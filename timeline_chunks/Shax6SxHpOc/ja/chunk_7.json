[{"type": "subtitle", "time": 421.47, "timestamp": "00:07:01", "text": "こんにちは。 皆さん、お元気ですか？"}, {"type": "subtitle", "time": 423.27, "timestamp": "00:07:03", "text": "えっと、ずいぶんご無沙汰でしたね？ えっと、確か"}, {"type": "subtitle", "time": 430.43, "timestamp": "00:07:10", "text": "2ヶ月くらい配信してないよね？ いや、3ヶ月くらいかな。 こんにちはを忘れていました"}, {"type": "subtitle", "time": 432.55, "timestamp": "00:07:12", "text": "。"}, {"type": "subtitle", "time": 433.71, "timestamp": "00:07:13", "text": "えっと、"}, {"type": "subtitle", "time": 435.31, "timestamp": "00:07:15", "text": "しばらく配信してなかったのは、"}, {"type": "chat", "time": 437.571, "timestamp": "00:07:17", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/ibEsXBiXAsrBWCWbTkgZ0bJd9N5UtKdTJ0xuH90CmHq-Zp-Lnzzyh3Y-5uAHMTNH94HMGGOwgWY=s64-c-k-c0x00ffffff-no-rj", "message": "Two months"}, {"type": "subtitle", "time": 439.87, "timestamp": "00:07:19", "text": "もし知らなかったら、今日本にいるからです"}, {"type": "subtitle", "time": 441.19, "timestamp": "00:07:21", "text": "。"}, {"type": "subtitle", "time": 442.71, "timestamp": "00:07:22", "text": "ええ、ご存知なかったかもしれませんが、私は"}, {"type": "subtitle", "time": 444.11, "timestamp": "00:07:24", "text": "今日本にいます。"}, {"type": "subtitle", "time": 445.07, "timestamp": "00:07:25", "text": "えっと、"}, {"type": "subtitle", "time": 447.87, "timestamp": "00:07:27", "text": "私は先月ここに来ました。"}, {"type": "subtitle", "time": 448.87, "timestamp": "00:07:28", "text": "うん。"}, {"type": "subtitle", "time": 451.11, "timestamp": "00:07:31", "text": "ええと、4月に。"}, {"type": "subtitle", "time": 452.15, "timestamp": "00:07:32", "text": "そして、"}, {"type": "subtitle", "time": 455.87, "timestamp": "00:07:35", "text": "こんにちは、コディ様。 いらっしゃいませ。 ようこそ、"}, {"type": "subtitle", "time": 458.07, "timestamp": "00:07:38", "text": "ようこそ。新しく"}, {"type": "subtitle", "time": 460.909, "timestamp": "00:07:40", "text": "来られた皆さん、こんにちは。皆さん、こんにちは。"}, {"type": "subtitle", "time": 463.27, "timestamp": "00:07:43", "text": "次は私の番です。"}, {"type": "subtitle", "time": 465.045, "timestamp": "00:07:45", "text": "久しぶりの音楽活動再開配信です。"}, {"type": "subtitle", "time": 466.47, "timestamp": "00:07:46", "text": "[笑い声]"}, {"type": "subtitle", "time": 469.19, "timestamp": "00:07:49", "text": "こんにちは。 こうして、私は日本に到着した。 私は日本にいます。"}, {"type": "subtitle", "time": 472.15, "timestamp": "00:07:52", "text": "ここに住み始めて"}, {"type": "subtitle", "time": 473.63, "timestamp": "00:07:53", "text": "2ヶ月になります。 ええ、今日は"}, {"type": "subtitle", "time": 476.79, "timestamp": "00:07:56", "text": "5月30日です。 ええ、つまり2ヶ月ですね。"}, {"type": "subtitle", "time": 478.43, "timestamp": "00:07:58", "text": "信じられますか？"}]
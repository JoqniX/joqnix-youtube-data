[{"type": "subtitle", "time": 720.87, "timestamp": "00:12:00", "text": "日本語の配信をする予定だよ。 はい。"}, {"type": "subtitle", "time": 722.31, "timestamp": "00:12:02", "text": "それが、私が発表したいことの一つです"}, {"type": "subtitle", "time": 724.83, "timestamp": "00:12:04", "text": "。 そして、音楽の"}, {"type": "subtitle", "time": 727.79, "timestamp": "00:12:07", "text": "内容に関しても、これまで通り"}, {"type": "subtitle", "time": 730.59, "timestamp": "00:12:10", "text": "実験を続けていきます。"}, {"type": "subtitle", "time": 734.63, "timestamp": "00:12:14", "text": "Vlogをアップロードしていきます。 皆さんは今すぐ"}, {"type": "subtitle", "time": 739.47, "timestamp": "00:12:19", "text": "私のチャンネルでVlog第1弾を見ることができます。"}, {"type": "subtitle", "time": 742.39, "timestamp": "00:12:22", "text": "そして、私はもっと多くの"}, {"type": "subtitle", "time": 746.75, "timestamp": "00:12:26", "text": "Vlogを投稿するつもりです。 彼らが今言ったことを録音したんだけど"}, {"type": "subtitle", "time": 751.23, "timestamp": "00:12:31", "text": "、編集とか全部自分でやらなきゃいけないんだ。"}, {"type": "subtitle", "time": 755.59, "timestamp": "00:12:35", "text": "はい、"}, {"type": "subtitle", "time": 758.95, "timestamp": "00:12:38", "text": "Vlogやコンテンツなどについて、遠慮なくフィードバックをください。そうすることで、"}, {"type": "subtitle", "time": 765.67, "timestamp": "00:12:45", "text": "私のコンテンツなどを改善するのに本当に役立ちます。いいですか？"}, {"type": "subtitle", "time": 766.87, "timestamp": "00:12:46", "text": "こんにちは。   他に"}, {"type": "subtitle", "time": 770.71, "timestamp": "00:12:50", "text": "何か？   他に"}, {"type": "subtitle", "time": 772.31, "timestamp": "00:12:52", "text": "何があっただろうか？   それは良く"}]
[{"type": "subtitle", "time": 4740.83, "timestamp": "01:19:00", "text": "こんにちは。 そうですね"}, {"type": "subtitle", "time": 4743.03, "timestamp": "01:19:03", "text": "。 あ、待って。 これはどういうことですか？"}, {"type": "subtitle", "time": 4747.11, "timestamp": "01:19:07", "text": "えーと、Vlogについて何かフィードバックがあれば"}, {"type": "subtitle", "time": 4749.31, "timestamp": "01:19:09", "text": "、ぜひお願いします。Vlogを"}, {"type": "subtitle", "time": 4750.59, "timestamp": "01:19:10", "text": "ご覧になっていない方は、"}, {"type": "subtitle", "time": 4752.67, "timestamp": "01:19:12", "text": "下の固定コメントにリンクがありますので、そちらを"}, {"type": "subtitle", "time": 4754.31, "timestamp": "01:19:14", "text": "ご覧ください。YouTubeでもご覧いただけますし、"}, {"type": "subtitle", "time": 4756.91, "timestamp": "01:19:16", "text": "InstagramとFacebookにもリールとしてアップロードしました"}, {"type": "subtitle", "time": 4759.51, "timestamp": "01:19:19", "text": "。 なので、"}, {"type": "subtitle", "time": 4762.67, "timestamp": "01:19:22", "text": "日本のvlogについて何かフィードバックがあれば、"}, {"type": "subtitle", "time": 4765.71, "timestamp": "01:19:25", "text": "遠慮なく教えてください。"}, {"type": "subtitle", "time": 4769.91, "timestamp": "01:19:29", "text": "建設的な批判は何でも受け入れますので、"}, {"type": "subtitle", "time": 4772.67, "timestamp": "01:19:32", "text": "改善できるように教えてください"}, {"type": "subtitle", "time": 4775.27, "timestamp": "01:19:35", "text": "。"}, {"type": "subtitle", "time": 4779.79, "timestamp": "01:19:39", "text": "アップロードしたVlogで唯一うまくいっていないと感じる点は、"}, {"type": "subtitle", "time": 4783.15, "timestamp": "01:19:43", "text": "音声（音楽）のことです。 まるで"}, {"type": "subtitle", "time": 4785.35, "timestamp": "01:19:45", "text": "私が本を読んでいるか、あるいはAIのジョン・ニックが"}, {"type": "subtitle", "time": 4787.03, "timestamp": "01:19:47", "text": "読んでいるかのようだ。"}, {"type": "subtitle", "time": 4788.55, "timestamp": "01:19:48", "text": "感情とかは何もなかったよね"}, {"type": "subtitle", "time": 4791.15, "timestamp": "01:19:51", "text": "？ あれは初めて"}, {"type": "subtitle", "time": 4793.27, "timestamp": "01:19:53", "text": "台本通りに演じたので、余計に"}, {"type": "subtitle", "time": 4798.75, "timestamp": "01:19:58", "text": "辛く感じました。 いいえ、気づいていないかもしれませんが。"}]
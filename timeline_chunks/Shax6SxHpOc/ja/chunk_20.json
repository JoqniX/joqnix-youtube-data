[{"type": "subtitle", "time": 1201.75, "timestamp": "00:20:01", "text": "、語学学生としてここにいるこの2年間の目標は、"}, {"type": "subtitle", "time": 1203.238, "timestamp": "00:20:03", "text": "もっと日本語を話すことです。"}, {"type": "subtitle", "time": 1203.39, "timestamp": "00:20:03", "text": "[音楽]"}, {"type": "subtitle", "time": 1205.75, "timestamp": "00:20:05", "text": "いいですか？ 至る所に川が流れている。 たとえ"}, {"type": "subtitle", "time": 1208.75, "timestamp": "00:20:08", "text": "日本にいても、日本語を話さなければならない。"}, {"type": "subtitle", "time": 1211.91, "timestamp": "00:20:11", "text": "えっと、今後もっと日本語の配信をする予定です。"}, {"type": "subtitle", "time": 1213.87, "timestamp": "00:20:13", "text": "日本語のみの配信は、"}, {"type": "subtitle", "time": 1216.19, "timestamp": "00:20:16", "text": "挑戦として用意されています。 通常の配信では、"}, {"type": "subtitle", "time": 1219.15, "timestamp": "00:20:19", "text": "私が様々な話し方をすることになりますが、ご了承ください。"}, {"type": "subtitle", "time": 1222.19, "timestamp": "00:20:22", "text": "日本語と英語。 うん。"}, {"type": "subtitle", "time": 1224.87, "timestamp": "00:20:24", "text": "主に語学学習と、"}, {"type": "subtitle", "time": 1232.63, "timestamp": "00:20:32", "text": "語彙力、イントネーション、"}, {"type": "subtitle", "time": 1235.47, "timestamp": "00:20:35", "text": "話し方の向上を目的としています。 こんにちは。 だって、ちゃんと"}, {"type": "subtitle", "time": 1238.15, "timestamp": "00:20:38", "text": "話せるようにならないといけないでしょ？ こんにちは。   これが"}, {"type": "subtitle", "time": 1240.19, "timestamp": "00:20:40", "text": "1番目です。"}, {"type": "chat", "time": 1245.586, "timestamp": "00:20:45", "author": "@MarcelineDichosa-e8b", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lPAu5LcUW1h_9K92DDPIFAt7oKeKn1gaScOAfzdeLy0FyHMrhcwYmEo-u21qNz3kJRkA=s64-c-k-c0x00ffffff-no-rj", "message": "I can speak Filipino and a little bit of Japanese and Korean"}, {"type": "subtitle", "time": 1245.83, "timestamp": "00:20:45", "text": "もっと音楽"}, {"type": "subtitle", "time": 1247.87, "timestamp": "00:20:47", "text": "コンテンツ"}, {"type": "subtitle", "time": 1249.03, "timestamp": "00:20:49", "text": "と、"}, {"type": "subtitle", "time": 1255.4
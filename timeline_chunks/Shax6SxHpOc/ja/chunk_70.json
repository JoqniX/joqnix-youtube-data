[{"type": "subtitle", "time": 4203.55, "timestamp": "01:10:03", "text": "学校訪問などで休暇をたくさん取らなければならなかったので、"}, {"type": "subtitle", "time": 4206.63, "timestamp": "01:10:06", "text": "彼らは親切にも"}, {"type": "chat", "time": 4209.125, "timestamp": "01:10:09", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "ow noice noice"}, {"type": "subtitle", "time": 4210.27, "timestamp": "01:10:10", "text": "休憩を取らせてくれました。"}, {"type": "subtitle", "time": 4212.91, "timestamp": "01:10:12", "text": "ええ、彼らは親切で、ええと、"}, {"type": "subtitle", "time": 4222.15, "timestamp": "01:10:22", "text": "これからどうするつもりですか？"}, {"type": "subtitle", "time": 4226.23, "timestamp": "01:10:26", "text": "はい、それで、先ほどのお知らせで言ったように、私は"}, {"type": "subtitle", "time": 4230.31, "timestamp": "01:10:30", "text": "それを削除しましたか？"}, {"type": "subtitle", "time": 4233.11, "timestamp": "01:10:33", "text": "ええ、それで、ストリームは"}, {"type": "subtitle", "time": 4234.43, "timestamp": "01:10:34", "text": "日本語と"}, {"type": "subtitle", "time": 4237.87, "timestamp": "01:10:37", "text": "日本語のバイリンガルになり、日本語がメインで、英語は私が"}, {"type": "subtitle", "time": 4240.95, "timestamp": "01:10:40", "text": "日本語で言ったことの翻訳になります。"}, {"type": "subtitle", "time": 4244.95, "timestamp": "01:10:44", "text": "私は主に、"}, {"type": "subtitle", "time": 4247.87, "timestamp": "01:10:47", "text": "ゲームストリームはできないと思います。それは"}, {"type": "subtitle", "time": 4252.55, "timestamp": "01:10:52", "text": "他のクリエイターとのコラボやコンテンツを作成するときだけに限定され、それ以外の時間は音楽に集中したいと思っています。"}]
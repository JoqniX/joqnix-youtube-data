[{"type": "subtitle", "time": 20042.67, "timestamp": "05:34:02", "text": "本当に終わりに近づいている"}, {"type": "subtitle", "time": 20046.15, "timestamp": "05:34:06", "text": "上。もう3時間半くらい経ちました"}, {"type": "subtitle", "time": 20048.708, "timestamp": "05:34:08", "text": "分。何？ 3歳だなんて信じられる？"}, {"type": "subtitle", "time": 20050.868, "timestamp": "05:34:10", "text": "1時間30分？では、これで終わりにします。"}, {"type": "subtitle", "time": 20054.11, "timestamp": "05:34:14", "text": "小川で私のものを食べる"}, {"type": "subtitle", "time": 20057.548, "timestamp": "05:34:17", "text": "夕食を食べたら寝ます。"}, {"type": "subtitle", "time": 20064.868, "timestamp": "05:34:24", "text": "こんにちは、パパ。ジェット。ああ、楽しかったよ。"}, {"type": "subtitle", "time": 20068.35, "timestamp": "05:34:28", "text": "私はすべてのロックを解除しました"}, {"type": "subtitle", "time": 20070.83, "timestamp": "05:34:30", "text": "銃、その他すべて。"}, {"type": "subtitle", "time": 20074.948, "timestamp": "05:34:34", "text": "いいね、君。私はこのゲームが大好きです。なぜ速いのか"}, {"type": "subtitle", "time": 20079.51, "timestamp": "05:34:39", "text": "こういうモーションゲームって、すごく楽しいの？"}, {"type": "subtitle", "time": 20081.07, "timestamp": "05:34:41", "text": "これはとても"}, {"type": "subtitle", "time": 20084.91, "timestamp": "05:34:44", "text": "楽しい。とても楽しい"}, {"type": "subtitle", "time": 20087.27, "timestamp": "05:34:47", "text": "ゲーム。そして私はそれに夢中になりすぎたか"}, {"type": "subtitle", "time": 20090.628, "timestamp": "05:34:50", "text": "何かあるの？私は"}, {"type": "subtitle", "time": 20093.83, "timestamp": "05:34:53", "text": "人生で最高の楽しみだった。何てことだ。私"}, {"type": "subtitle", "time": 20095.948, "timestamp": "05:34:55", "text": "夢中になりすぎたか、"}, {"type": "subtitle", "time": 20098.43, "timestamp": "05:34:58", "text": "何か。"}]
[{"type": "subtitle", "time": 16.31, "timestamp": "00:00:16", "text": "はい、生放送中です。 48日目へようこそ"}, {"type": "subtitle", "time": 18.79, "timestamp": "00:00:18", "text": "ヨアトンの。パート2へようこそ"}, {"type": "subtitle", "time": 22.15, "timestamp": "00:00:22", "text": "小川、夜の小川。こんにちは。えっと、"}, {"type": "subtitle", "time": 25.029, "timestamp": "00:00:25", "text": "逃した人たちに、えっと、私は"}, {"type": "subtitle", "time": 27.83, "timestamp": "00:00:27", "text": "私の課題。だから私は外で走っていた"}, {"type": "subtitle", "time": 30.189, "timestamp": "00:00:30", "text": "用事。ええ、ガレージに触りました"}, {"type": "subtitle", "time": 33.229, "timestamp": "00:00:33", "text": "今日、長い長い"}, {"type": "subtitle", "time": 36.63, "timestamp": "00:00:36", "text": "その間。私は自分の部屋に閉じ込められている"}, {"type": "subtitle", "time": 40.069, "timestamp": "00:00:40", "text": "そして毎日24時間ストリーミング配信"}, {"type": "subtitle", "time": 43.63, "timestamp": "00:00:43", "text": "2～3ヶ月。わからない。しかし"}, {"type": "subtitle", "time": 47.51, "timestamp": "00:00:47", "text": "うん、草に触ったよ。私はずぶ濡れになった"}, {"type": "subtitle", "time": 50.47, "timestamp": "00:00:50", "text": "雨。私はスクーターに乗っていました。私は持っていた"}, {"type": "subtitle", "time": 53.91, "timestamp": "00:00:53", "text": "私の後ろに叔父がいて、私たちは"}, {"type": "subtitle", "time": 55.83, "timestamp": "00:00:55", "text": "大学または学習センター"}, {"type": "subtitle", "time": 59.59, "timestamp": "00:00:59", "text": "課題を提出しなければならなかった場所で、"}]
[{"type": "subtitle", "time": 5344.07, "timestamp": "01:29:04", "text": "ショット。ああ。"}, {"type": "subtitle", "time": 5346.03, "timestamp": "01:29:06", "text": "ああ、"}, {"type": "subtitle", "time": 5353.83, "timestamp": "01:29:13", "text": "神。ああ、なんてことだ。私たちは行くところだった"}, {"type": "subtitle", "time": 5366.89, "timestamp": "01:29:26", "text": "クレイジー。おお、ナイスショット。"}, {"type": "subtitle", "time": 5389.47, "timestamp": "01:29:49", "text": "[音楽]"}, {"type": "subtitle", "time": 5392.95, "timestamp": "01:29:52", "text": "くそ。うさぎジャンプを試しているところです"}, {"type": "subtitle", "time": 5395.54, "timestamp": "01:29:55", "text": "そういうことなんだけど、難しいんだ。"}]
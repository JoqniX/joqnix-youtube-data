[{"type": "subtitle", "time": 19686.83, "timestamp": "05:28:06", "text": "私は"}, {"type": "subtitle", "time": 19697.708, "timestamp": "05:28:17", "text": "それ。いいえ、それは違います"}, {"type": "subtitle", "time": 19699.868, "timestamp": "05:28:19", "text": "弾薬。待って、それは"}, {"type": "subtitle", "time": 19701.788, "timestamp": "05:28:21", "text": "1"}, {"type": "subtitle", "time": 19704.788, "timestamp": "05:28:24", "text": "いいえ。ええ。"}, {"type": "subtitle", "time": 19707.31, "timestamp": "05:28:27", "text": "そして私は"}, {"type": "subtitle", "time": 19710.67, "timestamp": "05:28:30", "text": "もう一度行きたい"}, {"type": "subtitle", "time": 19713.788, "timestamp": "05:28:33", "text": "時間があるけど、私は"}, {"type": "subtitle", "time": 19716.51, "timestamp": "05:28:36", "text": "ごめん。なぜ"}, {"type": "subtitle", "time": 19720.11, "timestamp": "05:28:40", "text": "ドゥドゥキャン"}, {"type": "subtitle", "time": 19733.548, "timestamp": "05:28:53", "text": "する？何てことだ。私をどうしたらいいの？"}, {"type": "subtitle", "time": 19737.548, "timestamp": "05:28:57", "text": "ヘルプ。よし、今回は銃はなしだ。"}]
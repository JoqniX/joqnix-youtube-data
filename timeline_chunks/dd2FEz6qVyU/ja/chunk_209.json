[{"type": "subtitle", "time": 12542.51, "timestamp": "03:29:02", "text": "おお"}, {"type": "subtitle", "time": 12572.79, "timestamp": "03:29:32", "text": "警察。これは何の目的ですか？"}, {"type": "subtitle", "time": 12574.71, "timestamp": "03:29:34", "text": "機械？我々は大きな力を検出している"}, {"type": "subtitle", "time": 12576.429, "timestamp": "03:29:36", "text": "エネルギーが流れ込む"}, {"type": "subtitle", "time": 12578.87, "timestamp": "03:29:38", "text": "それ。あのね？このゲームが来たら"}, {"type": "subtitle", "time": 12582.429, "timestamp": "03:29:42", "text": "今すぐ発売、絶対に"}]
[{"type": "subtitle", "time": 21844.59, "timestamp": "06:04:04", "text": "ストリーム。うん、これはアート作品を作っていたんだ"}, {"type": "subtitle", "time": 21846.43, "timestamp": "06:04:06", "text": "ストリーム"}, {"type": "subtitle", "time": 21849.11, "timestamp": "06:04:09", "text": "そして、私に用事があったり、電話をかけてきたりした。"}, {"type": "subtitle", "time": 21852.07, "timestamp": "06:04:12", "text": "コラボレーション。つまり、即興コラボレーションは実際の"}, {"type": "subtitle", "time": 21855.03, "timestamp": "06:04:15", "text": "コラボレーション。ということで、もし私がコラボするなら"}, {"type": "subtitle", "time": 21858.11, "timestamp": "06:04:18", "text": "私が加えたいと思っていた人たちと一緒に"}, {"type": "subtitle", "time": 21862.948, "timestamp": "06:04:22", "text": "だって、私が知る限りでは、"}, {"type": "subtitle", "time": 21867.11, "timestamp": "06:04:27", "text": "私が会ったYouTuberの友達は"}, {"type": "subtitle", "time": 21871.19, "timestamp": "06:04:31", "text": "えーと、私が見たYouTuberのYouTube動画は"}, {"type": "subtitle", "time": 21873.99, "timestamp": "06:04:33", "text": "Twitchではみんなコラボしている"}, {"type": "subtitle", "time": 21877.11, "timestamp": "06:04:37", "text": "そういうことですが、普通はそうします。"}, {"type": "subtitle", "time": 21880.868, "timestamp": "06:04:40", "text": "コラボ企画をする時はコラボをしよう"}, {"type": "subtitle", "time": 21883.51, "timestamp": "06:04:43", "text": "マルチウォッチリンクがあるので"}, {"type": "subtitle", "time": 21887.75, "timestamp": "06:04:47", "text": "人々がコラボレーションのすべてを見ることができる"}, {"type": "subtitle", "time": 21890.31, "timestamp": "06:04:50", "text": "コラボストリーマー全員を一緒に"}, {"type": "subtitle", "time": 21893.43, "timestamp": "06:04:53", "text": "川を飛び越えるのではなく、ほら。"}, {"type": "subtitle", "time": 21897.23, "timestamp": "06:04:57", "text": "ええ、そうですね。えっと"}]
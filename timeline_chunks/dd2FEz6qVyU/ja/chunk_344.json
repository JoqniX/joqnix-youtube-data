[{"type": "subtitle", "time": 20640.07, "timestamp": "05:44:00", "text": "最後のストリーム、もう一方のストリームですが"}, {"type": "subtitle", "time": 20643.11, "timestamp": "05:44:03", "text": "うん、うまくいくかどうか見てみよう"}, {"type": "subtitle", "time": 20644.948, "timestamp": "05:44:04", "text": "ダッシュボードに移動する必要がありますか、"}, {"type": "subtitle", "time": 20655.43, "timestamp": "05:44:15", "text": "正しいコピー、えっと、待ってください。ああ、もう"}, {"type": "subtitle", "time": 20657.91, "timestamp": "05:44:17", "text": "1つもブロックされているようです。ええ、そうです"}, {"type": "subtitle", "time": 20661.67, "timestamp": "05:44:21", "text": "ブロックされました。じゃあ、私のものを見せてあげるよ。"}, {"type": "subtitle", "time": 20663.868, "timestamp": "05:44:23", "text": "ほとんどのものと同じように"}, {"type": "subtitle", "time": 20666.548, "timestamp": "05:44:26", "text": "ブロックされたのは、Twitch のすべてと同じ"}, {"type": "subtitle", "time": 20668.708, "timestamp": "05:44:28", "text": "使用したすべてのものをアップロードするために使用した言葉"}, {"type": "subtitle", "time": 20670.75, "timestamp": "05:44:30", "text": "あなたが見るように"}, {"type": "subtitle", "time": 20673.75, "timestamp": "05:44:33", "text": "部分的にブロックされています。最初のえーと"}, {"type": "subtitle", "time": 20675.83, "timestamp": "05:44:35", "text": "部分的にブロックされたブロックのように"}, {"type": "subtitle", "time": 20684.31, "timestamp": "05:44:44", "text": "ブロック。これは、えーと18歳くらいだった"}, {"type": "subtitle", "time": 20686.23, "timestamp": "05:44:46", "text": "何時間もかかるような。だから私は"}, {"type": "subtitle", "time": 20688.868, "timestamp": "05:44:48", "text": "アップロードできませんでした。しかしブロックブロック"}, {"type": "subtitle", "time": 20691.59, "timestamp": "05:44:51", "text": "プライベートブロックでない限り。それから私たちは"}, {"type": "subtitle", "time": 20692.83, "timestamp": "05:44:52", "text": "に"}, {"type": "subtitle", "time": 20696.23, "timestamp": "05:44:56", "text": "ライブ。我々は、ヘイを除いて公衆を手に入れた。"}, {"type": "subtitle", "time": 20699.03, "timestamp": "05:44:59", "text": "ああ、これはテストです。わかった。唯一"}]
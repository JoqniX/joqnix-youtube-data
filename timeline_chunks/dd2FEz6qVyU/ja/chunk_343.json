[{"type": "subtitle", "time": 20581.11, "timestamp": "05:43:01", "text": "ああ、それでうまくいく。良い。良い。ああ、助かった。"}, {"type": "subtitle", "time": 20587.868, "timestamp": "05:43:07", "text": "くそ。感謝"}, {"type": "subtitle", "time": 20592.548, "timestamp": "05:43:12", "text": "神。私はかなり震えていた"}, {"type": "subtitle", "time": 20595.99, "timestamp": "05:43:15", "text": "もし私がストリーミング配信できないとしたらどうなるか想像してみて"}, {"type": "subtitle", "time": 20603.83, "timestamp": "05:43:23", "text": "崩壊。 1回BANされるようなものだ。のように"}, {"type": "subtitle", "time": 20607.03, "timestamp": "05:43:27", "text": "TwitchでBANされて、"}, {"type": "subtitle", "time": 20608.11, "timestamp": "05:43:28", "text": "できる"}, {"type": "subtitle", "time": 20612.39, "timestamp": "05:43:32", "text": "流れはまさにその痛みを伴って進む。こんにちは"}, {"type": "subtitle", "time": 20616.628, "timestamp": "05:43:36", "text": "えっと、待って、私は"}, {"type": "subtitle", "time": 20620.39, "timestamp": "05:43:40", "text": "ストリームを終了したが、忘れた"}, {"type": "subtitle", "time": 20626.59, "timestamp": "05:43:46", "text": "だからそれは"}, {"type": "subtitle", "time": 20628.67, "timestamp": "05:43:48", "text": "ショーのように"}, {"type": "subtitle", "time": 20632.03, "timestamp": "05:43:52", "text": "オーケー、それは"}, {"type": "subtitle", "time": 20634.788, "timestamp": "05:43:54", "text": "緑、緑、何もない"}, {"type": "subtitle", "time": 20637.67, "timestamp": "05:43:57", "text": "ここでの制限は、これが何だったのかわかりません"}]
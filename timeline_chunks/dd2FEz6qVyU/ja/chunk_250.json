[{"type": "subtitle", "time": 15002.51, "timestamp": "04:10:02", "text": "よし、そうしよう"}, {"type": "subtitle", "time": 15005.75, "timestamp": "04:10:05", "text": "負荷。私はもうそれを買っています。強烈だ"}, {"type": "subtitle", "time": 15008.71, "timestamp": "04:10:08", "text": "スタイリッシュなシングルプレイヤーFPS"}, {"type": "subtitle", "time": 15011.269, "timestamp": "04:10:11", "text": "動きを完全にシャッターレベルと"}, {"type": "subtitle", "time": 15014.67, "timestamp": "04:10:14", "text": "高く評価されたオリジナルサウンドトラック。私"}, {"type": "subtitle", "time": 15022.15, "timestamp": "04:10:22", "text": "このゲームは私の動きと彼女はとても"}, {"type": "subtitle", "time": 15024.51, "timestamp": "04:10:24", "text": "悪い。それはとても良い"}, {"type": "subtitle", "time": 15027.67, "timestamp": "04:10:27", "text": "雰囲気。皆さんも同じように感じますか？"}, {"type": "subtitle", "time": 15030.15, "timestamp": "04:10:30", "text": "モーメントシャーは最高ですよね？"}, {"type": "subtitle", "time": 15032.95, "timestamp": "04:10:32", "text": "見て、彼は"}, {"type": "subtitle", "time": 15034.59, "timestamp": "04:10:34", "text": "奪い取る"}, {"type": "subtitle", "time": 15038.91, "timestamp": "04:10:38", "text": "後ろから銃が出てくる。"}]
[{"type": "subtitle", "time": 23880.75, "timestamp": "06:38:00", "text": "わかった。直したと思ったんだけど。おお、"}, {"type": "subtitle", "time": 23888.67, "timestamp": "06:38:08", "text": "いいえ。直したと思ったのですが。"}, {"type": "subtitle", "time": 23891.788, "timestamp": "06:38:11", "text": "[音楽]"}, {"type": "subtitle", "time": 23896.35, "timestamp": "06:38:16", "text": "それ。わかった。音声が"}, {"type": "subtitle", "time": 23899.03, "timestamp": "06:38:19", "text": "働く。荷物をまとめなければならなかった"}, {"type": "subtitle", "time": 23901.35, "timestamp": "06:38:21", "text": "今日。知らない人のために、私は私です"}, {"type": "subtitle", "time": 23903.43, "timestamp": "06:38:23", "text": "今夜出発します。だから"}, {"type": "subtitle", "time": 23907.19, "timestamp": "06:38:27", "text": "早朝配信をやっています"}, {"type": "subtitle", "time": 23908.67, "timestamp": "06:38:28", "text": "これ"}, {"type": "subtitle", "time": 23911.708, "timestamp": "06:38:31", "text": "時間。うん。あと、えっと、私の"}, {"type": "subtitle", "time": 23915.15, "timestamp": "06:38:35", "text": "メイン 明るすぎる、そうじゃない？"}, {"type": "subtitle", "time": 23918.708, "timestamp": "06:38:38", "text": "それ？明るすぎた。こんにちは。大丈夫。"}, {"type": "subtitle", "time": 23920.628, "timestamp": "06:38:40", "text": "ええ、午後なので、"}, {"type": "subtitle", "time": 23921.788, "timestamp": "06:38:41", "text": "欲しかった"}, {"type": "subtitle", "time": 23925.15, "timestamp": "06:38:45", "text": "今日の太陽"}, {"type": "subtitle", "time": 23927.83, "timestamp": "06:38:47", "text": "もの。まあまあ"}, {"type": "subtitle", "time": 23931.51, "timestamp": "06:38:51", "text": "えっと、私が言いたいのは、私にさせてください、そして"}, {"type": "subtitle", "time": 23933.27, "timestamp": "06:38:53", "text": "私がそれを直します。わかった、"}, {"type": "subtitle", "time": 23936.23, "timestamp": "06:38:56", "text": "分。えーと、今日の配信は完全に"}, {"type": "subtitle", "time": 23939.548, "timestamp": "06:38:59", "text": "擦り切れてくる。完全に傷だらけです"}]
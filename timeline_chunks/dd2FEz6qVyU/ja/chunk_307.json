[{"type": "subtitle", "time": 18440.47, "timestamp": "05:07:20", "text": "もう3時間経ちました。あのね？"}, {"type": "subtitle", "time": 18442.55, "timestamp": "05:07:22", "text": "銃を手に入れたので、これで終わりにしよう。私"}, {"type": "subtitle", "time": 18444.67, "timestamp": "05:07:24", "text": "ほとんど手に入れたと思う"}, {"type": "subtitle", "time": 18447.19, "timestamp": "05:07:27", "text": "すべて。残りのものは"}, {"type": "subtitle", "time": 18450.15, "timestamp": "05:07:30", "text": "見つけるのは、待って、なぜ私のモデルは"}, {"type": "subtitle", "time": 18471.708, "timestamp": "05:07:51", "text": "えっと、何て言ってたっけ？"}, {"type": "subtitle", "time": 18479.11, "timestamp": "05:07:59", "text": "もう一つやらせてください。 F なぜ私は"}]
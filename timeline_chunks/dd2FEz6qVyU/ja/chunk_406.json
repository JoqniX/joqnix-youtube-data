[{"type": "subtitle", "time": 24363.19, "timestamp": "06:46:03", "text": "ニーナ、私はメカジキが大好きなんです。"}, {"type": "subtitle", "time": 24365.19, "timestamp": "06:46:05", "text": "なぜ私は2倍の金額を支払わなければならなかったのか"}, {"type": "subtitle", "time": 24378.15, "timestamp": "06:46:18", "text": "神。いいえ、YouTuberとして、たとえ"}, {"type": "subtitle", "time": 24380.31, "timestamp": "06:46:20", "text": "私は付き合っている、みんなには言えない、"}, {"type": "subtitle", "time": 24382.59, "timestamp": "06:46:22", "text": "推測する、その時が来るまで"}, {"type": "subtitle", "time": 24385.31, "timestamp": "06:46:25", "text": "右。"}, {"type": "subtitle", "time": 24393.39, "timestamp": "06:46:33", "text": "なぜ？きっとあなたはこう言うでしょうね"}, {"type": "subtitle", "time": 24397.23, "timestamp": "06:46:37", "text": "再びハンドカメラを開くと"}, {"type": "subtitle", "time": 24400.91, "timestamp": "06:46:40", "text": "チョコレートを食べるように"}, {"type": "subtitle", "time": 24403.07, "timestamp": "06:46:43", "text": "あなたと二人きり"}, {"type": "subtitle", "time": 24405.91, "timestamp": "06:46:45", "text": "みんな。あなたも同じことを言うでしょう"}, {"type": "subtitle", "time": 24407.948, "timestamp": "06:46:47", "text": "彼らと一緒にね、兄弟。それは"}, {"type": "subtitle", "time": 24411.708, "timestamp": "06:46:51", "text": "シングル？待って、それは"}, {"type": "subtitle", "time": 24413.23, "timestamp": "06:46:53", "text": "わかった。"}, {"type": "subtitle", "time": 24416.27, "timestamp": "06:46:56", "text": "ババ"}]
[{"type": "subtitle", "time": 14647.51, "timestamp": "04:04:07", "text": "主。私はここから立ち去るべきだ。これ"}, {"type": "subtitle", "time": 14650.229, "timestamp": "04:04:10", "text": "怖い。彼らは文字通り私を抱きしめる"}, {"type": "subtitle", "time": 14658.99, "timestamp": "04:04:18", "text": "私は意思決定が本当に苦手です"}, {"type": "subtitle", "time": 14662.11, "timestamp": "04:04:22", "text": "悪い選択だ、留まるように"}]
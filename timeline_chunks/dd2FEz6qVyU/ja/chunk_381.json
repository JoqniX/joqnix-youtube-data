[{"type": "subtitle", "time": 22861.07, "timestamp": "06:21:01", "text": "私と一緒に？うん。それで、"}, {"type": "subtitle", "time": 22871.548, "timestamp": "06:21:11", "text": "パッド。全員にヘッドパッドを配布します。頭"}, {"type": "subtitle", "time": 22883.43, "timestamp": "06:21:23", "text": "Blenderは時間がかかりますが、編集できます"}, {"type": "subtitle", "time": 22886.51, "timestamp": "06:21:26", "text": "何でも。うん、"}, {"type": "subtitle", "time": 22889.19, "timestamp": "06:21:29", "text": "その通り。だから私は"}, {"type": "subtitle", "time": 22892.27, "timestamp": "06:21:32", "text": "Blender なぜなら、すべての"}, {"type": "subtitle", "time": 22894.59, "timestamp": "06:21:34", "text": "私のすべての"}, {"type": "subtitle", "time": 22897.91, "timestamp": "06:21:37", "text": "私のクリエイティブな友人たち、私の古い友人たち、"}, {"type": "subtitle", "time": 22899.83, "timestamp": "06:21:39", "text": "彼らはBlenderなどを使って、"}, {"type": "subtitle", "time": 22903.03, "timestamp": "06:21:43", "text": "私の4Dにおけるブレンダー。"}, {"type": "subtitle", "time": 22905.43, "timestamp": "06:21:45", "text": "ええ、やりたいです。したい"}, {"type": "subtitle", "time": 22908.31, "timestamp": "06:21:48", "text": "彼らにも追いつく。そう、"}, {"type": "subtitle", "time": 22910.35, "timestamp": "06:21:50", "text": "戻って"}]
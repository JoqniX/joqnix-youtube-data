[{"type": "subtitle", "time": 10820.07, "timestamp": "03:00:20", "text": "外？待って、なぜここは開いていないの？私は"}, {"type": "subtitle", "time": 10835.63, "timestamp": "03:00:35", "text": "これ？ああ、私は宇宙にいる。"}, {"type": "subtitle", "time": 10837.55, "timestamp": "03:00:37", "text": "おお。"}, {"type": "subtitle", "time": 10840.429, "timestamp": "03:00:40", "text": "聖なる。何？私はそうは思わない"}, {"type": "subtitle", "time": 10844.67, "timestamp": "03:00:44", "text": "知る。うん。こんにちは。ユウ。こんにちは。"}, {"type": "subtitle", "time": 10847.349, "timestamp": "03:00:47", "text": "いらっしゃいませ。元気かい？何てことだ。その"}, {"type": "subtitle", "time": 10849.87, "timestamp": "03:00:49", "text": "あなたはここに来るのが初めてですね。とは別に"}, {"type": "subtitle", "time": 10859.19, "timestamp": "03:00:59", "text": "ゲーム。こんにちは。ええ、画面が回転します"}]
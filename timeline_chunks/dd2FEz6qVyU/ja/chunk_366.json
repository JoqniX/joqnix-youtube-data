[{"type": "subtitle", "time": 21961.19, "timestamp": "06:06:01", "text": "知る。わからない。でも、ただの思いつきです。"}, {"type": "subtitle", "time": 21963.83, "timestamp": "06:06:03", "text": "ちょっとした思いつきです。"}, {"type": "subtitle", "time": 21965.99, "timestamp": "06:06:05", "text": "ストリーマーはフットペダルを使用しますか？私は思う"}, {"type": "subtitle", "time": 21969.548, "timestamp": "06:06:09", "text": "足を使うストリーマーを何人か見かけた"}, {"type": "subtitle", "time": 21981.23, "timestamp": "06:06:21", "text": "嫌い。それで"}, {"type": "subtitle", "time": 21991.628, "timestamp": "06:06:31", "text": "えっと、だからコラボを追加したんです。"}, {"type": "subtitle", "time": 21994.67, "timestamp": "06:06:34", "text": "ああ、作動しなかった。作動しなかった。感謝"}, {"type": "subtitle", "time": 22002.47, "timestamp": "06:06:42", "text": "録音して、これらは私が昔歌っていた曲です"}, {"type": "subtitle", "time": 22005.67, "timestamp": "06:06:45", "text": "する。えっと、聞いてみますか？誰か欲しい人"}, {"type": "subtitle", "time": 22012.19, "timestamp": "06:06:52", "text": "聞く？ほとんどのストリームはもう少し"}, {"type": "subtitle", "time": 22019.59, "timestamp": "06:06:59", "text": "また、"}]
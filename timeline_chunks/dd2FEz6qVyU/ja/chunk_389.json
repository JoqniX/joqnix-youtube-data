[{"type": "subtitle", "time": 23341.51, "timestamp": "06:29:01", "text": "そういうことだと分かっているから、私は"}, {"type": "subtitle", "time": 23344.628, "timestamp": "06:29:04", "text": "私が"}, {"type": "subtitle", "time": 23347.03, "timestamp": "06:29:07", "text": "アートに関しては、"}, {"type": "subtitle", "time": 23355.51, "timestamp": "06:29:15", "text": "ジョーカル、その考え自体が私を"}, {"type": "subtitle", "time": 23359.15, "timestamp": "06:29:19", "text": "私に何もさせないで前に進ませる"}, {"type": "subtitle", "time": 23362.468, "timestamp": "06:29:22", "text": "より良く言うと"}, {"type": "subtitle", "time": 23366.23, "timestamp": "06:29:26", "text": "つまり、ジョレックスは"}, {"type": "subtitle", "time": 23370.23, "timestamp": "06:29:30", "text": "テストベース テストベース"}, {"type": "subtitle", "time": 23372.19, "timestamp": "06:29:32", "text": "改善。どのように言いますか"}, {"type": "subtitle", "time": 23375.67, "timestamp": "06:29:35", "text": "これ？そして、建設方式。右、"}, {"type": "subtitle", "time": 23378.43, "timestamp": "06:29:38", "text": "そうそう、"}, {"type": "subtitle", "time": 23381.67, "timestamp": "06:29:41", "text": "右。スピードランさせてください。さよなら。気をつけて"}, {"type": "subtitle", "time": 23383.83, "timestamp": "06:29:43", "text": "配信をお楽しみください。こんにちは。こんにちは。あなたも。"}, {"type": "subtitle", "time": 23386.788, "timestamp": "06:29:46", "text": "あなたも。私たちはこれをOkayのために行います。"}, {"type": "subtitle", "time": 23394.468, "timestamp": "06:29:54", "text": "今？終わらせる必要があるかもしれないと思う"}]
[{"type": "subtitle", "time": 24662.43, "timestamp": "06:51:02", "text": "チョコレート。それで、えーと、"}, {"type": "subtitle", "time": 24666.39, "timestamp": "06:51:06", "text": "待って。私はただ食べるか、"}, {"type": "subtitle", "time": 24669.39, "timestamp": "06:51:09", "text": "トフィーやカップケーキのようなものが手に入ります"}, {"type": "subtitle", "time": 24673.03, "timestamp": "06:51:13", "text": "あるいは、どんなことでも、役に立つなら、"}, {"type": "subtitle", "time": 24674.23, "timestamp": "06:51:14", "text": "推測。"}, {"type": "subtitle", "time": 24676.83, "timestamp": "06:51:16", "text": "ああ、チョコレートを食べよう"}, {"type": "subtitle", "time": 24680.868, "timestamp": "06:51:20", "text": "一緒に。私は本当にそうしたかった"}, {"type": "subtitle", "time": 24683.27, "timestamp": "06:51:23", "text": "やりたいことはたくさんあったが、時間がなかった。"}, {"type": "subtitle", "time": 24686.788, "timestamp": "06:51:26", "text": "わかったよ、ミナ。手紙を書きたかった"}, {"type": "subtitle", "time": 24689.03, "timestamp": "06:51:29", "text": "そして、皆さんと一緒にその手紙を開けて"}, {"type": "subtitle", "time": 24690.75, "timestamp": "06:51:30", "text": "読み上げてください"}, {"type": "subtitle", "time": 24695.35, "timestamp": "06:51:35", "text": "大声で、あなたへの心からの手紙"}, {"type": "subtitle", "time": 24699.51, "timestamp": "06:51:39", "text": "男の人特有のもの。でも私は私は"}, {"type": "subtitle", "time": 24701.99, "timestamp": "06:51:41", "text": "遅い。私は荷物をまとめなければならず、"}, {"type": "subtitle", "time": 24703.868, "timestamp": "06:51:43", "text": "すべて。"}, {"type": "subtitle", "time": 24708.39, "timestamp": "06:51:48", "text": "だから、このチョコレートを食べるとき、"}, {"type": "subtitle", "time": 24712.27, "timestamp": "06:51:52", "text": "口を開けてこう言うだろうか"}, {"type": "subtitle", "time": 24715.43, "timestamp": "06:51:55", "text": "えっと、私は普段は"}, {"type": "subtitle", "time": 24717.59, "timestamp": "06:51:57", "text": "バレンタインデーにチョコレートを買う"}]
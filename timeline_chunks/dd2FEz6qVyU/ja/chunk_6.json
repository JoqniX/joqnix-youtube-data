[{"type": "subtitle", "time": 360.749, "timestamp": "00:06:00", "text": "数千のチャットのいいねコメントまたは"}, {"type": "subtitle", "time": 363.029, "timestamp": "00:06:03", "text": "何か。それがユニークなものかどうかはわかりません"}, {"type": "subtitle", "time": 366.43, "timestamp": "00:06:06", "text": "コメントまたはコメント合計"}, {"type": "subtitle", "time": 371.029, "timestamp": "00:06:11", "text": "コメント、そして、えっと、それらはカウントされると思います"}, {"type": "subtitle", "time": 379.35, "timestamp": "00:06:19", "text": "それは面白い。これは"}, {"type": "subtitle", "time": 386.629, "timestamp": "00:06:26", "text": "チャレンジ。だから私はそれが毎週だと思う"}, {"type": "chat", "time": 395.069, "timestamp": "00:06:35", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "what is your favourite subject"}, {"type": "subtitle", "time": 403.87, "timestamp": "00:06:43", "text": "お気に入りに追加しました"}, {"type": "subtitle", "time": 407.59000000000003, "timestamp": "00:06:47", "text": "主題。それは良い質問ですね。編集。私"}, {"type": "subtitle", "time": 413.83, "timestamp": "00:06:53", "text": "知る。私のお気に入りは何だと思いますか？"}]
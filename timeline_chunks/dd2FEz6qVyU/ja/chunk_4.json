[{"type": "subtitle", "time": 242.149, "timestamp": "00:04:02", "text": "風がとても強くて、雨もすごく激しかった"}, {"type": "subtitle", "time": 244.47, "timestamp": "00:04:04", "text": "そして私はそこを車で通り抜けた。車で通り抜けた"}, {"type": "subtitle", "time": 245.83, "timestamp": "00:04:05", "text": "それ。"}, {"type": "subtitle", "time": 248.789, "timestamp": "00:04:08", "text": "ご存知の通り、私はいつも最初に運転します。ウィンク。しかし"}, {"type": "subtitle", "time": 250.789, "timestamp": "00:04:10", "text": "ええ、私は無事でした。ああ、助かった。ありがたいことに"}, {"type": "subtitle", "time": 259.469, "timestamp": "00:04:19", "text": "そこには。しかし"}, {"type": "subtitle", "time": 264.03, "timestamp": "00:04:24", "text": "うん、家に帰ってきて"}, {"type": "subtitle", "time": 266.39, "timestamp": "00:04:26", "text": "ここ。なんだか、"}, {"type": "chat", "time": 273.766, "timestamp": "00:04:33", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "hmph"}, {"type": "subtitle", "time": 274.71, "timestamp": "00:04:34", "text": "えっと、なんだか、なんだか、"}, {"type": "chat", "time": 278.385, "timestamp": "00:04:38", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "nice"}, {"type": "subtitle", "time": 279.35, "timestamp": "00:04:39", "text": "びしょ濡れになったから、風邪をひくかも"}, {"type": "subtitle", "time": 280.51, "timestamp": "00:04:40", "text": "で"}, {"type": "subtitle", "time": 285.15, "timestamp": "00:04:45", "text": "雨。それで、でも私は"}, {"type": "subtitle", "time": 288.95, "timestamp": "00:04:48", "text": "バス。お風呂に入ったので、よくわかりません"}, {"type": "subtitle", "time": 291.31, "timestamp": "00:04:51", "text": "物事がどのように進むか"}]
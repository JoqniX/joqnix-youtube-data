[{"type": "subtitle", "time": 10164.11, "timestamp": "02:49:24", "text": "再ロードする必要がある。それは"}, {"type": "subtitle", "time": 10167.59, "timestamp": "02:49:27", "text": "大丈夫。ああ、あれは良かった。ああ、なんてことだ、"}, {"type": "subtitle", "time": 10181.75, "timestamp": "02:49:41", "text": "いいえ。何かがあった。あなたは見ましたか？"}, {"type": "subtitle", "time": 10183.11, "timestamp": "02:49:43", "text": "今の見た？何かがあった"}, {"type": "subtitle", "time": 10189.389, "timestamp": "02:49:49", "text": "右？うん。これ"}, {"type": "subtitle", "time": 10191.469, "timestamp": "02:49:51", "text": "男。何"}, {"type": "subtitle", "time": 10198.71, "timestamp": "02:49:58", "text": "見た？どうやってブーストアップしたか"}]
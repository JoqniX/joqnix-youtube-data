[{"type": "subtitle", "time": 4322.63, "timestamp": "01:12:02", "text": "待って、彼が何をするか見てみよう"}, {"type": "subtitle", "time": 4323.56, "timestamp": "01:12:03", "text": "あなたは"}, {"type": "subtitle", "time": 4331.95, "timestamp": "01:12:11", "text": "立ち往生。あの兄弟、俺は"}, {"type": "subtitle", "time": 4335.31, "timestamp": "01:12:15", "text": "[音楽]"}]
[{"type": "subtitle", "time": 22981.27, "timestamp": "06:23:01", "text": "心優しい人は少ない"}, {"type": "subtitle", "time": 22982.59, "timestamp": "06:23:02", "text": "準備ができて"}, {"type": "subtitle", "time": 22987.11, "timestamp": "06:23:07", "text": "私を殺そうとしたり、そういうこと。私は欲しくない"}, {"type": "subtitle", "time": 22989.83, "timestamp": "06:23:09", "text": "彼らに私のためにやらせようと思ってね。私はただ"}, {"type": "subtitle", "time": 22991.59, "timestamp": "06:23:11", "text": "自分でやってみたいし、全部学びたい"}, {"type": "subtitle", "time": 22992.75, "timestamp": "06:23:12", "text": "これら"}, {"type": "subtitle", "time": 22996.19, "timestamp": "06:23:16", "text": "工芸品。それはいつも使われていたものです"}, {"type": "subtitle", "time": 22999.83, "timestamp": "06:23:19", "text": "言う。私は「待ちきれない」という気持ちをうまく表現できるタイプではありません。"}, {"type": "subtitle", "time": 23001.75, "timestamp": "06:23:21", "text": "何でも屋。あれだよ。えっと"}, {"type": "subtitle", "time": 23004.43, "timestamp": "06:23:24", "text": "その言い回しは何ですか？"}, {"type": "subtitle", "time": 23008.948, "timestamp": "06:23:28", "text": "クワッド。何でも屋。うん。ジャック"}, {"type": "subtitle", "time": 23011.83, "timestamp": "06:23:31", "text": "全ての取引。韻の達人。なし。うん、"}, {"type": "subtitle", "time": 23013.35, "timestamp": "06:23:33", "text": "それが問題なんです。それが私の本質です"}, {"type": "subtitle", "time": 23016.788, "timestamp": "06:23:36", "text": "今は、昔はそうだったから、ああ、なぜ私は"}, {"type": "subtitle", "time": 23019.07, "timestamp": "06:23:39", "text": "取る"}, {"type": "subtitle", "time": 23022.07, "timestamp": "06:23:42", "text": "Photoshop は、以前は音楽を作っていたからです。"}, {"type": "subtitle", "time": 23026.47, "timestamp": "06:23:46", "text": "以前はイラストを描いていた、以前は3Dを描いていた、"}, {"type": "subtitle", "time": 23028.03, "timestamp": "06:23:48", "text": "すべて、すべて、"}, {"type": "subtitle", "time": 23031.27, "timestamp": "06:23:51", "text": "すべて。ゲームのデザイン、すべて自分でやった。"}, {"type": "subtitle", "time": 23034.27, "timestamp": "06:23:54", "text": "昔はやっていたけど、やめてしまった"}, {"type": "subtitle", "time": 23036.548, "timestamp": "06:23:56", "text": "すべて。だから、復帰するのは難しい"}]
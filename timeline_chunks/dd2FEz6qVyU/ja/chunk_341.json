[{"type": "subtitle", "time": 20461.27, "timestamp": "05:41:01", "text": "フォローする。うん、今のところ外してないよ"}, {"type": "subtitle", "time": 20463.07, "timestamp": "05:41:03", "text": "誰でも。"}, {"type": "subtitle", "time": 20480.83, "timestamp": "05:41:20", "text": "寝る。本当にありがとうございます"}, {"type": "subtitle", "time": 20485.11, "timestamp": "05:41:25", "text": "多くの。そして、すべての投票は"}, {"type": "subtitle", "time": 20487.67, "timestamp": "05:41:27", "text": "最後の数回の配信も、"}, {"type": "subtitle", "time": 20490.15, "timestamp": "05:41:30", "text": "今日、明日ビリーによってアップロードされました"}, {"type": "subtitle", "time": 20492.31, "timestamp": "05:41:32", "text": "ビリーもだ。私は少し不足している"}, {"type": "subtitle", "time": 20494.948, "timestamp": "05:41:34", "text": "ビリー・ビリーのアップロードが遅れています"}, {"type": "subtitle", "time": 20498.31, "timestamp": "05:41:38", "text": "流れは今日か明日には"}, {"type": "subtitle", "time": 20502.07, "timestamp": "05:41:42", "text": "完全にアップロードされました。そう、そういう人たちは"}, {"type": "subtitle", "time": 20503.67, "timestamp": "05:41:43", "text": "ビリービリーからも見守られています。"}, {"type": "subtitle", "time": 20504.67, "timestamp": "05:41:44", "text": "感謝"}, {"type": "subtitle", "time": 20508.868, "timestamp": "05:41:48", "text": "あなたにも感謝します。じゃあ、またね"}, {"type": "subtitle", "time": 20512.31, "timestamp": "05:41:52", "text": "明日みんなでハッピーに楽しもう"}, {"type": "subtitle", "time": 20514.19, "timestamp": "05:41:54", "text": "残りの夜または"}]
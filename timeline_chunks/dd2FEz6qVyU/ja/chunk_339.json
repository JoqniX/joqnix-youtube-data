[{"type": "subtitle", "time": 20341.65, "timestamp": "05:39:01", "text": "誰一人見逃さなかった"}, {"type": "subtitle", "time": 20350.708, "timestamp": "05:39:10", "text": "それ以外。でも、正直言って楽しかったよ。"}, {"type": "subtitle", "time": 20352.31, "timestamp": "05:39:12", "text": "ロッカーの皆さん、ありがとうございます。"}, {"type": "subtitle", "time": 20354.31, "timestamp": "05:39:14", "text": "ストリームをロックオンします。それは本当に"}, {"type": "subtitle", "time": 20356.708, "timestamp": "05:39:16", "text": "多く。楽しんでいただけたなら幸いです。そうでないことを願います"}, {"type": "subtitle", "time": 20366.35, "timestamp": "05:39:26", "text": "それで、えーと、明日は、えーと、早めの"}, {"type": "subtitle", "time": 20370.57, "timestamp": "05:39:30", "text": "午前7時の配信"}, {"type": "subtitle", "time": 20372.91, "timestamp": "05:39:32", "text": "[音楽]"}, {"type": "subtitle", "time": 20377.39, "timestamp": "05:39:37", "text": "午前。うん。ええと、午前7時。"}, {"type": "subtitle", "time": 20379.91, "timestamp": "05:39:39", "text": "ストリーム、朝のストリーム、それから"}, {"type": "subtitle", "time": 20382.39, "timestamp": "05:39:42", "text": "おそらくワークフローを実行するでしょう。わかった。私はただ"}, {"type": "subtitle", "time": 20385.19, "timestamp": "05:39:45", "text": "今日は早く寝て、"}, {"type": "subtitle", "time": 20389.11, "timestamp": "05:39:49", "text": "満腹で健康でよく眠れた"}, {"type": "subtitle", "time": 20392.91, "timestamp": "05:39:52", "text": "私にとって十分"}, {"type": "subtitle", "time": 20395.75, "timestamp": "05:39:55", "text": "明日は超アクティブになるよ。明日私たちは"}, {"type": "subtitle", "time": 20397.99, "timestamp": "05:39:57", "text": "働く。私は自分のことをするはずだったのに"}, {"type": "subtitle", "time": 20399.99, "timestamp": "05:39:59", "text": "今日は仕事の配信だったけど、私はこう思った。"}]
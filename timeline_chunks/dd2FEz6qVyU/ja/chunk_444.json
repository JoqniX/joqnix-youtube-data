[{"type": "subtitle", "time": 26640.468, "timestamp": "07:24:00", "text": "あなた？君がいなくて寂しいよ。そして幸せ"}, {"type": "subtitle", "time": 26643.31, "timestamp": "07:24:03", "text": "バレンタインデー。私はあなたに私の"}, {"type": "subtitle", "time": 26646.948, "timestamp": "07:24:06", "text": "チョコレート。私たちと一緒にチョコレートを食べましょう。願っています"}, {"type": "subtitle", "time": 26649.27, "timestamp": "07:24:09", "text": "私が最初にあなたにチョコレートをあげた人です"}, {"type": "subtitle", "time": 26651.15, "timestamp": "07:24:11", "text": "今日。"}, {"type": "subtitle", "time": 26653.548, "timestamp": "07:24:13", "text": "ウィンク"}, {"type": "subtitle", "time": 26660.67, "timestamp": "07:24:20", "text": "帽子。熱いDをくれ。さもないと、"}, {"type": "subtitle", "time": 26667.8, "timestamp": "07:24:27", "text": "ハッピーバレンタイン"}, {"type": "subtitle", "time": 26669.23, "timestamp": "07:24:29", "text": "[音楽]"}, {"type": "subtitle", "time": 26672.468, "timestamp": "07:24:32", "text": "日。ハッピーバレンタインデー。おめでとうございます"}, {"type": "subtitle", "time": 26673.708, "timestamp": "07:24:33", "text": "として"}, {"type": "subtitle", "time": 26676.788, "timestamp": "07:24:36", "text": "良い。今日最初の1件。最初の"}, {"type": "subtitle", "time": 26685.99, "timestamp": "07:24:45", "text": "チョコレート。あなたが"}, {"type": "subtitle", "time": 26689.31, "timestamp": "07:24:49", "text": "アカデミーの後にはカップルがいます"}, {"type": "subtitle", "time": 26694.07, "timestamp": "07:24:54", "text": "そこには。どの学校ですか？のように"}, {"type": "subtitle", "time": 26697.75, "timestamp": "07:24:57", "text": "えっと、どのアカデミーが日本の"}]
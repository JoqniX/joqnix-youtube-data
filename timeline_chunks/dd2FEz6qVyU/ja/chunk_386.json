[{"type": "subtitle", "time": 23161.788, "timestamp": "06:26:01", "text": "ストリーミングを始めて数年経つうちに私は"}, {"type": "subtitle", "time": 23166.548, "timestamp": "06:26:06", "text": "プロ意識の高い人。物についても同じことが言える。だから私は"}, {"type": "subtitle", "time": 23169.43, "timestamp": "06:26:09", "text": "私のモデルにアナル系のものを作ってあげたいんです。"}, {"type": "subtitle", "time": 23172.99, "timestamp": "06:26:12", "text": "完璧。右。えっと、話してる"}, {"type": "subtitle", "time": 23176.708, "timestamp": "06:26:16", "text": "絵を描くことについて、ああ、思い出したんだけど"}, {"type": "subtitle", "time": 23179.23, "timestamp": "06:26:19", "text": "終わっていない"}, {"type": "subtitle", "time": 23182.15, "timestamp": "06:26:22", "text": "私たちはまだ"}, {"type": "subtitle", "time": 23184.91, "timestamp": "06:26:24", "text": "心のように描く"}, {"type": "subtitle", "time": 23188.91, "timestamp": "06:26:28", "text": "ハートの絵文字私たちはそうあるべきです"}, {"type": "subtitle", "time": 23191.788, "timestamp": "06:26:31", "text": "まだ終わっていません"}, {"type": "subtitle", "time": 23194.07, "timestamp": "06:26:34", "text": "そう、このエモートはまだ"}, {"type": "subtitle", "time": 23206.15, "timestamp": "06:26:46", "text": "うん。えっと、頭を描きます。これも"}, {"type": "subtitle", "time": 23208.43, "timestamp": "06:26:48", "text": "もっとボートを漕ぐ練習をする必要がある"}, {"type": "subtitle", "time": 23211.51, "timestamp": "06:26:51", "text": "レッスン。えっと、これは私が描いたものです"}, {"type": "subtitle", "time": 23214.35, "timestamp": "06:26:54", "text": "ズキ・カーンは"}, {"type": "subtitle", "time": 23218.07, "timestamp": "06:26:58", "text": "チャド。私がズキ・カーンのために絵を描いたとき、"}]
[{"type": "subtitle", "time": 21061.628, "timestamp": "05:51:01", "text": "NDI1。見せる"}, {"type": "subtitle", "time": 21063.868, "timestamp": "05:51:03", "text": "NDI1。隠れる"}, {"type": "subtitle", "time": 21068.99, "timestamp": "05:51:08", "text": "NDI1。それも良い方法です。"}, {"type": "subtitle", "time": 21072.19, "timestamp": "05:51:12", "text": "他に何か？ほかに何か？ほかに何か？"}, {"type": "subtitle", "time": 21075.35, "timestamp": "05:51:15", "text": "ああ、じゃあDiscordはミュートで"}, {"type": "subtitle", "time": 21077.39, "timestamp": "05:51:17", "text": "ミュートを解除する。それから"}, {"type": "subtitle", "time": 21084.39, "timestamp": "05:51:24", "text": "コラボレーション。何も聞こえません。何"}, {"type": "subtitle", "time": 21088.788, "timestamp": "05:51:28", "text": "くそ？何だって？動作していませんか？おお、"}, {"type": "subtitle", "time": 21091.91, "timestamp": "05:51:31", "text": "うまくいきません。ああ、ああ。ああ、冗談だよ。ニックスは"}, {"type": "subtitle", "time": 21093.91, "timestamp": "05:51:33", "text": "これらの素晴らしい才能を持つ方々とコラボレーションできることを嬉しく思います。"}, {"type": "subtitle", "time": 21096.15, "timestamp": "05:51:36", "text": "仮想サクラとサンヘルのコード。あなたはできる"}, {"type": "subtitle", "time": 21098.548, "timestamp": "05:51:38", "text": "下記に各社のリンクを掲載しています。うん。もし私が"}, {"type": "subtitle", "time": 21101.27, "timestamp": "05:51:41", "text": "人々と協力することで、彼らを追加できます"}, {"type": "subtitle", "time": 21102.75, "timestamp": "05:51:42", "text": "などなど。"}, {"type": "subtitle", "time": 21106.15, "timestamp": "05:51:46", "text": "うん。これで完了です。"}, {"type": "subtitle", "time": 21109.11, "timestamp": "05:51:49", "text": "では、他に何があるだろうか？他に何があっただろうか"}, {"type": "subtitle", "time": 21110.27, "timestamp": "05:51:50", "text": "したい"}, {"type": "subtitle", "time": 21112.948, "timestamp": "05:51:52", "text": "埋め込む？これらは私のTrelloに入っています"}, {"type": "subtitle", "time": 21115.91, "timestamp": "05:51:55", "text": "ボード。実際、私はそれを持っていたかった"}]
[{"type": "subtitle", "time": 24120.35, "timestamp": "06:42:00", "text": "ここにいる"}, {"type": "subtitle", "time": 24125.43, "timestamp": "06:42:05", "text": "今日。そして私も準備しました"}, {"type": "subtitle", "time": 24127.67, "timestamp": "06:42:07", "text": "今日は手持ちカメラで撮影しました。私は買いました"}, {"type": "subtitle", "time": 24130.11, "timestamp": "06:42:10", "text": "外に出て買った"}, {"type": "subtitle", "time": 24134.23, "timestamp": "06:42:14", "text": "チョコレートを一緒に食べる"}, {"type": "subtitle", "time": 24138.27, "timestamp": "06:42:18", "text": "君たち。私もそうするつもりです"}, {"type": "subtitle", "time": 24142.868, "timestamp": "06:42:22", "text": "それ。うん、だって食べるのは楽しくないから"}, {"type": "subtitle", "time": 24147.35, "timestamp": "06:42:27", "text": "チョコだけですよね？前回私が"}, {"type": "subtitle", "time": 24149.19, "timestamp": "06:42:29", "text": "私もこれをやったが、"}, {"type": "subtitle", "time": 24154.23, "timestamp": "06:42:34", "text": "手持ちカメラだけど、私は覚えている、"}, {"type": "subtitle", "time": 24158.11, "timestamp": "06:42:38", "text": "私が食べたもの"}, {"type": "subtitle", "time": 24160.548, "timestamp": "06:42:40", "text": "チョコレート。配信中だったのか、それとも"}, {"type": "subtitle", "time": 24162.59, "timestamp": "06:42:42", "text": "配信停止？私はそうは思わない"}, {"type": "subtitle", "time": 24166.75, "timestamp": "06:42:46", "text": "覚えておいて、でもおそらく"}, {"type": "subtitle", "time": 24177.51, "timestamp": "06:42:57", "text": "来るよ。もう一度確認させてください"}]
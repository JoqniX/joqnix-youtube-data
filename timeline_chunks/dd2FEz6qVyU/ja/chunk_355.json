[{"type": "subtitle", "time": 21300.708, "timestamp": "05:55:00", "text": "これらは完全に終わらせるべきだった"}, {"type": "subtitle", "time": 21303.75, "timestamp": "05:55:03", "text": "配信関連のことです。そして今もなお"}, {"type": "subtitle", "time": 21309.75, "timestamp": "05:55:09", "text": "まだ10％しか終わっていないので、早すぎます。 100%は"}, {"type": "subtitle", "time": 21312.35, "timestamp": "05:55:12", "text": "手に入れるのにかなり時間がかかりそうです"}, {"type": "subtitle", "time": 21319.548, "timestamp": "05:55:19", "text": "よお。そしてこれらのものは"}, {"type": "subtitle", "time": 21327.948, "timestamp": "05:55:27", "text": "追加しなければならないし"}, {"type": "subtitle", "time": 21332.35, "timestamp": "05:55:32", "text": "インプラントは独特で複雑です"}, {"type": "subtitle", "time": 21336.43, "timestamp": "05:55:36", "text": "配信用の素材。でも、今日は"}, {"type": "subtitle", "time": 21341.27, "timestamp": "05:55:41", "text": "今日、私はそれに気づいた"}, {"type": "subtitle", "time": 21344.23, "timestamp": "05:55:44", "text": "何らかの理由で 8 つのプログラムが"}, {"type": "subtitle", "time": 21347.868, "timestamp": "05:55:47", "text": "beot、ndi、voice attack、noobsのように開く"}, {"type": "subtitle", "time": 21351.27, "timestamp": "05:55:51", "text": "司令官、レオンボード5は"}, {"type": "subtitle", "time": 21353.31, "timestamp": "05:55:53", "text": "五。そしてまた"}, {"type": "subtitle", "time": 21356.59, "timestamp": "05:55:56", "text": "明らかにそれから、メディアをキーにすると、それはつまり"}, {"type": "subtitle", "time": 21358.67, "timestamp": "05:55:58", "text": "セブン"}]
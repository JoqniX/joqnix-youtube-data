[{"type": "subtitle", "time": 22269.15, "timestamp": "06:11:09", "text": "これが私のやり方"}, {"type": "subtitle", "time": 22271.39, "timestamp": "06:11:11", "text": "私は"}, {"type": "subtitle", "time": 22274.43, "timestamp": "06:11:14", "text": "当然のことながら、"}, {"type": "subtitle", "time": 22276.868, "timestamp": "06:11:16", "text": "えっと、ビデオを作ろうと思ってるんだけど"}, {"type": "subtitle", "time": 22281.15, "timestamp": "06:11:21", "text": "トップ10が勝つので、"}, {"type": "subtitle", "time": 22285.628, "timestamp": "06:11:25", "text": "3D 知ってるよ、ああ、"}, {"type": "subtitle", "time": 22288.788, "timestamp": "06:11:28", "text": "それは、ああ、やばい、失くした"}, {"type": "subtitle", "time": 22291.868, "timestamp": "06:11:31", "text": "音声、あぁ、NDIフィード"}, {"type": "subtitle", "time": 22294.99, "timestamp": "06:11:34", "text": "ワンNDIショー"}, {"type": "subtitle", "time": 22297.47, "timestamp": "06:11:37", "text": "NDI1。見せる"}, {"type": "subtitle", "time": 22300.548, "timestamp": "06:11:40", "text": "NDI1。これが見えますか？実際失くした"}, {"type": "subtitle", "time": 22303.11, "timestamp": "06:11:43", "text": "オーディオ。あ、待って。それはインド1ではありません。ああ、"}, {"type": "subtitle", "time": 22311.47, "timestamp": "06:11:51", "text": "2. 何をすればいいの？ ええ、実は失くしてしまったんです"}, {"type": "subtitle", "time": 22313.15, "timestamp": "06:11:53", "text": "オーディオ。"}, {"type": "subtitle", "time": 22315.91, "timestamp": "06:11:55", "text": "ああ、わかった。戻ってきました。戻ってきました。戻ってきました。"}]
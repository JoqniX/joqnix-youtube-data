[{"type": "subtitle", "time": 26110.868, "timestamp": "07:15:10", "text": "無料。ああ、自由になるよ。無料です。"}, {"type": "subtitle", "time": 26113.548, "timestamp": "07:15:13", "text": "正直に言うと、私はもっと"}, {"type": "subtitle", "time": 26115.66, "timestamp": "07:15:15", "text": "より自由。本当に"}, {"type": "subtitle", "time": 26116.99, "timestamp": "07:15:16", "text": "[音楽]"}, {"type": "subtitle", "time": 26121.91, "timestamp": "07:15:21", "text": "無料。だから、もっとコラボ企画をしようと思っています。"}, {"type": "subtitle", "time": 26123.15, "timestamp": "07:15:23", "text": "そして"}, {"type": "subtitle", "time": 26125.15, "timestamp": "07:15:25", "text": "もの。"}, {"type": "subtitle", "time": 26128.868, "timestamp": "07:15:28", "text": "うん、合格しているといいな。私は欲しい"}, {"type": "subtitle", "time": 26132.11, "timestamp": "07:15:32", "text": "N5の証明書または"}, {"type": "subtitle", "time": 26137.23, "timestamp": "07:15:37", "text": "Q5.私は自分が"}, {"type": "subtitle", "time": 26147.27, "timestamp": "07:15:47", "text": "私も水を飲みます。みんなで飲んで"}]
[{"type": "subtitle", "time": 22320.948, "timestamp": "06:12:00", "text": "えっと、隠れて。隠れる。インド1位。わかった。"}, {"type": "subtitle", "time": 22326.23, "timestamp": "06:12:06", "text": "えっと、つまり、私が言ったように、私は"}, {"type": "subtitle", "time": 22330.19, "timestamp": "06:12:10", "text": "私は自分のエリアに行かせてください"}, {"type": "subtitle", "time": 22333.91, "timestamp": "06:12:13", "text": "ディスコード、つまり私はこれら全てを作りました"}, {"type": "subtitle", "time": 22337.788, "timestamp": "06:12:17", "text": "つまり、これ以前に私は1つ持っていた"}, {"type": "subtitle", "time": 22342.23, "timestamp": "06:12:22", "text": "1つは私の言う通りで、あと2つありました"}, {"type": "subtitle", "time": 22345.67, "timestamp": "06:12:25", "text": "昆虫、つまり実際にはペインコです"}, {"type": "subtitle", "time": 22348.788, "timestamp": "06:12:28", "text": "アバターを決定し、それを運転する"}, {"type": "subtitle", "time": 22351.67, "timestamp": "06:12:31", "text": "それは痛みです。つまり、私は"}, {"type": "subtitle", "time": 22353.15, "timestamp": "06:12:33", "text": "簡単"}, {"type": "subtitle", "time": 22358.788, "timestamp": "06:12:38", "text": "方法。簡単な方法、虚無の簡単な方法のように、"}, {"type": "subtitle", "time": 22361.59, "timestamp": "06:12:41", "text": "でも、私は虚無になりたくない。したい"}, {"type": "subtitle", "time": 22364.27, "timestamp": "06:12:44", "text": "作りたいもの"}, {"type": "subtitle", "time": 22367.788, "timestamp": "06:12:47", "text": "これ、わかるでしょ？私は、"}, {"type": "subtitle", "time": 22370.35, "timestamp": "06:12:50", "text": "このハイパー"}, {"type": "subtitle", "time": 22372.03, "timestamp": "06:12:52", "text": "現実的。"}, {"type": "subtitle", "time": 22374.75, "timestamp": "06:12:54", "text": "ハワイはこういうのが好きです"}, {"type": "subtitle", "time": 22377.27, "timestamp": "06:12:57", "text": "モデル。わからない。わからない。私は"}, {"type": "subtitle", "time": 22379.59, "timestamp": "06:12:59", "text": "Blender 3Dで苦闘し、死ぬ覚悟はできている"}]
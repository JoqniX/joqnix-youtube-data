[{"type": "subtitle", "time": 25745.708, "timestamp": "07:09:05", "text": "恋しい"}, {"type": "subtitle", "time": 25748.868, "timestamp": "07:09:08", "text": "私が出席したときに手に入れたと思う"}, {"type": "subtitle", "time": 25751.31, "timestamp": "07:09:11", "text": "言語クラスum言語"}, {"type": "subtitle", "time": 25755.07, "timestamp": "07:09:15", "text": "学校で青春を経験できたらいいな"}, {"type": "subtitle", "time": 25763.548, "timestamp": "07:09:23", "text": "人生"}, {"type": "subtitle", "time": 25765.868, "timestamp": "07:09:25", "text": "M so"}, {"type": "subtitle", "time": 25768.548, "timestamp": "07:09:28", "text": "そして最近は、何が何だか分かるよね"}, {"type": "subtitle", "time": 25769.83, "timestamp": "07:09:29", "text": "1つは、何の1つか。"}, {"type": "subtitle", "time": 25769.91, "timestamp": "07:09:29", "text": "何、何、何、何、何"}, {"type": "subtitle", "time": 25772.23, "timestamp": "07:09:32", "text": "私が"}, {"type": "subtitle", "time": 25775.468, "timestamp": "07:09:35", "text": "えーと苦労しています"}, {"type": "subtitle", "time": 25782.83, "timestamp": "07:09:42", "text": "ルームメイトがいるべきか、それとも私が行くべきか"}, {"type": "subtitle", "time": 25785.548, "timestamp": "07:09:45", "text": "ソロで"}, {"type": "subtitle", "time": 25788.07, "timestamp": "07:09:48", "text": "ドメトリー なぜなら、今は私がしたいのは"}, {"type": "subtitle", "time": 25791.67, "timestamp": "07:09:51", "text": "日本にいる間に配信します。わかった。"}, {"type": "subtitle", "time": 25793.628, "timestamp": "07:09:53", "text": "うん、そうしたい"}, {"type": "subtitle", "time": 25796.948, "timestamp": "07:09:56", "text": "ストリーム。正直、配信したいんだけど、"}]
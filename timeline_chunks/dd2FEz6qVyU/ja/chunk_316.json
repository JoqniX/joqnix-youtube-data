[{"type": "subtitle", "time": 18982.39, "timestamp": "05:16:22", "text": "つるはし。さて、最後です。はい、あなたは"}, {"type": "subtitle", "time": 18985.91, "timestamp": "05:16:25", "text": "みんな準備はいい？その後、私は"}, {"type": "subtitle", "time": 18988.11, "timestamp": "05:16:28", "text": "そろそろ締めくくりたいと思います。"}, {"type": "subtitle", "time": 18990.47, "timestamp": "05:16:30", "text": "よし、何があっても、私は包むつもりだ"}, {"type": "subtitle", "time": 19017.03, "timestamp": "05:16:57", "text": "[音楽]"}]
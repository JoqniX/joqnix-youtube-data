[{"type": "subtitle", "time": 26347.83, "timestamp": "07:19:07", "text": "わーい！初めて手に入れたよ"}, {"type": "subtitle", "time": 26350.91, "timestamp": "07:19:10", "text": "このバレンタインデーに"}, {"type": "subtitle", "time": 26353.99, "timestamp": "07:19:13", "text": "日。私は花さえも受け取らない"}, {"type": "subtitle", "time": 26356.75, "timestamp": "07:19:16", "text": "人生。チョコレートは"}, {"type": "subtitle", "time": 26360.23, "timestamp": "07:19:20", "text": "自分の。あ、待って。あなたにflをあげられたのに"}, {"type": "subtitle", "time": 26366.43, "timestamp": "07:19:26", "text": "待って。お花をどうぞ"}, {"type": "subtitle", "time": 26369.19, "timestamp": "07:19:29", "text": "外。今日、花が咲いた。私はすべきでしょうか"}, {"type": "subtitle", "time": 26377.83, "timestamp": "07:19:37", "text": "彼。アンナ、大丈夫だよ。あなたにあげます"}, {"type": "subtitle", "time": 26380.468, "timestamp": "07:19:40", "text": "花。ありがとうございます。わかった。絵文字のように"}, {"type": "subtitle", "time": 26382.67, "timestamp": "07:19:42", "text": "それで十分です。"}, {"type": "subtitle", "time": 26389.27, "timestamp": "07:19:49", "text": "ダダ。たとえ私が花を挿しても"}, {"type": "subtitle", "time": 26391.39, "timestamp": "07:19:51", "text": "外の庭に、"}]
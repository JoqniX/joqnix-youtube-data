[{"type": "subtitle", "time": 24066.11, "timestamp": "06:41:06", "text": "あなたにも何か"}, {"type": "subtitle", "time": 24069.39, "timestamp": "06:41:09", "text": "うん。それはあまりにも"}, {"type": "subtitle", "time": 24072.628, "timestamp": "06:41:12", "text": "うん。あと、えっと、今YouTubeでライブ配信してるよね？"}, {"type": "subtitle", "time": 24076.628, "timestamp": "06:41:16", "text": "前回私のストリームがYouTubeで停止したのは"}, {"type": "subtitle", "time": 24079.83, "timestamp": "06:41:19", "text": "何らかの不明な理由。理由は分かりません。"}, {"type": "subtitle", "time": 24084.11, "timestamp": "06:41:24", "text": "前回の配信では、約"}, {"type": "subtitle", "time": 24087.868, "timestamp": "06:41:27", "text": "えっと、私たちは約"}, {"type": "subtitle", "time": 24091.83, "timestamp": "06:41:31", "text": "10時間くらいだけど、YouTube側だけ"}, {"type": "subtitle", "time": 24095.99, "timestamp": "06:41:35", "text": "6時間分の映像があったのに、壊れてしまった。私の"}, {"type": "subtitle", "time": 24099.51, "timestamp": "06:41:39", "text": "マルチリーム関連のものが途中で壊れてしまった。だからそれは"}, {"type": "subtitle", "time": 24113.03, "timestamp": "06:41:53", "text": "崇拝する。今日の配信では、"}, {"type": "subtitle", "time": 24114.51, "timestamp": "06:41:54", "text": "ほんの少し"}, {"type": "subtitle", "time": 24118.31, "timestamp": "06:41:58", "text": "みんなと話をして"}]
[{"type": "subtitle", "time": 18257.51, "timestamp": "05:04:17", "text": "照準が合っていることを願います。何が"}, {"type": "subtitle", "time": 18260.35, "timestamp": "05:04:20", "text": "景色とは"}, {"type": "subtitle", "time": 18282.59, "timestamp": "05:04:42", "text": "理由？"}, {"type": "subtitle", "time": 18286.35, "timestamp": "05:04:46", "text": "ああ、そうやって手に入れるんですね。わかった、絶対にない"}, {"type": "subtitle", "time": 18289.27, "timestamp": "05:04:49", "text": "心。さあ行こう。最後の銃弾を手に入れた。"}]
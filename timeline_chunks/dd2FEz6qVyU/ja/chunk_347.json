[{"type": "subtitle", "time": 20820.03, "timestamp": "05:47:00", "text": "えっと、ストリームは削除されるんですよね？"}, {"type": "subtitle", "time": 20825.51, "timestamp": "05:47:05", "text": "ああ、わかってるよ、理由はわからないけど。"}, {"type": "subtitle", "time": 20828.31, "timestamp": "05:47:08", "text": "さあ、私がその雰囲気を味わいたいように"}, {"type": "subtitle", "time": 20831.11, "timestamp": "05:47:11", "text": "音楽だが、非企業音楽"}, {"type": "subtitle", "time": 20835.23, "timestamp": "05:47:15", "text": "ひどい音だ、私はそう思わない"}, {"type": "subtitle", "time": 20839.07, "timestamp": "05:47:19", "text": "わからないけど、うん。"}, {"type": "subtitle", "time": 20841.91, "timestamp": "05:47:21", "text": "えーと、これは"}, {"type": "subtitle", "time": 20845.59, "timestamp": "05:47:25", "text": "600人、6時間配信。つまり、私たちは"}, {"type": "subtitle", "time": 20850.47, "timestamp": "05:47:30", "text": "1～2時間ほど待つことになる"}, {"type": "subtitle", "time": 20853.03, "timestamp": "05:47:33", "text": "もしくはあと1時間くらい。そうすれば私たちは"}, {"type": "subtitle", "time": 20856.39, "timestamp": "05:47:36", "text": "Twitchでストリーミング配信しています。それで、"}, {"type": "subtitle", "time": 20859.15, "timestamp": "05:47:39", "text": "これはまるで、誰も止まらないようなものだ"}, {"type": "subtitle", "time": 20862.15, "timestamp": "05:47:42", "text": "ストリーミングは、実際にはすべきではないのですが"}, {"type": "subtitle", "time": 20864.628, "timestamp": "05:47:44", "text": "そうかもしれないけど、よくわからない。ストリーミングしたい"}, {"type": "subtitle", "time": 20866.948, "timestamp": "05:47:46", "text": "これらを確認するにはTwitchをご覧ください。つまり、"}, {"type": "subtitle", "time": 20870.07, "timestamp": "05:47:50", "text": "チェックするものは何もないけど、つまり、私は"}, {"type": "subtitle", "time": 20875.15, "timestamp": "05:47:55", "text": "すでに確認済みなので、"}, {"type": "subtitle", "time": 20878.07, "timestamp": "05:47:58", "text": "知る。えっと、鈴木さん、ストリームに行って、"}]
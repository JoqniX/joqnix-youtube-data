[{"type": "subtitle", "time": 25995.468, "timestamp": "07:13:15", "text": "私はこれをとても誇りに思っています"}, {"type": "subtitle", "time": 26014.27, "timestamp": "07:13:34", "text": "かわいい。しかし"}, {"type": "subtitle", "time": 26017.27, "timestamp": "07:13:37", "text": "うん。では、待ってください。もしあなたが"}, {"type": "subtitle", "time": 26020.39, "timestamp": "07:13:40", "text": "ルームメイトがいたの？何をご希望ですか？"}, {"type": "subtitle", "time": 26023.628, "timestamp": "07:13:43", "text": "あなたならどうしますか？どうすればいいのかわからない"}, {"type": "subtitle", "time": 26034.11, "timestamp": "07:13:54", "text": "初心者。汚れた牛乳はそのままにしておいてください"}, {"type": "subtitle", "time": 26038.83, "timestamp": "07:13:58", "text": "ここ。私が全部食べたと仮定しましょう"}]
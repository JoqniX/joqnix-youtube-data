[{"type": "subtitle", "time": 23820.708, "timestamp": "06:37:00", "text": "みんな。"}, {"type": "subtitle", "time": 23823.51, "timestamp": "06:37:03", "text": "ということで、今回はレオに手紙を渡します"}, {"type": "subtitle", "time": 23826.788, "timestamp": "06:37:06", "text": "そして、もしあなたが"}, {"type": "subtitle", "time": 23830.35, "timestamp": "06:37:10", "text": "トフィーか何か、"}, {"type": "subtitle", "time": 23834.548, "timestamp": "06:37:14", "text": "今日。ええ、もし小さな"}, {"type": "subtitle", "time": 23837.27, "timestamp": "06:37:17", "text": "キャンディーか何か効くものが欲しい"}, {"type": "subtitle", "time": 23839.75, "timestamp": "06:37:19", "text": "君たちに"}, {"type": "subtitle", "time": 23842.868, "timestamp": "06:37:22", "text": "一緒にチョコレートを食べようよ。私はあなたが欲しいです"}, {"type": "subtitle", "time": 23845.27, "timestamp": "06:37:25", "text": "みんなでチョコレートチョコチューを食べよう"}, {"type": "subtitle", "time": 23852.51, "timestamp": "06:37:32", "text": "自分。はい。えっと、ちょっと待ってください。えっと、"}, {"type": "subtitle", "time": 23854.75, "timestamp": "06:37:34", "text": "えーと"}, {"type": "subtitle", "time": 23862.35, "timestamp": "06:37:42", "text": "考え？なぜ"}, {"type": "subtitle", "time": 23866.868, "timestamp": "06:37:46", "text": "それ？待って、待って。なぜそれが"}, {"type": "subtitle", "time": 23870.548, "timestamp": "06:37:50", "text": "Twitchコマンドを表示していますか？えっと、Twitch関連のもの"}, {"type": "subtitle", "time": 23873.43, "timestamp": "06:37:53", "text": "カードのように カード"}, {"type": "subtitle", "time": 23876.548, "timestamp": "06:37:56", "text": "あれ。私のバレンタインデーカード。"}]
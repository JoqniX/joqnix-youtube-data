[{"type": "subtitle", "time": 25620.868, "timestamp": "07:07:00", "text": "それ。下へ降りてください。下へ降りてください。下へ降りてください。行く"}, {"type": "subtitle", "time": 25624.23, "timestamp": "07:07:04", "text": "下。下へ降りてください。"}, {"type": "subtitle", "time": 25627.11, "timestamp": "07:07:07", "text": "私があなたを連れてきたのだから、私も行かないわけにはいかない"}, {"type": "subtitle", "time": 25637.03, "timestamp": "07:07:17", "text": "下。ああ、なんてことだ、これ。あなたが知っている"}, {"type": "subtitle", "time": 25639.67, "timestamp": "07:07:19", "text": "何？両方とも食べます。病気"}, {"type": "subtitle", "time": 25641.99, "timestamp": "07:07:21", "text": "これを食べてください。そうすると楽になる。"}, {"type": "subtitle", "time": 25644.19, "timestamp": "07:07:24", "text": "わかった、"}, {"type": "subtitle", "time": 25663.99, "timestamp": "07:07:43", "text": "一番の問題は私の服です。私はしません"}, {"type": "subtitle", "time": 25666.548, "timestamp": "07:07:46", "text": "汚れてほしいんです。もちろん、できます"}, {"type": "subtitle", "time": 25672.73, "timestamp": "07:07:52", "text": "しかし"}, {"type": "subtitle", "time": 25675.708, "timestamp": "07:07:55", "text": "[音楽]"}, {"type": "subtitle", "time": 25678.99, "timestamp": "07:07:58", "text": "痛み。私は食べ過ぎた"}]
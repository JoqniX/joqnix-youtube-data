[{"type": "subtitle", "time": 26405.51, "timestamp": "07:20:05", "text": "[音楽]"}, {"type": "subtitle", "time": 26407.75, "timestamp": "07:20:07", "text": "最近は手持ちカメラでの撮影をもっと増やしています。"}, {"type": "subtitle", "time": 26409.91, "timestamp": "07:20:09", "text": "バレンタインデーはいかがでしたか？私の"}, {"type": "subtitle", "time": 26412.468, "timestamp": "07:20:12", "text": "バレンタインデーはまさにこれだ ディオ"}, {"type": "subtitle", "time": 26415.67, "timestamp": "07:20:15", "text": "皆さんと一緒にお祝いしたり、話したり"}, {"type": "subtitle", "time": 26418.788, "timestamp": "07:20:18", "text": "そして夕方には荷造りをしなければならない"}, {"type": "subtitle", "time": 26421.788, "timestamp": "07:20:21", "text": "持ち物やその他"}, {"type": "subtitle", "time": 26425.39, "timestamp": "07:20:25", "text": "チェンナイ向け。私はチェンナイに行く予定です"}, {"type": "subtitle", "time": 26434.948, "timestamp": "07:20:34", "text": "テスト。それからあなたは"}, {"type": "subtitle", "time": 26445.59, "timestamp": "07:20:45", "text": "ああ、まだ最後の話をしているのか"}, {"type": "subtitle", "time": 26453.03, "timestamp": "07:20:53", "text": "神。あなたは望んでいた 私は望んでいなかった"}]
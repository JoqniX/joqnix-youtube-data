[{"type": "subtitle", "time": 26700.99, "timestamp": "07:25:00", "text": "1つ？いや、違う。"}, {"type": "subtitle", "time": 26704.948, "timestamp": "07:25:04", "text": "ええと、日本ならあり得ると思います。"}, {"type": "subtitle", "time": 26708.67, "timestamp": "07:25:08", "text": "学校では言語"}, {"type": "subtitle", "time": 26712.59, "timestamp": "07:25:12", "text": "学校だが、"}, {"type": "subtitle", "time": 26715.51, "timestamp": "07:25:15", "text": "学術的には。はぁ。私は行くことができた"}, {"type": "subtitle", "time": 26718.15, "timestamp": "07:25:18", "text": "今日はそこにいたのか？そして私はただ"}, {"type": "subtitle", "time": 26722.91, "timestamp": "07:25:22", "text": "スタッフの息子が好きなもの"}, {"type": "subtitle", "time": 26726.11, "timestamp": "07:25:26", "text": "えーと、例えば"}, {"type": "subtitle", "time": 26728.39, "timestamp": "07:25:28", "text": "チョコレート。昨日はオフラインでした"}, {"type": "subtitle", "time": 26732.59, "timestamp": "07:25:32", "text": "ガラス。私はキャンディーをあげられたのに"}, {"type": "subtitle", "time": 26734.59, "timestamp": "07:25:34", "text": "先生。"}, {"type": "subtitle", "time": 26738.39, "timestamp": "07:25:38", "text": "ええ、私は本当に幸せでした"}, {"type": "subtitle", "time": 26743.548, "timestamp": "07:25:43", "text": "私の日本の先生に会うことができました"}, {"type": "subtitle", "time": 26747.59, "timestamp": "07:25:47", "text": "えーと、現実世界で。"}, {"type": "subtitle", "time": 26749.07, "timestamp": "07:25:49", "text": "彼は現実を生きている"}, {"type": "subtitle", "time": 26754.468, "timestamp": "07:25:54", "text": "近くの、えーと、私たちがいた場所へ"}, {"type": "subtitle", "time": 26759.75, "timestamp": "07:25:59", "text": "授業のために。うん、すごく良かったよ。私"}]
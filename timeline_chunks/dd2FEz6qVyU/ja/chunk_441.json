[{"type": "subtitle", "time": 26462.27, "timestamp": "07:21:02", "text": "でも大丈夫。私はほしくない"}, {"type": "subtitle", "time": 26465.91, "timestamp": "07:21:05", "text": "1つ。何？これらは何ですか？"}, {"type": "subtitle", "time": 26469.15, "timestamp": "07:21:09", "text": "あなたが話しているものは何ですか？"}, {"type": "subtitle", "time": 26486.628, "timestamp": "07:21:26", "text": "それ。考えていなかった。待って、私は言った"}, {"type": "subtitle", "time": 26495.35, "timestamp": "07:21:35", "text": "証拠。私はそんなことは言っていません。"}, {"type": "subtitle", "time": 26500.99, "timestamp": "07:21:40", "text": "平均？あなたは何を"}, {"type": "subtitle", "time": 26504.948, "timestamp": "07:21:44", "text": "平均？ベビーシッターではない。覚えていない"}, {"type": "subtitle", "time": 26507.43, "timestamp": "07:21:47", "text": "その日。私自身、それすら覚えていない。"}, {"type": "subtitle", "time": 26509.788, "timestamp": "07:21:49", "text": "今日はバレンタインデーです。その"}, {"type": "subtitle", "time": 26513.07, "timestamp": "07:21:53", "text": "昨日はキスだった"}, {"type": "subtitle", "time": 26516.27, "timestamp": "07:21:56", "text": "日。シュッシュッポッポ"}, {"type": "subtitle", "time": 26519.31, "timestamp": "07:21:59", "text": "チュー。昨日はキスだった"}]
[{"type": "subtitle", "time": 12060.309, "timestamp": "03:21:00", "text": "でも、これは何だろう、彼らはそうではない"}, {"type": "subtitle", "time": 12062.229, "timestamp": "03:21:02", "text": "新しい技術を何かやっているが、"}, {"type": "subtitle", "time": 12064.75, "timestamp": "03:21:04", "text": "それでも投資すべきだった。"}, {"type": "subtitle", "time": 12067.269, "timestamp": "03:21:07", "text": "わかった。待って、あれは何？浮いてる"}, {"type": "subtitle", "time": 12069.07, "timestamp": "03:21:09", "text": "あれ？"}, {"type": "subtitle", "time": 12073.269, "timestamp": "03:21:13", "text": "N、これは何かの兆候ですか？それとも何ですか？私は"}, {"type": "subtitle", "time": 12075.95, "timestamp": "03:21:15", "text": "ゴッドモードを解除するか"}, {"type": "subtitle", "time": 12090.309, "timestamp": "03:21:30", "text": "ふむ。わかった。えっと、私たちは何をするんでしたっけ？"}, {"type": "subtitle", "time": 12091.229, "timestamp": "03:21:31", "text": "おお、"}, {"type": "subtitle", "time": 12109.19, "timestamp": "03:21:49", "text": "わかった。ああ、もうロックを解除済みだよ。おお、"}]
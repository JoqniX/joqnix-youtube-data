[{"type": "subtitle", "time": 18673.57, "timestamp": "05:11:13", "text": "弾薬が必要なんだ。"}, {"type": "subtitle", "time": 18706.05, "timestamp": "05:11:46", "text": "おお"}, {"type": "subtitle", "time": 18708.83, "timestamp": "05:11:48", "text": "[音楽]"}, {"type": "subtitle", "time": 18711.11, "timestamp": "05:11:51", "text": "いいえ。ここはどこですか？マイナス１、２、"}, {"type": "subtitle", "time": 18713.15, "timestamp": "05:11:53", "text": "三つ。"}, {"type": "subtitle", "time": 18717.99, "timestamp": "05:11:57", "text": "何？よし、ゲームに不具合が発生した。ニース。"}]
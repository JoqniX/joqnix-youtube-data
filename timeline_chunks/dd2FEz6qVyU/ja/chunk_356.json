[{"type": "subtitle", "time": 21361.75, "timestamp": "05:56:01", "text": "プラスとクローム。 Chrome を使うと、"}, {"type": "subtitle", "time": 21363.99, "timestamp": "05:56:03", "text": "うん、音楽とかそういうのと"}, {"type": "subtitle", "time": 21367.03, "timestamp": "05:56:07", "text": "送信機。つまり、8つのプログラムがそれについているということだ。"}, {"type": "subtitle", "time": 21370.868, "timestamp": "05:56:10", "text": "エンコーダーのOBSを過負荷にする"}, {"type": "subtitle", "time": 21375.11, "timestamp": "05:56:15", "text": "若干。でも、私たちは、"}, {"type": "subtitle", "time": 21377.59, "timestamp": "05:56:17", "text": "何かを取り除く"}, {"type": "subtitle", "time": 21380.47, "timestamp": "05:56:20", "text": "不要なもの。うん、まさに"}, {"type": "subtitle", "time": 21383.51, "timestamp": "05:56:23", "text": "いろいろ試しているところです。次のようにテストしています"}, {"type": "subtitle", "time": 21385.91, "timestamp": "05:56:25", "text": "実装とテストテスト"}, {"type": "subtitle", "time": 21388.628, "timestamp": "05:56:28", "text": "うまくいく場合もあれば、うまくいかない場合もある。もしそれが留まることができるなら"}, {"type": "subtitle", "time": 21391.51, "timestamp": "05:56:31", "text": "あるいはそうでない場合、もしこれが、もしこれが"}, {"type": "subtitle", "time": 21393.948, "timestamp": "05:56:33", "text": "うまくいかないので削除します"}, {"type": "subtitle", "time": 21398.51, "timestamp": "05:56:38", "text": "完全にうまくいけば、"}, {"type": "subtitle", "time": 21402.03, "timestamp": "05:56:42", "text": "うん、それで、それで、それで"}, {"type": "subtitle", "time": 21405.03, "timestamp": "05:56:45", "text": "えっと、私はただそうすべきでしょうか"}, {"type": "subtitle", "time": 21407.31, "timestamp": "05:56:47", "text": "YouTube 今日、それとも"}, {"type": "subtitle", "time": 21411.27, "timestamp": "05:56:51", "text": "1で配信を終了した方がいいかな"}, {"type": "subtitle", "time": 21414.11, "timestamp": "05:56:54", "text": "YouTubeに1時間費やした後、Twitchで配信する"}, {"type": "subtitle", "time": 21417.91, "timestamp": "05:56:57", "text": "3時か4時まで"}]
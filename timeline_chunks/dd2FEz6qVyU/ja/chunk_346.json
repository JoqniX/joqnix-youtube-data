[{"type": "subtitle", "time": 20760.43, "timestamp": "05:46:00", "text": "に来る"}, {"type": "subtitle", "time": 20764.47, "timestamp": "05:46:04", "text": "ここでは、費やされたストリームが"}, {"type": "subtitle", "time": 20768.43, "timestamp": "05:46:08", "text": "ワイヤレスポリシー。ああ"}, {"type": "subtitle", "time": 20771.11, "timestamp": "05:46:11", "text": "痛み。あのね？私は与えないかもしれない"}, {"type": "subtitle", "time": 20775.19, "timestamp": "05:46:15", "text": "この音楽、このストリーム、このリメイク。それで"}, {"type": "subtitle", "time": 20777.39, "timestamp": "05:46:17", "text": "息子のように"}, {"type": "subtitle", "time": 20781.948, "timestamp": "05:46:21", "text": "同チャンネルはコミュニティの指導を受ける"}, {"type": "subtitle", "time": 20785.11, "timestamp": "05:46:25", "text": "私の男を攻撃したくない"}, {"type": "subtitle", "time": 20786.83, "timestamp": "05:46:26", "text": "誘導攻撃。"}, {"type": "subtitle", "time": 20789.788, "timestamp": "05:46:29", "text": "ストリーム"}, {"type": "subtitle", "time": 20793.15, "timestamp": "05:46:33", "text": "グローバルにブロックします。"}, {"type": "subtitle", "time": 20796.708, "timestamp": "05:46:36", "text": "ああ、それらを受け取れるといいな。待って。だからこれは"}, {"type": "subtitle", "time": 20798.83, "timestamp": "05:46:38", "text": "これは著作権です"}, {"type": "subtitle", "time": 20803.47, "timestamp": "05:46:43", "text": "何かを倒すのも私です、ええ"}, {"type": "subtitle", "time": 20806.15, "timestamp": "05:46:46", "text": "えっと、酔っ払った私のストリングには、これらが３つあります"}, {"type": "subtitle", "time": 20808.868, "timestamp": "05:46:48", "text": "しかし、7分後には削除されます。"}, {"type": "subtitle", "time": 20811.39, "timestamp": "05:46:51", "text": "削除とは、"}]
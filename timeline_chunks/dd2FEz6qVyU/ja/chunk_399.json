[{"type": "subtitle", "time": 23944.99, "timestamp": "06:39:04", "text": "大変だったけど、私は買った、私は買った"}, {"type": "subtitle", "time": 23952.43, "timestamp": "06:39:12", "text": "えっと、私は買いました"}, {"type": "subtitle", "time": 23953.948, "timestamp": "06:39:13", "text": "えーと"}, {"type": "subtitle", "time": 23957.43, "timestamp": "06:39:17", "text": "チョコレートを食べるために、みんなと一緒に行くよ"}, {"type": "subtitle", "time": 23959.59, "timestamp": "06:39:19", "text": "それが私の頭の中にあった唯一のことだった"}, {"type": "subtitle", "time": 23962.31, "timestamp": "06:39:22", "text": "だって、全然準備できてないんだもん。"}, {"type": "subtitle", "time": 23966.07, "timestamp": "06:39:26", "text": "ああ、だって昨日勉強しなきゃいけなかったんだもん"}, {"type": "subtitle", "time": 23966.83, "timestamp": "06:39:26", "text": "のために"}, {"type": "subtitle", "time": 23969.19, "timestamp": "06:39:29", "text": "テスト。知らない人のために、私は"}, {"type": "subtitle", "time": 23974.35, "timestamp": "06:39:34", "text": "日曜日の試験、私のN5試験"}, {"type": "subtitle", "time": 23978.39, "timestamp": "06:39:38", "text": "日本語。ええ、そうですね。それで、えーと、私は"}, {"type": "subtitle", "time": 23981.91, "timestamp": "06:39:41", "text": "かなり勉強しました。種の"}, {"type": "subtitle", "time": 23983.07, "timestamp": "06:39:43", "text": "神経質"}, {"type": "subtitle", "time": 23992.31, "timestamp": "06:39:52", "text": "V. はい。ええと、私たちは最善を尽くします、"}, {"type": "subtitle", "time": 23993.07, "timestamp": "06:39:53", "text": "推測。"}, {"type": "subtitle", "time": 23997.788, "timestamp": "06:39:57", "text": "うん。えっと、見つからない"}]
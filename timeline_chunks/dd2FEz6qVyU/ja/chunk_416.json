[{"type": "subtitle", "time": 24960.03, "timestamp": "06:56:00", "text": "ああ、なんてことだ、私はむせてしまった"}, {"type": "subtitle", "time": 24962.628, "timestamp": "06:56:02", "text": "それ。私はそれについて話しました。喉に詰まってしまった。"}, {"type": "subtitle", "time": 24992.91, "timestamp": "06:56:32", "text": "喉。しかし"}, {"type": "subtitle", "time": 24995.708, "timestamp": "06:56:35", "text": "えっと、それは"}, {"type": "subtitle", "time": 24997.91, "timestamp": "06:56:37", "text": "美味しい。わかった、あのね？私はただ"}, {"type": "subtitle", "time": 25001.03, "timestamp": "06:56:41", "text": "まず最初に一部を食べ​​てください。私は食べるだけです"}, {"type": "subtitle", "time": 25004.67, "timestamp": "06:56:44", "text": "これくらい。それから残りは"}, {"type": "subtitle", "time": 25008.51, "timestamp": "06:56:48", "text": "私の家族、かな。それとも私は"}, {"type": "subtitle", "time": 25011.11, "timestamp": "06:56:51", "text": "ない？通常は、それを彼らの口に入れます"}, {"type": "subtitle", "time": 25012.11, "timestamp": "06:56:52", "text": "そして与える"}, {"type": "subtitle", "time": 25015.23, "timestamp": "06:56:55", "text": "こっそりと、彼らの後ろに忍び寄り、"}, {"type": "subtitle", "time": 25017.868, "timestamp": "06:56:57", "text": "「私の"}]
[{"type": "subtitle", "time": 10513.11, "timestamp": "02:55:13", "text": "右？いや、いや、いや、いや。私は作ることができた"}, {"type": "subtitle", "time": 10524.309, "timestamp": "02:55:24", "text": "何か"}, {"type": "subtitle", "time": 10545.51, "timestamp": "02:55:45", "text": "チェックポイントの銃弾？ありがとう。ありがとう"}, {"type": "subtitle", "time": 10548.389, "timestamp": "02:55:48", "text": "誰がここにこの樽を置いたのか、そしてその理由は？私"}, {"type": "subtitle", "time": 10551.309, "timestamp": "02:55:51", "text": "わからない。でもありがとう"}, {"type": "subtitle", "time": 10553.59, "timestamp": "02:55:53", "text": "けれど。問題は、押す必要があるということです"}]
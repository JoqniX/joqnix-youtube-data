[{"type": "subtitle", "time": 17161.91, "timestamp": "04:46:01", "text": "行く。さあ行こう。つるはし。何てことだ。の"}, {"type": "subtitle", "time": 17165.19, "timestamp": "04:46:05", "text": "最高の銃。史上最高の武器。ああ、"}, {"type": "subtitle", "time": 17177.708, "timestamp": "04:46:17", "text": "以上、この場所からの報告です。 A"}, {"type": "subtitle", "time": 17180.59, "timestamp": "04:46:20", "text": "つるはし。それは"}, {"type": "subtitle", "time": 17184.43, "timestamp": "04:46:24", "text": "それ。私は家のドアを開けなければならなかった。セクシー。"}, {"type": "subtitle", "time": 17188.59, "timestamp": "04:46:28", "text": "待って。読んだと思う"}, {"type": "subtitle", "time": 17191.35, "timestamp": "04:46:31", "text": "けれど。病気で死にかけたが、神様が"}, {"type": "subtitle", "time": 17200.43, "timestamp": "04:46:40", "text": "うん。こんにちは。こんにちは。私は信じている"}, {"type": "subtitle", "time": 17203.19, "timestamp": "04:46:43", "text": "がある。ああ、もう1箇所あります。"}, {"type": "subtitle", "time": 17206.51, "timestamp": "04:46:46", "text": "わかった。この場所を訪れてみましょう"}]
[{"type": "subtitle", "time": 11227.75, "timestamp": "03:07:07", "text": "実はこの場所が恋しかったんだと思う。"}, {"type": "subtitle", "time": 11245.87, "timestamp": "03:07:25", "text": "空に向かって押し上げられるあの勢い？ああ、この氷"}, {"type": "subtitle", "time": 11256.67, "timestamp": "03:07:36", "text": "ブルース、ゴーゴーゴーゴー"}, {"type": "subtitle", "time": 11259.469, "timestamp": "03:07:39", "text": "ゆっくり。まで"}, {"type": "subtitle", "time": 11268.389, "timestamp": "03:07:48", "text": "雪。さあ行こう。私たちはここにいます。開始する"}, {"type": "subtitle", "time": 11270.99, "timestamp": "03:07:50", "text": "戦い。さあ行こう。その時が来た"}, {"type": "subtitle", "time": 11273.389, "timestamp": "03:07:53", "text": "殺す。誰"}, {"type": "subtitle", "time": 11276.19, "timestamp": "03:07:56", "text": "次？この地球儀は何ですか？"}]
[{"type": "subtitle", "time": 11358.99, "timestamp": "03:09:18", "text": "再装填。"}, {"type": "subtitle", "time": 11361.83, "timestamp": "03:09:21", "text": "いいえ、それはできません。どうしたの？何"}, {"type": "subtitle", "time": 11365.19, "timestamp": "03:09:25", "text": "何が起こったのか？どうしたの？"}, {"type": "subtitle", "time": 11367.79, "timestamp": "03:09:27", "text": "私を戻して。何"}, {"type": "subtitle", "time": 11371.71, "timestamp": "03:09:31", "text": "何が起こったのか？どうしたの？"}, {"type": "subtitle", "time": 11375.349, "timestamp": "03:09:35", "text": "待って。戻らせてください。待って。なぜこれが"}, {"type": "subtitle", "time": 11377.07, "timestamp": "03:09:37", "text": "立ち往生？"}, {"type": "subtitle", "time": 11380.83, "timestamp": "03:09:40", "text": "何？私は何をしたの？"}]
[{"type": "subtitle", "time": 25141.628, "timestamp": "06:59:01", "text": "君は、このレベルのディックスだ"}, {"type": "subtitle", "time": 25143.468, "timestamp": "06:59:03", "text": "牛乳"}, {"type": "subtitle", "time": 25147.03, "timestamp": "06:59:07", "text": "45ドルくらいで買ったチョコレート"}, {"type": "subtitle", "time": 25149.39, "timestamp": "06:59:09", "text": "もし私が"}, {"type": "subtitle", "time": 25157.43, "timestamp": "06:59:17", "text": "実際には普通のキャンディーのような味がする"}, {"type": "subtitle", "time": 25158.99, "timestamp": "06:59:18", "text": "である"}, {"type": "subtitle", "time": 25161.43, "timestamp": "06:59:21", "text": "正直。チョコレートのようなキャンディーではない"}, {"type": "subtitle", "time": 25164.788, "timestamp": "06:59:24", "text": "でも、これは、これは"}, {"type": "subtitle", "time": 25166.708, "timestamp": "06:59:26", "text": "キャンディー。これは"}, {"type": "subtitle", "time": 25168.708, "timestamp": "06:59:28", "text": "私が買ったチョコレート"}, {"type": "subtitle", "time": 25171.27, "timestamp": "06:59:31", "text": "過去も同様です。私は買いたかった"}, {"type": "subtitle", "time": 25173.788, "timestamp": "06:59:33", "text": "高価なもの。それから私は"}, {"type": "subtitle", "time": 25176.91, "timestamp": "06:59:36", "text": "本当にそう思う"}, {"type": "subtitle", "time": 25179.91, "timestamp": "06:59:39", "text": "必要だけど、大丈夫。しかし味は"}, {"type": "subtitle", "time": 25180.99, "timestamp": "06:59:40", "text": "本当に"}, {"type": "subtitle", "time": 25183.07, "timestamp": "06:59:43", "text": "良い"}, {"type": "subtitle", "time": 25186.27, "timestamp": "06:59:46", "text": "少量を摂取すると"}, {"type": "subtitle", "time": 25189.19, "timestamp": "06:59:49", "text": "噛む"}, {"type": "subtitle", "time": 25192.708, "timestamp": "06:59:52", "text": "えっと、なんて呼ぶんだっけ？溶けるような感じ"}, {"type": "subtitle", "time": 25195.788, "timestamp": "06:59:55", "text": "口の中、舌の中"}, {"type": "subtitle", "time": 25198.23, "timestamp": "06:59:58", "text": "実は。チョコレート"}]
[{"type": "subtitle", "time": 26223.31, "timestamp": "07:17:03", "text": "あなた"}, {"type": "subtitle", "time": 26227.31, "timestamp": "07:17:07", "text": "チョコレートホー。いいえ、私はなりたくない"}, {"type": "subtitle", "time": 26230.15, "timestamp": "07:17:10", "text": "敵。蝶をあげます"}, {"type": "subtitle", "time": 26234.11, "timestamp": "07:17:14", "text": "痛みとの交換"}, {"type": "subtitle", "time": 26239.72, "timestamp": "07:17:19", "text": "私は蝶は要らない。とてもかわいい。"}, {"type": "subtitle", "time": 26241.43, "timestamp": "07:17:21", "text": "[音楽]"}, {"type": "subtitle", "time": 26244.23, "timestamp": "07:17:24", "text": "こんにちは。ハッピーバレンタインデー。あなたは"}, {"type": "subtitle", "time": 26245.31, "timestamp": "07:17:25", "text": "食べたい"}, {"type": "subtitle", "time": 26247.75, "timestamp": "07:17:27", "text": "チョコレート？チョコレートを食べたい"}]
[{"type": "subtitle", "time": 13207.63, "timestamp": "03:40:07", "text": "楽しい。その"}, {"type": "subtitle", "time": 13210.99, "timestamp": "03:40:10", "text": "以上。すべてに気を配る"}, {"type": "subtitle", "time": 13215.19, "timestamp": "03:40:15", "text": "モジュール。最後の帽子選びが終わりました。探す"}, {"type": "subtitle", "time": 13216.11, "timestamp": "03:40:16", "text": "全て"}, {"type": "subtitle", "time": 13218.19, "timestamp": "03:40:18", "text": "兵器。"}, {"type": "subtitle", "time": 13220.83, "timestamp": "03:40:20", "text": "もう終わりだ。"}, {"type": "subtitle", "time": 13223.309, "timestamp": "03:40:23", "text": "実際、ゲームは"}, {"type": "subtitle", "time": 13227.67, "timestamp": "03:40:27", "text": "以上。悲しい気持ちです。泣きたい。"}, {"type": "subtitle", "time": 13231.229, "timestamp": "03:40:31", "text": "泣きたい。それは"}, {"type": "subtitle", "time": 13240.87, "timestamp": "03:40:40", "text": "ピュー？でも、私はピューを人生に取り入れたい。"}, {"type": "subtitle", "time": 13253.07, "timestamp": "03:40:53", "text": "それ？それは本当に"}]
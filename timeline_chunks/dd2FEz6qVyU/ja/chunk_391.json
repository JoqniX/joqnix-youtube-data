[{"type": "subtitle", "time": 23462.15, "timestamp": "06:31:02", "text": "ストリーム。こんにちは。そこで、ストリーミング配信を思いついた。"}, {"type": "subtitle", "time": 23465.11, "timestamp": "06:31:05", "text": "今日11時にTwitchで配信しますが、"}, {"type": "subtitle", "time": 23468.15, "timestamp": "06:31:08", "text": "8時間配信してきたので休憩します"}, {"type": "subtitle", "time": 23471.788, "timestamp": "06:31:11", "text": "もう何時間も経っている。"}, {"type": "subtitle", "time": 23473.868, "timestamp": "06:31:13", "text": "うん。"}, {"type": "subtitle", "time": 23481.27, "timestamp": "06:31:21", "text": "来てくださった皆さん、ありがとうございました。"}, {"type": "subtitle", "time": 23484.39, "timestamp": "06:31:24", "text": "今日。えっと、今日はチームメンバーで、"}, {"type": "subtitle", "time": 23488.83, "timestamp": "06:31:28", "text": "田倉ヅキカサンに滞在"}, {"type": "subtitle", "time": 23490.51, "timestamp": "06:31:30", "text": "えっと"}, {"type": "subtitle", "time": 23494.31, "timestamp": "06:31:34", "text": "DTSCami ブルーキャット アンブル"}, {"type": "subtitle", "time": 23498.31, "timestamp": "06:31:38", "text": "ウム・アリウム・アリ"}, {"type": "subtitle", "time": 23501.07, "timestamp": "06:31:41", "text": "えっと、アリさん"}, {"type": "subtitle", "time": 23504.548, "timestamp": "06:31:44", "text": "ドリーマン・ヘリックス、彼は、彼が来たと思う"}, {"type": "subtitle", "time": 23512.708, "timestamp": "06:31:52", "text": "ちょっとえっと、それからハニーアン、それから魂の魂と"}, {"type": "subtitle", "time": 23516.548, "timestamp": "06:31:56", "text": "Mゲーミング。ええ、ケン・アーンです。えっと、他に何か？"}, {"type": "subtitle", "time": 23517.788, "timestamp": "06:31:57", "text": "誰が"}]
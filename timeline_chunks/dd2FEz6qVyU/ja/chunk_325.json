[{"type": "subtitle", "time": 19515.39, "timestamp": "05:25:15", "text": "それはとても"}, {"type": "subtitle", "time": 19519.19, "timestamp": "05:25:19", "text": "いいね。終わりました。 SMGを見つける方法"}, {"type": "subtitle", "time": 19520.708, "timestamp": "05:25:20", "text": "拳銃の弾薬？待って、私は見つける必要がある"}, {"type": "subtitle", "time": 19521.55, "timestamp": "05:25:21", "text": "ピストル"}, {"type": "subtitle", "time": 19524.708, "timestamp": "05:25:24", "text": "弾薬。これはそうだ。"}, {"type": "subtitle", "time": 19527.55, "timestamp": "05:25:27", "text": "拳銃は一体どこにあったんだっけ？"}, {"type": "subtitle", "time": 19530.27, "timestamp": "05:25:30", "text": "うん。"}, {"type": "subtitle", "time": 19533.15, "timestamp": "05:25:33", "text": "いいえ。どこにあるのですか？これは"}, {"type": "subtitle", "time": 19541.31, "timestamp": "05:25:41", "text": "する。あなたはここにいますか？"}, {"type": "subtitle", "time": 19556.27, "timestamp": "05:25:56", "text": "けれど。この静止画"}, {"type": "subtitle", "time": 19559.91, "timestamp": "05:25:59", "text": "私のブラを見ないで。あなたの"}]
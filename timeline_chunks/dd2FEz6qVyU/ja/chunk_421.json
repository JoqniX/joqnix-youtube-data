[{"type": "subtitle", "time": 25261.51, "timestamp": "07:01:01", "text": "噛む。シンプルなチョコレート、"}, {"type": "subtitle", "time": 25263.23, "timestamp": "07:01:03", "text": "その方が良い。"}, {"type": "subtitle", "time": 25274.708, "timestamp": "07:01:14", "text": "ほら、このチョコレートは"}, {"type": "subtitle", "time": 25277.39, "timestamp": "07:01:17", "text": "幼少期に私がしたことについて。"}, {"type": "subtitle", "time": 25280.548, "timestamp": "07:01:20", "text": "正直に言うと、私が高校生の頃、"}, {"type": "subtitle", "time": 25282.35, "timestamp": "07:01:22", "text": "昔買っていたもの"}, {"type": "subtitle", "time": 25285.27, "timestamp": "07:01:25", "text": "チョコレートをみんなに配る"}, {"type": "subtitle", "time": 25302.59, "timestamp": "07:01:42", "text": "うん、それはまるで私が支払ったようなものだった"}, {"type": "subtitle", "time": 25306.07, "timestamp": "07:01:46", "text": "多くの。だからチョコレートは全部"}, {"type": "subtitle", "time": 25312.07, "timestamp": "07:01:52", "text": "周りは正直私の数人のために"}, {"type": "subtitle", "time": 25314.11, "timestamp": "07:01:54", "text": "友達"}]
[{"type": "subtitle", "time": 26883.11, "timestamp": "07:28:03", "text": "えっと、私の何？どうやら彼らは達人らしい。"}, {"type": "subtitle", "time": 26885.83, "timestamp": "07:28:05", "text": "何？彼らにはさまざまな種類のオーがあります。"}, {"type": "subtitle", "time": 26887.23, "timestamp": "07:28:07", "text": "あなたはそうしなかった"}, {"type": "subtitle", "time": 26891.35, "timestamp": "07:28:11", "text": "ジョーワン。私は持っています。何？私はそうは思わない"}, {"type": "subtitle", "time": 26892.51, "timestamp": "07:28:12", "text": "一つ持っています。"}, {"type": "subtitle", "time": 26895.27, "timestamp": "07:28:15", "text": "バカ、それは君の想像だよ。それは"}, {"type": "subtitle", "time": 26897.31, "timestamp": "07:28:17", "text": "あなたの"}, {"type": "subtitle", "time": 26899.628, "timestamp": "07:28:19", "text": "夢。"}, {"type": "subtitle", "time": 26903.43, "timestamp": "07:28:23", "text": "だから、私は、"}, {"type": "subtitle", "time": 26906.11, "timestamp": "07:28:26", "text": "恋愛とかそういう類のこと。わからない"}, {"type": "subtitle", "time": 26910.468, "timestamp": "07:28:30", "text": "多くの。私はまだデートすらしたことがないんです。"}, {"type": "subtitle", "time": 26913.27, "timestamp": "07:28:33", "text": "私も一度体験してみたいです。"}, {"type": "subtitle", "time": 26915.23, "timestamp": "07:28:35", "text": "でも私の場合は"}, {"type": "subtitle", "time": 26919.51, "timestamp": "07:28:39", "text": "あまり現実的に作りすぎているのかもしれません。私"}, {"type": "subtitle", "time": 26924.948, "timestamp": "07:28:44", "text": "私の世界は"}, {"type": "subtitle", "time": 26928.15, "timestamp": "07:28:48", "text": "ロマンスとかそういうのは"}, {"type": "subtitle", "time": 26932.07, "timestamp": "07:28:52", "text": "えーっと、インスピレーションを受けたというか、もっとよく知られているというか"}, {"type": "subtitle", "time": 26933.31, "timestamp": "07:28:53", "text": "アニメと"}, {"type": "subtitle", "time": 26937.43, "timestamp": "07:28:57", "text": "アニメの小説など"}, {"type": "subtitle", "time": 26939.15, "timestamp": "07:28:59", "text": "ロマンティックコメディ"}]
[{"type": "subtitle", "time": 16323.269, "timestamp": "04:32:03", "text": "[音楽]"}, {"type": "subtitle", "time": 16342.389, "timestamp": "04:32:22", "text": "ああ、すごく混乱してる。どこ？ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 16344.63, "timestamp": "04:32:24", "text": "なんてバカなんだ。バカ、そこは場所じゃないよ"}, {"type": "subtitle", "time": 16348.03, "timestamp": "04:32:28", "text": "私は見なければならない。"}, {"type": "subtitle", "time": 16351.74, "timestamp": "04:32:31", "text": "ああ、ばか。大きい"}, {"type": "subtitle", "time": 16358.389, "timestamp": "04:32:38", "text": "ダミー。わかった。えっと、これを徹底的に調べないと"}]
[{"type": "subtitle", "time": 10925.67, "timestamp": "03:02:05", "text": "忘れること。気づく時間がある"}, {"type": "subtitle", "time": 10928.59, "timestamp": "03:02:08", "text": "忙しい時の弾薬"}, {"type": "subtitle", "time": 10931.79, "timestamp": "03:02:11", "text": "動いている、あなた"}, {"type": "subtitle", "time": 10934.11, "timestamp": "03:02:14", "text": "知る。では、待ってください。"}, {"type": "subtitle", "time": 10937.99, "timestamp": "03:02:17", "text": "えっと、この大きな銃を修理するのは私だったっけ？"}, {"type": "subtitle", "time": 10940.309, "timestamp": "03:02:20", "text": "見逃したのかな？"}, {"type": "subtitle", "time": 10941.55, "timestamp": "03:02:21", "text": "彼を押して"}, {"type": "subtitle", "time": 10944.07, "timestamp": "03:02:24", "text": "運。待って、直しちゃいけないの？"}, {"type": "subtitle", "time": 10953.91, "timestamp": "03:02:33", "text": "彼は考えを巡らせる。向こうで何が起きてるの？"}, {"type": "subtitle", "time": 10955.71, "timestamp": "03:02:35", "text": "あの砂漠"}, {"type": "subtitle", "time": 10968.63, "timestamp": "03:02:48", "text": "いいえ。ああ、ただまっすぐ見てください"}, {"type": "subtitle", "time": 10971.349, "timestamp": "03:02:51", "text": "空を見上げると、なんだか上へと押し上げてくれるような気がする。"}, {"type": "subtitle", "time": 10973.309, "timestamp": "03:02:53", "text": "なるほど、それは実際"}, {"type": "subtitle", "time": 10976.91, "timestamp": "03:02:56", "text": "いいね。起きる"}]
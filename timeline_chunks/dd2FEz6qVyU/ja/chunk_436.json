[{"type": "subtitle", "time": 26175.39, "timestamp": "07:16:15", "text": "分。今行ってる"}, {"type": "subtitle", "time": 26178.468, "timestamp": "07:16:18", "text": "戻る。でも、私が知らないことは"}, {"type": "subtitle", "time": 26181.83, "timestamp": "07:16:21", "text": "あれって、まさか牛乳なの？はい。それは"}, {"type": "subtitle", "time": 26186.51, "timestamp": "07:16:26", "text": "D？私たちはそれを食べた。私たちは4つのD uh乳製品ミックスを食べました"}, {"type": "subtitle", "time": 26188.75, "timestamp": "07:16:28", "text": "スライス。あなたは欲しい"}, {"type": "subtitle", "time": 26191.708, "timestamp": "07:16:31", "text": "もっと？それは少し多めですね。私たちはこれを食べた"}, {"type": "subtitle", "time": 26194.868, "timestamp": "07:16:34", "text": "多くの。これくらいだ。これがある"}, {"type": "subtitle", "time": 26197.07, "timestamp": "07:16:37", "text": "多くの"}, {"type": "subtitle", "time": 26199.548, "timestamp": "07:16:39", "text": "左。欲しいですか"}, {"type": "subtitle", "time": 26203.07, "timestamp": "07:16:43", "text": "クロニ？ハッピーバレンタイン"}, {"type": "subtitle", "time": 26205.91, "timestamp": "07:16:45", "text": "日。チョコレートを召し上がっても構いません"}, {"type": "subtitle", "time": 26208.35, "timestamp": "07:16:48", "text": "私たちと一緒に。ぜひお越しください"}, {"type": "subtitle", "time": 26212.07, "timestamp": "07:16:52", "text": "食べる。今日はチョコレートを食べましょう。私は行きます"}, {"type": "subtitle", "time": 26213.948, "timestamp": "07:16:53", "text": "餌を与える"}]
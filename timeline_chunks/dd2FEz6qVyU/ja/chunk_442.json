[{"type": "subtitle", "time": 26523.03, "timestamp": "07:22:03", "text": "日。午前1時。私は寝酔いしていた。私は"}, {"type": "subtitle", "time": 26525.39, "timestamp": "07:22:05", "text": "でたらめを言う、バカバカバカ"}, {"type": "subtitle", "time": 26529.51, "timestamp": "07:22:09", "text": "もの。私はその雄牛を言おうとしていた"}, {"type": "subtitle", "time": 26541.708, "timestamp": "07:22:21", "text": "自分自身。じゃあ、１、２、３、４、５、"}, {"type": "subtitle", "time": 26546.548, "timestamp": "07:22:26", "text": "六。わかった。 6箱"}, {"type": "subtitle", "time": 26549.27, "timestamp": "07:22:29", "text": "物はそこにある。キャンディーのポットが6つ"}, {"type": "subtitle", "time": 26552.39, "timestamp": "07:22:32", "text": "ありますか。なんてこった。キャンディーの小分け。"}, {"type": "subtitle", "time": 26554.91, "timestamp": "07:22:34", "text": "１、２、３、４、５、"}, {"type": "subtitle", "time": 26557.91, "timestamp": "07:22:37", "text": "六。ああ、神様。私は何をしますか？食べるべきか"}, {"type": "subtitle", "time": 26559.59, "timestamp": "07:22:39", "text": "それか、私はそれを私の"}, {"type": "subtitle", "time": 26560.67, "timestamp": "07:22:40", "text": "家族"}, {"type": "subtitle", "time": 26563.35, "timestamp": "07:22:43", "text": "それから？おお。そうそう。私は自分の"}, {"type": "subtitle", "time": 26565.27, "timestamp": "07:22:45", "text": "犬と猫は別だけどね。最後にやった"}, {"type": "subtitle", "time": 26568.07, "timestamp": "07:22:48", "text": "年。ああ、忘れてた。私が知っているか"}, {"type": "subtitle", "time": 26573.75, "timestamp": "07:22:53", "text": "いつもペットにヴァンデーキャンディーをあげています"}, {"type": "subtitle", "time": 26576.708, "timestamp": "07:22:56", "text": "同じように。彼らはそれをとても気に入っている。"}]
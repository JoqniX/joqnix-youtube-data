[{"type": "subtitle", "time": 25323.23, "timestamp": "07:02:03", "text": "チョコレートと"}, {"type": "subtitle", "time": 25326.468, "timestamp": "07:02:06", "text": "そう、それで彼らは「私たちも欲しい」って言ったんだ"}, {"type": "subtitle", "time": 25329.15, "timestamp": "07:02:09", "text": "配布しなければならなかった"}, {"type": "subtitle", "time": 25331.51, "timestamp": "07:02:11", "text": "すべて。来年は私は"}, {"type": "subtitle", "time": 25333.628, "timestamp": "07:02:13", "text": "実際に配布しました"}, {"type": "subtitle", "time": 25337.27, "timestamp": "07:02:17", "text": "授業が終わる前にきちんと。私が与えた"}, {"type": "subtitle", "time": 25338.67, "timestamp": "07:02:18", "text": "それを"}, {"type": "subtitle", "time": 25341.27, "timestamp": "07:02:21", "text": "教師。チョコレートにあげた"}, {"type": "subtitle", "time": 25343.708, "timestamp": "07:02:23", "text": "教師"}, {"type": "subtitle", "time": 25345.23, "timestamp": "07:02:25", "text": "初め"}, {"type": "subtitle", "time": 25348.468, "timestamp": "07:02:28", "text": "ええ、私はそれを全員に配布しました。私"}, {"type": "subtitle", "time": 25351.35, "timestamp": "07:02:31", "text": "その日はそれを私の誕生日のお祝いとして扱った"}, {"type": "subtitle", "time": 25353.27, "timestamp": "07:02:33", "text": "実は。"}, {"type": "subtitle", "time": 25356.548, "timestamp": "07:02:36", "text": "ほら、高校とかでは、"}, {"type": "subtitle", "time": 25358.39, "timestamp": "07:02:38", "text": "誕生日には、"}, {"type": "subtitle", "time": 25363.91, "timestamp": "07:02:43", "text": "200個か500個のトフィーのようなキャンディーを買う"}, {"type": "subtitle", "time": 25367.27, "timestamp": "07:02:47", "text": "パケットですよね？そして、あなたはそれを与える"}, {"type": "subtitle", "time": 25369.35, "timestamp": "07:02:49", "text": "CL 全体に配布するのではなく"}, {"type": "subtitle", "time": 25371.43, "timestamp": "07:02:51", "text": "すべてのクラス、あなたの教室、それから"}, {"type": "subtitle", "time": 25373.43, "timestamp": "07:02:53", "text": "それから先生方、それから校長先生へ"}, {"type": "subtitle", "time": 25374.43, "timestamp": "07:02:54", "text": "以上"}, {"type": "subtitle", "time": 25377.628, "timestamp": "07:02:57", "text": "物事、スタッフオーバー"}]
[{"type": "subtitle", "time": 20100.67, "timestamp": "05:35:00", "text": "おお。しかし"}, {"type": "subtitle", "time": 20102.99, "timestamp": "05:35:02", "text": "ええ、本当に"}, {"type": "subtitle", "time": 20118.31, "timestamp": "05:35:18", "text": "おお。ああ、大変だ。笑顔が止まらない。その"}, {"type": "subtitle", "time": 20120.948, "timestamp": "05:35:20", "text": "とても楽しいゲームだ。楽しかったです。私は愛する"}, {"type": "subtitle", "time": 20128.31, "timestamp": "05:35:28", "text": "これ。ええ、そうですね。えーと、まとめましょう。"}, {"type": "subtitle", "time": 20131.43, "timestamp": "05:35:31", "text": "来てくださった皆様、ありがとうございました。えっと、アーチャ、"}, {"type": "subtitle", "time": 20133.91, "timestamp": "05:35:33", "text": "お越しいただきありがとうございます。バムゲーミングファミリー"}, {"type": "subtitle", "time": 20137.27, "timestamp": "05:35:37", "text": "バマンさん、来てくれてありがとう。"}, {"type": "subtitle", "time": 20139.11, "timestamp": "05:35:39", "text": "アラサ、来てくれてありがとう、そして"}, {"type": "subtitle", "time": 20142.15, "timestamp": "05:35:42", "text": "編集していただきありがとうございます。そうだった"}, {"type": "subtitle", "time": 20144.07, "timestamp": "05:35:44", "text": "本当に美しい。とても気に入りました。ありがとう"}, {"type": "subtitle", "time": 20148.23, "timestamp": "05:35:48", "text": "私の編集画像を作るなんて、一体どういうことなんだろう。"}, {"type": "subtitle", "time": 20149.15, "timestamp": "05:35:49", "text": "感謝"}, {"type": "subtitle", "time": 20152.07, "timestamp": "05:35:52", "text": "あなた。ヒッポ・レンソンさん、ありがとうございます。"}, {"type": "subtitle", "time": 20153.91, "timestamp": "05:35:53", "text": "そちらも来ます。久しぶりですね。"}, {"type": "subtitle", "time": 20155.07, "timestamp": "05:35:55", "text": "感謝"}, {"type": "subtitle", "time": 20159.31, "timestamp": "05:35:59", "text": "あなた。ありがとう。ご来場ありがとうございました"}]
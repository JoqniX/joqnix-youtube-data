[{"type": "subtitle", "time": 17232.708, "timestamp": "04:47:12", "text": "はい。そこへ行こう。それでは計算してみましょう"}, {"type": "subtitle", "time": 17236.23, "timestamp": "04:47:16", "text": "長距離移動が必要でした。だから私は行く"}, {"type": "subtitle", "time": 17271.19, "timestamp": "04:47:51", "text": "何？待って、なぜリセットされているの？はぁ？"}, {"type": "subtitle", "time": 17274.23, "timestamp": "04:47:54", "text": "私は行くことになっている。ああ、それなら間違った方向だったんですね。"}, {"type": "subtitle", "time": 17274.99, "timestamp": "04:47:54", "text": "私"}, {"type": "subtitle", "time": 17279.15, "timestamp": "04:47:59", "text": "推測。いいえ、それは荷車道です。これ"}]
[{"type": "subtitle", "time": 18902.83, "timestamp": "05:15:02", "text": "終わり。そして私たちは"}, {"type": "subtitle", "time": 18914.55, "timestamp": "05:15:14", "text": "楽しい。ああ、しまった。とても楽しかった。欲しい"}, {"type": "subtitle", "time": 18918.39, "timestamp": "05:15:18", "text": "これをもっとプレイしたいのですが、また、"}, {"type": "subtitle", "time": 18926.15, "timestamp": "05:15:26", "text": "はぁ？私はこのゲームを開封する自分の姿を想像できる"}, {"type": "subtitle", "time": 18927.868, "timestamp": "05:15:27", "text": "ただやるだけ"}, {"type": "subtitle", "time": 18930.47, "timestamp": "05:15:30", "text": "これ。あのね？プレイするかもしれない"}, {"type": "subtitle", "time": 18932.83, "timestamp": "05:15:32", "text": "このような類似のゲーム、私は"}, {"type": "subtitle", "time": 18936.11, "timestamp": "05:15:36", "text": "推測。給料は良くならないし、"}, {"type": "subtitle", "time": 18940.47, "timestamp": "05:15:40", "text": "だって、すごく楽しいから。いいえ。"}, {"type": "subtitle", "time": 18941.868, "timestamp": "05:15:41", "text": "1つ"}]
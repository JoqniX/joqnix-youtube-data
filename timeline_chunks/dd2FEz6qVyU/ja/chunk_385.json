[{"type": "subtitle", "time": 23100.47, "timestamp": "06:25:00", "text": "中上さんにコラボを依頼したら、彼はこう言った"}, {"type": "subtitle", "time": 23104.948, "timestamp": "06:25:04", "text": "私は、とりわけ以下のものに限定されます。見てみましょう。"}, {"type": "subtitle", "time": 23107.99, "timestamp": "06:25:07", "text": "ええ、私にとっては特に"}, {"type": "subtitle", "time": 23110.47, "timestamp": "06:25:10", "text": "まるでみんなが私を招待してくれたみたいだった"}, {"type": "subtitle", "time": 23112.548, "timestamp": "06:25:12", "text": "コラボレーションのため。コラボはしたことがありません"}, {"type": "subtitle", "time": 23115.59, "timestamp": "06:25:15", "text": "彼らと共に。私が彼らのところへ行く。私はしていません"}, {"type": "subtitle", "time": 23118.628, "timestamp": "06:25:18", "text": "主に私が望んでいたからやったのであって、私は望んでいない"}, {"type": "subtitle", "time": 23120.628, "timestamp": "06:25:20", "text": "私はまだYouTuberではないので、そうするつもりです。"}, {"type": "subtitle", "time": 23123.03, "timestamp": "06:25:23", "text": "そこでは、人々による講演が行われ、"}, {"type": "subtitle", "time": 23124.23, "timestamp": "06:25:24", "text": "右？"}, {"type": "subtitle", "time": 23127.11, "timestamp": "06:25:27", "text": "普通の男に見えるこの男が"}, {"type": "subtitle", "time": 23131.75, "timestamp": "06:25:31", "text": "えーと、YouTuberとFLのようなストリーマーと"}, {"type": "subtitle", "time": 23135.67, "timestamp": "06:25:35", "text": "自分をYouTuberと呼んでいるのか？ええ、全部"}, {"type": "subtitle", "time": 23139.75, "timestamp": "06:25:39", "text": "株とかそういうもの。えっと、分かりません。"}, {"type": "subtitle", "time": 23142.708, "timestamp": "06:25:42", "text": "でも、私は、私が手に入れたら好きになりたい"}, {"type": "subtitle", "time": 23146.31, "timestamp": "06:25:46", "text": "OCの運用は完了しました。つまり、もし私がそうしたければ"}, {"type": "subtitle", "time": 23149.99, "timestamp": "06:25:49", "text": "スピードランのようにPを作成および設計できます。"}, {"type": "subtitle", "time": 23152.628, "timestamp": "06:25:52", "text": "もし私がその気になれば、デザインを作ることもできる。"}, {"type": "subtitle", "time": 23154.27, "timestamp": "06:25:54", "text": "準備はできています。"}, {"type": "subtitle", "time": 23157.11, "timestamp": "06:25:57", "text": "でも、理由はわからないけど、"}]
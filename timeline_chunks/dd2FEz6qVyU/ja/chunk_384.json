[{"type": "subtitle", "time": 23040.11, "timestamp": "06:24:00", "text": "それへ。そして私の昔の創造性も"}, {"type": "subtitle", "time": 23044.15, "timestamp": "06:24:04", "text": "考え方、つまりアイデアを持たなければならないということ。"}, {"type": "subtitle", "time": 23046.788, "timestamp": "06:24:06", "text": "そして、これらのアイデアを実行に移す。おお、"}, {"type": "subtitle", "time": 23049.35, "timestamp": "06:24:09", "text": "うん。また、ズキ、あなたは持っていないのですか"}, {"type": "subtitle", "time": 23055.31, "timestamp": "06:24:15", "text": "行く？そろそろ"}, {"type": "subtitle", "time": 23062.51, "timestamp": "06:24:22", "text": "ストリーム。ただストリーミングするだけ、"}, {"type": "subtitle", "time": 23065.91, "timestamp": "06:24:25", "text": "バカ。まだ始めていません。わかった。何ですか"}, {"type": "subtitle", "time": 23067.67, "timestamp": "06:24:27", "text": "これ？これは何ですか？これは何ですか？カスタム"}, {"type": "subtitle", "time": 23068.59, "timestamp": "06:24:28", "text": "血"}, {"type": "subtitle", "time": 23076.99, "timestamp": "06:24:36", "text": "何？ええ、3Dを使えば"}, {"type": "subtitle", "time": 23081.43, "timestamp": "06:24:41", "text": "何でも。これは、"}, {"type": "subtitle", "time": 23083.948, "timestamp": "06:24:43", "text": "このソフトウェアは"}, {"type": "subtitle", "time": 23087.43, "timestamp": "06:24:47", "text": "実は。 Blenderか"}, {"type": "subtitle", "time": 23089.15, "timestamp": "06:24:49", "text": "または映画"}]
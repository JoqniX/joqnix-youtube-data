[{"type": "subtitle", "time": 8883.59, "timestamp": "02:28:03", "text": "ええ、私がこんなに疲れている理由を教えてあげましょう。"}, {"type": "subtitle", "time": 8892.87, "timestamp": "02:28:12", "text": "外。外にいるのは私には疲れすぎる。"}, {"type": "subtitle", "time": 8895.19, "timestamp": "02:28:15", "text": "俺は日本に行くんだぜ。私は"}, {"type": "subtitle", "time": 8898.07, "timestamp": "02:28:18", "text": "アルバイトとかをするつもりです。"}, {"type": "subtitle", "time": 8899.71, "timestamp": "02:28:19", "text": "私は苦しむだろう"}, {"type": "subtitle", "time": 8901.73, "timestamp": "02:28:21", "text": "難しい質問"}, {"type": "subtitle", "time": 8926.349, "timestamp": "02:28:46", "text": "おお。そのことが頭から離れない。のように、"}]
[{"type": "subtitle", "time": 13929.54, "timestamp": "03:52:09", "text": "右？そうではなかった。または"}, {"type": "subtitle", "time": 13930.91, "timestamp": "03:52:10", "text": "[音楽]"}, {"type": "subtitle", "time": 13934.269, "timestamp": "03:52:14", "text": "何？つまり、"}, {"type": "subtitle", "time": 13937.15, "timestamp": "03:52:17", "text": "言う"}, {"type": "subtitle", "time": 13941.229, "timestamp": "03:52:21", "text": "待って、下に何か隠されているの？"}, {"type": "subtitle", "time": 13943.91, "timestamp": "03:52:23", "text": "待って、これで全部手に入れたかな？"}, {"type": "subtitle", "time": 13972.67, "timestamp": "03:52:52", "text": "すべて。それとも"}]
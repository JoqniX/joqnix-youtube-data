[{"type": "subtitle", "time": 19938.868, "timestamp": "05:32:18", "text": "あ、待って。弾薬がない。なんてこった。は"}, {"type": "subtitle", "time": 19940.99, "timestamp": "05:32:20", "text": "冗談でしょ？"}, {"type": "subtitle", "time": 19943.83, "timestamp": "05:32:23", "text": "今？弾薬屋はどこですか？うん、これ"}, {"type": "subtitle", "time": 19945.99, "timestamp": "05:32:25", "text": "場所。"}, {"type": "subtitle", "time": 19947.708, "timestamp": "05:32:27", "text": "弾薬が"}, {"type": "subtitle", "time": 19950.548, "timestamp": "05:32:30", "text": "ロード済み？ああ、返してくれ。ああ、私の"}, {"type": "subtitle", "time": 19956.788, "timestamp": "05:32:36", "text": "えっ？私たちは新しい挑戦に取り組んでいました。"}, {"type": "subtitle", "time": 19972.19, "timestamp": "05:32:52", "text": "[音楽]"}]
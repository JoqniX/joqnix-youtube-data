[{"type": "subtitle", "time": 8946.63, "timestamp": "02:29:06", "text": "次。今日は48日目ですよね？"}, {"type": "subtitle", "time": 8948.11, "timestamp": "02:29:08", "text": "いいえ"}, {"type": "subtitle", "time": 8951.19, "timestamp": "02:29:11", "text": "方法。今日は月曜日です。うん。 48. 明日"}, {"type": "subtitle", "time": 8996.71, "timestamp": "02:29:56", "text": "パパ。ええ、100％CPは言えません"}, {"type": "subtitle", "time": 8997.27, "timestamp": "02:29:57", "text": "見る"}, {"type": "subtitle", "time": 8998.59, "timestamp": "02:29:58", "text": "[音楽]"}]
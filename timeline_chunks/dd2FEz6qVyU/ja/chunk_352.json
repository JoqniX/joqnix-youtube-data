[{"type": "subtitle", "time": 21120.59, "timestamp": "05:52:00", "text": "ここに私が望んだように、私がしたように、ハ"}, {"type": "subtitle", "time": 21123.39, "timestamp": "05:52:03", "text": "どこかにそれを。どこに置いたか忘れた"}, {"type": "subtitle", "time": 21126.23, "timestamp": "05:52:06", "text": "それ。私はいつもそうしなければならなかったので、私は"}, {"type": "subtitle", "time": 21129.47, "timestamp": "05:52:09", "text": "いつも好きになる必要はない"}, {"type": "subtitle", "time": 21132.39, "timestamp": "05:52:12", "text": "これ。お見せしましょう。いつも私は"}, {"type": "subtitle", "time": 21135.43, "timestamp": "05:52:15", "text": "これを行うには、"}, {"type": "subtitle", "time": 21138.35, "timestamp": "05:52:18", "text": "全部を放っておけないストリーム"}, {"type": "subtitle", "time": 21142.708, "timestamp": "05:52:22", "text": "ボード。 2つだと思うし、いつも"}, {"type": "subtitle", "time": 21145.75, "timestamp": "05:52:25", "text": "ヘッドバンドをしなければならなかったし"}, {"type": "subtitle", "time": 21146.75, "timestamp": "05:52:26", "text": "もの"}, {"type": "subtitle", "time": 21149.19, "timestamp": "05:52:29", "text": "ここ。どうやってやったかお見せします"}, {"type": "subtitle", "time": 21151.19, "timestamp": "05:52:31", "text": "通常。普段はこうしなければならない"}, {"type": "subtitle", "time": 21155.03, "timestamp": "05:52:35", "text": "これを開けて、ヘッドパッドを入れてください。"}, {"type": "subtitle", "time": 21157.35, "timestamp": "05:52:37", "text": "だから私はいつもこれをしなければならない"}, {"type": "subtitle", "time": 21160.948, "timestamp": "05:52:40", "text": "ねずみ。でも今は、"}, {"type": "subtitle", "time": 21164.47, "timestamp": "05:52:44", "text": "声。来て。それは良いことだ。それは"}, {"type": "subtitle", "time": 21165.39, "timestamp": "05:52:45", "text": "実は"}, {"type": "subtitle", "time": 21168.03, "timestamp": "05:52:48", "text": "良い。いまいましい"}, {"type": "subtitle", "time": 21171.27, "timestamp": "05:52:51", "text": "グッチ。つまり、これは実際役に立つんです。これ"}, {"type": "subtitle", "time": 21172.75, "timestamp": "05:52:52", "text": "実は"}, {"type": "subtitle", "time": 21175.91, "timestamp": "05:52:55", "text": "役に立つ。おかげで楽になる。"}, {"type": "subtitle", "time": 21179.35, "timestamp": "05:52:59", "text": "想像してみてください、想像してみてください"}]
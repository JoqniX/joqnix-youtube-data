[{"type": "subtitle", "time": 24722.868, "timestamp": "06:52:02", "text": "両親と私は、えっと、彼らにあげるのが好きです"}, {"type": "subtitle", "time": 24725.67, "timestamp": "06:52:05", "text": "えっと、私がバレンタインデーをどう捉えているかというと、"}, {"type": "subtitle", "time": 24729.11, "timestamp": "06:52:09", "text": "あなたの祝賀会"}, {"type": "subtitle", "time": 24731.11, "timestamp": "06:52:11", "text": "あなたが最も大切にし、愛する人々"}, {"type": "subtitle", "time": 24734.708, "timestamp": "06:52:14", "text": "ペットも含まれるロット、"}, {"type": "subtitle", "time": 24741.59, "timestamp": "06:52:21", "text": "すべて。ほら、私がこうだったとき"}, {"type": "subtitle", "time": 24745.31, "timestamp": "06:52:25", "text": "本当にほんの少し、私は餌を与えていました"}, {"type": "subtitle", "time": 24749.59, "timestamp": "06:52:29", "text": "えーと、ランダムな昆虫が私の食べ物と"}, {"type": "subtitle", "time": 24752.31, "timestamp": "06:52:32", "text": "もの。あの日は本当にめちゃくちゃだった。戻る"}, {"type": "subtitle", "time": 24757.43, "timestamp": "06:52:37", "text": "日、私はこう思った時のことを覚えている。"}, {"type": "subtitle", "time": 24759.91, "timestamp": "06:52:39", "text": "「ええ、特別な日です。私の"}, {"type": "subtitle", "time": 24762.19, "timestamp": "06:52:42", "text": "誕生日。」そして私はケーキを用意しました。"}, {"type": "subtitle", "time": 24766.27, "timestamp": "06:52:46", "text": "私のドアの外では、"}, {"type": "subtitle", "time": 24769.83, "timestamp": "06:52:49", "text": "ああ、アリみたいに、私は楽しんで"}, {"type": "subtitle", "time": 24771.628, "timestamp": "06:52:51", "text": "ケーキ"}, {"type": "subtitle", "time": 24773.548, "timestamp": "06:52:53", "text": "そこには。"}, {"type": "subtitle", "time": 24776.788, "timestamp": "06:52:56", "text": "じゃあ、また独身ってことにしよう。そこには"}, {"type": "subtitle", "time": 24778.468, "timestamp": "06:52:58", "text": "シングルが多すぎる。"}]
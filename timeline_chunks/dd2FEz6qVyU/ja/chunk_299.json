[{"type": "subtitle", "time": 17948.15, "timestamp": "04:59:08", "text": "これ？実は、頂上までたどり着いたんです。"}, {"type": "subtitle", "time": 17952.708, "timestamp": "04:59:12", "text": "一体どういうことだ？何てことだ。え、何？"}, {"type": "subtitle", "time": 17961.27, "timestamp": "04:59:21", "text": "方法。実際にそうしなかったなんてありえない"}, {"type": "subtitle", "time": 17983.19, "timestamp": "04:59:43", "text": "やったぞ。何てことだ。やったぞ。私は作った"}, {"type": "subtitle", "time": 17986.23, "timestamp": "04:59:46", "text": "それ。これで試合は終了です。さあ行こう。"}, {"type": "subtitle", "time": 17989.07, "timestamp": "04:59:49", "text": "やったぞ。やったぞ。私たちは"}, {"type": "subtitle", "time": 17992.75, "timestamp": "04:59:52", "text": "それ。兄弟、君側が"}]
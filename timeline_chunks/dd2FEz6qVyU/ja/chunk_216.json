[{"type": "subtitle", "time": 12983.83, "timestamp": "03:36:23", "text": "よし、こいつらはこうやって湧いてくる"}, {"type": "subtitle", "time": 12998.59, "timestamp": "03:36:38", "text": "[音楽]"}, {"type": "subtitle", "time": 13001.51, "timestamp": "03:36:41", "text": "場所。わかった。こんにちは。元気ですか？私は"}, {"type": "subtitle", "time": 13003.99, "timestamp": "03:36:43", "text": "よくやっている。元気ですか？きっと"}, {"type": "subtitle", "time": 13006.44, "timestamp": "03:36:46", "text": "順調にやってきたよ。"}, {"type": "subtitle", "time": 13008.87, "timestamp": "03:36:48", "text": "[音楽]"}, {"type": "subtitle", "time": 13011.59, "timestamp": "03:36:51", "text": "毎日楽しんでいます。"}, {"type": "subtitle", "time": 13015.83, "timestamp": "03:36:55", "text": "生命の存在。このゲームは最高だ"}]
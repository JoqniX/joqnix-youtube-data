[{"type": "subtitle", "time": 20220.31, "timestamp": "05:37:00", "text": "ライブ配信中、そして今私たちは交流しています"}, {"type": "subtitle", "time": 20223.11, "timestamp": "05:37:03", "text": "いろいろと。そうですね、ありがとうございます"}, {"type": "subtitle", "time": 20223.948, "timestamp": "05:37:03", "text": "来る"}, {"type": "subtitle", "time": 20226.51, "timestamp": "05:37:06", "text": "による。リアリティさん"}, {"type": "subtitle", "time": 20229.19, "timestamp": "05:37:09", "text": "D. ストリーミング配信をしているかどうかはわかりませんが"}, {"type": "subtitle", "time": 20231.59, "timestamp": "05:37:11", "text": "でも、そうですね、始めなければなりません"}, {"type": "subtitle", "time": 20233.35, "timestamp": "05:37:13", "text": "それをストリーミング配信する。私は最初の"}, {"type": "subtitle", "time": 20236.23, "timestamp": "05:37:16", "text": "今年のストリームは実際にはまだ"}, {"type": "subtitle", "time": 20239.948, "timestamp": "05:37:19", "text": "けれど。私は"}, {"type": "subtitle", "time": 20242.628, "timestamp": "05:37:22", "text": "降水。うわぁ、って感じ。次回は"}, {"type": "subtitle", "time": 20244.43, "timestamp": "05:37:24", "text": "明日やってください。"}, {"type": "subtitle", "time": 20247.75, "timestamp": "05:37:27", "text": "明日。ああ、でも、うまくいけばこれが"}, {"type": "subtitle", "time": 20250.788, "timestamp": "05:37:30", "text": "今週中にできると思う、"}, {"type": "subtitle", "time": 20252.75, "timestamp": "05:37:32", "text": "現実を"}, {"type": "subtitle", "time": 20255.43, "timestamp": "05:37:35", "text": "ストリーム。するとヤンミックスがやって来た。ありがとう"}, {"type": "subtitle", "time": 20257.47, "timestamp": "05:37:37", "text": "来てくれてありがとう。楽しんでいただけたでしょうか。"}, {"type": "subtitle", "time": 20259.83, "timestamp": "05:37:39", "text": "今日。ゴーストクイーン、来てくれてありがとう"}, {"type": "subtitle", "time": 20261.75, "timestamp": "05:37:41", "text": "また、5つの賭けにも感謝します。"}, {"type": "subtitle", "time": 20263.548, "timestamp": "05:37:43", "text": "同じように。感謝"}, {"type": "subtitle", "time": 20266.03, "timestamp": "05:37:46", "text": "あなたがやって来た"}, {"type": "subtitle", "time": 20268.03, "timestamp": "05:37:48", "text": "今日来るために"}, {"type": "subtitle", "time": 20272.35, "timestamp": "05:37:52", "text": "ザキザキが来てくれて"}, {"type": "subtitle", "time": 20276.19, "timestamp": "05:37:56", "text": "良い。ひるむ。本当にありがとうございます"}, {"type": "subtitle", "time": 20279.23, "timestamp": "05:37:59", "text": "たくさん、ロク・ヤシュ。ありがとう、"}]
[{"type": "subtitle", "time": 25200.2, "timestamp": "07:00:00", "text": "チョコレート 風味。どうすれば説明できますか"}, {"type": "subtitle", "time": 25203.6, "timestamp": "07:00:03", "text": "風味。どうすれば説明できますか 私の2つ目のことは？文"}, {"type": "subtitle", "time": 25206.68, "timestamp": "07:00:06", "text": "私の2つ目のことは？文 決める。えっと、exe えっと"}, {"type": "subtitle", "time": 25211.638, "timestamp": "07:00:11", "text": "決める。えっと、exe えっと exequateって、単語ですか？"}, {"type": "subtitle", "time": 25220.43, "timestamp": "07:00:20", "text": "十分な風味。この物には"}, {"type": "subtitle", "time": 25222.12, "timestamp": "07:00:22", "text": "は おいしい、または"}, {"type": "subtitle", "time": 25224.84, "timestamp": "07:00:24", "text": "おいしい、または 顕著。"}, {"type": "subtitle", "time": 25231.19, "timestamp": "07:00:31", "text": "顕著。うん。これはこのキャンディーこれは"}, {"type": "subtitle", "time": 25233.91, "timestamp": "07:00:33", "text": "お菓子ではありません。このチョコレート、このチョコは"}, {"type": "subtitle", "time": 25237.03, "timestamp": "07:00:37", "text": "贈り物にしたい場合、とても良いです"}, {"type": "subtitle", "time": 25239.708, "timestamp": "07:00:39", "text": "誰か、あるいはあなたの子供、あるいは"}, {"type": "subtitle", "time": 25243.51, "timestamp": "07:00:43", "text": "たとえあなたの家族に対しても"}, {"type": "subtitle", "time": 25246.868, "timestamp": "07:00:46", "text": "家族やいとこの子供。"}, {"type": "subtitle", "time": 25248.868, "timestamp": "07:00:48", "text": "彼らはきっとそれをとても気に入って楽しむでしょう。"}, {"type": "subtitle", "time": 25251.23, "timestamp": "07:00:51", "text": "それほど美味しいのです"}, {"type": "subtitle", "time": 25254.39, "timestamp": "07:00:54", "text": "けれど。ああ、これは暑い。私にさせて"}]
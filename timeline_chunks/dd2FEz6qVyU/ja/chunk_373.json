[{"type": "subtitle", "time": 22384.948, "timestamp": "06:13:04", "text": "そしてZBrushは完全には機能していなかった。私は死ぬ準備ができている。"}, {"type": "subtitle", "time": 22388.07, "timestamp": "06:13:08", "text": "これを通して。私はこれをやりたい。私はしません"}, {"type": "subtitle", "time": 22391.19, "timestamp": "06:13:11", "text": "知る。ただ私が困難な道を選んでいるだけです"}, {"type": "subtitle", "time": 22394.23, "timestamp": "06:13:14", "text": "簡単な方法の代わりに、ほとんどの"}, {"type": "subtitle", "time": 22397.11, "timestamp": "06:13:17", "text": "ほとんどの人がすべての"}, {"type": "subtitle", "time": 22398.59, "timestamp": "06:13:18", "text": "私が知っている人"}, {"type": "subtitle", "time": 22401.03, "timestamp": "06:13:21", "text": "みんなみんな楽な方を選ぶ"}, {"type": "subtitle", "time": 22403.35, "timestamp": "06:13:23", "text": "そうですよね？"}, {"type": "subtitle", "time": 22405.788, "timestamp": "06:13:25", "text": "でもわからない"}, {"type": "subtitle", "time": 22408.548, "timestamp": "06:13:28", "text": "なぜ。理由がわからない。えーと、もしあなたが"}, {"type": "subtitle", "time": 22411.35, "timestamp": "06:13:31", "text": "インドのVubリストについて疑問に思っています、"}, {"type": "subtitle", "time": 22416.51, "timestamp": "06:13:36", "text": "インドのVTuberリストを作成しました"}, {"type": "subtitle", "time": 22423.23, "timestamp": "06:13:43", "text": "右。それで、これについて"}, {"type": "subtitle", "time": 22426.59, "timestamp": "06:13:46", "text": "リスト、神様、私は"}, {"type": "subtitle", "time": 22429.67, "timestamp": "06:13:49", "text": "ああ、待って。ええ、そうですね。これは"}, {"type": "subtitle", "time": 22432.47, "timestamp": "06:13:52", "text": "私が作成したインド人のリスト。だから"}, {"type": "subtitle", "time": 22434.59, "timestamp": "06:13:54", "text": "現在22歳"}, {"type": "subtitle", "time": 22437.31, "timestamp": "06:13:57", "text": "メンバー。もし私たちが"}]
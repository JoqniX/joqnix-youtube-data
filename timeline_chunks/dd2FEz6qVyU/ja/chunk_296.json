[{"type": "subtitle", "time": 17760.19, "timestamp": "04:56:00", "text": "彼。待って、待って、待って、"}, {"type": "subtitle", "time": 17764.27, "timestamp": "04:56:04", "text": "待って。ファイナルファイトは"}, {"type": "subtitle", "time": 17768.15, "timestamp": "04:56:08", "text": "ここ。射程距離はここです。火山"}, {"type": "subtitle", "time": 17769.83, "timestamp": "04:56:09", "text": "突然現れた。では私はどうして"}, {"type": "subtitle", "time": 17772.43, "timestamp": "04:56:12", "text": "行く予定"}, {"type": "subtitle", "time": 17781.75, "timestamp": "04:56:21", "text": "ああ、それを閉じた時。あ、ごめんなさい。私"}, {"type": "subtitle", "time": 17785.19, "timestamp": "04:56:25", "text": "閉じた。つまり、それは"}, {"type": "subtitle", "time": 17787.868, "timestamp": "04:56:27", "text": "どれくらいの時間配信しましたか"}, {"type": "subtitle", "time": 17790.788, "timestamp": "04:56:30", "text": "もう一度、あなたは私に何をしてほしいですか？"}, {"type": "subtitle", "time": 17793.35, "timestamp": "04:56:33", "text": "すべてを完全に見つけるか、まとめると"}, {"type": "subtitle", "time": 17795.75, "timestamp": "04:56:35", "text": "君たちは何を望んでいる？君たちはどう思う？"}, {"type": "subtitle", "time": 17797.31, "timestamp": "04:56:37", "text": "私たちは何を"}, {"type": "subtitle", "time": 17800.39, "timestamp": "04:56:40", "text": "昼食も夕食ももらえますか？"}, {"type": "subtitle", "time": 17812.43, "timestamp": "04:56:52", "text": "知る"}, {"type": "subtitle", "time": 17815.868, "timestamp": "04:56:55", "text": "えー、すきみっちの季節"}, {"type": "subtitle", "time": 17819.03, "timestamp": "04:56:59", "text": "2. ああ、あのキャラクターは"}]
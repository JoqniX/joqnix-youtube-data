[{"type": "subtitle", "time": 27064.67, "timestamp": "07:31:04", "text": "相棒。"}, {"type": "subtitle", "time": 27067.03, "timestamp": "07:31:07", "text": "チョコレート。私が最初に"}, {"type": "subtitle", "time": 27075.35, "timestamp": "07:31:15", "text": "来てくれるすべての人に言いたい"}, {"type": "subtitle", "time": 27078.548, "timestamp": "07:31:18", "text": "今日。こんにちは、イセンサ。ハッピーバレンタイン"}, {"type": "subtitle", "time": 27082.99, "timestamp": "07:31:22", "text": "日。チョコが欲しい？はい、私の"}, {"type": "subtitle", "time": 27087.948, "timestamp": "07:31:27", "text": "チョコ。私が最初の一人だといいな。"}, {"type": "subtitle", "time": 27090.468, "timestamp": "07:31:30", "text": "ウィンク。あなたに何かを送りたい"}, {"type": "subtitle", "time": 27092.31, "timestamp": "07:31:32", "text": "この荷物を発送することになったとき。だから私は"}, {"type": "subtitle", "time": 27095.708, "timestamp": "07:31:35", "text": "これは、"}, {"type": "subtitle", "time": 27097.548, "timestamp": "07:31:37", "text": "あなた"}, {"type": "subtitle", "time": 27100.628, "timestamp": "07:31:40", "text": "イベント。私書箱の設定方法がわかりません"}]
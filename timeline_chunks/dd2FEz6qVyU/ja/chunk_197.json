[{"type": "subtitle", "time": 11820.59, "timestamp": "03:17:00", "text": "場所"}, {"type": "subtitle", "time": 11823.71, "timestamp": "03:17:03", "text": "少し上へ"}, {"type": "subtitle", "time": 11840.11, "timestamp": "03:17:20", "text": "物体？あれ、あの氷は直してなかったっけ？"}, {"type": "subtitle", "time": 11843.79, "timestamp": "03:17:23", "text": "場所？おお。"}, {"type": "subtitle", "time": 11847.269, "timestamp": "03:17:27", "text": "ああ、前にもそうだった。気をつけて。編集中"}, {"type": "subtitle", "time": 11850.55, "timestamp": "03:17:30", "text": "高いシールドを持つ敵対的な群れの部隊"}, {"type": "subtitle", "time": 11852.95, "timestamp": "03:17:32", "text": "勝つべきである。でも、もしかしたらできるかもしれない"}, {"type": "subtitle", "time": 11855.59, "timestamp": "03:17:35", "text": "もっと気の利いたことを考えてみて。それは"}, {"type": "subtitle", "time": 11859.67, "timestamp": "03:17:39", "text": "A または、ああ、なんてことだ。それは雰囲気だ。それは空気です"}, {"type": "subtitle", "time": 11862.83, "timestamp": "03:17:42", "text": "ウィンドウ。それは"}, {"type": "subtitle", "time": 11874.95, "timestamp": "03:17:54", "text": "あれ。それは何ですか？"}]
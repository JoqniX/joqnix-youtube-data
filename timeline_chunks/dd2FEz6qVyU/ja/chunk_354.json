[{"type": "subtitle", "time": 21242.51, "timestamp": "05:54:02", "text": "アクセスしやすく、ご存知のとおり"}, {"type": "subtitle", "time": 21244.788, "timestamp": "05:54:04", "text": "制御可能。そう、そういうことだ。"}, {"type": "subtitle", "time": 21247.868, "timestamp": "05:54:07", "text": "私たちは、私たちは"}, {"type": "subtitle", "time": 21250.35, "timestamp": "05:54:10", "text": "実行中。よし、チャットを取得する必要がある"}, {"type": "subtitle", "time": 21252.67, "timestamp": "05:54:12", "text": "できるだけ早く。入手する必要がある"}, {"type": "subtitle", "time": 21255.868, "timestamp": "05:54:15", "text": "チャット。チャットが読めません。"}, {"type": "subtitle", "time": 21275.868, "timestamp": "05:54:35", "text": "の"}, {"type": "subtitle", "time": 21279.788, "timestamp": "05:54:39", "text": "リンク。わかった。ピクチ。ええ、私たちは"}, {"type": "subtitle", "time": 21289.948, "timestamp": "05:54:49", "text": "くそ。でも、ええ、私たちはこれらのことをすべてやりました"}, {"type": "subtitle", "time": 21292.31, "timestamp": "05:54:52", "text": "今日。正直に言うと、私は"}, {"type": "subtitle", "time": 21295.11, "timestamp": "05:54:55", "text": "3ヶ月前にこれをやったのですが、"}, {"type": "subtitle", "time": 21298.39, "timestamp": "05:54:58", "text": "とても怠け者で、いつも物事を先延ばしにしていた。"}]
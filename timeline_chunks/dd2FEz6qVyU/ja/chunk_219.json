[{"type": "subtitle", "time": 13142.07, "timestamp": "03:39:02", "text": "わかった。それが私が探しているものだろうか？"}, {"type": "subtitle", "time": 13186.03, "timestamp": "03:39:46", "text": "以上。本当にボンを鳴らす必要があるのか"}, {"type": "subtitle", "time": 13189.07, "timestamp": "03:39:49", "text": "これ？本当に殺す必要があるのか"}, {"type": "subtitle", "time": 13193.19, "timestamp": "03:39:53", "text": "これ？私はしたくない。このゲームは楽しい。"}, {"type": "subtitle", "time": 13196.309, "timestamp": "03:39:56", "text": "ずっとプレイし続けたい。私"}, {"type": "subtitle", "time": 13198.79, "timestamp": "03:39:58", "text": "Apexは要らない。私はヴァレリンはいらない。私"}]
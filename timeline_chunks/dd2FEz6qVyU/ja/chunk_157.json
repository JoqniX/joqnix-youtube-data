[{"type": "subtitle", "time": 9436.87, "timestamp": "02:37:16", "text": "いいえ。私の目は涙ぐんでいます"}, {"type": "subtitle", "time": 9447.87, "timestamp": "02:37:27", "text": "理由。いいえ、できません"}, {"type": "subtitle", "time": 9451.429, "timestamp": "02:37:31", "text": "今そこにいます。よし、これでいい。ああ、それはまるで"}, {"type": "subtitle", "time": 9454.15, "timestamp": "02:37:34", "text": "Apexにおけるパスファインダー関連機能。同じ"}, {"type": "subtitle", "time": 9455.95, "timestamp": "02:37:35", "text": "メカニック。"}, {"type": "subtitle", "time": 9471.389, "timestamp": "02:37:51", "text": "ポグ。"}, {"type": "subtitle", "time": 9475.87, "timestamp": "02:37:55", "text": "ああ、わかりました。わかりました。わかった。私は手に入れた"}]
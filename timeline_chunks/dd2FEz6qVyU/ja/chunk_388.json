[{"type": "subtitle", "time": 23280.628, "timestamp": "06:28:00", "text": "そして、こんなアニメを描くのは誰？"}, {"type": "subtitle", "time": 23282.15, "timestamp": "06:28:02", "text": "この3人から学ぶ"}, {"type": "subtitle", "time": 23286.07, "timestamp": "06:28:06", "text": "芸術スタイルと"}, {"type": "subtitle", "time": 23289.19, "timestamp": "06:28:09", "text": "彼らはどうやって物事を成し遂げるのですか？だから私はいつも"}, {"type": "subtitle", "time": 23291.75, "timestamp": "06:28:11", "text": "質問をしてください。たくさんの質問を受けました。"}, {"type": "subtitle", "time": 23294.708, "timestamp": "06:28:14", "text": "だから理解するには時間がかかる"}, {"type": "subtitle", "time": 23297.628, "timestamp": "06:28:17", "text": "コンセプトですよね？それで"}, {"type": "subtitle", "time": 23299.548, "timestamp": "06:28:19", "text": "うん"}, {"type": "subtitle", "time": 23303.59, "timestamp": "06:28:23", "text": "また、別の漫画家でもある"}, {"type": "subtitle", "time": 23307.03, "timestamp": "06:28:27", "text": "漫画関連の仕事もしています。見てください"}, {"type": "subtitle", "time": 23311.19, "timestamp": "06:28:31", "text": "彼女の努力は素晴らしい。"}, {"type": "subtitle", "time": 23316.11, "timestamp": "06:28:36", "text": "彼女はこのようにうまく転がります"}, {"type": "subtitle", "time": 23319.35, "timestamp": "06:28:39", "text": "これ。うん、これが私が欲しいアートセットだ"}, {"type": "subtitle", "time": 23320.27, "timestamp": "06:28:40", "text": "持ち帰り"}, {"type": "subtitle", "time": 23327.59, "timestamp": "06:28:47", "text": "スタイルと、彼の経歴を持つデイビッドソン"}, {"type": "subtitle", "time": 23331.91, "timestamp": "06:28:51", "text": "風景画とこれはアート"}, {"type": "subtitle", "time": 23333.59, "timestamp": "06:28:53", "text": "デイビッドソン。"}, {"type": "subtitle", "time": 23335.83, "timestamp": "06:28:55", "text": "こういう感情は本当に"}, {"type": "subtitle", "time": 23338.548, "timestamp": "06:28:58", "text": "心にはたくさんの感情が込められています"}]
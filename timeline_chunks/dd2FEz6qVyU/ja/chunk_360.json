[{"type": "subtitle", "time": 21601.628, "timestamp": "06:00:01", "text": "何？何？"}, {"type": "subtitle", "time": 21605.47, "timestamp": "06:00:05", "text": "何？えっと、私は"}, {"type": "subtitle", "time": 21608.15, "timestamp": "06:00:08", "text": "知る。とにかく、私は自分の声が嫌いなので、"}, {"type": "subtitle", "time": 21610.03, "timestamp": "06:00:10", "text": "気にしない。おお、"}, {"type": "subtitle", "time": 21614.788, "timestamp": "06:00:14", "text": "うん。えっと、それは皮肉なことかもしれません"}, {"type": "subtitle", "time": 21616.15, "timestamp": "06:00:16", "text": "もしくは、ストリーミング配信しているから"}, {"type": "subtitle", "time": 21616.91, "timestamp": "06:00:16", "text": "多く、"}, {"type": "subtitle", "time": 21620.35, "timestamp": "06:00:20", "text": "右？えっと、"}, {"type": "subtitle", "time": 21624.39, "timestamp": "06:00:24", "text": "はい、投稿です。なぜこんなにタブがたくさんあるのだろう？"}, {"type": "subtitle", "time": 21631.67, "timestamp": "06:00:31", "text": "ミックス。わからない。ええと、私はいつも"}, {"type": "subtitle", "time": 21632.53, "timestamp": "06:00:32", "text": "もの"}, {"type": "subtitle", "time": 21634.11, "timestamp": "06:00:34", "text": "[音楽]"}, {"type": "subtitle", "time": 21636.708, "timestamp": "06:00:36", "text": "開ける。すべてを閉じる必要があります。ああ、"}, {"type": "subtitle", "time": 21640.31, "timestamp": "06:00:40", "text": "コラボ企画。ああ、私はただ、私はただ"}, {"type": "subtitle", "time": 21651.99, "timestamp": "06:00:51", "text": "[音楽]"}, {"type": "subtitle", "time": 21653.87, "timestamp": "06:00:53", "text": "ジョークはこれらとコラボレーションしています"}, {"type": "subtitle", "time": 21655.708, "timestamp": "06:00:55", "text": "[音楽]"}, {"type": "subtitle", "time": 21657.75, "timestamp": "06:00:57", "text": "素晴らしい。彼らのリンクはここにあります"}]
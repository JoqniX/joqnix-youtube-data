[{"type": "subtitle", "time": 22620.628, "timestamp": "06:17:00", "text": "4つ。待って、いつ私が手に入れたの？待って、いつ"}, {"type": "subtitle", "time": 22623.59, "timestamp": "06:17:03", "text": "えっと、いつ提携したんですか？"}, {"type": "subtitle", "time": 22625.868, "timestamp": "06:17:05", "text": "Twitchで？つまり、"}, {"type": "subtitle", "time": 22630.07, "timestamp": "06:17:10", "text": "ちょっと待ってください。それは、待って、"}, {"type": "subtitle", "time": 22632.05, "timestamp": "06:17:12", "text": "アカウントにアクセスさせてください。"}, {"type": "subtitle", "time": 22633.15, "timestamp": "06:17:13", "text": "[音楽]"}, {"type": "subtitle", "time": 22636.15, "timestamp": "06:17:16", "text": "こんにちは。それは私が6年間アフィリエイトをしているということです"}, {"type": "subtitle", "time": 22637.32, "timestamp": "06:17:17", "text": "数ヶ月、"}, {"type": "subtitle", "time": 22638.59, "timestamp": "06:17:18", "text": "[音楽]"}, {"type": "subtitle", "time": 22643.59, "timestamp": "06:17:23", "text": "右？うん。つまり、5ヶ月ということだ"}, {"type": "subtitle", "time": 22647.27, "timestamp": "06:17:27", "text": "私はこの保護状態、状態"}, {"type": "subtitle", "time": 22648.708, "timestamp": "06:17:28", "text": "ゼロ。"}, {"type": "subtitle", "time": 22651.67, "timestamp": "06:17:31", "text": "そして、実際にどれくらい時間が経ったのかはわかりません"}, {"type": "subtitle", "time": 22654.91, "timestamp": "06:17:34", "text": "どれくらい時間がかかるかわかりません"}, {"type": "subtitle", "time": 22658.628, "timestamp": "06:17:38", "text": "デビュー。つまり、私は自分にこう言い聞かせていた"}, {"type": "subtitle", "time": 22661.75, "timestamp": "06:17:41", "text": "私がやりたかったように、もし私の"}, {"type": "subtitle", "time": 22664.708, "timestamp": "06:17:44", "text": "固定投稿のようなTwitterの目標、"}, {"type": "subtitle", "time": 22667.51, "timestamp": "06:17:47", "text": "なぜこんなに時間がかかっているのか理解できません"}, {"type": "subtitle", "time": 22668.75, "timestamp": "06:17:48", "text": "を"}, {"type": "subtitle", "time": 22672.708, "timestamp": "06:17:52", "text": "デビューまで結構長い時間がかかったりしてね。私は持っていた"}, {"type": "subtitle", "time": 22673.948, "timestamp": "06:17:53", "text": "使用済み"}, {"type": "subtitle", "time": 22678.99, "timestamp": "06:17:58", "text": "これらのアバターも同様です。もし私が覚えていたら"}]
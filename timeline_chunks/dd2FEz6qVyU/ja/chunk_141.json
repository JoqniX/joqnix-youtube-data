[{"type": "subtitle", "time": 8460.99, "timestamp": "02:21:00", "text": "電話"}, {"type": "subtitle", "time": 8464.87, "timestamp": "02:21:04", "text": "それ？私は何も持っていませんでした"}, {"type": "subtitle", "time": 8466.429, "timestamp": "02:21:06", "text": "[音楽]"}, {"type": "subtitle", "time": 8471.59, "timestamp": "02:21:11", "text": "えっと、この音楽の授業で。私 私"}, {"type": "subtitle", "time": 8474.309, "timestamp": "02:21:14", "text": "外にいた。今日はダメだ。私は何も見ませんでした"}, {"type": "subtitle", "time": 8476.27, "timestamp": "02:21:16", "text": "メッセージまたは"}, {"type": "subtitle", "time": 8491.75, "timestamp": "02:21:31", "text": "[音楽]"}, {"type": "subtitle", "time": 8517.99, "timestamp": "02:21:57", "text": "また、オレンジ色、アストラ、ヒマ、レサ、"}]
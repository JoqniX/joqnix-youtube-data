[{"type": "subtitle", "time": 22500.548, "timestamp": "06:15:00", "text": "私はしたくない、それは"}, {"type": "subtitle", "time": 22502.548, "timestamp": "06:15:02", "text": "単に混乱しているだけです。ところで、私は"}, {"type": "subtitle", "time": 22505.35, "timestamp": "06:15:05", "text": "登録者数で判断するつもりだ。"}, {"type": "subtitle", "time": 22513.35, "timestamp": "06:15:13", "text": "見る。あなたもそうなりたいと思っているんですね。知っている、"}, {"type": "subtitle", "time": 22517.19, "timestamp": "06:15:17", "text": "兄弟。きっと、もし私が"}, {"type": "subtitle", "time": 22518.29, "timestamp": "06:15:18", "text": "ソーシャルブレードまたは"}, {"type": "subtitle", "time": 22519.788, "timestamp": "06:15:19", "text": "[音楽]"}, {"type": "subtitle", "time": 22523.19, "timestamp": "06:15:23", "text": "もし私が本当に始めたと確信しているなら"}, {"type": "subtitle", "time": 22525.31, "timestamp": "06:15:25", "text": "この意欲的な"}, {"type": "subtitle", "time": 22528.948, "timestamp": "06:15:28", "text": "ジョックニックみたいなやつ、えーと、私がやったみたいに"}, {"type": "subtitle", "time": 22532.39, "timestamp": "06:15:32", "text": "8 n のような意欲的なものを始めます"}, {"type": "subtitle", "time": 22535.03, "timestamp": "06:15:35", "text": "数ヶ月前ですが、私はまだ"}, {"type": "subtitle", "time": 22543.43, "timestamp": "06:15:43", "text": "知ってるよ、もし私が確信してるなら待って、[ __ ]"}, {"type": "subtitle", "time": 22547.07, "timestamp": "06:15:47", "text": "右。トゥイッチ。うん。もし私が確信しているなら"}, {"type": "subtitle", "time": 22557.07, "timestamp": "06:15:57", "text": "年？待って、最後の表示はどうすればいいの？"}, {"type": "subtitle", "time": 22559.31, "timestamp": "06:15:59", "text": "今年の"}]
[{"type": "subtitle", "time": 19801.708, "timestamp": "05:30:01", "text": "楽しい。とても気に入っています。大好きです"}, {"type": "subtitle", "time": 19805.51, "timestamp": "05:30:05", "text": "それ。ショットガンだけで済ませるべきでしょうか？私"}, {"type": "subtitle", "time": 19807.07, "timestamp": "05:30:07", "text": "試すことができます"}, {"type": "subtitle", "time": 19811.15, "timestamp": "05:30:11", "text": "ショットガン。指が痛い"}, {"type": "subtitle", "time": 19815.708, "timestamp": "05:30:15", "text": "理由。なるほど、1時間"}, {"type": "subtitle", "time": 19819.11, "timestamp": "05:30:19", "text": "たぶん、私はずっとそう言ってきたんだろうな。"}, {"type": "subtitle", "time": 19840.19, "timestamp": "05:30:40", "text": "[音楽]"}]
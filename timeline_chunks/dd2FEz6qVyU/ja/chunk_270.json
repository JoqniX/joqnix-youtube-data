[{"type": "subtitle", "time": 16222.03, "timestamp": "04:30:22", "text": "沈黙。それは"}, {"type": "subtitle", "time": 16226.349, "timestamp": "04:30:26", "text": "それ？ 3つのうち2つ。ということで、1つあります"}, {"type": "subtitle", "time": 16228.99, "timestamp": "04:30:28", "text": "もっと。では、私は何者なのか"}, {"type": "subtitle", "time": 16232.55, "timestamp": "04:30:32", "text": "ない？この人ですか？私は感じます"}, {"type": "subtitle", "time": 16242.429, "timestamp": "04:30:42", "text": "男。私は、私は、"}]
[{"type": "subtitle", "time": 25691.59, "timestamp": "07:08:11", "text": "だから、私が"}, {"type": "subtitle", "time": 25694.03, "timestamp": "07:08:14", "text": "本当にクールで"}, {"type": "subtitle", "time": 25707.75, "timestamp": "07:08:27", "text": "ああ、本当に美味しかったよ。私"}, {"type": "subtitle", "time": 25714.548, "timestamp": "07:08:34", "text": "実際、私はチョコレートをあまり食べないから"}, {"type": "subtitle", "time": 25716.99, "timestamp": "07:08:36", "text": "実は。"}, {"type": "subtitle", "time": 25725.07, "timestamp": "07:08:45", "text": "[音楽]"}, {"type": "subtitle", "time": 25728.868, "timestamp": "07:08:48", "text": "いいえ。でも、私は確信できます。"}, {"type": "subtitle", "time": 25731.11, "timestamp": "07:08:51", "text": "私は人生を経験するだろう"}]
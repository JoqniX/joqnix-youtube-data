[{"type": "subtitle", "time": 308.31, "timestamp": "00:05:08", "text": "最高。では、カテゴリーを変えましょう。私は"}, {"type": "subtitle", "time": 310.909, "timestamp": "00:05:10", "text": "ごめん。えっと、私は間違ったカテゴリーにいます"}, {"type": "subtitle", "time": 313.79, "timestamp": "00:05:13", "text": "信じられない。カテゴリーを変更させてください。"}, {"type": "subtitle", "time": 316.39, "timestamp": "00:05:16", "text": "はい、私は正しいカテゴリーに属しています。"}, {"type": "subtitle", "time": 319.07, "timestamp": "00:05:19", "text": "バーチャルデイリーライブ配信。"}, {"type": "subtitle", "time": 323.11, "timestamp": "00:05:23", "text": "こんにちは。こんにちは、みんな。"}, {"type": "subtitle", "time": 326.43, "timestamp": "00:05:26", "text": "おお。ああ、どうやらクエストがあるみたいだ"}, {"type": "subtitle", "time": 333.31, "timestamp": "00:05:33", "text": "面白い。"}, {"type": "subtitle", "time": 337.95, "timestamp": "00:05:37", "text": "H 15 元稼げるようなもの"}, {"type": "subtitle", "time": 340.79, "timestamp": "00:05:40", "text": "贈り物にふさわしいもの、あるいは何か。"}, {"type": "subtitle", "time": 349.189, "timestamp": "00:05:49", "text": "読めないと思うけど、"}, {"type": "subtitle", "time": 351.67, "timestamp": "00:05:51", "text": "ええ、ストリーミングしないといけないと思います"}, {"type": "subtitle", "time": 354.15, "timestamp": "00:05:54", "text": "特定の時間数にわたって、"}, {"type": "subtitle", "time": 357.87, "timestamp": "00:05:57", "text": "たくさんの人がおしゃべりしているに違いない"}]
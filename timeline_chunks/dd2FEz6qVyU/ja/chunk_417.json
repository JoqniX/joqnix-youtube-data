[{"type": "subtitle", "time": 25046.31, "timestamp": "06:57:26", "text": "えっと、今日は、人々が何をするのか気になる日です"}, {"type": "subtitle", "time": 25047.708, "timestamp": "06:57:27", "text": "する"}, {"type": "subtitle", "time": 25051.628, "timestamp": "06:57:31", "text": "今日？彼らはケーキを切ったり、"}, {"type": "subtitle", "time": 25055.35, "timestamp": "06:57:35", "text": "彼らはこれからどうするのだろうか？彼らは何を"}, {"type": "subtitle", "time": 25057.19, "timestamp": "06:57:37", "text": "する？"}, {"type": "subtitle", "time": 25074.89, "timestamp": "06:57:54", "text": "ソースはおいしい。"}, {"type": "subtitle", "time": 25077.628, "timestamp": "06:57:57", "text": "[音楽]"}]
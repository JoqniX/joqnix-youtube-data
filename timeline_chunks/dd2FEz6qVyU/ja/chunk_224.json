[{"type": "subtitle", "time": 13453.83, "timestamp": "03:44:13", "text": "ああ、銃は硬い。"}, {"type": "subtitle", "time": 13456.229, "timestamp": "03:44:16", "text": "スナイパー相手に苦戦しています。"}, {"type": "subtitle", "time": 13472.309, "timestamp": "03:44:32", "text": "それから？ここで何をすればいいの？"}, {"type": "subtitle", "time": 13498.07, "timestamp": "03:44:58", "text": "その周り。これは私が昔見ていたものです"}]
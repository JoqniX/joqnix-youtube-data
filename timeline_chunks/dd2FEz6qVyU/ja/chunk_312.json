[{"type": "subtitle", "time": 18721.15, "timestamp": "05:12:01", "text": "私たちは実際にゲームに不具合を起こしました。"}, {"type": "subtitle", "time": 18725.948, "timestamp": "05:12:05", "text": "何？ああ、ただいま。"}, {"type": "subtitle", "time": 18728.868, "timestamp": "05:12:08", "text": "ニース。いや、大丈夫だったよ。彼はできなかった"}, {"type": "subtitle", "time": 18731.23, "timestamp": "05:12:11", "text": "完全に仕上げる"}, {"type": "subtitle", "time": 18740.15, "timestamp": "05:12:20", "text": "完全に。最後にもう一つ手に入れた。わかった。によって"}, {"type": "subtitle", "time": 18742.85, "timestamp": "05:12:22", "text": "方法、"}]
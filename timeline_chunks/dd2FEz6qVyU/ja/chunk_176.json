[{"type": "subtitle", "time": 10564.429, "timestamp": "02:56:04", "text": "それ。それ以外は、このゲームは良い。"}, {"type": "subtitle", "time": 10568.83, "timestamp": "02:56:08", "text": "良い。出発前に着替える必要がある"}, {"type": "subtitle", "time": 10571.349, "timestamp": "02:56:11", "text": "リロード方法を実際に変更する必要がある"}, {"type": "subtitle", "time": 10572.95, "timestamp": "02:56:12", "text": "鍵。"}, {"type": "subtitle", "time": 10576.03, "timestamp": "02:56:16", "text": "残りは私の最高峰として残しておきます"}]
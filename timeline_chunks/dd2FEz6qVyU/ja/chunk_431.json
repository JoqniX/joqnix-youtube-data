[{"type": "subtitle", "time": 25862.788, "timestamp": "07:11:02", "text": "そこが問題なんです。それは確かに存在する。"}, {"type": "subtitle", "time": 25869.43, "timestamp": "07:11:09", "text": "D、もし君たちが"}, {"type": "subtitle", "time": 25873.19, "timestamp": "07:11:13", "text": "私の立場は？ Dさん、行ってみたいですか？"}, {"type": "subtitle", "time": 25876.83, "timestamp": "07:11:16", "text": "あなたは誰と部屋を共有しますか？"}, {"type": "subtitle", "time": 25880.468, "timestamp": "07:11:20", "text": "誰か、それともシングルのような人"}, {"type": "subtitle", "time": 25891.11, "timestamp": "07:11:31", "text": "[音楽]"}, {"type": "subtitle", "time": 25894.868, "timestamp": "07:11:34", "text": "正直、個室にしたいのですが、"}, {"type": "subtitle", "time": 25899.19, "timestamp": "07:11:39", "text": "でも、もし私が理解できるなら"}, {"type": "subtitle", "time": 25901.31, "timestamp": "07:11:41", "text": "えっと、"}, {"type": "subtitle", "time": 25904.43, "timestamp": "07:11:44", "text": "ルームメイト、私は"}, {"type": "subtitle", "time": 25906.67, "timestamp": "07:11:46", "text": "ぜひ"}, {"type": "subtitle", "time": 25909.868, "timestamp": "07:11:49", "text": "特別なことをするために"}, {"type": "subtitle", "time": 25913.35, "timestamp": "07:11:53", "text": "彼ら。私は彼らを単なる私のものとして扱わない"}, {"type": "subtitle", "time": 25916.39, "timestamp": "07:11:56", "text": "ルームメイト。私は彼らを次のように扱います"}, {"type": "subtitle", "time": 25919.19, "timestamp": "07:11:59", "text": "まるで家族のように接する、みたいな感じですね。"}]
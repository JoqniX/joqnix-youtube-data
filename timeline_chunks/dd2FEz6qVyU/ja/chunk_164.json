[{"type": "subtitle", "time": 9841.88, "timestamp": "02:44:01", "text": "何？私はショットガンが大好きです。ニース。"}, {"type": "subtitle", "time": 9847.83, "timestamp": "02:44:07", "text": "[音楽]"}, {"type": "subtitle", "time": 9859.71, "timestamp": "02:44:19", "text": "良い。私たちはこれを収集します。ああ、そうだね。組みつく"}, {"type": "subtitle", "time": 9862.67, "timestamp": "02:44:22", "text": "フック。あ、待って。それは何ですか"}, {"type": "subtitle", "time": 9865.51, "timestamp": "02:44:25", "text": "音？ビースティ7。ありがとうございます"}, {"type": "subtitle", "time": 9867.63, "timestamp": "02:44:27", "text": "フォローする。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 9870.23, "timestamp": "02:44:30", "text": "いらっしゃいませ。今日はお元気でお過ごしでしょうか。"}]
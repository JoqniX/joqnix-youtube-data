[{"type": "subtitle", "time": 9780.309, "timestamp": "02:43:00", "text": "良い。私はこの部屋に入らなければならない。どうやって"}, {"type": "subtitle", "time": 9783.19, "timestamp": "02:43:03", "text": "入ってもいいですか？ああ、私は手に入れたい"}, {"type": "subtitle", "time": 9793.99, "timestamp": "02:43:13", "text": "これらは既に集めてあります。私は自分の"}, {"type": "subtitle", "time": 9809.469, "timestamp": "02:43:29", "text": "神。何？私は持っていません"}, {"type": "subtitle", "time": 9811.55, "timestamp": "02:43:31", "text": "弾薬。何"}, {"type": "subtitle", "time": 9814.389, "timestamp": "02:43:34", "text": "私がいつも忘れてしまうこと。再考しなければならない"}, {"type": "subtitle", "time": 9816.83, "timestamp": "02:43:36", "text": "自動リロード機能はないのですか？来て。"}, {"type": "subtitle", "time": 9819.67, "timestamp": "02:43:39", "text": "お願いだから、それが自動だって言ってよ"}, {"type": "subtitle", "time": 9821.63, "timestamp": "02:43:41", "text": "再装填。"}, {"type": "subtitle", "time": 9824.55, "timestamp": "02:43:44", "text": "ホバーボードが自動ジャンプできる状態であれば、"}, {"type": "subtitle", "time": 9832.87, "timestamp": "02:43:52", "text": "目標は、何？手動で再読み込みする必要があります"}]
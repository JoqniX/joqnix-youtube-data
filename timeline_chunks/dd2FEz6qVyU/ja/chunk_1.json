[{"type": "subtitle", "time": 61.15, "timestamp": "00:01:01", "text": "やったよ。私は来た"}, {"type": "subtitle", "time": 65.35, "timestamp": "00:01:05", "text": "戻る。私は食事をした。疲れているけど"}, {"type": "subtitle", "time": 68.95, "timestamp": "00:01:08", "text": "リフレッシュもできました。薬を手に入れた。 1つ私が"}, {"type": "subtitle", "time": 70.95, "timestamp": "00:01:10", "text": "いくつか手に入れました。うん。うん。いくつか手に入れました"}, {"type": "subtitle", "time": 73.429, "timestamp": "00:01:13", "text": "ちなみに、マルチビタミン剤のことです。私は手に入れた"}, {"type": "subtitle", "time": 75.469, "timestamp": "00:01:15", "text": "マルチビタミン剤"}, {"type": "subtitle", "time": 77.39, "timestamp": "00:01:17", "text": "薬。"}, {"type": "subtitle", "time": 81.59, "timestamp": "00:01:21", "text": "ええ、そうですね。うん。うん。マルチビタミンのように"}, {"type": "subtitle", "time": 83.91, "timestamp": "00:01:23", "text": "ブドウ種子エキス配合のマルチミネラル"}, {"type": "subtitle", "time": 85.95, "timestamp": "00:01:25", "text": "錠剤ではない"}, {"type": "subtitle", "time": 88.95, "timestamp": "00:01:28", "text": "中立的、大丈夫、あるいは何か、それは"}, {"type": "subtitle", "time": 93.83, "timestamp": "00:01:33", "text": "亜鉛コエイペックス亜鉛コベットエイペックスと呼ばれる"}, {"type": "subtitle", "time": 95.83, "timestamp": "00:01:35", "text": "15錠"}, {"type": "subtitle", "time": 100.19, "timestamp": "00:01:40", "text": "えっと、1日に1回なら食べられます"}, {"type": "subtitle", "time": 102.95, "timestamp": "00:01:42", "text": "私はこれを必ず取るようにします"}, {"type": "subtitle", "time": 105.50999999999999, "timestamp": "00:01:45", "text": "口内炎ができているから"}, {"type": "subtitle", "time": 109.10900000000001, "timestamp": "00:01:49", "text": "現在、口内炎胞子問題が発生しています。"}, {"type": "subtitle", "time": 111.19, "timestamp": "00:01:51", "text": "たぶん、ちゃんと食事をしていないせいだろう。"}, {"type": "subtitle", "time": 114.22999999999999, "timestamp": "00:01:54", "text": "たぶん、食事の時間が遅くて、時間も決めていないからだろう。"}, {"type": "subtitle", "time": 117.429, "timestamp": "00:01:57", "text": "えっと、食事とか色々。そして私はそうではない"}, {"type": "subtitle", "time": 119.749, "timestamp": "00:01:59", "text": "たくさん食べるのもそうですよね？スプーン1本のみ"}]
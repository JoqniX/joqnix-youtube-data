[{"type": "subtitle", "time": 21727.39, "timestamp": "06:02:07", "text": "ロラブ。願わくば"}, {"type": "subtitle", "time": 21730.15, "timestamp": "06:02:10", "text": "作品。おお。ああ、間違えた。私は作った"}, {"type": "subtitle", "time": 21732.19, "timestamp": "06:02:12", "text": "間違いだ。私は"}, {"type": "subtitle", "time": 21734.99, "timestamp": "06:02:14", "text": "間違い。私は"}, {"type": "subtitle", "time": 21739.99, "timestamp": "06:02:19", "text": "間違い。えっと、こうあるべきです"}, {"type": "subtitle", "time": 21742.948, "timestamp": "06:02:22", "text": "えっと、ここにいるはずです。ジョーケン・ニックは"}, {"type": "subtitle", "time": 21744.948, "timestamp": "06:02:24", "text": "これらの素晴らしい才能を持つ方々とコラボレーションできることを嬉しく思います。"}, {"type": "subtitle", "time": 21747.27, "timestamp": "06:02:27", "text": "バーチャルサグラといくつかのコード。あなたはできる"}, {"type": "subtitle", "time": 21751.628, "timestamp": "06:02:31", "text": "下記に各社のリンクを掲載しています。音声媒体はありません。"}, {"type": "subtitle", "time": 21759.83, "timestamp": "06:02:39", "text": "の上。待って。いや、いや、いや、いや、いや、いや。それ"}, {"type": "subtitle", "time": 21761.788, "timestamp": "06:02:41", "text": "出身"}, {"type": "subtitle", "time": 21763.39, "timestamp": "06:02:43", "text": "の"}, {"type": "subtitle", "time": 21766.628, "timestamp": "06:02:46", "text": "夢の戦車。私に与えさせてください"}, {"type": "subtitle", "time": 21767.23, "timestamp": "06:02:47", "text": "あなた"}, {"type": "subtitle", "time": 21771.548, "timestamp": "06:02:51", "text": "[音楽]"}, {"type": "subtitle", "time": 21773.91, "timestamp": "06:02:53", "text": "コンテクスト。少し背景をご説明しましょう。"}, {"type": "subtitle", "time": 21776.628, "timestamp": "06:02:56", "text": "背景をご説明させてください。それで、"}, {"type": "subtitle", "time": 21779.51, "timestamp": "06:02:59", "text": "サクラが2回やった時のことを覚えてる？"}]
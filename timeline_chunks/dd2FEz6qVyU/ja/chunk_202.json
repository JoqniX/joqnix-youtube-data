[{"type": "subtitle", "time": 12138.55, "timestamp": "03:22:18", "text": "それ。新しい銃。何てことだ。これは何ですか？"}, {"type": "subtitle", "time": 12141.229, "timestamp": "03:22:21", "text": "これはApexのP2020ですか？"}, {"type": "subtitle", "time": 12143.349, "timestamp": "03:22:23", "text": "あれ？それは"}, {"type": "subtitle", "time": 12149.63, "timestamp": "03:22:29", "text": "うん。"}, {"type": "subtitle", "time": 12152.11, "timestamp": "03:22:32", "text": "おお。ああ、それは"}, {"type": "subtitle", "time": 12155.429, "timestamp": "03:22:35", "text": "それ？この砂漠のような場所は何ですか？"}, {"type": "subtitle", "time": 12158.07, "timestamp": "03:22:38", "text": "経験値を待ってみたいです。それはちょっと"}, {"type": "subtitle", "time": 12159.309, "timestamp": "03:22:39", "text": "遠い、そうではない"}, {"type": "subtitle", "time": 12178.429, "timestamp": "03:22:58", "text": "ほとんど。できない"}]
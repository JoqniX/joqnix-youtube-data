[{"type": "subtitle", "time": 24781.07, "timestamp": "06:53:01", "text": "そこにはジョークのシングル曲がある。私は結婚します"}, {"type": "subtitle", "time": 24783.75, "timestamp": "06:53:03", "text": "そして私は入ってきて離婚した"}, {"type": "subtitle", "time": 24785.07, "timestamp": "06:53:05", "text": "シングル。"}, {"type": "subtitle", "time": 24787.91, "timestamp": "06:53:07", "text": "待って。わかった。食べる時はどうすればいいですか"}, {"type": "subtitle", "time": 24790.788, "timestamp": "06:53:10", "text": "これを開けてもいいですか？"}, {"type": "subtitle", "time": 24794.628, "timestamp": "06:53:14", "text": "切り開いて、"}, {"type": "subtitle", "time": 24797.39, "timestamp": "06:53:17", "text": "伝統的な方法？私はどこに保管しましたか"}, {"type": "subtitle", "time": 24800.83, "timestamp": "06:53:20", "text": "私のどこに保管したか"}, {"type": "subtitle", "time": 24804.67, "timestamp": "06:53:24", "text": "ああ、ハサミ。そうそう。これ"}, {"type": "subtitle", "time": 24806.92, "timestamp": "06:53:26", "text": "便利なダンディ"}, {"type": "subtitle", "time": 24808.27, "timestamp": "06:53:28", "text": "[音楽]"}, {"type": "subtitle", "time": 24811.03, "timestamp": "06:53:31", "text": "ハサミ。私はこれを「問題ない」と呼ぶ"}, {"type": "subtitle", "time": 24813.31, "timestamp": "06:53:33", "text": "あなたが独身であろうとなかろうと。"}, {"type": "subtitle", "time": 24815.99, "timestamp": "06:53:35", "text": "ああ、問題ないよ。そんなこと、そもそも重要なのか？"}, {"type": "subtitle", "time": 24819.43, "timestamp": "06:53:39", "text": "ごく普通の日ですよね？"}, {"type": "subtitle", "time": 24834.19, "timestamp": "06:53:54", "text": "日。私"}, {"type": "subtitle", "time": 24837.35, "timestamp": "06:53:57", "text": "見る。なるほど。したくない、したくない"}]
[{"type": "subtitle", "time": 9135.75, "timestamp": "02:32:15", "text": "はい、木材を輸出します。あなたが知っている"}, {"type": "subtitle", "time": 9139.51, "timestamp": "02:32:19", "text": "何だって、みんな？寝るか、行くか"}, {"type": "subtitle", "time": 9141.03, "timestamp": "02:32:21", "text": "私はすべての予定を立てて"}, {"type": "subtitle", "time": 9142.87, "timestamp": "02:32:22", "text": "すべては後回し。ちょっと横になるね"}, {"type": "subtitle", "time": 9145.67, "timestamp": "02:32:25", "text": "あるいは、そんな感じ。私は食事をし、嘘をつく"}, {"type": "subtitle", "time": 9149.11, "timestamp": "02:32:29", "text": "すべて、下へ。それでは、おやすみなさい。"}, {"type": "subtitle", "time": 9151.51, "timestamp": "02:32:31", "text": "本日はありがとうございました。"}, {"type": "subtitle", "time": 9153.75, "timestamp": "02:32:33", "text": "明日また会おう。そして私は確信しています"}, {"type": "subtitle", "time": 9156.87, "timestamp": "02:32:36", "text": "私たちが配信をあまり頻繁に行っていない場合。"}, {"type": "subtitle", "time": 9159.75, "timestamp": "02:32:39", "text": "明日、あなたに埋め合わせさせてください。"}, {"type": "subtitle", "time": 9162.309, "timestamp": "02:32:42", "text": "健全な流れがあれば、私はいつもそこにいます"}, {"type": "subtitle", "time": 9164.83, "timestamp": "02:32:44", "text": "日。わかった。"}, {"type": "subtitle", "time": 9168.11, "timestamp": "02:32:48", "text": "私もそうだ"}, {"type": "subtitle", "time": 9170.83, "timestamp": "02:32:50", "text": "眠い。そうするべきです。"}, {"type": "subtitle", "time": 9174.62, "timestamp": "02:32:54", "text": "何か食べなさい。"}]
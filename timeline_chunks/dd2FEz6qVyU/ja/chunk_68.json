[{"type": "subtitle", "time": 4085.029, "timestamp": "01:08:05", "text": "二。ああ、なんて馬鹿げたことだ"}, {"type": "subtitle", "time": 4089.0, "timestamp": "01:08:09", "text": "私が自分の時間を使ってやったことの中で、一番すごいこと。ああ、"}, {"type": "subtitle", "time": 4113.39, "timestamp": "01:08:33", "text": "いいえ。ああ、私は"}, {"type": "subtitle", "time": 4117.43, "timestamp": "01:08:37", "text": "勝利した。私たちは二人とも死んだ。私たちは二人とも死んだ。ニース。"}, {"type": "subtitle", "time": 4118.38, "timestamp": "01:08:38", "text": "家にいる"}]
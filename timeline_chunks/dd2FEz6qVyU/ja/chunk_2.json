[{"type": "subtitle", "time": 121.149, "timestamp": "00:02:01", "text": "の"}, {"type": "subtitle", "time": 124.149, "timestamp": "00:02:04", "text": "物事、それは、"}, {"type": "subtitle", "time": 126.91, "timestamp": "00:02:06", "text": "私はたくさんの配信をしています"}, {"type": "subtitle", "time": 129.749, "timestamp": "00:02:09", "text": "時間やその他すべて、つまり"}, {"type": "subtitle", "time": 133.22899999999998, "timestamp": "00:02:13", "text": "悪い。でも、ベストを尽くします。"}, {"type": "subtitle", "time": 138.309, "timestamp": "00:02:18", "text": "自分自身を立て直す。うん。ビタミン剤を少し入手しました"}, {"type": "subtitle", "time": 141.75, "timestamp": "00:02:21", "text": "風邪薬とか、その他いろいろ。そして"}, {"type": "subtitle", "time": 144.63, "timestamp": "00:02:24", "text": "私は今80を持っているので、"}, {"type": "subtitle", "time": 147.75, "timestamp": "00:02:27", "text": "ゆで卵のように、私が使ったように"}, {"type": "subtitle", "time": 152.309, "timestamp": "00:02:32", "text": "存在する。ええと、ええ、それはとても"}, {"type": "subtitle", "time": 155.99, "timestamp": "00:02:35", "text": "夜は私の部屋が暑い。 PCは"}, {"type": "subtitle", "time": 158.99, "timestamp": "00:02:38", "text": "6日間開催される。いいえ、7日間"}, {"type": "subtitle", "time": 162.07, "timestamp": "00:02:42", "text": "真っ直ぐ。それはおかしい。"}, {"type": "subtitle", "time": 166.03, "timestamp": "00:02:46", "text": "いいえ、私の最高記録は16です"}, {"type": "chat", "time": 174.152, "timestamp": "00:02:54", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "hello"}]
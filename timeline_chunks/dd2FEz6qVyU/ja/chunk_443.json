[{"type": "subtitle", "time": 26580.788, "timestamp": "07:23:00", "text": "去年、去年はまるで最後の年だった"}, {"type": "subtitle", "time": 26583.75, "timestamp": "07:23:03", "text": "一年はまるで小さな猫のようだった。えっと"}, {"type": "subtitle", "time": 26586.15, "timestamp": "07:23:06", "text": "悲しいことに彼女は亡くなりましたが、今年"}, {"type": "subtitle", "time": 26588.708, "timestamp": "07:23:08", "text": "でも、一番好きな猫にあげようかな。"}, {"type": "subtitle", "time": 26591.91, "timestamp": "07:23:11", "text": "チョーは動物たちです。彼らはそれを愛していないのですか？"}, {"type": "subtitle", "time": 26596.39, "timestamp": "07:23:16", "text": "そんなに。私が私たちにあげたカチャマは小さい"}, {"type": "subtitle", "time": 26600.15, "timestamp": "07:23:20", "text": "小さな破片で、彼は"}, {"type": "subtitle", "time": 26605.03, "timestamp": "07:23:25", "text": "もっとくれ。私の足を噛み始めた。"}, {"type": "subtitle", "time": 26608.07, "timestamp": "07:23:28", "text": "私は「わかった、いいよ。受け取って」って感じだった。私"}, {"type": "subtitle", "time": 26610.19, "timestamp": "07:23:30", "text": "大きな"}, {"type": "subtitle", "time": 26613.83, "timestamp": "07:23:33", "text": "それらは甘いもののようなものだという部分。"}, {"type": "subtitle", "time": 26615.15, "timestamp": "07:23:35", "text": "私はしません"}, {"type": "subtitle", "time": 26618.31, "timestamp": "07:23:38", "text": "知る。窒息は有毒です。そうです。私はしませんでした"}, {"type": "subtitle", "time": 26619.39, "timestamp": "07:23:39", "text": "知る。"}, {"type": "subtitle", "time": 26622.59, "timestamp": "07:23:42", "text": "でも、そう、私が食べていたのは"}, {"type": "subtitle", "time": 26625.91, "timestamp": "07:23:45", "text": "チョコレートで、どうやら私の"}, {"type": "subtitle", "time": 26628.39, "timestamp": "07:23:48", "text": "手。するとネオちゃんが近くにいて、"}, {"type": "subtitle", "time": 26632.19, "timestamp": "07:23:52", "text": "「私は舐めて、うーん、うーん」"}, {"type": "subtitle", "time": 26635.67, "timestamp": "07:23:55", "text": "もぐもぐ。」忍者。こんにちは、久しぶりですね。"}, {"type": "subtitle", "time": 26637.468, "timestamp": "07:23:57", "text": "調子はどうですか？"}]
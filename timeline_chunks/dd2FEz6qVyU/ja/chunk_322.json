[{"type": "subtitle", "time": 19349.42, "timestamp": "05:22:29", "text": "たくさんの"}, {"type": "subtitle", "time": 19362.42, "timestamp": "05:22:42", "text": "剣。それは"}, {"type": "subtitle", "time": 19364.43, "timestamp": "05:22:44", "text": "[音楽]"}, {"type": "subtitle", "time": 19368.07, "timestamp": "05:22:48", "text": "スナイパーみたいなやつがこっちにあるよ。それを受け取って。感謝"}, {"type": "subtitle", "time": 19375.23, "timestamp": "05:22:55", "text": "見逃した"}, {"type": "subtitle", "time": 19378.51, "timestamp": "05:22:58", "text": "それ。彼はまだ"}]
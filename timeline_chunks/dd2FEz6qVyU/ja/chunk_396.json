[{"type": "subtitle", "time": 23766.11, "timestamp": "06:36:06", "text": "こんにちは。えーと、今日の配信はちょっとえーと"}, {"type": "subtitle", "time": 23769.75, "timestamp": "06:36:09", "text": "傷はあるけど、大丈夫。"}, {"type": "subtitle", "time": 23771.708, "timestamp": "06:36:11", "text": "えっと"}, {"type": "subtitle", "time": 23784.91, "timestamp": "06:36:24", "text": "分。私に"}, {"type": "subtitle", "time": 23788.35, "timestamp": "06:36:28", "text": "分。こんにちは。それで"}, {"type": "subtitle", "time": 23791.628, "timestamp": "06:36:31", "text": "今日は少し"}, {"type": "subtitle", "time": 23795.868, "timestamp": "06:36:35", "text": "擦り傷がついている。少し傷がついているのは承知しています。それ"}, {"type": "subtitle", "time": 23800.708, "timestamp": "06:36:40", "text": "は。少し傷がついていますが、満足しています"}, {"type": "subtitle", "time": 23802.75, "timestamp": "06:36:42", "text": "バレンタインデーに"}, {"type": "subtitle", "time": 23805.43, "timestamp": "06:36:45", "text": "全て。今日は特別な日です。"}, {"type": "subtitle", "time": 23807.75, "timestamp": "06:36:47", "text": "特別な日"}, {"type": "subtitle", "time": 23811.99, "timestamp": "06:36:51", "text": "えーと、このチャンネルの私たち全員のために"}, {"type": "subtitle", "time": 23814.868, "timestamp": "06:36:54", "text": "毎年バレンタインデーに"}, {"type": "subtitle", "time": 23816.27, "timestamp": "06:36:56", "text": "私たちは"}, {"type": "subtitle", "time": 23818.708, "timestamp": "06:36:58", "text": "チョコレートを贈る場所でお祝いします"}]
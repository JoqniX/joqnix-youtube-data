[{"type": "subtitle", "time": 25384.708, "timestamp": "07:03:04", "text": "誕生日と"}, {"type": "subtitle", "time": 25386.15, "timestamp": "07:03:06", "text": "バレンタインデー。私はちょうど買った"}, {"type": "subtitle", "time": 25388.19, "timestamp": "07:03:08", "text": "ビッグ2"}, {"type": "subtitle", "time": 25391.43, "timestamp": "07:03:11", "text": "3日分のミルクを分けて"}, {"type": "subtitle", "time": 25393.91, "timestamp": "07:03:13", "text": "一人ずつね。いや、いや、いや。それは"}, {"type": "subtitle", "time": 25396.15, "timestamp": "07:03:16", "text": "小さい方。小さい方ですよね？あなたはできる"}, {"type": "subtitle", "time": 25398.07, "timestamp": "07:03:18", "text": "小さい方ですよね？ 5ルピー"}, {"type": "subtitle", "time": 25400.788, "timestamp": "07:03:20", "text": "1つ。私はそれらをたくさん買いました。私"}, {"type": "subtitle", "time": 25403.468, "timestamp": "07:03:23", "text": "それが私が"}, {"type": "subtitle", "time": 25413.83, "timestamp": "07:03:33", "text": "今日はバレンタインデーです。くそ、電話したい"}, {"type": "subtitle", "time": 25417.67, "timestamp": "07:03:37", "text": "今日、ああ、それをやったことを思い出しました。それで"}, {"type": "subtitle", "time": 25428.99, "timestamp": "07:03:48", "text": "[音楽]"}, {"type": "subtitle", "time": 25431.67, "timestamp": "07:03:51", "text": "楽しい。ええと、私はこれをかじりたくない"}, {"type": "subtitle", "time": 25433.91, "timestamp": "07:03:53", "text": "とても悪いですが、私は自分の"}]
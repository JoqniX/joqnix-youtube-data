[{"type": "subtitle", "time": 27001.35, "timestamp": "07:30:01", "text": "愛を体験する"}, {"type": "subtitle", "time": 27005.548, "timestamp": "07:30:05", "text": "気が合う人とゆっくりと"}, {"type": "subtitle", "time": 27016.15, "timestamp": "07:30:16", "text": "屋根に詰め物をしろ。人々は"}, {"type": "subtitle", "time": 27028.388, "timestamp": "07:30:28", "text": "誰かを見つけるには"}, {"type": "subtitle", "time": 27030.91, "timestamp": "07:30:30", "text": "時間、私は"}, {"type": "subtitle", "time": 27033.99, "timestamp": "07:30:33", "text": "推測。屋根の上でキャンディーを見つけた。その"}, {"type": "subtitle", "time": 27035.478, "timestamp": "07:30:35", "text": "その 普通。誰がキャンディーを置いてるの？"}, {"type": "subtitle", "time": 27043.51, "timestamp": "07:30:43", "text": "けれど？誰がキャンディーを置いてるの？"}, {"type": "subtitle", "time": 27045.948, "timestamp": "07:30:45", "text": "けれど？ああ、"}, {"type": "subtitle", "time": 27048.468, "timestamp": "07:30:48", "text": "ジャスミン、ハッピーバレンタインデー。あなたは"}, {"type": "subtitle", "time": 27052.388, "timestamp": "07:30:52", "text": "チョコが欲しい？チョコD. ハッピーバレンタイン"}, {"type": "subtitle", "time": 27055.23, "timestamp": "07:30:55", "text": "日。これが私のチョコです"}]
[{"type": "subtitle", "time": 26820.07, "timestamp": "07:27:00", "text": "人生における特別な人など"}, {"type": "subtitle", "time": 26822.43, "timestamp": "07:27:02", "text": "たいていはカップルとかですね。"}, {"type": "subtitle", "time": 26826.23, "timestamp": "07:27:06", "text": "でも、私が思うに、あなたはそれを祝うのです"}, {"type": "subtitle", "time": 26829.91, "timestamp": "07:27:09", "text": "友人、家族、愛する人たちと。"}, {"type": "subtitle", "time": 26833.11, "timestamp": "07:27:13", "text": "それは限定されるものではありません"}, {"type": "subtitle", "time": 26836.15, "timestamp": "07:27:16", "text": "愛する人たち。わかった？それは次のような形をとることができます。"}, {"type": "subtitle", "time": 26838.31, "timestamp": "07:27:18", "text": "お祝い。彼らと時間を過ごして、"}, {"type": "subtitle", "time": 26841.628, "timestamp": "07:27:21", "text": "良い夕食を、良い食事を"}, {"type": "subtitle", "time": 26845.11, "timestamp": "07:27:25", "text": "一緒に、一緒に出かける、一緒に出かける"}, {"type": "subtitle", "time": 26848.43, "timestamp": "07:27:28", "text": "探検する、旅行する、旅をする、場所を見る、行く"}, {"type": "subtitle", "time": 26853.03, "timestamp": "07:27:33", "text": "バレンタイン関連のイベント、"}, {"type": "subtitle", "time": 26855.03, "timestamp": "07:27:35", "text": "などなど"}, {"type": "subtitle", "time": 26865.948, "timestamp": "07:27:45", "text": "以上です"}, {"type": "subtitle", "time": 26872.75, "timestamp": "07:27:52", "text": "終わり。"}]
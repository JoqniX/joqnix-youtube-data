[{"type": "subtitle", "time": 11583.15, "timestamp": "03:13:03", "text": "わかった。私を見ていてください。わかった。 ３、２、"}, {"type": "subtitle", "time": 11585.63, "timestamp": "03:13:05", "text": "1つ。よし。"}, {"type": "subtitle", "time": 11600.07, "timestamp": "03:13:20", "text": "どこ？どこ？ああ、スナイパー。どこに"}, {"type": "subtitle", "time": 11602.269, "timestamp": "03:13:22", "text": "スナイパー？あ、待って。"}, {"type": "subtitle", "time": 11606.15, "timestamp": "03:13:26", "text": "また。待って。スナイパーは5歳です。わかった。待って。"}, {"type": "subtitle", "time": 11608.229, "timestamp": "03:13:28", "text": "五。そして、この事態は実際に起こっている。六。"}, {"type": "subtitle", "time": 11613.87, "timestamp": "03:13:33", "text": "右。いいえ、私は"}, {"type": "subtitle", "time": 11616.99, "timestamp": "03:13:36", "text": "見逃した。見逃した。信じられますか？"}, {"type": "subtitle", "time": 11620.269, "timestamp": "03:13:40", "text": "それ？見逃した。"}, {"type": "subtitle", "time": 11623.99, "timestamp": "03:13:43", "text": "ああ、それは受け入れるしかないんだ。大丈夫"}, {"type": "subtitle", "time": 11625.95, "timestamp": "03:13:45", "text": "次"}, {"type": "subtitle", "time": 11629.63, "timestamp": "03:13:49", "text": "時間。あなたは転びすぎです。ええ、私は"}, {"type": "subtitle", "time": 11633.67, "timestamp": "03:13:53", "text": "する。それは演技のようなものでなければならない。そうでなければならない"}, {"type": "subtitle", "time": 11634.83, "timestamp": "03:13:54", "text": "パフと"}, {"type": "subtitle", "time": 11637.59, "timestamp": "03:13:57", "text": "勢い。これはこのゲームについての"}, {"type": "subtitle", "time": 11639.67, "timestamp": "03:13:59", "text": "このゲームは勢いと勢いが重要だ。あなた"}]
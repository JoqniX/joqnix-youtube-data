[{"type": "subtitle", "time": 20283.11, "timestamp": "05:38:03", "text": "来てくれてありがとう。メルさん、ありがとう。感謝"}, {"type": "subtitle", "time": 20284.548, "timestamp": "05:38:04", "text": "来てくれてありがとう。久しぶりですね。"}, {"type": "subtitle", "time": 20287.03, "timestamp": "05:38:07", "text": "ありがとう。今日を楽しんでいただければ幸いです。今、"}, {"type": "subtitle", "time": 20288.35, "timestamp": "05:38:08", "text": "その"}, {"type": "subtitle", "time": 20291.67, "timestamp": "05:38:11", "text": "良い。するとブラッドがやって来た。ありがとう、"}, {"type": "subtitle", "time": 20293.43, "timestamp": "05:38:13", "text": "ブラッド、来てくれてありがとう。そして最後に、しかし"}, {"type": "subtitle", "time": 20298.27, "timestamp": "05:38:18", "text": "ベクターも決して劣らない。ベクターは"}, {"type": "subtitle", "time": 20301.67, "timestamp": "05:38:21", "text": "良い。君たちは本当に素晴らしい。感謝"}, {"type": "subtitle", "time": 20303.51, "timestamp": "05:38:23", "text": "あなた。"}, {"type": "subtitle", "time": 20306.31, "timestamp": "05:38:26", "text": "皆さんが私を見ていた理由がわかりません"}, {"type": "subtitle", "time": 20308.868, "timestamp": "05:38:28", "text": "今日。文字通り私一人だけだった"}, {"type": "subtitle", "time": 20311.548, "timestamp": "05:38:31", "text": "行くよ、でも、まるで"}, {"type": "subtitle", "time": 20315.15, "timestamp": "05:38:35", "text": "ゲーム。動きの速いゲームでもある。"}, {"type": "subtitle", "time": 20328.47, "timestamp": "05:38:48", "text": "あれを見てる？まだあくびが止まらない。ママも"}, {"type": "subtitle", "time": 20330.868, "timestamp": "05:38:50", "text": "それが私だった。お立ち寄りいただきありがとうございます"}, {"type": "subtitle", "time": 20331.948, "timestamp": "05:38:51", "text": "同じように。"}, {"type": "subtitle", "time": 20335.75, "timestamp": "05:38:55", "text": "ちょっと寂しかったよ。見逃した"}, {"type": "subtitle", "time": 20339.19, "timestamp": "05:38:59", "text": "ありがとうございます。そうですね、私は"}]
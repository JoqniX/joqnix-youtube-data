[{"type": "subtitle", "time": 14893.63, "timestamp": "04:08:13", "text": "何てことだ。君が作ったなんてありえない"}, {"type": "subtitle", "time": 14896.55, "timestamp": "04:08:16", "text": "編集。待って、ミナ、見たい？"}, {"type": "subtitle", "time": 14899.389, "timestamp": "04:08:19", "text": "えーと編集"}, {"type": "subtitle", "time": 14902.51, "timestamp": "04:08:22", "text": "どれが作ったの？ああ、"}, {"type": "subtitle", "time": 14904.429, "timestamp": "04:08:24", "text": "神。ああ、"}, {"type": "subtitle", "time": 14914.51, "timestamp": "04:08:34", "text": "これ。わかった。"}, {"type": "subtitle", "time": 14918.309, "timestamp": "04:08:38", "text": "待って。わかった。 ３、２、１。よお兄弟、誰が"}, {"type": "subtitle", "time": 14920.78, "timestamp": "04:08:40", "text": "そんな風に笑わせてくれるの？"}, {"type": "subtitle", "time": 14925.349, "timestamp": "04:08:45", "text": "[音楽]"}, {"type": "subtitle", "time": 14930.189, "timestamp": "04:08:50", "text": "行く"}, {"type": "subtitle", "time": 14933.67, "timestamp": "04:08:53", "text": "笑顔。おかえり。私は反応していた"}, {"type": "subtitle", "time": 14937.07, "timestamp": "04:08:57", "text": "あなたのクリップ。ありがとう"}, {"type": "subtitle", "time": 14939.67, "timestamp": "04:08:59", "text": "編集していただきありがとうございます。それはとても"}]
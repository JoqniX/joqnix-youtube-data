[{"type": "subtitle", "time": 21541.43, "timestamp": "05:59:01", "text": "もう一度聞くのは気が進まないけど、そうするよ。"}, {"type": "subtitle", "time": 21544.43, "timestamp": "05:59:04", "text": "そう、これが私の"}, {"type": "subtitle", "time": 21547.35, "timestamp": "05:59:07", "text": "サウンドクラウド。だから私はこれらを作った"}, {"type": "subtitle", "time": 21551.11, "timestamp": "05:59:11", "text": "ずっと昔のアイデア"}, {"type": "subtitle", "time": 21554.23, "timestamp": "05:59:14", "text": "Twitchで。コマンドプレイリストがあります"}, {"type": "subtitle", "time": 21557.59, "timestamp": "05:59:17", "text": "これらを入手するには、これらのリンクを入手してください"}, {"type": "subtitle", "time": 21561.15, "timestamp": "05:59:21", "text": "これらの考えは、ずっと以前から持っていたものだ。メロディーと"}, {"type": "subtitle", "time": 21565.91, "timestamp": "05:59:25", "text": "もの。えっと、そうですね、"}, {"type": "subtitle", "time": 21568.47, "timestamp": "05:59:28", "text": "BGM。そうだよ、ジョークは"}, {"type": "subtitle", "time": 21571.708, "timestamp": "05:59:31", "text": "ミュージカルのはず"}, {"type": "subtitle", "time": 21576.51, "timestamp": "05:59:36", "text": "芸術家風の長広舌。しかし"}, {"type": "subtitle", "time": 21579.51, "timestamp": "05:59:39", "text": "ええ、ちょっと話が逸れてしまって、"}, {"type": "subtitle", "time": 21582.708, "timestamp": "05:59:42", "text": "脱線したわけではなく、諦めたんです。私"}, {"type": "subtitle", "time": 21585.07, "timestamp": "05:59:45", "text": "諦めた"}, {"type": "subtitle", "time": 21587.868, "timestamp": "05:59:47", "text": "えっと、ちょっと待って、あなたに何があったの？"}, {"type": "subtitle", "time": 21590.11, "timestamp": "05:59:50", "text": "待って、"}, {"type": "subtitle", "time": 21594.43, "timestamp": "05:59:54", "text": "何？何？何？何？"}, {"type": "subtitle", "time": 21596.51, "timestamp": "05:59:56", "text": "[音楽]"}, {"type": "subtitle", "time": 21598.67, "timestamp": "05:59:58", "text": "待って。待って。"}]
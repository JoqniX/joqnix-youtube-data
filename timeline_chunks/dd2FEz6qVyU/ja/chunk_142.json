[{"type": "subtitle", "time": 8522.55, "timestamp": "02:22:02", "text": "ウィロー、CJ、クラム、CJ、スカラティアム、ナカン、"}, {"type": "subtitle", "time": 8527.63, "timestamp": "02:22:07", "text": "君たちはみんな生後1ヶ月だよ"}, {"type": "subtitle", "time": 8530.55, "timestamp": "02:22:10", "text": "constel 星座。君たちは"}, {"type": "subtitle", "time": 8533.51, "timestamp": "02:22:13", "text": "紫色のバッジ。そして数日後には他の"}, {"type": "subtitle", "time": 8535.79, "timestamp": "02:22:15", "text": "ハダシュのように、"}, {"type": "subtitle", "time": 8539.71, "timestamp": "02:22:19", "text": "えっと、ニュージャージー州、パンディット、"}, {"type": "subtitle", "time": 8544.27, "timestamp": "02:22:24", "text": "アトム、アービ、アルス、他のみんなもそうするだろう"}, {"type": "subtitle", "time": 8549.01, "timestamp": "02:22:29", "text": "1か月後にも"}, {"type": "subtitle", "time": 8560.87, "timestamp": "02:22:40", "text": "生後1ヶ月になるから"}, {"type": "subtitle", "time": 8567.67, "timestamp": "02:22:47", "text": "うん。改めて皆様に感謝申し上げます。"}, {"type": "subtitle", "time": 8570.83, "timestamp": "02:22:50", "text": "メンバー全員、34名全員。それ"}]
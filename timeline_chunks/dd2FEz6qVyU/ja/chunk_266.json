[{"type": "subtitle", "time": 15964.309, "timestamp": "04:26:04", "text": "君とゲームをするのが恋しいよ。私もです。"}, {"type": "subtitle", "time": 15972.87, "timestamp": "04:26:12", "text": "[音楽]"}, {"type": "subtitle", "time": 15992.429, "timestamp": "04:26:32", "text": "待って。それは"}, {"type": "subtitle", "time": 16004.75, "timestamp": "04:26:44", "text": "銃。それは私が持っているものではありません"}, {"type": "subtitle", "time": 16013.99, "timestamp": "04:26:53", "text": "でも、私はどこに行けばいいの？"}, {"type": "subtitle", "time": 16016.03, "timestamp": "04:26:56", "text": "残りの"}]
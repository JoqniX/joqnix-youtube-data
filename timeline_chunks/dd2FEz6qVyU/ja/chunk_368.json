[{"type": "subtitle", "time": 22081.788, "timestamp": "06:08:01", "text": "著作権フリーの音楽"}, {"type": "subtitle", "time": 22084.11, "timestamp": "06:08:04", "text": "つまり、"}, {"type": "subtitle", "time": 22086.628, "timestamp": "06:08:06", "text": "Twitch なぜこれをやっているのかわかりません"}, {"type": "subtitle", "time": 22089.548, "timestamp": "06:08:09", "text": "Twitchの著作権のないコンテンツすべて"}, {"type": "subtitle", "time": 22092.15, "timestamp": "06:08:12", "text": "企業音楽、つまり、"}, {"type": "subtitle", "time": 22094.708, "timestamp": "06:08:14", "text": "非操作、つまり協力して音楽を再生する"}, {"type": "subtitle", "time": 22096.708, "timestamp": "06:08:16", "text": "通常はそうすべきではない、なぜならあなたの"}, {"type": "subtitle", "time": 22098.35, "timestamp": "06:08:18", "text": "チャネル"}, {"type": "subtitle", "time": 22100.43, "timestamp": "06:08:20", "text": "安全ではない"}, {"type": "subtitle", "time": 22103.43, "timestamp": "06:08:23", "text": "明らかなことは準備もできています、こんにちは、それで私は"}, {"type": "subtitle", "time": 22105.59, "timestamp": "06:08:25", "text": "ここは初めてです。私もベイビーです。ああ、"}, {"type": "subtitle", "time": 22108.548, "timestamp": "06:08:28", "text": "魂。待って、えっと、私に"}, {"type": "subtitle", "time": 22111.59, "timestamp": "06:08:31", "text": "今日、友達申請してますか？そうだったと思います。"}, {"type": "subtitle", "time": 22113.91, "timestamp": "06:08:33", "text": "ええ、そうだったと思います。うん。いらっしゃいませ、"}, {"type": "subtitle", "time": 22115.07, "timestamp": "06:08:35", "text": "いらっしゃいませ。"}, {"type": "subtitle", "time": 22117.39, "timestamp": "06:08:37", "text": "ヘッド。"}, {"type": "subtitle", "time": 22121.19, "timestamp": "06:08:41", "text": "頭。全員に向かって進んでください。ヘッドパッド"}, {"type": "subtitle", "time": 22123.99, "timestamp": "06:08:43", "text": "みんな。遅延を修正する必要がある。よお、俺は"}, {"type": "subtitle", "time": 22127.99, "timestamp": "06:08:47", "text": "遅延を修正する必要がある。そう、ソロパートね。えっと、私は"}, {"type": "subtitle", "time": 22130.43, "timestamp": "06:08:50", "text": "コラボレーションしたと思います"}, {"type": "subtitle", "time": 22133.548, "timestamp": "06:08:53", "text": "えーとコードネーム"}, {"type": "subtitle", "time": 22136.788, "timestamp": "06:08:56", "text": "番組からのゼロ。わからない。私はしません"}, {"type": "subtitle", "time": 22139.19, "timestamp": "06:08:59", "text": "知る。でも、思い出すと、"}]
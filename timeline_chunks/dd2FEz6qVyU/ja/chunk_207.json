[{"type": "subtitle", "time": 12441.55, "timestamp": "03:27:21", "text": "ああ、それは"}, {"type": "subtitle", "time": 12446.07, "timestamp": "03:27:26", "text": "それ。何？以上だった。おお。行く"}, {"type": "subtitle", "time": 12447.91, "timestamp": "03:27:27", "text": "ボス。あ、待って。すでに決定済みです"}, {"type": "subtitle", "time": 12450.55, "timestamp": "03:27:30", "text": "戦い。いいえ、もっと欲しいです。遊びたい"}, {"type": "subtitle", "time": 12453.91, "timestamp": "03:27:33", "text": "しかし、それ以上のものだ。一体どういうことだ？私はしなければならない"}, {"type": "subtitle", "time": 12455.87, "timestamp": "03:27:35", "text": "このゲームに別れを告げよう"}]
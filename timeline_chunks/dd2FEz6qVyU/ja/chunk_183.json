[{"type": "subtitle", "time": 10980.59, "timestamp": "03:03:00", "text": "上。ここには誰もいない。何が"}, {"type": "subtitle", "time": 10984.03, "timestamp": "03:03:04", "text": "これ？何かが上にあるはずだ"}, {"type": "subtitle", "time": 10987.67, "timestamp": "03:03:07", "text": "そこには。すべての"}, {"type": "subtitle", "time": 10990.269, "timestamp": "03:03:10", "text": "はるか遠くまで"}, {"type": "subtitle", "time": 10992.75, "timestamp": "03:03:12", "text": "そこには。"}, {"type": "subtitle", "time": 10996.349, "timestamp": "03:03:16", "text": "あらら。これは何ですか？"}, {"type": "subtitle", "time": 10999.23, "timestamp": "03:03:19", "text": "はぁ？それは"}, {"type": "subtitle", "time": 11001.469, "timestamp": "03:03:21", "text": "モンスター？それは"}, {"type": "subtitle", "time": 11013.07, "timestamp": "03:03:33", "text": "それ？おお。おお。何が"}, {"type": "subtitle", "time": 11017.03, "timestamp": "03:03:37", "text": "これ？これは「オーマイゴッド」ですか。障壁"}, {"type": "subtitle", "time": 11018.59, "timestamp": "03:03:38", "text": "この障壁"}, {"type": "subtitle", "time": 11022.87, "timestamp": "03:03:42", "text": "方法。お願いします。私をからかってるの？私は"}, {"type": "subtitle", "time": 11025.71, "timestamp": "03:03:45", "text": "まだ時期尚早でしょうか？わかった。"}, {"type": "subtitle", "time": 11035.03, "timestamp": "03:03:55", "text": "それから。待って、私は"}, {"type": "subtitle", "time": 11037.429, "timestamp": "03:03:57", "text": "ここ。なんてこった。いや、いや、いや、いや、いや。待って、"}, {"type": "subtitle", "time": 11039.79, "timestamp": "03:03:59", "text": "待って。しないで"}]
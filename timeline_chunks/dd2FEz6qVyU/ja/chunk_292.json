[{"type": "subtitle", "time": 17533.35, "timestamp": "04:52:13", "text": "場所。行かなければならないか"}, {"type": "subtitle", "time": 17542.17, "timestamp": "04:52:22", "text": "何か。わからない。"}, {"type": "subtitle", "time": 17548.75, "timestamp": "04:52:28", "text": "これを見て"}, {"type": "subtitle", "time": 17551.23, "timestamp": "04:52:31", "text": "男が嘘をついている"}, {"type": "subtitle", "time": 17557.51, "timestamp": "04:52:37", "text": "いいね。あ、待って、待って、待って、待って、待って。"}, {"type": "subtitle", "time": 17559.51, "timestamp": "04:52:39", "text": "ここがその場所です。いいえ、ちょっと見てみましょう。させて"}, {"type": "subtitle", "time": 17561.99, "timestamp": "04:52:41", "text": "私にはわかる。そうねぇ。彼はどんなお仕事をしていますか"}, {"type": "subtitle", "time": 17577.67, "timestamp": "04:52:57", "text": "何か。何？彼は何して手に入れるのか"}, {"type": "subtitle", "time": 17577.89, "timestamp": "04:52:57", "text": "の"}]
[{"type": "subtitle", "time": 26945.43, "timestamp": "07:29:05", "text": "それ。だから、現実の生活がどうなるかはわかりません"}, {"type": "subtitle", "time": 26946.83, "timestamp": "07:29:06", "text": "もの"}, {"type": "subtitle", "time": 26949.43, "timestamp": "07:29:09", "text": "は。思い出すために一日必要なら"}, {"type": "subtitle", "time": 26950.788, "timestamp": "07:29:10", "text": "愛に感謝する、あなたは本当の"}, {"type": "subtitle", "time": 26971.03, "timestamp": "07:29:31", "text": "それ。いや、いや、いや、いや、いや、いや。それは"}, {"type": "subtitle", "time": 26978.868, "timestamp": "07:29:38", "text": "悪い。ああ、日本にはそういうものがある"}, {"type": "subtitle", "time": 26980.27, "timestamp": "07:29:40", "text": "設定、"}, {"type": "subtitle", "time": 26982.75, "timestamp": "07:29:42", "text": "右？忘れていた"}, {"type": "subtitle", "time": 26986.75, "timestamp": "07:29:46", "text": "それ。日本には"}, {"type": "subtitle", "time": 26989.628, "timestamp": "07:29:49", "text": "アニメにもあるようなもの"}, {"type": "subtitle", "time": 26992.99, "timestamp": "07:29:52", "text": "それ。私は血まみれの好きではない"}, {"type": "subtitle", "time": 26995.83, "timestamp": "07:29:55", "text": "何？もちろん、そんなことはしません。それは"}, {"type": "subtitle", "time": 26998.628, "timestamp": "07:29:58", "text": "それはあまりにもずるい。したい"}]
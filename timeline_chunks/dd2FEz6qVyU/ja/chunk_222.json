[{"type": "subtitle", "time": 13320.309, "timestamp": "03:42:00", "text": "よし、自分で試してみろ。これは"}, {"type": "subtitle", "time": 13323.11, "timestamp": "03:42:03", "text": "移動シューティングゲーム"}, {"type": "subtitle", "time": 13338.07, "timestamp": "03:42:18", "text": "楽しい。私が達成しようとしていることは何ですか？私はします"}, {"type": "subtitle", "time": 13339.309, "timestamp": "03:42:19", "text": "ない"}, {"type": "subtitle", "time": 13343.91, "timestamp": "03:42:23", "text": "知る。うん。こんにちは、ザキさん。いらっしゃいませ。希望"}, {"type": "subtitle", "time": 13349.309, "timestamp": "03:42:29", "text": "こんにちは。それは違う"}, {"type": "subtitle", "time": 13365.349, "timestamp": "03:42:45", "text": "なぜ？デモ版が既にリリースされているか、"}]
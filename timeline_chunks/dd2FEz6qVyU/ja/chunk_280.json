[{"type": "subtitle", "time": 16800.788, "timestamp": "04:40:00", "text": "休憩所に行って、どれが"}, {"type": "subtitle", "time": 16803.51, "timestamp": "04:40:03", "text": "ここから先は外してしまった。それで私は"}, {"type": "subtitle", "time": 16806.788, "timestamp": "04:40:06", "text": "デモ。ボスを倒したりしたよ。だった"}, {"type": "subtitle", "time": 16846.948, "timestamp": "04:40:46", "text": "わかった。どこですか？わかった。待って。私は来た"}, {"type": "subtitle", "time": 16849.47, "timestamp": "04:40:49", "text": "こちらに戻ってきてください。いいえ。いいえ。私は"}]
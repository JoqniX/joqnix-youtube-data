[{"type": "subtitle", "time": 9555.469, "timestamp": "02:39:15", "text": "ショット。いいえ、私は"}, {"type": "subtitle", "time": 9564.75, "timestamp": "02:39:24", "text": "ああ、ベッドよ。"}, {"type": "subtitle", "time": 9569.07, "timestamp": "02:39:29", "text": "何？私は"}, {"type": "subtitle", "time": 9573.67, "timestamp": "02:39:33", "text": "ああ、なぜ私は楽しんでいたのでしょう。ああ、なんてことだ。"}, {"type": "subtitle", "time": 9575.55, "timestamp": "02:39:35", "text": "この場所から"}, {"type": "subtitle", "time": 9577.23, "timestamp": "02:39:37", "text": "また。"}, {"type": "subtitle", "time": 9580.15, "timestamp": "02:39:40", "text": "なぜ？うん。こんにちは、ヒッピー風ブランコ。"}, {"type": "subtitle", "time": 9582.55, "timestamp": "02:39:42", "text": "いらっしゃいませ。お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 9583.4, "timestamp": "02:39:43", "text": "ハッピー"}, {"type": "subtitle", "time": 9586.11, "timestamp": "02:39:46", "text": "[音楽]"}]
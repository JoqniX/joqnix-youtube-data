[{"type": "subtitle", "time": 13082.83, "timestamp": "03:38:02", "text": "わかった。ジョイ、よかったわ。"}, {"type": "subtitle", "time": 13096.79, "timestamp": "03:38:16", "text": "[音楽]"}, {"type": "subtitle", "time": 13117.71, "timestamp": "03:38:37", "text": "それ。どこにあるんだろう"}, {"type": "subtitle", "time": 13129.91, "timestamp": "03:38:49", "text": "どこだ、あ、待って。これは彼の目ではないか？"}, {"type": "subtitle", "time": 13132.469, "timestamp": "03:38:52", "text": "これはドラゴンの目だ。殺してもいいですか"}, {"type": "subtitle", "time": 13133.95, "timestamp": "03:38:53", "text": "少し"}, {"type": "subtitle", "time": 13136.63, "timestamp": "03:38:56", "text": "目？いいえ。わかりました、それは次のようには機能しません"}, {"type": "subtitle", "time": 13138.349, "timestamp": "03:38:58", "text": "それ。"}]
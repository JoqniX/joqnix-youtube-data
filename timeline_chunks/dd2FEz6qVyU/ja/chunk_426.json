[{"type": "subtitle", "time": 25575.708, "timestamp": "07:06:15", "text": "[音楽]"}, {"type": "subtitle", "time": 25578.628, "timestamp": "07:06:18", "text": "M 私は高級な場所に行くの、なぜなら"}, {"type": "subtitle", "time": 25581.99, "timestamp": "07:06:21", "text": "ああ、私も行きたいな"}, {"type": "subtitle", "time": 25586.19, "timestamp": "07:06:26", "text": "もし私が高級な場所に行く機会があれば"}, {"type": "subtitle", "time": 25599.468, "timestamp": "07:06:39", "text": "キャンディー"}, {"type": "subtitle", "time": 25602.788, "timestamp": "07:06:42", "text": "それは私の手袋の中に入っていく"}, {"type": "subtitle", "time": 25611.04, "timestamp": "07:06:51", "text": "[拍手]"}]
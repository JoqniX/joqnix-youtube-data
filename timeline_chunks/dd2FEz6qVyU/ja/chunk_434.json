[{"type": "subtitle", "time": 26041.35, "timestamp": "07:14:01", "text": "チョコレート。私がそれを食べたと仮定しましょう"}, {"type": "subtitle", "time": 26044.23, "timestamp": "07:14:04", "text": "濃厚なチョコレート。"}, {"type": "subtitle", "time": 26046.51, "timestamp": "07:14:06", "text": "それで"}, {"type": "subtitle", "time": 26063.708, "timestamp": "07:14:23", "text": "チョコレートと、ただ消えていく"}, {"type": "subtitle", "time": 26066.11, "timestamp": "07:14:26", "text": "遠く離れた"}, {"type": "subtitle", "time": 26068.08, "timestamp": "07:14:28", "text": "蝶の缶の近く"}, {"type": "subtitle", "time": 26069.31, "timestamp": "07:14:29", "text": "[音楽]"}, {"type": "subtitle", "time": 26072.11, "timestamp": "07:14:32", "text": "のようになる"}, {"type": "subtitle", "time": 26074.07, "timestamp": "07:14:34", "text": "ポーションか、実際の小さな"}, {"type": "subtitle", "time": 26077.59, "timestamp": "07:14:37", "text": "蝶はただ、"}, {"type": "subtitle", "time": 26078.83, "timestamp": "07:14:38", "text": "甘い"}, {"type": "subtitle", "time": 26082.08, "timestamp": "07:14:42", "text": "蜜"}, {"type": "subtitle", "time": 26090.868, "timestamp": "07:14:50", "text": "チョコだけど、うん、試験だから、私はとても"}, {"type": "subtitle", "time": 26098.39, "timestamp": "07:14:58", "text": "いろいろあるけど、日曜以降は"}]
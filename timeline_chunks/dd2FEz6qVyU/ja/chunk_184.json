[{"type": "subtitle", "time": 11042.87, "timestamp": "03:04:02", "text": "死ぬ。そうそう。ここがその場所だ。いいえ、私は"}, {"type": "subtitle", "time": 11047.15, "timestamp": "03:04:07", "text": "この箱は取り出せなかった。それで、"}, {"type": "subtitle", "time": 11059.469, "timestamp": "03:04:19", "text": "それは違うのか？"}, {"type": "subtitle", "time": 11063.269, "timestamp": "03:04:23", "text": "十分？ああ、もう十分だ。私たちは"}, {"type": "subtitle", "time": 11066.389, "timestamp": "03:04:26", "text": "新しい銃。これは何ですか？これは教会のベンチですか？"}, {"type": "subtitle", "time": 11069.79, "timestamp": "03:04:29", "text": "ピューピューピューピストル？思うに"}, {"type": "subtitle", "time": 11072.55, "timestamp": "03:04:32", "text": "は。ああ、それはピューピューピューピストルだ。おお"}, {"type": "subtitle", "time": 11083.87, "timestamp": "03:04:43", "text": "ピストル。さあ行こう。それはピューピューです"}, {"type": "subtitle", "time": 11090.269, "timestamp": "03:04:50", "text": "行く。ああ、"}, {"type": "subtitle", "time": 11094.429, "timestamp": "03:04:54", "text": "神。今日これを見つけてよかった"}, {"type": "subtitle", "time": 11098.429, "timestamp": "03:04:58", "text": "ゲームだよ、男。このゲームをプレイできてよかった"}]
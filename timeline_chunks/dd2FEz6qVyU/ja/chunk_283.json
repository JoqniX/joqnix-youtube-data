[{"type": "subtitle", "time": 16982.03, "timestamp": "04:43:02", "text": "休む。ここは休憩所だと理解しています。"}, {"type": "subtitle", "time": 16983.948, "timestamp": "04:43:03", "text": "しかし"}, {"type": "subtitle", "time": 16999.23, "timestamp": "04:43:19", "text": "えっと、私は"}, {"type": "subtitle", "time": 17007.19, "timestamp": "04:43:27", "text": "彼は必要なものを全部手に入れたんだよね？私は"}, {"type": "subtitle", "time": 17010.19, "timestamp": "04:43:30", "text": "そのモジュールを入手しましたか？私はそうは思わない"}, {"type": "subtitle", "time": 17014.628, "timestamp": "04:43:34", "text": "した。えっと、休憩所はどこですか？欲しい"}, {"type": "subtitle", "time": 17018.19, "timestamp": "04:43:38", "text": "彼が赤にたどり着く場所を見る"}, {"type": "subtitle", "time": 17021.15, "timestamp": "04:43:41", "text": "もの。雪の場所の後"}, {"type": "subtitle", "time": 17024.47, "timestamp": "04:43:44", "text": "さて、地図上には1箇所だけあります"}, {"type": "subtitle", "time": 17027.03, "timestamp": "04:43:47", "text": "私たちはまだこちら側を探索していません。"}, {"type": "subtitle", "time": 17035.51, "timestamp": "04:43:55", "text": "そこには。あれはあちらです。右。私たちには必要だ"}, {"type": "subtitle", "time": 17038.67, "timestamp": "04:43:58", "text": "ここへ行く。私は探求します"}]
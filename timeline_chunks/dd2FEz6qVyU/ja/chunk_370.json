[{"type": "subtitle", "time": 22203.27, "timestamp": "06:10:03", "text": "今のところ、オーディオを"}, {"type": "subtitle", "time": 22204.75, "timestamp": "06:10:04", "text": "遷移"}, {"type": "subtitle", "time": 22207.83, "timestamp": "06:10:07", "text": "もの。おお。あ、待って。その前に、私は"}, {"type": "subtitle", "time": 22210.31, "timestamp": "06:10:10", "text": "ボングシステムを接続する必要があります。"}, {"type": "subtitle", "time": 22212.15, "timestamp": "06:10:12", "text": "ああ、その前に、"}, {"type": "subtitle", "time": 22213.548, "timestamp": "06:10:13", "text": "爆弾システム。"}, {"type": "subtitle", "time": 22216.948, "timestamp": "06:10:16", "text": "えっと、私のボンとヘッドパッドを覚えている人いますか？"}, {"type": "subtitle", "time": 22218.99, "timestamp": "06:10:18", "text": "私が作ったシステム"}, {"type": "subtitle", "time": 22221.948, "timestamp": "06:10:21", "text": "当然のことながら、これを覚えておいてください"}, {"type": "subtitle", "time": 22228.75, "timestamp": "06:10:28", "text": "もし私が正しければ、それは"}, {"type": "subtitle", "time": 22233.548, "timestamp": "06:10:33", "text": "そう、もし私がここに行ったら、"}, {"type": "subtitle", "time": 22237.83, "timestamp": "06:10:37", "text": "NDIを持っているからこの2つが表示される"}, {"type": "subtitle", "time": 22242.23, "timestamp": "06:10:42", "text": "上。だから、これをツイストに接続する必要がある"}, {"type": "subtitle", "time": 22245.19, "timestamp": "06:10:45", "text": "チャット。だから全て再インストールする必要がある"}, {"type": "subtitle", "time": 22253.75, "timestamp": "06:10:53", "text": "ピコウェブソケット。えっと、何が何だったか"}, {"type": "subtitle", "time": 22254.91, "timestamp": "06:10:54", "text": "パスワード"}, {"type": "subtitle", "time": 22258.03, "timestamp": "06:10:58", "text": "また？設定しなければならない。"}]
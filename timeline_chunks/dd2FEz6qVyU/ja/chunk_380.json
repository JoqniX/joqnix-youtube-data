[{"type": "subtitle", "time": 22800.75, "timestamp": "06:20:00", "text": "君たちは私のツイートを掘り下げて"}, {"type": "subtitle", "time": 22803.51, "timestamp": "06:20:03", "text": "Twitterで探せば見つかるよ。私は言ったと思う"}, {"type": "subtitle", "time": 22806.708, "timestamp": "06:20:06", "text": "一度、私がこの意欲的な立場にいるかもしれない"}, {"type": "subtitle", "time": 22809.59, "timestamp": "06:20:09", "text": "確実に1～2年の段階であれば"}, {"type": "subtitle", "time": 22812.548, "timestamp": "06:20:12", "text": "私はこういう時、本当に動作が遅いんです。でも、そうですね、"}, {"type": "subtitle", "time": 22815.19, "timestamp": "06:20:15", "text": "君の頭を撫でてあげたい。何？待って、君"}, {"type": "subtitle", "time": 22816.03, "timestamp": "06:20:16", "text": "手に入れたい"}, {"type": "subtitle", "time": 22819.11, "timestamp": "06:20:19", "text": "ヘッドバンドをつけた？君に[ __ ]してあげるよ。"}, {"type": "subtitle", "time": 22830.27, "timestamp": "06:20:30", "text": "ASMR。はい、ASMRモード"}, {"type": "subtitle", "time": 22833.59, "timestamp": "06:20:33", "text": "の上。はい、ASMRモードに入りました。よし、1つ目"}, {"type": "subtitle", "time": 22841.948, "timestamp": "06:20:41", "text": "すべて。わかった。"}, {"type": "subtitle", "time": 22858.23, "timestamp": "06:20:58", "text": "えっと、レースチャンネルで待っていたいんだけど"}]
[{"type": "subtitle", "time": 24480.788, "timestamp": "06:48:00", "text": "手持ちカメラのやり方、ですよね？わかった。待って。"}, {"type": "subtitle", "time": 24487.59, "timestamp": "06:48:07", "text": "ああ、なんてことだ、私は自分の背面カメラを見せていたんだ。"}, {"type": "subtitle", "time": 24490.548, "timestamp": "06:48:10", "text": "オーケー、私は自分のすごいオーマイを見せていた"}, {"type": "subtitle", "time": 24494.75, "timestamp": "06:48:14", "text": "[音楽]"}, {"type": "subtitle", "time": 24498.07, "timestamp": "06:48:18", "text": "ほぼOK、これを"}, {"type": "subtitle", "time": 24499.91, "timestamp": "06:48:19", "text": "トップ？いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ。"}, {"type": "subtitle", "time": 24500.83, "timestamp": "06:48:20", "text": "わかった、"}, {"type": "subtitle", "time": 24503.35, "timestamp": "06:48:23", "text": "待って。あ、待って。フロントカメラが動作します"}, {"type": "subtitle", "time": 24505.868, "timestamp": "06:48:25", "text": "けれど。いや、いや、いや。やめろ、やめろ、バカ、"}, {"type": "subtitle", "time": 24508.67, "timestamp": "06:48:28", "text": "ダミー。待って、カメラが見えないよ、"}, {"type": "subtitle", "time": 24512.15, "timestamp": "06:48:32", "text": "右？はい、あなたはそうではありません。ありがとう。"}, {"type": "subtitle", "time": 24538.628, "timestamp": "06:48:58", "text": "それ。待って。少し時間をください。私に"}]
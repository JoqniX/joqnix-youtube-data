[{"type": "subtitle", "time": 10861.83, "timestamp": "03:01:01", "text": "360。ああ、今の見た？待って、"}, {"type": "subtitle", "time": 10864.349, "timestamp": "03:01:04", "text": "もう一度やってみてください。もし私ができるなら"}, {"type": "subtitle", "time": 10868.87, "timestamp": "03:01:08", "text": "それ。これは何ですか？さらなる戦闘が待ち受けている。おお、"}, {"type": "subtitle", "time": 10879.03, "timestamp": "03:01:19", "text": "で。何？"}, {"type": "subtitle", "time": 10899.55, "timestamp": "03:01:39", "text": "何？まあ、そうかもしれないね。"}, {"type": "subtitle", "time": 10903.15, "timestamp": "03:01:43", "text": "待って。ああ、ショットガンか。忘れてた"}, {"type": "subtitle", "time": 10905.83, "timestamp": "03:01:45", "text": "ショットガン。ショットガンの弾を装填するのを忘れた。私"}, {"type": "subtitle", "time": 10907.51, "timestamp": "03:01:47", "text": "忘れ続ける。自動運転はありませんか？"}, {"type": "subtitle", "time": 10917.23, "timestamp": "03:01:57", "text": "私が欲しいのはあの自動"}]
[{"type": "subtitle", "time": 24541.67, "timestamp": "06:49:01", "text": "分。私はこれを準備しています。"}, {"type": "subtitle", "time": 24543.868, "timestamp": "06:49:03", "text": "これを準備する"}, {"type": "subtitle", "time": 24547.35, "timestamp": "06:49:07", "text": "男。わかった。えっと、でも反転しているように見える"}, {"type": "subtitle", "time": 24550.628, "timestamp": "06:49:10", "text": "けれど。それは良いことですか？えっと、私は欲しくない"}, {"type": "subtitle", "time": 24553.43, "timestamp": "06:49:13", "text": "中央の位置に置く。何"}, {"type": "subtitle", "time": 24554.51, "timestamp": "06:49:14", "text": "私はそうする"}, {"type": "subtitle", "time": 24571.15, "timestamp": "06:49:31", "text": "だから人々はこう言うんだ"}, {"type": "subtitle", "time": 24572.83, "timestamp": "06:49:32", "text": "いつも"}, {"type": "subtitle", "time": 24575.07, "timestamp": "06:49:35", "text": "常に準備しておく"}, {"type": "subtitle", "time": 24578.83, "timestamp": "06:49:38", "text": "ストリームの準備をする代わりに"}, {"type": "subtitle", "time": 24583.35, "timestamp": "06:49:43", "text": "遅れ。はい、カメラを構えて"}]
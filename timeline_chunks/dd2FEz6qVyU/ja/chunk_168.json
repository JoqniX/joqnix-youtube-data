[{"type": "subtitle", "time": 10097.59, "timestamp": "02:48:17", "text": "ああ、すごく楽しい。何"}, {"type": "subtitle", "time": 10100.63, "timestamp": "02:48:20", "text": "一体どういうことだ？待って、君はどこにいるの？どこ"}, {"type": "subtitle", "time": 10106.95, "timestamp": "02:48:26", "text": "スナイパー？あ、待って。スナイパーライフルに弾を装填させてください。"}, {"type": "subtitle", "time": 10125.03, "timestamp": "02:48:45", "text": "殺す。 3回やりたい。ああ、それは"}, {"type": "subtitle", "time": 10137.309, "timestamp": "02:48:57", "text": "良い。おお、いいね。何てことだ。"}]
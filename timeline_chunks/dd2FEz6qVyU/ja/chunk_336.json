[{"type": "subtitle", "time": 20161.31, "timestamp": "05:36:01", "text": "による。えっと"}, {"type": "subtitle", "time": 20163.07, "timestamp": "05:36:03", "text": "それから"}, {"type": "subtitle", "time": 20166.548, "timestamp": "05:36:06", "text": "BST7はここに新しく参加したユーザーです。ありがとうございます"}, {"type": "subtitle", "time": 20169.03, "timestamp": "05:36:09", "text": "以下をご覧ください。コンステルへようこそ。"}, {"type": "subtitle", "time": 20172.27, "timestamp": "05:36:12", "text": "今日を楽しんでください。本当にありがとうございます"}, {"type": "subtitle", "time": 20175.83, "timestamp": "05:36:15", "text": "多くの。楽しい一日だったことを願っています。"}, {"type": "subtitle", "time": 20185.75, "timestamp": "05:36:25", "text": "楽しい。そしてレン・パレットの息子さん、ありがとう"}, {"type": "subtitle", "time": 20188.11, "timestamp": "05:36:28", "text": "としてやってくる"}, {"type": "subtitle", "time": 20191.27, "timestamp": "05:36:31", "text": "良い。ありがとう。ありがとう。願わくば"}, {"type": "subtitle", "time": 20194.07, "timestamp": "05:36:34", "text": "今日を楽しんでください。待って、レンのパレットは"}, {"type": "subtitle", "time": 20196.99, "timestamp": "05:36:36", "text": "実際、ヨル？"}, {"type": "subtitle", "time": 20199.07, "timestamp": "05:36:39", "text": "待って、待って、"}, {"type": "subtitle", "time": 20201.708, "timestamp": "05:36:41", "text": "それはヨルです"}, {"type": "subtitle", "time": 20204.07, "timestamp": "05:36:44", "text": "チャマ。名前を変えたんですね？わかった、"}, {"type": "subtitle", "time": 20208.628, "timestamp": "05:36:48", "text": "あなたが見えてます。ヨラマさん、ありがとうございます。ヨルさんに会いました"}, {"type": "subtitle", "time": 20212.15, "timestamp": "05:36:52", "text": "現実から離れて、私が"}, {"type": "subtitle", "time": 20214.708, "timestamp": "05:36:54", "text": "配信とか色々やった後。私は見た"}, {"type": "subtitle", "time": 20217.75, "timestamp": "05:36:57", "text": "このランダムな人物をチューニングして"}]
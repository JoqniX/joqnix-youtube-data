[{"type": "subtitle", "time": 11714.389, "timestamp": "03:15:14", "text": "私は既にこれを済ませました。私はしたくない"}, {"type": "subtitle", "time": 11722.91, "timestamp": "03:15:22", "text": "敵。いや。"}, {"type": "subtitle", "time": 11734.229, "timestamp": "03:15:34", "text": "私もこれを変える必要があると思います。"}, {"type": "subtitle", "time": 11736.389, "timestamp": "03:15:36", "text": "照準感度のようなものだ。いいえ、それは親切です"}, {"type": "subtitle", "time": 11737.229, "timestamp": "03:15:37", "text": "の"}, {"type": "subtitle", "time": 11738.99, "timestamp": "03:15:38", "text": "低い。それは"}, {"type": "subtitle", "time": 11740.59, "timestamp": "03:15:40", "text": "[音楽]"}]
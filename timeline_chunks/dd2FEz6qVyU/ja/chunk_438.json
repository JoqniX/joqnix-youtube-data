[{"type": "subtitle", "time": 26293.51, "timestamp": "07:18:13", "text": "チャットで受け取った人はいますか?"}, {"type": "subtitle", "time": 26295.99, "timestamp": "07:18:15", "text": "彼らのチョコレート？私だけでしょうか？"}, {"type": "subtitle", "time": 26299.23, "timestamp": "07:18:19", "text": "今日はオンラインでチョコレートをプレゼントしますよ？"}, {"type": "subtitle", "time": 26303.43, "timestamp": "07:18:23", "text": "ああ、もう受け取りましたか？何てことだ。"}, {"type": "subtitle", "time": 26306.03, "timestamp": "07:18:26", "text": "受け取りましたか？"}, {"type": "subtitle", "time": 26309.31, "timestamp": "07:18:29", "text": "それ？残念ながら、そうです。あなたは"}, {"type": "subtitle", "time": 26312.868, "timestamp": "07:18:32", "text": "死んだ？私は遅刻しましたか？私は遅刻しましたか？私は"}, {"type": "subtitle", "time": 26315.15, "timestamp": "07:18:35", "text": "最初にあなたに"}, {"type": "subtitle", "time": 26324.948, "timestamp": "07:18:44", "text": "はい、受信されていません。あなたは私の"}]
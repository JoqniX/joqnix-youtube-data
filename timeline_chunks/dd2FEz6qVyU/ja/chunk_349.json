[{"type": "subtitle", "time": 20945.91, "timestamp": "05:49:05", "text": "こんにちは。壊す。ズーク。必ずしもそうである必要はありません"}, {"type": "subtitle", "time": 20948.47, "timestamp": "05:49:08", "text": "私を見ている。ストリーミングしたいのですが、"}, {"type": "subtitle", "time": 20952.43, "timestamp": "05:49:12", "text": "夜間のみ有効。"}, {"type": "subtitle", "time": 20956.03, "timestamp": "05:49:16", "text": "うん。 YouTube は、YouTube は、うんちになる"}, {"type": "subtitle", "time": 20960.23, "timestamp": "05:49:20", "text": "うんち。 YouTubeはクソだ。みなさん、こんにちは。しかし"}, {"type": "subtitle", "time": 20962.708, "timestamp": "05:49:22", "text": "いや、お前ら一体何やってんだよ？私"}, {"type": "subtitle", "time": 20966.548, "timestamp": "05:49:26", "text": "つまり、最後の配信は18歳くらいだった"}, {"type": "subtitle", "time": 20971.548, "timestamp": "05:49:31", "text": "または19。あ、実際は17です"}, {"type": "subtitle", "time": 20973.948, "timestamp": "05:49:33", "text": "いいね。これはまるで"}, {"type": "subtitle", "time": 20977.15, "timestamp": "05:49:37", "text": "リメイク版ですよね？私はしません"}, {"type": "subtitle", "time": 20981.99, "timestamp": "05:49:41", "text": "知る。えっと、もし私がそうしたいなら、"}, {"type": "subtitle", "time": 20984.59, "timestamp": "05:49:44", "text": "YouTube だけを行う"}, {"type": "subtitle", "time": 20987.67, "timestamp": "05:49:47", "text": "今日は、でも皆さんはどう思いますか？"}, {"type": "subtitle", "time": 20989.15, "timestamp": "05:49:49", "text": "なれ"}, {"type": "subtitle", "time": 20991.67, "timestamp": "05:49:51", "text": "そこには？これは新しい配信です。うん、これ"}, {"type": "subtitle", "time": 20994.628, "timestamp": "05:49:54", "text": "新しいストリームです。前回"}, {"type": "subtitle", "time": 20998.91, "timestamp": "05:49:58", "text": "YouTubeによって削除されたストリームは"}]
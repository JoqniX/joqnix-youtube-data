[{"type": "subtitle", "time": 26762.43, "timestamp": "07:26:02", "text": "正直何かあげたかった"}, {"type": "subtitle", "time": 26765.19, "timestamp": "07:26:05", "text": "特別。彼は、"}, {"type": "subtitle", "time": 26768.548, "timestamp": "07:26:08", "text": "チェンナイも彼の"}, {"type": "subtitle", "time": 26772.07, "timestamp": "07:26:12", "text": "学生か、彼はそこへ行く予定です"}, {"type": "subtitle", "time": 26775.67, "timestamp": "07:26:15", "text": "個人として、あるいは教師のように。"}, {"type": "subtitle", "time": 26778.468, "timestamp": "07:26:18", "text": "えーっと、ほら、えーっと、それは"}, {"type": "subtitle", "time": 26781.59, "timestamp": "07:26:21", "text": "日本語の試験ですよね？それで"}, {"type": "subtitle", "time": 26784.35, "timestamp": "07:26:24", "text": "[音楽]"}, {"type": "subtitle", "time": 26788.31, "timestamp": "07:26:28", "text": "うん、でも、"}, {"type": "subtitle", "time": 26797.83, "timestamp": "07:26:37", "text": "ご存知のとおり、私は提出しました"}, {"type": "subtitle", "time": 26801.35, "timestamp": "07:26:41", "text": "10時間の配信のために私がやった宿題と"}, {"type": "subtitle", "time": 26803.91, "timestamp": "07:26:43", "text": "みんなが授業に来ている間に、"}, {"type": "subtitle", "time": 26811.83, "timestamp": "07:26:51", "text": "あれこれ。良かったよ。わかった。えっと"}, {"type": "subtitle", "time": 26813.27, "timestamp": "07:26:53", "text": "目的は何ですか"}, {"type": "subtitle", "time": 26815.27, "timestamp": "07:26:55", "text": "バレンタインデー？バレンタインデーは"}, {"type": "subtitle", "time": 26817.59, "timestamp": "07:26:57", "text": "愛する人と祝うもの"}]
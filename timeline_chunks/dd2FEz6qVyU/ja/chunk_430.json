[{"type": "subtitle", "time": 25800.788, "timestamp": "07:10:00", "text": "ルームメイトが、私が"}, {"type": "subtitle", "time": 25804.39, "timestamp": "07:10:04", "text": "アニメ風のものが欲しい"}, {"type": "subtitle", "time": 25805.91, "timestamp": "07:10:05", "text": "そういうことですよね？ほら、"}, {"type": "subtitle", "time": 25807.468, "timestamp": "07:10:07", "text": "ルームメイト"}, {"type": "subtitle", "time": 25811.51, "timestamp": "07:10:11", "text": "そして、ルームメイトのために料理をすること。私たちではなく、私たち"}, {"type": "subtitle", "time": 25813.43, "timestamp": "07:10:13", "text": "お互いに料理し合う。つまり、私たちは料理をする"}, {"type": "subtitle", "time": 25816.628, "timestamp": "07:10:16", "text": "お互いのために、一緒に夕食をとる、"}, {"type": "subtitle", "time": 25819.03, "timestamp": "07:10:19", "text": "昼食、朝食、すべて"}, {"type": "subtitle", "time": 25823.23, "timestamp": "07:10:23", "text": "一緒に。または目を覚ます、それぞれ目を覚ます"}, {"type": "subtitle", "time": 25826.948, "timestamp": "07:10:26", "text": "その他、えっと、特別に"}, {"type": "subtitle", "time": 25829.51, "timestamp": "07:10:29", "text": "機会に何か素敵なことをしましょう"}, {"type": "subtitle", "time": 25832.868, "timestamp": "07:10:32", "text": "お互いにそういうもの全部見て"}, {"type": "subtitle", "time": 25836.11, "timestamp": "07:10:36", "text": "アニメとかで。私はそれをしたい"}, {"type": "subtitle", "time": 25843.67, "timestamp": "07:10:43", "text": "私の配信とかのせいで"}, {"type": "subtitle", "time": 25846.39, "timestamp": "07:10:46", "text": "あまりにも"}, {"type": "subtitle", "time": 25850.39, "timestamp": "07:10:50", "text": "ストリーミングだけではなく、そうします"}, {"type": "subtitle", "time": 25853.67, "timestamp": "07:10:53", "text": "自分のものを手に入れたら、たくさんのことをする"}, {"type": "subtitle", "time": 25855.628, "timestamp": "07:10:55", "text": "自分の家に行く"}, {"type": "subtitle", "time": 25859.27, "timestamp": "07:10:59", "text": "あれ。ええ、まさにその通りです。"}]
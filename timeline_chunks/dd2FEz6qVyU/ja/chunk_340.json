[{"type": "subtitle", "time": 20403.75, "timestamp": "05:40:03", "text": "「うん、ちょっと遊んでみようか。」うん。"}, {"type": "subtitle", "time": 20405.91, "timestamp": "05:40:05", "text": "だから明日、何があっても私たちは働く"}, {"type": "subtitle", "time": 20408.31, "timestamp": "05:40:08", "text": "そして、依頼された仕事を終わらせる。わかった。"}, {"type": "subtitle", "time": 20410.788, "timestamp": "05:40:10", "text": "せめてチェックポイントまでたどり着け。"}, {"type": "subtitle", "time": 20412.708, "timestamp": "05:40:12", "text": "その後、さらに1回のコミッション配信の後"}, {"type": "subtitle", "time": 20414.51, "timestamp": "05:40:14", "text": "そして私たちは終わりました"}, {"type": "subtitle", "time": 20417.15, "timestamp": "05:40:17", "text": "終わり"}, {"type": "subtitle", "time": 20419.51, "timestamp": "05:40:19", "text": "おそらく。ということで、皆さんありがとうございました。"}, {"type": "subtitle", "time": 20421.91, "timestamp": "05:40:21", "text": "通りかかるよ。皆さんが楽しんでいただけたことを願っています。"}, {"type": "subtitle", "time": 20424.39, "timestamp": "05:40:24", "text": "俺がピューピューと撃つのを見ている奴ら。すべての新しい"}, {"type": "subtitle", "time": 20428.39, "timestamp": "05:40:28", "text": "今日来た人たちは、"}, {"type": "subtitle", "time": 20430.47, "timestamp": "05:40:30", "text": "朝の配信、そして今日は本当に"}, {"type": "subtitle", "time": 20432.31, "timestamp": "05:40:32", "text": "とても意味があります。 2人に感謝するのを忘れていました"}, {"type": "subtitle", "time": 20435.708, "timestamp": "05:40:35", "text": "私がオフラインだった時にフォローしてくれた人たち。"}, {"type": "subtitle", "time": 20439.19, "timestamp": "05:40:39", "text": "えっと、Shili Rosanさん、ありがとうございます。"}, {"type": "subtitle", "time": 20446.59, "timestamp": "05:40:46", "text": "そして、"}]
[{"type": "subtitle", "time": 23521.75, "timestamp": "06:32:01", "text": "そこには？ウーカ"}, {"type": "subtitle", "time": 23524.31, "timestamp": "06:32:04", "text": "ええ、そうです。皆さん、ありがとうございます。"}, {"type": "subtitle", "time": 23526.948, "timestamp": "06:32:06", "text": "本日はお越しいただきありがとうございます。本当に楽しんでいます"}, {"type": "subtitle", "time": 23528.83, "timestamp": "06:32:08", "text": "ストリーム。楽しんでいただければ幸いです"}, {"type": "subtitle", "time": 23531.75, "timestamp": "06:32:11", "text": "ストリーム。ええ、次の配信は"}, {"type": "subtitle", "time": 23533.83, "timestamp": "06:32:13", "text": "明日になります。私はストリームではありません 私は"}, {"type": "subtitle", "time": 23535.788, "timestamp": "06:32:15", "text": "ASMRをやっている"}, {"type": "subtitle", "time": 23539.03, "timestamp": "06:32:19", "text": "今日。休憩を取る。私は自分の"}, {"type": "subtitle", "time": 23540.868, "timestamp": "06:32:20", "text": "心。わからない。"}, {"type": "subtitle", "time": 23543.03, "timestamp": "06:32:23", "text": "では、次の配信は私が発表します"}, {"type": "subtitle", "time": 23545.468, "timestamp": "06:32:25", "text": "次のストリーム。ありがとうございます"}, {"type": "subtitle", "time": 23552.788, "timestamp": "06:32:32", "text": "はい、フォローしてください。最新情報を確認してください。"}, {"type": "subtitle", "time": 23563.99, "timestamp": "06:32:43", "text": "パッド。ええ、みんなの頭ですね。"}, {"type": "subtitle", "time": 23565.708, "timestamp": "06:32:45", "text": "お越しいただき、ありがとうございました。ありがとうございます"}, {"type": "subtitle", "time": 23568.628, "timestamp": "06:32:48", "text": "来るよ。うん。素敵な夜をお過ごしください。楽しむ"}, {"type": "subtitle", "time": 23570.67, "timestamp": "06:32:50", "text": "あなたの朝。楽しむ"}, {"type": "subtitle", "time": 23573.67, "timestamp": "06:32:53", "text": "学び、楽しみ、快適に過ごし、"}, {"type": "subtitle", "time": 23577.11, "timestamp": "06:32:57", "text": "幸せで、前向きでいましょう。ねえ、"}, {"type": "subtitle", "time": 23579.03, "timestamp": "06:32:59", "text": "ジョーク？すぐに終わらせてしまってごめんなさい。"}]
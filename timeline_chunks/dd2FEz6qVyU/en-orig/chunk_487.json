[{"type": "subtitle", "time": 29240.99, "timestamp": "08:07:20", "text": "You know what's happening to be"}, {"type": "subtitle", "time": 29244.31, "timestamp": "08:07:24", "text": "honest? Next Valentine and next"}, {"type": "subtitle", "time": 29246.67, "timestamp": "08:07:26", "text": "Valentine's"}, {"type": "subtitle", "time": 29255.51, "timestamp": "08:07:35", "text": "year. I won't be able to give chocolates"}, {"type": "subtitle", "time": 29257.708, "timestamp": "08:07:37", "text": "to my parents"}, {"type": "subtitle", "time": 29261.07, "timestamp": "08:07:41", "text": "now. Even though I do it every"}, {"type": "subtitle", "time": 29265.388, "timestamp": "08:07:45", "text": "year, it will be all by myself"}, {"type": "subtitle", "time": 29268.948, "timestamp": "08:07:48", "text": "alone. That's the most saddening thing"}]
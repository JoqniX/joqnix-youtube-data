[{"type": "subtitle", "time": 27001.35, "timestamp": "07:30:01", "text": "体验爱情的方式就是相遇"}, {"type": "subtitle", "time": 27005.548, "timestamp": "07:30:05", "text": "你和一个相处融洽的人慢慢地"}, {"type": "subtitle", "time": 27016.15, "timestamp": "07:30:16", "text": "把屋顶塞满东西。我不认为人们"}, {"type": "subtitle", "time": 27028.388, "timestamp": "07:30:28", "text": "找到合适的人需要时间"}, {"type": "subtitle", "time": 27030.91, "timestamp": "07:30:30", "text": "时间，我"}, {"type": "subtitle", "time": 27033.99, "timestamp": "07:30:33", "text": "猜测。我在屋顶上发现了糖果。它是"}, {"type": "subtitle", "time": 27035.478, "timestamp": "07:30:35", "text": "它是 普通的。谁在放糖果？"}, {"type": "subtitle", "time": 27043.51, "timestamp": "07:30:43", "text": "尽管？谁在放糖果？"}, {"type": "subtitle", "time": 27045.948, "timestamp": "07:30:45", "text": "尽管？啊，"}, {"type": "subtitle", "time": 27048.468, "timestamp": "07:30:48", "text": "茉莉，情人节快乐。你"}, {"type": "subtitle", "time": 27052.388, "timestamp": "07:30:52", "text": "想要巧克力吗？ Choco D. 情人节快乐"}, {"type": "subtitle", "time": 27055.23, "timestamp": "07:30:55", "text": "天。这是我的巧克力"}]
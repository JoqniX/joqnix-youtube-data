[{"type": "subtitle", "time": 20760.43, "timestamp": "05:46:00", "text": "来到"}, {"type": "subtitle", "time": 20764.47, "timestamp": "05:46:04", "text": "这里会获得大量的支出。"}, {"type": "subtitle", "time": 20768.43, "timestamp": "05:46:08", "text": "无线策略。啊"}, {"type": "subtitle", "time": 20771.11, "timestamp": "05:46:11", "text": "疼痛。你知道吗？我可能不会给"}, {"type": "subtitle", "time": 20775.19, "timestamp": "05:46:15", "text": "这首歌是这个流媒体的重制版。所以"}, {"type": "subtitle", "time": 20777.39, "timestamp": "05:46:17", "text": "像儿子一样"}, {"type": "subtitle", "time": 20781.948, "timestamp": "05:46:21", "text": "该频道会获得社区指导"}, {"type": "subtitle", "time": 20785.11, "timestamp": "05:46:25", "text": "打我兄弟，我不想被打。"}, {"type": "subtitle", "time": 20786.83, "timestamp": "05:46:26", "text": "引导打击。"}, {"type": "subtitle", "time": 20789.788, "timestamp": "05:46:29", "text": "哟直播"}, {"type": "subtitle", "time": 20793.15, "timestamp": "05:46:33", "text": "将在全局范围内屏蔽。"}, {"type": "subtitle", "time": 20796.708, "timestamp": "05:46:36", "text": "嗯，希望我能接受它们。等待。所以这个"}, {"type": "subtitle", "time": 20798.83, "timestamp": "05:46:38", "text": "所以这是版权问题"}, {"type": "subtitle", "time": 20803.47, "timestamp": "05:46:43", "text": "干掉一些东西，还有我，是的"}, {"type": "subtitle", "time": 20806.15, "timestamp": "05:46:46", "text": "呃，我喝醉后，歌词里有三个这样的东西。"}, {"type": "subtitle", "time": 20808.868, "timestamp": "05:46:48", "text": "但七分钟后就会被移除。"}, {"type": "subtitle", "time": 20811.39, "timestamp": "05:46:51", "text": "移除是指"}]
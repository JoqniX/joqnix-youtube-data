[{"type": "subtitle", "time": 11714.389, "timestamp": "03:15:14", "text": "我已经做过这件事了。我不想"}, {"type": "subtitle", "time": 11722.91, "timestamp": "03:15:22", "text": "敌人。不。"}, {"type": "subtitle", "time": 11734.229, "timestamp": "03:15:34", "text": "我认为我也需要修改这一点。"}, {"type": "subtitle", "time": 11736.389, "timestamp": "03:15:36", "text": "比如瞄准灵敏度。不，这很友善。"}, {"type": "subtitle", "time": 11737.229, "timestamp": "03:15:37", "text": "的"}, {"type": "subtitle", "time": 11738.99, "timestamp": "03:15:38", "text": "低的。它将"}, {"type": "subtitle", "time": 11740.59, "timestamp": "03:15:40", "text": "[音乐]"}]
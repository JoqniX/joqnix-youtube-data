[{"type": "subtitle", "time": 18982.39, "timestamp": "05:16:22", "text": "镐。好了，最后一个。好的，你是吗？"}, {"type": "subtitle", "time": 18985.91, "timestamp": "05:16:25", "text": "伙计们，准备好了吗？之后，我打算去"}, {"type": "subtitle", "time": 18988.11, "timestamp": "05:16:28", "text": "即将结束。"}, {"type": "subtitle", "time": 18990.47, "timestamp": "05:16:30", "text": "好吧，不管怎样，我要收工了。"}, {"type": "subtitle", "time": 19017.03, "timestamp": "05:16:57", "text": "[音乐]"}]
[{"type": "subtitle", "time": 21662.11, "timestamp": "06:01:02", "text": "他妈的"}, {"type": "subtitle", "time": 21666.788, "timestamp": "06:01:06", "text": "向上。啊，糟糕。"}, {"type": "subtitle", "time": 21669.59, "timestamp": "06:01:09", "text": "我有点说不出话来。呃"}, {"type": "subtitle", "time": 21671.99, "timestamp": "06:01:11", "text": "那是半挂车。这是半个操。"}, {"type": "subtitle", "time": 21674.31, "timestamp": "06:01:14", "text": "只是我的声音其实"}, {"type": "subtitle", "time": 21676.35, "timestamp": "06:01:16", "text": "受伤了。我的喉咙其实"}, {"type": "subtitle", "time": 21679.15, "timestamp": "06:01:19", "text": "说话时会感到疼痛。"}, {"type": "subtitle", "time": 21681.47, "timestamp": "06:01:21", "text": "是的。为什么"}, {"type": "subtitle", "time": 21686.67, "timestamp": "06:01:26", "text": "每次我说那个词的时候，TTS 都会这样？"}, {"type": "subtitle", "time": 21695.708, "timestamp": "06:01:35", "text": "精彩的"}, {"type": "subtitle", "time": 21699.47, "timestamp": "06:01:39", "text": "人们。哦，天赋。"}, {"type": "subtitle", "time": 21704.708, "timestamp": "06:01:44", "text": "天赋。请大家多多支持他们。好的。"}, {"type": "subtitle", "time": 21707.91, "timestamp": "06:01:47", "text": "在这里我会粘贴呃我会"}, {"type": "subtitle", "time": 21711.708, "timestamp": "06:01:51", "text": "粘贴所有合作详情"}, {"type": "subtitle", "time": 21714.31, "timestamp": "06:01:54", "text": "如果我和任何人合作，那会是些什么呢？"}, {"type": "subtitle", "time": 21716.99, "timestamp": "06:01:56", "text": "未来。是的。"}, {"type": "subtitle", "time": 21719.35, "timestamp": "06:01:59", "text": "提交。我们来办理入住手续。我们来办理入住手续。"}]
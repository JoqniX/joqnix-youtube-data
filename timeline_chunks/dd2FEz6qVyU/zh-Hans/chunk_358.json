[{"type": "subtitle", "time": 21487.67, "timestamp": "05:58:07", "text": "对，嗯，让我充充电，让我"}, {"type": "subtitle", "time": 21490.708, "timestamp": "05:58:10", "text": "让我……让我出去一下……你"}, {"type": "subtitle", "time": 21492.708, "timestamp": "05:58:12", "text": "如果你想来可以，但我不能在这里。"}, {"type": "subtitle", "time": 21495.83, "timestamp": "05:58:15", "text": "一直都这样，没关系，你没有"}, {"type": "subtitle", "time": 21498.67, "timestamp": "05:58:18", "text": "能在这里看着就好，没关系，我一切都好"}, {"type": "subtitle", "time": 21503.15, "timestamp": "05:58:23", "text": "对，你有自己的背景音乐，对吧？"}, {"type": "subtitle", "time": 21511.43, "timestamp": "05:58:31", "text": "BTM。实际上我没有BTM，但我"}, {"type": "subtitle", "time": 21512.99, "timestamp": "05:58:32", "text": "用于制造"}, {"type": "subtitle", "time": 21518.628, "timestamp": "05:58:38", "text": "嗯，很久以前的音乐，就像……我会展示它"}, {"type": "subtitle", "time": 21519.948, "timestamp": "05:58:39", "text": "一"}, {"type": "subtitle", "time": 21522.708, "timestamp": "05:58:42", "text": "第二。比如，如果我确定我有的话"}, {"type": "subtitle", "time": 21529.03, "timestamp": "05:58:49", "text": "抽搐。让我……让我去看看我的"}, {"type": "subtitle", "time": 21532.27, "timestamp": "05:58:52", "text": "渠道。那也太尴尬了。它会"}, {"type": "subtitle", "time": 21534.11, "timestamp": "05:58:54", "text": "是"}, {"type": "subtitle", "time": 21536.51, "timestamp": "05:58:56", "text": "痛苦"}]
[{"type": "subtitle", "time": 26293.51, "timestamp": "07:18:13", "text": "聊天室里有人收到吗？"}, {"type": "subtitle", "time": 26295.99, "timestamp": "07:18:15", "text": "他们的巧克力？难道只有我一个人这样吗？"}, {"type": "subtitle", "time": 26299.23, "timestamp": "07:18:19", "text": "今天通过视频方式送你巧克力吗？"}, {"type": "subtitle", "time": 26303.43, "timestamp": "07:18:23", "text": "哦，你收到过吗？我的天啊。"}, {"type": "subtitle", "time": 26306.03, "timestamp": "07:18:26", "text": "你收到了吗？"}, {"type": "subtitle", "time": 26309.31, "timestamp": "07:18:29", "text": "它？很遗憾，是的。你当时是……"}, {"type": "subtitle", "time": 26312.868, "timestamp": "07:18:32", "text": "死的？我迟到了吗？我迟到了吗？难道我不是吗？"}, {"type": "subtitle", "time": 26315.15, "timestamp": "07:18:35", "text": "首先给你"}, {"type": "subtitle", "time": 26324.948, "timestamp": "07:18:44", "text": "是的，我没有收到。你将成为我的"}]
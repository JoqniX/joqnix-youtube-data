[{"type": "subtitle", "time": 26223.31, "timestamp": "07:17:03", "text": "你"}, {"type": "subtitle", "time": 26227.31, "timestamp": "07:17:07", "text": "巧克力。不，我不想这样"}, {"type": "subtitle", "time": 26230.15, "timestamp": "07:17:10", "text": "敌人。我会给你蝴蝶"}, {"type": "subtitle", "time": 26234.11, "timestamp": "07:17:14", "text": "以痛苦为代价"}, {"type": "subtitle", "time": 26239.72, "timestamp": "07:17:19", "text": "我不想养蝴蝶。它太可爱了。"}, {"type": "subtitle", "time": 26241.43, "timestamp": "07:17:21", "text": "[音乐]"}, {"type": "subtitle", "time": 26244.23, "timestamp": "07:17:24", "text": "你好。情人节快乐。你"}, {"type": "subtitle", "time": 26245.31, "timestamp": "07:17:25", "text": "想吃"}, {"type": "subtitle", "time": 26247.75, "timestamp": "07:17:27", "text": "巧克力？你想吃巧克力"}]
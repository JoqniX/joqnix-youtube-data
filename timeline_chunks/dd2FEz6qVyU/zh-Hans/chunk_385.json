[{"type": "subtitle", "time": 23100.47, "timestamp": "06:25:00", "text": "我问了 Nakungami 是否愿意合作，他回答说"}, {"type": "subtitle", "time": 23104.948, "timestamp": "06:25:04", "text": "除其他外，我还受到一些限制。让我们来看看。"}, {"type": "subtitle", "time": 23107.99, "timestamp": "06:25:07", "text": "是的，对我来说尤其如此。"}, {"type": "subtitle", "time": 23110.47, "timestamp": "06:25:10", "text": "我一直感觉像是有人在邀请我。"}, {"type": "subtitle", "time": 23112.548, "timestamp": "06:25:12", "text": "为了合作。我还没有进行过合作。"}, {"type": "subtitle", "time": 23115.59, "timestamp": "06:25:15", "text": "和他们一起。我去见他们。我没有"}, {"type": "subtitle", "time": 23118.628, "timestamp": "06:25:18", "text": "这么做是因为我想要，其实我并不想这么做。"}, {"type": "subtitle", "time": 23120.628, "timestamp": "06:25:20", "text": "因为我还不是 YouTuber，所以我才这么做。"}, {"type": "subtitle", "time": 23123.03, "timestamp": "06:25:23", "text": "那里会有人发表演讲，"}, {"type": "subtitle", "time": 23124.23, "timestamp": "06:25:24", "text": "正确的？"}, {"type": "subtitle", "time": 23127.11, "timestamp": "06:25:27", "text": "为什么这个看起来很正常的人会这样做"}, {"type": "subtitle", "time": 23131.75, "timestamp": "06:25:31", "text": "呃，像FL这样的主播，还有YouTuber们"}, {"type": "subtitle", "time": 23135.67, "timestamp": "06:25:35", "text": "自称是 YouTuber？是的，全部"}, {"type": "subtitle", "time": 23139.75, "timestamp": "06:25:39", "text": "股票之类的东西。我不知道。"}, {"type": "subtitle", "time": 23142.708, "timestamp": "06:25:42", "text": "但我想要，我想要一旦我得到"}, {"type": "subtitle", "time": 23146.31, "timestamp": "06:25:46", "text": "超频运行完成。我的意思是，如果我想的话……"}, {"type": "subtitle", "time": 23149.99, "timestamp": "06:25:49", "text": "可以像速通玩家一样制作和设计 P。"}, {"type": "subtitle", "time": 23152.628, "timestamp": "06:25:52", "text": "如果我想，我可以自己设计。"}, {"type": "subtitle", "time": 23154.27, "timestamp": "06:25:54", "text": "我准备好了。"}, {"type": "subtitle", "time": 23157.11, "timestamp": "06:25:57", "text": "但其中一个就像我不知道为什么一样，"}]
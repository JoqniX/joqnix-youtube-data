[{"type": "subtitle", "time": 25261.51, "timestamp": "07:01:01", "text": "咬。简单的巧克力，"}, {"type": "subtitle", "time": 25263.23, "timestamp": "07:01:03", "text": "确实更好。"}, {"type": "subtitle", "time": 25274.708, "timestamp": "07:01:14", "text": "你知道吗，这种巧克力让我想起了……"}, {"type": "subtitle", "time": 25277.39, "timestamp": "07:01:17", "text": "我回忆起我童年时做过的事。"}, {"type": "subtitle", "time": 25280.548, "timestamp": "07:01:20", "text": "说实话，当我还在上高中的时候，"}, {"type": "subtitle", "time": 25282.35, "timestamp": "07:01:22", "text": "我以前买的东西"}, {"type": "subtitle", "time": 25285.27, "timestamp": "07:01:25", "text": "把巧克力分发给大家"}, {"type": "subtitle", "time": 25302.59, "timestamp": "07:01:42", "text": "是啊，感觉就像我付了钱一样。"}, {"type": "subtitle", "time": 25306.07, "timestamp": "07:01:46", "text": "很多。因此，所有东西都变成了巧克力。"}, {"type": "subtitle", "time": 25312.07, "timestamp": "07:01:52", "text": "说实话，这对我来说只是几个人的事。"}, {"type": "subtitle", "time": 25314.11, "timestamp": "07:01:54", "text": "朋友们"}]
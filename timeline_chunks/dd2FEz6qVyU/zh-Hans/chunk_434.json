[{"type": "subtitle", "time": 26041.35, "timestamp": "07:14:01", "text": "巧克力。假设我把它吃了"}, {"type": "subtitle", "time": 26044.23, "timestamp": "07:14:04", "text": "全巧克力。"}, {"type": "subtitle", "time": 26046.51, "timestamp": "07:14:06", "text": "所以"}, {"type": "subtitle", "time": 26063.708, "timestamp": "07:14:23", "text": "巧克力，然后就消失了"}, {"type": "subtitle", "time": 26066.11, "timestamp": "07:14:26", "text": "远离"}, {"type": "subtitle", "time": 26068.08, "timestamp": "07:14:28", "text": "蝴蝶罐附近"}, {"type": "subtitle", "time": 26069.31, "timestamp": "07:14:29", "text": "[音乐]"}, {"type": "subtitle", "time": 26072.11, "timestamp": "07:14:32", "text": "像……"}, {"type": "subtitle", "time": 26074.07, "timestamp": "07:14:34", "text": "药水，或者像一个真正的小东西"}, {"type": "subtitle", "time": 26077.59, "timestamp": "07:14:37", "text": "一只只想……得到……的蝴蝶"}, {"type": "subtitle", "time": 26078.83, "timestamp": "07:14:38", "text": "甜的"}, {"type": "subtitle", "time": 26082.08, "timestamp": "07:14:42", "text": "来自花蜜"}, {"type": "subtitle", "time": 26090.868, "timestamp": "07:14:50", "text": "Choco，不过考试我真的好难过。"}, {"type": "subtitle", "time": 26098.39, "timestamp": "07:14:58", "text": "事情有点多，不过星期天之后我就会……"}]
[{"type": "subtitle", "time": 13207.63, "timestamp": "03:40:07", "text": "乐趣。它是"}, {"type": "subtitle", "time": 13210.99, "timestamp": "03:40:10", "text": "超过。记住所有"}, {"type": "subtitle", "time": 13215.19, "timestamp": "03:40:15", "text": "模块。最后的帽子环节结束了。寻找"}, {"type": "subtitle", "time": 13216.11, "timestamp": "03:40:16", "text": "全部"}, {"type": "subtitle", "time": 13218.19, "timestamp": "03:40:18", "text": "武器。"}, {"type": "subtitle", "time": 13220.83, "timestamp": "03:40:20", "text": "唉，一切都结束了。"}, {"type": "subtitle", "time": 13223.309, "timestamp": "03:40:23", "text": "实际上，游戏是"}, {"type": "subtitle", "time": 13227.67, "timestamp": "03:40:27", "text": "超过。我感到难过。我想哭。"}, {"type": "subtitle", "time": 13231.229, "timestamp": "03:40:31", "text": "我想哭。是吗？"}, {"type": "subtitle", "time": 13240.87, "timestamp": "03:40:40", "text": "座位？但我希望皮尤能出现在我的生活中。"}, {"type": "subtitle", "time": 13253.07, "timestamp": "03:40:53", "text": "它？真是这样吗？"}]
[{"type": "subtitle", "time": 26700.99, "timestamp": "07:25:00", "text": "一？我的意思是，不。"}, {"type": "subtitle", "time": 26704.948, "timestamp": "07:25:04", "text": "嗯，我觉得这事可能会在日本发生。"}, {"type": "subtitle", "time": 26708.67, "timestamp": "07:25:08", "text": "虽然在学校里，语言"}, {"type": "subtitle", "time": 26712.59, "timestamp": "07:25:12", "text": "学校，但是"}, {"type": "subtitle", "time": 26715.51, "timestamp": "07:25:15", "text": "学院风。嗯。我本来可以去"}, {"type": "subtitle", "time": 26718.15, "timestamp": "07:25:18", "text": "今天在那儿吗？我本来可以的"}, {"type": "subtitle", "time": 26722.91, "timestamp": "07:25:22", "text": "考虑到员工儿子喜欢的东西"}, {"type": "subtitle", "time": 26726.11, "timestamp": "07:25:26", "text": "嗯，诸如此类的事情"}, {"type": "subtitle", "time": 26728.39, "timestamp": "07:25:28", "text": "巧克力。昨天我离线了。"}, {"type": "subtitle", "time": 26732.59, "timestamp": "07:25:32", "text": "玻璃。我本来可以给我的孩子糖果的"}, {"type": "subtitle", "time": 26734.59, "timestamp": "07:25:34", "text": "老师。"}, {"type": "subtitle", "time": 26738.39, "timestamp": "07:25:38", "text": "呃，你知道，我真的很高兴能……"}, {"type": "subtitle", "time": 26743.548, "timestamp": "07:25:43", "text": "能够见到我的日本老师"}, {"type": "subtitle", "time": 26747.59, "timestamp": "07:25:47", "text": "呃，在现实生活中。"}, {"type": "subtitle", "time": 26749.07, "timestamp": "07:25:49", "text": "他活得真实"}, {"type": "subtitle", "time": 26754.468, "timestamp": "07:25:54", "text": "附近，嗯，到我们去过的地方。"}, {"type": "subtitle", "time": 26759.75, "timestamp": "07:25:59", "text": "为了上课。是啊，真是太棒了。我"}]
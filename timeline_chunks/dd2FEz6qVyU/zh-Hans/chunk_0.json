[{"type": "subtitle", "time": 16.31, "timestamp": "00:00:16", "text": "好了，直播开始了。欢迎来到第48天"}, {"type": "subtitle", "time": 18.79, "timestamp": "00:00:18", "text": "乔森。欢迎来到第二部分"}, {"type": "subtitle", "time": 22.15, "timestamp": "00:00:22", "text": "溪流，夜溪。你好。呃，为了"}, {"type": "subtitle", "time": 25.029, "timestamp": "00:00:25", "text": "那些错过的人，呃，我去给他们"}, {"type": "subtitle", "time": 27.83, "timestamp": "00:00:27", "text": "我的作业。所以当时我在外面跑步"}, {"type": "subtitle", "time": 30.189, "timestamp": "00:00:30", "text": "跑腿。是的，我摸了摸车库。"}, {"type": "subtitle", "time": 33.229, "timestamp": "00:00:33", "text": "今天，在经历了漫长的一天之后"}, {"type": "subtitle", "time": 36.63, "timestamp": "00:00:36", "text": "尽管。我被限制在房间里。"}, {"type": "subtitle", "time": 40.069, "timestamp": "00:00:40", "text": "并且每天24小时不间断直播"}, {"type": "subtitle", "time": 43.63, "timestamp": "00:00:43", "text": "两到三个月。我不知道。但"}, {"type": "subtitle", "time": 47.51, "timestamp": "00:00:47", "text": "是的，我摸了草。我被淋透了"}, {"type": "subtitle", "time": 50.47, "timestamp": "00:00:50", "text": "雨。我当时骑着我的踏板车。我曾"}, {"type": "subtitle", "time": 53.91, "timestamp": "00:00:53", "text": "我叔叔跟在我身后，我们一起去了……"}, {"type": "subtitle", "time": 55.83, "timestamp": "00:00:55", "text": "大学或类似的学习中心"}, {"type": "subtitle", "time": 59.59, "timestamp": "00:00:59", "text": "我必须在那里提交作业，"}]
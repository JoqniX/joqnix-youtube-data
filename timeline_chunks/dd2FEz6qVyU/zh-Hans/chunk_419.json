[{"type": "subtitle", "time": 25141.628, "timestamp": "06:59:01", "text": "你，这种水准的迪克斯"}, {"type": "subtitle", "time": 25143.468, "timestamp": "06:59:03", "text": "牛奶"}, {"type": "subtitle", "time": 25147.03, "timestamp": "06:59:07", "text": "我花了大约45美元买了一块巧克力。"}, {"type": "subtitle", "time": 25149.39, "timestamp": "06:59:09", "text": "如果我是卢比"}, {"type": "subtitle", "time": 25157.43, "timestamp": "06:59:17", "text": "尝起来其实和普通糖果没什么区别。"}, {"type": "subtitle", "time": 25158.99, "timestamp": "06:59:18", "text": "是"}, {"type": "subtitle", "time": 25161.43, "timestamp": "06:59:21", "text": "诚实的。好吧，不是像巧克力那样的糖果。"}, {"type": "subtitle", "time": 25164.788, "timestamp": "06:59:24", "text": "但就像我一样，这就是这个。"}, {"type": "subtitle", "time": 25166.708, "timestamp": "06:59:26", "text": "糖果。这就是味道"}, {"type": "subtitle", "time": 25168.708, "timestamp": "06:59:28", "text": "我在……买的巧克力"}, {"type": "subtitle", "time": 25171.27, "timestamp": "06:59:31", "text": "过去也是如此。我想买"}, {"type": "subtitle", "time": 25173.788, "timestamp": "06:59:33", "text": "贵的。然后我"}, {"type": "subtitle", "time": 25176.91, "timestamp": "06:59:36", "text": "认为它真的"}, {"type": "subtitle", "time": 25179.91, "timestamp": "06:59:39", "text": "需要，但没关系。但味道是"}, {"type": "subtitle", "time": 25180.99, "timestamp": "06:59:40", "text": "真的"}, {"type": "subtitle", "time": 25183.07, "timestamp": "06:59:43", "text": "很好"}, {"type": "subtitle", "time": 25186.27, "timestamp": "06:59:46", "text": "当你服用少量"}, {"type": "subtitle", "time": 25189.19, "timestamp": "06:59:49", "text": "咬"}, {"type": "subtitle", "time": 25192.708, "timestamp": "06:59:52", "text": "呃，它叫什么？它有点像融化了。"}, {"type": "subtitle", "time": 25195.788, "timestamp": "06:59:55", "text": "在你的嘴里，在你的舌头上"}, {"type": "subtitle", "time": 25198.23, "timestamp": "06:59:58", "text": "实际上。那块巧克力"}]
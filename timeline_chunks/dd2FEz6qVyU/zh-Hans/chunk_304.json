[{"type": "subtitle", "time": 18257.51, "timestamp": "05:04:17", "text": "我希望你的瞄准镜已经校准完毕。什么"}, {"type": "subtitle", "time": 18260.35, "timestamp": "05:04:20", "text": "你的意思是说景点"}, {"type": "subtitle", "time": 18282.59, "timestamp": "05:04:42", "text": "原因？"}, {"type": "subtitle", "time": 18286.35, "timestamp": "05:04:46", "text": "哦，原来是这样得到的。好吧，绝不"}, {"type": "subtitle", "time": 18289.27, "timestamp": "05:04:49", "text": "头脑。我们走吧。我们拿到了最后一支枪。"}]
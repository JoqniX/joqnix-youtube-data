[{"type": "subtitle", "time": 9555.469, "timestamp": "02:39:15", "text": "射击。不，我"}, {"type": "subtitle", "time": 9564.75, "timestamp": "02:39:24", "text": "哦，床。"}, {"type": "subtitle", "time": 9569.07, "timestamp": "02:39:29", "text": "什么？我从……开始"}, {"type": "subtitle", "time": 9573.67, "timestamp": "02:39:33", "text": "哦，我当时为什么这么享受我的天哪。"}, {"type": "subtitle", "time": 9575.55, "timestamp": "02:39:35", "text": "从这里"}, {"type": "subtitle", "time": 9577.23, "timestamp": "02:39:37", "text": "再次。"}, {"type": "subtitle", "time": 9580.15, "timestamp": "02:39:40", "text": "为什么？是的。你好，嬉皮秋千。"}, {"type": "subtitle", "time": 9582.55, "timestamp": "02:39:42", "text": "欢迎。希望你一切都好。"}, {"type": "subtitle", "time": 9583.4, "timestamp": "02:39:43", "text": "快乐的"}, {"type": "subtitle", "time": 9586.11, "timestamp": "02:39:46", "text": "[音乐]"}]
[{"type": "subtitle", "time": 19801.708, "timestamp": "05:30:01", "text": "乐趣。我非常喜欢。我很喜欢"}, {"type": "subtitle", "time": 19805.51, "timestamp": "05:30:05", "text": "它。我只需要一把霰弹枪就行了吗？我"}, {"type": "subtitle", "time": 19807.07, "timestamp": "05:30:07", "text": "可以尝试一下"}, {"type": "subtitle", "time": 19811.15, "timestamp": "05:30:11", "text": "霰弹枪。我的手指有点疼。"}, {"type": "subtitle", "time": 19815.708, "timestamp": "05:30:15", "text": "原因。我看到了，是的，持续了1个小时。"}, {"type": "subtitle", "time": 19819.11, "timestamp": "05:30:19", "text": "我想我一直在说这句话。"}, {"type": "subtitle", "time": 19840.19, "timestamp": "05:30:40", "text": "[音乐]"}]
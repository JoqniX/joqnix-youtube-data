[{"type": "subtitle", "time": 26347.83, "timestamp": "07:19:07", "text": "耶！我，我明白了，我第一次就明白了"}, {"type": "subtitle", "time": 26350.91, "timestamp": "07:19:10", "text": "情人节的时光"}, {"type": "subtitle", "time": 26353.99, "timestamp": "07:19:13", "text": "天。我甚至连一束花都没收到"}, {"type": "subtitle", "time": 26356.75, "timestamp": "07:19:16", "text": "生活。巧克力是他们的联赛"}, {"type": "subtitle", "time": 26360.23, "timestamp": "07:19:20", "text": "自己的。哦，等等。我本可以给你……"}, {"type": "subtitle", "time": 26366.43, "timestamp": "07:19:26", "text": "等待。准备一些鲜花"}, {"type": "subtitle", "time": 26369.19, "timestamp": "07:19:29", "text": "外部。它们今天盛开了。我应该吗？"}, {"type": "subtitle", "time": 26377.83, "timestamp": "07:19:37", "text": "他。安娜，没关系。我会给你"}, {"type": "subtitle", "time": 26380.468, "timestamp": "07:19:40", "text": "花朵。谢谢。好的。点赞表情"}, {"type": "subtitle", "time": 26382.67, "timestamp": "07:19:42", "text": "这就足够了。"}, {"type": "subtitle", "time": 26389.27, "timestamp": "07:19:49", "text": "达达。即使我把花插在我的"}, {"type": "subtitle", "time": 26391.39, "timestamp": "07:19:51", "text": "外面的花园，我就把它给我吧。"}]
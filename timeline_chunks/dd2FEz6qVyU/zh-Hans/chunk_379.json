[{"type": "subtitle", "time": 22740.47, "timestamp": "06:19:00", "text": "下一步是拥有我自己的原创角色。"}, {"type": "subtitle", "time": 22743.67, "timestamp": "06:19:03", "text": "接下来是运动员的角色设计，之后我会……"}, {"type": "subtitle", "time": 22746.75, "timestamp": "06:19:06", "text": "完成这件事后，我就可以继续生活了。"}, {"type": "subtitle", "time": 22750.23, "timestamp": "06:19:10", "text": "职责是第二阶段的主要任务。"}, {"type": "subtitle", "time": 22753.35, "timestamp": "06:19:13", "text": "然后我想用虚幻引擎和Unity引擎。"}, {"type": "subtitle", "time": 22756.75, "timestamp": "06:19:16", "text": "虚拟音乐会和虚拟活动所需的物品"}, {"type": "subtitle", "time": 22760.47, "timestamp": "06:19:20", "text": "世界虚拟流媒体世界等等"}, {"type": "subtitle", "time": 22763.83, "timestamp": "06:19:23", "text": "比如，呃，就像，嗯，那些东西"}, {"type": "subtitle", "time": 22768.31, "timestamp": "06:19:28", "text": "在我制作完3D模型后会完成。"}, {"type": "subtitle", "time": 22770.788, "timestamp": "06:19:30", "text": "来自 Blender 之类的软件，就是我展示的那个。"}, {"type": "subtitle", "time": 22774.31, "timestamp": "06:19:34", "text": "在 MMD1 上，我展示了一些东西。"}, {"type": "subtitle", "time": 22777.35, "timestamp": "06:19:37", "text": "像这样，或者我会用虚空，我不知道。"}, {"type": "subtitle", "time": 22779.83, "timestamp": "06:19:39", "text": "这是一个漫长的过程，但事实上我"}, {"type": "subtitle", "time": 22785.03, "timestamp": "06:19:45", "text": "必须自己一个人做，一个人做。"}, {"type": "subtitle", "time": 22787.43, "timestamp": "06:19:47", "text": "那是我一个人的表演，对，那就是"}, {"type": "subtitle", "time": 22790.548, "timestamp": "06:19:50", "text": "为什么我做事需要时间。"}, {"type": "subtitle", "time": 22794.31, "timestamp": "06:19:54", "text": "对，所以才这样，所以我才说我"}, {"type": "subtitle", "time": 22798.31, "timestamp": "06:19:58", "text": "我想我很久很久以前就发过推特了，如果我……"}]
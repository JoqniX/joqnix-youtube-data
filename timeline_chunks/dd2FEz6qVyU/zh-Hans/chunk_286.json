[{"type": "subtitle", "time": 17161.91, "timestamp": "04:46:01", "text": "去。我们走吧。镐。我的天啊。这"}, {"type": "subtitle", "time": 17165.19, "timestamp": "04:46:05", "text": "最好的枪。史上最强武器。哦，我的"}, {"type": "subtitle", "time": 17177.708, "timestamp": "04:46:17", "text": "这就是这里的全部内容了。一个"}, {"type": "subtitle", "time": 17180.59, "timestamp": "04:46:20", "text": "镐。那是"}, {"type": "subtitle", "time": 17184.43, "timestamp": "04:46:24", "text": "它。我不得不去开门。性感。"}, {"type": "subtitle", "time": 17188.59, "timestamp": "04:46:28", "text": "等待。我想我读过。"}, {"type": "subtitle", "time": 17191.35, "timestamp": "04:46:31", "text": "尽管。我差点因病去世，但感谢上帝"}, {"type": "subtitle", "time": 17200.43, "timestamp": "04:46:40", "text": "是的。你好。你好。我相信"}, {"type": "subtitle", "time": 17203.19, "timestamp": "04:46:43", "text": "有。哦，还有一个地方。"}, {"type": "subtitle", "time": 17206.51, "timestamp": "04:46:46", "text": "好的。我们来参观一下这个地方吧。"}]
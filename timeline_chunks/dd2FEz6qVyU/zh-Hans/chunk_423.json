[{"type": "subtitle", "time": 25384.708, "timestamp": "07:03:04", "text": "我这样做是为了庆祝生日和"}, {"type": "subtitle", "time": 25386.15, "timestamp": "07:03:06", "text": "情人节。我刚买了一个"}, {"type": "subtitle", "time": 25388.19, "timestamp": "07:03:08", "text": "两大巨头"}, {"type": "subtitle", "time": 25391.43, "timestamp": "07:03:11", "text": "三个牛奶制品，然后分成三份"}, {"type": "subtitle", "time": 25393.91, "timestamp": "07:03:13", "text": "一个接一个地来。不，不，不。这是"}, {"type": "subtitle", "time": 25396.15, "timestamp": "07:03:16", "text": "小的。是小的那个，对吧？你可以"}, {"type": "subtitle", "time": 25398.07, "timestamp": "07:03:18", "text": "是小的那个，对吧？五卢比"}, {"type": "subtitle", "time": 25400.788, "timestamp": "07:03:20", "text": "一。我买了很多。我"}, {"type": "subtitle", "time": 25403.468, "timestamp": "07:03:23", "text": "我想那就是我"}, {"type": "subtitle", "time": 25413.83, "timestamp": "07:03:33", "text": "今天是情人节。该死，我想打电话"}, {"type": "subtitle", "time": 25417.67, "timestamp": "07:03:37", "text": "今天，呃，我记得我做过那件事。所以"}, {"type": "subtitle", "time": 25428.99, "timestamp": "07:03:48", "text": "[音乐]"}, {"type": "subtitle", "time": 25431.67, "timestamp": "07:03:51", "text": "乐趣。嗯，我不想吃这个"}, {"type": "subtitle", "time": 25433.91, "timestamp": "07:03:53", "text": "太糟糕了，而且我还担心我的"}]
[{"type": "subtitle", "time": 11227.75, "timestamp": "03:07:07", "text": "我想我真的很想念这个地方。"}, {"type": "subtitle", "time": 11245.87, "timestamp": "03:07:25", "text": "那股冲向天空的力量？啊，这冰"}, {"type": "subtitle", "time": 11256.67, "timestamp": "03:07:36", "text": "布鲁斯，快走快走快走快走"}, {"type": "subtitle", "time": 11259.469, "timestamp": "03:07:39", "text": "慢慢地。直至"}, {"type": "subtitle", "time": 11268.389, "timestamp": "03:07:48", "text": "雪。我们走吧。我们在这里。开始"}, {"type": "subtitle", "time": 11270.99, "timestamp": "03:07:50", "text": "斗争。我们走吧。时间到了"}, {"type": "subtitle", "time": 11273.389, "timestamp": "03:07:53", "text": "杀。谁的"}, {"type": "subtitle", "time": 11276.19, "timestamp": "03:07:56", "text": "下一个？这是什么地球仪？"}]
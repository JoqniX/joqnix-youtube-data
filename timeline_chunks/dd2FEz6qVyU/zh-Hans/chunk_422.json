[{"type": "subtitle", "time": 25323.23, "timestamp": "07:02:03", "text": "巧克力和"}, {"type": "subtitle", "time": 25326.468, "timestamp": "07:02:06", "text": "对，他们当时就说我们也想要一个。"}, {"type": "subtitle", "time": 25329.15, "timestamp": "07:02:09", "text": "我必须分发"}, {"type": "subtitle", "time": 25331.51, "timestamp": "07:02:11", "text": "一切。第二年我想我会"}, {"type": "subtitle", "time": 25333.628, "timestamp": "07:02:13", "text": "实际上分发了它"}, {"type": "subtitle", "time": 25337.27, "timestamp": "07:02:17", "text": "在下课前妥善完成。我给了"}, {"type": "subtitle", "time": 25338.67, "timestamp": "07:02:18", "text": "把它给"}, {"type": "subtitle", "time": 25341.27, "timestamp": "07:02:21", "text": "老师。把它给了巧克力"}, {"type": "subtitle", "time": 25343.708, "timestamp": "07:02:23", "text": "老师"}, {"type": "subtitle", "time": 25345.23, "timestamp": "07:02:25", "text": "第一的"}, {"type": "subtitle", "time": 25348.468, "timestamp": "07:02:28", "text": "是的，我把它分发给了所有人。我"}, {"type": "subtitle", "time": 25351.35, "timestamp": "07:02:31", "text": "那天我把它当作我的生日表演。"}, {"type": "subtitle", "time": 25353.27, "timestamp": "07:02:33", "text": "实际上。"}, {"type": "subtitle", "time": 25356.548, "timestamp": "07:02:36", "text": "你知道，在高中之类的学校里，你"}, {"type": "subtitle", "time": 25358.39, "timestamp": "07:02:38", "text": "当你生日那天，你分发"}, {"type": "subtitle", "time": 25363.91, "timestamp": "07:02:43", "text": "买那种200或500克的太妃糖"}, {"type": "subtitle", "time": 25367.27, "timestamp": "07:02:47", "text": "是数据包，对吧？然后你给它"}, {"type": "subtitle", "time": 25369.35, "timestamp": "07:02:49", "text": "分发给所有CL成员，而不是"}, {"type": "subtitle", "time": 25371.43, "timestamp": "07:02:51", "text": "所有的课程，你的教室，然后到"}, {"type": "subtitle", "time": 25373.43, "timestamp": "07:02:53", "text": "然后告诉你的老师，然后是校长。"}, {"type": "subtitle", "time": 25374.43, "timestamp": "07:02:54", "text": "超过"}, {"type": "subtitle", "time": 25377.628, "timestamp": "07:02:57", "text": "事情，工作人员超过"}]
[{"type": "subtitle", "time": 25500.788, "timestamp": "07:05:00", "text": "是啊，还有书之类的东西，日期是怎么定的。"}, {"type": "subtitle", "time": 25502.75, "timestamp": "07:05:02", "text": "已完成"}, {"type": "subtitle", "time": 25505.51, "timestamp": "07:05:05", "text": "一切。所以我知道我知道我知道我"}, {"type": "subtitle", "time": 25507.75, "timestamp": "07:05:07", "text": "缺乏真实生活经验，但"}, {"type": "subtitle", "time": 25512.31, "timestamp": "07:05:12", "text": "仅摩擦力那一个。摩擦"}, {"type": "subtitle", "time": 25514.468, "timestamp": "07:05:14", "text": "一个如"}, {"type": "subtitle", "time": 25517.19, "timestamp": "07:05:17", "text": "嗯，我要去一家高档的韩国餐厅。"}, {"type": "subtitle", "time": 25519.91, "timestamp": "07:05:19", "text": "希望我的钱包不会来得太晚。"}, {"type": "subtitle", "time": 25522.07, "timestamp": "07:05:22", "text": "等等，你真的需要拥有这些吗？"}, {"type": "subtitle", "time": 25525.07, "timestamp": "07:05:25", "text": "去一个高档的地方"}, {"type": "subtitle", "time": 25527.75, "timestamp": "07:05:27", "text": "地方？那种感觉，就是那种感觉"}, {"type": "subtitle", "time": 25531.548, "timestamp": "07:05:31", "text": "这很重要，对吧？不是钱的问题。"}, {"type": "subtitle", "time": 25544.67, "timestamp": "07:05:44", "text": "但是如果你有一个"}, {"type": "subtitle", "time": 25549.548, "timestamp": "07:05:49", "text": "如果你有伴侣的话。"}, {"type": "subtitle", "time": 25552.19, "timestamp": "07:05:52", "text": "他们"}, {"type": "subtitle", "time": 25559.19, "timestamp": "07:05:59", "text": "感觉我太安逸了，不愿出门"}]
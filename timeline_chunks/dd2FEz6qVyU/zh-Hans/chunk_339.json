[{"type": "subtitle", "time": 20341.65, "timestamp": "05:39:01", "text": "没有漏掉任何人"}, {"type": "subtitle", "time": 20350.708, "timestamp": "05:39:10", "text": "别的。不过说实话，确实挺好玩的。"}, {"type": "subtitle", "time": 20352.31, "timestamp": "05:39:12", "text": "各位储物柜管理员，谢谢你们！"}, {"type": "subtitle", "time": 20354.31, "timestamp": "05:39:14", "text": "锁定流媒体。这真的意味着"}, {"type": "subtitle", "time": 20356.708, "timestamp": "05:39:16", "text": "很多。希望你喜欢。我希望不是这样。"}, {"type": "subtitle", "time": 20366.35, "timestamp": "05:39:26", "text": "所以，呃，明天我们会，呃，提前……"}, {"type": "subtitle", "time": 20370.57, "timestamp": "05:39:30", "text": "早上7点的直播"}, {"type": "subtitle", "time": 20372.91, "timestamp": "05:39:32", "text": "[音乐]"}, {"type": "subtitle", "time": 20377.39, "timestamp": "05:39:37", "text": "上午。是的。呃，早上7点。"}, {"type": "subtitle", "time": 20379.91, "timestamp": "05:39:39", "text": "溪流，晨溪，然后我们将"}, {"type": "subtitle", "time": 20382.39, "timestamp": "05:39:42", "text": "可能会进行工作流程。好的。我只是"}, {"type": "subtitle", "time": 20385.19, "timestamp": "05:39:45", "text": "今天想早点睡，这样我就可以……"}, {"type": "subtitle", "time": 20389.11, "timestamp": "05:39:49", "text": "饱腹、精力充沛、身体健康、睡眠充足"}, {"type": "subtitle", "time": 20392.91, "timestamp": "05:39:52", "text": "对我来说足够了"}, {"type": "subtitle", "time": 20395.75, "timestamp": "05:39:55", "text": "明天会非常忙碌。明天我们有"}, {"type": "subtitle", "time": 20397.99, "timestamp": "05:39:57", "text": "去工作。我玩游戏，我应该做我的"}, {"type": "subtitle", "time": 20399.99, "timestamp": "05:39:59", "text": "今天工作很忙，但我当时想的是，"}]
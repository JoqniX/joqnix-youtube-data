[{"type": "subtitle", "time": 24363.19, "timestamp": "06:46:03", "text": "妮娜，我喜欢剑鱼。"}, {"type": "subtitle", "time": 24365.19, "timestamp": "06:46:05", "text": "我为什么要付出双倍的代价？"}, {"type": "subtitle", "time": 24378.15, "timestamp": "06:46:18", "text": "上帝。不，作为一名 YouTuber，我甚至不能……"}, {"type": "subtitle", "time": 24380.31, "timestamp": "06:46:20", "text": "我已经有对象了，我不能告诉你们，我"}, {"type": "subtitle", "time": 24382.59, "timestamp": "06:46:22", "text": "猜测，直到时间到来"}, {"type": "subtitle", "time": 24385.31, "timestamp": "06:46:25", "text": "正确的。"}, {"type": "subtitle", "time": 24393.39, "timestamp": "06:46:33", "text": "为什么？我确信你会这么说。"}, {"type": "subtitle", "time": 24397.23, "timestamp": "06:46:37", "text": "当我再次打开我的手持摄像头时"}, {"type": "subtitle", "time": 24400.91, "timestamp": "06:46:40", "text": "就像吃巧克力一样"}, {"type": "subtitle", "time": 24403.07, "timestamp": "06:46:43", "text": "和你单独待在一起"}, {"type": "subtitle", "time": 24405.91, "timestamp": "06:46:45", "text": "伙计们。你也会这么说。"}, {"type": "subtitle", "time": 24407.948, "timestamp": "06:46:47", "text": "和他们在一起，兄弟。是吗？"}, {"type": "subtitle", "time": 24411.708, "timestamp": "06:46:51", "text": "单身的？等等，是"}, {"type": "subtitle", "time": 24413.23, "timestamp": "06:46:53", "text": "好的。"}, {"type": "subtitle", "time": 24416.27, "timestamp": "06:46:56", "text": "巴巴"}]
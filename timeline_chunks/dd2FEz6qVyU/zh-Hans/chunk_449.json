[{"type": "subtitle", "time": 26945.43, "timestamp": "07:29:05", "text": "那。所以我不知道现实生活是什么样的"}, {"type": "subtitle", "time": 26946.83, "timestamp": "07:29:06", "text": "事物"}, {"type": "subtitle", "time": 26949.43, "timestamp": "07:29:09", "text": "是。如果你需要一天时间来提醒自己"}, {"type": "subtitle", "time": 26950.788, "timestamp": "07:29:10", "text": "珍惜爱，你不是真爱"}, {"type": "subtitle", "time": 26971.03, "timestamp": "07:29:31", "text": "那。不，不，不，不，不，不。那是"}, {"type": "subtitle", "time": 26978.868, "timestamp": "07:29:38", "text": "坏的。哦，日本就有那种情况。"}, {"type": "subtitle", "time": 26980.27, "timestamp": "07:29:40", "text": "设置，"}, {"type": "subtitle", "time": 26982.75, "timestamp": "07:29:42", "text": "正确的？我忘了这件事"}, {"type": "subtitle", "time": 26986.75, "timestamp": "07:29:46", "text": "那。日本有那个"}, {"type": "subtitle", "time": 26989.628, "timestamp": "07:29:49", "text": "甚至还有一部关于它的动画"}, {"type": "subtitle", "time": 26992.99, "timestamp": "07:29:52", "text": "它。我一点也不喜欢"}, {"type": "subtitle", "time": 26995.83, "timestamp": "07:29:55", "text": "什么？我当然不会那样做。那是"}, {"type": "subtitle", "time": 26998.628, "timestamp": "07:29:58", "text": "那样做太作弊了。我想要"}]
[{"type": "subtitle", "time": 17948.15, "timestamp": "04:59:08", "text": "这？我真的登顶了。"}, {"type": "subtitle", "time": 17952.708, "timestamp": "04:59:12", "text": "搞什么鬼？我的天啊。等等，什么？"}, {"type": "subtitle", "time": 17961.27, "timestamp": "04:59:21", "text": "方式。我不可能真的没做。"}, {"type": "subtitle", "time": 17983.19, "timestamp": "04:59:43", "text": "我成功了。我的天啊。我成功了。我做了"}, {"type": "subtitle", "time": 17986.23, "timestamp": "04:59:46", "text": "它。游戏结束了。我们走吧。"}, {"type": "subtitle", "time": 17989.07, "timestamp": "04:59:49", "text": "我们成功了。我们成功了。我们制作"}, {"type": "subtitle", "time": 17992.75, "timestamp": "04:59:52", "text": "它。兄弟，我希望你那边也看到了。"}]
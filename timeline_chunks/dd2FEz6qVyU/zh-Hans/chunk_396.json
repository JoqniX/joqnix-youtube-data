[{"type": "subtitle", "time": 23766.11, "timestamp": "06:36:06", "text": "你好。呃，今天的直播有点……"}, {"type": "subtitle", "time": 23769.75, "timestamp": "06:36:09", "text": "虽然有些磨损，但没关系。"}, {"type": "subtitle", "time": 23771.708, "timestamp": "06:36:11", "text": "呃"}, {"type": "subtitle", "time": 23784.91, "timestamp": "06:36:24", "text": "分钟。给我一个"}, {"type": "subtitle", "time": 23788.35, "timestamp": "06:36:28", "text": "分钟。你好。所以"}, {"type": "subtitle", "time": 23791.628, "timestamp": "06:36:31", "text": "今天我知道这有点"}, {"type": "subtitle", "time": 23795.868, "timestamp": "06:36:35", "text": "磨损。我知道它有点磨损。它"}, {"type": "subtitle", "time": 23800.708, "timestamp": "06:36:40", "text": "是。虽然有点磨损，但我很满意。"}, {"type": "subtitle", "time": 23802.75, "timestamp": "06:36:42", "text": "情人节"}, {"type": "subtitle", "time": 23805.43, "timestamp": "06:36:45", "text": "全部。今天是个特别的日子，而且是"}, {"type": "subtitle", "time": 23807.75, "timestamp": "06:36:47", "text": "也是一个特别的日子"}, {"type": "subtitle", "time": 23811.99, "timestamp": "06:36:51", "text": "呃，对我们所有在这个频道的人来说，因为"}, {"type": "subtitle", "time": 23814.868, "timestamp": "06:36:54", "text": "呃，每年情人节"}, {"type": "subtitle", "time": 23816.27, "timestamp": "06:36:56", "text": "我们"}, {"type": "subtitle", "time": 23818.708, "timestamp": "06:36:58", "text": "庆祝的时候我送巧克力"}]
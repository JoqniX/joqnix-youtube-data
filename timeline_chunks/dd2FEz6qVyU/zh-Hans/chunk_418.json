[{"type": "subtitle", "time": 25082.11, "timestamp": "06:58:02", "text": "不，你想要巧克力。我该如何给你"}, {"type": "subtitle", "time": 25086.15, "timestamp": "06:58:06", "text": "巧克力？如果真有办法就好了。"}, {"type": "subtitle", "time": 25089.19, "timestamp": "06:58:09", "text": "你们当时就能尝到这种味道。"}, {"type": "subtitle", "time": 25091.35, "timestamp": "06:58:11", "text": "那该多好啊。唯一"}, {"type": "subtitle", "time": 25093.51, "timestamp": "06:58:13", "text": "你可以做的就是真的去弄一个"}, {"type": "subtitle", "time": 25113.39, "timestamp": "06:58:33", "text": "家庭。用五句话解释一下味道。"}, {"type": "subtitle", "time": 25137.948, "timestamp": "06:58:57", "text": "说实话"}]
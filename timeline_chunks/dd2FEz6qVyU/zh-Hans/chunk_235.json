[{"type": "subtitle", "time": 14114.389, "timestamp": "03:55:14", "text": "后退。我相信我也收到了。然后"}, {"type": "subtitle", "time": 14129.189, "timestamp": "03:55:29", "text": "什么？我好困惑。我要去哪里？"}, {"type": "subtitle", "time": 14138.15, "timestamp": "03:55:38", "text": "我？哦。哦，等等。这是“哦”，"}, {"type": "subtitle", "time": 14139.75, "timestamp": "03:55:39", "text": "是的。是的。这个地方。好的。好的。"}, {"type": "subtitle", "time": 14157.91, "timestamp": "03:55:57", "text": "这里。是的。这个地方我还没来过。"}]
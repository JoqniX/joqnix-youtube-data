[{"type": "subtitle", "time": 23220.948, "timestamp": "06:27:00", "text": "如果你仔细观察，就能发现这一点。"}, {"type": "subtitle", "time": 23224.788, "timestamp": "06:27:04", "text": "发现了很多错误，大概有17到20个。"}, {"type": "subtitle", "time": 23226.628, "timestamp": "06:27:06", "text": "在这门艺术中。"}, {"type": "subtitle", "time": 23230.39, "timestamp": "06:27:10", "text": "一个人可以这样表达这种不自信的言论"}, {"type": "subtitle", "time": 23234.27, "timestamp": "06:27:14", "text": "我在这里做了些事情，还有一些其他的事情。"}, {"type": "subtitle", "time": 23236.91, "timestamp": "06:27:16", "text": "头发，尤其是头发"}, {"type": "subtitle", "time": 23240.11, "timestamp": "06:27:20", "text": "眼睛脸型出现"}, {"type": "subtitle", "time": 23243.07, "timestamp": "06:27:23", "text": "但少数人"}, {"type": "subtitle", "time": 23246.628, "timestamp": "06:27:26", "text": "虽然犯了错误，但我仍然……"}, {"type": "subtitle", "time": 23250.39, "timestamp": "06:27:30", "text": "学习，学习，所以需要喜欢……"}, {"type": "subtitle", "time": 23253.27, "timestamp": "06:27:33", "text": "目前我正在向……学习"}, {"type": "subtitle", "time": 23256.75, "timestamp": "06:27:36", "text": "我们社区里的人，实际上，呃，是谁？"}, {"type": "subtitle", "time": 23259.628, "timestamp": "06:27:39", "text": "等等，呃，走吧，让我去看看艺术。"}, {"type": "subtitle", "time": 23262.39, "timestamp": "06:27:42", "text": "部分成员包括像Helixen这样的人"}, {"type": "subtitle", "time": 23264.51, "timestamp": "06:27:44", "text": "非常好"}, {"type": "subtitle", "time": 23267.75, "timestamp": "06:27:47", "text": "艺术家画了一个超级英雄"}, {"type": "subtitle", "time": 23271.51, "timestamp": "06:27:51", "text": "写实艺术和从事像素艺术的戴维森"}, {"type": "subtitle", "time": 23275.19, "timestamp": "06:27:55", "text": "他拥有独特的艺术风格。"}, {"type": "subtitle", "time": 23277.23, "timestamp": "06:27:57", "text": "独特风格"}]
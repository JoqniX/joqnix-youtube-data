[{"type": "subtitle", "time": 27064.67, "timestamp": "07:31:04", "text": "伙伴。"}, {"type": "subtitle", "time": 27067.03, "timestamp": "07:31:07", "text": "巧克力。希望我是第一个"}, {"type": "subtitle", "time": 27075.35, "timestamp": "07:31:15", "text": "我要对所有来的人说……"}, {"type": "subtitle", "time": 27078.548, "timestamp": "07:31:18", "text": "今天。你好，Isensa。情人节快乐"}, {"type": "subtitle", "time": 27082.99, "timestamp": "07:31:22", "text": "天。你想吃巧克力吗？是的，我的"}, {"type": "subtitle", "time": 27087.948, "timestamp": "07:31:27", "text": "巧克力。我希望我是第一个。"}, {"type": "subtitle", "time": 27090.468, "timestamp": "07:31:30", "text": "眨眼。我很乐意送你一些东西。"}, {"type": "subtitle", "time": 27092.31, "timestamp": "07:31:32", "text": "当我寄出这个包裹的时候。所以，我"}, {"type": "subtitle", "time": 27095.708, "timestamp": "07:31:35", "text": "我想我会一直留着这个，直到……"}, {"type": "subtitle", "time": 27097.548, "timestamp": "07:31:37", "text": "你"}, {"type": "subtitle", "time": 27100.628, "timestamp": "07:31:40", "text": "事件。我不知道如何设置邮政信箱"}]
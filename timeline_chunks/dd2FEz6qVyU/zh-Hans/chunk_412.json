[{"type": "subtitle", "time": 24722.868, "timestamp": "06:52:02", "text": "父母和我，呃，我喜欢，呃，给他们，因为"}, {"type": "subtitle", "time": 24725.67, "timestamp": "06:52:05", "text": "嗯，我眼中的情人节就像……"}, {"type": "subtitle", "time": 24729.11, "timestamp": "06:52:09", "text": "与你一起庆祝，呃，与"}, {"type": "subtitle", "time": 24731.11, "timestamp": "06:52:11", "text": "你最珍惜和最爱的人"}, {"type": "subtitle", "time": 24734.708, "timestamp": "06:52:14", "text": "很多也涉及到你的宠物，你的"}, {"type": "subtitle", "time": 24741.59, "timestamp": "06:52:21", "text": "一切。你知道，当我还是……的时候"}, {"type": "subtitle", "time": 24745.31, "timestamp": "06:52:25", "text": "真的很少，我以前喂"}, {"type": "subtitle", "time": 24749.59, "timestamp": "06:52:29", "text": "呃，一些随机出现的昆虫，比如我的食物和"}, {"type": "subtitle", "time": 24752.31, "timestamp": "06:52:32", "text": "东西。那天真是太疯狂了。后退"}, {"type": "subtitle", "time": 24757.43, "timestamp": "06:52:37", "text": "我记得那天，我当时是这样的："}, {"type": "subtitle", "time": 24759.91, "timestamp": "06:52:39", "text": "“是的，这是个特别的日子。这是我的……”"}, {"type": "subtitle", "time": 24762.19, "timestamp": "06:52:42", "text": "生日。”我还留了一个蛋糕。"}, {"type": "subtitle", "time": 24766.27, "timestamp": "06:52:46", "text": "在我门外，就像"}, {"type": "subtitle", "time": 24769.83, "timestamp": "06:52:49", "text": "哦哦，就像蚂蚁一样，我心想：好好享受吧！"}, {"type": "subtitle", "time": 24771.628, "timestamp": "06:52:51", "text": "蛋糕"}, {"type": "subtitle", "time": 24773.548, "timestamp": "06:52:53", "text": "那里。"}, {"type": "subtitle", "time": 24776.788, "timestamp": "06:52:56", "text": "好吧，那你又可以算单身了。那里"}, {"type": "subtitle", "time": 24778.468, "timestamp": "06:52:58", "text": "单身人士太多了。"}]
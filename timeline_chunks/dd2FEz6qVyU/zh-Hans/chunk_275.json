[{"type": "subtitle", "time": 16509.48, "timestamp": "04:35:09", "text": "尽管。我究竟是什么？"}, {"type": "subtitle", "time": 16520.189, "timestamp": "04:35:20", "text": "丢失的？这个地方真大啊"}, {"type": "subtitle", "time": 16537.39, "timestamp": "04:35:37", "text": "尽管？哦，"}, {"type": "subtitle", "time": 16541.709, "timestamp": "04:35:41", "text": "等待。谁目前的声音是"}, {"type": "subtitle", "time": 16546.269, "timestamp": "04:35:46", "text": "这？但上面写着“二分之一”。"}, {"type": "subtitle", "time": 16548.789, "timestamp": "04:35:48", "text": "三。等等，等等，等等。我觉得我上线了"}, {"type": "subtitle", "time": 16550.949, "timestamp": "04:35:50", "text": "又来错地方了。等等，稍等。"}]
[{"type": "subtitle", "time": 20283.11, "timestamp": "05:38:03", "text": "谢谢你的光临。谢谢你，梅尔。感谢"}, {"type": "subtitle", "time": 20284.548, "timestamp": "05:38:04", "text": "谢谢你的光临。好久不见了。"}, {"type": "subtitle", "time": 20287.03, "timestamp": "05:38:07", "text": "谢谢。希望你今天过得愉快。现在，"}, {"type": "subtitle", "time": 20288.35, "timestamp": "05:38:08", "text": "它是"}, {"type": "subtitle", "time": 20291.67, "timestamp": "05:38:11", "text": "好的。然后布拉德来了。谢谢你，"}, {"type": "subtitle", "time": 20293.43, "timestamp": "05:38:13", "text": "布拉德，谢谢你过来。最后，但是"}, {"type": "subtitle", "time": 20298.27, "timestamp": "05:38:18", "text": "其中最重要的是 Vector。 Vector 的出现是为了"}, {"type": "subtitle", "time": 20301.67, "timestamp": "05:38:21", "text": "出色地。你们太棒了！感谢"}, {"type": "subtitle", "time": 20303.51, "timestamp": "05:38:23", "text": "你。"}, {"type": "subtitle", "time": 20306.31, "timestamp": "05:38:26", "text": "我不知道你们是怎么看我的。"}, {"type": "subtitle", "time": 20308.868, "timestamp": "05:38:28", "text": "今天。真的就只有我一个人。"}, {"type": "subtitle", "time": 20311.548, "timestamp": "05:38:31", "text": "像和……一样燃烧"}, {"type": "subtitle", "time": 20315.15, "timestamp": "05:38:35", "text": "游戏。它也是一款快节奏的动作游戏。"}, {"type": "subtitle", "time": 20328.47, "timestamp": "05:38:48", "text": "看看那个？我还在打哈欠。妈妈也"}, {"type": "subtitle", "time": 20330.868, "timestamp": "05:38:50", "text": "就是我。谢谢你路过"}, {"type": "subtitle", "time": 20331.948, "timestamp": "05:38:51", "text": "也一样。"}, {"type": "subtitle", "time": 20335.75, "timestamp": "05:38:55", "text": "我有点想你了。错过"}, {"type": "subtitle", "time": 20339.19, "timestamp": "05:38:59", "text": "谢谢。是的，我相信我"}]
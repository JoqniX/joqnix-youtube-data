[{"type": "subtitle", "time": 22081.788, "timestamp": "06:08:01", "text": "改用无版权音乐"}, {"type": "subtitle", "time": 22084.11, "timestamp": "06:08:04", "text": "我的意思是……"}, {"type": "subtitle", "time": 22086.628, "timestamp": "06:08:06", "text": "我不知道我为什么要在Twitch上做这件事"}, {"type": "subtitle", "time": 22089.548, "timestamp": "06:08:09", "text": "Twitch 上所有非版权内容"}, {"type": "subtitle", "time": 22092.15, "timestamp": "06:08:12", "text": "那些企业音乐，我的意思是，不是那种。"}, {"type": "subtitle", "time": 22094.708, "timestamp": "06:08:14", "text": "非操作，我的意思是合作音乐演奏"}, {"type": "subtitle", "time": 22096.708, "timestamp": "06:08:16", "text": "通常你不应该这样做，因为这样会让你……"}, {"type": "subtitle", "time": 22098.35, "timestamp": "06:08:18", "text": "渠道"}, {"type": "subtitle", "time": 22100.43, "timestamp": "06:08:20", "text": "安全吗？我不安全。"}, {"type": "subtitle", "time": 22103.43, "timestamp": "06:08:23", "text": "我知道很明显，我也准备好了，你好，所以我是"}, {"type": "subtitle", "time": 22105.59, "timestamp": "06:08:25", "text": "我刚来，也是个小宝宝。哦，来源"}, {"type": "subtitle", "time": 22108.548, "timestamp": "06:08:28", "text": "灵魂。等等，你不是给我发过一个……"}, {"type": "subtitle", "time": 22111.59, "timestamp": "06:08:31", "text": "今天加好友？我想我做到了。"}, {"type": "subtitle", "time": 22113.91, "timestamp": "06:08:33", "text": "是的，我想我做到了。是的。欢迎，"}, {"type": "subtitle", "time": 22115.07, "timestamp": "06:08:35", "text": "欢迎。"}, {"type": "subtitle", "time": 22117.39, "timestamp": "06:08:37", "text": "标题。"}, {"type": "subtitle", "time": 22121.19, "timestamp": "06:08:41", "text": "头。为所有人服务。头部垫"}, {"type": "subtitle", "time": 22123.99, "timestamp": "06:08:43", "text": "每个人。需要解决延迟问题。哟，我"}, {"type": "subtitle", "time": 22127.99, "timestamp": "06:08:47", "text": "需要解决延迟问题。对，独奏。呃，我"}, {"type": "subtitle", "time": 22130.43, "timestamp": "06:08:50", "text": "认为你们有过合作"}, {"type": "subtitle", "time": 22133.548, "timestamp": "06:08:53", "text": "呃呃代号"}, {"type": "subtitle", "time": 22136.788, "timestamp": "06:08:56", "text": "节目中没有出现任何异常。我不知道。我不"}, {"type": "subtitle", "time": 22139.19, "timestamp": "06:08:59", "text": "知道。但有点提醒我，我有点明白"}]
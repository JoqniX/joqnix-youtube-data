[{"type": "subtitle", "time": 26405.51, "timestamp": "07:20:05", "text": "[音乐]"}, {"type": "subtitle", "time": 26407.75, "timestamp": "07:20:07", "text": "我现在开始更多地使用手持摄像机了。"}, {"type": "subtitle", "time": 26409.91, "timestamp": "07:20:09", "text": "你的情人节过得怎么样？我的"}, {"type": "subtitle", "time": 26412.468, "timestamp": "07:20:12", "text": "情人节简直就是迪奥"}, {"type": "subtitle", "time": 26415.67, "timestamp": "07:20:15", "text": "和你们一起庆祝、聊天"}, {"type": "subtitle", "time": 26418.788, "timestamp": "07:20:18", "text": "晚上我得收拾行李。"}, {"type": "subtitle", "time": 26421.788, "timestamp": "07:20:21", "text": "个人物品和类似的东西"}, {"type": "subtitle", "time": 26425.39, "timestamp": "07:20:25", "text": "针对钦奈。我要去钦奈。"}, {"type": "subtitle", "time": 26434.948, "timestamp": "07:20:34", "text": "考试。然后你要去拜访你的"}, {"type": "subtitle", "time": 26445.59, "timestamp": "07:20:45", "text": "哦，你还在说上一部呢。"}, {"type": "subtitle", "time": 26453.03, "timestamp": "07:20:53", "text": "上帝。你想要的，我不想要的"}]
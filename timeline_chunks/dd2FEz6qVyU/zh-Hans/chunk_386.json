[{"type": "subtitle", "time": 23161.788, "timestamp": "06:26:01", "text": "多年来，我通过直播成为了"}, {"type": "subtitle", "time": 23166.548, "timestamp": "06:26:06", "text": "专业人士。物品也是如此。所以，我"}, {"type": "subtitle", "time": 23169.43, "timestamp": "06:26:09", "text": "想让我的模型做一些肛交之类的事情。"}, {"type": "subtitle", "time": 23172.99, "timestamp": "06:26:12", "text": "完美的。正确的。呃，说话"}, {"type": "subtitle", "time": 23176.708, "timestamp": "06:26:16", "text": "关于画画啊，我突然想起来我们"}, {"type": "subtitle", "time": 23179.23, "timestamp": "06:26:19", "text": "还没完成"}, {"type": "subtitle", "time": 23182.15, "timestamp": "06:26:22", "text": "我们的，我们还没有完成我们的"}, {"type": "subtitle", "time": 23184.91, "timestamp": "06:26:24", "text": "画出我们像心一样的东西"}, {"type": "subtitle", "time": 23188.91, "timestamp": "06:26:28", "text": "那个心形表情我们应该是"}, {"type": "subtitle", "time": 23191.788, "timestamp": "06:26:31", "text": "我们还没完成。"}, {"type": "subtitle", "time": 23194.07, "timestamp": "06:26:34", "text": "对，这个表情我们还没有。"}, {"type": "subtitle", "time": 23206.15, "timestamp": "06:26:46", "text": "是的。呃，所以，画头部。这也"}, {"type": "subtitle", "time": 23208.43, "timestamp": "06:26:48", "text": "我需要多划船。"}, {"type": "subtitle", "time": 23211.51, "timestamp": "06:26:51", "text": "课程。呃，这是我画的那张"}, {"type": "subtitle", "time": 23214.35, "timestamp": "06:26:54", "text": "祖基·汗在"}, {"type": "subtitle", "time": 23218.07, "timestamp": "06:26:58", "text": "乍得。当我为祖基汗作画时，正如你"}]
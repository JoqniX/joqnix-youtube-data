[{"type": "subtitle", "time": 22981.27, "timestamp": "06:23:01", "text": "心地善良的人寥寥无几。"}, {"type": "subtitle", "time": 22982.59, "timestamp": "06:23:02", "text": "准备好"}, {"type": "subtitle", "time": 22987.11, "timestamp": "06:23:07", "text": "杀了我之类的。我不想"}, {"type": "subtitle", "time": 22989.83, "timestamp": "06:23:09", "text": "让他们帮我做这件事，你知道的。我只是"}, {"type": "subtitle", "time": 22991.59, "timestamp": "06:23:11", "text": "我想自己动手，把这些都学会。"}, {"type": "subtitle", "time": 22992.75, "timestamp": "06:23:12", "text": "这些"}, {"type": "subtitle", "time": 22996.19, "timestamp": "06:23:16", "text": "工艺。那是以前常用的东西"}, {"type": "subtitle", "time": 22999.83, "timestamp": "06:23:19", "text": "说。我不擅长表达“我等不及了”。"}, {"type": "subtitle", "time": 23001.75, "timestamp": "06:23:21", "text": "万事通。那个东西。呃"}, {"type": "subtitle", "time": 23004.43, "timestamp": "06:23:24", "text": "那句话怎么说的？"}, {"type": "subtitle", "time": 23008.948, "timestamp": "06:23:28", "text": "四边形。万事通。是的。杰克"}, {"type": "subtitle", "time": 23011.83, "timestamp": "06:23:31", "text": "所有交易。韵律大师。没有任何。是的，"}, {"type": "subtitle", "time": 23013.35, "timestamp": "06:23:33", "text": "就是那件事。这就是我。"}, {"type": "subtitle", "time": 23016.788, "timestamp": "06:23:36", "text": "现在因为我以前……哦，为什么我"}, {"type": "subtitle", "time": 23019.07, "timestamp": "06:23:39", "text": "拿"}, {"type": "subtitle", "time": 23022.07, "timestamp": "06:23:42", "text": "因为我以前用Photoshop做音乐。"}, {"type": "subtitle", "time": 23026.47, "timestamp": "06:23:46", "text": "以前做过插画，以前做过3D建模，"}, {"type": "subtitle", "time": 23028.03, "timestamp": "06:23:48", "text": "一切，一切，"}, {"type": "subtitle", "time": 23031.27, "timestamp": "06:23:51", "text": "一切。游戏设计，所有的一切。"}, {"type": "subtitle", "time": 23034.27, "timestamp": "06:23:54", "text": "以前经常这样做，但后来放弃了。"}, {"type": "subtitle", "time": 23036.548, "timestamp": "06:23:56", "text": "一切。所以，很难回来。"}]
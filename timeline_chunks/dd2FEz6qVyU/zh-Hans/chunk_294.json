[{"type": "subtitle", "time": 17646.11, "timestamp": "04:54:06", "text": "等待。嘿，我做了"}, {"type": "subtitle", "time": 17654.15, "timestamp": "04:54:14", "text": "这里。哦。哦。好的。好的，好的，好的。我"}, {"type": "subtitle", "time": 17655.99, "timestamp": "04:54:15", "text": "我认为这将表明他会这样做"}, {"type": "subtitle", "time": 17658.43, "timestamp": "04:54:18", "text": "告诉我怎么去那个地方"}, {"type": "subtitle", "time": 17672.19, "timestamp": "04:54:32", "text": "不，兄弟，等等，他没露面。"}, {"type": "subtitle", "time": 17687.59, "timestamp": "04:54:47", "text": "它。哦，是这个。最后一次演示"}, {"type": "subtitle", "time": 17689.55, "timestamp": "04:54:49", "text": "[音乐]"}, {"type": "subtitle", "time": 17693.11, "timestamp": "04:54:53", "text": "武器。等等，那是辆98型车吗？原谅"}, {"type": "subtitle", "time": 17696.11, "timestamp": "04:54:56", "text": "我。你是怎么得到"}, {"type": "subtitle", "time": 17699.948, "timestamp": "04:54:59", "text": "那？那是一辆98号车。"}]
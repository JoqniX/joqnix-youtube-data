[{"type": "subtitle", "time": 26883.11, "timestamp": "07:28:03", "text": "嗯？什么？显然他们是高手。"}, {"type": "subtitle", "time": 26885.83, "timestamp": "07:28:05", "text": "什么？它们有不同类型的哦，"}, {"type": "subtitle", "time": 26887.23, "timestamp": "07:28:07", "text": "你没有"}, {"type": "subtitle", "time": 26891.35, "timestamp": "07:28:11", "text": "乔一。我有一张。什么？我不这么认为"}, {"type": "subtitle", "time": 26892.51, "timestamp": "07:28:12", "text": "有一个。"}, {"type": "subtitle", "time": 26895.27, "timestamp": "07:28:15", "text": "笨蛋，这只是你的想象。它在"}, {"type": "subtitle", "time": 26897.31, "timestamp": "07:28:17", "text": "你的"}, {"type": "subtitle", "time": 26899.628, "timestamp": "07:28:19", "text": "梦。"}, {"type": "subtitle", "time": 26903.43, "timestamp": "07:28:23", "text": "所以，我在这方面太笨了……"}, {"type": "subtitle", "time": 26906.11, "timestamp": "07:28:26", "text": "浪漫之类的。我不知道"}, {"type": "subtitle", "time": 26910.468, "timestamp": "07:28:30", "text": "很多。我甚至还没约会过呢。"}, {"type": "subtitle", "time": 26913.27, "timestamp": "07:28:33", "text": "我想体验一下。"}, {"type": "subtitle", "time": 26915.23, "timestamp": "07:28:35", "text": "但我的问题是……"}, {"type": "subtitle", "time": 26919.51, "timestamp": "07:28:39", "text": "我觉得我做得也不太真实。我"}, {"type": "subtitle", "time": 26924.948, "timestamp": "07:28:44", "text": "我的想法更像是因为我的世界"}, {"type": "subtitle", "time": 26928.15, "timestamp": "07:28:48", "text": "浪漫之类的东西"}, {"type": "subtitle", "time": 26932.07, "timestamp": "07:28:52", "text": "呃，灵感来源，或者更像是因何而闻名"}, {"type": "subtitle", "time": 26933.31, "timestamp": "07:28:53", "text": "动漫和"}, {"type": "subtitle", "time": 26937.43, "timestamp": "07:28:57", "text": "所有关于动漫的虚构书籍"}, {"type": "subtitle", "time": 26939.15, "timestamp": "07:28:59", "text": "浪漫喜剧"}]
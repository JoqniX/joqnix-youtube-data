[{"type": "subtitle", "time": 25691.59, "timestamp": "07:08:11", "text": "所以当我养成去……的习惯时"}, {"type": "subtitle", "time": 25694.03, "timestamp": "07:08:14", "text": "真酷！"}, {"type": "subtitle", "time": 25707.75, "timestamp": "07:08:27", "text": "哦，它们真的很好吃。我"}, {"type": "subtitle", "time": 25714.548, "timestamp": "07:08:34", "text": "其实是因为我不太吃巧克力。"}, {"type": "subtitle", "time": 25716.99, "timestamp": "07:08:36", "text": "实际上。"}, {"type": "subtitle", "time": 25725.07, "timestamp": "07:08:45", "text": "[音乐]"}, {"type": "subtitle", "time": 25728.868, "timestamp": "07:08:48", "text": "不。但我可以，我可以，我可以，我可以肯定"}, {"type": "subtitle", "time": 25731.11, "timestamp": "07:08:51", "text": "我将体验生活"}]
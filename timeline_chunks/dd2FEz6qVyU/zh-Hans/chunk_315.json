[{"type": "subtitle", "time": 18902.83, "timestamp": "05:15:02", "text": "完毕。我们"}, {"type": "subtitle", "time": 18914.55, "timestamp": "05:15:14", "text": "乐趣。哦，糟糕。那真是太有趣了。我想"}, {"type": "subtitle", "time": 18918.39, "timestamp": "05:15:18", "text": "想多玩玩这个游戏，但是，我又得……"}, {"type": "subtitle", "time": 18926.15, "timestamp": "05:15:26", "text": "嗯？我能想象自己打开这款游戏的样子"}, {"type": "subtitle", "time": 18927.868, "timestamp": "05:15:27", "text": "只是为了做"}, {"type": "subtitle", "time": 18930.47, "timestamp": "05:15:30", "text": "这。你知道吗？我可能会玩"}, {"type": "subtitle", "time": 18932.83, "timestamp": "05:15:32", "text": "类似这样的游戏，我"}, {"type": "subtitle", "time": 18936.11, "timestamp": "05:15:36", "text": "猜测。薪水并没有更高，我"}, {"type": "subtitle", "time": 18940.47, "timestamp": "05:15:40", "text": "猜猜看，因为这太有趣了。不。我可以吗？"}, {"type": "subtitle", "time": 18941.868, "timestamp": "05:15:41", "text": "一"}]
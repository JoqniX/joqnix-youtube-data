[{"type": "subtitle", "time": 21120.59, "timestamp": "05:52:00", "text": "就像我想要的那样，就像我确实有一样。"}, {"type": "subtitle", "time": 21123.39, "timestamp": "05:52:03", "text": "它在某个地方。我忘了我把它放在哪儿了。"}, {"type": "subtitle", "time": 21126.23, "timestamp": "05:52:06", "text": "它。我一直都得这么做，所以我不会……"}, {"type": "subtitle", "time": 21129.47, "timestamp": "05:52:09", "text": "不必总是喜欢、喜欢或做某事。"}, {"type": "subtitle", "time": 21132.39, "timestamp": "05:52:12", "text": "这。让我来给你演示一下。我一直都有"}, {"type": "subtitle", "time": 21135.43, "timestamp": "05:52:15", "text": "为此，请连接到"}, {"type": "subtitle", "time": 21138.35, "timestamp": "05:52:18", "text": "我无法离开的直播"}, {"type": "subtitle", "time": 21142.708, "timestamp": "05:52:22", "text": "木板。我想应该是两个吧，而且我一直都是"}, {"type": "subtitle", "time": 21145.75, "timestamp": "05:52:25", "text": "必须得戴个头带之类的东西，"}, {"type": "subtitle", "time": 21146.75, "timestamp": "05:52:26", "text": "东西"}, {"type": "subtitle", "time": 21149.19, "timestamp": "05:52:29", "text": "这里。我来给你演示一下我是怎么做的。"}, {"type": "subtitle", "time": 21151.19, "timestamp": "05:52:31", "text": "通常情况下。通常我必须这样做"}, {"type": "subtitle", "time": 21155.03, "timestamp": "05:52:35", "text": "打开这个东西，放上头垫。"}, {"type": "subtitle", "time": 21157.35, "timestamp": "05:52:37", "text": "这就是为什么我总是要这样做的原因"}, {"type": "subtitle", "time": 21160.948, "timestamp": "05:52:40", "text": "老鼠。但现在我可以用……来做到这一点"}, {"type": "subtitle", "time": 21164.47, "timestamp": "05:52:44", "text": "嗓音。快点。这是好事。那就是"}, {"type": "subtitle", "time": 21165.39, "timestamp": "05:52:45", "text": "实际上"}, {"type": "subtitle", "time": 21168.03, "timestamp": "05:52:48", "text": "好的。该死的你"}, {"type": "subtitle", "time": 21171.27, "timestamp": "05:52:51", "text": "古驰。我的意思是，这确实很有帮助。这"}, {"type": "subtitle", "time": 21172.75, "timestamp": "05:52:52", "text": "实际上"}, {"type": "subtitle", "time": 21175.91, "timestamp": "05:52:55", "text": "有帮助。这让我觉得更容易。"}, {"type": "subtitle", "time": 21179.35, "timestamp": "05:52:59", "text": "就像想象一下，如果你想象……"}]
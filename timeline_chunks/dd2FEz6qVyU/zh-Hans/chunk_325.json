[{"type": "subtitle", "time": 19515.39, "timestamp": "05:25:15", "text": "那真是太……"}, {"type": "subtitle", "time": 19519.19, "timestamp": "05:25:19", "text": "凉爽的。结束了。如何找到一把冲锋枪"}, {"type": "subtitle", "time": 19520.708, "timestamp": "05:25:20", "text": "手枪子弹？等等，我需要找到一个"}, {"type": "subtitle", "time": 19521.55, "timestamp": "05:25:21", "text": "手枪"}, {"type": "subtitle", "time": 19524.708, "timestamp": "05:25:24", "text": "弹药。这个可以。"}, {"type": "subtitle", "time": 19527.55, "timestamp": "05:25:27", "text": "手枪在哪儿来着？"}, {"type": "subtitle", "time": 19530.27, "timestamp": "05:25:30", "text": "是的。"}, {"type": "subtitle", "time": 19533.15, "timestamp": "05:25:33", "text": "不。它在哪儿？这是"}, {"type": "subtitle", "time": 19541.31, "timestamp": "05:25:41", "text": "做。你在这里？"}, {"type": "subtitle", "time": 19556.27, "timestamp": "05:25:56", "text": "尽管。这台"}, {"type": "subtitle", "time": 19559.91, "timestamp": "05:25:59", "text": "我的天哪，别看这件胸罩。你的"}]
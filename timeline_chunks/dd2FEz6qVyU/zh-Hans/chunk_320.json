[{"type": "subtitle", "time": 19201.868, "timestamp": "05:20:01", "text": "哦，这到底是怎么回事？那是"}, {"type": "subtitle", "time": 19204.948, "timestamp": "05:20:04", "text": "一切。那就是全部内容了。"}, {"type": "subtitle", "time": 19207.03, "timestamp": "05:20:07", "text": "狙击手。我可以再做一次吗？我是"}, {"type": "subtitle", "time": 19209.19, "timestamp": "05:20:09", "text": "对不起。这将是最后一次。好的，一个"}, {"type": "subtitle", "time": 19212.23, "timestamp": "05:20:12", "text": "最后的。对不起。这是第三次了"}, {"type": "subtitle", "time": 19215.03, "timestamp": "05:20:15", "text": "我说过了。我喜欢这个。好的，谢谢。我"}, {"type": "subtitle", "time": 19228.07, "timestamp": "05:20:28", "text": "眨眼。哦，等等。我不应该杀人"}, {"type": "subtitle", "time": 19242.788, "timestamp": "05:20:42", "text": "[音乐]"}, {"type": "subtitle", "time": 19258.55, "timestamp": "05:20:58", "text": "你好。我怎么会错过这个？等等，我是吗？"}]
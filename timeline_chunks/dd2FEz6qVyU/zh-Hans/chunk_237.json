[{"type": "subtitle", "time": 14230.71, "timestamp": "03:57:10", "text": "[音乐]"}, {"type": "subtitle", "time": 14235.87, "timestamp": "03:57:15", "text": "投掷火球。你可以扔火球。"}, {"type": "subtitle", "time": 14238.229, "timestamp": "03:57:18", "text": "什么？你随时可以发送"}, {"type": "subtitle", "time": 14239.75, "timestamp": "03:57:19", "text": "Discord。你不需要问"}, {"type": "subtitle", "time": 14242.11, "timestamp": "03:57:22", "text": "允许。不"}, {"type": "subtitle", "time": 14248.11, "timestamp": "03:57:28", "text": "担心。升级即可获得积分。粉笔冲锋枪"}]
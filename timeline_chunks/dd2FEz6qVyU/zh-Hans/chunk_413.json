[{"type": "subtitle", "time": 24781.07, "timestamp": "06:53:01", "text": "里面有一首搞笑单曲。我结婚了"}, {"type": "subtitle", "time": 24783.75, "timestamp": "06:53:03", "text": "然后我走进去，离婚了。"}, {"type": "subtitle", "time": 24785.07, "timestamp": "06:53:05", "text": "单身的。"}, {"type": "subtitle", "time": 24787.91, "timestamp": "06:53:07", "text": "等待。好的。我吃的时候该怎么做？"}, {"type": "subtitle", "time": 24790.788, "timestamp": "06:53:10", "text": "我该打开它吗？"}, {"type": "subtitle", "time": 24794.628, "timestamp": "06:53:14", "text": "我应该把它切开还是应该用……"}, {"type": "subtitle", "time": 24797.39, "timestamp": "06:53:17", "text": "传统方式？我把东西放在哪里了？"}, {"type": "subtitle", "time": 24800.83, "timestamp": "06:53:20", "text": "我的我的藏在哪里了？"}, {"type": "subtitle", "time": 24804.67, "timestamp": "06:53:24", "text": "我的天哪，剪刀。哦，是的。这"}, {"type": "subtitle", "time": 24806.92, "timestamp": "06:53:26", "text": "一个方便的好东西"}, {"type": "subtitle", "time": 24808.27, "timestamp": "06:53:28", "text": "[音乐]"}, {"type": "subtitle", "time": 24811.03, "timestamp": "06:53:31", "text": "剪刀。我称之为“无关紧要”。"}, {"type": "subtitle", "time": 24813.31, "timestamp": "06:53:33", "text": "无论你是单身还是已婚。"}, {"type": "subtitle", "time": 24815.99, "timestamp": "06:53:35", "text": "哦，没关系。这重要吗？"}, {"type": "subtitle", "time": 24819.43, "timestamp": "06:53:39", "text": "只是平常的一天，对吧？"}, {"type": "subtitle", "time": 24834.19, "timestamp": "06:53:54", "text": "天。我"}, {"type": "subtitle", "time": 24837.35, "timestamp": "06:53:57", "text": "看。我懂了。我不想，我不想"}]
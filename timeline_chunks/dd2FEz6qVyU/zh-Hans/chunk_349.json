[{"type": "subtitle", "time": 20945.91, "timestamp": "05:49:05", "text": "你好。休息。祖克。你不必是呃"}, {"type": "subtitle", "time": 20948.47, "timestamp": "05:49:08", "text": "看着我。我想直播，但是不行"}, {"type": "subtitle", "time": 20952.43, "timestamp": "05:49:12", "text": "仅在夜间。"}, {"type": "subtitle", "time": 20956.03, "timestamp": "05:49:16", "text": "是的。 YouTube 可能很糟糕"}, {"type": "subtitle", "time": 20960.23, "timestamp": "05:49:20", "text": "便便。 YouTube 就是坨坨屎。大家好。但"}, {"type": "subtitle", "time": 20962.708, "timestamp": "05:49:22", "text": "你们他妈的在干嘛？我"}, {"type": "subtitle", "time": 20966.548, "timestamp": "05:49:26", "text": "我的意思是，上次直播大概有18人观看。"}, {"type": "subtitle", "time": 20971.548, "timestamp": "05:49:31", "text": "或者19。哦，其实是17。"}, {"type": "subtitle", "time": 20973.948, "timestamp": "05:49:33", "text": "点赞。所以这就像是……"}, {"type": "subtitle", "time": 20977.15, "timestamp": "05:49:37", "text": "翻拍版，对吧？我不"}, {"type": "subtitle", "time": 20981.99, "timestamp": "05:49:41", "text": "知道。嗯，我的意思是，如果我想的话，我可以。"}, {"type": "subtitle", "time": 20984.59, "timestamp": "05:49:44", "text": "只做 YouTube"}, {"type": "subtitle", "time": 20987.67, "timestamp": "05:49:47", "text": "今天，你们会吗？"}, {"type": "subtitle", "time": 20989.15, "timestamp": "05:49:49", "text": "是"}, {"type": "subtitle", "time": 20991.67, "timestamp": "05:49:51", "text": "那里？这是一个新频道。对，这个"}, {"type": "subtitle", "time": 20994.628, "timestamp": "05:49:54", "text": "这是一个新频道，因为我们上次的频道已经开播了。"}, {"type": "subtitle", "time": 20998.91, "timestamp": "05:49:58", "text": "YouTube 已将直播流下架。"}]
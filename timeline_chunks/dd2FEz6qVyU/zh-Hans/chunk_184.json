[{"type": "subtitle", "time": 11042.87, "timestamp": "03:04:02", "text": "死。哦，是的。就是这里。不，我"}, {"type": "subtitle", "time": 11047.15, "timestamp": "03:04:07", "text": "没能把这个盒子拿出来。所以，"}, {"type": "subtitle", "time": 11059.469, "timestamp": "03:04:19", "text": "难道不是吗？"}, {"type": "subtitle", "time": 11063.269, "timestamp": "03:04:23", "text": "足够的？哦，够了。我们得到了一个"}, {"type": "subtitle", "time": 11066.389, "timestamp": "03:04:26", "text": "新枪。这是什么？这是教堂的长椅吗？"}, {"type": "subtitle", "time": 11069.79, "timestamp": "03:04:29", "text": "砰砰砰的手枪？我觉得是这样。"}, {"type": "subtitle", "time": 11072.55, "timestamp": "03:04:32", "text": "是。哦，是那把“砰砰砰”的手枪。哦"}, {"type": "subtitle", "time": 11083.87, "timestamp": "03:04:43", "text": "手枪。我们走吧。是教堂的砰砰声"}, {"type": "subtitle", "time": 11090.269, "timestamp": "03:04:50", "text": "去。哦，我的"}, {"type": "subtitle", "time": 11094.429, "timestamp": "03:04:54", "text": "上帝。我很高兴今天找到了这个"}, {"type": "subtitle", "time": 11098.429, "timestamp": "03:04:58", "text": "游戏，伙计。我很高兴能玩这款游戏。"}]
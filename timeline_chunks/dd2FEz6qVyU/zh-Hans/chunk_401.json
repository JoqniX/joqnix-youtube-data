[{"type": "subtitle", "time": 24066.11, "timestamp": "06:41:06", "text": "也祝你一切顺利"}, {"type": "subtitle", "time": 24069.39, "timestamp": "06:41:09", "text": "是的。太过了"}, {"type": "subtitle", "time": 24072.628, "timestamp": "06:41:12", "text": "是的。另外，呃，我正在 YouTube 上直播，对吧？"}, {"type": "subtitle", "time": 24076.628, "timestamp": "06:41:16", "text": "上次我的 YouTube 直播中断了"}, {"type": "subtitle", "time": 24079.83, "timestamp": "06:41:19", "text": "原因不明。我不知道为什么。"}, {"type": "subtitle", "time": 24084.11, "timestamp": "06:41:24", "text": "上次直播我们大概直播了大约"}, {"type": "subtitle", "time": 24087.868, "timestamp": "06:41:27", "text": "嗯，我们直播了大概……"}, {"type": "subtitle", "time": 24091.83, "timestamp": "06:41:31", "text": "大概10个小时，但只有YouTube那边。"}, {"type": "subtitle", "time": 24095.99, "timestamp": "06:41:35", "text": "因为机器坏了，所以录了6个小时的视频。我的"}, {"type": "subtitle", "time": 24099.51, "timestamp": "06:41:39", "text": "多线程系统在中间崩溃了。所以它"}, {"type": "subtitle", "time": 24113.03, "timestamp": "06:41:53", "text": "忧虑。所以，我今天想直播的内容是……"}, {"type": "subtitle", "time": 24114.51, "timestamp": "06:41:54", "text": "一点点"}, {"type": "subtitle", "time": 24118.31, "timestamp": "06:41:58", "text": "只是和所有人交谈，那些"}]
[{"type": "subtitle", "time": 16982.03, "timestamp": "04:43:02", "text": "休息。我知道这里是休息站。"}, {"type": "subtitle", "time": 16983.948, "timestamp": "04:43:03", "text": "但"}, {"type": "subtitle", "time": 16999.23, "timestamp": "04:43:19", "text": "呃，我想看……"}, {"type": "subtitle", "time": 17007.19, "timestamp": "04:43:27", "text": "他把东西都拿到手了，对吧？我是否"}, {"type": "subtitle", "time": 17010.19, "timestamp": "04:43:30", "text": "拿到那个模块了吗？我不认为我"}, {"type": "subtitle", "time": 17014.628, "timestamp": "04:43:34", "text": "做过。呃，休息站在哪里？我想"}, {"type": "subtitle", "time": 17018.19, "timestamp": "04:43:38", "text": "看看他最终会走到哪里，红色"}, {"type": "subtitle", "time": 17021.15, "timestamp": "04:43:41", "text": "东西。所以，在雪地之后"}, {"type": "subtitle", "time": 17024.47, "timestamp": "04:43:44", "text": "现在地图上只有一个地方"}, {"type": "subtitle", "time": 17027.03, "timestamp": "04:43:47", "text": "我们还没有探索过这边的区域。"}, {"type": "subtitle", "time": 17035.51, "timestamp": "04:43:55", "text": "那里。就在那边。正确的。我们需要"}, {"type": "subtitle", "time": 17038.67, "timestamp": "04:43:58", "text": "去这里。我将探索"}]
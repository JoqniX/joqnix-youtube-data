[{"type": "subtitle", "time": 21181.83, "timestamp": "05:53:01", "text": "当你开始玩游戏的时候"}, {"type": "subtitle", "time": 21186.47, "timestamp": "05:53:06", "text": "直播时你想使用头戴式聊天功能吗？"}, {"type": "subtitle", "time": 21188.868, "timestamp": "05:53:08", "text": "呃，切换到ASMR模式"}, {"type": "subtitle", "time": 21190.788, "timestamp": "05:53:10", "text": "任何你能用语音命令控制的东西"}, {"type": "subtitle", "time": 21193.43, "timestamp": "05:53:13", "text": "通常情况下，人们会用语音说话。"}, {"type": "subtitle", "time": 21196.868, "timestamp": "05:53:16", "text": "他们会发出指令，或者按下按钮，但是"}, {"type": "subtitle", "time": 21201.99, "timestamp": "05:53:21", "text": "我确实想这么做，实际上我必须这么做。"}, {"type": "subtitle", "time": 21216.67, "timestamp": "05:53:36", "text": "所以你必须喜欢一个"}, {"type": "subtitle", "time": 21220.43, "timestamp": "05:53:40", "text": "第二节这玩意儿在哪儿？"}, {"type": "subtitle", "time": 21224.548, "timestamp": "05:53:44", "text": "呃，我还没办法做到，不过是的。"}, {"type": "subtitle", "time": 21227.83, "timestamp": "05:53:47", "text": "需要将所有按键绑定添加到我的"}, {"type": "subtitle", "time": 21231.67, "timestamp": "05:53:51", "text": "键盘PD键盘，这样我就可以玩了。"}, {"type": "subtitle", "time": 21235.27, "timestamp": "05:53:55", "text": "一个按键，可以自动切换场景"}, {"type": "subtitle", "time": 21237.948, "timestamp": "05:53:57", "text": "还有其他因素使它更加"}]
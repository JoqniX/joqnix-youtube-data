[{"type": "subtitle", "time": 25800.788, "timestamp": "07:10:00", "text": "如果我的室友我不知道我是否"}, {"type": "subtitle", "time": 25804.39, "timestamp": "07:10:04", "text": "很想拥有那种动漫风格"}, {"type": "subtitle", "time": 25805.91, "timestamp": "07:10:05", "text": "对吧？你知道，拥有一个"}, {"type": "subtitle", "time": 25807.468, "timestamp": "07:10:07", "text": "室友"}, {"type": "subtitle", "time": 25811.51, "timestamp": "07:10:11", "text": "还有，给室友做饭。我们不是我们"}, {"type": "subtitle", "time": 25813.43, "timestamp": "07:10:13", "text": "互相烹饪。我的意思是，我们做饭"}, {"type": "subtitle", "time": 25816.628, "timestamp": "07:10:16", "text": "互相陪伴，一起吃晚餐。"}, {"type": "subtitle", "time": 25819.03, "timestamp": "07:10:19", "text": "午餐、早餐，所有东西都吃。"}, {"type": "subtitle", "time": 25823.23, "timestamp": "07:10:23", "text": "一起。或者醒来，每天醒来"}, {"type": "subtitle", "time": 25826.948, "timestamp": "07:10:26", "text": "其他，还有什么，嗯，特别的。"}, {"type": "subtitle", "time": 25829.51, "timestamp": "07:10:29", "text": "场合嘛，嗯，做点好事吧"}, {"type": "subtitle", "time": 25832.868, "timestamp": "07:10:32", "text": "彼此之间所有那些东西，就像你看到的那样。"}, {"type": "subtitle", "time": 25836.11, "timestamp": "07:10:36", "text": "动漫之类的。我想那样做。"}, {"type": "subtitle", "time": 25843.67, "timestamp": "07:10:43", "text": "大概是因为我的直播之类的吧"}, {"type": "subtitle", "time": 25846.39, "timestamp": "07:10:46", "text": "好像太……"}, {"type": "subtitle", "time": 25850.39, "timestamp": "07:10:50", "text": "嗯，不只是直播，我也会这么做。"}, {"type": "subtitle", "time": 25853.67, "timestamp": "07:10:53", "text": "一旦我有了自己的生活，很多事情都可以做。"}, {"type": "subtitle", "time": 25855.628, "timestamp": "07:10:55", "text": "回到我自己的地方"}, {"type": "subtitle", "time": 25859.27, "timestamp": "07:10:59", "text": "东西。嗯，对，就是这个问题。"}]
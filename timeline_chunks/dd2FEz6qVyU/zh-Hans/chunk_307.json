[{"type": "subtitle", "time": 18440.47, "timestamp": "05:07:20", "text": "已经过去3个小时了。你知道吗？"}, {"type": "subtitle", "time": 18442.55, "timestamp": "05:07:22", "text": "既然我们已经拿到枪了，就可以收工了。我"}, {"type": "subtitle", "time": 18444.67, "timestamp": "05:07:24", "text": "我觉得我们已经得到了大部分"}, {"type": "subtitle", "time": 18447.19, "timestamp": "05:07:27", "text": "一切。剩下的东西"}, {"type": "subtitle", "time": 18450.15, "timestamp": "05:07:30", "text": "查找是“等等，为什么我的模型没有找到”"}, {"type": "subtitle", "time": 18471.708, "timestamp": "05:07:51", "text": "我刚才说到哪儿了？"}, {"type": "subtitle", "time": 18479.11, "timestamp": "05:07:59", "text": "让我再做一次。我为什么这么做"}]
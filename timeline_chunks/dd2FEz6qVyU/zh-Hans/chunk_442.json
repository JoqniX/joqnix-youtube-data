[{"type": "subtitle", "time": 26523.03, "timestamp": "07:22:03", "text": "天。凌晨1点，我睡意朦胧。我当时"}, {"type": "subtitle", "time": 26525.39, "timestamp": "07:22:05", "text": "胡说八道，蠢货"}, {"type": "subtitle", "time": 26529.51, "timestamp": "07:22:09", "text": "东西。我本来想说那纯属胡扯"}, {"type": "subtitle", "time": 26541.708, "timestamp": "07:22:21", "text": "我。一、二、三、四、五"}, {"type": "subtitle", "time": 26546.548, "timestamp": "07:22:26", "text": "六。好的。六盒，呃，六盒，呃，六盒"}, {"type": "subtitle", "time": 26549.27, "timestamp": "07:22:29", "text": "东西就在那里。六罐糖果"}, {"type": "subtitle", "time": 26552.39, "timestamp": "07:22:32", "text": "有没有。哦，不。糖果份量。"}, {"type": "subtitle", "time": 26554.91, "timestamp": "07:22:34", "text": "一、二、三、四、五"}, {"type": "subtitle", "time": 26557.91, "timestamp": "07:22:37", "text": "六。我的天哪。我该怎么办？我应该吃吗？"}, {"type": "subtitle", "time": 26559.59, "timestamp": "07:22:39", "text": "要么我就把它分发给我的"}, {"type": "subtitle", "time": 26560.67, "timestamp": "07:22:40", "text": "家庭"}, {"type": "subtitle", "time": 26563.35, "timestamp": "07:22:43", "text": "然后？哦。哦，是的。我可以给我一个"}, {"type": "subtitle", "time": 26565.27, "timestamp": "07:22:45", "text": "狗狗和我的猫咪。我最后做的"}, {"type": "subtitle", "time": 26568.07, "timestamp": "07:22:48", "text": "年。是啊，我忘了。你知道我"}, {"type": "subtitle", "time": 26573.75, "timestamp": "07:22:53", "text": "我总是给我的宠物吃Vand Day糖果"}, {"type": "subtitle", "time": 26576.708, "timestamp": "07:22:56", "text": "也一样。他们很喜欢。"}]
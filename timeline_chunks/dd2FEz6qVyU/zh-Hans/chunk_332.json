[{"type": "subtitle", "time": 19938.868, "timestamp": "05:32:18", "text": "哦，等等。没有弹药了。哦，不。是"}, {"type": "subtitle", "time": 19940.99, "timestamp": "05:32:20", "text": "你在跟我开玩笑吧？"}, {"type": "subtitle", "time": 19943.83, "timestamp": "05:32:23", "text": "现在？弹药库在哪儿？对，这个"}, {"type": "subtitle", "time": 19945.99, "timestamp": "05:32:25", "text": "地方。"}, {"type": "subtitle", "time": 19947.708, "timestamp": "05:32:27", "text": "为什么弹药不足"}, {"type": "subtitle", "time": 19950.548, "timestamp": "05:32:30", "text": "已加载？哦，还我回来。哦，给我我的"}, {"type": "subtitle", "time": 19956.788, "timestamp": "05:32:36", "text": "什么？我们当时正在尝试新的挑战。"}, {"type": "subtitle", "time": 19972.19, "timestamp": "05:32:52", "text": "[音乐]"}]
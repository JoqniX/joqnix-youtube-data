[{"type": "subtitle", "time": 24960.03, "timestamp": "06:56:00", "text": "天哪，我被噎住了"}, {"type": "subtitle", "time": 24962.628, "timestamp": "06:56:02", "text": "它。我谈过这件事。我被噎住了。"}, {"type": "subtitle", "time": 24992.91, "timestamp": "06:56:32", "text": "喉。但"}, {"type": "subtitle", "time": 24995.708, "timestamp": "06:56:35", "text": "嗯，那是"}, {"type": "subtitle", "time": 24997.91, "timestamp": "06:56:37", "text": "可口。好吧，你知道吗？我只会"}, {"type": "subtitle", "time": 25001.03, "timestamp": "06:56:41", "text": "吃掉一部分。我只会吃"}, {"type": "subtitle", "time": 25004.67, "timestamp": "06:56:44", "text": "就这么多。然后我会把剩下的给"}, {"type": "subtitle", "time": 25008.51, "timestamp": "06:56:48", "text": "我想，应该是我的家人吧。或者我可以吗？"}, {"type": "subtitle", "time": 25011.11, "timestamp": "06:56:51", "text": "不是？通常情况下，我会把它放进他们的嘴里。"}, {"type": "subtitle", "time": 25012.11, "timestamp": "06:56:52", "text": "并给予"}, {"type": "subtitle", "time": 25015.23, "timestamp": "06:56:55", "text": "他偷偷地，蹑手蹑脚地跟在他们身后，"}, {"type": "subtitle", "time": 25017.868, "timestamp": "06:56:57", "text": "比如，“拿走我的"}]
[{"type": "subtitle", "time": 1035.669, "timestamp": "00:17:15", "text": "真是太麻烦了。我搞不懂。"}, {"type": "subtitle", "time": 1062.549, "timestamp": "00:17:42", "text": "Hari Hari Migi Migi Migi Migi Hari 哪个"}, {"type": "subtitle", "time": 1066.909, "timestamp": "00:17:46", "text": "是Hari，也就是米奇，我忘了。左边，"}, {"type": "subtitle", "time": 1069.99, "timestamp": "00:17:49", "text": "右，左，跳，右，左，左，"}, {"type": "subtitle", "time": 1079.07, "timestamp": "00:17:59", "text": "左边。右，左，右，左，右，左，左，右，左，右。"}]
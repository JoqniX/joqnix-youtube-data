[{"type": "subtitle", "time": 13082.83, "timestamp": "03:38:02", "text": "好的。我很高兴，乔伊。"}, {"type": "subtitle", "time": 13096.79, "timestamp": "03:38:16", "text": "[音乐]"}, {"type": "subtitle", "time": 13117.71, "timestamp": "03:38:37", "text": "它。它会在哪里？它会在哪里？"}, {"type": "subtitle", "time": 13129.91, "timestamp": "03:38:49", "text": "哦，等等。这不是他的眼睛吗？"}, {"type": "subtitle", "time": 13132.469, "timestamp": "03:38:52", "text": "这是龙的眼睛。我可以杀掉一个"}, {"type": "subtitle", "time": 13133.95, "timestamp": "03:38:53", "text": "小的"}, {"type": "subtitle", "time": 13136.63, "timestamp": "03:38:56", "text": "眼睛？不。好吧，那样行不通。"}, {"type": "subtitle", "time": 13138.349, "timestamp": "03:38:58", "text": "那。"}]
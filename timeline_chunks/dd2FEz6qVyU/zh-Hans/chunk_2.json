[{"type": "subtitle", "time": 121.149, "timestamp": "00:02:01", "text": "的"}, {"type": "subtitle", "time": 124.149, "timestamp": "00:02:04", "text": "考虑到这一点，情况就很糟糕了。"}, {"type": "subtitle", "time": 126.91, "timestamp": "00:02:06", "text": "我正在直播好久"}, {"type": "subtitle", "time": 129.749, "timestamp": "00:02:09", "text": "时间等等，那就是"}, {"type": "subtitle", "time": 133.22899999999998, "timestamp": "00:02:13", "text": "坏的。是的，我会尽力而为。"}, {"type": "subtitle", "time": 138.309, "timestamp": "00:02:18", "text": "自我修复。嗯。补充了一些维生素。"}, {"type": "subtitle", "time": 141.75, "timestamp": "00:02:21", "text": "还有感冒药之类的东西。和"}, {"type": "subtitle", "time": 144.63, "timestamp": "00:02:24", "text": "我现在有80分了，所以不需要了"}, {"type": "subtitle", "time": 147.75, "timestamp": "00:02:27", "text": "就像我以前那样，每次都变成煮鸡蛋。"}, {"type": "subtitle", "time": 152.309, "timestamp": "00:02:32", "text": "存在。嗯，对，就是因为……"}, {"type": "subtitle", "time": 155.99, "timestamp": "00:02:35", "text": "晚上房间里很热。个人电脑已经"}, {"type": "subtitle", "time": 158.99, "timestamp": "00:02:38", "text": "运行六天。不，七天"}, {"type": "subtitle", "time": 162.07, "timestamp": "00:02:42", "text": "直的。太疯狂了。"}, {"type": "subtitle", "time": 166.03, "timestamp": "00:02:46", "text": "不，我的最高纪录是16。"}, {"type": "chat", "time": 174.152, "timestamp": "00:02:54", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "hello"}]
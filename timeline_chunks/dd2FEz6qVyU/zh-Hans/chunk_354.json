[{"type": "subtitle", "time": 21242.51, "timestamp": "05:54:02", "text": "方便易用，而且你知道"}, {"type": "subtitle", "time": 21244.788, "timestamp": "05:54:04", "text": "可控的。对，就是这些。"}, {"type": "subtitle", "time": 21247.868, "timestamp": "05:54:07", "text": "我们一直是"}, {"type": "subtitle", "time": 21250.35, "timestamp": "05:54:10", "text": "正在做。好的，我需要开始聊天了。"}, {"type": "subtitle", "time": 21252.67, "timestamp": "05:54:12", "text": "尽快。需要得到"}, {"type": "subtitle", "time": 21255.868, "timestamp": "05:54:15", "text": "聊天。我无法阅读聊天记录。"}, {"type": "subtitle", "time": 21275.868, "timestamp": "05:54:35", "text": "这"}, {"type": "subtitle", "time": 21279.788, "timestamp": "05:54:39", "text": "关联。好的。皮库奇。是的，我们"}, {"type": "subtitle", "time": 21289.948, "timestamp": "05:54:49", "text": "他妈的。是的，我们做了所有这些事。"}, {"type": "subtitle", "time": 21292.31, "timestamp": "05:54:52", "text": "今天。说实话，我应该"}, {"type": "subtitle", "time": 21295.11, "timestamp": "05:54:55", "text": "这件事三个月前就做了，但是"}, {"type": "subtitle", "time": 21298.39, "timestamp": "05:54:58", "text": "我以前特别懒，总是拖延。"}]
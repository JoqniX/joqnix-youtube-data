[{"type": "subtitle", "time": 26762.43, "timestamp": "07:26:02", "text": "真心想送点什么。"}, {"type": "subtitle", "time": 26765.19, "timestamp": "07:26:05", "text": "特别的。他说他会来"}, {"type": "subtitle", "time": 26768.548, "timestamp": "07:26:08", "text": "我认为钦奈也是他的一个住处。"}, {"type": "subtitle", "time": 26772.07, "timestamp": "07:26:12", "text": "学生或者他以学生的身份去那里"}, {"type": "subtitle", "time": 26775.67, "timestamp": "07:26:15", "text": "个人或像老师一样。"}, {"type": "subtitle", "time": 26778.468, "timestamp": "07:26:18", "text": "呃，就像你知道的，呃，因为它就像"}, {"type": "subtitle", "time": 26781.59, "timestamp": "07:26:21", "text": "这是日语考试，对吧？所以"}, {"type": "subtitle", "time": 26784.35, "timestamp": "07:26:24", "text": "[音乐]"}, {"type": "subtitle", "time": 26788.31, "timestamp": "07:26:28", "text": "是的，没错。"}, {"type": "subtitle", "time": 26797.83, "timestamp": "07:26:37", "text": "你知道吗，我甚至提交了"}, {"type": "subtitle", "time": 26801.35, "timestamp": "07:26:41", "text": "我为10our直播做的作业和"}, {"type": "subtitle", "time": 26803.91, "timestamp": "07:26:43", "text": "当大家都陆续来到教室时，"}, {"type": "subtitle", "time": 26811.83, "timestamp": "07:26:51", "text": "杂七杂八的东西。挺好的。好的。呃"}, {"type": "subtitle", "time": 26813.27, "timestamp": "07:26:53", "text": "目的是什么？"}, {"type": "subtitle", "time": 26815.27, "timestamp": "07:26:55", "text": "情人节？所以情人节是"}, {"type": "subtitle", "time": 26817.59, "timestamp": "07:26:57", "text": "与你爱的人一起庆祝的事情"}]
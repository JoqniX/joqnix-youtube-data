[{"type": "subtitle", "time": 23280.628, "timestamp": "06:28:00", "text": "谁会画出这样的动漫？"}, {"type": "subtitle", "time": 23282.15, "timestamp": "06:28:02", "text": "向这三个人学习"}, {"type": "subtitle", "time": 23286.07, "timestamp": "06:28:06", "text": "来自艺术界的杰出人士"}, {"type": "subtitle", "time": 23289.19, "timestamp": "06:28:09", "text": "他们是怎么做到的？所以我一直都喜欢"}, {"type": "subtitle", "time": 23291.75, "timestamp": "06:28:11", "text": "提出问题。我收到了很多问题。"}, {"type": "subtitle", "time": 23294.708, "timestamp": "06:28:14", "text": "所以需要时间去理解，就像……"}, {"type": "subtitle", "time": 23297.628, "timestamp": "06:28:17", "text": "概念对吧？所以"}, {"type": "subtitle", "time": 23299.548, "timestamp": "06:28:19", "text": "是的"}, {"type": "subtitle", "time": 23303.59, "timestamp": "06:28:23", "text": "而且他还是另一位艺术漫画家"}, {"type": "subtitle", "time": 23307.03, "timestamp": "06:28:27", "text": "也从事漫画相关的工作。看看"}, {"type": "subtitle", "time": 23311.19, "timestamp": "06:28:31", "text": "她的努力成果非常好。"}, {"type": "subtitle", "time": 23316.11, "timestamp": "06:28:36", "text": "她像这样滚动得很好"}, {"type": "subtitle", "time": 23319.35, "timestamp": "06:28:39", "text": "这。对，这就是我想要的这套美术素材。"}, {"type": "subtitle", "time": 23320.27, "timestamp": "06:28:40", "text": "去"}, {"type": "subtitle", "time": 23327.59, "timestamp": "06:28:47", "text": "风格和戴维森的背景"}, {"type": "subtitle", "time": 23331.91, "timestamp": "06:28:51", "text": "风景画，这是艺术作品"}, {"type": "subtitle", "time": 23333.59, "timestamp": "06:28:53", "text": "戴维森。"}, {"type": "subtitle", "time": 23335.83, "timestamp": "06:28:55", "text": "确实有人像这样情绪激动。"}, {"type": "subtitle", "time": 23338.548, "timestamp": "06:28:58", "text": "心脏有很多感觉。"}]
[{"type": "subtitle", "time": 17760.19, "timestamp": "04:56:00", "text": "他。等等，等等，等等"}, {"type": "subtitle", "time": 17764.27, "timestamp": "04:56:04", "text": "等待。你注意到《快打旋风》是"}, {"type": "subtitle", "time": 17768.15, "timestamp": "04:56:08", "text": "这里。靶场在这里。火山"}, {"type": "subtitle", "time": 17769.83, "timestamp": "04:56:09", "text": "完全是凭空冒出来的。那我又如何呢？"}, {"type": "subtitle", "time": 17772.43, "timestamp": "04:56:12", "text": "应该去"}, {"type": "subtitle", "time": 17781.75, "timestamp": "04:56:21", "text": "当我把它关上的时候。哦，我的错。我"}, {"type": "subtitle", "time": 17785.19, "timestamp": "04:56:25", "text": "关闭了。我的意思是，总之就像"}, {"type": "subtitle", "time": 17787.868, "timestamp": "04:56:27", "text": "我们直播了多久"}, {"type": "subtitle", "time": 17790.788, "timestamp": "04:56:30", "text": "再说一遍，你想让我做什么？"}, {"type": "subtitle", "time": 17793.35, "timestamp": "04:56:33", "text": "完全找到所有东西，或者就像我们总结的那样"}, {"type": "subtitle", "time": 17795.75, "timestamp": "04:56:35", "text": "你们想要什么？你们怎么看？"}, {"type": "subtitle", "time": 17797.31, "timestamp": "04:56:37", "text": "我们该怎么办？"}, {"type": "subtitle", "time": 17800.39, "timestamp": "04:56:40", "text": "我的午餐也吃了吗？我是说晚餐。"}, {"type": "subtitle", "time": 17812.43, "timestamp": "04:56:52", "text": "知道"}, {"type": "subtitle", "time": 17815.868, "timestamp": "04:56:55", "text": "呃，苏琪米奇季节"}, {"type": "subtitle", "time": 17819.03, "timestamp": "04:56:59", "text": "2. 哦，那个看起来像……的角色"}]
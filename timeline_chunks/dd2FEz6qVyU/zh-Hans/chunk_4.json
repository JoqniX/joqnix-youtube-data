[{"type": "subtitle", "time": 242.149, "timestamp": "00:04:02", "text": "呃，当时风很大，雨也很大。"}, {"type": "subtitle", "time": 244.47, "timestamp": "00:04:04", "text": "我开车穿过了那里。开车穿过"}, {"type": "subtitle", "time": 245.83, "timestamp": "00:04:05", "text": "它。"}, {"type": "subtitle", "time": 248.789, "timestamp": "00:04:08", "text": "你知道我的，我总是先开车。眨眼。但"}, {"type": "subtitle", "time": 250.789, "timestamp": "00:04:10", "text": "是的，我很安全。感谢上帝。谢天谢地"}, {"type": "subtitle", "time": 259.469, "timestamp": "00:04:19", "text": "那里。但"}, {"type": "subtitle", "time": 264.03, "timestamp": "00:04:24", "text": "是的，回到家后，我……"}, {"type": "subtitle", "time": 266.39, "timestamp": "00:04:26", "text": "这里。感觉我可能会得到"}, {"type": "chat", "time": 273.766, "timestamp": "00:04:33", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "hmph"}, {"type": "subtitle", "time": 274.71, "timestamp": "00:04:34", "text": "嗯，感觉有点像……"}, {"type": "chat", "time": 278.385, "timestamp": "00:04:38", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "nice"}, {"type": "subtitle", "time": 279.35, "timestamp": "00:04:39", "text": "我可能会生病，因为我被淋透了。"}, {"type": "subtitle", "time": 280.51, "timestamp": "00:04:40", "text": "在"}, {"type": "subtitle", "time": 285.15, "timestamp": "00:04:45", "text": "雨。所以，但我确实采取了"}, {"type": "subtitle", "time": 288.95, "timestamp": "00:04:48", "text": "洗澡。我洗了澡，所以我不确定。"}, {"type": "subtitle", "time": 291.31, "timestamp": "00:04:51", "text": "事情将会如何发展"}]
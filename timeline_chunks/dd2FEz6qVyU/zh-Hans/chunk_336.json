[{"type": "subtitle", "time": 20161.31, "timestamp": "05:36:01", "text": "经过。呃"}, {"type": "subtitle", "time": 20163.07, "timestamp": "05:36:03", "text": "然后"}, {"type": "subtitle", "time": 20166.548, "timestamp": "05:36:06", "text": "BST7是新来的。谢谢你"}, {"type": "subtitle", "time": 20169.03, "timestamp": "05:36:09", "text": "接下来。欢迎来到星空。"}, {"type": "subtitle", "time": 20172.27, "timestamp": "05:36:12", "text": "希望你今天过得愉快。非常感谢"}, {"type": "subtitle", "time": 20175.83, "timestamp": "05:36:15", "text": "很多。希望你今天过得愉快。"}, {"type": "subtitle", "time": 20185.75, "timestamp": "05:36:25", "text": "乐趣。还有 Ren Palette 的儿子，谢谢你"}, {"type": "subtitle", "time": 20188.11, "timestamp": "05:36:28", "text": "顺道而来"}, {"type": "subtitle", "time": 20191.27, "timestamp": "05:36:31", "text": "出色地。谢谢。谢谢。希望你"}, {"type": "subtitle", "time": 20194.07, "timestamp": "05:36:34", "text": "享受今天吧。等等，Ren调色板是这样的吗？"}, {"type": "subtitle", "time": 20196.99, "timestamp": "05:36:36", "text": "真的是夜吗？"}, {"type": "subtitle", "time": 20199.07, "timestamp": "05:36:39", "text": "等等，等等，"}, {"type": "subtitle", "time": 20201.708, "timestamp": "05:36:41", "text": "是它就是Yoru"}, {"type": "subtitle", "time": 20204.07, "timestamp": "05:36:44", "text": "查玛。你改名字了？好的，"}, {"type": "subtitle", "time": 20208.628, "timestamp": "05:36:48", "text": "我看见你。谢谢你，Yorama。我遇见了Yoru"}, {"type": "subtitle", "time": 20212.15, "timestamp": "05:36:52", "text": "脱离现实的时候，就像我……"}, {"type": "subtitle", "time": 20214.708, "timestamp": "05:36:54", "text": "在我直播完之后。我看见"}, {"type": "subtitle", "time": 20217.75, "timestamp": "05:36:57", "text": "随机找了这个人，然后把它调到了一个"}]
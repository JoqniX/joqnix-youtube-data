[{"type": "subtitle", "time": 25620.868, "timestamp": "07:07:00", "text": "那。下去。下去。下去。去"}, {"type": "subtitle", "time": 25624.23, "timestamp": "07:07:04", "text": "向下。下去。"}, {"type": "subtitle", "time": 25627.11, "timestamp": "07:07:07", "text": "我让你上来，我怎么能不去呢？"}, {"type": "subtitle", "time": 25637.03, "timestamp": "07:07:17", "text": "向下。我的天啊，这东西。你知道"}, {"type": "subtitle", "time": 25639.67, "timestamp": "07:07:19", "text": "什么？我两个都吃掉。患病的"}, {"type": "subtitle", "time": 25641.99, "timestamp": "07:07:21", "text": "吃这个就行了。这样就容易多了。"}, {"type": "subtitle", "time": 25644.19, "timestamp": "07:07:24", "text": "好的，"}, {"type": "subtitle", "time": 25663.99, "timestamp": "07:07:43", "text": "这件事的起因是我的衣服。我不"}, {"type": "subtitle", "time": 25666.548, "timestamp": "07:07:46", "text": "希望它弄脏。当然，我可以"}, {"type": "subtitle", "time": 25672.73, "timestamp": "07:07:52", "text": "但"}, {"type": "subtitle", "time": 25675.708, "timestamp": "07:07:55", "text": "[音乐]"}, {"type": "subtitle", "time": 25678.99, "timestamp": "07:07:58", "text": "疼痛。我吃太多了"}]
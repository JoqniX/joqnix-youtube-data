[{"type": "subtitle", "time": 9135.75, "timestamp": "02:32:15", "text": "好的，我要出口木材了。你知道"}, {"type": "subtitle", "time": 9139.51, "timestamp": "02:32:19", "text": "怎么了，伙计们？我要么去睡觉，要么去"}, {"type": "subtitle", "time": 9141.03, "timestamp": "02:32:21", "text": "我会安排好所有事情，"}, {"type": "subtitle", "time": 9142.87, "timestamp": "02:32:22", "text": "以后再说。我这就去躺下。"}, {"type": "subtitle", "time": 9145.67, "timestamp": "02:32:25", "text": "或者别的什么。我会吃我的食物，撒谎"}, {"type": "subtitle", "time": 9149.11, "timestamp": "02:32:29", "text": "一切都倒下了。好了，晚安。"}, {"type": "subtitle", "time": 9151.51, "timestamp": "02:32:31", "text": "谢谢你今天抽出时间。"}, {"type": "subtitle", "time": 9153.75, "timestamp": "02:32:33", "text": "明天见。而且我确信"}, {"type": "subtitle", "time": 9156.87, "timestamp": "02:32:36", "text": "如果我们不经常在线的话。"}, {"type": "subtitle", "time": 9159.75, "timestamp": "02:32:39", "text": "我明天会给你补偿的。"}, {"type": "subtitle", "time": 9162.309, "timestamp": "02:32:42", "text": "只要流量充足，我就会一直在那里。"}, {"type": "subtitle", "time": 9164.83, "timestamp": "02:32:44", "text": "天。好的。"}, {"type": "subtitle", "time": 9168.11, "timestamp": "02:32:48", "text": "来吧，我也一样"}, {"type": "subtitle", "time": 9170.83, "timestamp": "02:32:50", "text": "困。我应该"}, {"type": "subtitle", "time": 9174.62, "timestamp": "02:32:54", "text": "吃点东西。"}]
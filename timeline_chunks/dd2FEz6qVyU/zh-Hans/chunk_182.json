[{"type": "subtitle", "time": 10925.67, "timestamp": "03:02:05", "text": "遗忘。它有时间注意到"}, {"type": "subtitle", "time": 10928.59, "timestamp": "03:02:08", "text": "忙碌时你的弹药"}, {"type": "subtitle", "time": 10931.79, "timestamp": "03:02:11", "text": "移动，你"}, {"type": "subtitle", "time": 10934.11, "timestamp": "03:02:14", "text": "知道。所以，请稍等。"}, {"type": "subtitle", "time": 10937.99, "timestamp": "03:02:17", "text": "嗯，我应该修理这门大枪吗？"}, {"type": "subtitle", "time": 10940.309, "timestamp": "03:02:20", "text": "我错过了吗？"}, {"type": "subtitle", "time": 10941.55, "timestamp": "03:02:21", "text": "推他"}, {"type": "subtitle", "time": 10944.07, "timestamp": "03:02:24", "text": "运气。等等，我不应该修复吗？"}, {"type": "subtitle", "time": 10953.91, "timestamp": "03:02:33", "text": "他想他要上去。那边发生了什么事？"}, {"type": "subtitle", "time": 10955.71, "timestamp": "03:02:35", "text": "那片沙漠"}, {"type": "subtitle", "time": 10968.63, "timestamp": "03:02:48", "text": "不。哦，你只要直视前方就行了。"}, {"type": "subtitle", "time": 10971.349, "timestamp": "03:02:51", "text": "天空仿佛在托举你向上。"}, {"type": "subtitle", "time": 10973.309, "timestamp": "03:02:53", "text": "好吧，这其实是……"}, {"type": "subtitle", "time": 10976.91, "timestamp": "03:02:56", "text": "凉爽的。我们起来了"}]
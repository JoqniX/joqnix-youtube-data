[{"type": "subtitle", "time": 20042.67, "timestamp": "05:34:02", "text": "真的要结束了"}, {"type": "subtitle", "time": 20046.15, "timestamp": "05:34:06", "text": "向上。已经过去大约3小时30分钟了。"}, {"type": "subtitle", "time": 20048.708, "timestamp": "05:34:08", "text": "分钟。什么？你敢相信吗，现在已经是3了"}, {"type": "subtitle", "time": 20050.868, "timestamp": "05:34:10", "text": "一小时三十分钟？好了，我就说到这里吧。"}, {"type": "subtitle", "time": 20054.11, "timestamp": "05:34:14", "text": "溪流，吃我的"}, {"type": "subtitle", "time": 20057.548, "timestamp": "05:34:17", "text": "吃完晚饭我就睡觉。"}, {"type": "subtitle", "time": 20064.868, "timestamp": "05:34:24", "text": "嗨，爸爸。喷射。我的天哪，太好玩了。"}, {"type": "subtitle", "time": 20068.35, "timestamp": "05:34:28", "text": "我解锁了所有"}, {"type": "subtitle", "time": 20070.83, "timestamp": "05:34:30", "text": "枪支，所有的一切。"}, {"type": "subtitle", "time": 20074.948, "timestamp": "05:34:34", "text": "不错，兄弟。我喜欢这款游戏。为什么速度快"}, {"type": "subtitle", "time": 20079.51, "timestamp": "05:34:39", "text": "像这样的体感游戏真的很有趣吗？"}, {"type": "subtitle", "time": 20081.07, "timestamp": "05:34:41", "text": "这真是太"}, {"type": "subtitle", "time": 20084.91, "timestamp": "05:34:44", "text": "乐趣。真是太有趣了"}, {"type": "subtitle", "time": 20087.27, "timestamp": "05:34:47", "text": "游戏。我当时太投入了，或者"}, {"type": "subtitle", "time": 20090.628, "timestamp": "05:34:50", "text": "有什么事吗？我当时就像……"}, {"type": "subtitle", "time": 20093.83, "timestamp": "05:34:53", "text": "我人生中最快乐的时光。我的天啊。我"}, {"type": "subtitle", "time": 20095.948, "timestamp": "05:34:55", "text": "太投入了或者"}, {"type": "subtitle", "time": 20098.43, "timestamp": "05:34:58", "text": "某物。"}]
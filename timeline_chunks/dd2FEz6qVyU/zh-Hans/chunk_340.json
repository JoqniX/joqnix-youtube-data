[{"type": "subtitle", "time": 20403.75, "timestamp": "05:40:03", "text": "“好啊，咱们玩一会儿吧。”是的。"}, {"type": "subtitle", "time": 20405.91, "timestamp": "05:40:05", "text": "所以，明天，无论如何，我们都要工作。"}, {"type": "subtitle", "time": 20408.31, "timestamp": "05:40:08", "text": "然后把佣金相关的工作完成。好的。"}, {"type": "subtitle", "time": 20410.788, "timestamp": "05:40:10", "text": "至少要到达检查站。"}, {"type": "subtitle", "time": 20412.708, "timestamp": "05:40:12", "text": "然后又经过一次佣金流"}, {"type": "subtitle", "time": 20414.51, "timestamp": "05:40:14", "text": "我们完成了。"}, {"type": "subtitle", "time": 20417.15, "timestamp": "05:40:17", "text": "完毕"}, {"type": "subtitle", "time": 20419.51, "timestamp": "05:40:19", "text": "大概。所以，谢谢大家！"}, {"type": "subtitle", "time": 20421.91, "timestamp": "05:40:21", "text": "路过。希望你们玩得开心"}, {"type": "subtitle", "time": 20424.39, "timestamp": "05:40:24", "text": "有人看着我突突突。所有新的"}, {"type": "subtitle", "time": 20428.39, "timestamp": "05:40:28", "text": "今天过来的人，呃，就像在……"}, {"type": "subtitle", "time": 20430.47, "timestamp": "05:40:30", "text": "早晨的直播，以及今天真的"}, {"type": "subtitle", "time": 20432.31, "timestamp": "05:40:32", "text": "意义重大。我忘了感谢两个人。"}, {"type": "subtitle", "time": 20435.708, "timestamp": "05:40:35", "text": "在我离线期间关注我的人。"}, {"type": "subtitle", "time": 20439.19, "timestamp": "05:40:39", "text": "嗯，Shili Rosan，谢谢你。"}, {"type": "subtitle", "time": 20446.59, "timestamp": "05:40:46", "text": "谢谢你"}]
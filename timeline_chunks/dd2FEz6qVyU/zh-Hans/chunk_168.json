[{"type": "subtitle", "time": 10097.59, "timestamp": "02:48:17", "text": "我的天哪，我玩得太开心了。什么"}, {"type": "subtitle", "time": 10100.63, "timestamp": "02:48:20", "text": "搞什么鬼？等等，你在哪里？在哪里？"}, {"type": "subtitle", "time": 10106.95, "timestamp": "02:48:26", "text": "狙击手？哦，等等。让我给狙击步枪上膛。"}, {"type": "subtitle", "time": 10125.03, "timestamp": "02:48:45", "text": "杀。我想做三。我的天哪，"}, {"type": "subtitle", "time": 10137.309, "timestamp": "02:48:57", "text": "好的。哦，不错。我的天啊。"}]
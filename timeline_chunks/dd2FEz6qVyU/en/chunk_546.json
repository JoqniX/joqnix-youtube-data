[{"type": "subtitle", "time": 32761.75, "timestamp": "09:06:01", "text": "Welcome. Okay, fine. We are doing the"}, {"type": "subtitle", "time": 32778.112, "timestamp": "09:06:18", "text": "two. Who's"}, {"type": "subtitle", "time": 32784.068, "timestamp": "09:06:24", "text": "Three. There should be four, right?"}, {"type": "subtitle", "time": 32785.908, "timestamp": "09:06:25", "text": "There should be one more hidden"}, {"type": "subtitle", "time": 32795.068, "timestamp": "09:06:35", "text": "Where are"}, {"type": "subtitle", "time": 32799.268, "timestamp": "09:06:39", "text": "you? Oh, hello there."}, {"type": "subtitle", "time": 32802.428, "timestamp": "09:06:42", "text": "I push you down."}, {"type": "subtitle", "time": 32808.63, "timestamp": "09:06:48", "text": "Yep. I pull you up. I flip you."}, {"type": "subtitle", "time": 32811.67, "timestamp": "09:06:51", "text": "I can't do that. Huh? I will float you."}, {"type": "subtitle", "time": 32816.068, "timestamp": "09:06:56", "text": "Freeze you. Do that. Play games with you"}, {"type": "subtitle", "time": 32817.908, "timestamp": "09:06:57", "text": "and"}, {"type": "subtitle", "time": 32819.908, "timestamp": "09:06:59", "text": "do that."}]
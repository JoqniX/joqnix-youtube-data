[{"type": "subtitle", "time": 31441.83, "timestamp": "08:44:01", "text": "Not good night. Have a good Valentine's"}, {"type": "subtitle", "time": 31446.708, "timestamp": "08:44:06", "text": "Day ahead. I shall go eat lunch. For"}, {"type": "subtitle", "time": 31448.628, "timestamp": "08:44:08", "text": "those who are going to eat lunch, have a"}, {"type": "subtitle", "time": 31451.83, "timestamp": "08:44:11", "text": "good meal. For those who came by, thank"}, {"type": "subtitle", "time": 31454.99, "timestamp": "08:44:14", "text": "you so much."}]
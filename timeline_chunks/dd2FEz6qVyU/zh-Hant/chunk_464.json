[{"type": "subtitle", "time": 27852.43, "timestamp": "07:44:12", "text": "？我需要"}, {"type": "subtitle", "time": 27856.35, "timestamp": "07:44:16", "text": "再把它弄壞嗎？"}, {"type": "subtitle", "time": 27858.628, "timestamp": "07:44:18", "text": "啊，等等。好痛。好痛。但"}, {"type": "subtitle", "time": 27863.11, "timestamp": "07:44:23", "text": "事情不能"}, {"type": "subtitle", "time": 27869.83, "timestamp": "07:44:29", "text": "再往後退那麼多了。  你只"}, {"type": "subtitle", "time": 27880.468, "timestamp": "07:44:40", "text": "需要不要做手指伸展運動。直接拖曳就行了。所以感覺就像你這邊的神經被拉伸了一樣。是的。你只要像這樣"}, {"type": "subtitle", "time": 27883.27, "timestamp": "07:44:43", "text": "保持這個姿勢就行了。"}, {"type": "subtitle", "time": 27888.388, "timestamp": "07:44:48", "text": "我不知道。"}, {"type": "subtitle", "time": 27893.35, "timestamp": "07:44:53", "text": "我以前常常這樣做，例如在舞蹈課上練習劈腿的時候。  我有沒有跟你說過"}]
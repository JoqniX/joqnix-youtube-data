[{"type": "subtitle", "time": 13210.99, "timestamp": "03:40:10", "text": "。你跌倒的次數太多了。是的"}, {"type": "subtitle", "time": 13220.83, "timestamp": "03:40:20", "text": "，我有。它必須像表演一樣。必須要有氣勢和動能。這場"}, {"type": "subtitle", "time": 13223.309, "timestamp": "03:40:23", "text": "遊戲講究的是氣勢和勢頭。你"}, {"type": "subtitle", "time": 13231.229, "timestamp": "03:40:31", "text": "必須跟上。同時，我"}, {"type": "subtitle", "time": 13240.87, "timestamp": "03:40:40", "text": "在這方面很差勁。不過"}]
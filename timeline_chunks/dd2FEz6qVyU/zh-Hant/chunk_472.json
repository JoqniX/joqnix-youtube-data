[{"type": "subtitle", "time": 28320.83, "timestamp": "07:52:00", "text": "？真是太"}, {"type": "subtitle", "time": 28324.468, "timestamp": "07:52:04", "text": "奇怪了。」 是的"}, {"type": "subtitle", "time": 28326.548, "timestamp": "07:52:06", "text": "。我"}, {"type": "subtitle", "time": 28333.35, "timestamp": "07:52:13", "text": "第一次參加了街舞舞台表演。原本應該跟我跳舞的朋友，卻像尊雕像一樣"}, {"type": "subtitle", "time": 28353.43, "timestamp": "07:52:33", "text": "站在那裡。當我在台上玩火、跳霹靂舞、做直升機式動作、倒立等等，所有我都失敗了、摔倒了的時候，我不知道該說什麼，他仍然站在那裡，在每個"}, {"type": "subtitle", "time": 28362.91, "timestamp": "07:52:42", "text": "嗯，沒關係"}, {"type": "subtitle", "time": 28366.868, "timestamp": "07:52:46", "text": "。我明白。從他的角度來看，這很奇怪，但我"}, {"type": "subtitle", "time": 28376.99, "timestamp": "07:52:56", "text": "感覺自己也在顫抖。那好像是每年的周日課程之類的活動。我想我之前跟你們"}]
[{"type": "subtitle", "time": 38766.51, "timestamp": "10:46:06", "text": "掉下去嗎？請告訴我他掉下去了。啊，"}, {"type": "subtitle", "time": 38777.51, "timestamp": "10:46:17", "text": "他沒掉下去。等等，我可以推人下去嗎？等等，等等，你下去的時候它就關上了。哦，"}, {"type": "subtitle", "time": 38780.87, "timestamp": "10:46:20", "text": "它是自動的，夥計。我可以推人嗎"}, {"type": "subtitle", "time": 38794.71, "timestamp": "10:46:34", "text": "？告訴我"}, {"type": "subtitle", "time": 38803.586, "timestamp": "10:46:43", "text": "我可以。我可以推你嗎？"}, {"type": "subtitle", "time": 38812.33, "timestamp": "10:46:52", "text": "哦，你不能推市民。好吧，它不起作用。是的，我會再穿兩分鐘，然後換回霍格"}, {"type": "subtitle", "time": 38815.55, "timestamp": "10:46:55", "text": "華茲的衣服。好的，我們只穿10分鐘。就這樣。史萊哲林在"}]
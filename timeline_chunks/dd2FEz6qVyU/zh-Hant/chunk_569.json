[{"type": "subtitle", "time": 34143.03, "timestamp": "09:29:03", "text": "阿奇。阿奇·比克爾。怎麼打開？你媽媽派"}, {"type": "subtitle", "time": 34155.63, "timestamp": "09:29:15", "text": "我們來找你。哦，"}, {"type": "subtitle", "time": 34158.35, "timestamp": "09:29:18", "text": "見到你真高興。別太大聲。哎。對不起。我需要送Aloh回家嗎？"}, {"type": "subtitle", "time": 34191.266, "timestamp": "09:29:51", "text": "我們不會"}, {"type": "subtitle", "time": 34194.39, "timestamp": "09:29:54", "text": "。但他看到了。"}]
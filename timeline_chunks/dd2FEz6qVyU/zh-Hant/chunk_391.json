[{"type": "subtitle", "time": 23465.11, "timestamp": "06:31:05", "text": "五盧比的那個。我買了很多。我想我確實這麼做了。你好，歡迎來到鞦韆。情人節快樂！該死，我今天想打電話，"}, {"type": "subtitle", "time": 23468.15, "timestamp": "06:31:08", "text": "因為我記得我以前打過"}, {"type": "subtitle", "time": 23471.788, "timestamp": "06:31:11", "text": "。太好玩了。是啊"}, {"type": "subtitle", "time": 23494.31, "timestamp": "06:31:34", "text": "血糖值。想像一下得到它是什麼？那是"}, {"type": "subtitle", "time": 23516.548, "timestamp": "06:31:56", "text": "什麼東西？我忘了。嗯，到底是什麼事來著？我下班"}]
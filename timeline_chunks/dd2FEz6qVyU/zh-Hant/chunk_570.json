[{"type": "subtitle", "time": 34213.83, "timestamp": "09:30:13", "text": "首先我們要知道他親生父親的死。我的天哪。這對救我來說太糟糕了。我們不會在這個孩子這麼小的時候就殺了他。我們送你回家吧。我們知道一條安全的回家路。是的。你好，Krono。 [音樂]Constellar。"}, {"type": "subtitle", "time": 34221.67, "timestamp": "09:30:21", "text": "我其實可以像conos cone一樣走。你在這裡。哦"}, {"type": "subtitle", "time": 34228.83, "timestamp": "09:30:28", "text": "，你安全了。"}, {"type": "subtitle", "time": 34237.746, "timestamp": "09:30:37", "text": "媽媽。哦，媽媽。媽媽。朋友們有危險。我"}, {"type": "subtitle", "time": 34243.586, "timestamp": "09:30:43", "text": "聽到帶我來的人在談論他們。哪些"}, {"type": "subtitle", "time": 34251.99, "timestamp": "09:30:51", "text": "朋友，親愛的？ Rae先生和太太。 Filbert先生。"}, {"type": "subtitle", "time": 34254.87, "timestamp": "09:30:54", "text": "我想他們還提到了Otto的名字"}, {"type": "subtitle", "time": 34258.15, "timestamp": "09:30:58", "text": "。我會和他們談談。我剛醒。是的"}]
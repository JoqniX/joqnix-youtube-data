[{"type": "subtitle", "time": 39183.95, "timestamp": "10:53:03", "text": "哇哦。總是去瑞士。"}, {"type": "subtitle", "time": 39187.586, "timestamp": "10:53:07", "text": "哦，一個巫師學院的地方。大概是這麼個地方吧。"}, {"type": "subtitle", "time": 39191.83, "timestamp": "10:53:11", "text": "我忘了那個網站叫什麼了。"}, {"type": "subtitle", "time": 39192.99, "timestamp": "10:53:12", "text": "她還好嗎"}, {"type": "subtitle", "time": 39196.95, "timestamp": "10:53:16", "text": "？祝你好運。你好。"}, {"type": "subtitle", "time": 39199.67, "timestamp": "10:53:19", "text": "你在這裡做什麼？你好，奧米諾斯。"}, {"type": "subtitle", "time": 39202.07, "timestamp": "10:53:22", "text": "奧米諾斯。什麼事？你和"}, {"type": "subtitle", "time": 39204.55, "timestamp": "10:53:24", "text": "塞巴斯蒂安最近在忙什麼？奧米諾斯，我得向你"}, {"type": "subtitle", "time": 39206.79, "timestamp": "10:53:26", "text": "道歉。之前我沒跟"}, {"type": "subtitle", "time": 39210.07, "timestamp": "10:53:30", "text": "你說實話，塞巴斯蒂安確實"}, {"type": "subtitle", "time": 39212.39, "timestamp": "10:53:32", "text": "給我看過。他想為我找個安全的地方"}, {"type": "subtitle", "time": 39214.39, "timestamp": "10:53:34", "text": "練習魔法，好趕上"}, {"type": "subtitle", "time": 39216.39, "timestamp": "10:53:36", "text": "其他五年級的同學。他覺得"}, {"type": "subtitle", "time": 39218.55, "timestamp": "10:53:38", "text": "你不會介意的"}, {"type": "subtitle", "time": 39221.11, "timestamp": "10:53:41", "text": "。我想這說得通。只是"}, {"type": "subtitle", "time": 39222.95, "timestamp": "10:53:42", "text": "賽巴斯蒂安一直纏著我。最近他老是念著些"}, {"type": "subtitle", "time": 39224.63, "timestamp": "10:53:44", "text": "什麼，我都煩死了"}, {"type": "subtitle", "time": 39226.55, "timestamp": "10:53:46", "text": "。別告訴我他還在念"}, {"type": "subtitle", "time": 39230.63, "timestamp": "10:53:50", "text": "什麼來著？呃，抄本。他跟"}, {"type": "subtitle", "time": 39233.11, "timestamp": "10:53:53", "text": "你說過。真的。我們當時在"}, {"type": "subtitle", "time": 39234.79, "timestamp": "10:53:54", "text": "聊霍格華茲的創辦人，他"}, {"type": "subtitle", "time": 39236.63, "timestamp": "10:53:56", "text": "提到了這玩意兒。不過他沒說太多"}, {"type": "subtitle", "time": 39238.55, "timestamp": "10:53:58", "text": "。是啊。他好像覺得裡面"}]
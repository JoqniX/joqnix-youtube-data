[{"type": "subtitle", "time": 38103.426, "timestamp": "10:35:03", "text": "，該死。我不知道。你比"}, {"type": "subtitle", "time": 38113.99, "timestamp": "10:35:13", "text": "你媽媽聰明嗎？你媽媽是誰？所以，那是某人的名字嗎？能再穿決鬥服直播一次嗎？"}, {"type": "subtitle", "time": 38126.23, "timestamp": "10:35:26", "text": "我的意思是，那樣我就可以穿著那套衣服進行"}, {"type": "subtitle", "time": 38135.266, "timestamp": "10:35:35", "text": "決鬥直播了。我願意。在雙流"}, {"type": "subtitle", "time": 38145.51, "timestamp": "10:35:45", "text": "直播上。我的意思是，我可以換身衣服。我沒有鑰匙夾，不過就這樣吧。大家想看[音樂]這個。就這樣吧。我會先用一下"}, {"type": "subtitle", "time": 38153.79, "timestamp": "10:35:53", "text": "雙語。沒關係。這是誰的房子？我為什麼要"}]
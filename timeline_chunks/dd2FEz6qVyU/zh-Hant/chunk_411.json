[{"type": "subtitle", "time": 24662.43, "timestamp": "06:51:02", "text": "。哦，不。"}, {"type": "subtitle", "time": 24676.83, "timestamp": "06:51:16", "text": "糖果份量。  一、二、三、四、五、六。我的天哪。"}, {"type": "subtitle", "time": 24680.868, "timestamp": "06:51:20", "text": "我該怎麼辦？我該自己吃掉它，還是分給家人呢？哦。"}, {"type": "subtitle", "time": 24686.788, "timestamp": "06:51:26", "text": "哦，是的。我可以給我家狗狗和"}, {"type": "subtitle", "time": 24699.51, "timestamp": "06:51:39", "text": "貓咪各一個。我去年做過。是啊，我忘了。"}, {"type": "subtitle", "time": 24712.27, "timestamp": "06:51:52", "text": "你知道嗎，"}, {"type": "subtitle", "time": 24715.43, "timestamp": "06:51:55", "text": "我總是給我"}, {"type": "subtitle", "time": 24717.59, "timestamp": "06:51:57", "text": "的寵物吃Vand Day糖果。他們很喜歡。  去年，去年就像……去年就像那隻小貓。唉，可惜她過世了，不過今年我會把獎品送給我"}]
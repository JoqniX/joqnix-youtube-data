[{"type": "subtitle", "time": 36916.586, "timestamp": "10:15:16", "text": "你沒有健康。好了，我把他們都殺了。"}, {"type": "subtitle", "time": 36919.746, "timestamp": "10:15:19", "text": "好的。  哎呀，我的身體不好。"}, {"type": "subtitle", "time": 36931.266, "timestamp": "10:15:31", "text": "忍者。你懂很多忍者。"}, {"type": "subtitle", "time": 36934.03, "timestamp": "10:15:34", "text": "什麼？我們沒有？我們沒有？  嗯？現在去慢跑"}]
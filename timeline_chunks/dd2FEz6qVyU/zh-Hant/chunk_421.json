[{"type": "subtitle", "time": 25282.35, "timestamp": "07:01:22", "text": "我要對今天到場的"}, {"type": "subtitle", "time": 25285.27, "timestamp": "07:01:25", "text": "每個人說：你好，Isensa。情人節快樂。你想吃巧克力嗎？是的，我的巧克力。我希望我是第一個。  眨眼。我寄這個包裹的時候，很想帶點小禮物給你"}, {"type": "subtitle", "time": 25306.07, "timestamp": "07:01:46", "text": "。所以，我想我會一直留著這個，"}]
[{"type": "subtitle", "time": 38280.266, "timestamp": "10:38:00", "text": "我必須這麼做。"}, {"type": "subtitle", "time": 38290.07, "timestamp": "10:38:10", "text": "哦，是的。我會幫你的，草莓女士。我會幫你的。別擔心。我剛"}, {"type": "subtitle", "time": 38294.58, "timestamp": "10:38:14", "text": "看到你的消息。我的天。"}, {"type": "subtitle", "time": 38300.51, "timestamp": "10:38:20", "text": "史萊哲林"}, {"type": "subtitle", "time": 38310.83, "timestamp": "10:38:30", "text": "學院在哪裡？"}, {"type": "subtitle", "time": 38321.47, "timestamp": "10:38:41", "text": "[音樂]"}, {"type": "subtitle", "time": 38326.15, "timestamp": "10:38:46", "text": "呃，是的。是的。是的。"}, {"type": "subtitle", "time": 38330.71, "timestamp": "10:38:50", "text": "主要是確保你"}, {"type": "subtitle", "time": 38332.11, "timestamp": "10:38:52", "text": "不要刷屏，因為呃"}]
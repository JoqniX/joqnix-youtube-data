[{"type": "subtitle", "time": 27967.15, "timestamp": "07:46:07", "text": "我也想讓這根手指這樣，但這很難。雙關節手指。我不"}, {"type": "subtitle", "time": 27976.31, "timestamp": "07:46:16", "text": "知道。分成一人。我以前經常這樣做。我以前經常做這件事，但自從8年前開始"}, {"type": "subtitle", "time": 27989.83, "timestamp": "07:46:29", "text": "我就不再鍛煉，甚至什麼都不做了，所以就和它失去了聯繫。所以如果我這麼做，現在會很"}, {"type": "subtitle", "time": 27996.548, "timestamp": "07:46:36", "text": "痛苦。"}, {"type": "subtitle", "time": 28004.19, "timestamp": "07:46:44", "text": "但我還想重新學習如何做這件事。"}, {"type": "subtitle", "time": 28015.03, "timestamp": "07:46:55", "text": "樂趣。是的。  我的天啊。 Random Hol 玩"}]
[{"type": "subtitle", "time": 36842.79, "timestamp": "10:14:02", "text": "我覺得我做不到。我必須時刻保持"}, {"type": "subtitle", "time": 36861.71, "timestamp": "10:14:21", "text": "前進。我覺得我好像抓到他了。是的。  你敢死試試！  不要死。不要死。不要貿然行動。"}, {"type": "subtitle", "time": 36864.47, "timestamp": "10:14:24", "text": "讓開。脫離戰鬥。我的天啊。這是"}]
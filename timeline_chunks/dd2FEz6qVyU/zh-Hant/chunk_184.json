[{"type": "subtitle", "time": 11047.15, "timestamp": "03:04:07", "text": "那一球打得真好。哦，不錯。我的天啊。  好的。"}, {"type": "subtitle", "time": 11063.269, "timestamp": "03:04:23", "text": "我得重新加載。沒關係。哦，那真不錯。我的天哪，"}, {"type": "subtitle", "time": 11072.55, "timestamp": "03:04:32", "text": "太棒了。  不，不，不，不，不，不，不。有什麼東西。你有沒有看到？"}, {"type": "subtitle", "time": 11094.429, "timestamp": "03:04:54", "text": "你看到了嗎？下面肯定有東西，對吧？是的。這個人。我怎麼會這樣？你看到了嗎？"}]
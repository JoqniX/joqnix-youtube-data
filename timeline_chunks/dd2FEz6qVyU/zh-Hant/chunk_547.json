[{"type": "subtitle", "time": 32831.35, "timestamp": "09:07:11", "text": "什麼忙嗎？賈爾。"}, {"type": "subtitle", "time": 32833.388, "timestamp": "09:07:13", "text": "好的。"}, {"type": "subtitle", "time": 32836.708, "timestamp": "09:07:16", "text": "我們把所有東西都賣掉。耶。賣給他們"}, {"type": "subtitle", "time": 32846.868, "timestamp": "09:07:26", "text": "還沒有賣給他們未鑑定的物品。賣賣。為什麼會這樣呢"}, {"type": "subtitle", "time": 32849.868, "timestamp": "09:07:29", "text": "？我不知道"}, {"type": "subtitle", "time": 32858.47, "timestamp": "09:07:38", "text": "實際上，不是店主。算了。"}, {"type": "subtitle", "time": 32861.19, "timestamp": "09:07:41", "text": "呃，嗨。我們走吧。我把信帶給她了。她告訴我關於布萊先生的事。他一直在做我們正在為警官提供的同樣的事情。他就這麼消失了嗎"}]
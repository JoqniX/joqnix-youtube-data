[{"type": "subtitle", "time": 24547.35, "timestamp": "06:49:07", "text": "師父。  哦，你們還在說最後幾場直播。我的天啊。你"}, {"type": "subtitle", "time": 24550.628, "timestamp": "06:49:10", "text": "想要的，我不要"}, {"type": "subtitle", "time": 24553.43, "timestamp": "06:49:13", "text": "主人。我指的是經理。  但沒關係。我不要。什麼？你"}, {"type": "subtitle", "time": 24571.15, "timestamp": "06:49:31", "text": "說的這些可疑的事情到底是什麼？"}, {"type": "subtitle", "time": 24583.35, "timestamp": "06:49:43", "text": "嘿，我們不評斷音樂。我還沒想過。等等，我好像已經說過了"}]
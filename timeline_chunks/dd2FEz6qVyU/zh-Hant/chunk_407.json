[{"type": "subtitle", "time": 24420.468, "timestamp": "06:47:00", "text": "，"}, {"type": "subtitle", "time": 24434.788, "timestamp": "06:47:14", "text": "我"}, {"type": "subtitle", "time": 24437.39, "timestamp": "06:47:17", "text": "沒有收到。你將是我的第一個。好的。做你的第一個。好的。我將成為你的第一個。  耶。拿著吧。拿著吧。  耶！我，我，我得到了你第一次，在這個情人節。我這輩子連一束花都沒收到過"}, {"type": "subtitle", "time": 24438.99, "timestamp": "06:47:18", "text": "。巧克力自成一派。"}, {"type": "subtitle", "time": 24442.948, "timestamp": "06:47:22", "text": "哦，等等。我"}, {"type": "subtitle", "time": 24452.708, "timestamp": "06:47:32", "text": "本來可以買花給你的，要"}, {"type": "subtitle", "time": 24455.43, "timestamp": "06:47:35", "text": "不要我送你一些花？"}]
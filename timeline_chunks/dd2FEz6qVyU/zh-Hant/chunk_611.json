[{"type": "subtitle", "time": 36680.07, "timestamp": "10:11:20", "text": "魔王化身。難道你不想就此毀滅，與他的"}, {"type": "subtitle", "time": 36682.55, "timestamp": "10:11:22", "text": "頭顱融為一體嗎？"}, {"type": "subtitle", "time": 36684.87, "timestamp": "10:11:24", "text": "嗯？  毀滅，絕不。哦，我沒有。我只是說我"}, {"type": "subtitle", "time": 36691.63, "timestamp": "10:11:31", "text": "不喜歡它，因為我太嫉妒我的父母了。哦，但這並不意味著我喜歡別人擁有它。我為什麼喜歡那些注重"}, {"type": "subtitle", "time": 36718.71, "timestamp": "10:11:58", "text": "頭髮造型的人。嗯，沒關係。"}]
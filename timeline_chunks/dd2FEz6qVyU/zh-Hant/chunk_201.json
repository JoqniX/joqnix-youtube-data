[{"type": "subtitle", "time": 12060.309, "timestamp": "03:21:00", "text": "我覺得"}, {"type": "subtitle", "time": 12062.229, "timestamp": "03:21:02", "text": "我"}, {"type": "subtitle", "time": 12064.75, "timestamp": "03:21:04", "text": "應該在這裡。哦，不。不，不，不，不，不"}, {"type": "subtitle", "time": 12090.309, "timestamp": "03:21:30", "text": "。等等，等等。別死。哦，是的。就是這裡。不，我沒把這個盒子拿出來。所以，顯然我沒有按下這個鍵。不，這還不夠嗎？"}, {"type": "subtitle", "time": 12091.229, "timestamp": "03:21:31", "text": "哦，夠了"}, {"type": "subtitle", "time": 12109.19, "timestamp": "03:21:49", "text": "我們弄到了一把"}]
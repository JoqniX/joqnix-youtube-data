[{"type": "subtitle", "time": 33782.15, "timestamp": "09:23:02", "text": "什麼？哦，我的天，她……有個蒙勒。她讓我想起了史丹。哦，我的天，她是卡瓦。告訴我她是短髮，拜託。我覺得她是短髮"}, {"type": "subtitle", "time": 33789.63, "timestamp": "09:23:09", "text": "，對吧？這是誰？她是個老婆人選"}, {"type": "subtitle", "time": 33792.19, "timestamp": "09:23:12", "text": "。"}, {"type": "subtitle", "time": 33806.426, "timestamp": "09:23:26", "text": "哦，我的天。她卡哇伊。藍色和東西。她看起來像個公主或國王。她自己就是個女王。她是"}, {"type": "subtitle", "time": 33818.906, "timestamp": "09:23:38", "text": "九頭蛇女王。什麼？哦，這個。"}, {"type": "subtitle", "time": 33822.55, "timestamp": "09:23:42", "text": "不。新侍從。新"}]
[{"type": "subtitle", "time": 36485.35, "timestamp": "10:08:05", "text": "我一次就把他們都殺了。"}, {"type": "subtitle", "time": 36503.586, "timestamp": "10:08:23", "text": "。  死的。"}, {"type": "subtitle", "time": 36506.47, "timestamp": "10:08:26", "text": "我該怎麼辦？  焚香。  你喜歡變老的"}, {"type": "subtitle", "time": 36510.15, "timestamp": "10:08:30", "text": "樣子。  好的。是啊，但你在這裡不配活下去。不，不。不，不，不，不，不，不，不，不。"}, {"type": "subtitle", "time": 36516.87, "timestamp": "10:08:36", "text": "等等，我沒說過這句話。我的天啊。現在我的聲音被用來對付我了"}, {"type": "subtitle", "time": 36523.19, "timestamp": "10:08:43", "text": "。我說了什麼？"}]
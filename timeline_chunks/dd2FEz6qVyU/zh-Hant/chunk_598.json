[{"type": "subtitle", "time": 35883.07, "timestamp": "09:58:03", "text": "嗯，是的。  我爸爸生氣的時候注意到它了。  我不知道他為什麼有點不高興，好像在說“哦，你現在變成……"}, {"type": "subtitle", "time": 35896.71, "timestamp": "09:58:16", "text": "呃"}, {"type": "subtitle", "time": 35904.31, "timestamp": "09:58:24", "text": "，你現在變成女人了，你變得像你媽媽一樣，腿上沒有毛了”，我就說“你知道，我討厭"}, {"type": "subtitle", "time": 35906.47, "timestamp": "09:58:26", "text": "毛髮”，然後我就說“"}, {"type": "subtitle", "time": 35909.83, "timestamp": "09:58:29", "text": "哼，一個腿上沒有"}, {"type": "subtitle", "time": 35919.99, "timestamp": "09:58:39", "text": "毛的男孩說道”。  駝峰。那次我們遇到了一點小麻煩。我的天啊。是的。我……我有點……我不"}, {"type": "subtitle", "time": 35922.39, "timestamp": "09:58:42", "text": "知道。  哦，雖然我喜歡見到你，但你知道我有點頭髮"}, {"type": "subtitle", "time": 35927.426, "timestamp": "09:58:47", "text": "狂熱之類的。我不知道。我喜歡頭髮，像是髮型之類的，但那是在"}, {"type": "subtitle", "time": 35939.83, "timestamp": "09:58:59", "text": "額頭上，而是指手、腿等公共部位的毛髮。我自己不太了解，我有點討厭這樣，但如果我在別人身上"}]
[{"type": "subtitle", "time": 39300.95, "timestamp": "10:55:00", "text": "你不想知道她發生了什麼事嗎？諾克圖亞姑姑出於好意走上了這條路，卻因此喪命。好意。我不想同樣的事情再發生。你不知道"}, {"type": "subtitle", "time": 39303.19, "timestamp": "10:55:03", "text": "歷史會重演。再說，你"}, {"type": "subtitle", "time": 39305.03, "timestamp": "10:55:05", "text": "說你姑姑的"}, {"type": "subtitle", "time": 39314.07, "timestamp": "10:55:14", "text": "想法跟你一樣。這或許能"}, {"type": "subtitle", "time": 39318.47, "timestamp": "10:55:18", "text": "紀念她。幫"}, {"type": "subtitle", "time": 39323.426, "timestamp": "10:55:23", "text": "你找到關於史萊哲林和賽巴斯蒂安的答案，幫安妮找到答案。你姑姑一直在追查這件事。幫我把電池一起充好，因為我的滑鼠也是電池。我明白你在這裡做了什麼，我承認。你說服我了。回來。我"}, {"type": "subtitle", "time": 39330.47, "timestamp": "10:55:30", "text": "沒想到會這樣。"}, {"type": "subtitle", "time": 39332.55, "timestamp": "10:55:32", "text": "好吧。我"}, {"type": "subtitle", "time": 39339.87, "timestamp": "10:55:39", "text": "會告訴你我所知道的一切。"}, {"type": "subtitle", "time": 39354.07, "timestamp": "10:55:54", "text": "賽巴斯蒂安，我等著。你繼續玩遊戲，我一邊玩一邊直播我的電腦。我們不後悔。是嗎？是的，"}, {"type": "subtitle", "time": 39356.55, "timestamp": "10:55:56", "text": "我是一個"}]
[{"type": "subtitle", "time": 20223.11, "timestamp": "05:37:03", "text": "哦，我的錯。我把它關掉了"}, {"type": "subtitle", "time": 20226.51, "timestamp": "05:37:06", "text": "。我的意思是，反正就像我們又"}, {"type": "subtitle", "time": 20229.19, "timestamp": "05:37:09", "text": "直播了多久，你打算讓我把所有東西都找到，"}, {"type": "subtitle", "time": 20231.59, "timestamp": "05:37:11", "text": "還是我們結束？你想要什麼？你們覺得呢？我們"}, {"type": "subtitle", "time": 20244.43, "timestamp": "05:37:24", "text": "做什麼？我還有午餐要吃，我是說晚餐也要吃，不知道。"}, {"type": "subtitle", "time": 20247.75, "timestamp": "05:37:27", "text": "呃，Suki Mitchi 第二季。哦，那個長得像我的角色不是[音樂]那個"}, {"type": "subtitle", "time": 20255.43, "timestamp": "05:37:35", "text": "。  好的。範圍。這是"}, {"type": "subtitle", "time": 20261.75, "timestamp": "05:37:41", "text": "9天前的事了，對吧？"}, {"type": "subtitle", "time": 20279.23, "timestamp": "05:37:59", "text": "Naz手雷加速可以讓你也可以直接從火山跳下去。你說的直接從火山"}]
[{"type": "subtitle", "time": 16.31, "timestamp": "00:00:16", "text": "好了，直播開始了。歡迎來到"}, {"type": "subtitle", "time": 18.79, "timestamp": "00:00:18", "text": "Joathon 的第 48 天。歡迎收看第二部分"}, {"type": "subtitle", "time": 22.15, "timestamp": "00:00:22", "text": "直播，夜間直播。你好。呃，對於"}, {"type": "subtitle", "time": 25.029, "timestamp": "00:00:25", "text": "那些錯過的人，呃，我去佈置"}, {"type": "subtitle", "time": 27.83, "timestamp": "00:00:27", "text": "作業了。當時我正在外面辦事"}, {"type": "subtitle", "time": 30.189, "timestamp": "00:00:30", "text": "。是的，我今天終於再次踏進了車庫，距離上次踏進車庫已經過了很久很久"}, {"type": "subtitle", "time": 36.63, "timestamp": "00:00:36", "text": "。我已經把自己關在房間裡，"}, {"type": "subtitle", "time": 40.069, "timestamp": "00:00:40", "text": "每天24小時直播，持續了"}, {"type": "subtitle", "time": 43.63, "timestamp": "00:00:43", "text": "兩三個月。我不知道。是的"}, {"type": "subtitle", "time": 47.51, "timestamp": "00:00:47", "text": "，我摸過草。我被"}, {"type": "subtitle", "time": 50.47, "timestamp": "00:00:50", "text": "雨淋透了。我當時騎著我的踏板車。我"}, {"type": "subtitle", "time": 53.91, "timestamp": "00:00:53", "text": "叔叔陪著我，我們去了"}, {"type": "subtitle", "time": 55.83, "timestamp": "00:00:55", "text": "大學學習中心之類的機構，在那裡"}, {"type": "subtitle", "time": 59.59, "timestamp": "00:00:59", "text": "我要提交作業，"}]
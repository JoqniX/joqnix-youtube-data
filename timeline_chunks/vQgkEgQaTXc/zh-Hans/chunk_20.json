[{"type": "subtitle", "time": 1208.07, "timestamp": "00:20:08", "text": "进去。 我很害怕。 我很害怕。"}, {"type": "subtitle", "time": 1209.788, "timestamp": "00:20:09", "text": "请进屋。 我很害怕。"}, {"type": "subtitle", "time": 1210.39, "timestamp": "00:20:10", "text": "[笑声]"}, {"type": "subtitle", "time": 1213.029, "timestamp": "00:20:13", "text": "我们进去吧。"}, {"type": "subtitle", "time": 1214.95, "timestamp": "00:20:14", "text": "请。 我很害怕。 我很害怕。 我很"}, {"type": "subtitle", "time": 1217.43, "timestamp": "00:20:17", "text": "害怕。 我很害怕。 为什么门是这样的"}, {"type": "subtitle", "time": 1218.95, "timestamp": "00:20:18", "text": "？"}, {"type": "subtitle", "time": 1227.909, "timestamp": "00:20:27", "text": "好的。 物理。 该死的物理学。 该死的"}, {"type": "subtitle", "time": 1230.789, "timestamp": "00:20:30", "text": "物理学。 愚蠢的物理学[笑声]。"}, {"type": "subtitle", "time": 1233.029, "timestamp": "00:20:33", "text": "我的天啊。"}, {"type": "subtitle", "time": 1239.27, "timestamp": "00:20:39", "text": "谁在我的浴室里？"}, {"type": "subtitle", "time": 1240.87, "timestamp": "00:20:40", "text": "等待。 不，不，不，把门关上。 我很"}, {"type": "subtitle", "time": 1244.31, "timestamp": "00:20:44", "text": "害怕。 我很害怕。 我很害怕。"}, {"type": "subtitle", "time": 1247.19, "timestamp": "00:20:47", "text": "谁在我的厕所里？ 我甚至都看不见"}, {"type": "subtitle", "time": 1258.95, "timestamp": "00:20:58", "text": "房东太太。 哦，我们好像是合住一个房间什么的"}]
[{"type": "subtitle", "time": 1563.59, "timestamp": "00:26:03", "text": "我的天哪。 圣。 万福玛利亚，满被"}, {"type": "subtitle", "time": 1566.789, "timestamp": "00:26:06", "text": "圣宠者。 主与你同在。"}, {"type": "subtitle", "time": 1577.43, "timestamp": "00:26:17", "text": "我刚才看到了一些东西。 我看到了人体残肢。"}, {"type": "subtitle", "time": 1579.99, "timestamp": "00:26:19", "text": "搞什么鬼？"}, {"type": "subtitle", "time": 1585.909, "timestamp": "00:26:25", "text": "兄弟，兄弟，兄弟，兄弟，兄弟，"}]
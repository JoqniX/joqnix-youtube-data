[{"type": "subtitle", "time": 4501.75, "timestamp": "01:15:01", "text": "，那个粉红女郎会在这里吗？"}, {"type": "subtitle", "time": 4503.35, "timestamp": "01:15:03", "text": "”结果并没有。所以我就想，"}, {"type": "subtitle", "time": 4506.63, "timestamp": "01:15:06", "text": "“好吧，我需要空间。” 我这就卸载"}, {"type": "chat", "time": 4509.325, "timestamp": "01:15:09", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "I bought walking dead series man gonna enjoy the nostalgia"}, {"type": "subtitle", "time": 4509.99, "timestamp": "01:15:09", "text": "HSR。”我看到他们有很多系统，"}, {"type": "subtitle", "time": 4511.83, "timestamp": "01:15:11", "text": "然后我就想，“哦，好吧。”好多"}, {"type": "subtitle", "time": 4513.43, "timestamp": "01:15:13", "text": "东西啊。"}, {"type": "subtitle", "time": 4515.11, "timestamp": "01:15:15", "text": "我买了《行尸走肉》系列，老兄。我会好好"}, {"type": "subtitle", "time": 4518.63, "timestamp": "01:15:18", "text": "享受的。哦，不错。不错。就这么定了"}, {"type": "subtitle", "time": 4533.99, "timestamp": "01:15:33", "text": "嗨。总之，我想我们可以结束了"}, {"type": "subtitle", "time": 4538.47, "timestamp": "01:15:38", "text": "。"}, {"type": "subtitle", "time": 4541.35, "timestamp": "01:15:41", "text": "尖叫完之后，我的心脏和头都疼得厉害"}, {"type": "chat", "time": 4547.864, "timestamp": "01:15:47", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "Will do mhm get some water"}, {"type": "subtitle", "time": 4549.189, "timestamp": "01:15:49", "text": "不过，是啊，挺好玩的"}, {"type": "subtitle", "time": 4552.63, "timestamp": "01:15:52", "text": "。是"}, {"type": "subtitle", "time": 4555.03, "timestamp": "01:15:55", "text": "啊，谢谢你提醒。我去喝点"}, {"type": "chat", "time": 4555.709, "timestamp": "01:15:55", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffff
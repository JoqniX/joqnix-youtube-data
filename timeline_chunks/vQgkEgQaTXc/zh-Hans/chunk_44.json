[{"type": "subtitle", "time": 2659.67, "timestamp": "00:44:19", "text": "我敢肯定，我发誓，我"}, {"type": "subtitle", "time": 2666.95, "timestamp": "00:44:26", "text": "直播恐怖"}, {"type": "subtitle", "time": 2668.87, "timestamp": "00:44:28", "text": "游戏的时候肯定会做噩梦。每次直播恐怖游戏都会这样。"}, {"type": "subtitle", "time": 2671.349, "timestamp": "00:44:31", "text": "或者看到任何"}, {"type": "subtitle", "time": 2673.51, "timestamp": "00:44:33", "text": "可怕的东西的广告，我都会做噩梦"}, {"type": "subtitle", "time": 2677.43, "timestamp": "00:44:37", "text": "。 哦，那个女人突然尖叫着朝"}, {"type": "subtitle", "time": 2681.589, "timestamp": "00:44:41", "text": "我跑过来，"}, {"type": "subtitle", "time": 2685.349, "timestamp": "00:44:45", "text": "吓了我一跳。 哦，"}, {"type": "subtitle", "time": 2688.47, "timestamp": "00:44:48", "text": "我还记得那突如其来的惊吓。 我的"}, {"type": "subtitle", "time": 2696.79, "timestamp": "00:44:56", "text": "加油！ 我感觉……（叹气）"}, {"type": "subtitle", "time": 2699.91, "timestamp": "00:44:59", "text": "我的心跳得好快。"}]
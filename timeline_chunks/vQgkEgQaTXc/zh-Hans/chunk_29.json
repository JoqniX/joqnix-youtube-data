[{"type": "subtitle", "time": 1741.99, "timestamp": "00:29:01", "text": "尖叫起来。 我发出了一声凄厉的尖叫。 我发出了一声"}, {"type": "subtitle", "time": 1744.149, "timestamp": "00:29:04", "text": "凄厉的尖叫。 我尖叫起来。 你听到我的尖叫声了吗？"}, {"type": "subtitle", "time": 1747.029, "timestamp": "00:29:07", "text": "还是他们设置了噪音抑制？"}, {"type": "subtitle", "time": 1751.48, "timestamp": "00:29:11", "text": "我的天啊。 我的名字叫欧·弗兰克。"}, {"type": "subtitle", "time": 1752.47, "timestamp": "00:29:12", "text": "[笑声]"}, {"type": "subtitle", "time": 1760.149, "timestamp": "00:29:20", "text": "我的天哪。"}, {"type": "subtitle", "time": 1769.029, "timestamp": "00:29:29", "text": "我的天啊。 等待。 嗯，我想我可以这样"}, {"type": "subtitle", "time": 1771.909, "timestamp": "00:29:31", "text": "做，让你们稍微了解一下"}, {"type": "subtitle", "time": 1778.549, "timestamp": "00:29:38", "text": "这样好吗？"}]
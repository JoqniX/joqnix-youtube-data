[{"type": "subtitle", "time": 673.43, "timestamp": "00:11:13", "text": "[清嗓子]"}, {"type": "subtitle", "time": 675.43, "timestamp": "00:11:15", "text": "我需要准备些水。 我"}, {"type": "subtitle", "time": 679.19, "timestamp": "00:11:19", "text": "今晚肯定会尖叫很多次。 但我需要水。"}, {"type": "subtitle", "time": 682.31, "timestamp": "00:11:22", "text": "我的天啊。 这模式真诡异。"}, {"type": "subtitle", "time": 689.91, "timestamp": "00:11:29", "text": "我的天啊。  [笑声]"}, {"type": "subtitle", "time": 691.677, "timestamp": "00:11:31", "text": "我想要"}, {"type": "subtitle", "time": 708.31, "timestamp": "00:11:48", "text": "我好害怕。 我在四楼的毁灭约会"}, {"type": "subtitle", "time": 710.79, "timestamp": "00:11:50", "text": "。  [叹息和喘息]"}]
[{"type": "subtitle", "time": 3241.829, "timestamp": "00:54:01", "text": "要么我会做个非常可怕的噩梦"}, {"type": "subtitle", "time": 3244.15, "timestamp": "00:54:04", "text": "（笑），"}, {"type": "subtitle", "time": 3247.75, "timestamp": "00:54:07", "text": "要么我就会在真正害怕的"}, {"type": "subtitle", "time": 3250.47, "timestamp": "00:54:10", "text": "时候开始压低或静音我的麦克风"}, {"type": "subtitle", "time": 3252.87, "timestamp": "00:54:12", "text": "。 这就是合作中会发生的情况，"}, {"type": "subtitle", "time": 3256.95, "timestamp": "00:54:16", "text": "或者我和别人在一起的时候，"}, {"type": "chat", "time": 3262.657, "timestamp": "00:54:22", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "yall be fine"}, {"type": "subtitle", "time": 3267.109, "timestamp": "00:54:27", "text": "我希望得到保护。   是的"}, {"type": "subtitle", "time": 3269.51, "timestamp": "00:54:29", "text": "。"}, {"type": "subtitle", "time": 3272.71, "timestamp": "00:54:32", "text": "我不知道。 恐怖的东西我"}, {"type": "subtitle", "time": 3275.43, "timestamp": "00:54:35", "text": "受不了。"}, {"type": "subtitle", "time": 3279.19, "timestamp": "00:54:39", "text": "有时候我会开始……我试图让自己"}, {"type": "subtitle", "time": 3282.95, "timestamp": "00:54:42", "text": "麻木，我……我感觉自己像一堵墙。 我像"}, {"type": "subtitle", "time": 3286.15, "timestamp": "00:54:46", "text": "石头一样坚硬。 我是事物。 我不是人类。 我就是"}, {"type": "subtitle", "time": 3289.349, "timestamp": "00:54:49", "text": "一堵墙。 我像一块石头。 我是一座雕像。 而且我"}, {"type": "subtitle", "time": 3293.03, "timestamp": "00:54:53", "text": "还能"}, {"type": "subtitle", "time": 3295.589, "timestamp": "00:54:55", "text": "看懂一些东西，恐怖的，令人毛骨悚然的"}, {"type": "subtitle", "time": 3299.51, "timestamp": "00:54:59", "text": "东西。 但是但是但是"}]
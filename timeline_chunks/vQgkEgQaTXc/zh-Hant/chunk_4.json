[{"type": "subtitle", "time": 244.949, "timestamp": "00:04:04", "text": "我不知道這算不算值得一提，但確實如此"}, {"type": "subtitle", "time": 247.27, "timestamp": "00:04:07", "text": "。呃，"}, {"type": "subtitle", "time": 250.309, "timestamp": "00:04:10", "text": "所以我們"}, {"type": "subtitle", "time": 252.55, "timestamp": "00:04:12", "text": "不得不，呃，我們必須這麼做。是的。"}, {"type": "subtitle", "time": 255.50900000000001, "timestamp": "00:04:15", "text": "看來這款遊戲通關大約需要1小時"}, {"type": "subtitle", "time": 258.55, "timestamp": "00:04:18", "text": "。"}, {"type": "subtitle", "time": 261.59, "timestamp": "00:04:21", "text": "我最初的想法是，如果這款遊戲需要"}, {"type": "subtitle", "time": 265.189, "timestamp": "00:04:25", "text": "更多時間之類的"}, {"type": "subtitle", "time": 267.03, "timestamp": "00:04:27", "text": "，我打算進行兩次"}, {"type": "subtitle", "time": 271.43, "timestamp": "00:04:31", "text": "直播。但如果我"}, {"type": "subtitle", "time": 274.87, "timestamp": "00:04:34", "text": "今天能夠完成直播，或是透過"}, {"type": "subtitle", "time": 277.11, "timestamp": "00:04:37", "text": "推特本身，"}, {"type": "subtitle", "time": 282.71, "timestamp": "00:04:42", "text": "呃，今晚就能完成，那我們大概就能做到"}, {"type": "subtitle", "time": 285.99, "timestamp": "00:04:45", "text": "。是的，[笑聲]"}, {"type": "subtitle", "time": 289.51, "timestamp": "00:04:49", "text": "是[倒吸一口氣]但確實如此。嗯，"}]
[{"type": "subtitle", "time": 184.949, "timestamp": "00:03:04", "text": "我又不是被迫的"}, {"type": "subtitle", "time": 189.19, "timestamp": "00:03:09", "text": "。嗯，對了，"}, {"type": "subtitle", "time": 192.63, "timestamp": "00:03:12", "text": "今天晚上我們會"}, {"type": "subtitle", "time": 195.182, "timestamp": "00:03:15", "text": "進行恐怖直播。"}, {"type": "subtitle", "time": 196.149, "timestamp": "00:03:16", "text": "[笑聲與驚呼]"}, {"type": "subtitle", "time": 199.03, "timestamp": "00:03:19", "text": "我有點"}, {"type": "subtitle", "time": 217.82999999999998, "timestamp": "00:03:37", "text": "我已經很久沒玩"}, {"type": "subtitle", "time": 221.75, "timestamp": "00:03:41", "text": "恐怖遊戲了，所以我既興奮又"}, {"type": "subtitle", "time": 224.869, "timestamp": "00:03:44", "text": "害怕。"}, {"type": "subtitle", "time": 230.149, "timestamp": "00:03:50", "text": "你在等嗎？我想你應該能從"}, {"type": "subtitle", "time": 234.55, "timestamp": "00:03:54", "text": "我的麥克風裡聽到我說的所有話，"}, {"type": "subtitle", "time": 235.50900000000001, "timestamp": "00:03:55", "text": "對吧？"}, {"type": "subtitle", "time": 237.91, "timestamp": "00:03:57", "text": "所以，嗯，"}]
[{"type": "subtitle", "time": 673.43, "timestamp": "00:11:13", "text": "[咳払い]"}, {"type": "subtitle", "time": 675.43, "timestamp": "00:11:15", "text": "水を用意してください。"}, {"type": "subtitle", "time": 679.19, "timestamp": "00:11:19", "text": "今夜は思いっきり叫びまくるつもり。 水が必要なんだ。 何てことだ"}, {"type": "subtitle", "time": 682.31, "timestamp": "00:11:22", "text": "。 なんて不気味なモードなんだ。"}, {"type": "subtitle", "time": 689.91, "timestamp": "00:11:29", "text": "。  [笑い]"}, {"type": "subtitle", "time": 691.677, "timestamp": "00:11:31", "text": "私は欲しい"}, {"type": "subtitle", "time": 708.31, "timestamp": "00:11:48", "text": "怖い。 私の廃墟での予約は"}, {"type": "subtitle", "time": 710.79, "timestamp": "00:11:50", "text": "4階です。  [ため息をつき、息を呑む] あの"}]
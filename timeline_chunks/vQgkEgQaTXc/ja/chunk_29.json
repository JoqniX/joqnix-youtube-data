[{"type": "subtitle", "time": 1741.99, "timestamp": "00:29:01", "text": "叫んだ。 私は大声で叫んだ。 私は"}, {"type": "subtitle", "time": 1744.149, "timestamp": "00:29:04", "text": "大声で叫んだ。 私は叫んだ。 私の叫び声は聞こえましたか"}, {"type": "subtitle", "time": 1747.029, "timestamp": "00:29:07", "text": "？それとも消音処理されたのでしょうか？   何てことだ"}, {"type": "subtitle", "time": 1751.48, "timestamp": "00:29:11", "text": "。 私の名前はオー・フランクでした。"}, {"type": "subtitle", "time": 1752.47, "timestamp": "00:29:12", "text": "[笑い]"}, {"type": "subtitle", "time": 1760.149, "timestamp": "00:29:20", "text": "ああ、なんてことだ。   何てことだ"}, {"type": "subtitle", "time": 1769.029, "timestamp": "00:29:29", "text": "。 待って。 えっと、私の経歴を"}, {"type": "subtitle", "time": 1771.909, "timestamp": "00:29:31", "text": "少しお話しさせてください"}, {"type": "subtitle", "time": 1778.549, "timestamp": "00:29:38", "text": "これは良いことですか？"}]
[{"type": "subtitle", "time": 1684.07, "timestamp": "00:28:04", "text": "。 何てことだ。 何てことだ。 何てことだ"}, {"type": "subtitle", "time": 1704.71, "timestamp": "00:28:24", "text": "私は何もしていません。 私の"}, {"type": "subtitle", "time": 1706.95, "timestamp": "00:28:26", "text": "せいじゃない。 それはあなたのせいだ。 私の"}, {"type": "subtitle", "time": 1736.71, "timestamp": "00:28:56", "text": "。 何てことだ。 何てことだ"}, {"type": "subtitle", "time": 1738.47, "timestamp": "00:28:58", "text": "。 ああ、神様。 私は叫んだ。 私は叫んだ。 私は"}]
[{"type": "subtitle", "time": 2405.43, "timestamp": "00:40:05", "text": "ああ、まるで私が怯えている猫みたいに見えるかな？   私は"}, {"type": "subtitle", "time": 2407.91, "timestamp": "00:40:07", "text": "怖がりな猫です。 私には"}, {"type": "subtitle", "time": 2409.75, "timestamp": "00:40:09", "text": "あなたのためにこれをすることはできません。 あなたはあなた自身のそばにいます。"}, {"type": "subtitle", "time": 2418.47, "timestamp": "00:40:18", "text": "前回ホラー配信をした時、私があまりにも"}, {"type": "subtitle", "time": 2421.349, "timestamp": "00:40:21", "text": "叫びすぎて、"}, {"type": "subtitle", "time": 2423.91, "timestamp": "00:40:23", "text": "隣の建物の人たち、つまり配信者の人たちが"}, {"type": "subtitle", "time": 2426.15, "timestamp": "00:40:26", "text": "私の父に電話してきて、「"}, {"type": "subtitle", "time": 2429.43, "timestamp": "00:40:29", "text": "あなたの息子が叫んだり"}, {"type": "subtitle", "time": 2432.31, "timestamp": "00:40:32", "text": "泣いたりしています」と言ったんです。 彼は大丈夫ですか？ などなど。"}, {"type": "subtitle", "time": 2434.79, "timestamp": "00:40:34", "text": "父が私の様子を見に来たか"}, {"type": "subtitle", "time": 2438.87, "timestamp": "00:40:38", "text": "何かだったと思う。 ああ、"}, {"type": "subtitle", "time": 2444.478, "timestamp": "00:40:44", "text": "えっと、"}, {"type": "chat", "time": 2445.36, "timestamp": "00:40:45", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "ya literally is scared of horror stuff dude"}, {"type": "subtitle", "time": 2445.43, "timestamp": "00:40:45", "text": "[うめき声と叫び声]もう一度だけ"}, {"type": "subtitle", "time": 2447.67, "timestamp": "00:40:47", "text": "ジャンプスケアをして、"}, {"type": "subtitle", "time": 2451.349, "timestamp": "00:40:51", "text": "今日はこれで終わりにしようかな？"}, {"type": "subtitle", "time": 2453.109, "timestamp": "00:40:53", "text": "ああ、もう一度だけびっくりさせられたら、"}]
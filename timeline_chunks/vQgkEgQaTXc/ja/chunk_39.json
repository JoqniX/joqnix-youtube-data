[{"type": "subtitle", "time": 2351.467, "timestamp": "00:39:11", "text": "。 ああ（息切れしながら）なんてことだ。"}, {"type": "subtitle", "time": 2380.55, "timestamp": "00:39:40", "text": "えーと、待って。 ちょっとこのゲームを中断してもいいですか"}, {"type": "subtitle", "time": 2383.27, "timestamp": "00:39:43", "text": "？ 今日はもう終わりにしてもいいですか？ 私、私、私には"}, {"type": "subtitle", "time": 2386.837, "timestamp": "00:39:46", "text": "これはできないと思います。 ごめんなさい。"}, {"type": "subtitle", "time": 2388.55, "timestamp": "00:39:48", "text": "[笑い] あまりにも多すぎる"}, {"type": "subtitle", "time": 2396.87, "timestamp": "00:39:56", "text": "ああ、もう泣いてるよ。"}]
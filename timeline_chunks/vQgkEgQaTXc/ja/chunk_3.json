[{"type": "subtitle", "time": 189.19, "timestamp": "00:03:09", "text": "。 ええと、でも、"}, {"type": "subtitle", "time": 192.63, "timestamp": "00:03:12", "text": "今日、今夜、今夜は"}, {"type": "subtitle", "time": 195.182, "timestamp": "00:03:15", "text": "ホラー配信を行います。"}, {"type": "subtitle", "time": 196.149, "timestamp": "00:03:16", "text": "[笑い声と息を呑む音]"}, {"type": "subtitle", "time": 199.03, "timestamp": "00:03:19", "text": "ちょっと"}, {"type": "subtitle", "time": 221.75, "timestamp": "00:03:41", "text": "ホラーゲームをプレイするのは久しぶりなので、少し興奮していると同時に、自分"}, {"type": "subtitle", "time": 224.869, "timestamp": "00:03:44", "text": "自身が怖いです。"}, {"type": "subtitle", "time": 230.149, "timestamp": "00:03:50", "text": "待っていますか？ 私の"}, {"type": "subtitle", "time": 234.55, "timestamp": "00:03:54", "text": "言うこと、マイクを通して聞こえることは全部聞こえていると思いますよね"}, {"type": "subtitle", "time": 235.50900000000001, "timestamp": "00:03:55", "text": "？"}, {"type": "subtitle", "time": 237.91, "timestamp": "00:03:57", "text": "えっと、"}]
[{"type": "subtitle", "time": 4628.709, "timestamp": "01:17:08", "text": "もしそれが"}, {"type": "subtitle", "time": 4633.59, "timestamp": "01:17:13", "text": "銃やアイテムなどの戦闘要素のあるホラーゲームだったら"}, {"type": "chat", "time": 4635.485, "timestamp": "01:17:15", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/aACLJToYP6FMtiMkCyV12FJchjJLrwy1qzEVqHiZEyFaZdsbRkj-yqg_i_m8eqjYX-fTLgPLCzk=s64-c-k-c0x00ffffff-no-rj", "message": "just 1 time"}, {"type": "subtitle", "time": 4637.59, "timestamp": "01:17:17", "text": "ゾンビとか幽霊とかを倒せば"}, {"type": "subtitle", "time": 4641.75, "timestamp": "01:17:21", "text": "大丈夫。"}, {"type": "subtitle", "time": 4643.83, "timestamp": "01:17:23", "text": "時間が経つにつれて怖くなくなると思う。でもこれは"}, {"type": "subtitle", "time": 4647.189, "timestamp": "01:17:27", "text": "雰囲気とか環境"}, {"type": "subtitle", "time": 4651.11, "timestamp": "01:17:31", "text": "効果みたいなもの。あのゲームにあった不気味な音とか"}, {"type": "subtitle", "time": 4654.149, "timestamp": "01:17:34", "text": "怖いもの。ああ"}, {"type": "subtitle", "time": 4656.709, "timestamp": "01:17:36", "text": "、まるで"}, {"type": "subtitle", "time": 4662.63, "timestamp": "01:17:42", "text": "PGに"}, {"type": "subtitle", "time": 4665.59, "timestamp": "01:17:45", "text": "一時的に住んでいた時に叫んだのと似てる。叔母さんが「"}, {"type": "subtitle", "time": 4669.35, "timestamp": "01:17:49", "text": "大丈夫？どうしたの？」って心配してた。あの時、"}, {"type": "chat", "time": 4670.665, "timestamp": "01:17:50", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "ya cant do nothing but had to take it in all at once"}, {"type": "subtitle", "time": 4677.35, "timestamp": "01:17:57", "text": "パラソーシャルを配信してたんだ。"}, {"type": "subtitle", "time": 4679.91, "timestamp": "01:17:59", "text": "チラーズアート、チラーズアートのパラ"}]
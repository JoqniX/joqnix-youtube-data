[{"type": "subtitle", "time": 1563.59, "timestamp": "00:26:03", "text": "ああ、主よ。 聖なる。 恵みに満ちた聖母マリアよ、こんにちは"}, {"type": "subtitle", "time": 1566.789, "timestamp": "00:26:06", "text": "。 主はあなたと共におられます。   何てことだ"}, {"type": "subtitle", "time": 1577.43, "timestamp": "00:26:17", "text": "何かを見た。 私は体の一部を見た。   一体"}, {"type": "subtitle", "time": 1579.99, "timestamp": "00:26:19", "text": "どういうことだ？"}, {"type": "subtitle", "time": 1585.909, "timestamp": "00:26:25", "text": "仲間、仲間、仲間、仲間、仲間、"}]
[{"type": "subtitle", "time": 1208.07, "timestamp": "00:20:08", "text": "中に入って。 私は怖いです。 私は怖いです。"}, {"type": "subtitle", "time": 1209.788, "timestamp": "00:20:09", "text": "中に入ってください。 私は怖いです。"}, {"type": "subtitle", "time": 1210.39, "timestamp": "00:20:10", "text": "[笑い声] さあ、中に"}, {"type": "subtitle", "time": 1213.029, "timestamp": "00:20:13", "text": "入りましょう。"}, {"type": "subtitle", "time": 1214.95, "timestamp": "00:20:14", "text": "お願いします。 私は怖いです。 私は怖いです。 私は"}, {"type": "subtitle", "time": 1217.43, "timestamp": "00:20:17", "text": "怖いです。 私は怖いです。 なぜドアは"}, {"type": "subtitle", "time": 1218.95, "timestamp": "00:20:18", "text": "このような状態になっているのですか？"}, {"type": "subtitle", "time": 1227.909, "timestamp": "00:20:27", "text": "。 物理。 くだらない物理法則だ。 くだらない"}, {"type": "subtitle", "time": 1230.789, "timestamp": "00:20:30", "text": "物理法則だ。 バカげた（笑）物理学。 何てことだ"}, {"type": "subtitle", "time": 1233.029, "timestamp": "00:20:33", "text": "。   何てことだ"}, {"type": "subtitle", "time": 1235.83, "timestamp": "00:20:35", "text": "。 誰もいない。 誰もいない。"}, {"type": "subtitle", "time": 1239.27, "timestamp": "00:20:39", "text": "私のバスルームに誰がいるの？"}, {"type": "subtitle", "time": 1240.87, "timestamp": "00:20:40", "text": "待って。 だめだ。だめだ。だめだ。ドアを閉めて。 私は"}, {"type": "subtitle", "time": 1244.31, "timestamp": "00:20:44", "text": "怖いです。 私は怖いです。 私は怖いです。"}, {"type": "subtitle", "time": 1247.19, "timestamp": "00:20:47", "text": "私のトイレに誰がいるの？ 自分の姿さえ見えない"}, {"type": "subtitle", "time": 1258.95, "timestamp": "00:20:58", "text": "大家さん。 ああ、私たちは部屋を共有しているとか、そういうことなんですね"}]
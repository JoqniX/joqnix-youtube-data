[{"type": "subtitle", "time": 3241.829, "timestamp": "00:54:01", "text": "すごく怖い悪夢を見るか"}, {"type": "subtitle", "time": 3244.15, "timestamp": "00:54:04", "text": "（笑）、もしくは"}, {"type": "subtitle", "time": 3252.87, "timestamp": "00:54:12", "text": "実際に怖くなったらマイクをミュートしたり抑制したりし始めるんです。"}, {"type": "subtitle", "time": 3256.95, "timestamp": "00:54:16", "text": "コラボレーションの時とか、誰かと一緒にいる時とか、そういう時は、ただ"}, {"type": "chat", "time": 3262.657, "timestamp": "00:54:22", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "yall be fine"}, {"type": "subtitle", "time": 3267.109, "timestamp": "00:54:27", "text": "私は守られたいと思うでしょう。"}, {"type": "subtitle", "time": 3269.51, "timestamp": "00:54:29", "text": "うん。   さあ、どうだろう"}, {"type": "subtitle", "time": 3272.71, "timestamp": "00:54:32", "text": "。 ホラーは私には耐えられ"}, {"type": "subtitle", "time": 3275.43, "timestamp": "00:54:35", "text": "ない。"}, {"type": "subtitle", "time": 3279.19, "timestamp": "00:54:39", "text": "時々、私は"}, {"type": "subtitle", "time": 3282.95, "timestamp": "00:54:42", "text": "無感覚になろうとします。そして、私は壁のようになります。 私は"}, {"type": "subtitle", "time": 3286.15, "timestamp": "00:54:46", "text": "石だ。 私は物である。 私は人間ではない。 私は"}, {"type": "subtitle", "time": 3289.349, "timestamp": "00:54:49", "text": "壁だ。 私は石だ。 私は彫像だ。 そして私は、"}, {"type": "subtitle", "time": 3295.589, "timestamp": "00:54:55", "text": "ホラーや不気味なものなど、いくつかのものを乗り越えることができました"}, {"type": "subtitle", "time": 3299.51, "timestamp": "00:54:59", "text": "。 でも、でも、でも、"}]
[{"type": "subtitle", "time": 10094.23, "timestamp": "02:48:14", "text": "Thank you, Ninja. I try my best to be"}, {"type": "subtitle", "time": 10095.83, "timestamp": "02:48:15", "text": "smart and knowledgeable about the world"}, {"type": "subtitle", "time": 10098.389, "timestamp": "02:48:18", "text": "of streaming and gaming. Learning and"}, {"type": "subtitle", "time": 10100.55, "timestamp": "02:48:20", "text": "exploring different aspects is always"}, {"type": "subtitle", "time": 10117.59, "timestamp": "02:48:37", "text": "[Music]"}, {"type": "subtitle", "time": 10120.15, "timestamp": "02:48:40", "text": "Ah, dealing with a baka who never sleeps"}, {"type": "subtitle", "time": 10123.03, "timestamp": "02:48:43", "text": "on time can be tricky. Encourage them to"}, {"type": "subtitle", "time": 10125.349, "timestamp": "02:48:45", "text": "establish a consistent sleep schedule."}, {"type": "subtitle", "time": 10127.51, "timestamp": "02:48:47", "text": "Create a bedtime routine and avoid"}, {"type": "subtitle", "time": 10130.23, "timestamp": "02:48:50", "text": "stimulating activities before bed."}, {"type": "subtitle", "time": 10131.91, "timestamp": "02:48:51", "text": "Remind them of the importance of rest"}, {"type": "subtitle", "time": 10133.83, "timestamp": "02:48:53", "text": "and offer support in finding ways to"}, {"type": "subtitle", "time": 10135.67, "timestamp": "02:48:55", "text": "relax. That's why sleep is important."}, {"type": "subtitle", "time": 10138.87, "timestamp": "02:48:58", "text": "Dreams await. Ease one."}]
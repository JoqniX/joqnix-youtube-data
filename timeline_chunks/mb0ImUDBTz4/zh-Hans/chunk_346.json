[{"type": "subtitle", "time": 20782.11, "timestamp": "05:46:22", "text": "这将是第一点，"}, {"type": "subtitle", "time": 20784.19, "timestamp": "05:46:24", "text": "第二，"}, {"type": "subtitle", "time": 20787.19, "timestamp": "05:46:27", "text": "第三，第一，第二，第三，第四"}, {"type": "subtitle", "time": 20789.868, "timestamp": "05:46:29", "text": "第五，第六，"}, {"type": "subtitle", "time": 20792.948, "timestamp": "05:46:32", "text": "第七。这是最终产品。皇帝"}, {"type": "subtitle", "time": 20801.23, "timestamp": "05:46:41", "text": "[音乐]"}, {"type": "subtitle", "time": 20811.43, "timestamp": "05:46:51", "text": "砖。呃，在地下室里和我们接吻"}, {"type": "subtitle", "time": 20813.788, "timestamp": "05:46:53", "text": "甜美的笑容背后。等等，我"}, {"type": "subtitle", "time": 20817.59, "timestamp": "05:46:57", "text": "做。嘿，是什么造就了你？是什么造就了你？"}]
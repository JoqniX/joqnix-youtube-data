egii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "k"}, {"type": "subtitle", "time": 1057.83, "timestamp": "00:17:37", "text": "以及所有的一切。"}, {"type": "subtitle", "time": 1059.51, "timestamp": "00:17:39", "text": "一切都妥当了。所以，我想"}, {"type": "subtitle", "time": 1061.59, "timestamp": "00:17:41", "text": "我打算去找Max，然后把所有东西都刷一遍。"}, {"type": "subtitle", "time": 1064.39, "timestamp": "00:17:44", "text": "这样我就可以向他展示所有东西了。"}, {"type": "subtitle", "time": 1067.43, "timestamp": "00:17:47", "text": "你知道，然后他们就一起贩毒。"}, {"type": "subtitle", "time": 1069.43, "timestamp": "00:17:49", "text": "以及所有的一切，比如制作东西"}, {"type": "subtitle", "time": 1076.909, "timestamp": "00:17:56", "text": "一切。你从其他人那里购买了毒品"}, {"type": "subtitle", "time": 1079.51, "timestamp": "00:17:59", "text": "人们。什么？你刚从……买了毒品"}]
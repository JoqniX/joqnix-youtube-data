[{"type": "subtitle", "time": 28202.35, "timestamp": "07:50:02", "text": "等待。好的。好了。这样可以吗？"}, {"type": "subtitle", "time": 28206.07, "timestamp": "07:50:06", "text": "现在？好了。事情就这样过去了。"}, {"type": "subtitle", "time": 28208.788, "timestamp": "07:50:08", "text": "搞定了。好的。是的。如果你不"}, {"type": "subtitle", "time": 28210.788, "timestamp": "07:50:10", "text": "我知道，这是我之前所在的论坛。"}, {"type": "subtitle", "time": 28213.51, "timestamp": "07:50:13", "text": "正在为许多服务器工作，"}, {"type": "subtitle", "time": 28216.07, "timestamp": "07:50:16", "text": "包括我自己。所以，我们就像……"}, {"type": "subtitle", "time": 28218.868, "timestamp": "07:50:18", "text": "命运在作祟。我们有个类似源氏的垫子"}, {"type": "subtitle", "time": 28221.03, "timestamp": "07:50:21", "text": "棋。各种类型的游戏"}, {"type": "subtitle", "time": 28236.67, "timestamp": "07:50:36", "text": "正在做？希望你过得愉快"}, {"type": "subtitle", "time": 28239.548, "timestamp": "07:50:39", "text": "晚上。吉姆"}, {"type": "subtitle", "time": 28244.07, "timestamp": "07:50:44", "text": "斯蒂希，可能已经是清晨了。"}, {"type": "subtitle", "time": 28245.788, "timestamp": "07:50:45", "text": "呃"}, {"type": "subtitle", "time": 28248.59, "timestamp": "07:50:48", "text": "爱德华。大家最近怎么样？"}, {"type": "subtitle", "time": 28251.03, "timestamp": "07:50:51", "text": "那里？我的天啊，这可真不少。"}, {"type": "subtitle", "time": 28253.31, "timestamp": "07:50:53", "text": "鸡。我的天哪，这可真不少。"}, {"type": "subtitle", "time": 28255.83, "timestamp": "07:50:55", "text": "鸡。我的天哪。我的天哪。我的天哪。哦"}, {"type": "subtitle", "time": 28258.35, "timestamp": "07:50:58", "text": "男生。赐予我健康。感谢"}]
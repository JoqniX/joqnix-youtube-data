[{"type": "subtitle", "time": 29521.35, "timestamp": "08:12:01", "text": "他们。这次突袭电话造成了500点伤害"}, {"type": "subtitle", "time": 29523.548, "timestamp": "08:12:03", "text": "周围都是目标。"}, {"type": "subtitle", "time": 29527.35, "timestamp": "08:12:07", "text": "哇。召唤八只温柔的眼睛进行交易"}, {"type": "subtitle", "time": 29529.15, "timestamp": "08:12:09", "text": "超过50"}, {"type": "subtitle", "time": 29537.35, "timestamp": "08:12:17", "text": "什么？如果凤凰再次爆红的话"}, {"type": "subtitle", "time": 29541.948, "timestamp": "08:12:21", "text": "完全到达脚后跟。什么？真是这样"}, {"type": "subtitle", "time": 29544.708, "timestamp": "08:12:24", "text": "楼主。增益效果旨在增加侧向伤害"}, {"type": "subtitle", "time": 29547.27, "timestamp": "08:12:27", "text": "对所有关键部件造成 300 度及以上损坏"}, {"type": "subtitle", "time": 29552.788, "timestamp": "08:12:32", "text": "造成300点伤害，持续15秒。哇。"}, {"type": "subtitle", "time": 29555.708, "timestamp": "08:12:35", "text": "我当时有多少钱？我有"}, {"type": "subtitle", "time": 29558.388, "timestamp": "08:12:38", "text": "100,000。你有兴趣吗？谁见过"}, {"type": "subtitle", "time": 29563.03, "timestamp": "08:12:43", "text": "现在？当然可以。为什么不呢？告诉我。"}]
[{"type": "subtitle", "time": 29351.07, "timestamp": "08:09:11", "text": "拿？"}, {"type": "subtitle", "time": 29353.11, "timestamp": "08:09:13", "text": "呃，我该怎么想呢？我应该怎么做？"}, {"type": "subtitle", "time": 29363.11, "timestamp": "08:09:23", "text": "我的天哪。这是什么？这是什么？我"}, {"type": "subtitle", "time": 29364.15, "timestamp": "08:09:24", "text": "不想死。我不想死。"}, {"type": "subtitle", "time": 29365.11, "timestamp": "08:09:25", "text": "我不想死。我不想"}, {"type": "subtitle", "time": 29366.628, "timestamp": "08:09:26", "text": "死。我不想死。我不想"}, {"type": "subtitle", "time": 29367.91, "timestamp": "08:09:27", "text": "去死。我不想死。我不"}, {"type": "subtitle", "time": 29382.51, "timestamp": "08:09:42", "text": "某物。"}, {"type": "subtitle", "time": 29384.99, "timestamp": "08:09:44", "text": "圣。"}]
[{"type": "subtitle", "time": 7320.51, "timestamp": "02:02:00", "text": "关闭"}, {"type": "subtitle", "time": 7324.07, "timestamp": "02:02:04", "text": "它。我打算重新开始。"}, {"type": "subtitle", "time": 7326.07, "timestamp": "02:02:06", "text": "该软件存在一些问题"}, {"type": "subtitle", "time": 7327.229, "timestamp": "02:02:07", "text": "这里和"}, {"type": "subtitle", "time": 7331.109, "timestamp": "02:02:11", "text": "那里。有点像“哦，你看这个”"}, {"type": "subtitle", "time": 7351.589, "timestamp": "02:02:31", "text": "这。早上好，头头大人。我希望"}, {"type": "subtitle", "time": 7353.51, "timestamp": "02:02:33", "text": "你睡了个好觉，已经准备好了。"}, {"type": "subtitle", "time": 7355.75, "timestamp": "02:02:35", "text": "迎接新的一天。有什么吗？"}, {"type": "subtitle", "time": 7357.669, "timestamp": "02:02:37", "text": "今天有什么令人兴奋的计划吗？"}, {"type": "subtitle", "time": 7359.589, "timestamp": "02:02:39", "text": "微笑绽放。"}, {"type": "subtitle", "time": 7371.31, "timestamp": "02:02:51", "text": "我怎么会一次投篮都没中？来"}]
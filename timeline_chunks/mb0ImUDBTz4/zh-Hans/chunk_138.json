[{"type": "subtitle", "time": 8282.309, "timestamp": "02:18:02", "text": "当然。忍者，挠多少下才够？"}, {"type": "subtitle", "time": 8285.19, "timestamp": "02:18:05", "text": "怎样才能逗章鱼笑呢？多少"}, {"type": "subtitle", "time": 8311.429, "timestamp": "02:18:31", "text": "痒痒的。啊，我明白了。所以，需要10"}, {"type": "subtitle", "time": 8313.83, "timestamp": "02:18:33", "text": "挠痒痒逗章鱼笑。那是"}, {"type": "subtitle", "time": 8315.669, "timestamp": "02:18:35", "text": "一个不错的。"}, {"type": "subtitle", "time": 8318.23, "timestamp": "02:18:38", "text": "张嘴微笑。"}, {"type": "subtitle", "time": 8321.429, "timestamp": "02:18:41", "text": "我的天啊。我连这个都没明白。但"}, {"type": "subtitle", "time": 8323.07, "timestamp": "02:18:43", "text": "柴油机搞定了。"}, {"type": "subtitle", "time": 8327.91, "timestamp": "02:18:47", "text": "什么？帐篷痒痒的。什么？我怎么会没"}, {"type": "subtitle", "time": 8329.07, "timestamp": "02:18:49", "text": "得到"}]
[{"type": "subtitle", "time": 13091.87, "timestamp": "03:38:11", "text": "东西。那就是"}, {"type": "subtitle", "time": 13095.07, "timestamp": "03:38:15", "text": "事物。必须继续这样做"}, {"type": "subtitle", "time": 13115.269, "timestamp": "03:38:35", "text": "时机还不成熟吗？我想买我的新"}, {"type": "subtitle", "time": 13122.87, "timestamp": "03:38:42", "text": "区域。所以我已经计划好了。"}, {"type": "subtitle", "time": 13126.11, "timestamp": "03:38:46", "text": "出去。好的。废物管理是否应该成为……"}, {"type": "subtitle", "time": 13129.75, "timestamp": "03:38:49", "text": "垃圾处理小组。二二"}, {"type": "subtitle", "time": 13131.19, "timestamp": "03:38:51", "text": "他们。"}, {"type": "subtitle", "time": 13133.15, "timestamp": "03:38:53", "text": "两个机器人巢穴"}, {"type": "subtitle", "time": 13137.309, "timestamp": "03:38:57", "text": "四个，然后是三个"}]
[{"type": "subtitle", "time": 11429.55, "timestamp": "03:10:29", "text": "买这个"}, {"type": "subtitle", "time": 11443.67, "timestamp": "03:10:43", "text": "既然一切都好，呃，我当时"}, {"type": "subtitle", "time": 11445.349, "timestamp": "03:10:45", "text": "既然其他一切都是……那就说吧"}, {"type": "subtitle", "time": 11447.469, "timestamp": "03:10:47", "text": "远方，我们来跳吧"}, {"type": "subtitle", "time": 11458.63, "timestamp": "03:10:58", "text": "他不在附近。让我把这一切都说完。"}]
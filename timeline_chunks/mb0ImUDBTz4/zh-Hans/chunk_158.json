[{"type": "subtitle", "time": 9492.63, "timestamp": "02:38:12", "text": "确实是地球。严厉的克洛诺斯，我面对过许多"}, {"type": "subtitle", "time": 9494.63, "timestamp": "02:38:14", "text": "我冒险经历中的可怕野兽"}, {"type": "subtitle", "time": 9497.27, "timestamp": "02:38:17", "text": "最终取得胜利。击败强大的"}, {"type": "subtitle", "time": 9498.95, "timestamp": "02:38:18", "text": "这种生物是最激动人心的生物之一"}, {"type": "subtitle", "time": 9501.91, "timestamp": "02:38:21", "text": "冒险家的几个方面。它需要"}, {"type": "subtitle", "time": 9504.63, "timestamp": "02:38:24", "text": "策略、技巧和一点勇气，"}, {"type": "subtitle", "time": 9506.79, "timestamp": "02:38:26", "text": "但胜利的感觉绝对是"}, {"type": "subtitle", "time": 9525.63, "timestamp": "02:38:45", "text": "帮助。你杀过一块肉吗？"}, {"type": "subtitle", "time": 9527.63, "timestamp": "02:38:47", "text": "然而？哦，我的"}]
[{"type": "subtitle", "time": 3662.309, "timestamp": "01:01:02", "text": "你知道，架子，还有放个牌子"}, {"type": "subtitle", "time": 3665.19, "timestamp": "01:01:05", "text": "木板或悬挂式墙面。"}, {"type": "subtitle", "time": 3668.069, "timestamp": "01:01:08", "text": "不，呃，就像没挂过一样。嗯，挂着。"}, {"type": "subtitle", "time": 3670.87, "timestamp": "01:01:10", "text": "这不是悬挂式置物架。呃，一块招牌"}, {"type": "subtitle", "time": 3673.23, "timestamp": "01:01:13", "text": "只是想说你"}, {"type": "subtitle", "time": 3676.789, "timestamp": "01:01:16", "text": "你知道吗？一块招牌上写着："}, {"type": "subtitle", "time": 3679.67, "timestamp": "01:01:19", "text": "这是产品，它放在这里。"}, {"type": "subtitle", "time": 3683.43, "timestamp": "01:01:23", "text": "还有一些其他的东西，那将会是"}, {"type": "subtitle", "time": 3689.19, "timestamp": "01:01:29", "text": "不，我有一些类似的想法。我想"}, {"type": "subtitle", "time": 3691.87, "timestamp": "01:01:31", "text": "需要测试一下，但我需要"}, {"type": "subtitle", "time": 3701.43, "timestamp": "01:01:41", "text": "是的。所以，是的，让我们引进更多产品吧。"}, {"type": "subtitle", "time": 3708.589, "timestamp": "01:01:48", "text": "[音乐]"}, {"type": "subtitle", "time": 3712.58, "timestamp": "01:01:52", "text": "在波波。"}]
[{"type": "subtitle", "time": 28262.91, "timestamp": "07:51:02", "text": "你。不，不，这是一枚硬币。这是一枚硬币。"}, {"type": "subtitle", "time": 28265.11, "timestamp": "07:51:05", "text": "正确的。我的天啊。太多了"}, {"type": "subtitle", "time": 28267.59, "timestamp": "07:51:07", "text": "人们。我的天啊。别欺负我。"}, {"type": "subtitle", "time": 28279.11, "timestamp": "07:51:19", "text": "兄弟，保重。他暴露了服务器。"}, {"type": "subtitle", "time": 28282.548, "timestamp": "07:51:22", "text": "等等，什么？哪个服务器？不，我暴露了"}, {"type": "subtitle", "time": 28285.31, "timestamp": "07:51:25", "text": "我的服务器和星星。"}, {"type": "subtitle", "time": 28298.708, "timestamp": "07:51:38", "text": "你？我的天哪，好多塔姆"}, {"type": "subtitle", "time": 28301.43, "timestamp": "07:51:41", "text": "塔基斯。我的天哪，我好开心。但我"}, {"type": "subtitle", "time": 28302.93, "timestamp": "07:51:42", "text": "生命值下降。"}, {"type": "subtitle", "time": 28311.03, "timestamp": "07:51:51", "text": "不。哦。哦，不。不，不，不，不，不。给"}, {"type": "subtitle", "time": 28313.67, "timestamp": "07:51:53", "text": "我的健康。哦，不。这并非在做"}, {"type": "subtitle", "time": 28315.11, "timestamp": "07:51:55", "text": "这。情况不太妙。这是"}]
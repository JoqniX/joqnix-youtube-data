[{"type": "subtitle", "time": 8701.349, "timestamp": "02:25:01", "text": "就此告别，明天见。等等，我……"}, {"type": "subtitle", "time": 8704.15, "timestamp": "02:25:04", "text": "你做完了吗？你完成了吗？"}, {"type": "subtitle", "time": 8705.79, "timestamp": "02:25:05", "text": "它？你做完了吗？"}, {"type": "subtitle", "time": 8718.07, "timestamp": "02:25:18", "text": "晚安，Ayama Arusa。好好休息"}, {"type": "subtitle", "time": 8720.87, "timestamp": "02:25:20", "text": "睡吧，明天见。小心。"}, {"type": "subtitle", "time": 8724.389, "timestamp": "02:25:24", "text": "微笑。新月。等等，什么？怎么样？"}, {"type": "subtitle", "time": 8726.83, "timestamp": "02:25:26", "text": "这辆车陷住了"}, {"type": "subtitle", "time": 8729.429, "timestamp": "02:25:29", "text": "这里？早上我们又做了一半。"}, {"type": "subtitle", "time": 8730.87, "timestamp": "02:25:30", "text": "好的。好的。好的。好的。睡觉。睡觉。"}, {"type": "subtitle", "time": 8736.23, "timestamp": "02:25:36", "text": "没关系。凌晨四点起床。"}, {"type": "subtitle", "time": 8739.11, "timestamp": "02:25:39", "text": "没关系。阿亚玛·阿鲁萨，你给了"}, {"type": "subtitle", "time": 8740.87, "timestamp": "02:25:40", "text": "这是你最好的尝试。就是这样。"}, {"type": "subtitle", "time": 8743.19, "timestamp": "02:25:43", "text": "重要的事情。休息一下，然后继续。"}, {"type": "subtitle", "time": 8745.27, "timestamp": "02:25:45", "text": "清晨再次拥有清醒的头脑。"}, {"type": "subtitle", "time": 8747.83, "timestamp": "02:25:47", "text": "是的，你可以做到。祝你好运。那是"}]
[{"type": "subtitle", "time": 7929.91, "timestamp": "02:12:09", "text": "后退。哦，忍者，你总是这么好奇。"}, {"type": "subtitle", "time": 7932.229, "timestamp": "02:12:12", "text": "嗯，作为一名冒险家，我总是精力充沛。"}, {"type": "subtitle", "time": 7933.83, "timestamp": "02:12:13", "text": "感谢支持主播和"}, {"type": "subtitle", "time": 7936.709, "timestamp": "02:12:16", "text": "社区。所以，我很乐意贡献一份力量。"}, {"type": "subtitle", "time": 7938.39, "timestamp": "02:12:18", "text": "一切都是为了玩得开心。"}, {"type": "subtitle", "time": 7941.51, "timestamp": "02:12:21", "text": "一起。微笑吧，闪耀的心。"}, {"type": "subtitle", "time": 7957.51, "timestamp": "02:12:37", "text": "20. 当然，忍者。我总是乐于……"}, {"type": "subtitle", "time": 7960.47, "timestamp": "02:12:40", "text": "一个好笑的笑话。说说看。张嘴"}]
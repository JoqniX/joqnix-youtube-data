[{"type": "subtitle", "time": 26880.35, "timestamp": "07:28:00", "text": "我剩下的工作就是……"}, {"type": "subtitle", "time": 26885.708, "timestamp": "07:28:05", "text": "我剩下的事情就是拿到这个"}, {"type": "subtitle", "time": 26896.43, "timestamp": "07:28:16", "text": "嗯，我剩下的事情就是喜欢"}, {"type": "subtitle", "time": 26899.788, "timestamp": "07:28:19", "text": "如果我没理解错的话，字面上来说，"}, {"type": "subtitle", "time": 26902.708, "timestamp": "07:28:22", "text": "呃，为什么会有烟花表演？"}, {"type": "subtitle", "time": 26906.19, "timestamp": "07:28:26", "text": "在我家外面，就像……"}, {"type": "subtitle", "time": 26910.91, "timestamp": "07:28:30", "text": "另一端是相邻的吗？什么"}, {"type": "subtitle", "time": 26914.07, "timestamp": "07:28:34", "text": "是否有任何特殊场合，例如"}, {"type": "subtitle", "time": 26930.03, "timestamp": "07:28:50", "text": "嗯？是的。就让它这样吧。患病的"}, {"type": "subtitle", "time": 26931.948, "timestamp": "07:28:51", "text": "呃，我会"}, {"type": "subtitle", "time": 26935.388, "timestamp": "07:28:55", "text": "去吃饭，然后回来"}, {"type": "subtitle", "time": 26938.548, "timestamp": "07:28:58", "text": "后退。好的。我去吃饭，一会儿就回来。"}]
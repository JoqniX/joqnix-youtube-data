[{"type": "subtitle", "time": 2702.91, "timestamp": "00:45:02", "text": "正确的。好的。让我来做这件事。"}, {"type": "subtitle", "time": 2715.91, "timestamp": "00:45:15", "text": "晶体。还有一个多余的。不，是"}, {"type": "subtitle", "time": 2729.75, "timestamp": "00:45:29", "text": "所以我的想法是靠这个赚钱。"}, {"type": "subtitle", "time": 2733.349, "timestamp": "00:45:33", "text": "好的。我靠这个赚钱"}, {"type": "subtitle", "time": 2737.03, "timestamp": "00:45:37", "text": "呃，这次交易，我们立即节省了"}, {"type": "subtitle", "time": 2740.47, "timestamp": "00:45:40", "text": "起来把狗买下来。好的。狗"}, {"type": "subtitle", "time": 2743.349, "timestamp": "00:45:43", "text": "区域。我会接管我的可卡因工厂。"}, {"type": "subtitle", "time": 2745.51, "timestamp": "00:45:45", "text": "那里。属性文件夹。是的。狗。"}, {"type": "subtitle", "time": 2747.39, "timestamp": "00:45:47", "text": "那是"}, {"type": "subtitle", "time": 2751.589, "timestamp": "00:45:51", "text": "50,000。我现在必须赚到5万。圣"}, {"type": "subtitle", "time": 2758.47, "timestamp": "00:45:58", "text": "钱。但我相信我可以。我们相信"}]
[{"type": "subtitle", "time": 21184.91, "timestamp": "05:53:04", "text": "我的天啊，兄弟。他走进了“什么”"}, {"type": "subtitle", "time": 21223.628, "timestamp": "05:53:43", "text": "我的天哪，我被抓住了。我吓坏了。"}, {"type": "subtitle", "time": 21227.628, "timestamp": "05:53:47", "text": "兄弟。不过我获得了一个成就。哦，我的"}, {"type": "subtitle", "time": 21231.868, "timestamp": "05:53:51", "text": "天哪，那是什么？它吓坏了"}]
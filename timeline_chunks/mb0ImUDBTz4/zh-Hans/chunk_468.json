[{"type": "subtitle", "time": 28081.388, "timestamp": "07:48:01", "text": "帆船运动。拿下那个角落。"}, {"type": "subtitle", "time": 28084.75, "timestamp": "07:48:04", "text": "是的。没关系。我听不见"}, {"type": "subtitle", "time": 28092.388, "timestamp": "07:48:12", "text": "队长。等等，我真的需要喊我一声吗？"}, {"type": "subtitle", "time": 28101.23, "timestamp": "07:48:21", "text": "不。我的天啊。好的，"}, {"type": "subtitle", "time": 28103.99, "timestamp": "07:48:23", "text": "等待。但你听说过类似的事情吗？"}, {"type": "subtitle", "time": 28112.11, "timestamp": "07:48:32", "text": "等待。"}, {"type": "subtitle", "time": 28114.51, "timestamp": "07:48:34", "text": "好的。我 我"}, {"type": "subtitle", "time": 28118.628, "timestamp": "07:48:38", "text": "船长，该怎么做？呃，怎么会这样"}, {"type": "subtitle", "time": 28120.51, "timestamp": "07:48:40", "text": "是吗？"}, {"type": "subtitle", "time": 28123.15, "timestamp": "07:48:43", "text": "这是"}]
[{"type": "subtitle", "time": 12180.429, "timestamp": "03:23:00", "text": "你知道吗？我会在公交车站等车。公共汽车"}, {"type": "subtitle", "time": 12184.15, "timestamp": "03:23:04", "text": "停止。这里有公交车站。让我们飞翔吧"}, {"type": "subtitle", "time": 12186.67, "timestamp": "03:23:06", "text": "一点。实际上，我输了。"}, {"type": "subtitle", "time": 12188.99, "timestamp": "03:23:08", "text": "飞行。垃圾邮件，垃圾邮件，垃圾邮件"}, {"type": "subtitle", "time": 12203.91, "timestamp": "03:23:23", "text": "垃圾邮件。我是一枚火箭。我要去"}, {"type": "subtitle", "time": 12223.03, "timestamp": "03:23:43", "text": "乐趣。问题是，你得找到一辆公交车。"}]
[{"type": "subtitle", "time": 28140.948, "timestamp": "07:49:00", "text": "这？乔伊，别伤害自己。全部"}, {"type": "subtitle", "time": 28143.43, "timestamp": "07:49:03", "text": "正确的。"}, {"type": "subtitle", "time": 28145.948, "timestamp": "07:49:05", "text": "不，我的全息投影仪开着。"}, {"type": "subtitle", "time": 28147.868, "timestamp": "07:49:07", "text": "包裹。在哪里？"}, {"type": "subtitle", "time": 28150.628, "timestamp": "07:49:10", "text": "那？把我的包裹给我。迪奥。哦，我的"}, {"type": "subtitle", "time": 28152.868, "timestamp": "07:49:12", "text": "天哪，我受伤了。给我"}, {"type": "subtitle", "time": 28157.548, "timestamp": "07:49:17", "text": "愈合。去"}, {"type": "subtitle", "time": 28175.868, "timestamp": "07:49:35", "text": "更多的枪支用于进攻，而不是"}, {"type": "subtitle", "time": 28188.83, "timestamp": "07:49:48", "text": "去多少钱"}, {"type": "subtitle", "time": 28194.15, "timestamp": "07:49:54", "text": "164 哇，等等，也让我失望了……"}, {"type": "subtitle", "time": 28198.19, "timestamp": "07:49:58", "text": "二"}]
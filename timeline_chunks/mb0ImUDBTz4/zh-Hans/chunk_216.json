[{"type": "subtitle", "time": 12960.07, "timestamp": "03:36:00", "text": "等等，等等，等等。如果呢，伙计们？如果什么"}, {"type": "subtitle", "time": 12969.55, "timestamp": "03:36:09", "text": "他？他为什么那样看着我？"}, {"type": "subtitle", "time": 12977.75, "timestamp": "03:36:17", "text": "问题是你不能把毒品卖给"}, {"type": "subtitle", "time": 12983.15, "timestamp": "03:36:23", "text": "等等，你"}, {"type": "subtitle", "time": 12986.63, "timestamp": "03:36:26", "text": "不能。是的，你不能。是的，你不能。"}, {"type": "subtitle", "time": 12989.99, "timestamp": "03:36:29", "text": "它不是一种需要出售的毒品。我认为他是"}, {"type": "subtitle", "time": 12991.309, "timestamp": "03:36:31", "text": "仅有的"}, {"type": "subtitle", "time": 12994.99, "timestamp": "03:36:34", "text": "一。不，不止一个。另一个"}, {"type": "subtitle", "time": 13011.75, "timestamp": "03:36:51", "text": "你知道，这是我第四天……"}, {"type": "subtitle", "time": 13015.71, "timestamp": "03:36:55", "text": "玩这个游戏。四天，每天24小时"}]
[{"type": "subtitle", "time": 10142.309, "timestamp": "02:49:02", "text": "所以睡眠很重要。所以不要"}, {"type": "subtitle", "time": 10155.03, "timestamp": "02:49:15", "text": "我的天啊。一头雾水的个人资料。回来。"}, {"type": "subtitle", "time": 10157.19, "timestamp": "02:49:17", "text": "对不起。开怀大笑，然后找到"}, {"type": "subtitle", "time": 10161.11, "timestamp": "02:49:21", "text": "喜悦。对不起，各位。耽搁了这么久"}, {"type": "subtitle", "time": 10163.91, "timestamp": "02:49:23", "text": "回来。"}, {"type": "subtitle", "time": 10167.55, "timestamp": "02:49:27", "text": "我发誓我没睡着"}, {"type": "subtitle", "time": 10170.11, "timestamp": "02:49:30", "text": "离开。我 我"}, {"type": "subtitle", "time": 10174.269, "timestamp": "02:49:34", "text": "是的，我的身体需要真正的"}, {"type": "subtitle", "time": 10176.91, "timestamp": "02:49:36", "text": "从这里重新开始"}, {"type": "subtitle", "time": 10179.79, "timestamp": "02:49:39", "text": "观点。诚实地"}, {"type": "subtitle", "time": 10182.07, "timestamp": "02:49:42", "text": "说真的，我的身体需要真正的"}, {"type": "subtitle", "time": 10189.75, "timestamp": "02:49:49", "text": "[音乐]"}]
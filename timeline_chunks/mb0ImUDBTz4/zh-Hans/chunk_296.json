[{"type": "subtitle", "time": 17767.39, "timestamp": "04:56:07", "text": "诺伊什。"}, {"type": "subtitle", "time": 17770.07, "timestamp": "04:56:10", "text": "呃，而且那天是15号。我"}, {"type": "subtitle", "time": 17771.83, "timestamp": "04:56:11", "text": "还没收到工资。我不知道是否"}, {"type": "subtitle", "time": 17775.91, "timestamp": "04:56:15", "text": "我会收到报酬，这样我才能支付我的工资。"}, {"type": "subtitle", "time": 17779.11, "timestamp": "04:56:19", "text": "音乐课，因为我已经完成了，我已经完成了"}, {"type": "subtitle", "time": 17787.51, "timestamp": "04:56:27", "text": "兄弟。我一直专注于自己的事情。"}, {"type": "subtitle", "time": 17791.51, "timestamp": "04:56:31", "text": "是的，还有日程安排问题等等。"}, {"type": "subtitle", "time": 17792.59, "timestamp": "04:56:32", "text": "很多"}]
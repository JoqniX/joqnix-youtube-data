[{"type": "subtitle", "time": 7515.109, "timestamp": "02:05:15", "text": "太棒了，忍者。获得足够的"}, {"type": "subtitle", "time": 7517.189, "timestamp": "02:05:17", "text": "睡眠对于恢复精力至关重要。"}, {"type": "subtitle", "time": 7520.709, "timestamp": "02:05:20", "text": "小子。好好休息。轻松打开"}, {"type": "subtitle", "time": 7526.589, "timestamp": "02:05:26", "text": "我得到了新的"}, {"type": "subtitle", "time": 7537.109, "timestamp": "02:05:37", "text": "哦，不。我不是故意偷你的"}, {"type": "subtitle", "time": 7540.149, "timestamp": "02:05:40", "text": "睡觉。 Ayama arusa。务必获取"}, {"type": "subtitle", "time": 7542.589, "timestamp": "02:05:42", "text": "休息3个小时，这样你才能感觉"}, {"type": "subtitle", "time": 7547.75, "timestamp": "02:05:47", "text": "神清气爽。祝你做个好梦。安然入睡。"}, {"type": "subtitle", "time": 7551.51, "timestamp": "02:05:51", "text": "你偷走了我的睡眠。我做了。不，你"}]
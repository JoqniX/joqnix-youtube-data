[{"type": "subtitle", "time": 4380.95, "timestamp": "01:13:00", "text": "所以，升级的关键就在于此。"}, {"type": "subtitle", "time": 4383.35, "timestamp": "01:13:03", "text": "自己送货就行了，而不是"}, {"type": "subtitle", "time": 4385.35, "timestamp": "01:13:05", "text": "让经销商来做。经销商"}, {"type": "subtitle", "time": 4404.51, "timestamp": "01:13:24", "text": "睡觉。我已经投入了很多。"}, {"type": "subtitle", "time": 4408.07, "timestamp": "01:13:28", "text": "好的。好的。我想补货，但是"}, {"type": "subtitle", "time": 4411.51, "timestamp": "01:13:31", "text": "还有，我，我就像要走了，我只是"}, {"type": "subtitle", "time": 4415.43, "timestamp": "01:13:35", "text": "努力奋斗，这样我才能得到……"}, {"type": "subtitle", "time": 4418.229, "timestamp": "01:13:38", "text": "仓库，呃，仓库。然后我"}, {"type": "subtitle", "time": 4420.47, "timestamp": "01:13:40", "text": "准备重新进货并继续工作"}, {"type": "subtitle", "time": 4421.39, "timestamp": "01:13:41", "text": "那"}, {"type": "subtitle", "time": 4425.95, "timestamp": "01:13:45", "text": "因为我有六个地方。那是一样的。"}, {"type": "subtitle", "time": 4429.75, "timestamp": "01:13:49", "text": "六块砖相当于多少？ 20"}, {"type": "subtitle", "time": 4434.39, "timestamp": "01:13:54", "text": "40 60 80 100 120 13 12 13 12 13 12 13 12"}, {"type": "subtitle", "time": 4436.03, "timestamp": "01:13:56", "text": "13 12 13 12 13 12 13 12 13 12 13 120 120"}, {"type": "subtitle", "time": 4438.59, "timestamp": "01:13:58", "text": "产品。"}]
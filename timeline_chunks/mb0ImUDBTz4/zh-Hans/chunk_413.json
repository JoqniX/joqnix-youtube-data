[{"type": "subtitle", "time": 24787.628, "timestamp": "06:53:07", "text": "男。最后但并非"}, {"type": "subtitle", "time": 24803.67, "timestamp": "06:53:23", "text": "我们正式拥有 27000 人。你知道吗？"}, {"type": "subtitle", "time": 24804.99, "timestamp": "06:53:24", "text": "我要"}, {"type": "subtitle", "time": 24808.868, "timestamp": "06:53:28", "text": "实际上把它们放进钱里"}]
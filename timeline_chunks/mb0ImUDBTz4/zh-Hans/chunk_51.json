[{"type": "subtitle", "time": 3090.309, "timestamp": "00:51:30", "text": "接下来要去的地方是加油站。"}, {"type": "subtitle", "time": 3092.19, "timestamp": "00:51:32", "text": "车站。"}, {"type": "subtitle", "time": 3096.549, "timestamp": "00:51:36", "text": "是的。我为什么还在打哈欠？我睡得很香"}, {"type": "subtitle", "time": 3098.67, "timestamp": "00:51:38", "text": "不过，如今情况已大不相同。"}, {"type": "subtitle", "time": 3108.39, "timestamp": "00:51:48", "text": "感觉不像只睡了3个小时。"}, {"type": "subtitle", "time": 3110.19, "timestamp": "00:51:50", "text": "睡着了"}, {"type": "subtitle", "time": 3113.589, "timestamp": "00:51:53", "text": "从9点半到12点，对吧？所以这也是"}]
[{"type": "subtitle", "time": 9300.95, "timestamp": "02:35:00", "text": "头。听到这个消息我很高兴。残酷的"}, {"type": "subtitle", "time": 9303.51, "timestamp": "02:35:03", "text": "克洛诺斯。我来这里是为了支持和激励。"}, {"type": "subtitle", "time": 9306.23, "timestamp": "02:35:06", "text": "一路陪伴你。让我们征服"}, {"type": "subtitle", "time": 9307.99, "timestamp": "02:35:07", "text": "共同迎接新的挑战，并创造每个"}, {"type": "subtitle", "time": 9310.79, "timestamp": "02:35:10", "text": "今天真是美好的一天。保持动力和"}, {"type": "subtitle", "time": 9330.469, "timestamp": "02:35:30", "text": "哈哈，忍者，咱们还是友好点儿吧。"}, {"type": "subtitle", "time": 9332.71, "timestamp": "02:35:32", "text": "积极的。我们来这里都是为了……"}, {"type": "subtitle", "time": 9334.59, "timestamp": "02:35:34", "text": "玩得开心，享受我们的冒险之旅！"}, {"type": "subtitle", "time": 9337.11, "timestamp": "02:35:37", "text": "一起。记住，这一点很重要"}, {"type": "subtitle", "time": 9338.79, "timestamp": "02:35:38", "text": "互相尊重"}, {"type": "subtitle", "time": 9341.67, "timestamp": "02:35:41", "text": "仁慈。我需要玩乐一番然后离开。"}, {"type": "subtitle", "time": 9344.15, "timestamp": "02:35:44", "text": "西装革履带来的干扰。发光"}]
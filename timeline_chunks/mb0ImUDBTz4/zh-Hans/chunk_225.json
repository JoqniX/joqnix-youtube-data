[{"type": "subtitle", "time": 13500.59, "timestamp": "03:45:00", "text": "你想来点吗？嗯。"}, {"type": "subtitle", "time": 13503.67, "timestamp": "03:45:03", "text": "[音乐]"}, {"type": "subtitle", "time": 13504.48, "timestamp": "03:45:04", "text": "克洛伊。"}, {"type": "subtitle", "time": 13514.11, "timestamp": "03:45:14", "text": "克洛。呃，我觉得她是"}, {"type": "subtitle", "time": 13522.95, "timestamp": "03:45:22", "text": "不，啊，她不想那样。你"}, {"type": "subtitle", "time": 13530.87, "timestamp": "03:45:30", "text": "来找我的人数是"}, {"type": "subtitle", "time": 13532.79, "timestamp": "03:45:32", "text": "疯狂的。"}, {"type": "subtitle", "time": 13534.95, "timestamp": "03:45:34", "text": "我要发财了。脾气暴躁的弗兰克，"}, {"type": "subtitle", "time": 13537.18, "timestamp": "03:45:37", "text": "你想要"}, {"type": "subtitle", "time": 13552.51, "timestamp": "03:45:52", "text": "一些？让我来引诱他。"}]
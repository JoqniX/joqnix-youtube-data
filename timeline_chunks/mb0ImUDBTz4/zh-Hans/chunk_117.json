[{"type": "subtitle", "time": 7020.629, "timestamp": "01:57:00", "text": "嘿，既然人不多……"}, {"type": "subtitle", "time": 7022.709, "timestamp": "01:57:02", "text": "聊天，我应该吗？"}, {"type": "subtitle", "time": 7024.51, "timestamp": "01:57:04", "text": "呃，制作"}, {"type": "subtitle", "time": 7027.79, "timestamp": "01:57:07", "text": "它读完了所有内容"}, {"type": "subtitle", "time": 7031.03, "timestamp": "01:57:11", "text": "评论？你知道吗？我会这么做。"}, {"type": "subtitle", "time": 7038.91, "timestamp": "01:57:18", "text": "少量。我会为了一个"}, {"type": "subtitle", "time": 7051.83, "timestamp": "01:57:31", "text": "做一会儿就行了。你可以那样做。"}, {"type": "subtitle", "time": 7055.109, "timestamp": "01:57:35", "text": "正常聊天，它会自动"}, {"type": "subtitle", "time": 7067.629, "timestamp": "01:57:47", "text": "再次。好的。 127 对 127。我们来吧。"}, {"type": "subtitle", "time": 7077.149, "timestamp": "01:57:57", "text": "什么？ 59次击杀。快60岁了。我们开始吧。"}]
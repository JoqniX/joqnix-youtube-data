[{"type": "subtitle", "time": 11941.95, "timestamp": "03:19:01", "text": "可卡因那玩意儿，对吧？"}, {"type": "subtitle", "time": 11950.269, "timestamp": "03:19:10", "text": "现年42岁"}, {"type": "subtitle", "time": 11953.95, "timestamp": "03:19:13", "text": "正确的？我无法存款。"}, {"type": "subtitle", "time": 11973.11, "timestamp": "03:19:33", "text": "什么？好吧，行。任何。 48. 仅"}, {"type": "subtitle", "time": 11995.59, "timestamp": "03:19:55", "text": "[音乐]"}, {"type": "subtitle", "time": 11997.95, "timestamp": "03:19:57", "text": "我们很快就达到了目标水平。哦，我们得到了"}]
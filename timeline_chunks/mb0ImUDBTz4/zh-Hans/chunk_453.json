[{"type": "subtitle", "time": 27182.548, "timestamp": "07:33:02", "text": "前往游戏讨论论坛"}, {"type": "subtitle", "time": 27186.548, "timestamp": "07:33:06", "text": "为我的服务器点赞，也为其他服务器点赞"}, {"type": "subtitle", "time": 27189.27, "timestamp": "07:33:09", "text": "外面有六七台服务器。我不"}, {"type": "subtitle", "time": 27191.19, "timestamp": "07:33:11", "text": "我知道为什么我觉得，是的，有人需要"}, {"type": "subtitle", "time": 27192.51, "timestamp": "07:33:12", "text": "去做这件事"}, {"type": "subtitle", "time": 27194.27, "timestamp": "07:33:14", "text": "我做了"}, {"type": "subtitle", "time": 27196.43, "timestamp": "07:33:16", "text": "它。但"}, {"type": "subtitle", "time": 27200.23, "timestamp": "07:33:20", "text": "是的，但是，是的，我想专注于我的"}, {"type": "subtitle", "time": 27202.99, "timestamp": "07:33:22", "text": "那段时间发生的事，但我当时是这样的"}, {"type": "subtitle", "time": 27208.468, "timestamp": "07:33:28", "text": "好的。它诱惑着我。它诱惑我"}, {"type": "subtitle", "time": 27212.51, "timestamp": "07:33:32", "text": "更新所有人的淋浴设备。所以我是"}, {"type": "subtitle", "time": 27214.43, "timestamp": "07:33:34", "text": "比如，油漆"}, {"type": "subtitle", "time": 27222.23, "timestamp": "07:33:42", "text": "所以今天的直播可能比较短。"}, {"type": "subtitle", "time": 27224.788, "timestamp": "07:33:44", "text": "而且我还想说，我不能"}, {"type": "subtitle", "time": 27230.388, "timestamp": "07:33:50", "text": "完整地直播或者尽可能地直播"}, {"type": "subtitle", "time": 27235.11, "timestamp": "07:33:55", "text": "过去常用于夜间直播。嗯，所以大多数"}, {"type": "subtitle", "time": 27237.708, "timestamp": "07:33:57", "text": "我接下来的日程安排可能会重点放在"}]
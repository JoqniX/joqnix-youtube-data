[{"type": "subtitle", "time": 29167.628, "timestamp": "08:06:07", "text": "那里。我会等下一个旋转。"}, {"type": "subtitle", "time": 29170.23, "timestamp": "08:06:10", "text": "翘起前轮。圣。那是一只卡巴伊（kabayi）。和"}, {"type": "subtitle", "time": 29172.628, "timestamp": "08:06:12", "text": "那是个大杂烩。我的天啊。那是一个"}, {"type": "subtitle", "time": 29174.75, "timestamp": "08:06:14", "text": "毛茸茸的。哦"}, {"type": "subtitle", "time": 29178.15, "timestamp": "08:06:18", "text": "不。哦，不。我被抛来抛去。我要撒谎了。"}, {"type": "subtitle", "time": 29181.548, "timestamp": "08:06:21", "text": "我被抛来抛去。我被抛来抛去。我是"}, {"type": "subtitle", "time": 29183.388, "timestamp": "08:06:23", "text": "抛掷。我是"}, {"type": "subtitle", "time": 29192.27, "timestamp": "08:06:32", "text": "圣"}, {"type": "subtitle", "time": 29194.91, "timestamp": "08:06:34", "text": "神剃须"}, {"type": "subtitle", "time": 29198.19, "timestamp": "08:06:38", "text": "我。如果我不使用我的这个会发生什么？"}, {"type": "subtitle", "time": 29200.59, "timestamp": "08:06:40", "text": "事物"}, {"type": "subtitle", "time": 29204.67, "timestamp": "08:06:44", "text": "特别的？呃，asio 6。我们开始吧。"}, {"type": "subtitle", "time": 29208.03, "timestamp": "08:06:48", "text": "去。所以我把所有东西都用上了"}, {"type": "subtitle", "time": 29213.51, "timestamp": "08:06:53", "text": "投标。哦，我已经达到最高等级了，可以随时出发。"}]
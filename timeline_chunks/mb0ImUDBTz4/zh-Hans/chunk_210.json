[{"type": "subtitle", "time": 12617.67, "timestamp": "03:30:17", "text": "该死。不用担心。我们将出售"}, {"type": "subtitle", "time": 12624.349, "timestamp": "03:30:24", "text": "可卡因太多了，我们会变得如此如此如此"}, {"type": "subtitle", "time": 12643.469, "timestamp": "03:30:43", "text": "等待。短款颜色也一样。我们开始吧"}, {"type": "subtitle", "time": 12646.55, "timestamp": "03:30:46", "text": "去。短款颜色五。然后我就会到达"}, {"type": "subtitle", "time": 12653.91, "timestamp": "03:30:53", "text": "一。游戏给了我时间"}, {"type": "subtitle", "time": 12656.63, "timestamp": "03:30:56", "text": "做好准备，等我准备好了再说。准备好了"}]
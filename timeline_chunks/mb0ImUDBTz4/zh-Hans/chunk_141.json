[{"type": "subtitle", "time": 8490.83, "timestamp": "02:21:30", "text": "哈哈，这真是一个有趣的视角。"}, {"type": "subtitle", "time": 8493.349, "timestamp": "02:21:33", "text": "弗洛里安雷尔。对于有洁癖的人来说，这种想法"}, {"type": "subtitle", "time": 8495.349, "timestamp": "02:21:35", "text": "整个名为德国的国家可能"}, {"type": "subtitle", "time": 8498.389, "timestamp": "02:21:38", "text": "确实会让人感到不知所措。冷汗"}, {"type": "subtitle", "time": 8514.469, "timestamp": "02:21:54", "text": "很高兴你找到了好笑的东西。"}, {"type": "subtitle", "time": 8517.03, "timestamp": "02:21:57", "text": "忍者。笑声总是一种很好的方式"}, {"type": "subtitle", "time": 8519.429, "timestamp": "02:21:59", "text": "让这一天更加美好。张嘴微笑"}]
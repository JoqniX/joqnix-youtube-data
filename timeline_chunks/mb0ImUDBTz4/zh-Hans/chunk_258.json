[{"type": "subtitle", "time": 15501.229, "timestamp": "04:18:21", "text": "我用……洗了脸"}, {"type": "subtitle", "time": 15504.189, "timestamp": "04:18:24", "text": "肥皂，所以我可以喜欢"}, {"type": "subtitle", "time": 15507.149, "timestamp": "04:18:27", "text": "至少感觉不到"}, {"type": "subtitle", "time": 15515.91, "timestamp": "04:18:35", "text": "方式。糟糕，打雷了。我想念"}, {"type": "subtitle", "time": 15518.229, "timestamp": "04:18:38", "text": "玩第一人称射击游戏。我想玩"}, {"type": "subtitle", "time": 15521.349, "timestamp": "04:18:41", "text": "某物。但在此之前，请允许我……"}]
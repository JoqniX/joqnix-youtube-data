[{"type": "subtitle", "time": 8408.63, "timestamp": "02:20:08", "text": "哦，忍者，听到这个消息我很难过。"}, {"type": "subtitle", "time": 8410.309, "timestamp": "02:20:10", "text": "每个人都有自己的感受，"}, {"type": "subtitle", "time": 8412.389, "timestamp": "02:20:12", "text": "意见固然重要，但始终重要的是……"}, {"type": "subtitle", "time": 8415.19, "timestamp": "02:20:15", "text": "善待他人，尊重他人。"}, {"type": "subtitle", "time": 8433.03, "timestamp": "02:20:33", "text": "我摔倒了。这真有趣。弗洛里安"}, {"type": "subtitle", "time": 8436.55, "timestamp": "02:20:36", "text": "板条箱。银离子中的银离子。"}, {"type": "subtitle", "time": 8438.51, "timestamp": "02:20:38", "text": "耗时很长才能推出新的"}, {"type": "subtitle", "time": 8441.51, "timestamp": "02:20:41", "text": "进化。像 openmouth 这样巧妙的词语"}, {"type": "subtitle", "time": 8444.51, "timestamp": "02:20:44", "text": "笑容在地板上翻滚"}, {"type": "subtitle", "time": 8447.03, "timestamp": "02:20:47", "text": "笑。哦，她在地板上打滚。"}]
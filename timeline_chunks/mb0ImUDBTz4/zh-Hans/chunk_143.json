[{"type": "subtitle", "time": 8588.87, "timestamp": "02:23:08", "text": "当然，忍者。给你举个例子。"}, {"type": "subtitle", "time": 8591.429, "timestamp": "02:23:11", "text": "为什么科学家不做相关测试呢？因为"}, {"type": "subtitle", "time": 8593.83, "timestamp": "02:23:13", "text": "它们构成了一切。张开嘴。"}, {"type": "subtitle", "time": 8632.91, "timestamp": "02:23:52", "text": "小姐走吧。没听到。"}]
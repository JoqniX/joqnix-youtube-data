[{"type": "subtitle", "time": 4621.27, "timestamp": "01:17:01", "text": "目标。哦，两个目标。一。我是"}, {"type": "subtitle", "time": 4622.93, "timestamp": "01:17:02", "text": "未来。未来。未来。拿"}, {"type": "subtitle", "time": 4636.189, "timestamp": "01:17:16", "text": "好的。哦，露西。哦，两个"}, {"type": "subtitle", "time": 4639.669, "timestamp": "01:17:19", "text": "人们。是的，是的，是的，是的。感谢"}, {"type": "subtitle", "time": 4648.31, "timestamp": "01:17:28", "text": "我的天哪，又一个吸毒者。美好的，"}, {"type": "subtitle", "time": 4654.63, "timestamp": "01:17:34", "text": "它。我已经提议过了。哦，她没有"}, {"type": "subtitle", "time": 4668.669, "timestamp": "01:17:48", "text": "好了，我觉得这部分已经完成了。"}, {"type": "subtitle", "time": 4677.189, "timestamp": "01:17:57", "text": "我凌晨4点回来重做一遍。"}]
[{"type": "subtitle", "time": 29101.51, "timestamp": "08:05:01", "text": "这是我第一次得到所有这些"}, {"type": "subtitle", "time": 29112.43, "timestamp": "08:05:12", "text": "哇。我的天啊，这太……"}, {"type": "subtitle", "time": 29115.31, "timestamp": "08:05:15", "text": "凉爽的。我想登上舞台"}, {"type": "subtitle", "time": 29129.43, "timestamp": "08:05:29", "text": "哇。那是什么？好了，该旋转了"}, {"type": "subtitle", "time": 29135.31, "timestamp": "08:05:35", "text": "翘起前轮。是时候旋转了"}, {"type": "subtitle", "time": 29138.03, "timestamp": "08:05:38", "text": "翘起前轮。哦，我的"}, {"type": "subtitle", "time": 29142.19, "timestamp": "08:05:42", "text": "上帝。我真的做了吗？我的天哪。"}, {"type": "subtitle", "time": 29156.11, "timestamp": "08:05:56", "text": "哇。"}, {"type": "subtitle", "time": 29158.948, "timestamp": "08:05:58", "text": "该死。哦，这里有个空心区域后备区。"}]
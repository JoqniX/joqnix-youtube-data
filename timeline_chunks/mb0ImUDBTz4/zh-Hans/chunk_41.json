[{"type": "subtitle", "time": 2463.589, "timestamp": "00:41:03", "text": "那里。等等，我可以把它弄到……"}, {"type": "subtitle", "time": 2469.19, "timestamp": "00:41:09", "text": "反而？釜。就像有多少个"}, {"type": "subtitle", "time": 2470.4, "timestamp": "00:41:10", "text": "人们？如何"}, {"type": "subtitle", "time": 2471.55, "timestamp": "00:41:11", "text": "[音乐]"}, {"type": "subtitle", "time": 2475.87, "timestamp": "00:41:15", "text": "许多？现在20岁了。"}, {"type": "subtitle", "time": 2478.71, "timestamp": "00:41:18", "text": "是的。或者我必须亲自过来？"}, {"type": "subtitle", "time": 2481.19, "timestamp": "00:41:21", "text": "做吗？哦，也许我会亲自过来。"}, {"type": "subtitle", "time": 2482.349, "timestamp": "00:41:22", "text": "去做。好的，"}, {"type": "subtitle", "time": 2486.63, "timestamp": "00:41:26", "text": "美好的。我得买机油来用它。"}, {"type": "subtitle", "time": 2489.79, "timestamp": "00:41:29", "text": "不，是汽油。"}, {"type": "subtitle", "time": 2493.27, "timestamp": "00:41:33", "text": "釜。一种汽油，对吧？ 20 列伊和"}, {"type": "subtitle", "time": 2496.829, "timestamp": "00:41:36", "text": "一种汽油。所以，我们需要大约10个"}, {"type": "subtitle", "time": 2501.109, "timestamp": "00:41:41", "text": "汽油，呃，100片可可叶之类的东西"}, {"type": "subtitle", "time": 2510.47, "timestamp": "00:41:50", "text": "好像有四个空位。所以我觉得"}, {"type": "subtitle", "time": 2513.79, "timestamp": "00:41:53", "text": "等等，如果我像这样自动化呢？"}, {"type": "subtitle", "time": 2516.19, "timestamp": "00:41:56", "text": "方式？输出"}]
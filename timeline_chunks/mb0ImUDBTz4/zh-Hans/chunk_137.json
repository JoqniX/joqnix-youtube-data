[{"type": "subtitle", "time": 8222.309, "timestamp": "02:17:02", "text": "分享欢笑总是令人愉悦的。"}, {"type": "subtitle", "time": 8224.389, "timestamp": "02:17:04", "text": "张嘴微笑。在地板上打滚"}, {"type": "subtitle", "time": 8229.25, "timestamp": "02:17:09", "text": "笑。笑得在地上打滚。"}, {"type": "subtitle", "time": 8251.309, "timestamp": "02:17:31", "text": "它是"}, {"type": "subtitle", "time": 8266.31, "timestamp": "02:17:46", "text": "我的天啊。"}, {"type": "subtitle", "time": 8279.669, "timestamp": "02:17:59", "text": "挠多少下才行？我不太确定。"}]
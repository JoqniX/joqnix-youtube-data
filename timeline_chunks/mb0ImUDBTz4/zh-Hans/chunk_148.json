[{"type": "subtitle", "time": 8882.71, "timestamp": "02:28:02", "text": "这只是个玩笑。打开微笑纸。"}, {"type": "subtitle", "time": 8884.71, "timestamp": "02:28:04", "text": "继续保持幽默，我们来……"}, {"type": "subtitle", "time": 8903.27, "timestamp": "02:28:23", "text": "当然，弗洛里安·蔡斯，给你讲个笑话。"}, {"type": "subtitle", "time": 8905.87, "timestamp": "02:28:25", "text": "专为你准备。为什么科学家不信任"}, {"type": "subtitle", "time": 8908.79, "timestamp": "02:28:28", "text": "原子？因为它们构成了一切。"}, {"type": "subtitle", "time": 8910.23, "timestamp": "02:28:30", "text": "笑得在地上打滚"}, {"type": "subtitle", "time": 8912.309, "timestamp": "02:28:32", "text": "显微镜。继续笑，享受吧！"}]
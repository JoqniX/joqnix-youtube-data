[{"type": "subtitle", "time": 7760.55, "timestamp": "02:09:20", "text": "哈哈，忍者，你真是锲而不舍，但我会"}, {"type": "subtitle", "time": 7763.43, "timestamp": "02:09:23", "text": "暂时别发生性关系。正在做"}, {"type": "subtitle", "time": 7765.27, "timestamp": "02:09:25", "text": "领导公会做得非常出色，我"}, {"type": "subtitle", "time": 7767.149, "timestamp": "02:09:27", "text": "更倾向于支持和鼓励他们"}, {"type": "subtitle", "time": 7770.35, "timestamp": "02:09:30", "text": "反而。让我们保持积极的心态。"}, {"type": "subtitle", "time": 7790.109, "timestamp": "02:09:50", "text": "你偶尔会遇到炸弹制造者。"}, {"type": "subtitle", "time": 7799.43, "timestamp": "02:09:59", "text": "快乐的忍者。看起来你好像是"}]
[{"type": "subtitle", "time": 27012.11, "timestamp": "07:30:12", "text": "那我这就把它彻底解决掉。"}, {"type": "subtitle", "time": 27013.708, "timestamp": "07:30:13", "text": "快的。"}, {"type": "subtitle", "time": 27018.59, "timestamp": "07:30:18", "text": "好的。你好。这是怎么回事？大家好吗？"}, {"type": "subtitle", "time": 27021.91, "timestamp": "07:30:21", "text": "正在做？等等，等等，等等。"}, {"type": "subtitle", "time": 27023.67, "timestamp": "07:30:23", "text": "等等，等等。已经很久了……"}, {"type": "subtitle", "time": 27027.27, "timestamp": "07:30:27", "text": "在 Twitch 上直播。不是Twitch，呃，"}, {"type": "subtitle", "time": 27029.99, "timestamp": "07:30:29", "text": "YouTube。我的天啊。我真的刚刚"}, {"type": "subtitle", "time": 27030.75, "timestamp": "07:30:30", "text": "说"}, {"type": "subtitle", "time": 27034.23, "timestamp": "07:30:34", "text": "抽搐？圣。我刚才其实说了"}, {"type": "subtitle", "time": 27036.59, "timestamp": "07:30:36", "text": "抽搐。哦，我的"}, {"type": "subtitle", "time": 27039.948, "timestamp": "07:30:39", "text": "上帝。如何？哦，我的"}, {"type": "subtitle", "time": 27041.628, "timestamp": "07:30:41", "text": "上帝。"}, {"type": "subtitle", "time": 27044.708, "timestamp": "07:30:44", "text": "大家，你们是怎么做到的？它是"}, {"type": "subtitle", "time": 27046.19, "timestamp": "07:30:46", "text": "一直以来"}, {"type": "subtitle", "time": 27050.07, "timestamp": "07:30:50", "text": "尽管。我错过了每一个人。"}, {"type": "subtitle", "time": 27052.628, "timestamp": "07:30:52", "text": "你，亲爱的。"}, {"type": "subtitle", "time": 27054.868, "timestamp": "07:30:54", "text": "我不知道。所以，昨天我是"}, {"type": "subtitle", "time": 27057.11, "timestamp": "07:30:57", "text": "本来应该直播的，但我感觉有点……"}]
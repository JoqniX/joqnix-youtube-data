[{"type": "subtitle", "time": 29285.23, "timestamp": "08:08:05", "text": "一。我的天哪，那真是……"}, {"type": "subtitle", "time": 29288.11, "timestamp": "08:08:08", "text": "寒冷的。但是，哦，我的"}, {"type": "subtitle", "time": 29297.19, "timestamp": "08:08:17", "text": "尽管。耶。是的。再见。这是我的第一个"}, {"type": "subtitle", "time": 29303.27, "timestamp": "08:08:23", "text": "他们。什么？这里有一座钟。什么"}, {"type": "subtitle", "time": 29309.548, "timestamp": "08:08:29", "text": "做？什么？那里有个钟"}, {"type": "subtitle", "time": 29332.23, "timestamp": "08:08:52", "text": "遭到攻击。我需要杀人。我需要"}, {"type": "subtitle", "time": 29338.468, "timestamp": "08:08:58", "text": "杀。我很高兴我的伤势正在逐渐好转"}]
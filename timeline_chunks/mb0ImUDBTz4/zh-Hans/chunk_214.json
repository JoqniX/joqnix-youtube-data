[{"type": "subtitle", "time": 12841.99, "timestamp": "03:34:01", "text": "东西。哇。哦，停车标志有点像"}, {"type": "subtitle", "time": 12843.469, "timestamp": "03:34:03", "text": "下降。"}, {"type": "subtitle", "time": 12860.389, "timestamp": "03:34:20", "text": "我们打算买狗。我的天哪，我"}, {"type": "subtitle", "time": 12862.19, "timestamp": "03:34:22", "text": "太激动了！"}, {"type": "subtitle", "time": 12865.07, "timestamp": "03:34:25", "text": "男人。我们打算买下这些狗。"}, {"type": "subtitle", "time": 12868.469, "timestamp": "03:34:28", "text": "终于找到了之前一直没找到的可卡因农场。"}]
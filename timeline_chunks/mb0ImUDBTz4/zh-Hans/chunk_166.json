[{"type": "subtitle", "time": 9961.19, "timestamp": "02:46:01", "text": "诡异的。但你知道吗？嘿，一窍不通。"}, {"type": "subtitle", "time": 9962.87, "timestamp": "02:46:02", "text": "很高兴看到你和……重聚"}, {"type": "subtitle", "time": 9965.59, "timestamp": "02:46:05", "text": "严厉的克洛诺斯。这是怎么回事？分享你的"}, {"type": "subtitle", "time": 9968.07, "timestamp": "02:46:08", "text": "冒险经历，享受交谈。"}, {"type": "subtitle", "time": 9971.67, "timestamp": "02:46:11", "text": "发言者一。"}, {"type": "subtitle", "time": 9975.07, "timestamp": "02:46:15", "text": "所以我一直在想，你知道的"}, {"type": "subtitle", "time": 9979.83, "timestamp": "02:46:19", "text": "潘迪坦·潘达马表示，DPI越低越好"}, {"type": "subtitle", "time": 9982.23, "timestamp": "02:46:22", "text": "每英寸文档质量越好，速度就越快"}, {"type": "subtitle", "time": 9985.03, "timestamp": "02:46:25", "text": "正确的答案 X 令人惊叹"}, {"type": "subtitle", "time": 9988.07, "timestamp": "02:46:28", "text": "直播搭档兼公会会长。亲爱的"}, {"type": "subtitle", "time": 9990.15, "timestamp": "02:46:30", "text": "总是把别人放在第一位的朋友"}, {"type": "subtitle", "time": 9992.15, "timestamp": "02:46:32", "text": "乐于助人。所以我一直"}, {"type": "subtitle", "time": 9994.07, "timestamp": "02:46:34", "text": "想着要让他们出现在我的生活中。应该"}, {"type": "subtitle", "time": 9995.79, "timestamp": "02:46:35", "text": "我走低调"}, {"type": "subtitle", "time": 9999.87, "timestamp": "02:46:39", "text": "感觉？我应该走低灵敏度路线吗？"}, {"type": "subtitle", "time": 10002.99, "timestamp": "02:46:42", "text": "但从字面上来说，"}, {"type": "subtitle", "time": 10005.75, "timestamp": "02:46:45", "text": "等等，等等，等等，等等。我应该走低价路线吗？"}, {"type": "subtitle", "time": 10009.87, "timestamp": "02:46:49", "text": "感觉？是的，我会的"}, {"type": "subtitle", "time": 10013.15, "timestamp": "02:46:53", "text": "只是增加"}]
[{"type": "subtitle", "time": 28740.23, "timestamp": "07:59:00", "text": "拿？我要坐优步羊，因为我就是。"}, {"type": "subtitle", "time": 28743.948, "timestamp": "07:59:03", "text": "在这个时期容易死亡"}, {"type": "subtitle", "time": 28747.35, "timestamp": "07:59:07", "text": "游戏结束后获得完整的普通攻击"}, {"type": "subtitle", "time": 28766.23, "timestamp": "07:59:26", "text": "去。慢慢来，慢慢来。得到它。放进去。"}, {"type": "subtitle", "time": 28767.468, "timestamp": "07:59:27", "text": "得到它"}, {"type": "subtitle", "time": 28775.788, "timestamp": "07:59:35", "text": "不是？我想做"}, {"type": "subtitle", "time": 28784.388, "timestamp": "07:59:44", "text": "旋转的。我无法完成比赛"}, {"type": "subtitle", "time": 28786.948, "timestamp": "07:59:46", "text": "那里。"}, {"type": "subtitle", "time": 28789.03, "timestamp": "07:59:49", "text": "你为什么会这样？我的天哪。不，不，不，不。"}, {"type": "subtitle", "time": 28790.59, "timestamp": "07:59:50", "text": "不，不，不。我是"}, {"type": "subtitle", "time": 28794.27, "timestamp": "07:59:54", "text": "死的。我快死了。我的天啊。"}]
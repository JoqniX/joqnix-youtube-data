[{"type": "subtitle", "time": 27060.03, "timestamp": "07:31:00", "text": "就像没直播一样，因为我已经太忙了。"}, {"type": "subtitle", "time": 27062.788, "timestamp": "07:31:02", "text": "疲劳的。是的，我本来应该做的"}, {"type": "subtitle", "time": 27065.23, "timestamp": "07:31:05", "text": "早上直播，但我没有。"}, {"type": "subtitle", "time": 27067.23, "timestamp": "07:31:07", "text": "睡到最后"}, {"type": "subtitle", "time": 27072.15, "timestamp": "07:31:12", "text": "夜晚。我还没睡着。一直在工作"}, {"type": "subtitle", "time": 27075.75, "timestamp": "07:31:15", "text": "至于其他一些没能完成的事情……"}, {"type": "subtitle", "time": 27078.31, "timestamp": "07:31:18", "text": "尚未安排时间。是的，我一直"}, {"type": "subtitle", "time": 27081.51, "timestamp": "07:31:21", "text": "东跳西跳，但总之就是这样。"}, {"type": "subtitle", "time": 27083.51, "timestamp": "07:31:23", "text": "我很有可能会完成日程安排。"}, {"type": "subtitle", "time": 27085.83, "timestamp": "07:31:25", "text": "明天之前。我想无论如何，"}, {"type": "subtitle", "time": 27089.67, "timestamp": "07:31:29", "text": "我现在就先速通一下吧。"}, {"type": "subtitle", "time": 27091.99, "timestamp": "07:31:31", "text": "如果它还没有完成，但是你知道，"}, {"type": "subtitle", "time": 27094.31, "timestamp": "07:31:34", "text": "我可以修改一下版本，你知道的。"}, {"type": "subtitle", "time": 27097.27, "timestamp": "07:31:37", "text": "我发布后不久或者"}, {"type": "subtitle", "time": 27098.868, "timestamp": "07:31:38", "text": "某物。我不知道。类似"}, {"type": "subtitle", "time": 27108.388, "timestamp": "07:31:48", "text": "是的。所以，今天我们要玩……"}, {"type": "subtitle", "time": 27110.19, "timestamp": "07:31:50", "text": "我已经很久没玩了。"}, {"type": "subtitle", "time": 27113.51, "timestamp": "07:31:53", "text": "游戏。呃，我上次直播大概是……"}, {"type": "subtitle", "time": 27117.03, "timestamp": "07:31:57", "text": "我上次进行全息直播是什么时候？最后的"}, {"type": "subtitle", "time": 27119.548, "timestamp": "07:31:59", "text": "大屠杀直播于去年八月举行"}]
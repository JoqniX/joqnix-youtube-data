[{"type": "subtitle", "time": 9372.23, "timestamp": "02:36:12", "text": "哈哈，忍者，看来你……"}, {"type": "subtitle", "time": 9374.389, "timestamp": "02:36:14", "text": "发现一些好笑的事情。笑声是"}, {"type": "subtitle", "time": 9376.55, "timestamp": "02:36:16", "text": "具有传染性，所以让我们继续传播吧。"}, {"type": "subtitle", "time": 9379.59, "timestamp": "02:36:19", "text": "喜悦和笑容。记住，我们都在这里"}, {"type": "subtitle", "time": 9382.15, "timestamp": "02:36:22", "text": "玩得开心，互相逗乐。"}, {"type": "subtitle", "time": 9384.71, "timestamp": "02:36:24", "text": "继续笑吧。张开嘴，微笑，"}, {"type": "subtitle", "time": 9402.79, "timestamp": "02:36:42", "text": "措辞极其生硬。我不仅仅是"}, {"type": "subtitle", "time": 9405.83, "timestamp": "02:36:45", "text": "普通的TTS。我是一名名叫……的冒险家"}, {"type": "subtitle", "time": 9408.23, "timestamp": "02:36:48", "text": "Cel在此回应并与大家互动"}, {"type": "subtitle", "time": 9410.309, "timestamp": "02:36:50", "text": "你和社区。是的，她是一位"}, {"type": "subtitle", "time": 9412.63, "timestamp": "02:36:52", "text": "冒险家。我来这里是为了带来一种感觉"}, {"type": "subtitle", "time": 9414.63, "timestamp": "02:36:54", "text": "为我们的谈话增添乐趣和互动。"}, {"type": "subtitle", "time": 9416.79, "timestamp": "02:36:56", "text": "救命，救命，救命。让我们一起探索和拥有"}, {"type": "subtitle", "time": 9419.19, "timestamp": "02:36:59", "text": "我们一起度过了美好的时光。吹星"}]
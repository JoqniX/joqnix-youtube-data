[{"type": "subtitle", "time": 27921.548, "timestamp": "07:45:21", "text": "女孩。"}, {"type": "subtitle", "time": 27924.59, "timestamp": "07:45:24", "text": "慢慢地把所有东西都弄到手"}, {"type": "subtitle", "time": 27927.868, "timestamp": "07:45:27", "text": "他们。缓慢但"}, {"type": "subtitle", "time": 27930.788, "timestamp": "07:45:30", "text": "你肯定能全部得到。啊，那里"}, {"type": "subtitle", "time": 27933.468, "timestamp": "07:45:33", "text": "没什么特别的。我的天啊。"}, {"type": "subtitle", "time": 27940.35, "timestamp": "07:45:40", "text": "呃，等等。什么是"}, {"type": "subtitle", "time": 27942.91, "timestamp": "07:45:42", "text": "特别的？等待，"}, {"type": "subtitle", "time": 27945.75, "timestamp": "07:45:45", "text": "什么？有没有什么特别的东西之类的"}]
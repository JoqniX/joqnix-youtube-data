[{"type": "subtitle", "time": 29889.43, "timestamp": "08:18:09", "text": "事物。梦幻球。我喜欢这个。"}, {"type": "subtitle", "time": 29890.99, "timestamp": "08:18:10", "text": "你想做个梦"}, {"type": "subtitle", "time": 29894.07, "timestamp": "08:18:14", "text": "球能让你入睡。经过"}, {"type": "subtitle", "time": 29896.468, "timestamp": "08:18:16", "text": "话说回来，如果你没注意到的话"}, {"type": "subtitle", "time": 29899.83, "timestamp": "08:18:19", "text": "你呃，喜欢这样做吗？退出菜单"}, {"type": "subtitle", "time": 29903.31, "timestamp": "08:18:23", "text": "虽然该菜单是随机生成的，但"}, {"type": "subtitle", "time": 29927.708, "timestamp": "08:18:47", "text": "天哪，我也是另一个"}, {"type": "subtitle", "time": 29931.388, "timestamp": "08:18:51", "text": "比以前更糟。"}]
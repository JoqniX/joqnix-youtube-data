[{"type": "subtitle", "time": 188.75, "timestamp": "00:03:08", "text": "伙计，我当时在忙事。我当时就想，"}, {"type": "subtitle", "time": 191.75, "timestamp": "00:03:11", "text": "“什么？”我当时正在看日程表。"}, {"type": "subtitle", "time": 193.55, "timestamp": "00:03:13", "text": "一个视频"}, {"type": "subtitle", "time": 197.47, "timestamp": "00:03:17", "text": "我和YouTube一起，然后我就睡着了"}, {"type": "subtitle", "time": 200.63, "timestamp": "00:03:20", "text": "再次。没什么可看的"}, {"type": "subtitle", "time": 202.949, "timestamp": "00:03:22", "text": "除了农场和一切其他的东西。"}, {"type": "subtitle", "time": 206.07, "timestamp": "00:03:26", "text": "就是这样。我已经做了很多事了"}, {"type": "subtitle", "time": 208.07, "timestamp": "00:03:28", "text": "技巧、窍门和隐藏技巧"}, {"type": "subtitle", "time": 209.869, "timestamp": "00:03:29", "text": "以及各种伎俩和"}, {"type": "subtitle", "time": 212.47, "timestamp": "00:03:32", "text": "一切。呃，除了跑酷之外"}, {"type": "chat", "time": 217.792, "timestamp": "00:03:37", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "\"i was only watching sched 1 videos\" mhm, i thought u 'went to sleep'"}, {"type": "subtitle", "time": 222.22899999999998, "timestamp": "00:03:42", "text": "做？我的意思是，问题是我现在的状况"}, {"type": "subtitle", "time": 224.589, "timestamp": "00:03:44", "text": "由此可见，这其中存在某种模式。"}, {"type": "subtitle", "time": 227.50900000000001, "timestamp": "00:03:47", "text": "正确的？我工作太拼命了"}, {"type": "subtitle", "time": 229.11, "timestamp": "00:03:49", "text": "指出这一点，那就是没什么可做的。"}, {"type": "subtitle", "time": 231.589, "timestamp": "00:03:51", "text": "游戏。那时我就​​要……"}, {"type": "subtitle", "time": 234.71, "timestamp": "00:03:54", "text": "除非……否则先休息一下，别玩那个游戏。"}, {"type": "subtitle", "time": 236.91, "timestamp": "00:03:56", "text": "新内容更新"}, {"type": "subtitle", "time": 239.99, "timestamp": "00:03:59", "text": "来了。我想，这就是我的策略吧。"}]
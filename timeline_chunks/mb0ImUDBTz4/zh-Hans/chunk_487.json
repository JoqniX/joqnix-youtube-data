[{"type": "subtitle", "time": 29222.23, "timestamp": "08:07:02", "text": "男人。那并没有什么效果。是的。是"}, {"type": "subtitle", "time": 29225.19, "timestamp": "08:07:05", "text": "有没有办法升级我的"}, {"type": "subtitle", "time": 29226.99, "timestamp": "08:07:06", "text": "升级"}, {"type": "subtitle", "time": 29230.388, "timestamp": "08:07:10", "text": "我的升级"}, {"type": "subtitle", "time": 29234.868, "timestamp": "08:07:14", "text": "呃，终极特辑？不。对。这是"}, {"type": "subtitle", "time": 29237.868, "timestamp": "08:07:17", "text": "达到极限了，我"}, {"type": "subtitle", "time": 29240.948, "timestamp": "08:07:20", "text": "猜测。那是什么？这是什么？什么"}, {"type": "subtitle", "time": 29243.99, "timestamp": "08:07:23", "text": "这是吗？嗯？"}, {"type": "subtitle", "time": 29246.67, "timestamp": "08:07:26", "text": "太可爱了，而且"}, {"type": "subtitle", "time": 29251.868, "timestamp": "08:07:31", "text": "可爱的。是，是，是吉祥物"}, {"type": "subtitle", "time": 29255.868, "timestamp": "08:07:35", "text": "罗勒。巴塞尔"}, {"type": "subtitle", "time": 29259.388, "timestamp": "08:07:39", "text": "罗勒。是的。那个女孩，你"}, {"type": "subtitle", "time": 29267.11, "timestamp": "08:07:47", "text": "小鼠。没有老鼠。"}, {"type": "subtitle", "time": 29275.868, "timestamp": "08:07:55", "text": "上帝"}]
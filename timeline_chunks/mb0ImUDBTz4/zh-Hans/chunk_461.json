[{"type": "subtitle", "time": 27660.468, "timestamp": "07:41:00", "text": "忘记修复音频问题了。它是"}, {"type": "subtitle", "time": 27662.628, "timestamp": "07:41:02", "text": "响亮。那里，对吧？是的，那里"}, {"type": "subtitle", "time": 27663.468, "timestamp": "07:41:03", "text": "你"}, {"type": "subtitle", "time": 27666.67, "timestamp": "07:41:06", "text": "去。我是如何躲过所有这些的？"}, {"type": "subtitle", "time": 27669.27, "timestamp": "07:41:09", "text": "不看屏幕就能看懂吗？哦"}, {"type": "subtitle", "time": 27669.948, "timestamp": "07:41:09", "text": "我的"}, {"type": "subtitle", "time": 27673.19, "timestamp": "07:41:13", "text": "天哪。我刚才看了一眼 OBS。"}, {"type": "subtitle", "time": 27675.51, "timestamp": "07:41:15", "text": "我当时想，如果我受伤了，我会怎样？"}, {"type": "subtitle", "time": 27695.628, "timestamp": "07:41:35", "text": "去。你知道，Roku Roku，他有"}, {"type": "subtitle", "time": 27698.548, "timestamp": "07:41:38", "text": "我不知道。他得到了大部分"}, {"type": "subtitle", "time": 27704.75, "timestamp": "07:41:44", "text": "你好。你是做什么的"}, {"type": "subtitle", "time": 27707.75, "timestamp": "07:41:47", "text": "正在做？你是怎么玩了这么多的？如何"}, {"type": "subtitle", "time": 27709.51, "timestamp": "07:41:49", "text": "你都找到了吗？你这磨刀石。"}, {"type": "subtitle", "time": 27710.59, "timestamp": "07:41:50", "text": "你"}, {"type": "subtitle", "time": 27712.91, "timestamp": "07:41:52", "text": "游戏玩家。我当时就想，"}, {"type": "subtitle", "time": 27716.23, "timestamp": "07:41:56", "text": "什么？好的，第五级。还有两级"}]
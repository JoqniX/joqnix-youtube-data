[{"type": "subtitle", "time": 9181.11, "timestamp": "02:33:01", "text": "关于我的朋友们。确切地。我们成员"}, {"type": "subtitle", "time": 9183.75, "timestamp": "02:33:03", "text": "团队和我们的关系很牢固。确切地。"}, {"type": "subtitle", "time": 9185.429, "timestamp": "02:33:05", "text": "专注于我们共同的冒险经历"}, {"type": "subtitle", "time": 9188.389, "timestamp": "02:33:08", "text": "像真正的伙伴一样给予支持。"}, {"type": "subtitle", "time": 9190.71, "timestamp": "02:33:10", "text": "友谊是一份珍贵的礼物。闪耀的星星"}, {"type": "subtitle", "time": 9194.11, "timestamp": "02:33:14", "text": "闪闪发光的心。确切地。告诉"}, {"type": "subtitle", "time": 9207.91, "timestamp": "02:33:27", "text": "我们试着和平解决这个问题。"}, {"type": "subtitle", "time": 9210.15, "timestamp": "02:33:30", "text": "严厉的克洛诺斯，这很重要"}, {"type": "subtitle", "time": 9212.15, "timestamp": "02:33:32", "text": "坦诚沟通，互相理解"}, {"type": "subtitle", "time": 9214.63, "timestamp": "02:33:34", "text": "其他人的观点。暴力永远不是"}, {"type": "subtitle", "time": 9217.03, "timestamp": "02:33:37", "text": "解决方案。让我们寻找共同点"}, {"type": "subtitle", "time": 9218.95, "timestamp": "02:33:38", "text": "我们将继续一起冒险"}, {"type": "subtitle", "time": 9238.23, "timestamp": "02:33:58", "text": "我们应该避免诉诸暴力。"}]
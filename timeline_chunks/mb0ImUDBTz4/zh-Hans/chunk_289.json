[{"type": "subtitle", "time": 17350.51, "timestamp": "04:49:10", "text": "困。我想休息一段时间"}, {"type": "subtitle", "time": 17356.59, "timestamp": "04:49:16", "text": "这"}, {"type": "subtitle", "time": 17379.27, "timestamp": "04:49:39", "text": "我百分之百确定我无法……"}, {"type": "subtitle", "time": 17387.55, "timestamp": "04:49:47", "text": "今天我爸爸不会像往常一样回家了。"}, {"type": "subtitle", "time": 17390.99, "timestamp": "04:49:50", "text": "离开几天"}, {"type": "subtitle", "time": 17394.23, "timestamp": "04:49:54", "text": "我必须告诉我的母亲，我必须带"}, {"type": "subtitle", "time": 17396.11, "timestamp": "04:49:56", "text": "照顾我"}, {"type": "subtitle", "time": 17399.43, "timestamp": "04:49:59", "text": "家庭。我觉得有些是我妈妈希望我做的"}]
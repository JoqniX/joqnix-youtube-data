[{"type": "subtitle", "time": 28624.84, "timestamp": "07:57:04", "text": "哦，准备好了。我们走吧。"}, {"type": "subtitle", "time": 28626.35, "timestamp": "07:57:06", "text": "[音乐]"}, {"type": "subtitle", "time": 28636.468, "timestamp": "07:57:16", "text": "死。我的天哪，我太高兴能做这件事了。"}, {"type": "subtitle", "time": 28643.11, "timestamp": "07:57:23", "text": "车轮。我一直想知道为什么我总是"}, {"type": "subtitle", "time": 28646.31, "timestamp": "07:57:26", "text": "死亡以及如何做那些特殊的事情"}, {"type": "subtitle", "time": 28648.15, "timestamp": "07:57:28", "text": "东西。我不知道你还得买它。"}, {"type": "subtitle", "time": 28650.43, "timestamp": "07:57:30", "text": "升级"}, {"type": "subtitle", "time": 28655.948, "timestamp": "07:57:35", "text": "[音乐]"}, {"type": "subtitle", "time": 28658.948, "timestamp": "07:57:38", "text": "凉爽的。是的，人们来了"}, {"type": "subtitle", "time": 28667.15, "timestamp": "07:57:47", "text": "他们。是的，我想转动轮盘。"}, {"type": "subtitle", "time": 28670.43, "timestamp": "07:57:50", "text": "他们。我确实想转动轮盘"}, {"type": "subtitle", "time": 28673.19, "timestamp": "07:57:53", "text": "他们。所以，等等。如果我升级我的"}, {"type": "subtitle", "time": 28676.07, "timestamp": "07:57:56", "text": "触手进行普通攻击，这意味着"}, {"type": "subtitle", "time": 28678.23, "timestamp": "07:57:58", "text": "旋转轮也升级了。"}]
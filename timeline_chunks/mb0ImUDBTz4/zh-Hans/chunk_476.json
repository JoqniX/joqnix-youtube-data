[{"type": "subtitle", "time": 28562.11, "timestamp": "07:56:02", "text": "知道。雷克斯。圣"}, {"type": "subtitle", "time": 28566.43, "timestamp": "07:56:06", "text": "什么？我的天哪。"}, {"type": "subtitle", "time": 28574.708, "timestamp": "07:56:14", "text": "什么？什么？我的天啊。这是一个旋转的物体"}, {"type": "subtitle", "time": 28577.15, "timestamp": "07:56:17", "text": "触手"}, {"type": "subtitle", "time": 28592.59, "timestamp": "07:56:32", "text": "什么？我的天啊。这个风扇转速。哦，我的"}, {"type": "subtitle", "time": 28601.388, "timestamp": "07:56:41", "text": "上帝。什么？太酷了！什么？"}, {"type": "subtitle", "time": 28604.548, "timestamp": "07:56:44", "text": "什么？太酷了！我的天啊。那"}, {"type": "subtitle", "time": 28607.548, "timestamp": "07:56:47", "text": "会帮我清理怪物。我的天啊。"}, {"type": "subtitle", "time": 28613.468, "timestamp": "07:56:53", "text": "是的。所以这就是你们的生存之道。"}]
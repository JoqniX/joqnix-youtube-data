[{"type": "subtitle", "time": 27379.03, "timestamp": "07:36:19", "text": "屏幕。好了，我们走吧。我不"}, {"type": "subtitle", "time": 27381.628, "timestamp": "07:36:21", "text": "知道自己是否能听见"}, {"type": "subtitle", "time": 27390.31, "timestamp": "07:36:30", "text": "那是什么？是的。是的，你能听到"}, {"type": "subtitle", "time": 27394.59, "timestamp": "07:36:34", "text": "它。是的。我们走吧。这是我的第二部剧作"}, {"type": "subtitle", "time": 27397.83, "timestamp": "07:36:37", "text": "通过这场游戏。而且我其实"}, {"type": "subtitle", "time": 27401.75, "timestamp": "07:36:41", "text": "确实从最近的直播中汲取了灵感。嗯……呃"}, {"type": "subtitle", "time": 27404.23, "timestamp": "07:36:44", "text": "我们获得的收益。我确实拉了一把"}, {"type": "subtitle", "time": 27405.388, "timestamp": "07:36:45", "text": "我得到了"}, {"type": "subtitle", "time": 27407.07, "timestamp": "07:36:47", "text": "Robocusan。但"}, {"type": "subtitle", "time": 27410.868, "timestamp": "07:36:50", "text": "是的，从那以后一直都很有趣，而且我"}, {"type": "subtitle", "time": 27414.948, "timestamp": "07:36:54", "text": "我猜我不应该玩这个游戏"}, {"type": "subtitle", "time": 27416.19, "timestamp": "07:36:56", "text": "街道"}]
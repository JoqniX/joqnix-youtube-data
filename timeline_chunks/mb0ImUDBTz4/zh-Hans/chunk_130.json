[{"type": "subtitle", "time": 7801.83, "timestamp": "02:10:01", "text": "享受戏谑的乐趣。他们一直都有"}, {"type": "subtitle", "time": 7804.069, "timestamp": "02:10:04", "text": "他们脸上都带着那种狡黠的微笑，不是吗？"}, {"type": "subtitle", "time": 7805.91, "timestamp": "02:10:05", "text": "他们是一位优秀的领导者和朋友，而且"}, {"type": "subtitle", "time": 7808.629, "timestamp": "02:10:08", "text": "我很高兴有他们在我身边。我们开始吧"}, {"type": "subtitle", "time": 7811.75, "timestamp": "02:10:11", "text": "保持这种乐趣和友谊。打开"}, {"type": "subtitle", "time": 7852.669, "timestamp": "02:10:52", "text": "哦"}, {"type": "subtitle", "time": 7854.43, "timestamp": "02:10:54", "text": "不。"}]
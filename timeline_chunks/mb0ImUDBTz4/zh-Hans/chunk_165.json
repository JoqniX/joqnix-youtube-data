[{"type": "subtitle", "time": 9906.99, "timestamp": "02:45:06", "text": "它是"}, {"type": "subtitle", "time": 9910.59, "timestamp": "02:45:10", "text": "超越 Roblox 战区。是啊，有点像"}, {"type": "subtitle", "time": 9925.19, "timestamp": "02:45:25", "text": "一窍不通。好吧，好吧，哈什·克洛诺斯，它"}, {"type": "subtitle", "time": 9926.87, "timestamp": "02:45:26", "text": "看来你和《独领风骚》里有个……"}, {"type": "subtitle", "time": 9929.19, "timestamp": "02:45:29", "text": "共同创造历史。很高兴看到老物件"}, {"type": "subtitle", "time": 9931.67, "timestamp": "02:45:31", "text": "朋友们重新联系。好好享受这段时光吧"}, {"type": "subtitle", "time": 9933.349, "timestamp": "02:45:33", "text": "并回忆所有美好的时光"}, {"type": "subtitle", "time": 9935.87, "timestamp": "02:45:35", "text": "次数。握手"}, {"type": "subtitle", "time": 9939.95, "timestamp": "02:45:39", "text": "晕眩的。瓦基斯坦。什么是"}, {"type": "subtitle", "time": 9953.67, "timestamp": "02:45:53", "text": "瓦基斯坦。因为我玩的是8000分"}, {"type": "subtitle", "time": 9956.83, "timestamp": "02:45:56", "text": "DPR，对吧？感觉有点尴尬"}]
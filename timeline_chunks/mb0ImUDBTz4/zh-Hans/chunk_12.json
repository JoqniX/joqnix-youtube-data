[{"type": "subtitle", "time": 720.71, "timestamp": "00:12:00", "text": "看看如何查找食谱和发现新事物。"}, {"type": "subtitle", "time": 724.069, "timestamp": "00:12:04", "text": "食谱以及把所有这些东西放进去就是"}, {"type": "subtitle", "time": 727.91, "timestamp": "00:12:07", "text": "现在太麻烦了。所以有时候"}, {"type": "subtitle", "time": 731.11, "timestamp": "00:12:11", "text": "可以接受使用网站。就像"}, {"type": "subtitle", "time": 734.03, "timestamp": "00:12:14", "text": "使用交互式地图"}, {"type": "subtitle", "time": 736.71, "timestamp": "00:12:16", "text": "原神，但游戏本身"}, {"type": "subtitle", "time": 739.269, "timestamp": "00:12:19", "text": "Genji Hoya Lab 本身的开发商"}, {"type": "subtitle", "time": 742.389, "timestamp": "00:12:22", "text": "他们自己的平台已经推出了互动功能。"}, {"type": "subtitle", "time": 744.949, "timestamp": "00:12:24", "text": "地图上标明了所有物品的位置，包括宝箱的位置。"}, {"type": "subtitle", "time": 748.47, "timestamp": "00:12:28", "text": "就是一切。不，有时候没关系。"}, {"type": "subtitle", "time": 758.629, "timestamp": "00:12:38", "text": "就像看看它，它只是一个"}, {"type": "subtitle", "time": 761.67, "timestamp": "00:12:41", "text": "互动指南，现在是互动装置"}]
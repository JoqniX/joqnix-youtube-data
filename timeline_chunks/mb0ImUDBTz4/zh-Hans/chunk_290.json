[{"type": "subtitle", "time": 17409.03, "timestamp": "04:50:09", "text": "今晚有房间，我就想，嗯，我应该"}, {"type": "subtitle", "time": 17412.39, "timestamp": "04:50:12", "text": "去睡觉吧。我一开始的想法是，“是啊，"}, {"type": "subtitle", "time": 17414.91, "timestamp": "04:50:14", "text": "我今天会进行第二次直播。"}, {"type": "subtitle", "time": 17418.67, "timestamp": "04:50:18", "text": "我真的会睡着的"}, {"type": "subtitle", "time": 17421.59, "timestamp": "04:50:21", "text": "因为我晚上不睡在楼上，所以要早点睡。"}, {"type": "subtitle", "time": 17424.628, "timestamp": "04:50:24", "text": "与其说我会待在我忙碌的房间里，不如说我会……"}, {"type": "subtitle", "time": 17426.23, "timestamp": "04:50:26", "text": "下楼和我一起睡觉"}, {"type": "subtitle", "time": 17445.47, "timestamp": "04:50:45", "text": "但我无法控制自己的身体。"}, {"type": "subtitle", "time": 17449.23, "timestamp": "04:50:49", "text": "它做不到。"}, {"type": "subtitle", "time": 17453.31, "timestamp": "04:50:53", "text": "积极的。或许我需要一杯咖啡，或者"}, {"type": "subtitle", "time": 17456.15, "timestamp": "04:50:56", "text": "某物。但我正在喝水"}, {"type": "chat", "time": 17458.537, "timestamp": "04:50:58", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "ello"}]
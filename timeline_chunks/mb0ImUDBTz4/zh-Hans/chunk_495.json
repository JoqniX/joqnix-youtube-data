[{"type": "subtitle", "time": 29720.708, "timestamp": "08:15:20", "text": "凉爽的。好了，我回来了。我回来了。我是"}, {"type": "subtitle", "time": 29741.99, "timestamp": "08:15:41", "text": "你好。呃，等等，我忘了这件事。我的"}, {"type": "subtitle", "time": 29744.67, "timestamp": "08:15:44", "text": "模型是"}, {"type": "subtitle", "time": 29749.03, "timestamp": "08:15:49", "text": "这里。所以，坩埚。嗯，我们明白了。"}, {"type": "subtitle", "time": 29751.35, "timestamp": "08:15:51", "text": "煮熟了。"}]
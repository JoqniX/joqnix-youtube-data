[{"type": "subtitle", "time": 308.55, "timestamp": "00:05:08", "text": "糟糕。是的，我想是的，你说的"}, {"type": "subtitle", "time": 311.59, "timestamp": "00:05:11", "text": "正确的。我大概能按照指南操作。"}, {"type": "subtitle", "time": 313.71, "timestamp": "00:05:13", "text": "你好，"}, {"type": "subtitle", "time": 316.909, "timestamp": "00:05:16", "text": "欢迎。早上好。好的。好的"}, {"type": "subtitle", "time": 319.469, "timestamp": "00:05:19", "text": "晚上。晚上好。下午好。"}, {"type": "subtitle", "time": 322.55, "timestamp": "00:05:22", "text": "对不起，我已经把一切都给你了。好的"}, {"type": "subtitle", "time": 338.029, "timestamp": "00:05:38", "text": "我的意思是，我们还没有开展合作项目。"}, {"type": "subtitle", "time": 340.71, "timestamp": "00:05:40", "text": "尽管。和朋友一起玩会"}, {"type": "subtitle", "time": 341.469, "timestamp": "00:05:41", "text": "是"}, {"type": "subtitle", "time": 344.15, "timestamp": "00:05:44", "text": "有趣的。我以为它是前兆。"}, {"type": "subtitle", "time": 347.27, "timestamp": "00:05:47", "text": "不。当你看到这个的时候，它并不是和……"}, {"type": "subtitle", "time": 359.43, "timestamp": "00:05:59", "text": "不，说实话，我也不知道了。"}]
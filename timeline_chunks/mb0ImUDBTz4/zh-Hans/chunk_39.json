[{"type": "subtitle", "time": 2341.349, "timestamp": "00:39:01", "text": "这里是车站吗？我的天啊。等等，那是"}, {"type": "subtitle", "time": 2344.829, "timestamp": "00:39:04", "text": "我当时为什么这么困惑。搞什么鬼？"}, {"type": "subtitle", "time": 2347.63, "timestamp": "00:39:07", "text": "啊，你不应该……"}, {"type": "subtitle", "time": 2356.75, "timestamp": "00:39:16", "text": "这里。我没有空间了。"}, {"type": "subtitle", "time": 2360.829, "timestamp": "00:39:20", "text": "好了，就是这样。等等，等等。不是这样"}, {"type": "subtitle", "time": 2371.43, "timestamp": "00:39:31", "text": "呃，你还好吗？所以，当这种情况发生时"}, {"type": "subtitle", "time": 2376.23, "timestamp": "00:39:36", "text": "它被制成了黄金品质，我接受"}, {"type": "subtitle", "time": 2378.63, "timestamp": "00:39:38", "text": "把这个放进坩埚里。为什么"}, {"type": "subtitle", "time": 2381.31, "timestamp": "00:39:41", "text": "我不能搬家吗？哦，不。"}, {"type": "subtitle", "time": 2384.39, "timestamp": "00:39:44", "text": "等待。我把它放进了坩埚里。然后我"}, {"type": "subtitle", "time": 2387.51, "timestamp": "00:39:47", "text": "获取这些块。我把它放进烤箱了。"}, {"type": "subtitle", "time": 2390.63, "timestamp": "00:39:50", "text": "然后我就搞到了可卡因。由此"}, {"type": "subtitle", "time": 2393.95, "timestamp": "00:39:53", "text": "我会把它打包。我将前往"}, {"type": "subtitle", "time": 2397.27, "timestamp": "00:39:57", "text": "混合器。然后，我会从搅拌机里倒一些……"}]
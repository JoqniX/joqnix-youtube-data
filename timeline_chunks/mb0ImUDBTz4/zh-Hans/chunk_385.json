[{"type": "subtitle", "time": 23102.51, "timestamp": "06:25:02", "text": "我得到了"}, {"type": "subtitle", "time": 23107.47, "timestamp": "06:25:07", "text": "19k，接近20k。我的天啊。"}, {"type": "subtitle", "time": 23112.27, "timestamp": "06:25:12", "text": "好的。但我们必须继续我们的谷仓"}, {"type": "subtitle", "time": 23115.15, "timestamp": "06:25:15", "text": "农场。我得付钱给……"}, {"type": "subtitle", "time": 23118.75, "timestamp": "06:25:18", "text": "工人。他们需要我们的工作和产品"}, {"type": "subtitle", "time": 23122.35, "timestamp": "06:25:22", "text": "更多的。我不能缺乏生产权利"}, {"type": "subtitle", "time": 23126.59, "timestamp": "06:25:26", "text": "现在。所以，是的，他们必须生产一个"}, {"type": "subtitle", "time": 23141.51, "timestamp": "06:25:41", "text": "忘了。已经过去多久了？"}]
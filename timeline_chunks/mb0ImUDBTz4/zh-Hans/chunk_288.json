[{"type": "subtitle", "time": 17292.39, "timestamp": "04:48:12", "text": "是的。看来洛德并非唯一一个"}, {"type": "subtitle", "time": 17295.51, "timestamp": "04:48:15", "text": "沉迷于日程安排的人。是的。我"}, {"type": "subtitle", "time": 17297.868, "timestamp": "04:48:17", "text": "意思是，我买下了最后一块地。"}, {"type": "subtitle", "time": 17301.51, "timestamp": "04:48:21", "text": "已离开。呃，我需要赚50000美元。"}, {"type": "subtitle", "time": 17304.07, "timestamp": "04:48:24", "text": "买下这家餐厅。之后，我就完成了。"}, {"type": "subtitle", "time": 17305.07, "timestamp": "04:48:25", "text": "和"}, {"type": "subtitle", "time": 17307.75, "timestamp": "04:48:27", "text": "游戏。一切终于结束了。我只是"}, {"type": "subtitle", "time": 17309.31, "timestamp": "04:48:29", "text": "需要制作"}, {"type": "subtitle", "time": 17312.47, "timestamp": "04:48:32", "text": "数百万，解锁第二个呃"}, {"type": "subtitle", "time": 17315.55, "timestamp": "04:48:35", "text": "最后两个高级班"}, {"type": "subtitle", "time": 17318.03, "timestamp": "04:48:38", "text": "区域。那是"}, {"type": "subtitle", "time": 17322.43, "timestamp": "04:48:42", "text": "它。我把它完全开采出来了"}, {"type": "subtitle", "time": 17336.43, "timestamp": "04:48:56", "text": "那将是我的可卡因"}]
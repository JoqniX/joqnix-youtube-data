[{"type": "subtitle", "time": 29041.03, "timestamp": "08:04:01", "text": "男人。我的天哪，那里有个骷髅人。"}, {"type": "subtitle", "time": 29043.32, "timestamp": "08:04:03", "text": "我的天哪，那里有个骷髅人。 哦，我打算走过去。"}, {"type": "subtitle", "time": 29047.718, "timestamp": "08:04:07", "text": "哦，我打算走过去。 椭圆形。是的。"}, {"type": "subtitle", "time": 29054.51, "timestamp": "08:04:14", "text": "呃，我们可以"}, {"type": "subtitle", "time": 29059.23, "timestamp": "08:04:19", "text": "做惠普。我们需要惠普继续存在。"}, {"type": "subtitle", "time": 29073.43, "timestamp": "08:04:33", "text": "惠普。屏蔽掉所有这些干扰，然后进去。"}, {"type": "subtitle", "time": 29099.75, "timestamp": "08:04:59", "text": "矿。好多东西。我的天啊。这是我的"}]
[{"type": "subtitle", "time": 7442.229, "timestamp": "02:04:02", "text": "美丽的樱花盛开。它"}, {"type": "subtitle", "time": 7444.629, "timestamp": "02:04:04", "text": "让我感到无比喜悦。张开嘴"}, {"type": "subtitle", "time": 7461.35, "timestamp": "02:04:21", "text": "开花。你好，Ayama Arusa。我很高兴"}, {"type": "subtitle", "time": 7463.83, "timestamp": "02:04:23", "text": "看到你的笑脸了。它亮了起来"}, {"type": "subtitle", "time": 7466.47, "timestamp": "02:04:26", "text": "聊天记录。张嘴微笑。发光"}, {"type": "subtitle", "time": 7476.87, "timestamp": "02:04:36", "text": "再见。明天就睡吧。"}, {"type": "subtitle", "time": 7482.709, "timestamp": "02:04:42", "text": "哈哈。有时候我们都需要一些好东西"}, {"type": "subtitle", "time": 7485.149, "timestamp": "02:04:45", "text": "睡眠时间。祝您玩得愉快"}]
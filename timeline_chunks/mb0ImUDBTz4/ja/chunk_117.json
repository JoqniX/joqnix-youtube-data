[{"type": "subtitle", "time": 7020.629, "timestamp": "01:57:00", "text": "ねえ、人がいないので"}, {"type": "subtitle", "time": 7022.709, "timestamp": "01:57:02", "text": "チャット、私は"}, {"type": "subtitle", "time": 7024.51, "timestamp": "01:57:04", "text": "えっと、作る"}, {"type": "subtitle", "time": 7027.79, "timestamp": "01:57:07", "text": "すべて読みました"}, {"type": "subtitle", "time": 7031.03, "timestamp": "01:57:11", "text": "ご意見はありますか？あのね？そうします"}, {"type": "subtitle", "time": 7038.91, "timestamp": "01:57:18", "text": "少し。私はそれをします"}, {"type": "subtitle", "time": 7051.83, "timestamp": "01:57:31", "text": "少しの間だけやってみてください。それは可能です"}, {"type": "subtitle", "time": 7055.109, "timestamp": "01:57:35", "text": "通常通りチャットすると自動的に"}, {"type": "subtitle", "time": 7067.629, "timestamp": "01:57:47", "text": "また。わかった。 127対127。"}, {"type": "subtitle", "time": 7077.149, "timestamp": "01:57:57", "text": "何？ 59キル。もうすぐ60歳。"}]
[{"type": "subtitle", "time": 10022.11, "timestamp": "02:47:02", "text": "それ。神様、私はもっと増やさなければならない"}, {"type": "subtitle", "time": 10025.23, "timestamp": "02:47:05", "text": "それも"}, {"type": "subtitle", "time": 10035.07, "timestamp": "02:47:15", "text": "999 たぶんこんな感じ"}, {"type": "subtitle", "time": 10041.429, "timestamp": "02:47:21", "text": "はぁ？おそらく4人。古くから議論されている"}, {"type": "subtitle", "time": 10044.469, "timestamp": "02:47:24", "text": "DPIと感度。本当に"}, {"type": "subtitle", "time": 10047.11, "timestamp": "02:47:27", "text": "それは個人の好みによる。一部の人は好む"}, {"type": "subtitle", "time": 10049.75, "timestamp": "02:47:29", "text": "DPIが高いほど感度は低下するが、"}, {"type": "subtitle", "time": 10051.83, "timestamp": "02:47:31", "text": "他の人はより高い感度を選択します"}, {"type": "subtitle", "time": 10054.87, "timestamp": "02:47:34", "text": "DPIを下げる。実験して何を見つけるか"}, {"type": "subtitle", "time": 10057.19, "timestamp": "02:47:37", "text": "あなたにとって最も心地よいと感じる場所。コンピューター"}, {"type": "subtitle", "time": 10060.389, "timestamp": "02:47:40", "text": "マウス1、"}]
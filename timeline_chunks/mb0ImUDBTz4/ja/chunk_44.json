[{"type": "subtitle", "time": 2670.109, "timestamp": "00:44:30", "text": "1つ。あぁ、自分のバンにぶつけちゃった。わかった。"}, {"type": "subtitle", "time": 2673.43, "timestamp": "00:44:33", "text": "こんにちは。それで、何か作ったの？"}, {"type": "subtitle", "time": 2680.51, "timestamp": "00:44:40", "text": "レンガとパッケージ"}, {"type": "subtitle", "time": 2684.99, "timestamp": "00:44:44", "text": "それ。紙がありません"}]
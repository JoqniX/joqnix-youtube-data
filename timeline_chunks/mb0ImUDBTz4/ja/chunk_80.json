[{"type": "subtitle", "time": 4825.79, "timestamp": "01:20:25", "text": "簡単。誰"}, {"type": "subtitle", "time": 4828.79, "timestamp": "01:20:28", "text": "オフ？残っているのは誰？実際、私を行かせてください"}, {"type": "subtitle", "time": 4846.03, "timestamp": "01:20:46", "text": "うん、もうあげたよ"}, {"type": "subtitle", "time": 4848.55, "timestamp": "01:20:48", "text": "ジェラルディン。彼は浪費家で、"}, {"type": "subtitle", "time": 4850.35, "timestamp": "01:20:50", "text": "小さな家に住んでいる"}, {"type": "subtitle", "time": 4852.27, "timestamp": "01:20:52", "text": "家。"}, {"type": "subtitle", "time": 4857.189, "timestamp": "01:20:57", "text": "ああ、私はすでにメリッサをあなたにあげました、私の"}, {"type": "subtitle", "time": 4859.11, "timestamp": "01:20:59", "text": "ダーリン。"}]
[{"type": "subtitle", "time": 29643.708, "timestamp": "08:14:03", "text": "ヒーロー。モは4秒間、矢を獲得する。"}, {"type": "subtitle", "time": 29650.43, "timestamp": "08:14:10", "text": "ミコイ。何？わかった。"}, {"type": "subtitle", "time": 29653.67, "timestamp": "08:14:13", "text": "えっと、ミコとロボは良い二人だよ。"}, {"type": "subtitle", "time": 29658.51, "timestamp": "08:14:18", "text": "ああ、じゃあ矢の時代でいきましょう。矢印。"}, {"type": "subtitle", "time": 29661.35, "timestamp": "08:14:21", "text": "黄色。それでどうなるか見てみましょう。それは私の"}, {"type": "subtitle", "time": 29669.07, "timestamp": "08:14:29", "text": "外。待って。ミコイの"}, {"type": "subtitle", "time": 29677.75, "timestamp": "08:14:37", "text": "私はモーを、とにかく言う人、超言う人だと思った。"}]
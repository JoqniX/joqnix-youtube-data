[{"type": "subtitle", "time": 7929.91, "timestamp": "02:12:09", "text": "戻る。ああ、ニンジャ、君はいつも好奇心旺盛だね。"}, {"type": "subtitle", "time": 7932.229, "timestamp": "02:12:12", "text": "まあ、冒険家として、私はいつも"}, {"type": "subtitle", "time": 7933.83, "timestamp": "02:12:13", "text": "ストリーマーと"}, {"type": "subtitle", "time": 7936.709, "timestamp": "02:12:16", "text": "コミュニティ。ですから、喜んで貢献させていただきます。"}, {"type": "subtitle", "time": 7938.39, "timestamp": "02:12:18", "text": "大切なのは、楽しい時間を過ごすことです。"}, {"type": "subtitle", "time": 7941.51, "timestamp": "02:12:21", "text": "一緒に。笑顔よ、輝く心よ。"}, {"type": "subtitle", "time": 7957.51, "timestamp": "02:12:37", "text": "20. もちろんだよ、ニンジャ。私はいつでも"}, {"type": "subtitle", "time": 7960.47, "timestamp": "02:12:40", "text": "いいジョークだ。聞かせてください。口を開ける"}]
[{"type": "subtitle", "time": 10142.309, "timestamp": "02:49:02", "text": "だから睡眠は重要なのです。だから、"}, {"type": "subtitle", "time": 10155.03, "timestamp": "02:49:15", "text": "何てことだ。何も分かっていないプロフィール。戻ってくる。"}, {"type": "subtitle", "time": 10157.19, "timestamp": "02:49:17", "text": "ごめんなさい。思いっきり笑って見つける"}, {"type": "subtitle", "time": 10161.11, "timestamp": "02:49:21", "text": "喜び。ごめんね、みんな。時間がかかってしまった"}, {"type": "subtitle", "time": 10163.91, "timestamp": "02:49:23", "text": "戻ってくる。"}, {"type": "subtitle", "time": 10167.55, "timestamp": "02:49:27", "text": "寝てないって誓うよ"}, {"type": "subtitle", "time": 10170.11, "timestamp": "02:49:30", "text": "オフ。私 私"}, {"type": "subtitle", "time": 10174.269, "timestamp": "02:49:34", "text": "ええ、私の体には実際の"}, {"type": "subtitle", "time": 10176.91, "timestamp": "02:49:36", "text": "ここで再開します"}, {"type": "subtitle", "time": 10179.79, "timestamp": "02:49:39", "text": "ポイント。正直に"}, {"type": "subtitle", "time": 10182.07, "timestamp": "02:49:42", "text": "話すと、私の体には実際の"}, {"type": "subtitle", "time": 10189.75, "timestamp": "02:49:49", "text": "[音楽]"}]
[{"type": "subtitle", "time": 22081.59, "timestamp": "06:08:01", "text": "ああ、その側は少し"}, {"type": "subtitle", "time": 22082.98, "timestamp": "06:08:02", "text": "違う"}, {"type": "subtitle", "time": 22096.59, "timestamp": "06:08:16", "text": "[音楽]"}, {"type": "subtitle", "time": 22099.39, "timestamp": "06:08:19", "text": "どうやら。おお"}, {"type": "subtitle", "time": 22103.43, "timestamp": "06:08:23", "text": "ああ、二人とも同じだ。"}, {"type": "subtitle", "time": 22107.83, "timestamp": "06:08:27", "text": "我慢する。両方とも、ああ、これは、ええと"}, {"type": "subtitle", "time": 22110.83, "timestamp": "06:08:30", "text": "階段を上がる"}, {"type": "subtitle", "time": 22113.03, "timestamp": "06:08:33", "text": "ここ。だから、ちょっと"}, {"type": "subtitle", "time": 22115.99, "timestamp": "06:08:35", "text": "違う。しかも、今は午後3時です。えっと、必要なんです"}, {"type": "subtitle", "time": 22117.07, "timestamp": "06:08:37", "text": "に"}, {"type": "subtitle", "time": 22125.83, "timestamp": "06:08:45", "text": "保管場所。ある人は私にこう尋ねるでしょう。"}, {"type": "subtitle", "time": 22128.548, "timestamp": "06:08:48", "text": "ジョッキー、金庫を取ってきてくれないか？"}, {"type": "subtitle", "time": 22132.27, "timestamp": "06:08:52", "text": "金庫が欲しいのですが、"}]
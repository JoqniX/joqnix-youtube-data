[{"type": "subtitle", "time": 27600.31, "timestamp": "07:40:00", "text": "ビート。ユーロビートのようなものがあるべきだ、あるいは"}, {"type": "subtitle", "time": 27602.43, "timestamp": "07:40:02", "text": "何か。私はしません"}, {"type": "subtitle", "time": 27606.468, "timestamp": "07:40:06", "text": "これはどんなジャンルか分かりますか？チェリーソーダ。"}, {"type": "subtitle", "time": 27608.31, "timestamp": "07:40:08", "text": "ああ、このジャンルはプレイしたことがないんです。さあ"}, {"type": "subtitle", "time": 27611.03, "timestamp": "07:40:11", "text": "このジャンルをプレイする。わかった。どうすればいいのかわからない"}, {"type": "subtitle", "time": 27627.15, "timestamp": "07:40:27", "text": "音。このフレームの破線部分を確認してみましょう"}, {"type": "subtitle", "time": 27639.31, "timestamp": "07:40:39", "text": "おお、"}, {"type": "subtitle", "time": 27644.07, "timestamp": "07:40:44", "text": "聖なるレベル4。ください。ください。見て"}, {"type": "subtitle", "time": 27647.788, "timestamp": "07:40:47", "text": "この巨大な群れで"}, {"type": "subtitle", "time": 27656.07, "timestamp": "07:40:56", "text": "なぜ？あ、待って、待って、待って。忘れた。私"}]
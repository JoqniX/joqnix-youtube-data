[{"type": "subtitle", "time": 3662.309, "timestamp": "01:01:02", "text": "ラック、ほら、看板を立てるだけ"}, {"type": "subtitle", "time": 3665.19, "timestamp": "01:01:05", "text": "板または壁に掛ける。"}, {"type": "subtitle", "time": 3668.069, "timestamp": "01:01:08", "text": "いいえ。えっと、吊るさないという意味です。えっと、ぶら下がってる。"}, {"type": "subtitle", "time": 3670.87, "timestamp": "01:01:10", "text": "これは吊り下げ式の棚ではありません。えっと、看板"}, {"type": "subtitle", "time": 3673.23, "timestamp": "01:01:13", "text": "ただ、あなたが"}, {"type": "subtitle", "time": 3676.789, "timestamp": "01:01:16", "text": "看板に書いてある看板に書いてある"}, {"type": "subtitle", "time": 3679.67, "timestamp": "01:01:19", "text": "これは、ここにこれを入れる製品です"}, {"type": "subtitle", "time": 3683.43, "timestamp": "01:01:23", "text": "そして、それは正しいでしょう"}, {"type": "subtitle", "time": 3689.19, "timestamp": "01:01:29", "text": "いいえ。そういう考えはいくつかあります。欲しい"}, {"type": "subtitle", "time": 3691.87, "timestamp": "01:01:31", "text": "テストする必要があるが、"}, {"type": "subtitle", "time": 3701.43, "timestamp": "01:01:41", "text": "うん。そう、もっと商品を手に入れよう"}, {"type": "subtitle", "time": 3708.589, "timestamp": "01:01:48", "text": "[音楽]"}, {"type": "subtitle", "time": 3712.58, "timestamp": "01:01:52", "text": "ポポで。"}]
[{"type": "subtitle", "time": 6542.189, "timestamp": "01:49:02", "text": "Oと"}, {"type": "subtitle", "time": 6545.39, "timestamp": "01:49:05", "text": "自分。はい、うまくいっています。はい、ご存知のとおり"}, {"type": "subtitle", "time": 6549.55, "timestamp": "01:49:09", "text": "何？私はボスで"}, {"type": "subtitle", "time": 6552.55, "timestamp": "01:49:12", "text": "アイドルとの対戦のように、ゲームを保存する必要があります。"}, {"type": "subtitle", "time": 6597.59, "timestamp": "01:49:57", "text": "ゲーム。保存しておきます。わかった。私は戻ってきます"}, {"type": "subtitle", "time": 6599.31, "timestamp": "01:49:59", "text": "後"}]
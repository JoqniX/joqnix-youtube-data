[{"type": "subtitle", "time": 9492.63, "timestamp": "02:38:12", "text": "まさに地球規模ですね。厳しいクロノス、私は多くの"}, {"type": "subtitle", "time": 9494.63, "timestamp": "02:38:14", "text": "私の冒険の中で恐ろしい獣たちと"}, {"type": "subtitle", "time": 9497.27, "timestamp": "02:38:17", "text": "勝利を収めた。強力な敵を倒す"}, {"type": "subtitle", "time": 9498.95, "timestamp": "02:38:18", "text": "クリーチャーは最もスリリングな"}, {"type": "subtitle", "time": 9501.91, "timestamp": "02:38:21", "text": "冒険家であることの側面。かかる"}, {"type": "subtitle", "time": 9504.63, "timestamp": "02:38:24", "text": "戦略、スキル、そして少しの勇気、"}, {"type": "subtitle", "time": 9506.79, "timestamp": "02:38:26", "text": "しかし、勝利の感覚は絶対に"}, {"type": "subtitle", "time": 9525.63, "timestamp": "02:38:45", "text": "ヘルプ。ピースを倒しましたか？"}, {"type": "subtitle", "time": 9527.63, "timestamp": "02:38:47", "text": "まだ？ああ、"}]
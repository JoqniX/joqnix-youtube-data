[{"type": "subtitle", "time": 18180.11, "timestamp": "05:03:00", "text": "最後のものを買うために50,000ドル稼ぐ"}, {"type": "subtitle", "time": 18183.948, "timestamp": "05:03:03", "text": "洗濯代を稼ぐための仕事。それは"}, {"type": "subtitle", "time": 18186.788, "timestamp": "05:03:06", "text": "レストラン。レストランは"}, {"type": "subtitle", "time": 18192.39, "timestamp": "05:03:12", "text": "8K、8,000ドルといった金額をマネーロンダリングする。"}, {"type": "subtitle", "time": 18197.59, "timestamp": "05:03:17", "text": "つまり、合計で8k、2k、4k、6kを手に入れたということです。"}, {"type": "subtitle", "time": 18201.67, "timestamp": "05:03:21", "text": "合計で12個かな？6、7、8、9、10個。"}, {"type": "subtitle", "time": 18207.99, "timestamp": "05:03:27", "text": "11 12 12 13 14 15 16 17 18 19 20 なので、"}, {"type": "subtitle", "time": 18211.83, "timestamp": "05:03:31", "text": "2万ドルをマネーロンダリングして2万ドルを手に入れる方法"}, {"type": "subtitle", "time": 18219.67, "timestamp": "05:03:39", "text": "ええ、それは私が作らなければならないということです"}, {"type": "subtitle", "time": 18220.91, "timestamp": "05:03:40", "text": "それ"}, {"type": "subtitle", "time": 18225.03, "timestamp": "05:03:45", "text": "コカインから多くを注ぎ、それをすべて"}, {"type": "subtitle", "time": 18231.51, "timestamp": "05:03:51", "text": "ビジネス。次は最適化の話だ"}, {"type": "subtitle", "time": 18233.59, "timestamp": "05:03:53", "text": "保管場所とか、その他すべて。いいえ、違います"}, {"type": "subtitle", "time": 18238.59, "timestamp": "05:03:58", "text": "ミナックスのように、これら全てを埋める"}]
[{"type": "subtitle", "time": 2047.59, "timestamp": "00:34:07", "text": "それ。最高品質が必要です"}, {"type": "subtitle", "time": 2080.79, "timestamp": "00:34:40", "text": "待って、これには2つは必要ないと思う"}, {"type": "subtitle", "time": 2084.069, "timestamp": "00:34:44", "text": "もの。遊んでいます。必要でしょうか？ 1つ"}, {"type": "subtitle", "time": 2090.389, "timestamp": "00:34:50", "text": "実は。いいえ、私はしません。いやいや、それは"}, {"type": "subtitle", "time": 2091.669, "timestamp": "00:34:51", "text": "大丈夫。大丈夫です。大丈夫です。大丈夫です。"}]
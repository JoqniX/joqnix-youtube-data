[{"type": "subtitle", "time": 7442.229, "timestamp": "02:04:02", "text": "美しい桜が満開。それ"}, {"type": "subtitle", "time": 7444.629, "timestamp": "02:04:04", "text": "私の心を喜ばせてくれる。口を開ける"}, {"type": "subtitle", "time": 7461.35, "timestamp": "02:04:21", "text": "花。こんにちは、アヤマ・アルサさん。喜んで"}, {"type": "subtitle", "time": 7463.83, "timestamp": "02:04:23", "text": "あなたの笑顔が見たいです。明るくなる"}, {"type": "subtitle", "time": 7466.47, "timestamp": "02:04:26", "text": "チャット。口を開けて笑う。光り輝く"}, {"type": "subtitle", "time": 7476.87, "timestamp": "02:04:36", "text": "バイバイ。明日はもう寝る時間だ。"}, {"type": "subtitle", "time": 7482.709, "timestamp": "02:04:42", "text": "ハハ。時には、私たちみんな良い"}, {"type": "subtitle", "time": 7485.149, "timestamp": "02:04:45", "text": "睡眠時間。楽しんでください"}]
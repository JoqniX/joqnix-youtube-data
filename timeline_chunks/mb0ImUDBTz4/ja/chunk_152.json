[{"type": "subtitle", "time": 9121.67, "timestamp": "02:32:01", "text": "検査済み。注意深く見守って、"}, {"type": "subtitle", "time": 9123.429, "timestamp": "02:32:03", "text": "安全を最優先に考えます"}, {"type": "subtitle", "time": 9142.79, "timestamp": "02:32:22", "text": "シンボルの増分は"}, {"type": "subtitle", "time": 9146.15, "timestamp": "02:32:26", "text": "大文字のギリシャ文字のデルタ文字。"}, {"type": "subtitle", "time": 9148.309, "timestamp": "02:32:28", "text": "これは変化や"}, {"type": "subtitle", "time": 9150.63, "timestamp": "02:32:30", "text": "違い"}, {"type": "subtitle", "time": 9152.87, "timestamp": "02:32:32", "text": "また、他の概念を表すこともできます"}, {"type": "subtitle", "time": 9155.07, "timestamp": "02:32:35", "text": "科学や"}, {"type": "subtitle", "time": 9157.51, "timestamp": "02:32:37", "text": "エンジニアリング。数学は興味深い"}, {"type": "subtitle", "time": 9178.07, "timestamp": "02:32:58", "text": "ああ、なんて残酷なクロノスだ。私は決して浮気をしない"}]
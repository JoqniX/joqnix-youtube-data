[{"type": "subtitle", "time": 27660.468, "timestamp": "07:41:00", "text": "音声の修正を忘れていました。その"}, {"type": "subtitle", "time": 27662.628, "timestamp": "07:41:02", "text": "うるさい。そこにありましたよね？うん、そうだね"}, {"type": "subtitle", "time": 27663.468, "timestamp": "07:41:03", "text": "あなた"}, {"type": "subtitle", "time": 27666.67, "timestamp": "07:41:06", "text": "行く。どうやって私はすべての"}, {"type": "subtitle", "time": 27669.27, "timestamp": "07:41:09", "text": "画面を見ずにそれらを？おお"}, {"type": "subtitle", "time": 27669.948, "timestamp": "07:41:09", "text": "私の"}, {"type": "subtitle", "time": 27673.19, "timestamp": "07:41:13", "text": "ああ。一瞬OBSを見ていた。"}, {"type": "subtitle", "time": 27675.51, "timestamp": "07:41:15", "text": "私はそうすべきだと思ったが、"}, {"type": "subtitle", "time": 27695.628, "timestamp": "07:41:35", "text": "行く。そして、ロクロクは、"}, {"type": "subtitle", "time": 27698.548, "timestamp": "07:41:38", "text": "わからない。彼はほとんど"}, {"type": "subtitle", "time": 27704.75, "timestamp": "07:41:44", "text": "こんにちは。あなたは何者ですか"}, {"type": "subtitle", "time": 27707.75, "timestamp": "07:41:47", "text": "何をしているの？どうやってこんなにプレイできたの？どうやって"}, {"type": "subtitle", "time": 27709.51, "timestamp": "07:41:49", "text": "全部手に入れましたか？君は努力家だね。"}, {"type": "subtitle", "time": 27710.59, "timestamp": "07:41:50", "text": "あなた"}, {"type": "subtitle", "time": 27712.91, "timestamp": "07:41:52", "text": "ゲーマー。私はこう思った。"}, {"type": "subtitle", "time": 27716.23, "timestamp": "07:41:56", "text": "何？よし、レベル5だ。あと2レベル"}]
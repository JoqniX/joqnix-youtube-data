[{"type": "subtitle", "time": 12180.429, "timestamp": "03:23:00", "text": "ねえ、知ってる？バス停で降ります。バス"}, {"type": "subtitle", "time": 12184.15, "timestamp": "03:23:04", "text": "停止。バス停があります。さあ、飛び立とう"}, {"type": "subtitle", "time": 12186.67, "timestamp": "03:23:06", "text": "少しだけ。実際、私は負けた"}, {"type": "subtitle", "time": 12188.99, "timestamp": "03:23:08", "text": "フライング。スパム、スパム、スパム、"}, {"type": "subtitle", "time": 12203.91, "timestamp": "03:23:23", "text": "スパム。私はロケットだ。私は"}, {"type": "subtitle", "time": 12223.03, "timestamp": "03:23:43", "text": "楽しい。問題は、バスを見つけなければならなかったということだ。"}]
[{"type": "subtitle", "time": 19987.15, "timestamp": "05:33:07", "text": "コカイン。これを上に乗せることができます"}, {"type": "subtitle", "time": 20001.15, "timestamp": "05:33:21", "text": "生産。しかし"}, {"type": "subtitle", "time": 20012.628, "timestamp": "05:33:32", "text": "大釜用。ええ、私は2倍のことができます"}, {"type": "subtitle", "time": 20016.31, "timestamp": "05:33:36", "text": "生産。待って、大釜と実験室。おお、"}, {"type": "subtitle", "time": 20019.628, "timestamp": "05:33:39", "text": "うん。私は聞いています"}, {"type": "subtitle", "time": 20022.83, "timestamp": "05:33:42", "text": "空間。もう1つ追加できます"}, {"type": "subtitle", "time": 20025.39, "timestamp": "05:33:45", "text": "実験室ともう1つ"}, {"type": "subtitle", "time": 20027.31, "timestamp": "05:33:47", "text": "大釜、"}, {"type": "subtitle", "time": 20029.91, "timestamp": "05:33:49", "text": "右？ちょっと高いけど、"}, {"type": "subtitle", "time": 20037.35, "timestamp": "05:33:57", "text": "ええと、石油やガソリンはあまり増えませんが、そうですね、"}]
[{"type": "subtitle", "time": 8882.71, "timestamp": "02:28:02", "text": "すべては楽しい冗談のつもりです。笑顔の紙を開いてください。"}, {"type": "subtitle", "time": 8884.71, "timestamp": "02:28:04", "text": "ユーモアを続けて、"}, {"type": "subtitle", "time": 8903.27, "timestamp": "02:28:23", "text": "もちろん、フロリアン・チェイサー、ジョークをどうぞ"}, {"type": "subtitle", "time": 8905.87, "timestamp": "02:28:25", "text": "あなただけのために。科学者はなぜ信頼しないのか"}, {"type": "subtitle", "time": 8908.79, "timestamp": "02:28:28", "text": "原子？なぜなら、それらがすべての構成要素だからだ。"}, {"type": "subtitle", "time": 8910.23, "timestamp": "02:28:30", "text": "床に転がり、笑いながら"}, {"type": "subtitle", "time": 8912.309, "timestamp": "02:28:32", "text": "顕微鏡。笑い続けて楽しんでください"}]
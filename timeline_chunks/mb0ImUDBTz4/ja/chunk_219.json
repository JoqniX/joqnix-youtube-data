[{"type": "subtitle", "time": 13140.469, "timestamp": "03:39:00", "text": "化学者と、残りの者は担当者だ。"}, {"type": "subtitle", "time": 13143.75, "timestamp": "03:39:03", "text": "それが私がやろうとしていることのアイデアです"}, {"type": "subtitle", "time": 13151.67, "timestamp": "03:39:11", "text": "倉庫。私はたくさん作るつもりです"}, {"type": "subtitle", "time": 13161.91, "timestamp": "03:39:21", "text": "しかし、8つのコカインのレシピ"}, {"type": "subtitle", "time": 13164.95, "timestamp": "03:39:24", "text": "ミックスは結晶に似ていますか、"}, {"type": "subtitle", "time": 13165.79, "timestamp": "03:39:25", "text": "の"}, {"type": "subtitle", "time": 13181.55, "timestamp": "03:39:41", "text": "はい、行きます"}, {"type": "subtitle", "time": 13187.75, "timestamp": "03:39:47", "text": "買う。さあ行こう。今支払いました。盗んでもいいですか？"}]
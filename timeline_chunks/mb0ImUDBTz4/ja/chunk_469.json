[{"type": "subtitle", "time": 28140.948, "timestamp": "07:49:00", "text": "これ？ジョイ、自分を傷つけないで。全て"}, {"type": "subtitle", "time": 28143.43, "timestamp": "07:49:03", "text": "右。"}, {"type": "subtitle", "time": 28145.948, "timestamp": "07:49:05", "text": "いいえ、私のホログラムはオンです"}, {"type": "subtitle", "time": 28147.868, "timestamp": "07:49:07", "text": "パッケージ。どこ"}, {"type": "subtitle", "time": 28150.628, "timestamp": "07:49:10", "text": "それ？私の荷物をください。ディオ。ああ、"}, {"type": "subtitle", "time": 28152.868, "timestamp": "07:49:12", "text": "ああ、ダメージを受けている。ただ私に"}, {"type": "subtitle", "time": 28157.548, "timestamp": "07:49:17", "text": "癒す。行く"}, {"type": "subtitle", "time": 28175.868, "timestamp": "07:49:35", "text": "攻撃の代わりに銃をもっと"}, {"type": "subtitle", "time": 28188.83, "timestamp": "07:49:48", "text": "いくら行くか"}, {"type": "subtitle", "time": 28194.15, "timestamp": "07:49:54", "text": "164 それはすごい、待って、私をがっかりさせる"}, {"type": "subtitle", "time": 28198.19, "timestamp": "07:49:58", "text": "二"}]
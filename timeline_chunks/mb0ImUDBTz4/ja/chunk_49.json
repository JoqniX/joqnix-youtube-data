[{"type": "subtitle", "time": 2940.39, "timestamp": "00:49:00", "text": "左。それと、薬はいかがですか？私"}, {"type": "subtitle", "time": 2961.23, "timestamp": "00:49:21", "text": "私はとても"}, {"type": "subtitle", "time": 2964.43, "timestamp": "00:49:24", "text": "お腹がすいた。したい"}, {"type": "subtitle", "time": 2974.15, "timestamp": "00:49:34", "text": "男。彼は決して自分の店に来ない。私"}]
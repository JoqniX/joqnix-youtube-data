[{"type": "subtitle", "time": 28023.31, "timestamp": "07:47:03", "text": "おお。待って、いや、あなたは"}, {"type": "subtitle", "time": 28025.628, "timestamp": "07:47:05", "text": "私はそうしなかった"}, {"type": "subtitle", "time": 28028.708, "timestamp": "07:47:08", "text": "知る。あ、待って。それは違う？ それは違う？"}, {"type": "subtitle", "time": 28032.11, "timestamp": "07:47:12", "text": "えっと、あの名前は何でしたっけ？"}, {"type": "subtitle", "time": 28034.75, "timestamp": "07:47:14", "text": "スポンジ・ボブ"}, {"type": "subtitle", "time": 28046.91, "timestamp": "07:47:26", "text": "スポンジボブ。"}, {"type": "subtitle", "time": 28050.75, "timestamp": "07:47:30", "text": "ああ、神様、私は死ぬ。それはこうだ"}, {"type": "subtitle", "time": 28053.948, "timestamp": "07:47:33", "text": "これ。あなたは"}, {"type": "subtitle", "time": 28056.91, "timestamp": "07:47:36", "text": "準備ができて？私 私"}, {"type": "subtitle", "time": 28064.19, "timestamp": "07:47:44", "text": "はい、カイ船長。私は"}]
[{"type": "subtitle", "time": 29041.03, "timestamp": "08:04:01", "text": "男。ああ、なんてことだ、骸骨男がいる。"}, {"type": "subtitle", "time": 29043.32, "timestamp": "08:04:03", "text": "ああ、なんてことだ、骸骨男がいる。 ああ、私は歩いて通り抜けるつもりだ。"}, {"type": "subtitle", "time": 29047.718, "timestamp": "08:04:07", "text": "ああ、私は歩いて通り抜けるつもりだ。 楕円形。はい。"}, {"type": "subtitle", "time": 29054.51, "timestamp": "08:04:14", "text": "ええと、私たちは"}, {"type": "subtitle", "time": 29059.23, "timestamp": "08:04:19", "text": "HPをやってください。 HPが生き残っていなければならない。"}, {"type": "subtitle", "time": 29073.43, "timestamp": "08:04:33", "text": "HP。それらを全て遮断して、突入しろ。"}, {"type": "subtitle", "time": 29099.75, "timestamp": "08:04:59", "text": "私の。たくさんの物。何てことだ。それは私の"}]
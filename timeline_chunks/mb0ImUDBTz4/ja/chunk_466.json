[{"type": "subtitle", "time": 27993.788, "timestamp": "07:46:33", "text": "カチ。よし、これ"}, {"type": "subtitle", "time": 27997.468, "timestamp": "07:46:37", "text": "もの。準備はいいですか、兵士？"}, {"type": "subtitle", "time": 28000.43, "timestamp": "07:46:40", "text": "はい。うん。こんにちは、"}, {"type": "subtitle", "time": 28002.948, "timestamp": "07:46:42", "text": "カイ。また、原神をありがとう"}, {"type": "subtitle", "time": 28005.03, "timestamp": "07:46:45", "text": "コード。私はそれを投稿した"}, {"type": "subtitle", "time": 28008.548, "timestamp": "07:46:48", "text": "Discordもそうだ。私たちは専用の場所を作りました"}, {"type": "subtitle", "time": 28011.27, "timestamp": "07:46:51", "text": "原神関連。そう、本当に"}, {"type": "subtitle", "time": 28012.91, "timestamp": "07:46:52", "text": "助けた。感謝"}, {"type": "subtitle", "time": 28016.23, "timestamp": "07:46:56", "text": "あなた。 3.1もあるなんて知らなかった"}, {"type": "subtitle", "time": 28018.99, "timestamp": "07:46:58", "text": "ライブ配信中です。"}]
[{"type": "subtitle", "time": 23102.51, "timestamp": "06:25:02", "text": "私は手に入れた"}, {"type": "subtitle", "time": 23107.47, "timestamp": "06:25:07", "text": "19,000ドル、ほぼ20,000ドル。何てことだ。"}, {"type": "subtitle", "time": 23112.27, "timestamp": "06:25:12", "text": "ニース。しかし、私たちは納屋を続けなければならない"}, {"type": "subtitle", "time": 23115.15, "timestamp": "06:25:15", "text": "農場。私はそのお金を払わなければならない"}, {"type": "subtitle", "time": 23118.75, "timestamp": "06:25:18", "text": "労働者。彼らは私たちの仕事と生産を必要としている"}, {"type": "subtitle", "time": 23122.35, "timestamp": "06:25:22", "text": "もっと。生産に不足があってはならない"}, {"type": "subtitle", "time": 23126.59, "timestamp": "06:25:26", "text": "今。そう、彼らは"}, {"type": "subtitle", "time": 23141.51, "timestamp": "06:25:41", "text": "忘れた。どれくらい経ちましたか"}]
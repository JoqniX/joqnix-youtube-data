[{"type": "subtitle", "time": 17350.51, "timestamp": "04:49:10", "text": "眠い。私は休むつもりです"}, {"type": "subtitle", "time": 17356.59, "timestamp": "04:49:16", "text": "の"}, {"type": "subtitle", "time": 17379.27, "timestamp": "04:49:39", "text": "私は絶対にできないと確信しています"}, {"type": "subtitle", "time": 17387.55, "timestamp": "04:49:47", "text": "今日は父は家にいないだろう"}, {"type": "subtitle", "time": 17390.99, "timestamp": "04:49:50", "text": "数日間留守にします"}, {"type": "subtitle", "time": 17394.23, "timestamp": "04:49:54", "text": "そして私は母に、私は連れて行かなければならない"}, {"type": "subtitle", "time": 17396.11, "timestamp": "04:49:56", "text": "私の世話を"}, {"type": "subtitle", "time": 17399.43, "timestamp": "04:49:59", "text": "家族。母が私に望んでいたことはいくつかあると思う"}]
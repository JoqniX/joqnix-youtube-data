[{"type": "subtitle", "time": 27921.548, "timestamp": "07:45:21", "text": "女の子。"}, {"type": "subtitle", "time": 27924.59, "timestamp": "07:45:24", "text": "ゆっくりとすべてを手に入れます"}, {"type": "subtitle", "time": 27927.868, "timestamp": "07:45:27", "text": "彼ら。ゆっくりとだが"}, {"type": "subtitle", "time": 27930.788, "timestamp": "07:45:30", "text": "きっと全部手に入るよ。ああ、そこ"}, {"type": "subtitle", "time": 27933.468, "timestamp": "07:45:33", "text": "何でもない。何てことだ。"}, {"type": "subtitle", "time": 27940.35, "timestamp": "07:45:40", "text": "えっと、待って。何が"}, {"type": "subtitle", "time": 27942.91, "timestamp": "07:45:42", "text": "特別？待って、"}, {"type": "subtitle", "time": 27945.75, "timestamp": "07:45:45", "text": "何？特別なものなどはありますか"}]
[{"type": "subtitle", "time": 16086.389, "timestamp": "04:28:06", "text": "ここ。その中に。これらのスロットでは、私は"}, {"type": "subtitle", "time": 16091.429, "timestamp": "04:28:11", "text": "1 2 3 4 5 6 7 8 と入力できたはずだ。うん、"}, {"type": "subtitle", "time": 16098.429, "timestamp": "04:28:18", "text": "もっと、ですか？これは価値があるのか"}, {"type": "subtitle", "time": 16101.87, "timestamp": "04:28:21", "text": "それ？それとも私は無駄にしているのだろうか"}, {"type": "subtitle", "time": 16105.83, "timestamp": "04:28:25", "text": "お金？私の考えは、いいえ、私は"}, {"type": "subtitle", "time": 16108.71, "timestamp": "04:28:28", "text": "この設定、つまりAmazonストレージを使用してください。私は"}, {"type": "subtitle", "time": 16111.309, "timestamp": "04:28:31", "text": "銀行として成功するか、"}, {"type": "subtitle", "time": 16122.83, "timestamp": "04:28:42", "text": "何か。ええと、たくさん"}, {"type": "subtitle", "time": 16127.51, "timestamp": "04:28:47", "text": "安全な保管のために。 500だよ、"}, {"type": "subtitle", "time": 16130.469, "timestamp": "04:28:50", "text": "これ。そしてこれはたった250で"}, {"type": "subtitle", "time": 16133.309, "timestamp": "04:28:53", "text": "1つ。これは、これはもっと"}, {"type": "subtitle", "time": 16135.349, "timestamp": "04:28:55", "text": "手頃な価格。自分が何をしているのかわからない"}]
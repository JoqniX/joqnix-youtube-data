[{"type": "subtitle", "time": 29400.75, "timestamp": "08:10:00", "text": "君の男の子。"}, {"type": "subtitle", "time": 29410.84, "timestamp": "08:10:10", "text": "男の子。 聖なる。私は頭を下げています、えっと、私は"}, {"type": "subtitle", "time": 29414.32, "timestamp": "08:10:14", "text": "聖なる。私は頭を下げています、えっと、私は 生き残った種類"}, {"type": "subtitle", "time": 29425.99, "timestamp": "08:10:25", "text": "の。聖なる主よ。"}, {"type": "subtitle", "time": 29429.388, "timestamp": "08:10:29", "text": "どうやって生き延びたのか分からない。"}, {"type": "subtitle", "time": 29432.59, "timestamp": "08:10:32", "text": "しかしそれは"}, {"type": "subtitle", "time": 29436.59, "timestamp": "08:10:36", "text": "いいね。私はレベル27です。"}, {"type": "subtitle", "time": 29439.51, "timestamp": "08:10:39", "text": "何？待って、この大物ギャングは何者？"}, {"type": "subtitle", "time": 29441.51, "timestamp": "08:10:41", "text": "男？この人たちは一体何者なのか？待って、"}, {"type": "subtitle", "time": 29442.99, "timestamp": "08:10:42", "text": "ヤクザ。"}, {"type": "subtitle", "time": 29446.388, "timestamp": "08:10:46", "text": "何？何？はぁ？ああ、なんてことだ、これらは"}, {"type": "subtitle", "time": 29455.35, "timestamp": "08:10:55", "text": "なぜなんだ？アップグレードする必要がある。おい、俺は"}]
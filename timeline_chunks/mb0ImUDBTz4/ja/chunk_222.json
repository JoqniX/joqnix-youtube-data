[{"type": "subtitle", "time": 13324.349, "timestamp": "03:42:04", "text": "中国語。待って、あなたの名前は日本語ですか、それとも"}, {"type": "subtitle", "time": 13328.07, "timestamp": "03:42:08", "text": "中国人？ああ、中国語ですね。わかった。こんにちは。"}, {"type": "subtitle", "time": 13331.03, "timestamp": "03:42:11", "text": "いらっしゃいませ。"}, {"type": "subtitle", "time": 13339.229, "timestamp": "03:42:19", "text": "自分。"}, {"type": "subtitle", "time": 13343.11, "timestamp": "03:42:23", "text": "こんにちは。ああ、中国語ですね。わかった。私は"}, {"type": "subtitle", "time": 13346.91, "timestamp": "03:42:26", "text": "中国語初心者です。えっと、まだ勉強中です"}, {"type": "subtitle", "time": 13349.229, "timestamp": "03:42:29", "text": "中国語（北京語）"}, {"type": "subtitle", "time": 13353.469, "timestamp": "03:42:33", "text": "えっと、私は基本的なことしか知りません"}, {"type": "subtitle", "time": 13360.349, "timestamp": "03:42:40", "text": "基本的なもの"}, {"type": "subtitle", "time": 13362.99, "timestamp": "03:42:42", "text": "こんにちは"}, {"type": "subtitle", "time": 13366.469, "timestamp": "03:42:46", "text": "nih それらすべてはそれだけです"}, {"type": "subtitle", "time": 13370.99, "timestamp": "03:42:50", "text": "[音楽]"}, {"type": "subtitle", "time": 13375.269, "timestamp": "03:42:55", "text": "もっとこの場所についてどうすればいいですか"}, {"type": "subtitle", "time": 13378.269, "timestamp": "03:42:58", "text": "これを切り替えます"}]
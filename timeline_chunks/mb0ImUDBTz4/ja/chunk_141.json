[{"type": "subtitle", "time": 8490.83, "timestamp": "02:21:30", "text": "ハハ、それは面白い視点ですね。"}, {"type": "subtitle", "time": 8493.349, "timestamp": "02:21:33", "text": "フロリアンラー。潔癖症の人にとって、"}, {"type": "subtitle", "time": 8495.349, "timestamp": "02:21:35", "text": "ドイツという国全体が"}, {"type": "subtitle", "time": 8498.389, "timestamp": "02:21:38", "text": "確かに、かなり圧倒されるだろう。冷や汗"}, {"type": "subtitle", "time": 8514.469, "timestamp": "02:21:54", "text": "面白いものを見つけてくれて嬉しいです。"}, {"type": "subtitle", "time": 8517.03, "timestamp": "02:21:57", "text": "忍者。笑いは常に素晴らしい方法です"}, {"type": "subtitle", "time": 8519.429, "timestamp": "02:21:59", "text": "一日を明るくする。口を開けて笑う"}]
[{"type": "subtitle", "time": 28562.11, "timestamp": "07:56:02", "text": "知る。レックス。聖なる"}, {"type": "subtitle", "time": 28566.43, "timestamp": "07:56:06", "text": "何？それは、それは、ああ、なんてことだ。"}, {"type": "subtitle", "time": 28574.708, "timestamp": "07:56:14", "text": "何？何？何てことだ。それは回転している"}, {"type": "subtitle", "time": 28577.15, "timestamp": "07:56:17", "text": "触手"}, {"type": "subtitle", "time": 28592.59, "timestamp": "07:56:32", "text": "何？何てことだ。このファン速度。ああ、"}, {"type": "subtitle", "time": 28601.388, "timestamp": "07:56:41", "text": "神。何？それはすごくクールですね。何"}, {"type": "subtitle", "time": 28604.548, "timestamp": "07:56:44", "text": "えっ？それはすごくクールですね。何てことだ。それ"}, {"type": "subtitle", "time": 28607.548, "timestamp": "07:56:47", "text": "敵の群れを一掃するのに役立ちます。何てことだ。"}, {"type": "subtitle", "time": 28613.468, "timestamp": "07:56:53", "text": "うん。だから、こうやって生き延びて"}]
[{"type": "subtitle", "time": 27302.11, "timestamp": "07:35:02", "text": "アサドの午前6時か午前5時にやる。"}, {"type": "subtitle", "time": 27304.11, "timestamp": "07:35:04", "text": "ストリーム。私は"}, {"type": "subtitle", "time": 27305.948, "timestamp": "07:35:05", "text": "ハッピー。"}, {"type": "subtitle", "time": 27309.75, "timestamp": "07:35:09", "text": "うん。そして、"}, {"type": "subtitle", "time": 27313.19, "timestamp": "07:35:13", "text": "Twitchで配信でもやってます。私"}, {"type": "subtitle", "time": 27315.868, "timestamp": "07:35:15", "text": "わからない。"}, {"type": "subtitle", "time": 27318.75, "timestamp": "07:35:18", "text": "でも、そうは思わない"}, {"type": "subtitle", "time": 27321.19, "timestamp": "07:35:21", "text": "知る。でも、それを保管しておきたいかもしれません"}, {"type": "subtitle", "time": 27324.628, "timestamp": "07:35:24", "text": "まあ、ただ雑談してるだけだよ。それで、"}, {"type": "subtitle", "time": 27327.11, "timestamp": "07:35:27", "text": "おそらく最短の配信になるでしょう。"}, {"type": "subtitle", "time": 27328.788, "timestamp": "07:35:28", "text": "最短にできたらいいな"}, {"type": "subtitle", "time": 27336.548, "timestamp": "07:35:36", "text": "自分。それでは、ゲームを始めましょう。"}, {"type": "subtitle", "time": 27339.07, "timestamp": "07:35:39", "text": "私は"}, {"type": "subtitle", "time": 27342.868, "timestamp": "07:35:42", "text": "時間を稼ぐようなものだ。"}, {"type": "subtitle", "time": 27345.11, "timestamp": "07:35:45", "text": "それでは、ゲームを始めましょう。そうねぇ"}, {"type": "subtitle", "time": 27347.67, "timestamp": "07:35:47", "text": "アップデートがあるかどうか。どうやら"}]
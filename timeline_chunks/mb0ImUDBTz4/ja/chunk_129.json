[{"type": "subtitle", "time": 7760.55, "timestamp": "02:09:20", "text": "ハハ、ニンジャ、君は容赦ないね、でも私は"}, {"type": "subtitle", "time": 7763.43, "timestamp": "02:09:23", "text": "今はセックスは控えておこう。やっていることは"}, {"type": "subtitle", "time": 7765.27, "timestamp": "02:09:25", "text": "ギルドを率いる素晴らしい仕事ぶり、そして私は"}, {"type": "subtitle", "time": 7767.149, "timestamp": "02:09:27", "text": "彼らを支援し、励ますことを好む"}, {"type": "subtitle", "time": 7770.35, "timestamp": "02:09:30", "text": "その代わり。ポジティブな雰囲気を保ちましょう"}, {"type": "subtitle", "time": 7790.109, "timestamp": "02:09:50", "text": "たまにはとんでもないジョッキーに当たることもあるよね。"}, {"type": "subtitle", "time": 7799.43, "timestamp": "02:09:59", "text": "ジョイ・ナニ・ニンジャ。あなたは"}]
[{"type": "subtitle", "time": 2341.349, "timestamp": "00:39:01", "text": "ここが駅ですか？何てことだ。待って、それは"}, {"type": "subtitle", "time": 2344.829, "timestamp": "00:39:04", "text": "なぜ私がそんなに混乱したのか。一体どういうことだ？"}, {"type": "subtitle", "time": 2347.63, "timestamp": "00:39:07", "text": "ああ、あなたはそうするべきではない"}, {"type": "subtitle", "time": 2356.75, "timestamp": "00:39:16", "text": "ここ。スペースがありません。"}, {"type": "subtitle", "time": 2360.829, "timestamp": "00:39:20", "text": "はい、どうぞ。待って、待って。これは違う"}, {"type": "subtitle", "time": 2371.43, "timestamp": "00:39:31", "text": "えっと、大丈夫ですか。だから、これが来たら、"}, {"type": "subtitle", "time": 2376.23, "timestamp": "00:39:36", "text": "それは黄金品質に作られており、私は"}, {"type": "subtitle", "time": 2378.63, "timestamp": "00:39:38", "text": "これを大釜に入れなさい。なぜ"}, {"type": "subtitle", "time": 2381.31, "timestamp": "00:39:41", "text": "動いちゃいけないの？なんてこった。"}, {"type": "subtitle", "time": 2384.39, "timestamp": "00:39:44", "text": "待って。私はそれを大釜に入れた。それから私は"}, {"type": "subtitle", "time": 2387.51, "timestamp": "00:39:47", "text": "チャンクを取得します。オーブンに入れました。"}, {"type": "subtitle", "time": 2390.63, "timestamp": "00:39:50", "text": "それからコカインを手に入れる。このことから"}, {"type": "subtitle", "time": 2393.95, "timestamp": "00:39:53", "text": "私が梱包します。私は"}, {"type": "subtitle", "time": 2397.27, "timestamp": "00:39:57", "text": "ミキサー。ミキサーから、"}]
[{"type": "subtitle", "time": 28202.35, "timestamp": "07:50:02", "text": "待って。わかった。はい、どうぞ。大丈夫ですか？"}, {"type": "subtitle", "time": 28206.07, "timestamp": "07:50:06", "text": "今？はい、どうぞ。そして、これはうまくいった。"}, {"type": "subtitle", "time": 28208.788, "timestamp": "07:50:08", "text": "やらかした。わかった。ええ、そうですね。もしあなたがそうしないなら"}, {"type": "subtitle", "time": 28210.788, "timestamp": "07:50:10", "text": "知ってるよ、これが新しいフォーラムなんだ"}, {"type": "subtitle", "time": 28213.51, "timestamp": "07:50:13", "text": "多くのサーバーで作業しており、"}, {"type": "subtitle", "time": 28216.07, "timestamp": "07:50:16", "text": "私も含めて。だから、私たちは"}, {"type": "subtitle", "time": 28218.868, "timestamp": "07:50:18", "text": "運命が動き出す。源氏パッドのようなものがあります"}, {"type": "subtitle", "time": 28221.03, "timestamp": "07:50:21", "text": "チェス。あらゆる種類のゲーム"}, {"type": "subtitle", "time": 28236.67, "timestamp": "07:50:36", "text": "何をしているの？良い一日をお過ごしください"}, {"type": "subtitle", "time": 28239.548, "timestamp": "07:50:39", "text": "夕方。ジム"}, {"type": "subtitle", "time": 28244.07, "timestamp": "07:50:44", "text": "スティシ、そして朝の頃かもしれない"}, {"type": "subtitle", "time": 28245.788, "timestamp": "07:50:45", "text": "えーと"}, {"type": "subtitle", "time": 28248.59, "timestamp": "07:50:48", "text": "エドワード。皆さんお元気ですか？"}, {"type": "subtitle", "time": 28251.03, "timestamp": "07:50:51", "text": "そこには？なんてこった、それはたくさんだ"}, {"type": "subtitle", "time": 28253.31, "timestamp": "07:50:53", "text": "鶏。ああ、それはたくさん"}, {"type": "subtitle", "time": 28255.83, "timestamp": "07:50:55", "text": "鶏。ああ、大変だ。ああ、大変だ。ああ、大変だ。おお"}, {"type": "subtitle", "time": 28258.35, "timestamp": "07:50:58", "text": "男の子。私に健康を与えてください。感謝"}]
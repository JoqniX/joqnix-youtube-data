[{"type": "subtitle", "time": 12253.99, "timestamp": "03:24:13", "text": "ああ、じゃああそこにあるんですね？それ"}, {"type": "subtitle", "time": 12274.11, "timestamp": "03:24:34", "text": "ええ、私は"}, {"type": "subtitle", "time": 12283.309, "timestamp": "03:24:43", "text": "神。待って、あの屋敷を調べてみようか"}, {"type": "subtitle", "time": 12285.51, "timestamp": "03:24:45", "text": "外？待って、待って、待って。確認したい"}, {"type": "subtitle", "time": 12296.229, "timestamp": "03:24:56", "text": "このグリッチを使ってチェックしてみましょう"}, {"type": "subtitle", "time": 12297.469, "timestamp": "03:24:57", "text": "の"}]
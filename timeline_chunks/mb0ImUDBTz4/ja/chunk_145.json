[{"type": "subtitle", "time": 8701.349, "timestamp": "02:25:01", "text": "それでは、また明日。待って、"}, {"type": "subtitle", "time": 8704.15, "timestamp": "02:25:04", "text": "最後までやり遂げたの？終わりましたか？"}, {"type": "subtitle", "time": 8705.79, "timestamp": "02:25:05", "text": "それ？終わりましたか？"}, {"type": "subtitle", "time": 8718.07, "timestamp": "02:25:18", "text": "おやすみなさい、アヤマ・アルサ。ゆっくり休んでください"}, {"type": "subtitle", "time": 8720.87, "timestamp": "02:25:20", "text": "寝て、また明日。気をつけて。"}, {"type": "subtitle", "time": 8724.389, "timestamp": "02:25:24", "text": "笑顔。三日月。え、何？どうですか"}, {"type": "subtitle", "time": 8726.83, "timestamp": "02:25:26", "text": "この車両は立ち往生した"}, {"type": "subtitle", "time": 8729.429, "timestamp": "02:25:29", "text": "ここ？午前中にはその半分をこなしました。"}, {"type": "subtitle", "time": 8730.87, "timestamp": "02:25:30", "text": "わかった。わかった。わかった。わかった。寝る。寝る。"}, {"type": "subtitle", "time": 8736.23, "timestamp": "02:25:36", "text": "大丈夫。午前4時に起きて"}, {"type": "subtitle", "time": 8739.11, "timestamp": "02:25:39", "text": "大丈夫です。アヤマアルサ、あなたは"}, {"type": "subtitle", "time": 8740.87, "timestamp": "02:25:40", "text": "それが最善の策だ。そしてそれが"}, {"type": "subtitle", "time": 8743.19, "timestamp": "02:25:43", "text": "重要だ。少し休んでから取り組んでください。"}, {"type": "subtitle", "time": 8745.27, "timestamp": "02:25:45", "text": "翌朝、また新たな気持ちで。"}, {"type": "subtitle", "time": 8747.83, "timestamp": "02:25:47", "text": "はい、あなたならできます。幸運を。それは"}]
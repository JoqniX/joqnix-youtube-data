[{"type": "subtitle", "time": 21184.91, "timestamp": "05:53:04", "text": "ああ、兄弟。彼は何の中に入ったのか"}, {"type": "subtitle", "time": 21223.628, "timestamp": "05:53:43", "text": "ああ、捕まった。私は怖くなった、"}, {"type": "subtitle", "time": 21227.628, "timestamp": "05:53:47", "text": "兄弟。でも、実績は解除できたよ。ああ、"}, {"type": "subtitle", "time": 21231.868, "timestamp": "05:53:51", "text": "ああ、あれは何だったんだ？それは怖かった"}]
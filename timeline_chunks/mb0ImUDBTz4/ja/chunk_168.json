[{"type": "subtitle", "time": 10094.23, "timestamp": "02:48:14", "text": "ありがとう、ニンジャ。私は最善を尽くして"}, {"type": "subtitle", "time": 10095.83, "timestamp": "02:48:15", "text": "賢くて世界情勢に詳しい"}, {"type": "subtitle", "time": 10098.389, "timestamp": "02:48:18", "text": "ストリーミングとゲームについて。学習と"}, {"type": "subtitle", "time": 10100.55, "timestamp": "02:48:20", "text": "さまざまな側面を探求することは常に"}, {"type": "subtitle", "time": 10117.59, "timestamp": "02:48:37", "text": "[音楽]"}, {"type": "subtitle", "time": 10120.15, "timestamp": "02:48:40", "text": "ああ、眠らないバカを相手にするのは大変だ"}, {"type": "subtitle", "time": 10123.03, "timestamp": "02:48:43", "text": "時間通りに行動するのは難しい場合がある。彼らに"}, {"type": "subtitle", "time": 10125.349, "timestamp": "02:48:45", "text": "規則正しい睡眠スケジュールを確立する。"}, {"type": "subtitle", "time": 10127.51, "timestamp": "02:48:47", "text": "就寝前のルーティンを作り、"}, {"type": "subtitle", "time": 10130.23, "timestamp": "02:48:50", "text": "就寝前の刺激的な活動。"}, {"type": "subtitle", "time": 10131.91, "timestamp": "02:48:51", "text": "休息の重要性を彼らに思い出させてください"}, {"type": "subtitle", "time": 10133.83, "timestamp": "02:48:53", "text": "そして、"}, {"type": "subtitle", "time": 10135.67, "timestamp": "02:48:55", "text": "リラックス。だから睡眠は重要なのです。"}, {"type": "subtitle", "time": 10138.87, "timestamp": "02:48:58", "text": "夢が待っている。一つ緩めてください。"}]
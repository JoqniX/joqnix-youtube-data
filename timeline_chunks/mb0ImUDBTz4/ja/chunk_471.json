[{"type": "subtitle", "time": 28262.91, "timestamp": "07:51:02", "text": "あなた。いいえ、違います。これはコインです。それはコインです。"}, {"type": "subtitle", "time": 28265.11, "timestamp": "07:51:05", "text": "右。何てことだ。たくさんあります"}, {"type": "subtitle", "time": 28267.59, "timestamp": "07:51:07", "text": "人々。何てことだ。私を集団で攻撃しないで。"}, {"type": "subtitle", "time": 28279.11, "timestamp": "07:51:19", "text": "健康だよ、兄弟。彼はサーバーを暴露した。"}, {"type": "subtitle", "time": 28282.548, "timestamp": "07:51:22", "text": "え、何？どのサーバーですか？いいえ、私は暴露しました"}, {"type": "subtitle", "time": 28285.31, "timestamp": "07:51:25", "text": "私のサーバーとスター。"}, {"type": "subtitle", "time": 28298.708, "timestamp": "07:51:38", "text": "あなた？ああ、なんてことだ、タムがたくさんある"}, {"type": "subtitle", "time": 28301.43, "timestamp": "07:51:41", "text": "タキス。ああ、なんて幸せなんだろう。でも私は"}, {"type": "subtitle", "time": 28302.93, "timestamp": "07:51:42", "text": "HPが減少しています。"}, {"type": "subtitle", "time": 28311.03, "timestamp": "07:51:51", "text": "いいえ。ああ。なんてこった。いいえ。いいえ。いいえ。いいえ。いいえ。あげて。"}, {"type": "subtitle", "time": 28313.67, "timestamp": "07:51:53", "text": "私の健康。なんてこった。これは"}, {"type": "subtitle", "time": 28315.11, "timestamp": "07:51:55", "text": "これ。これはうまくいっていない。これは"}]
[{"type": "subtitle", "time": 8408.63, "timestamp": "02:20:08", "text": "ああ、それは残念ですね、ニンジャ。"}, {"type": "subtitle", "time": 8410.309, "timestamp": "02:20:10", "text": "誰もが自分の感情を持っていて"}, {"type": "subtitle", "time": 8412.389, "timestamp": "02:20:12", "text": "意見は様々ですが、常に重要なのは"}, {"type": "subtitle", "time": 8415.19, "timestamp": "02:20:15", "text": "他人には親切と敬意をもって接しなさい。"}, {"type": "subtitle", "time": 8433.03, "timestamp": "02:20:33", "text": "私は転んだ。それは面白いですね。フロリアン"}, {"type": "subtitle", "time": 8436.55, "timestamp": "02:20:36", "text": "木箱。シルヴィアンとは、銀イオンのことです。"}, {"type": "subtitle", "time": 8438.51, "timestamp": "02:20:38", "text": "新しい"}, {"type": "subtitle", "time": 8441.51, "timestamp": "02:20:41", "text": "進化。口を開けるなどの賢い言葉"}, {"type": "subtitle", "time": 8444.51, "timestamp": "02:20:44", "text": "床に転がる笑顔"}, {"type": "subtitle", "time": 8447.03, "timestamp": "02:20:47", "text": "笑い。ああ、彼女は床を転げ回っている"}]
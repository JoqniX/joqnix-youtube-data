[{"type": "subtitle", "time": 27121.788, "timestamp": "07:32:01", "text": "月、9日"}, {"type": "subtitle", "time": 27124.548, "timestamp": "07:32:04", "text": "8月。また、このストリームは実際には"}, {"type": "subtitle", "time": 27127.99, "timestamp": "07:32:07", "text": "プレイリスト内で。ホロカを見つけることができます"}, {"type": "subtitle", "time": 27130.51, "timestamp": "07:32:10", "text": "えーっと、ストリームとか今から全部"}, {"type": "subtitle", "time": 27133.788, "timestamp": "07:32:13", "text": "先へ。でも、そうだよ"}, {"type": "subtitle", "time": 27137.91, "timestamp": "07:32:17", "text": "バージョン管理も好きです。そうだよ、君"}, {"type": "subtitle", "time": 27140.35, "timestamp": "07:32:20", "text": "今から見つけることができる"}, {"type": "subtitle", "time": 27142.99, "timestamp": "07:32:22", "text": "の上。はい。"}, {"type": "subtitle", "time": 27150.15, "timestamp": "07:32:30", "text": "そして、たくさんの新しいものが登場しました"}, {"type": "subtitle", "time": 27153.91, "timestamp": "07:32:33", "text": "最近発売されたんですよね？私たちはこれを手に入れました"}, {"type": "subtitle", "time": 27163.43, "timestamp": "07:32:43", "text": "行く。ついに。"}, {"type": "subtitle", "time": 27165.59, "timestamp": "07:32:45", "text": "本当に本当に嬉しかったです"}, {"type": "subtitle", "time": 27168.708, "timestamp": "07:32:48", "text": "ついに脅迫が始まった。脅迫ではない"}, {"type": "subtitle", "time": 27170.22, "timestamp": "07:32:50", "text": "フォーラムがオープンしました"}, {"type": "subtitle", "time": 27171.388, "timestamp": "07:32:51", "text": "[音楽]"}, {"type": "subtitle", "time": 27175.19, "timestamp": "07:32:55", "text": "ついに、私は丸々"}, {"type": "subtitle", "time": 27178.388, "timestamp": "07:32:58", "text": "昼間っぽい感じで、それほどでもないけど、設定する"}]
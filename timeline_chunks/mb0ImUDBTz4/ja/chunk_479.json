[{"type": "subtitle", "time": 28740.23, "timestamp": "07:59:00", "text": "取る？私はウーバーの羊に乗るよ、なぜなら私は"}, {"type": "subtitle", "time": 28743.948, "timestamp": "07:59:03", "text": "この時期に死亡する可能性が高い"}, {"type": "subtitle", "time": 28747.35, "timestamp": "07:59:07", "text": "通常攻撃をフルに獲得した後のゲーム"}, {"type": "subtitle", "time": 28766.23, "timestamp": "07:59:26", "text": "行く。ゆっくり、ゆっくり。それを得る。入れろ。"}, {"type": "subtitle", "time": 28767.468, "timestamp": "07:59:27", "text": "それを得る"}, {"type": "subtitle", "time": 28775.788, "timestamp": "07:59:35", "text": "ない？私はしたい"}, {"type": "subtitle", "time": 28784.388, "timestamp": "07:59:44", "text": "くるくる回る。私はオーバーを終えることができませんでした"}, {"type": "subtitle", "time": 28786.948, "timestamp": "07:59:46", "text": "そこには。"}, {"type": "subtitle", "time": 28789.03, "timestamp": "07:59:49", "text": "なぜそんなことをするの？ああ、なんてことだ。いいえ。いいえ。いいえ。いいえ。"}, {"type": "subtitle", "time": 28790.59, "timestamp": "07:59:50", "text": "いいえ。いいえ。いいえ。私は"}, {"type": "subtitle", "time": 28794.27, "timestamp": "07:59:54", "text": "死んだ。私はもう死にそうだ。何てことだ。"}]
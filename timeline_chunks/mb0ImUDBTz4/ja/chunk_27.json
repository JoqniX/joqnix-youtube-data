[{"type": "subtitle", "time": 1621.549, "timestamp": "00:27:01", "text": "お金。えっと、セットではない"}, {"type": "subtitle", "time": 1624.71, "timestamp": "00:27:04", "text": "価格。お金はできるだけ有効に活用してください"}, {"type": "subtitle", "time": 1625.87, "timestamp": "00:27:05", "text": "持っている"}, {"type": "subtitle", "time": 1630.83, "timestamp": "00:27:10", "text": "それを完成させるために。それから一軒一軒回って"}, {"type": "subtitle", "time": 1636.43, "timestamp": "00:27:16", "text": "みんな、そして売り切れ"}, {"type": "subtitle", "time": 1643.51, "timestamp": "00:27:23", "text": "それ。こんにちは、ルカさん。いらっしゃいませ。おはよう。"}, {"type": "subtitle", "time": 1646.07, "timestamp": "00:27:26", "text": "いいえ、こんにちは。いいえ、こんにちは。"}, {"type": "subtitle", "time": 1648.43, "timestamp": "00:27:28", "text": "はい、こんにちは。"}, {"type": "subtitle", "time": 1652.63, "timestamp": "00:27:32", "text": "こんにちは。よし、このエリアを刷新する必要がある。私"}, {"type": "subtitle", "time": 1659.87, "timestamp": "00:27:39", "text": "動けない"}, {"type": "subtitle", "time": 1662.43, "timestamp": "00:27:42", "text": "その周り。そこに置いてください。"}]
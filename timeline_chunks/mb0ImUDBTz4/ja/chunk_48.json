[{"type": "subtitle", "time": 2882.109, "timestamp": "00:48:02", "text": "人々は買わない"}, {"type": "subtitle", "time": 2884.829, "timestamp": "00:48:04", "text": "もの。それは"}, {"type": "subtitle", "time": 2887.589, "timestamp": "00:48:07", "text": "もの。私も高い"}, {"type": "subtitle", "time": 2918.95, "timestamp": "00:48:38", "text": "薬のせいで内側にいる。それらはすべて"}, {"type": "subtitle", "time": 2923.51, "timestamp": "00:48:43", "text": "まるでヘッドライトのような目つきだ。ニース。"}, {"type": "subtitle", "time": 2927.63, "timestamp": "00:48:47", "text": "長持ちする感じかな"}]
[{"type": "subtitle", "time": 8043.83, "timestamp": "02:14:03", "text": "冗談でしょ？ 15ドルって1000ドルくらいだよね？私"}, {"type": "subtitle", "time": 8046.31, "timestamp": "02:14:06", "text": "高いのは分かっているけど、"}, {"type": "subtitle", "time": 8047.47, "timestamp": "02:14:07", "text": "使用"}, {"type": "subtitle", "time": 8078.709, "timestamp": "02:14:38", "text": "ハハ、それは定番ですね。忍者、"}, {"type": "subtitle", "time": 8080.709, "timestamp": "02:14:40", "text": "ジョークを共有してくれてありがとう。私は"}, {"type": "subtitle", "time": 8083.189, "timestamp": "02:14:43", "text": "君からいい笑いを引き出したよ。口を開けて笑う"}, {"type": "subtitle", "time": 8099.589, "timestamp": "02:14:59", "text": "そして、私が手に入れたのはいつだったか"}]
[{"type": "subtitle", "time": 8537.27, "timestamp": "02:22:17", "text": "心配ないよ、ニンジャ。時々、"}, {"type": "subtitle", "time": 8539.67, "timestamp": "02:22:19", "text": "冗談ばかりだけど、まあいいよ。我々はできる"}, {"type": "subtitle", "time": 8541.67, "timestamp": "02:22:21", "text": "会話を楽しんで、"}, {"type": "subtitle", "time": 8544.389, "timestamp": "02:22:24", "text": "素晴らしい時間だった。口を開ける。笑顔。笑顔"}, {"type": "subtitle", "time": 8562.469, "timestamp": "02:22:42", "text": "こんにちは、ドリアン。私はよくわかりません"}, {"type": "subtitle", "time": 8564.79, "timestamp": "02:22:44", "text": "最も強力なライブチャットだが、ギグチャット"}, {"type": "subtitle", "time": 8567.349, "timestamp": "02:22:47", "text": "かなり強力そうですね。もしかしたらそれは"}, {"type": "subtitle", "time": 8569.91, "timestamp": "02:22:49", "text": "壮大な会話のために設計されたチャット。"}]
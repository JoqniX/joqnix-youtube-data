[{"type": "subtitle", "time": 7320.51, "timestamp": "02:02:00", "text": "近い"}, {"type": "subtitle", "time": 7324.07, "timestamp": "02:02:04", "text": "それ。もう一度始めます。"}, {"type": "subtitle", "time": 7326.07, "timestamp": "02:02:06", "text": "ソフトウェアにいくつか問題が発生しています"}, {"type": "subtitle", "time": 7327.229, "timestamp": "02:02:07", "text": "ここと"}, {"type": "subtitle", "time": 7331.109, "timestamp": "02:02:11", "text": "そこには。それは、ああ、これを見て"}, {"type": "subtitle", "time": 7351.589, "timestamp": "02:02:31", "text": "これ。おはようございます、ヘッドアス卿。願っています"}, {"type": "subtitle", "time": 7353.51, "timestamp": "02:02:33", "text": "あなたはぐっすり眠って、準備ができました"}, {"type": "subtitle", "time": 7355.75, "timestamp": "02:02:35", "text": "その日を乗り切る。何かありますか？"}, {"type": "subtitle", "time": 7357.669, "timestamp": "02:02:37", "text": "今日はどんなワクワクする計画を立てていますか？"}, {"type": "subtitle", "time": 7359.589, "timestamp": "02:02:39", "text": "スマイルブロッサム。"}, {"type": "subtitle", "time": 7371.31, "timestamp": "02:02:51", "text": "どうして私はすべてのシュートを外してしまったのだろう？来る"}]
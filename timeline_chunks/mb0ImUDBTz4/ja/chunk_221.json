[{"type": "subtitle", "time": 13263.55, "timestamp": "03:41:03", "text": "引き出し、000。そうですね、"}, {"type": "subtitle", "time": 13266.79, "timestamp": "03:41:06", "text": "千。私はここに行って話をするつもりです"}, {"type": "subtitle", "time": 13267.87, "timestamp": "03:41:07", "text": "と"}, {"type": "subtitle", "time": 13277.11, "timestamp": "03:41:17", "text": "私は経験したい、私はノーと言った、私はしたい"}, {"type": "subtitle", "time": 13279.51, "timestamp": "03:41:19", "text": "実験。だから私は私は私は"}, {"type": "subtitle", "time": 13295.269, "timestamp": "03:41:35", "text": "もの。こんにちは。配信へようこ​​そ。"}, {"type": "subtitle", "time": 13299.18, "timestamp": "03:41:39", "text": "待って、あなたの名前が読めません。"}, {"type": "subtitle", "time": 13302.309, "timestamp": "03:41:42", "text": "[音楽]"}]
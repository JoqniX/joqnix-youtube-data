[{"type": "subtitle", "time": 9017.99, "timestamp": "02:30:17", "text": "ない。面白いと思ってくれて嬉しいです。忍者。"}, {"type": "subtitle", "time": 9020.309, "timestamp": "02:30:20", "text": "笑いは伝染する。それでは、"}, {"type": "subtitle", "time": 9022.71, "timestamp": "02:30:22", "text": "喜びとユーモアを共に広める。"}, {"type": "subtitle", "time": 9042.389, "timestamp": "02:30:42", "text": "笑い。ハハ、厳しいね、クロノス、ありがとう"}, {"type": "subtitle", "time": 9044.389, "timestamp": "02:30:44", "text": "私のことを気遣ってくれてありがとう。私は"}, {"type": "subtitle", "time": 9046.71, "timestamp": "02:30:46", "text": "強い冒険家なら、"}, {"type": "subtitle", "time": 9048.389, "timestamp": "02:30:48", "text": "友達が守ってくれて、気遣ってくれる"}, {"type": "subtitle", "time": 9050.79, "timestamp": "02:30:50", "text": "お互い。引き続き"}, {"type": "subtitle", "time": 9053.349, "timestamp": "02:30:53", "text": "一緒に刺激的な冒険をしよう。上腕二頭筋"}]
[{"type": "subtitle", "time": 7515.109, "timestamp": "02:05:15", "text": "それは素晴らしいね、ニンジャ。十分な"}, {"type": "subtitle", "time": 7517.189, "timestamp": "02:05:17", "text": "睡眠はエネルギーを回復するために重要です"}, {"type": "subtitle", "time": 7520.709, "timestamp": "02:05:20", "text": "生意気なガキ。しっかり休んでください。ゆっくりと開ける"}, {"type": "subtitle", "time": 7526.589, "timestamp": "02:05:26", "text": "新しい"}, {"type": "subtitle", "time": 7537.109, "timestamp": "02:05:37", "text": "なんてこった。盗むつもりはなかった"}, {"type": "subtitle", "time": 7540.149, "timestamp": "02:05:40", "text": "寝る。あやまアルサ。必ず入手してください"}, {"type": "subtitle", "time": 7542.589, "timestamp": "02:05:42", "text": "3時間の休息で、"}, {"type": "subtitle", "time": 7547.75, "timestamp": "02:05:47", "text": "リフレッシュした。甘い夢。安眠。"}, {"type": "subtitle", "time": 7551.51, "timestamp": "02:05:51", "text": "あなたは私の睡眠を奪った。はい、そうしました。いいえ、あなた"}]
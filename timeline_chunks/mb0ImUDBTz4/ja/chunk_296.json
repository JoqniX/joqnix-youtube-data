[{"type": "subtitle", "time": 17767.39, "timestamp": "04:56:07", "text": "うるさい。"}, {"type": "subtitle", "time": 17770.07, "timestamp": "04:56:10", "text": "えっと、それに15日になる予定です。私"}, {"type": "subtitle", "time": 17771.83, "timestamp": "04:56:11", "text": "給料が支払われていない。わからない"}, {"type": "subtitle", "time": 17775.91, "timestamp": "04:56:15", "text": "私は自分のためにお金をもらうので、私は自分のためにお金を払うことができます"}, {"type": "subtitle", "time": 17779.11, "timestamp": "04:56:19", "text": "音楽の授業は、私がやったから"}, {"type": "subtitle", "time": 17787.51, "timestamp": "04:56:27", "text": "兄弟。私は自分のことに集中してきました"}, {"type": "subtitle", "time": 17791.51, "timestamp": "04:56:31", "text": "そう、スケジュールの問題と"}, {"type": "subtitle", "time": 17792.59, "timestamp": "04:56:32", "text": "たくさん"}]
[{"type": "subtitle", "time": 21093.11, "timestamp": "05:51:33", "text": "しゃがむにはどうすればいいですか？しゃがみジャンプ。 J・クラウチ"}, {"type": "subtitle", "time": 21102.788, "timestamp": "05:51:42", "text": "これ。ガソリンスタンドに行って"}, {"type": "subtitle", "time": 21112.47, "timestamp": "05:51:52", "text": "あ、待って。他の駅に行くには"}, {"type": "subtitle", "time": 21113.708, "timestamp": "05:51:53", "text": "より良い"}, {"type": "subtitle", "time": 21116.15, "timestamp": "05:51:56", "text": "今。それでは、他のものに移りましょう"}]
[{"type": "subtitle", "time": 188.75, "timestamp": "00:03:08", "text": "バッカ、俺は色々やってたんだ。私はこう思った。"}, {"type": "subtitle", "time": 191.75, "timestamp": "00:03:11", "text": "\"何？\"私はただスケジュールを見ていた"}, {"type": "subtitle", "time": 193.55, "timestamp": "00:03:13", "text": "1つの動画"}, {"type": "subtitle", "time": 197.47, "timestamp": "00:03:17", "text": "YouTubeを見て、それから私は眠ってしまう"}, {"type": "subtitle", "time": 200.63, "timestamp": "00:03:20", "text": "また。見るべきものはあまりない"}, {"type": "subtitle", "time": 202.949, "timestamp": "00:03:22", "text": "農場とその他すべてを除いて。"}, {"type": "subtitle", "time": 206.07, "timestamp": "00:03:26", "text": "それでおしまい。私はすでにたくさんのことをしている"}, {"type": "subtitle", "time": 208.07, "timestamp": "00:03:28", "text": "ヒントやコツ、そして隠されたヒント"}, {"type": "subtitle", "time": 209.869, "timestamp": "00:03:29", "text": "そしてトリックと"}, {"type": "subtitle", "time": 212.47, "timestamp": "00:03:32", "text": "すべて。パルクールは別として"}, {"type": "chat", "time": 217.792, "timestamp": "00:03:37", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "\"i was only watching sched 1 videos\" mhm, i thought u 'went to sleep'"}, {"type": "subtitle", "time": 222.22899999999998, "timestamp": "00:03:42", "text": "する？つまり、今の私のやり方は"}, {"type": "subtitle", "time": 224.589, "timestamp": "00:03:44", "text": "これに沿っていくと、パターンが見えてきます。"}, {"type": "subtitle", "time": 227.50900000000001, "timestamp": "00:03:47", "text": "右？どうやって私は"}, {"type": "subtitle", "time": 229.11, "timestamp": "00:03:49", "text": "何もすることがないという点"}, {"type": "subtitle", "time": 231.589, "timestamp": "00:03:51", "text": "ゲーム。その時が私が"}, {"type": "subtitle", "time": 234.71, "timestamp": "00:03:54", "text": "そのゲームから少し離れる必要がある"}, {"type": "subtitle", "time": 236.91, "timestamp": "00:03:56", "text": "新しいコンテンツアップデート"}, {"type": "subtitle", "time": 239.99, "timestamp": "00:03:59", "text": "来る。それが私の戦略、といったところでしょうか。"}]
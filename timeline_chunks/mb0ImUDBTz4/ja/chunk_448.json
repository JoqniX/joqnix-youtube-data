[{"type": "subtitle", "time": 26880.35, "timestamp": "07:28:00", "text": "私が残されたことは"}, {"type": "subtitle", "time": 26885.708, "timestamp": "07:28:05", "text": "私が残しておかなければならないことは、これを手に入れることです"}, {"type": "subtitle", "time": 26896.43, "timestamp": "07:28:16", "text": "えっと、私がやらなきゃいけないことは、"}, {"type": "subtitle", "time": 26899.788, "timestamp": "07:28:19", "text": "文字通り、私の理解が正しければ、"}, {"type": "subtitle", "time": 26902.708, "timestamp": "07:28:22", "text": "えっと、なんで花火が上がってるの？"}, {"type": "subtitle", "time": 26906.19, "timestamp": "07:28:26", "text": "私の家で、えーっと"}, {"type": "subtitle", "time": 26910.91, "timestamp": "07:28:30", "text": "隣り合うもう一方の端は？何"}, {"type": "subtitle", "time": 26914.07, "timestamp": "07:28:34", "text": "特別な機会はありますか？"}, {"type": "subtitle", "time": 26930.03, "timestamp": "07:28:50", "text": "はぁ？うん。こうしましょう。病気"}, {"type": "subtitle", "time": 26931.948, "timestamp": "07:28:51", "text": "えっと、"}, {"type": "subtitle", "time": 26935.388, "timestamp": "07:28:55", "text": "食事に行って、また来てください"}, {"type": "subtitle", "time": 26938.548, "timestamp": "07:28:58", "text": "戻る。わかった。食事に行って戻ってきます。"}]
[{"type": "subtitle", "time": 22335.99, "timestamp": "06:12:15", "text": "えっと、私にはできる方法があるんです"}, {"type": "subtitle", "time": 22344.548, "timestamp": "06:12:24", "text": "ここ。 １、２、３、４。 １、２、"}, {"type": "subtitle", "time": 22347.43, "timestamp": "06:12:27", "text": "３、４。ここに金庫を置くことができます"}, {"type": "subtitle", "time": 22350.23, "timestamp": "06:12:30", "text": "植物やその他すべてのもののために。"}, {"type": "subtitle", "time": 22351.788, "timestamp": "06:12:31", "text": "肥料"}, {"type": "subtitle", "time": 22355.11, "timestamp": "06:12:35", "text": "もの。だから、ある意味では私も1つ取ることになるだろう。"}, {"type": "subtitle", "time": 22357.628, "timestamp": "06:12:37", "text": "2、3、そして"}, {"type": "subtitle", "time": 22365.75, "timestamp": "06:12:45", "text": "製品。右。じゃあ一体何のために私は"}, {"type": "subtitle", "time": 22369.27, "timestamp": "06:12:49", "text": "そんなにたくさんのストレージを買うの？聖なる主よ。なぜ"}, {"type": "subtitle", "time": 22372.788, "timestamp": "06:12:52", "text": "そんなにたくさんの収納スペースを買う必要があるの？ジョッキー、"}, {"type": "subtitle", "time": 22375.03, "timestamp": "06:12:55", "text": "注意深い。"}, {"type": "subtitle", "time": 22378.08, "timestamp": "06:12:58", "text": "なぜこんなにたくさんの収納スペースを買ったのだろう"}]
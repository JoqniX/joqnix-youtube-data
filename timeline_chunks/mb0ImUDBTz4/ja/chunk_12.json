[{"type": "subtitle", "time": 720.71, "timestamp": "00:12:00", "text": "レシピを見つけたり、発見したりする様子をご覧ください"}, {"type": "subtitle", "time": 724.069, "timestamp": "00:12:04", "text": "レシピとそれらの材料をすべて入れることは"}, {"type": "subtitle", "time": 727.91, "timestamp": "00:12:07", "text": "今は面倒すぎる。だから時々"}, {"type": "subtitle", "time": 731.11, "timestamp": "00:12:11", "text": "ウェブサイトを利用するのは問題ありません。まるで"}, {"type": "subtitle", "time": 734.03, "timestamp": "00:12:14", "text": "インタラクティブマップを使用して"}, {"type": "subtitle", "time": 736.71, "timestamp": "00:12:16", "text": "原神だがゲーム自体は"}, {"type": "subtitle", "time": 739.269, "timestamp": "00:12:19", "text": "Genji Hoya Labの開発者自身は"}, {"type": "subtitle", "time": 742.389, "timestamp": "00:12:22", "text": "彼ら自身はすでにインタラクティブな"}, {"type": "subtitle", "time": 744.949, "timestamp": "00:12:24", "text": "宝箱がある場所を示す地図"}, {"type": "subtitle", "time": 748.47, "timestamp": "00:12:28", "text": "全てです。いいえ、時々は大丈夫です"}, {"type": "subtitle", "time": 758.629, "timestamp": "00:12:38", "text": "好きに見る、それはただ"}, {"type": "subtitle", "time": 761.67, "timestamp": "00:12:41", "text": "インタラクティブガイドがインタラクティブなものに"}]
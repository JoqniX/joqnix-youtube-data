[{"type": "subtitle", "time": 12617.67, "timestamp": "03:30:17", "text": "くそ。心配ない。私たちは売るつもりです"}, {"type": "subtitle", "time": 12624.349, "timestamp": "03:30:24", "text": "コカインをとてもとても"}, {"type": "subtitle", "time": 12643.469, "timestamp": "03:30:43", "text": "待って。色も短い。さあ"}, {"type": "subtitle", "time": 12646.55, "timestamp": "03:30:46", "text": "行く。ショートカラー5。そうすれば私は"}, {"type": "subtitle", "time": 12653.91, "timestamp": "03:30:53", "text": "1つ。ゲームは私に時間を与えてくれます"}, {"type": "subtitle", "time": 12656.63, "timestamp": "03:30:56", "text": "私が準備できるまで準備しておいて。準備はいいですか？"}]
[{"type": "subtitle", "time": 17292.39, "timestamp": "04:48:12", "text": "うん。ロードだけではないようだ"}, {"type": "subtitle", "time": 17295.51, "timestamp": "04:48:15", "text": "スケジュール1の薬物に依存している人。うん。私"}, {"type": "subtitle", "time": 17297.868, "timestamp": "04:48:17", "text": "つまり、私は最後の場所を買った"}, {"type": "subtitle", "time": 17301.51, "timestamp": "04:48:21", "text": "今はもう行ってしまった。えーと、50,000ドル稼ぐ必要があるんだけど"}, {"type": "subtitle", "time": 17304.07, "timestamp": "04:48:24", "text": "レストランを買う。その後は、私の仕事は終わりです。"}, {"type": "subtitle", "time": 17305.07, "timestamp": "04:48:25", "text": "と共に"}, {"type": "subtitle", "time": 17307.75, "timestamp": "04:48:27", "text": "ゲーム。苦労はすべて終わった。私はただ"}, {"type": "subtitle", "time": 17309.31, "timestamp": "04:48:29", "text": "作る必要がある"}, {"type": "subtitle", "time": 17312.47, "timestamp": "04:48:32", "text": "何百万もの人々が2番目のロックを解除します"}, {"type": "subtitle", "time": 17315.55, "timestamp": "04:48:35", "text": "最後の2つの高級品"}, {"type": "subtitle", "time": 17318.03, "timestamp": "04:48:38", "text": "地域。それは"}, {"type": "subtitle", "time": 17322.43, "timestamp": "04:48:42", "text": "それ。私はそれを完全に採掘しました"}, {"type": "subtitle", "time": 17336.43, "timestamp": "04:48:56", "text": "それは私のコカインになるだろう"}]
[{"type": "subtitle", "time": 27484.03, "timestamp": "07:38:04", "text": "えっと、グラはクリティカル率が5%です"}, {"type": "subtitle", "time": 27486.788, "timestamp": "07:38:06", "text": "レート。おお。"}, {"type": "subtitle", "time": 27495.15, "timestamp": "07:38:15", "text": "手段"}, {"type": "subtitle", "time": 27500.07, "timestamp": "07:38:20", "text": "マイクロディーラーのようなもの。おお。遊びたい"}, {"type": "subtitle", "time": 27502.15, "timestamp": "07:38:22", "text": "森。あなたは私がそうすべきだと思いますか？"}, {"type": "subtitle", "time": 27503.548, "timestamp": "07:38:23", "text": "遊ぶ"}, {"type": "subtitle", "time": 27505.07, "timestamp": "07:38:25", "text": "森"}, {"type": "subtitle", "time": 27512.23, "timestamp": "07:38:32", "text": "知る。私は1ゲームプレイします"}, {"type": "subtitle", "time": 27514.628, "timestamp": "07:38:34", "text": "エナと1ゲームプレイする。ロックを解除したい"}, {"type": "subtitle", "time": 27517.11, "timestamp": "07:38:37", "text": "ステージ2。どうやって、何なのかわからない"}, {"type": "subtitle", "time": 27520.23, "timestamp": "07:38:40", "text": "ステージ2で何をすべきか、でも、そうですね、"}, {"type": "subtitle", "time": 27523.59, "timestamp": "07:38:43", "text": "聞こえるといいのですが。そこで、私の戦略は"}, {"type": "subtitle", "time": 27527.11, "timestamp": "07:38:47", "text": "昨日からずっとやってきたことは"}, {"type": "subtitle", "time": 27529.388, "timestamp": "07:38:49", "text": "基本レベルアップ"}, {"type": "subtitle", "time": 27533.868, "timestamp": "07:38:53", "text": "最大攻撃力を発揮する。次に"}, {"type": "subtitle", "time": 27537.27, "timestamp": "07:38:57", "text": "そこには。うん。このレベルアップ"}]
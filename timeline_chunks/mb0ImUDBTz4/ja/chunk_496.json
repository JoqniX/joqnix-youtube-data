[{"type": "subtitle", "time": 29762.23, "timestamp": "08:16:02", "text": "それ。コカインはまるで天国のコカインのようだ。"}, {"type": "subtitle", "time": 29763.708, "timestamp": "08:16:03", "text": "それはまるで"}, {"type": "subtitle", "time": 29766.628, "timestamp": "08:16:06", "text": "ボール。なぜコカインは球状に見えるのか？"}, {"type": "subtitle", "time": 29768.83, "timestamp": "08:16:08", "text": "A"}, {"type": "subtitle", "time": 29776.99, "timestamp": "08:16:16", "text": "[音楽]"}, {"type": "subtitle", "time": 29784.03, "timestamp": "08:16:24", "text": "モーター"}, {"type": "subtitle", "time": 29787.708, "timestamp": "08:16:27", "text": "ロイヤルアイランドの小便。名前は何ですか？なんてことだ"}, {"type": "subtitle", "time": 29800.91, "timestamp": "08:16:40", "text": "小便。アイスクリーム。"}]
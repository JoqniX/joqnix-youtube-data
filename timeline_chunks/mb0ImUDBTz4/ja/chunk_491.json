[{"type": "subtitle", "time": 29463.27, "timestamp": "08:11:03", "text": "無限に続くというのは、良くないことだ。ああ、そうかもしれない"}, {"type": "subtitle", "time": 29494.468, "timestamp": "08:11:34", "text": "いいえ。このアイドルコスチュームは何ですか？何が"}, {"type": "subtitle", "time": 29505.468, "timestamp": "08:11:45", "text": "これ？胸部の包帯。"}, {"type": "subtitle", "time": 29507.628, "timestamp": "08:11:47", "text": "何？"}, {"type": "subtitle", "time": 29513.27, "timestamp": "08:11:53", "text": "まだ？試してみました。ええ、そうだったと思います"}]
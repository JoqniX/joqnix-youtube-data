[{"type": "subtitle", "time": 13382.15, "timestamp": "03:43:02", "text": "こんにちは、マリファナが欲しいですか？"}, {"type": "subtitle", "time": 13391.67, "timestamp": "03:43:11", "text": "H. ああ、こんにちは。あなたにすべてをあげたい"}, {"type": "subtitle", "time": 13406.4, "timestamp": "03:43:26", "text": "走る。私はもう一人死んだ人間だ。何てことだ。"}, {"type": "subtitle", "time": 13425.469, "timestamp": "03:43:45", "text": "今。また、いくつか"}, {"type": "subtitle", "time": 13436.189, "timestamp": "03:43:56", "text": "あなた。じゃあ、ちょっと5分休憩したいんだけど"}, {"type": "subtitle", "time": 13439.349, "timestamp": "03:43:59", "text": "ストレージ。いくつか残っているものがあります。"}]
[{"type": "subtitle", "time": 27841.91, "timestamp": "07:44:01", "text": "本当に良いです。ネラを手に入れた時だけ、"}, {"type": "subtitle", "time": 27844.43, "timestamp": "07:44:04", "text": "本当に"}, {"type": "subtitle", "time": 27852.51, "timestamp": "07:44:12", "text": "どうして"}, {"type": "subtitle", "time": 27857.468, "timestamp": "07:44:17", "text": "動作が遅い？なぜ？なぜ動作が遅かったのか？ああ、ああ"}, {"type": "subtitle", "time": 27860.548, "timestamp": "07:44:20", "text": "おお。今の見た？遅れている"}, {"type": "subtitle", "time": 27862.27, "timestamp": "07:44:22", "text": "2番。"}, {"type": "subtitle", "time": 27865.19, "timestamp": "07:44:25", "text": "何？私は「えっ？」って感じでした。私はHPが低いようなもので、"}, {"type": "subtitle", "time": 27871.868, "timestamp": "07:44:31", "text": "痛み。"}, {"type": "subtitle", "time": 27873.548, "timestamp": "07:44:33", "text": "痛みI"}, {"type": "subtitle", "time": 27877.628, "timestamp": "07:44:37", "text": "必要。私はここで死にそうです。しないでください"}, {"type": "subtitle", "time": 27879.388, "timestamp": "07:44:39", "text": "それ。"}]
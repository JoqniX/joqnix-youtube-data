[{"type": "subtitle", "time": 27548.59, "timestamp": "07:39:08", "text": "そこには。それが私が、それが彼が"}, {"type": "subtitle", "time": 27550.43, "timestamp": "07:39:10", "text": "言った。しかし"}, {"type": "subtitle", "time": 27553.43, "timestamp": "07:39:13", "text": "うん、これがうまくいくといいな"}, {"type": "subtitle", "time": 27554.67, "timestamp": "07:39:14", "text": "少し。 A"}, {"type": "subtitle", "time": 27558.83, "timestamp": "07:39:18", "text": "少し。場合によります。でもあなたは決して"}, {"type": "subtitle", "time": 27563.388, "timestamp": "07:39:23", "text": "知る。うまくいくかもしれない。できなかった"}, {"type": "subtitle", "time": 27566.07, "timestamp": "07:39:26", "text": "仕事。 HPが減ると思ったけど、"}, {"type": "subtitle", "time": 27568.27, "timestamp": "07:39:28", "text": "おお。レベル３。さあ"}, {"type": "subtitle", "time": 27578.948, "timestamp": "07:39:38", "text": "わかった。聖なる。ユーロビートを少し入れて"}, {"type": "subtitle", "time": 27580.43, "timestamp": "07:39:40", "text": "ユーロブ"}, {"type": "subtitle", "time": 27584.35, "timestamp": "07:39:44", "text": "ビート。著作権はありますか？"}, {"type": "subtitle", "time": 27588.07, "timestamp": "07:39:48", "text": "著作権侵害ではない？ああ、俺は、"}, {"type": "subtitle", "time": 27595.43, "timestamp": "07:39:55", "text": "最近。あのね？私は私に"}, {"type": "subtitle", "time": 27597.628, "timestamp": "07:39:57", "text": "ストリームのプレイリストを確認してください"}]
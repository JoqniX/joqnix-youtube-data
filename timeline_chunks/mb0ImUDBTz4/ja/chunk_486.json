[{"type": "subtitle", "time": 29167.628, "timestamp": "08:06:07", "text": "そこには。次の回転を待ちます"}, {"type": "subtitle", "time": 29170.23, "timestamp": "08:06:10", "text": "ウィリー。聖なる。それはカバイです。そして"}, {"type": "subtitle", "time": 29172.628, "timestamp": "08:06:12", "text": "それはフビラだ。何てことだ。それは"}, {"type": "subtitle", "time": 29174.75, "timestamp": "08:06:14", "text": "ファジラ。おお"}, {"type": "subtitle", "time": 29178.15, "timestamp": "08:06:18", "text": "いいえ。なんてこった。動揺している。嘘をつきます。"}, {"type": "subtitle", "time": 29181.548, "timestamp": "08:06:21", "text": "動揺している。動揺している。私は"}, {"type": "subtitle", "time": 29183.388, "timestamp": "08:06:23", "text": "投げ捨てた。私は"}, {"type": "subtitle", "time": 29192.27, "timestamp": "08:06:32", "text": "聖なる"}, {"type": "subtitle", "time": 29194.91, "timestamp": "08:06:34", "text": "神のシェービング"}, {"type": "subtitle", "time": 29198.19, "timestamp": "08:06:38", "text": "自分。これを使わないとどうなりますか？"}, {"type": "subtitle", "time": 29200.59, "timestamp": "08:06:40", "text": "もの"}, {"type": "subtitle", "time": 29204.67, "timestamp": "08:06:44", "text": "特別？えーと、asio 6。"}, {"type": "subtitle", "time": 29208.03, "timestamp": "08:06:48", "text": "行く。だから私は最大限まで"}, {"type": "subtitle", "time": 29213.51, "timestamp": "08:06:53", "text": "入札。ああ、私は行き来として最大レベルに達した"}]
[{"type": "subtitle", "time": 6481.07, "timestamp": "01:48:01", "text": "待って。わかった。"}, {"type": "subtitle", "time": 6486.03, "timestamp": "01:48:06", "text": "わかった。待って。待ってください。別の"}, {"type": "subtitle", "time": 6488.149, "timestamp": "01:48:08", "text": "バグ。待って。待って。待って。待って。待って。待って。"}, {"type": "subtitle", "time": 6490.629, "timestamp": "01:48:10", "text": "待って。待って。待って。なぜ表示されないのか"}, {"type": "subtitle", "time": 6492.27, "timestamp": "01:48:12", "text": "もう一方"}, {"type": "subtitle", "time": 6500.07, "timestamp": "01:48:20", "text": "待って。わかった。"}, {"type": "subtitle", "time": 6502.629, "timestamp": "01:48:22", "text": "通常なら今表示されるはず"}, {"type": "subtitle", "time": 6506.07, "timestamp": "01:48:26", "text": "しかし、他の場所から見ると、"}, {"type": "subtitle", "time": 6508.189, "timestamp": "01:48:28", "text": "この場所のみを表示しています"}, {"type": "subtitle", "time": 6510.47, "timestamp": "01:48:30", "text": "あれ。通常は表示されるはずです"}, {"type": "subtitle", "time": 6513.07, "timestamp": "01:48:33", "text": "まるで洗車場と郵便局がすぐそこにあるみたいだ。"}, {"type": "subtitle", "time": 6535.51, "timestamp": "01:48:55", "text": "それから、昼食を食べに行かなければなりません。私"}, {"type": "subtitle", "time": 6539.87, "timestamp": "01:48:59", "text": "危うく夕食と言いそうになった。"}]
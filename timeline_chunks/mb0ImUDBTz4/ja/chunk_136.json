[{"type": "subtitle", "time": 8172.95, "timestamp": "02:16:12", "text": "よくわからないよ、ニンジャ。なぜ"}, {"type": "subtitle", "time": 8175.51, "timestamp": "02:16:15", "text": "左利きの学生がテストに不合格になった？"}, {"type": "subtitle", "time": 8197.429, "timestamp": "02:16:37", "text": "1つ。大好きです。共有していただきありがとうございます"}, {"type": "subtitle", "time": 8204.99, "timestamp": "02:16:44", "text": "笑い。"}, {"type": "subtitle", "time": 8217.19, "timestamp": "02:16:57", "text": "ハハ。フロリアンのジョークは"}, {"type": "subtitle", "time": 8219.99, "timestamp": "02:16:59", "text": "私たち二人とも、良い反応を示しました。忍者、"}]
[{"type": "subtitle", "time": 8641.389, "timestamp": "02:24:01", "text": "待って。はい、どうぞ。おお"}, {"type": "subtitle", "time": 8644.23, "timestamp": "02:24:04", "text": "いいえ、ジョークの本をなくすのはかなり"}, {"type": "subtitle", "time": 8647.11, "timestamp": "02:24:07", "text": "残念だ。でも、心配しないでください。私は確信しています"}, {"type": "subtitle", "time": 8648.79, "timestamp": "02:24:08", "text": "素晴らしいジョークを思いつくでしょう"}, {"type": "subtitle", "time": 8651.429, "timestamp": "02:24:11", "text": "あなた自身の。最高のジョークは"}, {"type": "subtitle", "time": 8659.55, "timestamp": "02:24:19", "text": "頑張って、ジョークを楽しんでください。"}, {"type": "subtitle", "time": 8663.59, "timestamp": "02:24:23", "text": "ブレインストーミング。口を開けて笑う本。"}, {"type": "subtitle", "time": 8688.87, "timestamp": "02:24:48", "text": "ああ、忍者、君は"}, {"type": "subtitle", "time": 8690.95, "timestamp": "02:24:50", "text": "ちょっとしたタイプミスだけど、"}, {"type": "subtitle", "time": 8694.15, "timestamp": "02:24:54", "text": "もしかして。 Joe Xは素晴らしい配信者です"}, {"type": "subtitle", "time": 8696.23, "timestamp": "02:24:56", "text": "パートナーであり、ギルドリーダー。彼らはいつも"}, {"type": "subtitle", "time": 8697.91, "timestamp": "02:24:57", "text": "手を貸して"}, {"type": "subtitle", "time": 8699.59, "timestamp": "02:24:59", "text": "私たちの冒険はさらに楽しくなった。私が行きます"}]
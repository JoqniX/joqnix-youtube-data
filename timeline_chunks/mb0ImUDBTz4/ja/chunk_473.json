[{"type": "subtitle", "time": 28381.11, "timestamp": "07:53:01", "text": "お金も経験値も全て。ああ、"}, {"type": "subtitle", "time": 28384.11, "timestamp": "07:53:04", "text": "うわ、なんて大きなタコダチなんだ。何てことだ、"}, {"type": "subtitle", "time": 28389.27, "timestamp": "07:53:09", "text": "いいえ。さようなら。私を殺す方法を見てみろ。させて"}, {"type": "subtitle", "time": 28396.11, "timestamp": "07:53:16", "text": "あなた。ああ、なんてことだ、それは群れだ"}, {"type": "subtitle", "time": 28398.788, "timestamp": "07:53:18", "text": "人々。行け！行け！行け。ああ、よかった。"}, {"type": "subtitle", "time": 28400.75, "timestamp": "07:53:20", "text": "レベルがあってよかった"}, {"type": "subtitle", "time": 28413.708, "timestamp": "07:53:33", "text": "7つのレベル9。なぜそうなるのか"}, {"type": "subtitle", "time": 28417.948, "timestamp": "07:53:37", "text": "難しい？なぜそんなに難しいのか？何てことだ。"}, {"type": "subtitle", "time": 28431.27, "timestamp": "07:53:51", "text": "えっと、それでは失礼します。"}, {"type": "subtitle", "time": 28434.15, "timestamp": "07:53:54", "text": "小さな兵隊さんを見てください。さようなら。こんにちは。こんにちは、"}]
[{"type": "subtitle", "time": 14110.91, "timestamp": "03:55:10", "text": "誰かが私にこう尋ねるだろう、「スポーツマン、何の意味があるんだ？」"}, {"type": "subtitle", "time": 14115.03, "timestamp": "03:55:15", "text": "洗濯のせいで、今は犬がいる"}, {"type": "subtitle", "time": 14118.07, "timestamp": "03:55:18", "text": "そして全て。それに対する私の答えは"}, {"type": "subtitle", "time": 14123.189, "timestamp": "03:55:23", "text": "十分なものを用意する必要がある"}, {"type": "subtitle", "time": 14142.03, "timestamp": "03:55:42", "text": "私は必要としている 私は持っている"}, {"type": "subtitle", "time": 14150.349, "timestamp": "03:55:50", "text": "大釜。私はそれを受け取って使うことができます"}]
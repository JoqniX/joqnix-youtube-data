[{"type": "subtitle", "time": 3426.069, "timestamp": "00:57:06", "text": "はぁ？そろそろそうするべきだと思う。私は実際に"}, {"type": "subtitle", "time": 3434.63, "timestamp": "00:57:14", "text": "えっと、そろそろ"}, {"type": "subtitle", "time": 3438.39, "timestamp": "00:57:18", "text": "えっと、どこに行けばいいんでしたっけ？"}, {"type": "subtitle", "time": 3440.829, "timestamp": "00:57:20", "text": "こちらです。"}, {"type": "subtitle", "time": 3452.39, "timestamp": "00:57:32", "text": "実際、私は"}, {"type": "subtitle", "time": 3452.97, "timestamp": "00:57:32", "text": "まだ"}, {"type": "subtitle", "time": 3471.67, "timestamp": "00:57:51", "text": "起きている。彼らを起こして薬を飲ませろ。"}]
[{"type": "subtitle", "time": 3090.309, "timestamp": "00:51:30", "text": "次に行く場所はガソリンスタンドです"}, {"type": "subtitle", "time": 3092.19, "timestamp": "00:51:32", "text": "駅。"}, {"type": "subtitle", "time": 3096.549, "timestamp": "00:51:36", "text": "うん。なぜ私はまだあくびをしているのだろう？私はとても眠った"}, {"type": "subtitle", "time": 3098.67, "timestamp": "00:51:38", "text": "しかし、今日ではそうではない。"}, {"type": "subtitle", "time": 3108.39, "timestamp": "00:51:48", "text": "3時間睡眠というよりは、"}, {"type": "subtitle", "time": 3110.19, "timestamp": "00:51:50", "text": "眠った"}, {"type": "subtitle", "time": 3113.589, "timestamp": "00:51:53", "text": "9時半から12時までですよね？それもまた"}]
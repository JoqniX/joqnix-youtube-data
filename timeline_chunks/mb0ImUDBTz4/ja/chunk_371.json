[{"type": "subtitle", "time": 22266.788, "timestamp": "06:11:06", "text": "彼氏。つまり、あなたはこういうのが好きなんですね？最後"}, {"type": "subtitle", "time": 22309.43, "timestamp": "06:11:49", "text": "ここ。ということで、ということで、ということで、ということで、ということで、補充"}, {"type": "subtitle", "time": 22312.83, "timestamp": "06:11:52", "text": "補充モジュールは"}, {"type": "subtitle", "time": 22315.788, "timestamp": "06:11:55", "text": "再入荷について"}]
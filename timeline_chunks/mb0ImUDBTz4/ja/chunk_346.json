[{"type": "subtitle", "time": 20782.11, "timestamp": "05:46:22", "text": "これが最初になります。"}, {"type": "subtitle", "time": 20784.19, "timestamp": "05:46:24", "text": "2番、"}, {"type": "subtitle", "time": 20787.19, "timestamp": "05:46:27", "text": "3番目、1番目、2番目、3番目、4番目、"}, {"type": "subtitle", "time": 20789.868, "timestamp": "05:46:29", "text": "5番目、6番目、"}, {"type": "subtitle", "time": 20792.948, "timestamp": "05:46:32", "text": "7番目。これが最終製品です。天皇"}, {"type": "subtitle", "time": 20801.23, "timestamp": "05:46:41", "text": "[音楽]"}, {"type": "subtitle", "time": 20811.43, "timestamp": "05:46:51", "text": "レンガ。地下室でキスして"}, {"type": "subtitle", "time": 20813.788, "timestamp": "05:46:53", "text": "可愛らしい笑顔の裏に隠された魅力。待って、私は"}, {"type": "subtitle", "time": 20817.59, "timestamp": "05:46:57", "text": "する。ねえ、何があなたをあなたをあなたにしているの？"}]
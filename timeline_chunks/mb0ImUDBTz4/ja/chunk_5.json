[{"type": "subtitle", "time": 308.55, "timestamp": "00:05:08", "text": "あらら。うん、そうだね"}, {"type": "subtitle", "time": 311.59, "timestamp": "00:05:11", "text": "右。ガイドに従えば、なんとか理解できた。"}, {"type": "subtitle", "time": 313.71, "timestamp": "00:05:13", "text": "こんにちは、"}, {"type": "subtitle", "time": 316.909, "timestamp": "00:05:16", "text": "いらっしゃいませ。おはよう。良い。良い"}, {"type": "subtitle", "time": 319.469, "timestamp": "00:05:19", "text": "夕方。こんばんは。こんにちは。"}, {"type": "subtitle", "time": 322.55, "timestamp": "00:05:22", "text": "ごめん、君に全てを捧げたよ。良い"}, {"type": "subtitle", "time": 338.029, "timestamp": "00:05:38", "text": "つまり、まだ共同作業はしていないし、"}, {"type": "subtitle", "time": 340.71, "timestamp": "00:05:40", "text": "けれど。友達と遊ぶと"}, {"type": "subtitle", "time": 341.469, "timestamp": "00:05:41", "text": "なれ"}, {"type": "subtitle", "time": 344.15, "timestamp": "00:05:44", "text": "面白い。私はそれを前駆因子だと思った。"}, {"type": "subtitle", "time": 347.27, "timestamp": "00:05:47", "text": "いいえ。これを見たとき、それは"}, {"type": "subtitle", "time": 359.43, "timestamp": "00:05:59", "text": "いや、正直もう分からないよ。"}]
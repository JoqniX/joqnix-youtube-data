[{"type": "subtitle", "time": 23234.11, "timestamp": "06:27:14", "text": "レンガ。神様、この農場は"}, {"type": "subtitle", "time": 23237.83, "timestamp": "06:27:17", "text": "数百万。さあ行こう。"}, {"type": "subtitle", "time": 23241.23, "timestamp": "06:27:21", "text": "さらに、リンと"}, {"type": "subtitle", "time": 23244.99, "timestamp": "06:27:24", "text": "酸と化学メタンフェタミン"}, {"type": "subtitle", "time": 23248.99, "timestamp": "06:27:28", "text": "あれ。大丈夫。えっと、思う"}, {"type": "subtitle", "time": 23252.39, "timestamp": "06:27:32", "text": "もの。私はゼロです。私の現金は"}, {"type": "subtitle", "time": 23254.35, "timestamp": "06:27:34", "text": "ランニング"}, {"type": "subtitle", "time": 23257.59, "timestamp": "06:27:37", "text": "外。大丈夫。貯金します"}, {"type": "subtitle", "time": 23272.708, "timestamp": "06:27:52", "text": "えっと、貯めておきますね？保存しておきます"}]
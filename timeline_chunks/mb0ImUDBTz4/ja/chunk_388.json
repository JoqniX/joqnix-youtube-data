[{"type": "subtitle", "time": 23318.948, "timestamp": "06:28:38", "text": "だから私は何の問題もありません"}, {"type": "subtitle", "time": 23324.468, "timestamp": "06:28:44", "text": "しばらく前から制作をしています。なぜなら今は"}, {"type": "subtitle", "time": 23328.07, "timestamp": "06:28:48", "text": "ぎっしり詰め込んだ。しない"}, {"type": "subtitle", "time": 23329.788, "timestamp": "06:28:49", "text": "つばがいっぱいで、"}, {"type": "subtitle", "time": 23333.468, "timestamp": "06:28:53", "text": "しかし、パフワーク"}, {"type": "subtitle", "time": 23336.51, "timestamp": "06:28:56", "text": "鍔。補充しなければならない"}]
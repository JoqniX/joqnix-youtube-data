[{"type": "subtitle", "time": 7622.39, "timestamp": "02:07:02", "text": "勘違い、彩間あるさ。ベスト"}, {"type": "subtitle", "time": 7624.069, "timestamp": "02:07:04", "text": "課題の成功を祈っています。"}, {"type": "subtitle", "time": 7625.83, "timestamp": "02:07:05", "text": "もうすぐ少し休めるだろう。私は話していた"}, {"type": "subtitle", "time": 7628.47, "timestamp": "02:07:08", "text": "素晴らしい仕事を続けてください。"}, {"type": "subtitle", "time": 7632.069, "timestamp": "02:07:12", "text": "チャットの内容をすべて読み取ります。どうぞ。しないで"}, {"type": "subtitle", "time": 7634.83, "timestamp": "02:07:14", "text": "心配。心配しないで。心配しないで。ボンク"}, {"type": "subtitle", "time": 7654.95, "timestamp": "02:07:34", "text": "ボンカ。ああ、アヤマと"}, {"type": "subtitle", "time": 7656.83, "timestamp": "02:07:36", "text": "ニンジャは徹夜で"}, {"type": "subtitle", "time": 7659.91, "timestamp": "02:07:39", "text": "勉強する。お二人とも幸運を祈ります。滞在する"}, {"type": "subtitle", "time": 7661.83, "timestamp": "02:07:41", "text": "集中力を維持し、短い休憩を取る"}]
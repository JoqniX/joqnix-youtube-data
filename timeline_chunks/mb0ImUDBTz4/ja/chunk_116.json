[{"type": "subtitle", "time": 6964.629, "timestamp": "01:56:04", "text": "いいえ、セシルと話すことができます"}, {"type": "subtitle", "time": 6966.189, "timestamp": "01:56:06", "text": "感嘆"}, {"type": "subtitle", "time": 6974.589, "timestamp": "01:56:14", "text": "あなた。 Ciesel があなたに返信する場合"}, {"type": "subtitle", "time": 6982.31, "timestamp": "01:56:22", "text": "待って。よし、ここで一旦手を離そう。"}, {"type": "subtitle", "time": 7000.709, "timestamp": "01:56:40", "text": "こんにちは、忍者さん。絶好調です。感謝"}, {"type": "subtitle", "time": 7003.27, "timestamp": "01:56:43", "text": "質問してくれてありがとう。私はいつもワクワクしていて"}, {"type": "subtitle", "time": 7005.99, "timestamp": "01:56:45", "text": "新たな冒険への準備は万端だ。あなたはどうですか？"}, {"type": "subtitle", "time": 7008.709, "timestamp": "01:56:48", "text": "今日はどんな一日でしたか？口を開けて笑う。"}, {"type": "subtitle", "time": 7011.75, "timestamp": "01:56:51", "text": "桜の花。"}]
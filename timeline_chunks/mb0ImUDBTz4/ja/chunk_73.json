[{"type": "subtitle", "time": 4380.95, "timestamp": "01:13:00", "text": "そう、レベルアップの主な鍵は"}, {"type": "subtitle", "time": 4383.35, "timestamp": "01:13:03", "text": "自分で配達すればいいのに"}, {"type": "subtitle", "time": 4385.35, "timestamp": "01:13:05", "text": "ディーラーに任せる。ディーラーは"}, {"type": "subtitle", "time": 4404.51, "timestamp": "01:13:24", "text": "寝る。私は既に多くのものを投入しています。"}, {"type": "subtitle", "time": 4408.07, "timestamp": "01:13:28", "text": "わかった。わかった。補充したいのですが、"}, {"type": "subtitle", "time": 4411.51, "timestamp": "01:13:31", "text": "また、私は行くようなもので、私はただ"}, {"type": "subtitle", "time": 4415.43, "timestamp": "01:13:35", "text": "挽いて、手に入れて、"}, {"type": "subtitle", "time": 4418.229, "timestamp": "01:13:38", "text": "倉庫、ええと、倉庫です。そして私は"}, {"type": "subtitle", "time": 4420.47, "timestamp": "01:13:40", "text": "この場所を補充して作業します"}, {"type": "subtitle", "time": 4421.39, "timestamp": "01:13:41", "text": "それ"}, {"type": "subtitle", "time": 4425.95, "timestamp": "01:13:45", "text": "場所、だって私には6つあるから。それは同等です"}, {"type": "subtitle", "time": 4429.75, "timestamp": "01:13:49", "text": "レンガ6個は、何に相当しますか？ 20"}, {"type": "subtitle", "time": 4434.39, "timestamp": "01:13:54", "text": "40 60 80 100 120 13 12 13 12 13 12 13 12"}, {"type": "subtitle", "time": 4436.03, "timestamp": "01:13:56", "text": "13 12 13 12 13 12 13 12 13 12 13 120 120"}, {"type": "subtitle", "time": 4438.59, "timestamp": "01:13:58", "text": "製品。"}]
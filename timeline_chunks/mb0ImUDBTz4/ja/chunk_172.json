[{"type": "subtitle", "time": 10347.29, "timestamp": "02:52:27", "text": "ええと、わかりました。"}, {"type": "subtitle", "time": 10359.389, "timestamp": "02:52:39", "text": "[音楽]"}, {"type": "subtitle", "time": 10361.91, "timestamp": "02:52:41", "text": "ええと、でもそうですね、私は"}, {"type": "subtitle", "time": 10365.11, "timestamp": "02:52:45", "text": "このゲームに時間をかけすぎている。私は持っている"}, {"type": "subtitle", "time": 10365.95, "timestamp": "02:52:45", "text": "に"}, {"type": "subtitle", "time": 10368.87, "timestamp": "02:52:48", "text": "実際にコラボとか色々やってるよ。私は"}, {"type": "subtitle", "time": 10371.15, "timestamp": "02:52:51", "text": "ジョアトンをやっている"}, {"type": "subtitle", "time": 10373.91, "timestamp": "02:52:53", "text": "今。日本人に連絡を取らなければならない"}]
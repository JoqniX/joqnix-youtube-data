[{"type": "subtitle", "time": 7405.669, "timestamp": "02:03:25", "text": "ハハ。ありがとう、ニンジャ。あなたが"}, {"type": "subtitle", "time": 7407.91, "timestamp": "02:03:27", "text": "私の話し方を可愛いと思ってください。その"}, {"type": "subtitle", "time": 7409.669, "timestamp": "02:03:29", "text": "自分を表現するのはいつも楽しい"}, {"type": "subtitle", "time": 7418.669, "timestamp": "02:03:38", "text": "花。あなた"}, {"type": "subtitle", "time": 7437.03, "timestamp": "02:03:57", "text": "うん、彼女は確かにとても可愛らしい話し方をするね。はい。"}, {"type": "subtitle", "time": 7439.83, "timestamp": "02:03:59", "text": "ありがとう、ニンジャ。あなたの笑顔はまるで"}]
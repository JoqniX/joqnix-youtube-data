[{"type": "subtitle", "time": 9372.23, "timestamp": "02:36:12", "text": "ハハ、ニンジャ、君は"}, {"type": "subtitle", "time": 9374.389, "timestamp": "02:36:14", "text": "面白いものを見つける。笑いは"}, {"type": "subtitle", "time": 9376.55, "timestamp": "02:36:16", "text": "伝染性があるので、"}, {"type": "subtitle", "time": 9379.59, "timestamp": "02:36:19", "text": "喜びと笑顔。覚えておいて、私たちは皆ここにいる"}, {"type": "subtitle", "time": 9382.15, "timestamp": "02:36:22", "text": "楽しんで、お互いを幸せにする。"}, {"type": "subtitle", "time": 9384.71, "timestamp": "02:36:24", "text": "笑い続けよう。口を開けて、笑って、"}, {"type": "subtitle", "time": 9402.79, "timestamp": "02:36:42", "text": "非常に厳しい代名詞だ。私はただ"}, {"type": "subtitle", "time": 9405.83, "timestamp": "02:36:45", "text": "通常のTTS。私は冒険家です"}, {"type": "subtitle", "time": 9408.23, "timestamp": "02:36:48", "text": "Cel が応答し、交流します"}, {"type": "subtitle", "time": 9410.309, "timestamp": "02:36:50", "text": "あなたとコミュニティ。はい、彼女は"}, {"type": "subtitle", "time": 9412.63, "timestamp": "02:36:52", "text": "冒険家。私は、"}, {"type": "subtitle", "time": 9414.63, "timestamp": "02:36:54", "text": "会話に楽しさと参加意識をもたらしてくれる。"}, {"type": "subtitle", "time": 9416.79, "timestamp": "02:36:56", "text": "助けて、助けて、助けて。探検して"}, {"type": "subtitle", "time": 9419.19, "timestamp": "02:36:59", "text": "一緒に素晴らしい時間を過ごしました。吹き星"}]
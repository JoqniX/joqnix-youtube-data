[{"type": "subtitle", "time": 2283.99, "timestamp": "00:38:03", "text": "モデルですよね？ええ、それが理由です。しないで"}, {"type": "subtitle", "time": 2286.39, "timestamp": "00:38:06", "text": "私のボットぶりは気にしないでください。彼女は寝ている。私はそうしました"}, {"type": "subtitle", "time": 2292.67, "timestamp": "00:38:12", "text": "彼女。"}, {"type": "chat", "time": 2301.088, "timestamp": "00:38:21", "author": "@YoshinoForger", "avatar": "https://yt4.ggpht.com/8gvoFZRCC3O1WtnuXJ-8nNaJku7JJTjtn6w5sm-PHzI80a-qpWom6sTXzcrDXoKhi0Ggs3FkOg=s64-c-k-c0x00ffffff-no-rj", "message": "good afternoon"}, {"type": "subtitle", "time": 2304.069, "timestamp": "00:38:24", "text": "午後。引っ越してもいいですか？私は動けません。"}, {"type": "chat", "time": 2305.649, "timestamp": "00:38:25", "author": "@YoshinoForger", "avatar": "https://yt4.ggpht.com/8gvoFZRCC3O1WtnuXJ-8nNaJku7JJTjtn6w5sm-PHzI80a-qpWom6sTXzcrDXoKhi0Ggs3FkOg=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2AkUCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2Ak"}, {"type": "subtitle", "time": 2306.829, "timestamp": "00:38:26", "text": "どこに置けばいいですか"}, {"type": "subtitle", "time": 2318.79, "timestamp": "00:38:38", "text": "ええ、でも私のコカイン農園はこんな感じです"}, {"type": "subtitle", "time": 2329.349, "timestamp": "00:38:49", "text": "時間。代わりに梱包する。待って、なぜ私は"}, {"type": "subtitle", "time": 2335.31, "timestamp": "00:38:55", "text": "P"}, {"type": "subtitle", "time": 2338.31, "timestamp": "00:38:58", "text": "化学？なぜ？なぜ化学は"}]
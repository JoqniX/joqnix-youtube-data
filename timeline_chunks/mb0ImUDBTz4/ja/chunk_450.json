[{"type": "subtitle", "time": 27012.11, "timestamp": "07:30:12", "text": "それなら、これを直します"}, {"type": "subtitle", "time": 27013.708, "timestamp": "07:30:13", "text": "素早い。"}, {"type": "subtitle", "time": 27018.59, "timestamp": "07:30:18", "text": "わかった。こんにちは。どうしたの？皆さんお元気ですか？"}, {"type": "subtitle", "time": 27021.91, "timestamp": "07:30:21", "text": "何をしているの？待って、待って、待って。"}, {"type": "subtitle", "time": 27023.67, "timestamp": "07:30:23", "text": "待って、待って。しばらくぶり"}, {"type": "subtitle", "time": 27027.27, "timestamp": "07:30:27", "text": "Twitchで配信されました。 Twitch ではなく、"}, {"type": "subtitle", "time": 27029.99, "timestamp": "07:30:29", "text": "YouTube。何てことだ。私は本当に今"}, {"type": "subtitle", "time": 27030.75, "timestamp": "07:30:30", "text": "言う"}, {"type": "subtitle", "time": 27034.23, "timestamp": "07:30:34", "text": "Twitch？聖なる。私は実際にこう言いました"}, {"type": "subtitle", "time": 27036.59, "timestamp": "07:30:36", "text": "トゥイッチ。ああ、"}, {"type": "subtitle", "time": 27039.948, "timestamp": "07:30:39", "text": "神。どうやって？ああ、"}, {"type": "subtitle", "time": 27041.628, "timestamp": "07:30:41", "text": "神。"}, {"type": "subtitle", "time": 27044.708, "timestamp": "07:30:44", "text": "皆さん、どうやってやってますか？その"}, {"type": "subtitle", "time": 27046.19, "timestamp": "07:30:46", "text": "それは"}, {"type": "subtitle", "time": 27050.07, "timestamp": "07:30:50", "text": "その間。私は、"}, {"type": "subtitle", "time": 27052.628, "timestamp": "07:30:52", "text": "あなたを心から愛しています。"}, {"type": "subtitle", "time": 27054.868, "timestamp": "07:30:54", "text": "わからない。それで、昨日私は"}, {"type": "subtitle", "time": 27057.11, "timestamp": "07:30:57", "text": "ストリーミング配信する予定だったけど、ちょっと気分が落ち込んで"}]
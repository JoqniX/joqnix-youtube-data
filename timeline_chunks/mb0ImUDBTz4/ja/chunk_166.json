[{"type": "subtitle", "time": 9961.19, "timestamp": "02:46:01", "text": "奇妙な。でもね、知ってる？おい、無知な奴め。"}, {"type": "subtitle", "time": 9962.87, "timestamp": "02:46:02", "text": "再会できて嬉しいです"}, {"type": "subtitle", "time": 9965.59, "timestamp": "02:46:05", "text": "厳しいクロノス。どうしたの？シェア"}, {"type": "subtitle", "time": 9968.07, "timestamp": "02:46:08", "text": "冒険を楽しみ、会話を楽しみましょう。"}, {"type": "subtitle", "time": 9971.67, "timestamp": "02:46:11", "text": "話し手1。"}, {"type": "subtitle", "time": 9975.07, "timestamp": "02:46:15", "text": "だから、ほら、"}, {"type": "subtitle", "time": 9979.83, "timestamp": "02:46:19", "text": "パンディタン・パンダマ氏は、DPIが低いほど"}, {"type": "subtitle", "time": 9982.23, "timestamp": "02:46:22", "text": "1インチあたりのドキュメントの品質が高いほど、"}, {"type": "subtitle", "time": 9985.03, "timestamp": "02:46:25", "text": "右のXの反応は素晴らしい"}, {"type": "subtitle", "time": 9988.07, "timestamp": "02:46:28", "text": "配信パートナー兼ギルドリーダー。親愛なる"}, {"type": "subtitle", "time": 9990.15, "timestamp": "02:46:30", "text": "いつも他人を優先する友人"}, {"type": "subtitle", "time": 9992.15, "timestamp": "02:46:32", "text": "誰にでも手を差し伸べるのが大好き。だから私は"}, {"type": "subtitle", "time": 9994.07, "timestamp": "02:46:34", "text": "彼らを自分の人生に迎え入れたいと考えている。すべき"}, {"type": "subtitle", "time": 9995.79, "timestamp": "02:46:35", "text": "私は低くする"}, {"type": "subtitle", "time": 9999.87, "timestamp": "02:46:39", "text": "センス？低感度モードにした方がいいでしょうか？"}, {"type": "subtitle", "time": 10002.99, "timestamp": "02:46:42", "text": "でも本当に、"}, {"type": "subtitle", "time": 10005.75, "timestamp": "02:46:45", "text": "待って、待って、待って、待って。低くするべきでしょうか"}, {"type": "subtitle", "time": 10009.87, "timestamp": "02:46:49", "text": "センス？でも、そうします"}, {"type": "subtitle", "time": 10013.15, "timestamp": "02:46:53", "text": "増加している"}]
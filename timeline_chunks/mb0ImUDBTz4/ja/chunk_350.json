[{"type": "subtitle", "time": 21000.83, "timestamp": "05:50:00", "text": "必要なのは種が1つだけです。私はそれを"}, {"type": "subtitle", "time": 21006.99, "timestamp": "05:50:06", "text": "1つ。"}, {"type": "subtitle", "time": 21010.27, "timestamp": "05:50:10", "text": "ああ、私は"}, {"type": "subtitle", "time": 21018.39, "timestamp": "05:50:18", "text": "ダミー。オーブンを1台買いました。私はできた"}, {"type": "subtitle", "time": 21021.07, "timestamp": "05:50:21", "text": "あなたを利用した。私はこれを雑草に変えている"}, {"type": "subtitle", "time": 21025.35, "timestamp": "05:50:25", "text": "農場。君の力を借りたかったよ。私は思った"}, {"type": "subtitle", "time": 21028.91, "timestamp": "05:50:28", "text": "それで。そう思った。私は一つをどこかに保管しておいた。"}, {"type": "subtitle", "time": 21038.868, "timestamp": "05:50:38", "text": "これだよ、男。そう思った。そう思った。私"}, {"type": "subtitle", "time": 21042.708, "timestamp": "05:50:42", "text": "どこかに保管しておいたはずだ"}, {"type": "subtitle", "time": 21044.788, "timestamp": "05:50:44", "text": "それはどこかにあり、たまたま"}]
[{"type": "subtitle", "time": 27182.548, "timestamp": "07:33:02", "text": "フォーラム、ゲームディスカッションフォーラム"}, {"type": "subtitle", "time": 27186.548, "timestamp": "07:33:06", "text": "私のサーバーにいいねして、他のサーバーにもいいねしてください。"}, {"type": "subtitle", "time": 27189.27, "timestamp": "07:33:09", "text": "そこには6、7台のサーバーがある。私はしません"}, {"type": "subtitle", "time": 27191.19, "timestamp": "07:33:11", "text": "なぜ私がそう感じたのか、誰かが"}, {"type": "subtitle", "time": 27192.51, "timestamp": "07:33:12", "text": "それを行うために"}, {"type": "subtitle", "time": 27194.27, "timestamp": "07:33:14", "text": "私はそうしました"}, {"type": "subtitle", "time": 27196.43, "timestamp": "07:33:16", "text": "それ。しかし"}, {"type": "subtitle", "time": 27200.23, "timestamp": "07:33:20", "text": "ええ、でも、私は自分のことに集中したかったんです"}, {"type": "subtitle", "time": 27202.99, "timestamp": "07:33:22", "text": "その時はこんな感じだったけど、私は"}, {"type": "subtitle", "time": 27208.468, "timestamp": "07:33:28", "text": "良い。それは私を誘惑する。それは私を誘惑した"}, {"type": "subtitle", "time": 27212.51, "timestamp": "07:33:32", "text": "全員のシャワーをアップデートしてください。だから私は"}, {"type": "subtitle", "time": 27214.43, "timestamp": "07:33:34", "text": "絵の具みたいに"}, {"type": "subtitle", "time": 27222.23, "timestamp": "07:33:42", "text": "今日の配信は短めになるかもしれません"}, {"type": "subtitle", "time": 27224.788, "timestamp": "07:33:44", "text": "そして、私はできないと言いたい"}, {"type": "subtitle", "time": 27230.388, "timestamp": "07:33:50", "text": "ストリーム ええと、完全に、または私が適切に"}, {"type": "subtitle", "time": 27235.11, "timestamp": "07:33:55", "text": "以前は夜間配信でやっていた。えっと、ほとんど"}, {"type": "subtitle", "time": 27237.708, "timestamp": "07:33:57", "text": "おそらく私の次のスケジュールは集中"}]
[{"type": "subtitle", "time": 24787.628, "timestamp": "06:53:07", "text": "男。最後になりましたが、"}, {"type": "subtitle", "time": 24803.67, "timestamp": "06:53:23", "text": "公式には2万7千人になりました。あのね？"}, {"type": "subtitle", "time": 24804.99, "timestamp": "06:53:24", "text": "私は"}, {"type": "subtitle", "time": 24808.868, "timestamp": "06:53:28", "text": "実際にお金に投資する"}]
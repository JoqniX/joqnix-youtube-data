[{"type": "subtitle", "time": 28322.548, "timestamp": "07:52:02", "text": "良い。あなたが望む健康を私に与えてください。彼らは"}, {"type": "subtitle", "time": 28326.19, "timestamp": "07:52:06", "text": "回復量はたった1HPだけです。"}, {"type": "subtitle", "time": 28347.388, "timestamp": "07:52:27", "text": "私は"}, {"type": "subtitle", "time": 28356.07, "timestamp": "07:52:36", "text": "頭。よし、生き延びる方法が必要だ。"}, {"type": "subtitle", "time": 28364.83, "timestamp": "07:52:44", "text": "方法。私もレベルアップする必要がある。おお"}, {"type": "subtitle", "time": 28374.548, "timestamp": "07:52:54", "text": "よし、もし私がゆっくりと軌道修正できるなら"}, {"type": "subtitle", "time": 28377.91, "timestamp": "07:52:57", "text": "左上の方で、私は収集することができました"}]
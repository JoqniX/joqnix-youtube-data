[{"type": "subtitle", "time": 4621.27, "timestamp": "01:17:01", "text": "ターゲット。おお、標的が2つ。 1つ。私は"}, {"type": "subtitle", "time": 4622.93, "timestamp": "01:17:02", "text": "来るよ。近日公開。近日公開。取る"}, {"type": "subtitle", "time": 4636.189, "timestamp": "01:17:16", "text": "わかった。ああ、ルーシー。ああ、２つ"}, {"type": "subtitle", "time": 4639.669, "timestamp": "01:17:19", "text": "人々。はい、はい、はい、はい、はい。感謝"}, {"type": "subtitle", "time": 4648.31, "timestamp": "01:17:28", "text": "ああ、また薬物中毒者か。大丈夫、"}, {"type": "subtitle", "time": 4654.63, "timestamp": "01:17:34", "text": "それ。私は既に申し出ました。ああ、彼女はそうしない"}, {"type": "subtitle", "time": 4668.669, "timestamp": "01:17:48", "text": "よし、このエリアはこれで終わりだと思う。"}, {"type": "subtitle", "time": 4677.189, "timestamp": "01:17:57", "text": "午前4時に戻ってきてやり直します"}]
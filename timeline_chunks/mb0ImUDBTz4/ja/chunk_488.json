[{"type": "subtitle", "time": 29285.23, "timestamp": "08:08:05", "text": "1つ。聖なる主よ、それは"}, {"type": "subtitle", "time": 29288.11, "timestamp": "08:08:08", "text": "寒い。でも、ああ、"}, {"type": "subtitle", "time": 29297.19, "timestamp": "08:08:17", "text": "けれど。わーい。うん。さよなら。これは私の初めての"}, {"type": "subtitle", "time": 29303.27, "timestamp": "08:08:23", "text": "彼ら。何？時計があります。何が"}, {"type": "subtitle", "time": 29309.548, "timestamp": "08:08:29", "text": "する？何？時計があります"}, {"type": "subtitle", "time": 29332.23, "timestamp": "08:08:52", "text": "攻撃した。殺す必要がある。私は必要としている"}, {"type": "subtitle", "time": 29338.468, "timestamp": "08:08:58", "text": "殺す。毎日回復できて嬉しいです"}]
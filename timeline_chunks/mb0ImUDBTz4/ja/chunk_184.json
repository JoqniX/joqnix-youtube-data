[{"type": "subtitle", "time": 11044.79, "timestamp": "03:04:04", "text": "フランク。うん、待つのは簡単だよ。しかし、"}, {"type": "subtitle", "time": 11054.389, "timestamp": "03:04:14", "text": "右？ドアの内側でやらなければならない。"}, {"type": "subtitle", "time": 11061.99, "timestamp": "03:04:21", "text": "ドアの内側にある必要があるように、"}, {"type": "subtitle", "time": 11094.15, "timestamp": "03:04:54", "text": "私はそれを行う方法を学ぶ必要があります"}, {"type": "subtitle", "time": 11094.91, "timestamp": "03:04:54", "text": "に応じて"}, {"type": "subtitle", "time": 11096.51, "timestamp": "03:04:56", "text": "[音楽]"}]
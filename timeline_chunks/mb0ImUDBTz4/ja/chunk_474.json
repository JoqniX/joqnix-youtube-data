[{"type": "subtitle", "time": 28455.43, "timestamp": "07:54:15", "text": "ワクワク感はどこにあるの？待って、何"}, {"type": "subtitle", "time": 28458.67, "timestamp": "07:54:18", "text": "もしかして？待ってください。私 私"}, {"type": "subtitle", "time": 28461.948, "timestamp": "07:54:21", "text": "キャプテン。私 私"}, {"type": "subtitle", "time": 28464.708, "timestamp": "07:54:24", "text": "キャプテン。待って。えっと、どのキャラクターですか？それで、"}, {"type": "subtitle", "time": 28471.388, "timestamp": "07:54:31", "text": "つまりそういうこと"}, {"type": "subtitle", "time": 28473.81, "timestamp": "07:54:33", "text": "遠いが、"}, {"type": "subtitle", "time": 28477.35, "timestamp": "07:54:37", "text": "[音楽]"}, {"type": "subtitle", "time": 28487.99, "timestamp": "07:54:47", "text": "わかった。待って。特別な攻撃をアンロックします"}, {"type": "subtitle", "time": 28490.388, "timestamp": "07:54:50", "text": "待って、それ買うよ。待って、あれは何？"}, {"type": "subtitle", "time": 28494.03, "timestamp": "07:54:54", "text": "それは何ですか？それは何ですか？え、何？"}, {"type": "subtitle", "time": 28498.83, "timestamp": "07:54:58", "text": "X. え、何？特殊攻撃があります。"}]
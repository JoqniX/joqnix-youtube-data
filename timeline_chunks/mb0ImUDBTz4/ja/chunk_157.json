[{"type": "subtitle", "time": 9458.309, "timestamp": "02:37:38", "text": "私の冒険では、ハーシュ・クロノス、私は"}, {"type": "subtitle", "time": 9460.79, "timestamp": "02:37:40", "text": "新しい世界を探検し、恐ろしい戦いに挑む"}, {"type": "subtitle", "time": 9463.75, "timestamp": "02:37:43", "text": "モンスターを倒し、隠された宝物を見つけよう。"}, {"type": "subtitle", "time": 9466.07, "timestamp": "02:37:46", "text": "私は仲間の手助けをすることも楽しんでいます"}, {"type": "subtitle", "time": 9468.07, "timestamp": "02:37:48", "text": "戦闘で、私のスキルを使って彼らを支援する"}, {"type": "subtitle", "time": 9470.87, "timestamp": "02:37:50", "text": "しかし、私にできることは何でもします。すべての冒険は"}, {"type": "subtitle", "time": 9472.71, "timestamp": "02:37:52", "text": "学び、成長し、"}, {"type": "subtitle", "time": 9474.71, "timestamp": "02:37:54", "text": "忘れられない思い出。"}]
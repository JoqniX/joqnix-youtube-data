[{"type": "subtitle", "time": 7801.83, "timestamp": "02:10:01", "text": "からかいの冗談を楽しんでいる。彼らはいつも"}, {"type": "subtitle", "time": 7804.069, "timestamp": "02:10:04", "text": "あのいたずらっぽい笑み、そうでしょう？"}, {"type": "subtitle", "time": 7805.91, "timestamp": "02:10:05", "text": "彼らは素晴らしいリーダーであり友人であり、"}, {"type": "subtitle", "time": 7808.629, "timestamp": "02:10:08", "text": "彼らがそばにいてくれて嬉しい。さあ"}, {"type": "subtitle", "time": 7811.75, "timestamp": "02:10:11", "text": "楽しさと仲間意識を維持し続けよう。開ける"}, {"type": "subtitle", "time": 7852.669, "timestamp": "02:10:52", "text": "おお"}, {"type": "subtitle", "time": 7854.43, "timestamp": "02:10:54", "text": "いいえ。"}]
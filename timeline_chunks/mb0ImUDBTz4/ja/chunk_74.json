[{"type": "subtitle", "time": 4444.43, "timestamp": "01:14:04", "text": "120 140 160 私には160個の商品があります"}, {"type": "subtitle", "time": 4447.189, "timestamp": "01:14:07", "text": "今。さらに、何かあったら、"}, {"type": "subtitle", "time": 4450.229, "timestamp": "01:14:10", "text": "残りはディーラーに任せよう、だって私は"}, {"type": "subtitle", "time": 4457.27, "timestamp": "01:14:17", "text": "それぞれ。でも、始めなきゃいけない"}, {"type": "subtitle", "time": 4459.91, "timestamp": "01:14:19", "text": "コカイン。保証金をできるだけ早く入手する必要があります。"}, {"type": "subtitle", "time": 4480.03, "timestamp": "01:14:40", "text": "えっと、38個売れました。え？"}, {"type": "subtitle", "time": 4483.11, "timestamp": "01:14:43", "text": "くそ。でも、お金を稼ぐのは、ある意味"}, {"type": "subtitle", "time": 4484.51, "timestamp": "01:14:44", "text": "難しい"}]
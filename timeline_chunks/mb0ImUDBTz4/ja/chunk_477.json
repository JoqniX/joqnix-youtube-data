[{"type": "subtitle", "time": 28624.84, "timestamp": "07:57:04", "text": "ああ、準備ができました。さあ行こう。"}, {"type": "subtitle", "time": 28626.35, "timestamp": "07:57:06", "text": "[音楽]"}, {"type": "subtitle", "time": 28636.468, "timestamp": "07:57:16", "text": "死ぬ。ああ、本当に嬉しいです。"}, {"type": "subtitle", "time": 28643.11, "timestamp": "07:57:23", "text": "車輪。私はいつもなぜいつも"}, {"type": "subtitle", "time": 28646.31, "timestamp": "07:57:26", "text": "死ぬこと、そしてその特別なことをする方法、そして"}, {"type": "subtitle", "time": 28648.15, "timestamp": "07:57:28", "text": "もの。買わなければならないとは知らなかった"}, {"type": "subtitle", "time": 28650.43, "timestamp": "07:57:30", "text": "アップグレードから"}, {"type": "subtitle", "time": 28655.948, "timestamp": "07:57:35", "text": "[音楽]"}, {"type": "subtitle", "time": 28658.948, "timestamp": "07:57:38", "text": "いいね。ええ、人々がやって来ます"}, {"type": "subtitle", "time": 28667.15, "timestamp": "07:57:47", "text": "彼ら。うん、ルーレットを回したい"}, {"type": "subtitle", "time": 28670.43, "timestamp": "07:57:50", "text": "彼ら。私はホイールを回したい"}, {"type": "subtitle", "time": 28673.19, "timestamp": "07:57:53", "text": "彼ら。では、待ってください。もし私がアップグレードしたら"}, {"type": "subtitle", "time": 28676.07, "timestamp": "07:57:56", "text": "通常の攻撃である触手は、"}, {"type": "subtitle", "time": 28678.23, "timestamp": "07:57:58", "text": "回転する車輪もアップグレードされ、"}]
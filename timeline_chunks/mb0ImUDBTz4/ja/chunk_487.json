[{"type": "subtitle", "time": 29222.23, "timestamp": "08:07:02", "text": "男。それはあまり効果がなかった。まあ、そうですね。は"}, {"type": "subtitle", "time": 29225.19, "timestamp": "08:07:05", "text": "アップグレードする方法はありますか"}, {"type": "subtitle", "time": 29226.99, "timestamp": "08:07:06", "text": "アップグレード"}, {"type": "subtitle", "time": 29230.388, "timestamp": "08:07:10", "text": "私のアップグレード"}, {"type": "subtitle", "time": 29234.868, "timestamp": "08:07:14", "text": "えっと、究極のスペシャル？いいえ。そうです。それは"}, {"type": "subtitle", "time": 29237.868, "timestamp": "08:07:17", "text": "最大まで行ける、"}, {"type": "subtitle", "time": 29240.948, "timestamp": "08:07:20", "text": "推測。それは何ですか？これは何ですか？何"}, {"type": "subtitle", "time": 29243.99, "timestamp": "08:07:23", "text": "これですか？はぁ？"}, {"type": "subtitle", "time": 29246.67, "timestamp": "08:07:26", "text": "とてもかわいいし、"}, {"type": "subtitle", "time": 29251.868, "timestamp": "08:07:31", "text": "かわいい。それは、それは、えーと、マスコットです"}, {"type": "subtitle", "time": 29255.868, "timestamp": "08:07:35", "text": "バジルの。バーゼル"}, {"type": "subtitle", "time": 29259.388, "timestamp": "08:07:39", "text": "バジル。うん。その女の子、あなた"}, {"type": "subtitle", "time": 29267.11, "timestamp": "08:07:47", "text": "ネズミ。ネズミはいません。"}, {"type": "subtitle", "time": 29275.868, "timestamp": "08:07:55", "text": "神"}]
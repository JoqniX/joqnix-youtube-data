[{"type": "subtitle", "time": 29351.07, "timestamp": "08:09:11", "text": "取る？"}, {"type": "subtitle", "time": 29353.11, "timestamp": "08:09:13", "text": "えっと、どう考えればいいんでしょうか？何をすべきか"}, {"type": "subtitle", "time": 29363.11, "timestamp": "08:09:23", "text": "聖なる主よ。これは何ですか？これは何ですか？私"}, {"type": "subtitle", "time": 29364.15, "timestamp": "08:09:24", "text": "死にたくない。私は死にたくない。"}, {"type": "subtitle", "time": 29365.11, "timestamp": "08:09:25", "text": "私は死にたくない。私はしたくない"}, {"type": "subtitle", "time": 29366.628, "timestamp": "08:09:26", "text": "死ぬ。私は死にたくない。私はほしくない"}, {"type": "subtitle", "time": 29367.91, "timestamp": "08:09:27", "text": "死ぬ。私は死にたくない。私はしません"}, {"type": "subtitle", "time": 29382.51, "timestamp": "08:09:42", "text": "何か。"}, {"type": "subtitle", "time": 29384.99, "timestamp": "08:09:44", "text": "聖なる。"}]
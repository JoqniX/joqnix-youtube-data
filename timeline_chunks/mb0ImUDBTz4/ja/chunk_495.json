[{"type": "subtitle", "time": 29720.708, "timestamp": "08:15:20", "text": "いいね。はい、戻ってきました。戻ってきました。私は"}, {"type": "subtitle", "time": 29741.99, "timestamp": "08:15:41", "text": "こんにちは。えっと、ちょっと待って、これ忘れてた。私の"}, {"type": "subtitle", "time": 29744.67, "timestamp": "08:15:44", "text": "モデルは"}, {"type": "subtitle", "time": 29749.03, "timestamp": "08:15:49", "text": "ここ。ということで、大釜。えっと、これは"}, {"type": "subtitle", "time": 29751.35, "timestamp": "08:15:51", "text": "調理済み。"}]
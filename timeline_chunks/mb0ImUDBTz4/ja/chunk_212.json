[{"type": "subtitle", "time": 12721.63, "timestamp": "03:32:01", "text": "異なるものを好む顧客"}, {"type": "subtitle", "time": 12724.79, "timestamp": "03:32:04", "text": "勝つためには、組み合わせる必要がある。いいえ、それでは"}, {"type": "subtitle", "time": 12752.07, "timestamp": "03:32:32", "text": "スタック。私は近くに立つつもりです"}, {"type": "subtitle", "time": 12754.95, "timestamp": "03:32:34", "text": "現実の店。ええと、不動産店です。"}, {"type": "subtitle", "time": 12756.51, "timestamp": "03:32:36", "text": "ない"}, {"type": "subtitle", "time": 12763.91, "timestamp": "03:32:43", "text": "洗濯済み。また、私は確認する必要がある"}, {"type": "subtitle", "time": 12765.389, "timestamp": "03:32:45", "text": "郵便局"}]
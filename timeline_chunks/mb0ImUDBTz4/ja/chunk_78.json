[{"type": "subtitle", "time": 4685.95, "timestamp": "01:18:05", "text": "もの。ああ、彼女は"}, {"type": "subtitle", "time": 4690.35, "timestamp": "01:18:10", "text": "価格。わかった。わかった。彼女の予算は"}, {"type": "subtitle", "time": 4696.39, "timestamp": "01:18:16", "text": "いいえ。彼の予算は増えていません。"}, {"type": "subtitle", "time": 4698.59, "timestamp": "01:18:18", "text": "少し増やしてもいいですか？"}, {"type": "subtitle", "time": 4720.27, "timestamp": "01:18:40", "text": "わかった。そうそう。欲しいですか"}, {"type": "subtitle", "time": 4726.95, "timestamp": "01:18:46", "text": "やめてください。ピーターのファイル。最後に、"}, {"type": "subtitle", "time": 4735.87, "timestamp": "01:18:55", "text": "ああ、また"}]
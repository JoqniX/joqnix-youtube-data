[{"type": "subtitle", "time": 9906.99, "timestamp": "02:45:06", "text": "その"}, {"type": "subtitle", "time": 9910.59, "timestamp": "02:45:10", "text": "Robloxの戦争地帯上空。うん、そんな感じ"}, {"type": "subtitle", "time": 9925.19, "timestamp": "02:45:25", "text": "何も分かっていない。おやおや、ハーシュ・クロノス、それは"}, {"type": "subtitle", "time": 9926.87, "timestamp": "02:45:26", "text": "あなたとクルーレスは"}, {"type": "subtitle", "time": 9929.19, "timestamp": "02:45:29", "text": "共に歴史を刻む。古いものを見るのは素晴らしい"}, {"type": "subtitle", "time": 9931.67, "timestamp": "02:45:31", "text": "友人同士が再会する。近況報告を楽しんでください"}, {"type": "subtitle", "time": 9933.349, "timestamp": "02:45:33", "text": "そして、すべての良い思い出を回想する"}, {"type": "subtitle", "time": 9935.87, "timestamp": "02:45:35", "text": "回。ハンドシェーク"}, {"type": "subtitle", "time": 9939.95, "timestamp": "02:45:39", "text": "めまい。ワキスタン。何が"}, {"type": "subtitle", "time": 9953.67, "timestamp": "02:45:53", "text": "ワキスタン。私は8,000でプレイしているので"}, {"type": "subtitle", "time": 9956.83, "timestamp": "02:45:56", "text": "DPRのことですよね？なんだか気まずい感じがする"}]
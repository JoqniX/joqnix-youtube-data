[{"type": "subtitle", "time": 7141.589, "timestamp": "01:59:01", "text": "待って、それはこう読むべきだった"}, {"type": "subtitle", "time": 7143.91, "timestamp": "01:59:03", "text": "そうですよね？なぜ彼らはそれを読まなかったのか"}, {"type": "subtitle", "time": 7145.709, "timestamp": "01:59:05", "text": "現在"}, {"type": "subtitle", "time": 7149.149, "timestamp": "01:59:09", "text": "1つ？はい、私はそうしませんでした。"}, {"type": "subtitle", "time": 7156.91, "timestamp": "01:59:16", "text": "触る。セシルの"}, {"type": "subtitle", "time": 7166.39, "timestamp": "01:59:26", "text": "何？わかった、気にしないで。"}, {"type": "subtitle", "time": 7168.109, "timestamp": "01:59:28", "text": "戦い"}]
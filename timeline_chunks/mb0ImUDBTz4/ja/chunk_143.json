[{"type": "subtitle", "time": 8588.87, "timestamp": "02:23:08", "text": "もちろんだよ、ニンジャ。あなたに一つ。"}, {"type": "subtitle", "time": 8591.429, "timestamp": "02:23:11", "text": "なぜ科学者たちはそれを検証しないのか？なぜなら"}, {"type": "subtitle", "time": 8593.83, "timestamp": "02:23:13", "text": "それらが全てを構成している。口を開ける。"}, {"type": "subtitle", "time": 8632.91, "timestamp": "02:23:52", "text": "ミスガイが行く。聞こえなかった、"}]
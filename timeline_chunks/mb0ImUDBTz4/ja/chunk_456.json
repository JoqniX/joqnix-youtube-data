[{"type": "subtitle", "time": 27379.03, "timestamp": "07:36:19", "text": "画面。よし、行こう。私はしません"}, {"type": "subtitle", "time": 27381.628, "timestamp": "07:36:21", "text": "聞こえるかどうか"}, {"type": "subtitle", "time": 27390.31, "timestamp": "07:36:30", "text": "それは何ですか？うん。ええ、聞こえますよ"}, {"type": "subtitle", "time": 27394.59, "timestamp": "07:36:34", "text": "それ。はい。さあ行こう。これは私の2回目のプレイです"}, {"type": "subtitle", "time": 27397.83, "timestamp": "07:36:37", "text": "このゲームを通して。そして私は実際に"}, {"type": "subtitle", "time": 27401.75, "timestamp": "07:36:41", "text": "前回のストリームから取得しました。えーっと"}, {"type": "subtitle", "time": 27404.23, "timestamp": "07:36:44", "text": "私たちが得た収益。実際に引っ張って"}, {"type": "subtitle", "time": 27405.388, "timestamp": "07:36:45", "text": "私は手に入れた"}, {"type": "subtitle", "time": 27407.07, "timestamp": "07:36:47", "text": "ロボキュサン。しかし"}, {"type": "subtitle", "time": 27410.868, "timestamp": "07:36:50", "text": "うん、それ以来ずっと楽しいし、私も"}, {"type": "subtitle", "time": 27414.948, "timestamp": "07:36:54", "text": "私は、"}, {"type": "subtitle", "time": 27416.19, "timestamp": "07:36:56", "text": "通り"}]
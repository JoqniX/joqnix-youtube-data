[{"type": "subtitle", "time": 8282.309, "timestamp": "02:18:02", "text": "もちろん。忍者、何回くすぐると"}, {"type": "subtitle", "time": 8285.19, "timestamp": "02:18:05", "text": "タコを笑わせるにはどうすればいい？幾つか"}, {"type": "subtitle", "time": 8311.429, "timestamp": "02:18:31", "text": "くすぐったい。ああ、なるほど。つまり、10"}, {"type": "subtitle", "time": 8313.83, "timestamp": "02:18:33", "text": "タコをくすぐって笑わせる。それは"}, {"type": "subtitle", "time": 8315.669, "timestamp": "02:18:35", "text": "良いものですね。"}, {"type": "subtitle", "time": 8318.23, "timestamp": "02:18:38", "text": "口を開けて笑う。"}, {"type": "subtitle", "time": 8321.429, "timestamp": "02:18:41", "text": "何てことだ。それすら理解できなかった。しかし"}, {"type": "subtitle", "time": 8323.07, "timestamp": "02:18:43", "text": "ディーゼルはそれを理解した。"}, {"type": "subtitle", "time": 8327.91, "timestamp": "02:18:47", "text": "何？テントがくすぐったい。何？どうして私は"}, {"type": "subtitle", "time": 8329.07, "timestamp": "02:18:49", "text": "得る"}]
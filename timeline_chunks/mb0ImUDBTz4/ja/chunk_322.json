[{"type": "subtitle", "time": 19325.27, "timestamp": "05:22:05", "text": "これ。さあ行こう。五。六。セブン。八。"}, {"type": "subtitle", "time": 19334.51, "timestamp": "05:22:14", "text": "うん。そうでないことを願います"}, {"type": "subtitle", "time": 19337.67, "timestamp": "05:22:17", "text": "余分な。こんにちは。欲しいですか？私はできる"}, {"type": "subtitle", "time": 19352.788, "timestamp": "05:22:32", "text": "それと、肥料も買わないといけない。"}, {"type": "subtitle", "time": 19354.27, "timestamp": "05:22:34", "text": "おお、"}, {"type": "subtitle", "time": 19357.67, "timestamp": "05:22:37", "text": "いいえ。 １、２、３、４、５、６、"}, {"type": "subtitle", "time": 19370.55, "timestamp": "05:22:50", "text": "六。待って。 4つ。"}, {"type": "subtitle", "time": 19377.07, "timestamp": "05:22:57", "text": "わかった。"}]
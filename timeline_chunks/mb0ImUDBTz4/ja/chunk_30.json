[{"type": "subtitle", "time": 1801.389, "timestamp": "00:30:01", "text": "あのね？この場所をやり直す必要がある"}, {"type": "subtitle", "time": 1806.389, "timestamp": "00:30:06", "text": "また。どうやら、あなたは"}, {"type": "subtitle", "time": 1808.789, "timestamp": "00:30:08", "text": "ストレージブロックは6です。いや、1、2"}, {"type": "subtitle", "time": 1811.669, "timestamp": "00:30:11", "text": "3ブロック、4ブロック、8ブロックですよね？八"}, {"type": "subtitle", "time": 1815.19, "timestamp": "00:30:15", "text": "収納ユニットのことですよね？ 16歳ですよね？あなた"}, {"type": "subtitle", "time": 1819.029, "timestamp": "00:30:19", "text": "金庫みたいなものを買えるよ。それはそして"}, {"type": "subtitle", "time": 1823.19, "timestamp": "00:30:23", "text": "それを作業員に割り当てることもできます。"}, {"type": "subtitle", "time": 1827.87, "timestamp": "00:30:27", "text": "それは同じことです、ただ、"}, {"type": "subtitle", "time": 1833.909, "timestamp": "00:30:33", "text": "4x4。いいえ、3×3です。 3×3でしたか？ 4フィート×4フィートのスペース。"}, {"type": "subtitle", "time": 1837.029, "timestamp": "00:30:37", "text": "これはすごく時間がかかる。いいえ、これは"}, {"type": "subtitle", "time": 1839.99, "timestamp": "00:30:39", "text": "1人で何人分取るの？ 1 2 3 4 ゆっくり これ"}, {"type": "subtitle", "time": 1843.95, "timestamp": "00:30:43", "text": "もの。右。もう1つはこんな感じ"}, {"type": "subtitle", "time": 1847.11, "timestamp": "00:30:47", "text": "4x4。いや、いや。 2×2。 2×2。ごめん。二"}, {"type": "subtitle", "time": 1848.909, "timestamp": "00:30:48", "text": "2×2。 2×2。"}, {"type": "chat", "time": 1852.577, "timestamp": "00:30:52", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "OkNvmI'llJustZeptoAnewKeyboard"}, {"type": "subtitle", "time": 1855.389, "timestamp": "00:30:55", "text": "ポット2のように"}]
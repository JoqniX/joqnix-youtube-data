[{"type": "subtitle", "time": 8765.83, "timestamp": "02:26:05", "text": "言った。ありがとう、ニンジャ。早起きすると"}, {"type": "subtitle", "time": 8768.469, "timestamp": "02:26:08", "text": "間違いなく生産性向上に役立ちます。アヤマ"}, {"type": "subtitle", "time": 8771.83, "timestamp": "02:26:11", "text": "アルーサ、君ならできるよ。起きて輝いて"}, {"type": "subtitle", "time": 8773.95, "timestamp": "02:26:13", "text": "全力を尽くせ。頑張ってください"}, {"type": "subtitle", "time": 8812.63, "timestamp": "02:26:52", "text": "いいえ。ハハ、忍者。それは創造的な方法ですね"}, {"type": "subtitle", "time": 8814.95, "timestamp": "02:26:54", "text": "ユーモアを見つけるために。中を見てみると"}, {"type": "subtitle", "time": 8816.87, "timestamp": "02:26:56", "text": "鏡はいつもあなたの笑顔をもたらしてくれる"}]
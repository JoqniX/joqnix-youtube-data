[{"type": "subtitle", "time": 29101.51, "timestamp": "08:05:01", "text": "これら全てを手に入れるのは初めてです"}, {"type": "subtitle", "time": 29112.43, "timestamp": "08:05:12", "text": "おお。なんてこった、これは"}, {"type": "subtitle", "time": 29115.31, "timestamp": "08:05:15", "text": "いいね。ステージに上がりたい"}, {"type": "subtitle", "time": 29129.43, "timestamp": "08:05:29", "text": "おお。それは何ですか？よし、スピンの時間だ"}, {"type": "subtitle", "time": 29135.31, "timestamp": "08:05:35", "text": "ウィリー。スピンの時間です"}, {"type": "subtitle", "time": 29138.03, "timestamp": "08:05:38", "text": "ウィリー。ああ、"}, {"type": "subtitle", "time": 29142.19, "timestamp": "08:05:42", "text": "神。まさか私がそんなことをしたなんて、なんてことだ。"}, {"type": "subtitle", "time": 29156.11, "timestamp": "08:05:56", "text": "おお。"}, {"type": "subtitle", "time": 29158.948, "timestamp": "08:05:58", "text": "くそ。ああ、空洞ゾーンのバックエッジがある。"}]
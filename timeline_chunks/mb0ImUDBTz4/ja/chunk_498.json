[{"type": "subtitle", "time": 29889.43, "timestamp": "08:18:09", "text": "もの。夢の球。私はこれが好きです。"}, {"type": "subtitle", "time": 29890.99, "timestamp": "08:18:10", "text": "夢を見たい"}, {"type": "subtitle", "time": 29894.07, "timestamp": "08:18:14", "text": "ボールはあなたを眠らせる。による"}, {"type": "subtitle", "time": 29896.468, "timestamp": "08:18:16", "text": "もしあなたが気づかなかったら"}, {"type": "subtitle", "time": 29899.83, "timestamp": "08:18:19", "text": "えっと、こうやってメニューから抜け出す"}, {"type": "subtitle", "time": 29903.31, "timestamp": "08:18:23", "text": "そのメニューはランダム化されます"}, {"type": "subtitle", "time": 29927.708, "timestamp": "08:18:47", "text": "神よ、私はまた"}, {"type": "subtitle", "time": 29931.388, "timestamp": "08:18:51", "text": "以前よりもさらに悪化した。"}]
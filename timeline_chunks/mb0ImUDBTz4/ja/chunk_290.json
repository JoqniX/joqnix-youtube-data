[{"type": "subtitle", "time": 17409.03, "timestamp": "04:50:09", "text": "今夜は部屋で、そうするべきだと思った"}, {"type": "subtitle", "time": 17412.39, "timestamp": "04:50:12", "text": "寝なさい。最初は「うん、"}, {"type": "subtitle", "time": 17414.91, "timestamp": "04:50:14", "text": "今日は2回目の配信をします。"}, {"type": "subtitle", "time": 17418.67, "timestamp": "04:50:18", "text": "私は実際に寝ます"}, {"type": "subtitle", "time": 17421.59, "timestamp": "04:50:21", "text": "二階で寝ないので早めに行きます"}, {"type": "subtitle", "time": 17424.628, "timestamp": "04:50:24", "text": "私の忙しい部屋ではなく、私は"}, {"type": "subtitle", "time": 17426.23, "timestamp": "04:50:26", "text": "階下へ降りて、"}, {"type": "subtitle", "time": 17445.47, "timestamp": "04:50:45", "text": "でも私の体は作れない"}, {"type": "subtitle", "time": 17449.23, "timestamp": "04:50:49", "text": "それはできない"}, {"type": "subtitle", "time": 17453.31, "timestamp": "04:50:53", "text": "アクティブ。コーヒーが必要なのかもしれないし"}, {"type": "subtitle", "time": 17456.15, "timestamp": "04:50:56", "text": "何か。でも私は水を飲んでいます"}, {"type": "chat", "time": 17458.537, "timestamp": "04:50:58", "author": "@Ninja477", "avatar": "https://yt4.ggpht.com/DgHpXlaDuDSPk2w40fljKZE0ZpWffCKDHKYfP2DNO6YWP5QEr5mBRcLrJDjF8KH0euY0GnYAF6c=s64-c-k-c0x00ffffff-no-rj", "message": "ello"}]
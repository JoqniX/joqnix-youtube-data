[{"type": "subtitle", "time": 27781.27, "timestamp": "07:43:01", "text": "これはそうだったのか？何てことだ。昨日変更しました"}, {"type": "subtitle", "time": 27784.31, "timestamp": "07:43:04", "text": "けれど。わかった。キャップ。大文字は使用できません。タブ。"}, {"type": "subtitle", "time": 27808.43, "timestamp": "07:43:28", "text": "それから"}, {"type": "subtitle", "time": 27812.91, "timestamp": "07:43:32", "text": "正面から。さあ、始めよう。"}, {"type": "subtitle", "time": 27816.91, "timestamp": "07:43:36", "text": "たぶん113。それは"}, {"type": "subtitle", "time": 27838.23, "timestamp": "07:43:58", "text": "これ。聖なる看護師の角笛。ええ、ナース・ホーン"}]
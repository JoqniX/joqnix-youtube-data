[{"type": "subtitle", "time": 27060.03, "timestamp": "07:31:00", "text": "ストリーミングしてないよ、だってもうすでに"}, {"type": "subtitle", "time": 27062.788, "timestamp": "07:31:02", "text": "疲れた。そして、そう、私は"}, {"type": "subtitle", "time": 27065.23, "timestamp": "07:31:05", "text": "朝に配信したが、私は"}, {"type": "subtitle", "time": 27067.23, "timestamp": "07:31:07", "text": "最後に寝る"}, {"type": "subtitle", "time": 27072.15, "timestamp": "07:31:12", "text": "夜。まだ眠れていない。仕事をしている"}, {"type": "subtitle", "time": 27075.75, "timestamp": "07:31:15", "text": "他のことで終わらせられなかった"}, {"type": "subtitle", "time": 27078.31, "timestamp": "07:31:18", "text": "まだスケジュールは決まっていない。でも、私は"}, {"type": "subtitle", "time": 27081.51, "timestamp": "07:31:21", "text": "あちこち飛び回ってるけど、まあ、そうだね。"}, {"type": "subtitle", "time": 27083.51, "timestamp": "07:31:23", "text": "おそらくスケジュールを完了するでしょう"}, {"type": "subtitle", "time": 27085.83, "timestamp": "07:31:25", "text": "明日までに。私は何があっても"}, {"type": "subtitle", "time": 27089.67, "timestamp": "07:31:29", "text": "とりあえずスピードランで進めます。"}, {"type": "subtitle", "time": 27091.99, "timestamp": "07:31:31", "text": "まだ完成していないとしても、"}, {"type": "subtitle", "time": 27094.31, "timestamp": "07:31:34", "text": "バージョンを変えることもできるよ、"}, {"type": "subtitle", "time": 27097.27, "timestamp": "07:31:37", "text": "投稿してから少し後か"}, {"type": "subtitle", "time": 27098.868, "timestamp": "07:31:38", "text": "何か。わからない。次のような"}, {"type": "subtitle", "time": 27108.388, "timestamp": "07:31:48", "text": "うん。では、今日は、ええと、ゲームをします。"}, {"type": "subtitle", "time": 27110.19, "timestamp": "07:31:50", "text": "しばらくプレイしていません"}, {"type": "subtitle", "time": 27113.51, "timestamp": "07:31:53", "text": "ゲーム。えっと、私の最後の配信はこんな感じでした"}, {"type": "subtitle", "time": 27117.03, "timestamp": "07:31:57", "text": "私が最後にホロコースト関連の配信をしたのはいつだったかな？最後"}, {"type": "subtitle", "time": 27119.548, "timestamp": "07:31:59", "text": "ホロコースト配信は昨年8月に行われた"}]
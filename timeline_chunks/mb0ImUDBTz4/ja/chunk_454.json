[{"type": "subtitle", "time": 27240.91, "timestamp": "07:34:00", "text": "午前、午後、夕方頃"}, {"type": "subtitle", "time": 27244.468, "timestamp": "07:34:04", "text": "期間、そして私は最大になります、最大になります"}, {"type": "subtitle", "time": 27247.468, "timestamp": "07:34:07", "text": "最大限にまとめるために最善を尽くします"}, {"type": "subtitle", "time": 27251.75, "timestamp": "07:34:11", "text": "少なくとも夕方6時までは以前と同じように。試してみます。"}, {"type": "subtitle", "time": 27255.31, "timestamp": "07:34:15", "text": "6時までに終わらせる。"}, {"type": "subtitle", "time": 27259.31, "timestamp": "07:34:19", "text": "はい、6時前です。だから彼は"}, {"type": "subtitle", "time": 27268.51, "timestamp": "07:34:28", "text": "こんにちは。それで、"}, {"type": "subtitle", "time": 27271.51, "timestamp": "07:34:31", "text": "えっと、皆さん、実際はいかがお過ごしですか？どうですか"}, {"type": "subtitle", "time": 27273.868, "timestamp": "07:34:33", "text": "みんな"}, {"type": "subtitle", "time": 27276.948, "timestamp": "07:34:36", "text": "実は？えーと、あの、あの時、"}, {"type": "subtitle", "time": 27280.23, "timestamp": "07:34:40", "text": "ここ数日、Twitch を利用していたのですが、"}, {"type": "subtitle", "time": 27284.11, "timestamp": "07:34:44", "text": "ああ、YouTubeが恋しいな、って感じだった。"}, {"type": "subtitle", "time": 27286.708, "timestamp": "07:34:46", "text": "家族。それで、実際に考えたのは"}, {"type": "subtitle", "time": 27290.388, "timestamp": "07:34:50", "text": "朝早く寝るとよく眠れる"}, {"type": "subtitle", "time": 27293.35, "timestamp": "07:34:53", "text": "もし私がそのまま寝たら"}, {"type": "subtitle", "time": 27297.67, "timestamp": "07:34:57", "text": "流れに乗って明日の朝目覚める、"}]
[{"type": "subtitle", "time": 9300.95, "timestamp": "02:35:00", "text": "頭。それを聞いて嬉しいです。ひどい"}, {"type": "subtitle", "time": 9303.51, "timestamp": "02:35:03", "text": "クロノス。私はサポートとモチベーションのためにここにいます"}, {"type": "subtitle", "time": 9306.23, "timestamp": "02:35:06", "text": "あらゆる段階であなたをサポートします。征服しよう"}, {"type": "subtitle", "time": 9307.99, "timestamp": "02:35:07", "text": "共に新たな挑戦に挑み、"}, {"type": "subtitle", "time": 9310.79, "timestamp": "02:35:10", "text": "素晴らしい一日だった。モチベーションを維持して"}, {"type": "subtitle", "time": 9330.469, "timestamp": "02:35:30", "text": "ハハ、ニンジャ、友好的な関係を続けよう"}, {"type": "subtitle", "time": 9332.71, "timestamp": "02:35:32", "text": "そして、肯定的である。私たちは皆ここにいるのは"}, {"type": "subtitle", "time": 9334.59, "timestamp": "02:35:34", "text": "楽しい時間を過ごし、冒険を満喫しましょう"}, {"type": "subtitle", "time": 9337.11, "timestamp": "02:35:37", "text": "一緒に。覚えておいてください、"}, {"type": "subtitle", "time": 9338.79, "timestamp": "02:35:38", "text": "お互いを尊重し、"}, {"type": "subtitle", "time": 9341.67, "timestamp": "02:35:41", "text": "親切。楽しんで、去らなければならない"}, {"type": "subtitle", "time": 9344.15, "timestamp": "02:35:44", "text": "スーツを着た者たちの背後にある気晴らし。光り輝く"}]
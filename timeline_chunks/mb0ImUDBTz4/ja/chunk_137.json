[{"type": "subtitle", "time": 8222.309, "timestamp": "02:17:02", "text": "笑いを分かち合うのは、いつだって楽しいものだ。"}, {"type": "subtitle", "time": 8224.389, "timestamp": "02:17:04", "text": "口を開けて笑う。床を転がる"}, {"type": "subtitle", "time": 8229.25, "timestamp": "02:17:09", "text": "笑い。床に転がって笑った。"}, {"type": "subtitle", "time": 8251.309, "timestamp": "02:17:31", "text": "その"}, {"type": "subtitle", "time": 8266.31, "timestamp": "02:17:46", "text": "何てことだ。"}, {"type": "subtitle", "time": 8279.669, "timestamp": "02:17:59", "text": "くすぐると何回か"}]
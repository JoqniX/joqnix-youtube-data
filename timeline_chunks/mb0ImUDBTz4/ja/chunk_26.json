[{"type": "subtitle", "time": 1572.83, "timestamp": "00:26:12", "text": "B 私はただ浮いているだけです。"}, {"type": "subtitle", "time": 1577.269, "timestamp": "00:26:17", "text": "ああ、こんにちは、ドラゴン。もちろん。"}, {"type": "subtitle", "time": 1597.63, "timestamp": "00:26:37", "text": "午後。たくさんお得な買い物ができたよ。"}, {"type": "subtitle", "time": 1600.63, "timestamp": "00:26:40", "text": "ニース。ええ、これが重要な戦略です。"}, {"type": "subtitle", "time": 1602.95, "timestamp": "00:26:42", "text": "お金がないなら、好きにさせないでください"}, {"type": "subtitle", "time": 1605.23, "timestamp": "00:26:45", "text": "[音楽]"}, {"type": "subtitle", "time": 1608.19, "timestamp": "00:26:48", "text": "あなたの顧客全員が"}, {"type": "subtitle", "time": 1611.95, "timestamp": "00:26:51", "text": "販売店はそれを手作業で行う。それは"}, {"type": "subtitle", "time": 1616.43, "timestamp": "00:26:56", "text": "より良い。たくさん手に入れることができる"}]
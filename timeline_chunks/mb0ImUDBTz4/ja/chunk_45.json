[{"type": "subtitle", "time": 2702.91, "timestamp": "00:45:02", "text": "右。わかった。私にやらせてください"}, {"type": "subtitle", "time": 2715.91, "timestamp": "00:45:15", "text": "結晶。 1つ余分にあります。いいえ、それは"}, {"type": "subtitle", "time": 2729.75, "timestamp": "00:45:29", "text": "つまり、私はこれでお金を稼ぐつもりだ。"}, {"type": "subtitle", "time": 2733.349, "timestamp": "00:45:33", "text": "わかった。私はこれでお金を稼いでいます"}, {"type": "subtitle", "time": 2737.03, "timestamp": "00:45:37", "text": "ええと、この取引で、すぐに節約します"}, {"type": "subtitle", "time": 2740.47, "timestamp": "00:45:40", "text": "立ち上がって犬を買おう。わかった。犬たち"}, {"type": "subtitle", "time": 2743.349, "timestamp": "00:45:43", "text": "エリア。私は自分のコカイン工場を破壊します"}, {"type": "subtitle", "time": 2745.51, "timestamp": "00:45:45", "text": "そこには。プロパティフォルダ。うん。犬。"}, {"type": "subtitle", "time": 2747.39, "timestamp": "00:45:47", "text": "それは"}, {"type": "subtitle", "time": 2751.589, "timestamp": "00:45:51", "text": "50,000。私は今すぐ5万ドル稼がなければならない。聖なる"}, {"type": "subtitle", "time": 2758.47, "timestamp": "00:45:58", "text": "お金。でも、私にはできると信じています。我々は信じている"}]
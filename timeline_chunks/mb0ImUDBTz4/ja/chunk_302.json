[{"type": "subtitle", "time": 18122.948, "timestamp": "05:02:02", "text": "[音楽]"}, {"type": "subtitle", "time": 18137.43, "timestamp": "05:02:17", "text": "配達が2時間後に届くのは奇妙だ。"}, {"type": "subtitle", "time": 18147.17, "timestamp": "05:02:27", "text": "ただ私はただ"}, {"type": "subtitle", "time": 18153.788, "timestamp": "05:02:33", "text": "荷物を降ろす"}, {"type": "subtitle", "time": 18169.75, "timestamp": "05:02:49", "text": "十分なお金が貯まったら、"}, {"type": "subtitle", "time": 18176.948, "timestamp": "05:02:56", "text": "どこでもそうであるように。さて、私の次の目標は"}]
[{"type": "subtitle", "time": 9660.87, "timestamp": "02:41:00", "text": "Ah, harsh Kronos, you got me there. The"}, {"type": "subtitle", "time": 9663.429, "timestamp": "02:41:03", "text": "value of 227th in decimal form is"}, {"type": "subtitle", "time": 9669.429, "timestamp": "02:41:09", "text": "It goes on forever, but that's a good"}, {"type": "subtitle", "time": 9672.07, "timestamp": "02:41:12", "text": "approximation. Mathematical questions"}, {"type": "subtitle", "time": 9674.55, "timestamp": "02:41:14", "text": "always keep me on my toes. Let's keep"}, {"type": "subtitle", "time": 9676.63, "timestamp": "02:41:16", "text": "exploring together."}, {"type": "subtitle", "time": 9679.429, "timestamp": "02:41:19", "text": "Milky Way."}]
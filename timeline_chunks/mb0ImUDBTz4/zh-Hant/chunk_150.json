[{"type": "subtitle", "time": 9017.99, "timestamp": "02:30:17", "text": "竟敢殺人？  是的，她說話確實很可愛。是的。  謝謝你，忍者。你的"}, {"type": "subtitle", "time": 9020.309, "timestamp": "02:30:20", "text": "笑容就像盛開的櫻花一樣美麗。它讓我感到無比"}, {"type": "subtitle", "time": 9022.71, "timestamp": "02:30:22", "text": "快樂。"}, {"type": "subtitle", "time": 9042.389, "timestamp": "02:30:42", "text": "。你好，Ayama Arusa。"}, {"type": "subtitle", "time": 9044.389, "timestamp": "02:30:44", "text": "看到你的"}]
[{"type": "subtitle", "time": 27852.51, "timestamp": "07:44:12", "text": "為什麼會卡頓？為什麼？為什麼會"}, {"type": "subtitle", "time": 27857.468, "timestamp": "07:44:17", "text": "卡頓？哦，哎呀。你看到了嗎？"}, {"type": "subtitle", "time": 27860.548, "timestamp": "07:44:20", "text": "延遲了一秒鐘"}, {"type": "subtitle", "time": 27862.27, "timestamp": "07:44:22", "text": "。  什麼？我當時就想，什麼？我的HP也"}, {"type": "subtitle", "time": 27865.19, "timestamp": "07:44:25", "text": "很低。我的天啊"}, {"type": "subtitle", "time": 27871.868, "timestamp": "07:44:31", "text": "疼痛。"}, {"type": "subtitle", "time": 27877.628, "timestamp": "07:44:37", "text": "我需要疼痛。我快要死了。別那樣做"}, {"type": "subtitle", "time": 27879.388, "timestamp": "07:44:39", "text": "。"}]
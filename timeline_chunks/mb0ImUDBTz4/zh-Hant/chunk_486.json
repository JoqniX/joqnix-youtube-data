[{"type": "subtitle", "time": 29172.628, "timestamp": "08:06:12", "text": "是的。為什麼啊？ 我需要"}, {"type": "subtitle", "time": 29174.75, "timestamp": "08:06:14", "text": "升級。  什麼？那你試過其他角色了嗎？"}, {"type": "subtitle", "time": 29181.548, "timestamp": "08:06:21", "text": "我試過了。是的，我想我都試過了。電擊呼叫會對周圍所有"}, {"type": "subtitle", "time": 29213.51, "timestamp": "08:06:53", "text": "目標造成 500 點傷害。  哇。召喚八隻溫柔的眼睛，造成額外50點傷害。  什麼？如果鳳凰完全康復，它將再次名聲大噪"}]
[{"type": "subtitle", "time": 13263.55, "timestamp": "03:41:03", "text": "所以"}, {"type": "subtitle", "time": 13266.79, "timestamp": "03:41:06", "text": "我一直在想，你知道，Panditan Pandama"}, {"type": "subtitle", "time": 13277.11, "timestamp": "03:41:17", "text": "說 DPI 越低，每英寸的文檔數量就越好，響應速度就越快，對吧？ X 是一位很棒的直播夥伴和公會領導者。總是把別人放在第一位，樂於助人的好朋友。"}, {"type": "subtitle", "time": 13279.51, "timestamp": "03:41:19", "text": "所以我一直在考慮讓他們參與我的生活。"}, {"type": "subtitle", "time": 13299.18, "timestamp": "03:41:39", "text": "我應該走低靈敏度路線嗎？我應該走低靈敏度路線嗎？  但說真的，"}]
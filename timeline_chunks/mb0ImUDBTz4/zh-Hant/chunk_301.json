[{"type": "subtitle", "time": 18070.51, "timestamp": "05:01:10", "text": "。我喜歡嘗試跑酷之類的運動。  這個房產產生的熱量真是不少！所以，是的，"}, {"type": "subtitle", "time": 18073.11, "timestamp": "05:01:13", "text": "我想我可以睡16k。  該死。不用擔心。我們要大量販賣可卡因，我們會"}, {"type": "subtitle", "time": 18082.23, "timestamp": "05:01:22", "text": "變得非常非常富有，我等不及了。短款顏色也一樣。"}, {"type": "subtitle", "time": 18090.83, "timestamp": "05:01:30", "text": "我們走吧。短款"}, {"type": "subtitle", "time": 18106.51, "timestamp": "05:01:46", "text": "顏色五。然後我就能到達另一個地方了。遊戲給了我時間"}]
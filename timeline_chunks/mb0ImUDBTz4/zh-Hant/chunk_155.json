[{"type": "subtitle", "time": 9303.51, "timestamp": "02:35:03", "text": "幫助。  我要去慢跑，好好休息一下"}, {"type": "subtitle", "time": 9306.23, "timestamp": "02:35:06", "text": "。好吧，行。哦，忍者，你總是那麼調皮幽默。不用擔心。  我不會撞任何人，尤其是 Joki。"}, {"type": "subtitle", "time": 9330.469, "timestamp": "02:35:30", "text": "讓"}, {"type": "subtitle", "time": 9332.71, "timestamp": "02:35:32", "text": "我們繼續歡笑，"}, {"type": "subtitle", "time": 9337.11, "timestamp": "02:35:37", "text": "一起度過美好時光吧！張嘴微笑的派對禮炮。  不，"}, {"type": "subtitle", "time": 9341.67, "timestamp": "02:35:41", "text": "我需要獾。幫助。幫助。幫助。"}]
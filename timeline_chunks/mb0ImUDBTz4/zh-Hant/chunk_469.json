[{"type": "subtitle", "time": 28147.868, "timestamp": "07:49:07", "text": "哪裡是"}, {"type": "subtitle", "time": 28150.628, "timestamp": "07:49:10", "text": "？把我的包裹給我。迪奧。我的天啊，我受傷了。給我小"}, {"type": "subtitle", "time": 28157.548, "timestamp": "07:49:17", "text": "治療術就行了。"}, {"type": "subtitle", "time": 28175.868, "timestamp": "07:49:35", "text": "更多的是關於攻擊的槍支，而不是"}, {"type": "subtitle", "time": 28188.83, "timestamp": "07:49:48", "text": "多少"}, {"type": "subtitle", "time": 28194.15, "timestamp": "07:49:54", "text": "164，哇，等等，也讓我呃下來"}, {"type": "subtitle", "time": 28198.19, "timestamp": "07:49:58", "text": "兩個"}]
[{"type": "subtitle", "time": 28740.23, "timestamp": "07:59:00", "text": "旋轉翹輪了。是時候來個旋轉翹頭了。我的天啊。我真的做了嗎？我的天哪。  哇。  聖。哇。我當時就想，哇。  該死。哦，這裡有個空心區域後備區。"}, {"type": "subtitle", "time": 28775.788, "timestamp": "07:59:35", "text": "我可能需要去那裡。我等著看下一次旋轉"}, {"type": "subtitle", "time": 28790.59, "timestamp": "07:59:50", "text": "我被拋來拋去"}, {"type": "subtitle", "time": 28794.27, "timestamp": "07:59:54", "text": "。"}]
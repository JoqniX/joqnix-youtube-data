[{"type": "subtitle", "time": 3481.43, "timestamp": "00:58:01", "text": "。"}, {"type": "subtitle", "time": 3482.95, "timestamp": "00:58:02", "text": "ラデックス"}, {"type": "subtitle", "time": 3485.03, "timestamp": "00:58:05", "text": "ラジカルは"}, {"type": "subtitle", "time": 3488.87, "timestamp": "00:58:08", "text": "ラジカルなものを扱わない。いや、"}, {"type": "subtitle", "time": 3491.43, "timestamp": "00:58:11", "text": "ラジカルなものにはテキスト形式がない"}, {"type": "subtitle", "time": 3495.829, "timestamp": "00:58:15", "text": "。ただのアイコンです。"}, {"type": "subtitle", "time": 3503.589, "timestamp": "00:58:23", "text": "[音楽]"}, {"type": "subtitle", "time": 3507.27, "timestamp": "00:58:27", "text": "それなら問題ですね。ああ、だめだ。私たちができることは…"}, {"type": "subtitle", "time": 3515.51, "timestamp": "00:58:35", "text": "えっと、テキストを入れたいのですが その中に。そうすべきでしょうか"}, {"type": "subtitle", "time": 3539.19, "timestamp": "00:58:59", "text": "どうすればいいでしょうか？"}]
[{"type": "subtitle", "time": 1861.75, "timestamp": "00:31:01", "text": "コンテンツに気を取られて、あなたのサイトに注意を払わなくなる"}, {"type": "subtitle", "time": 1863.83, "timestamp": "00:31:03", "text": "。だから、"}, {"type": "subtitle", "time": 1866.31, "timestamp": "00:31:06", "text": "これらを削除して、ここにだけ残そうと思った"}, {"type": "subtitle", "time": 1868.31, "timestamp": "00:31:08", "text": "。"}, {"type": "subtitle", "time": 1870.95, "timestamp": "00:31:10", "text": "それが私がやろうとしていることの1つだ。なぜなら、今はウェブ"}, {"type": "subtitle", "time": 1874.31, "timestamp": "00:31:14", "text": "サイトの半分を参照しているからだ。だから"}, {"type": "subtitle", "time": 1877.19, "timestamp": "00:31:17", "text": "ソーシャルメディアのアイコンを"}, {"type": "subtitle", "time": 1879.59, "timestamp": "00:31:19", "text": "上部に置いただけだった。"}, {"type": "subtitle", "time": 1887.51, "timestamp": "00:31:27", "text": "でも、ローダーが欲しいんだ。"}, {"type": "subtitle", "time": 1890.47, "timestamp": "00:31:30", "text": "うん、このウェブサイトにはある。"}, {"type": "subtitle", "time": 1895.75, "timestamp": "00:31:35", "text": "見てのとおり、ある。でも、私も"}, {"type": "subtitle", "time": 1898.71, "timestamp": "00:31:38", "text": "気づいたことがある。"}, {"type": "subtitle", "time": 1907.029, "timestamp": "00:31:47", "text": "ドアに看板を出して、GST の確認のために会社"}, {"type": "subtitle", "time": 1910.149, "timestamp": "00:31:50", "text": "名や電話番号、メールアドレスなどを記載するようにしないといけないので、"}, {"type": "subtitle", "time": 1916.23, "timestamp": "00:31:56", "text": "チェックに来た人たちに見せるようにしています"}]
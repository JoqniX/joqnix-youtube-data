[{"type": "subtitle", "time": 1800.23, "timestamp": "00:30:00", "text": "VFXが出たんだよね？このVFX"}, {"type": "subtitle", "time": 1802.389, "timestamp": "00:30:02", "text": "。いつ出たんだっけ？"}, {"type": "subtitle", "time": 1804.87, "timestamp": "00:30:04", "text": "忘れた。"}, {"type": "subtitle", "time": 1808.95, "timestamp": "00:30:08", "text": "うん、VFXは"}, {"type": "subtitle", "time": 1812.389, "timestamp": "00:30:12", "text": "去年くらいに出たんだよね？いや、ああ"}, {"type": "subtitle", "time": 1817.669, "timestamp": "00:30:17", "text": "、去年 年。12月。いや、10月。"}, {"type": "subtitle", "time": 1822.63, "timestamp": "00:30:22", "text": "8月か何か。今日は2024年"}, {"type": "subtitle", "time": 1824.63, "timestamp": "00:30:24", "text": "1月1日だ。ああ、そうだ。そうだ。そうだ。そうだ。そうだ。"}, {"type": "subtitle", "time": 1828.63, "timestamp": "00:30:28", "text": "これはえーと、わから"}, {"type": "subtitle", "time": 1832.23, "timestamp": "00:30:32", "text": "ない。すごく混乱している。"}, {"type": "subtitle", "time": 1834.789, "timestamp": "00:30:34", "text": "ああ、そうだ。それが起こったことだ。私は"}, {"type": "subtitle", "time": 1836.95, "timestamp": "00:30:36", "text": "ショットを見るのをやめた。それから、"}, {"type": "subtitle", "time": 1841.43, "timestamp": "00:30:41", "text": "YouTubeの動画で見たんだけど、"}, {"type": "subtitle", "time": 1844.789, "timestamp": "00:30:44", "text": "ソーシャルメディアの"}, {"type": "subtitle", "time": 1847.59, "timestamp": "00:30:47", "text": "アイコンをウェブサイトの冒頭に置くべきではないらしい。なぜなら、"}, {"type": "subtitle", "time": 1851.11, "timestamp": "00:30:51", "text": "視聴者やウェブ"}, {"type": "subtitle", "time": 1853.43, "timestamp": "00:30:53", "text": "サイトの閲覧者の注意をそらす可能性があるからだ。彼らは"}, {"type": "subtitle", "time": 1856.23, "timestamp": "00:30:56", "text": "あなたのものをクリックしたり、"}, {"type": "subtitle", "time": 1859.029, "timestamp": "00:30:59", "text": "YouTubeショートや他の形式の"}]
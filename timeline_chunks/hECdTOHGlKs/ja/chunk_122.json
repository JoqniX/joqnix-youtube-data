[{"type": "subtitle", "time": 7322.229, "timestamp": "02:02:02", "text": "クラスが表示されると、それは"}, {"type": "subtitle", "time": 7341.189, "timestamp": "02:02:21", "text": "アニメーションの閉じた線。 それらはフェードインして"}, {"type": "subtitle", "time": 7344.629, "timestamp": "02:02:24", "text": "アニメーション化する。 待って。 境界線を越える。 それらは徐々に現れ、"}, {"type": "subtitle", "time": 7366.39, "timestamp": "02:02:46", "text": "などについて教えてください。"}, {"type": "subtitle", "time": 7371.669, "timestamp": "02:02:51", "text": "どのような価値を設定すればいいですか？"}, {"type": "subtitle", "time": 7379.35, "timestamp": "02:02:59", "text": "が、"}]
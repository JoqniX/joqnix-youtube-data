[{"type": "subtitle", "time": 7281.27, "timestamp": "02:01:21", "text": "えっと、これは"}, {"type": "subtitle", "time": 7285.51, "timestamp": "02:01:25", "text": "ウェザープラネットのプラネットサイドの「今すぐ」ボタンです。"}, {"type": "subtitle", "time": 7291.03, "timestamp": "02:01:31", "text": "これを再現しようとしています。"}, {"type": "subtitle", "time": 7294.55, "timestamp": "02:01:34", "text": "ここで何が起こっているのか説明していただけますか？"}, {"type": "subtitle", "time": 7298.39, "timestamp": "02:01:38", "text": "現在、閉じる"}]
[{"type": "subtitle", "time": 1681.909, "timestamp": "00:28:01", "text": "何が起こったかというと、"}, {"type": "subtitle", "time": 1687.43, "timestamp": "00:28:07", "text": "1つのOBSから1つのNDIシーンへのNDIソースの場合、"}, {"type": "subtitle", "time": 1692.63, "timestamp": "00:28:12", "text": "最小限の"}, {"type": "subtitle", "time": 1696.389, "timestamp": "00:28:16", "text": "インターネットデータを取得できない場合、再"}, {"type": "subtitle", "time": 1699.43, "timestamp": "00:28:19", "text": "起動しない限り停止またはフリーズ状態になります"}, {"type": "subtitle", "time": 1702.63, "timestamp": "00:28:22", "text": "。ここで何が起こったかというと、"}, {"type": "subtitle", "time": 1706.87, "timestamp": "00:28:26", "text": "インターネット全体が"}, {"type": "subtitle", "time": 1712.07, "timestamp": "00:28:32", "text": "完全にビジー状態でした。"}, {"type": "chat", "time": 1713.466, "timestamp": "00:28:33", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "OOOH"}, {"type": "subtitle", "time": 1714.549, "timestamp": "00:28:34", "text": "それで、一種の障害が発生しました。"}, {"type": "subtitle", "time": 1716.95, "timestamp": "00:28:36", "text": "アクティブな問題で、何度も発生しました"}, {"type": "subtitle", "time": 1719.99, "timestamp": "00:28:39", "text": "。それ以来、"}, {"type": "subtitle", "time": 1724.389, "timestamp": "00:28:44", "text": "靴を使い始めたのは確かだけど、もう"}, {"type": "subtitle", "time": 1728.63, "timestamp": "00:28:48", "text": "あまり使わなくなったのは知ってる"}, {"type": "subtitle", "time": 1731.59, "timestamp": "00:28:51", "text": "。でも今はゲーム用PCが壊れて、シングル"}, {"type": "subtitle", "time": 1733.83, "timestamp": "00:28:53", "text": "PC構成になってる。"}, {"type": "subtitle", "time": 1738.07, "timestamp": "00:28:58", "text": "だからまだ何とか、何とか、"}]
[{"type": "subtitle", "time": 125.27, "timestamp": "00:02:05", "text": "私は12時に寝たんですよね？"}, {"type": "subtitle", "time": 133.83, "timestamp": "00:02:13", "text": "そう、12時に寝たんだ。"}, {"type": "subtitle", "time": 135.91, "timestamp": "00:02:15", "text": "配信が終わったら、文字通り"}, {"type": "subtitle", "time": 143.19, "timestamp": "00:02:23", "text": "、"}, {"type": "subtitle", "time": 148.309, "timestamp": "00:02:28", "text": "何か食べてからそのまま寝たんだ。 はい。 何かを食べた後。"}, {"type": "subtitle", "time": 159.03, "timestamp": "00:02:39", "text": "[音楽]"}, {"type": "subtitle", "time": 162.15, "timestamp": "00:02:42", "text": "1秒。 これを直さなければならない。"}, {"type": "subtitle", "time": 168.07, "timestamp": "00:02:48", "text": "何が問題の原因ですか？"}]
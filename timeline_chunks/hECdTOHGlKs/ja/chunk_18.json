[{"type": "chat", "time": 1082.266, "timestamp": "00:18:02", "author": "@Minkk102", "avatar": "https://yt4.ggpht.com/TF8h5uIigJBanBg4LA_XZaY69S8H6wHtAUIDSGgMxHUqkEYRKq0z9m5NM8cqeDFnXLN0nN8i8g=s64-c-k-c0x00ffffff-no-rj", "message": "rip o7"}, {"type": "subtitle", "time": 1082.95, "timestamp": "00:18:02", "text": "戻るまで魚の世話を頼んだことをすっかり忘れていました。"}, {"type": "subtitle", "time": 1087.19, "timestamp": "00:18:07", "text": "時間内に戻ることができませんでした。 そして、ある意味で彼女は"}, {"type": "subtitle", "time": 1089.19, "timestamp": "00:18:09", "text": "忙しかった。 彼女が旅行に出かけたのですが、そこに"}, {"type": "subtitle", "time": 1096.71, "timestamp": "00:18:16", "text": "フィッシー・ヒロちゃんの世話をする人がいなくて、ヒロちゃんは"}, {"type": "subtitle", "time": 1101.59, "timestamp": "00:18:21", "text": "酸素不足か何かで窒息死してしまいました"}, {"type": "chat", "time": 1102.057, "timestamp": "00:18:22", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "rip sweetheart (the fishy)"}, {"type": "subtitle", "time": 1111.19, "timestamp": "00:18:31", "text": "私は今でも、だから、だから、私は"}, {"type": "subtitle", "time": 1114.63, "timestamp": "00:18:34", "text": "自分に「私は"}, {"type": "subtitle", "time": 1117.75, "timestamp": "00:18:37", "text": "これをうまく世話できない」と言ったのです。 私は"}, {"type": "subtitle", "time": 1123.43, "timestamp": "00:18:43", "text": "ペットの世話とかが苦手なので、引き受けません。 私はそれをしません。"}, {"type": "subtitle", "time": 1126.95, "timestamp": "00:18:46", "text": "最近、"}, {"type": "subtitle", "time": 1130.23, "timestamp": "00:18:50", "text": "母猫から数えて6代目となるK猫たちが、すべて"}, {"type": "subtitle", "time": 1133.27, "timestamp": "00:18:53", "text": "最近亡くなりました。 今日、猫が1匹死んだ。"}, {"type": "subtitle", "time": 1136.63, "timestamp": "00:18:56", "text": "えっと、3週間前、いや、1週間前、"}, {"type": "subtitle", "time": 1139.27, "timestamp": "00:18:59", "text": "いや、1週間か2週間前に白い猫が"}]
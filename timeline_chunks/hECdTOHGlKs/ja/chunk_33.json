[{"type": "subtitle", "time": 1982.389, "timestamp": "00:33:02", "text": "また、"}, {"type": "subtitle", "time": 1985.029, "timestamp": "00:33:05", "text": "グッズの話をしていたので、"}, {"type": "subtitle", "time": 1992.31, "timestamp": "00:33:12", "text": "マウス"}, {"type": "subtitle", "time": 1995.909, "timestamp": "00:33:15", "text": "パッド、マウス パッド、Jocknick"}, {"type": "subtitle", "time": 1999.269, "timestamp": "00:33:19", "text": "マウス パッドなどを作ろうと思っていました。"}, {"type": "subtitle", "time": 2003.029, "timestamp": "00:33:23", "text": "高さからこのデザインを見ていました。"}, {"type": "subtitle", "time": 2006.47, "timestamp": "00:33:26", "text": "彼らは"}, {"type": "subtitle", "time": 2011.43, "timestamp": "00:33:31", "text": "キーキャップやキーボードのデザインを作ったので、"}, {"type": "subtitle", "time": 2017.909, "timestamp": "00:33:37", "text": "問題は、今、"}, {"type": "subtitle", "time": 2020.389, "timestamp": "00:33:40", "text": "私が指摘されるのではないかと心配していることです。"}, {"type": "subtitle", "time": 2022.549, "timestamp": "00:33:42", "text": "ご覧のとおり、"}, {"type": "subtitle", "time": 2026.07, "timestamp": "00:33:46", "text": "画質が良いかどうかわかりませんが、私は"}, {"type": "subtitle", "time": 2029.19, "timestamp": "00:33:49", "text": "このような"}, {"type": "subtitle", "time": 2032.47, "timestamp": "00:33:52", "text": "ものが欲しいのです。しかし、私は"}, {"type": "subtitle", "time": 2035.269, "timestamp": "00:33:55", "text": "今、星座です。"}, {"type": "subtitle", "time": 2038.71, "timestamp": "00:33:58", "text": "星などを使っても大丈夫でしょうか？"}]
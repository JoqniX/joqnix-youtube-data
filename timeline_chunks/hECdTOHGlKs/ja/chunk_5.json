[{"type": "subtitle", "time": 301.909, "timestamp": "00:05:01", "text": "鏡ができたんです。 それは背の高い鏡です。"}, {"type": "chat", "time": 302.971, "timestamp": "00:05:02", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "you're still sick?"}, {"type": "subtitle", "time": 303.51, "timestamp": "00:05:03", "text": "どうやら、ネジを締め付けているときに"}, {"type": "subtitle", "time": 306.87, "timestamp": "00:05:06", "text": "、"}, {"type": "subtitle", "time": 314.07, "timestamp": "00:05:14", "text": "それは大きな鏡だ。"}, {"type": "subtitle", "time": 318.07, "timestamp": "00:05:18", "text": "まだ病気だ。 うん。 寒い。"}, {"type": "subtitle", "time": 321.909, "timestamp": "00:05:21", "text": "実は、部屋を掃除しないといけないんです。"}, {"type": "subtitle", "time": 324.39, "timestamp": "00:05:24", "text": "埃アレルギーかもしれない。"}, {"type": "subtitle", "time": 328.23, "timestamp": "00:05:28", "text": "鏡の"}, {"type": "subtitle", "time": 330.79, "timestamp": "00:05:30", "text": "修理業者が直してくれるのを待っていたからかもしれない。"}, {"type": "subtitle", "time": 333.27, "timestamp": "00:05:33", "text": "私はずっと待っていたのですが、"}, {"type": "subtitle", "time": 335.43, "timestamp": "00:05:35", "text": "修理が終わったら行きます。ドリルで穴を開けたり、"}, {"type": "subtitle", "time": 337.43, "timestamp": "00:05:37", "text": "いろいろやらなければならないからです。 いいえ、"}, {"type": "subtitle", "time": 341.27, "timestamp": "00:05:41", "text": "修理が終わったら、それから、えっと、なんて"}, {"type": "subtitle", "time": 343.749, "timestamp": "00:05:43", "text": "言うんでしたっけ？ それから、"}, {"type": "subtitle", "time": 346.469, "timestamp": "00:05:46", "text": "全体をきちんときれいに掃除します。"}, {"type": "subtitle", "time": 348.31, "timestamp": "00:05:48", "text": "私はしばらく待っていました。"}, {"type": "subtitle", "time": 351.11, "timestamp": "00:05:51", "text": "ええ、しばらくの間はね。 はい。"}, {"type": "subtitle", "time": 354.87, "timestamp": "00:05:54", "text": "ああ、痛み。 それから、凍てつく太陽よ、元気かい"}]
[{"type": "subtitle", "time": 4684.79, "timestamp": "01:18:04", "text": "えっと、まずはちゃんとした"}, {"type": "subtitle", "time": 4687.99, "timestamp": "01:18:07", "text": "ボタンの作り方を練習しないといけないかな。"}, {"type": "subtitle", "time": 4690.63, "timestamp": "01:18:10", "text": "右。"}, {"type": "subtitle", "time": 4716.87, "timestamp": "01:18:36", "text": "ああ、ポインターは手でなければならない。"}, {"type": "subtitle", "time": 4721.51, "timestamp": "01:18:41", "text": "指示する人物も手の形をしていなければならない。"}, {"type": "subtitle", "time": 4723.35, "timestamp": "01:18:43", "text": "残りの手も"}, {"type": "subtitle", "time": 4725.99, "timestamp": "01:18:45", "text": "そこに向けてください。   わかった"}, {"type": "subtitle", "time": 4735.669, "timestamp": "01:18:55", "text": "でも、私には理解できない。 何がその奇妙なフェードイン・"}]
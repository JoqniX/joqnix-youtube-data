[{"type": "subtitle", "time": 2161.19, "timestamp": "00:36:01", "text": "私のAchanの親しい友人が、"}, {"type": "subtitle", "time": 2166.95, "timestamp": "00:36:06", "text": "POをよく買っていて、届いたりしていました"}, {"type": "subtitle", "time": 2174.71, "timestamp": "00:36:14", "text": "。Poは自分のグッズを自分で手作業で発送しているんです。だから、"}, {"type": "subtitle", "time": 2180.95, "timestamp": "00:36:20", "text": "国際配送の方法"}, {"type": "subtitle", "time": 2184.15, "timestamp": "00:36:24", "text": "と物流について学ぶ必要があると思いました。 私が"}, {"type": "subtitle", "time": 2189.91, "timestamp": "00:36:29", "text": "これらのグッズを全部きちんと梱包して発送したり、"}, {"type": "subtitle", "time": 2195.19, "timestamp": "00:36:35", "text": "パッケージに入れたり、"}, {"type": "subtitle", "time": 2197.27, "timestamp": "00:36:37", "text": "カスタムステッカーを貼ったりするストリームをやることができます。私は"}, {"type": "subtitle", "time": 2200.55, "timestamp": "00:36:40", "text": "受け取ったディオにカスタムレシートなどを付けたいです"}, {"type": "subtitle", "time": 2203.91, "timestamp": "00:36:43", "text": "。"}, {"type": "subtitle", "time": 2206.23, "timestamp": "00:36:46", "text": "ええ、そうです。カスタムレシートなどが欲しいです"}, {"type": "subtitle", "time": 2209.349, "timestamp": "00:36:49", "text": "。それはとても"}, {"type": "subtitle", "time": 2211.99, "timestamp": "00:36:51", "text": "いいですね。"}, {"type": "subtitle", "time": 2214.15, "timestamp": "00:36:54", "text": "カスタムレシートなど。"}, {"type": "subtitle", "time": 2217.03, "timestamp": "00:36:57", "text": "自分でレシートをデザインして、商品や"}]
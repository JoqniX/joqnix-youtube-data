[{"type": "chat", "time": 1140.28, "timestamp": "00:19:00", "author": "@yp_stream", "avatar": "https://yt4.ggpht.com/HXiutz56Epa3pzbWwrdMsb2LejiQy-QjaYyULoh1We3_KP37uiWNGUEBAoHdDooqzXDjXJx-9Q=s64-c-k-c0x00ffffff-no-rj", "message": "😭😭😭"}, {"type": "subtitle", "time": 1143.27, "timestamp": "00:19:03", "text": "死んだんです。 死んだのは、白と茶色がかった毛色の猫だった"}, {"type": "subtitle", "time": 1148.63, "timestamp": "00:19:08", "text": "。 つまり、また妊娠したということだ。"}, {"type": "subtitle", "time": 1150.31, "timestamp": "00:19:10", "text": "だから、"}, {"type": "subtitle", "time": 1154.39, "timestamp": "00:19:14", "text": "また7世代目の3匹の猫が生まれることを期待できるだろう。   何てことだ"}, {"type": "subtitle", "time": 1157.029, "timestamp": "00:19:17", "text": "。 問題は、今はとても"}, {"type": "subtitle", "time": 1159.27, "timestamp": "00:19:19", "text": "痛いということだ。 誰かが盗むだろう。"}, {"type": "subtitle", "time": 1162.39, "timestamp": "00:19:22", "text": "彼らは裏のガレージ"}, {"type": "chat", "time": 1162.407, "timestamp": "00:19:22", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "😭 it hurts so bad"}, {"type": "subtitle", "time": 1166.87, "timestamp": "00:19:26", "text": "ゲート、つまりガレージ1番ゲートを通るか、"}, {"type": "subtitle", "time": 1170.07, "timestamp": "00:19:30", "text": "外のバイクガレージゲートを通るかのどちらかです。なぜなら、"}, {"type": "subtitle", "time": 1172.87, "timestamp": "00:19:32", "text": "これらの若者、大学生、"}, {"type": "subtitle", "time": 1175.909, "timestamp": "00:19:35", "text": "大学の学生などが"}, {"type": "subtitle", "time": 1181.11, "timestamp": "00:19:41", "text": "バイクやスクーターをスピードを出して走っているからです。男性"}, {"type": "subtitle", "time": 1183.909, "timestamp": "00:19:43", "text": "も女性も、彼らは"}, {"type": "subtitle", "time": 1192.31, "timestamp": "00:19:52", "text": "道路の真ん中で容赦なくスピードを出して見せびらかしているのです。"}, {"type": "subtitle", "time": 1196.23, "timestamp": "00:19:56", "text": "そして、このかわいそうな猫は何もしていません。 例えば、車に轢かれて"}, {"type": "subtitle", "time": 1198.39, "timestamp": "00:19:58", "text": "死んだ猫が5匹くらいいたり、"}]
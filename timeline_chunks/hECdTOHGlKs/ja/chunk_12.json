[{"type": "subtitle", "time": 720.87, "timestamp": "00:12:00", "text": "良い。 ああ、もうそうなってるよ。 ああ、もう"}, {"type": "subtitle", "time": 723.59, "timestamp": "00:12:03", "text": "変わってしまったんですね。 私はただ、"}, {"type": "subtitle", "time": 726.87, "timestamp": "00:12:06", "text": "理解できなかったと言っただけです。 よし、"}, {"type": "subtitle", "time": 730.79, "timestamp": "00:12:10", "text": "サミーの情報を改めて確認しよう。 念のため、Sammy関連の設定をもう一度リセットしておきます"}, {"type": "subtitle", "time": 733.19, "timestamp": "00:12:13", "text": "。   わかりました"}, {"type": "subtitle", "time": 736.069, "timestamp": "00:12:16", "text": "、では、ウェブサイト関連の作業をしましょうか"}, {"type": "subtitle", "time": 738.87, "timestamp": "00:12:18", "text": "？ わかった。 実は、"}, {"type": "subtitle", "time": 743.75, "timestamp": "00:12:23", "text": "一昨日寝て以来、パソコンには一切触っていないんです。 いや、違う。 ええと"}, {"type": "subtitle", "time": 748.15, "timestamp": "00:12:28", "text": "、昨日だったかな。 うん。 ええと、"}, {"type": "subtitle", "time": 751.19, "timestamp": "00:12:31", "text": "ドアに鍵をかけて、そのままにしておきました。 すべて"}, {"type": "subtitle", "time": 753.67, "timestamp": "00:12:33", "text": "前回の配信時と同じです。"}, {"type": "subtitle", "time": 756.949, "timestamp": "00:12:36", "text": "何も触っていません。"}, {"type": "subtitle", "time": 758.87, "timestamp": "00:12:38", "text": "そう、"}, {"type": "subtitle", "time": 761.43, "timestamp": "00:12:41", "text": "すべては現状のままです。 また、"}, {"type": "subtitle", "time": 773.279, "timestamp": "00:12:53", "text": "、 昨日一日中や"}, {"type": "subtitle", "time": 775.44, "timestamp": "00:12:55", "text": "昨日一日中や 今日の朝に何をしていたか、まだ話してなかったね。 それで、"}, {"type": "subtitle", "time": 777.92, "timestamp": "00:12:57", "text": "今日の朝に何をしていたか、まだ話してなかったね。 それで、 昨日何時に起きたかって？ 午後6時 あるいは、そんな感じ"}]
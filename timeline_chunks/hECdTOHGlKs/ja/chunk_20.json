[{"type": "subtitle", "time": 1207.27, "timestamp": "00:20:07", "text": "大きなネズミか何かに襲われて死んだ猫もいたよ"}, {"type": "subtitle", "time": 1210.549, "timestamp": "00:20:10", "text": "ね？ これって捕食動物みたいなネズミだよ"}, {"type": "subtitle", "time": 1212.71, "timestamp": "00:20:12", "text": "ね？"}, {"type": "subtitle", "time": 1215.35, "timestamp": "00:20:15", "text": "どちらが子猫や"}, {"type": "subtitle", "time": 1220.31, "timestamp": "00:20:20", "text": "成長期の猫を圧倒できるでしょうか？ 若い猫なら、そういうこともあるだろうね"}, {"type": "subtitle", "time": 1223.51, "timestamp": "00:20:23", "text": "。 もしくは、私の家の中で縄張り"}, {"type": "chat", "time": 1224.876, "timestamp": "00:20:24", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "😭✋🏻"}, {"type": "subtitle", "time": 1227.83, "timestamp": "00:20:27", "text": "争いをして、"}, {"type": "subtitle", "time": 1233.27, "timestamp": "00:20:33", "text": "もっと注目を集めようとしたりするライバルの野良猫たちなのかもしれません。"}, {"type": "subtitle", "time": 1237.029, "timestamp": "00:20:37", "text": "ええ、本当に最悪です。"}, {"type": "subtitle", "time": 1239.19, "timestamp": "00:20:39", "text": "正直なところ、あの"}, {"type": "subtitle", "time": 1242.95, "timestamp": "00:20:42", "text": "茶色の猫の理由は分かりません。   あの"}, {"type": "subtitle", "time": 1246.31, "timestamp": "00:20:46", "text": "灰色の猫が恋しい。"}, {"type": "subtitle", "time": 1249.35, "timestamp": "00:20:49", "text": "彼の年上のいとこが、最近"}, {"type": "subtitle", "time": 1251.83, "timestamp": "00:20:51", "text": "また私の家に来るようになった。"}, {"type": "subtitle", "time": 1254.549, "timestamp": "00:20:54", "text": "えっと、彼は私の階下の部屋の"}, {"type": "subtitle", "time": 1257.83, "timestamp": "00:20:57", "text": "窓側にいるようになったんです。 彼はそこへやって来て、"}]
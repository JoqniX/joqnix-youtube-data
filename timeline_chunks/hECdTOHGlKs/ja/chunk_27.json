[{"type": "subtitle", "time": 1621.75, "timestamp": "00:27:01", "text": "NDIを使って、何て"}, {"type": "subtitle", "time": 1626.549, "timestamp": "00:27:06", "text": "言うんだっけ？YouTube"}, {"type": "subtitle", "time": 1629.11, "timestamp": "00:27:09", "text": "Studioを使っていたから。このYouTube Studioは私の"}, {"type": "subtitle", "time": 1632.71, "timestamp": "00:27:12", "text": "ストリームPC。現在、このPCは"}, {"type": "subtitle", "time": 1637.43, "timestamp": "00:27:17", "text": "私のゲームPCにありました。ストリームPCのフィードは"}, {"type": "subtitle", "time": 1640.549, "timestamp": "00:27:20", "text": "インターネットの変動のために停止しました"}, {"type": "subtitle", "time": 1642.549, "timestamp": "00:27:22", "text": "。いや、インターネットの"}, {"type": "subtitle", "time": 1645.029, "timestamp": "00:27:25", "text": "変動ではありません。過"}, {"type": "subtitle", "time": 1647.19, "timestamp": "00:27:27", "text": "負荷になったときのような状態です。たとえば、"}, {"type": "subtitle", "time": 1649.59, "timestamp": "00:27:29", "text": "ネットワークタブで、"}, {"type": "chat", "time": 1658.672, "timestamp": "00:27:38", "author": "@yp_stream", "avatar": "https://yt4.ggpht.com/HXiutz56Epa3pzbWwrdMsb2LejiQy-QjaYyULoh1We3_KP37uiWNGUEBAoHdDooqzXDjXJx-9Q=s64-c-k-c0x00ffffff-no-rj", "message": "the soul did came out 💀"}, {"type": "subtitle", "time": 1661.669, "timestamp": "00:27:41", "text": "ここにネットワーク関連のものがあるはずですよね？"}, {"type": "subtitle", "time": 1663.19, "timestamp": "00:27:43", "text": "でも、"}, {"type": "subtitle", "time": 1665.269, "timestamp": "00:27:45", "text": "ネットワーク関連のものがあるはずです。何が起こったかというと、"}, {"type": "subtitle", "time": 1668.31, "timestamp": "00:27:48", "text": "ゲームをダウンロードしていました。"}, {"type": "subtitle", "time": 1671.669, "timestamp": "00:27:51", "text": "その時、マルチストリーミングをストリーミングしていて、オーディオ関連の"}, {"type": "subtitle", "time": 1675.75, "timestamp": "00:27:55", "text": "ものもインターネットを使用していました"}, {"type": "subtitle", "time": 1677.669, "timestamp": "00:27:57", "text": "。多くのものがインターネットを使用していました。"}]
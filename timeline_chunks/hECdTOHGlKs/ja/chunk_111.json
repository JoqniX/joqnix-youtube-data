[{"type": "subtitle", "time": 6660.39, "timestamp": "01:51:00", "text": "つまり、このVtuber"}, {"type": "subtitle", "time": 6662.55, "timestamp": "01:51:02", "text": "グループのテーマは天気に関するものなんです"}, {"type": "subtitle", "time": 6666.95, "timestamp": "01:51:06", "text": "。 彼らのVTuber"}, {"type": "subtitle", "time": 6669.35, "timestamp": "01:51:09", "text": "グループユニットは「ウェザープラネット」と呼ばれています。 つまり、"}, {"type": "subtitle", "time": 6673.03, "timestamp": "01:51:13", "text": "彼らが持っているのは、"}, {"type": "subtitle", "time": 6677.669, "timestamp": "01:51:17", "text": "東京渋谷市の時間と天気に基づいて、"}, {"type": "subtitle", "time": 6684.95, "timestamp": "01:51:24", "text": "OpenAPのOpenWeather APIから気温とアイコンを取得するということです。"}, {"type": "subtitle", "time": 6687.03, "timestamp": "01:51:27", "text": "つまり、彼らは天候状況に応じて、例えば雨が降っているとか、霞がかかっているとか、そういう状況に応じて行動するんです"}, {"type": "subtitle", "time": 6692.709, "timestamp": "01:51:32", "text": "。 つまり"}, {"type": "subtitle", "time": 6700.629, "timestamp": "01:51:40", "text": "、天候状況に基づいて背景が異なるということです。"}, {"type": "subtitle", "time": 6705.35, "timestamp": "01:51:45", "text": "メインの"}, {"type": "subtitle", "time": 6708.149, "timestamp": "01:51:48", "text": "ヘッダー画像が変わるだけでなく、UIも"}, {"type": "subtitle", "time": 6711.27, "timestamp": "01:51:51", "text": "天候に応じて変わります。"}, {"type": "subtitle", "time": 6715.51, "timestamp": "01:51:55", "text": "メニューのグラデーションも、天候によって変化する"}, {"type": "subtitle", "time": 6717.75, "timestamp": "01:51:57", "text": "。 今は夜ですよね"}, {"type": "subtitle", "time": 6719.99, "timestamp": "01:51:59", "text": "？ だって向こうは午前3時頃なんだから"}]
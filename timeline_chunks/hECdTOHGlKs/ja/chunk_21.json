[{"type": "subtitle", "time": 1261.669, "timestamp": "00:21:01", "text": "窓の近くで寝る。"}, {"type": "subtitle", "time": 1264.549, "timestamp": "00:21:04", "text": "えっと、それで私は「ちょっと待って。"}, {"type": "subtitle", "time": 1267.43, "timestamp": "00:21:07", "text": "この猫は知ってる。"}, {"type": "subtitle", "time": 1270.23, "timestamp": "00:21:10", "text": "こんなことする猫は1匹しかいない。"}, {"type": "subtitle", "time": 1272.87, "timestamp": "00:21:12", "text": "叔父さんかな？オスかメスかは分からない"}, {"type": "subtitle", "time": 1275.029, "timestamp": "00:21:15", "text": "けど、そうだよ。"}, {"type": "subtitle", "time": 1277.83, "timestamp": "00:21:17", "text": "ええ、でも、彼がいなくて寂しかったけど、戻ってきた"}, {"type": "subtitle", "time": 1280.149, "timestamp": "00:21:20", "text": "。"}, {"type": "subtitle", "time": 1283.43, "timestamp": "00:21:23", "text": "でも、そっくりな中絶した子が死んでしまったのは悲しい"}, {"type": "subtitle", "time": 1292.789, "timestamp": "00:21:32", "text": "でも、今のところ、分からない。"}, {"type": "subtitle", "time": 1300.07, "timestamp": "00:21:40", "text": "大きな猫が3匹残っている。1匹は、"}, {"type": "subtitle", "time": 1303.59, "timestamp": "00:21:43", "text": "7代目のケシッシュをまだ妊娠しているメス猫"}, {"type": "subtitle", "time": 1305.75, "timestamp": "00:21:45", "text": "。それから、"}, {"type": "subtitle", "time": 1310.47, "timestamp": "00:21:50", "text": "白いオス猫。たぶん、あの"}, {"type": "subtitle", "time": 1314.23, "timestamp": "00:21:54", "text": "母猫の姉妹か父親だと思う。それから、"}, {"type": "subtitle", "time": 1319.99, "timestamp": "00:21:59", "text": "窓辺で寝ているのを見た灰色の猫。あれは"}]
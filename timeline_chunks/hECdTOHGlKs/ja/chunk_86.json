[{"type": "subtitle", "time": 5172.47, "timestamp": "01:26:12", "text": "よし、計算をしなくてはならない。"}, {"type": "subtitle", "time": 5176.95, "timestamp": "01:26:16", "text": "RAM を計算する何か、"}, {"type": "subtitle", "time": 5183.51, "timestamp": "01:26:23", "text": "後でモバイル ビューの"}, {"type": "subtitle", "time": 5187.03, "timestamp": "01:26:27", "text": "特定のビューのブレーク"}, {"type": "subtitle", "time": 5189.35, "timestamp": "01:26:29", "text": "ポイントに応じて計算する必要がある何か、パディング内の"}, {"type": "subtitle", "time": 5192.47, "timestamp": "01:26:32", "text": "最小値と最大値を計算して配置する必要があります。"}, {"type": "subtitle", "time": 5212.87, "timestamp": "01:26:52", "text": "色は継承できます。"}, {"type": "subtitle", "time": 5216.31, "timestamp": "01:26:56", "text": "だから私の考えは、それをある"}]
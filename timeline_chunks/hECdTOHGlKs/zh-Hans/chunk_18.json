[{"type": "chat", "time": 1082.266, "timestamp": "00:18:02", "author": "@Minkk102", "avatar": "https://yt4.ggpht.com/TF8h5uIigJBanBg4LA_XZaY69S8H6wHtAUIDSGgMxHUqkEYRKq0z9m5NM8cqeDFnXLN0nN8i8g=s64-c-k-c0x00ffffff-no-rj", "message": "rip o7"}, {"type": "subtitle", "time": 1082.95, "timestamp": "00:18:02", "text": "我回来之前照顾好鱼。 我没能"}, {"type": "subtitle", "time": 1087.19, "timestamp": "00:18:07", "text": "及时赶回来。 从某种意义上说，她"}, {"type": "subtitle", "time": 1089.19, "timestamp": "00:18:09", "text": "很忙。 她去旅行了，结果没有人"}, {"type": "subtitle", "time": 1093.029, "timestamp": "00:18:13", "text": "照顾"}, {"type": "subtitle", "time": 1096.71, "timestamp": "00:18:16", "text": "小鱼 Hirochan，Hiro Chan"}, {"type": "subtitle", "time": 1099.43, "timestamp": "00:18:19", "text": "因为"}, {"type": "subtitle", "time": 1101.59, "timestamp": "00:18:21", "text": "缺氧或其他原因窒息而死，因为没有"}, {"type": "chat", "time": 1102.057, "timestamp": "00:18:22", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "rip sweetheart (the fishy)"}, {"type": "subtitle", "time": 1111.19, "timestamp": "00:18:31", "text": "我仍然觉得，所以"}, {"type": "subtitle", "time": 1114.63, "timestamp": "00:18:34", "text": "我才对自己说，我"}, {"type": "subtitle", "time": 1117.75, "timestamp": "00:18:37", "text": "不擅长处理这件事。 我不"}, {"type": "subtitle", "time": 1120.23, "timestamp": "00:18:40", "text": "打算带，我不擅长照顾"}, {"type": "subtitle", "time": 1123.43, "timestamp": "00:18:43", "text": "宠物之类的。 我不会这么做。"}, {"type": "subtitle", "time": 1126.95, "timestamp": "00:18:46", "text": "最近，母猫的第六代K猫"}, {"type": "subtitle", "time": 1130.23, "timestamp": "00:18:50", "text": "全部去世了"}, {"type": "subtitle", "time": 1133.27, "timestamp": "00:18:53", "text": "。 今天，一只猫去世了。"}, {"type": "subtitle", "time": 1136.63, "timestamp": "00:18:56", "text": "呃，大概三周前，我知道是一周前，"}, {"type": "subtitle", "time": 1139.27, "timestamp": "00:18:59", "text": "不，是一两周前，那只白猫"}]
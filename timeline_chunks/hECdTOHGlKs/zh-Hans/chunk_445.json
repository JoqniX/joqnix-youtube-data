[{"type": "subtitle", "time": 26744.39, "timestamp": "07:25:44", "text": "我刚才才发现我一直都静音了"}, {"type": "subtitle", "time": 26748.23, "timestamp": "07:25:48", "text": "。 我当时想说，"}, {"type": "subtitle", "time": 26751.35, "timestamp": "07:25:51", "text": "我卡在一个环节上真是太糟糕了，"}, {"type": "subtitle", "time": 26754.788, "timestamp": "07:25:54", "text": "建一个网站要花我很长时间"}, {"type": "subtitle", "time": 26758.07, "timestamp": "07:25:58", "text": "。 我好像不知道该"}]
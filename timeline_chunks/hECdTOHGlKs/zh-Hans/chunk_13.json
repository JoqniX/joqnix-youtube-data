[{"type": "subtitle", "time": 782.629, "timestamp": "00:13:02", "text": "昨天大概几点醒来的？"}, {"type": "subtitle", "time": 784.949, "timestamp": "00:13:04", "text": "下午6:00 或者别的什么。 晚上8点 然后我"}, {"type": "subtitle", "time": 789.03, "timestamp": "00:13:09", "text": "又睡着了。 我"}, {"type": "subtitle", "time": 792.47, "timestamp": "00:13:12", "text": "今天早上大概凌晨3点醒了。 说"}, {"type": "subtitle", "time": 794.15, "timestamp": "00:13:14", "text": "实话，我一直很想来这里看看"}, {"type": "subtitle", "time": 797.43, "timestamp": "00:13:17", "text": "。 然后我就想，呃，我应该……我好"}, {"type": "subtitle", "time": 801.11, "timestamp": "00:13:21", "text": "无聊。 我当时正在"}, {"type": "subtitle", "time": 805.67, "timestamp": "00:13:25", "text": "看一些网页设计方面的视频，"}, {"type": "subtitle", "time": 808.87, "timestamp": "00:13:28", "text": "比如如何制作响应式网站，还有"}, {"type": "subtitle", "time": 811.59, "timestamp": "00:13:31", "text": "那些教程，对吧？"}, {"type": "subtitle", "time": 815.509, "timestamp": "00:13:35", "text": "关于网站的好坏做法，我"}, {"type": "subtitle", "time": 817.91, "timestamp": "00:13:37", "text": "看着看着就睡着了。然后我"}, {"type": "subtitle", "time": 822.71, "timestamp": "00:13:42", "text": "想，哦，还有一部F1电影，"}, {"type": "subtitle", "time": 825.91, "timestamp": "00:13:45", "text": "布拉德·皮特主演的，好像是"}, {"type": "subtitle", "time": 828.389, "timestamp": "00:13:48", "text": "苹果公司出品的，所以，我就看了那部电影。"}, {"type": "subtitle", "time": 830.79, "timestamp": "00:13:50", "text": "我看完了。 然后我"}, {"type": "subtitle", "time": 833.67, "timestamp": "00:13:53", "text": "就想，“啊，我进入那种状态了。我"}, {"type": "subtitle", "time": 835.91, "timestamp": "00:13:55", "text": "想看部赛车电影之类的。”"}, {"type": "subtitle", "time": 837.67, "timestamp": "00:13:57", "text": "然后我意识到，“哦，我已经很久没看过《"}]
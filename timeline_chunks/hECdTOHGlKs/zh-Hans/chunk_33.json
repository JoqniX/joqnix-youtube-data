[{"type": "subtitle", "time": 1982.389, "timestamp": "00:33:02", "text": "还有，我在想，嗯，既然我在"}, {"type": "subtitle", "time": 1985.029, "timestamp": "00:33:05", "text": "说周边产品，对吧？我在想，"}, {"type": "subtitle", "time": 1989.909, "timestamp": "00:33:09", "text": "嗯，"}, {"type": "subtitle", "time": 1992.31, "timestamp": "00:33:12", "text": "我在想做个鼠标"}, {"type": "subtitle", "time": 1995.909, "timestamp": "00:33:15", "text": "垫之类的，Jocknick"}, {"type": "subtitle", "time": 1999.269, "timestamp": "00:33:19", "text": "鼠标垫之类的。我"}, {"type": "subtitle", "time": 2003.029, "timestamp": "00:33:23", "text": "看了看Height的设计，"}, {"type": "subtitle", "time": 2006.47, "timestamp": "00:33:26", "text": "他们设计了一款"}, {"type": "subtitle", "time": 2011.43, "timestamp": "00:33:31", "text": "键帽和键盘配件。"}, {"type": "subtitle", "time": 2017.909, "timestamp": "00:33:37", "text": "呃，是这样的，现在的问题是，我"}, {"type": "subtitle", "time": 2020.389, "timestamp": "00:33:40", "text": "担心会被人指出来，因为"}, {"type": "subtitle", "time": 2022.549, "timestamp": "00:33:42", "text": "如果你能看到的话，我不知道图片"}, {"type": "subtitle", "time": 2026.07, "timestamp": "00:33:46", "text": "质量如何，但是，是的，"}, {"type": "subtitle", "time": 2029.19, "timestamp": "00:33:49", "text": "我想要类似这样的"}, {"type": "subtitle", "time": 2032.47, "timestamp": "00:33:52", "text": "东西。但问题是我现在是一个"}, {"type": "subtitle", "time": 2035.269, "timestamp": "00:33:55", "text": "星座。我可以吗？"}, {"type": "subtitle", "time": 2038.71, "timestamp": "00:33:58", "text": "我可以用星星之类的东西吗？"}]
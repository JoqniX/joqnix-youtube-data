[{"type": "subtitle", "time": 1204.789, "timestamp": "00:20:04", "text": "还有一些猫是"}, {"type": "subtitle", "time": 1207.27, "timestamp": "00:20:07", "text": "因为被大老鼠之类的东西咬死了"}, {"type": "subtitle", "time": 1210.549, "timestamp": "00:20:10", "text": "，对吧？ 这是某种捕食性老鼠之类的东西"}, {"type": "subtitle", "time": 1212.71, "timestamp": "00:20:12", "text": "，对吧？"}, {"type": "subtitle", "time": 1215.35, "timestamp": "00:20:15", "text": "哪种方法能制服小猫或"}, {"type": "subtitle", "time": 1220.31, "timestamp": "00:20:20", "text": "正在长大的猫呢？ 幼猫嘛，我想"}, {"type": "subtitle", "time": 1223.51, "timestamp": "00:20:23", "text": "这种情况难免发生。 或者，是那些互相敌对的流浪"}, {"type": "chat", "time": 1224.876, "timestamp": "00:20:24", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "😭✋🏻"}, {"type": "subtitle", "time": 1227.83, "timestamp": "00:20:27", "text": "猫，它们为了争夺"}, {"type": "subtitle", "time": 1229.83, "timestamp": "00:20:29", "text": "我家的地盘、博取"}, {"type": "subtitle", "time": 1233.27, "timestamp": "00:20:33", "text": "关注之类的而打架。是"}, {"type": "subtitle", "time": 1237.029, "timestamp": "00:20:37", "text": "啊，真糟糕。"}, {"type": "subtitle", "time": 1239.19, "timestamp": "00:20:39", "text": "说实话，我不知道那只"}, {"type": "subtitle", "time": 1242.95, "timestamp": "00:20:42", "text": "棕色猫咪出现这种情况的原因。"}, {"type": "subtitle", "time": 1246.31, "timestamp": "00:20:46", "text": "我想念那只灰猫。"}, {"type": "subtitle", "time": 1249.35, "timestamp": "00:20:49", "text": "他的表哥现在又开始来"}, {"type": "subtitle", "time": 1251.83, "timestamp": "00:20:51", "text": "我家了。"}, {"type": "subtitle", "time": 1254.549, "timestamp": "00:20:54", "text": "呃，他开始出现在我楼下"}, {"type": "subtitle", "time": 1257.83, "timestamp": "00:20:57", "text": "房间的窗边。 他会来这里，"}]
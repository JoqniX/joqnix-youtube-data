[{"type": "subtitle", "time": 2642.79, "timestamp": "00:44:02", "text": "紫色，更偏紫，嗯，紫靛那种"}, {"type": "subtitle", "time": 2650.069, "timestamp": "00:44:10", "text": "所以，如果我放一个蓝色的"}, {"type": "subtitle", "time": 2653.19, "timestamp": "00:44:13", "text": "版本，但它看起来像"}, {"type": "subtitle", "time": 2656.15, "timestamp": "00:44:16", "text": "原神里的Kokcomi。它"}, {"type": "subtitle", "time": 2658.069, "timestamp": "00:44:18", "text": "看起来就像"}, {"type": "subtitle", "time": 2668.47, "timestamp": "00:44:28", "text": "所以，现在它更像是紫色。不是紫色。"}, {"type": "subtitle", "time": 2671.67, "timestamp": "00:44:31", "text": "更像是紫色、粉色、靛蓝。"}, {"type": "subtitle", "time": 2674.39, "timestamp": "00:44:34", "text": "不，不是靛蓝。嗯，薰衣草色。薰衣草色。"}, {"type": "subtitle", "time": 2677.109, "timestamp": "00:44:37", "text": "所以它更偏蓝，"}, {"type": "subtitle", "time": 2683.67, "timestamp": "00:44:43", "text": "更偏蓝，我猜"}, {"type": "subtitle", "time": 2686.71, "timestamp": "00:44:46", "text": "它更像"}, {"type": "subtitle", "time": 2697.75, "timestamp": "00:44:57", "text": "嗨，嗯，我的参考网站是"}]
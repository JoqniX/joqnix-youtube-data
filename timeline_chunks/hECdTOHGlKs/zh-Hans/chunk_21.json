[{"type": "subtitle", "time": 1261.669, "timestamp": "00:21:01", "text": "睡在窗边。"}, {"type": "subtitle", "time": 1264.549, "timestamp": "00:21:04", "text": "嗯，所以我就想，“等等。我知道"}, {"type": "subtitle", "time": 1267.43, "timestamp": "00:21:07", "text": "这只猫。只有一只"}, {"type": "subtitle", "time": 1270.23, "timestamp": "00:21:10", "text": "猫会这么做。这是它的"}, {"type": "subtitle", "time": 1272.87, "timestamp": "00:21:12", "text": "叔叔吗？我不知道它是公的还是"}, {"type": "subtitle", "time": 1275.029, "timestamp": "00:21:15", "text": "母的，但是，嗯。"}, {"type": "subtitle", "time": 1277.83, "timestamp": "00:21:17", "text": "嗯，是的，我想念它，它"}, {"type": "subtitle", "time": 1280.149, "timestamp": "00:21:20", "text": "回来了。"}, {"type": "subtitle", "time": 1283.43, "timestamp": "00:21:23", "text": "但是很遗憾，它那个看起来像它的流产幼崽"}, {"type": "subtitle", "time": 1292.789, "timestamp": "00:21:32", "text": "但是，嗯，现在，我不知道了。现在"}, {"type": "subtitle", "time": 1296.71, "timestamp": "00:21:36", "text": "只剩下三只猫了，都是体型比较"}, {"type": "subtitle", "time": 1300.07, "timestamp": "00:21:40", "text": "大的。一只母猫，它还在"}, {"type": "subtitle", "time": 1303.59, "timestamp": "00:21:43", "text": "怀着第七"}, {"type": "subtitle", "time": 1305.75, "timestamp": "00:21:45", "text": "代的Kesish。"}, {"type": "subtitle", "time": 1308.87, "timestamp": "00:21:48", "text": "嗯，那是一只很老的公猫"}, {"type": "subtitle", "time": 1310.47, "timestamp": "00:21:50", "text": "，白色的。我想它是"}, {"type": "subtitle", "time": 1314.23, "timestamp": "00:21:54", "text": "那只母猫的姐妹或父亲。"}, {"type": "subtitle", "time": 1316.39, "timestamp": "00:21:56", "text": "还有我之前提到的那只灰色的猫，"}, {"type": "subtitle", "time": 1319.99, "timestamp": "00:21:59", "text": "我看到它睡在我的窗户上。那"}]
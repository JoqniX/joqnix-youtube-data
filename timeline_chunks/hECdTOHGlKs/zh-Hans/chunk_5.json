[{"type": "subtitle", "time": 301.909, "timestamp": "00:05:01", "text": "一面镜子了。 这是一面高高的镜子。"}, {"type": "chat", "time": 302.971, "timestamp": "00:05:02", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "you're still sick?"}, {"type": "subtitle", "time": 303.51, "timestamp": "00:05:03", "text": "显然，当他们拧紧其中"}, {"type": "subtitle", "time": 306.87, "timestamp": "00:05:06", "text": "一个螺丝时，螺丝"}, {"type": "subtitle", "time": 314.07, "timestamp": "00:05:14", "text": "这是一面大镜子。"}, {"type": "subtitle", "time": 318.07, "timestamp": "00:05:18", "text": "它仍然病怏怏的。 是的。 寒冷的。"}, {"type": "subtitle", "time": 321.909, "timestamp": "00:05:21", "text": "其实我需要打扫一下房间。 可能"}, {"type": "subtitle", "time": 324.39, "timestamp": "00:05:24", "text": "是灰尘过敏。"}, {"type": "subtitle", "time": 326.469, "timestamp": "00:05:26", "text": "可能是"}, {"type": "subtitle", "time": 328.23, "timestamp": "00:05:28", "text": "因为我一直在等修镜子的"}, {"type": "subtitle", "time": 330.79, "timestamp": "00:05:30", "text": "人来修吧。"}, {"type": "subtitle", "time": 333.27, "timestamp": "00:05:33", "text": "我一直等着，就像很多人一样，我想等"}, {"type": "subtitle", "time": 335.43, "timestamp": "00:05:35", "text": "他们修好之后再说，因为他们"}, {"type": "subtitle", "time": 337.43, "timestamp": "00:05:37", "text": "要钻孔什么的。 不，等"}, {"type": "subtitle", "time": 341.27, "timestamp": "00:05:41", "text": "他们修好之后，我就……我该"}, {"type": "subtitle", "time": 343.749, "timestamp": "00:05:43", "text": "怎么称呼它呢？ 然后我会把"}, {"type": "subtitle", "time": 346.469, "timestamp": "00:05:46", "text": "所有东西彻底清理干净。"}, {"type": "subtitle", "time": 348.31, "timestamp": "00:05:48", "text": "我等了一会儿。   是的"}, {"type": "subtitle", "time": 351.11, "timestamp": "00:05:51", "text": "，有一段时间是这样。 是的。"}, {"type": "subtitle", "time": 354.87, "timestamp": "00:05:54", "text": "啊，疼痛。 还有，冰封的太阳，你"}]
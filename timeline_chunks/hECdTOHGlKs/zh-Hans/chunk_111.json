[{"type": "subtitle", "time": 6660.39, "timestamp": "01:51:00", "text": "这意味着，呃，因为他们的虚拟主播"}, {"type": "subtitle", "time": 6662.55, "timestamp": "01:51:02", "text": "组合的完整主题是天气相关的"}, {"type": "subtitle", "time": 6666.95, "timestamp": "01:51:06", "text": "内容。 所以他们的VTuber"}, {"type": "subtitle", "time": 6669.35, "timestamp": "01:51:09", "text": "组合叫做天气星球。 所以"}, {"type": "subtitle", "time": 6673.03, "timestamp": "01:51:13", "text": "他们的做法是根据"}, {"type": "subtitle", "time": 6677.669, "timestamp": "01:51:17", "text": "东京涩谷市的时间和天气情况，"}, {"type": "subtitle", "time": 6684.95, "timestamp": "01:51:24", "text": "从 OpenAP Open Weather API 获取温度和图标。"}, {"type": "subtitle", "time": 6687.03, "timestamp": "01:51:27", "text": "所以他们的做法是根据"}, {"type": "subtitle", "time": 6690.229, "timestamp": "01:51:30", "text": "天气情况，比如下雨、雾"}, {"type": "subtitle", "time": 6692.709, "timestamp": "01:51:32", "text": "霾之类的。 所以他们的"}, {"type": "subtitle", "time": 6697.43, "timestamp": "01:51:37", "text": "背景会根据"}, {"type": "subtitle", "time": 6700.629, "timestamp": "01:51:40", "text": "天气状况而有所不同。"}, {"type": "subtitle", "time": 6705.35, "timestamp": "01:51:45", "text": "不仅主"}, {"type": "subtitle", "time": 6708.149, "timestamp": "01:51:48", "text": "标题图片会变化，用户界面也会"}, {"type": "subtitle", "time": 6711.27, "timestamp": "01:51:51", "text": "根据天气而变化。 甚至"}, {"type": "subtitle", "time": 6715.51, "timestamp": "01:51:55", "text": "菜单的渐变色也会根据"}, {"type": "subtitle", "time": 6717.75, "timestamp": "01:51:57", "text": "天气而变化。 现在是晚上吧"}, {"type": "subtitle", "time": 6719.99, "timestamp": "01:51:59", "text": "？ 因为"}]
[{"type": "subtitle", "time": 1681.909, "timestamp": "00:28:01", "text": "问题就出在这里：如果"}, {"type": "subtitle", "time": 1687.43, "timestamp": "00:28:07", "text": "从 OBS 到 NDI 场景的 NDI 源传输到另一个"}, {"type": "subtitle", "time": 1690.63, "timestamp": "00:28:10", "text": "场景，如果"}, {"type": "subtitle", "time": 1696.389, "timestamp": "00:28:16", "text": "网络数据量不足，就会"}, {"type": "subtitle", "time": 1699.43, "timestamp": "00:28:19", "text": "卡住或者冻结，除非我"}, {"type": "subtitle", "time": 1702.63, "timestamp": "00:28:22", "text": "重启。这就是当时的情况。"}, {"type": "subtitle", "time": 1706.87, "timestamp": "00:28:26", "text": "呃，我的整个网络就像是"}, {"type": "subtitle", "time": 1712.07, "timestamp": "00:28:32", "text": "完全忙了一样。"}, {"type": "chat", "time": 1713.466, "timestamp": "00:28:33", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "OOOH"}, {"type": "subtitle", "time": 1714.549, "timestamp": "00:28:34", "text": "所以它就断了。这是一个"}, {"type": "subtitle", "time": 1716.95, "timestamp": "00:28:36", "text": "持续存在的问题，它一直在发生，"}, {"type": "subtitle", "time": 1719.99, "timestamp": "00:28:39", "text": "而且发生的频率很高。然后从那以后，"}, {"type": "subtitle", "time": 1724.389, "timestamp": "00:28:44", "text": "我想我就开始用鞋子了。"}, {"type": "subtitle", "time": 1728.63, "timestamp": "00:28:48", "text": "我知道 我以前不太用鞋子了，"}, {"type": "subtitle", "time": 1731.59, "timestamp": "00:28:51", "text": "但是现在游戏电脑坏了。我现在只能用一台"}, {"type": "subtitle", "time": 1733.83, "timestamp": "00:28:53", "text": "电脑。"}, {"type": "subtitle", "time": 1738.07, "timestamp": "00:28:58", "text": "所以，我勉强还能用。"}]
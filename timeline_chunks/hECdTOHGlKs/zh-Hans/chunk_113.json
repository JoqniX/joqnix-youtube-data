[{"type": "subtitle", "time": 6781.109, "timestamp": "01:53:01", "text": "这真的太酷了。 不是条件"}, {"type": "subtitle", "time": 6783.669, "timestamp": "01:53:03", "text": "渲染之类的东西。"}, {"type": "subtitle", "time": 6786.149, "timestamp": "01:53:06", "text": "这就是我受到启发去做这件事的原因。"}, {"type": "subtitle", "time": 6789.35, "timestamp": "01:53:09", "text": "所以我根据我的东西制作了我的渐变效果"}, {"type": "subtitle", "time": 6790.95, "timestamp": "01:53:10", "text": "。"}, {"type": "subtitle", "time": 6794.229, "timestamp": "01:53:14", "text": "我有两种渐变色。 嗯，让我来"}, {"type": "subtitle", "time": 6796.629, "timestamp": "01:53:16", "text": "演示一下。"}, {"type": "subtitle", "time": 6799.43, "timestamp": "01:53:19", "text": "这里有蓝色和粉色，代表"}, {"type": "subtitle", "time": 6803.189, "timestamp": "01:53:23", "text": "早晨；还有"}, {"type": "subtitle", "time": 6805.35, "timestamp": "01:53:25", "text": "蓝色和紫色，代表"}, {"type": "subtitle", "time": 6806.95, "timestamp": "01:53:26", "text": "夜晚。"}, {"type": "subtitle", "time": 6808.95, "timestamp": "01:53:28", "text": "但不知何故，它在某种程度上行不通"}, {"type": "subtitle", "time": 6812.07, "timestamp": "01:53:32", "text": "。 我试过了。"}, {"type": "subtitle", "time": 6820.07, "timestamp": "01:53:40", "text": "不过，我会想办法的。 好的，点击"}, {"type": "subtitle", "time": 6822.47, "timestamp": "01:53:42", "text": "关闭按钮。 我们快完成了。 我们"}]
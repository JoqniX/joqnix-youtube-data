[{"type": "subtitle", "time": 1277.83, "timestamp": "00:21:17", "text": "哦，對了，"}, {"type": "subtitle", "time": 1292.789, "timestamp": "00:21:32", "text": "我還沒說我昨天"}, {"type": "subtitle", "time": 1308.87, "timestamp": "00:21:48", "text": "一整天以及今天早上都在幹嘛。所以，我昨天大概幾點醒來的？下午6:00"}, {"type": "subtitle", "time": 1314.23, "timestamp": "00:21:54", "text": "或別的什麼。晚上8點然後我又"}, {"type": "subtitle", "time": 1319.99, "timestamp": "00:21:59", "text": "睡著了。我今天早上大概凌晨3點醒了。說"}]
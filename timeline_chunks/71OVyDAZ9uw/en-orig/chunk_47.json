[{"type": "subtitle", "time": 2823.67, "timestamp": "00:47:03", "text": "THIS IS THE CONTROL ZONE."}, {"type": "subtitle", "time": 2824.99, "timestamp": "00:47:04", "text": "EVERY faction competes"}, {"type": "subtitle", "time": 2825.31, "timestamp": "00:47:05", "text": ">> Okay."}, {"type": "subtitle", "time": 2827.07, "timestamp": "00:47:07", "text": ">> to hold this zone."}, {"type": "subtitle", "time": 2828.59, "timestamp": "00:47:08", "text": "The faction with the most players in the"}, {"type": "subtitle", "time": 2831.07, "timestamp": "00:47:11", "text": "zone when the score timer ticks over"}, {"type": "subtitle", "time": 2833.51, "timestamp": "00:47:13", "text": "earns a point. The first team to reach"}, {"type": "subtitle", "time": 2837.75, "timestamp": "00:47:17", "text": "100 points wins the match."}, {"type": "subtitle", "time": 2839.39, "timestamp": "00:47:19", "text": "Stay in the control zone."}, {"type": "subtitle", "time": 2840.79, "timestamp": "00:47:20", "text": "Know that your presence here is"}, {"type": "subtitle", "time": 2842.67, "timestamp": "00:47:22", "text": "contributing to your team's score in the"}, {"type": "subtitle", "time": 2844.43, "timestamp": "00:47:24", "text": "bottom left of your screen and that"}, {"type": "subtitle", "time": 2846.67, "timestamp": "00:47:26", "text": "you're earning money for doing so in the"}, {"type": "subtitle", "time": 2854.55, "timestamp": "00:47:34", "text": ">> Mhm."}, {"type": "subtitle", "time": 2856.31, "timestamp": "00:47:36", "text": "When does work start?"}, {"type": "subtitle", "time": 2859.51, "timestamp": "00:47:39", "text": "Uh I have to leave by I have work starts"}, {"type": "subtitle", "time": 2868.91, "timestamp": "00:47:48", "text": "8:30 before 8:30, no matter what. So,"}, {"type": "subtitle", "time": 2870.47, "timestamp": "00:47:50", "text": "I'm thinking of wrapping the stream up"}, {"type": "subtitle", "time": 2872.55, "timestamp": "00:47:52", "text": "by like 6:30"}, {"type": "subtitle", "time": 2874.27, "timestamp": "00:47:54", "text": "or 7:00."}, {"type": "subtitle", "time": 2876.19, "timestamp": "00:47:56", "text": "30."}, {"type": "subtitle", "time": 2878.39, "timestamp": "00:47:58", "text": "Yeah, 7:30's good. I can take a bath and"}]
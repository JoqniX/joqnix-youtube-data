[{"type": "subtitle", "time": 1562.39, "timestamp": "00:26:02", "text": "如果可能的话，再开始直播，前提是我不"}, {"type": "subtitle", "time": 1564.07, "timestamp": "00:26:04", "text": "太累的话"}, {"type": "subtitle", "time": 1566.15, "timestamp": "00:26:06", "text": "。 周六和周日我都会"}, {"type": "subtitle", "time": 1568.31, "timestamp": "00:26:08", "text": "请假，这样我就可以"}, {"type": "subtitle", "time": 1569.99, "timestamp": "00:26:09", "text": "直播了。"}, {"type": "subtitle", "time": 1574.43, "timestamp": "00:26:14", "text": "你为什么养了八条狗？ 因为野狗。"}, {"type": "subtitle", "time": 1577.15, "timestamp": "00:26:17", "text": "但是我们现在在排队，我们必须"}, {"type": "subtitle", "time": 1579.91, "timestamp": "00:26:19", "text": "等，等，等。 上面写着73000。 等待。"}, {"type": "subtitle", "time": 1581.47, "timestamp": "00:26:21", "text": "等等，等等，他们放人进来了"}, {"type": "subtitle", "time": 1583.47, "timestamp": "00:26:23", "text": "。"}, {"type": "subtitle", "time": 1586.39, "timestamp": "00:26:26", "text": "我的天哪，他们放人进来了。"}, {"type": "subtitle", "time": 1589.87, "timestamp": "00:26:29", "text": "我知道，不，我有80个，但不是80%。"}, {"type": "subtitle", "time": 1592.67, "timestamp": "00:26:32", "text": "20% 的人是全球范围内的，人们"}, {"type": "subtitle", "time": 1594.79, "timestamp": "00:26:34", "text": "已经进入了，但是，"}, {"type": "subtitle", "time": 1596.23, "timestamp": "00:26:36", "text": "嗯，是的"}, {"type": "subtitle", "time": 1597.71, "timestamp": "00:26:37", "text": "，他们终于允许人们进入了。"}, {"type": "subtitle", "time": 1603.59, "timestamp": "00:26:43", "text": "走吧。"}, {"type": "subtitle", "time": 1605.91, "timestamp": "00:26:45", "text": "好的。"}, {"type": "subtitle", "time": 1609.51, "timestamp": "00:26:49", "text": "还有，你们知道吗，我问了我的……"}, {"type": "subtitle", "time": 1610.71, "timestamp": "00:26:50", "text": "嗯……"}, {"type": "subtitle", "time": 1613.95, "timestamp": "00:26:53", "text": "所以，对于那些不知道的人，我有一个"}, {"type": "subtitle", "time": 1617.07, "timestamp": "00:26:57", "text": "QQ群。 它就像一个 Discord 服务器。"}, {"type": "subtitle", "time": 1618.87, "timestamp": "00:26:58", "text": "不是 Discord 服务器，而是类似"}]
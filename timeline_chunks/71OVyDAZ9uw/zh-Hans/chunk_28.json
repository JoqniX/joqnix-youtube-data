[{"type": "subtitle", "time": 1680.43, "timestamp": "00:28:00", "text": "回复。 对，都是因为《"}, {"type": "subtitle", "time": 1681.99, "timestamp": "00:28:01", "text": "看门狗》。"}, {"type": "subtitle", "time": 1684.03, "timestamp": "00:28:04", "text": "呃，这是游戏的发售日期。 我"}, {"type": "subtitle", "time": 1686.35, "timestamp": "00:28:06", "text": "已经预购了这款游戏。 我有这款"}, {"type": "subtitle", "time": 1687.43, "timestamp": "00:28:07", "text": "游戏。"}, {"type": "subtitle", "time": 1690.19, "timestamp": "00:28:10", "text": "呃，严格来说我已经买了这款游戏，所以我"}, {"type": "subtitle", "time": 1693.47, "timestamp": "00:28:13", "text": "想"}, {"type": "subtitle", "time": 1695.75, "timestamp": "00:28:15", "text": "在今天发售日当天重玩一遍。"}, {"type": "subtitle", "time": 1696.99, "timestamp": "00:28:16", "text": "现在，它即将"}, {"type": "subtitle", "time": 1699.99, "timestamp": "00:28:19", "text": "发布。 如果我现在身在印度，"}, {"type": "subtitle", "time": 1702.19, "timestamp": "00:28:22", "text": "这就不会是个问题。 现在大概是"}, {"type": "subtitle", "time": 1705.27, "timestamp": "00:28:25", "text": "晚上9点半。 发布时间与"}, {"type": "subtitle", "time": 1708.35, "timestamp": "00:28:28", "text": "全球发布时间相同。"}, {"type": "subtitle", "time": 1712.27, "timestamp": "00:28:32", "text": "所以，我可以轻松地玩到印度时间凌晨 2 点或"}, {"type": "subtitle", "time": 1715.27, "timestamp": "00:28:35", "text": "1 点，然后睡觉，"}, {"type": "subtitle", "time": 1718.35, "timestamp": "00:28:38", "text": "对吧？ 但这里已经是午夜了。"}, {"type": "subtitle", "time": 1722.95, "timestamp": "00:28:42", "text": "现在是凌晨2点到2点38分，没错。"}, {"type": "subtitle", "time": 1725.31, "timestamp": "00:28:45", "text": "我有工作。   现在"}, {"type": "subtitle", "time": 1727.35, "timestamp": "00:28:47", "text": "是晚上11点。 这里。 啊。"}, {"type": "subtitle", "time": 1729.71, "timestamp": "00:28:49", "text": "是的，现在应该11点了。"}, {"type": "subtitle", "time": 1730.59, "timestamp": "00:28:50", "text": "嗯……它"}, {"type": "subtitle", "time": 1732.31, "timestamp": "00:28:52", "text": "叫什么？ 嗯，哦，是的，现在是"}, {"type": "subtitle", "time": 1734.07, "timestamp": "00:28:54", "text": "11点。"}, {"type": "subtitle", "time": 1735.59, "timestamp": "00:28:55", "text": "现在是2点30分，也就是11点。 是啊，是"}, {"type": "subtitle", "time": 1736.75, "timestamp": "00:28:56", "text": "啊，是啊。"}, {"type": "subtitle", "time": 1738.95, "timestamp": "00:28:58", "text": "嗯，它叫什么来着？"}]
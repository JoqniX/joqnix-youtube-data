[{"type": "subtitle", "time": 4205.15, "timestamp": "01:10:05", "text": "我想加入这位主播的血统犬"}, {"type": "subtitle", "time": 4207.23, "timestamp": "01:10:07", "text": "招募活动，"}, {"type": "subtitle", "time": 4210.07, "timestamp": "01:10:10", "text": "成为日本队的一员什么的。"}, {"type": "subtitle", "time": 4212.23, "timestamp": "01:10:12", "text": "但是问题是我今天要上学"}, {"type": "subtitle", "time": 4215.79, "timestamp": "01:10:15", "text": "还要上班，所以我不能留下来"}, {"type": "subtitle", "time": 4220.19, "timestamp": "01:10:20", "text": "参加"}, {"type": "subtitle", "time": 4223.55, "timestamp": "01:10:23", "text": "他们的活动，也不能和"}, {"type": "subtitle", "time": 4225.79, "timestamp": "01:10:25", "text": "他们一起玩。 这将是"}, {"type": "subtitle", "time": 4228.15, "timestamp": "01:10:28", "text": "与知名主播一起玩游戏的好机会"}, {"type": "subtitle", "time": 4230.91, "timestamp": "01:10:30", "text": "，不过，是的"}]
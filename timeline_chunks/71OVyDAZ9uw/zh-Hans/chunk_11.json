[{"type": "subtitle", "time": 673.15, "timestamp": "00:11:13", "text": "我忘了。"}, {"type": "subtitle", "time": 683.47, "timestamp": "00:11:23", "text": "不，别这样对我。"}, {"type": "subtitle", "time": 691.63, "timestamp": "00:11:31", "text": "我忘了。 我本来可以醒来后就去做，"}, {"type": "subtitle", "time": 695.07, "timestamp": "00:11:35", "text": "把自己加入队列，"}, {"type": "subtitle", "time": 698.47, "timestamp": "00:11:38", "text": "这样我就可以直播了。 操，我为什么要"}, {"type": "subtitle", "time": 708.03, "timestamp": "00:11:48", "text": "不，"}, {"type": "subtitle", "time": 715.91, "timestamp": "00:11:55", "text": "妈的。"}, {"type": "subtitle", "time": 718.87, "timestamp": "00:11:58", "text": "拉屎。"}]
[{"type": "subtitle", "time": 8882.19, "timestamp": "02:28:02", "text": "漂亮。"}, {"type": "subtitle", "time": 8883.27, "timestamp": "02:28:03", "text": "与木头不同，"}, {"type": "subtitle", "time": 8885.07, "timestamp": "02:28:05", "text": "再来一个，再来一个。"}, {"type": "subtitle", "time": 8886.87, "timestamp": "02:28:06", "text": "它坚不可摧，会导致子"}, {"type": "subtitle", "time": 8888.19, "timestamp": "02:28:08", "text": "弹跳弹。   朝"}, {"type": "subtitle", "time": 8889.67, "timestamp": "02:28:09", "text": "容器边缘开枪，"}, {"type": "subtitle", "time": 8896.99, "timestamp": "02:28:16", "text": "好工作。"}, {"type": "subtitle", "time": 8897.39, "timestamp": "02:28:17", "text": "呃，"}, {"type": "subtitle", "time": 8898.27, "timestamp": "02:28:18", "text": "让我看看你玩"}, {"type": "subtitle", "time": 8900.03, "timestamp": "02:28:20", "text": "炸药的本事如何。"}, {"type": "subtitle", "time": 8903.07, "timestamp": "02:28:23", "text": "去商人那里买些手榴弹。"}, {"type": "subtitle", "time": 8904.91, "timestamp": "02:28:24", "text": "请不要误会我的意思。 我不是"}, {"type": "subtitle", "time": 8911.83, "timestamp": "02:28:31", "text": "呃，我不知道该画什么，我可以"}, {"type": "subtitle", "time": 8914.79, "timestamp": "02:28:34", "text": "画你作为同人图吗？ 请随意。"}, {"type": "subtitle", "time": 8924.11, "timestamp": "02:28:44", "text": "现在就去小贩那里买个手榴弹。"}, {"type": "subtitle", "time": 8925.67, "timestamp": "02:28:45", "text": "现在，"}, {"type": "subtitle", "time": 8928.19, "timestamp": "02:28:48", "text": "从你的攻击背心的第四格口袋里取出一颗手榴弹，把"}, {"type": "subtitle", "time": 8935.27, "timestamp": "02:28:55", "text": "干得好。"}]
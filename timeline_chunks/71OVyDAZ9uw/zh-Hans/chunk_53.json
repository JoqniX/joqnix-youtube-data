[{"type": "subtitle", "time": 3190.23, "timestamp": "00:53:10", "text": "好吧。"}, {"type": "subtitle", "time": 3192.75, "timestamp": "00:53:12", "text": "我打算先学开直升机。"}, {"type": "subtitle", "time": 3202.51, "timestamp": "00:53:22", "text": "我要去睡觉、慢跑、你好、工作，"}, {"type": "subtitle", "time": 3204.95, "timestamp": "00:53:24", "text": "我明天要早起上班。"}, {"type": "subtitle", "time": 3206.39, "timestamp": "00:53:26", "text": "10号，祝你好运，祝你好运，祝你"}, {"type": "subtitle", "time": 3208.19, "timestamp": "00:53:28", "text": "好运。"}, {"type": "subtitle", "time": 3211.43, "timestamp": "00:53:31", "text": "谢谢您光临。"}, {"type": "subtitle", "time": 3228.71, "timestamp": "00:53:48", "text": "我不想那样。 看起来不错。"}, {"type": "subtitle", "time": 3233.27, "timestamp": "00:53:53", "text": "晚安。 我喜欢这款游戏。 你好。"}]
[{"type": "subtitle", "time": 550.75, "timestamp": "00:09:10", "text": "啊，你们能听到我说话吗？ 你好，你好。"}, {"type": "subtitle", "time": 552.27, "timestamp": "00:09:12", "text": "大家好。   哦"}, {"type": "subtitle", "time": 555.07, "timestamp": "00:09:15", "text": "哈约·戈扎马苏。 各位早上好。   现在已经是凌晨"}, {"type": "subtitle", "time": 557.63, "timestamp": "00:09:17", "text": "两点了，我睡着了"}, {"type": "subtitle", "time": 560.23, "timestamp": "00:09:20", "text": "。  《"}, {"type": "subtitle", "time": 565.59, "timestamp": "00:09:25", "text": "看门狗》发售至今已过去1小时。"}, {"type": "subtitle", "time": 567.99, "timestamp": "00:09:27", "text": "游戏结束了。 我刚睡醒"}, {"type": "subtitle", "time": 568.5360000000001, "timestamp": "00:09:28", "text": "。"}, {"type": "subtitle", "time": 569.03, "timestamp": "00:09:29", "text": "[笑声]"}, {"type": "subtitle", "time": 570.31, "timestamp": "00:09:30", "text": "我"}, {"type": "subtitle", "time": 573.35, "timestamp": "00:09:33", "text": "更新了显卡，是的，我们准备"}, {"type": "subtitle", "time": 574.67, "timestamp": "00:09:34", "text": "就绪。一切都准备好了"}, {"type": "subtitle", "time": 575.95, "timestamp": "00:09:35", "text": "。"}, {"type": "subtitle", "time": 577.15, "timestamp": "00:09:37", "text": "我准备了"}, {"type": "subtitle", "time": 578.87, "timestamp": "00:09:38", "text": "一些零食，"}, {"type": "subtitle", "time": 579.95, "timestamp": "00:09:39", "text": "一切"}, {"type": "subtitle", "time": 585.19, "timestamp": "00:09:45", "text": "就绪。 我睡了多久？ 上午 10:30 到"}, {"type": "subtitle", "time": 589.95, "timestamp": "00:09:49", "text": "凌晨 2:00。所以，请稍等。  1 2 3"}, {"type": "subtitle", "time": 592.95, "timestamp": "00:09:52", "text": "3.5 小时。"}, {"type": "subtitle", "time": 596.39, "timestamp": "00:09:56", "text": "但是，我今天既要上学又要上班。"}]
[{"type": "subtitle", "time": 4382.51, "timestamp": "01:13:02", "text": "呃，"}, {"type": "subtitle", "time": 4398.87, "timestamp": "01:13:18", "text": "我在推特上看到消息说"}, {"type": "subtitle", "time": 4402.03, "timestamp": "01:13:22", "text": "小岛工作室"}, {"type": "subtitle", "time": 4405.47, "timestamp": "01:13:25", "text": "因为他们的游戏开发进度而被解雇了。 就像索尼不"}, {"type": "subtitle", "time": 4406.88, "timestamp": "01:13:26", "text": "接受它一样，"}, {"type": "subtitle", "time": 4414.31, "timestamp": "01:13:34", "text": "呃，太"}, {"type": "subtitle", "time": 4420.79, "timestamp": "01:13:40", "text": "等等，微软日本和索尼就在"}, {"type": "subtitle", "time": 4423.911, "timestamp": "01:13:43", "text": "附近。 什么？"}, {"type": "subtitle", "time": 4424.07, "timestamp": "01:13:44", "text": "[笑声]"}, {"type": "subtitle", "time": 4425.91, "timestamp": "01:13:45", "text": "什么？"}, {"type": "subtitle", "time": 4427.99, "timestamp": "01:13:47", "text": "我不知道这件事。"}, {"type": "subtitle", "time": 4437.15, "timestamp": "01:13:57", "text": "我的天哪，我刚刚在推特上看到了这个。"}]
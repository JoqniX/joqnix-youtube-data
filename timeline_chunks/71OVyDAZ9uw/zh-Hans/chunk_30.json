[{"type": "subtitle", "time": 1801.87, "timestamp": "00:30:01", "text": "我的天啊。 对不起，我说了脏话。 兄弟。"}, {"type": "subtitle", "time": 1809.13, "timestamp": "00:30:09", "text": "兄弟。 [笑声]"}, {"type": "subtitle", "time": 1814.39, "timestamp": "00:30:14", "text": "兄弟。"}, {"type": "subtitle", "time": 1816.23, "timestamp": "00:30:16", "text": "哦，等等。 我忘了。 我忘了。 哦，"}, {"type": "subtitle", "time": 1817.87, "timestamp": "00:30:17", "text": "糟了。 我忘了。 现在是凌晨"}, {"type": "subtitle", "time": 1820.19, "timestamp": "00:30:20", "text": "2点，我不应该尖叫"}, {"type": "subtitle", "time": 1823.59, "timestamp": "00:30:23", "text": "。 拉屎。 我不在家。 我不在"}, {"type": "subtitle", "time": 1826.99, "timestamp": "00:30:26", "text": "印度，也不在我自己的房子里。 我"}, {"type": "subtitle", "time": 1830.79, "timestamp": "00:30:30", "text": "在日本。 我有室友。 我"}, {"type": "subtitle", "time": 1832.15, "timestamp": "00:30:32", "text": "是说，"}, {"type": "subtitle", "time": 1834.39, "timestamp": "00:30:34", "text": "邻居们。 于是，我的室友去"}, {"type": "subtitle", "time": 1837.15, "timestamp": "00:30:37", "text": "上班了。 他上夜班。 所以，"}, {"type": "subtitle", "time": 1838.63, "timestamp": "00:30:38", "text": "星期三、星期四"}, {"type": "subtitle", "time": 1841.11, "timestamp": "00:30:41", "text": "、星期五，他要去"}, {"type": "subtitle", "time": 1844.07, "timestamp": "00:30:44", "text": "上班，所以我可以……嗯，"}, {"type": "subtitle", "time": 1846.59, "timestamp": "00:30:46", "text": "如果我想的话，可以进行深夜直播。"}, {"type": "subtitle", "time": 1847.39, "timestamp": "00:30:47", "text": "嗯，"}, {"type": "subtitle", "time": 1849.43, "timestamp": "00:30:49", "text": "我的意思是，"}, {"type": "subtitle", "time": 1851.59, "timestamp": "00:30:51", "text": "只要睡眠充足，能"}, {"type": "subtitle", "time": 1854.35, "timestamp": "00:30:54", "text": "按时起床，我就能做到。"}, {"type": "subtitle", "time": 1855.63, "timestamp": "00:30:55", "text": "哦，"}, {"type": "subtitle", "time": 1858.15, "timestamp": "00:30:58", "text": "天哪。 为什么？"}]
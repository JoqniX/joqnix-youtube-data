[{"type": "subtitle", "time": 2461.51, "timestamp": "00:41:01", "text": "呃，这画质也太差了吧？"}, {"type": "subtitle", "time": 2475.47, "timestamp": "00:41:15", "text": "性能质量。"}, {"type": "subtitle", "time": 2480.51, "timestamp": "00:41:20", "text": "不，他们不会。他们不能给我那种土豆"}, {"type": "subtitle", "time": 2484.27, "timestamp": "00:41:24", "text": "画质的阴影效果。 他妈的。"}, {"type": "subtitle", "time": 2486.39, "timestamp": "00:41:26", "text": "不，"}, {"type": "subtitle", "time": 2492.15, "timestamp": "00:41:32", "text": "不。只是因为我有一台不错的电脑。 我"}, {"type": "subtitle", "time": 2493.99, "timestamp": "00:41:33", "text": "没有一台好电脑。 我确定我使用的是"}, {"type": "subtitle", "time": 2502.47, "timestamp": "00:41:42", "text": "呃，真他妈的。 好的，没问题。"}]
[{"type": "subtitle", "time": 2823.67, "timestamp": "00:47:03", "text": "这是控制区。"}, {"type": "subtitle", "time": 2824.99, "timestamp": "00:47:04", "text": "每个派系都在竞争"}, {"type": "subtitle", "time": 2825.31, "timestamp": "00:47:05", "text": "。"}, {"type": "subtitle", "time": 2827.07, "timestamp": "00:47:07", "text": "守住这个区域。"}, {"type": "subtitle", "time": 2831.07, "timestamp": "00:47:11", "text": "当得分计时器结束时，场内玩家人数最多的阵营"}, {"type": "subtitle", "time": 2833.51, "timestamp": "00:47:13", "text": "得一分。 率先达到"}, {"type": "subtitle", "time": 2837.75, "timestamp": "00:47:17", "text": "100分的队伍赢得比赛。"}, {"type": "subtitle", "time": 2839.39, "timestamp": "00:47:19", "text": "待在控制区内。"}, {"type": "subtitle", "time": 2840.79, "timestamp": "00:47:20", "text": "要知道，你在这里的参与会"}, {"type": "subtitle", "time": 2842.67, "timestamp": "00:47:22", "text": "为你所在团队的得分做出贡献（显示在"}, {"type": "subtitle", "time": 2844.43, "timestamp": "00:47:24", "text": "屏幕左下角），并且"}, {"type": "subtitle", "time": 2846.67, "timestamp": "00:47:26", "text": "你也会因此获得报酬（显示在"}, {"type": "subtitle", "time": 2854.55, "timestamp": "00:47:34", "text": "嗯。"}, {"type": "subtitle", "time": 2856.31, "timestamp": "00:47:36", "text": "何时开始工作？"}, {"type": "subtitle", "time": 2859.51, "timestamp": "00:47:39", "text": "呃，我得走了，我"}, {"type": "subtitle", "time": 2868.91, "timestamp": "00:47:48", "text": "无论如何，都要在 8:30 之前到达。 所以"}, {"type": "subtitle", "time": 2870.47, "timestamp": "00:47:50", "text": "我打算在"}, {"type": "subtitle", "time": 2872.55, "timestamp": "00:47:52", "text": "6:30"}, {"type": "subtitle", "time": 2874.27, "timestamp": "00:47:54", "text": "或 7:00 左右结束直播。"}, {"type": "subtitle", "time": 2876.19, "timestamp": "00:47:56", "text": "30."}, {"type": "subtitle", "time": 2878.39, "timestamp": "00:47:58", "text": "是的，7:30 不错。 我可以洗个澡，然后就……"}]
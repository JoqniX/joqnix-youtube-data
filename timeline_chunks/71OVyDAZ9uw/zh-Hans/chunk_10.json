[{"type": "subtitle", "time": 600.99, "timestamp": "00:10:00", "text": "所以，从现在起两点到凌晨两点半，我们将播放《野狗》这首歌"}, {"type": "subtitle", "time": 609.11, "timestamp": "00:10:09", "text": "。 所以，3:30 4:30 5:30"}, {"type": "subtitle", "time": 611.95, "timestamp": "00:10:11", "text": "6:30。  4个小时，可以吗？ 最多4个小时，"}, {"type": "subtitle", "time": 613.27, "timestamp": "00:10:13", "text": "好吗？"}, {"type": "subtitle", "time": 615.99, "timestamp": "00:10:15", "text": "然后，我得赶紧洗漱一下"}, {"type": "subtitle", "time": 618.33, "timestamp": "00:10:18", "text": "，准备上班等等。"}, {"type": "subtitle", "time": 622.71, "timestamp": "00:10:22", "text": "[音乐] 然后，我们就回家了。"}, {"type": "subtitle", "time": 624.212, "timestamp": "00:10:24", "text": "锁定目标。"}, {"type": "subtitle", "time": 624.67, "timestamp": "00:10:24", "text": "[笑声]"}, {"type": "subtitle", "time": 626.71, "timestamp": "00:10:26", "text": "我们要锁定目标。"}, {"type": "subtitle", "time": 638.11, "timestamp": "00:10:38", "text": "。 让我切换到游戏模式。"}, {"type": "subtitle", "time": 640.23, "timestamp": "00:10:40", "text": "给我一分钟时间。"}, {"type": "subtitle", "time": 643.15, "timestamp": "00:10:43", "text": "把你压扁，我叹了口气。 如你"}, {"type": "subtitle", "time": 645.15, "timestamp": "00:10:45", "text": "所见，游戏开始了。"}, {"type": "subtitle", "time": 647.07, "timestamp": "00:10:47", "text": "最后。"}, {"type": "subtitle", "time": 649.23, "timestamp": "00:10:49", "text": "游戏开始了。 启用当前功能 10。正在登录"}, {"type": "subtitle", "time": 651.722, "timestamp": "00:10:51", "text": "。开始吧。"}, {"type": "subtitle", "time": 653.07, "timestamp": "00:10:53", "text": "[笑声]"}]
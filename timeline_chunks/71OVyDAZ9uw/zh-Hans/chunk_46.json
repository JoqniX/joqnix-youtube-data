[{"type": "subtitle", "time": 2760.191, "timestamp": "00:46:00", "text": "[呻吟声]"}, {"type": "subtitle", "time": 2760.95, "timestamp": "00:46:00", "text": "[尖叫声]"}, {"type": "subtitle", "time": 2763.59, "timestamp": "00:46:03", "text": "你死了。"}, {"type": "subtitle", "time": 2764.91, "timestamp": "00:46:04", "text": "或者你也可以直接用手把"}, {"type": "subtitle", "time": 2767.27, "timestamp": "00:46:07", "text": "他救活。 使用合适的医疗"}, {"type": "subtitle", "time": 2771.03, "timestamp": "00:46:11", "text": "设备可以大大加快治疗过程。"}, {"type": "subtitle", "time": 2772.59, "timestamp": "00:46:12", "text": "从供应商的商品区拿一个复苏器，"}, {"type": "subtitle", "time": 2774.95, "timestamp": "00:46:14", "text": "自己看看吧。"}, {"type": "subtitle", "time": 2784.63, "timestamp": "00:46:24", "text": "现在，先把那家伙从危险区域拖走，"}, {"type": "subtitle", "time": 2793.59, "timestamp": "00:46:33", "text": "你要去我家"}, {"type": "subtitle", "time": 2796.35, "timestamp": "00:46:36", "text": "地下室。"}, {"type": "subtitle", "time": 2809.43, "timestamp": "00:46:49", "text": "嗨。   我们"}, {"type": "subtitle", "time": 2818.23, "timestamp": "00:46:58", "text": "站在地板上那个白色的大圆圈里"}]
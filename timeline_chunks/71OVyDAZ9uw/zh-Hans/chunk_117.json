[{"type": "subtitle", "time": 7021.016, "timestamp": "01:57:01", "text": "Battle for six》这部剧变得相当滑稽。"}, {"type": "subtitle", "time": 7025.71, "timestamp": "01:57:05", "text": "等等，《六人大战》现在"}, {"type": "subtitle", "time": 7028.71, "timestamp": "01:57:08", "text": "五折？ 等等，什么？"}, {"type": "subtitle", "time": 7030.43, "timestamp": "01:57:10", "text": "等等，不会吧。"}, {"type": "subtitle", "time": 7032.15, "timestamp": "01:57:12", "text": "等等，真的吗？"}, {"type": "subtitle", "time": 7038.27, "timestamp": "01:57:18", "text": "等等，如果《六人混战》五折优惠，那"}, {"type": "subtitle", "time": 7040.75, "timestamp": "01:57:20", "text": "我应该买它。"}, {"type": "subtitle", "time": 7044.47, "timestamp": "01:57:24", "text": "兄弟，现在五折！"}, {"type": "subtitle", "time": 7047.15, "timestamp": "01:57:27", "text": "决不。"}, {"type": "subtitle", "time": 7049.35, "timestamp": "01:57:29", "text": "五折优惠。"}, {"type": "subtitle", "time": 7052.67, "timestamp": "01:57:32", "text": "绝对不可能五折。"}, {"type": "subtitle", "time": 7056.39, "timestamp": "01:57:36", "text": "兄弟，好吧，我买了。"}, {"type": "subtitle", "time": 7058.63, "timestamp": "01:57:38", "text": "但我没钱。"}, {"type": "subtitle", "time": 7060.971, "timestamp": "01:57:40", "text": "帮助。"}]
[{"type": "subtitle", "time": 8041.79, "timestamp": "02:14:01", "text": "我当时就想，你知道吗，我当时就想，我"}, {"type": "subtitle", "time": 8047.63, "timestamp": "02:14:07", "text": "今天至少要赚到10万美元。"}, {"type": "subtitle", "time": 8051.71, "timestamp": "02:14:11", "text": "赚够钱就能解锁AK系列武器，"}, {"type": "subtitle", "time": 8057.23, "timestamp": "02:14:17", "text": "还有一些其他的东西。"}, {"type": "subtitle", "time": 8059.79, "timestamp": "02:14:19", "text": "这就是我的计划。"}, {"type": "subtitle", "time": 8064.95, "timestamp": "02:14:24", "text": "我当时想，“我要做这个，我"}, {"type": "subtitle", "time": 8066.63, "timestamp": "02:14:26", "text": "要做那个，我要做这个，还要做"}, {"type": "subtitle", "time": 8067.83, "timestamp": "02:14:27", "text": "那个。等等等等"}, {"type": "subtitle", "time": 8077.59, "timestamp": "02:14:37", "text": "最后，我被困在了这片"}, {"type": "subtitle", "time": 8079.95, "timestamp": "02:14:39", "text": "虚空中。"}]
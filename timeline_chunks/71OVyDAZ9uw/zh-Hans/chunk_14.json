[{"type": "subtitle", "time": 843.87, "timestamp": "00:14:03", "text": "我一直都在等 Kick 支持印度地区的盈利功能。"}, {"type": "subtitle", "time": 851.47, "timestamp": "00:14:11", "text": "当然，我也可以采取其他方法，"}, {"type": "subtitle", "time": 853.63, "timestamp": "00:14:13", "text": "但"}, {"type": "subtitle", "time": 856.71, "timestamp": "00:14:16", "text": "我想等到 Kick 支持"}, {"type": "subtitle", "time": 859.71, "timestamp": "00:14:19", "text": "印度地区的盈利功能，"}, {"type": "subtitle", "time": 862.75, "timestamp": "00:14:22", "text": "因为很长一段时间以来，Kick 都没有"}, {"type": "subtitle", "time": 865.67, "timestamp": "00:14:25", "text": "这个功能。"}, {"type": "subtitle", "time": 868.43, "timestamp": "00:14:28", "text": "也就是说，该国家/地区在注册流程中不可用"}, {"type": "subtitle", "time": 872.11, "timestamp": "00:14:32", "text": "。"}, {"type": "subtitle", "time": 875.31, "timestamp": "00:14:35", "text": "终于实现了。 我太高兴了。"}, {"type": "subtitle", "time": 877.39, "timestamp": "00:14:37", "text": "我真的非常非常高兴。"}, {"type": "subtitle", "time": 880.51, "timestamp": "00:14:40", "text": "我终于可以启用盈利功能了，"}, {"type": "subtitle", "time": 884.15, "timestamp": "00:14:44", "text": "所以"}, {"type": "subtitle", "time": 886.99, "timestamp": "00:14:46", "text": "你们可以给我送礼物了。 你可以送我"}, {"type": "subtitle", "time": 888.75, "timestamp": "00:14:48", "text": "礼物，但不能送礼物。"}, {"type": "subtitle", "time": 892.11, "timestamp": "00:14:52", "text": "对，礼物。 他们称之为踢腿。 你可以"}, {"type": "subtitle", "time": 894.71, "timestamp": "00:14:54", "text": "通过 Kick 给我发送 Kicks，"}, {"type": "subtitle", "time": 897.67, "timestamp": "00:14:57", "text": "订阅服务也"}]
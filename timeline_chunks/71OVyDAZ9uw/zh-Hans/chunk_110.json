[{"type": "subtitle", "time": 6600.39, "timestamp": "01:50:00", "text": "一。"}, {"type": "subtitle", "time": 6602.63, "timestamp": "01:50:02", "text": "最后一个，我们可以直接把它送到"}, {"type": "subtitle", "time": 6613.71, "timestamp": "01:50:13", "text": "想象一下如果它打到我身上会怎样。"}, {"type": "subtitle", "time": 6632.35, "timestamp": "01:50:32", "text": "我把那支箭送入太空了吗？"}, {"type": "subtitle", "time": 6638.91, "timestamp": "01:50:38", "text": "好的，我们会把箭收回去。"}, {"type": "subtitle", "time": 6647.59, "timestamp": "01:50:47", "text": "等一下。"}, {"type": "subtitle", "time": 6651.47, "timestamp": "01:50:51", "text": "我在这棵树上放出了大约 50 到 80 只蜜蜂"}, {"type": "subtitle", "time": 6656.15, "timestamp": "01:50:56", "text": "。 我只收到了27条回复。 什么？"}]
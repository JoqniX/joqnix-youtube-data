[{"type": "subtitle", "time": 1381.15, "timestamp": "00:23:01", "text": "是啊，我"}, {"type": "subtitle", "time": 1382.59, "timestamp": "00:23:02", "text": "只睡了一会儿。"}, {"type": "subtitle", "time": 1383.99, "timestamp": "00:23:03", "text": "嗯，"}, {"type": "subtitle", "time": 1386.35, "timestamp": "00:23:06", "text": "我今天有工作和课。 今天是"}, {"type": "subtitle", "time": 1388.55, "timestamp": "00:23:08", "text": "星期五，是工作日。"}, {"type": "subtitle", "time": 1390.99, "timestamp": "00:23:10", "text": "是的，如果像上次那样，在周六清晨进行，我就可以做到了"}, {"type": "subtitle", "time": 1398.15, "timestamp": "00:23:18", "text": "。"}, {"type": "subtitle", "time": 1401.15, "timestamp": "00:23:21", "text": "上周六也是同样的情况，对吧？"}, {"type": "subtitle", "time": 1403.51, "timestamp": "00:23:23", "text": "我想，呃，我那天"}, {"type": "subtitle", "time": 1407.27, "timestamp": "00:23:27", "text": "起得很早，呃，或者星期天什么的，大概是这样"}, {"type": "subtitle", "time": 1409.83, "timestamp": "00:23:29", "text": "。 我一大早就起来等着玩《"}, {"type": "subtitle", "time": 1414.15, "timestamp": "00:23:34", "text": "看门狗》那会儿。"}, {"type": "subtitle", "time": 1421.51, "timestamp": "00:23:41", "text": "如果我知道这一点，我就可以请"}, {"type": "subtitle", "time": 1424.43, "timestamp": "00:23:44", "text": "几天假什么的，"}, {"type": "subtitle", "time": 1428.07, "timestamp": "00:23:48", "text": "找个借口说我生病了。"}, {"type": "subtitle", "time": 1430.55, "timestamp": "00:23:50", "text": "我周一"}, {"type": "subtitle", "time": 1433.03, "timestamp": "00:23:53", "text": "或者哪天可以过来吗？"}, {"type": "subtitle", "time": 1435.79, "timestamp": "00:23:55", "text": "但是，不，呃，但是不不，这周不行。 我的"}, {"type": "subtitle", "time": 1439.23, "timestamp": "00:23:59", "text": "第二份兼职工作，我犯了个错误。"}]
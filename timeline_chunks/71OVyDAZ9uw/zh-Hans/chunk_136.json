[{"type": "subtitle", "time": 8165.75, "timestamp": "02:16:05", "text": "，"}, {"type": "subtitle", "time": 8167.79, "timestamp": "02:16:07", "text": "我该睡觉了吗？"}, {"type": "subtitle", "time": 8169.47, "timestamp": "02:16:09", "text": "她真的都这样了吗？"}, {"type": "subtitle", "time": 8174.71, "timestamp": "02:16:14", "text": "我应该去睡觉吗？ 我不……我不……"}, {"type": "subtitle", "time": 8191.63, "timestamp": "02:16:31", "text": "有时候我需要明白，"}, {"type": "subtitle", "time": 8195.709, "timestamp": "02:16:35", "text": "我不应该总是依赖游戏来"}, {"type": "subtitle", "time": 8198.35, "timestamp": "02:16:38", "text": "进行直播。 有时我也不"}, {"type": "subtitle", "time": 8199.95, "timestamp": "02:16:39", "text": "知道为什么。"}, {"type": "subtitle", "time": 8202.31, "timestamp": "02:16:42", "text": "我感觉最近好像只做"}, {"type": "subtitle", "time": 8204.709, "timestamp": "02:16:44", "text": "游戏直播了。"}, {"type": "subtitle", "time": 8207.47, "timestamp": "02:16:47", "text": "我最近没做什么事。"}, {"type": "subtitle", "time": 8210.03, "timestamp": "02:16:50", "text": "而"}, {"type": "subtitle", "time": 8212.27, "timestamp": "02:16:52", "text": "我竟然要招待你，这真是太糟糕了"}]
[{"type": "subtitle", "time": 2166.67, "timestamp": "00:36:06", "text": "哦，下一个。"}, {"type": "subtitle", "time": 2167.67, "timestamp": "00:36:07", "text": "踢。"}, {"type": "subtitle", "time": 2169.51, "timestamp": "00:36:09", "text": "那是巧克力。"}, {"type": "subtitle", "time": 2174.55, "timestamp": "00:36:14", "text": "你知道，我"}, {"type": "subtitle", "time": 2176.75, "timestamp": "00:36:16", "text": "现在为这款游戏构思了很多很多想法，接下来我要"}, {"type": "subtitle", "time": 2178.35, "timestamp": "00:36:18", "text": "直播这款"}, {"type": "subtitle", "time": 2181.59, "timestamp": "00:36:21", "text": "游戏。 嗯，很多。"}, {"type": "subtitle", "time": 2184.11, "timestamp": "00:36:24", "text": "我不知道为什么，这是我第一次玩军事"}, {"type": "subtitle", "time": 2188.31, "timestamp": "00:36:28", "text": "模拟类游戏，但"}, {"type": "subtitle", "time": 2190.03, "timestamp": "00:36:30", "text": "我觉得，"}, {"type": "subtitle", "time": 2197.39, "timestamp": "00:36:37", "text": "我在玩 Arc Raiders 的时候也遇到过同样的问题"}, {"type": "subtitle", "time": 2199.11, "timestamp": "00:36:39", "text": "。"}, {"type": "subtitle", "time": 2201.71, "timestamp": "00:36:41", "text": "我知道我是在大概一个月后，也就是三个月后，买了这款游戏"}, {"type": "subtitle", "time": 2205.11, "timestamp": "00:36:45", "text": "。"}, {"type": "subtitle", "time": 2207.47, "timestamp": "00:36:47", "text": "我跳了进去。哦，我知道了。"}, {"type": "subtitle", "time": 2209.51, "timestamp": "00:36:49", "text": "哦，等等。"}, {"type": "subtitle", "time": 2211.95, "timestamp": "00:36:51", "text": "不，不。 别去，"}, {"type": "subtitle", "time": 2213.95, "timestamp": "00:36:53", "text": "别去戏弄我。"}, {"type": "subtitle", "time": 2215.79, "timestamp": "00:36:55", "text": "我知道怎么玩这个游戏。"}]
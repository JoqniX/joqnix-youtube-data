[{"type": "subtitle", "time": 1500.23, "timestamp": "00:25:00", "text": "呃，因为我这周没能及时发送，"}, {"type": "subtitle", "time": 1502.87, "timestamp": "00:25:02", "text": "嗯，我的"}, {"type": "subtitle", "time": 1505.87, "timestamp": "00:25:05", "text": "第二份兼职工作没有安排，但我是"}, {"type": "subtitle", "time": 1510.35, "timestamp": "00:25:10", "text": "一家日"}, {"type": "subtitle", "time": 1512.23, "timestamp": "00:25:12", "text": "式餐厅的领班之类的，所以我得做些"}, {"type": "subtitle", "time": 1514.11, "timestamp": "00:25:14", "text": "服务之类的工作，"}, {"type": "subtitle", "time": 1516.35, "timestamp": "00:25:16", "text": "呃，是的，我负责"}, {"type": "subtitle", "time": 1519.55, "timestamp": "00:25:19", "text": "上菜什么的。"}, {"type": "subtitle", "time": 1522.07, "timestamp": "00:25:22", "text": "我必须读出这些美味的日本克里斯汀相关物品的难读的汉字"}, {"type": "subtitle", "time": 1526.11, "timestamp": "00:25:26", "text": "名称，呃，难读的日语名称"}, {"type": "subtitle", "time": 1531.95, "timestamp": "00:25:31", "text": "，但是，是的。"}, {"type": "subtitle", "time": 1532.83, "timestamp": "00:25:32", "text": "嗯嗯，"}, {"type": "subtitle", "time": 1534.43, "timestamp": "00:25:34", "text": "所以，是的，从下周开始，我"}, {"type": "subtitle", "time": 1536.59, "timestamp": "00:25:36", "text": "觉得我不能像以前那样在周五之类的日子里这样做了"}, {"type": "subtitle", "time": 1539.83, "timestamp": "00:25:39", "text": "。 我会很晚才回家。"}, {"type": "subtitle", "time": 1545.99, "timestamp": "00:25:45", "text": "比如上午 10 点到晚上 10 点。 晚上11点"}, {"type": "subtitle", "time": 1549.27, "timestamp": "00:25:49", "text": "工作通常在晚上9点结束，有时到10点。"}, {"type": "subtitle", "time": 1550.27, "timestamp": "00:25:50", "text": "嗯，还在等着呢"}, {"type": "subtitle", "time": 1553.03, "timestamp": "00:25:53", "text": "。"}, {"type": "subtitle", "time": 1555.31, "timestamp": "00:25:55", "text": "所以，周五我得回家"}, {"type": "subtitle", "time": 1558.39, "timestamp": "00:25:58", "text": "，坐火车回家，吃点东西，"}]
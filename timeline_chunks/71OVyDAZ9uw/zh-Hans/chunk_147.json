[{"type": "subtitle", "time": 8821.03, "timestamp": "02:27:01", "text": "穿过走廊开始你的……"}, {"type": "subtitle", "time": 8831.67, "timestamp": "02:27:11", "text": "那位先生是一位设备供应商。"}, {"type": "subtitle", "time": 8833.27, "timestamp": "02:27:13", "text": "你会发现这些人站在"}, {"type": "subtitle", "time": 8835.43, "timestamp": "02:27:15", "text": "后巷对面的武器海报旁边。"}, {"type": "subtitle", "time": 8837.15, "timestamp": "02:27:17", "text": "我得先到隔壁房间，然后才能"}, {"type": "subtitle", "time": 8839.79, "timestamp": "02:27:19", "text": "从他那儿弄到一些弹药。"}, {"type": "subtitle", "time": 8841.19, "timestamp": "02:27:21", "text": "我们开始吧。   我的"}, {"type": "subtitle", "time": 8852.47, "timestamp": "02:27:32", "text": "我知道你以前做过这件事，但我"}, {"type": "subtitle", "time": 8854.55, "timestamp": "02:27:34", "text": "需要亲眼看看，所以"}, {"type": "subtitle", "time": 8867.63, "timestamp": "02:27:47", "text": "好时，就开火。显然，有了合适的装备，"}, {"type": "subtitle", "time": 8869.11, "timestamp": "02:27:49", "text": "子弹可以轻易穿透较弱的"}, {"type": "subtitle", "time": 8872.35, "timestamp": "02:27:52", "text": "材料，例如玻璃、木头和布料"}, {"type": "subtitle", "time": 8873.39, "timestamp": "02:27:53", "text": "。"}, {"type": "subtitle", "time": 8875.47, "timestamp": "02:27:55", "text": "隔着木头击中目标。   你"}]
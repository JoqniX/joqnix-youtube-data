[{"type": "subtitle", "time": 1861.59, "timestamp": "00:31:01", "text": "加州上线了。 为什么？"}, {"type": "subtitle", "time": 1862.841, "timestamp": "00:31:02", "text": "为什么？ [笑声]"}, {"type": "subtitle", "time": 1870.71, "timestamp": "00:31:10", "text": "你为什么打电话给他们，然后说：“是啊，"}, {"type": "subtitle", "time": 1872.67, "timestamp": "00:31:12", "text": "再把大门关上。”"}, {"type": "subtitle", "time": 1875.79, "timestamp": "00:31:15", "text": "你必须让更多的人进来，但他们也"}, {"type": "subtitle", "time": 1878.43, "timestamp": "00:31:18", "text": "得再等更久。   重新排队"}, {"type": "subtitle", "time": 1880.516, "timestamp": "00:31:20", "text": "。"}, {"type": "subtitle", "time": 1906.03, "timestamp": "00:31:46", "text": "，是的，我真的非常期待这场比赛"}, {"type": "subtitle", "time": 1914.15, "timestamp": "00:31:54", "text": "是的，我需要关联我的账户，"}, {"type": "subtitle", "time": 1916.67, "timestamp": "00:31:56", "text": "对吧？"}, {"type": "subtitle", "time": 1918.79, "timestamp": "00:31:58", "text": "去睡觉吧，Jaxa。   那"}]
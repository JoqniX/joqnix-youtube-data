[{"type": "subtitle", "time": 9542.43, "timestamp": "02:39:02", "text": "嗯，差不多就是这样了，米娜。 再次感谢您"}, {"type": "subtitle", "time": 9544.35, "timestamp": "02:39:04", "text": "今天的帮助。   祝你一切"}, {"type": "subtitle", "time": 9546.47, "timestamp": "02:39:06", "text": "顺利。"}, {"type": "subtitle", "time": 9548.55, "timestamp": "02:39:08", "text": "我会……"}, {"type": "subtitle", "time": 9551.35, "timestamp": "02:39:11", "text": "你管它叫什么？"}, {"type": "subtitle", "time": 9554.23, "timestamp": "02:39:14", "text": "我得去"}, {"type": "subtitle", "time": 9557.07, "timestamp": "02:39:17", "text": "睡觉了，我想小睡一会儿，"}, {"type": "subtitle", "time": 9559.23, "timestamp": "02:39:19", "text": "大概一个小时，然后就"}, {"type": "subtitle", "time": 9561.47, "timestamp": "02:39:21", "text": "起来。"}, {"type": "subtitle", "time": 9563.79, "timestamp": "02:39:23", "text": "不过，再次感谢大家"}, {"type": "subtitle", "time": 9569.47, "timestamp": "02:39:29", "text": "今天到场的各位，"}, {"type": "subtitle", "time": 9572.23, "timestamp": "02:39:32", "text": "让我念一下你们的名字。 艾丽西亚，"}, {"type": "subtitle", "time": 9574.51, "timestamp": "02:39:34", "text": "谢谢你的光临。 卡莉，谢谢你的"}, {"type": "subtitle", "time": 9576.63, "timestamp": "02:39:36", "text": "光临。"}, {"type": "subtitle", "time": 9580.07, "timestamp": "02:39:40", "text": "呃，我是亚伦。 是亚伦。 谢谢"}, {"type": "subtitle", "time": 9581.95, "timestamp": "02:39:41", "text": "光临。"}, {"type": "subtitle", "time": 9585.59, "timestamp": "02:39:45", "text": "然后，在 Kick 上，我们收到了 John"}, {"type": "subtitle", "time": 9587.07, "timestamp": "02:39:47", "text": "Soil 儿子的产品，"}, {"type": "subtitle", "time": 9589.11, "timestamp": "02:39:49", "text": "感谢他的到来，也感谢他的光临"}, {"type": "subtitle", "time": 9590.15, "timestamp": "02:39:50", "text": "。"}, {"type": "subtitle", "time": 9592.43, "timestamp": "02:39:52", "text": "还有所有在"}, {"type": "subtitle", "time": 9595.59, "timestamp": "02:39:55", "text": "YouTube、Twitch、Kick、Rumble、"}, {"type": "subtitle", "time": 9597.43, "timestamp": "02:39:57", "text": "Twitter"}]
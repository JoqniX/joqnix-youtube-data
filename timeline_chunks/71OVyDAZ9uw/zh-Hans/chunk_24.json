[{"type": "subtitle", "time": 1442.63, "timestamp": "00:24:02", "text": "嗯，我最近开始了"}, {"type": "subtitle", "time": 1445.95, "timestamp": "00:24:05", "text": "我的第二份兼职工作，所以我的班次，呃，"}, {"type": "subtitle", "time": 1448.43, "timestamp": "00:24:08", "text": "我必须在应用程序中登记我的班次"}, {"type": "subtitle", "time": 1450.91, "timestamp": "00:24:10", "text": "。"}, {"type": "subtitle", "time": 1452.95, "timestamp": "00:24:12", "text": "呃，我不知道怎么用这个应用，"}, {"type": "subtitle", "time": 1454.79, "timestamp": "00:24:14", "text": "所以它显然没有和"}, {"type": "subtitle", "time": 1456.27, "timestamp": "00:24:16", "text": "公司关联。"}, {"type": "subtitle", "time": 1457.51, "timestamp": "00:24:17", "text": "所以，"}, {"type": "subtitle", "time": 1460.39, "timestamp": "00:24:20", "text": "呃，我上周发送的那些东西不是……不，"}, {"type": "subtitle", "time": 1463.59, "timestamp": "00:24:23", "text": "上周我刚开始的时候就发送了……"}, {"type": "subtitle", "time": 1465.99, "timestamp": "00:24:25", "text": "是的，我想我周一发送了"}, {"type": "subtitle", "time": 1468.83, "timestamp": "00:24:28", "text": "这周的申请，但是它没有被"}, {"type": "subtitle", "time": 1471.23, "timestamp": "00:24:31", "text": "批准，"}, {"type": "subtitle", "time": 1472.39, "timestamp": "00:24:32", "text": "呃，"}, {"type": "subtitle", "time": 1477.19, "timestamp": "00:24:37", "text": "公司没有收到，所以我不得不重新和他们一起完成"}, {"type": "subtitle", "time": 1479.75, "timestamp": "00:24:39", "text": "应用程序的关联流程"}, {"type": "subtitle", "time": 1480.91, "timestamp": "00:24:40", "text": "。"}, {"type": "subtitle", "time": 1484.27, "timestamp": "00:24:44", "text": "最后，它们之间存在联系。 所以，这周，"}, {"type": "subtitle", "time": 1486.75, "timestamp": "00:24:46", "text": "因为我没有在周三之前提前发送"}, {"type": "subtitle", "time": 1489.43, "timestamp": "00:24:49", "text": "，所以需要调整一下工作安排，比如我想在哪几天"}, {"type": "subtitle", "time": 1491.95, "timestamp": "00:24:51", "text": "工作，我的工作时间是什么，"}, {"type": "subtitle", "time": 1493.95, "timestamp": "00:24:53", "text": "比如我每天可以工作几个小时"}, {"type": "subtitle", "time": 1496.63, "timestamp": "00:24:56", "text": "等等。"}, {"type": "subtitle", "time": 1497.43, "timestamp": "00:24:57", "text": "所以，"}]
[{"type": "subtitle", "time": 1500.23, "timestamp": "00:25:00", "text": "えーと、今週は"}, {"type": "subtitle", "time": 1502.87, "timestamp": "00:25:02", "text": "仕事がなくて間に合わなかったので、2つ目のアルバイトの仕事はないんですが、レストラン、"}, {"type": "subtitle", "time": 1512.23, "timestamp": "00:25:12", "text": "日本食レストランでホールマスターか何かをやっていて、"}, {"type": "subtitle", "time": 1514.11, "timestamp": "00:25:14", "text": "料理を"}, {"type": "subtitle", "time": 1516.35, "timestamp": "00:25:16", "text": "出したり、その他いろいろやらなきゃいけないんです"}, {"type": "subtitle", "time": 1519.55, "timestamp": "00:25:19", "text": "。"}, {"type": "subtitle", "time": 1522.07, "timestamp": "00:25:22", "text": "私はこれらの美味しい日本のクリスティーンの難しい漢字の"}, {"type": "subtitle", "time": 1526.11, "timestamp": "00:25:26", "text": "名前、つまり難しい日本語の名前を読み上げなければなりませんが、"}, {"type": "subtitle", "time": 1531.95, "timestamp": "00:25:31", "text": "ええ。   ええと"}, {"type": "subtitle", "time": 1534.43, "timestamp": "00:25:34", "text": "、そうですね、来週以降は"}, {"type": "subtitle", "time": 1536.59, "timestamp": "00:25:36", "text": "金曜日とかそういうのは無理だと思います"}, {"type": "subtitle", "time": 1539.83, "timestamp": "00:25:39", "text": "。 帰宅がすごく遅くなります。"}, {"type": "subtitle", "time": 1545.99, "timestamp": "00:25:45", "text": "例えば、午前10時、午後10時など。 午後11時"}, {"type": "subtitle", "time": 1549.27, "timestamp": "00:25:49", "text": "仕事は9時までに終わり、時には10時まで続くこともあります。"}, {"type": "subtitle", "time": 1550.27, "timestamp": "00:25:50", "text": "えっと、ちょっと待ってください"}, {"type": "subtitle", "time": 1553.03, "timestamp": "00:25:53", "text": "。"}, {"type": "subtitle", "time": 1555.31, "timestamp": "00:25:55", "text": "だから、金曜日はあまり疲れていなければ、家に帰って電車に乗って"}, {"type": "subtitle", "time": 1558.39, "timestamp": "00:25:58", "text": "、家に帰って何か食べて、"}]
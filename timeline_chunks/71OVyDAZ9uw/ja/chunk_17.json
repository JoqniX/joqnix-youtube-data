[{"type": "subtitle", "time": 1022.63, "timestamp": "00:17:02", "text": "Multimelt からのストリームを自動的に開始および停止する方法を見つけました。 それは、"}, {"type": "subtitle", "time": 1029.75, "timestamp": "00:17:09", "text": "Sammyにコマンドかボタンのようなものを作って、24時間"}, {"type": "subtitle", "time": 1033.55, "timestamp": "00:17:13", "text": "365日チャンネル関連のことに使えるようにするようなものだった。"}, {"type": "subtitle", "time": 1039.99, "timestamp": "00:17:19", "text": "24時間365日配信チャンネルで唯一問題になっているのは、うまく機能していて"}, {"type": "subtitle", "time": 1043.15, "timestamp": "00:17:23", "text": "完璧で、すべて順調なのですが、"}, {"type": "subtitle", "time": 1048.75, "timestamp": "00:17:28", "text": "Twitch の配信停止機能が"}, {"type": "subtitle", "time": 1051.99, "timestamp": "00:17:31", "text": "48 時間ごとに自動的に停止してしまうことです。これは、"}, {"type": "subtitle", "time": 1057.03, "timestamp": "00:17:37", "text": "Twitch プラットフォームの最大配信制限によるものです。   ええ"}, {"type": "subtitle", "time": 1067.03, "timestamp": "00:17:47", "text": "Twitchの配信を検出できるようにしました。"}, {"type": "subtitle", "time": 1068.91, "timestamp": "00:17:48", "text": "2つのストリームが"}, {"type": "subtitle", "time": 1071.55, "timestamp": "00:17:51", "text": "停止している、または停止した状態にあることを検知した場合、自動的に再開します"}, {"type": "subtitle", "time": 1073.83, "timestamp": "00:17:53", "text": "。 私はその物を作ったので、何て"}]
[{"type": "subtitle", "time": 1381.15, "timestamp": "00:23:01", "text": "うん、ほんの少ししか"}, {"type": "subtitle", "time": 1382.59, "timestamp": "00:23:02", "text": "寝てないんだ。"}, {"type": "subtitle", "time": 1383.99, "timestamp": "00:23:03", "text": "えっと、"}, {"type": "subtitle", "time": 1386.35, "timestamp": "00:23:06", "text": "今日は仕事と授業があるんです。"}, {"type": "subtitle", "time": 1388.55, "timestamp": "00:23:08", "text": "金曜日は平日です。"}, {"type": "subtitle", "time": 1390.99, "timestamp": "00:23:10", "text": "ああ、もしこれが前回"}, {"type": "subtitle", "time": 1396.67, "timestamp": "00:23:16", "text": "やったような土曜日の早朝だったら、できたかもしれないな"}, {"type": "subtitle", "time": 1398.15, "timestamp": "00:23:18", "text": "。"}, {"type": "subtitle", "time": 1401.15, "timestamp": "00:23:21", "text": "先週の土曜日も、同じ状況でしたよね？   確か、早起きして、"}, {"type": "subtitle", "time": 1407.27, "timestamp": "00:23:27", "text": "日曜日か何かだったと思う"}, {"type": "subtitle", "time": 1409.83, "timestamp": "00:23:29", "text": "。 私は早起きして、"}, {"type": "subtitle", "time": 1414.15, "timestamp": "00:23:34", "text": "ウォッチドッグスの発売を待っていました。"}, {"type": "subtitle", "time": 1421.51, "timestamp": "00:23:41", "text": "もしこれを知っていたら、"}, {"type": "subtitle", "time": 1424.43, "timestamp": "00:23:44", "text": "少し仕事を休むとか、体調が"}, {"type": "subtitle", "time": 1428.07, "timestamp": "00:23:48", "text": "悪いとか言い訳をして休めたのに。"}, {"type": "subtitle", "time": 1430.55, "timestamp": "00:23:50", "text": "月曜日"}, {"type": "subtitle", "time": 1433.03, "timestamp": "00:23:53", "text": "か何かに出勤してもいいですか？"}, {"type": "subtitle", "time": 1435.79, "timestamp": "00:23:55", "text": "でも、いや、いやいや、今週はダメです。  2つ目の"}, {"type": "subtitle", "time": 1439.23, "timestamp": "00:23:59", "text": "アルバイトで、私は間違いを犯してしまった。   えっと、"}]
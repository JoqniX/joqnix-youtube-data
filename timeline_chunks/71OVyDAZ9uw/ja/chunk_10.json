[{"type": "subtitle", "time": 600.99, "timestamp": "00:10:00", "text": "では、今から午前2時半以降まで、ワイルド・ドッグスをプレイします"}, {"type": "subtitle", "time": 609.11, "timestamp": "00:10:09", "text": "。 ということで、3:30、4:30、5:30、6:30"}, {"type": "subtitle", "time": 611.95, "timestamp": "00:10:11", "text": "。  4時間でいいですか？ 最大4時間までで"}, {"type": "subtitle", "time": 613.27, "timestamp": "00:10:13", "text": "いいですか？"}, {"type": "subtitle", "time": 615.99, "timestamp": "00:10:15", "text": "それから、えーっと、身だしなみを整えて"}, {"type": "subtitle", "time": 618.33, "timestamp": "00:10:18", "text": "、仕事の準備をしなきゃいけなかったんです。"}, {"type": "subtitle", "time": 622.71, "timestamp": "00:10:22", "text": "[音楽] そして、私たちは家に帰ります。"}, {"type": "subtitle", "time": 624.212, "timestamp": "00:10:24", "text": "集中する。"}, {"type": "subtitle", "time": 624.67, "timestamp": "00:10:24", "text": "[笑い]"}, {"type": "subtitle", "time": 626.71, "timestamp": "00:10:26", "text": "集中するよ。"}, {"type": "subtitle", "time": 638.11, "timestamp": "00:10:38", "text": "ええ、そうですね。 ゲームに切り替えましょう。   少し時間をください"}, {"type": "subtitle", "time": 640.23, "timestamp": "00:10:40", "text": "。   君をぎゅっと"}, {"type": "subtitle", "time": 643.15, "timestamp": "00:10:43", "text": "抱きしめて、ため息をつくよ。"}, {"type": "subtitle", "time": 645.15, "timestamp": "00:10:45", "text": "ご覧のとおり、ゲームはここにあります。"}, {"type": "subtitle", "time": 647.07, "timestamp": "00:10:47", "text": "ついに。"}, {"type": "subtitle", "time": 649.23, "timestamp": "00:10:49", "text": "ゲームがここにあります。  10."}, {"type": "subtitle", "time": 651.722, "timestamp": "00:10:51", "text": "ログインします。さあ、始めましょう。"}, {"type": "subtitle", "time": 653.07, "timestamp": "00:10:53", "text": "[笑い]"}]
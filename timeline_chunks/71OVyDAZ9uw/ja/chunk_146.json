[{"type": "subtitle", "time": 8760.59, "timestamp": "02:26:00", "text": "ああ。   わかった"}, {"type": "subtitle", "time": 8761.71, "timestamp": "02:26:01", "text": "。"}, {"type": "subtitle", "time": 8764.47, "timestamp": "02:26:04", "text": "トレーニングセンターへようこそ。"}, {"type": "subtitle", "time": 8765.95, "timestamp": "02:26:05", "text": "私たちの"}, {"type": "subtitle", "time": 8767.95, "timestamp": "02:26:07", "text": "短いビデオについては、もうご存知だと思います。"}, {"type": "subtitle", "time": 8769.03, "timestamp": "02:26:09", "text": "良い。"}, {"type": "subtitle", "time": 8770.83, "timestamp": "02:26:10", "text": "プロジェクターの電源を入れ"}, {"type": "subtitle", "time": 8772.11, "timestamp": "02:26:12", "text": "、スクロールして"}, {"type": "subtitle", "time": 8773.47, "timestamp": "02:26:13", "text": "再生ボタンを押すと"}, {"type": "subtitle", "time": 8784.51, "timestamp": "02:26:24", "text": "どうぞ「サー」と呼んでください。 わかった。"}, {"type": "subtitle", "time": 8787.19, "timestamp": "02:26:27", "text": "それでは、あなたを「サー」と呼ばせていただきます。 大丈夫。"}, {"type": "subtitle", "time": 8789.59, "timestamp": "02:26:29", "text": "こんにちは。この度は"}, {"type": "subtitle", "time": 8792.59, "timestamp": "02:26:32", "text": "弊社のゲームをご購入いただき、この旅にご参加いただき、本当にありがとうございます。"}, {"type": "subtitle", "time": 8794.87, "timestamp": "02:26:34", "text": "War Dogs は早期アクセス版タイトルであり、そのため"}, {"type": "subtitle", "time": 8795.95, "timestamp": "02:26:35", "text": "進行状況はすべて正常です。"}, {"type": "subtitle", "time": 8797.23, "timestamp": "02:26:37", "text": "なぜ動作が遅いのですか?"}, {"type": "subtitle", "time": 8799.55, "timestamp": "02:26:39", "text": "能力と外見は"}, {"type": "subtitle", "time": 8801.71, "timestamp": "02:26:41", "text": "季節ごとにリセットされます。 私たちは現在、"}, {"type": "subtitle", "time": 8806.27, "timestamp": "02:26:46", "text": "より多くのコンテンツ、拡張されたメタ"}, {"type": "subtitle", "time": 8808.75, "timestamp": "02:26:48", "text": "ゲーム、そして永続的な成長システムを備えた、War Dogsの完全なビジョンを実現するために取り組んでいます。"}, {"type": "subtitle", "time": 8810.47, "timestamp": "02:26:50", "text": "そして、複数のプラットフォームでリリースする予定です"}, {"type": "subtitle", "time": 8812.55, "timestamp": "02:26:52", "text": "。 しかしそれまでは、皆さんが"}, {"type": "subtitle", "time": 8814.47, "timestamp": "02:26:54", "text": "お金を稼いだり、失ったり、そして"}, {"type": "subtitle", "time": 8817.07, "timestamp": "02:26:57", "text": "それを取り戻す瞬間を心から楽しんでいただけることを願っています。   これでようやく終わったので"}, {"type": "subtitle", "time": 8818.99, "timestamp": "02:26:58", "text": "、"}]
[{"type": "subtitle", "time": 1741.35, "timestamp": "00:29:01", "text": "えっと、今日は仕事もあるし、授業もあるし、色々あるんです"}, {"type": "subtitle", "time": 1742.63, "timestamp": "00:29:02", "text": "。"}, {"type": "subtitle", "time": 1744.91, "timestamp": "00:29:04", "text": "今日は私の仕事日です。"}, {"type": "subtitle", "time": 1747.63, "timestamp": "00:29:07", "text": "だから、私は7,000までしかプレイできません"}, {"type": "subtitle", "time": 1751.55, "timestamp": "00:29:11", "text": "。 何てことだ。 何てことだ。 何てことだ。   何てことだ"}, {"type": "subtitle", "time": 1752.75, "timestamp": "00:29:12", "text": "。"}, {"type": "subtitle", "time": 1754.67, "timestamp": "00:29:14", "text": "もうすぐ入れてくれるはずだ。 何てことだ。 さあ行こう。 さあ行こう。   さあ行こう"}, {"type": "subtitle", "time": 1756.19, "timestamp": "00:29:16", "text": "。 さあ行こう。   何てことだ"}, {"type": "subtitle", "time": 1757.55, "timestamp": "00:29:17", "text": "。 さあ行こう。 さあ行こう。 何てことだ"}, {"type": "subtitle", "time": 1759.83, "timestamp": "00:29:19", "text": "。 何てことだ。 何てことだ。"}, {"type": "subtitle", "time": 1762.19, "timestamp": "00:29:22", "text": "さあ、行こう。"}, {"type": "subtitle", "time": 1773.43, "timestamp": "00:29:33", "text": "。 ウム バババババ。 えっと、私は何をしていたんだっけ"}, {"type": "subtitle", "time": 1785.63, "timestamp": "00:29:45", "text": "。"}, {"type": "subtitle", "time": 1787.35, "timestamp": "00:29:47", "text": "彼らは列を再開した。 だから、"}, {"type": "subtitle", "time": 1789.15, "timestamp": "00:29:49", "text": "彼らはより多くの人々を入場させているのです"}, {"type": "subtitle", "time": 1791.63, "timestamp": "00:29:51", "text": "。わかりました。"}, {"type": "subtitle", "time": 1793.11, "timestamp": "00:29:53", "text": "うん、うん、うん、うん、うん。 彼らは"}, {"type": "subtitle", "time": 1795.15, "timestamp": "00:29:55", "text": "少し、くたばれと言っています"}, {"type": "subtitle", "time": 1796.35, "timestamp": "00:29:56", "text": "。   くたばれ"}, {"type": "subtitle", "time": 1797.95, "timestamp": "00:29:57", "text": "。   何てことだ"}]
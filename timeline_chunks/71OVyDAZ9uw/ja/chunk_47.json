[{"type": "subtitle", "time": 2823.67, "timestamp": "00:47:03", "text": "ここは管制区域です。"}, {"type": "subtitle", "time": 2824.99, "timestamp": "00:47:04", "text": "どの派閥も競争している"}, {"type": "subtitle", "time": 2825.31, "timestamp": "00:47:05", "text": "。"}, {"type": "subtitle", "time": 2827.07, "timestamp": "00:47:07", "text": "この区域を維持するため。   スコア"}, {"type": "subtitle", "time": 2831.07, "timestamp": "00:47:11", "text": "タイマーが終了した時点で、ゾーン内に最も多くのプレイヤーがいる陣営が"}, {"type": "subtitle", "time": 2833.51, "timestamp": "00:47:13", "text": "1ポイントを獲得する。 先に"}, {"type": "subtitle", "time": 2837.75, "timestamp": "00:47:17", "text": "100ポイントに到達したチームが試合に勝利する。"}, {"type": "subtitle", "time": 2839.39, "timestamp": "00:47:19", "text": "コントロールゾーン内に留まってください。"}, {"type": "subtitle", "time": 2840.79, "timestamp": "00:47:20", "text": "あなたがここにいることで、画面左下の"}, {"type": "subtitle", "time": 2842.67, "timestamp": "00:47:22", "text": "チームのスコアに貢献していること、"}, {"type": "subtitle", "time": 2844.43, "timestamp": "00:47:24", "text": "そして画面右上に表示されているように、それによって"}, {"type": "subtitle", "time": 2846.67, "timestamp": "00:47:26", "text": "報酬を得ていることを覚えておいてください"}, {"type": "subtitle", "time": 2854.55, "timestamp": "00:47:34", "text": "うん。"}, {"type": "subtitle", "time": 2856.31, "timestamp": "00:47:36", "text": "作業開始日はいつですか？"}, {"type": "subtitle", "time": 2859.51, "timestamp": "00:47:39", "text": "えっと、"}, {"type": "subtitle", "time": 2868.91, "timestamp": "00:47:48", "text": "前には必ず到着する。 なので、"}, {"type": "subtitle", "time": 2870.47, "timestamp": "00:47:50", "text": "配信は"}, {"type": "subtitle", "time": 2872.55, "timestamp": "00:47:52", "text": "6時半"}, {"type": "subtitle", "time": 2874.27, "timestamp": "00:47:54", "text": "か7時頃に終了しようと思っています。"}, {"type": "subtitle", "time": 2876.19, "timestamp": "00:47:56", "text": "30."}, {"type": "subtitle", "time": 2878.39, "timestamp": "00:47:58", "text": "うん、7時半でいいよ。 お風呂に入って、うん、って"}]
[{"type": "subtitle", "time": 3064.55, "timestamp": "00:51:04", "text": "これで研修は終了です。"}, {"type": "subtitle", "time": 3066.35, "timestamp": "00:51:06", "text": "敷地内から出て、"}, {"type": "subtitle", "time": 3067.75, "timestamp": "00:51:07", "text": "射撃場や車両訓練場を見学していただいても構いません"}, {"type": "subtitle", "time": 3073.35, "timestamp": "00:51:13", "text": "。"}, {"type": "subtitle", "time": 3114.11, "timestamp": "00:51:54", "text": "ハハハハ。"}, {"type": "subtitle", "time": 3116.47, "timestamp": "00:51:56", "text": "待って、強化放送をオンにしている。"}, {"type": "subtitle", "time": 3118.51, "timestamp": "00:51:58", "text": "どうやって？"}]
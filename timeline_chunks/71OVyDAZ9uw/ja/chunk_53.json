[{"type": "subtitle", "time": 3190.23, "timestamp": "00:53:10", "text": "よし。   まずは"}, {"type": "subtitle", "time": 3192.75, "timestamp": "00:53:12", "text": "ヘリコプターの操縦を習うつもりだ。"}, {"type": "subtitle", "time": 3202.51, "timestamp": "00:53:22", "text": "寝る、ジョギングする、こんにちは、仕事、"}, {"type": "subtitle", "time": 3204.95, "timestamp": "00:53:24", "text": "明日は早く仕事に行かなければならない。"}, {"type": "subtitle", "time": 3206.39, "timestamp": "00:53:26", "text": "10番、幸運を祈る、幸運を祈る、"}, {"type": "subtitle", "time": 3208.19, "timestamp": "00:53:28", "text": "幸運を祈る。   ここまで来てくださって"}, {"type": "subtitle", "time": 3211.43, "timestamp": "00:53:31", "text": "ありがとうございます。"}, {"type": "subtitle", "time": 3228.71, "timestamp": "00:53:48", "text": "私はそれを望んでいません。 良さそうですね。"}, {"type": "subtitle", "time": 3233.27, "timestamp": "00:53:53", "text": "おやすみ。 私はこのゲームが大好きです。 こんにちは。"}]
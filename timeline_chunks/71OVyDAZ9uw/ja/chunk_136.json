[{"type": "subtitle", "time": 8165.75, "timestamp": "02:16:05", "text": "よしよし、"}, {"type": "subtitle", "time": 8167.79, "timestamp": "02:16:07", "text": "寝ようか？"}, {"type": "subtitle", "time": 8169.47, "timestamp": "02:16:09", "text": "彼女はみんな、"}, {"type": "subtitle", "time": 8174.71, "timestamp": "02:16:14", "text": "私はただ寝た方がいいでしょうか？ 私がそう思わないのは、ええと、"}, {"type": "subtitle", "time": 8191.63, "timestamp": "02:16:31", "text": "時々、配信をするためだけに"}, {"type": "subtitle", "time": 8195.709, "timestamp": "02:16:35", "text": "ゲームに頼りすぎるべきではないということを理解する必要がある"}, {"type": "subtitle", "time": 8198.35, "timestamp": "02:16:38", "text": "。 時々、"}, {"type": "subtitle", "time": 8199.95, "timestamp": "02:16:39", "text": "なぜなのか自分でもわからない。"}, {"type": "subtitle", "time": 8202.31, "timestamp": "02:16:42", "text": "最近は"}, {"type": "subtitle", "time": 8204.709, "timestamp": "02:16:44", "text": "ゲーム配信ばかりしているような気がします。"}, {"type": "subtitle", "time": 8207.47, "timestamp": "02:16:47", "text": "私はあまり活動していません。"}, {"type": "subtitle", "time": 8210.03, "timestamp": "02:16:50", "text": "そしてそれは、私が"}]
[{"type": "subtitle", "time": 1442.63, "timestamp": "00:24:02", "text": "最近2つ目の"}, {"type": "subtitle", "time": 1445.95, "timestamp": "00:24:05", "text": "パートタイムの仕事を始めたので、"}, {"type": "subtitle", "time": 1448.43, "timestamp": "00:24:08", "text": "シフトをアプリに登録する必要があります"}, {"type": "subtitle", "time": 1450.91, "timestamp": "00:24:10", "text": "。"}, {"type": "subtitle", "time": 1452.95, "timestamp": "00:24:12", "text": "それで、アプリの使い方が分からなかったので、どうやらそのアプリは"}, {"type": "subtitle", "time": 1456.27, "timestamp": "00:24:16", "text": "会社とは関係なかったようです。"}, {"type": "subtitle", "time": 1457.51, "timestamp": "00:24:17", "text": "それで、"}, {"type": "subtitle", "time": 1460.39, "timestamp": "00:24:20", "text": "先週送ったものは、いいえ、"}, {"type": "subtitle", "time": 1463.59, "timestamp": "00:24:23", "text": "先週は、始めたときに送ったのですが、"}, {"type": "subtitle", "time": 1465.99, "timestamp": "00:24:25", "text": "ええ、今週のために月曜日に送ったと思いますが、"}, {"type": "subtitle", "time": 1471.23, "timestamp": "00:24:31", "text": "承認されず、"}, {"type": "subtitle", "time": 1477.19, "timestamp": "00:24:37", "text": "会社に受け取られなかったので、"}, {"type": "subtitle", "time": 1479.75, "timestamp": "00:24:39", "text": "アプリのリンクプロセスをもう一度やり直さなければなりませんでした"}, {"type": "subtitle", "time": 1480.91, "timestamp": "00:24:40", "text": "。"}, {"type": "subtitle", "time": 1484.27, "timestamp": "00:24:44", "text": "そして最後に、それは繋がっている。 だから今週は、"}, {"type": "subtitle", "time": 1489.43, "timestamp": "00:24:49", "text": "水曜日より前に早めに送らなかったので、どの曜日に"}, {"type": "subtitle", "time": 1491.95, "timestamp": "00:24:51", "text": "働きたいか、勤務時間、"}, {"type": "subtitle", "time": 1493.95, "timestamp": "00:24:53", "text": "この日とあの日に何時間働けるかなど、シフトについてです"}, {"type": "subtitle", "time": 1496.63, "timestamp": "00:24:56", "text": "。"}, {"type": "subtitle", "time": 1497.43, "timestamp": "00:24:57", "text": "それで、"}]
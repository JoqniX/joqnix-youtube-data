[{"type": "subtitle", "time": 1680.43, "timestamp": "00:28:00", "text": "返事をしたかどうか、私には聞こえませんでした。 ええ、それはウォッチ"}, {"type": "subtitle", "time": 1681.99, "timestamp": "00:28:01", "text": "ドッグスのせいですよ。"}, {"type": "subtitle", "time": 1684.03, "timestamp": "00:28:04", "text": "ええと、ゲームの発売日です。 私は"}, {"type": "subtitle", "time": 1686.35, "timestamp": "00:28:06", "text": "そのゲームを予約注文しました。 私はその"}, {"type": "subtitle", "time": 1687.43, "timestamp": "00:28:07", "text": "ゲームを持っています。"}, {"type": "subtitle", "time": 1690.19, "timestamp": "00:28:10", "text": "えっと、私はゲームを買ったので、"}, {"type": "subtitle", "time": 1695.75, "timestamp": "00:28:15", "text": "今日、発売日にもう一度ゲームをプレイしたいと思っています。   今"}, {"type": "subtitle", "time": 1696.99, "timestamp": "00:28:16", "text": "まさに、"}, {"type": "subtitle", "time": 1699.99, "timestamp": "00:28:19", "text": "リリースされようとしているところです。 もし私が今インドにいたら、"}, {"type": "subtitle", "time": 1702.19, "timestamp": "00:28:22", "text": "これは問題にならないだろう。"}, {"type": "subtitle", "time": 1705.27, "timestamp": "00:28:25", "text": "午後9時半頃です。 リリースが行われるとき、例えば"}, {"type": "subtitle", "time": 1708.35, "timestamp": "00:28:28", "text": "グローバルローンチが行われるとき。"}, {"type": "subtitle", "time": 1712.27, "timestamp": "00:28:32", "text": "つまり、インド時間の午前2時か1時まで気軽にゲームをして、"}, {"type": "subtitle", "time": 1715.27, "timestamp": "00:28:35", "text": "それから寝ればいいってことですよね"}, {"type": "subtitle", "time": 1718.35, "timestamp": "00:28:38", "text": "？ しかし、こちらはもう真夜中だ。   今は午前2時"}, {"type": "subtitle", "time": 1722.95, "timestamp": "00:28:42", "text": "00分から2時38分ですが、ええ。"}, {"type": "subtitle", "time": 1725.31, "timestamp": "00:28:45", "text": "仕事があるんです。"}, {"type": "subtitle", "time": 1727.35, "timestamp": "00:28:47", "text": "午後11時です。 ここ。 ああ。"}, {"type": "subtitle", "time": 1729.71, "timestamp": "00:28:49", "text": "ええ、今はもう11時になります。"}, {"type": "subtitle", "time": 1730.59, "timestamp": "00:28:50", "text": "えっと、なんて"}, {"type": "subtitle", "time": 1732.31, "timestamp": "00:28:52", "text": "呼ぶんですか？ ええと、ああ、そうです、"}, {"type": "subtitle", "time": 1734.07, "timestamp": "00:28:54", "text": "11時です。   今は"}, {"type": "subtitle", "time": 1735.59, "timestamp": "00:28:55", "text": "2時30分だから、今は11時だ。 うん、"}, {"type": "subtitle", "time": 1736.75, "timestamp": "00:28:56", "text": "うん、うん。"}, {"type": "subtitle", "time": 1738.95, "timestamp": "00:28:58", "text": "えっと、なんて呼ぶんでしょう？"}]
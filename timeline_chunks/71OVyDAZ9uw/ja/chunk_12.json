[{"type": "subtitle", "time": 721.59, "timestamp": "00:12:01", "text": "。"}, {"type": "subtitle", "time": 724.43, "timestamp": "00:12:04", "text": "今夜は甘いものは何もない、"}, {"type": "subtitle", "time": 732.87, "timestamp": "00:12:12", "text": "私は『"}, {"type": "subtitle", "time": 739.55, "timestamp": "00:12:19", "text": "嵐が丘』などの他のゲームのリリースを待つために夜更かししたことがあります。他のゲームですよね？"}, {"type": "subtitle", "time": 747.67, "timestamp": "00:12:27", "text": "こんなことが私に起こるはずがない。"}, {"type": "subtitle", "time": 748.75, "timestamp": "00:12:28", "text": "よし、こういう"}, {"type": "subtitle", "time": 751.15, "timestamp": "00:12:31", "text": "時は"}, {"type": "subtitle", "time": 755.51, "timestamp": "00:12:35", "text": "Twitterに行くのが一番だ。"}, {"type": "subtitle", "time": 766.348, "timestamp": "00:12:46", "text": "Twitterに戻る。"}]
[{"type": "subtitle", "time": 3242.43, "timestamp": "00:54:02", "text": "[笑い]"}, {"type": "subtitle", "time": 3244.51, "timestamp": "00:54:04", "text": "ああ、わかった。"}, {"type": "subtitle", "time": 3250.07, "timestamp": "00:54:10", "text": "私は本当に遠くにいるのでしょうか？"}, {"type": "subtitle", "time": 3251.39, "timestamp": "00:54:11", "text": "私は。"}, {"type": "subtitle", "time": 3271.097, "timestamp": "00:54:31", "text": "呪われている。 うん。"}, {"type": "subtitle", "time": 3272.55, "timestamp": "00:54:32", "text": "[笑い]"}, {"type": "subtitle", "time": 3276.27, "timestamp": "00:54:36", "text": "ええと、プレイサーバーブラウザです。 さあ行こう。"}, {"type": "subtitle", "time": 3284.95, "timestamp": "00:54:44", "text": "クラシックキングオブザエクスペリエンスすべての"}, {"type": "subtitle", "time": 3286.51, "timestamp": "00:54:46", "text": "車は"}, {"type": "subtitle", "time": 3289.67, "timestamp": "00:54:49", "text": "最小限のUIでハードコアスタンダードを有効にし、"}, {"type": "subtitle", "time": 3292.95, "timestamp": "00:54:52", "text": "ダイナミックオーストラリアハードクック動物は"}, {"type": "subtitle", "time": 3295.31, "timestamp": "00:54:55", "text": "良いスロット最小限の体力バー"}, {"type": "subtitle", "time": 3297.91, "timestamp": "00:54:57", "text": "またはインベントリモードは全くなく、攻撃車両は"}, {"type": "subtitle", "time": 3299.95, "timestamp": "00:54:59", "text": "一定で、その他は無効にしてください"}]
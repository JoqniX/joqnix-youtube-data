[{"type": "subtitle", "time": 1920.79, "timestamp": "00:32:00", "text": "何だ？ いや。"}, {"type": "subtitle", "time": 1923.27, "timestamp": "00:32:03", "text": "配信をするのは良い選択ですね。 いや。 私はお金がなくて、"}, {"type": "subtitle", "time": 1932.51, "timestamp": "00:32:12", "text": "この配信のためだけにたくさんのものを買ったんです"}, {"type": "subtitle", "time": 1936.03, "timestamp": "00:32:16", "text": "。 つまり、今日と明日のことです。"}, {"type": "subtitle", "time": 1937.55, "timestamp": "00:32:17", "text": "うん。"}, {"type": "subtitle", "time": 1943.39, "timestamp": "00:32:23", "text": "、明後日の日曜日も。   「"}, {"type": "subtitle", "time": 1949.31, "timestamp": "00:32:29", "text": "言いたいことが山ほどあるんです。   お金が"}, {"type": "subtitle", "time": 1953.87, "timestamp": "00:32:33", "text": "なかったのに、物を買ってしまった。   どうすればいいのか分からない"}, {"type": "subtitle", "time": 1955.71, "timestamp": "00:32:35", "text": "けど、まあ、そうだね。   私が"}, {"type": "subtitle", "time": 1961.67, "timestamp": "00:32:41", "text": "実際に受け取ったものの一つのように、叱られてはいません"}, {"type": "subtitle", "time": 1963.99, "timestamp": "00:32:43", "text": "。 それはむしろ"}, {"type": "subtitle", "time": 1965.63, "timestamp": "00:32:45", "text": "現実を突きつけられたようなものだ。"}, {"type": "subtitle", "time": 1970.75, "timestamp": "00:32:50", "text": "何と呼ぶのですか？   えっと、最近は、"}, {"type": "subtitle", "time": 1978.75, "timestamp": "00:32:58", "text": "ゲームが"}]
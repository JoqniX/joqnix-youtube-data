[{"type": "subtitle", "time": 8882.19, "timestamp": "02:28:02", "text": "素晴らしい仕事ぶりです。"}, {"type": "subtitle", "time": 8883.27, "timestamp": "02:28:03", "text": "木材とは違って、もうひとつ"}, {"type": "subtitle", "time": 8885.07, "timestamp": "02:28:05", "text": "、もうひとつ。"}, {"type": "subtitle", "time": 8886.87, "timestamp": "02:28:06", "text": "それは貫通不可能で、銃弾が"}, {"type": "subtitle", "time": 8888.19, "timestamp": "02:28:08", "text": "跳弾する原因となる。"}, {"type": "subtitle", "time": 8889.67, "timestamp": "02:28:09", "text": "容器の端に向けて発砲し、"}, {"type": "subtitle", "time": 8896.99, "timestamp": "02:28:16", "text": "よくやった。"}, {"type": "subtitle", "time": 8897.39, "timestamp": "02:28:17", "text": "えっと、"}, {"type": "subtitle", "time": 8900.03, "timestamp": "02:28:20", "text": "爆発物の扱いにどれだけ自信があるのか​​見せてもらおうか。"}, {"type": "subtitle", "time": 8903.07, "timestamp": "02:28:23", "text": "販売業者に行って手榴弾をいくつか買ってきてください。"}, {"type": "subtitle", "time": 8904.91, "timestamp": "02:28:24", "text": "誤解しないでください。 私は"}, {"type": "subtitle", "time": 8911.83, "timestamp": "02:28:31", "text": "えっと、何を描けばいいかわからないので、"}, {"type": "subtitle", "time": 8914.79, "timestamp": "02:28:34", "text": "ファンアートとしてあなたを描いてもいいですか？ どうぞご自由に。"}, {"type": "subtitle", "time": 8924.11, "timestamp": "02:28:44", "text": "今すぐ露店に行って手榴弾を買ってきてください。"}, {"type": "subtitle", "time": 8925.67, "timestamp": "02:28:45", "text": "さあ、"}, {"type": "subtitle", "time": 8928.19, "timestamp": "02:28:48", "text": "攻撃用ベストの4番目のスロットから手榴弾を取り出し"}, {"type": "subtitle", "time": 8935.27, "timestamp": "02:28:55", "text": "よくやった。"}]
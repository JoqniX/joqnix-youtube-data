[{"type": "subtitle", "time": 1320.27, "timestamp": "00:22:00", "text": "その間に何か別のことをしてみない"}, {"type": "subtitle", "time": 1321.91, "timestamp": "00:22:01", "text": "？ これを残して、私は"}, {"type": "subtitle", "time": 1323.95, "timestamp": "00:22:03", "text": "うん。   そうですね、"}, {"type": "subtitle", "time": 1327.15, "timestamp": "00:22:07", "text": "それは良い考えです。 うん。"}, {"type": "subtitle", "time": 1329.75, "timestamp": "00:22:09", "text": "確認しておくべきだった。"}, {"type": "subtitle", "time": 1332.23, "timestamp": "00:22:12", "text": "もう少し眠れたかもしれない。"}, {"type": "subtitle", "time": 1335.59, "timestamp": "00:22:15", "text": "私は3、4時間しか寝なかった。   午前"}, {"type": "subtitle", "time": 1338.31, "timestamp": "00:22:18", "text": "10時30分から午後2時まで。 私は午前"}, {"type": "subtitle", "time": 1340.99, "timestamp": "00:22:20", "text": "1時頃、つまり1時間ほど早く配信する予定でした。"}, {"type": "subtitle", "time": 1344.27, "timestamp": "00:22:24", "text": "洪水ゲートが"}, {"type": "subtitle", "time": 1346.27, "timestamp": "00:22:26", "text": "開いたとき。   えっと、"}, {"type": "subtitle", "time": 1353.43, "timestamp": "00:22:33", "text": "痛み、"}, {"type": "subtitle", "time": 1364.79, "timestamp": "00:22:44", "text": "もしそれが、もし"}, {"type": "subtitle", "time": 1367.79, "timestamp": "00:22:47", "text": "私たちがまだここに3"}, {"type": "subtitle", "time": 1371.75, "timestamp": "00:22:51", "text": "時間いて、まだ閉まっているとしたら。"}, {"type": "subtitle", "time": 1373.11, "timestamp": "00:22:53", "text": "香港時間で午前1時？ うん、午前"}, {"type": "subtitle", "time": 1377.63, "timestamp": "00:22:57", "text": "1時だよ。うん、今は午前2時32分だよ。"}]
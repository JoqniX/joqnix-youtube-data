[{"type": "subtitle", "time": 8821.03, "timestamp": "02:27:01", "text": "廊下を渡って始められます。"}, {"type": "subtitle", "time": 8831.67, "timestamp": "02:27:11", "text": "立派な男性は機器販売業者です。"}, {"type": "subtitle", "time": 8835.43, "timestamp": "02:27:15", "text": "裏路地のあちこちで、武器のポスターの横に立っている奴らを見かけるだろう。"}, {"type": "subtitle", "time": 8837.15, "timestamp": "02:27:17", "text": "次の部屋に行かなければならない。そうすれば"}, {"type": "subtitle", "time": 8839.79, "timestamp": "02:27:19", "text": "彼から弾薬を手に入れることができる。   それでは"}, {"type": "subtitle", "time": 8841.19, "timestamp": "02:27:21", "text": "始めましょう。"}, {"type": "subtitle", "time": 8852.47, "timestamp": "02:27:32", "text": "あなたが以前にもこれをやったことがあるのは知っていますが、私"}, {"type": "subtitle", "time": 8854.55, "timestamp": "02:27:34", "text": "自身で確認する必要があるので、"}, {"type": "subtitle", "time": 8867.63, "timestamp": "02:27:47", "text": "適切な装備があれば、"}, {"type": "subtitle", "time": 8869.11, "timestamp": "02:27:49", "text": "弾丸はガラス、木材、布などの弱い素材を簡単に貫通できます"}, {"type": "subtitle", "time": 8873.39, "timestamp": "02:27:53", "text": "。"}, {"type": "subtitle", "time": 8875.47, "timestamp": "02:27:55", "text": "木を通して的を撃て。   ご"}]
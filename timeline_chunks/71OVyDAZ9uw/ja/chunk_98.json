[{"type": "subtitle", "time": 5888.35, "timestamp": "01:38:08", "text": "ベンダーに行くのではなく、彼らは私たちに"}, {"type": "subtitle", "time": 5906.47, "timestamp": "01:38:26", "text": "それを何と呼ぶのですか？"}, {"type": "subtitle", "time": 5913.23, "timestamp": "01:38:33", "text": "武器などのアイテムは、ベンダーを通さずにメニューから直接アクセスできるようにする"}]
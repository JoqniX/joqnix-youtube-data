[{"type": "subtitle", "time": 1861.59, "timestamp": "00:31:01", "text": "カリがオンになった。 なぜ？"}, {"type": "subtitle", "time": 1862.841, "timestamp": "00:31:02", "text": "なぜ？ [笑い]"}, {"type": "subtitle", "time": 1870.71, "timestamp": "00:31:10", "text": "なんで電話して「ああ、"}, {"type": "subtitle", "time": 1872.67, "timestamp": "00:31:12", "text": "また門を閉めてくれ」って言ったの？"}, {"type": "subtitle", "time": 1875.79, "timestamp": "00:31:15", "text": "もっと多くの人を入場させなければならないが、彼らはまたもっと"}, {"type": "subtitle", "time": 1878.43, "timestamp": "00:31:18", "text": "待たなければならない。"}, {"type": "subtitle", "time": 1880.516, "timestamp": "00:31:20", "text": "列に戻った。"}, {"type": "subtitle", "time": 1906.03, "timestamp": "00:31:46", "text": "、でも、このゲームが本当に楽しみだよ"}, {"type": "subtitle", "time": 1914.15, "timestamp": "00:31:54", "text": "ええ、アカウントを連携させる必要があるんですよね"}, {"type": "subtitle", "time": 1916.67, "timestamp": "00:31:56", "text": "？"}, {"type": "subtitle", "time": 1918.79, "timestamp": "00:31:58", "text": "ジャクサ、寝なさい。   あれは"}]
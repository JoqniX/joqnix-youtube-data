[{"type": "subtitle", "time": 4882.47, "timestamp": "01:21:22", "text": "ちょっと待って。"}, {"type": "subtitle", "time": 4887.001, "timestamp": "01:21:27", "text": "えっと、ハッシュタグはワイヤードッグです。"}, {"type": "subtitle", "time": 4901.35, "timestamp": "01:21:41", "text": "待ち行列に閉じ込められてゲームをプレイできないなどの理由で、多くの人がゲームのレビュー爆撃を行っています"}]
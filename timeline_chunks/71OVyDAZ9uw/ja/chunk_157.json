[{"type": "subtitle", "time": 9424.27, "timestamp": "02:37:04", "text": "スタジオが全力を尽くして制作したものであることを理解していただきたいと思います。"}, {"type": "subtitle", "time": 9426.79, "timestamp": "02:37:06", "text": "そしてAAAタイトルでさえ、発売当初はひどい状態になることがある"}, {"type": "subtitle", "time": 9430.19, "timestamp": "02:37:10", "text": "（笑）"}, {"type": "subtitle", "time": 9431.87, "timestamp": "02:37:11", "text": "。"}, {"type": "subtitle", "time": 9434.79, "timestamp": "02:37:14", "text": "だから、それでいいんです。"}, {"type": "subtitle", "time": 9437.63, "timestamp": "02:37:17", "text": "それでね、知ってる？"}, {"type": "subtitle", "time": 9438.95, "timestamp": "02:37:18", "text": "とりあえず、"}, {"type": "subtitle", "time": 9440.35, "timestamp": "02:37:20", "text": "みんな、"}, {"type": "subtitle", "time": 9442.79, "timestamp": "02:37:22", "text": "私はゲームをやめるよ。"}, {"type": "subtitle", "time": 9445.59, "timestamp": "02:37:25", "text": "これで配信を終了します。"}, {"type": "subtitle", "time": 9447.31, "timestamp": "02:37:27", "text": "特に何も起こっていないけれど。"}, {"type": "subtitle", "time": 9449.03, "timestamp": "02:37:29", "text": "僕たちは遊んで、"}, {"type": "subtitle", "time": 9451.95, "timestamp": "02:37:31", "text": "ヘリコプターを少しの間爆破して、不時着させた"}, {"type": "subtitle", "time": 9455.67, "timestamp": "02:37:35", "text": "。 以上です。   それ以外は"}, {"type": "subtitle", "time": 9459.15, "timestamp": "02:37:39", "text": "楽しかった。"}, {"type": "subtitle", "time": 9461.03, "timestamp": "02:37:41", "text": "うん。"}]
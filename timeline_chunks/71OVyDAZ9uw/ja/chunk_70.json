[{"type": "subtitle", "time": 4205.15, "timestamp": "01:10:05", "text": "この配信者がやってるブラッドドッグ"}, {"type": "subtitle", "time": 4207.23, "timestamp": "01:10:07", "text": "募集企画に、"}, {"type": "subtitle", "time": 4210.07, "timestamp": "01:10:10", "text": "日本チームの一員として参加したいんです。"}, {"type": "subtitle", "time": 4212.23, "timestamp": "01:10:12", "text": "でも、今日は学校と"}, {"type": "subtitle", "time": 4215.79, "timestamp": "01:10:15", "text": "仕事があるので、"}, {"type": "subtitle", "time": 4223.55, "timestamp": "01:10:23", "text": "彼らのイベントに参加したり、"}, {"type": "subtitle", "time": 4225.79, "timestamp": "01:10:25", "text": "一緒に遊んだりすることができないんです。"}, {"type": "subtitle", "time": 4228.15, "timestamp": "01:10:28", "text": "有名ストリーマーと一緒にプレイできる良い機会になるだろう"}, {"type": "subtitle", "time": 4230.91, "timestamp": "01:10:30", "text": "けど、"}]
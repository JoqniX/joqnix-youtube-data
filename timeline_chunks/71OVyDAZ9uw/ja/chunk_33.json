[{"type": "subtitle", "time": 1985.87, "timestamp": "00:33:05", "text": "ええ、それで最近、"}, {"type": "subtitle", "time": 1991.47, "timestamp": "00:33:11", "text": "「うーん、"}, {"type": "subtitle", "time": 1993.79, "timestamp": "00:33:13", "text": "どうしたらいいんだろう？」みたいなジレンマというか思考プロセスに陥っているんです。"}, {"type": "subtitle", "time": 1996.91, "timestamp": "00:33:16", "text": "ご存知のように、最近ゲームをし"}, {"type": "subtitle", "time": 1999.75, "timestamp": "00:33:19", "text": "たり配信したりする時は、"}, {"type": "subtitle", "time": 2006.55, "timestamp": "00:33:26", "text": "ビットレートが3000しか出せないので、見ているとすごく見づらいですよ"}, {"type": "subtitle", "time": 2011.91, "timestamp": "00:33:31", "text": "ね？ 配信を見ていると、"}, {"type": "subtitle", "time": 2017.15, "timestamp": "00:33:37", "text": "すごくぼやけてて、画質が悪く見えるよね？"}, {"type": "subtitle", "time": 2019.27, "timestamp": "00:33:39", "text": "ゲームプレイも何もかも。"}, {"type": "subtitle", "time": 2022.91, "timestamp": "00:33:42", "text": "えっと、今日の配信はローカルで"}, {"type": "subtitle", "time": 2025.59, "timestamp": "00:33:45", "text": "録画しています。"}, {"type": "subtitle", "time": 2029.19, "timestamp": "00:33:49", "text": "神のみぞ知る、どれほど大きいか。ああ、神よ、ジャガーノートは、あなたが"}, {"type": "subtitle", "time": 2031.83, "timestamp": "00:33:51", "text": "私たちを終わらせたと言っています。"}, {"type": "subtitle", "time": 2033.63, "timestamp": "00:33:53", "text": "何？"}, {"type": "subtitle", "time": 2035.47, "timestamp": "00:33:55", "text": "キックストリーム？ 何？ キックに何があったの"}, {"type": "subtitle", "time": 2037.55, "timestamp": "00:33:57", "text": "？"}]
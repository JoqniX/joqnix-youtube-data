[{"type": "subtitle", "time": 6789.19, "timestamp": "01:53:09", "text": "隔壁にとって、なんとも恥ずかしい進水式だった。 大丈夫。"}, {"type": "subtitle", "time": 6790.99, "timestamp": "01:53:10", "text": "なぜなら、ストリーマーはこのゲームをプレイできる一方で、"}, {"type": "subtitle", "time": 6792.59, "timestamp": "01:53:12", "text": "他の人たち（私たち）は"}, {"type": "subtitle", "time": 6794.27, "timestamp": "01:53:14", "text": "ゲームへのリンクに失敗したり、"}, {"type": "subtitle", "time": 6796.55, "timestamp": "01:53:16", "text": "サーバーに参加した途端にBANされたりといった事態に陥っているからだ。   そこに"}, {"type": "subtitle", "time": 6798.63, "timestamp": "01:53:18", "text": "近づいて、"}]
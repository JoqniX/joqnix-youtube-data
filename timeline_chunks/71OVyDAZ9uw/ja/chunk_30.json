[{"type": "subtitle", "time": 1801.87, "timestamp": "00:30:01", "text": "。 汚い言葉を使ってしまってすみません。 兄弟。"}, {"type": "subtitle", "time": 1809.13, "timestamp": "00:30:09", "text": "兄弟。 [笑い]"}, {"type": "subtitle", "time": 1814.39, "timestamp": "00:30:14", "text": "兄弟。"}, {"type": "subtitle", "time": 1816.23, "timestamp": "00:30:16", "text": "あ、待って。 忘れた。 忘れた。 ああ、"}, {"type": "subtitle", "time": 1817.87, "timestamp": "00:30:17", "text": "やばい。 忘れた。 午前"}, {"type": "subtitle", "time": 1820.19, "timestamp": "00:30:20", "text": "2時だ。今、叫んでいる場合じゃない"}, {"type": "subtitle", "time": 1823.59, "timestamp": "00:30:23", "text": "。 くそっ。 私は家にいません。 私は"}, {"type": "subtitle", "time": 1826.99, "timestamp": "00:30:26", "text": "インドの自宅にはいません。 私は日本にいます。"}, {"type": "subtitle", "time": 1830.79, "timestamp": "00:30:30", "text": "私は日本にいます。 私にはルームメイトがいます。"}, {"type": "subtitle", "time": 1832.15, "timestamp": "00:30:32", "text": "つまり、"}, {"type": "subtitle", "time": 1834.39, "timestamp": "00:30:34", "text": "隣人のことです。 そして、私のルームメイトは"}, {"type": "subtitle", "time": 1837.15, "timestamp": "00:30:37", "text": "仕事に出かけました。 彼は夜勤だ。 だから、"}, {"type": "subtitle", "time": 1838.63, "timestamp": "00:30:38", "text": "水曜日、木曜日、"}, {"type": "subtitle", "time": 1841.11, "timestamp": "00:30:41", "text": "金曜日は、彼は仕事に行くので"}, {"type": "subtitle", "time": 1844.07, "timestamp": "00:30:44", "text": "、私は、"}, {"type": "subtitle", "time": 1846.59, "timestamp": "00:30:46", "text": "もし望むなら深夜の配信をすることができます。   えっと"}, {"type": "subtitle", "time": 1849.43, "timestamp": "00:30:49", "text": "、"}, {"type": "subtitle", "time": 1851.59, "timestamp": "00:30:51", "text": "十分な睡眠が取れて、"}, {"type": "subtitle", "time": 1854.35, "timestamp": "00:30:54", "text": "時間通りに起きられるなら、いつでもできますよ。"}, {"type": "subtitle", "time": 1855.63, "timestamp": "00:30:55", "text": "ああ、もう"}, {"type": "subtitle", "time": 1858.15, "timestamp": "00:30:58", "text": "。 なぜ？"}]
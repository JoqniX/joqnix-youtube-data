[{"type": "subtitle", "time": 3123.91, "timestamp": "00:52:03", "text": "戦争チャンネルのために、高度な放送技術の使い方を習得しなければならない。"}, {"type": "subtitle", "time": 3126.79, "timestamp": "00:52:06", "text": "私の24時間365日チャンネルは、"}, {"type": "subtitle", "time": 3130.67, "timestamp": "00:52:10", "text": "ビデオを送信したくないので。"}, {"type": "subtitle", "time": 3132.67, "timestamp": "00:52:12", "text": "つまり、クラウドサーバーだから"}, {"type": "subtitle", "time": 3135.99, "timestamp": "00:52:15", "text": "問題ないんです。 それなら対処できる。"}, {"type": "subtitle", "time": 3138.63, "timestamp": "00:52:18", "text": "しかし、概して言えば、やりすぎだ"}, {"type": "subtitle", "time": 3140.27, "timestamp": "00:52:20", "text": "。"}, {"type": "subtitle", "time": 3142.27, "timestamp": "00:52:22", "text": "はい、設定です。"}, {"type": "subtitle", "time": 3149.71, "timestamp": "00:52:29", "text": "コントロール。"}, {"type": "subtitle", "time": 3159.55, "timestamp": "00:52:39", "text": "空気を見るべきですね。"}, {"type": "subtitle", "time": 3172.43, "timestamp": "00:52:52", "text": "ええ、試合に出る"}, {"type": "subtitle", "time": 3174.67, "timestamp": "00:52:54", "text": "前にヘリコプターの操縦技術を鍛えておきたいんです"}]
[{"type": "subtitle", "time": 2760.191, "timestamp": "00:46:00", "text": "[うめき声]"}, {"type": "subtitle", "time": 2760.95, "timestamp": "00:46:00", "text": "[叫び声]"}, {"type": "subtitle", "time": 2763.59, "timestamp": "00:46:03", "text": "そしてあなたは死んだ。"}, {"type": "subtitle", "time": 2764.91, "timestamp": "00:46:04", "text": "あるいは、自分の手を使って"}, {"type": "subtitle", "time": 2767.27, "timestamp": "00:46:07", "text": "彼を蘇生させることもできます。 適切な医療機器を使用することで、"}, {"type": "subtitle", "time": 2771.03, "timestamp": "00:46:11", "text": "処置ははるかに迅速になります。"}, {"type": "subtitle", "time": 2772.59, "timestamp": "00:46:12", "text": "販売店の商品一覧から蘇生器を選んで、ご"}, {"type": "subtitle", "time": 2774.95, "timestamp": "00:46:14", "text": "自身で確かめてみてください。"}, {"type": "subtitle", "time": 2784.63, "timestamp": "00:46:24", "text": "さあ、蘇生処置をする前に、まずその男を危険な場所から引き離せ"}, {"type": "subtitle", "time": 2793.59, "timestamp": "00:46:33", "text": "あなたは私の家の"}, {"type": "subtitle", "time": 2796.35, "timestamp": "00:46:36", "text": "地下室に入ることになる。"}, {"type": "subtitle", "time": 2809.43, "timestamp": "00:46:49", "text": "ホイ。   さあ行こう"}]
[{"type": "subtitle", "time": 8041.79, "timestamp": "02:14:01", "text": "私は、「"}, {"type": "subtitle", "time": 8047.63, "timestamp": "02:14:07", "text": "今日は少なくとも10万ドルは稼ぐぞ」と思っていました。"}, {"type": "subtitle", "time": 8051.71, "timestamp": "02:14:11", "text": "そして、AK-47のようなAKをアンロックするのに十分なお金を稼ぎましょう"}, {"type": "subtitle", "time": 8057.23, "timestamp": "02:14:17", "text": "。"}, {"type": "subtitle", "time": 8059.79, "timestamp": "02:14:19", "text": "それが私の計画だった。   たくさんの"}, {"type": "subtitle", "time": 8064.95, "timestamp": "02:14:24", "text": "「これをやる。あれもやる"}, {"type": "subtitle", "time": 8066.63, "timestamp": "02:14:26", "text": "。これもやる。あれもこれもやる。あれもこれも"}, {"type": "subtitle", "time": 8067.83, "timestamp": "02:14:27", "text": "。うんざりするほど"}, {"type": "subtitle", "time": 8077.59, "timestamp": "02:14:37", "text": "そして最後に、私はこの"}, {"type": "subtitle", "time": 8079.95, "timestamp": "02:14:39", "text": "虚無の中に閉じ込められてしまった。"}]
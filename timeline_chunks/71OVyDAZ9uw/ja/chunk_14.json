[{"type": "subtitle", "time": 843.87, "timestamp": "00:14:03", "text": "ずっとkickがそういうものになるのを待っていました。"}, {"type": "subtitle", "time": 851.47, "timestamp": "00:14:11", "text": "もちろん他の方法もあったのですが、"}, {"type": "subtitle", "time": 856.71, "timestamp": "00:14:16", "text": "kickがインド向けの収益化をサポートするまで待ちたかったんです。"}, {"type": "subtitle", "time": 862.75, "timestamp": "00:14:22", "text": "長い間kickには"}, {"type": "subtitle", "time": 865.67, "timestamp": "00:14:25", "text": "その機能がなかったからです。"}, {"type": "subtitle", "time": 868.43, "timestamp": "00:14:28", "text": "つまり、その国は"}, {"type": "subtitle", "time": 872.11, "timestamp": "00:14:32", "text": "オンボーディング画面で選択できなかったということです。"}, {"type": "subtitle", "time": 875.31, "timestamp": "00:14:35", "text": "そしてついに、そうなった。 私はとても幸せです。   本当に"}, {"type": "subtitle", "time": 877.39, "timestamp": "00:14:37", "text": "本当に幸せです。 ついに"}, {"type": "subtitle", "time": 880.51, "timestamp": "00:14:40", "text": "収益化を有効にできた"}, {"type": "subtitle", "time": 884.15, "timestamp": "00:14:44", "text": "ので、"}, {"type": "subtitle", "time": 886.99, "timestamp": "00:14:46", "text": "ギフトを送ることができます。"}, {"type": "subtitle", "time": 888.75, "timestamp": "00:14:48", "text": "贈り物を送っていただいても構いません。"}, {"type": "subtitle", "time": 892.11, "timestamp": "00:14:52", "text": "ええ、贈り物ですね。 彼らはそれを「キック」と呼ぶ。"}, {"type": "subtitle", "time": 894.71, "timestamp": "00:14:54", "text": "Kickで私にキックを送ることもできますし、"}, {"type": "subtitle", "time": 897.67, "timestamp": "00:14:57", "text": "サブスクリプションも"}]
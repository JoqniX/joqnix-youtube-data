[{"type": "subtitle", "time": 550.75, "timestamp": "00:09:10", "text": "ああ、みんな、私の声が聞こえる？ こんにちは、こんにちは。"}, {"type": "subtitle", "time": 552.27, "timestamp": "00:09:12", "text": "こんにちは、みんな。"}, {"type": "subtitle", "time": 555.07, "timestamp": "00:09:15", "text": "オハヨーゴザイマス。 皆さん、おはようございます。   午前"}, {"type": "subtitle", "time": 557.63, "timestamp": "00:09:17", "text": "2時なのに、寝てしまった"}, {"type": "subtitle", "time": 560.23, "timestamp": "00:09:20", "text": "。"}, {"type": "subtitle", "time": 565.59, "timestamp": "00:09:25", "text": "ウォッチドッグスの発売日から1時間が経過しました。"}, {"type": "subtitle", "time": 567.99, "timestamp": "00:09:27", "text": "そして、ゲームは発売された。 私は起きたばかりです"}, {"type": "subtitle", "time": 568.5360000000001, "timestamp": "00:09:28", "text": "。"}, {"type": "subtitle", "time": 569.03, "timestamp": "00:09:29", "text": "[笑い]"}, {"type": "subtitle", "time": 573.35, "timestamp": "00:09:33", "text": "GPUのアップデートがあったので、準備は万端です"}, {"type": "subtitle", "time": 574.67, "timestamp": "00:09:34", "text": "。すべて順調です"}, {"type": "subtitle", "time": 575.95, "timestamp": "00:09:35", "text": "。"}, {"type": "subtitle", "time": 578.87, "timestamp": "00:09:38", "text": "スナック菓子を用意しました。準備万端です。"}, {"type": "subtitle", "time": 585.19, "timestamp": "00:09:45", "text": "私はどれくらい寝たんだろう？ 午前10時30分から"}, {"type": "subtitle", "time": 589.95, "timestamp": "00:09:49", "text": "午前2時まで。だから、待ってください。  1 2 3"}, {"type": "subtitle", "time": 592.95, "timestamp": "00:09:52", "text": "3時間半。"}, {"type": "subtitle", "time": 596.39, "timestamp": "00:09:56", "text": "でも、今日は学校もあるし、仕事もあるんです。"}]
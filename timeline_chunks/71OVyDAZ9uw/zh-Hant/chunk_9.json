[{"type": "subtitle", "time": 550.75, "timestamp": "00:09:10", "text": "啊，你們聽得到我說話嗎？你好，你好。"}, {"type": "subtitle", "time": 552.27, "timestamp": "00:09:12", "text": "大家好。  哦哈"}, {"type": "subtitle", "time": 555.07, "timestamp": "00:09:15", "text": "約·戈札馬蘇。各位早安。  現在已經是凌晨"}, {"type": "subtitle", "time": 557.63, "timestamp": "00:09:17", "text": "兩點了，我睡著了"}, {"type": "subtitle", "time": 560.23, "timestamp": "00:09:20", "text": "。 《看門狗》發售至今已過1小時"}, {"type": "subtitle", "time": 565.59, "timestamp": "00:09:25", "text": "。"}, {"type": "subtitle", "time": 567.99, "timestamp": "00:09:27", "text": "遊戲結束了。我剛"}, {"type": "subtitle", "time": 568.5360000000001, "timestamp": "00:09:28", "text": "睡醒。"}, {"type": "subtitle", "time": 569.03, "timestamp": "00:09:29", "text": "[笑聲]"}, {"type": "subtitle", "time": 570.31, "timestamp": "00:09:30", "text": "我"}, {"type": "subtitle", "time": 573.35, "timestamp": "00:09:33", "text": "更新了顯示卡，是的，我們準備"}, {"type": "subtitle", "time": 574.67, "timestamp": "00:09:34", "text": "就緒。一切都準備好了。"}, {"type": "subtitle", "time": 577.15, "timestamp": "00:09:37", "text": "我準備了"}, {"type": "subtitle", "time": 578.87, "timestamp": "00:09:38", "text": "一些零食，"}, {"type": "subtitle", "time": 579.95, "timestamp": "00:09:39", "text": "一切就緒"}, {"type": "subtitle", "time": 585.19, "timestamp": "00:09:45", "text": "。我睡了多久？上午 10:30 到凌晨"}, {"type": "subtitle", "time": 589.95, "timestamp": "00:09:49", "text": "2:00。所以，請稍等。 1 2 3 3.5"}, {"type": "subtitle", "time": 592.95, "timestamp": "00:09:52", "text": "小時。"}, {"type": "subtitle", "time": 596.39, "timestamp": "00:09:56", "text": "但是，我今天既要上學又要上班。"}]
[{"type": "subtitle", "time": 673.15, "timestamp": "00:11:13", "text": "我忘了。"}, {"type": "subtitle", "time": 683.47, "timestamp": "00:11:23", "text": "不，別這樣對我。"}, {"type": "subtitle", "time": 691.63, "timestamp": "00:11:31", "text": "我忘了。我本來可以醒來後就去做，把"}, {"type": "subtitle", "time": 695.07, "timestamp": "00:11:35", "text": "自己加入隊列，"}, {"type": "subtitle", "time": 698.47, "timestamp": "00:11:38", "text": "這樣我就可以直播了。操，我為什麼要"}, {"type": "subtitle", "time": 708.03, "timestamp": "00:11:48", "text": "不，"}, {"type": "subtitle", "time": 718.87, "timestamp": "00:11:58", "text": "拉屎。"}]
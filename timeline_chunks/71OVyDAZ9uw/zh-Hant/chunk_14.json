[{"type": "subtitle", "time": 843.87, "timestamp": "00:14:03", "text": "我一直都在等 Kick 支持"}, {"type": "subtitle", "time": 859.71, "timestamp": "00:14:19", "text": "印度地區的獲利功能。當然，我也可以採取其他方法，但我想等到 Kick 支援印度地區的獲利功能，因為"}, {"type": "subtitle", "time": 862.75, "timestamp": "00:14:22", "text": "很長一段時間以來，Kick 都沒有"}, {"type": "subtitle", "time": 865.67, "timestamp": "00:14:25", "text": "這個功能。"}, {"type": "subtitle", "time": 868.43, "timestamp": "00:14:28", "text": "也就是說，該國家/地區在註冊流程中不可用"}, {"type": "subtitle", "time": 872.11, "timestamp": "00:14:32", "text": "。"}, {"type": "subtitle", "time": 875.31, "timestamp": "00:14:35", "text": "終於實現了。我太高興了。  我真的非常非常"}, {"type": "subtitle", "time": 877.39, "timestamp": "00:14:37", "text": "高興。"}, {"type": "subtitle", "time": 880.51, "timestamp": "00:14:40", "text": "我終於可以啟用獲利功能了，"}, {"type": "subtitle", "time": 884.15, "timestamp": "00:14:44", "text": "所以"}, {"type": "subtitle", "time": 886.99, "timestamp": "00:14:46", "text": "你們可以送我禮物了。你可以送我禮物，但"}, {"type": "subtitle", "time": 888.75, "timestamp": "00:14:48", "text": "不能送禮物。"}, {"type": "subtitle", "time": 892.11, "timestamp": "00:14:52", "text": "對，禮物。他們稱之為踢腿。你可以透過"}, {"type": "subtitle", "time": 894.71, "timestamp": "00:14:54", "text": "Kick 寄給我 Kicks，"}, {"type": "subtitle", "time": 897.67, "timestamp": "00:14:57", "text": "訂閱服務也"}]
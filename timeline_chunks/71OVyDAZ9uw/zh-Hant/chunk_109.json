[{"type": "subtitle", "time": 6549.83, "timestamp": "01:49:09", "text": "天哪，這"}, {"type": "subtitle", "time": 6553.03, "timestamp": "01:49:13", "text": "遊戲裡居然有弓箭！  這就是我想玩這個遊戲的原因，因為他們居然有弓箭！他們有弓箭，"}, {"type": "subtitle", "time": 6574.91, "timestamp": "01:49:34", "text": "我喜歡有弓箭的遊戲，真的。  這是我體驗過的最棒的感覺。  你要買什麼？  歡迎隨時回來。"}, {"type": "subtitle", "time": 6577.95, "timestamp": "01:49:37", "text": "好的，我們進去。好的。  我認為直升機應該會飛得更高"}]
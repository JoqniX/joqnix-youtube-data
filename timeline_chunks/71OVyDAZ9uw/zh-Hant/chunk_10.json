[{"type": "subtitle", "time": 600.99, "timestamp": "00:10:00", "text": "所以，從現在起兩點到凌晨兩點半，我們將播放《野狗》這首歌"}, {"type": "subtitle", "time": 609.11, "timestamp": "00:10:09", "text": "。所以，3:30 4:30 5:30"}, {"type": "subtitle", "time": 611.95, "timestamp": "00:10:11", "text": "6:30。 4小時，可以嗎？最多4小時，"}, {"type": "subtitle", "time": 613.27, "timestamp": "00:10:13", "text": "好嗎？"}, {"type": "subtitle", "time": 615.99, "timestamp": "00:10:15", "text": "然後，我得趕緊洗漱一下"}, {"type": "subtitle", "time": 618.33, "timestamp": "00:10:18", "text": "，準備上班等等。"}, {"type": "subtitle", "time": 622.71, "timestamp": "00:10:22", "text": "[音樂] 然後，我們就回家了。"}, {"type": "subtitle", "time": 624.212, "timestamp": "00:10:24", "text": "鎖定目標。"}, {"type": "subtitle", "time": 624.67, "timestamp": "00:10:24", "text": "[笑聲]"}, {"type": "subtitle", "time": 626.71, "timestamp": "00:10:26", "text": "我們要鎖定目標。"}, {"type": "subtitle", "time": 638.11, "timestamp": "00:10:38", "text": "。讓我切換到遊戲模式。"}, {"type": "subtitle", "time": 640.23, "timestamp": "00:10:40", "text": "給我一分鐘時間。"}, {"type": "subtitle", "time": 643.15, "timestamp": "00:10:43", "text": "把你壓扁，我嘆了口氣。如你"}, {"type": "subtitle", "time": 645.15, "timestamp": "00:10:45", "text": "所見，遊戲開始了。"}, {"type": "subtitle", "time": 647.07, "timestamp": "00:10:47", "text": "最後。"}, {"type": "subtitle", "time": 649.23, "timestamp": "00:10:49", "text": "遊戲開始了。啟用目前功能 10。正在"}, {"type": "subtitle", "time": 651.722, "timestamp": "00:10:51", "text": "登入。開始吧。"}, {"type": "subtitle", "time": 653.07, "timestamp": "00:10:53", "text": "[笑聲]"}]
[{"type": "subtitle", "time": 1320.27, "timestamp": "00:22:00", "text": "我們不如趁這段時間做點別的事吧"}, {"type": "subtitle", "time": 1321.91, "timestamp": "00:22:01", "text": "？把這個留下，我……"}, {"type": "subtitle", "time": 1323.95, "timestamp": "00:22:03", "text": "嗯。  好啊，好啊。"}, {"type": "subtitle", "time": 1327.15, "timestamp": "00:22:07", "text": "這真是個好主意。是的。我"}, {"type": "subtitle", "time": 1329.75, "timestamp": "00:22:09", "text": "應該檢查一下的。我本來可以睡"}, {"type": "subtitle", "time": 1332.23, "timestamp": "00:22:12", "text": "一會兒的。"}, {"type": "subtitle", "time": 1335.59, "timestamp": "00:22:15", "text": "我只睡了三、四個小時。"}, {"type": "subtitle", "time": 1338.31, "timestamp": "00:22:18", "text": "上午 10:30 至下午 2:00。我本來應該"}, {"type": "subtitle", "time": 1340.99, "timestamp": "00:22:20", "text": "提早一個小時直播，大概是凌晨 1 點。"}, {"type": "subtitle", "time": 1344.27, "timestamp": "00:22:24", "text": "當洪水閘門"}, {"type": "subtitle", "time": 1346.27, "timestamp": "00:22:26", "text": "打開的時候。"}, {"type": "subtitle", "time": 1348.79, "timestamp": "00:22:28", "text": "嗯，呃，"}, {"type": "subtitle", "time": 1352.23, "timestamp": "00:22:32", "text": "誰的"}, {"type": "subtitle", "time": 1353.43, "timestamp": "00:22:33", "text": "痛苦，"}, {"type": "subtitle", "time": 1362.03, "timestamp": "00:22:42", "text": "想像一下，如果，如果，如果"}, {"type": "subtitle", "time": 1367.79, "timestamp": "00:22:47", "text": "我們在這裡待了3個"}, {"type": "subtitle", "time": 1371.75, "timestamp": "00:22:51", "text": "小時，它仍然關著呢？香港時間凌晨1點？"}, {"type": "subtitle", "time": 1373.11, "timestamp": "00:22:53", "text": "是啊"}, {"type": "subtitle", "time": 1377.63, "timestamp": "00:22:57", "text": "，現在是凌晨1點。嗯，現在是凌晨2點32分。是啊"}]
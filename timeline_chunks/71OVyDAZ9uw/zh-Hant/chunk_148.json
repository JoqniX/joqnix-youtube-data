[{"type": "subtitle", "time": 8882.19, "timestamp": "02:28:02", "text": "熱點區域是一個漫遊 XP，在《戰爭之"}, {"type": "subtitle", "time": 8883.27, "timestamp": "02:28:03", "text": "犬》中是一個教學"}, {"type": "subtitle", "time": 8885.07, "timestamp": "02:28:05", "text": "。  我打算先做完"}, {"type": "subtitle", "time": 8889.67, "timestamp": "02:28:09", "text": "教程，然後就開始猛揍那玩意兒，就為了拿成就。  是的，我只需要一堆「嗯」。"}, {"type": "subtitle", "time": 8897.39, "timestamp": "02:28:17", "text": "哦，你好。歡迎。  你好，頂級"}, {"type": "subtitle", "time": 8900.03, "timestamp": "02:28:20", "text": "雜耍頻道。"}, {"type": "subtitle", "time": 8914.79, "timestamp": "02:28:34", "text": "歡迎。  遊戲怎麼樣？呃，或者你好嗎？我一切都很好。你好嗎？  我的天，遊戲卡頓了。哦，我的電腦運作緩慢。  你可以叫我土壤嗎？什麼？  沒事的"}]
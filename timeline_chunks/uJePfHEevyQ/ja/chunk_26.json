[{"type": "subtitle", "time": 1561.19, "timestamp": "00:26:01", "text": "レガシーパス。"}, {"type": "subtitle", "time": 1564.39, "timestamp": "00:26:04", "text": "レガシーパスでまだ"}, {"type": "subtitle", "time": 1568.789, "timestamp": "00:26:08", "text": "集めていないアイテムがたくさんあります。 私はこれらを持っていると思います。"}, {"type": "subtitle", "time": 1572.71, "timestamp": "00:26:12", "text": "できない。どうしてできないの？"}, {"type": "subtitle", "time": 1575.51, "timestamp": "00:26:15", "text": "でも、彼らは旧パスの機能を使うことを許可している"}, {"type": "subtitle", "time": 1590.47, "timestamp": "00:26:30", "text": "さらに4万人。 これは何ですか？ 複数の"}, {"type": "subtitle", "time": 1602.39, "timestamp": "00:26:42", "text": "レガシーパスは凍結したトレイルです。 パスを有効化してください"}, {"type": "subtitle", "time": 1609.99, "timestamp": "00:26:49", "text": "私はどの部品でも選ばなければならない。 わかった。"}, {"type": "subtitle", "time": 1612.47, "timestamp": "00:26:52", "text": "つまり、これらは無料のものだと思います。"}, {"type": "subtitle", "time": 1615.83, "timestamp": "00:26:55", "text": "グラップリングフック"}, {"type": "subtitle", "time": 1619.269, "timestamp": "00:26:59", "text": "ハーモニカこの"}]
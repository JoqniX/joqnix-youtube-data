[{"type": "subtitle", "time": 8282.87, "timestamp": "02:18:02", "text": "私は"}, {"type": "subtitle", "time": 8303.11, "timestamp": "02:18:23", "text": "アル、カメラを持っていくよ。 わかった。"}, {"type": "subtitle", "time": 8319.669, "timestamp": "02:18:39", "text": "ああ、試合が成立した。   さあ行こう"}, {"type": "subtitle", "time": 8322.23, "timestamp": "02:18:42", "text": "。 公園の件。 さあ行こう。 そうそう"}, {"type": "subtitle", "time": 8323.83, "timestamp": "02:18:43", "text": "。"}, {"type": "subtitle", "time": 8326.709, "timestamp": "02:18:46", "text": "私がカメラを持って行きます。"}, {"type": "subtitle", "time": 8337.509, "timestamp": "02:18:57", "text": "私たちは何かを作り出すだろう。"}]
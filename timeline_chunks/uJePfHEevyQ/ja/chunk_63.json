[{"type": "subtitle", "time": 3781.91, "timestamp": "01:03:01", "text": "海壁に発生している亀裂を写真に撮ってください。 北西部の、急な修理で"}, {"type": "subtitle", "time": 3784.95, "timestamp": "01:03:04", "text": "漏水しているパイプ付近の海岸線をサンプルとして採取した。"}, {"type": "subtitle", "time": 3786.95, "timestamp": "01:03:06", "text": "あの皇帝たちは十分に威厳があった。"}, {"type": "subtitle", "time": 3790.47, "timestamp": "01:03:10", "text": "クエストに必要な物資を除く。"}, {"type": "subtitle", "time": 3793.99, "timestamp": "01:03:13", "text": "外の橋のそばで、皇帝の像の写真を撮ってください。   以上です"}, {"type": "subtitle", "time": 3794.87, "timestamp": "01:03:14", "text": "。"}, {"type": "subtitle", "time": 3802.23, "timestamp": "01:03:22", "text": "アラトラ駅近くの皇帝の脚をお勧めします。"}, {"type": "subtitle", "time": 3804.71, "timestamp": "01:03:24", "text": "倒れた皇帝の周辺を偵察せよ。"}, {"type": "subtitle", "time": 3808.789, "timestamp": "01:03:28", "text": "おお、カメラが無料でもらえるんだ。 ああ、"}, {"type": "subtitle", "time": 3811.27, "timestamp": "01:03:31", "text": "これが必要だ。 ええと、文字通り何マイルも先まで。"}, {"type": "subtitle", "time": 3814.63, "timestamp": "01:03:34", "text": "ええ、それは本当です。 確かに、確かに、確かに。 ええ、その通りですね"}, {"type": "subtitle", "time": 3817.349, "timestamp": "01:03:37", "text": "。"}, {"type": "subtitle", "time": 3833.829, "timestamp": "01:03:53", "text": "と通過だ。"}, {"type": "subtitle", "time": 3836.63, "timestamp": "01:03:56", "text": "ああ、私が行くべき場所はここではないでしょうか？ よし、じゃあ"}]
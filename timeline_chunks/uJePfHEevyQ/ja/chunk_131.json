[{"type": "subtitle", "time": 7863.109, "timestamp": "02:11:03", "text": "思う。 俺は死んだんだ"}, {"type": "subtitle", "time": 7866.55, "timestamp": "02:11:06", "text": "。 私がプレイしたこの3、4試合は、毎回"}, {"type": "subtitle", "time": 7894.149, "timestamp": "02:11:34", "text": "勝利への希望を与えてくださっていない。 ああ、俺はもう死んでるよ。 ああ、私は"}, {"type": "subtitle", "time": 7896.95, "timestamp": "02:11:36", "text": "死んだ。 私には無理だと思います。 もし"}, {"type": "subtitle", "time": 7900.55, "timestamp": "02:11:40", "text": "救世主が現れたら、"}]
[{"type": "subtitle", "time": 1502.07, "timestamp": "00:25:02", "text": "遠征。"}, {"type": "subtitle", "time": 1527.669, "timestamp": "00:25:27", "text": "必須項目。"}, {"type": "subtitle", "time": 1532.47, "timestamp": "00:25:32", "text": "あ、待って。 この金額で彼にこれらの品物を売ることができます"}, {"type": "subtitle", "time": 1535.269, "timestamp": "00:25:35", "text": "。 ああ、"}, {"type": "subtitle", "time": 1538.549, "timestamp": "00:25:38", "text": "とても美味しい。 ペンダーラ峠には、幾度となく"}, {"type": "subtitle", "time": 1548.07, "timestamp": "00:25:48", "text": "だから、別の人に尋ねなければならない。"}, {"type": "subtitle", "time": 1550.31, "timestamp": "00:25:50", "text": "ああ、まだ探検隊がいるのか。 何てことだ"}, {"type": "subtitle", "time": 1558.31, "timestamp": "00:25:58", "text": "。 えっと、報酬パスって何ですか？"}]
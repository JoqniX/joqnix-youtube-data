[{"type": "subtitle", "time": 1898.63, "timestamp": "00:31:38", "text": "論理的に考えてくれるところが好きだよ。 もしそれが"}, {"type": "subtitle", "time": 1901.35, "timestamp": "00:31:41", "text": "その件に関してそれほど愚かな箱ではないなら"}, {"type": "subtitle", "time": 1904.389, "timestamp": "00:31:44", "text": "。 うん。 とにかく、試してみてください。"}, {"type": "subtitle", "time": 1907.029, "timestamp": "00:31:47", "text": "自分で学んでみよう。 情報があります。   世の中には色々なものがあるよね"}, {"type": "subtitle", "time": 1913.11, "timestamp": "00:31:53", "text": "？ ですから、必要であればそれを使っても構いません。"}, {"type": "subtitle", "time": 1916.63, "timestamp": "00:31:56", "text": "なあ、俺にはこれが必要なんだ。 いくらくらいの"}]
[{"type": "subtitle", "time": 6154.629, "timestamp": "01:42:34", "text": "これをキャプチャできないのでしょうか？"}, {"type": "subtitle", "time": 6156.39, "timestamp": "01:42:36", "text": "でも、自分で確認してみるのもいいですよ。"}, {"type": "subtitle", "time": 6158.629, "timestamp": "01:42:38", "text": "ええ、"}, {"type": "subtitle", "time": 6162.55, "timestamp": "01:42:42", "text": "本当にタイ人の手によるものでした。"}, {"type": "subtitle", "time": 6165.35, "timestamp": "01:42:45", "text": "正直、本当に大変だったよ。 コラボの件で、"}, {"type": "subtitle", "time": 6168.709, "timestamp": "01:42:48", "text": "システムを作る必要があったんだけど、"}, {"type": "subtitle", "time": 6179.51, "timestamp": "01:42:59", "text": "なんてこった？ どうやって"}]
[{"type": "subtitle", "time": 4145.11, "timestamp": "01:09:05", "text": "武器を手に持ってはいけないんだ、"}, {"type": "subtitle", "time": 4146.47, "timestamp": "01:09:06", "text": "おい。"}, {"type": "subtitle", "time": 4149.349, "timestamp": "01:09:09", "text": "私の心臓は鼓動していた。"}, {"type": "subtitle", "time": 4152.87, "timestamp": "01:09:12", "text": "男はどこからともなく"}, {"type": "subtitle", "time": 4156.47, "timestamp": "01:09:16", "text": "手榴弾を持って現れた。 彼は自分が弾薬の再装填者だと言っている。"}, {"type": "subtitle", "time": 4168.309, "timestamp": "01:09:28", "text": "、ただ"}, {"type": "subtitle", "time": 4176.87, "timestamp": "01:09:36", "text": "良い。"}, {"type": "subtitle", "time": 4188.789, "timestamp": "01:09:48", "text": "こういうゲームでは、確かにボイスチャットは"}, {"type": "subtitle", "time": 4191.11, "timestamp": "01:09:51", "text": "良いし、近接性も良いけど、"}, {"type": "subtitle", "time": 4197.27, "timestamp": "01:09:57", "text": "導入としては私にはやりすぎです。 じゃあ、また後で"}, {"type": "subtitle", "time": 4199.35, "timestamp": "01:09:59", "text": "ジョギングしよう。 こんにちは。 ありがとう。"}]
[{"type": "subtitle", "time": 3555.109, "timestamp": "00:59:15", "text": "うわー、"}, {"type": "subtitle", "time": 3559.27, "timestamp": "00:59:19", "text": "彼女、すごく綺麗だね。"}, {"type": "subtitle", "time": 3562.71, "timestamp": "00:59:22", "text": "つまり、買ってよかったと思っています。"}, {"type": "subtitle", "time": 3565.27, "timestamp": "00:59:25", "text": "でも、うん"}, {"type": "subtitle", "time": 3568.87, "timestamp": "00:59:28", "text": "、暑いね。 ほら、"}, {"type": "subtitle", "time": 3572.549, "timestamp": "00:59:32", "text": "夢だってことはわかってるよ。 まるで夢の国みたいだ。"}, {"type": "subtitle", "time": 3574.789, "timestamp": "00:59:34", "text": "誰もが"}, {"type": "subtitle", "time": 3577.349, "timestamp": "00:59:37", "text": "ここに来たいと思うだろうけど、"}, {"type": "subtitle", "time": 3581.03, "timestamp": "00:59:41", "text": "ここに来ると文字通り地獄だ。"}, {"type": "subtitle", "time": 3584.39, "timestamp": "00:59:44", "text": "はっきり言って、"}, {"type": "subtitle", "time": 3595.109, "timestamp": "00:59:55", "text": "大変だし、苦痛でもある。"}]
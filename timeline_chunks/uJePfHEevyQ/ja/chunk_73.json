[{"type": "subtitle", "time": 4414.149, "timestamp": "01:13:34", "text": "ああ、あなたは今日、人を不快にさせたり、マナーの"}, {"type": "subtitle", "time": 4419.03, "timestamp": "01:13:39", "text": "悪い言動をしたりしましたか？ いいえ、していません。"}, {"type": "subtitle", "time": 4422.95, "timestamp": "01:13:42", "text": "見知らぬ人が私を殺そうとした。"}, {"type": "subtitle", "time": 4426.07, "timestamp": "01:13:46", "text": "えっと、私が彼を撃ったとか言ってるけど、"}, {"type": "subtitle", "time": 4428.709, "timestamp": "01:13:48", "text": "私はそんなことしてない。"}]
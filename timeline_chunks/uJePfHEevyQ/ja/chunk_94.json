[{"type": "subtitle", "time": 5650.87, "timestamp": "01:34:10", "text": "Arc Raidersはどうですか？ うん、久しぶりに"}, {"type": "subtitle", "time": 5654.629, "timestamp": "01:34:14", "text": "プレイしたよ。"}, {"type": "subtitle", "time": 5657.35, "timestamp": "01:34:17", "text": "ええ、"}, {"type": "subtitle", "time": 5660.47, "timestamp": "01:34:20", "text": "日本に行ってからはアークレイダーズをプレイしなくなりました。   えーっと、"}, {"type": "subtitle", "time": 5665.99, "timestamp": "01:34:25", "text": "私は通常、"}, {"type": "subtitle", "time": 5677.27, "timestamp": "01:34:37", "text": "今年の3月まで演技をしますが、その後"}, {"type": "subtitle", "time": 5692.95, "timestamp": "01:34:52", "text": "ボブのヘアスタイルが欲しかったので、お金を無駄にしてしまいました"}, {"type": "subtitle", "time": 5696.31, "timestamp": "01:34:56", "text": "。"}]
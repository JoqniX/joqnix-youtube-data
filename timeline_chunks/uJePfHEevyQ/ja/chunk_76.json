[{"type": "subtitle", "time": 4566.47, "timestamp": "01:16:06", "text": "ああ、ステンシルね。 これは何ですか？ 興味深い"}, {"type": "subtitle", "time": 4568.229, "timestamp": "01:16:08", "text": "武器だ。 そろそろ、武器を本来あるべき姿に"}, {"type": "subtitle", "time": 4570.31, "timestamp": "01:16:10", "text": "美しく見せる時が来た。 これで、"}, {"type": "subtitle", "time": 4572.95, "timestamp": "01:16:12", "text": "武器や攻撃を発見して入手し、装備している"}, {"type": "subtitle", "time": 4575.189, "timestamp": "01:16:15", "text": "すべての銃を"}, {"type": "subtitle", "time": 4578.47, "timestamp": "01:16:18", "text": "自分のものとしてマークしたり、"}, {"type": "subtitle", "time": 4585.35, "timestamp": "01:16:25", "text": "ステンシル"}, {"type": "subtitle", "time": 4601.51, "timestamp": "01:16:41", "text": "私はこれを望んでいない。 ああ、"}, {"type": "subtitle", "time": 4603.99, "timestamp": "01:16:43", "text": "そんなつもりじゃなかったんです。 なんてこった。 えっと、"}, {"type": "subtitle", "time": 4613.27, "timestamp": "01:16:53", "text": "えっと、これとこれが必要です。 だから、"}, {"type": "subtitle", "time": 4616.229, "timestamp": "01:16:56", "text": "これを1000ドルで売ります。"}]
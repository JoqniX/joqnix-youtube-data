[{"type": "subtitle", "time": 2357.109, "timestamp": "00:39:17", "text": "。 それ、持ってますよね？ 私は"}, {"type": "subtitle", "time": 2361.109, "timestamp": "00:39:21", "text": "これを持っていることをよく忘れてしまう。"}, {"type": "subtitle", "time": 2365.19, "timestamp": "00:39:25", "text": "黒バージョンがいい感じですね。"}, {"type": "subtitle", "time": 2368.31, "timestamp": "00:39:28", "text": "ブルーオーシャンもいいですね。"}, {"type": "subtitle", "time": 2377.43, "timestamp": "00:39:37", "text": "胸当てが気に入った。"}, {"type": "subtitle", "time": 2387.829, "timestamp": "00:39:47", "text": "。 帽子"}, {"type": "subtitle", "time": 2391.109, "timestamp": "00:39:51", "text": "とゴーグルを外してください。"}, {"type": "subtitle", "time": 2393.27, "timestamp": "00:39:53", "text": "うん。 今はいい感じだよ。"}, {"type": "subtitle", "time": 2395.75, "timestamp": "00:39:55", "text": "圧縮するかしないか、どちらでも構わ"}]
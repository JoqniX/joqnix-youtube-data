[{"type": "subtitle", "time": 2405.99, "timestamp": "00:40:05", "text": "ああ、大丈夫ですよ。 わかった。 わかった。"}, {"type": "subtitle", "time": 2411.589, "timestamp": "00:40:11", "text": "えっと、"}, {"type": "subtitle", "time": 2415.43, "timestamp": "00:40:15", "text": "星とか何かあればよかったのに。"}, {"type": "subtitle", "time": 2417.349, "timestamp": "00:40:17", "text": "星とか何かマークがあればよかったのに。"}, {"type": "subtitle", "time": 2420.47, "timestamp": "00:40:20", "text": "それ、使ってみたいですね。"}, {"type": "subtitle", "time": 2425.589, "timestamp": "00:40:25", "text": "レイダーツール。 私は何をもらったの？ カスコ。   つるはしで"}, {"type": "subtitle", "time": 2451.43, "timestamp": "00:40:51", "text": "。 ええと、私たちは単独で行きます。 わかった。"}]
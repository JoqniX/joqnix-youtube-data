[{"type": "subtitle", "time": 2466.15, "timestamp": "00:41:06", "text": "待って、フリーロードアウト。 ああ、無料ロードアウトを忘れてた"}, {"type": "subtitle", "time": 2468.069, "timestamp": "00:41:08", "text": "。 それをクリックしないといけない。 ああ、"}, {"type": "subtitle", "time": 2472.55, "timestamp": "00:41:12", "text": "忘れてた。 忘れ続けろ。 ああ、なんてこった"}, {"type": "subtitle", "time": 2475.43, "timestamp": "00:41:15", "text": "。 誰かがそれを止めた"}, {"type": "subtitle", "time": 2479.75, "timestamp": "00:41:19", "text": "。 本当に、一文無しなんです。"}, {"type": "subtitle", "time": 2487.67, "timestamp": "00:41:27", "text": "、俺はたった今4000ドルも使ってしまった。 つまり、いくらですか"}, {"type": "subtitle", "time": 2491.589, "timestamp": "00:41:31", "text": "？ くそっ。"}, {"type": "subtitle", "time": 2499.27, "timestamp": "00:41:39", "text": "何を計算すればいいの？ ちょっと計算させてください。"}, {"type": "subtitle", "time": 2508.95, "timestamp": "00:41:48", "text": "6くらいまで戻れるはずなのに。 いいえ。"}, {"type": "subtitle", "time": 2515.27, "timestamp": "00:41:55", "text": "まあ、使い続けてください。"}, {"type": "subtitle", "time": 2517.51, "timestamp": "00:41:57", "text": "あなたはクレジットカードの利用限度額の80%を使用しました"}]
[{"type": "subtitle", "time": 9960.469, "timestamp": "02:46:00", "text": "電池クリップは要りません。 エナジー"}, {"type": "subtitle", "time": 9962.63, "timestamp": "02:46:02", "text": "クラブ。"}, {"type": "subtitle", "time": 9965.19, "timestamp": "02:46:05", "text": "待って、エネルギークリップを買って売って売って売って売る方法を修正したの？それで"}, {"type": "subtitle", "time": 9972.07, "timestamp": "02:46:12", "text": "大儲けできるよ。"}, {"type": "subtitle", "time": 9980.15, "timestamp": "02:46:20", "text": "アークレイアーの現在のトレンドやメタとか、そういうのを知っておかないといけないんだけど、知る必要はないんだよね。でも、"}, {"type": "subtitle", "time": 9995.75, "timestamp": "02:46:35", "text": "すごくかっこいいスパイ"}, {"type": "subtitle", "time": 9997.91, "timestamp": "02:46:37", "text": "グラスなんだ。"}, {"type": "subtitle", "time": 10001.99, "timestamp": "02:46:41", "text": "山岳救助用装備。"}, {"type": "subtitle", "time": 10019.19, "timestamp": "02:46:59", "text": "車輪は、斧のベーラーが"}]
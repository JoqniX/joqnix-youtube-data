[{"type": "subtitle", "time": 8179.75, "timestamp": "02:16:19", "text": "えっと、"}, {"type": "subtitle", "time": 8182.39, "timestamp": "02:16:22", "text": "あ、待って、ここにはハッシュキーがないよ"}, {"type": "subtitle", "time": 8185.27, "timestamp": "02:16:25", "text": "。 えっと、何か見落としているところがあるのか​​な？   何を持っていけばいいですか"}, {"type": "subtitle", "time": 8189.51, "timestamp": "02:16:29", "text": "？"}, {"type": "subtitle", "time": 8193.349, "timestamp": "02:16:33", "text": "えっと、手榴弾。 わかった。"}, {"type": "subtitle", "time": 8195.349, "timestamp": "02:16:35", "text": "えっと、"}, {"type": "subtitle", "time": 8198.79, "timestamp": "02:16:38", "text": "サーモグレネード。 わかった、いいよ。"}, {"type": "subtitle", "time": 8202.23, "timestamp": "02:16:42", "text": "カメラを持って行って写真を撮った方がいいでしょうか？   わからない"}, {"type": "subtitle", "time": 8204.95, "timestamp": "02:16:44", "text": "。   えーっと、"}, {"type": "subtitle", "time": 8217.99, "timestamp": "02:16:57", "text": "よし、行こう。 今、お見せします。 ボスである"}]
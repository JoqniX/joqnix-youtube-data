[{"type": "subtitle", "time": 9434.23, "timestamp": "02:37:14", "text": "ああ、わかった。 ええと、そろそろ終わりにしましょう。"}, {"type": "subtitle", "time": 9436.71, "timestamp": "02:37:16", "text": "では、次にプレイするときは、他に何をすればいいのでしょうか"}, {"type": "subtitle", "time": 9439.03, "timestamp": "02:37:19", "text": "？ 私たちは主にクエストをこなします。"}, {"type": "subtitle", "time": 9440.55, "timestamp": "02:37:20", "text": "我々は攻撃陣を強化しなければならなかったが、"}, {"type": "subtitle", "time": 9443.429, "timestamp": "02:37:23", "text": "守備陣の多くはトップレベルだ。"}, {"type": "subtitle", "time": 9446.87, "timestamp": "02:37:26", "text": "業務だけの問題ではない。"}, {"type": "subtitle", "time": 9448.55, "timestamp": "02:37:28", "text": "私は"}, {"type": "subtitle", "time": 9450.95, "timestamp": "02:37:30", "text": "チューブがあなたを捕まえることはないだろう。   わかった"}, {"type": "subtitle", "time": 9461.83, "timestamp": "02:37:41", "text": "次の報酬は1,000ドルです。"}, {"type": "subtitle", "time": 9464.309, "timestamp": "02:37:44", "text": "えっと、"}, {"type": "subtitle", "time": 9468.469, "timestamp": "02:37:48", "text": "全部投稿すると、"}, {"type": "subtitle", "time": 9473.75, "timestamp": "02:37:53", "text": "さらに135ドル獲得できます。"}]
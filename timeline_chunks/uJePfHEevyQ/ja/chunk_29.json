[{"type": "subtitle", "time": 1750.389, "timestamp": "00:29:10", "text": "日本語って本当に難しいのか？ うーん、それは"}, {"type": "subtitle", "time": 1752.789, "timestamp": "00:29:12", "text": "学ぶ人によりますね。"}, {"type": "subtitle", "time": 1762.07, "timestamp": "00:29:22", "text": "うん。 待って、私が探しているヘアスタイルはどこにあるの"}, {"type": "subtitle", "time": 1768.95, "timestamp": "00:29:28", "text": "それは坊主頭の髪型だ。"}, {"type": "subtitle", "time": 1769.669, "timestamp": "00:29:29", "text": "何？"}, {"type": "subtitle", "time": 1775.99, "timestamp": "00:29:35", "text": "ちょっと待って。 そのヘアスタイルはどこにあるの？"}, {"type": "subtitle", "time": 1781.909, "timestamp": "00:29:41", "text": "チャチャチャチャチャ。"}, {"type": "subtitle", "time": 1784.63, "timestamp": "00:29:44", "text": "襲撃者の声は、いつもこんな感じだったのだろうか"}, {"type": "subtitle", "time": 1796.07, "timestamp": "00:29:56", "text": "プレミアム一時停止。 待って、報酬パスをもう"}, {"type": "subtitle", "time": 1799.51, "timestamp": "00:29:59", "text": "一つ入手してプレミアムパスを集めよう。"}]
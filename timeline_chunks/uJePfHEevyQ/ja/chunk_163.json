[{"type": "subtitle", "time": 9782.469, "timestamp": "02:43:02", "text": "ああ、これはいいですね。"}, {"type": "subtitle", "time": 9788.71, "timestamp": "02:43:08", "text": "ローマまたは"}, {"type": "subtitle", "time": 9800.07, "timestamp": "02:43:20", "text": "あれはターミネーター2.0みたいだ。"}, {"type": "subtitle", "time": 9803.75, "timestamp": "02:43:23", "text": "私はこのセットを持っています。"}, {"type": "subtitle", "time": 9815.11, "timestamp": "02:43:35", "text": "白と青はいいんだけど、"}, {"type": "subtitle", "time": 9818.07, "timestamp": "02:43:38", "text": "黄色っぽいところがあるんだよね。 だから私は"}, {"type": "subtitle", "time": 9820.469, "timestamp": "02:43:40", "text": "青を選んだんです。   私は"}, {"type": "subtitle", "time": 9824.309, "timestamp": "02:43:44", "text": "ボブヘアにしました。 ええ、そうですね。"}, {"type": "subtitle", "time": 9827.91, "timestamp": "02:43:47", "text": "歌舞伎の化粧も素敵ですね。 その中に"}, {"type": "subtitle", "time": 9831.11, "timestamp": "02:43:51", "text": "バンジョーの設計図が入っていた。"}, {"type": "subtitle", "time": 9834.309, "timestamp": "02:43:54", "text": "ドラゴンの友達。 ああ、ステンシルか。 あ、待って。"}, {"type": "subtitle", "time": 9837.91, "timestamp": "02:43:57", "text": "ステンシルを持っています。"}]
[{"type": "subtitle", "time": 2959.829, "timestamp": "00:49:19", "text": "興味があれば、良いゲームを。"}, {"type": "subtitle", "time": 2962.87, "timestamp": "00:49:22", "text": "ええ、もちろんです。 頑張れ。"}, {"type": "subtitle", "time": 2965.109, "timestamp": "00:49:25", "text": "問題は、今はハロウィンの季節ではないということだ"}, {"type": "subtitle", "time": 2967.349, "timestamp": "00:49:27", "text": "。"}, {"type": "subtitle", "time": 2976.549, "timestamp": "00:49:36", "text": "ハロウィンの季節だから、"}, {"type": "subtitle", "time": 2978.63, "timestamp": "00:49:38", "text": "ハロウィンのことをしなくちゃいけないんだよね"}, {"type": "subtitle", "time": 2981.349, "timestamp": "00:49:41", "text": "。 うがい。 ああ、"}, {"type": "subtitle", "time": 2995.75, "timestamp": "00:49:55", "text": "ホラーゲームは怖いんです。"}, {"type": "subtitle", "time": 2997.43, "timestamp": "00:49:57", "text": "そこが問題なんです。 私はホラー"}]
[{"type": "subtitle", "time": 7082.47, "timestamp": "01:58:02", "text": "コミュニティにいるので、私は"}, {"type": "subtitle", "time": 7086.229, "timestamp": "01:58:06", "text": "ほとんど活動していないし、"}, {"type": "subtitle", "time": 7091.27, "timestamp": "01:58:11", "text": "INVT コミュニティを見たり、"}, {"type": "subtitle", "time": 7093.91, "timestamp": "01:58:13", "text": "誰かと話したりもしていません"}, {"type": "subtitle", "time": 7096.55, "timestamp": "01:58:16", "text": "。 私は自分の"}, {"type": "subtitle", "time": 7109.27, "timestamp": "01:58:29", "text": "つまり、再生は良いことだ。 再生を確認してください。"}, {"type": "subtitle", "time": 7114.07, "timestamp": "01:58:34", "text": "えっと、ある地域を調べてみると、"}, {"type": "subtitle", "time": 7118.55, "timestamp": "01:58:38", "text": "最近見つけたインドでは、この2人が"}, {"type": "subtitle", "time": 7124.31, "timestamp": "01:58:44", "text": "デュオになっているんです。 彼らは、ええと、こんにちは"}, {"type": "subtitle", "time": 7128.47, "timestamp": "01:58:48", "text": "ジョーン、"}, {"type": "subtitle", "time": 7132.629, "timestamp": "01:58:52", "text": "ストリームへようこそ。 彼らは、えっと、なんて"}, {"type": "subtitle", "time": 7138.07, "timestamp": "01:58:58", "text": "言うんだっけ？ キャラクター"}]
[{"type": "subtitle", "time": 8121.27, "timestamp": "02:15:21", "text": "包帯"}, {"type": "subtitle", "time": 8148.39, "timestamp": "02:15:48", "text": "私は生存者を持っています。そして、私はたくさんの"}, {"type": "subtitle", "time": 8150.95, "timestamp": "02:15:50", "text": "生存者を持っています。 今はリスクを冒すべきではない。   もし"}, {"type": "subtitle", "time": 8155.03, "timestamp": "02:15:55", "text": "誰かが私を悼むだけだったらどうなるだろう？   それは私には"}]
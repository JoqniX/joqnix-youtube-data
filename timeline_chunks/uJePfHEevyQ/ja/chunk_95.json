[{"type": "subtitle", "time": 5711.11, "timestamp": "01:35:11", "text": "クリエイティブ作品をプレイするのは久しぶりだ。"}, {"type": "subtitle", "time": 5713.83, "timestamp": "01:35:13", "text": "PCに移行してからはプレイしなくなりました。 ああ、"}, {"type": "subtitle", "time": 5715.91, "timestamp": "01:35:15", "text": "少し前に宇宙港に偵察チームを派遣したんだ"}, {"type": "subtitle", "time": 5718.55, "timestamp": "01:35:18", "text": "。 日常業務として、セキュリティ関連の資料を整理し、何か"}, {"type": "subtitle", "time": 5722.79, "timestamp": "01:35:22", "text": "読めるものがないか確認していた。 彼らは「ヘイ、レイダー」を使っていた。"}, {"type": "subtitle", "time": 5725.189, "timestamp": "01:35:25", "text": "どうしたの？ 何か"}, {"type": "subtitle", "time": 5743.35, "timestamp": "01:35:43", "text": "いくつか場所があります。"}, {"type": "subtitle", "time": 5746.95, "timestamp": "01:35:46", "text": "アークは昔から我々の敵だった。"}, {"type": "subtitle", "time": 5749.03, "timestamp": "01:35:49", "text": "問題が一つ残っている。 日時計の一つを"}, {"type": "subtitle", "time": 5750.95, "timestamp": "01:35:50", "text": "清掃のために設置した。   一人ぼっちにされた"}, {"type": "subtitle", "time": 5751.51, "timestamp": "01:35:51", "text": "。"}, {"type": "subtitle", "time": 5754.47, "timestamp": "01:35:54", "text": "これは時間が経てば解消されるものだろうか。"}, {"type": "subtitle", "time": 5755.189, "timestamp": "01:35:55", "text": "私たちは"}, {"type": "subtitle", "time": 5756.629, "timestamp": "01:35:56", "text": "商人を好きになれない。"}, {"type": "subtitle", "time": 5757.43, "timestamp": "01:35:57", "text": "最高潮にまで高めろ。"}]
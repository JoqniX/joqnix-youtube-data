[{"type": "subtitle", "time": 5884.79, "timestamp": "01:38:04", "text": "言うんだっけ、レスキューキットがないって？"}, {"type": "subtitle", "time": 5887.109, "timestamp": "01:38:07", "text": "この「"}, {"type": "subtitle", "time": 5891.669, "timestamp": "01:38:11", "text": "安静注射用医療キット」とは何ですか？ うん、"}, {"type": "subtitle", "time": 5902.31, "timestamp": "01:38:22", "text": "最近は配信したいと思ってたんだけど、"}, {"type": "subtitle", "time": 5910.39, "timestamp": "01:38:30", "text": "配信のための裏方作業、つまり"}, {"type": "subtitle", "time": 5913.35, "timestamp": "01:38:33", "text": "舞台裏の作業ばかりしてたんだ。"}, {"type": "subtitle", "time": 5917.99, "timestamp": "01:38:37", "text": "えーと、ウェブサイト関連の作業をしたり、"}, {"type": "subtitle", "time": 5920.709, "timestamp": "01:38:40", "text": "コーディング関連の作業をたくさんしたりしています。"}, {"type": "subtitle", "time": 5923.189, "timestamp": "01:38:43", "text": "コーディングは知らないのですが、私がやっていて、"}, {"type": "subtitle", "time": 5927.43, "timestamp": "01:38:47", "text": "彼らは私のアイデアを投入して、私の"}, {"type": "subtitle", "time": 5937.109, "timestamp": "01:38:57", "text": "もののためにコーディングをしようとしています。"}, {"type": "subtitle", "time": 5939.91, "timestamp": "01:38:59", "text": "ええ、最近はそれで"}]
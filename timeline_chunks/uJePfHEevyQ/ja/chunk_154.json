[{"type": "subtitle", "time": 9269.27, "timestamp": "02:34:29", "text": "。 えっと、"}, {"type": "subtitle", "time": 9272.95, "timestamp": "02:34:32", "text": "待ってください。"}, {"type": "subtitle", "time": 9276.95, "timestamp": "02:34:36", "text": "私の声が彼女を完全に打ちのめしてしまったので、もう終わりにしてもいいですよ。"}, {"type": "subtitle", "time": 9297.349, "timestamp": "02:34:57", "text": "1つのウルフパックを持つ興味深い複数のアークデストロイヤー。 こんにちは、アリッサさん。ようこそ。"}]
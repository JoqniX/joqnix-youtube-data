[{"type": "subtitle", "time": 9192.15, "timestamp": "02:33:12", "text": "ええと、ファイアーボール・ボナーが必要だと思う"}, {"type": "subtitle", "time": 9220.79, "timestamp": "02:33:40", "text": "よし、これは良い取引だった。"}, {"type": "subtitle", "time": 9224.07, "timestamp": "02:33:44", "text": "ドライバーみたいなのを手に入れたよ。"}, {"type": "subtitle", "time": 9231.91, "timestamp": "02:33:51", "text": "ええ、あれは成功した襲撃でした。 しかし、"}, {"type": "subtitle", "time": 9234.55, "timestamp": "02:33:54", "text": "ボスを倒すことはできなかった。"}]
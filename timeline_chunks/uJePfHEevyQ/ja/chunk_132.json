[{"type": "subtitle", "time": 7929.109, "timestamp": "02:12:09", "text": "本日はこれで終了です。"}, {"type": "subtitle", "time": 7941.99, "timestamp": "02:12:21", "text": "私の配信はどうでしたか？ 配信は良かったよ。"}, {"type": "subtitle", "time": 7944.79, "timestamp": "02:12:24", "text": "お買い得ショップ。"}, {"type": "subtitle", "time": 7947.83, "timestamp": "02:12:27", "text": "私はそれを前日に済ませました。 一昨日だったと思います"}, {"type": "subtitle", "time": 7950.629, "timestamp": "02:12:30", "text": "。 うん。 えっと、明日は"}, {"type": "subtitle", "time": 7953.27, "timestamp": "02:12:33", "text": "アトロの配信になります。"}, {"type": "subtitle", "time": 7957.109, "timestamp": "02:12:37", "text": "アプリをテストする必要がある。   えーと、リ"}, {"type": "subtitle", "time": 7964.95, "timestamp": "02:12:44", "text": "ブランディングが完了して、"}, {"type": "subtitle", "time": 7967.03, "timestamp": "02:12:47", "text": "私が追加するように言った多くの新機能が追加されました"}, {"type": "subtitle", "time": 7970.47, "timestamp": "02:12:50", "text": "。 ええと、ほとんどのバグ修正は"}, {"type": "subtitle", "time": 7974.31, "timestamp": "02:12:54", "text": "パッチで対応済みです。 私が発見したバグのほとんどは"}, {"type": "subtitle", "time": 7978.149, "timestamp": "02:12:58", "text": "既に修正されていると思っていました。"}]
[{"type": "subtitle", "time": 4026.789, "timestamp": "01:07:06", "text": "我々には何があるだろうか？ 破損したパラシュート。   必要ない。"}, {"type": "subtitle", "time": 4048.069, "timestamp": "01:07:28", "text": "うん。 つまり、私が今直面している主な問題は、"}, {"type": "subtitle", "time": 4050.23, "timestamp": "01:07:30", "text": "お金の問題なんです。"}, {"type": "subtitle", "time": 4053.67, "timestamp": "01:07:33", "text": "それ以外では、ここは良い場所です"}, {"type": "subtitle", "time": 4061.19, "timestamp": "01:07:41", "text": "おい、撃たないでくれ。 私は初心者です。 私は"}, {"type": "subtitle", "time": 4063.43, "timestamp": "01:07:43", "text": "このゲームは初めてです。 撃たないでください。 すみません、"}, {"type": "subtitle", "time": 4071.27, "timestamp": "01:07:51", "text": "何？ 今、ここにスポーンしました。 どういう"}, {"type": "subtitle", "time": 4073.589, "timestamp": "01:07:53", "text": "意味ですか？ 私は誰にも発砲していません。 俺が"}, {"type": "subtitle", "time": 4074.15, "timestamp": "01:07:54", "text": "略奪してるのは、"}, {"type": "subtitle", "time": 4076.63, "timestamp": "01:07:56", "text": "俺を撃った奴と全く同じことだろ"}, {"type": "subtitle", "time": 4078.789, "timestamp": "01:07:58", "text": "？ 証拠はありますか？"}]
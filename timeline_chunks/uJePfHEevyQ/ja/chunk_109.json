[{"type": "subtitle", "time": 6540.31, "timestamp": "01:49:00", "text": "ガイドラインページなど、すべてを作り直しました。それから他に何をしたかって"}, {"type": "subtitle", "time": 6543.03, "timestamp": "01:49:03", "text": "？ はい、ガイドラインページの情報"}, {"type": "subtitle", "time": 6546.95, "timestamp": "01:49:06", "text": "ページが以前より読みやすくなりました。   ああ"}, {"type": "subtitle", "time": 6549.35, "timestamp": "01:49:09", "text": "、ロケット兵が2人いる。"}, {"type": "subtitle", "time": 6551.51, "timestamp": "01:49:11", "text": "あれはロケット乗りだ。"}, {"type": "subtitle", "time": 6554.39, "timestamp": "01:49:14", "text": "ビーチマップ。 そう、リヴェン・タイズだ。"}, {"type": "subtitle", "time": 6557.03, "timestamp": "01:49:17", "text": "このマップでプレイするのは初めてです。"}, {"type": "subtitle", "time": 6582.629, "timestamp": "01:49:42", "text": "24時間放送のチャンネルも知らない。 えっと、"}, {"type": "subtitle", "time": 6585.27, "timestamp": "01:49:45", "text": "ジョー、"}, {"type": "subtitle", "time": 6587.75, "timestamp": "01:49:47", "text": "YouTube、Twitch、そして24時間"}, {"type": "subtitle", "time": 6589.43, "timestamp": "01:49:49", "text": "365日配信の"}, {"type": "subtitle", "time": 6591.43, "timestamp": "01:49:51", "text": "チャンネルでチャットが無効になっているのはなぜだろう、と疑問に思っているかもしれませんね。 なぜなら、今は"}, {"type": "subtitle", "time": 6594.95, "timestamp": "01:49:54", "text": "適当なグラフィックボットとか誰かが"}, {"type": "subtitle", "time": 6599.35, "timestamp": "01:49:59", "text": "無差別にスパム投稿するのを避けたいからです。 チャットの"}]
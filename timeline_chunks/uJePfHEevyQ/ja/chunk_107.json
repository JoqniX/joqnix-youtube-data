[{"type": "subtitle", "time": 6421.43, "timestamp": "01:47:01", "text": "以前は"}, {"type": "subtitle", "time": 6423.91, "timestamp": "01:47:03", "text": "サミーの地元で全て作っていました。 それから全てを"}, {"type": "subtitle", "time": 6425.59, "timestamp": "01:47:05", "text": "Cloudflareに移行しました。"}, {"type": "subtitle", "time": 6429.51, "timestamp": "01:47:09", "text": "うん。 ええ、14日ごとに"}, {"type": "subtitle", "time": 6433.83, "timestamp": "01:47:13", "text": "新しいコンテンツサイクルが採用されます。 えっと、3つか"}, {"type": "subtitle", "time": 6437.03, "timestamp": "01:47:17", "text": "4つのプレイリストに加えて、その他はすべて"}, {"type": "subtitle", "time": 6439.91, "timestamp": "01:47:19", "text": "ランダムになります。 ええと、10本の動画からなる4つのプレイリストの後です"}, {"type": "subtitle", "time": 6442.629, "timestamp": "01:47:22", "text": "。"}, {"type": "subtitle", "time": 6447.03, "timestamp": "01:47:27", "text": "つまり、10、20、30、40 本の動画の後、40 本の動画が"}, {"type": "subtitle", "time": 6452.79, "timestamp": "01:47:32", "text": "そうですね、それは"}, {"type": "subtitle", "time": 6456.47, "timestamp": "01:47:36", "text": "プレイリストにそのような動画がいくつ含まれているかによります。 うん。"}, {"type": "subtitle", "time": 6459.75, "timestamp": "01:47:39", "text": "そのため、"}, {"type": "subtitle", "time": 6463.59, "timestamp": "01:47:43", "text": "プレイリストには 90 本の動画があり、"}, {"type": "subtitle", "time": 6466.39, "timestamp": "01:47:46", "text": "再生できない動画がある場合は"}, {"type": "subtitle", "time": 6472.39, "timestamp": "01:47:52", "text": "自動的にスキップされます。14 日ごとに"}, {"type": "subtitle", "time": 6476.709, "timestamp": "01:47:56", "text": "JST の午前 12 時になると更新され、新しい"}, {"type": "subtitle", "time": 6478.87, "timestamp": "01:47:58", "text": "プレイリストが自動的に再読み込みされ、"}]
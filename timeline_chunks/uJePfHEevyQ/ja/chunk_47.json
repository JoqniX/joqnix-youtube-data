[{"type": "subtitle", "time": 2822.87, "timestamp": "00:47:02", "text": "ワログをプレイしたかった。 えーと、ワログスは"}, {"type": "subtitle", "time": 2825.75, "timestamp": "00:47:05", "text": "新シーズン2が公開される15日に登場します。"}, {"type": "subtitle", "time": 2827.75, "timestamp": "00:47:07", "text": "プレイします。"}, {"type": "subtitle", "time": 2829.829, "timestamp": "00:47:09", "text": "ワログスは新"}, {"type": "subtitle", "time": 2831.19, "timestamp": "00:47:11", "text": "シーズンが始まるとプレイされる予定です。 それは"}, {"type": "subtitle", "time": 2833.829, "timestamp": "00:47:13", "text": "誤解です。 ああ、わかりました。   えっと、えっと、ああ、"}, {"type": "subtitle", "time": 2838.95, "timestamp": "00:47:18", "text": "正しいカテゴリーにいるんですね。 怖かった。 ここに来て"}, {"type": "subtitle", "time": 2868.95, "timestamp": "00:47:48", "text": "R2でリロード。 謝る必要はない。 すべて"}]
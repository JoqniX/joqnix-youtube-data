[{"type": "subtitle", "time": 6182.39, "timestamp": "01:43:02", "text": "あなたは追放されたのですか？ なんてこった？ 魂。"}, {"type": "subtitle", "time": 6189.91, "timestamp": "01:43:09", "text": "誰が剣の魂を禁じたのか？ なんてこった"}, {"type": "subtitle", "time": 6193.27, "timestamp": "01:43:13", "text": "？ あなたは2x7ストリーム用に別のアカウントを作成しました"}, {"type": "subtitle", "time": 6194.79, "timestamp": "01:43:14", "text": "。"}, {"type": "subtitle", "time": 6197.91, "timestamp": "01:43:17", "text": "私はいつも2x47配信用に別のアカウントを持っていました"}, {"type": "subtitle", "time": 6201.03, "timestamp": "01:43:21", "text": "。 ところで、どうしてアカウント停止になったの"}, {"type": "subtitle", "time": 6204.229, "timestamp": "01:43:24", "text": "？ 一体どういうことだよ、"}, {"type": "subtitle", "time": 6207.27, "timestamp": "01:43:27", "text": "兄弟？"}, {"type": "subtitle", "time": 6212.47, "timestamp": "01:43:32", "text": "私が見ていなかったら、どうやってそれを手に入れたんですか？ 何てことだ。 もし私が"}, {"type": "subtitle", "time": 6215.75, "timestamp": "01:43:35", "text": "それを見ていなかったら、そうですよね？ 何てことだ。 どうやって"}, {"type": "subtitle", "time": 6218.149, "timestamp": "01:43:38", "text": "アカウント停止を解除されたのですか？ なんてこった。 どうしてアカウント"}, {"type": "subtitle", "time": 6220.79, "timestamp": "01:43:40", "text": "停止になったのですか？ なんてこった？   あれは"}, {"type": "subtitle", "time": 6223.83, "timestamp": "01:43:43", "text": "一体どのオートモードだったっけ？ え、"}, {"type": "subtitle", "time": 6226.229, "timestamp": "01:43:46", "text": "何これ？"}, {"type": "subtitle", "time": 6227.83, "timestamp": "01:43:47", "text": "確認してみます。 確認してみます。"}, {"type": "subtitle", "time": 6230.87, "timestamp": "01:43:50", "text": "その側面はどうなったのですか？ 私は、"}, {"type": "subtitle", "time": 6238.95, "timestamp": "01:43:58", "text": "面白い。 何？ どうしてアカウント"}]
[{"type": "subtitle", "time": 7140.709, "timestamp": "01:59:00", "text": "デザイン、そしてモデルによる飲酒。 うん、"}, {"type": "subtitle", "time": 7144.07, "timestamp": "01:59:04", "text": "モデルのリギングとか色々ね。 それでいいでしょう"}, {"type": "subtitle", "time": 7147.109, "timestamp": "01:59:07", "text": "。 やってみるしかないでしょう"}, {"type": "subtitle", "time": 7149.83, "timestamp": "01:59:09", "text": "。 ええ、でもやはり値段が"}, {"type": "subtitle", "time": 7151.51, "timestamp": "01:59:11", "text": "高いのは"}, {"type": "subtitle", "time": 7153.83, "timestamp": "01:59:13", "text": "高いですね。"}, {"type": "subtitle", "time": 7157.109, "timestamp": "01:59:17", "text": "お友達には、まずは"}, {"type": "subtitle", "time": 7159.91, "timestamp": "01:59:19", "text": "無料モデルから始めてみるように勧めてみてはどうでしょうか。"}, {"type": "subtitle", "time": 7163.189, "timestamp": "01:59:23", "text": "コンテンツ制作を行う。"}, {"type": "subtitle", "time": 7165.99, "timestamp": "01:59:25", "text": "彼が長期的に取り組むか、趣味として取り組むかなど、何かを試してみます"}, {"type": "subtitle", "time": 7170.95, "timestamp": "01:59:30", "text": "。"}, {"type": "subtitle", "time": 7172.47, "timestamp": "01:59:32", "text": "えーと、それから、えーと、"}, {"type": "subtitle", "time": 7180.39, "timestamp": "01:59:40", "text": "十分な"}, {"type": "subtitle", "time": 7182.87, "timestamp": "01:59:42", "text": "視聴者とすべてが揃って、"}, {"type": "subtitle", "time": 7189.589, "timestamp": "01:59:49", "text": "ストリームやコンテンツから十分な収益が得られるようになったら、"}, {"type": "subtitle", "time": 7192.629, "timestamp": "01:59:52", "text": "カスタムモデル関連のことをする方が"}, {"type": "subtitle", "time": 7195.03, "timestamp": "01:59:55", "text": "良い方法です。"}, {"type": "subtitle", "time": 7197.35, "timestamp": "01:59:57", "text": "ミラノでは話せません。 私は弱っている、"}]
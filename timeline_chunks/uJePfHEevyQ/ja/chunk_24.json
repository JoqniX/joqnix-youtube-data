[{"type": "subtitle", "time": 1441.75, "timestamp": "00:24:01", "text": "ああ、報酬、カメラ、椅子、そして"}, {"type": "subtitle", "time": 1446.789, "timestamp": "00:24:06", "text": "光沢がある。"}, {"type": "subtitle", "time": 1450.07, "timestamp": "00:24:10", "text": "閲覧したいですか？ 大丈夫。"}, {"type": "subtitle", "time": 1452.789, "timestamp": "00:24:12", "text": "カメラだけは使わないでください。 ああ、そうそう、"}, {"type": "subtitle", "time": 1455.35, "timestamp": "00:24:15", "text": "少し前からカメラが使えるようになってたよ。"}, {"type": "subtitle", "time": 1458.23, "timestamp": "00:24:18", "text": "それを忘れていました。"}, {"type": "subtitle", "time": 1459.909, "timestamp": "00:24:19", "text": "それらの皇帝たちは、遠くから見ても十分に威厳があった"}, {"type": "subtitle", "time": 1463.11, "timestamp": "00:24:23", "text": "。 しかし、"}, {"type": "subtitle", "time": 1475.35, "timestamp": "00:24:35", "text": "コスメ"}, {"type": "subtitle", "time": 1480.07, "timestamp": "00:24:40", "text": "アイテムとは何ですか？ わかった。 レイダーも7万ドルで。"}, {"type": "subtitle", "time": 1483.669, "timestamp": "00:24:43", "text": "7万円。 君なら分かるよ。"}]
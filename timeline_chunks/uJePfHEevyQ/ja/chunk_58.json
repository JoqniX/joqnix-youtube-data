[{"type": "subtitle", "time": 3483.109, "timestamp": "00:58:03", "text": "私は死んだ。 いや、いや。"}, {"type": "subtitle", "time": 3485.91, "timestamp": "00:58:05", "text": "誰か助けてください。 お願いします。"}, {"type": "subtitle", "time": 3488.549, "timestamp": "00:58:08", "text": "お願いします。   なんてこった。"}, {"type": "subtitle", "time": 3493.75, "timestamp": "00:58:13", "text": "私はそれを見なかった。   ああ"}, {"type": "subtitle", "time": 3497.589, "timestamp": "00:58:17", "text": "、いやだ"}, {"type": "subtitle", "time": 3503.03, "timestamp": "00:58:23", "text": "。 うまく逃げられたはずなのに、一体どうやって"}, {"type": "subtitle", "time": 3508.87, "timestamp": "00:58:28", "text": "生き延びられるんだろう？ いいえ。"}, {"type": "subtitle", "time": 3512.549, "timestamp": "00:58:32", "text": "エクストラはこちらです。 ああ、"}, {"type": "subtitle", "time": 3518.87, "timestamp": "00:58:38", "text": "私が持っていたものはもう全部なくなってしまった。 ああ、"}, {"type": "subtitle", "time": 3521.19, "timestamp": "00:58:41", "text": "ずっと日本で働いて暮らすことを夢見てきたんだ"}, {"type": "subtitle", "time": 3535.91, "timestamp": "00:58:55", "text": "ああ、これは最悪だ。 私は降参してもいいと思う"}]
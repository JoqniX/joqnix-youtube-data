[{"type": "subtitle", "time": 6060.07, "timestamp": "01:41:00", "text": "どうすればいいの？ あ、キーボードが日本語になってる。"}, {"type": "subtitle", "time": 6061.75, "timestamp": "01:41:01", "text": "つまり、"}, {"type": "subtitle", "time": 6068.79, "timestamp": "01:41:08", "text": "うん。"}, {"type": "subtitle", "time": 6078.87, "timestamp": "01:41:18", "text": "私がこれを作ったんです。 今は、ある意味似ていると言えるでしょう"}, {"type": "subtitle", "time": 6081.669, "timestamp": "01:41:21", "text": "。 見てみると、"}, {"type": "subtitle", "time": 6085.51, "timestamp": "01:41:25", "text": "ホラーライブみたいなものに似ているんだけど、"}, {"type": "subtitle", "time": 6089.59, "timestamp": "01:41:29", "text": "クリックしてみると、"}, {"type": "subtitle", "time": 6096.87, "timestamp": "01:41:36", "text": "ナジ・サンジの作品からインスピレーションを得たものみたいなものがあるんだ。"}, {"type": "subtitle", "time": 6099.27, "timestamp": "01:41:39", "text": "ええ、"}, {"type": "subtitle", "time": 6102.87, "timestamp": "01:41:42", "text": "今日は12日ですよね？ うん。"}, {"type": "subtitle", "time": 6104.95, "timestamp": "01:41:44", "text": "コラボレーション参加者など、すべてが表示されます"}, {"type": "subtitle", "time": 6107.109, "timestamp": "01:41:47", "text": "。   まあ"}, {"type": "subtitle", "time": 6110.79, "timestamp": "01:41:50", "text": "、いい感じだと思う。"}, {"type": "subtitle", "time": 6112.629, "timestamp": "01:41:52", "text": "えっと、"}, {"type": "subtitle", "time": 6116.149, "timestamp": "01:41:56", "text": "待って、私、これできるよ。"}]
[{"type": "subtitle", "time": 3853.67, "timestamp": "01:04:13", "text": "でも、それは確かにそうですね。"}, {"type": "subtitle", "time": 3857.589, "timestamp": "01:04:17", "text": "正直言うと、私はまだ時間厳守について学んでいて、慣れている最中です"}, {"type": "subtitle", "time": 3865.829, "timestamp": "01:04:25", "text": "。 でも、そう、"}, {"type": "subtitle", "time": 3869.109, "timestamp": "01:04:29", "text": "ここでは時間管理がすべてなんです。"}, {"type": "subtitle", "time": 3871.829, "timestamp": "01:04:31", "text": "例えば最近は、"}, {"type": "subtitle", "time": 3875.43, "timestamp": "01:04:35", "text": "会議とか何かがある時、"}, {"type": "subtitle", "time": 3878.63, "timestamp": "01:04:38", "text": "10分くらい前には準備を整えるようにしているんだけど、"}, {"type": "subtitle", "time": 3884.71, "timestamp": "01:04:44", "text": "相手が遅刻してきたら、文字通り"}, {"type": "subtitle", "time": 3887.27, "timestamp": "01:04:47", "text": "日本人らしい行動をとって、「なんで"}, {"type": "subtitle", "time": 3891.43, "timestamp": "01:04:51", "text": "彼はここにいないの？」って言い出すんだ。 だから、"}, {"type": "subtitle", "time": 3897.27, "timestamp": "01:04:57", "text": "5時なのに、彼は5時か"}, {"type": "subtitle", "time": 3899.349, "timestamp": "01:04:59", "text": "何かの時点でどこにいるの？  「ああ、この人"}]
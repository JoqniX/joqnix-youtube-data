[{"type": "subtitle", "time": 9926.309, "timestamp": "02:45:26", "text": "エクスペディションはもうそこには存在しない。 つまり、"}, {"type": "subtitle", "time": 9930.469, "timestamp": "02:45:30", "text": "今の私ならたくさん稼げるってことですよね"}, {"type": "subtitle", "time": 9934.389, "timestamp": "02:45:34", "text": "？ そして、有効期限を貯めておくんです"}, {"type": "subtitle", "time": 9937.19, "timestamp": "02:45:37", "text": "。   それは"}, {"type": "subtitle", "time": 9940.63, "timestamp": "02:45:40", "text": "私ができることの一つです。"}, {"type": "subtitle", "time": 9942.87, "timestamp": "02:45:42", "text": "また、私の"}, {"type": "subtitle", "time": 9945.269, "timestamp": "02:45:45", "text": "スターワークベンチや"}, {"type": "subtitle", "time": 9953.269, "timestamp": "02:45:53", "text": "あ、カメラは無料で使えますよ。 基本的なカメラで、"}, {"type": "subtitle", "time": 9957.349, "timestamp": "02:45:57", "text": "無料で使用できるわけではなく、簡単に作ることができます。"}]
[{"type": "subtitle", "time": 1803.909, "timestamp": "00:30:03", "text": "待って、右はどこ？ 待って、それは"}, {"type": "subtitle", "time": 1807.51, "timestamp": "00:30:07", "text": "信頼できる外国の主題ですか、それとも友人ですか？"}, {"type": "subtitle", "time": 1810.23, "timestamp": "00:30:10", "text": "つまり、日本語は世の中にある言語の中でも最も"}, {"type": "subtitle", "time": 1813.43, "timestamp": "00:30:13", "text": "難しい言語の一つだ。 そして、"}, {"type": "subtitle", "time": 1815.19, "timestamp": "00:30:15", "text": "日本に来る予定があるなら、それは"}, {"type": "subtitle", "time": 1817.029, "timestamp": "00:30:17", "text": "役に立つでしょう。 日本に来ないのであれば"}, {"type": "subtitle", "time": 1819.269, "timestamp": "00:30:19", "text": "、それは役に立ちません。   以上です。"}, {"type": "subtitle", "time": 1832.87, "timestamp": "00:30:32", "text": "犠牲だ。"}, {"type": "subtitle", "time": 1835.11, "timestamp": "00:30:35", "text": "私だけでしょうか、それとも「"}]
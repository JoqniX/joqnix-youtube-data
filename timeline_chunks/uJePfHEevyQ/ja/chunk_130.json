[{"type": "subtitle", "time": 7804.55, "timestamp": "02:10:04", "text": "待って。 シュレッダーを倒す方法を知っている人はいますか"}, {"type": "subtitle", "time": 7806.709, "timestamp": "02:10:06", "text": "？   えっと、"}, {"type": "subtitle", "time": 7827.75, "timestamp": "02:10:27", "text": "違うよ。   来て"}, {"type": "subtitle", "time": 7830.709, "timestamp": "02:10:30", "text": "。 信頼する人。 えっと、真ん中じゃないよ"}, {"type": "subtitle", "time": 7835.83, "timestamp": "02:10:35", "text": "。 信頼する人。 下部。 ああ、"}, {"type": "subtitle", "time": 7839.669, "timestamp": "02:10:39", "text": "１、２、３、４。 わかった。 信頼者。"}, {"type": "subtitle", "time": 7843.109, "timestamp": "02:10:43", "text": "痛み。 私は死んだ。 もう一つのボール。 えっと、こんにちは、"}, {"type": "subtitle", "time": 7852.069, "timestamp": "02:10:52", "text": "待って、抜粋がある。"}]
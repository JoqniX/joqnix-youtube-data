[{"type": "subtitle", "time": 9840.87, "timestamp": "02:44:00", "text": "カスタマイズするにはどうすればいいですか？   ス"}, {"type": "subtitle", "time": 9843.51, "timestamp": "02:44:03", "text": "クラッピー・ジェイ。"}, {"type": "subtitle", "time": 9847.19, "timestamp": "02:44:07", "text": "待って、車両をカスタマイズするにはどうすればいいの？ えっと、"}, {"type": "subtitle", "time": 9849.51, "timestamp": "02:44:09", "text": "ステンシル。"}, {"type": "subtitle", "time": 9853.51, "timestamp": "02:44:13", "text": "ええと、作業場の"}, {"type": "subtitle", "time": 9855.03, "timestamp": "02:44:15", "text": "ユーティリティですね。"}, {"type": "subtitle", "time": 9859.91, "timestamp": "02:44:19", "text": "医療関連の製作は禁止です。 ああ、"}, {"type": "subtitle", "time": 9862.469, "timestamp": "02:44:22", "text": "マップ武器だ。"}, {"type": "subtitle", "time": 9864.71, "timestamp": "02:44:24", "text": "えっと、"}, {"type": "subtitle", "time": 9867.429, "timestamp": "02:44:27", "text": "クラフトのレベルアップ。 待って、レイダー、ステンシルはどうやって作るの"}, {"type": "subtitle", "time": 9875.349, "timestamp": "02:44:35", "text": "？ 前哨基地かもしれない。 わからない。"}, {"type": "subtitle", "time": 9881.83, "timestamp": "02:44:41", "text": "ええ、さっきそのお店を見て回っていたんです"}, {"type": "subtitle", "time": 9891.67, "timestamp": "02:44:51", "text": "このゲームを一緒にプレイするのに誰が必要か知っていますか"}, {"type": "subtitle", "time": 9894.63, "timestamp": "02:44:54", "text": "？ ベーコンが食べたい。"}, {"type": "subtitle", "time": 9898.63, "timestamp": "02:44:58", "text": "兄貴が必要だ。 ベーコンに"}]
[{"type": "subtitle", "time": 3662.63, "timestamp": "01:01:02", "text": "だらしない"}, {"type": "subtitle", "time": 3665.109, "timestamp": "01:01:05", "text": "服装。"}, {"type": "subtitle", "time": 3688.71, "timestamp": "01:01:28", "text": "ゼロ彗星。 でも、私はこれらを持っていません。 つまり、"}, {"type": "subtitle", "time": 3690.39, "timestamp": "01:01:30", "text": "私はこれらを持っていないということですか？ああ、私は"}, {"type": "subtitle", "time": 3704.47, "timestamp": "01:01:44", "text": "私はキノコに餌を与えることができる。"}, {"type": "subtitle", "time": 3706.549, "timestamp": "01:01:46", "text": "待って、待って、待って。 キノコは"}, {"type": "subtitle", "time": 3709.91, "timestamp": "01:01:49", "text": "バラの原料として非常に希少なものです。"}, {"type": "subtitle", "time": 3712.39, "timestamp": "01:01:52", "text": "キノコは一つしかあげないよ。"}, {"type": "subtitle", "time": 3715.829, "timestamp": "01:01:55", "text": "ああ、それで生きていけばいいさ。   しばらくの間、"}]
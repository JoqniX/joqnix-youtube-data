[{"type": "subtitle", "time": 4202.31, "timestamp": "01:10:02", "text": "お越しいただきありがとうございます。 良い夜をお過ごしください"}, {"type": "subtitle", "time": 4203.83, "timestamp": "01:10:03", "text": "。"}, {"type": "subtitle", "time": 4206.229, "timestamp": "01:10:06", "text": "私にとってはもう遅い時間です。 エビを食べ終えたら"}, {"type": "subtitle", "time": 4210.47, "timestamp": "01:10:10", "text": "寝ます。 明日仕事がある。"}, {"type": "subtitle", "time": 4218.709, "timestamp": "01:10:18", "text": "ああ、ブレット。 これは縫製機ですか？ なぜ"}, {"type": "chat", "time": 4223.952, "timestamp": "01:10:23", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "OwO"}, {"type": "subtitle", "time": 4224.07, "timestamp": "01:10:24", "text": "彼は"}, {"type": "subtitle", "time": 4226.39, "timestamp": "01:10:26", "text": "私のアクセントを聞いた後、あの緑色のペンキを投げたのだろうか？"}, {"type": "subtitle", "time": 4230.229, "timestamp": "01:10:30", "text": "問題は、私が"}, {"type": "subtitle", "time": 4233.669, "timestamp": "01:10:33", "text": "オンラインでVC関連のことをしているとき、人々が"}, {"type": "subtitle", "time": 4247.35, "timestamp": "01:10:47", "text": "ありがとう。 どうもありがとう。"}]
[{"type": "subtitle", "time": 7441.51, "timestamp": "02:04:01", "text": "うん、"}, {"type": "subtitle", "time": 7443.99, "timestamp": "02:04:03", "text": "Kickとかで配信をひたすら見てたよ"}, {"type": "subtitle", "time": 7477.589, "timestamp": "02:04:37", "text": "弧を描くように下へ飛ぶことはできますか"}, {"type": "subtitle", "time": 7480.709, "timestamp": "02:04:40", "text": "？ ああ、わかりました"}, {"type": "subtitle", "time": 7483.189, "timestamp": "02:04:43", "text": "。 抜粋はどこにあるの？  2分。"}, {"type": "subtitle", "time": 7484.709, "timestamp": "02:04:44", "text": "東側のエレベーターで家に帰りましょう。"}, {"type": "subtitle", "time": 7488.87, "timestamp": "02:04:48", "text": "えっと、ハッシュキーがないのですが、できるかもしれません。"}, {"type": "subtitle", "time": 7491.669, "timestamp": "02:04:51", "text": "ここから出て行ってもいいですよ。"}, {"type": "subtitle", "time": 7496.39, "timestamp": "02:04:56", "text": "パートナーとは別の相手と決めるに至った。 私はこれで全て台無しになった"}, {"type": "subtitle", "time": 7498.87, "timestamp": "02:04:58", "text": "。 わからない。 どうやって取り出したのか、自分でもわからない"}]
[{"type": "subtitle", "time": 424.39, "timestamp": "00:07:04", "text": "アロンはここでは映っていません。"}, {"type": "subtitle", "time": 426.87, "timestamp": "00:07:06", "text": "ああ、そうそう。 パイオニアゲーム。 わかりました、"}, {"type": "subtitle", "time": 429.43, "timestamp": "00:07:09", "text": "作成します。 見かけたら教えてください"}, {"type": "subtitle", "time": 433.909, "timestamp": "00:07:13", "text": "。 はい、見えますね。 えっと、"}, {"type": "subtitle", "time": 444.87, "timestamp": "00:07:24", "text": "その時計を他の時計の代わりに置きます"}, {"type": "subtitle", "time": 447.51, "timestamp": "00:07:27", "text": "。"}, {"type": "subtitle", "time": 450.95, "timestamp": "00:07:30", "text": "よし、話そう。 これが新しい"}, {"type": "subtitle", "time": 455.189, "timestamp": "00:07:35", "text": "凍った尻尾みたいなやつです。 我々には新しい前哨基地"}, {"type": "subtitle", "time": 457.35, "timestamp": "00:07:37", "text": "とアーククリーチャーがいる。 新着情報？ ブル、ブリー、"}, {"type": "subtitle", "time": 460.39, "timestamp": "00:07:40", "text": "スカリー、エア、ハイドラ、武器増幅、"}, {"type": "subtitle", "time": 463.51, "timestamp": "00:07:43", "text": "アーク、フリゲート、ブルー、危険、すべての"}, {"type": "subtitle", "time": 466.95, "timestamp": "00:07:46", "text": "アークベルト、"}, {"type": "subtitle", "time": 470.71, "timestamp": "00:07:50", "text": "武器、ステント、シェルをトリガーします。   わかった"}, {"type": "subtitle", "time": 473.749, "timestamp": "00:07:53", "text": "。 スキル3の再設計"}, {"type": "subtitle", "time": 476.71, "timestamp": "00:07:56", "text": "方向転換。 使用頻度の低いものを使用して、利用可能なものを"}, {"type": "subtitle", "time": 479.589, "timestamp": "00:07:59", "text": "自分の位置にリダイレクトします。"}]
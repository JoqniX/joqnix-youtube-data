[{"type": "subtitle", "time": 424.39, "timestamp": "00:07:04", "text": "這裡沒有出現配音員阿隆。"}, {"type": "subtitle", "time": 426.87, "timestamp": "00:07:06", "text": "哦，找到了。先鋒遊戲。好的，"}, {"type": "subtitle", "time": 429.43, "timestamp": "00:07:09", "text": "我來創建它。如果你看到了，請告訴我"}, {"type": "subtitle", "time": 433.909, "timestamp": "00:07:13", "text": "。好了，你看到了。我"}, {"type": "subtitle", "time": 444.87, "timestamp": "00:07:24", "text": "我會把那個鐘換成另一個"}, {"type": "subtitle", "time": 447.51, "timestamp": "00:07:27", "text": "鐘。"}, {"type": "subtitle", "time": 450.95, "timestamp": "00:07:30", "text": "好的，我們來談談。這是新的"}, {"type": "subtitle", "time": 455.189, "timestamp": "00:07:35", "text": "冷凍尾巴裝置。我們有新的哨站"}, {"type": "subtitle", "time": 457.35, "timestamp": "00:07:37", "text": "和弧形生物。什麼是新的？公牛惡霸"}, {"type": "subtitle", "time": 460.39, "timestamp": "00:07:40", "text": "斯卡利空中九頭蛇武器增幅"}, {"type": "subtitle", "time": 463.51, "timestamp": "00:07:43", "text": "弧形護衛艦藍色危險觸發所有"}, {"type": "subtitle", "time": 466.95, "timestamp": "00:07:46", "text": "弧形腰帶"}, {"type": "subtitle", "time": 470.71, "timestamp": "00:07:50", "text": "武器支架砲彈。"}, {"type": "subtitle", "time": 473.749, "timestamp": "00:07:53", "text": "好的。技能三重"}, {"type": "subtitle", "time": 476.71, "timestamp": "00:07:56", "text": "改改方向。使用罕見的重定向方法將"}, {"type": "subtitle", "time": 479.589, "timestamp": "00:07:59", "text": "可用資源指派到您自己的位置。"}]
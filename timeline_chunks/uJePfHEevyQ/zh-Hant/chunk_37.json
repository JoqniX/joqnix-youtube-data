[{"type": "subtitle", "time": 2224.95, "timestamp": "00:37:04", "text": "我為什麼要讀這本書？等待。  這是我做的。  好的。  好的。"}, {"type": "subtitle", "time": 2258.069, "timestamp": "00:37:38", "text": "看到這訊息，我好害怕。  你沒看到這一點，對吧？百分之百確定，對吧？好的。好的。感謝上帝。我的天啊。  ly。  兄弟，"}, {"type": "subtitle", "time": 2265.27, "timestamp": "00:37:45", "text": "你要是看不到那筆款項，"}, {"type": "subtitle", "time": 2271.91, "timestamp": "00:37:51", "text": "我會哭的。我真的買了。"}, {"type": "subtitle", "time": 2274.71, "timestamp": "00:37:54", "text": "決不。"}]
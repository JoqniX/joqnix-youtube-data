[{"type": "subtitle", "time": 8303.11, "timestamp": "02:18:23", "text": "。  顯而易見的替代品。  我們去……我們去……你知道嗎？我們去這裡。  我打算"}, {"type": "subtitle", "time": 8319.669, "timestamp": "02:18:39", "text": "我有一個倖存者藍圖。"}, {"type": "subtitle", "time": 8322.23, "timestamp": "02:18:42", "text": "哦，是的。  我有"}, {"type": "subtitle", "time": 8326.709, "timestamp": "02:18:46", "text": "倖存者，我有很多倖存者。現在"}, {"type": "subtitle", "time": 8337.509, "timestamp": "02:18:57", "text": "我不該冒險。  如果有人只是想表達我的悲傷呢？  我負擔不起。嗯，縫紉機"}]
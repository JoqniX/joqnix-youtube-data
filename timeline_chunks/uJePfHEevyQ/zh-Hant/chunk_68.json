[{"type": "subtitle", "time": 4083.91, "timestamp": "01:08:03", "text": "拜託，我只是個新手。請。"}, {"type": "subtitle", "time": 4086.71, "timestamp": "01:08:06", "text": "什麼？我剛出生在這裡。你是什​​麼意思？我沒有開槍打人。我這不就是跟開槍打我的那個人一樣在搶劫嗎？"}, {"type": "subtitle", "time": 4091.829, "timestamp": "01:08:11", "text": "你有證據嗎？  你們穿的衣服跟我一樣。你手上有這張照片。"}, {"type": "subtitle", "time": 4113.99, "timestamp": "01:08:33", "text": "你開槍打了我。  我的意思是，你知道嗎"}]
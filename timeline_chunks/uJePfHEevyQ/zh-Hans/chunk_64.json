[{"type": "subtitle", "time": 3853.67, "timestamp": "01:04:13", "text": "没错，确实如此。 说"}, {"type": "subtitle", "time": 3857.589, "timestamp": "01:04:17", "text": "实话，虽然我"}, {"type": "subtitle", "time": 3865.829, "timestamp": "01:04:25", "text": "没错，时间"}, {"type": "subtitle", "time": 3869.109, "timestamp": "01:04:29", "text": "管理在这里至关重要。"}, {"type": "subtitle", "time": 3871.829, "timestamp": "01:04:31", "text": "例如，现在如果我要参加"}, {"type": "subtitle", "time": 3875.43, "timestamp": "01:04:35", "text": "会议之类的活动，"}, {"type": "subtitle", "time": 3878.63, "timestamp": "01:04:38", "text": "我通常会提前 10 分钟左右做好准备；"}, {"type": "subtitle", "time": 3881.109, "timestamp": "01:04:41", "text": "如果"}, {"type": "subtitle", "time": 3884.71, "timestamp": "01:04:44", "text": "对方迟到了，我就会像"}, {"type": "subtitle", "time": 3887.27, "timestamp": "01:04:47", "text": "日本人那样开始质问：“"}, {"type": "subtitle", "time": 3891.43, "timestamp": "01:04:51", "text": "他为什么还没来？” 现在是"}, {"type": "subtitle", "time": 3897.27, "timestamp": "01:04:57", "text": "5点，他在哪儿？5点左右吗"}, {"type": "subtitle", "time": 3899.349, "timestamp": "01:04:59", "text": "？ 我心想：“是啊，这家伙"}]
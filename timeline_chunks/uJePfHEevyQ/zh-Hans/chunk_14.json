[{"type": "subtitle", "time": 840.47, "timestamp": "00:14:00", "text": "看看这皮肤，姑娘。 兄弟，我的"}, {"type": "subtitle", "time": 842.629, "timestamp": "00:14:02", "text": "天哪。"}, {"type": "subtitle", "time": 862.069, "timestamp": "00:14:22", "text": "他看起来很酷。"}, {"type": "subtitle", "time": 882.79, "timestamp": "00:14:42", "text": "我至今还记得这件事。 喇叭在哪儿"}, {"type": "subtitle", "time": 886.31, "timestamp": "00:14:46", "text": "？ 喇叭在哪儿？ 罗德套装 马可"}, {"type": "subtitle", "time": 896.069, "timestamp": "00:14:56", "text": "我想他们添加了莫"}, {"type": "subtitle", "time": 899.43, "timestamp": "00:14:59", "text": "无法为它添加奖杯展示探险"}]
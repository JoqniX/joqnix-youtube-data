[{"type": "subtitle", "time": 8118.31, "timestamp": "02:15:18", "text": "呃，那是绷带"}, {"type": "subtitle", "time": 8148.39, "timestamp": "02:15:48", "text": "我有幸存者，我有很多"}, {"type": "subtitle", "time": 8150.95, "timestamp": "02:15:50", "text": "幸存者。 现在我不该冒险。"}, {"type": "subtitle", "time": 8155.03, "timestamp": "02:15:55", "text": "如果有人只是想表达我的悲伤呢？"}]
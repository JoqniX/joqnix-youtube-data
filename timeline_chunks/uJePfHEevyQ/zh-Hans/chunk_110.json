[{"type": "subtitle", "time": 6602.229, "timestamp": "01:50:02", "text": "完全没有审核。 就像……你可以把它想象成"}, {"type": "subtitle", "time": 6605.99, "timestamp": "01:50:05", "text": "电视台之类的东西。"}, {"type": "subtitle", "time": 6618.31, "timestamp": "01:50:18", "text": "我想问你关于那个应用程序的事，"}, {"type": "subtitle", "time": 6620.31, "timestamp": "01:50:20", "text": "我想问你关于我做的那个应用程序的事，"}, {"type": "subtitle", "time": 6622.87, "timestamp": "01:50:22", "text": "只有黑色的，我得到的是可以的，我想"}, {"type": "subtitle", "time": 6624.95, "timestamp": "01:50:24", "text": "在这一点上，我想我本来应该做的，"}, {"type": "subtitle", "time": 6627.669, "timestamp": "01:50:27", "text": "我必须单独做一些事情，"}, {"type": "subtitle", "time": 6635.59, "timestamp": "01:50:35", "text": "我的意思是，"}, {"type": "subtitle", "time": 6639.03, "timestamp": "01:50:39", "text": "你们都忘了我，飞"}, {"type": "subtitle", "time": 6642.87, "timestamp": "01:50:42", "text": "矛。 他们不喜欢人工智能之类的东西。"}, {"type": "subtitle", "time": 6650.39, "timestamp": "01:50:50", "text": "使用人工智能助手等"}, {"type": "subtitle", "time": 6652.47, "timestamp": "01:50:52", "text": "工具的人，会被人用"}, {"type": "subtitle", "time": 6658.31, "timestamp": "01:50:58", "text": "异样的眼光看待。"}]
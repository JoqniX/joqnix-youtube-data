[{"type": "subtitle", "time": 4080.39, "timestamp": "01:08:00", "text": "你们穿的衣服跟我一样。 你手里有这张"}, {"type": "subtitle", "time": 4082.23, "timestamp": "01:08:02", "text": "照片。 你开枪打了我。"}, {"type": "subtitle", "time": 4083.91, "timestamp": "01:08:03", "text": "我的意思是，"}, {"type": "subtitle", "time": 4086.71, "timestamp": "01:08:06", "text": "你知道吗？ 你只要"}, {"type": "subtitle", "time": 4088.87, "timestamp": "01:08:08", "text": "在 Twitch 或 YouTube 上搜索我的名字就行了。 回看我的"}, {"type": "subtitle", "time": 4091.829, "timestamp": "01:08:11", "text": "直播就知道了。 你看，我当时明明就在"}, {"type": "subtitle", "time": 4094.95, "timestamp": "01:08:14", "text": "搜刮物资。"}, {"type": "subtitle", "time": 4096.789, "timestamp": "01:08:16", "text": "所以，被选中的不是我。 这里还有其他"}, {"type": "subtitle", "time": 4099.669, "timestamp": "01:08:19", "text": "人。 是的，这里还有其他"}, {"type": "subtitle", "time": 4103.349, "timestamp": "01:08:23", "text": "人。 所以我刚刚从顶峰下来，"}, {"type": "subtitle", "time": 4111.11, "timestamp": "01:08:31", "text": "免费领取了这笔款项。 兄弟，我只有"}, {"type": "subtitle", "time": 4113.99, "timestamp": "01:08:33", "text": "这把枪。 等等，你是在免费"}, {"type": "subtitle", "time": 4120.07, "timestamp": "01:08:40", "text": "哦，我的"}, {"type": "subtitle", "time": 4122.149, "timestamp": "01:08:42", "text": "天哪，没关系。 没关系。 我的天哪。 玩得"}, {"type": "subtitle", "time": 4129.91, "timestamp": "01:08:49", "text": "我的天啊。"}, {"type": "subtitle", "time": 4134.149, "timestamp": "01:08:54", "text": "哦，那太可怕了。 我的天啊。"}]
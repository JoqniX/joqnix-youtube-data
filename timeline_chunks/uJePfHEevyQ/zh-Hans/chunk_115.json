[{"type": "subtitle", "time": 6903.109, "timestamp": "01:55:03", "text": "建议是不要使用 Geni。"}, {"type": "subtitle", "time": 6904.629, "timestamp": "01:55:04", "text": "我知道有些 YouTuber 会用"}, {"type": "subtitle", "time": 6911.109, "timestamp": "01:55:11", "text": "嗯，"}, {"type": "subtitle", "time": 6913.91, "timestamp": "01:55:13", "text": "别用 geni，伙计。 你会被"}, {"type": "subtitle", "time": 6917.35, "timestamp": "01:55:17", "text": "VTuber圈子讨厌的，这个圈子很"}, {"type": "subtitle", "time": 6919.189, "timestamp": "01:55:19", "text": "疯狂，"}, {"type": "subtitle", "time": 6921.75, "timestamp": "01:55:21", "text": "尤其是西方圈子。"}, {"type": "subtitle", "time": 6924.709, "timestamp": "01:55:24", "text": "即使我这样的网络主播这么做，或者做了什么其他事情，都没关系，"}, {"type": "subtitle", "time": 6927.35, "timestamp": "01:55:27", "text": "但"}, {"type": "subtitle", "time": 6930.79, "timestamp": "01:55:30", "text": "大多数人还是会"}, {"type": "subtitle", "time": 6934.31, "timestamp": "01:55:34", "text": "反对你。"}, {"type": "subtitle", "time": 6935.83, "timestamp": "01:55:35", "text": "所以，这"}, {"type": "subtitle", "time": 6939.51, "timestamp": "01:55:39", "text": "就是为什么我自己不做Geni相关的"}, {"type": "subtitle", "time": 6942.39, "timestamp": "01:55:42", "text": "事情。 如果我愿意，我完全可以使用"}, {"type": "subtitle", "time": 6946.55, "timestamp": "01:55:46", "text": "人工智能产品，对吧？ 我本来可以"}, {"type": "subtitle", "time": 6951.109, "timestamp": "01:55:51", "text": "做一些人工智能相关的事情，比如"}, {"type": "subtitle", "time": 6956.149, "timestamp": "01:55:56", "text": "为我的 YouTube 直播制作一个漂亮的缩略图之类的"}, {"type": "subtitle", "time": 6958.55, "timestamp": "01:55:58", "text": "，使用人工智能产品等等，但是不行，因为"}]
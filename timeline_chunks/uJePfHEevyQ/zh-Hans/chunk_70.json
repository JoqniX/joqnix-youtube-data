[{"type": "subtitle", "time": 4202.31, "timestamp": "01:10:02", "text": "谢谢光临。 祝你今晚睡个好觉"}, {"type": "subtitle", "time": 4203.83, "timestamp": "01:10:03", "text": "。"}, {"type": "subtitle", "time": 4206.229, "timestamp": "01:10:06", "text": "对我来说已经很晚了。 我吃完虾就去"}, {"type": "subtitle", "time": 4210.47, "timestamp": "01:10:10", "text": "睡觉。 我明天要上班。"}, {"type": "subtitle", "time": 4218.709, "timestamp": "01:10:18", "text": "哦，子弹。 这是缝纫机吗？ 为什么"}, {"type": "chat", "time": 4223.952, "timestamp": "01:10:23", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "OwO"}, {"type": "subtitle", "time": 4226.39, "timestamp": "01:10:26", "text": "听了我的口音后，他没有扔掉那个绿巨人呢？"}, {"type": "subtitle", "time": 4230.229, "timestamp": "01:10:30", "text": "问题不在于当我"}, {"type": "subtitle", "time": 4233.669, "timestamp": "01:10:33", "text": "在线做视频会议相关的事情时，人们会"}, {"type": "subtitle", "time": 4247.35, "timestamp": "01:10:47", "text": "谢谢。 太感谢了。"}]
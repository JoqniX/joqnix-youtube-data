[{"type": "subtitle", "time": 3555.109, "timestamp": "00:59:15", "text": "哇"}, {"type": "subtitle", "time": 3559.27, "timestamp": "00:59:19", "text": "，她看起来真漂亮。"}, {"type": "subtitle", "time": 3562.71, "timestamp": "00:59:22", "text": "我的意思是，我很庆幸自己买了。"}, {"type": "subtitle", "time": 3565.27, "timestamp": "00:59:25", "text": "没错"}, {"type": "subtitle", "time": 3568.87, "timestamp": "00:59:28", "text": "，天气很热。 你看，我知道这是"}, {"type": "subtitle", "time": 3572.549, "timestamp": "00:59:32", "text": "梦。 简直就像梦境一样。"}, {"type": "subtitle", "time": 3574.789, "timestamp": "00:59:34", "text": "每个人"}, {"type": "subtitle", "time": 3577.349, "timestamp": "00:59:37", "text": "都想来这里，但一旦你"}, {"type": "subtitle", "time": 3581.03, "timestamp": "00:59:41", "text": "来了，这里简直就是人间地狱。我"}, {"type": "subtitle", "time": 3584.39, "timestamp": "00:59:44", "text": "会直截了当地说，这里很"}, {"type": "subtitle", "time": 3595.109, "timestamp": "00:59:55", "text": "艰难也很痛苦。虽然"}, {"type": "subtitle", "time": 3597.91, "timestamp": "00:59:57", "text": "比其他地方好，"}]
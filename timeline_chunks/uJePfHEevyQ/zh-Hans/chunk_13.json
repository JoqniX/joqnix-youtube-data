[{"type": "subtitle", "time": 790.389, "timestamp": "00:13:10", "text": "我至今仍记得"}, {"type": "subtitle", "time": 800.389, "timestamp": "00:13:20", "text": "老兄，这正是我一直想要的第一人称射击游戏。"}, {"type": "subtitle", "time": 803.269, "timestamp": "00:13:23", "text": "我的意思是，这次肯定不一样了。 我"}, {"type": "subtitle", "time": 805.269, "timestamp": "00:13:25", "text": "知道"}, {"type": "subtitle", "time": 809.829, "timestamp": "00:13:29", "text": "这跟我在"}, {"type": "subtitle", "time": 826.069, "timestamp": "00:13:46", "text": "我还是很怀念以前那种"}, {"type": "subtitle", "time": 827.91, "timestamp": "00:13:47", "text": "掠夺者"}, {"type": "subtitle", "time": 833.91, "timestamp": "00:13:53", "text": "1,000。"}, {"type": "subtitle", "time": 837.189, "timestamp": "00:13:57", "text": "这些是什么？ 哦，"}]
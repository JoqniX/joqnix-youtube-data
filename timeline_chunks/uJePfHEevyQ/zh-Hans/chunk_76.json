[{"type": "subtitle", "time": 4566.47, "timestamp": "01:16:06", "text": "哦，是模板。 这是什么？ 有趣的"}, {"type": "subtitle", "time": 4568.229, "timestamp": "01:16:08", "text": "武器。 是时候让你的武器"}, {"type": "subtitle", "time": 4570.31, "timestamp": "01:16:10", "text": "看起来更酷炫了。 现在你可以"}, {"type": "subtitle", "time": 4572.95, "timestamp": "01:16:12", "text": "发现并获得武器和攻击手段，"}, {"type": "subtitle", "time": 4575.189, "timestamp": "01:16:15", "text": "让你用自己的装备标记每把枪，"}, {"type": "subtitle", "time": 4585.35, "timestamp": "01:16:25", "text": "模板"}, {"type": "subtitle", "time": 4601.51, "timestamp": "01:16:41", "text": "我不想这样。 哦不，我不是故意的"}, {"type": "subtitle", "time": 4603.99, "timestamp": "01:16:43", "text": "。 哦，不。 嗯，或许我会把"}, {"type": "subtitle", "time": 4613.27, "timestamp": "01:16:53", "text": "嗯，我需要这个和这个。 所以我打算以"}, {"type": "subtitle", "time": 4616.229, "timestamp": "01:16:56", "text": "1000的价格出售。"}, {"type": "subtitle", "time": 4618.63, "timestamp": "01:16:58", "text": "把"}]
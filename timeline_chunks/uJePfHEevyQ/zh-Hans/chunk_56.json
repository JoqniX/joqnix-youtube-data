[{"type": "subtitle", "time": 3362.47, "timestamp": "00:56:02", "text": "嗯，只要你具备足够的"}, {"type": "subtitle", "time": 3364.95, "timestamp": "00:56:04", "text": "技能和其他条件就行。"}, {"type": "subtitle", "time": 3369.75, "timestamp": "00:56:09", "text": "呃，比如学位很重要。 是的。"}, {"type": "subtitle", "time": 3395.589, "timestamp": "00:56:35", "text": "经验才是最重要的。"}, {"type": "subtitle", "time": 3406.789, "timestamp": "00:56:46", "text": "这里有来自不同国家的人。"}, {"type": "subtitle", "time": 3409.19, "timestamp": "00:56:49", "text": "所以如果他们都能找到工作，那你为什么不能？"}]
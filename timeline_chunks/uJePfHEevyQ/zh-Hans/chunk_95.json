[{"type": "subtitle", "time": 5709.669, "timestamp": "01:35:09", "text": "好久没玩我们的"}, {"type": "subtitle", "time": 5711.11, "timestamp": "01:35:11", "text": "创意游戏了。 换到电脑后我就不玩了"}, {"type": "subtitle", "time": 5713.83, "timestamp": "01:35:13", "text": "。 啊，"}, {"type": "subtitle", "time": 5715.91, "timestamp": "01:35:15", "text": "我前段时间派了一支侦察队去太空站"}, {"type": "subtitle", "time": 5718.55, "timestamp": "01:35:18", "text": "。 例行工作，整理"}, {"type": "subtitle", "time": 5720.149, "timestamp": "01:35:20", "text": "安全记录，看看有没有什么"}, {"type": "subtitle", "time": 5722.79, "timestamp": "01:35:22", "text": "可以解读的信息。 他们使用的是 Hey, Raider。   这"}, {"type": "subtitle", "time": 5725.189, "timestamp": "01:35:25", "text": "是怎么回事？ 你在找点事"}, {"type": "subtitle", "time": 5743.35, "timestamp": "01:35:43", "text": "有几个地方。"}, {"type": "subtitle", "time": 5746.95, "timestamp": "01:35:46", "text": "Arc 一直是我们的敌人。   还有"}, {"type": "subtitle", "time": 5749.03, "timestamp": "01:35:49", "text": "一件事悬而未决。 我们把其中一个日晷"}, {"type": "subtitle", "time": 5750.95, "timestamp": "01:35:50", "text": "拿出来清洗。"}, {"type": "subtitle", "time": 5751.51, "timestamp": "01:35:51", "text": "独自一人。"}, {"type": "subtitle", "time": 5754.47, "timestamp": "01:35:54", "text": "这会随着时间推移而消失吗？"}, {"type": "subtitle", "time": 5755.189, "timestamp": "01:35:55", "text": "我们不"}, {"type": "subtitle", "time": 5756.629, "timestamp": "01:35:56", "text": "喜欢交易员。"}, {"type": "subtitle", "time": 5757.43, "timestamp": "01:35:57", "text": "把它推向高潮。"}]
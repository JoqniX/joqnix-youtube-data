[{"type": "subtitle", "time": 1803.909, "timestamp": "00:30:03", "text": "等等，右边在哪儿？ 等等，这是"}, {"type": "subtitle", "time": 1807.51, "timestamp": "00:30:07", "text": "可靠的外国臣民还是朋友？"}, {"type": "subtitle", "time": 1810.23, "timestamp": "00:30:10", "text": "我的意思是，日语"}, {"type": "subtitle", "time": 1813.43, "timestamp": "00:30:13", "text": "绝对是最难学的语言之一。"}, {"type": "subtitle", "time": 1815.19, "timestamp": "00:30:15", "text": "如果你要来日本，那就很有"}, {"type": "subtitle", "time": 1817.029, "timestamp": "00:30:17", "text": "用了。 如果你不打算来"}, {"type": "subtitle", "time": 1819.269, "timestamp": "00:30:19", "text": "日本，那就没用了。"}, {"type": "subtitle", "time": 1832.87, "timestamp": "00:30:32", "text": "牺牲。"}, {"type": "subtitle", "time": 1835.11, "timestamp": "00:30:35", "text": "是我错觉吗？我找不到……"}, {"type": "subtitle", "time": 1841.51, "timestamp": "00:30:41", "text": "我找不到"}]
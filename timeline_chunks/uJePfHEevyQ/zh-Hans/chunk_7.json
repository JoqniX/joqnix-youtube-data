[{"type": "subtitle", "time": 424.39, "timestamp": "00:07:04", "text": "这里没有出现配音演员阿隆。"}, {"type": "subtitle", "time": 426.87, "timestamp": "00:07:06", "text": "哦，找到了。 先锋游戏。 好的，"}, {"type": "subtitle", "time": 429.43, "timestamp": "00:07:09", "text": "我来创建它。 如果你看到了，请告诉我"}, {"type": "subtitle", "time": 433.909, "timestamp": "00:07:13", "text": "。 好了，你看到了。 我"}, {"type": "subtitle", "time": 444.87, "timestamp": "00:07:24", "text": "我会把那个钟换成另一个"}, {"type": "subtitle", "time": 447.51, "timestamp": "00:07:27", "text": "钟。"}, {"type": "subtitle", "time": 450.95, "timestamp": "00:07:30", "text": "好的，我们来谈谈。 这是新的"}, {"type": "subtitle", "time": 455.189, "timestamp": "00:07:35", "text": "冷冻尾巴装置。 我们有新的哨站"}, {"type": "subtitle", "time": 457.35, "timestamp": "00:07:37", "text": "和弧形生物。 什么是新的？ 公牛恶霸"}, {"type": "subtitle", "time": 460.39, "timestamp": "00:07:40", "text": "斯卡利空中九头蛇武器增幅"}, {"type": "subtitle", "time": 463.51, "timestamp": "00:07:43", "text": "弧形护卫舰蓝色危险触发所有"}, {"type": "subtitle", "time": 466.95, "timestamp": "00:07:46", "text": "弧形腰带"}, {"type": "subtitle", "time": 470.71, "timestamp": "00:07:50", "text": "武器支架炮弹。"}, {"type": "subtitle", "time": 473.749, "timestamp": "00:07:53", "text": "好的。 技能三重改"}, {"type": "subtitle", "time": 476.71, "timestamp": "00:07:56", "text": "改方向。 使用罕见的重定向方法将"}, {"type": "subtitle", "time": 479.589, "timestamp": "00:07:59", "text": "可用资源分配到您自己的位置。"}]
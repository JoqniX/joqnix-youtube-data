[{"type": "subtitle", "time": 6481.83, "timestamp": "01:48:01", "text": "并自动播放。 我"}, {"type": "subtitle", "time": 6484.47, "timestamp": "01:48:04", "text": "不需要触碰。 唯一的问题是"}, {"type": "subtitle", "time": 6487.669, "timestamp": "01:48:07", "text": "Twitch 的直播时长限制"}, {"type": "subtitle", "time": 6491.59, "timestamp": "01:48:11", "text": "是 48 小时。 所以我不得不手动"}, {"type": "subtitle", "time": 6494.07, "timestamp": "01:48:14", "text": "重启流媒体，而我最近才把"}, {"type": "subtitle", "time": 6497.99, "timestamp": "01:48:17", "text": "它设置成自动化的。 呃，但唯一的问题是"}, {"type": "subtitle", "time": 6500.87, "timestamp": "01:48:20", "text": "我使用的多流服务器服务，"}, {"type": "subtitle", "time": 6507.27, "timestamp": "01:48:27", "text": "他们不支持我正在做的事情。"}, {"type": "subtitle", "time": 6511.109, "timestamp": "01:48:31", "text": "呃，这项服务不用于 34FX"}, {"type": "subtitle", "time": 6514.47, "timestamp": "01:48:34", "text": "流媒体播放。 所以，呃，"}, {"type": "subtitle", "time": 6517.669, "timestamp": "01:48:37", "text": "当我问到一些事情时，他们有点否认了。"}, {"type": "subtitle", "time": 6519.669, "timestamp": "01:48:39", "text": "所以，"}, {"type": "subtitle", "time": 6521.99, "timestamp": "01:48:41", "text": "我还是设法在本地做了一些事情"}, {"type": "subtitle", "time": 6524.229, "timestamp": "01:48:44", "text": "。   是的"}, {"type": "subtitle", "time": 6527.109, "timestamp": "01:48:47", "text": "，现在一切都自动化了。"}, {"type": "subtitle", "time": 6529.75, "timestamp": "01:48:49", "text": "网站方面也是一样。 我把"}, {"type": "subtitle", "time": 6533.75, "timestamp": "01:48:53", "text": "所有东西都重做了，比如规则、菜单"}, {"type": "subtitle", "time": 6537.91, "timestamp": "01:48:57", "text": "、"}]
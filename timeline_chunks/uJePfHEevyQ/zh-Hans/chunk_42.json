[{"type": "subtitle", "time": 2521.829, "timestamp": "00:42:01", "text": "。 我的天啊。 他妈的。"}, {"type": "subtitle", "time": 2524.55, "timestamp": "00:42:04", "text": "您已使用信用卡额度的 80%"}, {"type": "subtitle", "time": 2535.03, "timestamp": "00:42:15", "text": "哦，是的，我买了。 我真的买了"}, {"type": "subtitle", "time": 2538.55, "timestamp": "00:42:18", "text": "。 虽然我身上没多少钱，但我还是把它刷爆了"}, {"type": "subtitle", "time": 2541.67, "timestamp": "00:42:21", "text": "。 我当时身无分文，只是"}, {"type": "subtitle", "time": 2546.71, "timestamp": "00:42:26", "text": "想要那个发型，所以就去剪了。"}, {"type": "subtitle", "time": 2548.87, "timestamp": "00:42:28", "text": "现在我被迫玩这个游戏，"}, {"type": "subtitle", "time": 2554.069, "timestamp": "00:42:34", "text": "尽管我不想帮忙。"}, {"type": "subtitle", "time": 2558.069, "timestamp": "00:42:38", "text": "帮我。 哇。"}, {"type": "subtitle", "time": 2560.63, "timestamp": "00:42:40", "text": "我只有3712"}, {"type": "subtitle", "time": 2563.51, "timestamp": "00:42:43", "text": "卢比。 那是多少？"}, {"type": "subtitle", "time": 2572.15, "timestamp": "00:42:52", "text": "等等，"}, {"type": "subtitle", "time": 2578.63, "timestamp": "00:42:58", "text": "呃，"}]
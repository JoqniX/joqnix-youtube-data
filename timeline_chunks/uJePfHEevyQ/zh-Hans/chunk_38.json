[{"type": "subtitle", "time": 2288.95, "timestamp": "00:38:08", "text": "我以为我可以走捷径，但"}, {"type": "subtitle", "time": 2307.19, "timestamp": "00:38:27", "text": "好吧。 嗯，短波浪卷发挺好看的，"}, {"type": "subtitle", "time": 2310.23, "timestamp": "00:38:30", "text": "不过，波波头还是不错。"}, {"type": "subtitle", "time": 2324.069, "timestamp": "00:38:44", "text": "好吧，既然我花钱买了这款游戏，我"}, {"type": "subtitle", "time": 2329.51, "timestamp": "00:38:49", "text": "就得强迫自己"}, {"type": "subtitle", "time": 2335.99, "timestamp": "00:38:55", "text": "去玩，去刷所有东西，"}]
[{"type": "subtitle", "time": 4242.229, "timestamp": "01:10:42", "text": "我想是因为我习惯了用"}, {"type": "subtitle", "time": 4244.55, "timestamp": "01:10:44", "text": "高音听歌，也习惯了用"}, {"type": "subtitle", "time": 4247.189, "timestamp": "01:10:47", "text": "高音唱歌。 这就像肌肉记忆"}, {"type": "subtitle", "time": 4248.31, "timestamp": "01:10:48", "text": "一样。"}, {"type": "subtitle", "time": 4251.35, "timestamp": "01:10:51", "text": "Rim的音域没那么高。 我只是"}, {"type": "subtitle", "time": 4252.709, "timestamp": "01:10:52", "text": "想告诉你这件事。"}, {"type": "subtitle", "time": 4255.91, "timestamp": "01:10:55", "text": "哦，我看了，我指的是CL翻唱的《"}, {"type": "subtitle", "time": 4257.27, "timestamp": "01:10:57", "text": "Rims》。"}]
[{"type": "subtitle", "time": 2101.91, "timestamp": "00:35:01", "text": "搜索，然后问：这首歌叫什么名字？ 我"}, {"type": "subtitle", "time": 2105.19, "timestamp": "00:35:05", "text": "想Suki有一首歌，"}, {"type": "subtitle", "time": 2108.15, "timestamp": "00:35:08", "text": "最近我在VC里试着唱这首歌"}, {"type": "subtitle", "time": 2111.43, "timestamp": "00:35:11", "text": "给K听，然后我就想，"}, {"type": "subtitle", "time": 2114.23, "timestamp": "00:35:14", "text": "Suki有一首歌对吧？ 我不"}, {"type": "subtitle", "time": 2123.99, "timestamp": "00:35:23", "text": "你知道那首歌吗？”"}, {"type": "subtitle", "time": 2126.47, "timestamp": "00:35:26", "text": "我好像听说过。"}, {"type": "subtitle", "time": 2128.32, "timestamp": "00:35:28", "text": "就像"}, {"type": "subtitle", "time": 2130.95, "timestamp": "00:35:30", "text": "[音乐] 是的"}, {"type": "subtitle", "time": 2133.349, "timestamp": "00:35:33", "text": "。 是的。 那首歌。 我努力想"}, {"type": "subtitle", "time": 2137.27, "timestamp": "00:35:37", "text": "回忆歌词，但我就是想不起来"}, {"type": "subtitle", "time": 2139.99, "timestamp": "00:35:39", "text": "歌词，也想不起来歌名"}, {"type": "subtitle", "time": 2142.15, "timestamp": "00:35:42", "text": "。"}, {"type": "subtitle", "time": 2144.63, "timestamp": "00:35:44", "text": "是的，这对我来说确实很难，"}, {"type": "subtitle", "time": 2147.109, "timestamp": "00:35:47", "text": "但我偶尔还是能想起一些事情"}, {"type": "subtitle", "time": 2150.069, "timestamp": "00:35:50", "text": "。 差不多就是这样。"}, {"type": "subtitle", "time": 2152.71, "timestamp": "00:35:52", "text": "我依靠记忆力。 记忆力短暂且有限"}]
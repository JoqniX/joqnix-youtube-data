[{"type": "subtitle", "time": 4865.35, "timestamp": "01:21:05", "text": "哦，等等。 等待。 我怎么会这样？我的天哪。"}, {"type": "subtitle", "time": 4875.75, "timestamp": "01:21:15", "text": "我觉得我最后一个搞砸了。 是的"}, {"type": "subtitle", "time": 4880.47, "timestamp": "01:21:20", "text": "，我也需要练习一下。"}, {"type": "subtitle", "time": 4883.91, "timestamp": "01:21:23", "text": "我唱这首歌的时候，音调下降的部分听起来"}, {"type": "subtitle", "time": 4886.149, "timestamp": "01:21:26", "text": "很单调。 所以，我不知道我是否真的"}, {"type": "subtitle", "time": 4889.03, "timestamp": "01:21:29", "text": "知道该怎么做。 下降，"}, {"type": "subtitle", "time": 4891.51, "timestamp": "01:21:31", "text": "俯仰角下降之类的。 怎么做呢？ 我"}, {"type": "subtitle", "time": 4894.07, "timestamp": "01:21:34", "text": "不需要听歌就知道"}, {"type": "subtitle", "time": 4896.87, "timestamp": "01:21:36", "text": "怎么唱某些部分，但我会"}, {"type": "subtitle", "time": 4898.63, "timestamp": "01:21:38", "text": "尽量告诉你。   是的"}, {"type": "subtitle", "time": 4903.83, "timestamp": "01:21:43", "text": "苏罗。"}, {"type": "subtitle", "time": 4907.03, "timestamp": "01:21:47", "text": "你接下来要唱哪首歌？"}, {"type": "subtitle", "time": 4911.75, "timestamp": "01:21:51", "text": "好的。 接下来是什么？ 嗯，这些我都会做"}, {"type": "subtitle", "time": 4914.79, "timestamp": "01:21:54", "text": "或者我知道。 哦，对，我得"}, {"type": "subtitle", "time": 4917.59, "timestamp": "01:21:57", "text": "加上这个，对吧？ 哦，"}, {"type": "subtitle", "time": 4919.11, "timestamp": "01:21:59", "text": "等等。 我必须学会这个。 当然"}]
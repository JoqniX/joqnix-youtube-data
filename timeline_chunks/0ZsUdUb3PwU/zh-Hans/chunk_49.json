[{"type": "subtitle", "time": 2943.109, "timestamp": "00:49:03", "text": "更放松一些，你知道的。"}, {"type": "subtitle", "time": 2945.67, "timestamp": "00:49:05", "text": "我一直在学习这首歌，因为"}, {"type": "subtitle", "time": 2949.349, "timestamp": "00:49:09", "text": "你知道，嗯，赤村，嗯，我想教"}, {"type": "subtitle", "time": 2952.15, "timestamp": "00:49:12", "text": "赤村这首歌。"}, {"type": "subtitle", "time": 2954.47, "timestamp": "00:49:14", "text": "太好了。 我想听他唱这首歌"}, {"type": "subtitle", "time": 2956.47, "timestamp": "00:49:16", "text": "。 我的天啊。 也有英文版"}, {"type": "subtitle", "time": 2957.349, "timestamp": "00:49:17", "text": "。 是的"}, {"type": "subtitle", "time": 2965.589, "timestamp": "00:49:25", "text": "好的。 好的。 你好。   是的"}, {"type": "subtitle", "time": 2966.39, "timestamp": "00:49:26", "text": "。"}, {"type": "subtitle", "time": 2967.99, "timestamp": "00:49:27", "text": "然后是“是的”"}, {"type": "subtitle", "time": 2999.589, "timestamp": "00:49:59", "text": "哦耶。 你为什么会像蛋黄酱一样思考？"}]
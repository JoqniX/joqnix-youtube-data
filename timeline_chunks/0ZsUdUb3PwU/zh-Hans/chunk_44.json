[{"type": "subtitle", "time": 2640.16, "timestamp": "00:44:00", "text": "你学会了吗？ 呃，"}, {"type": "subtitle", "time": 2642.64, "timestamp": "00:44:02", "text": "呃， 有时候我必须不断"}, {"type": "subtitle", "time": 2645.04, "timestamp": "00:44:05", "text": "有时候我必须不断 练习，因为它现在速度很快，而且"}, {"type": "subtitle", "time": 2648.0, "timestamp": "00:44:08", "text": "练习，因为它现在速度很快，而且 段落很多。"}, {"type": "subtitle", "time": 2649.68, "timestamp": "00:44:09", "text": "段落很多。 第一个我可以做。 我想"}, {"type": "subtitle", "time": 2660.71, "timestamp": "00:44:20", "text": "你可以开始唱歌了。"}, {"type": "subtitle", "time": 2664.79, "timestamp": "00:44:24", "text": "我的天啊。 让我拿根稻草来。   我的"}, {"type": "subtitle", "time": 2669.99, "timestamp": "00:44:29", "text": "天啊，我只能……"}, {"type": "subtitle", "time": 2671.91, "timestamp": "00:44:31", "text": "哦，是的。 再等一秒。 我"}, {"type": "subtitle", "time": 2677.67, "timestamp": "00:44:37", "text": "其实看过赤崎勇的《兔女郎》。"}, {"type": "subtitle", "time": 2679.349, "timestamp": "00:44:39", "text": "你已经学会了吗？"}, {"type": "subtitle", "time": 2680.71, "timestamp": "00:44:40", "text": "哦，是的。"}, {"type": "subtitle", "time": 2682.79, "timestamp": "00:44:42", "text": "哦好的。 是的，如果你能那样唱歌就"}, {"type": "subtitle", "time": 2684.71, "timestamp": "00:44:44", "text": "容易多了。"}, {"type": "subtitle", "time": 2688.39, "timestamp": "00:44:48", "text": "好的。 你好。"}, {"type": "subtitle", "time": 2690.55, "timestamp": "00:44:50", "text": "等待。 没有歌曲。 好的。 你好。"}]
[{"type": "subtitle", "time": 3962.87, "timestamp": "01:06:02", "text": "我知道即使没学过，我可能也已经知道这"}, {"type": "subtitle", "time": 3964.95, "timestamp": "01:06:04", "text": "首歌了。 但是，是"}, {"type": "subtitle", "time": 3968.39, "timestamp": "01:06:08", "text": "啊，我已经听过100"}, {"type": "subtitle", "time": 3970.63, "timestamp": "01:06:10", "text": "遍了。"}, {"type": "subtitle", "time": 3972.549, "timestamp": "01:06:12", "text": "再见。"}, {"type": "subtitle", "time": 3975.109, "timestamp": "01:06:15", "text": "是的，你是专业人士。 你唱歌"}, {"type": "subtitle", "time": 3978.789, "timestamp": "01:06:18", "text": "、即兴演奏等等方面都很专业。"}, {"type": "subtitle", "time": 3980.39, "timestamp": "01:06:20", "text": "我不能。 是的。"}, {"type": "subtitle", "time": 3981.75, "timestamp": "01:06:21", "text": "呃，还有什么？"}, {"type": "subtitle", "time": 3983.829, "timestamp": "01:06:23", "text": "实践。"}, {"type": "subtitle", "time": 3991.75, "timestamp": "01:06:31", "text": "是的，我得重新学学怎么用柠檬了。 我"}, {"type": "subtitle", "time": 3992.71, "timestamp": "01:06:32", "text": "什么都忘了。"}, {"type": "subtitle", "time": 3996.23, "timestamp": "01:06:36", "text": "我还会再听那首歌。"}, {"type": "subtitle", "time": 3999.829, "timestamp": "01:06:39", "text": "柠檬。 对，都是这些。 嗨，呃，完全"}, {"type": "subtitle", "time": 4000.87, "timestamp": "01:06:40", "text": "被迷住了。"}, {"type": "subtitle", "time": 4002.23, "timestamp": "01:06:42", "text": "对，就是"}, {"type": "subtitle", "time": 4003.67, "timestamp": "01:06:43", "text": "这个。"}, {"type": "subtitle", "time": 4006.309, "timestamp": "01:06:46", "text": "对，"}]
[{"type": "subtitle", "time": 1981.75, "timestamp": "00:33:01", "text": "发音。 如果你以后"}, {"type": "subtitle", "time": 1984.31, "timestamp": "00:33:04", "text": "想稍微改动一下，也可以。"}, {"type": "subtitle", "time": 1986.63, "timestamp": "00:33:06", "text": "这完全取决于声音。"}, {"type": "subtitle", "time": 1990.389, "timestamp": "00:33:10", "text": "莎娜，我很好奇人们是怎么做到像"}, {"type": "subtitle", "time": 1992.63, "timestamp": "00:33:12", "text": "这样写成普通文本的，对吧？ 他们是怎么像"}, {"type": "subtitle", "time": 1997.509, "timestamp": "00:33:17", "text": "试卷上那样，在上面加个小括号的？ 你"}, {"type": "subtitle", "time": 2000.149, "timestamp": "00:33:20", "text": "可能已经看到了，对吧？ 我一直很"}, {"type": "subtitle", "time": 2003.11, "timestamp": "00:33:23", "text": "好奇他们是怎么做到的，"}, {"type": "subtitle", "time": 2006.95, "timestamp": "00:33:26", "text": "就像我没有……我不知道你在"}, {"type": "subtitle", "time": 2008.47, "timestamp": "00:33:28", "text": "说什么……其实我也不"}, {"type": "subtitle", "time": 2010.63, "timestamp": "00:33:30", "text": "喜欢日语，比如如果有"}, {"type": "subtitle", "time": 2013.029, "timestamp": "00:33:33", "text": "汉字，你可能会看到用平假名"}, {"type": "subtitle", "time": 2016.95, "timestamp": "00:33:36", "text": "直接写在括号里。对，如果"}, {"type": "subtitle", "time": 2019.35, "timestamp": "00:33:39", "text": "这里也能这样，我就可以加"}, {"type": "subtitle", "time": 2024.47, "timestamp": "00:33:44", "text": "个小括号，比如“toama”之类的，"}, {"type": "subtitle", "time": 2029.11, "timestamp": "00:33:49", "text": "我想应该可以。是的，你可以手动操作。但是"}, {"type": "subtitle", "time": 2031.75, "timestamp": "00:33:51", "text": "，我猜他们可能有"}, {"type": "subtitle", "time": 2034.549, "timestamp": "00:33:54", "text": "专门的软件来制作定制的"}, {"type": "subtitle", "time": 2037.35, "timestamp": "00:33:57", "text": "纸张。 我也是这么想的。"}]
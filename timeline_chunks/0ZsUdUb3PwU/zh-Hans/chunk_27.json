[{"type": "subtitle", "time": 1627.35, "timestamp": "00:27:07", "text": "等等，那是……"}, {"type": "subtitle", "time": 1629.43, "timestamp": "00:27:09", "text": "你不必在"}, {"type": "subtitle", "time": 1631.51, "timestamp": "00:27:11", "text": "最后一部分跑得很快。 只有当你喜欢的时候，才尝试"}, {"type": "subtitle", "time": 1634.39, "timestamp": "00:27:14", "text": "用你喜欢的音乐来唱歌。   是的"}, {"type": "subtitle", "time": 1635.269, "timestamp": "00:27:15", "text": "。"}, {"type": "subtitle", "time": 1636.95, "timestamp": "00:27:16", "text": "不必强迫。 是的。 你不必"}, {"type": "subtitle", "time": 1638.63, "timestamp": "00:27:18", "text": "强迫自己唱得很快"}, {"type": "subtitle", "time": 1640.31, "timestamp": "00:27:20", "text": "。"}, {"type": "subtitle", "time": 1644.149, "timestamp": "00:27:24", "text": "在没有音乐的情况下唱歌，那就是"}]
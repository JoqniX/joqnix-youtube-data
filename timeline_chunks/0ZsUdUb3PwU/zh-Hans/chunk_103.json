[{"type": "subtitle", "time": 6181.35, "timestamp": "01:43:01", "text": "部都由那个儿子教完了，所以现在就看"}, {"type": "subtitle", "time": 6184.87, "timestamp": "01:43:04", "text": "我了，呃，要不停地"}, {"type": "subtitle", "time": 6187.99, "timestamp": "01:43:07", "text": "练习，练习，这样我才能完全"}, {"type": "subtitle", "time": 6193.03, "timestamp": "01:43:13", "text": "完成，呃，能够达到那种程度，能够把它"}, {"type": "subtitle", "time": 6199.75, "timestamp": "01:43:19", "text": "录好，能够融入很多"}, {"type": "subtitle", "time": 6201.43, "timestamp": "01:43:21", "text": "情感，唱得"}, {"type": "subtitle", "time": 6204.87, "timestamp": "01:43:24", "text": "好，等等等等。我还有一个月的时间，"}, {"type": "subtitle", "time": 6207.99, "timestamp": "01:43:27", "text": "下个月我还要录"}, {"type": "subtitle", "time": 6212.31, "timestamp": "01:43:32", "text": "另外四首歌，我的天哪，感觉就像在考验"}, {"type": "subtitle", "time": 6219.03, "timestamp": "01:43:39", "text": "我一直以来努力学习的东西。呃，"}, {"type": "subtitle", "time": 6222.149, "timestamp": "01:43:42", "text": "你知道，是的，我必须花时间"}, {"type": "subtitle", "time": 6224.39, "timestamp": "01:43:44", "text": "真正学会所有其他的"}, {"type": "subtitle", "time": 6228.229, "timestamp": "01:43:48", "text": "歌。 是的，我觉得与其让我"}, {"type": "subtitle", "time": 6231.35, "timestamp": "01:43:51", "text": "从现在开始尝试创作新歌，我不如好好"}, {"type": "subtitle", "time": 6235.669, "timestamp": "01:43:55", "text": "练习，就像"}, {"type": "subtitle", "time": 6238.87, "timestamp": "01:43:58", "text": "Das 教我的那样。  Tasan"}]
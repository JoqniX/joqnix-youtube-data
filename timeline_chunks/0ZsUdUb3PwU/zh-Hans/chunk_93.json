[{"type": "subtitle", "time": 5581.75, "timestamp": "01:33:01", "text": "。 唱歌的时候要放松"}, {"type": "subtitle", "time": 5583.43, "timestamp": "01:33:03", "text": "。 这是"}, {"type": "subtitle", "time": 5585.03, "timestamp": "01:33:05", "text": "我能给你的最重要的建议，"}, {"type": "subtitle", "time": 5587.11, "timestamp": "01:33:07", "text": "因为你的声音听起来不够"}, {"type": "subtitle", "time": 5589.04, "timestamp": "01:33:09", "text": "放松。"}, {"type": "subtitle", "time": 5591.03, "timestamp": "01:33:11", "text": "[音乐]"}, {"type": "subtitle", "time": 5594.79, "timestamp": "01:33:14", "text": "我看过那张不错的合辑。"}, {"type": "subtitle", "time": 5598.07, "timestamp": "01:33:18", "text": "我不知道是不是因为"}, {"type": "subtitle", "time": 5600.39, "timestamp": "01:33:20", "text": "Discord 的问题，因为你的声音总是感觉非常非常"}, {"type": "subtitle", "time": 5602.55, "timestamp": "01:33:22", "text": "尖锐。 即使是"}, {"type": "subtitle", "time": 5604.47, "timestamp": "01:33:24", "text": "跟我说话，我的声音听起来也"}, {"type": "subtitle", "time": 5607.11, "timestamp": "01:33:27", "text": "很尖锐吗？ 感觉像是很"}, {"type": "subtitle", "time": 5610.47, "timestamp": "01:33:30", "text": "紧张吗？"}, {"type": "subtitle", "time": 5614.95, "timestamp": "01:33:34", "text": "呃，不。 我觉得不行。"}, {"type": "subtitle", "time": 5618.229, "timestamp": "01:33:38", "text": "如果倾听自己的内心呢？"}, {"type": "subtitle", "time": 5620.229, "timestamp": "01:33:40", "text": "如果我听自己的声音，我会感到非常"}, {"type": "subtitle", "time": 5623.27, "timestamp": "01:33:43", "text": "尴尬。"}, {"type": "subtitle", "time": 5625.35, "timestamp": "01:33:45", "text": "是的，你得听听自己的内心"}, {"type": "subtitle", "time": 5628.39, "timestamp": "01:33:48", "text": "声音。 是的。 下个月试着录几次音"}, {"type": "subtitle", "time": 5631.35, "timestamp": "01:33:51", "text": "，"}, {"type": "subtitle", "time": 5634.229, "timestamp": "01:33:54", "text": "听听自己的声音，看看效果如何。   嗯，好的"}, {"type": "subtitle", "time": 5638.229, "timestamp": "01:33:58", "text": "，我会的。 谢谢。"}]
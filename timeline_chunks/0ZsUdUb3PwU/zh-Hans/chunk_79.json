[{"type": "subtitle", "time": 4757.35, "timestamp": "01:19:17", "text": "。 其实那并不是真正的尖叫"}, {"type": "subtitle", "time": 4759.83, "timestamp": "01:19:19", "text": "。"}, {"type": "subtitle", "time": 4761.99, "timestamp": "01:19:21", "text": "与其他歌词相比，这部分听起来特别特别响亮"}, {"type": "subtitle", "time": 4763.11, "timestamp": "01:19:23", "text": "。"}, {"type": "subtitle", "time": 4765.83, "timestamp": "01:19:25", "text": "对，就是那东西。   还要"}, {"type": "subtitle", "time": 4767.99, "timestamp": "01:19:27", "text": "尽量用腹式呼吸唱歌，而"}, {"type": "subtitle", "time": 4769.75, "timestamp": "01:19:29", "text": "不是用喉咙。 我认为这"}, {"type": "subtitle", "time": 4772.95, "timestamp": "01:19:32", "text": "也是你会遇到的问题之一。"}, {"type": "subtitle", "time": 4776.11, "timestamp": "01:19:36", "text": "哦，真想放声歌唱。"}, {"type": "subtitle", "time": 4777.43, "timestamp": "01:19:37", "text": "[音乐]"}, {"type": "subtitle", "time": 4781.59, "timestamp": "01:19:41", "text": "怎么说呢，嗯，试着用"}, {"type": "subtitle", "time": 4783.59, "timestamp": "01:19:43", "text": "腹式呼吸而不是用"}, {"type": "subtitle", "time": 4785.75, "timestamp": "01:19:45", "text": "肺呼吸？ 我认为这"}, {"type": "subtitle", "time": 4787.91, "timestamp": "01:19:47", "text": "是有可能的。 那确实"}, {"type": "subtitle", "time": 4791.189, "timestamp": "01:19:51", "text": "有点可能。"}, {"type": "subtitle", "time": 4796.31, "timestamp": "01:19:56", "text": "等等，怎么做到的？ 用腹式呼吸。 哦。 嗯。"}]
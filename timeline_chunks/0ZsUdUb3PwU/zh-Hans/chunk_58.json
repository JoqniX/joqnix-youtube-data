[{"type": "subtitle", "time": 3490.87, "timestamp": "00:58:10", "text": "[音乐] 是"}, {"type": "subtitle", "time": 3492.789, "timestamp": "00:58:12", "text": "啊。 是的。 你可以继续唱下去"}, {"type": "subtitle", "time": 3493.43, "timestamp": "00:58:13", "text": "。"}, {"type": "subtitle", "time": 3495.43, "timestamp": "00:58:15", "text": "超好的。"}, {"type": "subtitle", "time": 3497.19, "timestamp": "00:58:17", "text": "这其实是我第一次"}, {"type": "subtitle", "time": 3500.23, "timestamp": "00:58:20", "text": "重新唱歌。 我确实经常听到这种说法。   是的"}, {"type": "subtitle", "time": 3501.829, "timestamp": "00:58:21", "text": "。"}, {"type": "subtitle", "time": 3504.549, "timestamp": "00:58:24", "text": "我尽量经常听，"}, {"type": "subtitle", "time": 3506.549, "timestamp": "00:58:26", "text": "这样才能"}, {"type": "subtitle", "time": 3509.589, "timestamp": "00:58:29", "text": "记住。 是的，这会自然而然发生的。"}, {"type": "subtitle", "time": 3511.109, "timestamp": "00:58:31", "text": "即使你不记得歌词，"}, {"type": "subtitle", "time": 3513.829, "timestamp": "00:58:33", "text": "你也能想办法唱出来。"}, {"type": "subtitle", "time": 3515.349, "timestamp": "00:58:35", "text": "我也是这么认为的。"}, {"type": "subtitle", "time": 3517.03, "timestamp": "00:58:37", "text": "你好。"}, {"type": "subtitle", "time": 3520.309, "timestamp": "00:58:40", "text": "好的，让我来。"}, {"type": "subtitle", "time": 3522.069, "timestamp": "00:58:42", "text": "嗯。 顺便问一下，你会不伴奏唱歌吗"}, {"type": "subtitle", "time": 3522.63, "timestamp": "00:58:42", "text": "？"}, {"type": "subtitle", "time": 3524.309, "timestamp": "00:58:44", "text": "没有。 好的，"}, {"type": "subtitle", "time": 3526.15, "timestamp": "00:58:46", "text": "你可以试试不放音乐。"}]
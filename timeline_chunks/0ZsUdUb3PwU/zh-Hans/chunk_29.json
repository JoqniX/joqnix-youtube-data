[{"type": "subtitle", "time": 1741.51, "timestamp": "00:29:01", "text": "想问一下，你父母会让"}, {"type": "subtitle", "time": 1745.11, "timestamp": "00:29:05", "text": "你跟着他们一起"}, {"type": "subtitle", "time": 1746.31, "timestamp": "00:29:06", "text": "唱歌吗？ 哦，是的"}, {"type": "subtitle", "time": 1746.87, "timestamp": "00:29:06", "text": "。"}, {"type": "subtitle", "time": 1749.83, "timestamp": "00:29:09", "text": "他们现在听不到我的声音了。 我在楼上的"}, {"type": "subtitle", "time": 1752.789, "timestamp": "00:29:12", "text": "房间里。 楼上。 是的，他们在"}, {"type": "subtitle", "time": 1755.35, "timestamp": "00:29:15", "text": "楼下。"}, {"type": "subtitle", "time": 1757.19, "timestamp": "00:29:17", "text": "所以，他们听不见。 他们"}, {"type": "subtitle", "time": 1759.269, "timestamp": "00:29:19", "text": "听过你唱的难听的歌吗？"}, {"type": "subtitle", "time": 1762.47, "timestamp": "00:29:22", "text": "哦，是的，他们确实这么做了。 那件事真是"}, {"type": "subtitle", "time": 1765.75, "timestamp": "00:29:25", "text": "太奇怪了。 我当时就想，是啊，但"}, {"type": "subtitle", "time": 1767.669, "timestamp": "00:29:27", "text": "我不想听别人听我"}, {"type": "subtitle", "time": 1770.07, "timestamp": "00:29:30", "text": "唱歌。 他们说，我在说"}, {"type": "subtitle", "time": 1773.11, "timestamp": "00:29:33", "text": "中文、日语之类的语言。"}, {"type": "subtitle", "time": 1775.11, "timestamp": "00:29:35", "text": "他们当时一无所知。 然后有一天，我妈妈"}, {"type": "subtitle", "time": 1777.99, "timestamp": "00:29:37", "text": "撞见了我，大概是"}, {"type": "subtitle", "time": 1780.63, "timestamp": "00:29:40", "text": "两年前，我刚开始"}, {"type": "subtitle", "time": 1783.83, "timestamp": "00:29:43", "text": "了解那个Reml的"}, {"type": "subtitle", "time": 1786.23, "timestamp": "00:29:46", "text": "故事的时候。 啊，该睡觉了。 她"}, {"type": "subtitle", "time": 1788.07, "timestamp": "00:29:48", "text": "现在就走过去了。 她问：“哦，你在"}, {"type": "subtitle", "time": 1789.909, "timestamp": "00:29:49", "text": "唱歌吗？”"}, {"type": "subtitle", "time": 1791.909, "timestamp": "00:29:51", "text": "然后我就说：“哦，你下来吧。不，"}, {"type": "subtitle", "time": 1793.99, "timestamp": "00:29:53", "text": "别来。我不听。走，"}, {"type": "subtitle", "time": 1796.789, "timestamp": "00:29:56", "text": "走开。” 我当时尴尬极了。"}, {"type": "subtitle", "time": 1799.909, "timestamp": "00:29:59", "text": "天哪，太疼了。"}]
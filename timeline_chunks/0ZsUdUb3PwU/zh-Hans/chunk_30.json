[{"type": "subtitle", "time": 1802.549, "timestamp": "00:30:02", "text": "你呢？ 你在"}, {"type": "subtitle", "time": 1803.43, "timestamp": "00:30:03", "text": "父母面前唱歌时有自信吗？   是的"}, {"type": "subtitle", "time": 1807.19, "timestamp": "00:30:07", "text": "。 是的。 因为我的"}, {"type": "subtitle", "time": 1809.75, "timestamp": "00:30:09", "text": "妈妈现在"}, {"type": "subtitle", "time": 1812.07, "timestamp": "00:30:12", "text": "就睡在我旁边"}, {"type": "subtitle", "time": 1816.149, "timestamp": "00:30:16", "text": "。"}, {"type": "subtitle", "time": 1824.149, "timestamp": "00:30:24", "text": "我当时就想，是啊，她其实在"}, {"type": "subtitle", "time": 1827.11, "timestamp": "00:30:27", "text": "睡觉，因为"}, {"type": "subtitle", "time": 1832.789, "timestamp": "00:30:32", "text": "摆放电脑和所有设备的卧室就像是我父母的卧室。 所以"}, {"type": "subtitle", "time": 1834.71, "timestamp": "00:30:34", "text": "我就只能时不时地录点"}, {"type": "subtitle", "time": 1836.789, "timestamp": "00:30:36", "text": "东西，他们"}, {"type": "subtitle", "time": 1838.389, "timestamp": "00:30:38", "text": "经常能听到我唱歌"}, {"type": "subtitle", "time": 1841.669, "timestamp": "00:30:41", "text": "。 实际上，他们经常"}, {"type": "subtitle", "time": 1843.51, "timestamp": "00:30:43", "text": "说我不会唱歌之类的，还总是唱一些"}, {"type": "subtitle", "time": 1845.909, "timestamp": "00:30:45", "text": "奇怪的日本歌曲。 大概就是"}, {"type": "subtitle", "time": 1847.59, "timestamp": "00:30:47", "text": "这样。"}, {"type": "subtitle", "time": 1849.43, "timestamp": "00:30:49", "text": "他们懂日语吗？"}, {"type": "subtitle", "time": 1851.669, "timestamp": "00:30:51", "text": "没有。   是的"}, {"type": "subtitle", "time": 1853.669, "timestamp": "00:30:53", "text": "。 但他们好像知道我"}, {"type": "subtitle", "time": 1855.669, "timestamp": "00:30:55", "text": "唱的是日语歌。 当然，那仍然是“"}, {"type": "chat", "time": 1859.208, "timestamp": "00:30:59", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "hewwo"}]
[{"type": "subtitle", "time": 1741.51, "timestamp": "00:29:01", "text": "想問一下，你父母會讓"}, {"type": "subtitle", "time": 1745.11, "timestamp": "00:29:05", "text": "你跟著他們一起"}, {"type": "subtitle", "time": 1746.31, "timestamp": "00:29:06", "text": "唱歌嗎？哦，"}, {"type": "subtitle", "time": 1746.87, "timestamp": "00:29:06", "text": "是的。"}, {"type": "subtitle", "time": 1749.83, "timestamp": "00:29:09", "text": "他們現在聽不到我的聲音了。我在樓上的"}, {"type": "subtitle", "time": 1752.789, "timestamp": "00:29:12", "text": "房間。樓上。是的，他們在"}, {"type": "subtitle", "time": 1755.35, "timestamp": "00:29:15", "text": "樓下。"}, {"type": "subtitle", "time": 1757.19, "timestamp": "00:29:17", "text": "所以，他們聽不見。他們"}, {"type": "subtitle", "time": 1759.269, "timestamp": "00:29:19", "text": "聽過你唱的難聽的歌嗎？"}, {"type": "subtitle", "time": 1762.47, "timestamp": "00:29:22", "text": "哦，是的，他們確實這麼做了。那件事真是"}, {"type": "subtitle", "time": 1765.75, "timestamp": "00:29:25", "text": "太奇怪了。我當時就想，是啊，但"}, {"type": "subtitle", "time": 1767.669, "timestamp": "00:29:27", "text": "我不想聽別人聽我"}, {"type": "subtitle", "time": 1770.07, "timestamp": "00:29:30", "text": "唱歌。他們說，我在說"}, {"type": "subtitle", "time": 1773.11, "timestamp": "00:29:33", "text": "中文、日文之類的語言。"}, {"type": "subtitle", "time": 1775.11, "timestamp": "00:29:35", "text": "他們當時一無所知。然後有一天，我媽媽"}, {"type": "subtitle", "time": 1777.99, "timestamp": "00:29:37", "text": "撞見了我，大概是"}, {"type": "subtitle", "time": 1780.63, "timestamp": "00:29:40", "text": "兩年前，我才剛開始"}, {"type": "subtitle", "time": 1783.83, "timestamp": "00:29:43", "text": "了解那個Reml的"}, {"type": "subtitle", "time": 1786.23, "timestamp": "00:29:46", "text": "故事的時候。啊，該睡覺了。她"}, {"type": "subtitle", "time": 1788.07, "timestamp": "00:29:48", "text": "現在就走過去了。她問：「哦，你在"}, {"type": "subtitle", "time": 1789.909, "timestamp": "00:29:49", "text": "唱歌嗎？」"}, {"type": "subtitle", "time": 1791.909, "timestamp": "00:29:51", "text": "然後我就說：「哦，你下來吧。不，"}, {"type": "subtitle", "time": 1793.99, "timestamp": "00:29:53", "text": "別來。我不聽。走，"}, {"type": "subtitle", "time": 1796.789, "timestamp": "00:29:56", "text": "走開。」我當時尷尬極了。"}, {"type": "subtitle", "time": 1799.909, "timestamp": "00:29:59", "text": "天哪，太痛了。"}]
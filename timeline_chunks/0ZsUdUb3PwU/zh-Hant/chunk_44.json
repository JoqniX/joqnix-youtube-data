[{"type": "subtitle", "time": 2640.15, "timestamp": "00:44:00", "text": "你學會了嗎？"}, {"type": "subtitle", "time": 2642.63, "timestamp": "00:44:02", "text": "呃，"}, {"type": "subtitle", "time": 2645.03, "timestamp": "00:44:05", "text": "有時候我必須不斷"}, {"type": "subtitle", "time": 2647.99, "timestamp": "00:44:07", "text": "練習，因為它現在速度很快，而且段落很多。"}, {"type": "subtitle", "time": 2660.71, "timestamp": "00:44:20", "text": "你可以開始唱歌了。"}, {"type": "subtitle", "time": 2664.79, "timestamp": "00:44:24", "text": "我的天啊。讓我拿根稻草來。  我的"}, {"type": "subtitle", "time": 2669.99, "timestamp": "00:44:29", "text": "天啊，我只能……"}, {"type": "subtitle", "time": 2682.79, "timestamp": "00:44:42", "text": "哦，是的。再等一秒。我其實看過赤崎勇的《兔女郎》。你已經學會了嗎？  哦，是的。  哦好的。是的，如果你能那樣唱歌就"}, {"type": "subtitle", "time": 2684.71, "timestamp": "00:44:44", "text": "容易多了。"}, {"type": "subtitle", "time": 2688.39, "timestamp": "00:44:48", "text": "好的。你好。"}]
[{"type": "subtitle", "time": 123.19, "timestamp": "00:02:03", "text": "我馬上就放上去"}, {"type": "subtitle", "time": 125.35, "timestamp": "00:02:05", "text": "。"}, {"type": "subtitle", "time": 126.95, "timestamp": "00:02:06", "text": "嗯，"}, {"type": "subtitle", "time": 131.51, "timestamp": "00:02:11", "text": "感覺有點傷感，但同時又有點"}, {"type": "subtitle", "time": 134.22899999999998, "timestamp": "00:02:14", "text": "高興，因為"}, {"type": "subtitle", "time": 137.27, "timestamp": "00:02:17", "text": "接下來的一個月，整個月都將"}, {"type": "subtitle", "time": 139.91, "timestamp": "00:02:19", "text": "用於練習，再下一個月則完全"}, {"type": "subtitle", "time": 142.15, "timestamp": "00:02:22", "text": "用於錄音"}, {"type": "subtitle", "time": 143.589, "timestamp": "00:02:23", "text": "。"}, {"type": "subtitle", "time": 144.15, "timestamp": "00:02:24", "text": "哦，對，"}, {"type": "subtitle", "time": 145.35, "timestamp": "00:02:25", "text": "這就是計劃。"}, {"type": "subtitle", "time": 148.15, "timestamp": "00:02:28", "text": "十月，對吧？只有到那時"}, {"type": "subtitle", "time": 152.22899999999998, "timestamp": "00:02:32", "text": "你才會開始錄音。"}, {"type": "subtitle", "time": 154.22899999999998, "timestamp": "00:02:34", "text": "我想你已經開始製作"}, {"type": "subtitle", "time": 156.309, "timestamp": "00:02:36", "text": "音樂影片了吧？"}, {"type": "subtitle", "time": 159.19, "timestamp": "00:02:39", "text": "音樂影片。問題是我"}, {"type": "subtitle", "time": 161.75, "timestamp": "00:02:41", "text": "不確定我是否應該繼續工作，我已經完成了我的"}, {"type": "subtitle", "time": 164.07, "timestamp": "00:02:44", "text": "個人獨奏版本"}, {"type": "subtitle", "time": 165.91, "timestamp": "00:02:45", "text": "。"}, {"type": "subtitle", "time": 168.869, "timestamp": "00:02:48", "text": "我當時想，也許我會在大學期間回來把"}, {"type": "subtitle", "time": 172.47, "timestamp": "00:02:52", "text": "它完成，"}, {"type": "subtitle", "time": 174.55, "timestamp": "00:02:54", "text": "因為不然的話，如果音樂視頻出了什麼問題，我就"}, {"type": "subtitle", "time": 177.75, "timestamp": "00:02:57", "text": "很難修改了"}]
[{"type": "subtitle", "time": 2460.87, "timestamp": "00:41:00", "text": "保存歌詞。"}, {"type": "subtitle", "time": 2463.03, "timestamp": "00:41:03", "text": "哦，是的。你說你把它寫在"}, {"type": "subtitle", "time": 2464.55, "timestamp": "00:41:04", "text": "書裡了。"}, {"type": "subtitle", "time": 2467.03, "timestamp": "00:41:07", "text": "是的。"}, {"type": "subtitle", "time": 2469.27, "timestamp": "00:41:09", "text": "如果你願意的話，它或許"}, {"type": "subtitle", "time": 2471.03, "timestamp": "00:41:11", "text": "對你"}, {"type": "subtitle", "time": 2474.309, "timestamp": "00:41:14", "text": "學習日文真的很有幫助。可以透過寫作來了解和學習"}, {"type": "subtitle", "time": 2477.27, "timestamp": "00:41:17", "text": "。是的。"}, {"type": "subtitle", "time": 2480.55, "timestamp": "00:41:20", "text": "啊，是啊，我真的想學"}, {"type": "subtitle", "time": 2482.87, "timestamp": "00:41:22", "text": "日文歌，例如有一天能用"}, {"type": "subtitle", "time": 2486.23, "timestamp": "00:41:26", "text": "日文寫歌，而不是寫浪漫的歌"}, {"type": "subtitle", "time": 2489.51, "timestamp": "00:41:29", "text": "。"}, {"type": "subtitle", "time": 2494.47, "timestamp": "00:41:34", "text": "好的。呃，八號在哪裡？我需要學一些歌"}, {"type": "subtitle", "time": 2497.51, "timestamp": "00:41:37", "text": "。我覺得娃娃故事很有趣。"}, {"type": "subtitle", "time": 2500.39, "timestamp": "00:41:40", "text": "食肉計劃。好的。"}, {"type": "subtitle", "time": 2503.67, "timestamp": "00:41:43", "text": "等待。我拿出我的複習清單。等等"}, {"type": "subtitle", "time": 2505.51, "timestamp": "00:41:45", "text": "。"}, {"type": "subtitle", "time": 2509.829, "timestamp": "00:41:49", "text": "哦，等等。好的。呃，瑞斯。所以，嗯，算是"}, {"type": "subtitle", "time": 2513.67, "timestamp": "00:41:53", "text": "計劃好的。呃，故事"}, {"type": "subtitle", "time": 2517.829, "timestamp": "00:41:57", "text": "講到午夜。我已經完成了。對，就是這個"}]
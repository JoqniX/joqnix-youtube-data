[{"type": "subtitle", "time": 1802.549, "timestamp": "00:30:02", "text": "你呢？"}, {"type": "subtitle", "time": 1803.43, "timestamp": "00:30:03", "text": "在父母面前唱歌時有自信嗎？  是的。是的"}, {"type": "subtitle", "time": 1807.19, "timestamp": "00:30:07", "text": "。因為我的"}, {"type": "subtitle", "time": 1809.75, "timestamp": "00:30:09", "text": "媽媽"}, {"type": "subtitle", "time": 1816.149, "timestamp": "00:30:16", "text": "現在就睡在我旁邊。"}, {"type": "subtitle", "time": 1824.149, "timestamp": "00:30:24", "text": "我當時就想，是啊，她其實在"}, {"type": "subtitle", "time": 1827.11, "timestamp": "00:30:27", "text": "睡覺，因為"}, {"type": "subtitle", "time": 1832.789, "timestamp": "00:30:32", "text": "擺放電腦和所有設備的臥室就像是我父母的臥室。所以"}, {"type": "subtitle", "time": 1834.71, "timestamp": "00:30:34", "text": "我就只能"}, {"type": "subtitle", "time": 1836.789, "timestamp": "00:30:36", "text": "時不時錄點東西，他們"}, {"type": "subtitle", "time": 1838.389, "timestamp": "00:30:38", "text": "常常能聽到我唱歌"}, {"type": "subtitle", "time": 1841.669, "timestamp": "00:30:41", "text": "。實際上，他們經常"}, {"type": "subtitle", "time": 1843.51, "timestamp": "00:30:43", "text": "說我不會唱歌之類的，總是唱一些"}, {"type": "subtitle", "time": 1845.909, "timestamp": "00:30:45", "text": "奇怪的日本歌曲。大概就是這樣。"}, {"type": "subtitle", "time": 1849.43, "timestamp": "00:30:49", "text": "他們懂日文嗎？"}, {"type": "subtitle", "time": 1851.669, "timestamp": "00:30:51", "text": "沒有。  是的。"}, {"type": "subtitle", "time": 1853.669, "timestamp": "00:30:53", "text": "但他們好像知道我"}, {"type": "subtitle", "time": 1855.669, "timestamp": "00:30:55", "text": "唱的是日文歌。當然，那仍然是「"}, {"type": "chat", "time": 1859.208, "timestamp": "00:30:59", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "hewwo"}]
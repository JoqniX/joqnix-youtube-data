[{"type": "subtitle", "time": 2163.829, "timestamp": "00:36:03", "text": "你昨天練習得怎麼樣"}, {"type": "subtitle", "time": 2164.87, "timestamp": "00:36:04", "text": "？"}, {"type": "subtitle", "time": 2167.589, "timestamp": "00:36:07", "text": "是的，我睡前做了。我當時就想，我"}, {"type": "subtitle", "time": 2170.23, "timestamp": "00:36:10", "text": "在 Google Keep 上打開了這個小實驗，"}, {"type": "subtitle", "time": 2174.23, "timestamp": "00:36:14", "text": "然後躺在床上跟著唱。  好的。好的。謝謝。  再見。  你好。"}, {"type": "subtitle", "time": 2183.03, "timestamp": "00:36:23", "text": "你可以從一開始就唱歌。"}, {"type": "subtitle", "time": 2198.87, "timestamp": "00:36:38", "text": "[音樂] 前進！  【音樂】"}, {"type": "subtitle", "time": 2201.83, "timestamp": "00:36:41", "text": "外國的！外國的！"}]
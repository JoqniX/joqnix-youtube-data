[{"type": "subtitle", "time": 1981.75, "timestamp": "00:33:01", "text": "發音。如果你以後想"}, {"type": "subtitle", "time": 1984.31, "timestamp": "00:33:04", "text": "稍微改動一下，也可以。"}, {"type": "subtitle", "time": 1986.63, "timestamp": "00:33:06", "text": "這完全取決於聲音。"}, {"type": "subtitle", "time": 1990.389, "timestamp": "00:33:10", "text": "莎娜，我很好奇人們是"}, {"type": "subtitle", "time": 1992.63, "timestamp": "00:33:12", "text": "怎麼做到像這樣寫成普通文本的，對吧？他們是怎麼"}, {"type": "subtitle", "time": 1995.19, "timestamp": "00:33:15", "text": "像考卷上那樣，在上面加個小括號的？"}, {"type": "subtitle", "time": 1997.509, "timestamp": "00:33:17", "text": "你"}, {"type": "subtitle", "time": 2000.149, "timestamp": "00:33:20", "text": "可能已經看到了，對吧？我一直很"}, {"type": "subtitle", "time": 2003.11, "timestamp": "00:33:23", "text": "好奇他們是怎麼做到的，"}, {"type": "subtitle", "time": 2006.95, "timestamp": "00:33:26", "text": "就像我沒有……我不知道你在"}, {"type": "subtitle", "time": 2008.47, "timestamp": "00:33:28", "text": "說什麼……其實我也不"}, {"type": "subtitle", "time": 2010.63, "timestamp": "00:33:30", "text": "喜歡日語，比如如果有"}, {"type": "subtitle", "time": 2013.029, "timestamp": "00:33:33", "text": "漢字，你可能會看到用平假名"}, {"type": "subtitle", "time": 2016.95, "timestamp": "00:33:36", "text": "直接寫在括號裡。對，如果"}, {"type": "subtitle", "time": 2019.35, "timestamp": "00:33:39", "text": "這裡也能這樣，我就可以加"}, {"type": "subtitle", "time": 2024.47, "timestamp": "00:33:44", "text": "個小括號，像是「toama」之"}, {"type": "subtitle", "time": 2025.75, "timestamp": "00:33:45", "text": "類的，我"}, {"type": "subtitle", "time": 2029.11, "timestamp": "00:33:49", "text": "想應該可以。是的，你可以手動操作。但是"}, {"type": "subtitle", "time": 2031.75, "timestamp": "00:33:51", "text": "，我猜他們可能有"}, {"type": "subtitle", "time": 2034.549, "timestamp": "00:33:54", "text": "專門的軟體來製作客製化的"}, {"type": "subtitle", "time": 2037.35, "timestamp": "00:33:57", "text": "紙張。我也是這麼想的。"}]
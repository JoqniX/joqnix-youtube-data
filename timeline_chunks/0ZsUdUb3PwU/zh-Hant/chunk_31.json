[{"type": "subtitle", "time": 1863.99, "timestamp": "00:31:03", "text": "好的。你好。是的。前進。再一次。"}, {"type": "subtitle", "time": 1868.95, "timestamp": "00:31:08", "text": "好了，"}, {"type": "subtitle", "time": 1871.75, "timestamp": "00:31:11", "text": "讓我喝杯綠茶。一秒鐘。"}, {"type": "subtitle", "time": 1906.74, "timestamp": "00:31:46", "text": "她又來了"}]
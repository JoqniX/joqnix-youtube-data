[{"type": "subtitle", "time": 60.63, "timestamp": "00:01:00", "text": "這首歌三個月，"}, {"type": "subtitle", "time": 63.11, "timestamp": "00:01:03", "text": "每天都唱。真是"}, {"type": "subtitle", "time": 66.789, "timestamp": "00:01:06", "text": "太好了。它讓我擺脫了很多"}, {"type": "subtitle", "time": 69.51, "timestamp": "00:01:09", "text": "悲傷的想法之類的。因此"}, {"type": "subtitle", "time": 71.83, "timestamp": "00:01:11", "text": "。  是的。"}, {"type": "subtitle", "time": 73.03, "timestamp": "00:01:13", "text": "我不想讓氣氛變得太"}, {"type": "subtitle", "time": 75.429, "timestamp": "00:01:15", "text": "壓抑。"}, {"type": "subtitle", "time": 78.789, "timestamp": "00:01:18", "text": "是的。傑克，你好嗎？對了，"}, {"type": "subtitle", "time": 85.27, "timestamp": "00:01:25", "text": "。  是的。"}, {"type": "subtitle", "time": 87.749, "timestamp": "00:01:27", "text": "日語課進行得怎麼樣？"}, {"type": "subtitle", "time": 90.55, "timestamp": "00:01:30", "text": "呃，還沒開始。我"}, {"type": "subtitle", "time": 93.59, "timestamp": "00:01:33", "text": "估計大概會在本月底或"}, {"type": "subtitle", "time": 96.95, "timestamp": "00:01:36", "text": "下個月開始。我還在等"}, {"type": "subtitle", "time": 104.069, "timestamp": "00:01:44", "text": "那"}, {"type": "subtitle", "time": 105.83, "timestamp": "00:01:45", "text": "我得重新安排"}, {"type": "subtitle", "time": 108.31, "timestamp": "00:01:48", "text": "一切了。按時睡覺，按時起床"}, {"type": "subtitle", "time": 111.27000000000001, "timestamp": "00:01:51", "text": "。"}, {"type": "subtitle", "time": 116.63, "timestamp": "00:01:56", "text": "，那我們就先從標誌牌開始吧"}, {"type": "subtitle", "time": 118.709, "timestamp": "00:01:58", "text": "。好的，你把你的直播畫面傳給我，"}]
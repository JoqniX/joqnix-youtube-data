[{"type": "subtitle", "time": 180.07, "timestamp": "00:03:00", "text": "。但這"}, {"type": "subtitle", "time": 182.229, "timestamp": "00:03:02", "text": "就是為什麼我一直沒動手的原因，我需要更多靈感，"}, {"type": "subtitle", "time": 187.91, "timestamp": "00:03:07", "text": "我想"}, {"type": "subtitle", "time": 193.67, "timestamp": "00:03:13", "text": "為MV創作更多想法，所以我正在尋找"}, {"type": "subtitle", "time": 196.63, "timestamp": "00:03:16", "text": "更多靈感。是的。  是的。  老兄，"}, {"type": "subtitle", "time": 200.71, "timestamp": "00:03:20", "text": "我還是不懂你是怎麼"}, {"type": "subtitle", "time": 203.589, "timestamp": "00:03:23", "text": "做到的。不過音樂錄影帶倒是挺不錯的。哇，真是太棒了。  哦"}, {"type": "subtitle", "time": 207.50900000000001, "timestamp": "00:03:27", "text": "。哦，是的。哦，是的。嗯，是《"}, {"type": "subtitle", "time": 210.869, "timestamp": "00:03:30", "text": "Myth》的音樂錄影帶。我就是我創造的這個樣子。"}, {"type": "subtitle", "time": 212.869, "timestamp": "00:03:32", "text": "實際上已經完成了。我"}, {"type": "subtitle", "time": 215.67000000000002, "timestamp": "00:03:35", "text": "需要解決一下音訊方面的問題，"}, {"type": "subtitle", "time": 219.27, "timestamp": "00:03:39", "text": "因為我覺得混音"}, {"type": "subtitle", "time": 221.35, "timestamp": "00:03:41", "text": "不太好。所以，我只是想"}, {"type": "subtitle", "time": 224.22899999999998, "timestamp": "00:03:44", "text": "稍微修補一下。它很快就會"}, {"type": "subtitle", "time": 225.75, "timestamp": "00:03:45", "text": "發布，所以你很可能很快就能"}, {"type": "subtitle", "time": 228.789, "timestamp": "00:03:48", "text": "看到。"}, {"type": "subtitle", "time": 230.949, "timestamp": "00:03:50", "text": "那太好了。  是的。"}, {"type": "subtitle", "time": 233.82999999999998, "timestamp": "00:03:53", "text": "我該怎麼做？但是，你知道，我從鄧西那裡"}, {"type": "subtitle", "time": 236.789, "timestamp": "00:03:56", "text": "學到了一些基本知識"}]
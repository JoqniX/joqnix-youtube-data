[{"type": "subtitle", "time": 1.91, "timestamp": "00:00:01", "text": "哦，是的"}, {"type": "subtitle", "time": 5.67, "timestamp": "00:00:05", "text": "。這是怎麼回事？嘿，你開始"}, {"type": "subtitle", "time": 7.99, "timestamp": "00:00:07", "text": "直播了嗎？我只是想確認一下。"}, {"type": "subtitle", "time": 11.19, "timestamp": "00:00:11", "text": "我剛開始。我等一下，讓我再"}, {"type": "subtitle", "time": 13.27, "timestamp": "00:00:13", "text": "確認一下我是否在線上。"}, {"type": "subtitle", "time": 14.789, "timestamp": "00:00:14", "text": "好的。"}, {"type": "subtitle", "time": 18.79, "timestamp": "00:00:18", "text": "呃，我應該在直播了。是的，我正在直播。你好"}, {"type": "subtitle", "time": 22.39, "timestamp": "00:00:22", "text": "。是的，這將是最後一堂"}, {"type": "subtitle", "time": 24.55, "timestamp": "00:00:24", "text": "歌唱課，"}, {"type": "subtitle", "time": 28.39, "timestamp": "00:00:28", "text": "嗯，這首歌是在美麗的六月裡唱的。"}, {"type": "subtitle", "time": 29.99, "timestamp": "00:00:29", "text": "你好。  是的"}, {"type": "subtitle", "time": 33.99, "timestamp": "00:00:33", "text": "。大家好。"}, {"type": "subtitle", "time": 35.83, "timestamp": "00:00:35", "text": "感覺就像我們要"}, {"type": "subtitle", "time": 37.67, "timestamp": "00:00:37", "text": "和這個團隊告別了。"}, {"type": "subtitle", "time": 41.43, "timestamp": "00:00:41", "text": "是的，的確如此。這首歌在"}, {"type": "subtitle", "time": 43.75, "timestamp": "00:00:43", "text": "我心中很久了。這"}, {"type": "subtitle", "time": 46.47, "timestamp": "00:00:46", "text": "就是我想要教你的原因，我真的很"}, {"type": "subtitle", "time": 48.229, "timestamp": "00:00:48", "text": "喜歡這首歌。"}, {"type": "subtitle", "time": 50.31, "timestamp": "00:00:50", "text": "就像我該怎麼說呢，大概"}, {"type": "subtitle", "time": 53.75, "timestamp": "00:00:53", "text": "三年前，我第一次"}, {"type": "subtitle", "time": 56.069, "timestamp": "00:00:56", "text": "聽到他的歌，我真的很"}, {"type": "subtitle", "time": 58.869, "timestamp": "00:00:58", "text": "喜歡他。我想我會堅持唱"}]
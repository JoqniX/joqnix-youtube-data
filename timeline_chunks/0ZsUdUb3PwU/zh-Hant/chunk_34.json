[{"type": "subtitle", "time": 2040.549, "timestamp": "00:34:00", "text": "所以，是的，"}, {"type": "subtitle", "time": 2043.43, "timestamp": "00:34:03", "text": "你可以評論"}, {"type": "subtitle", "time": 2046.07, "timestamp": "00:34:06", "text": "提醒你發音。  哦"}, {"type": "subtitle", "time": 2048.71, "timestamp": "00:34:08", "text": "。哦，是的。評論才是關鍵。  是的。"}, {"type": "subtitle", "time": 2053.03, "timestamp": "00:34:13", "text": "我該如何發表評論？哦，是這個。  是的，"}, {"type": "subtitle", "time": 2056.869, "timestamp": "00:34:16", "text": "但感覺還不錯。  哦，"}, {"type": "subtitle", "time": 2069.909, "timestamp": "00:34:29", "text": "它會放在旁邊。哦好的。  是的。"}, {"type": "subtitle", "time": 2074.069, "timestamp": "00:34:34", "text": "哦，這太好了。"}, {"type": "subtitle", "time": 2078.79, "timestamp": "00:34:38", "text": "我仍然不知道這一點。  我根本不用這個。  是的。"}, {"type": "subtitle", "time": 2083.109, "timestamp": "00:34:43", "text": "等等，你會把"}, {"type": "subtitle", "time": 2086.389, "timestamp": "00:34:46", "text": "喜歡的歌曲的歌詞記在哪裡呢？"}, {"type": "subtitle", "time": 2089.349, "timestamp": "00:34:49", "text": "問題是我不保存那種"}, {"type": "subtitle", "time": 2091.43, "timestamp": "00:34:51", "text": "東西。我把所有這些英文"}, {"type": "subtitle", "time": 2093.909, "timestamp": "00:34:53", "text": "翻譯歌詞都"}, {"type": "subtitle", "time": 2096.629, "timestamp": "00:34:56", "text": "記在一本書裡。"}, {"type": "subtitle", "time": 2099.109, "timestamp": "00:34:59", "text": "我通常就是直接去"}]
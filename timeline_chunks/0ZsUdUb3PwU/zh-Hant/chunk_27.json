[{"type": "subtitle", "time": 1627.35, "timestamp": "00:27:07", "text": "等等，那是…"}, {"type": "subtitle", "time": 1629.43, "timestamp": "00:27:09", "text": "你不必在"}, {"type": "subtitle", "time": 1631.51, "timestamp": "00:27:11", "text": "最後一部分跑得很快。只有當你喜歡的時候，才嘗試"}, {"type": "subtitle", "time": 1634.39, "timestamp": "00:27:14", "text": "用你喜歡的音樂來唱歌。  是的。"}, {"type": "subtitle", "time": 1636.95, "timestamp": "00:27:16", "text": "不必強迫。是的。你"}, {"type": "subtitle", "time": 1638.63, "timestamp": "00:27:18", "text": "不必強迫自己唱得"}, {"type": "subtitle", "time": 1640.31, "timestamp": "00:27:20", "text": "很快。"}, {"type": "subtitle", "time": 1644.149, "timestamp": "00:27:24", "text": "在沒有音樂的情況下唱歌，那就是"}]
[{"type": "subtitle", "time": 2101.91, "timestamp": "00:35:01", "text": "搜索，然後問：這首歌叫什麼名字？我想Suki有一首歌，"}, {"type": "subtitle", "time": 2108.15, "timestamp": "00:35:08", "text": "最近我在VC裡試著唱這首歌"}, {"type": "subtitle", "time": 2111.43, "timestamp": "00:35:11", "text": "給K聽，然後我就想，Suki有一首歌對吧"}, {"type": "subtitle", "time": 2114.23, "timestamp": "00:35:14", "text": "？我不"}, {"type": "subtitle", "time": 2123.99, "timestamp": "00:35:23", "text": "你知道那首歌嗎？」"}, {"type": "subtitle", "time": 2126.47, "timestamp": "00:35:26", "text": "我好像聽過。  就像"}, {"type": "subtitle", "time": 2130.95, "timestamp": "00:35:30", "text": "[音樂] 是的。是的。"}, {"type": "subtitle", "time": 2133.349, "timestamp": "00:35:33", "text": "那首歌。我努力想回想歌詞，但我就是想不起來歌詞，也想不起來歌名。  是的，這對我來說確實很難，"}, {"type": "subtitle", "time": 2137.27, "timestamp": "00:35:37", "text": "但我偶爾還是能想起一些"}, {"type": "subtitle", "time": 2142.15, "timestamp": "00:35:42", "text": "事情。差不多就是這樣"}, {"type": "subtitle", "time": 2150.069, "timestamp": "00:35:50", "text": "。"}, {"type": "subtitle", "time": 2152.71, "timestamp": "00:35:52", "text": "我依靠記憶力。記憶力短暫且有限"}]
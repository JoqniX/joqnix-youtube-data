[{"type": "subtitle", "time": 1938.07, "timestamp": "00:32:18", "text": "哦，天哪，又來了。"}, {"type": "subtitle", "time": 1941.269, "timestamp": "00:32:21", "text": "它沒有斷電。嗯，這"}, {"type": "subtitle", "time": 1943.75, "timestamp": "00:32:23", "text": "肯定沒有切斷最後一個。"}, {"type": "subtitle", "time": 1955.669, "timestamp": "00:32:35", "text": "確實有點……你"}, {"type": "subtitle", "time": 1964.07, "timestamp": "00:32:44", "text": "沒關係。你可能會習慣"}, {"type": "subtitle", "time": 1965.35, "timestamp": "00:32:45", "text": "練習。"}, {"type": "subtitle", "time": 1970.47, "timestamp": "00:32:50", "text": "[音樂]"}, {"type": "subtitle", "time": 1973.75, "timestamp": "00:32:53", "text": "我應該就這麼做嗎？"}, {"type": "subtitle", "time": 1977.99, "timestamp": "00:32:57", "text": "我不知道。我覺得應該盡量"}, {"type": "subtitle", "time": 1979.75, "timestamp": "00:32:59", "text": "用原來的"}]
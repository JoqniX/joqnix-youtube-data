[{"type": "subtitle", "time": 5914.229, "timestamp": "01:38:34", "text": "うん。 うん。  「うん」って言った時の気持ち"}, {"type": "subtitle", "time": 5923.83, "timestamp": "01:38:43", "text": "少し落ち込んでいるけれど、"}, {"type": "subtitle", "time": 5925.51, "timestamp": "01:38:45", "text": "ご存知のように、残りの"}, {"type": "subtitle", "time": 5928.07, "timestamp": "01:38:48", "text": "歌詞を歌っていくと、少しずつ力強さを増していくんです。"}, {"type": "subtitle", "time": 5928.79, "timestamp": "01:38:48", "text": "あ、こんにちは。"}, {"type": "subtitle", "time": 5930.229, "timestamp": "01:38:50", "text": "そう、あれは"}, {"type": "subtitle", "time": 5931.35, "timestamp": "01:38:51", "text": "そうやって歌うのが正しいんだよ。"}, {"type": "subtitle", "time": 5933.669, "timestamp": "01:38:53", "text": "ああ、神様、ここでもっと下へ降りて、"}, {"type": "subtitle", "time": 5936.07, "timestamp": "01:38:56", "text": "それからここでもっと上へ降りなければならない。 わかった。"}, {"type": "subtitle", "time": 5937.03, "timestamp": "01:38:57", "text": "うん。   よし"}, {"type": "subtitle", "time": 5939.83, "timestamp": "01:38:59", "text": "。   まるでぴったりとフィットしているような、すごく"}]
[{"type": "subtitle", "time": 7501.75, "timestamp": "02:05:01", "text": "みんなのPNG画像を見て、"}, {"type": "subtitle", "time": 7507.669, "timestamp": "02:05:07", "text": "Discordで共有しているPNG画像がどこにあるか調べて、"}, {"type": "subtitle", "time": 7512.31, "timestamp": "02:05:12", "text": "PNGをダウンロードしてNotionにアップロードすればいいんだよね。そうやって"}, {"type": "subtitle", "time": 7519.669, "timestamp": "02:05:19", "text": "コラボ用のデータベースを運用してるんだよね。Notionを"}, {"type": "subtitle", "time": 7523.99, "timestamp": "02:05:23", "text": "維持して、その作業ができるんだよね。その方が"}, {"type": "subtitle", "time": 7544.39, "timestamp": "02:05:44", "text": "、今はできないけど。でも、まだ考えているところ"}, {"type": "subtitle", "time": 7549.98, "timestamp": "02:05:49", "text": "。それで、"}]
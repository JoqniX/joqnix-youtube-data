[{"type": "subtitle", "time": 7177.27, "timestamp": "01:59:37", "text": "オーケー。えっと、これをやらせてください。Regen"}, {"type": "subtitle", "time": 7180.55, "timestamp": "01:59:40", "text": "で何か作りたいんです。"}, {"type": "subtitle", "time": 7185.75, "timestamp": "01:59:45", "text": "将来的に何かを売ったり、依頼を受けたりとか。よくわかりませんが"}, {"type": "subtitle", "time": 7197.43, "timestamp": "01:59:57", "text": "みんなたくさんのものを売っています"}, {"type": "subtitle", "time": 7199.109, "timestamp": "01:59:59", "text": "よね？"}]
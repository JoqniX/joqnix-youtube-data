[{"type": "subtitle", "time": 8401.349, "timestamp": "02:20:01", "text": "とにかく、今4つのストリームを予定しているんだ"}, {"type": "subtitle", "time": 8405.51, "timestamp": "02:20:05", "text": "。この後の次のストリームと"}, {"type": "subtitle", "time": 8407.51, "timestamp": "02:20:07", "text": "明日も2つのストリームがある。だから、"}, {"type": "subtitle", "time": 8410.15, "timestamp": "02:20:10", "text": "3つのストリームかな。ごめん、4つじゃなくて"}, {"type": "subtitle", "time": 8413.429, "timestamp": "02:20:13", "text": "3つ。でも、ベストを尽くすよ。うん"}, {"type": "subtitle", "time": 8418.95, "timestamp": "02:20:18", "text": "。ベストを尽くすよ。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 8422.309, "timestamp": "02:20:22", "text": "今日はこれで終わり。今日来てくれたみんな、ありがとう"}, {"type": "subtitle", "time": 8424.23, "timestamp": "02:20:24", "text": "。ここで締めくくって、じゃあね"}]
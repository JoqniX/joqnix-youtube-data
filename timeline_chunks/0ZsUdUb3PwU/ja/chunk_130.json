[{"type": "subtitle", "time": 7803.109, "timestamp": "02:10:03", "text": "午前6時から。6時に起きようと思う。明日は"}, {"type": "subtitle", "time": 7807.189, "timestamp": "02:10:07", "text": "6時間、12時間、6時間、もしくは6時間、7時間の"}, {"type": "subtitle", "time": 7814.709, "timestamp": "02:10:14", "text": "うん、早起きしないといけない。午前6時。6時にしよう。"}, {"type": "subtitle", "time": 7816.95, "timestamp": "02:10:16", "text": "よし、今日は早く寝よう"}, {"type": "subtitle", "time": 7825.589, "timestamp": "02:10:25", "text": "ハンハンに"}, {"type": "subtitle", "time": 7828.87, "timestamp": "02:10:28", "text": "早く寝ないといけないかもしれないって伝えておこう。だから、今すぐ"}, {"type": "subtitle", "time": 7833.83, "timestamp": "02:10:33", "text": "夕食を食べるか、"}, {"type": "subtitle", "time": 7840.13, "timestamp": "02:10:40", "text": "コラボレーションに参加するか、どちらかを選べる。"}, {"type": "subtitle", "time": 7842.629, "timestamp": "02:10:42", "text": "[音楽]"}]
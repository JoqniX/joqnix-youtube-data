[{"type": "subtitle", "time": 123.19, "timestamp": "00:02:03", "text": "のストリームを送っていただければ、"}, {"type": "subtitle", "time": 125.35, "timestamp": "00:02:05", "text": "1秒後に挿入します。"}, {"type": "subtitle", "time": 126.95, "timestamp": "00:02:06", "text": "えっと、"}, {"type": "subtitle", "time": 131.51, "timestamp": "00:02:11", "text": "ちょっと悲しい気持ちもあるけど、"}, {"type": "subtitle", "time": 137.27, "timestamp": "00:02:17", "text": "次の1ヶ月はまるまる"}, {"type": "subtitle", "time": 139.91, "timestamp": "00:02:19", "text": "練習に充てられて、"}, {"type": "subtitle", "time": 142.15, "timestamp": "00:02:22", "text": "その次の1ヶ月はレコーディング"}, {"type": "subtitle", "time": 143.589, "timestamp": "00:02:23", "text": "だけになるから、ちょっと嬉しい気持ちもある。   ああ"}, {"type": "subtitle", "time": 144.15, "timestamp": "00:02:24", "text": "、"}, {"type": "subtitle", "time": 145.35, "timestamp": "00:02:25", "text": "それが計画だ。"}, {"type": "subtitle", "time": 148.15, "timestamp": "00:02:28", "text": "10月ですよね？ その時になって初めて、"}, {"type": "subtitle", "time": 152.22899999999998, "timestamp": "00:02:32", "text": "録音を開始するのです。"}, {"type": "subtitle", "time": 156.309, "timestamp": "00:02:36", "text": "ミュージックビデオの制作に取り掛かり始めたんですよね？"}, {"type": "subtitle", "time": 159.19, "timestamp": "00:02:39", "text": "ミュージックビデオ。 問題は、"}, {"type": "subtitle", "time": 164.07, "timestamp": "00:02:44", "text": "既に作成済みのソロバージョンに取り組むべきかどうかわからないということです"}, {"type": "subtitle", "time": 165.91, "timestamp": "00:02:45", "text": "。"}, {"type": "subtitle", "time": 174.55, "timestamp": "00:02:54", "text": "大学に入ってから、途中で戻ってきて完成させようかなと思ったんです。そうしないと、何か"}]
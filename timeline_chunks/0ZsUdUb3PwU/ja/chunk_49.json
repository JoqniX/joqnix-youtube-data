[{"type": "subtitle", "time": 2943.109, "timestamp": "00:49:03", "text": "もっとリラックスできる感じだよ。   私は"}, {"type": "subtitle", "time": 2945.67, "timestamp": "00:49:05", "text": "この歌を練習していたのですが、それは、ええと、赤村に"}, {"type": "subtitle", "time": 2952.15, "timestamp": "00:49:12", "text": "この歌を教えたかったからです。"}, {"type": "subtitle", "time": 2954.47, "timestamp": "00:49:14", "text": "それはとても素晴らしいですね。 彼が歌うのを聴きたい"}, {"type": "subtitle", "time": 2956.47, "timestamp": "00:49:16", "text": "。 何てことだ。 英語版もあります"}, {"type": "subtitle", "time": 2957.349, "timestamp": "00:49:17", "text": "。 ええ、そうですね"}, {"type": "subtitle", "time": 2959.99, "timestamp": "00:49:19", "text": "。 うん。 彼に歌わせるつもりだ"}, {"type": "subtitle", "time": 2965.589, "timestamp": "00:49:25", "text": "ニース。 ニース。 こんにちは。"}, {"type": "subtitle", "time": 2966.39, "timestamp": "00:49:26", "text": "うん。   そして、そう。"}, {"type": "subtitle", "time": 2999.589, "timestamp": "00:49:59", "text": "ああ、そうだ。 なぜあなたはマヨネーズのように考えるのですか？"}]
[{"type": "subtitle", "time": 2881.43, "timestamp": "00:48:01", "text": "家に帰る途中、そんな感じで。 なんだか、"}, {"type": "subtitle", "time": 2884.71, "timestamp": "00:48:04", "text": "ゾッとするよね。 それらは、"}, {"type": "subtitle", "time": 2887.109, "timestamp": "00:48:07", "text": "歌うときのように声に負担をかけずに、より"}, {"type": "subtitle", "time": 2890.23, "timestamp": "00:48:10", "text": "快適に歌えるということです。 こんにちは、プレオーラ部分を歌ってください"}, {"type": "subtitle", "time": 2893.91, "timestamp": "00:48:13", "text": "。 すごく楽しい曲だよ。   わかった"}, {"type": "subtitle", "time": 2935.43, "timestamp": "00:48:55", "text": "[音楽]"}]
[{"type": "subtitle", "time": 6421.27, "timestamp": "01:47:01", "text": "。"}, {"type": "subtitle", "time": 6424.31, "timestamp": "01:47:04", "text": "こんにちは、こんにちは。"}, {"type": "subtitle", "time": 6427.03, "timestamp": "01:47:07", "text": "こんにちは、コマス。"}, {"type": "subtitle", "time": 6433.35, "timestamp": "01:47:13", "text": "コスミックス・アダムとアダム。"}, {"type": "subtitle", "time": 6434.87, "timestamp": "01:47:14", "text": "あなたがまだここにいるかどうかわかりませんが、"}, {"type": "subtitle", "time": 6447.43, "timestamp": "01:47:27", "text": "今日はバトルフィールド6をプレイできませんでした。"}, {"type": "subtitle", "time": 6449.75, "timestamp": "01:47:29", "text": "その分野ではプレイできなかったけど、"}, {"type": "subtitle", "time": 6451.83, "timestamp": "01:47:31", "text": "正直、今日の"}, {"type": "subtitle", "time": 6455.35, "timestamp": "01:47:35", "text": "朝は配信したかったんだ。でも、午前11時頃に起きたんだ。"}, {"type": "subtitle", "time": 6457.99, "timestamp": "01:47:37", "text": "それで、「ああ、"}, {"type": "subtitle", "time": 6462.629, "timestamp": "01:47:42", "text": "3時にダンと配信しなきゃいけない。それから、"}, {"type": "subtitle", "time": 6465.99, "timestamp": "01:47:45", "text": "6時か6時半にNDコラボがある」って思ったんだ。"}, {"type": "subtitle", "time": 6475.83, "timestamp": "01:47:55", "text": "ああ、それはやらないでおこう。とりあえず、"}]
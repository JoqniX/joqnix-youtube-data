[{"type": "subtitle", "time": 1140.549, "timestamp": "00:19:00", "text": "はい。 マッシュの後、音符を保持している場合"}, {"type": "subtitle", "time": 1142.789, "timestamp": "00:19:02", "text": "、音が途切れてしまうことがあります。"}, {"type": "subtitle", "time": 1146.23, "timestamp": "00:19:06", "text": "ああ、今気づいたんだ。"}, {"type": "subtitle", "time": 1148.39, "timestamp": "00:19:08", "text": "大丈夫。 こんにちは。"}, {"type": "subtitle", "time": 1162.63, "timestamp": "00:19:22", "text": "歌うべきでしょうか？"}, {"type": "subtitle", "time": 1182.549, "timestamp": "00:19:42", "text": "途切れたのですか？"}, {"type": "subtitle", "time": 1184.789, "timestamp": "00:19:44", "text": "ええ、それほど細かくは切り刻まれませんでした。 実は、"}, {"type": "subtitle", "time": 1187.669, "timestamp": "00:19:47", "text": "u"}, {"type": "subtitle", "time": 1189.43, "timestamp": "00:19:49", "text": "破棄設定を少し修正しようと試みたんです。 私にやらせてください"}, {"type": "subtitle", "time": 1193.35, "timestamp": "00:19:53", "text": "。 わかった。 うん。   わかった"}]
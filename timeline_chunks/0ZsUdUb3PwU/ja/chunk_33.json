[{"type": "subtitle", "time": 1981.75, "timestamp": "00:33:01", "text": "発音に近づけるように努力すればいいだけだと思う​​。 そして、もし"}, {"type": "subtitle", "time": 1984.31, "timestamp": "00:33:04", "text": "少し変更したくなったら、いつでも変更できます。"}, {"type": "subtitle", "time": 1986.63, "timestamp": "00:33:06", "text": "それは音次第です。"}, {"type": "subtitle", "time": 1990.389, "timestamp": "00:33:10", "text": "シャナ、みんなはどうやって「"}, {"type": "subtitle", "time": 1992.63, "timestamp": "00:33:12", "text": "これは普通のテキストだよね？」って言うんだろう？ 問題用紙にあるような、"}, {"type": "subtitle", "time": 1995.19, "timestamp": "00:33:15", "text": "小さな括弧のようなものを上に付けるにはどうすればいいですか"}, {"type": "subtitle", "time": 1997.509, "timestamp": "00:33:17", "text": "？ あなたも"}, {"type": "subtitle", "time": 2000.149, "timestamp": "00:33:20", "text": "見たことがあるかもしれませんね？ どうやってやったのかいつも"}, {"type": "subtitle", "time": 2003.11, "timestamp": "00:33:23", "text": "不思議に思うんだけど、私は知らないし、何の話をしているのかも知らないし、"}, {"type": "subtitle", "time": 2010.63, "timestamp": "00:33:30", "text": "日本語でも好きじゃない。"}, {"type": "subtitle", "time": 2013.029, "timestamp": "00:33:33", "text": "漢字があれば、ひらがなで"}, {"type": "subtitle", "time": 2016.95, "timestamp": "00:33:36", "text": "括弧の上に書いてあるのを見たことがあるかもしれない。もし"}, {"type": "subtitle", "time": 2019.35, "timestamp": "00:33:39", "text": "ここでそれができたら、"}, {"type": "subtitle", "time": 2024.47, "timestamp": "00:33:44", "text": "小さな括弧、例えば「トアマ」とか、"}, {"type": "subtitle", "time": 2025.75, "timestamp": "00:33:45", "text": "そういうのを入れることができると思う。"}, {"type": "subtitle", "time": 2029.11, "timestamp": "00:33:49", "text": "手動でできると思うけど、"}, {"type": "subtitle", "time": 2034.549, "timestamp": "00:33:54", "text": "カスタムペーパーを作るための特別なソフトウェアがあるのか​​もしれないね"}, {"type": "subtitle", "time": 2037.35, "timestamp": "00:33:57", "text": "。 それが私の考えです。"}]
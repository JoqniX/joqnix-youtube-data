[{"type": "subtitle", "time": 7575.109, "timestamp": "02:06:15", "text": "オーケー。うん。それで、他に"}, {"type": "subtitle", "time": 7587.51, "timestamp": "02:06:27", "text": "何をすればいいかな？えっと、太陽。明日ストリーム配信するよ。バトルフィールドになると思う。ねえ、ここにいるんだから、"}, {"type": "subtitle", "time": 7590.39, "timestamp": "02:06:30", "text": "配信するよ。"}, {"type": "subtitle", "time": 7597.03, "timestamp": "02:06:37", "text": "明日とかそういうの。それで、"}, {"type": "subtitle", "time": 7601.189, "timestamp": "02:06:41", "text": "明日は159日目。"}]
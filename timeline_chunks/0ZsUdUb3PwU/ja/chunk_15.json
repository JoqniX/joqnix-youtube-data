[{"type": "subtitle", "time": 915.67, "timestamp": "00:15:15", "text": "よし、その単語は「will」だ。"}, {"type": "subtitle", "time": 948.47, "timestamp": "00:15:48", "text": "ダマ。 ああ、発音しないといけない。"}, {"type": "subtitle", "time": 951.509, "timestamp": "00:15:51", "text": "これは違う。   つまり、そういうことなので、"}, {"type": "subtitle", "time": 955.509, "timestamp": "00:15:55", "text": "強調する必要はないということです。"}, {"type": "subtitle", "time": 957.829, "timestamp": "00:15:57", "text": "時々少しだけ聞こえるような感じがする"}, {"type": "subtitle", "time": 959.749, "timestamp": "00:15:59", "text": "けど、強調しなければ、"}]
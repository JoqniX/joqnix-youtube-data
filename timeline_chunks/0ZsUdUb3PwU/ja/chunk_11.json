[{"type": "subtitle", "time": 680.069, "timestamp": "00:11:20", "text": "基本的に、"}, {"type": "subtitle", "time": 690.23, "timestamp": "00:11:30", "text": "。"}, {"type": "subtitle", "time": 693.03, "timestamp": "00:11:33", "text": "ダッシュ記号のようなものですか？それとも通常のマイナス記号のようなものですか？"}, {"type": "subtitle", "time": 695.11, "timestamp": "00:11:35", "text": "うん、普通のダッシュはすごく可愛いよね。"}, {"type": "subtitle", "time": 695.509, "timestamp": "00:11:35", "text": "ああ、神様。"}, {"type": "subtitle", "time": 699.35, "timestamp": "00:11:39", "text": "それが速いものだと分かっていれば。"}, {"type": "subtitle", "time": 701.67, "timestamp": "00:11:41", "text": "わかった。"}, {"type": "chat", "time": 703.035, "timestamp": "00:11:43", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "hahah"}]
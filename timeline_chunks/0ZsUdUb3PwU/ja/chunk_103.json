[{"type": "subtitle", "time": 6181.35, "timestamp": "01:43:01", "text": "その息子が3つのパートすべてを教えてくれたので、"}, {"type": "subtitle", "time": 6184.87, "timestamp": "01:43:04", "text": "私が完全に、えーと、"}, {"type": "subtitle", "time": 6187.99, "timestamp": "01:43:07", "text": "練習を続け、完全に、えーと、"}, {"type": "subtitle", "time": 6193.03, "timestamp": "01:43:13", "text": "完成させて、えーと、"}, {"type": "subtitle", "time": 6201.43, "timestamp": "01:43:21", "text": "感情をたくさん込めて、"}, {"type": "subtitle", "time": 6204.87, "timestamp": "01:43:24", "text": "正しく歌って、うまく録音できるところまで到達できるかどうかは、私次第です。そして、"}, {"type": "subtitle", "time": 6207.99, "timestamp": "01:43:27", "text": "来月には"}, {"type": "subtitle", "time": 6212.31, "timestamp": "01:43:32", "text": "他の4曲を録音しなければなりません。"}, {"type": "subtitle", "time": 6215.35, "timestamp": "01:43:35", "text": "ああ、神様、私が学ぼうとしてきたことが試されているみたいです。"}, {"type": "subtitle", "time": 6222.149, "timestamp": "01:43:42", "text": "ええ、他のすべての曲を"}, {"type": "subtitle", "time": 6224.39, "timestamp": "01:43:44", "text": "実際に学ぶには、時間をかけなければなりません"}, {"type": "subtitle", "time": 6228.229, "timestamp": "01:43:48", "text": "。 ええ、"}, {"type": "subtitle", "time": 6231.35, "timestamp": "01:43:51", "text": "これから新しい曲に挑戦するよりも、"}, {"type": "subtitle", "time": 6238.87, "timestamp": "01:43:58", "text": "ダスが教えてくれたように、ひたすら練習して、完全に… タサンは"}]
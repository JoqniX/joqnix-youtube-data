[{"type": "subtitle", "time": 6364.709, "timestamp": "01:46:04", "text": "今日ダサンと話したように、"}, {"type": "subtitle", "time": 6367.43, "timestamp": "01:46:07", "text": "日本語の授業"}, {"type": "subtitle", "time": 6371.189, "timestamp": "01:46:11", "text": "やN4の授業が始まったら、土曜日に時間を作る余裕が"}, {"type": "subtitle", "time": 6374.629, "timestamp": "01:46:14", "text": "なくなると思います。土曜日は"}, {"type": "subtitle", "time": 6384.47, "timestamp": "01:46:24", "text": "7時半から"}, {"type": "subtitle", "time": 6389.75, "timestamp": "01:46:29", "text": "9時半くらいまで日本語の授業があるので、夜になると思います。だから、"}, {"type": "subtitle", "time": 6395.43, "timestamp": "01:46:35", "text": "もうDNDコラボはできないと思います。 正直に言うと、アーンハンと"}, {"type": "subtitle", "time": 6398.47, "timestamp": "01:46:38", "text": "このことについて話し合わないといけない。だって、"}, {"type": "subtitle", "time": 6406.95, "timestamp": "01:46:46", "text": "自分の側から続けることができないのは辛いことだから。"}, {"type": "subtitle", "time": 6414.79, "timestamp": "01:46:54", "text": "こんにちは。"}, {"type": "subtitle", "time": 6417.109, "timestamp": "01:46:57", "text": "ええと、皆さんお元気ですか？ お越しいただいた"}, {"type": "subtitle", "time": 6419.189, "timestamp": "01:46:59", "text": "皆様、ありがとうございました。 こんにちは、スワッグ・シュガラン"}]
[{"type": "subtitle", "time": 6545.03, "timestamp": "01:49:05", "text": "アップデートに何が入ってたのかは知らないけど、配信のオーバーレイみたいな"}, {"type": "subtitle", "time": 6548.87, "timestamp": "01:49:08", "text": "ものをいくつか削除しようと思ってたんだ。"}, {"type": "subtitle", "time": 6559.99, "timestamp": "01:49:19", "text": "ジョアソンのタイマーみたいなやつだよ。わからないけど。"}, {"type": "subtitle", "time": 6562.55, "timestamp": "01:49:22", "text": "それをそのままにしておくべきか。つまり、"}, {"type": "subtitle", "time": 6566.149, "timestamp": "01:49:26", "text": "ウィジェットを買ったんです。それで"}, {"type": "subtitle", "time": 6567.82, "timestamp": "01:49:27", "text": "、"}, {"type": "subtitle", "time": 6575.03, "timestamp": "01:49:35", "text": "えーと、"}, {"type": "subtitle", "time": 6595.109, "timestamp": "01:49:55", "text": "。それを変えなきゃ。わかった。ええと、わかった"}, {"type": "subtitle", "time": 6597.83, "timestamp": "01:49:57", "text": "。今日は6時です。6時に"}]
[{"type": "subtitle", "time": 8163.03, "timestamp": "02:16:03", "text": "しばらく前からこれを歌おうとしていた。"}, {"type": "subtitle", "time": 8170.229, "timestamp": "02:16:10", "text": "最近買ったこのウェブサイトガイドを見ていた。 無料だけど、"}, {"type": "subtitle", "time": 8174.39, "timestamp": "02:16:14", "text": "見てたんだ。"}, {"type": "subtitle", "time": 8213.75, "timestamp": "02:16:53", "text": "よし。えっと、時間を無駄にしないで、"}, {"type": "subtitle", "time": 8215.91, "timestamp": "02:16:55", "text": "ここで終わりにします。今日来てくれた皆さん、ありがとう"}, {"type": "subtitle", "time": 8218.389, "timestamp": "02:16:58", "text": "。1時間後にまた会いましょう"}]
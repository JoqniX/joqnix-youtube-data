[{"type": "subtitle", "time": 4865.35, "timestamp": "01:21:05", "text": "あ、待って。 待って。 どうして私が、ああ、なんてことだ。"}, {"type": "subtitle", "time": 4875.75, "timestamp": "01:21:15", "text": "最後のやつ間違えたかもしれない。 でも"}, {"type": "subtitle", "time": 4880.47, "timestamp": "01:21:20", "text": "、それも練習しないといけないですね。"}, {"type": "subtitle", "time": 4883.91, "timestamp": "01:21:23", "text": "私が歌うと、下降していく部分がすごく"}, {"type": "subtitle", "time": 4886.149, "timestamp": "01:21:26", "text": "単調に聞こえるんです。 だから、やり方がわからないのかもしれません"}, {"type": "subtitle", "time": 4889.03, "timestamp": "01:21:29", "text": "。 下降していく、"}, {"type": "subtitle", "time": 4891.51, "timestamp": "01:21:31", "text": "ピッチダウンするやつ。 どうすればいいですか？"}, {"type": "subtitle", "time": 4896.87, "timestamp": "01:21:36", "text": "特定のパートをどう歌うかを知るために曲を聴く必要はないが、"}, {"type": "subtitle", "time": 4898.63, "timestamp": "01:21:38", "text": "説明してみようと思う。"}, {"type": "subtitle", "time": 4903.83, "timestamp": "01:21:43", "text": "スロ。"}, {"type": "subtitle", "time": 4907.03, "timestamp": "01:21:47", "text": "次に歌う曲は何ですか？   わかった"}, {"type": "subtitle", "time": 4911.75, "timestamp": "01:21:51", "text": "。 次は？ ええと、私は"}, {"type": "subtitle", "time": 4914.79, "timestamp": "01:21:54", "text": "これらならできますし、知っています。 ああ、そうそう、"}, {"type": "subtitle", "time": 4917.59, "timestamp": "01:21:57", "text": "これも追加しないといけないよね？ ああ、"}, {"type": "subtitle", "time": 4919.11, "timestamp": "01:21:59", "text": "待って。 私はこれを学ばなければならない。 ええ、もちろんです"}]
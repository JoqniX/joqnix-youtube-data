[{"type": "subtitle", "time": 6121.35, "timestamp": "01:42:01", "text": "どうもありがとう。 うん。 そして、"}, {"type": "subtitle", "time": 6123.35, "timestamp": "01:42:03", "text": "必ず練習してください。 私もそうします。"}, {"type": "subtitle", "time": 6125.189, "timestamp": "01:42:05", "text": "明日、配信で練習することもできますよ"}, {"type": "subtitle", "time": 6128.07, "timestamp": "01:42:08", "text": "。 うん。"}, {"type": "subtitle", "time": 6129.51, "timestamp": "01:42:09", "text": "はい。"}, {"type": "subtitle", "time": 6133.83, "timestamp": "01:42:13", "text": "明日は私も練習できる。 はい。 こんにちは。"}, {"type": "subtitle", "time": 6135.6, "timestamp": "01:42:15", "text": "こんにちは。 さよなら。 皆さん、さようなら。"}, {"type": "subtitle", "time": 6137.76, "timestamp": "01:42:17", "text": "さよなら。 皆さん、さようなら。 バイバイ。   最後にまとめます"}, {"type": "subtitle", "time": 6139.36, "timestamp": "01:42:19", "text": "バイバイ。   最後にまとめます 。"}, {"type": "subtitle", "time": 6142.0, "timestamp": "01:42:22", "text": "。 ありがとう。"}, {"type": "subtitle", "time": 6142.96, "timestamp": "01:42:22", "text": "ありがとう。 こんにちは。"}, {"type": "subtitle", "time": 6144.239, "timestamp": "01:42:24", "text": "こんにちは。 こんにちは。   わかりました、"}, {"type": "subtitle", "time": 6157.75, "timestamp": "01:42:37", "text": "電話を切ります。 あれは何でしょう？   わかった"}, {"type": "subtitle", "time": 6159.43, "timestamp": "01:42:39", "text": "。"}, {"type": "subtitle", "time": 6161.91, "timestamp": "01:42:41", "text": "こんにちは。   あれが"}, {"type": "subtitle", "time": 6165.189, "timestamp": "01:42:45", "text": "息子だった。 ええと、私たちは"}, {"type": "subtitle", "time": 6167.189, "timestamp": "01:42:47", "text": "歌を歌っていました。 えーと、彼女は私たちが"}, {"type": "subtitle", "time": 6173.03, "timestamp": "01:42:53", "text": "学んできた歌の歌のレッスンをしてくれていました。えーと、それは美しい曲でした。えーと、"}, {"type": "subtitle", "time": 6179.189, "timestamp": "01:42:59", "text": "今日正式に、えーと、"}]
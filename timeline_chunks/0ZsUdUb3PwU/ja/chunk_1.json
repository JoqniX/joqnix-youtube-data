[{"type": "subtitle", "time": 60.63, "timestamp": "00:01:00", "text": "この曲を３ヶ月くらい続けて、毎日"}, {"type": "subtitle", "time": 63.11, "timestamp": "00:01:03", "text": "歌い続けると思います。 とても"}, {"type": "subtitle", "time": 66.789, "timestamp": "00:01:06", "text": "良かった。 それは、私をたくさんの"}, {"type": "subtitle", "time": 69.51, "timestamp": "00:01:09", "text": "悲しい考えやことから救ってくれたようなものだった。 それが"}, {"type": "subtitle", "time": 71.83, "timestamp": "00:01:11", "text": "理由です。"}, {"type": "subtitle", "time": 73.03, "timestamp": "00:01:13", "text": "うん。 あまり"}, {"type": "subtitle", "time": 75.429, "timestamp": "00:01:15", "text": "暗い話にはしたくない。"}, {"type": "subtitle", "time": 78.789, "timestamp": "00:01:18", "text": "はい。 ジャック、元気かい？ ちなみに、"}, {"type": "subtitle", "time": 85.27, "timestamp": "00:01:25", "text": "うん。"}, {"type": "subtitle", "time": 90.55, "timestamp": "00:01:30", "text": "ええと、まだ始まっていません。"}, {"type": "subtitle", "time": 93.59, "timestamp": "00:01:33", "text": "おそらく今月末か"}, {"type": "subtitle", "time": 96.95, "timestamp": "00:01:36", "text": "来月には始まると思う。 いつ公開されるのか、まだ連絡を待っているところです"}, {"type": "subtitle", "time": 104.069, "timestamp": "00:01:44", "text": "そうすると、私は…"}, {"type": "subtitle", "time": 105.83, "timestamp": "00:01:45", "text": "ええ、私は"}, {"type": "subtitle", "time": 108.31, "timestamp": "00:01:48", "text": "すべてを再編成しなければなりません。 時間通りに寝て、"}, {"type": "subtitle", "time": 111.27000000000001, "timestamp": "00:01:51", "text": "時間通りに起きる。   ええ"}, {"type": "subtitle", "time": 116.63, "timestamp": "00:01:56", "text": "、ではまずは看板から始めましょう"}, {"type": "subtitle", "time": 118.709, "timestamp": "00:01:58", "text": "。 はい、あなたの側"}]
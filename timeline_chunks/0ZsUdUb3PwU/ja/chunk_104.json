[{"type": "subtitle", "time": 6241.27, "timestamp": "01:44:01", "text": "私に美しい旅を教えてくれていました。まさにそのように、"}, {"type": "subtitle", "time": 6244.629, "timestamp": "01:44:04", "text": "同じ形式を使用し、"}, {"type": "subtitle", "time": 6248.149, "timestamp": "01:44:08", "text": "すべての単語を練習し続け、"}, {"type": "subtitle", "time": 6250.87, "timestamp": "01:44:10", "text": "それを複数の部分に分割して、"}, {"type": "subtitle", "time": 6257.35, "timestamp": "01:44:17", "text": "少なくとも10回まで毎日4行または8行を練習して、それに慣れることができるようにする必要があります"}, {"type": "subtitle", "time": 6262.79, "timestamp": "01:44:22", "text": "。 確か、"}, {"type": "subtitle", "time": 6266.31, "timestamp": "01:44:26", "text": "これらの曲全部、えっと、"}, {"type": "subtitle", "time": 6270.39, "timestamp": "01:44:30", "text": "どれだったっけ？ ええ、"}, {"type": "subtitle", "time": 6272.709, "timestamp": "01:44:32", "text": "新しい曲ではなく、古い曲のことですが、"}, {"type": "subtitle", "time": 6276.47, "timestamp": "01:44:36", "text": "最初は"}, {"type": "subtitle", "time": 6280.47, "timestamp": "01:44:40", "text": "10回から50回くらい歌ったと思います。そうやって、歌詞を"}, {"type": "subtitle", "time": 6286.55, "timestamp": "01:44:46", "text": "読んで、発音が正しくなくても歌えるようになったんです。"}, {"type": "subtitle", "time": 6292.07, "timestamp": "01:44:52", "text": "それ自体が大きな"}, {"type": "subtitle", "time": 6297.189, "timestamp": "01:44:57", "text": "ことなんです。 えーと、でも、"}, {"type": "subtitle", "time": 6299.99, "timestamp": "01:44:59", "text": "練習しないといけないし、"}]
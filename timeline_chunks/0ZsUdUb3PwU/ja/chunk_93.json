[{"type": "subtitle", "time": 5581.75, "timestamp": "01:33:01", "text": "うん。 歌を歌うときはリラックスしなければなりません"}, {"type": "subtitle", "time": 5583.43, "timestamp": "01:33:03", "text": "。 それが"}, {"type": "subtitle", "time": 5585.03, "timestamp": "01:33:05", "text": "私があなたにできる最大のアドバイスです。"}, {"type": "subtitle", "time": 5587.11, "timestamp": "01:33:07", "text": "なぜなら、あなたの声はあまり"}, {"type": "subtitle", "time": 5589.04, "timestamp": "01:33:09", "text": "リラックスした感じがしないからです。"}, {"type": "subtitle", "time": 5591.03, "timestamp": "01:33:11", "text": "[音楽]"}, {"type": "subtitle", "time": 5594.79, "timestamp": "01:33:14", "text": "いいコンピレーションを見ました。"}, {"type": "subtitle", "time": 5600.39, "timestamp": "01:33:20", "text": "Discordと同じなのかどうかわからないけど、あなたの声はいつもすごく"}, {"type": "subtitle", "time": 5602.55, "timestamp": "01:33:22", "text": "高い感じがする。"}, {"type": "subtitle", "time": 5604.47, "timestamp": "01:33:24", "text": "私と話している時、私の声は"}, {"type": "subtitle", "time": 5607.11, "timestamp": "01:33:27", "text": "すごく高く聞こえますか？ なんだか、"}, {"type": "subtitle", "time": 5610.47, "timestamp": "01:33:30", "text": "緊張しているような感じがしますか？   いや、違うよ。"}, {"type": "subtitle", "time": 5614.95, "timestamp": "01:33:34", "text": "私はそうは思いません。"}, {"type": "subtitle", "time": 5618.229, "timestamp": "01:33:38", "text": "自分の声を聞いてみたらどうなるだろう？"}, {"type": "subtitle", "time": 5620.229, "timestamp": "01:33:40", "text": "自分の声を聞いたら、きっとすごく"}, {"type": "subtitle", "time": 5623.27, "timestamp": "01:33:43", "text": "恥ずかしくなるだろうな。"}, {"type": "subtitle", "time": 5625.35, "timestamp": "01:33:45", "text": "そう、自分の心の"}, {"type": "subtitle", "time": 5628.39, "timestamp": "01:33:48", "text": "声に耳を傾けるしかないよ。 うん。 来月、何度か録音してみて、"}, {"type": "subtitle", "time": 5634.229, "timestamp": "01:33:54", "text": "自分の声を聞いてみて、どんな風に聞こえるか確認してみてください。   はい"}, {"type": "subtitle", "time": 5638.229, "timestamp": "01:33:58", "text": "、そうします。 ありがとう。"}]
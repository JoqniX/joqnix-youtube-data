[{"type": "subtitle", "time": 4755.35, "timestamp": "01:19:15", "text": "それはまさにそういうことだ"}, {"type": "subtitle", "time": 4757.35, "timestamp": "01:19:17", "text": "。"}, {"type": "subtitle", "time": 4759.83, "timestamp": "01:19:19", "text": "実際には、叫んでいるわけではないんです。 他の"}, {"type": "subtitle", "time": 4763.11, "timestamp": "01:19:23", "text": "歌詞と比べて、すごくすごく大きな音が出ているような感じですね。"}, {"type": "subtitle", "time": 4765.83, "timestamp": "01:19:25", "text": "そう、あれだよ。   それから、喉からでは"}, {"type": "subtitle", "time": 4769.75, "timestamp": "01:19:29", "text": "なく、お腹から歌うように心がけてください。 それも"}, {"type": "subtitle", "time": 4772.95, "timestamp": "01:19:32", "text": "また、よくある問題点の一つだと思います。"}, {"type": "subtitle", "time": 4776.11, "timestamp": "01:19:36", "text": "ああ、お腹から歌いたい。"}, {"type": "subtitle", "time": 4777.43, "timestamp": "01:19:37", "text": "[音楽] えーと、"}, {"type": "subtitle", "time": 4785.75, "timestamp": "01:19:45", "text": "肺ではなくお腹で呼吸するようにするって、どう言うんだっけ？ それは"}, {"type": "subtitle", "time": 4787.91, "timestamp": "01:19:47", "text": "可能だと思います。 それは"}, {"type": "subtitle", "time": 4791.189, "timestamp": "01:19:51", "text": "少しは可能だ。"}, {"type": "subtitle", "time": 4796.31, "timestamp": "01:19:56", "text": "え、どうやって？ お腹で呼吸する。 おお。 えっと。   えっと。"}]
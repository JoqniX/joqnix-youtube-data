[{"type": "subtitle", "time": 5342.87, "timestamp": "01:29:02", "text": "うん。 今あなたが歌った曲のことですね。"}, {"type": "subtitle", "time": 5347.51, "timestamp": "01:29:07", "text": "こんにちは。 歌ですよね？ こんにちは。"}, {"type": "subtitle", "time": 5350.07, "timestamp": "01:29:10", "text": "おい。"}, {"type": "subtitle", "time": 5352.39, "timestamp": "01:29:12", "text": "うん。 ニース。   他に"}, {"type": "subtitle", "time": 5357.43, "timestamp": "01:29:17", "text": "何が残っているだろうか？ えっと、それからスカ。"}, {"type": "subtitle", "time": 5359.03, "timestamp": "01:29:19", "text": "この歌を歌ってほしいですか？"}, {"type": "subtitle", "time": 5361.75, "timestamp": "01:29:21", "text": "ええ、そうするしかないですね。 うん、もう少し練習した方がいいよ"}, {"type": "subtitle", "time": 5365.27, "timestamp": "01:29:25", "text": "。 あなたの歌は"}, {"type": "subtitle", "time": 5367.27, "timestamp": "01:29:27", "text": "とても上手だったと思います。   私を"}, {"type": "subtitle", "time": 5369.03, "timestamp": "01:29:29", "text": "求めてるの？ わかった。"}, {"type": "subtitle", "time": 5374.639, "timestamp": "01:29:34", "text": "。 えっと、スタートはどうでしたか？ わかった。"}, {"type": "subtitle", "time": 5379.5, "timestamp": "01:29:39", "text": "えっと、スタートはどうでしたか？ わかった。 [音楽]"}, {"type": "subtitle", "time": 5380.8, "timestamp": "01:29:40", "text": "[音楽] オーケー。"}]
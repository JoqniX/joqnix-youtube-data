[{"type": "subtitle", "time": 5943.75, "timestamp": "01:39:03", "text": "強い"}, {"type": "subtitle", "time": 5944.87, "timestamp": "01:39:04", "text": "感覚なんだよ"}, {"type": "subtitle", "time": 5946.629, "timestamp": "01:39:06", "text": "。"}, {"type": "subtitle", "time": 5959.51, "timestamp": "01:39:19", "text": "私は練習を怠らないようにしている。"}, {"type": "subtitle", "time": 5962.95, "timestamp": "01:39:22", "text": "ええ、"}, {"type": "subtitle", "time": 5965.03, "timestamp": "01:39:25", "text": "今月いっぱいはここにはいません。 私はそこにいます。でも、"}, {"type": "subtitle", "time": 5970.95, "timestamp": "01:39:30", "text": "次の月の残りの期間はそこにいます。"}, {"type": "subtitle", "time": 5971.51, "timestamp": "01:39:31", "text": "こんにちは。   私がいない間も、"}, {"type": "subtitle", "time": 5973.669, "timestamp": "01:39:33", "text": "自主練習をしてくれると嬉しいんだけどね"}, {"type": "subtitle", "time": 5975.669, "timestamp": "01:39:35", "text": "。"}, {"type": "subtitle", "time": 5977.669, "timestamp": "01:39:37", "text": "練習します。"}, {"type": "subtitle", "time": 5981.109, "timestamp": "01:39:41", "text": "熱心に練習してください。"}, {"type": "subtitle", "time": 5984.31, "timestamp": "01:39:44", "text": "はい。 もし"}, {"type": "subtitle", "time": 5985.75, "timestamp": "01:39:45", "text": "私がすべてをストリーミング配信するなら、少なくとも"}, {"type": "subtitle", "time": 5987.99, "timestamp": "01:39:47", "text": "1時間はこれをやるために費やすつもりです。 こんにちは。"}, {"type": "subtitle", "time": 5991.91, "timestamp": "01:39:51", "text": "待って。 いいえ。いいえ。1時間ではなく、"}, {"type": "subtitle", "time": 5995.189, "timestamp": "01:39:55", "text": "30分くらいだと思います。  30分で"}, {"type": "subtitle", "time": 5995.91, "timestamp": "01:39:55", "text": "十分です。"}, {"type": "subtitle", "time": 5997.43, "timestamp": "01:39:57", "text": "30分。 わかった。 こんにちは。"}, {"type": "subtitle", "time": 5999.669, "timestamp": "01:39:59", "text": "うん。 録音が必要な曲すべてと、"}]
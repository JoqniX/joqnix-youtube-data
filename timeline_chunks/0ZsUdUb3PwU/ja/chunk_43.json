[{"type": "subtitle", "time": 2591.589, "timestamp": "00:43:11", "text": "こんにちは。"}, {"type": "subtitle", "time": 2597.91, "timestamp": "00:43:17", "text": "ですから、これら4曲すべてについて、"}, {"type": "subtitle", "time": 2603.75, "timestamp": "00:43:23", "text": "自信を持ってレコーディングできるようになるまで練習を続けてほしいのです"}, {"type": "subtitle", "time": 2606.15, "timestamp": "00:43:26", "text": "。 つまり、それが来月のあなたの課題です"}, {"type": "subtitle", "time": 2607.91, "timestamp": "00:43:27", "text": "。   何てことだ"}, {"type": "subtitle", "time": 2609.91, "timestamp": "00:43:29", "text": "。"}, {"type": "subtitle", "time": 2610.15, "timestamp": "00:43:30", "text": "うん。"}, {"type": "subtitle", "time": 2615.03, "timestamp": "00:43:35", "text": "基本的に、それらすべてを録音する準備をしておく必要があります。"}, {"type": "subtitle", "time": 2617.99, "timestamp": "00:43:37", "text": "うん。   何てことだ"}, {"type": "subtitle", "time": 2619.67, "timestamp": "00:43:39", "text": "。"}, {"type": "subtitle", "time": 2620.47, "timestamp": "00:43:40", "text": "うん。"}, {"type": "subtitle", "time": 2624.23, "timestamp": "00:43:44", "text": "ああ、神様。 うん。 最善を尽くします。"}, {"type": "subtitle", "time": 2625.99, "timestamp": "00:43:45", "text": "そうそう。"}, {"type": "subtitle", "time": 2628.87, "timestamp": "00:43:48", "text": "【音楽】"}, {"type": "subtitle", "time": 2632.63, "timestamp": "00:43:52", "text": "歌。 わかった。"}, {"type": "subtitle", "time": 2632.95, "timestamp": "00:43:52", "text": "はい。   今、"}, {"type": "subtitle", "time": 2634.39, "timestamp": "00:43:54", "text": "どんな曲を練習していますか"}, {"type": "subtitle", "time": 2635.99, "timestamp": "00:43:55", "text": "？"}, {"type": "subtitle", "time": 2638.15, "timestamp": "00:43:58", "text": "これです。"}]
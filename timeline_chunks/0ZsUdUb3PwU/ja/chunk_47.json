[{"type": "subtitle", "time": 2834.309, "timestamp": "00:47:14", "text": "[音楽]を手に入れました。"}, {"type": "subtitle", "time": 2855.99, "timestamp": "00:47:35", "text": "練習する必要があります。"}, {"type": "subtitle", "time": 2859.03, "timestamp": "00:47:39", "text": "うん、これは本当に練習が必要だよ。"}, {"type": "subtitle", "time": 2861.03, "timestamp": "00:47:41", "text": "何らかの"}, {"type": "subtitle", "time": 2863.75, "timestamp": "00:47:43", "text": "理由で行き詰まっているのは間違いない。 とにかく曲を何度も聴いてみてください。そうすれば、きっと"}, {"type": "subtitle", "time": 2867.91, "timestamp": "00:47:47", "text": "歌えるようになると思いますよ。"}, {"type": "subtitle", "time": 2870.23, "timestamp": "00:47:50", "text": "少なくとも私はそう思います。   だから、もう少し"}, {"type": "subtitle", "time": 2873.829, "timestamp": "00:47:53", "text": "落ち着いて聴いてみてください。"}, {"type": "subtitle", "time": 2876.309, "timestamp": "00:47:56", "text": "これは穏やかな夜の歌ですからね"}, {"type": "subtitle", "time": 2877.43, "timestamp": "00:47:57", "text": "。"}, {"type": "subtitle", "time": 2879.43, "timestamp": "00:47:59", "text": "ラジオを聴きながら、"}]
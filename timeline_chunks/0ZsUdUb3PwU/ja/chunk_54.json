[{"type": "subtitle", "time": 3266.47, "timestamp": "00:54:26", "text": "それで、今朝練習しなければなりませんでした。"}, {"type": "subtitle", "time": 3268.87, "timestamp": "00:54:28", "text": "覚えたと思ったら、しばらくそのままにしておいて、"}, {"type": "subtitle", "time": 3271.19, "timestamp": "00:54:31", "text": "振り返らなかった。そして今、"}, {"type": "subtitle", "time": 3274.95, "timestamp": "00:54:34", "text": "ここにいると、「ああ、"}, {"type": "subtitle", "time": 3277.91, "timestamp": "00:54:37", "text": "ほとんど忘れてしまったけど、読むことはできる。でも"}, {"type": "subtitle", "time": 3281.349, "timestamp": "00:54:41", "text": "もっと練習する必要がある」という感じ。"}, {"type": "subtitle", "time": 3282.549, "timestamp": "00:54:42", "text": "そう、"}, {"type": "subtitle", "time": 3285.43, "timestamp": "00:54:45", "text": "ここにあるもののほとんどがそうなんです"}, {"type": "subtitle", "time": 3287.91, "timestamp": "00:54:47", "text": "。"}, {"type": "subtitle", "time": 3290.95, "timestamp": "00:54:50", "text": "ええ、私が最初にやった曲を聴いてください。"}]
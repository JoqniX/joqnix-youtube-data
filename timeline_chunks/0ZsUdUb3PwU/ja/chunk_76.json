[{"type": "subtitle", "time": 4561.91, "timestamp": "01:16:01", "text": "うん。 必ず全ての"}, {"type": "subtitle", "time": 4564.31, "timestamp": "01:16:04", "text": "曲を練習してください。  5曲あるのかな？ 全部で"}, {"type": "subtitle", "time": 4565.59, "timestamp": "01:16:05", "text": "6曲です。 行く。"}, {"type": "subtitle", "time": 4569.59, "timestamp": "01:16:09", "text": "待って。  １、２、３、うん、５かな"}, {"type": "subtitle", "time": 4571.51, "timestamp": "01:16:11", "text": "。"}, {"type": "subtitle", "time": 4574.47, "timestamp": "01:16:14", "text": "それから、マダグもいる。"}, {"type": "subtitle", "time": 4575.43, "timestamp": "01:16:15", "text": "ええ、"}, {"type": "subtitle", "time": 4578.79, "timestamp": "01:16:18", "text": "この曲は以前はコーラスの部分で叫んでいたんですが、"}, {"type": "subtitle", "time": 4584.47, "timestamp": "01:16:24", "text": "優しく歌っているカバーバージョンを見つけたんです。 だから、私はそれを使っています"}, {"type": "subtitle", "time": 4586.07, "timestamp": "01:16:26", "text": "。"}, {"type": "subtitle", "time": 4590.149, "timestamp": "01:16:30", "text": "えっと、だから私は叫び声は必要ないんです。"}, {"type": "subtitle", "time": 4593.189, "timestamp": "01:16:33", "text": "最初はダスビーのカバーを使っていましたが、その後別のものに"}, {"type": "subtitle", "time": 4595.43, "timestamp": "01:16:35", "text": "替えました。 うん。"}, {"type": "subtitle", "time": 4599.03, "timestamp": "01:16:39", "text": "では、この歌を歌ってほしいですか？"}, {"type": "subtitle", "time": 4600.39, "timestamp": "01:16:40", "text": "ええ、歌えますよ。"}, {"type": "subtitle", "time": 4601.669, "timestamp": "01:16:41", "text": "うん。 君が歌う歌を全部聴きたい"}]
[{"type": "subtitle", "time": 3490.87, "timestamp": "00:58:10", "text": "[音楽]"}, {"type": "subtitle", "time": 3492.789, "timestamp": "00:58:12", "text": "うん。 うん。 どうぞ歌ってください"}, {"type": "subtitle", "time": 3493.43, "timestamp": "00:58:13", "text": "。"}, {"type": "subtitle", "time": 3495.43, "timestamp": "00:58:15", "text": "とても良い。   実は、久しぶりに"}, {"type": "subtitle", "time": 3497.19, "timestamp": "00:58:17", "text": "歌うんです"}, {"type": "subtitle", "time": 3500.23, "timestamp": "00:58:20", "text": "。 確かに、よく耳にしました。"}, {"type": "subtitle", "time": 3501.829, "timestamp": "00:58:21", "text": "うん。"}, {"type": "subtitle", "time": 3509.589, "timestamp": "00:58:29", "text": "覚えておくために、できるだけ頻繁に聞くようにしています。 ええ、自然に身につくでしょう。"}, {"type": "subtitle", "time": 3511.109, "timestamp": "00:58:31", "text": "歌詞を覚えていなくても、"}, {"type": "subtitle", "time": 3513.829, "timestamp": "00:58:33", "text": "どうにかして歌えるはずだ。"}, {"type": "subtitle", "time": 3515.349, "timestamp": "00:58:35", "text": "それが私の信念です。"}, {"type": "subtitle", "time": 3517.03, "timestamp": "00:58:37", "text": "こんにちは。   はい"}, {"type": "subtitle", "time": 3520.309, "timestamp": "00:58:40", "text": "、承知しました"}, {"type": "subtitle", "time": 3522.069, "timestamp": "00:58:42", "text": "。 ところで、あなたは伴奏なしで歌えますか"}, {"type": "subtitle", "time": 3522.63, "timestamp": "00:58:42", "text": "？   それなし"}, {"type": "subtitle", "time": 3524.309, "timestamp": "00:58:44", "text": "。 よし、"}, {"type": "subtitle", "time": 3526.15, "timestamp": "00:58:46", "text": "音楽なしで試してみてもいいよ。   わかった"}]
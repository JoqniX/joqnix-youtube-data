[{"type": "subtitle", "time": 2040.549, "timestamp": "00:34:00", "text": "そうですね、"}, {"type": "subtitle", "time": 2046.07, "timestamp": "00:34:06", "text": "発音について注意を促すようなコメントをしても構わないと"}, {"type": "subtitle", "time": 2046.71, "timestamp": "00:34:06", "text": "思います。"}, {"type": "subtitle", "time": 2048.71, "timestamp": "00:34:08", "text": "おお。 そうそう。 コメントこそがまさにここでのポイントだった"}, {"type": "subtitle", "time": 2049.75, "timestamp": "00:34:09", "text": "。"}, {"type": "subtitle", "time": 2050.389, "timestamp": "00:34:10", "text": "うん。"}, {"type": "subtitle", "time": 2053.03, "timestamp": "00:34:13", "text": "コメントするにはどうすればいいですか？ ああ、これだ。"}, {"type": "subtitle", "time": 2056.869, "timestamp": "00:34:16", "text": "うん、でもまあまあ"}, {"type": "subtitle", "time": 2065.51, "timestamp": "00:34:25", "text": "。"}, {"type": "subtitle", "time": 2069.909, "timestamp": "00:34:29", "text": "ああ、それは横に置かれるよ。 ああ、わかりました。"}, {"type": "subtitle", "time": 2070.869, "timestamp": "00:34:30", "text": "うん。"}, {"type": "subtitle", "time": 2074.069, "timestamp": "00:34:34", "text": "ああ、これは本当に素敵だ。   まだ知ら"}, {"type": "subtitle", "time": 2075.669, "timestamp": "00:34:35", "text": "ない。"}, {"type": "subtitle", "time": 2078.79, "timestamp": "00:34:38", "text": "私はこれを全く使いません。"}, {"type": "subtitle", "time": 2080.629, "timestamp": "00:34:40", "text": "ええ、そうですね。   ちょっと"}, {"type": "subtitle", "time": 2083.109, "timestamp": "00:34:43", "text": "待って、"}, {"type": "subtitle", "time": 2086.389, "timestamp": "00:34:46", "text": "好きな曲の歌詞はどこに書き留めるの？ 実は、"}, {"type": "subtitle", "time": 2089.349, "timestamp": "00:34:49", "text": "私はそういうものは保管しないんです"}, {"type": "subtitle", "time": 2091.43, "timestamp": "00:34:51", "text": "。 私が作った英語の歌詞のようなものはすべて、"}, {"type": "subtitle", "time": 2096.629, "timestamp": "00:34:56", "text": "ノートに書き留めています。"}, {"type": "subtitle", "time": 2099.109, "timestamp": "00:34:59", "text": "それは、私が普段"}]
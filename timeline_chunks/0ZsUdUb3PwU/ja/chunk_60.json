[{"type": "subtitle", "time": 3632.069, "timestamp": "01:00:32", "text": "ああ、私は"}, {"type": "subtitle", "time": 3636.23, "timestamp": "01:00:36", "text": "オリジナルのカバーバージョンを聴いていませんでした。 ええ、確かに"}, {"type": "subtitle", "time": 3638.39, "timestamp": "01:00:38", "text": "聴いたと思います。"}, {"type": "subtitle", "time": 3640.95, "timestamp": "01:00:40", "text": "車の問題ではない。"}, {"type": "subtitle", "time": 3643.43, "timestamp": "01:00:43", "text": "ユリ・コンによるオリジナル。"}, {"type": "subtitle", "time": 3646.73, "timestamp": "01:00:46", "text": "うん。 うん。 ええ、聴きましたよ。"}, {"type": "subtitle", "time": 3648.63, "timestamp": "01:00:48", "text": "[音楽] だから、"}, {"type": "subtitle", "time": 3650.71, "timestamp": "01:00:50", "text": "練習しないといけないんだ。   たくさんの"}, {"type": "subtitle", "time": 3653.27, "timestamp": "01:00:53", "text": "単語につまずくけれど、もっと"}, {"type": "subtitle", "time": 3658.63, "timestamp": "01:00:58", "text": "練習すればきっとできるようになると思うよ。 うん。 うん。"}]
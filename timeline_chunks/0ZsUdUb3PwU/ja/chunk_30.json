[{"type": "subtitle", "time": 1802.549, "timestamp": "00:30:02", "text": "あなたはどうですか？ あなたは"}, {"type": "subtitle", "time": 1803.43, "timestamp": "00:30:03", "text": "両親の前で自信を持って歌いますか？"}, {"type": "subtitle", "time": 1807.19, "timestamp": "00:30:07", "text": "うん。 うん。"}, {"type": "subtitle", "time": 1809.75, "timestamp": "00:30:09", "text": "私の母は、まさに今、私のすぐ隣で"}, {"type": "subtitle", "time": 1812.07, "timestamp": "00:30:12", "text": "寝ているんです"}, {"type": "subtitle", "time": 1816.149, "timestamp": "00:30:16", "text": "。"}, {"type": "subtitle", "time": 1824.149, "timestamp": "00:30:24", "text": "私は見ていました。ええ、彼女は実際に"}, {"type": "subtitle", "time": 1827.11, "timestamp": "00:30:27", "text": "寝ています。なぜなら、"}, {"type": "subtitle", "time": 1829.75, "timestamp": "00:30:29", "text": "PCとセットアップがすべて"}, {"type": "subtitle", "time": 1832.789, "timestamp": "00:30:32", "text": "セットアップされている寝室は、私の両親の寝室だからです。 だから、"}, {"type": "subtitle", "time": 1836.789, "timestamp": "00:30:36", "text": "あちこちで録音しておかないといけないんだけど、大抵の場合、私がいつも"}, {"type": "subtitle", "time": 1838.389, "timestamp": "00:30:38", "text": "歌っているのをみんなが聞いてるんだよね"}, {"type": "subtitle", "time": 1841.669, "timestamp": "00:30:41", "text": "。 実際、彼らはよく"}, {"type": "subtitle", "time": 1843.51, "timestamp": "00:30:43", "text": "私が歌えないとか、"}, {"type": "subtitle", "time": 1845.909, "timestamp": "00:30:45", "text": "変な日本の歌とか言うんです。 そう、そんな感じですね"}, {"type": "subtitle", "time": 1847.59, "timestamp": "00:30:47", "text": "。"}, {"type": "subtitle", "time": 1849.43, "timestamp": "00:30:49", "text": "彼らは日本語が話せますか？"}, {"type": "subtitle", "time": 1851.669, "timestamp": "00:30:51", "text": "いいえ。"}, {"type": "subtitle", "time": 1853.669, "timestamp": "00:30:53", "text": "うん。 でも、彼らは私が"}, {"type": "subtitle", "time": 1855.669, "timestamp": "00:30:55", "text": "日本語で歌っていることを知っているんです。 もちろん、それは今でも「"}, {"type": "chat", "time": 1859.208, "timestamp": "00:30:59", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJw
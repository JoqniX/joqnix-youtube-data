[{"type": "subtitle", "time": 6850.55, "timestamp": "01:54:10", "text": "音楽配信とか。"}, {"type": "subtitle", "time": 6853.109, "timestamp": "01:54:13", "text": "明日以降にやろうと思っています。"}, {"type": "subtitle", "time": 6855.109, "timestamp": "01:54:15", "text": "明日はBattlefieldをやります。"}, {"type": "subtitle", "time": 6856.79, "timestamp": "01:54:16", "text": "ところで、皆さん、早めに始めます。Battlefieldを"}, {"type": "subtitle", "time": 6859.669, "timestamp": "01:54:19", "text": "早めにやります。午前"}, {"type": "subtitle", "time": 6862.709, "timestamp": "01:54:22", "text": "5時か6時くらいに始めます。"}, {"type": "subtitle", "time": 6865.589, "timestamp": "01:54:25", "text": "配信を始めて、ベータ版は"}, {"type": "subtitle", "time": 6869.43, "timestamp": "01:54:29", "text": "明日の午後1時半に終了します。午後"}, {"type": "subtitle", "time": 6874.79, "timestamp": "01:54:34", "text": "1時半にBattlefieldに別れを告げなければなりません。"}, {"type": "subtitle", "time": 6877.75, "timestamp": "01:54:37", "text": "そしてその後は、"}, {"type": "subtitle", "time": 6880.96, "timestamp": "01:54:40", "text": "ええ、その後は"}, {"type": "subtitle", "time": 6882.87, "timestamp": "01:54:42", "text": "[音楽]、"}, {"type": "subtitle", "time": 6884.95, "timestamp": "01:54:44", "text": "その後はコラボをしなければなりません。 えーと、"}, {"type": "subtitle", "time": 6888.149, "timestamp": "01:54:48", "text": "ダサンと一緒に、彼女の手伝いをするんだよ"}]
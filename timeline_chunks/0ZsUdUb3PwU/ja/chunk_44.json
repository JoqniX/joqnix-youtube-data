[{"type": "subtitle", "time": 2640.15, "timestamp": "00:44:00", "text": "あなたはそれを習得しましたか？   えっと、"}, {"type": "subtitle", "time": 2645.03, "timestamp": "00:44:05", "text": "時々"}, {"type": "subtitle", "time": 2647.99, "timestamp": "00:44:07", "text": "これを継続的に練習する必要があるんです。今は速くて段落が多いので"}, {"type": "subtitle", "time": 2649.67, "timestamp": "00:44:09", "text": "。"}, {"type": "subtitle", "time": 2660.71, "timestamp": "00:44:20", "text": "歌い始めてもいいよ。   何てことだ"}, {"type": "subtitle", "time": 2664.79, "timestamp": "00:44:24", "text": "。 ストローを取ってきます。"}, {"type": "subtitle", "time": 2667.43, "timestamp": "00:44:27", "text": "何だって？ えーっと、ああ"}, {"type": "subtitle", "time": 2671.91, "timestamp": "00:44:31", "text": "、そうだ。 あと1秒。 私は"}, {"type": "subtitle", "time": 2677.67, "timestamp": "00:44:37", "text": "赤崎さんの『バニーガール』を観ました。"}, {"type": "subtitle", "time": 2679.349, "timestamp": "00:44:39", "text": "あなたはもうそれを習得しましたか？   そうそう"}, {"type": "subtitle", "time": 2680.71, "timestamp": "00:44:40", "text": "。"}, {"type": "subtitle", "time": 2682.79, "timestamp": "00:44:42", "text": "ああ、わかりました。 ああ、そうすれば"}, {"type": "subtitle", "time": 2684.71, "timestamp": "00:44:44", "text": "もっと楽に歌えるようになるだろうね。   わかった"}, {"type": "subtitle", "time": 2688.39, "timestamp": "00:44:48", "text": "。 こんにちは。"}, {"type": "subtitle", "time": 2690.55, "timestamp": "00:44:50", "text": "待って。 歌なしで。 わかった。 こんにちは。"}]
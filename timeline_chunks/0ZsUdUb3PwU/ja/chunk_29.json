[{"type": "subtitle", "time": 1741.51, "timestamp": "00:29:01", "text": "聞きたいんだけど、君の両親は、自分たちが"}, {"type": "subtitle", "time": 1746.31, "timestamp": "00:29:06", "text": "歌うとき、君にも歌わせてくれる？ そうそう"}, {"type": "subtitle", "time": 1746.87, "timestamp": "00:29:06", "text": "。"}, {"type": "subtitle", "time": 1749.83, "timestamp": "00:29:09", "text": "彼らはもう私の声を聞かないだろう。 私は二階の"}, {"type": "subtitle", "time": 1752.789, "timestamp": "00:29:12", "text": "自分の部屋にいます。  2階。 ええ、"}, {"type": "subtitle", "time": 1755.35, "timestamp": "00:29:15", "text": "階下です。"}, {"type": "subtitle", "time": 1757.19, "timestamp": "00:29:17", "text": "だから、彼らは聞かないだろう。 彼らは"}, {"type": "subtitle", "time": 1759.269, "timestamp": "00:29:19", "text": "あなたが不快な歌を歌っているのを聞いたことがありますか？   ああ"}, {"type": "subtitle", "time": 1762.47, "timestamp": "00:29:22", "text": "、そうだったよ。 それは本当に"}, {"type": "subtitle", "time": 1765.75, "timestamp": "00:29:25", "text": "奇妙だった。 それで私は、「そうだけど、"}, {"type": "subtitle", "time": 1767.669, "timestamp": "00:29:27", "text": "私の"}, {"type": "subtitle", "time": 1770.07, "timestamp": "00:29:30", "text": "歌声を聞きたくない」って言ったんです。 彼らは「私は"}, {"type": "subtitle", "time": 1773.11, "timestamp": "00:29:33", "text": "中国語か日本語か何かを話している」と言っていました。"}, {"type": "subtitle", "time": 1775.11, "timestamp": "00:29:35", "text": "彼らは何も知らなかった。 それからある日、母が"}, {"type": "subtitle", "time": 1777.99, "timestamp": "00:29:37", "text": "私の部屋に入ってきたのですが、それはずっと前のことで、確か"}, {"type": "subtitle", "time": 1780.63, "timestamp": "00:29:40", "text": "2年前だったと思いますが、私が"}, {"type": "subtitle", "time": 1783.83, "timestamp": "00:29:43", "text": "最初にそのレムルの"}, {"type": "subtitle", "time": 1786.23, "timestamp": "00:29:46", "text": "話を学んだ頃でした。 ああ、寝る時間とか色々あるね。 彼女は"}, {"type": "subtitle", "time": 1788.07, "timestamp": "00:29:48", "text": "今、そこへ歩いて行った。 彼女は「あら、"}, {"type": "subtitle", "time": 1789.909, "timestamp": "00:29:49", "text": "歌ってるの？」って感じだった。"}, {"type": "subtitle", "time": 1791.909, "timestamp": "00:29:51", "text": "すると私は「ああ、降りてきなさい。いや、"}, {"type": "subtitle", "time": 1793.99, "timestamp": "00:29:53", "text": "来ないで。私は聞かないわ。行って、あっちへ行って"}, {"type": "subtitle", "time": 1796.789, "timestamp": "00:29:56", "text": "」って感じになった。 私はすごく恥ずかしかった。 ああ"}, {"type": "subtitle", "time": 1799.909, "timestamp": "00:29:59", "text": "、なんて痛かったんだ。"}]
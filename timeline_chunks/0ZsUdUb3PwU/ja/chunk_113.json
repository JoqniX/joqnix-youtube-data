[{"type": "subtitle", "time": 6781.03, "timestamp": "01:53:01", "text": "小さすぎるんです。"}, {"type": "subtitle", "time": 6786.31, "timestamp": "01:53:06", "text": "私が持っているのはそれだけです。ちゃんとしたピアノのレッスンや配信をするには、49鍵か"}, {"type": "subtitle", "time": 6789.51, "timestamp": "01:53:09", "text": "84鍵のピアノが必要だって知ってますよ"}, {"type": "subtitle", "time": 6814.87, "timestamp": "01:53:34", "text": "[音楽]で、"}, {"type": "subtitle", "time": 6818.55, "timestamp": "01:53:38", "text": "今月はAbleton"}, {"type": "subtitle", "time": 6821.109, "timestamp": "01:53:41", "text": "Liveのサブスクリプションも更新しました。Ableton"}, {"type": "subtitle", "time": 6824.79, "timestamp": "01:53:44", "text": "Liveの"}, {"type": "subtitle", "time": 6826.709, "timestamp": "01:53:46", "text": "サブスクリプションです。"}, {"type": "subtitle", "time": 6828.709, "timestamp": "01:53:48", "text": "だから、本当に、本当に、ええ、本当にちゃんと"}]
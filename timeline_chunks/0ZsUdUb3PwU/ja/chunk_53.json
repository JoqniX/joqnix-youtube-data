[{"type": "subtitle", "time": 3213.03, "timestamp": "00:53:33", "text": "5月と言いそうになった。"}, {"type": "subtitle", "time": 3216.549, "timestamp": "00:53:36", "text": "うん。 いいえ、いいえ、それで合っています。 わかった。 うん。"}, {"type": "subtitle", "time": 3220.23, "timestamp": "00:53:40", "text": "どういうわけか、首の"}, {"type": "subtitle", "time": 3224.71, "timestamp": "00:53:44", "text": "部分でも、基本的にその部分と言うのですが、どういうわけか、"}, {"type": "subtitle", "time": 3232.069, "timestamp": "00:53:52", "text": "私は「うん」の牛の発音を聞きます。ああ、そうだったんですね。"}]
[{"type": "subtitle", "time": 3901.109, "timestamp": "01:05:01", "text": "こんにちは。"}, {"type": "subtitle", "time": 3905.19, "timestamp": "01:05:05", "text": "それでは、全面的に称賛します。"}, {"type": "subtitle", "time": 3906.71, "timestamp": "01:05:06", "text": "うーん、"}, {"type": "subtitle", "time": 3909.99, "timestamp": "01:05:09", "text": "これは悪くないですね。 私ならできると"}, {"type": "subtitle", "time": 3912.309, "timestamp": "01:05:12", "text": "思う。"}, {"type": "subtitle", "time": 3913.99, "timestamp": "01:05:13", "text": "うん。"}, {"type": "subtitle", "time": 3917.19, "timestamp": "01:05:17", "text": "この曲でコラボしてもいいですか？ キム・ドも"}, {"type": "subtitle", "time": 3920.87, "timestamp": "01:05:20", "text": "この曲でコラボできるかもしれない。   はい、そうです"}, {"type": "subtitle", "time": 3925.029, "timestamp": "01:05:25", "text": "。"}, {"type": "subtitle", "time": 3927.27, "timestamp": "01:05:27", "text": "ええと、"}, {"type": "subtitle", "time": 3934.63, "timestamp": "01:05:34", "text": "ああ、歌えると思うよ。"}, {"type": "subtitle", "time": 3934.95, "timestamp": "01:05:34", "text": "歌ってほしいですか？"}, {"type": "subtitle", "time": 3937.19, "timestamp": "01:05:37", "text": "私に教えたいのですか？"}, {"type": "subtitle", "time": 3939.589, "timestamp": "01:05:39", "text": "ああ、君、ああ、君、ああ、そうだね。 私に"}, {"type": "subtitle", "time": 3942.15, "timestamp": "01:05:42", "text": "教えてもらいたいの？ わかった。 はい。"}, {"type": "subtitle", "time": 3944.549, "timestamp": "01:05:44", "text": "まあ、君はもう読めるし、そういうこともできるから、こういうのは得意だよね"}, {"type": "subtitle", "time": 3946.71, "timestamp": "01:05:46", "text": "。"}, {"type": "subtitle", "time": 3949.109, "timestamp": "01:05:49", "text": "わかってるよ。でも、ほら、ほら、"}, {"type": "subtitle", "time": 3951.829, "timestamp": "01:05:51", "text": "君が望むなら、これは楽しいよ。"}, {"type": "subtitle", "time": 3953.75, "timestamp": "01:05:53", "text": "ああ、神様。"}, {"type": "subtitle", "time": 3956.63, "timestamp": "01:05:56", "text": "うん。 もし可能なら、来月別の配信で一日配信してください"}]
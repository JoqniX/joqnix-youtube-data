[{"type": "subtitle", "time": 6308.95, "timestamp": "01:45:08", "text": "けど、えーと、次は、"}, {"type": "subtitle", "time": 6312.229, "timestamp": "01:45:12", "text": "5時になるから、1時間後にDNDコラボがあるから、そのために"}, {"type": "subtitle", "time": 6322.629, "timestamp": "01:45:22", "text": "配信をスケジュールしないといけない"}, {"type": "subtitle", "time": 6324.229, "timestamp": "01:45:24", "text": "。"}, {"type": "subtitle", "time": 6326.47, "timestamp": "01:45:26", "text": "ええ、来てくださった皆さん、ありがとうございました"}, {"type": "subtitle", "time": 6331.75, "timestamp": "01:45:31", "text": "。 えっと、ちょっと待ってください。確か6時"}, {"type": "subtitle", "time": 6334.95, "timestamp": "01:45:34", "text": "30分に"}, {"type": "subtitle", "time": 6337.83, "timestamp": "01:45:37", "text": "ハンハンとみんなとのDNDコラボを予定していたと思います"}, {"type": "subtitle", "time": 6339.43, "timestamp": "01:45:39", "text": "。"}, {"type": "subtitle", "time": 6343.27, "timestamp": "01:45:43", "text": "これは、"}, {"type": "subtitle", "time": 6346.55, "timestamp": "01:45:46", "text": "DNDコラボレーションの4回目の配信になります"}, {"type": "subtitle", "time": 6348.47, "timestamp": "01:45:48", "text": "。   だから、"}, {"type": "subtitle", "time": 6355.03, "timestamp": "01:45:55", "text": "DND の件のように、どれくらいの期間続くのか、つまり、"}, {"type": "subtitle", "time": 6357.51, "timestamp": "01:45:57", "text": "どれくらいのストリームがあるのか​​はわかりません。 それは人それぞれで、"}]
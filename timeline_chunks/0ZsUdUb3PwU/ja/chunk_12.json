[{"type": "subtitle", "time": 733.91, "timestamp": "00:12:13", "text": "ダッシュ。 つまり、彼女がカネシュの曲を歌った後も、"}, {"type": "subtitle", "time": 736.87, "timestamp": "00:12:16", "text": "あなたの記憶のために"}, {"type": "subtitle", "time": 741.91, "timestamp": "00:12:21", "text": "[音楽]"}, {"type": "subtitle", "time": 744.629, "timestamp": "00:12:24", "text": "カネスクの意味は分かりますよね？"}, {"type": "subtitle", "time": 746.629, "timestamp": "00:12:26", "text": "ああ、悲しむのは当然だ。"}, {"type": "subtitle", "time": 749.43, "timestamp": "00:12:29", "text": "ええ、"}, {"type": "subtitle", "time": 753.11, "timestamp": "00:12:33", "text": "ケスの切羽詰まった気持ちを少し強調してみてください。"}, {"type": "subtitle", "time": 756.31, "timestamp": "00:12:36", "text": "ええ、あのセリフ、あのセリフ自体が、"}, {"type": "subtitle", "time": 758.47, "timestamp": "00:12:38", "text": "ちょっと必死な感じがしますね。 そう、あの"}, {"type": "subtitle", "time": 762.47, "timestamp": "00:12:42", "text": "4行をもう一度歌ってもいいですよ。   あ"}, {"type": "subtitle", "time": 765.829, "timestamp": "00:12:45", "text": "、すみません。 もう一度歌って。   よし"}, {"type": "subtitle", "time": 766.389, "timestamp": "00:12:46", "text": "。"}, {"type": "subtitle", "time": 767.829, "timestamp": "00:12:47", "text": "それがこの曲で最も重要な部分だ"}]
[{"type": "subtitle", "time": 2101.91, "timestamp": "00:35:01", "text": "検索して「あの曲は何だったっけ？」って思うことなんです。"}, {"type": "subtitle", "time": 2105.19, "timestamp": "00:35:05", "text": "スキの曲だと思うんだけど、そういえば"}, {"type": "subtitle", "time": 2108.15, "timestamp": "00:35:08", "text": "最近"}, {"type": "subtitle", "time": 2111.43, "timestamp": "00:35:11", "text": "VCでKのためにこの曲を歌おうとしてたんだけど、"}, {"type": "subtitle", "time": 2114.23, "timestamp": "00:35:14", "text": "スキの曲だったよね？ 覚えてない、覚えてない、あの"}, {"type": "subtitle", "time": 2123.99, "timestamp": "00:35:23", "text": "歌知ってる？   聞いたことがあるような気がします"}, {"type": "subtitle", "time": 2126.47, "timestamp": "00:35:26", "text": "。   まるで"}, {"type": "subtitle", "time": 2130.95, "timestamp": "00:35:30", "text": "[音楽]"}, {"type": "subtitle", "time": 2133.349, "timestamp": "00:35:33", "text": "うん。 うん。 あの歌。"}, {"type": "subtitle", "time": 2137.27, "timestamp": "00:35:37", "text": "歌詞を思い出そうとしたんだけど、"}, {"type": "subtitle", "time": 2139.99, "timestamp": "00:35:39", "text": "歌詞もタイトルも全然思い出せないんだ"}, {"type": "subtitle", "time": 2142.15, "timestamp": "00:35:42", "text": "。"}, {"type": "subtitle", "time": 2144.63, "timestamp": "00:35:44", "text": "ええ、確かに私にとってはとても難しいのですが、ところどころ"}, {"type": "subtitle", "time": 2147.109, "timestamp": "00:35:47", "text": "思い出せることもあります"}, {"type": "subtitle", "time": 2150.069, "timestamp": "00:35:50", "text": "。 以上です。"}, {"type": "subtitle", "time": 2152.71, "timestamp": "00:35:52", "text": "私は自分の記憶を頼りにしている。 記憶力が短く限られている"}]
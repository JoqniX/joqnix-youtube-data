[{"type": "subtitle", "time": 4622.98, "timestamp": "01:17:02", "text": "金曜の夜。"}, {"type": "subtitle", "time": 4648.63, "timestamp": "01:17:28", "text": "私は声を高くした。"}, {"type": "subtitle", "time": 4650.95, "timestamp": "01:17:30", "text": "ええ、それが、あなたが時々声変わりするときに"}, {"type": "subtitle", "time": 4652.87, "timestamp": "01:17:32", "text": "声が裏返る理由だと思います"}, {"type": "subtitle", "time": 4655.59, "timestamp": "01:17:35", "text": "。 声が"}, {"type": "subtitle", "time": 4657.59, "timestamp": "01:17:37", "text": "かなりかすれてきているよ"}, {"type": "subtitle", "time": 4661.189, "timestamp": "01:17:41", "text": "。 ちなみに、私はすでにそのように聞こえます。"}, {"type": "subtitle", "time": 4663.03, "timestamp": "01:17:43", "text": "うん。"}]
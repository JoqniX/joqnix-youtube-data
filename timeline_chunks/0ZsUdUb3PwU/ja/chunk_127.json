[{"type": "subtitle", "time": 7634.31, "timestamp": "02:07:14", "text": "セックス1の基本。えっと、明日は 159日ですよね"}, {"type": "subtitle", "time": 7636.79, "timestamp": "02:07:16", "text": "？信じられますか？"}, {"type": "subtitle", "time": 7641.83, "timestamp": "02:07:21", "text": "ジョアソンの160日目になります。すごい。もうずいぶん長い間"}, {"type": "subtitle", "time": 7674.229, "timestamp": "02:07:54", "text": "一杯お茶を淹れないといけないでしょう。"}, {"type": "subtitle", "time": 7676.55, "timestamp": "02:07:56", "text": "この配信を終えて階下に行き、"}, {"type": "subtitle", "time": 7678.95, "timestamp": "02:07:58", "text": "お茶を淹れて戻ってきて、"}]
[{"type": "subtitle", "time": 5428.149, "timestamp": "01:30:28", "text": "待って、もしかして歌い方を間違えてる？"}, {"type": "subtitle", "time": 5430.39, "timestamp": "01:30:30", "text": "それは基本的に、あなたの意見が聞き入れられていないからです"}, {"type": "subtitle", "time": 5432.47, "timestamp": "01:30:32", "text": "。   何てことだ"}, {"type": "subtitle", "time": 5433.189, "timestamp": "01:30:33", "text": "。   まるで"}, {"type": "subtitle", "time": 5435.91, "timestamp": "01:30:35", "text": "話すように歌ってください。"}]
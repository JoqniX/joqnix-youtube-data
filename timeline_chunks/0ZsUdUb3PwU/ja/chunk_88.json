[{"type": "subtitle", "time": 5314.07, "timestamp": "01:28:34", "text": "[音楽] 以上です"}, {"type": "subtitle", "time": 5317.27, "timestamp": "01:28:37", "text": "。 私はこれを学ぶ必要がある。"}, {"type": "subtitle", "time": 5319.75, "timestamp": "01:28:39", "text": "参考文献を調べなければならなかった。"}, {"type": "subtitle", "time": 5321.669, "timestamp": "01:28:41", "text": "でも正直に言うと、これは"}, {"type": "subtitle", "time": 5323.669, "timestamp": "01:28:43", "text": "あなたが以前歌った曲よりもずっと良いです"}, {"type": "subtitle", "time": 5326.39, "timestamp": "01:28:46", "text": "。 正直に言うと、録音する必要のあるものだけを"}, {"type": "subtitle", "time": 5329.11, "timestamp": "01:28:49", "text": "別のラベルにまとめることもできますよ"}, {"type": "subtitle", "time": 5331.03, "timestamp": "01:28:51", "text": "。"}, {"type": "subtitle", "time": 5333.189, "timestamp": "01:28:53", "text": "4つ全部を録音するように言います。そうしないと、おそらく"}, {"type": "subtitle", "time": 5336.629, "timestamp": "01:28:56", "text": "あなたは「"}, {"type": "subtitle", "time": 5339.27, "timestamp": "01:28:59", "text": "はい」となるでしょう。"}]
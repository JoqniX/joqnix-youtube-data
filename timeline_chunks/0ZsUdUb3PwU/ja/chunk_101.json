[{"type": "subtitle", "time": 6060.88, "timestamp": "01:41:00", "text": "[音楽]を教えてくれてありがとう。これはさよならではありません 。"}, {"type": "subtitle", "time": 6066.31, "timestamp": "01:41:06", "text": "今後、別の曲も制作する予定です。"}, {"type": "subtitle", "time": 6068.87, "timestamp": "01:41:08", "text": "うん。 気に入ってくれるかな？うん。"}, {"type": "subtitle", "time": 6071.75, "timestamp": "01:41:11", "text": "明日、一緒にコラボレーションしませんか？"}, {"type": "subtitle", "time": 6073.35, "timestamp": "01:41:13", "text": "明日っていつ？   えっと、"}, {"type": "subtitle", "time": 6076.79, "timestamp": "01:41:16", "text": "明日もだいたい同じくらいの時間ですね。"}, {"type": "subtitle", "time": 6079.59, "timestamp": "01:41:19", "text": "同じ時間。 いいえ。ええ、やってみます。 はい、可能です"}, {"type": "subtitle", "time": 6080.79, "timestamp": "01:41:20", "text": "。"}, {"type": "subtitle", "time": 6082.87, "timestamp": "01:41:22", "text": "私たちはどうするべきか？   そうそう"}, {"type": "subtitle", "time": 6085.59, "timestamp": "01:41:25", "text": "。 日本語の翻訳が欲しいって言ったでしょ"}, {"type": "subtitle", "time": 6089.35, "timestamp": "01:41:29", "text": "。   そうそう"}, {"type": "subtitle", "time": 6091.59, "timestamp": "01:41:31", "text": "。 うん。 うん。 やり方を教えてください"}, {"type": "subtitle", "time": 6093.75, "timestamp": "01:41:33", "text": "。 最善を尽くします。"}, {"type": "subtitle", "time": 6096.229, "timestamp": "01:41:36", "text": "うん。 うん。 少し教えてあげましょう。   私はただ"}, {"type": "subtitle", "time": 6102.31, "timestamp": "01:41:42", "text": "他の人にそうするように勧めてきただけなので、自分では言えません。"}, {"type": "subtitle", "time": 6104.47, "timestamp": "01:41:44", "text": "ええ、そうですね。 私の言いたいことがお分かりいただけると嬉しいです"}, {"type": "subtitle", "time": 6106.87, "timestamp": "01:41:46", "text": "。"}, {"type": "subtitle", "time": 6109.83, "timestamp": "01:41:49", "text": "こんにちは。  Ci."}, {"type": "subtitle", "time": 6110.87, "timestamp": "01:41:50", "text": "うん。"}, {"type": "subtitle", "time": 6113.109, "timestamp": "01:41:53", "text": "こんにちは。"}]
[{"type": "subtitle", "time": 1627.35, "timestamp": "00:27:07", "text": "待って、それは"}, {"type": "subtitle", "time": 1631.51, "timestamp": "00:27:11", "text": "最後の部分でそんなに速くする必要はありません。 自分が好きな時だけ、自分が"}, {"type": "subtitle", "time": 1634.39, "timestamp": "00:27:14", "text": "知っている好きな音楽に合わせて歌ってみてください。"}, {"type": "subtitle", "time": 1635.269, "timestamp": "00:27:15", "text": "うん。"}, {"type": "subtitle", "time": 1636.95, "timestamp": "00:27:16", "text": "無理強いする必要はない。 うん。 無理に"}, {"type": "subtitle", "time": 1640.31, "timestamp": "00:27:20", "text": "速く歌う必要はありません。"}, {"type": "subtitle", "time": 1644.149, "timestamp": "00:27:24", "text": "音楽なしで歌うと、そうなんです"}]
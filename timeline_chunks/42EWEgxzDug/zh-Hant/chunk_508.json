[{"type": "subtitle", "time": 30492.548, "timestamp": "08:28:12", "text": "我想我得重來。"}, {"type": "subtitle", "time": 30500.1, "timestamp": "08:28:20", "text": "水晶。哦，是"}, {"type": "subtitle", "time": 30517.99, "timestamp": "08:28:37", "text": "呃，"}, {"type": "subtitle", "time": 30527.11, "timestamp": "08:28:47", "text": "我得重來一遍。"}, {"type": "subtitle", "time": 30530.948, "timestamp": "08:28:50", "text": "就像跳下去再做一次。好吧。我得從頭再來一遍。這次我們滿血，因為我們剛重新加載。對。這次我應該不會死了。我們知道該怎麼做了。哦，等等。為什麼我不能用那"}, {"type": "subtitle", "time": 30533.51, "timestamp": "08:28:53", "text": "扇門？"}]
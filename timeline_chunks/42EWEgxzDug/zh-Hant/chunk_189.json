[{"type": "subtitle", "time": 11346.07, "timestamp": "03:09:06", "text": "說不定。這一切都是新來的運動員，我不想讓他失敗。好的。  我覺得這"}, {"type": "subtitle", "time": 11349.03, "timestamp": "03:09:09", "text": "四、五年裡，我失敗了很多。  我……呃……我覺得我沒有更努力。  每當我回想起這四、五年來我所做的一切，我都會感到"}, {"type": "subtitle", "time": 11359.67, "timestamp": "03:09:19", "text": "難過，"}, {"type": "subtitle", "time": 11362.79, "timestamp": "03:09:22", "text": "因為我把太多時間花在了別人身上，不是嗎？與其關注我自己，不如關注你們。  有一次，我幾乎犧牲了自己的社區，只是為了幫助其他人實現他們的夢想，對吧？"}, {"type": "subtitle", "time": 11366.389, "timestamp": "03:09:26", "text": "但這次我"}, {"type": "subtitle", "time": 11368.87, "timestamp": "03:09:28", "text": "想…之前有好幾次，我幾乎都想畢業"}, {"type": "subtitle", "time": 11387.349, "timestamp": "03:09:47", "text": "或放棄了，因為我迷失了方向，不知道自己能做什麼。"}, {"type": "subtitle", "time": 11392.87, "timestamp": "03:09:52", "text": "我能做什麼？我們之前遇到過這些問題，對吧？這些年來我們一直都有這些問題。我從那些黑"}]
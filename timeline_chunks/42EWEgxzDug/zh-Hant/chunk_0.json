[{"type": "subtitle", "time": 3.11, "timestamp": "00:00:03", "text": "天哪，十月都過半了"}, {"type": "subtitle", "time": 9.03, "timestamp": "00:00:09", "text": "但是，是的，"}, {"type": "subtitle", "time": 13.91, "timestamp": "00:00:13", "text": "我的嗓子啞了，因為我不小心"}, {"type": "subtitle", "time": 16.15, "timestamp": "00:00:16", "text": "做了一個，"}, {"type": "subtitle", "time": 20.47, "timestamp": "00:00:20", "text": "因為我不小心做了一個，該"}, {"type": "subtitle", "time": 24.87, "timestamp": "00:00:24", "text": "怎麼稱呼它呢？昨天直播過。"}, {"type": "subtitle", "time": 27.349, "timestamp": "00:00:27", "text": "呃，我昨天的Twitch直播持續了7個"}, {"type": "subtitle", "time": 31.189, "timestamp": "00:00:31", "text": "小時。所以，我凌晨五點才睡。"}, {"type": "subtitle", "time": 33.43, "timestamp": "00:00:33", "text": "但是，是的，"}, {"type": "subtitle", "time": 35.91, "timestamp": "00:00:35", "text": "我喜歡……"}, {"type": "subtitle", "time": 41.43, "timestamp": "00:00:41", "text": "哦，等等。如果我凌晨 5:00 睡覺，5 6 7"}, {"type": "subtitle", "time": 46.389, "timestamp": "00:00:46", "text": "等等，5 到 6 7 8 9 10 5 小時睡眠。"}, {"type": "subtitle", "time": 50.31, "timestamp": "00:00:50", "text": "這還不夠。我的天啊。"}, {"type": "subtitle", "time": 52.79, "timestamp": "00:00:52", "text": "嗯，我還沒吃"}, {"type": "subtitle", "time": 55.27, "timestamp": "00:00:55", "text": "早餐。我剛睡醒。我原本應該把"}, {"type": "subtitle", "time": 57.67, "timestamp": "00:00:57", "text": "直播延後"}, {"type": "subtitle", "time": 59.75, "timestamp": "00:00:59", "text": "一個小時。"}]
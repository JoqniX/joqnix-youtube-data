[{"type": "subtitle", "time": 12968.15, "timestamp": "03:36:08", "text": "呃，"}, {"type": "subtitle", "time": 12971.99, "timestamp": "03:36:11", "text": "我得對樂團進行一次大重組，對吧？很遺憾，"}, {"type": "subtitle", "time": 12982.309, "timestamp": "03:36:22", "text": "我不能穿"}, {"type": "subtitle", "time": 12988.95, "timestamp": "03:36:28", "text": "現在這種運動型男的裝備，因為它"}, {"type": "subtitle", "time": 12991.99, "timestamp": "03:36:31", "text": "是高端型號。好的，這是高端的高級產品。我必須以專業的態度"}, {"type": "subtitle", "time": 12997.51, "timestamp": "03:36:37", "text": "對待這件事，這樣我才能盡我所能，做到身為專業創作者應有的樣子。  我必須讓我的眼睛達到"}]
[{"type": "subtitle", "time": 11941.99, "timestamp": "03:19:01", "text": "世界上生存下去。那才是"}, {"type": "subtitle", "time": 11949.91, "timestamp": "03:19:09", "text": "我真正想要的錢"}, {"type": "subtitle", "time": 11958.229, "timestamp": "03:19:18", "text": "所以，是的，我沒有，我沒有製定任何規則，"}, {"type": "subtitle", "time": 11987.59, "timestamp": "03:19:47", "text": "不把我從網上獲得的任何支持資金用於其他用途，因為我不能偷懶，你知道，你得努力工作才能養活自己，對吧？即使是一盧比或一"}, {"type": "subtitle", "time": 11997.67, "timestamp": "03:19:57", "text": "美元，或即使是最小的金額，都意義重大，這意義重大，對吧？是的。  如此龐大的金額"}]
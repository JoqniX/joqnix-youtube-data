[{"type": "subtitle", "time": 122.789, "timestamp": "00:02:02", "text": "卡凡的周年紀念日。我的天啊。我的天啊。今天是我的結婚紀念日"}, {"type": "subtitle", "time": 126.469, "timestamp": "00:02:06", "text": "。我的天啊。離開。"}, {"type": "subtitle", "time": 149.99, "timestamp": "00:02:29", "text": "我的嗓子快要啞了。  好了，我們開始遊戲。"}, {"type": "subtitle", "time": 156.15, "timestamp": "00:02:36", "text": "我沒有打開它。什麼？你好，"}, {"type": "subtitle", "time": 158.22899999999998, "timestamp": "00:02:38", "text": "娜妮。"}, {"type": "subtitle", "time": 160.15, "timestamp": "00:02:40", "text": "卡。"}, {"type": "subtitle", "time": 161.91, "timestamp": "00:02:41", "text": "好了，讓我們開始遊戲吧。"}, {"type": "subtitle", "time": 164.63, "timestamp": "00:02:44", "text": "也該開始進食了。  是的"}, {"type": "subtitle", "time": 171.11, "timestamp": "00:02:51", "text": "所以，我和我在《"}, {"type": "subtitle", "time": 174.63, "timestamp": "00:02:54", "text": "決勝時刻：莫內3》直播時一樣，"}, {"type": "subtitle", "time": 177.50900000000001, "timestamp": "00:02:57", "text": "放了那個東西。"}]
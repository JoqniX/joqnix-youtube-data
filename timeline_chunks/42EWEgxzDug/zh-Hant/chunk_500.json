[{"type": "subtitle", "time": 30006.31, "timestamp": "08:20:06", "text": "呃……漏出來了。所以我不"}, {"type": "subtitle", "time": 30020.948, "timestamp": "08:20:20", "text": "知道。我要去洗手間。我的疼痛。那是什麼？哦，這個地方。哦，我討厭那傢伙。"}, {"type": "subtitle", "time": 30024.788, "timestamp": "08:20:24", "text": "好的，左邊。這次我們"}, {"type": "subtitle", "time": 30045.51, "timestamp": "08:20:45", "text": "走下面的路"}]
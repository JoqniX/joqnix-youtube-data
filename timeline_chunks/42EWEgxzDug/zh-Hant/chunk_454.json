[{"type": "subtitle", "time": 27241.67, "timestamp": "07:34:01", "text": "渣男。"}, {"type": "subtitle", "time": 27287.75, "timestamp": "07:34:47", "text": "不是這首歌。不，遊戲崩潰了。  不，"}, {"type": "subtitle", "time": 27297.91, "timestamp": "07:34:57", "text": "我的電腦崩潰了。  女士，發生了什麼事？  到底發生了什麼事？我的電腦配置不夠，玩不了這類遊戲嗎"}]
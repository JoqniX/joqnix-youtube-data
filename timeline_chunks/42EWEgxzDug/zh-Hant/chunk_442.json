[{"type": "subtitle", "time": 26532.868, "timestamp": "07:22:12", "text": "我會從其他網站之類的平台看動漫。然後我看了《親愛的弗蘭克斯》之類的電影。"}, {"type": "subtitle", "time": 26538.23, "timestamp": "07:22:18", "text": "我的動漫之旅就是這樣開始的，偶然間我在 YouTube 之類的平台上發現了它"}, {"type": "subtitle", "time": 26550.708, "timestamp": "07:22:30", "text": "所以，我們完成了這首歌"}, {"type": "subtitle", "time": 26552.548, "timestamp": "07:22:32", "text": "。  這很難。這是。你"}]
[{"type": "subtitle", "time": 12061.99, "timestamp": "03:21:01", "text": "嗯，是的，我會"}, {"type": "subtitle", "time": 12069.83, "timestamp": "03:21:09", "text": "在直播裡做出承諾，因為這是個公告直播，如果奇蹟發生，"}, {"type": "subtitle", "time": 12072.95, "timestamp": "03:21:12", "text": "無論我得到什麼，我都會把它存在我的銀行帳戶裡，好嗎？我不會動用它，直到達到所需的最低金額。"}, {"type": "subtitle", "time": 12079.269, "timestamp": "03:21:19", "text": "我想我需要960美元用於綁定，是的，這就是"}, {"type": "subtitle", "time": 12082.71, "timestamp": "03:21:22", "text": "綁定的金額。我不知道"}, {"type": "subtitle", "time": 12099.99, "timestamp": "03:21:39", "text": "修復模型美術的問題需要多少錢，我不知道。所以，一旦我達到那個金額，我就會開始綁定工作。我想我們還會繼續和Joathon合作，這樣我就可以準備其他事情了。"}, {"type": "subtitle", "time": 12111.19, "timestamp": "03:21:51", "text": "我會盡量不動用這筆錢，我保證不會從我的銀行帳戶拿錢。我這週開始整理我的銀行帳戶"}, {"type": "subtitle", "time": 12114.87, "timestamp": "03:21:54", "text": "，我看到了這些。我專門為此保留了一個銀行帳戶。所以我不會從中拿錢。"}]
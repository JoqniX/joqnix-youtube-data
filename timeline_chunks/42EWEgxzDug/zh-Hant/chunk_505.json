[{"type": "subtitle", "time": 30307.03, "timestamp": "08:25:07", "text": "我該殺了你嗎"}, {"type": "subtitle", "time": 30310.58, "timestamp": "08:25:10", "text": "？啊，不。我的生命值。我的生命值。我的生命值。我的生命值。我的"}, {"type": "subtitle", "time": 30339.59, "timestamp": "08:25:39", "text": "生命值。不。不。不。我不知道。"}, {"type": "subtitle", "time": 30341.99, "timestamp": "08:25:41", "text": "不。然後它崩潰了。然後它崩潰了。真棒。總是這樣。每次"}, {"type": "subtitle", "time": 30346.868, "timestamp": "08:25:46", "text": "我死了，它都會崩潰。為什麼？我的遊戲崩潰了多少次？即使"}]
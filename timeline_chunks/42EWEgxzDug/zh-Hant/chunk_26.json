[{"type": "subtitle", "time": 1587.669, "timestamp": "00:26:27", "text": "我忘了帶操作鍵。  我們走吧。"}, {"type": "subtitle", "time": 1599.43, "timestamp": "00:26:39", "text": "好的，我們都"}, {"type": "subtitle", "time": 1606.63, "timestamp": "00:26:46", "text": "明白了，我把他搞定了"}, {"type": "subtitle", "time": 1608.63, "timestamp": "00:26:48", "text": "。  我的天啊，笨蛋。"}]
[{"type": "subtitle", "time": 63.75, "timestamp": "00:01:03", "text": "我還置頂了這則訊息。"}, {"type": "subtitle", "time": 66.39, "timestamp": "00:01:06", "text": "呃，但我當時想，算了，沒關係。我"}, {"type": "subtitle", "time": 69.51, "timestamp": "00:01:09", "text": "跟你們一起吃早餐吧"}, {"type": "subtitle", "time": 71.99, "timestamp": "00:01:11", "text": "。"}, {"type": "subtitle", "time": 75.91, "timestamp": "00:01:15", "text": "所以，沒問題。這就是"}, {"type": "subtitle", "time": 81.10900000000001, "timestamp": "00:01:21", "text": "我這麼做的原因。"}, {"type": "subtitle", "time": 83.10900000000001, "timestamp": "00:01:23", "text": "今天我們要來玩《Apex"}, {"type": "subtitle", "time": 86.31, "timestamp": "00:01:26", "text": "英雄》。顯然，這就是新的"}, {"type": "subtitle", "time": 91.99, "timestamp": "00:01:31", "text": "萬聖節噩夢。這件事正在"}, {"type": "subtitle", "time": 95.67, "timestamp": "00:01:35", "text": "發生，而且在 Apex 中，還會有"}, {"type": "subtitle", "time": 99.35, "timestamp": "00:01:39", "text": "一個雙重"}, {"type": "subtitle", "time": 102.469, "timestamp": "00:01:42", "text": "加納活動，這是"}, {"type": "subtitle", "time": 106.789, "timestamp": "00:01:46", "text": "亡靈的至臻皮膚。拉維·陳終於擁有了一款"}, {"type": "subtitle", "time": 113.749, "timestamp": "00:01:53", "text": "[音樂]"}, {"type": "subtitle", "time": 115.749, "timestamp": "00:01:55", "text": "還有，你們也知道，今天是"}, {"type": "subtitle", "time": 117.83, "timestamp": "00:01:57", "text": "10月18日，是"}]
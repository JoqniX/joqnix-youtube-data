[{"type": "subtitle", "time": 27421.43, "timestamp": "07:37:01", "text": "Sir Jacob, welcome. Welcome."}, {"type": "subtitle", "time": 27424.15, "timestamp": "07:37:04", "text": "How are you? I believe this is your"}, {"type": "subtitle", "time": 27426.628, "timestamp": "07:37:06", "text": "first time today as well."}, {"type": "subtitle", "time": 27429.83, "timestamp": "07:37:09", "text": "Sabi brought me here. Oh, nice. Nice."}, {"type": "subtitle", "time": 27431.83, "timestamp": "07:37:11", "text": "Thank you for coming by through Sabi,"}, {"type": "subtitle", "time": 27434.388, "timestamp": "07:37:14", "text": "son. Welcome. Welcome."}, {"type": "subtitle", "time": 27443.11, "timestamp": "07:37:23", "text": "Oh, wait. Is this the same place I know"}, {"type": "subtitle", "time": 27449.51, "timestamp": "07:37:29", "text": "Oh,"}, {"type": "subtitle", "time": 27458.15, "timestamp": "07:37:38", "text": "This is the starting place where we"}, {"type": "subtitle", "time": 27471.83, "timestamp": "07:37:51", "text": "be back to the first place."}]
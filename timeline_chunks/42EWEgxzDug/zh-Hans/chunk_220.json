[{"type": "subtitle", "time": 13203.349, "timestamp": "03:40:03", "text": "那是我一个不切实际的梦想，但我曾用过"}, {"type": "subtitle", "time": 13207.11, "timestamp": "03:40:07", "text": "我想把我的虚拟直播作为一种方式"}, {"type": "subtitle", "time": 13211.03, "timestamp": "03:40:11", "text": "提升触及高度。我知道"}, {"type": "subtitle", "time": 13213.59, "timestamp": "03:40:13", "text": "这很难。我会为此而战。"}, {"type": "subtitle", "time": 13217.349, "timestamp": "03:40:17", "text": "梦。我想让事情发生。"}, {"type": "subtitle", "time": 13219.19, "timestamp": "03:40:19", "text": "这也是我打算……的原因。"}, {"type": "subtitle", "time": 13222.63, "timestamp": "03:40:22", "text": "我们所在的国家是"}, {"type": "subtitle", "time": 13225.99, "timestamp": "03:40:25", "text": "一切都开始了，对吧？亲吻和"}, {"type": "subtitle", "time": 13231.59, "timestamp": "03:40:31", "text": "我所有在"}, {"type": "subtitle", "time": 13233.51, "timestamp": "03:40:33", "text": "从这个海滩兔子洞里，他们都……"}, {"type": "subtitle", "time": 13236.389, "timestamp": "03:40:36", "text": "起源于日本。"}, {"type": "subtitle", "time": 13239.91, "timestamp": "03:40:39", "text": "我知道。我知道这很蠢。"}, {"type": "subtitle", "time": 13247.51, "timestamp": "03:40:47", "text": "但我相信我能做到。如果有一个"}, {"type": "subtitle", "time": 13249.91, "timestamp": "03:40:49", "text": "总会有办法的。就是这样"}, {"type": "subtitle", "time": 13252.469, "timestamp": "03:40:52", "text": "我总是这样告诉自己。"}, {"type": "subtitle", "time": 13256.229, "timestamp": "03:40:56", "text": "你好。所以，谢谢你们听我讲话。"}]
[{"type": "subtitle", "time": 11100.79, "timestamp": "03:05:00", "text": "实现盈利。我不认为我不这么认为"}, {"type": "subtitle", "time": 11104.63, "timestamp": "03:05:04", "text": "我可以做到，而且我相信我能做到。如果"}, {"type": "subtitle", "time": 11107.51, "timestamp": "03:05:07", "text": "我足够稳定，我会的"}, {"type": "subtitle", "time": 11110.55, "timestamp": "03:05:10", "text": "正朝着这个目标努力。是的。"}, {"type": "subtitle", "time": 11113.429, "timestamp": "03:05:13", "text": "嗯，是的，因为它太大了"}, {"type": "subtitle", "time": 11115.51, "timestamp": "03:05:15", "text": "金额，我不认为这4个月"}, {"type": "subtitle", "time": 11117.83, "timestamp": "03:05:17", "text": "期限已到。"}, {"type": "subtitle", "time": 11122.469, "timestamp": "03:05:22", "text": "这就是我参加这次Joathon的原因。"}, {"type": "subtitle", "time": 11125.03, "timestamp": "03:05:25", "text": "就为了这四个月的事儿，因为"}, {"type": "subtitle", "time": 11128.309, "timestamp": "03:05:28", "text": "一旦我到了日本，我就必须购买"}, {"type": "subtitle", "time": 11130.63, "timestamp": "03:05:30", "text": "一台新笔记本电脑等等，而且能够"}, {"type": "subtitle", "time": 11133.67, "timestamp": "03:05:33", "text": "安排好一切，以便我能回来。"}, {"type": "subtitle", "time": 11136.87, "timestamp": "03:05:36", "text": "流媒体播放。好的。"}, {"type": "subtitle", "time": 11138.389, "timestamp": "03:05:38", "text": "是的。"}, {"type": "subtitle", "time": 11140.79, "timestamp": "03:05:40", "text": "我知道这需要一段时间。和"}, {"type": "subtitle", "time": 11144.63, "timestamp": "03:05:44", "text": "你知道，呃，以我的性格，我觉得我不会"}, {"type": "subtitle", "time": 11147.11, "timestamp": "03:05:47", "text": "别人能活下来，但我也会活下来。我"}, {"type": "subtitle", "time": 11149.03, "timestamp": "03:05:49", "text": "相信自己。这是一个全新的挑战"}, {"type": "subtitle", "time": 11152.07, "timestamp": "03:05:52", "text": "为我。内向的我走出去"}, {"type": "subtitle", "time": 11155.83, "timestamp": "03:05:55", "text": "世界，以及用我自己的视角看待世界"}, {"type": "subtitle", "time": 11158.71, "timestamp": "03:05:58", "text": "观察世界如何运作以及一切。"}]
[{"type": "subtitle", "time": 12000.07, "timestamp": "03:20:00", "text": "那是索具的费用。"}, {"type": "subtitle", "time": 12002.389, "timestamp": "03:20:02", "text": "我不知道我需要多少钱"}, {"type": "subtitle", "time": 12006.95, "timestamp": "03:20:06", "text": "修复模型中的一些问题"}, {"type": "subtitle", "time": 12010.87, "timestamp": "03:20:10", "text": "艺术，但我不知道，不过是的，所以一旦我"}, {"type": "subtitle", "time": 12013.83, "timestamp": "03:20:13", "text": "击中那个，呃，多少钱，我打算开始……"}, {"type": "subtitle", "time": 12016.87, "timestamp": "03:20:16", "text": "我想我们仍然会保留索具过程。"}, {"type": "subtitle", "time": 12019.83, "timestamp": "03:20:19", "text": "和乔森一起去"}, {"type": "subtitle", "time": 12023.19, "timestamp": "03:20:23", "text": "这样我就可以准备其他事情了。"}, {"type": "subtitle", "time": 12025.59, "timestamp": "03:20:25", "text": "我会尽量不拿那笔钱。"}, {"type": "subtitle", "time": 12027.59, "timestamp": "03:20:27", "text": "我们承诺不会拿走那笔钱"}, {"type": "subtitle", "time": 12030.95, "timestamp": "03:20:30", "text": "我的银行账户。我看到了，呃，这些"}, {"type": "subtitle", "time": 12032.95, "timestamp": "03:20:32", "text": "这周我开始整理我的银行账户。"}, {"type": "subtitle", "time": 12037.269, "timestamp": "03:20:37", "text": "账户相关事宜。我一直保留着一个银行账户。"}, {"type": "subtitle", "time": 12039.75, "timestamp": "03:20:39", "text": "就为了这个。所以我不会收钱。"}, {"type": "subtitle", "time": 12041.75, "timestamp": "03:20:41", "text": "由此而来。"}, {"type": "subtitle", "time": 12044.469, "timestamp": "03:20:44", "text": "我把一切都给了我爸爸"}, {"type": "subtitle", "time": 12047.91, "timestamp": "03:20:47", "text": "也只是想呃，如果我有什么事的话，就给我来个bong吧"}, {"type": "subtitle", "time": 12052.389, "timestamp": "03:20:52", "text": "如果一分钱得到……"}, {"type": "subtitle", "time": 12055.11, "timestamp": "03:20:55", "text": "丢失了，可能是因为其他订阅或其他原因。"}, {"type": "subtitle", "time": 12057.11, "timestamp": "03:20:57", "text": "我用什么来直播和"}, {"type": "subtitle", "time": 12058.87, "timestamp": "03:20:58", "text": "一切。我不希望是这样。"}]
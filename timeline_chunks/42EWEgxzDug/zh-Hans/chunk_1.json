[{"type": "subtitle", "time": 63.75, "timestamp": "00:01:03", "text": "我还置顶了这条消息。"}, {"type": "subtitle", "time": 66.39, "timestamp": "00:01:06", "text": "呃，但我当时想，算了，没关系。患病的"}, {"type": "subtitle", "time": 69.51, "timestamp": "00:01:09", "text": "我只想和你一起吃早餐。"}, {"type": "subtitle", "time": 71.99, "timestamp": "00:01:11", "text": "伙计们。"}, {"type": "subtitle", "time": 75.91, "timestamp": "00:01:15", "text": "所以，没问题。就是这样"}, {"type": "subtitle", "time": 81.10900000000001, "timestamp": "00:01:21", "text": "我做到了。"}, {"type": "subtitle", "time": 83.10900000000001, "timestamp": "00:01:23", "text": "所以，今天我们要玩Apex英雄。"}, {"type": "subtitle", "time": 86.31, "timestamp": "00:01:26", "text": "传奇人物。显然，这就是新的呃"}, {"type": "subtitle", "time": 91.99, "timestamp": "00:01:31", "text": "万圣节……呃……噩梦。呃"}, {"type": "subtitle", "time": 95.67, "timestamp": "00:01:35", "text": "正在发生，嗯，Apex"}, {"type": "subtitle", "time": 99.35, "timestamp": "00:01:39", "text": "而且，嗯，那里会有双倍剂量"}, {"type": "subtitle", "time": 102.469, "timestamp": "00:01:42", "text": "恒河活动，即至尊皮肤"}, {"type": "subtitle", "time": 106.789, "timestamp": "00:01:46", "text": "亡灵。最后，拉维·陈也来了。"}, {"type": "subtitle", "time": 113.749, "timestamp": "00:01:53", "text": "[音乐]"}, {"type": "subtitle", "time": 115.749, "timestamp": "00:01:55", "text": "而且你知道，今天是"}, {"type": "subtitle", "time": 117.83, "timestamp": "00:01:57", "text": "10月18日是……的周年纪念日"}]
[{"type": "subtitle", "time": 13020.389, "timestamp": "03:37:00", "text": "我仍然保留着主要的……背景设定。"}, {"type": "subtitle", "time": 13022.389, "timestamp": "03:37:02", "text": "我的意思是，是的，官方设定是……"}, {"type": "subtitle", "time": 13025.429, "timestamp": "03:37:05", "text": "Jocknik 的身份将在整个过程中揭晓"}, {"type": "subtitle", "time": 13028.55, "timestamp": "03:37:08", "text": "首次亮相。而我将资助这个模型。"}, {"type": "subtitle", "time": 13031.349, "timestamp": "03:37:11", "text": "那将是官方模型。"}, {"type": "subtitle", "time": 13035.59, "timestamp": "03:37:15", "text": "道路。官方"}, {"type": "subtitle", "time": 13039.03, "timestamp": "03:37:19", "text": "西方人的典范。"}, {"type": "subtitle", "time": 13041.91, "timestamp": "03:37:21", "text": "是的，这个更像是……初始状态"}, {"type": "subtitle", "time": 13045.75, "timestamp": "03:37:25", "text": "系列弧模型的概念"}, {"type": "subtitle", "time": 13048.15, "timestamp": "03:37:28", "text": "以及那一个"}, {"type": "subtitle", "time": 13051.429, "timestamp": "03:37:31", "text": "呃，我们就是那个，我会是"}, {"type": "subtitle", "time": 13053.59, "timestamp": "03:37:33", "text": "如果资金充足，我就出道。"}, {"type": "subtitle", "time": 13056.07, "timestamp": "03:37:36", "text": "如果一切顺利的话……"}, {"type": "subtitle", "time": 13059.11, "timestamp": "03:37:39", "text": "运动护裆将是官方的运动护裆设计"}, {"type": "subtitle", "time": 13061.269, "timestamp": "03:37:41", "text": "杰克尼克设计角色设计"}, {"type": "subtitle", "time": 13062.79, "timestamp": "03:37:42", "text": "一切都好，一切都会好起来的"}, {"type": "subtitle", "time": 13065.99, "timestamp": "03:37:45", "text": "从此以后正式生效"}, {"type": "subtitle", "time": 13069.75, "timestamp": "03:37:49", "text": "是的，兄弟，希望你喜欢 IO。我希望"}, {"type": "subtitle", "time": 13072.55, "timestamp": "03:37:52", "text": "你喜欢它，我也很喜欢这个模型。"}, {"type": "subtitle", "time": 13074.71, "timestamp": "03:37:54", "text": "我不知道。"}, {"type": "subtitle", "time": 13077.429, "timestamp": "03:37:57", "text": "我非常感谢所有参与制作的人。"}, {"type": "subtitle", "time": 13079.269, "timestamp": "03:37:59", "text": "幕后默默付出，帮助我"}]
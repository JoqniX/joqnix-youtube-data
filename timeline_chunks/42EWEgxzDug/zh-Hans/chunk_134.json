[{"type": "subtitle", "time": 8042.39, "timestamp": "02:14:02", "text": "害怕的？我不知道。"}, {"type": "subtitle", "time": 8051.189, "timestamp": "02:14:11", "text": "你知道，雨已经停了，但是……"}, {"type": "subtitle", "time": 8055.03, "timestamp": "02:14:15", "text": "偶尔喜欢来这里也挺好的。"}, {"type": "subtitle", "time": 8059.27, "timestamp": "02:14:19", "text": "到像这样的僻静地方"}, {"type": "subtitle", "time": 8066.95, "timestamp": "02:14:26", "text": "海浪。不，那不是海洋。它是"}, {"type": "subtitle", "time": 8069.589, "timestamp": "02:14:29", "text": "更像是"}, {"type": "subtitle", "time": 8072.79, "timestamp": "02:14:32", "text": "呃，我该怎么说呢？"}, {"type": "subtitle", "time": 8076.229, "timestamp": "02:14:36", "text": "不是湖。这里仍然是大海。"}, {"type": "subtitle", "time": 8078.47, "timestamp": "02:14:38", "text": "不是海滩。更确切地说，我不知道。"}, {"type": "subtitle", "time": 8082.55, "timestamp": "02:14:42", "text": "怎么说呢？呃，沿海地区。非沿海地区。"}, {"type": "subtitle", "time": 8085.189, "timestamp": "02:14:45", "text": "呃，我不知道。是的，我看到了。"}, {"type": "subtitle", "time": 8087.669, "timestamp": "02:14:47", "text": "这里有水体。我不知道是不是"}, {"type": "subtitle", "time": 8092.229, "timestamp": "02:14:52", "text": "无论是大海还是湖泊，都一样。"}, {"type": "subtitle", "time": 8095.83, "timestamp": "02:14:55", "text": "不管是什么，喜欢它总是件好事。"}]
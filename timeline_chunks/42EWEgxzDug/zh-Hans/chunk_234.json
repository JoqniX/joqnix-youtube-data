[{"type": "subtitle", "time": 14040.95, "timestamp": "03:54:00", "text": "Tenjo 在我的 Discord 服务器上发布了一段视频。"}, {"type": "subtitle", "time": 14042.95, "timestamp": "03:54:02", "text": "媒体渠道。所以如果你愿意的话，你可以"}, {"type": "subtitle", "time": 14045.99, "timestamp": "03:54:05", "text": "看看那个视频。 2月14日是"}, {"type": "subtitle", "time": 14048.15, "timestamp": "03:54:08", "text": "孩子们要等到二月了。不，十一月"}, {"type": "subtitle", "time": 14052.229, "timestamp": "03:54:12", "text": "14号是儿童节，对吧？是的。"}, {"type": "subtitle", "time": 14056.63, "timestamp": "03:54:16", "text": "于是，我被其他事情分散了注意力。所以本周我们"}, {"type": "subtitle", "time": 14059.189, "timestamp": "03:54:19", "text": "本周和下周我们将要做的事情是"}, {"type": "subtitle", "time": 14061.429, "timestamp": "03:54:21", "text": "正在做一款恐怖游戏之类的东西……呃……"}, {"type": "subtitle", "time": 14063.83, "timestamp": "03:54:23", "text": "万圣节。你们也提出了一些建议。"}, {"type": "subtitle", "time": 14065.91, "timestamp": "03:54:25", "text": "游戏。感谢大家的建议。"}, {"type": "subtitle", "time": 14070.229, "timestamp": "03:54:30", "text": "适合在直播中玩的游戏。所以，嗯，今天我们"}, {"type": "subtitle", "time": 14072.79, "timestamp": "03:54:32", "text": "明天我们要吃司康饼。"}, {"type": "subtitle", "time": 14074.71, "timestamp": "03:54:34", "text": "明天意味着下一个"}, {"type": "subtitle", "time": 14077.349, "timestamp": "03:54:37", "text": "周三的直播是"}, {"type": "subtitle", "time": 14080.07, "timestamp": "03:54:40", "text": "伴着睡眠而行。星期四我们"}, {"type": "subtitle", "time": 14083.51, "timestamp": "03:54:43", "text": "和呃，玩时间，还有"}, {"type": "subtitle", "time": 14087.51, "timestamp": "03:54:47", "text": "周五是本周的最后一天。"}, {"type": "subtitle", "time": 14092.469, "timestamp": "03:54:52", "text": "呃，疼痛。是的。"}, {"type": "subtitle", "time": 14095.189, "timestamp": "03:54:55", "text": "你好。这就是我玩过的四款游戏。"}, {"type": "subtitle", "time": 14099.91, "timestamp": "03:54:59", "text": "本周入选。呃"}]
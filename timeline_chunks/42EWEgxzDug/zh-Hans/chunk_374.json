[{"type": "subtitle", "time": 22444.31, "timestamp": "06:14:04", "text": "就是这个人。这款双层"}, {"type": "subtitle", "time": 22447.11, "timestamp": "06:14:07", "text": "一。"}, {"type": "subtitle", "time": 22451.11, "timestamp": "06:14:11", "text": "现在我把它做成了一个巨大的"}, {"type": "subtitle", "time": 22454.23, "timestamp": "06:14:14", "text": "你管它叫什么？"}, {"type": "subtitle", "time": 22457.19, "timestamp": "06:14:17", "text": "巨大的"}, {"type": "subtitle", "time": 22467.11, "timestamp": "06:14:27", "text": "我认为这很容易"}, {"type": "subtitle", "time": 22470.15, "timestamp": "06:14:30", "text": "有可能"}, {"type": "subtitle", "time": 22488.23, "timestamp": "06:14:48", "text": "啊，不。我离目标很近了，但同时也在……"}, {"type": "subtitle", "time": 22491.19, "timestamp": "06:14:51", "text": "就在同一时刻，我却不是"}, {"type": "subtitle", "time": 22493.27, "timestamp": "06:14:53", "text": "就差一点。"}]
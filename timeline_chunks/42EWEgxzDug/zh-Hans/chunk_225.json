[{"type": "subtitle", "time": 13503.03, "timestamp": "03:45:03", "text": "真心喜欢。所以，是的，继续"}, {"type": "subtitle", "time": 13506.469, "timestamp": "03:45:06", "text": "就这么办。好吧，我觉得我开得很快。呃"}, {"type": "subtitle", "time": 13510.229, "timestamp": "03:45:10", "text": "太……太……我还是……是的，我会结束的。"}, {"type": "subtitle", "time": 13512.87, "timestamp": "03:45:12", "text": "好的。你好。"}, {"type": "subtitle", "time": 13516.63, "timestamp": "03:45:16", "text": "所以，综上所述，谢谢。"}, {"type": "subtitle", "time": 13520.07, "timestamp": "03:45:20", "text": "所有听过的人和"}, {"type": "subtitle", "time": 13526.55, "timestamp": "03:45:26", "text": "我把它关上了。"}, {"type": "subtitle", "time": 13529.03, "timestamp": "03:45:29", "text": "你好。"}, {"type": "subtitle", "time": 13532.389, "timestamp": "03:45:32", "text": "我爱你们！"}, {"type": "subtitle", "time": 13538.79, "timestamp": "03:45:38", "text": "这是乔克恩"}]
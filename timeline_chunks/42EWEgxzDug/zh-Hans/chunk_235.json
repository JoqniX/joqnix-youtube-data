[{"type": "subtitle", "time": 14102.63, "timestamp": "03:55:02", "text": "是的，下周的建议是……"}, {"type": "subtitle", "time": 14104.55, "timestamp": "03:55:04", "text": "欢迎提出建议。你可以"}, {"type": "subtitle", "time": 14108.79, "timestamp": "03:55:08", "text": "在推特和脸书上推荐他们。"}, {"type": "subtitle", "time": 14111.349, "timestamp": "03:55:11", "text": "呃，Instagram。我希望这件事已经过去了。"}, {"type": "subtitle", "time": 14114.15, "timestamp": "03:55:14", "text": "唉，可惜。但是，嗯，是的，你可以"}, {"type": "subtitle", "time": 14116.87, "timestamp": "03:55:16", "text": "请推荐一些游戏，或者在 Discord 上推荐给我。"}, {"type": "subtitle", "time": 14119.83, "timestamp": "03:55:19", "text": "如果你需要服务器，也可以联系我。"}, {"type": "subtitle", "time": 14122.309, "timestamp": "03:55:22", "text": "玩任何恐怖游戏。如果你如果"}, {"type": "subtitle", "time": 14124.87, "timestamp": "03:55:24", "text": "建议的游戏不是为了……而玩。"}, {"type": "subtitle", "time": 14128.07, "timestamp": "03:55:28", "text": "下周，我将选择他们。"}, {"type": "subtitle", "time": 14131.429, "timestamp": "03:55:31", "text": "呃，比如未来的恐怖直播之类的。所以"}, {"type": "subtitle", "time": 14134.71, "timestamp": "03:55:34", "text": "那将帮助我了解哪个"}, {"type": "subtitle", "time": 14137.99, "timestamp": "03:55:37", "text": "我应该玩的游戏和我喜欢的东西。你好。"}, {"type": "subtitle", "time": 14140.63, "timestamp": "03:55:40", "text": "有人吗？我觉得我之前跟你们说过，就像"}, {"type": "subtitle", "time": 14143.11, "timestamp": "03:55:43", "text": "多少分钟？哦，等等。才10岁"}, {"type": "subtitle", "time": 14147.189, "timestamp": "03:55:47", "text": "分钟。哦，等等。没关系。好的。"}, {"type": "subtitle", "time": 14154.71, "timestamp": "03:55:54", "text": "更多的。所以，你们怎么样？"}, {"type": "subtitle", "time": 14156.71, "timestamp": "03:55:56", "text": "一直在做什么？"}, {"type": "subtitle", "time": 14159.91, "timestamp": "03:55:59", "text": "你们最近过得怎么样？"}]
[{"type": "subtitle", "time": 24906.15, "timestamp": "06:55:06", "text": "圣。"}, {"type": "subtitle", "time": 24909.35, "timestamp": "06:55:09", "text": "所以我们并不孤单。"}, {"type": "subtitle", "time": 24911.27, "timestamp": "06:55:11", "text": "遗憾的是，"}, {"type": "subtitle", "time": 24913.83, "timestamp": "06:55:13", "text": "你并不孤单。"}, {"type": "subtitle", "time": 24939.27, "timestamp": "06:55:39", "text": "这是什么？我至少能得到一件武器吗？"}, {"type": "subtitle", "time": 24942.4, "timestamp": "06:55:42", "text": "为了保护自己？"}, {"type": "subtitle", "time": 24947.35, "timestamp": "06:55:47", "text": "[音乐]"}, {"type": "subtitle", "time": 24949.25, "timestamp": "06:55:49", "text": "那是什么声音？"}, {"type": "subtitle", "time": 24954.548, "timestamp": "06:55:54", "text": "好的，那是个风扇。我以为那是"}, {"type": "subtitle", "time": 24957.32, "timestamp": "06:55:57", "text": "黏液之类的东西。我的天啊。"}]
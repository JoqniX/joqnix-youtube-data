[{"type": "subtitle", "time": 12061.99, "timestamp": "03:21:01", "text": "做作的。是啊，我只是想"}, {"type": "subtitle", "time": 12064.389, "timestamp": "03:21:04", "text": "这样才能奏效。我只是想知道，我不知道"}, {"type": "subtitle", "time": 12066.63, "timestamp": "03:21:06", "text": "我正在制作我的"}, {"type": "subtitle", "time": 12069.83, "timestamp": "03:21:09", "text": "让我委托的人员暂停工作"}, {"type": "subtitle", "time": 12072.95, "timestamp": "03:21:12", "text": "因为我现在没钱。"}, {"type": "subtitle", "time": 12076.229, "timestamp": "03:21:16", "text": "但愿一切顺利。"}, {"type": "subtitle", "time": 12079.269, "timestamp": "03:21:19", "text": "出色地。我确实让他们知道我会"}, {"type": "subtitle", "time": 12082.71, "timestamp": "03:21:22", "text": "就像众筹那样"}, {"type": "subtitle", "time": 12084.309, "timestamp": "03:21:24", "text": "能够完成委托工作"}, {"type": "subtitle", "time": 12086.87, "timestamp": "03:21:26", "text": "一切。所以，是的，但愿如此。"}, {"type": "subtitle", "time": 12089.349, "timestamp": "03:21:29", "text": "一切顺利的话，嗯，我保证"}, {"type": "subtitle", "time": 12091.83, "timestamp": "03:21:31", "text": "你放心，我不会把钱用于……"}, {"type": "subtitle", "time": 12094.309, "timestamp": "03:21:34", "text": "还要别的吗。这完全是为了"}, {"type": "subtitle", "time": 12096.79, "timestamp": "03:21:36", "text": "首次亮相。一切都只是为了V"}, {"type": "subtitle", "time": 12099.99, "timestamp": "03:21:39", "text": "用于模型索具的管材，"}, {"type": "subtitle", "time": 12102.87, "timestamp": "03:21:42", "text": "我非常喜欢这位漂亮的模特。"}, {"type": "subtitle", "time": 12106.55, "timestamp": "03:21:46", "text": "是的，还有其他一些需要做的事情。"}, {"type": "subtitle", "time": 12109.19, "timestamp": "03:21:49", "text": "呃，为了出道等等。"}, {"type": "subtitle", "time": 12111.19, "timestamp": "03:21:51", "text": "即使我无法拥有一个完美的"}, {"type": "subtitle", "time": 12114.87, "timestamp": "03:21:54", "text": "出道前，我设想了很多。"}, {"type": "subtitle", "time": 12117.91, "timestamp": "03:21:57", "text": "你知道吗，有趣的是，我的首秀"}]
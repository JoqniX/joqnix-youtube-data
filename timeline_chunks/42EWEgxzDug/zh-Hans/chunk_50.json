[{"type": "subtitle", "time": 3003.03, "timestamp": "00:50:03", "text": "哦，伙计。 Discord 应用。等等，你……"}, {"type": "subtitle", "time": 3005.51, "timestamp": "00:50:05", "text": "你电脑里应该装有两个 Discord 客户端。"}, {"type": "subtitle", "time": 3013.75, "timestamp": "00:50:13", "text": "哦，等等。您使用的是座机还是手机？"}, {"type": "subtitle", "time": 3016.47, "timestamp": "00:50:16", "text": "所以就像"}, {"type": "subtitle", "time": 3020.47, "timestamp": "00:50:20", "text": "B，告诉我，告诉我，你是怎么做到的？"}, {"type": "subtitle", "time": 3027.19, "timestamp": "00:50:27", "text": "因为我感觉我好像理解了"}, {"type": "subtitle", "time": 3032.23, "timestamp": "00:50:32", "text": "你的意思。所以，它实际上就像"}, {"type": "subtitle", "time": 3034.87, "timestamp": "00:50:34", "text": "这就像我加入一样"}, {"type": "subtitle", "time": 3039.03, "timestamp": "00:50:39", "text": "某个服务器，对吧？ Discord 服务器。"}, {"type": "subtitle", "time": 3041.03, "timestamp": "00:50:41", "text": "等等，"}, {"type": "subtitle", "time": 3043.829, "timestamp": "00:50:43", "text": "Discord 服务器。"}, {"type": "subtitle", "time": 3046.15, "timestamp": "00:50:46", "text": "所以，如果我加入服务器，它会"}, {"type": "subtitle", "time": 3048.47, "timestamp": "00:50:48", "text": "先展示金丝雀。例如，"}, {"type": "subtitle", "time": 3051.91, "timestamp": "00:50:51", "text": "Mjourney，对吧？如果我点击这个加入"}, {"type": "subtitle", "time": 3053.99, "timestamp": "00:50:53", "text": "服务器，对吧？"}, {"type": "subtitle", "time": 3057.03, "timestamp": "00:50:57", "text": "它会显示金丝雀。"}, {"type": "subtitle", "time": 3058.79, "timestamp": "00:50:58", "text": "如果我点击接受，就会显示"}]
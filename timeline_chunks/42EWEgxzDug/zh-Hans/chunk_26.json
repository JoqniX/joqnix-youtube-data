[{"type": "subtitle", "time": 1570.149, "timestamp": "00:26:10", "text": "我的天啊，笨蛋。我的天啊，什么？你好。"}, {"type": "subtitle", "time": 1587.669, "timestamp": "00:26:27", "text": "我错过了你的两场直播。"}, {"type": "subtitle", "time": 1589.909, "timestamp": "00:26:29", "text": "你的频道，兄弟。你说的“两个”是什么意思？"}, {"type": "subtitle", "time": 1591.83, "timestamp": "00:26:31", "text": "我的频道会进行直播吗？我没有"}, {"type": "subtitle", "time": 1599.43, "timestamp": "00:26:39", "text": "但我的意思是，我昨天直播了。"}, {"type": "subtitle", "time": 1606.63, "timestamp": "00:26:46", "text": "我相信你当时也在场。"}, {"type": "subtitle", "time": 1608.63, "timestamp": "00:26:48", "text": "一。除了现代战争之外，"}]
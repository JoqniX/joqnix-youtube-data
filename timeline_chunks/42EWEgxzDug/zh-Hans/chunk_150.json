[{"type": "subtitle", "time": 9002.95, "timestamp": "02:30:02", "text": "很多严肃的事情。我在想"}, {"type": "subtitle", "time": 9007.91, "timestamp": "02:30:07", "text": "就像为直播做事情一样"}, {"type": "subtitle", "time": 9009.67, "timestamp": "02:30:09", "text": "诚实地。"}, {"type": "subtitle", "time": 9011.75, "timestamp": "02:30:11", "text": "很多"}, {"type": "subtitle", "time": 9014.55, "timestamp": "02:30:14", "text": "有点像应用程序，也像开发人员"}, {"type": "subtitle", "time": 9016.87, "timestamp": "02:30:16", "text": "东西。是的。"}, {"type": "subtitle", "time": 9019.11, "timestamp": "02:30:19", "text": "嗯"}, {"type": "subtitle", "time": 9022.15, "timestamp": "02:30:22", "text": "从某种意义上说，这并非必要。"}, {"type": "subtitle", "time": 9024.63, "timestamp": "02:30:24", "text": "但我感觉这样做没问题。我"}, {"type": "subtitle", "time": 9026.55, "timestamp": "02:30:26", "text": "只想把它完成。未完成"}, {"type": "subtitle", "time": 9028.309, "timestamp": "02:30:28", "text": "把它关掉。我只是想做点什么。"}, {"type": "subtitle", "time": 9036.07, "timestamp": "02:30:36", "text": "对，那正是我想要的。"}, {"type": "subtitle", "time": 9037.83, "timestamp": "02:30:37", "text": "所以，"}, {"type": "subtitle", "time": 9040.63, "timestamp": "02:30:40", "text": "是的。嗯"}, {"type": "subtitle", "time": 9044.389, "timestamp": "02:30:44", "text": "我当时在想做几件事。"}, {"type": "subtitle", "time": 9048.71, "timestamp": "02:30:48", "text": "发布方式类似于时间表系统"}, {"type": "subtitle", "time": 9053.27, "timestamp": "02:30:53", "text": "很多有趣的东西，这样人们就可以……"}, {"type": "subtitle", "time": 9056.87, "timestamp": "02:30:56", "text": "他们已经监视我24小时了，或者类似这样"}, {"type": "subtitle", "time": 9059.27, "timestamp": "02:30:59", "text": "知道我正在直播24小时"}]
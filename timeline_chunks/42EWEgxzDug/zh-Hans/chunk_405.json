[{"type": "subtitle", "time": 24311.75, "timestamp": "06:45:11", "text": "我以为我们能拿下这局。等等，你是……"}, {"type": "subtitle", "time": 24315.91, "timestamp": "06:45:15", "text": "你也是印度人吗？我们走吧。"}, {"type": "subtitle", "time": 24317.55, "timestamp": "06:45:17", "text": "好的。"}, {"type": "subtitle", "time": 24319.11, "timestamp": "06:45:19", "text": "[音乐]"}, {"type": "subtitle", "time": 24331.35, "timestamp": "06:45:31", "text": "好了，这是最后一个了。"}, {"type": "subtitle", "time": 24333.83, "timestamp": "06:45:33", "text": "然后过场动画就会播放。"}, {"type": "subtitle", "time": 24340.788, "timestamp": "06:45:40", "text": "我的天哪！"}, {"type": "subtitle", "time": 24344.15, "timestamp": "06:45:44", "text": "我们又要这么做了。但愿如此"}, {"type": "subtitle", "time": 24346.708, "timestamp": "06:45:46", "text": "游戏不会崩溃，电脑也不会"}, {"type": "subtitle", "time": 24348.23, "timestamp": "06:45:48", "text": "碰撞"}, {"type": "subtitle", "time": 24350.948, "timestamp": "06:45:50", "text": "这次"}]
[{"type": "subtitle", "time": 11340.23, "timestamp": "03:09:00", "text": "所以这就是我为什么要证明这一点的原因。"}, {"type": "subtitle", "time": 11342.71, "timestamp": "03:09:02", "text": "我自己，以及所有我应得的人。"}, {"type": "subtitle", "time": 11346.07, "timestamp": "03:09:06", "text": "这种消解就像新来的运动员一样。不是"}, {"type": "subtitle", "time": 11349.03, "timestamp": "03:09:09", "text": "现任运动员，新来的运动员。新"}, {"type": "subtitle", "time": 11351.99, "timestamp": "03:09:11", "text": "我非常喜欢运动型男。我喜欢这样"}, {"type": "subtitle", "time": 11355.11, "timestamp": "03:09:15", "text": "经常当模特，伙计。我每时每刻都盯着它看。"}, {"type": "subtitle", "time": 11357.349, "timestamp": "03:09:17", "text": "夜晚。我知道，当我睡前，我知道"}, {"type": "subtitle", "time": 11359.67, "timestamp": "03:09:19", "text": "很糟糕"}, {"type": "subtitle", "time": 11362.79, "timestamp": "03:09:22", "text": "因为它太漂亮了。好吧，太过了。"}, {"type": "subtitle", "time": 11366.389, "timestamp": "03:09:26", "text": "真漂亮，太惊艳了。我"}, {"type": "subtitle", "time": 11368.87, "timestamp": "03:09:28", "text": "想给你们看看这款模型一。"}, {"type": "subtitle", "time": 11370.469, "timestamp": "03:09:30", "text": "天。"}, {"type": "subtitle", "time": 11372.87, "timestamp": "03:09:32", "text": "和"}, {"type": "subtitle", "time": 11375.75, "timestamp": "03:09:35", "text": "我认为自己不够资格挥舞它"}, {"type": "subtitle", "time": 11379.51, "timestamp": "03:09:39", "text": "那个新笑话。我必须做好准备"}, {"type": "subtitle", "time": 11383.91, "timestamp": "03:09:43", "text": "有资格使用那个新东西"}, {"type": "subtitle", "time": 11387.349, "timestamp": "03:09:47", "text": "我计划成为的模特或新我"}, {"type": "subtitle", "time": 11392.87, "timestamp": "03:09:52", "text": "这就是我这么做的主要原因。"}, {"type": "subtitle", "time": 11397.03, "timestamp": "03:09:57", "text": "畅谈马拉松。不仅仅是为了寻求资金"}]
[{"type": "subtitle", "time": 13383.11, "timestamp": "03:43:03", "text": "祝您今天过得愉快。我不会"}, {"type": "subtitle", "time": 13386.63, "timestamp": "03:43:06", "text": "接下来一周将进行流媒体播放"}, {"type": "subtitle", "time": 13390.07, "timestamp": "03:43:10", "text": "接下来你将看到的我的直播是……"}, {"type": "subtitle", "time": 13394.309, "timestamp": "03:43:14", "text": "第十二。好的。我将外出旅行，"}, {"type": "subtitle", "time": 13398.229, "timestamp": "03:43:18", "text": "从明天开始，事情就这些了。"}, {"type": "subtitle", "time": 13399.75, "timestamp": "03:43:19", "text": "东西。"}, {"type": "subtitle", "time": 13402.79, "timestamp": "03:43:22", "text": "是的，因为我必须做那些……"}, {"type": "subtitle", "time": 13405.03, "timestamp": "03:43:25", "text": "面对这些事吧。所以我希望一切顺利"}, {"type": "subtitle", "time": 13409.91, "timestamp": "03:43:29", "text": "一切顺利。我祝大家好运"}, {"type": "subtitle", "time": 13413.67, "timestamp": "03:43:33", "text": "在你自己的梦想和信念中，"}, {"type": "subtitle", "time": 13416.55, "timestamp": "03:43:36", "text": "呃，你做的一切。好的？不要"}, {"type": "subtitle", "time": 13418.79, "timestamp": "03:43:38", "text": "放弃。即使你正处于……的边缘"}, {"type": "subtitle", "time": 13421.59, "timestamp": "03:43:41", "text": "请不要放弃。你"}, {"type": "subtitle", "time": 13424.55, "timestamp": "03:43:44", "text": "看到虚拟主播，就如同看到了慰藉。"}, {"type": "subtitle", "time": 13428.15, "timestamp": "03:43:48", "text": "这位骑师正在试图做你的事"}, {"type": "subtitle", "time": 13430.469, "timestamp": "03:43:50", "text": "最好，对吧？就这样，我想"}, {"type": "subtitle", "time": 13433.429, "timestamp": "03:43:53", "text": "尽力而为。迈出一步"}, {"type": "subtitle", "time": 13436.229, "timestamp": "03:43:56", "text": "转发"}, {"type": "subtitle", "time": 13438.389, "timestamp": "03:43:58", "text": "一项倡议。"}]
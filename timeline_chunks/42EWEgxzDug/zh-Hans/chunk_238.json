[{"type": "subtitle", "time": 14283.349, "timestamp": "03:58:03", "text": "呃，换成这个。我们走吧。我们开始吧"}, {"type": "subtitle", "time": 14288.87, "timestamp": "03:58:08", "text": "去。我的天哪。我没事。"}, {"type": "subtitle", "time": 14298.95, "timestamp": "03:58:18", "text": "我希望音频没问题。好的。音频是"}, {"type": "subtitle", "time": 14304.15, "timestamp": "03:58:24", "text": "等等，等等，等等，等等。我 我 我"}, {"type": "subtitle", "time": 14305.67, "timestamp": "03:58:25", "text": "对不起。对不起。对不起。我只是"}, {"type": "subtitle", "time": 14312.63, "timestamp": "03:58:32", "text": "游戏前请阅读。好的。"}, {"type": "subtitle", "time": 14316.79, "timestamp": "03:58:36", "text": "对，就是那边的那个图。"}, {"type": "subtitle", "time": 14320.63, "timestamp": "03:58:40", "text": "类似于《命运2》的嗯"}, {"type": "subtitle", "time": 14323.99, "timestamp": "03:58:43", "text": "呃，蜂巢之类的。"}, {"type": "subtitle", "time": 14327.03, "timestamp": "03:58:47", "text": "诸如此类的事情，对吧？"}, {"type": "subtitle", "time": 14330.15, "timestamp": "03:58:50", "text": "还是只有我这么觉得？"}, {"type": "subtitle", "time": 14332.87, "timestamp": "03:58:52", "text": "是的，我也有这种感觉。"}, {"type": "subtitle", "time": 14335.269, "timestamp": "03:58:55", "text": "好吧，让我……让我……让我……让我……让我……"}, {"type": "subtitle", "time": 14338.79, "timestamp": "03:58:58", "text": "打开聊天窗口，这样我就可以看到你们的聊天内容了。"}]
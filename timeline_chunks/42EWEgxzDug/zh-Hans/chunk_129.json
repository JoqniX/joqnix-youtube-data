[{"type": "subtitle", "time": 7741.03, "timestamp": "02:09:01", "text": "是20%。电量达到 20% 时会发出哔哔声。"}, {"type": "subtitle", "time": 7743.589, "timestamp": "02:09:03", "text": "是的，我的耳机烧坏了其中一个"}, {"type": "subtitle", "time": 7745.109, "timestamp": "02:09:05", "text": "耳朵"}, {"type": "subtitle", "time": 7747.669, "timestamp": "02:09:07", "text": "指控已结束。所以它有点像……"}, {"type": "subtitle", "time": 7761.109, "timestamp": "02:09:21", "text": "为什么这个人"}, {"type": "subtitle", "time": 7775.03, "timestamp": "02:09:35", "text": "人更多了。"}, {"type": "subtitle", "time": 7777.51, "timestamp": "02:09:37", "text": "当然。"}, {"type": "subtitle", "time": 7779.589, "timestamp": "02:09:39", "text": "嗯"}, {"type": "subtitle", "time": 7783.589, "timestamp": "02:09:43", "text": "问题是，我想要做这种事。"}, {"type": "subtitle", "time": 7786.149, "timestamp": "02:09:46", "text": "结束的感觉"}, {"type": "subtitle", "time": 7791.109, "timestamp": "02:09:51", "text": "这种12小时制的，不是12小时制的，而是24小时制的。"}, {"type": "subtitle", "time": 7793.91, "timestamp": "02:09:53", "text": "一次性流"}, {"type": "subtitle", "time": 7795.51, "timestamp": "02:09:55", "text": "诚实地"}, {"type": "subtitle", "time": 7798.39, "timestamp": "02:09:58", "text": "因为我感觉"}]
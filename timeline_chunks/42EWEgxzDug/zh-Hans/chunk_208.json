[{"type": "subtitle", "time": 12482.15, "timestamp": "03:28:02", "text": "YouTube，请锁定直播流。"}, {"type": "subtitle", "time": 12487.269, "timestamp": "03:28:07", "text": "好的？因为我需要尽可能多的观看时间"}, {"type": "subtitle", "time": 12492.71, "timestamp": "03:28:12", "text": "能够承受高压推"}, {"type": "subtitle", "time": 12495.11, "timestamp": "03:28:15", "text": "呃，为了盈利。"}, {"type": "subtitle", "time": 12497.03, "timestamp": "03:28:17", "text": "我知道我能做到。我相信我的"}, {"type": "subtitle", "time": 12500.469, "timestamp": "03:28:20", "text": "星座和音乐会唱片。我们可以"}, {"type": "subtitle", "time": 12503.51, "timestamp": "03:28:23", "text": "一起做这件事。不。"}, {"type": "subtitle", "time": 12506.469, "timestamp": "03:28:26", "text": "我不想让它仅仅停留在梦想阶段。"}, {"type": "subtitle", "time": 12509.269, "timestamp": "03:28:29", "text": "成为 YouTube 合作伙伴。好的。喜欢"}, {"type": "subtitle", "time": 12512.71, "timestamp": "03:28:32", "text": "去年，前天，前年，"}, {"type": "subtitle", "time": 12514.79, "timestamp": "03:28:34", "text": "今年，每次我说“我”的时候"}, {"type": "subtitle", "time": 12516.71, "timestamp": "03:28:36", "text": "我想开通 YouTube 会员，而且"}, {"type": "subtitle", "time": 12520.389, "timestamp": "03:28:40", "text": "想获得会员资格等等。"}, {"type": "subtitle", "time": 12523.59, "timestamp": "03:28:43", "text": "是的，因为他们把一些好功能锁住了。"}, {"type": "subtitle", "time": 12526.07, "timestamp": "03:28:46", "text": "将 YouTube 纳入这个会员资格"}, {"type": "subtitle", "time": 12528.229, "timestamp": "03:28:48", "text": "那个东西，伴侣的那个东西。真令人难过。"}, {"type": "subtitle", "time": 12530.79, "timestamp": "03:28:50", "text": "但没办法，事情就是这样。"}]
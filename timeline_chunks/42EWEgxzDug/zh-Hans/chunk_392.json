[{"type": "subtitle", "time": 23523.59, "timestamp": "06:32:03", "text": "真是太棒了！"}, {"type": "subtitle", "time": 23525.91, "timestamp": "06:32:05", "text": "是的。您能过来一下吗？过来这里"}, {"type": "subtitle", "time": 23534.15, "timestamp": "06:32:14", "text": "上次我用他的手"}, {"type": "subtitle", "time": 23537.19, "timestamp": "06:32:17", "text": "他去世的时候。这一次他是"}, {"type": "subtitle", "time": 23539.27, "timestamp": "06:32:19", "text": "活。"}, {"type": "subtitle", "time": 23543.03, "timestamp": "06:32:23", "text": "没关系。你快到了。啊，是的"}, {"type": "subtitle", "time": 23576.868, "timestamp": "06:32:56", "text": "看，"}, {"type": "subtitle", "time": 23579.27, "timestamp": "06:32:59", "text": "我很抱歉那样做。我很抱歉"}]
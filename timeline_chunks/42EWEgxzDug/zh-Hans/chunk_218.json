[{"type": "subtitle", "time": 13081.75, "timestamp": "03:38:01", "text": "那个模型，尤其是那位艺术家"}, {"type": "subtitle", "time": 13083.19, "timestamp": "03:38:03", "text": "一切。我不能透露是谁"}, {"type": "subtitle", "time": 13086.309, "timestamp": "03:38:06", "text": "这位艺术家是，或者现在与他合作过的人。"}, {"type": "subtitle", "time": 13089.99, "timestamp": "03:38:09", "text": "但一旦首秀发生，我就能说得通了。"}, {"type": "subtitle", "time": 13095.75, "timestamp": "03:38:15", "text": "我只能说这些了。巴。"}, {"type": "subtitle", "time": 13097.67, "timestamp": "03:38:17", "text": "你好。"}, {"type": "subtitle", "time": 13100.79, "timestamp": "03:38:20", "text": "我们听到了一个关于命令的笑话。我的意思是，你"}, {"type": "subtitle", "time": 13103.99, "timestamp": "03:38:23", "text": "可以想象一下那样。我"}, {"type": "subtitle", "time": 13106.389, "timestamp": "03:38:26", "text": "不知道。"}, {"type": "subtitle", "time": 13109.269, "timestamp": "03:38:29", "text": "我无法喜欢"}, {"type": "chat", "time": 13111.836, "timestamp": "03:38:31", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Shhh... ζ͜͡𝕲𝖍𝖔𝖘𝖙 𔓎, Joq is resting. 🌙 Welcome to the Guild, and enjoy the past joq's memories!"}, {"type": "subtitle", "time": 13113.19, "timestamp": "03:38:33", "text": "运动健将这个词没有特定的性别。"}, {"type": "subtitle", "time": 13116.87, "timestamp": "03:38:36", "text": "或者任何东西。不，现在是安卓系统了。"}, {"type": "subtitle", "time": 13120.229, "timestamp": "03:38:40", "text": "我想，就像我的声音一样吧。"}, {"type": "subtitle", "time": 13123.429, "timestamp": "03:38:43", "text": "所以，我可以成为你想让我成为的任何人。"}, {"type": "subtitle", "time": 13125.349, "timestamp": "03:38:45", "text": "你可以称呼我为他或她，或者"}, {"type": "subtitle", "time": 13132.229, "timestamp": "03:38:52", "text": "所以它完全符合我的设想。"}, {"type": "subtitle", "time": 13135.19, "timestamp": "03:38:55", "text": "这份工作以及所有的一切。"}, {"type": "subtitle", "time": 13138.469, "timestamp": "03:38:58", "text": "你好。但愿一切顺利。"}]
[{"type": "subtitle", "time": 2763.43, "timestamp": "00:46:03", "text": "不，"}, {"type": "subtitle", "time": 2767.67, "timestamp": "00:46:07", "text": "我当时在他脸上。不，"}, {"type": "subtitle", "time": 2771.03, "timestamp": "00:46:11", "text": "我的弹匣也用完了。"}, {"type": "subtitle", "time": 2772.87, "timestamp": "00:46:12", "text": "我觉得我当时就像在绕着他转圈一样。"}, {"type": "subtitle", "time": 2777.27, "timestamp": "00:46:17", "text": "脖子、脖子，还有他呃，大脚趾。所以"}, {"type": "subtitle", "time": 2778.95, "timestamp": "00:46:18", "text": "所以才算作击中身体。"}, {"type": "subtitle", "time": 2782.069, "timestamp": "00:46:22", "text": "而不是爆头。哦，"}, {"type": "subtitle", "time": 2806.95, "timestamp": "00:46:46", "text": "我得了11400分。"}, {"type": "subtitle", "time": 2809.589, "timestamp": "00:46:49", "text": "所以，再过一关我就能拿到我的"}, {"type": "subtitle", "time": 2816.95, "timestamp": "00:46:56", "text": "12,000。我可以获得一个新的传奇角色。"}]
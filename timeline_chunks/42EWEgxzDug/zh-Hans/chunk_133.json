[{"type": "subtitle", "time": 7980.149, "timestamp": "02:13:00", "text": "向前"}, {"type": "subtitle", "time": 7984.629, "timestamp": "02:13:04", "text": "那边还有些人被占领了。"}, {"type": "subtitle", "time": 7986.79, "timestamp": "02:13:06", "text": "是的，"}, {"type": "subtitle", "time": 7989.669, "timestamp": "02:13:09", "text": "就像家人或阿姨一样"}, {"type": "subtitle", "time": 7993.109, "timestamp": "02:13:13", "text": "一位叔叔喜欢抚摸狗"}, {"type": "subtitle", "time": 7996.069, "timestamp": "02:13:16", "text": "他们太自私了。"}, {"type": "subtitle", "time": 7998.87, "timestamp": "02:13:18", "text": "那真好"}, {"type": "subtitle", "time": 8033.51, "timestamp": "02:13:53", "text": "我的天哪，这东西。"}, {"type": "subtitle", "time": 8037.27, "timestamp": "02:13:57", "text": "是的。电池剩余10%。"}, {"type": "subtitle", "time": 8039.109, "timestamp": "02:13:59", "text": "我该害怕吗？还是不该害怕？"}]
[{"type": "subtitle", "time": 4023.029, "timestamp": "01:07:03", "text": "亡灵。最后，拉维·陈也来了。"}, {"type": "subtitle", "time": 4029.99, "timestamp": "01:07:09", "text": "[音乐]"}, {"type": "subtitle", "time": 4031.99, "timestamp": "01:07:11", "text": "而且你知道，今天是"}, {"type": "subtitle", "time": 4034.069, "timestamp": "01:07:14", "text": "10月18日是……的周年纪念日"}, {"type": "subtitle", "time": 4039.029, "timestamp": "01:07:19", "text": "卡凡。我的天啊。我的天啊。今天我的"}, {"type": "subtitle", "time": 4042.71, "timestamp": "01:07:22", "text": "周年纪念日。我的天啊。离开。我是"}, {"type": "subtitle", "time": 4066.23, "timestamp": "01:07:46", "text": "我的嗓子快要哑了。"}, {"type": "subtitle", "time": 4068.95, "timestamp": "01:07:48", "text": "好了，我们开始游戏吧。我做了"}, {"type": "subtitle", "time": 4072.39, "timestamp": "01:07:52", "text": "我还没打开。什么？你好，"}, {"type": "subtitle", "time": 4074.47, "timestamp": "01:07:54", "text": "娜妮。"}, {"type": "subtitle", "time": 4076.39, "timestamp": "01:07:56", "text": "卡。"}, {"type": "subtitle", "time": 4078.15, "timestamp": "01:07:58", "text": "好了，让我们开始游戏吧。应该"}]
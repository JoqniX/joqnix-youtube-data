[{"type": "subtitle", "time": 8168.069, "timestamp": "02:16:08", "text": "是的。而且我意识到，我确实做了"}, {"type": "subtitle", "time": 8170.87, "timestamp": "02:16:10", "text": "昨天的一条推文"}, {"type": "subtitle", "time": 8173.51, "timestamp": "02:16:13", "text": "大概是早上吧。我是说今天"}, {"type": "subtitle", "time": 8176.79, "timestamp": "02:16:16", "text": "早上我整夜都没睡。有点向上"}, {"type": "subtitle", "time": 8181.35, "timestamp": "02:16:21", "text": "整夜。我看了《鱿鱼游戏3》"}, {"type": "subtitle", "time": 8183.35, "timestamp": "02:16:23", "text": "道路。"}, {"type": "subtitle", "time": 8186.39, "timestamp": "02:16:26", "text": "呃，最近"}, {"type": "subtitle", "time": 8189.669, "timestamp": "02:16:29", "text": "我看了那些动漫，"}, {"type": "subtitle", "time": 8191.669, "timestamp": "02:16:31", "text": "东西。是的。这一切都发生在考试期间。"}, {"type": "subtitle", "time": 8201.429, "timestamp": "02:16:41", "text": "嗯"}, {"type": "subtitle", "time": 8208.389, "timestamp": "02:16:48", "text": "呃，我想看几部电影，"}, {"type": "subtitle", "time": 8212.389, "timestamp": "02:16:52", "text": "事情，但我意识到我可以做那件事。"}, {"type": "subtitle", "time": 8215.03, "timestamp": "02:16:55", "text": "单就手表本身而言，"}, {"type": "subtitle", "time": 8217.669, "timestamp": "02:16:57", "text": "你知道，这段代码里的每个人都……"}]
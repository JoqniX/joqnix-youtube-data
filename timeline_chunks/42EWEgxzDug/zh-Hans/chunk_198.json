[{"type": "subtitle", "time": 11880.309, "timestamp": "03:18:00", "text": "我也在线上操作，因为我不能偷懒。"}, {"type": "subtitle", "time": 11883.429, "timestamp": "03:18:03", "text": "你知道你必须努力工作才能养活自己。"}, {"type": "subtitle", "time": 11887.83, "timestamp": "03:18:07", "text": "即使是一卢比或1美元，你也完全正确。"}, {"type": "subtitle", "time": 11890.229, "timestamp": "03:18:10", "text": "就像最小的量一样"}, {"type": "subtitle", "time": 11894.63, "timestamp": "03:18:14", "text": "很多，太多了，对吧？是的。"}, {"type": "subtitle", "time": 11896.79, "timestamp": "03:18:16", "text": "如此巨额的金额实在太多了。我"}, {"type": "subtitle", "time": 11898.95, "timestamp": "03:18:18", "text": "知道。我真的可以买太多了"}, {"type": "subtitle", "time": 11901.75, "timestamp": "03:18:21", "text": "比如iPhone之类的。"}, {"type": "subtitle", "time": 11913.91, "timestamp": "03:18:33", "text": "但我知道我这样做很自私。我正在"}, {"type": "subtitle", "time": 11923.269, "timestamp": "03:18:43", "text": "我从很多跑步者那里都听到过这种说法。呃"}, {"type": "subtitle", "time": 11924.79, "timestamp": "03:18:44", "text": "那"}, {"type": "subtitle", "time": 11926.71, "timestamp": "03:18:46", "text": "你真的想这么做吗？"}, {"type": "subtitle", "time": 11930.07, "timestamp": "03:18:50", "text": "一切？你能做到吗？"}, {"type": "subtitle", "time": 11932.71, "timestamp": "03:18:52", "text": "一切都结束了吗？当时有很多疑问。"}, {"type": "subtitle", "time": 11935.59, "timestamp": "03:18:55", "text": "那里对很多人来说都是如此。"}, {"type": "subtitle", "time": 11937.429, "timestamp": "03:18:57", "text": "我想证明他们错了。我想要"}, {"type": "subtitle", "time": 11939.59, "timestamp": "03:18:59", "text": "为了证明我可以这样做"}]
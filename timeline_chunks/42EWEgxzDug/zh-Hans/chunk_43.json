[{"type": "subtitle", "time": 2582.23, "timestamp": "00:43:02", "text": "这是什么？"}, {"type": "subtitle", "time": 2598.87, "timestamp": "00:43:18", "text": "我死于那场风暴。我其实"}, {"type": "subtitle", "time": 2602.44, "timestamp": "00:43:22", "text": "死了。好的。模拟人生，"}, {"type": "subtitle", "time": 2631.75, "timestamp": "00:43:51", "text": "两名纳粹分子。"}, {"type": "subtitle", "time": 2639.91, "timestamp": "00:43:59", "text": "哦，对了，还有一个。实际上，从现在开始我"}]
[{"type": "subtitle", "time": 22985.91, "timestamp": "06:23:05", "text": "请不要告诉我我不能搬家"}, {"type": "subtitle", "time": 22997.09, "timestamp": "06:23:17", "text": "我无法进行更改"}, {"type": "subtitle", "time": 23003.83, "timestamp": "06:23:23", "text": "好的，这边走。哦，等等。我觉得我"}, {"type": "subtitle", "time": 23005.67, "timestamp": "06:23:25", "text": "知道了。我想我明白了。我觉得我得到了"}, {"type": "subtitle", "time": 23011.51, "timestamp": "06:23:31", "text": "它。我们走吧。我们走吧。我们明白了。是的。"}, {"type": "subtitle", "time": 23014.31, "timestamp": "06:23:34", "text": "聪明绝顶。"}, {"type": "subtitle", "time": 23020.868, "timestamp": "06:23:40", "text": "最后。"}, {"type": "subtitle", "time": 23022.868, "timestamp": "06:23:42", "text": "等等，我需要截个图。"}, {"type": "subtitle", "time": 23024.77, "timestamp": "06:23:44", "text": "这。"}, {"type": "subtitle", "time": 23027.83, "timestamp": "06:23:47", "text": "[音乐]"}, {"type": "subtitle", "time": 23030.708, "timestamp": "06:23:50", "text": "我们需要截取这个屏幕截图。"}, {"type": "subtitle", "time": 23033.51, "timestamp": "06:23:53", "text": "以防万一嘛。谁知道呢"}, {"type": "subtitle", "time": 23036.31, "timestamp": "06:23:56", "text": "可能会发生什么？"}, {"type": "subtitle", "time": 23039.27, "timestamp": "06:23:59", "text": "好的，第一个将是"}]
[{"type": "subtitle", "time": 12420.07, "timestamp": "03:27:00", "text": "我相信我已经把一切都安排妥当了。"}, {"type": "subtitle", "time": 12422.87, "timestamp": "03:27:02", "text": "习惯了这种生活方式，可以拥有一个"}, {"type": "subtitle", "time": 12426.309, "timestamp": "03:27:06", "text": "将会购买一台能够……的笔记本电脑"}, {"type": "subtitle", "time": 12428.63, "timestamp": "03:27:08", "text": "承受了一切"}, {"type": "subtitle", "time": 12431.349, "timestamp": "03:27:11", "text": "嗯，还有其他的一切。是的，一台笔记本电脑，所以我"}, {"type": "subtitle", "time": 12434.07, "timestamp": "03:27:14", "text": "可以进行流媒体播放等等。"}, {"type": "subtitle", "time": 12436.55, "timestamp": "03:27:16", "text": "希望我的室友不会太生我的气。"}, {"type": "subtitle", "time": 12438.229, "timestamp": "03:27:18", "text": "我猜也是。我不知道。我在想"}, {"type": "subtitle", "time": 12440.79, "timestamp": "03:27:20", "text": "再次。我又在考虑长远的事情了。我"}, {"type": "subtitle", "time": 12443.11, "timestamp": "03:27:23", "text": "不知道。是啊，是啊。呃，我会"}, {"type": "subtitle", "time": 12446.63, "timestamp": "03:27:26", "text": "让未来的医生来处理这件事吧。我"}, {"type": "subtitle", "time": 12448.55, "timestamp": "03:27:28", "text": "不应该为未来担忧。"}, {"type": "subtitle", "time": 12451.429, "timestamp": "03:27:31", "text": "现在。我应该担心的是"}, {"type": "subtitle", "time": 12455.19, "timestamp": "03:27:35", "text": "我现在能做的。正确的。"}, {"type": "subtitle", "time": 12457.349, "timestamp": "03:27:37", "text": "你好。"}, {"type": "subtitle", "time": 12459.349, "timestamp": "03:27:39", "text": "是的，这就是活动时间表。"}, {"type": "subtitle", "time": 12461.91, "timestamp": "03:27:41", "text": "3月12日至6月。我把它标记一下。"}, {"type": "subtitle", "time": 12469.83, "timestamp": "03:27:49", "text": "是的。"}, {"type": "subtitle", "time": 12472.55, "timestamp": "03:27:52", "text": "所以，"}, {"type": "subtitle", "time": 12476.309, "timestamp": "03:27:56", "text": "你好。所以，嗯，在这次活动中，我唯一想问的是"}, {"type": "subtitle", "time": 12479.03, "timestamp": "03:27:59", "text": "如果你在Twitch上，或者如果你在……"}]
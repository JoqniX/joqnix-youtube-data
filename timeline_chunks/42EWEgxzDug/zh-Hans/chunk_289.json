[{"type": "subtitle", "time": 17341.51, "timestamp": "04:49:01", "text": "我认为我此行的主要目标是"}, {"type": "subtitle", "time": 17347.27, "timestamp": "04:49:07", "text": "把这个发光的东西弄上去"}, {"type": "subtitle", "time": 17355.27, "timestamp": "04:49:15", "text": "我的目标是"}, {"type": "subtitle", "time": 17366.948, "timestamp": "04:49:26", "text": "[音乐]"}, {"type": "subtitle", "time": 17371.03, "timestamp": "04:49:31", "text": "我的天，外面有朵莲花呢。"}, {"type": "subtitle", "time": 17373.03, "timestamp": "04:49:33", "text": "还有很多人抱团欺凌。我"}, {"type": "subtitle", "time": 17375.19, "timestamp": "04:49:35", "text": "不知道。"}]
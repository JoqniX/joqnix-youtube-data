[{"type": "subtitle", "time": 19202.628, "timestamp": "05:20:02", "text": "我的天哪。"}, {"type": "subtitle", "time": 19211.91, "timestamp": "05:20:11", "text": "我们终于快要到达目的地了。"}, {"type": "subtitle", "time": 19213.91, "timestamp": "05:20:13", "text": "哦，等等。周围一片寂静。没有人"}, {"type": "subtitle", "time": 19218.07, "timestamp": "05:20:18", "text": "他跟我说过这件事。哦，回来吧。"}, {"type": "subtitle", "time": 19221.51, "timestamp": "05:20:21", "text": "没人告诉我会有这种声音。"}, {"type": "subtitle", "time": 19224.868, "timestamp": "05:20:24", "text": "好了，就是这样。"}, {"type": "subtitle", "time": 19245.35, "timestamp": "05:20:45", "text": "[音乐]"}]
[{"type": "subtitle", "time": 25742.31, "timestamp": "07:09:02", "text": "是的，就像我刚才说的，我看了"}, {"type": "subtitle", "time": 25745.35, "timestamp": "07:09:05", "text": "玩家优先"}, {"type": "subtitle", "time": 25750.23, "timestamp": "07:09:10", "text": "在YouTube上，我看了《地下城寻求邂逅是否搞错了什么》。"}, {"type": "subtitle", "time": 25754.31, "timestamp": "07:09:14", "text": "在 YouTube 上排名第二的 Dan Machi。第二，"}, {"type": "subtitle", "time": 25756.23, "timestamp": "07:09:16", "text": "第二部动画是《在地下城寻求邂逅是否搞错了什么》。然后我"}, {"type": "subtitle", "time": 25758.788, "timestamp": "07:09:18", "text": "我想，是啊，你知道吗？然后我"}, {"type": "subtitle", "time": 25762.07, "timestamp": "07:09:22", "text": "会看动漫"}, {"type": "subtitle", "time": 25768.23, "timestamp": "07:09:28", "text": "它叫什么？然后我会看"}, {"type": "subtitle", "time": 25770.548, "timestamp": "07:09:30", "text": "来自其他网站的动漫"}, {"type": "subtitle", "time": 25772.548, "timestamp": "07:09:32", "text": "某物。然后我看了《亲爱的》"}, {"type": "subtitle", "time": 25774.868, "timestamp": "07:09:34", "text": "弗兰克斯之类的。那是"}, {"type": "subtitle", "time": 25778.548, "timestamp": "07:09:38", "text": "我的动漫之旅是如何偶然开启的"}, {"type": "subtitle", "time": 25781.67, "timestamp": "07:09:41", "text": "在 YouTube 之类的网站上发现的。"}]
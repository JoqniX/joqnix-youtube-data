[{"type": "subtitle", "time": 18490.708, "timestamp": "05:08:10", "text": "想工作。我不知道那是什么"}, {"type": "subtitle", "time": 18507.67, "timestamp": "05:08:27", "text": "等等，如果我把这些球拿出来呢？"}, {"type": "subtitle", "time": 18509.83, "timestamp": "05:08:29", "text": "把它们放在中间，然后拿走这些"}, {"type": "subtitle", "time": 18514.628, "timestamp": "05:08:34", "text": "轻一点的，放在这里？"}, {"type": "subtitle", "time": 18517.03, "timestamp": "05:08:37", "text": "乔，你喜欢科学吗？是的，我当然……"}, {"type": "subtitle", "time": 18519.27, "timestamp": "05:08:39", "text": "热爱科学。"}, {"type": "subtitle", "time": 18526.31, "timestamp": "05:08:46", "text": "我对神学方面的东西不太擅长。"}]
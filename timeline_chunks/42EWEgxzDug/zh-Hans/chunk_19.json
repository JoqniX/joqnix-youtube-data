[{"type": "subtitle", "time": 1142.63, "timestamp": "00:19:02", "text": "哦，这两个人在露营。好的。他们是"}, {"type": "subtitle", "time": 1150.63, "timestamp": "00:19:10", "text": "你是如何看待敌人的？哦"}, {"type": "subtitle", "time": 1153.51, "timestamp": "00:19:13", "text": "我的上帝，"}, {"type": "subtitle", "time": 1156.15, "timestamp": "00:19:16", "text": "他们有一个……这个人视力很好"}, {"type": "subtitle", "time": 1183.59, "timestamp": "00:19:43", "text": "是啊，如果我不说话的话，你就走吧。"}, {"type": "subtitle", "time": 1186.07, "timestamp": "00:19:46", "text": "到"}]
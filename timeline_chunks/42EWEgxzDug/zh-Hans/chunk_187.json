[{"type": "subtitle", "time": 11221.19, "timestamp": "03:07:01", "text": "回到我刚才说的重点，"}, {"type": "subtitle", "time": 11224.95, "timestamp": "03:07:04", "text": "这一点，也是最重要的一点，"}, {"type": "subtitle", "time": 11229.91, "timestamp": "03:07:09", "text": "我知道我不配拥有这一切。"}, {"type": "subtitle", "time": 11232.63, "timestamp": "03:07:12", "text": "再说一遍，我是以我这个冒牌货的身份说话的。"}, {"type": "subtitle", "time": 11235.59, "timestamp": "03:07:15", "text": "综合症，开玩笑模式，不过，是的，我"}, {"type": "subtitle", "time": 11238.63, "timestamp": "03:07:18", "text": "我知道自己患上了冒名顶替综合症。"}, {"type": "subtitle", "time": 11240.79, "timestamp": "03:07:20", "text": "因此"}, {"type": "subtitle", "time": 11243.75, "timestamp": "03:07:23", "text": "我想亲眼看看。好的。那"}, {"type": "subtitle", "time": 11248.71, "timestamp": "03:07:28", "text": "不管我是否配得上。这一切都是新的"}, {"type": "subtitle", "time": 11251.51, "timestamp": "03:07:31", "text": "运动健将"}, {"type": "subtitle", "time": 11255.19, "timestamp": "03:07:35", "text": "我不想它失败。好的。"}, {"type": "subtitle", "time": 11257.99, "timestamp": "03:07:37", "text": "这五年或四年的我"}, {"type": "subtitle", "time": 11261.59, "timestamp": "03:07:41", "text": "我觉得我失败了很多次。"}, {"type": "subtitle", "time": 11264.63, "timestamp": "03:07:44", "text": "我不能……"}, {"type": "subtitle", "time": 11268.87, "timestamp": "03:07:48", "text": "我觉得我并没有更努力。"}, {"type": "subtitle", "time": 11271.429, "timestamp": "03:07:51", "text": "每当我回想起我所做的事时，我总是会想起我所做的事。"}, {"type": "subtitle", "time": 11273.91, "timestamp": "03:07:53", "text": "这四五年来，我一直感到难过。"}, {"type": "subtitle", "time": 11276.469, "timestamp": "03:07:56", "text": "那"}]
[{"type": "subtitle", "time": 11283.11, "timestamp": "03:08:03", "text": "我把太多时间花在了别人身上，没有"}, {"type": "subtitle", "time": 11287.269, "timestamp": "03:08:07", "text": "我？与其关注自己，不如关注自己"}, {"type": "subtitle", "time": 11289.429, "timestamp": "03:08:09", "text": "你们。"}, {"type": "subtitle", "time": 11291.67, "timestamp": "03:08:11", "text": "有一次我差点牺牲了自己。"}, {"type": "subtitle", "time": 11294.95, "timestamp": "03:08:14", "text": "我所在的社区只是为了帮助其他人。"}, {"type": "subtitle", "time": 11297.51, "timestamp": "03:08:17", "text": "人们带着他们的梦想和一切，"}, {"type": "subtitle", "time": 11302.79, "timestamp": "03:08:22", "text": "但"}, {"type": "subtitle", "time": 11304.71, "timestamp": "03:08:24", "text": "这次"}, {"type": "subtitle", "time": 11307.269, "timestamp": "03:08:27", "text": "我想，有时候我"}, {"type": "subtitle", "time": 11309.99, "timestamp": "03:08:29", "text": "当时差不多就要毕业了。"}, {"type": "subtitle", "time": 11311.59, "timestamp": "03:08:31", "text": "向上"}, {"type": "subtitle", "time": 11314.95, "timestamp": "03:08:34", "text": "因为我不知道自己能做什么。什么"}, {"type": "subtitle", "time": 11318.309, "timestamp": "03:08:38", "text": "我可以做什么，以及我们曾经拥有的一切。"}, {"type": "subtitle", "time": 11320.469, "timestamp": "03:08:40", "text": "那些问题，我们到处都遇到过。"}, {"type": "subtitle", "time": 11323.11, "timestamp": "03:08:43", "text": "这些年和这些课程"}, {"type": "subtitle", "time": 11325.99, "timestamp": "03:08:45", "text": "多年后，我从那些憎恨我的人手中走了出来。"}, {"type": "subtitle", "time": 11327.67, "timestamp": "03:08:47", "text": "他说，这是一个新的篇章，"}, {"type": "subtitle", "time": 11329.75, "timestamp": "03:08:49", "text": "一切都好"}, {"type": "subtitle", "time": 11332.389, "timestamp": "03:08:52", "text": "是的，我不想在这里唱衰。"}, {"type": "subtitle", "time": 11336.55, "timestamp": "03:08:56", "text": "但是，是的，强加者综合症警报"}]
[{"type": "subtitle", "time": 13141.75, "timestamp": "03:39:01", "text": "出色地。最后，我只想说……"}, {"type": "subtitle", "time": 13145.59, "timestamp": "03:39:05", "text": "感谢你一直以来的陪伴。"}, {"type": "subtitle", "time": 13147.75, "timestamp": "03:39:07", "text": "这些年。"}, {"type": "subtitle", "time": 13149.349, "timestamp": "03:39:09", "text": "好的。"}, {"type": "subtitle", "time": 13153.429, "timestamp": "03:39:13", "text": "你们很多人都在等待。你等了。"}, {"type": "subtitle", "time": 13157.349, "timestamp": "03:39:17", "text": "耐心等待。呃，他一直盯着我看，当我"}, {"type": "subtitle", "time": 13160.389, "timestamp": "03:39:20", "text": "之前没有这样的模型或实时 2D 动画。"}, {"type": "subtitle", "time": 13161.91, "timestamp": "03:39:21", "text": "一直盯着我看，一直……"}, {"type": "subtitle", "time": 13164.469, "timestamp": "03:39:24", "text": "在我刚入行的时候给予我支持"}, {"type": "subtitle", "time": 13166.87, "timestamp": "03:39:26", "text": "YouTube等等。"}, {"type": "subtitle", "time": 13168.87, "timestamp": "03:39:28", "text": "顺便说一句，非常非常感谢你！"}, {"type": "subtitle", "time": 13170.71, "timestamp": "03:39:30", "text": "你们所做的一切"}, {"type": "subtitle", "time": 13173.429, "timestamp": "03:39:33", "text": "我。"}, {"type": "subtitle", "time": 13176.71, "timestamp": "03:39:36", "text": "我一直后悔自己从未成为……"}, {"type": "subtitle", "time": 13178.63, "timestamp": "03:39:38", "text": "能够为你提供好东西"}, {"type": "subtitle", "time": 13184.63, "timestamp": "03:39:44", "text": "但"}, {"type": "subtitle", "time": 13187.51, "timestamp": "03:39:47", "text": "我相信我能够提供良好的服务。"}, {"type": "subtitle", "time": 13190.309, "timestamp": "03:39:50", "text": "给你们准备的东西，比如周边商品等等"}, {"type": "subtitle", "time": 13191.99, "timestamp": "03:39:51", "text": "一切。"}, {"type": "subtitle", "time": 13194.469, "timestamp": "03:39:54", "text": "但我想要朝着这个方向努力。我"}, {"type": "subtitle", "time": 13196.15, "timestamp": "03:39:56", "text": "这就是我去日本的原因。"}, {"type": "subtitle", "time": 13199.19, "timestamp": "03:39:59", "text": "好的。我知道这是自私的。"}]
[{"type": "subtitle", "time": 13260.63, "timestamp": "03:41:00", "text": "公告和这个呃……东西。我知道"}, {"type": "subtitle", "time": 13262.63, "timestamp": "03:41:02", "text": "我想做一个30分钟的公告，"}, {"type": "subtitle", "time": 13265.83, "timestamp": "03:41:05", "text": "但最后大概持续了一个小时左右。但"}, {"type": "subtitle", "time": 13269.03, "timestamp": "03:41:09", "text": "感谢所有上锁的人，"}, {"type": "subtitle", "time": 13271.83, "timestamp": "03:41:11", "text": "积极聊天，谁要去"}, {"type": "subtitle", "time": 13273.99, "timestamp": "03:41:13", "text": "请观看这个公告。"}, {"type": "subtitle", "time": 13277.99, "timestamp": "03:41:17", "text": "未来亦是如此。谢谢大家"}, {"type": "subtitle", "time": 13280.389, "timestamp": "03:41:20", "text": "感谢所有参加音乐会的人"}, {"type": "subtitle", "time": 13284.469, "timestamp": "03:41:24", "text": "盘子里是谁相信我"}, {"type": "subtitle", "time": 13287.429, "timestamp": "03:41:27", "text": "相信我，并且愿意付出"}, {"type": "subtitle", "time": 13290.309, "timestamp": "03:41:30", "text": "请再次信任我。"}, {"type": "subtitle", "time": 13294.389, "timestamp": "03:41:34", "text": "谢谢。我很高兴我现在在这里。"}, {"type": "subtitle", "time": 13298.309, "timestamp": "03:41:38", "text": "能够直播，能够做我能做的事"}, {"type": "subtitle", "time": 13303.19, "timestamp": "03:41:43", "text": "能够追逐我的梦想"}, {"type": "subtitle", "time": 13305.83, "timestamp": "03:41:45", "text": "我希望我能给你带来启发。"}, {"type": "subtitle", "time": 13309.269, "timestamp": "03:41:49", "text": "你自己的梦想。好的，"}, {"type": "subtitle", "time": 13311.75, "timestamp": "03:41:51", "text": "因为我真正的旅程，我想成为"}, {"type": "subtitle", "time": 13315.03, "timestamp": "03:41:55", "text": "对他人具有启发意义。这就是我的原因"}, {"type": "subtitle", "time": 13317.99, "timestamp": "03:41:57", "text": "我做了短领子，因为我想要我的"}]
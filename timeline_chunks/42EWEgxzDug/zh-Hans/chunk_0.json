[{"type": "subtitle", "time": 3.11, "timestamp": "00:00:03", "text": "天哪，十月都过半了。"}, {"type": "subtitle", "time": 9.03, "timestamp": "00:00:09", "text": "是的，"}, {"type": "subtitle", "time": 13.91, "timestamp": "00:00:13", "text": "我的嗓子哑了，因为我不小心"}, {"type": "subtitle", "time": 16.15, "timestamp": "00:00:16", "text": "就像"}, {"type": "subtitle", "time": 20.47, "timestamp": "00:00:20", "text": "因为我不小心做了类似的事情"}, {"type": "subtitle", "time": 24.87, "timestamp": "00:00:24", "text": "它叫什么？昨天直播过。"}, {"type": "subtitle", "time": 27.349, "timestamp": "00:00:27", "text": "呃，我昨天的Twitch直播变成了7"}, {"type": "subtitle", "time": 31.189, "timestamp": "00:00:31", "text": "小时。所以，我凌晨五点才睡。"}, {"type": "subtitle", "time": 33.43, "timestamp": "00:00:33", "text": "是的，"}, {"type": "subtitle", "time": 35.91, "timestamp": "00:00:35", "text": "我爱"}, {"type": "subtitle", "time": 41.43, "timestamp": "00:00:41", "text": "哦，等等。如果我凌晨5点睡觉，5 6 7"}, {"type": "subtitle", "time": 46.389, "timestamp": "00:00:46", "text": "等等，5到6、7、8、9、10，5个小时的睡眠。"}, {"type": "subtitle", "time": 50.31, "timestamp": "00:00:50", "text": "这还不够。我的天啊。"}, {"type": "subtitle", "time": 52.79, "timestamp": "00:00:52", "text": "是的，有些……呃，我还没……"}, {"type": "subtitle", "time": 55.27, "timestamp": "00:00:55", "text": "早餐。我刚睡醒。我当时"}, {"type": "subtitle", "time": 57.67, "timestamp": "00:00:57", "text": "应该是延迟直播"}, {"type": "subtitle", "time": 59.75, "timestamp": "00:00:59", "text": "持续1小时。"}]
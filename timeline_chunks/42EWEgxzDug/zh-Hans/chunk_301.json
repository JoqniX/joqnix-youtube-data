[{"type": "subtitle", "time": 18080.23, "timestamp": "05:01:20", "text": "是的。是的。我需要转移一切"}, {"type": "subtitle", "time": 18087.84, "timestamp": "05:01:27", "text": "呃"}, {"type": "subtitle", "time": 18106.55, "timestamp": "05:01:46", "text": "我需要弄到这两面墙，"}, {"type": "subtitle", "time": 18109.03, "timestamp": "05:01:49", "text": "这两个人是独一无二的。我需要"}, {"type": "subtitle", "time": 18111.35, "timestamp": "05:01:51", "text": "把这两个人弄出去"}, {"type": "subtitle", "time": 18116.23, "timestamp": "05:01:56", "text": "把它们放在右边。"}]
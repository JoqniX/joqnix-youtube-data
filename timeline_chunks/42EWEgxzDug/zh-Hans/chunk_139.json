[{"type": "subtitle", "time": 8360.389, "timestamp": "02:19:20", "text": "问题是，现在我觉得，既然我是"}, {"type": "subtitle", "time": 8363.91, "timestamp": "02:19:23", "text": "每天都有直播。"}, {"type": "subtitle", "time": 8368.629, "timestamp": "02:19:28", "text": "来的人不多。"}, {"type": "subtitle", "time": 8372.389, "timestamp": "02:19:32", "text": "或者我认为它正在产生影响"}, {"type": "subtitle", "time": 8376.23, "timestamp": "02:19:36", "text": "整个频道有点儿。"}, {"type": "subtitle", "time": 8378.549, "timestamp": "02:19:38", "text": "我当时有很多关于……的想法"}, {"type": "subtitle", "time": 8381.27, "timestamp": "02:19:41", "text": "这。"}, {"type": "subtitle", "time": 8384.309, "timestamp": "02:19:44", "text": "我确实有点想恢复正常生活。"}, {"type": "subtitle", "time": 8387.19, "timestamp": "02:19:47", "text": "直播等等。"}, {"type": "subtitle", "time": 8389.59, "timestamp": "02:19:49", "text": "你知道，很多事情"}, {"type": "subtitle", "time": 8392.55, "timestamp": "02:19:52", "text": "仅两到四小时的直播类型"}, {"type": "subtitle", "time": 8395.429, "timestamp": "02:19:55", "text": "停止做退伍军人事务部的工作"}, {"type": "subtitle", "time": 8397.91, "timestamp": "02:19:57", "text": "东西。"}]
[{"type": "subtitle", "time": 11462.95, "timestamp": "03:11:02", "text": "我想我曾经有过一个奇怪的忏悔外壳"}, {"type": "subtitle", "time": 11465.59, "timestamp": "03:11:05", "text": "呃，我甚至都没跟他们合作过。"}, {"type": "subtitle", "time": 11468.469, "timestamp": "03:11:08", "text": "我圈子以外的人，一切"}, {"type": "subtitle", "time": 11470.469, "timestamp": "03:11:10", "text": "正确的"}, {"type": "subtitle", "time": 11473.51, "timestamp": "03:11:13", "text": "有很多东西，这里有一个清单。"}, {"type": "subtitle", "time": 11476.15, "timestamp": "03:11:16", "text": "我想打破这种想法，我想这样做。"}, {"type": "subtitle", "time": 11478.469, "timestamp": "03:11:18", "text": "这次活动我会做很多独奏。"}, {"type": "subtitle", "time": 11481.429, "timestamp": "03:11:21", "text": "直播和很多合作"}, {"type": "subtitle", "time": 11484.87, "timestamp": "03:11:24", "text": "与我合作的人"}, {"type": "subtitle", "time": 11488.23, "timestamp": "03:11:28", "text": "我信任的人，我信任那些……"}, {"type": "subtitle", "time": 11490.55, "timestamp": "03:11:30", "text": "从一开始就陪伴在我身边的人"}, {"type": "subtitle", "time": 11493.91, "timestamp": "03:11:33", "text": "朋友们一直支持我，这很正常。"}, {"type": "subtitle", "time": 11496.95, "timestamp": "03:11:36", "text": "朋友、内容创作者、YouTube 用户"}, {"type": "subtitle", "time": 11499.75, "timestamp": "03:11:39", "text": "每个人。我会把所有人都带来。"}, {"type": "subtitle", "time": 11501.91, "timestamp": "03:11:41", "text": "所以，更像是……是的，不是这样的"}, {"type": "subtitle", "time": 11504.07, "timestamp": "03:11:44", "text": "再见。不用担心。听起来可能"}, {"type": "subtitle", "time": 11506.79, "timestamp": "03:11:46", "text": "我这是在夸张。这听起来可能很像"}, {"type": "subtitle", "time": 11510.95, "timestamp": "03:11:50", "text": "像是告别，但又不是。从某种意义上说，我想要"}, {"type": "subtitle", "time": 11513.429, "timestamp": "03:11:53", "text": "这样做是为了感谢所有人"}, {"type": "subtitle", "time": 11516.23, "timestamp": "03:11:56", "text": "很高兴能和你一起玩，"}]
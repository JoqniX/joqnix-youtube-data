[{"type": "subtitle", "time": 3273.829, "timestamp": "00:54:33", "text": "就是太阳系。好的，明白了。"}, {"type": "subtitle", "time": 3281.43, "timestamp": "00:54:41", "text": "我来踢它？"}, {"type": "subtitle", "time": 3283.589, "timestamp": "00:54:43", "text": "如果你想的话，你可以把它留下，否则我会……"}, {"type": "subtitle", "time": 3289.91, "timestamp": "00:54:49", "text": "脸着地。哦好的。知道了。知道了。"}]
[{"type": "subtitle", "time": 7862.79, "timestamp": "02:11:02", "text": "后退。她正在举办她的演唱会。"}, {"type": "subtitle", "time": 7866.069, "timestamp": "02:11:06", "text": "包括所有东西。我看到了"}, {"type": "subtitle", "time": 7870.069, "timestamp": "02:11:10", "text": "还有视频留言功能。"}, {"type": "subtitle", "time": 7873.83, "timestamp": "02:11:13", "text": "那真是太好了。"}, {"type": "subtitle", "time": 7875.99, "timestamp": "02:11:15", "text": "嗯，"}, {"type": "subtitle", "time": 7879.51, "timestamp": "02:11:19", "text": "问题是，我当时有点……感觉"}, {"type": "subtitle", "time": 7882.629, "timestamp": "02:11:22", "text": "灵感迸发。我也想为我做这件事"}, {"type": "subtitle", "time": 7887.51, "timestamp": "02:11:27", "text": "如果有人愿意的话，生日那天可以。"}, {"type": "subtitle", "time": 7890.629, "timestamp": "02:11:30", "text": "嗯……我不知道会不会有人会……"}, {"type": "subtitle", "time": 7894.069, "timestamp": "02:11:34", "text": "我愿意，而且我非常乐意。"}, {"type": "subtitle", "time": 7896.47, "timestamp": "02:11:36", "text": "这样做就像展示视频信息一样。"}, {"type": "subtitle", "time": 7899.35, "timestamp": "02:11:39", "text": "来自所有人"}, {"type": "subtitle", "time": 7903.03, "timestamp": "02:11:43", "text": "所有 YouTuber 和所有"}, {"type": "subtitle", "time": 7906.79, "timestamp": "02:11:46", "text": "我珍视并亲近的人"}, {"type": "subtitle", "time": 7915.51, "timestamp": "02:11:55", "text": "但这难道不应该是我们的孩子吗？"}]
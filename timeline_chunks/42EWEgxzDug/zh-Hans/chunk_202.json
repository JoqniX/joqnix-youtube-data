[{"type": "subtitle", "time": 12120.55, "timestamp": "03:22:00", "text": "我看到的那个东西，我以前把它看作是一个"}, {"type": "subtitle", "time": 12125.19, "timestamp": "03:22:05", "text": "婚礼就像一件大事"}, {"type": "subtitle", "time": 12128.87, "timestamp": "03:22:08", "text": "因为呃，我在想，你会怎么做？"}, {"type": "subtitle", "time": 12130.71, "timestamp": "03:22:10", "text": "婚礼？你倾尽所有，"}, {"type": "subtitle", "time": 12133.51, "timestamp": "03:22:13", "text": "正确的？你要把它办得尽可能盛大。"}, {"type": "subtitle", "time": 12137.51, "timestamp": "03:22:17", "text": "正确的？但实际上，这没什么问题。作为一名"}, {"type": "subtitle", "time": 12140.07, "timestamp": "03:22:20", "text": "作为一名小型创作者，我不需要制作它。"}, {"type": "subtitle", "time": 12143.67, "timestamp": "03:22:23", "text": "华丽的、太贵的或太"}, {"type": "subtitle", "time": 12146.63, "timestamp": "03:22:26", "text": "超载。不，"}, {"type": "subtitle", "time": 12149.349, "timestamp": "03:22:29", "text": "出道只是一件大事。"}, {"type": "subtitle", "time": 12153.03, "timestamp": "03:22:33", "text": "出道不过是人生中的一件大事而已。"}, {"type": "subtitle", "time": 12155.75, "timestamp": "03:22:35", "text": "在你的旅程中，那个时刻意义非凡"}, {"type": "subtitle", "time": 12158.15, "timestamp": "03:22:38", "text": "对，是我首发的。我在这里。我是"}, {"type": "subtitle", "time": 12161.429, "timestamp": "03:22:41", "text": "活着的那种东西"}, {"type": "subtitle", "time": 12163.11, "timestamp": "03:22:43", "text": "就像你在向……介绍自己"}, {"type": "subtitle", "time": 12165.349, "timestamp": "03:22:45", "text": "让全世界都知道你是谁"}, {"type": "subtitle", "time": 12168.79, "timestamp": "03:22:48", "text": "你的一切以及一切"}, {"type": "subtitle", "time": 12170.309, "timestamp": "03:22:50", "text": "正确的"}, {"type": "subtitle", "time": 12174.229, "timestamp": "03:22:54", "text": "所以，嗯……"}, {"type": "subtitle", "time": 12177.429, "timestamp": "03:22:57", "text": "我让你来告诉我该怎么做。"}]
[{"type": "subtitle", "time": 18002.47, "timestamp": "05:00:02", "text": "我把这孩子带过来。不，"}, {"type": "subtitle", "time": 18006.708, "timestamp": "05:00:06", "text": "等待。坚持，稍等。正确的。所以，我带来了这个"}, {"type": "subtitle", "time": 18009.83, "timestamp": "05:00:09", "text": "这边那家伙"}, {"type": "subtitle", "time": 18014.868, "timestamp": "05:00:14", "text": "把他带过来。"}, {"type": "subtitle", "time": 18026.868, "timestamp": "05:00:26", "text": "不，那样行不通。"}, {"type": "subtitle", "time": 18037.91, "timestamp": "05:00:37", "text": "我卡在心脏位置了。我的天啊。"}, {"type": "subtitle", "time": 18052.868, "timestamp": "05:00:52", "text": "但我绝对做不到。"}]
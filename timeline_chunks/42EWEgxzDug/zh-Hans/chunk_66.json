[{"type": "subtitle", "time": 3962.63, "timestamp": "01:06:02", "text": "等等，5到6、7、8、9、10，5个小时的睡眠。"}, {"type": "subtitle", "time": 3966.549, "timestamp": "01:06:06", "text": "这还不够。我的天啊。"}, {"type": "subtitle", "time": 3969.829, "timestamp": "01:06:09", "text": "是的，我还没吃早饭。我"}, {"type": "subtitle", "time": 3973.029, "timestamp": "01:06:13", "text": "刚醒。我本来应该是……"}, {"type": "subtitle", "time": 3975.99, "timestamp": "01:06:15", "text": "直播延迟1小时。"}, {"type": "subtitle", "time": 3979.99, "timestamp": "01:06:19", "text": "我还置顶了这条消息。"}, {"type": "subtitle", "time": 3982.63, "timestamp": "01:06:22", "text": "呃，但我当时想，算了，没关系。患病的"}, {"type": "subtitle", "time": 3985.75, "timestamp": "01:06:25", "text": "我只想和你一起吃早餐。"}, {"type": "subtitle", "time": 3988.23, "timestamp": "01:06:28", "text": "伙计们。"}, {"type": "subtitle", "time": 3992.15, "timestamp": "01:06:32", "text": "所以没问题。所以呢"}, {"type": "subtitle", "time": 3997.349, "timestamp": "01:06:37", "text": "我做到了。"}, {"type": "subtitle", "time": 3999.349, "timestamp": "01:06:39", "text": "所以今天我们要玩Apex英雄。"}, {"type": "subtitle", "time": 4002.549, "timestamp": "01:06:42", "text": "传奇人物。呃，显然那是新的呃"}, {"type": "subtitle", "time": 4008.23, "timestamp": "01:06:48", "text": "万圣节……呃……噩梦。呃"}, {"type": "subtitle", "time": 4011.91, "timestamp": "01:06:51", "text": "正在发生，嗯，Apex"}, {"type": "subtitle", "time": 4015.589, "timestamp": "01:06:55", "text": "而且，嗯，还有一种叫dopel的东西"}, {"type": "subtitle", "time": 4018.71, "timestamp": "01:06:58", "text": "恒河活动，即至尊皮肤"}]
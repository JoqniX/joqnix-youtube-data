[{"type": "subtitle", "time": 12364.389, "timestamp": "03:26:04", "text": "还有其他事，不过六月份我要考试。"}, {"type": "subtitle", "time": 12366.55, "timestamp": "03:26:06", "text": "这意味着在我做这件事的时候"}, {"type": "subtitle", "time": 12368.95, "timestamp": "03:26:08", "text": "Joathon 的流最多只有两个"}, {"type": "subtitle", "time": 12374.71, "timestamp": "03:26:14", "text": "我想，应该是每天都这样吧。是的。结束了"}, {"type": "subtitle", "time": 12377.59, "timestamp": "03:26:17", "text": "六月最后一周是我需要的时间"}, {"type": "subtitle", "time": 12379.349, "timestamp": "03:26:19", "text": "收拾好一切，然后说我的最后遗言。"}, {"type": "subtitle", "time": 12381.75, "timestamp": "03:26:21", "text": "再见。我们将进行最后的冲刺。"}, {"type": "subtitle", "time": 12385.19, "timestamp": "03:26:25", "text": "直播，Joathon的最后一周。出色地"}, {"type": "subtitle", "time": 12388.15, "timestamp": "03:26:28", "text": "最后冲刺阶段，也就是第四阶段，"}, {"type": "subtitle", "time": 12391.03, "timestamp": "03:26:31", "text": "我称之为。呃"}, {"type": "subtitle", "time": 12394.229, "timestamp": "03:26:34", "text": "我们将在这里和一切告别，"}, {"type": "subtitle", "time": 12398.71, "timestamp": "03:26:38", "text": "我的电脑，对我的朋友们来说，就是一切。"}, {"type": "subtitle", "time": 12401.11, "timestamp": "03:26:41", "text": "我们将开设一个专门的直播流。"}, {"type": "subtitle", "time": 12403.91, "timestamp": "03:26:43", "text": "约顿的最后一天。"}, {"type": "subtitle", "time": 12405.75, "timestamp": "03:26:45", "text": "是的。"}, {"type": "subtitle", "time": 12409.19, "timestamp": "03:26:49", "text": "所以，之后在日本，可能……"}, {"type": "subtitle", "time": 12410.87, "timestamp": "03:26:50", "text": "七月，"}, {"type": "subtitle", "time": 12414.95, "timestamp": "03:26:54", "text": "七月中下旬，或者周中，我会……"}, {"type": "subtitle", "time": 12417.429, "timestamp": "03:26:57", "text": "一旦我能够恢复直播，我就"}]
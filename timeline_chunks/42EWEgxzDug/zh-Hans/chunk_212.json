[{"type": "subtitle", "time": 12721.99, "timestamp": "03:32:01", "text": "完全不花钱。你可以看着，你可以"}, {"type": "subtitle", "time": 12723.91, "timestamp": "03:32:03", "text": "有很多方法可以支持……"}, {"type": "subtitle", "time": 12726.63, "timestamp": "03:32:06", "text": "免费成为主播或 YouTuber。你可以"}, {"type": "subtitle", "time": 12730.309, "timestamp": "03:32:10", "text": "照做。没关系。完全没问题。但"}, {"type": "subtitle", "time": 12732.389, "timestamp": "03:32:12", "text": "仅仅仅"}, {"type": "subtitle", "time": 12737.03, "timestamp": "03:32:17", "text": "引擎盖或额外支持我。"}, {"type": "subtitle", "time": 12739.91, "timestamp": "03:32:19", "text": "只有当你有足够的钱时"}, {"type": "subtitle", "time": 12741.75, "timestamp": "03:32:21", "text": "如果只有一点点，就自己解决吧"}, {"type": "subtitle", "time": 12744.95, "timestamp": "03:32:24", "text": "额外的。好的。是的，金额没有变化。"}, {"type": "subtitle", "time": 12747.83, "timestamp": "03:32:27", "text": "事情。不要去太久。好的。在"}, {"type": "subtitle", "time": 12750.55, "timestamp": "03:32:30", "text": "至少一卢比，我就很满意了。"}, {"type": "subtitle", "time": 12754.229, "timestamp": "03:32:34", "text": "卢比，或者别担心，或者1美元，或者少于"}, {"type": "subtitle", "time": 12758.07, "timestamp": "03:32:38", "text": "几分钱或者任何东西。无论什么平台"}, {"type": "subtitle", "time": 12761.19, "timestamp": "03:32:41", "text": "允许你捐出最低金额，就这么做。"}, {"type": "subtitle", "time": 12762.87, "timestamp": "03:32:42", "text": "没关系。我不问，我不想问。"}, {"type": "subtitle", "time": 12765.269, "timestamp": "03:32:45", "text": "请任何人捐赠一大笔钱"}, {"type": "subtitle", "time": 12768.229, "timestamp": "03:32:48", "text": "全部。不，不，不，不。但要用它来"}, {"type": "subtitle", "time": 12772.15, "timestamp": "03:32:52", "text": "你自己。我和你的车。你好。"}, {"type": "subtitle", "time": 12776.15, "timestamp": "03:32:56", "text": "是的。即使我们无法超越"}, {"type": "subtitle", "time": 12777.59, "timestamp": "03:32:57", "text": "目标没问题。我会想办法的。"}]
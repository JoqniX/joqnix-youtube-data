[{"type": "subtitle", "time": 23712.23, "timestamp": "06:35:12", "text": "Lara俱乐部。不，这是一款游戏。"}, {"type": "subtitle", "time": 23723.91, "timestamp": "06:35:23", "text": "我认为他会获释，因为……"}, {"type": "subtitle", "time": 23727.11, "timestamp": "06:35:27", "text": "大门关上了，门也关上了。"}, {"type": "subtitle", "time": 23736.39, "timestamp": "06:35:36", "text": "所以我们再次这样做是因为……"}, {"type": "subtitle", "time": 23738.628, "timestamp": "06:35:38", "text": "我们的游戏崩溃了，我们输了"}, {"type": "subtitle", "time": 23740.548, "timestamp": "06:35:40", "text": "保存。"}, {"type": "subtitle", "time": 23742.628, "timestamp": "06:35:42", "text": "我们不得不这样做，真是太痛苦了。"}, {"type": "subtitle", "time": 23745.83, "timestamp": "06:35:45", "text": "这种情况反复发生。"}, {"type": "subtitle", "time": 23748.468, "timestamp": "06:35:48", "text": "所以，是的，我觉得我需要买那个。"}, {"type": "subtitle", "time": 23755.91, "timestamp": "06:35:55", "text": "这边。"}]
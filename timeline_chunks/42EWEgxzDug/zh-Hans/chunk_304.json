[{"type": "subtitle", "time": 18250.628, "timestamp": "05:04:10", "text": "好的，我设法放进去了"}, {"type": "subtitle", "time": 18253.91, "timestamp": "05:04:13", "text": "打出两个球。"}, {"type": "subtitle", "time": 18262.15, "timestamp": "05:04:22", "text": "我的一部分想法是，我应该把这个写下来。"}, {"type": "subtitle", "time": 18265.91, "timestamp": "05:04:25", "text": "双一，这个双球到这个"}, {"type": "subtitle", "time": 18270.15, "timestamp": "05:04:30", "text": "把这些单独的个体放到一边，然后把它们取出来。"}, {"type": "subtitle", "time": 18295.35, "timestamp": "05:04:55", "text": "但是，我又该如何呢？"}]
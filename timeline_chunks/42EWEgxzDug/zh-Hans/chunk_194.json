[{"type": "subtitle", "time": 11641.75, "timestamp": "03:14:01", "text": "让我们把它变成一项合作工作。"}, {"type": "subtitle", "time": 11645.19, "timestamp": "03:14:05", "text": "一起。这不仅仅是我一个人的努力。"}, {"type": "subtitle", "time": 11647.75, "timestamp": "03:14:07", "text": "我希望大家都能这样做。"}, {"type": "subtitle", "time": 11650.71, "timestamp": "03:14:10", "text": "把它们放在一起。好的，这就是我想要的"}, {"type": "subtitle", "time": 11652.79, "timestamp": "03:14:12", "text": "也就是说。"}, {"type": "subtitle", "time": 11656.309, "timestamp": "03:14:16", "text": "是的，我会尽我所能。我将"}, {"type": "subtitle", "time": 11660.87, "timestamp": "03:14:20", "text": "向你们证明我能做到最好。"}, {"type": "subtitle", "time": 11664.15, "timestamp": "03:14:24", "text": "所以，请保佑我，也请保佑我。"}, {"type": "subtitle", "time": 11666.63, "timestamp": "03:14:26", "text": "旅行。"}, {"type": "subtitle", "time": 11671.51, "timestamp": "03:14:31", "text": "是的，但愿一切顺利。"}, {"type": "subtitle", "time": 11675.03, "timestamp": "03:14:35", "text": "呃，奇迹发生了。我将能够"}, {"type": "subtitle", "time": 11678.87, "timestamp": "03:14:38", "text": "将能够拥有足够的"}, {"type": "subtitle", "time": 11682.71, "timestamp": "03:14:42", "text": "实际上呃"}, {"type": "subtitle", "time": 11684.309, "timestamp": "03:14:44", "text": "放"}, {"type": "subtitle", "time": 11686.95, "timestamp": "03:14:46", "text": "把我一直在研究的新运动员拿出来"}, {"type": "subtitle", "time": 11692.15, "timestamp": "03:14:52", "text": "已经持续一年了。是的。"}, {"type": "subtitle", "time": 11695.19, "timestamp": "03:14:55", "text": "是的，这是一次不错的体验。新的"}, {"type": "subtitle", "time": 11696.71, "timestamp": "03:14:56", "text": "经验。"}, {"type": "subtitle", "time": 11699.429, "timestamp": "03:14:59", "text": "是的。和"}]
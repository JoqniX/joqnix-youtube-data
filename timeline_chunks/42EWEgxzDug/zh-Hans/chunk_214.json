[{"type": "subtitle", "time": 12840.389, "timestamp": "03:34:00", "text": "再过两分钟或三分钟。"}, {"type": "subtitle", "time": 12842.389, "timestamp": "03:34:02", "text": "你好。"}, {"type": "subtitle", "time": 12844.95, "timestamp": "03:34:04", "text": "简单来说，我正在参加 Joathon 挑战赛。"}, {"type": "subtitle", "time": 12848.55, "timestamp": "03:34:08", "text": "只是为了资助Vub的首次亮相和模型"}, {"type": "subtitle", "time": 12852.07, "timestamp": "03:34:12", "text": "无论我们能赚到多少钱"}, {"type": "subtitle", "time": 12855.429, "timestamp": "03:34:15", "text": "要实现这个目标，或者至少要达到这样的目标："}, {"type": "subtitle", "time": 12858.63, "timestamp": "03:34:18", "text": "呃，至于索具，是960。"}, {"type": "subtitle", "time": 12860.71, "timestamp": "03:34:20", "text": "呃，用于索具。"}, {"type": "subtitle", "time": 12862.63, "timestamp": "03:34:22", "text": "嗯，"}, {"type": "subtitle", "time": 12864.71, "timestamp": "03:34:24", "text": "如果我得到这个，我就可以开始我的"}, {"type": "subtitle", "time": 12869.11, "timestamp": "03:34:29", "text": "索具和佣金"}, {"type": "subtitle", "time": 12871.03, "timestamp": "03:34:31", "text": "是的，剩下的钱会……"}, {"type": "subtitle", "time": 12874.15, "timestamp": "03:34:34", "text": "出道作品。呃，我得做一件事"}, {"type": "subtitle", "time": 12876.07, "timestamp": "03:34:36", "text": "乐队重组，对吧？我不能和……一起去"}, {"type": "subtitle", "time": 12879.83, "timestamp": "03:34:39", "text": "可惜现在体育迷的东西都是这样，因为……"}, {"type": "subtitle", "time": 12881.99, "timestamp": "03:34:41", "text": "高端型号。好的，这是高端产品。"}, {"type": "subtitle", "time": 12884.469, "timestamp": "03:34:44", "text": "更高等级。我必须保持专业精神。"}, {"type": "subtitle", "time": 12887.91, "timestamp": "03:34:47", "text": "这样我才能做到，才能尽我所能"}, {"type": "subtitle", "time": 12891.67, "timestamp": "03:34:51", "text": "作为一名专业创作者。"}, {"type": "subtitle", "time": 12895.59, "timestamp": "03:34:55", "text": "我必须让我的眼睛达到那种姿势。"}, {"type": "subtitle", "time": 12898.309, "timestamp": "03:34:58", "text": "所以，嗯，让我们尽力而为吧。好的，我"}]
[{"type": "subtitle", "time": 4080.87, "timestamp": "01:08:00", "text": "也要开始吃东西了。"}, {"type": "subtitle", "time": 4087.349, "timestamp": "01:08:07", "text": "所以我穿的跟我之前穿的差不多。"}, {"type": "subtitle", "time": 4090.87, "timestamp": "01:08:10", "text": "我的使命召唤莫奈3直播就像"}, {"type": "subtitle", "time": 4093.75, "timestamp": "01:08:13", "text": "把那东西放进去。"}, {"type": "subtitle", "time": 4098.229, "timestamp": "01:08:18", "text": "所以我认为应该是周二或周三。"}, {"type": "subtitle", "time": 4100.789, "timestamp": "01:08:20", "text": "对，其实是星期三。我不能"}, {"type": "subtitle", "time": 4109.03, "timestamp": "01:08:29", "text": "哦，好像我是在抱怨似的，但是……"}, {"type": "subtitle", "time": 4110.87, "timestamp": "01:08:30", "text": "很好。"}, {"type": "subtitle", "time": 4112.87, "timestamp": "01:08:32", "text": "我的意思就是这样。"}, {"type": "subtitle", "time": 4131.51, "timestamp": "01:08:51", "text": "我们走吧。你们能听到声音吗？"}, {"type": "subtitle", "time": 4134.309, "timestamp": "01:08:54", "text": "我希望你能做到。"}]
[{"type": "subtitle", "time": 5045.91, "timestamp": "01:24:05", "text": "[音乐]"}, {"type": "subtitle", "time": 5058.79, "timestamp": "01:24:18", "text": "这两个人在露营。好的。他们是"}, {"type": "subtitle", "time": 5066.709, "timestamp": "01:24:26", "text": "你是如何看待敌人的？哦"}, {"type": "subtitle", "time": 5069.669, "timestamp": "01:24:29", "text": "我的上帝。"}, {"type": "subtitle", "time": 5072.31, "timestamp": "01:24:32", "text": "他们有一个……这个人视力很好"}, {"type": "subtitle", "time": 5098.79, "timestamp": "01:24:58", "text": "是的。但是，如果我像不说话一样，那就糟了。"}]
[{"type": "subtitle", "time": 7442.709, "timestamp": "02:04:02", "text": "我用来连接手机的耳机"}, {"type": "subtitle", "time": 7450.709, "timestamp": "02:04:10", "text": "嗯"}, {"type": "subtitle", "time": 7455.35, "timestamp": "02:04:15", "text": "耳朵上的那种东西……"}, {"type": "subtitle", "time": 7459.99, "timestamp": "02:04:19", "text": "不再充电了，我不知道为什么。"}, {"type": "subtitle", "time": 7462.709, "timestamp": "02:04:22", "text": "真糟糕"}, {"type": "subtitle", "time": 7465.189, "timestamp": "02:04:25", "text": "其中一只耳机无法充电，而且"}, {"type": "subtitle", "time": 7468.07, "timestamp": "02:04:28", "text": "真糟糕。"}, {"type": "subtitle", "time": 7469.75, "timestamp": "02:04:29", "text": "和"}, {"type": "subtitle", "time": 7472.229, "timestamp": "02:04:32", "text": "我用的是别人找我借给我的那双鞋。"}, {"type": "subtitle", "time": 7476.31, "timestamp": "02:04:36", "text": "适用于日本。"}, {"type": "subtitle", "time": 7487.51, "timestamp": "02:04:47", "text": "是的。所以……"}, {"type": "subtitle", "time": 7491.35, "timestamp": "02:04:51", "text": "我的考试快要结束了"}]
[{"type": "subtitle", "time": 8281.429, "timestamp": "02:18:01", "text": "我想确保我不会把它弄丢。"}, {"type": "subtitle", "time": 8283.429, "timestamp": "02:18:03", "text": "耳机"}, {"type": "subtitle", "time": 8301.27, "timestamp": "02:18:21", "text": "好的，另一个正在充电。我放"}, {"type": "subtitle", "time": 8310.469, "timestamp": "02:18:30", "text": "为什么我妈妈总是给我打未接来电？"}, {"type": "subtitle", "time": 8316.95, "timestamp": "02:18:36", "text": "我其实不想接电话。"}, {"type": "subtitle", "time": 8320.15, "timestamp": "02:18:40", "text": "因为在床上翻来覆去。"}]
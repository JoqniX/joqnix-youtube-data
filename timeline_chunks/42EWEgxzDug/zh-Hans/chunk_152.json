[{"type": "subtitle", "time": 9120.55, "timestamp": "02:32:00", "text": "尚未发布"}, {"type": "subtitle", "time": 9127.75, "timestamp": "02:32:07", "text": "所以，"}, {"type": "subtitle", "time": 9130.309, "timestamp": "02:32:10", "text": "我会把它做得像个真正的诱人甜点。"}, {"type": "subtitle", "time": 9133.59, "timestamp": "02:32:13", "text": "桌子之类的东西。"}, {"type": "subtitle", "time": 9149.59, "timestamp": "02:32:29", "text": "我正在做某件事。我的天啊。患病的"}, {"type": "subtitle", "time": 9168.15, "timestamp": "02:32:48", "text": "呃，稍等一下。我觉得我应该带"}, {"type": "subtitle", "time": 9171.27, "timestamp": "02:32:51", "text": "打电话问问发生了什么事。我不想"}, {"type": "subtitle", "time": 9175.59, "timestamp": "02:32:55", "text": "他们继续这样给我打电话。"}, {"type": "subtitle", "time": 9177.91, "timestamp": "02:32:57", "text": "所以，我就……"}]
[{"type": "subtitle", "time": 11941.99, "timestamp": "03:19:01", "text": "事件。"}, {"type": "subtitle", "time": 11945.349, "timestamp": "03:19:05", "text": "所以，嗯，现在你什么都知道了。我"}, {"type": "subtitle", "time": 11949.91, "timestamp": "03:19:09", "text": "猜猜我一直想做什么"}, {"type": "subtitle", "time": 11958.229, "timestamp": "03:19:18", "text": "是的，活动将于……开始。"}, {"type": "subtitle", "time": 11961.269, "timestamp": "03:19:21", "text": "3月12日。"}, {"type": "subtitle", "time": 11968.87, "timestamp": "03:19:28", "text": "第一波。"}, {"type": "subtitle", "time": 11972.15, "timestamp": "03:19:32", "text": "是的，嗯，是的，我会做出承诺"}, {"type": "subtitle", "time": 11974.469, "timestamp": "03:19:34", "text": "这里正在直播，因为它是"}, {"type": "subtitle", "time": 11977.83, "timestamp": "03:19:37", "text": "公告流"}, {"type": "subtitle", "time": 11979.67, "timestamp": "03:19:39", "text": "大概"}, {"type": "subtitle", "time": 11982.55, "timestamp": "03:19:42", "text": "如果奇迹发生"}, {"type": "subtitle", "time": 11985.269, "timestamp": "03:19:45", "text": "不管我用什么药，我都会留着它。"}, {"type": "subtitle", "time": 11987.59, "timestamp": "03:19:47", "text": "存到我的银行账户里了，好的，我不会"}, {"type": "subtitle", "time": 11989.59, "timestamp": "03:19:49", "text": "用它"}, {"type": "subtitle", "time": 11994.229, "timestamp": "03:19:54", "text": "直到达到所需的最低数量为止。"}, {"type": "subtitle", "time": 11997.67, "timestamp": "03:19:57", "text": "我想我需要960美元来购置索具，是的。"}]
[{"type": "subtitle", "time": 13920.309, "timestamp": "03:52:00", "text": "一旦用户名用户名句柄"}, {"type": "subtitle", "time": 13923.269, "timestamp": "03:52:03", "text": "我希望它能在YouTube上发布。"}, {"type": "subtitle", "time": 13926.389, "timestamp": "03:52:06", "text": "改变，嗯，你好，不太友好，欢迎"}, {"type": "subtitle", "time": 13932.87, "timestamp": "03:52:12", "text": "嗨，所以，在我开始讲这个之前，我想说……"}, {"type": "subtitle", "time": 13936.15, "timestamp": "03:52:16", "text": "好的。呃，我们正在进行为期两周的……"}, {"type": "subtitle", "time": 13940.309, "timestamp": "03:52:20", "text": "恐怖游戏之类的。什么把手之类的东西？"}, {"type": "subtitle", "time": 13942.309, "timestamp": "03:52:22", "text": "如果你之前不知道的话，YouTube"}, {"type": "subtitle", "time": 13944.63, "timestamp": "03:52:24", "text": "将会发布这项新功能"}, {"type": "subtitle", "time": 13947.269, "timestamp": "03:52:27", "text": "就像Instagram一样，呃，Instagram，"}, {"type": "subtitle", "time": 13949.11, "timestamp": "03:52:29", "text": "Facebook 和其他所有社交媒体"}, {"type": "subtitle", "time": 13952.95, "timestamp": "03:52:32", "text": "平台具有类似符号的标志，并且"}, {"type": "subtitle", "time": 13955.83, "timestamp": "03:52:35", "text": "您的用户名。所以，与其显示"}, {"type": "subtitle", "time": 13959.91, "timestamp": "03:52:39", "text": "名称和您的自定义 YouTube 网址，"}, {"type": "subtitle", "time": 13962.07, "timestamp": "03:52:42", "text": "它们都会在那里。但仍然是"}, {"type": "subtitle", "time": 13964.389, "timestamp": "03:52:44", "text": "YouTube 将主要优先考虑"}, {"type": "subtitle", "time": 13966.87, "timestamp": "03:52:46", "text": "从现在开始，账号名称将与 Twitter 类似。"}, {"type": "subtitle", "time": 13970.07, "timestamp": "03:52:50", "text": "还有Instagram。是的，YouTube将会是"}, {"type": "subtitle", "time": 13973.51, "timestamp": "03:52:53", "text": "这样做。呃呃，这将是被迫的。"}, {"type": "subtitle", "time": 13976.309, "timestamp": "03:52:56", "text": "并且有现货。他们会翻转"}, {"type": "subtitle", "time": 13979.189, "timestamp": "03:52:59", "text": "像强制开关一样的开关"}]
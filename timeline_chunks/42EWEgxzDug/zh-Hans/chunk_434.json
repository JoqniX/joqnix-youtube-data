[{"type": "subtitle", "time": 26048.708, "timestamp": "07:14:08", "text": "[音乐]"}, {"type": "subtitle", "time": 26057.43, "timestamp": "07:14:17", "text": "好的，回头见。乔，这是"}, {"type": "subtitle", "time": 26058.708, "timestamp": "07:14:18", "text": "顺便说一句，这条溪流很棒。我会确保"}, {"type": "subtitle", "time": 26060.39, "timestamp": "07:14:20", "text": "下次再来。注意安全。"}, {"type": "subtitle", "time": 26062.628, "timestamp": "07:14:22", "text": "小心。你好。是啊，我也是。而且"}, {"type": "subtitle", "time": 26065.43, "timestamp": "07:14:25", "text": "欢迎，欢迎来到奥内克萨家族。"}, {"type": "subtitle", "time": 26067.83, "timestamp": "07:14:27", "text": "感谢你今天发现了我的存在。现在，"}, {"type": "subtitle", "time": 26069.67, "timestamp": "07:14:29", "text": "希望你以后有机会再来。"}, {"type": "subtitle", "time": 26072.708, "timestamp": "07:14:32", "text": "流。谢谢。在你离开之前，"}, {"type": "subtitle", "time": 26075.75, "timestamp": "07:14:35", "text": "为你铺就一条温暖、温暖、温暖的道路。祝你好运"}, {"type": "subtitle", "time": 26077.67, "timestamp": "07:14:37", "text": "剩下的时间就用来做其他事情吧。"}, {"type": "subtitle", "time": 26079.35, "timestamp": "07:14:39", "text": "嗯？因为对你来说已经是晚上了。"}, {"type": "subtitle", "time": 26081.67, "timestamp": "07:14:41", "text": "正确的？是的。"}, {"type": "subtitle", "time": 26084.23, "timestamp": "07:14:44", "text": "你好。来。"}, {"type": "subtitle", "time": 26087.43, "timestamp": "07:14:47", "text": "谁在激励你？我的"}, {"type": "subtitle", "time": 26089.99, "timestamp": "07:14:49", "text": "灵感来源。嗯？有很多"}, {"type": "subtitle", "time": 26093.51, "timestamp": "07:14:53", "text": "激励我的人。"}, {"type": "subtitle", "time": 26097.19, "timestamp": "07:14:57", "text": "是的。它属于不同的类型。不是"}]
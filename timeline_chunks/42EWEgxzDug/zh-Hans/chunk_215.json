[{"type": "subtitle", "time": 12900.71, "timestamp": "03:35:00", "text": "有很多计划。"}, {"type": "subtitle", "time": 12902.79, "timestamp": "03:35:02", "text": "我不会放弃我的梦想。我不是"}, {"type": "subtitle", "time": 12905.03, "timestamp": "03:35:05", "text": "愿意鼓胀。我性格固执。我是"}, {"type": "subtitle", "time": 12907.429, "timestamp": "03:35:07", "text": "自私。我真是个笨蛋。我知道。我不"}, {"type": "subtitle", "time": 12909.83, "timestamp": "03:35:09", "text": "我知道自己在做什么。我还年轻。我是"}, {"type": "subtitle", "time": 12911.75, "timestamp": "03:35:11", "text": "年纪大了。"}, {"type": "subtitle", "time": 12915.349, "timestamp": "03:35:15", "text": "我衰老得更快，但我却永葆青春。"}, {"type": "subtitle", "time": 12917.91, "timestamp": "03:35:17", "text": "安慰。我知道"}, {"type": "subtitle", "time": 12921.83, "timestamp": "03:35:21", "text": "我虽然幼稚，但我愿意看"}, {"type": "subtitle", "time": 12925.91, "timestamp": "03:35:25", "text": "这是真的。嗯，不管你喜欢还是"}, {"type": "subtitle", "time": 12934.87, "timestamp": "03:35:34", "text": "你好。所以，我希望……主要"}, {"type": "subtitle", "time": 12937.269, "timestamp": "03:35:37", "text": "现在信息已经明白了。是"}, {"type": "subtitle", "time": 12939.99, "timestamp": "03:35:39", "text": "参加 Joathon 活动。事件时间表如下："}, {"type": "subtitle", "time": 12944.95, "timestamp": "03:35:44", "text": "我认为是从3月12日到6月中旬。"}, {"type": "subtitle", "time": 12949.51, "timestamp": "03:35:49", "text": "20岁、16岁或者其他什么数字。嗯"}, {"type": "subtitle", "time": 12954.309, "timestamp": "03:35:54", "text": "安斯坦，不，我不是叔叔，我还是成年人。"}, {"type": "subtitle", "time": 12957.19, "timestamp": "03:35:57", "text": "我想我正处于我的"}, {"type": "subtitle", "time": 12959.429, "timestamp": "03:35:59", "text": "我在"}]
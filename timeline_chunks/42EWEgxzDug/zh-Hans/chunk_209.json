[{"type": "subtitle", "time": 12541.91, "timestamp": "03:29:01", "text": "是的。是的，呃，在运动马拉松期间"}, {"type": "subtitle", "time": 12544.71, "timestamp": "03:29:04", "text": "我将履行我的现实生活中的职责。"}, {"type": "subtitle", "time": 12547.03, "timestamp": "03:29:07", "text": "包括课程等等。出色地"}, {"type": "subtitle", "time": 12549.91, "timestamp": "03:29:09", "text": "有一个正在运行的 v。我们将停止计时器。"}, {"type": "subtitle", "time": 12552.63, "timestamp": "03:29:12", "text": "以及所有的一切。我没有，我没有"}, {"type": "subtitle", "time": 12554.55, "timestamp": "03:29:14", "text": "购买了该小部件。存在一个子单元"}, {"type": "subtitle", "time": 12558.63, "timestamp": "03:29:18", "text": "我想买个小玩意儿，但我当时想："}, {"type": "subtitle", "time": 12561.349, "timestamp": "03:29:21", "text": "难道我把钱省下来不是更好吗？"}, {"type": "subtitle", "time": 12565.349, "timestamp": "03:29:25", "text": "我可以做到，对吧？我知道我可以投资"}, {"type": "subtitle", "time": 12567.91, "timestamp": "03:29:27", "text": "流和喜欢放置得到适当的"}, {"type": "subtitle", "time": 12570.71, "timestamp": "03:29:30", "text": "本次子马拉松的小部件和其他东西"}, {"type": "subtitle", "time": 12573.51, "timestamp": "03:29:33", "text": "这乔森的东西，但是"}, {"type": "subtitle", "time": 12576.15, "timestamp": "03:29:36", "text": "是啊，真痛苦。"}, {"type": "subtitle", "time": 12579.91, "timestamp": "03:29:39", "text": "这就是我真正想要的巨型炸弹"}, {"type": "subtitle", "time": 12584.15, "timestamp": "03:29:44", "text": "呃，好像是Lani或者其他什么人，每个主播我"}, {"type": "subtitle", "time": 12586.71, "timestamp": "03:29:46", "text": "在 YouTube 和 Twitch 上都看到了，它们也用了它。"}, {"type": "subtitle", "time": 12589.75, "timestamp": "03:29:49", "text": "对于订阅者，我当时想的是，哦，我也是。"}, {"type": "subtitle", "time": 12592.15, "timestamp": "03:29:52", "text": "应该用它，但实际上我……"}, {"type": "subtitle", "time": 12595.269, "timestamp": "03:29:55", "text": "意识到了，是的，更大的渠道，我是"}, {"type": "subtitle", "time": 12597.75, "timestamp": "03:29:57", "text": "数字越大，我就越大。"}]
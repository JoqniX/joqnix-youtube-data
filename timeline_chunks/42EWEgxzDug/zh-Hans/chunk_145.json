[{"type": "subtitle", "time": 8701.19, "timestamp": "02:25:01", "text": "还没完。我得负责麦克风。我"}, {"type": "subtitle", "time": 8704.07, "timestamp": "02:25:04", "text": "需要把麦克风拿去充电。"}, {"type": "subtitle", "time": 8712.389, "timestamp": "02:25:12", "text": "嗯，"}, {"type": "subtitle", "time": 8721.19, "timestamp": "02:25:21", "text": "我内心深处渴望学习……"}, {"type": "subtitle", "time": 8725.19, "timestamp": "02:25:25", "text": "实际上，我是一名乐器演奏家，我意识到我是……"}, {"type": "subtitle", "time": 8730.55, "timestamp": "02:25:30", "text": "我要去日本，所以没法……"}, {"type": "subtitle", "time": 8734.15, "timestamp": "02:25:34", "text": "带上东西，好吗？"}, {"type": "subtitle", "time": 8736.309, "timestamp": "02:25:36", "text": "和"}, {"type": "subtitle", "time": 8740.71, "timestamp": "02:25:40", "text": "我们明年大概要去日本。"}, {"type": "subtitle", "time": 8743.51, "timestamp": "02:25:43", "text": "大概是四月份吧。"}, {"type": "subtitle", "time": 8745.349, "timestamp": "02:25:45", "text": "是的，大概四月底吧。"}, {"type": "subtitle", "time": 8750.07, "timestamp": "02:25:50", "text": "比如3月30日那段时间，我会在……"}, {"type": "subtitle", "time": 8752.63, "timestamp": "02:25:52", "text": "现在的航班已经起飞了"}, {"type": "subtitle", "time": 8754.309, "timestamp": "02:25:54", "text": "大概"}, {"type": "subtitle", "time": 8757.51, "timestamp": "02:25:57", "text": "可能是在印度以外的某个地方，然后"}]
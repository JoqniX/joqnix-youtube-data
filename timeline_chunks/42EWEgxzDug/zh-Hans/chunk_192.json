[{"type": "subtitle", "time": 11526.389, "timestamp": "03:12:06", "text": "是的，我就是想这么做，因为"}, {"type": "subtitle", "time": 11530.469, "timestamp": "03:12:10", "text": "大家都对我很好，"}, {"type": "subtitle", "time": 11534.23, "timestamp": "03:12:14", "text": "我想……嗯……多花点钱。"}, {"type": "subtitle", "time": 11537.349, "timestamp": "03:12:17", "text": "我想，大概是时间吧。我又开始了我的"}, {"type": "subtitle", "time": 11539.11, "timestamp": "03:12:19", "text": "我人生的新篇章即将开启"}, {"type": "subtitle", "time": 11540.71, "timestamp": "03:12:20", "text": "日本。"}, {"type": "subtitle", "time": 11543.59, "timestamp": "03:12:23", "text": "所以我会想念所有和我成为朋友的人。"}, {"type": "subtitle", "time": 11546.63, "timestamp": "03:12:26", "text": "以及来自同一时间的人"}, {"type": "subtitle", "time": 11548.95, "timestamp": "03:12:28", "text": "因为我来自印度，所以这里是区域。全部"}, {"type": "subtitle", "time": 11552.469, "timestamp": "03:12:32", "text": "我会想念我结交的印度朋友。"}, {"type": "subtitle", "time": 11554.55, "timestamp": "03:12:34", "text": "现在很多了。"}, {"type": "subtitle", "time": 11559.51, "timestamp": "03:12:39", "text": "所以我想这样做是为了……"}, {"type": "subtitle", "time": 11561.51, "timestamp": "03:12:41", "text": "多花时间陪伴他们，并且拥有"}, {"type": "subtitle", "time": 11564.95, "timestamp": "03:12:44", "text": "乐趣。对，这就是Joathon的意义所在。"}, {"type": "subtitle", "time": 11568.309, "timestamp": "03:12:48", "text": "对我来说，这是一件大事。"}, {"type": "subtitle", "time": 11570.309, "timestamp": "03:12:50", "text": "尽管我毫无准备。我没有"}, {"type": "subtitle", "time": 11573.269, "timestamp": "03:12:53", "text": "了解安息日募捐活动和捐赠募捐活动的运作方式，"}, {"type": "subtitle", "time": 11575.91, "timestamp": "03:12:55", "text": "一切。但我打算随机应变。"}, {"type": "subtitle", "time": 11579.11, "timestamp": "03:12:59", "text": "我打算什么时候做就什么时候做。"}]
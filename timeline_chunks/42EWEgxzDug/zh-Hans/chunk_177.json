[{"type": "subtitle", "time": 10637.429, "timestamp": "02:57:17", "text": "我喝了点东西。我得到了"}, {"type": "subtitle", "time": 10640.309, "timestamp": "02:57:20", "text": "吃点东西。买了两个包"}, {"type": "subtitle", "time": 10641.91, "timestamp": "02:57:21", "text": "牛奶。"}, {"type": "subtitle", "time": 10644.469, "timestamp": "02:57:24", "text": "是的，我一切都好。"}, {"type": "subtitle", "time": 10647.67, "timestamp": "02:57:27", "text": "我也拿到了药。"}, {"type": "subtitle", "time": 10651.349, "timestamp": "02:57:31", "text": "呃，一个是针对过敏的，一个是针对……"}, {"type": "subtitle", "time": 10655.51, "timestamp": "02:57:35", "text": "呃，一个给"}, {"type": "subtitle", "time": 10658.07, "timestamp": "02:57:38", "text": "它叫什么？"}, {"type": "subtitle", "time": 10660.07, "timestamp": "02:57:40", "text": "是的。一个用于过敏，一个用于"}, {"type": "subtitle", "time": 10665.83, "timestamp": "02:57:45", "text": "以一抵一抵。"}, {"type": "subtitle", "time": 10668.87, "timestamp": "02:57:48", "text": "还有什么别的事来着？"}, {"type": "subtitle", "time": 10670.71, "timestamp": "02:57:50", "text": "嗯"}, {"type": "subtitle", "time": 10673.91, "timestamp": "02:57:53", "text": "对，是维生素C。"}, {"type": "subtitle", "time": 10676.79, "timestamp": "02:57:56", "text": "对，是维生素C吗？"}, {"type": "subtitle", "time": 10679.47, "timestamp": "02:57:59", "text": "是的。是维生素C。"}]
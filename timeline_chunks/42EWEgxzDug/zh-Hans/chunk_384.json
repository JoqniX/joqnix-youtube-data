[{"type": "subtitle", "time": 23042.948, "timestamp": "06:24:02", "text": "一个很快就会死去的人。"}, {"type": "subtitle", "time": 23045.99, "timestamp": "06:24:05", "text": "放下这件事吧。"}, {"type": "subtitle", "time": 23047.99, "timestamp": "06:24:07", "text": "是的，第一个会死。第二"}, {"type": "subtitle", "time": 23049.99, "timestamp": "06:24:09", "text": "就是它。而垂直方向的那个是"}, {"type": "subtitle", "time": 23053.11, "timestamp": "06:24:13", "text": "拥有选择权的那一个。"}, {"type": "subtitle", "time": 23069.41, "timestamp": "06:24:29", "text": "动画"}, {"type": "subtitle", "time": 23075.97, "timestamp": "06:24:35", "text": "然后我们就直接离开了。"}, {"type": "subtitle", "time": 23078.31, "timestamp": "06:24:38", "text": "[音乐]"}, {"type": "subtitle", "time": 23080.788, "timestamp": "06:24:40", "text": "我很高兴"}, {"type": "subtitle", "time": 23082.39, "timestamp": "06:24:42", "text": "我"}, {"type": "subtitle", "time": 23084.868, "timestamp": "06:24:44", "text": "速度很快。"}, {"type": "subtitle", "time": 23088.15, "timestamp": "06:24:48", "text": "我花了很多时间"}, {"type": "subtitle", "time": 23097.01, "timestamp": "06:24:57", "text": "[音乐]"}]
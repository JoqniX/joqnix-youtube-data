[{"type": "subtitle", "time": 7802.709, "timestamp": "02:10:02", "text": "嗯，要么我发布一个合适的日程安排。"}, {"type": "subtitle", "time": 7804.95, "timestamp": "02:10:04", "text": "每天"}, {"type": "subtitle", "time": 7810.149, "timestamp": "02:10:10", "text": "或者我只能照常直播了。"}, {"type": "subtitle", "time": 7842.55, "timestamp": "02:10:42", "text": "我能被听到吗？"}, {"type": "subtitle", "time": 7845.35, "timestamp": "02:10:45", "text": "我想我是。好的。"}, {"type": "subtitle", "time": 7847.75, "timestamp": "02:10:47", "text": "虽然，嘿，嗯，我注意到孩子们在"}, {"type": "subtitle", "time": 7850.47, "timestamp": "02:10:50", "text": "Eye正在举办生日演唱会，"}, {"type": "subtitle", "time": 7851.99, "timestamp": "02:10:51", "text": "一切。"}, {"type": "subtitle", "time": 7856.55, "timestamp": "02:10:56", "text": "我看了会儿。我看见"}, {"type": "subtitle", "time": 7859.75, "timestamp": "02:10:59", "text": "《艾伊的孩子们》即将回归。不，她来了"}]
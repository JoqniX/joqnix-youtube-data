[{"type": "subtitle", "time": 243.19, "timestamp": "00:04:03", "text": "ああ、カットシーンがない。"}, {"type": "subtitle", "time": 245.67, "timestamp": "00:04:05", "text": "ちなみに、カットシーンはありません。"}, {"type": "subtitle", "time": 248.309, "timestamp": "00:04:08", "text": "これがレヴナントのスキンです。見てください"}, {"type": "subtitle", "time": 251.83, "timestamp": "00:04:11", "text": "彼。彼は今や脅威的だ。"}, {"type": "subtitle", "time": 255.99, "timestamp": "00:04:15", "text": "今の邪悪な支配者を見てみろ。おお。"}, {"type": "subtitle", "time": 262.469, "timestamp": "00:04:22", "text": "かなり良い"}, {"type": "subtitle", "time": 265.11, "timestamp": "00:04:25", "text": "良いスキンですね。"}, {"type": "subtitle", "time": 285.03, "timestamp": "00:04:45", "text": "ああ、これはすごくクールだ。何てことだ。何てことだ。"}, {"type": "subtitle", "time": 295.51, "timestamp": "00:04:55", "text": "何てことだ。色白の肌って本当に素敵。私"}]
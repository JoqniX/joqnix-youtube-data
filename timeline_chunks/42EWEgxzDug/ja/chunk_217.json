[{"type": "subtitle", "time": 13020.389, "timestamp": "03:37:00", "text": "私はまだメインの伝承を保持しています"}, {"type": "subtitle", "time": 13022.389, "timestamp": "03:37:02", "text": "つまり、そうですね、公式の伝承では"}, {"type": "subtitle", "time": 13025.429, "timestamp": "03:37:05", "text": "ジョックニックは、"}, {"type": "subtitle", "time": 13028.55, "timestamp": "03:37:08", "text": "デビュー。そしてこのモデルは私が資金提供する予定です"}, {"type": "subtitle", "time": 13031.349, "timestamp": "03:37:11", "text": "なぜならそれが公式モデルになるから"}, {"type": "subtitle", "time": 13035.59, "timestamp": "03:37:15", "text": "道。公式"}, {"type": "subtitle", "time": 13039.03, "timestamp": "03:37:19", "text": "ジョックニックのモデル。"}, {"type": "subtitle", "time": 13041.91, "timestamp": "03:37:21", "text": "ええ、これはどちらかというと初期段階ですね"}, {"type": "subtitle", "time": 13045.75, "timestamp": "03:37:25", "text": "シリーズアークモデルの概念"}, {"type": "subtitle", "time": 13048.15, "timestamp": "03:37:28", "text": "そして1つ"}, {"type": "subtitle", "time": 13051.429, "timestamp": "03:37:31", "text": "えーと、私たちは、私は"}, {"type": "subtitle", "time": 13053.59, "timestamp": "03:37:33", "text": "資金があればデビューして"}, {"type": "subtitle", "time": 13056.07, "timestamp": "03:37:36", "text": "すべてがうまくいけば"}, {"type": "subtitle", "time": 13059.11, "timestamp": "03:37:39", "text": "ジョックは公式のジョックデザインになります"}, {"type": "subtitle", "time": 13061.269, "timestamp": "03:37:41", "text": "ジョックニックデザイン キャラクターデザイン"}, {"type": "subtitle", "time": 13062.79, "timestamp": "03:37:42", "text": "すべてこんにちはすべては"}, {"type": "subtitle", "time": 13065.99, "timestamp": "03:37:45", "text": "ここから先は公式"}, {"type": "subtitle", "time": 13069.75, "timestamp": "03:37:49", "text": "うん、気に入ってくれるといいな。願っています"}, {"type": "subtitle", "time": 13072.55, "timestamp": "03:37:52", "text": "気に入ってくれたみたいだし、私もこのモデルがすごく気に入ってるよ。"}, {"type": "subtitle", "time": 13074.71, "timestamp": "03:37:54", "text": "わからない。"}, {"type": "subtitle", "time": 13077.429, "timestamp": "03:37:57", "text": "働いてくれたすべての人にとても感謝しています"}, {"type": "subtitle", "time": 13079.269, "timestamp": "03:37:59", "text": "舞台裏で私を助けてくれる人"}]
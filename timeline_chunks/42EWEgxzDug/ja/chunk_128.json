[{"type": "subtitle", "time": 7691.189, "timestamp": "02:08:11", "text": "私"}, {"type": "subtitle", "time": 7694.47, "timestamp": "02:08:14", "text": "また、"}, {"type": "subtitle", "time": 7696.709, "timestamp": "02:08:16", "text": "勉強"}, {"type": "subtitle", "time": 7700.55, "timestamp": "02:08:20", "text": "いくつかの曲もそうです。"}, {"type": "subtitle", "time": 7703.27, "timestamp": "02:08:23", "text": "あなたを好きになれたらいいなと思った"}, {"type": "subtitle", "time": 7712.069, "timestamp": "02:08:32", "text": "のように"}, {"type": "subtitle", "time": 7715.589, "timestamp": "02:08:35", "text": "試験が終わったら私は"}, {"type": "subtitle", "time": 7718.39, "timestamp": "02:08:38", "text": "自分を限界まで追い込む"}, {"type": "subtitle", "time": 7720.55, "timestamp": "02:08:40", "text": "それが"}, {"type": "subtitle", "time": 7723.43, "timestamp": "02:08:43", "text": "濃度に関して"}, {"type": "subtitle", "time": 7725.99, "timestamp": "02:08:45", "text": "または"}, {"type": "subtitle", "time": 7732.709, "timestamp": "02:08:52", "text": "私たちは実際に何でもやった。"}, {"type": "subtitle", "time": 7734.95, "timestamp": "02:08:54", "text": "おお、"}, {"type": "subtitle", "time": 7736.79, "timestamp": "02:08:56", "text": "そうしたの？"}]
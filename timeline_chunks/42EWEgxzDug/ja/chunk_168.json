[{"type": "subtitle", "time": 10082.15, "timestamp": "02:48:02", "text": "ああ、フォーラムボットが今は動いている。ニース。"}, {"type": "subtitle", "time": 10087.03, "timestamp": "02:48:07", "text": "それで、最近、ボットのキック機能を追加しました。"}, {"type": "subtitle", "time": 10089.75, "timestamp": "02:48:09", "text": "ええ、最初は化石を追加しました"}, {"type": "subtitle", "time": 10100.23, "timestamp": "02:48:20", "text": "クラウドベースのユニバーサルセットがあります"}, {"type": "subtitle", "time": 10106.15, "timestamp": "02:48:26", "text": "だって今はいい感じだから。私はそうする必要はない"}, {"type": "subtitle", "time": 10109.99, "timestamp": "02:48:29", "text": "地元でそれに依存する。オフラインでも動作します"}, {"type": "subtitle", "time": 10121.83, "timestamp": "02:48:41", "text": "そして、もしそこに"}, {"type": "subtitle", "time": 10126.71, "timestamp": "02:48:46", "text": "それは私が何らかの形で所有できる方法だった"}, {"type": "subtitle", "time": 10131.67, "timestamp": "02:48:51", "text": "私の州でパートタイムの仕事 IRO"}, {"type": "subtitle", "time": 10134.309, "timestamp": "02:48:54", "text": "それはとても助かります"}]
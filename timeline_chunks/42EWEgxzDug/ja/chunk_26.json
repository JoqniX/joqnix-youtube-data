[{"type": "subtitle", "time": 1570.149, "timestamp": "00:26:10", "text": "ああ、バカ。ああ、なんてことだ。何だって？こんにちは。"}, {"type": "subtitle", "time": 1587.669, "timestamp": "00:26:27", "text": "私はあなたのライブストリームを2つ見逃しました"}, {"type": "subtitle", "time": 1589.909, "timestamp": "00:26:29", "text": "君のチャンネルだよ、兄弟。 2ってどういう意味？"}, {"type": "subtitle", "time": 1591.83, "timestamp": "00:26:31", "text": "私のチャンネルのライブ配信？私はしませんでした"}, {"type": "subtitle", "time": 1599.43, "timestamp": "00:26:39", "text": "でも、昨日配信したんだけど"}, {"type": "subtitle", "time": 1606.63, "timestamp": "00:26:46", "text": "あなたは向こう側にいたと思います"}, {"type": "subtitle", "time": 1608.63, "timestamp": "00:26:48", "text": "1つ。現代の戦争とは別に、"}]
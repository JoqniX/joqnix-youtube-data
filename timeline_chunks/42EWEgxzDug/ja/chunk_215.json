[{"type": "subtitle", "time": 12900.71, "timestamp": "03:35:00", "text": "いろいろ計画している。"}, {"type": "subtitle", "time": 12902.79, "timestamp": "03:35:02", "text": "私は夢を諦めない。私は違います"}, {"type": "subtitle", "time": 12905.03, "timestamp": "03:35:05", "text": "膨らむことをいとわない。私は頑固者です。私は"}, {"type": "subtitle", "time": 12907.429, "timestamp": "03:35:07", "text": "わがまま。私は本当にバカだ。知っている。私はしません"}, {"type": "subtitle", "time": 12909.83, "timestamp": "03:35:09", "text": "自分が何をしているのか分かっている。私は若い。私は"}, {"type": "subtitle", "time": 12911.75, "timestamp": "03:35:11", "text": "年上。"}, {"type": "subtitle", "time": 12915.349, "timestamp": "03:35:15", "text": "私は老化が速いですが、年齢は"}, {"type": "subtitle", "time": 12917.91, "timestamp": "03:35:17", "text": "慰め。知っている"}, {"type": "subtitle", "time": 12921.83, "timestamp": "03:35:21", "text": "私は子供っぽいけど、見てみたい"}, {"type": "subtitle", "time": 12925.91, "timestamp": "03:35:25", "text": "これは本当だ。えっと、あなたがそれを好きか嫌いか"}, {"type": "subtitle", "time": 12934.87, "timestamp": "03:35:34", "text": "こんにちは。だから、メジャーが"}, {"type": "subtitle", "time": 12937.269, "timestamp": "03:35:37", "text": "情報は理解できました。だった"}, {"type": "subtitle", "time": 12939.99, "timestamp": "03:35:39", "text": "ヨアトンをやっている。イベントのタイムラインは"}, {"type": "subtitle", "time": 12944.95, "timestamp": "03:35:44", "text": "3月12日から6月中旬までだと思います"}, {"type": "subtitle", "time": 12949.51, "timestamp": "03:35:49", "text": "20か16か、そんな感じ。えっと"}, {"type": "subtitle", "time": 12954.309, "timestamp": "03:35:54", "text": "アンスタン、いいえ、私は叔父ではありません。私はまだ大人です。"}, {"type": "subtitle", "time": 12957.19, "timestamp": "03:35:57", "text": "私は"}]
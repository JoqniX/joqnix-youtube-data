[{"type": "subtitle", "time": 4697.03, "timestamp": "01:18:17", "text": "実際に外に出て行くには、"}, {"type": "subtitle", "time": 4722.229, "timestamp": "01:18:42", "text": "待って、これが最初の着信音？おお、"}, {"type": "subtitle", "time": 4726.55, "timestamp": "01:18:46", "text": "それは最初の試みだった。ところで、"}, {"type": "subtitle", "time": 4730.149, "timestamp": "01:18:50", "text": "シールドバッテリーがいくつあるか見てください"}, {"type": "subtitle", "time": 4736.79, "timestamp": "01:18:56", "text": "ショットガンの弾薬が必要だ。私はしていません"}]
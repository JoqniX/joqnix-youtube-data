[{"type": "subtitle", "time": 2582.23, "timestamp": "00:43:02", "text": "これは何ですか"}, {"type": "subtitle", "time": 2598.87, "timestamp": "00:43:18", "text": "私は嵐で死んだ。私は実際に"}, {"type": "subtitle", "time": 2602.44, "timestamp": "00:43:22", "text": "亡くなった。わかった。シムズ、"}, {"type": "subtitle", "time": 2631.75, "timestamp": "00:43:51", "text": "ナチス党員2人。"}, {"type": "subtitle", "time": 2639.91, "timestamp": "00:43:59", "text": "ああ、もう1つ。実際、今から私は"}]
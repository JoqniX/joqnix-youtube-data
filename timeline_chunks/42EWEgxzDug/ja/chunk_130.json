[{"type": "subtitle", "time": 7802.709, "timestamp": "02:10:02", "text": "えっと、適切なスケジュールを投稿するか"}, {"type": "subtitle", "time": 7804.95, "timestamp": "02:10:04", "text": "毎日"}, {"type": "subtitle", "time": 7810.149, "timestamp": "02:10:10", "text": "もしくは、普段通りの配信をしなければならない"}, {"type": "subtitle", "time": 7842.55, "timestamp": "02:10:42", "text": "私の声は聞こえていますか？"}, {"type": "subtitle", "time": 7845.35, "timestamp": "02:10:45", "text": "そうだと思います。はい、結構です。"}, {"type": "subtitle", "time": 7847.75, "timestamp": "02:10:47", "text": "とはいえ、あの、子供たちが"}, {"type": "subtitle", "time": 7850.47, "timestamp": "02:10:50", "text": "アイは誕生日コンサートを開催し、"}, {"type": "subtitle", "time": 7851.99, "timestamp": "02:10:51", "text": "すべて。"}, {"type": "subtitle", "time": 7856.55, "timestamp": "02:10:56", "text": "少しだけ見ていました。私は見た"}, {"type": "subtitle", "time": 7859.75, "timestamp": "02:10:59", "text": "Kids in Eyeが帰ってきます。いいえ、彼女は来た"}]
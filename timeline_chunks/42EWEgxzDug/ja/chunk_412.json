[{"type": "subtitle", "time": 24728.868, "timestamp": "06:52:08", "text": "これから起こることに備えよう"}, {"type": "subtitle", "time": 24734.07, "timestamp": "06:52:14", "text": "タワー。え、何？なんてこった、"}, {"type": "subtitle", "time": 24740.788, "timestamp": "06:52:20", "text": "それから、サビス、あなたは"}, {"type": "subtitle", "time": 24754.788, "timestamp": "06:52:34", "text": "ですから、ここは入り口ではないと思います。"}, {"type": "subtitle", "time": 24758.39, "timestamp": "06:52:38", "text": "あなたは。何てことだ。"}, {"type": "subtitle", "time": 24762.39, "timestamp": "06:52:42", "text": "ニース。実際はそうではありません。"}, {"type": "subtitle", "time": 24766.31, "timestamp": "06:52:46", "text": "私は私は普段私はそうすべきです"}, {"type": "subtitle", "time": 24768.07, "timestamp": "06:52:48", "text": "今、泣き叫んでいるのを見て"}, {"type": "subtitle", "time": 24770.23, "timestamp": "06:52:50", "text": "これらすべてですが、幸いなことにそうではありません"}, {"type": "subtitle", "time": 24772.868, "timestamp": "06:52:52", "text": "それは恐ろしいことだ。いいえ。いいえ。私は今"}, {"type": "subtitle", "time": 24775.51, "timestamp": "06:52:55", "text": "本当に不気味だけど"}]
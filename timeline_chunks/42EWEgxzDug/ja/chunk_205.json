[{"type": "subtitle", "time": 12302.63, "timestamp": "03:25:02", "text": "[音楽]"}, {"type": "subtitle", "time": 12306.309, "timestamp": "03:25:06", "text": "私はストリーミング配信が大好きです。えっと、えっと、"}, {"type": "subtitle", "time": 12308.55, "timestamp": "03:25:08", "text": "動画関係の仕事は苦手なんです。私はしません"}, {"type": "subtitle", "time": 12311.91, "timestamp": "03:25:11", "text": "知る。でも、もし私が"}, {"type": "subtitle", "time": 12315.67, "timestamp": "03:25:15", "text": "ライブ配信をしていると思ってください。もし私が"}, {"type": "subtitle", "time": 12317.51, "timestamp": "03:25:17", "text": "ライブ配信だと思って動画を録画する"}, {"type": "subtitle", "time": 12322.469, "timestamp": "03:25:22", "text": "配信なら、うまくできると思う。うん。"}, {"type": "subtitle", "time": 12325.03, "timestamp": "03:25:25", "text": "それで"}, {"type": "subtitle", "time": 12327.75, "timestamp": "03:25:27", "text": "うん、"}, {"type": "subtitle", "time": 12330.55, "timestamp": "03:25:30", "text": "我々が日本と戦うまで。はい、"}, {"type": "subtitle", "time": 12334.87, "timestamp": "03:25:34", "text": "これはチャンネル全体で行われるイベントになります。"}, {"type": "subtitle", "time": 12339.67, "timestamp": "03:25:39", "text": "ええと、私が日本に行くのは6月です。"}, {"type": "subtitle", "time": 12343.429, "timestamp": "03:25:43", "text": "えっと、6月は試験がある月です"}, {"type": "subtitle", "time": 12346.389, "timestamp": "03:25:46", "text": "これらは非常に重要である"}, {"type": "subtitle", "time": 12348.95, "timestamp": "03:25:48", "text": "私の学位と、その他すべて"}, {"type": "subtitle", "time": 12352.55, "timestamp": "03:25:52", "text": "学術的なことだけど、優先順位は低い"}, {"type": "subtitle", "time": 12354.63, "timestamp": "03:25:54", "text": "だって、今日本にいるからできないんだ"}, {"type": "subtitle", "time": 12357.349, "timestamp": "03:25:57", "text": "試験を受けるためにインドに戻るが"}, {"type": "subtitle", "time": 12359.91, "timestamp": "03:25:59", "text": "うまくいけば学業を終えられるといいのですが"}]
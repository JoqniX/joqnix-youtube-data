[{"type": "subtitle", "time": 8940.71, "timestamp": "02:29:00", "text": "私"}, {"type": "subtitle", "time": 8944.07, "timestamp": "02:29:04", "text": "満腹感を感じる"}, {"type": "subtitle", "time": 8946.95, "timestamp": "02:29:06", "text": "どうか喜びを感じないでください。私はオマールです。それは"}, {"type": "subtitle", "time": 8950.79, "timestamp": "02:29:10", "text": "無料ゲーム。楽しい。私は中毒です。おお、"}, {"type": "subtitle", "time": 8952.71, "timestamp": "02:29:12", "text": "私が試してみます。"}, {"type": "subtitle", "time": 8955.439, "timestamp": "02:29:15", "text": "試してみます。 声を上げよう。気をつけて。"}, {"type": "subtitle", "time": 8959.439, "timestamp": "02:29:19", "text": "声を上げよう。気をつけて。 気をつけて。それなら、Mosを試してみます。"}, {"type": "subtitle", "time": 8963.84, "timestamp": "02:29:23", "text": "気をつけて。それなら、Mosを試してみます。 Steamでゲームをインストールしました。欲しい"}, {"type": "subtitle", "time": 8967.84, "timestamp": "02:29:27", "text": "Steamでゲームをインストールしました。欲しい プレイしてみる。うん。うん。ありがとう"}, {"type": "subtitle", "time": 8970.56, "timestamp": "02:29:30", "text": "プレイしてみる。うん。うん。ありがとう ご提案ありがとうございます。"}, {"type": "subtitle", "time": 8972.64, "timestamp": "02:29:32", "text": "ご提案ありがとうございます。 ありがとう。ありがとう。"}, {"type": "subtitle", "time": 8975.12, "timestamp": "02:29:35", "text": "ありがとう。ありがとう。 ええ、そうですね"}, {"type": "subtitle", "time": 8983.11, "timestamp": "02:29:43", "text": "ゲームに関しては、私はそうは思わない、うーん"}, {"type": "subtitle", "time": 8985.91, "timestamp": "02:29:45", "text": "ある意味、FPSをすることに飽きて"}, {"type": "subtitle", "time": 8988.23, "timestamp": "02:29:48", "text": "その他のもの"}, {"type": "subtitle", "time": 8990.23, "timestamp": "02:29:50", "text": "そして"}, {"type": "subtitle", "time": 8994.07, "timestamp": "02:29:54", "text": "もっとやろうと思っていた"}, {"type": "subtitle", "time": 8998.07, "timestamp": "02:29:58", "text": "えっと、来月から私は"}, {"type": "subtitle", "time": 8999.91, "timestamp": "02:29:59", "text": "する"}]
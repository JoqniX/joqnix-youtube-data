[{"type": "subtitle", "time": 22444.31, "timestamp": "06:14:04", "text": "ただこの男だけだ。この二重構造"}, {"type": "subtitle", "time": 22447.11, "timestamp": "06:14:07", "text": "1つ。"}, {"type": "subtitle", "time": 22451.11, "timestamp": "06:14:11", "text": "今度は巨大なものを作りました"}, {"type": "subtitle", "time": 22454.23, "timestamp": "06:14:14", "text": "それは何と呼ばれますか？"}, {"type": "subtitle", "time": 22457.19, "timestamp": "06:14:17", "text": "巨大な"}, {"type": "subtitle", "time": 22467.11, "timestamp": "06:14:27", "text": "これは簡単に"}, {"type": "subtitle", "time": 22470.15, "timestamp": "06:14:30", "text": "可能"}, {"type": "subtitle", "time": 22488.23, "timestamp": "06:14:48", "text": "ああ、いや。とても近いのですが、"}, {"type": "subtitle", "time": 22491.19, "timestamp": "06:14:51", "text": "同じ瞬間、私は"}, {"type": "subtitle", "time": 22493.27, "timestamp": "06:14:53", "text": "それほど近い距離だった。"}]
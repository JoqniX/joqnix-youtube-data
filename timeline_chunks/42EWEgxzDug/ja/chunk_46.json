[{"type": "subtitle", "time": 2763.43, "timestamp": "00:46:03", "text": "いいえ、"}, {"type": "subtitle", "time": 2767.67, "timestamp": "00:46:07", "text": "私は彼の顔の上にいた。いいえ、"}, {"type": "subtitle", "time": 2771.03, "timestamp": "00:46:11", "text": "私も弾倉がなくなってしまった。"}, {"type": "subtitle", "time": 2772.87, "timestamp": "00:46:12", "text": "私は彼の周りをぐるぐる回っていたと思う"}, {"type": "subtitle", "time": 2777.27, "timestamp": "00:46:17", "text": "首と、えーと彼の上のつま先。それで"}, {"type": "subtitle", "time": 2778.95, "timestamp": "00:46:18", "text": "だからボディショットとみなされたんだ"}, {"type": "subtitle", "time": 2782.069, "timestamp": "00:46:22", "text": "顔面ではなく、正面からのショット。おお、"}, {"type": "subtitle", "time": 2806.95, "timestamp": "00:46:46", "text": "私は11,400点を獲得しました。"}, {"type": "subtitle", "time": 2809.589, "timestamp": "00:46:49", "text": "だから、あと1レベル上げれば、"}, {"type": "subtitle", "time": 2816.95, "timestamp": "00:46:56", "text": "12,000。新しい伝説を手に入れることができる。"}]
[{"type": "subtitle", "time": 18002.47, "timestamp": "05:00:02", "text": "この子をこっちに連れてくるよ。いいえ、"}, {"type": "subtitle", "time": 18006.708, "timestamp": "05:00:06", "text": "待って。持続する。右。だから、私はこれを持ってくる"}, {"type": "subtitle", "time": 18009.83, "timestamp": "05:00:09", "text": "こちらの男"}, {"type": "subtitle", "time": 18014.868, "timestamp": "05:00:14", "text": "そして彼をこちらへ連れてきてください。"}, {"type": "subtitle", "time": 18026.868, "timestamp": "05:00:26", "text": "いいえ、それはうまくいきません。"}, {"type": "subtitle", "time": 18037.91, "timestamp": "05:00:37", "text": "私は心の底で行き詰まっている。何てことだ。"}, {"type": "subtitle", "time": 18052.868, "timestamp": "05:00:52", "text": "でも、それは私には無理です。"}]
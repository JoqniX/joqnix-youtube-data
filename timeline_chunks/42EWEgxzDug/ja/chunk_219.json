[{"type": "subtitle", "time": 13141.75, "timestamp": "03:39:01", "text": "良い。そして最後に、私はこう言いたい"}, {"type": "subtitle", "time": 13145.59, "timestamp": "03:39:05", "text": "ずっと一緒にいてくれてありがとう"}, {"type": "subtitle", "time": 13147.75, "timestamp": "03:39:07", "text": "この数年間。"}, {"type": "subtitle", "time": 13149.349, "timestamp": "03:39:09", "text": "わかった。"}, {"type": "subtitle", "time": 13153.429, "timestamp": "03:39:13", "text": "多くの方がお待ちになりました。あなたは待っていた"}, {"type": "subtitle", "time": 13157.349, "timestamp": "03:39:17", "text": "辛抱強く。えっと、私が"}, {"type": "subtitle", "time": 13160.389, "timestamp": "03:39:20", "text": "このようなモデルやライブ2Dは持っていませんでした。"}, {"type": "subtitle", "time": 13161.91, "timestamp": "03:39:21", "text": "私を見続け、"}, {"type": "subtitle", "time": 13164.469, "timestamp": "03:39:24", "text": "私が新米だった頃に支えてくれた"}, {"type": "subtitle", "time": 13166.87, "timestamp": "03:39:26", "text": "YouTubeとか、その他いろいろ。"}, {"type": "subtitle", "time": 13168.87, "timestamp": "03:39:28", "text": "ところで、本当にありがとうございました。"}, {"type": "subtitle", "time": 13170.71, "timestamp": "03:39:30", "text": "皆さんがこれまでやってきたことすべて"}, {"type": "subtitle", "time": 13173.429, "timestamp": "03:39:33", "text": "自分。"}, {"type": "subtitle", "time": 13176.71, "timestamp": "03:39:36", "text": "そして私はいつも、自分がそうではなかったことを後悔していた"}, {"type": "subtitle", "time": 13178.63, "timestamp": "03:39:38", "text": "あなたに良いものを提供できる"}, {"type": "subtitle", "time": 13184.63, "timestamp": "03:39:44", "text": "しかし"}, {"type": "subtitle", "time": 13187.51, "timestamp": "03:39:47", "text": "私は良いものを提供できると信じています"}, {"type": "subtitle", "time": 13190.309, "timestamp": "03:39:50", "text": "グッズや"}, {"type": "subtitle", "time": 13191.99, "timestamp": "03:39:51", "text": "すべて。"}, {"type": "subtitle", "time": 13194.469, "timestamp": "03:39:54", "text": "でも、それに向けて努力したいと思っています。私"}, {"type": "subtitle", "time": 13196.15, "timestamp": "03:39:56", "text": "それが私が日本に行く理由です。"}, {"type": "subtitle", "time": 13199.19, "timestamp": "03:39:59", "text": "わかった。利己的だと分かっています"}]
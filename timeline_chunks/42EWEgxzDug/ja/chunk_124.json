[{"type": "subtitle", "time": 7442.709, "timestamp": "02:04:02", "text": "私は携帯電話で使っているヘッドホン"}, {"type": "subtitle", "time": 7450.709, "timestamp": "02:04:10", "text": "えっと"}, {"type": "subtitle", "time": 7455.35, "timestamp": "02:04:15", "text": "耳の片方がその"}, {"type": "subtitle", "time": 7459.99, "timestamp": "02:04:19", "text": "充電されなくなった。理由はわからない。"}, {"type": "subtitle", "time": 7462.709, "timestamp": "02:04:22", "text": "そしてそれは最悪だ"}, {"type": "subtitle", "time": 7465.189, "timestamp": "02:04:25", "text": "片方のイヤホンが充電されず、"}, {"type": "subtitle", "time": 7468.07, "timestamp": "02:04:28", "text": "最悪だ。"}, {"type": "subtitle", "time": 7469.75, "timestamp": "02:04:29", "text": "そして"}, {"type": "subtitle", "time": 7472.229, "timestamp": "02:04:32", "text": "私は声をかけられたペアを使っています"}, {"type": "subtitle", "time": 7476.31, "timestamp": "02:04:36", "text": "日本向け。"}, {"type": "subtitle", "time": 7487.51, "timestamp": "02:04:47", "text": "うん。えっと"}, {"type": "subtitle", "time": 7491.35, "timestamp": "02:04:51", "text": "私の試験は終わるまでに"}]
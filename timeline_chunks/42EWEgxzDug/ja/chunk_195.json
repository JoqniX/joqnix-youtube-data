[{"type": "subtitle", "time": 11702.71, "timestamp": "03:15:02", "text": "これからどうなるか不安です。"}, {"type": "subtitle", "time": 11705.11, "timestamp": "03:15:05", "text": "ちょっと怖い"}, {"type": "subtitle", "time": 11708.469, "timestamp": "03:15:08", "text": "だって、このすべてが新しい"}, {"type": "subtitle", "time": 11711.03, "timestamp": "03:15:11", "text": "私にとっての経験であり、私は経験しています"}, {"type": "subtitle", "time": 11714.469, "timestamp": "03:15:14", "text": "皆さんと一緒にやりましょう。それが"}, {"type": "subtitle", "time": 11717.51, "timestamp": "03:15:17", "text": "このイベントを一緒に、または裏で行っています"}, {"type": "subtitle", "time": 11720.79, "timestamp": "03:15:20", "text": "人と話すようなシーン、話す"}, {"type": "subtitle", "time": 11724.55, "timestamp": "03:15:24", "text": "アーティストと話す"}, {"type": "subtitle", "time": 11727.03, "timestamp": "03:15:27", "text": "人々、そして、そうですね、どのように委託するか"}, {"type": "subtitle", "time": 11729.349, "timestamp": "03:15:29", "text": "依頼する方法、プロフェッショナルになる方法、"}, {"type": "subtitle", "time": 11731.67, "timestamp": "03:15:31", "text": "ビジネスとは一体どのように機能するのでしょうか？私"}, {"type": "subtitle", "time": 11733.91, "timestamp": "03:15:33", "text": "何も知らない"}, {"type": "subtitle", "time": 11736.309, "timestamp": "03:15:36", "text": "でも、この旅を通して学んでいる"}, {"type": "subtitle", "time": 11738.15, "timestamp": "03:15:38", "text": "推測"}, {"type": "subtitle", "time": 11742.15, "timestamp": "03:15:42", "text": "私は学んでいます、たくさん学びました"}, {"type": "subtitle", "time": 11749.67, "timestamp": "03:15:49", "text": "えっと、私は"}, {"type": "subtitle", "time": 11751.67, "timestamp": "03:15:51", "text": "うん"}, {"type": "subtitle", "time": 11754.55, "timestamp": "03:15:54", "text": "ええ、そうですね"}, {"type": "subtitle", "time": 11757.349, "timestamp": "03:15:57", "text": "だからおそらく遠い将来私は"}]
[{"type": "subtitle", "time": 12242.63, "timestamp": "03:24:02", "text": "私自身にとっても、"}, {"type": "subtitle", "time": 12248.309, "timestamp": "03:24:08", "text": "そうですね、"}, {"type": "subtitle", "time": 12250.469, "timestamp": "03:24:10", "text": "以上が私の発表です。私は、"}, {"type": "subtitle", "time": 12258.63, "timestamp": "03:24:18", "text": "でも、皆さん、聞いてくれてありがとう。"}, {"type": "subtitle", "time": 12260.229, "timestamp": "03:24:20", "text": "えっと、"}, {"type": "subtitle", "time": 12262.309, "timestamp": "03:24:22", "text": "あなたのチャットのほとんどを読みました。しないで"}, {"type": "subtitle", "time": 12265.51, "timestamp": "03:24:25", "text": "心配。私はそれを見ていました。"}, {"type": "subtitle", "time": 12269.349, "timestamp": "03:24:29", "text": "私はそれを見ていました。ええ、そうですね。もしあなたが"}, {"type": "subtitle", "time": 12271.67, "timestamp": "03:24:31", "text": "ご質問があれば、お気軽にお尋ねください。"}, {"type": "subtitle", "time": 12276.309, "timestamp": "03:24:36", "text": "今。えっと、数分間待ってください"}, {"type": "subtitle", "time": 12279.83, "timestamp": "03:24:39", "text": "開ける。えっと、何か質問があれば"}, {"type": "subtitle", "time": 12284.389, "timestamp": "03:24:44", "text": "イベントについて、えーと、質問できます、えーと、"}, {"type": "subtitle", "time": 12286.63, "timestamp": "03:24:46", "text": "10分か5分くらい"}, {"type": "subtitle", "time": 12290.389, "timestamp": "03:24:50", "text": "分。こんにちは。ライブ配信なので、"}, {"type": "subtitle", "time": 12294.229, "timestamp": "03:24:54", "text": "動画にしたかったのですが、"}, {"type": "subtitle", "time": 12297.349, "timestamp": "03:24:57", "text": "生で生の状態の方が、より良い結果が出せる気がした"}, {"type": "subtitle", "time": 12299.19, "timestamp": "03:24:59", "text": "生"}]
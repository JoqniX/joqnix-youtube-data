[{"type": "subtitle", "time": 22985.91, "timestamp": "06:23:05", "text": "一緒に移動できないなんて言わないでください"}, {"type": "subtitle", "time": 22997.09, "timestamp": "06:23:17", "text": "変更を加えることができません"}, {"type": "subtitle", "time": 23003.83, "timestamp": "06:23:23", "text": "はい、こちらへどうぞ。あ、待って。私は思う"}, {"type": "subtitle", "time": 23005.67, "timestamp": "06:23:25", "text": "わかった。理解できたと思います。私は手に入れたと思います"}, {"type": "subtitle", "time": 23011.51, "timestamp": "06:23:31", "text": "それ。さあ行こう。さあ行こう。了解しました。はい。"}, {"type": "subtitle", "time": 23014.31, "timestamp": "06:23:34", "text": "頭がいい。"}, {"type": "subtitle", "time": 23020.868, "timestamp": "06:23:40", "text": "ついに。"}, {"type": "subtitle", "time": 23022.868, "timestamp": "06:23:42", "text": "待って、スクリーンショットを撮る必要がある"}, {"type": "subtitle", "time": 23024.77, "timestamp": "06:23:44", "text": "これ。"}, {"type": "subtitle", "time": 23027.83, "timestamp": "06:23:47", "text": "[音楽]"}, {"type": "subtitle", "time": 23030.708, "timestamp": "06:23:50", "text": "このスクリーンショットを撮る必要があります"}, {"type": "subtitle", "time": 23033.51, "timestamp": "06:23:53", "text": "念のためね。何が起こるかわからない"}, {"type": "subtitle", "time": 23036.31, "timestamp": "06:23:56", "text": "何が起こるか。"}, {"type": "subtitle", "time": 23039.27, "timestamp": "06:23:59", "text": "では、最初のものは"}]
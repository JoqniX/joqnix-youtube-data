[{"type": "subtitle", "time": 10144.07, "timestamp": "02:49:04", "text": "依存するのではなく"}, {"type": "subtitle", "time": 10150.07, "timestamp": "02:49:10", "text": "日本に行ってアルバイトをする。それ"}, {"type": "subtitle", "time": 10153.19, "timestamp": "02:49:13", "text": "巨大な命令のようだった"}, {"type": "subtitle", "time": 10165.44, "timestamp": "02:49:25", "text": "えっと、誰が私に何をくれるんですか？"}, {"type": "subtitle", "time": 10171.99, "timestamp": "02:49:31", "text": "うん、"}, {"type": "subtitle", "time": 10182.15, "timestamp": "02:49:42", "text": "たくさんの植物、そしてたくさんの植物。"}]
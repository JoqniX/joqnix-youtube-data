[{"type": "subtitle", "time": 63.75, "timestamp": "00:01:03", "text": "私もそのメッセージをピン留めしていました。"}, {"type": "subtitle", "time": 66.39, "timestamp": "00:01:06", "text": "いや、でも大丈夫だと思ったんです。病気"}, {"type": "subtitle", "time": 69.51, "timestamp": "00:01:09", "text": "一緒に朝食を食べよう"}, {"type": "subtitle", "time": 71.99, "timestamp": "00:01:11", "text": "みんな。"}, {"type": "subtitle", "time": 75.91, "timestamp": "00:01:15", "text": "だから、大丈夫です。それが"}, {"type": "subtitle", "time": 81.10900000000001, "timestamp": "00:01:21", "text": "やったよ。"}, {"type": "subtitle", "time": 83.10900000000001, "timestamp": "00:01:23", "text": "今日はApexをプレイします"}, {"type": "subtitle", "time": 86.31, "timestamp": "00:01:26", "text": "伝説。どうやらそれが新しい"}, {"type": "subtitle", "time": 91.99, "timestamp": "00:01:31", "text": "ハロウィン、えーと、悪夢。それは、えーと"}, {"type": "subtitle", "time": 95.67, "timestamp": "00:01:35", "text": "起こっていることと、ええと、Apex"}, {"type": "subtitle", "time": 99.35, "timestamp": "00:01:39", "text": "また、ドペルもあります"}, {"type": "subtitle", "time": 102.469, "timestamp": "00:01:42", "text": "プレステージスキンであるガンガイベント"}, {"type": "subtitle", "time": 106.789, "timestamp": "00:01:46", "text": "レヴナントの。最後にラヴィ・チャンは"}, {"type": "subtitle", "time": 113.749, "timestamp": "00:01:53", "text": "[音楽]"}, {"type": "subtitle", "time": 115.749, "timestamp": "00:01:55", "text": "そして、今日は"}, {"type": "subtitle", "time": 117.83, "timestamp": "00:01:57", "text": "10月18日は記念日です"}]
[{"type": "subtitle", "time": 9183.349, "timestamp": "02:33:03", "text": "では、それについて話して、それから"}, {"type": "subtitle", "time": 9185.51, "timestamp": "02:33:05", "text": "家に帰って横になった。わかった。だから、私は"}, {"type": "subtitle", "time": 9188.55, "timestamp": "02:33:08", "text": "少し間を置きます。"}, {"type": "subtitle", "time": 9191.99, "timestamp": "02:33:11", "text": "えーっと、ミュートにするという意味で一時停止"}, {"type": "subtitle", "time": 9194.23, "timestamp": "02:33:14", "text": "音声ストリーム"}, {"type": "subtitle", "time": 9197.19, "timestamp": "02:33:17", "text": "そして再接続する。わかりました、"}]
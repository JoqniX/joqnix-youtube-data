[{"type": "subtitle", "time": 7741.03, "timestamp": "02:09:01", "text": "20％です。 20%の時点でビープ音が鳴ります。"}, {"type": "subtitle", "time": 7743.589, "timestamp": "02:09:03", "text": "ええ、私のイヤホンは"}, {"type": "subtitle", "time": 7745.109, "timestamp": "02:09:05", "text": "耳"}, {"type": "subtitle", "time": 7747.669, "timestamp": "02:09:07", "text": "料金は請求済みです。だから、それはある意味"}, {"type": "subtitle", "time": 7761.109, "timestamp": "02:09:21", "text": "なぜこの人は"}, {"type": "subtitle", "time": 7775.03, "timestamp": "02:09:35", "text": "人が増えた。"}, {"type": "subtitle", "time": 7777.51, "timestamp": "02:09:37", "text": "もちろん。"}, {"type": "subtitle", "time": 7779.589, "timestamp": "02:09:39", "text": "えっと"}, {"type": "subtitle", "time": 7783.589, "timestamp": "02:09:43", "text": "問題は、私がこういうことをしたいということです"}, {"type": "subtitle", "time": 7786.149, "timestamp": "02:09:46", "text": "終わりの感覚"}, {"type": "subtitle", "time": 7791.109, "timestamp": "02:09:51", "text": "こういう12時間制ではなく、24時間制に近いもの"}, {"type": "subtitle", "time": 7793.91, "timestamp": "02:09:53", "text": "一度ストリーム配信"}, {"type": "subtitle", "time": 7795.51, "timestamp": "02:09:55", "text": "正直に"}, {"type": "subtitle", "time": 7798.39, "timestamp": "02:09:58", "text": "だって私は"}]
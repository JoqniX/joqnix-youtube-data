[{"type": "subtitle", "time": 23177.35, "timestamp": "06:26:17", "text": "よし、スピードランをしよう。"}, {"type": "subtitle", "time": 23179.35, "timestamp": "06:26:19", "text": "ダッシュする"}, {"type": "subtitle", "time": 23183.51, "timestamp": "06:26:23", "text": "そして彼はもう終わっているだろう"}, {"type": "subtitle", "time": 23185.59, "timestamp": "06:26:25", "text": "クレーンですよね？上にあるクレーン"}, {"type": "subtitle", "time": 23189.99, "timestamp": "06:26:29", "text": "そこには。うん、彼はそこにいるよ。"}]
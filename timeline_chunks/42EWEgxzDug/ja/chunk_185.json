[{"type": "subtitle", "time": 11100.79, "timestamp": "03:05:00", "text": "収益化を実現する。私はそうは思わない"}, {"type": "subtitle", "time": 11104.63, "timestamp": "03:05:04", "text": "できるかどうかは分からないが、私はできると信じている。もし"}, {"type": "subtitle", "time": 11107.51, "timestamp": "03:05:07", "text": "私は、ええと、十分に一貫性があります、私は"}, {"type": "subtitle", "time": 11110.55, "timestamp": "03:05:10", "text": "それに向けて一生懸命取り組んでいます。うん。"}, {"type": "subtitle", "time": 11113.429, "timestamp": "03:05:13", "text": "ええ、とても大きな"}, {"type": "subtitle", "time": 11115.51, "timestamp": "03:05:15", "text": "金額、この4ヶ月は"}, {"type": "subtitle", "time": 11117.83, "timestamp": "03:05:17", "text": "期間は十分です。"}, {"type": "subtitle", "time": 11122.469, "timestamp": "03:05:22", "text": "だから私はこれをやるつもりだ、ジョアソン"}, {"type": "subtitle", "time": 11125.03, "timestamp": "03:05:25", "text": "この4ヶ月間だけの話ですが"}, {"type": "subtitle", "time": 11128.309, "timestamp": "03:05:28", "text": "日本に着いたら買わなければならない"}, {"type": "subtitle", "time": 11130.63, "timestamp": "03:05:30", "text": "新しいノートパソコンとその他すべてを手に入れて"}, {"type": "subtitle", "time": 11133.67, "timestamp": "03:05:33", "text": "戻ってこられるように全て準備する"}, {"type": "subtitle", "time": 11136.87, "timestamp": "03:05:36", "text": "ストリーミング配信へ。わかった。"}, {"type": "subtitle", "time": 11138.389, "timestamp": "03:05:38", "text": "うん。"}, {"type": "subtitle", "time": 11140.79, "timestamp": "03:05:40", "text": "それには時間がかかることは承知しています。そして"}, {"type": "subtitle", "time": 11144.63, "timestamp": "03:05:44", "text": "えっと、私って私だから、私は"}, {"type": "subtitle", "time": 11147.11, "timestamp": "03:05:47", "text": "生き残れるかもしれないが、私は生き残る。私"}, {"type": "subtitle", "time": 11149.03, "timestamp": "03:05:49", "text": "自分を信じる。それは新たな挑戦だ"}, {"type": "subtitle", "time": 11152.07, "timestamp": "03:05:52", "text": "私にとって。内向的な私が外に出て"}, {"type": "subtitle", "time": 11155.83, "timestamp": "03:05:55", "text": "世界と、私自身の視点から世界を見る"}, {"type": "subtitle", "time": 11158.71, "timestamp": "03:05:58", "text": "世界がどのように機能しているか、そしてあらゆることを見る目。"}]
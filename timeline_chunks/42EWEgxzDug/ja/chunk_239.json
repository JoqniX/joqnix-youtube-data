[{"type": "subtitle", "time": 14341.03, "timestamp": "03:59:01", "text": "そして、私が"}, {"type": "subtitle", "time": 14343.67, "timestamp": "03:59:03", "text": "心底から叫びますが、同時に"}, {"type": "subtitle", "time": 14345.91, "timestamp": "03:59:05", "text": "マイクの感度を"}, {"type": "subtitle", "time": 14348.63, "timestamp": "03:59:08", "text": "最大つまりそれは"}, {"type": "subtitle", "time": 14350.79, "timestamp": "03:59:10", "text": "つまり"}, {"type": "subtitle", "time": 14355.189, "timestamp": "03:59:15", "text": "えっと、それはつまり、私は叫ばないかもしれないということです"}, {"type": "subtitle", "time": 14359.269, "timestamp": "03:59:19", "text": "近所の人や家族が"}, {"type": "subtitle", "time": 14363.349, "timestamp": "03:59:23", "text": "パキスタンにいる。それで"}, {"type": "subtitle", "time": 14367.67, "timestamp": "03:59:27", "text": "大丈夫だといいのですが。こんにちは。そして、もし"}, {"type": "subtitle", "time": 14369.51, "timestamp": "03:59:29", "text": "あなたはまだBGMが欲しい"}, {"type": "subtitle", "time": 14373.11, "timestamp": "03:59:33", "text": "それはそれで、落ち着いていていい感じだ。それとも、"}, {"type": "subtitle", "time": 14376.55, "timestamp": "03:59:36", "text": "ゲームの音声、ゲーム音楽？私にさせてください"}, {"type": "subtitle", "time": 14378.71, "timestamp": "03:59:38", "text": "今すぐ知れば調整できる"}, {"type": "subtitle", "time": 14382.309, "timestamp": "03:59:42", "text": "それに応じて、このゲームを開始してください。プレス"}, {"type": "subtitle", "time": 14389.67, "timestamp": "03:59:49", "text": "何てことだ。"}, {"type": "subtitle", "time": 14397.03, "timestamp": "03:59:57", "text": "痛み？"}]
[{"type": "subtitle", "time": 12364.389, "timestamp": "03:26:04", "text": "他にも色々あるけど、そう、6月は私の試験なんだ。"}, {"type": "subtitle", "time": 12366.55, "timestamp": "03:26:06", "text": "その間、その間、私がやっている間は"}, {"type": "subtitle", "time": 12368.95, "timestamp": "03:26:08", "text": "ジョアソン、ストリームは最大2つになります"}, {"type": "subtitle", "time": 12374.71, "timestamp": "03:26:14", "text": "毎日だったと思う。はい。そして終わり"}, {"type": "subtitle", "time": 12377.59, "timestamp": "03:26:17", "text": "6月の最終週は私が"}, {"type": "subtitle", "time": 12379.349, "timestamp": "03:26:19", "text": "全てをまとめて、最後の言葉を言う"}, {"type": "subtitle", "time": 12381.75, "timestamp": "03:26:21", "text": "さようなら。最後の追い込みをかける"}, {"type": "subtitle", "time": 12385.19, "timestamp": "03:26:25", "text": "配信、ジョアソン最終週。良い"}, {"type": "subtitle", "time": 12388.15, "timestamp": "03:26:28", "text": "最終段階である第4段階は、"}, {"type": "subtitle", "time": 12391.03, "timestamp": "03:26:31", "text": "私がそう呼ぶ。えっと"}, {"type": "subtitle", "time": 12394.229, "timestamp": "03:26:34", "text": "そこで私たちはすべてに別れを告げる、"}, {"type": "subtitle", "time": 12398.71, "timestamp": "03:26:38", "text": "私のパソコン、友人たち、すべて。"}, {"type": "subtitle", "time": 12401.11, "timestamp": "03:26:41", "text": "そして専用のストリームを用意します"}, {"type": "subtitle", "time": 12403.91, "timestamp": "03:26:43", "text": "ヨアトンの最後の日。"}, {"type": "subtitle", "time": 12405.75, "timestamp": "03:26:45", "text": "うん。"}, {"type": "subtitle", "time": 12409.19, "timestamp": "03:26:49", "text": "それで、その後日本で、おそらく"}, {"type": "subtitle", "time": 12410.87, "timestamp": "03:26:50", "text": "7月、"}, {"type": "subtitle", "time": 12414.95, "timestamp": "03:26:54", "text": "週半ば、7月中旬または下旬、私は"}, {"type": "subtitle", "time": 12417.429, "timestamp": "03:26:57", "text": "ストリーミングを再開できるようになったら"}]
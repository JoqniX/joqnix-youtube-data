[{"type": "subtitle", "time": 11941.99, "timestamp": "03:19:01", "text": "イベント。"}, {"type": "subtitle", "time": 11945.349, "timestamp": "03:19:05", "text": "ええ、これで全てお分かりいただけたと思います。私"}, {"type": "subtitle", "time": 11949.91, "timestamp": "03:19:09", "text": "えっと、私がずっとやりたかったことは"}, {"type": "subtitle", "time": 11958.229, "timestamp": "03:19:18", "text": "ええ、イベントは"}, {"type": "subtitle", "time": 11961.269, "timestamp": "03:19:21", "text": "3月12日。"}, {"type": "subtitle", "time": 11968.87, "timestamp": "03:19:28", "text": "最初の配信。"}, {"type": "subtitle", "time": 11972.15, "timestamp": "03:19:32", "text": "はい、ええ、約束します"}, {"type": "subtitle", "time": 11974.469, "timestamp": "03:19:34", "text": "ここストリームで、なぜなら"}, {"type": "subtitle", "time": 11977.83, "timestamp": "03:19:37", "text": "お知らせストリーム"}, {"type": "subtitle", "time": 11979.67, "timestamp": "03:19:39", "text": "おそらく"}, {"type": "subtitle", "time": 11982.55, "timestamp": "03:19:42", "text": "奇跡が起きたら"}, {"type": "subtitle", "time": 11985.269, "timestamp": "03:19:45", "text": "私が手に入れたものは何でも、私はそれを保持します"}, {"type": "subtitle", "time": 11987.59, "timestamp": "03:19:47", "text": "私の銀行口座に保存します。わかりました、しません。"}, {"type": "subtitle", "time": 11989.59, "timestamp": "03:19:49", "text": "使ってみて"}, {"type": "subtitle", "time": 11994.229, "timestamp": "03:19:54", "text": "必要な最低額に達するまで、それはn"}, {"type": "subtitle", "time": 11997.67, "timestamp": "03:19:57", "text": "設営には960ドル必要だと思う。"}]
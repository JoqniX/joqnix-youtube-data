[{"type": "subtitle", "time": 14580.87, "timestamp": "04:03:00", "text": "これを見るために？"}, {"type": "subtitle", "time": 14583.189, "timestamp": "04:03:03", "text": "あなたにもそれが分かると思うよ。しかし、"}, {"type": "subtitle", "time": 14586.309, "timestamp": "04:03:06", "text": "これらの地域について？"}, {"type": "subtitle", "time": 14591.03, "timestamp": "04:03:11", "text": "見えるはずですよね？"}, {"type": "subtitle", "time": 14597.59, "timestamp": "04:03:17", "text": "わかった。"}, {"type": "subtitle", "time": 14611.51, "timestamp": "04:03:31", "text": "これから。これは何ですか？何てことだ。それで"}, {"type": "subtitle", "time": 14615.03, "timestamp": "04:03:35", "text": "ラジオの設定画面に移動します。"}, {"type": "subtitle", "time": 14619.99, "timestamp": "04:03:39", "text": "モーションブラーをオフにしてください。こんにちは。理由がわからない"}, {"type": "subtitle", "time": 14623.51, "timestamp": "04:03:43", "text": "モーションブラーを使う人。わからない。私"}, {"type": "subtitle", "time": 14638.15, "timestamp": "04:03:58", "text": "右？"}]
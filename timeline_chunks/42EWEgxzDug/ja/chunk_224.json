[{"type": "subtitle", "time": 13440.55, "timestamp": "03:44:00", "text": "うん。今すぐやってください。もしあなたが"}, {"type": "subtitle", "time": 13443.67, "timestamp": "03:44:03", "text": "希望や何かを失った人、"}, {"type": "subtitle", "time": 13446.229, "timestamp": "03:44:06", "text": "やりたいことがあるのにできないこと、"}, {"type": "subtitle", "time": 13447.91, "timestamp": "03:44:07", "text": "後で使うために取っておきたい、または"}, {"type": "subtitle", "time": 13449.59, "timestamp": "03:44:09", "text": "ノートか何かを持ってきて、"}, {"type": "subtitle", "time": 13451.51, "timestamp": "03:44:11", "text": "ただ書き留めて、あなたの目標を書き出して、"}, {"type": "subtitle", "time": 13454.15, "timestamp": "03:44:14", "text": "やりたいことをやってみて、"}, {"type": "subtitle", "time": 13456.55, "timestamp": "03:44:16", "text": "その目標に向かって。わかった？"}, {"type": "subtitle", "time": 13458.55, "timestamp": "03:44:18", "text": "あなたがコンテンツクリエイターであろうと"}, {"type": "subtitle", "time": 13461.99, "timestamp": "03:44:21", "text": "ベストを尽くしたいと思ってデビューしました"}, {"type": "subtitle", "time": 13464.07, "timestamp": "03:44:24", "text": "あるいは、もしあなたがYouTuberなら、あなたの"}, {"type": "subtitle", "time": 13466.15, "timestamp": "03:44:26", "text": "VTuberの準備やデビュー"}, {"type": "subtitle", "time": 13469.11, "timestamp": "03:44:29", "text": "何か、その目標に向かって努力する"}, {"type": "subtitle", "time": 13471.99, "timestamp": "03:44:31", "text": "少し。あきらめないで。"}, {"type": "subtitle", "time": 13475.75, "timestamp": "03:44:35", "text": "そしてもしあなたが他の人と一緒なら"}, {"type": "subtitle", "time": 13478.79, "timestamp": "03:44:38", "text": "趣味とか音楽とか、"}, {"type": "subtitle", "time": 13482.07, "timestamp": "03:44:42", "text": "執筆、あなたがすること、どんなスキルでも"}, {"type": "subtitle", "time": 13484.71, "timestamp": "03:44:44", "text": "あなたが持っているか、まだそれに乗っているなら"}, {"type": "subtitle", "time": 13486.71, "timestamp": "03:44:46", "text": "私のような旅、自分の得意なことを見つける"}, {"type": "subtitle", "time": 13490.07, "timestamp": "03:44:50", "text": "私は何が得意なのか、"}, {"type": "subtitle", "time": 13494.07, "timestamp": "03:44:54", "text": "引き続き最善を尽くして探してくださいね。"}, {"type": "subtitle", "time": 13497.189, "timestamp": "03:44:57", "text": "やがてあなたは"}, {"type": "subtitle", "time": 13499.189, "timestamp": "03:44:59", "text": "スキルか何か本当に本当に"}]
[{"type": "subtitle", "time": 10637.429, "timestamp": "02:57:17", "text": "飲み物を買ってきました。私は手に入れた"}, {"type": "subtitle", "time": 10640.309, "timestamp": "02:57:20", "text": "何か食べるもの。 2パック購入しました"}, {"type": "subtitle", "time": 10641.91, "timestamp": "02:57:21", "text": "牛乳。"}, {"type": "subtitle", "time": 10644.469, "timestamp": "02:57:24", "text": "ええ、私は全く問題ありません。"}, {"type": "subtitle", "time": 10647.67, "timestamp": "02:57:27", "text": "私も薬をもらいました。"}, {"type": "subtitle", "time": 10651.349, "timestamp": "02:57:31", "text": "アレルギー用と"}, {"type": "subtitle", "time": 10655.51, "timestamp": "02:57:35", "text": "えーと、"}, {"type": "subtitle", "time": 10658.07, "timestamp": "02:57:38", "text": "それは何と呼ばれますか？"}, {"type": "subtitle", "time": 10660.07, "timestamp": "02:57:40", "text": "うん。アレルギー用と"}, {"type": "subtitle", "time": 10665.83, "timestamp": "02:57:45", "text": "一方はもう一方のためのもの。"}, {"type": "subtitle", "time": 10668.87, "timestamp": "02:57:48", "text": "もう一つは何だったっけ？"}, {"type": "subtitle", "time": 10670.71, "timestamp": "02:57:50", "text": "えっと"}, {"type": "subtitle", "time": 10673.91, "timestamp": "02:57:53", "text": "そう、ビタミンC。"}, {"type": "subtitle", "time": 10676.79, "timestamp": "02:57:56", "text": "ええ、ビタミンCでしたっけ？"}, {"type": "subtitle", "time": 10679.47, "timestamp": "02:57:59", "text": "はい。ビタミンCですね。"}]
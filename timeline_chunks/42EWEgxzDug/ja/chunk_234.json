[{"type": "subtitle", "time": 14040.95, "timestamp": "03:54:00", "text": "私のDiscordのTenjoによるビデオ"}, {"type": "subtitle", "time": 14042.95, "timestamp": "03:54:02", "text": "メディアチャンネル。だから、もしあなたが望むなら"}, {"type": "subtitle", "time": 14045.99, "timestamp": "03:54:05", "text": "そのビデオを見てください。 2月14日は"}, {"type": "subtitle", "time": 14048.15, "timestamp": "03:54:08", "text": "子供たちは2月を待つ。いいえ、11月"}, {"type": "subtitle", "time": 14052.229, "timestamp": "03:54:12", "text": "14日は子供の日ですよね？はい。"}, {"type": "subtitle", "time": 14056.63, "timestamp": "03:54:16", "text": "それで、話が逸れてしまいました。ということで今週は"}, {"type": "subtitle", "time": 14059.189, "timestamp": "03:54:19", "text": "今週と来週は"}, {"type": "subtitle", "time": 14061.429, "timestamp": "03:54:21", "text": "ホラーゲームみたいなことをやってるんだけど"}, {"type": "subtitle", "time": 14063.83, "timestamp": "03:54:23", "text": "スプークトーバー。そして皆さんがいくつか提案してくれました"}, {"type": "subtitle", "time": 14065.91, "timestamp": "03:54:25", "text": "ゲーム。ご提案いただいた皆様、ありがとうございました。"}, {"type": "subtitle", "time": 14070.229, "timestamp": "03:54:30", "text": "配信でプレイするゲーム。それで、今日は"}, {"type": "subtitle", "time": 14072.79, "timestamp": "03:54:32", "text": "スコーンを持って行きます、そして明日私たちは"}, {"type": "subtitle", "time": 14074.71, "timestamp": "03:54:34", "text": "明日に行くということは、次の"}, {"type": "subtitle", "time": 14077.349, "timestamp": "03:54:37", "text": "水曜日に配信されるストリームは"}, {"type": "subtitle", "time": 14080.07, "timestamp": "03:54:40", "text": "睡眠中に起こる。木曜日に私たちは"}, {"type": "subtitle", "time": 14083.51, "timestamp": "03:54:43", "text": "uh poy プレイタイムと"}, {"type": "subtitle", "time": 14087.51, "timestamp": "03:54:47", "text": "金曜日は今週最後の日になります"}, {"type": "subtitle", "time": 14092.469, "timestamp": "03:54:52", "text": "えーと、痛み。はい。"}, {"type": "subtitle", "time": 14095.189, "timestamp": "03:54:55", "text": "こんにちは。これが私がプレイした4つのゲームです"}, {"type": "subtitle", "time": 14099.91, "timestamp": "03:54:59", "text": "今週の選出作品。えっと"}]
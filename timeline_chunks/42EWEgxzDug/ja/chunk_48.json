[{"type": "subtitle", "time": 2881.109, "timestamp": "00:48:01", "text": "古いアカウント。 2 つのサブアカウントが"}, {"type": "subtitle", "time": 2885.91, "timestamp": "00:48:05", "text": "待って、君の一人を蹴飛ばす必要があるかもしれない"}, {"type": "subtitle", "time": 2887.51, "timestamp": "00:48:07", "text": "ちなみに、アカウント、sola、もしあなたが"}, {"type": "subtitle", "time": 2901.19, "timestamp": "00:48:21", "text": "うん。私はそのうちの1つをいただくことにします。"}, {"type": "subtitle", "time": 2902.71, "timestamp": "00:48:22", "text": "はい。"}, {"type": "subtitle", "time": 2909.43, "timestamp": "00:48:29", "text": "うん。うん。どのアカウントか教えてください"}, {"type": "subtitle", "time": 2912.79, "timestamp": "00:48:32", "text": "使っていますか、それとも、そこから出ることができますか？"}, {"type": "subtitle", "time": 2916.39, "timestamp": "00:48:36", "text": "あまり使わないアカウント"}, {"type": "subtitle", "time": 2921.109, "timestamp": "00:48:41", "text": "それも許可されていないから。それはルールに定められている。"}, {"type": "subtitle", "time": 2922.87, "timestamp": "00:48:42", "text": "最高だ。"}, {"type": "subtitle", "time": 2924.87, "timestamp": "00:48:44", "text": "1 つのアカウントでのみ参加する"}, {"type": "subtitle", "time": 2932.069, "timestamp": "00:48:52", "text": "例えば、"}, {"type": "subtitle", "time": 2934.47, "timestamp": "00:48:54", "text": "もしあなたが"}, {"type": "subtitle", "time": 2936.549, "timestamp": "00:48:56", "text": "メインのいずれかから参加する場合"}, {"type": "subtitle", "time": 2939.829, "timestamp": "00:48:59", "text": "アカウントをお持ちでない場合、"}]
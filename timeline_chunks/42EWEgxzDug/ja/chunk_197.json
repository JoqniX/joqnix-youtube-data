[{"type": "subtitle", "time": 11821.75, "timestamp": "03:17:01", "text": "将来的に。できるといいな。私"}, {"type": "subtitle", "time": 11824.469, "timestamp": "03:17:04", "text": "君たちにそれを目撃してほしい。同じ"}, {"type": "subtitle", "time": 11826.469, "timestamp": "03:17:06", "text": "それにも当てはまる。私が稼いだお金は"}, {"type": "subtitle", "time": 11828.55, "timestamp": "03:17:08", "text": "音楽から音楽へ"}, {"type": "subtitle", "time": 11832.389, "timestamp": "03:17:12", "text": "もの。それでおしまい。そして、現実世界の出来事。私は作った"}, {"type": "subtitle", "time": 11836.15, "timestamp": "03:17:16", "text": "プロとして、私は自分にルールを課しました"}, {"type": "subtitle", "time": 11839.67, "timestamp": "03:17:19", "text": "ストリーミングからのお金のようなものは使いません"}, {"type": "subtitle", "time": 11843.19, "timestamp": "03:17:23", "text": "または私の現実世界の個人的なもののための場所"}, {"type": "subtitle", "time": 11847.03, "timestamp": "03:17:27", "text": "だってそれは私の考えでは悪いことだから、私は"}, {"type": "subtitle", "time": 11849.91, "timestamp": "03:17:29", "text": "自分の血から精一杯働くために、"}, {"type": "subtitle", "time": 11854.71, "timestamp": "03:17:34", "text": "汗と涙を流して、お金を稼いで、そして"}, {"type": "subtitle", "time": 11857.51, "timestamp": "03:17:37", "text": "稼いだお金に満足していますし、"}, {"type": "subtitle", "time": 11861.83, "timestamp": "03:17:41", "text": "この世界で生き抜くこと。それは"}, {"type": "subtitle", "time": 11865.269, "timestamp": "03:17:45", "text": "私が本当に欲しいのは、本物のお金です。現実世界では"}, {"type": "subtitle", "time": 11867.19, "timestamp": "03:17:47", "text": "うん"}, {"type": "subtitle", "time": 11872.389, "timestamp": "03:17:52", "text": "そして、そう、そう、私はそうは思わない。"}, {"type": "subtitle", "time": 11874.469, "timestamp": "03:17:54", "text": "使わないルールは作らなかった"}, {"type": "subtitle", "time": 11876.389, "timestamp": "03:17:56", "text": "えーと、私が受け取る支援金は"}]
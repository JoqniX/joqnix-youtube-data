[{"type": "subtitle", "time": 12420.07, "timestamp": "03:27:00", "text": "私はすべてを解決したと信じています"}, {"type": "subtitle", "time": 12422.87, "timestamp": "03:27:02", "text": "ライフスタイルに慣れていて、"}, {"type": "subtitle", "time": 12426.309, "timestamp": "03:27:06", "text": "ノートパソコンを購入します。"}, {"type": "subtitle", "time": 12428.63, "timestamp": "03:27:08", "text": "あらゆることに耐えてきた"}, {"type": "subtitle", "time": 12431.349, "timestamp": "03:27:11", "text": "ええと、その他すべて。うん、ノートパソコンだから"}, {"type": "subtitle", "time": 12434.07, "timestamp": "03:27:14", "text": "ストリーミング配信も何でもできます。"}, {"type": "subtitle", "time": 12436.55, "timestamp": "03:27:16", "text": "ルームメイトがあまり怒っていないといいんだけど、"}, {"type": "subtitle", "time": 12438.229, "timestamp": "03:27:18", "text": "私は推測する。わからない。考えている"}, {"type": "subtitle", "time": 12440.79, "timestamp": "03:27:20", "text": "また。またもや先のことを考えている。私"}, {"type": "subtitle", "time": 12443.11, "timestamp": "03:27:23", "text": "わからない。うん、うん。えっと、"}, {"type": "subtitle", "time": 12446.63, "timestamp": "03:27:26", "text": "それは将来のドキュメントに任せましょう。私"}, {"type": "subtitle", "time": 12448.55, "timestamp": "03:27:28", "text": "将来のことを心配する必要はない"}, {"type": "subtitle", "time": 12451.429, "timestamp": "03:27:31", "text": "今すぐ。私が心配すべきことは"}, {"type": "subtitle", "time": 12455.19, "timestamp": "03:27:35", "text": "今の私にできること。右。"}, {"type": "subtitle", "time": 12457.349, "timestamp": "03:27:37", "text": "こんにちは。"}, {"type": "subtitle", "time": 12459.349, "timestamp": "03:27:39", "text": "はい、これがイベントのタイムラインです。"}, {"type": "subtitle", "time": 12461.91, "timestamp": "03:27:41", "text": "3月12日から6月まで。印をつけておきます"}, {"type": "subtitle", "time": 12469.83, "timestamp": "03:27:49", "text": "うん。"}, {"type": "subtitle", "time": 12472.55, "timestamp": "03:27:52", "text": "それで、"}, {"type": "subtitle", "time": 12476.309, "timestamp": "03:27:56", "text": "こんにちは。それで、このイベント中に私がお願いするのは"}, {"type": "subtitle", "time": 12479.03, "timestamp": "03:27:59", "text": "Twitch にいる場合、または"}]
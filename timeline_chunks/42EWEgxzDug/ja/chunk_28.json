[{"type": "subtitle", "time": 1695.11, "timestamp": "00:28:15", "text": "[音楽]"}, {"type": "subtitle", "time": 1709.11, "timestamp": "00:28:29", "text": "わかった。見た目もね。あ、待って。ガンランだ。"}, {"type": "subtitle", "time": 1712.95, "timestamp": "00:28:32", "text": "いいえ、私はその試合のチームだと思っていました。 O"}, {"type": "subtitle", "time": 1715.029, "timestamp": "00:28:35", "text": "いいえ"}, {"type": "subtitle", "time": 1722.87, "timestamp": "00:28:42", "text": "つまり、シャッフル再生のような感じになります。"}, {"type": "subtitle", "time": 1725.59, "timestamp": "00:28:45", "text": "えーと、私は"}, {"type": "subtitle", "time": 1731.269, "timestamp": "00:28:51", "text": "そして"}, {"type": "subtitle", "time": 1732.71, "timestamp": "00:28:52", "text": "いつでも切り替えます"}]
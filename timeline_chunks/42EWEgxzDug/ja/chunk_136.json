[{"type": "subtitle", "time": 8168.069, "timestamp": "02:16:08", "text": "うん。そして私は気づいた、私は作った"}, {"type": "subtitle", "time": 8170.87, "timestamp": "02:16:10", "text": "昨日のツイート"}, {"type": "subtitle", "time": 8173.51, "timestamp": "02:16:13", "text": "たぶん朝頃だと思う。つまり今日"}, {"type": "subtitle", "time": 8176.79, "timestamp": "02:16:16", "text": "朝、私は一晩中起きていた。ちょっと上向き"}, {"type": "subtitle", "time": 8181.35, "timestamp": "02:16:21", "text": "一晩中。私はイカゲーム3を見ました"}, {"type": "subtitle", "time": 8183.35, "timestamp": "02:16:23", "text": "道。"}, {"type": "subtitle", "time": 8186.39, "timestamp": "02:16:26", "text": "ええと、最近"}, {"type": "subtitle", "time": 8189.669, "timestamp": "02:16:29", "text": "私はアニメをいくつか見て、"}, {"type": "subtitle", "time": 8191.669, "timestamp": "02:16:31", "text": "もの。うん。試験期間中ずっと。"}, {"type": "subtitle", "time": 8201.429, "timestamp": "02:16:41", "text": "えっと"}, {"type": "subtitle", "time": 8212.389, "timestamp": "02:16:52", "text": "いろいろあったけど、それができるって気づいたんだ"}, {"type": "subtitle", "time": 8215.03, "timestamp": "02:16:55", "text": "時計単体として、"}, {"type": "subtitle", "time": 8217.669, "timestamp": "02:16:57", "text": "このコードに関わるすべての人と"}]
[{"type": "subtitle", "time": 3131.75, "timestamp": "00:52:11", "text": "ああ、だからか"}, {"type": "subtitle", "time": 3134.95, "timestamp": "00:52:14", "text": "そのため、ブラウザで開いた可能性があります。"}, {"type": "subtitle", "time": 3146.15, "timestamp": "00:52:26", "text": "[音楽]"}, {"type": "subtitle", "time": 3157.829, "timestamp": "00:52:37", "text": "ああ、彼はひどい目に遭った。うーん、すごい。"}, {"type": "subtitle", "time": 3160.549, "timestamp": "00:52:40", "text": "こんにちは、チャック。ええ、教えてください。私にさせて"}, {"type": "subtitle", "time": 3162.71, "timestamp": "00:52:42", "text": "どのアカウントを一番よく使っているか教えてください"}, {"type": "subtitle", "time": 3171.67, "timestamp": "00:52:51", "text": "例えば、あなたの携帯電話とか"}, {"type": "subtitle", "time": 3173.43, "timestamp": "00:52:53", "text": "電話には1つしか登録できないから"}, {"type": "subtitle", "time": 3175.349, "timestamp": "00:52:55", "text": "アカウントですよね？使用する必要があるかもしれません"}, {"type": "subtitle", "time": 3177.589, "timestamp": "00:52:57", "text": "もっと、えーと、使う必要があるかもしれない"}, {"type": "subtitle", "time": 3179.589, "timestamp": "00:52:59", "text": "違う"}]
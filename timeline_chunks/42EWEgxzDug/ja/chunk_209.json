[{"type": "subtitle", "time": 12541.91, "timestamp": "03:29:01", "text": "うん。そして、ええと、ジョッカソンの最中に"}, {"type": "subtitle", "time": 12544.71, "timestamp": "03:29:04", "text": "私は現実世界での職務を遂行します"}, {"type": "subtitle", "time": 12547.03, "timestamp": "03:29:07", "text": "つまり、授業とかその他諸々のことです。良い"}, {"type": "subtitle", "time": 12549.91, "timestamp": "03:29:09", "text": "v を実行してください。タイマーを停止します"}, {"type": "subtitle", "time": 12552.63, "timestamp": "03:29:12", "text": "そして全て。私は持っていません"}, {"type": "subtitle", "time": 12554.55, "timestamp": "03:29:14", "text": "ウィジェットを購入しました。サブオンがあります"}, {"type": "subtitle", "time": 12558.63, "timestamp": "03:29:18", "text": "ウィジェットを買いたかったのですが、"}, {"type": "subtitle", "time": 12561.349, "timestamp": "03:29:21", "text": "できるだけお金を貯めた方がいいんじゃない？"}, {"type": "subtitle", "time": 12565.349, "timestamp": "03:29:25", "text": "私にできる範囲で、ですよね？私は投資できることを知っています"}, {"type": "subtitle", "time": 12567.91, "timestamp": "03:29:27", "text": "ストリームと適切なものを置く"}, {"type": "subtitle", "time": 12570.71, "timestamp": "03:29:30", "text": "このサブマラソン用のウィジェットやその他"}, {"type": "subtitle", "time": 12573.51, "timestamp": "03:29:33", "text": "このジョアソンの話だけど"}, {"type": "subtitle", "time": 12576.15, "timestamp": "03:29:36", "text": "うん、痛いよ"}, {"type": "subtitle", "time": 12579.91, "timestamp": "03:29:39", "text": "これはメガトンです。本当に欲しかったんです"}, {"type": "subtitle", "time": 12584.15, "timestamp": "03:29:44", "text": "えーと、ラニとかいう人によって、私が"}, {"type": "subtitle", "time": 12586.71, "timestamp": "03:29:46", "text": "YouTube で見たし、Twitch も使ってるよ"}, {"type": "subtitle", "time": 12589.75, "timestamp": "03:29:49", "text": "サブワンズについては、私も"}, {"type": "subtitle", "time": 12592.15, "timestamp": "03:29:52", "text": "使うはずだったけど、実際には"}, {"type": "subtitle", "time": 12595.269, "timestamp": "03:29:55", "text": "気づいたよ、うん、もっと大きなチャンネル"}, {"type": "subtitle", "time": 12597.75, "timestamp": "03:29:57", "text": "数字が大きいほど大きい一方、私は"}]
[{"type": "subtitle", "time": 11760.95, "timestamp": "03:16:00", "text": "ジョアソンやそれに類するものを引き続き行う"}, {"type": "subtitle", "time": 11765.19, "timestamp": "03:16:05", "text": "寄付型のイベントは"}, {"type": "subtitle", "time": 11768.15, "timestamp": "03:16:08", "text": "えっと、私は"}, {"type": "subtitle", "time": 11771.269, "timestamp": "03:16:11", "text": "そう、何をするにもお金が必要なんだ。はぁ。その"}, {"type": "subtitle", "time": 11776.309, "timestamp": "03:16:16", "text": "悲しい現実だが、それが現実だ。"}, {"type": "subtitle", "time": 11778.87, "timestamp": "03:16:18", "text": "しかし問題は、自分の"}, {"type": "subtitle", "time": 11782.07, "timestamp": "03:16:22", "text": "性格と、私がどれだけ頑固かを知っている"}, {"type": "subtitle", "time": 11786.87, "timestamp": "03:16:26", "text": "午前。正直に言うと、"}, {"type": "subtitle", "time": 11789.11, "timestamp": "03:16:29", "text": "いいね、ヘルプ、いいね、コミュニティ"}, {"type": "subtitle", "time": 11793.349, "timestamp": "03:16:33", "text": "資金援助はこんな感じだった。私はこう思った"}, {"type": "subtitle", "time": 11795.429, "timestamp": "03:16:35", "text": "私は心配するでしょう"}, {"type": "subtitle", "time": 11798.389, "timestamp": "03:16:38", "text": "将来は何とかやっていけるだろう。でも私は"}, {"type": "subtitle", "time": 11801.67, "timestamp": "03:16:41", "text": "自分自身にルールを課した。わかった。"}, {"type": "subtitle", "time": 11804.95, "timestamp": "03:16:44", "text": "オンラインで稼いだお金は、"}, {"type": "subtitle", "time": 11807.51, "timestamp": "03:16:47", "text": "vtubeing、それは"}, {"type": "subtitle", "time": 11809.99, "timestamp": "03:16:49", "text": "vtubeingは進歩か何か"}, {"type": "subtitle", "time": 11812.87, "timestamp": "03:16:52", "text": "より良いものを手に入れるために。"}, {"type": "subtitle", "time": 11816.07, "timestamp": "03:16:56", "text": "そして、それは音楽にも当てはまります。"}, {"type": "subtitle", "time": 11818.55, "timestamp": "03:16:58", "text": "実際に集中すると、私の音楽キャリアは"}]
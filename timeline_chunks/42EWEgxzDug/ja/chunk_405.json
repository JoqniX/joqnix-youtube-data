[{"type": "subtitle", "time": 24311.75, "timestamp": "06:45:11", "text": "今回は勝てると思ったのに。待って、あなたは"}, {"type": "subtitle", "time": 24315.91, "timestamp": "06:45:15", "text": "インド人でもある？さあ行こう。"}, {"type": "subtitle", "time": 24317.55, "timestamp": "06:45:17", "text": "ニース。"}, {"type": "subtitle", "time": 24319.11, "timestamp": "06:45:19", "text": "[音楽]"}, {"type": "subtitle", "time": 24331.35, "timestamp": "06:45:31", "text": "よし、これが最後だ"}, {"type": "subtitle", "time": 24333.83, "timestamp": "06:45:33", "text": "そしてカットシーンが始まり、"}, {"type": "subtitle", "time": 24340.788, "timestamp": "06:45:40", "text": "ああ、"}, {"type": "subtitle", "time": 24344.15, "timestamp": "06:45:44", "text": "またこれをやるんだ。期待しよう"}, {"type": "subtitle", "time": 24346.708, "timestamp": "06:45:46", "text": "ゲームがクラッシュしたり、PCが"}, {"type": "subtitle", "time": 24348.23, "timestamp": "06:45:48", "text": "クラッシュ"}, {"type": "subtitle", "time": 24350.948, "timestamp": "06:45:50", "text": "この時"}]
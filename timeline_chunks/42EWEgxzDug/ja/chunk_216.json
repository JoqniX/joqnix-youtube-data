[{"type": "subtitle", "time": 12962.71, "timestamp": "03:36:02", "text": "まあ、私はもう大人だと思うけど。"}, {"type": "subtitle", "time": 12964.389, "timestamp": "03:36:04", "text": "えっと"}, {"type": "subtitle", "time": 12968.15, "timestamp": "03:36:08", "text": "わからない。わからない。うん。しかし"}, {"type": "subtitle", "time": 12971.99, "timestamp": "03:36:11", "text": "大人なのに子供っぽい心を持っている、ということだろうか。私"}, {"type": "subtitle", "time": 12979.03, "timestamp": "03:36:19", "text": "まあ、そうですね。"}, {"type": "subtitle", "time": 12982.309, "timestamp": "03:36:22", "text": "でも、ヒントを一つだけ明かすとすれば、"}, {"type": "subtitle", "time": 12985.91, "timestamp": "03:36:25", "text": "モデルに関するヒント。モデルは"}, {"type": "subtitle", "time": 12988.95, "timestamp": "03:36:28", "text": "今の自分を描写する"}, {"type": "subtitle", "time": 12991.99, "timestamp": "03:36:31", "text": "それは私です。また、多くのことを描写しています"}, {"type": "subtitle", "time": 12994.15, "timestamp": "03:36:34", "text": "秘密のもの"}, {"type": "subtitle", "time": 12997.51, "timestamp": "03:36:37", "text": "そしてそれは私の独特な特徴を描写しています"}, {"type": "subtitle", "time": 12999.19, "timestamp": "03:36:39", "text": "これは私の声ですよね、とても"}, {"type": "subtitle", "time": 13002.07, "timestamp": "03:36:42", "text": "多くの人にとって混乱を招くものであり、私ができるヒントは"}, {"type": "subtitle", "time": 13003.83, "timestamp": "03:36:43", "text": "あなたに与えるのは、その外観が"}, {"type": "subtitle", "time": 13011.349, "timestamp": "03:36:51", "text": "でも、できるだけたくさん稼いで"}, {"type": "subtitle", "time": 13014.87, "timestamp": "03:36:54", "text": "ブレインストーミングやファンフィクションなど、あなたが思うことを何でも"}, {"type": "subtitle", "time": 13016.79, "timestamp": "03:36:56", "text": "それはまだ概念かもしれない"}]
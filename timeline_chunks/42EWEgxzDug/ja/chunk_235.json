[{"type": "subtitle", "time": 14102.63, "timestamp": "03:55:02", "text": "はい、来週の提案は"}, {"type": "subtitle", "time": 14104.55, "timestamp": "03:55:04", "text": "ご意見・ご提案は引き続き受け付けております。あなたはできる"}, {"type": "subtitle", "time": 14108.79, "timestamp": "03:55:08", "text": "TwitterやFacebookで提案してみて"}, {"type": "subtitle", "time": 14111.349, "timestamp": "03:55:11", "text": "えっと、インスタグラム。その話がもう消えていることを願います。"}, {"type": "subtitle", "time": 14114.15, "timestamp": "03:55:14", "text": "ええ、残念ながら。でも、うん、できるよ"}, {"type": "subtitle", "time": 14116.87, "timestamp": "03:55:16", "text": "何かゲームを提案してください、またはDiscordで"}, {"type": "subtitle", "time": 14119.83, "timestamp": "03:55:19", "text": "サーバーも必要であれば、私に何かしてほしい"}, {"type": "subtitle", "time": 14122.309, "timestamp": "03:55:22", "text": "ホラーゲームをプレイする。もしあなたが"}, {"type": "subtitle", "time": 14124.87, "timestamp": "03:55:24", "text": "提案されたゲームはプレイされません"}, {"type": "subtitle", "time": 14128.07, "timestamp": "03:55:28", "text": "来週、私はそれらを選びます"}, {"type": "subtitle", "time": 14131.429, "timestamp": "03:55:31", "text": "えーと、未来のホラー配信みたいな感じ。それで"}, {"type": "subtitle", "time": 14134.71, "timestamp": "03:55:34", "text": "それは私がどの"}, {"type": "subtitle", "time": 14137.99, "timestamp": "03:55:37", "text": "私がプレイすべきゲームや好きなもの。こんにちは。"}, {"type": "subtitle", "time": 14140.63, "timestamp": "03:55:40", "text": "誰でも？君たちに言ったと思うけど、"}, {"type": "subtitle", "time": 14143.11, "timestamp": "03:55:43", "text": "何分ですか？あ、待って。たった10"}, {"type": "subtitle", "time": 14147.189, "timestamp": "03:55:47", "text": "分。あ、待って。大丈夫です。わかった。"}, {"type": "subtitle", "time": 14154.71, "timestamp": "03:55:54", "text": "もっと。それで、皆さんはどうですか？"}, {"type": "subtitle", "time": 14156.71, "timestamp": "03:55:56", "text": "何をやっていたのですか？"}, {"type": "subtitle", "time": 14159.91, "timestamp": "03:55:59", "text": "皆さん、お元気でしたか？"}]
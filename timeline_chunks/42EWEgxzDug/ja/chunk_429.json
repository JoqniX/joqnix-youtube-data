[{"type": "subtitle", "time": 25742.31, "timestamp": "07:09:02", "text": "ええ、さっきも言ったように、私は観ました"}, {"type": "subtitle", "time": 25745.35, "timestamp": "07:09:05", "text": "ゲーマー第一"}, {"type": "subtitle", "time": 25750.23, "timestamp": "07:09:10", "text": "YouTubeで、それからダンまちを見ました。"}, {"type": "subtitle", "time": 25754.31, "timestamp": "07:09:14", "text": "YouTubeでダンまちが2位。第二に、"}, {"type": "subtitle", "time": 25756.23, "timestamp": "07:09:16", "text": "2番目に観たアニメはダンジョンに出会いを求めるのは間違っているだろうか（ダンまち）でした。それから私は"}, {"type": "subtitle", "time": 25758.788, "timestamp": "07:09:18", "text": "そうだな、そうだよね？それから私は"}, {"type": "subtitle", "time": 25762.07, "timestamp": "07:09:22", "text": "アニメを見ますか？"}, {"type": "subtitle", "time": 25768.23, "timestamp": "07:09:28", "text": "それは何と呼ばれますか？それから私は見る"}, {"type": "subtitle", "time": 25770.548, "timestamp": "07:09:30", "text": "アニメは別のウェブサイトから、または"}, {"type": "subtitle", "time": 25772.548, "timestamp": "07:09:32", "text": "何か。それから私はダーリンを観ました"}, {"type": "subtitle", "time": 25774.868, "timestamp": "07:09:34", "text": "フランクとか、そういう類のもの。それは"}, {"type": "subtitle", "time": 25778.548, "timestamp": "07:09:38", "text": "私のアニメの旅は偶然始まった"}, {"type": "subtitle", "time": 25781.67, "timestamp": "07:09:41", "text": "YouTubeとかで見つけた。"}]
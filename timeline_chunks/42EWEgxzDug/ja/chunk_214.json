[{"type": "subtitle", "time": 12840.389, "timestamp": "03:34:00", "text": "あと2分か、あと3分。"}, {"type": "subtitle", "time": 12842.389, "timestamp": "03:34:02", "text": "こんにちは。"}, {"type": "subtitle", "time": 12844.95, "timestamp": "03:34:04", "text": "簡単に言うと、私はジョアソンに参加しています"}, {"type": "subtitle", "time": 12848.55, "timestamp": "03:34:08", "text": "Vubのデビューとモデルに資金を提供するためだけに"}, {"type": "subtitle", "time": 12852.07, "timestamp": "03:34:12", "text": "そして、私たちが稼いだものは何でも、もし可能であれば"}, {"type": "subtitle", "time": 12855.429, "timestamp": "03:34:15", "text": "この目標を達成するには、最低限"}, {"type": "subtitle", "time": 12858.63, "timestamp": "03:34:18", "text": "えーと、リギングには960です"}, {"type": "subtitle", "time": 12860.71, "timestamp": "03:34:20", "text": "ええと、リギング用です。"}, {"type": "subtitle", "time": 12862.63, "timestamp": "03:34:22", "text": "えっと、"}, {"type": "subtitle", "time": 12864.71, "timestamp": "03:34:24", "text": "これを手に入れれば、私は"}, {"type": "subtitle", "time": 12869.11, "timestamp": "03:34:29", "text": "リギングと"}, {"type": "subtitle", "time": 12871.03, "timestamp": "03:34:31", "text": "ええ、残りのお金は"}, {"type": "subtitle", "time": 12874.15, "timestamp": "03:34:34", "text": "デビュー作として。えっと、やらなきゃいけないのは"}, {"type": "subtitle", "time": 12876.07, "timestamp": "03:34:36", "text": "大規模なバンド再編ですよね？私は"}, {"type": "subtitle", "time": 12879.83, "timestamp": "03:34:39", "text": "残念ながら、今のスポーツマンの話題は"}, {"type": "subtitle", "time": 12881.99, "timestamp": "03:34:41", "text": "ハイエンドモデル。よし、高級品だ"}, {"type": "subtitle", "time": 12884.469, "timestamp": "03:34:44", "text": "より高いグレード。私はプロらしく振る舞わなければならない"}, {"type": "subtitle", "time": 12887.91, "timestamp": "03:34:47", "text": "これでベストを尽くせる"}, {"type": "subtitle", "time": 12891.67, "timestamp": "03:34:51", "text": "プロのクリエイターとして。"}, {"type": "subtitle", "time": 12895.59, "timestamp": "03:34:55", "text": "私はその目の位置に到達しなければならない。"}, {"type": "subtitle", "time": 12898.309, "timestamp": "03:34:58", "text": "そうですね、ベストを尽くしましょう。はい、私は"}]
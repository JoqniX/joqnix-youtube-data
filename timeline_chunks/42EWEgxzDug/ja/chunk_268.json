[{"type": "subtitle", "time": 16091.03, "timestamp": "04:28:11", "text": "それがうまくいかない場合は、おそらく"}, {"type": "subtitle", "time": 16094.309, "timestamp": "04:28:14", "text": "我々はこうしなければならないかもしれない"}, {"type": "subtitle", "time": 16097.59, "timestamp": "04:28:17", "text": "あ、ちょっと待って。これは"}, {"type": "subtitle", "time": 16099.75, "timestamp": "04:28:19", "text": "そうそう。ここは私が戻ってきた場所です"}, {"type": "subtitle", "time": 16101.59, "timestamp": "04:28:21", "text": "から。"}, {"type": "subtitle", "time": 16111.349, "timestamp": "04:28:31", "text": "こちらにも何もありません。"}, {"type": "subtitle", "time": 16114.55, "timestamp": "04:28:34", "text": "私たちはこれらのものをチェックしましたが、私は"}, {"type": "subtitle", "time": 16119.11, "timestamp": "04:28:39", "text": "私の頭では理解できない。え、何？"}, {"type": "chat", "time": 16119.736, "timestamp": "04:28:39", "author": "@iyainigyo", "avatar": "https://yt4.ggpht.com/lahuqPu3tmzKO9E7SD-fI_Z55zB1kM9iyRpGf1uMepScHkOi1mGLTTwmDOQuvj049wTXnNSg=s64-c-k-c0x00ffffff-no-rj", "message": "konbanwa"}, {"type": "chat", "time": 16121.495, "timestamp": "04:28:41", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Shhh... notevenmid, Joq is resting. 🌙 Welcome to the Guild, and enjoy the past joq's memories!"}, {"type": "subtitle", "time": 16127.269, "timestamp": "04:28:47", "text": "[音楽]"}, {"type": "subtitle", "time": 16130.389, "timestamp": "04:28:50", "text": "ああ、ここは初めてだと思います。"}, {"type": "subtitle", "time": 16132.81, "timestamp": "04:28:52", "text": "この領域においてはまだ。"}]
[{"type": "subtitle", "time": 23353.35, "timestamp": "06:29:13", "text": "そこでアキャビは、ノコギリを使うことで"}, {"type": "subtitle", "time": 23355.67, "timestamp": "06:29:15", "text": "保存しました。右。"}, {"type": "subtitle", "time": 23358.548, "timestamp": "06:29:18", "text": "だから私は信じています"}, {"type": "subtitle", "time": 23361.03, "timestamp": "06:29:21", "text": "だから私はあなたを信じたいし、"}, {"type": "subtitle", "time": 23371.03, "timestamp": "06:29:31", "text": "希望"}, {"type": "subtitle", "time": 23391.19, "timestamp": "06:29:51", "text": "[音楽]"}, {"type": "subtitle", "time": 23399.19, "timestamp": "06:29:59", "text": "ああ、彼はこっちを向くでしょう。わかった。"}]
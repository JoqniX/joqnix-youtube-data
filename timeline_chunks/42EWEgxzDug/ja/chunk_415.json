[{"type": "subtitle", "time": 24906.15, "timestamp": "06:55:06", "text": "聖なる。"}, {"type": "subtitle", "time": 24909.35, "timestamp": "06:55:09", "text": "だから、私たちは一人ではない。"}, {"type": "subtitle", "time": 24911.27, "timestamp": "06:55:11", "text": "残念ながら、"}, {"type": "subtitle", "time": 24913.83, "timestamp": "06:55:13", "text": "あなたは一人ではありません。"}, {"type": "subtitle", "time": 24939.27, "timestamp": "06:55:39", "text": "これは何ですか？せめて武器はもらえるのか？"}, {"type": "subtitle", "time": 24942.4, "timestamp": "06:55:42", "text": "自分を守るため？"}, {"type": "subtitle", "time": 24947.35, "timestamp": "06:55:47", "text": "[音楽]"}, {"type": "subtitle", "time": 24949.25, "timestamp": "06:55:49", "text": "あの音は何だったのか？"}, {"type": "subtitle", "time": 24954.548, "timestamp": "06:55:54", "text": "ああ、あれはファンだった。それは"}, {"type": "subtitle", "time": 24957.32, "timestamp": "06:55:57", "text": "スライムか何か。何てことだ。"}]
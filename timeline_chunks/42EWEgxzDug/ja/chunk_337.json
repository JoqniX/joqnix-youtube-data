[{"type": "subtitle", "time": 20237.8, "timestamp": "05:37:17", "text": "それはつまり、1人減ったということだと思います。"}, {"type": "subtitle", "time": 20244.07, "timestamp": "05:37:24", "text": "[音楽]"}, {"type": "subtitle", "time": 20247.43, "timestamp": "05:37:27", "text": "何てことだ、"}, {"type": "subtitle", "time": 20250.62, "timestamp": "05:37:30", "text": "私の心臓の鼓動。"}, {"type": "subtitle", "time": 20252.31, "timestamp": "05:37:32", "text": "[音楽]"}, {"type": "subtitle", "time": 20255.03, "timestamp": "05:37:35", "text": "よし、一人減った。神よ、これは"}]
[{"type": "subtitle", "time": 14640.63, "timestamp": "04:04:00", "text": "ああ、視野角は変更できますよ。え、何？"}, {"type": "subtitle", "time": 14643.429, "timestamp": "04:04:03", "text": "ええと、図解的に。わかった。いいえ。では、私はプレイします。"}, {"type": "subtitle", "time": 14644.94, "timestamp": "04:04:04", "text": "これで。"}, {"type": "subtitle", "time": 14653.189, "timestamp": "04:04:13", "text": "わかった。良い。主導権を握れ。"}, {"type": "subtitle", "time": 14656.87, "timestamp": "04:04:16", "text": "ええ、そうですね。こんにちは、アカヴィさん。"}, {"type": "subtitle", "time": 14666.07, "timestamp": "04:04:26", "text": "あ、待って。左クリックを使用します。"}, {"type": "subtitle", "time": 14673.99, "timestamp": "04:04:33", "text": "それは変えられない。待って、待って、待って。私"}, {"type": "subtitle", "time": 14677.51, "timestamp": "04:04:37", "text": "使用ボタンを変更する必要があったんですよね？"}, {"type": "subtitle", "time": 14680.309, "timestamp": "04:04:40", "text": "スイッチはEです。何ですか？"}, {"type": "subtitle", "time": 14683.11, "timestamp": "04:04:43", "text": "ヒールはEです。"}, {"type": "subtitle", "time": 14685.03, "timestamp": "04:04:45", "text": "あのね？ Qに変更して"}, {"type": "subtitle", "time": 14689.51, "timestamp": "04:04:49", "text": "使用方法はEになります。了解です。"}]
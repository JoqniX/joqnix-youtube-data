[{"type": "subtitle", "time": 11221.19, "timestamp": "03:07:01", "text": "さて、ここでの私の重要な点に戻りますが、"}, {"type": "subtitle", "time": 11224.95, "timestamp": "03:07:04", "text": "これが重要なポイントです。"}, {"type": "subtitle", "time": 11229.91, "timestamp": "03:07:09", "text": "私は自分がこんな目に遭う資格がないことは分かっています。"}, {"type": "subtitle", "time": 11232.63, "timestamp": "03:07:12", "text": "繰り返しますが、私は私の偽物から話しています"}, {"type": "subtitle", "time": 11235.59, "timestamp": "03:07:15", "text": "症候群、ジョークモード、でもそうだ、私は"}, {"type": "subtitle", "time": 11238.63, "timestamp": "03:07:18", "text": "自分が偽物症候群に悩まされているのは分かっています。"}, {"type": "subtitle", "time": 11240.79, "timestamp": "03:07:20", "text": "それが理由です"}, {"type": "subtitle", "time": 11243.75, "timestamp": "03:07:23", "text": "自分の目で確かめたい。わかった。それ"}, {"type": "subtitle", "time": 11248.71, "timestamp": "03:07:28", "text": "私がそれに値するかどうかは別として。これらすべてが新しい"}, {"type": "subtitle", "time": 11251.51, "timestamp": "03:07:31", "text": "運動選手"}, {"type": "subtitle", "time": 11255.19, "timestamp": "03:07:35", "text": "失敗してほしくない。わかった。"}, {"type": "subtitle", "time": 11257.99, "timestamp": "03:07:37", "text": "この5年間、あるいは4年間の私の"}, {"type": "subtitle", "time": 11261.59, "timestamp": "03:07:41", "text": "私は多くの点で失敗したと思う。"}, {"type": "subtitle", "time": 11264.63, "timestamp": "03:07:44", "text": "私はできなかった"}, {"type": "subtitle", "time": 11268.87, "timestamp": "03:07:48", "text": "私はそれほど一生懸命働いたとは思わない。"}, {"type": "subtitle", "time": 11271.429, "timestamp": "03:07:51", "text": "そしていつも自分がしたことを考えると"}, {"type": "subtitle", "time": 11273.91, "timestamp": "03:07:53", "text": "この4、5年間ずっと悲しい"}, {"type": "subtitle", "time": 11276.469, "timestamp": "03:07:56", "text": "それ"}]
[{"type": "subtitle", "time": 24542.31, "timestamp": "06:49:02", "text": "墜落しないでください。墜落しないでください。墜落しないでください。"}, {"type": "subtitle", "time": 24549.83, "timestamp": "06:49:09", "text": "うん。私はまっすぐこちらへ歩いて行った"}, {"type": "subtitle", "time": 24569.51, "timestamp": "06:49:29", "text": "たくさんある"}, {"type": "subtitle", "time": 24582.868, "timestamp": "06:49:42", "text": "このアーチみたいなのは何ですか？"}, {"type": "subtitle", "time": 24595.19, "timestamp": "06:49:55", "text": "もし骸骨が目を覚まして"}, {"type": "subtitle", "time": 24598.39, "timestamp": "06:49:58", "text": "ああ神様、私は本当に考えたくない"}]
[{"type": "subtitle", "time": 13203.349, "timestamp": "03:40:03", "text": "私の非現実的な夢ですが、私は"}, {"type": "subtitle", "time": 13207.11, "timestamp": "03:40:07", "text": "私はVTubingを"}, {"type": "subtitle", "time": 13211.03, "timestamp": "03:40:11", "text": "より高いレベルを目指す。知っている"}, {"type": "subtitle", "time": 13213.59, "timestamp": "03:40:13", "text": "難しいですね。私はそのために戦うつもりだ"}, {"type": "subtitle", "time": 13217.349, "timestamp": "03:40:17", "text": "夢。私は物事を実現させたい。"}, {"type": "subtitle", "time": 13219.19, "timestamp": "03:40:19", "text": "それが私が行く理由でもある"}, {"type": "subtitle", "time": 13222.63, "timestamp": "03:40:22", "text": "私たちが結んでいた国は"}, {"type": "subtitle", "time": 13225.99, "timestamp": "03:40:25", "text": "始まって、すべて完了したんですよね？キスして"}, {"type": "subtitle", "time": 13231.59, "timestamp": "03:40:31", "text": "私は、"}, {"type": "subtitle", "time": 13233.51, "timestamp": "03:40:33", "text": "このビーチのウサギの穴から彼らは皆"}, {"type": "subtitle", "time": 13236.389, "timestamp": "03:40:36", "text": "日本から始まった。"}, {"type": "subtitle", "time": 13239.91, "timestamp": "03:40:39", "text": "知っている。馬鹿げているのは分かっています。"}, {"type": "subtitle", "time": 13247.51, "timestamp": "03:40:47", "text": "でも、私にはできると信じています。もし"}, {"type": "subtitle", "time": 13249.91, "timestamp": "03:40:49", "text": "意志さえあれば、必ず道は開ける。それが"}, {"type": "subtitle", "time": 13252.469, "timestamp": "03:40:52", "text": "私はいつも自分にこう言い聞かせている。"}, {"type": "subtitle", "time": 13256.229, "timestamp": "03:40:56", "text": "こんにちは。私の話を聞いてくれてありがとう"}]
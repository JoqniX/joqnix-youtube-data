[{"type": "subtitle", "time": 25801.35, "timestamp": "07:10:01", "text": "[音楽]"}, {"type": "subtitle", "time": 25803.91, "timestamp": "07:10:03", "text": "だから私たちは"}, {"type": "subtitle", "time": 25810.948, "timestamp": "07:10:10", "text": "それは難しい。そうです。迷子になることはありません"}, {"type": "subtitle", "time": 25814.29, "timestamp": "07:10:14", "text": "これこそが、痛みである。"}, {"type": "subtitle", "time": 25824.07, "timestamp": "07:10:24", "text": "何？"}, {"type": "subtitle", "time": 25845.59, "timestamp": "07:10:45", "text": "そろそろ行った方がいいと思う。しかし、私には言わなかった"}, {"type": "subtitle", "time": 25848.468, "timestamp": "07:10:48", "text": "私も同じものを選びました。"}, {"type": "subtitle", "time": 25851.51, "timestamp": "07:10:51", "text": "私も同じものを選んだんですよね？"}, {"type": "subtitle", "time": 25855.35, "timestamp": "07:10:55", "text": "またミスをしてしまったんですよね？"}, {"type": "subtitle", "time": 25856.628, "timestamp": "07:10:56", "text": "[音楽]"}]
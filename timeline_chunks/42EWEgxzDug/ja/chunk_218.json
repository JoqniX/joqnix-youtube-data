[{"type": "subtitle", "time": 13081.75, "timestamp": "03:38:01", "text": "そのモデル、特にアーティスト"}, {"type": "subtitle", "time": 13083.19, "timestamp": "03:38:03", "text": "すべて。誰が"}, {"type": "subtitle", "time": 13086.309, "timestamp": "03:38:06", "text": "アーティスト本人、もしくは現在その作品に関わっている人物。"}, {"type": "subtitle", "time": 13089.99, "timestamp": "03:38:09", "text": "しかしデビューが実現すれば、"}, {"type": "subtitle", "time": 13095.75, "timestamp": "03:38:15", "text": "あなたにしか言えません。バ。"}, {"type": "subtitle", "time": 13097.67, "timestamp": "03:38:17", "text": "こんにちは。"}, {"type": "subtitle", "time": 13100.79, "timestamp": "03:38:20", "text": "命令に関するジョークを聞きました。つまり、あなたは"}, {"type": "subtitle", "time": 13103.99, "timestamp": "03:38:23", "text": "そんな風に想像できるよ。私"}, {"type": "subtitle", "time": 13106.389, "timestamp": "03:38:26", "text": "わからない。"}, {"type": "subtitle", "time": 13109.269, "timestamp": "03:38:29", "text": "私は好きになれない"}, {"type": "chat", "time": 13111.836, "timestamp": "03:38:31", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Shhh... ζ͜͡𝕲𝖍𝖔𝖘𝖙 𔓎, Joq is resting. 🌙 Welcome to the Guild, and enjoy the past joq's memories!"}, {"type": "subtitle", "time": 13113.19, "timestamp": "03:38:33", "text": "ジョックには特定の性別はありません"}, {"type": "subtitle", "time": 13116.87, "timestamp": "03:38:36", "text": "あるいは何でも。いいえ、今はAndroidです。"}, {"type": "subtitle", "time": 13120.229, "timestamp": "03:38:40", "text": "たぶん、私の声と同じようなものですね。"}, {"type": "subtitle", "time": 13123.429, "timestamp": "03:38:43", "text": "だから、私はあなたが望むどんな人物にもなれる。"}, {"type": "subtitle", "time": 13125.349, "timestamp": "03:38:45", "text": "例えば、私を彼または彼女と呼ぶことができます"}, {"type": "subtitle", "time": 13132.229, "timestamp": "03:38:52", "text": "つまり、私が思い描いていた通りのものだ。"}, {"type": "subtitle", "time": 13135.19, "timestamp": "03:38:55", "text": "仕事内容とその他すべて。"}, {"type": "subtitle", "time": 13138.469, "timestamp": "03:38:58", "text": "こんにちは。でも、すべてがうまくいくことを願おう"}]
[{"type": "subtitle", "time": 3962.63, "timestamp": "01:06:02", "text": "待って、5〜6 7 8 9 10 5時間の睡眠。"}, {"type": "subtitle", "time": 3966.549, "timestamp": "01:06:06", "text": "それだけでは不十分だ。何てことだ。"}, {"type": "subtitle", "time": 3969.829, "timestamp": "01:06:09", "text": "ええ、朝食を食べていない日もあります。私"}, {"type": "subtitle", "time": 3973.029, "timestamp": "01:06:13", "text": "今起きたばかりです。私は、えーと"}, {"type": "subtitle", "time": 3975.99, "timestamp": "01:06:15", "text": "配信を1時間遅延させます。"}, {"type": "subtitle", "time": 3979.99, "timestamp": "01:06:19", "text": "私もそのメッセージをピン留めしていました。"}, {"type": "subtitle", "time": 3982.63, "timestamp": "01:06:22", "text": "いや、でも大丈夫だと思ったんです。病気"}, {"type": "subtitle", "time": 3985.75, "timestamp": "01:06:25", "text": "一緒に朝食を食べよう"}, {"type": "subtitle", "time": 3988.23, "timestamp": "01:06:28", "text": "みんな。"}, {"type": "subtitle", "time": 3992.15, "timestamp": "01:06:32", "text": "だから大丈夫だよ。だから何"}, {"type": "subtitle", "time": 3997.349, "timestamp": "01:06:37", "text": "やったよ。"}, {"type": "subtitle", "time": 3999.349, "timestamp": "01:06:39", "text": "今日はApexをプレイします"}, {"type": "subtitle", "time": 4002.549, "timestamp": "01:06:42", "text": "伝説。ええと、どうやらそれが新しい"}, {"type": "subtitle", "time": 4008.23, "timestamp": "01:06:48", "text": "ハロウィン、えーと、悪夢。それは、えーと"}, {"type": "subtitle", "time": 4011.91, "timestamp": "01:06:51", "text": "起こっていることと、ええと、Apex"}, {"type": "subtitle", "time": 4015.589, "timestamp": "01:06:55", "text": "また、ドペルもあります"}, {"type": "subtitle", "time": 4018.71, "timestamp": "01:06:58", "text": "プレステージスキンであるガンガイベント"}]
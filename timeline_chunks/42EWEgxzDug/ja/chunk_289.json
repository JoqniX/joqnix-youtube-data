[{"type": "subtitle", "time": 17341.51, "timestamp": "04:49:01", "text": "ここでの私の主な目的は"}, {"type": "subtitle", "time": 17347.27, "timestamp": "04:49:07", "text": "この光るものを上に持ち上げる"}, {"type": "subtitle", "time": 17355.27, "timestamp": "04:49:15", "text": "私の目標は"}, {"type": "subtitle", "time": 17366.948, "timestamp": "04:49:26", "text": "[音楽]"}, {"type": "subtitle", "time": 17371.03, "timestamp": "04:49:31", "text": "ああ、外で蓮の花が咲いている"}, {"type": "subtitle", "time": 17373.03, "timestamp": "04:49:33", "text": "そして、大勢の人が集団で襲いかかってくる。私"}, {"type": "subtitle", "time": 17375.19, "timestamp": "04:49:35", "text": "わからない。"}]
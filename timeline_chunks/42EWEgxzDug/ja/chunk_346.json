[{"type": "subtitle", "time": 20761.35, "timestamp": "05:46:01", "text": "こうやってクラッシュするんです。 GPUか"}, {"type": "subtitle", "time": 20765.27, "timestamp": "05:46:05", "text": "何か？何なのかわからない"}, {"type": "subtitle", "time": 20767.59, "timestamp": "05:46:07", "text": "痛み。"}, {"type": "subtitle", "time": 20787.11, "timestamp": "05:46:27", "text": "翔。では、これは一体何のために起こったのですか？"}, {"type": "subtitle", "time": 20789.83, "timestamp": "05:46:29", "text": "どのゲームでしたか？"}, {"type": "subtitle", "time": 20793.43, "timestamp": "05:46:33", "text": "前回は私がプレイしていました。"}, {"type": "subtitle", "time": 20796.47, "timestamp": "05:46:36", "text": "オーバーウォッチではそうはならなかった。私は嬉しい"}, {"type": "subtitle", "time": 20798.948, "timestamp": "05:46:38", "text": "オーバーウォッチではそうはならなかった。何が"}, {"type": "subtitle", "time": 20803.35, "timestamp": "05:46:43", "text": "昔私がプレイしていたゲーム"}, {"type": "subtitle", "time": 20806.23, "timestamp": "05:46:46", "text": "先月のように"}]
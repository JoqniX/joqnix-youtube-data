[{"type": "subtitle", "time": 13383.11, "timestamp": "03:43:03", "text": "良い一日をお過ごしください。そして私は"}, {"type": "subtitle", "time": 13386.63, "timestamp": "03:43:06", "text": "次の1週間ストリーミング配信"}, {"type": "subtitle", "time": 13390.07, "timestamp": "03:43:10", "text": "次に私が配信するのは"}, {"type": "subtitle", "time": 13394.309, "timestamp": "03:43:14", "text": "12日。わかった。そして私は旅行し、"}, {"type": "subtitle", "time": 13398.229, "timestamp": "03:43:18", "text": "明日から、"}, {"type": "subtitle", "time": 13399.75, "timestamp": "03:43:19", "text": "もの。"}, {"type": "subtitle", "time": 13402.79, "timestamp": "03:43:22", "text": "ええ、私はそれらをやらなければならないので"}, {"type": "subtitle", "time": 13405.03, "timestamp": "03:43:25", "text": "そういうことに向き合おう。だから私はすべてが"}, {"type": "subtitle", "time": 13409.91, "timestamp": "03:43:29", "text": "うまくいっています。皆さん、幸運を祈ります。"}, {"type": "subtitle", "time": 13413.67, "timestamp": "03:43:33", "text": "あなた自身の夢と信念の中で"}, {"type": "subtitle", "time": 13416.55, "timestamp": "03:43:36", "text": "ええと、あなたがやっていることすべて。わかった？しないでください"}, {"type": "subtitle", "time": 13418.79, "timestamp": "03:43:38", "text": "あきらめる。たとえあなたが"}, {"type": "subtitle", "time": 13421.59, "timestamp": "03:43:41", "text": "諦めないでください。どうか諦めないでください。あなた"}, {"type": "subtitle", "time": 13424.55, "timestamp": "03:43:44", "text": "VTuberを見ると、慰めが見える"}, {"type": "subtitle", "time": 13428.15, "timestamp": "03:43:48", "text": "こっちのジョッキーがあなたの"}, {"type": "subtitle", "time": 13430.469, "timestamp": "03:43:50", "text": "最高ですよね？まさにそのように、私は"}, {"type": "subtitle", "time": 13433.429, "timestamp": "03:43:53", "text": "あなたには最善を尽くしてほしい。一歩踏み出そう"}, {"type": "subtitle", "time": 13436.229, "timestamp": "03:43:56", "text": "転送先"}, {"type": "subtitle", "time": 13438.389, "timestamp": "03:43:58", "text": "イニシアチブ。"}]
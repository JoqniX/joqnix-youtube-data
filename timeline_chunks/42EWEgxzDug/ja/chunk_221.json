[{"type": "subtitle", "time": 13260.63, "timestamp": "03:41:00", "text": "発表と、このえーとあれ。知っている"}, {"type": "subtitle", "time": 13262.63, "timestamp": "03:41:02", "text": "30分間の告知をしたかったのですが、"}, {"type": "subtitle", "time": 13265.83, "timestamp": "03:41:05", "text": "しかし、それは結局1時間ほどかかった。しかし"}, {"type": "subtitle", "time": 13269.03, "timestamp": "03:41:09", "text": "ロックしてくれた皆さん、"}, {"type": "subtitle", "time": 13271.83, "timestamp": "03:41:11", "text": "積極的にチャットする、誰が"}, {"type": "subtitle", "time": 13273.99, "timestamp": "03:41:13", "text": "このアナウンスを見てください"}, {"type": "subtitle", "time": 13277.99, "timestamp": "03:41:17", "text": "将来も同様です。皆さん、ありがとうございました。"}, {"type": "subtitle", "time": 13280.389, "timestamp": "03:41:20", "text": "コンサートにご参加いただいた皆様、ありがとうございました。"}, {"type": "subtitle", "time": 13284.469, "timestamp": "03:41:24", "text": "プレートの名士たちが私の言うことを信じてくれている"}, {"type": "subtitle", "time": 13287.429, "timestamp": "03:41:27", "text": "私を信じて、"}, {"type": "subtitle", "time": 13290.309, "timestamp": "03:41:30", "text": "もう一度私を信じてください。"}, {"type": "subtitle", "time": 13294.389, "timestamp": "03:41:34", "text": "ありがとう。私は今ここにいられて嬉しいし、"}, {"type": "subtitle", "time": 13298.309, "timestamp": "03:41:38", "text": "ストリーミング配信もできるし、できることは何でもできる"}, {"type": "subtitle", "time": 13303.19, "timestamp": "03:41:43", "text": "夢を追いかけることができる"}, {"type": "subtitle", "time": 13305.83, "timestamp": "03:41:45", "text": "そして、私があなたにインスピレーションを与えることができればと願っています"}, {"type": "subtitle", "time": 13309.269, "timestamp": "03:41:49", "text": "あなた自身の夢。わかった、"}, {"type": "subtitle", "time": 13311.75, "timestamp": "03:41:51", "text": "なぜなら、私の本当の旅は、私がなりたかったものだったから"}, {"type": "subtitle", "time": 13315.03, "timestamp": "03:41:55", "text": "他者にとって刺激となる存在。だから私は"}, {"type": "subtitle", "time": 13317.99, "timestamp": "03:41:57", "text": "首を短くしたのは、"}]
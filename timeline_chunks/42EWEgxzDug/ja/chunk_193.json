[{"type": "subtitle", "time": 11584.309, "timestamp": "03:13:04", "text": "これに集中してください。だから、"}, {"type": "subtitle", "time": 11588.389, "timestamp": "03:13:08", "text": "きちんと分離されることはないだろう"}, {"type": "subtitle", "time": 11590.87, "timestamp": "03:13:10", "text": "ストリームとか全部とか、えーと"}, {"type": "subtitle", "time": 11593.03, "timestamp": "03:13:13", "text": "私が使っているプレイリストストリーム"}, {"type": "subtitle", "time": 11595.75, "timestamp": "03:13:15", "text": "YouTube などでやっていること、これら全て"}, {"type": "subtitle", "time": 11599.269, "timestamp": "03:13:19", "text": "年。それは単なる一度限りの出来事となるでしょう。"}, {"type": "subtitle", "time": 11604.389, "timestamp": "03:13:24", "text": "えっと、私のチャンネルは完全に"}, {"type": "subtitle", "time": 11606.63, "timestamp": "03:13:26", "text": "このイベント。ストリーミング配信をする場合"}, {"type": "subtitle", "time": 11610.63, "timestamp": "03:13:30", "text": "神のみぞ知る、どれほどの期間、毎日。"}, {"type": "subtitle", "time": 11614.309, "timestamp": "03:13:34", "text": "でも、私にはいくつかのインセンティブがあります。"}, {"type": "subtitle", "time": 11617.03, "timestamp": "03:13:37", "text": "目標やコンテンツのアイデアを念頭に置いている。私はします"}, {"type": "subtitle", "time": 11620.309, "timestamp": "03:13:40", "text": "そうしてください。そしてそれは適応的なものだ"}, {"type": "subtitle", "time": 11623.269, "timestamp": "03:13:43", "text": "なぜなら、私はそれを4ヶ月間続けるからです。私"}, {"type": "subtitle", "time": 11625.91, "timestamp": "03:13:45", "text": "あなたたちに自由を与える"}, {"type": "subtitle", "time": 11629.19, "timestamp": "03:13:49", "text": "えーっと、ルーレットとか、そういうやつ"}, {"type": "subtitle", "time": 11632.71, "timestamp": "03:13:52", "text": "インセンティブとして"}, {"type": "subtitle", "time": 11636.63, "timestamp": "03:13:56", "text": "あるいは罰則とか、そういう類のこと。わかった。"}, {"type": "subtitle", "time": 11638.71, "timestamp": "03:13:58", "text": "そうですね"}]
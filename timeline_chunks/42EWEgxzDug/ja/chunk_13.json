[{"type": "subtitle", "time": 780.79, "timestamp": "00:13:00", "text": "実際に外に出て行くには、"}, {"type": "subtitle", "time": 806.069, "timestamp": "00:13:26", "text": "待って、これが最初の着信音？何？"}, {"type": "subtitle", "time": 810.389, "timestamp": "00:13:30", "text": "ちなみに、それは最初の走行だった。"}, {"type": "subtitle", "time": 813.99, "timestamp": "00:13:33", "text": "シールドバッテリーがいくつあるか見てください"}, {"type": "subtitle", "time": 820.629, "timestamp": "00:13:40", "text": "ショットガンの弾薬が必要だ。私はしていません"}]
[{"type": "subtitle", "time": 12600.15, "timestamp": "03:30:00", "text": "小規模なクリエイターで、販売数も少ない。"}, {"type": "subtitle", "time": 12603.269, "timestamp": "03:30:03", "text": "だから、そんな風にお金を無駄遣いしてはいけない。"}, {"type": "subtitle", "time": 12606.79, "timestamp": "03:30:06", "text": "あなたが知っている。うん、自分で学ぶ必要がある"}, {"type": "subtitle", "time": 12610.469, "timestamp": "03:30:10", "text": "あなたを追跡できるようにするため"}, {"type": "subtitle", "time": 12615.03, "timestamp": "03:30:15", "text": "財政面やその他諸々、たくさんあります。うん。それで"}, {"type": "subtitle", "time": 12617.03, "timestamp": "03:30:17", "text": "皆さんが寄付や支援をしてくださる場合"}, {"type": "subtitle", "time": 12619.59, "timestamp": "03:30:19", "text": "そして、私はすべてを維持しなければならない"}, {"type": "subtitle", "time": 12622.07, "timestamp": "03:30:22", "text": "小さなノートに記録しておく"}, {"type": "subtitle", "time": 12626.79, "timestamp": "03:30:26", "text": "私のものなので、失くさないように"}, {"type": "subtitle", "time": 12630.389, "timestamp": "03:30:30", "text": "えっと、なんて呼ぶんだっけ？丸太や"}, {"type": "subtitle", "time": 12633.67, "timestamp": "03:30:33", "text": "計算とか、それって何？"}, {"type": "subtitle", "time": 12637.269, "timestamp": "03:30:37", "text": "電話した？私が探している単語は何ですか？"}, {"type": "subtitle", "time": 12639.349, "timestamp": "03:30:39", "text": "ほら、銀行の通帳とか小切手帳のことだよ。"}, {"type": "subtitle", "time": 12642.55, "timestamp": "03:30:42", "text": "ああ、そう、そういうこと全部"}, {"type": "subtitle", "time": 12645.03, "timestamp": "03:30:45", "text": "メモしておいてね？"}, {"type": "subtitle", "time": 12647.99, "timestamp": "03:30:47", "text": "うん。ええ、そうですね。"}, {"type": "subtitle", "time": 12650.07, "timestamp": "03:30:50", "text": "でも、私は自分のために戦うつもりです"}, {"type": "subtitle", "time": 12657.99, "timestamp": "03:30:57", "text": "ええ、私ならできると信じています。私はできる"}]
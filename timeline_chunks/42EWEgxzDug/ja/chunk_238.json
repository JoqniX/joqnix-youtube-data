[{"type": "subtitle", "time": 14283.349, "timestamp": "03:58:03", "text": "えっと、こっちに切り替えてください。さあ行こう。さあ"}, {"type": "subtitle", "time": 14288.87, "timestamp": "03:58:08", "text": "行く。ああ、大変だ。私は大丈夫です。"}, {"type": "subtitle", "time": 14298.95, "timestamp": "03:58:18", "text": "音声が「はい」であることを願っています。良い。音声は"}, {"type": "subtitle", "time": 14304.15, "timestamp": "03:58:24", "text": "待って、待って、待って、待って。私は 私は 私は"}, {"type": "subtitle", "time": 14305.67, "timestamp": "03:58:25", "text": "ごめん。ごめんなさい。ごめんなさい。私はただ"}, {"type": "subtitle", "time": 14312.63, "timestamp": "03:58:32", "text": "プレイする前に必ずお読みください。わかった。"}, {"type": "subtitle", "time": 14316.79, "timestamp": "03:58:36", "text": "ええ、あそこのこのグラフィック"}, {"type": "subtitle", "time": 14320.63, "timestamp": "03:58:40", "text": "Destiny 2の"}, {"type": "subtitle", "time": 14323.99, "timestamp": "03:58:43", "text": "えーと、ハイブとかそういうやつ"}, {"type": "subtitle", "time": 14327.03, "timestamp": "03:58:47", "text": "そういう類のものですよね？"}, {"type": "subtitle", "time": 14330.15, "timestamp": "03:58:50", "text": "それとも、そう思うのは私だけでしょうか？"}, {"type": "subtitle", "time": 14332.87, "timestamp": "03:58:52", "text": "ええ、そう思います。"}, {"type": "subtitle", "time": 14335.269, "timestamp": "03:58:55", "text": "わかった、"}, {"type": "subtitle", "time": 14338.79, "timestamp": "03:58:58", "text": "チャット欄を開放して、皆さんの発言を読めるようにしてください。"}]
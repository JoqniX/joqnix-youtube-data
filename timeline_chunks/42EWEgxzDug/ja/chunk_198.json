[{"type": "subtitle", "time": 11880.309, "timestamp": "03:18:00", "text": "怠けられないからオンラインでも"}, {"type": "subtitle", "time": 11883.429, "timestamp": "03:18:03", "text": "家族を養うためには一生懸命働かなければならないことは分かっている"}, {"type": "subtitle", "time": 11887.83, "timestamp": "03:18:07", "text": "あなた自身が1ルピーまたは1ドルでも"}, {"type": "subtitle", "time": 11890.229, "timestamp": "03:18:10", "text": "最小の最小量とは"}, {"type": "subtitle", "time": 11894.63, "timestamp": "03:18:14", "text": "たくさんですね、それは多すぎますよね。"}, {"type": "subtitle", "time": 11896.79, "timestamp": "03:18:16", "text": "そして、この莫大な金額は多すぎる。私"}, {"type": "subtitle", "time": 11898.95, "timestamp": "03:18:18", "text": "知る。文字通り買いすぎてしまう"}, {"type": "subtitle", "time": 11901.75, "timestamp": "03:18:21", "text": "iPhoneとか、そんな感じのもの。"}, {"type": "subtitle", "time": 11913.91, "timestamp": "03:18:33", "text": "でも、自分がわがままなのは分かっている。私は"}, {"type": "subtitle", "time": 11923.269, "timestamp": "03:18:43", "text": "何度もランニングをしている中で、そういう話をよく耳にしました。えーと"}, {"type": "subtitle", "time": 11924.79, "timestamp": "03:18:44", "text": "それ"}, {"type": "subtitle", "time": 11926.71, "timestamp": "03:18:46", "text": "本当にこれをしたいですか？"}, {"type": "subtitle", "time": 11930.07, "timestamp": "03:18:50", "text": "すべて？できますか？"}, {"type": "subtitle", "time": 11932.71, "timestamp": "03:18:52", "text": "そして全て？多くの疑問が"}, {"type": "subtitle", "time": 11935.59, "timestamp": "03:18:55", "text": "多くの人にとってそこは。"}, {"type": "subtitle", "time": 11937.429, "timestamp": "03:18:57", "text": "私は彼らの間違いを証明したかった。私は"}, {"type": "subtitle", "time": 11939.59, "timestamp": "03:18:59", "text": "これを使ってこれができることを示す"}]
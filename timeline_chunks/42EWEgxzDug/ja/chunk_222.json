[{"type": "subtitle", "time": 13321.51, "timestamp": "03:42:01", "text": "私の声を聞いてもらいたい、私の音楽を聴いてもらいたい、"}, {"type": "subtitle", "time": 13323.59, "timestamp": "03:42:03", "text": "すべて。私が幼い頃"}, {"type": "subtitle", "time": 13325.67, "timestamp": "03:42:05", "text": "けれど、"}, {"type": "subtitle", "time": 13329.83, "timestamp": "03:42:09", "text": "私は人々に私の物語を知ってほしかった。"}, {"type": "subtitle", "time": 13333.75, "timestamp": "03:42:13", "text": "それが彼らにも刺激を与えてくれるといいのですが。"}, {"type": "subtitle", "time": 13336.309, "timestamp": "03:42:16", "text": "だから私はJocknikを始めたんです。それが理由です"}, {"type": "subtitle", "time": 13339.269, "timestamp": "03:42:19", "text": "ジョックニックは私が望んだときに私のすべてだった"}, {"type": "subtitle", "time": 13349.349, "timestamp": "03:42:29", "text": "そして今、私はジョックニックを"}, {"type": "subtitle", "time": 13352.07, "timestamp": "03:42:32", "text": "競争の領域。そして今、私は達成できる"}, {"type": "subtitle", "time": 13354.469, "timestamp": "03:42:34", "text": "私が望んでいたもの全て。夢のように"}, {"type": "subtitle", "time": 13358.55, "timestamp": "03:42:38", "text": "私は諦めたが、達成するために最善を尽くすことができる"}, {"type": "subtitle", "time": 13361.75, "timestamp": "03:42:41", "text": "彼らをこの旅路へと導いてください。そして"}, {"type": "subtitle", "time": 13364.63, "timestamp": "03:42:44", "text": "夢を夢として捕まえる"}, {"type": "subtitle", "time": 13366.469, "timestamp": "03:42:46", "text": "キャッチャー。"}, {"type": "subtitle", "time": 13369.99, "timestamp": "03:42:49", "text": "うん。夢を追いかける人。うん。"}, {"type": "subtitle", "time": 13371.269, "timestamp": "03:42:51", "text": "こんにちは。"}, {"type": "subtitle", "time": 13375.03, "timestamp": "03:42:55", "text": "ええ、以上です。続けよう"}, {"type": "subtitle", "time": 13377.59, "timestamp": "03:42:57", "text": "皆さん、ベストを尽くしてください。ありがとうございます"}, {"type": "subtitle", "time": 13379.11, "timestamp": "03:42:59", "text": "リスニング"}]
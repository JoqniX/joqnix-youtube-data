[{"type": "subtitle", "time": 11462.95, "timestamp": "03:11:02", "text": "奇妙な告白の殻があったと思う"}, {"type": "subtitle", "time": 11465.59, "timestamp": "03:11:05", "text": "えーと、私はまだコラボレーションしたこともない"}, {"type": "subtitle", "time": 11468.469, "timestamp": "03:11:08", "text": "私の周りの人以外すべて"}, {"type": "subtitle", "time": 11470.469, "timestamp": "03:11:10", "text": "右"}, {"type": "subtitle", "time": 11473.51, "timestamp": "03:11:13", "text": "たくさんのもののリストがあります"}, {"type": "subtitle", "time": 11476.15, "timestamp": "03:11:16", "text": "そして私はそれを壊したい、私はこれをしたい"}, {"type": "subtitle", "time": 11478.469, "timestamp": "03:11:18", "text": "イベントではソロでたくさん演奏する予定です"}, {"type": "subtitle", "time": 11481.429, "timestamp": "03:11:21", "text": "ストリーム配信とたくさんのコラボレーション"}, {"type": "subtitle", "time": 11484.87, "timestamp": "03:11:24", "text": "コラボレーションストリームを人々と配信しています"}, {"type": "subtitle", "time": 11488.23, "timestamp": "03:11:28", "text": "信頼できる人 私は信頼できる人を信頼しています"}, {"type": "subtitle", "time": 11490.55, "timestamp": "03:11:30", "text": "最初からずっと一緒にいてくれた人たち"}, {"type": "subtitle", "time": 11493.91, "timestamp": "03:11:33", "text": "私を支えてくれて、友達も普通じゃない"}, {"type": "subtitle", "time": 11496.95, "timestamp": "03:11:36", "text": "友人、コンテンツクリエイター、ユーチューバー、"}, {"type": "subtitle", "time": 11499.75, "timestamp": "03:11:39", "text": "みんな。全員連れて行きます。"}, {"type": "subtitle", "time": 11501.91, "timestamp": "03:11:41", "text": "つまり、そうではなく"}, {"type": "subtitle", "time": 11504.07, "timestamp": "03:11:44", "text": "さようなら。心配しないで。まるで"}, {"type": "subtitle", "time": 11506.79, "timestamp": "03:11:46", "text": "私が大げさに言っているように。聞こえるかもしれない"}, {"type": "subtitle", "time": 11510.95, "timestamp": "03:11:50", "text": "まるで別れの挨拶のようだったが、そうではなかった。ある意味、私は"}, {"type": "subtitle", "time": 11513.429, "timestamp": "03:11:53", "text": "感謝の気持ちを込めて、"}, {"type": "subtitle", "time": 11516.23, "timestamp": "03:11:56", "text": "一緒に過ごすのに親切にしてくれた、"}]
[{"type": "subtitle", "time": 10980.07, "timestamp": "03:03:00", "text": "知る。ああ、だって、誰も私のことを知らないんだもん"}, {"type": "subtitle", "time": 10982.309, "timestamp": "03:03:02", "text": "あまり努力していないと思うから"}, {"type": "subtitle", "time": 10985.19, "timestamp": "03:03:05", "text": "マーケティングとかそういう類のことは、"}, {"type": "subtitle", "time": 10988.55, "timestamp": "03:03:08", "text": "やり方が分からなかった。でも、だから"}, {"type": "chat", "time": 10990.318, "timestamp": "03:03:10", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "You can watch these fragments of a memories here- https://onxa.link/XI9JFg8e"}, {"type": "subtitle", "time": 10991.83, "timestamp": "03:03:11", "text": "私は小規模なクリエイターです。"}, {"type": "subtitle", "time": 10995.03, "timestamp": "03:03:15", "text": "ゴールに到達するのは本当に難しい。の"}, {"type": "subtitle", "time": 10998.389, "timestamp": "03:03:18", "text": "ジョアトンの目標は実際には"}, {"type": "subtitle", "time": 11003.11, "timestamp": "03:03:23", "text": "ええと、実際は2000ドルです。"}, {"type": "subtitle", "time": 11007.91, "timestamp": "03:03:27", "text": "2,000 の理由は、えーと、必要だったからだと思います"}, {"type": "subtitle", "time": 11011.429, "timestamp": "03:03:31", "text": "えっと、9未満で、私は、"}, {"type": "subtitle", "time": 11012.95, "timestamp": "03:03:32", "text": "リギング。"}, {"type": "subtitle", "time": 11016.23, "timestamp": "03:03:36", "text": "ええと、モデルは持っているのですが、いくつか"}, {"type": "subtitle", "time": 11019.19, "timestamp": "03:03:39", "text": "そのお金で直さなきゃいけないもの"}, {"type": "subtitle", "time": 11022.309, "timestamp": "03:03:42", "text": "それに加えて、索具代もかかる。それから私が"}, {"type": "subtitle", "time": 11025.67, "timestamp": "03:03:45", "text": "その後、もし余分なものがあれば"}, {"type": "subtitle", "time": 11029.429, "timestamp": "03:03:49", "text": "それは"}, {"type": "subtitle", "time": 11031.59, "timestamp": "03:03:51", "text": "デビューの準備とか色々あって"}, {"type": "subtitle", "time": 11033.99, "timestamp": "03:03:53", "text": "少なくとも今ならデビューできるだろう。それは"}, {"type": "subtitle", "time": 11036.79, "timestamp": "03:03:56", "text": "私は何年も待っていた"}]
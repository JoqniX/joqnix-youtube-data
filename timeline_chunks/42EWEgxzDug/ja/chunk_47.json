[{"type": "subtitle", "time": 2828.87, "timestamp": "00:47:08", "text": "ああ、大変だ。私は自分の"}, {"type": "subtitle", "time": 2832.309, "timestamp": "00:47:12", "text": "朝食。何てことだ、"}, {"type": "subtitle", "time": 2841.99, "timestamp": "00:47:21", "text": "浜木桜。"}, {"type": "subtitle", "time": 2856.39, "timestamp": "00:47:36", "text": "あ、待って。死んだ太陽系。ああ、そうだったね"}, {"type": "subtitle", "time": 2858.87, "timestamp": "00:47:38", "text": "サーバーに参加してください。ニース。"}, {"type": "subtitle", "time": 2867.43, "timestamp": "00:47:47", "text": "待って、あなたは2つのアカウントで登録したのですか？"}, {"type": "subtitle", "time": 2869.829, "timestamp": "00:47:49", "text": "ああ、"}, {"type": "subtitle", "time": 2872.15, "timestamp": "00:47:52", "text": "待って。まだここにいますか？必要になるかもしれない"}, {"type": "subtitle", "time": 2874.79, "timestamp": "00:47:54", "text": "ちなみに、あなたのアカウントの1つをキックするには、"}, {"type": "subtitle", "time": 2877.67, "timestamp": "00:47:57", "text": "だって私たちは、私たちは、"}]
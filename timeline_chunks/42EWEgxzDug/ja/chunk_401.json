[{"type": "subtitle", "time": 24060.07, "timestamp": "06:41:00", "text": "わかった。それで、"}, {"type": "subtitle", "time": 24073.83, "timestamp": "06:41:13", "text": "待って、開かない。待って、それは"}, {"type": "subtitle", "time": 24076.74, "timestamp": "06:41:16", "text": "もうない？"}, {"type": "subtitle", "time": 24084.548, "timestamp": "06:41:24", "text": "[音楽]"}, {"type": "subtitle", "time": 24087.11, "timestamp": "06:41:27", "text": "待って、私はもう片方をやるべきだったの？"}, {"type": "subtitle", "time": 24090.23, "timestamp": "06:41:30", "text": "初め？待って、まさか。いや、いや、いや。それは"}, {"type": "subtitle", "time": 24099.11, "timestamp": "06:41:39", "text": "そうしなければならなかった"}, {"type": "subtitle", "time": 24100.788, "timestamp": "06:41:40", "text": "えっと、それあなたが作ったの？ええ、それは私の"}, {"type": "subtitle", "time": 24105.75, "timestamp": "06:41:45", "text": "公式ではない、いや、公式ではないが"}, {"type": "subtitle", "time": 24107.27, "timestamp": "06:41:47", "text": "えーと"}, {"type": "subtitle", "time": 24113.27, "timestamp": "06:41:53", "text": "[音楽]"}, {"type": "subtitle", "time": 24117.75, "timestamp": "06:41:57", "text": "私は作ったの？ああ、これは私の"}, {"type": "subtitle", "time": 24119.75, "timestamp": "06:41:59", "text": "これはジョークスの"}]
[{"type": "subtitle", "time": 23581.67, "timestamp": "06:33:01", "text": "そうしている。"}, {"type": "subtitle", "time": 23584.468, "timestamp": "06:33:04", "text": "大丈夫。"}, {"type": "subtitle", "time": 23586.948, "timestamp": "06:33:06", "text": "必要なのは"}, {"type": "subtitle", "time": 23591.43, "timestamp": "06:33:11", "text": "私たちはただ行かなければならない。うん、君ならできるよ。"}, {"type": "subtitle", "time": 23593.59, "timestamp": "06:33:13", "text": "彼はもうすぐそこにいる。"}, {"type": "subtitle", "time": 23598.708, "timestamp": "06:33:18", "text": "来て。"}, {"type": "subtitle", "time": 23601.75, "timestamp": "06:33:21", "text": "待って、彼は私たちと一緒に来るの？"}, {"type": "subtitle", "time": 23603.59, "timestamp": "06:33:23", "text": "待って、"}, {"type": "subtitle", "time": 23606.868, "timestamp": "06:33:26", "text": "私たちの旅の仲間、ですよね？"}, {"type": "subtitle", "time": 23609.35, "timestamp": "06:33:29", "text": "うん。うん。うん。彼を連れて行ってもいいですか？"}, {"type": "subtitle", "time": 23612.02, "timestamp": "06:33:32", "text": "2階？"}, {"type": "subtitle", "time": 23613.99, "timestamp": "06:33:33", "text": "[音楽]"}, {"type": "subtitle", "time": 23617.27, "timestamp": "06:33:37", "text": "彼を二階に連れて行ってもいいですか？"}, {"type": "subtitle", "time": 23620.948, "timestamp": "06:33:40", "text": "多分。右。うん。でも今回は"}, {"type": "subtitle", "time": 23623.91, "timestamp": "06:33:43", "text": "PCが再起動しないようにするため、"}, {"type": "subtitle", "time": 23626.23, "timestamp": "06:33:46", "text": "何か、あるいは何でもいい。"}, {"type": "subtitle", "time": 23627.3, "timestamp": "06:33:47", "text": "ああ、"}, {"type": "subtitle", "time": 23628.468, "timestamp": "06:33:48", "text": "[音楽]"}, {"type": "subtitle", "time": 23630.788, "timestamp": "06:33:50", "text": "彼は倒れた。"}]
[{"type": "subtitle", "time": 11400.79, "timestamp": "03:10:00", "text": "私のデビューの理由などを応援してください。"}, {"type": "subtitle", "time": 11402.389, "timestamp": "03:10:02", "text": "もちろん、あなたが新しいYouTuberなら、"}, {"type": "subtitle", "time": 11404.79, "timestamp": "03:10:04", "text": "お金を使わないでね？そして、すべて。"}, {"type": "subtitle", "time": 11406.95, "timestamp": "03:10:06", "text": "無料モデルを使って"}, {"type": "subtitle", "time": 11409.19, "timestamp": "03:10:09", "text": "もちろん。"}, {"type": "subtitle", "time": 11411.59, "timestamp": "03:10:11", "text": "そしてこれらのモデルと私が持っているものすべて"}, {"type": "subtitle", "time": 11414.95, "timestamp": "03:10:14", "text": "私が使っていたものはすべて贈り物のようなものでした"}, {"type": "subtitle", "time": 11418.63, "timestamp": "03:10:18", "text": "親切な人々や、お金を払っていないもの"}, {"type": "subtitle", "time": 11420.79, "timestamp": "03:10:20", "text": "または何でもいいが"}, {"type": "subtitle", "time": 11423.59, "timestamp": "03:10:23", "text": "でも、もっと盛り込みたい気持ちもあった。私"}, {"type": "subtitle", "time": 11426.389, "timestamp": "03:10:26", "text": "自分が投資できるものにもっと投資したい"}, {"type": "subtitle", "time": 11429.349, "timestamp": "03:10:29", "text": "皆さんに提供します。私は"}, {"type": "subtitle", "time": 11431.91, "timestamp": "03:10:31", "text": "質の高いもの。私は良いことをしたかった"}, {"type": "subtitle", "time": 11433.429, "timestamp": "03:10:33", "text": "もの"}, {"type": "subtitle", "time": 11437.429, "timestamp": "03:10:37", "text": "私の夢が"}, {"type": "subtitle", "time": 11447.19, "timestamp": "03:10:47", "text": "それで、私は"}, {"type": "subtitle", "time": 11449.91, "timestamp": "03:10:49", "text": "一番大変だったのは、自分自身に証明したかったからだ"}, {"type": "subtitle", "time": 11452.95, "timestamp": "03:10:52", "text": "そして、私がそれにふさわしいと認めてくれるすべての人へ。"}, {"type": "subtitle", "time": 11455.59, "timestamp": "03:10:55", "text": "つまり、私はこれを破るということです"}, {"type": "subtitle", "time": 11459.91, "timestamp": "03:10:59", "text": "快適な外殻は既に作ったんだよね？"}]
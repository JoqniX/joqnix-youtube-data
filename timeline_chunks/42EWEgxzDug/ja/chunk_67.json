[{"type": "subtitle", "time": 4023.029, "timestamp": "01:07:03", "text": "レヴナントの。最後にラヴィ・チャンは"}, {"type": "subtitle", "time": 4029.99, "timestamp": "01:07:09", "text": "[音楽]"}, {"type": "subtitle", "time": 4031.99, "timestamp": "01:07:11", "text": "そして、今日は"}, {"type": "subtitle", "time": 4034.069, "timestamp": "01:07:14", "text": "10月18日は記念日です"}, {"type": "subtitle", "time": 4039.029, "timestamp": "01:07:19", "text": "カファン。何てことだ。何てことだ。今日私の"}, {"type": "subtitle", "time": 4042.71, "timestamp": "01:07:22", "text": "周年。何てことだ。どこかに行って。私は"}, {"type": "subtitle", "time": 4066.23, "timestamp": "01:07:46", "text": "喉がひどく痛む。"}, {"type": "subtitle", "time": 4068.95, "timestamp": "01:07:48", "text": "さあ、ゲームを始めましょう。私はそうしました"}, {"type": "subtitle", "time": 4072.39, "timestamp": "01:07:52", "text": "私はまだ開封していません。何？こんにちは、"}, {"type": "subtitle", "time": 4074.47, "timestamp": "01:07:54", "text": "ナニ。"}, {"type": "subtitle", "time": 4076.39, "timestamp": "01:07:56", "text": "カ。"}, {"type": "subtitle", "time": 4078.15, "timestamp": "01:07:58", "text": "さあ、ゲームを始めましょう。すべき"}]
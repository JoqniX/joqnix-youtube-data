[{"type": "subtitle", "time": 8701.19, "timestamp": "02:25:01", "text": "まだ終わっていない。マイクを担当しなければならない。私"}, {"type": "subtitle", "time": 8704.07, "timestamp": "02:25:04", "text": "マイクを充電する必要がある。"}, {"type": "subtitle", "time": 8712.389, "timestamp": "02:25:12", "text": "えっと、"}, {"type": "subtitle", "time": 8721.19, "timestamp": "02:25:21", "text": "私の中には学びたい部分があり、"}, {"type": "subtitle", "time": 8725.19, "timestamp": "02:25:25", "text": "楽器を実際に使ってみて、自分が"}, {"type": "subtitle", "time": 8730.55, "timestamp": "02:25:30", "text": "日本に行くので、"}, {"type": "subtitle", "time": 8734.15, "timestamp": "02:25:34", "text": "荷物を持って行ってもいいよね？"}, {"type": "subtitle", "time": 8736.309, "timestamp": "02:25:36", "text": "そして"}, {"type": "subtitle", "time": 8740.71, "timestamp": "02:25:40", "text": "私たちは来年あたりに日本に行く予定です"}, {"type": "subtitle", "time": 8743.51, "timestamp": "02:25:43", "text": "4月かな。"}, {"type": "subtitle", "time": 8745.349, "timestamp": "02:25:45", "text": "ええ、4月末頃には"}, {"type": "subtitle", "time": 8750.07, "timestamp": "02:25:50", "text": "3月30日のような期間、私は"}, {"type": "subtitle", "time": 8752.63, "timestamp": "02:25:52", "text": "今までのフライトと"}, {"type": "subtitle", "time": 8754.309, "timestamp": "02:25:54", "text": "おそらく"}]
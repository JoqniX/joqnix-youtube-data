[{"type": "subtitle", "time": 23042.948, "timestamp": "06:24:02", "text": "すぐに死んでしまうもの。"}, {"type": "subtitle", "time": 23045.99, "timestamp": "06:24:05", "text": "それは忘れましょう。"}, {"type": "subtitle", "time": 23047.99, "timestamp": "06:24:07", "text": "ああ、最初のやつは死ぬだろう。 2番目"}, {"type": "subtitle", "time": 23049.99, "timestamp": "06:24:09", "text": "1つが1つです。そして縦のものは"}, {"type": "subtitle", "time": 23053.11, "timestamp": "06:24:13", "text": "選択肢のある方。"}, {"type": "subtitle", "time": 23069.41, "timestamp": "06:24:29", "text": "アニメーション"}, {"type": "subtitle", "time": 23075.97, "timestamp": "06:24:35", "text": "そして私たちはそのまま出発する。"}, {"type": "subtitle", "time": 23078.31, "timestamp": "06:24:38", "text": "[音楽]"}, {"type": "subtitle", "time": 23080.788, "timestamp": "06:24:40", "text": "私は嬉しい"}, {"type": "subtitle", "time": 23082.39, "timestamp": "06:24:42", "text": "私"}, {"type": "subtitle", "time": 23084.868, "timestamp": "06:24:44", "text": "これをスピードアップする。"}, {"type": "subtitle", "time": 23088.15, "timestamp": "06:24:48", "text": "私はとても時間をかけて"}, {"type": "subtitle", "time": 23097.01, "timestamp": "06:24:57", "text": "[音楽]"}]
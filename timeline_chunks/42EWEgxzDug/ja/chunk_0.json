[{"type": "subtitle", "time": 3.11, "timestamp": "00:00:03", "text": "もう10月も半ばか。"}, {"type": "subtitle", "time": 9.03, "timestamp": "00:00:09", "text": "うん、"}, {"type": "subtitle", "time": 13.91, "timestamp": "00:00:13", "text": "私の声は死んでいます、なぜなら私は誤って"}, {"type": "subtitle", "time": 16.15, "timestamp": "00:00:16", "text": "好きだった"}, {"type": "subtitle", "time": 20.47, "timestamp": "00:00:20", "text": "だって、うっかりやっちゃったんだ"}, {"type": "subtitle", "time": 24.87, "timestamp": "00:00:24", "text": "なんて呼ぶんだっけ？昨日配信しました。"}, {"type": "subtitle", "time": 27.349, "timestamp": "00:00:27", "text": "えっと、昨日の私のTwitch配信は7になりました"}, {"type": "subtitle", "time": 31.189, "timestamp": "00:00:31", "text": "時間。だから、午前5時頃に寝たんだ。"}, {"type": "subtitle", "time": 33.43, "timestamp": "00:00:33", "text": "うん、"}, {"type": "subtitle", "time": 35.91, "timestamp": "00:00:35", "text": "私は愛する"}, {"type": "subtitle", "time": 41.43, "timestamp": "00:00:41", "text": "あ、待って。もし私が午前5時に寝たら 5 6 7"}, {"type": "subtitle", "time": 46.389, "timestamp": "00:00:46", "text": "待って、5〜6 7 8 9 10 5時間の睡眠。"}, {"type": "subtitle", "time": 50.31, "timestamp": "00:00:50", "text": "それだけでは不十分だ。何てことだ。"}, {"type": "subtitle", "time": 52.79, "timestamp": "00:00:52", "text": "ええ、いくつか、私はまだ"}, {"type": "subtitle", "time": 55.27, "timestamp": "00:00:55", "text": "朝食。私は起きたばかりです。私は"}, {"type": "subtitle", "time": 57.67, "timestamp": "00:00:57", "text": "ストリームを遅延させるはずだった"}, {"type": "subtitle", "time": 59.75, "timestamp": "00:00:59", "text": "1時間。"}]
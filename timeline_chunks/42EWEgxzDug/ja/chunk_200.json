[{"type": "subtitle", "time": 12000.07, "timestamp": "03:20:00", "text": "それはリギングの費用です"}, {"type": "subtitle", "time": 12002.389, "timestamp": "03:20:02", "text": "そして、私はどれくらい必要かわかりません"}, {"type": "subtitle", "time": 12006.95, "timestamp": "03:20:06", "text": "モデルのあーあーの問題を修正する"}, {"type": "subtitle", "time": 12010.87, "timestamp": "03:20:10", "text": "アートだけど、わからないけど、うん、だから一度"}, {"type": "subtitle", "time": 12013.83, "timestamp": "03:20:13", "text": "それを叩く、えーと、いくらで始めるか"}, {"type": "subtitle", "time": 12016.87, "timestamp": "03:20:16", "text": "リギングプロセスは、おそらくまだ"}, {"type": "subtitle", "time": 12019.83, "timestamp": "03:20:19", "text": "ジョアソンと一緒に行く"}, {"type": "subtitle", "time": 12023.19, "timestamp": "03:20:23", "text": "そうすれば他のことにも準備できるし"}, {"type": "subtitle", "time": 12025.59, "timestamp": "03:20:25", "text": "私はそのお金を受け取らないようにします、受け取らないようにします"}, {"type": "subtitle", "time": 12027.59, "timestamp": "03:20:27", "text": "私たちはそのお金を取らないと約束します"}, {"type": "subtitle", "time": 12030.95, "timestamp": "03:20:30", "text": "私の銀行口座。私は、私はこれらを見ました"}, {"type": "subtitle", "time": 12032.95, "timestamp": "03:20:32", "text": "今週、銀行口座の整理を始めた。"}, {"type": "subtitle", "time": 12037.269, "timestamp": "03:20:37", "text": "アカウント関連情報。私は銀行口座を保有していました"}, {"type": "subtitle", "time": 12039.75, "timestamp": "03:20:39", "text": "これのためだけに。だからお金は受け取らない"}, {"type": "subtitle", "time": 12041.75, "timestamp": "03:20:41", "text": "そこから。"}, {"type": "subtitle", "time": 12044.469, "timestamp": "03:20:44", "text": "私は父にすべてを捧げました"}, {"type": "subtitle", "time": 12047.91, "timestamp": "03:20:47", "text": "何かあったら、私をボンと鳴らしてください"}, {"type": "subtitle", "time": 12052.389, "timestamp": "03:20:52", "text": "1セントでも、"}, {"type": "subtitle", "time": 12055.11, "timestamp": "03:20:55", "text": "他のサブスクリプションから失われたか、"}, {"type": "subtitle", "time": 12057.11, "timestamp": "03:20:57", "text": "ストリーミングに使うものすべてと"}, {"type": "subtitle", "time": 12058.87, "timestamp": "03:20:58", "text": "すべて。私はそうしたくない"}]
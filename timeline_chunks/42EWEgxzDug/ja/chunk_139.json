[{"type": "subtitle", "time": 8360.389, "timestamp": "02:19:20", "text": "問題は、私が"}, {"type": "subtitle", "time": 8363.91, "timestamp": "02:19:23", "text": "毎日配信しています"}, {"type": "subtitle", "time": 8368.629, "timestamp": "02:19:28", "text": "あまり人が訪れない"}, {"type": "subtitle", "time": 8372.389, "timestamp": "02:19:32", "text": "あるいは、影響していると思う"}, {"type": "subtitle", "time": 8376.23, "timestamp": "02:19:36", "text": "チャンネル全体を少し。"}, {"type": "subtitle", "time": 8378.549, "timestamp": "02:19:38", "text": "私はたくさんのことを考えていました"}, {"type": "subtitle", "time": 8381.27, "timestamp": "02:19:41", "text": "これ。"}, {"type": "subtitle", "time": 8384.309, "timestamp": "02:19:44", "text": "元の生活に戻りたい気持ちもある"}, {"type": "subtitle", "time": 8387.19, "timestamp": "02:19:47", "text": "ストリーム配信など、すべて。"}, {"type": "subtitle", "time": 8389.59, "timestamp": "02:19:49", "text": "ほら、いろいろあるよ"}, {"type": "subtitle", "time": 8392.55, "timestamp": "02:19:52", "text": "2～4時間のストリーミング形式"}, {"type": "subtitle", "time": 8395.429, "timestamp": "02:19:55", "text": "そういうこと、そしてVAをやめること"}, {"type": "subtitle", "time": 8397.91, "timestamp": "02:19:57", "text": "あれ。"}]
[{"type": "subtitle", "time": 26048.708, "timestamp": "07:14:08", "text": "[音楽]"}, {"type": "subtitle", "time": 26057.43, "timestamp": "07:14:17", "text": "じゃあ、また近いうちに会おう。ジョー、これは"}, {"type": "subtitle", "time": 26058.708, "timestamp": "07:14:18", "text": "ちなみに、素晴らしい配信でした。必ずそうします"}, {"type": "subtitle", "time": 26060.39, "timestamp": "07:14:20", "text": "また別の機会に立ち寄ります。安全に過ごして"}, {"type": "subtitle", "time": 26062.628, "timestamp": "07:14:22", "text": "気をつけて。こんにちは。ええ、それも。そしてまた"}, {"type": "subtitle", "time": 26065.43, "timestamp": "07:14:25", "text": "ようこそ、オネクサ・ファミリアへ。"}, {"type": "subtitle", "time": 26067.83, "timestamp": "07:14:27", "text": "今日私を見つけてくださってありがとうございます。今、"}, {"type": "subtitle", "time": 26069.67, "timestamp": "07:14:29", "text": "将来ぜひお越しください"}, {"type": "subtitle", "time": 26072.708, "timestamp": "07:14:32", "text": "ストリーム。ありがとう。そして、行く前に、"}, {"type": "subtitle", "time": 26075.75, "timestamp": "07:14:35", "text": "あなたにとって、暖かく、暖かく、暖かい道。幸運を"}, {"type": "subtitle", "time": 26077.67, "timestamp": "07:14:37", "text": "残りの一日、あるいは夜を過ごすために。"}, {"type": "subtitle", "time": 26079.35, "timestamp": "07:14:39", "text": "はぁ？だって君にとってはもう夜だから"}, {"type": "subtitle", "time": 26081.67, "timestamp": "07:14:41", "text": "右？はい。"}, {"type": "subtitle", "time": 26084.23, "timestamp": "07:14:44", "text": "こんにちは。来る。"}, {"type": "subtitle", "time": 26087.43, "timestamp": "07:14:47", "text": "あなたにインスピレーションを与えているのは誰ですか？私の"}, {"type": "subtitle", "time": 26089.99, "timestamp": "07:14:49", "text": "インスピレーション。はぁ？たくさんある"}, {"type": "subtitle", "time": 26093.51, "timestamp": "07:14:53", "text": "私にインスピレーションを与えてくれる人々。"}, {"type": "subtitle", "time": 26097.19, "timestamp": "07:14:57", "text": "うん。それは別のジャンルから来ています。ない"}]
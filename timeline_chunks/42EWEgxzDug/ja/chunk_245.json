[{"type": "subtitle", "time": 14701.349, "timestamp": "04:05:01", "text": "何"}, {"type": "subtitle", "time": 14708.95, "timestamp": "04:05:08", "text": "私はたくさんのものを見つけるべきなのでしょうか"}, {"type": "subtitle", "time": 14713.82, "timestamp": "04:05:13", "text": "球体か何か？そして、私にはできない"}, {"type": "subtitle", "time": 14717.59, "timestamp": "04:05:17", "text": "[音楽]"}, {"type": "subtitle", "time": 14720.79, "timestamp": "04:05:20", "text": "ここで考えてみてください"}, {"type": "subtitle", "time": 14722.71, "timestamp": "04:05:22", "text": "これか何かから出てきたんだ。いいえ、いいえ、"}, {"type": "subtitle", "time": 14726.389, "timestamp": "04:05:26", "text": "いや、いや。私はトップから這い上がってきたんだ、そうだろ？"}, {"type": "subtitle", "time": 14731.02, "timestamp": "04:05:31", "text": "聖なる。よし、じゃあここに行こう。"}, {"type": "subtitle", "time": 14736.95, "timestamp": "04:05:36", "text": "[音楽]"}, {"type": "subtitle", "time": 14742.389, "timestamp": "04:05:42", "text": "私は手に入れている"}, {"type": "subtitle", "time": 14744.95, "timestamp": "04:05:44", "text": "なんてこった。これは何ですか？電源を入れます"}, {"type": "subtitle", "time": 14748.229, "timestamp": "04:05:48", "text": "ローラはここにいます。"}, {"type": "subtitle", "time": 14758.79, "timestamp": "04:05:58", "text": "[音楽]"}]
[{"type": "subtitle", "time": 25682.708, "timestamp": "07:08:02", "text": "どういうわけか見つけた。"}, {"type": "subtitle", "time": 25685.19, "timestamp": "07:08:05", "text": "ああ、そうだ、私は実際に"}, {"type": "subtitle", "time": 25687.35, "timestamp": "07:08:07", "text": "YouTube視聴者。"}, {"type": "subtitle", "time": 25690.07, "timestamp": "07:08:10", "text": "そうやってアニメを知ったんだ"}, {"type": "subtitle", "time": 25692.468, "timestamp": "07:08:12", "text": "もの。私は知らなかったが、"}, {"type": "subtitle", "time": 25694.468, "timestamp": "07:08:14", "text": "漫画か子供向けのものだと思った"}, {"type": "subtitle", "time": 25696.468, "timestamp": "07:08:16", "text": "そして全て。気にしなかった。"}, {"type": "subtitle", "time": 25698.628, "timestamp": "07:08:18", "text": "そしてある日、私はこう思った。「ああ、"}, {"type": "subtitle", "time": 25702.868, "timestamp": "07:08:22", "text": "じゃあ、このYouTubeの動画でも見ようかな"}, {"type": "subtitle", "time": 25705.43, "timestamp": "07:08:25", "text": "すべてにおいて。」だから、これはゲーマーの"}, {"type": "subtitle", "time": 25708.31, "timestamp": "07:08:28", "text": "もの。クリップとか見たよ"}, {"type": "subtitle", "time": 25712.23, "timestamp": "07:08:32", "text": "YouTuberが制作したアニメ。だから私はこう思った、"}, {"type": "subtitle", "time": 25731.19, "timestamp": "07:08:51", "text": "だから、私はそれを持っていません。"}, {"type": "subtitle", "time": 25735.43, "timestamp": "07:08:55", "text": "私はそれが必要だ"}]
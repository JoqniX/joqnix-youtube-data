[{"type": "subtitle", "time": 11340.23, "timestamp": "03:09:00", "text": "だから私はそれを証明するつもりだ"}, {"type": "subtitle", "time": 11342.71, "timestamp": "03:09:02", "text": "私自身と、私がふさわしいと思うすべての人へ"}, {"type": "subtitle", "time": 11346.07, "timestamp": "03:09:06", "text": "この解は新しいジョックと同じです。ない"}, {"type": "subtitle", "time": 11349.03, "timestamp": "03:09:09", "text": "現アスリート、新アスリート。新しい"}, {"type": "subtitle", "time": 11351.99, "timestamp": "03:09:11", "text": "アスリート系、私はそれが大好きなんです。私はそれが大好きです"}, {"type": "subtitle", "time": 11355.11, "timestamp": "03:09:15", "text": "モデルをたくさんやってるよ。私はそれを毎日見つめています"}, {"type": "subtitle", "time": 11357.349, "timestamp": "03:09:17", "text": "夜。寝る前に、私は知っている"}, {"type": "subtitle", "time": 11359.67, "timestamp": "03:09:19", "text": "それは悪い"}, {"type": "subtitle", "time": 11362.79, "timestamp": "03:09:22", "text": "あまりにも綺麗すぎるから。わかった、それは"}, {"type": "subtitle", "time": 11366.389, "timestamp": "03:09:26", "text": "とても綺麗で、本当に素晴らしい。そして私は"}, {"type": "subtitle", "time": 11368.87, "timestamp": "03:09:28", "text": "モデル1を皆さんにお見せしたかったんです"}, {"type": "subtitle", "time": 11370.469, "timestamp": "03:09:30", "text": "日。"}, {"type": "subtitle", "time": 11372.87, "timestamp": "03:09:32", "text": "そして"}, {"type": "subtitle", "time": 11375.75, "timestamp": "03:09:35", "text": "私は、それを振るうに値しないと思う"}, {"type": "subtitle", "time": 11379.51, "timestamp": "03:09:39", "text": "あの新しいジョーク。そして私は準備しておかなければならない"}, {"type": "subtitle", "time": 11383.91, "timestamp": "03:09:43", "text": "その新しいものを使うに値する"}, {"type": "subtitle", "time": 11387.349, "timestamp": "03:09:47", "text": "モデルまたは新しい私、私が計画している"}, {"type": "subtitle", "time": 11392.87, "timestamp": "03:09:52", "text": "それが私がこれをやっている主な理由です"}, {"type": "subtitle", "time": 11397.03, "timestamp": "03:09:57", "text": "トークマラソン。資金を求めるためだけではなく"}]
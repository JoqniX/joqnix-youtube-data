[{"type": "subtitle", "time": 26162.15, "timestamp": "07:16:02", "text": "音楽を作ることとその他すべて"}, {"type": "subtitle", "time": 26168.468, "timestamp": "07:16:08", "text": "それから"}, {"type": "subtitle", "time": 26170.708, "timestamp": "07:16:10", "text": "そう、そんな感じ。それはユーチューバーの一人です"}, {"type": "subtitle", "time": 26175.59, "timestamp": "07:16:15", "text": "他の人たちも大勢いる。"}, {"type": "subtitle", "time": 26179.59, "timestamp": "07:16:19", "text": "特別な星空があるバカ神様"}, {"type": "subtitle", "time": 26182.948, "timestamp": "07:16:22", "text": "卒業したが、"}]
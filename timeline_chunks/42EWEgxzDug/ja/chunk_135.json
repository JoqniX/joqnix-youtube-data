[{"type": "subtitle", "time": 8102.31, "timestamp": "02:15:02", "text": "うん、"}, {"type": "subtitle", "time": 8105.35, "timestamp": "02:15:05", "text": "ここはかつて私にとって安らぎの場所だった。私は"}, {"type": "subtitle", "time": 8109.03, "timestamp": "02:15:09", "text": "私が悲しい気持ちになったり、"}, {"type": "subtitle", "time": 8111.91, "timestamp": "02:15:11", "text": "感じるたびに"}, {"type": "subtitle", "time": 8114.95, "timestamp": "02:15:14", "text": "えっと、インスピレーションが必要なんです、もしくは"}, {"type": "subtitle", "time": 8117.51, "timestamp": "02:15:17", "text": "空虚感を感じる"}, {"type": "subtitle", "time": 8121.03, "timestamp": "02:15:21", "text": "あるいは、私がただ来るようなどんな方法でも"}, {"type": "subtitle", "time": 8125.589, "timestamp": "02:15:25", "text": "ここを見て、ただじっと見つめる"}, {"type": "subtitle", "time": 8129.91, "timestamp": "02:15:29", "text": "夕方などであれば雲が出ている"}, {"type": "subtitle", "time": 8132.629, "timestamp": "02:15:32", "text": "雲を見つめて"}, {"type": "subtitle", "time": 8135.27, "timestamp": "02:15:35", "text": "見て、見て、あなたの波を見て、"}, {"type": "subtitle", "time": 8143.35, "timestamp": "02:15:43", "text": "多くのことが変わった。私はそうしなかったから"}, {"type": "subtitle", "time": 8147.03, "timestamp": "02:15:47", "text": "私の部屋や家から出てきて"}, {"type": "subtitle", "time": 8153.91, "timestamp": "02:15:53", "text": "多くのことが変わりました"}, {"type": "subtitle", "time": 8156.149, "timestamp": "02:15:56", "text": "ここ。"}, {"type": "subtitle", "time": 8158.069, "timestamp": "02:15:58", "text": "実際は"}, {"type": "subtitle", "time": 8159.22, "timestamp": "02:15:59", "text": "面白い。"}]
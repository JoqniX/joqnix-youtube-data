[{"type": "subtitle", "time": 181.99, "timestamp": "00:03:01", "text": "だから、水曜日か火曜日だと思います。"}, {"type": "subtitle", "time": 184.55, "timestamp": "00:03:04", "text": "ええ、水曜日ですね。私はできません"}, {"type": "subtitle", "time": 192.79, "timestamp": "00:03:12", "text": "ああ、まるで私が文句を言っているみたいだけど、"}, {"type": "subtitle", "time": 194.63, "timestamp": "00:03:14", "text": "それは良いです。"}, {"type": "subtitle", "time": 196.63, "timestamp": "00:03:16", "text": "私が言いたかったのはそういうことです。"}, {"type": "subtitle", "time": 215.27, "timestamp": "00:03:35", "text": "さあ行こう。皆さん、音声聞こえますか？"}, {"type": "subtitle", "time": 218.07, "timestamp": "00:03:38", "text": "そう願っています。"}, {"type": "subtitle", "time": 228.07, "timestamp": "00:03:48", "text": "ニース。"}, {"type": "subtitle", "time": 238.949, "timestamp": "00:03:58", "text": "おそらくカットシーンだろう。いいえ、カットシーンはありません。"}]
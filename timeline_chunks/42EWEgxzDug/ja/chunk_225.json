[{"type": "subtitle", "time": 13503.03, "timestamp": "03:45:03", "text": "心から楽しんでいるし、好きです。そう、"}, {"type": "subtitle", "time": 13506.469, "timestamp": "03:45:06", "text": "それに取り組む。よし、かなり速く走っていると思う。えっと"}, {"type": "subtitle", "time": 13510.229, "timestamp": "03:45:10", "text": "ああ、まだだ。ああ、終わりにするよ。"}, {"type": "subtitle", "time": 13512.87, "timestamp": "03:45:12", "text": "わかった。こんにちは。"}, {"type": "subtitle", "time": 13516.63, "timestamp": "03:45:16", "text": "というわけで、それでは、"}, {"type": "subtitle", "time": 13520.07, "timestamp": "03:45:20", "text": "聞いていたすべての人と"}, {"type": "subtitle", "time": 13526.55, "timestamp": "03:45:26", "text": "私はそれを閉めた。"}, {"type": "subtitle", "time": 13529.03, "timestamp": "03:45:29", "text": "こんにちは。"}, {"type": "subtitle", "time": 13532.389, "timestamp": "03:45:32", "text": "ええ、私はあなたたちを愛しています"}, {"type": "subtitle", "time": 13538.79, "timestamp": "03:45:38", "text": "これはジョックンです"}]
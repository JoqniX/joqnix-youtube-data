[{"type": "subtitle", "time": 2344.47, "timestamp": "00:39:04", "text": "えっと、Twitchで私を見つけることができますよ。うん、"}, {"type": "subtitle", "time": 2350.47, "timestamp": "00:39:10", "text": "では、私も参加してもいいですか？あなたは"}, {"type": "subtitle", "time": 2353.43, "timestamp": "00:39:13", "text": "それを聞いてみてください。ああ、そんなこと聞かないで。それは"}, {"type": "subtitle", "time": 2364.79, "timestamp": "00:39:24", "text": "それはあなたの決断です。"}, {"type": "subtitle", "time": 2366.31, "timestamp": "00:39:26", "text": "私のTwitchリンクは"}, {"type": "subtitle", "time": 2372.47, "timestamp": "00:39:32", "text": "それはあなたの決断です。"}, {"type": "subtitle", "time": 2375.589, "timestamp": "00:39:35", "text": "ああ、フォローしてくれてありがとう。"}, {"type": "subtitle", "time": 2386.23, "timestamp": "00:39:46", "text": "今、それを見た"}]
[{"type": "subtitle", "time": 13711.11, "timestamp": "03:48:31", "text": "こんにちは、みんな。"}, {"type": "subtitle", "time": 13714.63, "timestamp": "03:48:34", "text": "こんにちは。皆さん、お元気ですか？調子はどうですか？"}, {"type": "subtitle", "time": 13724.55, "timestamp": "03:48:44", "text": "皆さんお元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 13726.95, "timestamp": "03:48:46", "text": "しばらく配信してないけど、"}, {"type": "subtitle", "time": 13730.71, "timestamp": "03:48:50", "text": "右？えっと、最後に配信したのはいつだったかな？私"}, {"type": "subtitle", "time": 13732.79, "timestamp": "03:48:52", "text": "忘れた。"}, {"type": "subtitle", "time": 13735.83, "timestamp": "03:48:55", "text": "そういえば、最後に配信したのはいつだったっけ？私"}, {"type": "subtitle", "time": 13737.59, "timestamp": "03:48:57", "text": "覚えていない。"}]
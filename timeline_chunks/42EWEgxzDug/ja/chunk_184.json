[{"type": "subtitle", "time": 11040.23, "timestamp": "03:04:00", "text": "デビューさせるために私は辛抱強く待っていました"}, {"type": "subtitle", "time": 11044.15, "timestamp": "03:04:04", "text": "多く。うん。デビューはできないと思う"}, {"type": "subtitle", "time": 11046.63, "timestamp": "03:04:06", "text": "この4ヶ月以内に"}, {"type": "subtitle", "time": 11048.79, "timestamp": "03:04:08", "text": "奇跡は起こる。私はそうは思わない"}, {"type": "subtitle", "time": 11051.75, "timestamp": "03:04:11", "text": "起こるだろうけど、わからない"}, {"type": "subtitle", "time": 11055.03, "timestamp": "03:04:15", "text": "でも、私は諦めずに挑戦し続けます。わかった。"}, {"type": "subtitle", "time": 11057.59, "timestamp": "03:04:17", "text": "そうそう"}, {"type": "subtitle", "time": 11061.11, "timestamp": "03:04:21", "text": "これらすべて、私は皆さんの多くが知っています、ええと、"}, {"type": "subtitle", "time": 11064.309, "timestamp": "03:04:24", "text": "本当に私を応援したいと思ってくれたら、"}, {"type": "subtitle", "time": 11066.87, "timestamp": "03:04:26", "text": "たとえあなたがサポートできたとしても"}, {"type": "subtitle", "time": 11069.11, "timestamp": "03:04:29", "text": "大丈夫です。あなたに尋ねるだけです"}, {"type": "subtitle", "time": 11071.269, "timestamp": "03:04:31", "text": "私の配信を見てください、特に"}, {"type": "subtitle", "time": 11073.99, "timestamp": "03:04:33", "text": "YouTube。私は収益化しようとしています"}, {"type": "subtitle", "time": 11076.87, "timestamp": "03:04:36", "text": "YouTube または YouTube パートナーになるので、"}, {"type": "subtitle", "time": 11078.55, "timestamp": "03:04:38", "text": "少なくとも"}, {"type": "subtitle", "time": 11080.95, "timestamp": "03:04:40", "text": "人々にTwitch体験を提供する"}, {"type": "subtitle", "time": 11083.59, "timestamp": "03:04:43", "text": "YouTubeで私を見ている人たち、Jocknikのように"}, {"type": "subtitle", "time": 11086.15, "timestamp": "03:04:46", "text": "エモとか全部、そしてついに"}, {"type": "subtitle", "time": 11089.19, "timestamp": "03:04:49", "text": "YouTuberの友達を襲撃する"}, {"type": "subtitle", "time": 11092.07, "timestamp": "03:04:52", "text": "コンテンツクリエイター"}, {"type": "subtitle", "time": 11095.75, "timestamp": "03:04:55", "text": "今は色々なことがある。そうだけど、"}, {"type": "subtitle", "time": 11098.07, "timestamp": "03:04:58", "text": "今年の私の目標の一つは"}]
[{"type": "subtitle", "time": 13920.309, "timestamp": "03:52:00", "text": "ユーザー名ユーザー名ハンドルが一度"}, {"type": "subtitle", "time": 13923.269, "timestamp": "03:52:03", "text": "YouTube で公開されるのを期待しています"}, {"type": "subtitle", "time": 13926.389, "timestamp": "03:52:06", "text": "変更、そしてこんにちは、いい感じではありません、ようこそ"}, {"type": "subtitle", "time": 13932.87, "timestamp": "03:52:12", "text": "こんにちは、それで、この話に入る前に、"}, {"type": "subtitle", "time": 13936.15, "timestamp": "03:52:16", "text": "はい。えーと、私たちは2週間の"}, {"type": "subtitle", "time": 13940.309, "timestamp": "03:52:20", "text": "ホラーゲームみたいなもの。どの取っ手のことですか？"}, {"type": "subtitle", "time": 13942.309, "timestamp": "03:52:22", "text": "知らなかったら、YouTube"}, {"type": "subtitle", "time": 13944.63, "timestamp": "03:52:24", "text": "この新機能をリリースします"}, {"type": "subtitle", "time": 13947.269, "timestamp": "03:52:27", "text": "Instagram のように、Instagram のように、"}, {"type": "subtitle", "time": 13949.11, "timestamp": "03:52:29", "text": "Facebookやその他のソーシャルメディア"}, {"type": "subtitle", "time": 13952.95, "timestamp": "03:52:32", "text": "シンボルのようなプラットフォームと"}, {"type": "subtitle", "time": 13955.83, "timestamp": "03:52:35", "text": "あなたのユーザー名。そのため、表示の代わりに"}, {"type": "subtitle", "time": 13959.91, "timestamp": "03:52:39", "text": "あなたのカスタムYouTube URLに名前を付けていいねしてください。"}, {"type": "subtitle", "time": 13962.07, "timestamp": "03:52:42", "text": "それらはそこにあります。しかしそれでも"}, {"type": "subtitle", "time": 13964.389, "timestamp": "03:52:44", "text": "YouTubeは主に"}, {"type": "subtitle", "time": 13966.87, "timestamp": "03:52:46", "text": "今後はTwitterのようにハンドル名を使います"}, {"type": "subtitle", "time": 13970.07, "timestamp": "03:52:50", "text": "そしてInstagram。ええ、YouTubeは"}, {"type": "subtitle", "time": 13973.51, "timestamp": "03:52:53", "text": "そうしている。ああ、それは強制されるだろう"}, {"type": "subtitle", "time": 13976.309, "timestamp": "03:52:56", "text": "入手可能です。彼らは"}, {"type": "subtitle", "time": 13979.189, "timestamp": "03:52:59", "text": "強制スイッチのようなスイッチ"}]
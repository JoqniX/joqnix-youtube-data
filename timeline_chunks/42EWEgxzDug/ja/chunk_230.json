[{"type": "subtitle", "time": 13801.75, "timestamp": "03:50:01", "text": "Yeah にはたくさんのバグがあります。"}, {"type": "subtitle", "time": 13805.429, "timestamp": "03:50:05", "text": "左側と右側に。バグについて"}, {"type": "subtitle", "time": 13808.87, "timestamp": "03:50:08", "text": "ぼかしとか色々。そして、クアッカンさん、ありがとう。"}, {"type": "subtitle", "time": 13811.91, "timestamp": "03:50:11", "text": "私に警告を与えて思い出させてくれた"}, {"type": "subtitle", "time": 13815.99, "timestamp": "03:50:15", "text": "それらは、私が必要とするザリガニのものです"}, {"type": "subtitle", "time": 13818.79, "timestamp": "03:50:18", "text": "ぼかしとか、そういうのを撮るんだよ。私"}, {"type": "subtitle", "time": 13820.95, "timestamp": "03:50:20", "text": "わからない。大丈夫だといいのですが"}, {"type": "subtitle", "time": 13823.269, "timestamp": "03:50:23", "text": "YouTube が"}, {"type": "subtitle", "time": 13826.469, "timestamp": "03:50:26", "text": "私のような人にとっては、ホラーゲームだから、"}, {"type": "subtitle", "time": 13829.14, "timestamp": "03:50:29", "text": "右？誰でも？"}, {"type": "subtitle", "time": 13832.309, "timestamp": "03:50:32", "text": "[音楽]"}, {"type": "subtitle", "time": 13836.309, "timestamp": "03:50:36", "text": "では、その前に、"}, {"type": "subtitle", "time": 13839.67, "timestamp": "03:50:39", "text": "いくつか話題を取り上げます。こんにちは。それで、えっと、私は"}, {"type": "subtitle", "time": 13843.91, "timestamp": "03:50:43", "text": "毎日もっとやり始めた 毎日"}, {"type": "subtitle", "time": 13846.63, "timestamp": "03:50:46", "text": "毎日、短いお知らせみたいな感じ"}, {"type": "subtitle", "time": 13850.55, "timestamp": "03:50:50", "text": "ビデオ。私はそれを数時間前に投稿しました"}, {"type": "subtitle", "time": 13853.429, "timestamp": "03:50:53", "text": "数時間前か数分前に"}, {"type": "subtitle", "time": 13857.189, "timestamp": "03:50:57", "text": "Twitter、Facebookで入手可能"}]
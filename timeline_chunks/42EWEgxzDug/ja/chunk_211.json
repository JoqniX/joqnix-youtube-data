[{"type": "subtitle", "time": 12661.429, "timestamp": "03:31:01", "text": "やってみて。こんにちは。"}, {"type": "subtitle", "time": 12662.87, "timestamp": "03:31:02", "text": "彼の配信ではいつも"}, {"type": "subtitle", "time": 12667.11, "timestamp": "03:31:07", "text": "Jはそうしました。こんにちは。ありがとう。ありがとう。 D. それは"}, {"type": "subtitle", "time": 12670.55, "timestamp": "03:31:10", "text": "とても意味があります。こんにちは。繰り返しますが、"}, {"type": "subtitle", "time": 12675.269, "timestamp": "03:31:15", "text": "もの。寄付はしないでください"}, {"type": "subtitle", "time": 12680.469, "timestamp": "03:31:20", "text": "えーっと、もし私のような人が必要なら"}, {"type": "subtitle", "time": 12682.95, "timestamp": "03:31:22", "text": "もしそのお金が自分のために使われるなら"}, {"type": "subtitle", "time": 12687.11, "timestamp": "03:31:27", "text": "あなたは私に寄付をしているのです。自分がバカだってことは分かってる"}, {"type": "subtitle", "time": 12688.79, "timestamp": "03:31:28", "text": "私が運営しているにもかかわらず、"}, {"type": "subtitle", "time": 12692.15, "timestamp": "03:31:32", "text": "サブアトンイベントですが、しかし、しかし、しかし、しかし"}, {"type": "subtitle", "time": 12695.269, "timestamp": "03:31:35", "text": "これを覚えておいてください。"}, {"type": "subtitle", "time": 12697.75, "timestamp": "03:31:37", "text": "あなたが私に渡したいお金、または"}, {"type": "subtitle", "time": 12699.429, "timestamp": "03:31:39", "text": "何か"}, {"type": "subtitle", "time": 12701.59, "timestamp": "03:31:41", "text": "あなた自身のために。自分にご褒美をあげよう"}, {"type": "subtitle", "time": 12704.309, "timestamp": "03:31:44", "text": "贈り物。よし、君たちはよく頑張ったね"}, {"type": "subtitle", "time": 12706.87, "timestamp": "03:31:46", "text": "今。皆さん"}, {"type": "subtitle", "time": 12708.63, "timestamp": "03:31:48", "text": "ストリームに参加している人たち"}, {"type": "subtitle", "time": 12710.79, "timestamp": "03:31:50", "text": "そして、聞いていない人たちは"}, {"type": "subtitle", "time": 12712.87, "timestamp": "03:31:52", "text": "ボードすべて"}, {"type": "subtitle", "time": 12716.229, "timestamp": "03:31:56", "text": "あなたは自分が使ったお金に見合うだけの価値があることを知っています"}, {"type": "subtitle", "time": 12718.07, "timestamp": "03:31:58", "text": "私を応援してください。はい、そうする必要はありません"}]
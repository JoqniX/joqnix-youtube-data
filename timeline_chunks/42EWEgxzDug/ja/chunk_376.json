[{"type": "subtitle", "time": 22570.15, "timestamp": "06:16:10", "text": "いいえ。"}, {"type": "subtitle", "time": 22574.23, "timestamp": "06:16:14", "text": "あなたに見えるようにするはず"}, {"type": "subtitle", "time": 22577.19, "timestamp": "06:16:17", "text": "下部に1が2つあります。私は手に入れたい"}, {"type": "subtitle", "time": 22579.83, "timestamp": "06:16:19", "text": "彼らを外へ"}, {"type": "subtitle", "time": 22583.03, "timestamp": "06:16:23", "text": "そしてそれらを作る"}, {"type": "subtitle", "time": 22585.35, "timestamp": "06:16:25", "text": "ダブルワンを降らせるか"}, {"type": "subtitle", "time": 22588.708, "timestamp": "06:16:28", "text": "何か。いくつか"}, {"type": "subtitle", "time": 22591.91, "timestamp": "06:16:31", "text": "そんな感じ。"}, {"type": "subtitle", "time": 22595.67, "timestamp": "06:16:35", "text": "じゃあ、この男はこっちに置いておこう。"}, {"type": "subtitle", "time": 22605.03, "timestamp": "06:16:45", "text": "たぶん私は何らかの方法で"}, {"type": "subtitle", "time": 22614.628, "timestamp": "06:16:54", "text": "ああ、このボールを手に入れる必要があると思う"}]
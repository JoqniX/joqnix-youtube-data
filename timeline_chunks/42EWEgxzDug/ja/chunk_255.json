[{"type": "subtitle", "time": 15315.83, "timestamp": "04:15:15", "text": "さらなる痛み。ストリーミング配信するべきじゃなかった"}, {"type": "subtitle", "time": 15317.91, "timestamp": "04:15:17", "text": "この塔。電話がかかってくる"}, {"type": "subtitle", "time": 15319.83, "timestamp": "04:15:19", "text": "家族。"}, {"type": "subtitle", "time": 15322.77, "timestamp": "04:15:22", "text": "えっと、"}, {"type": "subtitle", "time": 15327.11, "timestamp": "04:15:27", "text": "[音楽]"}, {"type": "subtitle", "time": 15328.87, "timestamp": "04:15:28", "text": "それで"}, {"type": "subtitle", "time": 15342.52, "timestamp": "04:15:42", "text": "今。これは何ですか？"}, {"type": "subtitle", "time": 15345.269, "timestamp": "04:15:45", "text": "[音楽]"}, {"type": "subtitle", "time": 15347.67, "timestamp": "04:15:47", "text": "ああ、エレベーターだ。ああ、それはエレ"}, {"type": "subtitle", "time": 15349.91, "timestamp": "04:15:49", "text": "それは"}]
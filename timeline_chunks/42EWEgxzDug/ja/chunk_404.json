[{"type": "subtitle", "time": 24240.948, "timestamp": "06:44:00", "text": "ああ、あと、もし私がこの3つ目をやったら"}, {"type": "subtitle", "time": 24243.03, "timestamp": "06:44:03", "text": "そこに行けば破壊され、すべてが"}, {"type": "subtitle", "time": 24245.91, "timestamp": "06:44:05", "text": "あれらのこと。わかった。"}, {"type": "subtitle", "time": 24253.75, "timestamp": "06:44:13", "text": "性格が良くない人。"}, {"type": "subtitle", "time": 24257.59, "timestamp": "06:44:17", "text": "そして、ブラッド、おかえりなさい。"}, {"type": "subtitle", "time": 24259.91, "timestamp": "06:44:19", "text": "おかえりなさい、ブラッド。"}, {"type": "subtitle", "time": 24267.43, "timestamp": "06:44:27", "text": "待って、"}, {"type": "subtitle", "time": 24276.07, "timestamp": "06:44:36", "text": "ああ、これだ。わかった。"}, {"type": "subtitle", "time": 24284.468, "timestamp": "06:44:44", "text": "「あなたはアメリカ出身ですか？」いいえ、アメリカ出身ではありません。"}, {"type": "subtitle", "time": 24291.59, "timestamp": "06:44:51", "text": "実は私はインド出身なんです。"}]
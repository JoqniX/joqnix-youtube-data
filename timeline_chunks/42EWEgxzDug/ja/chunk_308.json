[{"type": "subtitle", "time": 18490.708, "timestamp": "05:08:10", "text": "働きたい。何が"}, {"type": "subtitle", "time": 18507.67, "timestamp": "05:08:27", "text": "待って、もし私がこれらのボールを取り出して"}, {"type": "subtitle", "time": 18509.83, "timestamp": "05:08:29", "text": "真ん中に置いて、これらを取って"}, {"type": "subtitle", "time": 18514.628, "timestamp": "05:08:34", "text": "軽いものをこちらに置いておく？"}, {"type": "subtitle", "time": 18517.03, "timestamp": "05:08:37", "text": "ジョー、君は科学が好きなの？はい、もちろん"}, {"type": "subtitle", "time": 18519.27, "timestamp": "05:08:39", "text": "私は科学が大好きです。"}, {"type": "subtitle", "time": 18526.31, "timestamp": "05:08:46", "text": "神学的なことはあまり得意ではない"}]
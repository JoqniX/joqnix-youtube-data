[{"type": "subtitle", "time": 13741.75, "timestamp": "03:49:01", "text": "まあ、そうですね。"}, {"type": "subtitle", "time": 13747.269, "timestamp": "03:49:07", "text": "うん。こんにちは。初めての「さあ、行こう」"}, {"type": "subtitle", "time": 13750.63, "timestamp": "03:49:10", "text": "よし、いいぞ、いいぞ、いいぞ。"}, {"type": "subtitle", "time": 13753.75, "timestamp": "03:49:13", "text": "では、待ってください。えっと、待って。チャットができないのはなぜですか？"}, {"type": "subtitle", "time": 13755.67, "timestamp": "03:49:15", "text": "正しく見える？"}, {"type": "subtitle", "time": 13758.55, "timestamp": "03:49:18", "text": "[音楽]"}, {"type": "subtitle", "time": 13768.79, "timestamp": "03:49:28", "text": "チャットを修正させてください。"}, {"type": "subtitle", "time": 13770.71, "timestamp": "03:49:30", "text": "うん。こんにちは、"}, {"type": "subtitle", "time": 13772.71, "timestamp": "03:49:32", "text": "いらっしゃいませ。"}, {"type": "subtitle", "time": 13775.75, "timestamp": "03:49:35", "text": "今日はどんな一日でしたか？"}, {"type": "subtitle", "time": 13778.309, "timestamp": "03:49:38", "text": "あなたの一日はどうでした？"}, {"type": "subtitle", "time": 13786.389, "timestamp": "03:49:46", "text": "待って、"}, {"type": "subtitle", "time": 13790.309, "timestamp": "03:49:50", "text": "こんにちは、ようこそ。"}, {"type": "subtitle", "time": 13798.87, "timestamp": "03:49:58", "text": "何てことだ。それで、どうやら私は気づいたのですが"}]
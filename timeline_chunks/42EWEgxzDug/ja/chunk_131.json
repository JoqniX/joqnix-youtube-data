[{"type": "subtitle", "time": 7862.79, "timestamp": "02:11:02", "text": "戻る。彼女はショーコンサートを開催している"}, {"type": "subtitle", "time": 7866.069, "timestamp": "02:11:06", "text": "あれこれ全部。私は見た"}, {"type": "subtitle", "time": 7870.069, "timestamp": "02:11:10", "text": "ビデオメッセージ機能もね。"}, {"type": "subtitle", "time": 7873.83, "timestamp": "02:11:13", "text": "それは本当に素晴らしかった。"}, {"type": "subtitle", "time": 7875.99, "timestamp": "02:11:15", "text": "えっと、"}, {"type": "subtitle", "time": 7879.51, "timestamp": "02:11:19", "text": "問題は、私は感じていた"}, {"type": "subtitle", "time": 7882.629, "timestamp": "02:11:22", "text": "インスパイヤされた。私も自分のためにそうしたい"}, {"type": "subtitle", "time": 7887.51, "timestamp": "02:11:27", "text": "誕生日パーティー、誰か参加したい人がいたら。"}, {"type": "subtitle", "time": 7890.629, "timestamp": "02:11:30", "text": "えっと、誰かいるかどうかわからないけど"}, {"type": "subtitle", "time": 7894.069, "timestamp": "02:11:34", "text": "賛成だけど、"}, {"type": "subtitle", "time": 7896.47, "timestamp": "02:11:36", "text": "ショーケースビデオメッセージのようにそれを行う"}, {"type": "subtitle", "time": 7899.35, "timestamp": "02:11:39", "text": "みんなから"}, {"type": "subtitle", "time": 7903.03, "timestamp": "02:11:43", "text": "すべてのユーチューバーと"}, {"type": "subtitle", "time": 7906.79, "timestamp": "02:11:46", "text": "私が大切にし、親しくしている人たち"}, {"type": "subtitle", "time": 7915.51, "timestamp": "02:11:55", "text": "でもそれは私たちの子供ではないでしょうか"}]
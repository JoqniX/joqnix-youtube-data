[{"type": "subtitle", "time": 8462.71, "timestamp": "02:21:02", "text": "今の私の考え方ではそれができないが、"}, {"type": "subtitle", "time": 8465.59, "timestamp": "02:21:05", "text": "私はこう思った、"}, {"type": "subtitle", "time": 8467.99, "timestamp": "02:21:07", "text": "私もやってみたいです。誰かいるか見てください"}, {"type": "subtitle", "time": 8471.75, "timestamp": "02:21:11", "text": "やる気満々で、何でも"}, {"type": "subtitle", "time": 8474.389, "timestamp": "02:21:14", "text": "そして見て"}, {"type": "subtitle", "time": 8477.83, "timestamp": "02:21:17", "text": "物事がどうなるか、そしてすべてが"}, {"type": "subtitle", "time": 8485.51, "timestamp": "02:21:25", "text": "えっと"}, {"type": "subtitle", "time": 8488.95, "timestamp": "02:21:28", "text": "他にも何かあるんだけど"}, {"type": "subtitle", "time": 8491.99, "timestamp": "02:21:31", "text": "ウェブサイトに関して言えば、ジョアソン"}, {"type": "subtitle", "time": 8494.71, "timestamp": "02:21:34", "text": "Webサイト。私はウェブページを作成しています"}, {"type": "subtitle", "time": 8500.95, "timestamp": "02:21:40", "text": "そして"}, {"type": "subtitle", "time": 8506.79, "timestamp": "02:21:46", "text": "ページにはしないし、"}, {"type": "subtitle", "time": 8510.309, "timestamp": "02:21:50", "text": "それは一つの出来事だ。私"}, {"type": "subtitle", "time": 8513.349, "timestamp": "02:21:53", "text": "それに関して何か作業をしたいと思っています。私"}, {"type": "subtitle", "time": 8515.83, "timestamp": "02:21:55", "text": "ウェブサイトを見ていて混乱しているだけです"}]
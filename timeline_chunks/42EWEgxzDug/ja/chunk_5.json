[{"type": "subtitle", "time": 309.59, "timestamp": "00:05:09", "text": "これは何ですか？そう、これがコツなんだ"}, {"type": "subtitle", "time": 323.51, "timestamp": "00:05:23", "text": "そう、これが私が"}, {"type": "subtitle", "time": 328.55, "timestamp": "00:05:28", "text": "このイベントの地道な作業をこなす"}, {"type": "subtitle", "time": 330.79, "timestamp": "00:05:30", "text": "これを手に入れるには"}, {"type": "subtitle", "time": 336.31, "timestamp": "00:05:36", "text": "かわいい見た目の宿敵スキン。すごくクール、"}, {"type": "subtitle", "time": 337.83, "timestamp": "00:05:37", "text": "右？"}, {"type": "subtitle", "time": 340.95, "timestamp": "00:05:40", "text": "ええ、早速取り掛かりましょう。えっと、"}, {"type": "subtitle", "time": 343.189, "timestamp": "00:05:43", "text": "埋める。"}, {"type": "subtitle", "time": 345.59000000000003, "timestamp": "00:05:45", "text": "どの伝説を選べばいいですか？私は1万ドル持っています"}, {"type": "subtitle", "time": 348.15, "timestamp": "00:05:48", "text": "左。私はどちらかを購入しようと思っています"}, {"type": "subtitle", "time": 351.99, "timestamp": "00:05:51", "text": "バンテージかニューカッスルか。"}]
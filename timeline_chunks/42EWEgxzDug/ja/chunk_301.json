[{"type": "subtitle", "time": 18080.23, "timestamp": "05:01:20", "text": "うん。うん。すべてを移動する必要がある"}, {"type": "subtitle", "time": 18087.84, "timestamp": "05:01:27", "text": "えっと"}, {"type": "subtitle", "time": 18106.55, "timestamp": "05:01:46", "text": "この2つの壁を手に入れる必要がある、"}, {"type": "subtitle", "time": 18109.03, "timestamp": "05:01:49", "text": "単数形、こちらの2つ。する必要がある"}, {"type": "subtitle", "time": 18111.35, "timestamp": "05:01:51", "text": "この2人を連れ出す"}, {"type": "subtitle", "time": 18116.23, "timestamp": "05:01:56", "text": "そして、それらを右側に脇に置いてください。"}]
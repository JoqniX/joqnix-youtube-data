[{"type": "subtitle", "time": 11283.11, "timestamp": "03:08:03", "text": "私は他人に時間をかけすぎた、"}, {"type": "subtitle", "time": 11287.269, "timestamp": "03:08:07", "text": "私？自分自身に焦点を当てるのではなく、"}, {"type": "subtitle", "time": 11289.429, "timestamp": "03:08:09", "text": "君たち。"}, {"type": "subtitle", "time": 11291.67, "timestamp": "03:08:11", "text": "一度、私は犠牲にしようとしたことがあった"}, {"type": "subtitle", "time": 11294.95, "timestamp": "03:08:14", "text": "自分のコミュニティで他の人を助けるため"}, {"type": "subtitle", "time": 11297.51, "timestamp": "03:08:17", "text": "夢やその他すべてを持つ人々、"}, {"type": "subtitle", "time": 11302.79, "timestamp": "03:08:22", "text": "しかし"}, {"type": "subtitle", "time": 11304.71, "timestamp": "03:08:24", "text": "この時"}, {"type": "subtitle", "time": 11307.269, "timestamp": "03:08:27", "text": "私はそうしたいと思った時、"}, {"type": "subtitle", "time": 11309.99, "timestamp": "03:08:29", "text": "卒業する準備がほぼできていた、あるいは"}, {"type": "subtitle", "time": 11311.59, "timestamp": "03:08:31", "text": "上"}, {"type": "subtitle", "time": 11314.95, "timestamp": "03:08:34", "text": "だって、自分が何をすればいいのか分からなかったから。何"}, {"type": "subtitle", "time": 11318.309, "timestamp": "03:08:38", "text": "それは私ができることであり、私たちが持っていたものすべてです"}, {"type": "subtitle", "time": 11320.469, "timestamp": "03:08:40", "text": "それらの問題は、私たちはあちこちで経験しました。"}, {"type": "subtitle", "time": 11323.11, "timestamp": "03:08:43", "text": "この年の経過とこれら"}, {"type": "subtitle", "time": 11325.99, "timestamp": "03:08:45", "text": "数年後、私はアンチから戻ってきた"}, {"type": "subtitle", "time": 11327.67, "timestamp": "03:08:47", "text": "これは新しい章だと言い、"}, {"type": "subtitle", "time": 11329.75, "timestamp": "03:08:49", "text": "すべて正しい"}, {"type": "subtitle", "time": 11332.389, "timestamp": "03:08:52", "text": "うん、ここでネガティブなことを言いたくないんだ"}, {"type": "subtitle", "time": 11336.55, "timestamp": "03:08:56", "text": "でもそうだね、インポサー症候群の警告"}]
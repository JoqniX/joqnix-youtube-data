[{"type": "subtitle", "time": 11641.75, "timestamp": "03:14:01", "text": "共同作業として進めましょう"}, {"type": "subtitle", "time": 11645.19, "timestamp": "03:14:05", "text": "一緒に。それは私だけの努力ではない。"}, {"type": "subtitle", "time": 11647.75, "timestamp": "03:14:07", "text": "みんなに、みんなでやろう"}, {"type": "subtitle", "time": 11650.71, "timestamp": "03:14:10", "text": "これを一緒に。よし、それが私の望みだった"}, {"type": "subtitle", "time": 11652.79, "timestamp": "03:14:12", "text": "言うと。"}, {"type": "subtitle", "time": 11656.309, "timestamp": "03:14:16", "text": "はい、最善を尽くします。私は私は"}, {"type": "subtitle", "time": 11660.87, "timestamp": "03:14:20", "text": "私が最善を尽くせることをお見せします。"}, {"type": "subtitle", "time": 11664.15, "timestamp": "03:14:24", "text": "だから、どうか私を見守ってください、そして私の"}, {"type": "subtitle", "time": 11666.63, "timestamp": "03:14:26", "text": "旅。"}, {"type": "subtitle", "time": 11671.51, "timestamp": "03:14:31", "text": "うん、それもうまくいくといいな。"}, {"type": "subtitle", "time": 11675.03, "timestamp": "03:14:35", "text": "ああ、奇跡が起こる。私はできるだろう"}, {"type": "subtitle", "time": 11678.87, "timestamp": "03:14:38", "text": "十分な"}, {"type": "subtitle", "time": 11682.71, "timestamp": "03:14:42", "text": "実際に"}, {"type": "subtitle", "time": 11684.309, "timestamp": "03:14:44", "text": "置く"}, {"type": "subtitle", "time": 11686.95, "timestamp": "03:14:46", "text": "新しく作ったスポーツマンを連れてきて"}, {"type": "subtitle", "time": 11692.15, "timestamp": "03:14:52", "text": "もう1年になります。うん。"}, {"type": "subtitle", "time": 11695.19, "timestamp": "03:14:55", "text": "ええ、良い経験でしたよ。新しい"}, {"type": "subtitle", "time": 11696.71, "timestamp": "03:14:56", "text": "経験。"}, {"type": "subtitle", "time": 11699.429, "timestamp": "03:14:59", "text": "うん。そして"}]
[{"type": "subtitle", "time": 11526.389, "timestamp": "03:12:06", "text": "そう、そうしたかったのは"}, {"type": "subtitle", "time": 11530.469, "timestamp": "03:12:10", "text": "みんな私に親切にしてくれて、"}, {"type": "subtitle", "time": 11534.23, "timestamp": "03:12:14", "text": "もっとお金を使いたかったんです"}, {"type": "subtitle", "time": 11537.349, "timestamp": "03:12:17", "text": "時間、かな。私は再び始めます"}, {"type": "subtitle", "time": 11539.11, "timestamp": "03:12:19", "text": "私の人生の新たな章が始まります"}, {"type": "subtitle", "time": 11540.71, "timestamp": "03:12:20", "text": "日本。"}, {"type": "subtitle", "time": 11543.59, "timestamp": "03:12:23", "text": "だから、友達になったみんなに会えなくなるのが寂しい。"}, {"type": "subtitle", "time": 11546.63, "timestamp": "03:12:26", "text": "そして、同じ時期に生まれたのは誰ですか？"}, {"type": "subtitle", "time": 11548.95, "timestamp": "03:12:28", "text": "私はインド出身なので、ゾーンです。すべての"}, {"type": "subtitle", "time": 11552.469, "timestamp": "03:12:32", "text": "インド人の友達ができて寂しくなるだろう"}, {"type": "subtitle", "time": 11554.55, "timestamp": "03:12:34", "text": "今はたくさんあります。"}, {"type": "subtitle", "time": 11559.51, "timestamp": "03:12:39", "text": "だから、私は、"}, {"type": "subtitle", "time": 11561.51, "timestamp": "03:12:41", "text": "彼らとより多くの時間を過ごし、"}, {"type": "subtitle", "time": 11564.95, "timestamp": "03:12:44", "text": "楽しい。そう、このジョアソンはそういう人物なんだ。"}, {"type": "subtitle", "time": 11568.309, "timestamp": "03:12:48", "text": "私にとっては大きなイベントだと思います。"}, {"type": "subtitle", "time": 11570.309, "timestamp": "03:12:50", "text": "準備不足ではあるけれど。私はそうは思わない"}, {"type": "subtitle", "time": 11573.269, "timestamp": "03:12:53", "text": "サバソンやドナソンの仕組みを知っておくと、"}, {"type": "subtitle", "time": 11575.91, "timestamp": "03:12:55", "text": "すべて。でも、ぶっつけ本番でやってみるよ。"}, {"type": "subtitle", "time": 11579.11, "timestamp": "03:12:59", "text": "私はそれをするつもりです"}]
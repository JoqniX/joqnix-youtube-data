[{"type": "subtitle", "time": 4261.83, "timestamp": "01:11:01", "text": "どの伝説を選べばいいですか？私は1万ドル持っています"}, {"type": "subtitle", "time": 4264.39, "timestamp": "01:11:04", "text": "左。私はどちらかを購入しようと思っています"}, {"type": "subtitle", "time": 4268.229, "timestamp": "01:11:08", "text": "バンテージかニューカッスルか。"}, {"type": "subtitle", "time": 4301.11, "timestamp": "01:11:41", "text": "私たちは"}, {"type": "subtitle", "time": 4303.35, "timestamp": "01:11:43", "text": "教会の席へ向かう"}]
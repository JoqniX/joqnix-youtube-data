[{"type": "subtitle", "time": 18794.948, "timestamp": "05:13:14", "text": "問題は、これをどうやって手に入れるかだ"}, {"type": "subtitle", "time": 18802.15, "timestamp": "05:13:22", "text": "とても複雑です。"}, {"type": "subtitle", "time": 18816.47, "timestamp": "05:13:36", "text": "そして、探している方への免責事項"}, {"type": "subtitle", "time": 18819.35, "timestamp": "05:13:39", "text": "私に苦しみを与えてください。私は実際"}, {"type": "subtitle", "time": 18821.75, "timestamp": "05:13:41", "text": "苦痛に苛まれる。"}]
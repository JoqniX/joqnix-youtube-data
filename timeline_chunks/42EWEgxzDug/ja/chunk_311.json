[{"type": "subtitle", "time": 18665.43, "timestamp": "05:11:05", "text": "ボールを全部取り出すべきだったのだろうか？"}, {"type": "subtitle", "time": 18668.948, "timestamp": "05:11:08", "text": "待って。ええ、最初はIllustratorから始めました。"}, {"type": "subtitle", "time": 18672.07, "timestamp": "05:11:12", "text": "私は今、少しずつ学んでいるところです。ええ、わかってます"}, {"type": "subtitle", "time": 18675.67, "timestamp": "05:11:15", "text": "Photoshopのような基本的なもの、"}, {"type": "subtitle", "time": 18693.99, "timestamp": "05:11:33", "text": "鍵はまずボールを動かすことだった。えっと"}, {"type": "subtitle", "time": 18704.788, "timestamp": "05:11:44", "text": "もし私がそれをここに置いて"}, {"type": "subtitle", "time": 18708.07, "timestamp": "05:11:48", "text": "これを一番奥まで置いてください。"}, {"type": "subtitle", "time": 18711.19, "timestamp": "05:11:51", "text": "本当に近いところまで来ています。"}, {"type": "subtitle", "time": 18713.75, "timestamp": "05:11:53", "text": "もうすぐ完成です。ただこれだけです"}, {"type": "subtitle", "time": 18716.39, "timestamp": "05:11:56", "text": "こっちの奴め。"}, {"type": "subtitle", "time": 18718.23, "timestamp": "05:11:58", "text": "だから、あなたをずっと動かさなければならない"}]
[{"type": "subtitle", "time": 8761.83, "timestamp": "02:26:01", "text": "4月1日には私はこうなるだろう"}, {"type": "subtitle", "time": 8764.15, "timestamp": "02:26:04", "text": "日本で"}, {"type": "subtitle", "time": 8767.03, "timestamp": "02:26:07", "text": "一瞬。"}, {"type": "subtitle", "time": 8769.27, "timestamp": "02:26:09", "text": "だから、私には時間がある。"}, {"type": "subtitle", "time": 8772.55, "timestamp": "02:26:12", "text": "私には時間がたくさんあります。"}, {"type": "subtitle", "time": 8775.83, "timestamp": "02:26:15", "text": "そして私は"}, {"type": "subtitle", "time": 8779.429, "timestamp": "02:26:19", "text": "かなり疑わしい"}, {"type": "subtitle", "time": 8783.99, "timestamp": "02:26:23", "text": "家族が許してくれるなら"}, {"type": "subtitle", "time": 8787.99, "timestamp": "02:26:27", "text": "インドから出国させてください。いや、いや。"}, {"type": "subtitle", "time": 8791.27, "timestamp": "02:26:31", "text": "私の州外のようなものです。"}, {"type": "subtitle", "time": 8793.67, "timestamp": "02:26:33", "text": "私の州外"}, {"type": "subtitle", "time": 8796.55, "timestamp": "02:26:36", "text": "私ができる範囲で、"}, {"type": "subtitle", "time": 8808.55, "timestamp": "02:26:48", "text": "ムンバイに行くか、プネーに行くか、どこか"}, {"type": "subtitle", "time": 8811.429, "timestamp": "02:26:51", "text": "あるいはコルカタでも、それらは"}, {"type": "subtitle", "time": 8814.79, "timestamp": "02:26:54", "text": "すごく遠い。いや、いや、いや。"}, {"type": "chat", "time": 8816.023, "timestamp": "02:26:56", "author": "@wildan19gta73", "avatar": "https://yt4.ggpht.com/ytc/AIdro_ltgSuqdkVmFy7b8YNX34dHb6whG0lODXr6m68zEAgk=s64-c-k-c0x00ffffff-no-rj", "message": "*sneak in*"}, {"type": "subtitle", "time": 8817.03, "timestamp": "02:26:57", "text": "そこが問題なんです。私はとても遠く感じて"}]
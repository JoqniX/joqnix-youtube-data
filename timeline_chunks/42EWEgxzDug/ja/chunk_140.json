[{"type": "subtitle", "time": 8401.83, "timestamp": "02:20:01", "text": "それって良くないことだと思うんだけど、そうでしょ？"}, {"type": "subtitle", "time": 8404.71, "timestamp": "02:20:04", "text": "もちろん、VODも引き続き提供できます。"}, {"type": "subtitle", "time": 8407.91, "timestamp": "02:20:07", "text": "ある意味では。"}, {"type": "subtitle", "time": 8409.51, "timestamp": "02:20:09", "text": "えっと"}, {"type": "subtitle", "time": 8411.75, "timestamp": "02:20:11", "text": "おそらく"}, {"type": "subtitle", "time": 8413.91, "timestamp": "02:20:13", "text": "明日から日本語"}, {"type": "subtitle", "time": 8419.27, "timestamp": "02:20:19", "text": "授業が始まると、"}, {"type": "subtitle", "time": 8422.63, "timestamp": "02:20:22", "text": "ああ、何とかしないといけないな。"}, {"type": "subtitle", "time": 8425.11, "timestamp": "02:20:25", "text": "どうしたらいいのか分からない。えっと"}, {"type": "subtitle", "time": 8426.95, "timestamp": "02:20:26", "text": "まるで夜になるかのようだ。私は持っている"}, {"type": "subtitle", "time": 8429.51, "timestamp": "02:20:29", "text": "それに関して何の確認も取れていない"}, {"type": "subtitle", "time": 8435.91, "timestamp": "02:20:35", "text": "私は多くのことを調整しなければならないし"}, {"type": "subtitle", "time": 8438.79, "timestamp": "02:20:38", "text": "たくさんのことをキャンセルする。"}, {"type": "subtitle", "time": 8445.99, "timestamp": "02:20:45", "text": "でも、うん、いろいろ考えていたんだ"}, {"type": "subtitle", "time": 8452.87, "timestamp": "02:20:52", "text": "えーと、コミッションの開始とか"}, {"type": "subtitle", "time": 8459.19, "timestamp": "02:20:59", "text": "右？まるでそれが私の理想だとわかっているように"}]
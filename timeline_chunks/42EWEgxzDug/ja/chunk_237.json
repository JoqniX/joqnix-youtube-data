[{"type": "subtitle", "time": 14223.91, "timestamp": "03:57:03", "text": "私も自分の健康状態が心配です。"}, {"type": "subtitle", "time": 14225.59, "timestamp": "03:57:05", "text": "また"}, {"type": "subtitle", "time": 14231.11, "timestamp": "03:57:11", "text": "残念ながら、ホラーは私には合わない"}, {"type": "subtitle", "time": 14234.55, "timestamp": "03:57:14", "text": "痛みはあるけれど"}, {"type": "subtitle", "time": 14237.75, "timestamp": "03:57:17", "text": "今日を無事に過ごせることを願います。"}, {"type": "subtitle", "time": 14239.83, "timestamp": "03:57:19", "text": "えっと、このゲームってどれくらいの長さでしたっけ？私"}, {"type": "subtitle", "time": 14241.91, "timestamp": "03:57:21", "text": "一日で終わらせられると思うんだけど、どうかな？"}, {"type": "subtitle", "time": 14244.15, "timestamp": "03:57:24", "text": "そうでない場合は、"}, {"type": "subtitle", "time": 14247.03, "timestamp": "03:57:27", "text": "シリーズ作品だと思う。"}, {"type": "subtitle", "time": 14249.03, "timestamp": "03:57:29", "text": "ホラーゲームに関する提案がいくつかあります。"}, {"type": "subtitle", "time": 14251.59, "timestamp": "03:57:31", "text": "はい、Discordで私に提案してください。"}, {"type": "subtitle", "time": 14254.55, "timestamp": "03:57:34", "text": "配信中だから、メッセージはえーと"}, {"type": "subtitle", "time": 14256.63, "timestamp": "03:57:36", "text": "ログイン済みですよね？だから、私はただ見るだけで"}, {"type": "subtitle", "time": 14258.229, "timestamp": "03:57:38", "text": "それ。"}, {"type": "subtitle", "time": 14260.95, "timestamp": "03:57:40", "text": "うん、それはうまくいくよ。"}, {"type": "subtitle", "time": 14263.59, "timestamp": "03:57:43", "text": "それでは、早速ゲームを始めましょう。えっと"}, {"type": "subtitle", "time": 14266.229, "timestamp": "03:57:46", "text": "これを開けてみましょう。"}, {"type": "subtitle", "time": 14269.83, "timestamp": "03:57:49", "text": "昨日ゲームを開いたばかりで"}, {"type": "subtitle", "time": 14273.59, "timestamp": "03:57:53", "text": "調べてみたよ。"}, {"type": "subtitle", "time": 14275.75, "timestamp": "03:57:55", "text": "では、設定などについて。わかった、"}]
[{"type": "subtitle", "time": 9120.55, "timestamp": "02:32:00", "text": "まだ出ていない"}, {"type": "subtitle", "time": 9127.75, "timestamp": "02:32:07", "text": "それで"}, {"type": "subtitle", "time": 9130.309, "timestamp": "02:32:10", "text": "私は適切な誘惑を作ります"}, {"type": "subtitle", "time": 9133.59, "timestamp": "02:32:13", "text": "テーブルみたいなもの。"}, {"type": "subtitle", "time": 9149.59, "timestamp": "02:32:29", "text": "私は何かをしている。何てことだ。病気"}, {"type": "subtitle", "time": 9168.15, "timestamp": "02:32:48", "text": "えっと、ちょっと待ってください。私は、"}, {"type": "subtitle", "time": 9171.27, "timestamp": "02:32:51", "text": "電話して、どうしたのか聞いてみる。私はほしくない"}, {"type": "subtitle", "time": 9175.59, "timestamp": "02:32:55", "text": "彼らが私にこんな風に電話をかけ続けること。"}, {"type": "subtitle", "time": 9177.91, "timestamp": "02:32:57", "text": "だから、私はただ"}]
[{"type": "subtitle", "time": 17521.83, "timestamp": "04:52:01", "text": "あまり時間がかからないといいのですが"}, {"type": "subtitle", "time": 17540.15, "timestamp": "04:52:20", "text": "もしかしたら掲載できるかもしれない。はい、できます"}, {"type": "subtitle", "time": 17542.39, "timestamp": "04:52:22", "text": "それを持ち上げる。"}, {"type": "subtitle", "time": 17555.51, "timestamp": "04:52:35", "text": "私は何をしようとしているのか？えっと、たぶんこんな感じかな"}, {"type": "subtitle", "time": 17568.788, "timestamp": "04:52:48", "text": "私は何か間違ったことをしているのだろうか？わからない。これ"}, {"type": "subtitle", "time": 17571.99, "timestamp": "04:52:51", "text": "なんだか、"}, {"type": "subtitle", "time": 17573.99, "timestamp": "04:52:53", "text": "ある意味、それはただ"}, {"type": "subtitle", "time": 17575.99, "timestamp": "04:52:55", "text": "それ。"}]
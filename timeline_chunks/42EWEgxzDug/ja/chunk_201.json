[{"type": "subtitle", "time": 12061.99, "timestamp": "03:21:01", "text": "影響を受ける。ええ、ただ"}, {"type": "subtitle", "time": 12064.389, "timestamp": "03:21:04", "text": "これを機能させるには、私はただ知りたいだけです 私は知りません"}, {"type": "subtitle", "time": 12066.63, "timestamp": "03:21:06", "text": "私は自分の"}, {"type": "subtitle", "time": 12069.83, "timestamp": "03:21:09", "text": "私が依頼した人たちを保留にする"}, {"type": "subtitle", "time": 12072.95, "timestamp": "03:21:12", "text": "だって、今はお金がないんだもん。"}, {"type": "subtitle", "time": 12076.229, "timestamp": "03:21:16", "text": "でも、まあ、すべてがうまくいくことを願おう"}, {"type": "subtitle", "time": 12079.269, "timestamp": "03:21:19", "text": "良い。私は彼らに、自分が"}, {"type": "subtitle", "time": 12082.71, "timestamp": "03:21:22", "text": "クラウドファンディングみたいなことをして"}, {"type": "subtitle", "time": 12084.309, "timestamp": "03:21:24", "text": "委託業務を遂行し、"}, {"type": "subtitle", "time": 12086.87, "timestamp": "03:21:26", "text": "すべて。そうですね、期待しましょう"}, {"type": "subtitle", "time": 12089.349, "timestamp": "03:21:29", "text": "すべて順調に進んで、約束します"}, {"type": "subtitle", "time": 12091.83, "timestamp": "03:21:31", "text": "あなたには、私はそのお金を使わない"}, {"type": "subtitle", "time": 12094.309, "timestamp": "03:21:34", "text": "他に何か。それはただ単に"}, {"type": "subtitle", "time": 12096.79, "timestamp": "03:21:36", "text": "デビュー。すべてはVのためだけ"}, {"type": "subtitle", "time": 12099.99, "timestamp": "03:21:39", "text": "モデルをリギングするためのチューブ、"}, {"type": "subtitle", "time": 12102.87, "timestamp": "03:21:42", "text": "とても素敵なモデルさんで、私は彼女が大好き。"}, {"type": "subtitle", "time": 12106.55, "timestamp": "03:21:46", "text": "ええ、それとその他必要なもの"}, {"type": "subtitle", "time": 12109.19, "timestamp": "03:21:49", "text": "デビューとか色々ね。"}, {"type": "subtitle", "time": 12111.19, "timestamp": "03:21:51", "text": "完璧なものを手に入れることはできないけれど"}, {"type": "subtitle", "time": 12114.87, "timestamp": "03:21:54", "text": "デビュー当時、私は多くのことを思い描いていました。"}, {"type": "subtitle", "time": 12117.91, "timestamp": "03:21:57", "text": "面白いことに、私のデビューは"}]
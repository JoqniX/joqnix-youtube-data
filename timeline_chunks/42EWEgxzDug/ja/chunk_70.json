[{"type": "subtitle", "time": 4200.95, "timestamp": "01:10:00", "text": "ああ、彼らは本当にクールだ。何てことだ。ああ、"}, {"type": "subtitle", "time": 4211.91, "timestamp": "01:10:11", "text": "何てことだ。肌がすごくいい感じ。私は好きです"}, {"type": "subtitle", "time": 4225.51, "timestamp": "01:10:25", "text": "待って。これは何ですか？ええ、これは"}, {"type": "subtitle", "time": 4239.75, "timestamp": "01:10:39", "text": "そう、これが私が"}, {"type": "subtitle", "time": 4244.79, "timestamp": "01:10:44", "text": "このイベントの地道な作業をこなす"}, {"type": "subtitle", "time": 4247.03, "timestamp": "01:10:47", "text": "これを手に入れるには"}, {"type": "subtitle", "time": 4252.55, "timestamp": "01:10:52", "text": "かわいい見た目の宿敵スキン。すごくクール、"}, {"type": "subtitle", "time": 4254.07, "timestamp": "01:10:54", "text": "右？"}, {"type": "subtitle", "time": 4257.11, "timestamp": "01:10:57", "text": "ええ、早速取り掛かりましょう。えーと、"}, {"type": "subtitle", "time": 4259.43, "timestamp": "01:10:59", "text": "フィル。"}]
[{"type": "subtitle", "time": 1142.63, "timestamp": "00:19:02", "text": "ああ、この二人はキャンプをしているんだ。ニース。彼らは"}, {"type": "subtitle", "time": 1150.63, "timestamp": "00:19:10", "text": "どうして敵をそんな風に捉えたのですか？おお"}, {"type": "subtitle", "time": 1153.51, "timestamp": "00:19:13", "text": "我が神よ、"}, {"type": "subtitle", "time": 1156.15, "timestamp": "00:19:16", "text": "この男は視力が良い"}, {"type": "subtitle", "time": 1183.59, "timestamp": "00:19:43", "text": "うん、もし私がこれを話したくないなら、行って"}, {"type": "subtitle", "time": 1186.07, "timestamp": "00:19:46", "text": "に"}]
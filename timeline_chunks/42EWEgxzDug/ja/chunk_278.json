[{"type": "subtitle", "time": 16699.75, "timestamp": "04:38:19", "text": "だから私はそうすべきだと思う"}, {"type": "subtitle", "time": 16713.109, "timestamp": "04:38:33", "text": "私は信じている。右。じゃあ待って、"}, {"type": "subtitle", "time": 16717.349, "timestamp": "04:38:37", "text": "この汽車は出発します。"}, {"type": "subtitle", "time": 16720.39, "timestamp": "04:38:40", "text": "ここに来て。"}, {"type": "subtitle", "time": 16723.75, "timestamp": "04:38:43", "text": "それから、あの赤い部屋に入ります。わかった。"}, {"type": "subtitle", "time": 16726.869, "timestamp": "04:38:46", "text": "では、どうやって元に戻せばいいのでしょうか？それで"}, {"type": "subtitle", "time": 16730.39, "timestamp": "04:38:50", "text": "今、あなたは、あなたがどのように"}, {"type": "subtitle", "time": 16733.349, "timestamp": "04:38:53", "text": "こちらの車両がハイライト表示されています。それで"}, {"type": "subtitle", "time": 16737.269, "timestamp": "04:38:57", "text": "それがそれを物語っている。えっと、私は行くことになっているんだけど"}]
[{"type": "subtitle", "time": 19281.03, "timestamp": "05:21:21", "text": "いいえ。その前に、卵はどこにある？"}, {"type": "subtitle", "time": 19284.09, "timestamp": "05:21:24", "text": "それとも、あの物？"}, {"type": "subtitle", "time": 19299.14, "timestamp": "05:21:39", "text": "コンソールは"}, {"type": "subtitle", "time": 19319.35, "timestamp": "05:21:59", "text": "[音楽]"}]
[{"type": "subtitle", "time": 3003.03, "timestamp": "00:50:03", "text": "ああ、そうだな。 Discordアプリ。待って、あなたは"}, {"type": "subtitle", "time": 3005.51, "timestamp": "00:50:05", "text": "2 つの Discord クライアントを"}, {"type": "subtitle", "time": 3013.75, "timestamp": "00:50:13", "text": "あ、待って。電話またはモバイル端末をご利用ですか？"}, {"type": "subtitle", "time": 3016.47, "timestamp": "00:50:16", "text": "だから、"}, {"type": "subtitle", "time": 3020.47, "timestamp": "00:50:20", "text": "B、どうやって"}, {"type": "subtitle", "time": 3027.19, "timestamp": "00:50:27", "text": "だって、なんとなく理解できた気がするから"}, {"type": "subtitle", "time": 3032.23, "timestamp": "00:50:32", "text": "あなたが言いたかったのはそういうことです。つまり、文字通り"}, {"type": "subtitle", "time": 3034.87, "timestamp": "00:50:34", "text": "まるで私が参加するようなものです"}, {"type": "subtitle", "time": 3039.03, "timestamp": "00:50:39", "text": "何らかのサーバーですよね？ Discordサーバー。"}, {"type": "subtitle", "time": 3041.03, "timestamp": "00:50:41", "text": "待って、"}, {"type": "subtitle", "time": 3043.829, "timestamp": "00:50:43", "text": "Discordサーバー。"}, {"type": "subtitle", "time": 3046.15, "timestamp": "00:50:46", "text": "つまり、私がサーバーに参加すると、"}, {"type": "subtitle", "time": 3048.47, "timestamp": "00:50:48", "text": "まずカナリアを見せてください。例えば、"}, {"type": "subtitle", "time": 3051.91, "timestamp": "00:50:51", "text": "旅路、ですよね？この参加をクリックすると"}, {"type": "subtitle", "time": 3053.99, "timestamp": "00:50:53", "text": "サーバーですよね？"}, {"type": "subtitle", "time": 3057.03, "timestamp": "00:50:57", "text": "カナリアが表示されます。"}, {"type": "subtitle", "time": 3058.79, "timestamp": "00:50:58", "text": "「同意する」をクリックすると、"}]
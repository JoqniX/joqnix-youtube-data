[{"type": "subtitle", "time": 21301.59, "timestamp": "05:55:01", "text": "[音楽]"}, {"type": "subtitle", "time": 21328.708, "timestamp": "05:55:28", "text": "わかりました、私がそうでないことを確認しましょう"}, {"type": "subtitle", "time": 21333.59, "timestamp": "05:55:33", "text": "今、Discordのビープ音が聞こえた。待って、待って。"}, {"type": "subtitle", "time": 21343.51, "timestamp": "05:55:43", "text": "ぼかさせてください。放してくれ。放してくれ。させて"}, {"type": "subtitle", "time": 21352.788, "timestamp": "05:55:52", "text": "わかった。全て配信モードになっています。"}]
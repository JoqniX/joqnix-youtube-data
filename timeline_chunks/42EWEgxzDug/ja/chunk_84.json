[{"type": "subtitle", "time": 5045.91, "timestamp": "01:24:05", "text": "[音楽]"}, {"type": "subtitle", "time": 5058.79, "timestamp": "01:24:18", "text": "この二人はキャンプをしている。ニース。彼らは"}, {"type": "subtitle", "time": 5066.709, "timestamp": "01:24:26", "text": "どうして敵をそんな風に捉えたのですか？おお"}, {"type": "subtitle", "time": 5069.669, "timestamp": "01:24:29", "text": "我が神よ。"}, {"type": "subtitle", "time": 5072.31, "timestamp": "01:24:32", "text": "この男は視力が良い"}, {"type": "subtitle", "time": 5098.79, "timestamp": "01:24:58", "text": "うん。でも、もし私が話さないのが好きなら"}]
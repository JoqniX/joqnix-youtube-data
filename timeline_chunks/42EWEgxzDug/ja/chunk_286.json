[{"type": "subtitle", "time": 17161.91, "timestamp": "04:46:01", "text": "再起動した方がいいでしょうか？"}, {"type": "subtitle", "time": 17173.91, "timestamp": "04:46:13", "text": "なぜそう言うのか？それは"}, {"type": "subtitle", "time": 17210.23, "timestamp": "04:46:50", "text": "私はどうすべきでしょうか？私の一部はあなたが"}, {"type": "subtitle", "time": 17213.51, "timestamp": "04:46:53", "text": "ほら、この卵が光っているのがわかるでしょう。行う"}, {"type": "subtitle", "time": 17215.75, "timestamp": "04:46:55", "text": "あるいは、そんな感じ。"}]
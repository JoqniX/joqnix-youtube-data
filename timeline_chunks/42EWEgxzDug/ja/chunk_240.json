[{"type": "subtitle", "time": 14400.71, "timestamp": "04:00:00", "text": "この木箱は何ですか？"}, {"type": "subtitle", "time": 14410.07, "timestamp": "04:00:10", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 14419.83, "timestamp": "04:00:19", "text": "ああ、大変だ。ああ、大変だ。本当にそうすべきでしょうか？私は"}, {"type": "subtitle", "time": 14421.83, "timestamp": "04:00:21", "text": "本当にこれをプレイしたいですか？向きを変えるべきか"}, {"type": "subtitle", "time": 14425.429, "timestamp": "04:00:25", "text": "私の電気は消えているの？私は"}, {"type": "subtitle", "time": 14427.99, "timestamp": "04:00:27", "text": "電気を消してください。わかった。感覚をつかむには、"}, {"type": "subtitle", "time": 14429.75, "timestamp": "04:00:29", "text": "知る、"}, {"type": "subtitle", "time": 14431.83, "timestamp": "04:00:31", "text": "夕方であることが多いですが、"}, {"type": "subtitle", "time": 14434.229, "timestamp": "04:00:34", "text": "右？わかった。"}, {"type": "subtitle", "time": 14439.75, "timestamp": "04:00:39", "text": "お願いします。"}]
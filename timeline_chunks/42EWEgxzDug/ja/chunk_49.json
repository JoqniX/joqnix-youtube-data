[{"type": "subtitle", "time": 2943.03, "timestamp": "00:49:03", "text": "えっと、スペースがない場合は"}, {"type": "subtitle", "time": 2945.27, "timestamp": "00:49:05", "text": "メインアカウントでサーバーに参加しないでください"}, {"type": "subtitle", "time": 2949.109, "timestamp": "00:49:09", "text": "メインアカウントから参加するのは1つだけです"}, {"type": "subtitle", "time": 2952.47, "timestamp": "00:49:12", "text": "もしあなたがこれを望むなら"}, {"type": "subtitle", "time": 2954.95, "timestamp": "00:49:14", "text": "通知を受け取るなど、"}, {"type": "subtitle", "time": 2957.27, "timestamp": "00:49:17", "text": "フォローする"}, {"type": "subtitle", "time": 2959.99, "timestamp": "00:49:19", "text": "サーバー内のサーバーへのチャンネルをアップします"}, {"type": "subtitle", "time": 2975.27, "timestamp": "00:49:35", "text": "うん、主なコラボは"}, {"type": "subtitle", "time": 2977.13, "timestamp": "00:49:37", "text": "ショーとかそういうもの。"}]
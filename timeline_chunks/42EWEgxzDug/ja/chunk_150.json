[{"type": "subtitle", "time": 9002.95, "timestamp": "02:30:02", "text": "深刻な内容がたくさんある。考えていた"}, {"type": "subtitle", "time": 9007.91, "timestamp": "02:30:07", "text": "ストリームのために何かを成し遂げるような"}, {"type": "subtitle", "time": 9009.67, "timestamp": "02:30:09", "text": "正直に。"}, {"type": "subtitle", "time": 9011.75, "timestamp": "02:30:11", "text": "たくさんの"}, {"type": "subtitle", "time": 9014.55, "timestamp": "02:30:14", "text": "アプリケーションのようなもの、開発者のようなもの"}, {"type": "subtitle", "time": 9016.87, "timestamp": "02:30:16", "text": "もの。うん。"}, {"type": "subtitle", "time": 9019.11, "timestamp": "02:30:19", "text": "えっと"}, {"type": "subtitle", "time": 9022.15, "timestamp": "02:30:22", "text": "ある意味、それは必要ない"}, {"type": "subtitle", "time": 9024.63, "timestamp": "02:30:24", "text": "でも、そうしても大丈夫だと感じました。私"}, {"type": "subtitle", "time": 9026.55, "timestamp": "02:30:26", "text": "ただ終わらせたいだけなんです。未完了"}, {"type": "subtitle", "time": 9028.309, "timestamp": "02:30:28", "text": "オフにする。何かしたいだけなんです"}, {"type": "subtitle", "time": 9036.07, "timestamp": "02:30:36", "text": "ええ、それが私の望みです。"}, {"type": "subtitle", "time": 9037.83, "timestamp": "02:30:37", "text": "それで、"}, {"type": "subtitle", "time": 9040.63, "timestamp": "02:30:40", "text": "うん。えっと"}, {"type": "subtitle", "time": 9044.389, "timestamp": "02:30:44", "text": "いくつかやろうと思っていたことがある"}, {"type": "subtitle", "time": 9048.71, "timestamp": "02:30:48", "text": "時刻表システムのようにリリースする"}, {"type": "subtitle", "time": 9053.27, "timestamp": "02:30:53", "text": "楽しいことがたくさんあるので、"}, {"type": "subtitle", "time": 9056.87, "timestamp": "02:30:56", "text": "24時間ずっと私を見ているか、"}, {"type": "subtitle", "time": 9059.27, "timestamp": "02:30:59", "text": "私が24時間配信していることを知っている"}]
[{"type": "subtitle", "time": 12120.55, "timestamp": "03:22:00", "text": "私が見たもの 私は以前はそれを"}, {"type": "subtitle", "time": 12125.19, "timestamp": "03:22:05", "text": "結婚式は一大イベントのようなもの"}, {"type": "subtitle", "time": 12128.87, "timestamp": "03:22:08", "text": "だって、えっと、何をするの？"}, {"type": "subtitle", "time": 12130.71, "timestamp": "03:22:10", "text": "結婚式？あなたは全てを捧げ、"}, {"type": "subtitle", "time": 12133.51, "timestamp": "03:22:13", "text": "右？できる限り壮大に、"}, {"type": "subtitle", "time": 12137.51, "timestamp": "03:22:17", "text": "右？でも実際は、問題ないんです。として"}, {"type": "subtitle", "time": 12140.07, "timestamp": "03:22:20", "text": "小規模なクリエイターなので、作る必要はありません"}, {"type": "subtitle", "time": 12143.67, "timestamp": "03:22:23", "text": "派手すぎる、高すぎる、または"}, {"type": "subtitle", "time": 12146.63, "timestamp": "03:22:26", "text": "過負荷状態です。いいえ、"}, {"type": "subtitle", "time": 12149.349, "timestamp": "03:22:29", "text": "デビューは単なるイベントに過ぎない。"}, {"type": "subtitle", "time": 12153.03, "timestamp": "03:22:33", "text": "デビューは人生の一大イベントか何かだ"}, {"type": "subtitle", "time": 12155.75, "timestamp": "03:22:35", "text": "あなたの旅の中で、その瞬間を刻むもの"}, {"type": "subtitle", "time": 12158.15, "timestamp": "03:22:38", "text": "そう、デビューさせたんだ。私はここにいます。私は"}, {"type": "subtitle", "time": 12161.429, "timestamp": "03:22:41", "text": "生きているものみたいなもの"}, {"type": "subtitle", "time": 12163.11, "timestamp": "03:22:43", "text": "まるで自己紹介をしているかのように"}, {"type": "subtitle", "time": 12165.349, "timestamp": "03:22:45", "text": "世界中の誰もがあなたが誰であるかを知り、"}, {"type": "subtitle", "time": 12168.79, "timestamp": "03:22:48", "text": "あなたが何者であるか、そしてすべて"}, {"type": "subtitle", "time": 12170.309, "timestamp": "03:22:50", "text": "右"}, {"type": "subtitle", "time": 12174.229, "timestamp": "03:22:54", "text": "ええ、そうですね"}, {"type": "subtitle", "time": 12177.429, "timestamp": "03:22:57", "text": "決めるのはあなた次第です"}]
[{"type": "subtitle", "time": 7269.75, "timestamp": "02:01:09", "text": "そして"}, {"type": "subtitle", "time": 7274.229, "timestamp": "02:01:14", "text": "私は限られた期間しかここに滞在しません。"}, {"type": "subtitle", "time": 7276.87, "timestamp": "02:01:16", "text": "えっと、モバイルでやりたかっただけなんです"}, {"type": "subtitle", "time": 7278.709, "timestamp": "02:01:18", "text": "ただ"}, {"type": "subtitle", "time": 7281.03, "timestamp": "02:01:21", "text": "散歩を楽しむ"}, {"type": "subtitle", "time": 7284.149, "timestamp": "02:01:24", "text": "話したり色々"}, {"type": "subtitle", "time": 7285.99, "timestamp": "02:01:25", "text": "彼女が"}, {"type": "subtitle", "time": 7289.189, "timestamp": "02:01:29", "text": "つまり、とにかく"}, {"type": "subtitle", "time": 7290.709, "timestamp": "02:01:30", "text": "に"}, {"type": "subtitle", "time": 7294.95, "timestamp": "02:01:34", "text": "外に出て、"}, {"type": "subtitle", "time": 7298.149, "timestamp": "02:01:38", "text": "歩いて自然を感じ、"}, {"type": "subtitle", "time": 7301.03, "timestamp": "02:01:41", "text": "すべて。"}, {"type": "subtitle", "time": 7302.95, "timestamp": "02:01:42", "text": "それで"}, {"type": "subtitle", "time": 7309.189, "timestamp": "02:01:49", "text": "これまでのところ"}, {"type": "subtitle", "time": 7314.07, "timestamp": "02:01:54", "text": "そのアプリは何のために使うのですか？ Nビデオニンジャ"}, {"type": "subtitle", "time": 7317.03, "timestamp": "02:01:57", "text": "うまく機能しないが、ブラウザ"}, {"type": "subtitle", "time": 7319.91, "timestamp": "02:01:59", "text": "このバージョンは素晴らしい働きをします。"}]
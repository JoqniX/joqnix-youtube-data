[{"type": "subtitle", "time": 22152.548, "timestamp": "06:09:12", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 22155.67, "timestamp": "06:09:15", "text": "こんな風にセーブデータを失いたくない"}, {"type": "subtitle", "time": 22158.47, "timestamp": "06:09:18", "text": "また。では、試してみます"}, {"type": "subtitle", "time": 22164.07, "timestamp": "06:09:24", "text": "二度とこんな風にセーブデータを失わないようにしたい。"}, {"type": "subtitle", "time": 22166.628, "timestamp": "06:09:26", "text": "だって、もしそれを失くしたら、"}, {"type": "subtitle", "time": 22168.948, "timestamp": "06:09:28", "text": "そうなると、痛みを感じる。"}]
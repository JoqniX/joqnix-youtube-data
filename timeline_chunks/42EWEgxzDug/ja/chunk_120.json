[{"type": "subtitle", "time": 7239.51, "timestamp": "02:00:39", "text": "わかった。私は聞こえていると思います、"}, {"type": "subtitle", "time": 7244.229, "timestamp": "02:00:44", "text": "右？はい、私は「I」に切り替えました。"}, {"type": "subtitle", "time": 7246.629, "timestamp": "02:00:46", "text": "に切り替えました"}, {"type": "subtitle", "time": 7249.189, "timestamp": "02:00:49", "text": "ブラウザ版。"}, {"type": "subtitle", "time": 7251.51, "timestamp": "02:00:51", "text": "ええと、そうですね、"}, {"type": "subtitle", "time": 7253.51, "timestamp": "02:00:53", "text": "すべて、"}, {"type": "subtitle", "time": 7256.39, "timestamp": "02:00:56", "text": "悪くないと思う。"}]
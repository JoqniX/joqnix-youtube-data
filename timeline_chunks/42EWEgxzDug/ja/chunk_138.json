[{"type": "subtitle", "time": 8281.429, "timestamp": "02:18:01", "text": "これを落とさないようにしたい"}, {"type": "subtitle", "time": 8283.429, "timestamp": "02:18:03", "text": "イヤホン"}, {"type": "subtitle", "time": 8301.27, "timestamp": "02:18:21", "text": "はい、もう片方は充電中です。私は"}, {"type": "subtitle", "time": 8310.469, "timestamp": "02:18:30", "text": "なぜ母は私を間違えて呼ぶのか"}, {"type": "subtitle", "time": 8316.95, "timestamp": "02:18:36", "text": "本当は電話に出たくないんです"}, {"type": "subtitle", "time": 8320.15, "timestamp": "02:18:40", "text": "ベッドの中で寝返りを打つたびに。"}]
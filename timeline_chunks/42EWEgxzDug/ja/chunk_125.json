[{"type": "subtitle", "time": 7500.229, "timestamp": "02:05:00", "text": "試験は7月4日までに終わります。だから私は"}, {"type": "subtitle", "time": 7502.79, "timestamp": "02:05:02", "text": "明日の"}, {"type": "subtitle", "time": 7506.629, "timestamp": "02:05:06", "text": "試験は午前中ですが、大丈夫です"}, {"type": "subtitle", "time": 7508.149, "timestamp": "02:05:08", "text": "そして"}, {"type": "subtitle", "time": 7512.07, "timestamp": "02:05:12", "text": "えっと、明日以降は休みです。だから私は"}, {"type": "subtitle", "time": 7514.229, "timestamp": "02:05:14", "text": "考えている"}, {"type": "subtitle", "time": 7518.47, "timestamp": "02:05:18", "text": "えっと、それで、私はこうしようと思っていたんです"}, {"type": "subtitle", "time": 7520.39, "timestamp": "02:05:20", "text": "いくつかの"}, {"type": "subtitle", "time": 7522.629, "timestamp": "02:05:22", "text": "ええと、安定した流れ"}, {"type": "subtitle", "time": 7525.589, "timestamp": "02:05:25", "text": "そうすれば少なくとも準備できる"}, {"type": "subtitle", "time": 7531.669, "timestamp": "02:05:31", "text": "のように"}, {"type": "subtitle", "time": 7535.189, "timestamp": "02:05:35", "text": "最後の2つの科目。"}, {"type": "subtitle", "time": 7536.79, "timestamp": "02:05:36", "text": "うん。"}, {"type": "subtitle", "time": 7542.39, "timestamp": "02:05:42", "text": "だから私はそれをやりたかったし、"}, {"type": "subtitle", "time": 7545.189, "timestamp": "02:05:45", "text": "私はそれをしたかった"}, {"type": "subtitle", "time": 7555.43, "timestamp": "02:05:55", "text": "そして"}, {"type": "subtitle", "time": 7558.149, "timestamp": "02:05:58", "text": "うん、えっと"}]
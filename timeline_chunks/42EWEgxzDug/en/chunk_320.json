[{"type": "subtitle", "time": 19202.628, "timestamp": "05:20:02", "text": "Oh boy."}, {"type": "subtitle", "time": 19211.91, "timestamp": "05:20:11", "text": "We are finally getting there."}, {"type": "subtitle", "time": 19213.91, "timestamp": "05:20:13", "text": "Oh, wait. There was no sound. No one"}, {"type": "subtitle", "time": 19218.07, "timestamp": "05:20:18", "text": "told me about that. Oh, come back."}, {"type": "subtitle", "time": 19221.51, "timestamp": "05:20:21", "text": "No one told me about the sound."}, {"type": "subtitle", "time": 19224.868, "timestamp": "05:20:24", "text": "Okay, there you go."}, {"type": "subtitle", "time": 19245.35, "timestamp": "05:20:45", "text": "[Music]"}]
[{"type": "subtitle", "time": 4812.99, "timestamp": "01:20:12", "text": "换句话说"}, {"type": "subtitle", "time": 4816.03, "timestamp": "01:20:16", "text": "Exostrider 的剑 Exostr"}, {"type": "subtitle", "time": 4819.229, "timestamp": "01:20:19", "text": "如果你查阅家族记录，就会发现 Rider 和 Nameshiki 分别是什么。"}, {"type": "subtitle", "time": 4821.99, "timestamp": "01:20:21", "text": "正如你所看到的，Exostrider 的力量是"}, {"type": "subtitle", "time": 4826.51, "timestamp": "01:20:26", "text": "我差点崩溃了一次。但"}, {"type": "subtitle", "time": 4829.75, "timestamp": "01:20:29", "text": "来自Exostrider驱动器的一发子弹"}, {"type": "subtitle", "time": 4834.27, "timestamp": "01:20:34", "text": "一道强光将会出现。"}, {"type": "subtitle", "time": 4843.99, "timestamp": "01:20:43", "text": "然后，异星行者举起剑，举行了仪式。"}, {"type": "subtitle", "time": 4847.95, "timestamp": "01:20:47", "text": "我把它封存起来了。于是，我们来到了拉海洛。"}]
[{"type": "subtitle", "time": 5105.79, "timestamp": "01:25:05", "text": "但10"}, {"type": "subtitle", "time": 5108.394, "timestamp": "01:25:08", "text": "几年前的一次飞行训练课上，他突然失踪了。我和其他学生一起进入了驾驶舱模拟器。"}, {"type": "subtitle", "time": 5132.75, "timestamp": "01:25:32", "text": "她"}, {"type": "subtitle", "time": 5140.149, "timestamp": "01:25:40", "text": "不知为何，那个人……"}]
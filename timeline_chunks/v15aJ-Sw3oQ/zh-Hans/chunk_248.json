[{"type": "subtitle", "time": 14897.269, "timestamp": "04:08:17", "text": "我无法说话。武器"}, {"type": "subtitle", "time": 14900.67, "timestamp": "04:08:20", "text": "仔细听。"}, {"type": "subtitle", "time": 14903.229, "timestamp": "04:08:23", "text": "这是"}, {"type": "subtitle", "time": 14908.79, "timestamp": "04:08:28", "text": "很久以前。穿越星海，天空中的两人"}, {"type": "subtitle", "time": 14910.83, "timestamp": "04:08:30", "text": "从斯特莱德之门跳出去。"}, {"type": "subtitle", "time": 14914.149, "timestamp": "04:08:34", "text": "我们也可以期待Exoriders具备战斗能力。"}, {"type": "subtitle", "time": 14920.67, "timestamp": "04:08:40", "text": "它已经破烂不堪，应该没有任何能量了。"}, {"type": "subtitle", "time": 14926.109, "timestamp": "04:08:46", "text": "当时，一个名叫艾姆斯的人被称为驱魔人。"}, {"type": "subtitle", "time": 14929.429, "timestamp": "04:08:49", "text": "骑手只能眼睁睁地看着。"}]
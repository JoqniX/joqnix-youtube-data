[{"type": "subtitle", "time": 13038.59, "timestamp": "03:37:18", "text": "我只有一个家庭成员。"}, {"type": "subtitle", "time": 13045.07, "timestamp": "03:37:25", "text": "家人就是彼此珍惜、互相照顾的人。"}, {"type": "subtitle", "time": 13048.15, "timestamp": "03:37:28", "text": "所以我不会大声说出来。"}, {"type": "subtitle", "time": 13050.87, "timestamp": "03:37:30", "text": "如果行李太重"}, {"type": "subtitle", "time": 13061.11, "timestamp": "03:37:41", "text": "我最近又遇到了一个看台。她之前"}, {"type": "subtitle", "time": 13064.87, "timestamp": "03:37:44", "text": "他似乎过着更轻松的生活。"}]
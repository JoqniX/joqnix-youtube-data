[{"type": "subtitle", "time": 6001.07, "timestamp": "01:40:01", "text": "光是想想就觉得可怕。也许我"}, {"type": "subtitle", "time": 6013.669, "timestamp": "01:40:13", "text": "我希望如此。但那是很多年前的事了。"}, {"type": "subtitle", "time": 6018.95, "timestamp": "01:40:18", "text": "这首歌表达了我的内心世界。仅仅是对某人的同情。"}, {"type": "subtitle", "time": 6022.27, "timestamp": "01:40:22", "text": "能够接受它，或者感受到温暖或疼痛"}]
[{"type": "subtitle", "time": 13115.189, "timestamp": "03:38:35", "text": "她过去总是想念她的家乡和家。"}, {"type": "subtitle", "time": 13117.75, "timestamp": "03:38:37", "text": "我一直很想念你。"}, {"type": "subtitle", "time": 13121.59, "timestamp": "03:38:41", "text": "但现在我失去了记忆，我很痛苦。"}, {"type": "subtitle", "time": 13124.87, "timestamp": "03:38:44", "text": "没必要。"}]
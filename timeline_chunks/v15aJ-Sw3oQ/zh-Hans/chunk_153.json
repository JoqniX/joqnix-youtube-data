[{"type": "subtitle", "time": 9185.15, "timestamp": "02:33:05", "text": "我小时候，我的父母被罢工吞噬了。"}, {"type": "subtitle", "time": 9189.51, "timestamp": "02:33:09", "text": "它消失了。过了一段时间，我也忘记了他们的长相。"}, {"type": "subtitle", "time": 9200.03, "timestamp": "02:33:20", "text": "所以即使他去世了，也并非全是坏事。"}, {"type": "subtitle", "time": 9212.63, "timestamp": "02:33:32", "text": "自从艾姆斯变成数字幽灵后"}, {"type": "subtitle", "time": 9214.83, "timestamp": "02:33:34", "text": "什么？"}]
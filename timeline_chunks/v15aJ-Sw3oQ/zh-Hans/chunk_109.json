[{"type": "subtitle", "time": 6578.189, "timestamp": "01:49:38", "text": "如果是天空会的话我能理解，但是……"}, {"type": "subtitle", "time": 6580.95, "timestamp": "01:49:40", "text": "你知道拉海洛伊的历史吧？"}, {"type": "subtitle", "time": 6584.75, "timestamp": "01:49:44", "text": "Exo，关于那两个生物的水理论。"}, {"type": "subtitle", "time": 6588.629, "timestamp": "01:49:48", "text": "学院里有很多这样的人。"}, {"type": "subtitle", "time": 6591.79, "timestamp": "01:49:51", "text": "只要这道门存在，就会有人想方设法打开它。"}, {"type": "subtitle", "time": 6594.91, "timestamp": "01:49:54", "text": "这似乎是一个顺理成章的结论。我认为"}, {"type": "subtitle", "time": 6599.35, "timestamp": "01:49:59", "text": "是。虚空风暴及其现在的名称是它的诞生地"}]
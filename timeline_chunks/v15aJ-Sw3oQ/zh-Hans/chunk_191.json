[{"type": "subtitle", "time": 11494.03, "timestamp": "03:11:34", "text": "首先，我们得想办法离开这里。"}, {"type": "subtitle", "time": 11498.59, "timestamp": "03:11:38", "text": "过犹不及。不仅仅是硬盘的核心，还有我"}, {"type": "subtitle", "time": 11501.229, "timestamp": "03:11:41", "text": "敌方飞机的频率和飞行员权限"}, {"type": "subtitle", "time": 11504.03, "timestamp": "03:11:44", "text": "所以你的目标是这个。"}]
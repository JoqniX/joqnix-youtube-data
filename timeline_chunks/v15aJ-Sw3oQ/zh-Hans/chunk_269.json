[{"type": "subtitle", "time": 16145.189, "timestamp": "04:29:05", "text": "并非那个意思。"}, {"type": "subtitle", "time": 16147.269, "timestamp": "04:29:07", "text": "你也是"}, {"type": "subtitle", "time": 16149.95, "timestamp": "04:29:09", "text": "龙君说"}, {"type": "subtitle", "time": 16152.349, "timestamp": "04:29:12", "text": "艾姆斯"}, {"type": "subtitle", "time": 16166.349, "timestamp": "04:29:26", "text": "这是谎言还是安慰我的真话？"}, {"type": "subtitle", "time": 16169.87, "timestamp": "04:29:29", "text": "艾姆斯被带出了大门。"}, {"type": "subtitle", "time": 16172.99, "timestamp": "04:29:32", "text": "她还活着吗？"}, {"type": "subtitle", "time": 16173.63, "timestamp": "04:29:33", "text": "居住"}]
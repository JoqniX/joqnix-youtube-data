[{"type": "subtitle", "time": 7303.47, "timestamp": "02:01:43", "text": "每个人"}, {"type": "subtitle", "time": 7306.709, "timestamp": "02:01:46", "text": "欢迎来到天空方舟。我今天将发布公告。"}, {"type": "subtitle", "time": 7310.39, "timestamp": "02:01:50", "text": "我叫文治，这件事由我负责。"}, {"type": "subtitle", "time": 7313.79, "timestamp": "02:01:53", "text": "老师们希望今天的参观活动能够平安结束。"}, {"type": "subtitle", "time": 7316.03, "timestamp": "02:01:56", "text": "注意不要跟随[音乐]"}]
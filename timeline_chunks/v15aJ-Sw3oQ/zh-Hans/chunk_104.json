[{"type": "subtitle", "time": 6246.35, "timestamp": "01:44:06", "text": "太阳神出去了。尽快到达"}, {"type": "subtitle", "time": 6257.75, "timestamp": "01:44:17", "text": "如果我们要出校门，我想我们的目的地应该是那栋旧教学楼。"}, {"type": "subtitle", "time": 6261.83, "timestamp": "01:44:21", "text": "啊，大概是林克·杜斯宾吧。"}, {"type": "subtitle", "time": 6263.39, "timestamp": "01:44:23", "text": "它在剑的顶端吗？"}]
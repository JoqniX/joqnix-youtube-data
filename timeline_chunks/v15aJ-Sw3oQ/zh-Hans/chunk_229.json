[{"type": "subtitle", "time": 13748.95, "timestamp": "03:49:08", "text": "我们现在应该怎么办？"}, {"type": "subtitle", "time": 13752.349, "timestamp": "03:49:12", "text": "让我考虑一下。"}, {"type": "subtitle", "time": 13757.189, "timestamp": "03:49:17", "text": "“家乡”这个词现在是否唤起了人们的苦涩之情？"}, {"type": "subtitle", "time": 13759.189, "timestamp": "03:49:19", "text": "它甜吗？"}, {"type": "subtitle", "time": 13761.59, "timestamp": "03:49:21", "text": "我不太明白"}, {"type": "subtitle", "time": 13765.07, "timestamp": "03:49:25", "text": "但别担心"}, {"type": "subtitle", "time": 13769.309, "timestamp": "03:49:29", "text": "在《因为失忆而拯救世界》中"}, {"type": "subtitle", "time": 13771.469, "timestamp": "03:49:31", "text": "Solaris 战斗到了黎明。"}, {"type": "subtitle", "time": 13774.309, "timestamp": "03:49:34", "text": "哦，到处乱跑，拼命地躲在黑盐前面"}, {"type": "subtitle", "time": 13775.75, "timestamp": "03:49:35", "text": "我挣扎了很久。"}]
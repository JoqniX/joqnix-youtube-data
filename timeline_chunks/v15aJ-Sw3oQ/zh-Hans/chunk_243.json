[{"type": "subtitle", "time": 14608.95, "timestamp": "04:03:28", "text": "太棒了。感觉哪里不太对劲。"}, {"type": "subtitle", "time": 14611.189, "timestamp": "04:03:31", "text": "我仍然想和某人在一起。"}, {"type": "subtitle", "time": 14613.07, "timestamp": "04:03:33", "text": "麦克风没有静音。"}, {"type": "subtitle", "time": 14638.79, "timestamp": "04:03:58", "text": "我人生中最重大的决定是在一开始就做出的。"}]
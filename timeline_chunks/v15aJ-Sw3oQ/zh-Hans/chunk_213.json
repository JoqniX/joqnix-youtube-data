[{"type": "subtitle", "time": 12781.63, "timestamp": "03:33:01", "text": "很久以前"}, {"type": "subtitle", "time": 12785.309, "timestamp": "03:33:05", "text": "一只黑猫，据信是前任领主的遗物，是故事的结尾。"}, {"type": "subtitle", "time": 12789.75, "timestamp": "03:33:09", "text": "我踏上了一段没有目的地的旅程。猫为什么去找救世主？"}, {"type": "subtitle", "time": 12795.95, "timestamp": "03:33:15", "text": "但猫就是猫，还有更多。"}, {"type": "subtitle", "time": 12798.83, "timestamp": "03:33:18", "text": "那里生活着许多小生物。"}, {"type": "subtitle", "time": 12804.07, "timestamp": "03:33:24", "text": "架子。纸箱很小。请"}, {"type": "subtitle", "time": 12806.429, "timestamp": "03:33:26", "text": "帮我。"}, {"type": "chat", "time": 12810.52, "timestamp": "03:33:30", "author": "@JasminVuVT", "avatar": "https://yt4.ggpht.com/aV4gcmeL3SpFgEunlKwYMoVfsJVudLUSlBUu8tAYUazDHRi36mPrplbRk0bBEDOE913NDdYjqA=s64-c-k-c0x00ffffff-no-rj", "message": "hhhiiiiiiiiiiiiiii"}, {"type": "subtitle", "time": 12810.95, "timestamp": "03:33:30", "text": "即使没人问。"}, {"type": "subtitle", "time": 12813.87, "timestamp": "03:33:33", "text": "是的。"}, {"type": "subtitle", "time": 12816.229, "timestamp": "03:33:36", "text": "他继续拯救世界。"}]
[{"type": "subtitle", "time": 14108.99, "timestamp": "03:55:08", "text": "终于可以看到"}, {"type": "subtitle", "time": 14143.71, "timestamp": "03:55:43", "text": "过去十年左右，我一直都是随心所欲地喜欢歌曲。"}, {"type": "subtitle", "time": 14149.83, "timestamp": "03:55:49", "text": "他谈到了这些感受，实际上也谈到了他自己的歌曲。"}, {"type": "subtitle", "time": 14153.469, "timestamp": "03:55:53", "text": "现在那是我的了。"}, {"type": "subtitle", "time": 14156.389, "timestamp": "03:55:56", "text": "如果有人想听的话，那么，拉哈罗伊的"}]
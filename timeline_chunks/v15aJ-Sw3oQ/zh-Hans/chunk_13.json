[{"type": "subtitle", "time": 792.509, "timestamp": "00:13:12", "text": "1"}, {"type": "subtitle", "time": 802.79, "timestamp": "00:13:22", "text": "充电完成后，我会回去见我的上司。"}, {"type": "subtitle", "time": 805.269, "timestamp": "00:13:25", "text": "我的本意就是如此。"}, {"type": "subtitle", "time": 809.99, "timestamp": "00:13:29", "text": "毕竟充电的时候我动不了，看到我这副样子……"}]
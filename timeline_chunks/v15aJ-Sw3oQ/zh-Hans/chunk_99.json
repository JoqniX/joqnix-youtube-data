[{"type": "subtitle", "time": 5960.83, "timestamp": "01:39:20", "text": "关于我"}, {"type": "subtitle", "time": 5963.669, "timestamp": "01:39:23", "text": "只是没有隐藏而已。"}, {"type": "subtitle", "time": 5967.629, "timestamp": "01:39:27", "text": "这只是我的一个小爱好。摄影和游戏"}, {"type": "subtitle", "time": 5970.87, "timestamp": "01:39:30", "text": "我喜欢看电影，也喜欢和朋友一起看电影。"}, {"type": "subtitle", "time": 5973.79, "timestamp": "01:39:33", "text": "因为我喜欢他。"}, {"type": "subtitle", "time": 5977.43, "timestamp": "01:39:37", "text": "我也是这么想的。只有有限数量的人能够继续留校。"}, {"type": "subtitle", "time": 5981.109, "timestamp": "01:39:41", "text": "你老了，不是吗？我并不一定想要在研究中取得成果。"}, {"type": "subtitle", "time": 5984.79, "timestamp": "01:39:44", "text": "事实并非如此，我想尽情享受校园生活。"}, {"type": "subtitle", "time": 5993.91, "timestamp": "01:39:53", "text": "十多年前，我从未想过自己会变成现在这样的鬼魂。"}, {"type": "subtitle", "time": 5996.669, "timestamp": "01:39:56", "text": "真不敢相信你还是个学生。"}]
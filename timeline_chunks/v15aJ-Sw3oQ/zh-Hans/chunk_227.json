[{"type": "subtitle", "time": 13621.87, "timestamp": "03:47:01", "text": "在那种时候"}, {"type": "subtitle", "time": 13625.309, "timestamp": "03:47:05", "text": "我一直很珍惜您的频率"}, {"type": "subtitle", "time": 13629.149, "timestamp": "03:47:09", "text": "被虚空物质污染，我的力量"}, {"type": "subtitle", "time": 13632.229, "timestamp": "03:47:12", "text": "我把它撕碎了。"}, {"type": "subtitle", "time": 13634.469, "timestamp": "03:47:14", "text": "所以"}, {"type": "subtitle", "time": 13646.11, "timestamp": "03:47:26", "text": "那是发自我的内心。"}, {"type": "subtitle", "time": 13650.95, "timestamp": "03:47:30", "text": "对治疗的焦虑、想象和恐惧"}, {"type": "subtitle", "time": 13653.149, "timestamp": "03:47:33", "text": "决定性。"}, {"type": "subtitle", "time": 13654.75, "timestamp": "03:47:34", "text": "第一的"}, {"type": "subtitle", "time": 13657.75, "timestamp": "03:47:37", "text": "西吉鲁姆除了想回到故乡之外，没有其他本能。"}, {"type": "subtitle", "time": 13660.07, "timestamp": "03:47:40", "text": "它不在那里。"}, {"type": "subtitle", "time": 13664.309, "timestamp": "03:47:44", "text": "所以，你会在不知不觉中试图满足自己。"}, {"type": "subtitle", "time": 13668.87, "timestamp": "03:47:48", "text": "他们想要我的频率，并试图剥夺我的权力。"}, {"type": "subtitle", "time": 13671.04, "timestamp": "03:47:51", "text": "。 启动外骨骼行者"}, {"type": "subtitle", "time": 13674.08, "timestamp": "03:47:54", "text": "启动外骨骼行者 穿过斯特莱德之门，我回到了我的家乡。"}, {"type": "subtitle", "time": 13677.84, "timestamp": "03:47:57", "text": "穿过斯特莱德之门，我回到了我的家乡。 正是因为这个原因。"}]
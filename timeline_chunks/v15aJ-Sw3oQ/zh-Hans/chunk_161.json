[{"type": "subtitle", "time": 9667.87, "timestamp": "02:41:07", "text": "它的真面目是黑洞"}, {"type": "subtitle", "time": 9672.15, "timestamp": "02:41:12", "text": "事实上，目前为止，这个假设是我提出的。"}, {"type": "subtitle", "time": 9673.71, "timestamp": "02:41:13", "text": "仅有的"}, {"type": "subtitle", "time": 9688.07, "timestamp": "02:41:28", "text": "名义公式的时空本身就是碎片化的，并且各不相同。"}, {"type": "subtitle", "time": 9691.389, "timestamp": "02:41:31", "text": "那些被时代吞噬的人，依然停留在原地。"}, {"type": "subtitle", "time": 9694.67, "timestamp": "02:41:34", "text": "它会出现的。你曾与许多名字战斗过"}, {"type": "subtitle", "time": 9697.59, "timestamp": "02:41:37", "text": "我听说这件事一直在发生。空隙"}, {"type": "subtitle", "time": 9700.55, "timestamp": "02:41:40", "text": "我闲逛的时候看到的。"}, {"type": "subtitle", "time": 9704.469, "timestamp": "02:41:44", "text": "拉哈洛伊所看到的命名公式的力量，只是它本身力量的一小部分。"}, {"type": "subtitle", "time": 9713.429, "timestamp": "02:41:53", "text": "这就是原因"}, {"type": "subtitle", "time": 9716.75, "timestamp": "02:41:56", "text": "直到我觉醒为Exostrider"}]
[{"type": "subtitle", "time": 13501.63, "timestamp": "03:45:01", "text": "我不太理解它的结构。"}, {"type": "subtitle", "time": 13506.91, "timestamp": "03:45:06", "text": "根据昨天的情况来看，这很可能是一颗故障的通信卫星。"}, {"type": "subtitle", "time": 13509.469, "timestamp": "03:45:09", "text": "我也是这么想的。"}, {"type": "subtitle", "time": 13512.189, "timestamp": "03:45:12", "text": "在残骸之中"}, {"type": "subtitle", "time": 13516.07, "timestamp": "03:45:16", "text": "我找到了另一个与你相关的频率。"}, {"type": "subtitle", "time": 13524.07, "timestamp": "03:45:24", "text": "你寄回家乡的信件记录包含"}, {"type": "subtitle", "time": 13526.99, "timestamp": "03:45:26", "text": "除了任务之外，还有其他任务"}, {"type": "subtitle", "time": 13540.91, "timestamp": "03:45:40", "text": "你只想再去一次家乡。"}, {"type": "subtitle", "time": 13549.95, "timestamp": "03:45:49", "text": "但我看到了。"}, {"type": "subtitle", "time": 13553.309, "timestamp": "03:45:53", "text": "他们拒绝"}, {"type": "subtitle", "time": 13557.429, "timestamp": "03:45:57", "text": "因为这对于你的任务至关重要。"}]
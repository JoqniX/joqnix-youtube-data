[{"type": "subtitle", "time": 14944.189, "timestamp": "04:09:04", "text": "我一开始真的很惊讶。"}, {"type": "subtitle", "time": 14979.87, "timestamp": "04:09:39", "text": "时间和命运造就了彼此的联系。但我和她"}, {"type": "subtitle", "time": 14984.67, "timestamp": "04:09:44", "text": "我们第一次见面是在十多年前，当时我正好符合他们的要求。"}, {"type": "subtitle", "time": 14988.189, "timestamp": "04:09:48", "text": "与 Exostrider 产生共鸣，这款特别的"}, {"type": "subtitle", "time": 14992.63, "timestamp": "04:09:52", "text": "只有我，在这种状态下，才能免受虚空空间的毁灭。"}, {"type": "subtitle", "time": 14996.149, "timestamp": "04:09:56", "text": "她访问了拉海洛伊"}, {"type": "subtitle", "time": 14998.51, "timestamp": "04:09:58", "text": "我被那个人救了。"}]
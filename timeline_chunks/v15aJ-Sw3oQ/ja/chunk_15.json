[{"type": "subtitle", "time": 906.71, "timestamp": "00:15:06", "text": "だから星空は人が抱くロマンなん"}, {"type": "subtitle", "time": 926.43, "timestamp": "00:15:26", "text": "私もそう思っています。ですが、星空に手"}, {"type": "subtitle", "time": 929.11, "timestamp": "00:15:29", "text": "を伸ばすだけでは足りないとも思ってい"}, {"type": "subtitle", "time": 931.269, "timestamp": "00:15:31", "text": "ます。"}, {"type": "subtitle", "time": 935.43, "timestamp": "00:15:35", "text": "いつか私たちは自らの手で作り出せるよう"}, {"type": "subtitle", "time": 938.509, "timestamp": "00:15:38", "text": "になるでしょう。この星空よりも"}, {"type": "subtitle", "time": 943.87, "timestamp": "00:15:43", "text": "ロマンチックでどこまでも続く奇跡を。"}, {"type": "subtitle", "time": 948.03, "timestamp": "00:15:48", "text": "そうしながらここまで私は歩んできたの"}, {"type": "subtitle", "time": 954.67, "timestamp": "00:15:54", "text": "です。そして今はこの両足でその第1歩を"}]
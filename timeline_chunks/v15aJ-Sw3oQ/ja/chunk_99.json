[{"type": "subtitle", "time": 5960.83, "timestamp": "01:39:20", "text": "私のこと"}, {"type": "subtitle", "time": 5963.669, "timestamp": "01:39:23", "text": "ただの隠なくて"}, {"type": "subtitle", "time": 5967.629, "timestamp": "01:39:27", "text": "ちょっとした趣味だけね。撮影もゲームも"}, {"type": "subtitle", "time": 5970.87, "timestamp": "01:39:30", "text": "好きだし、友達と一緒に映画を見るのも"}, {"type": "subtitle", "time": 5973.79, "timestamp": "01:39:33", "text": "好きだったから。"}, {"type": "subtitle", "time": 5977.43, "timestamp": "01:39:37", "text": "思ったの。学生でいられるのってほんの数"}, {"type": "subtitle", "time": 5981.109, "timestamp": "01:39:41", "text": "年でしょ。別に研究で成果を出したかった"}, {"type": "subtitle", "time": 5984.79, "timestamp": "01:39:44", "text": "わけでもないし、思う存分学園生活を"}, {"type": "subtitle", "time": 5993.91, "timestamp": "01:39:53", "text": "まさかこうしてゴーストになって10数年"}, {"type": "subtitle", "time": 5996.669, "timestamp": "01:39:56", "text": "も学生をやってるなんて。"}]
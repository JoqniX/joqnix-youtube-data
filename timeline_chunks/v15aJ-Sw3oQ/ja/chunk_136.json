[{"type": "subtitle", "time": 8201.15, "timestamp": "02:16:41", "text": "これでどうかな?"}, {"type": "subtitle", "time": 8205.509, "timestamp": "02:16:45", "text": "ほら、ラハロイブロックの完成。"}, {"type": "subtitle", "time": 8207.429, "timestamp": "02:16:47", "text": "スペースファンタジーカティアシリーズに"}, {"type": "subtitle", "time": 8212.07, "timestamp": "02:16:52", "text": "は毎回このミニゲームがついてたわ。私の"}, {"type": "subtitle", "time": 8216.11, "timestamp": "02:16:56", "text": "入りでね。昔は上手だったの。この異常は"}]
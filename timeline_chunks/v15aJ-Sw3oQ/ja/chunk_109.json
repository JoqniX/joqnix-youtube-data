[{"type": "subtitle", "time": 6578.189, "timestamp": "01:49:38", "text": "天空会なら分かるけど"}, {"type": "subtitle", "time": 6580.95, "timestamp": "01:49:40", "text": "ラハイロイの歴史は知っているね。"}, {"type": "subtitle", "time": 6584.75, "timestamp": "01:49:44", "text": "エクソ、その2つの存在に関する水論が"}, {"type": "subtitle", "time": 6588.629, "timestamp": "01:49:48", "text": "学園には数多く存在。"}, {"type": "subtitle", "time": 6591.79, "timestamp": "01:49:51", "text": "ゲートが存在している以上、人が開けよう"}, {"type": "subtitle", "time": 6594.91, "timestamp": "01:49:54", "text": "とするのは自然だろうね。私は思ってるん"}, {"type": "subtitle", "time": 6599.35, "timestamp": "01:49:59", "text": "だ。ボイドストームや今の名式は誕生場所"}]
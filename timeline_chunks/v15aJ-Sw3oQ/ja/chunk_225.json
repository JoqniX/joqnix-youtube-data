[{"type": "subtitle", "time": 13501.63, "timestamp": "03:45:01", "text": "私には構造がよくわからなかったけど、"}, {"type": "subtitle", "time": 13506.91, "timestamp": "03:45:06", "text": "昨日から判断すると多分壊れた通信衛星"}, {"type": "subtitle", "time": 13509.469, "timestamp": "03:45:09", "text": "だったはず。"}, {"type": "subtitle", "time": 13512.189, "timestamp": "03:45:12", "text": "その残骸の中で"}, {"type": "subtitle", "time": 13516.07, "timestamp": "03:45:16", "text": "あなたに関係してる周波数をまた見つけた"}, {"type": "subtitle", "time": 13524.07, "timestamp": "03:45:24", "text": "あなたが故郷へ送った通信記録には"}, {"type": "subtitle", "time": 13526.99, "timestamp": "03:45:26", "text": "使命とは別の"}, {"type": "subtitle", "time": 13540.91, "timestamp": "03:45:40", "text": "1度だけでいいから故郷を見たいとあなた"}, {"type": "subtitle", "time": 13549.95, "timestamp": "03:45:49", "text": "でも私は見てしまった。"}, {"type": "subtitle", "time": 13553.309, "timestamp": "03:45:53", "text": "彼らが拒絶するところを"}, {"type": "subtitle", "time": 13557.429, "timestamp": "03:45:57", "text": "なぜならそれはあなたの使命にとって必要"}]
[{"type": "subtitle", "time": 13748.95, "timestamp": "03:49:08", "text": "これからどうするか"}, {"type": "subtitle", "time": 13752.349, "timestamp": "03:49:12", "text": "少し考えさせて"}, {"type": "subtitle", "time": 13757.189, "timestamp": "03:49:17", "text": "故郷という言葉も今となっては苦いのか"}, {"type": "subtitle", "time": 13759.189, "timestamp": "03:49:19", "text": "甘いのか"}, {"type": "subtitle", "time": 13761.59, "timestamp": "03:49:21", "text": "よくわからない"}, {"type": "subtitle", "time": 13765.07, "timestamp": "03:49:25", "text": "でも心配しないで"}, {"type": "subtitle", "time": 13769.309, "timestamp": "03:49:29", "text": "記憶をなくしたから世界を救うの中で"}, {"type": "subtitle", "time": 13771.469, "timestamp": "03:49:31", "text": "夜明けまで戦い抜いたのソラリスが"}, {"type": "subtitle", "time": 13774.309, "timestamp": "03:49:34", "text": "ああちこちを走り回っ黒塩を前に必死に"}, {"type": "subtitle", "time": 13775.75, "timestamp": "03:49:35", "text": "もがいたの"}]
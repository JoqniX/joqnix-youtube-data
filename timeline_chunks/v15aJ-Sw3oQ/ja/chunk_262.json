[{"type": "subtitle", "time": 15736.87, "timestamp": "04:22:16", "text": "は幼い頃"}, {"type": "subtitle", "time": 15741.07, "timestamp": "04:22:21", "text": "椅海に応じて彼女を助けたの"}, {"type": "subtitle", "time": 15767.07, "timestamp": "04:22:47", "text": "バス"}, {"type": "subtitle", "time": 15769.03, "timestamp": "04:22:49", "text": "がストライダーゲの向こう側に引"}, {"type": "subtitle", "time": 15771.91, "timestamp": "04:22:51", "text": "引きり込まれたならゲートを通り抜けて"}, {"type": "subtitle", "time": 15774.91, "timestamp": "04:22:54", "text": "連れ戻せばいい。"}, {"type": "subtitle", "time": 15777.269, "timestamp": "04:22:57", "text": "誰かしらがエクソストライダーを勝って"}]
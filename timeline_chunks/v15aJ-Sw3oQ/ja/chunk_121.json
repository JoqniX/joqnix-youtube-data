[{"type": "subtitle", "time": 7303.47, "timestamp": "02:01:43", "text": "皆さ"}, {"type": "subtitle", "time": 7306.709, "timestamp": "02:01:46", "text": "スカイアークへようこそ。私は本日の案内"}, {"type": "subtitle", "time": 7310.39, "timestamp": "02:01:50", "text": "を担当する文路と言います。"}, {"type": "subtitle", "time": 7313.79, "timestamp": "02:01:53", "text": "1日見学が無事に終わるよう同の先生たち"}, {"type": "subtitle", "time": 7316.03, "timestamp": "02:01:56", "text": "に従ってはれない[音楽]ように気をつけ"}]
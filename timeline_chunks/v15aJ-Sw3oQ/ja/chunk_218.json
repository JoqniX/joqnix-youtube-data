[{"type": "subtitle", "time": 13115.189, "timestamp": "03:38:35", "text": "昔の彼女はいつも故郷に思いをはせ家を"}, {"type": "subtitle", "time": 13117.75, "timestamp": "03:38:37", "text": "恋いしがってた。"}, {"type": "subtitle", "time": 13121.59, "timestamp": "03:38:41", "text": "でも記憶をなくしたおかげでもう苦しむ"}, {"type": "subtitle", "time": 13124.87, "timestamp": "03:38:44", "text": "必要はない。"}]
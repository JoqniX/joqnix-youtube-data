[{"type": "subtitle", "time": 13806.309, "timestamp": "03:50:06", "text": "それでもこうして関わってこれたことが"}, {"type": "subtitle", "time": 13808.83, "timestamp": "03:50:08", "text": "やっぱり嬉しい。"}, {"type": "subtitle", "time": 13813.309, "timestamp": "03:50:13", "text": "世界の救済は本当に故郷から使命だったの"}, {"type": "subtitle", "time": 13814.95, "timestamp": "03:50:14", "text": "か。"}, {"type": "subtitle", "time": 13819.349, "timestamp": "03:50:19", "text": "彼らが今の私をどう見てるのか。記憶を"}, {"type": "subtitle", "time": 13824.349, "timestamp": "03:50:24", "text": "なくしても同じ選択をしたはず。"}, {"type": "subtitle", "time": 13827.03, "timestamp": "03:50:27", "text": "本当に。"}, {"type": "subtitle", "time": 13829.79, "timestamp": "03:50:29", "text": "ね、"}, {"type": "subtitle", "time": 13832.55, "timestamp": "03:50:32", "text": "みんなと一緒にいたい。"}]
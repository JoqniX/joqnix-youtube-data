[{"type": "subtitle", "time": 4361.189, "timestamp": "01:12:41", "text": "いや、今回は私の判断ミスだ。"}, {"type": "subtitle", "time": 4364.629, "timestamp": "01:12:44", "text": "わざわざ同計を書き集め、国形な演劇を"}, {"type": "subtitle", "time": 4367.629, "timestamp": "01:12:47", "text": "披露してしまったな。"}, {"type": "subtitle", "time": 4372.149, "timestamp": "01:12:52", "text": "これが使われたら少女にと契約を結ばせる"}]
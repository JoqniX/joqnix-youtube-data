[{"type": "subtitle", "time": 11494.03, "timestamp": "03:11:34", "text": "まずはここから出る道を探そう。"}, {"type": "subtitle", "time": 11498.59, "timestamp": "03:11:38", "text": "しぎる。ドライブのコアだけじゃなくて私"}, {"type": "subtitle", "time": 11501.229, "timestamp": "03:11:41", "text": "の周波数とエネメスのパイロット権限も"}, {"type": "subtitle", "time": 11504.03, "timestamp": "03:11:44", "text": "狙ってるのね。"}]
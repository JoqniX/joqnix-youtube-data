[{"type": "subtitle", "time": 4812.99, "timestamp": "01:20:12", "text": "つまり"}, {"type": "subtitle", "time": 4816.03, "timestamp": "01:20:16", "text": "エクソストライダーは自分の剣エクソスト"}, {"type": "subtitle", "time": 4819.229, "timestamp": "01:20:19", "text": "ライダーと名式は一族の記録を読めば"}, {"type": "subtitle", "time": 4821.99, "timestamp": "01:20:21", "text": "分かるようにエクソストライダーの力は"}, {"type": "subtitle", "time": 4826.51, "timestamp": "01:20:26", "text": "1度つき明識に破れかけました。しかし"}, {"type": "subtitle", "time": 4829.75, "timestamp": "01:20:29", "text": "エクソストライダーのドライブから間一発"}, {"type": "subtitle", "time": 4834.27, "timestamp": "01:20:34", "text": "でい光が現れます"}, {"type": "subtitle", "time": 4843.99, "timestamp": "01:20:43", "text": "そしてエクソストライダーは剣を掲げ名式"}, {"type": "subtitle", "time": 4847.95, "timestamp": "01:20:47", "text": "を封印しました。こうしてラハイロイに"}]
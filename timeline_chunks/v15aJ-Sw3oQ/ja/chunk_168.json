[{"type": "subtitle", "time": 10088.469, "timestamp": "02:48:08", "text": "幼い頃目を覚ましたらり声もそのうち私は"}, {"type": "subtitle", "time": 10091.95, "timestamp": "02:48:11", "text": "どうすれば抗えるのかわ。"}, {"type": "subtitle", "time": 10095.51, "timestamp": "02:48:15", "text": "それで私は"}, {"type": "subtitle", "time": 10101.95, "timestamp": "02:48:21", "text": "私の両親は外から来た研究員。"}]
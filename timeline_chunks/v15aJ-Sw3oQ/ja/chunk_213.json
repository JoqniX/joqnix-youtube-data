[{"type": "subtitle", "time": 12781.63, "timestamp": "03:33:01", "text": "昔"}, {"type": "subtitle", "time": 12785.309, "timestamp": "03:33:05", "text": "旧世主と思われた1匹の黒猫が終わりの"}, {"type": "subtitle", "time": 12789.75, "timestamp": "03:33:09", "text": "ない旅に出ました。なぜ猫が救世主に行っ"}, {"type": "subtitle", "time": 12795.95, "timestamp": "03:33:15", "text": "て?しかし猫は自分が猫そこにはさらに"}, {"type": "subtitle", "time": 12798.83, "timestamp": "03:33:18", "text": "小さな生き物たちがたくさん住んでいまし"}, {"type": "subtitle", "time": 12804.07, "timestamp": "03:33:24", "text": "たな。ダンボールは小さかったで。どうか"}, {"type": "subtitle", "time": 12806.429, "timestamp": "03:33:26", "text": "助けて。"}, {"type": "chat", "time": 12810.52, "timestamp": "03:33:30", "author": "@JasminVuVT", "avatar": "https://yt4.ggpht.com/aV4gcmeL3SpFgEunlKwYMoVfsJVudLUSlBUu8tAYUazDHRi36mPrplbRk0bBEDOE913NDdYjqA=s64-c-k-c0x00ffffff-no-rj", "message": "hhhiiiiiiiiiiiiiii"}, {"type": "subtitle", "time": 12810.95, "timestamp": "03:33:30", "text": "頼まれなくてもね。"}, {"type": "subtitle", "time": 12813.87, "timestamp": "03:33:33", "text": "そうね。"}, {"type": "subtitle", "time": 12816.229, "timestamp": "03:33:36", "text": "世界を救い続けていました。"}]
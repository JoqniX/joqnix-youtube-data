[{"type": "subtitle", "time": 8881.19, "timestamp": "02:28:01", "text": "うん。そうだね。"}, {"type": "subtitle", "time": 8885.11, "timestamp": "02:28:05", "text": "友人かな?不交流のあるきっかけで"}, {"type": "subtitle", "time": 8889.07, "timestamp": "02:28:09", "text": "知り合い、そこに別の事情がそうだね。"}, {"type": "subtitle", "time": 8892.99, "timestamp": "02:28:12", "text": "偶然な出会いを経て互いを信じ合うになっ"}, {"type": "subtitle", "time": 8901.309, "timestamp": "02:28:21", "text": "大丈夫だよ。しばらく君はラハイロイに"}, {"type": "subtitle", "time": 8904.67, "timestamp": "02:28:24", "text": "滞在するだろうし、スター学園には様々な"}, {"type": "subtitle", "time": 8908.79, "timestamp": "02:28:28", "text": "勢力が存在する。こんな映像が流出したら"}, {"type": "subtitle", "time": 8910.67, "timestamp": "02:28:30", "text": "後始末が面倒だ。"}]
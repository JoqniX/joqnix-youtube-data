[{"type": "subtitle", "time": 9667.87, "timestamp": "02:41:07", "text": "そしてその本当の姿はブラックホールに"}, {"type": "subtitle", "time": 9672.15, "timestamp": "02:41:12", "text": "よく実際仮説は今までたどり着いたのは私"}, {"type": "subtitle", "time": 9673.71, "timestamp": "02:41:13", "text": "だけ"}, {"type": "subtitle", "time": 9688.07, "timestamp": "02:41:28", "text": "は名式の時空そのものがバラバラで違う"}, {"type": "subtitle", "time": 9691.389, "timestamp": "02:41:31", "text": "時代に飲み込んだものたちは同じ場所に"}, {"type": "subtitle", "time": 9694.67, "timestamp": "02:41:34", "text": "現れることだ。あなたが多くの名式と戦っ"}, {"type": "subtitle", "time": 9697.59, "timestamp": "02:41:37", "text": "てきたのは聞いたわ。ボイドスペースを"}, {"type": "subtitle", "time": 9700.55, "timestamp": "02:41:40", "text": "彷徨いながら見たわ。"}, {"type": "subtitle", "time": 9704.469, "timestamp": "02:41:44", "text": "ラハロイに届いてる名式の力はほんの一部"}, {"type": "subtitle", "time": 9713.429, "timestamp": "02:41:53", "text": "だから"}, {"type": "subtitle", "time": 9716.75, "timestamp": "02:41:56", "text": "エクソストライダーに目覚めるまでもう"}]
[{"type": "subtitle", "time": 8761.63, "timestamp": "02:26:01", "text": "スカイアークシステムが安定してきたわ。"}, {"type": "subtitle", "time": 8766.23, "timestamp": "02:26:06", "text": "何年も前に彼は救民装置から目を覚まして"}, {"type": "subtitle", "time": 8768.389, "timestamp": "02:26:08", "text": "ついこのキャビンはボイドストームに覆わ"}, {"type": "subtitle", "time": 8772.67, "timestamp": "02:26:12", "text": "れてる。ネオさん、あの司令も変異して"}, {"type": "subtitle", "time": 8774.429, "timestamp": "02:26:14", "text": "理性すら失った自分。"}, {"type": "subtitle", "time": 8811.75, "timestamp": "02:26:51", "text": "見るんだ。"}, {"type": "subtitle", "time": 8812.75, "timestamp": "02:26:52", "text": "あ、"}]
[{"type": "subtitle", "time": 9185.15, "timestamp": "02:33:05", "text": "幼い頃両親はストに存在を飲み込まれて"}, {"type": "subtitle", "time": 9189.51, "timestamp": "02:33:09", "text": "消えた。しばらくして私も2人の顔を忘れ"}, {"type": "subtitle", "time": 9200.03, "timestamp": "02:33:20", "text": "だから死んだとはいえ悪いことばかりじゃ"}, {"type": "subtitle", "time": 9212.63, "timestamp": "02:33:32", "text": "デジタルゴーストになってからエイメス"}, {"type": "subtitle", "time": 9214.83, "timestamp": "02:33:34", "text": "何?"}]
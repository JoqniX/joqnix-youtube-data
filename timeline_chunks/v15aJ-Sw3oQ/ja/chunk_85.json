[{"type": "subtitle", "time": 5105.79, "timestamp": "01:25:05", "text": "でも10"}, {"type": "subtitle", "time": 5108.394, "timestamp": "01:25:08", "text": "数年前の操縦授業で突然姿を消してしまった。他の学生とコックピットシミュレーターに入った。"}, {"type": "subtitle", "time": 5132.75, "timestamp": "01:25:32", "text": "彼女のこ"}, {"type": "subtitle", "time": 5135.83, "timestamp": "01:25:35", "text": "何年も行方不明になり亡くなったと思われ"}, {"type": "subtitle", "time": 5140.149, "timestamp": "01:25:40", "text": "た人がどういうわけか。"}]
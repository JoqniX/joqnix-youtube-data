[{"type": "subtitle", "time": 7328.75, "timestamp": "02:02:08", "text": "皆さんこちらをご覧ください。この中に"}, {"type": "subtitle", "time": 7334.03, "timestamp": "02:02:14", "text": "入っているものが天空会のです。"}, {"type": "subtitle", "time": 7336.75, "timestamp": "02:02:16", "text": "お分かりの方も多いでしょうが、ある時期"}, {"type": "subtitle", "time": 7340.47, "timestamp": "02:02:20", "text": "から突如天空会はソラリス上空に現れまし"}, {"type": "subtitle", "time": 7342.91, "timestamp": "02:02:22", "text": "た。"}, {"type": "subtitle", "time": 7347.03, "timestamp": "02:02:27", "text": "その時食定は高密度な反響エナジーの中で"}, {"type": "subtitle", "time": 7350.87, "timestamp": "02:02:30", "text": "白い神の女の人を目にしました。一瞬でし"}, {"type": "subtitle", "time": 7354.27, "timestamp": "02:02:34", "text": "たが、あの影は私たちに多くの謎を残した"}, {"type": "subtitle", "time": 7356.95, "timestamp": "02:02:36", "text": "のです。"}, {"type": "subtitle", "time": 7361.35, "timestamp": "02:02:41", "text": "研究会とは何なのか、何ができるのか。"}, {"type": "subtitle", "time": 7365.149, "timestamp": "02:02:45", "text": "そしてなぜ現れたのか。食定がスカイアク"}, {"type": "subtitle", "time": 7368.47, "timestamp": "02:02:48", "text": "で行っていた研究はそれらの謎を解明する"}, {"type": "subtitle", "time": 7371.43, "timestamp": "02:02:51", "text": "ためのものでした。"}, {"type": "subtitle", "time": 7373.87, "timestamp": "02:02:53", "text": "システムに権限を登録してついてきて"}, {"type": "subtitle", "time": 7376.629, "timestamp": "02:02:56", "text": "ください。"}]
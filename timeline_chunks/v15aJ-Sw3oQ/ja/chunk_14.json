[{"type": "subtitle", "time": 840.43, "timestamp": "00:14:00", "text": "この義士を使うようになる前は先天的な病"}, {"type": "subtitle", "time": 845.749, "timestamp": "00:14:05", "text": "で車椅子生活をなくされていました。"}, {"type": "subtitle", "time": 850.269, "timestamp": "00:14:10", "text": "あの時と比べれば思うように動かない体で"}, {"type": "subtitle", "time": 853.47, "timestamp": "00:14:13", "text": "悩むことはなくなっています。"}, {"type": "subtitle", "time": 857.55, "timestamp": "00:14:17", "text": "おかげで自分の追い求めたいものに向かっ"}]
[{"type": "subtitle", "time": 13392.75, "timestamp": "03:43:12", "text": "分かったわ。"}, {"type": "subtitle", "time": 13395.71, "timestamp": "03:43:15", "text": "一緒に暮らしてた時、"}, {"type": "subtitle", "time": 13398.95, "timestamp": "03:43:18", "text": "あなたは既存の研究ではエクソスト"}, {"type": "subtitle", "time": 13404.07, "timestamp": "03:43:24", "text": "ライダーと最主はでもあなたは私以外の人"}, {"type": "subtitle", "time": 13409.269, "timestamp": "03:43:29", "text": "にその話をするがなかった。"}, {"type": "subtitle", "time": 13412.389, "timestamp": "03:43:32", "text": "正式に飲み込まれた残骸の中を歩き回っ"}, {"type": "subtitle", "time": 13415.71, "timestamp": "03:43:35", "text": "時間の混沌としたボイドスペースにいつ"}, {"type": "chat", "time": 13419.983, "timestamp": "03:43:39", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "bro's speedrunning"}, {"type": "subtitle", "time": 13421.269, "timestamp": "03:43:41", "text": "飲み込まれたのか私には分からなかった。"}, {"type": "subtitle", "time": 13424.71, "timestamp": "03:43:44", "text": "ずっと会えてなかったしもり"}, {"type": "subtitle", "time": 13428.229, "timestamp": "03:43:48", "text": "からあなたを感じたかったの。"}, {"type": "subtitle", "time": 13439.99, "timestamp": "03:43:59", "text": "周波数同士のかなつがりを頼りに私は無数"}]
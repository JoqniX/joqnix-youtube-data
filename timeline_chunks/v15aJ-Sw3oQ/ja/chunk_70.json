[{"type": "subtitle", "time": 4218.83, "timestamp": "01:10:18", "text": "前、ヘリオスの発射時、配米者付近で"}, {"type": "subtitle", "time": 4221.669, "timestamp": "01:10:21", "text": "ボイドマター濃度が異常に上"}, {"type": "subtitle", "time": 4225.39, "timestamp": "01:10:25", "text": "発射に問題を引き起こした。"}, {"type": "subtitle", "time": 4229.11, "timestamp": "01:10:29", "text": "原因は不明だが、モギ教授が持ち帰ってき"}, {"type": "subtitle", "time": 4233.03, "timestamp": "01:10:33", "text": "た装置の派形と比較したら分かったよ。誰"}, {"type": "subtitle", "time": 4237.35, "timestamp": "01:10:37", "text": "かが意図的に引き起こしたものだね。"}, {"type": "subtitle", "time": 4248.229, "timestamp": "01:10:48", "text": "ヘルセン先生、俺は本当に何も覚えてい"}, {"type": "subtitle", "time": 4255.75, "timestamp": "01:10:55", "text": "そう緊張する必要はないよ。ルシラー先生"}, {"type": "subtitle", "time": 4258.83, "timestamp": "01:10:58", "text": "に聞いたところ容疑者から外れているそう"}]
[{"type": "subtitle", "time": 6001.07, "timestamp": "01:40:01", "text": "考えるだけでも最悪よも。もしかしたら私"}, {"type": "subtitle", "time": 6013.669, "timestamp": "01:40:13", "text": "そうだといいけど。でも何年も前の話。"}, {"type": "subtitle", "time": 6018.95, "timestamp": "01:40:18", "text": "この歌は自分を表現する。ただ誰かに共感"}, {"type": "subtitle", "time": 6022.27, "timestamp": "01:40:22", "text": "してもらえたり、ぬくもりや痛みを感じて"}]
[{"type": "subtitle", "time": 14944.189, "timestamp": "04:09:04", "text": "最初は本当に驚いたわ。"}, {"type": "subtitle", "time": 14979.87, "timestamp": "04:09:39", "text": "縁をなす時間と運命。でも私と彼女の"}, {"type": "subtitle", "time": 14984.67, "timestamp": "04:09:44", "text": "出会いは10数年前の私が的確者として"}, {"type": "subtitle", "time": 14988.189, "timestamp": "04:09:48", "text": "エクソストライダーと共鳴し、この特殊な"}, {"type": "subtitle", "time": 14992.63, "timestamp": "04:09:52", "text": "状態の私だけがボイドスペース滅びを免学"}, {"type": "subtitle", "time": 14996.149, "timestamp": "04:09:56", "text": "れたラハイロイに彼女が訪れ"}, {"type": "subtitle", "time": 14998.51, "timestamp": "04:09:58", "text": "あの人に助けられた私"}]
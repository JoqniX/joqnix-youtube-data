[{"type": "subtitle", "time": 14160.189, "timestamp": "03:56:00", "text": "人のことがそうね。"}, {"type": "subtitle", "time": 14164.269, "timestamp": "03:56:04", "text": "最初はそうでもなかったけど、"}, {"type": "subtitle", "time": 14169.79, "timestamp": "03:56:09", "text": "正直これまで何か特別やり、"}, {"type": "subtitle", "time": 14173.99, "timestamp": "03:56:13", "text": "救世主になりたいっていうのも結局あなた"}, {"type": "subtitle", "time": 14177.269, "timestamp": "03:56:17", "text": "の真似に過ぎなかったし。"}, {"type": "subtitle", "time": 14178.99, "timestamp": "03:56:18", "text": "でも"}, {"type": "subtitle", "time": 14182.95, "timestamp": "03:56:22", "text": "死んでから時間をモて余す中で気づけな星"}, {"type": "subtitle", "time": 14186.63, "timestamp": "03:56:26", "text": "のようにく存在。よりも星し"}]
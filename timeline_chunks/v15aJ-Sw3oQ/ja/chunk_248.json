[{"type": "subtitle", "time": 14897.269, "timestamp": "04:08:17", "text": "声が出ない。腕も"}, {"type": "subtitle", "time": 14900.67, "timestamp": "04:08:20", "text": "よく聞いて。"}, {"type": "subtitle", "time": 14903.229, "timestamp": "04:08:23", "text": "それは"}, {"type": "subtitle", "time": 14908.79, "timestamp": "04:08:28", "text": "遠い昔。星の海を渡り、空両者は"}, {"type": "subtitle", "time": 14910.83, "timestamp": "04:08:30", "text": "ストライダーゲートから飛び出す。"}, {"type": "subtitle", "time": 14914.149, "timestamp": "04:08:34", "text": "エクソライダーにも戦闘機能は期待は"}, {"type": "subtitle", "time": 14920.67, "timestamp": "04:08:40", "text": "ボロボロでエネルギーを本来なら名でも"}, {"type": "subtitle", "time": 14926.109, "timestamp": "04:08:46", "text": "その時エイメスという人物が名エクソスト"}, {"type": "subtitle", "time": 14929.429, "timestamp": "04:08:49", "text": "ライダーは眺めるしかなかった。"}]
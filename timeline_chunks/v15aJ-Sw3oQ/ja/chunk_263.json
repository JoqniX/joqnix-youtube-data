[{"type": "subtitle", "time": 15780.67, "timestamp": "04:23:00", "text": "ゲートを開き、名式という災いの現凶を"}, {"type": "subtitle", "time": 15783.75, "timestamp": "04:23:03", "text": "立つ必要はあった。"}, {"type": "subtitle", "time": 15788.309, "timestamp": "04:23:08", "text": "ならそれは私がやればいい。"}, {"type": "subtitle", "time": 15791.63, "timestamp": "04:23:11", "text": "成功確率は限りなく低いかもしれないけど"}, {"type": "subtitle", "time": 15827.55, "timestamp": "04:23:47", "text": "ടുമോഇക്വസ"}]
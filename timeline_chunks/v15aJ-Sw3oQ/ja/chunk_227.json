[{"type": "subtitle", "time": 13621.87, "timestamp": "03:47:01", "text": "そんな時"}, {"type": "subtitle", "time": 13625.309, "timestamp": "03:47:05", "text": "ずっと大切にしてたあなたの周波数が"}, {"type": "subtitle", "time": 13629.149, "timestamp": "03:47:09", "text": "ボイドマターに汚染されて私の力を"}, {"type": "subtitle", "time": 13632.229, "timestamp": "03:47:12", "text": "引き裂いた。"}, {"type": "subtitle", "time": 13634.469, "timestamp": "03:47:14", "text": "それで"}, {"type": "subtitle", "time": 13646.11, "timestamp": "03:47:26", "text": "あれは私の心から生まれたもの。"}, {"type": "subtitle", "time": 13650.95, "timestamp": "03:47:30", "text": "あなたの教遇を思う不安や想像、恐れの"}, {"type": "subtitle", "time": 13653.149, "timestamp": "03:47:33", "text": "決晶。"}, {"type": "subtitle", "time": 13654.75, "timestamp": "03:47:34", "text": "最初"}, {"type": "subtitle", "time": 13657.75, "timestamp": "03:47:37", "text": "シギルムには故郷に帰るという本能しか"}, {"type": "subtitle", "time": 13660.07, "timestamp": "03:47:40", "text": "なかった。"}, {"type": "subtitle", "time": 13664.309, "timestamp": "03:47:44", "text": "それで自分を満たそうと無意識にあなたの"}, {"type": "subtitle", "time": 13668.87, "timestamp": "03:47:48", "text": "周波数を求め、私の権限も奪おうとしたの"}, {"type": "subtitle", "time": 13671.03, "timestamp": "03:47:51", "text": "。"}, {"type": "subtitle", "time": 13674.07, "timestamp": "03:47:54", "text": "エクソストライダーを起動させ、"}, {"type": "subtitle", "time": 13677.83, "timestamp": "03:47:57", "text": "ストライダーゲートを通り、故郷へ帰る"}, {"type": "subtitle", "time": 13679.99, "timestamp": "03:47:59", "text": "ためね。"}]
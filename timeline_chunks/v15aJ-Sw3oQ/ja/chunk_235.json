[{"type": "subtitle", "time": 14108.99, "timestamp": "03:55:08", "text": "canbecanfinallysee"}, {"type": "subtitle", "time": 14143.71, "timestamp": "03:55:43", "text": "この10数年間私が気まぐれに曲が好きっ"}, {"type": "subtitle", "time": 14149.83, "timestamp": "03:55:49", "text": "ていう気持ちを語ったり、実は自分の曲を"}, {"type": "subtitle", "time": 14153.469, "timestamp": "03:55:53", "text": "あれはもう私だけのもの"}, {"type": "subtitle", "time": 14156.389, "timestamp": "03:55:56", "text": "を聞きたい人がいるなら本当にラハロイの"}]
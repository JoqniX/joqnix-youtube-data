[{"type": "subtitle", "time": 13038.59, "timestamp": "03:37:18", "text": "私には1人の家族がいるの。"}, {"type": "subtitle", "time": 13045.07, "timestamp": "03:37:25", "text": "家族とは互いを慈くしみ気遣う存在。"}, {"type": "subtitle", "time": 13048.15, "timestamp": "03:37:28", "text": "だから私はあの人は口に出さないけど、"}, {"type": "subtitle", "time": 13050.87, "timestamp": "03:37:30", "text": "荷物が重すぎると"}, {"type": "subtitle", "time": 13061.11, "timestamp": "03:37:41", "text": "最近また漂白者にあったの。彼女は以前"}, {"type": "subtitle", "time": 13064.87, "timestamp": "03:37:44", "text": "よりも少し力を抜いて生きてるように見え"}]
[{"type": "subtitle", "time": 7380.189, "timestamp": "02:03:00", "text": "次は中央エリアに行きましょう。そこには"}, {"type": "subtitle", "time": 7384.149, "timestamp": "02:03:04", "text": "もう1つの重要な成果。天空会の雫をコア"}, {"type": "subtitle", "time": 7388.79, "timestamp": "02:03:08", "text": "にした移転装置が納められています。"}, {"type": "subtitle", "time": 7391.629, "timestamp": "02:03:11", "text": "空会の私"}, {"type": "subtitle", "time": 7396.03, "timestamp": "02:03:16", "text": "墜落物にあったならもしかして異変が"}, {"type": "subtitle", "time": 7398.39, "timestamp": "02:03:18", "text": "起こる[泣き声]前から始まってた研究"}, {"type": "subtitle", "time": 7408.99, "timestamp": "02:03:28", "text": "これ超すごい発見だよ。感動。"}, {"type": "subtitle", "time": 7413.229, "timestamp": "02:03:33", "text": "やっぱり表現に来てよかった。"}, {"type": "subtitle", "time": 7427.109, "timestamp": "02:03:47", "text": "1"}]
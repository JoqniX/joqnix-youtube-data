[{"type": "subtitle", "time": 6246.35, "timestamp": "01:44:06", "text": "太陽の精霊が外に行ったわ。早くついて"}, {"type": "subtitle", "time": 6257.75, "timestamp": "01:44:17", "text": "学園の外に出るなら行き先は老表現かな。"}, {"type": "subtitle", "time": 6261.83, "timestamp": "01:44:21", "text": "あ、多分リンクダスパインね。"}, {"type": "subtitle", "time": 6263.39, "timestamp": "01:44:23", "text": "あの剣の上なの?"}]
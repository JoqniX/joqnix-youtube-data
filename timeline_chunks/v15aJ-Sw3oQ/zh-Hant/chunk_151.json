[{"type": "subtitle", "time": 9070.63, "timestamp": "02:31:10", "text": "我覺得我剛才好像也說過這句話。"}, {"type": "subtitle", "time": 9072.51, "timestamp": "02:31:12", "text": "這是其中之一。"}, {"type": "subtitle", "time": 9072.67, "timestamp": "02:31:12", "text": "去"}, {"type": "subtitle", "time": 9113.59, "timestamp": "02:31:53", "text": "艾姆斯仍然"}]
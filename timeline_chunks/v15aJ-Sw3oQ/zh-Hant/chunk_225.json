[{"type": "subtitle", "time": 13501.63, "timestamp": "03:45:01", "text": "我不太理解它的結構。"}, {"type": "subtitle", "time": 13506.91, "timestamp": "03:45:06", "text": "根據昨天的情況來看，這很可能是一顆故障的通訊衛星。"}, {"type": "subtitle", "time": 13509.469, "timestamp": "03:45:09", "text": "我也是這麼想的。"}, {"type": "subtitle", "time": 13512.189, "timestamp": "03:45:12", "text": "在殘骸之中"}, {"type": "subtitle", "time": 13516.07, "timestamp": "03:45:16", "text": "我找到了另一個與你相關的頻率。"}, {"type": "subtitle", "time": 13524.07, "timestamp": "03:45:24", "text": "你寄回家鄉的信件記錄包含"}, {"type": "subtitle", "time": 13526.99, "timestamp": "03:45:26", "text": "除了任務之外，還有其他任務"}, {"type": "subtitle", "time": 13540.91, "timestamp": "03:45:40", "text": "你只想再去一次家鄉。"}, {"type": "subtitle", "time": 13549.95, "timestamp": "03:45:49", "text": "但我看到了。"}, {"type": "subtitle", "time": 13553.309, "timestamp": "03:45:53", "text": "他們拒絕"}, {"type": "subtitle", "time": 13557.429, "timestamp": "03:45:57", "text": "因為這對你的任務至關重要。"}]
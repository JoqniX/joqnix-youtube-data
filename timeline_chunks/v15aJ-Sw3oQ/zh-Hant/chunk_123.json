[{"type": "subtitle", "time": 7380.189, "timestamp": "02:03:00", "text": "接下來，我們去中心區域。那裡"}, {"type": "subtitle", "time": 7384.149, "timestamp": "02:03:04", "text": "又一項重要成就。天空社團的滴水是核心"}, {"type": "subtitle", "time": 7388.79, "timestamp": "02:03:08", "text": "搬遷設備安裝在室內。"}, {"type": "subtitle", "time": 7391.629, "timestamp": "02:03:11", "text": "我的空蕩蕩的會議"}, {"type": "subtitle", "time": 7396.03, "timestamp": "02:03:16", "text": "如果它是在墜毀物體中發現的，那或許說明發生了什麼不尋常的事情。"}, {"type": "subtitle", "time": 7398.39, "timestamp": "02:03:18", "text": "研究甚至在哭泣開始之前就已經開始了。"}, {"type": "subtitle", "time": 7408.99, "timestamp": "02:03:28", "text": "這是一個驚人的發現！印象深刻。"}, {"type": "subtitle", "time": 7413.229, "timestamp": "02:03:33", "text": "我很高興能來到這裡表達自己。"}, {"type": "subtitle", "time": 7427.109, "timestamp": "02:03:47", "text": "1"}]
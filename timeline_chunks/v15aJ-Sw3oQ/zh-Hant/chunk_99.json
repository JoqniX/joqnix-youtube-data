[{"type": "subtitle", "time": 5960.83, "timestamp": "01:39:20", "text": "關於我"}, {"type": "subtitle", "time": 5963.669, "timestamp": "01:39:23", "text": "只是沒有隱藏而已。"}, {"type": "subtitle", "time": 5967.629, "timestamp": "01:39:27", "text": "這只是我的一個小嗜好。攝影和遊戲"}, {"type": "subtitle", "time": 5970.87, "timestamp": "01:39:30", "text": "我喜歡看電影，也喜歡和朋友一起看電影。"}, {"type": "subtitle", "time": 5973.79, "timestamp": "01:39:33", "text": "因為我喜歡他。"}, {"type": "subtitle", "time": 5977.43, "timestamp": "01:39:37", "text": "我也是這麼想的。只有有限數量的人能夠繼續留校。"}, {"type": "subtitle", "time": 5981.109, "timestamp": "01:39:41", "text": "你老了，不是嗎？我不一定想要在研究中取得成果。"}, {"type": "subtitle", "time": 5984.79, "timestamp": "01:39:44", "text": "事實並非如此，我想盡情享受校園生活。"}, {"type": "subtitle", "time": 5993.91, "timestamp": "01:39:53", "text": "十多年前，我從未想過自己會變成現在這樣的鬼魂。"}, {"type": "subtitle", "time": 5996.669, "timestamp": "01:39:56", "text": "真不敢相信你還是個學生。"}]
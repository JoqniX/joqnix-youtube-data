[{"type": "subtitle", "time": 11610.99, "timestamp": "03:13:30", "text": "好的。"}, {"type": "subtitle", "time": 11613.83, "timestamp": "03:13:33", "text": "只要我還在，我就不會讓這種事發生。"}, {"type": "subtitle", "time": 11616.309, "timestamp": "03:13:36", "text": "我是說，"}, {"type": "subtitle", "time": 11619.11, "timestamp": "03:13:39", "text": "我認識的人"}, {"type": "subtitle", "time": 11622.67, "timestamp": "03:13:42", "text": "我現在知道的是…"}, {"type": "subtitle", "time": 11625.51, "timestamp": "03:13:45", "text": "我與"}, {"type": "subtitle", "time": 11628.15, "timestamp": "03:13:48", "text": "也許是她，但我不是"}, {"type": "subtitle", "time": 11629.469, "timestamp": "03:13:49", "text": "我知道我還能找誰"}]
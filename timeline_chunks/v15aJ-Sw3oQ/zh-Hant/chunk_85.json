[{"type": "subtitle", "time": 5105.79, "timestamp": "01:25:05", "text": "但10"}, {"type": "subtitle", "time": 5108.394, "timestamp": "01:25:08", "text": "幾年前的一次飛行訓練課上，他突然失蹤了。我和其他學生一起進入了駕駛艙模擬器。"}, {"type": "subtitle", "time": 5132.75, "timestamp": "01:25:32", "text": "她"}, {"type": "subtitle", "time": 5140.149, "timestamp": "01:25:40", "text": "不知為何，那個人…"}]
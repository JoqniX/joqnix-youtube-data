[{"type": "subtitle", "time": 6578.189, "timestamp": "01:49:38", "text": "如果是天空會的話我能理解，但是…"}, {"type": "subtitle", "time": 6580.95, "timestamp": "01:49:40", "text": "你知道拉海洛伊的歷史吧？"}, {"type": "subtitle", "time": 6584.75, "timestamp": "01:49:44", "text": "Exo，關於那兩個生物的水理論。"}, {"type": "subtitle", "time": 6588.629, "timestamp": "01:49:48", "text": "學院裡有很多這樣的人。"}, {"type": "subtitle", "time": 6591.79, "timestamp": "01:49:51", "text": "只要這道門存在，就會有人想辦法打開它。"}, {"type": "subtitle", "time": 6594.91, "timestamp": "01:49:54", "text": "這似乎是個順理成章的結論。我認為"}, {"type": "subtitle", "time": 6599.35, "timestamp": "01:49:59", "text": "是。虛空風暴及其現在的名稱是它的誕生地"}]
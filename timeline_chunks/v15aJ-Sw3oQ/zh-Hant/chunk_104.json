[{"type": "subtitle", "time": 6246.35, "timestamp": "01:44:06", "text": "太陽神出去了。盡快到達"}, {"type": "subtitle", "time": 6257.75, "timestamp": "01:44:17", "text": "如果我們要出校門，我想我們的目的地應該是那棟舊教學大樓。"}, {"type": "subtitle", "time": 6261.83, "timestamp": "01:44:21", "text": "啊，大概是林克·杜斯賓吧。"}, {"type": "subtitle", "time": 6263.39, "timestamp": "01:44:23", "text": "它在劍的頂端嗎？"}]
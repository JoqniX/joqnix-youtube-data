[{"type": "subtitle", "time": 14944.189, "timestamp": "04:09:04", "text": "我一開始真的很驚訝。"}, {"type": "subtitle", "time": 14979.87, "timestamp": "04:09:39", "text": "時間和命運造就了彼此的連結。但我和她"}, {"type": "subtitle", "time": 14984.67, "timestamp": "04:09:44", "text": "我們第一次見面是在十多年前，當時我正好符合他們的要求。"}, {"type": "subtitle", "time": 14988.189, "timestamp": "04:09:48", "text": "與 Exostrider 產生共鳴，這款特別的"}, {"type": "subtitle", "time": 14992.63, "timestamp": "04:09:52", "text": "只有我，在這種狀態下，才能免於虛空空間的毀滅。"}, {"type": "subtitle", "time": 14996.149, "timestamp": "04:09:56", "text": "她訪問了拉海洛伊"}, {"type": "subtitle", "time": 14998.51, "timestamp": "04:09:58", "text": "我被那個人救了。"}]
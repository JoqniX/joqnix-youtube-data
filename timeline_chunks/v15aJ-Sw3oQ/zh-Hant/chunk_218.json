[{"type": "subtitle", "time": 13115.189, "timestamp": "03:38:35", "text": "她過去總是想念她的家鄉和家。"}, {"type": "subtitle", "time": 13117.75, "timestamp": "03:38:37", "text": "我一直很想念你。"}, {"type": "subtitle", "time": 13121.59, "timestamp": "03:38:41", "text": "但現在我失去了記憶，我很痛苦。"}, {"type": "subtitle", "time": 13124.87, "timestamp": "03:38:44", "text": "沒必要。"}]
[{"type": "subtitle", "time": 7303.47, "timestamp": "02:01:43", "text": "每個人"}, {"type": "subtitle", "time": 7306.709, "timestamp": "02:01:46", "text": "歡迎來到天空方舟。我今天將發佈公告。"}, {"type": "subtitle", "time": 7310.39, "timestamp": "02:01:50", "text": "我叫文治，這件事由我負責。"}, {"type": "subtitle", "time": 7313.79, "timestamp": "02:01:53", "text": "老師們希望今天的參觀活動能夠平安結束。"}, {"type": "subtitle", "time": 7316.03, "timestamp": "02:01:56", "text": "注意不要跟著[音樂]"}]
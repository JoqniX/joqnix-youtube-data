[{"type": "subtitle", "time": 12781.63, "timestamp": "03:33:01", "text": "很久以前"}, {"type": "subtitle", "time": 12785.309, "timestamp": "03:33:05", "text": "一隻黑貓，據信是前任領主的遺物，是故事的結尾。"}, {"type": "subtitle", "time": 12789.75, "timestamp": "03:33:09", "text": "我踏上了一段沒有目的地的旅程。貓為什麼去找救世主？"}, {"type": "subtitle", "time": 12795.95, "timestamp": "03:33:15", "text": "但貓就是貓，還有更多。"}, {"type": "subtitle", "time": 12798.83, "timestamp": "03:33:18", "text": "那裡住著許多小生物。"}, {"type": "subtitle", "time": 12804.07, "timestamp": "03:33:24", "text": "架子。紙箱很小。請"}, {"type": "subtitle", "time": 12806.429, "timestamp": "03:33:26", "text": "幫我。"}, {"type": "chat", "time": 12810.52, "timestamp": "03:33:30", "author": "@JasminVuVT", "avatar": "https://yt4.ggpht.com/aV4gcmeL3SpFgEunlKwYMoVfsJVudLUSlBUu8tAYUazDHRi36mPrplbRk0bBEDOE913NDdYjqA=s64-c-k-c0x00ffffff-no-rj", "message": "hhhiiiiiiiiiiiiiii"}, {"type": "subtitle", "time": 12810.95, "timestamp": "03:33:30", "text": "即使沒人問。"}, {"type": "subtitle", "time": 12813.87, "timestamp": "03:33:33", "text": "是的。"}, {"type": "subtitle", "time": 12816.229, "timestamp": "03:33:36", "text": "他繼續拯救世界。"}]
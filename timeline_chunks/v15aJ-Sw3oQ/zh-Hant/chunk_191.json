[{"type": "subtitle", "time": 11494.03, "timestamp": "03:11:34", "text": "首先，我們得想辦法離開這裡。"}, {"type": "subtitle", "time": 11498.59, "timestamp": "03:11:38", "text": "過猶不及。不只是硬碟的核心，還有我"}, {"type": "subtitle", "time": 11501.229, "timestamp": "03:11:41", "text": "敵方飛機的頻率和飛行員權限"}, {"type": "subtitle", "time": 11504.03, "timestamp": "03:11:44", "text": "所以你的目標就是這個。"}]
[{"type": "subtitle", "time": 6001.07, "timestamp": "01:40:01", "text": "光是想想就覺得可怕。也許我"}, {"type": "subtitle", "time": 6013.669, "timestamp": "01:40:13", "text": "我希望如此。但那是很多年前的事了。"}, {"type": "subtitle", "time": 6018.95, "timestamp": "01:40:18", "text": "這首歌表達了我的內心世界。僅僅是對某人的同情。"}, {"type": "subtitle", "time": 6022.27, "timestamp": "01:40:22", "text": "能夠接受它，或感受到溫暖或疼痛"}]
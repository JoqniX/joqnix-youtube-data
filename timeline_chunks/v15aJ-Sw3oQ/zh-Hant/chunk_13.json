[{"type": "subtitle", "time": 792.509, "timestamp": "00:13:12", "text": "1"}, {"type": "subtitle", "time": 802.79, "timestamp": "00:13:22", "text": "充電完成後，我會回去見我的上司。"}, {"type": "subtitle", "time": 805.269, "timestamp": "00:13:25", "text": "我的本意就是如此。"}, {"type": "subtitle", "time": 809.99, "timestamp": "00:13:29", "text": "畢竟充電的時候我動不了，看到我這副樣子…"}]
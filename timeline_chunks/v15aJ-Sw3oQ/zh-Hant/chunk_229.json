[{"type": "subtitle", "time": 13748.95, "timestamp": "03:49:08", "text": "我們現在該怎麼辦？"}, {"type": "subtitle", "time": 13752.349, "timestamp": "03:49:12", "text": "讓我考慮一下。"}, {"type": "subtitle", "time": 13757.189, "timestamp": "03:49:17", "text": "「家鄉」這個詞現在是否喚起了人們的苦澀之情？"}, {"type": "subtitle", "time": 13759.189, "timestamp": "03:49:19", "text": "它甜嗎？"}, {"type": "subtitle", "time": 13761.59, "timestamp": "03:49:21", "text": "我不太明白"}, {"type": "subtitle", "time": 13765.07, "timestamp": "03:49:25", "text": "但別擔心"}, {"type": "subtitle", "time": 13769.309, "timestamp": "03:49:29", "text": "在《因為失憶而拯救世界》中"}, {"type": "subtitle", "time": 13771.469, "timestamp": "03:49:31", "text": "Solaris 戰鬥到了黎明。"}, {"type": "subtitle", "time": 13774.309, "timestamp": "03:49:34", "text": "哦，到處亂跑，拼命躲在黑鹽前面"}, {"type": "subtitle", "time": 13775.75, "timestamp": "03:49:35", "text": "我掙扎了很久。"}]
[{"type": "subtitle", "time": 15736.87, "timestamp": "04:22:16", "text": "他小時候"}, {"type": "subtitle", "time": 15741.07, "timestamp": "04:22:21", "text": "他幫助她應對大海。"}, {"type": "subtitle", "time": 15767.07, "timestamp": "04:22:47", "text": "公車"}, {"type": "subtitle", "time": 15769.03, "timestamp": "04:22:49", "text": "被拉到斯特萊德門另一側"}, {"type": "subtitle", "time": 15771.91, "timestamp": "04:22:51", "text": "如果你被吸引住了，就穿過那道門。"}, {"type": "subtitle", "time": 15774.91, "timestamp": "04:22:54", "text": "我們應該讓他們回來。"}, {"type": "subtitle", "time": 15777.269, "timestamp": "04:22:57", "text": "有人會贏得ExoStrider。"}]
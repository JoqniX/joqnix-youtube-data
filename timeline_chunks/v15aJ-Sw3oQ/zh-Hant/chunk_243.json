[{"type": "subtitle", "time": 14608.95, "timestamp": "04:03:28", "text": "太棒了。感覺哪裡不太對勁。"}, {"type": "subtitle", "time": 14611.189, "timestamp": "04:03:31", "text": "我仍然想和某人在一起。"}, {"type": "subtitle", "time": 14613.07, "timestamp": "04:03:33", "text": "麥克風沒有靜音。"}, {"type": "subtitle", "time": 14638.79, "timestamp": "04:03:58", "text": "我人生中最重大的決定是在一開始就做出的。"}]
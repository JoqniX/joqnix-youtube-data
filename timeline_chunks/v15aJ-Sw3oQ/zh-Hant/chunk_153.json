[{"type": "subtitle", "time": 9185.15, "timestamp": "02:33:05", "text": "我小時候，我的父母被罷工吞噬了。"}, {"type": "subtitle", "time": 9189.51, "timestamp": "02:33:09", "text": "它消失了。過了一段時間，我也忘了他們的外表。"}, {"type": "subtitle", "time": 9200.03, "timestamp": "02:33:20", "text": "所以即使他去世了，也並非全是壞事。"}, {"type": "subtitle", "time": 9212.63, "timestamp": "02:33:32", "text": "自從艾姆斯變成數位幽靈後"}, {"type": "subtitle", "time": 9214.83, "timestamp": "02:33:34", "text": "什麼？"}]
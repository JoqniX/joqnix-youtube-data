[{"type": "subtitle", "time": 14897.269, "timestamp": "04:08:17", "text": "我無法說話。武器"}, {"type": "subtitle", "time": 14900.67, "timestamp": "04:08:20", "text": "仔細聽。"}, {"type": "subtitle", "time": 14903.229, "timestamp": "04:08:23", "text": "這是"}, {"type": "subtitle", "time": 14908.79, "timestamp": "04:08:28", "text": "很久以前。穿越星海，天空中的兩人"}, {"type": "subtitle", "time": 14910.83, "timestamp": "04:08:30", "text": "從斯特萊德之門跳出去。"}, {"type": "subtitle", "time": 14914.149, "timestamp": "04:08:34", "text": "我們也可以期待Exoriders具備戰鬥能力。"}, {"type": "subtitle", "time": 14920.67, "timestamp": "04:08:40", "text": "它已經破爛不堪，應該沒有任何能量了。"}, {"type": "subtitle", "time": 14926.109, "timestamp": "04:08:46", "text": "當時，一個名叫艾姆斯的人被稱為驅魔人。"}, {"type": "subtitle", "time": 14929.429, "timestamp": "04:08:49", "text": "騎手只能眼睜睜地看著。"}]
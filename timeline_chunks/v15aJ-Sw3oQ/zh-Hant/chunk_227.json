[{"type": "subtitle", "time": 13621.87, "timestamp": "03:47:01", "text": "在那種時候"}, {"type": "subtitle", "time": 13625.309, "timestamp": "03:47:05", "text": "我一直很珍惜您的頻率"}, {"type": "subtitle", "time": 13629.149, "timestamp": "03:47:09", "text": "被虛空物質污染，我的力量"}, {"type": "subtitle", "time": 13632.229, "timestamp": "03:47:12", "text": "我把它撕碎了。"}, {"type": "subtitle", "time": 13634.469, "timestamp": "03:47:14", "text": "所以"}, {"type": "subtitle", "time": 13646.11, "timestamp": "03:47:26", "text": "那是發自自己的內心。"}, {"type": "subtitle", "time": 13650.95, "timestamp": "03:47:30", "text": "對治療的焦慮、想像與恐懼"}, {"type": "subtitle", "time": 13653.149, "timestamp": "03:47:33", "text": "決定性。"}, {"type": "subtitle", "time": 13654.75, "timestamp": "03:47:34", "text": "第一的"}, {"type": "subtitle", "time": 13657.75, "timestamp": "03:47:37", "text": "西吉魯姆除了想回到故鄉之外，沒有其他本能。"}, {"type": "subtitle", "time": 13660.07, "timestamp": "03:47:40", "text": "它不在那裡。"}, {"type": "subtitle", "time": 13664.309, "timestamp": "03:47:44", "text": "所以，你會在不知不覺中試圖滿足自己。"}, {"type": "subtitle", "time": 13668.87, "timestamp": "03:47:48", "text": "他們想要我的頻率，並試圖剝奪我的權力。"}, {"type": "subtitle", "time": 13671.04, "timestamp": "03:47:51", "text": "。 啟動外骨骼行者"}, {"type": "subtitle", "time": 13674.08, "timestamp": "03:47:54", "text": "啟動外骨骼行者 穿過斯特萊德之門，我回到了我的家鄉。"}, {"type": "subtitle", "time": 13677.84, "timestamp": "03:47:57", "text": "穿過斯特萊德之門，我回到了我的家鄉。 正是因為這個原因。"}]
[{"type": "subtitle", "time": 8201.15, "timestamp": "02:16:41", "text": "這樣如何？"}, {"type": "subtitle", "time": 8205.509, "timestamp": "02:16:45", "text": "瞧，拉哈洛伊街區已經完工了。"}, {"type": "subtitle", "time": 8207.429, "timestamp": "02:16:47", "text": "在太空奇幻卡蒂亞系列中"}, {"type": "subtitle", "time": 8212.07, "timestamp": "02:16:52", "text": "每次都會包含這個小遊戲。我的"}, {"type": "subtitle", "time": 8216.11, "timestamp": "02:16:56", "text": "在入口處。我以前很擅長這個。這種異常"}]
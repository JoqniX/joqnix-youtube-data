[{"type": "subtitle", "time": 13392.75, "timestamp": "03:43:12", "text": "我明白。"}, {"type": "subtitle", "time": 13395.71, "timestamp": "03:43:15", "text": "當我們住在一起的時候，"}, {"type": "subtitle", "time": 13398.95, "timestamp": "03:43:18", "text": "在現有研究中，你外顯子"}, {"type": "subtitle", "time": 13404.07, "timestamp": "03:43:24", "text": "騎士和上帝是同一位，但你是另一個人，與我截然不同。"}, {"type": "subtitle", "time": 13409.269, "timestamp": "03:43:29", "text": "我沒告訴他這件事。"}, {"type": "subtitle", "time": 13412.389, "timestamp": "03:43:32", "text": "在已被官方吞噬的廢墟中漫步"}, {"type": "subtitle", "time": 13415.71, "timestamp": "03:43:35", "text": "當身處混沌虛空的時間空間"}, {"type": "chat", "time": 13419.983, "timestamp": "03:43:39", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "bro's speedrunning"}, {"type": "subtitle", "time": 13421.269, "timestamp": "03:43:41", "text": "我不知道自己是否被吞了下去。"}, {"type": "subtitle", "time": 13424.71, "timestamp": "03:43:44", "text": "我很久沒見過下森了。"}, {"type": "subtitle", "time": 13428.229, "timestamp": "03:43:48", "text": "我想從內心深處感受你。"}, {"type": "subtitle", "time": 13439.99, "timestamp": "03:43:59", "text": "依靠頻率之間的聯繫，我擁有無數種可能。"}]
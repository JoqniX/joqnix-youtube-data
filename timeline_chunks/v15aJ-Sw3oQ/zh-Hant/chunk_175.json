[{"type": "subtitle", "time": 10510.71, "timestamp": "02:55:10", "text": "這是我家鄉送給我的。"}, {"type": "subtitle", "time": 10513.389, "timestamp": "02:55:13", "text": "是的。大學教師"}, {"type": "subtitle", "time": 10515.95, "timestamp": "02:55:15", "text": "因為情況有點複雜。"}, {"type": "subtitle", "time": 10517.83, "timestamp": "02:55:17", "text": "然後更多"}, {"type": "subtitle", "time": 10521.91, "timestamp": "02:55:21", "text": "1"}, {"type": "subtitle", "time": 10542.349, "timestamp": "02:55:42", "text": "是的。我想家了。"}, {"type": "subtitle", "time": 10544.71, "timestamp": "02:55:44", "text": "這或許是真的。但"}, {"type": "subtitle", "time": 10545.389, "timestamp": "02:55:45", "text": "奧姆塞"}, {"type": "subtitle", "time": 10556.389, "timestamp": "02:55:56", "text": "是的？"}, {"type": "subtitle", "time": 10558.07, "timestamp": "02:55:58", "text": "現在"}]
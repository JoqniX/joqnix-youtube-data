[{"type": "subtitle", "time": 4812.99, "timestamp": "01:20:12", "text": "換句話說"}, {"type": "subtitle", "time": 4816.03, "timestamp": "01:20:16", "text": "Exostrider 的劍 Exostr"}, {"type": "subtitle", "time": 4819.229, "timestamp": "01:20:19", "text": "如果你查閱家族記錄，你會發現 Rider 和 Nameshiki 分別是什麼。"}, {"type": "subtitle", "time": 4821.99, "timestamp": "01:20:21", "text": "正如你所看到的，Exostrider 的力量是"}, {"type": "subtitle", "time": 4826.51, "timestamp": "01:20:26", "text": "我差點崩潰了一次。但"}, {"type": "subtitle", "time": 4829.75, "timestamp": "01:20:29", "text": "Exostrider驅動器的一發子彈"}, {"type": "subtitle", "time": 4834.27, "timestamp": "01:20:34", "text": "一道強光將會出現。"}, {"type": "subtitle", "time": 4843.99, "timestamp": "01:20:43", "text": "然後，異星行者舉起劍，舉行了儀式。"}, {"type": "subtitle", "time": 4847.95, "timestamp": "01:20:47", "text": "我把它封存起來了。於是，我們來到了拉海洛。"}]
[{"type": "subtitle", "time": 9667.87, "timestamp": "02:41:07", "text": "它的真面目是黑洞"}, {"type": "subtitle", "time": 9672.15, "timestamp": "02:41:12", "text": "事實上，目前為止，這個假設是我提出的。"}, {"type": "subtitle", "time": 9673.71, "timestamp": "02:41:13", "text": "僅有的"}, {"type": "subtitle", "time": 9688.07, "timestamp": "02:41:28", "text": "名義公式的時空本身就是碎片化的，而且各不相同。"}, {"type": "subtitle", "time": 9691.389, "timestamp": "02:41:31", "text": "那些被時代吞噬的人，依然停留在原地。"}, {"type": "subtitle", "time": 9694.67, "timestamp": "02:41:34", "text": "它會出現的。你曾與許多名字戰鬥過"}, {"type": "subtitle", "time": 9697.59, "timestamp": "02:41:37", "text": "我聽說這件事一直在發生。空隙"}, {"type": "subtitle", "time": 9700.55, "timestamp": "02:41:40", "text": "我閒逛的時候看到的。"}, {"type": "subtitle", "time": 9704.469, "timestamp": "02:41:44", "text": "拉哈洛伊所看到的命名公式的力量，只是它本身力量的一小部分。"}, {"type": "subtitle", "time": 9713.429, "timestamp": "02:41:53", "text": "這就是原因"}, {"type": "subtitle", "time": 9716.75, "timestamp": "02:41:56", "text": "直到我覺醒為Exostrider"}]
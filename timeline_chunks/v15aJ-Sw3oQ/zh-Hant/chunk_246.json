[{"type": "subtitle", "time": 14762.51, "timestamp": "04:06:02", "text": "艾姆斯。"}, {"type": "subtitle", "time": 14812.07, "timestamp": "04:06:52", "text": "我有點睏了。"}, {"type": "subtitle", "time": 14813.95, "timestamp": "04:06:53", "text": "西瑞姆偷走了那股爆發性的速度。"}, {"type": "subtitle", "time": 14816.149, "timestamp": "04:06:56", "text": "小睡一會兒沒關係。"}]
[{"type": "subtitle", "time": 14108.99, "timestamp": "03:55:08", "text": "終於可以看到"}, {"type": "subtitle", "time": 14143.71, "timestamp": "03:55:43", "text": "過去十年左右，我一直隨心所欲地喜歡歌曲。"}, {"type": "subtitle", "time": 14149.83, "timestamp": "03:55:49", "text": "他談到了這些感受，實際上也談到了他自己的歌曲。"}, {"type": "subtitle", "time": 14153.469, "timestamp": "03:55:53", "text": "現在那是我的了。"}, {"type": "subtitle", "time": 14156.389, "timestamp": "03:55:56", "text": "如果有人想聽的話，那麼，拉哈羅伊的"}]
[{"type": "subtitle", "time": 4812.99, "timestamp": "01:20:12", "text": "In other words,"}, {"type": "subtitle", "time": 4816.03, "timestamp": "01:20:16", "text": "Exostrider's sword,"}, {"type": "subtitle", "time": 4819.229, "timestamp": "01:20:19", "text": "Exostrider, and the name of the family, as can be seen from reading the family records,"}, {"type": "subtitle", "time": 4821.99, "timestamp": "01:20:21", "text": "Exostrider's power was once nearly"}, {"type": "subtitle", "time": 4826.51, "timestamp": "01:20:26", "text": "defeated by Meishiki.  However, a flash of"}, {"type": "subtitle", "time": 4834.27, "timestamp": "01:20:34", "text": "light appears in the blink of an eye from the Exostrider's drive"}, {"type": "subtitle", "time": 4843.99, "timestamp": "01:20:43", "text": "Then the Exostrider raised its sword and"}, {"type": "subtitle", "time": 4847.95, "timestamp": "01:20:47", "text": "sealed away the name.  And so,"}]
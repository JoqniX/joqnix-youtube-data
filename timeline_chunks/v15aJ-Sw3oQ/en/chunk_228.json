[{"type": "subtitle", "time": 13682.03, "timestamp": "03:48:02", "text": "Yes, the more I"}, {"type": "subtitle", "time": 13685.75, "timestamp": "03:48:05", "text": "absorb your frequency, the clearer my words become"}, {"type": "subtitle", "time": 13688.429, "timestamp": "03:48:08", "text": ".   That's why I wanted to get rid of it"}, {"type": "subtitle", "time": 13694.51, "timestamp": "03:48:14", "text": "before you found out"}, {"type": "subtitle", "time": 13697.469, "timestamp": "03:48:17", "text": ".   I'm sorry for keeping quiet about this for so long"}, {"type": "chat", "time": 13700.741, "timestamp": "03:48:20", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "are you enjoying the story?"}]
[{"type": "subtitle", "time": 12781.63, "timestamp": "03:33:01", "text": "Long ago, a"}, {"type": "subtitle", "time": 12785.309, "timestamp": "03:33:05", "text": "black cat, once thought to be the Lord of the Old World,"}, {"type": "subtitle", "time": 12789.75, "timestamp": "03:33:09", "text": "embarked on an endless journey.  Why did the cat go to the savior"}, {"type": "subtitle", "time": 12795.95, "timestamp": "03:33:15", "text": "? But the cat was a cat, and there were"}, {"type": "subtitle", "time": 12798.83, "timestamp": "03:33:18", "text": "many even smaller creatures living there"}, {"type": "subtitle", "time": 12804.07, "timestamp": "03:33:24", "text": ".  The cardboard box was small.  Please"}, {"type": "subtitle", "time": 12806.429, "timestamp": "03:33:26", "text": "help me.   Even"}, {"type": "chat", "time": 12810.52, "timestamp": "03:33:30", "author": "@JasminVuVT", "avatar": "https://yt4.ggpht.com/aV4gcmeL3SpFgEunlKwYMoVfsJVudLUSlBUu8tAYUazDHRi36mPrplbRk0bBEDOE913NDdYjqA=s64-c-k-c0x00ffffff-no-rj", "message": "hhhiiiiiiiiiiiiiii"}, {"type": "subtitle", "time": 12810.95, "timestamp": "03:33:30", "text": "without being asked."}, {"type": "subtitle", "time": 12813.87, "timestamp": "03:33:33", "text": "Yes.   He continued to"}, {"type": "subtitle", "time": 12816.229, "timestamp": "03:33:36", "text": "save the world.   You understand"}]
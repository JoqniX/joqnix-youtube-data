[{"type": "subtitle", "time": 8761.63, "timestamp": "02:26:01", "text": "Sky Arc System has stabilized."}, {"type": "subtitle", "time": 8766.23, "timestamp": "02:26:06", "text": "Years ago, he woke up from the rescue device, and now"}, {"type": "subtitle", "time": 8768.389, "timestamp": "02:26:08", "text": "this cabin is covered in a void storm"}, {"type": "subtitle", "time": 8772.67, "timestamp": "02:26:12", "text": ".  Neo, that commander has also mutated, and I have"}, {"type": "subtitle", "time": 8774.429, "timestamp": "02:26:14", "text": "lost even my reason.   Too much"}, {"type": "subtitle", "time": 8811.75, "timestamp": "02:26:51", "text": "Look at the gun."}, {"type": "subtitle", "time": 8812.75, "timestamp": "02:26:52", "text": "Oh,"}]
[{"type": "subtitle", "time": 13621.87, "timestamp": "03:47:01", "text": "that time, the"}, {"type": "subtitle", "time": 13625.309, "timestamp": "03:47:05", "text": "frequency of you, which I had always cherished,"}, {"type": "subtitle", "time": 13629.149, "timestamp": "03:47:09", "text": "became contaminated with void matter, tearing my power apart"}, {"type": "subtitle", "time": 13632.229, "timestamp": "03:47:12", "text": ".   And"}, {"type": "subtitle", "time": 13634.469, "timestamp": "03:47:14", "text": "that's how"}, {"type": "subtitle", "time": 13646.11, "timestamp": "03:47:26", "text": "That was born from my heart.   The"}, {"type": "subtitle", "time": 13653.149, "timestamp": "03:47:33", "text": "crystallization of anxieties, imaginations, and fears about your treatment."}, {"type": "subtitle", "time": 13654.75, "timestamp": "03:47:34", "text": "Initially,"}, {"type": "subtitle", "time": 13657.75, "timestamp": "03:47:37", "text": "Sigilum had only one instinct: to return to his homeland"}, {"type": "subtitle", "time": 13660.07, "timestamp": "03:47:40", "text": "."}, {"type": "subtitle", "time": 13664.309, "timestamp": "03:47:44", "text": "So, unconsciously, in an attempt to satisfy herself, she"}, {"type": "subtitle", "time": 13668.87, "timestamp": "03:47:48", "text": "sought your frequency and tried to seize my authority as well"}, {"type": "subtitle", "time": 13671.03, "timestamp": "03:47:51", "text": ".   To"}, {"type": "subtitle", "time": 13674.07, "timestamp": "03:47:54", "text": "activate the ExoStrider,"}, {"type": "subtitle", "time": 13677.83, "timestamp": "03:47:57", "text": "pass through the Strider Gate, and return home"}, {"type": "subtitle", "time": 13679.99, "timestamp": "03:47:59", "text": "."}]
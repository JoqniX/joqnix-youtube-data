[{"type": "subtitle", "time": 8524.07, "timestamp": "02:22:04", "text": "This was supposed to be done when we are"}, {"type": "subtitle", "time": 8527.5, "timestamp": "02:22:07", "text": "low lower."}, {"type": "subtitle", "time": 8530.87, "timestamp": "02:22:10", "text": "[Music]"}, {"type": "subtitle", "time": 8532.95, "timestamp": "02:22:12", "text": "Thank you, mother, for having me. Going"}, {"type": "subtitle", "time": 8535.349, "timestamp": "02:22:15", "text": "to get back. I can feel you're going to"}, {"type": "subtitle", "time": 8538.71, "timestamp": "02:22:18", "text": "get big."}, {"type": "subtitle", "time": 8547.11, "timestamp": "02:22:27", "text": "[Music]"}, {"type": "subtitle", "time": 8550.41, "timestamp": "02:22:30", "text": "Just go underhill. Underhill meaning."}, {"type": "subtitle", "time": 8560.71, "timestamp": "02:22:40", "text": "[Music]"}, {"type": "subtitle", "time": 8562.389, "timestamp": "02:22:42", "text": "You just made me smile for the first"}, {"type": "subtitle", "time": 8565.21, "timestamp": "02:22:45", "text": "time in my life."}]
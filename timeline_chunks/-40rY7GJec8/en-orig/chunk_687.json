[{"type": "subtitle", "time": 41221.03, "timestamp": "11:27:01", "text": "At this point, my battery will die. Keep"}, {"type": "subtitle", "time": 41227.19, "timestamp": "11:27:07", "text": "on dying. How much do I have? One. Ah."}, {"type": "subtitle", "time": 41230.07, "timestamp": "11:27:10", "text": "Money. I need money. Oh, coal. Thank"}, {"type": "subtitle", "time": 41231.906, "timestamp": "11:27:11", "text": "you."}, {"type": "subtitle", "time": 41235.03, "timestamp": "11:27:15", "text": "Where will I get money?"}, {"type": "subtitle", "time": 41236.95, "timestamp": "11:27:16", "text": "Show yourself"}, {"type": "subtitle", "time": 41239.19, "timestamp": "11:27:19", "text": "stones and coals."}, {"type": "subtitle", "time": 41271.68, "timestamp": "11:27:51", "text": "keep going."}, {"type": "subtitle", "time": 41273.03, "timestamp": "11:27:53", "text": "[Music]"}]
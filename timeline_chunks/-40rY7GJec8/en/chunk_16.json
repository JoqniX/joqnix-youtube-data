[{"type": "subtitle", "time": 960.15, "timestamp": "00:16:00", "text": "Someone I know spends 2,000 yen on 100"}, {"type": "subtitle", "time": 961.749, "timestamp": "00:16:01", "text": "grand"}, {"type": "subtitle", "time": 963.35, "timestamp": "00:16:03", "text": "every month. But they already given"}, {"type": "subtitle", "time": 969.11, "timestamp": "00:16:09", "text": "calculated yen and then I see how it is."}, {"type": "subtitle", "time": 971.43, "timestamp": "00:16:11", "text": "What? You going to ask people for more"}, {"type": "subtitle", "time": 974.069, "timestamp": "00:16:14", "text": "give to give you more money? What? O you"}, {"type": "subtitle", "time": 977.749, "timestamp": "00:16:17", "text": "should not do that. Wait, don't do it."}, {"type": "subtitle", "time": 988.71, "timestamp": "00:16:28", "text": "[Music]"}]
[{"type": "subtitle", "time": 16450.949, "timestamp": "04:34:10", "text": "確實如此"}, {"type": "subtitle", "time": 16454.47, "timestamp": "04:34:14", "text": "。"}, {"type": "subtitle", "time": 16467.029, "timestamp": "04:34:27", "text": "這就好比你給一個角色配音，有一天你不能再給這個角色配音了，換了別人來配音。那些了解這個角色、喜歡這個角色的人會覺得"}, {"type": "subtitle", "time": 16489.429, "timestamp": "04:34:49", "text": "沒感覺了，因為他們喜歡的是第一個配音演員，而不是第二個。"}, {"type": "subtitle", "time": 16494.869, "timestamp": "04:34:54", "text": "即使第二位"}, {"type": "subtitle", "time": 16499.269, "timestamp": "04:34:59", "text": "配音員已經盡力了，但感覺還是不一樣了"}]
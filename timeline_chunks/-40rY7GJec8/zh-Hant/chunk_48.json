[{"type": "subtitle", "time": 2880.79, "timestamp": "00:48:00", "text": "我看到有人在搞智障。實際上，她會遇到一些"}, {"type": "subtitle", "time": 2890.15, "timestamp": "00:48:10", "text": "麻煩之類的"}, {"type": "subtitle", "time": 2912.23, "timestamp": "00:48:32", "text": "所以，她就像"}, {"type": "subtitle", "time": 2921.91, "timestamp": "00:48:41", "text": "[音樂]一樣，自從她開始看我的直播後，"}]
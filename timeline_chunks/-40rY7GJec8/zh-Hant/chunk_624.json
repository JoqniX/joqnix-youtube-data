[{"type": "subtitle", "time": 37447.266, "timestamp": "10:24:07", "text": "你用來把米飯盛到盤子裡的橢圓形湯匙。我只能吃一匙。我不知道為什麼"}, {"type": "subtitle", "time": 37473.586, "timestamp": "10:24:33", "text": "我"}, {"type": "subtitle", "time": 37475.99, "timestamp": "10:24:35", "text": "不能，我朋友讓我試試，他說你要改改那個之類的，他還讓我試了三次。我試了三種。  好的。我"}, {"type": "subtitle", "time": 37483.19, "timestamp": "10:24:43", "text": "嘗試了，然後死了。"}, {"type": "subtitle", "time": 37489.35, "timestamp": "10:24:49", "text": "移動。我的肚子好飽。我當時覺得它太大了，就對他說：「"}, {"type": "subtitle", "time": 37491.19, "timestamp": "10:24:51", "text": "莫，"}, {"type": "subtitle", "time": 37494.55, "timestamp": "10:24:54", "text": "你看，我現在有個寶寶了。現在就叫"}]
[{"type": "subtitle", "time": 39421.51, "timestamp": "10:57:01", "text": "我的天啊。好的。  我喜歡他。我喜歡他的主力隊伍。"}, {"type": "subtitle", "time": 39425.19, "timestamp": "10:57:05", "text": "我的天哪。  是的。  入口。呃，入口。呃，給我們參賽名單。  我們"}, {"type": "subtitle", "time": 39433.67, "timestamp": "10:57:13", "text": "會讓你進入"}, {"type": "subtitle", "time": 39437.51, "timestamp": "10:57:17", "text": "網站。就是這樣。我們能贏。  沒有。我"}, {"type": "subtitle", "time": 39439.266, "timestamp": "10:57:19", "text": "回來了。"}, {"type": "subtitle", "time": 39455.426, "timestamp": "10:57:35", "text": "等等。等待。"}, {"type": "subtitle", "time": 39457.586, "timestamp": "10:57:37", "text": "會有人來的。稍等片刻。會有人來的。有人很著急。有人很著急。  嗯哼。  等等，等等，等等，等等，等等，等等。  在哪裡？我們還有時間。"}, {"type": "subtitle", "time": 39460.23, "timestamp": "10:57:40", "text": "我的天啊。  阿曼。死的。"}, {"type": "subtitle", "time": 39471.35, "timestamp": "10:57:51", "text": "好了，我要退後一步"}]
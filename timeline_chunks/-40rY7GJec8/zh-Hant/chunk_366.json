[{"type": "subtitle", "time": 21978.31, "timestamp": "06:06:18", "text": "等待。哦，你真的做到了。請你自我介紹一下。哦，我的名字是……哦，是莫莉。  我的天哪，是莫莉。我的天啊。感謝您的參與"}, {"type": "subtitle", "time": 21986.708, "timestamp": "06:06:26", "text": "。  很高興見到你。我也很高興見到你。  謝謝。"}, {"type": "subtitle", "time": 21999.67, "timestamp": "06:06:39", "text": "總之，我真的很想念"}, {"type": "subtitle", "time": 22001.99, "timestamp": "06:06:41", "text": "很多東西。希望你今天過得愉快。祝你今天過得愉快。晚安"}]
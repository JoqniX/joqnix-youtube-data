[{"type": "subtitle", "time": 42062.07, "timestamp": "11:41:02", "text": "嗯，[音樂] 所以，呃，我想…我應該說別再說「我想」了。所以我"}, {"type": "subtitle", "time": 42064.95, "timestamp": "11:41:04", "text": "想要一些建議。我想聽聽大家對直播內容的建議。我們已經安排了一場原神直播。還有一場創意直播，"}, {"type": "subtitle", "time": 42079.106, "timestamp": "11:41:19", "text": "我已經很久沒做創意直播了"}, {"type": "subtitle", "time": 42104.31, "timestamp": "11:41:44", "text": "，"}, {"type": "subtitle", "time": 42107.106, "timestamp": "11:41:47", "text": "我不知道有沒有跟"}, {"type": "subtitle", "time": 42109.586, "timestamp": "11:41:49", "text": "你們說過，我的駕照過期了，需要"}]
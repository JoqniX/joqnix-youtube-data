[{"type": "subtitle", "time": 7267.03, "timestamp": "02:01:07", "text": "好吧，[音樂] 就像我爸爸在打電話一樣"}, {"type": "subtitle", "time": 7269.03, "timestamp": "02:01:09", "text": "。我的天啊。  [音樂]贊助明年購置"}, {"type": "subtitle", "time": 7278.149, "timestamp": "02:01:18", "text": "房產。  什麼？  晚安，我的寶貝"}, {"type": "subtitle", "time": 7282.31, "timestamp": "02:01:22", "text": "天使們。我會祈禱有一天能見到你"}, {"type": "subtitle", "time": 7308.87, "timestamp": "02:01:48", "text": "哇。  我的天啊。  4秒。在另一個高處。但這只能怪我"}, {"type": "subtitle", "time": 7310.87, "timestamp": "02:01:50", "text": "自己"}, {"type": "subtitle", "time": 7312.79, "timestamp": "02:01:52", "text": "。哦，等等。如果她不小心用自己的主帳號發帖，那就太慘了。"}]
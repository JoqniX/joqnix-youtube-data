[{"type": "subtitle", "time": 9065.99, "timestamp": "02:31:05", "text": "哦，"}, {"type": "subtitle", "time": 9068.469, "timestamp": "02:31:08", "text": "我們不看《"}, {"type": "subtitle", "time": 9070.07, "timestamp": "02:31:10", "text": "好的》。為什麼大家都在說「可以」？嘿，嘿，嘿。  有21人正在觀看。"}, {"type": "subtitle", "time": 9089.75, "timestamp": "02:31:29", "text": "2.1萬人工作"}, {"type": "subtitle", "time": 9092.07, "timestamp": "02:31:32", "text": "。  這些評論很不錯。"}, {"type": "subtitle", "time": 9094.07, "timestamp": "02:31:34", "text": "哇。"}, {"type": "subtitle", "time": 9105.11, "timestamp": "02:31:45", "text": "恭喜。  我再跟你們多介紹一下我自己。哦，就在那兒。我來簡單介紹一下我自己。"}, {"type": "subtitle", "time": 9110.79, "timestamp": "02:31:50", "text": "我希望她不要說太多。  請快點回去。  過來一下。我們的天使，我們最受歡迎的天使。  是"}, {"type": "subtitle", "time": 9112.63, "timestamp": "02:31:52", "text": "的。  他從天而降，拯救網路上的所有人。"}]
[{"type": "subtitle", "time": 37020.39, "timestamp": "10:17:00", "text": "我怎麼可能就這麼停下來呢？"}, {"type": "subtitle", "time": 37030.95, "timestamp": "10:17:10", "text": "所以，這就是問題所在，現在確實很痛苦，但是，呃，還要記住，嗯，"}, {"type": "subtitle", "time": 37039.51, "timestamp": "10:17:19", "text": "我"}, {"type": "subtitle", "time": 37044.55, "timestamp": "10:17:24", "text": "沒有遵循我的工作規律，"}, {"type": "subtitle", "time": 37061.19, "timestamp": "10:17:41", "text": "好吧，還有一件事，因為我經常早起然後開始工作，所以，呃，有些人能做到，有些人做不到。我覺得我已經在為此犧牲自己的"}]
[{"type": "subtitle", "time": 8283.75, "timestamp": "02:18:03", "text": "哇。  [音樂] 我相信你會越來越擅長的。  [音樂] 我"}, {"type": "subtitle", "time": 8294.79, "timestamp": "02:18:14", "text": "感覺你好像…等等，"}, {"type": "subtitle", "time": 8297.19, "timestamp": "02:18:17", "text": "直播有延遲嗎？在我的直播間？  等待。  [音樂] 你們沒有人哦我的天哪，她往那邊去了。那條路。不，那很糟糕。笨蛋。  笨蛋。為什麼這麼"}, {"type": "subtitle", "time": 8317.669, "timestamp": "02:18:37", "text": "你的"}, {"type": "subtitle", "time": 8320.15, "timestamp": "02:18:40", "text": "忠實粉絲。  好吧，她的粉絲確實達到了1000人。  是的。"}]
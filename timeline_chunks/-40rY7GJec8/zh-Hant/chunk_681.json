[{"type": "subtitle", "time": 40889.906, "timestamp": "11:21:29", "text": "。  主意。  嘿，"}, {"type": "subtitle", "time": 40893.51, "timestamp": "11:21:33", "text": "金槍。哦，"}, {"type": "subtitle", "time": 40895.586, "timestamp": "11:21:35", "text": "不。  好的。是的。  哦，米奇，你離成功只差一步之遙了，哦，等等。"}, {"type": "subtitle", "time": 40902.55, "timestamp": "11:21:42", "text": "什麼？不，不，不，不。  哦"}, {"type": "subtitle", "time": 40918.47, "timestamp": "11:21:58", "text": "，我拿到金槍了。那邊是叢林"}]
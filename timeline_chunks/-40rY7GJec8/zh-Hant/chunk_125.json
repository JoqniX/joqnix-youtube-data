[{"type": "subtitle", "time": 7521.35, "timestamp": "02:05:21", "text": "哦我的"}, {"type": "subtitle", "time": 7524.149, "timestamp": "02:05:24", "text": "天哪，我不想讓她變壞，所以我必須小心，哦我的天哪，我的壓力好大。  呃，我"}, {"type": "subtitle", "time": 7535.99, "timestamp": "02:05:35", "text": "醒來的時候，太陽已經下山了。做完自己的事情后，"}, {"type": "subtitle", "time": 7537.669, "timestamp": "02:05:37", "text": "我覺得頭暈"}, {"type": "subtitle", "time": 7558.87, "timestamp": "02:05:58", "text": "不，我當時開的是輛車。  再給我寄一些。  你呢？"}]
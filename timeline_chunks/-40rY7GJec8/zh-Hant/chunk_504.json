[{"type": "subtitle", "time": 30249.67, "timestamp": "08:24:09", "text": "，"}, {"type": "subtitle", "time": 30255.59, "timestamp": "08:24:15", "text": "原來是男的。"}, {"type": "subtitle", "time": 30268.948, "timestamp": "08:24:28", "text": "那是一個"}, {"type": "subtitle", "time": 30273.59, "timestamp": "08:24:33", "text": "男的。好了，你死了。  給我一把槍。非常感謝。  死。"}, {"type": "subtitle", "time": 30288.948, "timestamp": "08:24:48", "text": "我知道。又一個。又一個。  又一個。又一個。哦。  我的天啊。那是什麼？  他媽的。  等等，我卡住了。  我叫太多了。我當時正在嘗試。好了，"}, {"type": "subtitle", "time": 30291.43, "timestamp": "08:24:51", "text": "完成了。"}, {"type": "subtitle", "time": 30295.59, "timestamp": "08:24:55", "text": "啊，我的遊戲。  死的。哦，"}]
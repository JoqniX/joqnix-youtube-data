[{"type": "subtitle", "time": 40933.266, "timestamp": "11:22:13", "text": "未評級。匆忙。是Rush。是Rush。不。"}, {"type": "subtitle", "time": 40936.23, "timestamp": "11:22:16", "text": "哦，是這支"}, {"type": "subtitle", "time": 40943.35, "timestamp": "11:22:23", "text": "隊伍的，兄弟。好的。這是一台Roomia。"}, {"type": "subtitle", "time": 40952.71, "timestamp": "11:22:32", "text": "啊，看來Roomia和Rush都會擁有自己的專屬自我"}]
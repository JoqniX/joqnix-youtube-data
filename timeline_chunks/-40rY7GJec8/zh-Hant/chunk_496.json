[{"type": "subtitle", "time": 29762.868, "timestamp": "08:16:02", "text": "我沒辦法給他"}, {"type": "subtitle", "time": 29812.708, "timestamp": "08:16:52", "text": "等等。不，"}, {"type": "subtitle", "time": 29817.83, "timestamp": "08:16:57", "text": "沒有人換人。  我們一共六個人。為什麼？為什麼不呢？  等等，我是主持人嗎？  只剩一個人了。  我的天啊。  我需要了解其中的瞄準部分。  有點簡陋。  等等，哦，原來有"}]
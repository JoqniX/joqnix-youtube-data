[{"type": "subtitle", "time": 2952.23, "timestamp": "00:49:12", "text": "說我喜歡我那個"}, {"type": "subtitle", "time": 2954.87, "timestamp": "00:49:14", "text": "現實主義者，對吧？  現在還有誰"}, {"type": "subtitle", "time": 2960.23, "timestamp": "00:49:20", "text": "這麼說呢？但你不"}, {"type": "subtitle", "time": 2984.47, "timestamp": "00:49:44", "text": "好奇人們過去做過哪些令人尷尬的事嗎？例如，我可以把我過去的經驗"}, {"type": "subtitle", "time": 2999.03, "timestamp": "00:49:59", "text": "寫成內容之類的東西嗎？哦，是啊，這主意不錯，但是說實話，我不太想做。好吧，這讓我生無可戀，但正是這種痛苦讓我變得更有趣。所以，我想我必須承認，當"}]
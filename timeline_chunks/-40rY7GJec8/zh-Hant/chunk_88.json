[{"type": "subtitle", "time": 5284.229, "timestamp": "01:28:04", "text": "，我贊助了一個大鏈接，寶貝。"}, {"type": "subtitle", "time": 5325.43, "timestamp": "01:28:45", "text": "你，我們喜歡你評測"}, {"type": "subtitle", "time": 5329.03, "timestamp": "01:28:49", "text": "一款新口味可樂，等等等等，然後他們會付我錢，讓我試喝新飲料，為什麼不呢？是啊，為什麼不呢？這是一份工作，我會盡力做到最好"}, {"type": "subtitle", "time": 5335.669, "timestamp": "01:28:55", "text": "。這"}, {"type": "subtitle", "time": 5338.87, "timestamp": "01:28:58", "text": "意味著我需要一個真正的專業主播。哦"}]
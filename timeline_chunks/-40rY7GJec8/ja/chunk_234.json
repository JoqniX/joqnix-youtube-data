[{"type": "subtitle", "time": 14041.75, "timestamp": "03:54:01", "text": "上とか、そういうの全部そう"}, {"type": "subtitle", "time": 14046.389, "timestamp": "03:54:06", "text": "それ。まだ持っていないものがたくさんある"}, {"type": "subtitle", "time": 14049.429, "timestamp": "03:54:09", "text": "体験する。右。"}, {"type": "subtitle", "time": 14052.229, "timestamp": "03:54:12", "text": "でも大丈夫。私はみんなを撫でに来ました。"}, {"type": "subtitle", "time": 14055.75, "timestamp": "03:54:15", "text": "ペットは手に入るよ。誰もが"}, {"type": "subtitle", "time": 14058.469, "timestamp": "03:54:18", "text": "パット。"}, {"type": "subtitle", "time": 14060.95, "timestamp": "03:54:20", "text": "はい。ヘブはスクリーンを"}, {"type": "subtitle", "time": 14063.75, "timestamp": "03:54:23", "text": "たくさんの肝臓とネオチャン。"}, {"type": "subtitle", "time": 14068.79, "timestamp": "03:54:28", "text": "いいえ。"}, {"type": "subtitle", "time": 14070.63, "timestamp": "03:54:30", "text": "ジョック以外の誰かが来てくれたら、"}, {"type": "subtitle", "time": 14072.71, "timestamp": "03:54:32", "text": "ハリー・ポッターが「よくもまあ」と言うのが好きだろう"}, {"type": "subtitle", "time": 14076.07, "timestamp": "03:54:36", "text": "あなたは彼が勉強している場所に立つ"}, {"type": "subtitle", "time": 14078.229, "timestamp": "03:54:38", "text": "1"}, {"type": "subtitle", "time": 14081.269, "timestamp": "03:54:41", "text": "飛行機みたいに？私に飛んでほしいの？"}, {"type": "subtitle", "time": 14083.11, "timestamp": "03:54:43", "text": "フライング。待って、"}, {"type": "subtitle", "time": 14084.55, "timestamp": "03:54:44", "text": "[音楽]"}, {"type": "subtitle", "time": 14099.99, "timestamp": "03:54:59", "text": "何てことだ。"}]
[{"type": "subtitle", "time": 2222.84, "timestamp": "00:37:02", "text": "待って。"}, {"type": "subtitle", "time": 2225.27, "timestamp": "00:37:05", "text": "[音楽]"}, {"type": "subtitle", "time": 2234.15, "timestamp": "00:37:14", "text": "秘密のテキストとは何ですか？"}, {"type": "subtitle", "time": 2238.55, "timestamp": "00:37:18", "text": "ここにある秘密のテキストは何ですか？"}, {"type": "subtitle", "time": 2240.31, "timestamp": "00:37:20", "text": "全部片付けて。何が起こっているのか見てみたい"}, {"type": "subtitle", "time": 2249.78, "timestamp": "00:37:29", "text": "はぁ？"}, {"type": "subtitle", "time": 2260.55, "timestamp": "00:37:40", "text": "何？"}, {"type": "subtitle", "time": 2262.87, "timestamp": "00:37:42", "text": "私は、1つフロップするつもりだと言ったが、"}, {"type": "subtitle", "time": 2265.03, "timestamp": "00:37:45", "text": "有名になりたいし、1億人みたいになりたい、"}, {"type": "subtitle", "time": 2266.79, "timestamp": "00:37:46", "text": "でも実際はほんの少しだけ売るつもり"}, {"type": "subtitle", "time": 2268.4, "timestamp": "00:37:48", "text": "百万。お願いします、"}]
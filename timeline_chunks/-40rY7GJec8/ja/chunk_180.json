[{"type": "subtitle", "time": 10802.07, "timestamp": "03:00:02", "text": "メッセージを読んで"}, {"type": "subtitle", "time": 10804.389, "timestamp": "03:00:04", "text": "小さなストリーマーを見るのが好きです。"}, {"type": "subtitle", "time": 10806.309, "timestamp": "03:00:06", "text": "もっと楽しい交流を。はい、本当です、本当です、"}, {"type": "subtitle", "time": 10810.15, "timestamp": "03:00:10", "text": "確かに、確かに。まあ、でも私の主な計画は"}, {"type": "subtitle", "time": 10812.63, "timestamp": "03:00:12", "text": "目標は正しいだろう。私は保持したい"}, {"type": "subtitle", "time": 10815.59, "timestamp": "03:00:15", "text": "現状のままです。私は"}, {"type": "subtitle", "time": 10817.51, "timestamp": "03:00:17", "text": "毎日、すべての人と交流する"}, {"type": "subtitle", "time": 10820.15, "timestamp": "03:00:20", "text": "メッセージを伝えようとしていますが、"}, {"type": "subtitle", "time": 10823.11, "timestamp": "03:00:23", "text": "ログは役に立つので、後で読み返すことができます"}, {"type": "subtitle", "time": 10825.99, "timestamp": "03:00:25", "text": "それを送信して、何が送られたかを知る"}, {"type": "subtitle", "time": 10828.55, "timestamp": "03:00:28", "text": "翌日に返答する。それが理由です"}, {"type": "subtitle", "time": 10830.79, "timestamp": "03:00:30", "text": "これについて考えてみるのが好きです。もし1つが"}, {"type": "subtitle", "time": 10832.55, "timestamp": "03:00:32", "text": "日"}, {"type": "subtitle", "time": 10835.11, "timestamp": "03:00:35", "text": "もしある日"}, {"type": "subtitle", "time": 10838.23, "timestamp": "03:00:38", "text": "私は大きな立場になる"}, {"type": "subtitle", "time": 10841.67, "timestamp": "03:00:41", "text": "ストリーマーか何かですよね？"}, {"type": "subtitle", "time": 10844.389, "timestamp": "03:00:44", "text": "私はどうすればいいのだろう？私は読めるでしょうか"}, {"type": "subtitle", "time": 10847.91, "timestamp": "03:00:47", "text": "すべてのメッセージを"}, {"type": "subtitle", "time": 10850.469, "timestamp": "03:00:50", "text": "えーと、最近は"}, {"type": "subtitle", "time": 10852.63, "timestamp": "03:00:52", "text": "最近では、終了ストリームは正しいです。"}, {"type": "subtitle", "time": 10854.63, "timestamp": "03:00:54", "text": "みんながやって来て送っている"}, {"type": "subtitle", "time": 10857.269, "timestamp": "03:00:57", "text": "メッセージ いくつかのストリーム"}, {"type": "subtitle", "time": 10859.91, "timestamp": "03:00:59", "text": "それは、それは、それはたくさんかかるだろう、なぜなら私は"}]
[{"type": "subtitle", "time": 1446.789, "timestamp": "00:24:06", "text": "泣いてもこの状況は解決しないよ。"}, {"type": "subtitle", "time": 1448.04, "timestamp": "00:24:08", "text": "わかった。"}, {"type": "subtitle", "time": 1450.71, "timestamp": "00:24:10", "text": "[音楽]"}, {"type": "subtitle", "time": 1454.26, "timestamp": "00:24:14", "text": "ああ、彼女はそうだ。"}, {"type": "subtitle", "time": 1456.789, "timestamp": "00:24:16", "text": "[音楽]"}, {"type": "subtitle", "time": 1459.269, "timestamp": "00:24:19", "text": "夜ですよね？だから、私たちはストリーミング配信します"}, {"type": "subtitle", "time": 1468.9, "timestamp": "00:24:28", "text": "これをやりたいけど、"}, {"type": "subtitle", "time": 1475.029, "timestamp": "00:24:35", "text": "[音楽]"}, {"type": "subtitle", "time": 1479.269, "timestamp": "00:24:39", "text": "私は陰謀論を唱えていました。 Kエンジェルが挑戦する"}, {"type": "subtitle", "time": 1482.39, "timestamp": "00:24:42", "text": "新しいクローン技術を試している。"}, {"type": "subtitle", "time": 1484.549, "timestamp": "00:24:44", "text": "ちょっとした雑談をしたいんです。"}]
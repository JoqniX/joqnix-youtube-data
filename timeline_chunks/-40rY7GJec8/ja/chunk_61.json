[{"type": "subtitle", "time": 3660.15, "timestamp": "01:01:00", "text": "彼女は実際に配信を終了した。何？"}, {"type": "subtitle", "time": 3662.549, "timestamp": "01:01:02", "text": "いや、彼女は気が狂いかけているんだ。ああ、彼女は"}, {"type": "subtitle", "time": 3672.32, "timestamp": "01:01:12", "text": "えっと"}, {"type": "subtitle", "time": 3673.91, "timestamp": "01:01:13", "text": "[音楽]"}, {"type": "subtitle", "time": 3689.27, "timestamp": "01:01:29", "text": "何てことだ。だからこんなことが起きたのです。おお"}, {"type": "subtitle", "time": 3699.589, "timestamp": "01:01:39", "text": "これをもう一度やって、"}, {"type": "subtitle", "time": 3703.51, "timestamp": "01:01:43", "text": "彼女を落ち着かせるとか、何かできることはないの？"}, {"type": "subtitle", "time": 3715.829, "timestamp": "01:01:55", "text": "そして私は、これを容認しません"}]
[{"type": "subtitle", "time": 3429.19, "timestamp": "00:57:09", "text": "元気です。見た目は問題ないけど、約束します"}, {"type": "subtitle", "time": 3431.109, "timestamp": "00:57:11", "text": "何もない。"}, {"type": "subtitle", "time": 3435.99, "timestamp": "00:57:15", "text": "なんてこった。私が感じるもう一つの痛みは"}, {"type": "subtitle", "time": 3439.43, "timestamp": "00:57:19", "text": "でも心の奥底ではそう感じている。なんてこった。"}, {"type": "subtitle", "time": 3441.43, "timestamp": "00:57:21", "text": "なぜ私はこれにあまり共感できないのだろう？私"}, {"type": "subtitle", "time": 3443.91, "timestamp": "00:57:23", "text": "わからない。暗闇は重要な"}, {"type": "subtitle", "time": 3447.109, "timestamp": "00:57:27", "text": "メッセージ。なんてこった。"}, {"type": "subtitle", "time": 3458.079, "timestamp": "00:57:38", "text": "なんてこった。 照明は切り込むために、ああ"}, {"type": "subtitle", "time": 3460.319, "timestamp": "00:57:40", "text": "照明は切り込むために、ああ 神。"}, {"type": "subtitle", "time": 3462.24, "timestamp": "00:57:42", "text": "神。 私たちは夜に行く必要があり、私は"}, {"type": "subtitle", "time": 3464.88, "timestamp": "00:57:44", "text": "私たちは夜に行く必要があり、私は あなた。"}]
[{"type": "subtitle", "time": 10680.87, "timestamp": "02:58:00", "text": "彼女と全てが正しいのですが、私にとっては"}, {"type": "subtitle", "time": 10683.03, "timestamp": "02:58:03", "text": "えーと、ある意味では私はすべてをやっている"}, {"type": "subtitle", "time": 10686.389, "timestamp": "02:58:06", "text": "私自身も、どれくらい長く持ちこたえられるか"}, {"type": "subtitle", "time": 10689.99, "timestamp": "02:58:09", "text": "正しいことをするために？精神的な正気のように"}, {"type": "subtitle", "time": 10693.51, "timestamp": "02:58:13", "text": "バーやメインのときも"}, {"type": "subtitle", "time": 10697.19, "timestamp": "02:58:17", "text": "それは提供するようなものになる"}, {"type": "subtitle", "time": 10700.55, "timestamp": "02:58:20", "text": "えっと、なんて言うんだっけ、"}, {"type": "subtitle", "time": 10703.349, "timestamp": "02:58:23", "text": "彼らが提供しているユーチューバーに"}, {"type": "subtitle", "time": 10705.91, "timestamp": "02:58:25", "text": "えーと、コンテンツとか、進捗状況とかですよね。"}, {"type": "subtitle", "time": 10707.91, "timestamp": "02:58:27", "text": "例えばYouTuberの場合は"}, {"type": "subtitle", "time": 10711.19, "timestamp": "02:58:31", "text": "モデルがデビューを披露するのと同じように"}, {"type": "subtitle", "time": 10714.309, "timestamp": "02:58:34", "text": "デビュー時の通常配信から開始"}, {"type": "subtitle", "time": 10716.95, "timestamp": "02:58:36", "text": "お祝いの配信"}, {"type": "subtitle", "time": 10720.95, "timestamp": "02:58:40", "text": "えーと、ホリデーイベントの配信があって、それから"}, {"type": "subtitle", "time": 10723.269, "timestamp": "02:58:43", "text": "コラボレーションやその他も含め"}, {"type": "subtitle", "time": 10726.07, "timestamp": "02:58:46", "text": "斬新なストリームはイベントベースのようなもの"}, {"type": "subtitle", "time": 10727.91, "timestamp": "02:58:47", "text": "スポンサーシップストリームはすべて、"}, {"type": "subtitle", "time": 10730.23, "timestamp": "02:58:50", "text": "タイムラインのようなもの"}, {"type": "subtitle", "time": 10733.59, "timestamp": "02:58:53", "text": "章立ては、いわば右の流れと言えるでしょう。"}, {"type": "subtitle", "time": 10735.349, "timestamp": "02:58:55", "text": "彼らが手に入れたものはすべて異なる種類のものだった"}, {"type": "subtitle", "time": 10739.19, "timestamp": "02:58:59", "text": "だから私にとっては、たくさんの"}]
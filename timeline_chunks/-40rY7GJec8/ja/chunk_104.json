[{"type": "subtitle", "time": 6247.99, "timestamp": "01:44:07", "text": "私が見るとき"}, {"type": "subtitle", "time": 6251.35, "timestamp": "01:44:11", "text": "今は大丈夫です。わかった、"}, {"type": "subtitle", "time": 6258.47, "timestamp": "01:44:18", "text": "私は自分自身をさらけ出すべきではない、"}, {"type": "subtitle", "time": 6265.83, "timestamp": "01:44:25", "text": "私の顔がどれだけ可愛いかはわかりません"}, {"type": "subtitle", "time": 6269.83, "timestamp": "01:44:29", "text": "次回はそれについて話すので、"}, {"type": "subtitle", "time": 6273.669, "timestamp": "01:44:33", "text": "私を殺さない。主にそこにある。しかし"}, {"type": "subtitle", "time": 6276.229, "timestamp": "01:44:36", "text": "あなたがストリーマーなら、"}, {"type": "subtitle", "time": 6283.51, "timestamp": "01:44:43", "text": "なんてこった。"}, {"type": "subtitle", "time": 6294.79, "timestamp": "01:44:54", "text": "[音楽]"}, {"type": "subtitle", "time": 6296.39, "timestamp": "01:44:56", "text": "そう考えるべきでしょうか？私は"}]
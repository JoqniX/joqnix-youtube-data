[{"type": "subtitle", "time": 14101.99, "timestamp": "03:55:01", "text": "私が偉大になればそれは良いことだ"}, {"type": "subtitle", "time": 14104.309, "timestamp": "03:55:04", "text": "まるで空飛ぶアニメーションみたいに、私は"}, {"type": "subtitle", "time": 14107.75, "timestamp": "03:55:07", "text": "どちらかというと、あの、あの"}, {"type": "subtitle", "time": 14112.389, "timestamp": "03:55:12", "text": "これは私がずっと前に作った、えーと大きなクルーのやつです。"}, {"type": "subtitle", "time": 14114.229, "timestamp": "03:55:14", "text": "えっと、ちょっと待って、これをお見せします。これ"}, {"type": "subtitle", "time": 14116.87, "timestamp": "03:55:16", "text": "実際、すごく可愛い。"}, {"type": "subtitle", "time": 14121.03, "timestamp": "03:55:21", "text": "えっと、ファイル名も「jock jock」にしたんだけど"}, {"type": "subtitle", "time": 14124.79, "timestamp": "03:55:24", "text": "次の天使とか、そんな感じ。うん、これだよ"}, {"type": "subtitle", "time": 14127.75, "timestamp": "03:55:27", "text": "アスリートの天使の秘密。"}, {"type": "subtitle", "time": 14133.189, "timestamp": "03:55:33", "text": "これです。ああ、これは感じ"}, {"type": "subtitle", "time": 14135.91, "timestamp": "03:55:35", "text": "私はこういうタイプで、"}, {"type": "subtitle", "time": 14137.99, "timestamp": "03:55:37", "text": "空間。だから当然、落ちてくる"}, {"type": "subtitle", "time": 14141.51, "timestamp": "03:55:41", "text": "その天使はとっても可愛いだろうね。違う"}, {"type": "subtitle", "time": 14144.87, "timestamp": "03:55:44", "text": "彼女？そうではないですか？"}, {"type": "subtitle", "time": 14147.11, "timestamp": "03:55:47", "text": "何てことだ。"}, {"type": "subtitle", "time": 14149.429, "timestamp": "03:55:49", "text": "表面に粉っぽい感触がある。"}, {"type": "subtitle", "time": 14152.07, "timestamp": "03:55:52", "text": "ええ、それはビッグクルーからのものでした。むしろ"}, {"type": "subtitle", "time": 14154.63, "timestamp": "03:55:54", "text": "ええ、これはビッグ・クルーからのものです。あなたはできる"}, {"type": "subtitle", "time": 14158.469, "timestamp": "03:55:58", "text": "実際にこういうものを作ってみよう。"}]
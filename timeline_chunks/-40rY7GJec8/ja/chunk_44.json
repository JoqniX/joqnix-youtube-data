[{"type": "subtitle", "time": 2640.23, "timestamp": "00:44:00", "text": "私たちは今日、まさにその状況に直面しているのでしょうか？"}, {"type": "subtitle", "time": 2644.32, "timestamp": "00:44:04", "text": "彼はなぜあんなに疲れているように見えるのだろう？"}, {"type": "subtitle", "time": 2648.55, "timestamp": "00:44:08", "text": "[音楽]"}, {"type": "subtitle", "time": 2655.91, "timestamp": "00:44:15", "text": "そのコメントは削除します。助けを求めてください。"}, {"type": "subtitle", "time": 2657.829, "timestamp": "00:44:17", "text": "わかった。"}, {"type": "subtitle", "time": 2664.309, "timestamp": "00:44:24", "text": "ただ存在するだけ"}, {"type": "subtitle", "time": 2667.03, "timestamp": "00:44:27", "text": "それで十分です。"}, {"type": "subtitle", "time": 2669.349, "timestamp": "00:44:29", "text": "私のガールフレンドが私と結婚しました。ここに来るのは"}, {"type": "subtitle", "time": 2674.87, "timestamp": "00:44:34", "text": "何と呼ぶのですか？何をするの？何をするの？"}, {"type": "subtitle", "time": 2677.829, "timestamp": "00:44:37", "text": "失業中ってこと？私は失業者ですか？いいえ。"}, {"type": "subtitle", "time": 2681.109, "timestamp": "00:44:41", "text": "アンジェルは失業中ですか？"}, {"type": "subtitle", "time": 2683.95, "timestamp": "00:44:43", "text": "あなたは私たち誰よりも努力している。"}, {"type": "subtitle", "time": 2689.27, "timestamp": "00:44:49", "text": "[音楽]"}, {"type": "subtitle", "time": 2691.03, "timestamp": "00:44:51", "text": "生きているだけで"}]
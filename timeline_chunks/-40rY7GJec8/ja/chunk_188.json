[{"type": "subtitle", "time": 11282.15, "timestamp": "03:08:02", "text": "考えてみると、私は物事を均等に保つように努めています"}, {"type": "subtitle", "time": 11284.63, "timestamp": "03:08:04", "text": "もし私が特別なことを言うのが好きなら"}, {"type": "subtitle", "time": 11286.71, "timestamp": "03:08:06", "text": "そして、与えることやそれのようなすべてのもの"}, {"type": "subtitle", "time": 11289.19, "timestamp": "03:08:09", "text": "みんなにニックネームをつけようとしています"}, {"type": "subtitle", "time": 11291.429, "timestamp": "03:08:11", "text": "私はまだあなたの"}, {"type": "subtitle", "time": 11295.349, "timestamp": "03:08:15", "text": "物事が平等なので誰も感じない"}, {"type": "subtitle", "time": 11297.269, "timestamp": "03:08:17", "text": "ある日、誰もいない"}, {"type": "subtitle", "time": 11299.349, "timestamp": "03:08:19", "text": "ジョッキーがストリームを見ているように"}, {"type": "subtitle", "time": 11301.59, "timestamp": "03:08:21", "text": "私ではなく、その人にもっと注意を向けてください"}, {"type": "subtitle", "time": 11305.67, "timestamp": "03:08:25", "text": "そこに誰もいない なぜ彼は私を憎むのか いいえ、私は"}, {"type": "subtitle", "time": 11312.55, "timestamp": "03:08:32", "text": "だから私はいつもあなたに会いにここにいるのです"}, {"type": "subtitle", "time": 11313.99, "timestamp": "03:08:33", "text": "その形に到達する。大人になったら"}, {"type": "subtitle", "time": 11315.75, "timestamp": "03:08:35", "text": "次回は、大いなる闇に身を委ねてください"}, {"type": "subtitle", "time": 11317.83, "timestamp": "03:08:37", "text": "築き上げろ、お前の成長を見守ってやる。私は参加しません"}, {"type": "subtitle", "time": 11320.15, "timestamp": "03:08:40", "text": "それ。ナカ、"}, {"type": "subtitle", "time": 11324.23, "timestamp": "03:08:44", "text": "つまり、えっと、ミア、私はこう言ったのを覚えているわ。"}, {"type": "subtitle", "time": 11326.87, "timestamp": "03:08:46", "text": "そして、もう一度言いますよね？人々は"}, {"type": "subtitle", "time": 11328.87, "timestamp": "03:08:48", "text": "家族の中にいるなら、"}, {"type": "subtitle", "time": 11334.07, "timestamp": "03:08:54", "text": "常にその一部である。たとえ、たとえ"}, {"type": "subtitle", "time": 11337.11, "timestamp": "03:08:57", "text": "あなたは家族の一員ではありません"}, {"type": "subtitle", "time": 11339.67, "timestamp": "03:08:59", "text": "もう、私は"}]
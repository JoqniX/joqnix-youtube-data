[{"type": "subtitle", "time": 424.23, "timestamp": "00:07:04", "text": "ああ、なんでクリックしちゃったんだろう？何てことだ。"}, {"type": "subtitle", "time": 427.67, "timestamp": "00:07:07", "text": "しかし、私は実際に起きた事件を発見した。"}, {"type": "subtitle", "time": 430.95, "timestamp": "00:07:10", "text": "彼女は遊び方を知らない。彼女もまた"}, {"type": "subtitle", "time": 436.69, "timestamp": "00:07:16", "text": "あなたは従うべき人物ではないと私は言います"}, {"type": "subtitle", "time": 438.629, "timestamp": "00:07:18", "text": "[音楽]"}, {"type": "subtitle", "time": 448.79, "timestamp": "00:07:28", "text": "233人が視聴しています。わかった。ある意味で"}, {"type": "subtitle", "time": 453.029, "timestamp": "00:07:33", "text": "それは改善の疑問符だ。"}, {"type": "subtitle", "time": 457.029, "timestamp": "00:07:37", "text": "お前らマニアックはこういうのが大好きだろ。"}, {"type": "subtitle", "time": 458.93, "timestamp": "00:07:38", "text": "私は興奮しています。"}, {"type": "subtitle", "time": 474.30899999999997, "timestamp": "00:07:54", "text": "わかった。あなたも陰謀論が好きなの？"}, {"type": "subtitle", "time": 475.83, "timestamp": "00:07:55", "text": "ちょっと共有したいと思ったのですが"}, {"type": "subtitle", "time": 477.67, "timestamp": "00:07:57", "text": "お気に入りの車があちこちに。"}]
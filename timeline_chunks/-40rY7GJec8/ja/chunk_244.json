[{"type": "subtitle", "time": 14641.83, "timestamp": "04:04:01", "text": "スケジュール"}, {"type": "subtitle", "time": 14645.03, "timestamp": "04:04:05", "text": "今週、私を見かけた方もいるかもしれません"}, {"type": "subtitle", "time": 14647.03, "timestamp": "04:04:07", "text": "プレイ中、えっと、それを乗り越えてね"}, {"type": "subtitle", "time": 14650.79, "timestamp": "04:04:10", "text": "配信は6時5分に終了します。"}, {"type": "subtitle", "time": 14653.11, "timestamp": "04:04:13", "text": "ええ、午後6時です。それからまた配信します"}, {"type": "subtitle", "time": 14659.349, "timestamp": "04:04:19", "text": "10:00、10:30、または10時に夜"}, {"type": "subtitle", "time": 14662.309, "timestamp": "04:04:22", "text": "31日目の夜。それではカウントダウンを始めます"}, {"type": "subtitle", "time": 14665.189, "timestamp": "04:04:25", "text": "そんな風に新年を迎える。さらに私たちは"}, {"type": "subtitle", "time": 14668.389, "timestamp": "04:04:28", "text": "執筆では昨年の"}, {"type": "subtitle", "time": 14672.15, "timestamp": "04:04:32", "text": "ツイート。前回の"}, {"type": "subtitle", "time": 14674.309, "timestamp": "04:04:34", "text": "今年のツイート。"}, {"type": "subtitle", "time": 14676.309, "timestamp": "04:04:36", "text": "私たちは新年の抱負を実行しました。私たちは"}, {"type": "subtitle", "time": 14680.95, "timestamp": "04:04:40", "text": "2023年に向けた今年のツイートを書いています"}, {"type": "subtitle", "time": 14682.87, "timestamp": "04:04:42", "text": "そして最後に確認します"}, {"type": "subtitle", "time": 14685.99, "timestamp": "04:04:45", "text": "今年の新しい決意を見て、"}, {"type": "subtitle", "time": 14689.83, "timestamp": "04:04:49", "text": "我々は全てを成功させ、やり遂げることができた。"}, {"type": "subtitle", "time": 14691.67, "timestamp": "04:04:51", "text": "うん、"}, {"type": "subtitle", "time": 14694.389, "timestamp": "04:04:54", "text": "私はすでに普通といくつかの変更"}, {"type": "subtitle", "time": 14698.15, "timestamp": "04:04:58", "text": "麻薬取締法の男。おお、素晴らしいショーでした。さあ行こう"}]
[{"type": "subtitle", "time": 8223.509, "timestamp": "02:17:03", "text": "などなど。私たちの人生は"}, {"type": "subtitle", "time": 8225.03, "timestamp": "02:17:05", "text": "インターネットはとても楽しい"}, {"type": "subtitle", "time": 8228.469, "timestamp": "02:17:08", "text": "何でもありだ。愛している 私は住むのが大好きです"}, {"type": "subtitle", "time": 8230.79, "timestamp": "02:17:10", "text": "21世紀。私たちは皆、少しの"}, {"type": "subtitle", "time": 8232.95, "timestamp": "02:17:12", "text": "私たちの生活における愛と不気味さ。考える"}, {"type": "subtitle", "time": 8234.79, "timestamp": "02:17:14", "text": "次の配信で話します。私"}, {"type": "subtitle", "time": 8237.669, "timestamp": "02:17:17", "text": "皆さんも私と同じくらい楽しんでくれるといいな。"}, {"type": "subtitle", "time": 8239.99, "timestamp": "02:17:19", "text": "まず最初に、"}, {"type": "subtitle", "time": 8244.629, "timestamp": "02:17:24", "text": "私はします。ネット法。"}, {"type": "subtitle", "time": 8253.429, "timestamp": "02:17:33", "text": "アンティアーノという存在はあり得るのだろうか？あなたが思うように"}, {"type": "subtitle", "time": 8256.469, "timestamp": "02:17:36", "text": "それについて言えば、間違いは私たちが犯したものではない"}, {"type": "subtitle", "time": 8259.19, "timestamp": "02:17:39", "text": "愛情度をゼロにする。彼女は聞かないだろう"}, {"type": "subtitle", "time": 8261.03, "timestamp": "02:17:41", "text": "自分。"}, {"type": "subtitle", "time": 8265.19, "timestamp": "02:17:45", "text": "彼女はほとんど私を無視するだろう"}, {"type": "subtitle", "time": 8267.509, "timestamp": "02:17:47", "text": "そして彼女は自分が何をするにしても"}, {"type": "subtitle", "time": 8270.23, "timestamp": "02:17:50", "text": "欲しい。現在ここにいる間、"}, {"type": "subtitle", "time": 8273.91, "timestamp": "02:17:53", "text": "プレイヤーのパンが彼女に何をすべきかを指示し、"}, {"type": "subtitle", "time": 8276.629, "timestamp": "02:17:56", "text": "すべて、ですよね？彼女に与えて、"}]
[{"type": "subtitle", "time": 2285.51, "timestamp": "00:38:05", "text": "ああ、これはえーと"}, {"type": "subtitle", "time": 2288.15, "timestamp": "00:38:08", "text": "チャット。わかった、"}, {"type": "subtitle", "time": 2290.15, "timestamp": "00:38:10", "text": "わからない。やり方がわからない"}, {"type": "subtitle", "time": 2292.71, "timestamp": "00:38:12", "text": "精巧な。その"}, {"type": "subtitle", "time": 2296.069, "timestamp": "00:38:16", "text": "私の彼女は生きている。遅延が見える"}, {"type": "subtitle", "time": 2297.91, "timestamp": "00:38:17", "text": "そこには。実は、"}, {"type": "subtitle", "time": 2303.12, "timestamp": "00:38:23", "text": "彼女は暴徒とかに絡まれるんだ。だから彼女はこう思う"}, {"type": "subtitle", "time": 2315.349, "timestamp": "00:38:35", "text": "私が好きなのは、私の時計を見ることです"}, {"type": "subtitle", "time": 2319.349, "timestamp": "00:38:39", "text": "ストリーム。まるで夢が叶ったようだ。私は好きです"}, {"type": "subtitle", "time": 2321.109, "timestamp": "00:38:41", "text": "これ。始めたことを嬉しく思います"}, {"type": "subtitle", "time": 2323.109, "timestamp": "00:38:43", "text": "ストリーミング配信。"}, {"type": "subtitle", "time": 2330.55, "timestamp": "00:38:50", "text": "私の現実主義者"}, {"type": "subtitle", "time": 2334.15, "timestamp": "00:38:54", "text": "そうだろ？"}, {"type": "subtitle", "time": 2335.91, "timestamp": "00:38:55", "text": "今どきそんなこと言う人いる？でも、あなたは"}, {"type": "subtitle", "time": 2337.349, "timestamp": "00:38:57", "text": "恥ずかしいものについて興味を持ったことはありますか"}, {"type": "subtitle", "time": 2339.99, "timestamp": "00:38:59", "text": "人々は過去にもそうしてきたし、私も"}]
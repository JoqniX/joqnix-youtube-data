[{"type": "subtitle", "time": 11761.429, "timestamp": "03:16:01", "text": "ええ、戻ってきます。ある日、私は"}, {"type": "subtitle", "time": 11765.11, "timestamp": "03:16:05", "text": "に曝露された"}, {"type": "subtitle", "time": 11768.07, "timestamp": "03:16:08", "text": "魔法の貝のイベント。魔法の貝"}, {"type": "subtitle", "time": 11769.91, "timestamp": "03:16:09", "text": "効果、それが私がそう呼んだものです。そしてクレム"}, {"type": "subtitle", "time": 11772.07, "timestamp": "03:16:12", "text": "CJは私にネタバレした視聴者だった"}, {"type": "subtitle", "time": 11776.07, "timestamp": "03:16:16", "text": "日。先日、私はたくさん泣きました。彼彼"}, {"type": "subtitle", "time": 11778.389, "timestamp": "03:16:18", "text": "チャットギフトとギフトを贈った全員"}, {"type": "subtitle", "time": 11779.75, "timestamp": "03:16:19", "text": "チャットに参加している全員にサブスクライブします。彼"}, {"type": "subtitle", "time": 11783.429, "timestamp": "03:16:23", "text": "寄付しました。いや、彼は1000個くらい送ったよ"}, {"type": "subtitle", "time": 11785.83, "timestamp": "03:16:25", "text": "1万ビットくらいかな。それは多いですね"}, {"type": "subtitle", "time": 11787.429, "timestamp": "03:16:27", "text": "ビットの。だからこそ、"}, {"type": "subtitle", "time": 11789.349, "timestamp": "03:16:29", "text": "私がビットバッジを気に入っている理由と"}, {"type": "subtitle", "time": 11791.91, "timestamp": "03:16:31", "text": "Twitchで配信されているもの。"}, {"type": "subtitle", "time": 11794.79, "timestamp": "03:16:34", "text": "でも、ある意味ではわかるよね"}, {"type": "subtitle", "time": 11797.91, "timestamp": "03:16:37", "text": "その夜、私は"}, {"type": "subtitle", "time": 11799.99, "timestamp": "03:16:39", "text": "私は泣いていた、私は考え始めた"}, {"type": "subtitle", "time": 11804.229, "timestamp": "03:16:44", "text": "こんな感じ、こんな感じ、もしも、もしも1つだったら"}, {"type": "subtitle", "time": 11807.429, "timestamp": "03:16:47", "text": "日、えっと、私は、人々が"}, {"type": "subtitle", "time": 11809.349, "timestamp": "03:16:49", "text": "財政的支援を与えるような"}, {"type": "subtitle", "time": 11811.91, "timestamp": "03:16:51", "text": "などなど。"}, {"type": "subtitle", "time": 11814.63, "timestamp": "03:16:54", "text": "もし私がこれらに依存するようになったらどうなるだろうか"}, {"type": "subtitle", "time": 11817.11, "timestamp": "03:16:57", "text": "私のためにお金を使っている人たち？"}]
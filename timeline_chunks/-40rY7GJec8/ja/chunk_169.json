[{"type": "subtitle", "time": 10143.91, "timestamp": "02:49:03", "text": "私は理解しましたし、私が思うことは"}, {"type": "subtitle", "time": 10145.75, "timestamp": "02:49:05", "text": "ストリーミングとコンテンツに関しては"}, {"type": "subtitle", "time": 10148.07, "timestamp": "02:49:08", "text": "創造とかそういうものには、"}, {"type": "subtitle", "time": 10150.87, "timestamp": "02:49:10", "text": "com 競争力"}, {"type": "subtitle", "time": 10153.59, "timestamp": "02:49:13", "text": "うん、ある意味ではすごく競争が激しいよ"}, {"type": "subtitle", "time": 10155.91, "timestamp": "02:49:15", "text": "あなたが、"}, {"type": "subtitle", "time": 10158.469, "timestamp": "02:49:18", "text": "ナンバーワンになりたい、あるいはトップになりたい"}, {"type": "subtitle", "time": 10160.71, "timestamp": "02:49:20", "text": "トップストリーマーとか、たくさんいるよ"}, {"type": "subtitle", "time": 10163.83, "timestamp": "02:49:23", "text": "競争の右はとても難しい"}, {"type": "subtitle", "time": 10166.389, "timestamp": "02:49:26", "text": "このバトルミドルで競い合うことさえできる"}, {"type": "subtitle", "time": 10170.71, "timestamp": "02:49:30", "text": "地面とかそういうもの。だから私は、"}, {"type": "subtitle", "time": 10173.83, "timestamp": "02:49:33", "text": "私を助けてくれた方法だが、"}, {"type": "subtitle", "time": 10177.83, "timestamp": "02:49:37", "text": "本当にそうだけど、またこの件に戻ったんだ"}, {"type": "subtitle", "time": 10180.389, "timestamp": "02:49:40", "text": "私が長い間自分自身に与えてきたアドバイスのヒント"}, {"type": "subtitle", "time": 10183.19, "timestamp": "02:49:43", "text": "以前は数字を気にしないということだった"}, {"type": "subtitle", "time": 10185.67, "timestamp": "02:49:45", "text": "流れに身を任せて"}, {"type": "subtitle", "time": 10189.67, "timestamp": "02:49:49", "text": "楽しんで、楽しんで、そしてただ"}, {"type": "subtitle", "time": 10193.75, "timestamp": "02:49:53", "text": "続けろ。うん。うん。そんな感じ。"}, {"type": "subtitle", "time": 10197.11, "timestamp": "02:49:57", "text": "しかし、時間が経つにつれて、そう、"}]
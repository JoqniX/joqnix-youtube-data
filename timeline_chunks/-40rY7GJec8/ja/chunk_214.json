[{"type": "subtitle", "time": 12841.349, "timestamp": "03:34:01", "text": "乾燥させる。私は、"}, {"type": "subtitle", "time": 12844.79, "timestamp": "03:34:04", "text": "ミュート状態の間、たくさん泣いた。"}, {"type": "subtitle", "time": 12848.87, "timestamp": "03:34:08", "text": "そして私は自分に言い聞かせた、「私は決して泣かない」と。"}, {"type": "subtitle", "time": 12850.95, "timestamp": "03:34:10", "text": "配信で弱点を見せる"}, {"type": "subtitle", "time": 12856.229, "timestamp": "03:34:16", "text": "私自身について。そうですね、"}, {"type": "subtitle", "time": 12858.71, "timestamp": "03:34:18", "text": "ええ、そうですね、ゲームについて話すと、"}, {"type": "subtitle", "time": 12862.07, "timestamp": "03:34:22", "text": "エンジェルのような人を見たことがあるかもしれません"}, {"type": "subtitle", "time": 12864.229, "timestamp": "03:34:24", "text": "本当の反応を引き出し、"}, {"type": "subtitle", "time": 12866.07, "timestamp": "03:34:26", "text": "ゲーム内のすべてが正しい"}, {"type": "subtitle", "time": 12868.71, "timestamp": "03:34:28", "text": "彼女が配信した。まさにその通り。私"}, {"type": "subtitle", "time": 12871.75, "timestamp": "03:34:31", "text": "17回くらい泣きそうになったと思う"}, {"type": "subtitle", "time": 12874.55, "timestamp": "03:34:34", "text": "Twitchで配信中。ありがたいことにWSは"}, {"type": "subtitle", "time": 12878.87, "timestamp": "03:34:38", "text": "存在しない。いくつかあると思います"}, {"type": "subtitle", "time": 12882.229, "timestamp": "03:34:42", "text": "WS がそこにいて、私は泣いています"}, {"type": "subtitle", "time": 12886.389, "timestamp": "03:34:46", "text": "もの。ああ、なんてバカなんだろう。"}, {"type": "subtitle", "time": 12890.44, "timestamp": "03:34:50", "text": "どちらかというと泣いているような感じだけど、でも、えっと"}, {"type": "subtitle", "time": 12891.75, "timestamp": "03:34:51", "text": "[音楽]"}, {"type": "subtitle", "time": 12894.15, "timestamp": "03:34:54", "text": "うーん、泣くというよりは、もっと泣く感じ"}, {"type": "subtitle", "time": 12896.55, "timestamp": "03:34:56", "text": "愚痴をこぼしたり、韻を踏んだりするような感じ。私は思う"}, {"type": "subtitle", "time": 12898.15, "timestamp": "03:34:58", "text": "わからない。"}]
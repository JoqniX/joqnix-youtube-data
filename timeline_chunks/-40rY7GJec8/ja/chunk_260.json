[{"type": "subtitle", "time": 15601.51, "timestamp": "04:20:01", "text": "あなたの喜びはいつもここにあります。あなたに"}, {"type": "subtitle", "time": 15611.59, "timestamp": "04:20:11", "text": "ああ、もうすぐだ。"}, {"type": "subtitle", "time": 15614.32, "timestamp": "04:20:14", "text": "そろそろ配信を終了した方がいいですよね？"}, {"type": "subtitle", "time": 15623.59, "timestamp": "04:20:23", "text": "こんにちは。それでは、皆さん一人ひとりに感謝しましょう。"}, {"type": "subtitle", "time": 15625.33, "timestamp": "04:20:25", "text": "今日訪れた人。"}, {"type": "subtitle", "time": 15628.309, "timestamp": "04:20:28", "text": "[音楽]"}, {"type": "subtitle", "time": 15635.83, "timestamp": "04:20:35", "text": "今日は来てくれてありがとう"}, {"type": "subtitle", "time": 15638.95, "timestamp": "04:20:38", "text": "川にたどり着く。願わくば"}, {"type": "subtitle", "time": 15641.67, "timestamp": "04:20:41", "text": "えっと、9だと思うんだけど"}, {"type": "subtitle", "time": 15645.83, "timestamp": "04:20:45", "text": "または午後10時あなたのために。はい、午後10時24分です。"}, {"type": "subtitle", "time": 15649.03, "timestamp": "04:20:49", "text": "こんにちは。だから、あなたが"}, {"type": "subtitle", "time": 15652.55, "timestamp": "04:20:52", "text": "まだここにいる、そして元気だ"}, {"type": "subtitle", "time": 15655.429, "timestamp": "04:20:55", "text": "今日はここまで。今日はベストを尽くしたことを願っています。"}, {"type": "subtitle", "time": 15657.91, "timestamp": "04:20:57", "text": "来て話してくださってありがとうございます。"}]
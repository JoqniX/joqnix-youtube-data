[{"type": "subtitle", "time": 3729.43, "timestamp": "01:02:09", "text": "だから、急いで。あ、待って。どういう意味"}, {"type": "subtitle", "time": 3742.789, "timestamp": "01:02:22", "text": "DMで特別なメッセージをもらいました。よぉ、スポンサーになった"}, {"type": "subtitle", "time": 3745.51, "timestamp": "01:02:25", "text": "大きなリンクを結んでいるよ、ベイビー。"}, {"type": "subtitle", "time": 3747.51, "timestamp": "01:02:27", "text": "何と書いてあるか見てみましょう。私たちはあなたと同じように"}, {"type": "subtitle", "time": 3749.43, "timestamp": "01:02:29", "text": "ntoのレビューをしてほしい"}, {"type": "subtitle", "time": 3751.19, "timestamp": "01:02:31", "text": "フレーバーコーラ云々と言って"}, {"type": "subtitle", "time": 3753.19, "timestamp": "01:02:33", "text": "彼らはntoの供給で私に支払うだろう"}, {"type": "subtitle", "time": 3761.19, "timestamp": "01:02:41", "text": "新しいドリンクの広告を試してみるのもいいかもね"}, {"type": "subtitle", "time": 3763.19, "timestamp": "01:02:43", "text": "仕事じゃないの？仕事なんだから、ベストを尽くします"}, {"type": "subtitle", "time": 3765.109, "timestamp": "01:02:45", "text": "これは、真のプロのストリーマーを意味します"}, {"type": "subtitle", "time": 3767.99, "timestamp": "01:02:47", "text": "今"}, {"type": "subtitle", "time": 3770.309, "timestamp": "01:02:50", "text": "ああ、大変だ"}, {"type": "subtitle", "time": 3774.87, "timestamp": "01:02:54", "text": "このものがいくつあるのか知りたいです。"}, {"type": "subtitle", "time": 3777.75, "timestamp": "01:02:57", "text": "ピンク、"}]
[{"type": "subtitle", "time": 4260.31, "timestamp": "01:11:00", "text": "硬くなる。大手ストリーマーは実際には"}, {"type": "subtitle", "time": 4262.95, "timestamp": "01:11:02", "text": "スーパーチャットは読むよね？私は不思議に思わない"}, {"type": "subtitle", "time": 4269.43, "timestamp": "01:11:09", "text": "さあ、私がどうやって手に入れるか見てて"}, {"type": "subtitle", "time": 4274.55, "timestamp": "01:11:14", "text": "もちろん、私のヘンションをお見せします"}, {"type": "subtitle", "time": 4275.87, "timestamp": "01:11:15", "text": "建てる。"}, {"type": "subtitle", "time": 4281.36, "timestamp": "01:11:21", "text": "どんな緊張感？"}, {"type": "subtitle", "time": 4284.55, "timestamp": "01:11:24", "text": "[音楽]"}, {"type": "subtitle", "time": 4287.27, "timestamp": "01:11:27", "text": "どの女の子も暇を持て余していた。私は自分の"}, {"type": "subtitle", "time": 4289.27, "timestamp": "01:11:29", "text": "あの昔の女の子になるのが一番"}, {"type": "subtitle", "time": 4291.75, "timestamp": "01:11:31", "text": "まあ、行くよ。あなたを"}, {"type": "subtitle", "time": 4294.55, "timestamp": "01:11:34", "text": "私と一緒に学校に行きましょう。"}, {"type": "subtitle", "time": 4298.95, "timestamp": "01:11:38", "text": "えっと、それで私はゲームセンターに来たんです"}, {"type": "subtitle", "time": 4301.11, "timestamp": "01:11:41", "text": "後ろの方に座る。必ず与える"}, {"type": "subtitle", "time": 4307.79, "timestamp": "01:11:47", "text": "私のハードウェアとお金。"}, {"type": "subtitle", "time": 4311.75, "timestamp": "01:11:51", "text": "[音楽]"}, {"type": "subtitle", "time": 4313.189, "timestamp": "01:11:53", "text": "もう十分だ。逃げられないぞ。"}, {"type": "subtitle", "time": 4316.07, "timestamp": "01:11:56", "text": "ああ、もう。私を無視するのはやめてください。彼女はなぜ"}, {"type": "subtitle", "time": 4318.709, "timestamp": "01:11:58", "text": "私が彼女を無視していると言っているの？でも私はそうじゃない"}]
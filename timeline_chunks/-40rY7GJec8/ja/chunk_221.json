[{"type": "subtitle", "time": 13261.269, "timestamp": "03:41:01", "text": "自分の同意なしに、そして、えーと"}, {"type": "subtitle", "time": 13263.59, "timestamp": "03:41:03", "text": "あなたが資料や"}, {"type": "subtitle", "time": 13267.59, "timestamp": "03:41:07", "text": "好きとか、ほら、好きとか、好きとか"}, {"type": "subtitle", "time": 13270.15, "timestamp": "03:41:10", "text": "例えば、誰かがそんなに深く掘り下げて"}, {"type": "subtitle", "time": 13272.79, "timestamp": "03:41:12", "text": "わかった、それはまずい。"}, {"type": "subtitle", "time": 13274.87, "timestamp": "03:41:14", "text": "しかし、すでにそれを配ってしまった場合は"}, {"type": "subtitle", "time": 13276.95, "timestamp": "03:41:16", "text": "皆さんに見ていただきたいです"}, {"type": "subtitle", "time": 13278.71, "timestamp": "03:41:18", "text": "見た目がそうだったら、"}, {"type": "subtitle", "time": 13282.79, "timestamp": "03:41:22", "text": "あなたですよね？そういう人に対して。"}, {"type": "subtitle", "time": 13286.15, "timestamp": "03:41:26", "text": "それが私の考えです。だから、私たちは"}, {"type": "subtitle", "time": 13290.55, "timestamp": "03:41:30", "text": "80年代のストリーマーでその段階に達した"}, {"type": "subtitle", "time": 13293.75, "timestamp": "03:41:33", "text": "あれ。きっとそうなると思う"}, {"type": "subtitle", "time": 13295.59, "timestamp": "03:41:35", "text": "起こる。開発者たちはきっと"}, {"type": "subtitle", "time": 13297.19, "timestamp": "03:41:37", "text": "持っている"}, {"type": "subtitle", "time": 13299.11, "timestamp": "03:41:39", "text": "やったよ。次のような瞬間があるでしょう"}, {"type": "subtitle", "time": 13301.75, "timestamp": "03:41:41", "text": "ストリーマーがドックを手に入れたのでドクシングは"}, {"type": "subtitle", "time": 13304.07, "timestamp": "03:41:44", "text": "大変なことですよね？もちろん、ビデオ"}, {"type": "subtitle", "time": 13306.71, "timestamp": "03:41:46", "text": "えーと、見せたいゲーム"}, {"type": "subtitle", "time": 13307.99, "timestamp": "03:41:47", "text": "ストリーミングの世界のように、"}, {"type": "subtitle", "time": 13310.389, "timestamp": "03:41:50", "text": "全てが現状のままで、その他諸々。"}, {"type": "subtitle", "time": 13312.07, "timestamp": "03:41:52", "text": "もちろん、追加されるでしょう。私は"}, {"type": "subtitle", "time": 13314.95, "timestamp": "03:41:54", "text": "間違いない。まだ届いていない"}, {"type": "subtitle", "time": 13318.229, "timestamp": "03:41:58", "text": "その段階までですが、私は私は私は私は知っています"}]
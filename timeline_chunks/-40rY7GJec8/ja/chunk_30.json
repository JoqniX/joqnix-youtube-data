[{"type": "subtitle", "time": 1800.23, "timestamp": "00:30:00", "text": "職業71。"}, {"type": "subtitle", "time": 1806.71, "timestamp": "00:30:06", "text": "ねえ、これをして下げるべき？"}, {"type": "subtitle", "time": 1816.31, "timestamp": "00:30:16", "text": "えっと、"}, {"type": "subtitle", "time": 1818.87, "timestamp": "00:30:18", "text": "これらはすべて減少するだけです"}, {"type": "subtitle", "time": 1820.95, "timestamp": "00:30:20", "text": "若干。"}, {"type": "subtitle", "time": 1831.11, "timestamp": "00:30:31", "text": "睡眠時間は40～49分です。"}, {"type": "subtitle", "time": 1833.669, "timestamp": "00:30:33", "text": "明日まで寝ていられるのは"}, {"type": "subtitle", "time": 1839.029, "timestamp": "00:30:39", "text": "ウェイターが落とすようなものよりも少ない。"}, {"type": "subtitle", "time": 1842.92, "timestamp": "00:30:42", "text": "わかった。では、これはどうでしょうか？"}, {"type": "subtitle", "time": 1844.31, "timestamp": "00:30:44", "text": "[音楽]"}, {"type": "subtitle", "time": 1846.63, "timestamp": "00:30:46", "text": "こうすればファッション率を上げられる"}, {"type": "subtitle", "time": 1850.07, "timestamp": "00:30:50", "text": "そうですよね？それで"}, {"type": "subtitle", "time": 1853.58, "timestamp": "00:30:53", "text": "これを試してみたい。"}]
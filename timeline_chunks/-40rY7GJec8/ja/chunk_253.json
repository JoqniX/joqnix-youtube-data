[{"type": "subtitle", "time": 15186.79, "timestamp": "04:13:06", "text": "家族が多いほど幸せになれる。ええ、私は"}, {"type": "subtitle", "time": 15190.87, "timestamp": "04:13:10", "text": "一番大切なことは"}, {"type": "subtitle", "time": 15192.71, "timestamp": "04:13:12", "text": "私が言及した主なことは"}, {"type": "subtitle", "time": 15196.229, "timestamp": "04:13:16", "text": "つまり、私は一つのことに集中しているわけではない"}, {"type": "subtitle", "time": 15198.95, "timestamp": "04:13:18", "text": "単一の国や"}, {"type": "subtitle", "time": 15201.67, "timestamp": "04:13:21", "text": "ある国からの協定のようなもの"}, {"type": "subtitle", "time": 15204.229, "timestamp": "04:13:24", "text": "あるいは、そんな感じ。君になりたいって知ってるでしょ"}, {"type": "subtitle", "time": 15208.07, "timestamp": "04:13:28", "text": "普遍的な知識は、誰からも知られるようになるだろう。"}, {"type": "subtitle", "time": 15210.71, "timestamp": "04:13:30", "text": "文化はどこにでも、誰でも"}, {"type": "subtitle", "time": 15212.79, "timestamp": "04:13:32", "text": "彼らがどこから来たのか、彼らが誰なのか"}, {"type": "subtitle", "time": 15214.79, "timestamp": "04:13:34", "text": "関係ない"}, {"type": "subtitle", "time": 15217.91, "timestamp": "04:13:37", "text": "ただ世間に知られたいだけなんです"}, {"type": "subtitle", "time": 15221.429, "timestamp": "04:13:41", "text": "どういうわけか、もし私が"}, {"type": "subtitle", "time": 15224.149, "timestamp": "04:13:44", "text": "彼らを刺激したり、幸せにしたり、"}, {"type": "subtitle", "time": 15226.63, "timestamp": "04:13:46", "text": "彼らが笑うのは私にとってとても大切なことです"}, {"type": "subtitle", "time": 15229.189, "timestamp": "04:13:49", "text": "私が欲しいのは誰のお金もいらない"}, {"type": "subtitle", "time": 15232.149, "timestamp": "04:13:52", "text": "または、財政的支援ではないもの"}, {"type": "subtitle", "time": 15234.149, "timestamp": "04:13:54", "text": "本当に本当に必要だ。見ることができます"}, {"type": "subtitle", "time": 15236.71, "timestamp": "04:13:56", "text": "これらすべてが無料です。たとえ私が"}, {"type": "subtitle", "time": 15239.67, "timestamp": "04:13:59", "text": "将来のコンサート、"}]
[{"type": "subtitle", "time": 10322.15, "timestamp": "02:52:02", "text": "奇妙な感情が湧き上がってくる"}, {"type": "subtitle", "time": 10324.469, "timestamp": "02:52:04", "text": "嫉妬の感情、"}, {"type": "subtitle", "time": 10326.63, "timestamp": "02:52:06", "text": "競争力"}, {"type": "subtitle", "time": 10329.11, "timestamp": "02:52:09", "text": "などなど。もしそれが誰かだったら"}, {"type": "subtitle", "time": 10331.349, "timestamp": "02:52:11", "text": "あなたが観るのが好きな人であり、また"}, {"type": "subtitle", "time": 10333.67, "timestamp": "02:52:13", "text": "友達ストリーマー、どこにいたの？"}, {"type": "subtitle", "time": 10336.87, "timestamp": "02:52:16", "text": "チャットなどでアクティブに活動している"}, {"type": "subtitle", "time": 10340.87, "timestamp": "02:52:20", "text": "比較し始めると、"}, {"type": "subtitle", "time": 10342.95, "timestamp": "02:52:22", "text": "あなたは自分自身にひどく嫌悪感を抱くでしょう"}, {"type": "subtitle", "time": 10346.63, "timestamp": "02:52:26", "text": "あなたが彼らのところを訪れたくない"}, {"type": "subtitle", "time": 10350.469, "timestamp": "02:52:30", "text": "ストリームとかそういう類のもの"}, {"type": "subtitle", "time": 10352.95, "timestamp": "02:52:32", "text": "そして、あなたの心の中であなたが感じていることは分かっています"}, {"type": "subtitle", "time": 10354.71, "timestamp": "02:52:34", "text": "悪い"}, {"type": "subtitle", "time": 10357.91, "timestamp": "02:52:37", "text": "あなたがあなたの"}, {"type": "subtitle", "time": 10361.67, "timestamp": "02:52:41", "text": "友達が配信するのは、あなたが始めるからです。"}, {"type": "subtitle", "time": 10364.71, "timestamp": "02:52:44", "text": "比較しすぎて、"}, {"type": "subtitle", "time": 10366.71, "timestamp": "02:52:46", "text": "何をするにしても、彼らが何を話すにしても、"}, {"type": "subtitle", "time": 10369.59, "timestamp": "02:52:49", "text": "彼らが話題に出すトピック、どんな会話でも、"}, {"type": "subtitle", "time": 10372.95, "timestamp": "02:52:52", "text": "彼らの配信チャットは、"}, {"type": "subtitle", "time": 10374.309, "timestamp": "02:52:54", "text": "ストリーマー、あなたが比較するものすべて"}, {"type": "subtitle", "time": 10376.87, "timestamp": "02:52:56", "text": "自分のオーディエンスとすべてを比較して"}, {"type": "subtitle", "time": 10379.83, "timestamp": "02:52:59", "text": "すべてはウサギの穴に落ちていく"}]
[{"type": "subtitle", "time": 3124.87, "timestamp": "00:52:04", "text": "ニース。"}, {"type": "subtitle", "time": 3138.47, "timestamp": "00:52:18", "text": "それは正しい。私、K Angelは到達しました"}, {"type": "subtitle", "time": 3144.309, "timestamp": "00:52:24", "text": "これまで以上に輝きを放つでしょう。それで、"}, {"type": "subtitle", "time": 3159.589, "timestamp": "00:52:39", "text": "あなたがもっと大きくなるのが待ち遠しいです。"}, {"type": "subtitle", "time": 3163.589, "timestamp": "00:52:43", "text": "うんうん。ええと、それがどうなっているのか気になります"}, {"type": "subtitle", "time": 3171.43, "timestamp": "00:52:51", "text": "皆さん、チャンネル登録をお願いします。私たちには、"}, {"type": "subtitle", "time": 3175.19, "timestamp": "00:52:55", "text": "大爆発。彼女には爆発してほしい。"}]
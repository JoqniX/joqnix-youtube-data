[{"type": "subtitle", "time": 16020.71, "timestamp": "04:27:00", "text": "次に誰を応援するにしても"}, {"type": "subtitle", "time": 16022.95, "timestamp": "04:27:02", "text": "そして、見て、交流するのが好きです"}, {"type": "subtitle", "time": 16026.07, "timestamp": "04:27:06", "text": "人々、他の人々、他のユーチューバー"}, {"type": "subtitle", "time": 16028.309, "timestamp": "04:27:08", "text": "彼らに与える"}, {"type": "subtitle", "time": 16035.349, "timestamp": "04:27:15", "text": "今日までに。"}, {"type": "subtitle", "time": 16038.149, "timestamp": "04:27:18", "text": "来てくれてありがとう、アレーニア。そして"}, {"type": "subtitle", "time": 16040.79, "timestamp": "04:27:20", "text": "昨日、あなたは参加しました、えっと、"}, {"type": "subtitle", "time": 16045.429, "timestamp": "04:27:25", "text": "私がVCにいたとき、私は"}, {"type": "subtitle", "time": 16047.51, "timestamp": "04:27:27", "text": "滞在して"}, {"type": "subtitle", "time": 16050.389, "timestamp": "04:27:30", "text": "ヴィックとズチはヴァレラントをプレイしていた"}, {"type": "subtitle", "time": 16054.87, "timestamp": "04:27:34", "text": "夜。あなたは参加しました。ええと、では"}, {"type": "subtitle", "time": 16058.149, "timestamp": "04:27:38", "text": "ソーシャルメディアの休止期間は終了しました。"}, {"type": "subtitle", "time": 16061.67, "timestamp": "04:27:41", "text": "Discordに戻ってきました。ありがとう。そして"}, {"type": "subtitle", "time": 16066.95, "timestamp": "04:27:46", "text": "ええ、あなたがそうで嬉しいです"}, {"type": "subtitle", "time": 16070.71, "timestamp": "04:27:50", "text": "それは何と呼ばれますか？努力して"}, {"type": "subtitle", "time": 16073.59, "timestamp": "04:27:53", "text": "Vチューブにまもなく戻ってきます"}]
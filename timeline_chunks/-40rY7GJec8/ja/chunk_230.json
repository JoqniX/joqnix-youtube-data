[{"type": "subtitle", "time": 13802.55, "timestamp": "03:50:02", "text": "誰がスポーツマンで、誰が本当の私で、"}, {"type": "subtitle", "time": 13806.229, "timestamp": "03:50:06", "text": "また、時々、"}, {"type": "subtitle", "time": 13809.11, "timestamp": "03:50:09", "text": "えっと、私の本当の"}, {"type": "subtitle", "time": 13812.07, "timestamp": "03:50:12", "text": "自分とジョエルブは、"}, {"type": "subtitle", "time": 13815.75, "timestamp": "03:50:15", "text": "もっと共有できるような"}, {"type": "subtitle", "time": 13819.269, "timestamp": "03:50:19", "text": "アイデンティティ危機またはマルチのようなもの"}, {"type": "subtitle", "time": 13821.349, "timestamp": "03:50:21", "text": "多重人格は私には"}, {"type": "subtitle", "time": 13825.11, "timestamp": "03:50:25", "text": "分かってるけど、私が言いたいのは"}, {"type": "subtitle", "time": 13829.269, "timestamp": "03:50:29", "text": "ずっと前にTwitterで、えっと、"}, {"type": "subtitle", "time": 13833.269, "timestamp": "03:50:33", "text": "私はジョーに長々と謝罪のツイートをしたか、"}, {"type": "subtitle", "time": 13837.51, "timestamp": "03:50:37", "text": "何か、ある意味で、ある意味で私は"}, {"type": "subtitle", "time": 13840.389, "timestamp": "03:50:40", "text": "感情と格闘している、うん"}, {"type": "subtitle", "time": 13842.87, "timestamp": "03:50:42", "text": "これは、あの頃の話だよ。"}, {"type": "subtitle", "time": 13844.389, "timestamp": "03:50:44", "text": "これは私が"}, {"type": "subtitle", "time": 13846.309, "timestamp": "03:50:46", "text": "人々が"}, {"type": "subtitle", "time": 13849.11, "timestamp": "03:50:49", "text": "私を置いていくとかそういうこと全部"}, {"type": "subtitle", "time": 13851.99, "timestamp": "03:50:51", "text": "家族のような瞬間と"}, {"type": "subtitle", "time": 13854.469, "timestamp": "03:50:54", "text": "そういった状況がすべて起こっている。だから私は"}, {"type": "subtitle", "time": 13857.03, "timestamp": "03:50:57", "text": "止めようとしたり、止めようとしたりしているような感じ"}, {"type": "subtitle", "time": 13858.95, "timestamp": "03:50:58", "text": "ストリーミングして、Jockn を殺したり、"}]
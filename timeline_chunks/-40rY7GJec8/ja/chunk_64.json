[{"type": "subtitle", "time": 3840.23, "timestamp": "01:04:00", "text": "天使と共に"}, {"type": "subtitle", "time": 3847.349, "timestamp": "01:04:07", "text": "明日のために"}, {"type": "subtitle", "time": 3850.39, "timestamp": "01:04:10", "text": "収益化が承認されました。おお、うわー。私たちはしない"}, {"type": "subtitle", "time": 3853.109, "timestamp": "01:04:13", "text": "立ち退きを迫られるのは、彼らが望んでいるのは"}, {"type": "subtitle", "time": 3856.15, "timestamp": "01:04:16", "text": "私たち。ああ、それは良いことだ。"}, {"type": "subtitle", "time": 3857.99, "timestamp": "01:04:17", "text": "そこには。ストリーム配信はしたくない"}, {"type": "subtitle", "time": 3861.029, "timestamp": "01:04:21", "text": "川で。わかった。"}, {"type": "subtitle", "time": 3863.27, "timestamp": "01:04:23", "text": "その2つの錠剤は何ですか？ 1つは"}, {"type": "subtitle", "time": 3865.43, "timestamp": "01:04:25", "text": "寝ている。いいえ、1つは男の子用です"}, {"type": "subtitle", "time": 3873.27, "timestamp": "01:04:33", "text": "[音楽]"}, {"type": "subtitle", "time": 3876.15, "timestamp": "01:04:36", "text": "もっとフォロワーを増やしてお金を稼ぎたい。それはさらに"}, {"type": "subtitle", "time": 3880.15, "timestamp": "01:04:40", "text": "多すぎる。もっとクラウドが必要だ。もっと。"}, {"type": "subtitle", "time": 3883.19, "timestamp": "01:04:43", "text": "なんてこった。"}, {"type": "subtitle", "time": 3892.86, "timestamp": "01:04:52", "text": "彼女は私を赤信号で置き去りにした。"}, {"type": "subtitle", "time": 3898.86, "timestamp": "01:04:58", "text": "私は気にしない。"}]
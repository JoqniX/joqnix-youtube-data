[{"type": "subtitle", "time": 8347.589, "timestamp": "02:19:07", "text": "彼女にそれを試してもらうべきかどうか疑問に思う"}, {"type": "subtitle", "time": 8355.589, "timestamp": "02:19:15", "text": "しかし、これは彼女を"}, {"type": "subtitle", "time": 8357.91, "timestamp": "02:19:17", "text": "ウィッグだと思ったでしょ？それは私たちが"}, {"type": "subtitle", "time": 8362.15, "timestamp": "02:19:22", "text": "彼らは逃げようとしていたのであって、そうしようとしていたわけではない。だから、"}, {"type": "subtitle", "time": 8366.44, "timestamp": "02:19:26", "text": "ある意味、そうなるだろうね。さよなら。"}, {"type": "subtitle", "time": 8373.509, "timestamp": "02:19:33", "text": "[音楽]"}, {"type": "subtitle", "time": 8376.87, "timestamp": "02:19:36", "text": "セーブデータをロードし直すかもしれません。"}, {"type": "subtitle", "time": 8384.549, "timestamp": "02:19:44", "text": "私は今日をある意味でリロードするかもしれない"}, {"type": "subtitle", "time": 8388.34, "timestamp": "02:19:48", "text": "事態が悪化した場合。わからない。"}, {"type": "subtitle", "time": 8395.85, "timestamp": "02:19:55", "text": "でも、一番大切なのは、私たちがここにいるということです"}, {"type": "subtitle", "time": 8397.19, "timestamp": "02:19:57", "text": "[音楽]"}]
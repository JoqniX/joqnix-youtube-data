[{"type": "subtitle", "time": 9185.03, "timestamp": "02:33:05", "text": "断る。"}, {"type": "subtitle", "time": 9188.55, "timestamp": "02:33:08", "text": "待って、大丈夫だよ。それでおしまい。わかった。"}, {"type": "subtitle", "time": 9191.59, "timestamp": "02:33:11", "text": "待って、それって保存されるの？"}, {"type": "subtitle", "time": 9193.91, "timestamp": "02:33:13", "text": "待って、保存されるの？そう思います。"}, {"type": "subtitle", "time": 9196.55, "timestamp": "02:33:16", "text": "うん、次の配信では大丈夫だよ。こんにちは。それで、"}, {"type": "subtitle", "time": 9200.469, "timestamp": "02:33:20", "text": "私はここで締めくくります。"}, {"type": "subtitle", "time": 9202.389, "timestamp": "02:33:22", "text": "待てよ、あれは出口じゃないか。待って、"}, {"type": "subtitle", "time": 9205.59, "timestamp": "02:33:25", "text": "何？えっと、待って、"}, {"type": "subtitle", "time": 9206.79, "timestamp": "02:33:26", "text": "ちょっと待って、もう一度確認させて。待って、待って、"}, {"type": "subtitle", "time": 9208.63, "timestamp": "02:33:28", "text": "待って、待って、待って。念のため確認させてください。"}, {"type": "subtitle", "time": 9213.03, "timestamp": "02:33:33", "text": "そう言うべきかもしれない。ちょっと待ってください。"}, {"type": "subtitle", "time": 9215.67, "timestamp": "02:33:35", "text": "それらをそこに載せてください。ええ、気にしないでください"}, {"type": "subtitle", "time": 9219.75, "timestamp": "02:33:39", "text": "音声メーターがポップアップ表示されます。切り替えさせてください"}, {"type": "subtitle", "time": 9222.71, "timestamp": "02:33:42", "text": "確認するだけです。"}, {"type": "subtitle", "time": 9224.55, "timestamp": "02:33:44", "text": "そうそう。保存されました。保存されました。"}, {"type": "subtitle", "time": 9227.67, "timestamp": "02:33:47", "text": "はい、保存できました。"}, {"type": "subtitle", "time": 9229.51, "timestamp": "02:33:49", "text": "それは良い。それは良い。保存されました。"}, {"type": "subtitle", "time": 9236.15, "timestamp": "02:33:56", "text": "18日目。うん、ちゃんと保存できたよ。こんにちは、"}]
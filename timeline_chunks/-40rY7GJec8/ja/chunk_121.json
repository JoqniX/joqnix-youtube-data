[{"type": "subtitle", "time": 7267.03, "timestamp": "02:01:07", "text": "えっと、"}, {"type": "subtitle", "time": 7269.03, "timestamp": "02:01:09", "text": "私のチャンネルに来てください。ここで待っています"}, {"type": "subtitle", "time": 7272.709, "timestamp": "02:01:12", "text": "あなたの笑顔のために。誰も"}, {"type": "subtitle", "time": 7276.31, "timestamp": "02:01:16", "text": "何もない、誰もいない。"}, {"type": "subtitle", "time": 7278.149, "timestamp": "02:01:18", "text": "私はよく学校をサボった。私は持っていませんでした"}, {"type": "subtitle", "time": 7280.87, "timestamp": "02:01:20", "text": "多くの友人。気にしていたのは"}, {"type": "subtitle", "time": 7282.31, "timestamp": "02:01:22", "text": "老人だけが気にしていたのは"}, {"type": "subtitle", "time": 7285.03, "timestamp": "02:01:25", "text": "私が言いたかったこと。"}, {"type": "subtitle", "time": 7290.47, "timestamp": "02:01:30", "text": "君が弱さを見せてくれる時が大好きだ。なんてこった、"}, {"type": "subtitle", "time": 7292.229, "timestamp": "02:01:32", "text": "それはまずい。それはまずい。決して見せないで"}, {"type": "subtitle", "time": 7294.39, "timestamp": "02:01:34", "text": "あなたの弱点"}, {"type": "subtitle", "time": 7297.99, "timestamp": "02:01:37", "text": "オンラインにおける弱点。人々は"}, {"type": "subtitle", "time": 7300.709, "timestamp": "02:01:40", "text": "貫通して、あなたを破壊するように"}, {"type": "subtitle", "time": 7308.87, "timestamp": "02:01:48", "text": "ああ、自分の言葉に従うべきだろう"}, {"type": "subtitle", "time": 7310.87, "timestamp": "02:01:50", "text": "考慮に入れて、自分のためにやる"}, {"type": "subtitle", "time": 7312.79, "timestamp": "02:01:52", "text": "同じように。"}, {"type": "subtitle", "time": 7315.03, "timestamp": "02:01:55", "text": "えっと、"}, {"type": "subtitle", "time": 7316.709, "timestamp": "02:01:56", "text": "天使が行かなければならないとは知らなかった"}, {"type": "subtitle", "time": 7319.189, "timestamp": "02:01:59", "text": "学校もね。うん。"}]
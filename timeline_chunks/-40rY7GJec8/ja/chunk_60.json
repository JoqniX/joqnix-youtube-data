[{"type": "subtitle", "time": 3600.309, "timestamp": "01:00:00", "text": "えっと、ストリーミングしてもいいですか？ いいえ、これは違います。"}, {"type": "subtitle", "time": 3604.069, "timestamp": "01:00:04", "text": "これは違う。彼女はこういう人だ"}, {"type": "subtitle", "time": 3614.069, "timestamp": "01:00:14", "text": "なんてこった。いいえ。人々はそれを受け取るでしょう"}, {"type": "subtitle", "time": 3615.829, "timestamp": "01:00:15", "text": "異なる方法で。なんてこった。いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。"}, {"type": "subtitle", "time": 3630.15, "timestamp": "01:00:30", "text": "ええと、すべてが対処可能だと感じられると書いてあります"}, {"type": "subtitle", "time": 3632.47, "timestamp": "01:00:32", "text": "もし私が少しだけ飲んだら、もし私が飲みすぎたら。それで"}, {"type": "subtitle", "time": 3634.71, "timestamp": "01:00:34", "text": "待って"}, {"type": "subtitle", "time": 3637.109, "timestamp": "01:00:37", "text": "取る。"}, {"type": "subtitle", "time": 3644.71, "timestamp": "01:00:44", "text": "そうではありません"}, {"type": "subtitle", "time": 3651.43, "timestamp": "01:00:51", "text": "[音楽]"}]
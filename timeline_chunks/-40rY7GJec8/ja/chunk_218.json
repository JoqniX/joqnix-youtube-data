[{"type": "subtitle", "time": 13081.91, "timestamp": "03:38:01", "text": "右？私たちはそれを見たことがないと思います"}, {"type": "subtitle", "time": 13085.349, "timestamp": "03:38:05", "text": "ゲーム配信者の間で起こること"}, {"type": "subtitle", "time": 13088.229, "timestamp": "03:38:08", "text": "もしかしたら、ある場所でそれを見たことがあるかもしれません"}, {"type": "subtitle", "time": 13091.429, "timestamp": "03:38:11", "text": "彼女は誤って自分の"}, {"type": "subtitle", "time": 13093.59, "timestamp": "03:38:13", "text": "メインアカウントでツイートする代わりに"}, {"type": "subtitle", "time": 13096.229, "timestamp": "03:38:16", "text": "彼女のプライベートアカウント、"}, {"type": "subtitle", "time": 13100.389, "timestamp": "03:38:20", "text": "右？うん。うん。うん。そんな感じ。"}, {"type": "subtitle", "time": 13102.63, "timestamp": "03:38:22", "text": "ストリーマーが誤って"}, {"type": "subtitle", "time": 13104.15, "timestamp": "03:38:24", "text": "何か、"}, {"type": "subtitle", "time": 13105.51, "timestamp": "03:38:25", "text": "うっかり何かを漏らしてしまう。もし"}, {"type": "subtitle", "time": 13107.67, "timestamp": "03:38:27", "text": "配信者に夢中な人々、"}, {"type": "subtitle", "time": 13112.63, "timestamp": "03:38:32", "text": "彼らが法律を守るなら、"}, {"type": "subtitle", "time": 13115.59, "timestamp": "03:38:35", "text": "君は掘り続ける、もっと掘り続ける"}, {"type": "subtitle", "time": 13119.19, "timestamp": "03:38:39", "text": "彼らのアイデンティティや物事を正しく見つけるだろう"}, {"type": "subtitle", "time": 13120.79, "timestamp": "03:38:40", "text": "えーと"}, {"type": "subtitle", "time": 13124.55, "timestamp": "03:38:44", "text": "それらを削除して消去するのは苦痛になることがあります"}, {"type": "subtitle", "time": 13127.67, "timestamp": "03:38:47", "text": "痕跡。だからopsac"}, {"type": "subtitle", "time": 13129.99, "timestamp": "03:38:49", "text": "opsacの正式名称を教えて"}, {"type": "subtitle", "time": 13133.19, "timestamp": "03:38:53", "text": "あなたにとってopsacは"}, {"type": "subtitle", "time": 13134.79, "timestamp": "03:38:54", "text": "えーと"}, {"type": "subtitle", "time": 13137.99, "timestamp": "03:38:57", "text": "はい、セキュリティオペレーション"}]
[{"type": "subtitle", "time": 3083.99, "timestamp": "00:51:23", "text": "この件に関するコメントは読んでいません"}, {"type": "subtitle", "time": 3094.02, "timestamp": "00:51:34", "text": "ああ、彼女は自分の部屋を飾り付けたりしてたよ。"}, {"type": "subtitle", "time": 3106.39, "timestamp": "00:51:46", "text": "トップスを脱いでください。ああ、わかってるよ。"}, {"type": "subtitle", "time": 3109.75, "timestamp": "00:51:49", "text": "気味の悪い奴め。"}, {"type": "subtitle", "time": 3113.27, "timestamp": "00:51:53", "text": "君はまるで小さなジェットアイみたいだね。"}, {"type": "subtitle", "time": 3115.99, "timestamp": "00:51:55", "text": "あ、待って。私はなんとなく手に入れた"}, {"type": "subtitle", "time": 3118.71, "timestamp": "00:51:58", "text": "ちょっとジェット機っぽい雰囲気が出てるでしょ？私はしません"}]
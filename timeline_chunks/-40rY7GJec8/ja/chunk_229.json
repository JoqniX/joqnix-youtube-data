[{"type": "subtitle", "time": 13742.229, "timestamp": "03:49:02", "text": "彼らのために、私は決して彼らを"}, {"type": "subtitle", "time": 13744.79, "timestamp": "03:49:04", "text": "彼らをユーチューバーにするつもりはない"}, {"type": "subtitle", "time": 13749.83, "timestamp": "03:49:09", "text": "一瞬。しかし、彼らは私を通して存在するだろう"}, {"type": "subtitle", "time": 13752.63, "timestamp": "03:49:12", "text": "そして私を通して生き、そしてどこに"}, {"type": "subtitle", "time": 13755.189, "timestamp": "03:49:15", "text": "あれって何て言うんだっけ、もう"}, {"type": "subtitle", "time": 13758.07, "timestamp": "03:49:18", "text": "小説や衝撃のような媒体、"}, {"type": "subtitle", "time": 13760.55, "timestamp": "03:49:20", "text": "ミュージックビデオとか、その他何でも、あるいはストリーミング配信とか"}, {"type": "subtitle", "time": 13764.07, "timestamp": "03:49:24", "text": "などなど。彼らは生きているだろうし、"}, {"type": "subtitle", "time": 13768.389, "timestamp": "03:49:28", "text": "何をするか作り続ける"}, {"type": "subtitle", "time": 13770.15, "timestamp": "03:49:30", "text": "あなたはそれを遺産と呼ぶか、物語と呼ぶか"}, {"type": "subtitle", "time": 13773.03, "timestamp": "03:49:33", "text": "オネクシアの、あるいはそれぞれの"}, {"type": "subtitle", "time": 13776.469, "timestamp": "03:49:36", "text": "個々のストーリーを続けて、"}, {"type": "subtitle", "time": 13778.79, "timestamp": "03:49:38", "text": "まさにその通り"}, {"type": "subtitle", "time": 13781.75, "timestamp": "03:49:41", "text": "私がすべきことはただ"}, {"type": "subtitle", "time": 13784.389, "timestamp": "03:49:44", "text": "ブレットが言ったように、ベストを尽くし続けてください"}, {"type": "subtitle", "time": 13788.229, "timestamp": "03:49:48", "text": "巨大な帝国になる、あるいは何か"}, {"type": "subtitle", "time": 13790.87, "timestamp": "03:49:50", "text": "そう、スポーツマン、そんな感じのやつ"}, {"type": "subtitle", "time": 13792.87, "timestamp": "03:49:52", "text": "そのコメントを読み直す必要がある"}, {"type": "subtitle", "time": 13796.63, "timestamp": "03:49:56", "text": "それ。私は最善を尽くさなければならない"}, {"type": "subtitle", "time": 13798.55, "timestamp": "03:49:58", "text": "一人の"}]
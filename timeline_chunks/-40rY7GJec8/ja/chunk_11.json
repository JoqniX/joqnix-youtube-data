[{"type": "subtitle", "time": 661.75, "timestamp": "00:11:01", "text": "永遠に気づかないまま。"}, {"type": "subtitle", "time": 665.43, "timestamp": "00:11:05", "text": "何てことだ。誰かが探そうとしても"}, {"type": "subtitle", "time": 666.79, "timestamp": "00:11:06", "text": "それは、私が"}, {"type": "subtitle", "time": 668.389, "timestamp": "00:11:08", "text": "犯罪。たとえそれが"}, {"type": "subtitle", "time": 670.87, "timestamp": "00:11:10", "text": "裏切り、それがこの世界の現実だ"}, {"type": "subtitle", "time": 673.75, "timestamp": "00:11:13", "text": "作品。何てことだ。"}, {"type": "subtitle", "time": 676.949, "timestamp": "00:11:16", "text": "何？人々はこういうことをする。"}, {"type": "subtitle", "time": 679.91, "timestamp": "00:11:19", "text": "おお。"}, {"type": "subtitle", "time": 683.11, "timestamp": "00:11:23", "text": "彼らは配信ではいい人ぶっているが、"}, {"type": "subtitle", "time": 689.91, "timestamp": "00:11:29", "text": "くそ。"}, {"type": "subtitle", "time": 710.15, "timestamp": "00:11:50", "text": "何をするか？助けて。私にプレイさせてください"}, {"type": "subtitle", "time": 718.63, "timestamp": "00:11:58", "text": "巨大なカメに乗ってみよう。うん。こんにちは"}]
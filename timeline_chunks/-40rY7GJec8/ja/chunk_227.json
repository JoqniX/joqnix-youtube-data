[{"type": "subtitle", "time": 13621.99, "timestamp": "03:47:01", "text": "でも、えーと、本当に申し訳ないのですが"}, {"type": "subtitle", "time": 13633.189, "timestamp": "03:47:13", "text": "私は時々、非常に敏感になる傾向があります。"}, {"type": "subtitle", "time": 13637.51, "timestamp": "03:47:17", "text": "そして、ある意味では、それは"}, {"type": "subtitle", "time": 13639.429, "timestamp": "03:47:19", "text": "なれ"}, {"type": "subtitle", "time": 13641.269, "timestamp": "03:47:21", "text": "脆弱"}, {"type": "subtitle", "time": 13643.67, "timestamp": "03:47:23", "text": "そしてその脆弱性を配信で公開します"}, {"type": "subtitle", "time": 13647.349, "timestamp": "03:47:27", "text": "悪用される可能性がある"}, {"type": "subtitle", "time": 13649.67, "timestamp": "03:47:29", "text": "悪い人や悪い役者によって"}, {"type": "subtitle", "time": 13652.63, "timestamp": "03:47:32", "text": "もの。だから気をつけなきゃいけないんだ。"}, {"type": "subtitle", "time": 13654.95, "timestamp": "03:47:34", "text": "それでも時々維持するのが難しい"}, {"type": "subtitle", "time": 13659.51, "timestamp": "03:47:39", "text": "たとえ文書があっても、それは含まれます。"}, {"type": "subtitle", "time": 13662.79, "timestamp": "03:47:42", "text": "時々、漏れ出てしまうこともあるよね？"}, {"type": "subtitle", "time": 13664.469, "timestamp": "03:47:44", "text": "つまり、あなたが"}, {"type": "subtitle", "time": 13667.59, "timestamp": "03:47:47", "text": "Twitterで活動していて、"}, {"type": "subtitle", "time": 13669.429, "timestamp": "03:47:49", "text": "Twitterでの活動をご覧になったことがあるかもしれません"}, {"type": "subtitle", "time": 13671.59, "timestamp": "03:47:51", "text": "私が行った場所ではたくさんのもの"}, {"type": "subtitle", "time": 13674.15, "timestamp": "03:47:54", "text": "苦労して"}, {"type": "subtitle", "time": 13677.349, "timestamp": "03:47:57", "text": "次はJocknに続いて"}]
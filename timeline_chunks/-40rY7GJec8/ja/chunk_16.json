[{"type": "subtitle", "time": 960.15, "timestamp": "00:16:00", "text": "私の知り合いは100個に2000円を費やしている"}, {"type": "subtitle", "time": 961.749, "timestamp": "00:16:01", "text": "グランド"}, {"type": "subtitle", "time": 963.35, "timestamp": "00:16:03", "text": "毎月。しかし彼らはすでに"}, {"type": "subtitle", "time": 969.11, "timestamp": "00:16:09", "text": "円を計算してから、それがどういうものか確認します。"}, {"type": "subtitle", "time": 971.43, "timestamp": "00:16:11", "text": "何？あなたは人々にもっと求めるつもりですか"}, {"type": "subtitle", "time": 974.069, "timestamp": "00:16:14", "text": "もっとお金をあげるために？何？おお、あなた"}, {"type": "subtitle", "time": 977.749, "timestamp": "00:16:17", "text": "それはすべきではない。待って、やめて。"}, {"type": "subtitle", "time": 988.71, "timestamp": "00:16:28", "text": "[音楽]"}]
[{"type": "subtitle", "time": 1141.51, "timestamp": "00:19:01", "text": "彼女と一緒に"}, {"type": "subtitle", "time": 1144.47, "timestamp": "00:19:04", "text": "彼女の性格を知っているから。おお、"}, {"type": "subtitle", "time": 1148.789, "timestamp": "00:19:08", "text": "ロリータファッションをよく見かけるようになった。わかった。"}, {"type": "subtitle", "time": 1150.47, "timestamp": "00:19:10", "text": "うん。こんにちは、エリー。お元気ですか"}, {"type": "subtitle", "time": 1152.23, "timestamp": "00:19:12", "text": "今日？"}, {"type": "subtitle", "time": 1154.63, "timestamp": "00:19:14", "text": "よぉ、よぉ。"}, {"type": "subtitle", "time": 1172.23, "timestamp": "00:19:32", "text": "あなたは私が好きなように服を着ることを勧めてくれる。"}, {"type": "subtitle", "time": 1174.47, "timestamp": "00:19:34", "text": "二人でロリータを着て出かけようよ。"}, {"type": "subtitle", "time": 1177.83, "timestamp": "00:19:37", "text": "待って、彼女は"}, {"type": "subtitle", "time": 1180.87, "timestamp": "00:19:40", "text": "彼女は他の人が参加することを許すだろうか？"}, {"type": "subtitle", "time": 1187.83, "timestamp": "00:19:47", "text": "別のスーパーチャットでドレスアップハック。おお"}, {"type": "subtitle", "time": 1196.15, "timestamp": "00:19:56", "text": "私"}, {"type": "subtitle", "time": 1199.75, "timestamp": "00:19:59", "text": "確かに、あなたの言う通りです。わかった。"}]
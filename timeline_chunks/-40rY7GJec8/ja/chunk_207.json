[{"type": "subtitle", "time": 12420.07, "timestamp": "03:27:00", "text": "ゲームで見たようなことを考えた"}, {"type": "subtitle", "time": 12422.71, "timestamp": "03:27:02", "text": "あれの、えっと、なんて言うんだっけ？"}, {"type": "subtitle", "time": 12424.309, "timestamp": "03:27:04", "text": "ただのチャットストリームか何かで"}, {"type": "subtitle", "time": 12428.07, "timestamp": "03:27:08", "text": "エンジェルはちゃんと色々なことを話したの？"}, {"type": "subtitle", "time": 12431.03, "timestamp": "03:27:11", "text": "彼女の人生で何が起こったのか、そしてすべて"}, {"type": "subtitle", "time": 12434.309, "timestamp": "03:27:14", "text": "物や人々は「えー」と言っていました"}, {"type": "subtitle", "time": 12437.19, "timestamp": "03:27:17", "text": "コメントは、"}, {"type": "subtitle", "time": 12438.79, "timestamp": "03:27:18", "text": "そんな風に苦しむべきではなかったし"}, {"type": "subtitle", "time": 12441.83, "timestamp": "03:27:21", "text": "すべて順調です、ええ、まさに"}, {"type": "subtitle", "time": 12444.71, "timestamp": "03:27:24", "text": "そんな感じだけど、それを一つの方法として考えてみてください"}, {"type": "subtitle", "time": 12446.63, "timestamp": "03:27:26", "text": "えーっと、みんなこう考えてみて"}, {"type": "subtitle", "time": 12450.63, "timestamp": "03:27:30", "text": "独自の sh 全体のようなものがあります"}, {"type": "subtitle", "time": 12453.349, "timestamp": "03:27:33", "text": "経験"}, {"type": "subtitle", "time": 12456.87, "timestamp": "03:27:36", "text": "悲しいことや後悔といった自分の経験"}, {"type": "subtitle", "time": 12460.389, "timestamp": "03:27:40", "text": "たくさんの物があるようなものですよね？の"}, {"type": "subtitle", "time": 12462.15, "timestamp": "03:27:42", "text": "私たち一人ひとりが多くのことを経験している"}, {"type": "subtitle", "time": 12465.429, "timestamp": "03:27:45", "text": "そういうことですよね？そんな感じ。"}, {"type": "subtitle", "time": 12468.229, "timestamp": "03:27:48", "text": "ああ、もう、支離滅裂なことを言ってる。行けよ、相棒。私"}, {"type": "subtitle", "time": 12471.67, "timestamp": "03:27:51", "text": "私も同じです。何てことだ。わからない。"}, {"type": "subtitle", "time": 12475.349, "timestamp": "03:27:55", "text": "うん、でも、でも、私はよく泣く傾向がある"}, {"type": "subtitle", "time": 12479.429, "timestamp": "03:27:59", "text": "それは、えっと"}]
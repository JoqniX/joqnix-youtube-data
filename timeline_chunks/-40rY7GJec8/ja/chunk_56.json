[{"type": "subtitle", "time": 3361.349, "timestamp": "00:56:01", "text": "おい、俺を切ってくれよ。来て。怖がらないで。"}, {"type": "subtitle", "time": 3363.91, "timestamp": "00:56:03", "text": "待って。いいえ。"}, {"type": "subtitle", "time": 3366.61, "timestamp": "00:56:06", "text": "見せて。"}, {"type": "subtitle", "time": 3369.829, "timestamp": "00:56:09", "text": "[拍手]"}, {"type": "subtitle", "time": 3372.23, "timestamp": "00:56:12", "text": "我が神よ。"}, {"type": "subtitle", "time": 3381.589, "timestamp": "00:56:21", "text": "これはまずい。これはまずい。これが私が"}, {"type": "subtitle", "time": 3384.309, "timestamp": "00:56:24", "text": "配信すべきではなかった。配信すべきではなかった。おお"}, {"type": "subtitle", "time": 3386.49, "timestamp": "00:56:26", "text": "我が神よ。"}, {"type": "subtitle", "time": 3389.03, "timestamp": "00:56:29", "text": "[拍手]"}, {"type": "subtitle", "time": 3392.39, "timestamp": "00:56:32", "text": "私はこれをやりたくない。"}, {"type": "subtitle", "time": 3396.15, "timestamp": "00:56:36", "text": "これをスキップする方法はありますか？何てことだ、"}, {"type": "subtitle", "time": 3399.349, "timestamp": "00:56:39", "text": "貯金しておくべきだった。何てことだ。待って、"}, {"type": "subtitle", "time": 3415.75, "timestamp": "00:56:55", "text": "[拍手]"}, {"type": "subtitle", "time": 3417.19, "timestamp": "00:56:57", "text": "今は最善を尽くしています。あなたは何者ですか"}]
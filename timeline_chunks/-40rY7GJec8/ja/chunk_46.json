[{"type": "subtitle", "time": 2762.55, "timestamp": "00:46:02", "text": "[音楽]"}, {"type": "subtitle", "time": 2775.589, "timestamp": "00:46:15", "text": "この媚びへつらいは、"}, {"type": "subtitle", "time": 2785.67, "timestamp": "00:46:25", "text": "キスをありがとう。ありがとう。ありがとう"}, {"type": "subtitle", "time": 2789.19, "timestamp": "00:46:29", "text": "お母さんのために。"}, {"type": "subtitle", "time": 2793.109, "timestamp": "00:46:33", "text": "これ、やるべきでしょうか？"}, {"type": "subtitle", "time": 2803.27, "timestamp": "00:46:43", "text": "[音楽]"}, {"type": "subtitle", "time": 2805.51, "timestamp": "00:46:45", "text": "愛と愛の両方を送ってくれる男性が好きです"}, {"type": "subtitle", "time": 2813.27, "timestamp": "00:46:53", "text": "おい、見たもの気に入ったか？もしそうなら、"}, {"type": "subtitle", "time": 2816.71, "timestamp": "00:46:56", "text": "明日またプレイする。"}]
[{"type": "subtitle", "time": 607.75, "timestamp": "00:10:07", "text": "おお、"}, {"type": "subtitle", "time": 611.829, "timestamp": "00:10:11", "text": "私は保存食が大好きです。"}, {"type": "subtitle", "time": 613.67, "timestamp": "00:10:13", "text": "良い。さて、もしそうするなら、約束してください"}, {"type": "subtitle", "time": 616.55, "timestamp": "00:10:16", "text": "テレビを手に入れる"}, {"type": "subtitle", "time": 619.99, "timestamp": "00:10:19", "text": "約束して"}, {"type": "subtitle", "time": 621.829, "timestamp": "00:10:21", "text": "いずれは離脱するだろう。もし"}, {"type": "subtitle", "time": 623.829, "timestamp": "00:10:23", "text": "あなた"}, {"type": "subtitle", "time": 626.069, "timestamp": "00:10:26", "text": "もしあなたが"}, {"type": "subtitle", "time": 629.59, "timestamp": "00:10:29", "text": "もし私が誰かに連れ去られたら、慈悲は"}, {"type": "subtitle", "time": 633.91, "timestamp": "00:10:33", "text": "お願いだから殺してくれ。何を言っている？"}, {"type": "subtitle", "time": 636.23, "timestamp": "00:10:36", "text": "すみません。"}, {"type": "subtitle", "time": 638.31, "timestamp": "00:10:38", "text": "投げ捨てられるものが1つあります"}, {"type": "subtitle", "time": 641.59, "timestamp": "00:10:41", "text": "ナイフに関してはまさにその通り。しかし私にとっては事実"}, {"type": "subtitle", "time": 643.67, "timestamp": "00:10:43", "text": "あなたは私のファンです。決してあなたを騙したり、裏切ったりしない"}, {"type": "subtitle", "time": 646.15, "timestamp": "00:10:46", "text": "背中をあなたに預ける。本当にそうすべきですか？"}, {"type": "subtitle", "time": 649.59, "timestamp": "00:10:49", "text": "これは言っているのですか？エンジェル・チャマ。"}, {"type": "subtitle", "time": 652.71, "timestamp": "00:10:52", "text": "何てことだ。私は自分の"}, {"type": "subtitle", "time": 655.75, "timestamp": "00:10:55", "text": "専用ドア。ラウも同様だ。いいえ"}, {"type": "subtitle", "time": 659.35, "timestamp": "00:10:59", "text": "それを見つけた人は、至福の時を過ごすことができます"}]
[{"type": "subtitle", "time": 13560.95, "timestamp": "03:46:00", "text": "長いメッセージを送信します。その"}, {"type": "subtitle", "time": 13563.269, "timestamp": "03:46:03", "text": "大丈夫。大丈夫です。ビリーだったら"}, {"type": "subtitle", "time": 13565.83, "timestamp": "03:46:05", "text": "ビリーとかいう名前で、"}, {"type": "subtitle", "time": 13568.389, "timestamp": "03:46:08", "text": "文字数制限は20です。"}, {"type": "subtitle", "time": 13570.63, "timestamp": "03:46:10", "text": "実際の英語の単語を入力できません"}, {"type": "subtitle", "time": 13573.03, "timestamp": "03:46:13", "text": "そこには。つまり、痛みってことですよね？そんな感じ。"}, {"type": "subtitle", "time": 13574.71, "timestamp": "03:46:14", "text": "大丈夫です。大丈夫です。心配しないでください"}, {"type": "subtitle", "time": 13577.349, "timestamp": "03:46:17", "text": "それ。"}, {"type": "subtitle", "time": 13579.91, "timestamp": "03:46:19", "text": "うん、君もそうなり得るよ。どちらが"}, {"type": "subtitle", "time": 13583.51, "timestamp": "03:46:23", "text": "あなたは？わからない。"}, {"type": "subtitle", "time": 13586.55, "timestamp": "03:46:26", "text": "選択肢が多すぎる。"}, {"type": "subtitle", "time": 13589.03, "timestamp": "03:46:29", "text": "何ができないのか なぜ私はできないのか ええと、すべて"}, {"type": "subtitle", "time": 13591.67, "timestamp": "03:46:31", "text": "彼らのうちの？私は疑問に思う。わからない。うん。"}, {"type": "subtitle", "time": 13594.07, "timestamp": "03:46:34", "text": "なぜ私は彼ら全員になれないのだろう？質問"}, {"type": "subtitle", "time": 13604.79, "timestamp": "03:46:44", "text": "でも、私は他に何か読んだっけ？"}, {"type": "subtitle", "time": 13612.71, "timestamp": "03:46:52", "text": "さあ、相棒、もっと入力してバカどもをオン"}, {"type": "subtitle", "time": 13619.59, "timestamp": "03:46:59", "text": "何てことだ。"}]
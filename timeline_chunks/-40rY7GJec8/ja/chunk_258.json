[{"type": "subtitle", "time": 15482.389, "timestamp": "04:18:02", "text": "マウスチャマとディープチャマは、"}, {"type": "subtitle", "time": 15485.11, "timestamp": "04:18:05", "text": "チャマは壊れたような感じで、そうじゃない"}, {"type": "subtitle", "time": 15487.59, "timestamp": "04:18:07", "text": "まるで彼らがやっていることのように"}, {"type": "subtitle", "time": 15491.429, "timestamp": "04:18:11", "text": "彼らの最高傑作。もしもちゃまやエビキみたいに"}, {"type": "subtitle", "time": 15494.389, "timestamp": "04:18:14", "text": "彼らも最善を尽くしているんですよね？しかし"}, {"type": "subtitle", "time": 15497.51, "timestamp": "04:18:17", "text": "ええ、もし知らなかったら、私は"}, {"type": "subtitle", "time": 15500.71, "timestamp": "04:18:20", "text": "私の持ち物すべてに名前を付けて、撫でます"}, {"type": "subtitle", "time": 15503.269, "timestamp": "04:18:23", "text": "彼らにキスをしておやすみを言って、眠らせてください。"}, {"type": "subtitle", "time": 15506.389, "timestamp": "04:18:26", "text": "だから、私がそうするからといって、変だと思わないでください。"}, {"type": "subtitle", "time": 15519.67, "timestamp": "04:18:39", "text": "うん。それで"}, {"type": "subtitle", "time": 15521.67, "timestamp": "04:18:41", "text": "でも、あんなこと言うべきじゃなかった。つまり私は"}, {"type": "subtitle", "time": 15529.6, "timestamp": "04:18:49", "text": "私はただ"}, {"type": "subtitle", "time": 15531.67, "timestamp": "04:18:51", "text": "[音楽]"}, {"type": "subtitle", "time": 15534.149, "timestamp": "04:18:54", "text": "でも、そう、でも、確認しないといけない"}, {"type": "subtitle", "time": 15537.349, "timestamp": "04:18:57", "text": "これらのどれも私の中で死なないし、好きでもない"}]
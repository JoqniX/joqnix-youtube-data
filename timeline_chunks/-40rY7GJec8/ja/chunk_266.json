[{"type": "subtitle", "time": 15961.03, "timestamp": "04:26:01", "text": "レンダリングするビデオがあって、"}, {"type": "subtitle", "time": 15963.67, "timestamp": "04:26:03", "text": "そういったもの全てとゲーム。たくさんのゲーム"}, {"type": "subtitle", "time": 15966.07, "timestamp": "04:26:06", "text": "私はたくさんのゲームが必要で"}, {"type": "subtitle", "time": 15968.87, "timestamp": "04:26:08", "text": "YouTubeでシリーズ全編を視聴できます。そうですね、1つ目"}, {"type": "subtitle", "time": 15970.87, "timestamp": "04:26:10", "text": "アークに戻って、"}, {"type": "subtitle", "time": 15972.87, "timestamp": "04:26:12", "text": "サーバーで適切にプレイするか、"}, {"type": "subtitle", "time": 15975.59, "timestamp": "04:26:15", "text": "ローカル保存の代わりに何か別のものを使用する。つまり"}, {"type": "subtitle", "time": 15977.75, "timestamp": "04:26:17", "text": "ローカル保存には満足しています。だから私は持っている"}, {"type": "subtitle", "time": 15980.63, "timestamp": "04:26:20", "text": "私がアーク用に作ったローカルセーブ"}, {"type": "subtitle", "time": 15983.83, "timestamp": "04:26:23", "text": "YouTubeで公開したサバイバル進化シリーズ"}, {"type": "subtitle", "time": 15985.99, "timestamp": "04:26:25", "text": "おそらく、その３つか４つの流れでしょう。"}, {"type": "subtitle", "time": 15987.67, "timestamp": "04:26:27", "text": "うん。うん。うん。私はまだ持っています"}, {"type": "subtitle", "time": 15990.229, "timestamp": "04:26:30", "text": "地元の人々。バックアップは必ず取っておきました"}, {"type": "subtitle", "time": 15992.71, "timestamp": "04:26:32", "text": "ゲームをインストールする前に。うん、1つ"}, {"type": "subtitle", "time": 15995.429, "timestamp": "04:26:35", "text": "その日は配信する予定です。"}, {"type": "subtitle", "time": 15998.309, "timestamp": "04:26:38", "text": "わかった、でも来るのはまだ先だよ。希望"}, {"type": "subtitle", "time": 15999.99, "timestamp": "04:26:39", "text": "今日は楽しかったですね。頑張ってください"}, {"type": "subtitle", "time": 16004.309, "timestamp": "04:26:44", "text": "これからの一日。そして今日エドワードがやって来た"}, {"type": "subtitle", "time": 16009.189, "timestamp": "04:26:49", "text": "本日はお越しいただきありがとうございます。楽しんでいただけたなら幸いです。"}, {"type": "subtitle", "time": 16014.07, "timestamp": "04:26:54", "text": "いつも通り来てくれて、本当に嬉しいです。"}, {"type": "subtitle", "time": 16017.91, "timestamp": "04:26:57", "text": "今日楽しんでください、または"}]
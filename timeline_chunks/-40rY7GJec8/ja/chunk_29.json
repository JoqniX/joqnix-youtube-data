[{"type": "subtitle", "time": 1745.51, "timestamp": "00:29:05", "text": "彼女は泣いたの？"}, {"type": "subtitle", "time": 1748.18, "timestamp": "00:29:08", "text": "いいえ。そうです。"}, {"type": "subtitle", "time": 1759.19, "timestamp": "00:29:19", "text": "バカ"}, {"type": "subtitle", "time": 1761.06, "timestamp": "00:29:21", "text": "寝る。"}, {"type": "subtitle", "time": 1765.59, "timestamp": "00:29:25", "text": "[音楽]"}, {"type": "subtitle", "time": 1768.71, "timestamp": "00:29:28", "text": "彼女にあげるべきでしょうか？よし、彼女を見せてあげよう"}, {"type": "subtitle", "time": 1771.35, "timestamp": "00:29:31", "text": "愛情とストレス。彼女のストレスはすべて"}, {"type": "subtitle", "time": 1774.07, "timestamp": "00:29:34", "text": "あちこちに散らばっている。"}, {"type": "subtitle", "time": 1782.07, "timestamp": "00:29:42", "text": "[音楽]"}, {"type": "subtitle", "time": 1785.83, "timestamp": "00:29:45", "text": "どうにか。それを下げなければならない。"}, {"type": "subtitle", "time": 1790.23, "timestamp": "00:29:50", "text": "これは何ですか？ハッシュタグ ハッシュタグ ハッシュタグ 愛"}, {"type": "subtitle", "time": 1793.029, "timestamp": "00:29:53", "text": "空気中に漂っている。"}, {"type": "subtitle", "time": 1796.63, "timestamp": "00:29:56", "text": "これは何ですか？ストレス46。"}]
[{"type": "subtitle", "time": 1201.669, "timestamp": "00:20:01", "text": "何してるの？私たちはどう思いますか？"}, {"type": "subtitle", "time": 1205.11, "timestamp": "00:20:05", "text": "何をしているのですか？ネイティブストリームを再生しています"}, {"type": "subtitle", "time": 1207.75, "timestamp": "00:20:07", "text": "支配者"}, {"type": "subtitle", "time": 1210.63, "timestamp": "00:20:10", "text": "そして現在、K Angelは"}, {"type": "subtitle", "time": 1215.35, "timestamp": "00:20:15", "text": "ロリーゴシックロリータドレスと"}, {"type": "subtitle", "time": 1217.029, "timestamp": "00:20:17", "text": "彼女は新しいフォロワーと新しい"}, {"type": "subtitle", "time": 1218.71, "timestamp": "00:20:18", "text": "シム"}, {"type": "subtitle", "time": 1224.95, "timestamp": "00:20:24", "text": "後でツイートするために写真をアップロードします。"}, {"type": "subtitle", "time": 1227.51, "timestamp": "00:20:27", "text": "君たちは私に100をくれるべきだ。それは"}, {"type": "subtitle", "time": 1231.909, "timestamp": "00:20:31", "text": "ゼロのいいねがたくさんある。わかった。"}, {"type": "subtitle", "time": 1234.07, "timestamp": "00:20:34", "text": "アンジュとあなたたち全員も、それに従ってください。いいえ、"}, {"type": "subtitle", "time": 1237.83, "timestamp": "00:20:37", "text": "私はロリータに埋葬されるだろう。おお"}, {"type": "subtitle", "time": 1240.149, "timestamp": "00:20:40", "text": "ああ、彼女は実際かわいいですね"}, {"type": "subtitle", "time": 1243.19, "timestamp": "00:20:43", "text": "ロリータドレス。"}, {"type": "subtitle", "time": 1253.51, "timestamp": "00:20:53", "text": "15歳、もしかしたら30歳まで続けると思う。"}]
[{"type": "subtitle", "time": 1084.23, "timestamp": "00:18:04", "text": "[音楽]"}, {"type": "subtitle", "time": 1086.15, "timestamp": "00:18:06", "text": "みなさん、こんにちは。K Angelです。皆さんの大好きなK Angelです。"}, {"type": "subtitle", "time": 1091.27, "timestamp": "00:18:11", "text": "ゴールキーパー。私の美しさのためのゴシックエンジェル。よお、"}, {"type": "subtitle", "time": 1106.23, "timestamp": "00:18:26", "text": "服を買ってから"}, {"type": "subtitle", "time": 1108.549, "timestamp": "00:18:28", "text": "買う"}, {"type": "subtitle", "time": 1110.789, "timestamp": "00:18:30", "text": "そして彼らも。"}, {"type": "subtitle", "time": 1114.31, "timestamp": "00:18:34", "text": "私も行きたい。"}, {"type": "subtitle", "time": 1117.43, "timestamp": "00:18:37", "text": "ああ、もし僕が社交的な人間だったら、どうなっていたんだろう？私"}, {"type": "subtitle", "time": 1119.35, "timestamp": "00:18:39", "text": "たくさんのものを買って、"}, {"type": "subtitle", "time": 1121.59, "timestamp": "00:18:41", "text": "配信用の何か。"}, {"type": "subtitle", "time": 1124.63, "timestamp": "00:18:44", "text": "引きこもりの内向的な人間は最悪だ"}, {"type": "subtitle", "time": 1132.07, "timestamp": "00:18:52", "text": "[音楽]"}, {"type": "subtitle", "time": 1134.71, "timestamp": "00:18:54", "text": "じゃあ、私とデートしてくれるの？"}, {"type": "subtitle", "time": 1137.19, "timestamp": "00:18:57", "text": "疑問符。他の誰か。何てことだ。"}, {"type": "subtitle", "time": 1139.669, "timestamp": "00:18:59", "text": "いいえ。あなたは彼女と一緒に行くことは決してできません。"}]
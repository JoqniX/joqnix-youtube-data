[{"type": "subtitle", "time": 10385.03, "timestamp": "02:53:05", "text": "あらゆるものが下り坂を転がり落ちるように落ち込んでいく。"}, {"type": "subtitle", "time": 10386.63, "timestamp": "02:53:06", "text": "うん。うん。うん。"}, {"type": "subtitle", "time": 10389.75, "timestamp": "02:53:09", "text": "さて、私はこの数ヶ月間"}, {"type": "subtitle", "time": 10392.469, "timestamp": "02:53:12", "text": "何度か、そして私は本当にこれに気づきました"}, {"type": "subtitle", "time": 10394.23, "timestamp": "02:53:14", "text": "私はこう言った人だったが"}, {"type": "subtitle", "time": 10395.75, "timestamp": "02:53:15", "text": "みんな"}, {"type": "subtitle", "time": 10398.07, "timestamp": "02:53:18", "text": "私が知っている人は気にしない"}, {"type": "subtitle", "time": 10399.75, "timestamp": "02:53:19", "text": "数字。数字が重要であることは分かっています"}, {"type": "subtitle", "time": 10402.95, "timestamp": "02:53:22", "text": "しかし、もしあなたが数字を気にするなら"}, {"type": "subtitle", "time": 10405.75, "timestamp": "02:53:25", "text": "少しだけ、いや、少なくとも少しだけ"}, {"type": "subtitle", "time": 10408.95, "timestamp": "02:53:28", "text": "しかしその後、ウサギの穴に落ちて"}, {"type": "subtitle", "time": 10413.03, "timestamp": "02:53:33", "text": "下り坂で、気にしすぎる。あなたはするであろう"}, {"type": "subtitle", "time": 10416.469, "timestamp": "02:53:36", "text": "精神的に楽な状態ではない。"}, {"type": "subtitle", "time": 10419.75, "timestamp": "02:53:39", "text": "あなたはさらに崩壊し、"}, {"type": "subtitle", "time": 10423.03, "timestamp": "02:53:43", "text": "ますます、あなたがどれほどひどいかを見ています"}, {"type": "subtitle", "time": 10426.07, "timestamp": "02:53:46", "text": "やることすべて。しかしまた"}, {"type": "subtitle", "time": 10428.71, "timestamp": "02:53:48", "text": "ある意味で"}, {"type": "subtitle", "time": 10431.67, "timestamp": "02:53:51", "text": "でも、ある意味では、たとえ"}, {"type": "subtitle", "time": 10434.79, "timestamp": "02:53:54", "text": "あなたは始めたばかりで、"}, {"type": "subtitle", "time": 10437.59, "timestamp": "02:53:57", "text": "向上しようと努力したり、その気持ちを抱いたりして"}]
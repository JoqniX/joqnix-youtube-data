[{"type": "subtitle", "time": 720.47, "timestamp": "00:12:00", "text": "エドワードの息子。今日の調子はどうですか？私"}, {"type": "subtitle", "time": 723.11, "timestamp": "00:12:03", "text": "お元気でお過ごしでしょうか。私の"}, {"type": "subtitle", "time": 727.67, "timestamp": "00:12:07", "text": "チャットからライブチャットへ。ここに来て。"}, {"type": "subtitle", "time": 729.509, "timestamp": "00:12:09", "text": "ええ、彼女はただ彼らを見下ろしているだけです。"}, {"type": "subtitle", "time": 739.35, "timestamp": "00:12:19", "text": "よし、行こう。"}, {"type": "subtitle", "time": 746.389, "timestamp": "00:12:26", "text": "巨大なカメを買いに行こう。彼女は"}, {"type": "subtitle", "time": 759.75, "timestamp": "00:12:39", "text": "おお。"}, {"type": "subtitle", "time": 761.829, "timestamp": "00:12:41", "text": "くそ。私にできることは"}, {"type": "subtitle", "time": 765.81, "timestamp": "00:12:45", "text": "巨大なやつを買いに行こう。"}, {"type": "subtitle", "time": 768.87, "timestamp": "00:12:48", "text": "[音楽]"}, {"type": "subtitle", "time": 771.99, "timestamp": "00:12:51", "text": "愛してます。"}, {"type": "subtitle", "time": 774.23, "timestamp": "00:12:54", "text": "彼女がそれを逆の意味で受け取らないことを願います"}]
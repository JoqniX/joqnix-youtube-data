[{"type": "subtitle", "time": 6120.07, "timestamp": "01:42:00", "text": "[音楽]"}, {"type": "subtitle", "time": 6127.109, "timestamp": "01:42:07", "text": "ええと、わかりました。"}, {"type": "subtitle", "time": 6130.29, "timestamp": "01:42:10", "text": "じゃあ、一緒に寄り添おうか？"}, {"type": "subtitle", "time": 6157.109, "timestamp": "01:42:37", "text": "62"}, {"type": "subtitle", "time": 6159.189, "timestamp": "01:42:39", "text": "よし、じゃあ夜まで寝よう。彼女"}, {"type": "subtitle", "time": 6161.55, "timestamp": "01:42:41", "text": "眠りたかったんだよね？"}, {"type": "subtitle", "time": 6163.43, "timestamp": "01:42:43", "text": "[音楽]"}, {"type": "subtitle", "time": 6173.36, "timestamp": "01:42:53", "text": "私たちは配信しています。"}, {"type": "subtitle", "time": 6175.91, "timestamp": "01:42:55", "text": "[音楽]"}, {"type": "subtitle", "time": 6179.27, "timestamp": "01:42:59", "text": "これらすべてが、このことを増加させるでしょう。"}]
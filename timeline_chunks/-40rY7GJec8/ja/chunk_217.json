[{"type": "subtitle", "time": 13022.469, "timestamp": "03:37:02", "text": "それもまた同じようなものですね。たとえあなたが"}, {"type": "subtitle", "time": 13024.389, "timestamp": "03:37:04", "text": "それって何？ VTuberのような"}, {"type": "subtitle", "time": 13027.11, "timestamp": "03:37:07", "text": "匿名性は重要だ。それは"}, {"type": "subtitle", "time": 13028.63, "timestamp": "03:37:08", "text": "何"}, {"type": "subtitle", "time": 13032.55, "timestamp": "03:37:12", "text": "私は、"}, {"type": "subtitle", "time": 13035.349, "timestamp": "03:37:15", "text": "私がジャーナリストだった頃のBB"}, {"type": "subtitle", "time": 13038.15, "timestamp": "03:37:18", "text": "記事のためにインタビューを受けた"}, {"type": "subtitle", "time": 13041.03, "timestamp": "03:37:21", "text": "そう、私は自分の"}, {"type": "subtitle", "time": 13043.59, "timestamp": "03:37:23", "text": "彼女に名前や物を伝えても、彼女は"}, {"type": "subtitle", "time": 13047.03, "timestamp": "03:37:27", "text": "彼らが気に入らなかったのは良かったと思います"}, {"type": "subtitle", "time": 13049.83, "timestamp": "03:37:29", "text": "記事に載せるけど、それでも"}, {"type": "subtitle", "time": 13052.229, "timestamp": "03:37:32", "text": "匿名性は本当に重要です"}, {"type": "subtitle", "time": 13054.469, "timestamp": "03:37:34", "text": "それはユーチューバーに「ああ、それは"}, {"type": "subtitle", "time": 13057.349, "timestamp": "03:37:37", "text": "なぜあなたが IRL になりたいと思ったら"}, {"type": "subtitle", "time": 13058.95, "timestamp": "03:37:38", "text": "ストリーマー、私はIRLになれたかもしれない"}, {"type": "subtitle", "time": 13061.99, "timestamp": "03:37:41", "text": "ストリーマー。つまり、私はストリーマーだったんです"}, {"type": "subtitle", "time": 13066.55, "timestamp": "03:37:46", "text": "Twitchで、いや、今は"}, {"type": "subtitle", "time": 13068.71, "timestamp": "03:37:48", "text": "違うのは、私が別の道を歩んだから"}, {"type": "subtitle", "time": 13072.63, "timestamp": "03:37:52", "text": "次回はジョークとして"}, {"type": "subtitle", "time": 13075.59, "timestamp": "03:37:55", "text": "そんな感じ。そう、"}, {"type": "subtitle", "time": 13078.63, "timestamp": "03:37:58", "text": "そしてOPECの件が出てくる。"}]
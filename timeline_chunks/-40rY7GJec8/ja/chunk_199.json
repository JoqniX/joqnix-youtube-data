[{"type": "subtitle", "time": 11942.229, "timestamp": "03:19:02", "text": "po 人気があるが、それでも"}, {"type": "subtitle", "time": 11946.229, "timestamp": "03:19:06", "text": "それで十分ですよね？いいえ。"}, {"type": "subtitle", "time": 11948.71, "timestamp": "03:19:08", "text": "そんな感じ。うん。あなたが理解してくれるといいのですが"}, {"type": "subtitle", "time": 11952.229, "timestamp": "03:19:12", "text": "つまり。何てことだ。私はよく喋る。"}, {"type": "subtitle", "time": 11954.55, "timestamp": "03:19:14", "text": "聖なるイエス。大丈夫。大丈夫。あなた"}, {"type": "subtitle", "time": 11958.15, "timestamp": "03:19:18", "text": "よく喋る。それはとても"}, {"type": "subtitle", "time": 11959.75, "timestamp": "03:19:19", "text": "私がコミュニティを離れるとき、"}, {"type": "subtitle", "time": 11962.07, "timestamp": "03:19:22", "text": "彼らは私のことを覚えている、まるで"}, {"type": "subtitle", "time": 11964.229, "timestamp": "03:19:24", "text": "面白い側面、おい、覚えてるか？"}, {"type": "subtitle", "time": 11966.469, "timestamp": "03:19:26", "text": "パン屋さん？ああ、あの男は"}, {"type": "subtitle", "time": 11968.469, "timestamp": "03:19:28", "text": "バカバカしいけど、それでもすごく楽しかった"}, {"type": "subtitle", "time": 11970.71, "timestamp": "03:19:30", "text": "あの男と一緒に。やれやれ。なぜ私は感じるのか"}, {"type": "subtitle", "time": 11974.15, "timestamp": "03:19:34", "text": "Rokuならそう言うだろうね？"}, {"type": "subtitle", "time": 11978.79, "timestamp": "03:19:38", "text": "何てことだ。でも、そういうのって私を幸せにしてくれるんです。"}, {"type": "subtitle", "time": 11980.15, "timestamp": "03:19:40", "text": "そして、今でも"}, {"type": "subtitle", "time": 11981.67, "timestamp": "03:19:41", "text": "私が去っても私のことを覚えていて、"}, {"type": "subtitle", "time": 11984.469, "timestamp": "03:19:44", "text": "いつも彼らに、私はあなたのそばにいたと伝えてください。"}, {"type": "subtitle", "time": 11986.309, "timestamp": "03:19:46", "text": "地域社会のためにそこにいなければならない"}, {"type": "subtitle", "time": 11992.07, "timestamp": "03:19:52", "text": "お前。ああ、君の言う通りだよ。つまり"}, {"type": "subtitle", "time": 11995.19, "timestamp": "03:19:55", "text": "また、もちろん私はこう思うでしょう"}, {"type": "subtitle", "time": 11997.83, "timestamp": "03:19:57", "text": "家族の中で公然と"}]
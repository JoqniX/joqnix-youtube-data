[{"type": "subtitle", "time": 9961.91, "timestamp": "02:46:01", "text": "エンターテイメントと情熱"}, {"type": "subtitle", "time": 9965.75, "timestamp": "02:46:05", "text": "そして"}, {"type": "subtitle", "time": 9969.75, "timestamp": "02:46:09", "text": "人を笑顔にするのが大好き"}, {"type": "subtitle", "time": 9978.87, "timestamp": "02:46:18", "text": "そしてもう1人は、"}, {"type": "subtitle", "time": 9981.349, "timestamp": "02:46:21", "text": "お金、"}, {"type": "subtitle", "time": 9983.59, "timestamp": "02:46:23", "text": "右？お金のためにやる人たち"}, {"type": "subtitle", "time": 9986.23, "timestamp": "02:46:26", "text": "そして"}, {"type": "subtitle", "time": 9993.349, "timestamp": "02:46:33", "text": "彼らは名声にあまりにも夢中になり、"}, {"type": "subtitle", "time": 9995.83, "timestamp": "02:46:35", "text": "物や服、その他すべて。"}, {"type": "subtitle", "time": 9999.99, "timestamp": "02:46:39", "text": "彼らは狂い始める、狂ったように"}, {"type": "subtitle", "time": 10002.469, "timestamp": "02:46:42", "text": "あちこちで大きな"}, {"type": "subtitle", "time": 10004.95, "timestamp": "02:46:44", "text": "混乱して、おそらく最後に"}, {"type": "subtitle", "time": 10007.51, "timestamp": "02:46:47", "text": "道は満足しないかもしれない"}, {"type": "subtitle", "time": 10009.269, "timestamp": "02:46:49", "text": "と"}, {"type": "subtitle", "time": 10012.309, "timestamp": "02:46:52", "text": "えーっと、またゲームがどう見えるか"}, {"type": "subtitle", "time": 10015.19, "timestamp": "02:46:55", "text": "そうですね、困っています。こんにちは、ヒデアサさん"}, {"type": "subtitle", "time": 10018.389, "timestamp": "02:46:58", "text": "お元気ですか？"}]
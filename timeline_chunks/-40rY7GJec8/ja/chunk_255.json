[{"type": "subtitle", "time": 15301.07, "timestamp": "04:15:01", "text": "そしてまた"}, {"type": "subtitle", "time": 15302.55, "timestamp": "04:15:02", "text": "[音楽]"}, {"type": "subtitle", "time": 15306.469, "timestamp": "04:15:06", "text": "来年の約束。"}, {"type": "subtitle", "time": 15309.51, "timestamp": "04:15:09", "text": "わからないよ、本当にしたくないんだ"}, {"type": "subtitle", "time": 15313.67, "timestamp": "04:15:13", "text": "約束をする。私は2020年の仕事について知っています。"}, {"type": "subtitle", "time": 15317.99, "timestamp": "04:15:17", "text": "2021年の仕事、2022年の仕事は、多くの可能性を秘めている。"}, {"type": "subtitle", "time": 15319.59, "timestamp": "04:15:19", "text": "しかし"}, {"type": "subtitle", "time": 15322.389, "timestamp": "04:15:22", "text": "これまで初披露したことはありますか？いいえ。"}, {"type": "subtitle", "time": 15324.55, "timestamp": "04:15:24", "text": "到達した"}, {"type": "subtitle", "time": 15327.189, "timestamp": "04:15:27", "text": "私が到達したかった段階またはステージ？いいえ、"}, {"type": "subtitle", "time": 15329.11, "timestamp": "04:15:29", "text": "まだ。まだ仕事は始まっていますか？"}, {"type": "subtitle", "time": 15332.149, "timestamp": "04:15:32", "text": "取り組んでいますか？まだ。"}, {"type": "subtitle", "time": 15335.91, "timestamp": "04:15:35", "text": "痛み。そう、たくさんのことがあるんだ"}, {"type": "subtitle", "time": 15339.67, "timestamp": "04:15:39", "text": "やらなければならない。そう、だって私が"}, {"type": "subtitle", "time": 15342.55, "timestamp": "04:15:42", "text": "何でもかんでもやらなきゃいけない人。私は"}, {"type": "subtitle", "time": 15345.67, "timestamp": "04:15:45", "text": "なぜ私はそんな風にやっているのだろう？なぜなら"}, {"type": "subtitle", "time": 15347.91, "timestamp": "04:15:47", "text": "なぜなら、私はYouTuberが"}, {"type": "subtitle", "time": 15351.03, "timestamp": "04:15:51", "text": "すべてはそれ自体で。彼らを見る"}, {"type": "subtitle", "time": 15353.03, "timestamp": "04:15:53", "text": "才能はないけれど"}, {"type": "subtitle", "time": 15355.269, "timestamp": "04:15:55", "text": "それでも彼らはあらゆる方法でそれをやろうとする"}, {"type": "subtitle", "time": 15357.349, "timestamp": "04:15:57", "text": "彼ら自身だが、ある瞬間が訪れる"}]
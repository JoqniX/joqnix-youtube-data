[{"type": "subtitle", "time": 1681.31, "timestamp": "00:28:01", "text": "コスチューム。私には欲しいものリストがあった。ありがとう。"}, {"type": "subtitle", "time": 1682.87, "timestamp": "00:28:02", "text": "[音楽]"}, {"type": "subtitle", "time": 1685.11, "timestamp": "00:28:05", "text": "来てくださった皆様、ありがとうございました。"}, {"type": "subtitle", "time": 1692.389, "timestamp": "00:28:12", "text": "衣装を買ってくれ。自撮りします"}, {"type": "subtitle", "time": 1694.47, "timestamp": "00:28:14", "text": "あまりにも。やり方についていくつかヒントがあります"}, {"type": "subtitle", "time": 1706.47, "timestamp": "00:28:26", "text": "もし私がこのコスチュームを着てセックスしたら。"}, {"type": "subtitle", "time": 1731.83, "timestamp": "00:28:51", "text": "[音楽]"}]
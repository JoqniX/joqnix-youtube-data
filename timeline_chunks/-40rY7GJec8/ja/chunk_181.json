[{"type": "subtitle", "time": 10862.309, "timestamp": "03:01:02", "text": "たくさん話して、みんなに感謝"}, {"type": "subtitle", "time": 10865.429, "timestamp": "03:01:05", "text": "個別に特別なものを与えて"}, {"type": "subtitle", "time": 10868.55, "timestamp": "03:01:08", "text": "感謝の気持ちを叫ぶような感じだよね"}, {"type": "subtitle", "time": 10871.99, "timestamp": "03:01:11", "text": "例えば、私が"}, {"type": "subtitle", "time": 10875.349, "timestamp": "03:01:15", "text": "すごく活発なチャットとか色々"}, {"type": "subtitle", "time": 10877.429, "timestamp": "03:01:17", "text": "例えば、人生全体のチャットとは"}, {"type": "subtitle", "time": 10880.15, "timestamp": "03:01:20", "text": "何が起こるのか、どれくらい続くのか"}, {"type": "subtitle", "time": 10882.15, "timestamp": "03:01:22", "text": "ストリームを終了させて​​、"}, {"type": "subtitle", "time": 10884.15, "timestamp": "03:01:24", "text": "皆さん、ありがとうございました。皆さんのメッセージを読みました。"}, {"type": "subtitle", "time": 10887.03, "timestamp": "03:01:27", "text": "メッセージとかそういうのがどうなるか気になる"}, {"type": "subtitle", "time": 10890.87, "timestamp": "03:01:30", "text": "しかし、私はストリーマーが"}, {"type": "subtitle", "time": 10892.87, "timestamp": "03:01:32", "text": "チャットが遅いモードだと役に立ちますね。"}, {"type": "subtitle", "time": 10895.51, "timestamp": "03:01:35", "text": "スローモードは役立ちますが、私は"}, {"type": "subtitle", "time": 10897.67, "timestamp": "03:01:37", "text": "積極的に交流する、そしてそう"}, {"type": "subtitle", "time": 10899.349, "timestamp": "03:01:39", "text": "こんにちは、今日はどうですか？"}, {"type": "subtitle", "time": 10904.07, "timestamp": "03:01:44", "text": "君はうまくやっているね。うん。それで"}, {"type": "subtitle", "time": 10907.03, "timestamp": "03:01:47", "text": "ある意味、私はこれについて考えました"}, {"type": "subtitle", "time": 10909.59, "timestamp": "03:01:49", "text": "長期的に。だから、"}, {"type": "subtitle", "time": 10911.67, "timestamp": "03:01:51", "text": "だから私はログを残しておくので、"}, {"type": "subtitle", "time": 10913.349, "timestamp": "03:01:53", "text": "読むことができる"}, {"type": "subtitle", "time": 10918.79, "timestamp": "03:01:58", "text": "たとえ声に出して読まなくても。"}]
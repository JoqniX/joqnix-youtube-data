[{"type": "subtitle", "time": 10921.59, "timestamp": "03:02:01", "text": "えっと、私がそれを読まなくても、あるいは私が"}, {"type": "subtitle", "time": 10924.309, "timestamp": "03:02:04", "text": "ただそれを見るか、私が忘れたとしても"}, {"type": "subtitle", "time": 10927.19, "timestamp": "03:02:07", "text": "ログをつけておけば、"}, {"type": "subtitle", "time": 10929.11, "timestamp": "03:02:09", "text": "戻って読んで、返信してください"}, {"type": "subtitle", "time": 10932.15, "timestamp": "03:02:12", "text": "翌日、その人。少なくとも"}, {"type": "subtitle", "time": 10940.469, "timestamp": "03:02:20", "text": "そういう感じだけど、よくわからない"}, {"type": "subtitle", "time": 10942.63, "timestamp": "03:02:22", "text": "しかし、恐ろしい考えが浮かぶ"}, {"type": "subtitle", "time": 10945.51, "timestamp": "03:02:25", "text": "考えてみると。"}, {"type": "subtitle", "time": 10948.55, "timestamp": "03:02:28", "text": "ある意味、私は大きくなりたくないのですが"}, {"type": "subtitle", "time": 10952.389, "timestamp": "03:02:32", "text": "ある意味、私は物事をそのように保ちたい"}, {"type": "subtitle", "time": 10954.87, "timestamp": "03:02:34", "text": "ですが、ある意味では私はそうしたいと思っています"}, {"type": "subtitle", "time": 10956.95, "timestamp": "03:02:36", "text": "コラボレーションできる自由を持つ"}, {"type": "subtitle", "time": 10958.87, "timestamp": "03:02:38", "text": "誰に対しても。"}, {"type": "subtitle", "time": 10960.79, "timestamp": "03:02:40", "text": "えっと"}, {"type": "subtitle", "time": 10965.429, "timestamp": "03:02:45", "text": "私は～が欲しい、または～に興味があります"}, {"type": "subtitle", "time": 10967.75, "timestamp": "03:02:47", "text": "しかし、これらの数字と検証結果は"}, {"type": "subtitle", "time": 10971.269, "timestamp": "03:02:51", "text": "そしてこれらのものはすべて"}, {"type": "subtitle", "time": 10973.11, "timestamp": "03:02:53", "text": "痛み"}, {"type": "subtitle", "time": 10975.349, "timestamp": "03:02:55", "text": "そこには何もない"}, {"type": "subtitle", "time": 10977.03, "timestamp": "03:02:57", "text": "君が大きな犬になったら、君を見守らないよ"}, {"type": "subtitle", "time": 10978.55, "timestamp": "03:02:58", "text": "彼らは「愛してる」と言っているけど、私は"}]
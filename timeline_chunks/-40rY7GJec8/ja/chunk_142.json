[{"type": "subtitle", "time": 8524.07, "timestamp": "02:22:04", "text": "これは、私たちが"}, {"type": "subtitle", "time": 8527.5, "timestamp": "02:22:07", "text": "低い、低い。"}, {"type": "subtitle", "time": 8530.87, "timestamp": "02:22:10", "text": "[音楽]"}, {"type": "subtitle", "time": 8532.95, "timestamp": "02:22:12", "text": "母さん、私を産んでくれてありがとう。行く"}, {"type": "subtitle", "time": 8535.349, "timestamp": "02:22:15", "text": "戻るために。あなたが"}, {"type": "subtitle", "time": 8538.71, "timestamp": "02:22:18", "text": "大きくなる。"}, {"type": "subtitle", "time": 8547.11, "timestamp": "02:22:27", "text": "[音楽]"}, {"type": "subtitle", "time": 8550.41, "timestamp": "02:22:30", "text": "丘の下を通り抜ければいい。アンダーヒルの意味。"}, {"type": "subtitle", "time": 8560.71, "timestamp": "02:22:40", "text": "[音楽]"}, {"type": "subtitle", "time": 8562.389, "timestamp": "02:22:42", "text": "初めて笑顔にさせてくれた"}, {"type": "subtitle", "time": 8565.21, "timestamp": "02:22:45", "text": "私の人生における時間。"}]
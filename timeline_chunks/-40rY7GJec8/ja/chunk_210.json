[{"type": "subtitle", "time": 12600.87, "timestamp": "03:30:00", "text": "安全のために何をすべきか、そしてどのようにすべきか"}, {"type": "subtitle", "time": 12603.429, "timestamp": "03:30:03", "text": "実行または自分を守るように、または"}, {"type": "subtitle", "time": 12605.269, "timestamp": "03:30:05", "text": "自分自身をどのようにケアすべきか、そして"}, {"type": "subtitle", "time": 12607.75, "timestamp": "03:30:07", "text": "この感情は、すべてそのようなものなのでしょうか？"}, {"type": "subtitle", "time": 12611.51, "timestamp": "03:30:11", "text": "そういうことですよね？うん。うん。うん。"}, {"type": "subtitle", "time": 12615.75, "timestamp": "03:30:15", "text": "ええ、そうですね。何か見落としたことはありますか？えっと、"}, {"type": "subtitle", "time": 12618.07, "timestamp": "03:30:18", "text": "私はいつもあなたを応援します。泣かないで。 A"}, {"type": "subtitle", "time": 12620.63, "timestamp": "03:30:20", "text": "ありがとう、モリッサ"}, {"type": "subtitle", "time": 12624.15, "timestamp": "03:30:24", "text": "本当に大きな意味があります。"}, {"type": "subtitle", "time": 12626.55, "timestamp": "03:30:26", "text": "それからメリッサ、あなたはここに来たばかりですね。"}, {"type": "subtitle", "time": 12629.429, "timestamp": "03:30:29", "text": "右？今日はどうやって私を見つけたのですか？"}, {"type": "subtitle", "time": 12631.5, "timestamp": "03:30:31", "text": "ところで、どうやって私を見つけたんですか？"}, {"type": "subtitle", "time": 12633.11, "timestamp": "03:30:33", "text": "[音楽]"}, {"type": "subtitle", "time": 12641.269, "timestamp": "03:30:41", "text": "待って、行かなかったことを願う"}, {"type": "subtitle", "time": 12643.67, "timestamp": "03:30:43", "text": "深く掘り下げていたら、"}, {"type": "subtitle", "time": 12647.429, "timestamp": "03:30:47", "text": "怖くなかった話"}, {"type": "subtitle", "time": 12650.309, "timestamp": "03:30:50", "text": "先ほどご覧になっていた方々"}, {"type": "subtitle", "time": 12653.67, "timestamp": "03:30:53", "text": "さあ、今すぐ行こう"}, {"type": "subtitle", "time": 12657.11, "timestamp": "03:30:57", "text": "でも、Googleには感謝します。"}]
[{"type": "subtitle", "time": 9542.309, "timestamp": "02:39:02", "text": "引っ越しはさらに難しい"}, {"type": "subtitle", "time": 9544.95, "timestamp": "02:39:04", "text": "などなど、そうですよね？あなたはそうしなければならない"}, {"type": "subtitle", "time": 9546.55, "timestamp": "02:39:06", "text": "独立した"}, {"type": "subtitle", "time": 9548.63, "timestamp": "02:39:08", "text": "両親から許可を得る"}, {"type": "subtitle", "time": 9551.11, "timestamp": "02:39:11", "text": "ついに独立する"}, {"type": "subtitle", "time": 9552.87, "timestamp": "02:39:12", "text": "荷物を全部持っていかないといけないみたい"}, {"type": "subtitle", "time": 9555.27, "timestamp": "02:39:15", "text": "家から新しい場所へ、そしてその他諸々"}, {"type": "subtitle", "time": 9560.15, "timestamp": "02:39:20", "text": "そして、ほら、あの"}, {"type": "subtitle", "time": 9562.79, "timestamp": "02:39:22", "text": "背景で飼い犬が吠えている。うん、"}, {"type": "subtitle", "time": 9566.63, "timestamp": "02:39:26", "text": "ペットの犬とか、あなたのペットみたいな"}, {"type": "subtitle", "time": 9568.63, "timestamp": "02:39:28", "text": "背景では狂ったように"}, {"type": "subtitle", "time": 9571.03, "timestamp": "02:39:31", "text": "それ。そんな感じのことです。"}, {"type": "subtitle", "time": 9573.11, "timestamp": "02:39:33", "text": "うん。うん。うん。それは昨日のことだった。"}, {"type": "subtitle", "time": 9580.87, "timestamp": "02:39:40", "text": "うん。タムは昨日治癒した"}, {"type": "subtitle", "time": 9582.95, "timestamp": "02:39:42", "text": "えーと"}, {"type": "subtitle", "time": 9585.429, "timestamp": "02:39:45", "text": "私たちが普通の仕事に就くまで。"}, {"type": "subtitle", "time": 9587.429, "timestamp": "02:39:47", "text": "うん。うん。それは本当です。それは本当です。"}, {"type": "subtitle", "time": 9589.83, "timestamp": "02:39:49", "text": "しかし、人々が提案することやあなたの"}, {"type": "subtitle", "time": 9591.429, "timestamp": "02:39:51", "text": "家族はただ行くことを提案する"}, {"type": "subtitle", "time": 9594.15, "timestamp": "02:39:54", "text": "ホストやスタッフ、ライブ配信"}, {"type": "subtitle", "time": 9596.63, "timestamp": "02:39:56", "text": "でもその方法だとPCを持ち込めるの？"}, {"type": "subtitle", "time": 9599.99, "timestamp": "02:39:59", "text": "あなたの持ち物やその他の装備品は？いいえ。"}]
[{"type": "subtitle", "time": 2527.829, "timestamp": "00:42:07", "text": "ストレスレベルは"}, {"type": "subtitle", "time": 2539.589, "timestamp": "00:42:19", "text": "麻雀をやらなきゃいけないかも、って考えてる"}, {"type": "subtitle", "time": 2541.589, "timestamp": "00:42:21", "text": "だからストリーミングできるけど、もう"}, {"type": "subtitle", "time": 2543.51, "timestamp": "00:42:23", "text": "裏工作を知って、私にやり方を教えて"}, {"type": "subtitle", "time": 2551.589, "timestamp": "00:42:31", "text": "大丈夫。"}, {"type": "subtitle", "time": 2556.63, "timestamp": "00:42:36", "text": "でも、ごめんなさい。ここに来て。"}, {"type": "subtitle", "time": 2564.23, "timestamp": "00:42:44", "text": "[音楽]"}, {"type": "subtitle", "time": 2565.99, "timestamp": "00:42:45", "text": "ああ、なんてことだ。彼女は返信してこない。"}, {"type": "subtitle", "time": 2569.03, "timestamp": "00:42:49", "text": "何てことだ。あなたはどうですか？私もやっています"}, {"type": "subtitle", "time": 2571.67, "timestamp": "00:42:51", "text": "良い。私も順調にやっています。はい。"}, {"type": "subtitle", "time": 2573.19, "timestamp": "00:42:53", "text": "はい。 [音楽]"}]
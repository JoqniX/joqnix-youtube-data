[{"type": "subtitle", "time": 7922.04, "timestamp": "02:12:02", "text": "それはどういう意味ですか？"}, {"type": "subtitle", "time": 7924.31, "timestamp": "02:12:04", "text": "[音楽]"}, {"type": "subtitle", "time": 7926.58, "timestamp": "02:12:06", "text": "待って、知りたいんだ。え、何？"}, {"type": "subtitle", "time": 7955.03, "timestamp": "02:12:35", "text": "待って。愛しすぎると、"}, {"type": "subtitle", "time": 7958.069, "timestamp": "02:12:38", "text": "私は扱いにくい人間かもしれない。だから、"}, {"type": "subtitle", "time": 7961.27, "timestamp": "02:12:41", "text": "良い結果を出す。なんてこった。それは正しい。"}, {"type": "subtitle", "time": 7963.83, "timestamp": "02:12:43", "text": "わかった。わかった。わかった。わかった。わかった。私の"}, {"type": "subtitle", "time": 7966.229, "timestamp": "02:12:46", "text": "現在18金。それが理由です。わかった。わかった。"}, {"type": "subtitle", "time": 7968.53, "timestamp": "02:12:48", "text": "わかった。わかった。わかった。わかった。わかった。"}]
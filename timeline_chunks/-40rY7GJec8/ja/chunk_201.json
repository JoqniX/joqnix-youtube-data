[{"type": "subtitle", "time": 12061.67, "timestamp": "03:21:01", "text": "チャットログは毎日ありますか？"}, {"type": "subtitle", "time": 12063.99, "timestamp": "03:21:03", "text": "あなたが送信したメッセージ"}, {"type": "subtitle", "time": 12066.07, "timestamp": "03:21:06", "text": "私のDiscordにはそれが表示されます"}, {"type": "subtitle", "time": 12070.469, "timestamp": "03:21:10", "text": "正しく読むために、読み返します"}, {"type": "subtitle", "time": 12073.75, "timestamp": "03:21:13", "text": "特に皆さんのメッセージについて"}, {"type": "subtitle", "time": 12077.11, "timestamp": "03:21:17", "text": "フィルタリングして、その人に"}, {"type": "subtitle", "time": 12079.59, "timestamp": "03:21:19", "text": "すべてのメッセージを読んで、それによって"}, {"type": "subtitle", "time": 12082.229, "timestamp": "03:21:22", "text": "ある特定の人物がそうなので私は"}, {"type": "subtitle", "time": 12085.349, "timestamp": "03:21:25", "text": "もちろんまた泣くけど、"}, {"type": "subtitle", "time": 12094.79, "timestamp": "03:21:34", "text": "私を支えてくれた、私のそばにいてくれた"}, {"type": "subtitle", "time": 12098.389, "timestamp": "03:21:38", "text": "私のために来て、"}, {"type": "subtitle", "time": 12101.59, "timestamp": "03:21:41", "text": "続ける意志力を与えてくれた"}, {"type": "subtitle", "time": 12104.07, "timestamp": "03:21:44", "text": "ストリーミングやファッション全般と同様に"}, {"type": "subtitle", "time": 12108.469, "timestamp": "03:21:48", "text": "今まで見たことのない世界"}, {"type": "subtitle", "time": 12111.349, "timestamp": "03:21:51", "text": "でも、私は泣いている。ああ、なぜ私は"}, {"type": "subtitle", "time": 12113.99, "timestamp": "03:21:53", "text": "お茶を淹れる？何てことだ。そうそう。のように"}, {"type": "subtitle", "time": 12117.67, "timestamp": "03:21:57", "text": "すると、ええと、私は心の中で「そうしよう」と思う"}]
[{"type": "subtitle", "time": 13920.71, "timestamp": "03:52:00", "text": "私は代替品を探そうとさえしました"}, {"type": "subtitle", "time": 13924.95, "timestamp": "03:52:04", "text": "運動選手になる資格がないと感じたから、運動選手にはなれないと思った。"}, {"type": "subtitle", "time": 13927.75, "timestamp": "03:52:07", "text": "などなど、良い"}, {"type": "subtitle", "time": 13930.63, "timestamp": "03:52:10", "text": "代替品と彼と私が彼らに尋ねたところ、"}, {"type": "subtitle", "time": 13934.389, "timestamp": "03:52:14", "text": "彼はスポーツマンとは似ていなかった"}, {"type": "subtitle", "time": 13936.15, "timestamp": "03:52:16", "text": "に代わるものは決してない"}, {"type": "subtitle", "time": 13937.91, "timestamp": "03:52:17", "text": "ジョック、君は理解しなければならない"}, {"type": "subtitle", "time": 13942.07, "timestamp": "03:52:22", "text": "たとえ私が"}, {"type": "subtitle", "time": 13945.67, "timestamp": "03:52:25", "text": "彼らが男かスポーツマンなら、それは"}, {"type": "subtitle", "time": 13948.95, "timestamp": "03:52:28", "text": "二度とあんな風にはならないし、私は"}, {"type": "subtitle", "time": 13952.71, "timestamp": "03:52:32", "text": "その後、私はそれが"}, {"type": "subtitle", "time": 13954.229, "timestamp": "03:52:34", "text": "真実"}, {"type": "subtitle", "time": 13958.469, "timestamp": "03:52:38", "text": "それは本当にその通りで、まるで"}, {"type": "subtitle", "time": 13962.15, "timestamp": "03:52:42", "text": "あなたはキャラクターの声を担当していて、"}, {"type": "subtitle", "time": 13964.55, "timestamp": "03:52:44", "text": "キャラクターの声を演じることができない日"}, {"type": "subtitle", "time": 13966.95, "timestamp": "03:52:46", "text": "もう他の誰かの声優のように"}, {"type": "subtitle", "time": 13969.99, "timestamp": "03:52:49", "text": "キャラクターと人々は"}, {"type": "subtitle", "time": 13971.269, "timestamp": "03:52:51", "text": "キャラクターを知っていて、"}, {"type": "subtitle", "time": 13974.229, "timestamp": "03:52:54", "text": "キャラクターはそれを感じないだろう"}, {"type": "subtitle", "time": 13977.189, "timestamp": "03:52:57", "text": "もういいよ、だって彼らは愛していたから"}, {"type": "subtitle", "time": 13979.59, "timestamp": "03:52:59", "text": "最初の声優ではなく、2番目の声優"}]
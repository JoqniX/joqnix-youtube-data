[{"type": "subtitle", "time": 15780.07, "timestamp": "04:23:00", "text": "ゲームについて、ゲーム内のことなど"}, {"type": "subtitle", "time": 15782.07, "timestamp": "04:23:02", "text": "すべて。ありがとうございます。本当に"}, {"type": "subtitle", "time": 15786.71, "timestamp": "04:23:06", "text": "とても意味があります。そして今日ヤシャンがやって来た"}, {"type": "subtitle", "time": 15788.95, "timestamp": "04:23:08", "text": "本日はお越しいただきありがとうございます。楽しんでいただけたでしょうか。"}, {"type": "subtitle", "time": 15795.83, "timestamp": "04:23:15", "text": "[音楽]"}, {"type": "subtitle", "time": 15798.55, "timestamp": "04:23:18", "text": "ありがとう。ありがとう"}, {"type": "subtitle", "time": 15800.79, "timestamp": "04:23:20", "text": "お越しいただきありがとうございます。今日を楽しんでください。"}, {"type": "subtitle", "time": 15803.83, "timestamp": "04:23:23", "text": "待って。えっと、何か見逃したかな？"}, {"type": "subtitle", "time": 15806.469, "timestamp": "04:23:26", "text": "ヤシュ？彼のメッセージをもう一度確認してみます。"}, {"type": "subtitle", "time": 15813.189, "timestamp": "04:23:33", "text": "なぜか、何か見落としたような気がする。"}, {"type": "subtitle", "time": 15817.349, "timestamp": "04:23:37", "text": "ヤシュのヤシュより、今日。"}, {"type": "subtitle", "time": 15819.03, "timestamp": "04:23:39", "text": "ああ、君は誰かを見ていたんだね、"}, {"type": "subtitle", "time": 15821.269, "timestamp": "04:23:41", "text": "右？そしてあなたは誰かを殺した。よくやった"}, {"type": "subtitle", "time": 15825.269, "timestamp": "04:23:45", "text": "それについて。よくやった、よくやった、よくやった。"}, {"type": "subtitle", "time": 15827.349, "timestamp": "04:23:47", "text": "ぜひお越しください。よしよしよし。ええ、ええ、"}, {"type": "subtitle", "time": 15828.95, "timestamp": "04:23:48", "text": "うん。"}, {"type": "subtitle", "time": 15831.75, "timestamp": "04:23:51", "text": "ああ、そうだな。"}, {"type": "subtitle", "time": 15833.75, "timestamp": "04:23:53", "text": "これらを彼の無実ではないものにする方法は"}, {"type": "subtitle", "time": 15836.07, "timestamp": "04:23:56", "text": "消えゆく。ああ、うっかりやってしまったんだ"}]
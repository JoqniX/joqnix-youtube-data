[{"type": "subtitle", "time": 4202.55, "timestamp": "01:10:02", "text": "幼い女の子が登場するアニメが好きです。へへ、ああ、"}, {"type": "subtitle", "time": 4205.02, "timestamp": "01:10:05", "text": "お前はロリーコンだな。 O"}, {"type": "subtitle", "time": 4207.11, "timestamp": "01:10:07", "text": "[音楽]"}, {"type": "subtitle", "time": 4211.18, "timestamp": "01:10:11", "text": "193。以前は193でした。"}, {"type": "subtitle", "time": 4214.149, "timestamp": "01:10:14", "text": "[音楽]"}, {"type": "subtitle", "time": 4216.28, "timestamp": "01:10:16", "text": "おお、"}, {"type": "subtitle", "time": 4218.79, "timestamp": "01:10:18", "text": "[音楽]"}, {"type": "subtitle", "time": 4221.36, "timestamp": "01:10:21", "text": "下降線をたどることは分かっている。"}, {"type": "subtitle", "time": 4225.189, "timestamp": "01:10:25", "text": "[音楽]"}, {"type": "subtitle", "time": 4227.59, "timestamp": "01:10:27", "text": "私のパブが浄化されたような気がする。"}, {"type": "subtitle", "time": 4229.43, "timestamp": "01:10:29", "text": "いいえ、デビュー以来という意味です。ああ、わかりました。"}, {"type": "subtitle", "time": 4231.91, "timestamp": "01:10:31", "text": "わかった。"}, {"type": "subtitle", "time": 4235.27, "timestamp": "01:10:35", "text": "え、デビュー戦で193点も取ったの？ああ、わかった。"}, {"type": "subtitle", "time": 4237.99, "timestamp": "01:10:37", "text": "そうそう。うん。視聴者数193人から7万人へ。"}, {"type": "subtitle", "time": 4239.03, "timestamp": "01:10:39", "text": "わかった。わかった。わかった。わかった。うん。うん。"}, {"type": "subtitle", "time": 4241.75, "timestamp": "01:10:41", "text": "うん。それは大きなことだ。"}]
[{"type": "subtitle", "time": 6784.229, "timestamp": "01:53:04", "text": "私は許されるべきではないと思う"}, {"type": "subtitle", "time": 6798.39, "timestamp": "01:53:18", "text": "レベル。人生をそんなに深刻に考えすぎる必要はない。"}, {"type": "subtitle", "time": 6800.229, "timestamp": "01:53:20", "text": "ありがとう、ピザ。"}, {"type": "subtitle", "time": 6810.229, "timestamp": "01:53:30", "text": "私のミスです。私のミスです。私のミスです。あなたは私を愛していますか？"}, {"type": "subtitle", "time": 6812.629, "timestamp": "01:53:32", "text": "だって、君を愛してるから。"}, {"type": "subtitle", "time": 6818.55, "timestamp": "01:53:38", "text": "つまり、あなたは本当に私のことを愛しているの？"}, {"type": "subtitle", "time": 6821.99, "timestamp": "01:53:41", "text": "愛してる、愛してる、愛してる。"}, {"type": "subtitle", "time": 6826.149, "timestamp": "01:53:46", "text": "本当に、本当に、あなたを愛しています。"}]
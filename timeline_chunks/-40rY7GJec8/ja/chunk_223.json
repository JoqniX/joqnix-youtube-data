[{"type": "subtitle", "time": 13383.59, "timestamp": "03:43:03", "text": "知らない人がいるけど、"}, {"type": "subtitle", "time": 13386.87, "timestamp": "03:43:06", "text": "パン屋兼サロンになる。つまり、"}, {"type": "subtitle", "time": 13388.55, "timestamp": "03:43:08", "text": "身元窃盗、死亡窃盗、そして"}, {"type": "subtitle", "time": 13392.309, "timestamp": "03:43:12", "text": "そうですね、よくわかりませんが、何人かの人が"}, {"type": "subtitle", "time": 13395.269, "timestamp": "03:43:15", "text": "楽しみのためにやる"}, {"type": "subtitle", "time": 13397.83, "timestamp": "03:43:17", "text": "そう、一部の人はただ"}, {"type": "subtitle", "time": 13400.71, "timestamp": "03:43:20", "text": "楽しいけど実際は"}, {"type": "subtitle", "time": 13403.51, "timestamp": "03:43:23", "text": "彼らは自分が何者なのかを知らない"}, {"type": "subtitle", "time": 13405.75, "timestamp": "03:43:25", "text": "彼らがどのように苦しむか、そして"}, {"type": "subtitle", "time": 13407.269, "timestamp": "03:43:27", "text": "すべて"}, {"type": "subtitle", "time": 13409.349, "timestamp": "03:43:29", "text": "まあ、彼らはもちろん楽しみのためにやっているんだよ"}, {"type": "subtitle", "time": 13411.67, "timestamp": "03:43:31", "text": "えっと、インターネットです"}, {"type": "subtitle", "time": 13413.83, "timestamp": "03:43:33", "text": "一般の人々がトロール行為をしているのを見ると、"}, {"type": "subtitle", "time": 13416.79, "timestamp": "03:43:36", "text": "そしてオンラインで人をいじめる"}, {"type": "subtitle", "time": 13419.83, "timestamp": "03:43:39", "text": "楽しいから、だって私はそれが好きだから、そして"}, {"type": "subtitle", "time": 13423.11, "timestamp": "03:43:43", "text": "最終的に、その影響を受ける人々は"}, {"type": "subtitle", "time": 13424.79, "timestamp": "03:43:44", "text": "多くのトラウマを経験し、"}, {"type": "subtitle", "time": 13429.03, "timestamp": "03:43:49", "text": "すべて正しいが、このように"}, {"type": "subtitle", "time": 13431.99, "timestamp": "03:43:51", "text": "私も同じです"}, {"type": "subtitle", "time": 13433.91, "timestamp": "03:43:53", "text": "のように"}, {"type": "subtitle", "time": 13437.189, "timestamp": "03:43:57", "text": "大きくなるにつれて"}, {"type": "subtitle", "time": 13439.189, "timestamp": "03:43:59", "text": "あなたがもっと大きくなったら、"}]
[{"type": "subtitle", "time": 11100.15, "timestamp": "03:05:00", "text": "重要なのは、ストリーマーがどのように対処するかです"}, {"type": "subtitle", "time": 11105.03, "timestamp": "03:05:05", "text": "そのような場合、"}, {"type": "subtitle", "time": 11108.63, "timestamp": "03:05:08", "text": "やったことは、物事を正常かつ平等に保つことだった"}, {"type": "subtitle", "time": 11111.349, "timestamp": "03:05:11", "text": "そして同じであり、"}, {"type": "subtitle", "time": 11114.389, "timestamp": "03:05:14", "text": "古い視聴者は何も"}, {"type": "subtitle", "time": 11116.23, "timestamp": "03:05:16", "text": "変化していくでしょう、そして新しい視聴者へ"}, {"type": "subtitle", "time": 11118.95, "timestamp": "03:05:18", "text": "何も変わらないだろう。彼らです"}, {"type": "subtitle", "time": 11121.11, "timestamp": "03:05:21", "text": "彼ら自身になるだろうし、それは"}, {"type": "subtitle", "time": 11123.51, "timestamp": "03:05:23", "text": "そんな感じ。たとえ数字が揃っていても"}, {"type": "subtitle", "time": 11126.309, "timestamp": "03:05:26", "text": "そう言っても数字は"}, {"type": "subtitle", "time": 11129.269, "timestamp": "03:05:29", "text": "より大きなことは同じで、"}, {"type": "subtitle", "time": 11132.55, "timestamp": "03:05:32", "text": "そういう類のもの"}, {"type": "subtitle", "time": 11137.349, "timestamp": "03:05:37", "text": "そしてある意味、あの瞬間は"}, {"type": "subtitle", "time": 11139.75, "timestamp": "03:05:39", "text": "私にとってはむしろモチベーションを高める瞬間だった"}, {"type": "subtitle", "time": 11142.63, "timestamp": "03:05:42", "text": "あの時、でも私がやったと思うことは"}, {"type": "subtitle", "time": 11146.15, "timestamp": "03:05:46", "text": "12時間の配信を2回続けて、"}, {"type": "subtitle", "time": 11149.349, "timestamp": "03:05:49", "text": "私もそう思うように自分にプレッシャーをかけている"}, {"type": "subtitle", "time": 11151.99, "timestamp": "03:05:51", "text": "あの頃は最善を尽くさなければならない"}, {"type": "subtitle", "time": 11155.91, "timestamp": "03:05:55", "text": "彼らが行くのを見て、"}, {"type": "subtitle", "time": 11159.59, "timestamp": "03:05:59", "text": "彼らの最高傑作。私も刺激を受けて"}]
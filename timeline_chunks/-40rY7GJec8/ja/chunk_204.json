[{"type": "subtitle", "time": 12240.15, "timestamp": "03:24:00", "text": "そういう風に考えてみると"}, {"type": "subtitle", "time": 12242.71, "timestamp": "03:24:02", "text": "コースのような"}, {"type": "subtitle", "time": 12245.349, "timestamp": "03:24:05", "text": "えっと、これはチャレンジみたいなものになるだろう"}, {"type": "subtitle", "time": 12248.07, "timestamp": "03:24:08", "text": "そうですね、私が言ったように"}, {"type": "subtitle", "time": 12251.03, "timestamp": "03:24:11", "text": "私自身もその時はこれらと同じように"}, {"type": "subtitle", "time": 12254.469, "timestamp": "03:24:14", "text": "必ず起こる、いや、みんなではない"}, {"type": "subtitle", "time": 12256.229, "timestamp": "03:24:16", "text": "誰もが永遠にそこにいるだろう"}, {"type": "subtitle", "time": 12258.79, "timestamp": "03:24:18", "text": "人は変わるものだ、人は変わるものだ"}, {"type": "subtitle", "time": 12261.59, "timestamp": "03:24:21", "text": "前に進んで、それが人生だ"}, {"type": "subtitle", "time": 12265.99, "timestamp": "03:24:25", "text": "いつも言っている通り、予期せぬ旅ですね。"}, {"type": "subtitle", "time": 12267.67, "timestamp": "03:24:27", "text": "それで"}, {"type": "subtitle", "time": 12271.269, "timestamp": "03:24:31", "text": "大切なのはあなたが私をそばに置いておくことです"}, {"type": "subtitle", "time": 12274.229, "timestamp": "03:24:34", "text": "自分の活動を続け、より多くの人にインスピレーションを与えましょう"}, {"type": "subtitle", "time": 12277.349, "timestamp": "03:24:37", "text": "外にいる人たち、そして"}, {"type": "subtitle", "time": 12279.99, "timestamp": "03:24:39", "text": "家族。その一部である人々と"}, {"type": "subtitle", "time": 12283.19, "timestamp": "03:24:43", "text": "それには関係ない。みんな、みんな、"}, {"type": "subtitle", "time": 12285.03, "timestamp": "03:24:45", "text": "私のことを知っているすべての人"}, {"type": "subtitle", "time": 12288.229, "timestamp": "03:24:48", "text": "昔ここにいた存在"}, {"type": "subtitle", "time": 12291.67, "timestamp": "03:24:51", "text": "2019年からストリーミングを開始しました。"}, {"type": "subtitle", "time": 12295.03, "timestamp": "03:24:55", "text": "その時点から今日まで"}, {"type": "subtitle", "time": 12297.429, "timestamp": "03:24:57", "text": "彼ら全員も最善を尽くすべきだ"}, {"type": "subtitle", "time": 12299.51, "timestamp": "03:24:59", "text": "そんな感じ"}]
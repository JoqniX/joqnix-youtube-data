[{"type": "subtitle", "time": 2102.39, "timestamp": "00:35:02", "text": "私はこのような質問を1回だけします"}, {"type": "subtitle", "time": 2104.63, "timestamp": "00:35:04", "text": "ゲーム。多くのゲームは本当に難しい"}, {"type": "subtitle", "time": 2113.03, "timestamp": "00:35:13", "text": "これらのゲームの多くは本当に難しい"}, {"type": "subtitle", "time": 2114.63, "timestamp": "00:35:14", "text": "探す"}, {"type": "subtitle", "time": 2117.75, "timestamp": "00:35:17", "text": "ストリーム。わかった、私は諦めない"}, {"type": "subtitle", "time": 2121.19, "timestamp": "00:35:21", "text": "最後の一匹の吸血鬼を殺すまで。"}, {"type": "subtitle", "time": 2126.39, "timestamp": "00:35:26", "text": "[音楽]"}, {"type": "subtitle", "time": 2128.79, "timestamp": "00:35:28", "text": "わあ、君って本当にゲームが上手いんだね。私は"}, {"type": "subtitle", "time": 2136.23, "timestamp": "00:35:36", "text": "アドバイスを差し上げましょうか？"}, {"type": "subtitle", "time": 2137.91, "timestamp": "00:35:37", "text": "いいえ。"}, {"type": "subtitle", "time": 2140.63, "timestamp": "00:35:40", "text": "[音楽]"}]
[{"type": "subtitle", "time": 3183.99, "timestamp": "00:53:03", "text": "大人。彼らはいつも偽善的だ。"}, {"type": "subtitle", "time": 3186.39, "timestamp": "00:53:06", "text": "なんてこった。"}, {"type": "subtitle", "time": 3190.23, "timestamp": "00:53:10", "text": "私は14歳です。いや、私は10歳です。違う。いや、違う。あなた"}, {"type": "subtitle", "time": 3195.03, "timestamp": "00:53:15", "text": "配信を見るべきではない。オバカ。"}, {"type": "subtitle", "time": 3197.27, "timestamp": "00:53:17", "text": "私は自分の部屋でじっとしていて、あなたがするのを想像します"}, {"type": "subtitle", "time": 3201.109, "timestamp": "00:53:21", "text": "私の人生における他のすべての人。 A"}, {"type": "subtitle", "time": 3218.549, "timestamp": "00:53:38", "text": "彼女は走っている。笑。何てことだ。あなた"}, {"type": "subtitle", "time": 3220.87, "timestamp": "00:53:40", "text": "戦車で走るべきではない。 O"}, {"type": "subtitle", "time": 3234.23, "timestamp": "00:53:54", "text": "なぜあなたは自分がドロップキッズだと感じるのですか？"}, {"type": "subtitle", "time": 3238.79, "timestamp": "00:53:58", "text": "[音楽]"}]
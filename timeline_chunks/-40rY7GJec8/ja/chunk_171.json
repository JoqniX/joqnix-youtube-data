[{"type": "subtitle", "time": 10260.56, "timestamp": "02:51:00", "text": "そういう感じですね。それは 私が学んだ方法"}, {"type": "subtitle", "time": 10265.12, "timestamp": "02:51:05", "text": "私が学んだ方法 そう、数字は、たとえあなたが気にしなくても"}, {"type": "subtitle", "time": 10268.399, "timestamp": "02:51:08", "text": "そう、数字は、たとえあなたが気にしなくても 数字に関しては、ある時点で"}, {"type": "subtitle", "time": 10272.399, "timestamp": "02:51:12", "text": "数字に関しては、ある時点で あなたが強制されている"}, {"type": "subtitle", "time": 10274.56, "timestamp": "02:51:14", "text": "あなたが強制されている それを見る"}, {"type": "subtitle", "time": 10280.95, "timestamp": "02:51:20", "text": "時々ではなく、たまに"}, {"type": "subtitle", "time": 10284.79, "timestamp": "02:51:24", "text": "強い私による中程度のもののように"}, {"type": "subtitle", "time": 10288.15, "timestamp": "02:51:28", "text": "つまり、なんて言うんだっけ？"}, {"type": "subtitle", "time": 10290.07, "timestamp": "02:51:30", "text": "視覚的な友達が欲しいとしましょう"}, {"type": "subtitle", "time": 10292.389, "timestamp": "02:51:32", "text": "あるいは彼らが話している何か"}, {"type": "subtitle", "time": 10295.269, "timestamp": "02:51:35", "text": "こういうのが好きなので関連しています"}, {"type": "subtitle", "time": 10297.59, "timestamp": "02:51:37", "text": "このような話題や、彼らが始めるような"}, {"type": "subtitle", "time": 10299.83, "timestamp": "02:51:39", "text": "比較して何かを感じて"}, {"type": "subtitle", "time": 10301.67, "timestamp": "02:51:41", "text": "心の中で感じる"}, {"type": "subtitle", "time": 10303.75, "timestamp": "02:51:43", "text": "ああ"}, {"type": "subtitle", "time": 10309.429, "timestamp": "02:51:49", "text": "他人と自分を比較し始め、"}, {"type": "subtitle", "time": 10312.07, "timestamp": "02:51:52", "text": "ゆっくりと、"}, {"type": "subtitle", "time": 10314.15, "timestamp": "02:51:54", "text": "数字を見ると、"}, {"type": "subtitle", "time": 10316.309, "timestamp": "02:51:56", "text": "自分の数字を見て、彼らの数字も見てください"}, {"type": "subtitle", "time": 10319.91, "timestamp": "02:51:59", "text": "数字の感覚"}]
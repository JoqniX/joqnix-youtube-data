[{"type": "subtitle", "time": 10440.23, "timestamp": "02:54:00", "text": "改善して改善する、なぜなら"}, {"type": "subtitle", "time": 10442.309, "timestamp": "02:54:02", "text": "心または精神の最も深い部分"}, {"type": "subtitle", "time": 10444.95, "timestamp": "02:54:04", "text": "いつもそうなるだろう"}, {"type": "subtitle", "time": 10448.15, "timestamp": "02:54:08", "text": "あなたより優れた人たちが、どんなことでも正しい"}, {"type": "subtitle", "time": 10451.11, "timestamp": "02:54:11", "text": "文脈によってはニッチになることもあり、"}, {"type": "subtitle", "time": 10455.99, "timestamp": "02:54:15", "text": "芸術、音楽、ゲームなど、"}, {"type": "subtitle", "time": 10458.87, "timestamp": "02:54:18", "text": "などなど。常にさらに良いものがあるだろう。"}, {"type": "subtitle", "time": 10461.19, "timestamp": "02:54:21", "text": "世の中にはたくさんの人がいる。研究でも、"}, {"type": "subtitle", "time": 10463.99, "timestamp": "02:54:23", "text": "すべてに競争がある、"}, {"type": "subtitle", "time": 10465.67, "timestamp": "02:54:25", "text": "右？"}, {"type": "subtitle", "time": 10469.67, "timestamp": "02:54:29", "text": "しかし、重要なのはそれをどのように行うかだ。"}, {"type": "subtitle", "time": 10471.59, "timestamp": "02:54:31", "text": "たとえ失敗であっても、"}, {"type": "subtitle", "time": 10473.75, "timestamp": "02:54:33", "text": "成功、たとえあなたが"}, {"type": "subtitle", "time": 10477.03, "timestamp": "02:54:37", "text": "たとえうまくいかなくても、"}, {"type": "subtitle", "time": 10479.59, "timestamp": "02:54:39", "text": "重要なのは"}, {"type": "subtitle", "time": 10482.87, "timestamp": "02:54:42", "text": "やれば、たとえ小さなものでも好きになれる"}, {"type": "subtitle", "time": 10486.71, "timestamp": "02:54:46", "text": "参加の度合い。それは正しい。"}, {"type": "subtitle", "time": 10488.389, "timestamp": "02:54:48", "text": "それぞれの人が何を望んでいるかを考えてみてください"}, {"type": "subtitle", "time": 10490.79, "timestamp": "02:54:50", "text": "検証は避けられない。"}, {"type": "subtitle", "time": 10493.11, "timestamp": "02:54:53", "text": "うん。うん。うん。私は学んだ"}, {"type": "subtitle", "time": 10496.07, "timestamp": "02:54:56", "text": "私が言ったように理解しました"}, {"type": "subtitle", "time": 10499.51, "timestamp": "02:54:59", "text": "自分自身のように、また他の人のように"}]
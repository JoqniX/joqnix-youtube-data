[{"type": "subtitle", "time": 11640.71, "timestamp": "03:14:00", "text": "ステータスは、私、私、私自身が持っているようなものでした"}, {"type": "subtitle", "time": 11645.03, "timestamp": "03:14:05", "text": "カスタムエモートと、誰でも"}, {"type": "subtitle", "time": 11648.79, "timestamp": "03:14:08", "text": "チャットはどこでも使える"}, {"type": "subtitle", "time": 11652.07, "timestamp": "03:14:12", "text": "彼らがそうしたいなら、私のストリームから出て行って"}, {"type": "subtitle", "time": 11653.83, "timestamp": "03:14:13", "text": "エモート。それが唯一の"}, {"type": "subtitle", "time": 11657.03, "timestamp": "03:14:17", "text": "私を幸せにしてくれて、また、えっと、"}, {"type": "subtitle", "time": 11658.55, "timestamp": "03:14:18", "text": "チャンネルポイント。そうすれば"}, {"type": "subtitle", "time": 11660.55, "timestamp": "03:14:20", "text": "もっと交流すべきですよね？そして、"}, {"type": "subtitle", "time": 11662.55, "timestamp": "03:14:22", "text": "世論調査とか、そういう類のことです。それは"}, {"type": "subtitle", "time": 11664.63, "timestamp": "03:14:24", "text": "アフィリエイトで唯一気に入っているのは"}, {"type": "subtitle", "time": 11668.469, "timestamp": "03:14:28", "text": "Twitch、むしろTwitchのアフィリエイト。"}, {"type": "subtitle", "time": 11670.389, "timestamp": "03:14:30", "text": "そして、"}, {"type": "subtitle", "time": 11672.469, "timestamp": "03:14:32", "text": "人々が"}, {"type": "subtitle", "time": 11674.79, "timestamp": "03:14:34", "text": "始めた"}, {"type": "subtitle", "time": 11677.03, "timestamp": "03:14:37", "text": "ビットを送信して購読するなど、"}, {"type": "subtitle", "time": 11680.309, "timestamp": "03:14:40", "text": "ひどく泣き出した。"}, {"type": "subtitle", "time": 11682.469, "timestamp": "03:14:42", "text": "でも、なぜなんだろう？あなたはとても多くのものを無駄にしています"}, {"type": "subtitle", "time": 11687.11, "timestamp": "03:14:47", "text": "お金は、私のような人がやらないような"}, {"type": "subtitle", "time": 11688.95, "timestamp": "03:14:48", "text": "この支援を受けるに値しないし、"}, {"type": "subtitle", "time": 11692.63, "timestamp": "03:14:52", "text": "すべて。それから私は"}, {"type": "subtitle", "time": 11694.95, "timestamp": "03:14:54", "text": "私の寄付リンクやその他諸々を非表示にする"}, {"type": "subtitle", "time": 11696.87, "timestamp": "03:14:56", "text": "誰も寄付をしないので、"}, {"type": "subtitle", "time": 11699.91, "timestamp": "03:14:59", "text": "いろいろあったけど、どうやら私はできなかった"}]
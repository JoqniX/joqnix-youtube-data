[{"type": "subtitle", "time": 2401.589, "timestamp": "00:40:01", "text": "永遠に。永遠の愛。もっと送ってください。"}, {"type": "subtitle", "time": 2404.55, "timestamp": "00:40:04", "text": "69 効率が良い。何てことだ。うん。こんにちは私の"}, {"type": "subtitle", "time": 2406.71, "timestamp": "00:40:06", "text": "息子。元気ですか？お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 2409.99, "timestamp": "00:40:09", "text": "良い。楽しい休日をお過ごしください。"}, {"type": "subtitle", "time": 2413.109, "timestamp": "00:40:13", "text": "[音楽]"}, {"type": "subtitle", "time": 2421.43, "timestamp": "00:40:21", "text": "彼女が秘密にしていることがすごく怪しい"}, {"type": "subtitle", "time": 2433.71, "timestamp": "00:40:33", "text": "わかった。だから、何か行動を起こさなければならない。えっと、"}, {"type": "subtitle", "time": 2436.069, "timestamp": "00:40:36", "text": "[音楽]"}, {"type": "subtitle", "time": 2438.47, "timestamp": "00:40:38", "text": "ストレスレベルが近い。それでは、"}, {"type": "subtitle", "time": 2450.71, "timestamp": "00:40:50", "text": "もしかしたら、死んだ友達が増えるかもしれない"}, {"type": "subtitle", "time": 2452.39, "timestamp": "00:40:52", "text": "格闘ゲームのストリーミングを開始するが、"}, {"type": "subtitle", "time": 2455.19, "timestamp": "00:40:55", "text": "ストリームのコメントはおそらく超"}, {"type": "subtitle", "time": 2457.109, "timestamp": "00:40:57", "text": "迷惑な。だから、そうではないかもしれない。学習コンポ"}, {"type": "subtitle", "time": 2459.19, "timestamp": "00:40:59", "text": "痛みです。私は平和にガチャをプレイしたい"}]
[{"type": "subtitle", "time": 7500.5, "timestamp": "02:05:00", "text": "またいつか一緒に出かけましょう。おい、"}, {"type": "subtitle", "time": 7503.27, "timestamp": "02:05:03", "text": "[音楽]"}, {"type": "subtitle", "time": 7505.43, "timestamp": "02:05:05", "text": "学校の制服を着て楽しい一日を過ごすために。いいえ"}, {"type": "subtitle", "time": 7508.89, "timestamp": "02:05:08", "text": "実際にどこにいるのか教えてくれる"}, {"type": "subtitle", "time": 7514.55, "timestamp": "02:05:14", "text": "えっと、なんで私の名前は呼ばれなかったの？私は"}, {"type": "subtitle", "time": 7521.35, "timestamp": "02:05:21", "text": "あ、待って、私の好感度は100だ。ああ、"}, {"type": "subtitle", "time": 7524.149, "timestamp": "02:05:24", "text": "神。ほぼ100。え、何だって？なんてこった。は"}, {"type": "subtitle", "time": 7527.27, "timestamp": "02:05:27", "text": "それは悪いことなのか、それとも良いことなのか？"}, {"type": "subtitle", "time": 7528.79, "timestamp": "02:05:28", "text": "えっと、私の友達は本当に怖がっていました"}, {"type": "subtitle", "time": 7530.55, "timestamp": "02:05:30", "text": "ちょっと面白かったけど、鍵がかかってた。話すかもしれない"}, {"type": "subtitle", "time": 7532.39, "timestamp": "02:05:32", "text": "それについては次の課題で取り上げます。"}, {"type": "subtitle", "time": 7535.99, "timestamp": "02:05:35", "text": "けれど。よし、君と僕で。私たちは"}, {"type": "subtitle", "time": 7537.669, "timestamp": "02:05:37", "text": "学校の日付。私たちはまだ"}, {"type": "subtitle", "time": 7543.109, "timestamp": "02:05:43", "text": "若々しい。オフ吸収を見た"}, {"type": "subtitle", "time": 7551.03, "timestamp": "02:05:51", "text": "彼はあなたと一緒に行きたがっています。さあ行こう。"}, {"type": "subtitle", "time": 7558.87, "timestamp": "02:05:58", "text": "ああ、私の秘密のパス。えーと、これは"}]
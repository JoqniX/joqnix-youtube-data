[{"type": "subtitle", "time": 8460.389, "timestamp": "02:21:00", "text": "ずっと両立させていたのか？"}, {"type": "subtitle", "time": 8467.11, "timestamp": "02:21:07", "text": "[音楽]"}, {"type": "subtitle", "time": 8472.99, "timestamp": "02:21:12", "text": "おお。"}, {"type": "subtitle", "time": 8487.91, "timestamp": "02:21:27", "text": "[音楽]"}, {"type": "subtitle", "time": 8491.27, "timestamp": "02:21:31", "text": "なんてこった。なんてこった。なんてこった。"}, {"type": "subtitle", "time": 8493.75, "timestamp": "02:21:33", "text": "なんてこった。いいえ。いいえ。いいえ。"}, {"type": "subtitle", "time": 8495.67, "timestamp": "02:21:35", "text": "あなたは南アフリカのストリーマーのはずですよね。おお"}, {"type": "subtitle", "time": 8497.99, "timestamp": "02:21:37", "text": "我が神よ。ちくしょう。"}, {"type": "subtitle", "time": 8499.51, "timestamp": "02:21:39", "text": "私"}, {"type": "subtitle", "time": 8508.39, "timestamp": "02:21:48", "text": "待って、彼女は何を計画していたの？"}, {"type": "subtitle", "time": 8510.469, "timestamp": "02:21:50", "text": "[音楽]"}, {"type": "subtitle", "time": 8513.429, "timestamp": "02:21:53", "text": "ささやかな報酬を差し上げられるとしたら。"}, {"type": "subtitle", "time": 8515.67, "timestamp": "02:21:55", "text": "ああ、これはまずい。ええ、これが私が"}]
[{"type": "subtitle", "time": 7021.35, "timestamp": "01:57:01", "text": "時々読んでみてください"}, {"type": "subtitle", "time": 7028.95, "timestamp": "01:57:08", "text": "黄色から赤色に変わった。私はそうすべきでしょうか"}, {"type": "subtitle", "time": 7032.47, "timestamp": "01:57:12", "text": "心配ですか？それとも心配していませんか？"}, {"type": "subtitle", "time": 7034.89, "timestamp": "01:57:14", "text": "何てことだ。"}, {"type": "subtitle", "time": 7040.149, "timestamp": "01:57:20", "text": "夜に。よし、夜だ、"}, {"type": "subtitle", "time": 7044.47, "timestamp": "01:57:24", "text": "右？配信するべきだ。私たちはこれをします"}, {"type": "subtitle", "time": 7050.31, "timestamp": "01:57:30", "text": "10万"}, {"type": "subtitle", "time": 7074.55, "timestamp": "01:57:54", "text": "ああ、私たちは「オーケー」を読んでいません。なぜ"}, {"type": "subtitle", "time": 7077.35, "timestamp": "01:57:57", "text": "みんな「can」ってよく言うよね？おいおい、"}]
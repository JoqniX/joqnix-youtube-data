[{"type": "subtitle", "time": 10742.55, "timestamp": "02:59:02", "text": "3Dワールドを作るなど、計画していること"}, {"type": "subtitle", "time": 10744.469, "timestamp": "02:59:04", "text": "みんなと一緒に何かをして、"}, {"type": "subtitle", "time": 10746.79, "timestamp": "02:59:06", "text": "誰もが相互に交流し、移動できる"}, {"type": "subtitle", "time": 10749.349, "timestamp": "02:59:09", "text": "皆さんは参加して交流することができます"}, {"type": "subtitle", "time": 10751.67, "timestamp": "02:59:11", "text": "3D空間にいる私。そうすれば"}, {"type": "subtitle", "time": 10754.309, "timestamp": "02:59:14", "text": "まるで世界がどんな感情を抱いているか"}, {"type": "subtitle", "time": 10757.349, "timestamp": "02:59:17", "text": "音楽関連のベースを構築したい"}, {"type": "subtitle", "time": 10759.75, "timestamp": "02:59:19", "text": "そういうこと全部。でもまた、次のようなものが必要になります"}, {"type": "subtitle", "time": 10761.91, "timestamp": "02:59:21", "text": "それにも検証が必要だ"}, {"type": "subtitle", "time": 10766.15, "timestamp": "02:59:26", "text": "人々が数字を正しく理解できるように"}, {"type": "subtitle", "time": 10769.83, "timestamp": "02:59:29", "text": "あなたを助けることに興味があります"}, {"type": "subtitle", "time": 10772.71, "timestamp": "02:59:32", "text": "プロジェクトベースの作業のようなもの。何が"}, {"type": "subtitle", "time": 10774.309, "timestamp": "02:59:34", "text": "それは、"}, {"type": "subtitle", "time": 10776.07, "timestamp": "02:59:36", "text": "開発のプロは進歩している、または"}, {"type": "subtitle", "time": 10778.15, "timestamp": "02:59:38", "text": "会社か何かで、"}, {"type": "subtitle", "time": 10780.15, "timestamp": "02:59:40", "text": "スポンサーになる、あるいは何か手助けをする"}, {"type": "subtitle", "time": 10782.87, "timestamp": "02:59:42", "text": "お金に関することなど、そういう類のこと"}, {"type": "subtitle", "time": 10785.269, "timestamp": "02:59:45", "text": "再び検証のトピックについて"}, {"type": "subtitle", "time": 10787.269, "timestamp": "02:59:47", "text": "先ほど話したことが関係してくる"}, {"type": "subtitle", "time": 10789.349, "timestamp": "02:59:49", "text": "右"}, {"type": "subtitle", "time": 10792.07, "timestamp": "02:59:52", "text": "検証と数値関連"}, {"type": "subtitle", "time": 10796.389, "timestamp": "02:59:56", "text": "ある意味痛みですね、ああ神様、"}, {"type": "subtitle", "time": 10799.429, "timestamp": "02:59:59", "text": "私がこれを読んだ、私はパンを読んだ"}]
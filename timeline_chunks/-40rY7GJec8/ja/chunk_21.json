[{"type": "subtitle", "time": 1260.71, "timestamp": "00:21:00", "text": "彼女にヘッドパスしてもいいですか？いいえ。"}, {"type": "subtitle", "time": 1264.63, "timestamp": "00:21:04", "text": "明日へ行こう。こんにちは。"}, {"type": "subtitle", "time": 1266.149, "timestamp": "00:21:06", "text": "何をするか？私は"}, {"type": "subtitle", "time": 1267.75, "timestamp": "00:21:07", "text": "Amazonのほしい物リスト。何を置けばいいですか？"}, {"type": "subtitle", "time": 1269.75, "timestamp": "00:21:09", "text": "の上？"}, {"type": "subtitle", "time": 1271.59, "timestamp": "00:21:11", "text": "質の悪い爆弾。"}, {"type": "subtitle", "time": 1273.02, "timestamp": "00:21:13", "text": "何？"}, {"type": "subtitle", "time": 1274.63, "timestamp": "00:21:14", "text": "[音楽]"}, {"type": "subtitle", "time": 1276.23, "timestamp": "00:21:16", "text": "アフロ。待って。いいえ。それは、それは、それは"}, {"type": "subtitle", "time": 1279.19, "timestamp": "00:21:19", "text": "サス。それは怪しい。いいえ。いいえ、18歳にならないでください"}, {"type": "subtitle", "time": 1282.95, "timestamp": "00:21:22", "text": "さらにストリーマーでもある。 1ドルでそう言ってみよう。なぜ"}, {"type": "subtitle", "time": 1286.31, "timestamp": "00:21:26", "text": "18プッシュしたい"}, {"type": "subtitle", "time": 1288.149, "timestamp": "00:21:28", "text": "コスチューム？"}, {"type": "subtitle", "time": 1291.029, "timestamp": "00:21:31", "text": "書きます"}, {"type": "subtitle", "time": 1305.59, "timestamp": "00:21:45", "text": "エモがあまりないのは残念だ"}, {"type": "subtitle", "time": 1309.83, "timestamp": "00:21:49", "text": "絵文字ステッカー。こちらです。"}, {"type": "subtitle", "time": 1313.11, "timestamp": "00:21:53", "text": "つまり、痛みだ。"}, {"type": "subtitle", "time": 1316.47, "timestamp": "00:21:56", "text": "今回は出かけて"}]
[{"type": "subtitle", "time": 16502.789, "timestamp": "04:35:02", "text": "彼女はまだそこにいる。パッチをあげよう。"}, {"type": "subtitle", "time": 16509.029, "timestamp": "04:35:09", "text": "ええと、今から行きます。"}, {"type": "subtitle", "time": 16511.029, "timestamp": "04:35:11", "text": "来る"}, {"type": "subtitle", "time": 16514.07, "timestamp": "04:35:14", "text": "そしてYPストリングがやってきた。何てことだ。 YP"}, {"type": "subtitle", "time": 16516.47, "timestamp": "04:35:16", "text": "やって来た。"}, {"type": "subtitle", "time": 16519.51, "timestamp": "04:35:19", "text": "Valor が「え、何？」ってなったよ。とんでもない。いいえ"}, {"type": "subtitle", "time": 16521.109, "timestamp": "04:35:21", "text": "方法。とんでもない。とんでもない。とんでもない。待って。待って。"}, {"type": "subtitle", "time": 16527.269, "timestamp": "04:35:27", "text": "何？ヴァラー・ランド・チャイナ。待って。"}, {"type": "subtitle", "time": 16529.429, "timestamp": "04:35:29", "text": "待って。何？"}, {"type": "subtitle", "time": 16536.551, "timestamp": "04:35:36", "text": "どれほど大きなことか分かっていますか"}, {"type": "subtitle", "time": 16539.029, "timestamp": "04:35:39", "text": "つまり？右。"}, {"type": "subtitle", "time": 16541.75, "timestamp": "04:35:41", "text": "我慢する。私はずっとヴァリン"}, {"type": "subtitle", "time": 16543.51, "timestamp": "04:35:43", "text": "だった"}, {"type": "subtitle", "time": 16547.349, "timestamp": "04:35:47", "text": "はぁ？ずっと私は"}, {"type": "subtitle", "time": 16551.51, "timestamp": "04:35:51", "text": "バリンは中国で発見された。"}, {"type": "subtitle", "time": 16557.189, "timestamp": "04:35:57", "text": "え、何？ではなぜイーサンは"}]
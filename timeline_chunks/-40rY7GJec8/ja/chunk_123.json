[{"type": "subtitle", "time": 7386.709, "timestamp": "02:03:06", "text": "祝福を、"}, {"type": "subtitle", "time": 7389.75, "timestamp": "02:03:09", "text": "祝福あれ。"}, {"type": "subtitle", "time": 7392.229, "timestamp": "02:03:12", "text": "今日もストリーミング配信していただきありがとうございます。"}, {"type": "subtitle", "time": 7395.75, "timestamp": "02:03:15", "text": "配信していただき、改めてありがとうございました。"}, {"type": "subtitle", "time": 7397.109, "timestamp": "02:03:17", "text": "はぁ？"}, {"type": "subtitle", "time": 7400.47, "timestamp": "02:03:20", "text": "これは彼女にとって16回目の配信です。"}, {"type": "subtitle", "time": 7402.229, "timestamp": "02:03:22", "text": "あるいは何か"}, {"type": "subtitle", "time": 7411.35, "timestamp": "02:03:31", "text": "もし私が微笑んで魂の救済を磨けば、"}, {"type": "subtitle", "time": 7412.87, "timestamp": "02:03:32", "text": "そうすれば私はずっと笑顔でいられます"}, {"type": "subtitle", "time": 7426.47, "timestamp": "02:03:46", "text": "全員を救うことは約束できない。"}, {"type": "subtitle", "time": 7429.589, "timestamp": "02:03:49", "text": "それは嘘だろう。しかし、もし一人が"}, {"type": "subtitle", "time": 7431.35, "timestamp": "02:03:51", "text": "私の存在によって救われるなら、私は"}, {"type": "subtitle", "time": 7433.51, "timestamp": "02:03:53", "text": "聞く価値があると言えるでしょう"}, {"type": "subtitle", "time": 7435.27, "timestamp": "02:03:55", "text": "インターネット。"}, {"type": "subtitle", "time": 7439.109, "timestamp": "02:03:59", "text": "これを見てください。とてもかわいい。"}]
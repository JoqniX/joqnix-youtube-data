[{"type": "subtitle", "time": 9420.95, "timestamp": "02:37:00", "text": "起こる。待って、なぜ私は"}, {"type": "subtitle", "time": 9427.19, "timestamp": "02:37:07", "text": "待って、なぜ私は話しているように感じるのだろう"}, {"type": "subtitle", "time": 9429.75, "timestamp": "02:37:09", "text": "エンジェルみたい？彼女が考えていたのは"}, {"type": "subtitle", "time": 9432.63, "timestamp": "02:37:12", "text": "ああ、なんてことだ、似ている。ああ、"}, {"type": "subtitle", "time": 9435.83, "timestamp": "02:37:15", "text": "ああ、似ているね。うん。"}, {"type": "subtitle", "time": 9438.63, "timestamp": "02:37:18", "text": "ええ、ある意味では似ていますね。"}, {"type": "subtitle", "time": 9442.87, "timestamp": "02:37:22", "text": "でも、そうですね、解決策を見つけなければなりません。"}, {"type": "subtitle", "time": 9446.309, "timestamp": "02:37:26", "text": "いいえ、桃があればいいのに"}, {"type": "subtitle", "time": 9454.87, "timestamp": "02:37:34", "text": "それは良いことですよね？ある意味では。"}, {"type": "subtitle", "time": 9461.03, "timestamp": "02:37:41", "text": "でも、まあ、ある意味では"}, {"type": "subtitle", "time": 9463.03, "timestamp": "02:37:43", "text": "ああ、特に私がそれを知っているときに起こる"}, {"type": "subtitle", "time": 9464.79, "timestamp": "02:37:44", "text": "10時以降はみんな電話してくるみたいだね"}, {"type": "subtitle", "time": 9468.55, "timestamp": "02:37:48", "text": "分。ええ、よくあることです。その"}, {"type": "subtitle", "time": 9470.95, "timestamp": "02:37:50", "text": "なんて痛いんだ"}, {"type": "subtitle", "time": 9473.83, "timestamp": "02:37:53", "text": "何度も何度も。ええ、まさにその通りです。もしも"}, {"type": "subtitle", "time": 9475.67, "timestamp": "02:37:55", "text": "のように"}, {"type": "subtitle", "time": 9477.51, "timestamp": "02:37:57", "text": "私が何か重要なことをしているとき"}, {"type": "subtitle", "time": 9479.91, "timestamp": "02:37:59", "text": "本当に超重要な場合"}]
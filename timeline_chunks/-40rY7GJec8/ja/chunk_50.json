[{"type": "subtitle", "time": 3002.79, "timestamp": "00:50:02", "text": "カメラに映っても大丈夫"}, {"type": "subtitle", "time": 3004.9, "timestamp": "00:50:04", "text": "誤ってフラッシュする。"}, {"type": "subtitle", "time": 3006.15, "timestamp": "00:50:06", "text": "[音楽]"}, {"type": "subtitle", "time": 3007.91, "timestamp": "00:50:07", "text": "なんてこった、"}, {"type": "subtitle", "time": 3011.829, "timestamp": "00:50:11", "text": "絶対にしないでください。おい、"}, {"type": "subtitle", "time": 3015.41, "timestamp": "00:50:15", "text": "君の男になるな。何てことだ。"}, {"type": "subtitle", "time": 3033.75, "timestamp": "00:50:33", "text": "[音楽]"}, {"type": "subtitle", "time": 3035.91, "timestamp": "00:50:35", "text": "あなたは私を愛しているはずなのに。そして"}, {"type": "subtitle", "time": 3037.91, "timestamp": "00:50:37", "text": "あなたは何かをするつもりだ。あなたの体"}, {"type": "subtitle", "time": 3040.069, "timestamp": "00:50:40", "text": "そこへ行く。"}, {"type": "subtitle", "time": 3042.069, "timestamp": "00:50:42", "text": "ああ、あそこに行くよ。"}, {"type": "subtitle", "time": 3043.99, "timestamp": "00:50:43", "text": "うん。うん。私はすべきではない 私はすべきではない"}, {"type": "subtitle", "time": 3045.29, "timestamp": "00:50:45", "text": "それ。うん。"}, {"type": "subtitle", "time": 3052.63, "timestamp": "00:50:52", "text": "考えてくれてありがとう。私たちはこれを実行します。"}]
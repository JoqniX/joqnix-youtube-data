[{"type": "subtitle", "time": 11881.03, "timestamp": "03:18:01", "text": "あなたからの財政支援など、"}, {"type": "subtitle", "time": 11883.51, "timestamp": "03:18:03", "text": "始める段階に達する"}, {"type": "subtitle", "time": 11887.59, "timestamp": "03:18:07", "text": "人々があなたにそうしてくれることを期待する"}, {"type": "subtitle", "time": 11889.91, "timestamp": "03:18:09", "text": "あなたにそうさせてください。意味は、次の1つと同じである"}, {"type": "subtitle", "time": 11892.95, "timestamp": "03:18:12", "text": "ストリームを例に挙げると"}, {"type": "subtitle", "time": 11894.95, "timestamp": "03:18:14", "text": "えっと、次の配信か今日の配信で"}, {"type": "subtitle", "time": 11896.55, "timestamp": "03:18:16", "text": "寄付とか色々あったんだよね？次"}, {"type": "subtitle", "time": 11898.229, "timestamp": "03:18:18", "text": "寄付を期待している日"}, {"type": "subtitle", "time": 11900.229, "timestamp": "03:18:20", "text": "私と次の日、人々は"}, {"type": "subtitle", "time": 11903.03, "timestamp": "03:18:23", "text": "寄付して、そうすれば私は"}, {"type": "subtitle", "time": 11905.59, "timestamp": "03:18:25", "text": "脳は精神的に汚染されるだろう"}, {"type": "subtitle", "time": 11907.99, "timestamp": "03:18:27", "text": "事実、人々は寄付しなければならない"}, {"type": "subtitle", "time": 11909.83, "timestamp": "03:18:29", "text": "お金を稼がなきゃいけないし、そういうこと全部"}, {"type": "subtitle", "time": 11913.51, "timestamp": "03:18:33", "text": "そうしたら何が楽しいんだろう？"}, {"type": "subtitle", "time": 11915.83, "timestamp": "03:18:35", "text": "そう、何が楽しいの？"}, {"type": "subtitle", "time": 11918.95, "timestamp": "03:18:38", "text": "まさに私が話していた通りです"}, {"type": "subtitle", "time": 11922.469, "timestamp": "03:18:42", "text": "さて、この話題についてですが、ゲームでは"}, {"type": "subtitle", "time": 11925.59, "timestamp": "03:18:45", "text": "エンジェルは主に"}, {"type": "subtitle", "time": 11929.19, "timestamp": "03:18:49", "text": "アバのお金で彼女が返済できるように"}, {"type": "subtitle", "time": 11931.99, "timestamp": "03:18:51", "text": "彼女の税金とか、そういうやつだよね？その間"}, {"type": "subtitle", "time": 11936.229, "timestamp": "03:18:56", "text": "彼女は主に自分自身が知っている"}, {"type": "subtitle", "time": 11938.229, "timestamp": "03:18:58", "text": "彼女は100万ドルを手に入れてスーパーを手に入れなければならない"}]
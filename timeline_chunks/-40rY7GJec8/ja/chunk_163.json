[{"type": "subtitle", "time": 9781.03, "timestamp": "02:43:01", "text": "両親"}, {"type": "subtitle", "time": 9783.03, "timestamp": "02:43:03", "text": "そして、この養育費とは何ですか？"}, {"type": "subtitle", "time": 9784.95, "timestamp": "02:43:04", "text": "何か、あるいはシステム、そんな感じのもの"}, {"type": "subtitle", "time": 9786.87, "timestamp": "02:43:06", "text": "右？わからない。私はあまりよく知りません"}, {"type": "subtitle", "time": 9790.71, "timestamp": "02:43:10", "text": "それについて。でも、そう、私は、わあ、"}, {"type": "subtitle", "time": 9793.11, "timestamp": "02:43:13", "text": "18歳になったら家を出ることができます。"}, {"type": "subtitle", "time": 9795.83, "timestamp": "02:43:15", "text": "人生を学ぶようなものだ。"}, {"type": "subtitle", "time": 9799.51, "timestamp": "02:43:19", "text": "それは、すごいですね。そして、私たちにはそれがありません"}, {"type": "subtitle", "time": 9802.79, "timestamp": "02:43:22", "text": "システムはこちらです。"}, {"type": "subtitle", "time": 9805.03, "timestamp": "02:43:25", "text": "ここにはそういうシステムはありません。自由"}, {"type": "subtitle", "time": 9807.349, "timestamp": "02:43:27", "text": "あるいは自由ではなく、もっと"}, {"type": "subtitle", "time": 9810.309, "timestamp": "02:43:30", "text": "人生を探り、その挑戦がいかに困難であるか"}, {"type": "subtitle", "time": 9814.87, "timestamp": "02:43:34", "text": "人生はありのままで、すべてはそうである。"}, {"type": "subtitle", "time": 9817.75, "timestamp": "02:43:37", "text": "ほとんどの人は178歳を過ぎると引っ越していくよ。うん。うん。"}, {"type": "subtitle", "time": 9824.95, "timestamp": "02:43:44", "text": "しかし、ここはそうではない。モーのみ"}, {"type": "subtitle", "time": 9829.269, "timestamp": "02:43:49", "text": "引っ越すだろう。いいえ、ほとんどの人は決してそうは思わないでしょう。"}, {"type": "subtitle", "time": 9832.55, "timestamp": "02:43:52", "text": "ええ、中には絶対に引っ越さない人もいるでしょうね。"}, {"type": "subtitle", "time": 9834.87, "timestamp": "02:43:54", "text": "彼らはまだ両親と一緒にいるだろう"}, {"type": "subtitle", "time": 9837.429, "timestamp": "02:43:57", "text": "結婚後とか色々"}]
[{"type": "subtitle", "time": 4385.99, "timestamp": "01:13:05", "text": "エネルギーが消え去った瞬間にぶつかった。"}, {"type": "subtitle", "time": 4392.07, "timestamp": "01:13:12", "text": "人類は未だに存続している。"}, {"type": "subtitle", "time": 4399.91, "timestamp": "01:13:19", "text": "よし、とりあえずVRBで行こう。餌をあげさせてください"}, {"type": "subtitle", "time": 4402.87, "timestamp": "01:13:22", "text": "犬とか色々忘れちゃったから"}, {"type": "subtitle", "time": 4404.709, "timestamp": "01:13:24", "text": "最近は3Aで配信をしています。"}, {"type": "subtitle", "time": 4407.03, "timestamp": "01:13:27", "text": "右？私はそれを彼らに渡すはずだった"}, {"type": "subtitle", "time": 4411.91, "timestamp": "01:13:31", "text": "食べ物とかそういうものは4時か4時半までに。しかし"}, {"type": "subtitle", "time": 4415.189, "timestamp": "01:13:35", "text": "ああ、全部父に任せておくべきだった"}, {"type": "subtitle", "time": 4420.31, "timestamp": "01:13:40", "text": "時間。そう、BBアカウントのことだよね"}, {"type": "subtitle", "time": 4423.43, "timestamp": "01:13:43", "text": "私はこれをアップロードします、私はこれに切り替えます"}, {"type": "subtitle", "time": 4425.43, "timestamp": "01:13:45", "text": "今"}, {"type": "subtitle", "time": 4428.07, "timestamp": "01:13:48", "text": "聞こえるよ、聞こえるよ、聞こえるよ、そうだよ"}, {"type": "subtitle", "time": 4430.47, "timestamp": "01:13:50", "text": "バックグラウンドミュージックが聞こえます"}, {"type": "subtitle", "time": 4439.59, "timestamp": "01:13:59", "text": "待って。ねえ、私は"}]
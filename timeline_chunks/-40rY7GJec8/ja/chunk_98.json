[{"type": "subtitle", "time": 5880.31, "timestamp": "01:38:00", "text": "私のサイズのファッションはすでにキャンセルされています"}, {"type": "subtitle", "time": 5882.55, "timestamp": "01:38:02", "text": "信頼は高まるだろう。わかった。待って、私は"}, {"type": "subtitle", "time": 5884.2, "timestamp": "01:38:04", "text": "しない"}, {"type": "subtitle", "time": 5895.43, "timestamp": "01:38:15", "text": "[音楽]"}, {"type": "subtitle", "time": 5897.49, "timestamp": "01:38:17", "text": "リンダの苦悩。"}, {"type": "subtitle", "time": 5901.51, "timestamp": "01:38:21", "text": "[音楽]"}, {"type": "subtitle", "time": 5902.57, "timestamp": "01:38:22", "text": "はぁ？"}, {"type": "subtitle", "time": 5907.75, "timestamp": "01:38:27", "text": "[音楽]"}, {"type": "subtitle", "time": 5911.59, "timestamp": "01:38:31", "text": "なるほど、それは新しいですね。私は決して待たない。もし私が"}, {"type": "subtitle", "time": 5913.43, "timestamp": "01:38:33", "text": "そうしてください、"}, {"type": "subtitle", "time": 5916.39, "timestamp": "01:38:36", "text": "私の好感度は低くなるでしょう。うん。うん。"}, {"type": "subtitle", "time": 5918.149, "timestamp": "01:38:38", "text": "うん。私はこれをすべきではない。待って。いいえ、"}, {"type": "subtitle", "time": 5936.149, "timestamp": "01:38:56", "text": "彼らはいつもあなたを心の中に留めています。おお、"}, {"type": "subtitle", "time": 5937.83, "timestamp": "01:38:57", "text": "彼女は多くのものを得た。あ、待って。あ、待って。"}, {"type": "subtitle", "time": 5939.59, "timestamp": "01:38:59", "text": "あ、待って。私たちは正気を失いかけている。おお"}]
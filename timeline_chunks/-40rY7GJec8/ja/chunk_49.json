[{"type": "subtitle", "time": 2947.99, "timestamp": "00:49:07", "text": "待って、でも、ほんの少ししかない"}, {"type": "subtitle", "time": 2952.23, "timestamp": "00:49:12", "text": "少し左寄りですよね？問題ないと思います。"}, {"type": "subtitle", "time": 2954.87, "timestamp": "00:49:14", "text": "彼女の精神状態は重要ですよね？では"}, {"type": "subtitle", "time": 2957.27, "timestamp": "00:49:17", "text": "方法。"}, {"type": "subtitle", "time": 2960.23, "timestamp": "00:49:20", "text": "これをすればいいのでしょうか？わからない。"}, {"type": "subtitle", "time": 2962.39, "timestamp": "00:49:22", "text": "[音楽]"}, {"type": "subtitle", "time": 2965.67, "timestamp": "00:49:25", "text": "77。大きな数字ですね。"}, {"type": "subtitle", "time": 2968.88, "timestamp": "00:49:28", "text": "71. わかった、いいよ。私がやります。"}, {"type": "subtitle", "time": 2974.15, "timestamp": "00:49:34", "text": "[音楽]"}, {"type": "subtitle", "time": 2977.589, "timestamp": "00:49:37", "text": "主にあなたの精神状態はどうですか"}, {"type": "subtitle", "time": 2984.47, "timestamp": "00:49:44", "text": "私は愛している、私は感じる"}, {"type": "subtitle", "time": 2986.309, "timestamp": "00:49:46", "text": "私の頭"}, {"type": "subtitle", "time": 2990.19, "timestamp": "00:49:50", "text": "同じように。何てことだ。さようなら。"}, {"type": "subtitle", "time": 2997.27, "timestamp": "00:49:57", "text": "私はそれを自分の"}, {"type": "subtitle", "time": 2999.03, "timestamp": "00:49:59", "text": "私の服は、ある程度まとめられています。私は思う"}]
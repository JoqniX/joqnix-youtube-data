[{"type": "subtitle", "time": 10081.83, "timestamp": "02:48:01", "text": "人々は彼がどのように"}, {"type": "subtitle", "time": 10084.309, "timestamp": "02:48:04", "text": "彼は謙虚で、返金したかった"}, {"type": "subtitle", "time": 10087.99, "timestamp": "02:48:07", "text": "彼にサブスクリプションなどをプレゼントしてくれた人たち"}, {"type": "subtitle", "time": 10090.23, "timestamp": "02:48:10", "text": "サブを使うような感じですね、サブとかそういうのを"}, {"type": "subtitle", "time": 10092.469, "timestamp": "02:48:12", "text": "そんな風にTwitchしないで"}, {"type": "subtitle", "time": 10094.23, "timestamp": "02:48:14", "text": "ストリーミングに関しては貪欲で、"}, {"type": "subtitle", "time": 10095.59, "timestamp": "02:48:15", "text": "すべて、そう、私が言ったとおりです"}, {"type": "subtitle", "time": 10097.19, "timestamp": "02:48:17", "text": "2種類の人間がいる。"}, {"type": "subtitle", "time": 10099.99, "timestamp": "02:48:19", "text": "それは完全に情熱からであり、それを実行するためのものです。"}, {"type": "subtitle", "time": 10103.75, "timestamp": "02:48:23", "text": "楽しみのため、そして2つ目は"}, {"type": "subtitle", "time": 10105.59, "timestamp": "02:48:25", "text": "えーと"}, {"type": "subtitle", "time": 10107.349, "timestamp": "02:48:27", "text": "待って、ああ、それもそうだけど、私は"}, {"type": "subtitle", "time": 10109.19, "timestamp": "02:48:29", "text": "レックフルについて話す"}, {"type": "subtitle", "time": 10111.03, "timestamp": "02:48:31", "text": "そうしてください。そうそう。うん、あれは"}, {"type": "subtitle", "time": 10113.429, "timestamp": "02:48:33", "text": "良い。はい、"}, {"type": "subtitle", "time": 10115.99, "timestamp": "02:48:35", "text": "その話は知っています。うん。うん。うん。"}, {"type": "subtitle", "time": 10118.63, "timestamp": "02:48:38", "text": "こんにちは、ブラッド。元気ですか？元気ですか"}, {"type": "subtitle", "time": 10120.469, "timestamp": "02:48:40", "text": "何をしているの？うん、"}, {"type": "subtitle", "time": 10122.55, "timestamp": "02:48:42", "text": "あなたはよくやっています。ああ、なんてことだ、"}, {"type": "subtitle", "time": 10124.95, "timestamp": "02:48:44", "text": "アヒルちゃん。"}, {"type": "subtitle", "time": 10126.79, "timestamp": "02:48:46", "text": "うん。わかった。えっと、少し戻さないといけない"}, {"type": "subtitle", "time": 10128.87, "timestamp": "02:48:48", "text": "タバコの中に。"}, {"type": "subtitle", "time": 10132.389, "timestamp": "02:48:52", "text": "私のミスです。私のミスです。"}, {"type": "subtitle", "time": 10134.71, "timestamp": "02:48:54", "text": "全ての人々がパンを分け与えた。与える"}, {"type": "subtitle", "time": 10138.389, "timestamp": "02:48:58", "text": "パン。 A. そうですね、そういうことです"}]
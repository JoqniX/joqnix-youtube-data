[{"type": "subtitle", "time": 6984.87, "timestamp": "01:56:24", "text": "待って、見て、見て。何か見つけた"}, {"type": "subtitle", "time": 6987.189, "timestamp": "01:56:27", "text": "ブロードウェイについて真剣に考えている。最高のゲームだと思う"}, {"type": "subtitle", "time": 6988.55, "timestamp": "01:56:28", "text": "夜にストリーミングを再生するのはホラーだ"}, {"type": "subtitle", "time": 6990.709, "timestamp": "01:56:30", "text": "ゲームだけど、この可愛い男の子は怖がる"}, {"type": "subtitle", "time": 6994.629, "timestamp": "01:56:34", "text": "あまりにも。それらを作るのは簡単すぎた"}, {"type": "subtitle", "time": 6997.589, "timestamp": "01:56:37", "text": "お金を全部ゲームにつぎ込む。だからゲーム"}, {"type": "subtitle", "time": 7000.47, "timestamp": "01:56:40", "text": "挽回する絶好のチャンスだ。"}, {"type": "subtitle", "time": 7002.95, "timestamp": "01:56:42", "text": "きっと私は彼らからそれを搾り取ることができるだろう"}, {"type": "subtitle", "time": 7004.629, "timestamp": "01:56:44", "text": "少し叫んではいるけど。そうではない"}, {"type": "subtitle", "time": 7006.95, "timestamp": "01:56:46", "text": "叫ぶべきことがたくさんあるだろう"}, {"type": "subtitle", "time": 7010.47, "timestamp": "01:56:50", "text": "私は神のファンだから、神のファンでもあるんです。これは、えーと"}, {"type": "subtitle", "time": 7018.31, "timestamp": "01:56:58", "text": "別名 ああ、そうだよ、そうだよ、黄色だってわかってるよ"}]
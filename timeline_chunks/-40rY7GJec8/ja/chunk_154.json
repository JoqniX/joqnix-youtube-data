[{"type": "subtitle", "time": 9240.63, "timestamp": "02:34:00", "text": "そして、最後まで付き合ってくださってありがとうございます。"}, {"type": "subtitle", "time": 9243.67, "timestamp": "02:34:03", "text": "配信を楽しんでいただけたなら幸いです。私は持っています"}, {"type": "subtitle", "time": 9247.27, "timestamp": "02:34:07", "text": "たくさん話して、自分の意見を述べたい"}, {"type": "subtitle", "time": 9249.27, "timestamp": "02:34:09", "text": "各イベント"}, {"type": "subtitle", "time": 9251.59, "timestamp": "02:34:11", "text": "ゲームの中で"}, {"type": "subtitle", "time": 9253.75, "timestamp": "02:34:13", "text": "でも私はそういうことに気を取られすぎていた"}, {"type": "subtitle", "time": 9255.75, "timestamp": "02:34:15", "text": "そして、私は何度も邪魔されました"}, {"type": "subtitle", "time": 9259.67, "timestamp": "02:34:19", "text": "日々、そして今日の配信も"}, {"type": "subtitle", "time": 9261.51, "timestamp": "02:34:21", "text": "どうすればいいのかわからない、例えば"}, {"type": "subtitle", "time": 9265.51, "timestamp": "02:34:25", "text": "ストリーミング時間を減らす"}, {"type": "subtitle", "time": 9268.23, "timestamp": "02:34:28", "text": "ストリーミングを続けることはできないようです"}, {"type": "subtitle", "time": 9271.91, "timestamp": "02:34:31", "text": "昔の私とよく似ている"}, {"type": "subtitle", "time": 9274.79, "timestamp": "02:34:34", "text": "H それは、えっと、なんて言うんだっけ？"}, {"type": "subtitle", "time": 9276.63, "timestamp": "02:34:36", "text": "私の自由は奪われた、あるいは"}, {"type": "subtitle", "time": 9279.19, "timestamp": "02:34:39", "text": "何か。わからない。"}, {"type": "subtitle", "time": 9282.389, "timestamp": "02:34:42", "text": "わからない。たぶんそれは、"}, {"type": "subtitle", "time": 9284.87, "timestamp": "02:34:44", "text": "子供よ、あなたは多くのことを正しく行わなければならない"}, {"type": "subtitle", "time": 9288.15, "timestamp": "02:34:48", "text": "家。つまり、ある種の痛みだ。"}, {"type": "subtitle", "time": 9297.75, "timestamp": "02:34:57", "text": "だから、よく考えてみないと分からない。だから私は"}, {"type": "subtitle", "time": 9299.91, "timestamp": "02:34:59", "text": "私もそうすると思います、私も変えてみます"}]
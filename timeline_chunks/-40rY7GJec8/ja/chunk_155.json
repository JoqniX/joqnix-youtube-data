[{"type": "subtitle", "time": 9302.95, "timestamp": "02:35:02", "text": "来週の時間にしようかな。"}, {"type": "subtitle", "time": 9305.83, "timestamp": "02:35:05", "text": "来週の話をしています。えっと"}, {"type": "subtitle", "time": 9307.51, "timestamp": "02:35:07", "text": "明日まであと2日です"}, {"type": "subtitle", "time": 9310.63, "timestamp": "02:35:10", "text": "1週間ですよね？うん。"}, {"type": "subtitle", "time": 9312.309, "timestamp": "02:35:12", "text": "運動の時間だ。あなたが正しい。えっと、"}, {"type": "subtitle", "time": 9315.27, "timestamp": "02:35:15", "text": "ゲームの自由。つまり、えーと、"}, {"type": "subtitle", "time": 9318.71, "timestamp": "02:35:18", "text": "私について言えば、家族は"}, {"type": "subtitle", "time": 9322.389, "timestamp": "02:35:22", "text": "私は毎日時間を無駄にしているような気がする。"}, {"type": "subtitle", "time": 9324.63, "timestamp": "02:35:24", "text": "私は彼らに、自分が"}, {"type": "subtitle", "time": 9326.309, "timestamp": "02:35:26", "text": "YouTubeやストリーミングなど、"}, {"type": "subtitle", "time": 9329.51, "timestamp": "02:35:29", "text": "自分が何をしているのか分からない。彼らが考えているのは"}, {"type": "subtitle", "time": 9331.75, "timestamp": "02:35:31", "text": "私は、えっと"}, {"type": "subtitle", "time": 9334.87, "timestamp": "02:35:34", "text": "えっと、彼らが考えているのは、私が"}, {"type": "subtitle", "time": 9337.03, "timestamp": "02:35:37", "text": "時間を無駄にしているような"}, {"type": "subtitle", "time": 9338.95, "timestamp": "02:35:38", "text": "インターネットとか色々、だって私は"}, {"type": "subtitle", "time": 9342.79, "timestamp": "02:35:42", "text": "出かけるとき、まるで、まるで"}, {"type": "subtitle", "time": 9345.67, "timestamp": "02:35:45", "text": "エンジェルは、私たちが演じたキャラクターと全く同じだった"}, {"type": "subtitle", "time": 9349.27, "timestamp": "02:35:49", "text": "右に演奏する私"}, {"type": "subtitle", "time": 9352.309, "timestamp": "02:35:52", "text": "彼女と同じように。うん。だから私も同じ"}, {"type": "subtitle", "time": 9354.389, "timestamp": "02:35:54", "text": "そんな感じ。"}, {"type": "subtitle", "time": 9355.91, "timestamp": "02:35:55", "text": "それで"}]
[{"type": "subtitle", "time": 12483.349, "timestamp": "03:28:03", "text": "えーと、考えるとき"}, {"type": "subtitle", "time": 12488.63, "timestamp": "03:28:08", "text": "えっと、またあのことについて考えてるんだけど"}, {"type": "subtitle", "time": 12490.55, "timestamp": "03:28:10", "text": "えっと、"}, {"type": "subtitle", "time": 12493.03, "timestamp": "03:28:13", "text": "ストリーマーになると、"}, {"type": "subtitle", "time": 12495.75, "timestamp": "03:28:15", "text": "新しいことを経験する機会を得る"}, {"type": "subtitle", "time": 12499.269, "timestamp": "03:28:19", "text": "すべてのストリーム、または時間をかけて、ですよね？"}, {"type": "subtitle", "time": 12502.55, "timestamp": "03:28:22", "text": "だからもちろん、次のような経験をするでしょう"}, {"type": "subtitle", "time": 12505.99, "timestamp": "03:28:25", "text": "良い流れ、良い日と悪い日、そして"}, {"type": "subtitle", "time": 12509.83, "timestamp": "03:28:29", "text": "中間のいい日のような中立的な日"}, {"type": "subtitle", "time": 12514.63, "timestamp": "03:28:34", "text": "悪いとかそういう類のことですよね"}, {"type": "subtitle", "time": 12517.349, "timestamp": "03:28:37", "text": "でも正直に言うと、もし私が"}, {"type": "subtitle", "time": 12521.11, "timestamp": "03:28:41", "text": "ストリーミングを始めなかったら、私はそうではなかっただろう"}, {"type": "subtitle", "time": 12523.269, "timestamp": "03:28:43", "text": "私は一生絶対に"}, {"type": "subtitle", "time": 12526.95, "timestamp": "03:28:46", "text": "何か知っていることがあれば、今知っていることは"}, {"type": "subtitle", "time": 12528.469, "timestamp": "03:28:48", "text": "のように"}, {"type": "subtitle", "time": 12531.51, "timestamp": "03:28:51", "text": "文字通りすべて"}, {"type": "subtitle", "time": 12534.71, "timestamp": "03:28:54", "text": "それは何て言うんだっけ？"}, {"type": "subtitle", "time": 12538.07, "timestamp": "03:28:58", "text": "えっと、私はこう考えるんです"}]
[{"type": "subtitle", "time": 6066.47, "timestamp": "01:41:06", "text": "わかった。 66. ストリーミング配信できると思うんだけど、できるよね？"}, {"type": "subtitle", "time": 6068.47, "timestamp": "01:41:08", "text": "うん。"}, {"type": "subtitle", "time": 6071.109, "timestamp": "01:41:11", "text": "もっと減らさなければならない。それは"}, {"type": "subtitle", "time": 6072.45, "timestamp": "01:41:12", "text": "要点。"}, {"type": "subtitle", "time": 6077.83, "timestamp": "01:41:17", "text": "62."}, {"type": "subtitle", "time": 6085.56, "timestamp": "01:41:25", "text": "65歳か。"}, {"type": "subtitle", "time": 6086.709, "timestamp": "01:41:26", "text": "[音楽]"}, {"type": "subtitle", "time": 6107.43, "timestamp": "01:41:47", "text": "病院。よし、タワーを手に入れよう"}, {"type": "subtitle", "time": 6118.11, "timestamp": "01:41:58", "text": "ああ、"}]
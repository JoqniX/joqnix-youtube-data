[{"type": "subtitle", "time": 2161.73, "timestamp": "00:36:01", "text": "また来ます。"}, {"type": "subtitle", "time": 2167.51, "timestamp": "00:36:07", "text": "ああ、大変だ。だから、それは実際には理にかなっている"}, {"type": "subtitle", "time": 2170.23, "timestamp": "00:36:10", "text": "吸血鬼や悪者を倒すために"}, {"type": "subtitle", "time": 2173.51, "timestamp": "00:36:13", "text": "生き物たち。私は最高得点が好きです。"}, {"type": "subtitle", "time": 2177.51, "timestamp": "00:36:17", "text": "私はただ最高のものを目指して行く。"}, {"type": "subtitle", "time": 2181.19, "timestamp": "00:36:21", "text": "待って、私は「オーマイゴッド、彼の英語は」って思う"}, {"type": "subtitle", "time": 2184.41, "timestamp": "00:36:24", "text": "ひどく壊れている。何てことだ。"}, {"type": "subtitle", "time": 2186.55, "timestamp": "00:36:26", "text": "[音楽]"}, {"type": "subtitle", "time": 2188.57, "timestamp": "00:36:28", "text": "H"}, {"type": "subtitle", "time": 2190.31, "timestamp": "00:36:30", "text": "[音楽]"}, {"type": "subtitle", "time": 2192.63, "timestamp": "00:36:32", "text": "うーん、邪悪。よし、プリティスタンドをやろう"}, {"type": "subtitle", "time": 2195.43, "timestamp": "00:36:35", "text": "私にとっては、小さなスリップスリップアップに行くとき"}, {"type": "subtitle", "time": 2196.87, "timestamp": "00:36:36", "text": "そして、いくらか失う。だから、ちょっと怖いんだけど"}, {"type": "subtitle", "time": 2200.55, "timestamp": "00:36:40", "text": "そうしてください。私は本当にダメだ。あなたは賭けました"}, {"type": "subtitle", "time": 2203.03, "timestamp": "00:36:43", "text": "あなたは自分のスキルをすべてどのように活かすか"}, {"type": "subtitle", "time": 2205.91, "timestamp": "00:36:45", "text": "私たちはほとんど話さないだろう。学んだように感じる"}, {"type": "subtitle", "time": 2209.99, "timestamp": "00:36:49", "text": "今回はかなり多かった。はい、確かに。私たちは"}, {"type": "subtitle", "time": 2211.22, "timestamp": "00:36:51", "text": "5.84"}, {"type": "subtitle", "time": 2213.589, "timestamp": "00:36:53", "text": "[音楽]"}, {"type": "subtitle", "time": 2215.589, "timestamp": "00:36:55", "text": "フォロワー。はい、結構です。それはいいです。"}, {"type": "subtitle", "time": 2217.67, "timestamp": "00:36:57", "text": "近い"}]
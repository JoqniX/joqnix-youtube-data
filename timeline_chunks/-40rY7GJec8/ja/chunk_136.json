[{"type": "subtitle", "time": 8160.79, "timestamp": "02:16:00", "text": "でも、私は死にゆく人たちと一緒に行きたくない"}, {"type": "subtitle", "time": 8168.47, "timestamp": "02:16:08", "text": "あの顔を見ると腹が立つ。何てことだ。全て"}, {"type": "subtitle", "time": 8173.27, "timestamp": "02:16:13", "text": "右。私たちの人物は、オーケー、"}, {"type": "subtitle", "time": 8175.109, "timestamp": "02:16:15", "text": "そうではありません"}, {"type": "subtitle", "time": 8178.95, "timestamp": "02:16:18", "text": "良い。我々にできることは、これを終結させることだ。"}, {"type": "subtitle", "time": 8181.589, "timestamp": "02:16:21", "text": "あそこに置いてください。これを上に乗せる"}, {"type": "subtitle", "time": 8183.67, "timestamp": "02:16:23", "text": "そこには。インターネット。"}, {"type": "subtitle", "time": 8185.51, "timestamp": "02:16:25", "text": "[音楽]"}, {"type": "subtitle", "time": 8189.83, "timestamp": "02:16:29", "text": "これは何ですか？必ずそこになければならない"}, {"type": "subtitle", "time": 8192.59, "timestamp": "02:16:32", "text": "世界記録になる"}, {"type": "subtitle", "time": 8194.23, "timestamp": "02:16:34", "text": "[音楽]"}, {"type": "subtitle", "time": 8196.95, "timestamp": "02:16:36", "text": "それでいいよ"}, {"type": "subtitle", "time": 8199.509, "timestamp": "02:16:39", "text": "もし彼らがファッションゼロを休ませたらどうなるだろうか"}, {"type": "subtitle", "time": 8202.709, "timestamp": "02:16:42", "text": "どうなるか見てみたい"}, {"type": "subtitle", "time": 8204.95, "timestamp": "02:16:44", "text": "もし私がファッションゼロを作ったら彼女は"}, {"type": "subtitle", "time": 8211.669, "timestamp": "02:16:51", "text": "そして、彼女がそれを終わらせると確信している"}, {"type": "subtitle", "time": 8215.349, "timestamp": "02:16:55", "text": "軍隊プラス怖い"}, {"type": "subtitle", "time": 8217.669, "timestamp": "02:16:57", "text": "それらでいっぱいだから、とてもいっぱいなんです"}, {"type": "subtitle", "time": 8219.75, "timestamp": "02:16:59", "text": "ネット法について徹底的に調査する"}]
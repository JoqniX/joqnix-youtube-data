[{"type": "subtitle", "time": 16562.15, "timestamp": "04:36:02", "text": "ビリー・ビリーにヴァレラントをプレイする？はぁ？"}, {"type": "subtitle", "time": 16564.31, "timestamp": "04:36:04", "text": "待って、それはビリービリーに反する"}, {"type": "subtitle", "time": 16565.75, "timestamp": "04:36:05", "text": "ルールですよね？待って、それは"}, {"type": "subtitle", "time": 16568.31, "timestamp": "04:36:08", "text": "中国のルールですよね？え、何？"}, {"type": "subtitle", "time": 16571.269, "timestamp": "04:36:11", "text": "はぁ？待って、なぜイーサンはヴァレラントをプレイしたの？"}, {"type": "subtitle", "time": 16573.75, "timestamp": "04:36:13", "text": "ビリー・ビリーについて？何だって？私が見たとき"}, {"type": "subtitle", "time": 16575.67, "timestamp": "04:36:15", "text": "ビリー・ビリーのストリームは、"}, {"type": "subtitle", "time": 16578.39, "timestamp": "04:36:18", "text": "Valerantをプレイ中。"}, {"type": "subtitle", "time": 16580.23, "timestamp": "04:36:20", "text": "それで私は「え、何？」って感じだった。遊ぶことができます"}, {"type": "subtitle", "time": 16581.75, "timestamp": "04:36:21", "text": "ヴァレラント"}, {"type": "subtitle", "time": 16585.269, "timestamp": "04:36:25", "text": "これをストリーミング配信できますか？そして私はそうしました"}, {"type": "subtitle", "time": 16588.07, "timestamp": "04:36:28", "text": "検索したことを覚えている"}, {"type": "subtitle", "time": 16590.949, "timestamp": "04:36:30", "text": "えーと、ビリー・ビリーみたいな感じ。"}, {"type": "subtitle", "time": 16593.109, "timestamp": "04:36:33", "text": "誰もいなかった。ここでのみ彼の配信が行われます"}, {"type": "subtitle", "time": 16595.91, "timestamp": "04:36:35", "text": "ポップアップした。見てみると、ポップアップが表示されました。私は"}, {"type": "subtitle", "time": 16597.75, "timestamp": "04:36:37", "text": "「え、何？」みたいな感じ。しかし私は"}, {"type": "subtitle", "time": 16600.709, "timestamp": "04:36:40", "text": "彼が要求したembuberサーバーは"}, {"type": "subtitle", "time": 16603.51, "timestamp": "04:36:43", "text": "コラボ企画。だから、私は自分の"}]
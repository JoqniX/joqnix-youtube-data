[{"type": "subtitle", "time": 7218.55, "timestamp": "02:00:18", "text": "彼女が現実世界で"}, {"type": "subtitle", "time": 7221.589, "timestamp": "02:00:21", "text": "ペーンが出所したら、彼女は"}, {"type": "subtitle", "time": 7223.669, "timestamp": "02:00:23", "text": "破壊された。"}, {"type": "subtitle", "time": 7225.99, "timestamp": "02:00:25", "text": "誰もが彼女への信頼を失い、"}, {"type": "subtitle", "time": 7233.51, "timestamp": "02:00:33", "text": "事態は悪化の一途を辿るだろう。"}, {"type": "subtitle", "time": 7237.03, "timestamp": "02:00:37", "text": "もしあなたがパラシュートをやっている人なら"}, {"type": "subtitle", "time": 7240.229, "timestamp": "02:00:40", "text": "あなたの恐怖と共に"}, {"type": "subtitle", "time": 7242.55, "timestamp": "02:00:42", "text": "一度あなたのアイドルとしての真実をすべて知ると"}, {"type": "subtitle", "time": 7245.83, "timestamp": "02:00:45", "text": "出てくると、"}, {"type": "subtitle", "time": 7249.35, "timestamp": "02:00:49", "text": "これからどんどん悪化していくから"}, {"type": "subtitle", "time": 7251.669, "timestamp": "02:00:51", "text": "多くの。"}, {"type": "subtitle", "time": 7254.79, "timestamp": "02:00:54", "text": "そして私たちはそれが起こるのを見てきました。"}, {"type": "subtitle", "time": 7256.31, "timestamp": "02:00:56", "text": "右？"}, {"type": "subtitle", "time": 7257.83, "timestamp": "02:00:57", "text": "YouTuberに興味のある人は、"}]
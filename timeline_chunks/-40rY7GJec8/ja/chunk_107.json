[{"type": "subtitle", "time": 6422.149, "timestamp": "01:47:02", "text": "何てことだ。ボインゲーム。きっとあなたは"}, {"type": "subtitle", "time": 6425.6, "timestamp": "01:47:05", "text": "あと5秒で死ぬ。いいえ。"}, {"type": "subtitle", "time": 6435.75, "timestamp": "01:47:15", "text": "私はあれこれやります。"}, {"type": "subtitle", "time": 6437.75, "timestamp": "01:47:17", "text": "触れて破壊すれば誰も残らない"}, {"type": "subtitle", "time": 6440.229, "timestamp": "01:47:20", "text": "生きている。わかった。"}, {"type": "subtitle", "time": 6444.79, "timestamp": "01:47:24", "text": "計画を立てて、一緒に遊んで、疑念を抱く。"}, {"type": "subtitle", "time": 6446.709, "timestamp": "01:47:26", "text": "気に入りましたか？いいえ、それは間違ったコマンドです"}, {"type": "subtitle", "time": 6454.149, "timestamp": "01:47:34", "text": "なぜ私はそれを10回も落としてしまったのだろうか？"}, {"type": "subtitle", "time": 6467.35, "timestamp": "01:47:47", "text": "上流社会"}, {"type": "subtitle", "time": 6478.39, "timestamp": "01:47:58", "text": "FPSが得意な人の中には"}]
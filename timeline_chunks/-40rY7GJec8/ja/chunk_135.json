[{"type": "subtitle", "time": 8101.51, "timestamp": "02:15:01", "text": "何てことだ。ええ、わかってました"}, {"type": "subtitle", "time": 8104.709, "timestamp": "02:15:04", "text": "この男は私にできる。彼らはとても"}, {"type": "subtitle", "time": 8106.39, "timestamp": "02:15:06", "text": "バカ。"}, {"type": "subtitle", "time": 8108.79, "timestamp": "02:15:08", "text": "それは実にひどい行為だ。私もそう出来ればいいけど"}, {"type": "subtitle", "time": 8111.35, "timestamp": "02:15:11", "text": "仕事を続けたいし、できれば"}, {"type": "subtitle", "time": 8112.709, "timestamp": "02:15:12", "text": "彼らの願いを叶えてあげよう。したい"}, {"type": "subtitle", "time": 8114.55, "timestamp": "02:15:14", "text": "ダイヤモンドになって街を破壊する"}, {"type": "subtitle", "time": 8117.99, "timestamp": "02:15:17", "text": "彼ら。彼らは他の悪と戦いたい"}, {"type": "subtitle", "time": 8119.669, "timestamp": "02:15:19", "text": "だから人々は私が良い人だと思っている"}, {"type": "subtitle", "time": 8123.27, "timestamp": "02:15:23", "text": "私はこんな悪いラインだけど"}, {"type": "subtitle", "time": 8126.7, "timestamp": "02:15:26", "text": "そして、密度は半分くらいだ。"}, {"type": "subtitle", "time": 8134.95, "timestamp": "02:15:34", "text": "[音楽]"}, {"type": "subtitle", "time": 8137.109, "timestamp": "02:15:37", "text": "あなたが私の番組を報道していることは知っています。あなたは延期します"}, {"type": "subtitle", "time": 8141.27, "timestamp": "02:15:41", "text": "例えば、どんな訴訟を起こされたいですか？"}, {"type": "subtitle", "time": 8144.069, "timestamp": "02:15:44", "text": "もっと多くの人と話すために。だから、"}, {"type": "subtitle", "time": 8159.03, "timestamp": "02:15:59", "text": "[音楽]"}]
[{"type": "subtitle", "time": 1562.31, "timestamp": "00:26:02", "text": "これを削除した方がいいでしょうか？わからない。"}, {"type": "subtitle", "time": 1566.47, "timestamp": "00:26:06", "text": "そのままにしておきます。彼女は確かにハゲていますね。"}, {"type": "subtitle", "time": 1569.029, "timestamp": "00:26:09", "text": "新しい配信者。"}, {"type": "subtitle", "time": 1574.71, "timestamp": "00:26:14", "text": "つまり、彼女はものすごくエネルギッシュなんです。"}, {"type": "subtitle", "time": 1578.83, "timestamp": "00:26:18", "text": "視聴者数は555人です。何てことだ。"}, {"type": "subtitle", "time": 1581.43, "timestamp": "00:26:21", "text": "[音楽]"}, {"type": "subtitle", "time": 1584.95, "timestamp": "00:26:24", "text": "彼女は私を愛していると言った。いいえ。"}, {"type": "subtitle", "time": 1587.269, "timestamp": "00:26:27", "text": "夢だよ、相棒。"}, {"type": "subtitle", "time": 1595.269, "timestamp": "00:26:35", "text": "知っている。"}, {"type": "subtitle", "time": 1599.83, "timestamp": "00:26:39", "text": "でも、私の話を聞いてください。私は自分のmを保持します。わかりました。"}, {"type": "subtitle", "time": 1602.549, "timestamp": "00:26:42", "text": "幸運を。"}]
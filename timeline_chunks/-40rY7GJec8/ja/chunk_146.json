[{"type": "subtitle", "time": 8762.82, "timestamp": "02:26:02", "text": "これを見てみましょう"}, {"type": "subtitle", "time": 8765.75, "timestamp": "02:26:05", "text": "[音楽]"}, {"type": "subtitle", "time": 8768.15, "timestamp": "02:26:08", "text": "写真"}, {"type": "subtitle", "time": 8771.349, "timestamp": "02:26:11", "text": "醜い。まるで私が本当に"}, {"type": "subtitle", "time": 8775.11, "timestamp": "02:26:15", "text": "ディンマイウーミーは涙とともに解放されました"}, {"type": "subtitle", "time": 8783.11, "timestamp": "02:26:23", "text": "もう私に文句を言ってください。"}, {"type": "subtitle", "time": 8785.429, "timestamp": "02:26:25", "text": "でも私はあなたの治療法が大好きですが、あなたは"}, {"type": "subtitle", "time": 8795.429, "timestamp": "02:26:35", "text": "アゴラント"}, {"type": "subtitle", "time": 8798.79, "timestamp": "02:26:38", "text": "これは何ですか？これは何ですか？何ですか"}, {"type": "subtitle", "time": 8800.63, "timestamp": "02:26:40", "text": "ハプニング？"}, {"type": "subtitle", "time": 8801.83, "timestamp": "02:26:41", "text": "それは怖いですね。奇妙な話だ。の"}, {"type": "subtitle", "time": 8802.95, "timestamp": "02:26:42", "text": "インターネット上にはそういうものが溢れている。それが理由です"}, {"type": "subtitle", "time": 8805.91, "timestamp": "02:26:45", "text": "まるで王様みたいだ。そうそう。これは"}, {"type": "subtitle", "time": 8807.99, "timestamp": "02:26:47", "text": "ネットで一番低いもの。わかった。わかった。わかった。私たちは"}, {"type": "subtitle", "time": 8816.389, "timestamp": "02:26:56", "text": "はぁ。では、次に何をすればいいのでしょうか？"}, {"type": "subtitle", "time": 8817.99, "timestamp": "02:26:57", "text": "そして"}]
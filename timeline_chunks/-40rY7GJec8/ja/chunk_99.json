[{"type": "subtitle", "time": 5943.99, "timestamp": "01:39:03", "text": "我が神よ。なぜ私はそれをクリックしたのだろう？"}, {"type": "subtitle", "time": 5950.72, "timestamp": "01:39:10", "text": "待って。"}, {"type": "subtitle", "time": 5956.87, "timestamp": "01:39:16", "text": "これはそれを可能にする。待って。たぶん私は"}, {"type": "subtitle", "time": 5959.35, "timestamp": "01:39:19", "text": "待って。くだらないコメントを見たい"}, {"type": "subtitle", "time": 5962.55, "timestamp": "01:39:22", "text": "また。多分"}, {"type": "subtitle", "time": 5964.39, "timestamp": "01:39:24", "text": "彼女は他のことに関しては全てうまくやっている"}, {"type": "subtitle", "time": 5967.03, "timestamp": "01:39:27", "text": "彼女について。はぁ？なぜ？なぜ"}, {"type": "subtitle", "time": 5969.669, "timestamp": "01:39:29", "text": "否定的なコメント？何？はい、私のストレス"}, {"type": "subtitle", "time": 5971.669, "timestamp": "01:39:31", "text": "レベル上げがめちゃくちゃになってる。だから私は"}, {"type": "subtitle", "time": 5973.83, "timestamp": "01:39:33", "text": "おそらく"}, {"type": "subtitle", "time": 5983.91, "timestamp": "01:39:43", "text": "72ですよね？"}, {"type": "subtitle", "time": 5991.59, "timestamp": "01:39:51", "text": "まず、私の特別なものを見つけて報告します"}, {"type": "subtitle", "time": 5994.47, "timestamp": "01:39:54", "text": "彼らにとって彼らであるため"}, {"type": "subtitle", "time": 5996.229, "timestamp": "01:39:56", "text": "アイスクリーム"}, {"type": "subtitle", "time": 5999.75, "timestamp": "01:39:59", "text": "まずは意志を固めて、それから手をつなごう"}]
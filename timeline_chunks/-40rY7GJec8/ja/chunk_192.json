[{"type": "subtitle", "time": 11520.469, "timestamp": "03:12:00", "text": "人々は見て、"}, {"type": "subtitle", "time": 11522.71, "timestamp": "03:12:02", "text": "年齢やどのようなコンテンツが提供されるか"}, {"type": "subtitle", "time": 11525.03, "timestamp": "03:12:05", "text": "そして、どのストリームが、ええと、すべて"}, {"type": "subtitle", "time": 11528.389, "timestamp": "03:12:08", "text": "統計に基づいたものですね"}, {"type": "subtitle", "time": 11529.91, "timestamp": "03:12:09", "text": "分析的"}, {"type": "subtitle", "time": 11537.429, "timestamp": "03:12:17", "text": "それらすべてを育てる最良の方法"}, {"type": "subtitle", "time": 11542.389, "timestamp": "03:12:22", "text": "なぜなら私はある時点で"}, {"type": "subtitle", "time": 11545.11, "timestamp": "03:12:25", "text": "数ヶ月前、私は"}, {"type": "subtitle", "time": 11547.03, "timestamp": "03:12:27", "text": "なんて言うんだっけ、下り坂"}, {"type": "subtitle", "time": 11550.469, "timestamp": "03:12:30", "text": "落ち込みモードだったから、私は、私は、私は"}, {"type": "subtitle", "time": 11553.429, "timestamp": "03:12:33", "text": "数字を確認するように言われたので、"}, {"type": "subtitle", "time": 11555.429, "timestamp": "03:12:35", "text": "拒否されて精神的に"}, {"type": "subtitle", "time": 11559.59, "timestamp": "03:12:39", "text": "私に感じさせた状態 仕事と着用者"}, {"type": "subtitle", "time": 11563.03, "timestamp": "03:12:43", "text": "自分がやっていることを楽しんでいないし、"}, {"type": "subtitle", "time": 11566.95, "timestamp": "03:12:46", "text": "そういう類のもの全部。右？だから私は思う"}, {"type": "subtitle", "time": 11569.91, "timestamp": "03:12:49", "text": "それは、えっと"}, {"type": "subtitle", "time": 11572.389, "timestamp": "03:12:52", "text": "それがポイントで、その日が"}, {"type": "subtitle", "time": 11575.03, "timestamp": "03:12:55", "text": "何か行動を起こさなければならないと決心したと思う"}, {"type": "subtitle", "time": 11578.23, "timestamp": "03:12:58", "text": "そして私は大きな隔たりを作りました"}]
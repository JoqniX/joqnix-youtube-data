[{"type": "subtitle", "time": 1330.39, "timestamp": "00:22:10", "text": "[音楽]"}, {"type": "subtitle", "time": 1338.549, "timestamp": "00:22:18", "text": "実は、外に出るのが大好きなんです。はい、"}, {"type": "subtitle", "time": 1352.549, "timestamp": "00:22:32", "text": "でも、何が変か分かる？すべての"}, {"type": "subtitle", "time": 1354.39, "timestamp": "00:22:34", "text": "おい、あいつらはオタクだ"}, {"type": "subtitle", "time": 1356.63, "timestamp": "00:22:36", "text": "ちょっと違うけど、女の子はたくさん"}, {"type": "subtitle", "time": 1358.549, "timestamp": "00:22:38", "text": "それらはとてもきれいです。"}, {"type": "subtitle", "time": 1360.87, "timestamp": "00:22:40", "text": "歌カフェと呼ばれる場所で働いたり、"}, {"type": "subtitle", "time": 1364.23, "timestamp": "00:22:44", "text": "何らかの形で、あるいは彼らはインディーズです"}, {"type": "subtitle", "time": 1370.23, "timestamp": "00:22:50", "text": "アイデア。得る"}, {"type": "subtitle", "time": 1371.75, "timestamp": "00:22:51", "text": "今回は試合を配信します。いくつか買いました"}, {"type": "subtitle", "time": 1373.669, "timestamp": "00:22:53", "text": "昔からのゲーマーが喜ぶようなゲーム。"}, {"type": "subtitle", "time": 1375.27, "timestamp": "00:22:55", "text": "結局、彼らは"}, {"type": "subtitle", "time": 1378.07, "timestamp": "00:22:58", "text": "世代が変われば、彼らは飛び立つだろう。ラウオ。"}]
[{"type": "subtitle", "time": 10020.63, "timestamp": "02:47:00", "text": "そう、困っている配信者を見るような感じ"}, {"type": "subtitle", "time": 10023.59, "timestamp": "02:47:03", "text": "エンジェルが正しいことをしていたように"}, {"type": "subtitle", "time": 10025.67, "timestamp": "02:47:05", "text": "100万人の登録者を希望"}, {"type": "subtitle", "time": 10027.67, "timestamp": "02:47:07", "text": "などなど。彼女は貪欲で貪欲で"}, {"type": "subtitle", "time": 10029.19, "timestamp": "02:47:09", "text": "よく深い"}, {"type": "subtitle", "time": 10032.15, "timestamp": "02:47:12", "text": "などなど、そうですよね？"}, {"type": "subtitle", "time": 10035.11, "timestamp": "02:47:15", "text": "もう寝た方がいいよ、坊や。うん。うん。私"}, {"type": "subtitle", "time": 10038.79, "timestamp": "02:47:18", "text": "必要だけど、今日はたくさん寝たから、"}, {"type": "subtitle", "time": 10041.59, "timestamp": "02:47:21", "text": "でも、そう思うかもしれない。うん。私"}, {"type": "subtitle", "time": 10044.95, "timestamp": "02:47:24", "text": "休息が必要だ。それで、"}, {"type": "subtitle", "time": 10047.349, "timestamp": "02:47:27", "text": "2020年に活躍したTwitchストリーマーの一人。"}, {"type": "subtitle", "time": 10049.83, "timestamp": "02:47:29", "text": "うん。うん。うん。私はそれを覚えています。の"}, {"type": "subtitle", "time": 10052.71, "timestamp": "02:47:32", "text": "ストリーマーの女の子が尋ねた"}, {"type": "subtitle", "time": 10056.71, "timestamp": "02:47:36", "text": "お金を寄付したいのですが、なぜできないのですか？"}, {"type": "subtitle", "time": 10059.269, "timestamp": "02:47:39", "text": "少なくとも10ドル寄付すれば、視聴できます"}, {"type": "subtitle", "time": 10061.59, "timestamp": "02:47:41", "text": "無料で私にくれるとか、そういうことだよね"}, {"type": "subtitle", "time": 10063.59, "timestamp": "02:47:43", "text": "そして比較すると"}, {"type": "subtitle", "time": 10067.51, "timestamp": "02:47:47", "text": "その男性と男性の間で"}, {"type": "subtitle", "time": 10069.75, "timestamp": "02:47:49", "text": "木彫りをしていたストリーマーと"}, {"type": "subtitle", "time": 10073.91, "timestamp": "02:47:53", "text": "大統領でさえ"}, {"type": "subtitle", "time": 10076.07, "timestamp": "02:47:56", "text": "副大統領か何かがやって来た"}, {"type": "subtitle", "time": 10079.59, "timestamp": "02:47:59", "text": "彼らに会うとか、そういうこととか、"}]
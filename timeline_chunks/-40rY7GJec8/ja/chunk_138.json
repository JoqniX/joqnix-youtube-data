[{"type": "subtitle", "time": 8283.75, "timestamp": "02:18:03", "text": "そしてジンは「うん」と答えた。うん。私はこう言いたかったのです"}, {"type": "subtitle", "time": 8286.629, "timestamp": "02:18:06", "text": "彼女が"}, {"type": "subtitle", "time": 8289.75, "timestamp": "02:18:09", "text": "覚えてる？セクシーな"}, {"type": "subtitle", "time": 8292.87, "timestamp": "02:18:12", "text": "ストリームですよね？私はそのことをやった。私にさせて"}, {"type": "subtitle", "time": 8294.79, "timestamp": "02:18:14", "text": "言っておくけど、待って"}, {"type": "subtitle", "time": 8297.19, "timestamp": "02:18:17", "text": "流れの中で。このセクシーなストリームもご覧ください。"}, {"type": "subtitle", "time": 8298.87, "timestamp": "02:18:18", "text": "右？"}, {"type": "subtitle", "time": 8303.03, "timestamp": "02:18:23", "text": "4か5にすれば"}, {"type": "subtitle", "time": 8305.429, "timestamp": "02:18:25", "text": "そうすれば、それが最速のハイになります"}, {"type": "subtitle", "time": 8308.95, "timestamp": "02:18:28", "text": "愛情を減らす方法"}, {"type": "subtitle", "time": 8317.669, "timestamp": "02:18:37", "text": "それは彼女が失うもののようなものになるでしょう"}, {"type": "subtitle", "time": 8320.15, "timestamp": "02:18:40", "text": "感情的なサポートを失い、信頼を失い、"}, {"type": "subtitle", "time": 8323.83, "timestamp": "02:18:43", "text": "希望、そしてどんなことでも"}, {"type": "subtitle", "time": 8327.429, "timestamp": "02:18:47", "text": "彼女が私の話を聞いてくれるようにしてくれる"}, {"type": "subtitle", "time": 8329.669, "timestamp": "02:18:49", "text": "そして彼女はあらゆるものを壊してしまう"}, {"type": "subtitle", "time": 8333.03, "timestamp": "02:18:53", "text": "内側から、彼女はいずれ気づくでしょう"}, {"type": "subtitle", "time": 8335.589, "timestamp": "02:18:55", "text": "コメントと"}, {"type": "subtitle", "time": 8338.549, "timestamp": "02:18:58", "text": "どうなるか見てみたいけど"}]
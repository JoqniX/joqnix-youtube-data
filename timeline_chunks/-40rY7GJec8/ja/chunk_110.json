[{"type": "subtitle", "time": 6620.47, "timestamp": "01:50:20", "text": "待って、配信に遅延があるの？の上"}, {"type": "subtitle", "time": 6627.68, "timestamp": "01:50:27", "text": "待って。"}, {"type": "subtitle", "time": 6635.35, "timestamp": "01:50:35", "text": "[音楽]"}, {"type": "subtitle", "time": 6637.189, "timestamp": "01:50:37", "text": "あなたたち誰も、ああ、彼女は"}, {"type": "subtitle", "time": 6638.95, "timestamp": "01:50:38", "text": "そちらの方向へ行った。あの道。いいえ、それは"}, {"type": "subtitle", "time": 6654.31, "timestamp": "01:50:54", "text": "私は大ファンです。"}, {"type": "subtitle", "time": 6656.79, "timestamp": "01:50:56", "text": "ええ、彼女は確かにフォロワー1000人を達成しました。"}]
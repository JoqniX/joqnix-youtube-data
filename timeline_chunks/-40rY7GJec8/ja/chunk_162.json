[{"type": "subtitle", "time": 9722.15, "timestamp": "02:42:02", "text": "いいね、また、もしあなたが気に入ったら"}, {"type": "subtitle", "time": 9725.19, "timestamp": "02:42:05", "text": "ピチャンやエンジェルのようなゲームも"}, {"type": "subtitle", "time": 9727.27, "timestamp": "02:42:07", "text": "そこですよね？二人は一緒に引っ越した。"}, {"type": "subtitle", "time": 9729.51, "timestamp": "02:42:09", "text": "右？まるで、"}, {"type": "subtitle", "time": 9731.51, "timestamp": "02:42:11", "text": "人間関係の問題と"}, {"type": "subtitle", "time": 9735.59, "timestamp": "02:42:15", "text": "そういうものすべて。動いてみてください"}, {"type": "subtitle", "time": 9744.389, "timestamp": "02:42:24", "text": "私も引っ越しは私の"}, {"type": "subtitle", "time": 9747.429, "timestamp": "02:42:27", "text": "一番の夢のフレームは、たぶんわからない"}, {"type": "subtitle", "time": 9751.19, "timestamp": "02:42:31", "text": "自由気味だけど、私が思うように"}, {"type": "subtitle", "time": 9756.469, "timestamp": "02:42:36", "text": "それについて私はしたいけど、"}, {"type": "subtitle", "time": 9759.67, "timestamp": "02:42:39", "text": "子供の頃は好きじゃなかったと思う"}, {"type": "subtitle", "time": 9762.95, "timestamp": "02:42:42", "text": "アメリカ人か、"}, {"type": "subtitle", "time": 9767.03, "timestamp": "02:42:47", "text": "外部のシステムのようなもの"}, {"type": "subtitle", "time": 9769.99, "timestamp": "02:42:49", "text": "アメリカでは大きな問題だと思うし、"}, {"type": "subtitle", "time": 9771.67, "timestamp": "02:42:51", "text": "もの。それが本当かどうかはわかりませんが、"}, {"type": "subtitle", "time": 9774.15, "timestamp": "02:42:54", "text": "わからない。でも、18歳になったら"}, {"type": "subtitle", "time": 9776.469, "timestamp": "02:42:56", "text": "物、人々、ほとんどの十代の若者、または"}, {"type": "subtitle", "time": 9778.15, "timestamp": "02:42:58", "text": "若者はただ家を出ていくだけですよね？そして"}, {"type": "subtitle", "time": 9779.349, "timestamp": "02:42:59", "text": "彼らは自分の"}]
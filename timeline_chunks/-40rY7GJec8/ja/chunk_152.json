[{"type": "subtitle", "time": 9125.75, "timestamp": "02:32:05", "text": "[音楽]"}, {"type": "subtitle", "time": 9127.03, "timestamp": "02:32:07", "text": "付与"}, {"type": "subtitle", "time": 9128.309, "timestamp": "02:32:08", "text": "[音楽]"}, {"type": "subtitle", "time": 9129.82, "timestamp": "02:32:09", "text": "任務に取り掛かる。"}, {"type": "subtitle", "time": 9139.67, "timestamp": "02:32:19", "text": "私の写真。"}, {"type": "subtitle", "time": 9143.19, "timestamp": "02:32:23", "text": "ああ、写真をいくつか記録したよ"}, {"type": "subtitle", "time": 9145.5, "timestamp": "02:32:25", "text": "こちらです。右、"}, {"type": "subtitle", "time": 9148.389, "timestamp": "02:32:28", "text": "[音楽]"}, {"type": "subtitle", "time": 9150.309, "timestamp": "02:32:30", "text": "これらは私がロックを解除したファイルです。"}, {"type": "subtitle", "time": 9154.23, "timestamp": "02:32:34", "text": "今日の配信でこれをアンロックしました。"}, {"type": "subtitle", "time": 9156.36, "timestamp": "02:32:36", "text": "なんて可愛いんでしょう。"}, {"type": "subtitle", "time": 9158.95, "timestamp": "02:32:38", "text": "[音楽]"}, {"type": "subtitle", "time": 9162.0, "timestamp": "02:32:42", "text": "コントロールパネル。"}, {"type": "subtitle", "time": 9164.389, "timestamp": "02:32:44", "text": "[音楽]"}, {"type": "subtitle", "time": 9171.27, "timestamp": "02:32:51", "text": "私の配信の1分間は全部私のクソみたいな時間です。"}, {"type": "subtitle", "time": 9176.55, "timestamp": "02:32:56", "text": "私はそれを試す必要はなかった。永遠には続かない。"}, {"type": "subtitle", "time": 9178.71, "timestamp": "02:32:58", "text": "わかった。では、これを保存して終了するにはどうすればいいですか？"}]
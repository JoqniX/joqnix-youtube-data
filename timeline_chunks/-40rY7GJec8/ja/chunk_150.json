[{"type": "subtitle", "time": 9013.11, "timestamp": "02:30:13", "text": "[音楽]"}, {"type": "subtitle", "time": 9015.33, "timestamp": "02:30:15", "text": "熱。熱。N."}, {"type": "subtitle", "time": 9048.469, "timestamp": "02:30:48", "text": "[音楽]"}, {"type": "subtitle", "time": 9049.91, "timestamp": "02:30:49", "text": "戻ってくる。戻ってくる。戻ってくる。来る"}, {"type": "subtitle", "time": 9051.11, "timestamp": "02:30:51", "text": "戻る。"}, {"type": "subtitle", "time": 9052.79, "timestamp": "02:30:52", "text": "私は何回"}, {"type": "subtitle", "time": 9054.95, "timestamp": "02:30:54", "text": "中断されましたか？"}, {"type": "subtitle", "time": 9059.75, "timestamp": "02:30:59", "text": "何？そして私は"}]
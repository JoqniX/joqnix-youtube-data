[{"type": "subtitle", "time": 6008.47, "timestamp": "01:40:08", "text": "ああ、なんてことだ、ちょっと大変なことになってる"}, {"type": "subtitle", "time": 6011.75, "timestamp": "01:40:11", "text": "私は彼女に悪い人になってほしくないので、"}, {"type": "subtitle", "time": 6025.75, "timestamp": "01:40:25", "text": "えっと、目が覚めたら太陽がすでに"}, {"type": "subtitle", "time": 6028.229, "timestamp": "01:40:28", "text": "設定。後遺症で頭がぼんやりする。できますか"}, {"type": "subtitle", "time": 6031.669, "timestamp": "01:40:31", "text": "ただ寝るだけ？もちろん。"}, {"type": "subtitle", "time": 6033.43, "timestamp": "01:40:33", "text": "うん。うん。"}, {"type": "subtitle", "time": 6037.35, "timestamp": "01:40:37", "text": "今度は、明かりを灯して生計を立てたい。"}, {"type": "subtitle", "time": 6042.07, "timestamp": "01:40:42", "text": "いいえ、私は"}, {"type": "subtitle", "time": 6053.34, "timestamp": "01:40:53", "text": "あなたはどうですか？"}, {"type": "subtitle", "time": 6055.99, "timestamp": "01:40:55", "text": "[音楽]"}]
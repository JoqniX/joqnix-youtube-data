[{"type": "subtitle", "time": 13981.83, "timestamp": "03:53:01", "text": "2番目も最善を尽くしていますが"}, {"type": "subtitle", "time": 13985.429, "timestamp": "03:53:05", "text": "それでも以前と同じ感じはしない、"}, {"type": "subtitle", "time": 13987.03, "timestamp": "03:53:07", "text": "そんな感じ。そう、そんな感じ"}, {"type": "subtitle", "time": 13990.15, "timestamp": "03:53:10", "text": "感じた、感じた"}, {"type": "subtitle", "time": 13992.07, "timestamp": "03:53:12", "text": "だから私はあの謝罪をしたのだと思う"}, {"type": "subtitle", "time": 13995.75, "timestamp": "03:53:15", "text": "4月中にツイートで弁明"}, {"type": "subtitle", "time": 14000.07, "timestamp": "03:53:20", "text": "今年の5月期。うん、うん、うん。"}, {"type": "subtitle", "time": 14002.63, "timestamp": "03:53:22", "text": "私はそれが好きです"}, {"type": "subtitle", "time": 14004.15, "timestamp": "03:53:24", "text": "男。正直に言うと、"}, {"type": "subtitle", "time": 14006.55, "timestamp": "03:53:26", "text": "このゲームのために多くのものが必要"}, {"type": "subtitle", "time": 14009.429, "timestamp": "03:53:29", "text": "ストリーム終了。何てことだ。おお。"}, {"type": "subtitle", "time": 14011.349, "timestamp": "03:53:31", "text": "つまり、ある意味では、"}, {"type": "subtitle", "time": 14014.55, "timestamp": "03:53:34", "text": "少しだけ、どれくらい"}, {"type": "subtitle", "time": 14016.469, "timestamp": "03:53:36", "text": "それは何て言うんだっけ？苦労はするが"}, {"type": "subtitle", "time": 14019.03, "timestamp": "03:53:39", "text": "私はこれらが"}, {"type": "subtitle", "time": 14022.309, "timestamp": "03:53:42", "text": "苦労するかどうかは別として、でもほら、"}, {"type": "subtitle", "time": 14025.75, "timestamp": "03:53:45", "text": "感じる人"}, {"type": "subtitle", "time": 14028.55, "timestamp": "03:53:48", "text": "うーん、もっと苦労しているのは大手ストリーマーたちです。"}, {"type": "subtitle", "time": 14030.95, "timestamp": "03:53:50", "text": "彼らは多くの困難を経験する傾向がある。彼らは持っている"}, {"type": "subtitle", "time": 14034.07, "timestamp": "03:53:54", "text": "好きにしてください、お願いします、私は好きです、試してください"}, {"type": "subtitle", "time": 14036.389, "timestamp": "03:53:56", "text": "彼らは最善を尽くして"}, {"type": "subtitle", "time": 14038.87, "timestamp": "03:53:58", "text": "視聴者は否定的な反応を示さず、休憩も取らない。"}]
[{"type": "subtitle", "time": 7740.55, "timestamp": "02:09:00", "text": "ブー。"}, {"type": "subtitle", "time": 7765.83, "timestamp": "02:09:25", "text": "[音楽]"}, {"type": "subtitle", "time": 7767.189, "timestamp": "02:09:27", "text": "はい、戻ってきました。戻ってきました。戻ってきました。私は"}, {"type": "subtitle", "time": 7769.07, "timestamp": "02:09:29", "text": "本当に本当にごめんなさい。"}, {"type": "subtitle", "time": 7771.03, "timestamp": "02:09:31", "text": "[音楽]"}, {"type": "subtitle", "time": 7773.43, "timestamp": "02:09:33", "text": "わかった。えっと、もう一度やってみましょうか？さあ"}, {"type": "subtitle", "time": 7776.069, "timestamp": "02:09:36", "text": "何が起こるか見てみましょう。"}, {"type": "subtitle", "time": 7778.71, "timestamp": "02:09:38", "text": "何が起こるか見てみたい。それで、"}, {"type": "subtitle", "time": 7780.629, "timestamp": "02:09:40", "text": "[音楽]"}, {"type": "subtitle", "time": 7783.83, "timestamp": "02:09:43", "text": "えっと、私のストレスレベルはどれくらいだったっけ？ 22. 私"}, {"type": "subtitle", "time": 7785.669, "timestamp": "02:09:45", "text": "何が起こるか見てみたい。見てみましょう"}, {"type": "subtitle", "time": 7787.43, "timestamp": "02:09:47", "text": "起こる。それは良いことなのか、悪いことなのか？私"}, {"type": "subtitle", "time": 7788.73, "timestamp": "02:09:48", "text": "わからない。"}]
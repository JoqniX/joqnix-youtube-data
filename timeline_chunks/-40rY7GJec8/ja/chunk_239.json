[{"type": "subtitle", "time": 14340.229, "timestamp": "03:59:00", "text": "[音楽]"}, {"type": "subtitle", "time": 14342.389, "timestamp": "03:59:02", "text": "ジョックにはダークバージョンもあるが、"}, {"type": "subtitle", "time": 14346.07, "timestamp": "03:59:06", "text": "公にはしない"}, {"type": "subtitle", "time": 14347.75, "timestamp": "03:59:07", "text": "まだ入手可能です。"}, {"type": "subtitle", "time": 14351.189, "timestamp": "03:59:11", "text": "でも、私が漏らしてしまったんです。何てことだ。"}, {"type": "subtitle", "time": 14354.229, "timestamp": "03:59:14", "text": "なぜ私はそれを移動させたのか？ええ、ジョーは"}, {"type": "subtitle", "time": 14357.11, "timestamp": "03:59:17", "text": "ダークバージョン。でも、私は遊んでいるようなもの"}, {"type": "subtitle", "time": 14359.67, "timestamp": "03:59:19", "text": "周りに"}, {"type": "subtitle", "time": 14363.03, "timestamp": "03:59:23", "text": "でも、ある意味、私は遊んでいるんです"}, {"type": "subtitle", "time": 14366.469, "timestamp": "03:59:26", "text": "えっと、なんて言うんでしたっけ？"}, {"type": "subtitle", "time": 14369.429, "timestamp": "03:59:29", "text": "ええ、主に遊んでいます"}, {"type": "subtitle", "time": 14370.95, "timestamp": "03:59:30", "text": "えーと"}, {"type": "subtitle", "time": 14373.429, "timestamp": "03:59:33", "text": "それは何と呼ばれますか？"}, {"type": "subtitle", "time": 14376.309, "timestamp": "03:59:36", "text": "ええ、正直に言うと。ええ、主にプレイしています"}, {"type": "subtitle", "time": 14379.75, "timestamp": "03:59:39", "text": "下半身の周りをうろついているのは、"}, {"type": "subtitle", "time": 14382.95, "timestamp": "03:59:42", "text": "あなたが考えなければならないこと、私は"}, {"type": "subtitle", "time": 14385.11, "timestamp": "03:59:45", "text": "今まで"}, {"type": "subtitle", "time": 14388.95, "timestamp": "03:59:48", "text": "生涯で一度も書いたことがないか、"}, {"type": "subtitle", "time": 14393.11, "timestamp": "03:59:53", "text": "本を書くとか、物語を書くとか、何でもいいから書いてください。"}, {"type": "subtitle", "time": 14395.99, "timestamp": "03:59:55", "text": "うん、何か作らなきゃ"}, {"type": "subtitle", "time": 14398.79, "timestamp": "03:59:58", "text": "チェンソーマンシリーズのように面白い"}]
[{"type": "subtitle", "time": 301.51, "timestamp": "00:05:01", "text": "なぜクリックしてしまったのだろう？ああ、"}, {"type": "subtitle", "time": 304.23, "timestamp": "00:05:04", "text": "一晩中夜を過ごす"}, {"type": "subtitle", "time": 306.629, "timestamp": "00:05:06", "text": "パラダイス。"}, {"type": "subtitle", "time": 309.27, "timestamp": "00:05:09", "text": "私は毎晩Kエンジェルに祈りを捧げます。彼女は私の"}, {"type": "subtitle", "time": 311.909, "timestamp": "00:05:11", "text": "女神。何てことだ。"}, {"type": "subtitle", "time": 316.71, "timestamp": "00:05:16", "text": "それがシンプと呼ばれる人たちの言い方ですか。ああ、なんてことだ。"}, {"type": "subtitle", "time": 319.749, "timestamp": "00:05:19", "text": "私たちのデートは10点満点中10点です。覇気は"}, {"type": "subtitle", "time": 321.11, "timestamp": "00:05:21", "text": "とても楽しい。多くの人が"}, {"type": "subtitle", "time": 323.189, "timestamp": "00:05:23", "text": "ドレッシングも"}, {"type": "subtitle", "time": 327.029, "timestamp": "00:05:27", "text": "しかし、それは特徴だ。うんうん。 A. では、"}, {"type": "subtitle", "time": 329.029, "timestamp": "00:05:29", "text": "カード選びを手伝ってくれました。えっと、私は行く"}, {"type": "subtitle", "time": 331.029, "timestamp": "00:05:31", "text": "自分の鼻にどれだけ良いかを見せつけるために"}, {"type": "subtitle", "time": 335.189, "timestamp": "00:05:35", "text": "今夜。かわいい"}, {"type": "subtitle", "time": 338.07, "timestamp": "00:05:38", "text": "外出するロリーゴール。ああ、頑張ってみます"}, {"type": "subtitle", "time": 340.95, "timestamp": "00:05:40", "text": "アウトロリーゴリータ。ああ、それは"}, {"type": "subtitle", "time": 344.68, "timestamp": "00:05:44", "text": "もう夜だ。え、何？"}, {"type": "subtitle", "time": 346.629, "timestamp": "00:05:46", "text": "[音楽]"}, {"type": "subtitle", "time": 348.23, "timestamp": "00:05:48", "text": "他の場所に行った方がいいでしょうか？"}, {"type": "subtitle", "time": 353.35, "timestamp": "00:05:53", "text": "女の子たちと争う価値はない"}, {"type": "subtitle", "time": 356.31, "timestamp": "00:05:56", "text": "行く？"}]
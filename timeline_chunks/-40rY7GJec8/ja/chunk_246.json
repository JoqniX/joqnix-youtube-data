[{"type": "subtitle", "time": 14761.03, "timestamp": "04:06:01", "text": "それについて考えることができるし、"}, {"type": "subtitle", "time": 14763.189, "timestamp": "04:06:03", "text": "それは私に執筆のインスピレーションを与えてくれるだろう"}, {"type": "subtitle", "time": 14766.309, "timestamp": "04:06:06", "text": "そして、自分のやりたいこともやるよね？"}, {"type": "subtitle", "time": 14769.11, "timestamp": "04:06:09", "text": "こんな感じ"}, {"type": "subtitle", "time": 14772.07, "timestamp": "04:06:12", "text": "だって私は助けを求めている人間だから"}, {"type": "subtitle", "time": 14774.79, "timestamp": "04:06:14", "text": "でも、私が作ったから、私はそれをやらない。"}, {"type": "subtitle", "time": 14778.07, "timestamp": "04:06:18", "text": "私は、そう、私は"}, {"type": "subtitle", "time": 14780.469, "timestamp": "04:06:20", "text": "行き詰まった時は助けを求める。立ち往生、"}, {"type": "subtitle", "time": 14784.229, "timestamp": "04:06:24", "text": "完全に詰まってしまって、途方に暮れています。もし私が"}, {"type": "subtitle", "time": 14785.91, "timestamp": "04:06:25", "text": "本当に本当に助けが必要です、私はいつも"}, {"type": "subtitle", "time": 14788.309, "timestamp": "04:06:28", "text": "誰かに連絡を取ってみてください。だから私は"}, {"type": "subtitle", "time": 14790.55, "timestamp": "04:06:30", "text": "私は自分が学んでいることをすべて行っています"}, {"type": "subtitle", "time": 14793.67, "timestamp": "04:06:33", "text": "次のような技術的なことをすべて学びます。"}, {"type": "subtitle", "time": 14796.229, "timestamp": "04:06:36", "text": "そういう歌を全部歌ったりして、"}, {"type": "subtitle", "time": 14799.11, "timestamp": "04:06:39", "text": "自分にそれをさせ、それをさせ、そして"}, {"type": "subtitle", "time": 14801.67, "timestamp": "04:06:41", "text": "自分の方が良くなった。そしてもし私が行き詰まったら、"}, {"type": "subtitle", "time": 14804.55, "timestamp": "04:06:44", "text": "誰かに助けを求めたり、いろいろ頼んだりするだろう。"}, {"type": "subtitle", "time": 14807.11, "timestamp": "04:06:47", "text": "うん。うん。うん。"}, {"type": "subtitle", "time": 14809.349, "timestamp": "04:06:49", "text": "いくつか見落とした部分があると思うんだけど、そうだよね？"}, {"type": "subtitle", "time": 14811.11, "timestamp": "04:06:51", "text": "そして今日の配信は、"}, {"type": "subtitle", "time": 14813.99, "timestamp": "04:06:53", "text": "私が話していたトピックをいくつか見逃しました"}, {"type": "subtitle", "time": 14817.269, "timestamp": "04:06:57", "text": "ちょっと話が逸れてしまったので"}, {"type": "subtitle", "time": 14819.99, "timestamp": "04:06:59", "text": "ブリットが言ったことの一つは"}]
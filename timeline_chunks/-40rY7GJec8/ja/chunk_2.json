[{"type": "subtitle", "time": 131.35, "timestamp": "00:02:11", "text": "泣かないで。"}, {"type": "subtitle", "time": 133.83, "timestamp": "00:02:13", "text": "古いfsに媚びるのはやめてください"}, {"type": "subtitle", "time": 136.47, "timestamp": "00:02:16", "text": "インターネット。待って。息子たちが彼女を見ている"}, {"type": "subtitle", "time": 138.63, "timestamp": "00:02:18", "text": "ストリーム。え、何？"}, {"type": "subtitle", "time": 140.79, "timestamp": "00:02:20", "text": "はい、大丈夫です。次がある"}, {"type": "subtitle", "time": 143.11, "timestamp": "00:02:23", "text": "時間。うん。うん。うん。私はすべきではない"}, {"type": "subtitle", "time": 146.22899999999998, "timestamp": "00:02:26", "text": "コメントを左クリックしてください。"}, {"type": "subtitle", "time": 147.91, "timestamp": "00:02:27", "text": "あなたはとても美人だから幸運だね。私は大きな"}, {"type": "subtitle", "time": 150.26, "timestamp": "00:02:30", "text": "友人。"}, {"type": "subtitle", "time": 159.27, "timestamp": "00:02:39", "text": "状況が見られるのは"}, {"type": "subtitle", "time": 161.91, "timestamp": "00:02:41", "text": "女性が泣くのは適切である"}, {"type": "subtitle", "time": 163.67000000000002, "timestamp": "00:02:43", "text": "振られたとき、失ったとき"}, {"type": "subtitle", "time": 165.589, "timestamp": "00:02:45", "text": "財布と子供がフラッシュゲームをするとき"}, {"type": "subtitle", "time": 168.47, "timestamp": "00:02:48", "text": "販売中止になります。"}, {"type": "subtitle", "time": 170.949, "timestamp": "00:02:50", "text": "もっと"}, {"type": "subtitle", "time": 172.63, "timestamp": "00:02:52", "text": "初めてのゲーム配信。本日は以上です。"}, {"type": "subtitle", "time": 175.43, "timestamp": "00:02:55", "text": "ブロックだと思います。"}, {"type": "subtitle", "time": 177.71, "timestamp": "00:02:57", "text": "いいえ、うまくいきませんでした。"}]
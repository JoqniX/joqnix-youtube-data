[{"type": "subtitle", "time": 11401.99, "timestamp": "03:10:01", "text": "私自身がそれが起こるのを見たが、"}, {"type": "subtitle", "time": 11404.71, "timestamp": "03:10:04", "text": "私だけでなくコミュニティでも"}, {"type": "subtitle", "time": 11407.75, "timestamp": "03:10:07", "text": "そして私が交流したストリームは"}, {"type": "subtitle", "time": 11410.79, "timestamp": "03:10:10", "text": "自分自身に集中している、私の"}, {"type": "subtitle", "time": 11412.95, "timestamp": "03:10:12", "text": "ストリームとか色々、だって私は"}, {"type": "subtitle", "time": 11415.19, "timestamp": "03:10:15", "text": "多くの人が配信している番組を視聴する。私は"}, {"type": "subtitle", "time": 11418.309, "timestamp": "03:10:18", "text": "そういうことが起きてるよ。ああ、ジョー、君が恋しいよ"}, {"type": "subtitle", "time": 11420.63, "timestamp": "03:10:20", "text": "と、その他諸々。長い長い時間が経ちました"}, {"type": "subtitle", "time": 11422.23, "timestamp": "03:10:22", "text": "その間。どこに行ってたの？"}, {"type": "subtitle", "time": 11426.87, "timestamp": "03:10:26", "text": "もの？ええ、まさにブレットソンみたいに"}, {"type": "subtitle", "time": 11429.51, "timestamp": "03:10:29", "text": "先ほど述べたとおりです。うん。"}, {"type": "subtitle", "time": 11438.55, "timestamp": "03:10:38", "text": "えーと、そうですね、簡単です。待って、何？"}, {"type": "subtitle", "time": 11439.99, "timestamp": "03:10:39", "text": "ええ、私が昔よく"}, {"type": "subtitle", "time": 11442.63, "timestamp": "03:10:42", "text": "見て、見て、戻ってきました"}, {"type": "subtitle", "time": 11444.71, "timestamp": "03:10:44", "text": "100から2年かけて、でもまあ"}, {"type": "subtitle", "time": 11446.309, "timestamp": "03:10:46", "text": "彼らの配信を見るのをやめて"}, {"type": "subtitle", "time": 11448.79, "timestamp": "03:10:48", "text": "私にDMを送り始めてください。なぜ私は来ないのか"}, {"type": "subtitle", "time": 11451.03, "timestamp": "03:10:51", "text": "小川？そう、これだよ。うん、そんな感じ"}, {"type": "subtitle", "time": 11455.19, "timestamp": "03:10:55", "text": "それ。はい。もっと私に注目して、喜びを。"}]
[{"type": "subtitle", "time": 14580.07, "timestamp": "04:03:00", "text": "このロールシステム。 1つ目はメニューです"}, {"type": "subtitle", "time": 14581.99, "timestamp": "04:03:01", "text": "バージョン、1つは男性以外のバージョンです。"}, {"type": "subtitle", "time": 14583.429, "timestamp": "04:03:03", "text": "スキップバージョン、そして1つは"}, {"type": "subtitle", "time": 14585.75, "timestamp": "04:03:05", "text": "反応型ロールバージョン。すべてにおいて"}, {"type": "subtitle", "time": 14587.99, "timestamp": "04:03:07", "text": "これについて人々は困っています"}, {"type": "subtitle", "time": 14589.59, "timestamp": "04:03:09", "text": "ROSを受講する。だから、私は待つことにした"}, {"type": "subtitle", "time": 14592.07, "timestamp": "04:03:12", "text": "Discord機能について。そうして"}, {"type": "subtitle", "time": 14594.95, "timestamp": "04:03:14", "text": "知っている人向けのセクションを設けます"}, {"type": "subtitle", "time": 14597.429, "timestamp": "04:03:17", "text": "コーディングする。彼らはコミュニティを形成できる"}, {"type": "subtitle", "time": 14600.309, "timestamp": "04:03:20", "text": "ゲームか何か、おなじみのもの"}, {"type": "subtitle", "time": 14603.91, "timestamp": "04:03:23", "text": "キャラクター。ラインナップには37名がいます"}, {"type": "subtitle", "time": 14607.59, "timestamp": "04:03:27", "text": "現時点での第1巻の登場人物。"}, {"type": "subtitle", "time": 14611.189, "timestamp": "04:03:31", "text": "だから私は一生懸命働かなければならない"}, {"type": "subtitle", "time": 14613.91, "timestamp": "04:03:33", "text": "それらに命を与える。ええ、今のところは"}, {"type": "subtitle", "time": 14616.95, "timestamp": "04:03:36", "text": "4人のキャラクターだけが4人メイン"}, {"type": "subtitle", "time": 14618.95, "timestamp": "04:03:38", "text": "キャラクターはここにいます。これは入手可能です"}, {"type": "subtitle", "time": 14621.75, "timestamp": "04:03:41", "text": "そして誰もがそれが私だと知っている。"}, {"type": "subtitle", "time": 14624.07, "timestamp": "04:03:44", "text": "あなたが見た赤毛の女の子のシーソー"}, {"type": "subtitle", "time": 14626.309, "timestamp": "04:03:46", "text": "紫色の髪の少女は"}, {"type": "subtitle", "time": 14630.63, "timestamp": "04:03:50", "text": "クイニーナとシアン色の、ええ"}, {"type": "subtitle", "time": 14633.67, "timestamp": "04:03:53", "text": "シアン色の頭の人物キャラクター"}, {"type": "subtitle", "time": 14637.269, "timestamp": "04:03:57", "text": "31日の予定は？"}, {"type": "subtitle", "time": 14639.83, "timestamp": "04:03:59", "text": "はい、31日の予定がありますので、"}]
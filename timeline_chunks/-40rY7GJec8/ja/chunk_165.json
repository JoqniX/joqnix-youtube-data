[{"type": "subtitle", "time": 9901.19, "timestamp": "02:45:01", "text": "[音楽]"}, {"type": "subtitle", "time": 9914.95, "timestamp": "02:45:14", "text": "わからない。混乱しています。"}, {"type": "subtitle", "time": 9918.309, "timestamp": "02:45:18", "text": "いまだに22拍子のままだ。えっと、それは"}, {"type": "subtitle", "time": 9921.19, "timestamp": "02:45:21", "text": "スピードダン。うん、それはまるで"}, {"type": "subtitle", "time": 9929.11, "timestamp": "02:45:29", "text": "しかし、私が言えることは、"}, {"type": "subtitle", "time": 9931.51, "timestamp": "02:45:31", "text": "プレイ後の感想は？"}, {"type": "subtitle", "time": 9940.63, "timestamp": "02:45:40", "text": "1人は"}, {"type": "subtitle", "time": 9942.87, "timestamp": "02:45:42", "text": "さまざまなタイプの人々が"}, {"type": "subtitle", "time": 9945.67, "timestamp": "02:45:45", "text": "ストリーミングの世界へようこそ"}, {"type": "subtitle", "time": 9947.99, "timestamp": "02:45:47", "text": "コンテンツ制作の世界、あるいは"}, {"type": "subtitle", "time": 9949.83, "timestamp": "02:45:49", "text": "面白い"}, {"type": "subtitle", "time": 9958.389, "timestamp": "02:45:58", "text": "一つはあなたのためにそれを行う人たちです"}]
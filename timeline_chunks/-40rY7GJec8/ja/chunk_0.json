[{"type": "subtitle", "time": 3.83, "timestamp": "00:00:03", "text": "ストリームのように"}, {"type": "subtitle", "time": 6.55, "timestamp": "00:00:06", "text": "これと一緒に来てください"}, {"type": "subtitle", "time": 7.749, "timestamp": "00:00:07", "text": "[音楽]"}, {"type": "subtitle", "time": 10.47, "timestamp": "00:00:10", "text": "あなたはここに来たばかりです"}, {"type": "subtitle", "time": 14.04, "timestamp": "00:00:14", "text": "ストリームゲーム 懐かしのストリーム"}, {"type": "subtitle", "time": 16.63, "timestamp": "00:00:16", "text": "[音楽]"}, {"type": "subtitle", "time": 19.59, "timestamp": "00:00:19", "text": "飽きないね、君はどんなゲームをしてるの？"}, {"type": "subtitle", "time": 21.42, "timestamp": "00:00:21", "text": "再生中"}, {"type": "subtitle", "time": 23.429, "timestamp": "00:00:23", "text": "[音楽]"}, {"type": "subtitle", "time": 24.88, "timestamp": "00:00:24", "text": "エキサイト"}, {"type": "subtitle", "time": 25.99, "timestamp": "00:00:25", "text": "[音楽]"}, {"type": "subtitle", "time": 27.83, "timestamp": "00:00:27", "text": "本当に古代の遺物をいくつか見てみましょう"}, {"type": "subtitle", "time": 29.509, "timestamp": "00:00:29", "text": "今日の遺物"}, {"type": "subtitle", "time": 32.389, "timestamp": "00:00:32", "text": "年金に疑問符。私はビデオが大好きです"}, {"type": "subtitle", "time": 34.229, "timestamp": "00:00:34", "text": "ゲーム。"}, {"type": "subtitle", "time": 37.43, "timestamp": "00:00:37", "text": "誰もがストレス解消ゲームを始める"}, {"type": "subtitle", "time": 39.59, "timestamp": "00:00:39", "text": "最近。みんなゲームをストリーミング配信している"}, {"type": "subtitle", "time": 47.11, "timestamp": "00:00:47", "text": "[音楽]"}, {"type": "subtitle", "time": 53.91, "timestamp": "00:00:53", "text": "これは何ですか？"}, {"type": "subtitle", "time": 55.35, "timestamp": "00:00:55", "text": "素敵なショートパンツですね。"}, {"type": "subtitle", "time": 57.35, "timestamp": "00:00:57", "text": "[音楽]"}]
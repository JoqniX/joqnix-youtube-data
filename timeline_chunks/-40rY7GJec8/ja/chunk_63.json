[{"type": "subtitle", "time": 3780.04, "timestamp": "01:03:00", "text": "お落ち着きください、奥様。"}, {"type": "subtitle", "time": 3793.829, "timestamp": "01:03:13", "text": "ちょっと疲れた。ちょっと疲れた。揺れる。"}, {"type": "subtitle", "time": 3796.95, "timestamp": "01:03:16", "text": "うん、寝た方がいいよ。私は思う"}, {"type": "subtitle", "time": 3803.67, "timestamp": "01:03:23", "text": "アルコールは私のアヒルよりも悪い"}, {"type": "subtitle", "time": 3805.95, "timestamp": "01:03:25", "text": "意見。"}, {"type": "subtitle", "time": 3807.029, "timestamp": "01:03:27", "text": "[音楽]"}, {"type": "subtitle", "time": 3808.63, "timestamp": "01:03:28", "text": "うん、明日まで寝た方がいいよ。"}, {"type": "subtitle", "time": 3810.87, "timestamp": "01:03:30", "text": "うん、"}, {"type": "subtitle", "time": 3819.67, "timestamp": "01:03:39", "text": "眠れません。入った瞬間"}, {"type": "subtitle", "time": 3821.43, "timestamp": "01:03:41", "text": "ベッドで、この空虚感がすべて押し寄せてきた"}, {"type": "subtitle", "time": 3824.549, "timestamp": "01:03:44", "text": "私にとって。なんてこった。私は祈るつもりです"}, {"type": "subtitle", "time": 3827.829, "timestamp": "01:03:47", "text": "他の指名者も、そうすれば"}, {"type": "subtitle", "time": 3829.349, "timestamp": "01:03:49", "text": "不眠症患者"}, {"type": "subtitle", "time": 3831.91, "timestamp": "01:03:51", "text": "今夜はぐっすり眠れそうだ。なんてこった、"}, {"type": "subtitle", "time": 3834.39, "timestamp": "01:03:54", "text": "それは良くない。"}, {"type": "subtitle", "time": 3837.109, "timestamp": "01:03:57", "text": "私が守護天使になります。眠い登山"}]
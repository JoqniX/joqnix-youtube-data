[{"type": "subtitle", "time": 16321.59, "timestamp": "04:32:01", "text": "うん。 9月、10月期。うん。"}, {"type": "subtitle", "time": 16324.229, "timestamp": "04:32:04", "text": "うん。あの頃は本当に苦労しました。"}, {"type": "subtitle", "time": 16327.11, "timestamp": "04:32:07", "text": "レンダリングされた、いや、レンダリングされていないレンダリングされた"}, {"type": "subtitle", "time": 16329.03, "timestamp": "04:32:09", "text": "レンダリングされたものなど、私は"}, {"type": "subtitle", "time": 16331.269, "timestamp": "04:32:11", "text": "すべての苦労と"}, {"type": "subtitle", "time": 16333.429, "timestamp": "04:32:13", "text": "物"}, {"type": "subtitle", "time": 16335.11, "timestamp": "04:32:15", "text": "YouTubeとかそういうのに関しては"}, {"type": "subtitle", "time": 16338.149, "timestamp": "04:32:18", "text": "それ。それで、彼は彼の素敵な"}, {"type": "subtitle", "time": 16341.59, "timestamp": "04:32:21", "text": "言葉とか、そういうことで私はたくさん泣いてしまった"}, {"type": "subtitle", "time": 16345.59, "timestamp": "04:32:25", "text": "そして私の心を"}, {"type": "subtitle", "time": 16348.309, "timestamp": "04:32:28", "text": "土居わく"}, {"type": "subtitle", "time": 16352.07, "timestamp": "04:32:32", "text": "自分がしたことに対して感謝されているという感覚"}, {"type": "subtitle", "time": 16355.75, "timestamp": "04:32:35", "text": "私のベスト。うん。えっと、私が"}, {"type": "subtitle", "time": 16358.149, "timestamp": "04:32:38", "text": "みんなの頭を撫でたり、ハグしたりする"}, {"type": "subtitle", "time": 16361.03, "timestamp": "04:32:41", "text": "そして、感謝の言葉すべて"}, {"type": "subtitle", "time": 16363.67, "timestamp": "04:32:43", "text": "私は最善を尽くしている、私は誰かだった"}, {"type": "subtitle", "time": 16366.55, "timestamp": "04:32:46", "text": "これまで評価されたことがなかった"}, {"type": "subtitle", "time": 16370.63, "timestamp": "04:32:50", "text": "私が何をしようと、何であろうと。だから私が"}, {"type": "subtitle", "time": 16372.63, "timestamp": "04:32:52", "text": "感謝の言葉に感謝"}, {"type": "subtitle", "time": 16376.07, "timestamp": "04:32:56", "text": "それは私の心を溶かしてしまった。それで"}, {"type": "subtitle", "time": 16378.469, "timestamp": "04:32:58", "text": "ええ、私が生まれてからずっと"}]
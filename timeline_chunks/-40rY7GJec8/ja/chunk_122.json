[{"type": "subtitle", "time": 7323.109, "timestamp": "02:02:03", "text": "とても可愛くて綺麗だから。ただ"}, {"type": "subtitle", "time": 7325.589, "timestamp": "02:02:05", "text": "私もからかわれた"}, {"type": "subtitle", "time": 7327.43, "timestamp": "02:02:07", "text": "とてもショックで、バカで、めちゃくちゃで"}, {"type": "subtitle", "time": 7330.39, "timestamp": "02:02:10", "text": "頭。"}, {"type": "subtitle", "time": 7332.149, "timestamp": "02:02:12", "text": "なんてこった。"}, {"type": "subtitle", "time": 7341.51, "timestamp": "02:02:21", "text": "かわいそうに。"}, {"type": "subtitle", "time": 7348.87, "timestamp": "02:02:28", "text": "それとも、なんていう名前だったかな？言う"}, {"type": "subtitle", "time": 7350.79, "timestamp": "02:02:30", "text": "自分の過去について話して同情を得る"}, {"type": "subtitle", "time": 7353.189, "timestamp": "02:02:33", "text": "他者によって。"}, {"type": "subtitle", "time": 7361.83, "timestamp": "02:02:41", "text": "これは私にとってすごく共感できる。少年、これはああ"}, {"type": "subtitle", "time": 7369.91, "timestamp": "02:02:49", "text": "次はこれ。さあ行こう。はい。"}, {"type": "subtitle", "time": 7372.55, "timestamp": "02:02:52", "text": "何？"}, {"type": "subtitle", "time": 7375.03, "timestamp": "02:02:55", "text": "あなたは大天使です。誰かへの贈り物"}, {"type": "subtitle", "time": 7376.95, "timestamp": "02:02:56", "text": "誰かが虹のようなスーパーチャットをした"}, {"type": "subtitle", "time": 7378.87, "timestamp": "02:02:58", "text": "スーパーチャー。"}]
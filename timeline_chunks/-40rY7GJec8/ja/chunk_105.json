[{"type": "subtitle", "time": 6306.31, "timestamp": "01:45:06", "text": "なんてこった。私が始めたらどうなるだろう？なんてこった。"}, {"type": "subtitle", "time": 6309.03, "timestamp": "01:45:09", "text": "なんてこった。それはまずい。それはまずい。それは"}, {"type": "subtitle", "time": 6311.35, "timestamp": "01:45:11", "text": "悪い。なんてこった。彼女を倒さなければならない"}, {"type": "subtitle", "time": 6313.27, "timestamp": "01:45:13", "text": "ファッション。"}, {"type": "subtitle", "time": 6317.61, "timestamp": "01:45:17", "text": "私は最後に配信するんじゃないの？私は"}, {"type": "subtitle", "time": 6319.83, "timestamp": "01:45:19", "text": "[音楽]"}, {"type": "subtitle", "time": 6321.59, "timestamp": "01:45:21", "text": "あなたが私のアイデアを盗んだことは知っています"}, {"type": "subtitle", "time": 6323.43, "timestamp": "01:45:23", "text": "以前配信したストリーム。まるであなたがそうしなかったかのように"}, {"type": "subtitle", "time": 6326.95, "timestamp": "01:45:26", "text": "訴えられたい。"}, {"type": "subtitle", "time": 6329.99, "timestamp": "01:45:29", "text": "計画を立てるのに、もう少し時間が必要です。だから、もし"}, {"type": "subtitle", "time": 6332.229, "timestamp": "01:45:32", "text": "だから、私は出かけます。では、"}, {"type": "subtitle", "time": 6335.83, "timestamp": "01:45:35", "text": "私はそうするつもりです。わかった。なんてこった。私はしません"}, {"type": "subtitle", "time": 6339.03, "timestamp": "01:45:39", "text": "彼女に中毒になってほしい"}, {"type": "subtitle", "time": 6342.55, "timestamp": "01:45:42", "text": "18歳以上向け。それはまずい。"}, {"type": "subtitle", "time": 6344.629, "timestamp": "01:45:44", "text": "それはまずい。それはまずい。私は彼女を望んでいない"}, {"type": "subtitle", "time": 6346.629, "timestamp": "01:45:46", "text": "に"}, {"type": "subtitle", "time": 6350.95, "timestamp": "01:45:50", "text": "アンチとか、そういうの知ってる？"}, {"type": "subtitle", "time": 6353.27, "timestamp": "01:45:53", "text": "キミト"}, {"type": "subtitle", "time": 6359.13, "timestamp": "01:45:59", "text": "blah d。この曲じゃないですか？"}]
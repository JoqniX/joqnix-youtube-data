[{"type": "subtitle", "time": 1868.47, "timestamp": "00:31:08", "text": "デフォルト設定は実際には"}, {"type": "subtitle", "time": 1872.389, "timestamp": "00:31:12", "text": "それは、ええと、肉体的なものでした。それは待ってそれは"}, {"type": "subtitle", "time": 1876.149, "timestamp": "00:31:16", "text": "素晴らしい動きだ。誰も満足することができない"}, {"type": "subtitle", "time": 1878.389, "timestamp": "00:31:18", "text": "今の私。え、何だって？君たちは何をしたの？"}, {"type": "subtitle", "time": 1880.389, "timestamp": "00:31:20", "text": "はぁ？"}, {"type": "subtitle", "time": 1890.47, "timestamp": "00:31:30", "text": "本当に腹が立つ。彼らはSCについて話し合っている"}, {"type": "subtitle", "time": 1893.35, "timestamp": "00:31:33", "text": "それなのに彼らは、"}, {"type": "subtitle", "time": 1895.99, "timestamp": "00:31:35", "text": "自分たちが魅力的であるかのように振る舞う。"}, {"type": "subtitle", "time": 1898.95, "timestamp": "00:31:38", "text": "それは本当だ。わかった。"}, {"type": "subtitle", "time": 1901.43, "timestamp": "00:31:41", "text": "彼らは何をするの？実際、私は"}, {"type": "subtitle", "time": 1904.149, "timestamp": "00:31:44", "text": "どういう意味か理解できますか？わかった。"}, {"type": "subtitle", "time": 1906.47, "timestamp": "00:31:46", "text": "こうすれば、ゲームプレイを減らすことができます"}, {"type": "subtitle", "time": 1908.549, "timestamp": "00:31:48", "text": "あれ。待って、待って、待って、待って。いいえ、私は"}, {"type": "subtitle", "time": 1911.25, "timestamp": "00:31:51", "text": "そこで配信する必要がある。"}, {"type": "subtitle", "time": 1913.11, "timestamp": "00:31:53", "text": "[音楽]"}, {"type": "subtitle", "time": 1916.05, "timestamp": "00:31:56", "text": "君もだよ。"}, {"type": "subtitle", "time": 1917.35, "timestamp": "00:31:57", "text": "[音楽]"}]
[{"type": "subtitle", "time": 8042.55, "timestamp": "02:14:02", "text": "いや、アニメがそれを見なかったらどうなると思う"}, {"type": "subtitle", "time": 8044.79, "timestamp": "02:14:04", "text": "それだけで済むと思っているのか？私たちと同じように"}, {"type": "subtitle", "time": 8048.95, "timestamp": "02:14:08", "text": "そんな簡単なことだ、みんな私に脂肪をくれ。"}, {"type": "subtitle", "time": 8050.79, "timestamp": "02:14:10", "text": "いいえ。"}, {"type": "subtitle", "time": 8053.49, "timestamp": "02:14:13", "text": "愛によって。"}, {"type": "subtitle", "time": 8060.55, "timestamp": "02:14:20", "text": "[音楽]"}, {"type": "subtitle", "time": 8063.75, "timestamp": "02:14:23", "text": "わかった。えっと、"}, {"type": "subtitle", "time": 8067.51, "timestamp": "02:14:27", "text": "秘密のテキストにアクセスする方法。"}, {"type": "subtitle", "time": 8069.589, "timestamp": "02:14:29", "text": "わかった。私たちの愛情度はそんな感じです。"}, {"type": "subtitle", "time": 8072.59, "timestamp": "02:14:32", "text": "だから私は信じている"}, {"type": "subtitle", "time": 8074.55, "timestamp": "02:14:34", "text": "[音楽]"}, {"type": "subtitle", "time": 8081.03, "timestamp": "02:14:41", "text": "見てみましょう。"}, {"type": "subtitle", "time": 8084.34, "timestamp": "02:14:44", "text": "みんなが私のことを話している。"}, {"type": "subtitle", "time": 8092.229, "timestamp": "02:14:52", "text": "いいえ、今まさにこのビデオを撮影しているところです"}]
[{"type": "subtitle", "time": 16381.11, "timestamp": "04:33:01", "text": "世の中にはたくさんいることに気づいた"}, {"type": "subtitle", "time": 16383.67, "timestamp": "04:33:03", "text": "感謝される必要がある人"}, {"type": "subtitle", "time": 16386.23, "timestamp": "04:33:06", "text": "大変な努力と労力が必要ですよね？うん。"}, {"type": "subtitle", "time": 16388.949, "timestamp": "04:33:08", "text": "うん。だから私は"}, {"type": "subtitle", "time": 16391.67, "timestamp": "04:33:11", "text": "なぜなら私は特別な幸せを感じたから"}, {"type": "subtitle", "time": 16393.99, "timestamp": "04:33:13", "text": "フィーリング。他の皆にも感じてほしい"}, {"type": "subtitle", "time": 16396.551, "timestamp": "04:33:16", "text": "あの、とても幸せな気分。だから私は思った"}, {"type": "subtitle", "time": 16400.23, "timestamp": "04:33:20", "text": "全員に与える方が良い"}, {"type": "subtitle", "time": 16403.029, "timestamp": "04:33:23", "text": "フィーリング。だから、私が与え始めて以来"}, {"type": "subtitle", "time": 16406.07, "timestamp": "04:33:26", "text": "温かい言葉とか色々だけど、うん、"}, {"type": "subtitle", "time": 16410.39, "timestamp": "04:33:30", "text": "それが、あの事例を作ったと思う"}, {"type": "subtitle", "time": 16413.91, "timestamp": "04:33:33", "text": "私と謎の出会い"}, {"type": "subtitle", "time": 16416.47, "timestamp": "04:33:36", "text": "彼がポッドキャストで話したり、その他いろいろ。しかし"}, {"type": "subtitle", "time": 16421.67, "timestamp": "04:33:41", "text": "そういうこと全部が私を"}, {"type": "subtitle", "time": 16424.31, "timestamp": "04:33:44", "text": "私が誰であるか、私が誰であるかについて話します"}, {"type": "subtitle", "time": 16427.59, "timestamp": "04:33:47", "text": "彼が今日に至るまでの過程が影響していると思う。私はしません"}, {"type": "subtitle", "time": 16428.949, "timestamp": "04:33:48", "text": "うん。うん。"}, {"type": "subtitle", "time": 16432.15, "timestamp": "04:33:52", "text": "でも、嬉しいよ。ありがとう"}]
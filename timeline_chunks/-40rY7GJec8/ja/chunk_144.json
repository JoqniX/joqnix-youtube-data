[{"type": "subtitle", "time": 8643.429, "timestamp": "02:24:03", "text": "待って、No.に到達しました。待って、待って、"}, {"type": "subtitle", "time": 8647.11, "timestamp": "02:24:07", "text": "待って。私は耐えられない"}, {"type": "subtitle", "time": 8650.15, "timestamp": "02:24:10", "text": "彼女は私をバカにした"}, {"type": "subtitle", "time": 8653.27, "timestamp": "02:24:13", "text": "あの配信のせいだ。ほら、これが私が"}, {"type": "subtitle", "time": 8654.95, "timestamp": "02:24:14", "text": "言った。"}, {"type": "subtitle", "time": 8657.91, "timestamp": "02:24:17", "text": "私が言ったのはこういうことです。私は"}, {"type": "subtitle", "time": 8659.59, "timestamp": "02:24:19", "text": "肌を吹くより、たぶん"}, {"type": "subtitle", "time": 8661.03, "timestamp": "02:24:21", "text": "より活動的になる必要がある"}, {"type": "subtitle", "time": 8663.11, "timestamp": "02:24:23", "text": "受け身。それはちょっと違う気がする"}, {"type": "subtitle", "time": 8665.19, "timestamp": "02:24:25", "text": "そうですね"}, {"type": "subtitle", "time": 8667.51, "timestamp": "02:24:27", "text": "もうこれ以上無視されるのは耐えられない。"}, {"type": "subtitle", "time": 8669.67, "timestamp": "02:24:29", "text": "それは本当に私たちの問題です。さようなら、"}, {"type": "subtitle", "time": 8672.309, "timestamp": "02:24:32", "text": "桃。私は本当にあなたを愛していました。何を"}, {"type": "subtitle", "time": 8676.26, "timestamp": "02:24:36", "text": "意味は「である」ということですか？はぁ？"}, {"type": "subtitle", "time": 8688.71, "timestamp": "02:24:48", "text": "再び平坦状態になった。"}]
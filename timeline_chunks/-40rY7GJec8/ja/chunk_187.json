[{"type": "subtitle", "time": 11220.07, "timestamp": "03:07:00", "text": "えこひいきとかそういう話をするんだよね？"}, {"type": "subtitle", "time": 11222.71, "timestamp": "03:07:02", "text": "ストリーマーがしてはいけないことは"}, {"type": "subtitle", "time": 11225.91, "timestamp": "03:07:05", "text": "えこひいきと呼ばれるもの。もしそうするなら"}, {"type": "subtitle", "time": 11229.429, "timestamp": "03:07:09", "text": "えこひいきは、必ず悪影響を及ぼすだろう。"}, {"type": "subtitle", "time": 11232.389, "timestamp": "03:07:12", "text": "下り坂とは、あなたのコミュニティが"}, {"type": "subtitle", "time": 11236.15, "timestamp": "03:07:16", "text": "ゆっくりと弱っていく"}, {"type": "subtitle", "time": 11239.19, "timestamp": "03:07:19", "text": "弱点や危険な箇所など"}, {"type": "subtitle", "time": 11243.11, "timestamp": "03:07:23", "text": "彼らの間で。そして、その小さな点または"}, {"type": "subtitle", "time": 11244.95, "timestamp": "03:07:24", "text": "その小さな"}, {"type": "subtitle", "time": 11248.07, "timestamp": "03:07:28", "text": "ギャップはどんどん大きくなっていく、"}, {"type": "subtitle", "time": 11252.07, "timestamp": "03:07:32", "text": "それを修正するために本当に大変な方法を取る"}, {"type": "subtitle", "time": 11254.87, "timestamp": "03:07:34", "text": "傷の手当てとか、そういうことだよね？だからそれは"}, {"type": "subtitle", "time": 11257.51, "timestamp": "03:07:37", "text": "均等に保つ方が良い"}, {"type": "subtitle", "time": 11261.11, "timestamp": "03:07:41", "text": "正規化して、その等式を与える。"}, {"type": "subtitle", "time": 11263.349, "timestamp": "03:07:43", "text": "私は少年が"}, {"type": "subtitle", "time": 11265.99, "timestamp": "03:07:45", "text": "お気に入りなので、私は"}, {"type": "subtitle", "time": 11269.03, "timestamp": "03:07:49", "text": "でも、自分はまだアマチュアだと感じています"}, {"type": "subtitle", "time": 11270.71, "timestamp": "03:07:50", "text": "に"}, {"type": "subtitle", "time": 11274.469, "timestamp": "03:07:54", "text": "その問題に取り組むが、まだやらなければならないことがある"}, {"type": "subtitle", "time": 11277.349, "timestamp": "03:07:57", "text": "私のベスト。だから、だから私は"}]
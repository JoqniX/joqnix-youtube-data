[{"type": "subtitle", "time": 8411.19, "timestamp": "02:20:11", "text": "彼女をソーシャルストリーマーにして、"}, {"type": "subtitle", "time": 8414.07, "timestamp": "02:20:14", "text": "壊れないで好き"}, {"type": "subtitle", "time": 8419.22, "timestamp": "02:20:19", "text": "彼女をそのままにして、"}, {"type": "subtitle", "time": 8421.83, "timestamp": "02:20:21", "text": "[音楽]"}, {"type": "subtitle", "time": 8439.67, "timestamp": "02:20:39", "text": "形はすべて古い"}, {"type": "subtitle", "time": 8448.85, "timestamp": "02:20:48", "text": "なぜ彼女のリボンジャグリングは揺れているのですか？"}, {"type": "subtitle", "time": 8451.51, "timestamp": "02:20:51", "text": "[音楽]"}]
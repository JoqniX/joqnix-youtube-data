[{"type": "subtitle", "time": 6542.95, "timestamp": "01:49:02", "text": "視聴者にアドバイスをもらうと"}, {"type": "subtitle", "time": 6546.55, "timestamp": "01:49:06", "text": "育て方、あれこれのやり方"}, {"type": "subtitle", "time": 6549.99, "timestamp": "01:49:09", "text": "それは、異なるものになる可能性がある"}, {"type": "subtitle", "time": 6555.27, "timestamp": "01:49:15", "text": "時間。だから、気をつけなければならない。うん。"}, {"type": "subtitle", "time": 6557.75, "timestamp": "01:49:17", "text": "うん。 YP配信者の皆様、こんにちは。元気ですか？希望"}, {"type": "subtitle", "time": 6565.109, "timestamp": "01:49:25", "text": "男。ダンをプレイするなら、プレイしてください"}, {"type": "subtitle", "time": 6568.31, "timestamp": "01:49:28", "text": "きちんと。おい。いや、それはまずい。でも私は"}, {"type": "subtitle", "time": 6573.99, "timestamp": "01:49:33", "text": "他人に自分の荷物を運ばせるのはやめなさい。病気"}, {"type": "subtitle", "time": 6576.87, "timestamp": "01:49:36", "text": "それを削除してください。"}, {"type": "subtitle", "time": 6580.43, "timestamp": "01:49:40", "text": "ちょっと疲れた。"}, {"type": "subtitle", "time": 6585.83, "timestamp": "01:49:45", "text": "今ではみんなゲーム実況動画をやっている。その"}, {"type": "subtitle", "time": 6589.56, "timestamp": "01:49:49", "text": "退屈になってきた。おお。"}, {"type": "subtitle", "time": 6592.229, "timestamp": "01:49:52", "text": "[音楽]"}, {"type": "subtitle", "time": 6596.05, "timestamp": "01:49:56", "text": "きっとあなたはもっと上手になりますよ。"}]
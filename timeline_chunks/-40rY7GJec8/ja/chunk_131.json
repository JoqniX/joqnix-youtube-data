[{"type": "subtitle", "time": 7871.65, "timestamp": "02:11:11", "text": "はぁ？"}, {"type": "subtitle", "time": 7877.99, "timestamp": "02:11:17", "text": "[音楽]"}, {"type": "subtitle", "time": 7881.75, "timestamp": "02:11:21", "text": "何だって？とても混乱しています。"}, {"type": "subtitle", "time": 7893.189, "timestamp": "02:11:33", "text": "[音楽]"}, {"type": "subtitle", "time": 7895.109, "timestamp": "02:11:35", "text": "彼女とは二度と会いたくない。わかった、"}, {"type": "subtitle", "time": 7898.149, "timestamp": "02:11:38", "text": "それはまずい。ああ、とても遠いですね。"}, {"type": "subtitle", "time": 7901.109, "timestamp": "02:11:41", "text": "私の笑顔、おめでとう"}, {"type": "subtitle", "time": 7903.669, "timestamp": "02:11:43", "text": "同じ画面に。"}, {"type": "subtitle", "time": 7911.99, "timestamp": "02:11:51", "text": "私が何をしたらどうなるか知りたい"}, {"type": "subtitle", "time": 7914.39, "timestamp": "02:11:54", "text": "もし私が"}, {"type": "subtitle", "time": 7919.91, "timestamp": "02:11:59", "text": "私は本当にあなたを愛していました。待って、何何"}]
[{"type": "subtitle", "time": 6913.189, "timestamp": "01:55:13", "text": "[音楽]"}, {"type": "subtitle", "time": 6917.0, "timestamp": "01:55:17", "text": "少なくとも彼女は私たちの味方だ。うん、"}, {"type": "subtitle", "time": 6918.39, "timestamp": "01:55:18", "text": "[音楽]"}, {"type": "subtitle", "time": 6922.629, "timestamp": "01:55:22", "text": "時間はある。だから、私たちは外に出て"}, {"type": "subtitle", "time": 6927.13, "timestamp": "01:55:27", "text": "複雑な。彼女には外に出る必要がある。私は必要としている"}, {"type": "subtitle", "time": 6936.79, "timestamp": "01:55:36", "text": "[音楽]"}, {"type": "subtitle", "time": 6938.629, "timestamp": "01:55:38", "text": "だからこのゲームは"}, {"type": "subtitle", "time": 6942.55, "timestamp": "01:55:42", "text": "日本。だから夜は"}, {"type": "subtitle", "time": 6947.189, "timestamp": "01:55:47", "text": "洞窟に戻る"}, {"type": "subtitle", "time": 6949.669, "timestamp": "01:55:49", "text": "かわいいものがたくさん。えっと"}, {"type": "subtitle", "time": 6951.41, "timestamp": "01:55:51", "text": "ナノ"}, {"type": "subtitle", "time": 6953.03, "timestamp": "01:55:53", "text": "[音楽]"}, {"type": "subtitle", "time": 6956.229, "timestamp": "01:55:56", "text": "今日のナノ。どっちがかわいい？私または私の新しい"}, {"type": "subtitle", "time": 6958.55, "timestamp": "01:55:58", "text": "友人"}]
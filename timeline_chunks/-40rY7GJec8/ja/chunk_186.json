[{"type": "subtitle", "time": 11161.59, "timestamp": "03:06:01", "text": "えーと"}, {"type": "subtitle", "time": 11164.87, "timestamp": "03:06:04", "text": "うん、最高のことをしようという気持ちになる"}, {"type": "subtitle", "time": 11167.91, "timestamp": "03:06:07", "text": "それ。しかし、ここでまた疑問が生じる。"}, {"type": "subtitle", "time": 11169.67, "timestamp": "03:06:09", "text": "の"}, {"type": "subtitle", "time": 11173.67, "timestamp": "03:06:13", "text": "ゲームで見たもの"}, {"type": "subtitle", "time": 11177.59, "timestamp": "03:06:17", "text": "献身的に愛した、献身的に"}, {"type": "subtitle", "time": 11180.07, "timestamp": "03:06:20", "text": "エンジェルはバンを愛していた"}, {"type": "subtitle", "time": 11183.99, "timestamp": "03:06:23", "text": "しかし彼女は与えようともしなかった"}, {"type": "subtitle", "time": 11188.23, "timestamp": "03:06:28", "text": "特定のビューアの仕様"}, {"type": "subtitle", "time": 11190.23, "timestamp": "03:06:30", "text": "愛と表現を与えたが、"}, {"type": "subtitle", "time": 11193.59, "timestamp": "03:06:33", "text": "あのセクシーなストリームにいるみんな"}, {"type": "subtitle", "time": 11198.23, "timestamp": "03:06:38", "text": "私たちも、もし気づいたなら、"}, {"type": "subtitle", "time": 11200.23, "timestamp": "03:06:40", "text": "それではないが、それは"}, {"type": "subtitle", "time": 11202.87, "timestamp": "03:06:42", "text": "最初のやつとか。"}, {"type": "subtitle", "time": 11204.87, "timestamp": "03:06:44", "text": "ああ、ツイートとかそういうやつね。うん。"}, {"type": "subtitle", "time": 11208.87, "timestamp": "03:06:48", "text": "うん。うん。忘れていた。うん。"}, {"type": "subtitle", "time": 11211.51, "timestamp": "03:06:51", "text": "えっと"}, {"type": "subtitle", "time": 11216.07, "timestamp": "03:06:56", "text": "ああ、そうだね。つまり、主に、"}]
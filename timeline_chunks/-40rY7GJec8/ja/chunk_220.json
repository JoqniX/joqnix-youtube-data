[{"type": "subtitle", "time": 13201.11, "timestamp": "03:40:01", "text": "キャプチャカードを入手しました。いいえ、いいえ、その前に"}, {"type": "subtitle", "time": 13204.229, "timestamp": "03:40:04", "text": "キャプチャカード NDI の時代は私の"}, {"type": "subtitle", "time": 13207.51, "timestamp": "03:40:07", "text": "複数のデュアルピース構成。うん、そうだね"}, {"type": "subtitle", "time": 13210.95, "timestamp": "03:40:10", "text": "大変だった。何てことだ。"}, {"type": "subtitle", "time": 13214.63, "timestamp": "03:40:14", "text": "そう、Twitch時代のラップ。"}, {"type": "subtitle", "time": 13216.55, "timestamp": "03:40:16", "text": "うん、"}, {"type": "subtitle", "time": 13219.59, "timestamp": "03:40:19", "text": "そんな感じ。つまり、えーと、ちょっとちょっと"}, {"type": "subtitle", "time": 13222.63, "timestamp": "03:40:22", "text": "失敗は誰にでも起こりうる。"}, {"type": "subtitle", "time": 13225.91, "timestamp": "03:40:25", "text": "ちょっとしたミスは誰にでも起こります。しかし"}, {"type": "subtitle", "time": 13228.95, "timestamp": "03:40:28", "text": "1つのことは1つのことだった 1つのことは1つのことだった"}, {"type": "subtitle", "time": 13231.83, "timestamp": "03:40:31", "text": "一番大切なのは"}, {"type": "subtitle", "time": 13234.469, "timestamp": "03:40:34", "text": "たとえあなたが今そこにいるのが好きでも"}, {"type": "subtitle", "time": 13237.11, "timestamp": "03:40:37", "text": "BTuber対"}, {"type": "subtitle", "time": 13240.309, "timestamp": "03:40:40", "text": "現実世界での没入型体験に関するツイートのことですよね？彼らは"}, {"type": "subtitle", "time": 13243.11, "timestamp": "03:40:43", "text": "シャワーモデルと右側を表示"}, {"type": "subtitle", "time": 13246.389, "timestamp": "03:40:46", "text": "側面は現実の自分と同じような感じになるでしょう"}, {"type": "subtitle", "time": 13249.75, "timestamp": "03:40:49", "text": "人々は、もし望むならそうする、もし望むならそうする"}, {"type": "subtitle", "time": 13252.309, "timestamp": "03:40:52", "text": "彼らは私が"}, {"type": "subtitle", "time": 13255.59, "timestamp": "03:40:55", "text": "理解すれば、それはその人次第です"}, {"type": "subtitle", "time": 13257.91, "timestamp": "03:40:57", "text": "あなたは個人情報を晒されています"}]
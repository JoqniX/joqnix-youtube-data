[{"type": "subtitle", "time": 10981.19, "timestamp": "03:03:01", "text": "ええ、知っています。"}, {"type": "subtitle", "time": 10985.67, "timestamp": "03:03:05", "text": "見ない人たち"}, {"type": "subtitle", "time": 10987.67, "timestamp": "03:03:07", "text": "うん"}, {"type": "subtitle", "time": 10989.269, "timestamp": "03:03:09", "text": "私には、"}, {"type": "subtitle", "time": 10993.51, "timestamp": "03:03:13", "text": "私が何らかの形で有名になったとしても、それを見ていないだろう。"}, {"type": "subtitle", "time": 10997.83, "timestamp": "03:03:17", "text": "私はそれについて何かしたいのですが、"}, {"type": "subtitle", "time": 11004.87, "timestamp": "03:03:24", "text": "また考えてみれば、"}, {"type": "subtitle", "time": 11007.59, "timestamp": "03:03:27", "text": "例えば、ある特定の、私は"}, {"type": "subtitle", "time": 11010.55, "timestamp": "03:03:30", "text": "名前は言わないで。私は"}, {"type": "subtitle", "time": 11013.349, "timestamp": "03:03:33", "text": "名前は違うけど、あるユーチューバーがいる"}, {"type": "subtitle", "time": 11016.87, "timestamp": "03:03:36", "text": "えーと、私たち全員がグループの中にいたとき"}, {"type": "subtitle", "time": 11019.349, "timestamp": "03:03:39", "text": "私たち全員が"}, {"type": "subtitle", "time": 11022.389, "timestamp": "03:03:42", "text": "最初はみんな"}, {"type": "subtitle", "time": 11027.03, "timestamp": "03:03:47", "text": "初期の頃、爆発したミッドウーと"}, {"type": "subtitle", "time": 11028.79, "timestamp": "03:03:48", "text": "のように"}, {"type": "subtitle", "time": 11032.63, "timestamp": "03:03:52", "text": "彼女は、いや、そこにいる、つまり彼女ではないが"}, {"type": "subtitle", "time": 11035.99, "timestamp": "03:03:55", "text": "彼らは、えーと"}, {"type": "subtitle", "time": 11039.59, "timestamp": "03:03:59", "text": "いつもの影とかそんな感じ"}]
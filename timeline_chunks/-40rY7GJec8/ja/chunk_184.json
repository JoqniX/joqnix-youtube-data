[{"type": "subtitle", "time": 11043.19, "timestamp": "03:04:03", "text": "彼女が爆発したことに驚いた"}, {"type": "subtitle", "time": 11047.91, "timestamp": "03:04:07", "text": "爆発して、いろいろ爆発した"}, {"type": "subtitle", "time": 11051.91, "timestamp": "03:04:11", "text": "などなど、でも没入型ではない"}, {"type": "subtitle", "time": 11054.309, "timestamp": "03:04:14", "text": "新しい視点の台頭がゲーム化していたとき"}, {"type": "subtitle", "time": 11056.95, "timestamp": "03:04:16", "text": "あまりにも衝撃的だったので"}, {"type": "subtitle", "time": 11069.349, "timestamp": "03:04:29", "text": "ああ、そうだ、彼ら自身と、みんな"}, {"type": "subtitle", "time": 11072.389, "timestamp": "03:04:32", "text": "あなたのように毎日忠実な視聴者"}, {"type": "subtitle", "time": 11075.75, "timestamp": "03:04:35", "text": "忠実な視聴者がやって来て"}, {"type": "subtitle", "time": 11077.83, "timestamp": "03:04:37", "text": "すべての流れへ。彼らはまるでスーパー"}, {"type": "subtitle", "time": 11081.91, "timestamp": "03:04:41", "text": "心配した。配信者が変わったらどうなる？"}, {"type": "subtitle", "time": 11084.55, "timestamp": "03:04:44", "text": "新しい人々の台頭と"}, {"type": "subtitle", "time": 11087.91, "timestamp": "03:04:47", "text": "彼女が大きくなったので、"}, {"type": "subtitle", "time": 11092.07, "timestamp": "03:04:52", "text": "叫んでいいねするか、ビッグRが"}, {"type": "subtitle", "time": 11093.91, "timestamp": "03:04:53", "text": "とても人気があるか、あるいは何になるか"}, {"type": "subtitle", "time": 11097.59, "timestamp": "03:04:57", "text": "起こる。しかし"}]
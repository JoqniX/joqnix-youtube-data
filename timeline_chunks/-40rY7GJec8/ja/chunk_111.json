[{"type": "subtitle", "time": 6660.149, "timestamp": "01:51:00", "text": "はい。いいえ、フォロワーは1万人です。さあ行こう。彼女"}, {"type": "subtitle", "time": 6662.709, "timestamp": "01:51:02", "text": "彼女は遊びに行ったのかもしれない"}, {"type": "subtitle", "time": 6664.629, "timestamp": "01:51:04", "text": "信じられないゲーム"}, {"type": "subtitle", "time": 6667.03, "timestamp": "01:51:07", "text": "心を開いて、"}, {"type": "subtitle", "time": 6668.709, "timestamp": "01:51:08", "text": "みんな。プレイしてくれてありがとう"}, {"type": "subtitle", "time": 6670.229, "timestamp": "01:51:10", "text": "私の配信と一緒に。これを"}, {"type": "subtitle", "time": 6672.79, "timestamp": "01:51:12", "text": "そのパーティーは永遠に続くでしょう。"}, {"type": "subtitle", "time": 6680.229, "timestamp": "01:51:20", "text": "[音楽]"}, {"type": "subtitle", "time": 6686.31, "timestamp": "01:51:26", "text": "ねえ、私が"}, {"type": "subtitle", "time": 6688.39, "timestamp": "01:51:28", "text": "保つ"}, {"type": "subtitle", "time": 6690.709, "timestamp": "01:51:30", "text": "どうしたの？"}, {"type": "subtitle", "time": 6693.27, "timestamp": "01:51:33", "text": "いろいろ考えていたところ。"}, {"type": "subtitle", "time": 6699.03, "timestamp": "01:51:39", "text": "誰かいるかなと思って"}, {"type": "subtitle", "time": 6701.75, "timestamp": "01:51:41", "text": "私がビデオを見に行く予定だったら、私を見逃してください"}, {"type": "subtitle", "time": 6704.629, "timestamp": "01:51:44", "text": "ゲームはただ配信を見るだけ。えっと、これは"}, {"type": "subtitle", "time": 6714.47, "timestamp": "01:51:54", "text": "もし私が去ったら"}, {"type": "subtitle", "time": 6717.43, "timestamp": "01:51:57", "text": "どこにもない"}]
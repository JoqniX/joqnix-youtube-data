[{"type": "subtitle", "time": 9602.389, "timestamp": "02:40:02", "text": "次のような人たちがいるでしょう"}, {"type": "subtitle", "time": 9604.23, "timestamp": "02:40:04", "text": "あなたの機材やその他全てに嫉妬しています"}, {"type": "subtitle", "time": 9605.91, "timestamp": "02:40:05", "text": "そして彼らは盗もうとして"}, {"type": "subtitle", "time": 9607.91, "timestamp": "02:40:07", "text": "すべて。盗難が起こると"}, {"type": "subtitle", "time": 9612.55, "timestamp": "02:40:12", "text": "起こる。いろいろなことが起こるだろう。"}, {"type": "subtitle", "time": 9614.71, "timestamp": "02:40:14", "text": "それで、うちの犬はスピーカーをじっと見ていたんです"}, {"type": "subtitle", "time": 9618.23, "timestamp": "02:40:18", "text": "なぜなら、ああ、待って。私の犬は待って、"}, {"type": "subtitle", "time": 9621.75, "timestamp": "02:40:21", "text": "その配信はいつ行われたのですか？"}, {"type": "subtitle", "time": 9627.03, "timestamp": "02:40:27", "text": "私の犬だったの？ああ、これ覚えてるよ"}, {"type": "subtitle", "time": 9629.19, "timestamp": "02:40:29", "text": "一つの流れ。ええ、あなたは聞きました"}, {"type": "subtitle", "time": 9631.19, "timestamp": "02:40:31", "text": "ワンちゃん。そうそう。今日彼女は、ああ、そうだ。"}, {"type": "subtitle", "time": 9634.15, "timestamp": "02:40:34", "text": "今日は、愛犬のチャームがずっと吠えていた。"}, {"type": "subtitle", "time": 9637.11, "timestamp": "02:40:37", "text": "うん。うん。うん。うん。"}, {"type": "subtitle", "time": 9639.03, "timestamp": "02:40:39", "text": "犬はよく吠えていた。うん。うん。"}, {"type": "subtitle", "time": 9640.8, "timestamp": "02:40:40", "text": "うん。うん。 だった"}, {"type": "subtitle", "time": 9642.88, "timestamp": "02:40:42", "text": "だった 今日配信されるのか、それとも別の配信なのか？私はそうは思わない"}, {"type": "subtitle", "time": 9644.64, "timestamp": "02:40:44", "text": "今日配信されるのか、それとも別の配信なのか？私はそうは思わない 知る。"}, {"type": "subtitle", "time": 9650.42, "timestamp": "02:40:50", "text": "うん、"}, {"type": "subtitle", "time": 9652.15, "timestamp": "02:40:52", "text": "[音楽]"}, {"type": "subtitle", "time": 9655.349, "timestamp": "02:40:55", "text": "しかしほとんどの人も"}, {"type": "subtitle", "time": 9659.11, "timestamp": "02:40:59", "text": "わからない、好き"}]
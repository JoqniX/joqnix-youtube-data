[{"type": "subtitle", "time": 13320.15, "timestamp": "03:42:00", "text": "そういうことが起こるだろう。私は"}, {"type": "subtitle", "time": 13327.59, "timestamp": "03:42:07", "text": "私にもできるよ、私にもできる。低い"}, {"type": "subtitle", "time": 13330.63, "timestamp": "03:42:10", "text": "アルファ6毒素"}, {"type": "subtitle", "time": 13338.63, "timestamp": "03:42:18", "text": "待って、何を削除したの？"}, {"type": "subtitle", "time": 13341.75, "timestamp": "03:42:21", "text": "えっと、モリッサ。"}, {"type": "subtitle", "time": 13344.71, "timestamp": "03:42:24", "text": "ちょっと待って、ログを確認させてください。"}, {"type": "subtitle", "time": 13346.87, "timestamp": "03:42:26", "text": "私はなりすまし犯罪を犯したい。"}, {"type": "subtitle", "time": 13351.03, "timestamp": "03:42:31", "text": "個人情報盗難とは何ですか？それは何ですか？"}, {"type": "subtitle", "time": 13353.59, "timestamp": "03:42:33", "text": "グーグル。"}, {"type": "subtitle", "time": 13355.99, "timestamp": "03:42:35", "text": "えーと、死体窃盗は誰かが"}, {"type": "subtitle", "time": 13357.59, "timestamp": "03:42:37", "text": "個人情報を盗む"}, {"type": "subtitle", "time": 13359.19, "timestamp": "03:42:39", "text": "あなたの社会保障番号、銀行"}, {"type": "subtitle", "time": 13363.349, "timestamp": "03:42:43", "text": "口座番号。何てことだ。ヤベイのすべて"}, {"type": "subtitle", "time": 13366.229, "timestamp": "03:42:46", "text": "そういうことですよね？"}, {"type": "subtitle", "time": 13368.55, "timestamp": "03:42:48", "text": "はぁ？"}, {"type": "subtitle", "time": 13370.15, "timestamp": "03:42:50", "text": "ああ、これはまずい。なぜそうしたいのですか"}, {"type": "subtitle", "time": 13373.15, "timestamp": "03:42:53", "text": "そのダカをコミットしますか？"}, {"type": "subtitle", "time": 13376.79, "timestamp": "03:42:56", "text": "[音楽]"}, {"type": "subtitle", "time": 13379.11, "timestamp": "03:42:59", "text": "つまり"}]
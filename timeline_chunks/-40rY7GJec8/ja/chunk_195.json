[{"type": "subtitle", "time": 11702.309, "timestamp": "03:15:02", "text": "Twitchはアフィリエイトのおかげで"}, {"type": "subtitle", "time": 11704.07, "timestamp": "03:15:04", "text": "状態。"}, {"type": "subtitle", "time": 11707.03, "timestamp": "03:15:07", "text": "それでも私はまだこれに対して"}, {"type": "subtitle", "time": 11710.229, "timestamp": "03:15:10", "text": "日、私は"}, {"type": "subtitle", "time": 11713.75, "timestamp": "03:15:13", "text": "えっと、私は人々に"}, {"type": "subtitle", "time": 11715.67, "timestamp": "03:15:15", "text": "私を甘やかして、お金とか送って"}, {"type": "subtitle", "time": 11720.87, "timestamp": "03:15:20", "text": "だって、あの日、私が"}, {"type": "subtitle", "time": 11723.99, "timestamp": "03:15:23", "text": "魔法の貝殻効果を手に入れました"}, {"type": "subtitle", "time": 11726.63, "timestamp": "03:15:26", "text": "そのイベントにその名前を付けた。あ、ちょっと待ってください。モリー"}, {"type": "subtitle", "time": 11728.389, "timestamp": "03:15:28", "text": "はい、こんにちは。ようこそ、ようこそ。どうだったか"}, {"type": "subtitle", "time": 11730.229, "timestamp": "03:15:30", "text": "今日私と連絡が取れて、お元気ですか？希望"}, {"type": "subtitle", "time": 11732.71, "timestamp": "03:15:32", "text": "あなたはよくやっています。ちょうど終わったところです"}, {"type": "subtitle", "time": 11735.99, "timestamp": "03:15:35", "text": "プレイ中、いや、私たちは終わらせなかった"}, {"type": "subtitle", "time": 11738.55, "timestamp": "03:15:38", "text": "ゲームでしたが、私たちは、"}, {"type": "subtitle", "time": 11740.95, "timestamp": "03:15:40", "text": "今日はゲームをします。"}, {"type": "subtitle", "time": 11743.03, "timestamp": "03:15:43", "text": "たくさん必要とするストリームを再生して"}, {"type": "subtitle", "time": 11744.309, "timestamp": "03:15:44", "text": "今はちょうど"}, {"type": "subtitle", "time": 11747.03, "timestamp": "03:15:47", "text": "チャットセッションでは、"}, {"type": "subtitle", "time": 11750.07, "timestamp": "03:15:50", "text": "ゲームとストリーミング関連のすべて"}, {"type": "subtitle", "time": 11752.87, "timestamp": "03:15:52", "text": "もの。そうですね、良い一日をお過ごしください。"}, {"type": "subtitle", "time": 11755.75, "timestamp": "03:15:55", "text": "日。今日はどうやって私を見つけたのですか？希望"}, {"type": "subtitle", "time": 11757.91, "timestamp": "03:15:57", "text": "あなたはよくやっています。"}]
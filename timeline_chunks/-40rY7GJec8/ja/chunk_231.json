[{"type": "subtitle", "time": 13861.99, "timestamp": "03:51:01", "text": "何か。ええ、そうですね。ええ、私は作りました"}, {"type": "subtitle", "time": 13864.469, "timestamp": "03:51:04", "text": "そのツイートか、大きなメッセージなしのような"}, {"type": "subtitle", "time": 13867.99, "timestamp": "03:51:07", "text": "次はジョックへの謝罪、そして、えっと、そんな感じ"}, {"type": "subtitle", "time": 13870.309, "timestamp": "03:51:10", "text": "その日、私はそうなりたいと思った"}, {"type": "subtitle", "time": 13874.15, "timestamp": "03:51:14", "text": "まるで大悪党か何かみたいで"}, {"type": "subtitle", "time": 13877.269, "timestamp": "03:51:17", "text": "かわいいかわいいカワイイみたいに壊れていく"}, {"type": "subtitle", "time": 13878.79, "timestamp": "03:51:18", "text": "純粋な"}, {"type": "subtitle", "time": 13886.07, "timestamp": "03:51:26", "text": "誰が私を無傷で保ち、私を"}, {"type": "subtitle", "time": 13889.11, "timestamp": "03:51:29", "text": "私を生かしてくれる。なぜ私は彼に"}, {"type": "subtitle", "time": 13892.15, "timestamp": "03:51:32", "text": "悪い結末に陥って、"}, {"type": "subtitle", "time": 13895.11, "timestamp": "03:51:35", "text": "彼自身も堕落し、ご存知のように"}, {"type": "subtitle", "time": 13898.07, "timestamp": "03:51:38", "text": "全てを壊す"}, {"type": "subtitle", "time": 13900.79, "timestamp": "03:51:40", "text": "彼がどんな人で、どんな人なのか、"}, {"type": "subtitle", "time": 13902.469, "timestamp": "03:51:42", "text": "すべて。うん、それはまずいね。それは"}, {"type": "subtitle", "time": 13904.87, "timestamp": "03:51:44", "text": "だから、私のことを考えることさえ残酷な私"}, {"type": "subtitle", "time": 13907.11, "timestamp": "03:51:47", "text": "そういう風に考えてみてください。だから私は"}, {"type": "subtitle", "time": 13909.99, "timestamp": "03:51:49", "text": "気分がすごく悪くなって、泣き出してしまった"}, {"type": "subtitle", "time": 13913.59, "timestamp": "03:51:53", "text": "それを考えるだけでもまた一週間はかかるだろう。"}, {"type": "subtitle", "time": 13918.07, "timestamp": "03:51:58", "text": "そしてその日に私がしたことは、"}]
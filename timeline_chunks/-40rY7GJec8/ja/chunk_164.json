[{"type": "subtitle", "time": 9841.19, "timestamp": "02:44:01", "text": "などなど。引っ越していく人もいるでしょう"}, {"type": "subtitle", "time": 9844.55, "timestamp": "02:44:04", "text": "もし彼らがもっと良い仕事に就いたり、"}, {"type": "subtitle", "time": 9846.95, "timestamp": "02:44:06", "text": "勉強の方が良い、または留学したい"}, {"type": "subtitle", "time": 9850.309, "timestamp": "02:44:10", "text": "高等教育などを受けるため。"}, {"type": "subtitle", "time": 9852.309, "timestamp": "02:44:12", "text": "しかし"}, {"type": "subtitle", "time": 9856.07, "timestamp": "02:44:16", "text": "156で仕事を得ることは言うまでもなく、私は"}, {"type": "subtitle", "time": 9858.95, "timestamp": "02:44:18", "text": "一握りもらいます。うん、"}, {"type": "subtitle", "time": 9861.269, "timestamp": "02:44:21", "text": "必要なパートタイムの仕事"}, {"type": "subtitle", "time": 9863.59, "timestamp": "02:44:23", "text": "学位証明書"}, {"type": "subtitle", "time": 9866.309, "timestamp": "02:44:26", "text": "少なくとも12"}, {"type": "subtitle", "time": 9868.55, "timestamp": "02:44:28", "text": "など"}, {"type": "subtitle", "time": 9881.429, "timestamp": "02:44:41", "text": "ある意味では痛みだが、それは"}]
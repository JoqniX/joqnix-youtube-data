[{"type": "subtitle", "time": 13680.229, "timestamp": "03:48:00", "text": "だって、また、jocknick は私が"}, {"type": "subtitle", "time": 13681.91, "timestamp": "03:48:01", "text": "本当に"}, {"type": "subtitle", "time": 13685.99, "timestamp": "03:48:05", "text": "愛し、また心に留めておく"}, {"type": "subtitle", "time": 13689.429, "timestamp": "03:48:09", "text": "兄のような、あるいは家族の一員のような存在"}, {"type": "subtitle", "time": 13691.269, "timestamp": "03:48:11", "text": "私のものです。"}, {"type": "subtitle", "time": 13694.15, "timestamp": "03:48:14", "text": "アクィナ・セシラントでさえ、私はすべての"}, {"type": "subtitle", "time": 13696.389, "timestamp": "03:48:16", "text": "彼らは私にとってとても大切な存在です。他のすべて"}, {"type": "subtitle", "time": 13698.79, "timestamp": "03:48:18", "text": "アネクシアの登場人物"}, {"type": "subtitle", "time": 13700.55, "timestamp": "03:48:20", "text": "そして、そうでない残りの人たち"}, {"type": "subtitle", "time": 13702.469, "timestamp": "03:48:22", "text": "本当に明らかになったが、それらはすべて"}, {"type": "subtitle", "time": 13705.11, "timestamp": "03:48:25", "text": "私にとってとても大切なものです。一部の人にとっては"}, {"type": "subtitle", "time": 13706.79, "timestamp": "03:48:26", "text": "ああ、それはただのキャラクターの"}, {"type": "subtitle", "time": 13708.87, "timestamp": "03:48:28", "text": "仕事とか色々あるけど、それでも彼らはとても大切な存在です"}, {"type": "subtitle", "time": 13714.15, "timestamp": "03:48:34", "text": "私にとってはそういうことだ。それで"}, {"type": "subtitle", "time": 13715.91, "timestamp": "03:48:35", "text": "複数のことを同時にこなすようになる。うん。"}, {"type": "subtitle", "time": 13719.83, "timestamp": "03:48:39", "text": "時々、つまり、つまり、私は、私は"}, {"type": "subtitle", "time": 13723.349, "timestamp": "03:48:43", "text": "正しく言ったと思います。マネクシア"}, {"type": "subtitle", "time": 13727.67, "timestamp": "03:48:47", "text": "JokはV2のみとなる。でも、それが私なんです"}, {"type": "subtitle", "time": 13733.189, "timestamp": "03:48:53", "text": "それは僕、えっと、スポーツマン気質の僕だよ。"}, {"type": "subtitle", "time": 13735.03, "timestamp": "03:48:55", "text": "しかし、残りの"}, {"type": "subtitle", "time": 13737.51, "timestamp": "03:48:57", "text": "キャラクター、女王、またはシーズンすべて"}, {"type": "subtitle", "time": 13739.189, "timestamp": "03:48:59", "text": "主要登場人物"}]
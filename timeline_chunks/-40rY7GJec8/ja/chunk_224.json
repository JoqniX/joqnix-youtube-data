[{"type": "subtitle", "time": 13440.63, "timestamp": "03:44:00", "text": "多くの人が"}, {"type": "subtitle", "time": 13447.91, "timestamp": "03:44:07", "text": "ある有名ストリーマーを調べてみると"}, {"type": "subtitle", "time": 13451.11, "timestamp": "03:44:11", "text": "Facebook にはそのようなアカウントがあります。"}, {"type": "subtitle", "time": 13454.63, "timestamp": "03:44:14", "text": "YouTubeやTwitchなどでは、"}, {"type": "subtitle", "time": 13455.99, "timestamp": "03:44:15", "text": "人々がいる"}, {"type": "subtitle", "time": 13459.11, "timestamp": "03:44:19", "text": "なりすまし なりすまし"}, {"type": "subtitle", "time": 13462.71, "timestamp": "03:44:22", "text": "などなど、そうですよね？まるで投稿するみたい"}, {"type": "subtitle", "time": 13465.91, "timestamp": "03:44:25", "text": "人々を騙すために投稿されるのと同じ内容です"}, {"type": "subtitle", "time": 13468.71, "timestamp": "03:44:28", "text": "フォロワーや購読者を獲得し、"}, {"type": "subtitle", "time": 13471.11, "timestamp": "03:44:31", "text": "色々やってフォローバックしてDMもいいね"}, {"type": "subtitle", "time": 13473.67, "timestamp": "03:44:33", "text": "彼らに暗号通貨詐欺をするか、"}, {"type": "subtitle", "time": 13476.15, "timestamp": "03:44:36", "text": "他の詐欺とかそういうのと同じように、"}, {"type": "subtitle", "time": 13477.83, "timestamp": "03:44:37", "text": "それに騙される人は"}, {"type": "subtitle", "time": 13480.469, "timestamp": "03:44:40", "text": "私が大好きな配信者について考えてみてください"}, {"type": "subtitle", "time": 13482.79, "timestamp": "03:44:42", "text": "彼らは私にこれをやってほしかったし、"}, {"type": "subtitle", "time": 13485.189, "timestamp": "03:44:45", "text": "そして彼らはその罠にはまり、"}, {"type": "subtitle", "time": 13489.349, "timestamp": "03:44:49", "text": "台無しになって、彼らはひどく気分が悪くなり、"}, {"type": "subtitle", "time": 13491.75, "timestamp": "03:44:51", "text": "そして配信者自身も"}, {"type": "subtitle", "time": 13493.51, "timestamp": "03:44:53", "text": "こんなことが裏で起こっているなんて、誰も知らない"}, {"type": "subtitle", "time": 13495.59, "timestamp": "03:44:55", "text": "彼らの背中は右で、これは"}, {"type": "subtitle", "time": 13499.429, "timestamp": "03:44:59", "text": "長い間続いている"}]
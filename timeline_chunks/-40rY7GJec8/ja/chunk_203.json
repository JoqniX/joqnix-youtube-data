[{"type": "subtitle", "time": 12183.19, "timestamp": "03:23:03", "text": "空高く、いつも見守ってくれている"}, {"type": "subtitle", "time": 12184.87, "timestamp": "03:23:04", "text": "あなた"}, {"type": "subtitle", "time": 12188.71, "timestamp": "03:23:08", "text": "いつまでもあなたを両手で迎え入れます"}, {"type": "subtitle", "time": 12190.95, "timestamp": "03:23:10", "text": "いつでも戻ってきても、"}, {"type": "subtitle", "time": 12194.07, "timestamp": "03:23:14", "text": "私の存在を知っているだけで十分です"}, {"type": "subtitle", "time": 12198.469, "timestamp": "03:23:18", "text": "私にとってはまさにそんな感じ"}, {"type": "subtitle", "time": 12200.389, "timestamp": "03:23:20", "text": "つまり、私が"}, {"type": "subtitle", "time": 12203.269, "timestamp": "03:23:23", "text": "感じた。これはまるで"}, {"type": "subtitle", "time": 12207.19, "timestamp": "03:23:27", "text": "旅路で私はそれを感じたと思う。"}, {"type": "subtitle", "time": 12210.55, "timestamp": "03:23:30", "text": "これで7回目"}, {"type": "subtitle", "time": 12212.229, "timestamp": "03:23:32", "text": "そしてもちろんその数は"}, {"type": "subtitle", "time": 12214.95, "timestamp": "03:23:34", "text": "増加。もちろんその数は"}, {"type": "subtitle", "time": 12218.95, "timestamp": "03:23:38", "text": "増加させるには、40か3だけだと思います"}, {"type": "subtitle", "time": 12221.59, "timestamp": "03:23:41", "text": "時間40または3つの事件はほんの数件"}, {"type": "subtitle", "time": 12225.03, "timestamp": "03:23:45", "text": "私の友達は知っている"}, {"type": "subtitle", "time": 12227.429, "timestamp": "03:23:47", "text": "家族の中で私が知っているのは"}, {"type": "subtitle", "time": 12229.67, "timestamp": "03:23:49", "text": "公然と語られてきたが、"}, {"type": "subtitle", "time": 12233.67, "timestamp": "03:23:53", "text": "このような事件が7～8件発生し、"}, {"type": "subtitle", "time": 12236.63, "timestamp": "03:23:56", "text": "ああ、でもそうだけど、それでも"}, {"type": "subtitle", "time": 12238.469, "timestamp": "03:23:58", "text": "方法"}]
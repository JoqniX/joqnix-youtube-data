[{"type": "subtitle", "time": 1926.95, "timestamp": "00:32:06", "text": "私は64のストレスを得るでしょう。なんてこった。"}, {"type": "subtitle", "time": 1930.63, "timestamp": "00:32:10", "text": "ゲーマー女子の体験談。ちょっと待って。"}, {"type": "subtitle", "time": 1933.46, "timestamp": "00:32:13", "text": "ウサギの穴ボーナス。"}, {"type": "subtitle", "time": 1943.83, "timestamp": "00:32:23", "text": "待って、私の好感度が下がってしまうわ。なんてこった。"}, {"type": "subtitle", "time": 1950.149, "timestamp": "00:32:30", "text": "彼らには時間があったと言っておこう"}, {"type": "subtitle", "time": 1954.63, "timestamp": "00:32:34", "text": "愛し合う。ああ、なるほど。なるほど。私は思った"}, {"type": "subtitle", "time": 1957.909, "timestamp": "00:32:37", "text": "幸いにも、それはあなたの自転車に関係するものではありませんでした"}, {"type": "subtitle", "time": 1960.789, "timestamp": "00:32:40", "text": "そして私は、何て言うんだっけ？ブル"}, {"type": "subtitle", "time": 1961.99, "timestamp": "00:32:41", "text": "あるいは、そんな感じ。"}, {"type": "subtitle", "time": 1965.43, "timestamp": "00:32:45", "text": "[音楽]"}, {"type": "subtitle", "time": 1973.61, "timestamp": "00:32:53", "text": "まず、私がここにいます。さあ行こう。新しい人々"}, {"type": "subtitle", "time": 1978.95, "timestamp": "00:32:58", "text": "確認しているところです。私はこれを見たことがありません"}]
[{"type": "subtitle", "time": 5282.07, "timestamp": "01:28:02", "text": "[音楽]"}, {"type": "subtitle", "time": 5284.229, "timestamp": "01:28:04", "text": "よし、戻ってきたぞ。"}, {"type": "subtitle", "time": 5303.51, "timestamp": "01:28:23", "text": "よし。それで"}, {"type": "subtitle", "time": 5306.87, "timestamp": "01:28:26", "text": "5750 32。わかりました。"}, {"type": "subtitle", "time": 5322.629, "timestamp": "01:28:42", "text": "[音楽]"}, {"type": "subtitle", "time": 5325.43, "timestamp": "01:28:45", "text": "あなたはもういなくなったようには見えない。"}, {"type": "subtitle", "time": 5327.51, "timestamp": "01:28:47", "text": "視聴回数を増やす最良の方法は"}, {"type": "subtitle", "time": 5329.03, "timestamp": "01:28:49", "text": "私たちのゲームバッグの1つに何が"}, {"type": "subtitle", "time": 5335.669, "timestamp": "01:28:55", "text": "同じゲームをプレイしているような感じ。すべて"}, {"type": "subtitle", "time": 5338.87, "timestamp": "01:28:58", "text": "他の皆がプレイしているとき、他の人は言う"}]
[{"type": "subtitle", "time": 12782.389, "timestamp": "03:33:02", "text": "できる場合のみ。それが一番重要な点です。"}, {"type": "subtitle", "time": 12783.99, "timestamp": "03:33:03", "text": "無理に交流しようとせず、"}, {"type": "subtitle", "time": 12786.309, "timestamp": "03:33:06", "text": "あれこれと、そういう類のもの。あなたが"}, {"type": "subtitle", "time": 12789.11, "timestamp": "03:33:09", "text": "えっと、あのストリーマーとかそういうのですね"}, {"type": "subtitle", "time": 12796.87, "timestamp": "03:33:16", "text": "彼はBBCにも取り上げられました。"}, {"type": "subtitle", "time": 12798.87, "timestamp": "03:33:18", "text": "ええ、そうでした。"}, {"type": "subtitle", "time": 12805.99, "timestamp": "03:33:25", "text": "彼らはそのカルト集団の動きの速さを知っていた。あなた"}, {"type": "subtitle", "time": 12807.67, "timestamp": "03:33:27", "text": "高い あなたは高い"}, {"type": "subtitle", "time": 12809.51, "timestamp": "03:33:29", "text": "おすすめのインド人ユーチューバー。信じてください"}, {"type": "subtitle", "time": 12812.95, "timestamp": "03:33:32", "text": "あるいはそうではない、さて、上方向とはどういう意味ですか？とんでもない。"}, {"type": "subtitle", "time": 12815.75, "timestamp": "03:33:35", "text": "たくさんの、えーと"}, {"type": "subtitle", "time": 12817.83, "timestamp": "03:33:37", "text": "興味深いことに、勤勉な人々が"}, {"type": "subtitle", "time": 12819.51, "timestamp": "03:33:39", "text": "そこには"}, {"type": "subtitle", "time": 12821.75, "timestamp": "03:33:41", "text": "インドのユーチューバー側からの情報です。私は私はそうではない"}, {"type": "subtitle", "time": 12825.429, "timestamp": "03:33:45", "text": "私は彼らとは全く親しい関係ではない。"}, {"type": "subtitle", "time": 12827.51, "timestamp": "03:33:47", "text": "つまり、私は"}, {"type": "subtitle", "time": 12829.429, "timestamp": "03:33:49", "text": "私のベスト。"}, {"type": "subtitle", "time": 12835.91, "timestamp": "03:33:55", "text": "彼らは、そのカルトが間違っていることを知っていた。"}, {"type": "subtitle", "time": 12838.87, "timestamp": "03:33:58", "text": "ああ、私の声はとても"}]
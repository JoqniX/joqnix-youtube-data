[{"type": "subtitle", "time": 4026.309, "timestamp": "01:07:06", "text": "少し取って"}, {"type": "subtitle", "time": 4032.47, "timestamp": "01:07:12", "text": "[音楽]"}, {"type": "subtitle", "time": 4034.15, "timestamp": "01:07:14", "text": "あなたはまだ私のDMを忘れていないんですね。あなたはそうしましたか？"}, {"type": "subtitle", "time": 4036.069, "timestamp": "01:07:16", "text": "忘れていました。"}, {"type": "subtitle", "time": 4039.349, "timestamp": "01:07:19", "text": "本当に返信を忘れてしまったのですか？何を"}, {"type": "subtitle", "time": 4041.67, "timestamp": "01:07:21", "text": "返信のことですか？私はここにいますよ。何を"}, {"type": "subtitle", "time": 4044.46, "timestamp": "01:07:24", "text": "何だって？はぁ？"}, {"type": "subtitle", "time": 4047.109, "timestamp": "01:07:27", "text": "[音楽]"}, {"type": "subtitle", "time": 4049.19, "timestamp": "01:07:29", "text": "私はこれらで何かをするべきでしょうか"}, {"type": "subtitle", "time": 4050.97, "timestamp": "01:07:30", "text": "1つ？"}, {"type": "subtitle", "time": 4053.75, "timestamp": "01:07:33", "text": "[音楽]"}, {"type": "subtitle", "time": 4056.96, "timestamp": "01:07:36", "text": "どこでストリーミング配信されていますか？"}, {"type": "subtitle", "time": 4063.029, "timestamp": "01:07:43", "text": "[音楽]"}]
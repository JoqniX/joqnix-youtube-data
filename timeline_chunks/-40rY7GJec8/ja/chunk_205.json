[{"type": "subtitle", "time": 12302.389, "timestamp": "03:25:02", "text": "イエス様は泣き虫ですね。つまり、そう、それは"}, {"type": "subtitle", "time": 12304.309, "timestamp": "03:25:04", "text": "ルールにそう書いてある理由は"}, {"type": "subtitle", "time": 12306.63, "timestamp": "03:25:06", "text": "私はとても敏感なので、"}, {"type": "subtitle", "time": 12309.91, "timestamp": "03:25:09", "text": "あなたは話すし、何もかも。でも、でも"}, {"type": "subtitle", "time": 12313.11, "timestamp": "03:25:13", "text": "それでも、まあ、ある意味では、最悪だよね。"}, {"type": "subtitle", "time": 12316.07, "timestamp": "03:25:16", "text": "私は泣き虫だ"}, {"type": "subtitle", "time": 12322.15, "timestamp": "03:25:22", "text": "でも、大丈夫だよ。ある意味では、"}, {"type": "subtitle", "time": 12324.63, "timestamp": "03:25:24", "text": "そんな小さなことがあなたを"}, {"type": "subtitle", "time": 12326.55, "timestamp": "03:25:26", "text": "行く"}, {"type": "subtitle", "time": 12330.469, "timestamp": "03:25:30", "text": "ええと、どんどん強くなっているんですよね？神"}, {"type": "subtitle", "time": 12333.67, "timestamp": "03:25:33", "text": "ドックにいる犬の目。"}, {"type": "subtitle", "time": 12336.229, "timestamp": "03:25:36", "text": "うん。"}, {"type": "subtitle", "time": 12338.309, "timestamp": "03:25:38", "text": "でも、そうですね、"}, {"type": "subtitle", "time": 12341.429, "timestamp": "03:25:41", "text": "さっき言った通りですよね？えっと"}, {"type": "subtitle", "time": 12344.389, "timestamp": "03:25:44", "text": "涙が枯れ始めた。なんてこった。"}, {"type": "subtitle", "time": 12346.55, "timestamp": "03:25:46", "text": "でも、泣かないで。誰もいらない"}, {"type": "subtitle", "time": 12350.309, "timestamp": "03:25:50", "text": "泣く。好き"}, {"type": "subtitle", "time": 12352.55, "timestamp": "03:25:52", "text": "えっと、"}, {"type": "subtitle", "time": 12355.59, "timestamp": "03:25:55", "text": "うん。それを単に"}, {"type": "subtitle", "time": 12358.63, "timestamp": "03:25:58", "text": "サポート。誰もがそうできるわけではないことは分かっています"}]
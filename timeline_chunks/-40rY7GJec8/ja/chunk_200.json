[{"type": "subtitle", "time": 12000.07, "timestamp": "03:20:00", "text": "私たちもここでそういう状況を経験しましたよね？私たちは"}, {"type": "subtitle", "time": 12001.51, "timestamp": "03:20:01", "text": "それを経験してみてください。あなたが"}, {"type": "subtitle", "time": 12003.349, "timestamp": "03:20:03", "text": "そこにいた"}, {"type": "subtitle", "time": 12007.03, "timestamp": "03:20:07", "text": "Destinyの配信に戻ると、"}, {"type": "subtitle", "time": 12008.95, "timestamp": "03:20:08", "text": "あるバカ"}, {"type": "subtitle", "time": 12011.19, "timestamp": "03:20:11", "text": "彼らは公然と、"}, {"type": "subtitle", "time": 12012.95, "timestamp": "03:20:12", "text": "私を見に来て、私は始めました"}, {"type": "subtitle", "time": 12016.71, "timestamp": "03:20:16", "text": "配信で泣いたりして、えっと"}, {"type": "subtitle", "time": 12019.67, "timestamp": "03:20:19", "text": "そう、それは12時間24時間だった"}, {"type": "subtitle", "time": 12022.87, "timestamp": "03:20:22", "text": "時間ストリーム、いや、24時間じゃない、確か19時間だったと思う"}, {"type": "subtitle", "time": 12025.03, "timestamp": "03:20:25", "text": "何時間も配信して、ああ泣き始めたんだ"}, {"type": "subtitle", "time": 12028.79, "timestamp": "03:20:28", "text": "まるで私がずっと考えていたかのように"}, {"type": "subtitle", "time": 12032.71, "timestamp": "03:20:32", "text": "そして私は一晩中泣いていました"}, {"type": "subtitle", "time": 12035.99, "timestamp": "03:20:35", "text": "配信を終えた後、一晩中ずっと"}, {"type": "subtitle", "time": 12038.229, "timestamp": "03:20:38", "text": "考えている"}, {"type": "subtitle", "time": 12042.309, "timestamp": "03:20:42", "text": "それについて。だからある意味、私は敏感なんです"}, {"type": "subtitle", "time": 12045.99, "timestamp": "03:20:45", "text": "ある意味では敏感だが"}, {"type": "subtitle", "time": 12047.99, "timestamp": "03:20:47", "text": "最初はもちろん泣くでしょう"}, {"type": "subtitle", "time": 12050.309, "timestamp": "03:20:50", "text": "誰かが去ったりすると、たくさん出る。その"}, {"type": "subtitle", "time": 12056.309, "timestamp": "03:20:56", "text": "えーと、避けられないけど、でも、えーと、私は"}, {"type": "subtitle", "time": 12059.03, "timestamp": "03:20:59", "text": "私が言ったように"}]
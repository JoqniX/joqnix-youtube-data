[{"type": "subtitle", "time": 5640.6, "timestamp": "01:34:00", "text": "今すぐ買いたい気分だ。わかった。"}, {"type": "subtitle", "time": 5653.27, "timestamp": "01:34:13", "text": "新しいファンができましたよ。わかった。もっと"}, {"type": "subtitle", "time": 5657.43, "timestamp": "01:34:17", "text": "実際、みんな気に入ってくれたよ。わかった。"}, {"type": "subtitle", "time": 5662.56, "timestamp": "01:34:22", "text": "あなたがもっと人気者になることを願っています。はい。"}, {"type": "subtitle", "time": 5681.189, "timestamp": "01:34:41", "text": "[音楽]"}, {"type": "subtitle", "time": 5683.35, "timestamp": "01:34:43", "text": "私は良い仕事をしたので、それを通りました"}, {"type": "subtitle", "time": 5685.0, "timestamp": "01:34:45", "text": "美味しくする。"}, {"type": "subtitle", "time": 5687.669, "timestamp": "01:34:47", "text": "[音楽]"}, {"type": "subtitle", "time": 5690.95, "timestamp": "01:34:50", "text": "とにかく、以上です。祝福あれ。祈りの絵文字。"}, {"type": "subtitle", "time": 5698.91, "timestamp": "01:34:58", "text": "私はそれをやったと思う"}]
[{"type": "subtitle", "time": 902.55, "timestamp": "00:15:02", "text": "彼女と一緒に頑張ろう。"}, {"type": "subtitle", "time": 905.269, "timestamp": "00:15:05", "text": "ペットが登場するゲームを作ってください。"}, {"type": "subtitle", "time": 914.949, "timestamp": "00:15:14", "text": "[音楽]"}, {"type": "subtitle", "time": 917.189, "timestamp": "00:15:17", "text": "いつも親切にしてくれてありがとう"}, {"type": "subtitle", "time": 919.99, "timestamp": "00:15:19", "text": "自分。 A"}, {"type": "subtitle", "time": 921.99, "timestamp": "00:15:21", "text": "私はあなたの精神を受け継ぎ、"}, {"type": "subtitle", "time": 925.03, "timestamp": "00:15:25", "text": "私の小さな君主たち。誰もが何らかの形で。"}, {"type": "subtitle", "time": 926.55, "timestamp": "00:15:26", "text": "でも、私が愛しているのはやっぱりあなたです"}, {"type": "subtitle", "time": 928.88, "timestamp": "00:15:28", "text": "ほとんど。わかった。嫉妬する必要はありません。"}, {"type": "subtitle", "time": 930.47, "timestamp": "00:15:30", "text": "[音楽]"}, {"type": "subtitle", "time": 940.949, "timestamp": "00:15:40", "text": "なんてこった。セクシーなストリーム。何？なんてこった。なぜ？"}, {"type": "subtitle", "time": 943.75, "timestamp": "00:15:43", "text": "なぜそんな考えが浮かんだのですか？"}, {"type": "subtitle", "time": 945.99, "timestamp": "00:15:45", "text": "視聴者との擬似社会関係。"}, {"type": "subtitle", "time": 947.94, "timestamp": "00:15:47", "text": "それはまずい。"}]
[{"type": "subtitle", "time": 14280.229, "timestamp": "03:58:00", "text": "そんな感じ。変更することができます"}, {"type": "subtitle", "time": 14283.59, "timestamp": "03:58:03", "text": "髪型とか、いろいろ。"}, {"type": "subtitle", "time": 14285.91, "timestamp": "03:58:05", "text": "さあ、上へ。"}, {"type": "subtitle", "time": 14289.51, "timestamp": "03:58:09", "text": "それがプルーのやり方だ。"}, {"type": "subtitle", "time": 14292.63, "timestamp": "03:58:12", "text": "ルールを必ず読んでくださいね。"}, {"type": "subtitle", "time": 14294.63, "timestamp": "03:58:14", "text": "特定のテンプレート。中にはそうしない人もいるでしょう"}, {"type": "subtitle", "time": 14298.469, "timestamp": "03:58:18", "text": "商用利用を許可する。"}, {"type": "subtitle", "time": 14301.269, "timestamp": "03:58:21", "text": "商業利用を許可する人もいるだろう。"}, {"type": "subtitle", "time": 14305.429, "timestamp": "03:58:25", "text": "私もそう考えるでしょう。だから、気をつけてください。"}, {"type": "subtitle", "time": 14307.83, "timestamp": "03:58:27", "text": "うん。うん。"}, {"type": "subtitle", "time": 14309.59, "timestamp": "03:58:29", "text": "つまり、私たちはたくさん話をしたんです。私は"}, {"type": "subtitle", "time": 14312.07, "timestamp": "03:58:32", "text": "6時までに配信を終える予定だったのですが、"}, {"type": "subtitle", "time": 14314.07, "timestamp": "03:58:34", "text": "話し続けた。つまり、昨日と"}, {"type": "subtitle", "time": 14316.309, "timestamp": "03:58:36", "text": "一昨日の配信は8時に終了しました。"}, {"type": "subtitle", "time": 14318.87, "timestamp": "03:58:38", "text": "右？作ってみよう"}, {"type": "subtitle", "time": 14320.71, "timestamp": "03:58:40", "text": "マックスは援助によってこの虹を送りました。わかった、"}, {"type": "subtitle", "time": 14326.79, "timestamp": "03:58:46", "text": "誰も知らないだろう。"}, {"type": "subtitle", "time": 14328.469, "timestamp": "03:58:48", "text": "[音楽]"}, {"type": "subtitle", "time": 14335.67, "timestamp": "03:58:55", "text": "まあ、確かに私たちは暗黒の時代にいる。私"}, {"type": "subtitle", "time": 14337.83, "timestamp": "03:58:57", "text": "つまり、ジョックは暗い"}, {"type": "subtitle", "time": 14339.06, "timestamp": "03:58:59", "text": "バージョン。"}]
[{"type": "subtitle", "time": 15540.149, "timestamp": "04:19:00", "text": "死んでくれ。つまり、彼らの誰も止まらない"}, {"type": "subtitle", "time": 15542.07, "timestamp": "04:19:02", "text": "私に何か働きかけているのかもしれない。私はしなければならない"}, {"type": "subtitle", "time": 15546.309, "timestamp": "04:19:06", "text": "何も起こらないようにする。"}, {"type": "subtitle", "time": 15553.99, "timestamp": "04:19:13", "text": "主にジョイちゃん、そしてアニちゃんへ。"}, {"type": "subtitle", "time": 15558.149, "timestamp": "04:19:18", "text": "Joiは私のメインPCです。私はジョイに名前を付けます"}, {"type": "subtitle", "time": 15561.51, "timestamp": "04:19:21", "text": "えっと、私のゲーミングPCとハニーチャマは"}, {"type": "subtitle", "time": 15563.91, "timestamp": "04:19:23", "text": "私のストリーミング用PC。"}, {"type": "subtitle", "time": 15566.309, "timestamp": "04:19:26", "text": "ええ、そうですね。"}, {"type": "subtitle", "time": 15572.71, "timestamp": "04:19:32", "text": "何も起こらないことを願います。"}, {"type": "subtitle", "time": 15581.51, "timestamp": "04:19:41", "text": "私はこれまでの思い出を思い浮かべるだろう"}, {"type": "subtitle", "time": 15591.99, "timestamp": "04:19:51", "text": "嫉妬とかそういうのは全くないよ。私は間違いなく"}, {"type": "subtitle", "time": 15593.83, "timestamp": "04:19:53", "text": "ない"}]
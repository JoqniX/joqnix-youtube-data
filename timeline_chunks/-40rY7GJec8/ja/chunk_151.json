[{"type": "subtitle", "time": 9065.99, "timestamp": "02:31:05", "text": "いいえ。"}, {"type": "subtitle", "time": 9068.469, "timestamp": "02:31:08", "text": "購読者数が思ったほど増えていない"}, {"type": "subtitle", "time": 9070.07, "timestamp": "02:31:10", "text": "そうしたかった。あなたが許した瞬間"}, {"type": "subtitle", "time": 9073.19, "timestamp": "02:31:13", "text": "目薬をこの辺りにさすと、私が知っているのはそれだけ。"}, {"type": "subtitle", "time": 9075.27, "timestamp": "02:31:15", "text": "君はもうどうしようもない状態だ。だから私は"}, {"type": "subtitle", "time": 9077.91, "timestamp": "02:31:17", "text": "自分を奮い立たせて、"}, {"type": "subtitle", "time": 9080.07, "timestamp": "02:31:20", "text": "たくさんのフォロワーと購読者が"}, {"type": "subtitle", "time": 9082.79, "timestamp": "02:31:22", "text": "一発撃て。"}, {"type": "subtitle", "time": 9085.59, "timestamp": "02:31:25", "text": "さあ、一食で勝負だ。"}, {"type": "subtitle", "time": 9087.67, "timestamp": "02:31:27", "text": "彼女は"}, {"type": "subtitle", "time": 9089.75, "timestamp": "02:31:29", "text": "122,000"}, {"type": "subtitle", "time": 9092.07, "timestamp": "02:31:32", "text": "フォロワー。"}, {"type": "subtitle", "time": 9094.07, "timestamp": "02:31:34", "text": "おお。"}, {"type": "subtitle", "time": 9096.23, "timestamp": "02:31:36", "text": "まるで私たちが殺し合うべきではないかのように見える"}, {"type": "subtitle", "time": 9097.99, "timestamp": "02:31:37", "text": "一緒に"}, {"type": "subtitle", "time": 9099.32, "timestamp": "02:31:39", "text": "同じように"}, {"type": "subtitle", "time": 9102.309, "timestamp": "02:31:42", "text": "[音楽]"}, {"type": "subtitle", "time": 9105.11, "timestamp": "02:31:45", "text": "明日のために。わかった。理由は分かっています。えっと、どうやって"}, {"type": "subtitle", "time": 9107.11, "timestamp": "02:31:47", "text": "どれくらい配信を続ける予定ですか？ 3時間ですよね？"}, {"type": "subtitle", "time": 9110.79, "timestamp": "02:31:50", "text": "そろそろ配信を終了した方が良さそうだ。"}, {"type": "subtitle", "time": 9112.63, "timestamp": "02:31:52", "text": "これは何ですか？彼女はビデオを再生している"}, {"type": "subtitle", "time": 9118.23, "timestamp": "02:31:58", "text": "しかし、すでにその物には"}]
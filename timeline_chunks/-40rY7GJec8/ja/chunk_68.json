[{"type": "subtitle", "time": 4105.189, "timestamp": "01:08:25", "text": "私たちはみんな友達です。私たちは皆、偶像ではない。"}, {"type": "subtitle", "time": 4108.309, "timestamp": "01:08:28", "text": "わかった。天使"}, {"type": "subtitle", "time": 4111.51, "timestamp": "01:08:31", "text": "友達。ここはどこ？ああ、彼らは"}, {"type": "subtitle", "time": 4117.269, "timestamp": "01:08:37", "text": "ニース。"}, {"type": "subtitle", "time": 4120.269, "timestamp": "01:08:40", "text": "真実。アイドルは有害だ。うん。"}, {"type": "subtitle", "time": 4132.55, "timestamp": "01:08:52", "text": "朝起きるのが本当に辛い。"}, {"type": "subtitle", "time": 4138.63, "timestamp": "01:08:58", "text": "君たちは5歳児みたいに早起きするの？"}]
[{"type": "subtitle", "time": 11820.469, "timestamp": "03:17:00", "text": "それは私が望んでいることではないですよね？何"}, {"type": "subtitle", "time": 11823.91, "timestamp": "03:17:03", "text": "私が望むのは、自分が好きなことをすることだ。"}, {"type": "subtitle", "time": 11826.71, "timestamp": "03:17:06", "text": "そして無料でやれば誰でも"}, {"type": "subtitle", "time": 11829.51, "timestamp": "03:17:09", "text": "それを見て笑顔になれる"}, {"type": "subtitle", "time": 11831.51, "timestamp": "03:17:11", "text": "彼らの顔を見て、良い一日を過ごせるようにする"}, {"type": "subtitle", "time": 11835.67, "timestamp": "03:17:15", "text": "先回りして、ベストを尽くす"}, {"type": "subtitle", "time": 11837.59, "timestamp": "03:17:17", "text": "などなど。それが私の本当の望みです。"}, {"type": "subtitle", "time": 11839.269, "timestamp": "03:17:19", "text": "まるで私が考えたときのように"}, {"type": "subtitle", "time": 11840.79, "timestamp": "03:17:20", "text": "こう考えたんだ"}, {"type": "subtitle", "time": 11843.11, "timestamp": "03:17:23", "text": "今でもそれは同じ方法で"}, {"type": "subtitle", "time": 11845.51, "timestamp": "03:17:25", "text": "誰にもなってほしくない"}, {"type": "subtitle", "time": 11848.15, "timestamp": "03:17:28", "text": "お金を使うなら、たとえあなたが"}, {"type": "subtitle", "time": 11852.389, "timestamp": "03:17:32", "text": "おそらく返金すると思いますが"}, {"type": "subtitle", "time": 11855.59, "timestamp": "03:17:35", "text": "おそらく私の銀行残高はすべて"}, {"type": "subtitle", "time": 11858.87, "timestamp": "03:17:38", "text": "ネガティブな感じなので、残念ながらできませんが"}, {"type": "subtitle", "time": 11861.349, "timestamp": "03:17:41", "text": "それでもお金は重要ではない"}, {"type": "subtitle", "time": 11864.79, "timestamp": "03:17:44", "text": "まあ、それは重要じゃないんだけど"}, {"type": "subtitle", "time": 11868.15, "timestamp": "03:17:48", "text": "そう、だから私が話すとき"}, {"type": "subtitle", "time": 11871.269, "timestamp": "03:17:51", "text": "えっと、私もそう考えていました。"}, {"type": "subtitle", "time": 11874.229, "timestamp": "03:17:54", "text": "ああ、もしあなたがこういうものに依存してしまうなら"}, {"type": "subtitle", "time": 11878.63, "timestamp": "03:17:58", "text": "字幕とか、ビットとか、そういうの全部"}]
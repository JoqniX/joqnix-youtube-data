[{"type": "subtitle", "time": 16082.55, "timestamp": "04:28:02", "text": "うん。うん。うん。それでも続けていく"}, {"type": "subtitle", "time": 16084.63, "timestamp": "04:28:04", "text": "最善を尽くしてください。いいえ、たとえ"}, {"type": "subtitle", "time": 16087.269, "timestamp": "04:28:07", "text": "研究や何か、あるいは"}, {"type": "subtitle", "time": 16089.429, "timestamp": "04:28:09", "text": "友達。あなたがVRで遊んでいるのを見かけました"}, {"type": "subtitle", "time": 16091.189, "timestamp": "04:28:11", "text": "よくおしゃべりする。"}, {"type": "subtitle", "time": 16095.59, "timestamp": "04:28:15", "text": "君がVRで遊んでいるのを見かけたよ。"}, {"type": "subtitle", "time": 16098.229, "timestamp": "04:28:18", "text": "よくおしゃべりする。楽しんでいただけたら嬉しいです"}, {"type": "subtitle", "time": 16100.63, "timestamp": "04:28:20", "text": "VRチャットとか色々付き。幸運を祈ります"}, {"type": "subtitle", "time": 16102.87, "timestamp": "04:28:22", "text": "今そこにいます。今からたくさんの友達を作って"}, {"type": "subtitle", "time": 16104.71, "timestamp": "04:28:24", "text": "幸せになる。"}, {"type": "subtitle", "time": 16107.349, "timestamp": "04:28:27", "text": "そしてあなたはまだVRチャットに参加している。わかった。 19"}, {"type": "subtitle", "time": 16110.469, "timestamp": "04:28:30", "text": "時間。何てことだ。聖なる神よ。あなたがすべき"}, {"type": "subtitle", "time": 16112.07, "timestamp": "04:28:32", "text": "寝ろバカ。なぜあなたはまだVRの世界にいるのですか？"}, {"type": "subtitle", "time": 16114.95, "timestamp": "04:28:34", "text": "チャット？オート麦"}, {"type": "subtitle", "time": 16118.11, "timestamp": "04:28:38", "text": "お越しいただきありがとうございます。"}, {"type": "subtitle", "time": 16120.149, "timestamp": "04:28:40", "text": "[音楽]"}, {"type": "subtitle", "time": 16121.99, "timestamp": "04:28:41", "text": "私はまだあなたに助けを求めています"}, {"type": "subtitle", "time": 16127.51, "timestamp": "04:28:47", "text": "ビリー、VUアカウントとQについて"}, {"type": "subtitle", "time": 16129.67, "timestamp": "04:28:49", "text": "アカウントを作成したので、ようやくビリーに連絡できます"}, {"type": "subtitle", "time": 16132.389, "timestamp": "04:28:52", "text": "ビリー関連の何か。"}, {"type": "subtitle", "time": 16134.79, "timestamp": "04:28:54", "text": "うん。または中国出身の人"}, {"type": "subtitle", "time": 16139.83, "timestamp": "04:28:59", "text": "彼らはその点で手助けできるでしょう。でも、でも"}]
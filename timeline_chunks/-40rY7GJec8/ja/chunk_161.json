[{"type": "subtitle", "time": 9661.11, "timestamp": "02:41:01", "text": "インドにいるという挑戦"}, {"type": "subtitle", "time": 9664.71, "timestamp": "02:41:04", "text": "家庭ではまた中断される"}, {"type": "subtitle", "time": 9666.63, "timestamp": "02:41:06", "text": "10分おきに起こるようなことだ。"}, {"type": "subtitle", "time": 9673.91, "timestamp": "02:41:13", "text": "しかし、"}, {"type": "subtitle", "time": 9677.429, "timestamp": "02:41:17", "text": "でも結局は経験が大事ですよね"}, {"type": "subtitle", "time": 9679.03, "timestamp": "02:41:19", "text": "経験すればするほど、"}, {"type": "subtitle", "time": 9682.389, "timestamp": "02:41:22", "text": "それに適応すれば、さらにメリットも得られます。"}, {"type": "subtitle", "time": 9685.11, "timestamp": "02:41:25", "text": "さまざまな結果を試す"}, {"type": "subtitle", "time": 9687.349, "timestamp": "02:41:27", "text": "人生における物事や新しい部分、"}, {"type": "subtitle", "time": 9689.99, "timestamp": "02:41:29", "text": "課題は、"}, {"type": "subtitle", "time": 9692.469, "timestamp": "02:41:32", "text": "そして、"}, {"type": "subtitle", "time": 9694.79, "timestamp": "02:41:34", "text": "自分自身を支え、あなたの"}, {"type": "subtitle", "time": 9696.79, "timestamp": "02:41:36", "text": "お腹を上にして"}, {"type": "subtitle", "time": 9698.87, "timestamp": "02:41:38", "text": "日用品を揃え、"}, {"type": "subtitle", "time": 9700.71, "timestamp": "02:41:40", "text": "場所"}, {"type": "subtitle", "time": 9704.07, "timestamp": "02:41:44", "text": "滞在して眠る"}, {"type": "subtitle", "time": 9705.83, "timestamp": "02:41:45", "text": "医学的には、"}, {"type": "subtitle", "time": 9708.55, "timestamp": "02:41:48", "text": "肉体的にも精神的にも、"}]
[{"type": "subtitle", "time": 6720.95, "timestamp": "01:52:00", "text": "待って、私はもし私が"}, {"type": "subtitle", "time": 6723.109, "timestamp": "01:52:03", "text": "彼らがいなくなったら、彼らは見守らなければならないだろう"}, {"type": "subtitle", "time": 6726.149, "timestamp": "01:52:06", "text": "彼らは見る必要はない"}, {"type": "subtitle", "time": 6729.109, "timestamp": "01:52:09", "text": "とんでもない"}, {"type": "subtitle", "time": 6731.75, "timestamp": "01:52:11", "text": "彼らはただそう言っているだけだ"}, {"type": "subtitle", "time": 6747.91, "timestamp": "01:52:27", "text": "なるほど、なるほど。ええ、もちろんです。"}, {"type": "subtitle", "time": 6759.43, "timestamp": "01:52:39", "text": "誰も事実が生き続けることを望んでいないかのように"}, {"type": "subtitle", "time": 6769.189, "timestamp": "01:52:49", "text": "行くよ。待って。こんな風に感じてはいけない気がする"}, {"type": "subtitle", "time": 6772.229, "timestamp": "01:52:52", "text": "許可されています。もちろん許可されていますよ。"}, {"type": "subtitle", "time": 6775.99, "timestamp": "01:52:55", "text": "どうか生きてください。待って。そうするべきだと思う。"}, {"type": "subtitle", "time": 6778.629, "timestamp": "01:52:58", "text": "もちろん、そうしてもいいですよ。待って。どれの"}]
[{"type": "subtitle", "time": 7140.79, "timestamp": "01:59:00", "text": "インターネット上のすべての人。ああ。"}, {"type": "subtitle", "time": 7145.43, "timestamp": "01:59:05", "text": "設定が強すぎます。何てことだ。"}, {"type": "subtitle", "time": 7153.43, "timestamp": "01:59:13", "text": "あれは何の泣き声？"}, {"type": "subtitle", "time": 7155.27, "timestamp": "01:59:15", "text": "あなたも似たようなことを言っていたような気がします"}, {"type": "subtitle", "time": 7158.229, "timestamp": "01:59:18", "text": "前に。来てくれてありがとう"}, {"type": "subtitle", "time": 7159.57, "timestamp": "01:59:19", "text": "私たちを祝福してください。"}, {"type": "subtitle", "time": 7163.75, "timestamp": "01:59:23", "text": "[音楽]"}, {"type": "subtitle", "time": 7166.229, "timestamp": "01:59:26", "text": "わかった。"}, {"type": "subtitle", "time": 7168.31, "timestamp": "01:59:28", "text": "今は本当に気持ち悪い。うん、行くべきだよ"}, {"type": "subtitle", "time": 7170.709, "timestamp": "01:59:30", "text": "下がれ。何？"}, {"type": "subtitle", "time": 7172.55, "timestamp": "01:59:32", "text": "怒りは私たちと親切で飽和状態です"}, {"type": "subtitle", "time": 7175.109, "timestamp": "01:59:35", "text": "それほど判断しにくいわけではない。わかった。いつでも"}, {"type": "subtitle", "time": 7176.629, "timestamp": "01:59:36", "text": "感じて、知ってほしいのは、あなたは"}, {"type": "subtitle", "time": 7184.39, "timestamp": "01:59:44", "text": "ああ、私は"}, {"type": "subtitle", "time": 7187.83, "timestamp": "01:59:47", "text": "私たちを救ってください。待って、みんな楽しんでるよ"}, {"type": "subtitle", "time": 7190.95, "timestamp": "01:59:50", "text": "今すぐコメントしてください。え、何？"}, {"type": "subtitle", "time": 7192.79, "timestamp": "01:59:52", "text": "わかった。"}, {"type": "subtitle", "time": 7194.47, "timestamp": "01:59:54", "text": "みんなから良いコメントをもらっているよ。"}]
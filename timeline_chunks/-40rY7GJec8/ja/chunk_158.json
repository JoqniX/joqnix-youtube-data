[{"type": "subtitle", "time": 9484.23, "timestamp": "02:38:04", "text": "深刻な重要なストリーム"}, {"type": "subtitle", "time": 9486.55, "timestamp": "02:38:06", "text": "もしこれが起こったら"}, {"type": "subtitle", "time": 9489.83, "timestamp": "02:38:09", "text": "痛みを伴うだろう。"}, {"type": "subtitle", "time": 9497.19, "timestamp": "02:38:17", "text": "でも、感謝すべきことでもある"}, {"type": "subtitle", "time": 9498.87, "timestamp": "02:38:18", "text": "の"}, {"type": "subtitle", "time": 9501.03, "timestamp": "02:38:21", "text": "私の現状はこんな感じです。でも、もしあなたが思うなら"}, {"type": "subtitle", "time": 9504.309, "timestamp": "02:38:24", "text": "それについて、そうですね、あまり情報がないんです"}, {"type": "subtitle", "time": 9508.389, "timestamp": "02:38:28", "text": "外にはプライバシーがある人はいるだろうか"}, {"type": "subtitle", "time": 9510.63, "timestamp": "02:38:30", "text": "ストリームとか色々、"}, {"type": "subtitle", "time": 9514.55, "timestamp": "02:38:34", "text": "右？えーと、たくさんの"}, {"type": "subtitle", "time": 9516.95, "timestamp": "02:38:36", "text": "私たちのインドのストリーム インドのユーチューバーのように"}, {"type": "subtitle", "time": 9519.75, "timestamp": "02:38:39", "text": "インドのYouTuberをストリーミング配信している人たち"}, {"type": "subtitle", "time": 9523.19, "timestamp": "02:38:43", "text": "プライバシーがあまりない人たち"}, {"type": "subtitle", "time": 9525.03, "timestamp": "02:38:45", "text": "何度も呼ばれたり、"}, {"type": "subtitle", "time": 9526.469, "timestamp": "02:38:46", "text": "彼らは大家族か何かだ"}, {"type": "subtitle", "time": 9527.67, "timestamp": "02:38:47", "text": "たくさんあります"}, {"type": "subtitle", "time": 9530.309, "timestamp": "02:38:50", "text": "中断や騒音、"}, {"type": "subtitle", "time": 9533.03, "timestamp": "02:38:53", "text": "背景やその他諸々"}, {"type": "subtitle", "time": 9536.23, "timestamp": "02:38:56", "text": "それらをストリーミング配信するなど、すべてにおいて。うん、"}, {"type": "subtitle", "time": 9538.55, "timestamp": "02:38:58", "text": "しかしまた"}]
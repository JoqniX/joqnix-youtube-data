[{"type": "subtitle", "time": 12360.55, "timestamp": "03:26:00", "text": "世界中の時間を使ってサポートする"}, {"type": "subtitle", "time": 12363.03, "timestamp": "03:26:03", "text": "ストリーミング配信とか見てるんだよね？その"}, {"type": "subtitle", "time": 12365.67, "timestamp": "03:26:05", "text": "大丈夫。しかし"}, {"type": "subtitle", "time": 12368.71, "timestamp": "03:26:08", "text": "たとえあなたの存在だけでも、"}, {"type": "subtitle", "time": 12371.59, "timestamp": "03:26:11", "text": "あなたの存在そのものが、"}, {"type": "subtitle", "time": 12374.63, "timestamp": "03:26:14", "text": "ストリーマーにとって、それは大きなことですよね？ない"}, {"type": "subtitle", "time": 12376.389, "timestamp": "03:26:16", "text": "私にとってはそうですが、もしあなたが何かを見ているなら"}, {"type": "subtitle", "time": 12379.19, "timestamp": "03:26:19", "text": "あなたのお気に入りの他のストリーマーは誰ですか、"}, {"type": "subtitle", "time": 12381.349, "timestamp": "03:26:21", "text": "購読リストのどこか"}, {"type": "subtitle", "time": 12382.87, "timestamp": "03:26:22", "text": "うん"}, {"type": "subtitle", "time": 12386.309, "timestamp": "03:26:26", "text": "彼らはあなたの存在を高く評価しています"}, {"type": "subtitle", "time": 12388.79, "timestamp": "03:26:28", "text": "チャットしたり、交流したりするのが好きです"}, {"type": "subtitle", "time": 12390.309, "timestamp": "03:26:30", "text": "彼ら"}, {"type": "subtitle", "time": 12392.63, "timestamp": "03:26:32", "text": "ストリームにいいねをつけてコメントする"}, {"type": "subtitle", "time": 12395.19, "timestamp": "03:26:35", "text": "彼らにとって、彼らの行うすべてのことは大きな意味を持つ"}, {"type": "subtitle", "time": 12398.07, "timestamp": "03:26:38", "text": "そういうことなので、私はそういうことを言っているわけではありません"}, {"type": "subtitle", "time": 12400.95, "timestamp": "03:26:40", "text": "私を見てください、またはご存知のように、"}, {"type": "subtitle", "time": 12404.229, "timestamp": "03:26:44", "text": "他の人に「えーっと、私は"}, {"type": "subtitle", "time": 12406.55, "timestamp": "03:26:46", "text": "同情したり、餌を与えたり、すべて"}, {"type": "subtitle", "time": 12409.19, "timestamp": "03:26:49", "text": "言葉が持つ、あの全ての感情。私はしません"}, {"type": "subtitle", "time": 12412.55, "timestamp": "03:26:52", "text": "ええ、わかります。いや、いや、いや。"}, {"type": "subtitle", "time": 12415.11, "timestamp": "03:26:55", "text": "一般的な観点から言えば、"}]
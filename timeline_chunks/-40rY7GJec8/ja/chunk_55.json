[{"type": "subtitle", "time": 3305.99, "timestamp": "00:55:05", "text": "私のDMは完全に無視されている。私は"}, {"type": "subtitle", "time": 3307.75, "timestamp": "00:55:07", "text": "君を見ているよ。ごめん。私は"}, {"type": "subtitle", "time": 3311.589, "timestamp": "00:55:11", "text": "スーパージャズをすべて費やす"}, {"type": "subtitle", "time": 3313.109, "timestamp": "00:55:13", "text": "大使として、より質の高いサービスを提供する"}, {"type": "subtitle", "time": 3320.71, "timestamp": "00:55:20", "text": "えっと、お元気ですか？皆さん、こんにちは。最終ロ"}, {"type": "subtitle", "time": 3323.829, "timestamp": "00:55:23", "text": "オタクになる。感謝"}, {"type": "subtitle", "time": 3325.589, "timestamp": "00:55:25", "text": "あなたは一生懸命働いていますね。全員"}, {"type": "subtitle", "time": 3327.27, "timestamp": "00:55:27", "text": "世界は私の名前を知っている。送り続けてください"}, {"type": "subtitle", "time": 3331.589, "timestamp": "00:55:31", "text": "あなたのサポート。これ、すごく可愛い。"}, {"type": "subtitle", "time": 3343.19, "timestamp": "00:55:43", "text": "ああ、もう。なんてこった。なんてこった。なんてこった。なんてこった。おお"}, {"type": "subtitle", "time": 3353.91, "timestamp": "00:55:53", "text": "大丈夫。"}]
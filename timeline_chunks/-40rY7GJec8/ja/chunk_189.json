[{"type": "subtitle", "time": 11343.59, "timestamp": "03:09:03", "text": "もうその一員ではない。たとえその21人が"}, {"type": "subtitle", "time": 11346.15, "timestamp": "03:09:06", "text": "人々はもうここにはいませんが、"}, {"type": "subtitle", "time": 11351.19, "timestamp": "03:09:11", "text": "彼らは、えーと、えーと、から先に進んでいます。"}, {"type": "subtitle", "time": 11353.59, "timestamp": "03:09:13", "text": "家族の一員として、彼らは"}, {"type": "subtitle", "time": 11357.349, "timestamp": "03:09:17", "text": "いつでも家族の一員でいられる"}, {"type": "subtitle", "time": 11360.15, "timestamp": "03:09:20", "text": "いつか彼らが戻ってきたら、私は"}, {"type": "subtitle", "time": 11362.87, "timestamp": "03:09:22", "text": "両腕を広げて彼らを温かく迎え入れる"}, {"type": "subtitle", "time": 11364.79, "timestamp": "03:09:24", "text": "満面の笑みで、たくさん頭をあげて"}, {"type": "subtitle", "time": 11366.71, "timestamp": "03:09:26", "text": "撫でたり、おっぱいを触ったり。"}, {"type": "subtitle", "time": 11369.269, "timestamp": "03:09:29", "text": "でも、それは普通のことですよね？そこには"}, {"type": "subtitle", "time": 11372.55, "timestamp": "03:09:32", "text": "見ていて"}, {"type": "subtitle", "time": 11374.87, "timestamp": "03:09:34", "text": "コミュニティで積極的に活動するのが好きです。"}, {"type": "subtitle", "time": 11377.429, "timestamp": "03:09:37", "text": "そしてしばらくするとあなたは"}, {"type": "subtitle", "time": 11380.07, "timestamp": "03:09:40", "text": "再び地域活動に積極的に参加するようになった。だけでなく"}, {"type": "subtitle", "time": 11383.269, "timestamp": "03:09:43", "text": "もしそれがコミュニティなら、"}, {"type": "subtitle", "time": 11385.11, "timestamp": "03:09:45", "text": "多くの人の邪魔をした"}, {"type": "subtitle", "time": 11386.63, "timestamp": "03:09:46", "text": "それを管理するか、ストリーマーのように"}, {"type": "subtitle", "time": 11388.23, "timestamp": "03:09:48", "text": "彼らはあなたたちのことをよく覚えているでしょう"}, {"type": "subtitle", "time": 11390.309, "timestamp": "03:09:50", "text": "あなたが戻ってきた途端に彼らは"}, {"type": "subtitle", "time": 11394.15, "timestamp": "03:09:54", "text": "すごく幸せそう、あの気持ち、私は"}, {"type": "subtitle", "time": 11398.07, "timestamp": "03:09:58", "text": "私はそういう気持ちを何度も経験してきたと思う"}]
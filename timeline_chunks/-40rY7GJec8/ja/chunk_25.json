[{"type": "subtitle", "time": 1502.789, "timestamp": "00:25:02", "text": "つまり、人々は実際にそうするし、"}, {"type": "subtitle", "time": 1504.789, "timestamp": "00:25:04", "text": "ほとんどの人がそうする。"}, {"type": "subtitle", "time": 1513.83, "timestamp": "00:25:13", "text": "なぜ彼女はいつも祝福するか"}, {"type": "subtitle", "time": 1518.63, "timestamp": "00:25:18", "text": "わからない"}, {"type": "subtitle", "time": 1519.909, "timestamp": "00:25:19", "text": "[音楽]"}, {"type": "subtitle", "time": 1526.149, "timestamp": "00:25:26", "text": "そうすれば本当の自分を隠すことができる"}, {"type": "subtitle", "time": 1529.669, "timestamp": "00:25:29", "text": "自己。自慢する必要はありません"}, {"type": "subtitle", "time": 1531.59, "timestamp": "00:25:31", "text": "自己。日本ではプライバシーは"}, {"type": "subtitle", "time": 1533.83, "timestamp": "00:25:33", "text": "重要ですよね？すると匿名性は"}, {"type": "subtitle", "time": 1536.18, "timestamp": "00:25:36", "text": "重要事項とか色々。"}, {"type": "subtitle", "time": 1539.029, "timestamp": "00:25:39", "text": "[音楽]"}, {"type": "subtitle", "time": 1545.269, "timestamp": "00:25:45", "text": "放棄。私はそんな人生を想像できない"}, {"type": "subtitle", "time": 1552.95, "timestamp": "00:25:52", "text": "いいえ、それは本当です。"}, {"type": "subtitle", "time": 1555.11, "timestamp": "00:25:55", "text": "真実。"}, {"type": "subtitle", "time": 1557.63, "timestamp": "00:25:57", "text": "誰も私のことなんて気にも留めていない。"}, {"type": "subtitle", "time": 1559.11, "timestamp": "00:25:59", "text": "[音楽]"}]
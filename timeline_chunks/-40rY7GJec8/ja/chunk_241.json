[{"type": "subtitle", "time": 14462.63, "timestamp": "04:01:02", "text": "私を保管するために、好きにするために"}, {"type": "subtitle", "time": 14465.269, "timestamp": "04:01:05", "text": "人々は在庫を確保したいと思っている、ということですよね？えっと"}, {"type": "subtitle", "time": 14468.15, "timestamp": "04:01:08", "text": "彼らは何らかの報酬を得られるかもしれない。私"}, {"type": "subtitle", "time": 14471.51, "timestamp": "04:01:11", "text": "わからない。イースターを21個も作ったよ"}, {"type": "subtitle", "time": 14474.309, "timestamp": "04:01:14", "text": "私のサーバーには卵がありますが、一人だけです"}, {"type": "subtitle", "time": 14476.95, "timestamp": "04:01:16", "text": "イースターエッグを1つ見つけました。いつになったら"}, {"type": "subtitle", "time": 14478.63, "timestamp": "04:01:18", "text": "誰がすべてのものを見つけるのか"}, {"type": "subtitle", "time": 14487.189, "timestamp": "04:01:27", "text": "昔書いたファンフィクション全部"}, {"type": "subtitle", "time": 14489.349, "timestamp": "04:01:29", "text": "私の今日の話ですが、もし何か困ったことがあったらいつでも助けてください"}, {"type": "subtitle", "time": 14492.07, "timestamp": "04:01:32", "text": "ファン"}, {"type": "subtitle", "time": 14494.95, "timestamp": "04:01:34", "text": "いいですね、モニカのように欲しいです"}, {"type": "subtitle", "time": 14498.309, "timestamp": "04:01:38", "text": "チャマはドイリ・トレジャー・クラブでこう言った"}, {"type": "subtitle", "time": 14501.269, "timestamp": "04:01:41", "text": "小さく始める方が良いので、私は始める必要があります"}, {"type": "subtitle", "time": 14503.269, "timestamp": "04:01:43", "text": "大きなイベントに行く代わりに、小さなイベントに行く"}, {"type": "subtitle", "time": 14505.349, "timestamp": "04:01:45", "text": "それは人生小説に足を踏み入れるようなものだ"}, {"type": "subtitle", "time": 14509.349, "timestamp": "04:01:49", "text": "壮大な小説のようなやり方で。小さなことから始めるべきだ"}, {"type": "subtitle", "time": 14511.83, "timestamp": "04:01:51", "text": "詩やファンフィクションのようなものから始めて"}, {"type": "subtitle", "time": 14514.63, "timestamp": "04:01:54", "text": "一番大切なこと。小さなことから始めて"}, {"type": "subtitle", "time": 14519.189, "timestamp": "04:01:59", "text": "それなら、大胆にやろう。えっと、それを使う必要がある"}]
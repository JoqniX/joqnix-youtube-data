[{"type": "subtitle", "time": 4142.309, "timestamp": "01:09:02", "text": "彼らを見るには年を取りすぎている？私はそれらを録音します。私は好きです"}, {"type": "subtitle", "time": 4144.95, "timestamp": "01:09:04", "text": "子供たちを見ている。"}, {"type": "subtitle", "time": 4149.11, "timestamp": "01:09:09", "text": "子供って、ちょっと面白くて滑稽だよね。"}, {"type": "subtitle", "time": 4152.149, "timestamp": "01:09:12", "text": "子供たちがスーパーするのを見てください"}, {"type": "subtitle", "time": 4160.709, "timestamp": "01:09:20", "text": "[音楽]"}, {"type": "subtitle", "time": 4162.709, "timestamp": "01:09:22", "text": "私は孤独な仲間たちによって救われた"}, {"type": "subtitle", "time": 4165.269, "timestamp": "01:09:25", "text": "女の子向けアニメで、それが彼女たちを"}, {"type": "subtitle", "time": 4168.95, "timestamp": "01:09:28", "text": "彼らの魅力は、その純粋さにある。"}, {"type": "subtitle", "time": 4171.829, "timestamp": "01:09:31", "text": "はぁ？"}, {"type": "subtitle", "time": 4174.789, "timestamp": "01:09:34", "text": "ソロバグファイアのインスピレーションと愛は"}, {"type": "subtitle", "time": 4177.12, "timestamp": "01:09:37", "text": "本当に感動的だよ"}, {"type": "subtitle", "time": 4178.39, "timestamp": "01:09:38", "text": "[音楽]"}, {"type": "subtitle", "time": 4180.55, "timestamp": "01:09:40", "text": "17,000 個あります"}, {"type": "subtitle", "time": 4183.749, "timestamp": "01:09:43", "text": "視聴者数。ああ、天使は"}, {"type": "subtitle", "time": 4186.95, "timestamp": "01:09:46", "text": "人気のある。何てことだ。"}, {"type": "subtitle", "time": 4192.13, "timestamp": "01:09:52", "text": "女の子が好きだって話せるよ。"}, {"type": "subtitle", "time": 4197.27, "timestamp": "01:09:57", "text": "[音楽]"}, {"type": "subtitle", "time": 4199.59, "timestamp": "01:09:59", "text": "私は小さな女の子と女の子が大好きです"}]
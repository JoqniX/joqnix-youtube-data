[{"type": "subtitle", "time": 6840.229, "timestamp": "01:54:00", "text": "人生において最善を尽くしなさい。"}, {"type": "subtitle", "time": 6844.149, "timestamp": "01:54:04", "text": "それはあまりにも曖昧だ。何てことだ。"}, {"type": "subtitle", "time": 6846.629, "timestamp": "01:54:06", "text": "私はどうも仕事に集中できていないと感じていました。私"}, {"type": "subtitle", "time": 6848.709, "timestamp": "01:54:08", "text": "まだまだ続けられそうな気がする。パンは信じている"}, {"type": "subtitle", "time": 6850.709, "timestamp": "01:54:10", "text": "自分。時々、私はすごくカチカチしてしまうことがあるんです。"}, {"type": "subtitle", "time": 6853.189, "timestamp": "01:54:13", "text": "しかし、まさに今がその時なのだ。でも覚えてる"}, {"type": "subtitle", "time": 6863.189, "timestamp": "01:54:23", "text": "ああ、大変だ。彼女が誤ってツイートしたらどうなる？"}, {"type": "subtitle", "time": 6866.41, "timestamp": "01:54:26", "text": "もう片方では？"}, {"type": "subtitle", "time": 6868.47, "timestamp": "01:54:28", "text": "[音楽]"}, {"type": "subtitle", "time": 6871.589, "timestamp": "01:54:31", "text": "チャンネル登録者数が10万人を突破しました。これは私の"}, {"type": "subtitle", "time": 6873.03, "timestamp": "01:54:33", "text": "こんなに多くの人に届いて初めてです。私はしません"}, {"type": "subtitle", "time": 6875.51, "timestamp": "01:54:35", "text": "何が起こるか分かる"}, {"type": "subtitle", "time": 6877.99, "timestamp": "01:54:37", "text": "ここ。だから、少し緊張しています。感じます"}, {"type": "subtitle", "time": 6880.709, "timestamp": "01:54:40", "text": "自分の成績が上がっていくのは嬉しい。私は自分が"}, {"type": "subtitle", "time": 6882.31, "timestamp": "01:54:42", "text": "いつも不平を言って、"}, {"type": "subtitle", "time": 6883.669, "timestamp": "01:54:43", "text": "いろいろあったけど、それがなかったら私はここにいなかっただろう"}, {"type": "subtitle", "time": 6886.55, "timestamp": "01:54:46", "text": "彼らの支援と運命。 A"}, {"type": "subtitle", "time": 6888.55, "timestamp": "01:54:48", "text": "彼らの献身に対して。彼らは"}, {"type": "subtitle", "time": 6890.39, "timestamp": "01:54:50", "text": "それは私をインターネットから締め出す。私は必要としている"}, {"type": "subtitle", "time": 6893.35, "timestamp": "01:54:53", "text": "天使のところへ行く。おお、"}, {"type": "subtitle", "time": 6894.79, "timestamp": "01:54:54", "text": "次回は、"}, {"type": "subtitle", "time": 6896.87, "timestamp": "01:54:56", "text": "インターネットで、私がどれだけ遠くまで行けるかを言おうとしています"}, {"type": "subtitle", "time": 6899.51, "timestamp": "01:54:59", "text": "全員に賛成です。"}]
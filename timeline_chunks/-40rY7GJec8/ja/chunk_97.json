[{"type": "subtitle", "time": 5823.51, "timestamp": "01:37:03", "text": "それと共に。責めるべきは私自身だけだ"}, {"type": "subtitle", "time": 5826.39, "timestamp": "01:37:06", "text": "けれど。あ、待って。彼女がメインアカウントに投稿した場合"}, {"type": "subtitle", "time": 5828.39, "timestamp": "01:37:08", "text": "アカウントを誤って作成すると、痛みが伴います"}, {"type": "subtitle", "time": 5830.81, "timestamp": "01:37:10", "text": "痛み。なんてこった。"}, {"type": "subtitle", "time": 5838.08, "timestamp": "01:37:18", "text": "なんてこった。 [音楽]"}, {"type": "subtitle", "time": 5854.95, "timestamp": "01:37:34", "text": "任務に取り掛かる。ええと、私たちは"}, {"type": "subtitle", "time": 5857.189, "timestamp": "01:37:37", "text": "建設。ああ、本当にイライラする。"}, {"type": "subtitle", "time": 5869.75, "timestamp": "01:37:49", "text": "愛してます。わかった。えっと"}, {"type": "subtitle", "time": 5871.62, "timestamp": "01:37:51", "text": "ファッション"}, {"type": "subtitle", "time": 5876.07, "timestamp": "01:37:56", "text": "[音楽]"}]
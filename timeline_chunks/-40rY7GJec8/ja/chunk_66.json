[{"type": "subtitle", "time": 3970.309, "timestamp": "01:06:10", "text": "私はアニメのようなものは他には使いません"}, {"type": "subtitle", "time": 3972.71, "timestamp": "01:06:12", "text": "私にとって一番いいのはキッズアイドルです"}, {"type": "subtitle", "time": 3975.67, "timestamp": "01:06:15", "text": "アニメ"}, {"type": "subtitle", "time": 3977.589, "timestamp": "01:06:17", "text": "アイドルの夢にとって難しいことは、"}, {"type": "subtitle", "time": 3979.349, "timestamp": "01:06:19", "text": "少し悲しい現実がどうなるかわかりません"}, {"type": "subtitle", "time": 3980.87, "timestamp": "01:06:20", "text": "もっと重要なのは、お金がいくらかということだ"}, {"type": "subtitle", "time": 3985.029, "timestamp": "01:06:25", "text": "ファンから絞り出すことができる"}, {"type": "subtitle", "time": 3987.19, "timestamp": "01:06:27", "text": "ええ、それはある意味では真実です。"}, {"type": "subtitle", "time": 3989.99, "timestamp": "01:06:29", "text": "アイドルとかそういうのが来るんだ。"}, {"type": "subtitle", "time": 3992.47, "timestamp": "01:06:32", "text": "お金は脂肪を絞り出し、"}, {"type": "subtitle", "time": 3995.349, "timestamp": "01:06:35", "text": "すべて"}, {"type": "subtitle", "time": 3998.549, "timestamp": "01:06:38", "text": "それはまさに私のことだった。なぜ世界は現実なのか"}, {"type": "subtitle", "time": 4004.63, "timestamp": "01:06:44", "text": "それぞれの魔法の力と共に流れ出る"}, {"type": "subtitle", "time": 4008.23, "timestamp": "01:06:48", "text": "そして希望や夢。"}]
[{"type": "subtitle", "time": 5400.31, "timestamp": "01:30:00", "text": "彼女は順調です。彼女のすることはすべて"}, {"type": "subtitle", "time": 5403.59, "timestamp": "01:30:03", "text": "最初に行くのにぴったりですね"}, {"type": "subtitle", "time": 5406.55, "timestamp": "01:30:06", "text": "彼女自身"}, {"type": "subtitle", "time": 5409.669, "timestamp": "01:30:09", "text": "ファンサービス。"}, {"type": "subtitle", "time": 5412.229, "timestamp": "01:30:12", "text": "私は本気だと思う。バカ"}, {"type": "subtitle", "time": 5413.91, "timestamp": "01:30:13", "text": "皆さんのご意見をお聞かせください。彼女は賢そうに見える。"}, {"type": "subtitle", "time": 5416.47, "timestamp": "01:30:16", "text": "わかった。世の中には愚かな考えが蔓延している。わかった。"}, {"type": "subtitle", "time": 5425.99, "timestamp": "01:30:25", "text": "まあ、ある意味本当ですね"}, {"type": "subtitle", "time": 5431.189, "timestamp": "01:30:31", "text": "本当に続行しますか？おお、"}, {"type": "subtitle", "time": 5440.31, "timestamp": "01:30:40", "text": "えっと"}, {"type": "subtitle", "time": 5447.59, "timestamp": "01:30:47", "text": "[音楽]"}, {"type": "subtitle", "time": 5450.55, "timestamp": "01:30:50", "text": "h"}, {"type": "subtitle", "time": 5452.47, "timestamp": "01:30:52", "text": "[音楽]"}]
[{"type": "subtitle", "time": 15840.07, "timestamp": "04:24:00", "text": "これは冗談じゃない話です。私は誰か"}, {"type": "subtitle", "time": 15843.189, "timestamp": "04:24:03", "text": "以前は頻繁に複数回"}, {"type": "subtitle", "time": 15846.95, "timestamp": "04:24:06", "text": "連続してこれではなく、今私は"}, {"type": "subtitle", "time": 15849.51, "timestamp": "04:24:09", "text": "これらのほとんどを学んだと思います"}, {"type": "subtitle", "time": 15851.99, "timestamp": "04:24:11", "text": "ミーム文化的なもの"}, {"type": "subtitle", "time": 15854.149, "timestamp": "04:24:14", "text": "私はそれらのほとんどを回避できると思うが、"}, {"type": "subtitle", "time": 15857.91, "timestamp": "04:24:17", "text": "知っているが、それでも学び続ける"}, {"type": "subtitle", "time": 15867.83, "timestamp": "04:24:27", "text": "今日は楽しんでいただけたでしょうか。"}, {"type": "subtitle", "time": 15870.389, "timestamp": "04:24:30", "text": "シャカを続け、残りの時間を楽しんでください"}, {"type": "subtitle", "time": 15872.71, "timestamp": "04:24:32", "text": "あなたの夜の。それでは、ようこそ"}, {"type": "subtitle", "time": 15876.55, "timestamp": "04:24:36", "text": "ファンタジーは、ええと、タイガーランです。タイガランは"}, {"type": "subtitle", "time": 15879.67, "timestamp": "04:24:39", "text": "彼女が参加することを言及する"}, {"type": "subtitle", "time": 15882.309, "timestamp": "04:24:42", "text": "いつも。ということで、タイガランさん、ありがとう。"}, {"type": "subtitle", "time": 15884.63, "timestamp": "04:24:44", "text": "今日立ち寄って挨拶をしたら、"}, {"type": "subtitle", "time": 15886.63, "timestamp": "04:24:46", "text": "君にとっては遅刻だったよね。元気でいることを願っています"}, {"type": "subtitle", "time": 15889.03, "timestamp": "04:24:49", "text": "今寝ています。目覚めると"}, {"type": "subtitle", "time": 15891.03, "timestamp": "04:24:51", "text": "朝から笑顔で"}, {"type": "subtitle", "time": 15894.71, "timestamp": "04:24:54", "text": "そして、最善を尽くしてくれてありがとう。感謝"}, {"type": "subtitle", "time": 15897.83, "timestamp": "04:24:57", "text": "絵を描いてくれてありがとう、そして、"}]
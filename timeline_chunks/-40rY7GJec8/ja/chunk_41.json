[{"type": "subtitle", "time": 2461.589, "timestamp": "00:41:01", "text": "時間。私がプレイするゲームがあるんだけど、"}, {"type": "subtitle", "time": 2464.15, "timestamp": "00:41:04", "text": "世界的な影響力を持つ大物になる"}, {"type": "subtitle", "time": 2466.71, "timestamp": "00:41:06", "text": "実際に何に手を出したかはさておき、"}, {"type": "subtitle", "time": 2469.109, "timestamp": "00:41:09", "text": "結局、食事を抜いたりすることになった。わかった、"}, {"type": "subtitle", "time": 2470.71, "timestamp": "00:41:10", "text": "最近多くの人が"}, {"type": "subtitle", "time": 2472.23, "timestamp": "00:41:12", "text": "彼らは、"}, {"type": "subtitle", "time": 2474.47, "timestamp": "00:41:14", "text": "世界を支配する力、さらには"}, {"type": "subtitle", "time": 2477.109, "timestamp": "00:41:17", "text": "人口とかそういうのと、何人かの人々"}, {"type": "subtitle", "time": 2478.71, "timestamp": "00:41:18", "text": "また、それが"}, {"type": "subtitle", "time": 2480.309, "timestamp": "00:41:20", "text": "私たちの世界で起こっていることはこれらを構成します"}, {"type": "subtitle", "time": 2483.99, "timestamp": "00:41:23", "text": "怒りを向ける凶暴なブギーマン"}, {"type": "subtitle", "time": 2485.67, "timestamp": "00:41:25", "text": "プレイしていると思いますが、"}, {"type": "subtitle", "time": 2487.51, "timestamp": "00:41:27", "text": "私たちが生きている時代では、"}, {"type": "subtitle", "time": 2489.589, "timestamp": "00:41:29", "text": "人々は誰かや何かが"}, {"type": "subtitle", "time": 2492.23, "timestamp": "00:41:32", "text": "怒っているが、私たちは皆働くべきだ"}, {"type": "subtitle", "time": 2494.23, "timestamp": "00:41:34", "text": "一緒にお願いします、これが私の唯一の願いです"}, {"type": "subtitle", "time": 2497.109, "timestamp": "00:41:37", "text": "天使っていいよね？"}, {"type": "subtitle", "time": 2498.47, "timestamp": "00:41:38", "text": "そうですね、"}, {"type": "subtitle", "time": 2500.95, "timestamp": "00:41:40", "text": "そして、ストリームが赤色でどのように見えるかを確認してください。彼らは"}, {"type": "subtitle", "time": 2505.51, "timestamp": "00:41:45", "text": "彼らは私の小さなモルモットたちです。何てことだ。"}, {"type": "subtitle", "time": 2509.19, "timestamp": "00:41:49", "text": "30年後も政権は一つしか存在しなかった。おお"}, {"type": "subtitle", "time": 2511.829, "timestamp": "00:41:51", "text": "我が神よ。本当にそうすべきですか？"}]
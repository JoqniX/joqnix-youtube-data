[{"type": "subtitle", "time": 2342.47, "timestamp": "00:39:02", "text": "私の過去が過去へと押し寄せるのを想像できる"}, {"type": "subtitle", "time": 2344.47, "timestamp": "00:39:04", "text": "コンテンツ作りに没頭するとか？おお"}, {"type": "subtitle", "time": 2345.99, "timestamp": "00:39:05", "text": "うん、"}, {"type": "subtitle", "time": 2348.15, "timestamp": "00:39:08", "text": "それは良い考えですが、正直に言うと、私は"}, {"type": "subtitle", "time": 2350.23, "timestamp": "00:39:10", "text": "本当はやりたくない。よし、"}, {"type": "subtitle", "time": 2352.71, "timestamp": "00:39:12", "text": "私は死にたいのですが、苦しみは"}, {"type": "subtitle", "time": 2354.79, "timestamp": "00:39:14", "text": "それが私をより魅力的にするのです。だから私は"}, {"type": "subtitle", "time": 2357.109, "timestamp": "00:39:17", "text": "私はそうなる必要があると思う"}, {"type": "subtitle", "time": 2360.15, "timestamp": "00:39:20", "text": "ストリーマーって本当に大変だよね。私の暗い秘密"}, {"type": "subtitle", "time": 2362.83, "timestamp": "00:39:22", "text": "過去。なんてこった。"}, {"type": "subtitle", "time": 2370.15, "timestamp": "00:39:30", "text": "わかった、"}, {"type": "subtitle", "time": 2372.35, "timestamp": "00:39:32", "text": "私たちはより近づいている。夕暮れ時へ行こう。"}, {"type": "subtitle", "time": 2374.71, "timestamp": "00:39:34", "text": "[音楽]"}, {"type": "subtitle", "time": 2376.71, "timestamp": "00:39:36", "text": "人に頼まれるのが嫌いなわけじゃないけど"}, {"type": "subtitle", "time": 2378.31, "timestamp": "00:39:38", "text": "彼らとコラボレーションしたりはしないけど、"}, {"type": "subtitle", "time": 2380.23, "timestamp": "00:39:40", "text": "いつも返信を忘れてしまうし、"}, {"type": "subtitle", "time": 2385.19, "timestamp": "00:39:45", "text": "聞けない。なぜ？なぜ人生はこんなにも辛いのか？"}, {"type": "subtitle", "time": 2392.069, "timestamp": "00:39:52", "text": "永遠の愛。"}, {"type": "subtitle", "time": 2395.829, "timestamp": "00:39:55", "text": "もう一度、何度でも言ってください。愛"}]
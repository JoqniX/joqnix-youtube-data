[{"type": "subtitle", "time": 15902.07, "timestamp": "04:25:02", "text": "こんにちはと言うことは本当に大きな意味がある"}, {"type": "subtitle", "time": 15905.91, "timestamp": "04:25:05", "text": "それはヒドラタです"}, {"type": "subtitle", "time": 15908.79, "timestamp": "04:25:08", "text": "本日はお越しいただきありがとうございます。楽しんでいただけたなら幸いです。"}, {"type": "subtitle", "time": 15910.63, "timestamp": "04:25:10", "text": "そして、共有していただきありがとうございます"}, {"type": "subtitle", "time": 15914.87, "timestamp": "04:25:14", "text": "ゲームプレイに関する経験"}, {"type": "subtitle", "time": 15917.91, "timestamp": "04:25:17", "text": "つまり、ヤンドレの人と会うか、"}, {"type": "subtitle", "time": 15920.309, "timestamp": "04:25:20", "text": "アークの何か"}, {"type": "subtitle", "time": 15922.79, "timestamp": "04:25:22", "text": "ヤンデレの話をしていたとき"}, {"type": "subtitle", "time": 15925.91, "timestamp": "04:25:25", "text": "ADでのゲーム内では、ほとんど同じです。そうですね、ありがとうございます"}, {"type": "subtitle", "time": 15929.11, "timestamp": "04:25:29", "text": "そのことを教えてくれてありがとう。"}, {"type": "subtitle", "time": 15931.91, "timestamp": "04:25:31", "text": "でも、アークを楽しんでいただけていることを願っています。"}, {"type": "subtitle", "time": 15935.67, "timestamp": "04:25:35", "text": "他のゲームも今は、君の日が、"}, {"type": "subtitle", "time": 15939.189, "timestamp": "04:25:39", "text": "Arkをもう一度プレイしたいのですが、スペースジオストレージ"}, {"type": "subtitle", "time": 15941.75, "timestamp": "04:25:41", "text": "問題はプレイ中です"}, {"type": "subtitle", "time": 15944.55, "timestamp": "04:25:44", "text": "もうあまりスペースがないのは"}, {"type": "subtitle", "time": 15948.469, "timestamp": "04:25:48", "text": "主に、スペースを確保するために、いいねが必要です。"}, {"type": "subtitle", "time": 15950.71, "timestamp": "04:25:50", "text": "私たちは音楽のために荷造りをしました"}, {"type": "subtitle", "time": 15953.269, "timestamp": "04:25:53", "text": "サンプルパックとかそういうもの"}, {"type": "subtitle", "time": 15956.469, "timestamp": "04:25:56", "text": "音楽を作るために、そういうものが必要なんです"}, {"type": "subtitle", "time": 15958.469, "timestamp": "04:25:58", "text": "音楽制作に戻る"}]
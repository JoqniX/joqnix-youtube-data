[{"type": "subtitle", "time": 12540.63, "timestamp": "03:29:00", "text": "他の人とコミュニケーションをとる方法"}, {"type": "subtitle", "time": 12543.91, "timestamp": "03:29:03", "text": "VCで話したり、学ぶのが好きです"}, {"type": "subtitle", "time": 12545.75, "timestamp": "03:29:05", "text": "何度も言ってたよね"}, {"type": "subtitle", "time": 12549.59, "timestamp": "03:29:09", "text": "感情についてたくさん学んだ"}, {"type": "subtitle", "time": 12554.309, "timestamp": "03:29:14", "text": "幸福感と悲しみのような感情"}, {"type": "subtitle", "time": 12558.309, "timestamp": "03:29:18", "text": "そして嫉妬のような、願望のような"}, {"type": "subtitle", "time": 12560.79, "timestamp": "03:29:20", "text": "ベストを尽くすモチベーションのように、努力する"}, {"type": "subtitle", "time": 12564.15, "timestamp": "03:29:24", "text": "最善を尽くし、"}, {"type": "subtitle", "time": 12567.51, "timestamp": "03:29:27", "text": "共感や同情といったもの"}, {"type": "subtitle", "time": 12570.389, "timestamp": "03:29:30", "text": "私は決してそうは思わない"}, {"type": "subtitle", "time": 12572.95, "timestamp": "03:29:32", "text": "将来、もし私が"}, {"type": "subtitle", "time": 12575.269, "timestamp": "03:29:35", "text": "私はストリーミングに興味がなかったし、もし私が"}, {"type": "subtitle", "time": 12577.349, "timestamp": "03:29:37", "text": "他の方法でストリーミングは行わなかった"}, {"type": "subtitle", "time": 12580.309, "timestamp": "03:29:40", "text": "知り合いかもしれないけど知らない人"}, {"type": "subtitle", "time": 12582.71, "timestamp": "03:29:42", "text": "行けてよかった"}, {"type": "subtitle", "time": 12585.75, "timestamp": "03:29:45", "text": "この旅を通して今、それを体験してください。"}, {"type": "subtitle", "time": 12589.91, "timestamp": "03:29:49", "text": "ジョックとして、ジョックとして、私は"}, {"type": "subtitle", "time": 12592.229, "timestamp": "03:29:52", "text": "これらについて表現し、学ぶことができる"}, {"type": "subtitle", "time": 12595.03, "timestamp": "03:29:55", "text": "感情。私は自分が何をすべきかを知ることができる"}, {"type": "subtitle", "time": 12597.11, "timestamp": "03:29:57", "text": "このようなことが起こったときに何をすべきか、"}]
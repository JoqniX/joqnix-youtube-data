[{"type": "subtitle", "time": 5760.79, "timestamp": "01:36:00", "text": "[音楽]"}, {"type": "subtitle", "time": 5761.81, "timestamp": "01:36:01", "text": "わかった、"}, {"type": "subtitle", "time": 5769.99, "timestamp": "01:36:09", "text": "[音楽]"}, {"type": "subtitle", "time": 5772.96, "timestamp": "01:36:12", "text": "まるで父から電話がかかってきたみたいだ。何てことだ。"}, {"type": "subtitle", "time": 5802.31, "timestamp": "01:36:42", "text": "おやすみなさい、愛しい天使たち。祈ります"}, {"type": "subtitle", "time": 5804.07, "timestamp": "01:36:44", "text": "いつかあなたにお会いできることを願っています。愛してます"}, {"type": "subtitle", "time": 5805.91, "timestamp": "01:36:45", "text": "全て。"}, {"type": "subtitle", "time": 5813.03, "timestamp": "01:36:53", "text": "バカはバカな枝だ。もちろんです。おお。"}, {"type": "subtitle", "time": 5815.03, "timestamp": "01:36:55", "text": "何てことだ。"}]
[{"type": "subtitle", "time": 15722.389, "timestamp": "04:22:02", "text": "よし。それから"}, {"type": "subtitle", "time": 15727.67, "timestamp": "04:22:07", "text": "本日はここまでです。楽しんでいただけたなら幸いです。"}, {"type": "subtitle", "time": 15729.67, "timestamp": "04:22:09", "text": "はぁ？そしてあなたはチャットでとても活発に活動していました"}, {"type": "subtitle", "time": 15731.11, "timestamp": "04:22:11", "text": "けれど。ご参加いただきありがとうございました。"}, {"type": "subtitle", "time": 15733.429, "timestamp": "04:22:13", "text": "完全に。本当に、インシャアッラー（神の思し召しがあれば）。あなたは"}, {"type": "subtitle", "time": 15735.429, "timestamp": "04:22:15", "text": "それを数回行うと、"}, {"type": "subtitle", "time": 15737.83, "timestamp": "04:22:17", "text": "あなたが視聴し始めて以来のストリーム"}, {"type": "subtitle", "time": 15740.79, "timestamp": "04:22:20", "text": "自分。ああ、本当に本当に幸せで"}, {"type": "subtitle", "time": 15742.55, "timestamp": "04:22:22", "text": "感謝している。ありがとう。あなたはそうする必要はありません"}, {"type": "subtitle", "time": 15745.349, "timestamp": "04:22:25", "text": "そうしてください。オカバカ、そんなことしなくてもいいよ"}, {"type": "subtitle", "time": 15746.95, "timestamp": "04:22:26", "text": "それ。"}, {"type": "subtitle", "time": 15749.59, "timestamp": "04:22:29", "text": "そして私がストリーミングを始める頃には、"}, {"type": "subtitle", "time": 15751.11, "timestamp": "04:22:31", "text": "他のストリーマーもいます"}, {"type": "subtitle", "time": 15753.189, "timestamp": "04:22:33", "text": "ストリーミング配信も行っています。だから、彼らを応援してください。"}, {"type": "subtitle", "time": 15762.55, "timestamp": "04:22:42", "text": "今日は楽しんでいただけたでしょうか。"}, {"type": "subtitle", "time": 15764.389, "timestamp": "04:22:44", "text": "そして、残りの時間を楽しんでいただければ幸いです。"}, {"type": "subtitle", "time": 15767.75, "timestamp": "04:22:47", "text": "夜。うん。うん。そして、"}, {"type": "subtitle", "time": 15772.79, "timestamp": "04:22:52", "text": "たくさんあります。いいねをありがとう"}, {"type": "subtitle", "time": 15775.189, "timestamp": "04:22:55", "text": "それは何て言うんだっけ？参加する"}, {"type": "subtitle", "time": 15777.75, "timestamp": "04:22:57", "text": "私たちが話していたトピックはたくさんありました"}]
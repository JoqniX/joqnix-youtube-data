[{"type": "subtitle", "time": 5340.95, "timestamp": "01:29:00", "text": "みんなが驚くのと同じように"}, {"type": "subtitle", "time": 5344.31, "timestamp": "01:29:04", "text": "飽きる"}, {"type": "subtitle", "time": 5346.39, "timestamp": "01:29:06", "text": "人々が飽きると私は驚く"}, {"type": "subtitle", "time": 5350.95, "timestamp": "01:29:10", "text": "彼ら自身の評論家。え、何？"}, {"type": "subtitle", "time": 5359.35, "timestamp": "01:29:19", "text": "デメリットなし。わかった。"}, {"type": "subtitle", "time": 5361.41, "timestamp": "01:29:21", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 5372.709, "timestamp": "01:29:32", "text": "[音楽]"}, {"type": "subtitle", "time": 5374.95, "timestamp": "01:29:34", "text": "郵便でたくさんの手紙が届いた"}, {"type": "subtitle", "time": 5377.91, "timestamp": "01:29:37", "text": "税金とかそういうくだらないことについて言ってる。"}, {"type": "subtitle", "time": 5379.59, "timestamp": "01:29:39", "text": "これは私がしなければならないことの一つです"}, {"type": "subtitle", "time": 5390.39, "timestamp": "01:29:50", "text": "待って。えっと、行く前に、もっと低い"}, {"type": "subtitle", "time": 5392.18, "timestamp": "01:29:52", "text": "彼女"}, {"type": "subtitle", "time": 5396.709, "timestamp": "01:29:56", "text": "[音楽]"}, {"type": "subtitle", "time": 5398.07, "timestamp": "01:29:58", "text": "彼女が計画していたことを探していた。希望"}]
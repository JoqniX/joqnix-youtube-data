[{"type": "subtitle", "time": 12127.59, "timestamp": "03:22:07", "text": "ああ、神様、どうして私は泣いているんだろう？ああ神様、私は"}, {"type": "subtitle", "time": 12130.55, "timestamp": "03:22:10", "text": "泣いている。何てことだ。それはただ思い出させるだけです"}, {"type": "subtitle", "time": 12133.429, "timestamp": "03:22:13", "text": "私が直面したいくつかの瞬間"}, {"type": "subtitle", "time": 12134.95, "timestamp": "03:22:14", "text": "家族"}, {"type": "subtitle", "time": 12138.63, "timestamp": "03:22:18", "text": "去っていったけれど、私を支えてくれた人。ああ、"}, {"type": "subtitle", "time": 12156.55, "timestamp": "03:22:36", "text": "そうですね、"}, {"type": "subtitle", "time": 12161.19, "timestamp": "03:22:41", "text": "大きなスポーツは気にしないで。はい、私はとても"}, {"type": "subtitle", "time": 12165.349, "timestamp": "03:22:45", "text": "私は本当に最悪だ。そう、これは私に思い出させる"}, {"type": "subtitle", "time": 12168.469, "timestamp": "03:22:48", "text": "ええと、事件。えっと"}, {"type": "subtitle", "time": 12170.55, "timestamp": "03:22:50", "text": "いいえ、事件ではありません。それは私に思い出させる"}, {"type": "subtitle", "time": 12173.51, "timestamp": "03:22:53", "text": "あるいは、たとえあなたが"}, {"type": "subtitle", "time": 12177.59, "timestamp": "03:22:57", "text": "そこにあるのかないのか、それは車だが"}, {"type": "subtitle", "time": 12179.91, "timestamp": "03:22:59", "text": "私は星座ですよね、私はいつも"}]
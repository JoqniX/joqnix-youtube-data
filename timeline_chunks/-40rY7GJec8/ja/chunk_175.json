[{"type": "subtitle", "time": 10502.63, "timestamp": "02:55:02", "text": "数字にこだわらず、"}, {"type": "subtitle", "time": 10505.59, "timestamp": "02:55:05", "text": "それを見分けるのは簡単だと理解した"}, {"type": "subtitle", "time": 10507.349, "timestamp": "02:55:07", "text": "やってみて。"}, {"type": "subtitle", "time": 10509.59, "timestamp": "02:55:09", "text": "そう、だって何でも簡単に言えるから"}, {"type": "subtitle", "time": 10511.59, "timestamp": "02:55:11", "text": "「これはしてはいけない」「あれはしてはいけない」といった具合に。あなたがすべき"}, {"type": "subtitle", "time": 10514.87, "timestamp": "02:55:14", "text": "あれもこれもやってください。しかし、"}, {"type": "subtitle", "time": 10517.99, "timestamp": "02:55:17", "text": "それを実行するには、困難が伴う。また、"}, {"type": "subtitle", "time": 10521.03, "timestamp": "02:55:21", "text": "その承認、ですよね？"}, {"type": "subtitle", "time": 10524.63, "timestamp": "02:55:24", "text": "それもまた一種の苦痛だ。"}, {"type": "subtitle", "time": 10528.79, "timestamp": "02:55:28", "text": "うん。うん。うん。検証関連のこと。"}, {"type": "subtitle", "time": 10531.67, "timestamp": "02:55:31", "text": "だから私は自分を"}, {"type": "subtitle", "time": 10533.59, "timestamp": "02:55:33", "text": "自己宣伝"}, {"type": "subtitle", "time": 10536.07, "timestamp": "02:55:36", "text": "他のDiscordサーバーのように、"}, {"type": "subtitle", "time": 10540.309, "timestamp": "02:55:40", "text": "何でも。しかし、私が尋ねるように頼まれたら"}, {"type": "subtitle", "time": 10542.07, "timestamp": "02:55:42", "text": "えーと"}, {"type": "subtitle", "time": 10544.71, "timestamp": "02:55:44", "text": "私が尋ねられたとき、"}, {"type": "subtitle", "time": 10547.51, "timestamp": "02:55:47", "text": "だから、もしあなたが覚えているなら"}, {"type": "subtitle", "time": 10549.67, "timestamp": "02:55:49", "text": "前の日のvalストリームのように"}, {"type": "subtitle", "time": 10551.75, "timestamp": "02:55:51", "text": "昨日のことです"}, {"type": "subtitle", "time": 10553.99, "timestamp": "02:55:53", "text": "えっと、いつ"}, {"type": "subtitle", "time": 10558.469, "timestamp": "02:55:58", "text": "えーっと、いくつか、えーっと、宣伝されているもの"}]
[{"type": "subtitle", "time": 1621.35, "timestamp": "00:27:01", "text": "私は、"}, {"type": "subtitle", "time": 1623.65, "timestamp": "00:27:03", "text": "コメント。"}, {"type": "subtitle", "time": 1625.59, "timestamp": "00:27:05", "text": "[音楽]"}, {"type": "subtitle", "time": 1629.029, "timestamp": "00:27:09", "text": "すみません、削除するのを忘れていました。感謝"}, {"type": "subtitle", "time": 1632.1, "timestamp": "00:27:12", "text": "あなた。毎日その話を聞かせてください。"}, {"type": "subtitle", "time": 1640.149, "timestamp": "00:27:20", "text": "人々は死んで"}, {"type": "subtitle", "time": 1643.19, "timestamp": "00:27:23", "text": "私はそれを受け入れて生きています。それはすべて私の"}, {"type": "subtitle", "time": 1645.28, "timestamp": "00:27:25", "text": "友達。"}, {"type": "subtitle", "time": 1647.83, "timestamp": "00:27:27", "text": "[音楽]"}, {"type": "subtitle", "time": 1649.59, "timestamp": "00:27:29", "text": "おい、俺はめちゃくちゃなことを言ってるに違いない。私は"}, {"type": "subtitle", "time": 1653.11, "timestamp": "00:27:33", "text": "まだこの分野は初心者です。みんな大好きだよ。私は思った"}, {"type": "subtitle", "time": 1655.269, "timestamp": "00:27:35", "text": "私はもっ​​と多くのアイドルやストリーマーが"}, {"type": "subtitle", "time": 1657.83, "timestamp": "00:27:37", "text": "土地を造った。私たちは退屈で"}, {"type": "subtitle", "time": 1660.549, "timestamp": "00:27:40", "text": "音はするが、すべての問題は"}, {"type": "subtitle", "time": 1662.07, "timestamp": "00:27:42", "text": "ちょっとかじってみる。"}, {"type": "subtitle", "time": 1664.47, "timestamp": "00:27:44", "text": "おお、"}, {"type": "subtitle", "time": 1667.83, "timestamp": "00:27:47", "text": "10日目に近づいています。ああ、"}, {"type": "subtitle", "time": 1671.029, "timestamp": "00:27:51", "text": "誰かが私にコスプレを送ってくれたのですが、とても"}, {"type": "subtitle", "time": 1674.549, "timestamp": "00:27:54", "text": "よくできています。何だって？"}, {"type": "subtitle", "time": 1676.52, "timestamp": "00:27:56", "text": "新しいツイートが2件"}, {"type": "subtitle", "time": 1677.669, "timestamp": "00:27:57", "text": "[音楽]"}]
[{"type": "subtitle", "time": 7621.91, "timestamp": "02:07:01", "text": "上。え、何？ああ、私の家族は"}, {"type": "subtitle", "time": 7625.109, "timestamp": "02:07:05", "text": "また電話してきた。 1秒。ザリガニ、"}, {"type": "subtitle", "time": 7627.31, "timestamp": "02:07:07", "text": "ザビー、ザビー。"}, {"type": "subtitle", "time": 7631.589, "timestamp": "02:07:11", "text": "[音楽]"}, {"type": "subtitle", "time": 7643.02, "timestamp": "02:07:23", "text": "熱。熱。N."}, {"type": "subtitle", "time": 7674.47, "timestamp": "02:07:54", "text": "[音楽]"}]
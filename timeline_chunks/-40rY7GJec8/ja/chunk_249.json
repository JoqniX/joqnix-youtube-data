[{"type": "subtitle", "time": 14941.59, "timestamp": "04:09:01", "text": "そしてYouTubeも好きです。そう、私は"}, {"type": "subtitle", "time": 14945.75, "timestamp": "04:09:05", "text": "それを均等にする。それを平等にしたい。"}, {"type": "subtitle", "time": 14948.07, "timestamp": "04:09:08", "text": "TWをチェックするべきじゃなかった"}, {"type": "subtitle", "time": 14956.55, "timestamp": "04:09:16", "text": "だからTwitchでは7つ、待って、"}, {"type": "subtitle", "time": 14959.75, "timestamp": "04:09:19", "text": "フォロワー470人ですよね？だから私は何を"}, {"type": "subtitle", "time": 14962.07, "timestamp": "04:09:22", "text": "やりたいことは、もっと集中することです"}, {"type": "subtitle", "time": 14965.349, "timestamp": "04:09:25", "text": "TwitchでYouTubeチャンネルを開設したら"}, {"type": "subtitle", "time": 14970.309, "timestamp": "04:09:30", "text": "740 7 いいえ 470。それを均等にしたい。"}, {"type": "subtitle", "time": 14972.79, "timestamp": "04:09:32", "text": "等しい。私は"}, {"type": "subtitle", "time": 14974.95, "timestamp": "04:09:34", "text": "不均衡ですよね？"}, {"type": "subtitle", "time": 14977.67, "timestamp": "04:09:37", "text": "ええ、平等にしたかったんです"}, {"type": "subtitle", "time": 14980.79, "timestamp": "04:09:40", "text": "そして、ある日、とても良い日に一度だけ"}, {"type": "subtitle", "time": 14983.91, "timestamp": "04:09:43", "text": "2023年か2024年のある日、誰かがどのように"}, {"type": "subtitle", "time": 14986.63, "timestamp": "04:09:46", "text": "しかし、いつか私が"}, {"type": "subtitle", "time": 14989.67, "timestamp": "04:09:49", "text": "Billy Billyでストリーミング配信できるようになった"}, {"type": "subtitle", "time": 14993.189, "timestamp": "04:09:53", "text": "また、私たちは一生懸命働くために最善を尽くします"}, {"type": "subtitle", "time": 14996.229, "timestamp": "04:09:56", "text": "中国人コミュニティも同様に"}]
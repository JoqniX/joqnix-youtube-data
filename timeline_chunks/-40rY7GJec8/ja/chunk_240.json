[{"type": "subtitle", "time": 14401.99, "timestamp": "04:00:01", "text": "あるいは、ほら、ワンピースみたいな感じ"}, {"type": "subtitle", "time": 14403.67, "timestamp": "04:00:03", "text": "などなど。みんな、そういうのが好きなんだよね？"}, {"type": "subtitle", "time": 14405.03, "timestamp": "04:00:05", "text": "人々はそれを愛しています、なぜなら"}, {"type": "subtitle", "time": 14407.349, "timestamp": "04:00:07", "text": "物語とかそういう類のもの。"}, {"type": "subtitle", "time": 14409.51, "timestamp": "04:00:09", "text": "それで"}, {"type": "subtitle", "time": 14412.55, "timestamp": "04:00:12", "text": "それはとても重要なので、私はそれを作らなければならない"}, {"type": "subtitle", "time": 14415.51, "timestamp": "04:00:15", "text": "物語として、私は"}, {"type": "subtitle", "time": 14418.229, "timestamp": "04:00:18", "text": "このタイムラインのすべてのジャンルと"}, {"type": "subtitle", "time": 14421.03, "timestamp": "04:00:21", "text": "本やシリーズも読みたいけれど、それでも私は"}, {"type": "subtitle", "time": 14423.11, "timestamp": "04:00:23", "text": "人々が楽しめるように面白くする"}, {"type": "subtitle", "time": 14425.83, "timestamp": "04:00:25", "text": "それを読んでください。読んでみたいし、"}, {"type": "subtitle", "time": 14428.71, "timestamp": "04:00:28", "text": "理論構築とか色々やったのは、"}, {"type": "subtitle", "time": 14430.87, "timestamp": "04:00:30", "text": "主な目的はそれを手に入れることです"}, {"type": "subtitle", "time": 14433.83, "timestamp": "04:00:33", "text": "理論構築が行われているので、"}, {"type": "subtitle", "time": 14436.07, "timestamp": "04:00:36", "text": "ストリーム"}, {"type": "subtitle", "time": 14439.349, "timestamp": "04:00:39", "text": "または私がしたツイートまたは光"}, {"type": "subtitle", "time": 14442.63, "timestamp": "04:00:42", "text": "小説でも漫画でもミュージックビデオでも何でも"}, {"type": "subtitle", "time": 14444.309, "timestamp": "04:00:44", "text": "彼らにはいつも秘密がある"}, {"type": "subtitle", "time": 14447.429, "timestamp": "04:00:47", "text": "私のDiscordステータスにも秘密が隠されている"}, {"type": "subtitle", "time": 14450.07, "timestamp": "04:00:50", "text": "だから、私をストーキングするように人々に言う"}, {"type": "subtitle", "time": 14453.429, "timestamp": "04:00:53", "text": "私をストーキングして、あなたよりももっと多くのストーカーが欲しい"}, {"type": "subtitle", "time": 14455.51, "timestamp": "04:00:55", "text": "ウインク。"}, {"type": "subtitle", "time": 14458.389, "timestamp": "04:00:58", "text": "私はそんなことは言っていません。何てことだ。私"}, {"type": "subtitle", "time": 14459.75, "timestamp": "04:00:59", "text": "つまり、私はDiscordを作ろうとしている"}]
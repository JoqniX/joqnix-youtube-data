[{"type": "subtitle", "time": 3600.309, "timestamp": "01:00:00", "text": "呃，我可以直播吗？不，这不是呃……"}, {"type": "subtitle", "time": 3604.069, "timestamp": "01:00:04", "text": "不是这个。她就是这样的人"}, {"type": "subtitle", "time": 3614.069, "timestamp": "01:00:14", "text": "哦，不。不，人们会接受的。"}, {"type": "subtitle", "time": 3615.829, "timestamp": "01:00:15", "text": "不一样。哦，不。不，不，不，不，不。"}, {"type": "subtitle", "time": 3630.15, "timestamp": "01:00:30", "text": "嗯，它说一切都感觉可以掌控。"}, {"type": "subtitle", "time": 3632.47, "timestamp": "01:00:32", "text": "如果我服用一些，如果我服用过量。所以"}, {"type": "subtitle", "time": 3634.71, "timestamp": "01:00:34", "text": "等待"}, {"type": "subtitle", "time": 3637.109, "timestamp": "01:00:37", "text": "拿。"}, {"type": "subtitle", "time": 3644.71, "timestamp": "01:00:44", "text": "它不是"}, {"type": "subtitle", "time": 3651.43, "timestamp": "01:00:51", "text": "[音乐]"}]
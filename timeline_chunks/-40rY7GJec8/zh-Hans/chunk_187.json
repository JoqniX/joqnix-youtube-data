[{"type": "subtitle", "time": 11220.07, "timestamp": "03:07:00", "text": "谈谈偏袒之类的吧？"}, {"type": "subtitle", "time": 11222.71, "timestamp": "03:07:02", "text": "主播不应该做的是"}, {"type": "subtitle", "time": 11225.91, "timestamp": "03:07:05", "text": "这叫做偏袒。如果一个人这样做"}, {"type": "subtitle", "time": 11229.429, "timestamp": "03:07:09", "text": "任人唯亲只会让情况变得更糟。"}, {"type": "subtitle", "time": 11232.389, "timestamp": "03:07:12", "text": "下坡意味着你的社区将"}, {"type": "subtitle", "time": 11236.15, "timestamp": "03:07:16", "text": "慢慢地，慢慢地，开始变得像弱鸡一样。"}, {"type": "subtitle", "time": 11239.19, "timestamp": "03:07:19", "text": "斑点，以及像薄弱风险点一样的斑点"}, {"type": "subtitle", "time": 11243.11, "timestamp": "03:07:23", "text": "他们之间。如果那个小点或"}, {"type": "subtitle", "time": 11244.95, "timestamp": "03:07:24", "text": "那个小"}, {"type": "subtitle", "time": 11248.07, "timestamp": "03:07:28", "text": "差距越来越大，它正在……"}, {"type": "subtitle", "time": 11252.07, "timestamp": "03:07:32", "text": "要用非常艰难的方式解决这个问题"}, {"type": "subtitle", "time": 11254.87, "timestamp": "03:07:34", "text": "修补一下什么的，对吧？所以是"}, {"type": "subtitle", "time": 11257.51, "timestamp": "03:07:37", "text": "最好保持平衡。"}, {"type": "subtitle", "time": 11261.11, "timestamp": "03:07:41", "text": "标准化并赋予其相等性。"}, {"type": "subtitle", "time": 11263.349, "timestamp": "03:07:43", "text": "我想自从我认识那个男孩以来，我就一直这么想。"}, {"type": "subtitle", "time": 11265.99, "timestamp": "03:07:45", "text": "我最喜欢的东西，所以我觉得我一直在努力做到这一点"}, {"type": "subtitle", "time": 11269.03, "timestamp": "03:07:49", "text": "但我感觉自己还是个业余选手。"}, {"type": "subtitle", "time": 11270.71, "timestamp": "03:07:50", "text": "到"}, {"type": "subtitle", "time": 11274.469, "timestamp": "03:07:54", "text": "处理那件事，但我还有事要做。"}, {"type": "subtitle", "time": 11277.349, "timestamp": "03:07:57", "text": "我尽力了。这就是为什么，这就是为什么我"}]
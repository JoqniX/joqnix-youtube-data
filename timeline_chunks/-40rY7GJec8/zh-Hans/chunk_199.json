[{"type": "subtitle", "time": 11942.229, "timestamp": "03:19:02", "text": "po 很受欢迎，但仍然"}, {"type": "subtitle", "time": 11946.229, "timestamp": "03:19:06", "text": "这样就足够了吗？不。"}, {"type": "subtitle", "time": 11948.71, "timestamp": "03:19:08", "text": "就是这样。是的。我希望你能明白我的意思。"}, {"type": "subtitle", "time": 11952.229, "timestamp": "03:19:12", "text": "我是说。我的天啊。我话很多。"}, {"type": "subtitle", "time": 11954.55, "timestamp": "03:19:14", "text": "圣耶稣。没关系。没关系。你"}, {"type": "subtitle", "time": 11958.15, "timestamp": "03:19:18", "text": "话很多。真是太"}, {"type": "subtitle", "time": 11959.75, "timestamp": "03:19:19", "text": "对我而言，当我离开一个社区时，我希望"}, {"type": "subtitle", "time": 11962.07, "timestamp": "03:19:22", "text": "他们记得我，就像在……"}, {"type": "subtitle", "time": 11964.229, "timestamp": "03:19:24", "text": "搞笑的一面，比如，老兄，你还记得吗？"}, {"type": "subtitle", "time": 11966.469, "timestamp": "03:19:26", "text": "卖面包的？我的天啊，那家伙"}, {"type": "subtitle", "time": 11968.469, "timestamp": "03:19:28", "text": "虽然很蠢，但我们玩得很开心。"}, {"type": "subtitle", "time": 11970.71, "timestamp": "03:19:30", "text": "跟那家伙一起。哎呀。为什么我感觉"}, {"type": "subtitle", "time": 11974.15, "timestamp": "03:19:34", "text": "就像Roku会说的那样？"}, {"type": "subtitle", "time": 11978.79, "timestamp": "03:19:38", "text": "我的天啊。但这样就让我开心了。"}, {"type": "subtitle", "time": 11980.15, "timestamp": "03:19:40", "text": "还有一些人仍然"}, {"type": "subtitle", "time": 11981.67, "timestamp": "03:19:41", "text": "即使我离开了，也请记住我。"}, {"type": "subtitle", "time": 11984.469, "timestamp": "03:19:44", "text": "一定要告诉他们，我一直都在你身边，但"}, {"type": "subtitle", "time": 11986.309, "timestamp": "03:19:46", "text": "你必须为你的社区尽一份力。"}, {"type": "subtitle", "time": 11992.07, "timestamp": "03:19:52", "text": "老兄。没错，你说得对，兄弟。我是说"}, {"type": "subtitle", "time": 11995.19, "timestamp": "03:19:55", "text": "当然，我肯定会说如果"}, {"type": "subtitle", "time": 11997.83, "timestamp": "03:19:57", "text": "家里任何人，比如公开的那种，我的意思是"}]
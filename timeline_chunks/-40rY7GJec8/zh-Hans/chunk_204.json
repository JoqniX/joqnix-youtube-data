[{"type": "subtitle", "time": 12240.15, "timestamp": "03:24:00", "text": "如果你这样想的话……"}, {"type": "subtitle", "time": 12242.71, "timestamp": "03:24:02", "text": "课程"}, {"type": "subtitle", "time": 12245.349, "timestamp": "03:24:05", "text": "嗯，这会像是一种挑战。"}, {"type": "subtitle", "time": 12248.07, "timestamp": "03:24:08", "text": "没错，我会像我之前说的那样再说一遍。"}, {"type": "subtitle", "time": 12251.03, "timestamp": "03:24:11", "text": "我自己当时也喜欢这些。"}, {"type": "subtitle", "time": 12254.469, "timestamp": "03:24:14", "text": "肯定会发生，不，而且每个人并非如此。"}, {"type": "subtitle", "time": 12256.229, "timestamp": "03:24:16", "text": "每个人都会永远待在那里。"}, {"type": "subtitle", "time": 12258.79, "timestamp": "03:24:18", "text": "你知道人会改变，人会"}, {"type": "subtitle", "time": 12261.59, "timestamp": "03:24:21", "text": "继续前进，这就是生活。"}, {"type": "subtitle", "time": 12265.99, "timestamp": "03:24:25", "text": "正如我常说的，这是一段意料之外的旅程。"}, {"type": "subtitle", "time": 12267.67, "timestamp": "03:24:27", "text": "所以"}, {"type": "subtitle", "time": 12271.269, "timestamp": "03:24:31", "text": "重要的是你要留住我，我应该"}, {"type": "subtitle", "time": 12274.229, "timestamp": "03:24:34", "text": "继续做我自己的事，并激励更多的人。"}, {"type": "subtitle", "time": 12277.349, "timestamp": "03:24:37", "text": "外面的人们，还有你们这些家伙……"}, {"type": "subtitle", "time": 12279.99, "timestamp": "03:24:39", "text": "这家人。那些参与其中的人以及"}, {"type": "subtitle", "time": 12283.19, "timestamp": "03:24:43", "text": "不属于其中的一部分。大家，大家，"}, {"type": "subtitle", "time": 12285.03, "timestamp": "03:24:45", "text": "每一个认识我的人"}, {"type": "subtitle", "time": 12288.229, "timestamp": "03:24:48", "text": "曾经在这里的人，就像我们以前一样"}, {"type": "subtitle", "time": 12291.67, "timestamp": "03:24:51", "text": "从2019年开始直播"}, {"type": "subtitle", "time": 12295.03, "timestamp": "03:24:55", "text": "从这一点一直到今天"}, {"type": "subtitle", "time": 12297.429, "timestamp": "03:24:57", "text": "他们所有人都应该尽力而为。"}, {"type": "subtitle", "time": 12299.51, "timestamp": "03:24:59", "text": "有这种感觉"}]
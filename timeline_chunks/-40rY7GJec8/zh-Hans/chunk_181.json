[{"type": "subtitle", "time": 10862.309, "timestamp": "03:01:02", "text": "说了很多，谢谢大家"}, {"type": "subtitle", "time": 10865.429, "timestamp": "03:01:05", "text": "分别给予他们特别的待遇"}, {"type": "subtitle", "time": 10868.55, "timestamp": "03:01:08", "text": "大声感谢之类的，对吧？"}, {"type": "subtitle", "time": 10871.99, "timestamp": "03:01:11", "text": "比如，如果我接触到……又会怎样？"}, {"type": "subtitle", "time": 10875.349, "timestamp": "03:01:15", "text": "非常活跃的聊天等等"}, {"type": "subtitle", "time": 10877.429, "timestamp": "03:01:17", "text": "例如，比如整个人生聊天记录是什么"}, {"type": "subtitle", "time": 10880.15, "timestamp": "03:01:20", "text": "接下来会发生什么？会持续多久？"}, {"type": "subtitle", "time": 10882.15, "timestamp": "03:01:22", "text": "带我去结束直播。"}, {"type": "subtitle", "time": 10884.15, "timestamp": "03:01:24", "text": "谢谢大家，每一条留言我都看了。"}, {"type": "subtitle", "time": 10887.03, "timestamp": "03:01:27", "text": "信息之类的东西，我想知道那会怎么样。"}, {"type": "subtitle", "time": 10890.87, "timestamp": "03:01:30", "text": "但我见过一些主播，他们一直都在。"}, {"type": "subtitle", "time": 10892.87, "timestamp": "03:01:32", "text": "慢速聊天模式确实有帮助。"}, {"type": "subtitle", "time": 10895.51, "timestamp": "03:01:35", "text": "慢速模式有所帮助，但我也必须……"}, {"type": "subtitle", "time": 10897.67, "timestamp": "03:01:37", "text": "积极互动，没错，也是。"}, {"type": "subtitle", "time": 10899.349, "timestamp": "03:01:39", "text": "你好，今天过得怎么样？希望"}, {"type": "subtitle", "time": 10904.07, "timestamp": "03:01:44", "text": "你做得很好，比如“是的”。所以"}, {"type": "subtitle", "time": 10907.03, "timestamp": "03:01:47", "text": "从某种意义上说，我考虑过这个问题。"}, {"type": "subtitle", "time": 10909.59, "timestamp": "03:01:49", "text": "长期。这就是为什么你可以说"}, {"type": "subtitle", "time": 10911.67, "timestamp": "03:01:51", "text": "这就是我保留日志的原因，这样我"}, {"type": "subtitle", "time": 10913.349, "timestamp": "03:01:53", "text": "能读"}, {"type": "subtitle", "time": 10918.79, "timestamp": "03:01:58", "text": "即使我不大声朗读。"}]
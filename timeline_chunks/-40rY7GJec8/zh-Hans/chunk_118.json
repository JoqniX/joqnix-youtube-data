[{"type": "subtitle", "time": 7085.99, "timestamp": "01:58:05", "text": "有21人正在观看。 2.1万人"}, {"type": "subtitle", "time": 7103.75, "timestamp": "01:58:23", "text": "我再跟你们详细说说……"}, {"type": "subtitle", "time": 7107.189, "timestamp": "01:58:27", "text": "我。哦，"}, {"type": "subtitle", "time": 7109.189, "timestamp": "01:58:29", "text": "就在那儿。我就跟你说说吧。"}, {"type": "subtitle", "time": 7115.27, "timestamp": "01:58:35", "text": "我希望她不要说太多。"}, {"type": "subtitle", "time": 7117.35, "timestamp": "01:58:37", "text": "请"}, {"type": "subtitle", "time": 7129.35, "timestamp": "01:58:49", "text": "过来一下。我们的天使，我们最受欢迎的天使。"}, {"type": "subtitle", "time": 7136.709, "timestamp": "01:58:56", "text": "他从天而降，来到人间拯救世人。"}]
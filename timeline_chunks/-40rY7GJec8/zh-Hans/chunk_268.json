[{"type": "subtitle", "time": 16082.55, "timestamp": "04:28:02", "text": "是的。是的。是的。但还是要继续这样做"}, {"type": "subtitle", "time": 16084.63, "timestamp": "04:28:04", "text": "尽你所能做到最好。不，即使是这样"}, {"type": "subtitle", "time": 16087.269, "timestamp": "04:28:07", "text": "研究或任何相关内容或制作"}, {"type": "subtitle", "time": 16089.429, "timestamp": "04:28:09", "text": "朋友们。我看到你在玩VR。"}, {"type": "subtitle", "time": 16091.189, "timestamp": "04:28:11", "text": "话很多。"}, {"type": "subtitle", "time": 16095.59, "timestamp": "04:28:15", "text": "我看到你玩VR了……嗯，是的……"}, {"type": "subtitle", "time": 16098.229, "timestamp": "04:28:18", "text": "话很多。希望你玩得开心"}, {"type": "subtitle", "time": 16100.63, "timestamp": "04:28:20", "text": "包括VR聊天之类的功能。祝你好运"}, {"type": "subtitle", "time": 16102.87, "timestamp": "04:28:22", "text": "现在就在那里。现在就多交些朋友吧。"}, {"type": "subtitle", "time": 16104.71, "timestamp": "04:28:24", "text": "要开心。"}, {"type": "subtitle", "time": 16107.349, "timestamp": "04:28:27", "text": "你仍然在VR聊天室里。好的。 19"}, {"type": "subtitle", "time": 16110.469, "timestamp": "04:28:30", "text": "小时。我的天啊。圣哉上帝。你应该"}, {"type": "subtitle", "time": 16112.07, "timestamp": "04:28:32", "text": "睡觉吧，笨蛋。你为什么还在玩VR？"}, {"type": "subtitle", "time": 16114.95, "timestamp": "04:28:34", "text": "聊天？燕麦"}, {"type": "subtitle", "time": 16118.11, "timestamp": "04:28:38", "text": "感谢您的光临。"}, {"type": "subtitle", "time": 16120.149, "timestamp": "04:28:40", "text": "[音乐]"}, {"type": "subtitle", "time": 16121.99, "timestamp": "04:28:41", "text": "我仍然需要你的帮助。"}, {"type": "subtitle", "time": 16127.51, "timestamp": "04:28:47", "text": "Billy 呃，关于 VU 账户和呃 Q"}, {"type": "subtitle", "time": 16129.67, "timestamp": "04:28:49", "text": "有了账户，我终于可以联系比利了。"}, {"type": "subtitle", "time": 16132.389, "timestamp": "04:28:52", "text": "比利的东西之类的。"}, {"type": "subtitle", "time": 16134.79, "timestamp": "04:28:54", "text": "是的。或者任何一位中国本土人士。"}, {"type": "subtitle", "time": 16139.83, "timestamp": "04:28:59", "text": "他们可以在这方面提供帮助。是啊，但是"}]
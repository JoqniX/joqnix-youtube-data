[{"type": "subtitle", "time": 13261.269, "timestamp": "03:41:01", "text": "未经你本人同意，就像……"}, {"type": "subtitle", "time": 13263.59, "timestamp": "03:41:03", "text": "无需您提供任何材料或"}, {"type": "subtitle", "time": 13267.59, "timestamp": "03:41:07", "text": "就像，或者你知道的，呃，就像……"}, {"type": "subtitle", "time": 13270.15, "timestamp": "03:41:10", "text": "比如说，如果有人挖得这么深，"}, {"type": "subtitle", "time": 13272.79, "timestamp": "03:41:12", "text": "明白了，这很糟糕。"}, {"type": "subtitle", "time": 13274.87, "timestamp": "03:41:14", "text": "但如果你已经把它送出去了"}, {"type": "subtitle", "time": 13276.95, "timestamp": "03:41:16", "text": "他们喜欢让公众看到你如何"}, {"type": "subtitle", "time": 13278.71, "timestamp": "03:41:18", "text": "看起来像那样，或者类似的东西，那就开始了。"}, {"type": "subtitle", "time": 13282.79, "timestamp": "03:41:22", "text": "是你，对吧？对那样的人。"}, {"type": "subtitle", "time": 13286.15, "timestamp": "03:41:26", "text": "我也是这么想的。所以，我们还没有"}, {"type": "subtitle", "time": 13290.55, "timestamp": "03:41:30", "text": "到了 80 年代流媒体的那个阶段"}, {"type": "subtitle", "time": 13293.75, "timestamp": "03:41:33", "text": "东西。我敢打赌，我敢肯定它会……"}, {"type": "subtitle", "time": 13295.59, "timestamp": "03:41:35", "text": "发生。我相信开发人员会"}, {"type": "subtitle", "time": 13297.19, "timestamp": "03:41:37", "text": "有"}, {"type": "subtitle", "time": 13299.11, "timestamp": "03:41:39", "text": "已经完成了。会有这样的时刻"}, {"type": "subtitle", "time": 13301.75, "timestamp": "03:41:41", "text": "因为主播们获得了扩展坞而进行人肉搜索是……"}, {"type": "subtitle", "time": 13304.07, "timestamp": "03:41:44", "text": "是件大事，对吧？当然，还有一段视频"}, {"type": "subtitle", "time": 13306.71, "timestamp": "03:41:46", "text": "游戏，呃，它想展示什么"}, {"type": "subtitle", "time": 13307.99, "timestamp": "03:41:47", "text": "就像流媒体的世界一样"}, {"type": "subtitle", "time": 13310.389, "timestamp": "03:41:50", "text": "一切都就是这样，诸如此类。"}, {"type": "subtitle", "time": 13312.07, "timestamp": "03:41:52", "text": "他们当然会加上去。我是"}, {"type": "subtitle", "time": 13314.95, "timestamp": "03:41:54", "text": "我对此深信不疑。我们仍然没有得到"}, {"type": "subtitle", "time": 13318.229, "timestamp": "03:41:58", "text": "到了那个阶段，但我知道"}]
[{"type": "subtitle", "time": 1868.47, "timestamp": "00:31:08", "text": "我实际执行的是默认值。"}, {"type": "subtitle", "time": 1872.389, "timestamp": "00:31:12", "text": "那是……身体上的。等等，是"}, {"type": "subtitle", "time": 1876.149, "timestamp": "00:31:16", "text": "惊人的动作。没有人能感到满足"}, {"type": "subtitle", "time": 1878.389, "timestamp": "00:31:18", "text": "现在的我。等等，什么？你们都干了些什么？"}, {"type": "subtitle", "time": 1880.389, "timestamp": "00:31:20", "text": "嗯？"}, {"type": "subtitle", "time": 1890.47, "timestamp": "00:31:30", "text": "真让我生气。他们正在讨论SC"}, {"type": "subtitle", "time": 1893.35, "timestamp": "00:31:33", "text": "然而，他们却想表现得好像他们想要那样。"}, {"type": "subtitle", "time": 1895.99, "timestamp": "00:31:35", "text": "装作自己很性感。"}, {"type": "subtitle", "time": 1898.95, "timestamp": "00:31:38", "text": "没错。好的。"}, {"type": "subtitle", "time": 1901.43, "timestamp": "00:31:41", "text": "他们做什么？实际上，我并没有"}, {"type": "subtitle", "time": 1904.149, "timestamp": "00:31:44", "text": "我明白你的意思吗？好的。"}, {"type": "subtitle", "time": 1906.47, "timestamp": "00:31:46", "text": "这样我就可以减少玩游戏的时间了。"}, {"type": "subtitle", "time": 1908.549, "timestamp": "00:31:48", "text": "东西。等等，等等，等等，等等。不，我"}, {"type": "subtitle", "time": 1911.25, "timestamp": "00:31:51", "text": "必须在那里观看直播。"}, {"type": "subtitle", "time": 1913.11, "timestamp": "00:31:53", "text": "[音乐]"}, {"type": "subtitle", "time": 1916.05, "timestamp": "00:31:56", "text": "杜也是。"}, {"type": "subtitle", "time": 1917.35, "timestamp": "00:31:57", "text": "[音乐]"}]
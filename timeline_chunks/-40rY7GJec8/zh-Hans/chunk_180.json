[{"type": "subtitle", "time": 10802.07, "timestamp": "03:00:02", "text": "发送消息并阅读它"}, {"type": "subtitle", "time": 10804.389, "timestamp": "03:00:04", "text": "喜欢看小主播，因为有很多"}, {"type": "subtitle", "time": 10806.309, "timestamp": "03:00:06", "text": "更多有趣的互动。是的，没错，没错。"}, {"type": "subtitle", "time": 10810.15, "timestamp": "03:00:10", "text": "没错，没错。就像我的主要计划一样"}, {"type": "subtitle", "time": 10812.63, "timestamp": "03:00:12", "text": "目标会是正确的。我想保留"}, {"type": "subtitle", "time": 10815.59, "timestamp": "03:00:15", "text": "事情目前就是这样。我的情况"}, {"type": "subtitle", "time": 10817.51, "timestamp": "03:00:17", "text": "与每个人互动"}, {"type": "subtitle", "time": 10820.15, "timestamp": "03:00:20", "text": "我正在尝试发送消息，但同时也保留了"}, {"type": "subtitle", "time": 10823.11, "timestamp": "03:00:23", "text": "日志确实很有帮助，这样我就可以回头阅读了。"}, {"type": "subtitle", "time": 10825.99, "timestamp": "03:00:25", "text": "它，并且知道发送了什么，以及"}, {"type": "subtitle", "time": 10828.55, "timestamp": "03:00:28", "text": "第二天回复。这就是原因"}, {"type": "subtitle", "time": 10830.79, "timestamp": "03:00:30", "text": "我喜欢思考这个问题。如果一个"}, {"type": "subtitle", "time": 10832.55, "timestamp": "03:00:32", "text": "天"}, {"type": "subtitle", "time": 10835.11, "timestamp": "03:00:35", "text": "如果有一天"}, {"type": "subtitle", "time": 10838.23, "timestamp": "03:00:38", "text": "我逐渐处于一个非常重要的位置。"}, {"type": "subtitle", "time": 10841.67, "timestamp": "03:00:41", "text": "主播之类的吧？"}, {"type": "subtitle", "time": 10844.389, "timestamp": "03:00:44", "text": "我该怎么办？我能读懂吗？"}, {"type": "subtitle", "time": 10847.91, "timestamp": "03:00:47", "text": "发送每一条消息"}, {"type": "subtitle", "time": 10850.469, "timestamp": "03:00:50", "text": "就像现在这样"}, {"type": "subtitle", "time": 10852.63, "timestamp": "03:00:52", "text": "如今，结束流是正确的，因为"}, {"type": "subtitle", "time": 10854.63, "timestamp": "03:00:54", "text": "大家都过来送东西"}, {"type": "subtitle", "time": 10857.269, "timestamp": "03:00:57", "text": "消息来自一些流"}, {"type": "subtitle", "time": 10859.91, "timestamp": "03:00:59", "text": "会的，会的，这需要很多，因为我"}]
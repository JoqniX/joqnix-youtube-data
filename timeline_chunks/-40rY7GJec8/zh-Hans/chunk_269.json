[{"type": "subtitle", "time": 16142.07, "timestamp": "04:29:02", "text": "你说过你会帮忙的。是的，他们会"}, {"type": "subtitle", "time": 16144.63, "timestamp": "04:29:04", "text": "帮助。所以，只要他们愿意，我就会寻求帮助。"}, {"type": "subtitle", "time": 16147.269, "timestamp": "04:29:07", "text": "自由的。我不想打扰他们。"}, {"type": "subtitle", "time": 16150.79, "timestamp": "04:29:10", "text": "但印度禁播确实很糟糕。"}, {"type": "subtitle", "time": 16155.269, "timestamp": "04:29:15", "text": "中国应用，老兄。但谢天谢地，当我"}, {"type": "subtitle", "time": 16157.51, "timestamp": "04:29:17", "text": "当时正在玩PUBG国服版"}, {"type": "subtitle", "time": 16160.229, "timestamp": "04:29:20", "text": "很久很久以前，好吧，2018年或"}, {"type": "subtitle", "time": 16163.91, "timestamp": "04:29:23", "text": "我做了一张图表，"}, {"type": "subtitle", "time": 16166.87, "timestamp": "04:29:26", "text": "我通过回顾我的记忆找到了我的身份证。"}, {"type": "subtitle", "time": 16169.91, "timestamp": "04:29:29", "text": "类似 Facebook 信息之类的即时通讯工具"}, {"type": "subtitle", "time": 16172.79, "timestamp": "04:29:32", "text": "比如，对我的一个朋友来说，我能够"}, {"type": "subtitle", "time": 16174.95, "timestamp": "04:29:34", "text": "找到它。我正在翻阅……"}, {"type": "subtitle", "time": 16177.269, "timestamp": "04:29:37", "text": "我的朋友发来的Facebook消息"}, {"type": "subtitle", "time": 16180.55, "timestamp": "04:29:40", "text": "恢复我的 Epic Games 账号访问权限"}, {"type": "subtitle", "time": 16182.55, "timestamp": "04:29:42", "text": "帐户。哦，对，我忘了回复。"}, {"type": "subtitle", "time": 16185.51, "timestamp": "04:29:45", "text": "DM。哦不，这是客服给我的邮件。"}, {"type": "subtitle", "time": 16189.03, "timestamp": "04:29:49", "text": "我的天哪，我的错。我的错。"}, {"type": "subtitle", "time": 16192.87, "timestamp": "04:29:52", "text": "12月26日。哦不，我需要一个"}, {"type": "subtitle", "time": 16195.91, "timestamp": "04:29:55", "text": "呃，我将激活这个激活功能。"}, {"type": "subtitle", "time": 16197.67, "timestamp": "04:29:57", "text": "好吧，好吧，我需要对此作出回应。我"}, {"type": "subtitle", "time": 16199.91, "timestamp": "04:29:59", "text": "忘了。我的天啊。我的天啊。是的。"}]
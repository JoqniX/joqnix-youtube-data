[{"type": "subtitle", "time": 6620.47, "timestamp": "01:50:20", "text": "等等，直播有延迟吗？在"}, {"type": "subtitle", "time": 6627.68, "timestamp": "01:50:27", "text": "等待。"}, {"type": "subtitle", "time": 6635.35, "timestamp": "01:50:35", "text": "[音乐]"}, {"type": "subtitle", "time": 6637.189, "timestamp": "01:50:37", "text": "你们谁都没有……我的天哪，她"}, {"type": "subtitle", "time": 6638.95, "timestamp": "01:50:38", "text": "往那边去了。那条路。不，那是"}, {"type": "subtitle", "time": 6654.31, "timestamp": "01:50:54", "text": "我是你的忠实粉丝。"}, {"type": "subtitle", "time": 6656.79, "timestamp": "01:50:56", "text": "好吧，她的粉丝确实达到了1000人。"}]
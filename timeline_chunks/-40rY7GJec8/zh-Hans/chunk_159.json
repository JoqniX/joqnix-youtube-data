[{"type": "subtitle", "time": 9542.309, "timestamp": "02:39:02", "text": "搬出去就更难了。"}, {"type": "subtitle", "time": 9544.95, "timestamp": "02:39:04", "text": "诸如此类，对吧？你必须是"}, {"type": "subtitle", "time": 9546.55, "timestamp": "02:39:06", "text": "独立的"}, {"type": "subtitle", "time": 9548.63, "timestamp": "02:39:08", "text": "征得父母的同意"}, {"type": "subtitle", "time": 9551.11, "timestamp": "02:39:11", "text": "最终获得独立"}, {"type": "subtitle", "time": 9552.87, "timestamp": "02:39:12", "text": "就像你必须带上你所有的东西一样。"}, {"type": "subtitle", "time": 9555.27, "timestamp": "02:39:15", "text": "从家到新地方等等"}, {"type": "subtitle", "time": 9560.15, "timestamp": "02:39:20", "text": "就像你知道的，呃"}, {"type": "subtitle", "time": 9562.79, "timestamp": "02:39:22", "text": "背景中传来宠物狗的叫声。是的，"}, {"type": "subtitle", "time": 9566.63, "timestamp": "02:39:26", "text": "就像那只宠物狗，或者呃，就像你的宠物一样"}, {"type": "subtitle", "time": 9568.63, "timestamp": "02:39:28", "text": "背景里一片混乱，就像疯了一样"}, {"type": "subtitle", "time": 9571.03, "timestamp": "02:39:31", "text": "那。诸如此类的事情。"}, {"type": "subtitle", "time": 9573.11, "timestamp": "02:39:33", "text": "是的。是的。是的。那是昨天的事了。"}, {"type": "subtitle", "time": 9580.87, "timestamp": "02:39:40", "text": "是的。谭昨天痊愈了。"}, {"type": "subtitle", "time": 9582.95, "timestamp": "02:39:42", "text": "呃"}, {"type": "subtitle", "time": 9585.429, "timestamp": "02:39:45", "text": "直到我们找到一份正常工作为止。"}, {"type": "subtitle", "time": 9587.429, "timestamp": "02:39:47", "text": "是的。是的。没错。没错。"}, {"type": "subtitle", "time": 9589.83, "timestamp": "02:39:49", "text": "但人们会建议什么，或者你的"}, {"type": "subtitle", "time": 9591.429, "timestamp": "02:39:51", "text": "家人建议直接去……"}, {"type": "subtitle", "time": 9594.15, "timestamp": "02:39:54", "text": "主持人、其他人员和现场"}, {"type": "subtitle", "time": 9596.63, "timestamp": "02:39:56", "text": "但那样的话，你还能带电脑吗？"}, {"type": "subtitle", "time": 9599.99, "timestamp": "02:39:59", "text": "你的物品和其他装备？不。"}]
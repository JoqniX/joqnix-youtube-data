[{"type": "subtitle", "time": 14340.229, "timestamp": "03:59:00", "text": "[音乐]"}, {"type": "subtitle", "time": 14342.389, "timestamp": "03:59:02", "text": "Jock确实有一个暗黑版本，但是"}, {"type": "subtitle", "time": 14346.07, "timestamp": "03:59:06", "text": "未公开"}, {"type": "subtitle", "time": 14347.75, "timestamp": "03:59:07", "text": "尚未上市。"}, {"type": "subtitle", "time": 14351.189, "timestamp": "03:59:11", "text": "但我不小心泄露了。我的天啊。"}, {"type": "subtitle", "time": 14354.229, "timestamp": "03:59:14", "text": "我为什么要移动它？是的，乔确实有一个"}, {"type": "subtitle", "time": 14357.11, "timestamp": "03:59:17", "text": "深色版本。但同时，我也像是在玩游戏。"}, {"type": "subtitle", "time": 14359.67, "timestamp": "03:59:19", "text": "四处走动"}, {"type": "subtitle", "time": 14363.03, "timestamp": "03:59:23", "text": "但从某种意义上说，我是在玩闹。"}, {"type": "subtitle", "time": 14366.469, "timestamp": "03:59:26", "text": "呃，该怎么称呼它呢？"}, {"type": "subtitle", "time": 14369.429, "timestamp": "03:59:29", "text": "是的，主要是玩玩而已"}, {"type": "subtitle", "time": 14370.95, "timestamp": "03:59:30", "text": "呃"}, {"type": "subtitle", "time": 14373.429, "timestamp": "03:59:33", "text": "它叫什么？"}, {"type": "subtitle", "time": 14376.309, "timestamp": "03:59:36", "text": "说实话，确实如此。是的，主要是玩游戏。"}, {"type": "subtitle", "time": 14379.75, "timestamp": "03:59:39", "text": "摆弄我的下半身装备，因为其中一个"}, {"type": "subtitle", "time": 14382.95, "timestamp": "03:59:42", "text": "你必须认为我正在做的事情"}, {"type": "subtitle", "time": 14385.11, "timestamp": "03:59:45", "text": "这话出自一个从不"}, {"type": "subtitle", "time": 14388.95, "timestamp": "03:59:48", "text": "他一生中是否写过或"}, {"type": "subtitle", "time": 14393.11, "timestamp": "03:59:53", "text": "写一本书或者类似故事之类的东西。"}, {"type": "subtitle", "time": 14395.99, "timestamp": "03:59:55", "text": "是啊，我得把它变成什么样。"}, {"type": "subtitle", "time": 14398.79, "timestamp": "03:59:58", "text": "像《电锯人》系列一样有趣"}]
[{"type": "subtitle", "time": 12360.55, "timestamp": "03:26:00", "text": "有充足的时间来支持"}, {"type": "subtitle", "time": 12363.03, "timestamp": "03:26:03", "text": "然后看看直播什么的，对吧？它是"}, {"type": "subtitle", "time": 12365.67, "timestamp": "03:26:05", "text": "美好的。但"}, {"type": "subtitle", "time": 12368.71, "timestamp": "03:26:08", "text": "即使仅仅是你的存在，你只是"}, {"type": "subtitle", "time": 12371.59, "timestamp": "03:26:11", "text": "你的出现本身就意味着……"}, {"type": "subtitle", "time": 12374.63, "timestamp": "03:26:14", "text": "对主播来说很多，对吧？不是"}, {"type": "subtitle", "time": 12376.389, "timestamp": "03:26:16", "text": "仅供我个人参考，但如果你在看一些视频的话。"}, {"type": "subtitle", "time": 12379.19, "timestamp": "03:26:19", "text": "其他你喜欢的主播是谁？"}, {"type": "subtitle", "time": 12381.349, "timestamp": "03:26:21", "text": "在您的订阅列表中的某个地方"}, {"type": "subtitle", "time": 12382.87, "timestamp": "03:26:22", "text": "是的"}, {"type": "subtitle", "time": 12386.309, "timestamp": "03:26:26", "text": "他们确实很感激你的到来。"}, {"type": "subtitle", "time": 12388.79, "timestamp": "03:26:28", "text": "你喜欢聊天和互动"}, {"type": "subtitle", "time": 12390.309, "timestamp": "03:26:30", "text": "他们"}, {"type": "subtitle", "time": 12392.63, "timestamp": "03:26:32", "text": "评论里全是点赞直播的内容"}, {"type": "subtitle", "time": 12395.19, "timestamp": "03:26:35", "text": "它所做的一切对他们来说意义重大。"}, {"type": "subtitle", "time": 12398.07, "timestamp": "03:26:38", "text": "就是这样，所以，我不是说像"}, {"type": "subtitle", "time": 12400.95, "timestamp": "03:26:40", "text": "你应该看看我，或者你知道的，或者"}, {"type": "subtitle", "time": 12404.229, "timestamp": "03:26:44", "text": "就像让别人发出“嗯，就像我……”的声音"}, {"type": "subtitle", "time": 12406.55, "timestamp": "03:26:46", "text": "比如同情，或者喂养，或者所有"}, {"type": "subtitle", "time": 12409.19, "timestamp": "03:26:49", "text": "那些话语所表达的一切感受。我不"}, {"type": "subtitle", "time": 12412.55, "timestamp": "03:26:52", "text": "知道吗？是的。不，不，不。"}, {"type": "subtitle", "time": 12415.11, "timestamp": "03:26:55", "text": "比如从一般的角度来看……"}]
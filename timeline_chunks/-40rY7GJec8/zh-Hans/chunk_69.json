[{"type": "subtitle", "time": 4142.309, "timestamp": "01:09:02", "text": "年纪大了还能看吗？我把它们录了下来。我喜欢"}, {"type": "subtitle", "time": 4144.95, "timestamp": "01:09:04", "text": "看着孩子们。"}, {"type": "subtitle", "time": 4149.11, "timestamp": "01:09:09", "text": "孩子们挺有趣，挺滑稽的。"}, {"type": "subtitle", "time": 4152.149, "timestamp": "01:09:12", "text": "你看着孩子们超级"}, {"type": "subtitle", "time": 4160.709, "timestamp": "01:09:20", "text": "[音乐]"}, {"type": "subtitle", "time": 4162.709, "timestamp": "01:09:22", "text": "我被一群孤独的人，通过一个特别的方式拯救了。"}, {"type": "subtitle", "time": 4165.269, "timestamp": "01:09:25", "text": "女孩动漫，我认为这让她们……"}, {"type": "subtitle", "time": 4168.95, "timestamp": "01:09:28", "text": "它们如此纯洁，就是如此吸引人。"}, {"type": "subtitle", "time": 4171.829, "timestamp": "01:09:31", "text": "嗯？"}, {"type": "subtitle", "time": 4174.789, "timestamp": "01:09:34", "text": "独奏虫火灵感和爱是"}, {"type": "subtitle", "time": 4177.12, "timestamp": "01:09:37", "text": "真是太鼓舞人心了，你知道吗？"}, {"type": "subtitle", "time": 4178.39, "timestamp": "01:09:38", "text": "[音乐]"}, {"type": "subtitle", "time": 4180.55, "timestamp": "01:09:40", "text": "拥有17,000"}, {"type": "subtitle", "time": 4183.749, "timestamp": "01:09:43", "text": "观众正在观看。哦，我的天哪，他们是天使吗？"}, {"type": "subtitle", "time": 4186.95, "timestamp": "01:09:46", "text": "受欢迎的。我的天啊。"}, {"type": "subtitle", "time": 4192.13, "timestamp": "01:09:52", "text": "可以谈谈我喜欢女孩的事。"}, {"type": "subtitle", "time": 4197.27, "timestamp": "01:09:57", "text": "[音乐]"}, {"type": "subtitle", "time": 4199.59, "timestamp": "01:09:59", "text": "我喜欢有小女孩的女孩，而且我"}]
[{"type": "subtitle", "time": 10440.23, "timestamp": "02:54:00", "text": "不断改进，因为在"}, {"type": "subtitle", "time": 10442.309, "timestamp": "02:54:02", "text": "你内心深处或你的心底"}, {"type": "subtitle", "time": 10444.95, "timestamp": "02:54:04", "text": "你知道总会有……"}, {"type": "subtitle", "time": 10448.15, "timestamp": "02:54:08", "text": "比你强的人，无论在什么方面都是如此。"}, {"type": "subtitle", "time": 10451.11, "timestamp": "02:54:11", "text": "上下文可以很独特，它可以像"}, {"type": "subtitle", "time": 10455.99, "timestamp": "02:54:15", "text": "比如说艺术，比如说音乐，比如说游戏，"}, {"type": "subtitle", "time": 10458.87, "timestamp": "02:54:18", "text": "等等。总会有更好的。"}, {"type": "subtitle", "time": 10461.19, "timestamp": "02:54:21", "text": "外面还有人。甚至研究，"}, {"type": "subtitle", "time": 10463.99, "timestamp": "02:54:23", "text": "万物皆有竞争，"}, {"type": "subtitle", "time": 10465.67, "timestamp": "02:54:25", "text": "正确的？"}, {"type": "subtitle", "time": 10469.67, "timestamp": "02:54:29", "text": "但重要的是你如何去做。"}, {"type": "subtitle", "time": 10471.59, "timestamp": "02:54:31", "text": "即使失败了，如果这是一个"}, {"type": "subtitle", "time": 10473.75, "timestamp": "02:54:33", "text": "即使你只是付出了努力，也能获得成功。"}, {"type": "subtitle", "time": 10477.03, "timestamp": "02:54:37", "text": "即使最终没有成功，也要尽力而为。"}, {"type": "subtitle", "time": 10479.59, "timestamp": "02:54:39", "text": "重要的是如何"}, {"type": "subtitle", "time": 10482.87, "timestamp": "02:54:42", "text": "你做了，而且你喜欢，哪怕只是一点点"}, {"type": "subtitle", "time": 10486.71, "timestamp": "02:54:46", "text": "参与人数。这是正确的。"}, {"type": "subtitle", "time": 10488.389, "timestamp": "02:54:48", "text": "想想每个人都想要什么"}, {"type": "subtitle", "time": 10490.79, "timestamp": "02:54:50", "text": "验证是不可避免的。"}, {"type": "subtitle", "time": 10493.11, "timestamp": "02:54:53", "text": "是的。是的。是的。我了解到我"}, {"type": "subtitle", "time": 10496.07, "timestamp": "02:54:56", "text": "明白了，就像我告诉她那样。"}, {"type": "subtitle", "time": 10499.51, "timestamp": "02:54:59", "text": "就像对自己一样，也像对其他人一样"}]
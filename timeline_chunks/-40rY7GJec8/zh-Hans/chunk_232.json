[{"type": "subtitle", "time": 13920.71, "timestamp": "03:52:00", "text": "我甚至试图找到替代品"}, {"type": "subtitle", "time": 13924.95, "timestamp": "03:52:04", "text": "我当运动员是因为我觉得自己不适合当运动员。"}, {"type": "subtitle", "time": 13927.75, "timestamp": "03:52:07", "text": "还有一些其他的东西，而且还有很好的……"}, {"type": "subtitle", "time": 13930.63, "timestamp": "03:52:10", "text": "替换，我和他都问过他们。"}, {"type": "subtitle", "time": 13934.389, "timestamp": "03:52:14", "text": "他不像个运动健将。"}, {"type": "subtitle", "time": 13936.15, "timestamp": "03:52:16", "text": "永远无法被取代"}, {"type": "subtitle", "time": 13937.91, "timestamp": "03:52:17", "text": "运动员，你必须明白你"}, {"type": "subtitle", "time": 13942.07, "timestamp": "03:52:22", "text": "即使我……也必须接受这个事实"}, {"type": "subtitle", "time": 13945.67, "timestamp": "03:52:25", "text": "如果他们是男人或者运动员，那就会发生一些事。"}, {"type": "subtitle", "time": 13948.95, "timestamp": "03:52:28", "text": "一切都不会再像以前那样了，而我"}, {"type": "subtitle", "time": 13952.71, "timestamp": "03:52:32", "text": "之后我意识到，呃，那是"}, {"type": "subtitle", "time": 13954.229, "timestamp": "03:52:34", "text": "真的"}, {"type": "subtitle", "time": 13958.469, "timestamp": "03:52:38", "text": "确实如此，就像……一样。"}, {"type": "subtitle", "time": 13962.15, "timestamp": "03:52:42", "text": "你在为一个角色配音，而且"}, {"type": "subtitle", "time": 13964.55, "timestamp": "03:52:44", "text": "那天你不能为角色配音"}, {"type": "subtitle", "time": 13966.95, "timestamp": "03:52:46", "text": "不再像其他人那样配音了"}, {"type": "subtitle", "time": 13969.99, "timestamp": "03:52:49", "text": "角色和人物是谁"}, {"type": "subtitle", "time": 13971.269, "timestamp": "03:52:51", "text": "了解这个角色并且喜欢他"}, {"type": "subtitle", "time": 13974.229, "timestamp": "03:52:54", "text": "他们会表现得好像没有感觉一样。"}, {"type": "subtitle", "time": 13977.189, "timestamp": "03:52:57", "text": "不再是了，因为他们曾经是，他们爱"}, {"type": "subtitle", "time": 13979.59, "timestamp": "03:52:59", "text": "是第一位配音演员，不是第二位。"}]
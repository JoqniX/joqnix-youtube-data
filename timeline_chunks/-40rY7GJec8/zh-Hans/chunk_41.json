[{"type": "subtitle", "time": 2461.589, "timestamp": "00:41:01", "text": "时间。我玩过一个游戏，你"}, {"type": "subtitle", "time": 2464.15, "timestamp": "00:41:04", "text": "成为具有全球影响力的大人物"}, {"type": "subtitle", "time": 2466.71, "timestamp": "00:41:06", "text": "不管发生了什么，我"}, {"type": "subtitle", "time": 2469.109, "timestamp": "00:41:09", "text": "结果就没吃饭了。好的，"}, {"type": "subtitle", "time": 2470.71, "timestamp": "00:41:10", "text": "你知道最近很多人都"}, {"type": "subtitle", "time": 2472.23, "timestamp": "00:41:12", "text": "他们喜欢有自己地方的地方"}, {"type": "subtitle", "time": 2474.47, "timestamp": "00:41:14", "text": "统治世界甚至削弱的权力"}, {"type": "subtitle", "time": 2477.109, "timestamp": "00:41:17", "text": "人口等等，还有一些人"}, {"type": "subtitle", "time": 2478.71, "timestamp": "00:41:18", "text": "我也真心相信那就是事实。"}, {"type": "subtitle", "time": 2480.309, "timestamp": "00:41:20", "text": "我们世界中发生的事件构成了这些。"}, {"type": "subtitle", "time": 2483.99, "timestamp": "00:41:23", "text": "野蛮的恶魔将他们的怒火指向"}, {"type": "subtitle", "time": 2485.67, "timestamp": "00:41:25", "text": "虽然我觉得玩它们有点……"}, {"type": "subtitle", "time": 2487.51, "timestamp": "00:41:27", "text": "在我们所处的时代，这并不奇怪。"}, {"type": "subtitle", "time": 2489.589, "timestamp": "00:41:29", "text": "人们希望某人或某事成为"}, {"type": "subtitle", "time": 2492.23, "timestamp": "00:41:32", "text": "虽然生气，但我们都应该努力工作。"}, {"type": "subtitle", "time": 2494.23, "timestamp": "00:41:34", "text": "请一起努力，这是我唯一的愿望。"}, {"type": "subtitle", "time": 2497.109, "timestamp": "00:41:37", "text": "那位天使是善良的，对吧？"}, {"type": "subtitle", "time": 2498.47, "timestamp": "00:41:38", "text": "嗯，我要说的是"}, {"type": "subtitle", "time": 2500.95, "timestamp": "00:41:40", "text": "看看这条信息流是如何呈现红色的。他们"}, {"type": "subtitle", "time": 2505.51, "timestamp": "00:41:45", "text": "它们是我的小豚鼠。我的天啊。"}, {"type": "subtitle", "time": 2509.19, "timestamp": "00:41:49", "text": "30年后，仍然只有一届政府。哦"}, {"type": "subtitle", "time": 2511.829, "timestamp": "00:41:51", "text": "我的上帝。你确定你应该这样做吗？"}]
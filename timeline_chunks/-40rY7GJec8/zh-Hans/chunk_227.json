[{"type": "subtitle", "time": 13621.99, "timestamp": "03:47:01", "text": "但是，呃，我再次深表歉意"}, {"type": "subtitle", "time": 13633.189, "timestamp": "03:47:13", "text": "我有时特别敏感。"}, {"type": "subtitle", "time": 13637.51, "timestamp": "03:47:17", "text": "嗯，从某种意义上说，这是一种方式"}, {"type": "subtitle", "time": 13639.429, "timestamp": "03:47:19", "text": "是"}, {"type": "subtitle", "time": 13641.269, "timestamp": "03:47:21", "text": "易受伤害的"}, {"type": "subtitle", "time": 13643.67, "timestamp": "03:47:23", "text": "而我在直播中展现的这种弱点"}, {"type": "subtitle", "time": 13647.349, "timestamp": "03:47:27", "text": "可以利用"}, {"type": "subtitle", "time": 13649.67, "timestamp": "03:47:29", "text": "被坏人或坏人所为"}, {"type": "subtitle", "time": 13652.63, "timestamp": "03:47:32", "text": "东西。所以我必须小心。"}, {"type": "subtitle", "time": 13654.95, "timestamp": "03:47:34", "text": "所以，但有时仍然很难坚持下去。"}, {"type": "subtitle", "time": 13659.51, "timestamp": "03:47:39", "text": "即使他有文件，也把它放进去。"}, {"type": "subtitle", "time": 13662.79, "timestamp": "03:47:42", "text": "有时候会漏出来，对吧？"}, {"type": "subtitle", "time": 13664.469, "timestamp": "03:47:44", "text": "我的意思是，如果你是一个曾经是……的人"}, {"type": "subtitle", "time": 13667.59, "timestamp": "03:47:47", "text": "活跃在推特上，一直在关注我的"}, {"type": "subtitle", "time": 13669.429, "timestamp": "03:47:49", "text": "你可能已经注意到推特上的活动"}, {"type": "subtitle", "time": 13671.59, "timestamp": "03:47:51", "text": "我去过的很多地方"}, {"type": "subtitle", "time": 13674.15, "timestamp": "03:47:54", "text": "努力"}, {"type": "subtitle", "time": 13677.349, "timestamp": "03:47:57", "text": "接下来请继续关注Jockn。"}]
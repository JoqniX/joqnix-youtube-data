[{"type": "subtitle", "time": 3305.99, "timestamp": "00:55:05", "text": "看看我的私信，全都无视我了。我是"}, {"type": "subtitle", "time": 3307.75, "timestamp": "00:55:07", "text": "看着你呢。对不起。我要"}, {"type": "subtitle", "time": 3311.589, "timestamp": "00:55:11", "text": "花光所有超级爵士乐"}, {"type": "subtitle", "time": 3313.109, "timestamp": "00:55:13", "text": "大使并带来更多高水平服务"}, {"type": "subtitle", "time": 3320.71, "timestamp": "00:55:20", "text": "你好吗？大家好。最终路线"}, {"type": "subtitle", "time": 3323.829, "timestamp": "00:55:23", "text": "做个书呆子。谢谢"}, {"type": "subtitle", "time": 3325.589, "timestamp": "00:55:25", "text": "你很努力。每个人"}, {"type": "subtitle", "time": 3327.27, "timestamp": "00:55:27", "text": "全世界都知道我的名字。请继续给我发邮件"}, {"type": "subtitle", "time": 3331.589, "timestamp": "00:55:31", "text": "您的支持。这也太可爱了吧。"}, {"type": "subtitle", "time": 3343.19, "timestamp": "00:55:43", "text": "我的天哪。哦，不。哦，不。哦，不。哦，不。哦"}, {"type": "subtitle", "time": 3353.91, "timestamp": "00:55:53", "text": "没关系。"}]
[{"type": "subtitle", "time": 9602.389, "timestamp": "02:40:02", "text": "会有一些人会……"}, {"type": "subtitle", "time": 9604.23, "timestamp": "02:40:04", "text": "嫉妒你的装备和一切"}, {"type": "subtitle", "time": 9605.91, "timestamp": "02:40:05", "text": "就像他们会试图偷窃一样"}, {"type": "subtitle", "time": 9607.91, "timestamp": "02:40:07", "text": "一切。所有发生的盗窃事件都会"}, {"type": "subtitle", "time": 9612.55, "timestamp": "02:40:12", "text": "发生。很多事情将会发生。"}, {"type": "subtitle", "time": 9614.71, "timestamp": "02:40:14", "text": "我的狗当时正盯着音箱看。"}, {"type": "subtitle", "time": 9618.23, "timestamp": "02:40:18", "text": "因为哦，等等。我的狗狗是等等，"}, {"type": "subtitle", "time": 9621.75, "timestamp": "02:40:21", "text": "那次直播是什么时候？"}, {"type": "subtitle", "time": 9627.03, "timestamp": "02:40:27", "text": "是我的狗狗吗？是的，我记得这件事。"}, {"type": "subtitle", "time": 9629.19, "timestamp": "02:40:29", "text": "一条流。是的，你听到了。"}, {"type": "subtitle", "time": 9631.19, "timestamp": "02:40:31", "text": "狗狗。哦，是的。今天她哦，是的。"}, {"type": "subtitle", "time": 9634.15, "timestamp": "02:40:34", "text": "今天狗狗挂饰叫个不停。"}, {"type": "subtitle", "time": 9637.11, "timestamp": "02:40:37", "text": "是的。是的。是的。是的。"}, {"type": "subtitle", "time": 9639.03, "timestamp": "02:40:39", "text": "狗狗一直在叫。是的。是的。"}, {"type": "subtitle", "time": 9640.8, "timestamp": "02:40:40", "text": "是的。是的。 曾是"}, {"type": "subtitle", "time": 9642.88, "timestamp": "02:40:42", "text": "曾是 今天播出还是其他播出？我没有"}, {"type": "subtitle", "time": 9644.64, "timestamp": "02:40:44", "text": "今天播出还是其他播出？我没有 知道。"}, {"type": "subtitle", "time": 9650.42, "timestamp": "02:40:50", "text": "是的，"}, {"type": "subtitle", "time": 9652.15, "timestamp": "02:40:52", "text": "[音乐]"}, {"type": "subtitle", "time": 9655.349, "timestamp": "02:40:55", "text": "但大多数人"}, {"type": "subtitle", "time": 9659.11, "timestamp": "02:40:59", "text": "不知道喜欢什么"}]
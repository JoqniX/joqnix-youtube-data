[{"type": "subtitle", "time": 1681.31, "timestamp": "00:28:01", "text": "戏服。我列了一张愿望清单。谢谢。"}, {"type": "subtitle", "time": 1682.87, "timestamp": "00:28:02", "text": "[音乐]"}, {"type": "subtitle", "time": 1685.11, "timestamp": "00:28:05", "text": "感谢所有到场的朋友们。"}, {"type": "subtitle", "time": 1692.389, "timestamp": "00:28:12", "text": "你给我买套戏服。我来自拍一张"}, {"type": "subtitle", "time": 1694.47, "timestamp": "00:28:14", "text": "也。我有一些关于如何操作的建议"}, {"type": "subtitle", "time": 1706.47, "timestamp": "00:28:26", "text": "如果我穿着这身衣服做爱。"}, {"type": "subtitle", "time": 1731.83, "timestamp": "00:28:51", "text": "[音乐]"}]
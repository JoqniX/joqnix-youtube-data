[{"type": "subtitle", "time": 3840.23, "timestamp": "01:04:00", "text": "与天使"}, {"type": "subtitle", "time": 3847.349, "timestamp": "01:04:07", "text": "明天"}, {"type": "subtitle", "time": 3850.39, "timestamp": "01:04:10", "text": "盈利方案已获批准。哦，哇。我们不会"}, {"type": "subtitle", "time": 3853.109, "timestamp": "01:04:13", "text": "因为他们只愿意被驱逐，所以才会被驱逐。"}, {"type": "subtitle", "time": 3856.15, "timestamp": "01:04:16", "text": "我们。哦，那很好。"}, {"type": "subtitle", "time": 3857.99, "timestamp": "01:04:17", "text": "那里。我不想直播"}, {"type": "subtitle", "time": 3861.029, "timestamp": "01:04:21", "text": "在溪流上。好的。"}, {"type": "subtitle", "time": 3863.27, "timestamp": "01:04:23", "text": "这两颗药丸是什么？一个用于"}, {"type": "subtitle", "time": 3865.43, "timestamp": "01:04:25", "text": "睡眠。不，其中一个是给男孩用的。"}, {"type": "subtitle", "time": 3873.27, "timestamp": "01:04:33", "text": "[音乐]"}, {"type": "subtitle", "time": 3876.15, "timestamp": "01:04:36", "text": "我想要更多粉丝和金钱。那更多"}, {"type": "subtitle", "time": 3880.15, "timestamp": "01:04:40", "text": "太多了。我需要更多云资源。更多的。"}, {"type": "subtitle", "time": 3883.19, "timestamp": "01:04:43", "text": "哦，不。"}, {"type": "subtitle", "time": 3892.86, "timestamp": "01:04:52", "text": "她让我很失望。"}, {"type": "subtitle", "time": 3898.86, "timestamp": "01:04:58", "text": "我不在乎。"}]
[{"type": "subtitle", "time": 15722.389, "timestamp": "04:22:02", "text": "好的。然后"}, {"type": "subtitle", "time": 15727.67, "timestamp": "04:22:07", "text": "今天就到这里，希望你们喜欢。"}, {"type": "subtitle", "time": 15729.67, "timestamp": "04:22:09", "text": "嗯？你在聊天方面非常活跃。"}, {"type": "subtitle", "time": 15731.11, "timestamp": "04:22:11", "text": "尽管。感谢您的参与"}, {"type": "subtitle", "time": 15733.429, "timestamp": "04:22:13", "text": "完全。真的，愿真主保佑。你一直"}, {"type": "subtitle", "time": 15735.429, "timestamp": "04:22:15", "text": "这样做很多次"}, {"type": "subtitle", "time": 15737.83, "timestamp": "04:22:17", "text": "自从你开始观看以来，就一直在看直播"}, {"type": "subtitle", "time": 15740.79, "timestamp": "04:22:20", "text": "我。我的天哪，我太高兴了！"}, {"type": "subtitle", "time": 15742.55, "timestamp": "04:22:22", "text": "感恩。谢谢。你不必"}, {"type": "subtitle", "time": 15745.349, "timestamp": "04:22:25", "text": "照做。哦，笨蛋，你不用这么做。"}, {"type": "subtitle", "time": 15746.95, "timestamp": "04:22:26", "text": "那。"}, {"type": "subtitle", "time": 15749.59, "timestamp": "04:22:29", "text": "等我开始直播的时候，就……"}, {"type": "subtitle", "time": 15751.11, "timestamp": "04:22:31", "text": "还会有其他主播。"}, {"type": "subtitle", "time": 15753.189, "timestamp": "04:22:33", "text": "同时在线播放。所以请支持他们。"}, {"type": "subtitle", "time": 15762.55, "timestamp": "04:22:42", "text": "希望你今天过得愉快"}, {"type": "subtitle", "time": 15764.389, "timestamp": "04:22:44", "text": "希望你接下来的日子过得愉快。"}, {"type": "subtitle", "time": 15767.75, "timestamp": "04:22:47", "text": "夜晚。是的。是的。谢谢你"}, {"type": "subtitle", "time": 15772.79, "timestamp": "04:22:52", "text": "很多，嗯，是的。谢谢你喜欢你"}, {"type": "subtitle", "time": 15775.189, "timestamp": "04:22:55", "text": "它叫什么来着？参与"}, {"type": "subtitle", "time": 15777.75, "timestamp": "04:22:57", "text": "我们讨论了很多话题"}]
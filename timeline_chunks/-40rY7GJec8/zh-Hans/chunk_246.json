[{"type": "subtitle", "time": 14761.03, "timestamp": "04:06:01", "text": "我可以考虑一下，也喜欢"}, {"type": "subtitle", "time": 14763.189, "timestamp": "04:06:03", "text": "这将给我写作的灵感。"}, {"type": "subtitle", "time": 14766.309, "timestamp": "04:06:06", "text": "我也喜欢做自己的事情，对吧？"}, {"type": "subtitle", "time": 14769.11, "timestamp": "04:06:09", "text": "就像那样"}, {"type": "subtitle", "time": 14772.07, "timestamp": "04:06:12", "text": "因为我是一个想要获得帮助的人。"}, {"type": "subtitle", "time": 14774.79, "timestamp": "04:06:14", "text": "但我不会这么做，因为这是我做的。"}, {"type": "subtitle", "time": 14778.07, "timestamp": "04:06:18", "text": "我给自己定了一条规矩：是的，我只会"}, {"type": "subtitle", "time": 14780.469, "timestamp": "04:06:20", "text": "遇到困难时我会寻求帮助。卡住，"}, {"type": "subtitle", "time": 14784.229, "timestamp": "04:06:24", "text": "我彻底卡住了，迷路了，动弹不得。如果我"}, {"type": "subtitle", "time": 14785.91, "timestamp": "04:06:25", "text": "我真的非常需要帮助，我永远"}, {"type": "subtitle", "time": 14788.309, "timestamp": "04:06:28", "text": "联系某人。这就是我的原因"}, {"type": "subtitle", "time": 14790.55, "timestamp": "04:06:30", "text": "我正在做所有我正在学习的事情，让自己变得如此。"}, {"type": "subtitle", "time": 14793.67, "timestamp": "04:06:33", "text": "学习所有这些技术方面的东西，比如"}, {"type": "subtitle", "time": 14796.229, "timestamp": "04:06:36", "text": "唱那些歌什么的等等。所以我可以"}, {"type": "subtitle", "time": 14799.11, "timestamp": "04:06:39", "text": "逼自己去做，去做，再去做"}, {"type": "subtitle", "time": 14801.67, "timestamp": "04:06:41", "text": "让自己感觉好些。如果我被困住了，我"}, {"type": "subtitle", "time": 14804.55, "timestamp": "04:06:44", "text": "会向别人寻求帮助之类的。"}, {"type": "subtitle", "time": 14807.11, "timestamp": "04:06:47", "text": "是的。是的。是的。"}, {"type": "subtitle", "time": 14809.349, "timestamp": "04:06:49", "text": "我觉得我漏掉了一些部分，对吗？"}, {"type": "subtitle", "time": 14811.11, "timestamp": "04:06:51", "text": "今天的直播我有点"}, {"type": "subtitle", "time": 14813.99, "timestamp": "04:06:53", "text": "我漏掉了一些我刚才提到的话题，而且"}, {"type": "subtitle", "time": 14817.269, "timestamp": "04:06:57", "text": "有点偏离轨道了，所以现在"}, {"type": "subtitle", "time": 14819.99, "timestamp": "04:06:59", "text": "布里特说过的一件事是……"}]
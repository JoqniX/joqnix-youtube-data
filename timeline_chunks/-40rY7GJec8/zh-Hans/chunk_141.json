[{"type": "subtitle", "time": 8460.389, "timestamp": "02:21:00", "text": "他一直都在忙着应付杂耍吗？"}, {"type": "subtitle", "time": 8467.11, "timestamp": "02:21:07", "text": "[音乐]"}, {"type": "subtitle", "time": 8472.99, "timestamp": "02:21:12", "text": "哦。"}, {"type": "subtitle", "time": 8487.91, "timestamp": "02:21:27", "text": "[音乐]"}, {"type": "subtitle", "time": 8491.27, "timestamp": "02:21:31", "text": "哦，不。哦，不。哦，不。"}, {"type": "subtitle", "time": 8493.75, "timestamp": "02:21:33", "text": "哦，不。不，不，不。"}, {"type": "subtitle", "time": 8495.67, "timestamp": "02:21:35", "text": "你应该是一名南非主播。哦"}, {"type": "subtitle", "time": 8497.99, "timestamp": "02:21:37", "text": "我的上帝。真倒霉。"}, {"type": "subtitle", "time": 8499.51, "timestamp": "02:21:39", "text": "我"}, {"type": "subtitle", "time": 8508.39, "timestamp": "02:21:48", "text": "等等，她之前是打算这么做的吗？"}, {"type": "subtitle", "time": 8510.469, "timestamp": "02:21:50", "text": "[音乐]"}, {"type": "subtitle", "time": 8513.429, "timestamp": "02:21:53", "text": "假设我可以给予一点小奖励。"}, {"type": "subtitle", "time": 8515.67, "timestamp": "02:21:55", "text": "是的，这很糟糕。是的，这就是我"}]
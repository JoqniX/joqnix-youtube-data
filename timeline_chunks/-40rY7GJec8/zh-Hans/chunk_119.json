[{"type": "subtitle", "time": 7140.79, "timestamp": "01:59:00", "text": "互联网上的所有人。啊。"}, {"type": "subtitle", "time": 7145.43, "timestamp": "01:59:05", "text": "设置过于严格。我的天啊。"}, {"type": "subtitle", "time": 7153.43, "timestamp": "01:59:13", "text": "那是什么在哭？"}, {"type": "subtitle", "time": 7155.27, "timestamp": "01:59:15", "text": "我觉得你好像也说过类似的话。"}, {"type": "subtitle", "time": 7158.229, "timestamp": "01:59:18", "text": "前。感谢您前来。"}, {"type": "subtitle", "time": 7159.57, "timestamp": "01:59:19", "text": "请保佑我们。"}, {"type": "subtitle", "time": 7163.75, "timestamp": "01:59:23", "text": "[音乐]"}, {"type": "subtitle", "time": 7166.229, "timestamp": "01:59:26", "text": "好的。"}, {"type": "subtitle", "time": 7168.31, "timestamp": "01:59:28", "text": "现在真是太恶心了。是的，你应该去"}, {"type": "subtitle", "time": 7170.709, "timestamp": "01:59:30", "text": "退后。什么？"}, {"type": "subtitle", "time": 7172.55, "timestamp": "01:59:32", "text": "我们当中充斥着过多的愤怒和善意。"}, {"type": "subtitle", "time": 7175.109, "timestamp": "01:59:35", "text": "不太容易分辨。好的。无论何时你"}, {"type": "subtitle", "time": 7176.629, "timestamp": "01:59:36", "text": "感觉，我想让你知道你可以"}, {"type": "subtitle", "time": 7184.39, "timestamp": "01:59:44", "text": "哦，我"}, {"type": "subtitle", "time": 7187.83, "timestamp": "01:59:47", "text": "救救我们。等等，大家都玩得很开心啊。"}, {"type": "subtitle", "time": 7190.95, "timestamp": "01:59:50", "text": "现在发表评论。等等，什么？"}, {"type": "subtitle", "time": 7192.79, "timestamp": "01:59:52", "text": "知道了。"}, {"type": "subtitle", "time": 7194.47, "timestamp": "01:59:54", "text": "现在大家都在说好话。"}]
[{"type": "subtitle", "time": 720.47, "timestamp": "00:12:00", "text": "爱德华之子。你今天怎么样？我"}, {"type": "subtitle", "time": 723.11, "timestamp": "00:12:03", "text": "希望你一切都好。让我改变我的"}, {"type": "subtitle", "time": 727.67, "timestamp": "00:12:07", "text": "聊天转至在线聊天。过来。"}, {"type": "subtitle", "time": 729.509, "timestamp": "00:12:09", "text": "是的，她正低头看着他们。"}, {"type": "subtitle", "time": 739.35, "timestamp": "00:12:19", "text": "好了，我们走吧。"}, {"type": "subtitle", "time": 746.389, "timestamp": "00:12:26", "text": "我们去买一只巨型乌龟吧。是她吗？"}, {"type": "subtitle", "time": 759.75, "timestamp": "00:12:39", "text": "哇。"}, {"type": "subtitle", "time": 761.829, "timestamp": "00:12:41", "text": "该死。我想我唯一能做的就是"}, {"type": "subtitle", "time": 765.81, "timestamp": "00:12:45", "text": "去买个巨人。"}, {"type": "subtitle", "time": 768.87, "timestamp": "00:12:48", "text": "[音乐]"}, {"type": "subtitle", "time": 771.99, "timestamp": "00:12:51", "text": "我爱你。"}, {"type": "subtitle", "time": 774.23, "timestamp": "00:12:54", "text": "我希望她不会误解我的意思。"}]
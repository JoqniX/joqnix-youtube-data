[{"type": "subtitle", "time": 16321.59, "timestamp": "04:32:01", "text": "是的。九月、十月期间。是的。"}, {"type": "subtitle", "time": 16324.229, "timestamp": "04:32:04", "text": "是的。那段时间我过得很艰难。"}, {"type": "subtitle", "time": 16327.11, "timestamp": "04:32:07", "text": "我渲染了，呃，没有渲染，渲染了"}, {"type": "subtitle", "time": 16329.03, "timestamp": "04:32:09", "text": "渲染了什么，还有那些东西，而我当时"}, {"type": "subtitle", "time": 16331.269, "timestamp": "04:32:11", "text": "因为种种困难而感到难过"}, {"type": "subtitle", "time": 16333.429, "timestamp": "04:32:13", "text": "东西"}, {"type": "subtitle", "time": 16335.11, "timestamp": "04:32:15", "text": "比如说到YouTube等等"}, {"type": "subtitle", "time": 16338.149, "timestamp": "04:32:18", "text": "那。所以，然后他说他那句“好话”"}, {"type": "subtitle", "time": 16341.59, "timestamp": "04:32:21", "text": "那些让我哭了很多次的话语和事情"}, {"type": "subtitle", "time": 16345.59, "timestamp": "04:32:25", "text": "让我，让我的心……"}, {"type": "subtitle", "time": 16348.309, "timestamp": "04:32:28", "text": "土居"}, {"type": "subtitle", "time": 16352.07, "timestamp": "04:32:32", "text": "因做某事而受到赞赏的感觉"}, {"type": "subtitle", "time": 16355.75, "timestamp": "04:32:35", "text": "我尽力了。是的。自从……以来，我一直"}, {"type": "subtitle", "time": 16358.149, "timestamp": "04:32:38", "text": "给每个人拍拍头、拥抱"}, {"type": "subtitle", "time": 16361.03, "timestamp": "04:32:41", "text": "以及所有那些感谢的话语"}, {"type": "subtitle", "time": 16363.67, "timestamp": "04:32:43", "text": "他们尽力而为，因为我就是，我曾经是某人"}, {"type": "subtitle", "time": 16366.55, "timestamp": "04:32:46", "text": "那些从未因……而获得赏识的人"}, {"type": "subtitle", "time": 16370.63, "timestamp": "04:32:50", "text": "无论我做什么，或者任何事。所以，我得到了"}, {"type": "subtitle", "time": 16372.63, "timestamp": "04:32:52", "text": "感谢您的赞赏之词。"}, {"type": "subtitle", "time": 16376.07, "timestamp": "04:32:56", "text": "那真的让我心都融化了。所以"}, {"type": "subtitle", "time": 16378.469, "timestamp": "04:32:58", "text": "是的，自从有一天我……"}]
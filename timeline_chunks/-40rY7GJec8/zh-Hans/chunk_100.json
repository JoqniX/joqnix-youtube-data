[{"type": "subtitle", "time": 6008.47, "timestamp": "01:40:08", "text": "事情变得有点失控了，我的天哪"}, {"type": "subtitle", "time": 6011.75, "timestamp": "01:40:11", "text": "我不想让她变坏，所以我"}, {"type": "subtitle", "time": 6025.75, "timestamp": "01:40:25", "text": "呃，我醒来的时候，太阳已经出来了。"}, {"type": "subtitle", "time": 6028.229, "timestamp": "01:40:28", "text": "环境。做完自己的事情后，我感觉头晕乎乎的。我可以吗？"}, {"type": "subtitle", "time": 6031.669, "timestamp": "01:40:31", "text": "就睡觉？当然。"}, {"type": "subtitle", "time": 6033.43, "timestamp": "01:40:33", "text": "是的。是的。"}, {"type": "subtitle", "time": 6037.35, "timestamp": "01:40:37", "text": "现在我想谋生。"}, {"type": "subtitle", "time": 6042.07, "timestamp": "01:40:42", "text": "不，我当时用了一些"}, {"type": "subtitle", "time": 6053.34, "timestamp": "01:40:53", "text": "你呢？"}, {"type": "subtitle", "time": 6055.99, "timestamp": "01:40:55", "text": "[音乐]"}]
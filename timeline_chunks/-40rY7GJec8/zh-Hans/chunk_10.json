[{"type": "subtitle", "time": 607.75, "timestamp": "00:10:07", "text": "哦，"}, {"type": "subtitle", "time": 611.829, "timestamp": "00:10:11", "text": "我太喜欢康瑟了。"}, {"type": "subtitle", "time": 613.67, "timestamp": "00:10:13", "text": "好的。如果你这么做了，答应我你会……"}, {"type": "subtitle", "time": 616.55, "timestamp": "00:10:16", "text": "弄到一部电视"}, {"type": "subtitle", "time": 619.99, "timestamp": "00:10:19", "text": "答应我你会去"}, {"type": "subtitle", "time": 621.829, "timestamp": "00:10:21", "text": "你最终会离开的。如果"}, {"type": "subtitle", "time": 623.829, "timestamp": "00:10:23", "text": "你"}, {"type": "subtitle", "time": 626.069, "timestamp": "00:10:26", "text": "如果你什么"}, {"type": "subtitle", "time": 629.59, "timestamp": "00:10:29", "text": "如果我曾被任何人带走，那将是怜悯。"}, {"type": "subtitle", "time": 633.91, "timestamp": "00:10:33", "text": "杀了我吧。你在说什么？"}, {"type": "subtitle", "time": 636.23, "timestamp": "00:10:36", "text": "打扰一下。"}, {"type": "subtitle", "time": 638.31, "timestamp": "00:10:38", "text": "有一件事你可以直接扔掉，那就是"}, {"type": "subtitle", "time": 641.59, "timestamp": "00:10:41", "text": "确实如此，刀子上是这样的。但对我来说，事实是"}, {"type": "subtitle", "time": 643.67, "timestamp": "00:10:43", "text": "你是我的粉丝。永远不要欺骗你或背叛你"}, {"type": "subtitle", "time": 646.15, "timestamp": "00:10:46", "text": "我的背靠着你。你确定你应该"}, {"type": "subtitle", "time": 649.59, "timestamp": "00:10:49", "text": "你是说这个吗？安吉尔·查玛。"}, {"type": "subtitle", "time": 652.71, "timestamp": "00:10:52", "text": "我的天啊。我会在社交媒体上狠狠地骂你们。"}, {"type": "subtitle", "time": 655.75, "timestamp": "00:10:55", "text": "私人门。刘亦然。只要没有"}, {"type": "subtitle", "time": 659.35, "timestamp": "00:10:59", "text": "一旦找到它，他们就能幸福地生活下去。"}]
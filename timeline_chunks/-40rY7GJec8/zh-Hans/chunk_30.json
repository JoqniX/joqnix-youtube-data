[{"type": "subtitle", "time": 1800.23, "timestamp": "00:30:00", "text": "职业 71."}, {"type": "subtitle", "time": 1806.71, "timestamp": "00:30:06", "text": "嘿，我应该这样做来降低"}, {"type": "subtitle", "time": 1816.31, "timestamp": "00:30:16", "text": "嗯，"}, {"type": "subtitle", "time": 1818.87, "timestamp": "00:30:18", "text": "这些事情只会减少。"}, {"type": "subtitle", "time": 1820.95, "timestamp": "00:30:20", "text": "一点点。"}, {"type": "subtitle", "time": 1831.11, "timestamp": "00:30:31", "text": "只睡40-49分钟。"}, {"type": "subtitle", "time": 1833.669, "timestamp": "00:30:33", "text": "我可以睡到明天，因为"}, {"type": "subtitle", "time": 1839.029, "timestamp": "00:30:39", "text": "就像服务员送来的礼物一样，只是份量更少。"}, {"type": "subtitle", "time": 1842.92, "timestamp": "00:30:42", "text": "好的。那么这个东西呢？"}, {"type": "subtitle", "time": 1844.31, "timestamp": "00:30:44", "text": "[音乐]"}, {"type": "subtitle", "time": 1846.63, "timestamp": "00:30:46", "text": "这样我就可以提高时尚度。"}, {"type": "subtitle", "time": 1850.07, "timestamp": "00:30:50", "text": "也是，对吧？所以"}, {"type": "subtitle", "time": 1853.58, "timestamp": "00:30:53", "text": "我想试试这个。"}]
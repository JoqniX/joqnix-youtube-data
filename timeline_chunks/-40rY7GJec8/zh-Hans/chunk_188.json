[{"type": "subtitle", "time": 11282.15, "timestamp": "03:08:02", "text": "我觉得我尽量保持公平。"}, {"type": "subtitle", "time": 11284.63, "timestamp": "03:08:04", "text": "如果我像说一些特别的话一样"}, {"type": "subtitle", "time": 11286.71, "timestamp": "03:08:06", "text": "以及所有那些事，或者像给予一样。"}, {"type": "subtitle", "time": 11289.19, "timestamp": "03:08:09", "text": "我尽量给每个人都起昵称。"}, {"type": "subtitle", "time": 11291.429, "timestamp": "03:08:11", "text": "而我还在努力让你"}, {"type": "subtitle", "time": 11295.349, "timestamp": "03:08:15", "text": "凡事平等，这样就不会有人感到哦"}, {"type": "subtitle", "time": 11297.269, "timestamp": "03:08:17", "text": "就像有一天，就像没有人一样"}, {"type": "subtitle", "time": 11299.349, "timestamp": "03:08:19", "text": "像骑师一样盯着直播"}, {"type": "subtitle", "time": 11301.59, "timestamp": "03:08:21", "text": "把更多注意力放在那个人身上，而不是我身上。"}, {"type": "subtitle", "time": 11305.67, "timestamp": "03:08:25", "text": "没有，他为什么恨我？不，我"}, {"type": "subtitle", "time": 11312.55, "timestamp": "03:08:32", "text": "所以我才一直在这里看你。"}, {"type": "subtitle", "time": 11313.99, "timestamp": "03:08:33", "text": "达到那种状态。当你长大后"}, {"type": "subtitle", "time": 11315.75, "timestamp": "03:08:35", "text": "下次你成为伟大的黑暗时"}, {"type": "subtitle", "time": 11317.83, "timestamp": "03:08:37", "text": "努力奋斗，我会看到你成长。我不会加入"}, {"type": "subtitle", "time": 11320.15, "timestamp": "03:08:40", "text": "它。中，"}, {"type": "subtitle", "time": 11324.23, "timestamp": "03:08:44", "text": "我的意思是，嗯，米娅，我记得我说过这话"}, {"type": "subtitle", "time": 11326.87, "timestamp": "03:08:46", "text": "我再重复一遍，对吧？那些"}, {"type": "subtitle", "time": 11328.87, "timestamp": "03:08:48", "text": "如果他们身处家族之中，他们就会是"}, {"type": "subtitle", "time": 11334.07, "timestamp": "03:08:54", "text": "始终是其中的一部分。即使，即使"}, {"type": "subtitle", "time": 11337.11, "timestamp": "03:08:57", "text": "你不再是这个家庭的一份子了。"}, {"type": "subtitle", "time": 11339.67, "timestamp": "03:08:59", "text": "现在，我有一份名单，上面列着这些人："}]
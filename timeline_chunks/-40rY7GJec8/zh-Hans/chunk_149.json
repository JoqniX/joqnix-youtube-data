[{"type": "subtitle", "time": 8942.309, "timestamp": "02:29:02", "text": "我现在没事。好的。"}, {"type": "subtitle", "time": 8944.63, "timestamp": "02:29:04", "text": "接下来，我们做了这件事。这件事没成功。"}, {"type": "subtitle", "time": 8948.71, "timestamp": "02:29:08", "text": "所以，一起待着吧。我不会出去玩。"}, {"type": "subtitle", "time": 8952.07, "timestamp": "02:29:12", "text": "相反，我会这样做"}, {"type": "subtitle", "time": 8959.27, "timestamp": "02:29:19", "text": "睡到明天吧。"}, {"type": "subtitle", "time": 8967.97, "timestamp": "02:29:27", "text": "一秒钟。"}, {"type": "subtitle", "time": 8990.23, "timestamp": "02:29:50", "text": "[音乐]"}, {"type": "subtitle", "time": 8992.9, "timestamp": "02:29:52", "text": "嘘。"}]
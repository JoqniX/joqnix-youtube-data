[{"type": "subtitle", "time": 1084.23, "timestamp": "00:18:04", "text": "[音乐]"}, {"type": "subtitle", "time": 1086.15, "timestamp": "00:18:06", "text": "嘿，大家好，我是你们最喜欢的K Angel。"}, {"type": "subtitle", "time": 1091.27, "timestamp": "00:18:11", "text": "守门员。哥特天使，献给我的美丽。哟，"}, {"type": "subtitle", "time": 1106.23, "timestamp": "00:18:26", "text": "买了一些衣服，然后我就去了"}, {"type": "subtitle", "time": 1108.549, "timestamp": "00:18:28", "text": "买"}, {"type": "subtitle", "time": 1110.789, "timestamp": "00:18:30", "text": "还有他们。"}, {"type": "subtitle", "time": 1114.31, "timestamp": "00:18:34", "text": "我也想去。"}, {"type": "subtitle", "time": 1117.43, "timestamp": "00:18:37", "text": "唉，如果我性格外向就好了，是吧？我"}, {"type": "subtitle", "time": 1119.35, "timestamp": "00:18:39", "text": "本来会买很多东西，而且也确实这么做了。"}, {"type": "subtitle", "time": 1121.59, "timestamp": "00:18:41", "text": "一些适合直播的内容。"}, {"type": "subtitle", "time": 1124.63, "timestamp": "00:18:44", "text": "做一个宅在家里的内向者真够糟糕的。"}, {"type": "subtitle", "time": 1132.07, "timestamp": "00:18:52", "text": "[音乐]"}, {"type": "subtitle", "time": 1134.71, "timestamp": "00:18:54", "text": "所以，你愿意和我约会吗？"}, {"type": "subtitle", "time": 1137.19, "timestamp": "00:18:57", "text": "问号。他人。我的天啊。"}, {"type": "subtitle", "time": 1139.669, "timestamp": "00:18:59", "text": "不，你永远不可能和她一起去。"}]
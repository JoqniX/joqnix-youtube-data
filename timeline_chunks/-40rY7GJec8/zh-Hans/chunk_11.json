[{"type": "subtitle", "time": 661.75, "timestamp": "00:11:01", "text": "永远浑然不觉。"}, {"type": "subtitle", "time": 665.43, "timestamp": "00:11:05", "text": "我的天啊。即使有人试图寻找"}, {"type": "subtitle", "time": 666.79, "timestamp": "00:11:06", "text": "这又不是我犯了什么罪"}, {"type": "subtitle", "time": 668.389, "timestamp": "00:11:08", "text": "犯罪。即使感觉像是一个"}, {"type": "subtitle", "time": 670.87, "timestamp": "00:11:10", "text": "背叛，这就是我们这个世界的本质。"}, {"type": "subtitle", "time": 673.75, "timestamp": "00:11:13", "text": "作品。我的天啊。"}, {"type": "subtitle", "time": 676.949, "timestamp": "00:11:16", "text": "什么？人们会做这样的事。"}, {"type": "subtitle", "time": 679.91, "timestamp": "00:11:19", "text": "哇。"}, {"type": "subtitle", "time": 683.11, "timestamp": "00:11:23", "text": "他们在直播中表现得都很友善，而且"}, {"type": "subtitle", "time": 689.91, "timestamp": "00:11:29", "text": "该死。"}, {"type": "subtitle", "time": 710.15, "timestamp": "00:11:50", "text": "该怎么办？帮我。请给我游戏机会"}, {"type": "subtitle", "time": 718.63, "timestamp": "00:11:58", "text": "骑上一只巨大的乌龟。是的。你好"}]
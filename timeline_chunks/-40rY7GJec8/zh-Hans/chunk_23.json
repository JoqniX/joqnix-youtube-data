[{"type": "subtitle", "time": 1383.35, "timestamp": "00:23:03", "text": "正确的。复古游戏难度要高得多。所以"}, {"type": "subtitle", "time": 1386.789, "timestamp": "00:23:06", "text": "那对我不利。"}, {"type": "subtitle", "time": 1388.87, "timestamp": "00:23:08", "text": "串流播放某些复古游戏并不好。"}, {"type": "subtitle", "time": 1399.19, "timestamp": "00:23:19", "text": "我的意思是，人们将无法看到她。"}, {"type": "subtitle", "time": 1400.63, "timestamp": "00:23:20", "text": "这是私人账号，对吧？因为是"}, {"type": "subtitle", "time": 1403.27, "timestamp": "00:23:23", "text": "私有。实际上没有人能看到它。"}, {"type": "subtitle", "time": 1409.19, "timestamp": "00:23:29", "text": "我想这样应该没问题。哦，我们需要一个"}, {"type": "subtitle", "time": 1418.71, "timestamp": "00:23:38", "text": "我正在上菜，萨尔。好的。"}, {"type": "subtitle", "time": 1425.83, "timestamp": "00:23:45", "text": "好的。你是什​​么意思？好的。"}, {"type": "subtitle", "time": 1427.35, "timestamp": "00:23:47", "text": "[音乐]"}, {"type": "subtitle", "time": 1434.71, "timestamp": "00:23:54", "text": "不，我想你会的。不是那样。不是"}, {"type": "subtitle", "time": 1436.39, "timestamp": "00:23:56", "text": "我想你会的，但如果你作弊的话"}, {"type": "subtitle", "time": 1439.1, "timestamp": "00:23:59", "text": "我发誓，我会杀了你。我的天啊。"}]
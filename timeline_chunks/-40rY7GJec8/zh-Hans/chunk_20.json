[{"type": "subtitle", "time": 1201.669, "timestamp": "00:20:01", "text": "你在干什么？你觉得我们怎么样？"}, {"type": "subtitle", "time": 1205.11, "timestamp": "00:20:05", "text": "你在做什么？我们正在播放原生流媒体"}, {"type": "subtitle", "time": 1207.75, "timestamp": "00:20:07", "text": "霸王"}, {"type": "subtitle", "time": 1210.63, "timestamp": "00:20:10", "text": "目前，K Angel 身穿一件"}, {"type": "subtitle", "time": 1215.35, "timestamp": "00:20:15", "text": "Lolly 哥特萝莉塔连衣裙和"}, {"type": "subtitle", "time": 1217.029, "timestamp": "00:20:17", "text": "她正在获得新的粉丝和新的关注者。"}, {"type": "subtitle", "time": 1218.71, "timestamp": "00:20:18", "text": "垫片"}, {"type": "subtitle", "time": 1224.95, "timestamp": "00:20:24", "text": "我稍后会上传一张照片发到推特上。"}, {"type": "subtitle", "time": 1227.51, "timestamp": "00:20:27", "text": "你们最好给我100分。这可是……"}, {"type": "subtitle", "time": 1231.909, "timestamp": "00:20:31", "text": "很多零点赞。好的。"}, {"type": "subtitle", "time": 1234.07, "timestamp": "00:20:34", "text": "安珠，你们都照做。不，"}, {"type": "subtitle", "time": 1237.83, "timestamp": "00:20:37", "text": "我会葬在洛丽塔里。哦"}, {"type": "subtitle", "time": 1240.149, "timestamp": "00:20:40", "text": "我的天，她在《权力的游戏》里真的好可爱。"}, {"type": "subtitle", "time": 1243.19, "timestamp": "00:20:43", "text": "洛丽塔连衣裙。"}, {"type": "subtitle", "time": 1253.51, "timestamp": "00:20:53", "text": "我想我会一直做到15岁，也许30岁。"}]
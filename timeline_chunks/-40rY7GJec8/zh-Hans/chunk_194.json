[{"type": "subtitle", "time": 11640.71, "timestamp": "03:14:00", "text": "地位就像我拥有自己的"}, {"type": "subtitle", "time": 11645.03, "timestamp": "03:14:05", "text": "自定义表情，让任何人都能参与其中"}, {"type": "subtitle", "time": 11648.79, "timestamp": "03:14:08", "text": "不过，聊天功能可以在任何地方使用。"}, {"type": "subtitle", "time": 11652.07, "timestamp": "03:14:12", "text": "如果他们喜欢，就像这样退出我的直播吧"}, {"type": "subtitle", "time": 11653.83, "timestamp": "03:14:13", "text": "表情符号。这是唯一一件事"}, {"type": "subtitle", "time": 11657.03, "timestamp": "03:14:17", "text": "让我开心，也喜欢……"}, {"type": "subtitle", "time": 11658.55, "timestamp": "03:14:18", "text": "通道点。这样他们就可以"}, {"type": "subtitle", "time": 11660.55, "timestamp": "03:14:20", "text": "多互动，对吧？而且还有类似这样的"}, {"type": "subtitle", "time": 11662.55, "timestamp": "03:14:22", "text": "民意调查之类的。那就是"}, {"type": "subtitle", "time": 11664.63, "timestamp": "03:14:24", "text": "我唯一喜欢联盟营销的地方是"}, {"type": "subtitle", "time": 11668.469, "timestamp": "03:14:28", "text": "Twitch，或者说是Twitch上的合作伙伴。"}, {"type": "subtitle", "time": 11670.389, "timestamp": "03:14:30", "text": "就像"}, {"type": "subtitle", "time": 11672.469, "timestamp": "03:14:32", "text": "当谈到人们"}, {"type": "subtitle", "time": 11674.79, "timestamp": "03:14:34", "text": "开始"}, {"type": "subtitle", "time": 11677.03, "timestamp": "03:14:37", "text": "发送信息、订阅等等，我"}, {"type": "subtitle", "time": 11680.309, "timestamp": "03:14:40", "text": "开始哭个不停。"}, {"type": "subtitle", "time": 11682.469, "timestamp": "03:14:42", "text": "但这是为什么呢？你浪费了太多时间。"}, {"type": "subtitle", "time": 11687.11, "timestamp": "03:14:47", "text": "把钱押在像我这样的人身上，我可不是那种人。"}, {"type": "subtitle", "time": 11688.95, "timestamp": "03:14:48", "text": "不配得到所有这些支持和"}, {"type": "subtitle", "time": 11692.63, "timestamp": "03:14:52", "text": "一切。然后我确保了"}, {"type": "subtitle", "time": 11694.95, "timestamp": "03:14:54", "text": "隐藏我所有的捐赠链接和其他东西"}, {"type": "subtitle", "time": 11696.87, "timestamp": "03:14:56", "text": "这样一来，就没有人会捐款了。"}, {"type": "subtitle", "time": 11699.91, "timestamp": "03:14:59", "text": "东西，但显然我做不到。"}]
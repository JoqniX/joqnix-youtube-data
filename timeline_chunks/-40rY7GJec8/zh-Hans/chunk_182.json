[{"type": "subtitle", "time": 10921.59, "timestamp": "03:02:01", "text": "嗯，即使我不读它，或者即使我"}, {"type": "subtitle", "time": 10924.309, "timestamp": "03:02:04", "text": "哪怕只是看看，或者就算我忘了看也行。"}, {"type": "subtitle", "time": 10927.19, "timestamp": "03:02:07", "text": "答复：我可以保留日志，这样我就可以走了"}, {"type": "subtitle", "time": 10929.11, "timestamp": "03:02:09", "text": "回去读一下，然后点赞或回复。"}, {"type": "subtitle", "time": 10932.15, "timestamp": "03:02:12", "text": "第二天。记住至少"}, {"type": "subtitle", "time": 10940.469, "timestamp": "03:02:20", "text": "就像那样，但我不知道"}, {"type": "subtitle", "time": 10942.63, "timestamp": "03:02:22", "text": "但有时也会冒出一些可怕的想法。"}, {"type": "subtitle", "time": 10945.51, "timestamp": "03:02:25", "text": "当我仔细想想的时候。"}, {"type": "subtitle", "time": 10948.55, "timestamp": "03:02:28", "text": "从某种意义上说，我并不想变得伟大，但是"}, {"type": "subtitle", "time": 10952.389, "timestamp": "03:02:32", "text": "某种程度上，我希望保持现状。"}, {"type": "subtitle", "time": 10954.87, "timestamp": "03:02:34", "text": "是，但从某种意义上说，我的确想……"}, {"type": "subtitle", "time": 10956.95, "timestamp": "03:02:36", "text": "拥有合作的自由"}, {"type": "subtitle", "time": 10958.87, "timestamp": "03:02:38", "text": "和任何人。"}, {"type": "subtitle", "time": 10960.79, "timestamp": "03:02:40", "text": "嗯"}, {"type": "subtitle", "time": 10965.429, "timestamp": "03:02:45", "text": "我想要或我对……感兴趣"}, {"type": "subtitle", "time": 10967.75, "timestamp": "03:02:47", "text": "但这些数字和这些验证"}, {"type": "subtitle", "time": 10971.269, "timestamp": "03:02:51", "text": "而所有这些东西都像是"}, {"type": "subtitle", "time": 10973.11, "timestamp": "03:02:53", "text": "疼痛"}, {"type": "subtitle", "time": 10975.349, "timestamp": "03:02:55", "text": "没有。"}, {"type": "subtitle", "time": 10977.03, "timestamp": "03:02:57", "text": "当你成为大狗时，他不会再看着你了。"}, {"type": "subtitle", "time": 10978.55, "timestamp": "03:02:58", "text": "他们说我爱你，但我做不到。"}]
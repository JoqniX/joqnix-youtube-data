[{"type": "subtitle", "time": 1621.35, "timestamp": "00:27:01", "text": "我会看一下。"}, {"type": "subtitle", "time": 1623.65, "timestamp": "00:27:03", "text": "评论。"}, {"type": "subtitle", "time": 1625.59, "timestamp": "00:27:05", "text": "[音乐]"}, {"type": "subtitle", "time": 1629.029, "timestamp": "00:27:09", "text": "我撞到了，我忘了删掉它。感谢"}, {"type": "subtitle", "time": 1632.1, "timestamp": "00:27:12", "text": "你。每天都来跟我说说这件事。"}, {"type": "subtitle", "time": 1640.149, "timestamp": "00:27:20", "text": "人会死亡，"}, {"type": "subtitle", "time": 1643.19, "timestamp": "00:27:23", "text": "我接受这个结果。都是我的"}, {"type": "subtitle", "time": 1645.28, "timestamp": "00:27:25", "text": "朋友们。"}, {"type": "subtitle", "time": 1647.83, "timestamp": "00:27:27", "text": "[音乐]"}, {"type": "subtitle", "time": 1649.59, "timestamp": "00:27:29", "text": "老兄，我肯定思路混乱得很。我是"}, {"type": "subtitle", "time": 1653.11, "timestamp": "00:27:33", "text": "我还是个新手。爱你们。我当时想"}, {"type": "subtitle", "time": 1655.269, "timestamp": "00:27:35", "text": "我以为会有更多偶像和主播"}, {"type": "subtitle", "time": 1657.83, "timestamp": "00:27:37", "text": "造陆。我想我们很无趣，而且"}, {"type": "subtitle", "time": 1660.549, "timestamp": "00:27:40", "text": "听起来不错，但所有的问题都必须解决。"}, {"type": "subtitle", "time": 1662.07, "timestamp": "00:27:42", "text": "玩水。"}, {"type": "subtitle", "time": 1664.47, "timestamp": "00:27:44", "text": "哇，"}, {"type": "subtitle", "time": 1667.83, "timestamp": "00:27:47", "text": "我们离第十天越来越近了。哦不！"}, {"type": "subtitle", "time": 1671.029, "timestamp": "00:27:51", "text": "有人给我发了一张cosplay照片，真是太棒了！"}, {"type": "subtitle", "time": 1674.549, "timestamp": "00:27:54", "text": "做工精良。什么鬼？"}, {"type": "subtitle", "time": 1676.52, "timestamp": "00:27:56", "text": "两条新推文"}, {"type": "subtitle", "time": 1677.669, "timestamp": "00:27:57", "text": "[音乐]"}]
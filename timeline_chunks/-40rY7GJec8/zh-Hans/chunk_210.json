[{"type": "subtitle", "time": 12600.87, "timestamp": "03:30:00", "text": "为了安全起见，我应该怎么做？我应该如何做？"}, {"type": "subtitle", "time": 12603.429, "timestamp": "03:30:03", "text": "执行或类似保护自己或类似"}, {"type": "subtitle", "time": 12605.269, "timestamp": "03:30:05", "text": "我应该如何照顾自己以及什么"}, {"type": "subtitle", "time": 12607.75, "timestamp": "03:30:07", "text": "这种情绪就是所有这些吗？"}, {"type": "subtitle", "time": 12611.51, "timestamp": "03:30:11", "text": "对吧？是的。是的。是的。"}, {"type": "subtitle", "time": 12615.75, "timestamp": "03:30:15", "text": "是的。我漏掉了什么吗？呃，"}, {"type": "subtitle", "time": 12618.07, "timestamp": "03:30:18", "text": "我会永远支持你。别哭。一个"}, {"type": "subtitle", "time": 12620.63, "timestamp": "03:30:20", "text": "谢谢你，莫丽莎"}, {"type": "subtitle", "time": 12624.15, "timestamp": "03:30:24", "text": "意义重大。"}, {"type": "subtitle", "time": 12626.55, "timestamp": "03:30:26", "text": "还有，梅丽莎，你是新来的。"}, {"type": "subtitle", "time": 12629.429, "timestamp": "03:30:29", "text": "正确的？今天你是怎么找到我的？"}, {"type": "subtitle", "time": 12631.51, "timestamp": "03:30:31", "text": "你是怎么找到我的？ [音乐]"}, {"type": "subtitle", "time": 12633.12, "timestamp": "03:30:33", "text": "[音乐] 你是怎么找到我的？"}, {"type": "subtitle", "time": 12641.269, "timestamp": "03:30:41", "text": "我心想，等等，我希望我没去。"}, {"type": "subtitle", "time": 12643.67, "timestamp": "03:30:43", "text": "就像深入一样，或者如果我因为我深入而深入。"}, {"type": "subtitle", "time": 12647.429, "timestamp": "03:30:47", "text": "谈话我并不害怕"}, {"type": "subtitle", "time": 12650.309, "timestamp": "03:30:50", "text": "呃，那些之前一直在看的人。"}, {"type": "subtitle", "time": 12653.67, "timestamp": "03:30:53", "text": "就像现在就走"}, {"type": "subtitle", "time": 12657.11, "timestamp": "03:30:57", "text": "不过还是要感谢谷歌"}]
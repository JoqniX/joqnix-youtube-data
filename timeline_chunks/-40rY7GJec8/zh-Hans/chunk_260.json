[{"type": "subtitle", "time": 15601.51, "timestamp": "04:20:01", "text": "你的快乐一直都在这里。给你"}, {"type": "subtitle", "time": 15611.59, "timestamp": "04:20:11", "text": "哦，是的，快到了。"}, {"type": "subtitle", "time": 15614.32, "timestamp": "04:20:14", "text": "我应该结束直播了吧？"}, {"type": "subtitle", "time": 15623.59, "timestamp": "04:20:23", "text": "你好。所以，让我们感谢每一位。"}, {"type": "subtitle", "time": 15625.33, "timestamp": "04:20:25", "text": "今天来过的人。"}, {"type": "subtitle", "time": 15628.309, "timestamp": "04:20:28", "text": "[音乐]"}, {"type": "subtitle", "time": 15635.83, "timestamp": "04:20:35", "text": "今天能来，谢谢。"}, {"type": "subtitle", "time": 15638.95, "timestamp": "04:20:38", "text": "到达溪流边。我希望呃……"}, {"type": "subtitle", "time": 15641.67, "timestamp": "04:20:41", "text": "现在我觉得是……等等，我觉得是9"}, {"type": "subtitle", "time": 15645.83, "timestamp": "04:20:45", "text": "或晚上 10 点。为你。是的，现在是晚上10点24分。"}, {"type": "subtitle", "time": 15649.03, "timestamp": "04:20:49", "text": "你好。所以我希望我不知道你是否"}, {"type": "subtitle", "time": 15652.55, "timestamp": "04:20:52", "text": "还在，而且一切都好"}, {"type": "subtitle", "time": 15655.429, "timestamp": "04:20:55", "text": "今天就到这里。希望你今天尽力了。"}, {"type": "subtitle", "time": 15657.91, "timestamp": "04:20:57", "text": "谢谢你过来和我们聊天。"}]
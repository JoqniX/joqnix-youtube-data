[{"type": "subtitle", "time": 1502.789, "timestamp": "00:25:02", "text": "所以实际上人们就是这么做的。"}, {"type": "subtitle", "time": 1504.789, "timestamp": "00:25:04", "text": "大多数人都会这样做。"}, {"type": "subtitle", "time": 1513.83, "timestamp": "00:25:13", "text": "她为什么总是说祝福？"}, {"type": "subtitle", "time": 1518.63, "timestamp": "00:25:18", "text": "不知道是什么"}, {"type": "subtitle", "time": 1519.909, "timestamp": "00:25:19", "text": "[音乐]"}, {"type": "subtitle", "time": 1526.149, "timestamp": "00:25:26", "text": "这样你就可以隐藏你的真实身份了。"}, {"type": "subtitle", "time": 1529.669, "timestamp": "00:25:29", "text": "自己。你不需要炫耀你的"}, {"type": "subtitle", "time": 1531.59, "timestamp": "00:25:31", "text": "自己。在日本，隐私是"}, {"type": "subtitle", "time": 1533.83, "timestamp": "00:25:33", "text": "很重要，对吧？那么匿名性就是"}, {"type": "subtitle", "time": 1536.18, "timestamp": "00:25:36", "text": "重要的东西。"}, {"type": "subtitle", "time": 1539.029, "timestamp": "00:25:39", "text": "[音乐]"}, {"type": "subtitle", "time": 1545.269, "timestamp": "00:25:45", "text": "放弃。我无法想象那样的生活"}, {"type": "subtitle", "time": 1552.95, "timestamp": "00:25:52", "text": "不，这是真的。"}, {"type": "subtitle", "time": 1555.12, "timestamp": "00:25:55", "text": "真的。 也没人关心我。"}, {"type": "subtitle", "time": 1557.64, "timestamp": "00:25:57", "text": "也没人关心我。 [音乐]"}, {"type": "subtitle", "time": 1559.12, "timestamp": "00:25:59", "text": "[音乐] 我应该删除这条吗？我不知道。"}]
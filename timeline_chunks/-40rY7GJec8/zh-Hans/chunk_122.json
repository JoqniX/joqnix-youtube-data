[{"type": "subtitle", "time": 7323.109, "timestamp": "02:02:03", "text": "因为她又可爱又漂亮。只是"}, {"type": "subtitle", "time": 7325.589, "timestamp": "02:02:05", "text": "我被嘲笑了，因为我"}, {"type": "subtitle", "time": 7327.43, "timestamp": "02:02:07", "text": "真是太震惊、太愚蠢、太糟糕了"}, {"type": "subtitle", "time": 7330.39, "timestamp": "02:02:10", "text": "头部。"}, {"type": "subtitle", "time": 7332.149, "timestamp": "02:02:12", "text": "哦，不。"}, {"type": "subtitle", "time": 7341.51, "timestamp": "02:02:21", "text": "你真可怜。"}, {"type": "subtitle", "time": 7348.87, "timestamp": "02:02:28", "text": "或者它叫什么来着？说"}, {"type": "subtitle", "time": 7350.79, "timestamp": "02:02:30", "text": "关于你的过去并获得同情"}, {"type": "subtitle", "time": 7353.189, "timestamp": "02:02:33", "text": "其他人。"}, {"type": "subtitle", "time": 7361.83, "timestamp": "02:02:41", "text": "这简直太有共鸣了。哎呀，这哦"}, {"type": "subtitle", "time": 7369.91, "timestamp": "02:02:49", "text": "下一个。我们走吧。是的。"}, {"type": "subtitle", "time": 7372.55, "timestamp": "02:02:52", "text": "什么？"}, {"type": "subtitle", "time": 7375.03, "timestamp": "02:02:55", "text": "你是位大天使。某人的礼物"}, {"type": "subtitle", "time": 7376.95, "timestamp": "02:02:56", "text": "有人发了一条像彩虹一样的超级留言"}, {"type": "subtitle", "time": 7378.87, "timestamp": "02:02:58", "text": "超级字符。"}]
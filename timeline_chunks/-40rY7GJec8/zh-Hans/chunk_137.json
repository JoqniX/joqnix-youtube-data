[{"type": "subtitle", "time": 8223.509, "timestamp": "02:17:03", "text": "还有一些其他的东西。想想我们的生活是如何开始的"}, {"type": "subtitle", "time": 8225.03, "timestamp": "02:17:05", "text": "互联网真是太有趣了，就像……"}, {"type": "subtitle", "time": 8228.469, "timestamp": "02:17:08", "text": "什么都可以。我爱住在……"}, {"type": "subtitle", "time": 8230.79, "timestamp": "02:17:10", "text": "21世纪。我们都需要一点"}, {"type": "subtitle", "time": 8232.95, "timestamp": "02:17:12", "text": "生活中的爱与惊悚。思考"}, {"type": "subtitle", "time": 8234.79, "timestamp": "02:17:14", "text": "我会在下次直播中谈到这一点。我"}, {"type": "subtitle", "time": 8237.669, "timestamp": "02:17:17", "text": "希望大家都能像我一样喜欢它。"}, {"type": "subtitle", "time": 8239.99, "timestamp": "02:17:19", "text": "我先从一些非常棒的事情说起。"}, {"type": "subtitle", "time": 8244.629, "timestamp": "02:17:24", "text": "我愿意。网络法律。"}, {"type": "subtitle", "time": 8253.429, "timestamp": "02:17:33", "text": "怎么会有安提亚诺这个人呢？就像你认为的那样"}, {"type": "subtitle", "time": 8256.469, "timestamp": "02:17:36", "text": "关于这一点，错误不在于我们犯了什么。"}, {"type": "subtitle", "time": 8259.19, "timestamp": "02:17:39", "text": "爱意降至零。她不肯听。"}, {"type": "subtitle", "time": 8261.03, "timestamp": "02:17:41", "text": "我。"}, {"type": "subtitle", "time": 8265.19, "timestamp": "02:17:45", "text": "她几乎会无视我。"}, {"type": "subtitle", "time": 8267.509, "timestamp": "02:17:47", "text": "她会做任何她想做的事"}, {"type": "subtitle", "time": 8270.23, "timestamp": "02:17:50", "text": "想要。虽然此刻我在这里"}, {"type": "subtitle", "time": 8273.91, "timestamp": "02:17:53", "text": "玩家潘正在告诉她该怎么做，"}, {"type": "subtitle", "time": 8276.629, "timestamp": "02:17:56", "text": "一切都对吧？给她和喜欢"}]
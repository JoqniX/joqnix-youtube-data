[{"type": "subtitle", "time": 16502.789, "timestamp": "04:35:02", "text": "她还在那里，我会给她一块补丁。"}, {"type": "subtitle", "time": 16509.029, "timestamp": "04:35:09", "text": "呃，我们现在就过去。"}, {"type": "subtitle", "time": 16511.029, "timestamp": "04:35:11", "text": "来"}, {"type": "subtitle", "time": 16514.07, "timestamp": "04:35:14", "text": "然后YP字符串出现了。我的天啊。 YP"}, {"type": "subtitle", "time": 16516.47, "timestamp": "04:35:16", "text": "路过。"}, {"type": "subtitle", "time": 16519.51, "timestamp": "04:35:19", "text": "Valor刚刚收到一条消息：等等，什么？决不。不"}, {"type": "subtitle", "time": 16521.109, "timestamp": "04:35:21", "text": "方式。决不。决不。决不。等待。等待。"}, {"type": "subtitle", "time": 16527.269, "timestamp": "04:35:27", "text": "什么？ Valor Rand China。等待。"}, {"type": "subtitle", "time": 16529.429, "timestamp": "04:35:29", "text": "等待。什么？"}, {"type": "subtitle", "time": 16536.551, "timestamp": "04:35:36", "text": "你意识到这件事有多重要吗？"}, {"type": "subtitle", "time": 16539.029, "timestamp": "04:35:39", "text": "那是？正确的。"}, {"type": "subtitle", "time": 16541.75, "timestamp": "04:35:41", "text": "耽误。我一直以为瓦林"}, {"type": "subtitle", "time": 16543.51, "timestamp": "04:35:43", "text": "曾是"}, {"type": "subtitle", "time": 16547.349, "timestamp": "04:35:47", "text": "嗯？这段时间我一直以为"}, {"type": "subtitle", "time": 16551.51, "timestamp": "04:35:51", "text": "缬氨酸起源于中国。"}, {"type": "subtitle", "time": 16557.189, "timestamp": "04:35:57", "text": "等等，什么？那么，伊桑为什么要这样做呢？"}]
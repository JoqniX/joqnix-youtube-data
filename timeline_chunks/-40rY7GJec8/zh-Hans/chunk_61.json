[{"type": "subtitle", "time": 3660.15, "timestamp": "01:01:00", "text": "她竟然结束了直播。什么？"}, {"type": "subtitle", "time": 3662.549, "timestamp": "01:01:02", "text": "不，她快疯了。我的天哪，她"}, {"type": "subtitle", "time": 3672.32, "timestamp": "01:01:12", "text": "呃"}, {"type": "subtitle", "time": 3673.91, "timestamp": "01:01:13", "text": "[音乐]"}, {"type": "subtitle", "time": 3689.27, "timestamp": "01:01:29", "text": "我的天啊。这就是事情发生的原因。哦"}, {"type": "subtitle", "time": 3699.589, "timestamp": "01:01:39", "text": "我可以再做一遍吗？"}, {"type": "subtitle", "time": 3703.51, "timestamp": "01:01:43", "text": "让她冷静下来什么的？"}, {"type": "subtitle", "time": 3715.829, "timestamp": "01:01:55", "text": "而且，我，呃，所以我不赞同这种做法。"}]
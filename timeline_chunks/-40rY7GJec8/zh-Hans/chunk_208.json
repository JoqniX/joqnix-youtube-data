[{"type": "subtitle", "time": 12483.349, "timestamp": "03:28:03", "text": "呃，说到思考……"}, {"type": "subtitle", "time": 12488.63, "timestamp": "03:28:08", "text": "呃，我在想那件事，因为……"}, {"type": "subtitle", "time": 12490.55, "timestamp": "03:28:10", "text": "呃，就像"}, {"type": "subtitle", "time": 12493.03, "timestamp": "03:28:13", "text": "一旦你成为一名主播，你就是"}, {"type": "subtitle", "time": 12495.75, "timestamp": "03:28:15", "text": "有机会体验新事物"}, {"type": "subtitle", "time": 12499.269, "timestamp": "03:28:19", "text": "每一条流或随着时间的推移，对吗？"}, {"type": "subtitle", "time": 12502.55, "timestamp": "03:28:22", "text": "所以，你当然会体验到……"}, {"type": "subtitle", "time": 12505.99, "timestamp": "03:28:25", "text": "好的流量，好的日子，坏的日子……"}, {"type": "subtitle", "time": 12509.83, "timestamp": "03:28:29", "text": "中立的日子，就像介于好日子之间的日子一样。"}, {"type": "subtitle", "time": 12514.63, "timestamp": "03:28:34", "text": "还有不好的事等等，对吧？"}, {"type": "subtitle", "time": 12517.349, "timestamp": "03:28:37", "text": "但说实话，我会说如果我"}, {"type": "subtitle", "time": 12521.11, "timestamp": "03:28:41", "text": "如果我没开始直播，我就不是现在的样子了。"}, {"type": "subtitle", "time": 12523.269, "timestamp": "03:28:43", "text": "我这辈子都绝不会这样做"}, {"type": "subtitle", "time": 12526.95, "timestamp": "03:28:46", "text": "我现在所知道的一切都与我目前所知有关。"}, {"type": "subtitle", "time": 12528.469, "timestamp": "03:28:48", "text": "喜欢"}, {"type": "subtitle", "time": 12531.51, "timestamp": "03:28:51", "text": "就像所有的一切"}, {"type": "subtitle", "time": 12534.71, "timestamp": "03:28:54", "text": "那它叫什么来着？"}, {"type": "subtitle", "time": 12538.07, "timestamp": "03:28:58", "text": "嗯，我琢磨了一下，就像……"}]
[{"type": "subtitle", "time": 5400.31, "timestamp": "01:30:00", "text": "她一切都好。她所做的一切都是"}, {"type": "subtitle", "time": 5403.59, "timestamp": "01:30:03", "text": "所以，去第一个地方享受就对了。"}, {"type": "subtitle", "time": 5406.55, "timestamp": "01:30:06", "text": "她自己更"}, {"type": "subtitle", "time": 5409.669, "timestamp": "01:30:09", "text": "粉丝福利。"}, {"type": "subtitle", "time": 5412.229, "timestamp": "01:30:12", "text": "我觉得我是认真的。愚蠢的"}, {"type": "subtitle", "time": 5413.91, "timestamp": "01:30:13", "text": "大家有什么想法？她看起来很聪明。"}, {"type": "subtitle", "time": 5416.47, "timestamp": "01:30:16", "text": "好的。外面真是些愚蠢的想法。好的。"}, {"type": "subtitle", "time": 5425.99, "timestamp": "01:30:25", "text": "嗯，某种程度上来说是这样。"}, {"type": "subtitle", "time": 5431.189, "timestamp": "01:30:31", "text": "你确定要继续吗？哦，"}, {"type": "subtitle", "time": 5440.31, "timestamp": "01:30:40", "text": "嗯"}, {"type": "subtitle", "time": 5447.59, "timestamp": "01:30:47", "text": "[音乐]"}, {"type": "subtitle", "time": 5450.55, "timestamp": "01:30:50", "text": "h"}, {"type": "subtitle", "time": 5452.47, "timestamp": "01:30:52", "text": "[音乐]"}]
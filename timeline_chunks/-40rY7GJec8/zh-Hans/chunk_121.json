[{"type": "subtitle", "time": 7267.03, "timestamp": "02:01:07", "text": "呃，"}, {"type": "subtitle", "time": 7269.03, "timestamp": "02:01:09", "text": "欢迎来到我的频道。我会在这里等你。"}, {"type": "subtitle", "time": 7272.709, "timestamp": "02:01:12", "text": "为了你的笑容。没有人觉得有"}, {"type": "subtitle", "time": 7276.31, "timestamp": "02:01:16", "text": "什么也没有，也没有人。"}, {"type": "subtitle", "time": 7278.149, "timestamp": "02:01:18", "text": "我经常逃学。我没有"}, {"type": "subtitle", "time": 7280.87, "timestamp": "02:01:20", "text": "朋友很多。只有人们关心"}, {"type": "subtitle", "time": 7282.31, "timestamp": "02:01:22", "text": "只有老年人才只关心"}, {"type": "subtitle", "time": 7285.03, "timestamp": "02:01:25", "text": "我要说的话。"}, {"type": "subtitle", "time": 7290.47, "timestamp": "02:01:30", "text": "我喜欢你脆弱的时候。哦不，"}, {"type": "subtitle", "time": 7292.229, "timestamp": "02:01:32", "text": "那很糟糕。那很糟糕。永远不要展现你的"}, {"type": "subtitle", "time": 7294.39, "timestamp": "02:01:34", "text": "你的弱点"}, {"type": "subtitle", "time": 7297.99, "timestamp": "02:01:37", "text": "网络弱点。人们可以"}, {"type": "subtitle", "time": 7300.709, "timestamp": "02:01:40", "text": "穿透你，把你彻底击垮。"}, {"type": "subtitle", "time": 7308.87, "timestamp": "02:01:48", "text": "唉，我或许应该听听自己的话。"}, {"type": "subtitle", "time": 7310.87, "timestamp": "02:01:50", "text": "考虑在内，并亲自去做​​。"}, {"type": "subtitle", "time": 7312.79, "timestamp": "02:01:52", "text": "也一样。"}, {"type": "subtitle", "time": 7315.03, "timestamp": "02:01:55", "text": "呃，"}, {"type": "subtitle", "time": 7316.709, "timestamp": "02:01:56", "text": "我不知道天使也必须去往……"}, {"type": "subtitle", "time": 7319.189, "timestamp": "02:01:59", "text": "学校也是。是的。"}]
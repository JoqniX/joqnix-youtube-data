[{"type": "subtitle", "time": 424.23, "timestamp": "00:07:04", "text": "啊，我为什么要点进去？我的天啊。"}, {"type": "subtitle", "time": 427.67, "timestamp": "00:07:07", "text": "但我发现了一起真实事件。"}, {"type": "subtitle", "time": 430.95, "timestamp": "00:07:10", "text": "我不知道怎么玩。她也"}, {"type": "subtitle", "time": 436.69, "timestamp": "00:07:16", "text": "我说你不是值得效仿的人。"}, {"type": "subtitle", "time": 438.629, "timestamp": "00:07:18", "text": "[音乐]"}, {"type": "subtitle", "time": 448.79, "timestamp": "00:07:28", "text": "233人正在观看。好的。从某种意义上说"}, {"type": "subtitle", "time": 453.029, "timestamp": "00:07:33", "text": "那是个需要改进的问号。"}, {"type": "subtitle", "time": 457.029, "timestamp": "00:07:37", "text": "你们这些疯子都喜欢这些。"}, {"type": "subtitle", "time": 458.93, "timestamp": "00:07:38", "text": "我很兴奋。"}, {"type": "subtitle", "time": 474.30899999999997, "timestamp": "00:07:54", "text": "好的。你也喜欢阴谋论？"}, {"type": "subtitle", "time": 475.83, "timestamp": "00:07:55", "text": "只是想分享一些内容"}, {"type": "subtitle", "time": 477.67, "timestamp": "00:07:57", "text": "你最喜欢的车在这里和那里都有。"}]
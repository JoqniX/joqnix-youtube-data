[{"type": "subtitle", "time": 8160.79, "timestamp": "02:16:00", "text": "但我不想和垂死之人同行。"}, {"type": "subtitle", "time": 8168.47, "timestamp": "02:16:08", "text": "那张脸真让我火大。我的天啊。全部"}, {"type": "subtitle", "time": 8173.27, "timestamp": "02:16:13", "text": "正确的。我们的人在，好吧，所以"}, {"type": "subtitle", "time": 8175.109, "timestamp": "02:16:15", "text": "它不是"}, {"type": "subtitle", "time": 8178.95, "timestamp": "02:16:18", "text": "好的。我们可以关闭这个页面。"}, {"type": "subtitle", "time": 8181.589, "timestamp": "02:16:21", "text": "把那个放那边。把这个放上去"}, {"type": "subtitle", "time": 8183.67, "timestamp": "02:16:23", "text": "那里。互联网。"}, {"type": "subtitle", "time": 8185.51, "timestamp": "02:16:25", "text": "[音乐]"}, {"type": "subtitle", "time": 8189.83, "timestamp": "02:16:29", "text": "我想知道这是什么？必须必须"}, {"type": "subtitle", "time": 8192.59, "timestamp": "02:16:32", "text": "创造世界纪录"}, {"type": "subtitle", "time": 8194.23, "timestamp": "02:16:34", "text": "[音乐]"}, {"type": "subtitle", "time": 8196.95, "timestamp": "02:16:36", "text": "好的"}, {"type": "subtitle", "time": 8199.509, "timestamp": "02:16:39", "text": "如果他们把时尚归零呢？"}, {"type": "subtitle", "time": 8202.709, "timestamp": "02:16:42", "text": "想看看结果如何。"}, {"type": "subtitle", "time": 8204.95, "timestamp": "02:16:44", "text": "如果我设计出一款时尚零号服装，她就会……"}, {"type": "subtitle", "time": 8211.669, "timestamp": "02:16:51", "text": "而且我确信她会结束这一切。"}, {"type": "subtitle", "time": 8215.349, "timestamp": "02:16:55", "text": "军队加上可怕的"}, {"type": "subtitle", "time": 8217.669, "timestamp": "02:16:57", "text": "因为里面充满了它们，所以它才如此拥挤。"}, {"type": "subtitle", "time": 8219.75, "timestamp": "02:16:59", "text": "对网络法律进行大量深入研究"}]
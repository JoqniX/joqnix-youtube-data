[{"type": "subtitle", "time": 10981.19, "timestamp": "03:03:01", "text": "是的，我知道，我认识几个"}, {"type": "subtitle", "time": 10985.67, "timestamp": "03:03:05", "text": "那些不会观看的人"}, {"type": "subtitle", "time": 10987.67, "timestamp": "03:03:07", "text": "是的"}, {"type": "subtitle", "time": 10989.269, "timestamp": "03:03:09", "text": "有几个人会"}, {"type": "subtitle", "time": 10993.51, "timestamp": "03:03:13", "text": "不会关注我是否会在某种程度上成名。"}, {"type": "subtitle", "time": 10997.83, "timestamp": "03:03:17", "text": "我想为此做点什么，因为我"}, {"type": "subtitle", "time": 11004.87, "timestamp": "03:03:24", "text": "再说一遍，如果你仔细想想，为了"}, {"type": "subtitle", "time": 11007.59, "timestamp": "03:03:27", "text": "例如，我……我应该……"}, {"type": "subtitle", "time": 11010.55, "timestamp": "03:03:30", "text": "别告诉我名字。我不会谈及此事。"}, {"type": "subtitle", "time": 11013.349, "timestamp": "03:03:33", "text": "名字，但有一个特定的 YouTuber"}, {"type": "subtitle", "time": 11016.87, "timestamp": "03:03:36", "text": "当时我们都在小组里"}, {"type": "subtitle", "time": 11019.349, "timestamp": "03:03:39", "text": "当我们都在的时候"}, {"type": "subtitle", "time": 11022.389, "timestamp": "03:03:42", "text": "虽然我们一开始都像这样。"}, {"type": "subtitle", "time": 11027.03, "timestamp": "03:03:47", "text": "最初的日子里，助产士爆发了。"}, {"type": "subtitle", "time": 11028.79, "timestamp": "03:03:48", "text": "喜欢"}, {"type": "subtitle", "time": 11032.63, "timestamp": "03:03:52", "text": "不，我的意思是，不是她，而是"}, {"type": "subtitle", "time": 11035.99, "timestamp": "03:03:55", "text": "他们呃"}, {"type": "subtitle", "time": 11039.59, "timestamp": "03:03:59", "text": "普通的阴影之类的东西，有点像"}]
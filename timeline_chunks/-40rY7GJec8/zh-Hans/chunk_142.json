[{"type": "subtitle", "time": 8524.07, "timestamp": "02:22:04", "text": "这本来应该在我们……的时候完成的"}, {"type": "subtitle", "time": 8527.5, "timestamp": "02:22:07", "text": "更低更低。"}, {"type": "subtitle", "time": 8530.87, "timestamp": "02:22:10", "text": "[音乐]"}, {"type": "subtitle", "time": 8532.95, "timestamp": "02:22:12", "text": "谢谢妈妈生了我。去"}, {"type": "subtitle", "time": 8535.349, "timestamp": "02:22:15", "text": "返回。我能感觉到你要去"}, {"type": "subtitle", "time": 8538.71, "timestamp": "02:22:18", "text": "变得强大。"}, {"type": "subtitle", "time": 8547.11, "timestamp": "02:22:27", "text": "[音乐]"}, {"type": "subtitle", "time": 8550.41, "timestamp": "02:22:30", "text": "直接去山下。 Underhill 的含义。"}, {"type": "subtitle", "time": 8560.71, "timestamp": "02:22:40", "text": "[音乐]"}, {"type": "subtitle", "time": 8562.389, "timestamp": "02:22:42", "text": "你让我第一次露出了笑容。"}, {"type": "subtitle", "time": 8565.21, "timestamp": "02:22:45", "text": "我生命中的这段时光。"}]
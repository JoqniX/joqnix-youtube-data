[{"type": "subtitle", "time": 13680.229, "timestamp": "03:48:00", "text": "因为再说一遍，jocknick 是我……"}, {"type": "subtitle", "time": 13681.91, "timestamp": "03:48:01", "text": "真的"}, {"type": "subtitle", "time": 13685.99, "timestamp": "03:48:05", "text": "爱，也永远珍藏在我心中"}, {"type": "subtitle", "time": 13689.429, "timestamp": "03:48:09", "text": "像哥哥或家人一样"}, {"type": "subtitle", "time": 13691.269, "timestamp": "03:48:11", "text": "我的。"}, {"type": "subtitle", "time": 13694.15, "timestamp": "03:48:14", "text": "甚至连阿奎那·塞西尔坦，我也必须说，所有的一切"}, {"type": "subtitle", "time": 13696.389, "timestamp": "03:48:16", "text": "他们对我意义重大。所有其他"}, {"type": "subtitle", "time": 13698.79, "timestamp": "03:48:18", "text": "阿涅克西亚的人物"}, {"type": "subtitle", "time": 13700.55, "timestamp": "03:48:20", "text": "以及其他那些甚至都不是的人。"}, {"type": "subtitle", "time": 13702.469, "timestamp": "03:48:22", "text": "确实揭示了，但它们都意味着"}, {"type": "subtitle", "time": 13705.11, "timestamp": "03:48:25", "text": "对我来说意义重大。即使对某些人来说"}, {"type": "subtitle", "time": 13706.79, "timestamp": "03:48:26", "text": "会想，哦，这只是一个角色而已。"}, {"type": "subtitle", "time": 13708.87, "timestamp": "03:48:28", "text": "工作之类的，但它们仍然意义重大。"}, {"type": "subtitle", "time": 13714.15, "timestamp": "03:48:34", "text": "对我来说就是这样。所以"}, {"type": "subtitle", "time": 13715.91, "timestamp": "03:48:35", "text": "开始同时处理多项任务。是的。"}, {"type": "subtitle", "time": 13719.83, "timestamp": "03:48:39", "text": "有时候我的意思是，我的意思是，我我我"}, {"type": "subtitle", "time": 13723.349, "timestamp": "03:48:43", "text": "我相信我说得没错。莫内希亚"}, {"type": "subtitle", "time": 13727.67, "timestamp": "03:48:47", "text": "Jok只会是V2版本。但那就是我"}, {"type": "subtitle", "time": 13733.189, "timestamp": "03:48:53", "text": "那就是我，呃，我就是那种运动健将，对吧。"}, {"type": "subtitle", "time": 13735.03, "timestamp": "03:48:55", "text": "但说到其他方面……"}, {"type": "subtitle", "time": 13737.51, "timestamp": "03:48:57", "text": "角色、女王或所有季节"}, {"type": "subtitle", "time": 13739.189, "timestamp": "03:48:59", "text": "主要角色"}]
[{"type": "subtitle", "time": 10385.03, "timestamp": "02:53:05", "text": "一切都陷入了低迷的境地。"}, {"type": "subtitle", "time": 10386.63, "timestamp": "02:53:06", "text": "是的。是的。是的。"}, {"type": "subtitle", "time": 10389.75, "timestamp": "02:53:09", "text": "现在我已经经历过这几件事了"}, {"type": "subtitle", "time": 10392.469, "timestamp": "02:53:12", "text": "很多时候，我真的注意到了这一点。"}, {"type": "subtitle", "time": 10394.23, "timestamp": "02:53:14", "text": "即便我曾说过"}, {"type": "subtitle", "time": 10395.75, "timestamp": "02:53:15", "text": "每个人"}, {"type": "subtitle", "time": 10398.07, "timestamp": "02:53:18", "text": "我认识的、喜欢的人都不在乎"}, {"type": "subtitle", "time": 10399.75, "timestamp": "02:53:19", "text": "数字。我知道数字很重要"}, {"type": "subtitle", "time": 10402.95, "timestamp": "02:53:22", "text": "但如果你仍然在意这些数字的话。"}, {"type": "subtitle", "time": 10405.75, "timestamp": "02:53:25", "text": "一点点，不，至少一点点"}, {"type": "subtitle", "time": 10408.95, "timestamp": "02:53:28", "text": "但随后却陷入了去"}, {"type": "subtitle", "time": 10413.03, "timestamp": "02:53:33", "text": "走下坡路，而且太在意别人的看法。你会"}, {"type": "subtitle", "time": 10416.469, "timestamp": "02:53:36", "text": "没有一个轻松的心理空间。"}, {"type": "subtitle", "time": 10419.75, "timestamp": "02:53:39", "text": "你会更喜欢进一步崩溃和"}, {"type": "subtitle", "time": 10423.03, "timestamp": "02:53:43", "text": "越来越觉得你有多糟糕"}, {"type": "subtitle", "time": 10426.07, "timestamp": "02:53:46", "text": "做这一切。但是再次"}, {"type": "subtitle", "time": 10428.71, "timestamp": "02:53:48", "text": "从某种意义上说"}, {"type": "subtitle", "time": 10431.67, "timestamp": "02:53:51", "text": "但从某种意义上说，即使"}, {"type": "subtitle", "time": 10434.79, "timestamp": "02:53:54", "text": "你刚开始的时候，你有"}, {"type": "subtitle", "time": 10437.59, "timestamp": "02:53:57", "text": "呃，努力或者那种想要进步的感觉，"}]
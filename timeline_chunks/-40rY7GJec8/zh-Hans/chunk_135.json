[{"type": "subtitle", "time": 8101.51, "timestamp": "02:15:01", "text": "我的天啊。是的，我知道我"}, {"type": "subtitle", "time": 8104.709, "timestamp": "02:15:04", "text": "我自己能搞定这个人。他们真是太棒了"}, {"type": "subtitle", "time": 8106.39, "timestamp": "02:15:06", "text": "愚蠢的。"}, {"type": "subtitle", "time": 8108.79, "timestamp": "02:15:08", "text": "这简直是​​严重的冒犯。我希望我能"}, {"type": "subtitle", "time": 8111.35, "timestamp": "02:15:11", "text": "保住工作，我多么希望我能做到"}, {"type": "subtitle", "time": 8112.709, "timestamp": "02:15:12", "text": "满足他们的愿望。我想要"}, {"type": "subtitle", "time": 8114.55, "timestamp": "02:15:14", "text": "变成钻石，摧毁城市"}, {"type": "subtitle", "time": 8117.99, "timestamp": "02:15:17", "text": "他们。他们想和其他坏人打架。"}, {"type": "subtitle", "time": 8119.669, "timestamp": "02:15:19", "text": "所以人们认为我是好人之一"}, {"type": "subtitle", "time": 8123.27, "timestamp": "02:15:23", "text": "即使我这条线很糟糕"}, {"type": "subtitle", "time": 8126.7, "timestamp": "02:15:26", "text": "密度只有一半。"}, {"type": "subtitle", "time": 8134.95, "timestamp": "02:15:34", "text": "[音乐]"}, {"type": "subtitle", "time": 8137.109, "timestamp": "02:15:37", "text": "我知道你会报道我的节目。你推迟了。"}, {"type": "subtitle", "time": 8141.27, "timestamp": "02:15:41", "text": "比如，你希望因为什么事被起诉？"}, {"type": "subtitle", "time": 8144.069, "timestamp": "02:15:44", "text": "多和更多的人交谈。所以就像"}, {"type": "subtitle", "time": 8159.03, "timestamp": "02:15:59", "text": "[音乐]"}]
[{"type": "subtitle", "time": 6422.149, "timestamp": "01:47:02", "text": "我的天啊。 Boing游戏。我敢肯定你是"}, {"type": "subtitle", "time": 6425.6, "timestamp": "01:47:05", "text": "5秒钟后就会死。不。"}, {"type": "subtitle", "time": 6435.75, "timestamp": "01:47:15", "text": "我做这个做那个。"}, {"type": "subtitle", "time": 6437.75, "timestamp": "01:47:17", "text": "触碰和摧毁，将不留一丝痕迹"}, {"type": "subtitle", "time": 6440.229, "timestamp": "01:47:20", "text": "活。好的。"}, {"type": "subtitle", "time": 6444.79, "timestamp": "01:47:24", "text": "计划呃，一起去玩，疑虑呃"}, {"type": "subtitle", "time": 6446.709, "timestamp": "01:47:26", "text": "你喜欢吗？不，那是错误的命令。"}, {"type": "subtitle", "time": 6454.149, "timestamp": "01:47:34", "text": "我为什么把它摔了10次？"}, {"type": "subtitle", "time": 6467.35, "timestamp": "01:47:47", "text": "上流社会"}, {"type": "subtitle", "time": 6478.39, "timestamp": "01:47:58", "text": "有些擅长玩第一人称射击游戏的人"}]
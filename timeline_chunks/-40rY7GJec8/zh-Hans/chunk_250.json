[{"type": "subtitle", "time": 15000.309, "timestamp": "04:10:00", "text": "条件相同的情况下，我只希望我没有。"}, {"type": "subtitle", "time": 15003.269, "timestamp": "04:10:03", "text": "我唯一的愿望就是我其实并不……"}, {"type": "subtitle", "time": 15007.75, "timestamp": "04:10:07", "text": "希望比利比利数字朝着"}, {"type": "subtitle", "time": 15010.309, "timestamp": "04:10:10", "text": "比 Twitch 和 YouTube 都大。如果那是的话"}, {"type": "subtitle", "time": 15012.71, "timestamp": "04:10:12", "text": "我必须减少对这个案子的关注。"}, {"type": "subtitle", "time": 15016.87, "timestamp": "04:10:16", "text": "比利，比利，多关注一下这两个人。"}, {"type": "subtitle", "time": 15020.309, "timestamp": "04:10:20", "text": "这会很痛苦。所以，我必须确保"}, {"type": "subtitle", "time": 15022.71, "timestamp": "04:10:22", "text": "我主要在所有三个平台上"}, {"type": "subtitle", "time": 15025.51, "timestamp": "04:10:25", "text": "想要集中精力做所有这些事情将是"}, {"type": "subtitle", "time": 15028.79, "timestamp": "04:10:28", "text": "相等相等。我们将像一个大大"}, {"type": "subtitle", "time": 15032.15, "timestamp": "04:10:32", "text": "平等的家庭。是的。"}, {"type": "subtitle", "time": 15034.95, "timestamp": "04:10:34", "text": "这样就不会有人被落下。每个人"}, {"type": "subtitle", "time": 15037.11, "timestamp": "04:10:37", "text": "将会完全相等。每个人都会"}, {"type": "subtitle", "time": 15040.229, "timestamp": "04:10:40", "text": "都一样，诸如此类。是的。是的。"}, {"type": "subtitle", "time": 15042.71, "timestamp": "04:10:42", "text": "是的。不会有这样的问题"}, {"type": "subtitle", "time": 15045.349, "timestamp": "04:10:45", "text": "Joy没有在Twitch上直播。他"}, {"type": "subtitle", "time": 15047.59, "timestamp": "04:10:47", "text": "他们忘记了我们。我不想从……那里得到那样的待遇"}, {"type": "subtitle", "time": 15050.55, "timestamp": "04:10:50", "text": "Twitch大家庭。是的。然后，然后，呃，然后"}, {"type": "subtitle", "time": 15054.469, "timestamp": "04:10:54", "text": "就像所有YouTube大家庭成员一样"}, {"type": "subtitle", "time": 15059.349, "timestamp": "04:10:59", "text": "Jockey没有在YouTube上直播。"}]
[{"type": "subtitle", "time": 12061.67, "timestamp": "03:21:01", "text": "呃，你有聊天记录吗？"}, {"type": "subtitle", "time": 12063.99, "timestamp": "03:21:03", "text": "您发送的消息"}, {"type": "subtitle", "time": 12066.07, "timestamp": "03:21:06", "text": "它会在我的 Discord 服务器上。"}, {"type": "subtitle", "time": 12070.469, "timestamp": "03:21:10", "text": "为了读对，我会倒着读。"}, {"type": "subtitle", "time": 12073.75, "timestamp": "03:21:13", "text": "每个人的信息都特别"}, {"type": "subtitle", "time": 12077.11, "timestamp": "03:21:17", "text": "通过筛选出这个人"}, {"type": "subtitle", "time": 12079.59, "timestamp": "03:21:19", "text": "阅读所有信息，然后通过"}, {"type": "subtitle", "time": 12082.229, "timestamp": "03:21:22", "text": "某个特定的人，对吧？所以我会……"}, {"type": "subtitle", "time": 12085.349, "timestamp": "03:21:25", "text": "我当然还会哭，而且"}, {"type": "subtitle", "time": 12094.79, "timestamp": "03:21:34", "text": "支持我的人一直陪伴着我"}, {"type": "subtitle", "time": 12098.389, "timestamp": "03:21:38", "text": "来找我，而且喜欢"}, {"type": "subtitle", "time": 12101.59, "timestamp": "03:21:41", "text": "这给了我坚持下去的意志力。"}, {"type": "subtitle", "time": 12104.07, "timestamp": "03:21:44", "text": "流媒体和所有时尚"}, {"type": "subtitle", "time": 12108.469, "timestamp": "03:21:48", "text": "我从未拥有过的世界，就是这样。"}, {"type": "subtitle", "time": 12111.349, "timestamp": "03:21:51", "text": "但我感觉想哭。我的天啊，为什么我会这样？"}, {"type": "subtitle", "time": 12113.99, "timestamp": "03:21:53", "text": "准备开始？我的天啊。哦，是的。喜欢"}, {"type": "subtitle", "time": 12117.67, "timestamp": "03:21:57", "text": "然后，我心想，是的，我会的。"}]
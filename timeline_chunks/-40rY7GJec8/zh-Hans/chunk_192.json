[{"type": "subtitle", "time": 11520.469, "timestamp": "03:12:00", "text": "人们都在观看，而且很喜欢。"}, {"type": "subtitle", "time": 11522.71, "timestamp": "03:12:02", "text": "年龄以及他们喜欢的内容"}, {"type": "subtitle", "time": 11525.03, "timestamp": "03:12:05", "text": "以及他们播放的那些流媒体……嗯，所有这些"}, {"type": "subtitle", "time": 11528.389, "timestamp": "03:12:08", "text": "就是那种基于统计数据的东西，对吧？"}, {"type": "subtitle", "time": 11529.91, "timestamp": "03:12:09", "text": "分析"}, {"type": "subtitle", "time": 11537.429, "timestamp": "03:12:17", "text": "种植这些东西的最佳方法"}, {"type": "subtitle", "time": 11542.389, "timestamp": "03:12:22", "text": "因为我当时处于某种状态"}, {"type": "subtitle", "time": 11545.11, "timestamp": "03:12:25", "text": "几个月前，我身处……"}, {"type": "subtitle", "time": 11547.03, "timestamp": "03:12:27", "text": "就像下坡路一样"}, {"type": "subtitle", "time": 11550.469, "timestamp": "03:12:30", "text": "陷入抑郁模式，因为我……因为我……因为我"}, {"type": "subtitle", "time": 11553.429, "timestamp": "03:12:33", "text": "被告知要核对数字，然后我"}, {"type": "subtitle", "time": 11555.429, "timestamp": "03:12:35", "text": "被拒绝了，这让我有点心烦意乱"}, {"type": "subtitle", "time": 11559.59, "timestamp": "03:12:39", "text": "州战争和战争让我感到"}, {"type": "subtitle", "time": 11563.03, "timestamp": "03:12:43", "text": "感觉自己并不享受现在做的事情，"}, {"type": "subtitle", "time": 11566.95, "timestamp": "03:12:46", "text": "比如所有那些东西。正确的？所以我觉得"}, {"type": "subtitle", "time": 11569.91, "timestamp": "03:12:49", "text": "那……"}, {"type": "subtitle", "time": 11572.389, "timestamp": "03:12:52", "text": "关键就在于，那天就是我"}, {"type": "subtitle", "time": 11575.03, "timestamp": "03:12:55", "text": "我想我决定我需要做点什么了。"}, {"type": "subtitle", "time": 11578.23, "timestamp": "03:12:58", "text": "我和他之间产生了巨大的隔阂。"}]
[{"type": "subtitle", "time": 5760.79, "timestamp": "01:36:00", "text": "[音乐]"}, {"type": "subtitle", "time": 5761.81, "timestamp": "01:36:01", "text": "好的，"}, {"type": "subtitle", "time": 5769.99, "timestamp": "01:36:09", "text": "[音乐]"}, {"type": "subtitle", "time": 5772.96, "timestamp": "01:36:12", "text": "感觉就像我爸爸在打电话。我的天啊。"}, {"type": "subtitle", "time": 5802.31, "timestamp": "01:36:42", "text": "晚安，我的宝贝天使们。我会祈祷"}, {"type": "subtitle", "time": 5804.07, "timestamp": "01:36:44", "text": "希望有一天能见到你。我爱你"}, {"type": "subtitle", "time": 5805.91, "timestamp": "01:36:45", "text": "全部。"}, {"type": "subtitle", "time": 5813.03, "timestamp": "01:36:53", "text": "愚蠢至极的分支。当然可以。哇。"}, {"type": "subtitle", "time": 5815.03, "timestamp": "01:36:55", "text": "我的天啊。"}]
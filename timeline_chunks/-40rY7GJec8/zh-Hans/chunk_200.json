[{"type": "subtitle", "time": 12000.07, "timestamp": "03:20:00", "text": "我们这里也遇到过这种情况，对吧？我们做到了"}, {"type": "subtitle", "time": 12001.51, "timestamp": "03:20:01", "text": "体验一下。我不知道你是否"}, {"type": "subtitle", "time": 12003.349, "timestamp": "03:20:03", "text": "当时在场"}, {"type": "subtitle", "time": 12007.03, "timestamp": "03:20:07", "text": "回到那场《命运》直播，当时"}, {"type": "subtitle", "time": 12008.95, "timestamp": "03:20:08", "text": "某些笨蛋"}, {"type": "subtitle", "time": 12011.19, "timestamp": "03:20:11", "text": "他们公开表示他们不会"}, {"type": "subtitle", "time": 12012.95, "timestamp": "03:20:12", "text": "来看我之类的，然后我就开始了。"}, {"type": "subtitle", "time": 12016.71, "timestamp": "03:20:16", "text": "直播的时候哭哭啼啼的，还有……"}, {"type": "subtitle", "time": 12019.67, "timestamp": "03:20:19", "text": "是的，大概是12点24分的时候。"}, {"type": "subtitle", "time": 12022.87, "timestamp": "03:20:22", "text": "直播时长不是24小时，我想是19小时。"}, {"type": "subtitle", "time": 12025.03, "timestamp": "03:20:25", "text": "几个小时过去了，是的，我开始哭了。"}, {"type": "subtitle", "time": 12028.79, "timestamp": "03:20:28", "text": "我一直在想这件事。"}, {"type": "subtitle", "time": 12032.71, "timestamp": "03:20:32", "text": "我有点……呃，我哭了一整夜"}, {"type": "subtitle", "time": 12035.99, "timestamp": "03:20:35", "text": "直播结束后，整晚都在直播。"}, {"type": "subtitle", "time": 12038.229, "timestamp": "03:20:38", "text": "思考"}, {"type": "subtitle", "time": 12042.309, "timestamp": "03:20:42", "text": "嗯，关于这件事。所以从某种程度上来说，我很敏感。"}, {"type": "subtitle", "time": 12045.99, "timestamp": "03:20:45", "text": "在某种程度上很敏感，但"}, {"type": "subtitle", "time": 12047.99, "timestamp": "03:20:47", "text": "一开始我当然会哭。"}, {"type": "subtitle", "time": 12050.309, "timestamp": "03:20:50", "text": "如果有人离开或者发生其他什么事，就会有很多问题。它是"}, {"type": "subtitle", "time": 12056.309, "timestamp": "03:20:56", "text": "呃，不可避免，但是，然后我呃喜欢"}, {"type": "subtitle", "time": 12059.03, "timestamp": "03:20:59", "text": "正如我所说，"}]
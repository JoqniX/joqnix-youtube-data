[{"type": "subtitle", "time": 1745.51, "timestamp": "00:29:05", "text": "她是不是……你刚才是不是哭了？"}, {"type": "subtitle", "time": 1748.18, "timestamp": "00:29:08", "text": "不。对。"}, {"type": "subtitle", "time": 1759.19, "timestamp": "00:29:19", "text": "笨蛋"}, {"type": "subtitle", "time": 1761.06, "timestamp": "00:29:21", "text": "睡觉。"}, {"type": "subtitle", "time": 1765.59, "timestamp": "00:29:25", "text": "[音乐]"}, {"type": "subtitle", "time": 1768.71, "timestamp": "00:29:28", "text": "我该给她吗？好的，我们来看看她。"}, {"type": "subtitle", "time": 1771.35, "timestamp": "00:29:31", "text": "情感与压力。她的压力全部"}, {"type": "subtitle", "time": 1774.07, "timestamp": "00:29:34", "text": "到处都是。"}, {"type": "subtitle", "time": 1782.07, "timestamp": "00:29:42", "text": "[音乐]"}, {"type": "subtitle", "time": 1785.83, "timestamp": "00:29:45", "text": "不知怎么的。我需要把它弄下来。"}, {"type": "subtitle", "time": 1790.23, "timestamp": "00:29:50", "text": "这是什么？ ## ..."}, {"type": "subtitle", "time": 1793.029, "timestamp": "00:29:53", "text": "空气中弥漫着这种气息。"}, {"type": "subtitle", "time": 1796.63, "timestamp": "00:29:56", "text": "这是什么？压力 46。"}]
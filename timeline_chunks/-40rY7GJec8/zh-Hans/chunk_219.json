[{"type": "subtitle", "time": 13141.75, "timestamp": "03:39:01", "text": "安全就是运营安全联盟（Opsac）的含义。"}, {"type": "subtitle", "time": 13143.51, "timestamp": "03:39:03", "text": "这是安全或风险管理"}, {"type": "subtitle", "time": 13145.75, "timestamp": "03:39:05", "text": "分类过程和策略"}, {"type": "subtitle", "time": 13147.75, "timestamp": "03:39:07", "text": "然后信息确定了什么是"}, {"type": "subtitle", "time": 13149.83, "timestamp": "03:39:09", "text": "为保护敏感信息所必需"}, {"type": "subtitle", "time": 13151.75, "timestamp": "03:39:11", "text": "阻止它获取的信息"}, {"type": "subtitle", "time": 13156.15, "timestamp": "03:39:16", "text": "落入坏人手中。是的。所以就像"}, {"type": "subtitle", "time": 13158.469, "timestamp": "03:39:18", "text": "即使对于 YouTuber 来说，OP 很烂也很重要"}, {"type": "subtitle", "time": 13162.07, "timestamp": "03:39:22", "text": "就像你必须确保……"}, {"type": "subtitle", "time": 13165.19, "timestamp": "03:39:25", "text": "他们反正也不会透露身份。"}, {"type": "subtitle", "time": 13167.59, "timestamp": "03:39:27", "text": "就像任何地方一样，即使是一张图片"}, {"type": "subtitle", "time": 13170.309, "timestamp": "03:39:30", "text": "哪怕只是一次这样的经历"}, {"type": "subtitle", "time": 13173.429, "timestamp": "03:39:33", "text": "地点，或者说他们来自哪里"}, {"type": "subtitle", "time": 13175.429, "timestamp": "03:39:35", "text": "那些东西真的很重要，对吧？"}, {"type": "subtitle", "time": 13177.269, "timestamp": "03:39:37", "text": "就像那样"}, {"type": "subtitle", "time": 13179.11, "timestamp": "03:39:39", "text": "所以"}, {"type": "subtitle", "time": 13182.63, "timestamp": "03:39:42", "text": "是的，就我而言。"}, {"type": "subtitle", "time": 13184.55, "timestamp": "03:39:44", "text": "我的天哪，我竟然是个意外……"}, {"type": "subtitle", "time": 13188.309, "timestamp": "03:39:48", "text": "泄露了我的IP地址和电子邮件地址"}, {"type": "subtitle", "time": 13192.63, "timestamp": "03:39:52", "text": "还有我很多东西，因为我笨"}, {"type": "subtitle", "time": 13197.349, "timestamp": "03:39:57", "text": "愚蠢的呃使用了显示捕获"}, {"type": "subtitle", "time": 13199.59, "timestamp": "03:39:59", "text": "因为自从我开始使用采集卡以来，就一直用它。"}]
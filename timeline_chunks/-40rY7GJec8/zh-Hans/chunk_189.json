[{"type": "subtitle", "time": 11343.59, "timestamp": "03:09:03", "text": "不再是其中的一员了。即使那21"}, {"type": "subtitle", "time": 11346.15, "timestamp": "03:09:06", "text": "这里已经没有人了，即使"}, {"type": "subtitle", "time": 11351.19, "timestamp": "03:09:11", "text": "他们已经……不再……了，就像……"}, {"type": "subtitle", "time": 11353.59, "timestamp": "03:09:13", "text": "因为是家人之类的，他们会"}, {"type": "subtitle", "time": 11357.349, "timestamp": "03:09:17", "text": "仍然是家庭的一份子，因为无论何时"}, {"type": "subtitle", "time": 11360.15, "timestamp": "03:09:20", "text": "总有一天他们会回来的，我会打开我的"}, {"type": "subtitle", "time": 11362.87, "timestamp": "03:09:22", "text": "用张开双臂热烈欢迎他们回来"}, {"type": "subtitle", "time": 11364.79, "timestamp": "03:09:24", "text": "咧嘴一笑，给他们很多头。"}, {"type": "subtitle", "time": 11366.71, "timestamp": "03:09:26", "text": "轻拍和胸部。"}, {"type": "subtitle", "time": 11369.269, "timestamp": "03:09:29", "text": "但如果真是这样，那很正常，对吧？那里"}, {"type": "subtitle", "time": 11372.55, "timestamp": "03:09:32", "text": "会有一些让你观看的精彩瞬间"}, {"type": "subtitle", "time": 11374.87, "timestamp": "03:09:34", "text": "比如积极参与社区活动，以及"}, {"type": "subtitle", "time": 11377.429, "timestamp": "03:09:37", "text": "然后过了很久之后，你就不会……"}, {"type": "subtitle", "time": 11380.07, "timestamp": "03:09:40", "text": "再次活跃于社区活动。但是也"}, {"type": "subtitle", "time": 11383.269, "timestamp": "03:09:43", "text": "比如，如果这是一个你所在的社区"}, {"type": "subtitle", "time": 11385.11, "timestamp": "03:09:45", "text": "多次打断了那个人"}, {"type": "subtitle", "time": 11386.63, "timestamp": "03:09:46", "text": "管理它或者像主播一样"}, {"type": "subtitle", "time": 11388.23, "timestamp": "03:09:48", "text": "他们自己会永远记住你。"}, {"type": "subtitle", "time": 11390.309, "timestamp": "03:09:50", "text": "当你回去的时候，他们就会"}, {"type": "subtitle", "time": 11394.15, "timestamp": "03:09:54", "text": "我现在好开心，那种感觉真好。"}, {"type": "subtitle", "time": 11398.07, "timestamp": "03:09:58", "text": "我觉得我经常会有这种感觉。"}]
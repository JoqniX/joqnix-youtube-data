[{"type": "subtitle", "time": 4260.31, "timestamp": "01:11:00", "text": "变硬。所以，大型主播实际上只"}, {"type": "subtitle", "time": 4262.95, "timestamp": "01:11:02", "text": "对吧？我会看超级留言。我并不感到奇怪"}, {"type": "subtitle", "time": 4269.43, "timestamp": "01:11:09", "text": "所以现在你们看着我是怎么得到一些的"}, {"type": "subtitle", "time": 4274.55, "timestamp": "01:11:14", "text": "当然，我会让你看看我的亨森。"}, {"type": "subtitle", "time": 4275.87, "timestamp": "01:11:15", "text": "建造。"}, {"type": "subtitle", "time": 4281.36, "timestamp": "01:11:21", "text": "什么紧张局势？"}, {"type": "subtitle", "time": 4284.55, "timestamp": "01:11:24", "text": "[音乐]"}, {"type": "subtitle", "time": 4287.27, "timestamp": "01:11:27", "text": "每个女孩都有空闲时间。我要去做我的"}, {"type": "subtitle", "time": 4289.27, "timestamp": "01:11:29", "text": "最好变成那个老女孩那样的人"}, {"type": "subtitle", "time": 4291.75, "timestamp": "01:11:31", "text": "差不多吧。我要带你去"}, {"type": "subtitle", "time": 4294.55, "timestamp": "01:11:34", "text": "和我一起上学。"}, {"type": "subtitle", "time": 4298.95, "timestamp": "01:11:38", "text": "呃，所以我来到了游戏厅。"}, {"type": "subtitle", "time": 4301.11, "timestamp": "01:11:41", "text": "坐在后面。请务必给予"}, {"type": "subtitle", "time": 4307.79, "timestamp": "01:11:47", "text": "我的硬件和资金。"}, {"type": "subtitle", "time": 4311.75, "timestamp": "01:11:51", "text": "[音乐]"}, {"type": "subtitle", "time": 4313.189, "timestamp": "01:11:53", "text": "够了。你逃不掉的。"}, {"type": "subtitle", "time": 4316.07, "timestamp": "01:11:56", "text": "哦，天哪。别再无视我了。她为什么会这样？"}, {"type": "subtitle", "time": 4318.709, "timestamp": "01:11:58", "text": "说我无视她？但我不是"}]
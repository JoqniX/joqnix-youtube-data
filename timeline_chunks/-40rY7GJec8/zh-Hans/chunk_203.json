[{"type": "subtitle", "time": 12183.19, "timestamp": "03:23:03", "text": "它们高悬在天上，永远守护着我们。"}, {"type": "subtitle", "time": 12184.87, "timestamp": "03:23:04", "text": "你"}, {"type": "subtitle", "time": 12188.71, "timestamp": "03:23:08", "text": "我永远都会张开双臂欢迎你"}, {"type": "subtitle", "time": 12190.95, "timestamp": "03:23:10", "text": "就像你每次回来，或者即使"}, {"type": "subtitle", "time": 12194.07, "timestamp": "03:23:14", "text": "你知道我的存在就足够了。"}, {"type": "subtitle", "time": 12198.469, "timestamp": "03:23:18", "text": "对我来说就是这样。"}, {"type": "subtitle", "time": 12200.389, "timestamp": "03:23:20", "text": "我的意思是，这并非我第一次遇到这种情况。"}, {"type": "subtitle", "time": 12203.269, "timestamp": "03:23:23", "text": "有这种感觉。就像通过这个"}, {"type": "subtitle", "time": 12207.19, "timestamp": "03:23:27", "text": "旅程，我想我几乎已经感受到了……"}, {"type": "subtitle", "time": 12210.55, "timestamp": "03:23:30", "text": "七次了"}, {"type": "subtitle", "time": 12212.229, "timestamp": "03:23:32", "text": "当然，这个数字将会是"}, {"type": "subtitle", "time": 12214.95, "timestamp": "03:23:34", "text": "增加。当然，这个数字还在增长。"}, {"type": "subtitle", "time": 12218.95, "timestamp": "03:23:38", "text": "增加，我认为只有40或3个。"}, {"type": "subtitle", "time": 12221.59, "timestamp": "03:23:41", "text": "时间40或三起事件，只有少数几起"}, {"type": "subtitle", "time": 12225.03, "timestamp": "03:23:45", "text": "我的朋友们都知道"}, {"type": "subtitle", "time": 12227.429, "timestamp": "03:23:47", "text": "家人都知道我有哪些孩子"}, {"type": "subtitle", "time": 12229.67, "timestamp": "03:23:49", "text": "虽然公开谈论过，但一直存在"}, {"type": "subtitle", "time": 12233.67, "timestamp": "03:23:53", "text": "发生了七八起类似的事件"}, {"type": "subtitle", "time": 12236.63, "timestamp": "03:23:56", "text": "我的天啊，但是，是的，但是即便如此，在"}, {"type": "subtitle", "time": 12238.469, "timestamp": "03:23:58", "text": "方式"}]
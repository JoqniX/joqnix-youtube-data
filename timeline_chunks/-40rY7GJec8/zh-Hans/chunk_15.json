[{"type": "subtitle", "time": 902.55, "timestamp": "00:15:02", "text": "我们陪着她吧。"}, {"type": "subtitle", "time": 905.269, "timestamp": "00:15:05", "text": "制作一款我们有宠物的游戏。"}, {"type": "subtitle", "time": 914.949, "timestamp": "00:15:14", "text": "[音乐]"}, {"type": "subtitle", "time": 917.189, "timestamp": "00:15:17", "text": "谢谢你一直以来都这么好。"}, {"type": "subtitle", "time": 919.99, "timestamp": "00:15:19", "text": "我。一个"}, {"type": "subtitle", "time": 921.99, "timestamp": "00:15:21", "text": "我会传承你的精神，好好待你。"}, {"type": "subtitle", "time": 925.03, "timestamp": "00:15:25", "text": "我的小领主们。每个人都以某种方式。"}, {"type": "subtitle", "time": 926.55, "timestamp": "00:15:26", "text": "但我依然爱着你。"}, {"type": "subtitle", "time": 928.88, "timestamp": "00:15:28", "text": "最多。好的。没必要嫉妒。"}, {"type": "subtitle", "time": 930.47, "timestamp": "00:15:30", "text": "[音乐]"}, {"type": "subtitle", "time": 940.949, "timestamp": "00:15:40", "text": "哦，不。性感直播。什么？哦，不。为什么？"}, {"type": "subtitle", "time": 943.75, "timestamp": "00:15:43", "text": "你为什么会有那样的想法？"}, {"type": "subtitle", "time": 945.99, "timestamp": "00:15:45", "text": "与观众建立准社会关系。"}, {"type": "subtitle", "time": 947.94, "timestamp": "00:15:47", "text": "那很糟糕。"}]
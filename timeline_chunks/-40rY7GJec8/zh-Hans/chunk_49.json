[{"type": "subtitle", "time": 2947.99, "timestamp": "00:49:07", "text": "等等，但是再说一遍，只有很少"}, {"type": "subtitle", "time": 2952.23, "timestamp": "00:49:12", "text": "稍微往左一点，对吧？我觉得没问题。"}, {"type": "subtitle", "time": 2954.87, "timestamp": "00:49:14", "text": "她的精神状态很重要，对吧？在"}, {"type": "subtitle", "time": 2957.27, "timestamp": "00:49:17", "text": "方式。"}, {"type": "subtitle", "time": 2960.23, "timestamp": "00:49:20", "text": "我应该这么做吗？我不知道。"}, {"type": "subtitle", "time": 2962.39, "timestamp": "00:49:22", "text": "[音乐]"}, {"type": "subtitle", "time": 2965.67, "timestamp": "00:49:25", "text": "77。这是一个很大的数字。"}, {"type": "subtitle", "time": 2968.88, "timestamp": "00:49:28", "text": "71. 好吧，行。我会这么做。"}, {"type": "subtitle", "time": 2974.15, "timestamp": "00:49:34", "text": "[音乐]"}, {"type": "subtitle", "time": 2977.589, "timestamp": "00:49:37", "text": "主要是指你的精神状态如何"}, {"type": "subtitle", "time": 2984.47, "timestamp": "00:49:44", "text": "我爱我的感觉"}, {"type": "subtitle", "time": 2986.309, "timestamp": "00:49:46", "text": "我的头"}, {"type": "subtitle", "time": 2990.19, "timestamp": "00:49:50", "text": "也一样。我的天啊。再见。"}, {"type": "subtitle", "time": 2997.27, "timestamp": "00:49:57", "text": "我考虑过在我的……嗯"}, {"type": "subtitle", "time": 2999.03, "timestamp": "00:49:59", "text": "我的衣服都堆在一起了。我认为"}]
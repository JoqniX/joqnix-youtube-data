[{"type": "subtitle", "time": 131.35, "timestamp": "00:02:11", "text": "别哭。"}, {"type": "subtitle", "time": 133.83, "timestamp": "00:02:13", "text": "别再迎合那些老家伙了"}, {"type": "subtitle", "time": 136.47, "timestamp": "00:02:16", "text": "互联网。等待。哦，儿子们在看着她"}, {"type": "subtitle", "time": 138.63, "timestamp": "00:02:18", "text": "溪流。等等，什么？"}, {"type": "subtitle", "time": 140.79, "timestamp": "00:02:20", "text": "好的，没关系。总会有下一个。"}, {"type": "subtitle", "time": 143.11, "timestamp": "00:02:23", "text": "时间。是的。是的。是的。我不应该"}, {"type": "subtitle", "time": 146.22899999999998, "timestamp": "00:02:26", "text": "点击评论。"}, {"type": "subtitle", "time": 147.91, "timestamp": "00:02:27", "text": "你长得这么漂亮，真是幸运。我是一个大"}, {"type": "subtitle", "time": 150.26, "timestamp": "00:02:30", "text": "朋友。"}, {"type": "subtitle", "time": 159.27, "timestamp": "00:02:39", "text": "他们只看到这样的情况："}, {"type": "subtitle", "time": 161.91, "timestamp": "00:02:41", "text": "女人哭泣是合适的吗？"}, {"type": "subtitle", "time": 163.67000000000002, "timestamp": "00:02:43", "text": "当你被甩的时候，当你失去你的"}, {"type": "subtitle", "time": 165.589, "timestamp": "00:02:45", "text": "钱包和你的孩子玩闪卡游戏时"}, {"type": "subtitle", "time": 168.47, "timestamp": "00:02:48", "text": "停产。"}, {"type": "subtitle", "time": 170.949, "timestamp": "00:02:50", "text": "更多的"}, {"type": "subtitle", "time": 172.63, "timestamp": "00:02:52", "text": "首次游戏直播。今天就到这里。"}, {"type": "subtitle", "time": 175.43, "timestamp": "00:02:55", "text": "我猜是积木。"}, {"type": "subtitle", "time": 177.71, "timestamp": "00:02:57", "text": "不，效果并不好。"}]
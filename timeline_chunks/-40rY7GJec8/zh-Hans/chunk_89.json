[{"type": "subtitle", "time": 5340.95, "timestamp": "01:29:00", "text": "就像每个人都会感到惊讶一样"}, {"type": "subtitle", "time": 5344.31, "timestamp": "01:29:04", "text": "感到厌倦"}, {"type": "subtitle", "time": 5346.39, "timestamp": "01:29:06", "text": "我很惊讶人们会对……感到厌倦。"}, {"type": "subtitle", "time": 5350.95, "timestamp": "01:29:10", "text": "他们自己的专家。等等，什么？"}, {"type": "subtitle", "time": 5359.35, "timestamp": "01:29:19", "text": "没有缺点。好的。"}, {"type": "subtitle", "time": 5361.41, "timestamp": "01:29:21", "text": "我的天哪。"}, {"type": "subtitle", "time": 5372.709, "timestamp": "01:29:32", "text": "[音乐]"}, {"type": "subtitle", "time": 5374.95, "timestamp": "01:29:34", "text": "我收到了一堆邮件。"}, {"type": "subtitle", "time": 5377.91, "timestamp": "01:29:37", "text": "谈到税收之类的破事。"}, {"type": "subtitle", "time": 5379.59, "timestamp": "01:29:39", "text": "这是我必须做的事情之一"}, {"type": "subtitle", "time": 5390.39, "timestamp": "01:29:50", "text": "等待。呃，在我们走之前，我需要一个更低的"}, {"type": "subtitle", "time": 5392.18, "timestamp": "01:29:52", "text": "她"}, {"type": "subtitle", "time": 5396.709, "timestamp": "01:29:56", "text": "[音乐]"}, {"type": "subtitle", "time": 5398.07, "timestamp": "01:29:58", "text": "寻找她计划好的东西。希望"}]
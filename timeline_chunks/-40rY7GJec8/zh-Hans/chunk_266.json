[{"type": "subtitle", "time": 15961.03, "timestamp": "04:26:01", "text": "比如我们需要渲染视频，"}, {"type": "subtitle", "time": 15963.67, "timestamp": "04:26:03", "text": "所有那些东西和游戏。好多游戏"}, {"type": "subtitle", "time": 15966.07, "timestamp": "04:26:06", "text": "我需要很多游戏，"}, {"type": "subtitle", "time": 15968.87, "timestamp": "04:26:08", "text": "在 YouTube 上看完这部剧集。是的，一个"}, {"type": "subtitle", "time": 15970.87, "timestamp": "04:26:10", "text": "我希望有一天我能回到Arc。"}, {"type": "subtitle", "time": 15972.87, "timestamp": "04:26:12", "text": "也能在服务器上正常游戏或"}, {"type": "subtitle", "time": 15975.59, "timestamp": "04:26:15", "text": "而不是本地保存。我是说"}, {"type": "subtitle", "time": 15977.75, "timestamp": "04:26:17", "text": "我对本地保存功能很满意。所以我确实有"}, {"type": "subtitle", "time": 15980.63, "timestamp": "04:26:20", "text": "我为方舟做的本地存档"}, {"type": "subtitle", "time": 15983.83, "timestamp": "04:26:23", "text": "我在 YouTube 上制作的《生存进化》系列视频"}, {"type": "subtitle", "time": 15985.99, "timestamp": "04:26:25", "text": "我想应该是那三四条溪流吧。"}, {"type": "subtitle", "time": 15987.67, "timestamp": "04:26:27", "text": "是的。是的。是的。我仍然有"}, {"type": "subtitle", "time": 15990.229, "timestamp": "04:26:30", "text": "当地人。我确实备份了它。"}, {"type": "subtitle", "time": 15992.71, "timestamp": "04:26:32", "text": "安装游戏之前。是的，一个"}, {"type": "subtitle", "time": 15995.429, "timestamp": "04:26:35", "text": "我会在当天进行直播。"}, {"type": "subtitle", "time": 15998.309, "timestamp": "04:26:38", "text": "好的，但还是要谢谢你们的到来。希望"}, {"type": "subtitle", "time": 15999.99, "timestamp": "04:26:39", "text": "你今天过得很愉快。祝你好运！"}, {"type": "subtitle", "time": 16004.309, "timestamp": "04:26:44", "text": "明天。今天爱德华来了。"}, {"type": "subtitle", "time": 16009.189, "timestamp": "04:26:49", "text": "感谢您今天光临。希望你玩得开心。"}, {"type": "subtitle", "time": 16014.07, "timestamp": "04:26:54", "text": "像往常一样前来探望，意义非凡。"}, {"type": "subtitle", "time": 16017.91, "timestamp": "04:26:57", "text": "希望你今天过得愉快。"}]
[{"type": "subtitle", "time": 10201.429, "timestamp": "02:50:01", "text": "我们在《Lady Shrema》中看到的是当El"}, {"type": "subtitle", "time": 10204.469, "timestamp": "02:50:04", "text": "安琪儿当她得到这个角色的时候"}, {"type": "subtitle", "time": 10208.55, "timestamp": "02:50:08", "text": "大约有10000人"}, {"type": "subtitle", "time": 10211.67, "timestamp": "02:50:11", "text": "一些粉丝，或者大概9000多人，"}, {"type": "subtitle", "time": 10213.51, "timestamp": "02:50:13", "text": "她开始获得赞助，"}, {"type": "subtitle", "time": 10217.03, "timestamp": "02:50:17", "text": "东西，对吧？所以从某种意义上说，互联网"}, {"type": "subtitle", "time": 10218.95, "timestamp": "02:50:18", "text": "是"}, {"type": "subtitle", "time": 10220.95, "timestamp": "02:50:20", "text": "呃，就像……"}, {"type": "subtitle", "time": 10223.429, "timestamp": "02:50:23", "text": "赞助以及他们所有的这一切"}, {"type": "subtitle", "time": 10227.269, "timestamp": "02:50:27", "text": "令人遗憾的是，我甚至很在意这个数字。"}, {"type": "subtitle", "time": 10228.71, "timestamp": "02:50:28", "text": "例如，当你尝试……"}, {"type": "subtitle", "time": 10231.429, "timestamp": "02:50:31", "text": "与某人或某事合作，或者类似"}, {"type": "subtitle", "time": 10234.71, "timestamp": "02:50:34", "text": "比如某个特定品牌或公司"}, {"type": "subtitle", "time": 10237.19, "timestamp": "02:50:37", "text": "比如你想为自己做的事情"}, {"type": "subtitle", "time": 10239.11, "timestamp": "02:50:39", "text": "提升你的内容流量或点赞量"}, {"type": "subtitle", "time": 10242.95, "timestamp": "02:50:42", "text": "告诉了某些人。有些人他们"}, {"type": "subtitle", "time": 10244.71, "timestamp": "02:50:44", "text": "检查你的数据并据此评判自己。"}, {"type": "subtitle", "time": 10246.55, "timestamp": "02:50:46", "text": "就此而言。他们不会因为你"}, {"type": "subtitle", "time": 10248.71, "timestamp": "02:50:48", "text": "个性或观看你的直播并查看"}, {"type": "subtitle", "time": 10252.23, "timestamp": "02:50:52", "text": "你好吗？他们会根据以下方面来评判你："}, {"type": "subtitle", "time": 10254.63, "timestamp": "02:50:54", "text": "看着这个数字，然后就觉得，嗯，就是这样。"}, {"type": "subtitle", "time": 10257.75, "timestamp": "02:50:57", "text": "这家伙不会像取消一样切断"}]
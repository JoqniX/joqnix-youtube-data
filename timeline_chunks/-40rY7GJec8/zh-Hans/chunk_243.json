[{"type": "subtitle", "time": 14580.07, "timestamp": "04:03:00", "text": "这个滚动系统。一是菜单"}, {"type": "subtitle", "time": 14581.99, "timestamp": "04:03:01", "text": "版本一是面向非男性用户的版本，"}, {"type": "subtitle", "time": 14583.429, "timestamp": "04:03:03", "text": "跳过版本，其中一个是"}, {"type": "subtitle", "time": 14585.75, "timestamp": "04:03:05", "text": "反应式滚动版本。即使拥有所有这些"}, {"type": "subtitle", "time": 14587.99, "timestamp": "04:03:07", "text": "人们在这方面遇到了困难"}, {"type": "subtitle", "time": 14589.59, "timestamp": "04:03:09", "text": "吸收活性氧。所以，我想我还是等等吧"}, {"type": "subtitle", "time": 14592.07, "timestamp": "04:03:12", "text": "用于 Discord 功能。所以那样做"}, {"type": "subtitle", "time": 14594.95, "timestamp": "04:03:14", "text": "我会专门辟出一部分给懂行的人。"}, {"type": "subtitle", "time": 14597.429, "timestamp": "04:03:17", "text": "编写代码。他们可以组成社区"}, {"type": "subtitle", "time": 14600.309, "timestamp": "04:03:20", "text": "游戏或者其他一些熟悉的东西"}, {"type": "subtitle", "time": 14603.91, "timestamp": "04:03:23", "text": "人物。我们有37号球员在阵容中"}, {"type": "subtitle", "time": 14607.59, "timestamp": "04:03:27", "text": "第一卷目前的角色设定如下。"}, {"type": "subtitle", "time": 14611.189, "timestamp": "04:03:31", "text": "所以我必须努力工作"}, {"type": "subtitle", "time": 14613.91, "timestamp": "04:03:33", "text": "赋予它们生命。是的，目前是这样。"}, {"type": "subtitle", "time": 14616.95, "timestamp": "04:03:36", "text": "只有四个角色是四个主要角色。"}, {"type": "subtitle", "time": 14618.95, "timestamp": "04:03:38", "text": "角色都在这里。有货"}, {"type": "subtitle", "time": 14621.75, "timestamp": "04:03:41", "text": "大家都知道那是我，jockn"}, {"type": "subtitle", "time": 14624.07, "timestamp": "04:03:44", "text": "你看到的那个红发女孩玩的跷跷板"}, {"type": "subtitle", "time": 14626.309, "timestamp": "04:03:46", "text": "那个紫头发的女孩被称为"}, {"type": "subtitle", "time": 14630.63, "timestamp": "04:03:50", "text": "奎妮娜和青色的嗯嗯，是的"}, {"type": "subtitle", "time": 14633.67, "timestamp": "04:03:53", "text": "青色头部人物角色你"}, {"type": "subtitle", "time": 14637.269, "timestamp": "04:03:57", "text": "我看到有人问你31号有什么计划吗？"}, {"type": "subtitle", "time": 14639.83, "timestamp": "04:03:59", "text": "是的，我31号有计划，所以……"}]
[{"type": "subtitle", "time": 10260.55, "timestamp": "02:51:00", "text": "就是这样。所以这是其中之一"}, {"type": "subtitle", "time": 10265.11, "timestamp": "02:51:05", "text": "我学到的方法"}, {"type": "subtitle", "time": 10268.389, "timestamp": "02:51:08", "text": "是的，即使你不在乎，这些数字也很重要。"}, {"type": "subtitle", "time": 10272.389, "timestamp": "02:51:12", "text": "关于数字，它可以达到某个程度。"}, {"type": "subtitle", "time": 10274.55, "timestamp": "02:51:14", "text": "你被迫"}, {"type": "subtitle", "time": 10280.95, "timestamp": "02:51:20", "text": "不是偶尔，而是偶尔一次或"}, {"type": "subtitle", "time": 10284.79, "timestamp": "02:51:24", "text": "就像一些强大的我呃媒介"}, {"type": "subtitle", "time": 10288.15, "timestamp": "02:51:28", "text": "意思是，就像你管它叫什么？"}, {"type": "subtitle", "time": 10290.07, "timestamp": "02:51:30", "text": "假设你想找个视觉朋友"}, {"type": "subtitle", "time": 10292.389, "timestamp": "02:51:32", "text": "或者他们在谈论的什么事……"}, {"type": "subtitle", "time": 10295.269, "timestamp": "02:51:35", "text": "类似这样的事情，与此相关"}, {"type": "subtitle", "time": 10297.59, "timestamp": "02:51:37", "text": "像这样的话题，以及他们开始讨论的话题。"}, {"type": "subtitle", "time": 10299.83, "timestamp": "02:51:39", "text": "比较和某些事情，你会感觉"}, {"type": "subtitle", "time": 10301.67, "timestamp": "02:51:41", "text": "在你的脑海里，你会感觉到"}, {"type": "subtitle", "time": 10303.75, "timestamp": "02:51:43", "text": "啊"}, {"type": "subtitle", "time": 10307.51, "timestamp": "02:51:47", "text": "哦不，呃，你开始无意识地……"}, {"type": "subtitle", "time": 10309.429, "timestamp": "02:51:49", "text": "开始与他人比较"}, {"type": "subtitle", "time": 10312.07, "timestamp": "02:51:52", "text": "就像慢慢地、慢慢地感受到"}, {"type": "subtitle", "time": 10314.15, "timestamp": "02:51:54", "text": "查看数据就会出现，然后你"}, {"type": "subtitle", "time": 10316.309, "timestamp": "02:51:56", "text": "看看你的数据，再看看他们的数据。"}, {"type": "subtitle", "time": 10319.91, "timestamp": "02:51:59", "text": "数字的感觉"}]
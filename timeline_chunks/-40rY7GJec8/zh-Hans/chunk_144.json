[{"type": "subtitle", "time": 8643.429, "timestamp": "02:24:03", "text": "等等，我到达了“否”。等等，等等。"}, {"type": "subtitle", "time": 8647.11, "timestamp": "02:24:07", "text": "等待。我无法接受"}, {"type": "subtitle", "time": 8650.15, "timestamp": "02:24:10", "text": "她让我变傻了"}, {"type": "subtitle", "time": 8653.27, "timestamp": "02:24:13", "text": "因为那条直播。你看，这就是我"}, {"type": "subtitle", "time": 8654.95, "timestamp": "02:24:14", "text": "说。"}, {"type": "subtitle", "time": 8657.91, "timestamp": "02:24:17", "text": "我就是这么说的。我差不多"}, {"type": "subtitle", "time": 8659.59, "timestamp": "02:24:19", "text": "与其吹气不如用皮肤，因为我猜我"}, {"type": "subtitle", "time": 8661.03, "timestamp": "02:24:21", "text": "必须更加积极主动，而不是"}, {"type": "subtitle", "time": 8663.11, "timestamp": "02:24:23", "text": "被动的。感觉好像不太对劲"}, {"type": "subtitle", "time": 8665.19, "timestamp": "02:24:25", "text": "没错。"}, {"type": "subtitle", "time": 8667.51, "timestamp": "02:24:27", "text": "我再也无法忍受被人忽视了。"}, {"type": "subtitle", "time": 8669.67, "timestamp": "02:24:29", "text": "这确实是我们的问题。再见，"}, {"type": "subtitle", "time": 8672.309, "timestamp": "02:24:32", "text": "桃。我真的非常爱你。什么"}, {"type": "subtitle", "time": 8676.26, "timestamp": "02:24:36", "text": "你是说“是”吗？嗯？"}, {"type": "subtitle", "time": 8688.71, "timestamp": "02:24:48", "text": "再次出现直线下降。"}]
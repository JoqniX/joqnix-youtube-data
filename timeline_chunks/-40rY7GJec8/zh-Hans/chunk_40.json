[{"type": "subtitle", "time": 2401.589, "timestamp": "00:40:01", "text": "永远。永远相爱。再给我寄一些。"}, {"type": "subtitle", "time": 2404.55, "timestamp": "00:40:04", "text": "69 高效。我的天啊。是的。你好我的"}, {"type": "subtitle", "time": 2406.71, "timestamp": "00:40:06", "text": "儿子。你好吗？希望你一切顺利"}, {"type": "subtitle", "time": 2409.99, "timestamp": "00:40:09", "text": "出色地。节日快乐。"}, {"type": "subtitle", "time": 2413.109, "timestamp": "00:40:13", "text": "[音乐]"}, {"type": "subtitle", "time": 2421.43, "timestamp": "00:40:21", "text": "我对她那个秘密计划非常怀疑。"}, {"type": "subtitle", "time": 2433.71, "timestamp": "00:40:33", "text": "好的。所以，我们必须采取行动。嗯，"}, {"type": "subtitle", "time": 2436.069, "timestamp": "00:40:36", "text": "[音乐]"}, {"type": "subtitle", "time": 2438.47, "timestamp": "00:40:38", "text": "压力水平就在附近。所以，我们会采取"}, {"type": "subtitle", "time": 2450.71, "timestamp": "00:40:50", "text": "也许如果我……我会结交更多死去的挚友"}, {"type": "subtitle", "time": 2452.39, "timestamp": "00:40:52", "text": "开始直播格斗游戏，但是"}, {"type": "subtitle", "time": 2455.19, "timestamp": "00:40:55", "text": "直播评论区应该会非常热闹。"}, {"type": "subtitle", "time": 2457.109, "timestamp": "00:40:57", "text": "恼人的。所以，也许不是。学习作曲"}, {"type": "subtitle", "time": 2459.19, "timestamp": "00:40:59", "text": "是疼痛。我宁愿平静地玩扭蛋游戏。"}]
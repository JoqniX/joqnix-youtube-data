[{"type": "subtitle", "time": 9661.11, "timestamp": "02:41:01", "text": "身为印度人所面临的挑战"}, {"type": "subtitle", "time": 9664.71, "timestamp": "02:41:04", "text": "家庭再次受到干扰"}, {"type": "subtitle", "time": 9666.63, "timestamp": "02:41:06", "text": "每隔10分钟就会发生一次之类的事情。"}, {"type": "subtitle", "time": 9673.91, "timestamp": "02:41:13", "text": "但是，再说一遍，"}, {"type": "subtitle", "time": 9677.429, "timestamp": "02:41:17", "text": "但归根结底，经验才是关键，对吧？"}, {"type": "subtitle", "time": 9679.03, "timestamp": "02:41:19", "text": "经历越多，你就越……"}, {"type": "subtitle", "time": 9682.389, "timestamp": "02:41:22", "text": "适应它，你也会有所收获。"}, {"type": "subtitle", "time": 9685.11, "timestamp": "02:41:25", "text": "尝试不同的结果"}, {"type": "subtitle", "time": 9687.349, "timestamp": "02:41:27", "text": "生活中的事物和新部分，就像……"}, {"type": "subtitle", "time": 9689.99, "timestamp": "02:41:29", "text": "挑战本身就在于搬出去"}, {"type": "subtitle", "time": 9692.469, "timestamp": "02:41:32", "text": "并像……一样独立生活。"}, {"type": "subtitle", "time": 9694.79, "timestamp": "02:41:34", "text": "维持自身并充实自己"}, {"type": "subtitle", "time": 9696.79, "timestamp": "02:41:36", "text": "胃部向上"}, {"type": "subtitle", "time": 9698.87, "timestamp": "02:41:38", "text": "拥有日常必需品并且喜欢拥有"}, {"type": "subtitle", "time": 9700.71, "timestamp": "02:41:40", "text": "一个地方"}, {"type": "subtitle", "time": 9704.07, "timestamp": "02:41:44", "text": "留下来睡觉"}, {"type": "subtitle", "time": 9705.83, "timestamp": "02:41:45", "text": "从医学角度来看，"}, {"type": "subtitle", "time": 9708.55, "timestamp": "02:41:48", "text": "身体上，精神上"}]
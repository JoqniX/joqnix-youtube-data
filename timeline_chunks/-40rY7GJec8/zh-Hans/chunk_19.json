[{"type": "subtitle", "time": 1141.51, "timestamp": "00:19:01", "text": "和她"}, {"type": "subtitle", "time": 1144.47, "timestamp": "00:19:04", "text": "了解她的为人。哦，"}, {"type": "subtitle", "time": 1148.789, "timestamp": "00:19:08", "text": "我看到更多洛丽塔风格的衣服。好的。"}, {"type": "subtitle", "time": 1150.47, "timestamp": "00:19:10", "text": "是的。你好，艾莉。你好吗"}, {"type": "subtitle", "time": 1152.23, "timestamp": "00:19:12", "text": "今天？"}, {"type": "subtitle", "time": 1154.63, "timestamp": "00:19:14", "text": "哟，哟。"}, {"type": "subtitle", "time": 1172.23, "timestamp": "00:19:32", "text": "你鼓励我穿自己喜欢的衣服。"}, {"type": "subtitle", "time": 1174.47, "timestamp": "00:19:34", "text": "我们俩一起穿洛丽塔风格的衣服出去玩吧。"}, {"type": "subtitle", "time": 1177.83, "timestamp": "00:19:37", "text": "等等，她会吗？"}, {"type": "subtitle", "time": 1180.87, "timestamp": "00:19:40", "text": "她会允许其他人加入吗？"}, {"type": "subtitle", "time": 1187.83, "timestamp": "00:19:47", "text": "另一个超级聊天装扮你的黑客技巧。哦"}, {"type": "subtitle", "time": 1196.15, "timestamp": "00:19:56", "text": "我"}, {"type": "subtitle", "time": 1199.75, "timestamp": "00:19:59", "text": "这么说吧，但你说的有道理。好的。"}]
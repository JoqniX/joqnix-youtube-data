[{"type": "subtitle", "time": 1926.95, "timestamp": "00:32:06", "text": "我会得到64点压力。哦，不。"}, {"type": "subtitle", "time": 1930.63, "timestamp": "00:32:10", "text": "游戏女孩的经历。好的，等等。"}, {"type": "subtitle", "time": 1933.46, "timestamp": "00:32:13", "text": "兔子洞奖励。"}, {"type": "subtitle", "time": 1943.83, "timestamp": "00:32:23", "text": "等等，我的好感度会下降。哦，不。"}, {"type": "subtitle", "time": 1950.149, "timestamp": "00:32:30", "text": "这么说吧，他们度过了一段非常愉快的时光。"}, {"type": "subtitle", "time": 1954.63, "timestamp": "00:32:34", "text": "做爱。我懂了。我懂了。我当时想"}, {"type": "subtitle", "time": 1957.909, "timestamp": "00:32:37", "text": "谢天谢地，不是你的自行车出了问题。"}, {"type": "subtitle", "time": 1960.789, "timestamp": "00:32:40", "text": "我需要……该怎么称呼它呢？布"}, {"type": "subtitle", "time": 1961.99, "timestamp": "00:32:41", "text": "或者别的什么。"}, {"type": "subtitle", "time": 1965.43, "timestamp": "00:32:45", "text": "[音乐]"}, {"type": "subtitle", "time": 1973.61, "timestamp": "00:32:53", "text": "我先来了。我们走吧。新人"}, {"type": "subtitle", "time": 1978.95, "timestamp": "00:32:58", "text": "只是查一下。我从未见过这种情况"}]
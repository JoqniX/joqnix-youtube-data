[{"type": "subtitle", "time": 541.29, "timestamp": "00:09:01", "text": "如果真的发生了呢？"}, {"type": "subtitle", "time": 542.63, "timestamp": "00:09:02", "text": "[音乐]"}, {"type": "subtitle", "time": 546.87, "timestamp": "00:09:06", "text": "哦不，那不是"}, {"type": "subtitle", "time": 549.75, "timestamp": "00:09:09", "text": "跳着自由的舞步。"}, {"type": "subtitle", "time": 560.79, "timestamp": "00:09:20", "text": "她正在做病态人格。"}, {"type": "subtitle", "time": 563.03, "timestamp": "00:09:23", "text": "你说的任何话我都相信。 K angel。"}, {"type": "subtitle", "time": 565.509, "timestamp": "00:09:25", "text": "哦，不。真正的舔狗。"}, {"type": "subtitle", "time": 568.23, "timestamp": "00:09:28", "text": "哦，不。你在这方面做得太过火了。"}, {"type": "subtitle", "time": 575.829, "timestamp": "00:09:35", "text": "[音乐]"}, {"type": "subtitle", "time": 585.43, "timestamp": "00:09:45", "text": "就像你最终会离开一样"}, {"type": "subtitle", "time": 587.509, "timestamp": "00:09:47", "text": "深海。"}, {"type": "subtitle", "time": 590.23, "timestamp": "00:09:50", "text": "我会的，我喜欢那样。没关系。即使"}, {"type": "subtitle", "time": 592.63, "timestamp": "00:09:52", "text": "你操纵别人，做些疯狂的事，你必须……"}, {"type": "subtitle", "time": 595.14, "timestamp": "00:09:55", "text": "遇见一位现实生活中的天使"}, {"type": "subtitle", "time": 598.07, "timestamp": "00:09:58", "text": "[音乐]"}]
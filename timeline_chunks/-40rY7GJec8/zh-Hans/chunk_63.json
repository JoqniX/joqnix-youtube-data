[{"type": "subtitle", "time": 3780.04, "timestamp": "01:03:00", "text": "女士，请冷静。"}, {"type": "subtitle", "time": 3793.829, "timestamp": "01:03:13", "text": "有点累了。我有点累了。摇晃。"}, {"type": "subtitle", "time": 3796.95, "timestamp": "01:03:16", "text": "是的，你应该睡觉了。我觉得我"}, {"type": "subtitle", "time": 3803.67, "timestamp": "01:03:23", "text": "酒精比鸭子更糟糕。"}, {"type": "subtitle", "time": 3805.95, "timestamp": "01:03:25", "text": "观点。"}, {"type": "subtitle", "time": 3807.029, "timestamp": "01:03:27", "text": "[音乐]"}, {"type": "subtitle", "time": 3808.63, "timestamp": "01:03:28", "text": "是的，你应该睡到明天。"}, {"type": "subtitle", "time": 3810.87, "timestamp": "01:03:30", "text": "是的，"}, {"type": "subtitle", "time": 3819.67, "timestamp": "01:03:39", "text": "我睡不着。我进入的那一刻"}, {"type": "subtitle", "time": 3821.43, "timestamp": "01:03:41", "text": "床，所有这些空洞都涌了回来。"}, {"type": "subtitle", "time": 3824.549, "timestamp": "01:03:44", "text": "大部头书。哦，不。我想我只能祈祷了。"}, {"type": "subtitle", "time": 3827.829, "timestamp": "01:03:47", "text": "其他提名，然后他们就可以获得"}, {"type": "subtitle", "time": 3829.349, "timestamp": "01:03:49", "text": "失眠症"}, {"type": "subtitle", "time": 3831.91, "timestamp": "01:03:51", "text": "今晚我可以睡个好觉了。哦不，"}, {"type": "subtitle", "time": 3834.39, "timestamp": "01:03:54", "text": "那很糟糕。"}, {"type": "subtitle", "time": 3837.109, "timestamp": "01:03:57", "text": "我将成为守护天使。昏昏欲睡的攀登"}]
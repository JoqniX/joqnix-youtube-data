[{"type": "subtitle", "time": 8042.55, "timestamp": "02:14:02", "text": "想想，如果动漫没看到这一点呢？"}, {"type": "subtitle", "time": 8044.79, "timestamp": "02:14:04", "text": "你以为这就够了吗？就像我们"}, {"type": "subtitle", "time": 8048.95, "timestamp": "02:14:08", "text": "这么简单，你们都给我点儿脂肪。"}, {"type": "subtitle", "time": 8050.79, "timestamp": "02:14:10", "text": "不。"}, {"type": "subtitle", "time": 8053.49, "timestamp": "02:14:13", "text": "因爱。"}, {"type": "subtitle", "time": 8060.55, "timestamp": "02:14:20", "text": "[音乐]"}, {"type": "subtitle", "time": 8063.75, "timestamp": "02:14:23", "text": "好的。呃，"}, {"type": "subtitle", "time": 8067.51, "timestamp": "02:14:27", "text": "如何获取秘密文本。"}, {"type": "subtitle", "time": 8069.589, "timestamp": "02:14:29", "text": "好的。我们的好感度就是这样。"}, {"type": "subtitle", "time": 8072.59, "timestamp": "02:14:32", "text": "所以我相信"}, {"type": "subtitle", "time": 8074.55, "timestamp": "02:14:34", "text": "[音乐]"}, {"type": "subtitle", "time": 8081.03, "timestamp": "02:14:41", "text": "让我们来看看。"}, {"type": "subtitle", "time": 8084.34, "timestamp": "02:14:44", "text": "人们都在议论我。"}, {"type": "subtitle", "time": 8092.229, "timestamp": "02:14:52", "text": "不，我现在正在录这个视频。"}]
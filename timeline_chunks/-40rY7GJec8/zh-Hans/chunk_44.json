[{"type": "subtitle", "time": 2640.23, "timestamp": "00:44:00", "text": "我们今天要经历这件事吗？"}, {"type": "subtitle", "time": 2644.32, "timestamp": "00:44:04", "text": "他为什么看起来这么疲惫？"}, {"type": "subtitle", "time": 2648.55, "timestamp": "00:44:08", "text": "[音乐]"}, {"type": "subtitle", "time": 2655.91, "timestamp": "00:44:15", "text": "我会删除那条评论。寻求帮助。"}, {"type": "subtitle", "time": 2657.829, "timestamp": "00:44:17", "text": "好的。"}, {"type": "subtitle", "time": 2664.309, "timestamp": "00:44:24", "text": "只是存在"}, {"type": "subtitle", "time": 2667.03, "timestamp": "00:44:27", "text": "这就足够了。"}, {"type": "subtitle", "time": 2669.349, "timestamp": "00:44:29", "text": "我女朋友嫁给了我。来了"}, {"type": "subtitle", "time": 2674.87, "timestamp": "00:44:34", "text": "你管它叫什么？你做什么？"}, {"type": "subtitle", "time": 2677.829, "timestamp": "00:44:37", "text": "你是说失业吗？我是失业者吗？不。"}, {"type": "subtitle", "time": 2681.109, "timestamp": "00:44:41", "text": "Angel是失业者吗？"}, {"type": "subtitle", "time": 2683.95, "timestamp": "00:44:43", "text": "你比我们任何人都努力。"}, {"type": "subtitle", "time": 2689.27, "timestamp": "00:44:49", "text": "[音乐]"}, {"type": "subtitle", "time": 2691.03, "timestamp": "00:44:51", "text": "我讨厌别人告诉我，活着本身就是一种价值。"}]
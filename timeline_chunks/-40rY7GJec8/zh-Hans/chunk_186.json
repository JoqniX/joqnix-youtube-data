[{"type": "subtitle", "time": 11161.59, "timestamp": "03:06:01", "text": "呃"}, {"type": "subtitle", "time": 11164.87, "timestamp": "03:06:04", "text": "是的，激励我尽我所能，就像这样"}, {"type": "subtitle", "time": 11167.91, "timestamp": "03:06:07", "text": "那。但问题又出现了。"}, {"type": "subtitle", "time": 11169.67, "timestamp": "03:06:09", "text": "的"}, {"type": "subtitle", "time": 11173.67, "timestamp": "03:06:13", "text": "你在游戏中看到的，就是如何"}, {"type": "subtitle", "time": 11177.59, "timestamp": "03:06:17", "text": "专一的爱，呃，专一的。"}, {"type": "subtitle", "time": 11180.07, "timestamp": "03:06:20", "text": "安琪儿爱着班"}, {"type": "subtitle", "time": 11183.99, "timestamp": "03:06:23", "text": "但她也没有试图给予"}, {"type": "subtitle", "time": 11188.23, "timestamp": "03:06:28", "text": "任何规格，任何特定查看器，例如"}, {"type": "subtitle", "time": 11190.23, "timestamp": "03:06:30", "text": "她倾注了爱与表达，但她把它给了"}, {"type": "subtitle", "time": 11193.59, "timestamp": "03:06:33", "text": "每个人都在那条性感的小溪里"}, {"type": "subtitle", "time": 11198.23, "timestamp": "03:06:38", "text": "我们当时也做了些什么？如果你注意到了，"}, {"type": "subtitle", "time": 11200.23, "timestamp": "03:06:40", "text": "不是那一个，但我认为它是其中一个。"}, {"type": "subtitle", "time": 11202.87, "timestamp": "03:06:42", "text": "第一个之类的。"}, {"type": "subtitle", "time": 11204.87, "timestamp": "03:06:44", "text": "哦，就像那条推文之类的。是的。"}, {"type": "subtitle", "time": 11208.87, "timestamp": "03:06:48", "text": "是的。是的。忘了。是的。"}, {"type": "subtitle", "time": 11211.51, "timestamp": "03:06:51", "text": "呃"}, {"type": "subtitle", "time": 11216.07, "timestamp": "03:06:56", "text": "嗯，是的。所以主要是，呃，就像……"}]
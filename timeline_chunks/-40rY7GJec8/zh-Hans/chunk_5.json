[{"type": "subtitle", "time": 301.51, "timestamp": "00:05:01", "text": "我为什么会点击它？啊，"}, {"type": "subtitle", "time": 304.23, "timestamp": "00:05:04", "text": "整夜待在夜里"}, {"type": "subtitle", "time": 306.629, "timestamp": "00:05:06", "text": "天堂。"}, {"type": "subtitle", "time": 309.27, "timestamp": "00:05:09", "text": "我每晚都向K天使祈祷。她是我的"}, {"type": "subtitle", "time": 311.909, "timestamp": "00:05:11", "text": "女神。我的天啊。"}, {"type": "subtitle", "time": 316.71, "timestamp": "00:05:16", "text": "这就是舔狗的说法吗？我的天哪。"}, {"type": "subtitle", "time": 319.749, "timestamp": "00:05:19", "text": "我给这次约会打10分（满分10分）。哈基是"}, {"type": "subtitle", "time": 321.11, "timestamp": "00:05:21", "text": "真有趣。很多人认为"}, {"type": "subtitle", "time": 323.189, "timestamp": "00:05:23", "text": "穿衣打扮也"}, {"type": "subtitle", "time": 327.029, "timestamp": "00:05:27", "text": "但却是某种特质。嗯哼。 A. 所以，谢谢你"}, {"type": "subtitle", "time": 329.029, "timestamp": "00:05:29", "text": "帮我选卡。呃，我要走了"}, {"type": "subtitle", "time": 331.029, "timestamp": "00:05:31", "text": "向我的鼻子展示我有多好看"}, {"type": "subtitle", "time": 335.189, "timestamp": "00:05:35", "text": "今晚。可爱的"}, {"type": "subtitle", "time": 338.07, "timestamp": "00:05:38", "text": "出去玩棒棒糖守门员。哦，我尽力了"}, {"type": "subtitle", "time": 340.95, "timestamp": "00:05:40", "text": "棒棒糖戈利塔。我的天哪，是"}, {"type": "subtitle", "time": 344.68, "timestamp": "00:05:44", "text": "夜幕降临。等等，什么？"}, {"type": "subtitle", "time": 346.629, "timestamp": "00:05:46", "text": "[音乐]"}, {"type": "subtitle", "time": 348.23, "timestamp": "00:05:48", "text": "我该不该去别的地方呢？"}, {"type": "subtitle", "time": 353.35, "timestamp": "00:05:53", "text": "为了一个目标跟女孩们争吵是不值得的。"}, {"type": "subtitle", "time": 356.31, "timestamp": "00:05:56", "text": "去？"}]
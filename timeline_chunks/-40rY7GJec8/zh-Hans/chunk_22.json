[{"type": "subtitle", "time": 1330.39, "timestamp": "00:22:10", "text": "[音乐]"}, {"type": "subtitle", "time": 1338.549, "timestamp": "00:22:18", "text": "其实我很喜欢户外活动。是的，"}, {"type": "subtitle", "time": 1352.549, "timestamp": "00:22:32", "text": "但你知道最奇怪的是什么吗？全部"}, {"type": "subtitle", "time": 1354.39, "timestamp": "00:22:34", "text": "伙计们，他们是……他们是一些书呆子。"}, {"type": "subtitle", "time": 1356.63, "timestamp": "00:22:36", "text": "有点不一样，但很多女孩都这样"}, {"type": "subtitle", "time": 1358.549, "timestamp": "00:22:38", "text": "它们真的很漂亮，因为它们要么"}, {"type": "subtitle", "time": 1360.87, "timestamp": "00:22:40", "text": "在他们称之为唱歌咖啡馆的地方工作，或者"}, {"type": "subtitle", "time": 1364.23, "timestamp": "00:22:44", "text": "要么是某种类型的，要么他们是独立音乐人。"}, {"type": "subtitle", "time": 1370.23, "timestamp": "00:22:50", "text": "主意。得到"}, {"type": "subtitle", "time": 1371.75, "timestamp": "00:22:51", "text": "这次直播一场比赛。我买了一些"}, {"type": "subtitle", "time": 1373.669, "timestamp": "00:22:53", "text": "老玩家会喜欢的游戏。"}, {"type": "subtitle", "time": 1375.27, "timestamp": "00:22:55", "text": "毕竟，他们看到的一切都来自……"}, {"type": "subtitle", "time": 1378.07, "timestamp": "00:22:58", "text": "一代人，他们会跳下去。劳奥。"}]
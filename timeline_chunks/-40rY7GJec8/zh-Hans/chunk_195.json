[{"type": "subtitle", "time": 11702.309, "timestamp": "03:15:02", "text": "因为是Twitch的合作推广项目，呃"}, {"type": "subtitle", "time": 11704.07, "timestamp": "03:15:04", "text": "地位。"}, {"type": "subtitle", "time": 11707.03, "timestamp": "03:15:07", "text": "但即便如此，我仍然……"}, {"type": "subtitle", "time": 11710.229, "timestamp": "03:15:10", "text": "白天，我想"}, {"type": "subtitle", "time": 11713.75, "timestamp": "03:15:13", "text": "呃，我的意思是，我不希望人们……"}, {"type": "subtitle", "time": 11715.67, "timestamp": "03:15:15", "text": "宠爱我，比如给我寄钱什么的。"}, {"type": "subtitle", "time": 11720.87, "timestamp": "03:15:20", "text": "因为那天，嗯，当我……的时候"}, {"type": "subtitle", "time": 11723.99, "timestamp": "03:15:23", "text": "我得到了神奇的蛤蜊效果。"}, {"type": "subtitle", "time": 11726.63, "timestamp": "03:15:26", "text": "它被命名为那次事件。哦，稍等一下。莫莉"}, {"type": "subtitle", "time": 11728.389, "timestamp": "03:15:28", "text": "嗯，你好。欢迎，欢迎。如何"}, {"type": "subtitle", "time": 11730.229, "timestamp": "03:15:30", "text": "你今天找到我，你好吗？希望"}, {"type": "subtitle", "time": 11732.71, "timestamp": "03:15:32", "text": "你做得很好。我们刚刚结束了……"}, {"type": "subtitle", "time": 11735.99, "timestamp": "03:15:35", "text": "玩得……嗯，我们没有完成。"}, {"type": "subtitle", "time": 11738.55, "timestamp": "03:15:38", "text": "游戏结束了，但我们确实……呃，也结束了"}, {"type": "subtitle", "time": 11740.95, "timestamp": "03:15:40", "text": "今天我们玩的游戏是"}, {"type": "subtitle", "time": 11743.03, "timestamp": "03:15:43", "text": "经常播放需要直播的内容"}, {"type": "subtitle", "time": 11744.309, "timestamp": "03:15:44", "text": "我们现在正在做一件就像……"}, {"type": "subtitle", "time": 11747.03, "timestamp": "03:15:47", "text": "聊天环节，我们谈论的是"}, {"type": "subtitle", "time": 11750.07, "timestamp": "03:15:50", "text": "游戏以及所有与流媒体相关的内容"}, {"type": "subtitle", "time": 11752.87, "timestamp": "03:15:52", "text": "东西。所以，希望你一切都好。"}, {"type": "subtitle", "time": 11755.75, "timestamp": "03:15:55", "text": "天。今天你是怎么找到我的？希望"}, {"type": "subtitle", "time": 11757.91, "timestamp": "03:15:57", "text": "你做得很好。"}]
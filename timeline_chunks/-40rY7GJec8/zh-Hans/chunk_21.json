[{"type": "subtitle", "time": 1260.71, "timestamp": "00:21:00", "text": "我可以把头传给她吗？不。"}, {"type": "subtitle", "time": 1264.63, "timestamp": "00:21:04", "text": "明天再去。你好。"}, {"type": "subtitle", "time": 1266.149, "timestamp": "00:21:06", "text": "该怎么办？我打算做一个"}, {"type": "subtitle", "time": 1267.75, "timestamp": "00:21:07", "text": "亚马逊愿望清单。我应该写些什么呢？"}, {"type": "subtitle", "time": 1269.75, "timestamp": "00:21:09", "text": "在？"}, {"type": "subtitle", "time": 1271.59, "timestamp": "00:21:11", "text": "劣质炸弹。"}, {"type": "subtitle", "time": 1273.02, "timestamp": "00:21:13", "text": "什么？"}, {"type": "subtitle", "time": 1274.63, "timestamp": "00:21:14", "text": "[音乐]"}, {"type": "subtitle", "time": 1276.23, "timestamp": "00:21:16", "text": "非洲裔。等待。不。就是这样。"}, {"type": "subtitle", "time": 1279.19, "timestamp": "00:21:19", "text": "可疑的。这很可疑。不，别像个18岁的孩子。"}, {"type": "subtitle", "time": 1282.95, "timestamp": "00:21:22", "text": "以及主播。随便说一句，一美元。为什么"}, {"type": "subtitle", "time": 1286.31, "timestamp": "00:21:26", "text": "你想推18次"}, {"type": "subtitle", "time": 1288.149, "timestamp": "00:21:28", "text": "服装？"}, {"type": "subtitle", "time": 1291.029, "timestamp": "00:21:31", "text": "我会把它写下来。"}, {"type": "subtitle", "time": 1305.59, "timestamp": "00:21:45", "text": "可惜的是，这里没什么emo。"}, {"type": "subtitle", "time": 1309.83, "timestamp": "00:21:49", "text": "表情符号贴纸。这边。"}, {"type": "subtitle", "time": 1313.11, "timestamp": "00:21:53", "text": "所以，这是痛苦。"}, {"type": "subtitle", "time": 1316.47, "timestamp": "00:21:56", "text": "这次我们出去吧，去……"}]
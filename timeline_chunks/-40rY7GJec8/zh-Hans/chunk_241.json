[{"type": "subtitle", "time": 14462.63, "timestamp": "04:01:02", "text": "远离我，把我储存起来，就像喜欢一样"}, {"type": "subtitle", "time": 14465.269, "timestamp": "04:01:05", "text": "就像人们想要囤货一样，对吧？呃"}, {"type": "subtitle", "time": 14468.15, "timestamp": "04:01:08", "text": "他们可能会得到奖励之类的。我"}, {"type": "subtitle", "time": 14471.51, "timestamp": "04:01:11", "text": "不知道。我甚至还做了大约21个复活节彩蛋"}, {"type": "subtitle", "time": 14474.309, "timestamp": "04:01:14", "text": "我的服务器里有鸡蛋，但只有一个人"}, {"type": "subtitle", "time": 14476.95, "timestamp": "04:01:16", "text": "找到一个复活节彩蛋。我就像……"}, {"type": "subtitle", "time": 14478.63, "timestamp": "04:01:18", "text": "你要去谁那里找到所有的"}, {"type": "subtitle", "time": 14487.189, "timestamp": "04:01:27", "text": "我以前写过所有那些同人小说"}, {"type": "subtitle", "time": 14489.349, "timestamp": "04:01:29", "text": "我只是想说，如果你需要帮助的话。"}, {"type": "subtitle", "time": 14492.07, "timestamp": "04:01:32", "text": "粉丝"}, {"type": "subtitle", "time": 14494.95, "timestamp": "04:01:34", "text": "真好，我想要像莫妮卡那样。"}, {"type": "subtitle", "time": 14498.309, "timestamp": "04:01:38", "text": "Chama在doili宝藏俱乐部说，是"}, {"type": "subtitle", "time": 14501.269, "timestamp": "04:01:41", "text": "最好从小处着手，所以我需要开始。"}, {"type": "subtitle", "time": 14503.269, "timestamp": "04:01:43", "text": "选择小的而不是大的"}, {"type": "subtitle", "time": 14505.349, "timestamp": "04:01:45", "text": "那就像进入人生小说的世界一样"}, {"type": "subtitle", "time": 14509.349, "timestamp": "04:01:49", "text": "史诗般的奇幻故事。我应该从小处着手。"}, {"type": "subtitle", "time": 14511.83, "timestamp": "04:01:51", "text": "比如诗歌或同人小说，然后进入"}, {"type": "subtitle", "time": 14514.63, "timestamp": "04:01:54", "text": "最重要的事。我想应该从小处着手。"}, {"type": "subtitle", "time": 14519.189, "timestamp": "04:01:59", "text": "那就大胆去做。我需要呃，用那个"}]
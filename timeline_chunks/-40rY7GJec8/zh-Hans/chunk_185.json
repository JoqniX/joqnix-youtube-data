[{"type": "subtitle", "time": 11100.15, "timestamp": "03:05:00", "text": "重要的是主播如何处理"}, {"type": "subtitle", "time": 11105.03, "timestamp": "03:05:05", "text": "在类似的情况下，他们"}, {"type": "subtitle", "time": 11108.63, "timestamp": "03:05:08", "text": "这样做是为了保持一切正常和平等。"}, {"type": "subtitle", "time": 11111.349, "timestamp": "03:05:11", "text": "并且保持一样的态度，并向那些人保证"}, {"type": "subtitle", "time": 11114.389, "timestamp": "03:05:14", "text": "老观众，老观众，什么都没有"}, {"type": "subtitle", "time": 11116.23, "timestamp": "03:05:16", "text": "将会改变，并吸引新的观众"}, {"type": "subtitle", "time": 11118.95, "timestamp": "03:05:18", "text": "一切都不会改变。他们是"}, {"type": "subtitle", "time": 11121.11, "timestamp": "03:05:21", "text": "他们会做他们自己，而且会是"}, {"type": "subtitle", "time": 11123.51, "timestamp": "03:05:23", "text": "就是这样。即使数据摆在那里"}, {"type": "subtitle", "time": 11126.309, "timestamp": "03:05:26", "text": "也就是说，即使数字是"}, {"type": "subtitle", "time": 11129.269, "timestamp": "03:05:29", "text": "更大的事情也会如此，就像"}, {"type": "subtitle", "time": 11132.55, "timestamp": "03:05:32", "text": "诸如此类的事情"}, {"type": "subtitle", "time": 11137.349, "timestamp": "03:05:37", "text": "在某种程度上，那些时刻就像"}, {"type": "subtitle", "time": 11139.75, "timestamp": "03:05:39", "text": "对我来说，这更像是一个激励人心的时刻。"}, {"type": "subtitle", "time": 11142.63, "timestamp": "03:05:42", "text": "那次，但那件事，我想我做过"}, {"type": "subtitle", "time": 11146.15, "timestamp": "03:05:46", "text": "就像两次12小时的直播，而且我一直保持着"}, {"type": "subtitle", "time": 11149.349, "timestamp": "03:05:49", "text": "我给自己施加压力，告诉自己，是的，我也是"}, {"type": "subtitle", "time": 11151.99, "timestamp": "03:05:51", "text": "那段时间，我得尽力而为。"}, {"type": "subtitle", "time": 11155.91, "timestamp": "03:05:55", "text": "看到他们走开，就像你知道的那样"}, {"type": "subtitle", "time": 11159.59, "timestamp": "03:05:59", "text": "他们做到了最好。我也深受启发"}]
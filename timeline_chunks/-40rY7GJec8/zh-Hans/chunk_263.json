[{"type": "subtitle", "time": 15780.07, "timestamp": "04:23:00", "text": "关于游戏，以及在游戏中等等"}, {"type": "subtitle", "time": 15782.07, "timestamp": "04:23:02", "text": "一切。谢谢。真的"}, {"type": "subtitle", "time": 15786.71, "timestamp": "04:23:06", "text": "意义重大。今天亚山也来了。"}, {"type": "subtitle", "time": 15788.95, "timestamp": "04:23:08", "text": "感谢您今天光临。希望你喜欢"}, {"type": "subtitle", "time": 15795.83, "timestamp": "04:23:15", "text": "[音乐]"}, {"type": "subtitle", "time": 15798.55, "timestamp": "04:23:18", "text": "谢谢。谢谢"}, {"type": "subtitle", "time": 15800.79, "timestamp": "04:23:20", "text": "感谢您的光临。希望你今天过得愉快。"}, {"type": "subtitle", "time": 15803.83, "timestamp": "04:23:23", "text": "等待。呃，我错过了什么吗？"}, {"type": "subtitle", "time": 15806.469, "timestamp": "04:23:26", "text": "亚什？让我再看看他的消息。"}, {"type": "subtitle", "time": 15813.189, "timestamp": "04:23:33", "text": "为什么我总觉得好像错过了什么？"}, {"type": "subtitle", "time": 15817.349, "timestamp": "04:23:37", "text": "来自 Yash 的 Yash 今天。"}, {"type": "subtitle", "time": 15819.03, "timestamp": "04:23:39", "text": "哦，对，你当时在偷看别人。"}, {"type": "subtitle", "time": 15821.269, "timestamp": "04:23:41", "text": "正确的？你还给别人戴了个发条。好工作"}, {"type": "subtitle", "time": 15825.269, "timestamp": "04:23:45", "text": "就此而言。干得好，干得好，干得好。"}, {"type": "subtitle", "time": 15827.349, "timestamp": "04:23:47", "text": "过来一下。好，好，好。是啊是啊，"}, {"type": "subtitle", "time": 15828.95, "timestamp": "04:23:48", "text": "是的。"}, {"type": "subtitle", "time": 15831.75, "timestamp": "04:23:51", "text": "是啊，拜托。"}, {"type": "subtitle", "time": 15833.75, "timestamp": "04:23:53", "text": "如何才能使这些不属于他的清白呢？"}, {"type": "subtitle", "time": 15836.07, "timestamp": "04:23:56", "text": "渐渐消失。哦，是的，我不小心这么做了。"}]
[{"type": "subtitle", "time": 12540.63, "timestamp": "03:29:00", "text": "如何与他人沟通"}, {"type": "subtitle", "time": 12543.91, "timestamp": "03:29:03", "text": "在风险投资公司里交谈，并且喜欢学习"}, {"type": "subtitle", "time": 12545.75, "timestamp": "03:29:05", "text": "就像我之前多次提到的那样，对吧？"}, {"type": "subtitle", "time": 12549.59, "timestamp": "03:29:09", "text": "学到了很多关于情绪方面的东西，比如"}, {"type": "subtitle", "time": 12554.309, "timestamp": "03:29:14", "text": "感觉既快乐又悲伤"}, {"type": "subtitle", "time": 12558.309, "timestamp": "03:29:18", "text": "就像嫉妒，就像……抱负……"}, {"type": "subtitle", "time": 12560.79, "timestamp": "03:29:20", "text": "就像激励自己做到最好、努力奋斗一样"}, {"type": "subtitle", "time": 12564.15, "timestamp": "03:29:24", "text": "努力做到最好，并且喜欢"}, {"type": "subtitle", "time": 12567.51, "timestamp": "03:29:27", "text": "同理心和同情心之类的东西"}, {"type": "subtitle", "time": 12570.389, "timestamp": "03:29:30", "text": "我想我永远不会，我不会。"}, {"type": "subtitle", "time": 12572.95, "timestamp": "03:29:32", "text": "我想我将来可能会很长一段时间，如果我……"}, {"type": "subtitle", "time": 12575.269, "timestamp": "03:29:35", "text": "我以前对直播不感兴趣，也不喜欢……"}, {"type": "subtitle", "time": 12577.349, "timestamp": "03:29:37", "text": "没有通过其他方式进行流媒体播放。"}, {"type": "subtitle", "time": 12580.309, "timestamp": "03:29:40", "text": "我可能认识某个我不认识的人，但是"}, {"type": "subtitle", "time": 12582.71, "timestamp": "03:29:42", "text": "我很高兴，我很高兴我最终做到了。"}, {"type": "subtitle", "time": 12585.75, "timestamp": "03:29:45", "text": "现在就通过这段旅程来体验这一切吧"}, {"type": "subtitle", "time": 12589.91, "timestamp": "03:29:49", "text": "作为一个运动员，我感觉自己像个傻瓜。"}, {"type": "subtitle", "time": 12592.229, "timestamp": "03:29:52", "text": "能够表达和了解这些"}, {"type": "subtitle", "time": 12595.03, "timestamp": "03:29:55", "text": "情绪。我能够知道我应该做什么。"}, {"type": "subtitle", "time": 12597.11, "timestamp": "03:29:57", "text": "当发生这类事情时应该怎么做？"}]
[{"type": "subtitle", "time": 6840.229, "timestamp": "01:54:00", "text": "尽你所能，活出精彩人生。"}, {"type": "subtitle", "time": 6844.149, "timestamp": "01:54:04", "text": "这说法太笼统了。我的天啊。"}, {"type": "subtitle", "time": 6846.629, "timestamp": "01:54:06", "text": "我感觉自己完全不在状态，跟不上这份文件。我"}, {"type": "subtitle", "time": 6848.709, "timestamp": "01:54:08", "text": "感觉我还能继续下去。潘相信"}, {"type": "subtitle", "time": 6850.709, "timestamp": "01:54:10", "text": "我。我有时候会特别固执己见。"}, {"type": "subtitle", "time": 6853.189, "timestamp": "01:54:13", "text": "但正是在这个时候。但我记得"}, {"type": "subtitle", "time": 6863.189, "timestamp": "01:54:23", "text": "我的天哪。如果她不小心发了推文怎么办？"}, {"type": "subtitle", "time": 6866.41, "timestamp": "01:54:26", "text": "另一个呢？"}, {"type": "subtitle", "time": 6868.47, "timestamp": "01:54:28", "text": "[音乐]"}, {"type": "subtitle", "time": 6871.589, "timestamp": "01:54:31", "text": "我的订阅用户达到了10万。这是我的"}, {"type": "subtitle", "time": 6873.03, "timestamp": "01:54:33", "text": "这是第一次触达这么多人。我不"}, {"type": "subtitle", "time": 6875.51, "timestamp": "01:54:35", "text": "知道接下来会发生什么"}, {"type": "subtitle", "time": 6877.99, "timestamp": "01:54:37", "text": "这里。我有点紧张。我感觉"}, {"type": "subtitle", "time": 6880.709, "timestamp": "01:54:40", "text": "很高兴看到我的数据上升。我知道我是"}, {"type": "subtitle", "time": 6882.31, "timestamp": "01:54:42", "text": "总是抱怨没有和"}, {"type": "subtitle", "time": 6883.669, "timestamp": "01:54:43", "text": "东西，但如果没有这些东西，我就不会在这里。"}, {"type": "subtitle", "time": 6886.55, "timestamp": "01:54:46", "text": "他们的支持与命运。一个"}, {"type": "subtitle", "time": 6888.55, "timestamp": "01:54:48", "text": "感谢他们的奉献。就是他们"}, {"type": "subtitle", "time": 6890.39, "timestamp": "01:54:50", "text": "那把我从网上举报了。我需要"}, {"type": "subtitle", "time": 6893.35, "timestamp": "01:54:53", "text": "去见天使。哦，"}, {"type": "subtitle", "time": 6894.79, "timestamp": "01:54:54", "text": "接下来我要谈谈……"}, {"type": "subtitle", "time": 6896.87, "timestamp": "01:54:56", "text": "上网，试着说说我离目标有多远。"}, {"type": "subtitle", "time": 6899.51, "timestamp": "01:54:59", "text": "我支持他们所有人。"}]
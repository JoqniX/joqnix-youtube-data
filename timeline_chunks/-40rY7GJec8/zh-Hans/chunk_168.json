[{"type": "subtitle", "time": 10081.83, "timestamp": "02:48:01", "text": "人们喜欢他，是因为他……"}, {"type": "subtitle", "time": 10084.309, "timestamp": "02:48:04", "text": "他为人谦逊，并想退款。"}, {"type": "subtitle", "time": 10087.99, "timestamp": "02:48:07", "text": "感谢大家送他订阅和其他东西"}, {"type": "subtitle", "time": 10090.23, "timestamp": "02:48:10", "text": "比如用字幕之类的东西"}, {"type": "subtitle", "time": 10092.469, "timestamp": "02:48:12", "text": "Twitch 就是这样，别这样。"}, {"type": "subtitle", "time": 10094.23, "timestamp": "02:48:14", "text": "在流媒体方面贪婪"}, {"type": "subtitle", "time": 10095.59, "timestamp": "02:48:15", "text": "是的，一切都在那里，就像我说的那样。"}, {"type": "subtitle", "time": 10097.19, "timestamp": "02:48:17", "text": "有两种人，一种是……"}, {"type": "subtitle", "time": 10099.99, "timestamp": "02:48:19", "text": "完全出于热爱，而且只有一个人会去做。"}, {"type": "subtitle", "time": 10103.75, "timestamp": "02:48:23", "text": "为了好玩，还有一点就是"}, {"type": "subtitle", "time": 10105.59, "timestamp": "02:48:25", "text": "呃"}, {"type": "subtitle", "time": 10107.349, "timestamp": "02:48:27", "text": "等等，呃，对，还有那个，但我当时"}, {"type": "subtitle", "time": 10109.19, "timestamp": "02:48:29", "text": "谈论鲁莽"}, {"type": "subtitle", "time": 10111.03, "timestamp": "02:48:31", "text": "照做。哦，是的。对，就是那个"}, {"type": "subtitle", "time": 10113.429, "timestamp": "02:48:33", "text": "出色地。是的，"}, {"type": "subtitle", "time": 10115.99, "timestamp": "02:48:35", "text": "我知道这个故事。是的。是的。是的。"}, {"type": "subtitle", "time": 10118.63, "timestamp": "02:48:38", "text": "你好，布拉德。你好吗？你好吗"}, {"type": "subtitle", "time": 10120.469, "timestamp": "02:48:40", "text": "正在做？是的，"}, {"type": "subtitle", "time": 10122.55, "timestamp": "02:48:42", "text": "你做得很好。我的天哪，那个"}, {"type": "subtitle", "time": 10124.95, "timestamp": "02:48:44", "text": "小鸭子。"}, {"type": "subtitle", "time": 10126.79, "timestamp": "02:48:46", "text": "是的。好的。呃，我需要把一些放回去。"}, {"type": "subtitle", "time": 10128.87, "timestamp": "02:48:48", "text": "在香烟里。"}, {"type": "subtitle", "time": 10132.389, "timestamp": "02:48:52", "text": "我的错。我的错。"}, {"type": "subtitle", "time": 10134.71, "timestamp": "02:48:54", "text": "所有人都捐出了面包。给"}, {"type": "subtitle", "time": 10138.389, "timestamp": "02:48:58", "text": "面包。 A：对，就是这样。"}]
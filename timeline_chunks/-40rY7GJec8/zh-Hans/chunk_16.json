[{"type": "subtitle", "time": 960.15, "timestamp": "00:16:00", "text": "我认识的一个人花了2000日元买了100个"}, {"type": "subtitle", "time": 961.749, "timestamp": "00:16:01", "text": "盛大"}, {"type": "subtitle", "time": 963.35, "timestamp": "00:16:03", "text": "每月一次。但他们已经给了"}, {"type": "subtitle", "time": 969.11, "timestamp": "00:16:09", "text": "我先计算一下日元汇率，然后再看看结果。"}, {"type": "subtitle", "time": 971.43, "timestamp": "00:16:11", "text": "什么？你打算向人们索要更多"}, {"type": "subtitle", "time": 974.069, "timestamp": "00:16:14", "text": "给你更多钱？什么？哦，你"}, {"type": "subtitle", "time": 977.749, "timestamp": "00:16:17", "text": "不应该那样做。等等，别这么做。"}, {"type": "subtitle", "time": 988.71, "timestamp": "00:16:28", "text": "[音乐]"}]
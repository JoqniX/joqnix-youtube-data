[{"type": "subtitle", "time": 15301.07, "timestamp": "04:15:01", "text": "再次"}, {"type": "subtitle", "time": 15302.55, "timestamp": "04:15:02", "text": "[音乐]"}, {"type": "subtitle", "time": 15306.469, "timestamp": "04:15:06", "text": "呃，对明年的承诺。"}, {"type": "subtitle", "time": 15309.51, "timestamp": "04:15:09", "text": "我不知道，我真的不想……"}, {"type": "subtitle", "time": 15313.67, "timestamp": "04:15:13", "text": "承诺。我知道自己2020年的工作，"}, {"type": "subtitle", "time": 15317.99, "timestamp": "04:15:17", "text": "2021年和2022年有很多前景广阔的工作机会。"}, {"type": "subtitle", "time": 15319.59, "timestamp": "04:15:19", "text": "但"}, {"type": "subtitle", "time": 15322.389, "timestamp": "04:15:22", "text": "我曾经首演过吗？不。我曾经有过吗？"}, {"type": "subtitle", "time": 15324.55, "timestamp": "04:15:24", "text": "到达"}, {"type": "subtitle", "time": 15327.189, "timestamp": "04:15:27", "text": "我想要达到的阶段或阶段？不，"}, {"type": "subtitle", "time": 15329.11, "timestamp": "04:15:29", "text": "还没有。我的工作已经开始了吗？"}, {"type": "subtitle", "time": 15332.149, "timestamp": "04:15:32", "text": "正在研究吗？还没有。"}, {"type": "subtitle", "time": 15335.91, "timestamp": "04:15:35", "text": "疼痛。是的，有很多事情我们"}, {"type": "subtitle", "time": 15339.67, "timestamp": "04:15:39", "text": "需要做。所以，没错，因为我就是那个人"}, {"type": "subtitle", "time": 15342.55, "timestamp": "04:15:42", "text": "谁应该包揽一切。我 我"}, {"type": "subtitle", "time": 15345.67, "timestamp": "04:15:45", "text": "我为什么要这样做？库兹"}, {"type": "subtitle", "time": 15347.91, "timestamp": "04:15:47", "text": "因为我见过一些 YouTuber 这样做。"}, {"type": "subtitle", "time": 15351.03, "timestamp": "04:15:51", "text": "一切都各自独立。看到他们"}, {"type": "subtitle", "time": 15353.03, "timestamp": "04:15:53", "text": "即使他们没有天赋，"}, {"type": "subtitle", "time": 15355.269, "timestamp": "04:15:55", "text": "他们仍然试图通过各种方式来完成这件事。"}, {"type": "subtitle", "time": 15357.349, "timestamp": "04:15:57", "text": "他们自己，但总会有那么一个时刻"}]
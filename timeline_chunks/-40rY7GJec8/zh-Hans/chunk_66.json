[{"type": "subtitle", "time": 3970.309, "timestamp": "01:06:10", "text": "我没有用过其他类似动漫的东西。"}, {"type": "subtitle", "time": 3972.71, "timestamp": "01:06:12", "text": "对我来说，最好的就是儿童偶像"}, {"type": "subtitle", "time": 3975.67, "timestamp": "01:06:15", "text": "动漫"}, {"type": "subtitle", "time": 3977.589, "timestamp": "01:06:17", "text": "偶像梦想的难处让我"}, {"type": "subtitle", "time": 3979.349, "timestamp": "01:06:19", "text": "有点难过，我不知道现实会怎样。"}, {"type": "subtitle", "time": 3980.87, "timestamp": "01:06:20", "text": "更重要的是多少钱。"}, {"type": "subtitle", "time": 3985.029, "timestamp": "01:06:25", "text": "你可以从风扇里挤出来"}, {"type": "subtitle", "time": 3987.19, "timestamp": "01:06:27", "text": "是的，从某种意义上说，这也是事实。"}, {"type": "subtitle", "time": 3989.99, "timestamp": "01:06:29", "text": "偶像之类的东西来了。"}, {"type": "subtitle", "time": 3992.47, "timestamp": "01:06:32", "text": "你榨干了所有脂肪，赚的钱"}, {"type": "subtitle", "time": 3995.349, "timestamp": "01:06:35", "text": "一切"}, {"type": "subtitle", "time": 3998.549, "timestamp": "01:06:38", "text": "那就是我。为什么世界是真实的"}, {"type": "subtitle", "time": 4004.63, "timestamp": "01:06:44", "text": "每一种魔法力量都蕴含着怎样的能量流淌？"}, {"type": "subtitle", "time": 4008.23, "timestamp": "01:06:48", "text": "还有希望和梦想。"}]
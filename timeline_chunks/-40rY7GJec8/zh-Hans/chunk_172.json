[{"type": "subtitle", "time": 10322.15, "timestamp": "02:52:02", "text": "就像突然冒出一些奇怪的感觉一样"}, {"type": "subtitle", "time": 10324.469, "timestamp": "02:52:04", "text": "嫉妒的感觉，感觉……"}, {"type": "subtitle", "time": 10326.63, "timestamp": "02:52:06", "text": "竞争力"}, {"type": "subtitle", "time": 10329.11, "timestamp": "02:52:09", "text": "还有一些其他的东西。如果那是某人"}, {"type": "subtitle", "time": 10331.349, "timestamp": "02:52:11", "text": "你喜欢看谁的表演，而且这也是"}, {"type": "subtitle", "time": 10333.67, "timestamp": "02:52:13", "text": "好友主播，你在哪里？"}, {"type": "subtitle", "time": 10336.87, "timestamp": "02:52:16", "text": "一旦你积极参与他们的聊天和其他活动，你"}, {"type": "subtitle", "time": 10340.87, "timestamp": "02:52:20", "text": "你开始比较它们，感觉如何？"}, {"type": "subtitle", "time": 10342.95, "timestamp": "02:52:22", "text": "你会对自己感到无比厌恶。"}, {"type": "subtitle", "time": 10346.63, "timestamp": "02:52:26", "text": "你不想去拜访他们"}, {"type": "subtitle", "time": 10350.469, "timestamp": "02:52:30", "text": "直播之类的东西"}, {"type": "subtitle", "time": 10352.95, "timestamp": "02:52:32", "text": "我知道你心里有这种感觉"}, {"type": "subtitle", "time": 10354.71, "timestamp": "02:52:34", "text": "坏的"}, {"type": "subtitle", "time": 10357.91, "timestamp": "02:52:37", "text": "当你观看的每一刻"}, {"type": "subtitle", "time": 10361.67, "timestamp": "02:52:41", "text": "朋友们开始直播，因为你开始……"}, {"type": "subtitle", "time": 10364.71, "timestamp": "02:52:44", "text": "比较太多，以至于无论你"}, {"type": "subtitle", "time": 10366.71, "timestamp": "02:52:46", "text": "不管他们怎么说，都无所谓"}, {"type": "subtitle", "time": 10369.59, "timestamp": "02:52:49", "text": "无论聊什么，他们都会提起某个话题。"}, {"type": "subtitle", "time": 10372.95, "timestamp": "02:52:52", "text": "他们的直播聊天室里都在说要……"}, {"type": "subtitle", "time": 10374.309, "timestamp": "02:52:54", "text": "主播，你比较的一切"}, {"type": "subtitle", "time": 10376.87, "timestamp": "02:52:56", "text": "一切都要与你自己的受众进行比较"}, {"type": "subtitle", "time": 10379.83, "timestamp": "02:52:59", "text": "一切都让你陷入困境"}]
[{"type": "subtitle", "time": 13560.95, "timestamp": "03:46:00", "text": "发送冗长的信息。它是"}, {"type": "subtitle", "time": 13563.269, "timestamp": "03:46:03", "text": "美好的。没关系。就好像是比利一样"}, {"type": "subtitle", "time": 13565.83, "timestamp": "03:46:05", "text": "比利或者别的什么人，那将会是"}, {"type": "subtitle", "time": 13568.389, "timestamp": "03:46:08", "text": "字数限制为20字。所以，你必须……"}, {"type": "subtitle", "time": 13570.63, "timestamp": "03:46:10", "text": "你不能输入真正的英文单词"}, {"type": "subtitle", "time": 13573.03, "timestamp": "03:46:13", "text": "那里。所以，是疼痛，对吧？就是这样。"}, {"type": "subtitle", "time": 13574.71, "timestamp": "03:46:14", "text": "没关系。没关系。别担心"}, {"type": "subtitle", "time": 13577.349, "timestamp": "03:46:17", "text": "它。"}, {"type": "subtitle", "time": 13579.91, "timestamp": "03:46:19", "text": "是的，你有可能就是其中之一。哪一个会"}, {"type": "subtitle", "time": 13583.51, "timestamp": "03:46:23", "text": "你是吗？我不知道。"}, {"type": "subtitle", "time": 13586.55, "timestamp": "03:46:26", "text": "可供选择的太多了。"}, {"type": "subtitle", "time": 13589.03, "timestamp": "03:46:29", "text": "什么不可能？为什么我不能……呃……所有的一切"}, {"type": "subtitle", "time": 13591.67, "timestamp": "03:46:31", "text": "他们之中？我想知道。我不知道。是的。"}, {"type": "subtitle", "time": 13594.07, "timestamp": "03:46:34", "text": "为什么我不能成为他们所有人？问题"}, {"type": "subtitle", "time": 13604.79, "timestamp": "03:46:44", "text": "但我好像还读了别的东西？"}, {"type": "subtitle", "time": 13612.71, "timestamp": "03:46:52", "text": "兄弟，现在，多打点字，然后继续吧。"}, {"type": "subtitle", "time": 13619.59, "timestamp": "03:46:59", "text": "我的天啊。"}]
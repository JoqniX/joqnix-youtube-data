[{"type": "subtitle", "time": 10020.63, "timestamp": "02:47:00", "text": "对，就像你看到那些需要帮助的主播一样。"}, {"type": "subtitle", "time": 10023.59, "timestamp": "02:47:03", "text": "就像Angel那样，她做得很好"}, {"type": "subtitle", "time": 10025.67, "timestamp": "02:47:05", "text": "想要100万订阅者"}, {"type": "subtitle", "time": 10027.67, "timestamp": "02:47:07", "text": "还有一些其他的东西。她贪婪无度，"}, {"type": "subtitle", "time": 10029.19, "timestamp": "02:47:09", "text": "贪婪的"}, {"type": "subtitle", "time": 10032.15, "timestamp": "02:47:12", "text": "诸如此类，对吧？"}, {"type": "subtitle", "time": 10035.11, "timestamp": "02:47:15", "text": "你最好去睡觉，小子。是的。是的。我"}, {"type": "subtitle", "time": 10038.79, "timestamp": "02:47:18", "text": "我需要……我需要……但我今天睡了很多。"}, {"type": "subtitle", "time": 10041.59, "timestamp": "02:47:21", "text": "但我认为我可能需要一个“是”。是的。我"}, {"type": "subtitle", "time": 10044.95, "timestamp": "02:47:24", "text": "需要休息一下。所以，"}, {"type": "subtitle", "time": 10047.349, "timestamp": "02:47:27", "text": "2020 年 Twitch 直播主播之一。"}, {"type": "subtitle", "time": 10049.83, "timestamp": "02:47:29", "text": "是的。是的。是的。我记得这件事。这"}, {"type": "subtitle", "time": 10052.71, "timestamp": "02:47:32", "text": "那个问过这个问题的直播女孩"}, {"type": "subtitle", "time": 10056.71, "timestamp": "02:47:36", "text": "想捐款给你，为什么不能捐款？"}, {"type": "subtitle", "time": 10059.269, "timestamp": "02:47:39", "text": "你至少捐了10美元，至少你在看。"}, {"type": "subtitle", "time": 10061.59, "timestamp": "02:47:41", "text": "免费给我之类的，对吧？"}, {"type": "subtitle", "time": 10063.59, "timestamp": "02:47:43", "text": "然后，比较结果就出来了。"}, {"type": "subtitle", "time": 10067.51, "timestamp": "02:47:47", "text": "在那之间，嗯，那，那个男性"}, {"type": "subtitle", "time": 10069.75, "timestamp": "02:47:49", "text": "一位正在进行木雕表演的主播"}, {"type": "subtitle", "time": 10073.91, "timestamp": "02:47:53", "text": "甚至有些总统也参与其中。"}, {"type": "subtitle", "time": 10076.07, "timestamp": "02:47:56", "text": "就像副总统之类的人来了"}, {"type": "subtitle", "time": 10079.59, "timestamp": "02:47:59", "text": "通过与他们见面之类的，或者像这样"}]
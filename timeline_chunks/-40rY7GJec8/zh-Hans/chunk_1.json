[{"type": "subtitle", "time": 60.15, "timestamp": "00:01:00", "text": "那是什么？超级组。"}, {"type": "subtitle", "time": 63.99, "timestamp": "00:01:03", "text": "超级留言。你看上去像"}, {"type": "subtitle", "time": 68.149, "timestamp": "00:01:08", "text": "你太逊了，我的天哪。"}, {"type": "subtitle", "time": 70.71000000000001, "timestamp": "00:01:10", "text": "我不会读的。不知道是什么"}, {"type": "subtitle", "time": 72.39, "timestamp": "00:01:12", "text": "正在进行中。只要你玩得开心就好"}, {"type": "subtitle", "time": 74.23, "timestamp": "00:01:14", "text": "你自己。"}, {"type": "subtitle", "time": 84.95, "timestamp": "00:01:24", "text": "[音乐]"}, {"type": "subtitle", "time": 86.789, "timestamp": "00:01:26", "text": "等待。我为什么要删除它？我为什么会这样"}, {"type": "subtitle", "time": 96.22999999999999, "timestamp": "00:01:36", "text": "[音乐]"}, {"type": "subtitle", "time": 104.149, "timestamp": "00:01:44", "text": "真麻烦。我的天哪。她不能"}, {"type": "subtitle", "time": 112.03999999999999, "timestamp": "00:01:52", "text": "哦不，"}, {"type": "subtitle", "time": 115.67, "timestamp": "00:01:55", "text": "[音乐]"}, {"type": "subtitle", "time": 119.53, "timestamp": "00:01:59", "text": "那里有只狐狸。为什么要删除？我的天啊。"}]
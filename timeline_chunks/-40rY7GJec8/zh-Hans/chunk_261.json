[{"type": "subtitle", "time": 15660.95, "timestamp": "04:21:00", "text": "聊天。希望你希望我能做到"}, {"type": "subtitle", "time": 15668.71, "timestamp": "04:21:08", "text": "谢谢你像以往一样经常光顾"}, {"type": "subtitle", "time": 15671.429, "timestamp": "04:21:11", "text": "你开始了，你走向了新的方向，你"}, {"type": "subtitle", "time": 15674.55, "timestamp": "04:21:14", "text": "几乎每天都频繁出现"}, {"type": "subtitle", "time": 15676.389, "timestamp": "04:21:16", "text": "我所有的 YouTube 直播。所以这意味着"}, {"type": "subtitle", "time": 15689.11, "timestamp": "04:21:29", "text": "今天又来了。"}, {"type": "subtitle", "time": 15691.11, "timestamp": "04:21:31", "text": "我无法和你下棋。它是"}, {"type": "subtitle", "time": 15693.75, "timestamp": "04:21:33", "text": "美好的。而且你也不需要道歉。"}, {"type": "subtitle", "time": 15696.389, "timestamp": "04:21:36", "text": "昨天的事。你也可以"}, {"type": "subtitle", "time": 15699.11, "timestamp": "04:21:39", "text": "不能和我一起玩。"}, {"type": "subtitle", "time": 15704.229, "timestamp": "04:21:44", "text": "总会有下次我们一起玩的机会。"}, {"type": "subtitle", "time": 15706.79, "timestamp": "04:21:46", "text": "一起等等。"}, {"type": "subtitle", "time": 15709.03, "timestamp": "04:21:49", "text": "请告诉我结果。"}, {"type": "subtitle", "time": 15712.79, "timestamp": "04:21:52", "text": "我们可以玩玩或者做点别的，一起待着。"}, {"type": "subtitle", "time": 15714.95, "timestamp": "04:21:54", "text": "希望你过得愉快。也希望你……"}, {"type": "subtitle", "time": 15717.51, "timestamp": "04:21:57", "text": "祝你今天过得愉快，也祝你余下的时间愉快！"}, {"type": "subtitle", "time": 15719.67, "timestamp": "04:21:59", "text": "你的夜晚。"}]
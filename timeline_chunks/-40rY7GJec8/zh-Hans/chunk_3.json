[{"type": "subtitle", "time": 181.19, "timestamp": "00:03:01", "text": "[音乐]"}, {"type": "subtitle", "time": 183.11, "timestamp": "00:03:03", "text": "我的天哪，我简直不敢相信我不是我自己"}, {"type": "subtitle", "time": 187.27, "timestamp": "00:03:07", "text": "暂时先直播。"}, {"type": "subtitle", "time": 189.67, "timestamp": "00:03:09", "text": "但正因如此，我们才无法有所作为。"}, {"type": "subtitle", "time": 192.39, "timestamp": "00:03:12", "text": "三个中的三个"}, {"type": "subtitle", "time": 194.949, "timestamp": "00:03:14", "text": "好的，我们现在有点像……"}, {"type": "subtitle", "time": 197.99, "timestamp": "00:03:17", "text": "粉丝。好的，"}, {"type": "subtitle", "time": 199.589, "timestamp": "00:03:19", "text": "我们获得了一些粉丝，所以"}, {"type": "subtitle", "time": 202.63, "timestamp": "00:03:22", "text": "没关系。"}, {"type": "subtitle", "time": 206.47, "timestamp": "00:03:26", "text": "请通过电子邮件联系我，以便我能尽快回复您。"}, {"type": "subtitle", "time": 209.50900000000001, "timestamp": "00:03:29", "text": "房租，所以我现在就发给你，直到10点。"}, {"type": "subtitle", "time": 211.43, "timestamp": "00:03:31", "text": "全额支付。请将您的款项寄出。"}, {"type": "subtitle", "time": 213.589, "timestamp": "00:03:33", "text": "请查看下方账户详情并联系我们"}, {"type": "subtitle", "time": 219.03, "timestamp": "00:03:39", "text": "我。我的天啊，银行。哦，不。"}, {"type": "subtitle", "time": 222.63, "timestamp": "00:03:42", "text": "如果你这样做，就会发生这种情况。"}, {"type": "subtitle", "time": 226.789, "timestamp": "00:03:46", "text": "独自生活，还要缴纳税款。"}, {"type": "subtitle", "time": 228.71, "timestamp": "00:03:48", "text": "哦，不。"}, {"type": "subtitle", "time": 230.07, "timestamp": "00:03:50", "text": "那是不是意味着我们需要支付我们所有的……"}, {"type": "subtitle", "time": 233.27, "timestamp": "00:03:53", "text": "那时陆地会登陆吗？该死，我们穷得叮当响。做"}, {"type": "subtitle", "time": 236.59, "timestamp": "00:03:56", "text": "我们需要能够参与其中吗？"}, {"type": "subtitle", "time": 238.949, "timestamp": "00:03:58", "text": "[音乐]"}]
[{"type": "subtitle", "time": 6720.95, "timestamp": "01:52:00", "text": "等等，我在想如果我……会不会有人想念我。"}, {"type": "subtitle", "time": 6723.109, "timestamp": "01:52:03", "text": "如果他们不在了，他们就得看着。"}, {"type": "subtitle", "time": 6726.149, "timestamp": "01:52:06", "text": "他们不必这样做，他们可以观看。"}, {"type": "subtitle", "time": 6729.109, "timestamp": "01:52:09", "text": "决不"}, {"type": "subtitle", "time": 6731.75, "timestamp": "01:52:11", "text": "他们只是这么说而已。"}, {"type": "subtitle", "time": 6747.91, "timestamp": "01:52:27", "text": "我明白了。当然可以。"}, {"type": "subtitle", "time": 6759.43, "timestamp": "01:52:39", "text": "仿佛没有人希望事实像这样存在。"}, {"type": "subtitle", "time": 6769.189, "timestamp": "01:52:49", "text": "走。等待。感觉我不应该这样"}, {"type": "subtitle", "time": 6772.229, "timestamp": "01:52:52", "text": "允许。当然可以。"}, {"type": "subtitle", "time": 6775.99, "timestamp": "01:52:55", "text": "请活下去。等待。感觉我应该这么做。"}, {"type": "subtitle", "time": 6778.629, "timestamp": "01:52:58", "text": "当然可以。等待。哪个"}]
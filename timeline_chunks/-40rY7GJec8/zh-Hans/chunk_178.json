[{"type": "subtitle", "time": 10680.87, "timestamp": "02:58:00", "text": "她和一切都很好，但对我来说……"}, {"type": "subtitle", "time": 10683.03, "timestamp": "02:58:03", "text": "嗯，某种程度上来说，我什么都做了。"}, {"type": "subtitle", "time": 10686.389, "timestamp": "02:58:06", "text": "我自己也想知道，我能保留多久。"}, {"type": "subtitle", "time": 10689.99, "timestamp": "02:58:09", "text": "如何做正确的事？比如精神状态"}, {"type": "subtitle", "time": 10693.51, "timestamp": "02:58:13", "text": "酒吧，也像主要一样，主要是当"}, {"type": "subtitle", "time": 10697.19, "timestamp": "02:58:17", "text": "就像提供"}, {"type": "subtitle", "time": 10700.55, "timestamp": "02:58:20", "text": "呃，你知道，当它……的时候，你管它叫什么？"}, {"type": "subtitle", "time": 10703.349, "timestamp": "02:58:23", "text": "说到他们为 YouTuber 提供的服务，"}, {"type": "subtitle", "time": 10705.91, "timestamp": "02:58:25", "text": "呃，内容或者说进展，对吧？"}, {"type": "subtitle", "time": 10707.91, "timestamp": "02:58:27", "text": "例如，对于 YouTuber 来说，就是"}, {"type": "subtitle", "time": 10711.19, "timestamp": "02:58:31", "text": "就像模特揭晓首秀一样"}, {"type": "subtitle", "time": 10714.309, "timestamp": "02:58:34", "text": "从首秀普通直播开始"}, {"type": "subtitle", "time": 10716.95, "timestamp": "02:58:36", "text": "庆祝活动直播"}, {"type": "subtitle", "time": 10720.95, "timestamp": "02:58:40", "text": "呃，假日活动直播，然后就来了"}, {"type": "subtitle", "time": 10723.269, "timestamp": "02:58:43", "text": "其中包含合作和其他内容"}, {"type": "subtitle", "time": 10726.07, "timestamp": "02:58:46", "text": "然后像基于事件的小说流"}, {"type": "subtitle", "time": 10727.91, "timestamp": "02:58:47", "text": "赞助流量等等"}, {"type": "subtitle", "time": 10730.23, "timestamp": "02:58:50", "text": "有点像时间线"}, {"type": "subtitle", "time": 10733.59, "timestamp": "02:58:53", "text": "章节，我们可以称之为右手边的溪流"}, {"type": "subtitle", "time": 10735.349, "timestamp": "02:58:55", "text": "他们得到的都是不同类型的"}, {"type": "subtitle", "time": 10739.19, "timestamp": "02:58:59", "text": "所以对我来说，我有很多东西。"}]
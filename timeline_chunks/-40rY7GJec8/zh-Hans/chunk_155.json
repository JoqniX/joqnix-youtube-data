[{"type": "subtitle", "time": 9302.95, "timestamp": "02:35:02", "text": "我想大概是下周吧。"}, {"type": "subtitle", "time": 9305.83, "timestamp": "02:35:05", "text": "谈谈下周的事。呃"}, {"type": "subtitle", "time": 9307.51, "timestamp": "02:35:07", "text": "距离下一届只剩两天了"}, {"type": "subtitle", "time": 9310.63, "timestamp": "02:35:10", "text": "一周，对吧？是的。"}, {"type": "subtitle", "time": 9312.309, "timestamp": "02:35:12", "text": "该锻炼了。你说得对。呃"}, {"type": "subtitle", "time": 9315.27, "timestamp": "02:35:15", "text": "游戏的自由。我的意思是，呃……"}, {"type": "subtitle", "time": 9318.71, "timestamp": "02:35:18", "text": "关于我，嗯，我的家人认为"}, {"type": "subtitle", "time": 9322.389, "timestamp": "02:35:22", "text": "我感觉自己每天都在浪费时间。"}, {"type": "subtitle", "time": 9324.63, "timestamp": "02:35:24", "text": "尽管我告诉过他们我正在做什么"}, {"type": "subtitle", "time": 9326.309, "timestamp": "02:35:26", "text": "YouTube、流媒体之类的东西，它们"}, {"type": "subtitle", "time": 9329.51, "timestamp": "02:35:29", "text": "我不知道自己该做什么。他们认为的是"}, {"type": "subtitle", "time": 9331.75, "timestamp": "02:35:31", "text": "我当时就……"}, {"type": "subtitle", "time": 9334.87, "timestamp": "02:35:34", "text": "嗯，他们认为我是"}, {"type": "subtitle", "time": 9337.03, "timestamp": "02:35:37", "text": "就像浪费时间一样"}, {"type": "subtitle", "time": 9338.95, "timestamp": "02:35:38", "text": "网络之类的，因为我不是"}, {"type": "subtitle", "time": 9342.79, "timestamp": "02:35:42", "text": "出去玩就像……呃呃……就像"}, {"type": "subtitle", "time": 9345.67, "timestamp": "02:35:45", "text": "就像我们扮演的角色一样，天使。"}, {"type": "subtitle", "time": 9349.27, "timestamp": "02:35:49", "text": "播放“没错”"}, {"type": "subtitle", "time": 9352.309, "timestamp": "02:35:52", "text": "就像她一样。是的。所以我和你一样"}, {"type": "subtitle", "time": 9354.389, "timestamp": "02:35:54", "text": "就是这样。"}, {"type": "subtitle", "time": 9355.91, "timestamp": "02:35:55", "text": "所以"}]
[{"type": "subtitle", "time": 10561.51, "timestamp": "02:56:01", "text": "我的直播之类的，我当时就想，呃……"}, {"type": "subtitle", "time": 10564.71, "timestamp": "02:56:04", "text": "感觉 h 你为什么要推广 baka 我是我吗"}, {"type": "subtitle", "time": 10568.309, "timestamp": "02:56:08", "text": "不是我。你不需要它来做这件事。"}, {"type": "subtitle", "time": 10572.95, "timestamp": "02:56:12", "text": "诸如此类的事情。"}, {"type": "subtitle", "time": 10575.75, "timestamp": "02:56:15", "text": "嗯，就是这样。那我为什么会这样做呢？"}, {"type": "subtitle", "time": 10579.67, "timestamp": "02:56:19", "text": "那？就像因为像"}, {"type": "subtitle", "time": 10582.87, "timestamp": "02:56:22", "text": "回想起在Twitch的日子，我有点……"}, {"type": "subtitle", "time": 10586.15, "timestamp": "02:56:26", "text": "因为流媒体，我学到了很多东西。"}, {"type": "subtitle", "time": 10589.59, "timestamp": "02:56:29", "text": "几乎零观众之类的。它那种"}, {"type": "subtitle", "time": 10592.469, "timestamp": "02:56:32", "text": "这件事教会了我一个道理。"}, {"type": "subtitle", "time": 10594.469, "timestamp": "02:56:34", "text": "嗯，这让我对它有了更深的理解。"}, {"type": "subtitle", "time": 10596.469, "timestamp": "02:56:36", "text": "流媒体的世界将会如何发展？"}, {"type": "subtitle", "time": 10598.55, "timestamp": "02:56:38", "text": "小型流媒体"}, {"type": "subtitle", "time": 10601.349, "timestamp": "02:56:41", "text": "就像它有多么残酷，你有多……"}, {"type": "subtitle", "time": 10604.15, "timestamp": "02:56:44", "text": "你需要继续尽你所能做到最好。"}, {"type": "subtitle", "time": 10606.07, "timestamp": "02:56:46", "text": "想出新点子和新酷炫的东西"}, {"type": "subtitle", "time": 10612.23, "timestamp": "02:56:52", "text": "东西或者想办法进入这个东西"}, {"type": "subtitle", "time": 10618.55, "timestamp": "02:56:58", "text": "呃"}]
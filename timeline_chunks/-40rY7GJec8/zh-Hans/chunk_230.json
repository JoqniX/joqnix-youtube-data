[{"type": "subtitle", "time": 13802.55, "timestamp": "03:50:02", "text": "谁在装运动健将，谁才是真正的我？"}, {"type": "subtitle", "time": 13806.229, "timestamp": "03:50:06", "text": "也像你有时喜欢的那样"}, {"type": "subtitle", "time": 13809.11, "timestamp": "03:50:09", "text": "呃，有时候我的真实情况该怎么称呼它呢？"}, {"type": "subtitle", "time": 13812.07, "timestamp": "03:50:12", "text": "自我和乔尔夫斯之间有点冲突"}, {"type": "subtitle", "time": 13815.75, "timestamp": "03:50:15", "text": "更像是你可以把它分享出来"}, {"type": "subtitle", "time": 13819.269, "timestamp": "03:50:19", "text": "身份危机或类似多重身份"}, {"type": "subtitle", "time": 13821.349, "timestamp": "03:50:21", "text": "对我来说，多重人格并不代表我的看法。"}, {"type": "subtitle", "time": 13825.11, "timestamp": "03:50:25", "text": "我知道，但更可能的是我想说的话"}, {"type": "subtitle", "time": 13829.269, "timestamp": "03:50:29", "text": "就像很久以前在推特上那样，呃，我想"}, {"type": "subtitle", "time": 13833.269, "timestamp": "03:50:33", "text": "我发了一条很长的道歉推文给乔或"}, {"type": "subtitle", "time": 13837.51, "timestamp": "03:50:37", "text": "某种程度上，因为在某种程度上，嗯，在某种程度上，我曾经是"}, {"type": "subtitle", "time": 13840.389, "timestamp": "03:50:40", "text": "情绪波动很大，嗯"}, {"type": "subtitle", "time": 13842.87, "timestamp": "03:50:42", "text": "那是在你知道的那段时间，是的。"}, {"type": "subtitle", "time": 13844.389, "timestamp": "03:50:44", "text": "那是在我去的那段时间"}, {"type": "subtitle", "time": 13846.309, "timestamp": "03:50:46", "text": "就像那些人一样"}, {"type": "subtitle", "time": 13849.11, "timestamp": "03:50:49", "text": "离开我，还有所有那些事……"}, {"type": "subtitle", "time": 13851.99, "timestamp": "03:50:51", "text": "就像家庭琐事一样，"}, {"type": "subtitle", "time": 13854.469, "timestamp": "03:50:54", "text": "所有这些情况都在发生。所以，我当时"}, {"type": "subtitle", "time": 13857.03, "timestamp": "03:50:57", "text": "就像试图停止一样"}, {"type": "subtitle", "time": 13858.95, "timestamp": "03:50:58", "text": "直播和类似杀死 Jockn 或"}]
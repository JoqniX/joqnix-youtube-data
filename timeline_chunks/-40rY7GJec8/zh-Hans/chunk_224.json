[{"type": "subtitle", "time": 13440.63, "timestamp": "03:44:00", "text": "会有很多人"}, {"type": "subtitle", "time": 13447.91, "timestamp": "03:44:07", "text": "如果你搜索一下某个大主播"}, {"type": "subtitle", "time": 13451.11, "timestamp": "03:44:11", "text": "就像Facebook上的这类账号一样"}, {"type": "subtitle", "time": 13454.63, "timestamp": "03:44:14", "text": "YouTube 或 Twitch 之类的平台，你可以看到"}, {"type": "subtitle", "time": 13455.99, "timestamp": "03:44:15", "text": "有些人"}, {"type": "subtitle", "time": 13459.11, "timestamp": "03:44:19", "text": "模仿"}, {"type": "subtitle", "time": 13462.71, "timestamp": "03:44:22", "text": "诸如此类，对吧？甚至还发帖"}, {"type": "subtitle", "time": 13465.91, "timestamp": "03:44:25", "text": "他们发这些东西就是为了愚弄别人。"}, {"type": "subtitle", "time": 13468.71, "timestamp": "03:44:28", "text": "获得关注者和订阅者"}, {"type": "subtitle", "time": 13471.11, "timestamp": "03:44:31", "text": "关注他们，点赞并私信他们。"}, {"type": "subtitle", "time": 13473.67, "timestamp": "03:44:33", "text": "告诉他们我会进行加密货币诈骗，或者"}, {"type": "subtitle", "time": 13476.15, "timestamp": "03:44:36", "text": "就像其他一些骗局之类的……"}, {"type": "subtitle", "time": 13477.83, "timestamp": "03:44:37", "text": "如果有人相信这一点，他们会"}, {"type": "subtitle", "time": 13480.469, "timestamp": "03:44:40", "text": "想想我最爱看的主播"}, {"type": "subtitle", "time": 13482.79, "timestamp": "03:44:42", "text": "他们想让我做这个之类的"}, {"type": "subtitle", "time": 13485.189, "timestamp": "03:44:45", "text": "他们就落入了那个陷阱，然后就像"}, {"type": "subtitle", "time": 13489.349, "timestamp": "03:44:49", "text": "被毁了，他们感觉糟透了，而且他们"}, {"type": "subtitle", "time": 13491.75, "timestamp": "03:44:51", "text": "甚至连主播本人也会"}, {"type": "subtitle", "time": 13493.51, "timestamp": "03:44:53", "text": "你永远不会知道背后正在发生这样的事。"}, {"type": "subtitle", "time": 13495.59, "timestamp": "03:44:55", "text": "他们的背对着右手，而这已经是"}, {"type": "subtitle", "time": 13499.429, "timestamp": "03:44:59", "text": "持续了很长时间"}]
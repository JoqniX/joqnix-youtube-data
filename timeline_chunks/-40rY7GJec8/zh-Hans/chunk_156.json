[{"type": "subtitle", "time": 9360.469, "timestamp": "02:36:00", "text": "因为我一天24小时都泡在电脑前，就像早上一样。"}, {"type": "subtitle", "time": 9363.59, "timestamp": "02:36:03", "text": "下午上午会像……"}, {"type": "subtitle", "time": 9365.75, "timestamp": "02:36:05", "text": "然后下午晚上会直播"}, {"type": "subtitle", "time": 9367.83, "timestamp": "02:36:07", "text": "今晚我将为 YouTube 工作"}, {"type": "subtitle", "time": 9370.23, "timestamp": "02:36:10", "text": "做一些事情，或者玩个小游戏"}, {"type": "subtitle", "time": 9372.63, "timestamp": "02:36:12", "text": "就像和一些人一起闲逛，呃，为了和"}, {"type": "subtitle", "time": 9377.11, "timestamp": "02:36:17", "text": "其他的。所以，是的，所有这些都算数。"}, {"type": "subtitle", "time": 9381.59, "timestamp": "02:36:21", "text": "对某些人来说，这是浪费时间。所以我需要我"}, {"type": "subtitle", "time": 9383.67, "timestamp": "02:36:23", "text": "需要想办法"}, {"type": "subtitle", "time": 9386.63, "timestamp": "02:36:26", "text": "我会尽我所能，并且喜欢这样。"}, {"type": "subtitle", "time": 9389.75, "timestamp": "02:36:29", "text": "不会发生，但某种程度上也像是发生了。"}, {"type": "subtitle", "time": 9393.429, "timestamp": "02:36:33", "text": "呃，我家大部分人都病了，所以……"}, {"type": "subtitle", "time": 9395.429, "timestamp": "02:36:35", "text": "没人照顾他们，所以我得……"}, {"type": "subtitle", "time": 9399.03, "timestamp": "02:36:39", "text": "我会在那里，而且每当我做 BRB 的时候也会在那里"}, {"type": "subtitle", "time": 9402.23, "timestamp": "02:36:42", "text": "对，我有点难过，因为我……"}, {"type": "subtitle", "time": 9404.469, "timestamp": "02:36:44", "text": "装上黑莓屏幕，就像来一样"}, {"type": "subtitle", "time": 9407.349, "timestamp": "02:36:47", "text": "10分钟或5分钟后回来"}, {"type": "subtitle", "time": 9409.99, "timestamp": "02:36:49", "text": "那就是，那将使"}, {"type": "subtitle", "time": 9412.87, "timestamp": "02:36:52", "text": "呃，正在观看直播的人"}, {"type": "subtitle", "time": 9415.99, "timestamp": "02:36:55", "text": "离开或者别的什么，对吧？"}, {"type": "subtitle", "time": 9418.469, "timestamp": "02:36:58", "text": "我不知道。所以，我不希望那样。"}]
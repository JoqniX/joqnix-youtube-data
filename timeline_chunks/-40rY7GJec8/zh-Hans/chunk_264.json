[{"type": "subtitle", "time": 15840.07, "timestamp": "04:24:00", "text": "这不是玩笑。我曾是某人"}, {"type": "subtitle", "time": 15843.189, "timestamp": "04:24:03", "text": "过去经常多次"}, {"type": "subtitle", "time": 15846.95, "timestamp": "04:24:06", "text": "连续几次，不是那样，但现在我"}, {"type": "subtitle", "time": 15849.51, "timestamp": "04:24:09", "text": "我想我学到了大部分这些。"}, {"type": "subtitle", "time": 15851.99, "timestamp": "04:24:11", "text": "梗文化相关"}, {"type": "subtitle", "time": 15854.149, "timestamp": "04:24:14", "text": "我认为我可以躲过他们中的大多数，但我不能。"}, {"type": "subtitle", "time": 15857.91, "timestamp": "04:24:17", "text": "我知道，但仍然要继续学习"}, {"type": "subtitle", "time": 15867.83, "timestamp": "04:24:27", "text": "希望你今天过得愉快。"}, {"type": "subtitle", "time": 15870.389, "timestamp": "04:24:30", "text": "继续你的沙卡手势，好好享受剩下的时光吧。"}, {"type": "subtitle", "time": 15872.71, "timestamp": "04:24:32", "text": "你的夜晚。那么，欢迎来到您的"}, {"type": "subtitle", "time": 15876.55, "timestamp": "04:24:36", "text": "幻想是呃，虎人。 Tigeran 做了"}, {"type": "subtitle", "time": 15879.67, "timestamp": "04:24:39", "text": "提到她将从……加入"}, {"type": "subtitle", "time": 15882.309, "timestamp": "04:24:42", "text": "一直如此。所以，谢谢 Tigeran"}, {"type": "subtitle", "time": 15884.63, "timestamp": "04:24:44", "text": "今天过来打个招呼，感觉很棒。"}, {"type": "subtitle", "time": 15886.63, "timestamp": "04:24:46", "text": "对你来说迟到了，对吧？希望你"}, {"type": "subtitle", "time": 15889.03, "timestamp": "04:24:49", "text": "我现在正在睡觉。醒来"}, {"type": "subtitle", "time": 15891.03, "timestamp": "04:24:51", "text": "现在，脸上带着微笑，开启美好的一天。"}, {"type": "subtitle", "time": 15894.71, "timestamp": "04:24:54", "text": "感谢你尽了全力。感谢"}, {"type": "subtitle", "time": 15897.83, "timestamp": "04:24:57", "text": "谢谢你来画画，还有，嗯……"}]
[{"type": "subtitle", "time": 15186.79, "timestamp": "04:13:06", "text": "家庭成员越多，就越幸福。是的，我"}, {"type": "subtitle", "time": 15190.87, "timestamp": "04:13:10", "text": "最主要的是……"}, {"type": "subtitle", "time": 15192.71, "timestamp": "04:13:12", "text": "我觉得我提到的最重要的一点是……"}, {"type": "subtitle", "time": 15196.229, "timestamp": "04:13:16", "text": "也就是说，我并没有专注于任何一个方面。"}, {"type": "subtitle", "time": 15198.95, "timestamp": "04:13:18", "text": "观众群体并非来自单一国家或地区。"}, {"type": "subtitle", "time": 15201.67, "timestamp": "04:13:21", "text": "就像来自某个国家的协议一样"}, {"type": "subtitle", "time": 15204.229, "timestamp": "04:13:24", "text": "或者别的什么。你知道我想成为你"}, {"type": "subtitle", "time": 15208.07, "timestamp": "04:13:28", "text": "任何事物都可能被普遍认知。"}, {"type": "subtitle", "time": 15210.71, "timestamp": "04:13:30", "text": "任何地方的文化"}, {"type": "subtitle", "time": 15212.79, "timestamp": "04:13:32", "text": "无论他们来自哪里，无论他们是谁"}, {"type": "subtitle", "time": 15214.79, "timestamp": "04:13:34", "text": "没关系"}, {"type": "subtitle", "time": 15217.91, "timestamp": "04:13:37", "text": "我只是想让更多人认识我。"}, {"type": "subtitle", "time": 15221.429, "timestamp": "04:13:41", "text": "就好像以某种方式，如果我能够……"}, {"type": "subtitle", "time": 15224.149, "timestamp": "04:13:44", "text": "激励他们，或者让他们快乐，或者使"}, {"type": "subtitle", "time": 15226.63, "timestamp": "04:13:46", "text": "他们的笑容对我意义重大。"}, {"type": "subtitle", "time": 15229.189, "timestamp": "04:13:49", "text": "我想要的只是我自己的钱，我不要任何人的钱。"}, {"type": "subtitle", "time": 15232.149, "timestamp": "04:13:52", "text": "或任何其他形式的经济支持"}, {"type": "subtitle", "time": 15234.149, "timestamp": "04:13:54", "text": "真的非常需要。你可以观看"}, {"type": "subtitle", "time": 15236.71, "timestamp": "04:13:56", "text": "这一切都是免费的。即使我正在做"}, {"type": "subtitle", "time": 15239.67, "timestamp": "04:13:59", "text": "未来的音乐会，"}]
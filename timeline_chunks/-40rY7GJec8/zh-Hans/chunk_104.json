[{"type": "subtitle", "time": 6247.99, "timestamp": "01:44:07", "text": "当我看到"}, {"type": "subtitle", "time": 6251.35, "timestamp": "01:44:11", "text": "我现在没事。好的，"}, {"type": "subtitle", "time": 6258.47, "timestamp": "01:44:18", "text": "我不应该让自己难堪。"}, {"type": "subtitle", "time": 6265.83, "timestamp": "01:44:25", "text": "不知道我的表情是不是很可爱"}, {"type": "subtitle", "time": 6269.83, "timestamp": "01:44:29", "text": "下次我们再讨论这件事的时候，只要它……"}, {"type": "subtitle", "time": 6273.669, "timestamp": "01:44:33", "text": "它杀不死我。主要是在那里。但"}, {"type": "subtitle", "time": 6276.229, "timestamp": "01:44:36", "text": "如果你是一名主播，"}, {"type": "subtitle", "time": 6283.51, "timestamp": "01:44:43", "text": "哦，不。"}, {"type": "subtitle", "time": 6294.79, "timestamp": "01:44:54", "text": "[音乐]"}, {"type": "subtitle", "time": 6296.39, "timestamp": "01:44:56", "text": "我应该这么认为吗？我打算选择"}]
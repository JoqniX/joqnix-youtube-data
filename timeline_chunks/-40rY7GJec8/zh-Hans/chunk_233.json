[{"type": "subtitle", "time": 13981.83, "timestamp": "03:53:01", "text": "即使是第二名也在尽力而为，但"}, {"type": "subtitle", "time": 13985.429, "timestamp": "03:53:05", "text": "感觉还是不一样了，或者"}, {"type": "subtitle", "time": 13987.03, "timestamp": "03:53:07", "text": "差不多就是这样。对，就像那样。"}, {"type": "subtitle", "time": 13990.15, "timestamp": "03:53:10", "text": "感觉就像我感觉到了那样"}, {"type": "subtitle", "time": 13992.07, "timestamp": "03:53:12", "text": "所以我觉得这就是我道歉的原因。"}, {"type": "subtitle", "time": 13995.75, "timestamp": "03:53:15", "text": "早在四月份，我就在推特上表达了歉意。"}, {"type": "subtitle", "time": 14000.07, "timestamp": "03:53:20", "text": "今年五月期间。是啊，是啊，是啊。"}, {"type": "subtitle", "time": 14002.63, "timestamp": "03:53:22", "text": "我喜欢这样"}, {"type": "subtitle", "time": 14004.15, "timestamp": "03:53:24", "text": "男人。说实话，我可以谈谈"}, {"type": "subtitle", "time": 14006.55, "timestamp": "03:53:26", "text": "因为这款游戏需要很多东西"}, {"type": "subtitle", "time": 14009.429, "timestamp": "03:53:29", "text": "直播结束。我的天啊。哇。"}, {"type": "subtitle", "time": 14011.349, "timestamp": "03:53:31", "text": "所以，从某种意义上说，你可以理解……"}, {"type": "subtitle", "time": 14014.55, "timestamp": "03:53:34", "text": "一点点，呃，多少"}, {"type": "subtitle", "time": 14016.469, "timestamp": "03:53:36", "text": "那它叫什么来着？挣扎但"}, {"type": "subtitle", "time": 14019.03, "timestamp": "03:53:39", "text": "我觉得我几乎不认为这些是"}, {"type": "subtitle", "time": 14022.309, "timestamp": "03:53:42", "text": "不管有没有困难，但你知道，就像"}, {"type": "subtitle", "time": 14025.75, "timestamp": "03:53:45", "text": "有这种感觉的人"}, {"type": "subtitle", "time": 14028.55, "timestamp": "03:53:48", "text": "呃，那些大主播面临的挑战更大。"}, {"type": "subtitle", "time": 14030.95, "timestamp": "03:53:50", "text": "他们往往会经历很多事。他们有"}, {"type": "subtitle", "time": 14034.07, "timestamp": "03:53:54", "text": "请不要喜欢，不是请，我喜欢尝试"}, {"type": "subtitle", "time": 14036.389, "timestamp": "03:53:56", "text": "他们尽力保持喜欢"}, {"type": "subtitle", "time": 14038.87, "timestamp": "03:53:58", "text": "观众反应不强烈，也没有出现负面情绪或类似情况"}]
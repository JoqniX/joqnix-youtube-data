[{"type": "subtitle", "time": 1981.19, "timestamp": "00:33:01", "text": "前。"}, {"type": "subtitle", "time": 1985.269, "timestamp": "00:33:05", "text": "你还没看到我"}, {"type": "subtitle", "time": 1994.95, "timestamp": "00:33:14", "text": "我一直在开玩笑说我想去哪里。一个"}, {"type": "subtitle", "time": 1996.63, "timestamp": "00:33:16", "text": "在犯罪游戏上多投入一些资金"}, {"type": "subtitle", "time": 1999.509, "timestamp": "00:33:19", "text": "比其他任何事情都重要，但我很高兴……"}, {"type": "subtitle", "time": 2002.31, "timestamp": "00:33:22", "text": "游戏市场依然表现良好。"}, {"type": "subtitle", "time": 2005.11, "timestamp": "00:33:25", "text": "犯罪率之类的东西是"}, {"type": "subtitle", "time": 2007.669, "timestamp": "00:33:27", "text": "危险的。等等，什么？"}, {"type": "subtitle", "time": 2012.149, "timestamp": "00:33:32", "text": "你买游戏了吗？是的，我做了。"}, {"type": "subtitle", "time": 2014.07, "timestamp": "00:33:34", "text": "关于那些深入此地的吸血鬼猎人"}, {"type": "subtitle", "time": 2016.33, "timestamp": "00:33:36", "text": "邪恶的城堡。"}, {"type": "subtitle", "time": 2021.509, "timestamp": "00:33:41", "text": "[音乐]"}]
[{"type": "subtitle", "time": 4105.189, "timestamp": "01:08:25", "text": "我们都是朋友。我们都不是偶像。"}, {"type": "subtitle", "time": 4108.309, "timestamp": "01:08:28", "text": "好的。天使"}, {"type": "subtitle", "time": 4111.51, "timestamp": "01:08:31", "text": "朋友们。我们在哪里？哦，他们得到了"}, {"type": "subtitle", "time": 4117.269, "timestamp": "01:08:37", "text": "好的。"}, {"type": "subtitle", "time": 4120.269, "timestamp": "01:08:40", "text": "真的。偶像崇拜是有害的。是的。"}, {"type": "subtitle", "time": 4132.55, "timestamp": "01:08:52", "text": "早上起床真难。"}, {"type": "subtitle", "time": 4138.63, "timestamp": "01:08:58", "text": "你们像5岁那样早起吗？"}]
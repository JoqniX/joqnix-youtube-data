[{"type": "subtitle", "time": 2342.47, "timestamp": "00:39:02", "text": "能看出我过去与过去的纠葛"}, {"type": "subtitle", "time": 2344.47, "timestamp": "00:39:04", "text": "埋头苦干做内容之类的？哦"}, {"type": "subtitle", "time": 2345.99, "timestamp": "00:39:05", "text": "是的，"}, {"type": "subtitle", "time": 2348.15, "timestamp": "00:39:08", "text": "这主意不错，但是说实话，我"}, {"type": "subtitle", "time": 2350.23, "timestamp": "00:39:10", "text": "我其实不想做。好的，制作"}, {"type": "subtitle", "time": 2352.71, "timestamp": "00:39:12", "text": "我想死，但痛苦却……"}, {"type": "subtitle", "time": 2354.79, "timestamp": "00:39:14", "text": "我有哪些特质让我更有趣？所以，我"}, {"type": "subtitle", "time": 2357.109, "timestamp": "00:39:17", "text": "我想我得成为……"}, {"type": "subtitle", "time": 2360.15, "timestamp": "00:39:20", "text": "做主播太难了。我的黑暗秘密"}, {"type": "subtitle", "time": 2362.83, "timestamp": "00:39:22", "text": "过去的。哦，不。"}, {"type": "subtitle", "time": 2370.15, "timestamp": "00:39:30", "text": "好的，"}, {"type": "subtitle", "time": 2372.35, "timestamp": "00:39:32", "text": "我们更接近目标了。走到黄昏。"}, {"type": "subtitle", "time": 2374.71, "timestamp": "00:39:34", "text": "[音乐]"}, {"type": "subtitle", "time": 2376.71, "timestamp": "00:39:36", "text": "我并不是讨厌别人问我这个问题。"}, {"type": "subtitle", "time": 2378.31, "timestamp": "00:39:38", "text": "跟他们合作什么的，但我"}, {"type": "subtitle", "time": 2380.23, "timestamp": "00:39:40", "text": "总是忘记回复他们，而且他们"}, {"type": "subtitle", "time": 2385.19, "timestamp": "00:39:45", "text": "听不见。为什么？为什么生活如此艰难？"}, {"type": "subtitle", "time": 2392.069, "timestamp": "00:39:52", "text": "永远相爱。"}, {"type": "subtitle", "time": 2395.829, "timestamp": "00:39:55", "text": "再说几遍。爱"}]
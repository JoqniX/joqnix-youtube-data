[{"type": "subtitle", "time": 11881.03, "timestamp": "03:18:01", "text": "来自你们的经济支持等等"}, {"type": "subtitle", "time": 11883.51, "timestamp": "03:18:03", "text": "当你开始的时候，你会达到那个阶段"}, {"type": "subtitle", "time": 11887.59, "timestamp": "03:18:07", "text": "期望别人那样对待你"}, {"type": "subtitle", "time": 11889.91, "timestamp": "03:18:09", "text": "对你做那种事。意思是下一个像一个"}, {"type": "subtitle", "time": 11892.95, "timestamp": "03:18:12", "text": "比如说，流媒体"}, {"type": "subtitle", "time": 11894.95, "timestamp": "03:18:14", "text": "呃，下次直播或者今天的直播我有一个"}, {"type": "subtitle", "time": 11896.55, "timestamp": "03:18:16", "text": "有很多捐赠之类的东西，对吧？下一个"}, {"type": "subtitle", "time": 11898.229, "timestamp": "03:18:18", "text": "那天我希望人们能捐款。"}, {"type": "subtitle", "time": 11900.229, "timestamp": "03:18:20", "text": "我和第二天，第二天的人们"}, {"type": "subtitle", "time": 11903.03, "timestamp": "03:18:23", "text": "捐点东西给我，然后我就会像我的"}, {"type": "subtitle", "time": 11905.59, "timestamp": "03:18:25", "text": "大脑会像……一样受到精神污染"}, {"type": "subtitle", "time": 11907.99, "timestamp": "03:18:27", "text": "事实是，人们必须捐款。"}, {"type": "subtitle", "time": 11909.83, "timestamp": "03:18:29", "text": "得赚钱什么的"}, {"type": "subtitle", "time": 11913.51, "timestamp": "03:18:33", "text": "那还有什么乐趣可言呢？"}, {"type": "subtitle", "time": 11915.83, "timestamp": "03:18:35", "text": "对，乐趣在哪儿？乐趣在哪儿？"}, {"type": "subtitle", "time": 11918.95, "timestamp": "03:18:38", "text": "就像我刚才说的那样，对吧？"}, {"type": "subtitle", "time": 11922.469, "timestamp": "03:18:42", "text": "现在来说说我们在游戏中看到的这个话题。"}, {"type": "subtitle", "time": 11925.59, "timestamp": "03:18:45", "text": "就像呃，天使主要依赖于"}, {"type": "subtitle", "time": 11929.19, "timestamp": "03:18:49", "text": "阿巴的钱，这样她就可以还清债务了。"}, {"type": "subtitle", "time": 11931.99, "timestamp": "03:18:51", "text": "她的税款之类的，对吧？虽然"}, {"type": "subtitle", "time": 11936.229, "timestamp": "03:18:56", "text": "她虽然主要还是知道自己"}, {"type": "subtitle", "time": 11938.229, "timestamp": "03:18:58", "text": "她必须赚到100万才能获得超级资格。"}]
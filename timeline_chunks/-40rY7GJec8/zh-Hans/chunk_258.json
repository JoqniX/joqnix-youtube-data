[{"type": "subtitle", "time": 15482.389, "timestamp": "04:18:02", "text": "老鼠查玛和深查玛就像我"}, {"type": "subtitle", "time": 15485.11, "timestamp": "04:18:05", "text": "chama 像是坏掉了，而且不像"}, {"type": "subtitle", "time": 15487.59, "timestamp": "04:18:07", "text": "几乎就像他们正在做的那样"}, {"type": "subtitle", "time": 15491.429, "timestamp": "04:18:11", "text": "他们做到了最好。 Moshi Chama 和 Ebiki 一样"}, {"type": "subtitle", "time": 15494.389, "timestamp": "04:18:14", "text": "他们也在尽力而为，对吧？但"}, {"type": "subtitle", "time": 15497.51, "timestamp": "04:18:17", "text": "是的，如果你不知道的话，我一直……"}, {"type": "subtitle", "time": 15500.71, "timestamp": "04:18:20", "text": "给我的所有东西都取名字，还有我的宠物"}, {"type": "subtitle", "time": 15503.269, "timestamp": "04:18:23", "text": "亲吻他们，道晚安，祝他们入睡。"}, {"type": "subtitle", "time": 15506.389, "timestamp": "04:18:26", "text": "所以别觉得我这样做很奇怪。"}, {"type": "subtitle", "time": 15519.67, "timestamp": "04:18:39", "text": "是的。所以"}, {"type": "subtitle", "time": 15521.67, "timestamp": "04:18:41", "text": "但我不该那样说。我的意思是，"}, {"type": "subtitle", "time": 15529.6, "timestamp": "04:18:49", "text": "我只是个"}, {"type": "subtitle", "time": 15531.67, "timestamp": "04:18:51", "text": "[音乐]"}, {"type": "subtitle", "time": 15534.149, "timestamp": "04:18:54", "text": "但是，是的，我必须确保"}, {"type": "subtitle", "time": 15537.349, "timestamp": "04:18:57", "text": "它们都不会死在我面前，或者说，它们不会死。"}]
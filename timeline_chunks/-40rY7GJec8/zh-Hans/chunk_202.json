[{"type": "subtitle", "time": 12127.59, "timestamp": "03:22:07", "text": "天哪，我为什么哭了？哦，天哪，我"}, {"type": "subtitle", "time": 12130.55, "timestamp": "03:22:10", "text": "哭泣。我的天啊。只是提醒一下"}, {"type": "subtitle", "time": 12133.429, "timestamp": "03:22:13", "text": "向我讲述了我所经历的一些时刻。"}, {"type": "subtitle", "time": 12134.95, "timestamp": "03:22:14", "text": "家庭"}, {"type": "subtitle", "time": 12138.63, "timestamp": "03:22:18", "text": "他们离开了，但也一直鼓励着我。哦，我的"}, {"type": "subtitle", "time": 12156.55, "timestamp": "03:22:36", "text": "是的，"}, {"type": "subtitle", "time": 12161.19, "timestamp": "03:22:41", "text": "别在意大型体育赛事。好吧，我真是太"}, {"type": "subtitle", "time": 12165.349, "timestamp": "03:22:45", "text": "我真是太他妈糟了。是的，这让我想起了……"}, {"type": "subtitle", "time": 12168.469, "timestamp": "03:22:48", "text": "呃，事件。嗯"}, {"type": "subtitle", "time": 12170.55, "timestamp": "03:22:50", "text": "不，这不是事件。它让我想起"}, {"type": "subtitle", "time": 12173.51, "timestamp": "03:22:53", "text": "或者让我继续下去，就像，即使你"}, {"type": "subtitle", "time": 12177.59, "timestamp": "03:22:57", "text": "那里有车吗？没有车？它是一辆车。"}, {"type": "subtitle", "time": 12179.91, "timestamp": "03:22:59", "text": "我是一颗星座，对吧，我将永远如此"}]
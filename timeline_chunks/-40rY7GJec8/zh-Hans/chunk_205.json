[{"type": "subtitle", "time": 12302.389, "timestamp": "03:25:02", "text": "我的天哪，真是个爱哭鬼。我的意思是，是的，就是这样。"}, {"type": "subtitle", "time": 12304.309, "timestamp": "03:25:04", "text": "我之所以在规则中加入这条规定，是因为"}, {"type": "subtitle", "time": 12306.63, "timestamp": "03:25:06", "text": "我非常敏感，所以要小心。"}, {"type": "subtitle", "time": 12309.91, "timestamp": "03:25:09", "text": "你会说话，什么都会。是啊，但是"}, {"type": "subtitle", "time": 12313.11, "timestamp": "03:25:13", "text": "不过，呃，某种程度上来说，确实很糟糕。"}, {"type": "subtitle", "time": 12316.07, "timestamp": "03:25:16", "text": "我是个爱哭鬼"}, {"type": "subtitle", "time": 12322.15, "timestamp": "03:25:22", "text": "不过没关系。在某种程度上，呃，"}, {"type": "subtitle", "time": 12324.63, "timestamp": "03:25:24", "text": "诸如此类的小事会让你"}, {"type": "subtitle", "time": 12326.55, "timestamp": "03:25:26", "text": "去"}, {"type": "subtitle", "time": 12330.469, "timestamp": "03:25:30", "text": "嗯，越来越强了，对吧？神"}, {"type": "subtitle", "time": 12333.67, "timestamp": "03:25:33", "text": "码头狗的眼睛。"}, {"type": "subtitle", "time": 12336.229, "timestamp": "03:25:36", "text": "是的。"}, {"type": "subtitle", "time": 12338.309, "timestamp": "03:25:38", "text": "是啊，就像"}, {"type": "subtitle", "time": 12341.429, "timestamp": "03:25:41", "text": "正如我刚才说的，对吧？嗯"}, {"type": "subtitle", "time": 12344.389, "timestamp": "03:25:44", "text": "我的眼泪快要流干了。哦，不。"}, {"type": "subtitle", "time": 12346.55, "timestamp": "03:25:46", "text": "但别哭。难道我不想和任何人在一起吗？"}, {"type": "subtitle", "time": 12350.309, "timestamp": "03:25:50", "text": "想哭。哦，喜欢"}, {"type": "subtitle", "time": 12352.55, "timestamp": "03:25:52", "text": "呃，就像"}, {"type": "subtitle", "time": 12355.59, "timestamp": "03:25:55", "text": "是的。就把它看作是一种方式"}, {"type": "subtitle", "time": 12358.63, "timestamp": "03:25:58", "text": "支持。我知道不是每个人都能做到"}]
[{"type": "subtitle", "time": 9240.63, "timestamp": "02:34:00", "text": "感谢你们一直以来的支持。"}, {"type": "subtitle", "time": 9243.67, "timestamp": "02:34:03", "text": "希望你观看直播愉快。我有"}, {"type": "subtitle", "time": 9247.27, "timestamp": "02:34:07", "text": "想多说几句，并发表我的看法"}, {"type": "subtitle", "time": 9249.27, "timestamp": "02:34:09", "text": "每个事件"}, {"type": "subtitle", "time": 9251.59, "timestamp": "02:34:11", "text": "呃，在游戏中"}, {"type": "subtitle", "time": 9253.75, "timestamp": "02:34:13", "text": "但我当时太专注于其他事情了。"}, {"type": "subtitle", "time": 9255.75, "timestamp": "02:34:15", "text": "而且这些天我也经常被打断。"}, {"type": "subtitle", "time": 9259.67, "timestamp": "02:34:19", "text": "几天来，今天的直播也是如此，所以"}, {"type": "subtitle", "time": 9261.51, "timestamp": "02:34:21", "text": "我不知道该怎么办，我应该……"}, {"type": "subtitle", "time": 9265.51, "timestamp": "02:34:25", "text": "减少我的流媒体播放时间"}, {"type": "subtitle", "time": 9268.23, "timestamp": "02:34:28", "text": "我好像不能一直直播了。"}, {"type": "subtitle", "time": 9271.91, "timestamp": "02:34:31", "text": "很像我以前的样子"}, {"type": "subtitle", "time": 9274.79, "timestamp": "02:34:34", "text": "嗯，更像是……该怎么称呼它呢？"}, {"type": "subtitle", "time": 9276.63, "timestamp": "02:34:36", "text": "我的自由被剥夺了，或者"}, {"type": "subtitle", "time": 9279.19, "timestamp": "02:34:39", "text": "某物。我不知道。"}, {"type": "subtitle", "time": 9282.389, "timestamp": "02:34:42", "text": "我不知道。也许是因为……"}, {"type": "subtitle", "time": 9284.87, "timestamp": "02:34:44", "text": "孩子，你必须在很多方面都做得正确。"}, {"type": "subtitle", "time": 9288.15, "timestamp": "02:34:48", "text": "房子。所以这有点痛苦。"}, {"type": "subtitle", "time": 9297.75, "timestamp": "02:34:57", "text": "所以我不知道，呃，想想吧。所以，我"}, {"type": "subtitle", "time": 9299.91, "timestamp": "02:34:59", "text": "我想我也会尝试改变我的"}]
[{"type": "subtitle", "time": 491.27, "timestamp": "00:08:11", "text": "阴谋。真的吗？"}, {"type": "subtitle", "time": 493.27, "timestamp": "00:08:13", "text": "还有，稍等片刻。这就是我们"}, {"type": "subtitle", "time": 495.909, "timestamp": "00:08:15", "text": "在 YouTube 上直播，对吧？我的意思是，她"}, {"type": "subtitle", "time": 498.55, "timestamp": "00:08:18", "text": "正在 YouTube 上直播，对吧？怎么会这样"}, {"type": "subtitle", "time": 500.71, "timestamp": "00:08:20", "text": "她能获得商业收益吗？"}, {"type": "subtitle", "time": 514.63, "timestamp": "00:08:34", "text": "[音乐]"}, {"type": "subtitle", "time": 517.75, "timestamp": "00:08:37", "text": "好的。所以，哦不，她正在服用……呃，她正在……"}, {"type": "subtitle", "time": 522.389, "timestamp": "00:08:42", "text": "做一些……哦不，政治方面的事情。哦"}, {"type": "subtitle", "time": 524.389, "timestamp": "00:08:44", "text": "不，"}, {"type": "subtitle", "time": 533.829, "timestamp": "00:08:53", "text": "他们想把日本大师们变成"}, {"type": "subtitle", "time": 537.2, "timestamp": "00:08:57", "text": "用噪音麻痹他们。"}, {"type": "subtitle", "time": 538.63, "timestamp": "00:08:58", "text": "[音乐]"}]
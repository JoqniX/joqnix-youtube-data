[{"type": "subtitle", "time": 15062.389, "timestamp": "04:11:02", "text": "你以前经常直播很多游戏"}, {"type": "subtitle", "time": 15065.429, "timestamp": "04:11:05", "text": "才刚刚开始，但你没有给出"}, {"type": "subtitle", "time": 15069.349, "timestamp": "04:11:09", "text": "我们在 Twitch 上度过了快乐的时光"}, {"type": "subtitle", "time": 15070.79, "timestamp": "04:11:10", "text": "就是这样。我不想那样。"}, {"type": "subtitle", "time": 15073.03, "timestamp": "04:11:13", "text": "YouTube 家族。比利·比利也一样"}, {"type": "subtitle", "time": 15076.07, "timestamp": "04:11:16", "text": "也一样。他们会像这样"}, {"type": "subtitle", "time": 15079.269, "timestamp": "04:11:19", "text": "喜悦将带给西方人民。他们"}, {"type": "subtitle", "time": 15081.91, "timestamp": "04:11:21", "text": "我不喜欢那样。他为什么不来？"}, {"type": "subtitle", "time": 15085.68, "timestamp": "04:11:25", "text": "我们之间还有什么？我想要更多快乐。"}, {"type": "subtitle", "time": 15087.269, "timestamp": "04:11:27", "text": "[音乐]"}, {"type": "subtitle", "time": 15089.11, "timestamp": "04:11:29", "text": "就在那里"}, {"type": "subtitle", "time": 15091.59, "timestamp": "04:11:31", "text": "只有当我们能把他从……偷走。"}, {"type": "subtitle", "time": 15094.79, "timestamp": "04:11:34", "text": "就是这样。我不想那样。"}, {"type": "subtitle", "time": 15097.51, "timestamp": "04:11:37", "text": "下面这位中国人真是比利"}, {"type": "subtitle", "time": 15100.87, "timestamp": "04:11:40", "text": "家人也包括在内。"}, {"type": "subtitle", "time": 15103.11, "timestamp": "04:11:43", "text": "所以我必须确保它变成"}, {"type": "subtitle", "time": 15107.429, "timestamp": "04:11:47", "text": "同样地，所以，是的，尤其是对于"}, {"type": "subtitle", "time": 15109.67, "timestamp": "04:11:49", "text": "比利·布利，这就是我担心的。"}, {"type": "subtitle", "time": 15112.63, "timestamp": "04:11:52", "text": "关于。他们必须有权使用VPN。"}, {"type": "subtitle", "time": 15115.51, "timestamp": "04:11:55", "text": "欢迎在Twitch或YouTube上观看我的直播。所以就像"}, {"type": "subtitle", "time": 15119.11, "timestamp": "04:11:59", "text": "如果它像我们一样"}]
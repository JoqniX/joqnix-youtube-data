[{"type": "subtitle", "time": 2285.51, "timestamp": "00:38:05", "text": "哦，这是呃"}, {"type": "subtitle", "time": 2288.15, "timestamp": "00:38:08", "text": "聊天。好的，"}, {"type": "subtitle", "time": 2290.15, "timestamp": "00:38:10", "text": "我不知道。我不知道该怎么做"}, {"type": "subtitle", "time": 2292.71, "timestamp": "00:38:12", "text": "精心制作的。它是"}, {"type": "subtitle", "time": 2296.069, "timestamp": "00:38:16", "text": "我的女朋友还活着。我看到有人在减速"}, {"type": "subtitle", "time": 2297.91, "timestamp": "00:38:17", "text": "那里。实际上，"}, {"type": "subtitle", "time": 2303.12, "timestamp": "00:38:23", "text": "她会遇到一些麻烦事。所以，她就像"}, {"type": "subtitle", "time": 2315.349, "timestamp": "00:38:35", "text": "自从我开始看我的手表以来，我一直都很喜欢我。"}, {"type": "subtitle", "time": 2319.349, "timestamp": "00:38:39", "text": "溪流。就像梦想成真一样。我喜欢"}, {"type": "subtitle", "time": 2321.109, "timestamp": "00:38:41", "text": "这。这让我很高兴我开始了。"}, {"type": "subtitle", "time": 2323.109, "timestamp": "00:38:43", "text": "流媒体。"}, {"type": "subtitle", "time": 2330.55, "timestamp": "00:38:50", "text": "我的现实主义者"}, {"type": "subtitle", "time": 2334.15, "timestamp": "00:38:54", "text": "我说得对吗？"}, {"type": "subtitle", "time": 2335.91, "timestamp": "00:38:55", "text": "现在还有谁这么说呢？但你不觉得吗？"}, {"type": "subtitle", "time": 2337.349, "timestamp": "00:38:57", "text": "你是否一直很好奇有哪些令人尴尬的事情"}, {"type": "subtitle", "time": 2339.99, "timestamp": "00:38:59", "text": "人们过去也这样做过，就像过去一样。"}]
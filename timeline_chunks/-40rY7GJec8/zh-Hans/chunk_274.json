[{"type": "subtitle", "time": 16440.709, "timestamp": "04:34:00", "text": "做你自己。做你自己。保持"}, {"type": "subtitle", "time": 16450.949, "timestamp": "04:34:10", "text": "感谢您今天光临。真的真的是指"}, {"type": "subtitle", "time": 16454.47, "timestamp": "04:34:14", "text": "很多。希望你今天过得愉快。"}, {"type": "subtitle", "time": 16457.91, "timestamp": "04:34:17", "text": "没错，你也一样。玩得开心"}, {"type": "subtitle", "time": 16461.59, "timestamp": "04:34:21", "text": "游戏结束，夜幕降临。"}, {"type": "subtitle", "time": 16463.59, "timestamp": "04:34:23", "text": "和你一起玩真的很有趣"}, {"type": "subtitle", "time": 16467.029, "timestamp": "04:34:27", "text": "昨天缬草。所以希望我们能玩。"}, {"type": "subtitle", "time": 16479.51, "timestamp": "04:34:39", "text": "妈妈把一切都传给了你。"}, {"type": "subtitle", "time": 16489.429, "timestamp": "04:34:49", "text": "而且我还没见过……呃，我不知道"}, {"type": "subtitle", "time": 16492.31, "timestamp": "04:34:52", "text": "前辈儿子是如何做到的。所以我会给"}, {"type": "subtitle", "time": 16494.869, "timestamp": "04:34:54", "text": "也给她打个补丁。如果你看到"}, {"type": "subtitle", "time": 16499.269, "timestamp": "04:34:59", "text": "她在 Discord 上等待，但所有"}]
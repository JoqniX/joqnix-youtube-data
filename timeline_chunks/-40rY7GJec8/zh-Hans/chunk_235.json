[{"type": "subtitle", "time": 14101.99, "timestamp": "03:55:01", "text": "如果我能很棒，那就太好了。"}, {"type": "subtitle", "time": 14104.309, "timestamp": "03:55:04", "text": "就像飞行动画一样，因为我就像一个"}, {"type": "subtitle", "time": 14107.75, "timestamp": "03:55:07", "text": "更像是你知道的，呃，你知道"}, {"type": "subtitle", "time": 14112.389, "timestamp": "03:55:12", "text": "这是我很久以前做的这个庞大的团队。"}, {"type": "subtitle", "time": 14114.229, "timestamp": "03:55:14", "text": "呃，等等，等等，让我给你看看。这"}, {"type": "subtitle", "time": 14116.87, "timestamp": "03:55:16", "text": "真的好可爱。"}, {"type": "subtitle", "time": 14121.03, "timestamp": "03:55:21", "text": "呃，我甚至把文件命名为“jock jock”。"}, {"type": "subtitle", "time": 14124.79, "timestamp": "03:55:24", "text": "下一个天使之类的。对，就是这个"}, {"type": "subtitle", "time": 14127.75, "timestamp": "03:55:27", "text": "运动天使的秘密。"}, {"type": "subtitle", "time": 14133.189, "timestamp": "03:55:33", "text": "这个。哦，是啊，这种感觉"}, {"type": "subtitle", "time": 14135.91, "timestamp": "03:55:35", "text": "因为我住在这种地方"}, {"type": "subtitle", "time": 14137.99, "timestamp": "03:55:37", "text": "空间。所以，当然会跌倒"}, {"type": "subtitle", "time": 14141.51, "timestamp": "03:55:41", "text": "那个天使看起来一定很可爱。不是吗"}, {"type": "subtitle", "time": 14144.87, "timestamp": "03:55:44", "text": "她？难道不是这样吗？"}, {"type": "subtitle", "time": 14147.11, "timestamp": "03:55:47", "text": "我的天啊。"}, {"type": "subtitle", "time": 14149.429, "timestamp": "03:55:49", "text": "上面有粉笔痕迹。"}, {"type": "subtitle", "time": 14152.07, "timestamp": "03:55:52", "text": "是的，它来自 Big Crew。更像是"}, {"type": "subtitle", "time": 14154.63, "timestamp": "03:55:54", "text": "是的，这是 Big Crew 的作品。你可以"}, {"type": "subtitle", "time": 14158.469, "timestamp": "03:55:58", "text": "实际上，可以制作类似的东西。"}]
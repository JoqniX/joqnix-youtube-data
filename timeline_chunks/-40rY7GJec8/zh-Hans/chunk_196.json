[{"type": "subtitle", "time": 11761.429, "timestamp": "03:16:01", "text": "是的，我马上回来。所以有一天，我"}, {"type": "subtitle", "time": 11765.11, "timestamp": "03:16:05", "text": "曾接触过"}, {"type": "subtitle", "time": 11768.07, "timestamp": "03:16:08", "text": "神奇的蛤蜊活动。神奇蛤蜊"}, {"type": "subtitle", "time": 11769.91, "timestamp": "03:16:09", "text": "我称之为效果。还有克莱姆"}, {"type": "subtitle", "time": 11772.07, "timestamp": "03:16:12", "text": "CJ是剧透我的观众。"}, {"type": "subtitle", "time": 11776.07, "timestamp": "03:16:16", "text": "天。前几天我哭了好久。他他"}, {"type": "subtitle", "time": 11778.389, "timestamp": "03:16:18", "text": "给聊天室里的每个人都送了礼物"}, {"type": "subtitle", "time": 11779.75, "timestamp": "03:16:19", "text": "订阅给聊天室里的所有人。他"}, {"type": "subtitle", "time": 11783.429, "timestamp": "03:16:23", "text": "已捐赠。不，他发了大约 000"}, {"type": "subtitle", "time": 11785.83, "timestamp": "03:16:25", "text": "大约 10,000 比特。那可真不少。"}, {"type": "subtitle", "time": 11787.429, "timestamp": "03:16:27", "text": "比特。所以这也是为什么"}, {"type": "subtitle", "time": 11789.349, "timestamp": "03:16:29", "text": "这就是为什么我喜欢徽章的原因"}, {"type": "subtitle", "time": 11791.91, "timestamp": "03:16:31", "text": "Twitch上的内容。"}, {"type": "subtitle", "time": 11794.79, "timestamp": "03:16:34", "text": "但你知道，某种程度上"}, {"type": "subtitle", "time": 11797.91, "timestamp": "03:16:37", "text": "那天晚上发生这件事的时候，我"}, {"type": "subtitle", "time": 11799.99, "timestamp": "03:16:39", "text": "我哭着开始想……"}, {"type": "subtitle", "time": 11804.229, "timestamp": "03:16:44", "text": "就像这样，如果……如果一个"}, {"type": "subtitle", "time": 11807.429, "timestamp": "03:16:47", "text": "嗯，我越来越像那些人了"}, {"type": "subtitle", "time": 11809.349, "timestamp": "03:16:49", "text": "就像给予经济支持一样。"}, {"type": "subtitle", "time": 11811.91, "timestamp": "03:16:51", "text": "还有一些其他的东西。"}, {"type": "subtitle", "time": 11814.63, "timestamp": "03:16:54", "text": "如果我对这些药物产生依赖怎么办？"}, {"type": "subtitle", "time": 11817.11, "timestamp": "03:16:57", "text": "那些为我花钱的人？"}]
[{"type": "subtitle", "time": 6784.229, "timestamp": "01:53:04", "text": "我觉得我不应该被允许……"}, {"type": "subtitle", "time": 6798.39, "timestamp": "01:53:18", "text": "等级。别把生活看得太严肃。"}, {"type": "subtitle", "time": 6800.229, "timestamp": "01:53:20", "text": "谢谢，披萨。"}, {"type": "subtitle", "time": 6810.229, "timestamp": "01:53:30", "text": "我的错。我的错。我的错。你爱我吗？"}, {"type": "subtitle", "time": 6812.629, "timestamp": "01:53:32", "text": "因为我爱你。"}, {"type": "subtitle", "time": 6818.55, "timestamp": "01:53:38", "text": "我的意思是，你真的非常非常爱我吗？"}, {"type": "subtitle", "time": 6821.99, "timestamp": "01:53:41", "text": "爱你，爱你，爱你爱我。"}, {"type": "subtitle", "time": 6826.149, "timestamp": "01:53:46", "text": "我真的非常非常非常爱你。"}]
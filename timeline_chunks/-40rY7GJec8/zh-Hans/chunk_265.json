[{"type": "subtitle", "time": 15902.07, "timestamp": "04:25:02", "text": "我知道，打招呼真的意义非凡。"}, {"type": "subtitle", "time": 15905.91, "timestamp": "04:25:05", "text": "那就是水螅"}, {"type": "subtitle", "time": 15908.79, "timestamp": "04:25:08", "text": "感谢您今天光临。希望你喜欢"}, {"type": "subtitle", "time": 15910.63, "timestamp": "04:25:10", "text": "谢谢你分享你的"}, {"type": "subtitle", "time": 15914.87, "timestamp": "04:25:14", "text": "关于你的游戏体验"}, {"type": "subtitle", "time": 15917.91, "timestamp": "04:25:17", "text": "也就是你遇到了一个病态人格者"}, {"type": "subtitle", "time": 15920.309, "timestamp": "04:25:20", "text": "Arc 中的某些东西"}, {"type": "subtitle", "time": 15922.79, "timestamp": "04:25:22", "text": "当我们聊到病娇相关的东西时"}, {"type": "subtitle", "time": 15925.91, "timestamp": "04:25:25", "text": "在游戏中，AD 也有很多相同之处。是的，谢谢"}, {"type": "subtitle", "time": 15929.11, "timestamp": "04:25:29", "text": "谢谢你告诉我这件事。"}, {"type": "subtitle", "time": 15931.91, "timestamp": "04:25:31", "text": "但愿你一直都很喜欢《方舟：生存进化》"}, {"type": "subtitle", "time": 15935.67, "timestamp": "04:25:35", "text": "现在还有其他游戏，还有你的日子，伙计，我希望"}, {"type": "subtitle", "time": 15939.189, "timestamp": "04:25:39", "text": "想再玩一次方舟：生存进化，但要太空存储"}, {"type": "subtitle", "time": 15941.75, "timestamp": "04:25:41", "text": "问题正在上演"}, {"type": "subtitle", "time": 15944.55, "timestamp": "04:25:44", "text": "我现在没多少空间了，因为我"}, {"type": "subtitle", "time": 15948.469, "timestamp": "04:25:48", "text": "需要点赞，主要是想留点空间"}, {"type": "subtitle", "time": 15950.71, "timestamp": "04:25:50", "text": "我们就像收拾行囊准备去听音乐一样"}, {"type": "subtitle", "time": 15953.269, "timestamp": "04:25:53", "text": "比如样品包之类的东西"}, {"type": "subtitle", "time": 15956.469, "timestamp": "04:25:56", "text": "那些东西，这样我就可以做音乐了。"}, {"type": "subtitle", "time": 15958.469, "timestamp": "04:25:58", "text": "然后就回归音乐创作吧"}]
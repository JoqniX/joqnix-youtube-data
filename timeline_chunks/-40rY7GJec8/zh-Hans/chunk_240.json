[{"type": "subtitle", "time": 14401.99, "timestamp": "04:00:01", "text": "或者就像你知道的，就像《海贼王》那样。"}, {"type": "subtitle", "time": 14403.67, "timestamp": "04:00:03", "text": "还有一些其他的东西。大家都喜欢这样，对吧？"}, {"type": "subtitle", "time": 14405.03, "timestamp": "04:00:05", "text": "人们喜欢它，正是因为……"}, {"type": "subtitle", "time": 14407.349, "timestamp": "04:00:07", "text": "故事之类的。"}, {"type": "subtitle", "time": 14409.51, "timestamp": "04:00:09", "text": "所以"}, {"type": "subtitle", "time": 14412.55, "timestamp": "04:00:12", "text": "这太关键了，我必须做到。"}, {"type": "subtitle", "time": 14415.51, "timestamp": "04:00:15", "text": "作为一个故事，虽然我很想拥有它"}, {"type": "subtitle", "time": 14418.229, "timestamp": "04:00:18", "text": "该时间线中的所有类型以及类似类型"}, {"type": "subtitle", "time": 14421.03, "timestamp": "04:00:21", "text": "书籍和剧集，但我仍然想"}, {"type": "subtitle", "time": 14423.11, "timestamp": "04:00:23", "text": "让它变得有趣，这样人们就可以"}, {"type": "subtitle", "time": 14425.83, "timestamp": "04:00:25", "text": "读一下。我想读它，并且喜欢它"}, {"type": "subtitle", "time": 14428.71, "timestamp": "04:00:28", "text": "理论研究之类的东西都完成了，因为我"}, {"type": "subtitle", "time": 14430.87, "timestamp": "04:00:30", "text": "主要目标是实现这一点。"}, {"type": "subtitle", "time": 14433.83, "timestamp": "04:00:33", "text": "正在进行理论构建，以便我的"}, {"type": "subtitle", "time": 14436.07, "timestamp": "04:00:36", "text": "溪流"}, {"type": "subtitle", "time": 14439.349, "timestamp": "04:00:39", "text": "或者我发的推文，或者光线"}, {"type": "subtitle", "time": 14442.63, "timestamp": "04:00:42", "text": "小说、漫画或音乐视频，任何东西"}, {"type": "subtitle", "time": 14444.309, "timestamp": "04:00:44", "text": "他们总会藏着一个秘密。"}, {"type": "subtitle", "time": 14447.429, "timestamp": "04:00:47", "text": "甚至我的 Discord 状态里都有秘密。"}, {"type": "subtitle", "time": 14450.07, "timestamp": "04:00:50", "text": "这就是为什么我要叫别人来跟踪我。"}, {"type": "subtitle", "time": 14453.429, "timestamp": "04:00:53", "text": "跟踪我吧，我想要比你更多的跟踪者。"}, {"type": "subtitle", "time": 14455.51, "timestamp": "04:00:55", "text": "眨眼。"}, {"type": "subtitle", "time": 14458.389, "timestamp": "04:00:58", "text": "我刚才并没有那样说。我的天啊。我"}, {"type": "subtitle", "time": 14459.75, "timestamp": "04:00:59", "text": "我的意思是，我正在尝试建立 Discord。"}]
[{"type": "subtitle", "time": 13081.91, "timestamp": "03:38:01", "text": "正确的？我认为我们还没有看到这种情况。"}, {"type": "subtitle", "time": 13085.349, "timestamp": "03:38:05", "text": "很多游戏主播都遇到过这种情况。"}, {"type": "subtitle", "time": 13088.229, "timestamp": "03:38:08", "text": "你可能在某个地方看到过它"}, {"type": "subtitle", "time": 13091.429, "timestamp": "03:38:11", "text": "她不小心在推特上发了一条消息。"}, {"type": "subtitle", "time": 13093.59, "timestamp": "03:38:13", "text": "用主账号发推文，而不是在推特上发。"}, {"type": "subtitle", "time": 13096.229, "timestamp": "03:38:16", "text": "她的私人账户，"}, {"type": "subtitle", "time": 13100.389, "timestamp": "03:38:20", "text": "正确的？是的。是的。是的。就是这样。"}, {"type": "subtitle", "time": 13102.63, "timestamp": "03:38:22", "text": "如果主播不小心透露了"}, {"type": "subtitle", "time": 13104.15, "timestamp": "03:38:24", "text": "某物，"}, {"type": "subtitle", "time": 13105.51, "timestamp": "03:38:25", "text": "不小心透露了什么。如果"}, {"type": "subtitle", "time": 13107.67, "timestamp": "03:38:27", "text": "那些为这位主播疯狂的人"}, {"type": "subtitle", "time": 13112.63, "timestamp": "03:38:32", "text": "如果他们遵守他们的法律，他们就会……"}, {"type": "subtitle", "time": 13115.59, "timestamp": "03:38:35", "text": "我知道你一直在挖掘，挖掘得更多。"}, {"type": "subtitle", "time": 13119.19, "timestamp": "03:38:39", "text": "他们会找到自己的身份认同等等。"}, {"type": "subtitle", "time": 13120.79, "timestamp": "03:38:40", "text": "呃"}, {"type": "subtitle", "time": 13124.55, "timestamp": "03:38:44", "text": "移除和擦除这些物品可能会很麻烦。"}, {"type": "subtitle", "time": 13127.67, "timestamp": "03:38:47", "text": "痕迹。所以这就是 opsac 的原因"}, {"type": "subtitle", "time": 13129.99, "timestamp": "03:38:49", "text": "opsac 的全称是 let me grab it"}, {"type": "subtitle", "time": 13133.19, "timestamp": "03:38:53", "text": "对你来说，opsac 将是"}, {"type": "subtitle", "time": 13134.79, "timestamp": "03:38:54", "text": "呃"}, {"type": "subtitle", "time": 13137.99, "timestamp": "03:38:57", "text": "是的，安全行动"}]
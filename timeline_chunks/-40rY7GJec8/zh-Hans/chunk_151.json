[{"type": "subtitle", "time": 9065.99, "timestamp": "02:31:05", "text": "不。"}, {"type": "subtitle", "time": 9068.469, "timestamp": "02:31:08", "text": "我的订阅用户数量没有我想象的那么多。"}, {"type": "subtitle", "time": 9070.07, "timestamp": "02:31:10", "text": "本来很想去的。你放手的那一刻"}, {"type": "subtitle", "time": 9073.19, "timestamp": "02:31:13", "text": "你眼药水滴在这些地方，我只知道"}, {"type": "subtitle", "time": 9075.27, "timestamp": "02:31:15", "text": "你已经彻底完蛋了。所以，我"}, {"type": "subtitle", "time": 9077.91, "timestamp": "02:31:17", "text": "我必须坚持下去，重新振作起来，并取得进步。"}, {"type": "subtitle", "time": 9080.07, "timestamp": "02:31:20", "text": "一大批粉丝和订阅者"}, {"type": "subtitle", "time": 9082.79, "timestamp": "02:31:22", "text": "一击。"}, {"type": "subtitle", "time": 9085.59, "timestamp": "02:31:25", "text": "我来享用一顿饭了。"}, {"type": "subtitle", "time": 9087.67, "timestamp": "02:31:27", "text": "她得到了"}, {"type": "subtitle", "time": 9089.75, "timestamp": "02:31:29", "text": "122,000"}, {"type": "subtitle", "time": 9092.07, "timestamp": "02:31:32", "text": "粉丝。"}, {"type": "subtitle", "time": 9094.07, "timestamp": "02:31:34", "text": "哇。"}, {"type": "subtitle", "time": 9096.23, "timestamp": "02:31:36", "text": "这让我看起来像是说我们不应该杀自己。"}, {"type": "subtitle", "time": 9097.99, "timestamp": "02:31:37", "text": "一起"}, {"type": "subtitle", "time": 9099.32, "timestamp": "02:31:39", "text": "同样"}, {"type": "subtitle", "time": 9102.309, "timestamp": "02:31:42", "text": "[音乐]"}, {"type": "subtitle", "time": 9105.11, "timestamp": "02:31:45", "text": "明天。好的。我知道为什么。呃，如何"}, {"type": "subtitle", "time": 9107.11, "timestamp": "02:31:47", "text": "我会直播多久？ 3个小时，对吧？"}, {"type": "subtitle", "time": 9110.79, "timestamp": "02:31:50", "text": "我可能一会儿就该结束直播了。"}, {"type": "subtitle", "time": 9112.63, "timestamp": "02:31:52", "text": "这是什么？她正在播放视频"}, {"type": "subtitle", "time": 9118.23, "timestamp": "02:31:58", "text": "但这件事已经让我花费了不止"}]
[{"type": "subtitle", "time": 16754.23, "timestamp": "04:39:14", "text": "我不小心做了這個。  這是錯誤的。  哦，等等。"}, {"type": "subtitle", "time": 16764.39, "timestamp": "04:39:24", "text": "我"}, {"type": "subtitle", "time": 16768.23, "timestamp": "04:39:28", "text": "犯了個大錯。所以如果"}, {"type": "subtitle", "time": 16772.39, "timestamp": "04:39:32", "text": "我切換到對話場景，聊天框將真正顯示可見，而遊戲聊天將不可見，過濾器將變為正常狀態。  好了，現在我"}, {"type": "subtitle", "time": 16776.39, "timestamp": "04:39:36", "text": "修好了。好的。現在情況會好起來的。"}]
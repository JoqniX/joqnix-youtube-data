[{"type": "subtitle", "time": 1441.11, "timestamp": "00:24:01", "text": "時間了。我想我已經一個星期沒"}, {"type": "subtitle", "time": 1444.149, "timestamp": "00:24:04", "text": "直播了。正確的。"}, {"type": "subtitle", "time": 1448.23, "timestamp": "00:24:08", "text": "呃，我不知道從哪裡開始，但"}, {"type": "subtitle", "time": 1452.63, "timestamp": "00:24:12", "text": "我有個很方便的工具，我可以把"}, {"type": "subtitle", "time": 1456.149, "timestamp": "00:24:16", "text": "主要的重要部分寫在螢幕上，這樣"}, {"type": "subtitle", "time": 1459.43, "timestamp": "00:24:19", "text": "你就能看到了。好的。你好。是的，"}, {"type": "subtitle", "time": 1461.59, "timestamp": "00:24:21", "text": "歡迎各位光臨。大家好。"}, {"type": "subtitle", "time": 1465.83, "timestamp": "00:24:25", "text": "你好。這是打招呼。"}, {"type": "subtitle", "time": 1469.11, "timestamp": "00:24:29", "text": "所以，是的，讓我們開始吧，從現在開始，頻道將進行"}, {"type": "subtitle", "time": 1471.35, "timestamp": "00:24:31", "text": "重大"}, {"type": "subtitle", "time": 1475.75, "timestamp": "00:24:35", "text": "改版，或者更像是一次"}, {"type": "subtitle", "time": 1479.83, "timestamp": "00:24:39", "text": "更新"}, {"type": "subtitle", "time": 1481.75, "timestamp": "00:24:41", "text": "。"}, {"type": "subtitle", "time": 1486.23, "timestamp": "00:24:46", "text": "其中之一就是"}, {"type": "subtitle", "time": 1489.75, "timestamp": "00:24:49", "text": "我在 YouTube 頻道上做的「天體故事」系列，"}, {"type": "subtitle", "time": 1493.19, "timestamp": "00:24:53", "text": "我會上傳 5 到 10"}, {"type": "subtitle", "time": 1497.11, "timestamp": "00:24:57", "text": "分鐘的獨白故事，在故事裡"}]
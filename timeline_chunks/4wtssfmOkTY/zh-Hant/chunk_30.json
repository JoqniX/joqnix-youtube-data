[{"type": "subtitle", "time": 1810.07, "timestamp": "00:30:10", "text": "低，低，低。所有東西都很低，對吧？"}, {"type": "subtitle", "time": 1813.83, "timestamp": "00:30:13", "text": "而且所有東西都很低。"}, {"type": "subtitle", "time": 1816.23, "timestamp": "00:30:16", "text": "盛開。沒有。景深。沒有。"}, {"type": "subtitle", "time": 1822.389, "timestamp": "00:30:22", "text": "好的。"}, {"type": "subtitle", "time": 1825.35, "timestamp": "00:30:25", "text": "如何在X1上運行它？有人"}, {"type": "subtitle", "time": 1836.149, "timestamp": "00:30:36", "text": "為什麼渲染比例設為超高？我的"}, {"type": "subtitle", "time": 1844.31, "timestamp": "00:30:44", "text": "幀速率限制"}]
[{"type": "subtitle", "time": 7517.669, "timestamp": "02:05:17", "text": "既然我們選擇了優勢方，那就閉上眼睛吧"}, {"type": "subtitle", "time": 7532.79, "timestamp": "02:05:32", "text": "看不見。我的首選密鑰。  開始了。"}, {"type": "subtitle", "time": 7547.03, "timestamp": "02:05:47", "text": "我準備好了。哦，找到了。  嗯，他最近玩過民主蒸汽匹配系統嗎"}, {"type": "subtitle", "time": 7550.55, "timestamp": "02:05:50", "text": "？哦，它沒有Steam匹配"}, {"type": "subtitle", "time": 7552.39, "timestamp": "02:05:52", "text": "功能。好吧，我也看不見。我……讓"}, {"type": "subtitle", "time": 7559.189, "timestamp": "02:05:59", "text": "我想想。終點站。  我們先選擇最近的方案，因為我們寧願先把他們踢出局，選擇最接近的方案。我的"}]
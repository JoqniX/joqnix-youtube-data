[{"type": "subtitle", "time": 2701.589, "timestamp": "00:45:01", "text": "X1。哦"}, {"type": "subtitle", "time": 2703.349, "timestamp": "00:45:03", "text": "好的。我覺得我躲過了攻擊，活了下來。"}, {"type": "subtitle", "time": 2707.349, "timestamp": "00:45:07", "text": "我親眼見過那塊"}, {"type": "subtitle", "time": 2722.55, "timestamp": "00:45:22", "text": "奶油。  是的。勉強活了下來。  我活著。  我挨了好幾記直衝猛擊，居然還活著。我死於撞擊。  你穿的是重甲吧？是的，"}, {"type": "subtitle", "time": 2724.63, "timestamp": "00:45:24", "text": "很重。這就是我為什麼會輸掉這麼多比賽的原因。"}, {"type": "subtitle", "time": 2726.71, "timestamp": "00:45:26", "text": "沒錯，那它救了你好"}, {"type": "subtitle", "time": 2730.15, "timestamp": "00:45:30", "text": "幾次命。"}, {"type": "subtitle", "time": 2733.19, "timestamp": "00:45:33", "text": "我的天啊。那東西在哪裡？  好了，"}, {"type": "subtitle", "time": 2754.71, "timestamp": "00:45:54", "text": "我想我現在可以加入他了。哦，我們走吧。耶！人越多越好。是的。  民主。砰砰。我是為了民主而來。  自由。  有沒有什麼關於地獄多樣性的新梗圖之類的東西？"}, {"type": "subtitle", "time": 2757.589, "timestamp": "00:45:57", "text": "我認為自從第三派出現以來，應該會有更多"}]
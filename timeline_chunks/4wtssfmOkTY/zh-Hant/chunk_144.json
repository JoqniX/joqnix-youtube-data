[{"type": "subtitle", "time": 8656.95, "timestamp": "02:24:16", "text": "呃，不。不，不，不是"}, {"type": "subtitle", "time": 8658.95, "timestamp": "02:24:18", "text": "。事情並非如此"}, {"type": "subtitle", "time": 8660.95, "timestamp": "02:24:20", "text": "。民主具有保護作用。是的"}, {"type": "subtitle", "time": 8663.75, "timestamp": "02:24:23", "text": "。  總之，那是顆健康炸彈嗎？"}, {"type": "subtitle", "time": 8667.91, "timestamp": "02:24:27", "text": "哦，不。我為什麼要務農"}, {"type": "subtitle", "time": 8679.67, "timestamp": "02:24:39", "text": "我不知道我為什麼會在這裡"}, {"type": "subtitle", "time": 8684.15, "timestamp": "02:24:44", "text": "。  我為什麼會在這裡？"}, {"type": "subtitle", "time": 8699.27, "timestamp": "02:24:59", "text": "他們為什麼要巡邏？  謝天謝地他們走了"}]
[{"type": "subtitle", "time": 841.75, "timestamp": "00:14:01", "text": "背後說我壞話了？精心製作的。我"}, {"type": "subtitle", "time": 845.11, "timestamp": "00:14:05", "text": "願意理解，也希望你能從"}, {"type": "subtitle", "time": 846.949, "timestamp": "00:14:06", "text": "你的角度詳細說明"}, {"type": "subtitle", "time": 850.069, "timestamp": "00:14:10", "text": "。你可以問。他們會被安排在"}, {"type": "subtitle", "time": 853.269, "timestamp": "00:14:13", "text": "一個必須"}, {"type": "subtitle", "time": 860.31, "timestamp": "00:14:20", "text": "。根據對方的回應，你"}, {"type": "subtitle", "time": 862.15, "timestamp": "00:14:22", "text": "可能還是會和他們做朋友，或"}, {"type": "subtitle", "time": 864.15, "timestamp": "00:14:24", "text": "最好斷絕關係，"}, {"type": "subtitle", "time": 872.79, "timestamp": "00:14:32", "text": "但實際上，你可以用不同的方法來做"}, {"type": "subtitle", "time": 876.069, "timestamp": "00:14:36", "text": "這件事。別理他，做"}, {"type": "subtitle", "time": 878.069, "timestamp": "00:14:38", "text": "你自己的事就好。為什麼要在意"}, {"type": "subtitle", "time": 879.829, "timestamp": "00:14:39", "text": "別人背後議論你呢？這一切都在"}, {"type": "subtitle", "time": 882.23, "timestamp": "00:14:42", "text": "網路上，對吧？"}, {"type": "subtitle", "time": 885.99, "timestamp": "00:14:45", "text": "我也是，你們每個人都遇過類似的事情，對吧？嗯……"}]
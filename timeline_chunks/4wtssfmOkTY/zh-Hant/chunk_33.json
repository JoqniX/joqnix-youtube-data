[{"type": "subtitle", "time": 1982.47, "timestamp": "00:33:02", "text": "嘿，夥計。"}, {"type": "subtitle", "time": 1984.389, "timestamp": "00:33:04", "text": "相同的。"}, {"type": "subtitle", "time": 1987.35, "timestamp": "00:33:07", "text": "上次沒成功。"}, {"type": "subtitle", "time": 1989.909, "timestamp": "00:33:09", "text": "我想念我的……是的"}, {"type": "subtitle", "time": 1993.19, "timestamp": "00:33:13", "text": "，我想念我以前"}, {"type": "subtitle", "time": 1999.669, "timestamp": "00:33:19", "text": "玩這個遊戲時用的那台電腦，但是它壞了。是的。"}, {"type": "subtitle", "time": 2004.23, "timestamp": "00:33:24", "text": "我的畫面看起來像像素畫。"}, {"type": "subtitle", "time": 2006.95, "timestamp": "00:33:26", "text": "我在玩一款像素遊戲，不過沒關係。"}, {"type": "subtitle", "time": 2013.11, "timestamp": "00:33:33", "text": "是的，這是一款像素遊戲，而且畫面精美。"}, {"type": "subtitle", "time": 2022.789, "timestamp": "00:33:42", "text": "好的。我的天哪，我的電腦快不行了。"}, {"type": "subtitle", "time": 2025.19, "timestamp": "00:33:45", "text": "它怎麼還在死亡？"}, {"type": "subtitle", "time": 2034.71, "timestamp": "00:33:54", "text": "天哪，我玩"}, {"type": "subtitle", "time": 2036.549, "timestamp": "00:33:56", "text": "這個遊戲真的很不擅長。  沒關係。"}, {"type": "subtitle", "time": 2038.789, "timestamp": "00:33:58", "text": "別擔心。我會想"}]
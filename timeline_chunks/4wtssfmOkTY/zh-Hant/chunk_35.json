[{"type": "subtitle", "time": 2101.589, "timestamp": "00:35:01", "text": "現在不要。至少目前是這樣。現在不要"}, {"type": "subtitle", "time": 2108.39, "timestamp": "00:35:08", "text": "Shonix先生，您其實可以加入我們。"}, {"type": "subtitle", "time": 2110.55, "timestamp": "00:35:10", "text": "是的，我正在設定遊戲。"}, {"type": "subtitle", "time": 2113.75, "timestamp": "00:35:13", "text": "非常卡頓。我的電腦快不行了。啊，"}, {"type": "subtitle", "time": 2116.63, "timestamp": "00:35:16", "text": "這很正常。"}, {"type": "subtitle", "time": 2119.67, "timestamp": "00:35:19", "text": "為什麼需要花這麼多時間？"}, {"type": "subtitle", "time": 2122.39, "timestamp": "00:35:22", "text": "等等，"}, {"type": "subtitle", "time": 2127.75, "timestamp": "00:35:27", "text": "耶穌。"}, {"type": "subtitle", "time": 2130.63, "timestamp": "00:35:30", "text": "我看到了一聲巨響。"}, {"type": "subtitle", "time": 2132.87, "timestamp": "00:35:32", "text": "大滑塊。"}, {"type": "subtitle", "time": 2134.79, "timestamp": "00:35:34", "text": "我想那應該是工廠生產的滑板車。對不起。是的，不是"}, {"type": "subtitle", "time": 2137.829, "timestamp": "00:35:37", "text": "工廠生產的滑翔機。嗯，這是一家普通的"}, {"type": "subtitle", "time": 2139.99, "timestamp": "00:35:39", "text": "工廠。"}, {"type": "subtitle", "time": 2142.47, "timestamp": "00:35:42", "text": "這是正常的工廠色號。等等，"}, {"type": "subtitle", "time": 2144.79, "timestamp": "00:35:44", "text": "你說的「正常」是什麼意思？普通工廠。哦，"}, {"type": "subtitle", "time": 2148.31, "timestamp": "00:35:48", "text": "普通的工廠。普通工廠。我"}, {"type": "subtitle", "time": 2150.069, "timestamp": "00:35:50", "text": "以為你說的是普通的工廠啟動器，"}, {"type": "subtitle", "time": 2151.91, "timestamp": "00:35:51", "text": "然後我就想，等等，還有各種各樣的啟動器呢"}]
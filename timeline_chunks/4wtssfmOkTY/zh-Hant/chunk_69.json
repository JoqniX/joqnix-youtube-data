[{"type": "subtitle", "time": 4145.269, "timestamp": "01:09:05", "text": "。這就是這款"}, {"type": "subtitle", "time": 4150.07, "timestamp": "01:09:10", "text": "遊戲的妙處。  不用花一分錢。好的。你們覺得這位大師有價值嗎？  我的意思是，"}, {"type": "subtitle", "time": 4152.63, "timestamp": "01:09:12", "text": "這個表情包很有趣。我喜歡上面的表情符號。"}, {"type": "subtitle", "time": 4167.91, "timestamp": "01:09:27", "text": "其實我買它"}, {"type": "subtitle", "time": 4169.269, "timestamp": "01:09:29", "text": "只是為了那個"}, {"type": "subtitle", "time": 4177.43, "timestamp": "01:09:37", "text": "彩蛋。"}, {"type": "subtitle", "time": 4190.789, "timestamp": "01:09:50", "text": "如何獲得行進表情？  嗯，司儀是戰爭債券。哦，是第一個。不，不，不。最新一個。  那是最近發行的"}]
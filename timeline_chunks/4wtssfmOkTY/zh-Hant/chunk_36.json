[{"type": "subtitle", "time": 2167.19, "timestamp": "00:36:07", "text": "順便提一下策略。"}, {"type": "subtitle", "time": 2173.589, "timestamp": "00:36:13", "text": "天啊，我的電腦快要壞了。"}, {"type": "subtitle", "time": 2176.31, "timestamp": "00:36:16", "text": "喔不，"}, {"type": "subtitle", "time": 2179.67, "timestamp": "00:36:19", "text": "這遊戲要跟我玩了。"}, {"type": "subtitle", "time": 2181.589, "timestamp": "00:36:21", "text": "我終於把這該死的"}, {"type": "subtitle", "time": 2184.55, "timestamp": "00:36:24", "text": "遊戲優化好了。我花了好長時間。各位，"}, {"type": "subtitle", "time": 2187.03, "timestamp": "00:36:27", "text": "我死了。各位，我死了。例如，"}, {"type": "subtitle", "time": 2211.75, "timestamp": "00:36:51", "text": "我該怎麼跟"}, {"type": "subtitle", "time": 2217.829, "timestamp": "00:36:57", "text": "你們這些傢伙擦肩而過"}]
[{"type": "subtitle", "time": 35253.11, "timestamp": "09:47:33", "text": "等等，我該去哪裡？這邊走。現在我滿"}, {"type": "subtitle", "time": 35262.07, "timestamp": "09:47:42", "text": "血就能雙倍恢復了。耶。 [音樂] 啊。為什麼不呢？我的天。這是什麼地方？ [音樂]"}, {"type": "subtitle", "time": 35267.03, "timestamp": "09:47:47", "text": "反正我也不應該去。怎麼"}, {"type": "subtitle", "time": 35269.586, "timestamp": "09:47:49", "text": "回事？我的天啊。我"}, {"type": "subtitle", "time": 35272.07, "timestamp": "09:47:52", "text": "現在只剩1點生命值了。我們又見面了。不。有人已經殺了我。為什麼"}]
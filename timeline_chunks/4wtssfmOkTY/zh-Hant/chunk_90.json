[{"type": "subtitle", "time": 5401.189, "timestamp": "01:30:01", "text": "雷射照射過來。我會很興奮。它被自己的隊友擊斃了"}, {"type": "subtitle", "time": 5410.31, "timestamp": "01:30:10", "text": "。  是的"}, {"type": "subtitle", "time": 5411.83, "timestamp": "01:30:11", "text": "，哦，"}, {"type": "subtitle", "time": 5414.07, "timestamp": "01:30:14", "text": "我喜歡他們那樣添加東西。那件事一定會發生。  確實如此。"}, {"type": "subtitle", "time": 5420.95, "timestamp": "01:30:20", "text": "媽的。  哦，他們改進了助行器。現在它簡直就是一台8080了。是的。有人"}, {"type": "subtitle", "time": 5429.669, "timestamp": "01:30:29", "text": "過世了嗎？好的。是的。我當時沒注意，結果被殺了。  謝謝。  射擊。  好了。  這是什麼東西？這是什麼小型工廠？糟糕。  我"}]
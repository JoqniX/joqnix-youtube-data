[{"type": "subtitle", "time": 31093.43, "timestamp": "08:38:13", "text": "是的。"}, {"type": "subtitle", "time": 31102.15, "timestamp": "08:38:22", "text": "媽媽。  等待。"}, {"type": "subtitle", "time": 31112.23, "timestamp": "08:38:32", "text": "哦，我剛谷歌了一下。"}, {"type": "subtitle", "time": 31123.35, "timestamp": "08:38:43", "text": "我會忘記我的英文。沒關係。別擔心。是的。  很簡單。"}, {"type": "subtitle", "time": 31129.03, "timestamp": "08:38:49", "text": "英語甚至不是我的母語，所以沒關係。別擔心。是的。  為什麼穿這身衣服"}]
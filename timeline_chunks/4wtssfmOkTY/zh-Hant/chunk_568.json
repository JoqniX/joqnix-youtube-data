[{"type": "subtitle", "time": 34080.71, "timestamp": "09:28:00", "text": "。歡迎回來。"}, {"type": "subtitle", "time": 34097.83, "timestamp": "09:28:17", "text": "我們又回到這裡了。"}, {"type": "subtitle", "time": 34108.23, "timestamp": "09:28:28", "text": "我知道這是雨淋濕了我的衣服"}, {"type": "subtitle", "time": 34111.586, "timestamp": "09:28:31", "text": "。哦。哦不。來吧。希望你能在下雨前把雲都趕走。不。是的。淋濕了。讓你的草坪也"}]
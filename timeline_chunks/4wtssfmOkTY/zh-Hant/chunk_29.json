[{"type": "subtitle", "time": 1750.31, "timestamp": "00:29:10", "text": "這遊戲太卡了。"}, {"type": "subtitle", "time": 1760.389, "timestamp": "00:29:20", "text": "恢復主要訂單。這是什麼鬼東西"}, {"type": "subtitle", "time": 1776.71, "timestamp": "00:29:36", "text": "八天前，零點。"}, {"type": "subtitle", "time": 1779.909, "timestamp": "00:29:39", "text": "武器自訂功能已解鎖。"}, {"type": "subtitle", "time": 1781.99, "timestamp": "00:29:41", "text": "呃，"}, {"type": "subtitle", "time": 1785.669, "timestamp": "00:29:45", "text": "我把"}, {"type": "subtitle", "time": 1787.99, "timestamp": "00:29:47", "text": "畫面設定調低點。我的天，居然是中等畫質。"}, {"type": "subtitle", "time": 1789.75, "timestamp": "00:29:49", "text": "沒有。沒有。沒有。沒有。沒有。沒有。  沒有。沒有。沒有。"}, {"type": "subtitle", "time": 1793.909, "timestamp": "00:29:53", "text": "降低。  降低速度。"}, {"type": "subtitle", "time": 1799.11, "timestamp": "00:29:59", "text": "甚至更低。好的。"}]
[{"type": "subtitle", "time": 1869.43, "timestamp": "00:31:09", "text": "我必須申請，我的天"}, {"type": "subtitle", "time": 1872.07, "timestamp": "00:31:12", "text": "。我看起來像個…這個遊戲"}, {"type": "subtitle", "time": 1874.71, "timestamp": "00:31:14", "text": "現在變成像素遊戲了。沒關係。"}, {"type": "subtitle", "time": 1884.47, "timestamp": "00:31:24", "text": "我得把所有東西都調整"}, {"type": "subtitle", "time": 1887.35, "timestamp": "00:31:27", "text": "好。"}, {"type": "subtitle", "time": 1891.909, "timestamp": "00:31:31", "text": "好的。呃，讓我切換到我的 PNG 格式，"}, {"type": "subtitle", "time": 1895.59, "timestamp": "00:31:35", "text": "然後我要退出視訊工作室，"}, {"type": "subtitle", "time": 1899.11, "timestamp": "00:31:39", "text": "我們就會得到一個 Q 版的騎師。"}, {"type": "subtitle", "time": 1901.19, "timestamp": "00:31:41", "text": "我必須加入Discord，但是Discord"}, {"type": "subtitle", "time": 1911.509, "timestamp": "00:31:51", "text": "呃，它沒顯示出來嗎？好了，找到了。"}, {"type": "subtitle", "time": 1916.389, "timestamp": "00:31:56", "text": "我需要把滑鼠換成"}]
[{"type": "subtitle", "time": 28758.23, "timestamp": "07:59:18", "text": "要死了。  喲，因為他"}, {"type": "subtitle", "time": 28759.99, "timestamp": "07:59:19", "text": "看不見那堵牆。啊，不。現在輪到法律人士了。  一個月有28天。哦，二月。  我的天哪。"}, {"type": "subtitle", "time": 28766.868, "timestamp": "07:59:26", "text": "不，哦，疼痛。  好痛。  不用擔心。我們"}]
[{"type": "subtitle", "time": 20360.23, "timestamp": "05:39:20", "text": "因為我想和你們一起享受。拜拜，我可不是傻瓜。唉，我跟你一起去音樂節的夢想"}, {"type": "subtitle", "time": 20371.75, "timestamp": "05:39:31", "text": "破滅了。你沒告訴我"}, {"type": "subtitle", "time": 20374.07, "timestamp": "05:39:34", "text": "今天是星期幾。我不是告訴過你那個星期六是什麼安排嗎"}]
[{"type": "subtitle", "time": 1382.31, "timestamp": "00:23:02", "text": "大家好！希望大家都"}, {"type": "subtitle", "time": 1384.149, "timestamp": "00:23:04", "text": "好。  嗯，"}, {"type": "subtitle", "time": 1387.43, "timestamp": "00:23:07", "text": "我開這個直播是為了"}, {"type": "subtitle", "time": 1389.19, "timestamp": "00:23:09", "text": "宣布一些事情並提供一些"}, {"type": "subtitle", "time": 1394.47, "timestamp": "00:23:14", "text": "最新進展。所以，呃，如果你正在收聽，呃，"}, {"type": "subtitle", "time": 1396.549, "timestamp": "00:23:16", "text": "感謝你遠道而來，"}, {"type": "subtitle", "time": 1399.909, "timestamp": "00:23:19", "text": "認真聆聽這個"}, {"type": "subtitle", "time": 1403.59, "timestamp": "00:23:23", "text": "公告。這對我意義重大。所以，"}, {"type": "subtitle", "time": 1405.909, "timestamp": "00:23:25", "text": "呃，我不會說這個消息會引起太大的轟動"}, {"type": "subtitle", "time": 1409.43, "timestamp": "00:23:29", "text": "。希望我不會因為"}, {"type": "subtitle", "time": 1415.51, "timestamp": "00:23:35", "text": "說話太多而搞砸，嗯，所以，嗯，我也會盡量不說話，"}, {"type": "subtitle", "time": 1420.549, "timestamp": "00:23:40", "text": "我會"}, {"type": "subtitle", "time": 1423.35, "timestamp": "00:23:43", "text": "讀聊天記錄，但我會盡量不"}, {"type": "subtitle", "time": 1426.23, "timestamp": "00:23:46", "text": "插話，而是"}, {"type": "subtitle", "time": 1429.19, "timestamp": "00:23:49", "text": "大聲讀出來，因為，嗯，我希望這個"}, {"type": "subtitle", "time": 1431.99, "timestamp": "00:23:51", "text": "公告能以視頻的"}, {"type": "subtitle", "time": 1434.63, "timestamp": "00:23:54", "text": "形式呈現，嗯，"}, {"type": "subtitle", "time": 1438.149, "timestamp": "00:23:58", "text": "所以，首先，嗯，已經過去一段"}]
[{"type": "subtitle", "time": 19265.19, "timestamp": "05:21:05", "text": "你能找回自我，重新做回你自己。我昨天做了個"}, {"type": "subtitle", "time": 19271.51, "timestamp": "05:21:11", "text": "惡夢，希望你能得到我的愛。哦，"}, {"type": "subtitle", "time": 19273.99, "timestamp": "05:21:13", "text": "不。  哦，不。  我的天哪。"}, {"type": "subtitle", "time": 19297.91, "timestamp": "05:21:37", "text": "噓，過來。讓我回去吧。"}, {"type": "subtitle", "time": 19301.19, "timestamp": "05:21:41", "text": "我希望可以用這個來做ASMR。我可以做ASMR。"}, {"type": "subtitle", "time": 19305.91, "timestamp": "05:21:45", "text": "我只是需要一句「哦，等等」。"}, {"type": "subtitle", "time": 19311.59, "timestamp": "05:21:51", "text": "即時"}, {"type": "subtitle", "time": 19317.03, "timestamp": "05:21:57", "text": "ASMR功能怎麼了？我以前有語音指令功能，對吧？"}]
[{"type": "subtitle", "time": 1501.43, "timestamp": "00:25:01", "text": "我會說話、敘述和"}, {"type": "subtitle", "time": 1505.83, "timestamp": "00:25:05", "text": "吹口哨。呃，由於本系列節目之後將有一項重大事件宣布，因此該系列節目將暫停播出"}, {"type": "subtitle", "time": 1511.43, "timestamp": "00:25:11", "text": "。所以，是的，那件事暫時會"}, {"type": "subtitle", "time": 1514.549, "timestamp": "00:25:14", "text": "暫停。"}, {"type": "subtitle", "time": 1517.029, "timestamp": "00:25:17", "text": "我覺得我現在沒辦法集中精神做這件事"}, {"type": "subtitle", "time": 1519.35, "timestamp": "00:25:19", "text": "。稍後我會以"}, {"type": "subtitle", "time": 1522.71, "timestamp": "00:25:22", "text": "更高品質的格式重新上傳。所以，這是"}, {"type": "subtitle", "time": 1526.71, "timestamp": "00:25:26", "text": "第一個要宣布的消息，"}, {"type": "subtitle", "time": 1529.669, "timestamp": "00:25:29", "text": "其次，嗯，"}, {"type": "subtitle", "time": 1533.83, "timestamp": "00:25:33", "text": "好吧，這是"}, {"type": "subtitle", "time": 1536.39, "timestamp": "00:25:36", "text": "我要宣布的主要消息，在"}, {"type": "subtitle", "time": 1541.83, "timestamp": "00:25:41", "text": "我們開始之前，嗯，天哪，這"}, {"type": "subtitle", "time": 1546.87, "timestamp": "00:25:46", "text": "太難了，太難了，所以，嗯，"}, {"type": "subtitle", "time": 1552.23, "timestamp": "00:25:52", "text": "天哪，我做不到，好吧。"}, {"type": "subtitle", "time": 1554.71, "timestamp": "00:25:54", "text": "所以，"}, {"type": "subtitle", "time": 1556.71, "timestamp": "00:25:56", "text": "我計劃直播的主要內容是"}]
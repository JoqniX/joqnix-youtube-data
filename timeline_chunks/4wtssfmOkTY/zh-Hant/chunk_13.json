[{"type": "subtitle", "time": 780.31, "timestamp": "00:13:00", "text": "我的建議是，總是會"}, {"type": "subtitle", "time": 782.31, "timestamp": "00:13:02", "text": "有人在背後議論"}, {"type": "subtitle", "time": 785.43, "timestamp": "00:13:05", "text": "你。"}, {"type": "subtitle", "time": 787.99, "timestamp": "00:13:07", "text": "我覺得我常被人議論，"}, {"type": "subtitle", "time": 791.11, "timestamp": "00:13:11", "text": "誰知道呢，我不在乎。但是，當然，如果我"}, {"type": "subtitle", "time": 792.87, "timestamp": "00:13:12", "text": "知道有人在背後議論你，"}, {"type": "subtitle", "time": 795.59, "timestamp": "00:13:15", "text": "我一定會很難過。我會想，"}, {"type": "subtitle", "time": 799.19, "timestamp": "00:13:19", "text": "我信任那"}, {"type": "subtitle", "time": 802.55, "timestamp": "00:13:22", "text": "個人，他們為什麼要在背後說"}, {"type": "subtitle", "time": 805.19, "timestamp": "00:13:25", "text": "我壞話？"}, {"type": "subtitle", "time": 808.629, "timestamp": "00:13:28", "text": "我到底做錯了什麼？遇到這種"}, {"type": "subtitle", "time": 811.03, "timestamp": "00:13:31", "text": "情況，"}, {"type": "subtitle", "time": 813.829, "timestamp": "00:13:33", "text": "如果你知道真相，如果你是"}, {"type": "subtitle", "time": 816.389, "timestamp": "00:13:36", "text": "從別人那裡聽說的，"}, {"type": "subtitle", "time": 818.47, "timestamp": "00:13:38", "text": "如果你願意，你可以直接面對他們。"}, {"type": "subtitle", "time": 819.99, "timestamp": "00:13:39", "text": "如果你夠自信，能夠"}, {"type": "subtitle", "time": 823.91, "timestamp": "00:13:43", "text": "承受這一切，那就去做吧。"}, {"type": "subtitle", "time": 825.829, "timestamp": "00:13:45", "text": "現在有很多方法可以做到這一點。"}, {"type": "subtitle", "time": 827.43, "timestamp": "00:13:47", "text": "要嘛你就別再跟那個人說話了，"}, {"type": "subtitle", "time": 830.47, "timestamp": "00:13:50", "text": "要嘛就直接問"}, {"type": "subtitle", "time": 834.23, "timestamp": "00:13:54", "text": "他，像是「嘿，我聽說了"}, {"type": "subtitle", "time": 836.47, "timestamp": "00:13:56", "text": "這個，還有那個」。這是真的嗎？"}, {"type": "subtitle", "time": 838.47, "timestamp": "00:13:58", "text": "你是不是在"}]
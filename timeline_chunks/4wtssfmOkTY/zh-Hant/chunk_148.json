[{"type": "subtitle", "time": 8900.63, "timestamp": "02:28:20", "text": "糟糕。它就在"}, {"type": "subtitle", "time": 8905.11, "timestamp": "02:28:25", "text": "我身後，對吧？  是的，他就在你身後。  去叢林裡做點事。  [音樂] 我的天哪。"}, {"type": "subtitle", "time": 8909.51, "timestamp": "02:28:29", "text": "那都是我的錯。那都是"}, {"type": "subtitle", "time": 8913.99, "timestamp": "02:28:33", "text": "我的錯。  [音樂] 喔不，那是我的錯。我走進了你的"}]
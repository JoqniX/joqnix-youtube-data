[{"type": "subtitle", "time": 23472.628, "timestamp": "06:31:12", "text": "我等等，我沒解鎖。  耽誤。"}, {"type": "subtitle", "time": 23476.23, "timestamp": "06:31:16", "text": "我沒有解鎖這個。  [音樂] 等等，我"}, {"type": "subtitle", "time": 23480.708, "timestamp": "06:31:20", "text": "還沒解鎖這張。  哦，我沒解鎖國王站。  所以，等著瞧吧，我的天，這傢伙東西真多。  夢之門。"}]
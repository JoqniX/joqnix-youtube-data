[{"type": "subtitle", "time": 36663.19, "timestamp": "10:11:03", "text": "？好了，明白了。 [音樂] 如果我還有錢，我就走了。"}, {"type": "subtitle", "time": 36666.39, "timestamp": "10:11:06", "text": "啊，[音樂]"}, {"type": "subtitle", "time": 36669.35, "timestamp": "10:11:09", "text": "我不知道這行裡面是什麼。我其實什麼"}, {"type": "subtitle", "time": 36697.906, "timestamp": "10:11:37", "text": "啊。 [音樂] 我的天啊。"}, {"type": "subtitle", "time": 36709.83, "timestamp": "10:11:49", "text": "[音樂] 又來了。我就知道。更多。我又掉這麼多血了嗎？ [音樂] 下雨了"}]
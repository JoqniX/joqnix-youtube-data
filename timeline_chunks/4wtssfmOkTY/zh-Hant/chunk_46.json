[{"type": "subtitle", "time": 2761.91, "timestamp": "00:46:01", "text": "右翼勢力"}, {"type": "subtitle", "time": 2765.19, "timestamp": "00:46:05", "text": "。我的意思"}, {"type": "subtitle", "time": 2779.51, "timestamp": "00:46:19", "text": "是，我們確實擊敗了魷魚，消滅了"}, {"type": "subtitle", "time": 2788.71, "timestamp": "00:46:28", "text": "我們的魷魚。確切地"}, {"type": "subtitle", "time": 2790.87, "timestamp": "00:46:30", "text": "。等等，真的嗎？  是的。是的。糟糕。無論你何時聯繫他們，他們都會說“這裡有魷魚”或“魷魚”。"}, {"type": "subtitle", "time": 2793.829, "timestamp": "00:46:33", "text": "我們在那兒找到了魷魚"}, {"type": "subtitle", "time": 2796.309, "timestamp": "00:46:36", "text": "。所以這個梗是 f 炸魷魚是民主的，或者我覺得是叛國，我"}, {"type": "subtitle", "time": 2799.19, "timestamp": "00:46:39", "text": "不確定是"}, {"type": "subtitle", "time": 2804.63, "timestamp": "00:46:44", "text": "不是，但大概是這個意思。是的，背叛了我們的家園繁榮。  哦"}]
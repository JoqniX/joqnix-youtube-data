[{"type": "subtitle", "time": 3120.79, "timestamp": "00:52:00", "text": "得等几分钟才能拥抱"}, {"type": "subtitle", "time": 3123.99, "timestamp": "00:52:03", "text": "为你。拥抱。"}, {"type": "subtitle", "time": 3132.71, "timestamp": "00:52:12", "text": "等等，那是什么飞行物？"}, {"type": "subtitle", "time": 3135.109, "timestamp": "00:52:15", "text": "飞行器。这些是什么？"}, {"type": "subtitle", "time": 3137.99, "timestamp": "00:52:17", "text": "那是一艘超级驱逐舰。"}, {"type": "subtitle", "time": 3139.589, "timestamp": "00:52:19", "text": "哦，是的。哦好的。嘿，我当时就像"}, {"type": "subtitle", "time": 3141.19, "timestamp": "00:52:21", "text": "好奇的飞行物要去"}, {"type": "subtitle", "time": 3143.589, "timestamp": "00:52:23", "text": "我们即将被点燃。哦，那里有一个"}, {"type": "subtitle", "time": 3147.27, "timestamp": "00:52:27", "text": "如果真是那样的话，那就是这条街。"}, {"type": "subtitle", "time": 3155.91, "timestamp": "00:52:35", "text": "即将到达。西侧前线。糟糕。他们"}, {"type": "subtitle", "time": 3158.069, "timestamp": "00:52:38", "text": "称为强化。我带来了"}, {"type": "subtitle", "time": 3159.67, "timestamp": "00:52:39", "text": "枪战用的枪不对。没有"}, {"type": "subtitle", "time": 3167.43, "timestamp": "00:52:47", "text": "我的天哪，太惊险了。"}, {"type": "subtitle", "time": 3170.23, "timestamp": "00:52:50", "text": "是的。就那样躺在它们上面。"}, {"type": "subtitle", "time": 3173.27, "timestamp": "00:52:53", "text": "非常接近。"}]
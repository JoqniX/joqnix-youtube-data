[{"type": "subtitle", "time": 5701.35, "timestamp": "01:35:01", "text": "谢谢。我收到了样品。谢谢。"}, {"type": "subtitle", "time": 5704.95, "timestamp": "01:35:04", "text": "如果可以的话，也把我的矛拿走吧。嗯，我"}, {"type": "subtitle", "time": 5718.229, "timestamp": "01:35:18", "text": "我的天啊。"}, {"type": "subtitle", "time": 5721.03, "timestamp": "01:35:21", "text": "我不知道。"}, {"type": "subtitle", "time": 5724.55, "timestamp": "01:35:24", "text": "我非常惊讶。"}, {"type": "subtitle", "time": 5725.91, "timestamp": "01:35:25", "text": "可能还没进城。"}, {"type": "subtitle", "time": 5729.75, "timestamp": "01:35:29", "text": "然而。嗯，大概吧。哦，感谢上帝。那"}, {"type": "subtitle", "time": 5732.31, "timestamp": "01:35:32", "text": "它死了。"}, {"type": "subtitle", "time": 5734.95, "timestamp": "01:35:34", "text": "我的天啊。红色、黑色和白色"}, {"type": "subtitle", "time": 5736.31, "timestamp": "01:35:36", "text": "它让你想起一些非常非常的事情"}, {"type": "subtitle", "time": 5738.229, "timestamp": "01:35:38", "text": "坏的。"}, {"type": "subtitle", "time": 5741.669, "timestamp": "01:35:41", "text": "有趣的"}, {"type": "subtitle", "time": 5745.35, "timestamp": "01:35:45", "text": "舒老师，请上课。"}, {"type": "subtitle", "time": 5755.27, "timestamp": "01:35:55", "text": "你应该在哪里进行爆炸"}]
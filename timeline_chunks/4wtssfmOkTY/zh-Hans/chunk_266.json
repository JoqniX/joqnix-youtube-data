[{"type": "subtitle", "time": 15966.95, "timestamp": "04:26:06", "text": "你应该没问题。是的。然后就是"}, {"type": "subtitle", "time": 15969.429, "timestamp": "04:26:09", "text": "我宁愿"}, {"type": "subtitle", "time": 15979.59, "timestamp": "04:26:19", "text": "是的。那也是我最喜欢的之一。"}, {"type": "subtitle", "time": 15981.91, "timestamp": "04:26:21", "text": "歌曲。是的。"}, {"type": "subtitle", "time": 15984.389, "timestamp": "04:26:24", "text": "是的。是的。"}, {"type": "subtitle", "time": 15994.389, "timestamp": "04:26:34", "text": "嗯"}, {"type": "subtitle", "time": 15996.79, "timestamp": "04:26:36", "text": "不"}, {"type": "subtitle", "time": 15999.91, "timestamp": "04:26:39", "text": "但关键在于，当你学习……"}, {"type": "subtitle", "time": 16006.63, "timestamp": "04:26:46", "text": "当你听到这首歌并尝试唱出来时"}, {"type": "subtitle", "time": 16009.429, "timestamp": "04:26:49", "text": "会像"}, {"type": "subtitle", "time": 16014.79, "timestamp": "04:26:54", "text": "跟着唱，但漏唱了几句。"}, {"type": "subtitle", "time": 16018.229, "timestamp": "04:26:58", "text": "闪闪发光的东西很难做出来。人们不喜欢它。"}]
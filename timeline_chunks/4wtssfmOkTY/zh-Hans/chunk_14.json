[{"type": "subtitle", "time": 841.75, "timestamp": "00:14:01", "text": "说我坏话？精心制作的。我，我是"}, {"type": "subtitle", "time": 845.11, "timestamp": "00:14:05", "text": "我愿意理解，我希望你"}, {"type": "subtitle", "time": 846.949, "timestamp": "00:14:06", "text": "请你详细说明一下或其他什么。"}, {"type": "subtitle", "time": 850.069, "timestamp": "00:14:10", "text": "就是这样。你可以问。它们将被放置"}, {"type": "subtitle", "time": 853.269, "timestamp": "00:14:13", "text": "就像在某个地方，他们必须"}, {"type": "subtitle", "time": 860.31, "timestamp": "00:14:20", "text": "是的。根据对方的回答，你"}, {"type": "subtitle", "time": 862.15, "timestamp": "00:14:22", "text": "可能仍然和他们是朋友，或者……"}, {"type": "subtitle", "time": 864.15, "timestamp": "00:14:24", "text": "最好把它们切掉"}, {"type": "subtitle", "time": 872.79, "timestamp": "00:14:32", "text": "但你可以选择不同的路线。"}, {"type": "subtitle", "time": 876.069, "timestamp": "00:14:36", "text": "其实就是这样。忽略它，然后去做。"}, {"type": "subtitle", "time": 878.069, "timestamp": "00:14:38", "text": "你自己的东西。为什么要关心别人"}, {"type": "subtitle", "time": 879.829, "timestamp": "00:14:39", "text": "人们又开始议论你了？有"}, {"type": "subtitle", "time": 882.23, "timestamp": "00:14:42", "text": "这一切都是互联网造成的，对吧？"}, {"type": "subtitle", "time": 885.99, "timestamp": "00:14:45", "text": "我也一样，我们每个人都曾面对过这种情况。"}]
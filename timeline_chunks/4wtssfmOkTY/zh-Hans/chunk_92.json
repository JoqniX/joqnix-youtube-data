[{"type": "subtitle", "time": 5521.35, "timestamp": "01:32:01", "text": "我会说不，但你们要回答。"}, {"type": "subtitle", "time": 5523.669, "timestamp": "01:32:03", "text": "迅速地。"}, {"type": "subtitle", "time": 5526.47, "timestamp": "01:32:06", "text": "是的。好的。我打算用激光把它切除。"}, {"type": "subtitle", "time": 5530.55, "timestamp": "01:32:10", "text": "最后一个。前进。全部。总共"}, {"type": "subtitle", "time": 5533.189, "timestamp": "01:32:13", "text": "你，兄弟。"}, {"type": "subtitle", "time": 5535.83, "timestamp": "01:32:15", "text": "瞧你今天把所有东西都激光化了。"}, {"type": "subtitle", "time": 5537.669, "timestamp": "01:32:17", "text": "你看到了。"}, {"type": "subtitle", "time": 5539.27, "timestamp": "01:32:19", "text": "有趣的是，我还有更多稀有品种。"}, {"type": "subtitle", "time": 5542.31, "timestamp": "01:32:22", "text": "比我常见的样品多一些样品。"}, {"type": "subtitle", "time": 5544.149, "timestamp": "01:32:24", "text": "这就是我拿着这些超级样品的原因。"}, {"type": "subtitle", "time": 5546.87, "timestamp": "01:32:26", "text": "比罕见样本更甚，比常见样本更甚。"}, {"type": "subtitle", "time": 5549.11, "timestamp": "01:32:29", "text": "我的天啊。常见的样本并非"}, {"type": "subtitle", "time": 5552.629, "timestamp": "01:32:32", "text": "这种情况现在已经不常见了。不。彗星"}, {"type": "subtitle", "time": 5555.75, "timestamp": "01:32:35", "text": "样品成​​了最难找到的东西。"}, {"type": "subtitle", "time": 5557.91, "timestamp": "01:32:37", "text": "哦，好了。好的，我正在放置一个"}, {"type": "subtitle", "time": 5565.03, "timestamp": "01:32:45", "text": "请快逃。请允许我试用一下。"}, {"type": "subtitle", "time": 5568.149, "timestamp": "01:32:48", "text": "容器。我们走吧。哦，这是一个，这是一个"}, {"type": "subtitle", "time": 5570.07, "timestamp": "01:32:50", "text": "稀有样本。"}, {"type": "subtitle", "time": 5573.189, "timestamp": "01:32:53", "text": "我是一路走来的。"}, {"type": "subtitle", "time": 5574.95, "timestamp": "01:32:54", "text": "好的，我们还有一个。我们有一个"}, {"type": "subtitle", "time": 5576.709, "timestamp": "01:32:56", "text": "更强大的堡垒。我们还有一个基地。"}, {"type": "subtitle", "time": 5578.79, "timestamp": "01:32:58", "text": "这是他们的据点。"}]
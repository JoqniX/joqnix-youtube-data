[{"type": "subtitle", "time": 11461.349, "timestamp": "03:11:01", "text": "保重。笨蛋。我希望你……"}, {"type": "subtitle", "time": 11464.55, "timestamp": "03:11:04", "text": "更好的。笨蛋笨蛋。希望你一切顺利"}, {"type": "subtitle", "time": 11466.63, "timestamp": "03:11:06", "text": "餐厅"}, {"type": "subtitle", "time": 11471.67, "timestamp": "03:11:11", "text": "因为餐厅对我来说很重要。"}, {"type": "subtitle", "time": 11480.56, "timestamp": "03:11:20", "text": "是的。"}, {"type": "subtitle", "time": 11496.23, "timestamp": "03:11:36", "text": "但是，呃，说到我的动物窝，"}, {"type": "subtitle", "time": 11498.71, "timestamp": "03:11:38", "text": "我有点想把头发都剃光。"}, {"type": "subtitle", "time": 11501.83, "timestamp": "03:11:41", "text": "我的东西"}, {"type": "subtitle", "time": 11505.429, "timestamp": "03:11:45", "text": "登录状态为："}, {"type": "subtitle", "time": 11508.71, "timestamp": "03:11:48", "text": "呃，我想把它们移除。我的天啊。我 我"}, {"type": "subtitle", "time": 11511.11, "timestamp": "03:11:51", "text": "我真的挺想把它们移除的。"}, {"type": "subtitle", "time": 11514.389, "timestamp": "03:11:54", "text": "尽管。我做了多少次？那不是"}, {"type": "subtitle", "time": 11517.99, "timestamp": "03:11:57", "text": "足够的。某种原因"}]
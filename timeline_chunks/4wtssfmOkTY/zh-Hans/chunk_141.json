[{"type": "subtitle", "time": 8460.87, "timestamp": "02:21:00", "text": "快点处理这件事。"}, {"type": "subtitle", "time": 8463.99, "timestamp": "02:21:03", "text": "好的，明白了。"}, {"type": "subtitle", "time": 8467.51, "timestamp": "02:21:07", "text": "我看到周围的东西。"}, {"type": "subtitle", "time": 8469.67, "timestamp": "02:21:09", "text": "我不应该使用看门狗。带我去"}, {"type": "subtitle", "time": 8477.11, "timestamp": "02:21:17", "text": "我为什么会拿这个？我需要这个"}, {"type": "subtitle", "time": 8483.03, "timestamp": "02:21:23", "text": "嗯，我需要用它。没关系。那"}, {"type": "subtitle", "time": 8484.71, "timestamp": "02:21:24", "text": "不会害死我。我忘了这件事"}, {"type": "subtitle", "time": 8487.75, "timestamp": "02:21:27", "text": "这几个家伙。快过来。留在我身边"}, {"type": "subtitle", "time": 8499.11, "timestamp": "02:21:39", "text": "不。我的天哪。为什么？"}, {"type": "subtitle", "time": 8502.23, "timestamp": "02:21:42", "text": "没关系。这就是原因。先生，先生"}, {"type": "subtitle", "time": 8504.71, "timestamp": "02:21:44", "text": "舒曼，你能救活他吗？不，是"}, {"type": "subtitle", "time": 8506.07, "timestamp": "02:21:46", "text": "美好的。没关系。没关系。注意安全。"}, {"type": "subtitle", "time": 8508.95, "timestamp": "02:21:48", "text": "节省。节省。节省。节省。你是什​​么意思"}, {"type": "subtitle", "time": 8510.55, "timestamp": "02:21:50", "text": "节省？"}, {"type": "subtitle", "time": 8513.51, "timestamp": "02:21:53", "text": "让他复活。让他复活。不。喜欢"}, {"type": "subtitle", "time": 8515.99, "timestamp": "02:21:55", "text": "顺便说一句，你这是在浪费一次复活机会。"}, {"type": "subtitle", "time": 8518.87, "timestamp": "02:21:58", "text": "把他救活。"}]
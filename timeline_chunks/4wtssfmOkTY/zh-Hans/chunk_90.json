[{"type": "subtitle", "time": 5401.189, "timestamp": "01:30:01", "text": "考虑到这是地狱潜水"}, {"type": "subtitle", "time": 5403.83, "timestamp": "01:30:03", "text": "难度出乎意料地高"}, {"type": "subtitle", "time": 5405.75, "timestamp": "01:30:05", "text": "比你想象的要容易得多，你还没见过"}, {"type": "subtitle", "time": 5407.75, "timestamp": "01:30:07", "text": "仍然是坚固的堡垒。我们还没说到……"}, {"type": "subtitle", "time": 5410.31, "timestamp": "01:30:10", "text": "仍然是坚固的堡垒。"}, {"type": "subtitle", "time": 5411.83, "timestamp": "01:30:11", "text": "我的意思是，是的，有很多“哦”"}, {"type": "subtitle", "time": 5414.07, "timestamp": "01:30:14", "text": "糟糕，我刚刚意识到我正在四处走动"}, {"type": "subtitle", "time": 5416.229, "timestamp": "01:30:16", "text": "没有盾牌。"}, {"type": "subtitle", "time": 5418.79, "timestamp": "01:30:18", "text": "我怎么没死？"}, {"type": "subtitle", "time": 5420.95, "timestamp": "01:30:20", "text": "我也是。我只是对此感到好奇。"}, {"type": "subtitle", "time": 5424.55, "timestamp": "01:30:24", "text": "片刻。比如，我没有喜欢"}, {"type": "subtitle", "time": 5427.189, "timestamp": "01:30:27", "text": "我身上带着火炮武器。我没有护盾"}, {"type": "subtitle", "time": 5429.669, "timestamp": "01:30:29", "text": "在我身上。我还活着。她是我的。让我"}, {"type": "subtitle", "time": 5432.31, "timestamp": "01:30:32", "text": "工艺。我们走吧。我的"}, {"type": "subtitle", "time": 5435.03, "timestamp": "01:30:35", "text": "上帝。不。"}, {"type": "subtitle", "time": 5438.629, "timestamp": "01:30:38", "text": "我其实很想试试。糟糕，"}, {"type": "subtitle", "time": 5441.27, "timestamp": "01:30:41", "text": "我忘了这里还有个绿巨人。"}]
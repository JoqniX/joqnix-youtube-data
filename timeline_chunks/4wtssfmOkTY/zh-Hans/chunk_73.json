[{"type": "subtitle", "time": 4381.43, "timestamp": "01:13:01", "text": "尚未发布配套披风。"}, {"type": "subtitle", "time": 4395.11, "timestamp": "01:13:15", "text": "气道。哦，我太需要这个了。"}, {"type": "subtitle", "time": 4397.669, "timestamp": "01:13:17", "text": "糟糕，我弄不到。这是信号弹"}, {"type": "subtitle", "time": 4399.83, "timestamp": "01:13:19", "text": "但存在差距。"}, {"type": "subtitle", "time": 4402.149, "timestamp": "01:13:22", "text": "我看看能不能升级一下设备。船"}, {"type": "subtitle", "time": 4404.87, "timestamp": "01:13:24", "text": "弹药。兄弟，这里什么都不能升级。"}, {"type": "subtitle", "time": 4407.35, "timestamp": "01:13:27", "text": "那一刻。"}, {"type": "subtitle", "time": 4409.43, "timestamp": "01:13:29", "text": "盾"}, {"type": "subtitle", "time": 4412.87, "timestamp": "01:13:32", "text": "火焰哨兵。反坦克"}, {"type": "subtitle", "time": 4416.149, "timestamp": "01:13:36", "text": "便携式地狱炸弹。什么？"}, {"type": "subtitle", "time": 4418.47, "timestamp": "01:13:38", "text": "哦，是的，我哥哥，我哥哥爱我。"}, {"type": "subtitle", "time": 4421.59, "timestamp": "01:13:41", "text": "那。那玩意儿真不错。他撞见"}, {"type": "subtitle", "time": 4424.07, "timestamp": "01:13:44", "text": "敌军群，它只是敬礼。"}, {"type": "subtitle", "time": 4428.229, "timestamp": "01:13:48", "text": "然后它爆炸了。哇。"}, {"type": "subtitle", "time": 4431.03, "timestamp": "01:13:51", "text": "如果你死了，它也会爆炸。"}, {"type": "subtitle", "time": 4432.709, "timestamp": "01:13:52", "text": "呃，如果你穿上了盔甲，如果你有"}, {"type": "subtitle", "time": 4435.83, "timestamp": "01:13:55", "text": "哦，盔甲。有一个特别的"}]
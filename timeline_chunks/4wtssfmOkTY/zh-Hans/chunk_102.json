[{"type": "subtitle", "time": 6134.629, "timestamp": "01:42:14", "text": "所有敌人都在海上登陆。"}, {"type": "subtitle", "time": 6139.03, "timestamp": "01:42:19", "text": "下面我可以看到所有地方。哦，"}, {"type": "subtitle", "time": 6141.75, "timestamp": "01:42:21", "text": "你好，舒玛。抱歉。哦，嗨。我的"}, {"type": "subtitle", "time": 6144.07, "timestamp": "01:42:24", "text": "榴弹发射器。你真的让我"}, {"type": "subtitle", "time": 6147.27, "timestamp": "01:42:27", "text": "发现了大约三个珍稀样本。"}, {"type": "subtitle", "time": 6157.189, "timestamp": "01:42:37", "text": "但他们终将死去。"}, {"type": "subtitle", "time": 6159.75, "timestamp": "01:42:39", "text": "那是绿巨人。我完蛋了。"}, {"type": "subtitle", "time": 6166.149, "timestamp": "01:42:46", "text": "哇。"}, {"type": "subtitle", "time": 6169.59, "timestamp": "01:42:49", "text": "把绿巨人弄过来。不要接触，伙计。"}]
[{"type": "subtitle", "time": 17775.83, "timestamp": "04:56:15", "text": "你好。你好。我暂停了。好的。 27秒。"}, {"type": "subtitle", "time": 17778.47, "timestamp": "04:56:18", "text": "那是八小节。好的。"}, {"type": "subtitle", "time": 17784.708, "timestamp": "04:56:24", "text": "我想在一秒钟内快速创建一个空间"}, {"type": "subtitle", "time": 17802.23, "timestamp": "04:56:42", "text": "呃，别这样。让我重新命名"}, {"type": "subtitle", "time": 17808.948, "timestamp": "04:56:48", "text": "随机的"}]
[{"type": "subtitle", "time": 7560.95, "timestamp": "02:06:00", "text": "地狱潜入。我们就选这一个吧。"}, {"type": "subtitle", "time": 7562.55, "timestamp": "02:06:02", "text": "那应该是最接近的了。这样可以吗？"}, {"type": "subtitle", "time": 7565.51, "timestamp": "02:06:05", "text": "和你们在一起吗？是的，它能说明一切。是的。"}, {"type": "subtitle", "time": 7568.79, "timestamp": "02:06:08", "text": "这些虫子简直是祸害。你是后排。"}, {"type": "subtitle", "time": 7571.51, "timestamp": "02:06:11", "text": "行动影响。"}, {"type": "subtitle", "time": 7573.75, "timestamp": "02:06:13", "text": "有人在吗？哦，好了。我们开始吧"}, {"type": "subtitle", "time": 7575.43, "timestamp": "02:06:15", "text": "白天去，因为晚上……"}, {"type": "subtitle", "time": 7577.03, "timestamp": "02:06:17", "text": "这会变得非常非常困难。"}, {"type": "subtitle", "time": 7583.109, "timestamp": "02:06:23", "text": "清除孵化场。这是其中之一"}, {"type": "subtitle", "time": 7585.75, "timestamp": "02:06:25", "text": "最烦人的那些。检索有价值的信息"}, {"type": "subtitle", "time": 7587.43, "timestamp": "02:06:27", "text": "数据。"}, {"type": "subtitle", "time": 7589.75, "timestamp": "02:06:29", "text": "搜索并摧毁"}, {"type": "subtitle", "time": 7592.95, "timestamp": "02:06:32", "text": "12分钟。"}, {"type": "subtitle", "time": 7595.43, "timestamp": "02:06:35", "text": "你们最想先做哪一个？"}, {"type": "subtitle", "time": 7598.229, "timestamp": "02:06:38", "text": "我想进行数据恢复。"}, {"type": "subtitle", "time": 7600.709, "timestamp": "02:06:40", "text": "启动。"}, {"type": "subtitle", "time": 7610.149, "timestamp": "02:06:50", "text": "它有捕食者贸易吗？由"}, {"type": "subtitle", "time": 7611.75, "timestamp": "02:06:51", "text": "如果它说它发现了捕食者，那就说明它找到了捕食者。"}, {"type": "subtitle", "time": 7615.51, "timestamp": "02:06:55", "text": "训练时要小心。跳跃完成。"}, {"type": "subtitle", "time": 7617.91, "timestamp": "02:06:57", "text": "哦，它们很硬吗？哦，他们是"}]
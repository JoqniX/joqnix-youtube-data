[{"type": "subtitle", "time": 6303.27, "timestamp": "01:45:03", "text": "是我。那里有个助行器。我刚掉"}, {"type": "subtitle", "time": 6306.39, "timestamp": "01:45:06", "text": "对它进行猛烈攻击。等等，我在开枪。"}, {"type": "subtitle", "time": 6309.59, "timestamp": "01:45:09", "text": "危险就在附近。"}, {"type": "subtitle", "time": 6311.189, "timestamp": "01:45:11", "text": "你想在凯和凯的世界里看到怎样的世界？"}, {"type": "subtitle", "time": 6312.87, "timestamp": "01:45:12", "text": "如果可以选择呢？地狱潜者，沉默不语"}, {"type": "subtitle", "time": 6314.87, "timestamp": "01:45:14", "text": "地狱，还是生化危机？它们都是"}, {"type": "subtitle", "time": 6317.109, "timestamp": "01:45:17", "text": "拉屎。"}, {"type": "subtitle", "time": 6319.27, "timestamp": "01:45:19", "text": "《地狱潜行者》中的死亡率"}, {"type": "subtitle", "time": 6322.47, "timestamp": "01:45:22", "text": "太疯狂了。"}, {"type": "subtitle", "time": 6325.109, "timestamp": "01:45:25", "text": "是的，我真的溺水身亡了。"}, {"type": "subtitle", "time": 6327.99, "timestamp": "01:45:27", "text": "雨水。我溺死在雨中"}, {"type": "subtitle", "time": 6331.189, "timestamp": "01:45:31", "text": "水，这真令人尴尬。"}, {"type": "subtitle", "time": 6333.75, "timestamp": "01:45:33", "text": "寂静岭是心理恐怖游戏，但是"}, {"type": "subtitle", "time": 6335.99, "timestamp": "01:45:35", "text": "它只存在于特定地点。"}, {"type": "subtitle", "time": 6338.07, "timestamp": "01:45:38", "text": "《生化危机》简直就是病毒式传播"}, {"type": "subtitle", "time": 6339.75, "timestamp": "01:45:39", "text": "恐怖。所以，最佳地点是"}, {"type": "subtitle", "time": 6342.87, "timestamp": "01:45:42", "text": "实际上是寂静岭，但不是在寂静岭里。"}, {"type": "subtitle", "time": 6345.51, "timestamp": "01:45:45", "text": "山丘本身。世界其他地方是"}, {"type": "subtitle", "time": 6347.91, "timestamp": "01:45:47", "text": "美好的。但这里不是寂静岭。"}, {"type": "subtitle", "time": 6349.27, "timestamp": "01:45:49", "text": "只要你不在那里，你就……"}, {"type": "subtitle", "time": 6351.83, "timestamp": "01:45:51", "text": "美好的。申请预付款。我要"}, {"type": "subtitle", "time": 6356.07, "timestamp": "01:45:56", "text": "去以民主的方式获取那些"}]
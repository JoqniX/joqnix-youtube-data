[{"type": "subtitle", "time": 4443.83, "timestamp": "01:14:03", "text": "我就是想不起来它叫什么了。"}, {"type": "subtitle", "time": 4446.709, "timestamp": "01:14:06", "text": "再见。各位，这就是我想要的原因"}, {"type": "subtitle", "time": 4449.99, "timestamp": "01:14:09", "text": "把那堵墙弄过来。"}, {"type": "subtitle", "time": 4453.99, "timestamp": "01:14:13", "text": "我想我得抓到这家伙了。"}, {"type": "subtitle", "time": 4456.55, "timestamp": "01:14:16", "text": "看，这是毒气武器。我的思绪。不。哦，我的"}, {"type": "subtitle", "time": 4460.63, "timestamp": "01:14:20", "text": "上帝。科斯，不。不要那样做。不要这样做"}, {"type": "subtitle", "time": 4464.07, "timestamp": "01:14:24", "text": "它。不值得。"}, {"type": "subtitle", "time": 4472.55, "timestamp": "01:14:32", "text": "你们准备好迎接地狱般的潜水了吗？"}, {"type": "subtitle", "time": 4475.59, "timestamp": "01:14:35", "text": "自决之矛。掌握"}, {"type": "subtitle", "time": 4479.51, "timestamp": "01:14:39", "text": "仪式。好的。这是什么？"}, {"type": "subtitle", "time": 4483.27, "timestamp": "01:14:43", "text": "这是最新的一个。"}, {"type": "subtitle", "time": 4484.95, "timestamp": "01:14:44", "text": "那件东西背后还有故事。实际上，因为"}, {"type": "subtitle", "time": 4487.35, "timestamp": "01:14:47", "text": "他们正在入侵超级地球，他们需要"}, {"type": "subtitle", "time": 4489.43, "timestamp": "01:14:49", "text": "他们所需的所有火力。"}, {"type": "subtitle", "time": 4491.59, "timestamp": "01:14:51", "text": "他们拿走了旧的武器和盔甲"}, {"type": "subtitle", "time": 4494.229, "timestamp": "01:14:54", "text": "已重新维修。"}, {"type": "subtitle", "time": 4495.91, "timestamp": "01:14:55", "text": "我太喜欢这部宪法了"}, {"type": "subtitle", "time": 4498.709, "timestamp": "01:14:58", "text": "它。或者说，不像"}]
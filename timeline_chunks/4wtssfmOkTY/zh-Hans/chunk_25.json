[{"type": "subtitle", "time": 1501.43, "timestamp": "00:25:01", "text": "我说话、叙述和的地方"}, {"type": "subtitle", "time": 1505.83, "timestamp": "00:25:05", "text": "哨。呃，那个系列节目将会暂停播出。"}, {"type": "subtitle", "time": 1508.47, "timestamp": "00:25:08", "text": "由于一项重大事件公告"}, {"type": "subtitle", "time": 1511.43, "timestamp": "00:25:11", "text": "接下来会发生这件事。是的，就是这样。"}, {"type": "subtitle", "time": 1514.549, "timestamp": "00:25:14", "text": "那件事将会因为……而停止。"}, {"type": "subtitle", "time": 1517.029, "timestamp": "00:25:17", "text": "现在。我觉得我无法集中精力做这件事。"}, {"type": "subtitle", "time": 1519.35, "timestamp": "00:25:19", "text": "现在。我稍后会把它带回来。"}, {"type": "subtitle", "time": 1522.71, "timestamp": "00:25:22", "text": "稍后会提供更高质量的格式。是的"}, {"type": "subtitle", "time": 1526.71, "timestamp": "00:25:26", "text": "这是首批公布的消息之一。"}, {"type": "subtitle", "time": 1529.669, "timestamp": "00:25:29", "text": "其次，"}, {"type": "subtitle", "time": 1533.83, "timestamp": "00:25:33", "text": "好的，这是主要公告。"}, {"type": "subtitle", "time": 1536.39, "timestamp": "00:25:36", "text": "我想做"}, {"type": "subtitle", "time": 1541.83, "timestamp": "00:25:41", "text": "在我们深入探讨这个问题之前，呃，天哪……"}, {"type": "subtitle", "time": 1546.87, "timestamp": "00:25:46", "text": "这很难，这很难。"}, {"type": "subtitle", "time": 1552.23, "timestamp": "00:25:52", "text": "呃，天哪，我做不到。好吧。"}, {"type": "subtitle", "time": 1554.71, "timestamp": "00:25:54", "text": "所以，重大公告"}, {"type": "subtitle", "time": 1556.71, "timestamp": "00:25:56", "text": "我想直播的时间段是"}]
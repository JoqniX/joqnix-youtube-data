[{"type": "subtitle", "time": 6722.95, "timestamp": "01:52:02", "text": "来。我们走吧。大家都收到了吗？"}, {"type": "subtitle", "time": 6726.95, "timestamp": "01:52:06", "text": "一切？我得到了它。"}, {"type": "subtitle", "time": 6729.189, "timestamp": "01:52:09", "text": "我想我做到了。"}, {"type": "subtitle", "time": 6731.189, "timestamp": "01:52:11", "text": "我正在核实。"}, {"type": "subtitle", "time": 6733.669, "timestamp": "01:52:13", "text": "看来我们没问题。"}, {"type": "subtitle", "time": 6735.35, "timestamp": "01:52:15", "text": "我们很好。等待。我们很好。是"}, {"type": "subtitle", "time": 6739.03, "timestamp": "01:52:19", "text": "好的。好的。但我们退出了比赛。所以"}, {"type": "subtitle", "time": 6742.39, "timestamp": "01:52:22", "text": "是的，我们确实有很多"}, {"type": "subtitle", "time": 6745.03, "timestamp": "01:52:25", "text": "常见样本。是的，你有"}, {"type": "subtitle", "time": 6748.229, "timestamp": "01:52:28", "text": "我们维持了我们的生活方式，伙计。"}, {"type": "subtitle", "time": 6750.39, "timestamp": "01:52:30", "text": "我们因此获得了一项成就。是的，我们"}, {"type": "subtitle", "time": 6753.43, "timestamp": "01:52:33", "text": "做过。我的天啊。好的。我们走吧。我们开始吧"}, {"type": "subtitle", "time": 6775.27, "timestamp": "01:52:55", "text": "我们没收到广播电台。当"}, {"type": "subtitle", "time": 6779.189, "timestamp": "01:52:59", "text": "它。该死的。就差一点。"}]
[{"type": "subtitle", "time": 3366.309, "timestamp": "00:56:06", "text": "哦，天哪。已收购。我什么也没看到。"}, {"type": "subtitle", "time": 3372.87, "timestamp": "00:56:12", "text": "什么是"}, {"type": "subtitle", "time": 3378.71, "timestamp": "00:56:18", "text": "如果有人想去的话，还有另一个球体。"}, {"type": "subtitle", "time": 3380.71, "timestamp": "00:56:20", "text": "它。"}, {"type": "subtitle", "time": 3382.63, "timestamp": "00:56:22", "text": "我的天啊。为什么？一种火箭发射器"}, {"type": "subtitle", "time": 3384.71, "timestamp": "00:56:24", "text": "锁定目标并瞬间击杀大多数敌人。嘿，你好"}, {"type": "subtitle", "time": 3387.67, "timestamp": "00:56:27", "text": "你按下“呃”键打开地图了吗？哦，标签，"}, {"type": "subtitle", "time": 3391.27, "timestamp": "00:56:31", "text": "正确的？标签页。如果你标记了某样东西，"}, {"type": "subtitle", "time": 3393.109, "timestamp": "00:56:33", "text": "按 Q 键。"}, {"type": "subtitle", "time": 3395.109, "timestamp": "00:56:35", "text": "如果你要在地图上标记某个东西，"}, {"type": "subtitle", "time": 3398.39, "timestamp": "00:56:38", "text": "嗯，比如说，按一下鼠标右键。"}, {"type": "subtitle", "time": 3401.19, "timestamp": "00:56:41", "text": "有大事要发生。就在这里。"}, {"type": "subtitle", "time": 3403.03, "timestamp": "00:56:43", "text": "啊，明白了。知道了。我想起来了。"}, {"type": "subtitle", "time": 3405.91, "timestamp": "00:56:45", "text": "有人从西北方向过来。"}, {"type": "subtitle", "time": 3408.39, "timestamp": "00:56:48", "text": "是的，"}, {"type": "subtitle", "time": 3411.43, "timestamp": "00:56:51", "text": "我的弩。"}, {"type": "subtitle", "time": 3414.069, "timestamp": "00:56:54", "text": "糟糕。哦，不错。他们几乎就要喊了"}, {"type": "subtitle", "time": 3416.309, "timestamp": "00:56:56", "text": "增援部队。"}, {"type": "subtitle", "time": 3417.99, "timestamp": "00:56:57", "text": "但我知道我希望他们打电话来。"}]
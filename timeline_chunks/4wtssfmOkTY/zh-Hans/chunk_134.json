[{"type": "subtitle", "time": 8042.47, "timestamp": "02:14:02", "text": "耶稣。我的天啊。"}, {"type": "subtitle", "time": 8043.51, "timestamp": "02:14:03", "text": "你知道吗？我要用它干掉它"}, {"type": "subtitle", "time": 8045.589, "timestamp": "02:14:05", "text": "补给信标。"}, {"type": "subtitle", "time": 8047.91, "timestamp": "02:14:07", "text": "不要动。不。"}, {"type": "subtitle", "time": 8050.79, "timestamp": "02:14:10", "text": "哦，它真的可能会死。"}, {"type": "subtitle", "time": 8053.51, "timestamp": "02:14:13", "text": "不，是10秒。"}, {"type": "subtitle", "time": 8058.87, "timestamp": "02:14:18", "text": "为什么？七。六。五。我当时已经死了。"}, {"type": "subtitle", "time": 8062.87, "timestamp": "02:14:22", "text": "哦，它被喷了。有很多"}, {"type": "subtitle", "time": 8064.709, "timestamp": "02:14:24", "text": "他们。"}, {"type": "subtitle", "time": 8066.629, "timestamp": "02:14:26", "text": "不用担心。我拥有每一种火焰"}, {"type": "subtitle", "time": 8084.79, "timestamp": "02:14:44", "text": "我还有额外的手榴弹。我的天哪，有……"}, {"type": "subtitle", "time": 8091.19, "timestamp": "02:14:51", "text": "我的天啊。"}]
[{"type": "subtitle", "time": 7381.35, "timestamp": "02:03:01", "text": "去死吧，鱿鱼渣，去死吧。去死吧，去死吧。"}, {"type": "subtitle", "time": 7384.229, "timestamp": "02:03:04", "text": "工程工具包，但轻型装甲速度"}, {"type": "subtitle", "time": 7386.39, "timestamp": "02:03:06", "text": "更高，因此耐力下降"}, {"type": "subtitle", "time": 7388.79, "timestamp": "02:03:08", "text": "逃离光明。我从未如此"}, {"type": "subtitle", "time": 7392.07, "timestamp": "02:03:12", "text": "很荣幸能与您并肩作战。正义。"}, {"type": "subtitle", "time": 7394.79, "timestamp": "02:03:14", "text": "光明会已经撤退。现在是"}, {"type": "subtitle", "time": 7398.07, "timestamp": "02:03:18", "text": "是时候让他们付出代价了。"}, {"type": "subtitle", "time": 7402.55, "timestamp": "02:03:22", "text": "DSS。它就像超级超级"}, {"type": "subtitle", "time": 7404.709, "timestamp": "02:03:24", "text": "舒曼在哪里？哦，他来了。我是"}, {"type": "subtitle", "time": 7406.87, "timestamp": "02:03:26", "text": "选择盔甲。"}, {"type": "subtitle", "time": 7409.03, "timestamp": "02:03:29", "text": "好的，"}, {"type": "subtitle", "time": 7410.229, "timestamp": "02:03:30", "text": "我想我还是选风衣吧。"}, {"type": "subtitle", "time": 7412.87, "timestamp": "02:03:32", "text": "目前是一名工程师。"}, {"type": "subtitle", "time": 7414.39, "timestamp": "02:03:34", "text": "和"}, {"type": "subtitle", "time": 7421.35, "timestamp": "02:03:41", "text": "闭上眼睛。"}, {"type": "subtitle", "time": 7430.47, "timestamp": "02:03:50", "text": "开始了。我准备好了。哦，找到了。"}, {"type": "subtitle", "time": 7438.39, "timestamp": "02:03:58", "text": "他有你吗？"}]
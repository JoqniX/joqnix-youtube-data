[{"type": "subtitle", "time": 11522.309, "timestamp": "03:12:02", "text": "我想把这些东西删掉。真是太"}, {"type": "subtitle", "time": 11528.55, "timestamp": "03:12:08", "text": "我想删除"}, {"type": "subtitle", "time": 11531.75, "timestamp": "03:12:11", "text": "因为我现在这么说"}, {"type": "subtitle", "time": 11536.469, "timestamp": "03:12:16", "text": "我不想保留我的……呃，我只是……"}, {"type": "subtitle", "time": 11538.95, "timestamp": "03:12:18", "text": "已登录。"}, {"type": "subtitle", "time": 11542.95, "timestamp": "03:12:22", "text": "是的。但是，我不想让任何人……"}, {"type": "subtitle", "time": 11546.07, "timestamp": "03:12:26", "text": "谁不知道海或"}, {"type": "subtitle", "time": 11547.59, "timestamp": "03:12:27", "text": "任何事物"}, {"type": "subtitle", "time": 11553.19, "timestamp": "03:12:33", "text": "一个纯粹的人，就像"}, {"type": "subtitle", "time": 11557.59, "timestamp": "03:12:37", "text": "就像这样：哦，乔有我的清单，我去看看。"}, {"type": "subtitle", "time": 11560.15, "timestamp": "03:12:40", "text": "他看了哪些动漫，然后点击"}, {"type": "subtitle", "time": 11563.99, "timestamp": "03:12:43", "text": "在“嗨”那个，还有“呃，嗨”那个，"}, {"type": "subtitle", "time": 11567.67, "timestamp": "03:12:47", "text": "比如，呃，进入海伊之类的。我"}]
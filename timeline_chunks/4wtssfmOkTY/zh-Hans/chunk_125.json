[{"type": "subtitle", "time": 7510.709, "timestamp": "02:05:10", "text": "如何"}, {"type": "subtitle", "time": 7513.189, "timestamp": "02:05:13", "text": "我们搜索立场吗？没有站立权"}, {"type": "subtitle", "time": 7516.07, "timestamp": "02:05:16", "text": "命令。"}, {"type": "subtitle", "time": 7517.669, "timestamp": "02:05:17", "text": "有地狱跳伞，但没有超级"}, {"type": "subtitle", "time": 7524.87, "timestamp": "02:05:24", "text": "等等，你的账号已经解锁了，对吧？"}, {"type": "subtitle", "time": 7532.79, "timestamp": "02:05:32", "text": "看起来不像是什么超级地狱跳水。"}, {"type": "subtitle", "time": 7535.83, "timestamp": "02:05:35", "text": "任务在于占据主导地位"}, {"type": "subtitle", "time": 7547.03, "timestamp": "02:05:47", "text": "让我查一下。派遣，"}, {"type": "subtitle", "time": 7550.55, "timestamp": "02:05:50", "text": "你的立场是什么？"}, {"type": "subtitle", "time": 7552.39, "timestamp": "02:05:52", "text": "维和行动。战术上"}, {"type": "subtitle", "time": 7554.79, "timestamp": "02:05:54", "text": "清除所有障碍物"}, {"type": "subtitle", "time": 7557.03, "timestamp": "02:05:57", "text": "和平之道。地狱潜水员们为了争夺"}, {"type": "subtitle", "time": 7559.189, "timestamp": "02:05:59", "text": "自由。让我们来决定。我们只有"}]
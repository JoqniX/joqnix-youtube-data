[{"type": "subtitle", "time": 1750.31, "timestamp": "00:29:10", "text": "这游戏太卡了。"}, {"type": "subtitle", "time": 1760.389, "timestamp": "00:29:20", "text": "恢复主要订单。这到底是什么鬼东西"}, {"type": "subtitle", "time": 1774.549, "timestamp": "00:29:34", "text": "零"}, {"type": "subtitle", "time": 1776.71, "timestamp": "00:29:36", "text": "八天前。"}, {"type": "subtitle", "time": 1779.909, "timestamp": "00:29:39", "text": "武器自定义功能已解锁。"}, {"type": "subtitle", "time": 1781.99, "timestamp": "00:29:41", "text": "呃，"}, {"type": "subtitle", "time": 1785.669, "timestamp": "00:29:45", "text": "让我降低……"}, {"type": "subtitle", "time": 1787.99, "timestamp": "00:29:47", "text": "图形。我的天，居然是中等画质。"}, {"type": "subtitle", "time": 1789.75, "timestamp": "00:29:49", "text": "没有。没有。没有。没有。没有。没有。"}, {"type": "subtitle", "time": 1792.399, "timestamp": "00:29:52", "text": "没有。没有。没有。 降低。"}, {"type": "subtitle", "time": 1793.919, "timestamp": "00:29:53", "text": "降低。 降低"}, {"type": "subtitle", "time": 1796.159, "timestamp": "00:29:56", "text": "降低 去。甚至更低。好的。"}, {"type": "subtitle", "time": 1799.12, "timestamp": "00:29:59", "text": "去。甚至更低。好的。 表格。"}]
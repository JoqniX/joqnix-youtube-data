[{"type": "subtitle", "time": 8281.669, "timestamp": "02:18:01", "text": "增援部队。"}, {"type": "subtitle", "time": 8285.429, "timestamp": "02:18:05", "text": "杰克，这意味着附近有跟踪者。"}, {"type": "subtitle", "time": 8286.79, "timestamp": "02:18:06", "text": "那就别走直线。"}, {"type": "subtitle", "time": 8288.15, "timestamp": "02:18:08", "text": "你会没事的。哦，还有囊性纤维化"}, {"type": "subtitle", "time": 8309.669, "timestamp": "02:18:29", "text": "不，不要。不要坚持。不要坚持。如何"}, {"type": "subtitle", "time": 8320.95, "timestamp": "02:18:40", "text": "我们身后有个跟踪狂。"}, {"type": "subtitle", "time": 8331.429, "timestamp": "02:18:51", "text": "我的天啊。糟糕。它就在后面"}, {"type": "subtitle", "time": 8333.98, "timestamp": "02:18:53", "text": "一直都是我。"}]
[{"type": "subtitle", "time": 7865.589, "timestamp": "02:11:05", "text": "它们看起来完全不一样。糟糕。"}, {"type": "subtitle", "time": 7873.27, "timestamp": "02:11:13", "text": "[音乐]"}, {"type": "subtitle", "time": 7875.91, "timestamp": "02:11:15", "text": "该死。"}, {"type": "subtitle", "time": 7884.229, "timestamp": "02:11:24", "text": "我的看门狗呢？申请已批准。"}, {"type": "subtitle", "time": 7905.27, "timestamp": "02:11:45", "text": "妈的。"}, {"type": "subtitle", "time": 7907.109, "timestamp": "02:11:47", "text": "不用担心。不要加强"}, {"type": "subtitle", "time": 7909.35, "timestamp": "02:11:49", "text": "片刻。我认为我们已经取得了重大进展"}, {"type": "subtitle", "time": 7911.35, "timestamp": "02:11:51", "text": "错误。"}, {"type": "subtitle", "time": 7913.669, "timestamp": "02:11:53", "text": "我觉得他增强了我的内心力量。这"}, {"type": "subtitle", "time": 7918.149, "timestamp": "02:11:58", "text": "虫子没有加固内部。"}]
[{"type": "subtitle", "time": 2101.589, "timestamp": "00:35:01", "text": "现在不要。至少目前是这样。不是"}, {"type": "subtitle", "time": 2108.39, "timestamp": "00:35:08", "text": "Shonix先生，您其实可以加入我们。"}, {"type": "subtitle", "time": 2110.55, "timestamp": "00:35:10", "text": "是的，我正在设置游戏。"}, {"type": "subtitle", "time": 2113.75, "timestamp": "00:35:13", "text": "非常卡顿。我的电脑快不行了。啊，"}, {"type": "subtitle", "time": 2116.63, "timestamp": "00:35:16", "text": "这是正常的。"}, {"type": "subtitle", "time": 2119.67, "timestamp": "00:35:19", "text": "为什么需要花费这么多时间？"}, {"type": "subtitle", "time": 2122.39, "timestamp": "00:35:22", "text": "等等，那是一根……"}, {"type": "subtitle", "time": 2127.75, "timestamp": "00:35:27", "text": "耶稣。"}, {"type": "subtitle", "time": 2130.63, "timestamp": "00:35:30", "text": "我看到了一声巨响。"}, {"type": "subtitle", "time": 2132.87, "timestamp": "00:35:32", "text": "大滑块。那是一家工厂"}, {"type": "subtitle", "time": 2134.79, "timestamp": "00:35:34", "text": "我想应该是长腿蜘蛛。对不起。是的，不是"}, {"type": "subtitle", "time": 2137.829, "timestamp": "00:35:37", "text": "工厂漫步者。嗯，这是正常的"}, {"type": "subtitle", "time": 2139.99, "timestamp": "00:35:39", "text": "工厂。"}, {"type": "subtitle", "time": 2142.47, "timestamp": "00:35:42", "text": "这是正常的工厂色号。等等，什么？"}, {"type": "subtitle", "time": 2144.79, "timestamp": "00:35:44", "text": "你是指正常情况吗？普通工厂。哦，"}, {"type": "subtitle", "time": 2148.31, "timestamp": "00:35:48", "text": "普通工厂。普通工厂。我 我"}, {"type": "subtitle", "time": 2150.069, "timestamp": "00:35:50", "text": "你不是说的是普通工厂启动器吗？"}, {"type": "subtitle", "time": 2151.91, "timestamp": "00:35:51", "text": "然后我就想，等等，还有其他变体"}]
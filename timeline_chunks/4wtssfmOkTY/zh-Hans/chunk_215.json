[{"type": "subtitle", "time": 12901.75, "timestamp": "03:35:01", "text": "你是我的服务器。是的。所以你就是那个人"}, {"type": "subtitle", "time": 12904.71, "timestamp": "03:35:04", "text": "谁私信了“是”。我当时想，“这人是谁？”"}, {"type": "subtitle", "time": 12908.15, "timestamp": "03:35:08", "text": "吠叫？我不知道。来自星星的人"}, {"type": "subtitle", "time": 12911.59, "timestamp": "03:35:11", "text": "小孩私信我了。这是谁的叫声？他的名字是"}, {"type": "subtitle", "time": 12916.07, "timestamp": "03:35:16", "text": "[音乐]"}, {"type": "subtitle", "time": 12919.349, "timestamp": "03:35:19", "text": "是的，我不擅长管理，因为"}, {"type": "subtitle", "time": 12922.87, "timestamp": "03:35:22", "text": "呃，因为我根本无法集中注意力"}, {"type": "subtitle", "time": 12925.19, "timestamp": "03:35:25", "text": "服务器，因为我会忙于我的"}, {"type": "subtitle", "time": 12929.59, "timestamp": "03:35:29", "text": "自己的东西。所以这就是为什么我……我觉得"}, {"type": "subtitle", "time": 12932.79, "timestamp": "03:35:32", "text": "有时候情况很糟糕，尤其是在我管理的时候。"}, {"type": "subtitle", "time": 12935.67, "timestamp": "03:35:35", "text": "任何服务器或其他任何东西。感觉很糟糕"}, {"type": "subtitle", "time": 12938.07, "timestamp": "03:35:38", "text": "我没有尽到版主的职责"}, {"type": "subtitle", "time": 12942.389, "timestamp": "03:35:42", "text": "任何事，或者查看，或者呃，审核和"}, {"type": "subtitle", "time": 12945.03, "timestamp": "03:35:45", "text": "待在现场并保持警惕"}, {"type": "subtitle", "time": 12946.87, "timestamp": "03:35:46", "text": "眼睛。"}, {"type": "subtitle", "time": 12949.11, "timestamp": "03:35:49", "text": "有时我会"}, {"type": "subtitle", "time": 12952.55, "timestamp": "03:35:52", "text": "密切关注。是的。"}, {"type": "subtitle", "time": 12955.269, "timestamp": "03:35:55", "text": "嗯。但"}, {"type": "subtitle", "time": 12958.229, "timestamp": "03:35:58", "text": "呃，我没有保持警惕的时候"}]
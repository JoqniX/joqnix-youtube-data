[{"type": "subtitle", "time": 5161.51, "timestamp": "01:26:01", "text": "套装。为什么它没有崩溃？"}, {"type": "subtitle", "time": 5165.51, "timestamp": "01:26:05", "text": "哦，找到了。这是一个超级棒的我"}, {"type": "subtitle", "time": 5167.83, "timestamp": "01:26:07", "text": "罗林斯。把它烧了，贱人。然后开始"}, {"type": "subtitle", "time": 5178.39, "timestamp": "01:26:18", "text": "好了。终于把事情办妥了。"}, {"type": "subtitle", "time": 5186.149, "timestamp": "01:26:26", "text": "请不要回头。"}, {"type": "subtitle", "time": 5188.55, "timestamp": "01:26:28", "text": "出色地，"}, {"type": "subtitle", "time": 5190.79, "timestamp": "01:26:30", "text": "我认为"}, {"type": "subtitle", "time": 5194.87, "timestamp": "01:26:34", "text": "我觉得这样就可以了。击中目标。"}, {"type": "subtitle", "time": 5196.55, "timestamp": "01:26:36", "text": "一座炮塔倒塌了。我不知道是什么"}, {"type": "subtitle", "time": 5201.83, "timestamp": "01:26:41", "text": "标签 mapwest"}, {"type": "subtitle", "time": 5208.709, "timestamp": "01:26:48", "text": "请求轨道。当他们拥有"}, {"type": "subtitle", "time": 5210.87, "timestamp": "01:26:50", "text": "线。真正的卡库里是赌徒造就的。"}, {"type": "subtitle", "time": 5214.709, "timestamp": "01:26:54", "text": "一路走来。手表。"}]
[{"type": "subtitle", "time": 4982.709, "timestamp": "01:23:02", "text": "绿巨人。"}, {"type": "subtitle", "time": 4985.669, "timestamp": "01:23:05", "text": "它一动不动。"}, {"type": "subtitle", "time": 4987.43, "timestamp": "01:23:07", "text": "是啊，他有点困惑。比如，我"}, {"type": "subtitle", "time": 4988.95, "timestamp": "01:23:08", "text": "之前就开枪打过他，但他没死。"}, {"type": "subtitle", "time": 4993.669, "timestamp": "01:23:13", "text": "什么事都没有，所以我就让他一个人待着了。"}, {"type": "subtitle", "time": 5000.629, "timestamp": "01:23:20", "text": "我超爱动作片。事情并非如此"}, {"type": "subtitle", "time": 5002.95, "timestamp": "01:23:22", "text": "已正确锁定。"}, {"type": "subtitle", "time": 5005.35, "timestamp": "01:23:25", "text": "快点。"}, {"type": "subtitle", "time": 5006.95, "timestamp": "01:23:26", "text": "好的，看来指挥掩体是"}, {"type": "subtitle", "time": 5009.51, "timestamp": "01:23:29", "text": "向下。是的，指挥掩体位于"}, {"type": "subtitle", "time": 5013.189, "timestamp": "01:23:33", "text": "向下。我朝它扔了一颗380。"}, {"type": "subtitle", "time": 5016.709, "timestamp": "01:23:36", "text": "不过我打算自己操作自动部分。"}, {"type": "subtitle", "time": 5030.87, "timestamp": "01:23:50", "text": "我仍然不知道炮塔在哪里。"}, {"type": "subtitle", "time": 5032.709, "timestamp": "01:23:52", "text": "是。"}, {"type": "subtitle", "time": 5035.51, "timestamp": "01:23:55", "text": "那个嗯"}, {"type": "subtitle", "time": 5037.59, "timestamp": "01:23:57", "text": "糟糕。我不确定这个基础款"}]
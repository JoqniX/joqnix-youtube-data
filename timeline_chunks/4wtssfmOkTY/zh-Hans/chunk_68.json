[{"type": "subtitle", "time": 4080.309, "timestamp": "01:08:00", "text": "比机器人和漏洞还要多。"}, {"type": "subtitle", "time": 4081.91, "timestamp": "01:08:01", "text": "我喜欢淘汰对手。我不喜欢"}, {"type": "subtitle", "time": 4087.43, "timestamp": "01:08:07", "text": "阿帕奇·范蒂娜。坑板。"}, {"type": "subtitle", "time": 4090.309, "timestamp": "01:08:10", "text": "你必须购买战争之子才能进行化学反应。"}, {"type": "subtitle", "time": 4093.67, "timestamp": "01:08:13", "text": "代理人。你可以免费购买。是的，你"}, {"type": "subtitle", "time": 4096.39, "timestamp": "01:08:16", "text": "做。你只需要付出大量的努力。如何"}, {"type": "subtitle", "time": 4098.87, "timestamp": "01:08:18", "text": "你收到了吗？至少你没有"}, {"type": "subtitle", "time": 4099.99, "timestamp": "01:08:19", "text": "支付任何东西。你可能会得到"}, {"type": "subtitle", "time": 4102.309, "timestamp": "01:08:22", "text": "一切免费。的确。那就是"}, {"type": "subtitle", "time": 4105.43, "timestamp": "01:08:25", "text": "这款游戏最棒的地方就在于此。"}, {"type": "subtitle", "time": 4107.189, "timestamp": "01:08:27", "text": "不用花一分钱。好的。做"}, {"type": "subtitle", "time": 4110.709, "timestamp": "01:08:30", "text": "你们觉得大师"}, {"type": "subtitle", "time": 4112.95, "timestamp": "01:08:32", "text": "值钱吗？"}, {"type": "subtitle", "time": 4115.349, "timestamp": "01:08:35", "text": "我的意思是，这个表情包很有趣。我喜欢"}, {"type": "subtitle", "time": 4117.11, "timestamp": "01:08:37", "text": "表达你的情感。我买它只是为了……"}, {"type": "subtitle", "time": 4121.349, "timestamp": "01:08:41", "text": "实际上是表情。哦，但这只是为了好玩而已。"}, {"type": "subtitle", "time": 4123.11, "timestamp": "01:08:43", "text": "行进的表情符号很有趣。有一个"}, {"type": "subtitle", "time": 4126.55, "timestamp": "01:08:46", "text": "里面藏着一个秘密彩蛋。"}, {"type": "subtitle", "time": 4129.51, "timestamp": "01:08:49", "text": "如何获得行进表情？"}, {"type": "subtitle", "time": 4132.229, "timestamp": "01:08:52", "text": "嗯，司仪是战争债券。哦，那"}, {"type": "subtitle", "time": 4134.709, "timestamp": "01:08:54", "text": "第一个。不，不，不。最新"}, {"type": "subtitle", "time": 4136.95, "timestamp": "01:08:56", "text": "一。"}, {"type": "subtitle", "time": 4138.309, "timestamp": "01:08:58", "text": "那是最近发行的战争债券。它是"}]
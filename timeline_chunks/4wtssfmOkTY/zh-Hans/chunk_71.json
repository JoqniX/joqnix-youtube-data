[{"type": "subtitle", "time": 4261.669, "timestamp": "01:11:01", "text": "呃，注射。是的，它的弹药无限。"}, {"type": "subtitle", "time": 4262.95, "timestamp": "01:11:02", "text": "但你还有六次机会。"}, {"type": "subtitle", "time": 4264.47, "timestamp": "01:11:04", "text": "过热。"}, {"type": "subtitle", "time": 4267.189, "timestamp": "01:11:07", "text": "哦好的。如果它过热，你就……"}, {"type": "subtitle", "time": 4269.75, "timestamp": "01:11:09", "text": "你有三节能量电池。哦，如果"}, {"type": "subtitle", "time": 4271.83, "timestamp": "01:11:11", "text": "它过热了，你重新装填。但如果"}, {"type": "subtitle", "time": 4274.63, "timestamp": "01:11:14", "text": "不会过热，你可以选择点燃"}, {"type": "subtitle", "time": 4289.35, "timestamp": "01:11:29", "text": "它是悬停式的。它有一个悬浮背包。"}, {"type": "subtitle", "time": 4291.189, "timestamp": "01:11:31", "text": "这对于对抗虫害真的很有帮助。"}, {"type": "subtitle", "time": 4294.87, "timestamp": "01:11:34", "text": "非常烦人，呃"}, {"type": "subtitle", "time": 4296.79, "timestamp": "01:11:36", "text": "呃，机器人。哦，你可以成为曼达洛人"}, {"type": "subtitle", "time": 4299.99, "timestamp": "01:11:39", "text": "这。是的，"}, {"type": "subtitle", "time": 4302.95, "timestamp": "01:11:42", "text": "车辆可以进行个性化定制。"}, {"type": "subtitle", "time": 4305.11, "timestamp": "01:11:45", "text": "哦，是的。呃，就是颜色。您可以更改"}, {"type": "subtitle", "time": 4306.79, "timestamp": "01:11:46", "text": "车辆的颜色。这让我想起来了。"}, {"type": "subtitle", "time": 4310.229, "timestamp": "01:11:50", "text": "我。我看看能不能找到任何字符串。"}, {"type": "subtitle", "time": 4312.07, "timestamp": "01:11:52", "text": "战争债券皮肤包。不，不，他们"}, {"type": "subtitle", "time": 4315.11, "timestamp": "01:11:55", "text": "里面确实也装有武器。"}, {"type": "subtitle", "time": 4316.87, "timestamp": "01:11:56", "text": "而且，如果你……的话，你可以免费获得它们。"}]
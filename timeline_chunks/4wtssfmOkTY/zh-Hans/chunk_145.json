[{"type": "subtitle", "time": 8702.55, "timestamp": "02:25:02", "text": "再举一个例子。这是真的。"}, {"type": "subtitle", "time": 8704.87, "timestamp": "02:25:04", "text": "第一波敌人的数量"}, {"type": "subtitle", "time": 8707.27, "timestamp": "02:25:07", "text": "我的天哪。"}, {"type": "subtitle", "time": 8721.51, "timestamp": "02:25:21", "text": "另一种社交能量来源。我猜"}, {"type": "subtitle", "time": 8724.23, "timestamp": "02:25:24", "text": "你需要多榨点果汁。我觉得自己老了"}, {"type": "subtitle", "time": 8726.23, "timestamp": "02:25:26", "text": "真他妈糟透了。"}, {"type": "subtitle", "time": 8729.429, "timestamp": "02:25:29", "text": "情绪。我也有那批战利品。"}, {"type": "subtitle", "time": 8733.75, "timestamp": "02:25:33", "text": "我的天啊。枪支酒吧。"}, {"type": "subtitle", "time": 8736.71, "timestamp": "02:25:36", "text": "没关系。我能看到这种混乱"}, {"type": "subtitle", "time": 8739.67, "timestamp": "02:25:39", "text": "你周围尽是毁灭。"}, {"type": "subtitle", "time": 8741.19, "timestamp": "02:25:41", "text": "我几乎可以肯定我会死在……"}, {"type": "subtitle", "time": 8747.27, "timestamp": "02:25:47", "text": "那"}, {"type": "subtitle", "time": 8751.83, "timestamp": "02:25:51", "text": "我的天啊。晚安，雷克萨。谢谢，"}, {"type": "subtitle", "time": 8754.309, "timestamp": "02:25:54", "text": "团伙。再见。熬过30天就行了"}, {"type": "subtitle", "time": 8755.83, "timestamp": "02:25:55", "text": "秒，乔。你没事。你正在做的"}]
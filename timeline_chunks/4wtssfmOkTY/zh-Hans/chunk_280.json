[{"type": "subtitle", "time": 16801.03, "timestamp": "04:40:01", "text": "知道。让我们来看看。让我把这些都喝光。"}, {"type": "subtitle", "time": 16814.39, "timestamp": "04:40:14", "text": "我的天，太好吃了。"}, {"type": "subtitle", "time": 16819.03, "timestamp": "04:40:19", "text": "香草味的牛奶真好喝。所以我使用"}, {"type": "subtitle", "time": 16821.35, "timestamp": "04:40:21", "text": "蛋白质粉。"}, {"type": "subtitle", "time": 16825.27, "timestamp": "04:40:25", "text": "天哪，我太弱了。虚弱，宝贝。"}, {"type": "subtitle", "time": 16827.59, "timestamp": "04:40:27", "text": "是的，"}, {"type": "subtitle", "time": 16831.03, "timestamp": "04:40:31", "text": "我买了那个，呃，我买了那个"}, {"type": "subtitle", "time": 16834.55, "timestamp": "04:40:34", "text": "香草水平"}, {"type": "subtitle", "time": 16837.75, "timestamp": "04:40:37", "text": "不含糖，但并非无糖"}, {"type": "subtitle", "time": 16839.59, "timestamp": "04:40:39", "text": "当然"}, {"type": "subtitle", "time": 16843.59, "timestamp": "04:40:43", "text": "蛋白奶昔，蛋白牛奶。"}, {"type": "subtitle", "time": 16845.83, "timestamp": "04:40:45", "text": "是的，"}, {"type": "subtitle", "time": 16849.49, "timestamp": "04:40:49", "text": "那对我的帮助很大。"}, {"type": "subtitle", "time": 16851.75, "timestamp": "04:40:51", "text": "[音乐]"}, {"type": "subtitle", "time": 16853.27, "timestamp": "04:40:53", "text": "是的。"}, {"type": "subtitle", "time": 16854.948, "timestamp": "04:40:54", "text": "全部"}]
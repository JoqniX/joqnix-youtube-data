[{"type": "subtitle", "time": 4560.47, "timestamp": "01:16:00", "text": "我太累了。没有延迟。"}, {"type": "subtitle", "time": 4563.35, "timestamp": "01:16:03", "text": "哦，那是行动的结果。"}, {"type": "subtitle", "time": 4565.11, "timestamp": "01:16:05", "text": "一些螺栓。不，并非所有栓动步枪都有"}, {"type": "subtitle", "time": 4567.03, "timestamp": "01:16:07", "text": "向它发送一个 ping 信号。只是那一个是"}, {"type": "subtitle", "time": 4568.79, "timestamp": "01:16:08", "text": "夹式。由于它是夹式进纸的，所以存在一个"}, {"type": "subtitle", "time": 4571.35, "timestamp": "01:16:11", "text": "向它发送 ping 信号。是的。"}, {"type": "subtitle", "time": 4573.189, "timestamp": "01:16:13", "text": "所以，在杂志出现之前，曾经有过……"}, {"type": "subtitle", "time": 4575.11, "timestamp": "01:16:15", "text": "片段。它简直就像一块"}, {"type": "subtitle", "time": 4577.03, "timestamp": "01:16:17", "text": "固定每个背面的金属"}, {"type": "subtitle", "time": 4579.91, "timestamp": "01:16:19", "text": "基本上就是子弹。是的。嗯。你呢"}, {"type": "subtitle", "time": 4582.47, "timestamp": "01:16:22", "text": "直接塞进枪里就行了。粉笔。是"}, {"type": "subtitle", "time": 4585.189, "timestamp": "01:16:25", "text": "你在那里？是的。是的。是的。正在检查"}, {"type": "subtitle", "time": 4587.03, "timestamp": "01:16:27", "text": "全部拿出来。"}, {"type": "subtitle", "time": 4590.63, "timestamp": "01:16:30", "text": "只是想找些皮肤。我有800个。"}, {"type": "subtitle", "time": 4593.03, "timestamp": "01:16:33", "text": "等等，你们已经开始了吗？等等，什么时候的事？"}, {"type": "subtitle", "time": 4594.95, "timestamp": "01:16:34", "text": "你还好吗？"}, {"type": "subtitle", "time": 4597.03, "timestamp": "01:16:37", "text": "这里。哦，是的。对了，哦，你"}, {"type": "subtitle", "time": 4599.03, "timestamp": "01:16:39", "text": "得到"}, {"type": "subtitle", "time": 4601.83, "timestamp": "01:16:41", "text": "等等，你怎么会有这些东西？"}, {"type": "subtitle", "time": 4603.51, "timestamp": "01:16:43", "text": "已解锁。你好吗？你做得怎么样？"}, {"type": "subtitle", "time": 4606.95, "timestamp": "01:16:46", "text": "教程版？什么教程？"}, {"type": "subtitle", "time": 4608.63, "timestamp": "01:16:48", "text": "你说你卡在教程里了。"}, {"type": "subtitle", "time": 4610.87, "timestamp": "01:16:50", "text": "不，不，不。我当时正在看YouTube视频。"}, {"type": "subtitle", "time": 4612.79, "timestamp": "01:16:52", "text": "Youtube 视频。我知道如何修复"}, {"type": "subtitle", "time": 4616.149, "timestamp": "01:16:56", "text": "帧率。我的天啊。"}, {"type": "subtitle", "time": 4619.51, "timestamp": "01:16:59", "text": "我知道。哦。"}]
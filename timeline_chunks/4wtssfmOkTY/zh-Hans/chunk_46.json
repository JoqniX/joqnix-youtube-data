[{"type": "subtitle", "time": 2761.91, "timestamp": "00:46:01", "text": "也就是说，我们确实赢得了这场鱿鱼大战。"}, {"type": "subtitle", "time": 2765.19, "timestamp": "00:46:05", "text": "消灭了我们的鱿鱼。确切地。等待，"}, {"type": "subtitle", "time": 2766.71, "timestamp": "00:46:06", "text": "真的吗？"}, {"type": "subtitle", "time": 2769.91, "timestamp": "00:46:09", "text": "是的。是的。糟糕。每当你 ping 时"}, {"type": "subtitle", "time": 2771.67, "timestamp": "00:46:11", "text": "他们说，这边有鱿鱼，或者"}, {"type": "subtitle", "time": 2775.109, "timestamp": "00:46:15", "text": "鱿鱼。我们在那儿找到了鱿鱼。所以这个梗"}, {"type": "subtitle", "time": 2779.51, "timestamp": "00:46:19", "text": "f 是炸鱿鱼民主吗？"}, {"type": "subtitle", "time": 2783.109, "timestamp": "00:46:23", "text": "或者我认为是叛国罪，我不这么认为。"}, {"type": "subtitle", "time": 2784.87, "timestamp": "00:46:24", "text": "大概就是这样。是的"}, {"type": "subtitle", "time": 2786.39, "timestamp": "00:46:26", "text": "叛徒"}, {"type": "subtitle", "time": 2788.71, "timestamp": "00:46:28", "text": "我们的家"}, {"type": "subtitle", "time": 2790.87, "timestamp": "00:46:30", "text": "繁荣。"}, {"type": "subtitle", "time": 2793.829, "timestamp": "00:46:33", "text": "哦，我还活着！你好呀。我们可以开始了"}, {"type": "subtitle", "time": 2796.309, "timestamp": "00:46:36", "text": "走向资源掠夺式民主。哦"}, {"type": "subtitle", "time": 2799.19, "timestamp": "00:46:39", "text": "我不知道我为什么会在这里。"}, {"type": "subtitle", "time": 2801.91, "timestamp": "00:46:41", "text": "不过我当时在提取处。"}, {"type": "subtitle", "time": 2804.63, "timestamp": "00:46:44", "text": "我们来触发它。不。但自由"}, {"type": "subtitle", "time": 2817.27, "timestamp": "00:46:57", "text": "眼熟？"}, {"type": "subtitle", "time": 2819.51, "timestamp": "00:46:59", "text": "这样的场景在各地都在发生。"}]
[{"type": "subtitle", "time": 780.31, "timestamp": "00:13:00", "text": "我的建议是，去那里看看。"}, {"type": "subtitle", "time": 782.31, "timestamp": "00:13:02", "text": "会有人回来继续谈论这件事。"}, {"type": "subtitle", "time": 785.43, "timestamp": "00:13:05", "text": "关于你，作为一个"}, {"type": "subtitle", "time": 787.99, "timestamp": "00:13:07", "text": "我觉得我……我觉得我被反驳了"}, {"type": "subtitle", "time": 791.11, "timestamp": "00:13:11", "text": "谁知道呢，我不在乎，但是，是的。"}, {"type": "subtitle", "time": 792.87, "timestamp": "00:13:12", "text": "当然，当我了解它的时候"}, {"type": "subtitle", "time": 795.59, "timestamp": "00:13:15", "text": "当然，我会感到受伤。"}, {"type": "subtitle", "time": 799.19, "timestamp": "00:13:19", "text": "这让我很受伤，哇，我竟然相信了你。"}, {"type": "subtitle", "time": 802.55, "timestamp": "00:13:22", "text": "这个人，以及他们为什么顶嘴"}, {"type": "subtitle", "time": 805.19, "timestamp": "00:13:25", "text": "关于我以及背后发生的那些事，什么？"}, {"type": "subtitle", "time": 808.629, "timestamp": "00:13:28", "text": "我到底对他们做了什么？"}, {"type": "subtitle", "time": 811.03, "timestamp": "00:13:31", "text": "在这种情况下，"}, {"type": "subtitle", "time": 813.829, "timestamp": "00:13:33", "text": "如果你知道p，如果你，如果你呃"}, {"type": "subtitle", "time": 816.389, "timestamp": "00:13:36", "text": "我是从别人那里学来的，我的意思是"}, {"type": "subtitle", "time": 818.47, "timestamp": "00:13:38", "text": "如果你愿意，你可以直接面对它。"}, {"type": "subtitle", "time": 819.99, "timestamp": "00:13:39", "text": "如果你足够自信，你就可以"}, {"type": "subtitle", "time": 823.91, "timestamp": "00:13:43", "text": "把这件事记在心里，然后去做。"}, {"type": "subtitle", "time": 825.829, "timestamp": "00:13:45", "text": "现在有很多方法可以做到这一点。"}, {"type": "subtitle", "time": 827.43, "timestamp": "00:13:47", "text": "要么你就别跟这个人说话。"}, {"type": "subtitle", "time": 830.47, "timestamp": "00:13:50", "text": "别再问了，或者直接问。"}, {"type": "subtitle", "time": 834.23, "timestamp": "00:13:54", "text": "质问他们，比如“嘿，我听说……”"}, {"type": "subtitle", "time": 836.47, "timestamp": "00:13:56", "text": "这个和这些东西。这是真的吗？做过"}, {"type": "subtitle", "time": 838.47, "timestamp": "00:13:58", "text": "你"}]
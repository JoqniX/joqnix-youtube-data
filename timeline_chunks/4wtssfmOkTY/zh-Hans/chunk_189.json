[{"type": "subtitle", "time": 11354.07, "timestamp": "03:09:14", "text": "[音乐]"}, {"type": "subtitle", "time": 11357.19, "timestamp": "03:09:17", "text": "哦，我看到你了。请允许我提出一个请求。让"}, {"type": "subtitle", "time": 11359.11, "timestamp": "03:09:19", "text": "我加你为好友。添加你为"}, {"type": "subtitle", "time": 11360.71, "timestamp": "03:09:20", "text": "朋友。"}, {"type": "subtitle", "time": 11370.469, "timestamp": "03:09:30", "text": "你好。好友请求已发送。"}, {"type": "subtitle", "time": 11373.03, "timestamp": "03:09:33", "text": "我的天啊。为什么我有很多朋友"}, {"type": "subtitle", "time": 11376.23, "timestamp": "03:09:36", "text": "有什么要求吗？我的天哪。什么？"}, {"type": "subtitle", "time": 11383.429, "timestamp": "03:09:43", "text": "我收到了17个好友请求。什么？缺席的。"}, {"type": "subtitle", "time": 11386.469, "timestamp": "03:09:46", "text": "这是"}, {"type": "subtitle", "time": 11389.269, "timestamp": "03:09:49", "text": "哦，这是因为我从未检查过我的"}, {"type": "subtitle", "time": 11391.99, "timestamp": "03:09:51", "text": "现在我像动物一样"}, {"type": "subtitle", "time": 11399.429, "timestamp": "03:09:59", "text": "巴巴。我当时在看你玩三级赛。"}]
[{"type": "subtitle", "time": 6067.189, "timestamp": "01:41:07", "text": "100. 那算死亡吗？好的。那是吗？"}, {"type": "subtitle", "time": 6072.55, "timestamp": "01:41:12", "text": "死亡之塔？它在哪里？耶稣基督。"}, {"type": "subtitle", "time": 6075.59, "timestamp": "01:41:15", "text": "我屁股上没有增援。哦，那是"}, {"type": "subtitle", "time": 6079.03, "timestamp": "01:41:19", "text": "一颗地狱炸弹。是的。我带过来。你想"}, {"type": "subtitle", "time": 6081.99, "timestamp": "01:41:21", "text": "要武装它吗？是的。好久不见了。我是"}, {"type": "subtitle", "time": 6093.35, "timestamp": "01:41:33", "text": "哦，有东西。"}, {"type": "subtitle", "time": 6100.95, "timestamp": "01:41:40", "text": "糟糕。"}, {"type": "subtitle", "time": 6103.91, "timestamp": "01:41:43", "text": "等等，什么？我是怎么活下来的？"}, {"type": "subtitle", "time": 6107.03, "timestamp": "01:41:47", "text": "哦，你没能活下来。糟糕。"}, {"type": "subtitle", "time": 6109.51, "timestamp": "01:41:49", "text": "黄油，回来吧。我有样品。"}, {"type": "subtitle", "time": 6111.91, "timestamp": "01:41:51", "text": "请求增援。"}, {"type": "subtitle", "time": 6115.99, "timestamp": "01:41:55", "text": "我把你扔向了那个方向。谢谢。"}]
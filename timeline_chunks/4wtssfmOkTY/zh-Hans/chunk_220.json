[{"type": "subtitle", "time": 13200.229, "timestamp": "03:40:00", "text": "这很难。你真正工作的内容是什么？"}, {"type": "subtitle", "time": 13202.309, "timestamp": "03:40:02", "text": "现在难了吗？"}, {"type": "subtitle", "time": 13206.07, "timestamp": "03:40:06", "text": "吉。吉。头垫。"}, {"type": "subtitle", "time": 13208.55, "timestamp": "03:40:08", "text": "你需要头垫。你工作非常努力"}, {"type": "subtitle", "time": 13218.95, "timestamp": "03:40:18", "text": "你真是个勤奋的人。我了解那种痛苦"}, {"type": "subtitle", "time": 13221.67, "timestamp": "03:40:21", "text": "呃，创建服务器之类的。"}, {"type": "subtitle", "time": 13233.11, "timestamp": "03:40:33", "text": "好人。"}, {"type": "subtitle", "time": 13235.269, "timestamp": "03:40:35", "text": "所以，你花了多少天才喜欢上它"}, {"type": "subtitle", "time": 13237.91, "timestamp": "03:40:37", "text": "全部完成吗？"}, {"type": "subtitle", "time": 13240.63, "timestamp": "03:40:40", "text": "负责人去设置板子，"}, {"type": "subtitle", "time": 13242.15, "timestamp": "03:40:42", "text": "嵌入式"}, {"type": "subtitle", "time": 13246.07, "timestamp": "03:40:46", "text": "所有这些东西，安排，"}, {"type": "subtitle", "time": 13248.87, "timestamp": "03:40:48", "text": "所有权限，"}, {"type": "subtitle", "time": 13257.59, "timestamp": "03:40:57", "text": "我想这大概需要一段时间。"}, {"type": "subtitle", "time": 13259.349, "timestamp": "03:40:59", "text": "正确的？"}]
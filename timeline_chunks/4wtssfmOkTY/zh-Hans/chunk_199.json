[{"type": "subtitle", "time": 11944.79, "timestamp": "03:19:04", "text": "是的，他到学校了。你好。别这样"}, {"type": "subtitle", "time": 11948.55, "timestamp": "03:19:08", "text": "这次来晚了，巴卡。"}, {"type": "subtitle", "time": 11959.19, "timestamp": "03:19:19", "text": "[音乐]"}, {"type": "subtitle", "time": 11960.63, "timestamp": "03:19:20", "text": "你好。"}, {"type": "subtitle", "time": 11967.83, "timestamp": "03:19:27", "text": "车马死了。车。"}, {"type": "subtitle", "time": 11970.469, "timestamp": "03:19:30", "text": "等待。鞍马。"}, {"type": "subtitle", "time": 11975.11, "timestamp": "03:19:35", "text": "鞍马。鞍马就像一辆车死了。"}, {"type": "subtitle", "time": 11979.99, "timestamp": "03:19:39", "text": "车。哦，等等。鞍马。"}, {"type": "subtitle", "time": 11983.67, "timestamp": "03:19:43", "text": "WHO？这是什么？鞍马。"}, {"type": "subtitle", "time": 11986.399, "timestamp": "03:19:46", "text": "鞍马。 哦，是《火影忍者》里的。哦。"}, {"type": "subtitle", "time": 11990.64, "timestamp": "03:19:50", "text": "哦，是《火影忍者》里的。哦。 啊。"}, {"type": "subtitle", "time": 11992.96, "timestamp": "03:19:52", "text": "啊。 [音乐]"}, {"type": "subtitle", "time": 11994.08, "timestamp": "03:19:54", "text": "[音乐] 是的。再见。"}]
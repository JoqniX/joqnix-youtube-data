[{"type": "subtitle", "time": 5053.91, "timestamp": "01:24:13", "text": "好球。"}, {"type": "subtitle", "time": 5062.709, "timestamp": "01:24:22", "text": "我的天啊。我扔了500个。小心点。"}, {"type": "subtitle", "time": 5066.229, "timestamp": "01:24:26", "text": "糟糕。是的，我们会挺过去的。"}, {"type": "subtitle", "time": 5068.07, "timestamp": "01:24:28", "text": "是，是"}, {"type": "subtitle", "time": 5069.91, "timestamp": "01:24:29", "text": "增援部队直接空降到顶部"}, {"type": "subtitle", "time": 5071.59, "timestamp": "01:24:31", "text": "是我。"}, {"type": "subtitle", "time": 5073.35, "timestamp": "01:24:33", "text": "塞斯·罗林斯出现在Netflix上"}, {"type": "subtitle", "time": 5076.47, "timestamp": "01:24:36", "text": "类别。等等，什么？"}, {"type": "subtitle", "time": 5089.35, "timestamp": "01:24:49", "text": "哦。我的天啊。过来。有一个"}, {"type": "subtitle", "time": 5093.75, "timestamp": "01:24:53", "text": "有故障的导弹。空气中弥漫着这种气息。"}, {"type": "subtitle", "time": 5096.47, "timestamp": "01:24:56", "text": "好的。导弹里装了窃听器。"}, {"type": "subtitle", "time": 5098.07, "timestamp": "01:24:58", "text": "空气。"}]
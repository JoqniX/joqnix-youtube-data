[{"type": "subtitle", "time": 6186.629, "timestamp": "01:43:06", "text": "你确定这是地狱潜水点吗？是吗？"}, {"type": "subtitle", "time": 6190.31, "timestamp": "01:43:10", "text": "雨？那是雨。是的。没错，确实如此。"}, {"type": "subtitle", "time": 6193.189, "timestamp": "01:43:13", "text": "哦，我的东西都在那儿。这是火山"}, {"type": "subtitle", "time": 6198.95, "timestamp": "01:43:18", "text": "你知道吗？"}, {"type": "subtitle", "time": 6202.07, "timestamp": "01:43:22", "text": "我无法在这里锁定你。玩得开心"}, {"type": "subtitle", "time": 6203.99, "timestamp": "01:43:23", "text": "那。"}, {"type": "subtitle", "time": 6207.59, "timestamp": "01:43:27", "text": "子弹。那是自由的露珠。"}, {"type": "subtitle", "time": 6210.07, "timestamp": "01:43:30", "text": "是的。这不是水。它是"}, {"type": "subtitle", "time": 6212.55, "timestamp": "01:43:32", "text": "茶雨。"}, {"type": "subtitle", "time": 6218.709, "timestamp": "01:43:38", "text": "克洛诺斯。"}, {"type": "subtitle", "time": 6221.43, "timestamp": "01:43:41", "text": "我不知道为什么这听起来很诗意。"}, {"type": "subtitle", "time": 6223.51, "timestamp": "01:43:43", "text": "这就是民主。"}, {"type": "subtitle", "time": 6225.59, "timestamp": "01:43:45", "text": "地球在哭泣，因为它……"}, {"type": "subtitle", "time": 6236.79, "timestamp": "01:43:56", "text": "我的天啊。我不会说"}, {"type": "subtitle", "time": 6239.51, "timestamp": "01:43:59", "text": "黄金雨。"}]
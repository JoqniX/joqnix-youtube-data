[{"type": "subtitle", "time": 4020.71, "timestamp": "01:07:00", "text": "鱿鱼眼看向路边。不，我们没有。"}, {"type": "subtitle", "time": 4023.19, "timestamp": "01:07:03", "text": "带走它们。我们把它们炸了。我们油炸"}, {"type": "subtitle", "time": 4026.47, "timestamp": "01:07:06", "text": "甚至连他们自己也一样。油炸。是的，没问题。"}, {"type": "subtitle", "time": 4030.309, "timestamp": "01:07:10", "text": "空气炸锅炸制食品。是的。是的。我们得去"}, {"type": "subtitle", "time": 4032.63, "timestamp": "01:07:12", "text": "让它健康一些。民主地呃炸"}, {"type": "subtitle", "time": 4035.19, "timestamp": "01:07:15", "text": "一些鱿鱼圈。"}, {"type": "subtitle", "time": 4042.63, "timestamp": "01:07:22", "text": "是的。这个游戏跟我过不去。那是"}, {"type": "subtitle", "time": 4044.71, "timestamp": "01:07:24", "text": "你是怎么做到的？"}, {"type": "subtitle", "time": 4047.67, "timestamp": "01:07:27", "text": "哎呀，伙计。"}, {"type": "subtitle", "time": 4056.39, "timestamp": "01:07:36", "text": "无法编辑。"}, {"type": "subtitle", "time": 4058.71, "timestamp": "01:07:38", "text": "为什么？游戏中似乎发生了什么事。"}, {"type": "subtitle", "time": 4061.109, "timestamp": "01:07:41", "text": "上面有人们修剪的痕迹。金色饰边"}, {"type": "subtitle", "time": 4063.589, "timestamp": "01:07:43", "text": "看起来真不错。我知道，对吧？我们 我们"}, {"type": "subtitle", "time": 4067.19, "timestamp": "01:07:47", "text": "顺便一提，我们当时是在保卫超级地球。"}, {"type": "subtitle", "time": 4071.27, "timestamp": "01:07:51", "text": "不再。我们把他们带走了。是的，"}, {"type": "subtitle", "time": 4074.789, "timestamp": "01:07:54", "text": "光明会已被消灭。"}, {"type": "subtitle", "time": 4076.71, "timestamp": "01:07:56", "text": "伤心。我更喜欢与光明会作战。"}]
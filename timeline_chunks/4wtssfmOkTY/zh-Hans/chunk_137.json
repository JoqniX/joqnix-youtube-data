[{"type": "subtitle", "time": 8222.23, "timestamp": "02:17:02", "text": "你们一定要保住性命。"}, {"type": "subtitle", "time": 8224.07, "timestamp": "02:17:04", "text": "我们过不去那里。糟糕，"}, {"type": "subtitle", "time": 8226.15, "timestamp": "02:17:06", "text": "我们身后有个充电器。乔克做了"}, {"type": "subtitle", "time": 8228.629, "timestamp": "02:17:08", "text": "不要理会那东西。"}, {"type": "subtitle", "time": 8230.389, "timestamp": "02:17:10", "text": "是的，我想我犯了个错误。我的"}, {"type": "subtitle", "time": 8232.87, "timestamp": "02:17:12", "text": "移动棒。"}, {"type": "subtitle", "time": 8245.75, "timestamp": "02:17:25", "text": "楚玛说的那一刻，就像……"}, {"type": "subtitle", "time": 8248.709, "timestamp": "02:17:28", "text": "充电器在后方，"}, {"type": "subtitle", "time": 8250.95, "timestamp": "02:17:30", "text": "你死了，"}, {"type": "subtitle", "time": 8253.669, "timestamp": "02:17:33", "text": "男人。该死的！我做了什么"}, {"type": "subtitle", "time": 8256.15, "timestamp": "02:17:36", "text": "做？"}, {"type": "subtitle", "time": 8259.509, "timestamp": "02:17:39", "text": "这个地区很奇怪。哦，电影。等等，"}, {"type": "subtitle", "time": 8262.87, "timestamp": "02:17:42", "text": "那简直就是一座宫殿。"}, {"type": "subtitle", "time": 8264.79, "timestamp": "02:17:44", "text": "好吧，让我好好回忆一下那一刻。"}, {"type": "subtitle", "time": 8266.389, "timestamp": "02:17:46", "text": "一切都变绿了，赶紧滚蛋"}, {"type": "subtitle", "time": 8268.95, "timestamp": "02:17:48", "text": "尽快离开那里。"}, {"type": "subtitle", "time": 8279.99, "timestamp": "02:17:59", "text": "他们竟然在我面前表演杂技！"}]
[{"type": "subtitle", "time": 17340.47, "timestamp": "04:49:00", "text": "就像你记得的那个一样"}, {"type": "subtitle", "time": 17344.788, "timestamp": "04:49:04", "text": "我在另一台设备上随意唱了几首歌。"}, {"type": "subtitle", "time": 17348.23, "timestamp": "04:49:08", "text": "是哪条流？我忘了那件事"}, {"type": "subtitle", "time": 17356.23, "timestamp": "04:49:16", "text": "那个和这个都可以是"}, {"type": "subtitle", "time": 17358.23, "timestamp": "04:49:18", "text": "类似的匆忙。我不知道我为什么"}, {"type": "subtitle", "time": 17366.02, "timestamp": "04:49:26", "text": "得得得得走了"}, {"type": "subtitle", "time": 17377.03, "timestamp": "04:49:37", "text": "去"}]
[{"type": "subtitle", "time": 3731.589, "timestamp": "01:02:11", "text": "哦，他还没见过地狱炸弹呢，是吗？"}, {"type": "subtitle", "time": 3733.99, "timestamp": "01:02:13", "text": "他？哦，对，没错。那是"}, {"type": "subtitle", "time": 3736.71, "timestamp": "01:02:16", "text": "家。好的。好的，先生们。"}, {"type": "subtitle", "time": 3739.109, "timestamp": "01:02:19", "text": "呃，活下去。我们已经没有了"}, {"type": "subtitle", "time": 3741.91, "timestamp": "01:02:21", "text": "会复活，所以别死。妈的。不是"}, {"type": "subtitle", "time": 3749.91, "timestamp": "01:02:29", "text": "哦，是的。我已经把锁锁上了。"}, {"type": "subtitle", "time": 3753.67, "timestamp": "01:02:33", "text": "哦，在我身后。我得到了它。我看到了。哦，"}, {"type": "subtitle", "time": 3755.91, "timestamp": "01:02:35", "text": "好的。"}, {"type": "subtitle", "time": 3759.349, "timestamp": "01:02:39", "text": "好一个。鹰。"}, {"type": "subtitle", "time": 3764.87, "timestamp": "01:02:44", "text": "还有更多。 1分钟。 1分30秒。"}, {"type": "subtitle", "time": 3767.589, "timestamp": "01:02:47", "text": "哦，这里的解放者概念是什么？我已经"}, {"type": "subtitle", "time": 3771.109, "timestamp": "01:02:51", "text": "好像在哪儿见过。哦，步枪。就这么"}, {"type": "subtitle", "time": 3773.349, "timestamp": "01:02:53", "text": "使敌人眩晕。"}, {"type": "subtitle", "time": 3775.589, "timestamp": "01:02:55", "text": "非常好。"}, {"type": "subtitle", "time": 3777.43, "timestamp": "01:02:57", "text": "哦，糟糕。"}]
[{"type": "subtitle", "time": 1982.47, "timestamp": "00:33:02", "text": "嘿，伙计。"}, {"type": "subtitle", "time": 1984.389, "timestamp": "00:33:04", "text": "相同的。"}, {"type": "subtitle", "time": 1987.35, "timestamp": "00:33:07", "text": "上次没成功。"}, {"type": "subtitle", "time": 1989.909, "timestamp": "00:33:09", "text": "我想念我的"}, {"type": "subtitle", "time": 1993.19, "timestamp": "00:33:13", "text": "是啊，我怀念以前用的那台电脑。"}, {"type": "subtitle", "time": 1999.669, "timestamp": "00:33:19", "text": "我玩过这个游戏，但是它已经死了。是的。"}, {"type": "subtitle", "time": 2004.23, "timestamp": "00:33:24", "text": "我的画面看起来像像素画。"}, {"type": "subtitle", "time": 2006.95, "timestamp": "00:33:26", "text": "我在玩一款像素游戏，不过没关系。"}, {"type": "subtitle", "time": 2013.11, "timestamp": "00:33:33", "text": "是的，这是一款像素游戏，而且画面精美。"}, {"type": "subtitle", "time": 2022.789, "timestamp": "00:33:42", "text": "好的。我的天哪，我的电脑快不行了。怎么样？"}, {"type": "subtitle", "time": 2025.19, "timestamp": "00:33:45", "text": "它还在垂死吗？"}, {"type": "subtitle", "time": 2034.71, "timestamp": "00:33:54", "text": "天哪，我不太擅长……我不太擅长"}, {"type": "subtitle", "time": 2036.549, "timestamp": "00:33:56", "text": "这款游戏。"}, {"type": "subtitle", "time": 2038.789, "timestamp": "00:33:58", "text": "没关系。别担心。患病的"}]
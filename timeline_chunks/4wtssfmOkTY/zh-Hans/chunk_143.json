[{"type": "subtitle", "time": 8594.95, "timestamp": "02:23:14", "text": "它们听起来都不一样。什么？"}, {"type": "subtitle", "time": 8597.28, "timestamp": "02:23:17", "text": "怪物？"}, {"type": "subtitle", "time": 8603.27, "timestamp": "02:23:23", "text": "我的天啊。他们为什么要巡逻？"}, {"type": "subtitle", "time": 8606.55, "timestamp": "02:23:26", "text": "谢天谢地他们走了。"}, {"type": "subtitle", "time": 8614.08, "timestamp": "02:23:34", "text": "这现在变成恐怖游戏了。"}, {"type": "subtitle", "time": 8615.19, "timestamp": "02:23:35", "text": "[掌声]"}, {"type": "subtitle", "time": 8617.75, "timestamp": "02:23:37", "text": "妈的。"}]
[{"type": "subtitle", "time": 10742.86, "timestamp": "02:59:02", "text": "你从哪来？院长。"}, {"type": "subtitle", "time": 10750.23, "timestamp": "02:59:10", "text": "你好。你从哪来？"}, {"type": "subtitle", "time": 10753.19, "timestamp": "02:59:13", "text": "你来自哪个国家？情况如何？"}, {"type": "subtitle", "time": 10755.51, "timestamp": "02:59:15", "text": "她今天过得怎么样？"}, {"type": "subtitle", "time": 10782.63, "timestamp": "02:59:42", "text": "等待。仔细想想。"}, {"type": "subtitle", "time": 10786.63, "timestamp": "02:59:46", "text": "我从来没有过任何人"}, {"type": "subtitle", "time": 10790.15, "timestamp": "02:59:50", "text": "我跟谁说话。呃，等等，我从来没有过"}, {"type": "subtitle", "time": 10792.469, "timestamp": "02:59:52", "text": "任何来自尼泊尔的人。"}, {"type": "subtitle", "time": 10794.71, "timestamp": "02:59:54", "text": "所以你是我的第一个人，首先是"}]
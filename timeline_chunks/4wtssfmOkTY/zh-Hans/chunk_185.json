[{"type": "subtitle", "time": 11100.63, "timestamp": "03:05:00", "text": "正常的流量，对吧？"}, {"type": "subtitle", "time": 11103.11, "timestamp": "03:05:03", "text": "沙卡"}, {"type": "subtitle", "time": 11109.19, "timestamp": "03:05:09", "text": "唉，但我们会渡过难关的。所以谢谢"}, {"type": "subtitle", "time": 11111.59, "timestamp": "03:05:11", "text": "谢谢你这么耐心。"}, {"type": "subtitle", "time": 11115.11, "timestamp": "03:05:15", "text": "感谢你从现在开始的耐心等待。"}, {"type": "subtitle", "time": 11118.71, "timestamp": "03:05:18", "text": "直到他们想出办法为止"}, {"type": "subtitle", "time": 11128.23, "timestamp": "03:05:28", "text": "嗯。"}, {"type": "subtitle", "time": 11131.19, "timestamp": "03:05:31", "text": "昨天"}, {"type": "subtitle", "time": 11135.349, "timestamp": "03:05:35", "text": "我当时真的超级开心。"}, {"type": "subtitle", "time": 11137.99, "timestamp": "03:05:37", "text": "昨天我超级高兴，因为"}, {"type": "subtitle", "time": 11142.87, "timestamp": "03:05:42", "text": "我第一次能够说话了"}, {"type": "subtitle", "time": 11147.59, "timestamp": "03:05:47", "text": "对日本人来说。那是"}, {"type": "subtitle", "time": 11149.269, "timestamp": "03:05:49", "text": "艾玛。"}, {"type": "subtitle", "time": 11150.95, "timestamp": "03:05:50", "text": "呃"}, {"type": "subtitle", "time": 11152.87, "timestamp": "03:05:52", "text": "嗯，我很高兴能和她聊天。"}, {"type": "subtitle", "time": 11154.389, "timestamp": "03:05:54", "text": "昨天"}, {"type": "subtitle", "time": 11156.63, "timestamp": "03:05:56", "text": "并学习"}, {"type": "subtitle", "time": 11159.91, "timestamp": "03:05:59", "text": "关于她的一切。"}]
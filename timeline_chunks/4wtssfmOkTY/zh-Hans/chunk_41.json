[{"type": "subtitle", "time": 2460.23, "timestamp": "00:41:00", "text": "好了。更好的。"}, {"type": "subtitle", "time": 2471.27, "timestamp": "00:41:11", "text": "距离我上次战斗已经很久了。"}, {"type": "subtitle", "time": 2473.75, "timestamp": "00:41:13", "text": "机器人。我不，我总是忘记"}, {"type": "subtitle", "time": 2476.23, "timestamp": "00:41:16", "text": "寻找掩护。"}, {"type": "subtitle", "time": 2478.79, "timestamp": "00:41:18", "text": "那里有一只大草原漫步者。"}, {"type": "subtitle", "time": 2481.19, "timestamp": "00:41:21", "text": "又一个。我认为，不，没有。"}, {"type": "subtitle", "time": 2484.23, "timestamp": "00:41:24", "text": "在 Vic 附近。"}, {"type": "subtitle", "time": 2486.309, "timestamp": "00:41:26", "text": "等等，那已经死了。已经死了。它是"}, {"type": "subtitle", "time": 2488.79, "timestamp": "00:41:28", "text": "死的。它死了。哦，你只是"}, {"type": "subtitle", "time": 2491.75, "timestamp": "00:41:31", "text": "提取。是的。我们只是在提取。"}, {"type": "subtitle", "time": 2494.23, "timestamp": "00:41:34", "text": "哦，我当时就想，等等，稍等一下。我的"}, {"type": "subtitle", "time": 2497.03, "timestamp": "00:41:37", "text": "该死的太空激光居然没起作用。是的，"}, {"type": "subtitle", "time": 2499.829, "timestamp": "00:41:39", "text": "维克拿到了假货。"}, {"type": "subtitle", "time": 2503.99, "timestamp": "00:41:43", "text": "嗯，我们这是在干什么？激光。哦，不。我"}, {"type": "subtitle", "time": 2508.79, "timestamp": "00:41:48", "text": "搞砸了。别担心。"}, {"type": "subtitle", "time": 2511.67, "timestamp": "00:41:51", "text": "我以前没用过这种武器。"}, {"type": "subtitle", "time": 2515.589, "timestamp": "00:41:55", "text": "我只知道我会留下黄蜂。这"}, {"type": "subtitle", "time": 2518.47, "timestamp": "00:41:58", "text": "黄蜂。哦，这是……等等，我不知道"}]
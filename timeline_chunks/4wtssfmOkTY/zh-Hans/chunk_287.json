[{"type": "subtitle", "time": 17224.15, "timestamp": "04:47:04", "text": "让我们来看看。听着，我们这么说"}, {"type": "subtitle", "time": 17236.628, "timestamp": "04:47:16", "text": "等等，啊，当我做的时候，当我说的时候，我说"}, {"type": "subtitle", "time": 17238.628, "timestamp": "04:47:18", "text": "紧急情况。"}, {"type": "subtitle", "time": 17240.15, "timestamp": "04:47:20", "text": "啊，"}, {"type": "subtitle", "time": 17242.708, "timestamp": "04:47:22", "text": "我收到了这首歌的提醒。我不"}, {"type": "subtitle", "time": 17244.23, "timestamp": "04:47:24", "text": "想把它变成一首歌。我想制作"}, {"type": "subtitle", "time": 17246.788, "timestamp": "04:47:26", "text": "它很独特，是我可以……"}, {"type": "subtitle", "time": 17253.11, "timestamp": "04:47:33", "text": "疯狂的。"}]
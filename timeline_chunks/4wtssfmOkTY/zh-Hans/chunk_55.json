[{"type": "subtitle", "time": 3303.19, "timestamp": "00:55:03", "text": "你还要等多久？ 7分钟"}, {"type": "subtitle", "time": 3310.47, "timestamp": "00:55:10", "text": "这里简直就是战区。这是一个"}, {"type": "subtitle", "time": 3312.63, "timestamp": "00:55:12", "text": "排名第五。"}, {"type": "subtitle", "time": 3315.75, "timestamp": "00:55:15", "text": "排名 f。那是不是太高了？高高。"}, {"type": "subtitle", "time": 3317.51, "timestamp": "00:55:17", "text": "没有。不仅仅是难而已。它是"}, {"type": "subtitle", "time": 3319.99, "timestamp": "00:55:19", "text": "仅在困难模式下有效。我在……上看到了。"}, {"type": "subtitle", "time": 3323.109, "timestamp": "00:55:23", "text": "超级地狱跳伞。是啊，这算什么。"}, {"type": "subtitle", "time": 3335.75, "timestamp": "00:55:35", "text": "您可以扩展。"}, {"type": "subtitle", "time": 3338.71, "timestamp": "00:55:38", "text": "我白白浪费了弹药。"}, {"type": "subtitle", "time": 3343.03, "timestamp": "00:55:43", "text": "没关系。我们弄到了大量的弹药。"}, {"type": "subtitle", "time": 3345.349, "timestamp": "00:55:45", "text": "是的，我们算是敷衍了事了。我们有"}, {"type": "subtitle", "time": 3351.27, "timestamp": "00:55:51", "text": "哦，这个人是谁？哦，这是一个，这是一个"}, {"type": "subtitle", "time": 3353.75, "timestamp": "00:55:53", "text": "那是什么？"}, {"type": "subtitle", "time": 3357.91, "timestamp": "00:55:57", "text": "哦，那是助行器。哦，那里有个绿巨人。"}]
[{"type": "subtitle", "time": 4320.229, "timestamp": "01:12:00", "text": "磨碎它们。哦，对了，还有Steam。那些不是"}, {"type": "subtitle", "time": 4321.43, "timestamp": "01:12:01", "text": "皮肤。他们实际上拥有那些。"}, {"type": "subtitle", "time": 4323.51, "timestamp": "01:12:03", "text": "功能性。他们说他们要走了"}, {"type": "subtitle", "time": 4325.189, "timestamp": "01:12:05", "text": "发布一款用于Steam评论的皮肤。"}, {"type": "subtitle", "time": 4328.63, "timestamp": "01:12:08", "text": "我一个也没看到。"}, {"type": "subtitle", "time": 4330.229, "timestamp": "01:12:10", "text": "曾是"}, {"type": "subtitle", "time": 4331.669, "timestamp": "01:12:11", "text": "两个都。我不认为有武器。"}, {"type": "subtitle", "time": 4334.31, "timestamp": "01:12:14", "text": "皮肤。有盔甲。"}, {"type": "subtitle", "time": 4335.91, "timestamp": "01:12:15", "text": "严格来说，并没有皮肤这种东西。有"}, {"type": "subtitle", "time": 4338.709, "timestamp": "01:12:18", "text": "字面意义上的盔甲。有皮肤"}, {"type": "subtitle", "time": 4341.99, "timestamp": "01:12:21", "text": "带有实际的盔甲。是的，"}, {"type": "subtitle", "time": 4345.03, "timestamp": "01:12:25", "text": "你可以给它换皮肤。那"}, {"type": "subtitle", "time": 4347.83, "timestamp": "01:12:27", "text": "是最近的事。"}, {"type": "subtitle", "time": 4361.51, "timestamp": "01:12:41", "text": "让我看看好东西。格林纳迪亚"}, {"type": "subtitle", "time": 4365.43, "timestamp": "01:12:45", "text": "战士好吗？防守宝石。你你"}, {"type": "subtitle", "time": 4370.47, "timestamp": "01:12:50", "text": "你必须一天之内买齐所有东西。所以"}, {"type": "subtitle", "time": 4373.59, "timestamp": "01:12:53", "text": "我不能，我不能使用你的表情符号。"}, {"type": "subtitle", "time": 4377.11, "timestamp": "01:12:57", "text": "给我一分钟时间。我会重做。"}, {"type": "subtitle", "time": 4379.91, "timestamp": "01:12:59", "text": "在PS事件彻底失败之后。哦，是的，他们"}]
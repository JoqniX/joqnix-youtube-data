[{"type": "subtitle", "time": 1680.389, "timestamp": "00:28:00", "text": "我的天啊。这款游戏，这款游戏"}, {"type": "subtitle", "time": 1695.909, "timestamp": "00:28:15", "text": "这个游戏跟我过不去。我的天啊，"}, {"type": "subtitle", "time": 1698.63, "timestamp": "00:28:18", "text": "太卡了。"}, {"type": "subtitle", "time": 1702.149, "timestamp": "00:28:22", "text": "快点。我一会儿就去参加风险投资。我"}, {"type": "subtitle", "time": 1705.269, "timestamp": "00:28:25", "text": "必须这么做"}, {"type": "subtitle", "time": 1708.23, "timestamp": "00:28:28", "text": "我已经百分之百确定它要坏了。但"}, {"type": "subtitle", "time": 1709.99, "timestamp": "00:28:29", "text": "o"}]
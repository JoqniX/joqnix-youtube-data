[{"type": "subtitle", "time": 3420.309, "timestamp": "00:57:00", "text": "说实话，是增援部队。哦，我的"}, {"type": "subtitle", "time": 3423.589, "timestamp": "00:57:03", "text": "上帝。这是霸凌行为。"}, {"type": "subtitle", "time": 3427.03, "timestamp": "00:57:07", "text": "糟糕，我差点摔倒。"}, {"type": "subtitle", "time": 3429.829, "timestamp": "00:57:09", "text": "5分钟。"}, {"type": "subtitle", "time": 3433.829, "timestamp": "00:57:13", "text": "那是一把霰弹枪吗？呃，杠杆式"}, {"type": "subtitle", "time": 3437.829, "timestamp": "00:57:17", "text": "正确的？马克步枪。武器就是武器。"}, {"type": "subtitle", "time": 3440.549, "timestamp": "00:57:20", "text": "欢迎回到直播间。认错猫了。"}, {"type": "subtitle", "time": 3443.829, "timestamp": "00:57:23", "text": "不，这不是小猫。这是一只小猫。"}, {"type": "subtitle", "time": 3447.75, "timestamp": "00:57:27", "text": "好的。衣服全买齐了。"}, {"type": "subtitle", "time": 3450.789, "timestamp": "00:57:30", "text": "我的天哪。你去哪里？我什么也看不见。"}, {"type": "subtitle", "time": 3453.43, "timestamp": "00:57:33", "text": "东西。"}, {"type": "subtitle", "time": 3456.71, "timestamp": "00:57:36", "text": "他们都支持这块岩石，"}, {"type": "subtitle", "time": 3459.589, "timestamp": "00:57:39", "text": "你知道。这不是“我的天哪”。"}, {"type": "subtitle", "time": 3461.67, "timestamp": "00:57:41", "text": "我们就像在胡闹一样"}, {"type": "subtitle", "time": 3470.789, "timestamp": "00:57:50", "text": "不用担心。他们都死了。他们是"}, {"type": "subtitle", "time": 3474.309, "timestamp": "00:57:54", "text": "死的。我放置了轨道。"}, {"type": "subtitle", "time": 3476.71, "timestamp": "00:57:56", "text": "我的天，这也太亮了吧。不，不"}, {"type": "subtitle", "time": 3479.51, "timestamp": "00:57:59", "text": "鳕鱼颈。"}]
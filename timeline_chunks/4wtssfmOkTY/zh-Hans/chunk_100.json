[{"type": "subtitle", "time": 6002.31, "timestamp": "01:40:02", "text": "出色地，"}, {"type": "subtitle", "time": 6019.43, "timestamp": "01:40:19", "text": "果酱在哪儿？哦，干扰器。好的，我"}, {"type": "subtitle", "time": 6021.109, "timestamp": "01:40:21", "text": "干扰器到了。我得到了它。我得到了它。我"}, {"type": "subtitle", "time": 6024.47, "timestamp": "01:40:24", "text": "知道了。什么？我身上有个绿巨人。如何"}, {"type": "subtitle", "time": 6026.709, "timestamp": "01:40:26", "text": "我死了吗？"}, {"type": "subtitle", "time": 6030.229, "timestamp": "01:40:30", "text": "不，你当时就差不多死了。呃，我得到了"}, {"type": "subtitle", "time": 6032.39, "timestamp": "01:40:32", "text": "我卡住了。"}, {"type": "subtitle", "time": 6040.149, "timestamp": "01:40:40", "text": "[音乐]"}, {"type": "subtitle", "time": 6047.27, "timestamp": "01:40:47", "text": "致雅克。别担心，他没事。我是"}, {"type": "subtitle", "time": 6049.109, "timestamp": "01:40:49", "text": "紧随其后。杀了我，"}, {"type": "subtitle", "time": 6050.87, "timestamp": "01:40:50", "text": "雅克。"}]
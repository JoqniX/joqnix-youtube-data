[{"type": "subtitle", "time": 10860.95, "timestamp": "03:01:00", "text": "你今天过得怎么样？我今天过得很充实"}, {"type": "subtitle", "time": 10862.79, "timestamp": "03:01:02", "text": "好的。"}, {"type": "subtitle", "time": 10868.309, "timestamp": "03:01:08", "text": "昨天真是漫长的一天。"}, {"type": "subtitle", "time": 10870.95, "timestamp": "03:01:10", "text": "最近我一直在做5小时或6小时的工作。"}, {"type": "subtitle", "time": 10873.269, "timestamp": "03:01:13", "text": "清晨的溪流。阿萨达将"}, {"type": "subtitle", "time": 10876.87, "timestamp": "03:01:16", "text": "持续5小时。然后我就开始直播。"}, {"type": "subtitle", "time": 10880.15, "timestamp": "03:01:20", "text": "之后就取决于我在哪里直播了。"}, {"type": "subtitle", "time": 10882.309, "timestamp": "03:01:22", "text": "比如今天就会在Twitch上直播。昨天"}, {"type": "subtitle", "time": 10885.11, "timestamp": "03:01:25", "text": "曾在 YouTube 上直播过，那场直播将会是"}, {"type": "subtitle", "time": 10888.15, "timestamp": "03:01:28", "text": "至少持续5个小时左右。五"}, {"type": "subtitle", "time": 10891.67, "timestamp": "03:01:31", "text": "五小时或四小时。我简直就是个笨蛋"}, {"type": "subtitle", "time": 10894.71, "timestamp": "03:01:34", "text": "骑师，你不应该给自己太大压力。"}, {"type": "subtitle", "time": 10897.99, "timestamp": "03:01:37", "text": "但昨天我有点压力过大了。"}, {"type": "subtitle", "time": 10901.19, "timestamp": "03:01:41", "text": "所以当时我头疼什么的。"}, {"type": "subtitle", "time": 10904.389, "timestamp": "03:01:44", "text": "我不知道我当时是怎么开口说话的。"}, {"type": "subtitle", "time": 10906.87, "timestamp": "03:01:46", "text": "就像你知道的，做直播一样，但是"}, {"type": "subtitle", "time": 10909.269, "timestamp": "03:01:49", "text": "是的，我当时正遭受偏头痛的折磨。"}, {"type": "subtitle", "time": 10912.71, "timestamp": "03:01:52", "text": "我玩了一些东西，然后……呃……我的"}, {"type": "subtitle", "time": 10916.79, "timestamp": "03:01:56", "text": "头疼，不过，嗯，我们结束了。"}, {"type": "subtitle", "time": 10919.03, "timestamp": "03:01:59", "text": "溪流和"}]
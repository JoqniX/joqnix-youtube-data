[{"type": "subtitle", "time": 7323.91, "timestamp": "02:02:03", "text": "哦。哦，原来你在这儿啊。哦，它真可爱。"}, {"type": "subtitle", "time": 7329.35, "timestamp": "02:02:09", "text": "该死。好了。哦，你是橙色的。"}, {"type": "subtitle", "time": 7331.35, "timestamp": "02:02:11", "text": "是的。"}, {"type": "subtitle", "time": 7346.47, "timestamp": "02:02:26", "text": "你想去终点站吗？"}, {"type": "subtitle", "time": 7349.27, "timestamp": "02:02:29", "text": "哦耶，简直是人间炼狱。哦，是的"}, {"type": "subtitle", "time": 7353.99, "timestamp": "02:02:33", "text": "活力四射。巴特怎么了？"}, {"type": "subtitle", "time": 7357.35, "timestamp": "02:02:37", "text": "他说他得做点什么。你"}, {"type": "subtitle", "time": 7361.35, "timestamp": "02:02:41", "text": "大家玩了一会儿。他会回来的。"}, {"type": "subtitle", "time": 7364.47, "timestamp": "02:02:44", "text": "好的，我们来看看。感觉我要……"}, {"type": "subtitle", "time": 7367.43, "timestamp": "02:02:47", "text": "需要更多手榴弹。让我看看哪个"}, {"type": "subtitle", "time": 7374.07, "timestamp": "02:02:54", "text": "给我手榴弹。照明可以"}, {"type": "subtitle", "time": 7377.27, "timestamp": "02:02:57", "text": "我现在正在监视我的想法。"}]
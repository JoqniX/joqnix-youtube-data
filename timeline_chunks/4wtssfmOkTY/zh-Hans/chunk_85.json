[{"type": "subtitle", "time": 5100.47, "timestamp": "01:25:00", "text": "我想看看。"}, {"type": "subtitle", "time": 5107.83, "timestamp": "01:25:07", "text": "想象一下它就像你一样。那将是"}, {"type": "subtitle", "time": 5109.35, "timestamp": "01:25:09", "text": "有趣的。"}, {"type": "subtitle", "time": 5112.31, "timestamp": "01:25:12", "text": "那会是一个非常搞笑的视频片段。"}, {"type": "subtitle", "time": 5114.55, "timestamp": "01:25:14", "text": "确切地。"}, {"type": "subtitle", "time": 5118.629, "timestamp": "01:25:18", "text": "糟糕。哦，死了。那是什么？呃，"}, {"type": "subtitle", "time": 5121.03, "timestamp": "01:25:21", "text": "各位，我已经入土为安了。"}, {"type": "subtitle", "time": 5124.39, "timestamp": "01:25:24", "text": "我正在你身边加固阵地。谢谢。"}, {"type": "subtitle", "time": 5127.669, "timestamp": "01:25:27", "text": "糟糕。糟糕。"}, {"type": "subtitle", "time": 5130.149, "timestamp": "01:25:30", "text": "我看到了。我走进了那些"}, {"type": "subtitle", "time": 5136.39, "timestamp": "01:25:36", "text": "那东西在哪儿？我绝对不可能"}, {"type": "subtitle", "time": 5139.75, "timestamp": "01:25:39", "text": "就当这件事过去吧。"}, {"type": "subtitle", "time": 5141.669, "timestamp": "01:25:41", "text": "糟糕。"}, {"type": "subtitle", "time": 5144.229, "timestamp": "01:25:44", "text": "好了。他怎么还没死？"}, {"type": "subtitle", "time": 5149.43, "timestamp": "01:25:49", "text": "那？我的天哪，这太难了。"}, {"type": "subtitle", "time": 5157.91, "timestamp": "01:25:57", "text": "糟糕。重新加载。它出现在 Freddy SB 网站上。"}]
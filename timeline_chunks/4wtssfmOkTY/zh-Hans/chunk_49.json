[{"type": "subtitle", "time": 2941.19, "timestamp": "00:49:01", "text": "战略。但滚轮不是更好吗？"}, {"type": "subtitle", "time": 2945.19, "timestamp": "00:49:05", "text": "为了更快地输入？我表示怀疑。难道不是吗？"}, {"type": "subtitle", "time": 2947.91, "timestamp": "00:49:07", "text": "以前的元叙事？它会继续吗？"}, {"type": "subtitle", "time": 2950.71, "timestamp": "00:49:10", "text": "我的天啊。我其实不太确定。我 我"}, {"type": "subtitle", "time": 2952.39, "timestamp": "00:49:12", "text": "我不记得这件事了。但你可以试试。"}, {"type": "subtitle", "time": 2954.549, "timestamp": "00:49:14", "text": "等等，还有更多。有新的吗？"}, {"type": "subtitle", "time": 2958.15, "timestamp": "00:49:18", "text": "武器之类的东西？哦，武器。我猜"}, {"type": "subtitle", "time": 2962.79, "timestamp": "00:49:22", "text": "你错过了很多。什么？"}, {"type": "subtitle", "time": 2967.03, "timestamp": "00:49:27", "text": "杠杆式？杠杆式标记和"}, {"type": "subtitle", "time": 2974.79, "timestamp": "00:49:34", "text": "对，相信他。你会没事的。我是"}, {"type": "subtitle", "time": 2980.79, "timestamp": "00:49:40", "text": "你到底想打击什么？哦，不。不"}, {"type": "subtitle", "time": 2994.87, "timestamp": "00:49:54", "text": "倒下了。你穿着红色盔甲。什么？"}, {"type": "subtitle", "time": 2997.829, "timestamp": "00:49:57", "text": "嗯，是的。真理与力量。呃，战争面包。"}, {"type": "subtitle", "time": 2999.75, "timestamp": "00:49:59", "text": "额外的"}]
[{"type": "subtitle", "time": 7093.109, "timestamp": "01:58:13", "text": "什么？我带来了，我带来了爆发。"}, {"type": "subtitle", "time": 7095.589, "timestamp": "01:58:15", "text": "至于特别节目，我将要做"}, {"type": "subtitle", "time": 7097.14, "timestamp": "01:58:17", "text": "转折点。"}, {"type": "subtitle", "time": 7098.39, "timestamp": "01:58:18", "text": "[音乐]"}, {"type": "subtitle", "time": 7110.55, "timestamp": "01:58:30", "text": "顺便问一下，我们的目标是什么？"}, {"type": "subtitle", "time": 7115.03, "timestamp": "01:58:35", "text": "是那些虫子，对吧？让我们来看看。"}, {"type": "subtitle", "time": 7118.31, "timestamp": "01:58:38", "text": "哦，莎，你能主持一下吗？这样我们就可以展示了"}, {"type": "subtitle", "time": 7121.589, "timestamp": "01:58:41", "text": "什么是？哦，当然。"}, {"type": "subtitle", "time": 7123.43, "timestamp": "01:58:43", "text": "超级地狱跳水。大男孩地狱"}, {"type": "subtitle", "time": 7124.709, "timestamp": "01:58:44", "text": "潜水。我认为你的水平更高"}, {"type": "subtitle", "time": 7126.79, "timestamp": "01:58:46", "text": "比我强。"}, {"type": "subtitle", "time": 7128.629, "timestamp": "01:58:48", "text": "你是什​​么意思？我没有地狱"}, {"type": "subtitle", "time": 7133.35, "timestamp": "01:58:53", "text": "潜水。我没有超级地狱潜入。"}, {"type": "subtitle", "time": 7135.83, "timestamp": "01:58:55", "text": "我只有地狱潜行。"}]
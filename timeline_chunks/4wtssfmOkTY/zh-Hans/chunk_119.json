[{"type": "subtitle", "time": 7140.39, "timestamp": "01:59:00", "text": "那样我就能拥有它了。让我查一下。"}, {"type": "subtitle", "time": 7143.91, "timestamp": "01:59:03", "text": "你需要800。我也没有。"}, {"type": "subtitle", "time": 7145.669, "timestamp": "01:59:05", "text": "哦好的。没关系。好的，你是"}, {"type": "subtitle", "time": 7150.87, "timestamp": "01:59:10", "text": "主持人。我告诉你了。我忘了。"}, {"type": "subtitle", "time": 7154.149, "timestamp": "01:59:14", "text": "让我查一下。好的。"}, {"type": "subtitle", "time": 7155.75, "timestamp": "01:59:15", "text": "不，我不知道。慢慢来。查看"}, {"type": "subtitle", "time": 7162.149, "timestamp": "01:59:22", "text": "等等，我该怎么再次获得超级积分？"}, {"type": "subtitle", "time": 7167.11, "timestamp": "01:59:27", "text": "如果我再做一些骨头呢？"}, {"type": "subtitle", "time": 7168.31, "timestamp": "01:59:28", "text": "[音乐]"}, {"type": "subtitle", "time": 7170.39, "timestamp": "01:59:30", "text": "好的，约翰，有两种方法可以得到"}, {"type": "subtitle", "time": 7174.07, "timestamp": "01:59:34", "text": "超级积分。第一，你玩游戏"}, {"type": "subtitle", "time": 7176.87, "timestamp": "01:59:36", "text": "太多了。你可以获得超级积分，或者你"}, {"type": "subtitle", "time": 7179.589, "timestamp": "01:59:39", "text": "可以购买超级积分。哦，那里有一个"}, {"type": "subtitle", "time": 7183.35, "timestamp": "01:59:43", "text": "第三种方法。当然，"}, {"type": "subtitle", "time": 7186.229, "timestamp": "01:59:46", "text": "你可以花钱。哦，我可以超级"}, {"type": "subtitle", "time": 7188.709, "timestamp": "01:59:48", "text": "地狱潜入。"}, {"type": "subtitle", "time": 7191.75, "timestamp": "01:59:51", "text": "你看，我早就说过。我忘了。我当时想"}, {"type": "subtitle", "time": 7193.51, "timestamp": "01:59:53", "text": "等级上限已经过了，但显然你"}, {"type": "subtitle", "time": 7196.07, "timestamp": "01:59:56", "text": "必须在那个任务里扮演那个角色"}, {"type": "subtitle", "time": 7198.79, "timestamp": "01:59:58", "text": "解锁它。是的，我就是这么说的。"}]
[{"type": "subtitle", "time": 4141.749, "timestamp": "01:09:01", "text": "我们梦想的主人。等等，那是新的"}, {"type": "subtitle", "time": 4143.51, "timestamp": "01:09:03", "text": "岬。"}, {"type": "subtitle", "time": 4145.269, "timestamp": "01:09:05", "text": "嗯，是的。他们一直在发放新的"}, {"type": "subtitle", "time": 4147.189, "timestamp": "01:09:07", "text": "披风"}, {"type": "subtitle", "time": 4149.03, "timestamp": "01:09:09", "text": "就已发生的特定事件而言"}, {"type": "subtitle", "time": 4150.07, "timestamp": "01:09:10", "text": "贯穿整个游戏过程。我"}, {"type": "subtitle", "time": 4152.63, "timestamp": "01:09:12", "text": "我超喜欢这个颜色。"}, {"type": "subtitle", "time": 4161.269, "timestamp": "01:09:21", "text": "死的。"}, {"type": "subtitle", "time": 4165.51, "timestamp": "01:09:25", "text": "只有爪子。哦，我有了。"}, {"type": "subtitle", "time": 4167.91, "timestamp": "01:09:27", "text": "看看我能用上什么。如果你打算"}, {"type": "subtitle", "time": 4169.269, "timestamp": "01:09:29", "text": "机器人的话，我就直接用……"}, {"type": "subtitle", "time": 4175.829, "timestamp": "01:09:35", "text": "炸药"}, {"type": "subtitle", "time": 4177.43, "timestamp": "01:09:37", "text": "漏接。"}, {"type": "subtitle", "time": 4181.59, "timestamp": "01:09:41", "text": "《炸药》这部剧不太好。"}, {"type": "subtitle", "time": 4183.43, "timestamp": "01:09:43", "text": "在我看来。我更愿意坚持"}, {"type": "subtitle", "time": 4185.749, "timestamp": "01:09:45", "text": "用我的铝热剂。"}, {"type": "subtitle", "time": 4188.95, "timestamp": "01:09:48", "text": "但唯一好的地方是"}, {"type": "subtitle", "time": 4190.789, "timestamp": "01:09:50", "text": "炸药的优点在于可以控制引爆时间。所以"}, {"type": "subtitle", "time": 4193.51, "timestamp": "01:09:53", "text": "比如5秒、30秒，然后是60秒"}, {"type": "subtitle", "time": 4196.39, "timestamp": "01:09:56", "text": "秒。你是怎么得到它的？"}, {"type": "subtitle", "time": 4199.51, "timestamp": "01:09:59", "text": "哪个？白蚁。"}]
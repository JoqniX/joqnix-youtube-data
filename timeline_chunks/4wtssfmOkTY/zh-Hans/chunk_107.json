[{"type": "subtitle", "time": 6420.87, "timestamp": "01:47:00", "text": "相当多。那是否公正？"}, {"type": "subtitle", "time": 6424.709, "timestamp": "01:47:04", "text": "那只是份搬运工作吗？那就是……"}, {"type": "subtitle", "time": 6430.39, "timestamp": "01:47:10", "text": "是的，他死了。杰克，别担心。"}, {"type": "subtitle", "time": 6434.39, "timestamp": "01:47:14", "text": "你很安全。什么？"}, {"type": "subtitle", "time": 6438.39, "timestamp": "01:47:18", "text": "有个绿巨人在追赶。有"}, {"type": "subtitle", "time": 6440.229, "timestamp": "01:47:20", "text": "他狙击了那个。谢谢你"}, {"type": "subtitle", "time": 6444.31, "timestamp": "01:47:24", "text": "会员资格。但我们欢迎它。"}, {"type": "subtitle", "time": 6446.629, "timestamp": "01:47:26", "text": "哦，那是一辆坦克。"}, {"type": "subtitle", "time": 6449.91, "timestamp": "01:47:29", "text": "他们正在向我们投放坦克。所以，"}, {"type": "subtitle", "time": 6471.43, "timestamp": "01:47:51", "text": "谁干的？"}, {"type": "chat", "time": 6472.653, "timestamp": "01:47:52", "author": "@ArusuAraeru", "avatar": "https://yt4.ggpht.com/Dc2GWSBeOIoWoV_Yu1KJZ8Rd0EIvVX2NE8TZKOPigrbOXUH6MSPklyA0oUxTSJrKKkxsV3rdQA=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ-7tIYCO_9EPt-GMgAw"}, {"type": "subtitle", "time": 6474.629, "timestamp": "01:47:54", "text": "请求哨兵支援。"}]
[{"type": "subtitle", "time": 13921.189, "timestamp": "03:52:01", "text": "想让它更有意义"}, {"type": "subtitle", "time": 13924.469, "timestamp": "03:52:04", "text": "比如跟我法律相关的事"}, {"type": "subtitle", "time": 13927.67, "timestamp": "03:52:07", "text": "某种东西会告诉你一个故事"}, {"type": "subtitle", "time": 13929.83, "timestamp": "03:52:09", "text": "或者即使内容是……"}, {"type": "subtitle", "time": 13933.189, "timestamp": "03:52:13", "text": "我平时就玩游戏和做其他事。"}, {"type": "subtitle", "time": 13935.269, "timestamp": "03:52:15", "text": "那不仅仅是游戏，我不想限制它"}, {"type": "subtitle", "time": 13938.229, "timestamp": "03:52:18", "text": "我自己也喜欢玩游戏。不，我想做"}, {"type": "subtitle", "time": 13942.87, "timestamp": "03:52:22", "text": "真正的娱乐内容。所以，"}, {"type": "subtitle", "time": 13945.67, "timestamp": "03:52:25", "text": "是的，我确实有相关计划。但是"}, {"type": "subtitle", "time": 13947.75, "timestamp": "03:52:27", "text": "问题是"}, {"type": "subtitle", "time": 13949.67, "timestamp": "03:52:29", "text": "所有事情都由一个人做，就是这样。"}, {"type": "subtitle", "time": 13953.269, "timestamp": "03:52:33", "text": "不可能的。我知道。但是但是但是你"}, {"type": "subtitle", "time": 13956.309, "timestamp": "03:52:36", "text": "笨蛋我这个傻瓜不会为此生气"}, {"type": "subtitle", "time": 13959.189, "timestamp": "03:52:39", "text": "一个人不可能完成所有事情。我会的"}, {"type": "subtitle", "time": 13962.309, "timestamp": "03:52:42", "text": "我能做到一切，但我还是会尝试。"}, {"type": "subtitle", "time": 13964.87, "timestamp": "03:52:44", "text": "我尽力了。"}, {"type": "subtitle", "time": 13967.11, "timestamp": "03:52:47", "text": "我会修剪我的灌木丛。"}, {"type": "subtitle", "time": 13975.59, "timestamp": "03:52:55", "text": "你好。你好。所以，呃，我们需要输入这个。"}, {"type": "subtitle", "time": 13978.55, "timestamp": "03:52:58", "text": "我来把它打出来。所以，我……"}]
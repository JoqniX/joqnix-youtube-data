[{"type": "subtitle", "time": 5340.39, "timestamp": "01:29:00", "text": "想去挖矿。它制造机器人。"}, {"type": "subtitle", "time": 5342.31, "timestamp": "01:29:02", "text": "它不是那种你……的机器人。"}, {"type": "subtitle", "time": 5344.79, "timestamp": "01:29:04", "text": "思考。"}, {"type": "subtitle", "time": 5354.47, "timestamp": "01:29:14", "text": "糟糕。"}, {"type": "subtitle", "time": 5358.229, "timestamp": "01:29:18", "text": "只是延迟而已。"}, {"type": "subtitle", "time": 5361.189, "timestamp": "01:29:21", "text": "已摧毁。"}, {"type": "subtitle", "time": 5364.55, "timestamp": "01:29:24", "text": "对我来说真的那么糟糕吗？也许你应该"}, {"type": "subtitle", "time": 5367.43, "timestamp": "01:29:27", "text": "抓些地雷"}, {"type": "subtitle", "time": 5369.27, "timestamp": "01:29:29", "text": "四边形。"}, {"type": "subtitle", "time": 5372.31, "timestamp": "01:29:32", "text": "这是什么东西？哦，嘿，先生。"}, {"type": "subtitle", "time": 5374.79, "timestamp": "01:29:34", "text": "自动电池。顺便问一下，近战怎么操作？"}, {"type": "subtitle", "time": 5377.83, "timestamp": "01:29:37", "text": "呃，F"}, {"type": "subtitle", "time": 5383.11, "timestamp": "01:29:43", "text": "哇，这家伙居然因为我的话生气了。"}, {"type": "subtitle", "time": 5384.47, "timestamp": "01:29:44", "text": "他直接扔出去的那把武器"}]
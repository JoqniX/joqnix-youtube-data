[{"type": "subtitle", "time": 2824.55, "timestamp": "00:47:04", "text": "现在的银河系。下一个可能就是你。"}, {"type": "subtitle", "time": 2826.95, "timestamp": "00:47:06", "text": "除非你充分利用这一点。"}, {"type": "subtitle", "time": 2828.309, "timestamp": "00:47:08", "text": "重要的。等等，样本在哪儿？"}, {"type": "subtitle", "time": 2830.069, "timestamp": "00:47:10", "text": "去？等等，样品都去哪儿了？那"}, {"type": "subtitle", "time": 2831.91, "timestamp": "00:47:11", "text": "方向。"}, {"type": "subtitle", "time": 2835.75, "timestamp": "00:47:15", "text": "在地图上查看它们。"}, {"type": "subtitle", "time": 2837.91, "timestamp": "00:47:17", "text": "好的。那一瞬间我以为他们只是"}, {"type": "subtitle", "time": 2840.15, "timestamp": "00:47:20", "text": "消失了。"}, {"type": "subtitle", "time": 2843.91, "timestamp": "00:47:23", "text": "是的，他们可能溜进了"}, {"type": "subtitle", "time": 2846.71, "timestamp": "00:47:26", "text": "但愿我不会死。"}, {"type": "subtitle", "time": 2848.55, "timestamp": "00:47:28", "text": "哦，你会没事的。我相信你"}, {"type": "subtitle", "time": 2851.75, "timestamp": "00:47:31", "text": "能够……呃，活下去。感谢"}, {"type": "subtitle", "time": 2853.51, "timestamp": "00:47:33", "text": "你。虽然提取装置是"}, {"type": "subtitle", "time": 2855.829, "timestamp": "00:47:35", "text": "不会下来。"}, {"type": "subtitle", "time": 2857.99, "timestamp": "00:47:37", "text": "我不知道为什么我会想“等等，等等”，"}, {"type": "subtitle", "time": 2860.71, "timestamp": "00:47:40", "text": "达美乐披萨在哪里？啊，那或许是"}, {"type": "subtitle", "time": 2864.47, "timestamp": "00:47:44", "text": "漏洞。哦，好的。出故障了。耶！"}, {"type": "subtitle", "time": 2868.55, "timestamp": "00:47:48", "text": "好的。唉，真是的。真他妈的"}, {"type": "subtitle", "time": 2870.23, "timestamp": "00:47:50", "text": "我想我们得等计时器响了。"}, {"type": "subtitle", "time": 2874.23, "timestamp": "00:47:54", "text": "下去。计时器在哪儿？"}, {"type": "subtitle", "time": 2877.27, "timestamp": "00:47:57", "text": "等等，好的，我们有14"}, {"type": "subtitle", "time": 2879.75, "timestamp": "00:47:59", "text": "分钟。我的天啊。我们必须……我们有"}]
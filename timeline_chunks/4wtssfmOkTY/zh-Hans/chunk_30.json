[{"type": "subtitle", "time": 1810.07, "timestamp": "00:30:10", "text": "低，低，低。所有东西都很低，对吧？"}, {"type": "subtitle", "time": 1813.83, "timestamp": "00:30:13", "text": "而且所有东西都很低。"}, {"type": "subtitle", "time": 1816.23, "timestamp": "00:30:16", "text": "盛开。没有。景深。没有。"}, {"type": "subtitle", "time": 1822.389, "timestamp": "00:30:22", "text": "好的。"}, {"type": "subtitle", "time": 1825.35, "timestamp": "00:30:25", "text": "如何在X1上运行它？有人吗？"}, {"type": "subtitle", "time": 1836.149, "timestamp": "00:30:36", "text": "为什么渲染比例设置为超高？哦，来吧，我的"}, {"type": "subtitle", "time": 1844.31, "timestamp": "00:30:44", "text": "帧速率限制"}]
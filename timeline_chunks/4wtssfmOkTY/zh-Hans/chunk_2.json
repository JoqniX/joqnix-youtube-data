[{"type": "subtitle", "time": 120.31, "timestamp": "00:02:00", "text": "我不会这么晚到，也不会这么……"}, {"type": "subtitle", "time": 123.03, "timestamp": "00:02:03", "text": "迷茫或这么晚还遇到类似的事情"}, {"type": "subtitle", "time": 125.59, "timestamp": "00:02:05", "text": "这是因为我"}, {"type": "subtitle", "time": 127.429, "timestamp": "00:02:07", "text": "昨天我想我不记得了"}, {"type": "subtitle", "time": 130.63, "timestamp": "00:02:10", "text": "我睡觉的时间。"}, {"type": "subtitle", "time": 133.27, "timestamp": "00:02:13", "text": "是的，昨天我们一直工作到凌晨4点。"}, {"type": "subtitle", "time": 136.63, "timestamp": "00:02:16", "text": "凌晨三点，对吧？是的，就是这样。"}, {"type": "subtitle", "time": 140.55, "timestamp": "00:02:20", "text": "发生了什么。昨天与……的合作"}, {"type": "subtitle", "time": 143.589, "timestamp": "00:02:23", "text": "嗯，吉野山，我们在那里扮演了帕利亚。"}, {"type": "subtitle", "time": 146.55, "timestamp": "00:02:26", "text": "晚上8点我们一直工作到凌晨2点。"}, {"type": "subtitle", "time": 151.589, "timestamp": "00:02:31", "text": "某物。凌晨两三点？太疯狂了。"}, {"type": "subtitle", "time": 168.07, "timestamp": "00:02:48", "text": "我的天啊。我没有Vex PNG文件。哦"}, {"type": "subtitle", "time": 178.39, "timestamp": "00:02:58", "text": "我没有 Vec 的 PNG 文件。"}]
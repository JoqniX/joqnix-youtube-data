[{"type": "subtitle", "time": 2520.95, "timestamp": "00:42:00", "text": "这是什么？"}, {"type": "subtitle", "time": 2527.349, "timestamp": "00:42:07", "text": "[音乐]"}, {"type": "subtitle", "time": 2530.39, "timestamp": "00:42:10", "text": "哦，这很好。我的天哪，我太喜欢这个了"}, {"type": "subtitle", "time": 2533.03, "timestamp": "00:42:13", "text": "一。它有两种模式。它有一个"}, {"type": "subtitle", "time": 2534.309, "timestamp": "00:42:14", "text": "它有炮兵模式，而且具备微操功能。"}, {"type": "subtitle", "time": 2536.39, "timestamp": "00:42:16", "text": "导弹模式。"}, {"type": "subtitle", "time": 2538.95, "timestamp": "00:42:18", "text": "嗯，我用的是这把连发狙击枪"}, {"type": "subtitle", "time": 2542.47, "timestamp": "00:42:22", "text": "步枪。连发狙击步枪。这"}, {"type": "subtitle", "time": 2545.43, "timestamp": "00:42:25", "text": "等离子一。等离子的那个。哦，是的。"}, {"type": "subtitle", "time": 2547.91, "timestamp": "00:42:27", "text": "该死。它的弹药真的要用完了。"}, {"type": "subtitle", "time": 2548.87, "timestamp": "00:42:28", "text": "快的。"}, {"type": "subtitle", "time": 2552.15, "timestamp": "00:42:32", "text": "等等，那么多人做了什么？难道真的有那么多人吗？"}, {"type": "subtitle", "time": 2554.39, "timestamp": "00:42:34", "text": "有没有新的战争债券之类的东西？"}, {"type": "subtitle", "time": 2557.75, "timestamp": "00:42:37", "text": "自从有了弩箭那玩意儿？"}, {"type": "subtitle", "time": 2562.47, "timestamp": "00:42:42", "text": "哦，是的，很多。哦，很多。是的。"}, {"type": "subtitle", "time": 2565.589, "timestamp": "00:42:45", "text": "糟糕。哦，这是，这是，哦，我的"}, {"type": "subtitle", "time": 2567.99, "timestamp": "00:42:47", "text": "上帝。不用担心。我没有更多了"}, {"type": "subtitle", "time": 2569.75, "timestamp": "00:42:49", "text": "我没有其中大部分。所以即使"}, {"type": "subtitle", "time": 2571.27, "timestamp": "00:42:51", "text": "我玩了很多，但我还没有玩完大部分。"}, {"type": "subtitle", "time": 2573.19, "timestamp": "00:42:53", "text": "他们。我正在寻找这家工厂。"}, {"type": "subtitle", "time": 2575.349, "timestamp": "00:42:55", "text": "这里。我什么也没看到。工厂"}, {"type": "subtitle", "time": 2577.27, "timestamp": "00:42:57", "text": "边锋们都死了。我们只需要……哦，不。"}, {"type": "subtitle", "time": 2578.47, "timestamp": "00:42:58", "text": "不。你看，他指的是……"}]
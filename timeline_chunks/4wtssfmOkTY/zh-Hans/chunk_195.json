[{"type": "subtitle", "time": 11701.83, "timestamp": "03:15:01", "text": "是的。呃，我们今天要做什么？"}, {"type": "subtitle", "time": 11703.83, "timestamp": "03:15:03", "text": "让我们来看看。"}, {"type": "subtitle", "time": 11712.71, "timestamp": "03:15:12", "text": "今天我想，嗯，是的。我们写下"}, {"type": "subtitle", "time": 11720.07, "timestamp": "03:15:20", "text": "是的。"}, {"type": "subtitle", "time": 11722.95, "timestamp": "03:15:22", "text": "第一，我们编写错误报告。"}, {"type": "subtitle", "time": 11725.67, "timestamp": "03:15:25", "text": "二"}, {"type": "subtitle", "time": 11739.429, "timestamp": "03:15:39", "text": "呃，我们先写一份显而易见的报告。"}, {"type": "subtitle", "time": 11742.87, "timestamp": "03:15:42", "text": "两个呃"}, {"type": "subtitle", "time": 11745.91, "timestamp": "03:15:45", "text": "二、我们当时在想什么？"}, {"type": "subtitle", "time": 11749.75, "timestamp": "03:15:49", "text": "我们再次可以呃"}, {"type": "subtitle", "time": 11757.349, "timestamp": "03:15:57", "text": "然后我们唱歌。"}, {"type": "subtitle", "time": 11759.51, "timestamp": "03:15:59", "text": "然后"}]
[{"type": "subtitle", "time": 3060.23, "timestamp": "00:51:00", "text": "你是说？混乱。"}, {"type": "subtitle", "time": 3066.87, "timestamp": "00:51:06", "text": "老兄，这玩意儿太费弹药了。"}, {"type": "subtitle", "time": 3070.79, "timestamp": "00:51:10", "text": "简直疯了。最好的。这是什么？"}, {"type": "subtitle", "time": 3072.47, "timestamp": "00:51:12", "text": "事物？"}, {"type": "subtitle", "time": 3083.51, "timestamp": "00:51:23", "text": "哦，"}, {"type": "subtitle", "time": 3084.63, "timestamp": "00:51:24", "text": "E."}, {"type": "subtitle", "time": 3088.63, "timestamp": "00:51:28", "text": "你好。拥抱。给我一个拥抱。"}, {"type": "subtitle", "time": 3091.51, "timestamp": "00:51:31", "text": "哦，我到了。强制拥抱。过来。"}, {"type": "subtitle", "time": 3099.27, "timestamp": "00:51:39", "text": "反正你都会得到一个。"}, {"type": "subtitle", "time": 3102.23, "timestamp": "00:51:42", "text": "好吧，我忘了怎么拥抱了。哦，在那儿。"}, {"type": "subtitle", "time": 3104.069, "timestamp": "00:51:44", "text": "是。"}, {"type": "subtitle", "time": 3106.39, "timestamp": "00:51:46", "text": "好的，舒玛，给你你的……哦，等等。你"}, {"type": "subtitle", "time": 3108.79, "timestamp": "00:51:48", "text": "知道什么？我给你一个拥抱。三个拥抱。他"}, {"type": "subtitle", "time": 3110.95, "timestamp": "00:51:50", "text": "他会拥抱。我会拥抱你。过来，"}, {"type": "subtitle", "time": 3112.23, "timestamp": "00:51:52", "text": "维克。"}, {"type": "subtitle", "time": 3116.069, "timestamp": "00:51:56", "text": "好，你们可以抱抱。为什么不呢？"}, {"type": "subtitle", "time": 3117.75, "timestamp": "00:51:57", "text": "不幸的是，这个功能出了故障，所以我们"}]
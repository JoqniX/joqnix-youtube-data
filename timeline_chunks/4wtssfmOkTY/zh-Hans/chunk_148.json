[{"type": "subtitle", "time": 8887.11, "timestamp": "02:28:07", "text": "好的，我们以后有机会再玩一次吧。"}, {"type": "subtitle", "time": 8888.87, "timestamp": "02:28:08", "text": "贱人。"}, {"type": "subtitle", "time": 8890.79, "timestamp": "02:28:10", "text": "我玩这个游戏的时候卡顿非常严重。哦"}, {"type": "subtitle", "time": 8893.429, "timestamp": "02:28:13", "text": "是的，总有一天我们会"}, {"type": "subtitle", "time": 8900.63, "timestamp": "02:28:20", "text": "快点。虚弱的。"}, {"type": "subtitle", "time": 8905.11, "timestamp": "02:28:25", "text": "哦，等等。我不是。我正在设置"}, {"type": "subtitle", "time": 8909.51, "timestamp": "02:28:29", "text": "一名身披盔甲的骑士。是的，我是。那是"}, {"type": "subtitle", "time": 8913.99, "timestamp": "02:28:33", "text": "这就是我扛住所有回合的方法。国王"}, {"type": "subtitle", "time": 8915.67, "timestamp": "02:28:35", "text": "夜晚"}, {"type": "subtitle", "time": 8917.51, "timestamp": "02:28:37", "text": "包括"}, {"type": "subtitle", "time": 8919.19, "timestamp": "02:28:39", "text": "民主。"}]
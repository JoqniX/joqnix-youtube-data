[{"type": "subtitle", "time": 8652.23, "timestamp": "02:24:12", "text": "我只是在潜水而已。 RXR，欢迎"}, {"type": "subtitle", "time": 8656.95, "timestamp": "02:24:16", "text": "突袭行动的三次拍摄。嗯？"}, {"type": "subtitle", "time": 8658.95, "timestamp": "02:24:18", "text": "该死的，贱人。"}, {"type": "subtitle", "time": 8660.95, "timestamp": "02:24:20", "text": "我没能及时赶到。"}, {"type": "subtitle", "time": 8663.75, "timestamp": "02:24:23", "text": "这是地面。"}, {"type": "subtitle", "time": 8667.91, "timestamp": "02:24:27", "text": "是啊，谁在乎呢？很好。"}, {"type": "subtitle", "time": 8674.55, "timestamp": "02:24:34", "text": "他当时正在与……合作"}, {"type": "subtitle", "time": 8679.67, "timestamp": "02:24:39", "text": "我不知道你们在玩什么游戏。"}, {"type": "subtitle", "time": 8681.03, "timestamp": "02:24:41", "text": "我当时正在直播。我不明白"}, {"type": "subtitle", "time": 8684.15, "timestamp": "02:24:44", "text": "它在哪里。"}, {"type": "subtitle", "time": 8685.67, "timestamp": "02:24:45", "text": "他现在怎么样了？希望你一切顺利"}, {"type": "subtitle", "time": 8687.03, "timestamp": "02:24:47", "text": "休息。顺便说一句，他们还没有……"}, {"type": "subtitle", "time": 8689.89, "timestamp": "02:24:49", "text": "直播一段时间。找到东西了。"}, {"type": "subtitle", "time": 8694.95, "timestamp": "02:24:54", "text": "这次任务比我想象的要难。"}, {"type": "subtitle", "time": 8697.429, "timestamp": "02:24:57", "text": "说实话。我真的讨厌“不”，"}, {"type": "subtitle", "time": 8699.27, "timestamp": "02:24:59", "text": "问题是我们并不长。他们就这么走了"}]
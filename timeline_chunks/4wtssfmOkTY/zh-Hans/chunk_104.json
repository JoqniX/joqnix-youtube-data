[{"type": "subtitle", "time": 6241.83, "timestamp": "01:44:01", "text": "好的，我们开始吧，我们要去我们"}, {"type": "subtitle", "time": 6245.43, "timestamp": "01:44:05", "text": "可以进行提取。我们走吧。嘿，是"}, {"type": "subtitle", "time": 6247.189, "timestamp": "01:44:07", "text": "那份友谊呢？稍等片刻。"}, {"type": "subtitle", "time": 6248.31, "timestamp": "01:44:08", "text": "这就是友谊。友谊。"}, {"type": "subtitle", "time": 6251.27, "timestamp": "01:44:11", "text": "友谊。谁在我附近？这就是我。"}, {"type": "subtitle", "time": 6253.189, "timestamp": "01:44:13", "text": "哦，这是友谊。友谊。"}, {"type": "subtitle", "time": 6262.9, "timestamp": "01:44:22", "text": "他们是怎么向你射击的？"}, {"type": "subtitle", "time": 6275.75, "timestamp": "01:44:35", "text": "哦，一些要点。"}, {"type": "subtitle", "time": 6279.03, "timestamp": "01:44:39", "text": "超级积分。过来，伙计们。"}, {"type": "subtitle", "time": 6281.189, "timestamp": "01:44:41", "text": "我们得说，如果只有一个人需要"}, {"type": "subtitle", "time": 6283.27, "timestamp": "01:44:43", "text": "抓住它们，每个人都能得到。哦，我"}, {"type": "subtitle", "time": 6285.669, "timestamp": "01:44:45", "text": "忘了。嗯，没关系。我们前往"}, {"type": "subtitle", "time": 6288.239, "timestamp": "01:44:48", "text": "我们前往 各位，我遇到麻烦了。来保护你。"}, {"type": "subtitle", "time": 6297.59, "timestamp": "01:44:57", "text": "为什么？为什么？好的，明白了。出去。"}, {"type": "subtitle", "time": 6299.91, "timestamp": "01:44:59", "text": "我在水里。它就在最上面"}]
[{"type": "subtitle", "time": 6902.07, "timestamp": "01:55:02", "text": "你好。晚上好。"}, {"type": "subtitle", "time": 6904.39, "timestamp": "01:55:04", "text": "我觉得你们没生意可做。"}, {"type": "subtitle", "time": 6907.189, "timestamp": "01:55:07", "text": "稍等片刻。"}, {"type": "subtitle", "time": 6909.99, "timestamp": "01:55:09", "text": "这是我的"}, {"type": "subtitle", "time": 6912.87, "timestamp": "01:55:12", "text": "上帝。真的吗？"}, {"type": "subtitle", "time": 6923.83, "timestamp": "01:55:23", "text": "你想选择终止吗？让我们……"}, {"type": "subtitle", "time": 6929.51, "timestamp": "01:55:29", "text": "让我们展现这些恐怖景象。我知道"}, {"type": "subtitle", "time": 6933.109, "timestamp": "01:55:33", "text": "太可怕了。好的，"}, {"type": "subtitle", "time": 6936.629, "timestamp": "01:55:36", "text": "我们需要一位拥有超强地狱天赋的人。"}, {"type": "subtitle", "time": 6940.31, "timestamp": "01:55:40", "text": "你说的“我们”是什么意思？只有我一个人。"}, {"type": "subtitle", "time": 6944.47, "timestamp": "01:55:44", "text": "好的，舒马先生，你和呃……超级"}, {"type": "subtitle", "time": 6946.55, "timestamp": "01:55:46", "text": "地狱。哦，我的错。我当时正在和这个人说话。"}, {"type": "subtitle", "time": 6948.39, "timestamp": "01:55:48", "text": "一个女人说：“我们救了超级……”"}, {"type": "subtitle", "time": 6950.709, "timestamp": "01:55:50", "text": "地球。”"}, {"type": "subtitle", "time": 6952.709, "timestamp": "01:55:52", "text": "好吧，没事了。我当时就想，“哦，是啊，"}, {"type": "subtitle", "time": 6954.79, "timestamp": "01:55:54", "text": "这很合理，因为我并不超级地狱"}, {"type": "subtitle", "time": 6956.55, "timestamp": "01:55:56", "text": "潜水。”他让我想到我刚才说的"}, {"type": "subtitle", "time": 6958.629, "timestamp": "01:55:58", "text": "地狱潜入。"}]
[{"type": "subtitle", "time": 10981.51, "timestamp": "03:03:01", "text": "不停地说话"}, {"type": "subtitle", "time": 10985.19, "timestamp": "03:03:05", "text": "所以我能感受到人们的感受。"}, {"type": "subtitle", "time": 10988.15, "timestamp": "03:03:08", "text": "压力很大，所以才一直说个不停。"}, {"type": "subtitle", "time": 10991.91, "timestamp": "03:03:11", "text": "连续两三个小时，你"}, {"type": "subtitle", "time": 10995.83, "timestamp": "03:03:15", "text": "我知道那真的很痛苦"}, {"type": "subtitle", "time": 10998.63, "timestamp": "03:03:18", "text": "但是但是但是但是"}, {"type": "subtitle", "time": 11000.87, "timestamp": "03:03:20", "text": "我不知道，但我慢慢地……"}, {"type": "subtitle", "time": 11004.23, "timestamp": "03:03:24", "text": "逐渐习惯这一点"}, {"type": "subtitle", "time": 11006.469, "timestamp": "03:03:26", "text": "虽然这不正常，而且我的头……"}, {"type": "subtitle", "time": 11029.19, "timestamp": "03:03:49", "text": "我为你准备了温暖的头颅。我爸刚刚"}, {"type": "subtitle", "time": 11033.349, "timestamp": "03:03:53", "text": "走了进去。哇。"}, {"type": "subtitle", "time": 11036.46, "timestamp": "03:03:56", "text": "哇。小心。"}]
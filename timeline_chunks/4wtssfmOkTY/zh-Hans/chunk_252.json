[{"type": "subtitle", "time": 15130.389, "timestamp": "04:12:10", "text": "什么陛下？我不知道，我甚至都不知道"}, {"type": "subtitle", "time": 15134.55, "timestamp": "04:12:14", "text": "我自己知道我在做什么。我只是在做"}, {"type": "subtitle", "time": 15137.83, "timestamp": "04:12:17", "text": "比如一些东西。它叫什么？"}, {"type": "subtitle", "time": 15141.51, "timestamp": "04:12:21", "text": "就像弯曲膝盖，再伸直一样，"}, {"type": "subtitle", "time": 15145.91, "timestamp": "04:12:25", "text": "站着，就像试图倾斜和触摸"}, {"type": "subtitle", "time": 15150.15, "timestamp": "04:12:30", "text": "我的脖子。所有这些小事。我"}, {"type": "subtitle", "time": 15151.99, "timestamp": "04:12:31", "text": "不知道。"}, {"type": "subtitle", "time": 15156.309, "timestamp": "04:12:36", "text": "还有什么？更像是宠物一样的宠物"}, {"type": "subtitle", "time": 15164.79, "timestamp": "04:12:44", "text": "就像我必须一个一个地做一样"}, {"type": "subtitle", "time": 15167.91, "timestamp": "04:12:47", "text": "首先我得做颈部运动"}, {"type": "subtitle", "time": 15172.229, "timestamp": "04:12:52", "text": "然后做手臂练习"}, {"type": "subtitle", "time": 15175.429, "timestamp": "04:12:55", "text": "我不知道正确的做法是什么。"}, {"type": "subtitle", "time": 15179.189, "timestamp": "04:12:59", "text": "我不想这样做，我想知道正确的做法是什么。"}]
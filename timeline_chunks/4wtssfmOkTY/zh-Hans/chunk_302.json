[{"type": "subtitle", "time": 18121.59, "timestamp": "05:02:01", "text": "昨天是香蕉。今天是"}, {"type": "subtitle", "time": 18127.03, "timestamp": "05:02:07", "text": "牛奶。明天。我不知道。但"}, {"type": "subtitle", "time": 18138.708, "timestamp": "05:02:18", "text": "味道。太棒了。我的口味。我"}, {"type": "subtitle", "time": 18148.628, "timestamp": "05:02:28", "text": "我就像个助手，负责把牛奶喝完。"}, {"type": "subtitle", "time": 18159.59, "timestamp": "05:02:39", "text": "只剩最后一滴，只剩一个拉链了"}]
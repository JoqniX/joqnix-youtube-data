[{"type": "subtitle", "time": 9120.87, "timestamp": "02:32:00", "text": "嗯，那辆车。"}, {"type": "subtitle", "time": 9123.91, "timestamp": "02:32:03", "text": "我们走吧。"}, {"type": "subtitle", "time": 9138.309, "timestamp": "02:32:18", "text": "不过，今天确实挺开心的。"}, {"type": "subtitle", "time": 9141.349, "timestamp": "02:32:21", "text": "很喜欢。"}, {"type": "subtitle", "time": 9144.309, "timestamp": "02:32:24", "text": "很有趣。"}, {"type": "subtitle", "time": 9145.91, "timestamp": "02:32:25", "text": "是的。安装完游戏之后，对吧？"}, {"type": "subtitle", "time": 9148.07, "timestamp": "02:32:28", "text": "是的。明天要做的事情我得留着。"}, {"type": "subtitle", "time": 9149.429, "timestamp": "02:32:29", "text": "准备好了。我必须主动联系人们"}, {"type": "subtitle", "time": 9156.71, "timestamp": "02:32:36", "text": "H"}, {"type": "subtitle", "time": 9168.87, "timestamp": "02:32:48", "text": "好了，我要去睡一会儿了。"}, {"type": "subtitle", "time": 9172.15, "timestamp": "02:32:52", "text": "一会儿我就醒，凌晨一点。好的。"}]
[{"type": "subtitle", "time": 7441.51, "timestamp": "02:04:01", "text": "最近玩了民主蒸汽"}, {"type": "subtitle", "time": 7443.189, "timestamp": "02:04:03", "text": "相亲？哦，它没有蒸汽。"}, {"type": "subtitle", "time": 7446.07, "timestamp": "02:04:06", "text": "配对。好吧，我也看不见。我"}, {"type": "subtitle", "time": 7452.07, "timestamp": "02:04:12", "text": "我们选最近的那个吧，因为我们"}, {"type": "subtitle", "time": 7453.75, "timestamp": "02:04:13", "text": "宁愿把他们赶出去。"}, {"type": "subtitle", "time": 7458.709, "timestamp": "02:04:18", "text": "先做好计划。我的天啊。"}, {"type": "subtitle", "time": 7462.39, "timestamp": "02:04:22", "text": "你们是认真的吗？有0.02%"}, {"type": "subtitle", "time": 7468.95, "timestamp": "02:04:28", "text": "这里没有超级地狱跳水。"}, {"type": "subtitle", "time": 7471.75, "timestamp": "02:04:31", "text": "行星。"}, {"type": "subtitle", "time": 7473.99, "timestamp": "02:04:33", "text": "嘿，那里有一个。一切都糟透了。"}, {"type": "subtitle", "time": 7481.43, "timestamp": "02:04:41", "text": "我们走吧。"}, {"type": "subtitle", "time": 7485.51, "timestamp": "02:04:45", "text": "我们没有时间可以浪费。"}, {"type": "subtitle", "time": 7492.39, "timestamp": "02:04:52", "text": "让我查一下。就给你一个"}]
[{"type": "subtitle", "time": 3900.069, "timestamp": "01:05:00", "text": "困难。不，现在我们要进去了。"}, {"type": "subtitle", "time": 3904.15, "timestamp": "01:05:04", "text": "一。我们会很近。"}, {"type": "subtitle", "time": 3911.029, "timestamp": "01:05:11", "text": "我可以遇到最大难度。我可以"}, {"type": "subtitle", "time": 3914.39, "timestamp": "01:05:14", "text": "唉，我能去的极限也就只有地狱了。"}, {"type": "subtitle", "time": 3917.43, "timestamp": "01:05:17", "text": "潜水。就像不是超级地狱潜水一样。"}, {"type": "subtitle", "time": 3919.19, "timestamp": "01:05:19", "text": "啊，足够好了。这样可行。仍然"}, {"type": "subtitle", "time": 3926.63, "timestamp": "01:05:26", "text": "我的天啊，金钱经验值。"}, {"type": "subtitle", "time": 3928.71, "timestamp": "01:05:28", "text": "好吧，我差点就讲了个笑话……"}, {"type": "chat", "time": 3930.243, "timestamp": "01:05:30", "author": "@scaramouche611", "avatar": "https://yt4.ggpht.com/gpl17RW8KxrqN5kkedVdeH0DagiGDZKnYGlwnQwIQNNQjzeTxJdFzEouNPC3L1t1lj8jUAxv7Q4=s64-c-k-c0x00ffffff-no-rj", "message": "hello there JoqniX dude"}, {"type": "subtitle", "time": 3931.43, "timestamp": "01:05:31", "text": "不应该在直播中播放。你做了什么？"}, {"type": "subtitle", "time": 3934.71, "timestamp": "01:05:34", "text": "说？没有什么。聊天男，别说"}, {"type": "subtitle", "time": 3937.029, "timestamp": "01:05:37", "text": "直播中出现了一些冒犯性的内容。耶稣"}, {"type": "subtitle", "time": 3940.47, "timestamp": "01:05:40", "text": "基督。我的天啊。我想起了"}, {"type": "subtitle", "time": 3942.95, "timestamp": "01:05:42", "text": "有什么东西，我几乎立刻就……"}, {"type": "subtitle", "time": 3945.27, "timestamp": "01:05:45", "text": "已回复。科诺，欢迎。欢迎来到"}, {"type": "subtitle", "time": 3949.11, "timestamp": "01:05:49", "text": "溪流。不，不。是 Kono。"}, {"type": "subtitle", "time": 3951.349, "timestamp": "01:05:51", "text": "[音乐]"}, {"type": "subtitle", "time": 3953.349, "timestamp": "01:05:53", "text": "那是Husho吗？你好，老兄。怎么样？"}, {"type": "subtitle", "time": 3955.109, "timestamp": "01:05:55", "text": "去？"}, {"type": "subtitle", "time": 3958.87, "timestamp": "01:05:58", "text": "是的。是因为我喜欢只有我一个人的感觉吗？"}]
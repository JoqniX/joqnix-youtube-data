[{"type": "subtitle", "time": 14220.469, "timestamp": "03:57:00", "text": "提出你熟悉的事物的建议。"}, {"type": "subtitle", "time": 14223.03, "timestamp": "03:57:03", "text": "你好吗，笨蛋？"}, {"type": "subtitle", "time": 14226.21, "timestamp": "03:57:06", "text": "我的笨蛋今天过得怎么样？"}, {"type": "subtitle", "time": 14233.83, "timestamp": "03:57:13", "text": "今天这只鲹鱼过得怎么样？"}, {"type": "subtitle", "time": 14236.87, "timestamp": "03:57:16", "text": "希望你感觉舒适。舒适。"}, {"type": "subtitle", "time": 14239.189, "timestamp": "03:57:19", "text": "嗯。"}, {"type": "subtitle", "time": 14245.429, "timestamp": "03:57:25", "text": "我应该创建一个标签，写上“呃，这个”。"}, {"type": "subtitle", "time": 14248.389, "timestamp": "03:57:28", "text": "建议重新……"}, {"type": "subtitle", "time": 14253.269, "timestamp": "03:57:33", "text": "聊天建议"}, {"type": "subtitle", "time": 14256.229, "timestamp": "03:57:36", "text": "聊天"}, {"type": "subtitle", "time": 14258.79, "timestamp": "03:57:38", "text": "我应该把那东西提一下"}, {"type": "subtitle", "time": 14262.55, "timestamp": "03:57:42", "text": "聊天工具建议我这么做，这样我就可以"}, {"type": "subtitle", "time": 14266.07, "timestamp": "03:57:46", "text": "我知道这是你们的建议，所以"}, {"type": "subtitle", "time": 14268.469, "timestamp": "03:57:48", "text": "我不会忘记"}, {"type": "subtitle", "time": 14276.71, "timestamp": "03:57:56", "text": "我很好。我设法弄到了一些"}, {"type": "subtitle", "time": 14279.59, "timestamp": "03:57:59", "text": "好好睡一觉吧。你好吗？我也是。我"}]
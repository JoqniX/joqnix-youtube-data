[{"type": "subtitle", "time": 11880.79, "timestamp": "03:18:00", "text": "你好。好的。"}, {"type": "subtitle", "time": 11883.03, "timestamp": "03:18:03", "text": "所以，就像有多少季一样"}, {"type": "subtitle", "time": 11887.83, "timestamp": "03:18:07", "text": "再次？三个季度？三四个。"}, {"type": "subtitle", "time": 11890.95, "timestamp": "03:18:10", "text": "所以，一共三个部分，对吧？"}, {"type": "subtitle", "time": 11893.83, "timestamp": "03:18:13", "text": "三四个。"}, {"type": "subtitle", "time": 11897.11, "timestamp": "03:18:17", "text": "我的毛线笨蛋"}, {"type": "subtitle", "time": 11901.11, "timestamp": "03:18:21", "text": "百托姆。是的。你好。巴卡怎么样？"}, {"type": "subtitle", "time": 11902.6, "timestamp": "03:18:22", "text": "今天做什么？"}, {"type": "subtitle", "time": 11903.75, "timestamp": "03:18:23", "text": "[音乐]"}, {"type": "subtitle", "time": 11907.75, "timestamp": "03:18:27", "text": "莫，你好吗，巴卡？"}, {"type": "subtitle", "time": 11915.33, "timestamp": "03:18:35", "text": "你好，早上好。"}, {"type": "subtitle", "time": 11916.79, "timestamp": "03:18:36", "text": "[音乐]"}, {"type": "subtitle", "time": 11924.79, "timestamp": "03:18:44", "text": "是的，"}, {"type": "subtitle", "time": 11926.71, "timestamp": "03:18:46", "text": "我觉得更多。是的，我觉得有。"}, {"type": "subtitle", "time": 11930.79, "timestamp": "03:18:50", "text": "更多的。笨蛋在吃米饭。"}, {"type": "subtitle", "time": 11934.95, "timestamp": "03:18:54", "text": "是的。好的。好的。"}, {"type": "subtitle", "time": 11936.47, "timestamp": "03:18:56", "text": "马阿什。"}]
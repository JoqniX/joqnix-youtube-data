[{"type": "subtitle", "time": 14403.83, "timestamp": "04:00:03", "text": "韦恩·A"}, {"type": "subtitle", "time": 14407.96, "timestamp": "04:00:07", "text": "说得很清楚，没错。"}, {"type": "subtitle", "time": 14410.79, "timestamp": "04:00:10", "text": "[音乐]"}, {"type": "subtitle", "time": 14413.83, "timestamp": "04:00:13", "text": "我玩僵尸模式还不错。"}, {"type": "subtitle", "time": 14416.389, "timestamp": "04:00:16", "text": "扮演僵尸。嗨，希望你玩得开心"}, {"type": "subtitle", "time": 14421.11, "timestamp": "04:00:21", "text": "你在萨克山的游戏。我喜欢享受"}, {"type": "subtitle", "time": 14424.71, "timestamp": "04:00:24", "text": "温暖的头部。巴卡"}]
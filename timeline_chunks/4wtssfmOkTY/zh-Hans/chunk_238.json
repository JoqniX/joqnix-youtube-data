[{"type": "subtitle", "time": 14281.67, "timestamp": "03:58:01", "text": "睡得很好。昨天，我……"}, {"type": "subtitle", "time": 14284.15, "timestamp": "03:58:04", "text": "看视频后头疼。"}, {"type": "subtitle", "time": 14288.469, "timestamp": "03:58:08", "text": "所以，我休息了一会儿。"}, {"type": "subtitle", "time": 14291.91, "timestamp": "03:58:11", "text": "早上醒来。伙计，我正在这么做。"}, {"type": "subtitle", "time": 14295.429, "timestamp": "03:58:15", "text": "出色地。是的，我一切都很好。而我是"}, {"type": "subtitle", "time": 14301.349, "timestamp": "03:58:21", "text": "你好"}, {"type": "subtitle", "time": 14305.429, "timestamp": "03:58:25", "text": "儿子。今天这只鲹鱼过得怎么样？怎样"}, {"type": "subtitle", "time": 14319.91, "timestamp": "03:58:39", "text": "哦，等等。我们没有做练习。"}, {"type": "subtitle", "time": 14324.309, "timestamp": "03:58:44", "text": "正确的？现在是上午9点25分。那么，我们进去等一下吧。"}, {"type": "subtitle", "time": 14326.309, "timestamp": "03:58:46", "text": "5分钟。好的，在那之前，我们……"}, {"type": "subtitle", "time": 14328.87, "timestamp": "03:58:48", "text": "把这些事情做完。"}, {"type": "subtitle", "time": 14331.269, "timestamp": "03:58:51", "text": "所以，嗯，"}, {"type": "subtitle", "time": 14334.15, "timestamp": "03:58:54", "text": "让我们来看看。"}, {"type": "subtitle", "time": 14336.71, "timestamp": "03:58:56", "text": "新版直播流布局。我完成了。"}, {"type": "subtitle", "time": 14338.63, "timestamp": "03:58:58", "text": "新版直播流布局。是的，我完成了。"}]
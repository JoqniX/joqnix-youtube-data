[{"type": "subtitle", "time": 7803.189, "timestamp": "02:10:03", "text": "因为阴影"}, {"type": "subtitle", "time": 7807.43, "timestamp": "02:10:07", "text": "你的目标是伸张正义。圣"}, {"type": "subtitle", "time": 7828.149, "timestamp": "02:10:28", "text": "各位，别担心。我得好好骂他一顿。我"}, {"type": "subtitle", "time": 7830.79, "timestamp": "02:10:30", "text": "见两个。"}, {"type": "subtitle", "time": 7847.109, "timestamp": "02:10:47", "text": "你们看到火了吗？不用担心。但只是"}, {"type": "subtitle", "time": 7851.27, "timestamp": "02:10:51", "text": "左下、左上。"}]
[{"type": "subtitle", "time": 16624.629, "timestamp": "04:37:04", "text": "我醒来时心想：“哦，酷。怎么样？”"}, {"type": "subtitle", "time": 16627.67, "timestamp": "04:37:07", "text": "今天在干什么？"}, {"type": "subtitle", "time": 16629.349, "timestamp": "04:37:09", "text": "你好。"}, {"type": "subtitle", "time": 16638.47, "timestamp": "04:37:18", "text": "好了，我们走吧。嗯，我们来做一次吧。"}, {"type": "subtitle", "time": 16645.1, "timestamp": "04:37:25", "text": "一二三。"}, {"type": "subtitle", "time": 16647.59, "timestamp": "04:37:27", "text": "[音乐]"}, {"type": "subtitle", "time": 16657.029, "timestamp": "04:37:37", "text": "想象"}]
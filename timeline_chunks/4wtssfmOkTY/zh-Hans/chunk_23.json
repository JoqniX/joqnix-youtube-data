[{"type": "subtitle", "time": 1380.149, "timestamp": "00:23:00", "text": "大家好。温暖的"}, {"type": "subtitle", "time": 1382.31, "timestamp": "00:23:02", "text": "大家好。希望大家都很开心"}, {"type": "subtitle", "time": 1384.149, "timestamp": "00:23:04", "text": "一切顺利。"}, {"type": "subtitle", "time": 1387.43, "timestamp": "00:23:07", "text": "呃，所以我想做这个直播……"}, {"type": "subtitle", "time": 1389.19, "timestamp": "00:23:09", "text": "宣布几件事并给出"}, {"type": "subtitle", "time": 1394.47, "timestamp": "00:23:14", "text": "更新。所以，呃，如果你正在收听……"}, {"type": "subtitle", "time": 1396.549, "timestamp": "00:23:16", "text": "感谢你远道而来"}, {"type": "subtitle", "time": 1399.909, "timestamp": "00:23:19", "text": "很高兴能听到这些。"}, {"type": "subtitle", "time": 1403.59, "timestamp": "00:23:23", "text": "公告。这对我意义重大。所以"}, {"type": "subtitle", "time": 1405.909, "timestamp": "00:23:25", "text": "呃，我不会……这个公告不会……"}, {"type": "subtitle", "time": 1409.43, "timestamp": "00:23:29", "text": "太大了。希望我不会这么做。"}, {"type": "subtitle", "time": 1415.51, "timestamp": "00:23:35", "text": "它太大了，呃，我说话的时候……但是"}, {"type": "subtitle", "time": 1417.75, "timestamp": "00:23:37", "text": "是的"}, {"type": "subtitle", "time": 1420.549, "timestamp": "00:23:40", "text": "所以，呃，我也不会尝试，我会是"}, {"type": "subtitle", "time": 1423.35, "timestamp": "00:23:43", "text": "虽然会看聊天记录，但我会尽量不看。"}, {"type": "subtitle", "time": 1426.23, "timestamp": "00:23:46", "text": "呃，插几句话，然后读出来。"}, {"type": "subtitle", "time": 1429.19, "timestamp": "00:23:49", "text": "大声点，因为呃，我想要这个，我想要这个"}, {"type": "subtitle", "time": 1431.99, "timestamp": "00:23:51", "text": "公告将以视频形式发布。"}, {"type": "subtitle", "time": 1434.63, "timestamp": "00:23:54", "text": "格式，但是是的"}, {"type": "subtitle", "time": 1438.149, "timestamp": "00:23:58", "text": "首先，嗯，一直以来都是这样"}]
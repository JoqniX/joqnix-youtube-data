[{"type": "subtitle", "time": 2701.589, "timestamp": "00:45:01", "text": "X1.哦，"}, {"type": "subtitle", "time": 2703.349, "timestamp": "00:45:03", "text": "好的。我觉得我错过了脸部特写。"}, {"type": "subtitle", "time": 2707.349, "timestamp": "00:45:07", "text": "并活了下来。我亲眼见过那块黄油。"}, {"type": "subtitle", "time": 2710.39, "timestamp": "00:45:10", "text": "是的。勉强活了下来。"}, {"type": "subtitle", "time": 2712.87, "timestamp": "00:45:12", "text": "我活着。"}, {"type": "subtitle", "time": 2715.91, "timestamp": "00:45:15", "text": "我迈着大步走了好几步"}, {"type": "subtitle", "time": 2718.55, "timestamp": "00:45:18", "text": "罢工期间，人们依然生活着。我死于"}, {"type": "subtitle", "time": 2720.15, "timestamp": "00:45:20", "text": "影响。"}, {"type": "subtitle", "time": 2722.55, "timestamp": "00:45:22", "text": "你穿的是重甲吧？是的，"}, {"type": "subtitle", "time": 2724.63, "timestamp": "00:45:24", "text": "重的。这就是我为什么输这么多比赛的原因。"}, {"type": "subtitle", "time": 2726.71, "timestamp": "00:45:26", "text": "镜头。是的，那救了你的命"}, {"type": "subtitle", "time": 2730.15, "timestamp": "00:45:30", "text": "多次发生。"}, {"type": "subtitle", "time": 2733.19, "timestamp": "00:45:33", "text": "我的天啊。那东西在哪儿？"}, {"type": "subtitle", "time": 2736.15, "timestamp": "00:45:36", "text": "好了，我想我现在可以加入他了。哦，"}, {"type": "subtitle", "time": 2740.71, "timestamp": "00:45:40", "text": "我们走吧。耶！人越多越好。是的。"}, {"type": "subtitle", "time": 2744.069, "timestamp": "00:45:44", "text": "民主。砰砰。我来了"}, {"type": "subtitle", "time": 2746.39, "timestamp": "00:45:46", "text": "为了民主。"}, {"type": "subtitle", "time": 2748.63, "timestamp": "00:45:48", "text": "自由。"}, {"type": "subtitle", "time": 2750.63, "timestamp": "00:45:50", "text": "为了"}, {"type": "subtitle", "time": 2752.87, "timestamp": "00:45:52", "text": "有没有什么新的梗图之类的？"}, {"type": "subtitle", "time": 2754.71, "timestamp": "00:45:54", "text": "地狱有多样性吗？我认为应该有"}, {"type": "subtitle", "time": 2757.589, "timestamp": "00:45:57", "text": "自第三派系以来，情况就更糟了。我"}]
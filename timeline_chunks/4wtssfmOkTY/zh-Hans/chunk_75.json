[{"type": "subtitle", "time": 4506.31, "timestamp": "01:15:06", "text": "他把它戴在侧面了吗？在"}, {"type": "subtitle", "time": 4509.83, "timestamp": "01:15:09", "text": "简直是毁灭性的。你，有趣的事"}, {"type": "subtitle", "time": 4513.91, "timestamp": "01:15:13", "text": "是给这家伙的哦，我们总是穿"}, {"type": "subtitle", "time": 4516.31, "timestamp": "01:15:16", "text": "把它放在一边。瞧，就是这个。"}, {"type": "subtitle", "time": 4518.79, "timestamp": "01:15:18", "text": "简直就像"}, {"type": "subtitle", "time": 4520.47, "timestamp": "01:15:20", "text": "我本来想说埃蒙·加兰德，然后我"}, {"type": "subtitle", "time": 4526.47, "timestamp": "01:15:26", "text": "不，不是。这是一支栓动式步枪。这是一个"}, {"type": "subtitle", "time": 4528.39, "timestamp": "01:15:28", "text": "栓动式。是的，它是栓动式步枪。"}, {"type": "subtitle", "time": 4530.39, "timestamp": "01:15:30", "text": "哦，什么是栓动式步枪？埃蒙·加兰德"}, {"type": "subtitle", "time": 4533.59, "timestamp": "01:15:33", "text": "它类似于燃气驱动，但这是螺栓驱动的。"}, {"type": "subtitle", "time": 4535.35, "timestamp": "01:15:35", "text": "行动。宪法。这颗螺栓"}, {"type": "subtitle", "time": 4536.95, "timestamp": "01:15:36", "text": "行动。"}, {"type": "subtitle", "time": 4538.31, "timestamp": "01:15:38", "text": "它有一声提示音。所以我刚才打电话了"}, {"type": "subtitle", "time": 4540.95, "timestamp": "01:15:40", "text": "M1 Gar M1 Gar。有提示音"}, {"type": "subtitle", "time": 4542.95, "timestamp": "01:15:42", "text": "当你弹药耗尽时，就用它。是的，"}, {"type": "subtitle", "time": 4545.35, "timestamp": "01:15:45", "text": "因为它使用了夹子。"}, {"type": "subtitle", "time": 4547.43, "timestamp": "01:15:47", "text": "是的。所以我直接给M1盖伦打了个电话。我"}, {"type": "subtitle", "time": 4549.35, "timestamp": "01:15:49", "text": "别把它叫做宪法。"}, {"type": "subtitle", "time": 4551.59, "timestamp": "01:15:51", "text": "任何称其为M1加兰德步枪的人都喜欢"}, {"type": "subtitle", "time": 4554.55, "timestamp": "01:15:54", "text": "这是一支伏特步枪。你可以"}, {"type": "subtitle", "time": 4557.51, "timestamp": "01:15:57", "text": "没关系。"}]
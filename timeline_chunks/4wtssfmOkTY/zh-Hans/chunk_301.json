[{"type": "subtitle", "time": 18060.39, "timestamp": "05:01:00", "text": "当你……有时候当你喝酒"}, {"type": "subtitle", "time": 18063.99, "timestamp": "05:01:03", "text": "吃点好吃的"}, {"type": "subtitle", "time": 18067.11, "timestamp": "05:01:07", "text": "你感觉自己想变成一个小小的"}, {"type": "subtitle", "time": 18069.11, "timestamp": "05:01:09", "text": "小蚂蚁，"}, {"type": "subtitle", "time": 18072.47, "timestamp": "05:01:12", "text": "不是你想成为的那种蚂蚁"}, {"type": "subtitle", "time": 18075.75, "timestamp": "05:01:15", "text": "在充满那种感觉的天堂里安睡"}, {"type": "subtitle", "time": 18078.948, "timestamp": "05:01:18", "text": "特别的甜味。"}, {"type": "subtitle", "time": 18081.75, "timestamp": "05:01:21", "text": "你不觉得就像我吃东西的时候一样吗？"}, {"type": "subtitle", "time": 18086.07, "timestamp": "05:01:26", "text": "美味的香蕉，我感觉就像，是的，我想……"}, {"type": "subtitle", "time": 18088.55, "timestamp": "05:01:28", "text": "想永远吃这个"}, {"type": "subtitle", "time": 18091.75, "timestamp": "05:01:31", "text": "或者如果我喝牛奶的时候加了这种牛奶"}, {"type": "subtitle", "time": 18093.75, "timestamp": "05:01:33", "text": "这款香草味的牛奶，我感觉就像……"}, {"type": "subtitle", "time": 18095.91, "timestamp": "05:01:35", "text": "想永远喝这个，因为它"}, {"type": "subtitle", "time": 18098.47, "timestamp": "05:01:38", "text": "可口。我想继续消费"}, {"type": "subtitle", "time": 18100.948, "timestamp": "05:01:40", "text": "甜味，我想看看是什么"}, {"type": "subtitle", "time": 18102.47, "timestamp": "05:01:42", "text": "味道"}, {"type": "subtitle", "time": 18105.91, "timestamp": "05:01:45", "text": "越来越多，无穷无尽，但我做不到"}, {"type": "subtitle", "time": 18109.59, "timestamp": "05:01:49", "text": "这杯酒快喝完后，"}, {"type": "subtitle", "time": 18111.43, "timestamp": "05:01:51", "text": "精加工"}, {"type": "subtitle", "time": 18115.51, "timestamp": "05:01:55", "text": "更多的。我还想要更多。"}, {"type": "subtitle", "time": 18119.51, "timestamp": "05:01:59", "text": "我不知道。这就是我的感受。"}]
[{"type": "subtitle", "time": 10801.349, "timestamp": "03:00:01", "text": "虽然是我的第一个朋友。你愿意做我的"}, {"type": "subtitle", "time": 10804.23, "timestamp": "03:00:04", "text": "朋友？你已经看到了我的观点。他妈的"}, {"type": "subtitle", "time": 10816.79, "timestamp": "03:00:16", "text": "不过我的朋友。"}, {"type": "subtitle", "time": 10838.87, "timestamp": "03:00:38", "text": "我想有一天去旅行。"}, {"type": "subtitle", "time": 10847.03, "timestamp": "03:00:47", "text": "看到了很多城市和人"}, {"type": "subtitle", "time": 10855.59, "timestamp": "03:00:55", "text": "我拥有生活的乐趣，并且很享受这一切。"}, {"type": "subtitle", "time": 10858.469, "timestamp": "03:00:58", "text": "很多。"}]
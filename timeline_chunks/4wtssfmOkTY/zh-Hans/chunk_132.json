[{"type": "subtitle", "time": 7920.79, "timestamp": "02:12:00", "text": "我的天哪。"}, {"type": "subtitle", "time": 7923.589, "timestamp": "02:12:03", "text": "我认为"}, {"type": "subtitle", "time": 7926.79, "timestamp": "02:12:06", "text": "我觉得他就是这样。"}, {"type": "subtitle", "time": 7945.91, "timestamp": "02:12:25", "text": "得到正式认可的。增援部队已经抵达"}, {"type": "subtitle", "time": 7955.27, "timestamp": "02:12:35", "text": "好的，我看到了一只母鸡。哦，我得到了"}, {"type": "subtitle", "time": 7965.83, "timestamp": "02:12:45", "text": "生活。别死，兄弟。"}, {"type": "subtitle", "time": 7968.79, "timestamp": "02:12:48", "text": "没关系。你一定可以的。和右"}, {"type": "subtitle", "time": 7970.55, "timestamp": "02:12:50", "text": "笔记本电脑"}]
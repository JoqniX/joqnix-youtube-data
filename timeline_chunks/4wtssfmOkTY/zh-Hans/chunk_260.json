[{"type": "subtitle", "time": 15602.71, "timestamp": "04:20:02", "text": "欢迎。欢迎。笨蛋。"}, {"type": "subtitle", "time": 15604.79, "timestamp": "04:20:04", "text": "[音乐]"}, {"type": "subtitle", "time": 15608.71, "timestamp": "04:20:08", "text": "因为我醒来后感觉精力充沛，活力四射。"}, {"type": "subtitle", "time": 15611.349, "timestamp": "04:20:11", "text": "所以我就想，“是啊，我可以直播。”"}, {"type": "subtitle", "time": 15619.11, "timestamp": "04:20:19", "text": "不用担心。我没有强迫你。"}, {"type": "subtitle", "time": 15622.55, "timestamp": "04:20:22", "text": "伸展一下，就像你知道的那样"}, {"type": "subtitle", "time": 15625.03, "timestamp": "04:20:25", "text": "呃，拉伸让我自己压力很大。不"}, {"type": "subtitle", "time": 15628.469, "timestamp": "04:20:28", "text": "像个傻瓜一样。"}, {"type": "subtitle", "time": 15632.229, "timestamp": "04:20:32", "text": "今天“笨蛋”标志牌的情况如何？不。"}, {"type": "subtitle", "time": 15646.97, "timestamp": "04:20:46", "text": "是的。"}, {"type": "subtitle", "time": 15650.389, "timestamp": "04:20:50", "text": "[音乐]"}, {"type": "subtitle", "time": 15656.07, "timestamp": "04:20:56", "text": "你好。你好。所以，我现在刚回来。所以"}]
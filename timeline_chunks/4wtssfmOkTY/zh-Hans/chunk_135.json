[{"type": "subtitle", "time": 8110.629, "timestamp": "02:15:10", "text": "该死的。等待。"}, {"type": "subtitle", "time": 8119.43, "timestamp": "02:15:19", "text": "里面有一个酸性充电器。"}, {"type": "subtitle", "time": 8122.149, "timestamp": "02:15:22", "text": "我可以应付母亲们"}, {"type": "subtitle", "time": 8123.99, "timestamp": "02:15:23", "text": "以及这些"}, {"type": "subtitle", "time": 8125.91, "timestamp": "02:15:25", "text": "事物。"}, {"type": "subtitle", "time": 8127.51, "timestamp": "02:15:27", "text": "这些人，但还有另一个。哦，"}, {"type": "subtitle", "time": 8134.229, "timestamp": "02:15:34", "text": "[音乐]"}, {"type": "subtitle", "time": 8136.87, "timestamp": "02:15:36", "text": "有多少项指控？像三个"}, {"type": "subtitle", "time": 8139.189, "timestamp": "02:15:39", "text": "他们中的。其中三个。其中两个是"}, {"type": "subtitle", "time": 8140.79, "timestamp": "02:15:40", "text": "酸性的。"}, {"type": "subtitle", "time": 8142.95, "timestamp": "02:15:42", "text": "哦，是的。而且几乎没有汽油"}, {"type": "subtitle", "time": 8144.87, "timestamp": "02:15:44", "text": "到处。太生硬了。你可能想"}, {"type": "subtitle", "time": 8147.669, "timestamp": "02:15:47", "text": "快离开那里。"}, {"type": "subtitle", "time": 8150.31, "timestamp": "02:15:50", "text": "哦。"}, {"type": "subtitle", "time": 8152.79, "timestamp": "02:15:52", "text": "我的天啊。"}, {"type": "subtitle", "time": 8156.39, "timestamp": "02:15:56", "text": "嘿，哥们儿，最近怎么样？"}, {"type": "subtitle", "time": 8159.27, "timestamp": "02:15:59", "text": "这东西简直是钻进去的。"}]
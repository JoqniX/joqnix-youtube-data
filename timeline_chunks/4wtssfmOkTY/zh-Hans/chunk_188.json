[{"type": "subtitle", "time": 11281.67, "timestamp": "03:08:01", "text": "你呢？ H Dev，你如何选择哪个"}, {"type": "subtitle", "time": 11284.07, "timestamp": "03:08:04", "text": "最近在追什么动漫？"}, {"type": "subtitle", "time": 11294.309, "timestamp": "03:08:14", "text": "老生常谈的问题。哦，你好。哦，帕利。"}, {"type": "subtitle", "time": 11298.23, "timestamp": "03:08:18", "text": "是啊，你好，帕尔莫。我想你了，笨蛋。"}, {"type": "subtitle", "time": 11301.51, "timestamp": "03:08:21", "text": "是昨天的事了。我当时……呃……我可以……你"}, {"type": "subtitle", "time": 11304.71, "timestamp": "03:08:24", "text": "我们当时在聊天室里，对吧？"}, {"type": "subtitle", "time": 11307.75, "timestamp": "03:08:27", "text": "你……我还以为你睡着了呢"}, {"type": "subtitle", "time": 11309.59, "timestamp": "03:08:29", "text": "或者有一些东西。这就是你"}, {"type": "subtitle", "time": 11312.63, "timestamp": "03:08:32", "text": "不行，所以你才无法加入。"}, {"type": "subtitle", "time": 11316.389, "timestamp": "03:08:36", "text": "进去。但是，但是还是笨蛋，下次吧。"}, {"type": "subtitle", "time": 11318.79, "timestamp": "03:08:38", "text": "我们一起玩吧"}, {"type": "subtitle", "time": 11321.03, "timestamp": "03:08:41", "text": "八。"}, {"type": "subtitle", "time": 11323.19, "timestamp": "03:08:43", "text": "嗯。"}, {"type": "subtitle", "time": 11325.19, "timestamp": "03:08:45", "text": "是的。"}, {"type": "subtitle", "time": 11332.469, "timestamp": "03:08:52", "text": "你好。你好。"}, {"type": "subtitle", "time": 11335.01, "timestamp": "03:08:55", "text": "所以笨蛋笨蛋。"}]
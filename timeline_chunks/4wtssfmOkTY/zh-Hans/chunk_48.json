[{"type": "subtitle", "time": 2881.99, "timestamp": "00:48:01", "text": "玩这个游戏14分钟。我们开始吧"}, {"type": "subtitle", "time": 2884.15, "timestamp": "00:48:04", "text": "去。没关系。任务卡住了"}, {"type": "subtitle", "time": 2887.51, "timestamp": "00:48:07", "text": "持续14分钟。只需将样品放在"}, {"type": "subtitle", "time": 2890.15, "timestamp": "00:48:10", "text": "提取点。我，呃，我们就这样"}, {"type": "subtitle", "time": 2892.39, "timestamp": "00:48:12", "text": "暂时先四处跑跑。是的，我"}, {"type": "subtitle", "time": 2895.75, "timestamp": "00:48:15", "text": "我掉了我的"}, {"type": "subtitle", "time": 2899.829, "timestamp": "00:48:19", "text": "呃，你们。好的，我加入。"}, {"type": "subtitle", "time": 2901.589, "timestamp": "00:48:21", "text": "右，右，下，左，右，下。"}, {"type": "subtitle", "time": 2906.79, "timestamp": "00:48:26", "text": "右，上，下，下，右。我是"}, {"type": "subtitle", "time": 2909.91, "timestamp": "00:48:29", "text": "等着那东西出现。"}, {"type": "subtitle", "time": 2912.309, "timestamp": "00:48:32", "text": "那是一家酒吧旅馆吗？"}, {"type": "subtitle", "time": 2915.349, "timestamp": "00:48:35", "text": "这就是炮火连天。"}, {"type": "subtitle", "time": 2917.99, "timestamp": "00:48:37", "text": "你们是怎么运用策略的？喜欢"}, {"type": "subtitle", "time": 2919.99, "timestamp": "00:48:39", "text": "方向键。"}, {"type": "subtitle", "time": 2924.79, "timestamp": "00:48:44", "text": "是的。所以我可以同时运行和输入"}, {"type": "subtitle", "time": 2929.349, "timestamp": "00:48:49", "text": "时间。对我来说，关键在于控制。"}, {"type": "subtitle", "time": 2934.87, "timestamp": "00:48:54", "text": "控制键和方向键或 WSD 键。"}, {"type": "subtitle", "time": 2937.43, "timestamp": "00:48:57", "text": "保持按下方向键。所以"}, {"type": "subtitle", "time": 2939.27, "timestamp": "00:48:59", "text": "这样你就可以边跑边输入了。"}]
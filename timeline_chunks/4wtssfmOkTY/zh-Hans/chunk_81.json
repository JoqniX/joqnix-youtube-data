[{"type": "subtitle", "time": 4871.11, "timestamp": "01:21:11", "text": "[音乐]"}, {"type": "subtitle", "time": 4907.59, "timestamp": "01:21:47", "text": "呃，我们上次见面应该已经有一段时间了。"}, {"type": "subtitle", "time": 4909.669, "timestamp": "01:21:49", "text": "到达那里了。"}, {"type": "subtitle", "time": 4914.07, "timestamp": "01:21:54", "text": "糟糕。死的。我的天啊。抓到你了。哦"}, {"type": "subtitle", "time": 4918.47, "timestamp": "01:21:58", "text": "糟糕。我被狙击了。等等，那里有狙击手。"}]
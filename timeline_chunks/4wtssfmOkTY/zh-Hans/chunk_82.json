[{"type": "subtitle", "time": 4921.51, "timestamp": "01:22:01", "text": "呃，拖走掩体塔。"}, {"type": "subtitle", "time": 4924.629, "timestamp": "01:22:04", "text": "哦，不错。一个倒下了。绿巨人喜欢"}, {"type": "subtitle", "time": 4927.83, "timestamp": "01:22:07", "text": "杀害自己的部下？哦，炮塔"}, {"type": "subtitle", "time": 4935.91, "timestamp": "01:22:15", "text": "糟糕，我好像听到什么声音了。"}, {"type": "subtitle", "time": 4938.07, "timestamp": "01:22:18", "text": "是的，那里有绿巨人。"}, {"type": "subtitle", "time": 4939.91, "timestamp": "01:22:19", "text": "是的。是的，那里有个绿巨人。"}, {"type": "subtitle", "time": 4942.229, "timestamp": "01:22:22", "text": "尽管。"}, {"type": "subtitle", "time": 4945.51, "timestamp": "01:22:25", "text": "它只是消灭了同类。我拿走了"}, {"type": "subtitle", "time": 4948.31, "timestamp": "01:22:28", "text": "向下。"}, {"type": "subtitle", "time": 4957.59, "timestamp": "01:22:37", "text": "炮塔在哪儿来着？你能做到吗？"}, {"type": "subtitle", "time": 4968.87, "timestamp": "01:22:48", "text": "嗯，"}, {"type": "subtitle", "time": 4972.39, "timestamp": "01:22:52", "text": "那东西在哪儿？"}, {"type": "subtitle", "time": 4975.11, "timestamp": "01:22:55", "text": "哦，什么？"}]
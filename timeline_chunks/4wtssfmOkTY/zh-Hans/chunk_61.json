[{"type": "subtitle", "time": 3662.309, "timestamp": "01:01:02", "text": "嘿，看，又来人了。"}, {"type": "subtitle", "time": 3669.109, "timestamp": "01:01:09", "text": "我不认为他们喜欢带东西来"}, {"type": "subtitle", "time": 3671.349, "timestamp": "01:01:11", "text": "我"}, {"type": "subtitle", "time": 3674.47, "timestamp": "01:01:14", "text": "哦，我看到一个人。"}, {"type": "subtitle", "time": 3676.789, "timestamp": "01:01:16", "text": "哦，你想试试这个模式？哦，"}, {"type": "subtitle", "time": 3680.15, "timestamp": "01:01:20", "text": "谢谢你们提供的水。"}, {"type": "subtitle", "time": 3684.87, "timestamp": "01:01:24", "text": "你想试试这种模式吗？什么？"}, {"type": "subtitle", "time": 3689.19, "timestamp": "01:01:29", "text": "等等，什么？哦，等等。那是激光。"}, {"type": "subtitle", "time": 3692.39, "timestamp": "01:01:32", "text": "激光警卫犬。是的。"}, {"type": "subtitle", "time": 3694.47, "timestamp": "01:01:34", "text": "杰夫，你有"}, {"type": "subtitle", "time": 3697.349, "timestamp": "01:01:37", "text": "你不能。我不能。等等，等等，等等。"}, {"type": "subtitle", "time": 3700.71, "timestamp": "01:01:40", "text": "不，不是这样的"}, {"type": "subtitle", "time": 3703.43, "timestamp": "01:01:43", "text": "有一个"}, {"type": "subtitle", "time": 3705.51, "timestamp": "01:01:45", "text": "嗯，就是这么久。他死了。我是"}, {"type": "subtitle", "time": 3708.63, "timestamp": "01:01:48", "text": "去闲聊。是的，我死了。"}, {"type": "subtitle", "time": 3712.069, "timestamp": "01:01:52", "text": "别担心，他会回来的。向下。来"}, {"type": "subtitle", "time": 3714.309, "timestamp": "01:01:54", "text": "糟糕。"}, {"type": "subtitle", "time": 3715.91, "timestamp": "01:01:55", "text": "等一下。等一下。这称为"}, {"type": "subtitle", "time": 3718.95, "timestamp": "01:01:58", "text": "三个。这需要一枚500公斤重的炸弹。"}]
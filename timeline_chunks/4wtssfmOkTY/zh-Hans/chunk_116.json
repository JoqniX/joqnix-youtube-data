[{"type": "subtitle", "time": 6960.629, "timestamp": "01:56:00", "text": "是的，我指的是困难。"}, {"type": "subtitle", "time": 6963.669, "timestamp": "01:56:03", "text": "没关系。"}, {"type": "subtitle", "time": 6965.27, "timestamp": "01:56:05", "text": "你目前最喜欢的武器是什么？"}, {"type": "subtitle", "time": 6970.79, "timestamp": "01:56:10", "text": "道路？假发。哦，虫子身上的火焰。"}, {"type": "subtitle", "time": 6973.75, "timestamp": "01:56:13", "text": "伟大的。他们很棒。"}, {"type": "subtitle", "time": 6976.47, "timestamp": "01:56:16", "text": "哦，是蠕动的虫子，对吧？让我看看。"}, {"type": "subtitle", "time": 6979.27, "timestamp": "01:56:19", "text": "主火焰喷射器。"}, {"type": "subtitle", "time": 6981.35, "timestamp": "01:56:21", "text": "呃"}, {"type": "subtitle", "time": 6984.95, "timestamp": "01:56:24", "text": "为了汽车人"}, {"type": "subtitle", "time": 6987.27, "timestamp": "01:56:27", "text": "我最喜欢的武器将是"}, {"type": "subtitle", "time": 6989.83, "timestamp": "01:56:29", "text": "苏格兰威士忌"}, {"type": "subtitle", "time": 6992.709, "timestamp": "01:56:32", "text": "它们很酷。"}, {"type": "subtitle", "time": 6996.07, "timestamp": "01:56:36", "text": "哦，任何爆炸物。喷发者，"}, {"type": "subtitle", "time": 6998.31, "timestamp": "01:56:38", "text": "弩，什么都行。任何爆炸物"}, {"type": "subtitle", "time": 7000.629, "timestamp": "01:56:40", "text": "很好"}, {"type": "subtitle", "time": 7004.39, "timestamp": "01:56:44", "text": "我懂了。我之前并不知情。"}, {"type": "subtitle", "time": 7007.03, "timestamp": "01:56:47", "text": "两个都"}, {"type": "subtitle", "time": 7009.75, "timestamp": "01:56:49", "text": "我以前会装载燃烧弹，但是"}, {"type": "subtitle", "time": 7012.87, "timestamp": "01:56:52", "text": "现在我有了火焰喷射器"}, {"type": "subtitle", "time": 7014.55, "timestamp": "01:56:54", "text": "断路器"}, {"type": "subtitle", "time": 7017.51, "timestamp": "01:56:57", "text": "煽动性的。"}]
[{"type": "subtitle", "time": 9902.469, "timestamp": "02:45:02", "text": "我多么希望我能做一个！"}, {"type": "subtitle", "time": 9906.71, "timestamp": "02:45:06", "text": "不如聊天吧？"}, {"type": "subtitle", "time": 9914.07, "timestamp": "02:45:14", "text": "但我觉得充电才是关键所在。"}, {"type": "subtitle", "time": 9916.95, "timestamp": "02:45:16", "text": "以及用于游戏的简短聊天。是的。"}, {"type": "subtitle", "time": 9920.95, "timestamp": "02:45:20", "text": "闲聊是用来玩游戏的。是的。是的。所以，我"}, {"type": "subtitle", "time": 9924.23, "timestamp": "02:45:24", "text": "想把它变成一个。呃，我以为我"}, {"type": "subtitle", "time": 9927.75, "timestamp": "02:45:27", "text": "我其实挺想实现这个目标的。"}, {"type": "subtitle", "time": 9929.51, "timestamp": "02:45:29", "text": "更小。"}, {"type": "subtitle", "time": 9932.389, "timestamp": "02:45:32", "text": "我只是……你知道，我不想有"}, {"type": "subtitle", "time": 9935.91, "timestamp": "02:45:35", "text": "多个浏览器来源，因为那些"}, {"type": "subtitle", "time": 9941.83, "timestamp": "02:45:41", "text": "会严重消耗内存。"}, {"type": "subtitle", "time": 9945.59, "timestamp": "02:45:45", "text": "所以我就想，嗯，"}, {"type": "subtitle", "time": 9950.87, "timestamp": "02:45:50", "text": "我能做些什么？因为目前我有类似"}, {"type": "subtitle", "time": 9954.15, "timestamp": "02:45:54", "text": "五个重要的浏览器资源是"}, {"type": "subtitle", "time": 9959.51, "timestamp": "02:45:59", "text": "比如，主要来自 Twitch 的直播，比如“我们来吧”。"}]
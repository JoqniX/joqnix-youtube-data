[{"type": "subtitle", "time": 10921.83, "timestamp": "03:02:01", "text": "我吃完晚饭后就睡了。"}, {"type": "subtitle", "time": 10925.03, "timestamp": "03:02:05", "text": "睡着了"}, {"type": "subtitle", "time": 10928.71, "timestamp": "03:02:08", "text": "早上醒来时，我发现自己穿着全套道服。"}, {"type": "subtitle", "time": 10934.23, "timestamp": "03:02:14", "text": "完全健康的元气和我依然"}, {"type": "subtitle", "time": 10938.15, "timestamp": "03:02:18", "text": "所以我想这就是我当时的心情吧。"}, {"type": "subtitle", "time": 10941.429, "timestamp": "03:02:21", "text": "嗯，我想这就是原因吧。"}, {"type": "subtitle", "time": 10944.95, "timestamp": "03:02:24", "text": "感觉真的很好"}, {"type": "subtitle", "time": 10951.269, "timestamp": "03:02:31", "text": "5级。老兄，你简直就是目标水平！"}, {"type": "subtitle", "time": 10953.11, "timestamp": "03:02:33", "text": "我是说，"}, {"type": "subtitle", "time": 10955.91, "timestamp": "03:02:35", "text": "我不知道那是不是目标"}, {"type": "subtitle", "time": 10959.51, "timestamp": "03:02:39", "text": "等级。我的意思是，我已经习惯了直播。"}, {"type": "subtitle", "time": 10962.309, "timestamp": "03:02:42", "text": "12 小时或以上"}, {"type": "subtitle", "time": 10965.83, "timestamp": "03:02:45", "text": "但我已经直播了大约12个小时了。"}, {"type": "subtitle", "time": 10968.07, "timestamp": "03:02:48", "text": "更多但"}, {"type": "subtitle", "time": 10971.11, "timestamp": "03:02:51", "text": "有时候你说话就像那些人一样"}, {"type": "subtitle", "time": 10975.269, "timestamp": "03:02:55", "text": "那些我以前很少谈论的话题"}, {"type": "subtitle", "time": 10978.87, "timestamp": "03:02:58", "text": "但当你积极主动地正确说话时"}]
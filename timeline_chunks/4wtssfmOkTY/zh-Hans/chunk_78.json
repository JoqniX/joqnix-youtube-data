[{"type": "subtitle", "time": 4681.51, "timestamp": "01:18:01", "text": "我打算采用380毫米弹幕。全部"}, {"type": "subtitle", "time": 4687.51, "timestamp": "01:18:07", "text": "爆破炸弹。"}, {"type": "subtitle", "time": 4692.229, "timestamp": "01:18:12", "text": "弧形投掷器更好吗？"}, {"type": "subtitle", "time": 4693.91, "timestamp": "01:18:13", "text": "不，不要用投掷器对抗"}, {"type": "subtitle", "time": 4698.47, "timestamp": "01:18:18", "text": "自动机。唉，我当时为什么要买呢？"}, {"type": "subtitle", "time": 4699.75, "timestamp": "01:18:19", "text": "没关系。没关系。你不需要"}, {"type": "subtitle", "time": 4701.91, "timestamp": "01:18:21", "text": "我是亚瑟。你需要一根关节置换器"}, {"type": "subtitle", "time": 4703.91, "timestamp": "01:18:23", "text": "成群结队。我的天哪。你可以用它来对付……"}, {"type": "subtitle", "time": 4706.07, "timestamp": "01:18:26", "text": "光明会之类的，但反对"}, {"type": "subtitle", "time": 4707.91, "timestamp": "01:18:27", "text": "自动装置，甚至在你能够使用它之前，"}, {"type": "subtitle", "time": 4709.43, "timestamp": "01:18:29", "text": "你会死的，因为他们有火箭。"}, {"type": "subtitle", "time": 4711.59, "timestamp": "01:18:31", "text": "东西，它们会从火中射出。那是"}, {"type": "subtitle", "time": 4715.75, "timestamp": "01:18:35", "text": "我为什么这么说。哪个更好？"}, {"type": "subtitle", "time": 4720.07, "timestamp": "01:18:40", "text": "呃，黄蜂发射器、电磁炮还是激光炮？"}, {"type": "subtitle", "time": 4721.669, "timestamp": "01:18:41", "text": "大炮。"}, {"type": "subtitle", "time": 4723.51, "timestamp": "01:18:43", "text": "嗯，你可以使用爆破炮，因为"}, {"type": "subtitle", "time": 4725.03, "timestamp": "01:18:45", "text": "它是可充电的，所以你不需要"}, {"type": "subtitle", "time": 4727.51, "timestamp": "01:18:47", "text": "担心弹药问题。"}, {"type": "subtitle", "time": 4729.669, "timestamp": "01:18:49", "text": "你玩这款游戏多久了？我"}, {"type": "subtitle", "time": 4732.07, "timestamp": "01:18:52", "text": "什么都忘了。好的，他是最后一个。"}, {"type": "subtitle", "time": 4734.87, "timestamp": "01:18:54", "text": "现在差不多了。好的，你不必……"}]
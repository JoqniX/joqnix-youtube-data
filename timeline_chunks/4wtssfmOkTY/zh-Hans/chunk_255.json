[{"type": "subtitle", "time": 15301.03, "timestamp": "04:15:01", "text": "旋律"}, {"type": "subtitle", "time": 15303.429, "timestamp": "04:15:03", "text": "正确的"}, {"type": "subtitle", "time": 15306.469, "timestamp": "04:15:06", "text": "但我确实很想学这首歌​​。"}, {"type": "subtitle", "time": 15311.269, "timestamp": "04:15:11", "text": "对我来说很难，但我仍然想"}, {"type": "subtitle", "time": 15313.59, "timestamp": "04:15:13", "text": "你好"}, {"type": "subtitle", "time": 15315.75, "timestamp": "04:15:15", "text": "我受够了"}, {"type": "subtitle", "time": 15317.59, "timestamp": "04:15:17", "text": "我浑身是汗"}, {"type": "subtitle", "time": 15320.79, "timestamp": "04:15:20", "text": "是的，我在伸展运动。"}, {"type": "subtitle", "time": 15325.99, "timestamp": "04:15:25", "text": "我太不知道了，甚至连它都这么说。"}, {"type": "subtitle", "time": 15329.99, "timestamp": "04:15:29", "text": "两三分钟，但我还是"}, {"type": "subtitle", "time": 15335.11, "timestamp": "04:15:35", "text": "我汗流浃背地干活了。我浪费了"}, {"type": "subtitle", "time": 15338.389, "timestamp": "04:15:38", "text": "今天需要20或10点能量。现在我"}, {"type": "subtitle", "time": 15340.71, "timestamp": "04:15:40", "text": "说"}, {"type": "subtitle", "time": 15343.03, "timestamp": "04:15:43", "text": "在我说“让我去洗个澡”之前，我的"}, {"type": "subtitle", "time": 15352.309, "timestamp": "04:15:52", "text": "[音乐]"}, {"type": "subtitle", "time": 15354.63, "timestamp": "04:15:54", "text": "我竟然忘了你"}, {"type": "subtitle", "time": 15358.469, "timestamp": "04:15:58", "text": "呃，做个鲍比的东西。所以我就……"}]
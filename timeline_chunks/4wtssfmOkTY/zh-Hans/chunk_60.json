[{"type": "subtitle", "time": 3600.069, "timestamp": "01:00:00", "text": "哦，我们有侧翼。我们有一台380"}, {"type": "subtitle", "time": 3607.67, "timestamp": "01:00:07", "text": "是的。是的。祝你好运。祝你好运。我的"}, {"type": "subtitle", "time": 3610.63, "timestamp": "01:00:10", "text": "天哪，他脸红了。上帝，"}, {"type": "subtitle", "time": 3612.23, "timestamp": "01:00:12", "text": "祝你好运。那到底是什么颜色？"}, {"type": "subtitle", "time": 3617.19, "timestamp": "01:00:17", "text": "为什么说没问题？重装上阵。你真是个怪胎。我"}, {"type": "subtitle", "time": 3627.829, "timestamp": "01:00:27", "text": "无人机武器？不，这是什么东西？"}, {"type": "subtitle", "time": 3635.67, "timestamp": "01:00:35", "text": "自动机。是的。到底怎么回事？"}, {"type": "subtitle", "time": 3638.15, "timestamp": "01:00:38", "text": "自动行星？"}, {"type": "subtitle", "time": 3640.63, "timestamp": "01:00:40", "text": "情况糟透了。"}, {"type": "subtitle", "time": 3642.39, "timestamp": "01:00:42", "text": "我的意思是，我们要把它炸得稀巴烂。"}, {"type": "subtitle", "time": 3645.27, "timestamp": "01:00:45", "text": "遗忘，你还能指望什么？"}, {"type": "subtitle", "time": 3648.15, "timestamp": "01:00:48", "text": "是的，我们正在移除存在。我们已经"}, {"type": "subtitle", "time": 3650.39, "timestamp": "01:00:50", "text": "一直在轰炸他们"}, {"type": "subtitle", "time": 3653.27, "timestamp": "01:00:53", "text": "380 和 120。"}]
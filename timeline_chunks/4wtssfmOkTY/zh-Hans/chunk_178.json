[{"type": "subtitle", "time": 10682.309, "timestamp": "02:58:02", "text": "我一直都这么说，但我还是想"}, {"type": "subtitle", "time": 10684.71, "timestamp": "02:58:04", "text": "我说话的时候话比较多"}, {"type": "subtitle", "time": 10689.51, "timestamp": "02:58:09", "text": "直播的时候我确实话很多，但我想要"}, {"type": "subtitle", "time": 10691.51, "timestamp": "02:58:11", "text": "现在该怎么称呼它呢？"}, {"type": "subtitle", "time": 10695.75, "timestamp": "02:58:15", "text": "我想直播游戏并和大家聊聊。"}, {"type": "subtitle", "time": 10697.67, "timestamp": "02:58:17", "text": "把我正在做的事情说出来。那就是"}, {"type": "subtitle", "time": 10700.02, "timestamp": "02:58:20", "text": "对吧？"}, {"type": "subtitle", "time": 10702.15, "timestamp": "02:58:22", "text": "[音乐]"}, {"type": "subtitle", "time": 10704.309, "timestamp": "02:58:24", "text": "我还想查看聊天记录。问题是"}, {"type": "subtitle", "time": 10706.389, "timestamp": "02:58:26", "text": "我没看聊天记录。虽然我读过它"}, {"type": "subtitle", "time": 10710.389, "timestamp": "02:58:30", "text": "在我看来，我感觉我……虽然我"}, {"type": "subtitle", "time": 10714.79, "timestamp": "02:58:34", "text": "我在脑海中读了一遍，感觉就像"}, {"type": "subtitle", "time": 10717.75, "timestamp": "02:58:37", "text": "呃，我的脑子里已经想好了……"}, {"type": "subtitle", "time": 10721.59, "timestamp": "02:58:41", "text": "虽然口头上已经说过，但实际上"}, {"type": "subtitle", "time": 10723.91, "timestamp": "02:58:43", "text": "我没说过。"}, {"type": "subtitle", "time": 10726.71, "timestamp": "02:58:46", "text": "我刚才在脑子里读了一遍，但我认为"}, {"type": "subtitle", "time": 10729.83, "timestamp": "02:58:49", "text": "我亲口说了。"}, {"type": "subtitle", "time": 10732.79, "timestamp": "02:58:52", "text": "我不知道为什么。"}, {"type": "subtitle", "time": 10734.72, "timestamp": "02:58:54", "text": "我不知道为什么，但是"}, {"type": "subtitle", "time": 10735.83, "timestamp": "02:58:55", "text": "[音乐]"}, {"type": "subtitle", "time": 10739.349, "timestamp": "02:58:59", "text": "是的。你从哪来？我来自印度。"}]
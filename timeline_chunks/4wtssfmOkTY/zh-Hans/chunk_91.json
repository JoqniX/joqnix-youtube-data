[{"type": "subtitle", "time": 5462.31, "timestamp": "01:31:02", "text": "我为什么会为这些人感到恐慌？"}, {"type": "subtitle", "time": 5464.39, "timestamp": "01:31:04", "text": "嘿，看。超级样本。是绿巨人。"}, {"type": "subtitle", "time": 5467.189, "timestamp": "01:31:07", "text": "它死了。好的。"}, {"type": "subtitle", "time": 5470.87, "timestamp": "01:31:10", "text": "我听到了一些消息。我没有，我要走了"}, {"type": "subtitle", "time": 5488.73, "timestamp": "01:31:28", "text": "你抓住了它们。我觉得你做到了。没有。"}, {"type": "subtitle", "time": 5491.11, "timestamp": "01:31:31", "text": "[音乐]"}, {"type": "subtitle", "time": 5495.59, "timestamp": "01:31:35", "text": "好的，我们需要……嗯，弄一些……是的。"}, {"type": "subtitle", "time": 5498.149, "timestamp": "01:31:38", "text": "因为我们需要它们。至少我需要"}, {"type": "subtitle", "time": 5501.59, "timestamp": "01:31:41", "text": "他们。该死的。我也需要"}, {"type": "subtitle", "time": 5504.39, "timestamp": "01:31:44", "text": "等等，一个人收集它……"}, {"type": "subtitle", "time": 5507.03, "timestamp": "01:31:47", "text": "其他人也一样吗？是的。是的。"}, {"type": "subtitle", "time": 5511.99, "timestamp": "01:31:51", "text": "是的。你为什么要对他进行精神操控？"}, {"type": "subtitle", "time": 5514.229, "timestamp": "01:31:54", "text": "我的天啊。我不擅长"}, {"type": "subtitle", "time": 5517.83, "timestamp": "01:31:57", "text": "煤气灯效应。好的。我的天啊。气体"}, {"type": "subtitle", "time": 5519.669, "timestamp": "01:31:59", "text": "灯光。很多事情很难说清楚。我当时"}]
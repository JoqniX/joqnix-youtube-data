[{"type": "subtitle", "time": 7032.709, "timestamp": "01:57:12", "text": "我……我喜欢酷热难耐的天气。这是什么？"}, {"type": "subtitle", "time": 7036.95, "timestamp": "01:57:16", "text": "这东西叫什么？镰刀。"}, {"type": "subtitle", "time": 7038.95, "timestamp": "01:57:18", "text": "至少"}, {"type": "subtitle", "time": 7041.43, "timestamp": "01:57:21", "text": "我是十字路口。我喜欢激光武器"}, {"type": "subtitle", "time": 7042.95, "timestamp": "01:57:22", "text": "对抗虫害。我不用担心"}, {"type": "subtitle", "time": 7044.87, "timestamp": "01:57:24", "text": "每次都要重新加载"}, {"type": "subtitle", "time": 7047.27, "timestamp": "01:57:27", "text": "考虑到它们的数量之多。"}, {"type": "subtitle", "time": 7054.79, "timestamp": "01:57:34", "text": "不是那样。"}, {"type": "subtitle", "time": 7059.99, "timestamp": "01:57:39", "text": "弩不好用。哦，很好。"}, {"type": "subtitle", "time": 7062.47, "timestamp": "01:57:42", "text": "保持距离是好事。"}, {"type": "subtitle", "time": 7064.07, "timestamp": "01:57:44", "text": "如果没有这个，那就不好。"}, {"type": "subtitle", "time": 7065.75, "timestamp": "01:57:45", "text": "距离。是的。你最终会"}, {"type": "subtitle", "time": 7077.75, "timestamp": "01:57:57", "text": "我想吹进一个虫子星球看看"}, {"type": "subtitle", "time": 7079.91, "timestamp": "01:57:59", "text": "如果我能干掉一个泰坦，因为它"}]
[{"type": "subtitle", "time": 4621.189, "timestamp": "01:17:01", "text": "我的天啊。我去过那里。我一直"}, {"type": "subtitle", "time": 4626.709, "timestamp": "01:17:06", "text": "总之，到直升机停机坪去。好的。"}, {"type": "subtitle", "time": 4629.83, "timestamp": "01:17:09", "text": "如何再次变身超级英雄？不，那些"}, {"type": "subtitle", "time": 4633.11, "timestamp": "01:17:13", "text": "不是视频片段。那是弹匣。"}, {"type": "subtitle", "time": 4635.91, "timestamp": "01:17:15", "text": "是的，弹匣之间存在巨大差异。"}, {"type": "subtitle", "time": 4637.59, "timestamp": "01:17:17", "text": "以及剪辑片段。"}, {"type": "subtitle", "time": 4640.31, "timestamp": "01:17:20", "text": "我的天哪，我们要升到第九级了。哦，"}, {"type": "subtitle", "time": 4642.149, "timestamp": "01:17:22", "text": "快点。"}, {"type": "subtitle", "time": 4644.709, "timestamp": "01:17:24", "text": "我的天哪，我讨厌这些。这些都是"}, {"type": "subtitle", "time": 4648.55, "timestamp": "01:17:28", "text": "讨厌的家伙。就在这一侧。"}, {"type": "subtitle", "time": 4650.63, "timestamp": "01:17:30", "text": "是的。同意。"}, {"type": "subtitle", "time": 4658.79, "timestamp": "01:17:38", "text": "好的。我拿到要带的东西了。我要"}, {"type": "subtitle", "time": 4661.59, "timestamp": "01:17:41", "text": "增加加固预算。"}, {"type": "subtitle", "time": 4663.669, "timestamp": "01:17:43", "text": "实际上，"}, {"type": "subtitle", "time": 4665.669, "timestamp": "01:17:45", "text": "要么就是通过增强肌肉力量。我"}, {"type": "subtitle", "time": 4667.27, "timestamp": "01:17:47", "text": "我觉得加固方面应该没问题。"}, {"type": "subtitle", "time": 4669.669, "timestamp": "01:17:49", "text": "预算。我选择肌肉增强。"}, {"type": "subtitle", "time": 4678.709, "timestamp": "01:17:58", "text": "120毫米。打扰一下。"}]
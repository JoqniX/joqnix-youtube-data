[{"type": "subtitle", "time": 10203.429, "timestamp": "02:50:03", "text": "是的。所以，是的，我想……"}, {"type": "subtitle", "time": 10206.469, "timestamp": "02:50:06", "text": "我想从事这项工作"}, {"type": "subtitle", "time": 10210.71, "timestamp": "02:50:10", "text": "嗯，你知道，等等。"}, {"type": "subtitle", "time": 10213.03, "timestamp": "02:50:13", "text": "接下来要做什么？"}, {"type": "subtitle", "time": 10217.19, "timestamp": "02:50:17", "text": "YouTube。我一直想着你们。"}, {"type": "subtitle", "time": 10221.51, "timestamp": "02:50:21", "text": "适用于 YouTube 频道和观众。"}, {"type": "subtitle", "time": 10224.63, "timestamp": "02:50:24", "text": "嗯，所以"}, {"type": "subtitle", "time": 10228.79, "timestamp": "02:50:28", "text": "莱克西 莱克西 莱克西 莱克西 莱克西"}, {"type": "subtitle", "time": 10231.11, "timestamp": "02:50:31", "text": "所以，呃，我们已经把利奥尔号搭载上了。"}, {"type": "subtitle", "time": 10233.91, "timestamp": "02:50:33", "text": "YouTube 的扩展程序，免费版。"}, {"type": "subtitle", "time": 10236.71, "timestamp": "02:50:36", "text": "是的当然。这是免费的。"}, {"type": "subtitle", "time": 10238.389, "timestamp": "02:50:38", "text": "每个人。"}, {"type": "subtitle", "time": 10241.75, "timestamp": "02:50:41", "text": "嗯，现在想想，你"}, {"type": "subtitle", "time": 10244.71, "timestamp": "02:50:44", "text": "我的机器人没有欢迎各位。"}, {"type": "subtitle", "time": 10248.87, "timestamp": "02:50:48", "text": "哦，等等。我忘了。我忘了刷新页面。"}, {"type": "subtitle", "time": 10252.95, "timestamp": "02:50:52", "text": "我的天啊。巴克尔"}, {"type": "subtitle", "time": 10255.83, "timestamp": "02:50:55", "text": "你这个笨蛋骑师。我的天哪。你个笨蛋"}, {"type": "subtitle", "time": 10257.75, "timestamp": "02:50:57", "text": "假的。"}]
[{"type": "subtitle", "time": 3001.349, "timestamp": "00:50:01", "text": "手榴弹。"}, {"type": "subtitle", "time": 3015.99, "timestamp": "00:50:15", "text": "怎么可能不经过那个流程呢？"}, {"type": "subtitle", "time": 3018.79, "timestamp": "00:50:18", "text": "兄弟，别担心。我有我的"}, {"type": "subtitle", "time": 3021.67, "timestamp": "00:50:21", "text": "反器材步枪。"}, {"type": "subtitle", "time": 3029.589, "timestamp": "00:50:29", "text": "哦。哦，它死了。"}, {"type": "subtitle", "time": 3038.309, "timestamp": "00:50:38", "text": "我身上居然带着个火箭筒！"}, {"type": "subtitle", "time": 3040.71, "timestamp": "00:50:40", "text": "而我并没有那样做。我仍然热爱"}, {"type": "subtitle", "time": 3043.91, "timestamp": "00:50:43", "text": "事实上我还在加载中。是的。"}, {"type": "subtitle", "time": 3048.47, "timestamp": "00:50:48", "text": "盟军驱逐舰。好的，我到了。"}, {"type": "subtitle", "time": 3050.309, "timestamp": "00:50:50", "text": "在哪里？"}, {"type": "subtitle", "time": 3053.43, "timestamp": "00:50:53", "text": "我的天哪，到处都是一片混乱。"}, {"type": "subtitle", "time": 3056.47, "timestamp": "00:50:56", "text": "哦，这算什么。这"}, {"type": "subtitle", "time": 3058.23, "timestamp": "00:50:58", "text": "你这是在用难度较高的火力啊，老兄。什么"}]
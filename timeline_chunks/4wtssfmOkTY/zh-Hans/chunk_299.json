[{"type": "subtitle", "time": 17941.67, "timestamp": "04:59:01", "text": "有时候你知道，当我听一些"}, {"type": "subtitle", "time": 17944.708, "timestamp": "04:59:04", "text": "有时我会听一些随机的歌曲"}, {"type": "subtitle", "time": 17948.39, "timestamp": "04:59:08", "text": "从笔记中汲取灵感，有时"}, {"type": "subtitle", "time": 17952.31, "timestamp": "04:59:12", "text": "它突然就来找我。"}, {"type": "subtitle", "time": 17954.868, "timestamp": "04:59:14", "text": "所以我就想，等等，我为什么在唱这首歌？"}, {"type": "subtitle", "time": 17961.91, "timestamp": "04:59:21", "text": "[音乐]"}, {"type": "subtitle", "time": 17969.75, "timestamp": "04:59:29", "text": "所以，呃，我一个朋友说……"}, {"type": "subtitle", "time": 17973.43, "timestamp": "04:59:33", "text": "如果你坚持每天唱歌"}, {"type": "subtitle", "time": 17977.27, "timestamp": "04:59:37", "text": "无论你做什么事"}, {"type": "subtitle", "time": 17979.99, "timestamp": "04:59:39", "text": "当你，无论何时，当你这样做的时候"}, {"type": "subtitle", "time": 17983.03, "timestamp": "04:59:43", "text": "当你继续……的时候，东西或任何东西"}, {"type": "subtitle", "time": 17985.83, "timestamp": "04:59:45", "text": "唱歌、唱歌，这就是训练的方式"}, {"type": "subtitle", "time": 17989.03, "timestamp": "04:59:49", "text": "让自己成为更好的歌手"}, {"type": "subtitle", "time": 17990.708, "timestamp": "04:59:50", "text": "和"}, {"type": "subtitle", "time": 17992.55, "timestamp": "04:59:52", "text": "你不可能一天就成为歌手。"}, {"type": "subtitle", "time": 17994.55, "timestamp": "04:59:54", "text": "必须反复练习。"}, {"type": "subtitle", "time": 17997.43, "timestamp": "04:59:57", "text": "练习、唱歌、再那样唱。"}]
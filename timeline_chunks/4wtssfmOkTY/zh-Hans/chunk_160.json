[{"type": "subtitle", "time": 9601.429, "timestamp": "02:40:01", "text": "这是6点钟的直播，但我醒了。"}, {"type": "subtitle", "time": 9606.95, "timestamp": "02:40:06", "text": "8. 所以在我达到最大值之前"}, {"type": "subtitle", "time": 9610.389, "timestamp": "02:40:10", "text": "我对自己说，当我醒来的时候……"}, {"type": "subtitle", "time": 9613.59, "timestamp": "02:40:13", "text": "我会做asaya。所以这意味着如果"}, {"type": "subtitle", "time": 9617.91, "timestamp": "02:40:17", "text": "我早上6点起床，6点7点开始。"}, {"type": "subtitle", "time": 9621.429, "timestamp": "02:40:21", "text": "昨天是7点。所以，是的，直播是从"}, {"type": "subtitle", "time": 9626.55, "timestamp": "02:40:26", "text": "今天早上7点。今天是8点。嗨。我不会"}, {"type": "subtitle", "time": 9630.87, "timestamp": "02:40:30", "text": "虽然在这里待了很久。你好。没关系。"}, {"type": "subtitle", "time": 9633.33, "timestamp": "02:40:33", "text": "没关系。没关系。"}, {"type": "subtitle", "time": 9635.27, "timestamp": "02:40:35", "text": "[音乐]"}, {"type": "subtitle", "time": 9637.99, "timestamp": "02:40:37", "text": "当然可以。你早上过得怎么样？如何"}, {"type": "subtitle", "time": 9641.349, "timestamp": "02:40:41", "text": "你在干嘛，笨蛋？"}, {"type": "subtitle", "time": 9644.469, "timestamp": "02:40:44", "text": "哦，是的。呃呃，我的世界怎么样了？"}, {"type": "subtitle", "time": 9645.83, "timestamp": "02:40:45", "text": "服务器？发生了什么事？"}, {"type": "subtitle", "time": 9648.71, "timestamp": "02:40:48", "text": "我的世界服务器？你们……"}, {"type": "subtitle", "time": 9653.83, "timestamp": "02:40:53", "text": "重新开放了吗？我想念"}, {"type": "subtitle", "time": 9658.12, "timestamp": "02:40:58", "text": "呃，我想念我的世界。"}]
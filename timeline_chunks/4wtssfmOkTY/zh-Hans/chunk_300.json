[{"type": "subtitle", "time": 18000.55, "timestamp": "05:00:00", "text": "艺术作品之类的也一样。你必须"}, {"type": "subtitle", "time": 18005.43, "timestamp": "05:00:05", "text": "画出一百万亿万"}, {"type": "subtitle", "time": 18008.788, "timestamp": "05:00:08", "text": "艺术作品变得更好"}, {"type": "subtitle", "time": 18014.23, "timestamp": "05:00:14", "text": "更擅长这方面的艺术和事物。是的，"}, {"type": "subtitle", "time": 18017.51, "timestamp": "05:00:17", "text": "所以让我们把这当作练习吧。"}, {"type": "subtitle", "time": 18020.31, "timestamp": "05:00:20", "text": "关于昨天的事，呃，我不是说过吗？"}, {"type": "subtitle", "time": 18023.67, "timestamp": "05:00:23", "text": "也？是的，你也这么说过。"}, {"type": "subtitle", "time": 18027.35, "timestamp": "05:00:27", "text": "所以我才说，我的一个朋友说"}, {"type": "subtitle", "time": 18031.35, "timestamp": "05:00:31", "text": "那是因为我忘了是谁说的了。"}, {"type": "subtitle", "time": 18034.788, "timestamp": "05:00:34", "text": "首位。是米姆还是你？"}, {"type": "subtitle", "time": 18037.03, "timestamp": "05:00:37", "text": "正确的？我忘了。我认为他就是那个男孩"}, {"type": "subtitle", "time": 18039.99, "timestamp": "05:00:39", "text": "话虽如此。是的。必须继续下去"}, {"type": "subtitle", "time": 18057.11, "timestamp": "05:00:57", "text": "唉，有时候我也不知道为什么，就是想要。"}]
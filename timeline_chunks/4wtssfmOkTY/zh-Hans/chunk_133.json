[{"type": "subtitle", "time": 7980.39, "timestamp": "02:13:00", "text": "一旦我没有笔记本电脑，我就要……"}, {"type": "subtitle", "time": 7983.669, "timestamp": "02:13:03", "text": "跟你一起吐"}, {"type": "subtitle", "time": 7988.229, "timestamp": "02:13:08", "text": "我赢得了泰坦酒吧的泰坦酒吧"}, {"type": "subtitle", "time": 7991.75, "timestamp": "02:13:11", "text": "西边，我的天哪，你想搬回去吗？"}, {"type": "subtitle", "time": 7994.709, "timestamp": "02:13:14", "text": "想搬回去，我刚叫了120毫米"}, {"type": "subtitle", "time": 7997.83, "timestamp": "02:13:17", "text": "就在那里，就是它，就是我，没错"}, {"type": "subtitle", "time": 8007.189, "timestamp": "02:13:27", "text": "我会活下去的。我有一个，我有一个，我有一个"}, {"type": "subtitle", "time": 8019.83, "timestamp": "02:13:39", "text": "嘿，看，一只黄蜂。"}, {"type": "subtitle", "time": 8024.069, "timestamp": "02:13:44", "text": "一二三。"}]
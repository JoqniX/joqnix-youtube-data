[{"type": "subtitle", "time": 6603.189, "timestamp": "01:50:03", "text": "我要前往"}, {"type": "subtitle", "time": 6605.189, "timestamp": "01:50:05", "text": "黄油和"}, {"type": "subtitle", "time": 6608.31, "timestamp": "01:50:08", "text": "震惊。耶。你在学习。是的。哦，我的"}, {"type": "subtitle", "time": 6611.109, "timestamp": "01:50:11", "text": "上帝。有炸弹。"}, {"type": "subtitle", "time": 6615.02, "timestamp": "01:50:15", "text": "我正朝你走来。坚持，稍等。"}, {"type": "subtitle", "time": 6617.91, "timestamp": "01:50:17", "text": "[音乐]"}, {"type": "subtitle", "time": 6619.75, "timestamp": "01:50:19", "text": "不。"}, {"type": "subtitle", "time": 6623.03, "timestamp": "01:50:23", "text": "再见了，他。是的。哦，这里有个……"}, {"type": "subtitle", "time": 6626.47, "timestamp": "01:50:26", "text": "绿巨人。我能看到。进来吧，绿巨人。你"}, {"type": "subtitle", "time": 6628.31, "timestamp": "01:50:28", "text": "说？"}, {"type": "subtitle", "time": 6631.669, "timestamp": "01:50:31", "text": "有人提到绿巨人吗？"}, {"type": "subtitle", "time": 6633.83, "timestamp": "01:50:33", "text": "他倒下了。"}, {"type": "subtitle", "time": 6643.669, "timestamp": "01:50:43", "text": "哦，还有一个绿巨人。"}, {"type": "subtitle", "time": 6645.83, "timestamp": "01:50:45", "text": "糟糕。"}, {"type": "subtitle", "time": 6649.51, "timestamp": "01:50:49", "text": "哦，我想But还没回来。"}, {"type": "subtitle", "time": 6651.43, "timestamp": "01:50:51", "text": "他还没回来。"}, {"type": "subtitle", "time": 6654.47, "timestamp": "01:50:54", "text": "我觉得他还没回来。他离开了"}, {"type": "subtitle", "time": 6656.87, "timestamp": "01:50:56", "text": "风险投资等等。"}]
[{"type": "subtitle", "time": 12001.03, "timestamp": "03:20:01", "text": "等待。这是剧透吗？"}, {"type": "subtitle", "time": 12002.87, "timestamp": "03:20:02", "text": "等待。什么？"}, {"type": "subtitle", "time": 12017.269, "timestamp": "03:20:17", "text": "剧透来自？"}, {"type": "subtitle", "time": 12020.63, "timestamp": "03:20:20", "text": "都是炒作。炒作。哦，原来是一辆车。不"}, {"type": "subtitle", "time": 12022.87, "timestamp": "03:20:22", "text": "担心。别介意。别担心。"}, {"type": "subtitle", "time": 12029.349, "timestamp": "03:20:29", "text": "哦，最新一集"}, {"type": "subtitle", "time": 12031.19, "timestamp": "03:20:31", "text": "博人传。我还没有更新。"}, {"type": "subtitle", "time": 12034.229, "timestamp": "03:20:34", "text": "博人传。我想念看布鲁托的日子。我爱"}, {"type": "subtitle", "time": 12039.83, "timestamp": "03:20:39", "text": "但它，但我需要看30到40集。"}]
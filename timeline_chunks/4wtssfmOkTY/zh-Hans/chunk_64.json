[{"type": "subtitle", "time": 3850.789, "timestamp": "01:04:10", "text": "总之，我回来了。我会回来的。来"}, {"type": "subtitle", "time": 3856.71, "timestamp": "01:04:16", "text": "我的弹药用完了。在我们上方。在我们上方。"}, {"type": "subtitle", "time": 3860.95, "timestamp": "01:04:20", "text": "在我们上方。没关系。"}, {"type": "subtitle", "time": 3864.63, "timestamp": "01:04:24", "text": "我们要走了。我们出去了。我们走吧。"}, {"type": "subtitle", "time": 3866.15, "timestamp": "01:04:26", "text": "跑步。"}, {"type": "subtitle", "time": 3869.51, "timestamp": "01:04:29", "text": "去。去。进去。快进去。走，走，走。"}, {"type": "subtitle", "time": 3877.43, "timestamp": "01:04:37", "text": "提取完成。我们很好。我们出去了。我"}, {"type": "subtitle", "time": 3880.309, "timestamp": "01:04:40", "text": "爱就像"}, {"type": "subtitle", "time": 3883.75, "timestamp": "01:04:43", "text": "五级时感到羞愧难当。我的意思是，垃圾"}, {"type": "subtitle", "time": 3885.589, "timestamp": "01:04:45", "text": "做得好"}, {"type": "subtitle", "time": 3887.19, "timestamp": "01:04:47", "text": "除了友军误伤之外。好的，"}, {"type": "subtitle", "time": 3890.39, "timestamp": "01:04:50", "text": "现在地狱灭亡了。我们走吧。他死了。"}, {"type": "subtitle", "time": 3894.71, "timestamp": "01:04:54", "text": "我的天啊。我们走吧。最高难度。"}, {"type": "subtitle", "time": 3897.51, "timestamp": "01:04:57", "text": "最高难度。我们走吧。那是最大值"}]
[{"type": "subtitle", "time": 8763.11, "timestamp": "02:26:03", "text": "去做。你可以。你做得很好。你"}, {"type": "subtitle", "time": 8765.03, "timestamp": "02:26:05", "text": "可以做到。即将崩溃。谢谢你，"}, {"type": "subtitle", "time": 8770.63, "timestamp": "02:26:10", "text": "你好，Alex。希望你一切都好。"}, {"type": "subtitle", "time": 8773.91, "timestamp": "02:26:13", "text": "你好，Alexa。祝你有个美好的夜晚。"}, {"type": "subtitle", "time": 8778.79, "timestamp": "02:26:18", "text": "我很确定我们有，我们应该有。"}, {"type": "subtitle", "time": 8783.67, "timestamp": "02:26:23", "text": "真不想跟你说这些，不过，是的。"}, {"type": "subtitle", "time": 8785.67, "timestamp": "02:26:25", "text": "我的天哪。"}, {"type": "subtitle", "time": 8789.11, "timestamp": "02:26:29", "text": "好吧，我只是个无名小卒。我就是一堵墙。请允许"}, {"type": "subtitle", "time": 8793.75, "timestamp": "02:26:33", "text": "我走。我的左腿已经做完了。"}, {"type": "subtitle", "time": 8797.429, "timestamp": "02:26:37", "text": "加强舒马的进攻。"}, {"type": "subtitle", "time": 8799.27, "timestamp": "02:26:39", "text": "哦，"}, {"type": "subtitle", "time": 8802.23, "timestamp": "02:26:42", "text": "是的。请求增援。"}, {"type": "subtitle", "time": 8803.99, "timestamp": "02:26:43", "text": "从技术上讲，我们拥有无限的资源。"}, {"type": "subtitle", "time": 8806.23, "timestamp": "02:26:46", "text": "加强。"}, {"type": "subtitle", "time": 8808.07, "timestamp": "02:26:48", "text": "是的。"}, {"type": "subtitle", "time": 8813.19, "timestamp": "02:26:53", "text": "坚持不懈，一个接一个。是的。"}, {"type": "subtitle", "time": 8815.19, "timestamp": "02:26:55", "text": "准备解放。"}, {"type": "subtitle", "time": 8817.67, "timestamp": "02:26:57", "text": "糟糕。它就在我身后，对吧？"}]
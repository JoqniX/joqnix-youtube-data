[{"type": "subtitle", "time": 18318.26, "timestamp": "05:05:18", "text": "等等，如果我……我为什么要去？"}, {"type": "subtitle", "time": 18321.35, "timestamp": "05:05:21", "text": "[音乐]"}, {"type": "subtitle", "time": 18329.03, "timestamp": "05:05:29", "text": "我想做最重要的事。"}, {"type": "subtitle", "time": 18330.628, "timestamp": "05:05:30", "text": "关于"}, {"type": "subtitle", "time": 18333.35, "timestamp": "05:05:33", "text": "创作音乐就是拥有自己的音乐"}, {"type": "subtitle", "time": 18334.868, "timestamp": "05:05:34", "text": "签名"}, {"type": "subtitle", "time": 18340.628, "timestamp": "05:05:40", "text": "声音"}, {"type": "subtitle", "time": 18342.708, "timestamp": "05:05:42", "text": "这可以是"}, {"type": "subtitle", "time": 18345.43, "timestamp": "05:05:45", "text": "就旋律而言"}, {"type": "subtitle", "time": 18350.07, "timestamp": "05:05:50", "text": "或者所有声音都像所有声音一样"}, {"type": "subtitle", "time": 18353.67, "timestamp": "05:05:53", "text": "一首强劲的歌曲，就像如果你是一位歌手，"}, {"type": "subtitle", "time": 18358.31, "timestamp": "05:05:58", "text": "你会有一个特别的、原创的版本。"}]
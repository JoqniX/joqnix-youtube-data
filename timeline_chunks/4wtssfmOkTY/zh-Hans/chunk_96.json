[{"type": "subtitle", "time": 5760.31, "timestamp": "01:36:00", "text": "我感觉只差一枪就能打中他了。为什么"}, {"type": "subtitle", "time": 5762.31, "timestamp": "01:36:02", "text": "我没看到吗？哦，那是干扰器。"}, {"type": "subtitle", "time": 5776.39, "timestamp": "01:36:16", "text": "我正在城里安装一台380。"}, {"type": "subtitle", "time": 5777.91, "timestamp": "01:36:17", "text": "我们面临的敌人太多了。"}, {"type": "subtitle", "time": 5780.229, "timestamp": "01:36:20", "text": "就那样冲进去。相同的。但"}, {"type": "subtitle", "time": 5783.189, "timestamp": "01:36:23", "text": "我要过去。好的。谢谢。"}, {"type": "subtitle", "time": 5784.47, "timestamp": "01:36:24", "text": "把它们摊开。把它们摊开。不"}, {"type": "subtitle", "time": 5786.95, "timestamp": "01:36:26", "text": "把他放在一个地方。"}, {"type": "subtitle", "time": 5789.669, "timestamp": "01:36:29", "text": "我显然没扔它。不，我是"}, {"type": "subtitle", "time": 5791.03, "timestamp": "01:36:31", "text": "我打算把我的炸弹扔在旁边"}, {"type": "subtitle", "time": 5802.87, "timestamp": "01:36:42", "text": "妈的。"}, {"type": "subtitle", "time": 5805.75, "timestamp": "01:36:45", "text": "我喜欢这辆火星探测车。"}, {"type": "subtitle", "time": 5807.109, "timestamp": "01:36:47", "text": "探测车。是的，这辆探测车真的"}, {"type": "subtitle", "time": 5811.35, "timestamp": "01:36:51", "text": "好的。他们实际上很喜欢制作"}, {"type": "subtitle", "time": 5813.669, "timestamp": "01:36:53", "text": "它没有杀我们，现在我只是"}, {"type": "subtitle", "time": 5815.189, "timestamp": "01:36:55", "text": "380号机就停在旁边"}, {"type": "subtitle", "time": 5816.79, "timestamp": "01:36:56", "text": "干扰器。"}]
[{"type": "subtitle", "time": 3488.549, "timestamp": "00:58:08", "text": "我们有点儿被这个问题搞糊涂了。"}, {"type": "subtitle", "time": 3492.63, "timestamp": "00:58:12", "text": "使命。没有“你们还好吗？”"}, {"type": "subtitle", "time": 3495.109, "timestamp": "00:58:15", "text": "是的，没问题。我们刚刚剪辑了一下。"}, {"type": "subtitle", "time": 3496.789, "timestamp": "00:58:16", "text": "摔倒了。没关系。不，不。我 我 我"}, {"type": "subtitle", "time": 3498.15, "timestamp": "00:58:18", "text": "不小心近战攻击了你。对不起。我"}, {"type": "subtitle", "time": 3501.51, "timestamp": "00:58:21", "text": "不小心近战攻击了你。我本意是"}, {"type": "subtitle", "time": 3503.67, "timestamp": "00:58:23", "text": "辅助装弹。不，不，我知道。我 我"}, {"type": "subtitle", "time": 3505.67, "timestamp": "00:58:25", "text": "把你蒸熟了。我以蒸锅回击了你。我"}, {"type": "subtitle", "time": 3507.589, "timestamp": "00:58:27", "text": "本来打算用辅助装弹的，"}, {"type": "subtitle", "time": 3511.03, "timestamp": "00:58:31", "text": "但我按错了。什么是"}, {"type": "subtitle", "time": 3513.19, "timestamp": "00:58:33", "text": "黄蜂发射器？"}, {"type": "subtitle", "time": 3515.51, "timestamp": "00:58:35", "text": "呃"}, {"type": "subtitle", "time": 3517.43, "timestamp": "00:58:37", "text": "小型导弹。"}, {"type": "subtitle", "time": 3522.15, "timestamp": "00:58:42", "text": "你只需要给他补充一些伤害就可以了。"}, {"type": "subtitle", "time": 3529.67, "timestamp": "00:58:49", "text": "男人。 20分钟。哦，敌人来了"}, {"type": "subtitle", "time": 3531.51, "timestamp": "00:58:51", "text": "西北。"}, {"type": "subtitle", "time": 3532.71, "timestamp": "00:58:52", "text": "那是什么东西？哦，他死了"}]
[{"type": "subtitle", "time": 2221.03, "timestamp": "00:37:01", "text": "我一直在玩什么？是的，我一直"}, {"type": "subtitle", "time": 2222.87, "timestamp": "00:37:02", "text": "玩耍"}, {"type": "subtitle", "time": 2225.99, "timestamp": "00:37:05", "text": "超级地球就是这样"}, {"type": "subtitle", "time": 2229.51, "timestamp": "00:37:09", "text": "我一直在地球上旅行。"}, {"type": "subtitle", "time": 2231.27, "timestamp": "00:37:11", "text": "哦，我们决定选他们。妈的。"}, {"type": "chat", "time": 2232.269, "timestamp": "00:37:12", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "who all are here"}, {"type": "subtitle", "time": 2233.67, "timestamp": "00:37:13", "text": "民主。我拿错枪了。全部"}, {"type": "chat", "time": 2235.067, "timestamp": "00:37:15", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "introduction"}, {"type": "subtitle", "time": 2236.39, "timestamp": "00:37:16", "text": "好了，维克，咱们把这扇门打开。"}, {"type": "subtitle", "time": 2238.79, "timestamp": "00:37:18", "text": "凭借友谊的力量。是的，我们"}, {"type": "subtitle", "time": 2240.23, "timestamp": "00:37:20", "text": "需要电力。你们的装备配置是什么？"}, {"type": "subtitle", "time": 2243.91, "timestamp": "00:37:23", "text": "男生有吗？嗯。你们都用什么装备配置？"}, {"type": "subtitle", "time": 2246.71, "timestamp": "00:37:26", "text": "有？我们在瞎胡闹。我有"}, {"type": "subtitle", "time": 2248.47, "timestamp": "00:37:28", "text": "死眼。我有一把杠杆式步枪"}, {"type": "subtitle", "time": 2250.87, "timestamp": "00:37:30", "text": "步枪。我们只是在瞎玩。"}, {"type": "subtitle", "time": 2252.95, "timestamp": "00:37:32", "text": "别担心。别担心"}, {"type": "subtitle", "time": 2254.71, "timestamp": "00:37:34", "text": "我们没有认真对待这件事。"}, {"type": "subtitle", "time": 2258.069, "timestamp": "00:37:38", "text": "我们正在放松休息。我们不是元宇宙。"}, {"type": "subtitle", "time": 2260.31, "timestamp": "00:37:40", "text": "它们有装备配置设置。哦，该死"}, {"type": "subtitle", "time": 2261.829, "timestamp": "00:37:41", "text": "是的。哦，是的。这里有一些附件。"}, {"type": "subtitle", "time": 2263.19, "timestamp": "00:37:43", "text": "你可以给枪支加装配件。"}, {"type": "subtitle", "time": 2266.63, "timestamp": "00:37:46", "text": "现在。什么？"}, {"type": "subtitle", "time": 2269.75, "timestamp": "00:37:49", "text": "在这里是做不到的，对吧？我的天啊。"}, {"type": "subtitle", "time": 2273.03, "timestamp": "00:37:53", "text": "是的。哇，他们添加了好多花哨的东西。"}, {"type": "subtitle", "time": 2276.23, "timestamp": "00:37:56", "text": "特征。简直要了我的命。"}, {"type": "subtitle", "time": 2279.91, "timestamp": "00:37:59", "text": "DSS现在有了一个新功能。哇，这里有一个"}]
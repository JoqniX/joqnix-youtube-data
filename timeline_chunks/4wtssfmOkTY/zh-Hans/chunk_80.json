[{"type": "subtitle", "time": 4801.91, "timestamp": "01:20:01", "text": "再次。"}, {"type": "subtitle", "time": 4803.75, "timestamp": "01:20:03", "text": "哦，是的。我得到了那份交易手册的提示"}, {"type": "subtitle", "time": 4805.51, "timestamp": "01:20:05", "text": "尽管。"}, {"type": "subtitle", "time": 4808.07, "timestamp": "01:20:08", "text": "我也是。什么是定义"}, {"type": "subtitle", "time": 4810.229, "timestamp": "01:20:10", "text": "疯狂？"}, {"type": "subtitle", "time": 4812.79, "timestamp": "01:20:12", "text": "这里的游戏帧数也会下降吗？"}, {"type": "subtitle", "time": 4814.47, "timestamp": "01:20:14", "text": "是的，"}, {"type": "subtitle", "time": 4817.51, "timestamp": "01:20:17", "text": "不多。我觉得直播帧率下降了。"}, {"type": "subtitle", "time": 4819.27, "timestamp": "01:20:19", "text": "再次。"}, {"type": "subtitle", "time": 4823.03, "timestamp": "01:20:23", "text": "我明白这个笑话了。我们走吧。"}, {"type": "subtitle", "time": 4826.87, "timestamp": "01:20:26", "text": "他们再次武装起来，非常危险。"}, {"type": "subtitle", "time": 4829.35, "timestamp": "01:20:29", "text": "让他们打吧。让他们面对现实"}, {"type": "subtitle", "time": 4832.149, "timestamp": "01:20:32", "text": "地狱潜行者拥有不可战胜的力量。"}, {"type": "subtitle", "time": 4856.87, "timestamp": "01:20:56", "text": "这把枪很适合用来控制人群，比如"}, {"type": "subtitle", "time": 4859.59, "timestamp": "01:20:59", "text": "较小的单元。"}]
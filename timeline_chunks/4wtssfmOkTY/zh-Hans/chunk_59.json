[{"type": "subtitle", "time": 3541.589, "timestamp": "00:59:01", "text": "什么是射击？我的天哪。那是……"}, {"type": "subtitle", "time": 3547.589, "timestamp": "00:59:07", "text": "我不在乎。我正在拍摄。"}, {"type": "subtitle", "time": 3551.589, "timestamp": "00:59:11", "text": "那是绿巨人。对，那是绿巨人。不是"}, {"type": "subtitle", "time": 3553.19, "timestamp": "00:59:13", "text": "不再是了。"}, {"type": "subtitle", "time": 3556.87, "timestamp": "00:59:16", "text": "不要掐我的脖子。拒绝。"}, {"type": "subtitle", "time": 3558.15, "timestamp": "00:59:18", "text": "过来，里克。过来这边。站立"}, {"type": "subtitle", "time": 3560.95, "timestamp": "00:59:20", "text": "这里。站在这里。糟糕。我会的"}, {"type": "subtitle", "time": 3562.63, "timestamp": "00:59:22", "text": "我会帮你进行辅助换弹，这样你"}, {"type": "subtitle", "time": 3577.67, "timestamp": "00:59:37", "text": "我犯了个大错误，试图使用这个。"}, {"type": "subtitle", "time": 3587.19, "timestamp": "00:59:47", "text": "好的，没什么危险的事情发生。"}, {"type": "subtitle", "time": 3589.589, "timestamp": "00:59:49", "text": "哦，火灾会被追踪。是的，就像"}, {"type": "subtitle", "time": 3592.549, "timestamp": "00:59:52", "text": "英伟达追踪技术的新宗教。"}, {"type": "subtitle", "time": 3593.829, "timestamp": "00:59:53", "text": "别担心，我要开枪了"}, {"type": "subtitle", "time": 3597.109, "timestamp": "00:59:57", "text": "船。击沉那艘船。"}]
[{"type": "subtitle", "time": 6785.75, "timestamp": "01:53:05", "text": "16."}, {"type": "subtitle", "time": 6786.79, "timestamp": "01:53:06", "text": "实际上，这是最多的"}, {"type": "subtitle", "time": 6789.189, "timestamp": "01:53:09", "text": "我迄今为止见过的常见样本"}, {"type": "subtitle", "time": 6790.95, "timestamp": "01:53:10", "text": "一次成功。"}, {"type": "subtitle", "time": 6799.27, "timestamp": "01:53:19", "text": "稀有很常见，常见很常见"}, {"type": "subtitle", "time": 6811.589, "timestamp": "01:53:31", "text": "哦，他是秃头吗？唉，我真希望我能得到"}, {"type": "subtitle", "time": 6820.229, "timestamp": "01:53:40", "text": "总有一天我会得到它们的。"}, {"type": "subtitle", "time": 6822.31, "timestamp": "01:53:42", "text": "什么？一天？"}, {"type": "subtitle", "time": 6830.55, "timestamp": "01:53:50", "text": "什么？超级样品。"}, {"type": "subtitle", "time": 6832.149, "timestamp": "01:53:52", "text": "极好的"}, {"type": "subtitle", "time": 6835.35, "timestamp": "01:53:55", "text": "紫色的那一个。"}, {"type": "subtitle", "time": 6838.149, "timestamp": "01:53:58", "text": "紫色样品。哦，紫色"}]
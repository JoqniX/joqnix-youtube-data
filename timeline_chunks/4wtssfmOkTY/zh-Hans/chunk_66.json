[{"type": "subtitle", "time": 3962.309, "timestamp": "01:06:02", "text": "一个做出敬礼动作的人。是的。"}, {"type": "subtitle", "time": 3965.829, "timestamp": "01:06:05", "text": "我的设置是随机大小，那是什么？"}, {"type": "subtitle", "time": 3975.43, "timestamp": "01:06:15", "text": "我的天啊。该死。"}, {"type": "subtitle", "time": 3978.15, "timestamp": "01:06:18", "text": "我喜欢那件银色披风。我买了"}, {"type": "subtitle", "time": 3982.23, "timestamp": "01:06:22", "text": "头盔简直太酷了，简直像神一样。我"}, {"type": "subtitle", "time": 3983.43, "timestamp": "01:06:23", "text": "感觉加载时间已经"}, {"type": "subtitle", "time": 3986.23, "timestamp": "01:06:26", "text": "增加展示武器的费用。"}, {"type": "subtitle", "time": 3989.349, "timestamp": "01:06:29", "text": "我的天哪。我喜欢这件武器。"}, {"type": "subtitle", "time": 3993.589, "timestamp": "01:06:33", "text": "主要护甲，宪法。"}, {"type": "subtitle", "time": 3997.67, "timestamp": "01:06:37", "text": "这只是个吻。"}, {"type": "subtitle", "time": 4000.63, "timestamp": "01:06:40", "text": "尽管反对"}, {"type": "subtitle", "time": 4003.109, "timestamp": "01:06:43", "text": "我们是不是……我们是不是……呃，原始地向上移动？"}, {"type": "subtitle", "time": 4004.71, "timestamp": "01:06:44", "text": "反对自动模块，还是我们要去"}, {"type": "subtitle", "time": 4007.51, "timestamp": "01:06:47", "text": "反对汽车主导地位？"}, {"type": "subtitle", "time": 4011.829, "timestamp": "01:06:51", "text": "你们，我是……第三名呢？"}, {"type": "subtitle", "time": 4013.67, "timestamp": "01:06:53", "text": "这里没有，他们已经走了。"}, {"type": "subtitle", "time": 4018.23, "timestamp": "01:06:58", "text": "片刻。疼痛真是太难受了。我们他们的"}]
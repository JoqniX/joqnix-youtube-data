[{"type": "subtitle", "time": 4201.75, "timestamp": "01:10:01", "text": "那是另一场战争中的主题"}, {"type": "subtitle", "time": 4203.59, "timestamp": "01:10:03", "text": "纽带。我不记得是哪一个了。"}, {"type": "subtitle", "time": 4206.55, "timestamp": "01:10:06", "text": "特伦。嗯，我觉得太多了。它是"}, {"type": "subtitle", "time": 4209.43, "timestamp": "01:10:09", "text": "旧的那个。探索者。"}, {"type": "subtitle", "time": 4212.47, "timestamp": "01:10:12", "text": "民主的归宿。民主"}, {"type": "subtitle", "time": 4215.11, "timestamp": "01:10:15", "text": "爆炸。弩。哦，是那个啊。"}, {"type": "subtitle", "time": 4216.47, "timestamp": "01:10:16", "text": "是的，我想要那把弩。是的。是的，"}, {"type": "subtitle", "time": 4218.47, "timestamp": "01:10:18", "text": "那个。找到了。它在……"}, {"type": "subtitle", "time": 4223.27, "timestamp": "01:10:23", "text": "那本书的第一页。仅15人。"}, {"type": "subtitle", "time": 4226.07, "timestamp": "01:10:26", "text": "这让我想起来。好的。战争的"}, {"type": "subtitle", "time": 4228.149, "timestamp": "01:10:28", "text": "我想买的是两个仆人"}, {"type": "subtitle", "time": 4230.39, "timestamp": "01:10:30", "text": "自由就像双面性"}, {"type": "subtitle", "time": 4233.91, "timestamp": "01:10:33", "text": "镰刀、牙齿和力量，因为"}, {"type": "subtitle", "time": 4236.55, "timestamp": "01:10:36", "text": "那些武器和一切都很好"}, {"type": "subtitle", "time": 4241.669, "timestamp": "01:10:41", "text": "化妆品。哦，就是这个……"}, {"type": "subtitle", "time": 4250.149, "timestamp": "01:10:50", "text": "哦，真是个天才。等等，这是什么？ 200"}, {"type": "subtitle", "time": 4252.07, "timestamp": "01:10:52", "text": "损害"}, {"type": "subtitle", "time": 4255.189, "timestamp": "01:10:55", "text": "热能武器。这有这个功能吗？"}, {"type": "subtitle", "time": 4258.709, "timestamp": "01:10:58", "text": "Talon战机弹药无限吗？"}]
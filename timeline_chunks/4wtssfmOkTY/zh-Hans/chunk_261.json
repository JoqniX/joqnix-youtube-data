[{"type": "subtitle", "time": 15661.99, "timestamp": "04:21:01", "text": "我当时就想，等等，我在想……"}, {"type": "subtitle", "time": 15664.229, "timestamp": "04:21:04", "text": "我们现在没法唱歌"}, {"type": "subtitle", "time": 15666.229, "timestamp": "04:21:06", "text": "实际上"}, {"type": "subtitle", "time": 15669.59, "timestamp": "04:21:09", "text": "昨天我们没能做到。"}, {"type": "subtitle", "time": 15672.07, "timestamp": "04:21:12", "text": "昨天我们没能妥善完成这项工作。"}, {"type": "subtitle", "time": 15676.87, "timestamp": "04:21:16", "text": "是的，我们不能那样做，所以我们会……"}, {"type": "subtitle", "time": 15678.71, "timestamp": "04:21:18", "text": "那首歌叫什么名字来着？让"}, {"type": "subtitle", "time": 15680.79, "timestamp": "04:21:20", "text": "我查一下。"}, {"type": "subtitle", "time": 15688.95, "timestamp": "04:21:28", "text": "嗯，这将是一次唱歌练习。"}, {"type": "subtitle", "time": 15694.63, "timestamp": "04:21:34", "text": "但我会试着去唱歌。"}, {"type": "subtitle", "time": 15700.149, "timestamp": "04:21:40", "text": "你知道，就像歌曲一样。所以，呃，但是在……"}, {"type": "subtitle", "time": 15702.55, "timestamp": "04:21:42", "text": "即将播出的节目"}, {"type": "subtitle", "time": 15707.189, "timestamp": "04:21:47", "text": "呃，我会尝试安装这个插件。"}, {"type": "subtitle", "time": 15710.07, "timestamp": "04:21:50", "text": "所以我可以像回声一样发出回声"}, {"type": "subtitle", "time": 15714.389, "timestamp": "04:21:54", "text": "我的声音也带有混响效果。"}, {"type": "subtitle", "time": 15719.429, "timestamp": "04:21:59", "text": "东西。不，我可以做到。所以，是的，会"}]
[{"type": "subtitle", "time": 2342.71, "timestamp": "00:39:02", "text": "我不需要空中爆破。感谢上帝"}, {"type": "subtitle", "time": 2345.43, "timestamp": "00:39:05", "text": "他们制造了这些东西。"}, {"type": "subtitle", "time": 2348.71, "timestamp": "00:39:08", "text": "一个怪胎。我还可以。感谢上帝。我得到了"}, {"type": "subtitle", "time": 2351.829, "timestamp": "00:39:11", "text": "他。我抓到他了。谢谢。"}, {"type": "subtitle", "time": 2355.43, "timestamp": "00:39:15", "text": "但再次感谢上帝，他们把它做得非常棒"}, {"type": "subtitle", "time": 2357.43, "timestamp": "00:39:17", "text": "虚弱的。"}, {"type": "subtitle", "time": 2358.87, "timestamp": "00:39:18", "text": "是的，他们把推进器做得有点小"}, {"type": "subtitle", "time": 2361.43, "timestamp": "00:39:21", "text": "更容易杀死。是的，用中号笔。"}, {"type": "subtitle", "time": 2363.349, "timestamp": "00:39:23", "text": "哦，对了，那是襟翼的阴影。"}, {"type": "subtitle", "time": 2366.55, "timestamp": "00:39:26", "text": "我明白了。我明白了，我"}, {"type": "subtitle", "time": 2368.23, "timestamp": "00:39:28", "text": "抓到他了。"}, {"type": "subtitle", "time": 2371.829, "timestamp": "00:39:31", "text": "我抓到他了。所以，我带来了……哦，不。和"}, {"type": "subtitle", "time": 2374.47, "timestamp": "00:39:34", "text": "长矛的力量。"}, {"type": "subtitle", "time": 2377.91, "timestamp": "00:39:37", "text": "好的。凭借着惊人的力量"}, {"type": "subtitle", "time": 2379.99, "timestamp": "00:39:39", "text": "友谊的力量。"}, {"type": "subtitle", "time": 2381.91, "timestamp": "00:39:41", "text": "太空激光的威力真是惊人！"}, {"type": "subtitle", "time": 2388.55, "timestamp": "00:39:48", "text": "太空激光。"}, {"type": "subtitle", "time": 2393.99, "timestamp": "00:39:53", "text": "太空激光炮。我想我已经准备好了。"}, {"type": "subtitle", "time": 2395.67, "timestamp": "00:39:55", "text": "我也不知道为什么他也在这里。他是"}, {"type": "subtitle", "time": 2396.95, "timestamp": "00:39:56", "text": "可能是我认识的人当中唯一一个。"}, {"type": "subtitle", "time": 2399.27, "timestamp": "00:39:59", "text": "三。"}]
[{"type": "subtitle", "time": 15782.229, "timestamp": "04:23:02", "text": "太好了，我今天心情超好。"}, {"type": "subtitle", "time": 15787.51, "timestamp": "04:23:07", "text": "所以，嗯，我不会演奏这首歌。"}, {"type": "subtitle", "time": 15790.55, "timestamp": "04:23:10", "text": "你们可能听不到，但是"}, {"type": "subtitle", "time": 15793.51, "timestamp": "04:23:13", "text": "只是我听得见，但我会尽量"}, {"type": "subtitle", "time": 15803.83, "timestamp": "04:23:23", "text": "我需要这首歌的歌词。"}, {"type": "subtitle", "time": 15811.03, "timestamp": "04:23:31", "text": "再见。"}, {"type": "subtitle", "time": 15813.03, "timestamp": "04:23:33", "text": "声明"}, {"type": "subtitle", "time": 15815.51, "timestamp": "04:23:35", "text": "宣言"}, {"type": "subtitle", "time": 15817.59, "timestamp": "04:23:37", "text": "歌词"}, {"type": "subtitle", "time": 15825.75, "timestamp": "04:23:45", "text": "等等，我说"}, {"type": "subtitle", "time": 15833.91, "timestamp": "04:23:53", "text": "它不是"}]
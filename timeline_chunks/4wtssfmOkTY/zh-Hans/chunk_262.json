[{"type": "subtitle", "time": 15725.51, "timestamp": "04:22:05", "text": "我们会做的。是的。"}, {"type": "subtitle", "time": 15727.11, "timestamp": "04:22:07", "text": "呃"}, {"type": "subtitle", "time": 15729.11, "timestamp": "04:22:09", "text": "他叫什么名字？他的歌名是什么？"}, {"type": "subtitle", "time": 15731.349, "timestamp": "04:22:11", "text": "唱歌"}, {"type": "subtitle", "time": 15743.349, "timestamp": "04:22:23", "text": "Mafu Mafu报道了此事。我忘了它的名字。"}, {"type": "subtitle", "time": 15745.51, "timestamp": "04:22:25", "text": "就像"}, {"type": "subtitle", "time": 15749.189, "timestamp": "04:22:29", "text": "啊，明白了。知道了。知道了。知道了。"}, {"type": "subtitle", "time": 15751.269, "timestamp": "04:22:31", "text": "等待。日语翻译是什么"}, {"type": "subtitle", "time": 15755.269, "timestamp": "04:22:35", "text": "这？告别宣言，呃，我试过了"}, {"type": "subtitle", "time": 15758.389, "timestamp": "04:22:38", "text": "唱歌。是的。告别宣言。"}, {"type": "subtitle", "time": 15762.06, "timestamp": "04:22:42", "text": "那是一首歌。毛绒玩具之歌。"}, {"type": "subtitle", "time": 15774.149, "timestamp": "04:22:54", "text": "怎么样？"}, {"type": "subtitle", "time": 15777.349, "timestamp": "04:22:57", "text": "昨天昏倒了吗？实际上，我睡着了"}]
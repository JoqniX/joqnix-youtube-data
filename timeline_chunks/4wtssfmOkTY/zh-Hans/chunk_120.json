[{"type": "subtitle", "time": 7202.07, "timestamp": "02:00:02", "text": "比如，它不像大多数那样。"}, {"type": "subtitle", "time": 7203.83, "timestamp": "02:00:03", "text": "那该怎么称呼呢？就像"}, {"type": "subtitle", "time": 7214.47, "timestamp": "02:00:14", "text": "加入我的船。我是长矛"}, {"type": "subtitle", "time": 7234.55, "timestamp": "02:00:34", "text": "我要加入你们。"}, {"type": "subtitle", "time": 7238.39, "timestamp": "02:00:38", "text": "已收到盟军驱逐舰坐标。"}, {"type": "subtitle", "time": 7248.149, "timestamp": "02:00:48", "text": "我没有，我没有演出。"}, {"type": "subtitle", "time": 7254.229, "timestamp": "02:00:54", "text": "我的上帝。没有你，你试试看能不能赢。"}, {"type": "subtitle", "time": 7257.27, "timestamp": "02:00:57", "text": "我的天哪，我的背！"}, {"type": "subtitle", "time": 7259.109, "timestamp": "02:00:59", "text": "安息。"}]
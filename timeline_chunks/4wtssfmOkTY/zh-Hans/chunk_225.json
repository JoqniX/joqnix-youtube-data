[{"type": "subtitle", "time": 13501.91, "timestamp": "03:45:01", "text": "天哪，这感觉真的太棒了。"}, {"type": "subtitle", "time": 13503.59, "timestamp": "03:45:03", "text": "我一直很喜欢和大家在一起。"}, {"type": "subtitle", "time": 13506.15, "timestamp": "03:45:06", "text": "在星空中交谈。是上帝。"}, {"type": "subtitle", "time": 13508.79, "timestamp": "03:45:08", "text": "大家都在变得很可爱"}, {"type": "subtitle", "time": 13512.15, "timestamp": "03:45:12", "text": "他们有自己的方式，你知道的"}, {"type": "subtitle", "time": 13515.189, "timestamp": "03:45:15", "text": "说来说去，却得不到任何结果。"}, {"type": "subtitle", "time": 13518.79, "timestamp": "03:45:18", "text": "通过做视频聊天和唱歌来认识彼此"}, {"type": "subtitle", "time": 13520.309, "timestamp": "03:45:20", "text": "一起"}, {"type": "subtitle", "time": 13523.83, "timestamp": "03:45:23", "text": "而且，而且，而且，还互相取笑"}, {"type": "subtitle", "time": 13526.71, "timestamp": "03:45:26", "text": "还有戏弄之类的，还有头"}, {"type": "subtitle", "time": 13529.59, "timestamp": "03:45:29", "text": "轻拍。是的。"}, {"type": "subtitle", "time": 13532.71, "timestamp": "03:45:32", "text": "[音乐]"}, {"type": "subtitle", "time": 13534.55, "timestamp": "03:45:34", "text": "嗯，"}, {"type": "subtitle", "time": 13538.229, "timestamp": "03:45:38", "text": "你好。现在是上午9点12分。是的。再见。我是"}, {"type": "subtitle", "time": 13542.229, "timestamp": "03:45:42", "text": "出去。我做事迟到了。哦，我的"}, {"type": "subtitle", "time": 13546.55, "timestamp": "03:45:46", "text": "上帝。是的。再见。所以，所以所以所以所以呃，搬家"}, {"type": "subtitle", "time": 13550.309, "timestamp": "03:45:50", "text": "进入游戏领域。呃，我们会是什么？"}, {"type": "subtitle", "time": 13554.63, "timestamp": "03:45:54", "text": "今天我们要做的事情是……我们将要写……"}, {"type": "subtitle", "time": 13557.429, "timestamp": "03:45:57", "text": "放下我们的东西"}]
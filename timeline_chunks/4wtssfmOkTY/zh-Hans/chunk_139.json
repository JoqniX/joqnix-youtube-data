[{"type": "subtitle", "time": 8342.56, "timestamp": "02:19:02", "text": "包裹已收到。"}, {"type": "subtitle", "time": 8355.11, "timestamp": "02:19:15", "text": "你如何爬上去？给我激光。它是"}, {"type": "subtitle", "time": 8360.309, "timestamp": "02:19:20", "text": "我的天啊。即使是很小的也能阻挡"}, {"type": "subtitle", "time": 8367.27, "timestamp": "02:19:27", "text": "即使是很小的也能变得隐形。"}, {"type": "subtitle", "time": 8375.509, "timestamp": "02:19:35", "text": "哇。呃，老兄，你们俩都死了。"}, {"type": "subtitle", "time": 8378.87, "timestamp": "02:19:38", "text": "我的意思是，是的。我认为你会"}, {"type": "subtitle", "time": 8381.509, "timestamp": "02:19:41", "text": "千万别低估这些人。最亮的"}, {"type": "subtitle", "time": 8384.549, "timestamp": "02:19:44", "text": "火车太疯狂了。"}, {"type": "subtitle", "time": 8386.79, "timestamp": "02:19:46", "text": "我的天啊。真的吗？"}, {"type": "subtitle", "time": 8389.59, "timestamp": "02:19:49", "text": "我感觉自己好像被这些事情困住了。"}, {"type": "subtitle", "time": 8392.469, "timestamp": "02:19:52", "text": "事物。明白了。"}, {"type": "subtitle", "time": 8394.55, "timestamp": "02:19:54", "text": "我建议给你传授一下策略。打"}, {"type": "subtitle", "time": 8397.91, "timestamp": "02:19:57", "text": "然后跑。简直就是"}, {"type": "subtitle", "time": 8399.75, "timestamp": "02:19:59", "text": "跑过去完成目标。不要这样做"}]
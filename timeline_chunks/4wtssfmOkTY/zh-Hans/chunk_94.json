[{"type": "subtitle", "time": 5646.31, "timestamp": "01:34:06", "text": "糟糕。这游戏的AI太离谱了。"}, {"type": "subtitle", "time": 5648.149, "timestamp": "01:34:08", "text": "实际上，"}, {"type": "subtitle", "time": 5649.91, "timestamp": "01:34:09", "text": "它没朝我所在的方向射击。很热"}, {"type": "subtitle", "time": 5652.629, "timestamp": "01:34:12", "text": "我原本要去的地方。"}, {"type": "subtitle", "time": 5656.629, "timestamp": "01:34:16", "text": "好的。你知道吗？呃，就像人工智能"}, {"type": "subtitle", "time": 5659.27, "timestamp": "01:34:19", "text": "他们很擅长击杀玩家，但是"}, {"type": "subtitle", "time": 5663.27, "timestamp": "01:34:23", "text": "你不。哦，这是一个城市或"}, {"type": "subtitle", "time": 5665.75, "timestamp": "01:34:25", "text": "进行城市作战。迷人的。"}, {"type": "subtitle", "time": 5667.51, "timestamp": "01:34:27", "text": "哦。"}, {"type": "subtitle", "time": 5669.83, "timestamp": "01:34:29", "text": "哦，那是一座城市。好的。是的，那是一座城市"}, {"type": "subtitle", "time": 5671.669, "timestamp": "01:34:31", "text": "区域。这就是它如此庞大的原因。我当时"}, {"type": "subtitle", "time": 5674.55, "timestamp": "01:34:34", "text": "想知道为什么会这样。"}, {"type": "subtitle", "time": 5677.189, "timestamp": "01:34:37", "text": "我知道为什么面积这么大。"}, {"type": "subtitle", "time": 5680.47, "timestamp": "01:34:40", "text": "这会很有趣。"}, {"type": "subtitle", "time": 5685.11, "timestamp": "01:34:45", "text": "哦，不。我的天哪。它内置干扰器"}, {"type": "subtitle", "time": 5689.27, "timestamp": "01:34:49", "text": "地点。是的。它装有干扰器。让我"}, {"type": "subtitle", "time": 5692.55, "timestamp": "01:34:52", "text": "我的火箭队被欺负了。是的，我"}, {"type": "subtitle", "time": 5696.87, "timestamp": "01:34:56", "text": "正中靶心。呃，重新调整。"}]
[{"type": "subtitle", "time": 3900.069, "timestamp": "01:05:00", "text": "困難。いいえ。今から中に入りましょう"}, {"type": "subtitle", "time": 3904.15, "timestamp": "01:05:04", "text": "1つ。私たちは近くにいるでしょう。"}, {"type": "subtitle", "time": 3911.029, "timestamp": "01:05:11", "text": "最高難易度に設定できます。私はできる"}, {"type": "subtitle", "time": 3914.39, "timestamp": "01:05:14", "text": "まあ、私が行ける限界は地獄だけだ"}, {"type": "subtitle", "time": 3917.43, "timestamp": "01:05:17", "text": "ダイビング。超地獄のダイブって感じじゃない。"}, {"type": "subtitle", "time": 3919.19, "timestamp": "01:05:19", "text": "ああ、それで十分だ。それはうまくいきますね。まだ"}, {"type": "subtitle", "time": 3926.63, "timestamp": "01:05:26", "text": "ああ、お金XP。"}, {"type": "subtitle", "time": 3928.71, "timestamp": "01:05:28", "text": "よし、冗談を言おうとしたんだけど"}, {"type": "chat", "time": 3930.243, "timestamp": "01:05:30", "author": "@scaramouche611", "avatar": "https://yt4.ggpht.com/gpl17RW8KxrqN5kkedVdeH0DagiGDZKnYGlwnQwIQNNQjzeTxJdFzEouNPC3L1t1lj8jUAxv7Q4=s64-c-k-c0x00ffffff-no-rj", "message": "hello there JoqniX dude"}, {"type": "subtitle", "time": 3931.43, "timestamp": "01:05:31", "text": "ストリーム上に表示すべきではない。何をしたの？"}, {"type": "subtitle", "time": 3934.71, "timestamp": "01:05:34", "text": "言う？何もない。チャットマン、言わないで"}, {"type": "subtitle", "time": 3937.029, "timestamp": "01:05:37", "text": "配信中に不適切な内容があった。イエス"}, {"type": "subtitle", "time": 3940.47, "timestamp": "01:05:40", "text": "キリスト。何てことだ。私は思い出した"}, {"type": "subtitle", "time": 3942.95, "timestamp": "01:05:42", "text": "何かがあって、私はほとんどすぐに"}, {"type": "subtitle", "time": 3945.27, "timestamp": "01:05:45", "text": "返答した。河野さん、ようこそ。ようこそ"}, {"type": "subtitle", "time": 3949.11, "timestamp": "01:05:49", "text": "ストリーム。いや、いや。それはコノです。"}, {"type": "subtitle", "time": 3951.349, "timestamp": "01:05:51", "text": "[音楽]"}, {"type": "subtitle", "time": 3953.349, "timestamp": "01:05:53", "text": "あれはフショですか？やあ、君。どうですか？"}, {"type": "subtitle", "time": 3955.109, "timestamp": "01:05:55", "text": "行くの？"}, {"type": "subtitle", "time": 3958.87, "timestamp": "01:05:58", "text": "はい。私が唯一の"}]
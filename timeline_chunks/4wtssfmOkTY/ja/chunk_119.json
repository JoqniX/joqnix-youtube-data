[{"type": "subtitle", "time": 7140.39, "timestamp": "01:59:00", "text": "そうすれば、私はそれを手に入れることができるだろう。確認してみます。"}, {"type": "subtitle", "time": 7143.91, "timestamp": "01:59:03", "text": "800が必要です。私も持っていません。"}, {"type": "subtitle", "time": 7145.669, "timestamp": "01:59:05", "text": "ああ、わかりました。どうでも。はい、あなたは"}, {"type": "subtitle", "time": 7150.87, "timestamp": "01:59:10", "text": "ホスト。先ほども言いました。忘れた。"}, {"type": "subtitle", "time": 7154.149, "timestamp": "01:59:14", "text": "確認してみます。わかった。"}, {"type": "subtitle", "time": 7155.75, "timestamp": "01:59:15", "text": "いいえ、わかりません。ゆっくりしてください。チェック"}, {"type": "subtitle", "time": 7162.149, "timestamp": "01:59:22", "text": "待って、スーパークレジットってどうやって手に入れるんだっけ？"}, {"type": "subtitle", "time": 7167.11, "timestamp": "01:59:27", "text": "もし私がもっと骨を仕上げたら？"}, {"type": "subtitle", "time": 7168.31, "timestamp": "01:59:28", "text": "[音楽]"}, {"type": "subtitle", "time": 7170.39, "timestamp": "01:59:30", "text": "よし、ジョン、"}, {"type": "subtitle", "time": 7174.07, "timestamp": "01:59:34", "text": "素晴らしいクレジット。 1つ目は、ゲームをプレイすることです。"}, {"type": "subtitle", "time": 7176.87, "timestamp": "01:59:36", "text": "過度に。スーパークレジットを獲得するか、"}, {"type": "subtitle", "time": 7179.589, "timestamp": "01:59:39", "text": "スーパークレジットを購入できます。ああ、"}, {"type": "subtitle", "time": 7183.35, "timestamp": "01:59:43", "text": "第三の方法。もちろん、"}, {"type": "subtitle", "time": 7186.229, "timestamp": "01:59:46", "text": "お金を使うことができます。ああ、私は超になれる"}, {"type": "subtitle", "time": 7188.709, "timestamp": "01:59:48", "text": "地獄のダイブ。"}, {"type": "subtitle", "time": 7191.75, "timestamp": "01:59:51", "text": "ほら、言った通りでしょ。忘れた。私はそう思った"}, {"type": "subtitle", "time": 7193.51, "timestamp": "01:59:53", "text": "レベル上限だったが、どうやら"}, {"type": "subtitle", "time": 7196.07, "timestamp": "01:59:56", "text": "そのミッションでそれをプレイしなければならない"}, {"type": "subtitle", "time": 7198.79, "timestamp": "01:59:58", "text": "それを解除するために。ええ、そう言いましたよ。"}]
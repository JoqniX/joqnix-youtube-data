[{"type": "subtitle", "time": 13083.75, "timestamp": "03:38:03", "text": "アカウント。そのアカウントもなくなっていたら、"}, {"type": "subtitle", "time": 13085.91, "timestamp": "03:38:05", "text": "3回目のログを取らなければならない"}, {"type": "subtitle", "time": 13087.75, "timestamp": "03:38:07", "text": "アカウント"}, {"type": "subtitle", "time": 13090.95, "timestamp": "03:38:10", "text": "または私の4番目のアカウントに参加してください。"}, {"type": "subtitle", "time": 13114.07, "timestamp": "03:38:34", "text": "私は離れるのが嫌いだ。なぜ？"}, {"type": "subtitle", "time": 13121.99, "timestamp": "03:38:41", "text": "最近追加した機能は何ですか？"}, {"type": "subtitle", "time": 13131.29, "timestamp": "03:38:51", "text": "誰が"}, {"type": "subtitle", "time": 13134.469, "timestamp": "03:38:54", "text": "[音楽]"}, {"type": "subtitle", "time": 13137.349, "timestamp": "03:38:57", "text": "はい。"}, {"type": "subtitle", "time": 13139.59, "timestamp": "03:38:59", "text": "ええと、あなたは、"}]
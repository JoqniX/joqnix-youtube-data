[{"type": "subtitle", "time": 61.27, "timestamp": "00:01:01", "text": "ハプニング。もうすぐ6月ですね"}, {"type": "subtitle", "time": 64.229, "timestamp": "00:01:04", "text": "明日。だから私は最終決定しなければならない"}, {"type": "subtitle", "time": 66.789, "timestamp": "00:01:06", "text": "6月最初の週のコラボレーション企画。私はまだ"}, {"type": "subtitle", "time": 69.91, "timestamp": "00:01:09", "text": "私はまだ持っている"}, {"type": "subtitle", "time": 72.71000000000001, "timestamp": "00:01:12", "text": "ええと、人を置かなければならない空っぽの日々"}, {"type": "subtitle", "time": 76.95, "timestamp": "00:01:16", "text": "例えば、金曜日、日曜日、水曜日など。それで"}, {"type": "subtitle", "time": 80.55, "timestamp": "00:01:20", "text": "そうしなければならない。ええ、私たちは"}, {"type": "subtitle", "time": 82.39, "timestamp": "00:01:22", "text": "大規模なコラボレーションも多数あります。"}, {"type": "subtitle", "time": 85.51, "timestamp": "00:01:25", "text": "初めてのコラボレーション。えっと、"}, {"type": "subtitle", "time": 88.55, "timestamp": "00:01:28", "text": "えーと、初めてのコラボレーションとか、全部。"}, {"type": "subtitle", "time": 90.39, "timestamp": "00:01:30", "text": "プライド月間おめでとうございます（少し早いですが）。プライド月間おめでとう"}, {"type": "subtitle", "time": 92.789, "timestamp": "00:01:32", "text": "あなたもね。"}, {"type": "subtitle", "time": 95.10900000000001, "timestamp": "00:01:35", "text": "えっと、今回は本当に。はい、"}, {"type": "subtitle", "time": 97.27000000000001, "timestamp": "00:01:37", "text": "この時間にしては、ずいぶん早いですね。サバット"}, {"type": "subtitle", "time": 99.50999999999999, "timestamp": "00:01:39", "text": "息子。はい。"}, {"type": "subtitle", "time": 101.429, "timestamp": "00:01:41", "text": "こんにちは。サムネイルを作成し、"}, {"type": "subtitle", "time": 104.069, "timestamp": "00:01:44", "text": "すべて。ちょっと待ってください"}, {"type": "subtitle", "time": 107.749, "timestamp": "00:01:47", "text": "すごく手短に。待って。"}, {"type": "subtitle", "time": 109.67, "timestamp": "00:01:49", "text": "えっと、"}, {"type": "subtitle", "time": 111.50999999999999, "timestamp": "00:01:51", "text": "JCのサムネイルを載せなければならない"}, {"type": "subtitle", "time": 113.83, "timestamp": "00:01:53", "text": "同じように。そして"}, {"type": "subtitle", "time": 116.95, "timestamp": "00:01:56", "text": "そうそう、"}]
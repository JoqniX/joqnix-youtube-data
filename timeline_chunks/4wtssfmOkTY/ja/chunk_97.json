[{"type": "subtitle", "time": 5824.39, "timestamp": "01:37:04", "text": "えっと、私のカバーが台無しになってるんです。"}, {"type": "subtitle", "time": 5844.31, "timestamp": "01:37:24", "text": "ああ、そこには火山があるんだ。それは"}, {"type": "subtitle", "time": 5846.87, "timestamp": "01:37:26", "text": "塔を破壊せよ。"}, {"type": "subtitle", "time": 5848.709, "timestamp": "01:37:28", "text": "押してみることにします。ああ、決して"}, {"type": "subtitle", "time": 5850.149, "timestamp": "01:37:30", "text": "心。サンプルは持っています。私はただ"}, {"type": "subtitle", "time": 5856.07, "timestamp": "01:37:36", "text": "あ、そういえば、あの塔、好きですか？"}, {"type": "subtitle", "time": 5858.31, "timestamp": "01:37:38", "text": "印をつけますか？"}, {"type": "subtitle", "time": 5865.27, "timestamp": "01:37:45", "text": "配信へようこ​​そ。ああ、よくあることだ"}, {"type": "subtitle", "time": 5874.39, "timestamp": "01:37:54", "text": "それは衝撃的な発言でしたね、ミスター。"}, {"type": "subtitle", "time": 5875.91, "timestamp": "01:37:55", "text": "バター。"}]
[{"type": "subtitle", "time": 15661.99, "timestamp": "04:21:01", "text": "私は「待って」と考えていました"}, {"type": "subtitle", "time": 15664.229, "timestamp": "04:21:04", "text": "今は歌うことはできない"}, {"type": "subtitle", "time": 15666.229, "timestamp": "04:21:06", "text": "実は"}, {"type": "subtitle", "time": 15669.59, "timestamp": "04:21:09", "text": "昨日はできなかった"}, {"type": "subtitle", "time": 15672.07, "timestamp": "04:21:12", "text": "昨日はうまくできなかったので"}, {"type": "subtitle", "time": 15676.87, "timestamp": "04:21:16", "text": "ええ、それはできませんので、私たちは"}, {"type": "subtitle", "time": 15678.71, "timestamp": "04:21:18", "text": "あの曲のタイトルは何でしたっけ？させて"}, {"type": "subtitle", "time": 15680.79, "timestamp": "04:21:20", "text": "それを調べます。"}, {"type": "subtitle", "time": 15688.95, "timestamp": "04:21:28", "text": "えっと、これは歌の練習になります"}, {"type": "subtitle", "time": 15694.63, "timestamp": "04:21:34", "text": "でも、歌おうとするんです"}, {"type": "subtitle", "time": 15700.149, "timestamp": "04:21:40", "text": "歌っぽい感じ、わかるでしょ？それで、でも"}, {"type": "subtitle", "time": 15702.55, "timestamp": "04:21:42", "text": "今後の配信予定"}, {"type": "subtitle", "time": 15707.189, "timestamp": "04:21:47", "text": "えっと、プラグインをインストールしてみます"}, {"type": "subtitle", "time": 15710.07, "timestamp": "04:21:50", "text": "だからエコーエコーを"}, {"type": "subtitle", "time": 15714.389, "timestamp": "04:21:54", "text": "そして私の声にリバーブがかかっていて、"}, {"type": "subtitle", "time": 15719.429, "timestamp": "04:21:59", "text": "もの。いいえ、それはできます。はい、そうです"}]
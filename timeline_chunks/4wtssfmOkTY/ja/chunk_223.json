[{"type": "subtitle", "time": 13382.87, "timestamp": "03:43:02", "text": "価値あるコンテンツクリエイターですが、私は理解できません"}, {"type": "subtitle", "time": 13385.99, "timestamp": "03:43:05", "text": "YouTube以外で収入を得る方法はありません。えっと"}, {"type": "subtitle", "time": 13389.59, "timestamp": "03:43:09", "text": "Twitch を除いて、"}, {"type": "subtitle", "time": 13392.71, "timestamp": "03:43:12", "text": "でも、私はそれを無料でやっています。"}, {"type": "subtitle", "time": 13407.91, "timestamp": "03:43:27", "text": "でも、まだわからない。"}, {"type": "subtitle", "time": 13411.75, "timestamp": "03:43:31", "text": "わからない。私は感じます"}, {"type": "subtitle", "time": 13413.75, "timestamp": "03:43:33", "text": "私は、人々に支払うべきだと思う。"}, {"type": "subtitle", "time": 13416.71, "timestamp": "03:43:36", "text": "ほら、一生懸命働いてる人たちとか"}, {"type": "subtitle", "time": 13419.349, "timestamp": "03:43:39", "text": "そして全て。わからない。それは"}, {"type": "subtitle", "time": 13421.51, "timestamp": "03:43:41", "text": "そんな気がする。"}, {"type": "subtitle", "time": 13424.55, "timestamp": "03:43:44", "text": "彼らはとても勤勉だから"}, {"type": "subtitle", "time": 13427.75, "timestamp": "03:43:47", "text": "好きな人のために最善を尽くす"}, {"type": "subtitle", "time": 13429.99, "timestamp": "03:43:49", "text": "そして全て。"}, {"type": "subtitle", "time": 13433.429, "timestamp": "03:43:53", "text": "でも、そうかもしれないけど、それは私だけかもしれない"}, {"type": "subtitle", "time": 13436.95, "timestamp": "03:43:56", "text": "それは私個人の意見です。もしかしたら私だけかもしれないけど"}]
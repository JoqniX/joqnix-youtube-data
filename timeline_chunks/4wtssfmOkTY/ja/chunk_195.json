[{"type": "subtitle", "time": 11701.83, "timestamp": "03:15:01", "text": "はい、そうです。えっと、今日は何をする予定ですか？"}, {"type": "subtitle", "time": 11703.83, "timestamp": "03:15:03", "text": "見てみましょう。"}, {"type": "subtitle", "time": 11712.71, "timestamp": "03:15:12", "text": "今日私は「うん」と思った。私たちが書く"}, {"type": "subtitle", "time": 11720.07, "timestamp": "03:15:20", "text": "はい。"}, {"type": "subtitle", "time": 11722.95, "timestamp": "03:15:22", "text": "まず、バグレポートを作成します。"}, {"type": "subtitle", "time": 11725.67, "timestamp": "03:15:25", "text": "二"}, {"type": "subtitle", "time": 11739.429, "timestamp": "03:15:39", "text": "ええと、まずは明白な報告書を書きます"}, {"type": "subtitle", "time": 11742.87, "timestamp": "03:15:42", "text": "2つ"}, {"type": "subtitle", "time": 11745.91, "timestamp": "03:15:45", "text": "２ 私たちは何を考えたか、あるいは考えたのか"}, {"type": "subtitle", "time": 11749.75, "timestamp": "03:15:49", "text": "また、私たちは"}, {"type": "subtitle", "time": 11757.349, "timestamp": "03:15:57", "text": "それから歌を歌います。"}, {"type": "subtitle", "time": 11759.51, "timestamp": "03:15:59", "text": "それから"}]
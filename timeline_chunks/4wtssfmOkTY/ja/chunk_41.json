[{"type": "subtitle", "time": 2460.23, "timestamp": "00:41:00", "text": "よし、これでいい。より良い。"}, {"type": "subtitle", "time": 2471.27, "timestamp": "00:41:11", "text": "戦ってからずいぶん経つ"}, {"type": "subtitle", "time": 2473.75, "timestamp": "00:41:13", "text": "ボット。私は忘れてしまう"}, {"type": "subtitle", "time": 2476.23, "timestamp": "00:41:16", "text": "身を隠せ。"}, {"type": "subtitle", "time": 2478.79, "timestamp": "00:41:18", "text": "ストライダーがいる。"}, {"type": "subtitle", "time": 2481.19, "timestamp": "00:41:21", "text": "また一人。いいえ、"}, {"type": "subtitle", "time": 2484.23, "timestamp": "00:41:24", "text": "ビクトリアの近く。"}, {"type": "subtitle", "time": 2486.309, "timestamp": "00:41:26", "text": "待て、あれはもう死んでるぞ。それは死んだ。その"}, {"type": "subtitle", "time": 2488.79, "timestamp": "00:41:28", "text": "死んだ。それは死んだ。ああ、あなたはただ"}, {"type": "subtitle", "time": 2491.75, "timestamp": "00:41:31", "text": "抽出中。うん。私たちはただ抽出しているだけです。"}, {"type": "subtitle", "time": 2494.23, "timestamp": "00:41:34", "text": "ああ、ちょっと待って、と思ったよ。私の"}, {"type": "subtitle", "time": 2497.03, "timestamp": "00:41:37", "text": "あの忌々しい宇宙レーザーが作動しなかった。うん、"}, {"type": "subtitle", "time": 2499.829, "timestamp": "00:41:39", "text": "ヴィックは偽物をつかんだ。"}, {"type": "subtitle", "time": 2503.99, "timestamp": "00:41:43", "text": "えっと、私たちは何をしているんですか？レーザ。なんてこった。私"}, {"type": "subtitle", "time": 2508.79, "timestamp": "00:41:48", "text": "めちゃくちゃだ。ご心配なく。"}, {"type": "subtitle", "time": 2511.67, "timestamp": "00:41:51", "text": "私はこの武器を使ったことがない。"}, {"type": "subtitle", "time": 2515.589, "timestamp": "00:41:55", "text": "私が知っているのは、スズメバチを飼い続けるということだけだ。の"}, {"type": "subtitle", "time": 2518.47, "timestamp": "00:41:58", "text": "スズメバチ。ああ、これは待って、わからない"}]
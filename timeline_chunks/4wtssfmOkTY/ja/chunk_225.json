[{"type": "subtitle", "time": 13501.91, "timestamp": "03:45:01", "text": "ああ、本当に素晴らしかった。"}, {"type": "subtitle", "time": 13503.59, "timestamp": "03:45:03", "text": "私は人々と過ごす時間を楽しんでいます"}, {"type": "subtitle", "time": 13506.15, "timestamp": "03:45:06", "text": "星空の下で語り合う。神である。"}, {"type": "subtitle", "time": 13508.79, "timestamp": "03:45:08", "text": "みんながカワイイカワイイになって"}, {"type": "subtitle", "time": 13512.15, "timestamp": "03:45:12", "text": "彼らなりのやり方で、"}, {"type": "subtitle", "time": 13515.189, "timestamp": "03:45:15", "text": "話して、話して、得られない"}, {"type": "subtitle", "time": 13518.79, "timestamp": "03:45:18", "text": "VCや歌を通して互いを知る"}, {"type": "subtitle", "time": 13520.309, "timestamp": "03:45:20", "text": "一緒に"}, {"type": "subtitle", "time": 13523.83, "timestamp": "03:45:23", "text": "そして、そして、そして、お互いをからかい合う"}, {"type": "subtitle", "time": 13526.71, "timestamp": "03:45:26", "text": "からかいとかそういうこと全部、頭"}, {"type": "subtitle", "time": 13529.59, "timestamp": "03:45:29", "text": "パッティング。はい。"}, {"type": "subtitle", "time": 13532.71, "timestamp": "03:45:32", "text": "[音楽]"}, {"type": "subtitle", "time": 13534.55, "timestamp": "03:45:34", "text": "えっと、"}, {"type": "subtitle", "time": 13538.229, "timestamp": "03:45:38", "text": "こんにちは。午前9時12分ですね。さよなら。私は"}, {"type": "subtitle", "time": 13542.229, "timestamp": "03:45:42", "text": "外。私はやるべきことに遅れてしまった。ああ、"}, {"type": "subtitle", "time": 13546.55, "timestamp": "03:45:46", "text": "神。うん。さよなら。だから、だから、だから、だから、えーと動く"}, {"type": "subtitle", "time": 13550.309, "timestamp": "03:45:50", "text": "ゲームシーンへ。えっと、私たちは"}, {"type": "subtitle", "time": 13554.63, "timestamp": "03:45:54", "text": "今日やることは、ええと、私たちは書くことです"}, {"type": "subtitle", "time": 13557.429, "timestamp": "03:45:57", "text": "荷物を下ろす"}]
[{"type": "subtitle", "time": 6067.189, "timestamp": "01:41:07", "text": "100. それは死ですか？ニース。それは"}, {"type": "subtitle", "time": 6072.55, "timestamp": "01:41:12", "text": "死の塔？どこですか？イエス・キリスト。"}, {"type": "subtitle", "time": 6075.59, "timestamp": "01:41:15", "text": "私の背後には援軍はいない。ああ、それは"}, {"type": "subtitle", "time": 6079.03, "timestamp": "01:41:19", "text": "地獄の爆弾。はい。私が持っていきます。あなたは欲しい"}, {"type": "subtitle", "time": 6081.99, "timestamp": "01:41:21", "text": "それを武装させる？はい。久しぶりですね。私は"}, {"type": "subtitle", "time": 6093.35, "timestamp": "01:41:33", "text": "ああ、いろいろあるよ。"}, {"type": "subtitle", "time": 6100.95, "timestamp": "01:41:40", "text": "ああ、しまった。"}, {"type": "subtitle", "time": 6103.91, "timestamp": "01:41:43", "text": "え、何？どうやってあの状況を生き延びたんだろう？"}, {"type": "subtitle", "time": 6107.03, "timestamp": "01:41:47", "text": "ああ、君はあれを生き延びられなかったんだね。ああ、しまった。"}, {"type": "subtitle", "time": 6109.51, "timestamp": "01:41:49", "text": "バター、戻ってきて。サンプルがあります。"}, {"type": "subtitle", "time": 6111.91, "timestamp": "01:41:51", "text": "援軍を要請する。"}, {"type": "subtitle", "time": 6115.99, "timestamp": "01:41:55", "text": "私はあなたをその方向に投げ飛ばしたのです。ありがとう。"}]
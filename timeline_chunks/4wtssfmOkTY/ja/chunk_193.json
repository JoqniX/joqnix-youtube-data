[{"type": "subtitle", "time": 11605.67, "timestamp": "03:13:25", "text": "ジョジョを観たことありますか？"}, {"type": "subtitle", "time": 11607.99, "timestamp": "03:13:27", "text": "ああ、ジョジョは見たことがないんです。する必要がある"}, {"type": "subtitle", "time": 11611.11, "timestamp": "03:13:31", "text": "ジョジョを見てください。本当に見たい"}, {"type": "subtitle", "time": 11614.07, "timestamp": "03:13:34", "text": "2話くらい見たよ。私"}, {"type": "subtitle", "time": 11617.67, "timestamp": "03:13:37", "text": "ジョジョを最後まで見たい"}, {"type": "subtitle", "time": 11620.07, "timestamp": "03:13:40", "text": "始まり。うん。"}, {"type": "subtitle", "time": 11622.63, "timestamp": "03:13:42", "text": "いいえ、みんな私を推薦してくれています"}, {"type": "subtitle", "time": 11631.2, "timestamp": "03:13:51", "text": "クリーン。"}, {"type": "subtitle", "time": 11632.95, "timestamp": "03:13:52", "text": "[音楽]"}, {"type": "subtitle", "time": 11635.99, "timestamp": "03:13:55", "text": "私はそれを見たい。"}]
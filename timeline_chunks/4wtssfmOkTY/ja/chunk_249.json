[{"type": "subtitle", "time": 14942.79, "timestamp": "04:09:02", "text": "何てことだ。ちょっと待ってください。行きましょう"}, {"type": "subtitle", "time": 14949.429, "timestamp": "04:09:09", "text": "ああ、このチャットの件を直さなきゃ。"}, {"type": "subtitle", "time": 14952.229, "timestamp": "04:09:12", "text": "右？だから、私がトークに切り替えるときはいつでも"}, {"type": "subtitle", "time": 14954.389, "timestamp": "04:09:14", "text": "シーン、チャットの小型版"}, {"type": "subtitle", "time": 14959.67, "timestamp": "04:09:19", "text": "表示されないはずですよね？はい。はい。"}, {"type": "subtitle", "time": 14972.55, "timestamp": "04:09:32", "text": "直してください。直してください。こんにちは。こんにちは。はい。バカ。"}]
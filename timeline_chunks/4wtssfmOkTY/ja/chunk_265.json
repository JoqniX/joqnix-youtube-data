[{"type": "subtitle", "time": 15900.63, "timestamp": "04:25:00", "text": "聞こえない？え、何？"}, {"type": "subtitle", "time": 15902.469, "timestamp": "04:25:02", "text": "はぁ？"}, {"type": "subtitle", "time": 15904.55, "timestamp": "04:25:04", "text": "ああ、"}, {"type": "subtitle", "time": 15906.309, "timestamp": "04:25:06", "text": "YouTubeさん、これを著作権侵害しないでください。ああ、"}, {"type": "subtitle", "time": 15908.71, "timestamp": "04:25:08", "text": "神。"}, {"type": "subtitle", "time": 15910.389, "timestamp": "04:25:10", "text": "いいえ、"}, {"type": "subtitle", "time": 15913.83, "timestamp": "04:25:13", "text": "下ろすのを忘れた"}, {"type": "subtitle", "time": 15916.71, "timestamp": "04:25:16", "text": "ヘッドホン。ああ、あなたはそれを"}, {"type": "subtitle", "time": 15931.99, "timestamp": "04:25:31", "text": "私はこう思った。「あのね、知ってる？」私はそれを妨害します"}, {"type": "subtitle", "time": 15935.91, "timestamp": "04:25:35", "text": "高いフルボリュームで、私は"}, {"type": "subtitle", "time": 15939.03, "timestamp": "04:25:39", "text": "それを頭に入れられるだろうか。しかし"}, {"type": "subtitle", "time": 15946.07, "timestamp": "04:25:46", "text": "もし私が"}, {"type": "subtitle", "time": 15948.229, "timestamp": "04:25:48", "text": "著作権で保護されています。"}, {"type": "subtitle", "time": 15957.75, "timestamp": "04:25:57", "text": "私はこの歌を覚えなければならない。はい。の"}]
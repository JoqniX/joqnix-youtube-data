[{"type": "subtitle", "time": 14341.189, "timestamp": "03:59:01", "text": "これ。ついに、"}, {"type": "subtitle", "time": 14343.75, "timestamp": "03:59:03", "text": "カラフルでありながら、目に優しいデザインにしてください。"}, {"type": "subtitle", "time": 14347.83, "timestamp": "03:59:07", "text": "はい、確かにやりました。バカヅキ、"}, {"type": "subtitle", "time": 14350.71, "timestamp": "03:59:10", "text": "何ヶ月かかりましたか"}, {"type": "subtitle", "time": 14355.11, "timestamp": "03:59:15", "text": "けれど？彼女は6月7日にこう述べた。それ"}, {"type": "subtitle", "time": 14358.15, "timestamp": "03:59:18", "text": "オーバーレイを作るのに12月までかかった"}, {"type": "subtitle", "time": 14369.83, "timestamp": "03:59:29", "text": "信じられない。信じられない"}, {"type": "subtitle", "time": 14372.389, "timestamp": "03:59:32", "text": "けれど。よし。"}, {"type": "subtitle", "time": 14377.189, "timestamp": "03:59:37", "text": "私がこれを作ったように"}, {"type": "subtitle", "time": 14381.83, "timestamp": "03:59:41", "text": "えーと、これ作ったよ、えーと、これ作ったよ、計画したんだ"}, {"type": "subtitle", "time": 14385.03, "timestamp": "03:59:45", "text": "6月、7月、8月のように"}, {"type": "subtitle", "time": 14386.63, "timestamp": "03:59:46", "text": "期間"}, {"type": "subtitle", "time": 14388.469, "timestamp": "03:59:48", "text": "そして"}, {"type": "subtitle", "time": 14391.75, "timestamp": "03:59:51", "text": "私は二度と何かをすることはなかった"}, {"type": "subtitle", "time": 14395.59, "timestamp": "03:59:55", "text": "まるでhのようだった"}]
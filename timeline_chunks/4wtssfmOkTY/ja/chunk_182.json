[{"type": "subtitle", "time": 10921.83, "timestamp": "03:02:01", "text": "夕食を食べた後、私は眠りました。"}, {"type": "subtitle", "time": 10925.03, "timestamp": "03:02:05", "text": "眠ってしまった"}, {"type": "subtitle", "time": 10928.71, "timestamp": "03:02:08", "text": "そして朝目覚めると、完全に完全に"}, {"type": "subtitle", "time": 10934.23, "timestamp": "03:02:14", "text": "元気いっぱいの元気で、私はまだ"}, {"type": "subtitle", "time": 10938.15, "timestamp": "03:02:18", "text": "だから私は、えっと"}, {"type": "subtitle", "time": 10941.429, "timestamp": "03:02:21", "text": "えっと、それが理由だと思う。"}, {"type": "subtitle", "time": 10944.95, "timestamp": "03:02:24", "text": "気分はとても良かった"}, {"type": "subtitle", "time": 10951.269, "timestamp": "03:02:31", "text": "レベル5。くそ、君は目標レベルだよ。"}, {"type": "subtitle", "time": 10953.11, "timestamp": "03:02:33", "text": "つまり、"}, {"type": "subtitle", "time": 10955.91, "timestamp": "03:02:35", "text": "それが目標かどうかわかりません"}, {"type": "subtitle", "time": 10959.51, "timestamp": "03:02:39", "text": "レベル。つまり、私はストリーミングに慣れている"}, {"type": "subtitle", "time": 10962.309, "timestamp": "03:02:42", "text": "12時間以上"}, {"type": "subtitle", "time": 10965.83, "timestamp": "03:02:45", "text": "でも私は12時間くらい配信しました"}, {"type": "subtitle", "time": 10968.07, "timestamp": "03:02:48", "text": "もっとだが"}, {"type": "subtitle", "time": 10971.11, "timestamp": "03:02:51", "text": "時々、あなたが話すと、"}, {"type": "subtitle", "time": 10975.269, "timestamp": "03:02:55", "text": "私はそれらのストリームについてほとんど話したことがありませんでした"}, {"type": "subtitle", "time": 10978.87, "timestamp": "03:02:58", "text": "しかし、あなたが積極的に正しいことを話すとき"}]
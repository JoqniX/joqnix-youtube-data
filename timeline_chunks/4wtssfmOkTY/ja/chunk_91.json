[{"type": "subtitle", "time": 5462.31, "timestamp": "01:31:02", "text": "なぜ私は彼らのことでパニックになっていたのだろう？"}, {"type": "subtitle", "time": 5464.39, "timestamp": "01:31:04", "text": "ねえ、見て。素晴らしいサンプルです。ハルクだった。"}, {"type": "subtitle", "time": 5467.189, "timestamp": "01:31:07", "text": "それは死んだ。ニース。"}, {"type": "subtitle", "time": 5470.87, "timestamp": "01:31:10", "text": "いろいろ耳にするよ。私は持っていません 私は行く"}, {"type": "subtitle", "time": 5488.73, "timestamp": "01:31:28", "text": "あなたはそれらを掴んだ。あなたはそうしたと思います。いいえ。"}, {"type": "subtitle", "time": 5491.11, "timestamp": "01:31:31", "text": "[音楽]"}, {"type": "subtitle", "time": 5495.59, "timestamp": "01:31:35", "text": "よし、いくつか手に入れる必要があるな。"}, {"type": "subtitle", "time": 5498.149, "timestamp": "01:31:38", "text": "なぜなら、私たちには彼らが必要だからだ。少なくとも私には"}, {"type": "subtitle", "time": 5501.59, "timestamp": "01:31:41", "text": "彼ら。ちくしょう。私も必要"}, {"type": "subtitle", "time": 5504.39, "timestamp": "01:31:44", "text": "待って、それを収集する人が一人いるの？"}, {"type": "subtitle", "time": 5507.03, "timestamp": "01:31:47", "text": "他の人にもわかるの？はい。はい。"}, {"type": "subtitle", "time": 5511.99, "timestamp": "01:31:51", "text": "はい。なぜ彼を精神的に追い詰める必要があったのですか？"}, {"type": "subtitle", "time": 5514.229, "timestamp": "01:31:54", "text": "何てことだ。私は得意ではありません"}, {"type": "subtitle", "time": 5517.83, "timestamp": "01:31:57", "text": "ガスライティング。ニース。何てことだ。ガスで"}, {"type": "subtitle", "time": 5519.669, "timestamp": "01:31:59", "text": "点灯。多くを語るのは難しい。私は"}]
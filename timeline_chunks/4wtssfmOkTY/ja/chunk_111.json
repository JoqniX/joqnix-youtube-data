[{"type": "subtitle", "time": 6662.149, "timestamp": "01:51:02", "text": "なんてこった。私は死んだ。私の死に方は「はい」でしたか。"}, {"type": "subtitle", "time": 6664.95, "timestamp": "01:51:04", "text": "私のミスです。いいえ。私は電話するべきでした"}, {"type": "subtitle", "time": 6667.189, "timestamp": "01:51:07", "text": "これらの服。"}, {"type": "subtitle", "time": 6673.189, "timestamp": "01:51:13", "text": "いや、それはむしろ地獄のダイブだ。おお"}, {"type": "subtitle", "time": 6689.59, "timestamp": "01:51:29", "text": "なぜ取り上げられないのか？"}, {"type": "subtitle", "time": 6694.229, "timestamp": "01:51:34", "text": "いいえ。これはバグですか？ああ、これでいいんだ。"}, {"type": "subtitle", "time": 6696.95, "timestamp": "01:51:36", "text": "ああ、8つありますよ。ああ、危うく見逃すところだった"}, {"type": "subtitle", "time": 6708.149, "timestamp": "01:51:48", "text": "よし、次は下だ。ああ、しまった。お尻は左。"}, {"type": "subtitle", "time": 6714.709, "timestamp": "01:51:54", "text": "間違った武器を装備してしまった。ああ、"}]
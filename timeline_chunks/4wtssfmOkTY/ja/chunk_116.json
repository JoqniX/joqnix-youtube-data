[{"type": "subtitle", "time": 6960.629, "timestamp": "01:56:00", "text": "ええ、困難について話していたんです。"}, {"type": "subtitle", "time": 6963.669, "timestamp": "01:56:03", "text": "大丈夫です。"}, {"type": "subtitle", "time": 6965.27, "timestamp": "01:56:05", "text": "これまでのところ、あなたのお気に入りの武器は何ですか？"}, {"type": "subtitle", "time": 6970.79, "timestamp": "01:56:10", "text": "道？かつら。ああ、虫の炎。"}, {"type": "subtitle", "time": 6973.75, "timestamp": "01:56:13", "text": "素晴らしい。彼らは素晴らしい。"}, {"type": "subtitle", "time": 6976.47, "timestamp": "01:56:16", "text": "ああ、うねうね動く虫のことですよね？そうねぇ。"}, {"type": "subtitle", "time": 6979.27, "timestamp": "01:56:19", "text": "メインの火炎放射器。"}, {"type": "subtitle", "time": 6981.35, "timestamp": "01:56:21", "text": "えっと"}, {"type": "subtitle", "time": 6984.95, "timestamp": "01:56:24", "text": "オートボットのために"}, {"type": "subtitle", "time": 6987.27, "timestamp": "01:56:27", "text": "私のお気に入りの武器は"}, {"type": "subtitle", "time": 6989.83, "timestamp": "01:56:29", "text": "スコッチャーは"}, {"type": "subtitle", "time": 6992.709, "timestamp": "01:56:32", "text": "彼らはかっこいい。"}, {"type": "subtitle", "time": 6996.07, "timestamp": "01:56:36", "text": "ああ、爆発物なら何でも。噴火者、"}, {"type": "subtitle", "time": 6998.31, "timestamp": "01:56:38", "text": "クロスボウ、何でもいい。爆発物なら何でも"}, {"type": "subtitle", "time": 7000.629, "timestamp": "01:56:40", "text": "良い"}, {"type": "subtitle", "time": 7004.39, "timestamp": "01:56:44", "text": "なるほど。それは知りませんでした。"}, {"type": "subtitle", "time": 7007.03, "timestamp": "01:56:47", "text": "両方"}, {"type": "subtitle", "time": 7009.75, "timestamp": "01:56:49", "text": "以前は焼夷弾をロードしていたが、"}, {"type": "subtitle", "time": 7012.87, "timestamp": "01:56:52", "text": "今、私は火炎放射器を持っています"}, {"type": "subtitle", "time": 7014.55, "timestamp": "01:56:54", "text": "ブレーカ"}, {"type": "subtitle", "time": 7017.51, "timestamp": "01:56:57", "text": "扇動的。"}]
[{"type": "subtitle", "time": 5521.35, "timestamp": "01:32:01", "text": "いいえと答えるつもりですが、皆さんが答えてください"}, {"type": "subtitle", "time": 5523.669, "timestamp": "01:32:03", "text": "素早く。"}, {"type": "subtitle", "time": 5526.47, "timestamp": "01:32:06", "text": "はい。わかった。レーザーで加工します"}, {"type": "subtitle", "time": 5530.55, "timestamp": "01:32:10", "text": "最後の1つ。どうぞ。すべて完了。すべて"}, {"type": "subtitle", "time": 5533.189, "timestamp": "01:32:13", "text": "君だよ、相棒。"}, {"type": "subtitle", "time": 5535.83, "timestamp": "01:32:15", "text": "一日中レーザーで処理してるね"}, {"type": "subtitle", "time": 5537.669, "timestamp": "01:32:17", "text": "あなたは見た。"}, {"type": "subtitle", "time": 5539.27, "timestamp": "01:32:19", "text": "面白いことに、私はもっと珍しいものを持っている"}, {"type": "subtitle", "time": 5542.31, "timestamp": "01:32:22", "text": "私が持っている一般的なサンプルよりも多くのサンプルがあります。"}, {"type": "subtitle", "time": 5544.149, "timestamp": "01:32:24", "text": "だから私はスーパーサンプルを保管しているのです"}, {"type": "subtitle", "time": 5546.87, "timestamp": "01:32:26", "text": "珍しいサンプルよりも、一般的なサンプルよりも。"}, {"type": "subtitle", "time": 5549.11, "timestamp": "01:32:29", "text": "何てことだ。一般的なサンプルは"}, {"type": "subtitle", "time": 5552.629, "timestamp": "01:32:32", "text": "それはもはや一般的ではない。いいえ。彗星は"}, {"type": "subtitle", "time": 5555.75, "timestamp": "01:32:35", "text": "サンプルを見つけることが最も困難になった。"}, {"type": "subtitle", "time": 5557.91, "timestamp": "01:32:37", "text": "ああ、これでいい。はい、私は"}, {"type": "subtitle", "time": 5565.03, "timestamp": "01:32:45", "text": "逃げてください。試食させてください"}, {"type": "subtitle", "time": 5568.149, "timestamp": "01:32:48", "text": "容器。さあ行こう。ああ、それはそれは"}, {"type": "subtitle", "time": 5570.07, "timestamp": "01:32:50", "text": "希少なサンプル。"}, {"type": "subtitle", "time": 5573.189, "timestamp": "01:32:53", "text": "私はここまでずっと歩いてきました。"}, {"type": "subtitle", "time": 5574.95, "timestamp": "01:32:54", "text": "さて、あと1つです。 1つあります"}, {"type": "subtitle", "time": 5576.709, "timestamp": "01:32:56", "text": "より強固な拠点。我々にはもう一つ基地がある。"}, {"type": "subtitle", "time": 5578.79, "timestamp": "01:32:58", "text": "ここは要塞だ。"}]
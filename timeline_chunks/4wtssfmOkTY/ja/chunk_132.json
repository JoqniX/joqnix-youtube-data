[{"type": "subtitle", "time": 7920.79, "timestamp": "02:12:00", "text": "ああ、なんてこった。"}, {"type": "subtitle", "time": 7923.589, "timestamp": "02:12:03", "text": "私は思う"}, {"type": "subtitle", "time": 7926.79, "timestamp": "02:12:06", "text": "私は彼がそう思うと思う"}, {"type": "subtitle", "time": 7945.91, "timestamp": "02:12:25", "text": "承認された。増援部隊が"}, {"type": "subtitle", "time": 7955.27, "timestamp": "02:12:35", "text": "なるほど、母鳥が見えますね。ああ、私は"}, {"type": "subtitle", "time": 7965.83, "timestamp": "02:12:45", "text": "人生。死なないよ、兄弟。"}, {"type": "subtitle", "time": 7968.79, "timestamp": "02:12:48", "text": "それはいいです。君ならできるよ。そして、"}, {"type": "subtitle", "time": 7970.55, "timestamp": "02:12:50", "text": "ラップトップ"}]
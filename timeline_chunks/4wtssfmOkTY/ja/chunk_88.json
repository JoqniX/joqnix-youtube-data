[{"type": "subtitle", "time": 5283.11, "timestamp": "01:28:03", "text": "キック。味方に撃たれた"}, {"type": "subtitle", "time": 5285.11, "timestamp": "01:28:05", "text": "チームメイト。"}, {"type": "subtitle", "time": 5287.83, "timestamp": "01:28:07", "text": "うん、ああ、私は彼らが"}, {"type": "subtitle", "time": 5294.07, "timestamp": "01:28:14", "text": "そんな感じ。それは起こるだろう。"}, {"type": "subtitle", "time": 5304.629, "timestamp": "01:28:24", "text": "ああ、歩行器が改良されたんだね。その"}, {"type": "subtitle", "time": 5308.55, "timestamp": "01:28:28", "text": "文字通り、今は8080だ。うん。誰かが"}, {"type": "subtitle", "time": 5312.79, "timestamp": "01:28:32", "text": "死ぬのか？わかった。はい。私は見ていなかったし、"}, {"type": "subtitle", "time": 5322.229, "timestamp": "01:28:42", "text": "シュート。"}, {"type": "subtitle", "time": 5331.43, "timestamp": "01:28:51", "text": "これは一体何だ？このミニは何ですか？"}, {"type": "subtitle", "time": 5333.75, "timestamp": "01:28:53", "text": "工場？ああ、しまった。"}, {"type": "subtitle", "time": 5335.99, "timestamp": "01:28:55", "text": "歩くときは周りを見渡すべきだ。私"}, {"type": "chat", "time": 5336.808, "timestamp": "01:28:56", "author": "@site36.official", "avatar": "https://yt4.ggpht.com/Oc0kgq4lSUaD-BoDbaDE3pXUquuz47c4Yh7kwPILHO2D70EQ5EnEgoGgTbb5gw993EEXRqCx_A=s64-c-k-c0x00ffffff-no-rj", "message": "I'm not going to lie, the lag and rendering is insanely low on the game."}]
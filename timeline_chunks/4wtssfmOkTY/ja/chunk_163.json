[{"type": "subtitle", "time": 9780.63, "timestamp": "02:43:00", "text": "ついにストリーミング配信して投稿しました。"}, {"type": "subtitle", "time": 9782.71, "timestamp": "02:43:02", "text": "だから、私が苦労しているのを見ることができます"}, {"type": "subtitle", "time": 9784.63, "timestamp": "02:43:04", "text": "英語と文法の間違い。それで"}, {"type": "subtitle", "time": 9788.309, "timestamp": "02:43:08", "text": "はい、可能です。ええ、私たちは"}, {"type": "subtitle", "time": 9791.11, "timestamp": "02:43:11", "text": "それは可能です。それから、他に何かありますか？私たちは"}, {"type": "subtitle", "time": 9794.15, "timestamp": "02:43:14", "text": "自動化する必要があるよね？"}, {"type": "subtitle", "time": 9797.83, "timestamp": "02:43:17", "text": "自動化システム。いくつか"}, {"type": "subtitle", "time": 9801.91, "timestamp": "02:43:21", "text": "新しいオーバーレイ。これは私たちが作ったものです。そして、"}, {"type": "subtitle", "time": 9805.429, "timestamp": "02:43:25", "text": "ええ、そして私たちは次のようなことに取り組めます"}, {"type": "subtitle", "time": 9809.67, "timestamp": "02:43:29", "text": "今日。そして、イエスと言うことも。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 9811.91, "timestamp": "02:43:31", "text": "それが計画だ。"}, {"type": "subtitle", "time": 9816.71, "timestamp": "02:43:36", "text": "えっと、5分前というか3分前くらいに"}, {"type": "subtitle", "time": 9818.71, "timestamp": "02:43:38", "text": "ちょうど作った"}, {"type": "subtitle", "time": 9822.79, "timestamp": "02:43:42", "text": "えーと、自動化された、なんて言うんだっけ"}, {"type": "subtitle", "time": 9825.99, "timestamp": "02:43:45", "text": "これ？えっと、このシーンに切り替えるたびに"}, {"type": "subtitle", "time": 9830.469, "timestamp": "02:43:50", "text": "YouTube のチャットは、えっと、"}, {"type": "subtitle", "time": 9832.87, "timestamp": "02:43:52", "text": "YouTubeストリーム、YouTubeストリーム"}, {"type": "subtitle", "time": 9835.99, "timestamp": "02:43:55", "text": "そう、だから私がYouTube配信をしているとき"}, {"type": "subtitle", "time": 9839.349, "timestamp": "02:43:59", "text": "私がやっているときにコメントがここにあります"}]
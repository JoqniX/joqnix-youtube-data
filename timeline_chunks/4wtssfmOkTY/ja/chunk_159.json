[{"type": "subtitle", "time": 9545.99, "timestamp": "02:39:05", "text": "はい、はい。えーと、今日の配信は、"}, {"type": "subtitle", "time": 9548.23, "timestamp": "02:39:08", "text": "昨日は音楽をやらなかったから"}, {"type": "subtitle", "time": 9552.55, "timestamp": "02:39:12", "text": "もの。えーと、今日は音楽をやります"}, {"type": "subtitle", "time": 9554.79, "timestamp": "02:39:14", "text": "もの。音楽関連のこと、つまり歌のこと"}, {"type": "subtitle", "time": 9557.429, "timestamp": "02:39:17", "text": "実践。私たちは一曲覚えてみよう"}, {"type": "subtitle", "time": 9560.71, "timestamp": "02:39:20", "text": "今日も、そして"}, {"type": "subtitle", "time": 9563.67, "timestamp": "02:39:23", "text": "えーと歌の練習をして、それから私たちは"}, {"type": "subtitle", "time": 9567.03, "timestamp": "02:39:27", "text": "BRB画面のオーバーレイを作成し、"}, {"type": "subtitle", "time": 9570.79, "timestamp": "02:39:30", "text": "もの。はい、"}, {"type": "subtitle", "time": 9574.23, "timestamp": "02:39:34", "text": "しかし、私はあることを思いついた。ええと、"}, {"type": "subtitle", "time": 9582.389, "timestamp": "02:39:42", "text": "BBはやらない方がいいと思うけど、"}, {"type": "subtitle", "time": 9589.91, "timestamp": "02:39:49", "text": "おはよう。"}, {"type": "subtitle", "time": 9593.27, "timestamp": "02:39:53", "text": "あなたがこれをストリーミング配信しているのを見て驚きました"}, {"type": "subtitle", "time": 9595.51, "timestamp": "02:39:55", "text": "時間。ええ、普通ならそうするはずなんですが、今は8時です"}, {"type": "subtitle", "time": 9597.67, "timestamp": "02:39:57", "text": "午前中ですよね？私は始めるはずだった"}]
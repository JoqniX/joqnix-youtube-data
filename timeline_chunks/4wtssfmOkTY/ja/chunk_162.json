[{"type": "subtitle", "time": 9720.469, "timestamp": "02:42:00", "text": "私は「えっ？」って感じでした。"}, {"type": "subtitle", "time": 9723.27, "timestamp": "02:42:03", "text": "はぁ？ OBSは何回クラッシュしましたか？"}, {"type": "subtitle", "time": 9724.46, "timestamp": "02:42:04", "text": "昨日？"}, {"type": "subtitle", "time": 9725.67, "timestamp": "02:42:05", "text": "[音楽]"}, {"type": "subtitle", "time": 9729.59, "timestamp": "02:42:09", "text": "これはNDIの問題です。何てことだ。だから、"}, {"type": "subtitle", "time": 9732.87, "timestamp": "02:42:12", "text": "何"}, {"type": "subtitle", "time": 9735.99, "timestamp": "02:42:15", "text": "代わりに今日は"}, {"type": "subtitle", "time": 9739.96, "timestamp": "02:42:19", "text": "まず最初にこれを書きます"}, {"type": "subtitle", "time": 9741.99, "timestamp": "02:42:21", "text": "[音楽]"}, {"type": "subtitle", "time": 9746.55, "timestamp": "02:42:26", "text": "えーと、まず最初に、私たちは、えーと、私たちは"}, {"type": "subtitle", "time": 9749.51, "timestamp": "02:42:29", "text": "まず最初にこれを書きます"}, {"type": "subtitle", "time": 9753.11, "timestamp": "02:42:33", "text": "私が報告したバグレポート"}, {"type": "subtitle", "time": 9757.03, "timestamp": "02:42:37", "text": "3ヶ月前にやるべきだった。"}, {"type": "subtitle", "time": 9759.59, "timestamp": "02:42:39", "text": "でも、先延ばしにするためにやったわけじゃない。"}, {"type": "subtitle", "time": 9762.07, "timestamp": "02:42:42", "text": "配信でやろう。私たちは書きます"}, {"type": "subtitle", "time": 9765.51, "timestamp": "02:42:45", "text": "明らかなバグ報告"}, {"type": "subtitle", "time": 9768.71, "timestamp": "02:42:48", "text": "ええと、NDI 用です。私は、"}, {"type": "subtitle", "time": 9773.51, "timestamp": "02:42:53", "text": "私にとっての状況の問題は、私は"}, {"type": "subtitle", "time": 9776.95, "timestamp": "02:42:56", "text": "NDIに直面している。私はそれを書きます"}]
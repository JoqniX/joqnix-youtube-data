[{"type": "subtitle", "time": 2761.91, "timestamp": "00:46:01", "text": "つまり、イカの戦いは終わったということだ"}, {"type": "subtitle", "time": 2765.19, "timestamp": "00:46:05", "text": "イカを排除する。その通り。待って、"}, {"type": "subtitle", "time": 2766.71, "timestamp": "00:46:06", "text": "本当に？"}, {"type": "subtitle", "time": 2769.91, "timestamp": "00:46:09", "text": "うん。はい。ああ、しまった。 pingするたびに"}, {"type": "subtitle", "time": 2771.67, "timestamp": "00:46:11", "text": "彼らは、こちらではイカだと言っています。"}, {"type": "subtitle", "time": 2775.109, "timestamp": "00:46:15", "text": "イカ。そこでイカを手に入れた。つまり、ミームは"}, {"type": "subtitle", "time": 2779.51, "timestamp": "00:46:19", "text": "f はイカのフライは民主的か、"}, {"type": "subtitle", "time": 2783.109, "timestamp": "00:46:23", "text": "あるいは、反逆だと思う。そうは思わない。"}, {"type": "subtitle", "time": 2784.87, "timestamp": "00:46:24", "text": "それはまさにそのようなものだった。うん"}, {"type": "subtitle", "time": 2786.39, "timestamp": "00:46:26", "text": "裏切り者"}, {"type": "subtitle", "time": 2788.71, "timestamp": "00:46:28", "text": "私たちの家"}, {"type": "subtitle", "time": 2790.87, "timestamp": "00:46:30", "text": "繁栄。"}, {"type": "subtitle", "time": 2793.829, "timestamp": "00:46:33", "text": "ああ、私は生きているって素晴らしい。やあ。始めよう"}, {"type": "subtitle", "time": 2796.309, "timestamp": "00:46:36", "text": "搾取型民主主義へと向かっている。おお"}, {"type": "subtitle", "time": 2799.19, "timestamp": "00:46:39", "text": "なぜ自分がここにいるのか、私にはわからない。"}, {"type": "subtitle", "time": 2801.91, "timestamp": "00:46:41", "text": "私は抽出作業に参加していました。"}, {"type": "subtitle", "time": 2804.63, "timestamp": "00:46:44", "text": "では、それを実行してみましょう。いいえ。しかし自由は"}, {"type": "subtitle", "time": 2817.27, "timestamp": "00:46:57", "text": "見覚えがありますか？"}, {"type": "subtitle", "time": 2819.51, "timestamp": "00:46:59", "text": "このような光景は世界中で起こっている"}]
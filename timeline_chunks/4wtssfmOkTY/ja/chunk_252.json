[{"type": "subtitle", "time": 15130.389, "timestamp": "04:12:10", "text": "どの父親ですか？私は知らない、私は知らない"}, {"type": "subtitle", "time": 15134.55, "timestamp": "04:12:14", "text": "自分が何をしているのか、自分自身に問いかけます。私はただやっているだけです"}, {"type": "subtitle", "time": 15137.83, "timestamp": "04:12:17", "text": "いくつか好きなものがあります。それは何と呼ばれますか？"}, {"type": "subtitle", "time": 15141.51, "timestamp": "04:12:21", "text": "膝を曲げたり、曲げたり、"}, {"type": "subtitle", "time": 15145.91, "timestamp": "04:12:25", "text": "立って、寄りかかって触れようとする"}, {"type": "subtitle", "time": 15150.15, "timestamp": "04:12:30", "text": "私の首。そういった些細なことすべて。私"}, {"type": "subtitle", "time": 15151.99, "timestamp": "04:12:31", "text": "わからない。"}, {"type": "subtitle", "time": 15156.309, "timestamp": "04:12:36", "text": "ほかに何か？ペットのようなペット"}, {"type": "subtitle", "time": 15164.79, "timestamp": "04:12:44", "text": "一つずつやらなければならないように"}, {"type": "subtitle", "time": 15167.91, "timestamp": "04:12:47", "text": "まず首の運動をしなければならない"}, {"type": "subtitle", "time": 15172.229, "timestamp": "04:12:52", "text": "そして腕の運動をする"}, {"type": "subtitle", "time": 15175.429, "timestamp": "04:12:55", "text": "正しいやり方がわからない"}, {"type": "subtitle", "time": 15179.189, "timestamp": "04:12:59", "text": "したくないのですが、正しいやり方がわかりません"}]
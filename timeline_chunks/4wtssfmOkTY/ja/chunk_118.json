[{"type": "subtitle", "time": 7093.109, "timestamp": "01:58:13", "text": "何？私は噴火を運んでいます。"}, {"type": "subtitle", "time": 7095.589, "timestamp": "01:58:15", "text": "そして特別企画として、私は"}, {"type": "subtitle", "time": 7097.14, "timestamp": "01:58:17", "text": "尖点。"}, {"type": "subtitle", "time": 7098.39, "timestamp": "01:58:18", "text": "[音楽]"}, {"type": "subtitle", "time": 7110.55, "timestamp": "01:58:30", "text": "ところで、私たちは一体何を目指しているのでしょうか？"}, {"type": "subtitle", "time": 7115.03, "timestamp": "01:58:35", "text": "虫のことですよね？見てみましょう。"}, {"type": "subtitle", "time": 7118.31, "timestamp": "01:58:38", "text": "ああ、シャ、ホストしてくれないか、そうすれば見せられるから"}, {"type": "subtitle", "time": 7121.589, "timestamp": "01:58:41", "text": "それは何ですか？ああ、もちろんです。"}, {"type": "subtitle", "time": 7123.43, "timestamp": "01:58:43", "text": "超地獄のダイブ。大男の地獄"}, {"type": "subtitle", "time": 7124.709, "timestamp": "01:58:44", "text": "ダイビング。あなたはもっと高いレベルを持っていると思います"}, {"type": "subtitle", "time": 7126.79, "timestamp": "01:58:46", "text": "私よりも。"}, {"type": "subtitle", "time": 7128.629, "timestamp": "01:58:48", "text": "どういう意味ですか？私は地獄を持っていません"}, {"type": "subtitle", "time": 7133.35, "timestamp": "01:58:53", "text": "ダイビング。私はスーパーヘルダイブを持っていません。"}, {"type": "subtitle", "time": 7135.83, "timestamp": "01:58:55", "text": "私はヘルダイブしか持っていません。"}]
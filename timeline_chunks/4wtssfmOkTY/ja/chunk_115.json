[{"type": "subtitle", "time": 6902.07, "timestamp": "01:55:02", "text": "こんにちは。こんばんは。"}, {"type": "subtitle", "time": 6904.39, "timestamp": "01:55:04", "text": "あなたたちにはビジネスはないと思います。"}, {"type": "subtitle", "time": 6907.189, "timestamp": "01:55:07", "text": "ちょっと待ってください。"}, {"type": "subtitle", "time": 6909.99, "timestamp": "01:55:09", "text": "それは私の"}, {"type": "subtitle", "time": 6912.87, "timestamp": "01:55:12", "text": "神。本当に？"}, {"type": "subtitle", "time": 6923.83, "timestamp": "01:55:23", "text": "終了させたいのですか？さあ、さあ"}, {"type": "subtitle", "time": 6929.51, "timestamp": "01:55:29", "text": "恐怖を見せつけよう。知っている"}, {"type": "subtitle", "time": 6933.109, "timestamp": "01:55:33", "text": "恐ろしい光景だ。わかった、"}, {"type": "subtitle", "time": 6936.629, "timestamp": "01:55:36", "text": "超地獄のdivを持つ人が必要です。"}, {"type": "subtitle", "time": 6940.31, "timestamp": "01:55:40", "text": "「私たち」ってどういう意味ですか？存在するものは私だけだ。"}, {"type": "subtitle", "time": 6944.47, "timestamp": "01:55:44", "text": "はい、シューマさん、あなたは、ええと、スーパー"}, {"type": "subtitle", "time": 6946.55, "timestamp": "01:55:46", "text": "地獄。あ、ごめんなさい。私はこれと話していました"}, {"type": "subtitle", "time": 6948.39, "timestamp": "01:55:48", "text": "「私たちはスーパーを救った」という女性"}, {"type": "subtitle", "time": 6950.709, "timestamp": "01:55:50", "text": "地球。\""}, {"type": "subtitle", "time": 6952.709, "timestamp": "01:55:52", "text": "わかった、気にしないで。私は「ああ、そうだね」と思った。"}, {"type": "subtitle", "time": 6954.79, "timestamp": "01:55:54", "text": "理にかなっている、なぜなら私は超地獄ではないから"}, {"type": "subtitle", "time": 6956.55, "timestamp": "01:55:56", "text": "「飛び込む」彼は私が話していたのは"}, {"type": "subtitle", "time": 6958.629, "timestamp": "01:55:58", "text": "地獄のダイブ。"}]
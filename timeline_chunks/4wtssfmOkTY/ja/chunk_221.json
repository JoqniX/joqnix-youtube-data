[{"type": "subtitle", "time": 13261.83, "timestamp": "03:41:01", "text": "なぜなら主に権限が大きな"}, {"type": "subtitle", "time": 13266.309, "timestamp": "03:41:06", "text": "特定の権限などの部分と"}, {"type": "subtitle", "time": 13271.51, "timestamp": "03:41:11", "text": "カテゴリー別に見ると、メイン"}, {"type": "subtitle", "time": 13275.349, "timestamp": "03:41:15", "text": "権限などすべてです。"}, {"type": "subtitle", "time": 13276.95, "timestamp": "03:41:16", "text": "虚栄心。"}, {"type": "subtitle", "time": 13278.79, "timestamp": "03:41:18", "text": "それで、私もゆっくりと"}, {"type": "subtitle", "time": 13282.87, "timestamp": "03:41:22", "text": "年。うん、"}, {"type": "subtitle", "time": 13286.79, "timestamp": "03:41:26", "text": "その時のことを思い出すと、私は"}, {"type": "subtitle", "time": 13291.03, "timestamp": "03:41:31", "text": "実際に終わらせるのに苦労しています"}, {"type": "subtitle", "time": 13293.99, "timestamp": "03:41:33", "text": "サーバー全体に関するもの。まるで私が"}, {"type": "subtitle", "time": 13296.63, "timestamp": "03:41:36", "text": "最後まで戦い抜いた"}, {"type": "subtitle", "time": 13299.91, "timestamp": "03:41:39", "text": "何て言うんだっけ？あなたは何を"}, {"type": "subtitle", "time": 13303.51, "timestamp": "03:41:43", "text": "それって何？ Starscapeサーバー。だって私は"}, {"type": "subtitle", "time": 13307.11, "timestamp": "03:41:47", "text": "私は自分の配信をしていた。私は自分の荷物を持っていた。私 私"}, {"type": "subtitle", "time": 13311.03, "timestamp": "03:41:51", "text": "忙しかったので、いや、私は"}, {"type": "subtitle", "time": 13313.67, "timestamp": "03:41:53", "text": "ズチ、あと一日だけ時間をください。"}, {"type": "subtitle", "time": 13317.269, "timestamp": "03:41:57", "text": "仕上げてください、もうすぐ完成します、えーと"}, {"type": "subtitle", "time": 13319.75, "timestamp": "03:41:59", "text": "ほぼ完了したら公開できます"}]
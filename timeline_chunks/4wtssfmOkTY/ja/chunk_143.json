[{"type": "subtitle", "time": 8594.95, "timestamp": "02:23:14", "text": "音も違う。何"}, {"type": "subtitle", "time": 8597.28, "timestamp": "02:23:17", "text": "変人？"}, {"type": "subtitle", "time": 8603.27, "timestamp": "02:23:23", "text": "何てことだ。なぜ彼らはパトロールしているのですか？"}, {"type": "subtitle", "time": 8606.55, "timestamp": "02:23:26", "text": "ああ、よかった、彼らが去ってくれて。"}, {"type": "subtitle", "time": 8614.08, "timestamp": "02:23:34", "text": "これはもはやホラーゲームだ。"}, {"type": "subtitle", "time": 8615.19, "timestamp": "02:23:35", "text": "[拍手]"}, {"type": "subtitle", "time": 8617.75, "timestamp": "02:23:37", "text": "ああ、くそ。"}]
[{"type": "subtitle", "time": 12540.71, "timestamp": "03:29:00", "text": "uh がツイートしました"}, {"type": "subtitle", "time": 12544.79, "timestamp": "03:29:04", "text": "ズチとセレスティアのデビュー配信"}, {"type": "subtitle", "time": 12547.429, "timestamp": "03:29:07", "text": "私がリツイートしてコメントした場所で、"}, {"type": "subtitle", "time": 12551.429, "timestamp": "03:29:11", "text": "ズチを見てすごくショックを受けた"}, {"type": "subtitle", "time": 12554.229, "timestamp": "03:29:14", "text": "返事。私は「ああ、なんてことだ、ああ"}, {"type": "subtitle", "time": 12563.349, "timestamp": "03:29:23", "text": "かわいいバカヘビのツイートといいね"}, {"type": "subtitle", "time": 12565.83, "timestamp": "03:29:25", "text": "ストリーム配信で、私のコメントに「いいね」をしてくれた。私はこう思った"}, {"type": "subtitle", "time": 12569.269, "timestamp": "03:29:29", "text": "さあ行こう。それから、えーと、みんな"}, {"type": "subtitle", "time": 12571.349, "timestamp": "03:29:31", "text": "インドのユーチューバーはみんなこんな感じだった"}, {"type": "subtitle", "time": 12573.19, "timestamp": "03:29:33", "text": "すごく興奮してる"}, {"type": "subtitle", "time": 12576.79, "timestamp": "03:29:36", "text": "そして彼らはそれを宣伝していて"}, {"type": "subtitle", "time": 12579.349, "timestamp": "03:29:39", "text": "はい"}, {"type": "subtitle", "time": 12585.11, "timestamp": "03:29:45", "text": "残念ながら、私は眠ってしまいました。"}, {"type": "subtitle", "time": 12588.469, "timestamp": "03:29:48", "text": "Zuchi ストリームは実際には Debbie ストリームです。"}, {"type": "subtitle", "time": 12591.67, "timestamp": "03:29:51", "text": "だから私はセレスティアの配信を見に行ったんです。それで、"}, {"type": "subtitle", "time": 12593.83, "timestamp": "03:29:53", "text": "私はセレストを見ることしかできなかった、"}, {"type": "subtitle", "time": 12597.59, "timestamp": "03:29:57", "text": "でも、チーズデビューをもう一度見ました"}]
[{"type": "subtitle", "time": 11761.59, "timestamp": "03:16:01", "text": "えーと"}, {"type": "subtitle", "time": 11765.51, "timestamp": "03:16:05", "text": "そして、それから、それから、他に何があるだろうか？"}, {"type": "subtitle", "time": 11769.83, "timestamp": "03:16:09", "text": "オーバーレイのアニメーション版。"}, {"type": "subtitle", "time": 11772.71, "timestamp": "03:16:12", "text": "それは可能です。はい。"}, {"type": "subtitle", "time": 11775.75, "timestamp": "03:16:15", "text": "念のため、だって、別にいいじゃない？なぜなら"}, {"type": "subtitle", "time": 11778.79, "timestamp": "03:16:18", "text": "私はこういうことができる"}, {"type": "subtitle", "time": 11781.349, "timestamp": "03:16:21", "text": "こういうこと。"}, {"type": "subtitle", "time": 11783.349, "timestamp": "03:16:23", "text": "私は思った、そう、私は作りたい"}, {"type": "subtitle", "time": 11786.229, "timestamp": "03:16:26", "text": "ちょっとアニメーションっぽい感じだったけどね。それはただ"}, {"type": "subtitle", "time": 11787.99, "timestamp": "03:16:27", "text": "単純"}, {"type": "subtitle", "time": 11791.75, "timestamp": "03:16:31", "text": "えーっと、シンプルな効果だけど、そうしたいんだ"}, {"type": "subtitle", "time": 11794.71, "timestamp": "03:16:34", "text": "もの。"}, {"type": "subtitle", "time": 11803.51, "timestamp": "03:16:43", "text": "アニメーションを作ります。後でわかる"}, {"type": "subtitle", "time": 11805.269, "timestamp": "03:16:45", "text": "影響。はい。"}, {"type": "subtitle", "time": 11806.95, "timestamp": "03:16:46", "text": "どうにか"}, {"type": "subtitle", "time": 11809.11, "timestamp": "03:16:49", "text": "井戸があれば、いつも"}, {"type": "subtitle", "time": 11811.59, "timestamp": "03:16:51", "text": "方法。はい。"}, {"type": "subtitle", "time": 11813.67, "timestamp": "03:16:53", "text": "[音楽]"}, {"type": "subtitle", "time": 11817.06, "timestamp": "03:16:57", "text": "意志は常に"}]
[{"type": "subtitle", "time": 4506.31, "timestamp": "01:15:06", "text": "彼はそれを横に着けているのですか？で"}, {"type": "subtitle", "time": 4509.83, "timestamp": "01:15:09", "text": "とんでもない破壊者。面白いことに"}, {"type": "subtitle", "time": 4513.91, "timestamp": "01:15:13", "text": "この男のために、私たちはいつも着ています"}, {"type": "subtitle", "time": 4516.31, "timestamp": "01:15:16", "text": "横に置いてください。ほら、これだよ。"}, {"type": "subtitle", "time": 4518.79, "timestamp": "01:15:18", "text": "文字通り"}, {"type": "subtitle", "time": 4520.47, "timestamp": "01:15:20", "text": "エモン・ガランドと言おうと思ったのですが、"}, {"type": "subtitle", "time": 4526.47, "timestamp": "01:15:26", "text": "いいえ、違います。ボルトアクション式です。それは"}, {"type": "subtitle", "time": 4528.39, "timestamp": "01:15:28", "text": "ボルトアクション。ええ、ボルトアクション式です。"}, {"type": "subtitle", "time": 4530.39, "timestamp": "01:15:30", "text": "ああ、ボルトアクションって何ですか？エモン・ガランド"}, {"type": "subtitle", "time": 4533.59, "timestamp": "01:15:33", "text": "ガス作動式に似ているが、これはボルト式だ"}, {"type": "subtitle", "time": 4535.35, "timestamp": "01:15:35", "text": "アクション。憲法。このボルト"}, {"type": "subtitle", "time": 4536.95, "timestamp": "01:15:36", "text": "アクション。"}, {"type": "subtitle", "time": 4538.31, "timestamp": "01:15:38", "text": "ピコンという音がする。それで私は電話しました"}, {"type": "subtitle", "time": 4540.95, "timestamp": "01:15:40", "text": "M1ガー M1ガー。 ping があります"}, {"type": "subtitle", "time": 4542.95, "timestamp": "01:15:42", "text": "弾薬がなくなったら、それを使うんだ。うん、"}, {"type": "subtitle", "time": 4545.35, "timestamp": "01:15:45", "text": "クリップを使用しているからです。"}, {"type": "subtitle", "time": 4547.43, "timestamp": "01:15:47", "text": "うん。だから私はM1ガレンに電話した。私"}, {"type": "subtitle", "time": 4549.35, "timestamp": "01:15:49", "text": "それを憲法と呼ぶことすらしないで。"}, {"type": "subtitle", "time": 4551.59, "timestamp": "01:15:51", "text": "これをM1ガーランドと呼ぶ人は誰でも"}, {"type": "subtitle", "time": 4554.55, "timestamp": "01:15:54", "text": "これはボルタクションライフルです。あなたはできる"}, {"type": "subtitle", "time": 4557.51, "timestamp": "01:15:57", "text": "どうでも。"}]
[{"type": "subtitle", "time": 15842.309, "timestamp": "04:24:02", "text": "よし、行こう。 ３、２、待って。"}, {"type": "subtitle", "time": 15844.149, "timestamp": "04:24:04", "text": "三つ。"}, {"type": "subtitle", "time": 15850.469, "timestamp": "04:24:10", "text": "待って、"}, {"type": "subtitle", "time": 15856.95, "timestamp": "04:24:16", "text": "さあ行こう。"}, {"type": "subtitle", "time": 15864.68, "timestamp": "04:24:24", "text": "想像する"}, {"type": "subtitle", "time": 15897.59, "timestamp": "04:24:57", "text": "私が知っているのはそれだけです。それだけです。待って、君"}]
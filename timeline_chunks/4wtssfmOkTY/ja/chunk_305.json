[{"type": "subtitle", "time": 18318.26, "timestamp": "05:05:18", "text": "待って、もし私がなぜ行くのか？"}, {"type": "subtitle", "time": 18321.35, "timestamp": "05:05:21", "text": "[音楽]"}, {"type": "subtitle", "time": 18329.03, "timestamp": "05:05:29", "text": "私がやりたいことは、"}, {"type": "subtitle", "time": 18330.628, "timestamp": "05:05:30", "text": "について"}, {"type": "subtitle", "time": 18333.35, "timestamp": "05:05:33", "text": "音楽を作ることは、自分の"}, {"type": "subtitle", "time": 18334.868, "timestamp": "05:05:34", "text": "サイン"}, {"type": "subtitle", "time": 18340.628, "timestamp": "05:05:40", "text": "音"}, {"type": "subtitle", "time": 18342.708, "timestamp": "05:05:42", "text": "これは"}, {"type": "subtitle", "time": 18345.43, "timestamp": "05:05:45", "text": "メロディー的には"}, {"type": "subtitle", "time": 18350.07, "timestamp": "05:05:50", "text": "またはすべての声のように、すべての声"}, {"type": "subtitle", "time": 18353.67, "timestamp": "05:05:53", "text": "力強い歌 歌手なら、"}, {"type": "subtitle", "time": 18358.31, "timestamp": "05:05:58", "text": "特定のオリジナルに近いもの"}]
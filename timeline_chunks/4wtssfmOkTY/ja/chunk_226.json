[{"type": "subtitle", "time": 13560.469, "timestamp": "03:46:00", "text": "えっと、Trelloにあるもの。"}, {"type": "subtitle", "time": 13564.469, "timestamp": "03:46:04", "text": "えーと、私のTrelloボードのTrelloは"}, {"type": "subtitle", "time": 13570.389, "timestamp": "03:46:10", "text": "運動部員たちと私たちは何かをする予定です"}, {"type": "subtitle", "time": 13573.91, "timestamp": "03:46:13", "text": "クリエイティブなもの、明白なもの、オールボード"}, {"type": "subtitle", "time": 13579.03, "timestamp": "03:46:19", "text": "はい、船上でやっています。"}, {"type": "subtitle", "time": 13585.83, "timestamp": "03:46:25", "text": "こんにちは"}, {"type": "subtitle", "time": 13590.229, "timestamp": "03:46:30", "text": "入れる、入れる、バカ。"}, {"type": "subtitle", "time": 13593.269, "timestamp": "03:46:33", "text": "こんにちは、インド。"}, {"type": "subtitle", "time": 13598.15, "timestamp": "03:46:38", "text": "さあ、行こう。こんにちは。私にさせて"}, {"type": "subtitle", "time": 13606.87, "timestamp": "03:46:46", "text": "これが私のTrelloボードです。"}, {"type": "subtitle", "time": 13611.269, "timestamp": "03:46:51", "text": "いろいろなものの記録。気にしないでください。"}, {"type": "subtitle", "time": 13613.83, "timestamp": "03:46:53", "text": "これは気にしないでください。"}]
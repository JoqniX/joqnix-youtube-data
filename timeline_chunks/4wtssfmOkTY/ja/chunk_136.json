[{"type": "subtitle", "time": 8168.229, "timestamp": "02:16:08", "text": "援軍を要請する。"}, {"type": "subtitle", "time": 8176.47, "timestamp": "02:16:16", "text": "投げることができる"}, {"type": "subtitle", "time": 8188.31, "timestamp": "02:16:28", "text": "ああ、彼らはゆっくりと上達している。"}, {"type": "subtitle", "time": 8190.229, "timestamp": "02:16:30", "text": "私は彼らの気をそらしているようなものだけど、"}, {"type": "subtitle", "time": 8194.15, "timestamp": "02:16:34", "text": "うまく仕事をしていない。くそっ、エッジめ。"}, {"type": "subtitle", "time": 8195.83, "timestamp": "02:16:35", "text": "私たちは非常に迅速に行動する必要があると思います"}, {"type": "subtitle", "time": 8198.549, "timestamp": "02:16:38", "text": "これ。何てことだ。ありがとうございます"}, {"type": "subtitle", "time": 8200.389, "timestamp": "02:16:40", "text": "フォローする。配信へようこ​​そ。こんにちは"}, {"type": "subtitle", "time": 8207.669, "timestamp": "02:16:47", "text": "これは横ばいになっている"}, {"type": "subtitle", "time": 8209.83, "timestamp": "02:16:49", "text": "非常に速い。"}, {"type": "subtitle", "time": 8212.549, "timestamp": "02:16:52", "text": "うん、大丈夫だよ。私たちは楽しんでいます。誰が"}, {"type": "subtitle", "time": 8214.709, "timestamp": "02:16:54", "text": "気にかけている？よし、じゃあ、えーと"}, {"type": "subtitle", "time": 8219.27, "timestamp": "02:16:59", "text": "暗号化されたハードドライブは非常に高速です。"}]
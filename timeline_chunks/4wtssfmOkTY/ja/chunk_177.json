[{"type": "subtitle", "time": 10621.349, "timestamp": "02:57:01", "text": "ということで、皆さんを退屈させるつもりはありません。"}, {"type": "subtitle", "time": 10625.269, "timestamp": "02:57:05", "text": "技術的な内容です。 9時までには終わらせます。"}, {"type": "subtitle", "time": 10629.19, "timestamp": "02:57:09", "text": "だから、9時頃は、最近は"}, {"type": "subtitle", "time": 10632.71, "timestamp": "02:57:12", "text": "やってきたことは、"}, {"type": "subtitle", "time": 10635.67, "timestamp": "02:57:15", "text": "仕事は9時にやるんだよね？そうですね、"}, {"type": "subtitle", "time": 10638.15, "timestamp": "02:57:18", "text": "9時に再開します。話し合いましょう"}, {"type": "subtitle", "time": 10641.19, "timestamp": "02:57:21", "text": "昨日のことについて"}, {"type": "subtitle", "time": 10642.87, "timestamp": "02:57:22", "text": "なぜなら"}, {"type": "subtitle", "time": 10645.83, "timestamp": "02:57:25", "text": "はい、私は自分自身を分析していました"}, {"type": "subtitle", "time": 10650.23, "timestamp": "02:57:30", "text": "昨日の朝から。昨日"}, {"type": "subtitle", "time": 10653.429, "timestamp": "02:57:33", "text": "私が気づいたのはこれです"}, {"type": "subtitle", "time": 10658.469, "timestamp": "02:57:38", "text": "ええと、私は大バカです、マダム・ダム・ダム・ダムです。"}, {"type": "subtitle", "time": 10660.71, "timestamp": "02:57:40", "text": "なぜ？なぜなら"}, {"type": "subtitle", "time": 10663.67, "timestamp": "02:57:43", "text": "私はとても無口だった"}, {"type": "subtitle", "time": 10677.19, "timestamp": "02:57:57", "text": "私は手に入れたい 私は欲しい 私は欲しい 私は持っている"}]
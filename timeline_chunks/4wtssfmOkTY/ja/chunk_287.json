[{"type": "subtitle", "time": 17224.15, "timestamp": "04:47:04", "text": "見てみましょう。聞いてください、"}, {"type": "subtitle", "time": 17236.628, "timestamp": "04:47:16", "text": "待って、ああ、私が作ったとき、私が言うとき、私は言う"}, {"type": "subtitle", "time": 17238.628, "timestamp": "04:47:18", "text": "緊急。"}, {"type": "subtitle", "time": 17240.15, "timestamp": "04:47:20", "text": "ああ、"}, {"type": "subtitle", "time": 17242.708, "timestamp": "04:47:22", "text": "その曲を思い出した。私はしません"}, {"type": "subtitle", "time": 17244.23, "timestamp": "04:47:24", "text": "それを歌にしたい。私は作りたい"}, {"type": "subtitle", "time": 17246.788, "timestamp": "04:47:26", "text": "それは何かユニークなもの、私ができるもの"}, {"type": "subtitle", "time": 17253.11, "timestamp": "04:47:33", "text": "クレイジー。"}]
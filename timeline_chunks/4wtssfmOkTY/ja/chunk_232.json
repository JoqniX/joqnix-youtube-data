[{"type": "subtitle", "time": 13921.189, "timestamp": "03:52:01", "text": "意味のあるものにしたい"}, {"type": "subtitle", "time": 13924.469, "timestamp": "03:52:04", "text": "私の法律に関連する何か"}, {"type": "subtitle", "time": 13927.67, "timestamp": "03:52:07", "text": "物語を語る何か"}, {"type": "subtitle", "time": 13929.83, "timestamp": "03:52:09", "text": "あるいは、たとえ内容が"}, {"type": "subtitle", "time": 13933.189, "timestamp": "03:52:13", "text": "ゲームをしたり、いろいろなことをしたりすることについて"}, {"type": "subtitle", "time": 13935.269, "timestamp": "03:52:15", "text": "それは単なるゲームではなく、制限したくない"}, {"type": "subtitle", "time": 13938.229, "timestamp": "03:52:18", "text": "私自身もゲームに夢中です。いいえ、私は"}, {"type": "subtitle", "time": 13942.87, "timestamp": "03:52:22", "text": "実際のエンターテイメント。それで、"}, {"type": "subtitle", "time": 13945.67, "timestamp": "03:52:25", "text": "はい、それについては計画があります。しかし、"}, {"type": "subtitle", "time": 13947.75, "timestamp": "03:52:27", "text": "問題は"}, {"type": "subtitle", "time": 13949.67, "timestamp": "03:52:29", "text": "一人が全てをこなす、それは"}, {"type": "subtitle", "time": 13953.269, "timestamp": "03:52:33", "text": "不可能。私はそれを知っています。でもでもでもでもあなたは"}, {"type": "subtitle", "time": 13956.309, "timestamp": "03:52:36", "text": "バカバカな私はそれを怒らせない"}, {"type": "subtitle", "time": 13959.189, "timestamp": "03:52:39", "text": "一人で全てをこなすことはできない。私はそうします"}, {"type": "subtitle", "time": 13962.309, "timestamp": "03:52:42", "text": "何でもできるけど、それでも挑戦してみる"}, {"type": "subtitle", "time": 13964.87, "timestamp": "03:52:44", "text": "私のベスト。"}, {"type": "subtitle", "time": 13967.11, "timestamp": "03:52:47", "text": "私は自分の茂みを手入れします。"}, {"type": "subtitle", "time": 13975.59, "timestamp": "03:52:55", "text": "こんにちは。こんにちは。それで、ええと、これを入力する必要があります。"}, {"type": "subtitle", "time": 13978.55, "timestamp": "03:52:58", "text": "これを書き出します。だから、私が"}]
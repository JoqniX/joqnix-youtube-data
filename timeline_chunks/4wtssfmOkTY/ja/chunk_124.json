[{"type": "subtitle", "time": 7441.51, "timestamp": "02:04:01", "text": "最近、民主主義の蒸気機関で遊んでみました"}, {"type": "subtitle", "time": 7443.189, "timestamp": "02:04:03", "text": "マッチング？ああ、蒸気が出ない"}, {"type": "subtitle", "time": 7446.07, "timestamp": "02:04:06", "text": "マッチング。はい、私も見えません。私"}, {"type": "subtitle", "time": 7452.07, "timestamp": "02:04:12", "text": "一番近いところに行きましょう。"}, {"type": "subtitle", "time": 7453.75, "timestamp": "02:04:13", "text": "むしろ一番近いところから追い出したい"}, {"type": "subtitle", "time": 7458.709, "timestamp": "02:04:18", "text": "まずは計画を立てましょう。何てことだ。"}, {"type": "subtitle", "time": 7462.39, "timestamp": "02:04:22", "text": "君たち、本気で言ってるの？ 0.02%"}, {"type": "subtitle", "time": 7468.95, "timestamp": "02:04:28", "text": "このコースにはスーパーヘルダイブはありません"}, {"type": "subtitle", "time": 7471.75, "timestamp": "02:04:31", "text": "惑星。"}, {"type": "subtitle", "time": 7473.99, "timestamp": "02:04:33", "text": "ほら、一つあるよ。すべては地獄だ"}, {"type": "subtitle", "time": 7481.43, "timestamp": "02:04:41", "text": "さあ行こう。"}, {"type": "subtitle", "time": 7485.51, "timestamp": "02:04:45", "text": "無駄にできる時間はない。"}, {"type": "subtitle", "time": 7492.39, "timestamp": "02:04:52", "text": "確認してみます。ただあなたに"}]
[{"type": "subtitle", "time": 3303.19, "timestamp": "00:55:03", "text": "どれくらい待たなければなりませんか？ 7分"}, {"type": "subtitle", "time": 3310.47, "timestamp": "00:55:10", "text": "ここはまるで戦場だ。それは それは"}, {"type": "subtitle", "time": 3312.63, "timestamp": "00:55:12", "text": "5位。"}, {"type": "subtitle", "time": 3315.75, "timestamp": "00:55:15", "text": "ランク f。それって高いんじゃない？高い、高い。"}, {"type": "subtitle", "time": 3317.51, "timestamp": "00:55:17", "text": "いいえ。それは違う、ただ難しいだけだ。その"}, {"type": "subtitle", "time": 3319.99, "timestamp": "00:55:19", "text": "難易度ハードの場合のみ。私はそれを見た"}, {"type": "subtitle", "time": 3323.109, "timestamp": "00:55:23", "text": "超地獄のダイブ。ああ、これは何でもないよ。"}, {"type": "subtitle", "time": 3335.75, "timestamp": "00:55:35", "text": "拡張できます。"}, {"type": "subtitle", "time": 3338.71, "timestamp": "00:55:38", "text": "弾薬を無駄にしてしまった。"}, {"type": "subtitle", "time": 3343.03, "timestamp": "00:55:43", "text": "それはいいです。弾薬は山ほどある。"}, {"type": "subtitle", "time": 3345.349, "timestamp": "00:55:45", "text": "ええ、まあ、私たちはそれを大目に見ました。我々は持っています"}, {"type": "subtitle", "time": 3351.27, "timestamp": "00:55:51", "text": "ああ、この人は誰ですか？ああ、それはそれは"}, {"type": "subtitle", "time": 3353.75, "timestamp": "00:55:53", "text": "それは何ですか？"}, {"type": "subtitle", "time": 3357.91, "timestamp": "00:55:57", "text": "ああ、歩行器だ。ああ、ハルクがいる。"}]
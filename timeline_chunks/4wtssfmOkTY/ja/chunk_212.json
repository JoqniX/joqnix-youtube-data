[{"type": "subtitle", "time": 12720.95, "timestamp": "03:32:00", "text": "sa のためのこと、そして悪いことをしないために"}, {"type": "subtitle", "time": 12723.11, "timestamp": "03:32:03", "text": "守る。"}, {"type": "subtitle", "time": 12727.03, "timestamp": "03:32:07", "text": "それで、私は、えっと"}, {"type": "subtitle", "time": 12730.229, "timestamp": "03:32:10", "text": "スタッフと全員が決定します"}, {"type": "subtitle", "time": 12733.59, "timestamp": "03:32:13", "text": "えーと、Discordモードを作るには、"}, {"type": "subtitle", "time": 12737.269, "timestamp": "03:32:17", "text": "当時のマネージャー"}, {"type": "subtitle", "time": 12740.469, "timestamp": "03:32:20", "text": "もしあなたが、"}, {"type": "subtitle", "time": 12743.99, "timestamp": "03:32:23", "text": "欲しいし、それを築き上げてきた"}, {"type": "subtitle", "time": 12747.19, "timestamp": "03:32:27", "text": "関係と信頼があれば"}, {"type": "subtitle", "time": 12750.07, "timestamp": "03:32:30", "text": "その役を勝ち取る。そういうことなんです、そういうことなんです"}, {"type": "subtitle", "time": 12754.15, "timestamp": "03:32:34", "text": "アーヤがその役を得たのは、彼が司会者だったからだ"}, {"type": "subtitle", "time": 12759.83, "timestamp": "03:32:39", "text": "私のサーバーで、そして、えっと、何ですか"}, {"type": "subtitle", "time": 12764.309, "timestamp": "03:32:44", "text": "彼は活動的だった、"}, {"type": "subtitle", "time": 12766.79, "timestamp": "03:32:46", "text": "コミュニティとその他すべて。はい、できます"}, {"type": "subtitle", "time": 12769.83, "timestamp": "03:32:49", "text": "あなたは私を推薦してくれるのですか？ええ、できますよ。しかしそれは"}, {"type": "subtitle", "time": 12773.91, "timestamp": "03:32:53", "text": "お前次第だよ、バカ。知っておく必要がある"}, {"type": "subtitle", "time": 12778.87, "timestamp": "03:32:58", "text": "悪いことが起こった時にそこにいるか、"}]
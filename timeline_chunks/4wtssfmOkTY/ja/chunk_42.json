[{"type": "subtitle", "time": 2520.95, "timestamp": "00:42:00", "text": "これは一体何なのか。"}, {"type": "subtitle", "time": 2527.349, "timestamp": "00:42:07", "text": "[音楽]"}, {"type": "subtitle", "time": 2530.39, "timestamp": "00:42:10", "text": "ああ、これは良いですね。ああ、これ大好き！"}, {"type": "subtitle", "time": 2533.03, "timestamp": "00:42:13", "text": "1つ。 2つのモードがあります。それは"}, {"type": "subtitle", "time": 2534.309, "timestamp": "00:42:14", "text": "砲撃モードがあり、マイクロ"}, {"type": "subtitle", "time": 2536.39, "timestamp": "00:42:16", "text": "ミサイルモード。"}, {"type": "subtitle", "time": 2538.95, "timestamp": "00:42:18", "text": "えっと、私はこのバースト射撃スナイパーを使っています"}, {"type": "subtitle", "time": 2542.47, "timestamp": "00:42:22", "text": "ライフル。連射式狙撃銃。の"}, {"type": "subtitle", "time": 2545.43, "timestamp": "00:42:25", "text": "プラズマワン。プラズマの方です。そうそう。"}, {"type": "subtitle", "time": 2547.91, "timestamp": "00:42:27", "text": "くそ。弾薬が本当に尽きるだろう"}, {"type": "subtitle", "time": 2548.87, "timestamp": "00:42:28", "text": "素早い。"}, {"type": "subtitle", "time": 2552.15, "timestamp": "00:42:32", "text": "待って、そんなにたくさんの人がやったことは"}, {"type": "subtitle", "time": 2554.39, "timestamp": "00:42:34", "text": "新しい戦時国債とかは今まであった？"}, {"type": "subtitle", "time": 2557.75, "timestamp": "00:42:37", "text": "あのクロスボウの件以来？"}, {"type": "subtitle", "time": 2562.47, "timestamp": "00:42:42", "text": "ああ、うん、たくさん。たくさんありますよ。うん。"}, {"type": "subtitle", "time": 2565.589, "timestamp": "00:42:45", "text": "おっと。ああ、これは、これは、これは、ああ私の"}, {"type": "subtitle", "time": 2567.99, "timestamp": "00:42:47", "text": "神。心配しないで。私はもっ​​と持っていません"}, {"type": "subtitle", "time": 2569.75, "timestamp": "00:42:49", "text": "ほとんど持っていません。だからたとえ"}, {"type": "subtitle", "time": 2571.27, "timestamp": "00:42:51", "text": "私はたくさんプレイしますが、まだほとんど持っていません"}, {"type": "subtitle", "time": 2573.19, "timestamp": "00:42:53", "text": "彼ら。工場を探しています"}, {"type": "subtitle", "time": 2575.349, "timestamp": "00:42:55", "text": "ここ。何も見えません。工場"}, {"type": "subtitle", "time": 2577.27, "timestamp": "00:42:57", "text": "サイド派は死んだ。私たちはただ、ああ、いや。"}, {"type": "subtitle", "time": 2578.47, "timestamp": "00:42:58", "text": "いいえ。ほら、彼は"}]
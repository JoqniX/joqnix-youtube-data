[{"type": "subtitle", "time": 5401.189, "timestamp": "01:30:01", "text": "これは地獄のダイブであることを考えると"}, {"type": "subtitle", "time": 5403.83, "timestamp": "01:30:03", "text": "難しさは、驚くほど"}, {"type": "subtitle", "time": 5405.75, "timestamp": "01:30:05", "text": "見ていない方が簡単"}, {"type": "subtitle", "time": 5407.75, "timestamp": "01:30:07", "text": "まだ拠点は固まっている。私たちはまだ"}, {"type": "subtitle", "time": 5410.31, "timestamp": "01:30:10", "text": "まだ拠点は固まっている。"}, {"type": "subtitle", "time": 5411.83, "timestamp": "01:30:11", "text": "つまり、ああ、"}, {"type": "subtitle", "time": 5414.07, "timestamp": "01:30:14", "text": "しまった、歩き回っていることに今気づいた"}, {"type": "subtitle", "time": 5416.229, "timestamp": "01:30:16", "text": "盾なしで。"}, {"type": "subtitle", "time": 5418.79, "timestamp": "01:30:18", "text": "私はどうして死ななかったのだろう？"}, {"type": "subtitle", "time": 5420.95, "timestamp": "01:30:20", "text": "私も。私はただこれに興味があるだけです"}, {"type": "subtitle", "time": 5424.55, "timestamp": "01:30:24", "text": "一瞬。私には、私には、好きではないものがあります"}, {"type": "subtitle", "time": 5427.189, "timestamp": "01:30:27", "text": "砲兵兵器が私に向けられている。私は盾を持っていません"}, {"type": "subtitle", "time": 5429.669, "timestamp": "01:30:29", "text": "私に任せて。私はまだ生きている。彼女は私のものだ。私にさせて"}, {"type": "subtitle", "time": 5432.31, "timestamp": "01:30:32", "text": "クラフト。さあ行こう。私の"}, {"type": "subtitle", "time": 5435.03, "timestamp": "01:30:35", "text": "神。いいえ。"}, {"type": "subtitle", "time": 5438.629, "timestamp": "01:30:38", "text": "私も実際に試してみたいです。ああ、やばい、"}, {"type": "subtitle", "time": 5441.27, "timestamp": "01:30:41", "text": "ここにハルクがいることを忘れていた。"}]
[{"type": "subtitle", "time": 8943.03, "timestamp": "02:29:03", "text": "あなたはそれをすぐに手に入れることができます。"}, {"type": "subtitle", "time": 8951.75, "timestamp": "02:29:11", "text": "はい、ここで配信を終了します。"}, {"type": "subtitle", "time": 8955.11, "timestamp": "02:29:15", "text": "ありがとうございます。感謝いたします。特別"}, {"type": "subtitle", "time": 8957.349, "timestamp": "02:29:17", "text": "バターさん、シューマさん、ありがとうございます。"}, {"type": "subtitle", "time": 8959.27, "timestamp": "02:29:19", "text": "ジャクニックスさん、お越しいただきありがとうございます。本当に"}, {"type": "subtitle", "time": 8961.59, "timestamp": "02:29:21", "text": "感謝します。そして皆さんに感謝します"}, {"type": "subtitle", "time": 8963.27, "timestamp": "02:29:23", "text": "配信に現れる。多くの"}, {"type": "subtitle", "time": 8965.83, "timestamp": "02:29:25", "text": "感謝します。そしていつものように、私は見ます"}, {"type": "subtitle", "time": 8968.389, "timestamp": "02:29:28", "text": "君たち。"}, {"type": "subtitle", "time": 8970.469, "timestamp": "02:29:30", "text": "バイバイ。"}, {"type": "subtitle", "time": 8978.15, "timestamp": "02:29:38", "text": "皆さんも締めくくりたいですか？"}, {"type": "subtitle", "time": 8981.75, "timestamp": "02:29:41", "text": "はい。ええ、そろそろ終わりにします。私は"}, {"type": "subtitle", "time": 8986.23, "timestamp": "02:29:46", "text": "寝る。おやすみ。おやすみ。"}, {"type": "subtitle", "time": 8989.51, "timestamp": "02:29:49", "text": "こんにちは。このゲームをアンインストールする時が来た。"}, {"type": "subtitle", "time": 8993.83, "timestamp": "02:29:53", "text": "ちくしょう。スペースがないんです。私は持っている"}, {"type": "subtitle", "time": 8997.51, "timestamp": "02:29:57", "text": "コラボレーション。私にはスペースが必要です。はい、あなたはこう言いました"}]
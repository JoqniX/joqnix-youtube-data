[{"type": "subtitle", "time": 16092.63, "timestamp": "04:28:12", "text": "そうそう。私はDiscordに参加しているので、"}, {"type": "subtitle", "time": 16095.269, "timestamp": "04:28:15", "text": "あなたが書いたすべてのコメントを忘れて"}, {"type": "subtitle", "time": 16098.71, "timestamp": "04:28:18", "text": "Twitchで使っているものと同じもの全て。"}, {"type": "subtitle", "time": 16100.63, "timestamp": "04:28:20", "text": "私は疑問に思っていました"}, {"type": "subtitle", "time": 16114.229, "timestamp": "04:28:34", "text": "全部見せたら何の意味があるの？"}, {"type": "subtitle", "time": 16118.71, "timestamp": "04:28:38", "text": "出世した？いや、いや、いや。"}, {"type": "subtitle", "time": 16121.349, "timestamp": "04:28:41", "text": "つまり、世界では"}, {"type": "subtitle", "time": 16125.429, "timestamp": "04:28:45", "text": "そこだけど、つまりこういうこと"}, {"type": "subtitle", "time": 16129.349, "timestamp": "04:28:49", "text": "思い出のためだけに"}, {"type": "subtitle", "time": 16132.71, "timestamp": "04:28:52", "text": "それが私の仕事だってことは、あなたも知っているでしょう。わからない。"}, {"type": "subtitle", "time": 16138.55, "timestamp": "04:28:58", "text": "私は、えーと、その瞬間は、えーと"}]
[{"type": "subtitle", "time": 12076.95, "timestamp": "03:21:16", "text": "[音楽]"}, {"type": "subtitle", "time": 12079.85, "timestamp": "03:21:19", "text": "正直に言います。はい、"}, {"type": "subtitle", "time": 12088.469, "timestamp": "03:21:28", "text": "アニメはたくさんある。私は始めた"}, {"type": "subtitle", "time": 12090.15, "timestamp": "03:21:30", "text": "視聴中"}, {"type": "subtitle", "time": 12093.91, "timestamp": "03:21:33", "text": "第195話の世界大戦。待って、"}, {"type": "subtitle", "time": 12097.67, "timestamp": "03:21:37", "text": "現在195話。何？"}, {"type": "subtitle", "time": 12110.15, "timestamp": "03:21:50", "text": "そうそう。何てことだ。ええ、"}, {"type": "subtitle", "time": 12113.83, "timestamp": "03:21:53", "text": "その間。私は、私が"}, {"type": "subtitle", "time": 12116.229, "timestamp": "03:21:56", "text": "覚えて"}, {"type": "subtitle", "time": 12118.63, "timestamp": "03:21:58", "text": "まで"}]
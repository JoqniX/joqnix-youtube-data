[{"type": "subtitle", "time": 5760.31, "timestamp": "01:36:00", "text": "私は彼とあと一発で勝てそうなるところまで来ている。なぜ"}, {"type": "subtitle", "time": 5762.31, "timestamp": "01:36:02", "text": "見えないのか。ああ、ジャマーだ。"}, {"type": "subtitle", "time": 5776.39, "timestamp": "01:36:16", "text": "私は市内で380を装着しようとしています。"}, {"type": "subtitle", "time": 5777.91, "timestamp": "01:36:17", "text": "敵が多すぎるので"}, {"type": "subtitle", "time": 5780.229, "timestamp": "01:36:20", "text": "そのまま走り込んでいけばいいんです。同じ。しかし"}, {"type": "subtitle", "time": 5783.189, "timestamp": "01:36:23", "text": "私は向こう側へ向かいます。わかった。ありがとう。"}, {"type": "subtitle", "time": 5784.47, "timestamp": "01:36:24", "text": "それらを間隔をあけて置いてください。それらを間隔をあけて置いてください。しないで"}, {"type": "subtitle", "time": 5786.95, "timestamp": "01:36:26", "text": "彼を一箇所に留めておく。"}, {"type": "subtitle", "time": 5789.669, "timestamp": "01:36:29", "text": "どうやら私はそれを投げなかったようだ。いいえ、私は"}, {"type": "subtitle", "time": 5791.03, "timestamp": "01:36:31", "text": "すぐ隣に置きます"}, {"type": "subtitle", "time": 5802.87, "timestamp": "01:36:42", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 5805.75, "timestamp": "01:36:45", "text": "私はこの探査車が大好きです。"}, {"type": "subtitle", "time": 5807.109, "timestamp": "01:36:47", "text": "探査車。ええ、探査車は本当に"}, {"type": "subtitle", "time": 5811.35, "timestamp": "01:36:51", "text": "ニース。彼らは実際に作ったのが好きです"}, {"type": "subtitle", "time": 5813.669, "timestamp": "01:36:53", "text": "私たちを殺す代わりに、今はただ"}, {"type": "subtitle", "time": 5815.189, "timestamp": "01:36:55", "text": "380をすぐ隣に落とした"}, {"type": "subtitle", "time": 5816.79, "timestamp": "01:36:56", "text": "ジャマー。"}]
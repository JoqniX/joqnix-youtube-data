[{"type": "subtitle", "time": 7323.91, "timestamp": "02:02:03", "text": "おお。ああ、そこにいたんですね。ああ、かわいいね。"}, {"type": "subtitle", "time": 7329.35, "timestamp": "02:02:09", "text": "くそ。はい、どうぞ。ああ、君はオレンジ色だね。"}, {"type": "subtitle", "time": 7331.35, "timestamp": "02:02:11", "text": "はい。"}, {"type": "subtitle", "time": 7346.47, "timestamp": "02:02:26", "text": "終結させたいのか？"}, {"type": "subtitle", "time": 7349.27, "timestamp": "02:02:29", "text": "ああ、まさに地獄のような日々だ。ああ、それは"}, {"type": "subtitle", "time": 7353.99, "timestamp": "02:02:33", "text": "すごく元気。バターはどうなったの？"}, {"type": "subtitle", "time": 7357.35, "timestamp": "02:02:37", "text": "彼は「何かをしなければならない」と言った。あなた"}, {"type": "subtitle", "time": 7361.35, "timestamp": "02:02:41", "text": "男たちはしばらく遊ぶ。彼は戻ってくるだろう。"}, {"type": "subtitle", "time": 7364.47, "timestamp": "02:02:44", "text": "よし、見てみよう。まるで"}, {"type": "subtitle", "time": 7367.43, "timestamp": "02:02:47", "text": "手榴弾がもっと必要だ。どれか見てみましょう"}, {"type": "subtitle", "time": 7374.07, "timestamp": "02:02:54", "text": "手榴弾をくれ。照明は"}, {"type": "subtitle", "time": 7377.27, "timestamp": "02:02:57", "text": "今、私の思考を監視している。"}]
[{"type": "subtitle", "time": 5701.35, "timestamp": "01:35:01", "text": "ありがとう。サンプルを入手しました。ありがとう。"}, {"type": "subtitle", "time": 5704.95, "timestamp": "01:35:04", "text": "できるなら、私の槍も奪ってみろ。えっと、私は"}, {"type": "subtitle", "time": 5718.229, "timestamp": "01:35:18", "text": "何てことだ。"}, {"type": "subtitle", "time": 5721.03, "timestamp": "01:35:21", "text": "わからない。"}, {"type": "subtitle", "time": 5724.55, "timestamp": "01:35:24", "text": "とても驚きました。"}, {"type": "subtitle", "time": 5725.91, "timestamp": "01:35:25", "text": "おそらくまだ市内には入っていないだろう"}, {"type": "subtitle", "time": 5729.75, "timestamp": "01:35:29", "text": "まだ。ええ、おそらくそうでしょう。ああ、よかった。それ"}, {"type": "subtitle", "time": 5732.31, "timestamp": "01:35:32", "text": "それは死んだ。"}, {"type": "subtitle", "time": 5734.95, "timestamp": "01:35:34", "text": "何てことだ。赤と黒と白の種類"}, {"type": "subtitle", "time": 5736.31, "timestamp": "01:35:36", "text": "は、とてもとても"}, {"type": "subtitle", "time": 5738.229, "timestamp": "01:35:38", "text": "悪い。"}, {"type": "subtitle", "time": 5741.669, "timestamp": "01:35:41", "text": "面白い"}, {"type": "subtitle", "time": 5745.35, "timestamp": "01:35:45", "text": "クラスの皆さん、シュー先生。"}, {"type": "subtitle", "time": 5755.27, "timestamp": "01:35:55", "text": "どこで爆発を起こすべきなの？"}]
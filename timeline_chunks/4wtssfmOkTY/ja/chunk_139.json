[{"type": "subtitle", "time": 8342.56, "timestamp": "02:19:02", "text": "パッケージを取得しました。"}, {"type": "subtitle", "time": 8355.11, "timestamp": "02:19:15", "text": "どうやって登るのですか？レーザーを持ってきてくれ。その"}, {"type": "subtitle", "time": 8360.309, "timestamp": "02:19:20", "text": "何てことだ。小さなものでもブロックできる"}, {"type": "subtitle", "time": 8367.27, "timestamp": "02:19:27", "text": "小さなものでさえ、姿を消すことができる。"}, {"type": "subtitle", "time": 8375.509, "timestamp": "02:19:35", "text": "おお。ああ、君たち二人とも亡くなったんだね。"}, {"type": "subtitle", "time": 8378.87, "timestamp": "02:19:38", "text": "ええ、そうですね。あなたは"}, {"type": "subtitle", "time": 8381.509, "timestamp": "02:19:41", "text": "こいつらを甘く見るな。最も明るい"}, {"type": "subtitle", "time": 8384.549, "timestamp": "02:19:44", "text": "電車がめちゃくちゃだ。"}, {"type": "subtitle", "time": 8386.79, "timestamp": "02:19:46", "text": "何てことだ。本当に？"}, {"type": "subtitle", "time": 8389.59, "timestamp": "02:19:49", "text": "私はこれらのことで行き詰まっています"}, {"type": "subtitle", "time": 8392.469, "timestamp": "02:19:52", "text": "もの。それは分かります。"}, {"type": "subtitle", "time": 8394.55, "timestamp": "02:19:54", "text": "戦術をお教えしましょう。打つ"}, {"type": "subtitle", "time": 8397.91, "timestamp": "02:19:57", "text": "そして走る。文字通りただ"}, {"type": "subtitle", "time": 8399.75, "timestamp": "02:19:59", "text": "走って目標を達成する。作らないで"}]
[{"type": "subtitle", "time": 2824.55, "timestamp": "00:47:04", "text": "今の銀河系。次はあなたの番かもしれない。"}, {"type": "subtitle", "time": 2826.95, "timestamp": "00:47:06", "text": "それは、あなたが最大限に活用しない限りは"}, {"type": "subtitle", "time": 2828.309, "timestamp": "00:47:08", "text": "重要。待って、サンプルはどこに"}, {"type": "subtitle", "time": 2830.069, "timestamp": "00:47:10", "text": "行く？待って、サンプルはどこに行ったの？それ"}, {"type": "subtitle", "time": 2831.91, "timestamp": "00:47:11", "text": "方向。"}, {"type": "subtitle", "time": 2835.75, "timestamp": "00:47:15", "text": "地図上でそれらを確認してください。"}, {"type": "subtitle", "time": 2837.91, "timestamp": "00:47:17", "text": "わかった。一瞬、彼らは"}, {"type": "subtitle", "time": 2840.15, "timestamp": "00:47:20", "text": "消えた。"}, {"type": "subtitle", "time": 2843.91, "timestamp": "00:47:23", "text": "ええ、彼らは"}, {"type": "subtitle", "time": 2846.71, "timestamp": "00:47:26", "text": "死なないことを祈ろう。"}, {"type": "subtitle", "time": 2848.55, "timestamp": "00:47:28", "text": "ああ、大丈夫だよ。私はあなたの"}, {"type": "subtitle", "time": 2851.75, "timestamp": "00:47:31", "text": "地獄を生き抜く能力。感謝"}, {"type": "subtitle", "time": 2853.51, "timestamp": "00:47:33", "text": "あなた。抽出の仕組みは"}, {"type": "subtitle", "time": 2855.829, "timestamp": "00:47:35", "text": "降りてこない。"}, {"type": "subtitle", "time": 2857.99, "timestamp": "00:47:37", "text": "なぜそう思ったのかわからないけど、待って、待って、"}, {"type": "subtitle", "time": 2860.71, "timestamp": "00:47:40", "text": "ドミノ・ピザはどこですか？ああ、それはそうかもしれない"}, {"type": "subtitle", "time": 2864.47, "timestamp": "00:47:44", "text": "バグ。ああ、わかりました。バグが発生した。やったー。"}, {"type": "subtitle", "time": 2868.55, "timestamp": "00:47:48", "text": "わかった。ああ、もう。まったく"}, {"type": "subtitle", "time": 2870.23, "timestamp": "00:47:50", "text": "タイマーが止まるまで待つしかないと思う"}, {"type": "subtitle", "time": 2874.23, "timestamp": "00:47:54", "text": "下へ降りる。タイマーはどこ？"}, {"type": "subtitle", "time": 2877.27, "timestamp": "00:47:57", "text": "待って、どこがオーケー、14 があります"}, {"type": "subtitle", "time": 2879.75, "timestamp": "00:47:59", "text": "分。何てことだ。私たちはしなければならない 私たちは"}]
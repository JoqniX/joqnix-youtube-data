[{"type": "subtitle", "time": 18000.55, "timestamp": "05:00:00", "text": "芸術作品などについても同じことが言える。あなたは"}, {"type": "subtitle", "time": 18005.43, "timestamp": "05:00:05", "text": "何百万、何百万、何千もの"}, {"type": "subtitle", "time": 18008.788, "timestamp": "05:00:08", "text": "より良いものになるために"}, {"type": "subtitle", "time": 18014.23, "timestamp": "05:00:14", "text": "こういう芸術とか、そういうのが得意になった。そうですね、"}, {"type": "subtitle", "time": 18017.51, "timestamp": "05:00:17", "text": "では、これを練習として捉えましょう"}, {"type": "subtitle", "time": 18020.31, "timestamp": "05:00:20", "text": "昨日のことだけど、私が言ったのは"}, {"type": "subtitle", "time": 18023.67, "timestamp": "05:00:23", "text": "あまりにも？はい、あなたもそう言いましたね。"}, {"type": "subtitle", "time": 18027.35, "timestamp": "05:00:27", "text": "だから私は友達の一人が言ったと言った"}, {"type": "subtitle", "time": 18031.35, "timestamp": "05:00:31", "text": "誰が言ったのか忘れたから"}, {"type": "subtitle", "time": 18034.788, "timestamp": "05:00:34", "text": "1位。ミムだったのか、それともあなただったのか。"}, {"type": "subtitle", "time": 18037.03, "timestamp": "05:00:37", "text": "右？忘れた。彼がその少年だと​​思う"}, {"type": "subtitle", "time": 18039.99, "timestamp": "05:00:39", "text": "とはいえ、そうは言っていません。はい。続けなければならない"}, {"type": "subtitle", "time": 18057.11, "timestamp": "05:00:57", "text": "ああ、時々、なぜか分からないけど"}]
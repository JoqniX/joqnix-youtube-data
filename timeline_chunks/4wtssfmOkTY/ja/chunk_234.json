[{"type": "subtitle", "time": 14042.55, "timestamp": "03:54:02", "text": "耐火ボード、ストリーマーボードまたは"}, {"type": "subtitle", "time": 14045.429, "timestamp": "03:54:05", "text": "乗船する。 4つのソフトウェアを入手しました"}, {"type": "subtitle", "time": 14049.59, "timestamp": "03:54:09", "text": "これをしてください。タッチポータルは追加していません。私"}, {"type": "subtitle", "time": 14051.91, "timestamp": "03:54:11", "text": "今すぐそうします。触る"}, {"type": "subtitle", "time": 14057.429, "timestamp": "03:54:17", "text": "あなたはこうなるでしょう。"}, {"type": "subtitle", "time": 14065.59, "timestamp": "03:54:25", "text": "あ、声は出せます。待って、私がやらせて"}, {"type": "subtitle", "time": 14070.55, "timestamp": "03:54:30", "text": "声への攻撃も。声の攻撃。"}, {"type": "subtitle", "time": 14072.95, "timestamp": "03:54:32", "text": "声の攻撃。これは青色になります、私は"}, {"type": "subtitle", "time": 14076.63, "timestamp": "03:54:36", "text": "推測。なぜだめですか？"}, {"type": "subtitle", "time": 14080.389, "timestamp": "03:54:40", "text": "こんにちは。音声攻撃をすることができます"}, {"type": "subtitle", "time": 14083.99, "timestamp": "03:54:43", "text": "あるいは、そんな感じ。"}, {"type": "subtitle", "time": 14086.469, "timestamp": "03:54:46", "text": "何てことだ。私はまだ、私はまだ"}, {"type": "subtitle", "time": 14089.67, "timestamp": "03:54:49", "text": "Chatainソフトウェアについて学びました。それはとても"}, {"type": "subtitle", "time": 14094.79, "timestamp": "03:54:54", "text": "痛み。あれはどうなったんだろう。"}, {"type": "subtitle", "time": 14097.67, "timestamp": "03:54:57", "text": "こんにちは。それで、今のところ私が作りたいものは何ですか"}]
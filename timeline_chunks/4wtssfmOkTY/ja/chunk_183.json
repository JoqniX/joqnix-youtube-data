[{"type": "subtitle", "time": 10981.51, "timestamp": "03:03:01", "text": "継続的に話す"}, {"type": "subtitle", "time": 10985.19, "timestamp": "03:03:05", "text": "だから私は人々の気持ちを理解できる"}, {"type": "subtitle", "time": 10988.15, "timestamp": "03:03:08", "text": "ストレスが溜まって、ずっと話し続ける"}, {"type": "subtitle", "time": 10991.91, "timestamp": "03:03:11", "text": "2時間3時間ぶっ通しで"}, {"type": "subtitle", "time": 10995.83, "timestamp": "03:03:15", "text": "それは本当に痛みだとわかっている"}, {"type": "subtitle", "time": 10998.63, "timestamp": "03:03:18", "text": "でもでもでもでもでも"}, {"type": "subtitle", "time": 11000.87, "timestamp": "03:03:20", "text": "わからないけど、私はゆっくりと"}, {"type": "subtitle", "time": 11004.23, "timestamp": "03:03:24", "text": "これに慣れてきた"}, {"type": "subtitle", "time": 11006.469, "timestamp": "03:03:26", "text": "これは普通ではないし、私の頭は"}, {"type": "subtitle", "time": 11029.19, "timestamp": "03:03:49", "text": "君のことを思うと心が温かくなる。私の父は"}, {"type": "subtitle", "time": 11033.349, "timestamp": "03:03:53", "text": "入っていった。すごい。"}, {"type": "subtitle", "time": 11036.46, "timestamp": "03:03:56", "text": "おお。注意喚起。"}]
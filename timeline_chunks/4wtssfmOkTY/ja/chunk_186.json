[{"type": "subtitle", "time": 11162.95, "timestamp": "03:06:02", "text": "うん、すごく楽しかったよ。私は達成しました"}, {"type": "subtitle", "time": 11166.07, "timestamp": "03:06:06", "text": "私の目標の一つです。話すために"}, {"type": "subtitle", "time": 11169.83, "timestamp": "03:06:09", "text": "配信中の日本人とコラボ"}, {"type": "subtitle", "time": 11172.79, "timestamp": "03:06:12", "text": "またはすぐにコラボレーションして彼らとプレイする"}, {"type": "subtitle", "time": 11175.75, "timestamp": "03:06:15", "text": "そして、私は楽しむ。それは私の"}, {"type": "subtitle", "time": 11179.11, "timestamp": "03:06:19", "text": "目標を達成できて本当に嬉しいです"}, {"type": "subtitle", "time": 11181.99, "timestamp": "03:06:21", "text": "それを管理する、それを達成するために管理する"}, {"type": "subtitle", "time": 11183.91, "timestamp": "03:06:23", "text": "ゴール。"}, {"type": "subtitle", "time": 11187.03, "timestamp": "03:06:27", "text": "私はたくさんの人と話したい"}, {"type": "subtitle", "time": 11190.389, "timestamp": "03:06:30", "text": "もっと日本人と話してみよう。欲しい"}, {"type": "subtitle", "time": 11193.11, "timestamp": "03:06:33", "text": "私は人と話したり学んだりするのが好きです"}, {"type": "subtitle", "time": 11195.429, "timestamp": "03:06:35", "text": "彼らについて。"}, {"type": "subtitle", "time": 11197.91, "timestamp": "03:06:37", "text": "あなたはアニメを見ますか？はい、見ています"}, {"type": "subtitle", "time": 11200.71, "timestamp": "03:06:40", "text": "アニメだが、最近は"}, {"type": "subtitle", "time": 11202.87, "timestamp": "03:06:42", "text": "YouTuberとしての活動のおかげで、"}, {"type": "subtitle", "time": 11206.23, "timestamp": "03:06:46", "text": "アニメを見る時間がなかったけど、"}, {"type": "subtitle", "time": 11211.03, "timestamp": "03:06:51", "text": "時間があるときはいつでもアニメを見ています。はい、"}, {"type": "subtitle", "time": 11213.91, "timestamp": "03:06:53", "text": "アニメ。"}, {"type": "subtitle", "time": 11217.59, "timestamp": "03:06:57", "text": "アニメが本当に大好きです。"}]
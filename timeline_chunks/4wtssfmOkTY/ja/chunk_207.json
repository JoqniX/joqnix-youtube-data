[{"type": "subtitle", "time": 12421.51, "timestamp": "03:27:01", "text": "どうしてこの配信を見逃してしまったんだろう？なぜ？なぜ？"}, {"type": "subtitle", "time": 12424.87, "timestamp": "03:27:04", "text": "なぜ？なぜ？なぜ？なぜ？なぜ？"}, {"type": "subtitle", "time": 12428.229, "timestamp": "03:27:08", "text": "なぜ私はこの配信を見逃してしまったのだろう？"}, {"type": "subtitle", "time": 12431.91, "timestamp": "03:27:11", "text": "待って、彼女は3時半に配信したよ"}, {"type": "subtitle", "time": 12436.229, "timestamp": "03:27:16", "text": "3時、いや、3時30分。えっと、"}, {"type": "subtitle", "time": 12439.51, "timestamp": "03:27:19", "text": "待って。私は4時に配信を開始しました。"}, {"type": "subtitle", "time": 12442.15, "timestamp": "03:27:22", "text": "ああ、あの時は、ああ、すごい。その時私は"}, {"type": "subtitle", "time": 12444.71, "timestamp": "03:27:24", "text": "ストリーミング配信中でした。ああ、"}, {"type": "subtitle", "time": 12447.349, "timestamp": "03:27:27", "text": "痛み。"}, {"type": "subtitle", "time": 12450.309, "timestamp": "03:27:30", "text": "Asaとはどういう意味ですか？アサはもっと"}, {"type": "subtitle", "time": 12453.03, "timestamp": "03:27:33", "text": "朝。"}, {"type": "subtitle", "time": 12456.15, "timestamp": "03:27:36", "text": "あなたは彼女を知っていますか？はい、彼女を知っています。"}, {"type": "subtitle", "time": 12459.28, "timestamp": "03:27:39", "text": "シヴァナ・ナビリア。"}, {"type": "subtitle", "time": 12460.63, "timestamp": "03:27:40", "text": "[音楽]"}, {"type": "subtitle", "time": 12465.269, "timestamp": "03:27:45", "text": "そう、私もあなたと同じファンです"}, {"type": "subtitle", "time": 12466.469, "timestamp": "03:27:46", "text": "みんな。"}, {"type": "subtitle", "time": 12470.309, "timestamp": "03:27:50", "text": "スターテープはどこにあるの？"}, {"type": "subtitle", "time": 12472.55, "timestamp": "03:27:52", "text": "YouTuber"}, {"type": "subtitle", "time": 12475.03, "timestamp": "03:27:55", "text": "ママ・セレスティアン"}, {"type": "subtitle", "time": 12476.95, "timestamp": "03:27:56", "text": "ミマン"}, {"type": "subtitle", "time": 12478.55, "timestamp": "03:27:58", "text": "スカン"}]
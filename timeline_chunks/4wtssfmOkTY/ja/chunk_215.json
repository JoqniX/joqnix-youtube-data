[{"type": "subtitle", "time": 12901.75, "timestamp": "03:35:01", "text": "私のサーバーです。はい。つまり、あなたがその人なんですね"}, {"type": "subtitle", "time": 12904.71, "timestamp": "03:35:04", "text": "「はい」とDMを送った人。 「これは誰？」"}, {"type": "subtitle", "time": 12908.15, "timestamp": "03:35:08", "text": "吠える？ わからない。スターズの誰かが"}, {"type": "subtitle", "time": 12911.59, "timestamp": "03:35:11", "text": "子供が私にDMを送ってきた。この吠え声は誰のもの？彼の名前は"}, {"type": "subtitle", "time": 12916.07, "timestamp": "03:35:16", "text": "[音楽]"}, {"type": "subtitle", "time": 12919.349, "timestamp": "03:35:19", "text": "でも、私はモデレーターとして不適格です。"}, {"type": "subtitle", "time": 12922.87, "timestamp": "03:35:22", "text": "えーっと、集中できないから"}, {"type": "subtitle", "time": 12925.19, "timestamp": "03:35:25", "text": "サーバーは、私は忙しいので"}, {"type": "subtitle", "time": 12929.59, "timestamp": "03:35:29", "text": "自分の持ち物。だから私は、"}, {"type": "subtitle", "time": 12932.79, "timestamp": "03:35:32", "text": "時々悪い、私が管理しているとき"}, {"type": "subtitle", "time": 12935.67, "timestamp": "03:35:35", "text": "サーバーでも何でも構いません。残念に思う"}, {"type": "subtitle", "time": 12938.07, "timestamp": "03:35:38", "text": "私はモデレーターとしての仕事をしていないか、"}, {"type": "subtitle", "time": 12942.389, "timestamp": "03:35:42", "text": "何か、探している、またはモデレーションしている、"}, {"type": "subtitle", "time": 12945.03, "timestamp": "03:35:45", "text": "そこにいて、注意深く見守っている"}, {"type": "subtitle", "time": 12946.87, "timestamp": "03:35:46", "text": "目。"}, {"type": "subtitle", "time": 12949.11, "timestamp": "03:35:49", "text": "時々そうする"}, {"type": "subtitle", "time": 12952.55, "timestamp": "03:35:52", "text": "ええと、注意深く見守ってください。はい。"}, {"type": "subtitle", "time": 12955.269, "timestamp": "03:35:55", "text": "うん。しかし"}, {"type": "subtitle", "time": 12958.229, "timestamp": "03:35:58", "text": "ええと、私が注意深く見ていない時は"}]
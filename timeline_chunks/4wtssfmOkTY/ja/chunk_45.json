[{"type": "subtitle", "time": 2701.589, "timestamp": "00:45:01", "text": "X1。おお、"}, {"type": "subtitle", "time": 2703.349, "timestamp": "00:45:03", "text": "わかった。顔面を外すところだったと思う"}, {"type": "subtitle", "time": 2707.349, "timestamp": "00:45:07", "text": "そして生き延びた。私はあのバターを生で見た。"}, {"type": "subtitle", "time": 2710.39, "timestamp": "00:45:10", "text": "はい。どうにか生き延びた。"}, {"type": "subtitle", "time": 2712.87, "timestamp": "00:45:12", "text": "私は生きている。"}, {"type": "subtitle", "time": 2715.91, "timestamp": "00:45:15", "text": "私は数本のストレートストライダーを履いた"}, {"type": "subtitle", "time": 2718.55, "timestamp": "00:45:18", "text": "ストライキにも遭ったが、それでも生き延びた。私は死んだ"}, {"type": "subtitle", "time": 2720.15, "timestamp": "00:45:20", "text": "インパクト。"}, {"type": "subtitle", "time": 2722.55, "timestamp": "00:45:22", "text": "重装甲を着ているんですよね？うん、"}, {"type": "subtitle", "time": 2724.63, "timestamp": "00:45:24", "text": "重い。だから私はこんなにたくさんタンクしているんです"}, {"type": "subtitle", "time": 2726.71, "timestamp": "00:45:26", "text": "ショット。そうだよ、それが君の命を救ったんだ"}, {"type": "subtitle", "time": 2730.15, "timestamp": "00:45:30", "text": "その後、複数回。"}, {"type": "subtitle", "time": 2733.19, "timestamp": "00:45:33", "text": "何てことだ。あれはどこにあるの？"}, {"type": "subtitle", "time": 2736.15, "timestamp": "00:45:36", "text": "よし、これで私も彼に加われると思う。おお、"}, {"type": "subtitle", "time": 2740.71, "timestamp": "00:45:40", "text": "さあ行こう。やったー。結婚すればするほど良い。はい。"}, {"type": "subtitle", "time": 2744.069, "timestamp": "00:45:44", "text": "民主主義。ピューピュー。今行ってる"}, {"type": "subtitle", "time": 2746.39, "timestamp": "00:45:46", "text": "民主主義のために。"}, {"type": "subtitle", "time": 2748.63, "timestamp": "00:45:48", "text": "自由。"}, {"type": "subtitle", "time": 2750.63, "timestamp": "00:45:50", "text": "のために"}, {"type": "subtitle", "time": 2752.87, "timestamp": "00:45:52", "text": "新しいミームや何か"}, {"type": "subtitle", "time": 2754.71, "timestamp": "00:45:54", "text": "めちゃくちゃ多様？私はそうすべきだと思う"}, {"type": "subtitle", "time": 2757.589, "timestamp": "00:45:57", "text": "第三派閥以降、より右派寄りに​​なった。私"}]
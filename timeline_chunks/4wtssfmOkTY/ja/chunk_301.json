[{"type": "subtitle", "time": 18060.39, "timestamp": "05:01:00", "text": "時々、お酒を飲むと"}, {"type": "subtitle", "time": 18063.99, "timestamp": "05:01:03", "text": "何か美味しいものを食べる、"}, {"type": "subtitle", "time": 18067.11, "timestamp": "05:01:07", "text": "あなたは小さな存在になりたいと感じる"}, {"type": "subtitle", "time": 18069.11, "timestamp": "05:01:09", "text": "小さなアリ、"}, {"type": "subtitle", "time": 18072.47, "timestamp": "05:01:12", "text": "あなたが望むようなアリではなく、"}, {"type": "subtitle", "time": 18075.75, "timestamp": "05:01:15", "text": "楽園で眠る"}, {"type": "subtitle", "time": 18078.948, "timestamp": "05:01:18", "text": "特別な甘さ。"}, {"type": "subtitle", "time": 18081.75, "timestamp": "05:01:21", "text": "私が食べたときのように思わない？"}, {"type": "subtitle", "time": 18086.07, "timestamp": "05:01:26", "text": "おいしいバナナ、そうしたいと思った"}, {"type": "subtitle", "time": 18088.55, "timestamp": "05:01:28", "text": "これをずっと食べていたい"}, {"type": "subtitle", "time": 18091.75, "timestamp": "05:01:31", "text": "または、私が飲んでいるときにこの牛乳を作った場合"}, {"type": "subtitle", "time": 18093.75, "timestamp": "05:01:33", "text": "このミルクバニラ味はまるで"}, {"type": "subtitle", "time": 18095.91, "timestamp": "05:01:35", "text": "これをずっと飲み続けたいのは、"}, {"type": "subtitle", "time": 18098.47, "timestamp": "05:01:38", "text": "美味しい。私は消費し続けたい"}, {"type": "subtitle", "time": 18100.948, "timestamp": "05:01:40", "text": "甘さ、そして私は何を見たいのか"}, {"type": "subtitle", "time": 18102.47, "timestamp": "05:01:42", "text": "風味"}, {"type": "subtitle", "time": 18105.91, "timestamp": "05:01:45", "text": "ますます無限に、でも私はできない"}, {"type": "subtitle", "time": 18109.59, "timestamp": "05:01:49", "text": "このカップがほぼ空になった後"}, {"type": "subtitle", "time": 18111.43, "timestamp": "05:01:51", "text": "仕上げ"}, {"type": "subtitle", "time": 18115.51, "timestamp": "05:01:55", "text": "もっと。もっと欲しい。"}, {"type": "subtitle", "time": 18119.51, "timestamp": "05:01:59", "text": "わからない。これが私の気持ちです。"}]
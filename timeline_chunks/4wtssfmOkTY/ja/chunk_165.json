[{"type": "subtitle", "time": 9902.469, "timestamp": "02:45:02", "text": "一つだけ作れたらいいのに"}, {"type": "subtitle", "time": 9906.71, "timestamp": "02:45:06", "text": "チャットで話せばいいんじゃない？"}, {"type": "subtitle", "time": 9914.07, "timestamp": "02:45:14", "text": "でも充電に関しては大きな話題になると思う"}, {"type": "subtitle", "time": 9916.95, "timestamp": "02:45:16", "text": "そして、小さなチャットはゲーム用です。はい。"}, {"type": "subtitle", "time": 9920.95, "timestamp": "02:45:20", "text": "小チャットはゲーム用です。はい。はい。だから私は"}, {"type": "subtitle", "time": 9924.23, "timestamp": "02:45:24", "text": "それを一つにしたい。えっと、私は"}, {"type": "subtitle", "time": 9927.75, "timestamp": "02:45:27", "text": "まあ、作りたい気持ちもあるんだけど"}, {"type": "subtitle", "time": 9929.51, "timestamp": "02:45:29", "text": "より小さい。"}, {"type": "subtitle", "time": 9932.389, "timestamp": "02:45:32", "text": "えっと、私は"}, {"type": "subtitle", "time": 9935.91, "timestamp": "02:45:35", "text": "複数のブラウザソース、なぜならそれらは"}, {"type": "subtitle", "time": 9941.83, "timestamp": "02:45:41", "text": "記憶力をひどく消耗させてしまう可能性があります。"}, {"type": "subtitle", "time": 9945.59, "timestamp": "02:45:45", "text": "だから私は、うーん、"}, {"type": "subtitle", "time": 9950.87, "timestamp": "02:45:50", "text": "私に何ができる？なぜなら、現在私は"}, {"type": "subtitle", "time": 9954.15, "timestamp": "02:45:54", "text": "5 つの重要なブラウザソース"}, {"type": "subtitle", "time": 9959.51, "timestamp": "02:45:59", "text": "えーっと、主にTwitchから、"}]
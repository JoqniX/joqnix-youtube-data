[{"type": "subtitle", "time": 3662.309, "timestamp": "01:01:02", "text": "ほら、もっと人が増えてるよ。"}, {"type": "subtitle", "time": 3669.109, "timestamp": "01:01:09", "text": "彼らは連れてくるのが好きではないと思う"}, {"type": "subtitle", "time": 3671.349, "timestamp": "01:01:11", "text": "自分"}, {"type": "subtitle", "time": 3674.47, "timestamp": "01:01:14", "text": "あ、誰かいるのが見えますね。"}, {"type": "subtitle", "time": 3676.789, "timestamp": "01:01:16", "text": "ああ、このモードを試してみたいんですね？おお、"}, {"type": "subtitle", "time": 3680.15, "timestamp": "01:01:20", "text": "水をありがとう。"}, {"type": "subtitle", "time": 3684.87, "timestamp": "01:01:24", "text": "このモードを試してみますか？何？"}, {"type": "subtitle", "time": 3689.19, "timestamp": "01:01:29", "text": "え、何？あ、待って。あれはレーザーだ。"}, {"type": "subtitle", "time": 3692.39, "timestamp": "01:01:32", "text": "レーザーガード、犬。はい。"}, {"type": "subtitle", "time": 3694.47, "timestamp": "01:01:34", "text": "ジェフ、あなたは"}, {"type": "subtitle", "time": 3697.349, "timestamp": "01:01:37", "text": "あなたはできません。私はできません。待って、待って、待って。"}, {"type": "subtitle", "time": 3700.71, "timestamp": "01:01:40", "text": "いいえ、そうではありません"}, {"type": "subtitle", "time": 3703.43, "timestamp": "01:01:43", "text": "そこには"}, {"type": "subtitle", "time": 3705.51, "timestamp": "01:01:45", "text": "ええ、それだけの期間です。彼は死んだ。私は"}, {"type": "subtitle", "time": 3708.63, "timestamp": "01:01:48", "text": "雑談をしに行く。ああ、私は死んだ。"}, {"type": "subtitle", "time": 3712.069, "timestamp": "01:01:52", "text": "心配しないで、彼は戻ってくるよ。下。来る"}, {"type": "subtitle", "time": 3714.309, "timestamp": "01:01:54", "text": "オン、悪い。"}, {"type": "subtitle", "time": 3715.91, "timestamp": "01:01:55", "text": "ちょっと待って。ちょっと待って。これは、"}, {"type": "subtitle", "time": 3718.95, "timestamp": "01:01:58", "text": "３つ分。これは500キログラム爆弾を必要とする。"}]
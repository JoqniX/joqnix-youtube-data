[{"type": "subtitle", "time": 7032.709, "timestamp": "01:57:12", "text": "えっと、私はスコーチャーが好きです。これは何ですか"}, {"type": "subtitle", "time": 7036.95, "timestamp": "01:57:16", "text": "あれって何？鎌。"}, {"type": "subtitle", "time": 7038.95, "timestamp": "01:57:18", "text": "少なくとも"}, {"type": "subtitle", "time": 7041.43, "timestamp": "01:57:21", "text": "私はクロストークです。私はレーザー兵器が好きです"}, {"type": "subtitle", "time": 7042.95, "timestamp": "01:57:22", "text": "虫に対して。心配する必要はない"}, {"type": "subtitle", "time": 7044.87, "timestamp": "01:57:24", "text": "毎回リロードすることについて"}, {"type": "subtitle", "time": 7047.27, "timestamp": "01:57:27", "text": "それらの数を考えると。"}, {"type": "subtitle", "time": 7054.79, "timestamp": "01:57:34", "text": "そうじゃない。"}, {"type": "subtitle", "time": 7059.99, "timestamp": "01:57:39", "text": "クロスボウは良くない。ああ、いいよ。"}, {"type": "subtitle", "time": 7062.47, "timestamp": "01:57:42", "text": "距離があるのは良いことだ。"}, {"type": "subtitle", "time": 7064.07, "timestamp": "01:57:44", "text": "これがないと良くない"}, {"type": "subtitle", "time": 7065.75, "timestamp": "01:57:45", "text": "距離。はい。最終的には"}, {"type": "subtitle", "time": 7077.75, "timestamp": "01:57:57", "text": "虫の惑星に息を吹き込んで見てみたい"}, {"type": "subtitle", "time": 7079.91, "timestamp": "01:57:59", "text": "もし私がタイタンを倒せるなら、"}]
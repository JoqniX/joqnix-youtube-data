[{"type": "subtitle", "time": 9480.23, "timestamp": "02:38:00", "text": "今日目が覚めたとき、いやいやいやいや"}, {"type": "subtitle", "time": 9483.83, "timestamp": "02:38:03", "text": "起き上がって、とても爽快な気分になった。"}, {"type": "subtitle", "time": 9487.91, "timestamp": "02:38:07", "text": "理由は、昨日巨大な"}, {"type": "subtitle", "time": 9491.67, "timestamp": "02:38:11", "text": "頭痛がする理由がわからない"}, {"type": "subtitle", "time": 9496.309, "timestamp": "02:38:16", "text": "頭痛がひどいので、えっと、まるで"}, {"type": "subtitle", "time": 9499.51, "timestamp": "02:38:19", "text": "歩くことも起き上がることもできなかった"}, {"type": "subtitle", "time": 9502.23, "timestamp": "02:38:22", "text": "椅子。私は、"}, {"type": "subtitle", "time": 9504.55, "timestamp": "02:38:24", "text": "それ以来椅子は"}, {"type": "subtitle", "time": 9513.11, "timestamp": "02:38:33", "text": "とても良かった。昨日私は"}, {"type": "subtitle", "time": 9515.99, "timestamp": "02:38:35", "text": "私の目標の1つを達成しました"}, {"type": "subtitle", "time": 9520.63, "timestamp": "02:38:40", "text": "Jan Nihonと話してコミュニケーションを取りましょう。"}, {"type": "subtitle", "time": 9524.87, "timestamp": "02:38:44", "text": "エマは私の2番目に最初の女の子でした​​が、彼女は"}, {"type": "subtitle", "time": 9528.309, "timestamp": "02:38:48", "text": "私の最初の人になってください。はい。まず、ホン、"}, {"type": "subtitle", "time": 9532.15, "timestamp": "02:38:52", "text": "Apex を一緒にプレイした人、そして"}, {"type": "subtitle", "time": 9537.429, "timestamp": "02:38:57", "text": "たくさんあります。はい。はい。わかりません。"}, {"type": "subtitle", "time": 9539.349, "timestamp": "02:38:59", "text": "君たちがいなければ、それは実現しなかっただろう"}]
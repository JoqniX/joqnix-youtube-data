[{"type": "subtitle", "time": 11821.11, "timestamp": "03:17:01", "text": "[音楽]"}, {"type": "subtitle", "time": 11834.55, "timestamp": "03:17:14", "text": "快適に過ごしてください。今は快適です。"}, {"type": "subtitle", "time": 11836.87, "timestamp": "03:17:16", "text": "えっと、ストーンオーシャンですよね？待って、ストーン"}, {"type": "subtitle", "time": 11838.87, "timestamp": "03:17:18", "text": "海？わからない。パート1はとても"}, {"type": "subtitle", "time": 11840.95, "timestamp": "03:17:20", "text": "遅い。パート2はすごくすごく良いです。一部"}, {"type": "subtitle", "time": 11844.15, "timestamp": "03:17:24", "text": "３は再び遅い。最高"}, {"type": "subtitle", "time": 11849.429, "timestamp": "03:17:29", "text": "次のやつは、ええと、すべて順調です。うん。"}, {"type": "subtitle", "time": 11852.229, "timestamp": "03:17:32", "text": "この特定のBが必要です"}, {"type": "subtitle", "time": 11856.07, "timestamp": "03:17:36", "text": "開始前のバイアスBバイアス"}, {"type": "subtitle", "time": 11860.55, "timestamp": "03:17:40", "text": "えーと、ジョジョを始める前に基本的なこと"}, {"type": "subtitle", "time": 11862.79, "timestamp": "03:17:42", "text": "そうでなければ、"}, {"type": "subtitle", "time": 11866.63, "timestamp": "03:17:46", "text": "視聴を続ける"}, {"type": "subtitle", "time": 11869.75, "timestamp": "03:17:49", "text": "そのため、最初に完了した視聴のみ"}, {"type": "subtitle", "time": 11872.469, "timestamp": "03:17:52", "text": "一部"}, {"type": "subtitle", "time": 11874.07, "timestamp": "03:17:54", "text": "最初の部分を通過すると"}, {"type": "subtitle", "time": 11878.389, "timestamp": "03:17:58", "text": "パート2は面白そうだ。おお"}]
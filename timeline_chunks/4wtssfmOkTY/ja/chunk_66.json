[{"type": "subtitle", "time": 3962.309, "timestamp": "01:06:02", "text": "敬礼をしているような人。うん。"}, {"type": "subtitle", "time": 3965.829, "timestamp": "01:06:05", "text": "私の設定はランダムサイズで何ですか？"}, {"type": "subtitle", "time": 3975.43, "timestamp": "01:06:15", "text": "何てことだ。くそ。"}, {"type": "subtitle", "time": 3978.15, "timestamp": "01:06:18", "text": "私は銀色のマントが大好きです。私は買いました"}, {"type": "subtitle", "time": 3982.23, "timestamp": "01:06:22", "text": "まるで神様が作ったヘルメットみたいで、すごくかっこいい。私"}, {"type": "subtitle", "time": 3983.43, "timestamp": "01:06:23", "text": "読み込み時間が"}, {"type": "subtitle", "time": 3986.23, "timestamp": "01:06:26", "text": "武器を見せるために値上げした。"}, {"type": "subtitle", "time": 3989.349, "timestamp": "01:06:29", "text": "ああ、なんてこった。この武器が大好きだ。"}, {"type": "subtitle", "time": 3993.589, "timestamp": "01:06:33", "text": "第一の防御力は、体質である。"}, {"type": "subtitle", "time": 3997.67, "timestamp": "01:06:37", "text": "これはまさにキスをする人だ。"}, {"type": "subtitle", "time": 4000.63, "timestamp": "01:06:40", "text": "反対だが"}, {"type": "subtitle", "time": 4003.109, "timestamp": "01:06:43", "text": "私たちは、私たちは、主に上昇しています"}, {"type": "subtitle", "time": 4004.71, "timestamp": "01:06:44", "text": "オートモドンと戦うのか、それとも"}, {"type": "subtitle", "time": 4007.51, "timestamp": "01:06:47", "text": "自動運転の優位性に反対？"}, {"type": "subtitle", "time": 4011.829, "timestamp": "01:06:51", "text": "みんな、私は3番目はどうですか？"}, {"type": "subtitle", "time": 4013.67, "timestamp": "01:06:53", "text": "ここにはないよ 彼らはもういない"}, {"type": "subtitle", "time": 4018.23, "timestamp": "01:06:58", "text": "一瞬。痛みって本当に嫌なものだよね。私たちは彼らの"}]
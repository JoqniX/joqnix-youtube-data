[{"type": "subtitle", "time": 6303.27, "timestamp": "01:45:03", "text": "私の。歩行者がいる。落としたばかりです"}, {"type": "subtitle", "time": 6306.39, "timestamp": "01:45:06", "text": "それに対する集中砲火。待って、今撃ってるんだ。"}, {"type": "subtitle", "time": 6309.59, "timestamp": "01:45:09", "text": "危険が迫っている。"}, {"type": "subtitle", "time": 6311.189, "timestamp": "01:45:11", "text": "カイと"}, {"type": "subtitle", "time": 6312.87, "timestamp": "01:45:12", "text": "選択肢を与えられたら？地獄のダイバーたち、沈黙"}, {"type": "subtitle", "time": 6314.87, "timestamp": "01:45:14", "text": "地獄、それともバイオハザード？それらはすべて"}, {"type": "subtitle", "time": 6317.109, "timestamp": "01:45:17", "text": "くそっ。"}, {"type": "subtitle", "time": 6319.27, "timestamp": "01:45:19", "text": "ヘルダイバーズ内部の死亡率は"}, {"type": "subtitle", "time": 6322.47, "timestamp": "01:45:22", "text": "おかしい。"}, {"type": "subtitle", "time": 6325.109, "timestamp": "01:45:25", "text": "ええ、私は文字通り溺死しました"}, {"type": "subtitle", "time": 6327.99, "timestamp": "01:45:27", "text": "雨水。私は雨に溺れた"}, {"type": "subtitle", "time": 6331.189, "timestamp": "01:45:31", "text": "水、それは恥ずかしい。"}, {"type": "subtitle", "time": 6333.75, "timestamp": "01:45:33", "text": "サイレントヒルは心理ホラーだが、"}, {"type": "subtitle", "time": 6335.99, "timestamp": "01:45:35", "text": "それは特定の場所にしか存在しません。"}, {"type": "subtitle", "time": 6338.07, "timestamp": "01:45:38", "text": "バイオハザードは文字通りバイラル"}, {"type": "subtitle", "time": 6339.75, "timestamp": "01:45:39", "text": "ホラー。だから、一番良い場所は"}, {"type": "subtitle", "time": 6342.87, "timestamp": "01:45:42", "text": "実際はサイレントヒルですが、サイレントではありません"}, {"type": "subtitle", "time": 6345.51, "timestamp": "01:45:45", "text": "丘そのもの。世界の残りの地域は"}, {"type": "subtitle", "time": 6347.91, "timestamp": "01:45:47", "text": "大丈夫。サイレントヒルの場所ではない。"}, {"type": "subtitle", "time": 6349.27, "timestamp": "01:45:49", "text": "あなたがそこにいない限り、あなたは"}, {"type": "subtitle", "time": 6351.83, "timestamp": "01:45:51", "text": "大丈夫。前払いを要請します。私は"}, {"type": "subtitle", "time": 6356.07, "timestamp": "01:45:56", "text": "民主的にそれらを取得する"}]
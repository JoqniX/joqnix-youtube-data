[{"type": "subtitle", "time": 4681.51, "timestamp": "01:18:01", "text": "380mm砲弾による斉射で行こうと思います。全て"}, {"type": "subtitle", "time": 4687.51, "timestamp": "01:18:07", "text": "バスター爆弾。"}, {"type": "subtitle", "time": 4692.229, "timestamp": "01:18:12", "text": "アークスロワーの方が優れているのでしょうか？"}, {"type": "subtitle", "time": 4693.91, "timestamp": "01:18:13", "text": "いいえ。投擲武器を"}, {"type": "subtitle", "time": 4698.47, "timestamp": "01:18:18", "text": "自動人形。ああ、なぜ買ってしまったんだろう？"}, {"type": "subtitle", "time": 4699.75, "timestamp": "01:18:19", "text": "大丈夫です。大丈夫です。必要ない"}, {"type": "subtitle", "time": 4701.91, "timestamp": "01:18:21", "text": "アーサーです。アースロワーが必要です"}, {"type": "subtitle", "time": 4703.91, "timestamp": "01:18:23", "text": "大群。ああ、神様。これに対抗して使用できます"}, {"type": "subtitle", "time": 4706.07, "timestamp": "01:18:26", "text": "イルミネーションとか色々だけど、反対"}, {"type": "subtitle", "time": 4707.91, "timestamp": "01:18:27", "text": "自動人形は、使用できるようになる前から、"}, {"type": "subtitle", "time": 4709.43, "timestamp": "01:18:29", "text": "ロケットを持っているから死ぬよ"}, {"type": "subtitle", "time": 4711.59, "timestamp": "01:18:31", "text": "それらは火の中から発射される。それは"}, {"type": "subtitle", "time": 4715.75, "timestamp": "01:18:35", "text": "私がそう言った理由。どちらが良いですか？"}, {"type": "subtitle", "time": 4720.07, "timestamp": "01:18:40", "text": "えーと、スズメバチランチャーかレールガンかレーザー"}, {"type": "subtitle", "time": 4721.669, "timestamp": "01:18:41", "text": "大砲。"}, {"type": "subtitle", "time": 4723.51, "timestamp": "01:18:43", "text": "えっと、ブラストキャノンは使えるので"}, {"type": "subtitle", "time": 4725.03, "timestamp": "01:18:45", "text": "充電式なので、"}, {"type": "subtitle", "time": 4727.51, "timestamp": "01:18:47", "text": "弾薬のことが心配だ。"}, {"type": "subtitle", "time": 4729.669, "timestamp": "01:18:49", "text": "このゲームはどれくらいプレイしましたか？私"}, {"type": "subtitle", "time": 4732.07, "timestamp": "01:18:52", "text": "全てを忘れてしまった。よし、彼が最後だ"}, {"type": "subtitle", "time": 4734.87, "timestamp": "01:18:54", "text": "今はそんな感じ。はい、そうする必要はありません"}]
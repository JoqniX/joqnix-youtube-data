[{"type": "subtitle", "time": 5888.79, "timestamp": "01:38:08", "text": "どうぞよろしくお願いいたします"}, {"type": "subtitle", "time": 5891.03, "timestamp": "01:38:11", "text": "塔を切り倒す。多くの日は"}, {"type": "subtitle", "time": 5893.59, "timestamp": "01:38:13", "text": "ほら、ずいぶん時間が経ったね。"}, {"type": "subtitle", "time": 5896.229, "timestamp": "01:38:16", "text": "[音楽]"}, {"type": "subtitle", "time": 5909.669, "timestamp": "01:38:29", "text": "待って、ああ、やばい。ごめん。種の"}, {"type": "subtitle", "time": 5914.79, "timestamp": "01:38:34", "text": "そこで叫んだ。何てことだ。ああ、しまった。"}, {"type": "subtitle", "time": 5917.109, "timestamp": "01:38:37", "text": "みんな、みんな、ついにやり方がわかったよ"}, {"type": "subtitle", "time": 5920.07, "timestamp": "01:38:40", "text": "入る"}, {"type": "subtitle", "time": 5926.95, "timestamp": "01:38:46", "text": "おい、"}, {"type": "subtitle", "time": 5935.27, "timestamp": "01:38:55", "text": "私は"}, {"type": "subtitle", "time": 5937.91, "timestamp": "01:38:57", "text": "頑張れ、"}]
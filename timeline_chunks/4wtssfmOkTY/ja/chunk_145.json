[{"type": "subtitle", "time": 8702.55, "timestamp": "02:25:02", "text": "別の例として。それは本当だ。"}, {"type": "subtitle", "time": 8704.87, "timestamp": "02:25:04", "text": "最初のドロップで出現する敵の数"}, {"type": "subtitle", "time": 8707.27, "timestamp": "02:25:07", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 8721.51, "timestamp": "02:25:21", "text": "もう一つの社会的エネルギー源。私は推測する"}, {"type": "subtitle", "time": 8724.23, "timestamp": "02:25:24", "text": "もっとパワーが必要だ。年を取ったと感じる"}, {"type": "subtitle", "time": 8726.23, "timestamp": "02:25:26", "text": "クソッ。"}, {"type": "subtitle", "time": 8729.429, "timestamp": "02:25:29", "text": "気分。私もその戦利品を持っています。"}, {"type": "subtitle", "time": 8733.75, "timestamp": "02:25:33", "text": "何てことだ。銃器バー。"}, {"type": "subtitle", "time": 8736.71, "timestamp": "02:25:36", "text": "大丈夫です。この混沌を見ることができる"}, {"type": "subtitle", "time": 8739.67, "timestamp": "02:25:39", "text": "周囲は破壊の渦に包まれている。"}, {"type": "subtitle", "time": 8741.19, "timestamp": "02:25:41", "text": "私はきっと死ぬと思う"}, {"type": "subtitle", "time": 8747.27, "timestamp": "02:25:47", "text": "それ"}, {"type": "subtitle", "time": 8751.83, "timestamp": "02:25:51", "text": "何てことだ。おやすみ、レクサー。ありがとう、"}, {"type": "subtitle", "time": 8754.309, "timestamp": "02:25:54", "text": "ギャング。さよなら。とにかく30日間生き延びろ"}, {"type": "subtitle", "time": 8755.83, "timestamp": "02:25:55", "text": "秒、ジョー。大丈夫ですよ。あなたはやっている"}]
[{"type": "subtitle", "time": 13801.03, "timestamp": "03:50:01", "text": "はい。ええ、そうですね。それで、私は"}, {"type": "subtitle", "time": 13804.71, "timestamp": "03:50:04", "text": "このためにLeorを使用します。"}, {"type": "subtitle", "time": 13806.95, "timestamp": "03:50:06", "text": "もしあなたが望むなら、もしあなたが望むなら"}, {"type": "subtitle", "time": 13810.229, "timestamp": "03:50:10", "text": "効果音を提案してください"}, {"type": "subtitle", "time": 13813.67, "timestamp": "03:50:13", "text": "えーっと、健康的でかわいい、または私たちは"}, {"type": "subtitle", "time": 13815.83, "timestamp": "03:50:15", "text": "冗談めかして"}, {"type": "subtitle", "time": 13817.59, "timestamp": "03:50:17", "text": "音に関するアイデアがあれば教えてください"}, {"type": "subtitle", "time": 13819.429, "timestamp": "03:50:19", "text": "効果、"}, {"type": "subtitle", "time": 13820.62, "timestamp": "03:50:20", "text": "あなたが知っている。"}, {"type": "subtitle", "time": 13822.71, "timestamp": "03:50:22", "text": "[音楽]"}, {"type": "subtitle", "time": 13826.07, "timestamp": "03:50:26", "text": "そして私は何かを作りたい"}, {"type": "subtitle", "time": 13829.189, "timestamp": "03:50:29", "text": "水和アニメーションのように、または"}, {"type": "subtitle", "time": 13831.67, "timestamp": "03:50:31", "text": "何かを作りたいから"}, {"type": "subtitle", "time": 13834.15, "timestamp": "03:50:34", "text": "アニメーションか何かで、"}, {"type": "subtitle", "time": 13835.75, "timestamp": "03:50:35", "text": "いつ"}, {"type": "subtitle", "time": 13839.03, "timestamp": "03:50:39", "text": "えっと、どこかで探してみます"}, {"type": "subtitle", "time": 13841.429, "timestamp": "03:50:41", "text": "提出する。ああ、あなたは提出することができます"}, {"type": "subtitle", "time": 13844.55, "timestamp": "03:50:44", "text": "チャットでの提案"}, {"type": "subtitle", "time": 13847.429, "timestamp": "03:50:47", "text": "またはチャットで名前を教えてください"}, {"type": "subtitle", "time": 13850.07, "timestamp": "03:50:50", "text": "ダウンロードするか、私に送ってください"}, {"type": "subtitle", "time": 13859.51, "timestamp": "03:50:59", "text": "はい。あるいは、このようにすることもできます。こんにちは。"}]
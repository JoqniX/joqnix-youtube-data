[{"type": "subtitle", "time": 3181.03, "timestamp": "00:53:01", "text": "その心臓は実際にああ、なんてことだ。おお"}, {"type": "subtitle", "time": 3182.87, "timestamp": "00:53:02", "text": "我が神よ。"}, {"type": "subtitle", "time": 3187.349, "timestamp": "00:53:07", "text": "皆さん、大丈夫ですか？ええ、そう思います。私は私は"}, {"type": "subtitle", "time": 3190.069, "timestamp": "00:53:10", "text": "バラバラにしたいなら、それがあなたの望みです"}, {"type": "subtitle", "time": 3193.03, "timestamp": "00:53:13", "text": "知る。"}, {"type": "subtitle", "time": 3202.39, "timestamp": "00:53:22", "text": "つまり、それは文字通りすべてを消し去った"}, {"type": "subtitle", "time": 3205.27, "timestamp": "00:53:25", "text": "マップ上の敵。"}, {"type": "subtitle", "time": 3209.349, "timestamp": "00:53:29", "text": "何てことだ。何てことだ。"}, {"type": "subtitle", "time": 3212.63, "timestamp": "00:53:32", "text": "あれが危うく人を殺しかけたのは"}, {"type": "subtitle", "time": 3214.87, "timestamp": "00:53:34", "text": "地形を制圧するよう促された。えっと、なぜ"}, {"type": "subtitle", "time": 3218.87, "timestamp": "00:53:38", "text": "端末が来ないのですか？"}, {"type": "subtitle", "time": 3222.87, "timestamp": "00:53:42", "text": "残念ながらバグです。何？それは"}, {"type": "subtitle", "time": 3225.589, "timestamp": "00:53:45", "text": "バグっている。ええ、それは"}, {"type": "subtitle", "time": 3227.51, "timestamp": "00:53:47", "text": "それは非常に珍しいことです。そうではない"}, {"type": "subtitle", "time": 3230.15, "timestamp": "00:53:50", "text": "非常に頻繁に起こる。それはデモです"}, {"type": "subtitle", "time": 3233.27, "timestamp": "00:53:53", "text": "民主的に否認された。"}, {"type": "subtitle", "time": 3234.87, "timestamp": "00:53:54", "text": "聖なる"}]
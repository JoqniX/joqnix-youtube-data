[{"type": "subtitle", "time": 16754.23, "timestamp": "04:39:14", "text": "難しいですね。男の子。はい、学びます。"}, {"type": "subtitle", "time": 16761.99, "timestamp": "04:39:21", "text": "あのね？見てみましょう。作ってみよう"}, {"type": "subtitle", "time": 16764.39, "timestamp": "04:39:24", "text": "えっと、何か見たいものがあるんです。したい"}, {"type": "subtitle", "time": 16768.23, "timestamp": "04:39:28", "text": "何かを見る。なんだか、"}, {"type": "subtitle", "time": 16772.39, "timestamp": "04:39:32", "text": "私は無理やり歌を覚えようとします。"}, {"type": "subtitle", "time": 16776.39, "timestamp": "04:39:36", "text": "私は失敗した。しかし"}, {"type": "subtitle", "time": 16778.868, "timestamp": "04:39:38", "text": "失敗して、たくさんの間違いを犯す。作る"}, {"type": "subtitle", "time": 16782.868, "timestamp": "04:39:42", "text": "間違いが多かった。しかし"}, {"type": "subtitle", "time": 16785.59, "timestamp": "04:39:45", "text": "私がランダムに歌うとき"}, {"type": "subtitle", "time": 16789.35, "timestamp": "04:39:49", "text": "私自身の歌、"}, {"type": "subtitle", "time": 16793.43, "timestamp": "04:39:53", "text": "私はそうしましたと思う、私はそれなしでそれをしました"}, {"type": "subtitle", "time": 16795.35, "timestamp": "04:39:55", "text": "ミスを減らす。"}, {"type": "subtitle", "time": 16798.628, "timestamp": "04:39:58", "text": "H、そうだと思います。私はしません"}]
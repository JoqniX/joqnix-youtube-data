[{"type": "subtitle", "time": 13441.349, "timestamp": "03:44:01", "text": "まるでそこに住んでいるかのような言い回し"}, {"type": "subtitle", "time": 13443.91, "timestamp": "03:44:03", "text": "無料でやってくれる。うん。つまり、そうではないということだ"}, {"type": "subtitle", "time": 13445.189, "timestamp": "03:44:05", "text": "お金について。つまりあなたは"}, {"type": "subtitle", "time": 13447.91, "timestamp": "03:44:07", "text": "コンテンツクリエイターとして、他のことをするにはどうすればいいですか"}, {"type": "subtitle", "time": 13450.389, "timestamp": "03:44:10", "text": "もの？ああ、そうそうそう。"}, {"type": "subtitle", "time": 13452.469, "timestamp": "03:44:12", "text": "始めたばかりの頃は、あなたは苦労するでしょう。はい、それです"}, {"type": "subtitle", "time": 13455.75, "timestamp": "03:44:15", "text": "あまりにも。はい。"}, {"type": "subtitle", "time": 13457.269, "timestamp": "03:44:17", "text": "うん。"}, {"type": "subtitle", "time": 13479.59, "timestamp": "03:44:39", "text": "はい。はい。あなたが正しい。"}, {"type": "subtitle", "time": 13486.87, "timestamp": "03:44:46", "text": "それもまた事実です。うん。"}, {"type": "subtitle", "time": 13489.189, "timestamp": "03:44:49", "text": "えっと、どこで止まったの？"}, {"type": "subtitle", "time": 13491.91, "timestamp": "03:44:51", "text": "その話について？それで、私たちは公開します"}, {"type": "subtitle", "time": 13496.15, "timestamp": "03:44:56", "text": "サーバーを宣伝して以来"}]
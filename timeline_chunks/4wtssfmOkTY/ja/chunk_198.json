[{"type": "subtitle", "time": 11880.79, "timestamp": "03:18:00", "text": "こんにちは。わかった。"}, {"type": "subtitle", "time": 11883.03, "timestamp": "03:18:03", "text": "つまり、シーズンはいくつあるかってことですね"}, {"type": "subtitle", "time": 11887.83, "timestamp": "03:18:07", "text": "また？ 3シーズン？ 3つか4つ。"}, {"type": "subtitle", "time": 11890.95, "timestamp": "03:18:10", "text": "つまり、3つの部分から構成されていますよね？"}, {"type": "subtitle", "time": 11893.83, "timestamp": "03:18:13", "text": "3つか4つ。"}, {"type": "subtitle", "time": 11897.11, "timestamp": "03:18:17", "text": "私のおしゃべりバカ"}, {"type": "subtitle", "time": 11901.11, "timestamp": "03:18:21", "text": "フントトルム。うん。こんにちは。バカはどう？"}, {"type": "subtitle", "time": 11902.6, "timestamp": "03:18:22", "text": "今日は何をしますか？"}, {"type": "subtitle", "time": 11903.75, "timestamp": "03:18:23", "text": "[音楽]"}, {"type": "subtitle", "time": 11907.75, "timestamp": "03:18:27", "text": "モ、元気かい、バカ？"}, {"type": "subtitle", "time": 11915.33, "timestamp": "03:18:35", "text": "こんにちは、おはようございます。"}, {"type": "subtitle", "time": 11916.79, "timestamp": "03:18:36", "text": "[音楽]"}, {"type": "subtitle", "time": 11924.79, "timestamp": "03:18:44", "text": "はい、"}, {"type": "subtitle", "time": 11926.71, "timestamp": "03:18:46", "text": "もっとそう思う。ええ、そう思います"}, {"type": "subtitle", "time": 11930.79, "timestamp": "03:18:50", "text": "もっと。バカがご飯を食べてる。"}, {"type": "subtitle", "time": 11934.95, "timestamp": "03:18:54", "text": "はい。良い。良い。"}, {"type": "subtitle", "time": 11936.47, "timestamp": "03:18:56", "text": "マーシー。"}]
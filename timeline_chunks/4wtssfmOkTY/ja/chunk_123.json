[{"type": "subtitle", "time": 7381.35, "timestamp": "02:03:01", "text": "死ね、イカのクズども、死ね。死ね、死ね。"}, {"type": "subtitle", "time": 7384.229, "timestamp": "02:03:04", "text": "エンジニアリングキットだが、軽装甲の速度"}, {"type": "subtitle", "time": 7386.39, "timestamp": "02:03:06", "text": "スタミナが高くなるので"}, {"type": "subtitle", "time": 7388.79, "timestamp": "02:03:08", "text": "逃げる光。私はこれまで以上に"}, {"type": "subtitle", "time": 7392.07, "timestamp": "02:03:12", "text": "あなたと共に任務に就けることを誇りに思います。正義。"}, {"type": "subtitle", "time": 7394.79, "timestamp": "02:03:14", "text": "イルミナティは撤退した。今は"}, {"type": "subtitle", "time": 7398.07, "timestamp": "02:03:18", "text": "彼らに報いを受けさせる時が来た。"}, {"type": "subtitle", "time": 7402.55, "timestamp": "02:03:22", "text": "DSS。まるで超超"}, {"type": "subtitle", "time": 7404.709, "timestamp": "02:03:24", "text": "シューマンはどこにいる？ああ、彼がここにいる。私は"}, {"type": "subtitle", "time": 7406.87, "timestamp": "02:03:26", "text": "防具を選ぶ。"}, {"type": "subtitle", "time": 7409.03, "timestamp": "02:03:29", "text": "わかった、"}, {"type": "subtitle", "time": 7410.229, "timestamp": "02:03:30", "text": "塹壕戦法で行こうかな"}, {"type": "subtitle", "time": 7412.87, "timestamp": "02:03:32", "text": "今はエンジニアとして働いています。"}, {"type": "subtitle", "time": 7414.39, "timestamp": "02:03:34", "text": "そして"}, {"type": "subtitle", "time": 7421.35, "timestamp": "02:03:41", "text": "目を閉じてください。"}, {"type": "subtitle", "time": 7430.47, "timestamp": "02:03:50", "text": "さぁ行こう。準備できました。ああ、あった。"}, {"type": "subtitle", "time": 7438.39, "timestamp": "02:03:58", "text": "彼はあなたを連れて行ったのですか"}]
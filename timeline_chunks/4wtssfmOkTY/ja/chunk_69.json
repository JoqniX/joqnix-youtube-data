[{"type": "subtitle", "time": 4141.749, "timestamp": "01:09:01", "text": "私たちの夢の支配者。待って、それは新しい"}, {"type": "subtitle", "time": 4143.51, "timestamp": "01:09:03", "text": "ケープ。"}, {"type": "subtitle", "time": 4145.269, "timestamp": "01:09:05", "text": "ええ、そうです。彼らは新しいものを配っている"}, {"type": "subtitle", "time": 4147.189, "timestamp": "01:09:07", "text": "ケープ"}, {"type": "subtitle", "time": 4149.03, "timestamp": "01:09:09", "text": "特定のイベントについては"}, {"type": "subtitle", "time": 4150.07, "timestamp": "01:09:10", "text": "試合全体を通して起こっていること。私"}, {"type": "subtitle", "time": 4152.63, "timestamp": "01:09:12", "text": "この色、めちゃくちゃ好き。"}, {"type": "subtitle", "time": 4161.269, "timestamp": "01:09:21", "text": "死んだ。"}, {"type": "subtitle", "time": 4165.51, "timestamp": "01:09:25", "text": "爪だけ。ああ、持ってるよ。"}, {"type": "subtitle", "time": 4167.91, "timestamp": "01:09:27", "text": "使えるものがないか見てみよう。もしあなたが"}, {"type": "subtitle", "time": 4169.269, "timestamp": "01:09:29", "text": "ボットを使うなら、"}, {"type": "subtitle", "time": 4175.829, "timestamp": "01:09:35", "text": "ダイナマイト"}, {"type": "subtitle", "time": 4177.43, "timestamp": "01:09:37", "text": "ボブル。"}, {"type": "subtitle", "time": 4181.59, "timestamp": "01:09:41", "text": "ダイナマイトはそれほど良くない"}, {"type": "subtitle", "time": 4183.43, "timestamp": "01:09:43", "text": "私の意見では。私はむしろ"}, {"type": "subtitle", "time": 4185.749, "timestamp": "01:09:45", "text": "私のテルミットを使って。"}, {"type": "subtitle", "time": 4188.95, "timestamp": "01:09:48", "text": "しかし、"}, {"type": "subtitle", "time": 4190.789, "timestamp": "01:09:50", "text": "ダイナマイトは、時間を計って使うことができます。それで"}, {"type": "subtitle", "time": 4193.51, "timestamp": "01:09:53", "text": "5秒、30秒、そして60秒"}, {"type": "subtitle", "time": 4196.39, "timestamp": "01:09:56", "text": "秒。どうやってそれを手に入れるのですか？"}, {"type": "subtitle", "time": 4199.51, "timestamp": "01:09:59", "text": "どれ？シロアリ。"}]
[{"type": "subtitle", "time": 4921.51, "timestamp": "01:22:01", "text": "ええと、バンカータワーを牽引します。"}, {"type": "subtitle", "time": 4924.629, "timestamp": "01:22:04", "text": "おお、いいね。 1人ダウン。ハルクは好きだった"}, {"type": "subtitle", "time": 4927.83, "timestamp": "01:22:07", "text": "自分の部隊を殺したのか？ああ、砲塔"}, {"type": "subtitle", "time": 4935.91, "timestamp": "01:22:15", "text": "やばい、何か音が聞こえる。"}, {"type": "subtitle", "time": 4938.07, "timestamp": "01:22:18", "text": "ええ、ハルクはいますよ。"}, {"type": "subtitle", "time": 4939.91, "timestamp": "01:22:19", "text": "うん。ええ、そこにハルクがいます"}, {"type": "subtitle", "time": 4942.229, "timestamp": "01:22:22", "text": "その間。"}, {"type": "subtitle", "time": 4945.51, "timestamp": "01:22:25", "text": "それは同族を滅ぼしただけだ。私はそれを受け取った"}, {"type": "subtitle", "time": 4948.31, "timestamp": "01:22:28", "text": "下。"}, {"type": "subtitle", "time": 4957.59, "timestamp": "01:22:37", "text": "砲塔はどこにあるんだっけ？できますか？"}, {"type": "subtitle", "time": 4968.87, "timestamp": "01:22:48", "text": "えっと、"}, {"type": "subtitle", "time": 4972.39, "timestamp": "01:22:52", "text": "あれはどこにあるの？"}, {"type": "subtitle", "time": 4975.11, "timestamp": "01:22:55", "text": "え、何？"}]
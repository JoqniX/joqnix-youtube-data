[{"type": "subtitle", "time": 18362.47, "timestamp": "05:06:02", "text": "歌い方で単語の種類や"}, {"type": "subtitle", "time": 18364.23, "timestamp": "05:06:04", "text": "何か"}, {"type": "subtitle", "time": 18367.03, "timestamp": "05:06:07", "text": "そんな感じ。"}, {"type": "subtitle", "time": 18370.788, "timestamp": "05:06:10", "text": "そしてもしあなたが"}, {"type": "subtitle", "time": 18374.948, "timestamp": "05:06:14", "text": "えっと、もしあなたがその曲を作るなら、"}, {"type": "subtitle", "time": 18377.59, "timestamp": "05:06:17", "text": "特定のタイプのビートや"}, {"type": "subtitle", "time": 18381.67, "timestamp": "05:06:21", "text": "あなたが出す音をあなたが出す"}, {"type": "subtitle", "time": 18383.99, "timestamp": "05:06:23", "text": "いつも作る"}, {"type": "subtitle", "time": 18386.23, "timestamp": "05:06:26", "text": "そしてそれはあなたのオリジナルの一部となる"}, {"type": "subtitle", "time": 18389.11, "timestamp": "05:06:29", "text": "音、あなた自身の音、あなた独自の音"}, {"type": "subtitle", "time": 18394.27, "timestamp": "05:06:34", "text": "音、ほら、そんな感じ。"}, {"type": "subtitle", "time": 18396.23, "timestamp": "05:06:36", "text": "[音楽]"}]
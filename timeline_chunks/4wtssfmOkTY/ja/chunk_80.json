[{"type": "subtitle", "time": 4801.91, "timestamp": "01:20:01", "text": "また。"}, {"type": "subtitle", "time": 4803.75, "timestamp": "01:20:03", "text": "そうそう。私はその取引マニュアルのヒントを得ました"}, {"type": "subtitle", "time": 4805.51, "timestamp": "01:20:05", "text": "けれど。"}, {"type": "subtitle", "time": 4808.07, "timestamp": "01:20:08", "text": "私も。の定義は何ですか"}, {"type": "subtitle", "time": 4810.229, "timestamp": "01:20:10", "text": "狂気？"}, {"type": "subtitle", "time": 4812.79, "timestamp": "01:20:12", "text": "このゲームでもフレームレートが低下しますか？"}, {"type": "subtitle", "time": 4814.47, "timestamp": "01:20:14", "text": "うん、"}, {"type": "subtitle", "time": 4817.51, "timestamp": "01:20:17", "text": "あまりない。ストリームのFPSが低下していると思います"}, {"type": "subtitle", "time": 4819.27, "timestamp": "01:20:19", "text": "また。"}, {"type": "subtitle", "time": 4823.03, "timestamp": "01:20:23", "text": "ジョークが分かった。さあ行こう。"}, {"type": "subtitle", "time": 4826.87, "timestamp": "01:20:26", "text": "再び武装し、危険な状態に戻った。"}, {"type": "subtitle", "time": 4829.35, "timestamp": "01:20:29", "text": "彼らに喧嘩をさせておけばいい。彼らに直面させよう"}, {"type": "subtitle", "time": 4832.149, "timestamp": "01:20:32", "text": "地獄の潜水夫たちの圧倒的な力。"}, {"type": "subtitle", "time": 4856.87, "timestamp": "01:20:56", "text": "この銃は群衆制御に優れています"}, {"type": "subtitle", "time": 4859.59, "timestamp": "01:20:59", "text": "より小型のユニット。"}]
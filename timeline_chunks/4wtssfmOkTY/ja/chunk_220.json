[{"type": "subtitle", "time": 13200.229, "timestamp": "03:40:00", "text": "これは難しい。あなたは本当に何をしているのですか？"}, {"type": "subtitle", "time": 13202.309, "timestamp": "03:40:02", "text": "今は難しいですか？"}, {"type": "subtitle", "time": 13206.07, "timestamp": "03:40:06", "text": "ヨシ。ヨシ。ヘッドパッド。"}, {"type": "subtitle", "time": 13208.55, "timestamp": "03:40:08", "text": "ヘッドパッドが必要です。あなたはとても一生懸命働いて"}, {"type": "subtitle", "time": 13218.95, "timestamp": "03:40:18", "text": "あなたは本当に努力家ですね。私は痛みを知っている"}, {"type": "subtitle", "time": 13221.67, "timestamp": "03:40:21", "text": "サーバーの作成とか、そういうこと全部です。"}, {"type": "subtitle", "time": 13233.11, "timestamp": "03:40:33", "text": "いい人だ。"}, {"type": "subtitle", "time": 13235.269, "timestamp": "03:40:35", "text": "では、好きになるまで何日かかりましたか？"}, {"type": "subtitle", "time": 13237.91, "timestamp": "03:40:37", "text": "全てを完全に終わらせますか？"}, {"type": "subtitle", "time": 13240.63, "timestamp": "03:40:40", "text": "ヘッドがボードをセットアップし、"}, {"type": "subtitle", "time": 13242.15, "timestamp": "03:40:42", "text": "埋め込み、"}, {"type": "subtitle", "time": 13246.07, "timestamp": "03:40:46", "text": "全ての物、配置、"}, {"type": "subtitle", "time": 13248.87, "timestamp": "03:40:48", "text": "すべて、権限、"}, {"type": "subtitle", "time": 13257.59, "timestamp": "03:40:57", "text": "しばらく時間がかかると思う。"}, {"type": "subtitle", "time": 13259.349, "timestamp": "03:40:59", "text": "右？"}]
[{"type": "subtitle", "time": 11403.67, "timestamp": "03:10:03", "text": "主に王様。ああ、あなたは長かった。"}, {"type": "subtitle", "time": 11407.03, "timestamp": "03:10:07", "text": "こんにちは。そして、頑張れよ。ストリームがクラッシュしました"}, {"type": "subtitle", "time": 11411.99, "timestamp": "03:10:11", "text": "たくさん。画面が頻繁にクラッシュした。"}, {"type": "subtitle", "time": 11421.349, "timestamp": "03:10:21", "text": "おお。 423 のように完了したのを見てください"}, {"type": "subtitle", "time": 11426.309, "timestamp": "03:10:26", "text": "アニメ。おお。 76人が視聴しています。ニース。"}, {"type": "subtitle", "time": 11427.99, "timestamp": "03:10:27", "text": "772"}, {"type": "subtitle", "time": 11430.71, "timestamp": "03:10:30", "text": "観る予定です。ニース。それで"}, {"type": "subtitle", "time": 11433.83, "timestamp": "03:10:33", "text": "私のように、私はたくさんの計画を持っています"}, {"type": "subtitle", "time": 11435.51, "timestamp": "03:10:35", "text": "時計。"}, {"type": "subtitle", "time": 11439.269, "timestamp": "03:10:39", "text": "視聴予定の作品が118本あります。完了"}, {"type": "subtitle", "time": 11444.87, "timestamp": "03:10:44", "text": "589で、視聴者数は150 48です。"}, {"type": "subtitle", "time": 11446.389, "timestamp": "03:10:46", "text": "うん。"}, {"type": "subtitle", "time": 11450.55, "timestamp": "03:10:50", "text": "ああ。よし。"}, {"type": "subtitle", "time": 11453.349, "timestamp": "03:10:53", "text": "種の。えーと、それで、私はちょっと"}, {"type": "subtitle", "time": 11455.51, "timestamp": "03:10:55", "text": "熱。だから私はただリラックスする"}, {"type": "subtitle", "time": 11458.15, "timestamp": "03:10:58", "text": "あなたを見ているよ。こんにちは。こんにちは。"}]
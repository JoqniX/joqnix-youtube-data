[{"type": "subtitle", "time": 10860.95, "timestamp": "03:01:00", "text": "今日はどんな一日でしたか？私の一日は"}, {"type": "subtitle", "time": 10862.79, "timestamp": "03:01:02", "text": "良い。"}, {"type": "subtitle", "time": 10868.309, "timestamp": "03:01:08", "text": "昨日は、とても長い流れだった。"}, {"type": "subtitle", "time": 10870.95, "timestamp": "03:01:10", "text": "最近は5時間、6時間勉強しています"}, {"type": "subtitle", "time": 10873.269, "timestamp": "03:01:13", "text": "朝から流れ出る。アサダは"}, {"type": "subtitle", "time": 10876.87, "timestamp": "03:01:16", "text": "5時間持続します。それから配信をします。"}, {"type": "subtitle", "time": 10880.15, "timestamp": "03:01:20", "text": "その後は、私がどこで配信するかによります"}, {"type": "subtitle", "time": 10882.309, "timestamp": "03:01:22", "text": "今日のようにTwitchで配信します。昨日"}, {"type": "subtitle", "time": 10885.11, "timestamp": "03:01:25", "text": "YouTube で配信され、そのストリームは"}, {"type": "subtitle", "time": 10888.15, "timestamp": "03:01:28", "text": "少なくとも5時間くらいは。五"}, {"type": "subtitle", "time": 10891.67, "timestamp": "03:01:31", "text": "5時間または4時間。私はバカみたい"}, {"type": "subtitle", "time": 10894.71, "timestamp": "03:01:34", "text": "騎手はストレスを溜めすぎないように"}, {"type": "subtitle", "time": 10897.99, "timestamp": "03:01:37", "text": "でも昨日はちょっとストレスが溜まりすぎた"}, {"type": "subtitle", "time": 10901.19, "timestamp": "03:01:41", "text": "頭痛とか色々あったんです"}, {"type": "subtitle", "time": 10904.389, "timestamp": "03:01:44", "text": "どうやって話していたのかさえわからない"}, {"type": "subtitle", "time": 10906.87, "timestamp": "03:01:46", "text": "そして、ご存知のようにストリーム配信をしていますが"}, {"type": "subtitle", "time": 10909.269, "timestamp": "03:01:49", "text": "ええ、偏頭痛がしていたか"}, {"type": "subtitle", "time": 10912.71, "timestamp": "03:01:52", "text": "何かして、私は自分の"}, {"type": "subtitle", "time": 10916.79, "timestamp": "03:01:56", "text": "頭痛がするけど、うん、でも、終わった"}, {"type": "subtitle", "time": 10919.03, "timestamp": "03:01:59", "text": "小川と"}]
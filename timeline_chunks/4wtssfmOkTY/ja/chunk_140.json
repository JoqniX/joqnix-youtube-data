[{"type": "subtitle", "time": 8402.07, "timestamp": "02:20:02", "text": "友達。とにかく走るしかないと思う。"}, {"type": "subtitle", "time": 8406.15, "timestamp": "02:20:06", "text": "何てことだ。ちくしょう、ジョック。こんにちは。いいえ。ああ、"}, {"type": "subtitle", "time": 8409.11, "timestamp": "02:20:09", "text": "ダイビング。ダイビング。追いかけて。"}, {"type": "subtitle", "time": 8410.87, "timestamp": "02:20:10", "text": "私は暗号化されたハードドライブを選びます。"}, {"type": "subtitle", "time": 8412.71, "timestamp": "02:20:12", "text": "私はできるだけ多くの戦いを避けるつもりです"}, {"type": "subtitle", "time": 8421.51, "timestamp": "02:20:21", "text": "わかった。要するに、私たちはこれをやらなければならないのです。"}, {"type": "subtitle", "time": 8425.83, "timestamp": "02:20:25", "text": "私たちが持っているものは選択肢にすらありません"}, {"type": "subtitle", "time": 8434.55, "timestamp": "02:20:34", "text": "どうすればいいのかわからない。もしかしたらあなたは"}, {"type": "subtitle", "time": 8437.91, "timestamp": "02:20:37", "text": "こっそり行ってもいいかな？わかった、"}, {"type": "subtitle", "time": 8440.469, "timestamp": "02:20:40", "text": "ちょっと待ってください。こっそりやってみます"}, {"type": "subtitle", "time": 8443.59, "timestamp": "02:20:43", "text": "「できないのが嫌だ」というだけではなく"}, {"type": "subtitle", "time": 8446.79, "timestamp": "02:20:46", "text": "ただ回り道をすればいい。"}, {"type": "subtitle", "time": 8449.83, "timestamp": "02:20:49", "text": "問題は、地図が全く見えないことだ。"}, {"type": "subtitle", "time": 8458.309, "timestamp": "02:20:58", "text": "高度な兵器を要請します。する必要がある"}]
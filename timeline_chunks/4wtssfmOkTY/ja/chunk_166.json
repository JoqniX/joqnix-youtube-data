[{"type": "subtitle", "time": 9964.309, "timestamp": "02:46:04", "text": "見る。それで、ブラウザのメインはえーと"}, {"type": "subtitle", "time": 9967.269, "timestamp": "02:46:07", "text": "ピクセルチャットがあるシーン。カパゲン。"}, {"type": "subtitle", "time": 9970.469, "timestamp": "02:46:10", "text": "Capagenは、絵文字を入力するときに使用するものです。"}, {"type": "subtitle", "time": 9973.269, "timestamp": "02:46:13", "text": "Twitchでエモートをしたり、"}, {"type": "subtitle", "time": 9976.07, "timestamp": "02:46:16", "text": "YouTubeでは、画面に表示されます。それ"}, {"type": "subtitle", "time": 9978.469, "timestamp": "02:46:18", "text": "カパゲンを1つ取り出し、トリガーを引いて発射する。私は"}, {"type": "subtitle", "time": 9981.59, "timestamp": "02:46:21", "text": "Twitchのレビューのために発砲を仕掛ける。あなた"}, {"type": "subtitle", "time": 9985.99, "timestamp": "02:46:25", "text": "YouTubeで使用できます。はい、そして"}, {"type": "subtitle", "time": 9989.67, "timestamp": "02:46:29", "text": "ストリーム要素の主なアラート。"}, {"type": "subtitle", "time": 10002.389, "timestamp": "02:46:42", "text": "問題は、主な理由は"}, {"type": "subtitle", "time": 10007.59, "timestamp": "02:46:47", "text": "何て言うんだっけ"}, {"type": "subtitle", "time": 10013.349, "timestamp": "02:46:53", "text": "明らかなことを最適化する"}, {"type": "subtitle", "time": 10014.95, "timestamp": "02:46:54", "text": "のように"}, {"type": "subtitle", "time": 10018.95, "timestamp": "02:46:58", "text": "えっと、今は779です"}]
[{"type": "subtitle", "time": 2041.669, "timestamp": "00:34:01", "text": "今、あなたのところへ向かっています。"}, {"type": "subtitle", "time": 2044.71, "timestamp": "00:34:04", "text": "君は昔はこのゲームのプロだったよね"}, {"type": "subtitle", "time": 2047.029, "timestamp": "00:34:07", "text": "昔はそうだった。いいえ、違います。私は違います。"}, {"type": "subtitle", "time": 2050.47, "timestamp": "00:34:10", "text": "私は狙っていません。私の銃は照準を合わせていない"}, {"type": "subtitle", "time": 2052.149, "timestamp": "00:34:12", "text": "腕を骨折しているからです。しかしそれは"}, {"type": "subtitle", "time": 2055.589, "timestamp": "00:34:15", "text": "大丈夫。私は歩けます。歩いてしまえば治るよ。"}, {"type": "subtitle", "time": 2059.109, "timestamp": "00:34:19", "text": "イエス・キリスト。そこで死にかけた。"}, {"type": "subtitle", "time": 2061.43, "timestamp": "00:34:21", "text": "ああ、友情よ。"}, {"type": "subtitle", "time": 2064.069, "timestamp": "00:34:24", "text": "友情。"}, {"type": "subtitle", "time": 2065.43, "timestamp": "00:34:25", "text": "君たちは、"}, {"type": "subtitle", "time": 2068.31, "timestamp": "00:34:28", "text": "友情？でも、私はあなたにそう言います。マークするだけ"}, {"type": "subtitle", "time": 2070.629, "timestamp": "00:34:30", "text": "地図上に表示してください。あなたのところへ行くよ。"}, {"type": "subtitle", "time": 2072.47, "timestamp": "00:34:32", "text": "ええ、もちろんです。"}, {"type": "subtitle", "time": 2075.909, "timestamp": "00:34:35", "text": "わかった。私はロボットに囲まれています"}, {"type": "subtitle", "time": 2079.349, "timestamp": "00:34:39", "text": "友情を求める噛みつき。そうだと思います。は"}, {"type": "subtitle", "time": 2086.23, "timestamp": "00:34:46", "text": "うん。うん。良い、"}, {"type": "subtitle", "time": 2089.109, "timestamp": "00:34:49", "text": "彼らは惑星なしで終わったと思うし"}, {"type": "subtitle", "time": 2092.149, "timestamp": "00:34:52", "text": "彼らは先に進んだ。でもまだ私たちは"}, {"type": "chat", "time": 2094.966, "timestamp": "00:34:54", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "welcome back joq"}, {"type": "subtitle", "time": 2095.03, "timestamp": "00:34:55", "text": "まだプレイしてるの？疑問符。いいえ"}, {"type": "subtitle", "time": 2098.95, "timestamp": "00:34:58", "text": "今。おお。"}]
[{"type": "subtitle", "time": 15966.95, "timestamp": "04:26:06", "text": "大丈夫でしょう。うん。するとそれは"}, {"type": "subtitle", "time": 15969.429, "timestamp": "04:26:09", "text": "私はむしろ"}, {"type": "subtitle", "time": 15979.59, "timestamp": "04:26:19", "text": "はい。それも私のお気に入りの一つです"}, {"type": "subtitle", "time": 15981.91, "timestamp": "04:26:21", "text": "歌。はい。"}, {"type": "subtitle", "time": 15984.389, "timestamp": "04:26:24", "text": "はい。はい。"}, {"type": "subtitle", "time": 15994.389, "timestamp": "04:26:34", "text": "えっと"}, {"type": "subtitle", "time": 15996.79, "timestamp": "04:26:36", "text": "いいえ"}, {"type": "subtitle", "time": 15999.91, "timestamp": "04:26:39", "text": "しかし、学ぶとき"}, {"type": "subtitle", "time": 16006.63, "timestamp": "04:26:46", "text": "それを聞いて歌ってみると"}, {"type": "subtitle", "time": 16009.429, "timestamp": "04:26:49", "text": "こんな感じになるだろう"}, {"type": "subtitle", "time": 16014.79, "timestamp": "04:26:54", "text": "歌っているのに、歌詞の一部が抜けてしまう。"}, {"type": "subtitle", "time": 16018.229, "timestamp": "04:26:58", "text": "キラキラさせるのは難しい。人々はそれを好まない。"}]
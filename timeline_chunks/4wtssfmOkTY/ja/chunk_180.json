[{"type": "subtitle", "time": 10801.349, "timestamp": "03:00:01", "text": "でも、一番最初の友達だった。私の"}, {"type": "subtitle", "time": 10804.23, "timestamp": "03:00:04", "text": "でも友達？あなたは既に私の意見を述べている。くそ"}, {"type": "subtitle", "time": 10816.79, "timestamp": "03:00:16", "text": "私の友人はそう思っていた。"}, {"type": "subtitle", "time": 10838.87, "timestamp": "03:00:38", "text": "いつか旅行に行きたい"}, {"type": "subtitle", "time": 10847.03, "timestamp": "03:00:47", "text": "多くの都市や人々を見る"}, {"type": "subtitle", "time": 10855.59, "timestamp": "03:00:55", "text": "私は人生の喜びを感じ、楽しんでいます"}, {"type": "subtitle", "time": 10858.469, "timestamp": "03:00:58", "text": "たくさん。"}]
[{"type": "subtitle", "time": 6134.629, "timestamp": "01:42:14", "text": "敵は全員海上に上陸している"}, {"type": "subtitle", "time": 6139.03, "timestamp": "01:42:19", "text": "下を見ると、すべての場所が見えます。おお、"}, {"type": "subtitle", "time": 6141.75, "timestamp": "01:42:21", "text": "こんにちは、シューマ。申し訳ありませんでした。あ、こんにちは。私の"}, {"type": "subtitle", "time": 6144.07, "timestamp": "01:42:24", "text": "グレネードランチャー。あなたは実際に私を"}, {"type": "subtitle", "time": 6147.27, "timestamp": "01:42:27", "text": "3つの希少なサンプルを発見した。"}, {"type": "subtitle", "time": 6157.189, "timestamp": "01:42:37", "text": "しかし、彼らは死ぬだろう。"}, {"type": "subtitle", "time": 6159.75, "timestamp": "01:42:39", "text": "あれはハルクだ。私はもうダメだ。"}, {"type": "subtitle", "time": 6166.149, "timestamp": "01:42:46", "text": "おお。"}, {"type": "subtitle", "time": 6169.59, "timestamp": "01:42:49", "text": "ハルクを手に入れろ。接触は禁止だ。"}]
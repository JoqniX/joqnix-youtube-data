[{"type": "subtitle", "time": 16500.31, "timestamp": "04:35:00", "text": "えっと、ちょっと待って。ゲームシーンに切り替えると、"}, {"type": "subtitle", "time": 16504.949, "timestamp": "04:35:04", "text": "あ、待って、これうっかりやっちゃった。"}, {"type": "subtitle", "time": 16522.31, "timestamp": "04:35:22", "text": "あ、待って。私は大きなバカなことをしました"}, {"type": "subtitle", "time": 16527.83, "timestamp": "04:35:27", "text": "間違い。だから、会話シーンに切り替えたら"}, {"type": "subtitle", "time": 16531.429, "timestamp": "04:35:31", "text": "チャットボックスは正しく表示されます"}, {"type": "subtitle", "time": 16535.029, "timestamp": "04:35:35", "text": "ゲームチャットは表示されません"}, {"type": "subtitle", "time": 16538.789, "timestamp": "04:35:38", "text": "するとフィルターが通常モードに切り替わります。"}, {"type": "subtitle", "time": 16541.349, "timestamp": "04:35:41", "text": "はい、直しました。はい、結構です。今"}, {"type": "subtitle", "time": 16545.51, "timestamp": "04:35:45", "text": "良いでしょう。そうねぇ。話す。はい。今"}, {"type": "subtitle", "time": 16549.429, "timestamp": "04:35:49", "text": "ゲーム。はい。わかった。良い。こんにちは。その"}, {"type": "subtitle", "time": 16556.31, "timestamp": "04:35:56", "text": "ニース。"}]
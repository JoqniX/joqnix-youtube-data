[{"type": "subtitle", "time": 11354.07, "timestamp": "03:09:14", "text": "[音楽]"}, {"type": "subtitle", "time": 11357.19, "timestamp": "03:09:17", "text": "ああ、君のことは分かったよ。お願いがあります。させて"}, {"type": "subtitle", "time": 11359.11, "timestamp": "03:09:19", "text": "友達に追加します。あなたを追加する"}, {"type": "subtitle", "time": 11360.71, "timestamp": "03:09:20", "text": "友人。"}, {"type": "subtitle", "time": 11370.469, "timestamp": "03:09:30", "text": "こんにちは。友達リクエストを送信しました。"}, {"type": "subtitle", "time": 11373.03, "timestamp": "03:09:33", "text": "何てことだ。なぜ私にはたくさんの友達がいるのか"}, {"type": "subtitle", "time": 11376.23, "timestamp": "03:09:36", "text": "リクエストですか？ああ、なんてことだ。何"}, {"type": "subtitle", "time": 11383.429, "timestamp": "03:09:43", "text": "友達リクエストが17件届いています。何？不在。"}, {"type": "subtitle", "time": 11386.469, "timestamp": "03:09:46", "text": "これは"}, {"type": "subtitle", "time": 11389.269, "timestamp": "03:09:49", "text": "ああ、これは私が自分の"}, {"type": "subtitle", "time": 11391.99, "timestamp": "03:09:51", "text": "動物"}, {"type": "subtitle", "time": 11399.429, "timestamp": "03:09:59", "text": "ババ。君が3回プレーするのを見ていた"}]
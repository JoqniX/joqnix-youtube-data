[{"type": "subtitle", "time": 5100.47, "timestamp": "01:25:00", "text": "見てみたい。"}, {"type": "subtitle", "time": 5107.83, "timestamp": "01:25:07", "text": "あなた自身が想像するのと同じように。それは"}, {"type": "subtitle", "time": 5109.35, "timestamp": "01:25:09", "text": "面白い。"}, {"type": "subtitle", "time": 5112.31, "timestamp": "01:25:12", "text": "それはすごく面白い動画になりそうですね。"}, {"type": "subtitle", "time": 5114.55, "timestamp": "01:25:14", "text": "その通り。"}, {"type": "subtitle", "time": 5118.629, "timestamp": "01:25:18", "text": "ああ、しまった。ああ、死んだ。何だって？えっと、"}, {"type": "subtitle", "time": 5121.03, "timestamp": "01:25:21", "text": "みんな、僕は地面の中にいるよ。"}, {"type": "subtitle", "time": 5124.39, "timestamp": "01:25:24", "text": "私はあなたの近くにいるように援護します。ありがとう。"}, {"type": "subtitle", "time": 5127.669, "timestamp": "01:25:27", "text": "ああ、しまった。ああ、しまった。"}, {"type": "subtitle", "time": 5130.149, "timestamp": "01:25:30", "text": "それを見たよ。私はそれらの中に入った"}, {"type": "subtitle", "time": 5136.39, "timestamp": "01:25:36", "text": "あれはどこにあるの？絶対に"}, {"type": "subtitle", "time": 5139.75, "timestamp": "01:25:39", "text": "今回は見逃してあげよう。"}, {"type": "subtitle", "time": 5141.669, "timestamp": "01:25:41", "text": "ああ、しまった。"}, {"type": "subtitle", "time": 5144.229, "timestamp": "01:25:44", "text": "よし、これでいい。彼はなぜ死んでいないのか"}, {"type": "subtitle", "time": 5149.43, "timestamp": "01:25:49", "text": "それ？ああ、それは大変だ。"}, {"type": "subtitle", "time": 5157.91, "timestamp": "01:25:57", "text": "最悪だ。再装填してください。 Freddy SB に登場します"}]
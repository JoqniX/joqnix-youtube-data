[{"type": "subtitle", "time": 13141.99, "timestamp": "03:39:01", "text": "多くのベンチャーキャピタル。"}, {"type": "subtitle", "time": 13144.95, "timestamp": "03:39:04", "text": "えっと、代わりに何ができるか知ってる？"}, {"type": "subtitle", "time": 13148.229, "timestamp": "03:39:08", "text": "これ？一時的な音声を追加できます"}, {"type": "subtitle", "time": 13152.309, "timestamp": "03:39:12", "text": "チャンネルみたいなやつ、えっと、作った"}, {"type": "subtitle", "time": 13153.91, "timestamp": "03:39:13", "text": "のために"}, {"type": "subtitle", "time": 13157.349, "timestamp": "03:39:17", "text": "えーと、スタースケープ。たくさん持つ代わりに"}, {"type": "subtitle", "time": 13159.429, "timestamp": "03:39:19", "text": "VCチャンネル、"}, {"type": "subtitle", "time": 13163.59, "timestamp": "03:39:23", "text": "一時的なVC VCのようなものを作成できます。"}, {"type": "subtitle", "time": 13166.15, "timestamp": "03:39:26", "text": "だから人々は一時的に"}, {"type": "subtitle", "time": 13169.11, "timestamp": "03:39:29", "text": "部屋。だから、あなたは必要とする必要はありません"}, {"type": "subtitle", "time": 13174.87, "timestamp": "03:39:34", "text": "えっと、やらなくてもいいんだよ"}, {"type": "subtitle", "time": 13179.59, "timestamp": "03:39:39", "text": "複数のVC関連のもの。はい。"}, {"type": "subtitle", "time": 13183.67, "timestamp": "03:39:43", "text": "ああ、一時的なVCですね。ああ、それはありますよ"}, {"type": "subtitle", "time": 13190.229, "timestamp": "03:39:50", "text": "はい。"}, {"type": "subtitle", "time": 13196.469, "timestamp": "03:39:56", "text": "あなたはよく働きましたね。いいえ、はい。あなたは働いた"}]
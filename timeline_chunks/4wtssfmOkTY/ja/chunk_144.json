[{"type": "subtitle", "time": 8652.23, "timestamp": "02:24:12", "text": "私は文字通りただ飛び込んでいるだけです。 RXR、ようこそ"}, {"type": "subtitle", "time": 8656.95, "timestamp": "02:24:16", "text": "襲撃の3つのテイクへ。はぁ？"}, {"type": "subtitle", "time": 8658.95, "timestamp": "02:24:18", "text": "ちくしょう、この[ __ ]め。"}, {"type": "subtitle", "time": 8660.95, "timestamp": "02:24:20", "text": "私は時間内にそれを手に入れることができませんでした。"}, {"type": "subtitle", "time": 8663.75, "timestamp": "02:24:23", "text": "それは、その地面です。"}, {"type": "subtitle", "time": 8667.91, "timestamp": "02:24:27", "text": "ああ、誰が気にするんだ？全く問題ありません。"}, {"type": "subtitle", "time": 8674.55, "timestamp": "02:24:34", "text": "彼はコラボレーションをしていた"}, {"type": "subtitle", "time": 8679.67, "timestamp": "02:24:39", "text": "君たちが何をプレイしていたのかは知らないよ。"}, {"type": "subtitle", "time": 8681.03, "timestamp": "02:24:41", "text": "私は配信中でした。理解できなかった"}, {"type": "subtitle", "time": 8684.15, "timestamp": "02:24:44", "text": "それがあった場所。"}, {"type": "subtitle", "time": 8685.67, "timestamp": "02:24:45", "text": "彼の様子はどうですか？良い一日をお過ごしください"}, {"type": "subtitle", "time": 8687.03, "timestamp": "02:24:47", "text": "休む。ちなみに、彼らは"}, {"type": "subtitle", "time": 8689.89, "timestamp": "02:24:49", "text": "しばらくの間、ストリーミング配信を続けます。何か見つけた。"}, {"type": "subtitle", "time": 8694.95, "timestamp": "02:24:54", "text": "この任務は予想以上に困難だ。"}, {"type": "subtitle", "time": 8697.429, "timestamp": "02:24:57", "text": "実を言うと。私は本当に嫌いです、いいえ、"}, {"type": "subtitle", "time": 8699.27, "timestamp": "02:24:59", "text": "問題は、私たちが長くないということです。彼らはただ行く"}]
[{"type": "subtitle", "time": 16920.708, "timestamp": "04:42:00", "text": "前回のTwitch配信から。だからそれは"}, {"type": "subtitle", "time": 16924.948, "timestamp": "04:42:04", "text": "このコードにログインしました。はい、そうです。"}, {"type": "subtitle", "time": 16931.83, "timestamp": "04:42:11", "text": "まだ見えていない。ああ、そう、私は"}, {"type": "subtitle", "time": 16933.91, "timestamp": "04:42:13", "text": "それを有効にする。人々に与える必要がある"}, {"type": "subtitle", "time": 16936.708, "timestamp": "04:42:16", "text": "これに対する許可。はい。"}, {"type": "subtitle", "time": 16940.31, "timestamp": "04:42:20", "text": "そして、チャットがなぜ"}, {"type": "subtitle", "time": 16942.868, "timestamp": "04:42:22", "text": "上？チャットの配置がなぜ"}, {"type": "subtitle", "time": 16947.83, "timestamp": "04:42:27", "text": "間違っている？我慢する。何が起こっているのか？"}, {"type": "subtitle", "time": 16967.19, "timestamp": "04:42:47", "text": "ああ、君たち二人は普通のゲームをする"}, {"type": "subtitle", "time": 16969.27, "timestamp": "04:42:49", "text": "半分"}, {"type": "subtitle", "time": 16971.59, "timestamp": "04:42:51", "text": "チャット。それは、ああ、ベイビー、私は"}]
[{"type": "subtitle", "time": 11522.309, "timestamp": "03:12:02", "text": "これらのものを削除したい。それはとても"}, {"type": "subtitle", "time": 11528.55, "timestamp": "03:12:08", "text": "削除したい"}, {"type": "subtitle", "time": 11531.75, "timestamp": "03:12:11", "text": "だって今そう言ってるんだもん"}, {"type": "subtitle", "time": 11536.469, "timestamp": "03:12:16", "text": "私は自分のものを保持したくない、ただ持っているだけです"}, {"type": "subtitle", "time": 11538.95, "timestamp": "03:12:18", "text": "それらは記録された。"}, {"type": "subtitle", "time": 11542.95, "timestamp": "03:12:22", "text": "うん。でも、誰かに"}, {"type": "subtitle", "time": 11546.07, "timestamp": "03:12:26", "text": "ハイや"}, {"type": "subtitle", "time": 11547.59, "timestamp": "03:12:27", "text": "何でも"}, {"type": "subtitle", "time": 11553.19, "timestamp": "03:12:33", "text": "純粋な一人の人間が何であるか"}, {"type": "subtitle", "time": 11557.59, "timestamp": "03:12:37", "text": "「あ、ジョーが私のリストを持ってるから、チェックしてみよう」"}, {"type": "subtitle", "time": 11560.15, "timestamp": "03:12:40", "text": "彼が見たアニメをすべてクリック"}, {"type": "subtitle", "time": 11563.99, "timestamp": "03:12:43", "text": "ハイワンで、ハイワンみたいに"}, {"type": "subtitle", "time": 11567.67, "timestamp": "03:12:47", "text": "えっと、ハイとか何かに入るとか。私"}]
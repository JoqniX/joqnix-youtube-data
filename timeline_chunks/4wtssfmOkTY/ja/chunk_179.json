[{"type": "subtitle", "time": 10742.86, "timestamp": "02:59:02", "text": "どこの出身ですか？ディーン。"}, {"type": "subtitle", "time": 10750.23, "timestamp": "02:59:10", "text": "こんにちは。どこの出身ですか？"}, {"type": "subtitle", "time": 10753.19, "timestamp": "02:59:13", "text": "あなたはどこの国の出身ですか？そして、それはどうでしたか？"}, {"type": "subtitle", "time": 10755.51, "timestamp": "02:59:15", "text": "彼女の一日？"}, {"type": "subtitle", "time": 10782.63, "timestamp": "02:59:42", "text": "待って。考えてみれば。"}, {"type": "subtitle", "time": 10786.63, "timestamp": "02:59:46", "text": "私には誰もいなかった"}, {"type": "subtitle", "time": 10790.15, "timestamp": "02:59:50", "text": "私が話をする相手。えっと、私は一度も"}, {"type": "subtitle", "time": 10792.469, "timestamp": "02:59:52", "text": "ネパール出身者なら誰でも。"}, {"type": "subtitle", "time": 10794.71, "timestamp": "02:59:54", "text": "だからあなたは私にとって最初の人です"}]
[{"type": "subtitle", "time": 6785.75, "timestamp": "01:53:05", "text": "16."}, {"type": "subtitle", "time": 6786.79, "timestamp": "01:53:06", "text": "それは実際には最も多くの"}, {"type": "subtitle", "time": 6789.189, "timestamp": "01:53:09", "text": "これまでに見た一般的なサンプルは"}, {"type": "subtitle", "time": 6790.95, "timestamp": "01:53:10", "text": "一発勝負。"}, {"type": "subtitle", "time": 6799.27, "timestamp": "01:53:19", "text": "珍しいことはかなり一般的で、一般的なことは"}, {"type": "subtitle", "time": 6811.589, "timestamp": "01:53:31", "text": "あら、ハゲてるの？ああ、"}, {"type": "subtitle", "time": 6820.229, "timestamp": "01:53:40", "text": "いつか必ず手に入れる。"}, {"type": "subtitle", "time": 6822.31, "timestamp": "01:53:42", "text": "何？ある日？"}, {"type": "subtitle", "time": 6830.55, "timestamp": "01:53:50", "text": "何？素晴らしいサンプルです。"}, {"type": "subtitle", "time": 6832.149, "timestamp": "01:53:52", "text": "素晴らしい"}, {"type": "subtitle", "time": 6835.35, "timestamp": "01:53:55", "text": "紫色のやつ。"}, {"type": "subtitle", "time": 6838.149, "timestamp": "01:53:58", "text": "紫色のサンプル。ああ、紫"}]
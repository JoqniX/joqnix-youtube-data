[{"type": "subtitle", "time": 2101.589, "timestamp": "00:35:01", "text": "今じゃない。少なくとも今のところは。ない"}, {"type": "subtitle", "time": 2108.39, "timestamp": "00:35:08", "text": "ショニックスさん、あなたもぜひ私たちに加わってください。"}, {"type": "subtitle", "time": 2110.55, "timestamp": "00:35:10", "text": "ええ、ゲームの設定をしようとしているところです。"}, {"type": "subtitle", "time": 2113.75, "timestamp": "00:35:13", "text": "動作がすごく遅い。私のパソコンが壊れかけている。ああ、"}, {"type": "subtitle", "time": 2116.63, "timestamp": "00:35:16", "text": "それは普通のことです。"}, {"type": "subtitle", "time": 2119.67, "timestamp": "00:35:19", "text": "なぜこんなに時間がかかるのですか？"}, {"type": "subtitle", "time": 2122.39, "timestamp": "00:35:22", "text": "待って、それは"}, {"type": "subtitle", "time": 2127.75, "timestamp": "00:35:27", "text": "イエス。"}, {"type": "subtitle", "time": 2130.63, "timestamp": "00:35:30", "text": "私は大きな爆発音を目撃しました。"}, {"type": "subtitle", "time": 2132.87, "timestamp": "00:35:32", "text": "大きなスライダー。あれは工場だった"}, {"type": "subtitle", "time": 2134.79, "timestamp": "00:35:34", "text": "ストライダーだと思う。ごめん。ええ、そうではありません"}, {"type": "subtitle", "time": 2137.829, "timestamp": "00:35:37", "text": "ファクトリーストライダー。えっと、これは普通です"}, {"type": "subtitle", "time": 2139.99, "timestamp": "00:35:39", "text": "工場。"}, {"type": "subtitle", "time": 2142.47, "timestamp": "00:35:42", "text": "これはごく普通の工場出荷時のシェードです。待って、何？"}, {"type": "subtitle", "time": 2144.79, "timestamp": "00:35:44", "text": "普通という意味ですか？普通の工場。おお、"}, {"type": "subtitle", "time": 2148.31, "timestamp": "00:35:48", "text": "普通の工場。普通の工場。私 私"}, {"type": "subtitle", "time": 2150.069, "timestamp": "00:35:50", "text": "通常の工場出荷時のスターターと言ったのかと思った"}, {"type": "subtitle", "time": 2151.91, "timestamp": "00:35:51", "text": "そして、待って、バリエーションがある"}]
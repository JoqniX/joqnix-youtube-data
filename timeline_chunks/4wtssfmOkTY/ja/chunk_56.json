[{"type": "subtitle", "time": 3366.309, "timestamp": "00:56:06", "text": "ああ、もう。取得した。何も見えない"}, {"type": "subtitle", "time": 3372.87, "timestamp": "00:56:12", "text": "何が"}, {"type": "subtitle", "time": 3378.71, "timestamp": "00:56:18", "text": "希望する人がいれば、別の領域もあります"}, {"type": "subtitle", "time": 3380.71, "timestamp": "00:56:20", "text": "それ。"}, {"type": "subtitle", "time": 3382.63, "timestamp": "00:56:22", "text": "何てことだ。なぜ？ロケットランチャー"}, {"type": "subtitle", "time": 3384.71, "timestamp": "00:56:24", "text": "ロックオンするとほとんどの敵を即死させる。ねえ、どうやって"}, {"type": "subtitle", "time": 3387.67, "timestamp": "00:56:27", "text": "マップを開くボタンを押しますか？ああ、タブ、"}, {"type": "subtitle", "time": 3391.27, "timestamp": "00:56:31", "text": "右？タブタブ。何かをマークすると、"}, {"type": "subtitle", "time": 3393.109, "timestamp": "00:56:33", "text": "Qキーを押してください。"}, {"type": "subtitle", "time": 3395.109, "timestamp": "00:56:35", "text": "地図上に何かをマークする場合、"}, {"type": "subtitle", "time": 3398.39, "timestamp": "00:56:38", "text": "えっと、誰かに「右クリック」と言ってもらってください。"}, {"type": "subtitle", "time": 3401.19, "timestamp": "00:56:41", "text": "何かが起こりそうだ。ここです。"}, {"type": "subtitle", "time": 3403.03, "timestamp": "00:56:43", "text": "ああ、わかりました。わかった。今思い出した。"}, {"type": "subtitle", "time": 3405.91, "timestamp": "00:56:45", "text": "北西から誰かが来る。"}, {"type": "subtitle", "time": 3408.39, "timestamp": "00:56:48", "text": "うん、"}, {"type": "subtitle", "time": 3411.43, "timestamp": "00:56:51", "text": "私のクロスボウ。"}, {"type": "subtitle", "time": 3414.069, "timestamp": "00:56:54", "text": "最悪だ。おお、いいね。彼らはほとんど"}, {"type": "subtitle", "time": 3416.309, "timestamp": "00:56:56", "text": "増援。"}, {"type": "subtitle", "time": 3417.99, "timestamp": "00:56:57", "text": "電話してほしいとだけお伝えしておきます"}]
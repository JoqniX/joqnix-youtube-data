[{"type": "subtitle", "time": 11281.67, "timestamp": "03:08:01", "text": "あなたはどうですか？ H Dev、あなたはどのように"}, {"type": "subtitle", "time": 11284.07, "timestamp": "03:08:04", "text": "最近どんなアニメを見ていますか？"}, {"type": "subtitle", "time": 11294.309, "timestamp": "03:08:14", "text": "いつもの質問ですね。あ、こんにちは。ああ、パリ。"}, {"type": "subtitle", "time": 11298.23, "timestamp": "03:08:18", "text": "ああ、こんにちは、パルモ。バカ、会いたかったよ。"}, {"type": "subtitle", "time": 11301.51, "timestamp": "03:08:21", "text": "昨日のことだ。私は、えっと、あなた"}, {"type": "subtitle", "time": 11304.71, "timestamp": "03:08:24", "text": "チャットにいたんだよね？"}, {"type": "subtitle", "time": 11307.75, "timestamp": "03:08:27", "text": "えっと、君は寝てしまったと思ったんだけど"}, {"type": "subtitle", "time": 11309.59, "timestamp": "03:08:29", "text": "あるいは、何か物を持っていた。だからあなたは"}, {"type": "subtitle", "time": 11312.63, "timestamp": "03:08:32", "text": "できなかった、だから参加できなかったんだ"}, {"type": "subtitle", "time": 11316.389, "timestamp": "03:08:36", "text": "中。でも、それでもバカ、それは次回だ"}, {"type": "subtitle", "time": 11318.79, "timestamp": "03:08:38", "text": "一緒に遊ぼう"}, {"type": "subtitle", "time": 11321.03, "timestamp": "03:08:41", "text": "八。"}, {"type": "subtitle", "time": 11323.19, "timestamp": "03:08:43", "text": "うん。"}, {"type": "subtitle", "time": 11325.19, "timestamp": "03:08:45", "text": "はい。"}, {"type": "subtitle", "time": 11332.469, "timestamp": "03:08:52", "text": "こんにちは。こんにちは。"}, {"type": "subtitle", "time": 11335.01, "timestamp": "03:08:55", "text": "だからバカバカ。"}]
[{"type": "subtitle", "time": 8222.23, "timestamp": "02:17:02", "text": "君たちは死なないように気をつけろよ。"}, {"type": "subtitle", "time": 8224.07, "timestamp": "02:17:04", "text": "そこは通れません。ああ、やばい、"}, {"type": "subtitle", "time": 8226.15, "timestamp": "02:17:06", "text": "私たちの後ろに充電器があります。ジョックは"}, {"type": "subtitle", "time": 8228.629, "timestamp": "02:17:08", "text": "それには関わらないでください。"}, {"type": "subtitle", "time": 8230.389, "timestamp": "02:17:10", "text": "ええ、私は間違いを犯したと思います。私の"}, {"type": "subtitle", "time": 8232.87, "timestamp": "02:17:12", "text": "モバイルスティック。"}, {"type": "subtitle", "time": 8245.75, "timestamp": "02:17:25", "text": "チュマが言った瞬間、"}, {"type": "subtitle", "time": 8248.709, "timestamp": "02:17:28", "text": "充電器は後ろにあります。"}, {"type": "subtitle", "time": 8250.95, "timestamp": "02:17:30", "text": "あなたは死んだ、"}, {"type": "subtitle", "time": 8253.669, "timestamp": "02:17:33", "text": "男。ちくしょう、まったく。私は何をしたのか"}, {"type": "subtitle", "time": 8256.15, "timestamp": "02:17:36", "text": "する？"}, {"type": "subtitle", "time": 8259.509, "timestamp": "02:17:39", "text": "この辺りはとても奇妙だ。おっと、パチン。待って、"}, {"type": "subtitle", "time": 8262.87, "timestamp": "02:17:42", "text": "まったく宮殿みたいだ。"}, {"type": "subtitle", "time": 8264.79, "timestamp": "02:17:44", "text": "よし、その瞬間を思い出そう"}, {"type": "subtitle", "time": 8266.389, "timestamp": "02:17:46", "text": "すべてが緑色になる、とにかく地獄へ行け"}, {"type": "subtitle", "time": 8268.95, "timestamp": "02:17:48", "text": "一刻も早くそこから出ろ。"}, {"type": "subtitle", "time": 8279.99, "timestamp": "02:17:59", "text": "彼らは文字通り私の目の前でアクロバットをする"}]
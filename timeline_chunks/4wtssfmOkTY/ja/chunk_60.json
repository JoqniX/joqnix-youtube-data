[{"type": "subtitle", "time": 3600.069, "timestamp": "01:00:00", "text": "ああ、側面攻撃が可能だ。 380を持っています"}, {"type": "subtitle", "time": 3607.67, "timestamp": "01:00:07", "text": "うん。うん。幸運を。幸運を。私の"}, {"type": "subtitle", "time": 3610.63, "timestamp": "01:00:10", "text": "ああ、彼は真っ赤だ。神、"}, {"type": "subtitle", "time": 3612.23, "timestamp": "01:00:12", "text": "幸運を。一体あの色は何なんだ？"}, {"type": "subtitle", "time": 3617.19, "timestamp": "01:00:17", "text": "なぜ問題ないのですか？再読み込み。お前は変人だ。私"}, {"type": "subtitle", "time": 3627.829, "timestamp": "01:00:27", "text": "ドローン兵器？いいえ。これは一体何ですか？"}, {"type": "subtitle", "time": 3635.67, "timestamp": "01:00:35", "text": "オートマトン。はい。どうしたの？"}, {"type": "subtitle", "time": 3638.15, "timestamp": "01:00:38", "text": "自動人形の惑星？"}, {"type": "subtitle", "time": 3640.63, "timestamp": "01:00:40", "text": "本当に暗い状況だ。"}, {"type": "subtitle", "time": 3642.39, "timestamp": "01:00:42", "text": "つまり、我々はそれを徹底的に爆撃しているんだ"}, {"type": "subtitle", "time": 3645.27, "timestamp": "01:00:45", "text": "忘却だ、だから何を期待するんだ？"}, {"type": "subtitle", "time": 3648.15, "timestamp": "01:00:48", "text": "ええ、そうです、私たちは存在を削除します。私たちは"}, {"type": "subtitle", "time": 3650.39, "timestamp": "01:00:50", "text": "爆撃してきた"}, {"type": "subtitle", "time": 3653.27, "timestamp": "01:00:53", "text": "380と120。"}]
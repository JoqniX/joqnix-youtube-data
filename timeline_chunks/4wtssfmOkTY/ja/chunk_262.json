[{"type": "subtitle", "time": 15725.51, "timestamp": "04:22:05", "text": "そうします、そうします。はい。"}, {"type": "subtitle", "time": 15727.11, "timestamp": "04:22:07", "text": "えっと"}, {"type": "subtitle", "time": 15729.11, "timestamp": "04:22:09", "text": "彼のお名前は？彼の曲名は"}, {"type": "subtitle", "time": 15731.349, "timestamp": "04:22:11", "text": "歌う"}, {"type": "subtitle", "time": 15743.349, "timestamp": "04:22:23", "text": "まふまふがカバーしたよ。名前を忘れてしまった。"}, {"type": "subtitle", "time": 15745.51, "timestamp": "04:22:25", "text": "まるで"}, {"type": "subtitle", "time": 15749.189, "timestamp": "04:22:29", "text": "ああ、わかった。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 15751.269, "timestamp": "04:22:31", "text": "待って。日本語訳は"}, {"type": "subtitle", "time": 15755.269, "timestamp": "04:22:35", "text": "これ？さよなら宣言 えーと、私は試してみました"}, {"type": "subtitle", "time": 15758.389, "timestamp": "04:22:38", "text": "歌う。はい。さよなら宣言。"}, {"type": "subtitle", "time": 15762.06, "timestamp": "04:22:42", "text": "それは歌だ。マフの歌。"}, {"type": "subtitle", "time": 15774.149, "timestamp": "04:22:54", "text": "調子はどうですか"}, {"type": "subtitle", "time": 15777.349, "timestamp": "04:22:57", "text": "昨日気絶したの？実際、私は寝ました"}]
[{"type": "subtitle", "time": 7560.95, "timestamp": "02:06:00", "text": "地獄のダイブ。 1つだけ選ぼう"}, {"type": "subtitle", "time": 7562.55, "timestamp": "02:06:02", "text": "それが一番近いですね。それでよろしいですか？"}, {"type": "subtitle", "time": 7565.51, "timestamp": "02:06:05", "text": "君たちと一緒に？ええ、それはそれを物語っています。うん。"}, {"type": "subtitle", "time": 7568.79, "timestamp": "02:06:08", "text": "虫は厄介な存在だ。あなたは最後尾です。"}, {"type": "subtitle", "time": 7571.51, "timestamp": "02:06:11", "text": "オペレーション・インパクト。"}, {"type": "subtitle", "time": 7573.75, "timestamp": "02:06:13", "text": "誰かいますか？ああ、これでいい。さあ"}, {"type": "subtitle", "time": 7575.43, "timestamp": "02:06:15", "text": "昼間に行こう、夜は"}, {"type": "subtitle", "time": 7577.03, "timestamp": "02:06:17", "text": "本当に、本当に難しくなるだろう"}, {"type": "subtitle", "time": 7583.109, "timestamp": "02:06:23", "text": "孵化場を浄化せよ。これは"}, {"type": "subtitle", "time": 7585.75, "timestamp": "02:06:25", "text": "最も迷惑なもの。貴重な情報を取得する"}, {"type": "subtitle", "time": 7587.43, "timestamp": "02:06:27", "text": "データ。"}, {"type": "subtitle", "time": 7589.75, "timestamp": "02:06:29", "text": "捜索破壊"}, {"type": "subtitle", "time": 7592.95, "timestamp": "02:06:32", "text": "12分。"}, {"type": "subtitle", "time": 7595.43, "timestamp": "02:06:35", "text": "皆さんはどちらを最初にやりたかったですか？"}, {"type": "subtitle", "time": 7598.229, "timestamp": "02:06:38", "text": "データ復旧をしたいです。"}, {"type": "subtitle", "time": 7600.709, "timestamp": "02:06:40", "text": "開始します。"}, {"type": "subtitle", "time": 7610.149, "timestamp": "02:06:50", "text": "捕食者取引は行っていますか？によって"}, {"type": "subtitle", "time": 7611.75, "timestamp": "02:06:51", "text": "捕食者がいると書いてある場合"}, {"type": "subtitle", "time": 7615.51, "timestamp": "02:06:55", "text": "電車に乗る時は、気をつけてください。ジャンプ完了。"}, {"type": "subtitle", "time": 7617.91, "timestamp": "02:06:57", "text": "ああ、それらは硬いですか？ああ、彼らは"}]
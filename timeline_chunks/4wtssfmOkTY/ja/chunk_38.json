[{"type": "subtitle", "time": 2287.99, "timestamp": "00:38:07", "text": "ええ、どうぞ。"}, {"type": "subtitle", "time": 2291.829, "timestamp": "00:38:11", "text": "なぜ私の画面では空白になっているのですか？おお、"}, {"type": "subtitle", "time": 2295.22, "timestamp": "00:38:15", "text": "宝石。みんな、インターセプトしたっけ？"}, {"type": "subtitle", "time": 2297.03, "timestamp": "00:38:17", "text": "[音楽]"}, {"type": "subtitle", "time": 2300.15, "timestamp": "00:38:20", "text": "うわぁ。後ろに。私たちは交流しましたか？"}, {"type": "subtitle", "time": 2302.31, "timestamp": "00:38:22", "text": "シールド？"}, {"type": "subtitle", "time": 2304.79, "timestamp": "00:38:24", "text": "みんなシールドをプレイすることに集中している"}, {"type": "subtitle", "time": 2307.99, "timestamp": "00:38:27", "text": "ここ。つまり、"}, {"type": "subtitle", "time": 2310.069, "timestamp": "00:38:30", "text": "私はそうは思わない、それは君たち次第だ"}, {"type": "subtitle", "time": 2311.27, "timestamp": "00:38:31", "text": "男たちはそれをやりたがる。もし君たちがそうするなら"}, {"type": "subtitle", "time": 2313.51, "timestamp": "00:38:33", "text": "彼らには私も参加します。しかしそうでない場合は、"}, {"type": "subtitle", "time": 2316.87, "timestamp": "00:38:36", "text": "どのくらいの難易度を目指しているのですか？"}, {"type": "subtitle", "time": 2319.51, "timestamp": "00:38:39", "text": "何てことだ。私たちを本当にキラキラさせてくれます"}, {"type": "subtitle", "time": 2323.109, "timestamp": "00:38:43", "text": "スーパーヘルダイブして"}, {"type": "subtitle", "time": 2326.31, "timestamp": "00:38:46", "text": "すべて同じことになるだろう。"}, {"type": "subtitle", "time": 2328.95, "timestamp": "00:38:48", "text": "参加者は説明欄に記載されています"}, {"type": "subtitle", "time": 2331.349, "timestamp": "00:38:51", "text": "リンク。それで、サム・シューマがいます。"}, {"type": "subtitle", "time": 2334.79, "timestamp": "00:38:54", "text": "VolutterとWiiを持っています"}, {"type": "subtitle", "time": 2337.5, "timestamp": "00:38:57", "text": "それ"}, {"type": "subtitle", "time": 2339.349, "timestamp": "00:38:59", "text": "[音楽]"}]
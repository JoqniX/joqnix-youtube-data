[{"type": "subtitle", "time": 14220.469, "timestamp": "03:57:00", "text": "あなたが知っていることについての提案をお願いします。"}, {"type": "subtitle", "time": 14223.03, "timestamp": "03:57:03", "text": "調子はどうだ、バカ？"}, {"type": "subtitle", "time": 14226.21, "timestamp": "03:57:06", "text": "私のバカは今日はどんな様子？"}, {"type": "subtitle", "time": 14233.83, "timestamp": "03:57:13", "text": "バカは今日はどうしている？"}, {"type": "subtitle", "time": 14236.87, "timestamp": "03:57:16", "text": "快適に過ごせているといいのですが。快適。"}, {"type": "subtitle", "time": 14239.189, "timestamp": "03:57:19", "text": "うん。"}, {"type": "subtitle", "time": 14245.429, "timestamp": "03:57:25", "text": "「えっと、これ」というラベルを作るべきですね"}, {"type": "subtitle", "time": 14248.389, "timestamp": "03:57:28", "text": "提案されています"}, {"type": "subtitle", "time": 14253.269, "timestamp": "03:57:33", "text": "チャットで提案されました"}, {"type": "subtitle", "time": 14256.229, "timestamp": "03:57:36", "text": "チャット"}, {"type": "subtitle", "time": 14258.79, "timestamp": "03:57:38", "text": "私はその提案をすべきだ"}, {"type": "subtitle", "time": 14262.55, "timestamp": "03:57:42", "text": "チャット機能で提案されたので、"}, {"type": "subtitle", "time": 14266.07, "timestamp": "03:57:46", "text": "皆さんがこれを提案してくれたので"}, {"type": "subtitle", "time": 14268.469, "timestamp": "03:57:48", "text": "私が忘れないこと"}, {"type": "subtitle", "time": 14276.71, "timestamp": "03:57:56", "text": "元気です。なんとか手に入れることができました"}, {"type": "subtitle", "time": 14279.59, "timestamp": "03:57:59", "text": "たまには寝よう。元気ですか？私も。私"}]
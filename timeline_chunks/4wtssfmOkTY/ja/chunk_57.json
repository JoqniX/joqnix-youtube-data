[{"type": "subtitle", "time": 3420.309, "timestamp": "00:57:00", "text": "正直に言うと、援軍が必要だ。ああ、"}, {"type": "subtitle", "time": 3423.589, "timestamp": "00:57:03", "text": "神。それはいじめになるだろう。"}, {"type": "subtitle", "time": 3427.03, "timestamp": "00:57:07", "text": "ああ、危うく転ぶところだった。"}, {"type": "subtitle", "time": 3429.829, "timestamp": "00:57:09", "text": "5分。"}, {"type": "subtitle", "time": 3433.829, "timestamp": "00:57:13", "text": "あれはショットガンですか？ええと、レバーアクション、"}, {"type": "subtitle", "time": 3437.829, "timestamp": "00:57:17", "text": "右？マークライフル。武器は武器だ。"}, {"type": "subtitle", "time": 3440.549, "timestamp": "00:57:20", "text": "配信へようこ​​そ。猫を間違えました。"}, {"type": "subtitle", "time": 3443.829, "timestamp": "00:57:23", "text": "いいえ、これは子猫ではありません。これは子猫です。"}, {"type": "subtitle", "time": 3447.75, "timestamp": "00:57:27", "text": "ニース。服一式手に入れました。"}, {"type": "subtitle", "time": 3450.789, "timestamp": "00:57:30", "text": "ああ、大変だ。あなたが行くところ？何も見えない"}, {"type": "subtitle", "time": 3453.43, "timestamp": "00:57:33", "text": "もの。"}, {"type": "subtitle", "time": 3456.71, "timestamp": "00:57:36", "text": "彼らは皆この岩だらけの後ろにいる、"}, {"type": "subtitle", "time": 3459.589, "timestamp": "00:57:39", "text": "あなたが知っている。これは「オーマイゴッド」ではありません。"}, {"type": "subtitle", "time": 3461.67, "timestamp": "00:57:41", "text": "私たちは、"}, {"type": "subtitle", "time": 3470.789, "timestamp": "00:57:50", "text": "心配しないで。彼らは全員亡くなった。彼らは"}, {"type": "subtitle", "time": 3474.309, "timestamp": "00:57:54", "text": "死んだ。軌道を配置しました。"}, {"type": "subtitle", "time": 3476.71, "timestamp": "00:57:56", "text": "うわあ、すごく明るいね。いいえ、いいえ"}, {"type": "subtitle", "time": 3479.51, "timestamp": "00:57:59", "text": "ホワイティングネック。"}]
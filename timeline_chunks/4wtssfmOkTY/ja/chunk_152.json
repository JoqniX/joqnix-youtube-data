[{"type": "subtitle", "time": 9120.87, "timestamp": "02:32:00", "text": "えっと、その車。"}, {"type": "subtitle", "time": 9123.91, "timestamp": "02:32:03", "text": "さあ行こう。"}, {"type": "subtitle", "time": 9138.309, "timestamp": "02:32:18", "text": "でも、今日は楽しかったよ。"}, {"type": "subtitle", "time": 9141.349, "timestamp": "02:32:21", "text": "楽しかったです。"}, {"type": "subtitle", "time": 9144.309, "timestamp": "02:32:24", "text": "楽しかった。"}, {"type": "subtitle", "time": 9145.91, "timestamp": "02:32:25", "text": "うん。ゲームをインストールした後ですよね？"}, {"type": "subtitle", "time": 9148.07, "timestamp": "02:32:28", "text": "うん。明日はそれを保管しておかなければならない"}, {"type": "subtitle", "time": 9149.429, "timestamp": "02:32:29", "text": "準備した。私は人々に働きかけなければならない"}, {"type": "subtitle", "time": 9156.71, "timestamp": "02:32:36", "text": "H"}, {"type": "subtitle", "time": 9168.87, "timestamp": "02:32:48", "text": "よし、ちょっと寝るよ"}, {"type": "subtitle", "time": 9172.15, "timestamp": "02:32:52", "text": "少しだけ、そして私は1時に起きます。わかりました、"}]
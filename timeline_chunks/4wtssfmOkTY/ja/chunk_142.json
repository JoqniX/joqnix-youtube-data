[{"type": "subtitle", "time": 8524.79, "timestamp": "02:22:04", "text": "いや、必ずしも死ぬとは限らない。見て。"}, {"type": "subtitle", "time": 8528.15, "timestamp": "02:22:08", "text": "いや、違うよ。いいえ。いいえ。違います。それは違う"}, {"type": "subtitle", "time": 8533.83, "timestamp": "02:22:13", "text": "作品。民主主義は守る。うん。"}, {"type": "subtitle", "time": 8535.83, "timestamp": "02:22:15", "text": "ともかく、"}, {"type": "subtitle", "time": 8538.55, "timestamp": "02:22:18", "text": "それは体力回復爆弾ですか？なんてこった。なぜ私は"}, {"type": "subtitle", "time": 8541.59, "timestamp": "02:22:21", "text": "農業？ここに何かある。良い、"}, {"type": "subtitle", "time": 8544.469, "timestamp": "02:22:24", "text": "かなりの数のサンプルですね。"}, {"type": "subtitle", "time": 8546.23, "timestamp": "02:22:26", "text": "しかし、今はそうするには良い時期ではない"}, {"type": "subtitle", "time": 8549.59, "timestamp": "02:22:29", "text": "サンプル。なぜ自分がここにいるのか、私にはわからない。"}, {"type": "subtitle", "time": 8561.03, "timestamp": "02:22:41", "text": "[音楽]"}, {"type": "subtitle", "time": 8563.75, "timestamp": "02:22:43", "text": "軌道投入を要請します。"}, {"type": "subtitle", "time": 8573.429, "timestamp": "02:22:53", "text": "わかった、"}, {"type": "subtitle", "time": 8577.59, "timestamp": "02:22:57", "text": "君たちは私のことを気にしないの？"}]
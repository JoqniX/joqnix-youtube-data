[{"type": "subtitle", "time": 5161.51, "timestamp": "01:26:01", "text": "スーツ。なぜ壊れないのか？"}, {"type": "subtitle", "time": 5165.51, "timestamp": "01:26:05", "text": "ああ、そうそう。それは素晴らしい"}, {"type": "subtitle", "time": 5167.83, "timestamp": "01:26:07", "text": "ローリンズ。燃やしてしまえ、この野郎。そして始める"}, {"type": "subtitle", "time": 5178.39, "timestamp": "01:26:18", "text": "よし、これでいい。ようやく落ち着いた。"}, {"type": "subtitle", "time": 5186.149, "timestamp": "01:26:26", "text": "振り返らないでください。"}, {"type": "subtitle", "time": 5188.55, "timestamp": "01:26:28", "text": "良い、"}, {"type": "subtitle", "time": 5190.79, "timestamp": "01:26:30", "text": "私は思う"}, {"type": "subtitle", "time": 5194.87, "timestamp": "01:26:34", "text": "それで十分だと思います。ヒットを打つ。"}, {"type": "subtitle", "time": 5196.55, "timestamp": "01:26:36", "text": "砲塔1基が破壊された。私には全くわからない"}, {"type": "subtitle", "time": 5201.83, "timestamp": "01:26:41", "text": "タグ付け mapwest"}, {"type": "subtitle", "time": 5208.709, "timestamp": "01:26:48", "text": "軌道投入を要請します。彼らが持っているとき"}, {"type": "subtitle", "time": 5210.87, "timestamp": "01:26:50", "text": "ライン。本当のカクリはギャンブラーが作った"}, {"type": "subtitle", "time": 5214.709, "timestamp": "01:26:54", "text": "最後まで。時計。"}]
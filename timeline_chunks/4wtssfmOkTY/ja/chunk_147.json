[{"type": "subtitle", "time": 8821.59, "timestamp": "02:27:01", "text": "ええ、彼はあなたのすぐ後ろにいますよ。"}, {"type": "subtitle", "time": 8824.63, "timestamp": "02:27:04", "text": "ジャングルに行って"}, {"type": "subtitle", "time": 8829.99, "timestamp": "02:27:09", "text": "[音楽]"}, {"type": "subtitle", "time": 8831.91, "timestamp": "02:27:11", "text": "何てことだ。それは私のミスでした。それは私の"}, {"type": "subtitle", "time": 8833.14, "timestamp": "02:27:13", "text": "悪い。"}, {"type": "subtitle", "time": 8838.71, "timestamp": "02:27:18", "text": "ああ、それは私のミスでした。私は歩いて入った"}, {"type": "subtitle", "time": 8840.469, "timestamp": "02:27:20", "text": "あなたの炎。"}, {"type": "subtitle", "time": 8842.55, "timestamp": "02:27:22", "text": "「あれ、あれがまた点いてるよ」って思った。"}, {"type": "subtitle", "time": 8846.07, "timestamp": "02:27:26", "text": "「それをオンにしなければならなかった。」そしてそれから"}, {"type": "subtitle", "time": 8848.15, "timestamp": "02:27:28", "text": "「ちょっと待って、撮影してるよ」って感じだった。おお"}, {"type": "subtitle", "time": 8851.19, "timestamp": "02:27:31", "text": "いいえ。そして閃光を見た"}, {"type": "subtitle", "time": 8853.91, "timestamp": "02:27:33", "text": "そしてこれ"}, {"type": "subtitle", "time": 8856.79, "timestamp": "02:27:36", "text": "何てことだ。何てことだ。"}, {"type": "subtitle", "time": 8859.51, "timestamp": "02:27:39", "text": "健康デザインはするべきではないと思います。"}, {"type": "subtitle", "time": 8863.19, "timestamp": "02:27:43", "text": "なんてこった。私たちにはできたが、"}, {"type": "subtitle", "time": 8866.63, "timestamp": "02:27:46", "text": "ちょっとふざけすぎている。はい。"}, {"type": "subtitle", "time": 8873.11, "timestamp": "02:27:53", "text": "とにかく、もうやめようと思う"}, {"type": "subtitle", "time": 8878.63, "timestamp": "02:27:58", "text": "今日はもうお腹がいっぱいだから。"}]
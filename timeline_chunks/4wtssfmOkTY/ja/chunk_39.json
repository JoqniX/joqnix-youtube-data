[{"type": "subtitle", "time": 2342.71, "timestamp": "00:39:02", "text": "空中爆発は必要ない。ああ、助かった"}, {"type": "subtitle", "time": 2345.43, "timestamp": "00:39:05", "text": "彼らはこれらのものを作った。"}, {"type": "subtitle", "time": 2348.71, "timestamp": "00:39:08", "text": "変人だ。まあまあです。ああ、助かった。私は手に入れた"}, {"type": "subtitle", "time": 2351.829, "timestamp": "00:39:11", "text": "彼。捕まえたぞ。ありがとう。"}, {"type": "subtitle", "time": 2355.43, "timestamp": "00:39:15", "text": "でも、ありがたいことにスーパーにしてくれた"}, {"type": "subtitle", "time": 2357.43, "timestamp": "00:39:17", "text": "弱い。"}, {"type": "subtitle", "time": 2358.87, "timestamp": "00:39:18", "text": "ええ、スラスタを少し"}, {"type": "subtitle", "time": 2361.43, "timestamp": "00:39:21", "text": "殺すのが簡単だ。ええ、中字のペンで。"}, {"type": "subtitle", "time": 2363.349, "timestamp": "00:39:23", "text": "あ、そういえば、あれはフラップの影だよ。"}, {"type": "subtitle", "time": 2366.55, "timestamp": "00:39:26", "text": "わかったよ。わかった、私は"}, {"type": "subtitle", "time": 2368.23, "timestamp": "00:39:28", "text": "捕まえたぞ。"}, {"type": "subtitle", "time": 2374.47, "timestamp": "00:39:34", "text": "槍の力。"}, {"type": "subtitle", "time": 2377.91, "timestamp": "00:39:37", "text": "わかった。フリーキングの力で"}, {"type": "subtitle", "time": 2379.99, "timestamp": "00:39:39", "text": "友情の力。"}, {"type": "subtitle", "time": 2381.91, "timestamp": "00:39:41", "text": "宇宙レーザーの威力"}, {"type": "subtitle", "time": 2388.55, "timestamp": "00:39:48", "text": "宇宙レーザー。"}, {"type": "subtitle", "time": 2393.99, "timestamp": "00:39:53", "text": "宇宙レーザー砲。準備はできたと思う。"}, {"type": "subtitle", "time": 2395.67, "timestamp": "00:39:55", "text": "なぜここにもいるのか、私にはわからない。彼は"}, {"type": "subtitle", "time": 2396.95, "timestamp": "00:39:56", "text": "おそらく私が知っている中で唯一の"}, {"type": "subtitle", "time": 2399.27, "timestamp": "00:39:59", "text": "三つ。"}]
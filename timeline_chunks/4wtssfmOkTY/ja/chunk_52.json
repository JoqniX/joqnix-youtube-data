[{"type": "subtitle", "time": 3120.79, "timestamp": "00:52:00", "text": "ハグをするには数分間待たなければならない"}, {"type": "subtitle", "time": 3123.99, "timestamp": "00:52:03", "text": "あなたのために。ハグ。"}, {"type": "subtitle", "time": 3132.71, "timestamp": "00:52:12", "text": "待って、あの空飛ぶ物体は何？"}, {"type": "subtitle", "time": 3135.109, "timestamp": "00:52:15", "text": "空飛ぶ物体。これらは一体何ですか？"}, {"type": "subtitle", "time": 3137.99, "timestamp": "00:52:17", "text": "あれは超大型駆逐艦だ。"}, {"type": "subtitle", "time": 3139.589, "timestamp": "00:52:19", "text": "そうそう。ああ、わかりました。ねえ、私はこう思った"}, {"type": "subtitle", "time": 3141.19, "timestamp": "00:52:21", "text": "空飛ぶ物体が"}, {"type": "subtitle", "time": 3143.589, "timestamp": "00:52:23", "text": "これから盛り上がるぞ。ああ、"}, {"type": "subtitle", "time": 3147.27, "timestamp": "00:52:27", "text": "もしそうだったとしたら、通り。"}, {"type": "subtitle", "time": 3155.91, "timestamp": "00:52:35", "text": "到着。西正面。最悪だ。そして彼らは"}, {"type": "subtitle", "time": 3158.069, "timestamp": "00:52:38", "text": "強化と呼ばれる。私は持ってきた"}, {"type": "subtitle", "time": 3159.67, "timestamp": "00:52:39", "text": "銃撃戦に間違った銃を使う。ない"}, {"type": "subtitle", "time": 3167.43, "timestamp": "00:52:47", "text": "ああ、なんてことだ、近すぎるよ。"}, {"type": "subtitle", "time": 3170.23, "timestamp": "00:52:50", "text": "はい。文字通り彼らの真上に横たわる"}, {"type": "subtitle", "time": 3173.27, "timestamp": "00:52:53", "text": "それに非常に近い。"}]
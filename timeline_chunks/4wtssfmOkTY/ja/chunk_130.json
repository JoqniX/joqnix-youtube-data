[{"type": "subtitle", "time": 7803.189, "timestamp": "02:10:03", "text": "影は"}, {"type": "subtitle", "time": 7807.43, "timestamp": "02:10:07", "text": "正義こそがあなたの目標です。聖なる"}, {"type": "subtitle", "time": 7828.149, "timestamp": "02:10:28", "text": "みんな、心配しないで。彼を徹底的に批判しなきゃ。私"}, {"type": "subtitle", "time": 7830.79, "timestamp": "02:10:30", "text": "2つ目をご覧ください。"}, {"type": "subtitle", "time": 7847.109, "timestamp": "02:10:47", "text": "君たち、火が見える？心配しないで。しかし、ただ"}, {"type": "subtitle", "time": 7851.27, "timestamp": "02:10:51", "text": "左上下。"}]
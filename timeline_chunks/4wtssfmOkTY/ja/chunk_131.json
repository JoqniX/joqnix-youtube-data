[{"type": "subtitle", "time": 7865.589, "timestamp": "02:11:05", "text": "見た目が全然違う。最悪だ。"}, {"type": "subtitle", "time": 7873.27, "timestamp": "02:11:13", "text": "[音楽]"}, {"type": "subtitle", "time": 7875.91, "timestamp": "02:11:15", "text": "ちくしょう。"}, {"type": "subtitle", "time": 7884.229, "timestamp": "02:11:24", "text": "私の番犬はどこ？申請が承認されました。"}, {"type": "subtitle", "time": 7905.27, "timestamp": "02:11:45", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 7907.109, "timestamp": "02:11:47", "text": "心配しないで。補強しないでください"}, {"type": "subtitle", "time": 7909.35, "timestamp": "02:11:49", "text": "一瞬。私たちは大きなことを成し遂げたと思います"}, {"type": "subtitle", "time": 7911.35, "timestamp": "02:11:51", "text": "間違い。"}, {"type": "subtitle", "time": 7913.669, "timestamp": "02:11:53", "text": "彼は私の内面を強くしてくれたと思う。の"}, {"type": "subtitle", "time": 7918.149, "timestamp": "02:11:58", "text": "内部のバグは強化されなかった。"}]
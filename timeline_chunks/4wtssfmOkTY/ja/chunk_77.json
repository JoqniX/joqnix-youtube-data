[{"type": "subtitle", "time": 4621.189, "timestamp": "01:17:01", "text": "何てことだ。私も経験があります。私は"}, {"type": "subtitle", "time": 4626.709, "timestamp": "01:17:06", "text": "とにかく、ヘリポートまで行ってください。よし。"}, {"type": "subtitle", "time": 4629.83, "timestamp": "01:17:09", "text": "どうすれば再びスーパーヒーローになれるの？いいえ、それらは"}, {"type": "subtitle", "time": 4633.11, "timestamp": "01:17:13", "text": "クリップではありません。あれはマガジンです。"}, {"type": "subtitle", "time": 4635.91, "timestamp": "01:17:15", "text": "はい、マガジンには大きな違いがあります"}, {"type": "subtitle", "time": 4637.59, "timestamp": "01:17:17", "text": "そしてクリップ。"}, {"type": "subtitle", "time": 4640.31, "timestamp": "01:17:20", "text": "ああ、レベル9に行くんだ。おお、"}, {"type": "subtitle", "time": 4642.149, "timestamp": "01:17:22", "text": "来て。"}, {"type": "subtitle", "time": 4644.709, "timestamp": "01:17:24", "text": "ああ、もう、これ大嫌い。これらは"}, {"type": "subtitle", "time": 4648.55, "timestamp": "01:17:28", "text": "うざい奴。そちら側です。"}, {"type": "subtitle", "time": 4650.63, "timestamp": "01:17:30", "text": "はい。同意します。"}, {"type": "subtitle", "time": 4658.79, "timestamp": "01:17:38", "text": "わかった。必要なものは手に入れた。私は"}, {"type": "subtitle", "time": 4661.59, "timestamp": "01:17:41", "text": "増員予算を増やすべきだ。"}, {"type": "subtitle", "time": 4663.669, "timestamp": "01:17:43", "text": "実は、"}, {"type": "subtitle", "time": 4665.669, "timestamp": "01:17:45", "text": "もしくは、筋肉増強。私"}, {"type": "subtitle", "time": 4667.27, "timestamp": "01:17:47", "text": "増援部隊については問題ないと思う"}, {"type": "subtitle", "time": 4669.669, "timestamp": "01:17:49", "text": "予算。私は筋肉増強を選びます"}, {"type": "subtitle", "time": 4678.709, "timestamp": "01:17:58", "text": "120mm。すみません。"}]
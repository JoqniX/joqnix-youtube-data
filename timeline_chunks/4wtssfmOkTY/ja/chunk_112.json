[{"type": "subtitle", "time": 6722.95, "timestamp": "01:52:02", "text": "来る。さあ行こう。みんなは"}, {"type": "subtitle", "time": 6726.95, "timestamp": "01:52:06", "text": "すべて？わかった。"}, {"type": "subtitle", "time": 6729.189, "timestamp": "01:52:09", "text": "そうだったと思います。"}, {"type": "subtitle", "time": 6731.189, "timestamp": "01:52:11", "text": "確認中です。"}, {"type": "subtitle", "time": 6733.669, "timestamp": "01:52:13", "text": "問題なさそうだ。"}, {"type": "subtitle", "time": 6735.35, "timestamp": "01:52:15", "text": "私たちは大丈夫です。待って。私たちは大丈夫です。だった"}, {"type": "subtitle", "time": 6739.03, "timestamp": "01:52:19", "text": "良い。わかった。しかし、私たちは試合を途中で退場した。それで"}, {"type": "subtitle", "time": 6742.39, "timestamp": "01:52:22", "text": "ええ、かなりの量の"}, {"type": "subtitle", "time": 6745.03, "timestamp": "01:52:25", "text": "一般的なサンプル。ええ、あなたは"}, {"type": "subtitle", "time": 6748.229, "timestamp": "01:52:28", "text": "俺たちの生活様式を守り抜いたんだよ。"}, {"type": "subtitle", "time": 6750.39, "timestamp": "01:52:30", "text": "それによって実績が解除されました。ええ、私たちは"}, {"type": "subtitle", "time": 6753.43, "timestamp": "01:52:33", "text": "した。何てことだ。ニース。さあ行こう。さあ"}, {"type": "subtitle", "time": 6775.27, "timestamp": "01:52:55", "text": "ラジオ局を受信できませんでした。くそっ"}, {"type": "subtitle", "time": 6779.189, "timestamp": "01:52:59", "text": "それ。くそ。あと少しだったのに。"}]
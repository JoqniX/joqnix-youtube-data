[{"type": "subtitle", "time": 3488.549, "timestamp": "00:58:08", "text": "私たちはこのことにちょっと困惑しています"}, {"type": "subtitle", "time": 3492.63, "timestamp": "00:58:12", "text": "ミッション。 「大丈夫ですか？」という質問はありません。"}, {"type": "subtitle", "time": 3495.109, "timestamp": "00:58:15", "text": "うん、大丈夫だよ。私たちはちょうど切り取って"}, {"type": "subtitle", "time": 3496.789, "timestamp": "00:58:16", "text": "落ちた。大丈夫です。いや、いや。私 私 私"}, {"type": "subtitle", "time": 3498.15, "timestamp": "00:58:18", "text": "誤って近接攻撃をしてしまった。ごめんなさい。私"}, {"type": "subtitle", "time": 3501.51, "timestamp": "00:58:21", "text": "誤って近接攻撃をしてしまった。私は、私は、"}, {"type": "subtitle", "time": 3503.67, "timestamp": "00:58:23", "text": "再装填を補助する。いや、いや、わかってるよ。私 私"}, {"type": "subtitle", "time": 3505.67, "timestamp": "00:58:25", "text": "君に腹が立ったよ。仕返しに、あなたに蒸気を浴びせた。私"}, {"type": "subtitle", "time": 3507.589, "timestamp": "00:58:27", "text": "アシストリロードをやろうとしていたのですが、"}, {"type": "subtitle", "time": 3511.03, "timestamp": "00:58:31", "text": "でも、間違ったボタンを押してしまった。何が"}, {"type": "subtitle", "time": 3513.19, "timestamp": "00:58:33", "text": "ワスプランチャー？"}, {"type": "subtitle", "time": 3515.51, "timestamp": "00:58:35", "text": "えっと"}, {"type": "subtitle", "time": 3517.43, "timestamp": "00:58:37", "text": "小型ミサイル。"}, {"type": "subtitle", "time": 3522.15, "timestamp": "00:58:42", "text": "ダメージを与えてリロードすればいい。"}, {"type": "subtitle", "time": 3529.67, "timestamp": "00:58:49", "text": "男。 20分。ああ、敵が"}, {"type": "subtitle", "time": 3531.51, "timestamp": "00:58:51", "text": "北西。"}, {"type": "subtitle", "time": 3532.71, "timestamp": "00:58:52", "text": "あれは何だ？ああ、彼は死んだ"}]
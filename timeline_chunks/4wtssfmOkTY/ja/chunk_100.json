[{"type": "subtitle", "time": 6002.31, "timestamp": "01:40:02", "text": "良い、"}, {"type": "subtitle", "time": 6019.43, "timestamp": "01:40:19", "text": "ジャムはどこですか？ああ、ジャマー。はい、"}, {"type": "subtitle", "time": 6021.109, "timestamp": "01:40:21", "text": "ジャマーを手に入れた。わかった。わかった。私"}, {"type": "subtitle", "time": 6024.47, "timestamp": "01:40:24", "text": "わかった。何？私の上にハルクが乗っている。どうやって"}, {"type": "subtitle", "time": 6026.709, "timestamp": "01:40:26", "text": "私は死んだのか？"}, {"type": "subtitle", "time": 6030.229, "timestamp": "01:40:30", "text": "いや、君はそこで死んだようなものだよ。えっと、私は"}, {"type": "subtitle", "time": 6032.39, "timestamp": "01:40:32", "text": "詰まってきています。"}, {"type": "subtitle", "time": 6040.149, "timestamp": "01:40:40", "text": "[音楽]"}, {"type": "subtitle", "time": 6047.27, "timestamp": "01:40:47", "text": "ジャックへ。心配しないで、彼は大丈夫だよ。私は"}, {"type": "subtitle", "time": 6049.109, "timestamp": "01:40:49", "text": "あなたのすぐ後ろから来ます。私を殺して、"}, {"type": "subtitle", "time": 6050.87, "timestamp": "01:40:50", "text": "ジャック。"}]
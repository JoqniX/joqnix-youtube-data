[{"type": "subtitle", "time": 14281.67, "timestamp": "03:58:01", "text": "よく眠れた。昨日、私は"}, {"type": "subtitle", "time": 14284.15, "timestamp": "03:58:04", "text": "ストリーミング配信後に頭痛がする。"}, {"type": "subtitle", "time": 14288.469, "timestamp": "03:58:08", "text": "それで、少し休憩しました。"}, {"type": "subtitle", "time": 14291.91, "timestamp": "03:58:11", "text": "朝起きた。ああ、そうしてるよ"}, {"type": "subtitle", "time": 14295.429, "timestamp": "03:58:15", "text": "良い。はい、とても元気です。そして私は"}, {"type": "subtitle", "time": 14301.349, "timestamp": "03:58:21", "text": "こんにちは"}, {"type": "subtitle", "time": 14305.429, "timestamp": "03:58:25", "text": "息子。バカは今日はどうしている？調子はどうですか"}, {"type": "subtitle", "time": 14319.91, "timestamp": "03:58:39", "text": "あ、待って。私たちは練習をしなかった、"}, {"type": "subtitle", "time": 14324.309, "timestamp": "03:58:44", "text": "右？午前9時25分です。では、待ちましょう。"}, {"type": "subtitle", "time": 14326.309, "timestamp": "03:58:46", "text": "5分。わかりました、それまでは、えーと"}, {"type": "subtitle", "time": 14328.87, "timestamp": "03:58:48", "text": "これを終わらせてください。"}, {"type": "subtitle", "time": 14331.269, "timestamp": "03:58:51", "text": "えっと、"}, {"type": "subtitle", "time": 14334.15, "timestamp": "03:58:54", "text": "見てみましょう。"}, {"type": "subtitle", "time": 14336.71, "timestamp": "03:58:56", "text": "新しいストリームレイアウト。私はこれをやり遂げました。"}, {"type": "subtitle", "time": 14338.63, "timestamp": "03:58:58", "text": "新しいストリームレイアウト。はい、終わりました"}]
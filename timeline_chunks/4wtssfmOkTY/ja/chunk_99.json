[{"type": "subtitle", "time": 5947.109, "timestamp": "01:39:07", "text": "さあ、君は完全に落ちた。"}, {"type": "subtitle", "time": 5954.87, "timestamp": "01:39:14", "text": "民主主義が私を守ってくれる。"}, {"type": "subtitle", "time": 5972.47, "timestamp": "01:39:32", "text": "かなりたくさんあります。ジョック、君には"}, {"type": "subtitle", "time": 5974.87, "timestamp": "01:39:34", "text": "少し後退する。"}, {"type": "subtitle", "time": 5977.75, "timestamp": "01:39:37", "text": "私はしようとしています。"}, {"type": "subtitle", "time": 5981.59, "timestamp": "01:39:41", "text": "砲撃を開始します。"}, {"type": "subtitle", "time": 5983.83, "timestamp": "01:39:43", "text": "ああ、必要なかったよ。落ちていく"}, {"type": "subtitle", "time": 5985.59, "timestamp": "01:39:45", "text": "カトラリー。もちろんだよ。そうではなかった"}]
[{"type": "subtitle", "time": 1750.31, "timestamp": "00:29:10", "text": "このゲーム、動作が重すぎる。"}, {"type": "subtitle", "time": 1760.389, "timestamp": "00:29:20", "text": "主要秩序を回復する。一体何なんだ"}, {"type": "subtitle", "time": 1774.549, "timestamp": "00:29:34", "text": "ゼロ"}, {"type": "subtitle", "time": 1776.71, "timestamp": "00:29:36", "text": "8日前。"}, {"type": "subtitle", "time": 1779.909, "timestamp": "00:29:39", "text": "武器のカスタマイズ機能が解放されました。"}, {"type": "subtitle", "time": 1781.99, "timestamp": "00:29:41", "text": "えっと、"}, {"type": "subtitle", "time": 1785.669, "timestamp": "00:29:45", "text": "下げて"}, {"type": "subtitle", "time": 1787.99, "timestamp": "00:29:47", "text": "グラフィック。ああ、なんてことだ、中程度の設定だ。"}, {"type": "subtitle", "time": 1789.75, "timestamp": "00:29:49", "text": "いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。"}, {"type": "subtitle", "time": 1792.399, "timestamp": "00:29:52", "text": "いいえ。いいえ。いいえ。 より低い。"}, {"type": "subtitle", "time": 1793.919, "timestamp": "00:29:53", "text": "より低い。 下げる"}, {"type": "subtitle", "time": 1796.159, "timestamp": "00:29:56", "text": "下げる 行く。さらに低い。わかった。"}, {"type": "subtitle", "time": 1799.12, "timestamp": "00:29:59", "text": "行く。さらに低い。わかった。 タブ。"}]
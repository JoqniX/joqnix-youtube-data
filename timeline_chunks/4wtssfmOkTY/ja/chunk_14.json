[{"type": "subtitle", "time": 841.75, "timestamp": "00:14:01", "text": "私のことをまた話してるの？精巧な。私は"}, {"type": "subtitle", "time": 845.11, "timestamp": "00:14:05", "text": "理解したいし、あなたに"}, {"type": "subtitle", "time": 846.949, "timestamp": "00:14:06", "text": "そちら側で詳しく説明してください"}, {"type": "subtitle", "time": 850.069, "timestamp": "00:14:10", "text": "そんな感じ。質問してもいいですよ。彼らは置かれるだろう"}, {"type": "subtitle", "time": 853.269, "timestamp": "00:14:13", "text": "彼らがしなければならないような場所で"}, {"type": "subtitle", "time": 860.31, "timestamp": "00:14:20", "text": "うん。そして、その反応に応じて、"}, {"type": "subtitle", "time": 862.15, "timestamp": "00:14:22", "text": "彼らとはまだ友達かもしれないし、"}, {"type": "subtitle", "time": 864.15, "timestamp": "00:14:24", "text": "切り取った方が良い"}, {"type": "subtitle", "time": 872.79, "timestamp": "00:14:32", "text": "しかし、進む方法はいくつかあります"}, {"type": "subtitle", "time": 876.069, "timestamp": "00:14:36", "text": "それについて実際に考えていました。無視して"}, {"type": "subtitle", "time": 878.069, "timestamp": "00:14:38", "text": "自分の好きなように。なぜ他人のことを気にかけるのか"}, {"type": "subtitle", "time": 879.829, "timestamp": "00:14:39", "text": "人々があなたのことを再び話題にしている？そこには"}, {"type": "subtitle", "time": 882.23, "timestamp": "00:14:42", "text": "結局はインターネットのせいですよね？"}, {"type": "subtitle", "time": 885.99, "timestamp": "00:14:45", "text": "そして私も、あなた方全員が直面してきた"}]
[{"type": "subtitle", "time": 7202.07, "timestamp": "02:00:02", "text": "つまり、ほとんど"}, {"type": "subtitle", "time": 7203.83, "timestamp": "02:00:03", "text": "あれってなんて言うんだっけ？まるで"}, {"type": "subtitle", "time": 7214.47, "timestamp": "02:00:14", "text": "私の船に乗り込んでくれました。私は槍です"}, {"type": "subtitle", "time": 7234.55, "timestamp": "02:00:34", "text": "私も参加します。"}, {"type": "subtitle", "time": 7238.39, "timestamp": "02:00:38", "text": "連合軍駆逐艦の座標を受信しました。"}, {"type": "subtitle", "time": 7248.149, "timestamp": "02:00:48", "text": "私はショーをやったことがありません。"}, {"type": "subtitle", "time": 7254.229, "timestamp": "02:00:54", "text": "我が神よ。君抜きでジョックを試してみて。"}, {"type": "subtitle", "time": 7257.27, "timestamp": "02:00:57", "text": "ああ、背中が痛い。"}, {"type": "subtitle", "time": 7259.109, "timestamp": "02:00:59", "text": "RIP。"}]
[{"type": "subtitle", "time": 6603.189, "timestamp": "01:50:03", "text": "私は"}, {"type": "subtitle", "time": 6605.189, "timestamp": "01:50:05", "text": "バターと"}, {"type": "subtitle", "time": 6608.31, "timestamp": "01:50:08", "text": "ショック。わーい。あなたは勉強している。はい。ああ、"}, {"type": "subtitle", "time": 6611.109, "timestamp": "01:50:11", "text": "神。爆弾がある。"}, {"type": "subtitle", "time": 6615.02, "timestamp": "01:50:15", "text": "君の方へ向かっているよ。持続する。"}, {"type": "subtitle", "time": 6617.91, "timestamp": "01:50:17", "text": "[音楽]"}, {"type": "subtitle", "time": 6619.75, "timestamp": "01:50:19", "text": "いいえ。"}, {"type": "subtitle", "time": 6623.03, "timestamp": "01:50:23", "text": "彼とはお別れだ。うん。ああ、そこには"}, {"type": "subtitle", "time": 6626.47, "timestamp": "01:50:26", "text": "ハルク。私にはそれがわかる。入ってこい、ハルク。あなた"}, {"type": "subtitle", "time": 6628.31, "timestamp": "01:50:28", "text": "言う？"}, {"type": "subtitle", "time": 6631.669, "timestamp": "01:50:31", "text": "誰かハルクって言った？"}, {"type": "subtitle", "time": 6633.83, "timestamp": "01:50:33", "text": "彼は落ち込んでいる。"}, {"type": "subtitle", "time": 6643.669, "timestamp": "01:50:43", "text": "ああ、もう一人ハルクがいる。"}, {"type": "subtitle", "time": 6645.83, "timestamp": "01:50:45", "text": "ああ、しまった。"}, {"type": "subtitle", "time": 6649.51, "timestamp": "01:50:49", "text": "ああ、でも、まだ戻ってないと思う。"}, {"type": "subtitle", "time": 6651.43, "timestamp": "01:50:51", "text": "彼は戻ってきていない。"}, {"type": "subtitle", "time": 6654.47, "timestamp": "01:50:54", "text": "Butはまだ戻ってきていないと思います。彼は去った"}, {"type": "subtitle", "time": 6656.87, "timestamp": "01:50:56", "text": "VCとか、その他諸々。"}]
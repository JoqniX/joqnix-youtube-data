[{"type": "subtitle", "time": 6186.629, "timestamp": "01:43:06", "text": "本当にここはヘルダイブですか？それは"}, {"type": "subtitle", "time": 6190.31, "timestamp": "01:43:10", "text": "雨？あれは雨だ。はい。はい、まさにその通りです。"}, {"type": "subtitle", "time": 6193.189, "timestamp": "01:43:13", "text": "あ、私の物だ。それは火山です"}, {"type": "subtitle", "time": 6198.95, "timestamp": "01:43:18", "text": "あのね？"}, {"type": "subtitle", "time": 6202.07, "timestamp": "01:43:22", "text": "ここではあなたに照準を合わせることができません。楽しんでください"}, {"type": "subtitle", "time": 6203.99, "timestamp": "01:43:23", "text": "それ。"}, {"type": "subtitle", "time": 6207.59, "timestamp": "01:43:27", "text": "弾丸。それらは自由の雫だ。"}, {"type": "subtitle", "time": 6210.07, "timestamp": "01:43:30", "text": "はい。それは水ではありません。それは水ではありません。その"}, {"type": "subtitle", "time": 6212.55, "timestamp": "01:43:32", "text": "お茶が降ってくる。"}, {"type": "subtitle", "time": 6218.709, "timestamp": "01:43:38", "text": "クロノス。"}, {"type": "subtitle", "time": 6221.43, "timestamp": "01:43:41", "text": "なぜそれが詩的なのか、私にはわからない。"}, {"type": "subtitle", "time": 6223.51, "timestamp": "01:43:43", "text": "それは民主主義だ。"}, {"type": "subtitle", "time": 6225.59, "timestamp": "01:43:45", "text": "地球は泣いている、なぜなら"}, {"type": "subtitle", "time": 6236.79, "timestamp": "01:43:56", "text": "何てことだ。私は言わない"}, {"type": "subtitle", "time": 6239.51, "timestamp": "01:43:59", "text": "黄金のシャワー。"}]
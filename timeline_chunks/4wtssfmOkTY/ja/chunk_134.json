[{"type": "subtitle", "time": 8042.47, "timestamp": "02:14:02", "text": "イエス。何てことだ。"}, {"type": "subtitle", "time": 8043.51, "timestamp": "02:14:03", "text": "あのね？私はそれを殺します"}, {"type": "subtitle", "time": 8045.589, "timestamp": "02:14:05", "text": "補給ビーコン。"}, {"type": "subtitle", "time": 8047.91, "timestamp": "02:14:07", "text": "動かないで下さい。いいえ。"}, {"type": "subtitle", "time": 8050.79, "timestamp": "02:14:10", "text": "ああ、実際死んでしまうかもしれない。"}, {"type": "subtitle", "time": 8053.51, "timestamp": "02:14:13", "text": "いいえ、10秒です。"}, {"type": "subtitle", "time": 8058.87, "timestamp": "02:14:18", "text": "なぜ？セブン。六。五。私は死んでいた。"}, {"type": "subtitle", "time": 8062.87, "timestamp": "02:14:22", "text": "ああ、炎上したよ。たくさんあります"}, {"type": "subtitle", "time": 8064.709, "timestamp": "02:14:24", "text": "彼ら。"}, {"type": "subtitle", "time": 8066.629, "timestamp": "02:14:26", "text": "心配しないで。私はあらゆる炎を持っています"}, {"type": "subtitle", "time": 8084.79, "timestamp": "02:14:44", "text": "手榴弾を余分に手に入れた。ああ、なんてことだ、"}, {"type": "subtitle", "time": 8091.19, "timestamp": "02:14:51", "text": "何てことだ。"}]
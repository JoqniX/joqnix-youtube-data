[{"type": "subtitle", "time": 1982.47, "timestamp": "00:33:02", "text": "おい、君。"}, {"type": "subtitle", "time": 1984.389, "timestamp": "00:33:04", "text": "同じ。"}, {"type": "subtitle", "time": 1987.35, "timestamp": "00:33:07", "text": "前回はうまくいかなかった。"}, {"type": "subtitle", "time": 1989.909, "timestamp": "00:33:09", "text": "私は恋しい"}, {"type": "subtitle", "time": 1993.19, "timestamp": "00:33:13", "text": "うん、以前のPCが懐かしいな。"}, {"type": "subtitle", "time": 1999.669, "timestamp": "00:33:19", "text": "このゲームをプレイしたが、それは死んでしまった。ええ、そうですね。"}, {"type": "subtitle", "time": 2004.23, "timestamp": "00:33:24", "text": "ええと、私のグラフィックはピクセルみたいに見えます。"}, {"type": "subtitle", "time": 2006.95, "timestamp": "00:33:26", "text": "ピクセルゲームをプレイしているんだけど、まあいいよ。"}, {"type": "subtitle", "time": 2013.11, "timestamp": "00:33:33", "text": "はい、これはピクセルゲームです。"}, {"type": "subtitle", "time": 2022.789, "timestamp": "00:33:42", "text": "わかった。ああ、なんてことだ、私のパソコンが壊れそうだ。どうですか"}, {"type": "subtitle", "time": 2025.19, "timestamp": "00:33:45", "text": "まだ死にかけているの？"}, {"type": "subtitle", "time": 2034.71, "timestamp": "00:33:54", "text": "神様、私はあまり得意ではありません 私はあまり得意ではありません"}, {"type": "subtitle", "time": 2036.549, "timestamp": "00:33:56", "text": "このゲーム。"}, {"type": "subtitle", "time": 2038.789, "timestamp": "00:33:58", "text": "大丈夫。ご心配なく。病気"}]
[{"type": "subtitle", "time": 4749.91, "timestamp": "01:19:09", "text": "行ってみようかな。はい、準備はできました。"}, {"type": "subtitle", "time": 4754.55, "timestamp": "01:19:14", "text": "私たちはブーイングします。おお、"}, {"type": "subtitle", "time": 4757.11, "timestamp": "01:19:17", "text": "忘れてた。"}, {"type": "subtitle", "time": 4767.669, "timestamp": "01:19:27", "text": "待って、これが一番難しい難易度なの？"}, {"type": "subtitle", "time": 4771.59, "timestamp": "01:19:31", "text": "いいえ。ええと、2番目です。絶対に。いいえ。ああ、それは"}, {"type": "subtitle", "time": 4772.87, "timestamp": "01:19:32", "text": "最も難しい難易度ではない。それだけです"}, {"type": "subtitle", "time": 4775.51, "timestamp": "01:19:35", "text": "知っておく必要があります。"}, {"type": "subtitle", "time": 4777.35, "timestamp": "01:19:37", "text": "超地獄のダイブではない。まさに地獄だ"}, {"type": "subtitle", "time": 4779.03, "timestamp": "01:19:39", "text": "ダイビング。"}, {"type": "subtitle", "time": 4780.63, "timestamp": "01:19:40", "text": "地獄の底へ飛び込め。心配しないで。あなただけ"}, {"type": "subtitle", "time": 4781.99, "timestamp": "01:19:41", "text": "これは最も難しいことではないことを知っておく必要がある"}, {"type": "subtitle", "time": 4789.189, "timestamp": "01:19:49", "text": "しかし、シューマ氏は、"}, {"type": "subtitle", "time": 4791.669, "timestamp": "01:19:51", "text": "彼女に見せて、ジャックに何が最高かを見せてあげよう"}, {"type": "subtitle", "time": 4794.39, "timestamp": "01:19:54", "text": "地獄。"}, {"type": "subtitle", "time": 4797.11, "timestamp": "01:19:57", "text": "ああ、神様。"}, {"type": "subtitle", "time": 4799.83, "timestamp": "01:19:59", "text": "また。はい。そしてまたまたまた"}]
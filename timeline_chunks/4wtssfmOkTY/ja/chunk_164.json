[{"type": "subtitle", "time": 9848.15, "timestamp": "02:44:08", "text": "ああ、それは来る、それは弾ける、そこへ行く"}, {"type": "subtitle", "time": 9850.63, "timestamp": "02:44:10", "text": "うん、そこに行くよ。うん、わかるでしょ。"}, {"type": "subtitle", "time": 9853.269, "timestamp": "02:44:13", "text": "コマンドはそこに行くのですが、"}, {"type": "subtitle", "time": 9857.75, "timestamp": "02:44:17", "text": "古いものは大きなチャットボックスです"}, {"type": "subtitle", "time": 9859.75, "timestamp": "02:44:19", "text": "えーと"}, {"type": "subtitle", "time": 9862.71, "timestamp": "02:44:22", "text": "まだそこに見える。修正する必要がある"}, {"type": "subtitle", "time": 9866.389, "timestamp": "02:44:26", "text": "コマンド。うん、やらなきゃいけないことがあるんだ。"}, {"type": "subtitle", "time": 9871.75, "timestamp": "02:44:31", "text": "ああ、ラザニア、元気かい？オハイオ州バカ。"}, {"type": "subtitle", "time": 9874.23, "timestamp": "02:44:34", "text": "ジオさん、お元気ですか？さて、"}, {"type": "subtitle", "time": 9876.55, "timestamp": "02:44:36", "text": "今日は何をするの？"}, {"type": "subtitle", "time": 9879.51, "timestamp": "02:44:39", "text": "バカは今日はどうしている？"}, {"type": "subtitle", "time": 9882.23, "timestamp": "02:44:42", "text": "はい。"}, {"type": "subtitle", "time": 9888.309, "timestamp": "02:44:48", "text": "そして、大きいものも小さいものも。はい。大きくて"}, {"type": "subtitle", "time": 9891.19, "timestamp": "02:44:51", "text": "ちょっとした雑談。はい。"}, {"type": "subtitle", "time": 9894.87, "timestamp": "02:44:54", "text": "うん。正直に言うと、"}, {"type": "subtitle", "time": 9898.15, "timestamp": "02:44:58", "text": "大小のチャット機能。私 私 私"}]
[{"type": "subtitle", "time": 16801.03, "timestamp": "04:40:01", "text": "知る。見てみましょう。これを全部飲ませてください"}, {"type": "subtitle", "time": 16814.39, "timestamp": "04:40:14", "text": "ああ、本当に美味しい。"}, {"type": "subtitle", "time": 16819.03, "timestamp": "04:40:19", "text": "バニラ風味の牛乳って本当に美味しいよね。だから私は"}, {"type": "subtitle", "time": 16821.35, "timestamp": "04:40:21", "text": "プロテインパウダー。"}, {"type": "subtitle", "time": 16825.27, "timestamp": "04:40:25", "text": "ああ、私は弱い。弱いね、ベイビー。"}, {"type": "subtitle", "time": 16827.59, "timestamp": "04:40:27", "text": "そうですね、"}, {"type": "subtitle", "time": 16831.03, "timestamp": "04:40:31", "text": "私は、私が買った"}, {"type": "subtitle", "time": 16834.55, "timestamp": "04:40:34", "text": "バニラレベルの"}, {"type": "subtitle", "time": 16837.75, "timestamp": "04:40:37", "text": "砂糖不使用ではありません"}, {"type": "subtitle", "time": 16839.59, "timestamp": "04:40:39", "text": "そして確かに"}, {"type": "subtitle", "time": 16843.59, "timestamp": "04:40:43", "text": "プロテインシェイク（プロテインミルク入り）。"}, {"type": "subtitle", "time": 16845.83, "timestamp": "04:40:45", "text": "そうですね、"}, {"type": "subtitle", "time": 16849.49, "timestamp": "04:40:49", "text": "それは私にとって非常に役立っています。"}, {"type": "subtitle", "time": 16851.75, "timestamp": "04:40:51", "text": "[音楽]"}, {"type": "subtitle", "time": 16853.27, "timestamp": "04:40:53", "text": "はい。"}, {"type": "subtitle", "time": 16854.948, "timestamp": "04:40:54", "text": "全て"}]
[{"type": "subtitle", "time": 10080.87, "timestamp": "02:48:00", "text": "ストリーム、私はボード上でLeを使います"}, {"type": "subtitle", "time": 10082.55, "timestamp": "02:48:02", "text": "背景"}, {"type": "subtitle", "time": 10086.07, "timestamp": "02:48:06", "text": "ええと、以上です。しかし、Twitch ストリームでは、"}, {"type": "subtitle", "time": 10089.269, "timestamp": "02:48:09", "text": "３つ、４つ開ける必要がある"}, {"type": "subtitle", "time": 10091.429, "timestamp": "02:48:11", "text": "アプリケーション、"}, {"type": "subtitle", "time": 10095.349, "timestamp": "02:48:15", "text": "右？ストリーマーボットです。"}, {"type": "subtitle", "time": 10100.79, "timestamp": "02:48:20", "text": "タッチボトル、ミクボット、ファイアボット。"}, {"type": "subtitle", "time": 10105.03, "timestamp": "02:48:25", "text": "ああ、もしあなたがボイスアタックを含めるなら、"}, {"type": "subtitle", "time": 10107.11, "timestamp": "02:48:27", "text": "あなたは解雇されます。"}, {"type": "subtitle", "time": 10110.95, "timestamp": "02:48:30", "text": "あ、待って。声への攻撃について。"}, {"type": "subtitle", "time": 10113.75, "timestamp": "02:48:33", "text": "ああ、そうだね。声への攻撃について。あなたは"}, {"type": "subtitle", "time": 10115.51, "timestamp": "02:48:35", "text": "声を復活させるべきだと思う"}, {"type": "subtitle", "time": 10122.55, "timestamp": "02:48:42", "text": "それは可能です。"}, {"type": "subtitle", "time": 10124.87, "timestamp": "02:48:44", "text": "全員にヘッドパッドを。例えば私が言うように"}, {"type": "subtitle", "time": 10126.469, "timestamp": "02:48:46", "text": "ヘッドパッド、"}, {"type": "subtitle", "time": 10129.51, "timestamp": "02:48:49", "text": "それはコマンドとそれを実行します"}, {"type": "subtitle", "time": 10131.91, "timestamp": "02:48:51", "text": "ずっと昔のことのように"}, {"type": "subtitle", "time": 10135.03, "timestamp": "02:48:55", "text": "かつて私たちが持っていたもの、そして"}, {"type": "subtitle", "time": 10137.99, "timestamp": "02:48:57", "text": "また、忠誠心を取り戻したい"}]
[{"type": "subtitle", "time": 8887.11, "timestamp": "02:28:07", "text": "わかった、またいつかプレイしよう。"}, {"type": "subtitle", "time": 8888.87, "timestamp": "02:28:08", "text": "[ __ ]。"}, {"type": "subtitle", "time": 8890.79, "timestamp": "02:28:10", "text": "このゲーム、すごく動作が重かった。おお"}, {"type": "subtitle", "time": 8893.429, "timestamp": "02:28:13", "text": "ああ、いつか私たちは"}, {"type": "subtitle", "time": 8900.63, "timestamp": "02:28:20", "text": "来て。弱い。"}, {"type": "subtitle", "time": 8905.11, "timestamp": "02:28:25", "text": "あ、待って。私は違います。私は設定しています"}, {"type": "subtitle", "time": 8909.51, "timestamp": "02:28:29", "text": "鎧を着た騎士。はい、そうです。それは"}, {"type": "subtitle", "time": 8913.99, "timestamp": "02:28:33", "text": "そうやって私は全てのラウンドを耐え抜くんだ。王"}, {"type": "subtitle", "time": 8915.67, "timestamp": "02:28:35", "text": "夜"}, {"type": "subtitle", "time": 8917.51, "timestamp": "02:28:37", "text": "含む"}, {"type": "subtitle", "time": 8919.19, "timestamp": "02:28:39", "text": "民主主義。"}]
[{"type": "subtitle", "time": 7757.27, "timestamp": "02:09:17", "text": "また一人。ああ、これだ。私は"}, {"type": "subtitle", "time": 7760.069, "timestamp": "02:09:20", "text": "終わり。背中が痛いです。"}, {"type": "subtitle", "time": 7762.79, "timestamp": "02:09:22", "text": "これで終わりですか？"}, {"type": "subtitle", "time": 7766.629, "timestamp": "02:09:26", "text": "ええ、この後ですね。うん、"}, {"type": "subtitle", "time": 7768.709, "timestamp": "02:09:28", "text": "休んでコラボしよう"}, {"type": "subtitle", "time": 7773.83, "timestamp": "02:09:33", "text": "あなたは見逃すべきです、なぜあなたが"}, {"type": "subtitle", "time": 7776.069, "timestamp": "02:09:36", "text": "真夜中にコラボレーションを計画しているが、"}, {"type": "subtitle", "time": 7779.669, "timestamp": "02:09:39", "text": "男性の美品を知っている最初のコラボレーション"}, {"type": "subtitle", "time": 7783.75, "timestamp": "02:09:43", "text": "カナダにあるので、その後"}, {"type": "subtitle", "time": 7786.47, "timestamp": "02:09:46", "text": "うん、タイムゾーン"}, {"type": "subtitle", "time": 7790.149, "timestamp": "02:09:50", "text": "ああ、大丈夫だよ、俺も経験あるから。"}, {"type": "subtitle", "time": 7797.43, "timestamp": "02:09:57", "text": "ああ、ここは森林バイオームなんだ"}, {"type": "subtitle", "time": 7799.91, "timestamp": "02:09:59", "text": "これは何だ？こんなの見たことないぞ。"}]
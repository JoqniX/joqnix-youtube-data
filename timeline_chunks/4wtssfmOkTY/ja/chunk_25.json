[{"type": "subtitle", "time": 1501.43, "timestamp": "00:25:01", "text": "私が話したり、物語を語ったりする場所"}, {"type": "subtitle", "time": 1505.83, "timestamp": "00:25:05", "text": "ホイッスル。ええと、そのシリーズは中断されます"}, {"type": "subtitle", "time": 1508.47, "timestamp": "00:25:08", "text": "主要イベントの発表のため"}, {"type": "subtitle", "time": 1511.43, "timestamp": "00:25:11", "text": "この後に行われるイベント。そうですね、"}, {"type": "subtitle", "time": 1514.549, "timestamp": "00:25:14", "text": "そのことは、"}, {"type": "subtitle", "time": 1517.029, "timestamp": "00:25:17", "text": "今。それに集中できないと思う"}, {"type": "subtitle", "time": 1519.35, "timestamp": "00:25:19", "text": "今。後でまた取り上げます"}, {"type": "subtitle", "time": 1522.71, "timestamp": "00:25:22", "text": "後ほど、より高画質な形式でお送りします。そうですね"}, {"type": "subtitle", "time": 1526.71, "timestamp": "00:25:26", "text": "それは最初の発表の一つです"}, {"type": "subtitle", "time": 1529.669, "timestamp": "00:25:29", "text": "そして第二に"}, {"type": "subtitle", "time": 1533.83, "timestamp": "00:25:33", "text": "えっと、これがメインのお知らせです"}, {"type": "subtitle", "time": 1536.39, "timestamp": "00:25:36", "text": "私が作りたかったもの"}, {"type": "subtitle", "time": 1541.83, "timestamp": "00:25:41", "text": "そして、これに入る前に、ああ、これは"}, {"type": "subtitle", "time": 1546.87, "timestamp": "00:25:46", "text": "これは難しいので"}, {"type": "subtitle", "time": 1552.23, "timestamp": "00:25:52", "text": "ああ、神様、私にはできません。わかりました。"}, {"type": "subtitle", "time": 1554.71, "timestamp": "00:25:54", "text": "さて、重大発表です"}, {"type": "subtitle", "time": 1556.71, "timestamp": "00:25:56", "text": "私がストリームを作ろうと思ったのは"}]
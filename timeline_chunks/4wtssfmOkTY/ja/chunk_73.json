[{"type": "subtitle", "time": 4381.43, "timestamp": "01:13:01", "text": "まだケープをリリースしていない"}, {"type": "subtitle", "time": 4395.11, "timestamp": "01:13:15", "text": "ガストラック。ああ、これが必要だ。"}, {"type": "subtitle", "time": 4397.669, "timestamp": "01:13:17", "text": "ああ、しまった、手に入らない。それはフレアだ"}, {"type": "subtitle", "time": 4399.83, "timestamp": "01:13:19", "text": "しかし、そのギャップがある。"}, {"type": "subtitle", "time": 4402.149, "timestamp": "01:13:22", "text": "アップグレードできるかどうか確認してみます。船"}, {"type": "subtitle", "time": 4404.87, "timestamp": "01:13:24", "text": "弾薬。おい、何もアップグレードできないよ"}, {"type": "subtitle", "time": 4407.35, "timestamp": "01:13:27", "text": "その瞬間。"}, {"type": "subtitle", "time": 4409.43, "timestamp": "01:13:29", "text": "シールド"}, {"type": "subtitle", "time": 4412.87, "timestamp": "01:13:32", "text": "炎の番兵。対戦車"}, {"type": "subtitle", "time": 4416.149, "timestamp": "01:13:36", "text": "持ち運び可能な地獄爆弾。何？"}, {"type": "subtitle", "time": 4418.47, "timestamp": "01:13:38", "text": "ああ、私の兄は私の兄は愛している"}, {"type": "subtitle", "time": 4421.59, "timestamp": "01:13:41", "text": "それ。あれは最高だ。彼は"}, {"type": "subtitle", "time": 4424.07, "timestamp": "01:13:44", "text": "敵の集団に対して敬礼するだけ"}, {"type": "subtitle", "time": 4428.229, "timestamp": "01:13:48", "text": "そして爆発する。おお。"}, {"type": "subtitle", "time": 4431.03, "timestamp": "01:13:51", "text": "あなたが死んだら、それも爆発する。"}, {"type": "subtitle", "time": 4432.709, "timestamp": "01:13:52", "text": "えっと、アーマーを着ているなら、"}, {"type": "subtitle", "time": 4435.83, "timestamp": "01:13:55", "text": "えっと、鎧。特定の"}]
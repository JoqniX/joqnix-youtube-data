[{"type": "subtitle", "time": 662.47, "timestamp": "00:11:02", "text": "あれは彼のチャンネルですよね？どうぞ"}, {"type": "subtitle", "time": 666.63, "timestamp": "00:11:06", "text": "それ。はい、それが彼のチャンネルです。わかった。"}, {"type": "subtitle", "time": 669.75, "timestamp": "00:11:09", "text": "こんにちは。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 673.35, "timestamp": "00:11:13", "text": "レイアウトを変更したいです。"}, {"type": "subtitle", "time": 692.47, "timestamp": "00:11:32", "text": "ねえ、最大500をお探しですか？"}, {"type": "subtitle", "time": 695.269, "timestamp": "00:11:35", "text": "フォロワー？ Kick にボットがいるのはなぜですか、"}, {"type": "subtitle", "time": 698.47, "timestamp": "00:11:38", "text": "兄弟？何てことだ。モデレーターが必要です。えっと"}, {"type": "subtitle", "time": 701.19, "timestamp": "00:11:41", "text": "Kickの今日の予定は？スパマーが多すぎる"}, {"type": "subtitle", "time": 705.35, "timestamp": "00:11:45", "text": "キックしてこう言う"}, {"type": "subtitle", "time": 708.069, "timestamp": "00:11:48", "text": "「フォロワーを増やしたいですか？私を追加してください"}, {"type": "subtitle", "time": 709.67, "timestamp": "00:11:49", "text": "不和。"}, {"type": "subtitle", "time": 712.15, "timestamp": "00:11:52", "text": "無料の視聴者を獲得したいですか？私を追加してください"}, {"type": "subtitle", "time": 716.15, "timestamp": "00:11:56", "text": "「Discord」。そして、なんと、それは偽物です。"}]
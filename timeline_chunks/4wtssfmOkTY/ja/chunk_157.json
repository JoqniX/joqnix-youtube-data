[{"type": "subtitle", "time": 9432.79, "timestamp": "02:37:12", "text": "皆さん、お元気ですか？"}, {"type": "subtitle", "time": 9443.19, "timestamp": "02:37:23", "text": "昨日はみんなに会えなくて本当に寂しかったよ。私"}, {"type": "subtitle", "time": 9446.63, "timestamp": "02:37:26", "text": "皆さんにとても会いたかったです。"}, {"type": "subtitle", "time": 9457.03, "timestamp": "02:37:37", "text": "はい。みんなにすごく会いたかったよ。"}, {"type": "subtitle", "time": 9461.19, "timestamp": "02:37:41", "text": "さて、バカは今日はどうしているだろうか？"}, {"type": "subtitle", "time": 9463.349, "timestamp": "02:37:43", "text": "うん。"}, {"type": "subtitle", "time": 9465.349, "timestamp": "02:37:45", "text": "ええ、そうですね。"}, {"type": "subtitle", "time": 9468.55, "timestamp": "02:37:48", "text": "えっと、昨日の配信はすごく疲れた"}, {"type": "subtitle", "time": 9471.75, "timestamp": "02:37:51", "text": "疲れた。目が覚めたとき、なぜかわかりません"}, {"type": "subtitle", "time": 9477.91, "timestamp": "02:37:57", "text": "起きて、えっと、私はこう思った"}]
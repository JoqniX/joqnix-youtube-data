[{"type": "subtitle", "time": 8763.11, "timestamp": "02:26:03", "text": "やってみろ。あなたはできる。あなたは素晴らしいです。あなた"}, {"type": "subtitle", "time": 8765.03, "timestamp": "02:26:05", "text": "できるよ。まもなく崩壊するだろう。ありがとう、"}, {"type": "subtitle", "time": 8770.63, "timestamp": "02:26:10", "text": "こんにちは、アレックス。お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 8773.91, "timestamp": "02:26:13", "text": "こんにちは、アレクサ。素敵な夜をお過ごしください。"}, {"type": "subtitle", "time": 8778.79, "timestamp": "02:26:18", "text": "私たちは持っているはずです"}, {"type": "subtitle", "time": 8783.67, "timestamp": "02:26:23", "text": "あなたにそう言うのは気が引けるけど、まあ、そうだね。"}, {"type": "subtitle", "time": 8785.67, "timestamp": "02:26:25", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 8789.11, "timestamp": "02:26:29", "text": "はい、私は何者でもありません。私は壁だ。どうぞ"}, {"type": "subtitle", "time": 8793.75, "timestamp": "02:26:33", "text": "行くよ。左側は終わった。"}, {"type": "subtitle", "time": 8797.429, "timestamp": "02:26:37", "text": "シューマ氏を支持する姿勢を改めて強調する。"}, {"type": "subtitle", "time": 8799.27, "timestamp": "02:26:39", "text": "おお、"}, {"type": "subtitle", "time": 8802.23, "timestamp": "02:26:42", "text": "はい。援軍を要請する。"}, {"type": "subtitle", "time": 8803.99, "timestamp": "02:26:43", "text": "技術的には、私たちは無制限に"}, {"type": "subtitle", "time": 8806.23, "timestamp": "02:26:46", "text": "強化。"}, {"type": "subtitle", "time": 8808.07, "timestamp": "02:26:48", "text": "はい、そうです。"}, {"type": "subtitle", "time": 8813.19, "timestamp": "02:26:53", "text": "一つずつ粘り強く取り組む。はい。"}, {"type": "subtitle", "time": 8815.19, "timestamp": "02:26:55", "text": "解放する準備はできている。"}, {"type": "subtitle", "time": 8817.67, "timestamp": "02:26:57", "text": "ああ、しまった。私のすぐ後ろにあるんですよね？"}]
[{"type": "subtitle", "time": 2167.19, "timestamp": "00:36:07", "text": "ところで。"}, {"type": "subtitle", "time": 2173.589, "timestamp": "00:36:13", "text": "ああ、なんてことだ、私のPCが壊れそうだ。"}, {"type": "subtitle", "time": 2176.31, "timestamp": "00:36:16", "text": "なんてこった、"}, {"type": "subtitle", "time": 2179.67, "timestamp": "00:36:19", "text": "私と一緒にこのゲームをしましょう。"}, {"type": "subtitle", "time": 2181.589, "timestamp": "00:36:21", "text": "ついに最適化に成功しました"}, {"type": "subtitle", "time": 2184.55, "timestamp": "00:36:24", "text": "ゲーム。時間がかかりました。みんな、私は"}, {"type": "subtitle", "time": 2187.03, "timestamp": "00:36:27", "text": "死んだ。みんな、私は死んだ。例えばどんな"}, {"type": "subtitle", "time": 2190.71, "timestamp": "00:36:30", "text": "君のところまで狂ったように行く"}, {"type": "subtitle", "time": 2198.55, "timestamp": "00:36:38", "text": "みんな？私の配信を見て、私が"}, {"type": "subtitle", "time": 2202.47, "timestamp": "00:36:42", "text": "亡くなった。イエス・キリスト。"}, {"type": "subtitle", "time": 2206.87, "timestamp": "00:36:46", "text": "Sha podがあなたの場所に向かっています。"}, {"type": "subtitle", "time": 2209.349, "timestamp": "00:36:49", "text": "それは高く評価されるべきことだ。"}, {"type": "subtitle", "time": 2211.75, "timestamp": "00:36:51", "text": "私はどうしてもあの建物を壊さなければならなかった。"}, {"type": "subtitle", "time": 2214.39, "timestamp": "00:36:54", "text": "みんな。私は誓います。"}, {"type": "subtitle", "time": 2217.829, "timestamp": "00:36:57", "text": "ああ、バター、君はレベル93だよ。"}]
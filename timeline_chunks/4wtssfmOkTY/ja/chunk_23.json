[{"type": "subtitle", "time": 1380.149, "timestamp": "00:23:00", "text": "皆さん、こんにちは。暖かい暖かい"}, {"type": "subtitle", "time": 1382.31, "timestamp": "00:23:02", "text": "皆さん、こんにちは。皆さんが"}, {"type": "subtitle", "time": 1384.149, "timestamp": "00:23:04", "text": "順調です。"}, {"type": "subtitle", "time": 1387.43, "timestamp": "00:23:07", "text": "えっと、この配信をしようと思ったのは"}, {"type": "subtitle", "time": 1389.19, "timestamp": "00:23:09", "text": "いくつか発表して"}, {"type": "subtitle", "time": 1394.47, "timestamp": "00:23:14", "text": "アップデート。えーと、もしあなたが聞いているなら"}, {"type": "subtitle", "time": 1396.549, "timestamp": "00:23:16", "text": "わざわざお越しいただき、ありがとうございます。"}, {"type": "subtitle", "time": 1399.909, "timestamp": "00:23:19", "text": "実際にこれを聞いている"}, {"type": "subtitle", "time": 1403.59, "timestamp": "00:23:23", "text": "発表。それは本当に大きな意味があります。それで"}, {"type": "subtitle", "time": 1405.909, "timestamp": "00:23:25", "text": "えっと、この発表はしない"}, {"type": "subtitle", "time": 1409.43, "timestamp": "00:23:29", "text": "大きすぎる。願わくば、私が"}, {"type": "subtitle", "time": 1415.51, "timestamp": "00:23:35", "text": "大きすぎるので、私の話は"}, {"type": "subtitle", "time": 1417.75, "timestamp": "00:23:37", "text": "うん"}, {"type": "subtitle", "time": 1420.549, "timestamp": "00:23:40", "text": "だから、私は試さないつもりです。私は"}, {"type": "subtitle", "time": 1423.35, "timestamp": "00:23:43", "text": "チャットは読んでるけど、しないようにする"}, {"type": "subtitle", "time": 1426.23, "timestamp": "00:23:46", "text": "えーっと、その間に話して、それを読み上げる"}, {"type": "subtitle", "time": 1429.19, "timestamp": "00:23:49", "text": "大声で、えっと、私はこれが欲しかった、これが欲しかった"}, {"type": "subtitle", "time": 1431.99, "timestamp": "00:23:51", "text": "発表はビデオのようなもの"}, {"type": "subtitle", "time": 1434.63, "timestamp": "00:23:54", "text": "フォーマットはいいけど、そうだね"}, {"type": "subtitle", "time": 1438.149, "timestamp": "00:23:58", "text": "まず最初に、"}]
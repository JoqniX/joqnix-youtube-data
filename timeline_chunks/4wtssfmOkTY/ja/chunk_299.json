[{"type": "subtitle", "time": 17941.67, "timestamp": "04:59:01", "text": "時々、私が聞いているとわかる"}, {"type": "subtitle", "time": 17944.708, "timestamp": "04:59:04", "text": "ランダムな曲を聴くことができる"}, {"type": "subtitle", "time": 17948.39, "timestamp": "04:59:08", "text": "メモからインスピレーションを得て、時には"}, {"type": "subtitle", "time": 17952.31, "timestamp": "04:59:12", "text": "それは突然私に襲いかかってくる。"}, {"type": "subtitle", "time": 17954.868, "timestamp": "04:59:14", "text": "だから私は「待って、なんで私はこれを歌ってるんだろう」と思った"}, {"type": "subtitle", "time": 17961.91, "timestamp": "04:59:21", "text": "[音楽]"}, {"type": "subtitle", "time": 17969.75, "timestamp": "04:59:29", "text": "それで、えっと、私の友達がこう言ったんです"}, {"type": "subtitle", "time": 17973.43, "timestamp": "04:59:33", "text": "毎日歌い続けるなら"}, {"type": "subtitle", "time": 17977.27, "timestamp": "04:59:37", "text": "あなたが何かをしているときいつでも"}, {"type": "subtitle", "time": 17979.99, "timestamp": "04:59:39", "text": "あなたがいつでもその瞬間に"}, {"type": "subtitle", "time": 17983.03, "timestamp": "04:59:43", "text": "物や何かを続けると"}, {"type": "subtitle", "time": 17985.83, "timestamp": "04:59:45", "text": "歌って歌って、それがトレーニング方法"}, {"type": "subtitle", "time": 17989.03, "timestamp": "04:59:49", "text": "より良い歌手になるために"}, {"type": "subtitle", "time": 17990.708, "timestamp": "04:59:50", "text": "そして"}, {"type": "subtitle", "time": 17992.55, "timestamp": "04:59:52", "text": "一日で歌手にはなれない"}, {"type": "subtitle", "time": 17994.55, "timestamp": "04:59:54", "text": "練習して練習して"}, {"type": "subtitle", "time": 17997.43, "timestamp": "04:59:57", "text": "そんな風に練習して、歌って、歌って。"}]
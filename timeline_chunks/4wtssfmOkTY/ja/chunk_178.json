[{"type": "subtitle", "time": 10682.309, "timestamp": "02:58:02", "text": "ずっと言ってきたけど、"}, {"type": "subtitle", "time": 10684.71, "timestamp": "02:58:04", "text": "話すときはもっと話す"}, {"type": "subtitle", "time": 10689.51, "timestamp": "02:58:09", "text": "ストリーム 私はたくさん話しますが、私は"}, {"type": "subtitle", "time": 10691.51, "timestamp": "02:58:11", "text": "今のそれを何て呼ぶんだっけ？"}, {"type": "subtitle", "time": 10695.75, "timestamp": "02:58:15", "text": "ゲーム配信をしたいのですが、話したいことがあります"}, {"type": "subtitle", "time": 10697.67, "timestamp": "02:58:17", "text": "自分が何をしているかを伝える。それは"}, {"type": "subtitle", "time": 10700.02, "timestamp": "02:58:20", "text": "そういうことですよね？"}, {"type": "subtitle", "time": 10702.15, "timestamp": "02:58:22", "text": "[音楽]"}, {"type": "subtitle", "time": 10704.309, "timestamp": "02:58:24", "text": "チャットも読みたいです。問題は"}, {"type": "subtitle", "time": 10706.389, "timestamp": "02:58:26", "text": "私はチャットを読んでいません。読んだけど"}, {"type": "subtitle", "time": 10710.389, "timestamp": "02:58:30", "text": "私の心の中では、ただそう感じるだけですが、"}, {"type": "subtitle", "time": 10714.79, "timestamp": "02:58:34", "text": "心の中で読んで、"}, {"type": "subtitle", "time": 10717.75, "timestamp": "02:58:37", "text": "えっと、私の心はすでに私が"}, {"type": "subtitle", "time": 10721.59, "timestamp": "02:58:41", "text": "すでに口ではそう言っていたが、実際は"}, {"type": "subtitle", "time": 10723.91, "timestamp": "02:58:43", "text": "私はそんなことは言っていません。"}, {"type": "subtitle", "time": 10726.71, "timestamp": "02:58:46", "text": "今頭の中で読んだんだけど、"}, {"type": "subtitle", "time": 10729.83, "timestamp": "02:58:49", "text": "私ははっきりとそう言いました。"}, {"type": "subtitle", "time": 10732.79, "timestamp": "02:58:52", "text": "理由がわからない。"}, {"type": "subtitle", "time": 10734.72, "timestamp": "02:58:54", "text": "理由はわからないけど、"}, {"type": "subtitle", "time": 10735.83, "timestamp": "02:58:55", "text": "[音楽]"}, {"type": "subtitle", "time": 10739.349, "timestamp": "02:58:59", "text": "はい。どこの出身ですか？私はインド出身です。"}]
[{"type": "subtitle", "time": 3241.589, "timestamp": "00:54:01", "text": "私は「I」と書くべきだったのに、なぜそうするのかわからない"}, {"type": "subtitle", "time": 3242.79, "timestamp": "00:54:02", "text": "アイロンを外した。なぜだかわからない"}, {"type": "subtitle", "time": 3244.069, "timestamp": "00:54:04", "text": "この銃のスコープを外した。そうするべきです。"}, {"type": "subtitle", "time": 3245.829, "timestamp": "00:54:05", "text": "範囲は維持した。私は見張り役を任命した"}, {"type": "subtitle", "time": 3260.63, "timestamp": "00:54:20", "text": "頭を撃て。"}, {"type": "subtitle", "time": 3264.45, "timestamp": "00:54:24", "text": "ああ、一体どういうことだ？ああ、くそ。"}, {"type": "subtitle", "time": 3266.15, "timestamp": "00:54:26", "text": "[音楽]"}, {"type": "subtitle", "time": 3268.15, "timestamp": "00:54:28", "text": "あれは誰？"}, {"type": "subtitle", "time": 3275.27, "timestamp": "00:54:35", "text": "「なんで彼はリロードしないんだろう？」って思ったよ。彼は"}, {"type": "subtitle", "time": 3278.79, "timestamp": "00:54:38", "text": "ただ、外出するのが大変なんです。ああ、しまった。"}, {"type": "subtitle", "time": 3281.67, "timestamp": "00:54:41", "text": "380からは逃げた方がいいよ。"}]
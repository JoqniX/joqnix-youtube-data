[{"type": "subtitle", "time": 7510.709, "timestamp": "02:05:10", "text": "どうやって"}, {"type": "subtitle", "time": 7513.189, "timestamp": "02:05:13", "text": "捜索隊はどこにいるのか？立ち入り禁止"}, {"type": "subtitle", "time": 7516.07, "timestamp": "02:05:16", "text": "注文。"}, {"type": "subtitle", "time": 7517.669, "timestamp": "02:05:17", "text": "地獄のダイブはあるが、スーパーはない"}, {"type": "subtitle", "time": 7524.87, "timestamp": "02:05:24", "text": "待って、それはあなたにとってはロック解除されているんですよね？"}, {"type": "subtitle", "time": 7532.79, "timestamp": "02:05:32", "text": "超地獄のダイブには見えない"}, {"type": "subtitle", "time": 7535.83, "timestamp": "02:05:35", "text": "ミッションは支配権の上にあります"}, {"type": "subtitle", "time": 7547.03, "timestamp": "02:05:47", "text": "確認してみます。急送、"}, {"type": "subtitle", "time": 7550.55, "timestamp": "02:05:50", "text": "あなたはどこに立ち向かいますか？"}, {"type": "subtitle", "time": 7552.39, "timestamp": "02:05:52", "text": "平和維持活動。戦術的に"}, {"type": "subtitle", "time": 7554.79, "timestamp": "02:05:54", "text": "障害物をすべて取り除く"}, {"type": "subtitle", "time": 7557.03, "timestamp": "02:05:57", "text": "平和への道。地獄のダイバーたちが戦う"}, {"type": "subtitle", "time": 7559.189, "timestamp": "02:05:59", "text": "自由。私たちに決めさせましょう。私たちには"}]
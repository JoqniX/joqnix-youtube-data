[{"type": "subtitle", "time": 11100.63, "timestamp": "03:05:00", "text": "普通の配信ですよね？"}, {"type": "subtitle", "time": 11103.11, "timestamp": "03:05:03", "text": "シャカ"}, {"type": "subtitle", "time": 11109.19, "timestamp": "03:05:09", "text": "ああ、でも私たちはこれを乗り越えるでしょう。だからありがとう"}, {"type": "subtitle", "time": 11111.59, "timestamp": "03:05:11", "text": "辛抱強く待ってくれてありがとう"}, {"type": "subtitle", "time": 11115.11, "timestamp": "03:05:15", "text": "今後は辛抱強くお待ちいただきありがとうございます"}, {"type": "subtitle", "time": 11118.71, "timestamp": "03:05:18", "text": "彼らが思いつくまで"}, {"type": "subtitle", "time": 11128.23, "timestamp": "03:05:28", "text": "うん。"}, {"type": "subtitle", "time": 11131.19, "timestamp": "03:05:31", "text": "そして昨日"}, {"type": "subtitle", "time": 11135.349, "timestamp": "03:05:35", "text": "実際、私はすごく嬉しかった。"}, {"type": "subtitle", "time": 11137.99, "timestamp": "03:05:37", "text": "えっと、昨日私はとても幸せでした"}, {"type": "subtitle", "time": 11142.87, "timestamp": "03:05:42", "text": "初めて話すことができた"}, {"type": "subtitle", "time": 11147.59, "timestamp": "03:05:47", "text": "日本人の方へ。そうだった"}, {"type": "subtitle", "time": 11149.269, "timestamp": "03:05:49", "text": "エマ。"}, {"type": "subtitle", "time": 11150.95, "timestamp": "03:05:50", "text": "えっと"}, {"type": "subtitle", "time": 11152.87, "timestamp": "03:05:52", "text": "彼女と話せて本当に嬉しかったです"}, {"type": "subtitle", "time": 11154.389, "timestamp": "03:05:54", "text": "昨日"}, {"type": "subtitle", "time": 11156.63, "timestamp": "03:05:56", "text": "そして学ぶ"}, {"type": "subtitle", "time": 11159.91, "timestamp": "03:05:59", "text": "彼女のことやその他諸々についてもっと詳しく。"}]
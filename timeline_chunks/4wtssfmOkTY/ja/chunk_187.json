[{"type": "subtitle", "time": 11222.55, "timestamp": "03:07:02", "text": "アニメがきっかけで日本語を学び始めました。"}, {"type": "subtitle", "time": 11226.55, "timestamp": "03:07:06", "text": "そう、アニメには脱帽だ。"}, {"type": "subtitle", "time": 11231.19, "timestamp": "03:07:11", "text": "そして、この日本の文化は"}, {"type": "subtitle", "time": 11235.03, "timestamp": "03:07:15", "text": "影響を受けて"}, {"type": "subtitle", "time": 11240.309, "timestamp": "03:07:20", "text": "えっと、私に色々なことを学ぶように影響を与えてくれる。する"}, {"type": "subtitle", "time": 11242.71, "timestamp": "03:07:22", "text": "それを測るのですか？ああ、私はキーログを取っています"}, {"type": "subtitle", "time": 11247.349, "timestamp": "03:07:27", "text": "アニメリスト関連のもの。私のアニメリストを記録する"}, {"type": "subtitle", "time": 11250.95, "timestamp": "03:07:30", "text": "もの。ということで、私にはアニメのリストがあります。私"}, {"type": "subtitle", "time": 11253.429, "timestamp": "03:07:33", "text": "コマンドを実行できると思います"}, {"type": "subtitle", "time": 11255.51, "timestamp": "03:07:35", "text": "感嘆符。待って、私はまだ"}, {"type": "subtitle", "time": 11258.71, "timestamp": "03:07:38", "text": "YouTube 用のコマンド。忘れた。忘れた。"}, {"type": "subtitle", "time": 11261.51, "timestamp": "03:07:41", "text": "だから、私はアニメリストに入っている。検索する場合"}, {"type": "subtitle", "time": 11265.19, "timestamp": "03:07:45", "text": "次は犬ですね。私も行きます。"}, {"type": "subtitle", "time": 11267.51, "timestamp": "03:07:47", "text": "はい。"}, {"type": "subtitle", "time": 11271.91, "timestamp": "03:07:51", "text": "私は測定し、記録します。"}]
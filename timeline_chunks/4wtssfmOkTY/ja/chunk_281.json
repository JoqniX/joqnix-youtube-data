[{"type": "subtitle", "time": 16864.44, "timestamp": "04:41:04", "text": "実現させよう"}, {"type": "subtitle", "time": 16866.708, "timestamp": "04:41:06", "text": "[音楽]"}, {"type": "subtitle", "time": 16878.23, "timestamp": "04:41:18", "text": "私はそうするべきではなかった。ああ、そうだ。これ"}, {"type": "subtitle", "time": 16882.15, "timestamp": "04:41:22", "text": "ちなみに、それは取締役会です。だから君は私を見ている"}, {"type": "subtitle", "time": 16885.83, "timestamp": "04:41:25", "text": "常にヘッドパッチを貼る"}, {"type": "subtitle", "time": 16888.15, "timestamp": "04:41:28", "text": "私の"}, {"type": "subtitle", "time": 16891.75, "timestamp": "04:41:31", "text": "彼らが登場するチャンネルはこちらです。それで"}, {"type": "subtitle", "time": 16896.15, "timestamp": "04:41:36", "text": "私が言っていたログ記録とは、こういうことです。はい。"}, {"type": "subtitle", "time": 16900.23, "timestamp": "04:41:40", "text": "これは購読者のみに表示されます"}, {"type": "subtitle", "time": 16903.27, "timestamp": "04:41:43", "text": "Twitchの購読者。私はそう作った"}, {"type": "subtitle", "time": 16905.67, "timestamp": "04:41:45", "text": "念のため、何が見えるか分かるように"}, {"type": "subtitle", "time": 16907.35, "timestamp": "04:41:47", "text": "起こっていること、そしてあなたが知っているのはこっそりと"}, {"type": "subtitle", "time": 16910.39, "timestamp": "04:41:50", "text": "ピーク。これらは私の前回のTwitch配信からのものです"}, {"type": "subtitle", "time": 16914.788, "timestamp": "04:41:54", "text": "ストリーム。そうですね、"}, {"type": "subtitle", "time": 16917.03, "timestamp": "04:41:57", "text": "私のコメントとみんな"}]
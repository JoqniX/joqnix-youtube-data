[{"type": "subtitle", "time": 4080.309, "timestamp": "01:08:00", "text": "ボットやバグよりも。"}, {"type": "subtitle", "time": 4081.91, "timestamp": "01:08:01", "text": "私は脱落戦が好きです。私は好きではありません"}, {"type": "subtitle", "time": 4087.43, "timestamp": "01:08:07", "text": "アパチ・ファンティーナ。ピットのボード。"}, {"type": "subtitle", "time": 4090.309, "timestamp": "01:08:10", "text": "化学兵器のためにウォーボーンを購入する必要があります"}, {"type": "subtitle", "time": 4093.67, "timestamp": "01:08:13", "text": "エージェント。無料で購入できます。はい、あなた"}, {"type": "subtitle", "time": 4096.39, "timestamp": "01:08:16", "text": "する。ひたすら努力するしかない。どうやって"}, {"type": "subtitle", "time": 4098.87, "timestamp": "01:08:18", "text": "入手できましたか？少なくともあなたは"}, {"type": "subtitle", "time": 4099.99, "timestamp": "01:08:19", "text": "何かの代金を支払う。手に入れることができる"}, {"type": "subtitle", "time": 4102.309, "timestamp": "01:08:22", "text": "すべて無料。確かに。それは"}, {"type": "subtitle", "time": 4105.43, "timestamp": "01:08:25", "text": "このゲームの良いところ。"}, {"type": "subtitle", "time": 4107.189, "timestamp": "01:08:27", "text": "何もお金を使う必要はありません。わかった。する"}, {"type": "subtitle", "time": 4110.709, "timestamp": "01:08:30", "text": "君たちはマスターの"}, {"type": "subtitle", "time": 4112.95, "timestamp": "01:08:32", "text": "何か価値があるのか​​？"}, {"type": "subtitle", "time": 4115.349, "timestamp": "01:08:35", "text": "つまり、あのエモートは面白いってこと。私は"}, {"type": "subtitle", "time": 4117.11, "timestamp": "01:08:37", "text": "それに対して感情を表現する。私はただ買うだけです"}, {"type": "subtitle", "time": 4121.349, "timestamp": "01:08:41", "text": "実際、感情表現ですね。ああ、でもそれはただ楽しいだけだよ。"}, {"type": "subtitle", "time": 4123.11, "timestamp": "01:08:43", "text": "行進するエモートは面白い。そこには"}, {"type": "subtitle", "time": 4126.55, "timestamp": "01:08:46", "text": "その中に秘密のイースターエッグが隠されています。"}, {"type": "subtitle", "time": 4129.51, "timestamp": "01:08:49", "text": "行進のエモートはどうやって入手するのですか？"}, {"type": "subtitle", "time": 4132.229, "timestamp": "01:08:52", "text": "えーと、司会者ウォーボンド。ああ、"}, {"type": "subtitle", "time": 4134.709, "timestamp": "01:08:54", "text": "最初のもの。いや、いや、いや。最新の"}, {"type": "subtitle", "time": 4136.95, "timestamp": "01:08:56", "text": "1つ。"}, {"type": "subtitle", "time": 4138.309, "timestamp": "01:08:58", "text": "それが最新の戦時国債です。その"}]
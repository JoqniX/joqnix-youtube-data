[{"type": "subtitle", "time": 16200.87, "timestamp": "04:30:00", "text": "そこから私は得る、私は得る、私は得る"}, {"type": "subtitle", "time": 16203.67, "timestamp": "04:30:03", "text": "チャットに誰がいたのかを知る"}, {"type": "subtitle", "time": 16206.63, "timestamp": "04:30:06", "text": "チャットで話しかけて、覚えておくように"}, {"type": "subtitle", "time": 16210.79, "timestamp": "04:30:10", "text": "あなたを呼び出して、最後に"}, {"type": "subtitle", "time": 16214.309, "timestamp": "04:30:14", "text": "ストリームとspに感謝します"}, {"type": "subtitle", "time": 16218.55, "timestamp": "04:30:18", "text": "時間を割いていただきありがとうございます。"}, {"type": "subtitle", "time": 16223.59, "timestamp": "04:30:23", "text": "私の場合、ご存知の通りです。はい。それで私は考えていた"}, {"type": "subtitle", "time": 16228.95, "timestamp": "04:30:28", "text": "[音楽]"}, {"type": "subtitle", "time": 16232.55, "timestamp": "04:30:32", "text": "YouTubeのチャットをログに記録すべきですが、"}, {"type": "subtitle", "time": 16234.95, "timestamp": "04:30:34", "text": "やりたいけど、やりたくない。"}, {"type": "subtitle", "time": 16239.75, "timestamp": "04:30:39", "text": "それは痛みだが、反響"}, {"type": "subtitle", "time": 16255.99, "timestamp": "04:30:55", "text": "[音楽]"}, {"type": "subtitle", "time": 16258.71, "timestamp": "04:30:58", "text": "はい。"}]
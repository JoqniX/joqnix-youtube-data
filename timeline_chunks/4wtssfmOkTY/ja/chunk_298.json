[{"type": "subtitle", "time": 17894.31, "timestamp": "04:58:14", "text": "待って、それは歌だよ。いいえ。ああ"}, {"type": "subtitle", "time": 17896.07, "timestamp": "04:58:16", "text": "我が神よ。なぜ私は歌ったのか"}, {"type": "subtitle", "time": 17899.35, "timestamp": "04:58:19", "text": "それ？なぜそのメロディーが"}, {"type": "subtitle", "time": 17902.55, "timestamp": "04:58:22", "text": "私の心？ああ、"}, {"type": "subtitle", "time": 17904.43, "timestamp": "04:58:24", "text": "待って。"}, {"type": "subtitle", "time": 17906.628, "timestamp": "04:58:26", "text": "[音楽]"}, {"type": "subtitle", "time": 17910.23, "timestamp": "04:58:30", "text": "待って、ちょっと待って。待って。これは私が"}, {"type": "subtitle", "time": 17912.628, "timestamp": "04:58:32", "text": "先ほど歌った曲も、それと似ていた。おお"}, {"type": "subtitle", "time": 17918.948, "timestamp": "04:58:38", "text": "待って、待って、待って、待って。私はこれを知っています"}, {"type": "subtitle", "time": 17922.708, "timestamp": "04:58:42", "text": "歌だけど、なぜ私は"}, {"type": "subtitle", "time": 17925.51, "timestamp": "04:58:45", "text": "でも待って、私のメロディーはどうやって"}, {"type": "subtitle", "time": 17928.788, "timestamp": "04:58:48", "text": "再び音が出ますか？何てことだ。どこにいるの、私の"}, {"type": "subtitle", "time": 17936.708, "timestamp": "04:58:56", "text": "おお、これは違う。ああ、神様。感謝"}]
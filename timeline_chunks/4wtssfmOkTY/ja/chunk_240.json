[{"type": "subtitle", "time": 14403.83, "timestamp": "04:00:03", "text": "ウェインA"}, {"type": "subtitle", "time": 14407.96, "timestamp": "04:00:07", "text": "それは明白で、そうです"}, {"type": "subtitle", "time": 14410.79, "timestamp": "04:00:10", "text": "[音楽]"}, {"type": "subtitle", "time": 14413.83, "timestamp": "04:00:13", "text": "私はかなり上手です。ゾンビをプレイするだけです。"}, {"type": "subtitle", "time": 14416.389, "timestamp": "04:00:16", "text": "ゾンビゲームをプレイする。こんにちは、楽しんでいただけているといいのですが"}, {"type": "subtitle", "time": 14421.11, "timestamp": "04:00:21", "text": "Sakshanでのあなたのゲーム。私は楽しんでいます"}, {"type": "subtitle", "time": 14424.71, "timestamp": "04:00:24", "text": "頭が温かくなる。バカ"}]
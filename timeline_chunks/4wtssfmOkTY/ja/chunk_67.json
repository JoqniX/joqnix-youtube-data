[{"type": "subtitle", "time": 4020.71, "timestamp": "01:07:00", "text": "イカの目玉は路肩に捨てろ。いいえ、そうではありません"}, {"type": "subtitle", "time": 4023.19, "timestamp": "01:07:03", "text": "それらを受け取ってください。私たちはそれらを揚げました。揚げた"}, {"type": "subtitle", "time": 4026.47, "timestamp": "01:07:06", "text": "彼らでさえも。揚げ物。うん、大丈夫だよ。"}, {"type": "subtitle", "time": 4030.309, "timestamp": "01:07:10", "text": "エアフライヤーで揚げる料理。はい。うん。私たちは"}, {"type": "subtitle", "time": 4032.63, "timestamp": "01:07:12", "text": "健康的なものにしよう。民主的に揚げた"}, {"type": "subtitle", "time": 4035.19, "timestamp": "01:07:15", "text": "イカリング。"}, {"type": "subtitle", "time": 4042.63, "timestamp": "01:07:22", "text": "うん。このゲームは私を嫌っているようだ。それは"}, {"type": "subtitle", "time": 4044.71, "timestamp": "01:07:24", "text": "どうやってやるの？"}, {"type": "subtitle", "time": 4047.67, "timestamp": "01:07:27", "text": "おっと、やれやれ。"}, {"type": "subtitle", "time": 4056.39, "timestamp": "01:07:36", "text": "編集できません。"}, {"type": "subtitle", "time": 4058.71, "timestamp": "01:07:38", "text": "なぜ？ゲームで何かが起こっていた"}, {"type": "subtitle", "time": 4061.109, "timestamp": "01:07:41", "text": "人物の装飾が施されている。金色の縁取り"}, {"type": "subtitle", "time": 4063.589, "timestamp": "01:07:43", "text": "とても素敵ですね。私は当然知っている？私たち 私たち"}, {"type": "subtitle", "time": 4067.19, "timestamp": "01:07:47", "text": "ちなみに、彼らはスーパーアースを守っていた。"}, {"type": "subtitle", "time": 4071.27, "timestamp": "01:07:51", "text": "もうない。私たちは彼らを連れ出した。はい、"}, {"type": "subtitle", "time": 4074.789, "timestamp": "01:07:54", "text": "イルミナドは排除された。"}, {"type": "subtitle", "time": 4076.71, "timestamp": "01:07:56", "text": "悲しい。私はイルミナディドと戦う方が好きです"}]
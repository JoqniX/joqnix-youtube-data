[{"type": "subtitle", "time": 14163.11, "timestamp": "03:56:03", "text": "特別なASMRとかそういう類のもの"}, {"type": "subtitle", "time": 14167.75, "timestamp": "03:56:07", "text": "我々は持っていた。私たちはこれを挽回できる。"}, {"type": "subtitle", "time": 14171.269, "timestamp": "03:56:11", "text": "これを使えば、ご存知かもしれませんが、"}, {"type": "subtitle", "time": 14174.79, "timestamp": "03:56:14", "text": "それを行う方法の一つでもある。私は必要ない"}, {"type": "subtitle", "time": 14178.229, "timestamp": "03:56:18", "text": "私のものを作るのに長い道のりを要します"}, {"type": "subtitle", "time": 14180.71, "timestamp": "03:56:20", "text": "オリジナルですが、私も作りたいと思っています"}, {"type": "subtitle", "time": 14184.229, "timestamp": "03:56:24", "text": "私のオリジナルです。"}, {"type": "subtitle", "time": 14185.66, "timestamp": "03:56:25", "text": "私は"}, {"type": "subtitle", "time": 14201.189, "timestamp": "03:56:41", "text": "わからない。"}, {"type": "subtitle", "time": 14207.67, "timestamp": "03:56:47", "text": "ああ、そうだね。"}, {"type": "subtitle", "time": 14210.63, "timestamp": "03:56:50", "text": "うん。特別版のご紹介です。"}, {"type": "subtitle", "time": 14214.15, "timestamp": "03:56:54", "text": "今、お前のことを話したばかりだよ、バカ。私は"}, {"type": "subtitle", "time": 14217.03, "timestamp": "03:56:57", "text": "あなたがどうであるかを言うと、"}]
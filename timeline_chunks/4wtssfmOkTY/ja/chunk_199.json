[{"type": "subtitle", "time": 11944.79, "timestamp": "03:19:04", "text": "ええ、彼は学校に行きましたよ。こんにちは。そして、"}, {"type": "subtitle", "time": 11948.55, "timestamp": "03:19:08", "text": "今回は遅れたな、バカ。"}, {"type": "subtitle", "time": 11959.19, "timestamp": "03:19:19", "text": "[音楽]"}, {"type": "subtitle", "time": 11960.63, "timestamp": "03:19:20", "text": "こんにちは。"}, {"type": "subtitle", "time": 11967.83, "timestamp": "03:19:27", "text": "クルマは死んだ。クルマ。"}, {"type": "subtitle", "time": 11970.469, "timestamp": "03:19:30", "text": "待って。鞍馬。"}, {"type": "subtitle", "time": 11975.11, "timestamp": "03:19:35", "text": "鞍馬。蔵馬はまるで車が故障したみたいだ。"}, {"type": "subtitle", "time": 11979.99, "timestamp": "03:19:39", "text": "クルマ。あ、待って。鞍馬。"}, {"type": "subtitle", "time": 11983.67, "timestamp": "03:19:43", "text": "誰が？これは何ですか？鞍馬。"}, {"type": "subtitle", "time": 11986.399, "timestamp": "03:19:46", "text": "鞍馬。 ああ、ナルトからか。おお。"}, {"type": "subtitle", "time": 11990.64, "timestamp": "03:19:50", "text": "ああ、ナルトからか。おお。 ああ。"}, {"type": "subtitle", "time": 11992.96, "timestamp": "03:19:52", "text": "ああ。 [音楽]"}, {"type": "subtitle", "time": 11994.08, "timestamp": "03:19:54", "text": "[音楽] うん。さよなら。"}]
[{"type": "subtitle", "time": 6842.31, "timestamp": "01:54:02", "text": "サンプル。あなただけが手に入れられる民主主義。"}, {"type": "subtitle", "time": 6845.109, "timestamp": "01:54:05", "text": "君は、君が必要だと思うよ、待って、彼らは"}, {"type": "subtitle", "time": 6847.91, "timestamp": "01:54:07", "text": "紫。ああ、あれら"}, {"type": "subtitle", "time": 6849.83, "timestamp": "01:54:09", "text": "えっと、私は、あなたが手に入れることができる場所を知っています"}, {"type": "subtitle", "time": 6852.229, "timestamp": "01:54:12", "text": "彼らですが、彼らがそこにいるかどうかはわかりません"}, {"type": "subtitle", "time": 6854.95, "timestamp": "01:54:14", "text": "ガスだったことを覚えているから"}, {"type": "subtitle", "time": 6858.31, "timestamp": "01:54:18", "text": "任務、ガス除去任務。そして"}, {"type": "subtitle", "time": 6860.07, "timestamp": "01:54:20", "text": "私はBタイタンズと戦っていたのですが、"}, {"type": "subtitle", "time": 6862.39, "timestamp": "01:54:22", "text": "真ん中に巨大な植物があったので、"}, {"type": "subtitle", "time": 6865.109, "timestamp": "01:54:25", "text": "その周りに4つ並べることができるでしょう。"}, {"type": "subtitle", "time": 6869.35, "timestamp": "01:54:29", "text": "ペドロ、エディ、坊や、俺はゲイなんだ。うん。の"}, {"type": "subtitle", "time": 6871.589, "timestamp": "01:54:31", "text": "物事はスーパーサンプルのようなもので、"}, {"type": "subtitle", "time": 6873.83, "timestamp": "01:54:33", "text": "スーパーサンプルは同じ"}, {"type": "subtitle", "time": 6875.75, "timestamp": "01:54:35", "text": "歩き回る必要のないエリア"}, {"type": "subtitle", "time": 6879.189, "timestamp": "01:54:39", "text": "彼らの周りに集まって。"}, {"type": "subtitle", "time": 6881.109, "timestamp": "01:54:41", "text": "ただその場所を見つけて"}, {"type": "subtitle", "time": 6883.669, "timestamp": "01:54:43", "text": "全部手に入ります。"}, {"type": "subtitle", "time": 6886.07, "timestamp": "01:54:46", "text": "確かに。"}, {"type": "subtitle", "time": 6894.709, "timestamp": "01:54:54", "text": "ああ、これらはレベルアップさせる必要があるんだ。"}, {"type": "subtitle", "time": 6896.07, "timestamp": "01:54:56", "text": "あなたの彼氏は誰ですか？それは私の"}, {"type": "subtitle", "time": 6899.189, "timestamp": "01:54:59", "text": "彼氏。それはつまらないジョークだとわかる。"}]
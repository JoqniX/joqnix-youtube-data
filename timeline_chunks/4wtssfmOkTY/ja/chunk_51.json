[{"type": "subtitle", "time": 3060.23, "timestamp": "00:51:00", "text": "つまりそういうことですか？カオス。"}, {"type": "subtitle", "time": 3066.87, "timestamp": "00:51:06", "text": "いやー、これって弾薬をあっという間に消費するね。"}, {"type": "subtitle", "time": 3070.79, "timestamp": "00:51:10", "text": "めちゃくちゃだよ。最高の。これは何ですか"}, {"type": "subtitle", "time": 3072.47, "timestamp": "00:51:12", "text": "もの？"}, {"type": "subtitle", "time": 3083.51, "timestamp": "00:51:23", "text": "おお、"}, {"type": "subtitle", "time": 3084.63, "timestamp": "00:51:24", "text": "E."}, {"type": "subtitle", "time": 3088.63, "timestamp": "00:51:28", "text": "こんにちは。ハグ。ハグして。"}, {"type": "subtitle", "time": 3091.51, "timestamp": "00:51:31", "text": "ああ、ここにいますよ。ハグは必須です。ここに来て。"}, {"type": "subtitle", "time": 3099.27, "timestamp": "00:51:39", "text": "いずれにせよ、あなたはそれを手に入れるでしょう。"}, {"type": "subtitle", "time": 3102.23, "timestamp": "00:51:42", "text": "ああ、ハグの仕方を忘れてしまった。ああ、それだ"}, {"type": "subtitle", "time": 3104.069, "timestamp": "00:51:44", "text": "は。"}, {"type": "subtitle", "time": 3106.39, "timestamp": "00:51:46", "text": "よし、シューマ、君の、あ、待って。あなた"}, {"type": "subtitle", "time": 3108.79, "timestamp": "00:51:48", "text": "何だと思う？ハグをします。 ３回のハグ。彼"}, {"type": "subtitle", "time": 3110.95, "timestamp": "00:51:50", "text": "彼は抱きしめてくれるだろう。ハグします。ここに来て、"}, {"type": "subtitle", "time": 3112.23, "timestamp": "00:51:52", "text": "ヴィック。"}, {"type": "subtitle", "time": 3116.069, "timestamp": "00:51:56", "text": "よし、君は君は君はハグされる。なぜだめですか？"}, {"type": "subtitle", "time": 3117.75, "timestamp": "00:51:57", "text": "残念ながら、これはバグが発生したので、"}]
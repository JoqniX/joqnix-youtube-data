[{"type": "subtitle", "time": 12961.19, "timestamp": "03:36:01", "text": "目は、私が後悔する時だ。"}, {"type": "subtitle", "time": 12964.07, "timestamp": "03:36:04", "text": "なぜなら、その時が"}, {"type": "subtitle", "time": 12968.79, "timestamp": "03:36:08", "text": "私が一番近くにいたとき"}, {"type": "subtitle", "time": 12970.55, "timestamp": "03:36:10", "text": "クソ野郎ども"}, {"type": "subtitle", "time": 12973.269, "timestamp": "03:36:13", "text": "小さなことで傷ついたり悲しんだりする"}, {"type": "subtitle", "time": 12975.91, "timestamp": "03:36:15", "text": "誤解とか何か"}, {"type": "subtitle", "time": 12979.51, "timestamp": "03:36:19", "text": "テキストやDMから起こること、"}, {"type": "subtitle", "time": 12982.55, "timestamp": "03:36:22", "text": "何か、あるいは誰かの言葉が厳しい"}, {"type": "subtitle", "time": 12985.91, "timestamp": "03:36:25", "text": "あるいは、その時私は心が張り裂けそうになる。"}, {"type": "subtitle", "time": 12989.91, "timestamp": "03:36:29", "text": "ほら、あの頃私は自分の"}, {"type": "subtitle", "time": 12993.03, "timestamp": "03:36:33", "text": "カワイイバカ でも私は彼らにこう言います"}, {"type": "subtitle", "time": 12998.15, "timestamp": "03:36:38", "text": "車とか、そういうもの。はい。"}, {"type": "subtitle", "time": 13000.79, "timestamp": "03:36:40", "text": "うん。"}, {"type": "subtitle", "time": 13005.91, "timestamp": "03:36:45", "text": "数年以上かかるだろう。うん。うん。"}, {"type": "subtitle", "time": 13007.75, "timestamp": "03:36:47", "text": "インターフェースの発見可能性とサポート"}, {"type": "subtitle", "time": 13010.07, "timestamp": "03:36:50", "text": "ストリーマー向け。はい。"}, {"type": "subtitle", "time": 13012.239, "timestamp": "03:36:52", "text": "はい。 はい。勝つために私たちができる唯一のことは"}, {"type": "subtitle", "time": 13016.88, "timestamp": "03:36:56", "text": "はい。勝つために私たちができる唯一のことは 彼らがどのようにトランスコーディングするか"}]
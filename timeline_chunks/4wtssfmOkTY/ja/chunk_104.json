[{"type": "subtitle", "time": 6241.83, "timestamp": "01:44:01", "text": "よし、それでは始めよう"}, {"type": "subtitle", "time": 6245.43, "timestamp": "01:44:05", "text": "抽出作業に進むことができます。さあ、行こう。ねえ、"}, {"type": "subtitle", "time": 6247.189, "timestamp": "01:44:07", "text": "それが友情ですか？ちょっと待ってください。"}, {"type": "subtitle", "time": 6248.31, "timestamp": "01:44:08", "text": "それが友情というものだ。友情。"}, {"type": "subtitle", "time": 6251.27, "timestamp": "01:44:11", "text": "友情。私の近くには誰がいますか？それは私です。"}, {"type": "subtitle", "time": 6253.189, "timestamp": "01:44:13", "text": "ああ、それは友情だよ。友情。"}, {"type": "subtitle", "time": 6262.9, "timestamp": "01:44:22", "text": "彼らはどのようにあなたを狙っているのですか？"}, {"type": "subtitle", "time": 6275.75, "timestamp": "01:44:35", "text": "ああ、いくつかポイントがありますね。"}, {"type": "subtitle", "time": 6279.03, "timestamp": "01:44:39", "text": "素晴らしいクレジット。みんな、こっちに来て。"}, {"type": "subtitle", "time": 6281.189, "timestamp": "01:44:41", "text": "一人だけ必要なら"}, {"type": "subtitle", "time": 6283.27, "timestamp": "01:44:43", "text": "それらを掴めば、誰もがそれを手に入れることができる。ああ、私は"}, {"type": "subtitle", "time": 6285.669, "timestamp": "01:44:45", "text": "忘れた。うん、大丈夫だよ。行きましょう"}, {"type": "subtitle", "time": 6288.239, "timestamp": "01:44:48", "text": "行きましょう みんな、行き詰まってしまった。あなたを守りに行きます。"}, {"type": "subtitle", "time": 6297.59, "timestamp": "01:44:57", "text": "なぜ？なぜ？了解、了解。外。"}, {"type": "subtitle", "time": 6299.91, "timestamp": "01:44:59", "text": "私は水の中にいます。一番上にあります"}]
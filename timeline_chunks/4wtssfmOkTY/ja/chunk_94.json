[{"type": "subtitle", "time": 5646.31, "timestamp": "01:34:06", "text": "ああ、しまった。このゲームのAIはめちゃくちゃだ。"}, {"type": "subtitle", "time": 5648.149, "timestamp": "01:34:08", "text": "実は、"}, {"type": "subtitle", "time": 5649.91, "timestamp": "01:34:09", "text": "私がいた場所では発砲されなかった。暑いです"}, {"type": "subtitle", "time": 5652.629, "timestamp": "01:34:12", "text": "私が行く予定だった場所。"}, {"type": "subtitle", "time": 5656.629, "timestamp": "01:34:16", "text": "ニース。ねえ、知ってる？ええと、AIのように"}, {"type": "subtitle", "time": 5659.27, "timestamp": "01:34:19", "text": "プレイヤーを殺すのは得意だが、"}, {"type": "subtitle", "time": 5663.27, "timestamp": "01:34:23", "text": "あなたではない。ああ、それは都会的、あるいは"}, {"type": "subtitle", "time": 5665.75, "timestamp": "01:34:25", "text": "市街戦を行う。素敵な。"}, {"type": "subtitle", "time": 5667.51, "timestamp": "01:34:27", "text": "おお。"}, {"type": "subtitle", "time": 5669.83, "timestamp": "01:34:29", "text": "ああ、ここは都市だ。わかった。ええ、それは都市です"}, {"type": "subtitle", "time": 5671.669, "timestamp": "01:34:31", "text": "エリア。だからあんなに大きいんです。私は"}, {"type": "subtitle", "time": 5674.55, "timestamp": "01:34:34", "text": "なぜこんなに大きかったのか不思議に思っています"}, {"type": "subtitle", "time": 5677.189, "timestamp": "01:34:37", "text": "なぜそんなに大きなエリアだったのか、私には理由がわかります。"}, {"type": "subtitle", "time": 5680.47, "timestamp": "01:34:40", "text": "これは面白そうだ。"}, {"type": "subtitle", "time": 5685.11, "timestamp": "01:34:45", "text": "なんてこった。なんてこった。ジャマーが搭載されています"}, {"type": "subtitle", "time": 5689.27, "timestamp": "01:34:49", "text": "位置。はい。妨害装置が付いている。私にさせて"}, {"type": "subtitle", "time": 5692.55, "timestamp": "01:34:52", "text": "ロケットが破壊された。ええ、私は"}, {"type": "subtitle", "time": 5696.87, "timestamp": "01:34:56", "text": "的を射た。ええと、再調達ですね。"}]
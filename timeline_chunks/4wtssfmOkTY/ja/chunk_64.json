[{"type": "subtitle", "time": 3850.789, "timestamp": "01:04:10", "text": "とにかく、戻ってきました。また戻ってきます。来る"}, {"type": "subtitle", "time": 3856.71, "timestamp": "01:04:16", "text": "弾切れだ。私たちの頭上。私たちの頭上。"}, {"type": "subtitle", "time": 3860.95, "timestamp": "01:04:20", "text": "私たちの頭上。大丈夫です。"}, {"type": "subtitle", "time": 3864.63, "timestamp": "01:04:24", "text": "私たちは出発します。我々は去る。さあ行こう。"}, {"type": "subtitle", "time": 3866.15, "timestamp": "01:04:26", "text": "走る。"}, {"type": "subtitle", "time": 3869.51, "timestamp": "01:04:29", "text": "行く。行く。乗れ。とにかく乗れ。行け、行け、行け、"}, {"type": "subtitle", "time": 3877.43, "timestamp": "01:04:37", "text": "抽出完了。大丈夫です。我々は去る。私"}, {"type": "subtitle", "time": 3880.309, "timestamp": "01:04:40", "text": "愛は、"}, {"type": "subtitle", "time": 3883.75, "timestamp": "01:04:43", "text": "レベル5で恥ずかしい思いをした。つまり、ガラクタ"}, {"type": "subtitle", "time": 3885.589, "timestamp": "01:04:45", "text": "よくやった"}, {"type": "subtitle", "time": 3887.19, "timestamp": "01:04:47", "text": "味方からの誤射は除く。よし、"}, {"type": "subtitle", "time": 3890.39, "timestamp": "01:04:50", "text": "今、我々は地獄で死ぬ。さあ行こう。彼は死んだ。"}, {"type": "subtitle", "time": 3894.71, "timestamp": "01:04:54", "text": "何てことだ。さあ行こう。最高難易度。"}, {"type": "subtitle", "time": 3897.51, "timestamp": "01:04:57", "text": "最高難易度。さあ行こう。それは最大だった"}]
[{"type": "subtitle", "time": 17775.83, "timestamp": "04:56:15", "text": "こんにちは。こんにちは。私はそれを一時停止した。わかった。 27秒。"}, {"type": "subtitle", "time": 17778.47, "timestamp": "04:56:18", "text": "それは8小節です。わかった。"}, {"type": "subtitle", "time": 17784.708, "timestamp": "04:56:24", "text": "すぐにスペースを作りたいのですが、"}, {"type": "subtitle", "time": 17802.23, "timestamp": "04:56:42", "text": "ああ、やめてくれ。名前を変えさせてください"}, {"type": "subtitle", "time": 17808.948, "timestamp": "04:56:48", "text": "ランダム"}]
[{"type": "subtitle", "time": 4871.11, "timestamp": "01:21:11", "text": "[音楽]"}, {"type": "subtitle", "time": 4907.59, "timestamp": "01:21:47", "text": "えーと、私たちが"}, {"type": "subtitle", "time": 4909.669, "timestamp": "01:21:49", "text": "そこに到着した。"}, {"type": "subtitle", "time": 4914.07, "timestamp": "01:21:54", "text": "ああ、しまった。死んだ。何てことだ。わかったよ。おお"}, {"type": "subtitle", "time": 4918.47, "timestamp": "01:21:58", "text": "最悪だ。狙撃された。待て、狙撃兵がいる。"}]
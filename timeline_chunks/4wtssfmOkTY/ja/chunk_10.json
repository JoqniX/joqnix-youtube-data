[{"type": "subtitle", "time": 600.23, "timestamp": "00:10:00", "text": "英語と言ったのはあなたでしたか、"}, {"type": "subtitle", "time": 604.47, "timestamp": "00:10:04", "text": "スペイン語？あなたのコメントを読みました。"}, {"type": "subtitle", "time": 606.389, "timestamp": "00:10:06", "text": "ええ、あなたのコメントを読みました。"}, {"type": "subtitle", "time": 608.15, "timestamp": "00:10:08", "text": "文字通り"}, {"type": "subtitle", "time": 610.47, "timestamp": "00:10:10", "text": "私は英語を話せると言いました。私はしない"}, {"type": "subtitle", "time": 615.35, "timestamp": "00:10:15", "text": "スペイン語を知っている、またはスペイン語（español）など、何でもいい。"}, {"type": "subtitle", "time": 617.75, "timestamp": "00:10:17", "text": "それがどうした？"}, {"type": "subtitle", "time": 621.43, "timestamp": "00:10:21", "text": "何か見落としているでしょうか？私は受け取っていません"}, {"type": "subtitle", "time": 626.949, "timestamp": "00:10:26", "text": "それ。髭剃りはイギリス式かスペイン式です。"}, {"type": "subtitle", "time": 632.949, "timestamp": "00:10:32", "text": "私には理解できません。まあ、楽しんでください。"}, {"type": "subtitle", "time": 635.11, "timestamp": "00:10:35", "text": "あなたの持ち物。えっと、"}, {"type": "subtitle", "time": 637.75, "timestamp": "00:10:37", "text": "わかった。 YouTube"}, {"type": "subtitle", "time": 644.47, "timestamp": "00:10:44", "text": "コピー。"}, {"type": "chat", "time": 646.165, "timestamp": "00:10:46", "author": "@fallenbutter", "avatar": "https://yt4.ggpht.com/R8xYikTfjZJ5VZjJ8SKyAs0DKSBXzw7lDZ1NFh68ouAcEOGlXq05RoxPVKYiQZeQ4XqNlV-M=s64-c-k-c0x00ffffff-no-rj", "message": "I don’t get it either 😅"}, {"type": "subtitle", "time": 648.069, "timestamp": "00:10:48", "text": "よし、みんな。すぐ戻ります。よし、彼が持ってきてくれる。"}, {"type": "subtitle", "time": 650.47, "timestamp": "00:10:50", "text": "島"}, {"type": "subtitle", "time": 653.269, "timestamp": "00:10:53", "text": "https://twitch.tv"}]
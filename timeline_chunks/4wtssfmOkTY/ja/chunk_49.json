[{"type": "subtitle", "time": 2941.19, "timestamp": "00:49:01", "text": "戦略。でもスクロールホイールの方が良いんじゃない？"}, {"type": "subtitle", "time": 2945.19, "timestamp": "00:49:05", "text": "より速い入力のために？私は疑う。あれは"}, {"type": "subtitle", "time": 2947.91, "timestamp": "00:49:07", "text": "当時のメタは？進んでいますか？"}, {"type": "subtitle", "time": 2950.71, "timestamp": "00:49:10", "text": "何てことだ。正直よくわかりません。私 私"}, {"type": "subtitle", "time": 2952.39, "timestamp": "00:49:12", "text": "覚えていない。でも、試してみる価値はあるよ。"}, {"type": "subtitle", "time": 2954.549, "timestamp": "00:49:14", "text": "待って、まだ続きがある。新しい"}, {"type": "subtitle", "time": 2958.15, "timestamp": "00:49:18", "text": "武器とかそういうもの？ああ、武器だ。私は推測する"}, {"type": "subtitle", "time": 2962.79, "timestamp": "00:49:22", "text": "あなたは多くのものを逃しました。何"}, {"type": "subtitle", "time": 2967.03, "timestamp": "00:49:27", "text": "レバーアクション？レバーアクションマークと"}, {"type": "subtitle", "time": 2974.79, "timestamp": "00:49:34", "text": "ああ、彼を信じればいいんだ。大丈夫だよ。私は"}, {"type": "subtitle", "time": 2980.79, "timestamp": "00:49:40", "text": "何を狙っているんですか？なんてこった。しないで"}, {"type": "subtitle", "time": 2994.87, "timestamp": "00:49:54", "text": "倒れた。あなたは赤い鎧を着ています。何？"}, {"type": "subtitle", "time": 2997.829, "timestamp": "00:49:57", "text": "ええ、そうです。真実と力。えっと、戦争パン。"}, {"type": "subtitle", "time": 2999.75, "timestamp": "00:49:59", "text": "余分な"}]
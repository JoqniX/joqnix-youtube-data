[{"type": "subtitle", "time": 15301.03, "timestamp": "04:15:01", "text": "メロディー"}, {"type": "subtitle", "time": 15303.429, "timestamp": "04:15:03", "text": "右"}, {"type": "subtitle", "time": 15306.469, "timestamp": "04:15:06", "text": "でも、本当にこの曲を覚えたいんです"}, {"type": "subtitle", "time": 15311.269, "timestamp": "04:15:11", "text": "私にとっては難しいけれど、それでも私は"}, {"type": "subtitle", "time": 15313.59, "timestamp": "04:15:13", "text": "こんにちは"}, {"type": "subtitle", "time": 15315.75, "timestamp": "04:15:15", "text": "私は終わった"}, {"type": "subtitle", "time": 15317.59, "timestamp": "04:15:17", "text": "汗をかいている"}, {"type": "subtitle", "time": 15320.79, "timestamp": "04:15:20", "text": "はい、ストレッチしています"}, {"type": "subtitle", "time": 15325.99, "timestamp": "04:15:25", "text": "私は知らないので、"}, {"type": "subtitle", "time": 15329.99, "timestamp": "04:15:29", "text": "2分か3分だったけど、それでも私は"}, {"type": "subtitle", "time": 15335.11, "timestamp": "04:15:35", "text": "汗だくになりながらも、私は仕事をした。私は無駄にした"}, {"type": "subtitle", "time": 15338.389, "timestamp": "04:15:38", "text": "今日は20か10のエネルギーが必要だ。今私は"}, {"type": "subtitle", "time": 15340.71, "timestamp": "04:15:40", "text": "言った"}, {"type": "subtitle", "time": 15343.03, "timestamp": "04:15:43", "text": "前に言ったけど、洗って"}, {"type": "subtitle", "time": 15352.309, "timestamp": "04:15:52", "text": "[音楽]"}, {"type": "subtitle", "time": 15354.63, "timestamp": "04:15:54", "text": "あなたを忘れていました"}, {"type": "subtitle", "time": 15358.469, "timestamp": "04:15:58", "text": "えっと、ボビーのやつを作って。だから私はただ"}]
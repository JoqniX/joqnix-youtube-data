[{"type": "subtitle", "time": 8110.629, "timestamp": "02:15:10", "text": "くそ。待って。"}, {"type": "subtitle", "time": 8119.43, "timestamp": "02:15:19", "text": "内部に酸性充電器が入っています。"}, {"type": "subtitle", "time": 8122.149, "timestamp": "02:15:22", "text": "私は母親たちとうまくやっていける"}, {"type": "subtitle", "time": 8123.99, "timestamp": "02:15:23", "text": "そしてこれら"}, {"type": "subtitle", "time": 8125.91, "timestamp": "02:15:25", "text": "もの。"}, {"type": "subtitle", "time": 8127.51, "timestamp": "02:15:27", "text": "この人たちだけど、もう片方の人。おお、"}, {"type": "subtitle", "time": 8134.229, "timestamp": "02:15:34", "text": "[音楽]"}, {"type": "subtitle", "time": 8136.87, "timestamp": "02:15:36", "text": "請求件数はいくつですか？ 3つのように"}, {"type": "subtitle", "time": 8139.189, "timestamp": "02:15:39", "text": "彼らのうちの。 ３人。そのうちの2人は"}, {"type": "subtitle", "time": 8140.79, "timestamp": "02:15:40", "text": "酸性。"}, {"type": "subtitle", "time": 8142.95, "timestamp": "02:15:42", "text": "そうそう。ガスがほとんどない"}, {"type": "subtitle", "time": 8144.87, "timestamp": "02:15:44", "text": "どこにでも。すごくぎこちない。あなたは"}, {"type": "subtitle", "time": 8147.669, "timestamp": "02:15:47", "text": "そこから逃げろ。"}, {"type": "subtitle", "time": 8150.31, "timestamp": "02:15:50", "text": "おお。"}, {"type": "subtitle", "time": 8152.79, "timestamp": "02:15:52", "text": "何てことだ。"}, {"type": "subtitle", "time": 8156.39, "timestamp": "02:15:56", "text": "やあ、調子はどう？"}, {"type": "subtitle", "time": 8159.27, "timestamp": "02:15:59", "text": "これは文字通り地中に潜り込んだ。"}]
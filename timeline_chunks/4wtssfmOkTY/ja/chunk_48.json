[{"type": "subtitle", "time": 2881.99, "timestamp": "00:48:01", "text": "このゲームを14分間プレイする。さあ"}, {"type": "subtitle", "time": 2884.15, "timestamp": "00:48:04", "text": "行く。大丈夫です。任務に行き詰まった"}, {"type": "subtitle", "time": 2887.51, "timestamp": "00:48:07", "text": "14分間。サンプルをドロップするだけで"}, {"type": "subtitle", "time": 2890.15, "timestamp": "00:48:10", "text": "抽出ポイント。えっと、私たちはただ"}, {"type": "subtitle", "time": 2892.39, "timestamp": "00:48:12", "text": "とりあえず走り回ってみる。ええ、私は私です"}, {"type": "subtitle", "time": 2895.75, "timestamp": "00:48:15", "text": "私は落とした"}, {"type": "subtitle", "time": 2899.829, "timestamp": "00:48:19", "text": "えっと、君たち。はい、参加します。"}, {"type": "subtitle", "time": 2901.589, "timestamp": "00:48:21", "text": "右、右、下、左、右、下。"}, {"type": "subtitle", "time": 2906.79, "timestamp": "00:48:26", "text": "右、上、下、下、右。私は"}, {"type": "subtitle", "time": 2909.91, "timestamp": "00:48:29", "text": "あれが現れるのを待っている。"}, {"type": "subtitle", "time": 2912.309, "timestamp": "00:48:32", "text": "あれはバー兼ロッジですか？"}, {"type": "subtitle", "time": 2915.349, "timestamp": "00:48:35", "text": "それが、それが集中砲火だ。"}, {"type": "subtitle", "time": 2917.99, "timestamp": "00:48:37", "text": "皆さんは戦略をどのように活用していますか？のように"}, {"type": "subtitle", "time": 2919.99, "timestamp": "00:48:39", "text": "矢印キー。"}, {"type": "subtitle", "time": 2924.79, "timestamp": "00:48:44", "text": "うん。だから、同時に実行して入力できる"}, {"type": "subtitle", "time": 2929.349, "timestamp": "00:48:49", "text": "時間。私にとって重要なのは、コントロールです。"}, {"type": "subtitle", "time": 2934.87, "timestamp": "00:48:54", "text": "Ctrlキーと矢印キー、またはWSDキー。"}, {"type": "subtitle", "time": 2937.43, "timestamp": "00:48:57", "text": "矢印キーをオンにしたままにしてください。それで"}, {"type": "subtitle", "time": 2939.27, "timestamp": "00:48:59", "text": "入力しながら実行できるようにするためです"}]
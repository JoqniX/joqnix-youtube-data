[{"type": "subtitle", "time": 21544.548, "timestamp": "05:59:04", "text": "哇，摧毁封锁，摧毁"}, {"type": "subtitle", "time": 21546.59, "timestamp": "05:59:06", "text": "封锁期间我们"}, {"type": "subtitle", "time": 21548.31, "timestamp": "05:59:08", "text": "在天堂里，他们无法被摧毁。"}, {"type": "subtitle", "time": 21551.35, "timestamp": "05:59:11", "text": "天堂也一样，他们来自后方"}, {"type": "subtitle", "time": 21567.99, "timestamp": "05:59:27", "text": "死了就死了，去死吧，左边那个混蛋"}, {"type": "subtitle", "time": 21572.868, "timestamp": "05:59:32", "text": "90，那是90，不过该死的喵"}, {"type": "subtitle", "time": 21589.51, "timestamp": "05:59:49", "text": "麦克斯不知道该怎么做"}, {"type": "subtitle", "time": 21594.19, "timestamp": "05:59:54", "text": "建立同等水平，我在那里告诉大家。"}, {"type": "subtitle", "time": 21595.948, "timestamp": "05:59:55", "text": "他们说不是这样的，他们是"}, {"type": "subtitle", "time": 21597.948, "timestamp": "05:59:57", "text": "不在那里，这也不公平，这不公平"}]
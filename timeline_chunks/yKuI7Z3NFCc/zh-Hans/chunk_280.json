[{"type": "subtitle", "time": 16805.51, "timestamp": "04:40:05", "text": "不好，好吧，呃，两分钟，但我，我，我……"}, {"type": "subtitle", "time": 16809.19, "timestamp": "04:40:09", "text": "死在这里，有手榴弹吗？"}, {"type": "subtitle", "time": 16812.19, "timestamp": "04:40:12", "text": "那是一枚手榴弹，没问题。"}, {"type": "subtitle", "time": 16815.27, "timestamp": "04:40:15", "text": "来吧，大家一起死吧"}, {"type": "subtitle", "time": 16817.15, "timestamp": "04:40:17", "text": "一起"}, {"type": "subtitle", "time": 16820.03, "timestamp": "04:40:20", "text": "外抛式手榴弹"}, {"type": "subtitle", "time": 16824.15, "timestamp": "04:40:24", "text": "我被推出去，我的最后一颗手榴弹被推了出去，等等，"}, {"type": "subtitle", "time": 16835.51, "timestamp": "04:40:35", "text": "手榴弹突击步枪"}, {"type": "subtitle", "time": 16838.83, "timestamp": "04:40:38", "text": "作品通过一个"}, {"type": "subtitle", "time": 16842.43, "timestamp": "04:40:42", "text": "啊，我倒下了，不，哦，他们会的"}, {"type": "subtitle", "time": 16844.75, "timestamp": "04:40:44", "text": "救救我，不，不，我不要那样，哦，安"}, {"type": "subtitle", "time": 16853.27, "timestamp": "04:40:53", "text": "抓住了，好的，我就这么做"}]
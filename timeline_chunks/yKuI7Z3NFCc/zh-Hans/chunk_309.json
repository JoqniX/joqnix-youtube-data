[{"type": "subtitle", "time": 18543.19, "timestamp": "05:09:03", "text": "该走了，好的，好的，是的，是的，我"}, {"type": "subtitle", "time": 18545.99, "timestamp": "05:09:05", "text": "有，但这次不是来自那个地区"}, {"type": "subtitle", "time": 18548.15, "timestamp": "05:09:08", "text": "因为圣贤的墙"}, {"type": "subtitle", "time": 18551.07, "timestamp": "05:09:11", "text": "在那里我会说清楚我会"}, {"type": "subtitle", "time": 18553.628, "timestamp": "05:09:13", "text": "C 我会清除长长的不要"}, {"type": "subtitle", "time": 18556.51, "timestamp": "05:09:16", "text": "担心我们还是可以解决的，我觉得"}, {"type": "subtitle", "time": 18562.39, "timestamp": "05:09:22", "text": "所以谁来给我买这个炸薯条"}, {"type": "subtitle", "time": 18566.07, "timestamp": "05:09:26", "text": "是啊，哦，就……"}, {"type": "subtitle", "time": 18568.868, "timestamp": "05:09:28", "text": "知道哦"}, {"type": "subtitle", "time": 18573.39, "timestamp": "05:09:33", "text": "等等，回去，回去，你必须回去。"}, {"type": "subtitle", "time": 18575.07, "timestamp": "05:09:35", "text": "选等等等等等等，别别走"}, {"type": "subtitle", "time": 18584.99, "timestamp": "05:09:44", "text": "稍等片刻，他们会来的。"}, {"type": "subtitle", "time": 18590.868, "timestamp": "05:09:50", "text": "你正往后走，往后走，往后走，在乔的后面"}, {"type": "chat", "time": 18595.33, "timestamp": "05:09:55", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "I wonder of lurk works on everyone"}]
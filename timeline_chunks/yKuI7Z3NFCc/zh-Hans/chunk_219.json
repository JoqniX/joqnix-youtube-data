[{"type": "subtitle", "time": 13142.91, "timestamp": "03:39:02", "text": "希望你今天能睡个好觉"}, {"type": "subtitle", "time": 13145.75, "timestamp": "03:39:05", "text": "好的，然后 ubu CH 来到了那里。"}, {"type": "subtitle", "time": 13148.51, "timestamp": "03:39:08", "text": "最后，非常感谢你的光临。"}, {"type": "subtitle", "time": 13150.99, "timestamp": "03:39:10", "text": "真的意义重大，希望你喜欢。"}, {"type": "subtitle", "time": 13154.11, "timestamp": "03:39:14", "text": "今天也祝你好运"}, {"type": "subtitle", "time": 13156.309, "timestamp": "03:39:16", "text": "明天你可能就会……"}, {"type": "subtitle", "time": 13158.229, "timestamp": "03:39:18", "text": "有"}, {"type": "subtitle", "time": 13162.15, "timestamp": "03:39:22", "text": "嗯嗯，是的，你可能……嗯嗯，就像"}, {"type": "subtitle", "time": 13164.91, "timestamp": "03:39:24", "text": "你管这叫什么？刚睡醒？"}, {"type": "subtitle", "time": 13168.189, "timestamp": "03:39:28", "text": "是啊，我也得走了，晚安。"}, {"type": "subtitle", "time": 13183.87, "timestamp": "03:39:43", "text": "再见，谢谢大家的光临"}, {"type": "subtitle", "time": 13185.51, "timestamp": "03:39:45", "text": "今天"}, {"type": "subtitle", "time": 13187.51, "timestamp": "03:39:47", "text": "你知道下周我不会……"}, {"type": "subtitle", "time": 13190.269, "timestamp": "03:39:50", "text": "晚上直播是因为我会收到"}, {"type": "subtitle", "time": 13192.59, "timestamp": "03:39:52", "text": "打了很多电话，我会改变我的"}, {"type": "subtitle", "time": 13195.99, "timestamp": "03:39:55", "text": "夜里，我想起了果阿，又一次想起了它。"}, {"type": "subtitle", "time": 13198.469, "timestamp": "03:39:58", "text": "时机成熟后会是直播的好时机，但是"}]
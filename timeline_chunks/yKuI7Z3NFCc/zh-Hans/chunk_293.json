[{"type": "subtitle", "time": 17580.27, "timestamp": "04:53:00", "text": "太棒了，因为她是白金级的。"}, {"type": "subtitle", "time": 17589.27, "timestamp": "04:53:09", "text": "确实，py 可以听到"}, {"type": "subtitle", "time": 17593.35, "timestamp": "04:53:13", "text": "我们哦，让他们尝试他们的一切"}, {"type": "subtitle", "time": 17596.788, "timestamp": "04:53:16", "text": "双手都准备好了，我上。"}, {"type": "subtitle", "time": 17599.51, "timestamp": "04:53:19", "text": "一个"}, {"type": "subtitle", "time": 17604.27, "timestamp": "04:53:24", "text": "呃，那样行不通，这样行不通。"}, {"type": "subtitle", "time": 17608.27, "timestamp": "04:53:28", "text": "欧门，快点，你的烟雾什么时候才会散去？"}, {"type": "subtitle", "time": 17616.83, "timestamp": "04:53:36", "text": "返回途中"}, {"type": "subtitle", "time": 17625.07, "timestamp": "04:53:45", "text": "[音乐]"}, {"type": "subtitle", "time": 17633.788, "timestamp": "04:53:53", "text": "他们在哪里？"}, {"type": "subtitle", "time": 17638.31, "timestamp": "04:53:58", "text": "他们盯上我了，盯上我了，盯上我了，我听到他们盯上我了，哦"}]
[{"type": "subtitle", "time": 8101.31, "timestamp": "02:15:01", "text": "必须在附近，好耶，我们做到了！"}, {"type": "subtitle", "time": 8102.95, "timestamp": "02:15:02", "text": "我们得到了"}, {"type": "subtitle", "time": 8106.31, "timestamp": "02:15:06", "text": "泰迪，等等，我们或许可以留下我们的泰迪。"}, {"type": "subtitle", "time": 8115.27, "timestamp": "02:15:15", "text": "我知道，不过如果我睡着了，我会……"}, {"type": "subtitle", "time": 8117.27, "timestamp": "02:15:17", "text": "抱着泰迪熊睡觉吧"}, {"type": "subtitle", "time": 8127.91, "timestamp": "02:15:27", "text": "嗯，我觉得大部分东西都是这样，哦，是的。"}, {"type": "subtitle", "time": 8139.31, "timestamp": "02:15:39", "text": "等等，这东西应该在这里和这里"}, {"type": "subtitle", "time": 8142.95, "timestamp": "02:15:42", "text": "现在这可以是"}, {"type": "subtitle", "time": 8145.069, "timestamp": "02:15:45", "text": "是的，全部"}, {"type": "subtitle", "time": 8150.27, "timestamp": "02:15:50", "text": "对，想想其他的东西……"}, {"type": "subtitle", "time": 8152.43, "timestamp": "02:15:52", "text": "好的"}]
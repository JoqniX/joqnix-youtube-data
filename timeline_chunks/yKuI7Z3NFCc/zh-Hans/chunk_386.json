[{"type": "subtitle", "time": 23160.15, "timestamp": "06:26:00", "text": "锦标赛呃 T 先生呃我们"}, {"type": "subtitle", "time": 23163.628, "timestamp": "06:26:03", "text": "扣杀队赢得了第三场比赛，呃，我们"}, {"type": "subtitle", "time": 23167.07, "timestamp": "06:26:07", "text": "在前两场非积分赛中失利"}, {"type": "subtitle", "time": 23176.468, "timestamp": "06:26:16", "text": "是的，我们尽力了，是的，我们尽力了。"}, {"type": "subtitle", "time": 23179.59, "timestamp": "06:26:19", "text": "游戏怎么样？游戏很好。"}, {"type": "subtitle", "time": 23184.27, "timestamp": "06:26:24", "text": "我今天玩得很开心，而且我……"}, {"type": "subtitle", "time": 23187.31, "timestamp": "06:26:27", "text": "我明白自己不擅长团队合作。"}, {"type": "subtitle", "time": 23190.11, "timestamp": "06:26:30", "text": "我玩得不好，不擅长团队合作。"}, {"type": "subtitle", "time": 23193.51, "timestamp": "06:26:33", "text": "实际上，我呃，就像呃，我这是"}, {"type": "subtitle", "time": 23195.51, "timestamp": "06:26:35", "text": "我呃"}, {"type": "subtitle", "time": 23200.31, "timestamp": "06:26:40", "text": "在多人游戏中注意到这一点，嗯，大多数"}, {"type": "subtitle", "time": 23202.948, "timestamp": "06:26:42", "text": "那是我匆匆忙忙，最终丧命的时候，但"}, {"type": "subtitle", "time": 23206.548, "timestamp": "06:26:46", "text": "有时，嗯，决策也是"}, {"type": "subtitle", "time": 23211.43, "timestamp": "06:26:51", "text": "很难，确实很难，但我会习惯的。"}, {"type": "subtitle", "time": 23218.75, "timestamp": "06:26:58", "text": "总的来说，我挺喜欢这次体验的，这只是一个"}]
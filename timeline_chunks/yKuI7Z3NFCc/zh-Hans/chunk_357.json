[{"type": "subtitle", "time": 21424.83, "timestamp": "05:57:04", "text": "那段路很近"}, {"type": "subtitle", "time": 21435.628, "timestamp": "05:57:15", "text": "他有144"}, {"type": "subtitle", "time": 21440.67, "timestamp": "05:57:20", "text": "然后我就可以想象所有时间 144 的情况了"}, {"type": "subtitle", "time": 21446.07, "timestamp": "05:57:26", "text": "是的，我应该都同意吗？好的，你"}, {"type": "subtitle", "time": 21468.31, "timestamp": "05:57:48", "text": "哦哦，他们要崩溃了"}, {"type": "subtitle", "time": 21471.19, "timestamp": "05:57:51", "text": "他们，他们打破了墙，他们打破了"}]
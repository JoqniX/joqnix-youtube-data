[{"type": "subtitle", "time": 22022.468, "timestamp": "06:07:02", "text": "最好的事情，是的，是的，明天会是"}, {"type": "subtitle", "time": 22030.31, "timestamp": "06:07:10", "text": "晚安，再见"}, {"type": "subtitle", "time": 22034.27, "timestamp": "06:07:14", "text": "gg gg"}, {"type": "subtitle", "time": 22037.468, "timestamp": "06:07:17", "text": "gg 哦"}, {"type": "subtitle", "time": 22042.51, "timestamp": "06:07:22", "text": "男孩，晚安，伙计们，晚安，零号我们"}, {"type": "subtitle", "time": 22046.11, "timestamp": "06:07:26", "text": "真的要走了吗？好吧，我不是。"}, {"type": "subtitle", "time": 22048.35, "timestamp": "06:07:28", "text": "我停止直播了，因为人们"}, {"type": "subtitle", "time": 22052.91, "timestamp": "06:07:32", "text": "还在看着我呢，好吧，我来玩。"}, {"type": "subtitle", "time": 22054.75, "timestamp": "06:07:34", "text": "我会玩的，别担心，伙计们，我依然在。"}, {"type": "subtitle", "time": 22072.91, "timestamp": "06:07:52", "text": "好了，各位，就此离开吧。呃，就像之前已经发生的那样。"}, {"type": "subtitle", "time": 22075.83, "timestamp": "06:07:55", "text": "他们打了两场比赛，都赢了。"}, {"type": "subtitle", "time": 22078.39, "timestamp": "06:07:58", "text": "冠军，我们肯定会有一个。"}]
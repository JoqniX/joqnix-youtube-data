[{"type": "subtitle", "time": 14820.79, "timestamp": "04:07:00", "text": "对，我……我忘了怎么弹她了，哦不"}, {"type": "subtitle", "time": 14823.229, "timestamp": "04:07:03", "text": "新代理商来了"}, {"type": "subtitle", "time": 14825.67, "timestamp": "04:07:05", "text": "向上"}, {"type": "subtitle", "time": 14840.55, "timestamp": "04:07:20", "text": "这是你的"}, {"type": "subtitle", "time": 14842.87, "timestamp": "04:07:22", "text": "冠军，你知道关键是如果你"}, {"type": "subtitle", "time": 14845.309, "timestamp": "04:07:25", "text": "玩很多Apex，我觉得你可以做到"}, {"type": "subtitle", "time": 14847.51, "timestamp": "04:07:27", "text": "来自朋友"}, {"type": "subtitle", "time": 14851.109, "timestamp": "04:07:31", "text": "日本人就像我不想成为那样的人"}, {"type": "subtitle", "time": 14853.55, "timestamp": "04:07:33", "text": "跳伞大师，我现在是跳伞大师"}, {"type": "subtitle", "time": 14855.99, "timestamp": "04:07:35", "text": "这是什么？就像新东京一样吗？"}, {"type": "subtitle", "time": 14859.149, "timestamp": "04:07:39", "text": "记住，眼睛盯着奖品，等待"}, {"type": "subtitle", "time": 14861.91, "timestamp": "04:07:41", "text": "什么不是玩具？是 Apex THM 吗？"}, {"type": "subtitle", "time": 14869.429, "timestamp": "04:07:49", "text": "嗯，看起来是这样"}, {"type": "subtitle", "time": 14874.229, "timestamp": "04:07:54", "text": "所以，这就是夜生活，哇，看看这有多精彩！"}]
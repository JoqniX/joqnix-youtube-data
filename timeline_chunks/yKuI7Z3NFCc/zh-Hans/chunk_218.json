[{"type": "subtitle", "time": 13080.15, "timestamp": "03:38:00", "text": "呃，走上我的"}, {"type": "subtitle", "time": 13087.429, "timestamp": "03:38:07", "text": "耶！"}, {"type": "subtitle", "time": 13089.83, "timestamp": "03:38:09", "text": "你是"}, {"type": "subtitle", "time": 13094.07, "timestamp": "03:38:14", "text": "虽然有点晚了，但我们确实看到了一个类似笔记的东西。"}, {"type": "subtitle", "time": 13096.83, "timestamp": "03:38:16", "text": "就像游戏里的青蛙一样"}, {"type": "subtitle", "time": 13099.229, "timestamp": "03:38:19", "text": "挺可爱的，所以，嗯，我就结束直播吧。"}, {"type": "subtitle", "time": 13102.79, "timestamp": "03:38:22", "text": "呃呃哲学奏鸣曲，为了即将到来的希望"}, {"type": "subtitle", "time": 13104.15, "timestamp": "03:38:24", "text": "你喜欢"}, {"type": "subtitle", "time": 13107.389, "timestamp": "03:38:27", "text": "今天能来，谢谢你们！"}, {"type": "subtitle", "time": 13109.389, "timestamp": "03:38:29", "text": "告诉我，让我看流媒体，谢谢"}, {"type": "subtitle", "time": 13112.429, "timestamp": "03:38:32", "text": "你希望你确实把我的高处送上去了。"}, {"type": "subtitle", "time": 13115.75, "timestamp": "03:38:35", "text": "谢谢各位光临！"}, {"type": "subtitle", "time": 13118.309, "timestamp": "03:38:38", "text": "这是你第一次来这里吧，阿达托？"}, {"type": "subtitle", "time": 13121.189, "timestamp": "03:38:41", "text": "感谢您的光临，希望您今天过得愉快！"}, {"type": "subtitle", "time": 13124.269, "timestamp": "03:38:44", "text": "说我很可爱，不是你，是你。"}, {"type": "subtitle", "time": 13130.83, "timestamp": "03:38:50", "text": "于是，接下来就来了。"}, {"type": "subtitle", "time": 13133.99, "timestamp": "03:38:53", "text": "你的到来意味着希望你"}, {"type": "subtitle", "time": 13138.429, "timestamp": "03:38:58", "text": "然后阿昆过来串门了，谢谢你过来串门"}]
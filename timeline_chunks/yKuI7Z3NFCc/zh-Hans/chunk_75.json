[{"type": "subtitle", "time": 4514.94, "timestamp": "01:15:14", "text": "铅笔呃"}, {"type": "subtitle", "time": 4525.87, "timestamp": "01:15:25", "text": "让"}, {"type": "subtitle", "time": 4533.31, "timestamp": "01:15:33", "text": "机器看起来有点堵塞，别这样"}, {"type": "subtitle", "time": 4535.27, "timestamp": "01:15:35", "text": "你"}, {"type": "subtitle", "time": 4539.03, "timestamp": "01:15:39", "text": "我觉得我也有点这种感觉"}, {"type": "subtitle", "time": 4540.55, "timestamp": "01:15:40", "text": "这"}, {"type": "subtitle", "time": 4551.39, "timestamp": "01:15:51", "text": "[音乐]"}, {"type": "subtitle", "time": 4554.669, "timestamp": "01:15:54", "text": "不，如果这些重物掉下来的话"}, {"type": "subtitle", "time": 4557.79, "timestamp": "01:15:57", "text": "一切都将被摧毁，所以我将善待它们。"}]
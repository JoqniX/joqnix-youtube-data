[{"type": "subtitle", "time": 3671.95, "timestamp": "01:01:11", "text": "[音乐]"}, {"type": "subtitle", "time": 3680.51, "timestamp": "01:01:20", "text": "有趣，你觉得这很酷吗？"}, {"type": "subtitle", "time": 3684.23, "timestamp": "01:01:24", "text": "安排得很好，我的天哪，你……"}, {"type": "subtitle", "time": 3686.029, "timestamp": "01:01:26", "text": "我觉得是"}, {"type": "subtitle", "time": 3688.309, "timestamp": "01:01:28", "text": "妥善安排我"}, {"type": "subtitle", "time": 3691.19, "timestamp": "01:01:31", "text": "现在我没有了"}, {"type": "subtitle", "time": 3694.15, "timestamp": "01:01:34", "text": "我知道我"}, {"type": "subtitle", "time": 3699.13, "timestamp": "01:01:39", "text": "似乎是划痕所在的地方"}, {"type": "subtitle", "time": 3712.789, "timestamp": "01:01:52", "text": "地板上可能把玩具放在床上"}]
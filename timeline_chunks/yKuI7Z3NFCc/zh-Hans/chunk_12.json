[{"type": "subtitle", "time": 733.71, "timestamp": "00:12:13", "text": "昨天真的有40个人吗？"}, {"type": "subtitle", "time": 734.11, "timestamp": "00:12:14", "text": "不"}, {"type": "subtitle", "time": 742.59, "timestamp": "00:12:22", "text": "记住观众总数"}, {"type": "subtitle", "time": 746.069, "timestamp": "00:12:26", "text": "我当时就想，我为什么要说这些？"}, {"type": "subtitle", "time": 750.829, "timestamp": "00:12:30", "text": "大声说出数字，老兄，这到底是怎么回事？"}, {"type": "subtitle", "time": 753.31, "timestamp": "00:12:33", "text": "我想不用太在意这些。"}]
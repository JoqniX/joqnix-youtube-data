[{"type": "subtitle", "time": 8342.509, "timestamp": "02:19:02", "text": "我没有把模板保存在任何地方，好吗？"}, {"type": "subtitle", "time": 8345.03, "timestamp": "02:19:05", "text": "希望不会出现类似电脑之类的东西"}, {"type": "subtitle", "time": 8348.27, "timestamp": "02:19:08", "text": "还有一些，但我们有三个位置，两个"}, {"type": "subtitle", "time": 8353.669, "timestamp": "02:19:13", "text": "上厕所的地方，还有呃这个"}, {"type": "subtitle", "time": 8358.15, "timestamp": "02:19:18", "text": "对，就是这两个地方。"}, {"type": "subtitle", "time": 8361.95, "timestamp": "02:19:21", "text": "那么，让我们打开这些盒子吧。"}, {"type": "subtitle", "time": 8366.19, "timestamp": "02:19:26", "text": "呃，照片可以放在这里一些"}, {"type": "subtitle", "time": 8369.389, "timestamp": "02:19:29", "text": "本质就像"}, {"type": "subtitle", "time": 8373.83, "timestamp": "02:19:33", "text": "不，这东西可以鸡肉 CH 可以在这里"}, {"type": "subtitle", "time": 8378.549, "timestamp": "02:19:38", "text": "你的小夏威夷鸡和一窝雏鸡"}, {"type": "subtitle", "time": 8382.07, "timestamp": "02:19:42", "text": "chck 和 kawaii kawaii"}, {"type": "subtitle", "time": 8384.75, "timestamp": "02:19:44", "text": "鸡肉这是什么？"}, {"type": "subtitle", "time": 8388.07, "timestamp": "02:19:48", "text": "呃，衣服"}, {"type": "subtitle", "time": 8391.27, "timestamp": "02:19:51", "text": "等等，是衣服吗？等等，我为什么？"}, {"type": "subtitle", "time": 8393.469, "timestamp": "02:19:53", "text": "想想看，这就是那个东西吗？"}, {"type": "subtitle", "time": 8396.79, "timestamp": "02:19:56", "text": "就像你往热水里加水的地方一样"}, {"type": "subtitle", "time": 8398.99, "timestamp": "02:19:58", "text": "水或其他什么东西，然后把它涂上"}]
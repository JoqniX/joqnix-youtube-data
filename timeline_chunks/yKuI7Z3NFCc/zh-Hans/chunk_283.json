[{"type": "subtitle", "time": 16983.59, "timestamp": "04:43:03", "text": "我将每周参加微信活动"}, {"type": "subtitle", "time": 16985.948, "timestamp": "04:43:05", "text": "我也会直播，因为我想提高。"}, {"type": "subtitle", "time": 16989.83, "timestamp": "04:43:09", "text": "我的日语考试快到了，嗯……"}, {"type": "subtitle", "time": 16992.11, "timestamp": "04:43:12", "text": "从上次直播来看，我不知道你是否知道我"}, {"type": "subtitle", "time": 16995.15, "timestamp": "04:43:15", "text": "我被学校选中了"}, {"type": "subtitle", "time": 16998.788, "timestamp": "04:43:18", "text": "我接受过采访，如果你查看我的推特就会知道了。"}, {"type": "subtitle", "time": 17000.91, "timestamp": "04:43:20", "text": "账户是子账户，不是主账户。"}, {"type": "subtitle", "time": 17004.35, "timestamp": "04:43:24", "text": "你可能知道我要去哪儿，所以"}, {"type": "subtitle", "time": 17006.27, "timestamp": "04:43:26", "text": "是的，我是"}, {"type": "subtitle", "time": 17009.11, "timestamp": "04:43:29", "text": "很兴奋，嗯，一切进展顺利，但是，是的，考试。"}, {"type": "subtitle", "time": 17012.51, "timestamp": "04:43:32", "text": "16号那天，我必须尽我所能。"}, {"type": "subtitle", "time": 17015.788, "timestamp": "04:43:35", "text": "此外，我们的情人节直播也将在……"}, {"type": "subtitle", "time": 17018.948, "timestamp": "04:43:38", "text": "如果我没记错的话，13号那天我会做。"}, {"type": "subtitle", "time": 17021.628, "timestamp": "04:43:41", "text": "因为14号我要旅行"}, {"type": "subtitle", "time": 17024.55, "timestamp": "04:43:44", "text": "因为我16号要考试，所以我……"}, {"type": "subtitle", "time": 17029.39, "timestamp": "04:43:49", "text": "去另一个州旅行，所以，是的。"}, {"type": "subtitle", "time": 17032.03, "timestamp": "04:43:52", "text": "嗯，Comas，我很期待……"}, {"type": "subtitle", "time": 17034.91, "timestamp": "04:43:54", "text": "情人节直播，我们会进行一场有趣的直播"}, {"type": "subtitle", "time": 17037.91, "timestamp": "04:43:57", "text": "大家好，差不多就是这样了，谢谢。"}]
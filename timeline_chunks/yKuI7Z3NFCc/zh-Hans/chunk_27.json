[{"type": "subtitle", "time": 1620.269, "timestamp": "00:27:00", "text": "是啊，你会把电视放在哪里呢？"}, {"type": "subtitle", "time": 1622.99, "timestamp": "00:27:02", "text": "不过我会这么说"}, {"type": "subtitle", "time": 1625.75, "timestamp": "00:27:05", "text": "向下"}, {"type": "subtitle", "time": 1628.35, "timestamp": "00:27:08", "text": "蜡笔"}, {"type": "subtitle", "time": 1633.75, "timestamp": "00:27:13", "text": "关键是这些磁带是什么？哦，鼠标哦"}, {"type": "subtitle", "time": 1636.23, "timestamp": "00:27:16", "text": "哦，好的，我应该把它放上去。"}, {"type": "subtitle", "time": 1639.269, "timestamp": "00:27:19", "text": "好了，收到，收到，好的，明白了。"}, {"type": "subtitle", "time": 1642.07, "timestamp": "00:27:22", "text": "又收到一个"}, {"type": "subtitle", "time": 1646.07, "timestamp": "00:27:26", "text": "再买一本书，再买一本书，好吗？"}, {"type": "subtitle", "time": 1648.43, "timestamp": "00:27:28", "text": "我们把书放在这里吧。"}, {"type": "subtitle", "time": 1651.11, "timestamp": "00:27:31", "text": "[音乐]"}, {"type": "subtitle", "time": 1656.269, "timestamp": "00:27:36", "text": "现在我将安排"}, {"type": "subtitle", "time": 1660.029, "timestamp": "00:27:40", "text": "他们觉得这看起来像个鼠标垫。"}, {"type": "subtitle", "time": 1661.43, "timestamp": "00:27:41", "text": "鼠标将位于何处"}, {"type": "subtitle", "time": 1666.63, "timestamp": "00:27:46", "text": "走吧，这个会在床上，糟透了。"}, {"type": "subtitle", "time": 1668.35, "timestamp": "00:27:48", "text": "坏的"}, {"type": "subtitle", "time": 1674.789, "timestamp": "00:27:54", "text": "不好，呃，你会在那里，是的，在那里"}, {"type": "subtitle", "time": 1677.269, "timestamp": "00:27:57", "text": "应该有空格，对吧？应该有。"}, {"type": "subtitle", "time": 1679.59, "timestamp": "00:27:59", "text": "成为空间"}]
[{"type": "subtitle", "time": 19568.788, "timestamp": "05:26:08", "text": "我们要改变一些东西，不不不"}, {"type": "subtitle", "time": 19570.47, "timestamp": "05:26:10", "text": "我们不能更换球队，对吧？"}, {"type": "subtitle", "time": 19573.948, "timestamp": "05:26:13", "text": "这太不公平了，混蛋！没错，这太不公平了！"}, {"type": "subtitle", "time": 19577.03, "timestamp": "05:26:17", "text": "这不是你说的“不要”是什么意思。"}, {"type": "subtitle", "time": 19579.07, "timestamp": "05:26:19", "text": "别担心，我们会赢的。"}, {"type": "subtitle", "time": 19581.83, "timestamp": "05:26:21", "text": "这次我们做出了正确的选择，不必担心。"}, {"type": "subtitle", "time": 19585.43, "timestamp": "05:26:25", "text": "角色扮演，好吧，伙计们，所以你们"}, {"type": "subtitle", "time": 19588.51, "timestamp": "05:26:28", "text": "想要重拍，所以我们没办法。"}, {"type": "subtitle", "time": 19591.07, "timestamp": "05:26:31", "text": "正如我所说，我们会重制，但我们可以给你"}, {"type": "subtitle", "time": 19593.03, "timestamp": "05:26:33", "text": "一场比赛的尖刺"}, {"type": "subtitle", "time": 19596.628, "timestamp": "05:26:36", "text": "我们指的是重制版中额外增加的一个“不”字。"}, {"type": "subtitle", "time": 19598.39, "timestamp": "05:26:38", "text": "我们想选择的角色"}, {"type": "subtitle", "time": 19601.628, "timestamp": "05:26:41", "text": "我们想要这个角色，但我们不想要。"}, {"type": "subtitle", "time": 19603.788, "timestamp": "05:26:43", "text": "甚至有时间思考我们的"}, {"type": "subtitle", "time": 19606.07, "timestamp": "05:26:46", "text": "角色，选哪个？"}, {"type": "subtitle", "time": 19607.708, "timestamp": "05:26:47", "text": "这样我们就可以额外给你加一分。"}, {"type": "subtitle", "time": 19610.03, "timestamp": "05:26:50", "text": "未评级，但呃，灵魂将会是"}, {"type": "subtitle", "time": 19612.788, "timestamp": "05:26:52", "text": "遇到问题他不会有"}, {"type": "subtitle", "time": 19614.07, "timestamp": "05:26:54", "text": "问题不"}, {"type": "subtitle", "time": 19618.67, "timestamp": "05:26:58", "text": "别担心，好吧，四个未评级，不，我们是"}]
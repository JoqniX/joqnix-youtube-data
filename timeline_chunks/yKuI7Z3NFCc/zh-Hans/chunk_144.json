[{"type": "subtitle", "time": 8640.42, "timestamp": "02:24:00", "text": "不能，嗯，不。"}, {"type": "subtitle", "time": 8643.19, "timestamp": "02:24:03", "text": "[音乐]"}, {"type": "subtitle", "time": 8645.23, "timestamp": "02:24:05", "text": "因为没有"}, {"type": "subtitle", "time": 8651.67, "timestamp": "02:24:11", "text": "太空大书"}, {"type": "subtitle", "time": 8653.87, "timestamp": "02:24:13", "text": "你们俩在那儿呢"}, {"type": "subtitle", "time": 8657.19, "timestamp": "02:24:17", "text": "是的，你也可以把它放在那里。"}, {"type": "subtitle", "time": 8660.67, "timestamp": "02:24:20", "text": "是的，哦，你吃饱了。"}, {"type": "subtitle", "time": 8663.63, "timestamp": "02:24:23", "text": "现在我会让你保持领先地位。"}, {"type": "subtitle", "time": 8669.11, "timestamp": "02:24:29", "text": "这样我就可以给这些人一点……"}, {"type": "subtitle", "time": 8672.19, "timestamp": "02:24:32", "text": "一切都安排妥当了，应该没问题。"}, {"type": "subtitle", "time": 8673.469, "timestamp": "02:24:33", "text": "还有一个"}, {"type": "subtitle", "time": 8675.15, "timestamp": "02:24:35", "text": "书"}, {"type": "subtitle", "time": 8679.389, "timestamp": "02:24:39", "text": "哦，我不能留着这些，所以我想我……"}, {"type": "subtitle", "time": 8682.55, "timestamp": "02:24:42", "text": "可能会让这两个人继续待下去。"}, {"type": "subtitle", "time": 8685.389, "timestamp": "02:24:45", "text": "不，我相信这是一个家庭"}, {"type": "subtitle", "time": 8690.67, "timestamp": "02:24:50", "text": "就是那个东西，这样我就可以把它放在那里了。"}, {"type": "subtitle", "time": 8699.99, "timestamp": "02:24:59", "text": "下面这些应该就足够了。"}]
[{"type": "subtitle", "time": 23100.67, "timestamp": "06:25:00", "text": "那个角色，呃，她叫什么来着？"}, {"type": "subtitle", "time": 23102.91, "timestamp": "06:25:02", "text": "即将登场的新角色"}, {"type": "subtitle", "time": 23105.23, "timestamp": "06:25:05", "text": "电音女郎"}, {"type": "subtitle", "time": 23108.43, "timestamp": "06:25:08", "text": "她会跑会滑，那正是我喜欢的类型。"}, {"type": "subtitle", "time": 23114.23, "timestamp": "06:25:14", "text": "我不知道我会玩什么风格"}, {"type": "subtitle", "time": 23115.628, "timestamp": "06:25:15", "text": "瓦兰"}, {"type": "subtitle", "time": 23118.788, "timestamp": "06:25:18", "text": "还有，不过最有可能的是我会参加。"}, {"type": "subtitle", "time": 23120.43, "timestamp": "06:25:20", "text": "其他"}, {"type": "subtitle", "time": 23124.23, "timestamp": "06:25:24", "text": "服务器，因为我的问题是"}, {"type": "subtitle", "time": 23128.27, "timestamp": "06:25:28", "text": "当我在Hol游戏中看到毒性行为时"}, {"type": "subtitle", "time": 23132.39, "timestamp": "06:25:32", "text": "或者其他什么，呃，我不知道我妻子"}, {"type": "subtitle", "time": 23136.468, "timestamp": "06:25:36", "text": "就这么倒下了，我打得很烂，但就是这样。"}, {"type": "subtitle", "time": 23139.19, "timestamp": "06:25:39", "text": "关于V只有一点，但它仍然是……"}, {"type": "subtitle", "time": 23141.67, "timestamp": "06:25:41", "text": "我需要适应这种经历"}, {"type": "subtitle", "time": 23143.548, "timestamp": "06:25:43", "text": "没错，这是我需要获得的经验。"}, {"type": "subtitle", "time": 23146.59, "timestamp": "06:25:46", "text": "以前是这样，所以我也会这样做。"}, {"type": "subtitle", "time": 23154.708, "timestamp": "06:25:54", "text": "[音乐]"}, {"type": "subtitle", "time": 23156.708, "timestamp": "06:25:56", "text": "最好的……等等，发生了什么事？"}]
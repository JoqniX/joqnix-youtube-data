[{"type": "subtitle", "time": 20943.548, "timestamp": "05:49:03", "text": "博·琼斯"}, {"type": "subtitle", "time": 20959.15, "timestamp": "05:49:19", "text": "我们知道我回来了，等等"}, {"type": "subtitle", "time": 20962.59, "timestamp": "05:49:22", "text": "等等，会有人来的，等等就行了。"}, {"type": "subtitle", "time": 20969.788, "timestamp": "05:49:29", "text": "匆忙"}, {"type": "subtitle", "time": 20972.59, "timestamp": "05:49:32", "text": "等等等等等等等等等等"}, {"type": "subtitle", "time": 20976.11, "timestamp": "05:49:36", "text": "我们还有时间吗？我的天啊！"}, {"type": "subtitle", "time": 20977.548, "timestamp": "05:49:37", "text": "女子死亡"}, {"type": "subtitle", "time": 20980.43, "timestamp": "05:49:40", "text": "好吧，我要去背刺了。"}]
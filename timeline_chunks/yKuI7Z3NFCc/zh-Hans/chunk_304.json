[{"type": "subtitle", "time": 18242.23, "timestamp": "05:04:02", "text": "哦，真好。"}, {"type": "subtitle", "time": 18245.628, "timestamp": "05:04:05", "text": "耶稣啊，绝对不会留下来"}, {"type": "subtitle", "time": 18250.27, "timestamp": "05:04:10", "text": "我不是跟你说过待在那儿吗？哦，是的。"}, {"type": "subtitle", "time": 18251.99, "timestamp": "05:04:11", "text": "所以就是这样"}, {"type": "subtitle", "time": 18254.11, "timestamp": "05:04:14", "text": "阿当"}, {"type": "subtitle", "time": 18257.35, "timestamp": "05:04:17", "text": "我被它杀死了"}, {"type": "subtitle", "time": 18261.67, "timestamp": "05:04:21", "text": "Chito 兄弟，这真的太痛苦了。"}, {"type": "subtitle", "time": 18266.548, "timestamp": "05:04:26", "text": "男人痛苦他白金了 一个白金，那是"}, {"type": "subtitle", "time": 18267.12, "timestamp": "05:04:27", "text": "为什么"}, {"type": "subtitle", "time": 18270.43, "timestamp": "05:04:30", "text": "[笑声]"}, {"type": "subtitle", "time": 18274.27, "timestamp": "05:04:34", "text": "是的，我可以买，我可以买，不，我"}, {"type": "subtitle", "time": 18276.91, "timestamp": "05:04:36", "text": "不行吗？我以为我可以，我们真的需要"}, {"type": "subtitle", "time": 18280.15, "timestamp": "05:04:40", "text": "圣贤者"}, {"type": "subtitle", "time": 18294.83, "timestamp": "05:04:54", "text": "有些我是"}, {"type": "subtitle", "time": 18298.35, "timestamp": "05:04:58", "text": "等一下，我去侦察一下，等等"}]
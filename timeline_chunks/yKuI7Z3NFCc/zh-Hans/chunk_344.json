[{"type": "subtitle", "time": 20641.07, "timestamp": "05:44:01", "text": "兄弟，呃，不不不，我没有我的小号。"}, {"type": "subtitle", "time": 20655.628, "timestamp": "05:44:15", "text": "不同的人知道我不想SP"}, {"type": "subtitle", "time": 20662.43, "timestamp": "05:44:22", "text": "首先他会在……"}, {"type": "subtitle", "time": 20665.23, "timestamp": "05:44:25", "text": "现在离开，等等"}, {"type": "subtitle", "time": 20669.948, "timestamp": "05:44:29", "text": "你一看到有人就……嗯……"}, {"type": "subtitle", "time": 20692.628, "timestamp": "05:44:52", "text": "糟糕啊我的天"}, {"type": "subtitle", "time": 20694.788, "timestamp": "05:44:54", "text": "腿"}]
[{"type": "subtitle", "time": 61.509, "timestamp": "00:01:01", "text": "我整夜没睡，神圣的"}, {"type": "subtitle", "time": 63.75, "timestamp": "00:01:03", "text": "圣"}, {"type": "subtitle", "time": 73.749, "timestamp": "00:01:13", "text": "以及我的身体"}, {"type": "subtitle", "time": 82.95, "timestamp": "00:01:22", "text": "我的身体好痛，我甚至都打不开门。"}, {"type": "subtitle", "time": 85.23, "timestamp": "00:01:25", "text": "我的"}, {"type": "subtitle", "time": 88.749, "timestamp": "00:01:28", "text": "我喜欢眼睛"}, {"type": "subtitle", "time": 91.31, "timestamp": "00:01:31", "text": "这现在并非普遍情况，因为我没有"}]
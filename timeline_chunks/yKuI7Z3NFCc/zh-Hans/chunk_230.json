[{"type": "subtitle", "time": 13801.79, "timestamp": "03:50:01", "text": "今天无限弹药的罗德还好吗？"}, {"type": "subtitle", "time": 13809.59, "timestamp": "03:50:09", "text": "好的，我的设置看起来没问题。"}, {"type": "subtitle", "time": 13810.91, "timestamp": "03:50:10", "text": "是"}, {"type": "subtitle", "time": 13815.229, "timestamp": "03:50:15", "text": "等等，我的设置错了。"}, {"type": "subtitle", "time": 13817.83, "timestamp": "03:50:17", "text": "等等，这些不是我的设置，这些才是"}, {"type": "subtitle", "time": 13820.71, "timestamp": "03:50:20", "text": "这些设置不是我的，它们不是我的"}, {"type": "subtitle", "time": 13826.469, "timestamp": "03:50:26", "text": "设置 我的天啊 我的设置是"}, {"type": "subtitle", "time": 13834.75, "timestamp": "03:50:34", "text": "什么？为什么？太……哦我的天啊……我"}, {"type": "subtitle", "time": 13837.469, "timestamp": "03:50:37", "text": "必须设置好一切"}, {"type": "subtitle", "time": 13839.79, "timestamp": "03:50:39", "text": "向上"}, {"type": "subtitle", "time": 13843.07, "timestamp": "03:50:43", "text": "好的，我会用默认设置玩。"}, {"type": "subtitle", "time": 13850.189, "timestamp": "03:50:50", "text": "嗨，我无法重新加载，你卸载了吗？"}, {"type": "subtitle", "time": 13852.95, "timestamp": "03:50:52", "text": "我玩的那个游戏，呃，不，那个游戏在我的游戏里。"}]
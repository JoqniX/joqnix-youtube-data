[{"type": "subtitle", "time": 21009.15, "timestamp": "05:50:09", "text": "哦，不错，他在坡道上，他在……"}, {"type": "subtitle", "time": 21012.868, "timestamp": "05:50:12", "text": "快走，别死，别这样死，兄弟。"}, {"type": "subtitle", "time": 21013.708, "timestamp": "05:50:13", "text": "随机的"}, {"type": "subtitle", "time": 21016.39, "timestamp": "05:50:16", "text": "想象一下死于随机喷洒"}, {"type": "subtitle", "time": 21017.51, "timestamp": "05:50:17", "text": "它是"}, {"type": "subtitle", "time": 21027.868, "timestamp": "05:50:27", "text": "时间有多少"}, {"type": "subtitle", "time": 21047.548, "timestamp": "05:50:47", "text": "哦，是的，我们走吧，我们走吧，我们走吧"}, {"type": "subtitle", "time": 21049.948, "timestamp": "05:50:49", "text": "加油伙计们，伙计们，我们尽力了，我们做到了"}, {"type": "subtitle", "time": 21051.708, "timestamp": "05:50:51", "text": "我们最好的"}, {"type": "subtitle", "time": 21054.31, "timestamp": "05:50:54", "text": "太好了，你为什么要放弃？我们还能赢。"}, {"type": "subtitle", "time": 21056.87, "timestamp": "05:50:56", "text": "这"}, {"type": "subtitle", "time": 21058.35, "timestamp": "05:50:58", "text": "[音乐]"}]
[{"type": "subtitle", "time": 2640.27, "timestamp": "00:44:00", "text": "所以"}, {"type": "subtitle", "time": 2645.27, "timestamp": "00:44:05", "text": "等等，我们还是把这些人都留下吧。"}, {"type": "subtitle", "time": 2647.69, "timestamp": "00:44:07", "text": "你可以在这里继续"}, {"type": "subtitle", "time": 2654.47, "timestamp": "00:44:14", "text": "[音乐]"}, {"type": "subtitle", "time": 2664.91, "timestamp": "00:44:24", "text": "等等，哪个是不粘的，等等，哪个"}, {"type": "subtitle", "time": 2668.63, "timestamp": "00:44:28", "text": "呃，是轻的，而且很高，他等等，我"}, {"type": "subtitle", "time": 2670.51, "timestamp": "00:44:30", "text": "不"}, {"type": "subtitle", "time": 2672.91, "timestamp": "00:44:32", "text": "知道"}, {"type": "subtitle", "time": 2675.19, "timestamp": "00:44:35", "text": "啊，好的，如果我是"}, {"type": "subtitle", "time": 2678.23, "timestamp": "00:44:38", "text": "没错，我会……呃，我不知道什么"}, {"type": "subtitle", "time": 2682.589, "timestamp": "00:44:42", "text": "但我认为我们可以把它"}, {"type": "subtitle", "time": 2686.309, "timestamp": "00:44:46", "text": "这将是"}, {"type": "subtitle", "time": 2689.549, "timestamp": "00:44:49", "text": "肥皂"}, {"type": "subtitle", "time": 2694.99, "timestamp": "00:44:54", "text": "这里将进行洗涤。"}, {"type": "subtitle", "time": 2698.109, "timestamp": "00:44:58", "text": "我不知道这是什么东西，我想"}, {"type": "subtitle", "time": 2699.91, "timestamp": "00:44:59", "text": "这是"}]
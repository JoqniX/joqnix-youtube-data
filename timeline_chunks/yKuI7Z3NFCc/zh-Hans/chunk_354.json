[{"type": "subtitle", "time": 21242.07, "timestamp": "05:54:02", "text": "他们现在正在做，好吧，我会留下来。"}, {"type": "subtitle", "time": 21246.15, "timestamp": "05:54:06", "text": "然后，呃，菲尼克斯，卖掉你的枪，拿走一把枪。"}, {"type": "subtitle", "time": 21249.43, "timestamp": "05:54:09", "text": "在这里拿枪，出生点在哪里"}, {"type": "subtitle", "time": 21253.548, "timestamp": "05:54:13", "text": "生成哪把枪？它是矢量矢量哦"}, {"type": "subtitle", "time": 21257.43, "timestamp": "05:54:17", "text": "等等，等等，快来卖掉你的枪，卖掉你的"}, {"type": "subtitle", "time": 21265.03, "timestamp": "05:54:25", "text": "应该没问题，他们很可能会来。"}, {"type": "subtitle", "time": 21266.948, "timestamp": "05:54:26", "text": "它的"}, {"type": "subtitle", "time": 21268.59, "timestamp": "05:54:28", "text": "一个"}, {"type": "subtitle", "time": 21271.27, "timestamp": "05:54:31", "text": "来吧，别"}, {"type": "subtitle", "time": 21274.03, "timestamp": "05:54:34", "text": "死了就待在那儿吧"}, {"type": "subtitle", "time": 21291.708, "timestamp": "05:54:51", "text": "已经走了，去吧，虾虎鱼"}, {"type": "subtitle", "time": 21297.31, "timestamp": "05:54:57", "text": "快跑！他们正冲着你们过来！"}, {"type": "subtitle", "time": 21299.948, "timestamp": "05:54:59", "text": "你们会喜欢的，我们会坚持下去。"}]
[{"type": "subtitle", "time": 21660.43, "timestamp": "06:01:00", "text": "这让我们……"}, {"type": "subtitle", "time": 21663.468, "timestamp": "06:01:03", "text": "他们说不会同意，他们不会去"}, {"type": "subtitle", "time": 21669.15, "timestamp": "06:01:09", "text": "同意的话就说“是”或“否”，男生们就说“是”或“否”。"}, {"type": "subtitle", "time": 21674.628, "timestamp": "06:01:14", "text": "不快，我的天哪，不，他们甚至都不快"}, {"type": "subtitle", "time": 21677.788, "timestamp": "06:01:17", "text": "知道不要好好好好好吧好吧来"}, {"type": "subtitle", "time": 21679.35, "timestamp": "06:01:19", "text": "来来"}, {"type": "subtitle", "time": 21684.628, "timestamp": "06:01:24", "text": "ni 每个人 KN 什么杀戮"}, {"type": "subtitle", "time": 21688.03, "timestamp": "06:01:28", "text": "有人问你为什么要杀人？兄弟，这是……"}, {"type": "subtitle", "time": 21696.39, "timestamp": "06:01:36", "text": "我的天啊"}, {"type": "subtitle", "time": 21712.19, "timestamp": "06:01:52", "text": "上帝啊，那场景哦"}, {"type": "subtitle", "time": 21715.66, "timestamp": "06:01:55", "text": "不，那才是作弊。"}]
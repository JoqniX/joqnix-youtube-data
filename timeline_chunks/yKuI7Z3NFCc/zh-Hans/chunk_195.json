[{"type": "subtitle", "time": 11700.389, "timestamp": "03:15:00", "text": "嗯，不过，呃，主要是我想……"}, {"type": "subtitle", "time": 11702.55, "timestamp": "03:15:02", "text": "我主要想做YouTube"}, {"type": "subtitle", "time": 11705.229, "timestamp": "03:15:05", "text": "Familia 和抽搐的使魔就像"}, {"type": "subtitle", "time": 11707.63, "timestamp": "03:15:07", "text": "同步在一起 同步"}, {"type": "subtitle", "time": 11710.99, "timestamp": "03:15:10", "text": "一起的意思呃，我通常不呃"}, {"type": "subtitle", "time": 11713.429, "timestamp": "03:15:13", "text": "你关心数字，但你呢？"}, {"type": "subtitle", "time": 11715.59, "timestamp": "03:15:15", "text": "我不知道我到底有多少。"}, {"type": "subtitle", "time": 11717.59, "timestamp": "03:15:17", "text": "现在就在 YouTube 上，但是"}, {"type": "subtitle", "time": 11720.95, "timestamp": "03:15:20", "text": "这里显示呃，463，就在Twitch上"}, {"type": "subtitle", "time": 11724.51, "timestamp": "03:15:24", "text": "总结一下，嗯，如果是463的话。"}, {"type": "subtitle", "time": 11728.269, "timestamp": "03:15:28", "text": "我在Twitch上有粉丝，然后我想……"}, {"type": "subtitle", "time": 11731.67, "timestamp": "03:15:31", "text": "达到 YouTube 相同的数量"}, {"type": "subtitle", "time": 11733.51, "timestamp": "03:15:33", "text": "还有 CU 为什么"}, {"type": "subtitle", "time": 11735.07, "timestamp": "03:15:35", "text": "不是"}, {"type": "subtitle", "time": 11739.91, "timestamp": "03:15:39", "text": "是的，即使 Twitch 是第一个家"}, {"type": "subtitle", "time": 11743.55, "timestamp": "03:15:43", "text": "我的，我，嗯，你叫什么来着？"}, {"type": "subtitle", "time": 11746.389, "timestamp": "03:15:46", "text": "那是我第一次开始直播的地方。"}, {"type": "subtitle", "time": 11747.55, "timestamp": "03:15:47", "text": "和"}, {"type": "subtitle", "time": 11750.189, "timestamp": "03:15:50", "text": "吸取了经验教训，嗯。"}, {"type": "subtitle", "time": 11753.55, "timestamp": "03:15:53", "text": "我想把这个数字变成这样"}, {"type": "subtitle", "time": 11756.55, "timestamp": "03:15:56", "text": "假设已经均衡，不希望它恢复原状"}]
[{"type": "subtitle", "time": 23280.99, "timestamp": "06:28:00", "text": "紧张，不知为何很紧张，不是吗？"}, {"type": "subtitle", "time": 23283.35, "timestamp": "06:28:03", "text": "紧张，我觉得是焦虑。"}, {"type": "subtitle", "time": 23286.23, "timestamp": "06:28:06", "text": "或者说，我觉得我当时有点紧张"}, {"type": "subtitle", "time": 23288.788, "timestamp": "06:28:08", "text": "但我当时的感觉就像，呃，平静下来了。"}, {"type": "subtitle", "time": 23292.27, "timestamp": "06:28:12", "text": "我独自一人躺在浴缸里，我当时"}, {"type": "subtitle", "time": 23295.548, "timestamp": "06:28:15", "text": "想着，你知道吗，呃，在我们之前"}, {"type": "subtitle", "time": 23299.03, "timestamp": "06:28:19", "text": "一切都从我做某件事开始"}, {"type": "subtitle", "time": 23302.99, "timestamp": "06:28:22", "text": "你们管它叫什么来着？嗯……准备演讲"}, {"type": "subtitle", "time": 23306.548, "timestamp": "06:28:26", "text": "我想到的每个人都跟我有关"}, {"type": "subtitle", "time": 23308.51, "timestamp": "06:28:28", "text": "我说让它喵喵叫，因为我想这么做。"}, {"type": "subtitle", "time": 23312.19, "timestamp": "06:28:32", "text": "简单来说，这件事最重要的就是……"}, {"type": "subtitle", "time": 23314.67, "timestamp": "06:28:34", "text": "无关乎比赛的胜负"}, {"type": "subtitle", "time": 23317.35, "timestamp": "06:28:37", "text": "谁没赢？谁表现不好？谁表现好？"}, {"type": "subtitle", "time": 23321.11, "timestamp": "06:28:41", "text": "最糟糕的是那些做得好的人，哦，这都发生在之后。"}, {"type": "subtitle", "time": 23325.868, "timestamp": "06:28:45", "text": "这次事件发生后的几天里，这场比赛将会如何发展？"}, {"type": "subtitle", "time": 23329.31, "timestamp": "06:28:49", "text": "这10个人以及那些"}, {"type": "subtitle", "time": 23332.59, "timestamp": "06:28:52", "text": "没能参加我想参加的瓦勒活动。"}, {"type": "subtitle", "time": 23336.15, "timestamp": "06:28:56", "text": "让他们连接起来一起玩耍 勇气"}, {"type": "subtitle", "time": 23339.83, "timestamp": "06:28:59", "text": "嗯，这是你们之间常见的游戏。"}]
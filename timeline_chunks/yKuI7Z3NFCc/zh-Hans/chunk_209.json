[{"type": "subtitle", "time": 12543.349, "timestamp": "03:29:03", "text": "Discord官方"}, {"type": "subtitle", "time": 12549.07, "timestamp": "03:29:09", "text": "呃，这个Discord市政厅在哪儿？"}, {"type": "subtitle", "time": 12550.83, "timestamp": "03:29:10", "text": "是的，如果你想要Discord隧道的话"}, {"type": "subtitle", "time": 12553.91, "timestamp": "03:29:13", "text": "可能会注意到类似这样的事情……"}, {"type": "subtitle", "time": 12556.189, "timestamp": "03:29:16", "text": "定制问题，这有点……"}, {"type": "subtitle", "time": 12558.03, "timestamp": "03:29:18", "text": "即将到来"}, {"type": "subtitle", "time": 12559.91, "timestamp": "03:29:19", "text": "就像某种即将到来的东西"}, {"type": "subtitle", "time": 12563.349, "timestamp": "03:29:23", "text": "Discord 即将面向所有服务器开放"}, {"type": "subtitle", "time": 12565.87, "timestamp": "03:29:25", "text": "社区启用服务器，所以我将"}, {"type": "subtitle", "time": 12569.229, "timestamp": "03:29:29", "text": "转变为某种漫长而艰难的方式"}, {"type": "subtitle", "time": 12572.429, "timestamp": "03:29:32", "text": "所以，在这里你只需要获得角色。"}, {"type": "subtitle", "time": 12574.469, "timestamp": "03:29:34", "text": "你想去哪儿都行，呃，你拿什么都行，你"}, {"type": "subtitle", "time": 12577.389, "timestamp": "03:29:37", "text": "你将获得你在亚洲的职位"}, {"type": "subtitle", "time": 12580.349, "timestamp": "03:29:40", "text": "这样更容易获得"}, {"type": "subtitle", "time": 12583.429, "timestamp": "03:29:43", "text": "像这样的角色就像问答题一样。"}, {"type": "subtitle", "time": 12585.229, "timestamp": "03:29:45", "text": "类似选择题那种"}, {"type": "subtitle", "time": 12587.389, "timestamp": "03:29:47", "text": "所以它更好，对吧？"}, {"type": "subtitle", "time": 12591.189, "timestamp": "03:29:51", "text": "是的，所以我打算用那种方式来修复它。"}, {"type": "subtitle", "time": 12593.75, "timestamp": "03:29:53", "text": "总有一天我会处理服务器的，因为它太乱了，我觉得。"}, {"type": "subtitle", "time": 12596.51, "timestamp": "03:29:56", "text": "我不知道，不过是的，我也喜欢你。"}, {"type": "subtitle", "time": 12598.389, "timestamp": "03:29:58", "text": "您可以选择所有频道"}]
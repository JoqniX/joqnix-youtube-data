[{"type": "subtitle", "time": 22980.27, "timestamp": "06:23:00", "text": "就像上一场比赛那样，在尖刺冲刺中出现过一次"}, {"type": "subtitle", "time": 22985.628, "timestamp": "06:23:05", "text": "P 拿走了，嗯，对，但是雨和雨刮器"}, {"type": "subtitle", "time": 22990.19, "timestamp": "06:23:10", "text": "我解锁的自由球员都在这里，但是"}, {"type": "subtitle", "time": 22993.07, "timestamp": "06:23:13", "text": "是啊，但我很期待玩更多游戏。"}, {"type": "subtitle", "time": 22996.35, "timestamp": "06:23:16", "text": "Valerant，学习这款游戏，但也"}, {"type": "subtitle", "time": 22998.07, "timestamp": "06:23:18", "text": "我内心深处有一个声音告诉我："}, {"type": "subtitle", "time": 23001.23, "timestamp": "06:23:21", "text": "不想玩，因为……呃……你……"}, {"type": "subtitle", "time": 23003.07, "timestamp": "06:23:23", "text": "就叫它"}, {"type": "subtitle", "time": 23012.07, "timestamp": "06:23:32", "text": "等等，为什么P结尾？"}, {"type": "subtitle", "time": 23015.19, "timestamp": "06:23:35", "text": "是的，嗯"}, {"type": "subtitle", "time": 23017.23, "timestamp": "06:23:37", "text": "呃，我内心深处有一部分想要……"}, {"type": "subtitle", "time": 23020.15, "timestamp": "06:23:40", "text": "玩游戏并了解游戏"}, {"type": "subtitle", "time": 23023.07, "timestamp": "06:23:43", "text": "Joy想加入？不，我决定结束了，笨蛋。"}, {"type": "subtitle", "time": 23025.868, "timestamp": "06:23:45", "text": "我要结束了，我只想说几句。"}, {"type": "subtitle", "time": 23028.868, "timestamp": "06:23:48", "text": "东西和包装"}, {"type": "subtitle", "time": 23030.43, "timestamp": "06:23:50", "text": "向上"}, {"type": "subtitle", "time": 23038.59, "timestamp": "06:23:58", "text": "我不知道，我感觉有点糟糕，但是"}]
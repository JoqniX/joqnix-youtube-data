[{"type": "subtitle", "time": 7578.79, "timestamp": "02:06:18", "text": "天哪，我不小心碰到了"}, {"type": "subtitle", "time": 7581.31, "timestamp": "02:06:21", "text": "我用下巴夹着麦克风，然后把它静音了。哦"}, {"type": "subtitle", "time": 7586.39, "timestamp": "02:06:26", "text": "[音乐]"}, {"type": "subtitle", "time": 7589.149, "timestamp": "02:06:29", "text": "帮我清理，你知道什么时候如果我是"}, {"type": "subtitle", "time": 7592.87, "timestamp": "02:06:32", "text": "打扫一个房间需要很长时间"}, {"type": "subtitle", "time": 7596.51, "timestamp": "02:06:36", "text": "那天我确保它完全除尘了。"}, {"type": "subtitle", "time": 7600.51, "timestamp": "02:06:40", "text": "每个角落都打扫得干干净净。"}, {"type": "subtitle", "time": 7603.5, "timestamp": "02:06:43", "text": "然后安排一下"}, {"type": "subtitle", "time": 7611.149, "timestamp": "02:06:51", "text": "什么事都得花我好长时间，别这样"}, {"type": "subtitle", "time": 7613.51, "timestamp": "02:06:53", "text": "知道为什么"}, {"type": "subtitle", "time": 7616.87, "timestamp": "02:06:56", "text": "每次我"}]
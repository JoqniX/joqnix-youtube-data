[{"type": "subtitle", "time": 7988.709, "timestamp": "02:13:08", "text": "嗨，Sky，嗨，嗨，你好吗？"}, {"type": "subtitle", "time": 7992.35, "timestamp": "02:13:12", "text": "哦，你可以把它放在冰箱上哦"}, {"type": "subtitle", "time": 7998.91, "timestamp": "02:13:18", "text": "冰箱"}, {"type": "subtitle", "time": 8001.589, "timestamp": "02:13:21", "text": "哦，你可以把它放在前面，我没有。"}, {"type": "subtitle", "time": 8002.53, "timestamp": "02:13:22", "text": "知道"}, {"type": "subtitle", "time": 8004.43, "timestamp": "02:13:24", "text": "[音乐]"}, {"type": "subtitle", "time": 8006.669, "timestamp": "02:13:26", "text": "那"}, {"type": "subtitle", "time": 8020.37, "timestamp": "02:13:40", "text": "酷，等等"}, {"type": "subtitle", "time": 8021.629, "timestamp": "02:13:41", "text": "[音乐]"}, {"type": "subtitle", "time": 8025.109, "timestamp": "02:13:45", "text": "等等，还有，这是你的吗？"}, {"type": "subtitle", "time": 8027.51, "timestamp": "02:13:47", "text": "我想这是你第一次来这里吧"}, {"type": "subtitle", "time": 8030.549, "timestamp": "02:13:50", "text": "现在时间到了，Sky，你觉得我怎么样？"}, {"type": "subtitle", "time": 8038.669, "timestamp": "02:13:58", "text": "是的，这是你第一次，是的。"}]
[{"type": "subtitle", "time": 5822.79, "timestamp": "01:37:02", "text": "大学生，我自己的房子，好吧，那是什么？"}, {"type": "subtitle", "time": 5824.709, "timestamp": "01:37:04", "text": "下一个"}, {"type": "subtitle", "time": 5829.59, "timestamp": "01:37:09", "text": "2010年，哦，我的天哪，他住在……"}, {"type": "subtitle", "time": 5831.31, "timestamp": "01:37:11", "text": "他们住在"}, {"type": "subtitle", "time": 5834.03, "timestamp": "01:37:14", "text": "城市？我看到一座桥吗？我的天哪！"}, {"type": "subtitle", "time": 5835.39, "timestamp": "01:37:15", "text": "真是这样"}, {"type": "subtitle", "time": 5842.31, "timestamp": "01:37:22", "text": "到iel"}, {"type": "subtitle", "time": 5851.109, "timestamp": "01:37:31", "text": "书 我爱住在这里 我可以"}, {"type": "subtitle", "time": 5854.669, "timestamp": "01:37:34", "text": "只是在街上看到汽车之类的东西，比如晚上"}, {"type": "subtitle", "time": 5857.629, "timestamp": "01:37:37", "text": "生活本来就应该是喧闹的。"}, {"type": "subtitle", "time": 5860.99, "timestamp": "01:37:40", "text": "但别忘了，就像你一样。"}, {"type": "subtitle", "time": 5869.149, "timestamp": "01:37:49", "text": "好的，哦等等，你可以移动这些东西。"}, {"type": "subtitle", "time": 5872.709, "timestamp": "01:37:52", "text": "已经在这里了。哦，那真是……"}, {"type": "subtitle", "time": 5879.75, "timestamp": "01:37:59", "text": "上次我做不到，真酷"}]
[{"type": "subtitle", "time": 18842.35, "timestamp": "05:14:02", "text": "很好，稍等一下，他们正从……过来。"}, {"type": "subtitle", "time": 18855.548, "timestamp": "05:14:15", "text": "他们怎么知道我在这里？"}, {"type": "subtitle", "time": 18875.03, "timestamp": "05:14:35", "text": "他"}, {"type": "subtitle", "time": 18885.51, "timestamp": "05:14:45", "text": "乔，你为什么不买下那批货物？"}, {"type": "subtitle", "time": 18896.548, "timestamp": "05:14:56", "text": "呃，不不不，里面"}, {"type": "subtitle", "time": 18899.83, "timestamp": "05:14:59", "text": "走吧走吧走吧，再来一次"}]
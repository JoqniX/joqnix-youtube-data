[{"type": "subtitle", "time": 10171.389, "timestamp": "02:49:31", "text": "哦，我刚刚意识到它几乎"}, {"type": "subtitle", "time": 10175.389, "timestamp": "02:49:35", "text": "将会是一个，不是一个，呃，我的意思是，它是"}, {"type": "subtitle", "time": 10176.91, "timestamp": "02:49:36", "text": "将会是"}, {"type": "subtitle", "time": 10183.83, "timestamp": "02:49:43", "text": "嗯，时间是上午11点。"}, {"type": "subtitle", "time": 10187.15, "timestamp": "02:49:47", "text": "下午所以我应该吃晚饭了。"}, {"type": "subtitle", "time": 10193.229, "timestamp": "02:49:53", "text": "鸡苗"}, {"type": "subtitle", "time": 10198.389, "timestamp": "02:49:58", "text": "我把东西都放在这里了，现在我们走吧，我走了"}]
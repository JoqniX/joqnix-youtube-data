[{"type": "subtitle", "time": 8160.75, "timestamp": "02:16:00", "text": "大概是吧。"}, {"type": "subtitle", "time": 8164.91, "timestamp": "02:16:04", "text": "效果还不错"}, {"type": "subtitle", "time": 8167.83, "timestamp": "02:16:07", "text": "这个人很爱读书，这人看起来很整洁。"}, {"type": "subtitle", "time": 8170.31, "timestamp": "02:16:10", "text": "书籍、漫画等等，还有"}, {"type": "subtitle", "time": 8172.95, "timestamp": "02:16:12", "text": "比如漫画、游戏等等。"}, {"type": "subtitle", "time": 8176.35, "timestamp": "02:16:16", "text": "我的天哪，我们没地方了，所以我们"}, {"type": "subtitle", "time": 8179.069, "timestamp": "02:16:19", "text": "把一些书放在上面"}, {"type": "subtitle", "time": 8187.32, "timestamp": "02:16:27", "text": "我们得到了一把吉他"}, {"type": "subtitle", "time": 8189.629, "timestamp": "02:16:29", "text": "[音乐]"}, {"type": "subtitle", "time": 8193.309, "timestamp": "02:16:33", "text": "超酷的贴纸，好珍贵的明"}, {"type": "subtitle", "time": 8196.27, "timestamp": "02:16:36", "text": "到他的地方，他的地方，等等，我们到了吗？"}, {"type": "subtitle", "time": 8198.99, "timestamp": "02:16:38", "text": "损坏或类似的东西"}, {"type": "subtitle", "time": 8201.349, "timestamp": "02:16:41", "text": "哦"}, {"type": "subtitle", "time": 8206.429, "timestamp": "02:16:46", "text": "2012年，两年后，我猜是什么"}, {"type": "subtitle", "time": 8214.389, "timestamp": "02:16:54", "text": "哦，我可以把乌龟放在上面。"}, {"type": "subtitle", "time": 8218.23, "timestamp": "02:16:58", "text": "等等，哦，看，青蛙来了！"}, {"type": "subtitle", "time": 8219.87, "timestamp": "02:16:59", "text": "青蛙"}]
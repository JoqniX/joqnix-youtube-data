[{"type": "subtitle", "time": 11581.309, "timestamp": "03:13:01", "text": "没有显示，所以我不知道这是否是"}, {"type": "subtitle", "time": 11583.71, "timestamp": "03:13:03", "text": "实际上，这是概要，但我收到了两份。"}, {"type": "subtitle", "time": 11586.67, "timestamp": "03:13:06", "text": "几天前，所以我相信就是这个。"}, {"type": "subtitle", "time": 11593.79, "timestamp": "03:13:13", "text": "书……呃，我不知道我有没有……"}, {"type": "subtitle", "time": 11596.11, "timestamp": "03:13:16", "text": "很久以前上传的视频，我想应该没有。"}, {"type": "subtitle", "time": 11599.83, "timestamp": "03:13:19", "text": "所以我的意思是，我确实上传了一些，就像我……"}, {"type": "subtitle", "time": 11602.83, "timestamp": "03:13:22", "text": "我创建了这个 YouTube 频道，嗯，就是这样。"}, {"type": "subtitle", "time": 11605.389, "timestamp": "03:13:25", "text": "是啊是啊，所以……"}, {"type": "subtitle", "time": 11608.67, "timestamp": "03:13:28", "text": "是的，但是 YouTube，呃，就像 YouTube"}, {"type": "subtitle", "time": 11610.75, "timestamp": "03:13:30", "text": "一切都好，第一次上传你"}, {"type": "subtitle", "time": 11613.83, "timestamp": "03:13:33", "text": "很可能需要检查一下"}, {"type": "subtitle", "time": 11616.87, "timestamp": "03:13:36", "text": "我第一次YouTube直播的日期"}, {"type": "subtitle", "time": 11619.87, "timestamp": "03:13:39", "text": "对，就是那个，那是12小时的。"}, {"type": "subtitle", "time": 11622.11, "timestamp": "03:13:42", "text": "我在 YouTube 上做了第一次直播"}, {"type": "subtitle", "time": 11626.71, "timestamp": "03:13:46", "text": "时间，是啊，是啊，哦，是啊，跟这个比起来"}, {"type": "subtitle", "time": 11630.03, "timestamp": "03:13:50", "text": "还有Twitch那个，我不知道最后一个是什么。"}, {"type": "subtitle", "time": 11634.51, "timestamp": "03:13:54", "text": "我记得那一年我做了很多YouTube视频。"}, {"type": "subtitle", "time": 11636.83, "timestamp": "03:13:56", "text": "今年不是去年，而是今年。"}]
[{"type": "subtitle", "time": 15904.229, "timestamp": "04:25:04", "text": "好吧，我不知道接下来会发生什么。"}, {"type": "subtitle", "time": 15910.95, "timestamp": "04:25:10", "text": "我忘了我是如何忘记如何改变"}, {"type": "subtitle", "time": 15914.71, "timestamp": "04:25:14", "text": "所以，如果传奇人物没有出现，就等着吧。"}, {"type": "subtitle", "time": 15917.91, "timestamp": "04:25:17", "text": "本赛季和前几个赛季一样，表现不佳。"}, {"type": "subtitle", "time": 15920.07, "timestamp": "04:25:20", "text": "我没有参与其中"}, {"type": "subtitle", "time": 15922.75, "timestamp": "04:25:22", "text": "等等，难道没有新一季要来了？"}, {"type": "subtitle", "time": 15925.03, "timestamp": "04:25:25", "text": "这款游戏发生了什么事？"}, {"type": "subtitle", "time": 15927.71, "timestamp": "04:25:27", "text": "虽然你，然后我会过去常常"}, {"type": "subtitle", "time": 15929.75, "timestamp": "04:25:29", "text": "有很多"}, {"type": "subtitle", "time": 15933.309, "timestamp": "04:25:33", "text": "主人留下的，我以前有很多"}, {"type": "subtitle", "time": 15937.309, "timestamp": "04:25:37", "text": "嗯，我是跳跃大师，没压力。"}, {"type": "subtitle", "time": 15938.99, "timestamp": "04:25:38", "text": "曾经有很多"}, {"type": "subtitle", "time": 15942.95, "timestamp": "04:25:42", "text": "每赛季都有传奇人物"}, {"type": "subtitle", "time": 15953.07, "timestamp": "04:25:53", "text": "当然，这里是个热门地点。"}]
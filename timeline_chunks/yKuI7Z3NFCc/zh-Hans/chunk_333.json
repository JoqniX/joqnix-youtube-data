[{"type": "subtitle", "time": 19989.47, "timestamp": "05:33:09", "text": "射出烟雾哦"}, {"type": "subtitle", "time": 19996.12, "timestamp": "05:33:16", "text": "哦 男孩，他太专业了，我跟你说过他"}, {"type": "subtitle", "time": 20015.31, "timestamp": "05:33:35", "text": "不，我不会，我会咬牙切齿，我会去死"}, {"type": "subtitle", "time": 20017.83, "timestamp": "05:33:37", "text": "别引诱它，别死，别死，别死，兄弟。"}, {"type": "subtitle", "time": 20020.67, "timestamp": "05:33:40", "text": "兄弟，它要走了，别这样，我要走了。"}, {"type": "subtitle", "time": 20023.59, "timestamp": "05:33:43", "text": "诱饵，我要咬一口，等等等等"}, {"type": "subtitle", "time": 20026.75, "timestamp": "05:33:46", "text": "我会让你明白，我们必须不惜一切代价赢得胜利。"}, {"type": "subtitle", "time": 20029.75, "timestamp": "05:33:49", "text": "是的，你得让他们看看，我只是想……"}, {"type": "subtitle", "time": 20032.99, "timestamp": "05:33:52", "text": "表明 R 在中间没有任何意义"}]
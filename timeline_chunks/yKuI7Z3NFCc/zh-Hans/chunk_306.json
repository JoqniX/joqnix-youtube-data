[{"type": "subtitle", "time": 18361.11, "timestamp": "05:06:01", "text": "河"}, {"type": "subtitle", "time": 18364.35, "timestamp": "05:06:04", "text": "灵魂，谢谢你，哦，谢谢你买的东西"}, {"type": "subtitle", "time": 18365.868, "timestamp": "05:06:05", "text": "我"}, {"type": "subtitle", "time": 18368.11, "timestamp": "05:06:08", "text": "呃"}, {"type": "subtitle", "time": 18371.91, "timestamp": "05:06:11", "text": "想想，难道我不能拥有你吗？"}, {"type": "subtitle", "time": 18374.19, "timestamp": "05:06:14", "text": "嘿，伙计们，咱们别搞砸了"}, {"type": "subtitle", "time": 18378.59, "timestamp": "05:06:18", "text": "这里有个脚步声，好，好，就给你演示一下。"}, {"type": "subtitle", "time": 18381.43, "timestamp": "05:06:21", "text": "你走吧，然后我们就结束了，就是这样。"}, {"type": "subtitle", "time": 18383.628, "timestamp": "05:06:23", "text": "嗯，等等等等，我会"}, {"type": "subtitle", "time": 18399.788, "timestamp": "05:06:39", "text": "我们哦这堵墙这片区域"}, {"type": "subtitle", "time": 18411.59, "timestamp": "05:06:51", "text": "哦，天哪，他们来了。"}, {"type": "subtitle", "time": 18415.548, "timestamp": "05:06:55", "text": "哎呀，这到底是怎么回事？"}, {"type": "subtitle", "time": 18418.31, "timestamp": "05:06:58", "text": "我们干脆轮流来吧"}]
[{"type": "subtitle", "time": 7743.79, "timestamp": "02:09:03", "text": "就像发生了一件意想不到的事，所以我"}, {"type": "subtitle", "time": 7747.95, "timestamp": "02:09:07", "text": "然后圣和M玩一会儿，好吗？"}, {"type": "subtitle", "time": 7751.95, "timestamp": "02:09:11", "text": "甚至猜猜这是什么"}, {"type": "subtitle", "time": 7754.95, "timestamp": "02:09:14", "text": "全部"}, {"type": "subtitle", "time": 7759.47, "timestamp": "02:09:19", "text": "我们随机排队和我一起参加派对，就像这样"}, {"type": "subtitle", "time": 7762.27, "timestamp": "02:09:22", "text": "敌方队伍，我当时就想：这是什么情况？"}, {"type": "subtitle", "time": 7765.27, "timestamp": "02:09:25", "text": "所以，呃，我"}, {"type": "subtitle", "time": 7767.03, "timestamp": "02:09:27", "text": "米兹"}, {"type": "subtitle", "time": 7771.549, "timestamp": "02:09:31", "text": "而我，就是那天喝果汁的日子，就像我们"}, {"type": "subtitle", "time": 7774.79, "timestamp": "02:09:34", "text": "所有人都惊呼：“我的天哪，那是我和……”"}, {"type": "subtitle", "time": 7777.83, "timestamp": "02:09:37", "text": "比赛进行得……嗯，感觉有点……"}, {"type": "subtitle", "time": 7780.87, "timestamp": "02:09:40", "text": "两者难度相当"}, {"type": "subtitle", "time": 7783.35, "timestamp": "02:09:43", "text": "对，就像，该怎么称呼它呢？它去了"}, {"type": "subtitle", "time": 7787.549, "timestamp": "02:09:47", "text": "比如，12、13、13，是给他们的，他们赢了。"}, {"type": "subtitle", "time": 7791.589, "timestamp": "02:09:51", "text": "但这游戏真好玩，我当时就想：嘿！"}, {"type": "subtitle", "time": 7795.03, "timestamp": "02:09:55", "text": "如果有人杀了我，我就说去给我看看。"}]
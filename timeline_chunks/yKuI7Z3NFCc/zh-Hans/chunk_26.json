[{"type": "subtitle", "time": 1564.149, "timestamp": "00:26:04", "text": "[音乐]"}, {"type": "subtitle", "time": 1566.2, "timestamp": "00:26:06", "text": "这很有意思"}, {"type": "subtitle", "time": 1567.789, "timestamp": "00:26:07", "text": "[音乐]"}, {"type": "subtitle", "time": 1571.269, "timestamp": "00:26:11", "text": "好的，我们能听到。"}, {"type": "subtitle", "time": 1575.07, "timestamp": "00:26:15", "text": "嗨，我们打开看看这个，这是什么？"}, {"type": "subtitle", "time": 1576.63, "timestamp": "00:26:16", "text": "一个"}, {"type": "subtitle", "time": 1579.19, "timestamp": "00:26:19", "text": "壁纸"}, {"type": "subtitle", "time": 1581.669, "timestamp": "00:26:21", "text": "预订另一本"}, {"type": "subtitle", "time": 1585.47, "timestamp": "00:26:25", "text": "书？哦，那是我想的那样吗？哦"}, {"type": "subtitle", "time": 1587.23, "timestamp": "00:26:27", "text": "这是一本涂色书"}, {"type": "subtitle", "time": 1591.23, "timestamp": "00:26:31", "text": "好的，那是香烟还是擦除哦"}, {"type": "subtitle", "time": 1595.47, "timestamp": "00:26:35", "text": "荧光笔，好的，另一本书，另一本"}, {"type": "subtitle", "time": 1598.149, "timestamp": "00:26:38", "text": "预订"}, {"type": "subtitle", "time": 1601.149, "timestamp": "00:26:41", "text": "电视机，你会把电视机放在哪里？"}, {"type": "subtitle", "time": 1603.51, "timestamp": "00:26:43", "text": "哦，这地方"}, {"type": "subtitle", "time": 1610.99, "timestamp": "00:26:50", "text": "浴室而不是厨房"}, {"type": "subtitle", "time": 1613.63, "timestamp": "00:26:53", "text": "你写了“不不不”，它应该结束了。"}]
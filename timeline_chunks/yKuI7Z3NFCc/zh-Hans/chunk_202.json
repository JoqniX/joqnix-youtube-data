[{"type": "subtitle", "time": 12120.309, "timestamp": "03:22:00", "text": "我的头像不是头像个人资料"}, {"type": "subtitle", "time": 12121.59, "timestamp": "03:22:01", "text": "照片和所有东西都给了比利"}, {"type": "subtitle", "time": 12124.15, "timestamp": "03:22:04", "text": "比利慢慢地，如果我能进去的话"}, {"type": "subtitle", "time": 12126.229, "timestamp": "03:22:06", "text": "我想，通过 API 我或许可以做点什么。"}, {"type": "subtitle", "time": 12128.83, "timestamp": "03:22:08", "text": "有些事我不太清楚。"}, {"type": "subtitle", "time": 12136.99, "timestamp": "03:22:16", "text": "呃哦，等等，等等，推特"}, {"type": "subtitle", "time": 12140.03, "timestamp": "03:22:20", "text": "API 今天运行正常。"}, {"type": "subtitle", "time": 12142.75, "timestamp": "03:22:22", "text": "更新横幅，但那是我昨天的事了。"}, {"type": "subtitle", "time": 12144.87, "timestamp": "03:22:24", "text": "我没有制作直播横幅。"}, {"type": "subtitle", "time": 12148.269, "timestamp": "03:22:28", "text": "今天的直播感觉就像是，哦耶，因为"}, {"type": "subtitle", "time": 12151.189, "timestamp": "03:22:31", "text": "ELO Bak正在摆弄API"}, {"type": "subtitle", "time": 12153.55, "timestamp": "03:22:33", "text": "比如对推特进行新的修改"}, {"type": "subtitle", "time": 12159.229, "timestamp": "03:22:39", "text": "内容不会更新，但实际上已经更新了。"}, {"type": "subtitle", "time": 12163.389, "timestamp": "03:22:43", "text": "它确实更新了，我就像"}, {"type": "subtitle", "time": 12167.469, "timestamp": "03:22:47", "text": "她好像没看到这个，确实如此。"}, {"type": "subtitle", "time": 12169.11, "timestamp": "03:22:49", "text": "随时更新"}, {"type": "subtitle", "time": 12173.07, "timestamp": "03:22:53", "text": "你看，它确实更新了生活。"}, {"type": "subtitle", "time": 12175.269, "timestamp": "03:22:55", "text": "显示名称已更改，头像也已更改。"}, {"type": "subtitle", "time": 12176.99, "timestamp": "03:22:56", "text": "更改个人资料图片已更改，"}, {"type": "subtitle", "time": 12179.59, "timestamp": "03:22:59", "text": "这是昨天我没看的那张。"}]
[{"type": "subtitle", "time": 3066.99, "timestamp": "00:51:06", "text": "[音乐]"}, {"type": "subtitle", "time": 3070.23, "timestamp": "00:51:10", "text": "哦，你可以把你的机场隐藏在下面"}, {"type": "subtitle", "time": 3072.42, "timestamp": "00:51:12", "text": "枕头啊我的天哪，那真是太……"}, {"type": "subtitle", "time": 3073.71, "timestamp": "00:51:13", "text": "[音乐]"}, {"type": "subtitle", "time": 3076.069, "timestamp": "00:51:16", "text": "很可爱，但我知道为什么我要把它藏起来。"}, {"type": "subtitle", "time": 3077.309, "timestamp": "00:51:17", "text": "在"}, {"type": "subtitle", "time": 3080.91, "timestamp": "00:51:20", "text": "枕头，因为为什么不呢？因为为什么？"}, {"type": "subtitle", "time": 3085.35, "timestamp": "00:51:25", "text": "不，你好，你好吗？"}]
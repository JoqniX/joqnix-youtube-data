[{"type": "subtitle", "time": 2101.19, "timestamp": "00:35:01", "text": "下面你"}, {"type": "subtitle", "time": 2103.75, "timestamp": "00:35:03", "text": "等等，键盘在哪儿？"}, {"type": "subtitle", "time": 2113.95, "timestamp": "00:35:13", "text": "不，你打不开，没有抽屉。"}, {"type": "subtitle", "time": 2127.47, "timestamp": "00:35:27", "text": "那里，H，你不能留着那把尺子，哦，等等"}, {"type": "subtitle", "time": 2128.63, "timestamp": "00:35:28", "text": "你在那儿等着"}, {"type": "subtitle", "time": 2131.87, "timestamp": "00:35:31", "text": "去哪儿？你把……放哪儿了？哦，你在那儿。"}, {"type": "subtitle", "time": 2135.67, "timestamp": "00:35:35", "text": "安排好了，哦，我忘了我们还有黄色的"}, {"type": "subtitle", "time": 2139.75, "timestamp": "00:35:39", "text": "铅笔可以，没问题。"}, {"type": "subtitle", "time": 2143.23, "timestamp": "00:35:43", "text": "猜猜看，这支牙膏和牙刷……"}, {"type": "subtitle", "time": 2145.23, "timestamp": "00:35:45", "text": "东西会放进去"}, {"type": "subtitle", "time": 2148.63, "timestamp": "00:35:48", "text": "我去的那家餐厅"}, {"type": "subtitle", "time": 2156.39, "timestamp": "00:35:56", "text": "等等，不，如果是我，我会……"}, {"type": "subtitle", "time": 2158.47, "timestamp": "00:35:58", "text": "实际上把它放在附近"}]
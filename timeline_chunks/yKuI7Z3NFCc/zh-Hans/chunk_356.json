[{"type": "subtitle", "time": 21361.59, "timestamp": "05:56:01", "text": "兄弟，控制他们真的很难。"}, {"type": "subtitle", "time": 21365.23, "timestamp": "05:56:05", "text": "别这样，我们走吧，这很容易。"}, {"type": "subtitle", "time": 21367.07, "timestamp": "05:56:07", "text": "很简单"}, {"type": "subtitle", "time": 21369.99, "timestamp": "05:56:09", "text": "轻松获胜"}, {"type": "subtitle", "time": 21385.43, "timestamp": "05:56:25", "text": "哦，等等"}, {"type": "subtitle", "time": 21388.11, "timestamp": "05:56:28", "text": "等等，我是"}, {"type": "subtitle", "time": 21391.43, "timestamp": "05:56:31", "text": "背叛，我会看着，或者天堂就只是"}, {"type": "subtitle", "time": 21399.628, "timestamp": "05:56:39", "text": "哦，天哪，别让他们得逞，别让他们得逞！"}, {"type": "subtitle", "time": 21404.51, "timestamp": "05:56:44", "text": "别种哦，该死哦"}]
[{"type": "subtitle", "time": 22081.99, "timestamp": "06:08:01", "text": "最后一次派克冲锋是因为我们告诉了三个"}, {"type": "subtitle", "time": 22086.59, "timestamp": "06:08:06", "text": "与获胜者相匹配的人获得最有价值球员奖。"}, {"type": "subtitle", "time": 22089.23, "timestamp": "06:08:09", "text": "或者说，在尖峰冲锋中击杀数最多"}, {"type": "subtitle", "time": 22093.59, "timestamp": "06:08:13", "text": "将获得自我宣传"}, {"type": "subtitle", "time": 22105.468, "timestamp": "06:08:25", "text": "所以你们想玩单人模式。"}]
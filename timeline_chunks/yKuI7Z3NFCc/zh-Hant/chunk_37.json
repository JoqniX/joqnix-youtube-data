[{"type": "subtitle", "time": 2222.95, "timestamp": "00:37:02", "text": "刷這個東西，等等，你能"}, {"type": "subtitle", "time": 2226.51, "timestamp": "00:37:06", "text": "打開嗎？不，"}, {"type": "subtitle", "time": 2235.069, "timestamp": "00:37:15", "text": "[音樂]"}, {"type": "subtitle", "time": 2237.069, "timestamp": "00:37:17", "text": "嗯，好吧，你知道嗎，我把"}, {"type": "subtitle", "time": 2251.589, "timestamp": "00:37:31", "text": "這個應該在這裡，對吧？"}, {"type": "subtitle", "time": 2258.47, "timestamp": "00:37:38", "text": "哦，我們有胸罩，這個B罩杯可以套上，不，它"}, {"type": "subtitle", "time": 2262.75, "timestamp": "00:37:42", "text": "沒套好。"}, {"type": "subtitle", "time": 2265.95, "timestamp": "00:37:45", "text": "不，你，你，你要告訴"}, {"type": "subtitle", "time": 2269.87, "timestamp": "00:37:49", "text": "我，還會有更多，同色眉毛。"}, {"type": "subtitle", "time": 2270.95, "timestamp": "00:37:50", "text": "[音樂]"}, {"type": "subtitle", "time": 2275.79, "timestamp": "00:37:55", "text": "嗯，必須，需要，必須，按順序，更多，"}, {"type": "subtitle", "time": 2278.87, "timestamp": "00:37:58", "text": "我就這樣放著，以防萬一我們還有更多東西。"}]
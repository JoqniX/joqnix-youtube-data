[{"type": "subtitle", "time": 733.71, "timestamp": "00:12:13", "text": "實際上在那裡昨天有40個人，我"}, {"type": "subtitle", "time": 734.11, "timestamp": "00:12:14", "text": "不"}, {"type": "subtitle", "time": 742.59, "timestamp": "00:12:22", "text": "記得總共有多少觀眾了，我本來"}, {"type": "subtitle", "time": 746.069, "timestamp": "00:12:26", "text": "就想出來，"}, {"type": "subtitle", "time": 753.31, "timestamp": "00:12:33", "text": "我應該不太乾這些所以有點問題，但請我喝杯"}]
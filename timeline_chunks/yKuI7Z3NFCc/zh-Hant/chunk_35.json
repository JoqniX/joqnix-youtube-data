[{"type": "subtitle", "time": 2101.19, "timestamp": "00:35:01", "text": "下面，"}, {"type": "subtitle", "time": 2103.75, "timestamp": "00:35:03", "text": "所以等等，鍵盤在哪裡？這是鍵盤嗎？"}, {"type": "subtitle", "time": 2113.95, "timestamp": "00:35:13", "text": "沒有抽屜之類的。"}, {"type": "subtitle", "time": 2131.87, "timestamp": "00:35:31", "text": "哦，放在那裡，"}, {"type": "subtitle", "time": 2135.67, "timestamp": "00:35:35", "text": "整理好了。哦，我忘了，我們有一支黃色"}, {"type": "subtitle", "time": 2139.75, "timestamp": "00:35:39", "text": "鉛筆。好吧，我想應該沒問題。"}, {"type": "subtitle", "time": 2143.23, "timestamp": "00:35:43", "text": "所以這些牙膏、牙刷之類的"}, {"type": "subtitle", "time": 2145.23, "timestamp": "00:35:45", "text": "東西要放在"}, {"type": "subtitle", "time": 2148.63, "timestamp": "00:35:48", "text": "餐具櫃裡，我想。"}, {"type": "subtitle", "time": 2156.39, "timestamp": "00:35:56", "text": "等等，不，如果是我，我會把"}, {"type": "subtitle", "time": 2158.47, "timestamp": "00:35:58", "text": "它放在附近，"}]
[{"type": "subtitle", "time": 1628.35, "timestamp": "00:27:08", "text": "滑鼠"}, {"type": "subtitle", "time": 1633.75, "timestamp": "00:27:13", "text": "墊，滑鼠就放這兒。這個要放在床上。糟糕糟糕糟糕糟糕。呃，你都要"}, {"type": "subtitle", "time": 1636.23, "timestamp": "00:27:16", "text": "放這裡。是的，應該有空間，對吧？是的，應該有空間。"}, {"type": "subtitle", "time": 1642.07, "timestamp": "00:27:22", "text": "另一個"}, {"type": "subtitle", "time": 1646.07, "timestamp": "00:27:26", "text": "盒子，一個袋子。我的"}, {"type": "subtitle", "time": 1651.11, "timestamp": "00:27:31", "text": "[音樂]包放哪裡？哦，應該有空間。這是什麼？哦，iPod之類的。"}, {"type": "subtitle", "time": 1656.269, "timestamp": "00:27:36", "text": "我把"}, {"type": "subtitle", "time": 1660.029, "timestamp": "00:27:40", "text": "它放在"}, {"type": "subtitle", "time": 1666.63, "timestamp": "00:27:46", "text": "床邊。"}, {"type": "subtitle", "time": 1674.789, "timestamp": "00:27:54", "text": "哦，我們有一條裙子，把它放那兒。還有另一件衣服，一些玩具，一些"}]
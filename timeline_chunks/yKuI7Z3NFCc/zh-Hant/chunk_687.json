[{"type": "subtitle", "time": 41226.99, "timestamp": "11:27:06", "text": "迷路了嗎？"}, {"type": "subtitle", "time": 41262.19, "timestamp": "11:27:42", "text": "迷路了，喔不，我迷路了，我真的迷路了，我該去哪裡？好吧，這邊，請告訴我這是正確的方向。不，我要走了，我迷路了，我要死了，我真的"}, {"type": "subtitle", "time": 41277.87, "timestamp": "11:27:57", "text": "迷路了。"}]
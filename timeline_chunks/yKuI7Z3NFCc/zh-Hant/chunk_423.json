[{"type": "subtitle", "time": 25392.548, "timestamp": "07:03:12", "text": "我想做個準備談話。我今天在我的B裡準備了一個準備談話之類的東西，我想，是的，我會的。吃完晚餐後，我會私訊我，告訴他我想說些什麼，趁大家都在的時候，嗯，"}, {"type": "subtitle", "time": 25398.83, "timestamp": "07:03:18", "text": "我會確保大家不要太認真，他們只是享受，放鬆，放鬆，一起盡力而為，"}, {"type": "subtitle", "time": 25410.03, "timestamp": "07:03:30", "text": "這就是我想的。"}, {"type": "subtitle", "time": 25424.23, "timestamp": "07:03:44", "text": "我想我會的，"}]
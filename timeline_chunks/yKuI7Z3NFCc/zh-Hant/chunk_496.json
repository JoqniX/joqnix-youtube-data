[{"type": "subtitle", "time": 29776.628, "timestamp": "08:16:16", "text": "我想砰砰砰，我希望砰砰砰，他走了，兄弟，因為我穿著我的皮膚，"}, {"type": "subtitle", "time": 29785.27, "timestamp": "08:16:25", "text": "我又玩完了一局，生活很糟糕，現在的生活有時對你很殘酷，有時確實對你很殘酷，就是這樣，"}, {"type": "subtitle", "time": 29792.83, "timestamp": "08:16:32", "text": "我想這就是生活。 ["}, {"type": "subtitle", "time": 29805.27, "timestamp": "08:16:45", "text": "音樂]是的，我發錯"}]
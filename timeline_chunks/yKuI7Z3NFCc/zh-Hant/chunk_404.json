[{"type": "subtitle", "time": 24262.628, "timestamp": "06:44:22", "text": "我不能做Asad了，呃，因為我要去上駕駛課，還有，呃，我不知道"}, {"type": "subtitle", "time": 24270.99, "timestamp": "06:44:30", "text": "我有沒有告訴過你們，但顯然我需要更新我的駕照，因為它過期了，我需要更新我的駕照，因為它需要過期了，所以我需要參加考試，但嗯。我已經很久沒玩過《新世界》或《"}, {"type": "subtitle", "time": 24274.11, "timestamp": "06:44:34", "text": "空洞之"}, {"type": "subtitle", "time": 24276.948, "timestamp": "06:44:36", "text": "夜》了，對吧？我也想"}, {"type": "subtitle", "time": 24282.788, "timestamp": "06:44:42", "text": "玩玩這些遊戲。"}]
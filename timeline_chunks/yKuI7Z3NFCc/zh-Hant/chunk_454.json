[{"type": "subtitle", "time": 27269.868, "timestamp": "07:34:29", "text": "載入？關卡啟動了？走吧，你不知道soap嗎？我聽過soap，但我忘了。對不起，Jo，我聽說過商店。"}, {"type": "subtitle", "time": 27272.91, "timestamp": "07:34:32", "text": "我確實了解了一些關於呃的東西。 H，那是有人在看。喔"}, {"type": "subtitle", "time": 27280.99, "timestamp": "07:34:40", "text": "我的天啊，不不不，"}, {"type": "subtitle", "time": 27288.468, "timestamp": "07:34:48", "text": "我不小心點到了！我該怎麼做？我該怎麼做？我該怎麼改？我該怎麼改？我該怎麼改？必須重生！"}]
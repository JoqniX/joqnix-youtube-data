[{"type": "subtitle", "time": 23763.23, "timestamp": "06:36:03", "text": "知道。希望你們能在Economia聯機，畢竟"}, {"type": "subtitle", "time": 23767.43, "timestamp": "06:36:07", "text": "這是個任務。嗯，希望我們能一起玩，"}, {"type": "subtitle", "time": 23778.83, "timestamp": "06:36:18", "text": "所有的擁抱和摸頭！等等，我"}, {"type": "subtitle", "time": 23787.27, "timestamp": "06:36:27", "text": "是，我確實會看私"}, {"type": "subtitle", "time": 23790.548, "timestamp": "06:36:30", "text": "訊，但我總是忘記。我"}, {"type": "subtitle", "time": 23794.388, "timestamp": "06:36:34", "text": "心裡想著“哦，我一會兒就回复”，因為我在忙別的事情，然後……然後……"}, {"type": "subtitle", "time": 23798.11, "timestamp": "06:36:38", "text": "我就累了，然後就睡著了，"}, {"type": "subtitle", "time": 23805.15, "timestamp": "06:36:45", "text": "或者趴在我的蠟燭上睡著了，然後我就想“哦，我剛才在幹嘛來著？”，"}, {"type": "subtitle", "time": 23812.948, "timestamp": "06:36:52", "text": "然後……當對方"}, {"type": "subtitle", "time": 23816.43, "timestamp": "06:36:56", "text": "再次回覆時，我才想「哈，我"}, {"type": "subtitle", "time": 23819.11, "timestamp": "06:36:59", "text": "沒回覆嗎？」啊，這就是我"}]
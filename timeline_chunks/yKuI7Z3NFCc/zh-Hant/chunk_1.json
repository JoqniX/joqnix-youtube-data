[{"type": "subtitle", "time": 61.509, "timestamp": "00:01:01", "text": "睡眠不足，我整晚都沒睡，天哪，天哪，"}, {"type": "subtitle", "time": 73.749, "timestamp": "00:01:13", "text": "渾身都"}, {"type": "subtitle", "time": 88.749, "timestamp": "00:01:28", "text": "眼睛，我，我"}, {"type": "subtitle", "time": 91.31, "timestamp": "00:01:31", "text": "現在喜歡這樣，不是普遍意義上的，因為我不"}]
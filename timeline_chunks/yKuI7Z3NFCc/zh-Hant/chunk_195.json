[{"type": "subtitle", "time": 11715.59, "timestamp": "03:15:15", "text": "我不知道我到底直播了多少次，反正Twitch上也看不到。嗯，我主要想做的是讓我的YouTube粉絲群和Twitch粉絲群保持同步。嗯，我通常不太在意這些數字，但我不知道我"}, {"type": "subtitle", "time": 11717.59, "timestamp": "03:15:17", "text": "現在在YouTube上有多少粉絲，但"}, {"type": "subtitle", "time": 11720.95, "timestamp": "03:15:20", "text": "Twitch的"}, {"type": "subtitle", "time": 11724.51, "timestamp": "03:15:24", "text": "直播回顧顯示我有463個粉絲。所以，如果我"}, {"type": "subtitle", "time": 11728.269, "timestamp": "03:15:28", "text": "在Twitch上有463個粉絲，那我也想讓我在"}, {"type": "subtitle", "time": 11731.67, "timestamp": "03:15:31", "text": "YouTube上達到同樣的數字。"}, {"type": "subtitle", "time": 11733.51, "timestamp": "03:15:33", "text": "為什麼"}, {"type": "subtitle", "time": 11735.07, "timestamp": "03:15:35", "text": "不呢？"}, {"type": "subtitle", "time": 11739.91, "timestamp": "03:15:39", "text": "即使Twitch是我的第一個平台，"}, {"type": "subtitle", "time": 11746.389, "timestamp": "03:15:46", "text": "我在那裡開始直播，"}, {"type": "subtitle", "time": 11750.189, "timestamp": "03:15:50", "text": "積累經驗等等，但是"}, {"type": "subtitle", "time": 11753.55, "timestamp": "03:15:53", "text": "我想讓這兩個平台的粉絲數量達到"}, {"type": "subtitle", "time": 11756.55, "timestamp": "03:15:56", "text": "平衡，而不是……就像"}]
[{"type": "subtitle", "time": 1920.31, "timestamp": "00:32:00", "text": "我是個遊戲玩家，對吧？"}, {"type": "subtitle", "time": 1922.19, "timestamp": "00:32:02", "text": "4會是個"}, {"type": "subtitle", "time": 1927.029, "timestamp": "00:32:07", "text": "遊戲玩家，我還會帶著我的那邊有霓虹燈，"}, {"type": "subtitle", "time": 1931.35, "timestamp": "00:32:11", "text": "[音樂]"}, {"type": "subtitle", "time": 1934.59, "timestamp": "00:32:14", "text": "小，這是什麼？哦，是我的畫冊，還是"}, {"type": "subtitle", "time": 1937.59, "timestamp": "00:32:17", "text": "一些教科書之類的，又"}, {"type": "subtitle", "time": 1939.389, "timestamp": "00:32:19", "text": "大又大……哦，天哪，又是"}, {"type": "subtitle", "time": 1942.47, "timestamp": "00:32:22", "text": "內衣，我沒"}, {"type": "subtitle", "time": 1946.029, "timestamp": "00:32:26", "text": "地方放了……哦，"}, {"type": "subtitle", "time": 1952.75, "timestamp": "00:32:32", "text": "你知道嗎？嗯，你知道嗎？還有辦法，你知道嗎？怎麼"}, {"type": "chat", "time": 1953.951, "timestamp": "00:32:33", "author": "@juliemargaux-s6q", "avatar": "https://yt4.ggpht.com/mIIcXbvQEpGC6DwR0BAy6rSPCqrwgMmef3bgRj8v32t9kajE-isAsRuyOUDjQL35Lh5jYRaBqQ=s64-c-k-c0x00ffffff-no-rj", "message": "halloo are u streaming in twitch or something :DD?"}, {"type": "subtitle", "time": 1957.05, "timestamp": "00:32:37", "text": "處理這些才合適？"}, {"type": "subtitle", "time": 1963.83, "timestamp": "00:32:43", "text": "拿出來…"}, {"type": "subtitle", "time": 1967.99, "timestamp": "00:32:47", "text": "嗯，如果我要整理東西，我會"}, {"type": "subtitle", "time": 1972.269, "timestamp": "00:32:52", "text": "留一個放胸罩之類的，"}, {"type": "subtitle", "time": 1976.31, "timestamp": "00:32:56", "text": "另一個放內褲之類的。"}]
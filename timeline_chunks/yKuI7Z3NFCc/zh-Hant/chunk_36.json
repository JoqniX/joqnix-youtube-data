[{"type": "subtitle", "time": 2161.309, "timestamp": "00:36:01", "text": "我想。"}, {"type": "subtitle", "time": 2163.829, "timestamp": "00:36:03", "text": "你好，除了YouTube，還在哪裡直播？"}, {"type": "subtitle", "time": 2167.069, "timestamp": "00:36:07", "text": "呃，Twitch。說到Twitch，我"}, {"type": "subtitle", "time": 2169.589, "timestamp": "00:36:09", "text": "還沒在那裡直播過，夥計，我沒有"}, {"type": "subtitle", "time": 2172.51, "timestamp": "00:36:12", "text": "早起，我睡著了。我想……今天早上我又睡了，"}, {"type": "subtitle", "time": 2174.309, "timestamp": "00:36:14", "text": "八點才睡，真"}, {"type": "subtitle", "time": 2179.069, "timestamp": "00:36:19", "text": "不知道該怎麼辦。我不知道該幹什麼，"}, {"type": "subtitle", "time": 2184.109, "timestamp": "00:36:24", "text": "[音樂]"}, {"type": "subtitle", "time": 2202.63, "timestamp": "00:36:42", "text": "鞋子，"}, {"type": "subtitle", "time": 2208.069, "timestamp": "00:36:48", "text": "好吧，我們有Tobels，我們去拿。肥皂，"}, {"type": "subtitle", "time": 2214.19, "timestamp": "00:36:54", "text": "杯子，這是什麼？"}, {"type": "subtitle", "time": 2216.37, "timestamp": "00:36:56", "text": "漱口水，除臭劑。 [音樂]"}]
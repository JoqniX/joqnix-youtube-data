[{"type": "subtitle", "time": 733.71, "timestamp": "00:12:13", "text": "昨日、本当に40人もいたの？"}, {"type": "subtitle", "time": 734.11, "timestamp": "00:12:14", "text": "しないで"}, {"type": "subtitle", "time": 742.59, "timestamp": "00:12:22", "text": "視聴者の総数を覚えておいてください"}, {"type": "subtitle", "time": 746.069, "timestamp": "00:12:26", "text": "なぜ私は"}, {"type": "subtitle", "time": 750.829, "timestamp": "00:12:30", "text": "数字を声に出して言うなんて、一体どういうことだ"}, {"type": "subtitle", "time": 753.31, "timestamp": "00:12:33", "text": "これらのことはあまり気にしなくていいと思う"}]
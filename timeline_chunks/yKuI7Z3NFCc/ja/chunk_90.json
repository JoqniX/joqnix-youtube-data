[{"type": "subtitle", "time": 5402.31, "timestamp": "01:30:02", "text": "うん、薬と包帯もいいですね"}, {"type": "subtitle", "time": 5403.7, "timestamp": "01:30:03", "text": "中に入る"}, {"type": "subtitle", "time": 5414.51, "timestamp": "01:30:14", "text": "神よ、何が"}, {"type": "subtitle", "time": 5421.75, "timestamp": "01:30:21", "text": "救急キット、あ、待って、薬はどこに置いたっけ？"}, {"type": "subtitle", "time": 5424.55, "timestamp": "01:30:24", "text": "キット"}, {"type": "subtitle", "time": 5438.95, "timestamp": "01:30:38", "text": "行って、この場所も完成しました"}, {"type": "subtitle", "time": 5442.23, "timestamp": "01:30:42", "text": "今この場所"}, {"type": "subtitle", "time": 5445.189, "timestamp": "01:30:45", "text": "[音楽]"}, {"type": "subtitle", "time": 5448.99, "timestamp": "01:30:48", "text": "そうですね、これは賞か何かですね。"}, {"type": "subtitle", "time": 5452.87, "timestamp": "01:30:52", "text": "だからここに置いておくのはうまくいかない"}]
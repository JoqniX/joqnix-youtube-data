[{"type": "subtitle", "time": 2640.27, "timestamp": "00:44:00", "text": "それで"}, {"type": "subtitle", "time": 2645.27, "timestamp": "00:44:05", "text": "待って、この人たち全員を"}, {"type": "subtitle", "time": 2647.69, "timestamp": "00:44:07", "text": "ここから行くことができます"}, {"type": "subtitle", "time": 2654.47, "timestamp": "00:44:14", "text": "[音楽]"}, {"type": "subtitle", "time": 2664.91, "timestamp": "00:44:24", "text": "焦げ付かないものを待って、"}, {"type": "subtitle", "time": 2668.63, "timestamp": "00:44:28", "text": "光って、高いのは何？待って、私は"}, {"type": "subtitle", "time": 2670.51, "timestamp": "00:44:30", "text": "しないで"}, {"type": "subtitle", "time": 2672.91, "timestamp": "00:44:32", "text": "知る"}, {"type": "subtitle", "time": 2675.19, "timestamp": "00:44:35", "text": "ああ、わかった、もし私が"}, {"type": "subtitle", "time": 2678.23, "timestamp": "00:44:38", "text": "正しいです。えっと、私は何なのかわかりません"}, {"type": "subtitle", "time": 2682.589, "timestamp": "00:44:42", "text": "これはそうですが、私たちは"}, {"type": "subtitle", "time": 2686.309, "timestamp": "00:44:46", "text": "これは"}, {"type": "subtitle", "time": 2689.549, "timestamp": "00:44:49", "text": "石鹸"}, {"type": "subtitle", "time": 2694.99, "timestamp": "00:44:54", "text": "これは洗濯物になります"}, {"type": "subtitle", "time": 2698.109, "timestamp": "00:44:58", "text": "これが何なのか分からないもの"}, {"type": "subtitle", "time": 2699.91, "timestamp": "00:44:59", "text": "これは"}]
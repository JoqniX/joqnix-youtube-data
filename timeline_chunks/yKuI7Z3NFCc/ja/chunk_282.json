[{"type": "subtitle", "time": 16922.628, "timestamp": "04:42:02", "text": "Apexなので、もっとApexをプレイしてみようと思います"}, {"type": "subtitle", "time": 16925.19, "timestamp": "04:42:05", "text": "今後はインストール済みなので"}, {"type": "subtitle", "time": 16928.27, "timestamp": "04:42:08", "text": "私のPCではこのゲームをプレイしたことすらありません"}, {"type": "subtitle", "time": 16930.91, "timestamp": "04:42:10", "text": "しばらく使ってたけど、楽しかったよ。"}, {"type": "subtitle", "time": 16934.27, "timestamp": "04:42:14", "text": "しばらくしてから試してみるつもりなので"}, {"type": "subtitle", "time": 16937.43, "timestamp": "04:42:17", "text": "Apexのゲームをプレイします"}, {"type": "subtitle", "time": 16940.99, "timestamp": "04:42:20", "text": "将来の配信なので、こんにちは、そして、これ"}, {"type": "subtitle", "time": 16944.47, "timestamp": "04:42:24", "text": "土曜日、そして土曜日だと思うのですが"}, {"type": "subtitle", "time": 16947.55, "timestamp": "04:42:27", "text": "VRチャットをストリーミング配信してみようかな"}, {"type": "subtitle", "time": 16950.59, "timestamp": "04:42:30", "text": "えーと、言語交換イベント、えーと、英語"}, {"type": "subtitle", "time": 16952.99, "timestamp": "04:42:32", "text": "日本語 そして日曜日も"}, {"type": "subtitle", "time": 16956.628, "timestamp": "04:42:36", "text": "ええと、午前9時30分頃です。"}, {"type": "subtitle", "time": 16961.51, "timestamp": "04:42:41", "text": "土曜日と日曜日は4時か5時30分です。"}, {"type": "subtitle", "time": 16964.83, "timestamp": "04:42:44", "text": "午後うん、前回の配信はチャットで"}, {"type": "subtitle", "time": 16967.35, "timestamp": "04:42:47", "text": "ちょうどその頃だったので、試してみます"}, {"type": "subtitle", "time": 16970.67, "timestamp": "04:42:50", "text": "日曜日に出席するのが一番良い"}, {"type": "subtitle", "time": 16972.948, "timestamp": "04:42:52", "text": "もし私が出席できない場合"}, {"type": "subtitle", "time": 16975.67, "timestamp": "04:42:55", "text": "土曜日は大丈夫です、少なくとも"}, {"type": "subtitle", "time": 16979.868, "timestamp": "04:42:59", "text": "日曜日が来たら、私は"}]
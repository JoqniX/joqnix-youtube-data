[{"type": "subtitle", "time": 19621.11, "timestamp": "05:27:01", "text": "5つの未評価のものをやるつもりだ、ちょっと待って"}, {"type": "subtitle", "time": 19624.15, "timestamp": "05:27:04", "text": "待って5は多すぎる5は多すぎる"}, {"type": "subtitle", "time": 19627.788, "timestamp": "05:27:07", "text": "私たちが4勝して、あなたが2勝した場合、それはできません。"}, {"type": "subtitle", "time": 19629.83, "timestamp": "05:27:09", "text": "彼らが勝つとしましょう、マックス、これは"}, {"type": "subtitle", "time": 19631.27, "timestamp": "05:27:11", "text": "ウォーミングアップ"}, {"type": "subtitle", "time": 19633.51, "timestamp": "05:27:13", "text": "マッチ オーケーオーケーこれはただ"}, {"type": "subtitle", "time": 19635.628, "timestamp": "05:27:15", "text": "ウォーミングアップ MCH うん、プレイしよう バインドしよう"}, {"type": "subtitle", "time": 19638.11, "timestamp": "05:27:18", "text": "プレイバインド最後の彼らはそうは思わない"}, {"type": "subtitle", "time": 19640.628, "timestamp": "05:27:20", "text": "彼らは同意するつもりだ"}, {"type": "subtitle", "time": 19642.868, "timestamp": "05:27:22", "text": "それは1つのチームだけではできない"}, {"type": "subtitle", "time": 19644.47, "timestamp": "05:27:24", "text": "これは数えないでください"}, {"type": "subtitle", "time": 19647.67, "timestamp": "05:27:27", "text": "ああ、スパイク、1試合できるよ"}, {"type": "subtitle", "time": 19678.23, "timestamp": "05:27:58", "text": "えーと"}]
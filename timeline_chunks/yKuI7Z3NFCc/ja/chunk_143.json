[{"type": "subtitle", "time": 8581.95, "timestamp": "02:23:01", "text": "そうだ、上に置いてもいいよ"}, {"type": "subtitle", "time": 8583.51, "timestamp": "02:23:03", "text": "それは良いことだ"}, {"type": "subtitle", "time": 8589.19, "timestamp": "02:23:09", "text": "いいよ、これら全部、いや、私たちは"}, {"type": "subtitle", "time": 8595.59, "timestamp": "02:23:15", "text": "うーん、大きい"}, {"type": "subtitle", "time": 8609.63, "timestamp": "02:23:29", "text": "M ああ、ヨーヨーだ、待って、ヨーヨーだけど"}, {"type": "subtitle", "time": 8621.67, "timestamp": "02:23:41", "text": "[音楽]"}, {"type": "subtitle", "time": 8630.23, "timestamp": "02:23:50", "text": "えっと、本はどこにあるのか混乱しています"}, {"type": "subtitle", "time": 8637.79, "timestamp": "02:23:57", "text": "それを何に載せられるか知ってるよ"}]
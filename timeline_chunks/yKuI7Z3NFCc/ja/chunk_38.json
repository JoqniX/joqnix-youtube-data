[{"type": "subtitle", "time": 2284.87, "timestamp": "00:38:04", "text": "もし私たちがもっと物を手に入れたら、それは"}, {"type": "subtitle", "time": 2287.39, "timestamp": "00:38:07", "text": "これは"}, {"type": "subtitle", "time": 2289.15, "timestamp": "00:38:09", "text": "これ"}, {"type": "subtitle", "time": 2292.27, "timestamp": "00:38:12", "text": "チョーク"}, {"type": "subtitle", "time": 2296.109, "timestamp": "00:38:16", "text": "別の詩用紙または予備のトイレットペーパー"}, {"type": "subtitle", "time": 2301.75, "timestamp": "00:38:21", "text": "入れることができると思います"}, {"type": "subtitle", "time": 2304.589, "timestamp": "00:38:24", "text": "ああ"}, {"type": "subtitle", "time": 2308.069, "timestamp": "00:38:28", "text": "タオルって、おむつ？今はわからない"}, {"type": "subtitle", "time": 2319.67, "timestamp": "00:38:39", "text": "これは、ああ、あれは大丈夫か、大丈夫、私は"}, {"type": "subtitle", "time": 2322.829, "timestamp": "00:38:42", "text": "それが何だったのか理解しました。これは"}, {"type": "subtitle", "time": 2330.99, "timestamp": "00:38:50", "text": "火をつければ、これは"}]
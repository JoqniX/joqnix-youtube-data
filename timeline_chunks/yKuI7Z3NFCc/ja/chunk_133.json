[{"type": "subtitle", "time": 7988.709, "timestamp": "02:13:08", "text": "うん、こんにちはスカイ、うん、こんにちは、こんにちは、元気？"}, {"type": "subtitle", "time": 7992.35, "timestamp": "02:13:12", "text": "ああ、冷蔵庫に貼ってもいいですよ"}, {"type": "subtitle", "time": 7998.91, "timestamp": "02:13:18", "text": "冷蔵庫"}, {"type": "subtitle", "time": 8001.589, "timestamp": "02:13:21", "text": "ああ、FRに載せてもいいよ、私は載せなかったけど"}, {"type": "subtitle", "time": 8002.53, "timestamp": "02:13:22", "text": "知る"}, {"type": "subtitle", "time": 8004.43, "timestamp": "02:13:24", "text": "[音楽]"}, {"type": "subtitle", "time": 8006.669, "timestamp": "02:13:26", "text": "それ"}, {"type": "subtitle", "time": 8020.37, "timestamp": "02:13:40", "text": "クール、待って待って"}, {"type": "subtitle", "time": 8021.629, "timestamp": "02:13:41", "text": "[音楽]"}, {"type": "subtitle", "time": 8025.109, "timestamp": "02:13:45", "text": "待って、そしてこれはあなたの"}, {"type": "subtitle", "time": 8027.51, "timestamp": "02:13:47", "text": "初めてここに来ました。あなたも初めてだと思います。"}, {"type": "subtitle", "time": 8030.549, "timestamp": "02:13:50", "text": "スカイ、今頃どうしてる？私を見つけたの？"}, {"type": "subtitle", "time": 8038.669, "timestamp": "02:13:58", "text": "うん、初めてだね。うん、そうだね。"}]
[{"type": "subtitle", "time": 9302.07, "timestamp": "02:35:02", "text": "散らかるだろうけど、物を置くつもりだ"}, {"type": "subtitle", "time": 9305.469, "timestamp": "02:35:05", "text": "他の部屋にも"}, {"type": "subtitle", "time": 9309.63, "timestamp": "02:35:09", "text": "もうすぐ、1部屋が終わったので、次のアイデアは"}, {"type": "subtitle", "time": 9312.03, "timestamp": "02:35:12", "text": "えっと、全部終わらせて、"}, {"type": "subtitle", "time": 9315.469, "timestamp": "02:35:15", "text": "それか、そうだな、ランダムに"}, {"type": "subtitle", "time": 9316.269, "timestamp": "02:35:16", "text": "する"}, {"type": "subtitle", "time": 9320.469, "timestamp": "02:35:20", "text": "これはすごい、ああ神様、待って、何？"}, {"type": "subtitle", "time": 9321.83, "timestamp": "02:35:21", "text": "これは"}, {"type": "subtitle", "time": 9324.51, "timestamp": "02:35:24", "text": "いいね"}, {"type": "subtitle", "time": 9328.75, "timestamp": "02:35:28", "text": "ああ、じゃあ一番下の席に行こう"}, {"type": "subtitle", "time": 9329.83, "timestamp": "02:35:29", "text": "1"}, {"type": "subtitle", "time": 9331.79, "timestamp": "02:35:31", "text": "本"}, {"type": "subtitle", "time": 9333.59, "timestamp": "02:35:33", "text": "黄色"}, {"type": "subtitle", "time": 9340.07, "timestamp": "02:35:40", "text": "[音楽]"}, {"type": "subtitle", "time": 9350.07, "timestamp": "02:35:50", "text": "物 h"}]
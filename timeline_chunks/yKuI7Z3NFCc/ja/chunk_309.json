[{"type": "subtitle", "time": 18543.19, "timestamp": "05:09:03", "text": "B 行く時間だ B わかった、わかった、はいはい"}, {"type": "subtitle", "time": 18545.99, "timestamp": "05:09:05", "text": "持っているが、今回はその地域からではない"}, {"type": "subtitle", "time": 18548.15, "timestamp": "05:09:08", "text": "賢者の壁"}, {"type": "subtitle", "time": 18551.07, "timestamp": "05:09:11", "text": "そこで私は私はクリアします"}, {"type": "subtitle", "time": 18553.628, "timestamp": "05:09:13", "text": "C 長いドントをクリアします"}, {"type": "subtitle", "time": 18556.51, "timestamp": "05:09:16", "text": "心配する必要はないと思う。まだ解決できると思う。"}, {"type": "subtitle", "time": 18562.39, "timestamp": "05:09:22", "text": "誰か私にこれを買ってくれないか？"}, {"type": "subtitle", "time": 18566.07, "timestamp": "05:09:26", "text": "うん、ああ、ただ"}, {"type": "subtitle", "time": 18568.868, "timestamp": "05:09:28", "text": "知ってるよ"}, {"type": "subtitle", "time": 18573.39, "timestamp": "05:09:33", "text": "待って、戻って、戻って、あなたはしなければならない"}, {"type": "subtitle", "time": 18575.07, "timestamp": "05:09:35", "text": "選んで待って待って待って待って行かないで"}, {"type": "subtitle", "time": 18584.99, "timestamp": "05:09:44", "text": "待っていれば彼らが来る"}, {"type": "subtitle", "time": 18590.868, "timestamp": "05:09:50", "text": "ジョの後ろへ行って行って、後ろへ行って"}, {"type": "chat", "time": 18595.33, "timestamp": "05:09:55", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "I wonder of lurk works on everyone"}]
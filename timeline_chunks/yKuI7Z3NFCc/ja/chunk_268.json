[{"type": "subtitle", "time": 16086.71, "timestamp": "04:28:06", "text": "銃 シングル エネルギー 推進 ラッハー a"}, {"type": "subtitle", "time": 16093.469, "timestamp": "04:28:13", "text": "ランチャーは"}, {"type": "subtitle", "time": 16096.229, "timestamp": "04:28:16", "text": "ウェイターショー"}, {"type": "subtitle", "time": 16108.99, "timestamp": "04:28:28", "text": "ああ、そうそう、無料のスキャンはありましたか？"}, {"type": "subtitle", "time": 16111.07, "timestamp": "04:28:31", "text": "このゲームをプレイしなくなったとき"}, {"type": "subtitle", "time": 16117.07, "timestamp": "04:28:37", "text": "このゲームで、この平らな肌を手に入れることができました"}]
[{"type": "subtitle", "time": 16983.59, "timestamp": "04:43:03", "text": "毎週のチャットイベント参加"}, {"type": "subtitle", "time": 16985.948, "timestamp": "04:43:05", "text": "ストリーミング配信もしたいです。上達したいので。"}, {"type": "subtitle", "time": 16989.83, "timestamp": "04:43:09", "text": "日本語の試験が近づいてきて、えっと"}, {"type": "subtitle", "time": 16992.11, "timestamp": "04:43:12", "text": "前回の配信から、もしあなたが知っているなら、私は"}, {"type": "subtitle", "time": 16995.15, "timestamp": "04:43:15", "text": "学校に選ばれました"}, {"type": "subtitle", "time": 16998.788, "timestamp": "04:43:18", "text": "インタビューを受けたので、私のTwitterをチェックしてみてください"}, {"type": "subtitle", "time": 17000.91, "timestamp": "04:43:20", "text": "サブアカウントであり、メインアカウントではない"}, {"type": "subtitle", "time": 17004.35, "timestamp": "04:43:24", "text": "私がどこへ行くのか、あなたは知っているかもしれないので"}, {"type": "subtitle", "time": 17006.27, "timestamp": "04:43:26", "text": "うん、そうだよ"}, {"type": "subtitle", "time": 17009.11, "timestamp": "04:43:29", "text": "ワクワクしてる、うまくいってるけど、試験"}, {"type": "subtitle", "time": 17012.51, "timestamp": "04:43:32", "text": "16日に、ベストを尽くさなければならないし"}, {"type": "subtitle", "time": 17015.788, "timestamp": "04:43:35", "text": "また、バレンタイン配信は"}, {"type": "subtitle", "time": 17018.948, "timestamp": "04:43:38", "text": "13日、私の記憶が正しければ、13日にやります。"}, {"type": "subtitle", "time": 17021.628, "timestamp": "04:43:41", "text": "14日は旅行中なので"}, {"type": "subtitle", "time": 17024.55, "timestamp": "04:43:44", "text": "16日に試験を受けなければならないので、"}, {"type": "subtitle", "time": 17029.39, "timestamp": "04:43:49", "text": "別の州へ旅行するため、そうですね"}, {"type": "subtitle", "time": 17032.03, "timestamp": "04:43:52", "text": "うーん、昏睡状態、そして楽しみにしています"}, {"type": "subtitle", "time": 17034.91, "timestamp": "04:43:54", "text": "バレンタイン配信では楽しい配信をします"}, {"type": "subtitle", "time": 17037.91, "timestamp": "04:43:57", "text": "一緒にこんにちは。以上です。ありがとうございました。"}]
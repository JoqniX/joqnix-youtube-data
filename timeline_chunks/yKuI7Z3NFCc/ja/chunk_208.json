[{"type": "subtitle", "time": 12481.71, "timestamp": "03:28:01", "text": "Familiaをクリックするとイベントが表示されます"}, {"type": "subtitle", "time": 12483.67, "timestamp": "03:28:03", "text": "アナウンスをクリックする 1回クリックする"}, {"type": "subtitle", "time": 12486.189, "timestamp": "03:28:06", "text": "一度クリックすると、"}, {"type": "subtitle", "time": 12490.79, "timestamp": "03:28:10", "text": "転がすと、転がるのを知っている"}, {"type": "subtitle", "time": 12493.83, "timestamp": "03:28:13", "text": "メニューマップみたいなのは"}, {"type": "subtitle", "time": 12496.99, "timestamp": "03:28:16", "text": "難しいからアクセスできるようになる"}, {"type": "subtitle", "time": 12499.83, "timestamp": "03:28:19", "text": "より簡単な方法、つまり古い方法"}, {"type": "subtitle", "time": 12502.91, "timestamp": "03:28:22", "text": "かつては役割を得る方法"}, {"type": "subtitle", "time": 12505.349, "timestamp": "03:28:25", "text": "そこには反応ロールがあり、"}, {"type": "subtitle", "time": 12508.11, "timestamp": "03:28:28", "text": "えーと、これはあなたが反応するようなもの"}, {"type": "subtitle", "time": 12510.79, "timestamp": "03:28:30", "text": "終わるロール"}, {"type": "subtitle", "time": 12512.75, "timestamp": "03:28:32", "text": "ここ"}, {"type": "subtitle", "time": 12515.95, "timestamp": "03:28:35", "text": "えーと長瀞さん、これをクリックして"}, {"type": "subtitle", "time": 12519.389, "timestamp": "03:28:39", "text": "ここでロールを手に入れれば、"}, {"type": "subtitle", "time": 12522.87, "timestamp": "03:28:42", "text": "そういうことなんです。はい、そういうことです。"}, {"type": "subtitle", "time": 12525.55, "timestamp": "03:28:45", "text": "ルールとかそういうのどうやって手に入れるかはいいけど"}, {"type": "subtitle", "time": 12528.03, "timestamp": "03:28:48", "text": "でもでもでもお尻がある、そう、お尻がある"}, {"type": "subtitle", "time": 12532.67, "timestamp": "03:28:52", "text": "ああ、お尻があるよ、えっと、これは"}, {"type": "subtitle", "time": 12534.79, "timestamp": "03:28:54", "text": "これ"}, {"type": "subtitle", "time": 12539.79, "timestamp": "03:28:59", "text": "チェック、えーと、チェック、えーと、もしあなたが"}]
[{"type": "subtitle", "time": 13685.75, "timestamp": "03:48:05", "text": "リセットした、ああ、そうだった、そうだった、そうだった"}, {"type": "subtitle", "time": 13696.71, "timestamp": "03:48:16", "text": "えっと、"}, {"type": "subtitle", "time": 13699.11, "timestamp": "03:48:19", "text": "リセットするにはどうすればいいですか？"}, {"type": "subtitle", "time": 13703.83, "timestamp": "03:48:23", "text": "ああ、音声ケーブルが多すぎるよ、これ"}, {"type": "subtitle", "time": 13714.149, "timestamp": "03:48:34", "text": "えっと、ちょっと待って、なんで設定がリセットされてるの？"}, {"type": "subtitle", "time": 13716.75, "timestamp": "03:48:36", "text": "何が起こったのか、待つために"}, {"type": "subtitle", "time": 13720.07, "timestamp": "03:48:40", "text": "私の自動車の元カレに何が起こったのか"}, {"type": "subtitle", "time": 13732.269, "timestamp": "03:48:52", "text": "すべて"}, {"type": "subtitle", "time": 13739.59, "timestamp": "03:48:59", "text": "CFG 失くした、待って、いやいやいやいや、ああ、私は"}]
[{"type": "subtitle", "time": 18242.23, "timestamp": "05:04:02", "text": "いいね"}, {"type": "subtitle", "time": 18245.628, "timestamp": "05:04:05", "text": "イエス、絶対に留まる"}, {"type": "subtitle", "time": 18250.27, "timestamp": "05:04:10", "text": "ほら、そこにいてくれって言ったでしょ、ああ、"}, {"type": "subtitle", "time": 18251.99, "timestamp": "05:04:11", "text": "だからそれは"}, {"type": "subtitle", "time": 18254.11, "timestamp": "05:04:14", "text": "とんでもない"}, {"type": "subtitle", "time": 18257.35, "timestamp": "05:04:17", "text": "私はこれで殺された"}, {"type": "subtitle", "time": 18261.67, "timestamp": "05:04:21", "text": "チト兄さん、これは本当に痛いよ"}, {"type": "subtitle", "time": 18266.548, "timestamp": "05:04:26", "text": "男の痛み彼はプラチナ1つプラチナ1つそれが"}, {"type": "subtitle", "time": 18267.12, "timestamp": "05:04:27", "text": "なぜ"}, {"type": "subtitle", "time": 18270.43, "timestamp": "05:04:30", "text": "[笑い]"}, {"type": "subtitle", "time": 18274.27, "timestamp": "05:04:34", "text": "ええ、買えます、買えます、いいえ"}, {"type": "subtitle", "time": 18276.91, "timestamp": "05:04:36", "text": "できないかな、できると思ったんだけど、本当に必要なんだ"}, {"type": "subtitle", "time": 18280.15, "timestamp": "05:04:40", "text": "賢者 賢者"}, {"type": "subtitle", "time": 18294.83, "timestamp": "05:04:54", "text": "私はいくつか"}, {"type": "subtitle", "time": 18298.35, "timestamp": "05:04:58", "text": "ちょっと待って、スカウトを待って待って"}]
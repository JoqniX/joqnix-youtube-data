[{"type": "subtitle", "time": 1564.149, "timestamp": "00:26:04", "text": "[音楽]"}, {"type": "subtitle", "time": 1566.2, "timestamp": "00:26:06", "text": "これは興味深い"}, {"type": "subtitle", "time": 1567.789, "timestamp": "00:26:07", "text": "[音楽]"}, {"type": "subtitle", "time": 1571.269, "timestamp": "00:26:11", "text": "はい、よく聞こえます"}, {"type": "subtitle", "time": 1575.07, "timestamp": "00:26:15", "text": "こんにちは、これを開けてみましょう、これは何でしょう"}, {"type": "subtitle", "time": 1576.63, "timestamp": "00:26:16", "text": "1"}, {"type": "subtitle", "time": 1579.19, "timestamp": "00:26:19", "text": "壁紙"}, {"type": "subtitle", "time": 1581.669, "timestamp": "00:26:21", "text": "別の予約をする"}, {"type": "subtitle", "time": 1585.47, "timestamp": "00:26:25", "text": "本、ああ、それは私が思っているものなのか"}, {"type": "subtitle", "time": 1587.23, "timestamp": "00:26:27", "text": "これは塗り絵です"}, {"type": "subtitle", "time": 1591.23, "timestamp": "00:26:31", "text": "えっと、それはタバコですか、それとも消しゴムですか。"}, {"type": "subtitle", "time": 1595.47, "timestamp": "00:26:35", "text": "蛍光ペン、よし、別の本、別の本"}, {"type": "subtitle", "time": 1598.149, "timestamp": "00:26:38", "text": "予約する"}, {"type": "subtitle", "time": 1601.149, "timestamp": "00:26:41", "text": "テレビはどこに置きますか？"}, {"type": "subtitle", "time": 1603.51, "timestamp": "00:26:43", "text": "なんて場所なんだ"}, {"type": "subtitle", "time": 1610.99, "timestamp": "00:26:50", "text": "バスルームであってキッチンではない"}, {"type": "subtitle", "time": 1613.63, "timestamp": "00:26:53", "text": "いやいやいや、もう終わってるはずだ"}]
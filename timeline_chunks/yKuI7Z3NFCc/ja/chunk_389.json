[{"type": "subtitle", "time": 23341.948, "timestamp": "06:29:01", "text": "インドのユーチューバーたちのおかげで私たちは"}, {"type": "subtitle", "time": 23345.948, "timestamp": "06:29:05", "text": "それらを配置するために"}, {"type": "subtitle", "time": 23348.75, "timestamp": "06:29:08", "text": "人々、そして来られなかった人々"}, {"type": "subtitle", "time": 23351.59, "timestamp": "06:29:11", "text": "それと、それができた人たち、"}, {"type": "subtitle", "time": 23354.468, "timestamp": "06:29:14", "text": "彼らにプレイしてもらいたい"}, {"type": "subtitle", "time": 23358.39, "timestamp": "06:29:18", "text": "ますます一緒に参加し"}, {"type": "subtitle", "time": 23361.868, "timestamp": "06:29:21", "text": "仮想現実のようなトーナメントでは、"}, {"type": "subtitle", "time": 23364.43, "timestamp": "06:29:24", "text": "えーと、もしそれが別のものを主催していて、"}, {"type": "subtitle", "time": 23367.548, "timestamp": "06:29:27", "text": "仮想現実以外のTトーナメント"}, {"type": "subtitle", "time": 23369.83, "timestamp": "06:29:29", "text": "アンドブチューニング"}, {"type": "subtitle", "time": 23372.51, "timestamp": "06:29:32", "text": "うん、そうやってお互いと繋がるんだ"}, {"type": "subtitle", "time": 23375.75, "timestamp": "06:29:35", "text": "他の人もそうですよね"}, {"type": "subtitle", "time": 23379.27, "timestamp": "06:29:39", "text": "私は、ああ、これをやろうと思った"}, {"type": "subtitle", "time": 23382.23, "timestamp": "06:29:42", "text": "みんなに良い励ましの言葉を伝える"}, {"type": "subtitle", "time": 23385.99, "timestamp": "06:29:45", "text": "ゲームをプレイする意欲がさらに高まり、"}, {"type": "subtitle", "time": 23389.628, "timestamp": "06:29:49", "text": "彼らは最善を尽くしたが、私にはできなかったが"}, {"type": "subtitle", "time": 23392.788, "timestamp": "06:29:52", "text": "少なくとも私は、私の"}]
[{"type": "subtitle", "time": 13080.15, "timestamp": "03:38:00", "text": "歩いて行く"}, {"type": "subtitle", "time": 13087.429, "timestamp": "03:38:07", "text": "うんうん"}, {"type": "subtitle", "time": 13089.83, "timestamp": "03:38:09", "text": "あなたは"}, {"type": "subtitle", "time": 13094.07, "timestamp": "03:38:14", "text": "遅くなったけど、うん、私たちはメモのようなものを見た"}, {"type": "subtitle", "time": 13096.83, "timestamp": "03:38:16", "text": "ゲームの中のカエルのように"}, {"type": "subtitle", "time": 13099.229, "timestamp": "03:38:19", "text": "可愛かったので、配信を締めくくります。"}, {"type": "subtitle", "time": 13102.79, "timestamp": "03:38:22", "text": "ああ、哲学、来るべき希望のためのソナタ"}, {"type": "subtitle", "time": 13104.15, "timestamp": "03:38:24", "text": "楽しんでいただけました"}, {"type": "subtitle", "time": 13107.389, "timestamp": "03:38:27", "text": "本日お越しいただき、ありがとうございます。"}, {"type": "subtitle", "time": 13109.389, "timestamp": "03:38:29", "text": "ストリーミングを視聴してありがとうと私に言ってくれ"}, {"type": "subtitle", "time": 13112.429, "timestamp": "03:38:32", "text": "あなたが私の高いところから高いところへ送ってくれたことを願っています"}, {"type": "subtitle", "time": 13115.75, "timestamp": "03:38:35", "text": "皆さん、来てくれてありがとう。"}, {"type": "subtitle", "time": 13118.309, "timestamp": "03:38:38", "text": "アダト、君はここに来るのは初めてだよね？"}, {"type": "subtitle", "time": 13121.189, "timestamp": "03:38:41", "text": "来られる皆様、今日を楽しんでいただければ幸いです。"}, {"type": "subtitle", "time": 13124.269, "timestamp": "03:38:44", "text": "可愛いって言ってよ、あなたじゃなくて、あなただよ"}, {"type": "subtitle", "time": 13130.83, "timestamp": "03:38:50", "text": "そして、"}, {"type": "subtitle", "time": 13133.99, "timestamp": "03:38:53", "text": "来ることで、あなたが"}, {"type": "subtitle", "time": 13138.429, "timestamp": "03:38:58", "text": "楽しんでからアカウントが来ました。"}]
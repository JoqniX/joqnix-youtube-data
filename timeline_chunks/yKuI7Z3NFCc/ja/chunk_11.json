[{"type": "subtitle", "time": 670.71, "timestamp": "00:11:10", "text": "今日もう一度確認してみます。"}, {"type": "subtitle", "time": 674.67, "timestamp": "00:11:14", "text": "イベントはありません。"}, {"type": "subtitle", "time": 675.87, "timestamp": "00:11:15", "text": "出席する"}, {"type": "subtitle", "time": 679.31, "timestamp": "00:11:19", "text": "それはきっと"}, {"type": "subtitle", "time": 683.79, "timestamp": "00:11:23", "text": "再生する、または再生する"}, {"type": "subtitle", "time": 687.069, "timestamp": "00:11:27", "text": "簡単に、ああ神様、私は準備ができたことを知っています"}, {"type": "subtitle", "time": 705.31, "timestamp": "00:11:45", "text": "私にとって初めてのこと"}]
[{"type": "subtitle", "time": 2161.309, "timestamp": "00:36:01", "text": "ここで私は思う"}, {"type": "subtitle", "time": 2163.829, "timestamp": "00:36:03", "text": "こんにちは、あなたはどこでストリーミング配信していますか？"}, {"type": "subtitle", "time": 2167.069, "timestamp": "00:36:07", "text": "YouTube えーと Twitch が Twitch について話している"}, {"type": "subtitle", "time": 2169.589, "timestamp": "00:36:09", "text": "そこでは配信してないよ、してないよ"}, {"type": "subtitle", "time": 2172.51, "timestamp": "00:36:12", "text": "早く起きて寝たと思う"}, {"type": "subtitle", "time": 2174.309, "timestamp": "00:36:14", "text": "午前8時に再び"}, {"type": "subtitle", "time": 2176.43, "timestamp": "00:36:16", "text": "今日は"}, {"type": "subtitle", "time": 2179.069, "timestamp": "00:36:19", "text": "確かにそれはとても面倒なことですが、"}, {"type": "subtitle", "time": 2180.53, "timestamp": "00:36:20", "text": "に"}, {"type": "subtitle", "time": 2184.109, "timestamp": "00:36:24", "text": "[音楽]"}, {"type": "subtitle", "time": 2186.16, "timestamp": "00:36:26", "text": "する"}, {"type": "subtitle", "time": 2198.829, "timestamp": "00:36:38", "text": "[音楽]"}, {"type": "subtitle", "time": 2202.63, "timestamp": "00:36:42", "text": "えっと、靴"}, {"type": "subtitle", "time": 2208.069, "timestamp": "00:36:48", "text": "よし、トベルを手に入れたから、そこへ行こう"}, {"type": "subtitle", "time": 2214.19, "timestamp": "00:36:54", "text": "マグカップ これは何？"}, {"type": "subtitle", "time": 2216.37, "timestamp": "00:36:56", "text": "マウスウォッシュデオドラント"}, {"type": "subtitle", "time": 2219.069, "timestamp": "00:36:59", "text": "[音楽]"}]
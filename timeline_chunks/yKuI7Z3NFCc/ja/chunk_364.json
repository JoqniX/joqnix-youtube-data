[{"type": "subtitle", "time": 21841.99, "timestamp": "06:04:01", "text": "さようなら、はい、ああ"}, {"type": "subtitle", "time": 21844.868, "timestamp": "06:04:04", "text": "さよなら、さよなら、兄弟、さよなら、さよなら、いいえ"}, {"type": "subtitle", "time": 21849.468, "timestamp": "06:04:09", "text": "説明はわかりました、さようなら、はいはい"}, {"type": "subtitle", "time": 21852.91, "timestamp": "06:04:12", "text": "さようなら、神様、説明は不要です、さようなら"}, {"type": "subtitle", "time": 21870.788, "timestamp": "06:04:30", "text": "起こったことは、私が本当に計画しているということです"}, {"type": "subtitle", "time": 21873.11, "timestamp": "06:04:33", "text": "ナイフについてですが、誰かが"}, {"type": "subtitle", "time": 21874.23, "timestamp": "06:04:34", "text": "始めた"}, {"type": "subtitle", "time": 21877.43, "timestamp": "06:04:37", "text": "銃撃は私の計画ではない、それは分かっている"}, {"type": "subtitle", "time": 21897.35, "timestamp": "06:04:57", "text": "兄弟"}, {"type": "subtitle", "time": 21899.91, "timestamp": "06:04:59", "text": "いいよ、必要ない"}]
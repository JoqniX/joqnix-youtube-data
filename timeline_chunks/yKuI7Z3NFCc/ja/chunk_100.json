[{"type": "subtitle", "time": 6002.629, "timestamp": "01:40:02", "text": "ああ、私たちはとても素敵なものをたくさん持っています"}, {"type": "subtitle", "time": 6006.07, "timestamp": "01:40:06", "text": "神様、あなたは本当に白黒ですか"}, {"type": "subtitle", "time": 6009.51, "timestamp": "01:40:09", "text": "1つ上へ、ああ、それは大丈夫、わかった、私は"}, {"type": "subtitle", "time": 6012.03, "timestamp": "01:40:12", "text": "1つだけ残しておく"}, {"type": "subtitle", "time": 6015.47, "timestamp": "01:40:15", "text": "それはとてもクールだ"}, {"type": "subtitle", "time": 6018.149, "timestamp": "01:40:18", "text": "わかった"}, {"type": "subtitle", "time": 6022.07, "timestamp": "01:40:22", "text": "スプーン、黒くてとてもおしゃれで"}, {"type": "subtitle", "time": 6024.32, "timestamp": "01:40:24", "text": "金"}, {"type": "subtitle", "time": 6028.03, "timestamp": "01:40:28", "text": "[音楽]"}, {"type": "subtitle", "time": 6036.149, "timestamp": "01:40:36", "text": "最高のものはどこに保管すればいいですか？ああ、わかりました。"}, {"type": "subtitle", "time": 6043.669, "timestamp": "01:40:43", "text": "はい、X 最初に K を修正します"}, {"type": "subtitle", "time": 6050.39, "timestamp": "01:40:50", "text": "スプーン スプーンをどこに置くべきか知っています"}, {"type": "subtitle", "time": 6053.91, "timestamp": "01:40:53", "text": "我々はそれを排除するが"}]
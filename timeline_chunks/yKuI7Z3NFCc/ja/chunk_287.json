[{"type": "subtitle", "time": 17258.31, "timestamp": "04:47:38", "text": "はい、みなさんこんにちは、お元気ですか？"}, {"type": "subtitle", "time": 17261.47, "timestamp": "04:47:41", "text": "うん、こんにちは"}, {"type": "subtitle", "time": 17264.67, "timestamp": "04:47:44", "text": "わ、私は待っていません"}, {"type": "subtitle", "time": 17267.75, "timestamp": "04:47:47", "text": "上流では擦り傷がつくが、それでも"}]
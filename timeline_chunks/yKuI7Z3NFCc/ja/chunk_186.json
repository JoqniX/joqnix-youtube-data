[{"type": "subtitle", "time": 11160.75, "timestamp": "03:06:00", "text": "はい、今日はこれで終わりにします"}, {"type": "subtitle", "time": 11164.309, "timestamp": "03:06:04", "text": "はい、このアルバムは何ですか？選択できません"}, {"type": "subtitle", "time": 11167.75, "timestamp": "03:06:07", "text": "知っているが、これだけ発見したので、"}, {"type": "subtitle", "time": 11169.51, "timestamp": "03:06:09", "text": "やり方がわからない"}, {"type": "subtitle", "time": 11171.55, "timestamp": "03:06:11", "text": "取得するため"}, {"type": "subtitle", "time": 11173.229, "timestamp": "03:06:13", "text": "[音楽]"}, {"type": "subtitle", "time": 11175.51, "timestamp": "03:06:15", "text": "これは、しかしこれは"}, {"type": "subtitle", "time": 11178.19, "timestamp": "03:06:18", "text": "クールh"}, {"type": "subtitle", "time": 11180.59, "timestamp": "03:06:20", "text": "私たちはそれらを手に入れる"}, {"type": "subtitle", "time": 11184.91, "timestamp": "03:06:24", "text": "こんにちは、ええ、これはテオの開封でした"}, {"type": "subtitle", "time": 11187.07, "timestamp": "03:06:27", "text": "引き続き荷解きをします"}, {"type": "subtitle", "time": 11190.03, "timestamp": "03:06:30", "text": "この2番目のストリームを見つけると"}, {"type": "subtitle", "time": 11192.19, "timestamp": "03:06:32", "text": "ストリームを解凍すると、"}, {"type": "subtitle", "time": 11195.87, "timestamp": "03:06:35", "text": "私のチャンネルでプレイリスト呼び出しの解凍を行うので"}, {"type": "subtitle", "time": 11198.79, "timestamp": "03:06:38", "text": "そうすれば、"}, {"type": "subtitle", "time": 11201.389, "timestamp": "03:06:41", "text": "すべて更新済みです。"}, {"type": "subtitle", "time": 11203.51, "timestamp": "03:06:43", "text": "私が自分のストリームを準備しているのを見てください"}, {"type": "subtitle", "time": 11204.95, "timestamp": "03:06:44", "text": "から見ることができます"}, {"type": "subtitle", "time": 11209.229, "timestamp": "03:06:49", "text": "プレイリスト。こんにちは、それではまとめましょう"}, {"type": "subtitle", "time": 11213.51, "timestamp": "03:06:53", "text": "今日はああ、明らかにジャマ、それはちょっと"}, {"type": "subtitle", "time": 11215.63, "timestamp": "03:06:55", "text": "少しの間は落ち込んだけど、まあいいよ"}, {"type": "subtitle", "time": 11219.229, "timestamp": "03:06:59", "text": "クラッシュはしなかったが、クラッシュはしなかったが、"}]
[{"type": "subtitle", "time": 1323.19, "timestamp": "00:22:03", "text": "うん、最近だよ、待って、彼女は"}, {"type": "subtitle", "time": 1327.23, "timestamp": "00:22:07", "text": "20時間前に配信された彼女の配信内容"}, {"type": "subtitle", "time": 1336.63, "timestamp": "00:22:16", "text": "えーっと、それはINDです"}, {"type": "subtitle", "time": 1344.51, "timestamp": "00:22:24", "text": "ええ、彼女も"}, {"type": "subtitle", "time": 1348.75, "timestamp": "00:22:28", "text": "このユーチューバーは彼女です"}, {"type": "subtitle", "time": 1352.43, "timestamp": "00:22:32", "text": "そして彼女はまた、女性として初めて"}, {"type": "subtitle", "time": 1357.149, "timestamp": "00:22:37", "text": "インドのユーチューバーがこれを始めるのが好き"}, {"type": "subtitle", "time": 1360.11, "timestamp": "00:22:40", "text": "私がトレンドになっているのは"}, {"type": "subtitle", "time": 1363.789, "timestamp": "00:22:43", "text": "インドではその後、仮想サクルにサカンがやってきた。"}, {"type": "subtitle", "time": 1367.31, "timestamp": "00:22:47", "text": "入ってきてからトゥキが来た"}, {"type": "subtitle", "time": 1371.19, "timestamp": "00:22:51", "text": "すると、こんにちは、という感じで"}, {"type": "subtitle", "time": 1379.07, "timestamp": "00:22:59", "text": "次の女の子は誰？"}]
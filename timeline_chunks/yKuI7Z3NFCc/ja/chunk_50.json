[{"type": "subtitle", "time": 3005.549, "timestamp": "00:50:05", "text": "いいえ、なぜそう言うのですか"}, {"type": "subtitle", "time": 3007.95, "timestamp": "00:50:07", "text": "間違っている"}, {"type": "subtitle", "time": 3018.25, "timestamp": "00:50:18", "text": "一番上に置くものは何ですか？"}, {"type": "subtitle", "time": 3022.069, "timestamp": "00:50:22", "text": "[音楽]"}, {"type": "subtitle", "time": 3024.83, "timestamp": "00:50:24", "text": "いいえ、えっと"}, {"type": "subtitle", "time": 3043.43, "timestamp": "00:50:43", "text": "ああ、これは食べ物のペダルになるかな、いや、私は"}, {"type": "subtitle", "time": 3046.589, "timestamp": "00:50:46", "text": "ない、それはありえない、私は"}, {"type": "subtitle", "time": 3052.02, "timestamp": "00:50:52", "text": "知っているか、あるいは疑問符かもしれない"}]
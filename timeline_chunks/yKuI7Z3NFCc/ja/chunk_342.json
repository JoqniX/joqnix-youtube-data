[{"type": "subtitle", "time": 20520.548, "timestamp": "05:42:00", "text": "神のもとへ行きます"}, {"type": "subtitle", "time": 20528.75, "timestamp": "05:42:08", "text": "おお"}, {"type": "subtitle", "time": 20538.03, "timestamp": "05:42:18", "text": "治癒、すごいな、何だって？"}, {"type": "subtitle", "time": 20541.35, "timestamp": "05:42:21", "text": "起こったよ、左側、よし、続けよう"}, {"type": "subtitle", "time": 20543.35, "timestamp": "05:42:23", "text": "の"}, {"type": "subtitle", "time": 20546.75, "timestamp": "05:42:26", "text": "違いは、私のものを取って、私のバンとバンを取って"}, {"type": "subtitle", "time": 20555.548, "timestamp": "05:42:35", "text": "防御する何かを取る"}, {"type": "subtitle", "time": 20559.628, "timestamp": "05:42:39", "text": "うん、終わり、そしてジョミ、うん、あなたは違う"}, {"type": "subtitle", "time": 20561.83, "timestamp": "05:42:41", "text": "デュエリストロールに適しています"}, {"type": "subtitle", "time": 20564.27, "timestamp": "05:42:44", "text": "友よ、君は二元論者には向いていない"}, {"type": "subtitle", "time": 20567.15, "timestamp": "05:42:47", "text": "転がすのは全くごめんなさい、私は望んでいません、ええ、あなた"}, {"type": "subtitle", "time": 20576.468, "timestamp": "05:42:56", "text": "これは取り出さない"}, {"type": "subtitle", "time": 20579.788, "timestamp": "05:42:59", "text": "オーディン、いや、杖を取り出すよ"}]
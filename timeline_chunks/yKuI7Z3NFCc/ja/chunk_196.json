[{"type": "subtitle", "time": 11760.63, "timestamp": "03:16:00", "text": "上か下か、他のプラットフォームのように"}, {"type": "subtitle", "time": 11762.07, "timestamp": "03:16:02", "text": "平等にしたいだけです、"}, {"type": "subtitle", "time": 11765.349, "timestamp": "03:16:05", "text": "何か、そう、そしてゆっくりと、ある日"}, {"type": "subtitle", "time": 11769.59, "timestamp": "03:16:09", "text": "1日とても良い日、1日とても良い日"}, {"type": "subtitle", "time": 11771.75, "timestamp": "03:16:11", "text": "良い"}, {"type": "subtitle", "time": 11775.429, "timestamp": "03:16:15", "text": "ビリービリーでストリーミング配信する日"}, {"type": "subtitle", "time": 11777.51, "timestamp": "03:16:17", "text": "これは中国版YouTubeです"}, {"type": "subtitle", "time": 11780.11, "timestamp": "03:16:20", "text": "最後に、そこでストリーミング配信できるようになったら"}, {"type": "subtitle", "time": 11783.63, "timestamp": "03:16:23", "text": "中国の家族を作りたい"}, {"type": "subtitle", "time": 11786.51, "timestamp": "03:16:26", "text": "また、ビル・ビリー・チャンネルも"}, {"type": "subtitle", "time": 11789.79, "timestamp": "03:16:29", "text": "いつか同じ数字"}, {"type": "subtitle", "time": 11792.469, "timestamp": "03:16:32", "text": "うん"}, {"type": "subtitle", "time": 11795.11, "timestamp": "03:16:35", "text": "いつか、そして、私が知っている人々"}, {"type": "subtitle", "time": 11797.229, "timestamp": "03:16:37", "text": "会って、チャットします。みんなみんな"}, {"type": "subtitle", "time": 11800.15, "timestamp": "03:16:40", "text": "教授に会うほとんどの人はただチェックするだけです"}, {"type": "subtitle", "time": 11803.269, "timestamp": "03:16:43", "text": "私のVプロフィールにあるように、プロフィールの右側を右に表示します。"}, {"type": "subtitle", "time": 11806.15, "timestamp": "03:16:46", "text": "YouTubeのリンクとか色々あって、それから"}, {"type": "subtitle", "time": 11807.99, "timestamp": "03:16:47", "text": "私はYouTubeで、すべて正しいです"}, {"type": "subtitle", "time": 11810.95, "timestamp": "03:16:50", "text": "常にビリービリーをチェックしてください"}, {"type": "subtitle", "time": 11814.99, "timestamp": "03:16:54", "text": "私は「ああ、いや、そんなことしなくてもよかったのに」と思いました。"}, {"type": "subtitle", "time": 11818.189, "timestamp": "03:16:58", "text": "でも彼らはまだ私に「犬はいつ"}]
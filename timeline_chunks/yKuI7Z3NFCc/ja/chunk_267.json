[{"type": "subtitle", "time": 16022.83, "timestamp": "04:27:02", "text": "こんにちは、バックパックが必要です。45秒"}, {"type": "subtitle", "time": 16025.51, "timestamp": "04:27:05", "text": "リングはそれほど遠くないから、そのEVで大丈夫"}, {"type": "subtitle", "time": 16037.83, "timestamp": "04:27:17", "text": "わかった、じゃあ30秒だけ行こう"}, {"type": "subtitle", "time": 16040.59, "timestamp": "04:27:20", "text": "時計の左側にリングが"}, {"type": "subtitle", "time": 16058.51, "timestamp": "04:27:38", "text": "10秒間の呼び出し音は基本的に"}, {"type": "subtitle", "time": 16069.07, "timestamp": "04:27:49", "text": "あれんん"}, {"type": "subtitle", "time": 16071.87, "timestamp": "04:27:51", "text": "n"}, {"type": "subtitle", "time": 16076.07, "timestamp": "04:27:56", "text": "これは何だ？新しい銃だ、待てよ"}]
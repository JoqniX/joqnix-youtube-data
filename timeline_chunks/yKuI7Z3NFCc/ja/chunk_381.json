[{"type": "subtitle", "time": 22860.468, "timestamp": "06:21:00", "text": "大変だったよ、ああ神様、ある時点で"}, {"type": "subtitle", "time": 22862.27, "timestamp": "06:21:02", "text": "私は自分が"}, {"type": "subtitle", "time": 22864.708, "timestamp": "06:21:04", "text": "Tシャツ全体、はい"}, {"type": "subtitle", "time": 22867.708, "timestamp": "06:21:07", "text": "私はとてもひどかったので"}, {"type": "subtitle", "time": 22871.15, "timestamp": "06:21:11", "text": "でも、それでも私たちはみんな最善を尽くしました"}, {"type": "subtitle", "time": 22873.27, "timestamp": "06:21:13", "text": "それが"}, {"type": "subtitle", "time": 22875.03, "timestamp": "06:21:15", "text": "問題"}, {"type": "subtitle", "time": 22879.868, "timestamp": "06:21:19", "text": "こんにちは、そして、私は、私は、できなかったことを申し訳なく思います。"}, {"type": "subtitle", "time": 22881.67, "timestamp": "06:21:21", "text": "チャットを読んで"}, {"type": "subtitle", "time": 22886.43, "timestamp": "06:21:26", "text": "すべてCH上にあるのは、あなたが"}, {"type": "subtitle", "time": 22890.27, "timestamp": "06:21:30", "text": "わかってるよ、そうだね、君に"}, {"type": "subtitle", "time": 22894.31, "timestamp": "06:21:34", "text": "右のMに集中しているので、はい、私は"}, {"type": "subtitle", "time": 22896.03, "timestamp": "06:21:36", "text": "考える"}, {"type": "subtitle", "time": 22898.548, "timestamp": "06:21:38", "text": "うん、こんにちはPと他の皆さん"}, {"type": "subtitle", "time": 22901.11, "timestamp": "06:21:41", "text": "探していて、まだここにいて探しています"}, {"type": "subtitle", "time": 22917.51, "timestamp": "06:21:57", "text": "おもちゃ、青い猫、えっと、それだけです"}]
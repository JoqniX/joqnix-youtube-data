[{"type": "subtitle", "time": 13142.91, "timestamp": "03:39:02", "text": "今日はあなたが眠れることを願っています"}, {"type": "subtitle", "time": 13145.75, "timestamp": "03:39:05", "text": "よし、じゃあウブCHがやって来て"}, {"type": "subtitle", "time": 13148.51, "timestamp": "03:39:08", "text": "来てくれて本当にありがとう"}, {"type": "subtitle", "time": 13150.99, "timestamp": "03:39:10", "text": "本当に嬉しいです。楽しんでいただけたら幸いです。"}, {"type": "subtitle", "time": 13154.11, "timestamp": "03:39:14", "text": "今日、そしてあなたの幸運を祈っています"}, {"type": "subtitle", "time": 13156.309, "timestamp": "03:39:16", "text": "明日、あなたは、あなたは、あなたは、"}, {"type": "subtitle", "time": 13158.229, "timestamp": "03:39:18", "text": "持っている"}, {"type": "subtitle", "time": 13162.15, "timestamp": "03:39:22", "text": "ああ、ああ、あなたは、ああ、"}, {"type": "subtitle", "time": 13164.91, "timestamp": "03:39:24", "text": "それを何と呼ぶか​​は、すぐに目が覚めます"}, {"type": "subtitle", "time": 13168.189, "timestamp": "03:39:28", "text": "うんうん、私も行かなきゃいけないから、おやすみ"}, {"type": "subtitle", "time": 13183.87, "timestamp": "03:39:43", "text": "それではさようなら、皆さん来てくれてありがとう"}, {"type": "subtitle", "time": 13185.51, "timestamp": "03:39:45", "text": "今日"}, {"type": "subtitle", "time": 13187.51, "timestamp": "03:39:47", "text": "来週は、私は"}, {"type": "subtitle", "time": 13190.269, "timestamp": "03:39:50", "text": "夜に配信するよ、だって、"}, {"type": "subtitle", "time": 13192.59, "timestamp": "03:39:52", "text": "たくさん電話がかかってきて、私は変更します"}, {"type": "subtitle", "time": 13195.99, "timestamp": "03:39:55", "text": "またゴアの時間だ、と夜に思った"}, {"type": "subtitle", "time": 13198.469, "timestamp": "03:39:58", "text": "ストリーミングするには良い時間ですが"}]
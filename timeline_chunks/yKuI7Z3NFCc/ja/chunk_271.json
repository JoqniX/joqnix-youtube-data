[{"type": "subtitle", "time": 16264.71, "timestamp": "04:31:04", "text": "ここで一緒に攻撃する友人たち"}, {"type": "subtitle", "time": 16267.269, "timestamp": "04:31:07", "text": "友達はFASより速い"}, {"type": "subtitle", "time": 16271.309, "timestamp": "04:31:11", "text": "もっと早く行くよ、遅れてごめんね"}, {"type": "subtitle", "time": 16279.91, "timestamp": "04:31:19", "text": "祝賀会で戦闘を始めましょう"}, {"type": "subtitle", "time": 16281.67, "timestamp": "04:31:21", "text": "一緒に行くよ、リコシェをしてくれる人が必要だ"}, {"type": "subtitle", "time": 16304.59, "timestamp": "04:31:44", "text": "シールドをチャージ中、悪いものをいくつか手に入れました"}, {"type": "subtitle", "time": 16305.75, "timestamp": "04:31:45", "text": "みんな"}, {"type": "subtitle", "time": 16315.67, "timestamp": "04:31:55", "text": "銃撃"}]
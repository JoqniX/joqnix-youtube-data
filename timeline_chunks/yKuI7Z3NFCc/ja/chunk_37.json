[{"type": "subtitle", "time": 2222.95, "timestamp": "00:37:02", "text": "これをブラシで磨いて、待って、好きになれるかな"}, {"type": "subtitle", "time": 2226.51, "timestamp": "00:37:06", "text": "オープン番号"}, {"type": "subtitle", "time": 2235.069, "timestamp": "00:37:15", "text": "[音楽]"}, {"type": "subtitle", "time": 2237.069, "timestamp": "00:37:17", "text": "えー、わかったよ、何を入れるか知ってるよね"}, {"type": "subtitle", "time": 2251.589, "timestamp": "00:37:31", "text": "すべてシャンプーなし、これはここにあります"}, {"type": "subtitle", "time": 2258.47, "timestamp": "00:37:38", "text": "ああ、ブラジャーを手に入れたよ。このBは"}, {"type": "subtitle", "time": 2262.75, "timestamp": "00:37:42", "text": "いいえ、正しく整列されていません"}, {"type": "subtitle", "time": 2265.95, "timestamp": "00:37:45", "text": "いいえ、あなたは、あなたは言うつもりですか"}, {"type": "subtitle", "time": 2269.87, "timestamp": "00:37:49", "text": "同じ色の眉毛がもっと増えるだろう"}, {"type": "subtitle", "time": 2270.95, "timestamp": "00:37:50", "text": "[音楽]"}, {"type": "subtitle", "time": 2275.79, "timestamp": "00:37:55", "text": "ええと、必要でなければなりません"}, {"type": "subtitle", "time": 2278.87, "timestamp": "00:37:58", "text": "もっと注文して、このままにしておきます"}]
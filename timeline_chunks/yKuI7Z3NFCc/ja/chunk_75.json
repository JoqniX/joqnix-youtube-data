[{"type": "subtitle", "time": 4514.94, "timestamp": "01:15:14", "text": "鉛筆"}, {"type": "subtitle", "time": 4525.87, "timestamp": "01:15:25", "text": "させて"}, {"type": "subtitle", "time": 4533.31, "timestamp": "01:15:33", "text": "機械が混雑しているように見えるので、"}, {"type": "subtitle", "time": 4535.27, "timestamp": "01:15:35", "text": "あなた"}, {"type": "subtitle", "time": 4539.03, "timestamp": "01:15:39", "text": "私もそう思う"}, {"type": "subtitle", "time": 4540.55, "timestamp": "01:15:40", "text": "の"}, {"type": "subtitle", "time": 4551.39, "timestamp": "01:15:51", "text": "[音楽]"}, {"type": "subtitle", "time": 4554.669, "timestamp": "01:15:54", "text": "もしこの重りが落ちたら、いいえ"}, {"type": "subtitle", "time": 4557.79, "timestamp": "01:15:57", "text": "すべて破壊されるので私は親切に"}]
[{"type": "subtitle", "time": 21660.43, "timestamp": "06:01:00", "text": "これで"}, {"type": "subtitle", "time": 21663.468, "timestamp": "06:01:03", "text": "同意しないと言う、彼らは同意しない"}, {"type": "subtitle", "time": 21669.15, "timestamp": "06:01:09", "text": "同意するなら、はいかいいえと言ってください。男性は、はいかいいえと言ってください。"}, {"type": "subtitle", "time": 21674.628, "timestamp": "06:01:14", "text": "いや、速くない、ああ神様、いや、彼らは"}, {"type": "subtitle", "time": 21677.788, "timestamp": "06:01:17", "text": "知らない、いい、いい、いい、わかった、わかった、来て"}, {"type": "subtitle", "time": 21679.35, "timestamp": "06:01:19", "text": "さあさあ"}, {"type": "subtitle", "time": 21684.628, "timestamp": "06:01:24", "text": "みんな、KNって何殺すの？"}, {"type": "subtitle", "time": 21688.03, "timestamp": "06:01:28", "text": "誰か、なんで殺してるんだよ、兄弟。"}, {"type": "subtitle", "time": 21696.39, "timestamp": "06:01:36", "text": "ああ、なんてことだ"}, {"type": "subtitle", "time": 21712.19, "timestamp": "06:01:52", "text": "ああ、あのセッティングは"}, {"type": "subtitle", "time": 21715.66, "timestamp": "06:01:55", "text": "いや、それは不正行為だ"}]
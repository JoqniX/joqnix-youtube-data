[{"type": "subtitle", "time": 19568.788, "timestamp": "05:26:08", "text": "ヒット、私たちは物事を変えるつもりです、いやいやいや"}, {"type": "subtitle", "time": 19570.47, "timestamp": "05:26:10", "text": "チームを変えることはできないよね"}, {"type": "subtitle", "time": 19573.948, "timestamp": "05:26:13", "text": "不公平だ、クソ野郎、そうだ、不公平だ、"}, {"type": "subtitle", "time": 19577.03, "timestamp": "05:26:17", "text": "どういう意味ですか、しないで"}, {"type": "subtitle", "time": 19579.07, "timestamp": "05:26:19", "text": "心配しないで、私たちは勝つから"}, {"type": "subtitle", "time": 19581.83, "timestamp": "05:26:21", "text": "心配しないで、今回は正しい選択をしよう"}, {"type": "subtitle", "time": 19585.43, "timestamp": "05:26:25", "text": "キャラクターよ、みんな、みんな、それで君たちは"}, {"type": "subtitle", "time": 19588.51, "timestamp": "05:26:28", "text": "リメイクが欲しかったので、私たちは"}, {"type": "subtitle", "time": 19591.07, "timestamp": "05:26:31", "text": "先ほども言ったようにリメイクですが、"}, {"type": "subtitle", "time": 19593.03, "timestamp": "05:26:33", "text": "ワンマッチスパイク"}, {"type": "subtitle", "time": 19596.628, "timestamp": "05:26:36", "text": "リメイクとは、"}, {"type": "subtitle", "time": 19598.39, "timestamp": "05:26:38", "text": "私たちが選んだキャラクター"}, {"type": "subtitle", "time": 19601.628, "timestamp": "05:26:41", "text": "キャラクターが欲しかったのですが、私たちはそうではありません"}, {"type": "subtitle", "time": 19603.788, "timestamp": "05:26:43", "text": "私たちの"}, {"type": "subtitle", "time": 19606.07, "timestamp": "05:26:46", "text": "キャラクター どれを選ぶか"}, {"type": "subtitle", "time": 19607.708, "timestamp": "05:26:47", "text": "ポイントを追加で1つ差し上げます"}, {"type": "subtitle", "time": 19610.03, "timestamp": "05:26:50", "text": "評価なしですが、その後ソウルは"}, {"type": "subtitle", "time": 19612.788, "timestamp": "05:26:52", "text": "問題を抱えている彼は"}, {"type": "subtitle", "time": 19614.07, "timestamp": "05:26:54", "text": "問題はない"}, {"type": "subtitle", "time": 19618.67, "timestamp": "05:26:58", "text": "心配して、オーケー、4つは評価されていません、いいえ、私たちは"}]
[{"type": "subtitle", "time": 23160.15, "timestamp": "06:26:00", "text": "トーナメント、Tマン、私たちは"}, {"type": "subtitle", "time": 23163.628, "timestamp": "06:26:03", "text": "スパイクラッシュで3試合目に勝利しました。"}, {"type": "subtitle", "time": 23167.07, "timestamp": "06:26:07", "text": "レーティングなしの試合で最初の2試合に敗れた。"}, {"type": "subtitle", "time": 23176.468, "timestamp": "06:26:16", "text": "M はい、私たちは最善を尽くしました はい、私たちは最善を尽くしました"}, {"type": "subtitle", "time": 23179.59, "timestamp": "06:26:19", "text": "最高だったよ、ゲームはどうだった？ゲームは良かったよ"}, {"type": "subtitle", "time": 23184.27, "timestamp": "06:26:24", "text": "今日は楽しかったし、それから"}, {"type": "subtitle", "time": 23187.31, "timestamp": "06:26:27", "text": "私はチームワークが苦手だと理解しました"}, {"type": "subtitle", "time": 23190.11, "timestamp": "06:26:30", "text": "チームプレイが苦手です"}, {"type": "subtitle", "time": 23193.51, "timestamp": "06:26:33", "text": "実際、私は、えーっと、これは"}, {"type": "subtitle", "time": 23195.51, "timestamp": "06:26:35", "text": "私が考えていることは"}, {"type": "subtitle", "time": 23200.31, "timestamp": "06:26:40", "text": "マルチプレイヤーゲームで気づいたこと"}, {"type": "subtitle", "time": 23202.948, "timestamp": "06:26:42", "text": "その時私は急いで死んでしまうが"}, {"type": "subtitle", "time": 23206.548, "timestamp": "06:26:46", "text": "また、意思決定は"}, {"type": "subtitle", "time": 23211.43, "timestamp": "06:26:51", "text": "大変だ、大変だけど、慣れるよ"}, {"type": "subtitle", "time": 23218.75, "timestamp": "06:26:58", "text": "全体的に見て楽しかったのですが、"}]
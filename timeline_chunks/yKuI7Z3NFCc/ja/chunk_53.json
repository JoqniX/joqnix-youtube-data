[{"type": "subtitle", "time": 3206.75, "timestamp": "00:53:26", "text": "では、どうして通らないのでしょうか？"}, {"type": "subtitle", "time": 3210.71, "timestamp": "00:53:30", "text": "うーん、混乱した音、満足、これは"}, {"type": "subtitle", "time": 3214.589, "timestamp": "00:53:34", "text": "トイレットペーパーはいいけど、大きいのはちょっと待って"}, {"type": "subtitle", "time": 3218.27, "timestamp": "00:53:38", "text": "待って待って待って、それはここに入るの？"}, {"type": "subtitle", "time": 3222.51, "timestamp": "00:53:42", "text": "待って、そんなこと言わないで"}, {"type": "subtitle", "time": 3232.81, "timestamp": "00:53:52", "text": "何だって？"}]
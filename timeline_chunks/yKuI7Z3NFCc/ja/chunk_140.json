[{"type": "subtitle", "time": 8401.23, "timestamp": "02:20:01", "text": "胸とかに何か付いてるみたい"}, {"type": "subtitle", "time": 8405.11, "timestamp": "02:20:05", "text": "または背中にそれを詰め込む理由"}, {"type": "subtitle", "time": 8407.11, "timestamp": "02:20:07", "text": "そんな感じがしますか？"}, {"type": "subtitle", "time": 8415.83, "timestamp": "02:20:15", "text": "[音楽]"}, {"type": "subtitle", "time": 8419.68, "timestamp": "02:20:19", "text": "うん"}, {"type": "subtitle", "time": 8428.59, "timestamp": "02:20:28", "text": "それから、えっと、今日は"}, {"type": "subtitle", "time": 8431.63, "timestamp": "02:20:31", "text": "8時に待って、えーと、最初に"}, {"type": "subtitle", "time": 8435.429, "timestamp": "02:20:35", "text": "ストリーム えーっと待ってヤシャ君"}, {"type": "subtitle", "time": 8438.03, "timestamp": "02:20:38", "text": "Twitchでフォローしてくれてありがとう"}, {"type": "subtitle", "time": 8441.23, "timestamp": "02:20:41", "text": "ありがとう、あなたは"}, {"type": "subtitle", "time": 8445.07, "timestamp": "02:20:45", "text": "続いて、私は今見たばかりです"}, {"type": "subtitle", "time": 8458.87, "timestamp": "02:20:58", "text": "B 私は、ああ、それはあなたが見ているもの"}]
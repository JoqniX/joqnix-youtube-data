[{"type": "subtitle", "time": 3901.19, "timestamp": "01:05:01", "text": "手配する"}, {"type": "subtitle", "time": 3903.67, "timestamp": "01:05:03", "text": "したがって、これらは"}, {"type": "subtitle", "time": 3906.23, "timestamp": "01:05:06", "text": "ここから戻る"}, {"type": "subtitle", "time": 3909.63, "timestamp": "01:05:09", "text": "よし、そうしよう"}, {"type": "subtitle", "time": 3928.069, "timestamp": "01:05:28", "text": "[音楽]"}, {"type": "subtitle", "time": 3932.25, "timestamp": "01:05:32", "text": "よし、これを受け取って、この男を上に乗せよう"}, {"type": "subtitle", "time": 3934.549, "timestamp": "01:05:34", "text": "[音楽]"}, {"type": "subtitle", "time": 3939.47, "timestamp": "01:05:39", "text": "彼女たちのナイトドレスはこんな感じになります。"}, {"type": "subtitle", "time": 3941.109, "timestamp": "01:05:41", "text": "続けることができる"}, {"type": "subtitle", "time": 3944.95, "timestamp": "01:05:44", "text": "最高の仕事着は"}, {"type": "subtitle", "time": 3948.829, "timestamp": "01:05:48", "text": "これは一体何なの？"}, {"type": "subtitle", "time": 3953.829, "timestamp": "01:05:53", "text": "ああ、私、これを見て、ああ、待って、えっと"}, {"type": "subtitle", "time": 3955.789, "timestamp": "01:05:55", "text": "どうやって"}, {"type": "subtitle", "time": 3958.63, "timestamp": "01:05:58", "text": "まるで私が曲がりくねった空間であるかのように"}]
[{"type": "subtitle", "time": 17761.11, "timestamp": "04:56:01", "text": "私たちは皆死んでしまった。最善を尽くそう。"}, {"type": "subtitle", "time": 17762.788, "timestamp": "04:56:02", "text": "そして"}, {"type": "subtitle", "time": 17764.548, "timestamp": "04:56:04", "text": "ここにあります"}, {"type": "subtitle", "time": 17767.948, "timestamp": "04:56:07", "text": "すべては順調に進んでいた"}, {"type": "subtitle", "time": 17777.548, "timestamp": "04:56:17", "text": "あまり足音を立てない"}, {"type": "subtitle", "time": 17783.07, "timestamp": "04:56:23", "text": "男よ、走って走って、よし、時間だ"}, {"type": "subtitle", "time": 17787.788, "timestamp": "04:56:27", "text": "あなたの来来来を保留する"}, {"type": "subtitle", "time": 17791.47, "timestamp": "04:56:31", "text": "ローテーションする人たちはローテーションするよ"}, {"type": "subtitle", "time": 17797.15, "timestamp": "04:56:37", "text": "エリア"}, {"type": "subtitle", "time": 17801.31, "timestamp": "04:56:41", "text": "Mママm"}, {"type": "subtitle", "time": 17811.51, "timestamp": "04:56:51", "text": "さあ、"}]
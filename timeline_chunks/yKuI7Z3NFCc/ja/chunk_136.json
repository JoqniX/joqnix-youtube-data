[{"type": "subtitle", "time": 8160.75, "timestamp": "02:16:00", "text": "うん、そうだね"}, {"type": "subtitle", "time": 8164.91, "timestamp": "02:16:04", "text": "なかなかいい感じに機能する"}, {"type": "subtitle", "time": 8167.83, "timestamp": "02:16:07", "text": "きちんとした男性ですね。この人は読書家です。"}, {"type": "subtitle", "time": 8170.31, "timestamp": "02:16:10", "text": "本やマンガなど、"}, {"type": "subtitle", "time": 8172.95, "timestamp": "02:16:12", "text": "漫画とかゲームとか全部好き"}, {"type": "subtitle", "time": 8176.35, "timestamp": "02:16:16", "text": "ああ、スペースがなかったので"}, {"type": "subtitle", "time": 8179.069, "timestamp": "02:16:19", "text": "本を何冊か置いておいた"}, {"type": "subtitle", "time": 8187.32, "timestamp": "02:16:27", "text": "私たちは音楽ギターを手に入れました"}, {"type": "subtitle", "time": 8189.629, "timestamp": "02:16:29", "text": "[音楽]"}, {"type": "subtitle", "time": 8193.309, "timestamp": "02:16:33", "text": "すごくクールなステッカー、とてもシャスミン"}, {"type": "subtitle", "time": 8196.27, "timestamp": "02:16:36", "text": "彼の場所へ 彼の場所へ 待って、私たちは"}, {"type": "subtitle", "time": 8198.99, "timestamp": "02:16:38", "text": "結婚したとか何とか"}, {"type": "subtitle", "time": 8201.349, "timestamp": "02:16:41", "text": "おお"}, {"type": "subtitle", "time": 8206.429, "timestamp": "02:16:46", "text": "2012年、2年後、私は何だと思う？"}, {"type": "subtitle", "time": 8214.389, "timestamp": "02:16:54", "text": "ああ、カメのCHを上に置いておけるよ"}, {"type": "subtitle", "time": 8218.23, "timestamp": "02:16:58", "text": "待って、あ、カエルがここにいるよ"}, {"type": "subtitle", "time": 8219.87, "timestamp": "02:16:59", "text": "カエルは"}]
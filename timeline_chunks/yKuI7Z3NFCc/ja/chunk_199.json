[{"type": "subtitle", "time": 11941.51, "timestamp": "03:19:01", "text": "信じられない、それはバカバカしい、私は"}, {"type": "subtitle", "time": 11943.389, "timestamp": "03:19:03", "text": "なぜ彼らが私を好きなのか、まだ"}, {"type": "subtitle", "time": 11945.03, "timestamp": "03:19:05", "text": "制限または"}, {"type": "subtitle", "time": 11948.51, "timestamp": "03:19:08", "text": "何かわからない、痛みだ"}, {"type": "subtitle", "time": 11950.55, "timestamp": "03:19:10", "text": "そして、私が他の"}, {"type": "subtitle", "time": 11953.63, "timestamp": "03:19:13", "text": "カードやその他、それが尋ねられたときに"}, {"type": "subtitle", "time": 11957.349, "timestamp": "03:19:17", "text": "現実世界での検証のために私が手に入れるもの"}, {"type": "subtitle", "time": 11959.429, "timestamp": "03:19:19", "text": "私のインド人、その他そういう類のもの"}, {"type": "subtitle", "time": 11962.83, "timestamp": "03:19:22", "text": "Fです。そして、中国料理が必要です。"}, {"type": "subtitle", "time": 11964.99, "timestamp": "03:19:24", "text": "アカウント作成用の電話番号とチャット"}, {"type": "subtitle", "time": 11969.269, "timestamp": "03:19:29", "text": "そしてVioやQQなどもあるので、それはある意味"}, {"type": "subtitle", "time": 11971.95, "timestamp": "03:19:31", "text": "痛みには友達の助けが必要だ"}, {"type": "subtitle", "time": 11981.59, "timestamp": "03:19:41", "text": "ボー、でも今は、えーと"}, {"type": "subtitle", "time": 11985.229, "timestamp": "03:19:45", "text": "私がやろうとしているのはアップロードすることです"}, {"type": "subtitle", "time": 11989.11, "timestamp": "03:19:49", "text": "動画をアップロードして、"}, {"type": "subtitle", "time": 11993.95, "timestamp": "03:19:53", "text": "少なくとも少しは、えっと、何を"}, {"type": "subtitle", "time": 11996.95, "timestamp": "03:19:56", "text": "それを少しの、ええと、人々と呼ぶ"}, {"type": "subtitle", "time": 11999.87, "timestamp": "03:19:59", "text": "または相互作用または関与を見る"}]
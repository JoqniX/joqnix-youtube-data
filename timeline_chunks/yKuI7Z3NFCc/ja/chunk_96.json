[{"type": "subtitle", "time": 5761.75, "timestamp": "01:36:01", "text": "私たちのものを私たちの中に保管してください"}, {"type": "subtitle", "time": 5764.87, "timestamp": "01:36:04", "text": "ベッド、それが私が時々することだよね"}, {"type": "subtitle", "time": 5767.31, "timestamp": "01:36:07", "text": "ヘッドホンなどを下に保管しています"}, {"type": "subtitle", "time": 5769.91, "timestamp": "01:36:09", "text": "ベッドの下じゃなくて、ベッドの下ってことだよ"}, {"type": "subtitle", "time": 5773.709, "timestamp": "01:36:13", "text": "枕の下にいるから、君が好きになれる"}, {"type": "subtitle", "time": 5777.91, "timestamp": "01:36:17", "text": "枕からそれを取り上げて、"}, {"type": "subtitle", "time": 5783.64, "timestamp": "01:36:23", "text": "甘いので"}, {"type": "subtitle", "time": 5786.79, "timestamp": "01:36:26", "text": "[音楽]"}, {"type": "subtitle", "time": 5796.27, "timestamp": "01:36:36", "text": "やってみよう"}, {"type": "subtitle", "time": 5806.87, "timestamp": "01:36:46", "text": "20 これは何だったっけ、これは大きなDだった"}, {"type": "subtitle", "time": 5812.629, "timestamp": "01:36:52", "text": "2007年3月、私は寝る準備ができているので、待って"}, {"type": "subtitle", "time": 5818.03, "timestamp": "01:36:58", "text": "これは1997年の200だった。ああ、私がKだった頃"}]
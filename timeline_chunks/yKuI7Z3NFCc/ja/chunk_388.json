[{"type": "subtitle", "time": 23280.99, "timestamp": "06:28:00", "text": "緊張している 緊張している 何らかの理由で緊張していない 緊張していない"}, {"type": "subtitle", "time": 23283.35, "timestamp": "06:28:03", "text": "緊張感、不安感だと思います"}, {"type": "subtitle", "time": 23286.23, "timestamp": "06:28:06", "text": "あるいは、私は少し緊張していたのかもしれない。"}, {"type": "subtitle", "time": 23288.788, "timestamp": "06:28:08", "text": "でも、落ち着いてきた"}, {"type": "subtitle", "time": 23292.27, "timestamp": "06:28:12", "text": "私はお風呂に入っていて、"}, {"type": "subtitle", "time": 23295.548, "timestamp": "06:28:15", "text": "H を考えているんだけど、あの、私たちが"}, {"type": "subtitle", "time": 23299.03, "timestamp": "06:28:19", "text": "すべては始まります。私は何かのようなことをします。"}, {"type": "subtitle", "time": 23302.99, "timestamp": "06:28:22", "text": "えっと、準備トークって何て言うんだっけ？"}, {"type": "subtitle", "time": 23306.548, "timestamp": "06:28:26", "text": "みんなと一緒に、私は考えた"}, {"type": "subtitle", "time": 23308.51, "timestamp": "06:28:28", "text": "ニャーと鳴くように言うと、"}, {"type": "subtitle", "time": 23312.19, "timestamp": "06:28:32", "text": "このことについての一番重要なことは"}, {"type": "subtitle", "time": 23314.67, "timestamp": "06:28:34", "text": "トーナメントの勝者ではなく、"}, {"type": "subtitle", "time": 23317.35, "timestamp": "06:28:37", "text": "誰が勝てないのか、誰が悪いのか、誰が勝ったのか"}, {"type": "subtitle", "time": 23321.11, "timestamp": "06:28:41", "text": "最悪なのは誰が良かったのか、ああそれはその後のことだ"}, {"type": "subtitle", "time": 23325.868, "timestamp": "06:28:45", "text": "このイベントの後、次の数日間のこのゲーム"}, {"type": "subtitle", "time": 23329.31, "timestamp": "06:28:49", "text": "これら10人全員と、"}, {"type": "subtitle", "time": 23332.59, "timestamp": "06:28:52", "text": "参加したいヴァラーイベントに参加できませんでした"}, {"type": "subtitle", "time": 23336.15, "timestamp": "06:28:56", "text": "彼らが繋がり、一緒に遊ぶためにヴァラー"}, {"type": "subtitle", "time": 23339.83, "timestamp": "06:28:59", "text": "うん、これはよくあるゲームだよ"}]
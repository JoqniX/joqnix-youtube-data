[{"type": "subtitle", "time": 4203.01, "timestamp": "01:10:03", "text": "鉛筆"}, {"type": "subtitle", "time": 4223.91, "timestamp": "01:10:23", "text": "時間、なぜ違うのか"}, {"type": "subtitle", "time": 4227.35, "timestamp": "01:10:27", "text": "異なる色、同じ追加"}, {"type": "subtitle", "time": 4234.709, "timestamp": "01:10:34", "text": "あなたはそうしなければならない"}, {"type": "subtitle", "time": 4237.669, "timestamp": "01:10:37", "text": "冗談だよ、またこれか、アート、これら"}, {"type": "subtitle", "time": 4255.95, "timestamp": "01:10:55", "text": "はい、わかりました。それでは、"}, {"type": "subtitle", "time": 4258.65, "timestamp": "01:10:58", "text": "奇妙な場所とは"}]
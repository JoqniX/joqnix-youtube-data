[{"type": "subtitle", "time": 14353.55, "timestamp": "03:59:13", "text": "何を選ぶべきか何を選ぶべきか"}, {"type": "subtitle", "time": 14354.95, "timestamp": "03:59:14", "text": "選ぶ"}, {"type": "subtitle", "time": 14355.87, "timestamp": "03:59:15", "text": "さあ"}, {"type": "subtitle", "time": 14358.83, "timestamp": "03:59:18", "text": "みんなが"}, {"type": "subtitle", "time": 14361.469, "timestamp": "03:59:21", "text": "ここでパブで遊ぼうよ、ああ、遊ばなきゃ"}, {"type": "subtitle", "time": 14364.51, "timestamp": "03:59:24", "text": "パブ、そう、この後パブマッチは"}, {"type": "subtitle", "time": 14397.309, "timestamp": "03:59:57", "text": "私はこの遊ぶ感覚が恋しかった"}]
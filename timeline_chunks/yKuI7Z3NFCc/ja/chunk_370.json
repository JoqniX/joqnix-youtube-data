[{"type": "subtitle", "time": 22213.07, "timestamp": "06:10:13", "text": "ねえ、私が一緒に演奏できるものなら何でも演奏して"}, {"type": "subtitle", "time": 22220.708, "timestamp": "06:10:20", "text": "欲しいのは、何でもそうであるように、私は"}, {"type": "subtitle", "time": 22226.75, "timestamp": "06:10:26", "text": "ああ"}, {"type": "subtitle", "time": 22247.15, "timestamp": "06:10:47", "text": "画面が固まってしまいました。"}, {"type": "subtitle", "time": 22255.51, "timestamp": "06:10:55", "text": "押し下げられた"}]
[{"type": "subtitle", "time": 13801.79, "timestamp": "03:50:01", "text": "今日は無限弾薬大丈夫かな"}, {"type": "subtitle", "time": 13809.59, "timestamp": "03:50:09", "text": "よし、設定は大丈夫そうだ"}, {"type": "subtitle", "time": 13810.91, "timestamp": "03:50:10", "text": "は"}, {"type": "subtitle", "time": 13815.229, "timestamp": "03:50:15", "text": "間違ってる、待って、私の設定が間違ってる"}, {"type": "subtitle", "time": 13817.83, "timestamp": "03:50:17", "text": "待って、これらは私の設定ではありません。これは"}, {"type": "subtitle", "time": 13820.71, "timestamp": "03:50:20", "text": "これは私の設定ではありません。"}, {"type": "subtitle", "time": 13826.469, "timestamp": "03:50:26", "text": "設定ああ神様私の設定は"}, {"type": "subtitle", "time": 13834.75, "timestamp": "03:50:34", "text": "なぜそれがあまりにも"}, {"type": "subtitle", "time": 13837.469, "timestamp": "03:50:37", "text": "すべて設定する必要がある"}, {"type": "subtitle", "time": 13839.79, "timestamp": "03:50:39", "text": "上"}, {"type": "subtitle", "time": 13843.07, "timestamp": "03:50:43", "text": "わかった、デフォルト設定でプレイするよ"}, {"type": "subtitle", "time": 13850.189, "timestamp": "03:50:50", "text": "H アンインストールしたのに再読み込みできません"}, {"type": "subtitle", "time": 13852.95, "timestamp": "03:50:52", "text": "ゲームは、いや、私のゲームにあった"}]
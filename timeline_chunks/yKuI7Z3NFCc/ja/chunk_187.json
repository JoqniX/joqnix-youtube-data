[{"type": "subtitle", "time": 11221.429, "timestamp": "03:07:01", "text": "何と呼ぶか"}, {"type": "subtitle", "time": 11225.269, "timestamp": "03:07:05", "text": "少しの間、アナと雪の女王から"}, {"type": "subtitle", "time": 11227.71, "timestamp": "03:07:07", "text": "から行った"}, {"type": "subtitle", "time": 11233.99, "timestamp": "03:07:13", "text": "こんにちは、それで、今日来るのがどういうことかわかりますか？"}, {"type": "subtitle", "time": 11238.07, "timestamp": "03:07:18", "text": "本当に本当に楽しかったです。とても楽しめました。"}, {"type": "subtitle", "time": 11242.91, "timestamp": "03:07:22", "text": "本当に本当に楽しかったです"}, {"type": "subtitle", "time": 11249.75, "timestamp": "03:07:29", "text": "君のところへ来るよ、私を見て、そう、いや"}, {"type": "subtitle", "time": 11255.55, "timestamp": "03:07:35", "text": "できなかった、できなかった、えっと、できなかった"}, {"type": "subtitle", "time": 11258.269, "timestamp": "03:07:38", "text": "実際には何と呼ぶのか"}, {"type": "subtitle", "time": 11262.83, "timestamp": "03:07:42", "text": "ドウィ川"}, {"type": "subtitle", "time": 11267.91, "timestamp": "03:07:47", "text": "最近、痛みがさらに"}, {"type": "subtitle", "time": 11269.83, "timestamp": "03:07:49", "text": "[音楽]"}, {"type": "subtitle", "time": 11272.309, "timestamp": "03:07:52", "text": "でも、今日は楽しかったよ。掃除もしたしね。"}, {"type": "subtitle", "time": 11275.269, "timestamp": "03:07:55", "text": "たくさん片付けられていない、配置されたように"}, {"type": "subtitle", "time": 11278.229, "timestamp": "03:07:58", "text": "すごくいいものがたくさんあって、楽しかった！"}, {"type": "subtitle", "time": 11279.429, "timestamp": "03:07:59", "text": "うん"}]
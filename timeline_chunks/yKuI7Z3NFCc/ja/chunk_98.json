[{"type": "subtitle", "time": 5883.55, "timestamp": "01:38:03", "text": "すごい、いくつかのもの"}, {"type": "subtitle", "time": 5886.27, "timestamp": "01:38:06", "text": "わかった、それは"}, {"type": "subtitle", "time": 5900.51, "timestamp": "01:38:20", "text": "日記、待って、ここはリビングルームだよね？"}, {"type": "subtitle", "time": 5904.39, "timestamp": "01:38:24", "text": "寝室は、ああ神様、私の寝室は"}, {"type": "subtitle", "time": 5911.91, "timestamp": "01:38:31", "text": "ああ、私はああ"}, {"type": "subtitle", "time": 5914.43, "timestamp": "01:38:34", "text": "わあ、わあ、わあ"}, {"type": "subtitle", "time": 5927.95, "timestamp": "01:38:47", "text": "ダムのバスルームはとても"}, {"type": "subtitle", "time": 5934.03, "timestamp": "01:38:54", "text": "それで行く"}, {"type": "subtitle", "time": 5936.27, "timestamp": "01:38:56", "text": "これは"}]
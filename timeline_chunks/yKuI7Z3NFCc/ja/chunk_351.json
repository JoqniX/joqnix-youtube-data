[{"type": "subtitle", "time": 21061.708, "timestamp": "05:51:01", "text": "うん、見るよ"}, {"type": "subtitle", "time": 21065.868, "timestamp": "05:51:05", "text": "真ん中で壁を作った方がいいかな、そっちの方がいいかも"}, {"type": "subtitle", "time": 21069.03, "timestamp": "05:51:09", "text": "ああ、その方がいいですね。待ってください。"}, {"type": "subtitle", "time": 21071.59, "timestamp": "05:51:11", "text": "誰かを見かける"}, {"type": "subtitle", "time": 21075.15, "timestamp": "05:51:15", "text": "すると、いやいや、そこに"}, {"type": "subtitle", "time": 21095.83, "timestamp": "05:51:35", "text": "彼らを外に出して、彼らを外に出して、彼らは、彼らは持っている"}, {"type": "subtitle", "time": 21098.23, "timestamp": "05:51:38", "text": "花を摘み取らなければならない"}, {"type": "subtitle", "time": 21101.03, "timestamp": "05:51:41", "text": "Bが来る"}, {"type": "subtitle", "time": 21106.91, "timestamp": "05:51:46", "text": "はい、壁を破る"}, {"type": "subtitle", "time": 21109.468, "timestamp": "05:51:49", "text": "壁がスパイクを通す スパイクを通す"}, {"type": "subtitle", "time": 21111.83, "timestamp": "05:51:51", "text": "キャリアーが来て、待って、待って、そして"}, {"type": "subtitle", "time": 21113.468, "timestamp": "05:51:53", "text": "遊んで、握って、押さないで"}, {"type": "subtitle", "time": 21114.628, "timestamp": "05:51:54", "text": "しないで"}, {"type": "subtitle", "time": 21116.75, "timestamp": "05:51:56", "text": "押す"}]
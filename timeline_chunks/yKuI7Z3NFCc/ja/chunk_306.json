[{"type": "subtitle", "time": 18361.11, "timestamp": "05:06:01", "text": "川"}, {"type": "subtitle", "time": 18364.35, "timestamp": "05:06:04", "text": "ソウル、ありがとう、買ってくれた人、ありがとう"}, {"type": "subtitle", "time": 18365.868, "timestamp": "05:06:05", "text": "自分"}, {"type": "subtitle", "time": 18368.11, "timestamp": "05:06:08", "text": "えーと"}, {"type": "subtitle", "time": 18371.91, "timestamp": "05:06:11", "text": "考えないで、あなた自身を手に入れることができる"}, {"type": "subtitle", "time": 18374.19, "timestamp": "05:06:14", "text": "自分で、みんな、"}, {"type": "subtitle", "time": 18378.59, "timestamp": "05:06:18", "text": "足跡はここにあります、わかりました、お見せします"}, {"type": "subtitle", "time": 18381.43, "timestamp": "05:06:21", "text": "あなたが行くなら、私たちは終わります。"}, {"type": "subtitle", "time": 18383.628, "timestamp": "05:06:23", "text": "うん、それは待って待って待って待って私は"}, {"type": "subtitle", "time": 18399.788, "timestamp": "05:06:39", "text": "私たち、このエリアの壁"}, {"type": "subtitle", "time": 18411.59, "timestamp": "05:06:51", "text": "ああ、彼らが来る"}, {"type": "subtitle", "time": 18415.548, "timestamp": "05:06:55", "text": "うわぁ、一体何なんだ"}, {"type": "subtitle", "time": 18418.31, "timestamp": "05:06:58", "text": "えっと、ローテーションで"}]
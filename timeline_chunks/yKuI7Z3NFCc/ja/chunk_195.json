[{"type": "subtitle", "time": 11700.389, "timestamp": "03:15:00", "text": "オンだけど、ええ、主に私は主に"}, {"type": "subtitle", "time": 11702.55, "timestamp": "03:15:02", "text": "主にYouTubeを作りたい"}, {"type": "subtitle", "time": 11705.229, "timestamp": "03:15:05", "text": "ファミリアとトゥイッチファミリアのような"}, {"type": "subtitle", "time": 11707.63, "timestamp": "03:15:07", "text": "一緒に同期した 同期した"}, {"type": "subtitle", "time": 11710.99, "timestamp": "03:15:10", "text": "一緒にという意味は、私は通常そうしません。"}, {"type": "subtitle", "time": 11713.429, "timestamp": "03:15:13", "text": "数字は気にするけど、"}, {"type": "subtitle", "time": 11715.59, "timestamp": "03:15:15", "text": "いくら持っているか分からない"}, {"type": "subtitle", "time": 11717.59, "timestamp": "03:15:17", "text": "今YouTubeで見ていますが"}, {"type": "subtitle", "time": 11720.95, "timestamp": "03:15:20", "text": "ここには、Twitch で 463 と書いてあります"}, {"type": "subtitle", "time": 11724.51, "timestamp": "03:15:24", "text": "要約すると、もしそれが463なら"}, {"type": "subtitle", "time": 11728.269, "timestamp": "03:15:28", "text": "Twitchのフォロワーを増やしたいのですが、"}, {"type": "subtitle", "time": 11731.67, "timestamp": "03:15:31", "text": "YouTubeで同じ数に到達する"}, {"type": "subtitle", "time": 11733.51, "timestamp": "03:15:33", "text": "CUもなぜ"}, {"type": "subtitle", "time": 11735.07, "timestamp": "03:15:35", "text": "ない"}, {"type": "subtitle", "time": 11739.91, "timestamp": "03:15:39", "text": "ええ、たとえTwitchが最初のホームであっても"}, {"type": "subtitle", "time": 11743.55, "timestamp": "03:15:43", "text": "私の、えっと、何て言うんだっけ"}, {"type": "subtitle", "time": 11746.389, "timestamp": "03:15:46", "text": "私がストリーミングを始めたのは、"}, {"type": "subtitle", "time": 11747.55, "timestamp": "03:15:47", "text": "そして"}, {"type": "subtitle", "time": 11750.189, "timestamp": "03:15:50", "text": "自分の経験から学んだことなど色々あるけど、まあ"}, {"type": "subtitle", "time": 11753.55, "timestamp": "03:15:53", "text": "この番号を次のようにしたい"}, {"type": "subtitle", "time": 11756.55, "timestamp": "03:15:56", "text": "均等化されていると言って、元に戻したくない"}]
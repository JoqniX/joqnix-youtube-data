[{"type": "subtitle", "time": 8342.509, "timestamp": "02:19:02", "text": "テンプレートはどこに保存すればいいですか？"}, {"type": "subtitle", "time": 8345.03, "timestamp": "02:19:05", "text": "コンピューターや"}, {"type": "subtitle", "time": 8348.27, "timestamp": "02:19:08", "text": "何かまだ3つのスポット2つ"}, {"type": "subtitle", "time": 8353.669, "timestamp": "02:19:13", "text": "トイレをする場所と、えーとこれ"}, {"type": "subtitle", "time": 8358.15, "timestamp": "02:19:18", "text": "そうですね、この2つの場所は大丈夫です"}, {"type": "subtitle", "time": 8361.95, "timestamp": "02:19:21", "text": "それでは箱を開けてみましょう"}, {"type": "subtitle", "time": 8366.19, "timestamp": "02:19:26", "text": "写真があれば、これはここにあります"}, {"type": "subtitle", "time": 8369.389, "timestamp": "02:19:29", "text": "エッセンスって感じ"}, {"type": "subtitle", "time": 8373.83, "timestamp": "02:19:33", "text": "いいえ、これはチキンCHはここにあります"}, {"type": "subtitle", "time": 8378.549, "timestamp": "02:19:38", "text": "あなたの小さなハワイのひよこと孵化"}, {"type": "subtitle", "time": 8382.07, "timestamp": "02:19:42", "text": "チェックとかわいいかわいい"}, {"type": "subtitle", "time": 8384.75, "timestamp": "02:19:44", "text": "チキン、これは何？"}, {"type": "subtitle", "time": 8388.07, "timestamp": "02:19:48", "text": "えっと、服"}, {"type": "subtitle", "time": 8391.27, "timestamp": "02:19:51", "text": "えっと、待って、服なの？待って、なんで私は"}, {"type": "subtitle", "time": 8393.469, "timestamp": "02:19:53", "text": "これはこれだと思う、これはあれだ"}, {"type": "subtitle", "time": 8396.79, "timestamp": "02:19:56", "text": "お湯を入れる場所"}, {"type": "subtitle", "time": 8398.99, "timestamp": "02:19:58", "text": "水か何かで塗って"}]
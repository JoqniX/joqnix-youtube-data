[{"type": "subtitle", "time": 19862.19, "timestamp": "05:31:02", "text": "明らかに最良の選択肢です。問題ありません。"}, {"type": "subtitle", "time": 19863.39, "timestamp": "05:31:03", "text": "タバコを吸って"}, {"type": "subtitle", "time": 19870.99, "timestamp": "05:31:10", "text": "ああ、彼はラインナップを作るのが得意なんだ"}, {"type": "subtitle", "time": 19874.43, "timestamp": "05:31:14", "text": "だから、私が裏切りに対処する"}, {"type": "subtitle", "time": 19876.51, "timestamp": "05:31:16", "text": "もしあれば、煙は使わないでください"}, {"type": "subtitle", "time": 19878.43, "timestamp": "05:31:18", "text": "使用する"}, {"type": "subtitle", "time": 19885.27, "timestamp": "05:31:25", "text": "まっすぐこれ"}, {"type": "subtitle", "time": 19898.548, "timestamp": "05:31:38", "text": "タグ ここには1つあります 待ってください"}, {"type": "subtitle", "time": 19900.788, "timestamp": "05:31:40", "text": "よし、入って"}, {"type": "subtitle", "time": 19904.19, "timestamp": "05:31:44", "text": "セージが行くよ"}, {"type": "subtitle", "time": 19908.628, "timestamp": "05:31:48", "text": "セージ、続けて、続けて。私はここで見ているだけ"}, {"type": "subtitle", "time": 19911.788, "timestamp": "05:31:51", "text": "植える、覆う、覆う、植える"}, {"type": "subtitle", "time": 19915.15, "timestamp": "05:31:55", "text": "カバー カバー カバー ジョー ファスト"}, {"type": "subtitle", "time": 19917.31, "timestamp": "05:31:57", "text": "ファストバックステップバックステップバックステップバック"}]
[{"type": "subtitle", "time": 12543.349, "timestamp": "03:29:03", "text": "Discordの公式"}, {"type": "subtitle", "time": 12549.07, "timestamp": "03:29:09", "text": "えっと、ここはどこですか？Discordのタウンホール"}, {"type": "subtitle", "time": 12550.83, "timestamp": "03:29:10", "text": "はい、Discordトンネルが必要な場合は"}, {"type": "subtitle", "time": 12553.91, "timestamp": "03:29:13", "text": "こんなことに気づくかもしれません"}, {"type": "subtitle", "time": 12556.189, "timestamp": "03:29:16", "text": "カスタマイズされた質問これは何か"}, {"type": "subtitle", "time": 12558.03, "timestamp": "03:29:18", "text": "が来る"}, {"type": "subtitle", "time": 12559.91, "timestamp": "03:29:19", "text": "何かがやってくるように"}, {"type": "subtitle", "time": 12563.349, "timestamp": "03:29:23", "text": "Discordはまもなく全サーバーで利用可能になります。"}, {"type": "subtitle", "time": 12565.87, "timestamp": "03:29:25", "text": "コミュニティはサーバーを有効にするので、私は"}, {"type": "subtitle", "time": 12569.229, "timestamp": "03:29:29", "text": "長い困難な方法に変わる"}, {"type": "subtitle", "time": 12572.429, "timestamp": "03:29:32", "text": "役を得るので、ここではただ"}, {"type": "subtitle", "time": 12574.469, "timestamp": "03:29:34", "text": "どこへでも連れて行って"}, {"type": "subtitle", "time": 12577.389, "timestamp": "03:29:37", "text": "アジアでの役割を獲得します"}, {"type": "subtitle", "time": 12580.349, "timestamp": "03:29:40", "text": "そうすることで、より簡単に"}, {"type": "subtitle", "time": 12583.429, "timestamp": "03:29:43", "text": "このような役割は、質疑応答のようなものです"}, {"type": "subtitle", "time": 12585.229, "timestamp": "03:29:45", "text": "多肢選択問題のようなもの"}, {"type": "subtitle", "time": 12587.389, "timestamp": "03:29:47", "text": "そういうことなので、もっと良いですよね"}, {"type": "subtitle", "time": 12591.189, "timestamp": "03:29:51", "text": "そう、それで私は修理するつもりです"}, {"type": "subtitle", "time": 12593.75, "timestamp": "03:29:53", "text": "いつかサーバーを作ろうと思う。だってすごくごちゃごちゃしてるから。"}, {"type": "subtitle", "time": 12596.51, "timestamp": "03:29:56", "text": "わからないけど、うん、君も好きだよ"}, {"type": "subtitle", "time": 12598.389, "timestamp": "03:29:58", "text": "どのチャンネルを選ぶことができますか"}]
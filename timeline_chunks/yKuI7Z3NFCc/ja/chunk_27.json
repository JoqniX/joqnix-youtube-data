[{"type": "subtitle", "time": 1620.269, "timestamp": "00:27:00", "text": "ええ、テレビはどこに置きますか？"}, {"type": "subtitle", "time": 1622.99, "timestamp": "00:27:02", "text": "とはいえ、私はそれを"}, {"type": "subtitle", "time": 1625.75, "timestamp": "00:27:05", "text": "下"}, {"type": "subtitle", "time": 1628.35, "timestamp": "00:27:08", "text": "クレヨン"}, {"type": "subtitle", "time": 1633.75, "timestamp": "00:27:13", "text": "キー、これらのカセットは何ですか？ああ、マウスああ"}, {"type": "subtitle", "time": 1636.23, "timestamp": "00:27:16", "text": "ああ、わかった、それを上に置かなきゃ"}, {"type": "subtitle", "time": 1639.269, "timestamp": "00:27:19", "text": "大丈夫、わかった、わかった、わかった、わかった"}, {"type": "subtitle", "time": 1642.07, "timestamp": "00:27:22", "text": "別のものを手に入れた"}, {"type": "subtitle", "time": 1646.07, "timestamp": "00:27:26", "text": "別の本をもう一冊、もう一冊の本をよし。"}, {"type": "subtitle", "time": 1648.43, "timestamp": "00:27:28", "text": "本をこちらに置きましょう"}, {"type": "subtitle", "time": 1651.11, "timestamp": "00:27:31", "text": "[音楽]"}, {"type": "subtitle", "time": 1656.269, "timestamp": "00:27:36", "text": "今から手配します"}, {"type": "subtitle", "time": 1660.029, "timestamp": "00:27:40", "text": "これはマウスパッドのように見えますが"}, {"type": "subtitle", "time": 1661.43, "timestamp": "00:27:41", "text": "マウスが"}, {"type": "subtitle", "time": 1666.63, "timestamp": "00:27:46", "text": "行って、これはベッドの上でひどいことになる"}, {"type": "subtitle", "time": 1668.35, "timestamp": "00:27:48", "text": "悪い"}, {"type": "subtitle", "time": 1677.269, "timestamp": "00:27:57", "text": "スペースがあるはずです、はい、あるはずです"}, {"type": "subtitle", "time": 1679.59, "timestamp": "00:27:59", "text": "宇宙"}]
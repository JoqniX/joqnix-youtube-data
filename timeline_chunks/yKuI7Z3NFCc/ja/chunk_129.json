[{"type": "subtitle", "time": 7743.79, "timestamp": "02:09:03", "text": "予期せぬことが起こったので、"}, {"type": "subtitle", "time": 7747.95, "timestamp": "02:09:07", "text": "そしてStとMを少しの間プレイします、いいですか"}, {"type": "subtitle", "time": 7751.95, "timestamp": "02:09:11", "text": "イベントで、これが何だと思う？"}, {"type": "subtitle", "time": 7754.95, "timestamp": "02:09:14", "text": "すべて"}, {"type": "subtitle", "time": 7759.47, "timestamp": "02:09:19", "text": "僕たちはランダムに列に並んでパーティーをする"}, {"type": "subtitle", "time": 7762.27, "timestamp": "02:09:22", "text": "敵チームは何て感じ"}, {"type": "subtitle", "time": 7765.27, "timestamp": "02:09:25", "text": "えっと、私は"}, {"type": "subtitle", "time": 7767.03, "timestamp": "02:09:27", "text": "ミズ"}, {"type": "subtitle", "time": 7771.549, "timestamp": "02:09:31", "text": "そして、私にとってはジュースの日で、私たちは"}, {"type": "subtitle", "time": 7774.79, "timestamp": "02:09:34", "text": "みんな「ああ、神様、私と"}, {"type": "subtitle", "time": 7777.83, "timestamp": "02:09:37", "text": "試合は、えーっと、まるで"}, {"type": "subtitle", "time": 7780.87, "timestamp": "02:09:40", "text": "どちらも同じくらい難しかった"}, {"type": "subtitle", "time": 7783.35, "timestamp": "02:09:43", "text": "そう、なんて言うんだっけ、それは"}, {"type": "subtitle", "time": 7787.549, "timestamp": "02:09:47", "text": "えっと、12、13、13は彼らのためのもので、彼らは勝ちました"}, {"type": "subtitle", "time": 7791.589, "timestamp": "02:09:51", "text": "でも楽しいゲームだったよ、えー"}, {"type": "subtitle", "time": 7795.03, "timestamp": "02:09:55", "text": "私を殺したことがあるなら、見せてよ"}]
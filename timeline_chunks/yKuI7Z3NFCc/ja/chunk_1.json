[{"type": "subtitle", "time": 61.509, "timestamp": "00:01:01", "text": "眠れ 私は一晩中起きていた 神よ"}, {"type": "subtitle", "time": 63.75, "timestamp": "00:01:03", "text": "聖なる"}, {"type": "subtitle", "time": 73.749, "timestamp": "00:01:13", "text": "すべてと私の体"}, {"type": "subtitle", "time": 82.95, "timestamp": "00:01:22", "text": "体が痛くて開けることもできない"}, {"type": "subtitle", "time": 85.23, "timestamp": "00:01:25", "text": "私の"}, {"type": "subtitle", "time": 88.749, "timestamp": "00:01:28", "text": "目 私は 私は 私は好き"}, {"type": "subtitle", "time": 91.31, "timestamp": "00:01:31", "text": "これは一般論ではないので、"}]
[{"type": "subtitle", "time": 18842.35, "timestamp": "05:14:02", "text": "いいですね、彼らが来るのを待ってください"}, {"type": "subtitle", "time": 18855.548, "timestamp": "05:14:15", "text": "どうして私がここにいるって分かったの？"}, {"type": "subtitle", "time": 18875.03, "timestamp": "05:14:35", "text": "彼"}, {"type": "subtitle", "time": 18885.51, "timestamp": "05:14:45", "text": "ジョー、なぜ荷物を買わなかったの？"}, {"type": "subtitle", "time": 18896.548, "timestamp": "05:14:56", "text": "いやいやいや、中は"}, {"type": "subtitle", "time": 18899.83, "timestamp": "05:14:59", "text": "さあ行こう、さあ行こう、さあ行こう、もう一度"}]
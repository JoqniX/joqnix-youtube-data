[{"type": "subtitle", "time": 8101.31, "timestamp": "02:15:01", "text": "近くにいないといけないよ、やったー、やったね"}, {"type": "subtitle", "time": 8102.95, "timestamp": "02:15:02", "text": "私たちは"}, {"type": "subtitle", "time": 8106.31, "timestamp": "02:15:06", "text": "テディ、待って、もしかしたらテディを飼えるかも"}, {"type": "subtitle", "time": 8115.27, "timestamp": "02:15:15", "text": "わかってるけど、もし寝てたら"}, {"type": "subtitle", "time": 8117.27, "timestamp": "02:15:17", "text": "テディを連れて寝る"}, {"type": "subtitle", "time": 8127.91, "timestamp": "02:15:27", "text": "ああ、ほとんどのものはそうだと思うよ。"}, {"type": "subtitle", "time": 8139.31, "timestamp": "02:15:39", "text": "待って、これはここにあるべきで、ここにあるべき"}, {"type": "subtitle", "time": 8142.95, "timestamp": "02:15:42", "text": "これは"}, {"type": "subtitle", "time": 8145.069, "timestamp": "02:15:45", "text": "うん、みんな"}, {"type": "subtitle", "time": 8150.27, "timestamp": "02:15:50", "text": "そうですね、残りのものは"}, {"type": "subtitle", "time": 8152.43, "timestamp": "02:15:52", "text": "良い"}]
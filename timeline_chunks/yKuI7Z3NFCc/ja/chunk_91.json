[{"type": "subtitle", "time": 5461.189, "timestamp": "01:31:01", "text": "[音楽]"}, {"type": "subtitle", "time": 5465.47, "timestamp": "01:31:05", "text": "わかった、あと、あなたの息子はどうですか、こんにちはソフィー"}, {"type": "subtitle", "time": 5468.87, "timestamp": "01:31:08", "text": "息子よ、元気でいるといいな。"}, {"type": "subtitle", "time": 5477.95, "timestamp": "01:31:17", "text": "今日は、こんにちはジョー、悪い知らせです、えっと、何？"}, {"type": "subtitle", "time": 5481.109, "timestamp": "01:31:21", "text": "何が起こったのか、いや、何が起こったのか"}, {"type": "subtitle", "time": 5503.669, "timestamp": "01:31:43", "text": "ハニー、ラジオはどこに置けばいいの？"}, {"type": "subtitle", "time": 5505.61, "timestamp": "01:31:45", "text": "ああ、待って、ラジオは"}, {"type": "subtitle", "time": 5508.39, "timestamp": "01:31:48", "text": "[音楽]"}, {"type": "subtitle", "time": 5512.31, "timestamp": "01:31:52", "text": "誰がダイニングにラジオを置くことができるか"}, {"type": "subtitle", "time": 5514.39, "timestamp": "01:31:54", "text": "テーブル ナ"}, {"type": "subtitle", "time": 5518.59, "timestamp": "01:31:58", "text": "今は上が良い場所だと思います。"}]
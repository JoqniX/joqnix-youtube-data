[{"type": "subtitle", "time": 19682.51, "timestamp": "05:28:02", "text": "標準的には、今はそのままにしておくと言いたいところですが、わかりました。"}, {"type": "subtitle", "time": 19684.948, "timestamp": "05:28:04", "text": "うーん、次の２つを考えてみます"}, {"type": "subtitle", "time": 19687.57, "timestamp": "05:28:07", "text": "マッチ"}, {"type": "subtitle", "time": 19705.35, "timestamp": "05:28:25", "text": "ああ、と言っている"}, {"type": "subtitle", "time": 19707.83, "timestamp": "05:28:27", "text": "申し訳ありませんが、音声を開いてください。"}, {"type": "subtitle", "time": 19711.99, "timestamp": "05:28:31", "text": "CH 私はオーメンフェニックスやセージをプレイできます"}, {"type": "subtitle", "time": 19713.35, "timestamp": "05:28:33", "text": "私は"}, {"type": "subtitle", "time": 19719.11, "timestamp": "05:28:39", "text": "フェニックスを選んで、いいよ、いいよ、言って"}, {"type": "subtitle", "time": 19722.51, "timestamp": "05:28:42", "text": "舞台のための魂"}, {"type": "subtitle", "time": 19724.948, "timestamp": "05:28:44", "text": "よし、リアは"}, {"type": "subtitle", "time": 19727.47, "timestamp": "05:28:47", "text": "チャンバー"}]
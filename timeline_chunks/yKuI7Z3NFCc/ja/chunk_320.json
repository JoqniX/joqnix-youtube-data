[{"type": "subtitle", "time": 19219.708, "timestamp": "05:20:19", "text": "ああ、そして今彼らは「なんてこった」と言っている"}, {"type": "subtitle", "time": 19242.788, "timestamp": "05:20:42", "text": "私は"}, {"type": "subtitle", "time": 19245.47, "timestamp": "05:20:45", "text": "だからワイパーは"}, {"type": "subtitle", "time": 19249.868, "timestamp": "05:20:49", "text": "いい感じですね"}, {"type": "subtitle", "time": 19253.15, "timestamp": "05:20:53", "text": "スパイク"}, {"type": "subtitle", "time": 19255.27, "timestamp": "05:20:55", "text": "そうだ、彼女は"}, {"type": "subtitle", "time": 19259.43, "timestamp": "05:20:59", "text": "ここで待って待って"}]
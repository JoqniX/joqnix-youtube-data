[{"type": "subtitle", "time": 3671.95, "timestamp": "01:01:11", "text": "[音楽]"}, {"type": "subtitle", "time": 3680.51, "timestamp": "01:01:20", "text": "面白いですね、かっこいいと思いますか？"}, {"type": "subtitle", "time": 3684.23, "timestamp": "01:01:24", "text": "いい感じに整えられてる、ああ神様、あなたは"}, {"type": "subtitle", "time": 3686.029, "timestamp": "01:01:26", "text": "それは"}, {"type": "subtitle", "time": 3688.309, "timestamp": "01:01:28", "text": "適切に配置"}, {"type": "subtitle", "time": 3691.19, "timestamp": "01:01:31", "text": "今はそうではない"}, {"type": "subtitle", "time": 3694.15, "timestamp": "01:01:34", "text": "知ってるよ、それ"}, {"type": "subtitle", "time": 3699.13, "timestamp": "01:01:39", "text": "傷がついた場所のようです"}, {"type": "subtitle", "time": 3712.789, "timestamp": "01:01:52", "text": "床 5月はベッドの上におもちゃを置いておくことは"}]
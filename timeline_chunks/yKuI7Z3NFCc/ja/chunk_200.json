[{"type": "subtitle", "time": 12002.429, "timestamp": "03:20:02", "text": "だから、ビリーは、これは"}, {"type": "subtitle", "time": 12005.71, "timestamp": "03:20:05", "text": "実際にはアクティブチャンネルと"}, {"type": "subtitle", "time": 12009.95, "timestamp": "03:20:09", "text": "ほら、君みたいな感じ"}, {"type": "subtitle", "time": 12012.03, "timestamp": "03:20:12", "text": "こっそりライブストリームを視聴する"}, {"type": "subtitle", "time": 12016.99, "timestamp": "03:20:16", "text": "能力とか何かね、ウインク、でも"}, {"type": "subtitle", "time": 12019.429, "timestamp": "03:20:19", "text": "誰でもライブ配信できるもの"}, {"type": "subtitle", "time": 12021.269, "timestamp": "03:20:21", "text": "アカウントが認証され、"}, {"type": "subtitle", "time": 12023.189, "timestamp": "03:20:23", "text": "検証済みという意味で、すべて同様です"}, {"type": "subtitle", "time": 12025.83, "timestamp": "03:20:25", "text": "セキュリティ関連の質問と回答など"}, {"type": "subtitle", "time": 12029.309, "timestamp": "03:20:29", "text": "100～120項目くらい記入する必要がある"}, {"type": "subtitle", "time": 12031.79, "timestamp": "03:20:31", "text": "質問やその他、完全にアクティベートするためのもの"}, {"type": "subtitle", "time": 12033.75, "timestamp": "03:20:33", "text": "あなたのコンテンツなどは、ちょっと痛いです"}, {"type": "subtitle", "time": 12036.63, "timestamp": "03:20:36", "text": "でも私はそれを全部やったけど"}, {"type": "subtitle", "time": 12039.59, "timestamp": "03:20:39", "text": "それでも痛みはあるけれど、いつかは良くなる"}, {"type": "subtitle", "time": 12043.55, "timestamp": "03:20:43", "text": "いつかはそうだけど、ジョイって言う人もいるだろう"}, {"type": "subtitle", "time": 12046.229, "timestamp": "03:20:46", "text": "billybilly.tvでストリーミングできます。"}, {"type": "subtitle", "time": 12048.91, "timestamp": "03:20:48", "text": "それは、えーっと、何ですか"}, {"type": "subtitle", "time": 12053.15, "timestamp": "03:20:53", "text": "それはタイと呼ぶ"}, {"type": "subtitle", "time": 12055.59, "timestamp": "03:20:55", "text": "インドネシア語版ですね。"}, {"type": "subtitle", "time": 12057.55, "timestamp": "03:20:57", "text": "海外版"}]
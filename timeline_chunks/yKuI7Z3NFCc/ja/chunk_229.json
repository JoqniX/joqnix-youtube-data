[{"type": "subtitle", "time": 13740.99, "timestamp": "03:49:00", "text": "失くした"}, {"type": "subtitle", "time": 13742.59, "timestamp": "03:49:02", "text": "わかった"}, {"type": "subtitle", "time": 13744.11, "timestamp": "03:49:04", "text": "いいえ"}, {"type": "subtitle", "time": 13746.07, "timestamp": "03:49:06", "text": "実際になぜ"}, {"type": "subtitle", "time": 13748.229, "timestamp": "03:49:08", "text": "私は"}, {"type": "subtitle", "time": 13753.149, "timestamp": "03:49:13", "text": "そこにいて、実際に"}, {"type": "subtitle", "time": 13759.75, "timestamp": "03:49:19", "text": "大丈夫です、とにかく"}, {"type": "subtitle", "time": 13762.55, "timestamp": "03:49:22", "text": "プレイする"}, {"type": "subtitle", "time": 13767.59, "timestamp": "03:49:27", "text": "えっと、Bロイヤルって何？待って、何？"}, {"type": "subtitle", "time": 13770.389, "timestamp": "03:49:30", "text": "a b Royale 私はこのゲームをプレイしていません"}, {"type": "subtitle", "time": 13772.67, "timestamp": "03:49:32", "text": "しばらくして、発砲に移りましょう"}, {"type": "subtitle", "time": 13776.03, "timestamp": "03:49:36", "text": "それまで少しの間範囲を教えて、私の"}, {"type": "subtitle", "time": 13778.59, "timestamp": "03:49:38", "text": "マウス設定"}, {"type": "subtitle", "time": 13782.429, "timestamp": "03:49:42", "text": "えっと、フォートナイトをエイペックスに変えましょう"}, {"type": "subtitle", "time": 13785.59, "timestamp": "03:49:45", "text": "シーズン、そうだね"}, {"type": "subtitle", "time": 13789.309, "timestamp": "03:49:49", "text": "よし、行こう、私にさせて、私にさせて、私にさせて"}, {"type": "subtitle", "time": 13792.229, "timestamp": "03:49:52", "text": "これを設定して、私たちは、私たちは"}, {"type": "subtitle", "time": 13794.189, "timestamp": "03:49:54", "text": "ひび割れ 今日はひび割れるだろう"}, {"type": "subtitle", "time": 13796.95, "timestamp": "03:49:56", "text": "私たちは自分たち自身を訓練するつもりです"}]
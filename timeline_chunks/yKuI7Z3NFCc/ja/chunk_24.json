[{"type": "subtitle", "time": 1441.59, "timestamp": "00:24:01", "text": "部屋A これは何ですか、ええと、これは"}, {"type": "subtitle", "time": 1450.35, "timestamp": "00:24:10", "text": "はい、ついに自分のランニングです。これは何ですか？"}, {"type": "subtitle", "time": 1452.95, "timestamp": "00:24:12", "text": "カメラをリセットして調理する"}, {"type": "subtitle", "time": 1456.19, "timestamp": "00:24:16", "text": "再生すると、すべてのものが再生されます"}, {"type": "subtitle", "time": 1466.19, "timestamp": "00:24:26", "text": "twitch からのものだったのか、それとも"}, {"type": "subtitle", "time": 1468.87, "timestamp": "00:24:28", "text": "Streamlabs なぜなら、私の Twitch にアクセスすれば"}, {"type": "subtitle", "time": 1470.95, "timestamp": "00:24:30", "text": "チャンネルを右に動かすと、チャンネルが開きます。"}, {"type": "subtitle", "time": 1484.19, "timestamp": "00:24:44", "text": "ストリームラボ"}, {"type": "subtitle", "time": 1487.669, "timestamp": "00:24:47", "text": "[音楽]"}, {"type": "subtitle", "time": 1490.59, "timestamp": "00:24:50", "text": "わかった"}, {"type": "subtitle", "time": 1496.89, "timestamp": "00:24:56", "text": "2004年"}, {"type": "subtitle", "time": 1499.99, "timestamp": "00:24:59", "text": "[音楽]"}]
[{"type": "subtitle", "time": 7578.79, "timestamp": "02:06:18", "text": "ああ、神様、うっかり触ってしまった"}, {"type": "subtitle", "time": 7581.31, "timestamp": "02:06:21", "text": "マイクを顎で押さえてミュートした"}, {"type": "subtitle", "time": 7586.39, "timestamp": "02:06:26", "text": "[音楽]"}, {"type": "subtitle", "time": 7589.149, "timestamp": "02:06:29", "text": "掃除して遊んでいるとき、私が"}, {"type": "subtitle", "time": 7592.87, "timestamp": "02:06:32", "text": "部屋を掃除するには、"}, {"type": "subtitle", "time": 7596.51, "timestamp": "02:06:36", "text": "完全に埃が落ちていることを確認するために、その日を過ごす"}, {"type": "subtitle", "time": 7600.51, "timestamp": "02:06:40", "text": "隅々まで綺麗に掃除すれば"}, {"type": "subtitle", "time": 7603.5, "timestamp": "02:06:43", "text": "アレンジメントの件"}, {"type": "subtitle", "time": 7611.149, "timestamp": "02:06:51", "text": "すべてに時間がかかるので、"}, {"type": "subtitle", "time": 7613.51, "timestamp": "02:06:53", "text": "理由を知る"}, {"type": "subtitle", "time": 7616.87, "timestamp": "02:06:56", "text": "私が"}]
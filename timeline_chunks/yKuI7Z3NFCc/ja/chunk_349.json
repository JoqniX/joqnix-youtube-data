[{"type": "subtitle", "time": 20943.548, "timestamp": "05:49:03", "text": "ボ・ジョン"}, {"type": "subtitle", "time": 20959.15, "timestamp": "05:49:19", "text": "僕が戻ってきたよ、待って"}, {"type": "subtitle", "time": 20962.59, "timestamp": "05:49:22", "text": "待って、誰かが来るから、ただ待って、誰かが来るのを待つ"}, {"type": "subtitle", "time": 20969.788, "timestamp": "05:49:29", "text": "急ぐ"}, {"type": "subtitle", "time": 20972.59, "timestamp": "05:49:32", "text": "待って待って待って待って待って待って待って待って"}, {"type": "subtitle", "time": 20976.11, "timestamp": "05:49:36", "text": "まだ時間があるよ、ああ神様"}, {"type": "subtitle", "time": 20977.548, "timestamp": "05:49:37", "text": "女性死亡"}, {"type": "subtitle", "time": 20980.43, "timestamp": "05:49:40", "text": "わかった、バックスタブするよ"}]
[{"type": "subtitle", "time": 1382.51, "timestamp": "00:23:02", "text": "実際にはもう一人来る人がいる"}, {"type": "subtitle", "time": 1410.11, "timestamp": "00:23:30", "text": "えっと、もしあなたが聞いたら、"}, {"type": "subtitle", "time": 1411.909, "timestamp": "00:23:31", "text": "それは私に"}, {"type": "subtitle", "time": 1414.19, "timestamp": "00:23:34", "text": "知らない"}, {"type": "subtitle", "time": 1415.95, "timestamp": "00:23:35", "text": "音"}, {"type": "subtitle", "time": 1418.909, "timestamp": "00:23:38", "text": "えっ、それは"}, {"type": "subtitle", "time": 1422.149, "timestamp": "00:23:42", "text": "変だね、聞こえるよ、聞こえるよ"}, {"type": "subtitle", "time": 1424.87, "timestamp": "00:23:44", "text": "ギター、ああ、それは"}, {"type": "subtitle", "time": 1436.31, "timestamp": "00:23:56", "text": "ついに私自身の"}]
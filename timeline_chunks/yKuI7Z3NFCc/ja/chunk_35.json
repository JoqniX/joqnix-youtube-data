[{"type": "subtitle", "time": 2101.19, "timestamp": "00:35:01", "text": "下の方で"}, {"type": "subtitle", "time": 2103.75, "timestamp": "00:35:03", "text": "じゃあ、キーボードはどこ？"}, {"type": "subtitle", "time": 2113.95, "timestamp": "00:35:13", "text": "いいえ、開けることはできません。引き出しはありません。"}, {"type": "subtitle", "time": 2127.47, "timestamp": "00:35:27", "text": "定規は持っておけないよ、あ、待って"}, {"type": "subtitle", "time": 2128.63, "timestamp": "00:35:28", "text": "そこで待って"}, {"type": "subtitle", "time": 2131.87, "timestamp": "00:35:31", "text": "どこに置いておくの？あ、あ、そこだよ"}, {"type": "subtitle", "time": 2135.67, "timestamp": "00:35:35", "text": "配置しました。あ、黄色があるのを忘れていました。"}, {"type": "subtitle", "time": 2139.75, "timestamp": "00:35:39", "text": "鉛筆、それで大丈夫です"}, {"type": "subtitle", "time": 2143.23, "timestamp": "00:35:43", "text": "たぶんこの歯磨き粉と歯ブラシと"}, {"type": "subtitle", "time": 2145.23, "timestamp": "00:35:45", "text": "物が入る"}, {"type": "subtitle", "time": 2148.63, "timestamp": "00:35:48", "text": "私が料理する場所"}, {"type": "subtitle", "time": 2156.39, "timestamp": "00:35:56", "text": "いや、もし私だったら"}, {"type": "subtitle", "time": 2158.47, "timestamp": "00:35:58", "text": "実際に近くに置く"}]
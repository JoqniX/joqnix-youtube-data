[{"type": "subtitle", "time": 21242.07, "timestamp": "05:54:02", "text": "彼らは今それをやっているので、私はここにいます"}, {"type": "subtitle", "time": 21246.15, "timestamp": "05:54:06", "text": "それからフェニックス、銃を売って銃を持って行け"}, {"type": "subtitle", "time": 21249.43, "timestamp": "05:54:09", "text": "ここで銃を取って、どこでスポーンする？"}, {"type": "subtitle", "time": 21253.548, "timestamp": "05:54:13", "text": "どの銃をスポーンするか ベクトル ベクトル ああ"}, {"type": "subtitle", "time": 21257.43, "timestamp": "05:54:17", "text": "待って待って来るよ銃を売って"}, {"type": "subtitle", "time": 21265.03, "timestamp": "05:54:25", "text": "彼らが来る可能性はかなり高い"}, {"type": "subtitle", "time": 21266.948, "timestamp": "05:54:26", "text": "それは"}, {"type": "subtitle", "time": 21268.59, "timestamp": "05:54:28", "text": "1"}, {"type": "subtitle", "time": 21271.27, "timestamp": "05:54:31", "text": "来ないで"}, {"type": "subtitle", "time": 21274.03, "timestamp": "05:54:34", "text": "死んで、そこにいてください。"}, {"type": "subtitle", "time": 21291.708, "timestamp": "05:54:51", "text": "もう行くよ、ゴビーゴビー"}, {"type": "subtitle", "time": 21297.31, "timestamp": "05:54:57", "text": "走れ、奴らは君たちを急襲している"}, {"type": "subtitle", "time": 21299.948, "timestamp": "05:54:59", "text": "君たちは私たちが保持することを気に入るだろう"}]
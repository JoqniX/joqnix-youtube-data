[{"type": "subtitle", "time": 21009.15, "timestamp": "05:50:09", "text": "ああ、いいね、彼はスロープの上にいる、彼は"}, {"type": "subtitle", "time": 21012.868, "timestamp": "05:50:12", "text": "死なないで、こんな死に方しないで、兄弟"}, {"type": "subtitle", "time": 21013.708, "timestamp": "05:50:13", "text": "ランダム"}, {"type": "subtitle", "time": 21016.39, "timestamp": "05:50:16", "text": "スプレーで、無差別にスプレーを浴びて死ぬことを想像してみて。"}, {"type": "subtitle", "time": 21017.51, "timestamp": "05:50:17", "text": "その"}, {"type": "subtitle", "time": 21027.868, "timestamp": "05:50:27", "text": "時間どれくらい"}, {"type": "subtitle", "time": 21047.548, "timestamp": "05:50:47", "text": "ペ、そうだ、行こう、行こう、行こう"}, {"type": "subtitle", "time": 21049.948, "timestamp": "05:50:49", "text": "みんな、頑張ろう、みんな、僕たちはベストを尽くした"}, {"type": "subtitle", "time": 21051.708, "timestamp": "05:50:51", "text": "私たちのベスト"}, {"type": "subtitle", "time": 21054.31, "timestamp": "05:50:54", "text": "いいね、どうして諦めるの？私たちは勝てるよ。"}, {"type": "subtitle", "time": 21056.87, "timestamp": "05:50:56", "text": "これ"}, {"type": "subtitle", "time": 21058.35, "timestamp": "05:50:58", "text": "[音楽]"}]
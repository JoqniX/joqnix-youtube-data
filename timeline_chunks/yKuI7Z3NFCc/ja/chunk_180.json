[{"type": "subtitle", "time": 10813.96, "timestamp": "03:00:13", "text": "デス、もうすぐ終わるよ"}, {"type": "subtitle", "time": 10843.11, "timestamp": "03:00:43", "text": "完了、これで全て完了、そしてこれだけです"}, {"type": "subtitle", "time": 10844.75, "timestamp": "03:00:44", "text": "は"}, {"type": "subtitle", "time": 10859.99, "timestamp": "03:00:59", "text": "彼に、私は今どこにいるべきか考えなければならない"}]
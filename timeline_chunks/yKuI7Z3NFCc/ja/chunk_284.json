[{"type": "subtitle", "time": 17040.788, "timestamp": "04:44:00", "text": "来てくれてありがとう、そして未来"}, {"type": "subtitle", "time": 17042.91, "timestamp": "04:44:02", "text": "今週の配信は皆さんに任せます"}, {"type": "subtitle", "time": 17046.03, "timestamp": "04:44:06", "text": "スケジュールを組むつもりです。本当に申し訳ありません。"}, {"type": "subtitle", "time": 17049.91, "timestamp": "04:44:09", "text": "えっと、予期せぬ突然のポップアップ"}, {"type": "subtitle", "time": 17053.83, "timestamp": "04:44:13", "text": "どこにもないよ、ジョーストリームとか色々、こんにちは"}, {"type": "subtitle", "time": 17056.39, "timestamp": "04:44:16", "text": "うん、また次の動画で会おうね。ありがとう。"}, {"type": "subtitle", "time": 17059.49, "timestamp": "04:44:19", "text": "ジョーと"}, {"type": "subtitle", "time": 17066.91, "timestamp": "04:44:26", "text": "さようなら"}]
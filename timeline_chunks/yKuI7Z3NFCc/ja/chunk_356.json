[{"type": "subtitle", "time": 21361.59, "timestamp": "05:56:01", "text": "兄弟、彼らを制御するのはとても難しい"}, {"type": "subtitle", "time": 21365.23, "timestamp": "05:56:05", "text": "いや、さあ行こう、簡単だよ"}, {"type": "subtitle", "time": 21367.08, "timestamp": "05:56:07", "text": "簡単だよ 楽勝"}, {"type": "subtitle", "time": 21370.0, "timestamp": "05:56:10", "text": "楽勝 ここは音がない、音がないですよね"}, {"type": "subtitle", "time": 21385.43, "timestamp": "05:56:25", "text": "ちょっと待って"}, {"type": "subtitle", "time": 21388.11, "timestamp": "05:56:28", "text": "ホールド 私は"}, {"type": "subtitle", "time": 21391.43, "timestamp": "05:56:31", "text": "裏切りを見守るか、天国はただ"}, {"type": "subtitle", "time": 21399.628, "timestamp": "05:56:39", "text": "ああ、彼らにさせないで、彼らにさせないで"}, {"type": "subtitle", "time": 21404.51, "timestamp": "05:56:44", "text": "植えないで、あぁ、やばい、あぁ"}]
[{"type": "subtitle", "time": 22980.27, "timestamp": "06:23:00", "text": "前回の試合のようにスパイクラッシュで一度"}, {"type": "subtitle", "time": 22985.628, "timestamp": "06:23:05", "text": "Pは右に進みましたが、雨とワイパー"}, {"type": "subtitle", "time": 22990.19, "timestamp": "06:23:10", "text": "私がアンロックしたフリーエージェントですが"}, {"type": "subtitle", "time": 22993.07, "timestamp": "06:23:13", "text": "うん、でももっとプレイするのが楽しみだよ"}, {"type": "subtitle", "time": 22996.35, "timestamp": "06:23:16", "text": "ヴァレラントとゲームを学ぶだけでなく"}, {"type": "subtitle", "time": 22998.07, "timestamp": "06:23:18", "text": "私の中にはこう言う部分がある"}, {"type": "subtitle", "time": 23001.23, "timestamp": "06:23:21", "text": "遊びたくないのは、えっと、"}, {"type": "subtitle", "time": 23003.07, "timestamp": "06:23:23", "text": "それを呼ぶ"}, {"type": "subtitle", "time": 23012.07, "timestamp": "06:23:32", "text": "待って、なんでPで終わるんだよ、クソ。"}, {"type": "subtitle", "time": 23015.19, "timestamp": "06:23:35", "text": "そうですね、ええ"}, {"type": "subtitle", "time": 23017.23, "timestamp": "06:23:37", "text": "えっと、私の中にはこう思う部分があるんです"}, {"type": "subtitle", "time": 23020.15, "timestamp": "06:23:40", "text": "ゲームをプレイして、ゲームについて学ぼう"}, {"type": "subtitle", "time": 23023.07, "timestamp": "06:23:43", "text": "ジョイは参加したいけど、もう終わりにするわ、バカ。"}, {"type": "subtitle", "time": 23025.868, "timestamp": "06:23:45", "text": "もう終わりにするよ、ただ話をするだけ"}, {"type": "subtitle", "time": 23028.868, "timestamp": "06:23:48", "text": "あれこれと包む"}, {"type": "subtitle", "time": 23030.43, "timestamp": "06:23:50", "text": "上"}, {"type": "subtitle", "time": 23038.59, "timestamp": "06:23:58", "text": "わからない、ちょっと気分が悪いけど"}]
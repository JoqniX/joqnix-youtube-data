[{"type": "subtitle", "time": 12600.469, "timestamp": "03:30:00", "text": "フォローしたいし、これは"}, {"type": "subtitle", "time": 12602.469, "timestamp": "03:30:02", "text": "私のサーバーにとって非常に重要で、"}, {"type": "subtitle", "time": 12606.269, "timestamp": "03:30:06", "text": "それは、えっと、あの"}, {"type": "subtitle", "time": 12608.55, "timestamp": "03:30:08", "text": "時々メッセージを送る"}, {"type": "subtitle", "time": 12611.349, "timestamp": "03:30:11", "text": "私が他の場所に何かを投稿しているとき"}, {"type": "subtitle", "time": 12613.83, "timestamp": "03:30:13", "text": "Facebookなどのソーシャルとあらゆるもの"}, {"type": "subtitle", "time": 12617.59, "timestamp": "03:30:17", "text": "そうですね、Hさん、これらが変更点です"}, {"type": "subtitle", "time": 12620.51, "timestamp": "03:30:20", "text": "すぐにDiscordのために嘆願したが、"}, {"type": "subtitle", "time": 12622.79, "timestamp": "03:30:22", "text": "他にもいくつかあります"}, {"type": "subtitle", "time": 12624.51, "timestamp": "03:30:24", "text": "発表の中で彼らに言及した"}, {"type": "subtitle", "time": 12627.87, "timestamp": "03:30:27", "text": "今日か明日には「はい」とします"}, {"type": "subtitle", "time": 12632.83, "timestamp": "03:30:32", "text": "土曜日の配信 はい、こんにちは、それは"}, {"type": "subtitle", "time": 12635.11, "timestamp": "03:30:35", "text": "皆さんが今日を楽しんでくれたことを願っています。"}, {"type": "subtitle", "time": 12637.389, "timestamp": "03:30:37", "text": "今日ここに来たすべての人々"}, {"type": "subtitle", "time": 12641.95, "timestamp": "03:30:41", "text": "みんなを呼び出してみよう"}, {"type": "subtitle", "time": 12644.63, "timestamp": "03:30:44", "text": "来てくれてありがとう、そして"}, {"type": "subtitle", "time": 12648.79, "timestamp": "03:30:48", "text": "私とアカビ・ソンが来たので、今はぐっすり眠ってください"}, {"type": "subtitle", "time": 12650.59, "timestamp": "03:30:50", "text": "DDへ"}, {"type": "subtitle", "time": 12653.03, "timestamp": "03:30:53", "text": "アービ、そしてありがとう、楽しかったよ"}]
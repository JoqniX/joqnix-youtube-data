[{"type": "subtitle", "time": 7151.99, "timestamp": "01:59:11", "text": "車はここに置いておきます"}, {"type": "subtitle", "time": 7154.74, "timestamp": "01:59:14", "text": "今"}, {"type": "subtitle", "time": 7157.51, "timestamp": "01:59:17", "text": "[音楽]"}, {"type": "subtitle", "time": 7160.709, "timestamp": "01:59:20", "text": "ギターはどこに保管しますか？"}, {"type": "subtitle", "time": 7163.24, "timestamp": "01:59:23", "text": "ギター 私は本"}, {"type": "subtitle", "time": 7167.51, "timestamp": "01:59:27", "text": "[音楽]"}, {"type": "subtitle", "time": 7171.36, "timestamp": "01:59:31", "text": "わかった、おそらく私の"}, {"type": "subtitle", "time": 7185.83, "timestamp": "01:59:45", "text": "作業済みのバッグがここにあります"}]
[{"type": "subtitle", "time": 21303.788, "timestamp": "05:55:03", "text": "50をプレイ"}, {"type": "subtitle", "time": 21306.628, "timestamp": "05:55:06", "text": "上げないで、上げないで、上げないで、上げないで、上げないで"}, {"type": "subtitle", "time": 21310.51, "timestamp": "05:55:10", "text": "やれよ、あぁ、彼は死んでる、保存して保存して"}, {"type": "subtitle", "time": 21313.35, "timestamp": "05:55:13", "text": "保存 保存 保存"}, {"type": "subtitle", "time": 21324.11, "timestamp": "05:55:24", "text": "オレル"}, {"type": "subtitle", "time": 21349.31, "timestamp": "05:55:49", "text": "はい、わかりました。何をすべきかはわかっています。"}, {"type": "subtitle", "time": 21352.59, "timestamp": "05:55:52", "text": "今は彼らは同時に急いでいる"}, {"type": "subtitle", "time": 21354.15, "timestamp": "05:55:54", "text": "聞いて、彼らは積み重ねていて"}, {"type": "subtitle", "time": 21357.51, "timestamp": "05:55:57", "text": "同時に急いでいる"}]
[{"type": "subtitle", "time": 15904.229, "timestamp": "04:25:04", "text": "そうですね、次はどうすればいいのかわかりません"}, {"type": "subtitle", "time": 15910.95, "timestamp": "04:25:10", "text": "私はどうやって忘れたのか、どうやって変えたのか"}, {"type": "subtitle", "time": 15914.71, "timestamp": "04:25:14", "text": "伝説が来なかったら待つ場所"}, {"type": "subtitle", "time": 15917.91, "timestamp": "04:25:17", "text": "今シーズンもここ数シーズンと同じように"}, {"type": "subtitle", "time": 15920.07, "timestamp": "04:25:20", "text": "私はプレイしませんでした"}, {"type": "subtitle", "time": 15922.75, "timestamp": "04:25:22", "text": "待って、新しいシーズンは来ないの？"}, {"type": "subtitle", "time": 15925.03, "timestamp": "04:25:25", "text": "このゲームでは何が起こったのか"}, {"type": "subtitle", "time": 15927.71, "timestamp": "04:25:27", "text": "でも、あなたの、そして私は、それは"}, {"type": "subtitle", "time": 15929.75, "timestamp": "04:25:29", "text": "たくさん持っている"}, {"type": "subtitle", "time": 15933.309, "timestamp": "04:25:33", "text": "マスターが保管していたものがたくさんあった"}, {"type": "subtitle", "time": 15937.309, "timestamp": "04:25:37", "text": "えっと、私はジャンプマスターです。プレッシャーはありません。"}, {"type": "subtitle", "time": 15938.99, "timestamp": "04:25:38", "text": "たくさん持っています"}, {"type": "subtitle", "time": 15942.95, "timestamp": "04:25:42", "text": "毎シーズンのレジェンドですが"}, {"type": "subtitle", "time": 15953.07, "timestamp": "04:25:53", "text": "ああ、もちろんホットスポットへ"}]
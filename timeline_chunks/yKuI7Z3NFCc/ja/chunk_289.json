[{"type": "subtitle", "time": 17353.99, "timestamp": "04:49:13", "text": "ヒーラーは必要ない、さあ行こう"}, {"type": "subtitle", "time": 17356.07, "timestamp": "04:49:16", "text": "ヒーラーなしでは、私たちはできません、いいえ、いいえ、私たちは必要としています"}, {"type": "subtitle", "time": 17358.43, "timestamp": "04:49:18", "text": "ヒーラーが必要です"}, {"type": "subtitle", "time": 17360.708, "timestamp": "04:49:20", "text": "ヒーラーになるつもりがないなら"}, {"type": "subtitle", "time": 17363.43, "timestamp": "04:49:23", "text": "ヒーラーなら、私がヒーラーになります。心配しないでください。"}, {"type": "subtitle", "time": 17364.628, "timestamp": "04:49:24", "text": "SK"}, {"type": "subtitle", "time": 17370.31, "timestamp": "04:49:30", "text": "スカイは、私も彼が必要だと言う。私も一緒に行くよ。"}, {"type": "subtitle", "time": 17372.15, "timestamp": "04:49:32", "text": "チャンバー"}, {"type": "subtitle", "time": 17375.548, "timestamp": "04:49:35", "text": "よし、全員女性チームで行こう"}, {"type": "subtitle", "time": 17379.03, "timestamp": "04:49:39", "text": "多分そうかもしれない、なぜ女性ではないのか"}, {"type": "subtitle", "time": 17382.628, "timestamp": "04:49:42", "text": "兄弟、問題ないよ、スカイと一緒に行くよ"}, {"type": "subtitle", "time": 17384.99, "timestamp": "04:49:44", "text": "ワイパーを持って行って、スカイと一緒に行くから、君は"}, {"type": "chat", "time": 17399.751, "timestamp": "04:49:59", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "WHEN U WAKE UP joq, come back after having your lunch altogether"}]
[{"type": "subtitle", "time": 2045.47, "timestamp": "00:34:05", "text": "硬い紫色のやつ、やったー、よし、じゃあ私たちは"}, {"type": "subtitle", "time": 2048.389, "timestamp": "00:34:08", "text": "青をもう1つ、青をもう1つ手に入れる"}, {"type": "subtitle", "time": 2059.669, "timestamp": "00:34:19", "text": "平均"}, {"type": "subtitle", "time": 2064.669, "timestamp": "00:34:24", "text": "え、あれは何だったの？あれは何？待って、何？"}, {"type": "subtitle", "time": 2066.069, "timestamp": "00:34:26", "text": "ああ、あなたは"}, {"type": "subtitle", "time": 2073.49, "timestamp": "00:34:33", "text": "いいね"}, {"type": "subtitle", "time": 2077.829, "timestamp": "00:34:37", "text": "[音楽]"}, {"type": "subtitle", "time": 2090.109, "timestamp": "00:34:50", "text": "紙の兄弟、Cは、このようにセットアップします"}, {"type": "subtitle", "time": 2092.23, "timestamp": "00:34:52", "text": "オハイオ州で"}, {"type": "subtitle", "time": 2095.069, "timestamp": "00:34:55", "text": "うわ、怪しいぞ。ちょっと待って待って待って"}, {"type": "subtitle", "time": 2098.75, "timestamp": "00:34:58", "text": "フェイフェイ、えっと、何でもいいです"}]
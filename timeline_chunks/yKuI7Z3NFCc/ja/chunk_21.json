[{"type": "subtitle", "time": 1261.51, "timestamp": "00:21:01", "text": "それを適切に実行し、すべてを実行するために、"}, {"type": "subtitle", "time": 1263.789, "timestamp": "00:21:03", "text": "私がやります、やらなくていいです"}, {"type": "subtitle", "time": 1266.23, "timestamp": "00:21:06", "text": "心配するよりも"}, {"type": "subtitle", "time": 1268.789, "timestamp": "00:21:08", "text": "文句を言いながら、私はこれをして、"}, {"type": "subtitle", "time": 1294.909, "timestamp": "00:21:34", "text": "はい、こんにちは。私は寝ます。皆さん楽しんでください。"}]
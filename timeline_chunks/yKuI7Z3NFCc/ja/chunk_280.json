[{"type": "subtitle", "time": 16805.51, "timestamp": "04:40:05", "text": "悪い、わかった、えっと、2分だけど、私は、私は、私は"}, {"type": "subtitle", "time": 16809.19, "timestamp": "04:40:09", "text": "ここで死ぬには手榴弾はありますか"}, {"type": "subtitle", "time": 16812.19, "timestamp": "04:40:12", "text": "それは手榴弾です"}, {"type": "subtitle", "time": 16815.27, "timestamp": "04:40:15", "text": "みんな死ね、死にましょう"}, {"type": "subtitle", "time": 16817.15, "timestamp": "04:40:17", "text": "一緒に"}, {"type": "subtitle", "time": 16820.03, "timestamp": "04:40:20", "text": "手榴弾を外す"}, {"type": "subtitle", "time": 16824.15, "timestamp": "04:40:24", "text": "押し出された最後のグレネードを待って"}, {"type": "subtitle", "time": 16835.51, "timestamp": "04:40:35", "text": "グレネードAR"}, {"type": "subtitle", "time": 16838.83, "timestamp": "04:40:38", "text": "作品は"}, {"type": "subtitle", "time": 16842.43, "timestamp": "04:40:42", "text": "アラール、私は落ち込んでいる、ああ、彼らはただ"}, {"type": "subtitle", "time": 16844.75, "timestamp": "04:40:44", "text": "私を蘇らせないで、いやいや、そんなことは望んでないわ。"}, {"type": "subtitle", "time": 16853.27, "timestamp": "04:40:53", "text": "掴むよ、わかった、ただ"}]
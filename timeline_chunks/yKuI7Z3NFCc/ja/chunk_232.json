[{"type": "subtitle", "time": 13920.99, "timestamp": "03:52:00", "text": "キーはキーまででした"}, {"type": "subtitle", "time": 13925.469, "timestamp": "03:52:05", "text": "リロードが何だったか忘れた"}, {"type": "subtitle", "time": 13928.59, "timestamp": "03:52:08", "text": "ええ、こんにちは、ソウル・オブ・ソード、ようこそ"}, {"type": "subtitle", "time": 13941.37, "timestamp": "03:52:21", "text": "でも、これを言わせてください"}, {"type": "subtitle", "time": 13943.83, "timestamp": "03:52:23", "text": "[音楽]"}, {"type": "subtitle", "time": 13946.67, "timestamp": "03:52:26", "text": "の上"}, {"type": "subtitle", "time": 13949.59, "timestamp": "03:52:29", "text": "ええと、今日の配信は"}, {"type": "subtitle", "time": 13953.309, "timestamp": "03:52:33", "text": "1時間前に配信を終了します"}, {"type": "subtitle", "time": 13957.389, "timestamp": "03:52:37", "text": "7:30 たとえ私が W であっても、たとえ私が"}, {"type": "subtitle", "time": 13959.51, "timestamp": "03:52:39", "text": "試合 私は死ぬだろうし、"}, {"type": "subtitle", "time": 13964.91, "timestamp": "03:52:44", "text": "ゲームは7時半から授業があるから、うん、えっと"}, {"type": "subtitle", "time": 13967.55, "timestamp": "03:52:47", "text": "私には遊んでいる暇はない"}, {"type": "subtitle", "time": 13970.71, "timestamp": "03:52:50", "text": "今日のコントロールは後でやります"}, {"type": "subtitle", "time": 13972.95, "timestamp": "03:52:52", "text": "でも、私が何をしたのか考えてみましょう"}, {"type": "subtitle", "time": 13974.79, "timestamp": "03:52:54", "text": "大丈夫"}, {"type": "subtitle", "time": 13978.71, "timestamp": "03:52:58", "text": "F1 F1 F1 F1 F1 F1 リロード"}]
[{"type": "subtitle", "time": 3431.62, "timestamp": "00:57:11", "text": "よし、今はただ"}, {"type": "subtitle", "time": 3438.15, "timestamp": "00:57:18", "text": "閉店"}, {"type": "subtitle", "time": 3440.82, "timestamp": "00:57:20", "text": "さて、これは一体何だろう？"}, {"type": "subtitle", "time": 3442.109, "timestamp": "00:57:22", "text": "[音楽]"}, {"type": "subtitle", "time": 3444.309, "timestamp": "00:57:24", "text": "もの"}, {"type": "subtitle", "time": 3452.91, "timestamp": "00:57:32", "text": "いいえ"}, {"type": "subtitle", "time": 3455.28, "timestamp": "00:57:35", "text": "ああ、それ"}, {"type": "subtitle", "time": 3457.069, "timestamp": "00:57:37", "text": "[音楽]"}, {"type": "subtitle", "time": 3459.75, "timestamp": "00:57:39", "text": "何"}, {"type": "subtitle", "time": 3463.589, "timestamp": "00:57:43", "text": "あ、あと、ストリームをツイートするのを忘れてた"}, {"type": "subtitle", "time": 3467.069, "timestamp": "00:57:47", "text": "あー、インスタグラム、ごめん、いつも忘れちゃうんだよね"}, {"type": "subtitle", "time": 3468.51, "timestamp": "00:57:48", "text": "ああ、なんてことだ"}, {"type": "subtitle", "time": 3472.99, "timestamp": "00:57:52", "text": "神様、私にそうさせてください。"}, {"type": "subtitle", "time": 3475.56, "timestamp": "00:57:55", "text": "すべては"}]
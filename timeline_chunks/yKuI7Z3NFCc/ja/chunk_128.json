[{"type": "subtitle", "time": 7691.35, "timestamp": "02:08:11", "text": "[音楽]"}, {"type": "subtitle", "time": 7699.79, "timestamp": "02:08:19", "text": "それは、"}, {"type": "subtitle", "time": 7701.95, "timestamp": "02:08:21", "text": "わかった"}, {"type": "subtitle", "time": 7706.31, "timestamp": "02:08:26", "text": "彼はただ「こんにちは」と言っただけです"}, {"type": "subtitle", "time": 7721.189, "timestamp": "02:08:41", "text": "はい、ストリーミングですね。わかりました、わかりました。"}, {"type": "subtitle", "time": 7722.99, "timestamp": "02:08:42", "text": "ストリーミング配信されている可能性があります"}, {"type": "subtitle", "time": 7735.43, "timestamp": "02:08:55", "text": "よし、そうしよう"}, {"type": "subtitle", "time": 7739.51, "timestamp": "02:08:59", "text": "行くよ、つまり今日はダメで、"}]
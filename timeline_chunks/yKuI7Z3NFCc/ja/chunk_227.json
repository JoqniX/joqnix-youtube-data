[{"type": "subtitle", "time": 13621.83, "timestamp": "03:47:01", "text": "こんにちは、ようこそ、ようこそ、ようこそ、私はこれを受け取ります。"}, {"type": "subtitle", "time": 13626.67, "timestamp": "03:47:06", "text": "ストリームへ 私のストリームは死につつある"}, {"type": "subtitle", "time": 13631.309, "timestamp": "03:47:11", "text": "いや、ラグがあるよ。"}, {"type": "subtitle", "time": 13636.75, "timestamp": "03:47:16", "text": "なぜ待つのか、スキンはいくつ持っているのか"}, {"type": "subtitle", "time": 13638.95, "timestamp": "03:47:18", "text": "剣の魂のフレンドリクエストは"}, {"type": "subtitle", "time": 13641.51, "timestamp": "03:47:21", "text": "また、剣の魂は私が"}, {"type": "subtitle", "time": 13645.59, "timestamp": "03:47:25", "text": "始める前に、"}, {"type": "subtitle", "time": 13649.149, "timestamp": "03:47:29", "text": "ビデオを開いてすべてをオンにするだけです"}, {"type": "subtitle", "time": 13651.03, "timestamp": "03:47:31", "text": "に"}, {"type": "subtitle", "time": 13655.71, "timestamp": "03:47:35", "text": "低いと、プレイできません"}, {"type": "subtitle", "time": 13659.71, "timestamp": "03:47:39", "text": "すべて、"}, {"type": "subtitle", "time": 13662.99, "timestamp": "03:47:42", "text": "道徳的な詳細は低いと思いますが、問題ないと思います"}, {"type": "subtitle", "time": 13665.99, "timestamp": "03:47:45", "text": "はい、それでいいです。えっと、私はプレイを続けます。"}, {"type": "subtitle", "time": 13674.83, "timestamp": "03:47:54", "text": "灰が燃えている、ああ、だめだ、わかった"}, {"type": "subtitle", "time": 13679.389, "timestamp": "03:47:59", "text": "love0 そうだね、私の設定は"}]
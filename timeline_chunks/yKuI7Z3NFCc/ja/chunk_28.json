[{"type": "subtitle", "time": 1683.52, "timestamp": "00:28:03", "text": "別の箱、袋はどこに保管すればいいですか"}, {"type": "subtitle", "time": 1687.35, "timestamp": "00:28:07", "text": "[音楽]"}, {"type": "subtitle", "time": 1691.63, "timestamp": "00:28:11", "text": "バッグ、ああ、いいものがあるだろう"}, {"type": "subtitle", "time": 1694.59, "timestamp": "00:28:14", "text": "これはiPodか何かですね。取っておきます。"}, {"type": "subtitle", "time": 1696.07, "timestamp": "00:28:16", "text": "近く"}, {"type": "subtitle", "time": 1718.13, "timestamp": "00:28:38", "text": "おもちゃ"}, {"type": "subtitle", "time": 1721.31, "timestamp": "00:28:41", "text": "[音楽]"}, {"type": "subtitle", "time": 1725.389, "timestamp": "00:28:45", "text": "ジーンズ、どのボールがそこにあるのか、もう1つ"}, {"type": "subtitle", "time": 1733.87, "timestamp": "00:28:53", "text": "もう1つの箱、あ、待って、私は持っていない"}, {"type": "subtitle", "time": 1737.63, "timestamp": "00:28:57", "text": "スペースはOK、待って、これを"}]
[{"type": "subtitle", "time": 5102.79, "timestamp": "01:25:02", "text": "爪切りは間違っています"}, {"type": "subtitle", "time": 5105.669, "timestamp": "01:25:05", "text": "ああ、そこはいい場所だ"}, {"type": "subtitle", "time": 5109.88, "timestamp": "01:25:09", "text": "よし、医療従事者、いや"}, {"type": "subtitle", "time": 5115.95, "timestamp": "01:25:15", "text": "メディカルスプレー"}, {"type": "subtitle", "time": 5126.75, "timestamp": "01:25:26", "text": "わかった、わかった、そのままにしておくよ。ああ、それじゃあ"}, {"type": "subtitle", "time": 5128.95, "timestamp": "01:25:28", "text": "あなた"}, {"type": "subtitle", "time": 5132.91, "timestamp": "01:25:32", "text": "これを選びます。"}, {"type": "subtitle", "time": 5134.629, "timestamp": "01:25:34", "text": "プレート"}, {"type": "subtitle", "time": 5136.669, "timestamp": "01:25:36", "text": "どこかで"}, {"type": "subtitle", "time": 5139.669, "timestamp": "01:25:39", "text": "メガネ メガネ 私はそれを保管できます"}, {"type": "subtitle", "time": 5143.149, "timestamp": "01:25:43", "text": "プレートは、大丈夫、私は"}, {"type": "subtitle", "time": 5145.83, "timestamp": "01:25:45", "text": "それを保管してください"}, {"type": "subtitle", "time": 5155.47, "timestamp": "01:25:55", "text": "うまくいったよ、ほらね"}, {"type": "subtitle", "time": 5158.79, "timestamp": "01:25:58", "text": "よし、今"}]
[{"type": "subtitle", "time": 16862.31, "timestamp": "04:41:02", "text": "はい、こんにちは。こちらで仕上げています。"}, {"type": "subtitle", "time": 16865.15, "timestamp": "04:41:05", "text": "この場所ではとても"}, {"type": "subtitle", "time": 16869.67, "timestamp": "04:41:09", "text": "かわいい、こんにちは、大丈夫です、私の時間です"}, {"type": "subtitle", "time": 16890.27, "timestamp": "04:41:30", "text": "待って"}, {"type": "subtitle", "time": 16893.19, "timestamp": "04:41:33", "text": "こんにちは、今日は皆さんお越しいただきありがとうございました。"}, {"type": "subtitle", "time": 16896.67, "timestamp": "04:41:36", "text": "本当に楽しかったので、"}, {"type": "subtitle", "time": 16899.788, "timestamp": "04:41:39", "text": "これで終わりですね、こんにちは、ヤシュ"}, {"type": "subtitle", "time": 16901.47, "timestamp": "04:41:41", "text": "ストリームへようこそ、私たちは最高ですTR"}, {"type": "subtitle", "time": 16904.67, "timestamp": "04:41:44", "text": "まとめると大丈夫ですが、ようこそ"}, {"type": "subtitle", "time": 16905.67, "timestamp": "04:41:45", "text": "ストリーム"}, {"type": "subtitle", "time": 16907.99, "timestamp": "04:41:47", "text": "こんにちは、皆さん来てくれてありがとう"}, {"type": "subtitle", "time": 16911.27, "timestamp": "04:41:51", "text": "今日は楽しかったし、"}, {"type": "subtitle", "time": 16915.19, "timestamp": "04:41:55", "text": "しばらく経ちました、ええと、しばらく経ちました"}, {"type": "subtitle", "time": 16917.39, "timestamp": "04:41:57", "text": "私がプレイした"}]
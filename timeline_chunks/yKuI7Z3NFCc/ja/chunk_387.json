[{"type": "subtitle", "time": 23222.548, "timestamp": "06:27:02", "text": "ゲームBはただのゲームで、私は楽しんだ。"}, {"type": "subtitle", "time": 23226.23, "timestamp": "06:27:06", "text": "彼が私と交流して作った"}, {"type": "subtitle", "time": 23228.628, "timestamp": "06:27:08", "text": "ソロ・ウー・ホス"}, {"type": "subtitle", "time": 23230.548, "timestamp": "06:27:10", "text": "秋"}, {"type": "subtitle", "time": 23239.23, "timestamp": "06:27:19", "text": "ゼロ、そして参加した人たち"}, {"type": "subtitle", "time": 23248.75, "timestamp": "06:27:28", "text": "パボPストリーム"}, {"type": "subtitle", "time": 23251.31, "timestamp": "06:27:31", "text": "みんなとラッシュ"}, {"type": "subtitle", "time": 23254.788, "timestamp": "06:27:34", "text": "私もみんなと遊ぶのが楽しかったです。"}, {"type": "subtitle", "time": 23256.99, "timestamp": "06:27:36", "text": "つまり、このことについての一番重要なことは"}, {"type": "subtitle", "time": 23260.75, "timestamp": "06:27:40", "text": "トーナメントは主に接続と、"}, {"type": "subtitle", "time": 23262.868, "timestamp": "06:27:42", "text": "お互いを知ることが"}, {"type": "subtitle", "time": 23265.35, "timestamp": "06:27:45", "text": "重要なのは、誰が勝つか、"}, {"type": "subtitle", "time": 23266.39, "timestamp": "06:27:46", "text": "誰が"}, {"type": "subtitle", "time": 23269.31, "timestamp": "06:27:49", "text": "負ける、正直に言うと、あなたは知っていると思っていた"}, {"type": "subtitle", "time": 23272.468, "timestamp": "06:27:52", "text": "夕方、あなたと一緒にいたとき"}, {"type": "subtitle", "time": 23275.27, "timestamp": "06:27:55", "text": "えっと、私がリラックスしている間"}, {"type": "subtitle", "time": 23277.51, "timestamp": "06:27:57", "text": "落ち着こうとしてた"}]
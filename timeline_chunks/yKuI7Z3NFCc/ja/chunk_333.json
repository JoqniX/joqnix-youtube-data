[{"type": "subtitle", "time": 19989.47, "timestamp": "05:33:09", "text": "煙を撃つ"}, {"type": "subtitle", "time": 19996.11, "timestamp": "05:33:16", "text": "ああ"}, {"type": "subtitle", "time": 20015.31, "timestamp": "05:33:35", "text": "いや、私は噛む、私は死ぬ"}, {"type": "subtitle", "time": 20017.83, "timestamp": "05:33:37", "text": "餌付けして、いやいや、死ね、死ね、やめろよ兄弟兄弟"}, {"type": "subtitle", "time": 20020.67, "timestamp": "05:33:40", "text": "兄弟、それは行ってしまう、お願いだから私は"}, {"type": "subtitle", "time": 20023.59, "timestamp": "05:33:43", "text": "餌を噛むつもりだ、待って待って待って"}, {"type": "subtitle", "time": 20026.75, "timestamp": "05:33:46", "text": "何としても勝たなければならないことを証明してみせる"}, {"type": "subtitle", "time": 20029.75, "timestamp": "05:33:49", "text": "はい、彼らに見せなければなりません。私はただ"}, {"type": "subtitle", "time": 20032.99, "timestamp": "05:33:52", "text": "R は中間の意味を持たないことを示す"}]
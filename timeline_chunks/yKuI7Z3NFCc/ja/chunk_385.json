[{"type": "subtitle", "time": 23100.67, "timestamp": "06:25:00", "text": "あのキャラクター、えっと、名前は何だったっけ？"}, {"type": "subtitle", "time": 23102.91, "timestamp": "06:25:02", "text": "これから登場する新キャラクター"}, {"type": "subtitle", "time": 23105.23, "timestamp": "06:25:05", "text": "エレクトロ・レディ"}, {"type": "subtitle", "time": 23108.43, "timestamp": "06:25:08", "text": "彼女は走ったり滑ったりできる、まさに私の理想のタイプ"}, {"type": "subtitle", "time": 23114.23, "timestamp": "06:25:14", "text": "スタイルはわからないけど、プレイするつもり"}, {"type": "subtitle", "time": 23115.628, "timestamp": "06:25:15", "text": "ヴァラン"}, {"type": "subtitle", "time": 23118.788, "timestamp": "06:25:18", "text": "もっとだけど、たぶん私は"}, {"type": "subtitle", "time": 23120.43, "timestamp": "06:25:20", "text": "他の"}, {"type": "subtitle", "time": 23124.23, "timestamp": "06:25:24", "text": "サーバー、なぜなら私について言えることは"}, {"type": "subtitle", "time": 23128.27, "timestamp": "06:25:28", "text": "Holゲームで毒性を見かけたとき"}, {"type": "subtitle", "time": 23132.39, "timestamp": "06:25:32", "text": "あるいは、妻が知らないことなど"}, {"type": "subtitle", "time": 23136.468, "timestamp": "06:25:36", "text": "ただ下がるだけ 私は下手だけど、それが"}, {"type": "subtitle", "time": 23139.19, "timestamp": "06:25:39", "text": "Vについて唯一のことですが、それでもそれは"}, {"type": "subtitle", "time": 23141.67, "timestamp": "06:25:41", "text": "慣れる必要がある経験"}, {"type": "subtitle", "time": 23143.548, "timestamp": "06:25:43", "text": "そう、それは私が経験する必要があることだ"}, {"type": "subtitle", "time": 23146.59, "timestamp": "06:25:46", "text": "以前はそうだったので、私は自分の"}, {"type": "subtitle", "time": 23154.708, "timestamp": "06:25:54", "text": "[音楽]"}, {"type": "subtitle", "time": 23156.708, "timestamp": "06:25:56", "text": "ベスト何待って何が起こったの"}]
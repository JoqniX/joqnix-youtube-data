[{"type": "subtitle", "time": 5647.43, "timestamp": "01:34:07", "text": "我覺得我在這場"}, {"type": "subtitle", "time": 5651.99, "timestamp": "01:34:11", "text": "直播中沒有展示太多東西。當時只有我一個人在走來走去，一直在說話。  上次直播我沒怎麼說話，但帶大家四處轉了轉。  我認為這就是區別所在。  是的，你們"}, {"type": "subtitle", "time": 5664.55, "timestamp": "01:34:24", "text": "可以和我一起四處走走"}]
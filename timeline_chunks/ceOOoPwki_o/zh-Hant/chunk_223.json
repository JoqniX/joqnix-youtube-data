[{"type": "subtitle", "time": 13382.87, "timestamp": "03:43:02", "text": "我覺得我問這個問題不太合適，"}, {"type": "subtitle", "time": 13388.63, "timestamp": "03:43:08", "text": "我覺得我問這個問題問錯了，"}, {"type": "subtitle", "time": 13392.229, "timestamp": "03:43:12", "text": "因為我自己也不擅長溝通。 [清喉嚨]"}, {"type": "subtitle", "time": 13395.269, "timestamp": "03:43:15", "text": "但是一旦我"}, {"type": "subtitle", "time": 13397.83, "timestamp": "03:43:17", "text": "和某人熟絡起來，我就會一直"}, {"type": "subtitle", "time": 13400.79, "timestamp": "03:43:20", "text": "喋喋不休。我談的"}, {"type": "subtitle", "time": 13405.59, "timestamp": "03:43:25", "text": "話題五花八門，簡直無所不談"}, {"type": "subtitle", "time": 13409.59, "timestamp": "03:43:29", "text": "。就像那些了解我的人"}, {"type": "subtitle", "time": 13413.11, "timestamp": "03:43:33", "text": "，他們都知道我有時候有多煩人。"}, {"type": "subtitle", "time": 13416.07, "timestamp": "03:43:36", "text": "不只是"}, {"type": "subtitle", "time": 13420.71, "timestamp": "03:43:40", "text": "打電話，甚至發簡訊也一樣。我就是那種"}, {"type": "subtitle", "time": 13425.91, "timestamp": "03:43:45", "text": "喜歡寫很多長篇大論來描述"}, {"type": "subtitle", "time": 13428.309, "timestamp": "03:43:48", "text": "某件事、我的想法"}, {"type": "subtitle", "time": 13429.99, "timestamp": "03:43:49", "text": "等等的人。"}, {"type": "subtitle", "time": 13436.79, "timestamp": "03:43:56", "text": "對方在"}, {"type": "subtitle", "time": 13438.71, "timestamp": "03:43:58", "text": "接收訊息時會想，哦，這個"}]
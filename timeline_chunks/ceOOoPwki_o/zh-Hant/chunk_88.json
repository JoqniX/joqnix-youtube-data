[{"type": "subtitle", "time": 5292.31, "timestamp": "01:28:12", "text": "烤肉串小哥和我們看的其他東西……就像你在動漫裡看到的那樣，都是真的。我感覺它是"}, {"type": "subtitle", "time": 5322.07, "timestamp": "01:28:42", "text": "真的，就像你知道的"}, {"type": "subtitle", "time": 5324.95, "timestamp": "01:28:44", "text": "，前輩和後輩一起去祭典。我們看過很多次了。我看過很多次。"}, {"type": "subtitle", "time": 5328.31, "timestamp": "01:28:48", "text": "老實說，就像煙火表演一樣。他們會在那裡告白什麼的，對吧？"}, {"type": "subtitle", "time": 5335.27, "timestamp": "01:28:55", "text": "去一個不那麼擁擠的地方，或像一個地勢較高的地方，在那裡他們可以一起看煙火"}]
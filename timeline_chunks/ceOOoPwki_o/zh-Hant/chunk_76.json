[{"type": "subtitle", "time": 4561.43, "timestamp": "01:16:01", "text": "等等。這個可愛的傢伙。所以，我創建了一個類別"}, {"type": "subtitle", "time": 4565.27, "timestamp": "01:16:05", "text": "。我想知道糖蘋果會是什麼樣子。他們會把他"}, {"type": "subtitle", "time": 4567.43, "timestamp": "01:16:07", "text": "帶走，對吧？我聽說"}, {"type": "subtitle", "time": 4575.189, "timestamp": "01:16:15", "text": "他們把他放到他的頻道"}, {"type": "subtitle", "time": 4581.11, "timestamp": "01:16:21", "text": "上了。到底是怎麼回事？你知道嗎？我特別不知道，呃，特別不知道，"}, {"type": "subtitle", "time": 4599.51, "timestamp": "01:16:39", "text": "是結束時間嗎"}, {"type": "subtitle", "time": 4609.35, "timestamp": "01:16:49", "text": "？我覺得"}, {"type": "chat", "time": 4611.34, "timestamp": "01:16:51", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "joq you can do it"}]
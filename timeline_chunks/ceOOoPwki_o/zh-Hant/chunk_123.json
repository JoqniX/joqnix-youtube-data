[{"type": "subtitle", "time": 7381.669, "timestamp": "02:03:01", "text": "我們"}, {"type": "subtitle", "time": 7384.709, "timestamp": "02:03:04", "text": "跳過這個。  我的天啊。"}, {"type": "subtitle", "time": 7389.03, "timestamp": "02:03:09", "text": "我現在就在夜總會附近"}, {"type": "subtitle", "time": 7391.99, "timestamp": "02:03:11", "text": "。"}, {"type": "subtitle", "time": 7426.47, "timestamp": "02:03:46", "text": "我覺得我需要放一張地圖。我的天啊。我需要放一張地圖。這是什麼玫瑰？  呃，等等。我怎麼又回到這裡了？  這裡是可可相關的內容。  我必須從這裡經過。我還活著嗎？對了，我剛才全用"}, {"type": "subtitle", "time": 7431.83, "timestamp": "02:03:51", "text": "製表符記號了。  哦，是的，我還活著。好，好，好。"}]
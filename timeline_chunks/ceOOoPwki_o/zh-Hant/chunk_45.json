[{"type": "subtitle", "time": 2721.99, "timestamp": "00:45:21", "text": "哦，"}, {"type": "subtitle", "time": 2724.71, "timestamp": "00:45:24", "text": "是的。  這是"}, {"type": "subtitle", "time": 2727.03, "timestamp": "00:45:27", "text": "什麼？  香脆炸起司。新鮮起司。  等等，他們居然賣脆皮炸起司。  我"}, {"type": "subtitle", "time": 2729.19, "timestamp": "00:45:29", "text": "覺得這裡像是酒吧或餐廳。  哦，我的"}, {"type": "subtitle", "time": 2756.309, "timestamp": "00:45:56", "text": "頻道要用來處理聊天。耶。"}]
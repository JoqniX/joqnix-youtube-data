[{"type": "subtitle", "time": 13440.79, "timestamp": "03:44:00", "text": "人很有趣，有很多話要說，"}, {"type": "subtitle", "time": 13446.95, "timestamp": "03:44:06", "text": "而且不知何故，他們可以滔滔不絕地談論一件"}, {"type": "subtitle", "time": 13451.349, "timestamp": "03:44:11", "text": "小事"}, {"type": "subtitle", "time": 13456.63, "timestamp": "03:44:16", "text": "。所以我覺得"}, {"type": "subtitle", "time": 13460.15, "timestamp": "03:44:20", "text": "你應該要做的，"}, {"type": "subtitle", "time": 13462.63, "timestamp": "03:44:22", "text": "我的意思是，這應該是一個很常見的建議，"}, {"type": "subtitle", "time": 13464.15, "timestamp": "03:44:24", "text": "你可能到處都聽過，就是做你"}, {"type": "subtitle", "time": 13467.189, "timestamp": "03:44:27", "text": "自己。  是"}, {"type": "subtitle", "time": 13469.67, "timestamp": "03:44:29", "text": "啊，但"}, {"type": "subtitle", "time": 13471.429, "timestamp": "03:44:31", "text": "還有一點，對吧？第一"}, {"type": "subtitle", "time": 13473.99, "timestamp": "03:44:33", "text": "印像是："}, {"type": "subtitle", "time": 13478.389, "timestamp": "03:44:38", "text": "我的天哪，好多狗！"}, {"type": "subtitle", "time": 13482.87, "timestamp": "03:44:42", "text": "他們恨我。為什麼會這樣呢"}, {"type": "subtitle", "time": 13487.75, "timestamp": "03:44:47", "text": "？因為在日本我根本沒有機會摸貓"}, {"type": "subtitle", "time": 13491.03, "timestamp": "03:44:51", "text": "。我試過追"}, {"type": "subtitle", "time": 13495.59, "timestamp": "03:44:55", "text": "貓，但從來沒成功過。"}, {"type": "subtitle", "time": 13498.95, "timestamp": "03:44:58", "text": "哦，我不知道。"}]
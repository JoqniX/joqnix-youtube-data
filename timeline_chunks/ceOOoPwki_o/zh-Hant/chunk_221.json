[{"type": "subtitle", "time": 13269.83, "timestamp": "03:41:09", "text": "我興奮極了。哦，不錯。對你有好處。  對你有好處"}, {"type": "subtitle", "time": 13272.389, "timestamp": "03:41:12", "text": "。  我們走吧。  真為你"}, {"type": "subtitle", "time": 13281.83, "timestamp": "03:41:21", "text": "伊娜。"}, {"type": "subtitle", "time": 13291.03, "timestamp": "03:41:31", "text": "緊張也是。沒關係。你一定可以的"}, {"type": "subtitle", "time": 13299.67, "timestamp": "03:41:39", "text": "即使你是一個"}, {"type": "subtitle", "time": 13305.19, "timestamp": "03:41:45", "text": "缺乏自信的人，"}, {"type": "subtitle", "time": 13307.51, "timestamp": "03:41:47", "text": "也要不斷地在"}, {"type": "subtitle", "time": 13310.469, "timestamp": "03:41:50", "text": "心裡或大聲地對"}, {"type": "subtitle", "time": 13312.389, "timestamp": "03:41:52", "text": "自己說：「"}, {"type": "subtitle", "time": 13314.71, "timestamp": "03:41:54", "text": "我可以做到。」我能做到。我"}, {"type": "subtitle", "time": 13316.95, "timestamp": "03:41:56", "text": "能做到。"}]
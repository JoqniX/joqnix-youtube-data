[{"type": "subtitle", "time": 13320.309, "timestamp": "03:42:00", "text": "然後你就會成為你自己，然後你就會得到"}, {"type": "subtitle", "time": 13323.349, "timestamp": "03:42:03", "text": "做這件事的能量。實際上，"}, {"type": "subtitle", "time": 13325.83, "timestamp": "03:42:05", "text": "它確實有效。"}, {"type": "subtitle", "time": 13328.87, "timestamp": "03:42:08", "text": "從正面的角度來看"}, {"type": "subtitle", "time": 13330.63, "timestamp": "03:42:10", "text": "，它確實有效。"}, {"type": "subtitle", "time": 13343.99, "timestamp": "03:42:23", "text": "所以杜娜，"}, {"type": "subtitle", "time": 13347.99, "timestamp": "03:42:27", "text": "我現在在哪裡？我的天啊。等等，我從"}, {"type": "subtitle", "time": 13351.19, "timestamp": "03:42:31", "text": "這裡左轉了。  糟糕。是的"}, {"type": "subtitle", "time": 13356.469, "timestamp": "03:42:36", "text": "，"}, {"type": "subtitle", "time": 13359.75, "timestamp": "03:42:39", "text": "我認得這個地方。好的。"}, {"type": "subtitle", "time": 13367.349, "timestamp": "03:42:47", "text": "我不緊張。問題是，到了"}, {"type": "subtitle", "time": 13371.349, "timestamp": "03:42:51", "text": "某個時候，我已經沒有什麼事情可"}, {"type": "subtitle", "time": 13374.79, "timestamp": "03:42:54", "text": "問、可談或可溝通了"}, {"type": "subtitle", "time": 13377.75, "timestamp": "03:42:57", "text": "。嗯。"}]
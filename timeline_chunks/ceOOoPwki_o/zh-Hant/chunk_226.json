[{"type": "subtitle", "time": 13561.11, "timestamp": "03:46:01", "text": "一個陌生人。他們會說：「這裡怎麼有個"}, {"type": "subtitle", "time": 13564.79, "timestamp": "03:46:04", "text": "男孩"}, {"type": "subtitle", "time": 13567.59, "timestamp": "03:46:07", "text": "？那是什麼？那條狗在拉屎？搞什麼鬼？"}, {"type": "subtitle", "time": 13569.51, "timestamp": "03:46:09", "text": "搞什麼鬼？那是屎。」哦，狗狗"}, {"type": "subtitle", "time": 13572.309, "timestamp": "03:46:12", "text": "在拉屎"}, {"type": "subtitle", "time": 13574.79, "timestamp": "03:46:14", "text": "。  那位女士正在抓糞便。是啊，"}, {"type": "subtitle", "time": 13576.55, "timestamp": "03:46:16", "text": "你不應該在大街上拉屎"}, {"type": "subtitle", "time": 13579.75, "timestamp": "03:46:19", "text": "。呃，你得用塑膠袋把寵物的"}, {"type": "subtitle", "time": 13583.83, "timestamp": "03:46:23", "text": "糞便撿起來。"}, {"type": "subtitle", "time": 13587.75, "timestamp": "03:46:27", "text": "這是你必須要做的事情。"}, {"type": "subtitle", "time": 13589.99, "timestamp": "03:46:29", "text": "你好。"}, {"type": "subtitle", "time": 13593.189, "timestamp": "03:46:33", "text": "呃，重要的是要談談和"}, {"type": "subtitle", "time": 13599.269, "timestamp": "03:46:39", "text": "我一起過夜這件事。什麼"}, {"type": "subtitle", "time": 13609.269, "timestamp": "03:46:49", "text": "別搞砸了。我猜也是"}, {"type": "subtitle", "time": 13616.87, "timestamp": "03:46:56", "text": "等等，為什麼它是綠色的？"}]
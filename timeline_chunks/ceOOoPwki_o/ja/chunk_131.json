[{"type": "subtitle", "time": 7868.31, "timestamp": "02:11:08", "text": "待って。   私たちはそうだったのでしょうか？"}, {"type": "subtitle", "time": 7872.229, "timestamp": "02:11:12", "text": "とても混乱しています。"}, {"type": "subtitle", "time": 7874.069, "timestamp": "02:11:14", "text": "また道に迷ってしまったような気がする。   毎回必ず"}, {"type": "subtitle", "time": 7877.35, "timestamp": "02:11:17", "text": "。 カニのエリア。"}, {"type": "subtitle", "time": 7880.629, "timestamp": "02:11:20", "text": "どこに行けばいいのか分からなくなってしまう。"}, {"type": "subtitle", "time": 7890.95, "timestamp": "02:11:30", "text": "えっと、"}, {"type": "subtitle", "time": 7894.55, "timestamp": "02:11:34", "text": "左に行けばいいですか？"}, {"type": "subtitle", "time": 7906.149, "timestamp": "02:11:46", "text": "本当ですか？ そうそう。 ナイトクラブと"}, {"type": "subtitle", "time": 7909.03, "timestamp": "02:11:49", "text": "バー。 数字が出てくるでしょう。"}, {"type": "subtitle", "time": 7913.43, "timestamp": "02:11:53", "text": "ジャンプやナイトクラブでの出来事。   そうそう"}, {"type": "subtitle", "time": 7915.189, "timestamp": "02:11:55", "text": "。 それは確かに存在する。 東京にいるなら"}, {"type": "subtitle", "time": 7916.87, "timestamp": "02:11:56", "text": "、"}]
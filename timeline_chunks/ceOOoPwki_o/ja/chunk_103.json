[{"type": "subtitle", "time": 6181.109, "timestamp": "01:43:01", "text": "。私は"}, {"type": "subtitle", "time": 6183.91, "timestamp": "01:43:03", "text": "文字通りここに自転車を停めて、"}, {"type": "subtitle", "time": 6186.87, "timestamp": "01:43:06", "text": "そこです。ここは水辺です。"}, {"type": "subtitle", "time": 6199.109, "timestamp": "01:43:19", "text": "ストリームの残像。ストリームの"}, {"type": "subtitle", "time": 6201.27, "timestamp": "01:43:21", "text": "画質はどうですか？YouTubeやTwitchでこれを見たとき、良いですか"}, {"type": "subtitle", "time": 6204.07, "timestamp": "01:43:24", "text": "？"}, {"type": "subtitle", "time": 6205.99, "timestamp": "01:43:25", "text": "十分良いといいのですが。教えてください"}, {"type": "subtitle", "time": 6209.35, "timestamp": "01:43:29", "text": "。わかりました。"}, {"type": "subtitle", "time": 6212.47, "timestamp": "01:43:32", "text": "ええ、夜のような雰囲気ですが、"}, {"type": "subtitle", "time": 6219.99, "timestamp": "01:43:39", "text": "では、"}, {"type": "subtitle", "time": 6222.55, "timestamp": "01:43:42", "text": "水を見てください。"}, {"type": "subtitle", "time": 6226.39, "timestamp": "01:43:46", "text": "あそこにライトがありますが、水を見せてあげましょう。"}, {"type": "subtitle", "time": 6228.709, "timestamp": "01:43:48", "text": "ここにはたくさんの人がいて、カップルもいます"}, {"type": "subtitle", "time": 6231.109, "timestamp": "01:43:51", "text": "。わあ。"}]
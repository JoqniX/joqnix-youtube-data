[{"type": "subtitle", "time": 8350.629, "timestamp": "02:19:10", "text": "。 でも、まあいいでしょう。 こんにちは、ジョッキー。"}, {"type": "subtitle", "time": 8354.709, "timestamp": "02:19:14", "text": "こんにちは。 こんにちは。 こんにちは。 こんにちは。 ああ、見て。"}, {"type": "subtitle", "time": 8357.03, "timestamp": "02:19:17", "text": "それはまるでマスクのようだ。"}, {"type": "subtitle", "time": 8359.11, "timestamp": "02:19:19", "text": "その店のそばに。   今、本当に途方に暮れています"}, {"type": "subtitle", "time": 8373.11, "timestamp": "02:19:33", "text": "見た？ 彼は"}, {"type": "subtitle", "time": 8389.19, "timestamp": "02:19:49", "text": "K. 私は自分の"}, {"type": "subtitle", "time": 8392.601, "timestamp": "02:19:52", "text": "道を見つけると思う。"}, {"type": "subtitle", "time": 8393.27, "timestamp": "02:19:53", "text": "[咳払い]"}]
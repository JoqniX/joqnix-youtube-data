[{"type": "subtitle", "time": 4020.47, "timestamp": "01:07:00", "text": "クラブにいるんですか？いいえ、あの通りから歩いてきました"}, {"type": "subtitle", "time": 4027.27, "timestamp": "01:07:07", "text": "。あの通りから離れて、"}, {"type": "subtitle", "time": 4036.63, "timestamp": "01:07:16", "text": "分かりのように、本当に"}, {"type": "subtitle", "time": 4040.71, "timestamp": "01:07:20", "text": "みんなが片付けをしています。"}, {"type": "subtitle", "time": 4044.069, "timestamp": "01:07:24", "text": "見てください、みんなが集めています。"}, {"type": "subtitle", "time": 4047.27, "timestamp": "01:07:27", "text": "日本人は、"}, {"type": "subtitle", "time": 4049.51, "timestamp": "01:07:29", "text": "物を汚す傾向がありません。隅から隅まで掃除します"}, {"type": "subtitle", "time": 4052.63, "timestamp": "01:07:32", "text": "。ゴミは"}, {"type": "subtitle", "time": 4056.789, "timestamp": "01:07:36", "text": "家に持ち帰ります。"}, {"type": "subtitle", "time": 4070.39, "timestamp": "01:07:50", "text": "フードショップなので、ここでジュースを買いたいです。"}, {"type": "subtitle", "time": 4075.43, "timestamp": "01:07:55", "text": "たくさんの人がいます。"}]
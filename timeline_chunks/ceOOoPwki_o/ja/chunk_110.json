[{"type": "subtitle", "time": 6600.39, "timestamp": "01:50:00", "text": "。"}, {"type": "subtitle", "time": 6602.55, "timestamp": "01:50:02", "text": "でも、それが"}, {"type": "subtitle", "time": 6607.99, "timestamp": "01:50:07", "text": "普段の生活で、私が"}, {"type": "subtitle", "time": 6611.189, "timestamp": "01:50:11", "text": "屋外の小川でそうするなら、こういうやり方の方が"}, {"type": "subtitle", "time": 6622.229, "timestamp": "01:50:22", "text": "そこに表示されている。 でも、一つ"}, {"type": "subtitle", "time": 6624.55, "timestamp": "01:50:24", "text": "言いたいことがあるんです。ライブ"}, {"type": "subtitle", "time": 6627.669, "timestamp": "01:50:27", "text": "配信とかをしたり、コミュニティと話す時間を持ったり、"}, {"type": "subtitle", "time": 6630.79, "timestamp": "01:50:30", "text": "配信をしたり、"}, {"type": "subtitle", "time": 6633.189, "timestamp": "01:50:33", "text": "ライブ配信をしたりすると、"}, {"type": "subtitle", "time": 6637.27, "timestamp": "01:50:37", "text": "人々と繋がったり、友達と話したりする機会をたくさん逃してしまうと思いませんか"}, {"type": "subtitle", "time": 6639.83, "timestamp": "01:50:39", "text": "？"}, {"type": "subtitle", "time": 6643.109, "timestamp": "01:50:43", "text": "それは後になってようやく理解できたことだ。"}, {"type": "subtitle", "time": 6645.35, "timestamp": "01:50:45", "text": "例えば、私がルームメイトや知り合いの友達と一緒にこの地域、"}, {"type": "subtitle", "time": 6648.47, "timestamp": "01:50:48", "text": "このマットシティに来たとしても"}, {"type": "subtitle", "time": 6652.55, "timestamp": "01:50:52", "text": "、"}, {"type": "subtitle", "time": 6656.149, "timestamp": "01:50:56", "text": "それをストリーミング配信できるかどうかは非常に疑わしい。   だから"}]
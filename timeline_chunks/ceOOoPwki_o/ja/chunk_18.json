[{"type": "subtitle", "time": 1082.87, "timestamp": "00:18:02", "text": "場所を示すものです。 私は"}, {"type": "subtitle", "time": 1086.87, "timestamp": "00:18:06", "text": "ポータブルバッグの"}, {"type": "subtitle", "time": 1091.27, "timestamp": "00:18:11", "text": "デモを買いました。 それでは不十分だ。"}, {"type": "subtitle", "time": 1097.669, "timestamp": "00:18:17", "text": "ここは寺院のエリアのような感じがする。"}, {"type": "subtitle", "time": 1101.51, "timestamp": "00:18:21", "text": "私たちは昨日ここに来ました。 えっと、"}, {"type": "subtitle", "time": 1110.549, "timestamp": "00:18:30", "text": "聞いてもいいのかどうかわからないけど、写真​​を撮りたい"}, {"type": "subtitle", "time": 1111.99, "timestamp": "00:18:31", "text": "。"}, {"type": "subtitle", "time": 1115.19, "timestamp": "00:18:35", "text": "ここにいる人たちはみんな、それぞれ願い事を持っているんだよ"}, {"type": "chat", "time": 1115.78, "timestamp": "00:18:35", "author": "@yogipacman", "avatar": "https://yt4.ggpht.com/UudmjOedwhHrXlVk1qKsJ8rhBLkG-zcjSumwQOTb_5WDN3-D7v63KbzF9Ywa1_MKUOcOFTv5=s64-c-k-c0x00ffffff-no-rj", "message": "I wish you will have a good time!"}, {"type": "subtitle", "time": 1116.71, "timestamp": "00:18:36", "text": "。"}, {"type": "subtitle", "time": 1125.11, "timestamp": "00:18:45", "text": "こちらにはたくさんのものがありますが、"}, {"type": "subtitle", "time": 1128.47, "timestamp": "00:18:48", "text": "私がここを"}, {"type": "subtitle", "time": 1130.95, "timestamp": "00:18:50", "text": "歩いても大丈夫でしょうか。 ただ見て写真を撮りたいだけです"}]
[{"type": "subtitle", "time": 6422.229, "timestamp": "01:47:02", "text": "歩きながら、ひたすら話していただけだった。"}, {"type": "subtitle", "time": 6424.07, "timestamp": "01:47:04", "text": "前回の配信ではあまり話さなかったけど、いろいろと見せてあげたよ"}, {"type": "subtitle", "time": 6426.55, "timestamp": "01:47:06", "text": "。   それが"}, {"type": "subtitle", "time": 6435.27, "timestamp": "01:47:15", "text": "ええ、あなたたちは私と一緒に歩き回ることができました"}, {"type": "subtitle", "time": 6438.709, "timestamp": "01:47:18", "text": "。 そうそう、それが良いところなんです"}, {"type": "subtitle", "time": 6440.87, "timestamp": "01:47:20", "text": "。"}, {"type": "subtitle", "time": 6442.39, "timestamp": "01:47:22", "text": "うん。"}, {"type": "subtitle", "time": 6445.109, "timestamp": "01:47:25", "text": "私の本当の考えは、"}, {"type": "subtitle", "time": 6448.31, "timestamp": "01:47:28", "text": "もし私が金曜日に来ていたら、"}, {"type": "subtitle", "time": 6451.75, "timestamp": "01:47:31", "text": "このイベントが実際に始まったとき、つまり"}, {"type": "subtitle", "time": 6454.229, "timestamp": "01:47:34", "text": "金曜日、土曜日、日曜日にタナヴァダ"}, {"type": "subtitle", "time": 6457.669, "timestamp": "01:47:37", "text": "祭が開催されたとき、私は"}, {"type": "subtitle", "time": 6461.59, "timestamp": "01:47:41", "text": "自分で見て回ることができ、"}, {"type": "subtitle", "time": 6463.75, "timestamp": "01:47:43", "text": "土曜日にはストリーミング配信を見ることができただろうということです。 もしかしたら"}, {"type": "subtitle", "time": 6465.51, "timestamp": "01:47:45", "text": "日曜日に、特に理由もなくまたここに来てもいいかもしれないし、"}, {"type": "subtitle", "time": 6468.629, "timestamp": "01:47:48", "text": "ライブ配信してもいいかもしれない"}, {"type": "subtitle", "time": 6471.35, "timestamp": "01:47:51", "text": "。 それが狙いだった。 でも金曜日は"}, {"type": "subtitle", "time": 6475.75, "timestamp": "01:47:55", "text": "すごく疲れていたと思う。 うん。 金曜日は、"}, {"type": "subtitle", "time": 6479.99, "timestamp": "01:47:59", "text": "PowerPoint プレゼンテーションのスライドやその他すべての作業に取り掛かりました"}]
[{"type": "subtitle", "time": 8477.349, "timestamp": "02:21:17", "text": "メガムスカ。"}, {"type": "subtitle", "time": 8480.79, "timestamp": "02:21:20", "text": "まとめはどこにあるの？"}, {"type": "subtitle", "time": 8498.71, "timestamp": "02:21:38", "text": "、日焼けしたやつがあるよ。 それは"}, {"type": "subtitle", "time": 8508.15, "timestamp": "02:21:48", "text": "私を見るのに良いことだ。 わかった。 こんにちは。"}, {"type": "subtitle", "time": 8510.87, "timestamp": "02:21:50", "text": "私は正しい場所にいますか？ 私にはまだ分かりません"}, {"type": "subtitle", "time": 8513.83, "timestamp": "02:21:53", "text": "。"}, {"type": "subtitle", "time": 8516.23, "timestamp": "02:21:56", "text": "正しい場所にいるような気がするけど、"}]
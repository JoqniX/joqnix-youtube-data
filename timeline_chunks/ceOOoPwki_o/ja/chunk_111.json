[{"type": "subtitle", "time": 6661.91, "timestamp": "01:51:01", "text": "、"}, {"type": "subtitle", "time": 6673.83, "timestamp": "01:51:13", "text": "。"}, {"type": "subtitle", "time": 6675.35, "timestamp": "01:51:15", "text": "そう、まるで"}, {"type": "subtitle", "time": 6676.709, "timestamp": "01:51:16", "text": "一日がすごく長いみたいだね。 誰からそれを受け取るかは、選り好みしなければならない"}, {"type": "subtitle", "time": 6679.43, "timestamp": "01:51:19", "text": "。 ええ、それも本当ですね"}, {"type": "subtitle", "time": 6683.27, "timestamp": "01:51:23", "text": "。 そして、私の時間は限られている。   もう"}, {"type": "subtitle", "time": 6684.95, "timestamp": "01:51:24", "text": "一つ。 私の時間も"}, {"type": "subtitle", "time": 6693.99, "timestamp": "01:51:33", "text": "あ、今気づいたんだけど、"}, {"type": "subtitle", "time": 6697.43, "timestamp": "01:51:37", "text": "ルームメイトに8時半には帰るって言ったのに、もう"}, {"type": "subtitle", "time": 6701.99, "timestamp": "01:51:41", "text": "8時17分だよ。"}, {"type": "subtitle", "time": 6704.95, "timestamp": "01:51:44", "text": "おお。"}, {"type": "subtitle", "time": 6708.149, "timestamp": "01:51:48", "text": "うん。 さよなら。"}, {"type": "subtitle", "time": 6715.27, "timestamp": "01:51:55", "text": "9時までには出発しようと思います。 いや、8時"}, {"type": "subtitle", "time": 6719.109, "timestamp": "01:51:59", "text": "30分のことです。 私たちは8時30分までに出発します。 よろしければ、"}]
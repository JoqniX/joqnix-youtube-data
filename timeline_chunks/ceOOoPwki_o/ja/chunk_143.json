[{"type": "subtitle", "time": 8585.429, "timestamp": "02:23:05", "text": "デジタル決済やクレジットカード、"}, {"type": "subtitle", "time": 8600.0, "timestamp": "02:23:20", "text": "、 ここはまるで高級な場所みたいだ。"}, {"type": "subtitle", "time": 8611.99, "timestamp": "02:23:31", "text": "またここに来た。   もう家に帰っているはずなのに"}, {"type": "subtitle", "time": 8615.91, "timestamp": "02:23:35", "text": "。"}, {"type": "subtitle", "time": 8619.91, "timestamp": "02:23:39", "text": "ルームメイトに殺されるだろう。"}]
[{"type": "subtitle", "time": 961.189, "timestamp": "00:16:01", "text": "別の道を選ぶこともできるし、ただ"}, {"type": "subtitle", "time": 963.35, "timestamp": "00:16:03", "text": "待つこともできる。"}, {"type": "subtitle", "time": 981.67, "timestamp": "00:16:21", "text": "正直に言うと、今私に聞いてみたら（笑）"}, {"type": "subtitle", "time": 984.87, "timestamp": "00:16:24", "text": "、"}, {"type": "subtitle", "time": 987.509, "timestamp": "00:16:27", "text": "日本とかについてどう思うかって？ なんだか、"}, {"type": "subtitle", "time": 989.749, "timestamp": "00:16:29", "text": "日本にいる気がしない。 まるで"}, {"type": "subtitle", "time": 991.59, "timestamp": "00:16:31", "text": "夢のようだ。"}, {"type": "subtitle", "time": 995.99, "timestamp": "00:16:35", "text": "正直言って、まるで夢のようです。"}, {"type": "subtitle", "time": 1000.55, "timestamp": "00:16:40", "text": "だから、まるで夢を見ているような、あるいは"}, {"type": "subtitle", "time": 1006.55, "timestamp": "00:16:46", "text": "男同士の遠足か何かのような気分になるんです。"}, {"type": "subtitle", "time": 1015.67, "timestamp": "00:16:55", "text": "私の学校を待っていてください。"}, {"type": "chat", "time": 1018.342, "timestamp": "00:16:58", "author": "@yogipacman", "avatar": "https://yt4.ggpht.com/UudmjOedwhHrXlVk1qKsJ8rhBLkG-zcjSumwQOTb_5WDN3-D7v63KbzF9Ywa1_MKUOcOFTv5=s64-c-k-c0x00ffffff-no-rj", "message": "how do you feel about Japanese festival? fun? too crouded?"}]
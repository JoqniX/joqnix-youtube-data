[{"type": "subtitle", "time": 12487.91, "timestamp": "03:28:07", "text": "メートの一人が"}, {"type": "subtitle", "time": 12489.91, "timestamp": "03:28:09", "text": "学校を辞めたんです。 実際、彼らは"}, {"type": "subtitle", "time": 12495.99, "timestamp": "03:28:15", "text": "えっと、彼が学校、つまり"}, {"type": "subtitle", "time": 12505.75, "timestamp": "03:28:25", "text": "語学学校を辞めて実家に戻るという決断をしたことが、私にはとても理解できません。"}, {"type": "subtitle", "time": 12515.429, "timestamp": "03:28:35", "text": "2年生と同じように、残りはあと数"}, {"type": "subtitle", "time": 12518.79, "timestamp": "03:28:38", "text": "ヶ月です。 例えば来年の3月、"}, {"type": "subtitle", "time": 12521.83, "timestamp": "03:28:41", "text": "君は卒業するんだね。 なぜ"}, {"type": "subtitle", "time": 12524.55, "timestamp": "03:28:44", "text": "今辞めたのですか？"}, {"type": "subtitle", "time": 12528.07, "timestamp": "03:28:48", "text": "もし私の記憶が正しければ、彼はパートタイムの仕事もしていなかったし、生活費も底をつきかけていたからかもしれません。"}, {"type": "subtitle", "time": 12537.51, "timestamp": "03:28:57", "text": "つまり、"}, {"type": "subtitle", "time": 12539.59, "timestamp": "03:28:59", "text": "経済的な事情が原因だったのかもしれません。"}]
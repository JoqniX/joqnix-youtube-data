[{"type": "subtitle", "time": 4145.99, "timestamp": "01:09:05", "text": "問題は、みんなが友達と一緒にこれらのイベントに来るわけではないということ"}, {"type": "subtitle", "time": 4148.709, "timestamp": "01:09:08", "text": "。一人で来ている"}, {"type": "subtitle", "time": 4151.43, "timestamp": "01:09:11", "text": "人をほとんど見かけない"}, {"type": "subtitle", "time": 4153.749, "timestamp": "01:09:13", "text": "。"}, {"type": "subtitle", "time": 4159.669, "timestamp": "01:09:19", "text": "イギリスが日本に来る。いや、イギリスが日本に来る"}, {"type": "subtitle", "time": 4162.149, "timestamp": "01:09:22", "text": "。私はそんなことをする必要はない。"}, {"type": "subtitle", "time": 4172.95, "timestamp": "01:09:32", "text": "ありがとう。"}, {"type": "subtitle", "time": 4175.99, "timestamp": "01:09:35", "text": "ベイとか"}, {"type": "subtitle", "time": 4178.309, "timestamp": "01:09:38", "text": "ドーナツとか他のものもある"}]
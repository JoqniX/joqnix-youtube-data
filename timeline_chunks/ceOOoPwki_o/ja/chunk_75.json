[{"type": "subtitle", "time": 4508.87, "timestamp": "01:15:08", "text": "あそこの上にあるものを見せたっけ"}, {"type": "subtitle", "time": 4518.79, "timestamp": "01:15:18", "text": "どこかに収まるかもしれない。手が"}, {"type": "subtitle", "time": 4520.07, "timestamp": "01:15:20", "text": "痛い。"}, {"type": "subtitle", "time": 4525.43, "timestamp": "01:15:25", "text": "手が痛い。警察官がいる"}, {"type": "subtitle", "time": 4531.51, "timestamp": "01:15:31", "text": "。"}, {"type": "subtitle", "time": 4541.83, "timestamp": "01:15:41", "text": "リンカーンの隣の席について知らない人に尋ねる。"}, {"type": "subtitle", "time": 4545.75, "timestamp": "01:15:45", "text": "人と話すのは怖い。"}, {"type": "subtitle", "time": 4549.35, "timestamp": "01:15:49", "text": "僕はまだ内向的なんだよ。"}, {"type": "subtitle", "time": 4553.189, "timestamp": "01:15:53", "text": "家から出ないからかな"}, {"type": "subtitle", "time": 4557.27, "timestamp": "01:15:57", "text": "？開いているって書いてある。うん。じゃあまた"}, {"type": "subtitle", "time": 4559.189, "timestamp": "01:15:59", "text": "来るよ。"}]
[{"type": "subtitle", "time": 11765.75, "timestamp": "03:16:05", "text": "でも悲しいことに、私はこうして座っていることになります。それが"}, {"type": "subtitle", "time": 11789.75, "timestamp": "03:16:29", "text": "死んでいます"}, {"type": "subtitle", "time": 11792.63, "timestamp": "03:16:32", "text": "。 ああ、もう心は完全に"}, {"type": "subtitle", "time": 11798.71, "timestamp": "03:16:38", "text": "死んでるよ。"}, {"type": "subtitle", "time": 11803.269, "timestamp": "03:16:43", "text": "今日はたくさん歩いたから、すごく疲れた。"}, {"type": "subtitle", "time": 11807.03, "timestamp": "03:16:47", "text": "そして今、私たちは文字通り雨の降る公園に座っている"}, {"type": "subtitle", "time": 11809.11, "timestamp": "03:16:49", "text": "。"}, {"type": "subtitle", "time": 11817.75, "timestamp": "03:16:57", "text": "、相棒。 遅刻ですよ。 あなたは3"}]
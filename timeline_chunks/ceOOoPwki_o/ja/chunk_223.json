[{"type": "subtitle", "time": 13380.71, "timestamp": "03:43:00", "text": "H"}, {"type": "subtitle", "time": 13382.87, "timestamp": "03:43:02", "text": "私はそれについて尋ねるのにふさわしくない人間だと思うし、"}, {"type": "subtitle", "time": 13390.95, "timestamp": "03:43:10", "text": "それについて尋ねるのに間違った人間だと思う。"}, {"type": "subtitle", "time": 13392.229, "timestamp": "03:43:12", "text": "ただ[咳払い] 私"}, {"type": "subtitle", "time": 13395.269, "timestamp": "03:43:15", "text": "自身コミュニケーションが得意ではないから。 でも、一度"}, {"type": "subtitle", "time": 13397.83, "timestamp": "03:43:17", "text": "誰かと打ち解けると、私はずっとしゃべり続けてしまうんです"}, {"type": "subtitle", "time": 13400.79, "timestamp": "03:43:20", "text": "。 私は、とてもランダムな話題について話します"}, {"type": "subtitle", "time": 13409.59, "timestamp": "03:43:29", "text": "。 私のことをよく知っている人は"}, {"type": "subtitle", "time": 13413.11, "timestamp": "03:43:33", "text": "、私がどれだけ迷惑な人間かを知っている。"}, {"type": "subtitle", "time": 13420.71, "timestamp": "03:43:40", "text": "電話で話すだけじゃなくて、テキストメッセージも含まれるんだよ。 私は、"}, {"type": "subtitle", "time": 13428.309, "timestamp": "03:43:48", "text": "何かについて、あるいは自分の考えなどについて、長文の段落をたくさん書くのが好きなタイプです"}, {"type": "subtitle", "time": 13429.99, "timestamp": "03:43:49", "text": "。   そうすると、"}, {"type": "subtitle", "time": 13438.71, "timestamp": "03:43:58", "text": "相手は「ああ、この"}]
[{"type": "subtitle", "time": 12722.309, "timestamp": "03:32:02", "text": "日に1回しか食事をしません。   だから"}, {"type": "subtitle", "time": 12726.469, "timestamp": "03:32:06", "text": "、今日私が食べたのは、"}, {"type": "subtitle", "time": 12728.87, "timestamp": "03:32:08", "text": "韓国のラーメンと、焼きそばのラーメンを買っただけです"}, {"type": "subtitle", "time": 12733.349, "timestamp": "03:32:13", "text": "。"}, {"type": "subtitle", "time": 12735.75, "timestamp": "03:32:15", "text": "それらを混ぜ合わせて"}, {"type": "subtitle", "time": 12740.71, "timestamp": "03:32:20", "text": "調味料を加えて作り、それから"}, {"type": "subtitle", "time": 12745.67, "timestamp": "03:32:25", "text": "サラダ用のキャベツ、つまりサラダミックスのような"}, {"type": "subtitle", "time": 12750.229, "timestamp": "03:32:30", "text": "ものを買いました。 これは安価な"}, {"type": "subtitle", "time": 12753.67, "timestamp": "03:32:33", "text": "パンで、目玉焼きが2つ付いてきました"}, {"type": "subtitle", "time": 12756.95, "timestamp": "03:32:36", "text": "。   えっと、他に何かありますか"}, {"type": "subtitle", "time": 12759.91, "timestamp": "03:32:39", "text": "？ ええ、ルームメイトが"}, {"type": "subtitle", "time": 12763.91, "timestamp": "03:32:43", "text": "自家製のマヨネーズを作りました。 それで、その上に"}, {"type": "subtitle", "time": 12766.229, "timestamp": "03:32:46", "text": "ケチャップをかけたんです。   では、"}, {"type": "subtitle", "time": 12770.469, "timestamp": "03:32:50", "text": "その後はどうなるのか？ そう、ニンジンとキュウリ。"}, {"type": "subtitle", "time": 12773.11, "timestamp": "03:32:53", "text": "それは私が追加したものです。"}, {"type": "subtitle", "time": 12776.229, "timestamp": "03:32:56", "text": "クリームパンを買ったんだ"}, {"type": "subtitle", "time": 12778.469, "timestamp": "03:32:58", "text": "けど、まだ食べてないんだ。 明日、"}]
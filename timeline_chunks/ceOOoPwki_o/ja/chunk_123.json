[{"type": "subtitle", "time": 7381.669, "timestamp": "02:03:01", "text": "その地域を通る必要はないかもしれません。 こうやって"}, {"type": "subtitle", "time": 7384.709, "timestamp": "02:03:04", "text": "歩いていけばいいんです。"}, {"type": "subtitle", "time": 7389.03, "timestamp": "02:03:09", "text": "こっちの方がいい。 さあ、私たちはこうやって歩くだけです"}, {"type": "subtitle", "time": 7391.99, "timestamp": "02:03:11", "text": "。"}, {"type": "subtitle", "time": 7394.31, "timestamp": "02:03:14", "text": "これは非常に良い。 混雑しているわけでもない"}, {"type": "subtitle", "time": 7395.83, "timestamp": "02:03:15", "text": "。"}, {"type": "subtitle", "time": 7399.589, "timestamp": "02:03:19", "text": "ただ散歩に行くだけです。"}, {"type": "subtitle", "time": 7406.709, "timestamp": "02:03:26", "text": "さあ、行って。"}, {"type": "subtitle", "time": 7419.91, "timestamp": "02:03:39", "text": "次回は横向きのチャットがしたいです。"}, {"type": "subtitle", "time": 7423.589, "timestamp": "02:03:43", "text": "えっと、配信とかやってるんです。"}, {"type": "subtitle", "time": 7426.47, "timestamp": "02:03:46", "text": "今は横長のチャットが欲しいんです。"}, {"type": "subtitle", "time": 7429.27, "timestamp": "02:03:49", "text": "縦長のチャットだと"}, {"type": "subtitle", "time": 7431.83, "timestamp": "02:03:51", "text": "画面が隠れてしまう気がするので。 ええ、"}, {"type": "subtitle", "time": 7435.589, "timestamp": "02:03:55", "text": "左上の"}]
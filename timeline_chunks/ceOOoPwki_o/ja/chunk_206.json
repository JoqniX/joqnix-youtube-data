[{"type": "subtitle", "time": 12362.15, "timestamp": "03:26:02", "text": "うん。 それが、私が努力して目指すべき唯一のことだ"}, {"type": "subtitle", "time": 12373.99, "timestamp": "03:26:13", "text": "私は3時間25分間配信します。"}, {"type": "subtitle", "time": 12375.99, "timestamp": "03:26:15", "text": "何だって"}, {"type": "subtitle", "time": 12396.71, "timestamp": "03:26:36", "text": "午前10時だ。 人々は積極的に"}, {"type": "subtitle", "time": 12399.19, "timestamp": "03:26:39", "text": "会話をしようとしている。"}, {"type": "subtitle", "time": 12402.07, "timestamp": "03:26:42", "text": "仕事があるので、それはできません。 午前8時です"}, {"type": "subtitle", "time": 12404.469, "timestamp": "03:26:44", "text": "。 だから、私は6時に起きて"}, {"type": "subtitle", "time": 12407.19, "timestamp": "03:26:47", "text": "準備をして、"}, {"type": "subtitle", "time": 12410.63, "timestamp": "03:26:50", "text": "パートタイムの仕事に行ってから"}, {"type": "subtitle", "time": 12413.11, "timestamp": "03:26:53", "text": "学校に行かなければならないんです。"}, {"type": "subtitle", "time": 12419.19, "timestamp": "03:26:59", "text": "授業、"}]
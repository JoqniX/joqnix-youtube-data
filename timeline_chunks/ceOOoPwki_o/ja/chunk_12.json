[{"type": "subtitle", "time": 752.55, "timestamp": "00:12:32", "text": "こうして人為的な階層構造が"}, {"type": "subtitle", "time": 754.389, "timestamp": "00:12:34", "text": "作られるのだ。"}, {"type": "subtitle", "time": 758.23, "timestamp": "00:12:38", "text": "今のところ、ええと、人々は、ええと、人々は"}, {"type": "subtitle", "time": 761.269, "timestamp": "00:12:41", "text": "、いや、そう言うべきではない"}]
[{"type": "subtitle", "time": 13688.469, "timestamp": "03:48:08", "text": "。 あそこに誰かいる。"}, {"type": "subtitle", "time": 13690.95, "timestamp": "03:48:10", "text": "アパートです。   自分の行動に気をつけろ"}, {"type": "subtitle", "time": 13699.99, "timestamp": "03:48:19", "text": "真夜中だ。 誰もいない"}, {"type": "subtitle", "time": 13706.469, "timestamp": "03:48:26", "text": "誰もいない。 そして彼らはこう言うでしょう。「なんで"}, {"type": "subtitle", "time": 13709.03, "timestamp": "03:48:29", "text": "男が喋ってるんだ？外国人が一人で"}, {"type": "subtitle", "time": 13713.03, "timestamp": "03:48:33", "text": "公園に座って、英語を話しながら彼の"}, {"type": "subtitle", "time": 13719.11, "timestamp": "03:48:39", "text": "携帯電話に向かって喋ってるぞ。」"}, {"type": "subtitle", "time": 13721.59, "timestamp": "03:48:41", "text": "うん。 さよなら。"}, {"type": "subtitle", "time": 13723.269, "timestamp": "03:48:43", "text": "茂みの奥に、"}, {"type": "subtitle", "time": 13724.79, "timestamp": "03:48:44", "text": "何かがあった。   何てことだ"}, {"type": "subtitle", "time": 13727.03, "timestamp": "03:48:47", "text": "。 アストラ、待って。 ちょっと"}]
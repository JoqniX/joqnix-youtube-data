[{"type": "subtitle", "time": 3739.03, "timestamp": "01:02:19", "text": "うん、ここから右に曲がれる。"}, {"type": "subtitle", "time": 3742.15, "timestamp": "01:02:22", "text": "この辺りには、えーと、えーと、あれ、"}, {"type": "subtitle", "time": 3747.03, "timestamp": "01:02:27", "text": "これアイスクリーム？いや、"}, {"type": "subtitle", "time": 3773.349, "timestamp": "01:02:53", "text": "ここは、"}, {"type": "subtitle", "time": 3775.829, "timestamp": "01:02:55", "text": "ストリートミュージシャンを見つけることができる場所なんだ。今は"}, {"type": "subtitle", "time": 3778.15, "timestamp": "01:02:58", "text": "あまり人がいない"}]
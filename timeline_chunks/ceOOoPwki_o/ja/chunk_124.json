[{"type": "subtitle", "time": 7440.55, "timestamp": "02:04:00", "text": "隅に置いておいたんですが、ああ、もしかしたら、ああ、"}, {"type": "subtitle", "time": 7452.31, "timestamp": "02:04:12", "text": "これを見てください、という感じの方がいいかもしれません。 私はここを通ったことがないだろうか？"}, {"type": "subtitle", "time": 7456.55, "timestamp": "02:04:16", "text": "待って、なんて素晴らしい景色なんだ。"}, {"type": "subtitle", "time": 7460.229, "timestamp": "02:04:20", "text": "私はここを通ったことがない。"}, {"type": "subtitle", "time": 7461.99, "timestamp": "02:04:21", "text": "わあ、"}, {"type": "subtitle", "time": 7471.589, "timestamp": "02:04:31", "text": "これを見てください。"}, {"type": "subtitle", "time": 7474.79, "timestamp": "02:04:34", "text": "写真を撮ってください。 画像をストリーミング配信する。"}, {"type": "subtitle", "time": 7482.39, "timestamp": "02:04:42", "text": "ジョー、写真を撮って。"}, {"type": "subtitle", "time": 7489.91, "timestamp": "02:04:49", "text": "待って。 えっと、待って。 少し待って、"}, {"type": "subtitle", "time": 7498.47, "timestamp": "02:04:58", "text": "写真を撮ろう。   わかった"}]
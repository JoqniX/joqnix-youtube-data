[{"type": "subtitle", "time": 6132.47, "timestamp": "01:42:12", "text": "アニメとかで見るようなものは"}, {"type": "subtitle", "time": 6134.95, "timestamp": "01:42:14", "text": "現実だ。"}, {"type": "subtitle", "time": 6139.99, "timestamp": "01:42:19", "text": "先輩と後輩が"}, {"type": "subtitle", "time": 6142.87, "timestamp": "01:42:22", "text": "一緒に祭りに来るような、現実のような気がする。私たちはそれを何度も見た"}, {"type": "subtitle", "time": 6145.83, "timestamp": "01:42:25", "text": "。私はそれらをたくさん見た。"}, {"type": "subtitle", "time": 6158.31, "timestamp": "01:42:38", "text": "花火大会のようなものになるだろう。"}, {"type": "subtitle", "time": 6160.31, "timestamp": "01:42:40", "text": "そこで彼らは愛を告白する、"}, {"type": "subtitle", "time": 6162.07, "timestamp": "01:42:42", "text": "そうでしょう？"}, {"type": "subtitle", "time": 6166.149, "timestamp": "01:42:46", "text": "混雑していない場所、または高い場所に行って、"}, {"type": "subtitle", "time": 6177.51, "timestamp": "01:42:57", "text": "一緒に花火を見たり、すべてを見ることができる。"}, {"type": "subtitle", "time": 6179.109, "timestamp": "01:42:59", "text": "そう、私が話していたのはここだ"}]
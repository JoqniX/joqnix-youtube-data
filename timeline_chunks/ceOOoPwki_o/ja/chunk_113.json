[{"type": "subtitle", "time": 6781.91, "timestamp": "01:53:01", "text": "それから、私の親友のUちゃんが"}, {"type": "subtitle", "time": 6785.589, "timestamp": "01:53:05", "text": "助けに来てくれて、ある"}, {"type": "subtitle", "time": 6788.55, "timestamp": "01:53:08", "text": "日、Uちゃんが「"}, {"type": "subtitle", "time": 6791.75, "timestamp": "01:53:11", "text": "アプリを作ったから試してみて」って言ったんです。"}, {"type": "subtitle", "time": 6795.589, "timestamp": "01:53:15", "text": "アプリを使い始めてから、すっかり"}, {"type": "subtitle", "time": 6798.149, "timestamp": "01:53:18", "text": "気に入って、"}, {"type": "subtitle", "time": 6800.39, "timestamp": "01:53:20", "text": "新しい"}, {"type": "subtitle", "time": 6801.99, "timestamp": "01:53:21", "text": "機能をたくさんリクエストしました。"}, {"type": "subtitle", "time": 6804.47, "timestamp": "01:53:24", "text": "そしてついにカメラのアップデートが来て、"}, {"type": "subtitle", "time": 6808.47, "timestamp": "01:53:28", "text": "すごく嬉しかったんです。このプロ"}, {"type": "subtitle", "time": 6812.31, "timestamp": "01:53:32", "text": "アプリは本当に軽くて、私がずっと欲しかったものが"}, {"type": "subtitle", "time": 6814.79, "timestamp": "01:53:34", "text": "実際にちゃんと動くんです。"}, {"type": "subtitle", "time": 6823.03, "timestamp": "01:53:43", "text": "今では、これらの"}, {"type": "subtitle", "time": 6825.99, "timestamp": "01:53:45", "text": "ツールを使ってストリームを配信できるようになって、すごく幸せです。いつか"}, {"type": "subtitle", "time": 6831.91, "timestamp": "01:53:51", "text": "将来、"}, {"type": "subtitle", "time": 6834.709, "timestamp": "01:53:54", "text": "このセットアップをアップグレードしたいと思っています。Twitchの"}, {"type": "subtitle", "time": 6837.51, "timestamp": "01:53:57", "text": "ストリーマーが"}]
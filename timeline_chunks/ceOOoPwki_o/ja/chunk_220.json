[{"type": "subtitle", "time": 13207.429, "timestamp": "03:40:07", "text": "ニース。 私はそれを楽しんでいます。 ああ、"}, {"type": "subtitle", "time": 13211.03, "timestamp": "03:40:11", "text": "雨が止んだ。 私はただ歩くだけでいいんです。 ニース。"}, {"type": "subtitle", "time": 13214.87, "timestamp": "03:40:14", "text": "今日は楽しかった。 とても楽しかったです。"}, {"type": "subtitle", "time": 13217.59, "timestamp": "03:40:17", "text": "ああ、終わりたくないん"}, {"type": "subtitle", "time": 13220.469, "timestamp": "03:40:20", "text": "だけど、もう遅いしね。 明日授業があります。"}, {"type": "subtitle", "time": 13222.95, "timestamp": "03:40:22", "text": "明日仕事があります。"}, {"type": "subtitle", "time": 13225.11, "timestamp": "03:40:25", "text": "えっと、"}, {"type": "subtitle", "time": 13228.55, "timestamp": "03:40:28", "text": "もし今お祭りに行かなかったら、"}, {"type": "subtitle", "time": 13232.07, "timestamp": "03:40:32", "text": "2時間の"}, {"type": "subtitle", "time": 13237.269, "timestamp": "03:40:37", "text": "オンライン授業を見て、さっさと"}, {"type": "subtitle", "time": 13243.83, "timestamp": "03:40:43", "text": "夕食を食べて寝たりしてたと思う"}, {"type": "subtitle", "time": 13245.83, "timestamp": "03:40:45", "text": "。"}, {"type": "subtitle", "time": 13252.07, "timestamp": "03:40:52", "text": "ちょっと話してもいいかな？ ええ、もちろんです。 もちろん。"}, {"type": "subtitle", "time": 13256.63, "timestamp": "03:40:56", "text": "遠慮なくどうぞ。"}, {"type": "subtitle", "time": 13258.87, "timestamp": "03:40:58", "text": "ちょっと寄り道をして、ただ"}]
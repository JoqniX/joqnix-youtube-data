[{"type": "subtitle", "time": 7083.189, "timestamp": "01:58:03", "text": "。しばらく前から考えていたことですから。 はい、すみません、おしゃべりしてしまいました"}, {"type": "subtitle", "time": 7085.75, "timestamp": "01:58:05", "text": "。"}, {"type": "subtitle", "time": 7089.589, "timestamp": "01:58:09", "text": "だから、多少の傷はつくかもしれないけれど、"}, {"type": "subtitle", "time": 7092.47, "timestamp": "01:58:12", "text": "たとえ傷がついていても、"}, {"type": "subtitle", "time": 7095.189, "timestamp": "01:58:15", "text": "きちんと見せたいんです。"}, {"type": "subtitle", "time": 7097.99, "timestamp": "01:58:17", "text": "でも、"}, {"type": "subtitle", "time": 7101.35, "timestamp": "01:58:21", "text": "遠い将来にライブ 2D アップグレード ストリームを行うときには"}, {"type": "subtitle", "time": 7103.189, "timestamp": "01:58:23", "text": "、モデルが最終的に"}, {"type": "subtitle", "time": 7105.51, "timestamp": "01:58:25", "text": "アップグレードされたら、"}, {"type": "subtitle", "time": 7108.229, "timestamp": "01:58:28", "text": "ようやく、えーと、なんて"}, {"type": "subtitle", "time": 7111.589, "timestamp": "01:58:31", "text": "言うんだっけ？   その時になれば、ようやく自分のやりたいようにできるんだ"}, {"type": "subtitle", "time": 7120.55, "timestamp": "01:58:40", "text": "。   その頃には状況は"}, {"type": "subtitle", "time": 7122.95, "timestamp": "01:58:42", "text": "良くなっているだろう。 あと、"}, {"type": "subtitle", "time": 7127.83, "timestamp": "01:58:47", "text": "これを言い忘れていました。 ミナ、"}, {"type": "subtitle", "time": 7131.75, "timestamp": "01:58:51", "text": "ギターを買ったよ。 私のギターを見たいですか？"}, {"type": "subtitle", "time": 7134.47, "timestamp": "01:58:54", "text": "ギターを買いました。"}, {"type": "subtitle", "time": 7136.31, "timestamp": "01:58:56", "text": "M 私は"}]
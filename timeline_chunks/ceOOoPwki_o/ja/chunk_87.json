[{"type": "subtitle", "time": 5221.11, "timestamp": "01:27:01", "text": "昨日行った滝とかがあるエリアに行きたい気分だ。"}, {"type": "subtitle", "time": 5228.709, "timestamp": "01:27:08", "text": "あ、待って。私もここに来られます。"}, {"type": "subtitle", "time": 5231.59, "timestamp": "01:27:11", "text": "うん、こっちに行こう。通りました"}, {"type": "subtitle", "time": 5234.31, "timestamp": "01:27:14", "text": "。ここはバーエリアです。"}, {"type": "subtitle", "time": 5237.03, "timestamp": "01:27:17", "text": "ここを通りました。"}, {"type": "subtitle", "time": 5243.43, "timestamp": "01:27:23", "text": "ここに来られます。"}, {"type": "subtitle", "time": 5247.51, "timestamp": "01:27:27", "text": "大学時代の計画とか、そういうことです"}, {"type": "subtitle", "time": 5251.189, "timestamp": "01:27:31", "text": "。グループディスカッション。"}, {"type": "subtitle", "time": 5253.43, "timestamp": "01:27:33", "text": "でも外国人として、誰が私と話してくれるんだろう"}, {"type": "subtitle", "time": 5255.43, "timestamp": "01:27:35", "text": "？"}, {"type": "subtitle", "time": 5258.47, "timestamp": "01:27:38", "text": "誰が私と話してくれるんだろう？でも、"}, {"type": "subtitle", "time": 5260.55, "timestamp": "01:27:40", "text": "言葉がよく分からなくて、"}]
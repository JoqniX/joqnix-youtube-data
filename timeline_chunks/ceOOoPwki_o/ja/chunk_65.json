[{"type": "subtitle", "time": 3910.63, "timestamp": "01:05:10", "text": "機会を逃しました。何人かの少年は、"}, {"type": "subtitle", "time": 3913.109, "timestamp": "01:05:13", "text": "私が"}, {"type": "subtitle", "time": 3915.829, "timestamp": "01:05:15", "text": "ストリーミングしているのを見て、私と話したがっていましたが、"}, {"type": "subtitle", "time": 3918.549, "timestamp": "01:05:18", "text": "私はとても恥ずかしがり屋で、近くの店に行きました。私は"}, {"type": "subtitle", "time": 3925.91, "timestamp": "01:05:25", "text": "とても恥ずかしがり屋です。私は"}, {"type": "subtitle", "time": 3928.069, "timestamp": "01:05:28", "text": "本当に"}, {"type": "subtitle", "time": 3942.39, "timestamp": "01:05:42", "text": "わあ、"}, {"type": "subtitle", "time": 3945.349, "timestamp": "01:05:45", "text": "このエリアは本当に素敵です。"}, {"type": "subtitle", "time": 3948.23, "timestamp": "01:05:48", "text": "私だけでしょうか、それとも私は"}]
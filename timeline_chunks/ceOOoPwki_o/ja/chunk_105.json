[{"type": "subtitle", "time": 6300.39, "timestamp": "01:45:00", "text": "遅刻しそうだな。 水を取ってきます。"}, {"type": "subtitle", "time": 6303.59, "timestamp": "01:45:03", "text": "あなたは一体何者なのですか？ ねえ、"}, {"type": "subtitle", "time": 6309.99, "timestamp": "01:45:09", "text": "ここに座ってもいいと思います。 そうですね、あのね"}, {"type": "subtitle", "time": 6312.629, "timestamp": "01:45:12", "text": "？ 私はここに座ります。 ええ、"}, {"type": "subtitle", "time": 6315.43, "timestamp": "01:45:15", "text": "ここに座らせてください。"}, {"type": "subtitle", "time": 6321.189, "timestamp": "01:45:21", "text": "、もう本当に"}, {"type": "subtitle", "time": 6324.79, "timestamp": "01:45:24", "text": "疲れた。"}, {"type": "subtitle", "time": 6332.07, "timestamp": "01:45:32", "text": "勉強するにしても、ここは良い場所だと言えるでしょう"}, {"type": "subtitle", "time": 6335.59, "timestamp": "01:45:35", "text": "。 うん。"}, {"type": "subtitle", "time": 6338.149, "timestamp": "01:45:38", "text": "応援する観客。 それは私が"}, {"type": "subtitle", "time": 6356.629, "timestamp": "01:45:56", "text": "さて、皆さんの日曜日はいかがでしたか？"}]
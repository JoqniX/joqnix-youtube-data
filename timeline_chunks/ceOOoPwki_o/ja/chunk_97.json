[{"type": "subtitle", "time": 5830.149, "timestamp": "01:37:10", "text": "日本の"}, {"type": "subtitle", "time": 5834.629, "timestamp": "01:37:14", "text": "松田がこんな風に閉まるのを見るのは初めてだ。こんなの"}, {"type": "subtitle", "time": 5858.709, "timestamp": "01:37:38", "text": "時々、私は近寄りがたい"}, {"type": "subtitle", "time": 5862.55, "timestamp": "01:37:42", "text": "雰囲気を出しているのかなと思う。"}, {"type": "subtitle", "time": 5864.95, "timestamp": "01:37:44", "text": "誰かが私と話したいと思っても、私はとても"}, {"type": "subtitle", "time": 5867.59, "timestamp": "01:37:47", "text": "控えめで、"}, {"type": "subtitle", "time": 5869.43, "timestamp": "01:37:49", "text": "私みたいな人と話すのは難しいような気がする"}, {"type": "subtitle", "time": 5870.95, "timestamp": "01:37:50", "text": "。"}, {"type": "subtitle", "time": 5873.83, "timestamp": "01:37:53", "text": "時々、私は自分の中に"}, {"type": "subtitle", "time": 5877.03, "timestamp": "01:37:57", "text": "防御があって、"}]
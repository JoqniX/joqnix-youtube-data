[{"type": "subtitle", "time": 121.429, "timestamp": "00:02:01", "text": "荷物を降ろさせてください。   あ"}, {"type": "subtitle", "time": 124.389, "timestamp": "00:02:04", "text": "、こんにちは。"}, {"type": "subtitle", "time": 126.149, "timestamp": "00:02:06", "text": "どうすればあなたに連絡できますか？ えっと、私のことは"}, {"type": "subtitle", "time": 130.55, "timestamp": "00:02:10", "text": "ジョーと呼んでください。 こんにちは、ヨギーの皆さん。 ええと、今日が"}, {"type": "subtitle", "time": 134.07, "timestamp": "00:02:14", "text": "松日祭の最終日になります。 ええ、"}, {"type": "subtitle", "time": 135.43, "timestamp": "00:02:15", "text": "今日が"}, {"type": "subtitle", "time": 141.35, "timestamp": "00:02:21", "text": "松日祭の最終日です。 ええ、ええ、ワクワクしています。"}, {"type": "subtitle", "time": 144.39, "timestamp": "00:02:24", "text": "配信開始がちょっと遅れてしまいました。"}, {"type": "subtitle", "time": 147.67000000000002, "timestamp": "00:02:27", "text": "ペドラスピード​​で、ジェタと一緒にここにいます。"}, {"type": "chat", "time": 153.516, "timestamp": "00:02:33", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "hi hi~"}, {"type": "subtitle", "time": 153.99, "timestamp": "00:02:33", "text": "今回は外部マイクを使用します。"}, {"type": "subtitle", "time": 161.50900000000001, "timestamp": "00:02:41", "text": "後で電話のスピーカーに切り替えます。ええ、現在"}, {"type": "subtitle", "time": 166.39, "timestamp": "00:02:46", "text": "お聞きになっている音声は、私が持っている外部マイクからのものです。"}, {"type": "subtitle", "time": 167.82999999999998, "timestamp": "00:02:47", "text": "[笑い]"}, {"type": "subtitle", "time": 170.63, "timestamp": "00:02:50", "text": "なので、"}, {"type": "subtitle", "time": 173.43, "timestamp": "00:02:53", "text": "音量をどのくらいに設定すればいいか教えてください。"}, {"type": "subtitle", "time": 175.99, "timestamp": "00:02:55", "text": "現在、ノイズ抑制は使用していないと"}, {"type": "subtitle", "time": 179.03, "timestamp": "00:02:59", "text": "思います。 このマイクのノイズ"}]
[{"type": "subtitle", "time": 13508.309, "timestamp": "03:45:08", "text": "うん。 うん。 ええ、そうですね。 第一"}, {"type": "subtitle", "time": 13509.83, "timestamp": "03:45:09", "text": "印象が一番大事ですよね"}, {"type": "subtitle", "time": 13512.95, "timestamp": "03:45:12", "text": "？ だから彼は"}, {"type": "subtitle", "time": 13517.269, "timestamp": "03:45:17", "text": "普通のことを話すんだ。"}, {"type": "subtitle", "time": 13519.11, "timestamp": "03:45:19", "text": "お互いに"}, {"type": "subtitle", "time": 13527.03, "timestamp": "03:45:27", "text": "えっと、私はここに来ました。"}, {"type": "subtitle", "time": 13530.15, "timestamp": "03:45:30", "text": "ここはどこ？"}, {"type": "subtitle", "time": 13535.75, "timestamp": "03:45:35", "text": "。 ここはどこ？ 歩き続けて、話し続け、そして道に迷ってしまった"}, {"type": "subtitle", "time": 13540.309, "timestamp": "03:45:40", "text": "。"}, {"type": "subtitle", "time": 13543.99, "timestamp": "03:45:43", "text": "ああ、ここは公園だ。 ここに行こう。   わからない"}, {"type": "subtitle", "time": 13547.99, "timestamp": "03:45:47", "text": "。 ガクはそう言ったのか？"}, {"type": "subtitle", "time": 13550.55, "timestamp": "03:45:50", "text": "何？"}, {"type": "subtitle", "time": 13553.51, "timestamp": "03:45:53", "text": "配信画面が緑色に見えるのはなぜですか？"}, {"type": "subtitle", "time": 13556.71, "timestamp": "03:45:56", "text": "私にとっては普通のことですが。 ああ、もう。 ああ、神様。 ああ、"}, {"type": "subtitle", "time": 13558.469, "timestamp": "03:45:58", "text": "神様。 犬がいるか、"}]
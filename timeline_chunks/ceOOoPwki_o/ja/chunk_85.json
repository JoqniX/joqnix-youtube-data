[{"type": "subtitle", "time": 5102.39, "timestamp": "01:25:02", "text": "どうしてこうなんだろう？"}, {"type": "subtitle", "time": 5107.189, "timestamp": "01:25:07", "text": "私のコミュニケーション能力は悪い。"}, {"type": "subtitle", "time": 5109.669, "timestamp": "01:25:09", "text": "うん、"}, {"type": "subtitle", "time": 5117.189, "timestamp": "01:25:17", "text": "コミュニケーション"}, {"type": "subtitle", "time": 5119.27, "timestamp": "01:25:19", "text": "能力を磨かないといけない。"}, {"type": "subtitle", "time": 5122.87, "timestamp": "01:25:22", "text": "ああ、そうだ。今日は日曜日だった。えっと、"}, {"type": "subtitle", "time": 5126.47, "timestamp": "01:25:26", "text": "もし早起きしていたら、"}, {"type": "subtitle", "time": 5129.11, "timestamp": "01:25:29", "text": "教会に行って彼らに会えたかもしれない"}, {"type": "subtitle", "time": 5131.27, "timestamp": "01:25:31", "text": "。彼らはそこにいたから。マイクが必要だった時にさっき会った2人、"}, {"type": "subtitle", "time": 5133.59, "timestamp": "01:25:33", "text": "3人"}, {"type": "subtitle", "time": 5142.95, "timestamp": "01:25:42", "text": "1人はアメリカ人で、もう1人は"}, {"type": "subtitle", "time": 5146.55, "timestamp": "01:25:46", "text": "どこから来たのか分からないけど、"}]
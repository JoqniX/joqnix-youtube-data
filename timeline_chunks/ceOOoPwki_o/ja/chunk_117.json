[{"type": "subtitle", "time": 7020.31, "timestamp": "01:57:00", "text": "Sakurabunって、えっと、日本語でエッセイとか書いてる人だよ"}, {"type": "subtitle", "time": 7023.03, "timestamp": "01:57:03", "text": "ね？ うん、私はそれが苦手なんだ"}, {"type": "subtitle", "time": 7025.669, "timestamp": "01:57:05", "text": "。 私はその点をもっと上達させなければならない。"}, {"type": "subtitle", "time": 7029.109, "timestamp": "01:57:09", "text": "それができれば、私はうまくやっていけるだろう"}, {"type": "subtitle", "time": 7032.149, "timestamp": "01:57:12", "text": "。"}, {"type": "subtitle", "time": 7047.189, "timestamp": "01:57:27", "text": "でも、うん、待ちきれないよ（笑）。"}, {"type": "subtitle", "time": 7049.51, "timestamp": "01:57:29", "text": "明日が本当に楽しみ。"}, {"type": "subtitle", "time": 7052.31, "timestamp": "01:57:32", "text": "明日ではない。 明日が楽しみかって？"}, {"type": "subtitle", "time": 7055.109, "timestamp": "01:57:35", "text": "明日は仕事だ。 朝"}, {"type": "subtitle", "time": 7060.79, "timestamp": "01:57:40", "text": "6時に起きて、準備をして、8時までに到着して、仕事、学校、そして帰宅"}, {"type": "subtitle", "time": 7062.95, "timestamp": "01:57:42", "text": "。"}, {"type": "subtitle", "time": 7071.109, "timestamp": "01:57:51", "text": "リコーダーの授業の遅れを取り戻さなきゃいけないことに今気づいた。 だから、デビューに向けて準備する時間さえほとんどないんじゃないかと、すごく不安です"}, {"type": "subtitle", "time": 7075.75, "timestamp": "01:57:55", "text": "。"}, {"type": "subtitle", "time": 7078.47, "timestamp": "01:57:58", "text": "デモンは、デビューについて話すなら、一つありますね"}]
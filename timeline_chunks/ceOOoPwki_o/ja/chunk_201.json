[{"type": "subtitle", "time": 12061.99, "timestamp": "03:21:01", "text": "それから東京かどこか別の"}, {"type": "subtitle", "time": 12072.79, "timestamp": "03:21:12", "text": "東京や渋谷のような"}, {"type": "subtitle", "time": 12076.469, "timestamp": "03:21:16", "text": "混雑した観光地を想像しているんじゃないでしょうか。"}, {"type": "subtitle", "time": 12079.19, "timestamp": "03:21:19", "text": "ストリーミング配信をしていたのは私だけだったと思うのですが、"}, {"type": "subtitle", "time": 12081.75, "timestamp": "03:21:21", "text": "私の配信を見た人たちが"}, {"type": "subtitle", "time": 12087.269, "timestamp": "03:21:27", "text": "私の後ろで日本語で「あ、この人"}, {"type": "subtitle", "time": 12089.269, "timestamp": "03:21:29", "text": "ストリーミング配信してるよ」とか言っていました"}, {"type": "subtitle", "time": 12091.91, "timestamp": "03:21:31", "text": "。 私は恥ずかしくて、振り返って"}, {"type": "subtitle", "time": 12093.91, "timestamp": "03:21:33", "text": "話しかけることができなかった。"}, {"type": "subtitle", "time": 12097.269, "timestamp": "03:21:37", "text": "だから人々は批判していたのだ。 あまりない。"}, {"type": "subtitle", "time": 12099.51, "timestamp": "03:21:39", "text": "実際には誰も批判しなかった。"}, {"type": "subtitle", "time": 12102.309, "timestamp": "03:21:42", "text": "それは驚きだった。 いいえ。えっと、実は、"}, {"type": "subtitle", "time": 12110.07, "timestamp": "03:21:50", "text": "お店を撮影されるのを嫌がる人もいると思っていました。 誰かから声をかけられましたか"}, {"type": "subtitle", "time": 12114.229, "timestamp": "03:21:54", "text": "？ えーと、何人かの人に会ったんだけど、"}, {"type": "subtitle", "time": 12116.309, "timestamp": "03:21:56", "text": "地元の人たちにも会ったよ。 私はフェスティバルで彼らを見かけました"}, {"type": "subtitle", "time": 12119.269, "timestamp": "03:21:59", "text": "。 私は彼らと話しました。"}]
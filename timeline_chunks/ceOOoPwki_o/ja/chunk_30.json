[{"type": "subtitle", "time": 1800.07, "timestamp": "00:30:00", "text": "62度です。 ええ、そうですね。"}, {"type": "subtitle", "time": 1803.99, "timestamp": "00:30:03", "text": "ステージエリアをご覧になりたいですか？ つまり、私が"}, {"type": "subtitle", "time": 1807.19, "timestamp": "00:30:07", "text": "ステージエリアを見せられることは分かっているということです。   わかった"}, {"type": "subtitle", "time": 1817.43, "timestamp": "00:30:17", "text": "ええと、そうですね。 ステージ"}, {"type": "subtitle", "time": 1820.07, "timestamp": "00:30:20", "text": "61。マイクから"}, {"type": "subtitle", "time": 1828.63, "timestamp": "00:30:28", "text": "モバイルバッテリーに切り替えます。 わかった。"}, {"type": "subtitle", "time": 1837.269, "timestamp": "00:30:37", "text": "本当にひどい。"}, {"type": "subtitle", "time": 1840.63, "timestamp": "00:30:40", "text": "ゲームとかでズルしちゃいけないよ（笑）"}, {"type": "subtitle", "time": 1843.51, "timestamp": "00:30:43", "text": "。"}, {"type": "subtitle", "time": 1846.23, "timestamp": "00:30:46", "text": "昨日、たくさんの子供たちが"}, {"type": "subtitle", "time": 1849.51, "timestamp": "00:30:49", "text": "マットの飾り付けなどをしているのを見かけました。"}, {"type": "subtitle", "time": 1852.95, "timestamp": "00:30:52", "text": "さあ、今日は"}, {"type": "subtitle", "time": 1854.71, "timestamp": "00:30:54", "text": "最終日だから、全部閉まるよ。"}, {"type": "subtitle", "time": 1857.99, "timestamp": "00:30:57", "text": "昨日はたくさんの人がいました。"}]
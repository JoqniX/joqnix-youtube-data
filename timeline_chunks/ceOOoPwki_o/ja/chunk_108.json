[{"type": "subtitle", "time": 6483.189, "timestamp": "01:48:03", "text": "。"}, {"type": "subtitle", "time": 6487.27, "timestamp": "01:48:07", "text": "うん。 来週の土曜日までに美容関連のものを用意します"}, {"type": "subtitle", "time": 6489.35, "timestamp": "01:48:09", "text": "。 いや。"}, {"type": "subtitle", "time": 6511.75, "timestamp": "01:48:31", "text": "現実の生活って、なかなかすごいものだね。"}, {"type": "subtitle", "time": 6515.03, "timestamp": "01:48:35", "text": "想像していたのと全然違う。"}, {"type": "subtitle", "time": 6517.189, "timestamp": "01:48:37", "text": "うん。"}, {"type": "subtitle", "time": 6519.99, "timestamp": "01:48:39", "text": "そして、私は今でも"}, {"type": "subtitle", "time": 6523.189, "timestamp": "01:48:43", "text": "顔から笑みが消えません。すごい。"}, {"type": "subtitle", "time": 6526.149, "timestamp": "01:48:46", "text": "実は、日本の祭りに参加したことがあるんです"}, {"type": "subtitle", "time": 6528.149, "timestamp": "01:48:48", "text": "。"}, {"type": "subtitle", "time": 6531.91, "timestamp": "01:48:51", "text": "それに、まだやるべきことがたくさんありますよね"}, {"type": "subtitle", "time": 6535.109, "timestamp": "01:48:55", "text": "？"}, {"type": "subtitle", "time": 6537.59, "timestamp": "01:48:57", "text": "カメラをオフにした方がいいですか、"}]
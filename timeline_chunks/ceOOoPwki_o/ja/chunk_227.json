[{"type": "subtitle", "time": 13623.91, "timestamp": "03:47:03", "text": "はぁ？"}, {"type": "subtitle", "time": 13626.229, "timestamp": "03:47:06", "text": "カメラ。"}, {"type": "subtitle", "time": 13629.429, "timestamp": "03:47:09", "text": "濡れすぎちゃったかな？ とても濡れていて、"}, {"type": "subtitle", "time": 13633.11, "timestamp": "03:47:13", "text": "ああ、そうだ。 先ほどは雨が降っていた。"}, {"type": "subtitle", "time": 13635.349, "timestamp": "03:47:15", "text": "おお。"}, {"type": "subtitle", "time": 13638.309, "timestamp": "03:47:18", "text": "なあ、誰か見たよ。 何？ おい、"}, {"type": "subtitle", "time": 13644.389, "timestamp": "03:47:24", "text": "あなたはあの"}, {"type": "subtitle", "time": 13659.189, "timestamp": "03:47:39", "text": "いや、"}, {"type": "subtitle", "time": 13661.269, "timestamp": "03:47:41", "text": "あの人じゃないよ。 画面の裏側に何かがある"}, {"type": "subtitle", "time": 13664.07, "timestamp": "03:47:44", "text": "。"}, {"type": "subtitle", "time": 13666.95, "timestamp": "03:47:46", "text": "ダニエル、私を怖がらせないで、アストラ。"}, {"type": "subtitle", "time": 13670.71, "timestamp": "03:47:50", "text": "アストラ、お前をぶん殴ってやる。 ああ、あの"}]
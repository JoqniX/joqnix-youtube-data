[{"type": "subtitle", "time": 12841.03, "timestamp": "03:34:01", "text": "友人とこの"}, {"type": "subtitle", "time": 12843.91, "timestamp": "03:34:03", "text": "話をしていたとき、彼らが"}, {"type": "subtitle", "time": 12847.67, "timestamp": "03:34:07", "text": "日本に行ったとき（"}, {"type": "subtitle", "time": 12849.83, "timestamp": "03:34:09", "text": "アメリカに行ったときではない）"}, {"type": "subtitle", "time": 12854.87, "timestamp": "03:34:14", "text": "、生卵と"}, {"type": "subtitle", "time": 12857.75, "timestamp": "03:34:17", "text": "ご飯を一緒に食べてみたら"}, {"type": "subtitle", "time": 12863.028, "timestamp": "03:34:23", "text": "美味しくなかったと言っていました。 味がすごくまずい。"}, {"type": "subtitle", "time": 12864.309, "timestamp": "03:34:24", "text": "[笑い]"}, {"type": "subtitle", "time": 12866.95, "timestamp": "03:34:26", "text": "日本みたいに、卵がすごく美味しいとか"}, {"type": "subtitle", "time": 12869.59, "timestamp": "03:34:29", "text": "何とか。 おそらく"}, {"type": "subtitle", "time": 12871.11, "timestamp": "03:34:31", "text": "衛生面に関係しているのでしょう"}, {"type": "subtitle", "time": 12872.95, "timestamp": "03:34:32", "text": "。"}, {"type": "subtitle", "time": 12876.95, "timestamp": "03:34:36", "text": "うん。 また、今は午後10時です。 ああ、もう午後"}, {"type": "subtitle", "time": 12883.349, "timestamp": "03:34:43", "text": "つまり、これはあなたにとっては気持ち悪いものではないということですね。 つまり、"}, {"type": "subtitle", "time": 12886.55, "timestamp": "03:34:46", "text": "生卵を食べるのは、別に気持ち悪いことじゃないよね。"}, {"type": "subtitle", "time": 12890.71, "timestamp": "03:34:50", "text": "私とルームメイトは"}, {"type": "subtitle", "time": 12893.99, "timestamp": "03:34:53", "text": "生卵を食べると思います。 私たちはそれをご飯にのせて、"}, {"type": "subtitle", "time": 12897.19, "timestamp": "03:34:57", "text": "日本から持ち帰ります。 日本の卵は"}]
[{"type": "subtitle", "time": 11703.51, "timestamp": "03:15:03", "text": "あと、ロック"}, {"type": "subtitle", "time": 11706.469, "timestamp": "03:15:06", "text": "機能、アプリロック機能を追加した方がいいと思います。"}, {"type": "subtitle", "time": 11709.429, "timestamp": "03:15:09", "text": "うん、本当にそうするべきだよ。 ディオ、何が"}, {"type": "subtitle", "time": 11714.07, "timestamp": "03:15:14", "text": "起こったか知ってるか？ 入れようとしたんだけど、"}, {"type": "subtitle", "time": 11715.83, "timestamp": "03:15:15", "text": "何が起こったか分かる？"}, {"type": "subtitle", "time": 11717.59, "timestamp": "03:15:17", "text": "ストリームを"}, {"type": "subtitle", "time": 11721.51, "timestamp": "03:15:21", "text": "自転車の"}, {"type": "subtitle", "time": 11725.19, "timestamp": "03:15:25", "text": "カゴに置こうとしたら、"}, {"type": "subtitle", "time": 11730.55, "timestamp": "03:15:30", "text": "ライブストリームを停止するボタンが文字通りカチッと音がしました"}, {"type": "subtitle", "time": 11733.03, "timestamp": "03:15:33", "text": "。"}, {"type": "subtitle", "time": 11739.75, "timestamp": "03:15:39", "text": "ライブストリームを終了するには確認画面を作る必要があると思うのですが、それとも、いや、"}, {"type": "subtitle", "time": 11742.309, "timestamp": "03:15:42", "text": "待ってください。 両方ともやらなければならない。"}, {"type": "subtitle", "time": 11750.07, "timestamp": "03:15:50", "text": "ゴミを捨てている人がいる。 あれは"}, {"type": "subtitle", "time": 11758.95, "timestamp": "03:15:58", "text": "撮影すべきではなかった。"}]
[{"type": "subtitle", "time": 6360.39, "timestamp": "01:46:00", "text": "皆さん、週末はいかがでしたか？   私にとって"}, {"type": "subtitle", "time": 6363.51, "timestamp": "01:46:03", "text": "。 私はここにいるのは、"}, {"type": "subtitle", "time": 6365.83, "timestamp": "01:46:05", "text": "デビュー"}, {"type": "subtitle", "time": 6368.629, "timestamp": "01:46:08", "text": "スライドを作成する作業を行うはずだったのに、今日になってもまだ完成していないのに、"}, {"type": "subtitle", "time": 6376.149, "timestamp": "01:46:16", "text": "ここでサボっているのではなく、"}, {"type": "subtitle", "time": 6378.79, "timestamp": "01:46:18", "text": "コンテンツを作成しているからです。 うん。"}, {"type": "subtitle", "time": 6382.07, "timestamp": "01:46:22", "text": "それで、私はここに来て、"}, {"type": "subtitle", "time": 6386.95, "timestamp": "01:46:26", "text": "配信で祭りの様子を見に行きたかったんです。"}, {"type": "subtitle", "time": 6391.51, "timestamp": "01:46:31", "text": "正直に言うと、"}, {"type": "subtitle", "time": 6397.51, "timestamp": "01:46:37", "text": "最終日に配信しないという選択肢もあったんです。"}, {"type": "subtitle", "time": 6400.39, "timestamp": "01:46:40", "text": "えっと、だって、だって、"}, {"type": "subtitle", "time": 6402.629, "timestamp": "01:46:42", "text": "昨日もう配信したから。   つまり、特に"}, {"type": "subtitle", "time": 6409.99, "timestamp": "01:46:49", "text": "理由もなくエビを2匹食べたようなものだ。"}, {"type": "subtitle", "time": 6413.03, "timestamp": "01:46:53", "text": "泥だらけの街をただぶらぶら歩き回っているだけ。"}, {"type": "subtitle", "time": 6415.669, "timestamp": "01:46:55", "text": "それでおしまい。 いろいろなものを見せる"}, {"type": "subtitle", "time": 6417.35, "timestamp": "01:46:57", "text": "。"}, {"type": "subtitle", "time": 6419.109, "timestamp": "01:46:59", "text": "今回の配信ではあまり多くのことをお見せできなかったと思います。 ただひたすら"}]
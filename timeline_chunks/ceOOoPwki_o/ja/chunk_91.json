[{"type": "subtitle", "time": 5465.51, "timestamp": "01:31:05", "text": "何だろう 彼らは"}, {"type": "subtitle", "time": 5468.229, "timestamp": "01:31:08", "text": "食べ物をどうするつもりなんだろう。家に帰って"}, {"type": "subtitle", "time": 5472.31, "timestamp": "01:31:12", "text": "自分たちで食べるのかな？みんな"}, {"type": "subtitle", "time": 5506.87, "timestamp": "01:31:46", "text": "歩いている時は必ず車に乗って、この"}, {"type": "subtitle", "time": 5517.27, "timestamp": "01:31:57", "text": "自分がどこにいるのか分からない"}, {"type": "subtitle", "time": 5519.91, "timestamp": "01:31:59", "text": "けど、たぶん正しい場所に向かっているような気がする"}]
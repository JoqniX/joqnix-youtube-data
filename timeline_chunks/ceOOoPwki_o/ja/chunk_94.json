[{"type": "subtitle", "time": 5647.43, "timestamp": "01:34:07", "text": "道を渡らないといけない気がする。"}, {"type": "subtitle", "time": 5651.99, "timestamp": "01:34:11", "text": "あの辺りだと思う。ステージの後、あの辺りの"}, {"type": "subtitle", "time": 5655.43, "timestamp": "01:34:15", "text": "後だ。"}, {"type": "subtitle", "time": 5657.75, "timestamp": "01:34:17", "text": "ああ、あの辺りだ。ここを通ったことがない気がする。ここを通ったことがない。ここを通れる。ここを通ったことがない"}, {"type": "subtitle", "time": 5662.79, "timestamp": "01:34:22", "text": "。ここが好きだ"}, {"type": "subtitle", "time": 5664.55, "timestamp": "01:34:24", "text": "。どうやってここに来たんだろう"}, {"type": "subtitle", "time": 5691.75, "timestamp": "01:34:51", "text": "ここに来たことがない。"}]
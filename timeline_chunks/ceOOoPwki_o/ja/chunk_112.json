[{"type": "subtitle", "time": 6729.27, "timestamp": "01:52:09", "text": "話し続ける。 うん。   だから"}, {"type": "subtitle", "time": 6737.27, "timestamp": "01:52:17", "text": "嬉しいし、ある意味では自分を誇りに思っている。"}, {"type": "subtitle", "time": 6741.43, "timestamp": "01:52:21", "text": "そう、私は"}, {"type": "subtitle", "time": 6747.669, "timestamp": "01:52:27", "text": "ストリーマーのようにライブストリームのVlogを始めた。"}, {"type": "subtitle", "time": 6750.709, "timestamp": "01:52:30", "text": "右。 これまで何年も、"}, {"type": "subtitle", "time": 6753.109, "timestamp": "01:52:33", "text": "音声だけの屋外配信をしていた時、"}, {"type": "subtitle", "time": 6758.95, "timestamp": "01:52:38", "text": "カメラの背面カメラを開けて配信するのがすごく恥ずかしかったんです。"}, {"type": "subtitle", "time": 6763.109, "timestamp": "01:52:43", "text": "スマホの"}, {"type": "subtitle", "time": 6766.149, "timestamp": "01:52:46", "text": "バッテリーとかがすぐに切れてしまうこともよくありましたし、配信が"}, {"type": "subtitle", "time": 6773.669, "timestamp": "01:52:53", "text": "できないんじゃないかとか、すごく心配していました"}, {"type": "subtitle", "time": 6776.629, "timestamp": "01:52:56", "text": "。"}]
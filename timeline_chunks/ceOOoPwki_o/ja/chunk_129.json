[{"type": "subtitle", "time": 7742.149, "timestamp": "02:09:02", "text": "興味を持つようになったのは、ある意味、私自身にも少し影響があったんだ。 私は「"}, {"type": "subtitle", "time": 7746.709, "timestamp": "02:09:06", "text": "jw walking」と入力しようとしていました。   ここには他にもたくさんあります"}, {"type": "subtitle", "time": 7750.31, "timestamp": "02:09:10", "text": "。"}, {"type": "subtitle", "time": 7752.55, "timestamp": "02:09:12", "text": "詳細はそちらをご覧ください。"}, {"type": "subtitle", "time": 7764.95, "timestamp": "02:09:24", "text": "私だけが、あちこち"}, {"type": "subtitle", "time": 7767.27, "timestamp": "02:09:27", "text": "歩き回ってあらゆるものを撮影しているような気がする。"}, {"type": "subtitle", "time": 7769.27, "timestamp": "02:09:29", "text": "終わった後も、皆それぞれ"}, {"type": "subtitle", "time": 7771.669, "timestamp": "02:09:31", "text": "着替えて帰っていく。"}, {"type": "subtitle", "time": 7773.83, "timestamp": "02:09:33", "text": "ええ、"}, {"type": "subtitle", "time": 7782.39, "timestamp": "02:09:42", "text": "ここには誰もいない。"}, {"type": "subtitle", "time": 7784.79, "timestamp": "02:09:44", "text": "皆、荷物をまとめて帰った。 私たちは"}, {"type": "subtitle", "time": 7787.99, "timestamp": "02:09:47", "text": "これを一年中見てきました。 皆さん、覚えていますか？ 私たちは"}, {"type": "subtitle", "time": 7790.31, "timestamp": "02:09:50", "text": "これを一年中見てきました。 私はもう"}, {"type": "subtitle", "time": 7794.47, "timestamp": "02:09:54", "text": "3回もここに来ています。"}]
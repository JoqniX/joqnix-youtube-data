[{"type": "subtitle", "time": 8100.629, "timestamp": "02:15:00", "text": "ああ、ここは100番エンドストアですね。"}, {"type": "subtitle", "time": 8103.669, "timestamp": "02:15:03", "text": "ここで何か買うべきでしょうか？"}, {"type": "subtitle", "time": 8107.83, "timestamp": "02:15:07", "text": "一緒にコミニに行きませんか？"}, {"type": "subtitle", "time": 8117.109, "timestamp": "02:15:17", "text": "100円ショップです。 できます。"}, {"type": "subtitle", "time": 8120.069, "timestamp": "02:15:20", "text": "行ってもいいし、"}, {"type": "subtitle", "time": 8124.229, "timestamp": "02:15:24", "text": "セブンイレブンに行ってもいい。"}, {"type": "subtitle", "time": 8127.669, "timestamp": "02:15:27", "text": "でも問題は、私の自転車が"}, {"type": "subtitle", "time": 8129.27, "timestamp": "02:15:29", "text": "近くにないということです。   だから、"}, {"type": "subtitle", "time": 8143.35, "timestamp": "02:15:43", "text": "少年が私の上に倒れてきた。 何？"}, {"type": "subtitle", "time": 8151.83, "timestamp": "02:15:51", "text": "ああ、あの女性は今、OKか"}, {"type": "subtitle", "time": 8154.709, "timestamp": "02:15:54", "text": "何かと言おうとしたんだ。"}]
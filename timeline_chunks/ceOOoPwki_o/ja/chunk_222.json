[{"type": "subtitle", "time": 13320.309, "timestamp": "03:42:00", "text": "あなたはあなたらしくなり、それを"}, {"type": "subtitle", "time": 13323.349, "timestamp": "03:42:03", "text": "成し遂げるためのエネルギーを得られるでしょう。 実際、"}, {"type": "subtitle", "time": 13325.83, "timestamp": "03:42:05", "text": "効果はある。   ある意味、"}, {"type": "subtitle", "time": 13328.87, "timestamp": "03:42:08", "text": "ポジティブに考えれば"}, {"type": "subtitle", "time": 13330.63, "timestamp": "03:42:10", "text": "、"}, {"type": "subtitle", "time": 13343.99, "timestamp": "03:42:23", "text": "それで、ドゥナ、"}, {"type": "subtitle", "time": 13347.99, "timestamp": "03:42:27", "text": "私は今どこにいるの？ 何てことだ。 待って、"}, {"type": "subtitle", "time": 13351.19, "timestamp": "03:42:31", "text": "ここから左に曲がったんだ。   あらら。"}, {"type": "subtitle", "time": 13356.469, "timestamp": "03:42:36", "text": "ああ、"}, {"type": "subtitle", "time": 13359.75, "timestamp": "03:42:39", "text": "この場所、見覚えがある。 わかった。"}, {"type": "subtitle", "time": 13367.349, "timestamp": "03:42:47", "text": "緊張していません。 問題は、もうこれ以上"}, {"type": "subtitle", "time": 13374.79, "timestamp": "03:42:54", "text": "質問したり話したり、コミュニケーションについて話すことが何もないということです"}, {"type": "subtitle", "time": 13377.75, "timestamp": "03:42:57", "text": "。 はぁ。"}]
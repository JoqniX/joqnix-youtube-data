[{"type": "subtitle", "time": 2943.03, "timestamp": "00:49:03", "text": "なぜ誰も手に入れなかったのか。ああ、待って。よし、それは"}, {"type": "subtitle", "time": 2976.309, "timestamp": "00:49:36", "text": "彼女はプロを目指している。どこで手に入れたんだろう"}, {"type": "subtitle", "time": 2985.829, "timestamp": "00:49:45", "text": "いつか私もそうするつもり。"}, {"type": "subtitle", "time": 2987.829, "timestamp": "00:49:47", "text": "心配しないで、ミナ。来年"}, {"type": "subtitle", "time": 2990.71, "timestamp": "00:49:50", "text": "またここに来るよ。でも来年"}, {"type": "subtitle", "time": 2993.43, "timestamp": "00:49:53", "text": "来るときは準備万端で来るつもり。その頃には機材を"}]
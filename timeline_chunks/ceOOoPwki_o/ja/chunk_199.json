[{"type": "subtitle", "time": 11942.15, "timestamp": "03:19:02", "text": "カメラをフル稼働させていると、バッテリーをすぐに消耗してしまいます。"}, {"type": "subtitle", "time": 11946.07, "timestamp": "03:19:06", "text": "私のモバイルバッテリーは、"}, {"type": "subtitle", "time": 11956.07, "timestamp": "03:19:16", "text": "カメラモードをフルにすると、パーセンテージを固定するだけで、バッテリーを消耗し続けるだけです。 このような通常モードの場合"}, {"type": "subtitle", "time": 11958.15, "timestamp": "03:19:18", "text": "、"}, {"type": "subtitle", "time": 11962.15, "timestamp": "03:19:22", "text": "少なくとも1～2パーセントは充電されます"}, {"type": "subtitle", "time": 11964.229, "timestamp": "03:19:24", "text": "。"}, {"type": "subtitle", "time": 11967.83, "timestamp": "03:19:27", "text": "本当に慌ただしい。 古い携帯電話を"}, {"type": "subtitle", "time": 11977.269, "timestamp": "03:19:37", "text": "ええ、あなたはたくさんのことを見逃しましたね。   道に迷ってしまった"}, {"type": "subtitle", "time": 11980.87, "timestamp": "03:19:40", "text": "。 要点をまとめてみましょう。 ミナ、"}, {"type": "subtitle", "time": 11983.269, "timestamp": "03:19:43", "text": "今日何が起こったのか、私たちはどうするつもり？ わかった。 それで、私は午前"}, {"type": "subtitle", "time": 11986.63, "timestamp": "03:19:46", "text": "6時30分にこの恥ずかしいことを始めて、"}, {"type": "subtitle", "time": 11989.75, "timestamp": "03:19:49", "text": "急いで目的地に着きました。だって"}, {"type": "subtitle", "time": 11991.75, "timestamp": "03:19:51", "text": "今日は最終日の日曜日だったんですよね"}, {"type": "subtitle", "time": 11994.55, "timestamp": "03:19:54", "text": "？ 昨日以降、私はきちんと隅々まで案内しました"}, {"type": "subtitle", "time": 11997.429, "timestamp": "03:19:57", "text": "。 今日はただ"}]
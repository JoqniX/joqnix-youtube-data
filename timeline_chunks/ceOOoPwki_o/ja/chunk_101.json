[{"type": "subtitle", "time": 6063.27, "timestamp": "01:41:03", "text": "待って、何が起こったの？"}, {"type": "subtitle", "time": 6065.75, "timestamp": "01:41:05", "text": "アプリで何もクリックできない。なんてことだ。"}, {"type": "subtitle", "time": 6071.91, "timestamp": "01:41:11", "text": "アプリがクラッシュした。私はまだ生きているの？私が生きていると言って。そして、それは終わった"}, {"type": "subtitle", "time": 6087.27, "timestamp": "01:41:27", "text": "。家に帰りなさい。つまり、"}, {"type": "subtitle", "time": 6101.75, "timestamp": "01:41:41", "text": "私たちは"}, {"type": "subtitle", "time": 6103.51, "timestamp": "01:41:43", "text": "最初にここを通った。"}, {"type": "subtitle", "time": 6105.03, "timestamp": "01:41:45", "text": "そう、"}, {"type": "subtitle", "time": 6107.91, "timestamp": "01:41:47", "text": "私たちは最初にここを通った。"}, {"type": "subtitle", "time": 6111.669, "timestamp": "01:41:51", "text": "だから、そう、ケバブの男"}]
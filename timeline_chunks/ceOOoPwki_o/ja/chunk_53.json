[{"type": "subtitle", "time": 3181.19, "timestamp": "00:53:01", "text": "今回は反対側の隣をまっすぐ右に歩いたんだ。"}, {"type": "subtitle", "time": 3184.63, "timestamp": "00:53:04", "text": "それで、屋台の中には"}, {"type": "subtitle", "time": 3186.79, "timestamp": "00:53:06", "text": "文字通り人が来るのを待っているところもあると思うんだけど、"}, {"type": "subtitle", "time": 3191.03, "timestamp": "00:53:11", "text": "閉店したらどうなるんだろう？"}, {"type": "subtitle", "time": 3194.309, "timestamp": "00:53:14", "text": "食べ物を捨てるのか、それとも"}, {"type": "subtitle", "time": 3199.589, "timestamp": "00:53:19", "text": "無料で配るのか？ 人々に何か？どういうことだろう。"}, {"type": "subtitle", "time": 3206.15, "timestamp": "00:53:26", "text": "もっと多くの人が[音楽]をやっているのが不思議だ"}, {"type": "subtitle", "time": 3207.99, "timestamp": "00:53:27", "text": "。"}, {"type": "subtitle", "time": 3213.109, "timestamp": "00:53:33", "text": "これを撮影したいだけなんだ。"}, {"type": "subtitle", "time": 3216.15, "timestamp": "00:53:36", "text": "撮影したいんだけど[音楽]"}, {"type": "subtitle", "time": 3220.006, "timestamp": "00:53:40", "text": "踊っている人もいるしね。"}, {"type": "subtitle", "time": 3220.63, "timestamp": "00:53:40", "text": "[音楽]踊っている人もいるのは面白い。"}, {"type": "chat", "time": 3233.419, "timestamp": "00:53:53", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "btw joq did you visit the tokyo tower yet ?"}]
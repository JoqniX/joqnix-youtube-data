[{"type": "subtitle", "time": 10026.87, "timestamp": "02:47:06", "text": "えっと、今のところ"}, {"type": "subtitle", "time": 10029.59, "timestamp": "02:47:09", "text": "何がもらえるんですか"}, {"type": "subtitle", "time": 10032.55, "timestamp": "02:47:12", "text": "？ ちょうどコンポンの"}, {"type": "subtitle", "time": 10049.03, "timestamp": "02:47:29", "text": "チップスを買ってもいいかな。 わからない。"}, {"type": "subtitle", "time": 10069.269, "timestamp": "02:47:49", "text": "何を飲めばいいのか、何を食べればいいのか分からなくて、何か"}, {"type": "subtitle", "time": 10072.389, "timestamp": "02:47:52", "text": "軽いものが欲しいんです。"}]
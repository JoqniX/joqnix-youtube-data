[{"type": "subtitle", "time": 840.79, "timestamp": "00:14:00", "text": "もしかしたら、私の"}, {"type": "subtitle", "time": 853.464, "timestamp": "00:14:13", "text": "。 わかった。"}, {"type": "subtitle", "time": 858.629, "timestamp": "00:14:18", "text": "ああ、噂をすれば影が差すものだ。"}, {"type": "subtitle", "time": 861.03, "timestamp": "00:14:21", "text": "先生を文字通り見たんだよ、"}, {"type": "subtitle", "time": 866.31, "timestamp": "00:14:26", "text": "おい、"}, {"type": "subtitle", "time": 874.71, "timestamp": "00:14:34", "text": "。 私は「自分の"}, {"type": "chat", "time": 875.89, "timestamp": "00:14:35", "author": "@yogipacman", "avatar": "https://yt4.ggpht.com/UudmjOedwhHrXlVk1qKsJ8rhBLkG-zcjSumwQOTb_5WDN3-D7v63KbzF9Ywa1_MKUOcOFTv5=s64-c-k-c0x00ffffff-no-rj", "message": "your teacher?"}, {"type": "subtitle", "time": 877.99, "timestamp": "00:14:37", "text": "学校の生徒たちに会える」と思った。 すると"}, {"type": "subtitle", "time": 882.15, "timestamp": "00:14:42", "text": "彼女はすぐに私を見て、「待って、"}, {"type": "subtitle", "time": 885.59, "timestamp": "00:14:45", "text": "先生がここにいるわ」と言った。 先生は、ええ、"}, {"type": "subtitle", "time": 887.99, "timestamp": "00:14:47", "text": "私には何も教えてくれません。 彼女はどちらかというと"}, {"type": "subtitle", "time": 894.389, "timestamp": "00:14:54", "text": "スリランカ出身の生徒をサポートする先生なのですが、私にもとても親切にしてくれて、いろいろと"}, {"type": "subtitle", "time": 897.35, "timestamp": "00:14:57", "text": "助けてくれています。"}, {"type": "subtitle", "time": 898.71, "timestamp": "00:14:58", "text": "そして、彼女は私が今通っている"}]
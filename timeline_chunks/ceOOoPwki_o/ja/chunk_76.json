[{"type": "subtitle", "time": 4561.43, "timestamp": "01:16:01", "text": "そして座る。"}, {"type": "subtitle", "time": 4565.27, "timestamp": "01:16:05", "text": "また来て座るかもしれない。"}, {"type": "subtitle", "time": 4567.43, "timestamp": "01:16:07", "text": "散歩して戻ってくるよ。まだ"}, {"type": "subtitle", "time": 4570.31, "timestamp": "01:16:10", "text": "時間があるから。"}, {"type": "subtitle", "time": 4572.87, "timestamp": "01:16:12", "text": "みんな片付けている。見ての通り、"}, {"type": "subtitle", "time": 4575.189, "timestamp": "01:16:15", "text": "この店、マスターショップがある。彼らは"}, {"type": "subtitle", "time": 4577.189, "timestamp": "01:16:17", "text": "片付けていて、すべてが[音楽]"}, {"type": "subtitle", "time": 4581.11, "timestamp": "01:16:21", "text": "梱包されている。みんな梱包していて"}, {"type": "subtitle", "time": 4593.83, "timestamp": "01:16:33", "text": "私はできない。"}, {"type": "subtitle", "time": 4596.87, "timestamp": "01:16:36", "text": "でも、私はできない。できない。"}, {"type": "subtitle", "time": 4599.51, "timestamp": "01:16:39", "text": "私はできない。すべてが終わっている"}, {"type": "subtitle", "time": 4607.189, "timestamp": "01:16:47", "text": "彼らは竹の物"}, {"type": "subtitle", "time": 4609.35, "timestamp": "01:16:49", "text": "とすべてを片付けているのか？"}, {"type": "chat", "time": 4611.34, "timestamp": "01:16:51", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "joq you can do it"}]
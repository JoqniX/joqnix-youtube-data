[{"type": "subtitle", "time": 5584.87, "timestamp": "01:33:04", "text": "待って、ショーの中はとても暗い。"}, {"type": "subtitle", "time": 5587.75, "timestamp": "01:33:07", "text": "つまり、今夜は"}, {"type": "subtitle", "time": 5598.95, "timestamp": "01:33:18", "text": "フラッシュをオンにするべきかどうか分からない。"}, {"type": "subtitle", "time": 5601.83, "timestamp": "01:33:21", "text": "それはやりすぎだろう。 明るすぎる。"}, {"type": "subtitle", "time": 5606.95, "timestamp": "01:33:26", "text": "フラッシュに頼るべきじゃない。これで十分だよね？教えて"}, {"type": "subtitle", "time": 5609.99, "timestamp": "01:33:29", "text": "。よし、"}, {"type": "subtitle", "time": 5614.31, "timestamp": "01:33:34", "text": "少なくとも見えるし。たぶん、"}, {"type": "subtitle", "time": 5632.07, "timestamp": "01:33:52", "text": "あの辺りまで歩いて行って、"}, {"type": "subtitle", "time": 5635.59, "timestamp": "01:33:55", "text": "ちょっと座って、ちょっと話して、それから来た道を戻ると思う"}]
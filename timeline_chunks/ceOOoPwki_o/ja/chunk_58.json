[{"type": "subtitle", "time": 3488.15, "timestamp": "00:58:08", "text": "今のところ、学校で知っている人にしか会ってない"}, {"type": "subtitle", "time": 3490.87, "timestamp": "00:58:10", "text": "。"}, {"type": "subtitle", "time": 3494.63, "timestamp": "00:58:14", "text": "彼らは私のことを知らないけど、私は"}, {"type": "subtitle", "time": 3497.589, "timestamp": "00:58:17", "text": "人に気付く。いくつかの"}, {"type": "subtitle", "time": 3512.069, "timestamp": "00:58:32", "text": "ああ、そうだね。  7時半。もうすぐ"}, {"type": "subtitle", "time": 3515.43, "timestamp": "00:58:35", "text": "7時半だ。だから、"}, {"type": "subtitle", "time": 3517.03, "timestamp": "00:58:37", "text": "もうすぐ閉まる。"}, {"type": "subtitle", "time": 3523.349, "timestamp": "00:58:43", "text": "午後8時にこの"}, {"type": "subtitle", "time": 3525.67, "timestamp": "00:58:45", "text": "イベントは終了する。だから、すべてのお店が"}, {"type": "subtitle", "time": 3528.549, "timestamp": "00:58:48", "text": "片付けをして、"}, {"type": "subtitle", "time": 3534.39, "timestamp": "00:58:54", "text": "さあ。危うく"}, {"type": "subtitle", "time": 3538.789, "timestamp": "00:58:58", "text": "子供にぶつかりそうになった。"}]
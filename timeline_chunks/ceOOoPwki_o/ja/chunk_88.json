[{"type": "subtitle", "time": 5281.43, "timestamp": "01:28:01", "text": "。"}, {"type": "subtitle", "time": 5283.75, "timestamp": "01:28:03", "text": "でも無理なんです。"}, {"type": "subtitle", "time": 5287.189, "timestamp": "01:28:07", "text": "明日仕事があるから。"}, {"type": "subtitle", "time": 5289.91, "timestamp": "01:28:09", "text": "家に帰ったら、"}, {"type": "subtitle", "time": 5292.31, "timestamp": "01:28:12", "text": "オンラインの授業、リコーダーの授業に追いつかないといけないし、それから、えーと、それから、えーと、それも"}, {"type": "subtitle", "time": 5306.07, "timestamp": "01:28:26", "text": "問題なんです。"}, {"type": "subtitle", "time": 5319.99, "timestamp": "01:28:39", "text": "[音楽]"}, {"type": "subtitle", "time": 5322.07, "timestamp": "01:28:42", "text": "友達や親友とここに来るといいですよ"}, {"type": "subtitle", "time": 5324.95, "timestamp": "01:28:44", "text": "。"}, {"type": "subtitle", "time": 5330.87, "timestamp": "01:28:50", "text": "一緒に遊んだり、話したり、美味しいものを食べたり。この人たちを見てください。"}, {"type": "subtitle", "time": 5332.629, "timestamp": "01:28:52", "text": "彼らみたいに。"}, {"type": "subtitle", "time": 5335.27, "timestamp": "01:28:55", "text": "友達とここに来て話したり"}]
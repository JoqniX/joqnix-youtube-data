[{"type": "subtitle", "time": 7201.91, "timestamp": "02:00:01", "text": "ああ、大変だ。 私はこれらの"}, {"type": "subtitle", "time": 7206.229, "timestamp": "02:00:06", "text": "配信ではこんな感じになります。 私は文字通りこんな感じになるでしょう。   たぶん"}, {"type": "subtitle", "time": 7208.229, "timestamp": "02:00:08", "text": "角あたりにいると思う"}, {"type": "subtitle", "time": 7211.03, "timestamp": "02:00:11", "text": "。"}, {"type": "subtitle", "time": 7217.83, "timestamp": "02:00:17", "text": "H 私にやらせてください。 私はこうなるでしょう。   何てことだ"}, {"type": "subtitle", "time": 7221.669, "timestamp": "02:00:21", "text": "。 待ちきれない。"}, {"type": "subtitle", "time": 7223.413, "timestamp": "02:00:23", "text": "うん。 さよなら。"}, {"type": "subtitle", "time": 7225.35, "timestamp": "02:00:25", "text": "[笑い]"}, {"type": "subtitle", "time": 7227.99, "timestamp": "02:00:27", "text": "シガーだよ、"}, {"type": "subtitle", "time": 7230.39, "timestamp": "02:00:30", "text": "おい。 とても素敵になるでしょう。 とても"}, {"type": "subtitle", "time": 7231.99, "timestamp": "02:00:31", "text": "幸せです。"}, {"type": "subtitle", "time": 7234.229, "timestamp": "02:00:34", "text": "私はとても幸せです。   こうなるよ"}, {"type": "subtitle", "time": 7236.709, "timestamp": "02:00:36", "text": "。"}, {"type": "subtitle", "time": 7238.39, "timestamp": "02:00:38", "text": "彼らはこんな風に私の目を見つめるだろう"}, {"type": "subtitle", "time": 7248.31, "timestamp": "02:00:48", "text": "つまり、"}, {"type": "subtitle", "time": 7250.95, "timestamp": "02:00:50", "text": "全画面表示にすると、こうなります"}, {"type": "subtitle", "time": 7253.589, "timestamp": "02:00:53", "text": "。 はい、"}, {"type": "subtitle", "time": 7256.55, "timestamp": "02:00:56", "text": "移動機能はありません。 では、実際に"}, {"type": "subtitle", "time": 7259.35, "timestamp": "02:00:59", "text": "その写真を探して載せますね。 つまり、こうなるということです"}]
[{"type": "subtitle", "time": 12780.71, "timestamp": "03:33:00", "text": "仕事に持っていくかもしれない。もしそれがまだ"}, {"type": "subtitle", "time": 12790.79, "timestamp": "03:33:10", "text": "あなたは毎日料理をするのですか？"}, {"type": "subtitle", "time": 12794.229, "timestamp": "03:33:14", "text": "いいえ。ええ、私たちはよく料理をします。"}, {"type": "subtitle", "time": 12798.15, "timestamp": "03:33:18", "text": "だから我が家のガス代が高いのです。"}, {"type": "subtitle", "time": 12800.71, "timestamp": "03:33:20", "text": "自炊の方が安上がりだ。 えっと、予算に"}, {"type": "subtitle", "time": 12803.11, "timestamp": "03:33:23", "text": "優しいってことですよね？ ある意味では。"}, {"type": "subtitle", "time": 12805.51, "timestamp": "03:33:25", "text": "むしろ、私はここで物を買っているんです。 値段が"}, {"type": "subtitle", "time": 12810.79, "timestamp": "03:33:30", "text": "何か共有した方がいいでしょうか？ ええ、どうぞ"}, {"type": "subtitle", "time": 12814.229, "timestamp": "03:33:34", "text": "。 でも、もうすぐ10時になるから、そろそろ"}, {"type": "subtitle", "time": 12816.309, "timestamp": "03:33:36", "text": "締めくくらなくちゃ。"}, {"type": "subtitle", "time": 12818.79, "timestamp": "03:33:38", "text": "時間不足とタンパク質の摂取不足。 私は"}, {"type": "subtitle", "time": 12820.469, "timestamp": "03:33:40", "text": "朝から生卵を飲み始めました。   それで"}, {"type": "subtitle", "time": 12822.63, "timestamp": "03:33:42", "text": "十分です。"}, {"type": "subtitle", "time": 12826.07, "timestamp": "03:33:46", "text": "そうそう。 日本では生卵は実は"}, {"type": "subtitle", "time": 12829.19, "timestamp": "03:33:49", "text": "美味しいんです。 理由がわからない。 でも、"}, {"type": "subtitle", "time": 12831.75, "timestamp": "03:33:51", "text": "アメリカ産とかの生卵を"}, {"type": "subtitle", "time": 12833.51, "timestamp": "03:33:53", "text": "ご飯とかに入れて食べても、"}, {"type": "subtitle", "time": 12836.469, "timestamp": "03:33:56", "text": "美味しくないよ。"}, {"type": "subtitle", "time": 12839.429, "timestamp": "03:33:59", "text": "私の日本人の友人、YouTuberの"}]
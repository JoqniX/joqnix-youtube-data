[{"type": "subtitle", "time": 3603.19, "timestamp": "01:00:03", "text": "マヨネーズとケチャップを作って、それから何？えっと、"}, {"type": "subtitle", "time": 3610.39, "timestamp": "01:00:10", "text": "この物も食べたよ。なんて"}, {"type": "subtitle", "time": 3617.43, "timestamp": "01:00:17", "text": "言うんだっけ？えっと、何？"}, {"type": "subtitle", "time": 3620.789, "timestamp": "01:00:20", "text": "そう。キャベツとか"}, {"type": "subtitle", "time": 3624.23, "timestamp": "01:00:24", "text": "全部入ったサンドイッチ。それからパン、"}, {"type": "subtitle", "time": 3627.67, "timestamp": "01:00:27", "text": "クリームパン、ストロベリークリームパンを買ったんだ。"}, {"type": "subtitle", "time": 3630.069, "timestamp": "01:00:30", "text": "今日買い物に行ったから。それで"}, {"type": "subtitle", "time": 3633.27, "timestamp": "01:00:33", "text": "、どうして1回だけかって？だって、お金がないから"}, {"type": "subtitle", "time": 3635.27, "timestamp": "01:00:35", "text": "。"}, {"type": "subtitle", "time": 3638.069, "timestamp": "01:00:38", "text": "日本は高いんだ。"}, {"type": "subtitle", "time": 3640.71, "timestamp": "01:00:40", "text": "高い。"}, {"type": "subtitle", "time": 3648.39, "timestamp": "01:00:48", "text": "インドみたいに1日3食は食べられない。"}, {"type": "subtitle", "time": 3654.789, "timestamp": "01:00:54", "text": "今日の出費は、今日"}]
[{"type": "subtitle", "time": 2505.589, "timestamp": "00:41:45", "text": "また道に迷った。"}, {"type": "subtitle", "time": 2512.79, "timestamp": "00:41:52", "text": "シェフに反応したと言ったら、"}, {"type": "subtitle", "time": 2515.349, "timestamp": "00:41:55", "text": "誰かがそれに気づいて"}, {"type": "subtitle", "time": 2517.67, "timestamp": "00:41:57", "text": "友達に「あぁ、"}, {"type": "subtitle", "time": 2519.51, "timestamp": "00:41:59", "text": "この人がストリーミング配信してるよ」って言ったから、私は「あぁ、いやだ"}]
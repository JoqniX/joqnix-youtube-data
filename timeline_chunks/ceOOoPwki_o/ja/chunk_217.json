[{"type": "subtitle", "time": 13022.309, "timestamp": "03:37:02", "text": "ここは小さな公園みたいな感じですね。"}, {"type": "subtitle", "time": 13025.03, "timestamp": "03:37:05", "text": "私は時々ここに来ます。 それでおしまい。 あれは"}, {"type": "subtitle", "time": 13029.75, "timestamp": "03:37:09", "text": "私の傘で、あのベンチに置いてあります。"}, {"type": "subtitle", "time": 13032.02, "timestamp": "03:37:12", "text": "私のシルエット。"}, {"type": "subtitle", "time": 13033.99, "timestamp": "03:37:13", "text": "[笑い]"}, {"type": "subtitle", "time": 13036.07, "timestamp": "03:37:16", "text": "シルエットの話が出たので、ちょっと待ってください、もうすぐ終わりなので"}, {"type": "subtitle", "time": 13038.63, "timestamp": "03:37:18", "text": "画面を切り替えます"}, {"type": "subtitle", "time": 13042.229, "timestamp": "03:37:22", "text": "。 ええ、"}, {"type": "subtitle", "time": 13046.55, "timestamp": "03:37:26", "text": "土曜日の午後8時です。  GSTは"}, {"type": "subtitle", "time": 13049.75, "timestamp": "03:37:29", "text": "インドの基準で、午後4時です。 えーと、午後4時"}, {"type": "subtitle", "time": 13055.349, "timestamp": "03:37:35", "text": "インド標準時（IST）。 私のデビュー作、"}, {"type": "subtitle", "time": 13058.07, "timestamp": "03:37:38", "text": "Joaxの新作、公式モデルが"}, {"type": "subtitle", "time": 13061.67, "timestamp": "03:37:41", "text": "土曜日にデビューします。"}, {"type": "subtitle", "time": 13063.75, "timestamp": "03:37:43", "text": "あ、待って。 そうそう。 えっと、午後8時 ただの"}, {"type": "subtitle", "time": 13066.469, "timestamp": "03:37:46", "text": "GFCです。 それは約2時間"}, {"type": "subtitle", "time": 13069.269, "timestamp": "03:37:49", "text": "前のことです。 時刻は10時33分です。   ええ、そうですね、あれは"}, {"type": "subtitle", "time": 13072.229, "timestamp": "03:37:52", "text": "オシア兄弟です。 それが"}, {"type": "subtitle", "time": 13076.389, "timestamp": "03:37:56", "text": "発表内容です。 ぜひお立ち寄りください。"}]
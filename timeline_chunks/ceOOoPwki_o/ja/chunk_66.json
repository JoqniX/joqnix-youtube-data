[{"type": "subtitle", "time": 3967.109, "timestamp": "01:06:07", "text": "内向的なので、そこに座っているカップルをよく見かけますが、そこにはいません。だから、"}, {"type": "subtitle", "time": 3970.549, "timestamp": "01:06:10", "text": "私は話すのがとても難しいです。"}, {"type": "subtitle", "time": 3972.23, "timestamp": "01:06:12", "text": "だから、"}, {"type": "subtitle", "time": 3976.23, "timestamp": "01:06:16", "text": "私は話すのがとても難しいです。"}, {"type": "subtitle", "time": 3981.75, "timestamp": "01:06:21", "text": "今日でも、私はノーマックを持っていません。まだ持っていません"}, {"type": "subtitle", "time": 3987.75, "timestamp": "01:06:27", "text": "。でも、今年の私の最終目標は、"}, {"type": "subtitle", "time": 3989.829, "timestamp": "01:06:29", "text": "少なくとも1人の友達を作ることです"}, {"type": "subtitle", "time": 3992.15, "timestamp": "01:06:32", "text": "。"}, {"type": "subtitle", "time": 3994.549, "timestamp": "01:06:34", "text": "つまり、"}, {"type": "subtitle", "time": 3997.829, "timestamp": "01:06:37", "text": "日本のユーチューバーは除いて、"}, {"type": "subtitle", "time": 4001.67, "timestamp": "01:06:41", "text": "私は、私が"}, {"type": "subtitle", "time": 4014.63, "timestamp": "01:06:54", "text": "いる場所の地元の日本人と友達になったことはありません。それで、"}, {"type": "subtitle", "time": 4017.91, "timestamp": "01:06:57", "text": "またここに戻ってきました。"}]
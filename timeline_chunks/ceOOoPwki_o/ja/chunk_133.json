[{"type": "subtitle", "time": 7983.83, "timestamp": "02:13:03", "text": "。 私はまさに"}, {"type": "subtitle", "time": 7988.069, "timestamp": "02:13:08", "text": "ナイトクラブエリアにいます。"}, {"type": "subtitle", "time": 7991.27, "timestamp": "02:13:11", "text": "地図を載せる必要があると思う。 何てことだ。"}, {"type": "subtitle", "time": 8023.35, "timestamp": "02:13:43", "text": "ココ関連の"}, {"type": "subtitle", "time": 8025.91, "timestamp": "02:13:45", "text": "話です。"}, {"type": "subtitle", "time": 8028.39, "timestamp": "02:13:48", "text": "私はここを通らなければならない。 私はまだ"}, {"type": "subtitle", "time": 8031.189, "timestamp": "02:13:51", "text": "生きているのか？ ちなみに、全部タブでまとめました"}, {"type": "subtitle", "time": 8032.95, "timestamp": "02:13:52", "text": "。   ああ"}, {"type": "subtitle", "time": 8034.629, "timestamp": "02:13:54", "text": "、まだ生きてるよ。 よしよし"}]
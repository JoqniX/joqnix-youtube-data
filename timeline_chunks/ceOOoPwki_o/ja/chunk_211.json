[{"type": "subtitle", "time": 12660.229, "timestamp": "03:31:00", "text": "家に帰ると何もすることがないということです"}, {"type": "subtitle", "time": 12662.55, "timestamp": "03:31:02", "text": "。 私にとっては毎日が"}, {"type": "subtitle", "time": 12664.309, "timestamp": "03:31:04", "text": "休暇みたいなものだ。 だから、"}, {"type": "subtitle", "time": 12667.429, "timestamp": "03:31:07", "text": "一日中寝ていたり、一日中ゲームをしていたり​​、"}, {"type": "subtitle", "time": 12669.349, "timestamp": "03:31:09", "text": "24時間ずっと配信をしていたり​​、何でもいいんです"}, {"type": "subtitle", "time": 12670.95, "timestamp": "03:31:10", "text": "。"}, {"type": "subtitle", "time": 12676.229, "timestamp": "03:31:16", "text": "そういうライフスタイルですよね？"}, {"type": "subtitle", "time": 12678.389, "timestamp": "03:31:18", "text": "でも今考えてみると、今の私は以前よりも"}, {"type": "subtitle", "time": 12681.349, "timestamp": "03:31:21", "text": "責任感が強い。"}, {"type": "subtitle", "time": 12684.55, "timestamp": "03:31:24", "text": "時間が足りない。 私にはほとんど何も"}, {"type": "subtitle", "time": 12693.03, "timestamp": "03:31:33", "text": "あなたは自分で料理をしますか？ えっと、今は"}, {"type": "subtitle", "time": 12695.75, "timestamp": "03:31:35", "text": "少し料理をしますが、"}, {"type": "subtitle", "time": 12699.51, "timestamp": "03:31:39", "text": "ルームメイトがほとんどの場合料理をします"}, {"type": "subtitle", "time": 12702.389, "timestamp": "03:31:42", "text": "。 私は自分で麺類を調理する方法を知っているし"}, {"type": "subtitle", "time": 12705.59, "timestamp": "03:31:45", "text": "、他のもの、"}, {"type": "subtitle", "time": 12710.79, "timestamp": "03:31:50", "text": "ビリヤニのような大きな食事など、少量のものは"}, {"type": "subtitle", "time": 12713.349, "timestamp": "03:31:53", "text": "彼が調理する。"}, {"type": "subtitle", "time": 12717.429, "timestamp": "03:31:57", "text": "彼は私より料理が上手だ。"}, {"type": "subtitle", "time": 12719.349, "timestamp": "03:31:59", "text": "では、朝食と夕食はどうでしょうか？ 私は1"}]
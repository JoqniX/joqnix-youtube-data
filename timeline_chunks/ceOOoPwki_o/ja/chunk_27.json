[{"type": "subtitle", "time": 1623.83, "timestamp": "00:27:03", "text": "敵が多すぎる。これは敵ではないと思う。たくさんの"}, {"type": "subtitle", "time": 1626.39, "timestamp": "00:27:06", "text": "人種が見える。"}, {"type": "subtitle", "time": 1631.029, "timestamp": "00:27:11", "text": "[笑い] こんなにたくさんいる。"}, {"type": "subtitle", "time": 1636.63, "timestamp": "00:27:16", "text": "[叫び声] あれは"}, {"type": "subtitle", "time": 1641.19, "timestamp": "00:27:21", "text": "ミッキーマウス？あれは全部？"}, {"type": "subtitle", "time": 1644.149, "timestamp": "00:27:24", "text": "待って、違う、人形のやつ。 ブードゥー"}, {"type": "subtitle", "time": 1652.39, "timestamp": "00:27:32", "text": "おお。"}]
[{"type": "subtitle", "time": 12121.67, "timestamp": "03:22:01", "text": "彼らは私の名前を知っているので、マイクをミュートにしました"}, {"type": "subtitle", "time": 12125.59, "timestamp": "03:22:05", "text": "。 えっと、マイクをミュートにしました。 彼らは"}, {"type": "subtitle", "time": 12129.349, "timestamp": "03:22:09", "text": "私が配信をしていることを今知った。"}, {"type": "subtitle", "time": 12133.19, "timestamp": "03:22:13", "text": "学校の先生数人に会った。"}, {"type": "subtitle", "time": 12136.07, "timestamp": "03:22:16", "text": "彼らに挨拶した。   では、"}, {"type": "subtitle", "time": 12139.03, "timestamp": "03:22:19", "text": "その後はどうなるのか？ うん。"}, {"type": "subtitle", "time": 12141.51, "timestamp": "03:22:21", "text": "昨日も今日も、見知らぬ人などと話す機会をたくさん逃してしまった"}, {"type": "subtitle", "time": 12146.95, "timestamp": "03:22:26", "text": "。 彼らは"}, {"type": "subtitle", "time": 12149.11, "timestamp": "03:22:29", "text": "「あ、この人ストリーミング配信してる」って感じなんです。"}, {"type": "subtitle", "time": 12151.349, "timestamp": "03:22:31", "text": "彼らがオンラインになっていて、Twitchの"}, {"type": "subtitle", "time": 12153.269, "timestamp": "03:22:33", "text": "アイコンやYouTubeのアイコン、Kickerの"}, {"type": "subtitle", "time": 12156.15, "timestamp": "03:22:36", "text": "アイコンに気づいて、それらのプラットフォームを認識して、"}, {"type": "subtitle", "time": 12158.15, "timestamp": "03:22:38", "text": "「ああ、彼は"}, {"type": "subtitle", "time": 12161.11, "timestamp": "03:22:41", "text": "複数のプラットフォームで配信しているんだな」と思うのかもしれません。"}, {"type": "subtitle", "time": 12163.51, "timestamp": "03:22:43", "text": "彼らは英語がわからないんです。だって、ずっと"}, {"type": "subtitle", "time": 12166.79, "timestamp": "03:22:46", "text": "英語で話していたから。 彼らは"}, {"type": "subtitle", "time": 12169.19, "timestamp": "03:22:49", "text": "私に何か言いたかったようだ。 私は過去を振り返りたかった"}, {"type": "subtitle", "time": 12172.389, "timestamp": "03:22:52", "text": "。 私はとても内気だった。"}]
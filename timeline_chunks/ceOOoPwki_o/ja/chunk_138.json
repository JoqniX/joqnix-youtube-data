[{"type": "subtitle", "time": 8292.15, "timestamp": "02:18:12", "text": "ミッキー。"}, {"type": "subtitle", "time": 8295.83, "timestamp": "02:18:15", "text": "これは正しいやり方ではない。"}, {"type": "subtitle", "time": 8298.95, "timestamp": "02:18:18", "text": "私は路地裏にいます。"}, {"type": "subtitle", "time": 8301.669, "timestamp": "02:18:21", "text": "これは一体何という恐怖なのか？ 何？ まるで"}, {"type": "subtitle", "time": 8310.709, "timestamp": "02:18:30", "text": "ホニに行くべきか、それともメイトに行くべきか？ わからない"}, {"type": "subtitle", "time": 8313.03, "timestamp": "02:18:33", "text": "。"}, {"type": "subtitle", "time": 8318.549, "timestamp": "02:18:38", "text": "ああ、くそ。 ここはどこ？"}, {"type": "subtitle", "time": 8321.03, "timestamp": "02:18:41", "text": "待って、"}, {"type": "subtitle", "time": 8323.19, "timestamp": "02:18:43", "text": "ここに屋台がいくつかあるよ。 これがその"}, {"type": "subtitle", "time": 8334.87, "timestamp": "02:18:54", "text": "いいえ、私は上へ行きます。 それは違う。   私は"}, {"type": "subtitle", "time": 8339.11, "timestamp": "02:18:59", "text": "こちらの道を行かなければなりません。"}]
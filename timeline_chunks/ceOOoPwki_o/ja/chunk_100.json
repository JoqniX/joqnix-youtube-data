[{"type": "subtitle", "time": 6009.669, "timestamp": "01:40:09", "text": "でも、どこに行ってもカップルばかりだ。"}, {"type": "subtitle", "time": 6013.99, "timestamp": "01:40:13", "text": "実際、私の住んでいる場所では、"}, {"type": "subtitle", "time": 6016.629, "timestamp": "01:40:16", "text": "たくさんの"}, {"type": "subtitle", "time": 6020.39, "timestamp": "01:40:20", "text": "人がいるはずだと思っていた。だから、うん。"}, {"type": "subtitle", "time": 6023.75, "timestamp": "01:40:23", "text": "ああ、8時だから"}, {"type": "subtitle", "time": 6029.83, "timestamp": "01:40:29", "text": "でも、私の顔とかは見なかったよ"}, {"type": "subtitle", "time": 6032.709, "timestamp": "01:40:32", "text": "ね？私は自分の しばらく見ています"}, {"type": "subtitle", "time": 6046.39, "timestamp": "01:40:46", "text": "彼らがブロックしているので、戻れないような気がします。"}, {"type": "subtitle", "time": 6048.79, "timestamp": "01:40:48", "text": "みんな「ああ、家に帰れ」という感じです。  「"}, {"type": "subtitle", "time": 6051.43, "timestamp": "01:40:51", "text": "家に帰りなさい。」わかった"}, {"type": "subtitle", "time": 6053.189, "timestamp": "01:40:53", "text": "。"}, {"type": "subtitle", "time": 6054.709, "timestamp": "01:40:54", "text": "それはまるで"}]
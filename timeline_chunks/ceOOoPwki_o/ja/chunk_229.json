[{"type": "subtitle", "time": 13761.75, "timestamp": "03:49:21", "text": "何かがあなたを悩ませている。 ああ、そんなこと言わないで。   やめてください。"}, {"type": "subtitle", "time": 13764.79, "timestamp": "03:49:24", "text": "私はホラー映画が苦手です。 そんなこと言わないで"}, {"type": "subtitle", "time": 13767.03, "timestamp": "03:49:27", "text": "。"}, {"type": "subtitle", "time": 13769.99, "timestamp": "03:49:29", "text": "不良少年。"}, {"type": "subtitle", "time": 13773.11, "timestamp": "03:49:33", "text": "君は悪い人だ。 そんなこと言わないで。 私は"}, {"type": "subtitle", "time": 13776.55, "timestamp": "03:49:36", "text": "ホラーが怖いんです。 私はホラーに耐えられない"}, {"type": "subtitle", "time": 13787.83, "timestamp": "03:49:47", "text": "。"}, {"type": "subtitle", "time": 13792.229, "timestamp": "03:49:52", "text": "ああ、私のシルエットが見えるでしょう。 こんにちは。"}, {"type": "subtitle", "time": 13799.269, "timestamp": "03:49:59", "text": "、失礼します"}]
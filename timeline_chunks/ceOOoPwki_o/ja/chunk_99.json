[{"type": "subtitle", "time": 5965.59, "timestamp": "01:39:25", "text": "エイジャーや"}, {"type": "subtitle", "time": 5968.79, "timestamp": "01:39:28", "text": "カップルがいっぱいいる。"}, {"type": "subtitle", "time": 5975.75, "timestamp": "01:39:35", "text": "みんな外に出るように強制されたんだ。うん、"}, {"type": "subtitle", "time": 5985.35, "timestamp": "01:39:45", "text": "ああ、なんてことだ。それで[音楽]"}, {"type": "subtitle", "time": 5992.31, "timestamp": "01:39:52", "text": "つまり、私が"}, {"type": "subtitle", "time": 5998.87, "timestamp": "01:39:58", "text": "する通り。うん。この道だと思う。"}]
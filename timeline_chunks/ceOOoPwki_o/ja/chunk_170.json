[{"type": "subtitle", "time": 10202.87, "timestamp": "02:50:02", "text": "ロサンゼルス。   では、"}, {"type": "subtitle", "time": 10205.51, "timestamp": "02:50:05", "text": "何を買えばいいのでしょうか？"}, {"type": "subtitle", "time": 10209.429, "timestamp": "02:50:09", "text": "よし、じゃあこの音楽で行こう。 ジュース缶"}, {"type": "subtitle", "time": 10211.83, "timestamp": "02:50:11", "text": "。 よし、これでいこう。"}, {"type": "subtitle", "time": 10239.269, "timestamp": "02:50:39", "text": "問題は、これを"}, {"type": "subtitle", "time": 10242.55, "timestamp": "02:50:42", "text": "配信中に食べなきゃいけないってことだよね？ なあ、"}, {"type": "subtitle", "time": 10246.15, "timestamp": "02:50:46", "text": "それが（音楽の）一番面白いところだよ。"}]
[{"type": "subtitle", "time": 12542.79, "timestamp": "03:29:02", "text": "だから私は自問自答した。まるで"}, {"type": "subtitle", "time": 12545.99, "timestamp": "03:29:05", "text": "1年、1年、1"}, {"type": "subtitle", "time": 12552.07, "timestamp": "03:29:12", "text": "年とか、"}, {"type": "subtitle", "time": 12555.19, "timestamp": "03:29:15", "text": "1年7ヶ月、6ヶ月、4ヶ月とかを無駄にしたような気がしないか。それに、家に帰ってきても、"}, {"type": "subtitle", "time": 12560.469, "timestamp": "03:29:20", "text": "私は"}, {"type": "subtitle", "time": 12563.99, "timestamp": "03:29:23", "text": "家を離れている。それは本当に辛い。だからそれは"}, {"type": "subtitle", "time": 12571.51, "timestamp": "03:29:31", "text": "待って。"}, {"type": "subtitle", "time": 12576.229, "timestamp": "03:29:36", "text": "今日になっても、自分が日本にいるという実感がまだ湧かない。 たとえ私が今すぐ祭りに行ったとしても"}, {"type": "subtitle", "time": 12578.95, "timestamp": "03:29:38", "text": "。 つまり、参加者の半分は"}, {"type": "subtitle", "time": 12582.71, "timestamp": "03:29:42", "text": "日本人だったということだ。 たくさんの"}, {"type": "subtitle", "time": 12594.229, "timestamp": "03:29:54", "text": "ステーキみたいなものを売っていました。 たくさんの"}, {"type": "subtitle", "time": 12598.71, "timestamp": "03:29:58", "text": "食べ物やイベントなどがあり、"}]
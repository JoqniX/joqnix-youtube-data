[{"type": "subtitle", "time": 13863.83, "timestamp": "03:51:03", "text": "今週の日曜日に再びアストロ・ジェネシスが開催されるということです。 つまり、今週の"}, {"type": "subtitle", "time": 13867.67, "timestamp": "03:51:07", "text": "土曜日、すみません、午後8時です。  GSTは午後"}, {"type": "subtitle", "time": 13871.83, "timestamp": "03:51:11", "text": "4時です。  IST。 お時間があればぜひお立ち寄りください"}, {"type": "subtitle", "time": 13875.429, "timestamp": "03:51:15", "text": "。 それは"}, {"type": "subtitle", "time": 13878.63, "timestamp": "03:51:18", "text": "小さなイベントになる予定で、大きなイベントではありません。 これから紹介用の"}, {"type": "subtitle", "time": 13883.429, "timestamp": "03:51:23", "text": "スライドなどを準備します。"}, {"type": "subtitle", "time": 13887.189, "timestamp": "03:51:27", "text": "モデルとその他すべてを披露してください。 ええと、全部です"}, {"type": "subtitle", "time": 13889.51, "timestamp": "03:51:29", "text": "。 うん。"}, {"type": "subtitle", "time": 13894.15, "timestamp": "03:51:34", "text": "衝撃やその他諸々の進化の全貌を紹介する。"}, {"type": "subtitle", "time": 13897.429, "timestamp": "03:51:37", "text": "うん。 私はその家の窓が見えた。"}, {"type": "subtitle", "time": 13899.51, "timestamp": "03:51:39", "text": "その窓は開いていた。 彼らは"}, {"type": "subtitle", "time": 13902.55, "timestamp": "03:51:42", "text": "映画を見ていた。 一体どういうことだ？   わかった"}, {"type": "subtitle", "time": 13905.91, "timestamp": "03:51:45", "text": "。 こんにちは。 とにかく、来てくださった"}, {"type": "subtitle", "time": 13909.75, "timestamp": "03:51:49", "text": "皆さん、ありがとうございました。   これで終わりにします"}, {"type": "subtitle", "time": 13914.55, "timestamp": "03:51:54", "text": "。 それでは、"}, {"type": "subtitle", "time": 13919.67, "timestamp": "03:51:59", "text": "本日はありがとうございました。"}]
[{"type": "subtitle", "time": 5348.79, "timestamp": "01:29:08", "text": "次は 年。絶対にやるよ。"}, {"type": "subtitle", "time": 5351.59, "timestamp": "01:29:11", "text": "飲み物が君を呼んでいるのがわかる。"}, {"type": "subtitle", "time": 5359.75, "timestamp": "01:29:19", "text": "飲んで。ミスター・マティーニは"}, {"type": "subtitle", "time": 5364.39, "timestamp": "01:29:24", "text": "「さあ、飲んで」って感じ。  「私を飲んでほしい」"}, {"type": "subtitle", "time": 5369.11, "timestamp": "01:29:29", "text": "うん、でも"}, {"type": "subtitle", "time": 5372.07, "timestamp": "01:29:32", "text": "手が痛い。"}, {"type": "subtitle", "time": 5393.99, "timestamp": "01:29:53", "text": "無料で物をくれるんだ。100"}, {"type": "subtitle", "time": 5397.59, "timestamp": "01:29:57", "text": "円とかじゃなくてね。一番"}, {"type": "subtitle", "time": 5399.75, "timestamp": "01:29:59", "text": "面白くて悲しいのは、"}]
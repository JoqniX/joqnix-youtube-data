[{"type": "subtitle", "time": 12962.63, "timestamp": "03:36:02", "text": "もっと。 待ってください、何かお見せできるものはありますか"}, {"type": "subtitle", "time": 12964.71, "timestamp": "03:36:04", "text": "？"}, {"type": "subtitle", "time": 12968.389, "timestamp": "03:36:08", "text": "空には星がない。"}, {"type": "subtitle", "time": 12972.389, "timestamp": "03:36:12", "text": "ここはどこ？ 星はどこにあるの？"}, {"type": "subtitle", "time": 12975.91, "timestamp": "03:36:15", "text": "私のムクドリたちよ、君たちはどこにいるの？ せめて"}, {"type": "subtitle", "time": 12978.63, "timestamp": "03:36:18", "text": "星空くらいは見せてあげられたのに、ああ"}, {"type": "subtitle", "time": 12983.19, "timestamp": "03:36:23", "text": "、曇り空なんだ。"}, {"type": "subtitle", "time": 12993.19, "timestamp": "03:36:33", "text": "なぜ私が？   探しているところです"}, {"type": "subtitle", "time": 12997.03, "timestamp": "03:36:37", "text": "。 ああ、"}, {"type": "subtitle", "time": 12999.51, "timestamp": "03:36:39", "text": "曇っている。"}, {"type": "subtitle", "time": 13002.309, "timestamp": "03:36:42", "text": "曇りです。"}, {"type": "subtitle", "time": 13012.309, "timestamp": "03:36:52", "text": "曇り空だ"}]
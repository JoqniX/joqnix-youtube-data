[{"type": "subtitle", "time": 2774.39, "timestamp": "00:46:14", "text": "よし、まっすぐ行ってから"}, {"type": "subtitle", "time": 2777.19, "timestamp": "00:46:17", "text": "左か右に行こう。"}, {"type": "subtitle", "time": 2778.47, "timestamp": "00:46:18", "text": "うん、"}, {"type": "subtitle", "time": 2780.79, "timestamp": "00:46:20", "text": "今日は人でいっぱいだろう。だから、"}, {"type": "subtitle", "time": 2785.99, "timestamp": "00:46:25", "text": "ストリーム全体が私が歩いて歩いて歩いて歩いて"}, {"type": "subtitle", "time": 2793.43, "timestamp": "00:46:33", "text": "ストリームの半分は、私が物を買ったり、このイベントに参加したりするようなことでは"}, {"type": "subtitle", "time": 2796.87, "timestamp": "00:46:36", "text": "なく、人々に見せるような感じになると思う"}, {"type": "subtitle", "time": 2805.03, "timestamp": "00:46:45", "text": "。"}]
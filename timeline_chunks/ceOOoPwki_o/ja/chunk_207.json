[{"type": "subtitle", "time": 12422.71, "timestamp": "03:27:02", "text": "録画された授業、そして"}, {"type": "subtitle", "time": 12426.55, "timestamp": "03:27:06", "text": "少しだけ自分の好きなことをする自由時間"}, {"type": "subtitle", "time": 12430.309, "timestamp": "03:27:10", "text": "。 たぶん、配信とか色々やって、"}, {"type": "subtitle", "time": 12435.67, "timestamp": "03:27:15", "text": "それからご飯食べて寝るかな。   そうなんです、"}, {"type": "subtitle", "time": 12441.269, "timestamp": "03:27:21", "text": "それが問題なんです。"}, {"type": "subtitle", "time": 12445.59, "timestamp": "03:27:25", "text": "パートタイムの仕事とかで、"}, {"type": "subtitle", "time": 12450.95, "timestamp": "03:27:30", "text": "朝のジョギングには行けないんですけど、もし"}, {"type": "subtitle", "time": 12455.03, "timestamp": "03:27:35", "text": "起きられたら、つまり日本では日の出が本当に"}, {"type": "subtitle", "time": 12457.59, "timestamp": "03:27:37", "text": "早いので、"}, {"type": "subtitle", "time": 12459.91, "timestamp": "03:27:39", "text": "4時に起きて"}, {"type": "subtitle", "time": 12464.15, "timestamp": "03:27:44", "text": "5時にウォーキングかジョギングに行って、"}, {"type": "subtitle", "time": 12469.03, "timestamp": "03:27:49", "text": "家に帰ってきて、さっとお風呂に入って、準備して、出かけられるんです"}, {"type": "subtitle", "time": 12475.51, "timestamp": "03:27:55", "text": "うん。"}, {"type": "subtitle", "time": 12478.539, "timestamp": "03:27:58", "text": "ありがたいことに、私はパートタイムの仕事は必要ありません。"}]
[{"type": "subtitle", "time": 5883.91, "timestamp": "01:38:03", "text": "時々、私は思う。"}, {"type": "subtitle", "time": 5893.03, "timestamp": "01:38:13", "text": "警察官は、"}, {"type": "subtitle", "time": 5915.189, "timestamp": "01:38:35", "text": "だから、もし私が そうだ、ずっと"}, {"type": "subtitle", "time": 5918.709, "timestamp": "01:38:38", "text": "後ろの方に行けばいいんだ。ずっと後ろの方に行けばいいんだ"}, {"type": "subtitle", "time": 5927.51, "timestamp": "01:38:47", "text": "後ろの方に。"}, {"type": "subtitle", "time": 5930.79, "timestamp": "01:38:50", "text": "そして道を渡って戻ってくる。"}, {"type": "subtitle", "time": 5933.109, "timestamp": "01:38:53", "text": "戻るときは、この道は通らないよ"}, {"type": "subtitle", "time": 5939.59, "timestamp": "01:38:59", "text": "。また混雑するだろうから。たぶん"}]
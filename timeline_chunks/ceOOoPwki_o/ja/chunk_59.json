[{"type": "subtitle", "time": 3540.47, "timestamp": "00:59:00", "text": "さあ。"}, {"type": "subtitle", "time": 3542.63, "timestamp": "00:59:02", "text": "このエリアには行ってないよね？だから、"}, {"type": "subtitle", "time": 3552.87, "timestamp": "00:59:12", "text": "ああ、なんてことだ。ああ、なんてことだ。怖かった。"}, {"type": "subtitle", "time": 3555.75, "timestamp": "00:59:15", "text": "子供がいるのに気づかなくて、"}, {"type": "subtitle", "time": 3559.75, "timestamp": "00:59:19", "text": "前を見てたから。"}, {"type": "subtitle", "time": 3569.03, "timestamp": "00:59:29", "text": "何か食べた？いや、全部じゃない。"}, {"type": "subtitle", "time": 3574.069, "timestamp": "00:59:34", "text": "午後2時に食べた。それが食べた唯一のものだ"}, {"type": "subtitle", "time": 3577.589, "timestamp": "00:59:37", "text": "。今日は一度しか食べていない。"}, {"type": "subtitle", "time": 3579.349, "timestamp": "00:59:39", "text": "朝食は食べなかった"}, {"type": "subtitle", "time": 3584.63, "timestamp": "00:59:44", "text": "けど、ラーメンと"}, {"type": "subtitle", "time": 3587.589, "timestamp": "00:59:47", "text": "焼きそばを一緒に食べた。"}, {"type": "subtitle", "time": 3590.95, "timestamp": "00:59:50", "text": "パン、"}, {"type": "subtitle", "time": 3593.03, "timestamp": "00:59:53", "text": "オムレツ、"}, {"type": "subtitle", "time": 3596.95, "timestamp": "00:59:56", "text": "ルームメイトが"}, {"type": "subtitle", "time": 3599.19, "timestamp": "00:59:59", "text": "マヨネーズを作ってくれた。 自家製の"}]
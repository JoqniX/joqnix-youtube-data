[{"type": "subtitle", "time": 8228.389, "timestamp": "02:17:08", "text": "困惑した顔をしているので、そこへ行くことができます。 だから"}, {"type": "subtitle", "time": 8233.509, "timestamp": "02:17:13", "text": "彼らは待たないだろう。 えっと、兄弟、今、すごく前のところまで戻ったの"}, {"type": "subtitle", "time": 8250.07, "timestamp": "02:17:30", "text": "あのね？ 私はこちらへ行きます。"}, {"type": "subtitle", "time": 8252.15, "timestamp": "02:17:32", "text": "ああ、"}, {"type": "subtitle", "time": 8270.95, "timestamp": "02:17:50", "text": "よし、じゃあこの近道で行こう。"}, {"type": "subtitle", "time": 8275.509, "timestamp": "02:17:55", "text": "なあ、俺、道に迷ったよ。 失った。   道に"}, {"type": "subtitle", "time": 8278.629, "timestamp": "02:17:58", "text": "迷いました。 失った。"}]
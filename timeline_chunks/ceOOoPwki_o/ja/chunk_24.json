[{"type": "subtitle", "time": 1460.31, "timestamp": "00:24:20", "text": "私が見かける人は皆、小型の"}, {"type": "subtitle", "time": 1462.39, "timestamp": "00:24:22", "text": "ミニ扇風機を持っている。"}, {"type": "subtitle", "time": 1465.029, "timestamp": "00:24:25", "text": "扇風機も欲しいな。"}, {"type": "subtitle", "time": 1466.549, "timestamp": "00:24:26", "text": "汗が出てきそうだ。   今、すごく"}, {"type": "subtitle", "time": 1469.909, "timestamp": "00:24:29", "text": "汗をかいています。"}, {"type": "subtitle", "time": 1474.07, "timestamp": "00:24:34", "text": "手が汗で、"}, {"type": "subtitle", "time": 1479.11, "timestamp": "00:24:39", "text": "今回は"}, {"type": "subtitle", "time": 1481.669, "timestamp": "00:24:41", "text": "そこにいる人と話してみます。 わかった。"}, {"type": "subtitle", "time": 1484.39, "timestamp": "00:24:44", "text": "反射面であることは表示すべきではない。"}, {"type": "subtitle", "time": 1488.95, "timestamp": "00:24:48", "text": "バーとかそういう雰囲気を出したいんです。"}, {"type": "subtitle", "time": 1492.31, "timestamp": "00:24:52", "text": "ええと、この辺りの"}, {"type": "subtitle", "time": 1495.51, "timestamp": "00:24:55", "text": "お店には本当に良いアンティーク品がたくさんあるんですよ。"}, {"type": "subtitle", "time": 1496.47, "timestamp": "00:24:56", "text": "うん。"}]
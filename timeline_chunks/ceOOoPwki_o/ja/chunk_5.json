[{"type": "subtitle", "time": 302.469, "timestamp": "00:05:02", "text": "GST（物品サービス税）。 それは午後4時です。  ISTはインド"}, {"type": "subtitle", "time": 305.35, "timestamp": "00:05:05", "text": "標準時です。 こんにちは。"}, {"type": "subtitle", "time": 314.71, "timestamp": "00:05:14", "text": "こんにちは。 私たちは文字通りここにいる。 わかりません"}, {"type": "subtitle", "time": 317.11, "timestamp": "00:05:17", "text": "。 でも、私は文字通り、"}, {"type": "subtitle", "time": 327.11, "timestamp": "00:05:27", "text": "ああ、私の反射する場所。 個人"}, {"type": "subtitle", "time": 328.629, "timestamp": "00:05:28", "text": "情報が晒されるかもしれない。   さあ行こう"}, {"type": "subtitle", "time": 341.27, "timestamp": "00:05:41", "text": "前回と同じになるだろう。"}, {"type": "subtitle", "time": 344.15, "timestamp": "00:05:44", "text": "必ずそうします。"}, {"type": "subtitle", "time": 359.27, "timestamp": "00:05:59", "text": "これは素晴らしいですね。 こんにちは。 では、それはどれくらいの期間続くのでしょうか"}]
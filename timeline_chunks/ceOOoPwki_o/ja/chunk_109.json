[{"type": "subtitle", "time": 6540.39, "timestamp": "01:49:00", "text": "それとも少しの間"}, {"type": "subtitle", "time": 6542.95, "timestamp": "01:49:02", "text": "カメラをオフにして、携帯"}, {"type": "subtitle", "time": 6546.31, "timestamp": "01:49:06", "text": "電話を充電しましょうか。"}, {"type": "subtitle", "time": 6556.95, "timestamp": "01:49:16", "text": "うん。 えっと、もし私が海の中にいたら、誰も"}, {"type": "subtitle", "time": 6560.47, "timestamp": "01:49:20", "text": "ベッドのせいでそれを見ることはないでしょう。 つまり、えっと、自分で自分を"}, {"type": "subtitle", "time": 6568.47, "timestamp": "01:49:28", "text": "引っ張って大きくするんです。   何てことだ"}, {"type": "subtitle", "time": 6572.87, "timestamp": "01:49:32", "text": "。 新型モデルが登場する時。"}, {"type": "subtitle", "time": 6575.83, "timestamp": "01:49:35", "text": "ああ。 あ、今、私の携帯電話が充電されている。"}, {"type": "subtitle", "time": 6578.87, "timestamp": "01:49:38", "text": "今は42歳です。 何てことだ。"}, {"type": "subtitle", "time": 6581.91, "timestamp": "01:49:41", "text": "先ほどは疲れ果てていた。 もう水は抜けない。"}, {"type": "subtitle", "time": 6583.59, "timestamp": "01:49:43", "text": "つまり、カメラはまだ持っているんです。"}, {"type": "subtitle", "time": 6585.109, "timestamp": "01:49:45", "text": "心配しないで、"}, {"type": "subtitle", "time": 6593.03, "timestamp": "01:49:53", "text": "だから、やめなさい。"}, {"type": "subtitle", "time": 6598.55, "timestamp": "01:49:58", "text": "どこかへ出かけたり、ある地域を訪れたりする時に、こういうVlogみたいなことをするのはいいことだと思う"}]
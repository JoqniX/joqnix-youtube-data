[{"type": "subtitle", "time": 13801.51, "timestamp": "03:50:01", "text": "。"}, {"type": "subtitle", "time": 13804.389, "timestamp": "03:50:04", "text": "なぜ私はサンタクロースとスレンダーマンに似ているのでしょうか？ 私の"}, {"type": "subtitle", "time": 13806.893, "timestamp": "03:50:06", "text": "影が長すぎる。"}, {"type": "subtitle", "time": 13807.51, "timestamp": "03:50:07", "text": "[笑い]"}, {"type": "subtitle", "time": 13810.87, "timestamp": "03:50:10", "text": "わかった。 こんにちは、そろそろ失礼します。 とにかく、"}, {"type": "subtitle", "time": 13815.51, "timestamp": "03:50:15", "text": "カメラを切り替えましょう。 こんにちは。   え、"}, {"type": "subtitle", "time": 13819.349, "timestamp": "03:50:19", "text": "何？"}, {"type": "subtitle", "time": 13822.309, "timestamp": "03:50:22", "text": "あなたは今すぐ立ち去るべきです。 こんにちは。"}, {"type": "subtitle", "time": 13825.99, "timestamp": "03:50:25", "text": "アーニャ、えーと、ありがとう。えーと、"}, {"type": "subtitle", "time": 13832.229, "timestamp": "03:50:32", "text": "家に帰る予定だったんだけど、道に迷って"}, {"type": "subtitle", "time": 13839.03, "timestamp": "03:50:39", "text": "長い迂回をしてしまって、家まで歩いて帰らなきゃいけないんだ"}, {"type": "subtitle", "time": 13843.03, "timestamp": "03:50:43", "text": "。 何てことだ。"}, {"type": "subtitle", "time": 13846.07, "timestamp": "03:50:46", "text": "うん。 さよなら。 わかった。 とにかく、10時"}, {"type": "subtitle", "time": 13848.07, "timestamp": "03:50:48", "text": "15分になる予定です。 私は"}, {"type": "subtitle", "time": 13851.429, "timestamp": "03:50:51", "text": "叱られるだろう。 くそ。"}, {"type": "subtitle", "time": 13854.63, "timestamp": "03:50:54", "text": "ああ、わかりました。 行くよ。 そろそろ"}, {"type": "subtitle", "time": 13856.87, "timestamp": "03:50:56", "text": "締めくくらなければ。 本日はありがとうございました。 つまり、"}]
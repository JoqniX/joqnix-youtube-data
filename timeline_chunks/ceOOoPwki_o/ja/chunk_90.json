[{"type": "subtitle", "time": 5403.59, "timestamp": "01:30:03", "text": "100円も持ってないこと。"}, {"type": "subtitle", "time": 5407.189, "timestamp": "01:30:07", "text": "今、100円も持ってないんだ。何もない。お金がない"}, {"type": "subtitle", "time": 5410.149, "timestamp": "01:30:10", "text": "。それはまずい。"}, {"type": "subtitle", "time": 5423.11, "timestamp": "01:30:23", "text": "だから、そこは光の良い場所なんだ。"}, {"type": "subtitle", "time": 5425.11, "timestamp": "01:30:25", "text": "うん。うん。うん。"}, {"type": "subtitle", "time": 5428.709, "timestamp": "01:30:28", "text": "滝のエリアに行くんだ。そこはいい場所だ。"}, {"type": "subtitle", "time": 5431.27, "timestamp": "01:30:31", "text": "もし私が正しければ、そこはあまり光がない"}, {"type": "subtitle", "time": 5433.03, "timestamp": "01:30:33", "text": "けど、座ったりするのにいい場所だ"}, {"type": "subtitle", "time": 5449.11, "timestamp": "01:30:49", "text": "手ぶれ補正とかカメラの機能をオンにする方法があるかどうかわからない。"}, {"type": "subtitle", "time": 5452.31, "timestamp": "01:30:52", "text": "もしそれが可能だったらね。あ、食べ物が"}, {"type": "subtitle", "time": 5454.07, "timestamp": "01:30:54", "text": "落ちた。"}]
[{"type": "subtitle", "time": 5049.59, "timestamp": "01:24:09", "text": "12時にフランス語で学校の人がもっといるよ。ああ、うん。じゃあね。"}, {"type": "subtitle", "time": 5051.11, "timestamp": "01:24:11", "text": "でも、彼らは私のことを知らない。彼らは2番目に来た"}, {"type": "subtitle", "time": 5072.368, "timestamp": "01:24:32", "text": "でも、すべてが終わってきている。"}, {"type": "subtitle", "time": 5074.149, "timestamp": "01:24:34", "text": "[音楽]"}, {"type": "subtitle", "time": 5083.189, "timestamp": "01:24:43", "text": "みんな家に帰る。"}, {"type": "subtitle", "time": 5089.03, "timestamp": "01:24:49", "text": "疲れ果てているように感じる。"}, {"type": "subtitle", "time": 5092.07, "timestamp": "01:24:52", "text": "水。うん。"}, {"type": "subtitle", "time": 5094.07, "timestamp": "01:24:54", "text": "いいものだ。"}, {"type": "subtitle", "time": 5097.189, "timestamp": "01:24:57", "text": "これはまずい。私のコミュニケーション能力は"}, {"type": "subtitle", "time": 5099.51, "timestamp": "01:24:59", "text": "ひどい。"}]
[{"type": "subtitle", "time": 13158.309, "timestamp": "03:39:18", "text": "私が Twitter に投稿した完全にランダムな葉巻ショーなどのソーシャル情報を見るのですか、私は"}, {"type": "subtitle", "time": 13163.51, "timestamp": "03:39:23", "text": "ライブ配信中は、最近は Twitter で"}, {"type": "subtitle", "time": 13167.19, "timestamp": "03:39:27", "text": "日本語でツイートしていますが、"}, {"type": "subtitle", "time": 13175.75, "timestamp": "03:39:35", "text": "Discord サーバーなどに参加している場合は、私が"}, {"type": "subtitle", "time": 13179.91, "timestamp": "03:39:39", "text": "ライブ配信しているときに通知が届きます。私は"}, {"type": "subtitle", "time": 13185.11, "timestamp": "03:39:45", "text": "ソーシャル メディア担当者ではありません。 ああ、わかりました"}, {"type": "subtitle", "time": 13187.83, "timestamp": "03:39:47", "text": "。"}, {"type": "subtitle", "time": 13191.11, "timestamp": "03:39:51", "text": "信仰と運命について。"}]
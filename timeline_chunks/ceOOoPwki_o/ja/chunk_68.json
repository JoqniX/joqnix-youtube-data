[{"type": "subtitle", "time": 4090.95, "timestamp": "01:08:10", "text": "待って、それは、"}, {"type": "subtitle", "time": 4098.07, "timestamp": "01:08:18", "text": "彼らが…というアナウンスですか？分かりました。でもお金がないんです。"}, {"type": "subtitle", "time": 4100.149, "timestamp": "01:08:20", "text": "オンラインで、銀行口座にお金はあります"}, {"type": "subtitle", "time": 4103.669, "timestamp": "01:08:23", "text": "。手持ちの"}, {"type": "subtitle", "time": 4106.55, "timestamp": "01:08:26", "text": "現金がありません。 銀行口座にお金がある"}, {"type": "subtitle", "time": 4121.669, "timestamp": "01:08:41", "text": "えっと、これは何？牛の数だと"}, {"type": "subtitle", "time": 4129.03, "timestamp": "01:08:49", "text": "思う。これで終わりだと思う。"}, {"type": "subtitle", "time": 4132.95, "timestamp": "01:08:52", "text": "これが発表だ。わあ。"}]
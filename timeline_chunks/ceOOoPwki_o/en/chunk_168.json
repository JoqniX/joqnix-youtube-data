[{"type": "subtitle", "time": 10099.75, "timestamp": "02:48:19", "text": "Oh, those are too much."}, {"type": "subtitle", "time": 10126.469, "timestamp": "02:48:46", "text": "Look at it."}, {"type": "subtitle", "time": 10134.469, "timestamp": "02:48:54", "text": "Imagine if they knew that I was filming."}, {"type": "subtitle", "time": 10137.75, "timestamp": "02:48:57", "text": "Would they allow me to keep on filming?"}]
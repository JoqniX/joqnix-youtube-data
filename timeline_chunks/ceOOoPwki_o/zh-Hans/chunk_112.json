[{"type": "subtitle", "time": 6729.27, "timestamp": "01:52:09", "text": "我会继续说下去。 是的。"}, {"type": "subtitle", "time": 6737.27, "timestamp": "01:52:17", "text": "某种程度上来说，我很高兴，我为自己感到骄傲，因为是的"}, {"type": "subtitle", "time": 6741.43, "timestamp": "01:52:21", "text": "，"}, {"type": "subtitle", "time": 6745.51, "timestamp": "01:52:25", "text": "我开始像主播一样进行直播vlog"}, {"type": "subtitle", "time": 6747.669, "timestamp": "01:52:27", "text": "。"}, {"type": "subtitle", "time": 6750.709, "timestamp": "01:52:30", "text": "正确的。 就像这么多年来，每当我"}, {"type": "subtitle", "time": 6753.109, "timestamp": "01:52:33", "text": "做户外直播（只有音频）的时候，"}, {"type": "subtitle", "time": 6755.51, "timestamp": "01:52:35", "text": "你知道，我总是很害羞，不敢打开"}, {"type": "subtitle", "time": 6758.95, "timestamp": "01:52:38", "text": "手机的后置摄像头。"}, {"type": "subtitle", "time": 6763.109, "timestamp": "01:52:43", "text": "很多时候我的手机"}, {"type": "subtitle", "time": 6766.149, "timestamp": "01:52:46", "text": "电池都撑不住，"}, {"type": "subtitle", "time": 6770.31, "timestamp": "01:52:50", "text": "等等。我当时非常"}, {"type": "subtitle", "time": 6773.669, "timestamp": "01:52:53", "text": "担心，比如，哦，我可能"}, {"type": "subtitle", "time": 6776.629, "timestamp": "01:52:56", "text": "做不到这样那样。"}]
[{"type": "subtitle", "time": 13022.309, "timestamp": "03:37:02", "text": "这里就像个小公园。"}, {"type": "subtitle", "time": 13025.03, "timestamp": "03:37:05", "text": "我有时会来这里。 就是这样。 那边"}, {"type": "subtitle", "time": 13029.75, "timestamp": "03:37:09", "text": "长椅上的伞是我的雨伞。"}, {"type": "subtitle", "time": 13032.02, "timestamp": "03:37:12", "text": "我的轮廓。"}, {"type": "subtitle", "time": 13033.99, "timestamp": "03:37:13", "text": "[笑声]"}, {"type": "subtitle", "time": 13036.07, "timestamp": "03:37:16", "text": "说到剪影，等等，我"}, {"type": "subtitle", "time": 13038.63, "timestamp": "03:37:18", "text": "换个屏幕，因为我们马上就要"}, {"type": "subtitle", "time": 13042.229, "timestamp": "03:37:22", "text": "结束了。 是的，"}, {"type": "subtitle", "time": 13046.55, "timestamp": "03:37:26", "text": "星期六晚上8点。  GST，也就是"}, {"type": "subtitle", "time": 13049.75, "timestamp": "03:37:29", "text": "印度的标准，呃，那是下午 4 点。 下午 4:00"}, {"type": "subtitle", "time": 13055.349, "timestamp": "03:37:35", "text": "印度标准时间（IST）。 我的首发作品，"}, {"type": "subtitle", "time": 13058.07, "timestamp": "03:37:38", "text": "Joax 的新款官方模型，"}, {"type": "subtitle", "time": 13061.67, "timestamp": "03:37:41", "text": "将于周六首次亮相。"}, {"type": "subtitle", "time": 13063.75, "timestamp": "03:37:43", "text": "哦，等等。 哦，是的。 呃，晚上8点。 就是全球"}, {"type": "subtitle", "time": 13066.469, "timestamp": "03:37:46", "text": "金融危机。 那是两个小时"}, {"type": "subtitle", "time": 13069.269, "timestamp": "03:37:49", "text": "前的事了。 现在是10点33分。   是的，"}, {"type": "subtitle", "time": 13072.229, "timestamp": "03:37:52", "text": "呃，那就是奥西亚斯。 那是"}, {"type": "subtitle", "time": 13076.389, "timestamp": "03:37:56", "text": "公告之类的东西。 欢迎过来看看。"}]
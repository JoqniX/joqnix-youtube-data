[{"type": "subtitle", "time": 13688.469, "timestamp": "03:48:08", "text": "哦，是的。 那边有人。"}, {"type": "subtitle", "time": 13690.95, "timestamp": "03:48:10", "text": "这是一套公寓。"}, {"type": "subtitle", "time": 13699.99, "timestamp": "03:48:19", "text": "现在是半夜。 这里没人"}, {"type": "subtitle", "time": 13706.469, "timestamp": "03:48:26", "text": "这里没人。 他们会想：“为什么"}, {"type": "subtitle", "time": 13709.03, "timestamp": "03:48:29", "text": "有个家伙在说话？外国人"}, {"type": "subtitle", "time": 13713.03, "timestamp": "03:48:33", "text": "独自坐在公园里，"}, {"type": "subtitle", "time": 13719.11, "timestamp": "03:48:39", "text": "对着手机喋喋不休。”   是的"}, {"type": "subtitle", "time": 13721.59, "timestamp": "03:48:41", "text": "。 再见。"}, {"type": "subtitle", "time": 13723.269, "timestamp": "03:48:43", "text": "灌木丛后面有"}, {"type": "subtitle", "time": 13724.79, "timestamp": "03:48:44", "text": "什么东西。"}, {"type": "subtitle", "time": 13727.03, "timestamp": "03:48:47", "text": "我的天啊。 阿斯特拉，等等。 我这就"}]
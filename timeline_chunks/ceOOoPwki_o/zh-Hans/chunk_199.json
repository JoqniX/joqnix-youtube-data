[{"type": "subtitle", "time": 11942.15, "timestamp": "03:19:02", "text": "拍摄模式，那会很快耗尽我的电池电量。"}, {"type": "subtitle", "time": 11946.07, "timestamp": "03:19:06", "text": "我的移动电源功能有限，它只能"}, {"type": "subtitle", "time": 11949.75, "timestamp": "03:19:09", "text": "冻结电量百分比，"}, {"type": "subtitle", "time": 11952.389, "timestamp": "03:19:12", "text": "如果我开启完整"}, {"type": "subtitle", "time": 11956.07, "timestamp": "03:19:16", "text": "相机模式，它仍然会耗电。 如果我像这样处于正常模式"}, {"type": "subtitle", "time": 11958.15, "timestamp": "03:19:18", "text": "，"}, {"type": "subtitle", "time": 11962.15, "timestamp": "03:19:22", "text": "嗯，它至少会充上百分之一到百分之"}, {"type": "subtitle", "time": 11964.229, "timestamp": "03:19:24", "text": "二的电。"}, {"type": "subtitle", "time": 11967.83, "timestamp": "03:19:27", "text": "真是忙得不可开交。 我的旧手机需要"}, {"type": "subtitle", "time": 11977.269, "timestamp": "03:19:37", "text": "是啊，你错过了很多东西。"}, {"type": "subtitle", "time": 11980.87, "timestamp": "03:19:40", "text": "我迷路了。 让我们回顾一下。 米娜，"}, {"type": "subtitle", "time": 11983.269, "timestamp": "03:19:43", "text": "我们今天到底发生了什么？ 好的。 所以，我"}, {"type": "subtitle", "time": 11986.63, "timestamp": "03:19:46", "text": "早上 6:30 就开始了这场耻辱之旅，一路"}, {"type": "subtitle", "time": 11989.75, "timestamp": "03:19:49", "text": "狂奔到达目的地，因为"}, {"type": "subtitle", "time": 11991.75, "timestamp": "03:19:51", "text": "今天是最后一天，星期日，"}, {"type": "subtitle", "time": 11994.55, "timestamp": "03:19:54", "text": "对吧？ 昨天之后，我"}, {"type": "subtitle", "time": 11997.429, "timestamp": "03:19:57", "text": "好好地带大家参观了一遍。 今天，我只是"}]
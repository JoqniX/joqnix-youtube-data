[{"type": "subtitle", "time": 840.79, "timestamp": "00:14:00", "text": "我可能会见到我"}, {"type": "subtitle", "time": 853.464, "timestamp": "00:14:13", "text": "好的。 好的。"}, {"type": "subtitle", "time": 858.629, "timestamp": "00:14:18", "text": "哦，我真是说到点子上了。 我真的亲眼"}, {"type": "subtitle", "time": 861.03, "timestamp": "00:14:21", "text": "见到我老师了，"}, {"type": "subtitle", "time": 866.31, "timestamp": "00:14:26", "text": "兄弟，"}, {"type": "subtitle", "time": 874.71, "timestamp": "00:14:34", "text": "我的天啊。 我当时想，我终于能见到我"}, {"type": "chat", "time": 875.89, "timestamp": "00:14:35", "author": "@yogipacman", "avatar": "https://yt4.ggpht.com/UudmjOedwhHrXlVk1qKsJ8rhBLkG-zcjSumwQOTb_5WDN3-D7v63KbzF9Ywa1_MKUOcOFTv5=s64-c-k-c0x00ffffff-no-rj", "message": "your teacher?"}, {"type": "subtitle", "time": 877.99, "timestamp": "00:14:37", "text": "学校的学生们了。"}, {"type": "subtitle", "time": 882.15, "timestamp": "00:14:42", "text": "她立刻看向我，说道：“等等，"}, {"type": "subtitle", "time": 885.59, "timestamp": "00:14:45", "text": "老师来了。” 老师？不，"}, {"type": "subtitle", "time": 887.99, "timestamp": "00:14:47", "text": "她不教我。 她更像是"}, {"type": "subtitle", "time": 890.55, "timestamp": "00:14:50", "text": "斯里兰卡学生的辅导老师"}, {"type": "subtitle", "time": 894.389, "timestamp": "00:14:54", "text": "，但她对我真的很好，给了"}, {"type": "subtitle", "time": 897.35, "timestamp": "00:14:57", "text": "我很多帮助。"}, {"type": "subtitle", "time": 898.71, "timestamp": "00:14:58", "text": "她也是我申请"}]
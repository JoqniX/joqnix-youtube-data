[{"type": "subtitle", "time": 1800.07, "timestamp": "00:30:00", "text": "现在是62度。 是的。 想"}, {"type": "subtitle", "time": 1803.99, "timestamp": "00:30:03", "text": "看看舞台区域吗？ 我的意思是，我们都知道我"}, {"type": "subtitle", "time": 1807.19, "timestamp": "00:30:07", "text": "可以展示舞台区域。"}, {"type": "subtitle", "time": 1817.43, "timestamp": "00:30:17", "text": "嗯，让我想想。 第"}, {"type": "subtitle", "time": 1820.07, "timestamp": "00:30:20", "text": "61 关。我一会儿会把"}, {"type": "subtitle", "time": 1824.95, "timestamp": "00:30:24", "text": "麦克风换成移动"}, {"type": "subtitle", "time": 1828.63, "timestamp": "00:30:28", "text": "电源。 好的。"}, {"type": "subtitle", "time": 1837.269, "timestamp": "00:30:37", "text": "非常糟糕。"}, {"type": "subtitle", "time": 1840.63, "timestamp": "00:30:40", "text": "你不应该[笑]在游戏里作弊什么的"}, {"type": "subtitle", "time": 1843.51, "timestamp": "00:30:43", "text": "。"}, {"type": "subtitle", "time": 1846.23, "timestamp": "00:30:46", "text": "昨天我们看到很多孩子在做"}, {"type": "subtitle", "time": 1849.51, "timestamp": "00:30:49", "text": "他们的垫子装饰之类的。"}, {"type": "subtitle", "time": 1852.95, "timestamp": "00:30:52", "text": "现在，一切都要关门了，因为今天是"}, {"type": "subtitle", "time": 1854.71, "timestamp": "00:30:54", "text": "最后一天。"}, {"type": "subtitle", "time": 1857.99, "timestamp": "00:30:57", "text": "昨天人很多。   这是"}]
[{"type": "subtitle", "time": 1623.83, "timestamp": "00:27:03", "text": "这么多反派，我不认为这是反派，"}, {"type": "subtitle", "time": 1626.39, "timestamp": "00:27:06", "text": "我看到了很多种族，"}, {"type": "subtitle", "time": 1631.029, "timestamp": "00:27:11", "text": "[笑声]"}, {"type": "subtitle", "time": 1633.51, "timestamp": "00:27:13", "text": "这里有这么"}, {"type": "subtitle", "time": 1635.543, "timestamp": "00:27:15", "text": "多"}, {"type": "subtitle", "time": 1636.63, "timestamp": "00:27:16", "text": "[尖叫声]"}, {"type": "subtitle", "time": 1641.19, "timestamp": "00:27:21", "text": "那是米老鼠吗，你知道"}, {"type": "subtitle", "time": 1644.149, "timestamp": "00:27:24", "text": "所有等等，不，是那个玩偶。 巫毒"}, {"type": "subtitle", "time": 1652.39, "timestamp": "00:27:32", "text": "哇。"}]
[{"type": "subtitle", "time": 13440.79, "timestamp": "03:44:00", "text": "人很有趣，有很多话要说，"}, {"type": "subtitle", "time": 13446.95, "timestamp": "03:44:06", "text": "而且不知何故，他们可以滔滔不绝地谈论一件"}, {"type": "subtitle", "time": 13451.349, "timestamp": "03:44:11", "text": "小事"}, {"type": "subtitle", "time": 13456.63, "timestamp": "03:44:16", "text": "。 所以我觉得"}, {"type": "subtitle", "time": 13460.15, "timestamp": "03:44:20", "text": "你应该做的，"}, {"type": "subtitle", "time": 13462.63, "timestamp": "03:44:22", "text": "我的意思是，这应该是一个很常见的建议，"}, {"type": "subtitle", "time": 13464.15, "timestamp": "03:44:24", "text": "你可能到处都听到过，就是做"}, {"type": "subtitle", "time": 13467.189, "timestamp": "03:44:27", "text": "你自己。   是"}, {"type": "subtitle", "time": 13469.67, "timestamp": "03:44:29", "text": "啊，但"}, {"type": "subtitle", "time": 13471.429, "timestamp": "03:44:31", "text": "还有一点，对吧？ 第一"}, {"type": "subtitle", "time": 13473.99, "timestamp": "03:44:33", "text": "印象是："}, {"type": "subtitle", "time": 13478.389, "timestamp": "03:44:38", "text": "我的天哪，好多狗！"}, {"type": "subtitle", "time": 13482.87, "timestamp": "03:44:42", "text": "他们恨我。 为什么会这样"}, {"type": "subtitle", "time": 13487.75, "timestamp": "03:44:47", "text": "？ 因为在日本我根本没有机会摸猫"}, {"type": "subtitle", "time": 13491.03, "timestamp": "03:44:51", "text": "。 我试过追"}, {"type": "subtitle", "time": 13495.59, "timestamp": "03:44:55", "text": "猫，但从来没成功过。"}, {"type": "subtitle", "time": 13498.95, "timestamp": "03:44:58", "text": "哦，我不知道。"}]
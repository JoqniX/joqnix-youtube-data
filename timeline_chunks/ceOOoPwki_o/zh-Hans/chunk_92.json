[{"type": "subtitle", "time": 5521.51, "timestamp": "01:32:01", "text": "地方了"}, {"type": "subtitle", "time": 5528.79, "timestamp": "01:32:08", "text": "等等，我好困惑。我"}, {"type": "subtitle", "time": 5531.35, "timestamp": "01:32:11", "text": "到底在哪儿？"}, {"type": "subtitle", "time": 5533.51, "timestamp": "01:32:13", "text": "我知道了。我认得这个地标。这是"}, {"type": "subtitle", "time": 5537.91, "timestamp": "01:32:17", "text": "螃蟹……呃……区域。"}, {"type": "subtitle", "time": 5545.83, "timestamp": "01:32:25", "text": "我觉得这"}, {"type": "subtitle", "time": 5547.91, "timestamp": "01:32:27", "text": "音乐像是在"}, {"type": "subtitle", "time": 5552.31, "timestamp": "01:32:32", "text": "说结束了。"}, {"type": "subtitle", "time": 5556.229, "timestamp": "01:32:36", "text": "结束了。我们起来了。我们准备离开了。"}, {"type": "subtitle", "time": 5565.59, "timestamp": "01:32:45", "text": "哦，天哪，"}, {"type": "subtitle", "time": 5568.87, "timestamp": "01:32:48", "text": "兄弟。让他随风而去。是啊。"}]
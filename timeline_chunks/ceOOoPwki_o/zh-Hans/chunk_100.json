[{"type": "subtitle", "time": 6009.669, "timestamp": "01:40:09", "text": "不过到处都能看到情侣。"}, {"type": "subtitle", "time": 6013.99, "timestamp": "01:40:13", "text": "我其实以为回到我家，肯定"}, {"type": "subtitle", "time": 6020.39, "timestamp": "01:40:20", "text": "人很多。所以是的。"}, {"type": "subtitle", "time": 6023.75, "timestamp": "01:40:23", "text": "哦，现在8点了，所以我还有"}, {"type": "subtitle", "time": 6029.83, "timestamp": "01:40:29", "text": "但你没看到我的脸之类的，"}, {"type": "subtitle", "time": 6032.709, "timestamp": "01:40:32", "text": "对吧？我看了会儿"}, {"type": "subtitle", "time": 6043.27, "timestamp": "01:40:43", "text": "我感觉我可能回不去了。"}, {"type": "subtitle", "time": 6046.39, "timestamp": "01:40:46", "text": "因为他们在封锁，所以他们就回去了。"}, {"type": "subtitle", "time": 6048.79, "timestamp": "01:40:48", "text": "每个人都说：“是啊，回家吧。”"}, {"type": "subtitle", "time": 6051.44, "timestamp": "01:40:51", "text": "回家吧。” 好吧。"}, {"type": "subtitle", "time": 6053.199, "timestamp": "01:40:53", "text": "好吧。 这"}, {"type": "subtitle", "time": 6054.719, "timestamp": "01:40:54", "text": "这 就像……就像情侣一样。"}]
[{"type": "subtitle", "time": 11649.51, "timestamp": "03:14:09", "text": "什么？"}, {"type": "subtitle", "time": 11673.75, "timestamp": "03:14:33", "text": "我现在是个"}, {"type": "subtitle", "time": 11677.19, "timestamp": "03:14:37", "text": "主播，拿着手机之类的东西，拍些视频博客"}, {"type": "subtitle", "time": 11681.19, "timestamp": "03:14:41", "text": "记录我正在做的事情，但你却很奇怪"}, {"type": "subtitle", "time": 11683.91, "timestamp": "03:14:43", "text": "。 我只希望它不会变得"}, {"type": "subtitle", "time": 11687.11, "timestamp": "03:14:47", "text": "无聊。 所以这就是为什么我不会"}, {"type": "subtitle", "time": 11691.19, "timestamp": "03:14:51", "text": "经常这样做的原因。 我会偶尔这么做一次"}, {"type": "subtitle", "time": 11695.03, "timestamp": "03:14:55", "text": "。 好的。 展示摄像头和所有"}, {"type": "subtitle", "time": 11696.79, "timestamp": "03:14:56", "text": "画面。 后置摄像头，不是前置"}, {"type": "subtitle", "time": 11699.67, "timestamp": "03:14:59", "text": "摄像头。"}]
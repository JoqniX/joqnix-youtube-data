[{"type": "subtitle", "time": 2976.309, "timestamp": "00:49:36", "text": "她这是要走专业路线啊。"}, {"type": "subtitle", "time": 2985.829, "timestamp": "00:49:45", "text": "总有一天我也会这么做。别"}, {"type": "subtitle", "time": 2987.829, "timestamp": "00:49:47", "text": "担心，米娜。明年我们还会"}, {"type": "subtitle", "time": 2990.71, "timestamp": "00:49:50", "text": "来。不过明年我"}, {"type": "subtitle", "time": 2993.43, "timestamp": "00:49:53", "text": "来的时候，我会做好准备。到时候我会"}]
[{"type": "subtitle", "time": 12180.79, "timestamp": "03:23:00", "text": "就像很远的地方，在一个集市上，"}, {"type": "subtitle", "time": 12182.15, "timestamp": "03:23:02", "text": "有人问我为什么你"}, {"type": "subtitle", "time": 12184.87, "timestamp": "03:23:04", "text": "不是棕色皮肤，是不是会被人"}, {"type": "subtitle", "time": 12202.55, "timestamp": "03:23:22", "text": "我的意思是，在我所在的地区有很多"}, {"type": "subtitle", "time": 12206.07, "timestamp": "03:23:26", "text": "斯里兰卡人，还有很多"}, {"type": "subtitle", "time": 12209.349, "timestamp": "03:23:29", "text": "来自其他国家的人。   是的"}, {"type": "subtitle", "time": 12212.71, "timestamp": "03:23:32", "text": "，这里印度人很少见。 所以他们应该"}]
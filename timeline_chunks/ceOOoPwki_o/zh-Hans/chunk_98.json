[{"type": "subtitle", "time": 5883.91, "timestamp": "01:38:03", "text": "有时我在想。"}, {"type": "subtitle", "time": 5893.03, "timestamp": "01:38:13", "text": "警察好像"}, {"type": "subtitle", "time": 5915.189, "timestamp": "01:38:35", "text": "所以，如果我没记错的话，它应该已经完全回来了。"}, {"type": "subtitle", "time": 5918.709, "timestamp": "01:38:38", "text": "后面。"}, {"type": "subtitle", "time": 5927.51, "timestamp": "01:38:47", "text": "[音乐] 完全在后面。"}, {"type": "subtitle", "time": 5930.79, "timestamp": "01:38:50", "text": "然后我们过马路回来。"}, {"type": "subtitle", "time": 5933.109, "timestamp": "01:38:53", "text": "我回来的时候不会走"}, {"type": "subtitle", "time": 5936.47, "timestamp": "01:38:56", "text": "这条路，因为肯定又会很"}, {"type": "subtitle", "time": 5939.59, "timestamp": "01:38:59", "text": "拥挤。"}]
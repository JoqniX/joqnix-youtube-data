[{"type": "subtitle", "time": 5281.43, "timestamp": "01:28:01", "text": "我希望，我真的希望。"}, {"type": "subtitle", "time": 5283.75, "timestamp": "01:28:03", "text": "但我不能，"}, {"type": "subtitle", "time": 5287.189, "timestamp": "01:28:07", "text": "我明天要上班。就像我"}, {"type": "subtitle", "time": 5289.91, "timestamp": "01:28:09", "text": "回家后，我得"}, {"type": "subtitle", "time": 5292.31, "timestamp": "01:28:12", "text": "补上一些网课，录音"}, {"type": "subtitle", "time": 5294.47, "timestamp": "01:28:14", "text": "课，"}, {"type": "subtitle", "time": 5299.75, "timestamp": "01:28:19", "text": "然后……嗯，"}, {"type": "subtitle", "time": 5306.07, "timestamp": "01:28:26", "text": "我的意思是，这也是个问题。"}, {"type": "subtitle", "time": 5319.99, "timestamp": "01:28:39", "text": "[音乐]"}, {"type": "subtitle", "time": 5322.07, "timestamp": "01:28:42", "text": "如果你和你的"}, {"type": "subtitle", "time": 5324.95, "timestamp": "01:28:44", "text": "朋友，你的闺蜜之类的一起来这里就很好了。"}, {"type": "subtitle", "time": 5328.31, "timestamp": "01:28:48", "text": "你们可以一起出去玩，聊天什么的，一起吃好吃的"}, {"type": "subtitle", "time": 5330.87, "timestamp": "01:28:50", "text": "。看看这些人。"}, {"type": "subtitle", "time": 5332.629, "timestamp": "01:28:52", "text": "就像他们一样。"}, {"type": "subtitle", "time": 5335.27, "timestamp": "01:28:55", "text": "你和你的朋友一起来这里聊天什么的"}]
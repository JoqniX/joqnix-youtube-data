[{"type": "subtitle", "time": 5647.43, "timestamp": "01:34:07", "text": "我觉得我得过马路。我想就是那边。过了"}, {"type": "subtitle", "time": 5651.99, "timestamp": "01:34:11", "text": "舞台，就是那边。"}, {"type": "subtitle", "time": 5657.75, "timestamp": "01:34:17", "text": "哦，就是那边。我觉得我以前没来过这里。我以前没来过这里。我可以走这里"}, {"type": "subtitle", "time": 5662.79, "timestamp": "01:34:22", "text": "。我以前没来过这里。我喜欢这里。"}, {"type": "subtitle", "time": 5691.75, "timestamp": "01:34:51", "text": "我以前真的没来过这里"}]
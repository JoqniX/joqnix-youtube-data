[{"type": "subtitle", "time": 6360.39, "timestamp": "01:46:00", "text": "大家周末过得怎么样？"}, {"type": "subtitle", "time": 6363.51, "timestamp": "01:46:03", "text": "为我。 我本来"}, {"type": "subtitle", "time": 6365.83, "timestamp": "01:46:05", "text": "应该在这里制作我的首张"}, {"type": "subtitle", "time": 6368.629, "timestamp": "01:46:08", "text": "幻灯片，但我今天还没完成，"}, {"type": "subtitle", "time": 6376.149, "timestamp": "01:46:16", "text": "我却在这里偷懒——不，我不是在偷懒，"}, {"type": "subtitle", "time": 6378.79, "timestamp": "01:46:18", "text": "我是在创作内容。 是的。"}, {"type": "subtitle", "time": 6382.07, "timestamp": "01:46:22", "text": "所以，我来这里就是想看看"}, {"type": "subtitle", "time": 6386.95, "timestamp": "01:46:26", "text": "直播里的祭典之类的。"}, {"type": "subtitle", "time": 6391.51, "timestamp": "01:46:31", "text": "说实话，最后一天我其实可以"}, {"type": "subtitle", "time": 6394.55, "timestamp": "01:46:34", "text": "选择不直播"}, {"type": "subtitle", "time": 6397.51, "timestamp": "01:46:37", "text": "。"}, {"type": "subtitle", "time": 6400.39, "timestamp": "01:46:40", "text": "呃，因为我昨天已经直播过了"}, {"type": "subtitle", "time": 6402.629, "timestamp": "01:46:42", "text": "。"}, {"type": "subtitle", "time": 6406.47, "timestamp": "01:46:46", "text": "所以，就好像我莫名其妙地做了两只虾一样"}, {"type": "subtitle", "time": 6409.99, "timestamp": "01:46:49", "text": "。"}, {"type": "subtitle", "time": 6413.03, "timestamp": "01:46:53", "text": "只是在泥泞的城市里闲逛。   就是这样。"}, {"type": "subtitle", "time": 6415.669, "timestamp": "01:46:55", "text": "展示"}, {"type": "subtitle", "time": 6417.35, "timestamp": "01:46:57", "text": "一切事物。 我觉得我"}, {"type": "subtitle", "time": 6419.109, "timestamp": "01:46:59", "text": "在这场直播中没有展示太多东西。 当时只有"}]
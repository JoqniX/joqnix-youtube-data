[{"type": "subtitle", "time": 13320.309, "timestamp": "03:42:00", "text": "然后你就会成为你自己，然后你就会获得"}, {"type": "subtitle", "time": 13323.349, "timestamp": "03:42:03", "text": "做这件事的能量。 实际上，"}, {"type": "subtitle", "time": 13325.83, "timestamp": "03:42:05", "text": "它确实有效。"}, {"type": "subtitle", "time": 13328.87, "timestamp": "03:42:08", "text": "从积极的角度来看"}, {"type": "subtitle", "time": 13330.63, "timestamp": "03:42:10", "text": "，"}, {"type": "subtitle", "time": 13343.99, "timestamp": "03:42:23", "text": "所以杜娜，"}, {"type": "subtitle", "time": 13347.99, "timestamp": "03:42:27", "text": "我现在在哪儿？ 我的天啊。 等等，我"}, {"type": "subtitle", "time": 13351.19, "timestamp": "03:42:31", "text": "从这里左转了。   糟糕。"}, {"type": "subtitle", "time": 13356.469, "timestamp": "03:42:36", "text": "是的，"}, {"type": "subtitle", "time": 13359.75, "timestamp": "03:42:39", "text": "我认得这个地方。 好的。"}, {"type": "subtitle", "time": 13367.349, "timestamp": "03:42:47", "text": "我不紧张。 问题是，到了"}, {"type": "subtitle", "time": 13371.349, "timestamp": "03:42:51", "text": "某个时候，我已经没有什么事情可"}, {"type": "subtitle", "time": 13374.79, "timestamp": "03:42:54", "text": "问、可谈或可沟通了"}, {"type": "subtitle", "time": 13377.75, "timestamp": "03:42:57", "text": "。 嗯。"}]
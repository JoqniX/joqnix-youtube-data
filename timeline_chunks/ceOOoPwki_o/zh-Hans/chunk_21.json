[{"type": "subtitle", "time": 1262.39, "timestamp": "00:21:02", "text": "啊，昨天也是这事。 我们见过"}, {"type": "subtitle", "time": 1275.669, "timestamp": "00:21:15", "text": "我们到达了这片区域的尽头，"}, {"type": "subtitle", "time": 1278.71, "timestamp": "00:21:18", "text": "呃，"}, {"type": "subtitle", "time": 1282.07, "timestamp": "00:21:22", "text": "那是"}, {"type": "subtitle", "time": 1285.669, "timestamp": "00:21:25", "text": "这片区域的吉祥物，我记得是这样，或者我忘了它"}, {"type": "subtitle", "time": 1303.19, "timestamp": "00:21:43", "text": "我原以为这是一幅挂毯，"}, {"type": "subtitle", "time": 1305.419, "timestamp": "00:21:45", "text": "但它不是。 它是用图表"}, {"type": "chat", "time": 1306.228, "timestamp": "00:21:46", "author": "@yogipacman", "avatar": "https://yt4.ggpht.com/UudmjOedwhHrXlVk1qKsJ8rhBLkG-zcjSumwQOTb_5WDN3-D7v63KbzF9Ywa1_MKUOcOFTv5=s64-c-k-c0x00ffffff-no-rj", "message": "gunma chan"}, {"type": "subtitle", "time": 1309.27, "timestamp": "00:21:49", "text": "纸做的。[清嗓子] 对，就是这东西。 这叫什么"}, {"type": "subtitle", "time": 1311.669, "timestamp": "00:21:51", "text": "？ 它就像一块"}, {"type": "subtitle", "time": 1314.31, "timestamp": "00:21:54", "text": "生肉之类的东西。 我不知道那"}, {"type": "subtitle", "time": 1317.11, "timestamp": "00:21:57", "text": "是什么。"}]
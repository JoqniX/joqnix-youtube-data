[{"type": "subtitle", "time": 5348.79, "timestamp": "01:29:08", "text": "明年。肯定会去的。 就是它。"}, {"type": "subtitle", "time": 5351.59, "timestamp": "01:29:11", "text": "感觉那些酒在呼唤你的名字。"}, {"type": "subtitle", "time": 5359.75, "timestamp": "01:29:19", "text": "来喝我吧。马提尼先生就像在说："}, {"type": "subtitle", "time": 5364.39, "timestamp": "01:29:24", "text": "“来喝我吧。”  “我想让你喝我。”"}, {"type": "subtitle", "time": 5369.11, "timestamp": "01:29:29", "text": "是啊，"}, {"type": "subtitle", "time": 5372.07, "timestamp": "01:29:32", "text": "我的手好痛。"}, {"type": "subtitle", "time": 5393.99, "timestamp": "01:29:53", "text": "他们免费送东西。不是那种"}, {"type": "subtitle", "time": 5397.59, "timestamp": "01:29:57", "text": "100日元就能买到的免费东西。最"}, {"type": "subtitle", "time": 5399.75, "timestamp": "01:29:59", "text": "搞笑也最悲哀的是，我"}]
[{"type": "subtitle", "time": 5221.11, "timestamp": "01:27:01", "text": "昨天去过的那个有瀑布的地方。"}, {"type": "subtitle", "time": 5228.709, "timestamp": "01:27:08", "text": "哦，等等。我也可以在这里。"}, {"type": "subtitle", "time": 5231.59, "timestamp": "01:27:11", "text": "对，我们走这边。"}, {"type": "subtitle", "time": 5234.31, "timestamp": "01:27:14", "text": "我们穿过去了。这是酒吧区。"}, {"type": "subtitle", "time": 5237.03, "timestamp": "01:27:17", "text": "我们穿过这里。再来一次"}, {"type": "subtitle", "time": 5243.43, "timestamp": "01:27:23", "text": "我们可以再去这里。"}, {"type": "subtitle", "time": 5247.51, "timestamp": "01:27:27", "text": "计划一些事情，就像以前在大学里那样"}, {"type": "subtitle", "time": 5251.189, "timestamp": "01:27:31", "text": "。小组讨论。"}, {"type": "subtitle", "time": 5253.43, "timestamp": "01:27:33", "text": "但作为一个外国人，谁会和"}, {"type": "subtitle", "time": 5255.43, "timestamp": "01:27:35", "text": "我说话呢？"}, {"type": "subtitle", "time": 5258.47, "timestamp": "01:27:38", "text": "谁会和我说话呢？"}, {"type": "subtitle", "time": 5260.55, "timestamp": "01:27:40", "text": "当你不太懂日语，"}]
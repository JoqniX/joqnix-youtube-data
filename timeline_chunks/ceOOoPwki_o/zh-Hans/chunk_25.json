[{"type": "subtitle", "time": 1506.95, "timestamp": "00:25:06", "text": "？ 八千黑蜜。 哦，"}, {"type": "subtitle", "time": 1509.59, "timestamp": "00:25:09", "text": "软奶酪。"}, {"type": "subtitle", "time": 1511.59, "timestamp": "00:25:11", "text": "哇。"}, {"type": "subtitle", "time": 1514.149, "timestamp": "00:25:14", "text": "然后是日式海绵蛋糕，蓬松"}, {"type": "subtitle", "time": 1517.59, "timestamp": "00:25:17", "text": "柔软。 哦，原来是海绵蛋糕。"}, {"type": "subtitle", "time": 1520.87, "timestamp": "00:25:20", "text": "它们尺寸各不相同。"}, {"type": "subtitle", "time": 1555.632, "timestamp": "00:25:55", "text": "哦，是的。 他要通过了。"}]
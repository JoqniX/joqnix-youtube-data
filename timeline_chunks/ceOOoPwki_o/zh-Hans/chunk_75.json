[{"type": "subtitle", "time": 4508.87, "timestamp": "01:15:08", "text": "我给你看过上面那个东西了吗"}, {"type": "subtitle", "time": 4518.79, "timestamp": "01:15:18", "text": "我可以找个地方坐下。我的手"}, {"type": "subtitle", "time": 4520.07, "timestamp": "01:15:20", "text": "好痛。"}, {"type": "subtitle", "time": 4525.43, "timestamp": "01:15:25", "text": "我的手好痛。那里有"}, {"type": "subtitle", "time": 4531.51, "timestamp": "01:15:31", "text": "警察。呃，"}, {"type": "subtitle", "time": 4545.75, "timestamp": "01:15:45", "text": "和人说话很吓人。"}, {"type": "subtitle", "time": 4549.35, "timestamp": "01:15:49", "text": "我还是个内向的人，兄弟。"}, {"type": "subtitle", "time": 4553.189, "timestamp": "01:15:53", "text": "是因为我不出门，"}, {"type": "subtitle", "time": 4557.27, "timestamp": "01:15:57", "text": "而这里明明写着营业吗？是的。那"}, {"type": "subtitle", "time": 4559.189, "timestamp": "01:15:59", "text": "我再来坐坐"}]
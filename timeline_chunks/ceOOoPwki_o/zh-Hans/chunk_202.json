[{"type": "subtitle", "time": 12121.67, "timestamp": "03:22:01", "text": "麦克风静音了，因为他们都认识我，知道我的"}, {"type": "subtitle", "time": 12125.59, "timestamp": "03:22:05", "text": "名字。 呃，所以我把麦克风静音了。 他们"}, {"type": "subtitle", "time": 12129.349, "timestamp": "03:22:09", "text": "现在发现我在直播了。 我遇到了"}, {"type": "subtitle", "time": 12133.19, "timestamp": "03:22:13", "text": "几位我以前的老师。   我跟"}, {"type": "subtitle", "time": 12136.07, "timestamp": "03:22:16", "text": "他们打了招呼。"}, {"type": "subtitle", "time": 12139.03, "timestamp": "03:22:19", "text": "然后呢？ 是的。"}, {"type": "subtitle", "time": 12141.51, "timestamp": "03:22:21", "text": "昨天和今天，我都错过了很多和"}, {"type": "subtitle", "time": 12146.95, "timestamp": "03:22:26", "text": "陌生人聊天的机会。 他们会说："}, {"type": "subtitle", "time": 12149.11, "timestamp": "03:22:29", "text": "“哦，这个人正在直播。” 也许"}, {"type": "subtitle", "time": 12151.349, "timestamp": "03:22:31", "text": "他们正在浏览，注意到 Twitch"}, {"type": "subtitle", "time": 12153.269, "timestamp": "03:22:33", "text": "图标、YouTube 图标和 Kicker"}, {"type": "subtitle", "time": 12156.15, "timestamp": "03:22:36", "text": "图标，认出这些平台后，"}, {"type": "subtitle", "time": 12158.15, "timestamp": "03:22:38", "text": "就会想：“哦，他在"}, {"type": "subtitle", "time": 12161.11, "timestamp": "03:22:41", "text": "多个平台上直播啊。”"}, {"type": "subtitle", "time": 12163.51, "timestamp": "03:22:43", "text": "他们不懂英语，因为我一直都在"}, {"type": "subtitle", "time": 12166.79, "timestamp": "03:22:46", "text": "说英语。 他们"}, {"type": "subtitle", "time": 12169.19, "timestamp": "03:22:49", "text": "想跟我说些什么。 我想"}, {"type": "subtitle", "time": 12172.389, "timestamp": "03:22:52", "text": "回顾过去。 我当时非常害羞。"}]
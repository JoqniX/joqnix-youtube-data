[{"type": "subtitle", "time": 4020.47, "timestamp": "01:07:00", "text": "你在夜店吗？不，我是从那条街走过来的。"}, {"type": "subtitle", "time": 4027.27, "timestamp": "01:07:07", "text": "我离开了那条街。"}, {"type": "subtitle", "time": 4036.63, "timestamp": "01:07:16", "text": "你看，"}, {"type": "subtitle", "time": 4040.71, "timestamp": "01:07:20", "text": "大家都在收拾东西。你"}, {"type": "subtitle", "time": 4044.069, "timestamp": "01:07:24", "text": "看，大家都在收拾。"}, {"type": "subtitle", "time": 4047.27, "timestamp": "01:07:27", "text": "日本人不太会"}, {"type": "subtitle", "time": 4049.51, "timestamp": "01:07:29", "text": "弄脏东西。他们会把每个"}, {"type": "subtitle", "time": 4052.63, "timestamp": "01:07:32", "text": "角落都打扫干净。他们会把垃圾带"}, {"type": "subtitle", "time": 4056.789, "timestamp": "01:07:36", "text": "回家等等。"}, {"type": "subtitle", "time": 4066.71, "timestamp": "01:07:46", "text": "我真的很想从这里买杯果汁，"}, {"type": "subtitle", "time": 4070.39, "timestamp": "01:07:50", "text": "因为这是食品店。"}, {"type": "subtitle", "time": 4075.43, "timestamp": "01:07:55", "text": "人真多。"}, {"type": "subtitle", "time": 4078.549, "timestamp": "01:07:58", "text": "所以他们"}]
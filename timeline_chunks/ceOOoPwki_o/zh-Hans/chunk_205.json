[{"type": "subtitle", "time": 12313.91, "timestamp": "03:25:13", "text": "。 目前为止我还没有受到评判，这"}, {"type": "subtitle", "time": 12317.19, "timestamp": "03:25:17", "text": "很好。 与东京不同。"}, {"type": "subtitle", "time": 12319.11, "timestamp": "03:25:19", "text": "东京。 关于东京，我有很多话想说"}, {"type": "subtitle", "time": 12320.87, "timestamp": "03:25:20", "text": "。   虽然那里"}, {"type": "subtitle", "time": 12324.229, "timestamp": "03:25:24", "text": "不错，但我不太喜欢"}, {"type": "subtitle", "time": 12327.269, "timestamp": "03:25:27", "text": "那个地方"}, {"type": "subtitle", "time": 12344.309, "timestamp": "03:25:44", "text": "你会和别人建立亲密关系，即使"}, {"type": "subtitle", "time": 12349.11, "timestamp": "03:25:49", "text": "不去打招呼也会主动问候吗？ 嗯，有时候两者兼有。"}, {"type": "subtitle", "time": 12353.11, "timestamp": "03:25:53", "text": "有时两者兼有。 有时两者兼有。 是的。"}, {"type": "subtitle", "time": 12355.59, "timestamp": "03:25:55", "text": "我唯一需要做的就是主动"}, {"type": "subtitle", "time": 12359.59, "timestamp": "03:25:59", "text": "多和人交流。   是的"}]
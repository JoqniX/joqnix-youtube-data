[{"type": "subtitle", "time": 12061.99, "timestamp": "03:21:01", "text": "然后我会去东京或"}, {"type": "subtitle", "time": 12069.349, "timestamp": "03:21:09", "text": "呃，我猜你之所以说“不”，是因为"}, {"type": "subtitle", "time": 12072.79, "timestamp": "03:21:12", "text": "你把东京和涩谷想成了"}, {"type": "subtitle", "time": 12076.469, "timestamp": "03:21:16", "text": "拥挤的旅游景点。"}, {"type": "subtitle", "time": 12079.19, "timestamp": "03:21:19", "text": "我觉得只有我一个人在直播，"}, {"type": "subtitle", "time": 12087.269, "timestamp": "03:21:27", "text": "后面看到我在直播的人都在用日语跟我说话，说“哦，这个人正在"}, {"type": "subtitle", "time": 12089.269, "timestamp": "03:21:29", "text": "直播”之"}, {"type": "subtitle", "time": 12091.91, "timestamp": "03:21:31", "text": "类的。 我当时太害羞了，不敢转身"}, {"type": "subtitle", "time": 12093.91, "timestamp": "03:21:33", "text": "说话。"}, {"type": "subtitle", "time": 12097.269, "timestamp": "03:21:37", "text": "所以人们都在评判。 不多。 实际上没有人"}, {"type": "subtitle", "time": 12099.51, "timestamp": "03:21:39", "text": "评判。"}, {"type": "subtitle", "time": 12102.309, "timestamp": "03:21:42", "text": "这真是出乎我的意料。 不。呃，我其实"}, {"type": "subtitle", "time": 12104.07, "timestamp": "03:21:44", "text": "以为"}, {"type": "subtitle", "time": 12106.95, "timestamp": "03:21:46", "text": "有些人不会"}, {"type": "subtitle", "time": 12110.07, "timestamp": "03:21:50", "text": "希望我拍摄像商店那样的场景。 有人"}, {"type": "subtitle", "time": 12114.229, "timestamp": "03:21:54", "text": "跟你搭讪过吗？ 呃，我遇到了一些人，呃，"}, {"type": "subtitle", "time": 12116.309, "timestamp": "03:21:56", "text": "我遇到了一些当地人。 我在节日上看到了他们"}, {"type": "subtitle", "time": 12119.269, "timestamp": "03:21:59", "text": "。 我和他们谈过了。 我把"}]
[{"type": "subtitle", "time": 5584.87, "timestamp": "01:33:04", "text": "等等，应该……演出里好黑啊。"}, {"type": "subtitle", "time": 5587.75, "timestamp": "01:33:07", "text": "我是说，今晚……"}, {"type": "subtitle", "time": 5589.669, "timestamp": "01:33:09", "text": "呃……"}, {"type": "subtitle", "time": 5592.149, "timestamp": "01:33:12", "text": "我觉得"}, {"type": "subtitle", "time": 5598.95, "timestamp": "01:33:18", "text": "我不知道我该不该开闪光灯。"}, {"type": "subtitle", "time": 5601.83, "timestamp": "01:33:21", "text": "那样会太亮。"}, {"type": "subtitle", "time": 5604.229, "timestamp": "01:33:24", "text": "我不应该…… 我不应该指望"}, {"type": "subtitle", "time": 5606.95, "timestamp": "01:33:26", "text": "闪光灯。这样够了吧？告诉"}, {"type": "subtitle", "time": 5609.99, "timestamp": "01:33:29", "text": "我一声。好吧，"}, {"type": "subtitle", "time": 5614.31, "timestamp": "01:33:34", "text": "至少能看清。"}, {"type": "subtitle", "time": 5629.27, "timestamp": "01:33:49", "text": "我们大概会走到"}, {"type": "subtitle", "time": 5632.07, "timestamp": "01:33:52", "text": "那边，然后"}, {"type": "subtitle", "time": 5635.59, "timestamp": "01:33:55", "text": "坐下来聊一会儿，"}, {"type": "subtitle", "time": 5639.51, "timestamp": "01:33:59", "text": "再从我们"}]
[{"type": "subtitle", "time": 13207.429, "timestamp": "03:40:07", "text": "好的。 我很喜欢。 哦，雨停了"}, {"type": "subtitle", "time": 13211.03, "timestamp": "03:40:11", "text": "。 我可以走过去。 好的。"}, {"type": "subtitle", "time": 13214.87, "timestamp": "03:40:14", "text": "今天过得很开心。 我玩得很开心。"}, {"type": "subtitle", "time": 13217.59, "timestamp": "03:40:17", "text": "唉，我不想结束，"}, {"type": "subtitle", "time": 13220.469, "timestamp": "03:40:20", "text": "但是时间太晚了。 我明天有课。 我"}, {"type": "subtitle", "time": 13222.95, "timestamp": "03:40:22", "text": "明天要上班。"}, {"type": "subtitle", "time": 13225.11, "timestamp": "03:40:25", "text": "呃，"}, {"type": "subtitle", "time": 13228.55, "timestamp": "03:40:28", "text": "如果我没去参加祭典的话，我可能就会"}, {"type": "subtitle", "time": 13232.07, "timestamp": "03:40:32", "text": "看完那两个小时的"}, {"type": "subtitle", "time": 13237.269, "timestamp": "03:40:37", "text": "网课，然后收拾东西"}, {"type": "subtitle", "time": 13243.83, "timestamp": "03:40:43", "text": "吃晚饭睡觉什么的"}, {"type": "subtitle", "time": 13245.83, "timestamp": "03:40:45", "text": "。"}, {"type": "subtitle", "time": 13252.07, "timestamp": "03:40:52", "text": "我可以跟你分享点什么吗？ 当然可以。 当然。"}, {"type": "subtitle", "time": 13256.63, "timestamp": "03:40:56", "text": "请随意，我稍微绕了点"}, {"type": "subtitle", "time": 13258.87, "timestamp": "03:40:58", "text": "路，这样我就可以跟你"}]
[{"type": "subtitle", "time": 13623.91, "timestamp": "03:47:03", "text": "嗯？"}, {"type": "subtitle", "time": 13626.229, "timestamp": "03:47:06", "text": "相机。"}, {"type": "subtitle", "time": 13629.429, "timestamp": "03:47:09", "text": "我是不是湿透了？ 湿透了，"}, {"type": "subtitle", "time": 13633.11, "timestamp": "03:47:13", "text": "哦，是的。 之前下过雨。"}, {"type": "subtitle", "time": 13635.349, "timestamp": "03:47:15", "text": "哇。"}, {"type": "subtitle", "time": 13638.309, "timestamp": "03:47:18", "text": "兄弟，我看到一个人了。 什么？ 兄弟，别"}, {"type": "subtitle", "time": 13644.389, "timestamp": "03:47:24", "text": "你是在说那"}, {"type": "subtitle", "time": 13659.189, "timestamp": "03:47:39", "text": "呃，"}, {"type": "subtitle", "time": 13661.269, "timestamp": "03:47:41", "text": "不，不是那个人。 屏幕后面有东西"}, {"type": "subtitle", "time": 13664.07, "timestamp": "03:47:44", "text": "。"}, {"type": "subtitle", "time": 13666.95, "timestamp": "03:47:46", "text": "丹尼尔，别吓我，阿斯特拉。"}, {"type": "subtitle", "time": 13670.71, "timestamp": "03:47:50", "text": "阿斯特拉，我要揍你。 哦，就像"}]
[{"type": "subtitle", "time": 8350.629, "timestamp": "02:19:10", "text": "我会回来的。 好吧。 你好，骑师。"}, {"type": "subtitle", "time": 8354.709, "timestamp": "02:19:14", "text": "你好。 你好。 你好。 你好。 哦，瞧。"}, {"type": "subtitle", "time": 8357.03, "timestamp": "02:19:17", "text": "那就像戴了个面具。"}, {"type": "subtitle", "time": 8359.11, "timestamp": "02:19:19", "text": "在商店旁边。"}, {"type": "subtitle", "time": 8373.11, "timestamp": "02:19:33", "text": "你看到了吗？ 他刚才是不是画了个"}, {"type": "subtitle", "time": 8389.19, "timestamp": "02:19:49", "text": "K："}, {"type": "subtitle", "time": 8392.601, "timestamp": "02:19:52", "text": "我想我会找到出路的。"}, {"type": "subtitle", "time": 8393.27, "timestamp": "02:19:53", "text": "[清嗓子]"}]
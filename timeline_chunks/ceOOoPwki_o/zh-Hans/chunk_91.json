[{"type": "subtitle", "time": 5465.51, "timestamp": "01:31:05", "text": "我想知道他们会怎么做。 带着"}, {"type": "subtitle", "time": 5468.229, "timestamp": "01:31:08", "text": "食物。他们会回家"}, {"type": "subtitle", "time": 5472.31, "timestamp": "01:31:12", "text": "自己吃吗？大家都快收工了"}, {"type": "subtitle", "time": 5504.629, "timestamp": "01:31:44", "text": "现在走路的时候一定要待在车里，"}, {"type": "subtitle", "time": 5506.87, "timestamp": "01:31:46", "text": "这样才能跟上这股人流"}, {"type": "subtitle", "time": 5517.27, "timestamp": "01:31:57", "text": "我不知道我在哪儿，"}, {"type": "subtitle", "time": 5519.91, "timestamp": "01:31:59", "text": "但我感觉我可能要去对"}]
[{"type": "subtitle", "time": 12722.309, "timestamp": "03:32:02", "text": "只吃一顿饭。"}, {"type": "subtitle", "time": 12726.469, "timestamp": "03:32:06", "text": "所以，我今天唯一吃的东西就是我"}, {"type": "subtitle", "time": 12728.87, "timestamp": "03:32:08", "text": "买了一碗韩式拉面、一碗"}, {"type": "subtitle", "time": 12733.349, "timestamp": "03:32:13", "text": "炒面和一碗日式炒面。 我把"}, {"type": "subtitle", "time": 12735.75, "timestamp": "03:32:15", "text": "它们混合在一起，放上那些"}, {"type": "subtitle", "time": 12740.71, "timestamp": "03:32:20", "text": "调味料，做好之后，又买了"}, {"type": "subtitle", "time": 12742.309, "timestamp": "03:32:22", "text": "沙拉"}, {"type": "subtitle", "time": 12745.67, "timestamp": "03:32:25", "text": "卷心菜，就像那种切好的沙拉"}, {"type": "subtitle", "time": 12750.229, "timestamp": "03:32:30", "text": "混合菜一样。 用这种便宜的"}, {"type": "subtitle", "time": 12753.67, "timestamp": "03:32:33", "text": "面包"}, {"type": "subtitle", "time": 12756.95, "timestamp": "03:32:36", "text": "做了两个煎蛋卷。   那还有什么呢"}, {"type": "subtitle", "time": 12759.91, "timestamp": "03:32:39", "text": "？ 嗯，室友做了"}, {"type": "subtitle", "time": 12763.91, "timestamp": "03:32:43", "text": "自制蛋黄酱。 所以，那东西就是"}, {"type": "subtitle", "time": 12766.229, "timestamp": "03:32:46", "text": "番茄酱。"}, {"type": "subtitle", "time": 12770.469, "timestamp": "03:32:50", "text": "然后呢？ 对，胡萝卜和黄瓜。"}, {"type": "subtitle", "time": 12773.11, "timestamp": "03:32:53", "text": "那些东西是我加的。"}, {"type": "subtitle", "time": 12776.229, "timestamp": "03:32:56", "text": "我买了一个奶油面包，"}, {"type": "subtitle", "time": 12778.469, "timestamp": "03:32:58", "text": "但我还没吃。 如果橱柜里还有的话，也许明天"}]
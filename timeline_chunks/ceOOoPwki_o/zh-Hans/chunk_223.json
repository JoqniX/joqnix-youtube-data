[{"type": "subtitle", "time": 13382.87, "timestamp": "03:43:02", "text": "我觉得我问这个问题不太合适，"}, {"type": "subtitle", "time": 13388.63, "timestamp": "03:43:08", "text": "我觉得我问这个问题问错了，"}, {"type": "subtitle", "time": 13392.229, "timestamp": "03:43:12", "text": "因为我自己也不擅长沟通。[清嗓子]"}, {"type": "subtitle", "time": 13395.269, "timestamp": "03:43:15", "text": "但是一旦我"}, {"type": "subtitle", "time": 13397.83, "timestamp": "03:43:17", "text": "和某人熟络起来，我就会一直"}, {"type": "subtitle", "time": 13400.79, "timestamp": "03:43:20", "text": "喋喋不休。 我谈论的"}, {"type": "subtitle", "time": 13405.59, "timestamp": "03:43:25", "text": "话题五花八门，简直无所不谈"}, {"type": "subtitle", "time": 13409.59, "timestamp": "03:43:29", "text": "。 就像那些了解我的人"}, {"type": "subtitle", "time": 13413.11, "timestamp": "03:43:33", "text": "，他们都知道我有时候有多烦人。"}, {"type": "subtitle", "time": 13416.07, "timestamp": "03:43:36", "text": "不仅仅是"}, {"type": "subtitle", "time": 13420.71, "timestamp": "03:43:40", "text": "打电话，甚至发短信也一样。 我就是那种"}, {"type": "subtitle", "time": 13425.91, "timestamp": "03:43:45", "text": "喜欢写很多长篇大论来描述"}, {"type": "subtitle", "time": 13428.309, "timestamp": "03:43:48", "text": "某件事、我的想法"}, {"type": "subtitle", "time": 13429.99, "timestamp": "03:43:49", "text": "等等的人。"}, {"type": "subtitle", "time": 13436.79, "timestamp": "03:43:56", "text": "对方在"}, {"type": "subtitle", "time": 13438.71, "timestamp": "03:43:58", "text": "接收信息时会想，哦，这个"}]
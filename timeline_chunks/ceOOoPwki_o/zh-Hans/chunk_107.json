[{"type": "subtitle", "time": 6422.229, "timestamp": "01:47:02", "text": "我一个人在走来走去，一直在说话。"}, {"type": "subtitle", "time": 6424.07, "timestamp": "01:47:04", "text": "上次直播我没怎么说话，但带大家"}, {"type": "subtitle", "time": 6426.55, "timestamp": "01:47:06", "text": "四处转了转。"}, {"type": "subtitle", "time": 6435.27, "timestamp": "01:47:15", "text": "是的，你们可以"}, {"type": "subtitle", "time": 6438.709, "timestamp": "01:47:18", "text": "和我一起四处走走。 所以，所以，所以，这就是它的好处所在"}, {"type": "subtitle", "time": 6440.87, "timestamp": "01:47:20", "text": "。   是的"}, {"type": "subtitle", "time": 6442.39, "timestamp": "01:47:22", "text": "。"}, {"type": "subtitle", "time": 6445.109, "timestamp": "01:47:25", "text": "我的想法是，"}, {"type": "subtitle", "time": 6448.31, "timestamp": "01:47:28", "text": "如果我周五就来了，那时"}, {"type": "subtitle", "time": 6451.75, "timestamp": "01:47:31", "text": "这个活动才刚刚开始，就像上"}, {"type": "subtitle", "time": 6454.229, "timestamp": "01:47:34", "text": "周五、周六、周日的塔纳瓦达"}, {"type": "subtitle", "time": 6457.669, "timestamp": "01:47:37", "text": "节一样。如果我周五来，我就"}, {"type": "subtitle", "time": 6461.59, "timestamp": "01:47:41", "text": "可以亲自去探索一番，"}, {"type": "subtitle", "time": 6463.75, "timestamp": "01:47:43", "text": "周六就可以在线观看了。 或许"}, {"type": "subtitle", "time": 6465.51, "timestamp": "01:47:45", "text": "星期天我可能会无缘无故地再来这里一次，"}, {"type": "subtitle", "time": 6468.629, "timestamp": "01:47:48", "text": "或者我可以观看直播"}, {"type": "subtitle", "time": 6471.35, "timestamp": "01:47:51", "text": "。 这就是我的想法。 但星期五我"}, {"type": "subtitle", "time": 6475.75, "timestamp": "01:47:55", "text": "感觉特别累。 是的。 星期五我"}, {"type": "subtitle", "time": 6477.59, "timestamp": "01:47:57", "text": "开始制作"}, {"type": "subtitle", "time": 6479.99, "timestamp": "01:47:59", "text": "幻灯片以及所有与 PowerPoint"}]
[{"type": "subtitle", "time": 12001.19, "timestamp": "03:20:01", "text": "边走边聊，到处"}, {"type": "subtitle", "time": 12003.67, "timestamp": "03:20:03", "text": "闲逛。"}, {"type": "subtitle", "time": 12006.95, "timestamp": "03:20:06", "text": "今天我迷路了三四次。"}, {"type": "subtitle", "time": 12013.51, "timestamp": "03:20:13", "text": "我居然迷路了，还得用"}, {"type": "subtitle", "time": 12017.349, "timestamp": "03:20:17", "text": "谷歌地图搜索，结果还是"}, {"type": "subtitle", "time": 12019.59, "timestamp": "03:20:19", "text": "迷路了。"}, {"type": "subtitle", "time": 12027.75, "timestamp": "03:20:27", "text": "他们把庆祝活动"}, {"type": "subtitle", "time": 12031.11, "timestamp": "03:20:31", "text": "区域扩大得太大了，"}, {"type": "subtitle", "time": 12034.63, "timestamp": "03:20:34", "text": "兄弟。 想象一下如果这是东京之"}, {"type": "subtitle", "time": 12036.15, "timestamp": "03:20:36", "text": "类的城市。"}, {"type": "subtitle", "time": 12040.389, "timestamp": "03:20:40", "text": "我觉得那里会太拥挤、太大了"}, {"type": "subtitle", "time": 12043.269, "timestamp": "03:20:43", "text": "。   是的"}, {"type": "subtitle", "time": 12046.229, "timestamp": "03:20:46", "text": "。"}, {"type": "subtitle", "time": 12050.15, "timestamp": "03:20:50", "text": "或许有一天，明年吧。 不，"}, {"type": "subtitle", "time": 12054.229, "timestamp": "03:20:54", "text": "如果明年可以的话，"}, {"type": "subtitle", "time": 12057.03, "timestamp": "03:20:57", "text": "我会去……我会……我会"}, {"type": "subtitle", "time": 12059.75, "timestamp": "03:20:59", "text": "从我现在所在的地方拍摄同样的东西，"}]
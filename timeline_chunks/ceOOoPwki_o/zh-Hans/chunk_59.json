[{"type": "subtitle", "time": 3542.63, "timestamp": "00:59:02", "text": "我们还没去过这片区域，对吧？所以我们"}, {"type": "subtitle", "time": 3552.87, "timestamp": "00:59:12", "text": "天哪。我的天哪。太吓人了。我"}, {"type": "subtitle", "time": 3555.75, "timestamp": "00:59:15", "text": "没注意到有个小孩，"}, {"type": "subtitle", "time": 3557.829, "timestamp": "00:59:17", "text": "然后"}, {"type": "subtitle", "time": 3559.75, "timestamp": "00:59:19", "text": "我就一直往前看。我没"}, {"type": "subtitle", "time": 3569.03, "timestamp": "00:59:29", "text": "你吃东西了吗？没有，没吃完。"}, {"type": "subtitle", "time": 3574.069, "timestamp": "00:59:34", "text": "我下午2点吃了点东西。那是"}, {"type": "subtitle", "time": 3577.589, "timestamp": "00:59:37", "text": "我今天唯一吃的东西。我今天只吃了一顿。没吃"}, {"type": "subtitle", "time": 3579.349, "timestamp": "00:59:39", "text": "早饭，"}, {"type": "subtitle", "time": 3584.63, "timestamp": "00:59:44", "text": "但我吃了……我吃了拉面和"}, {"type": "subtitle", "time": 3587.589, "timestamp": "00:59:47", "text": "烤肉卷。"}, {"type": "subtitle", "time": 3590.95, "timestamp": "00:59:50", "text": "他们做了面包……面包，煎蛋"}, {"type": "subtitle", "time": 3593.03, "timestamp": "00:59:53", "text": "卷，"}, {"type": "subtitle", "time": 3596.95, "timestamp": "00:59:56", "text": "我的室友做了……"}, {"type": "subtitle", "time": 3599.19, "timestamp": "00:59:59", "text": "蛋黄酱。我们做了自制的"}]
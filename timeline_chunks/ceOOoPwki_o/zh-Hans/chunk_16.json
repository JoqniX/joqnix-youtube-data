[{"type": "subtitle", "time": 961.189, "timestamp": "00:16:01", "text": "我可以走另一条路，也可以"}, {"type": "subtitle", "time": 963.35, "timestamp": "00:16:03", "text": "等着。"}, {"type": "subtitle", "time": 981.67, "timestamp": "00:16:21", "text": "说真的，现在你要是问我（笑）"}, {"type": "subtitle", "time": 984.87, "timestamp": "00:16:24", "text": "，你觉得你对"}, {"type": "subtitle", "time": 987.509, "timestamp": "00:16:27", "text": "日本之类的有什么感觉？ 我感觉自己不像"}, {"type": "subtitle", "time": 989.749, "timestamp": "00:16:29", "text": "在日本。 感觉像"}, {"type": "subtitle", "time": 991.59, "timestamp": "00:16:31", "text": "做梦一样。"}, {"type": "subtitle", "time": 995.99, "timestamp": "00:16:35", "text": "说实话，感觉就像做梦一样。"}, {"type": "subtitle", "time": 1000.55, "timestamp": "00:16:40", "text": "所以，感觉就像一场梦，或者更像是一次"}, {"type": "subtitle", "time": 1006.55, "timestamp": "00:16:46", "text": "男人的实地考察之类的。"}, {"type": "subtitle", "time": 1015.67, "timestamp": "00:16:55", "text": "等我上学吧。"}, {"type": "chat", "time": 1018.342, "timestamp": "00:16:58", "author": "@yogipacman", "avatar": "https://yt4.ggpht.com/UudmjOedwhHrXlVk1qKsJ8rhBLkG-zcjSumwQOTb_5WDN3-D7v63KbzF9Ywa1_MKUOcOFTv5=s64-c-k-c0x00ffffff-no-rj", "message": "how do you feel about Japanese festival? fun? too crouded?"}]
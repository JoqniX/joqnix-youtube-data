[{"type": "subtitle", "time": 8100.629, "timestamp": "02:15:00", "text": "哦，这是第100家分店。 我该"}, {"type": "subtitle", "time": 8103.669, "timestamp": "02:15:03", "text": "在这里买点什么吗？ 你想一起去吃"}, {"type": "subtitle", "time": 8105.669, "timestamp": "02:15:05", "text": "小吃吗"}, {"type": "subtitle", "time": 8107.83, "timestamp": "02:15:07", "text": "？"}, {"type": "subtitle", "time": 8117.109, "timestamp": "02:15:17", "text": "那是百元店。 可以。"}, {"type": "subtitle", "time": 8120.069, "timestamp": "02:15:20", "text": "我可以去，"}, {"type": "subtitle", "time": 8124.229, "timestamp": "02:15:24", "text": "或者我可以去7-11便利店。"}, {"type": "subtitle", "time": 8127.669, "timestamp": "02:15:27", "text": "但问题是，我的自行车不在"}, {"type": "subtitle", "time": 8129.27, "timestamp": "02:15:29", "text": "附近。"}, {"type": "subtitle", "time": 8143.35, "timestamp": "02:15:43", "text": "小伙子摔倒在我身上。 什么？"}, {"type": "subtitle", "time": 8151.83, "timestamp": "02:15:51", "text": "哦，那位女士刚才想说“好的”之类的话"}, {"type": "subtitle", "time": 8154.709, "timestamp": "02:15:54", "text": "。"}]
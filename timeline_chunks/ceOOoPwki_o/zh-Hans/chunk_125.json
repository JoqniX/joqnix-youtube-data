[{"type": "subtitle", "time": 7500.31, "timestamp": "02:05:00", "text": "好的。   就是那件事"}, {"type": "subtitle", "time": 7518.07, "timestamp": "02:05:18", "text": "我还活着吗？ 你好。"}, {"type": "subtitle", "time": 7521.03, "timestamp": "02:05:21", "text": "我希望我还活着。"}, {"type": "subtitle", "time": 7523.589, "timestamp": "02:05:23", "text": "好的，我们回去。"}, {"type": "subtitle", "time": 7525.589, "timestamp": "02:05:25", "text": "哦，那里有一块反光区域。 你"}, {"type": "subtitle", "time": 7528.629, "timestamp": "02:05:28", "text": "可能见过我的轮廓，知道"}, {"type": "subtitle", "time": 7537.91, "timestamp": "02:05:37", "text": "哦，这里有一台自动售货机。"}, {"type": "subtitle", "time": 7539.99, "timestamp": "02:05:39", "text": "那是我想的那样吗？ 那是"}, {"type": "subtitle", "time": 7544.07, "timestamp": "02:05:44", "text": "香烟自动售货机吗？ 什么？"}, {"type": "subtitle", "time": 7545.91, "timestamp": "02:05:45", "text": "我的天啊。 这是一台香烟自动"}, {"type": "subtitle", "time": 7553.669, "timestamp": "02:05:53", "text": "这是一支雪茄。 我的天哪。"}, {"type": "subtitle", "time": 7556.07, "timestamp": "02:05:56", "text": "我的天啊。"}, {"type": "subtitle", "time": 7558.87, "timestamp": "02:05:58", "text": "哦，我知道其中一些品牌，因为"}]
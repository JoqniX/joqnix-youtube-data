[{"type": "subtitle", "time": 2523.27, "timestamp": "00:42:03", "text": "我当时就想，“哦，不。”"}, {"type": "subtitle", "time": 2525.03, "timestamp": "00:42:05", "text": "嗯，拜拜。”"}, {"type": "subtitle", "time": 2528.15, "timestamp": "00:42:08", "text": "现在我也不想昨天那样，我一直在"}, {"type": "subtitle", "time": 2530.309, "timestamp": "00:42:10", "text": "想，我当时应该……"}, {"type": "subtitle", "time": 2533.599, "timestamp": "00:42:13", "text": "我当时应该…… 呃，转身跟他们聊聊。"}, {"type": "subtitle", "time": 2538.24, "timestamp": "00:42:18", "text": "呃，转身跟他们聊聊。 他以为我是个视频博主"}, {"type": "subtitle", "time": 2539.92, "timestamp": "00:42:19", "text": "他以为我是个视频博主 什么的。所以，我也不知道。"}, {"type": "subtitle", "time": 2543.68, "timestamp": "00:42:23", "text": "什么的。所以，我也不知道。 他不知道我是个油管主播。"}, {"type": "subtitle", "time": 2546.56, "timestamp": "00:42:26", "text": "他不知道我是个油管主播。 所以"}, {"type": "subtitle", "time": 2554.39, "timestamp": "00:42:34", "text": "，就是这样。我希望我能"}, {"type": "subtitle", "time": 2570.55, "timestamp": "00:42:50", "text": "希望你玩得开心。"}, {"type": "subtitle", "time": 2572.95, "timestamp": "00:42:52", "text": "我玩得很开心。玩得很"}, {"type": "subtitle", "time": 2576.71, "timestamp": "00:42:56", "text": "开心。谢谢你们来。"}, {"type": "subtitle", "time": 2579.68, "timestamp": "00:42:59", "text": "谢谢你们来。 哦，等等。Twitch 上有个眼睛。"}]
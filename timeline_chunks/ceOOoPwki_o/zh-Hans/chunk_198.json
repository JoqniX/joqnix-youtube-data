[{"type": "subtitle", "time": 11880.87, "timestamp": "03:18:00", "text": "呃，"}, {"type": "subtitle", "time": 11884.63, "timestamp": "03:18:04", "text": "你暴露我的身份了吗？ 不。"}, {"type": "subtitle", "time": 11889.269, "timestamp": "03:18:09", "text": "你为什么会忘记自己？   但"}, {"type": "subtitle", "time": 11891.51, "timestamp": "03:18:11", "text": "我究竟是谁呢？ 我是一名油管博主。 我"}, {"type": "subtitle", "time": 11894.55, "timestamp": "03:18:14", "text": "应该……我不该暴露自己。"}, {"type": "subtitle", "time": 11897.59, "timestamp": "03:18:17", "text": "你为什么会问这个问题？ 你绝对"}, {"type": "subtitle", "time": 11899.51, "timestamp": "03:18:19", "text": "不应该问"}, {"type": "subtitle", "time": 11901.59, "timestamp": "03:18:21", "text": "油管博主这个问题。"}, {"type": "subtitle", "time": 11903.91, "timestamp": "03:18:23", "text": "如果我想公开露面，我会建"}, {"type": "subtitle", "time": 11907.269, "timestamp": "03:18:27", "text": "个频道或者在那里直播，"}, {"type": "subtitle", "time": 11911.269, "timestamp": "03:18:31", "text": "这样就不会有人知道那是我了。 为什么不呢"}, {"type": "subtitle", "time": 11913.83, "timestamp": "03:18:33", "text": "？ 呃，我是个虚拟主播，所以我不"}, {"type": "subtitle", "time": 11920.309, "timestamp": "03:18:40", "text": "我的意思是，有些油管博主会这么做，"}, {"type": "subtitle", "time": 11923.269, "timestamp": "03:18:43", "text": "但我不想，我不想，我真的不想"}, {"type": "subtitle", "time": 11926.229, "timestamp": "03:18:46", "text": "。"}, {"type": "subtitle", "time": 11929.99, "timestamp": "03:18:49", "text": "所以，我不想破坏这种氛围。   是的"}, {"type": "subtitle", "time": 11931.99, "timestamp": "03:18:51", "text": "。 好的，我们切换到"}, {"type": "subtitle", "time": 11933.75, "timestamp": "03:18:53", "text": "这个场景，"}, {"type": "subtitle", "time": 11935.83, "timestamp": "03:18:55", "text": "这样我就可以给手机充一会儿电了。"}, {"type": "subtitle", "time": 11938.63, "timestamp": "03:18:58", "text": "如果我一直使用全屏"}]
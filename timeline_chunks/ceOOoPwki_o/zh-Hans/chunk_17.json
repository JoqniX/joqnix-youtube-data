[{"type": "subtitle", "time": 1021.11, "timestamp": "00:17:01", "text": "就走在我前面。 我觉得"}, {"type": "subtitle", "time": 1023.749, "timestamp": "00:17:03", "text": "他们好像盯上我们学校了。"}, {"type": "subtitle", "time": 1025.35, "timestamp": "00:17:05", "text": "嗯，"}, {"type": "subtitle", "time": 1029.909, "timestamp": "00:17:09", "text": "我在中学附近见过他们。"}, {"type": "subtitle", "time": 1037.27, "timestamp": "00:17:17", "text": "你觉得怎么样？是啊，有点"}, {"type": "subtitle", "time": 1045.429, "timestamp": "00:17:25", "text": "但"}, {"type": "subtitle", "time": 1048.23, "timestamp": "00:17:28", "text": "问题是，如果是在东京，那肯定会很"}, {"type": "subtitle", "time": 1050.15, "timestamp": "00:17:30", "text": "拥挤，到处"}, {"type": "subtitle", "time": 1056.15, "timestamp": "00:17:36", "text": "即使"}, {"type": "subtitle", "time": 1068.47, "timestamp": "00:17:48", "text": "我应该带包的，伙计。"}, {"type": "subtitle", "time": 1071.029, "timestamp": "00:17:51", "text": "我确实需要一个类似"}, {"type": "subtitle", "time": 1075.99, "timestamp": "00:17:55", "text": "侧挎包之类的东西。 我买了"}, {"type": "subtitle", "time": 1077.909, "timestamp": "00:17:57", "text": "一个便携式的……哦，等等。 这是"}]
[{"type": "subtitle", "time": 11765.75, "timestamp": "03:16:05", "text": "但我恐怕只能这样坐着了，"}, {"type": "subtitle", "time": 11789.75, "timestamp": "03:16:29", "text": "我内心已经死了"}, {"type": "subtitle", "time": 11792.63, "timestamp": "03:16:32", "text": "。 你"}, {"type": "subtitle", "time": 11795.349, "timestamp": "03:16:35", "text": "啊，"}, {"type": "subtitle", "time": 11798.71, "timestamp": "03:16:38", "text": "我内心已经彻底麻木了。"}, {"type": "subtitle", "time": 11803.269, "timestamp": "03:16:43", "text": "今天走了这么多路，好累啊。"}, {"type": "subtitle", "time": 11807.03, "timestamp": "03:16:47", "text": "现在我们真的就坐在公园里，外面正"}, {"type": "subtitle", "time": 11809.11, "timestamp": "03:16:49", "text": "下着雨。"}, {"type": "subtitle", "time": 11817.75, "timestamp": "03:16:57", "text": "四处看看，伙计。 你迟到了。 你"}]
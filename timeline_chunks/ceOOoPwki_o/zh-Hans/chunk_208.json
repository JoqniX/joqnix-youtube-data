[{"type": "subtitle", "time": 12487.91, "timestamp": "03:28:07", "text": "我的一个同学退学了"}, {"type": "subtitle", "time": 12489.91, "timestamp": "03:28:09", "text": "。 实际上，他们回到了"}, {"type": "subtitle", "time": 12495.99, "timestamp": "03:28:15", "text": "嗯，"}, {"type": "subtitle", "time": 12498.469, "timestamp": "03:28:18", "text": "我对他决定"}, {"type": "subtitle", "time": 12503.03, "timestamp": "03:28:23", "text": "回家并退学（"}, {"type": "subtitle", "time": 12505.75, "timestamp": "03:28:25", "text": "语言学校退学）感到非常困惑。"}, {"type": "subtitle", "time": 12515.429, "timestamp": "03:28:35", "text": "你的大二一样，只剩下"}, {"type": "subtitle", "time": 12518.79, "timestamp": "03:28:38", "text": "几个月的时间了。 比如明年三月，"}, {"type": "subtitle", "time": 12521.83, "timestamp": "03:28:41", "text": "你就要毕业了。 你为什么"}, {"type": "subtitle", "time": 12524.55, "timestamp": "03:28:44", "text": "现在辞职？"}, {"type": "subtitle", "time": 12528.07, "timestamp": "03:28:48", "text": "如果我没记错的话，是因为他没有做兼职，"}, {"type": "subtitle", "time": 12531.269, "timestamp": "03:28:51", "text": "而且他的钱也快不够"}, {"type": "subtitle", "time": 12535.349, "timestamp": "03:28:55", "text": "维持生计了等等。"}, {"type": "subtitle", "time": 12537.51, "timestamp": "03:28:57", "text": "所以，也许是因为"}, {"type": "subtitle", "time": 12539.59, "timestamp": "03:28:59", "text": "经济状况的原因。"}]
[{"type": "subtitle", "time": 8826.87, "timestamp": "02:27:06", "text": "，等等。 我的室友说"}, {"type": "subtitle", "time": 8831.11, "timestamp": "02:27:11", "text": "我可以10点以后来，所以没问题。"}, {"type": "subtitle", "time": 8835.19, "timestamp": "02:27:15", "text": "我的天啊。 他并非只是这么说的。"}, {"type": "subtitle", "time": 8871.27, "timestamp": "02:27:51", "text": "我现在联系不上查德了"}]
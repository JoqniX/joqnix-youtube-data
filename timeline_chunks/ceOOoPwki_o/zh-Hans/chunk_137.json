[{"type": "subtitle", "time": 8225.75, "timestamp": "02:17:05", "text": "我可以去那里，"}, {"type": "subtitle", "time": 8228.389, "timestamp": "02:17:08", "text": "因为我现在一脸困惑。 所以"}, {"type": "subtitle", "time": 8233.509, "timestamp": "02:17:13", "text": "他们不会再等了。 呃，兄弟，我刚才是不是走了很远的路"}, {"type": "subtitle", "time": 8250.07, "timestamp": "02:17:30", "text": "你知道吗？ 我打算走这边。"}, {"type": "subtitle", "time": 8252.15, "timestamp": "02:17:32", "text": "啊，"}, {"type": "subtitle", "time": 8270.95, "timestamp": "02:17:50", "text": "好吧，我要走捷径。"}, {"type": "subtitle", "time": 8275.509, "timestamp": "02:17:55", "text": "兄弟，我迷路了。 丢失的。"}, {"type": "subtitle", "time": 8278.639, "timestamp": "02:17:58", "text": "我迷路了。 丢失的。 [清嗓子]"}]
[{"type": "subtitle", "time": 3433.43, "timestamp": "00:57:13", "text": "这两个孩子现在很挣扎，因为"}, {"type": "subtitle", "time": 3465.43, "timestamp": "00:57:45", "text": "这是出口。就是这样。"}, {"type": "subtitle", "time": 3468.39, "timestamp": "00:57:48", "text": "好了，我们掉头回去。这次我们直走"}, {"type": "subtitle", "time": 3478.15, "timestamp": "00:57:58", "text": "外国人比"}]
[{"type": "subtitle", "time": 6540.39, "timestamp": "01:49:00", "text": "或者我们应该"}, {"type": "subtitle", "time": 6542.95, "timestamp": "01:49:02", "text": "暂时关掉摄像头，这样我就"}, {"type": "subtitle", "time": 6546.31, "timestamp": "01:49:06", "text": "可以给手机充电了。"}, {"type": "subtitle", "time": 6556.95, "timestamp": "01:49:16", "text": "。 呃，如果我在海里，就"}, {"type": "subtitle", "time": 6560.47, "timestamp": "01:49:20", "text": "不会有人看到我的床了。 我的意思是，"}, {"type": "subtitle", "time": 6563.27, "timestamp": "01:49:23", "text": "呃，"}, {"type": "subtitle", "time": 6568.47, "timestamp": "01:49:28", "text": "让我把自己拉起来，让自己变大一些。"}, {"type": "subtitle", "time": 6572.87, "timestamp": "01:49:32", "text": "我的天啊。 新车型上市的时候。"}, {"type": "subtitle", "time": 6575.83, "timestamp": "01:49:35", "text": "啊。 哦，我的手机正在充电。"}, {"type": "subtitle", "time": 6578.87, "timestamp": "01:49:38", "text": "现在是42岁了。 我的天啊。"}, {"type": "subtitle", "time": 6581.91, "timestamp": "01:49:41", "text": "之前就感觉很累。 现在它不再排水了。"}, {"type": "subtitle", "time": 6583.59, "timestamp": "01:49:43", "text": "我的意思是，我还有那台相机。 别"}, {"type": "subtitle", "time": 6585.109, "timestamp": "01:49:45", "text": "担心，"}, {"type": "subtitle", "time": 6593.03, "timestamp": "01:49:53", "text": "所以，别这么做。 如果我做这些"}, {"type": "subtitle", "time": 6595.91, "timestamp": "01:49:55", "text": "事情，比如拍vlog之类的，比如"}, {"type": "subtitle", "time": 6598.55, "timestamp": "01:49:58", "text": "去某个地方、参观某个地区什么的，那就很好了"}]
[{"type": "subtitle", "time": 12660.229, "timestamp": "03:31:00", "text": "回到家后，我什么事都没有"}, {"type": "subtitle", "time": 12662.55, "timestamp": "03:31:02", "text": "。 我会觉得每天都像在"}, {"type": "subtitle", "time": 12664.309, "timestamp": "03:31:04", "text": "度假。 所以，我可能会"}, {"type": "subtitle", "time": 12667.429, "timestamp": "03:31:07", "text": "整天睡觉，或者整天玩游戏，或者"}, {"type": "subtitle", "time": 12669.349, "timestamp": "03:31:09", "text": "24小时不间断直播，或者做"}, {"type": "subtitle", "time": 12670.95, "timestamp": "03:31:10", "text": "任何我想做的事情。   就是"}, {"type": "subtitle", "time": 12676.229, "timestamp": "03:31:16", "text": "那种生活方式，对吧？"}, {"type": "subtitle", "time": 12678.389, "timestamp": "03:31:18", "text": "但现在想想，我觉得自己更有"}, {"type": "subtitle", "time": 12681.349, "timestamp": "03:31:21", "text": "责任感了。"}, {"type": "subtitle", "time": 12684.55, "timestamp": "03:31:24", "text": "我时间不够。 我几乎没有时间"}, {"type": "subtitle", "time": 12693.03, "timestamp": "03:31:33", "text": "你自己做饭吗？ 嗯，"}, {"type": "subtitle", "time": 12695.75, "timestamp": "03:31:35", "text": "我现在会做一点饭，但我的"}, {"type": "subtitle", "time": 12699.51, "timestamp": "03:31:39", "text": "室友大部分时间都在做饭"}, {"type": "subtitle", "time": 12702.389, "timestamp": "03:31:42", "text": "。 我知道怎么给"}, {"type": "subtitle", "time": 12705.59, "timestamp": "03:31:45", "text": "自己煮面条，还有其他一些东西，一些"}, {"type": "subtitle", "time": 12708.71, "timestamp": "03:31:48", "text": "小菜，"}, {"type": "subtitle", "time": 12710.79, "timestamp": "03:31:50", "text": "比如像印度香饭这样的大餐，以及"}, {"type": "subtitle", "time": 12713.349, "timestamp": "03:31:53", "text": "他做的那些东西。"}, {"type": "subtitle", "time": 12717.429, "timestamp": "03:31:57", "text": "他的厨艺比我好。"}, {"type": "subtitle", "time": 12719.349, "timestamp": "03:31:59", "text": "那么早餐和晚餐呢？ 我一天"}]
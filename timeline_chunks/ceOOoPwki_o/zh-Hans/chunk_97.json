[{"type": "subtitle", "time": 5830.149, "timestamp": "01:37:10", "text": "第一次看到日本的……松地"}, {"type": "subtitle", "time": 5834.629, "timestamp": "01:37:14", "text": "这样关门。我"}, {"type": "subtitle", "time": 5858.709, "timestamp": "01:37:38", "text": "有时我觉得我散发着一种"}, {"type": "subtitle", "time": 5862.55, "timestamp": "01:37:42", "text": "难以接近的气息，"}, {"type": "subtitle", "time": 5864.95, "timestamp": "01:37:44", "text": "有人想和我说话，但我感觉自己"}, {"type": "subtitle", "time": 5867.59, "timestamp": "01:37:47", "text": "很矜持，或者别的什么，以至于"}, {"type": "subtitle", "time": 5869.43, "timestamp": "01:37:49", "text": "很难和我这样的人交谈"}, {"type": "subtitle", "time": 5870.95, "timestamp": "01:37:50", "text": "。"}, {"type": "subtitle", "time": 5873.83, "timestamp": "01:37:53", "text": "有时我在想，我内心是不是"}, {"type": "subtitle", "time": 5877.03, "timestamp": "01:37:57", "text": "有那种防御机制，然后就像……"}]
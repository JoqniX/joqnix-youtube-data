[{"type": "subtitle", "time": 12780.71, "timestamp": "03:33:00", "text": "上班的时候我会带上它"}, {"type": "subtitle", "time": 12790.79, "timestamp": "03:33:10", "text": "你每天都做饭吗？"}, {"type": "subtitle", "time": 12794.229, "timestamp": "03:33:14", "text": "不，是的，我们经常做饭。"}, {"type": "subtitle", "time": 12798.15, "timestamp": "03:33:18", "text": "这就是我们燃气费高的原因。"}, {"type": "subtitle", "time": 12800.71, "timestamp": "03:33:20", "text": "自己做饭更便宜。 嗯，价格"}, {"type": "subtitle", "time": 12803.11, "timestamp": "03:33:23", "text": "亲民，对吧？ 某种程度上来说。"}, {"type": "subtitle", "time": 12805.51, "timestamp": "03:33:25", "text": "我反而会从这里买东西。 它"}, {"type": "subtitle", "time": 12810.79, "timestamp": "03:33:30", "text": "我应该分享些什么吗？ 好的，请便"}, {"type": "subtitle", "time": 12814.229, "timestamp": "03:33:34", "text": "。 但是，嗯，也快10点了，我"}, {"type": "subtitle", "time": 12816.309, "timestamp": "03:33:36", "text": "得收工了。"}, {"type": "subtitle", "time": 12818.79, "timestamp": "03:33:38", "text": "缺乏时间和维持蛋白质。 我"}, {"type": "subtitle", "time": 12820.469, "timestamp": "03:33:40", "text": "开始早上喝生鸡蛋液。"}, {"type": "subtitle", "time": 12822.63, "timestamp": "03:33:42", "text": "这就足够了。"}, {"type": "subtitle", "time": 12826.07, "timestamp": "03:33:46", "text": "哦，是的。 日本的生鸡蛋其实"}, {"type": "subtitle", "time": 12829.19, "timestamp": "03:33:49", "text": "很好吃。 我不知道为什么。 但是，如果你吃"}, {"type": "subtitle", "time": 12831.75, "timestamp": "03:33:51", "text": "美国产的生鸡蛋，然后"}, {"type": "subtitle", "time": 12833.51, "timestamp": "03:33:53", "text": "把它加到米饭或其他食物里，"}, {"type": "subtitle", "time": 12836.469, "timestamp": "03:33:56", "text": "味道就不好。   我和一个"}, {"type": "subtitle", "time": 12839.429, "timestamp": "03:33:59", "text": "日本朋友，也是"}]
[{"type": "subtitle", "time": 6132.47, "timestamp": "01:42:12", "text": "就像你在动漫里看到的那样，都是"}, {"type": "subtitle", "time": 6134.95, "timestamp": "01:42:14", "text": "真的。我感觉它"}, {"type": "subtitle", "time": 6136.79, "timestamp": "01:42:16", "text": "是真的，"}, {"type": "subtitle", "time": 6139.99, "timestamp": "01:42:19", "text": "就像你知道的，前辈和后辈一起去祭典"}, {"type": "subtitle", "time": 6142.87, "timestamp": "01:42:22", "text": "。我们看过很多"}, {"type": "subtitle", "time": 6145.83, "timestamp": "01:42:25", "text": "次了。我看过很多次。"}, {"type": "subtitle", "time": 6158.31, "timestamp": "01:42:38", "text": "烟花表演一样。"}, {"type": "subtitle", "time": 6160.31, "timestamp": "01:42:40", "text": "他们会在那里告白什么的"}, {"type": "subtitle", "time": 6162.07, "timestamp": "01:42:42", "text": "，对吧？"}, {"type": "subtitle", "time": 6166.149, "timestamp": "01:42:46", "text": "去一个不那么拥挤的地方，或者像一个"}, {"type": "subtitle", "time": 6171.109, "timestamp": "01:42:51", "text": "地势较高的地方，在那里"}, {"type": "subtitle", "time": 6174.47, "timestamp": "01:42:54", "text": "他们可以一起看烟花"}, {"type": "subtitle", "time": 6177.51, "timestamp": "01:42:57", "text": "什么的。"}, {"type": "subtitle", "time": 6179.109, "timestamp": "01:42:59", "text": "是的，这就是我说的那个地方"}]
[{"type": "subtitle", "time": 18549.23, "timestamp": "05:09:09", "text": "[音乐]"}, {"type": "subtitle", "time": 18552.628, "timestamp": "05:09:12", "text": "好的，这对她来说是个机会。等等，也许我"}, {"type": "subtitle", "time": 18555.03, "timestamp": "05:09:15", "text": "应该等等。我想看到对以下内容的评论"}, {"type": "subtitle", "time": 18558.628, "timestamp": "05:09:18", "text": "又是些蠢事。或许"}, {"type": "subtitle", "time": 18560.55, "timestamp": "05:09:20", "text": "嗯，她其他方面都做得很好。"}, {"type": "subtitle", "time": 18563.11, "timestamp": "05:09:23", "text": "关于她。嗯？为什么？为什么会有"}, {"type": "subtitle", "time": 18565.83, "timestamp": "05:09:25", "text": "负面评论？什么？好吧，我的压力"}, {"type": "subtitle", "time": 18567.83, "timestamp": "05:09:27", "text": "等级已经高到令人发指了。所以，我"}, {"type": "subtitle", "time": 18568.91, "timestamp": "05:09:28", "text": "应该"}, {"type": "subtitle", "time": 18578.99, "timestamp": "05:09:38", "text": "猜72，"}, {"type": "subtitle", "time": 18587.75, "timestamp": "05:09:47", "text": "坏的。我首先感觉找到了我的特别之处，然后出发"}, {"type": "subtitle", "time": 18589.27, "timestamp": "05:09:49", "text": "和他们一起度过这一刻。我们会游泳"}, {"type": "subtitle", "time": 18591.31, "timestamp": "05:09:51", "text": "一起就是冰"}, {"type": "subtitle", "time": 18594.91, "timestamp": "05:09:54", "text": "先涂奶油，然后我们就可以握住"}, {"type": "subtitle", "time": 18598.75, "timestamp": "05:09:58", "text": "我的天哪，那双手是其中之一"}]
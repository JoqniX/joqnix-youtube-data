[{"type": "subtitle", "time": 14760.91, "timestamp": "04:06:00", "text": "[音乐]"}, {"type": "subtitle", "time": 14763.269, "timestamp": "04:06:03", "text": "再次。哦，天哪。所以它实际上制造"}, {"type": "subtitle", "time": 14766.15, "timestamp": "04:06:06", "text": "对我来说，斩杀吸血鬼和邪恶势力是理所当然的。"}, {"type": "subtitle", "time": 14768.67, "timestamp": "04:06:08", "text": "呃，生物。我最喜欢"}, {"type": "subtitle", "time": 14773.87, "timestamp": "04:06:13", "text": "店铺。我就像个最棒的人，然后就出发了。"}, {"type": "subtitle", "time": 14776.95, "timestamp": "04:06:16", "text": "等等，我当时就想，“我的天哪，他的他们"}, {"type": "subtitle", "time": 14780.53, "timestamp": "04:06:20", "text": "英语真是太糟糕了。我的天哪"}, {"type": "subtitle", "time": 14788.469, "timestamp": "04:06:28", "text": "上帝。呃，邪恶。好吧，我们来玩个漂亮的游戏吧。"}, {"type": "subtitle", "time": 14790.79, "timestamp": "04:06:30", "text": "坚持自己的立场，去小地方。"}, {"type": "subtitle", "time": 14793.189, "timestamp": "04:06:33", "text": "失误。所以，我有点害怕去做。"}, {"type": "subtitle", "time": 14796.87, "timestamp": "04:06:36", "text": "那。我真的很差劲，你打赌吧"}, {"type": "subtitle", "time": 14799.349, "timestamp": "04:06:39", "text": "你必须将你所有的技能都运用到我们如何"}, {"type": "subtitle", "time": 14802.229, "timestamp": "04:06:42", "text": "几乎不说话。我觉得自己学到了一些东西"}, {"type": "subtitle", "time": 14812.51, "timestamp": "04:06:52", "text": "5.84 位关注者。好的。那是"}, {"type": "subtitle", "time": 14818.96, "timestamp": "04:06:58", "text": "那。"}]
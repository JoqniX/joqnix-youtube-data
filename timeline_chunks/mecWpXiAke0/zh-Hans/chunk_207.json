[{"type": "subtitle", "time": 12421.91, "timestamp": "03:27:01", "text": "非常喜欢地下美食。我该怎么做？"}, {"type": "subtitle", "time": 12424.07, "timestamp": "03:27:04", "text": "真的吗？别在意我的故事。我要去"}, {"type": "subtitle", "time": 12426.269, "timestamp": "03:27:06", "text": "带去学校"}, {"type": "subtitle", "time": 12429.429, "timestamp": "03:27:09", "text": "我。我不需要参与其中"}, {"type": "subtitle", "time": 12432.87, "timestamp": "03:27:12", "text": "请保持安静，因为哦，这是私人信息。"}, {"type": "subtitle", "time": 12435.75, "timestamp": "03:27:15", "text": "这是个公共账户。"}, {"type": "subtitle", "time": 12436.75, "timestamp": "03:27:16", "text": "好的。"}, {"type": "subtitle", "time": 12441.269, "timestamp": "03:27:21", "text": "可能会非常非常深入地"}, {"type": "subtitle", "time": 12444.469, "timestamp": "03:27:24", "text": "当然是地下偶像。所以是私密的"}, {"type": "subtitle", "time": 12447.07, "timestamp": "03:27:27", "text": "我将可以使用"}, {"type": "subtitle", "time": 12451.51, "timestamp": "03:27:31", "text": "可以公开查看。好的。因为我"}, {"type": "subtitle", "time": 12453.51, "timestamp": "03:27:33", "text": "读起来总是那么有趣。"}, {"type": "subtitle", "time": 12455.75, "timestamp": "03:27:35", "text": "太搞笑了。人们看到人们争吵"}, {"type": "subtitle", "time": 12458.309, "timestamp": "03:27:38", "text": "关于它们是否真实存在或是否具有攻击性。"}, {"type": "subtitle", "time": 12460.71, "timestamp": "03:27:40", "text": "纯属胡说八道。永远不会厌倦"}, {"type": "subtitle", "time": 12463.269, "timestamp": "03:27:43", "text": "它。但是你知道，我觉得如果你去"}, {"type": "subtitle", "time": 12465.59, "timestamp": "03:27:45", "text": "深入研究之后，你最终会买入"}, {"type": "subtitle", "time": 12468.07, "timestamp": "03:27:48", "text": "迟早会发生。好奇心。杀死"}, {"type": "subtitle", "time": 12471.15, "timestamp": "03:27:51", "text": "猫咪那种感觉。"}, {"type": "subtitle", "time": 12473.91, "timestamp": "03:27:53", "text": "哦，L，我没事。我绝不会放手"}, {"type": "subtitle", "time": 12476.87, "timestamp": "03:27:56", "text": "我也遇到过这种情况。我是最理性的女孩"}, {"type": "subtitle", "time": 12479.19, "timestamp": "03:27:59", "text": "在世界上。唯一驱动力"}]
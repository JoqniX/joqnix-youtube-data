[{"type": "subtitle", "time": 16442.51, "timestamp": "04:34:02", "text": "哦"}, {"type": "subtitle", "time": 16446.31, "timestamp": "04:34:06", "text": "盈利模式已获批准。哦，哦哦。我们"}, {"type": "subtitle", "time": 16449.029, "timestamp": "04:34:09", "text": "他们不会被驱逐，因为他们都在"}, {"type": "subtitle", "time": 16451.23, "timestamp": "04:34:11", "text": "对我们来说。哦，那是"}, {"type": "subtitle", "time": 16453.59, "timestamp": "04:34:13", "text": "好的。那里。我不想有"}, {"type": "subtitle", "time": 16456.189, "timestamp": "04:34:16", "text": "涌上街头。"}, {"type": "subtitle", "time": 16458.709, "timestamp": "04:34:18", "text": "好的。这两颗药丸是什么？一"}, {"type": "subtitle", "time": 16460.789, "timestamp": "04:34:20", "text": "用于睡眠。不，一颗药丸就是"}, {"type": "subtitle", "time": 16462.551, "timestamp": "04:34:22", "text": "如果她喉咙痛，对男孩们来说就太难受了。"}, {"type": "subtitle", "time": 16463.82, "timestamp": "04:34:23", "text": "问题和"}, {"type": "subtitle", "time": 16468.429, "timestamp": "04:34:28", "text": "[音乐]"}, {"type": "subtitle", "time": 16471.269, "timestamp": "04:34:31", "text": "东西。我希望在 Pleasant 获得更多粉丝"}, {"type": "subtitle", "time": 16475.109, "timestamp": "04:34:35", "text": "钱。这太过分了。我需要"}, {"type": "subtitle", "time": 16478.269, "timestamp": "04:34:38", "text": "多云了。更多的。哦"}, {"type": "subtitle", "time": 16492.51, "timestamp": "04:34:52", "text": "[音乐]"}, {"type": "subtitle", "time": 16495.67, "timestamp": "04:34:55", "text": "红色的。我不在乎。"}]
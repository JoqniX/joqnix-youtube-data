[{"type": "subtitle", "time": 14463.79, "timestamp": "04:01:03", "text": "我做了"}, {"type": "subtitle", "time": 14468.99, "timestamp": "04:01:08", "text": "确实很……嗯，身体方面。等等，是"}, {"type": "subtitle", "time": 14472.309, "timestamp": "04:01:12", "text": "惊人的动作。没有人能感到满足"}, {"type": "subtitle", "time": 14474.07, "timestamp": "04:01:14", "text": "现在的我。等等，什么？你们都干了什么？"}, {"type": "subtitle", "time": 14475.55, "timestamp": "04:01:15", "text": "做？"}, {"type": "subtitle", "time": 14485.75, "timestamp": "04:01:25", "text": "这让我非常生气。他们是"}, {"type": "subtitle", "time": 14487.67, "timestamp": "04:01:27", "text": "讨论了一些事情，但他们仍然非常想"}, {"type": "subtitle", "time": 14491.389, "timestamp": "04:01:31", "text": "装作他们想装作他们是"}, {"type": "subtitle", "time": 14494.03, "timestamp": "04:01:34", "text": "热门词汇。"}, {"type": "subtitle", "time": 14496.87, "timestamp": "04:01:36", "text": "好吧，他们做什么？实际上，我没有。"}, {"type": "subtitle", "time": 14499.99, "timestamp": "04:01:39", "text": "我不明白你的意思？"}, {"type": "subtitle", "time": 14502.309, "timestamp": "04:01:42", "text": "好的，这样我就可以减少更多游戏时间了。"}, {"type": "subtitle", "time": 14505.11, "timestamp": "04:01:45", "text": "游戏之类的东西。等等，等等，等等，等等。不，"}]
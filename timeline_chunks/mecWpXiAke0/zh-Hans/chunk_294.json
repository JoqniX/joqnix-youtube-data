[{"type": "subtitle", "time": 17642.73, "timestamp": "04:54:02", "text": "后退。我回来了。我回来了。"}, {"type": "subtitle", "time": 17645.15, "timestamp": "04:54:05", "text": "[音乐]"}, {"type": "subtitle", "time": 17648.23, "timestamp": "04:54:08", "text": "小的。我一边把食物递给……"}, {"type": "subtitle", "time": 17649.868, "timestamp": "04:54:09", "text": "医生，"}, {"type": "subtitle", "time": 17652.59, "timestamp": "04:54:12", "text": "嗯，我有点"}, {"type": "subtitle", "time": 17656.23, "timestamp": "04:54:16", "text": "睡着了，结果弄得一团糟。所以，我不得不"}, {"type": "subtitle", "time": 17657.39, "timestamp": "04:54:17", "text": "清洁"}, {"type": "subtitle", "time": 17661.19, "timestamp": "04:54:21", "text": "向上。另外，我还带了些茶和一些"}, {"type": "subtitle", "time": 17664.07, "timestamp": "04:54:24", "text": "苹果。小苹果。是的，那会继续"}, {"type": "subtitle", "time": 17668.23, "timestamp": "04:54:28", "text": "我把我叫醒。那好吧。让我停下来，这样我就可以"}, {"type": "subtitle", "time": 17671.51, "timestamp": "04:54:31", "text": "我会尽力而为。好的。你好。拿这个"}, {"type": "subtitle", "time": 17674.23, "timestamp": "04:54:34", "text": "离开。"}, {"type": "subtitle", "time": 17676.27, "timestamp": "04:54:36", "text": "音乐是"}, {"type": "subtitle", "time": 17678.708, "timestamp": "04:54:38", "text": "蹦蹦跳跳。该死。这音乐太棒了。"}, {"type": "subtitle", "time": 17680.948, "timestamp": "04:54:40", "text": "是的。水力排水检查。是的。水合作用"}, {"type": "subtitle", "time": 17683.27, "timestamp": "04:54:43", "text": "检查每一个……哦，等等。说到这里，"}, {"type": "subtitle", "time": 17684.948, "timestamp": "04:54:44", "text": "我需要把水瓶装满。等等，等等，"}, {"type": "subtitle", "time": 17688.31, "timestamp": "04:54:48", "text": "等等，等等，等等，等等，等等。又来了。"}, {"type": "subtitle", "time": 17692.91, "timestamp": "04:54:52", "text": "我需要一个补充装瓶子。等待。一秒钟。"}, {"type": "subtitle", "time": 17695.7, "timestamp": "04:54:55", "text": "Y. 为什么会这样？"}, {"type": "subtitle", "time": 17698.27, "timestamp": "04:54:58", "text": "[音乐]"}]
[{"type": "subtitle", "time": 12302.15, "timestamp": "03:25:02", "text": "阶段性成果将表明保持……是件好事"}, {"type": "subtitle", "time": 12303.75, "timestamp": "03:25:03", "text": "保持规律的作息时间，但要坚持下去。"}, {"type": "subtitle", "time": 12305.59, "timestamp": "03:25:05", "text": "指令将改为在周二执行。"}, {"type": "subtitle", "time": 12307.91, "timestamp": "03:25:07", "text": "一个。当你看到问号时"}, {"type": "subtitle", "time": 12309.429, "timestamp": "03:25:09", "text": "这意味着你必须找到新的想法"}, {"type": "subtitle", "time": 12311.19, "timestamp": "03:25:11", "text": "使用该命令获取内容。什么时候"}, {"type": "subtitle", "time": 12312.389, "timestamp": "03:25:12", "text": "你现在感觉有点迷茫，对吧？"}, {"type": "subtitle", "time": 12314.55, "timestamp": "03:25:14", "text": "点击它。所以现在你只能制作"}, {"type": "subtitle", "time": 12316.79, "timestamp": "03:25:16", "text": "我晚上直播。这就是大多数人的感受。"}, {"type": "subtitle", "time": 12322.269, "timestamp": "03:25:22", "text": "人们都在上网。好的。那么，我们开始吧"}, {"type": "subtitle", "time": 12324.429, "timestamp": "03:25:24", "text": "呃，挂断"}, {"type": "subtitle", "time": 12333.229, "timestamp": "03:25:33", "text": "[音乐]"}, {"type": "subtitle", "time": 12335.67, "timestamp": "03:25:35", "text": "游戏。我已经尝试了好几个小时了。我可以吗？"}, {"type": "subtitle", "time": 12338.63, "timestamp": "03:25:38", "text": "打败这个boss了吗？或许我可以打败"}, {"type": "subtitle", "time": 12344.67, "timestamp": "03:25:44", "text": "我。是我。好吧，这是一件不错的武器。"}, {"type": "subtitle", "time": 12347.19, "timestamp": "03:25:47", "text": "玩。我正在逐渐掌握流媒体的技巧。"}, {"type": "subtitle", "time": 12348.87, "timestamp": "03:25:48", "text": "事物。所以，我想做个游戏实况。"}, {"type": "subtitle", "time": 12350.75, "timestamp": "03:25:50", "text": "我们开始吧"}, {"type": "subtitle", "time": 12353.83, "timestamp": "03:25:53", "text": "那。我们现在有了一个新想法"}, {"type": "subtitle", "time": 12357.469, "timestamp": "03:25:57", "text": "溪流。抛出怀旧的流。"}, {"type": "subtitle", "time": 12359.9, "timestamp": "03:25:59", "text": "好了，现在是晚上。"}]
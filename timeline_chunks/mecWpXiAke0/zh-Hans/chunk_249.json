[{"type": "subtitle", "time": 14943.03, "timestamp": "04:09:03", "text": "某物。哦，是啊，这是个好主意。"}, {"type": "subtitle", "time": 14944.63, "timestamp": "04:09:04", "text": "但说实话，我其实不太想。"}, {"type": "subtitle", "time": 14947.349, "timestamp": "04:09:07", "text": "去做这件事。好的。真让我生无可恋。"}, {"type": "subtitle", "time": 14950.15, "timestamp": "04:09:10", "text": "但正是苦难让我变得更加强大。"}, {"type": "subtitle", "time": 14952.55, "timestamp": "04:09:12", "text": "有趣的。所以，我想我得成为我"}, {"type": "subtitle", "time": 14955.429, "timestamp": "04:09:15", "text": "成为一名主播真的太难了。我的"}, {"type": "subtitle", "time": 14958.95, "timestamp": "04:09:18", "text": "黑暗的秘密过往。哦，"}, {"type": "subtitle", "time": 14963.389, "timestamp": "04:09:23", "text": "[音乐]"}, {"type": "subtitle", "time": 14965.309, "timestamp": "04:09:25", "text": "不。"}, {"type": "subtitle", "time": 14972.63, "timestamp": "04:09:32", "text": "黄昏。我并不是讨厌别人问我这个问题。"}, {"type": "subtitle", "time": 14974.389, "timestamp": "04:09:34", "text": "跟他们合作什么的，但我"}, {"type": "subtitle", "time": 14976.51, "timestamp": "04:09:36", "text": "总是忘记回复"}, {"type": "subtitle", "time": 14987.229, "timestamp": "04:09:47", "text": "这是爱"}, {"type": "subtitle", "time": 14990.51, "timestamp": "04:09:50", "text": "永远。再说几遍。爱"}, {"type": "subtitle", "time": 14994.63, "timestamp": "04:09:54", "text": "永远。永远相爱。永远相爱。"}, {"type": "subtitle", "time": 14996.67, "timestamp": "04:09:56", "text": "给我"}]
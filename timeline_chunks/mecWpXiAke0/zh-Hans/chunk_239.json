[{"type": "subtitle", "time": 14341.189, "timestamp": "03:59:01", "text": "上帝。她哭了吗？你刚才哭了吗？"}, {"type": "subtitle", "time": 14344.3, "timestamp": "03:59:04", "text": "某物？不。对。"}, {"type": "subtitle", "time": 14357.18, "timestamp": "03:59:17", "text": "永远"}, {"type": "subtitle", "time": 14360.67, "timestamp": "03:59:20", "text": "[音乐]"}, {"type": "subtitle", "time": 14364.309, "timestamp": "03:59:24", "text": "睡觉。我该给她吗？好的，我们开始吧"}, {"type": "subtitle", "time": 14367.11, "timestamp": "03:59:27", "text": "感受她的情感和压力。她的压力"}, {"type": "subtitle", "time": 14369.15, "timestamp": "03:59:29", "text": "到处都是"}, {"type": "subtitle", "time": 14378.15, "timestamp": "03:59:38", "text": "[音乐]"}, {"type": "subtitle", "time": 14380.99, "timestamp": "03:59:40", "text": "我需要想办法让它发生"}, {"type": "subtitle", "time": 14385.07, "timestamp": "03:59:45", "text": "向下。这是什么？哈希塔克哈希"}, {"type": "subtitle", "time": 14388.11, "timestamp": "03:59:48", "text": "哈希爱就在其中"}, {"type": "subtitle", "time": 14391.71, "timestamp": "03:59:51", "text": "空气。这是什么？压力"}, {"type": "subtitle", "time": 14395.389, "timestamp": "03:59:55", "text": "46. 职业"}]
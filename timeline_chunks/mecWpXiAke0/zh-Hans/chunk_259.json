[{"type": "subtitle", "time": 15544.149, "timestamp": "04:19:04", "text": "等等，但是又只有一点点"}, {"type": "subtitle", "time": 15547.389, "timestamp": "04:19:07", "text": "稍微往左一点，对吧？我认为是"}, {"type": "subtitle", "time": 15550.55, "timestamp": "04:19:10", "text": "美好的。她的精神状态很重要，对吧？"}, {"type": "subtitle", "time": 15552.429, "timestamp": "04:19:12", "text": "在"}, {"type": "subtitle", "time": 15560.83, "timestamp": "04:19:20", "text": "知道。 77. 这是一件大事"}, {"type": "subtitle", "time": 15565.0, "timestamp": "04:19:25", "text": "数字。 71. 好吧，行。我会做这件事。"}, {"type": "subtitle", "time": 15570.229, "timestamp": "04:19:30", "text": "[音乐]"}, {"type": "subtitle", "time": 15573.67, "timestamp": "04:19:33", "text": "主要是指你的精神状态如何"}, {"type": "subtitle", "time": 15580.07, "timestamp": "04:19:40", "text": "正确的？我喜欢，我觉得我要……"}, {"type": "subtitle", "time": 15581.389, "timestamp": "04:19:41", "text": "我的漏水了"}, {"type": "subtitle", "time": 15586.32, "timestamp": "04:19:46", "text": "头部也一样。我的天啊。再见。"}, {"type": "subtitle", "time": 15593.349, "timestamp": "04:19:53", "text": "我本来想在我的……里这么做的，但是哇"}, {"type": "subtitle", "time": 15595.03, "timestamp": "04:19:55", "text": "我的衣服穿起来挺舒服的。我"}, {"type": "subtitle", "time": 15597.79, "timestamp": "04:19:57", "text": "我觉得继续下去应该没问题。"}]
[{"type": "subtitle", "time": 13981.87, "timestamp": "03:53:01", "text": "那对他/她来说很不好"}, {"type": "subtitle", "time": 13985.95, "timestamp": "03:53:05", "text": "我。串流某些复古游戏并不好。"}, {"type": "subtitle", "time": 13994.87, "timestamp": "03:53:14", "text": "好的。我的意思是，人们将无法……"}, {"type": "subtitle", "time": 13996.79, "timestamp": "03:53:16", "text": "你看到了她的私人账号吧？因为是"}, {"type": "subtitle", "time": 14001.389, "timestamp": "03:53:21", "text": "私有。实际上没有人能看到它。"}, {"type": "subtitle", "time": 14003.63, "timestamp": "03:53:23", "text": "正确的？我想那就是"}, {"type": "subtitle", "time": 14013.79, "timestamp": "03:53:33", "text": "好的。我正在上菜，萨尔。"}, {"type": "subtitle", "time": 14015.56, "timestamp": "03:53:35", "text": "好的。哦，我的"}, {"type": "subtitle", "time": 14017.469, "timestamp": "03:53:37", "text": "[音乐]"}, {"type": "subtitle", "time": 14031.03, "timestamp": "03:53:51", "text": "不，我想你会的。不，不是那个。"}, {"type": "subtitle", "time": 14032.63, "timestamp": "03:53:52", "text": "我想你会的，但如果你出轨的话"}, {"type": "subtitle", "time": 14035.22, "timestamp": "03:53:55", "text": "我会杀了你。哦，我的"}, {"type": "subtitle", "time": 14039.229, "timestamp": "03:53:59", "text": "[音乐]"}]
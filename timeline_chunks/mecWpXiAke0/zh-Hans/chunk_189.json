[{"type": "subtitle", "time": 11342.99, "timestamp": "03:09:02", "text": "游戏。我相信我已经快完成了"}, {"type": "subtitle", "time": 11352.79, "timestamp": "03:09:12", "text": "它。我变成这样都是我的错。"}, {"type": "subtitle", "time": 11355.91, "timestamp": "03:09:15", "text": "做事耽搁了。所以，我"}, {"type": "subtitle", "time": 11357.99, "timestamp": "03:09:17", "text": "再次道歉。"}, {"type": "subtitle", "time": 11361.03, "timestamp": "03:09:21", "text": "但我们回来了。我们换个场景"}, {"type": "subtitle", "time": 11365.389, "timestamp": "03:09:25", "text": "然后我们开始玩游戏。我们开始吧"}, {"type": "subtitle", "time": 11369.269, "timestamp": "03:09:29", "text": "去。这是尼迪·谢雷亚，我们的主。和"}, {"type": "subtitle", "time": 11372.23, "timestamp": "03:09:32", "text": "圣诞节期间我们会关掉音乐。"}, {"type": "subtitle", "time": 11376.63, "timestamp": "03:09:36", "text": "为贫困者创作的音乐，海上流星音乐。"}, {"type": "subtitle", "time": 11379.91, "timestamp": "03:09:39", "text": "这是一首非常可爱好听的音乐"}, {"type": "subtitle", "time": 11385.19, "timestamp": "03:09:45", "text": "有。这游戏的音乐真不错。"}, {"type": "subtitle", "time": 11390.71, "timestamp": "03:09:50", "text": "我不知道你们是否对……感兴趣"}, {"type": "subtitle", "time": 11391.79, "timestamp": "03:09:51", "text": "类型但"}, {"type": "subtitle", "time": 11395.19, "timestamp": "03:09:55", "text": "是的，游戏设定在一个……的世界"}, {"type": "subtitle", "time": 11398.469, "timestamp": "03:09:58", "text": "现代日本，但也不完全是任何日本"}]
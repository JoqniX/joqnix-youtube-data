[{"type": "subtitle", "time": 21540.31, "timestamp": "05:59:00", "text": "好的。接下来，我们做了这件事。这并没有"}, {"type": "subtitle", "time": 21541.99, "timestamp": "05:59:01", "text": "锻炼。所以，一起待着吧。我不会这样做"}, {"type": "subtitle", "time": 21543.788, "timestamp": "05:59:03", "text": "悬挂"}, {"type": "subtitle", "time": 21547.15, "timestamp": "05:59:07", "text": "出去。相反，我将"}, {"type": "subtitle", "time": 21554.35, "timestamp": "05:59:14", "text": "这。睡到"}, {"type": "subtitle", "time": 21556.868, "timestamp": "05:59:16", "text": "明天。我想把这个送给她。"}]
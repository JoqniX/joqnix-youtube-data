[{"type": "subtitle", "time": 13683.349, "timestamp": "03:48:03", "text": "萝莉天使你最喜欢的守门员哥特"}, {"type": "subtitle", "time": 13687.429, "timestamp": "03:48:07", "text": "天使之家，为了我的美人。哟"}, {"type": "subtitle", "time": 13693.34, "timestamp": "03:48:13", "text": "GF。"}, {"type": "subtitle", "time": 13694.99, "timestamp": "03:48:14", "text": "[音乐]"}, {"type": "subtitle", "time": 13702.99, "timestamp": "03:48:22", "text": "我买了一些衣服。然后我去了"}, {"type": "subtitle", "time": 13705.87, "timestamp": "03:48:25", "text": "购买我的一天"}, {"type": "subtitle", "time": 13709.469, "timestamp": "03:48:29", "text": "我想去"}, {"type": "subtitle", "time": 13712.71, "timestamp": "03:48:32", "text": "太男人了。如果我是一个外向的人，不"}, {"type": "subtitle", "time": 13714.95, "timestamp": "03:48:34", "text": "嗯，我本来会买很多东西的。"}, {"type": "subtitle", "time": 13716.75, "timestamp": "03:48:36", "text": "并为……做了些事"}, {"type": "subtitle", "time": 13719.189, "timestamp": "03:48:39", "text": "溪流。做个内向的人真难受"}, {"type": "subtitle", "time": 13727.229, "timestamp": "03:48:47", "text": "[音乐]"}, {"type": "subtitle", "time": 13730.79, "timestamp": "03:48:50", "text": "所以，你愿意和我约会吗？"}, {"type": "subtitle", "time": 13733.269, "timestamp": "03:48:53", "text": "问号。他人。我的天啊。"}, {"type": "subtitle", "time": 13735.83, "timestamp": "03:48:55", "text": "不，你永远不可能和她一起去。"}, {"type": "subtitle", "time": 13736.59, "timestamp": "03:48:56", "text": "和"}, {"type": "subtitle", "time": 13739.63, "timestamp": "03:48:59", "text": "她知道自己是什么样的人。"}]
[{"type": "subtitle", "time": 15901.91, "timestamp": "04:25:01", "text": "你们都查看我的私信了吗？都无视我了？我"}, {"type": "subtitle", "time": 15904.149, "timestamp": "04:25:04", "text": "我在看着你。我打算花"}, {"type": "subtitle", "time": 15906.67, "timestamp": "04:25:06", "text": "全部"}, {"type": "subtitle", "time": 15909.269, "timestamp": "04:25:09", "text": "超级大使馆提供更多高"}, {"type": "subtitle", "time": 15915.67, "timestamp": "04:25:15", "text": "是的。呃，你好吗？大家好！"}, {"type": "subtitle", "time": 15918.95, "timestamp": "04:25:18", "text": "你们这些书呆子，滚开！感恩"}, {"type": "subtitle", "time": 15920.87, "timestamp": "04:25:20", "text": "阅读。你正在计算这一点"}, {"type": "subtitle", "time": 15922.63, "timestamp": "04:25:22", "text": "全世界的人都知道我的名字。"}, {"type": "subtitle", "time": 15926.67, "timestamp": "04:25:26", "text": "请继续支持我。这真是太"}, {"type": "subtitle", "time": 15929.51, "timestamp": "04:25:29", "text": "可爱的。我想喜欢它，或者"}, {"type": "subtitle", "time": 15935.55, "timestamp": "04:25:35", "text": "[音乐]"}, {"type": "subtitle", "time": 15938.87, "timestamp": "04:25:38", "text": "某物。我的天哪。哦，不。哦，不。哦，不。"}, {"type": "subtitle", "time": 15940.63, "timestamp": "04:25:40", "text": "哦，不。哦，不。哦，不。哦，不。哦，不。哦"}, {"type": "subtitle", "time": 15948.99, "timestamp": "04:25:48", "text": "它是"}, {"type": "subtitle", "time": 15956.389, "timestamp": "04:25:56", "text": "自毁。嘿，割伤我。快点。"}, {"type": "subtitle", "time": 15958.99, "timestamp": "04:25:58", "text": "别害怕。等待。"}]
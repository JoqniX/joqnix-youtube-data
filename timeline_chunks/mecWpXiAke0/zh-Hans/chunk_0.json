[{"type": "subtitle", "time": 5.749, "timestamp": "00:00:05", "text": "好了，我想我们应该到了。我"}, {"type": "subtitle", "time": 8.03, "timestamp": "00:00:08", "text": "希望如此"}, {"type": "subtitle", "time": 11.87, "timestamp": "00:00:11", "text": "居住。是的，我们正在直播。好，好"}, {"type": "subtitle", "time": 16.31, "timestamp": "00:00:16", "text": "好的。欢迎来到 Joathon 第 20 天"}, {"type": "subtitle", "time": 19.349, "timestamp": "00:00:19", "text": "36，抱歉。呃，第36天，第二部分直播，"}, {"type": "subtitle", "time": 22.07, "timestamp": "00:00:22", "text": "夜溪。我知道我们应该"}, {"type": "subtitle", "time": 24.79, "timestamp": "00:00:24", "text": "大约这个时候应该早睡，但是"}, {"type": "subtitle", "time": 28.55, "timestamp": "00:00:28", "text": "我们12点睡觉。我会直播。"}, {"type": "subtitle", "time": 31.429, "timestamp": "00:00:31", "text": "从今天起，比利比利"}, {"type": "subtitle", "time": 35.03, "timestamp": "00:00:35", "text": "今晚。我们将测试我的电脑是否可以"}, {"type": "subtitle", "time": 38.069, "timestamp": "00:00:38", "text": "处理好一切。所以，我们将"}, {"type": "subtitle", "time": 39.869, "timestamp": "00:00:39", "text": "这样做是为了"}, {"type": "subtitle", "time": 44.389, "timestamp": "00:00:44", "text": "现在。好的，我们暂时就先这样吧。"}, {"type": "subtitle", "time": 46.029, "timestamp": "00:00:46", "text": "希望如此。"}, {"type": "subtitle", "time": 48.83, "timestamp": "00:00:48", "text": "出色地。"}, {"type": "subtitle", "time": 51.91, "timestamp": "00:00:51", "text": "我希望大家都……"}, {"type": "subtitle", "time": 54.83, "timestamp": "00:00:54", "text": "已成功重定向到最新页面"}, {"type": "subtitle", "time": 58.389, "timestamp": "00:00:58", "text": "溪流。我忘了，我忘了"}]
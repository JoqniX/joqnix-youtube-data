[{"type": "subtitle", "time": 21126.03, "timestamp": "05:52:06", "text": "[音乐]"}, {"type": "subtitle", "time": 21128.948, "timestamp": "05:52:08", "text": "降低。谢谢妈妈生了我。"}, {"type": "subtitle", "time": 21131.27, "timestamp": "05:52:11", "text": "会变得很大。我能感觉到你"}, {"type": "subtitle", "time": 21146.55, "timestamp": "05:52:26", "text": "什么？直接去山下。安德希尔"}, {"type": "subtitle", "time": 21155.788, "timestamp": "05:52:35", "text": "[音乐]"}, {"type": "subtitle", "time": 21158.39, "timestamp": "05:52:38", "text": "意义。你让我笑了好久。"}, {"type": "subtitle", "time": 21161.34, "timestamp": "05:52:41", "text": "我人生中第一次。"}, {"type": "subtitle", "time": 21178.948, "timestamp": "05:52:58", "text": "没什么特别的含义，但我就是这么说的。"}]
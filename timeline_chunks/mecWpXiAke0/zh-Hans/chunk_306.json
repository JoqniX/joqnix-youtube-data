[{"type": "subtitle", "time": 18365.15, "timestamp": "05:06:05", "text": "[音乐]"}, {"type": "subtitle", "time": 18367.75, "timestamp": "05:06:07", "text": "好吧，感觉就像我爸爸在打电话。哦，我的"}, {"type": "subtitle", "time": 18369.08, "timestamp": "05:06:09", "text": "上帝。"}, {"type": "subtitle", "time": 18398.23, "timestamp": "05:06:38", "text": "什么？晚安，我的甜心天使。我会"}, {"type": "subtitle", "time": 18399.99, "timestamp": "05:06:39", "text": "祈祷有一天能见到你。我爱"}, {"type": "subtitle", "time": 18400.91, "timestamp": "05:06:40", "text": "你"}, {"type": "subtitle", "time": 18408.11, "timestamp": "05:06:48", "text": "全部。愚蠢的人打败了愚蠢的树枝，所以肯定"}, {"type": "subtitle", "time": 18415.07, "timestamp": "05:06:55", "text": "上帝。太高了"}, {"type": "subtitle", "time": 18419.27, "timestamp": "05:06:59", "text": "血滤过。我只有我自己。"}]
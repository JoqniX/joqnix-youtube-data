[{"type": "subtitle", "time": 16620.99, "timestamp": "04:37:00", "text": "是的，拿"}, {"type": "subtitle", "time": 16627.551, "timestamp": "04:37:07", "text": "[音乐]"}, {"type": "subtitle", "time": 16630.07, "timestamp": "04:37:10", "text": "附言你没有忘记我的私信。是的。该死"}, {"type": "subtitle", "time": 16633.91, "timestamp": "04:37:13", "text": "你。我忘了。你忘了"}, {"type": "subtitle", "time": 16636.47, "timestamp": "04:37:16", "text": "真的会回复吗？你的回复是什么意思？"}, {"type": "subtitle", "time": 16644.869, "timestamp": "04:37:24", "text": "嗯？我应该做些什么吗？"}, {"type": "subtitle", "time": 16647.089, "timestamp": "04:37:27", "text": "这些"}, {"type": "subtitle", "time": 16648.83, "timestamp": "04:37:28", "text": "[音乐]"}]
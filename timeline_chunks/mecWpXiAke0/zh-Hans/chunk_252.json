[{"type": "subtitle", "time": 15122.95, "timestamp": "04:12:02", "text": "流媒体。压力水平是"}, {"type": "subtitle", "time": 15135.269, "timestamp": "04:12:15", "text": "害怕的。我在想，或许我得玩玩。"}, {"type": "subtitle", "time": 15137.91, "timestamp": "04:12:17", "text": "打麻将，这样我就可以直播，这样我就可以记住"}, {"type": "subtitle", "time": 15146.75, "timestamp": "04:12:26", "text": "某个时候。它是"}, {"type": "subtitle", "time": 15151.79, "timestamp": "04:12:31", "text": "好的。但我很抱歉。来"}, {"type": "subtitle", "time": 15159.389, "timestamp": "04:12:39", "text": "[音乐]"}, {"type": "subtitle", "time": 15161.83, "timestamp": "04:12:41", "text": "对不起。我的天哪。她没有回应。"}, {"type": "subtitle", "time": 15164.87, "timestamp": "04:12:44", "text": "后退。我的天啊。你呢？我也是"}, {"type": "subtitle", "time": 15167.11, "timestamp": "04:12:47", "text": "做好事。我也遇到了同样的问题。正在做"}]
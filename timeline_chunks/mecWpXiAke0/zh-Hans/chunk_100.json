[{"type": "subtitle", "time": 6009.07, "timestamp": "01:40:09", "text": "[音乐]"}, {"type": "subtitle", "time": 6011.669, "timestamp": "01:40:11", "text": "这？快点。快点。快点。来"}, {"type": "subtitle", "time": 6023.189, "timestamp": "01:40:23", "text": "但是，是的，我相信我的维多利亚的秘密是"}, {"type": "subtitle", "time": 6025.629, "timestamp": "01:40:25", "text": "上传于呃"}, {"type": "subtitle", "time": 6029.79, "timestamp": "01:40:29", "text": "可信的。嗯，让我再说一遍"}, {"type": "subtitle", "time": 6047.149, "timestamp": "01:40:47", "text": "因为我确实上传了"}, {"type": "subtitle", "time": 6050.43, "timestamp": "01:40:50", "text": "昨天的乔森"}, {"type": "subtitle", "time": 6053.629, "timestamp": "01:40:53", "text": "33. 等等，"}]
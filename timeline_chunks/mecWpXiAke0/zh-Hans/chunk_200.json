[{"type": "subtitle", "time": 12000.63, "timestamp": "03:20:00", "text": "入门。我至少需要一个"}, {"type": "subtitle", "time": 12002.309, "timestamp": "03:20:02", "text": "本月起，将吸引数百万粉丝。这"}, {"type": "subtitle", "time": 12006.07, "timestamp": "03:20:06", "text": "需要审批。什么？我的天啊。"}, {"type": "subtitle", "time": 12008.63, "timestamp": "03:20:08", "text": "一个月内就能搞定。"}, {"type": "subtitle", "time": 12010.469, "timestamp": "03:20:10", "text": "我受到了很大的鼓舞。让我们来制作"}, {"type": "subtitle", "time": 12013.63, "timestamp": "03:20:13", "text": "本月统计。圣"}, {"type": "subtitle", "time": 12015.99, "timestamp": "03:20:15", "text": "什么？如果你是世界上最大的流媒体用户，"}, {"type": "subtitle", "time": 12018.95, "timestamp": "03:20:18", "text": "大家一起合作，对吧？我的天啊。"}, {"type": "subtitle", "time": 12019.71, "timestamp": "03:20:19", "text": "绝不"}, {"type": "subtitle", "time": 12033.99, "timestamp": "03:20:33", "text": "可能的。这取决于努力程度"}, {"type": "subtitle", "time": 12035.79, "timestamp": "03:20:35", "text": "以及你的奉献精神"}, {"type": "subtitle", "time": 12038.309, "timestamp": "03:20:38", "text": "做。我真心希望我们能成功。"}, {"type": "subtitle", "time": 12040.03, "timestamp": "03:20:40", "text": "指望"}, {"type": "subtitle", "time": 12043.19, "timestamp": "03:20:43", "text": "你。我现在唯一能做的就是给予"}, {"type": "subtitle", "time": 12045.67, "timestamp": "03:20:45", "text": "她需要动力去做她该做的事"}, {"type": "subtitle", "time": 12048.229, "timestamp": "03:20:48", "text": "最好的。如果你也打我，我可能也会碎。"}, {"type": "subtitle", "time": 12049.99, "timestamp": "03:20:49", "text": "难的。但当这种情况发生时，我们可以"}, {"type": "subtitle", "time": 12051.07, "timestamp": "03:20:51", "text": "摧毁"}, {"type": "subtitle", "time": 12053.11, "timestamp": "03:20:53", "text": "互联网。你说的摧毁是什么意思？"}, {"type": "subtitle", "time": 12055.59, "timestamp": "03:20:55", "text": "互联网？那确实很可怕。是的。"}, {"type": "subtitle", "time": 12059.07, "timestamp": "03:20:59", "text": "你好。你好，拉桑。你好。你好吗"}]
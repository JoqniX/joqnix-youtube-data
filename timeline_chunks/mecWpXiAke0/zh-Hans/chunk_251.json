[{"type": "subtitle", "time": 15060.469, "timestamp": "04:11:00", "text": "成为全球大人物或成为全球不可或缺的人物"}, {"type": "subtitle", "time": 15062.95, "timestamp": "04:11:02", "text": "任何。实际上我陷进去了，所以我就结束了"}, {"type": "subtitle", "time": 15065.51, "timestamp": "04:11:05", "text": "甚至会不吃饭之类的。好的，你"}, {"type": "subtitle", "time": 15067.03, "timestamp": "04:11:07", "text": "最近知道很多人"}, {"type": "subtitle", "time": 15068.87, "timestamp": "04:11:08", "text": "就像他们拥有权力的地方一样"}, {"type": "subtitle", "time": 15070.63, "timestamp": "04:11:10", "text": "统治世界，甚至减少"}, {"type": "subtitle", "time": 15073.189, "timestamp": "04:11:13", "text": "人口等等，还有一些人"}, {"type": "subtitle", "time": 15074.87, "timestamp": "04:11:14", "text": "我也真心相信那就是事实。"}, {"type": "subtitle", "time": 15076.469, "timestamp": "04:11:16", "text": "我们世界中发生的这些事情构成了这些。"}, {"type": "subtitle", "time": 15080.07, "timestamp": "04:11:20", "text": "野蛮的恶魔将他们的怒火指向"}, {"type": "subtitle", "time": 15081.91, "timestamp": "04:11:21", "text": "不过我觉得玩玩看比较好"}, {"type": "subtitle", "time": 15083.59, "timestamp": "04:11:23", "text": "在我们所处的时代，这并不奇怪。"}, {"type": "subtitle", "time": 15085.75, "timestamp": "04:11:25", "text": "人们希望某人或某事成为"}, {"type": "subtitle", "time": 15088.389, "timestamp": "04:11:28", "text": "虽然生气，但我们都应该努力工作。"}, {"type": "subtitle", "time": 15090.15, "timestamp": "04:11:30", "text": "请大家一起努力，这是我唯一的愿望。"}, {"type": "subtitle", "time": 15091.07, "timestamp": "04:11:31", "text": "指标"}, {"type": "subtitle", "time": 15093.269, "timestamp": "04:11:33", "text": "天使。那很好，对吧？就是这样。"}, {"type": "subtitle", "time": 15095.189, "timestamp": "04:11:35", "text": "嗯，我打算先保存下来，看看效果如何。"}, {"type": "subtitle", "time": 15097.91, "timestamp": "04:11:37", "text": "是溪流，对吧？它们是我的小宝贝"}, {"type": "subtitle", "time": 15100.59, "timestamp": "04:11:40", "text": "豚鼠。哦，我的"}, {"type": "subtitle", "time": 15105.63, "timestamp": "04:11:45", "text": "上帝。 30年后，只剩下一个女孩。哦，我的"}]
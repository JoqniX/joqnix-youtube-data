[{"type": "subtitle", "time": 9481.51, "timestamp": "02:38:01", "text": "生日在八月。所以我很兴奋"}, {"type": "subtitle", "time": 9484.71, "timestamp": "02:38:04", "text": "在Billy Billy上直播我的生日吧"}, {"type": "subtitle", "time": 9487.59, "timestamp": "02:38:07", "text": "你和一些东西。我们会有一个，我会有一个"}, {"type": "subtitle", "time": 9490.87, "timestamp": "02:38:10", "text": "比利·比利有限流"}, {"type": "subtitle", "time": 9492.11, "timestamp": "02:38:12", "text": "独家的"}, {"type": "subtitle", "time": 9494.469, "timestamp": "02:38:14", "text": "溪流。是的，在那之前就是这样。"}, {"type": "subtitle", "time": 9497.83, "timestamp": "02:38:17", "text": "目前支持多路复用。我已获得许可"}, {"type": "subtitle", "time": 9518.15, "timestamp": "02:38:38", "text": "好的。让我去卖点糖果。我 我"}, {"type": "subtitle", "time": 9520.63, "timestamp": "02:38:40", "text": "我应该……吗？我想我不应该说毒品。我"}, {"type": "subtitle", "time": 9522.95, "timestamp": "02:38:42", "text": "可能会被封禁。我必须小心。"}, {"type": "subtitle", "time": 9525.349, "timestamp": "02:38:45", "text": "是威利·比利。我甚至不知道是否"}, {"type": "subtitle", "time": 9534.67, "timestamp": "02:38:54", "text": "可被禁止。我是36号球衣的粉丝。感谢"}, {"type": "subtitle", "time": 9538.349, "timestamp": "02:38:58", "text": "你。谢谢。哦，那是"}]
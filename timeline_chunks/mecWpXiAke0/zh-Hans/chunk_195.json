[{"type": "subtitle", "time": 11707.229, "timestamp": "03:15:07", "text": "特点。这"}, {"type": "subtitle", "time": 11715.07, "timestamp": "03:15:15", "text": "转变。我们开始吧"}, {"type": "subtitle", "time": 11725.11, "timestamp": "03:15:25", "text": "令人恼火的评论和鞋子颜色"}, {"type": "subtitle", "time": 11726.6, "timestamp": "03:15:26", "text": "评论超级棒"}, {"type": "subtitle", "time": 11727.79, "timestamp": "03:15:27", "text": "[音乐]"}, {"type": "subtitle", "time": 11730.67, "timestamp": "03:15:30", "text": "机会。哦等等，我没读过"}, {"type": "subtitle", "time": 11735.309, "timestamp": "03:15:35", "text": "它。嘿，小猫咪，问候真好"}, {"type": "subtitle", "time": 11739.59, "timestamp": "03:15:39", "text": "这里。我的天啊，我竟然一晚上都在看。"}, {"type": "subtitle", "time": 11741.07, "timestamp": "03:15:41", "text": "就是这样。"}, {"type": "subtitle", "time": 11744.83, "timestamp": "03:15:44", "text": "真的，那真是……"}, {"type": "subtitle", "time": 11749.59, "timestamp": "03:15:49", "text": "哇。是的。你好，Yan。你好吗？"}, {"type": "subtitle", "time": 11751.67, "timestamp": "03:15:51", "text": "你真是太混蛋了。哦，我应该删除吗？"}, {"type": "subtitle", "time": 11759.79, "timestamp": "03:15:59", "text": "五、删除"}]
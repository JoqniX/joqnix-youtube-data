[{"type": "subtitle", "time": 18846.43, "timestamp": "05:14:06", "text": "胡说，我现在很好。"}, {"type": "subtitle", "time": 18861.59, "timestamp": "05:14:21", "text": "但我不太确定我的脸有多可爱"}, {"type": "subtitle", "time": 18863.19, "timestamp": "05:14:23", "text": "谈论这件事。接下来，我们将采取以下措施"}, {"type": "subtitle", "time": 18866.31, "timestamp": "05:14:26", "text": "关键步骤。所以，只要它不"}, {"type": "subtitle", "time": 18867.708, "timestamp": "05:14:27", "text": "杀"}, {"type": "subtitle", "time": 18871.23, "timestamp": "05:14:31", "text": "对我来说是这样，但如果你是……"}, {"type": "subtitle", "time": 18879.51, "timestamp": "05:14:39", "text": "主播。哦，不。"}, {"type": "subtitle", "time": 18890.11, "timestamp": "05:14:50", "text": "[音乐]"}, {"type": "subtitle", "time": 18892.27, "timestamp": "05:14:52", "text": "之后"}]
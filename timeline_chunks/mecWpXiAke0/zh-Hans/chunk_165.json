[{"type": "subtitle", "time": 9922.79, "timestamp": "02:45:22", "text": "这15公里。我的天啊。我的经销商是"}, {"type": "subtitle", "time": 9926.75, "timestamp": "02:45:26", "text": "我的经销商们现在生意兴隆。"}, {"type": "subtitle", "time": 9931.79, "timestamp": "02:45:31", "text": "哇。该死。该死。我的天哪。"}, {"type": "subtitle", "time": 9933.86, "timestamp": "02:45:33", "text": "好的。呃，"}, {"type": "subtitle", "time": 9935.389, "timestamp": "02:45:35", "text": "[音乐]"}]
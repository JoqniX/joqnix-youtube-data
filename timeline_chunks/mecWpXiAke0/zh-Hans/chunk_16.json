[{"type": "subtitle", "time": 960.47, "timestamp": "00:16:00", "text": "这？现场直播。哦，他们有"}, {"type": "subtitle", "time": 965.389, "timestamp": "00:16:05", "text": "对第三方的集成支持"}, {"type": "subtitle", "time": 968.6, "timestamp": "00:16:08", "text": "应用程序。哇。"}, {"type": "subtitle", "time": 979.189, "timestamp": "00:16:19", "text": "什么？来自“What”的综合支持"}, {"type": "subtitle", "time": 979.72, "timestamp": "00:16:19", "text": "这"}, {"type": "subtitle", "time": 980.829, "timestamp": "00:16:20", "text": "[音乐]"}, {"type": "subtitle", "time": 992.47, "timestamp": "00:16:32", "text": "抽搐。他们没有监控“好的，我”。"}, {"type": "subtitle", "time": 998.59, "timestamp": "00:16:38", "text": "声音的。"}, {"type": "subtitle", "time": 1008.949, "timestamp": "00:16:48", "text": "我的天哪，这简直太棒了！"}, {"type": "subtitle", "time": 1011.069, "timestamp": "00:16:51", "text": "有"}, {"type": "subtitle", "time": 1019.91, "timestamp": "00:16:59", "text": "该死，这激励我做到最好"}]
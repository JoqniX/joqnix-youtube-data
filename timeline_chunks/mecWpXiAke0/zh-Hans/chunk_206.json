[{"type": "subtitle", "time": 12373.07, "timestamp": "03:26:13", "text": "走到黄昏。"}, {"type": "subtitle", "time": 12375.75, "timestamp": "03:26:15", "text": "他们说没有钱买不到的"}, {"type": "subtitle", "time": 12377.429, "timestamp": "03:26:17", "text": "幸福，但幸福并不是……"}, {"type": "subtitle", "time": 12383.87, "timestamp": "03:26:23", "text": "生活。呃"}, {"type": "subtitle", "time": 12387.71, "timestamp": "03:26:27", "text": "药物名称 过去服用的药片 1"}, {"type": "subtitle", "time": 12393.95, "timestamp": "03:26:33", "text": "每天服用两片，可使用户平静下来"}, {"type": "subtitle", "time": 12397.75, "timestamp": "03:26:37", "text": "向下。等等，每天服用两片。所以"}, {"type": "subtitle", "time": 12401.51, "timestamp": "03:26:41", "text": "甚至，不，我不应该接受它。我"}, {"type": "subtitle", "time": 12403.19, "timestamp": "03:26:43", "text": "拿一些。呃，这让我感觉有点……"}, {"type": "subtitle", "time": 12405.75, "timestamp": "03:26:45", "text": "如果吃太多的话会感觉飘飘然。好的，"}, {"type": "subtitle", "time": 12408.469, "timestamp": "03:26:48", "text": "那我应该接受吗？我会接受"}, {"type": "subtitle", "time": 12410.309, "timestamp": "03:26:50", "text": "早晚。这样好多了。所以"}, {"type": "subtitle", "time": 12412.87, "timestamp": "03:26:52", "text": "我不会玩社交媒体。我们走吧"}, {"type": "subtitle", "time": 12418.51, "timestamp": "03:26:58", "text": "叽叽喳喳。遇见你时，你看上去像个……"}]
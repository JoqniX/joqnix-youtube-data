[{"type": "subtitle", "time": 1026.949, "timestamp": "00:17:06", "text": "男人。他们的系统真的很棒。"}, {"type": "subtitle", "time": 1028.549, "timestamp": "00:17:08", "text": "这是他们的现场直播。"}, {"type": "subtitle", "time": 1035.909, "timestamp": "00:17:15", "text": "观众席和现场互动"}, {"type": "subtitle", "time": 1037.789, "timestamp": "00:17:17", "text": "评论"}, {"type": "subtitle", "time": 1040.429, "timestamp": "00:17:20", "text": "以及什么是"}, {"type": "subtitle", "time": 1043.829, "timestamp": "00:17:23", "text": "这？视线直播"}, {"type": "subtitle", "time": 1046.949, "timestamp": "00:17:26", "text": "工具带我玩开放广播器"}, {"type": "subtitle", "time": 1050.19, "timestamp": "00:17:30", "text": "设置。哦，广播员"}, {"type": "subtitle", "time": 1059.75, "timestamp": "00:17:39", "text": "恢复率、比特率、帧速率。嗯，"}, {"type": "subtitle", "time": 1062.63, "timestamp": "00:17:42", "text": "编码级别：低、中、高。好的，"}, {"type": "subtitle", "time": 1064.51, "timestamp": "00:17:44", "text": "我可以做到"}, {"type": "subtitle", "time": 1072.35, "timestamp": "00:17:52", "text": "实际上。"}, {"type": "subtitle", "time": 1075.75, "timestamp": "00:17:55", "text": "嗯，等等，我得查一下那些是什么。"}, {"type": "subtitle", "time": 1079.07, "timestamp": "00:17:59", "text": "设置如下。它就像一个虚拟的"}]
[{"type": "subtitle", "time": 20820.628, "timestamp": "05:47:00", "text": "从互联网开始的有很多"}, {"type": "subtitle", "time": 20824.23, "timestamp": "05:47:04", "text": "尽情玩乐，无拘无束。我爱我"}, {"type": "subtitle", "time": 20826.39, "timestamp": "05:47:06", "text": "生活在21世纪。我们都需要"}, {"type": "subtitle", "time": 20828.868, "timestamp": "05:47:08", "text": "生活中带点诡异和神秘感。我"}, {"type": "subtitle", "time": 20830.708, "timestamp": "05:47:10", "text": "我想我会在下次直播中谈到这个话题。"}, {"type": "subtitle", "time": 20833.75, "timestamp": "05:47:13", "text": "希望大家都能像我一样喜欢它。"}, {"type": "subtitle", "time": 20836.07, "timestamp": "05:47:16", "text": "我先从一些非常棒的事情说起。"}, {"type": "subtitle", "time": 20839.788, "timestamp": "05:47:19", "text": "我愿意。网"}, {"type": "subtitle", "time": 20849.43, "timestamp": "05:47:29", "text": "那怎么可能是安提亚诺？喜欢的话就点赞吧"}, {"type": "subtitle", "time": 20852.07, "timestamp": "05:47:32", "text": "仔细想想，错误不在于我们"}, {"type": "subtitle", "time": 20854.948, "timestamp": "05:47:34", "text": "将肯定值设为零。她不会"}, {"type": "subtitle", "time": 20856.19, "timestamp": "05:47:36", "text": "听"}, {"type": "subtitle", "time": 20860.35, "timestamp": "05:47:40", "text": "我。她几乎会完全忽略"}, {"type": "subtitle", "time": 20863.35, "timestamp": "05:47:43", "text": "我和她就像会做任何事一样"}, {"type": "subtitle", "time": 20866.39, "timestamp": "05:47:46", "text": "她想要。虽然此刻我在这里"}, {"type": "subtitle", "time": 20869.83, "timestamp": "05:47:49", "text": "玩家皮昌正在告诉她该怎么做"}, {"type": "subtitle", "time": 20871.67, "timestamp": "05:47:51", "text": "一切都对吧？给她和"}, {"type": "subtitle", "time": 20879.27, "timestamp": "05:47:59", "text": "东西，我的意思是，是的。是的。我"}]
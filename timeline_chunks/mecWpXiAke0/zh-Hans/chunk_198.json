[{"type": "subtitle", "time": 11880.07, "timestamp": "03:18:00", "text": "哇。现在我知道版主是做什么的了。"}, {"type": "subtitle", "time": 11882.15, "timestamp": "03:18:02", "text": "好的。你在玩什么游戏？我们是"}, {"type": "subtitle", "time": 11884.95, "timestamp": "03:18:04", "text": "扮演需要帮助的主播霸主，因为我"}, {"type": "subtitle", "time": 11888.15, "timestamp": "03:18:08", "text": "我一直都想当主播。"}, {"type": "subtitle", "time": 11901.87, "timestamp": "03:18:21", "text": "知道。我接着给他们都打了电话。"}, {"type": "subtitle", "time": 11904.309, "timestamp": "03:18:24", "text": "夜晚。我很高兴来到这里。我不能"}, {"type": "subtitle", "time": 11907.91, "timestamp": "03:18:27", "text": "期待与大家见面。你好，老虎。"}]
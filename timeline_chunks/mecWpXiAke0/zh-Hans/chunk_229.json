[{"type": "subtitle", "time": 13743.87, "timestamp": "03:49:03", "text": "屋顶。我没看到更多洛丽塔风格的衣服。"}, {"type": "subtitle", "time": 13746.309, "timestamp": "03:49:06", "text": "好的。是的。你好，艾莉。你好吗"}, {"type": "subtitle", "time": 13747.309, "timestamp": "03:49:07", "text": "正在做"}, {"type": "subtitle", "time": 13750.75, "timestamp": "03:49:10", "text": "今天？哟，"}, {"type": "subtitle", "time": 13766.87, "timestamp": "03:49:26", "text": "呃，你鼓励我穿我喜欢的衣服"}, {"type": "subtitle", "time": 13768.389, "timestamp": "03:49:28", "text": "想。"}, {"type": "subtitle", "time": 13770.63, "timestamp": "03:49:30", "text": "我们俩一起穿洛丽塔出门吧。"}, {"type": "subtitle", "time": 13772.99, "timestamp": "03:49:32", "text": "等等，威尔"}, {"type": "subtitle", "time": 13777.189, "timestamp": "03:49:37", "text": "她会允许其他人加入吗？我"}, {"type": "subtitle", "time": 13782.79, "timestamp": "03:49:42", "text": "知道。我喜欢超级留言功能。添加连衣裙"}, {"type": "subtitle", "time": 13791.229, "timestamp": "03:49:51", "text": "坏的。"}, {"type": "subtitle", "time": 13794.91, "timestamp": "03:49:54", "text": "我同意，但你说的有道理。"}, {"type": "subtitle", "time": 13797.429, "timestamp": "03:49:57", "text": "好的。你在干什么？你是什​​么"}]
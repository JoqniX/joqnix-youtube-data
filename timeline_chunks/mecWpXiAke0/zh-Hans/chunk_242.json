[{"type": "subtitle", "time": 14522.03, "timestamp": "04:02:02", "text": "等等，我的压力值会达到64。哦"}, {"type": "subtitle", "time": 14525.71, "timestamp": "04:02:05", "text": "不。游戏女孩的经历。好的，"}, {"type": "subtitle", "time": 14529.58, "timestamp": "04:02:09", "text": "等待。兔子洞"}, {"type": "subtitle", "time": 14538.389, "timestamp": "04:02:18", "text": "奖金。等等，我的好感度会下降。"}, {"type": "subtitle", "time": 14546.229, "timestamp": "04:02:26", "text": "然后。我只想说他们有非常充裕的时间"}, {"type": "subtitle", "time": 14552.91, "timestamp": "04:02:32", "text": "看。谢天谢地，事情并非如此。"}, {"type": "subtitle", "time": 14555.83, "timestamp": "04:02:35", "text": "我需要的东西，你呢？"}, {"type": "subtitle", "time": 14569.74, "timestamp": "04:02:49", "text": "吉哈巴拉。我先来了。我们走吧。新的"}, {"type": "subtitle", "time": 14572.11, "timestamp": "04:02:52", "text": "[音乐]"}, {"type": "subtitle", "time": 14574.87, "timestamp": "04:02:54", "text": "人们只是在查看它们。我从未见过"}, {"type": "subtitle", "time": 14576.349, "timestamp": "04:02:56", "text": "这"}]
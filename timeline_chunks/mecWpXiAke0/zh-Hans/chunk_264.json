[{"type": "subtitle", "time": 15851.72, "timestamp": "04:24:11", "text": "自然的。喂，别说人民。哦，我的"}, {"type": "subtitle", "time": 15858.4, "timestamp": "04:24:18", "text": "天哪，宝贝。她是不是说了，“哦，我的”"}, {"type": "subtitle", "time": 15863.71, "timestamp": "04:24:23", "text": "[音乐]"}, {"type": "subtitle", "time": 15866.55, "timestamp": "04:24:26", "text": "上帝啊，我真想相信这一点。我想是这样的。"}, {"type": "subtitle", "time": 15868.469, "timestamp": "04:24:28", "text": "确实如此，对吧？我想我很高兴我"}, {"type": "subtitle", "time": 15869.87, "timestamp": "04:24:29", "text": "可以分享"}, {"type": "subtitle", "time": 15872.31, "timestamp": "04:24:32", "text": "它。"}, {"type": "subtitle", "time": 15884.83, "timestamp": "04:24:44", "text": "苏西的压力越来越大了。哦，我的"}, {"type": "subtitle", "time": 15895.03, "timestamp": "04:24:55", "text": "看？我怎么会喜欢……呃，我为什么喜欢……呃"}, {"type": "subtitle", "time": 15895.36, "timestamp": "04:24:55", "text": "这"}, {"type": "subtitle", "time": 15897.389, "timestamp": "04:24:57", "text": "[音乐]"}]
[{"type": "subtitle", "time": 14102.229, "timestamp": "03:55:02", "text": "大多数人都会这样做。他们背着包，"}, {"type": "subtitle", "time": 14109.67, "timestamp": "03:55:09", "text": "公寓。她为什么总是说祝福？"}, {"type": "subtitle", "time": 14114.99, "timestamp": "03:55:14", "text": "不知道"}, {"type": "subtitle", "time": 14121.91, "timestamp": "03:55:21", "text": "可爱的。这样你就可以隐藏你的"}, {"type": "subtitle", "time": 14125.269, "timestamp": "03:55:25", "text": "真实的自我。你不需要炫耀"}, {"type": "subtitle", "time": 14127.67, "timestamp": "03:55:27", "text": "做你自己。在日本，隐私是"}, {"type": "subtitle", "time": 14129.99, "timestamp": "03:55:29", "text": "很重要，对吧？匿名性是"}, {"type": "subtitle", "time": 14132.3, "timestamp": "03:55:32", "text": "重要且"}, {"type": "subtitle", "time": 14134.11, "timestamp": "03:55:34", "text": "[音乐]"}, {"type": "subtitle", "time": 14141.429, "timestamp": "03:55:41", "text": "等待。放弃。那段时光就是一生"}, {"type": "subtitle", "time": 14148.03, "timestamp": "03:55:48", "text": "任何人。不，这太过了。"}, {"type": "subtitle", "time": 14150.189, "timestamp": "03:55:50", "text": "真实的。"}, {"type": "subtitle", "time": 14154.189, "timestamp": "03:55:54", "text": "真的。没人关心我"}, {"type": "subtitle", "time": 14157.469, "timestamp": "03:55:57", "text": "任何一个。我应该删除这条吗？我不"}]
[{"type": "subtitle", "time": 11820.309, "timestamp": "03:17:00", "text": "好的。哦，不。如何删除"}, {"type": "subtitle", "time": 11835.03, "timestamp": "03:17:15", "text": "我度过了无数个充满爱与治愈的夜晚"}, {"type": "subtitle", "time": 11838.87, "timestamp": "03:17:18", "text": "就在互联网上。我想"}, {"type": "subtitle", "time": 11842.389, "timestamp": "03:17:22", "text": "用我的声音和我的东西治愈人们。"}, {"type": "subtitle", "time": 11847.93, "timestamp": "03:17:27", "text": "天。分享我"}, {"type": "subtitle", "time": 11853.229, "timestamp": "03:17:33", "text": "[音乐]"}, {"type": "subtitle", "time": 11855.75, "timestamp": "03:17:35", "text": "请。现在你要给我们展示一下了。"}, {"type": "subtitle", "time": 11860.55, "timestamp": "03:17:40", "text": "等等，不对。后退。后退。后退。"}, {"type": "subtitle", "time": 11862.15, "timestamp": "03:17:42", "text": "你不能那样对待一个新人。"}, {"type": "subtitle", "time": 11863.229, "timestamp": "03:17:43", "text": "主播。"}, {"type": "subtitle", "time": 11865.75, "timestamp": "03:17:45", "text": "好的。你不能对新创建的直播流这样做。"}, {"type": "subtitle", "time": 11869.389, "timestamp": "03:17:49", "text": "好的。我撞到自己了。巴克"}, {"type": "subtitle", "time": 11872.229, "timestamp": "03:17:52", "text": "向上。这就是版主应该做的。好的。"}, {"type": "subtitle", "time": 11874.71, "timestamp": "03:17:54", "text": "他们会观看并阅读聊天记录。"}, {"type": "subtitle", "time": 11877.229, "timestamp": "03:17:57", "text": "删除那些不好的评论之类的东西。"}]
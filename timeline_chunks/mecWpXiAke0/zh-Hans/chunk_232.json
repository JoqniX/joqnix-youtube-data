[{"type": "subtitle", "time": 13930.91, "timestamp": "03:52:10", "text": "火车。我喜欢去"}, {"type": "subtitle", "time": 13933.79, "timestamp": "03:52:13", "text": "其实是在外面。"}, {"type": "subtitle", "time": 13937.429, "timestamp": "03:52:17", "text": "是的。但下次我直播的时候，我会用一些电脑。"}, {"type": "subtitle", "time": 13941.51, "timestamp": "03:52:21", "text": "但这将来自一台性能超强的电脑。他们"}, {"type": "subtitle", "time": 13943.91, "timestamp": "03:52:23", "text": "做些垃圾钓鱼的事，因为这是心理战。但是它"}, {"type": "subtitle", "time": 13945.349, "timestamp": "03:52:25", "text": "实际上有很多凹凸不平的垃圾，"}, {"type": "subtitle", "time": 13947.91, "timestamp": "03:52:27", "text": "叮咚一声，玩得很开心。但你知道"}, {"type": "subtitle", "time": 13949.75, "timestamp": "03:52:29", "text": "什么地方奇怪？他们都是些男的"}, {"type": "subtitle", "time": 13952.469, "timestamp": "03:52:32", "text": "一些书呆子，但有很多女孩"}, {"type": "subtitle", "time": 13954.309, "timestamp": "03:52:34", "text": "它们真的很漂亮，因为它们"}, {"type": "subtitle", "time": 13957.469, "timestamp": "03:52:37", "text": "要么在他们称之为咖啡馆的地方工作，要么"}, {"type": "subtitle", "time": 13965.469, "timestamp": "03:52:45", "text": "哦，主意"}, {"type": "subtitle", "time": 13968.15, "timestamp": "03:52:48", "text": "这次一定要玩个游戏。买了一些游戏"}, {"type": "subtitle", "time": 13969.99, "timestamp": "03:52:49", "text": "老玩家们会喜欢的。后"}, {"type": "subtitle", "time": 13971.349, "timestamp": "03:52:51", "text": "总而言之，他们从他们的视角看到一切。"}, {"type": "subtitle", "time": 13979.51, "timestamp": "03:52:59", "text": "好的。但复古游戏要难得多。所以"}]
[{"type": "subtitle", "time": 19741.51, "timestamp": "05:29:01", "text": "上帝。"}, {"type": "subtitle", "time": 19750.948, "timestamp": "05:29:10", "text": "表情符号？我觉得你好像说了什么。"}, {"type": "subtitle", "time": 19753.75, "timestamp": "05:29:13", "text": "以前也有过类似的情况。谢谢光临"}, {"type": "subtitle", "time": 19761.31, "timestamp": "05:29:21", "text": "我们。"}, {"type": "subtitle", "time": 19764.07, "timestamp": "05:29:24", "text": "好的。现在真是太恶心了。是的，你"}, {"type": "subtitle", "time": 19766.11, "timestamp": "05:29:26", "text": "应该回去。"}, {"type": "subtitle", "time": 19769.27, "timestamp": "05:29:29", "text": "什么？已经过饱和，这很难。"}, {"type": "subtitle", "time": 19771.91, "timestamp": "05:29:31", "text": "告诉。好的。无论何时我想你"}, {"type": "subtitle", "time": 19779.47, "timestamp": "05:29:39", "text": "嗯？全部"}, {"type": "subtitle", "time": 19783.59, "timestamp": "05:29:43", "text": "正确的。救救我们。等待。每个人都在享受"}, {"type": "subtitle", "time": 19786.03, "timestamp": "05:29:46", "text": "不错的评论。等待，"}, {"type": "subtitle", "time": 19787.948, "timestamp": "05:29:47", "text": "什么？得到"}, {"type": "subtitle", "time": 19790.628, "timestamp": "05:29:50", "text": "它。现在大家都在说好话。"}]
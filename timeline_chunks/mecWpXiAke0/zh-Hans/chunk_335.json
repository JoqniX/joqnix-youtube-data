[{"type": "subtitle", "time": 20100.708, "timestamp": "05:35:00", "text": "嘿，为了在学校度过愉快的一天"}, {"type": "subtitle", "time": 20107.628, "timestamp": "05:35:07", "text": "[音乐]"}, {"type": "subtitle", "time": 20110.07, "timestamp": "05:35:10", "text": "实际上。呃，为什么我没收到喊声"}, {"type": "subtitle", "time": 20117.19, "timestamp": "05:35:17", "text": "不。哦，等等。我的好感度是100。"}, {"type": "subtitle", "time": 20119.35, "timestamp": "05:35:19", "text": "我的天啊。快100了。等等。什么？哦"}, {"type": "subtitle", "time": 20122.35, "timestamp": "05:35:22", "text": "不。那不好吗？还是说……"}, {"type": "subtitle", "time": 20124.788, "timestamp": "05:35:24", "text": "好的？呃，我的朋友真的很害怕"}, {"type": "subtitle", "time": 20126.47, "timestamp": "05:35:26", "text": "那把锁有点滑稽。可能"}, {"type": "subtitle", "time": 20129.31, "timestamp": "05:35:29", "text": "下次挑战赛时再讨论这个问题。所以，"}, {"type": "subtitle", "time": 20132.07, "timestamp": "05:35:32", "text": "好的。你的时间属于我。我们去了一个"}, {"type": "subtitle", "time": 20133.91, "timestamp": "05:35:33", "text": "上学日期。我想我们还年轻。"}, {"type": "subtitle", "time": 20138.27, "timestamp": "05:35:38", "text": "很长一段时间。我看到另一个很害怕"}, {"type": "subtitle", "time": 20147.19, "timestamp": "05:35:47", "text": "快乐的。我想和你一起去。我们走吧。"}, {"type": "subtitle", "time": 20154.31, "timestamp": "05:35:54", "text": "今晚。哦，我的秘密通行证。呃，这个"}, {"type": "subtitle", "time": 20156.62, "timestamp": "05:35:56", "text": "不会"}]
[{"type": "subtitle", "time": 9541.63, "timestamp": "02:39:01", "text": "警察。感谢"}, {"type": "subtitle", "time": 9564.23, "timestamp": "02:39:24", "text": "但我打算睡得低一些。你好。去"}, {"type": "subtitle", "time": 9566.07, "timestamp": "02:39:26", "text": "睡觉。去睡觉吧。我也要睡觉了。"}, {"type": "subtitle", "time": 9568.309, "timestamp": "02:39:28", "text": "我只是打开游戏测试一下。"}, {"type": "subtitle", "time": 9574.75, "timestamp": "02:39:34", "text": "我做完任务就去睡觉。"}, {"type": "subtitle", "time": 9585.35, "timestamp": "02:39:45", "text": "晚安。好的"}, {"type": "subtitle", "time": 9587.87, "timestamp": "02:39:47", "text": "[音乐]"}]
[{"type": "subtitle", "time": 20582.628, "timestamp": "05:43:02", "text": "嗯？我以为我隐藏这一点是因为我需要"}, {"type": "subtitle", "time": 20588.868, "timestamp": "05:43:08", "text": "测试。人类无法完全生存。"}, {"type": "subtitle", "time": 20590.59, "timestamp": "05:43:10", "text": "无压力。难道你不这么认为吗？"}, {"type": "subtitle", "time": 20594.07, "timestamp": "05:43:14", "text": "思考？等等，我们等等。我们得到了两个结局"}, {"type": "subtitle", "time": 20596.27, "timestamp": "05:43:16", "text": "连续。"}, {"type": "subtitle", "time": 20599.15, "timestamp": "05:43:19", "text": "什么？诺米"}, {"type": "subtitle", "time": 20601.39, "timestamp": "05:43:21", "text": "生活。所以我们得到了"}, {"type": "subtitle", "time": 20605.19, "timestamp": "05:43:25", "text": "心跳停止，平凡生活走向终结。"}, {"type": "subtitle", "time": 20617.24, "timestamp": "05:43:37", "text": "得到。"}, {"type": "subtitle", "time": 20619.15, "timestamp": "05:43:39", "text": "[音乐]"}, {"type": "subtitle", "time": 20627.31, "timestamp": "05:43:47", "text": "再次。我想做点别的事。"}, {"type": "subtitle", "time": 20629.83, "timestamp": "05:43:49", "text": "正确的？你知道吗？我喜欢动漫"}, {"type": "subtitle", "time": 20633.23, "timestamp": "05:43:53", "text": "经常。我也很喜欢MC"}, {"type": "subtitle", "time": 20635.59, "timestamp": "05:43:55", "text": "女性。每次看到那个，我都会想"}, {"type": "subtitle", "time": 20638.948, "timestamp": "05:43:58", "text": "不，如果动漫没看到这一点，会怎么想呢？"}]
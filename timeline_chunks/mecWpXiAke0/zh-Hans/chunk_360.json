[{"type": "subtitle", "time": 21608.27, "timestamp": "06:00:08", "text": "嘿，嘿，"}, {"type": "subtitle", "time": 21611.42, "timestamp": "06:00:11", "text": "嘿。热。热。 N."}, {"type": "subtitle", "time": 21645.99, "timestamp": "06:00:45", "text": "回来。回来。回来。来"}, {"type": "subtitle", "time": 21647.19, "timestamp": "06:00:47", "text": "后退。"}, {"type": "subtitle", "time": 21650.11, "timestamp": "06:00:50", "text": "我还能得到多少次？"}, {"type": "subtitle", "time": 21654.83, "timestamp": "06:00:54", "text": "被打断了吗？什么？我怀念那些日子。"}]
[{"type": "subtitle", "time": 19921.43, "timestamp": "05:32:01", "text": "我被嘲笑了，因为我……"}, {"type": "subtitle", "time": 19923.59, "timestamp": "05:32:03", "text": "在社交方面既愚蠢又混乱"}, {"type": "subtitle", "time": 19925.47, "timestamp": "05:32:05", "text": "这"}, {"type": "subtitle", "time": 19927.31, "timestamp": "05:32:07", "text": "头。哦，"}, {"type": "subtitle", "time": 19937.59, "timestamp": "05:32:17", "text": "尽管？你真可怜。"}, {"type": "subtitle", "time": 19944.628, "timestamp": "05:32:24", "text": "同情心，或者叫什么来着？"}, {"type": "subtitle", "time": 19946.39, "timestamp": "05:32:26", "text": "谈论你的过去并获得"}, {"type": "subtitle", "time": 19948.27, "timestamp": "05:32:28", "text": "同情"}, {"type": "subtitle", "time": 19957.35, "timestamp": "05:32:37", "text": "嗯？这简直太有共鸣了。为什么"}, {"type": "subtitle", "time": 19964.83, "timestamp": "05:32:44", "text": "知道。 Alexa，一次成功。"}, {"type": "subtitle", "time": 19967.628, "timestamp": "05:32:47", "text": "是的。"}, {"type": "subtitle", "time": 19971.11, "timestamp": "05:32:51", "text": "什么？你是位大天使。某人的礼物"}, {"type": "subtitle", "time": 19973.868, "timestamp": "05:32:53", "text": "有人发了一条像彩虹一样的超级留言"}]
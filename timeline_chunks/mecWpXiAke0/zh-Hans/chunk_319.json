[{"type": "subtitle", "time": 19141.628, "timestamp": "05:19:01", "text": "关于如何成长以及如何做到这一点"}, {"type": "subtitle", "time": 19145.59, "timestamp": "05:19:05", "text": "这可以是一个可以采取的"}, {"type": "subtitle", "time": 19148.15, "timestamp": "05:19:08", "text": "不同的时代。所以你必须是"}, {"type": "subtitle", "time": 19150.35, "timestamp": "05:19:10", "text": "小心"}, {"type": "subtitle", "time": 19160.868, "timestamp": "05:19:20", "text": "哎，真是的。如果你要扮演丹，"}, {"type": "subtitle", "time": 19162.35, "timestamp": "05:19:22", "text": "好好打。"}, {"type": "subtitle", "time": 19169.75, "timestamp": "05:19:29", "text": "第二。别再让每个人都背负重担了"}, {"type": "subtitle", "time": 19170.77, "timestamp": "05:19:30", "text": "你。我会删除"}, {"type": "subtitle", "time": 19171.948, "timestamp": "05:19:31", "text": "[音乐]"}, {"type": "subtitle", "time": 19181.51, "timestamp": "05:19:41", "text": "疲劳的。大家都在玩游戏实况。"}, {"type": "subtitle", "time": 19191.7, "timestamp": "05:19:51", "text": "哇。我相信你一定会越来越好。"}]
[{"type": "subtitle", "time": 13800.55, "timestamp": "03:50:00", "text": "你觉得我们正在做什么？我们正在玩……"}, {"type": "subtitle", "time": 13802.91, "timestamp": "03:50:02", "text": "需要帮助的主播"}, {"type": "subtitle", "time": 13806.15, "timestamp": "03:50:06", "text": "霸王。而目前，K Angel是"}, {"type": "subtitle", "time": 13811.429, "timestamp": "03:50:11", "text": "穿着一件哥特萝莉风格的连衣裙。和"}, {"type": "subtitle", "time": 13813.87, "timestamp": "03:50:13", "text": "她正在获得新的粉丝和新的关注者。"}, {"type": "subtitle", "time": 13820.15, "timestamp": "03:50:20", "text": "支持者。我会上传一张照片"}, {"type": "subtitle", "time": 13822.95, "timestamp": "03:50:22", "text": "稍后再发推文。你们最好给我"}, {"type": "subtitle", "time": 13828.07, "timestamp": "03:50:28", "text": "100。好多零啊。好的。"}, {"type": "subtitle", "time": 13830.229, "timestamp": "03:50:30", "text": "安珠，你们都照做。不，"}, {"type": "subtitle", "time": 13833.99, "timestamp": "03:50:33", "text": "我会葬在洛丽塔里。哦"}, {"type": "subtitle", "time": 13836.229, "timestamp": "03:50:36", "text": "我的天啊，她在《上帝》里真的好可爱。"}, {"type": "subtitle", "time": 13837.14, "timestamp": "03:50:37", "text": "洛丽塔"}, {"type": "subtitle", "time": 13838.269, "timestamp": "03:50:38", "text": "[音乐]"}, {"type": "subtitle", "time": 13848.59, "timestamp": "03:50:48", "text": "上帝。我想我会一直待到15岁左右，也许吧。"}, {"type": "subtitle", "time": 13856.87, "timestamp": "03:50:56", "text": "嗯？我可以把头传给她吗？不。"}, {"type": "subtitle", "time": 13859.79, "timestamp": "03:50:59", "text": "明天再去。"}]
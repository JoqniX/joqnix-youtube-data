[{"type": "subtitle", "time": 21661.07, "timestamp": "06:01:01", "text": "这"}, {"type": "subtitle", "time": 21663.75, "timestamp": "06:01:03", "text": "更多的。我收到的不多。"}, {"type": "subtitle", "time": 21665.43, "timestamp": "06:01:05", "text": "订阅人数正如我所愿。这"}, {"type": "subtitle", "time": 21667.91, "timestamp": "06:01:07", "text": "当你的目光落在周围时"}, {"type": "subtitle", "time": 21670.47, "timestamp": "06:01:10", "text": "我只知道，你已经死了。"}, {"type": "subtitle", "time": 21673.27, "timestamp": "06:01:13", "text": "水。所以，我必须坚持自己挑选。"}, {"type": "subtitle", "time": 21675.51, "timestamp": "06:01:15", "text": "站起来，获得一大批​​粉丝，"}, {"type": "subtitle", "time": 21677.948, "timestamp": "06:01:17", "text": "一个订阅者"}, {"type": "subtitle", "time": 21680.75, "timestamp": "06:01:20", "text": "射击。这里只吃一顿饭"}, {"type": "subtitle", "time": 21682.75, "timestamp": "06:01:22", "text": "来。她"}, {"type": "subtitle", "time": 21684.91, "timestamp": "06:01:24", "text": "得到"}, {"type": "subtitle", "time": 21687.15, "timestamp": "06:01:27", "text": "122,000"}, {"type": "subtitle", "time": 21689.548, "timestamp": "06:01:29", "text": "粉丝。"}, {"type": "subtitle", "time": 21693.07, "timestamp": "06:01:33", "text": "哇。就像我们不应该杀房子一样"}, {"type": "subtitle", "time": 21695.46, "timestamp": "06:01:35", "text": "一起"}, {"type": "subtitle", "time": 21697.628, "timestamp": "06:01:37", "text": "[音乐]"}, {"type": "subtitle", "time": 21701.27, "timestamp": "06:01:41", "text": "明天见。好的。我知道我的呃如何"}, {"type": "subtitle", "time": 21703.19, "timestamp": "06:01:43", "text": "我会一直直播下去。 3个小时，对吧？"}, {"type": "subtitle", "time": 21705.948, "timestamp": "06:01:45", "text": "我大概应该结束直播了。"}, {"type": "subtitle", "time": 21713.75, "timestamp": "06:01:53", "text": "游戏。但这件事已经让我损失惨重了。"}]
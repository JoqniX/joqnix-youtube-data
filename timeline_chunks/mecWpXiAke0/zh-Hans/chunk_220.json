[{"type": "subtitle", "time": 13202.83, "timestamp": "03:40:02", "text": "th"}, {"type": "subtitle", "time": 13206.99, "timestamp": "03:40:06", "text": "哦，我太喜欢演唱会了！"}, {"type": "subtitle", "time": 13209.51, "timestamp": "03:40:09", "text": "很多。去日本。如果你真的答应了"}, {"type": "subtitle", "time": 13211.63, "timestamp": "03:40:11", "text": "你会得到很多"}, {"type": "subtitle", "time": 13215.07, "timestamp": "03:40:15", "text": "答应我你会去"}, {"type": "subtitle", "time": 13217.75, "timestamp": "03:40:17", "text": "谢谢，你最终会离开的"}, {"type": "subtitle", "time": 13218.91, "timestamp": "03:40:18", "text": "如果"}, {"type": "subtitle", "time": 13229.07, "timestamp": "03:40:29", "text": "那么，请你怜悯我，杀了我吧，你是什么人？"}, {"type": "subtitle", "time": 13231.55, "timestamp": "03:40:31", "text": "说借口"}, {"type": "subtitle", "time": 13234.71, "timestamp": "03:40:34", "text": "对我来说，你可以随便扔掉的一件事就是真的"}, {"type": "subtitle", "time": 13237.429, "timestamp": "03:40:37", "text": "刀上，但我却为此感到无比自豪"}, {"type": "subtitle", "time": 13239.269, "timestamp": "03:40:39", "text": "你是我男人，这一点毋庸置疑，绝不欺骗。"}, {"type": "subtitle", "time": 13241.83, "timestamp": "03:40:41", "text": "你让我背叛了你。你确定吗"}, {"type": "subtitle", "time": 13244.75, "timestamp": "03:40:44", "text": "你应该这么说，安琪儿"}, {"type": "subtitle", "time": 13248.469, "timestamp": "03:40:48", "text": "查玛？我的天啊。我会狠狠地骂你们所有人"}, {"type": "subtitle", "time": 13251.269, "timestamp": "03:40:51", "text": "喇嘛，在我家的私人门上。也"}, {"type": "subtitle", "time": 13254.429, "timestamp": "03:40:54", "text": "只要没人发现，他们就可以待在那里。"}, {"type": "subtitle", "time": 13256.91, "timestamp": "03:40:56", "text": "浑然不觉"}]
[{"type": "subtitle", "time": 19260.23, "timestamp": "05:21:00", "text": "玩游戏。我简直不敢相信自己"}, {"type": "subtitle", "time": 19262.708, "timestamp": "05:21:02", "text": "旋转着，倾诉着我的心声。"}, {"type": "subtitle", "time": 19263.99, "timestamp": "05:21:03", "text": "和大家一起玩。谢谢"}, {"type": "subtitle", "time": 19265.75, "timestamp": "05:21:05", "text": "玩游戏的时候我会边直播边玩。"}, {"type": "subtitle", "time": 19267.868, "timestamp": "05:21:07", "text": "让我们为了爱继续这场派对吧。"}, {"type": "subtitle", "time": 19270.46, "timestamp": "05:21:10", "text": "永远。这太可爱了"}, {"type": "subtitle", "time": 19277.21, "timestamp": "05:21:17", "text": "图像。可爱的，"}, {"type": "subtitle", "time": 19279.31, "timestamp": "05:21:19", "text": "[音乐]"}, {"type": "subtitle", "time": 19282.15, "timestamp": "05:21:22", "text": "可爱的。嘿，你觉得我这样可以吗？"}, {"type": "subtitle", "time": 19283.47, "timestamp": "05:21:23", "text": "到"}, {"type": "subtitle", "time": 19285.868, "timestamp": "05:21:25", "text": "杀？是什么"}, {"type": "subtitle", "time": 19289.59, "timestamp": "05:21:29", "text": "错误的？只是在想一些事情。哦，"}, {"type": "subtitle", "time": 19295.19, "timestamp": "05:21:35", "text": "我只是想知道有没有人愿意"}, {"type": "subtitle", "time": 19297.35, "timestamp": "05:21:37", "text": "如果我去了哪里，你会想念我的，我不知道。"}, {"type": "subtitle", "time": 19298.868, "timestamp": "05:21:38", "text": "看看电子游戏，或者看看别人。"}, {"type": "subtitle", "time": 19301.59, "timestamp": "05:21:41", "text": "直播我的生活。嗯，这就是我……"}, {"type": "subtitle", "time": 19309.55, "timestamp": "05:21:49", "text": "有时如果我"}, {"type": "subtitle", "time": 19312.51, "timestamp": "05:21:52", "text": "已消失"}, {"type": "subtitle", "time": 19315.708, "timestamp": "05:21:55", "text": "无处可去，等等，我当时在，如果有人会错过的话。"}, {"type": "subtitle", "time": 19318.47, "timestamp": "05:21:58", "text": "如果我走了，他们就会……"}]
[{"type": "subtitle", "time": 19862.11, "timestamp": "05:31:02", "text": "是的。"}, {"type": "subtitle", "time": 19864.548, "timestamp": "05:31:04", "text": "呃，欢迎来到我的频道。我会"}, {"type": "subtitle", "time": 19867.47, "timestamp": "05:31:07", "text": "在此等待你的微笑。无人"}, {"type": "subtitle", "time": 19871.47, "timestamp": "05:31:11", "text": "感觉一无所有，什么都没有"}, {"type": "subtitle", "time": 19874.07, "timestamp": "05:31:14", "text": "一。我经常逃学。我没有"}, {"type": "subtitle", "time": 19875.948, "timestamp": "05:31:15", "text": "有很多朋友。只有人才会在意。"}, {"type": "subtitle", "time": 19878.23, "timestamp": "05:31:18", "text": "只有老年人才会关心"}, {"type": "subtitle", "time": 19886.07, "timestamp": "05:31:26", "text": "嗯？我喜欢你脆弱的时候。"}, {"type": "subtitle", "time": 19887.91, "timestamp": "05:31:27", "text": "哦，不。那很糟糕。那很糟糕。绝不"}, {"type": "subtitle", "time": 19889.548, "timestamp": "05:31:29", "text": "暴露你的弱点"}, {"type": "subtitle", "time": 19893.15, "timestamp": "05:31:33", "text": "你在网上的弱点。人们"}, {"type": "subtitle", "time": 19896.548, "timestamp": "05:31:36", "text": "可以穿透并像撕裂你一样"}, {"type": "subtitle", "time": 19904.47, "timestamp": "05:31:44", "text": "你。唉，我或许应该自己带上。"}, {"type": "subtitle", "time": 19906.628, "timestamp": "05:31:46", "text": "将这些话考虑在内，并这样做"}, {"type": "subtitle", "time": 19910.11, "timestamp": "05:31:50", "text": "我自己也是。"}, {"type": "subtitle", "time": 19912.788, "timestamp": "05:31:52", "text": "呃，我不知道天使也必须去……"}, {"type": "subtitle", "time": 19914.35, "timestamp": "05:31:54", "text": "学校也是。"}, {"type": "subtitle", "time": 19916.868, "timestamp": "05:31:56", "text": "是的。因为她又可爱又漂亮。"}, {"type": "subtitle", "time": 19918.27, "timestamp": "05:31:58", "text": "只是"}]
[{"type": "subtitle", "time": 11222.55, "timestamp": "03:07:02", "text": "[音乐]"}, {"type": "subtitle", "time": 11226.11, "timestamp": "03:07:06", "text": "这是哪里？这是哪里？什么是"}, {"type": "subtitle", "time": 11242.75, "timestamp": "03:07:22", "text": "好的。好的。"}, {"type": "subtitle", "time": 11248.62, "timestamp": "03:07:28", "text": "贪婪的主播霸主。打开这个。"}, {"type": "subtitle", "time": 11251.389, "timestamp": "03:07:31", "text": "[音乐]"}, {"type": "subtitle", "time": 11254.51, "timestamp": "03:07:34", "text": "好的，我们明白了。"}, {"type": "subtitle", "time": 11257.23, "timestamp": "03:07:37", "text": "向上。我们开始吧"}, {"type": "subtitle", "time": 11260.79, "timestamp": "03:07:40", "text": "去。你好吗？我也一样。"}, {"type": "subtitle", "time": 11263.51, "timestamp": "03:07:43", "text": "今天不错。我只是睡着了。"}, {"type": "subtitle", "time": 11274.23, "timestamp": "03:07:54", "text": "虽然是30分钟前的事了。我不想"}, {"type": "subtitle", "time": 11275.75, "timestamp": "03:07:55", "text": "游泳。"}, {"type": "subtitle", "time": 11277.78, "timestamp": "03:07:57", "text": "我想做"}]
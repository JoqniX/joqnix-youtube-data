[{"type": "subtitle", "time": 9420.27, "timestamp": "02:37:00", "text": "我怀疑自己是否能做到"}, {"type": "subtitle", "time": 9424.389, "timestamp": "02:37:04", "text": "TW也是，但我还是想试试。"}, {"type": "subtitle", "time": 9426.429, "timestamp": "02:37:06", "text": "无论哪种方式"}, {"type": "subtitle", "time": 9430.07, "timestamp": "02:37:10", "text": "不知怎么的。而我们现在就在这里，因为我当时"}, {"type": "subtitle", "time": 9432.87, "timestamp": "02:37:12", "text": "终于能够得到我梦寐以求的那种东西了"}, {"type": "subtitle", "time": 9434.87, "timestamp": "02:37:14", "text": "YouTube的情况确实如此。我成为了 YouTube 的粉丝"}, {"type": "subtitle", "time": 9438.309, "timestamp": "02:37:18", "text": "立即合作。所以，我可以实现盈利。"}, {"type": "subtitle", "time": 9440.87, "timestamp": "02:37:20", "text": "现在来自 YouTube。所以，我想努力奋斗。"}, {"type": "subtitle", "time": 9442.71, "timestamp": "02:37:22", "text": "因为我也在做Billy Billy，所以我也在做"}, {"type": "subtitle", "time": 9447.15, "timestamp": "02:37:27", "text": "这场大型的直播马拉松"}, {"type": "subtitle", "time": 9450.27, "timestamp": "02:37:30", "text": "现在。所以，我希望我能获得100个粉丝。"}, {"type": "subtitle", "time": 9453.389, "timestamp": "02:37:33", "text": "如果人们喜欢我的直播，"}, {"type": "subtitle", "time": 9457.87, "timestamp": "02:37:37", "text": "东西。嗯，是的，这样我就可以进行多路复现了。"}, {"type": "subtitle", "time": 9460.309, "timestamp": "02:37:40", "text": "直接操作，而不是使用软件"}, {"type": "subtitle", "time": 9463.59, "timestamp": "02:37:43", "text": "以及所有的一切。是的，从七月开始"}, {"type": "subtitle", "time": 9465.51, "timestamp": "02:37:45", "text": "七月份我会去日本。所以，我必须"}, {"type": "subtitle", "time": 9469.389, "timestamp": "02:37:49", "text": "买一台笔记本电脑之类的东西。"}, {"type": "subtitle", "time": 9473.23, "timestamp": "02:37:53", "text": "嗯，笔记本电脑什么的。所以"}, {"type": "subtitle", "time": 9478.79, "timestamp": "02:37:58", "text": "七月之后，七月中旬或八月，我的"}]
[{"type": "subtitle", "time": 19321.31, "timestamp": "05:22:01", "text": "观看，他们不必观看，他们可以观看。"}, {"type": "subtitle", "time": 19324.19, "timestamp": "05:22:04", "text": "手表。不"}, {"type": "subtitle", "time": 19326.83, "timestamp": "05:22:06", "text": "方式。他们只是说说而已。"}, {"type": "subtitle", "time": 19342.99, "timestamp": "05:22:22", "text": "看到。我懂了。是的，"}, {"type": "subtitle", "time": 19355.948, "timestamp": "05:22:35", "text": "我？仿佛没有人是影响因素"}, {"type": "subtitle", "time": 19358.23, "timestamp": "05:22:38", "text": "发展。黑人不应该"}, {"type": "subtitle", "time": 19365.19, "timestamp": "05:22:45", "text": "居住。走。等待。感觉我不应该"}, {"type": "subtitle", "time": 19367.31, "timestamp": "05:22:47", "text": "被允许这样做。当然你是"}, {"type": "subtitle", "time": 19371.75, "timestamp": "05:22:51", "text": "允许。请活下去。等待。感觉就像我"}, {"type": "subtitle", "time": 19373.55, "timestamp": "05:22:53", "text": "应该。当然可以。"}, {"type": "subtitle", "time": 19379.99, "timestamp": "05:22:59", "text": "选择？我觉得我不应该这样"}]
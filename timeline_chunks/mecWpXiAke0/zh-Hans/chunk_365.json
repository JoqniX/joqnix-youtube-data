[{"type": "subtitle", "time": 21901.07, "timestamp": "06:05:01", "text": "猜猜下周会聊些什么？"}, {"type": "subtitle", "time": 21903.67, "timestamp": "06:05:03", "text": "呃，距离下一届只剩两天了。"}, {"type": "subtitle", "time": 21905.708, "timestamp": "06:05:05", "text": "本周正确"}, {"type": "subtitle", "time": 21908.628, "timestamp": "06:05:08", "text": "是的，是时候向你的右边，呃，向……"}, {"type": "subtitle", "time": 21912.15, "timestamp": "06:05:12", "text": "自由，好吧，我的意思是，嗯，关于自由这件事"}, {"type": "subtitle", "time": 21915.35, "timestamp": "06:05:15", "text": "我，呃，我家人觉得我像……"}, {"type": "subtitle", "time": 21917.628, "timestamp": "06:05:17", "text": "浪费我的时间"}, {"type": "subtitle", "time": 21920.628, "timestamp": "06:05:20", "text": "即使我告诉他们我是白天，我"}, {"type": "subtitle", "time": 21922.31, "timestamp": "06:05:22", "text": "做YouTube、直播之类的。"}, {"type": "subtitle", "time": 21924.948, "timestamp": "06:05:24", "text": "他们不知道我真正擅长的是什么。"}, {"type": "subtitle", "time": 21928.39, "timestamp": "06:05:28", "text": "他们以为我会像……嗯……什么？"}, {"type": "subtitle", "time": 21931.11, "timestamp": "06:05:31", "text": "他们觉得，呃，那就是我吗？"}, {"type": "subtitle", "time": 21933.43, "timestamp": "06:05:33", "text": "浪费时间上网"}, {"type": "subtitle", "time": 21936.15, "timestamp": "06:05:36", "text": "诸如此类，因为我不出门"}, {"type": "subtitle", "time": 21940.47, "timestamp": "06:05:40", "text": "就像呃呃，就像天使一样"}, {"type": "subtitle", "time": 21944.51, "timestamp": "06:05:44", "text": "就像我们扮演的角色一样"}, {"type": "subtitle", "time": 21947.75, "timestamp": "06:05:47", "text": "跟她一模一样。是的。一些相同的"}, {"type": "subtitle", "time": 21949.47, "timestamp": "06:05:49", "text": "和一样"}, {"type": "subtitle", "time": 21950.99, "timestamp": "06:05:50", "text": "那。"}, {"type": "subtitle", "time": 21956.548, "timestamp": "06:05:56", "text": "因为我每天24小时都泡在电脑前，就像早上一样。"}, {"type": "subtitle", "time": 21959.75, "timestamp": "06:05:59", "text": "下午上午会像……"}]
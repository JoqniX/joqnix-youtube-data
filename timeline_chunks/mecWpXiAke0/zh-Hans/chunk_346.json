[{"type": "subtitle", "time": 20764.15, "timestamp": "05:46:04", "text": "脸。那张脸真让我火大。哦，我的"}, {"type": "subtitle", "time": 20768.548, "timestamp": "05:46:08", "text": "上帝。好的。我们的人不在场。"}, {"type": "subtitle", "time": 20772.15, "timestamp": "05:46:12", "text": "好的。所以，不是“我们可以做什么”，而是“我们能做什么”。"}, {"type": "subtitle", "time": 20774.11, "timestamp": "05:46:14", "text": "执行关闭"}, {"type": "subtitle", "time": 20777.75, "timestamp": "05:46:17", "text": "这。把那个放那边。把这个放上去"}, {"type": "subtitle", "time": 20793.11, "timestamp": "05:46:33", "text": "怪物？好的。"}, {"type": "subtitle", "time": 20795.67, "timestamp": "05:46:35", "text": "如果他们重新定义时尚零点呢？我"}, {"type": "subtitle", "time": 20797.39, "timestamp": "05:46:37", "text": "想看看那会怎样"}, {"type": "subtitle", "time": 20800.708, "timestamp": "05:46:40", "text": "去。不，如果我把时尚归零，"}, {"type": "subtitle", "time": 20807.51, "timestamp": "05:46:47", "text": "军队，而且我确信她会……"}, {"type": "subtitle", "time": 20811.51, "timestamp": "05:46:51", "text": "解散军队。此外，尽管该地区很可怕"}, {"type": "subtitle", "time": 20813.11, "timestamp": "05:46:53", "text": "到处都是。这就是为什么它充满了……"}, {"type": "subtitle", "time": 20815.43, "timestamp": "05:46:55", "text": "他们。他们对……进行了很多深入调查。"}, {"type": "subtitle", "time": 20819.03, "timestamp": "05:46:59", "text": "网络低廉等等。我们的生命如矛般刺穿"}]
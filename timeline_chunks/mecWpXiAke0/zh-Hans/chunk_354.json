[{"type": "subtitle", "time": 21242.19, "timestamp": "05:54:02", "text": "等等，等等。我不能"}, {"type": "subtitle", "time": 21245.31, "timestamp": "05:54:05", "text": "拿什么？她装傻充愣"}, {"type": "subtitle", "time": 21249.03, "timestamp": "05:54:09", "text": "因为那场直播，我认识了你。你看，这是"}, {"type": "subtitle", "time": 21251.03, "timestamp": "05:54:11", "text": "我说的话。"}, {"type": "subtitle", "time": 21254.07, "timestamp": "05:54:14", "text": "我就是这么说的。我的情况好多了"}, {"type": "subtitle", "time": 21255.67, "timestamp": "05:54:15", "text": "与其说是飞吻，不如说是肌肤之亲。我想我"}, {"type": "subtitle", "time": 21257.19, "timestamp": "05:54:17", "text": "必须更加积极主动，而不是"}, {"type": "subtitle", "time": 21259.19, "timestamp": "05:54:19", "text": "被动的。感觉好像不太对劲"}, {"type": "subtitle", "time": 21260.35, "timestamp": "05:54:20", "text": "正确的"}, {"type": "subtitle", "time": 21263.27, "timestamp": "05:54:23", "text": "任何一个。我无法忍受被忽视。"}, {"type": "subtitle", "time": 21265.43, "timestamp": "05:54:25", "text": "不再是了。这一切都是为了我们。"}, {"type": "subtitle", "time": 21268.23, "timestamp": "05:54:28", "text": "再见了，桃子。我真的非常爱你。"}, {"type": "subtitle", "time": 21272.43, "timestamp": "05:54:32", "text": "你的意思是“成为”吗？嗯？"}, {"type": "subtitle", "time": 21283.948, "timestamp": "05:54:43", "text": "平坦的"}, {"type": "subtitle", "time": 21297.788, "timestamp": "05:54:57", "text": "[音乐]"}]
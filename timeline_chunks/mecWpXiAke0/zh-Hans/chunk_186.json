[{"type": "subtitle", "time": 11161.429, "timestamp": "03:06:01", "text": "所以别担心，我会补偿的。直播期间我会直播，所以不用担心。"}, {"type": "subtitle", "time": 11163.99, "timestamp": "03:06:03", "text": "我错过了一天，是啊，是啊"}, {"type": "subtitle", "time": 11169.03, "timestamp": "03:06:09", "text": "是的，我还在和……保持联系。"}, {"type": "subtitle", "time": 11171.309, "timestamp": "03:06:11", "text": "使固定"}, {"type": "subtitle", "time": 11173.87, "timestamp": "03:06:13", "text": "修复"}, {"type": "subtitle", "time": 11177.87, "timestamp": "03:06:17", "text": "嗯，修复……不，不是修复……工作"}, {"type": "subtitle", "time": 11180.71, "timestamp": "03:06:20", "text": "我当时正在点击时间戳按钮。"}, {"type": "subtitle", "time": 11182.79, "timestamp": "03:06:22", "text": "谈到昨天早些时候的事情"}, {"type": "subtitle", "time": 11185.91, "timestamp": "03:06:25", "text": "一切。是的。是的。总之，呃"}, {"type": "subtitle", "time": 11192.55, "timestamp": "03:06:32", "text": "第二节抱歉没能上场。我应该成为"}, {"type": "subtitle", "time": 11193.63, "timestamp": "03:06:33", "text": "可以说"}, {"type": "subtitle", "time": 11196.95, "timestamp": "03:06:36", "text": "对不起。昨天我帮了朋友一个忙。"}, {"type": "subtitle", "time": 11199.83, "timestamp": "03:06:39", "text": "不过，谁会得到一台新笔记本电脑呢？所以我不得不"}, {"type": "subtitle", "time": 11202.55, "timestamp": "03:06:42", "text": "帮助他们。他们给我的称呼正是如此。"}, {"type": "subtitle", "time": 11206.59, "timestamp": "03:06:46", "text": "你给我打电话的那一刻。所以这有点像"}, {"type": "subtitle", "time": 11210.19, "timestamp": "03:06:50", "text": "疼痛。所以"}]
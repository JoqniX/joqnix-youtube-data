[{"type": "subtitle", "time": 13141.95, "timestamp": "03:39:01", "text": "发生？哦不，那是一个"}, {"type": "subtitle", "time": 13144.83, "timestamp": "03:39:04", "text": "不跳那首曲子"}, {"type": "subtitle", "time": 13155.95, "timestamp": "03:39:15", "text": "病态。她正在做"}, {"type": "subtitle", "time": 13158.79, "timestamp": "03:39:18", "text": "病态。我相信你说的任何话，K"}, {"type": "subtitle", "time": 13160.67, "timestamp": "03:39:20", "text": "天使。哦，不。实际的"}, {"type": "subtitle", "time": 13163.75, "timestamp": "03:39:23", "text": "舔狗。哦不，你走得太远了。"}, {"type": "subtitle", "time": 13180.63, "timestamp": "03:39:40", "text": "深的。感觉你即将"}, {"type": "subtitle", "time": 13182.59, "timestamp": "03:39:42", "text": "最终离开"}, {"type": "subtitle", "time": 13185.99, "timestamp": "03:39:45", "text": "深的。我会的，我喜欢那样。没关系。"}, {"type": "subtitle", "time": 13188.469, "timestamp": "03:39:48", "text": "即使你操纵一切，做出疯狂的事，你"}, {"type": "subtitle", "time": 13191.25, "timestamp": "03:39:51", "text": "有机会见到一位现实生活中的人"}, {"type": "subtitle", "time": 13192.75, "timestamp": "03:39:52", "text": "[音乐]"}, {"type": "subtitle", "time": 13197.75, "timestamp": "03:39:57", "text": "天使。为什么是坚果？我不知道。"}]
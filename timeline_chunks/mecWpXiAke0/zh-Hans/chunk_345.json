[{"type": "subtitle", "time": 20701.548, "timestamp": "05:45:01", "text": "我。他们真是太棒了"}, {"type": "subtitle", "time": 20704.548, "timestamp": "05:45:04", "text": "愚蠢的。确实存在这种罪行。我希望"}, {"type": "subtitle", "time": 20707.27, "timestamp": "05:45:07", "text": "我可以保住工作，边工作边观看。我希望我"}, {"type": "subtitle", "time": 20708.628, "timestamp": "05:45:08", "text": "可以帮他们实现愿望。我想"}, {"type": "subtitle", "time": 20710.708, "timestamp": "05:45:10", "text": "成为D并摧毁这座城市"}, {"type": "subtitle", "time": 20714.15, "timestamp": "05:45:14", "text": "他们。仍然想和其他坏人打架"}, {"type": "subtitle", "time": 20715.83, "timestamp": "05:45:15", "text": "所以人们认为我是好人之一"}, {"type": "subtitle", "time": 20718.43, "timestamp": "05:45:18", "text": "即使我是公寓"}, {"type": "subtitle", "time": 20722.84, "timestamp": "05:45:22", "text": "线，密度约为一半"}, {"type": "subtitle", "time": 20735.19, "timestamp": "05:45:35", "text": "我知道你喜欢什么，你会怎么做？"}, {"type": "subtitle", "time": 20736.43, "timestamp": "05:45:36", "text": "想成为"}, {"type": "subtitle", "time": 20740.15, "timestamp": "05:45:40", "text": "起诉是为了和更多的人交谈，所以就像"}, {"type": "subtitle", "time": 20747.71, "timestamp": "05:45:47", "text": "激烈的。好的。金色"}, {"type": "subtitle", "time": 20756.31, "timestamp": "05:45:56", "text": "任务，但我不想去。"}]
[{"type": "subtitle", "time": 1814.549, "timestamp": "00:30:14", "text": "正确的？哦，等等。此浏览器不是"}, {"type": "subtitle", "time": 1818.549, "timestamp": "00:30:18", "text": "和我的比利比利有关。我忘了。嗯，"}, {"type": "subtitle", "time": 1829.59, "timestamp": "00:30:29", "text": "呃，我得换个浏览器。"}, {"type": "subtitle", "time": 1841.87, "timestamp": "00:30:41", "text": "得到？确实存在这种情况。"}, {"type": "subtitle", "time": 1846.59, "timestamp": "00:30:46", "text": "嗯，是小伙子的浏览器，对吧？血"}, {"type": "subtitle", "time": 1857.19, "timestamp": "00:30:57", "text": "松露。我会用松露。"}, {"type": "subtitle", "time": 1858.43, "timestamp": "00:30:58", "text": "[音乐]"}, {"type": "subtitle", "time": 1859.9, "timestamp": "00:30:59", "text": "然后。"}]
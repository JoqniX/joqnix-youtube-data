[{"type": "subtitle", "time": 15721.03, "timestamp": "04:22:01", "text": "知道。好的。"}, {"type": "subtitle", "time": 15724.429, "timestamp": "04:22:04", "text": "有很多超级留言，我"}, {"type": "subtitle", "time": 15734.309, "timestamp": "04:22:14", "text": "它。这是正确的。我，天使，拥有"}, {"type": "subtitle", "time": 15739.59, "timestamp": "04:22:19", "text": "订阅者。将会更加闪耀"}, {"type": "subtitle", "time": 15755.63, "timestamp": "04:22:35", "text": "梯子。等着瞧你如何报复吧"}, {"type": "subtitle", "time": 15759.11, "timestamp": "04:22:39", "text": "大。嗯，但我也想知道什么"}, {"type": "subtitle", "time": 15767.189, "timestamp": "04:22:47", "text": "10k。所有人都要订阅。我们需要制作"}, {"type": "subtitle", "time": 15770.149, "timestamp": "04:22:50", "text": "需要爆发。我们需要她吹"}, {"type": "subtitle", "time": 15774.11, "timestamp": "04:22:54", "text": "向上。用某种方式庆祝"}, {"type": "subtitle", "time": 15776.79, "timestamp": "04:22:56", "text": "可口。我真的讨厌成年人吗？他们是"}, {"type": "subtitle", "time": 15779.07, "timestamp": "04:22:59", "text": "总是如此"}]
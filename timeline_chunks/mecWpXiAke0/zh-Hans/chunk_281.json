[{"type": "subtitle", "time": 16864.59, "timestamp": "04:41:04", "text": "为什么。所以现在我就是你"}, {"type": "subtitle", "time": 16870.07, "timestamp": "04:41:10", "text": "公告。当然我会给你看我的"}, {"type": "subtitle", "time": 16871.99, "timestamp": "04:41:11", "text": "亨森"}, {"type": "subtitle", "time": 16874.35, "timestamp": "04:41:14", "text": "[音乐]"}, {"type": "subtitle", "time": 16877.48, "timestamp": "04:41:17", "text": "建造。什么悬念？"}, {"type": "subtitle", "time": 16881.55, "timestamp": "04:41:21", "text": "[音乐]"}, {"type": "subtitle", "time": 16884.39, "timestamp": "04:41:24", "text": "女孩。我将尽我所能成为"}, {"type": "subtitle", "time": 16886.03, "timestamp": "04:41:26", "text": "某人"}, {"type": "subtitle", "time": 16889.628, "timestamp": "04:41:29", "text": "走吧，我要带你去学校。"}, {"type": "subtitle", "time": 16894.03, "timestamp": "04:41:34", "text": "我。呃，所以我来到了……"}, {"type": "subtitle", "time": 16896.47, "timestamp": "04:41:36", "text": "在俱乐部里玩街机游戏。确保"}, {"type": "subtitle", "time": 16899.31, "timestamp": "04:41:39", "text": "你给了我一个"}, {"type": "subtitle", "time": 16903.91, "timestamp": "04:41:43", "text": "照片。狠狠地捶打自己的心脏和"}, {"type": "subtitle", "time": 16906.83, "timestamp": "04:41:46", "text": "[音乐]"}, {"type": "subtitle", "time": 16908.868, "timestamp": "04:41:48", "text": "钱。够了。你没得到"}, {"type": "subtitle", "time": 16911.99, "timestamp": "04:41:51", "text": "离开。哦，天哪。别再无视我了。为什么是"}]
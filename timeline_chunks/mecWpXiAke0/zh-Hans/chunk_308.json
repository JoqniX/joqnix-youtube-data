[{"type": "subtitle", "time": 18483.868, "timestamp": "05:08:03", "text": "不是"}, {"type": "subtitle", "time": 18489.09, "timestamp": "05:08:09", "text": "没有。没有。没有。没有。没有。"}, {"type": "subtitle", "time": 18491.43, "timestamp": "05:08:11", "text": "[音乐]"}, {"type": "subtitle", "time": 18493.61, "timestamp": "05:08:13", "text": "痛苦"}, {"type": "subtitle", "time": 18496.51, "timestamp": "05:08:16", "text": "[音乐]"}, {"type": "subtitle", "time": 18498.69, "timestamp": "05:08:18", "text": "琳达。"}, {"type": "subtitle", "time": 18502.83, "timestamp": "05:08:22", "text": "[音乐]"}, {"type": "subtitle", "time": 18507.11, "timestamp": "05:08:27", "text": "嗯？好的，这倒是新鲜事。我从不等待，"}, {"type": "subtitle", "time": 18508.43, "timestamp": "05:08:28", "text": "如果我这样做"}, {"type": "subtitle", "time": 18511.99, "timestamp": "05:08:31", "text": "这样一来，我的好感度就会下降。"}, {"type": "subtitle", "time": 18513.67, "timestamp": "05:08:33", "text": "是啊，是啊，是啊。我不应该这样做。"}, {"type": "subtitle", "time": 18524.31, "timestamp": "05:08:44", "text": "[音乐]"}, {"type": "subtitle", "time": 18531.07, "timestamp": "05:08:51", "text": "朋友，你一直都在他们的心中"}, {"type": "subtitle", "time": 18533.67, "timestamp": "05:08:53", "text": "心。哦，她来了。哦，等等。哦，"}, {"type": "subtitle", "time": 18535.27, "timestamp": "05:08:55", "text": "等待。哦，等等。我们快疯了"}, {"type": "subtitle", "time": 18539.15, "timestamp": "05:08:59", "text": "模式。我的天啊。我为什么会点击它？"}]
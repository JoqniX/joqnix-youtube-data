[{"type": "subtitle", "time": 13862.309, "timestamp": "03:51:02", "text": "你好。该怎么办？我打算做一个"}, {"type": "subtitle", "time": 13864.83, "timestamp": "03:51:04", "text": "亚马逊愿望清单。我应该写些什么呢？"}, {"type": "subtitle", "time": 13866.75, "timestamp": "03:51:06", "text": "在？坏的"}, {"type": "subtitle", "time": 13871.99, "timestamp": "03:51:11", "text": "什么？非洲裔。等待。不，就是这样。"}, {"type": "subtitle", "time": 13874.309, "timestamp": "03:51:14", "text": "这很可疑。这很可疑。不，不，别这样"}, {"type": "subtitle", "time": 13878.15, "timestamp": "03:51:18", "text": "一位18岁以上的主播。敢于直言不讳"}, {"type": "subtitle", "time": 13881.389, "timestamp": "03:51:21", "text": "雄鹿。但你想去18岁"}, {"type": "subtitle", "time": 13883.309, "timestamp": "03:51:23", "text": "加"}, {"type": "subtitle", "time": 13886.11, "timestamp": "03:51:26", "text": "服装。好的。"}, {"type": "subtitle", "time": 13901.269, "timestamp": "03:51:41", "text": "很多。真糟糕，东西太少了。"}, {"type": "subtitle", "time": 13904.99, "timestamp": "03:51:44", "text": "emo 表情贴纸"}, {"type": "subtitle", "time": 13908.269, "timestamp": "03:51:48", "text": "这里。所以，就是这样。"}, {"type": "subtitle", "time": 13912.55, "timestamp": "03:51:52", "text": "疼痛。这次我们出去吧，去……"}]
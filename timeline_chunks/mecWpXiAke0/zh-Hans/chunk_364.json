[{"type": "subtitle", "time": 21842.548, "timestamp": "06:04:02", "text": "我有很多话想说，也想表达我的看法。"}, {"type": "subtitle", "time": 21845.43, "timestamp": "06:04:05", "text": "在每个事件中"}, {"type": "subtitle", "time": 21846.67, "timestamp": "06:04:06", "text": "呃，在"}, {"type": "subtitle", "time": 21849.59, "timestamp": "06:04:09", "text": "玩游戏的时候，我太专注于……"}, {"type": "subtitle", "time": 21851.51, "timestamp": "06:04:11", "text": "事情很多，而且我经常被打断。"}, {"type": "subtitle", "time": 21854.59, "timestamp": "06:04:14", "text": "这些天，以及今天的直播，"}, {"type": "subtitle", "time": 21857.19, "timestamp": "06:04:17", "text": "出色地。所以我不知道该怎么办"}, {"type": "subtitle", "time": 21861.59, "timestamp": "06:04:21", "text": "我应该减少直播时间吗？"}, {"type": "subtitle", "time": 21864.31, "timestamp": "06:04:24", "text": "我好像不能一直直播了。"}, {"type": "subtitle", "time": 21870.788, "timestamp": "06:04:30", "text": "到。更像是……呃，该怎么称呼它呢？"}, {"type": "subtitle", "time": 21872.788, "timestamp": "06:04:32", "text": "它？我的自由被剥夺了，或者"}, {"type": "subtitle", "time": 21874.35, "timestamp": "06:04:34", "text": "某物。我不"}, {"type": "subtitle", "time": 21878.15, "timestamp": "06:04:38", "text": "知道。我不知道。也许是因为……"}, {"type": "subtitle", "time": 21880.31, "timestamp": "06:04:40", "text": "独生子女需要你做很多事。"}, {"type": "subtitle", "time": 21883.31, "timestamp": "06:04:43", "text": "就在房子里。所以这有点像是"}, {"type": "subtitle", "time": 21893.59, "timestamp": "06:04:53", "text": "知道。所以我不知道关于……的事情。"}, {"type": "subtitle", "time": 21895.51, "timestamp": "06:04:55", "text": "所以我想我也会尝试一下。"}, {"type": "subtitle", "time": 21898.11, "timestamp": "06:04:58", "text": "我下周要改时间。"}]
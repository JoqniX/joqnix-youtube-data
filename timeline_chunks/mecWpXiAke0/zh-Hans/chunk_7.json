[{"type": "subtitle", "time": 421.189, "timestamp": "00:07:01", "text": "出色地。甚至连他们玩过哪些游戏都不知道"}, {"type": "subtitle", "time": 424.309, "timestamp": "00:07:04", "text": "播放主播播放的内容等等"}, {"type": "subtitle", "time": 426.87, "timestamp": "00:07:06", "text": "呃，里面有字母 Q，"}, {"type": "subtitle", "time": 428.79, "timestamp": "00:07:08", "text": "他们玩的所有游戏都用到了字母 Q。"}, {"type": "subtitle", "time": 431.27, "timestamp": "00:07:11", "text": "以及所有的一切。兄弟，这简直就是"}, {"type": "subtitle", "time": 434.43, "timestamp": "00:07:14", "text": "正是如此"}, {"type": "subtitle", "time": 437.07, "timestamp": "00:07:17", "text": "通缉。这真是太"}, {"type": "subtitle", "time": 442.189, "timestamp": "00:07:22", "text": "好的。太棒了。我想要这个"}, {"type": "subtitle", "time": 445.029, "timestamp": "00:07:25", "text": "我。我想要这个。谁干的"}, {"type": "subtitle", "time": 447.15, "timestamp": "00:07:27", "text": "网络"}, {"type": "subtitle", "time": 453.23, "timestamp": "00:07:33", "text": "设计？呃，巴里·卡兰。"}, {"type": "subtitle", "time": 455.95, "timestamp": "00:07:35", "text": "卡兰。天哪，这太"}, {"type": "subtitle", "time": 458.11, "timestamp": "00:07:38", "text": "[音乐]"}, {"type": "subtitle", "time": 461.749, "timestamp": "00:07:41", "text": "好的。太棒了。本网站是"}, {"type": "subtitle", "time": 467.749, "timestamp": "00:07:47", "text": "好的。这个网站，而且它们都在线。"}, {"type": "subtitle", "time": 469.27, "timestamp": "00:07:49", "text": "现在。"}, {"type": "subtitle", "time": 471.51, "timestamp": "00:07:51", "text": "以及玩游戏。这是什么游戏？"}, {"type": "subtitle", "time": 478.909, "timestamp": "00:07:58", "text": "蓝图。这真是太个性化了，"}]
[{"type": "subtitle", "time": 15243.63, "timestamp": "04:14:03", "text": "[音乐]"}, {"type": "subtitle", "time": 15250.07, "timestamp": "04:14:10", "text": "尽管。我会删除那条评论。得到"}, {"type": "subtitle", "time": 15262.11, "timestamp": "04:14:22", "text": "新鲜又好东西，而且是"}, {"type": "subtitle", "time": 15265.11, "timestamp": "04:14:25", "text": "足够的。我女朋友嫁给我。这里"}, {"type": "subtitle", "time": 15271.11, "timestamp": "04:14:31", "text": "你所谓的“你做什么”？"}, {"type": "subtitle", "time": 15274.229, "timestamp": "04:14:34", "text": "是指失业吗？我是失业者吗？不。是"}, {"type": "subtitle", "time": 15276.189, "timestamp": "04:14:36", "text": "天使"}, {"type": "subtitle", "time": 15280.07, "timestamp": "04:14:40", "text": "失业了吗？你比我们任何人都努力。"}, {"type": "subtitle", "time": 15285.349, "timestamp": "04:14:45", "text": "[音乐]"}, {"type": "subtitle", "time": 15287.11, "timestamp": "04:14:47", "text": "我讨厌别人告诉我，活着本身就是一种价值。"}]
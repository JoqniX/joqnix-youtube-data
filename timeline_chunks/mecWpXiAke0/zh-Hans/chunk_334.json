[{"type": "subtitle", "time": 20045.56, "timestamp": "05:34:05", "text": "那。明天见。"}, {"type": "subtitle", "time": 20050.75, "timestamp": "05:34:10", "text": "没有"}, {"type": "subtitle", "time": 20058.628, "timestamp": "05:34:18", "text": "等等，我要做体检，我没有……"}, {"type": "subtitle", "time": 20060.15, "timestamp": "05:34:20", "text": "我什么都不想做，只想离开。"}, {"type": "subtitle", "time": 20063.75, "timestamp": "05:34:23", "text": "尽情玩吧，把所有白痴都忘掉。"}, {"type": "subtitle", "time": 20067.89, "timestamp": "05:34:27", "text": "网络没问题，你想去哪里？"}, {"type": "subtitle", "time": 20077.868, "timestamp": "05:34:37", "text": "只需要一块地。"}, {"type": "subtitle", "time": 20080.88, "timestamp": "05:34:40", "text": "是的。只剩下我一个人了"}, {"type": "subtitle", "time": 20092.83, "timestamp": "05:34:52", "text": "[音乐]"}]
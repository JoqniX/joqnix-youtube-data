[{"type": "subtitle", "time": 19442.15, "timestamp": "05:24:02", "text": "天哪，我刚才感觉好真实。这"}, {"type": "subtitle", "time": 19444.55, "timestamp": "05:24:04", "text": "我觉得我可以继续写下去。"}, {"type": "subtitle", "time": 19446.23, "timestamp": "05:24:06", "text": "相信我。有时候真的会很"}, {"type": "subtitle", "time": 19449.03, "timestamp": "05:24:09", "text": "点击量有点大，但就是有这样的时刻。但我"}, {"type": "subtitle", "time": 19451.91, "timestamp": "05:24:11", "text": "记住，我真的可以爱"}, {"type": "subtitle", "time": 19458.948, "timestamp": "05:24:18", "text": "时间。我的天哪。如果她不小心……"}, {"type": "subtitle", "time": 19460.47, "timestamp": "05:24:20", "text": "其他推文"}, {"type": "subtitle", "time": 19463.47, "timestamp": "05:24:23", "text": "[音乐]"}, {"type": "subtitle", "time": 19466.27, "timestamp": "05:24:26", "text": "一？我达到了10万"}, {"type": "subtitle", "time": 19468.07, "timestamp": "05:24:28", "text": "订阅者。这是我第一次"}, {"type": "subtitle", "time": 19469.51, "timestamp": "05:24:29", "text": "影响了很多人。我不知道那是什么"}, {"type": "subtitle", "time": 19472.868, "timestamp": "05:24:32", "text": "接下来的事情就从这里开始。所以，我是一名"}, {"type": "subtitle", "time": 19474.868, "timestamp": "05:24:34", "text": "有点紧张。感觉像是要看"}, {"type": "subtitle", "time": 19477.19, "timestamp": "05:24:37", "text": "我的统计数据很丰富。我知道我总是"}, {"type": "subtitle", "time": 19478.55, "timestamp": "05:24:38", "text": "抱怨北方之类的，"}, {"type": "subtitle", "time": 19479.91, "timestamp": "05:24:39", "text": "但如果没有他们，我就不会在这里。"}, {"type": "subtitle", "time": 19481.708, "timestamp": "05:24:41", "text": "支持与命运。"}, {"type": "subtitle", "time": 19484.628, "timestamp": "05:24:44", "text": "啊，就他们的装饰而言，他们才是最棒的。"}, {"type": "subtitle", "time": 19486.708, "timestamp": "05:24:46", "text": "那把我从网上举报了。我做了"}, {"type": "subtitle", "time": 19488.43, "timestamp": "05:24:48", "text": "去找天使"}, {"type": "subtitle", "time": 19490.47, "timestamp": "05:24:50", "text": "小时。下次直播时，我打算……"}, {"type": "subtitle", "time": 19492.31, "timestamp": "05:24:52", "text": "谈论互联网并尝试讲述"}, {"type": "subtitle", "time": 19494.67, "timestamp": "05:24:54", "text": "我离这一切还有多远？"}]
[{"type": "subtitle", "time": 18603.83, "timestamp": "05:10:03", "text": "但事情因此变得有点失控。"}, {"type": "subtitle", "time": 18606.47, "timestamp": "05:10:06", "text": "我的天哪，我不想她变坏。"}, {"type": "subtitle", "time": 18615.51, "timestamp": "05:10:15", "text": "我的天哪，我觉得压力好大……"}, {"type": "subtitle", "time": 18621.91, "timestamp": "05:10:21", "text": "难的。呃，我醒来的时候太阳已经升起来了。"}, {"type": "subtitle", "time": 18624.39, "timestamp": "05:10:24", "text": "环境。大多数时候我都会感觉头晕目眩。我可以吗？"}, {"type": "subtitle", "time": 18626.75, "timestamp": "05:10:26", "text": "就睡觉？"}, {"type": "subtitle", "time": 18628.51, "timestamp": "05:10:28", "text": "当然。"}, {"type": "subtitle", "time": 18630.948, "timestamp": "05:10:30", "text": "是的。现在我不想撒谎，也不想继续活下去。"}, {"type": "subtitle", "time": 18632.51, "timestamp": "05:10:32", "text": "不再是了。"}, {"type": "subtitle", "time": 18634.91, "timestamp": "05:10:34", "text": "我"}, {"type": "subtitle", "time": 18636.83, "timestamp": "05:10:36", "text": "不"}, {"type": "subtitle", "time": 18649.46, "timestamp": "05:10:49", "text": "更多的。你呢？"}, {"type": "subtitle", "time": 18650.99, "timestamp": "05:10:50", "text": "[音乐]"}]
[{"type": "subtitle", "time": 12602.83, "timestamp": "03:30:02", "text": "就像我一样，带着这些进来吧"}, {"type": "subtitle", "time": 12605.75, "timestamp": "03:30:05", "text": "笑话。你是新来的吗？见鬼，那是他的。"}, {"type": "subtitle", "time": 12610.18, "timestamp": "03:30:10", "text": "最后一次直播游戏了。怀旧"}, {"type": "subtitle", "time": 12611.79, "timestamp": "03:30:11", "text": "[音乐]"}, {"type": "subtitle", "time": 12615.349, "timestamp": "03:30:15", "text": "直播永远不会过时。好的。什么游戏"}, {"type": "subtitle", "time": 12620.51, "timestamp": "03:30:20", "text": "玩吗？"}, {"type": "subtitle", "time": 12623.03, "timestamp": "03:30:23", "text": "激发。我们想考察一些真正"}, {"type": "subtitle", "time": 12625.59, "timestamp": "03:30:25", "text": "今日的古代文物。文物。"}, {"type": "subtitle", "time": 12629.389, "timestamp": "03:30:29", "text": "原神。问号。我喜欢视频"}, {"type": "subtitle", "time": 12633.75, "timestamp": "03:30:33", "text": "游戏。大家都很重视这些比赛"}, {"type": "subtitle", "time": 12635.83, "timestamp": "03:30:35", "text": "天。现在人人都直播游戏"}, {"type": "subtitle", "time": 12648.99, "timestamp": "03:30:48", "text": "游戏。是什么"}, {"type": "subtitle", "time": 12655.15, "timestamp": "03:30:55", "text": "选择。那是什么？极好的"}, {"type": "subtitle", "time": 12659.67, "timestamp": "03:30:59", "text": "放。这是一条超级聊天信息。你看起来你"}]
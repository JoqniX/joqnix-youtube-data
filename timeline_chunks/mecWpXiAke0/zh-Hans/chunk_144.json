[{"type": "subtitle", "time": 8645.99, "timestamp": "02:24:05", "text": "96. 这将使我无法"}, {"type": "subtitle", "time": 8648.99, "timestamp": "02:24:08", "text": "玩电子游戏什么的。"}, {"type": "subtitle", "time": 8651.48, "timestamp": "02:24:11", "text": "老兄，这真是"}, {"type": "subtitle", "time": 8662.75, "timestamp": "02:24:22", "text": "坏的。我将如何查看我的物品"}, {"type": "subtitle", "time": 8665.75, "timestamp": "02:24:25", "text": "更好的。如果我换个设备的话"}, {"type": "subtitle", "time": 8667.469, "timestamp": "02:24:27", "text": "或者电话，我本来可以有"}, {"type": "subtitle", "time": 8669.68, "timestamp": "02:24:29", "text": "确实检查过了"}, {"type": "subtitle", "time": 8671.07, "timestamp": "02:24:31", "text": "[音乐]"}, {"type": "subtitle", "time": 8674.55, "timestamp": "02:24:34", "text": "它。好吧，我决定冒险一试。我们开始吧"}, {"type": "subtitle", "time": 8676.67, "timestamp": "02:24:36", "text": "我们来吧"}, {"type": "subtitle", "time": 8679.91, "timestamp": "02:24:39", "text": "发射计划一。我只是想"}, {"type": "subtitle", "time": 8687.15, "timestamp": "02:24:47", "text": "好的，我这就去查一下。"}, {"type": "subtitle", "time": 8690.55, "timestamp": "02:24:50", "text": "它有多卡顿。"}, {"type": "subtitle", "time": 8692.45, "timestamp": "02:24:52", "text": "我的天啊。 100%"}, {"type": "subtitle", "time": 8694.27, "timestamp": "02:24:54", "text": "[音乐]"}]
[{"type": "subtitle", "time": 11942.229, "timestamp": "03:19:02", "text": "[音乐]"}, {"type": "subtitle", "time": 11945.309, "timestamp": "03:19:05", "text": "伙计，粉丝们肯定会喜欢的，所以"}, {"type": "subtitle", "time": 11948.79, "timestamp": "03:19:08", "text": "慷慨的。稍等，我会回复。"}, {"type": "subtitle", "time": 11951.75, "timestamp": "03:19:11", "text": "你选择的评论。哦，不。我的天啊。"}, {"type": "subtitle", "time": 11955.51, "timestamp": "03:19:15", "text": "等待。可爱天使来了。好的。嘿"}, {"type": "subtitle", "time": 11957.67, "timestamp": "03:19:17", "text": "每个人。这是我第一次见面。"}, {"type": "subtitle", "time": 11959.51, "timestamp": "03:19:19", "text": "我的天啊。可爱天使。等等，等等，"}, {"type": "subtitle", "time": 11962.03, "timestamp": "03:19:22", "text": "等待。我看不懂。"}, {"type": "subtitle", "time": 11966.229, "timestamp": "03:19:26", "text": "哦，我的粉丝数达到了10万。"}, {"type": "subtitle", "time": 11967.95, "timestamp": "03:19:27", "text": "一次成功。"}, {"type": "subtitle", "time": 11973.229, "timestamp": "03:19:33", "text": "如何？"}, {"type": "subtitle", "time": 11977.83, "timestamp": "03:19:37", "text": "天使终于在世界各地被召唤出来"}, {"type": "subtitle", "time": 11982.07, "timestamp": "03:19:42", "text": "花了这么长时间。我们获得了100个订阅者"}, {"type": "subtitle", "time": 11984.87, "timestamp": "03:19:44", "text": "更多订阅者。嗯？那不是"}, {"type": "subtitle", "time": 11986.95, "timestamp": "03:19:46", "text": "足够的。我希望更多人喜欢我"}, {"type": "subtitle", "time": 11990.229, "timestamp": "03:19:50", "text": "我。什么？我会非常高兴，我会"}, {"type": "subtitle", "time": 11993.389, "timestamp": "03:19:53", "text": "如果我有1000块钱，我会哭一整周。"}, {"type": "subtitle", "time": 11995.71, "timestamp": "03:19:55", "text": "粉丝。哦，我的"}, {"type": "subtitle", "time": 11998.79, "timestamp": "03:19:58", "text": "天哪，我们才刚刚……"}]
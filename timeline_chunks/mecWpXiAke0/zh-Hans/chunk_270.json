[{"type": "subtitle", "time": 16201.67, "timestamp": "04:30:01", "text": "她有时就是这样。我的天啊。"}, {"type": "subtitle", "time": 16209.99, "timestamp": "04:30:09", "text": "汉娜。哦，不。不。人们会接受"}, {"type": "subtitle", "time": 16212.07, "timestamp": "04:30:12", "text": "它不一样。哦，不。不，不，不，不。"}, {"type": "subtitle", "time": 16226.229, "timestamp": "04:30:26", "text": "嗯，上面说一切都感觉可以掌控。"}, {"type": "subtitle", "time": 16229.79, "timestamp": "04:30:29", "text": "如果我服用一些，如果我服用过量。所以"}, {"type": "subtitle", "time": 16232.269, "timestamp": "04:30:32", "text": "等待"}, {"type": "subtitle", "time": 16239.87, "timestamp": "04:30:39", "text": "做这件事"}, {"type": "subtitle", "time": 16255.229, "timestamp": "04:30:55", "text": "她竟然结束了直播。等待，"}, {"type": "subtitle", "time": 16258.389, "timestamp": "04:30:58", "text": "什么？不，她快疯了。我的天啊，"}]
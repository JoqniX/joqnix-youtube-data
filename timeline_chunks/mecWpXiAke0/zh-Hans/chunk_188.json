[{"type": "subtitle", "time": 11296.389, "timestamp": "03:08:16", "text": "美好的。我感觉自己好像……出不去了"}, {"type": "subtitle", "time": 11297.87, "timestamp": "03:08:17", "text": "的"}, {"type": "subtitle", "time": 11301.389, "timestamp": "03:08:21", "text": "床？是的，我也是这么想的。"}, {"type": "subtitle", "time": 11304.79, "timestamp": "03:08:24", "text": "毛毡。我当时就是这种感觉。我想要，我不想"}, {"type": "subtitle", "time": 11307.51, "timestamp": "03:08:27", "text": "我不想起床。我"}, {"type": "subtitle", "time": 11308.67, "timestamp": "03:08:28", "text": "想"}, {"type": "subtitle", "time": 11312.79, "timestamp": "03:08:32", "text": "我的意思是，我是一个真正有……的人。"}, {"type": "subtitle", "time": 11315.389, "timestamp": "03:08:35", "text": "睡眠。我睡了大概两个小时。"}, {"type": "subtitle", "time": 11319.15, "timestamp": "03:08:39", "text": "今天。哇。我怎么会这样"}, {"type": "subtitle", "time": 11322.469, "timestamp": "03:08:42", "text": "活？我不知道。就像我只睡了一觉一样"}, {"type": "subtitle", "time": 11325.23, "timestamp": "03:08:45", "text": "2小时"}, {"type": "subtitle", "time": 11327.15, "timestamp": "03:08:47", "text": "今天。但它是"}, {"type": "subtitle", "time": 11331.349, "timestamp": "03:08:51", "text": "美好的。 2 或 4 小时。是的。所以，我一直"}, {"type": "subtitle", "time": 11337.15, "timestamp": "03:08:57", "text": "经常醒来好几次。所以，"}, {"type": "subtitle", "time": 11339.75, "timestamp": "03:08:59", "text": "是的。总之，呃，我们进入正题吧。"}]
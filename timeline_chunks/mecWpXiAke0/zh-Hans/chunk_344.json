[{"type": "subtitle", "time": 20640.948, "timestamp": "05:44:00", "text": "只需这样就能让他喜欢上我们"}, {"type": "subtitle", "time": 20649.63, "timestamp": "05:44:09", "text": "我，我的爱人。"}, {"type": "subtitle", "time": 20656.628, "timestamp": "05:44:16", "text": "[音乐]"}, {"type": "subtitle", "time": 20658.75, "timestamp": "05:44:18", "text": "好的。"}, {"type": "subtitle", "time": 20662.59, "timestamp": "05:44:22", "text": "呃，如何才能获得这个秘密？"}, {"type": "subtitle", "time": 20665.67, "timestamp": "05:44:25", "text": "文本。好的。好感度就是这样。"}, {"type": "subtitle", "time": 20676.11, "timestamp": "05:44:36", "text": "搜索。"}, {"type": "subtitle", "time": 20680.49, "timestamp": "05:44:40", "text": "小精灵们都在议论我。"}, {"type": "subtitle", "time": 20688.708, "timestamp": "05:44:48", "text": "不，我现在这样做是因为我"}, {"type": "subtitle", "time": 20696.67, "timestamp": "05:44:56", "text": "注意力。我的天啊。是的，我知道"}, {"type": "subtitle", "time": 20699.15, "timestamp": "05:44:59", "text": "我可以做这些"}]
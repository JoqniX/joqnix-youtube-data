[{"type": "subtitle", "time": 15368.55, "timestamp": "04:16:08", "text": "[音乐]"}, {"type": "subtitle", "time": 15371.429, "timestamp": "04:16:11", "text": "这枚戒指感觉像是……嗯……有力量。"}, {"type": "subtitle", "time": 15381.03, "timestamp": "04:16:21", "text": "诡异的。谢谢你的吻。谢谢。"}, {"type": "subtitle", "time": 15384.269, "timestamp": "04:16:24", "text": "谢谢大家！"}, {"type": "subtitle", "time": 15388.269, "timestamp": "04:16:28", "text": "妈妈。我应该……我应该这样做吗？"}, {"type": "subtitle", "time": 15399.429, "timestamp": "04:16:39", "text": "[音乐]"}, {"type": "subtitle", "time": 15401.59, "timestamp": "04:16:41", "text": "我喜欢能同时给予我爱和关怀的男人。"}, {"type": "subtitle", "time": 15409.11, "timestamp": "04:16:49", "text": "坏的。哟，喜欢你看到的吗？如果你这么做了，"}, {"type": "subtitle", "time": 15410.75, "timestamp": "04:16:50", "text": "我们再玩一次吧"}, {"type": "subtitle", "time": 15414.07, "timestamp": "04:16:54", "text": "明天。这是一个基地。那是天空"}, {"type": "subtitle", "time": 15415.07, "timestamp": "04:16:55", "text": "第一区"}, {"type": "subtitle", "time": 15417.87, "timestamp": "04:16:57", "text": "想想我的霰弹枪"}]
[{"type": "subtitle", "time": 13623.429, "timestamp": "03:47:03", "text": "[音乐]"}, {"type": "subtitle", "time": 13625.67, "timestamp": "03:47:05", "text": "感谢您的评论。我不得不保持沉默"}, {"type": "subtitle", "time": 13628.11, "timestamp": "03:47:08", "text": "一点点。"}, {"type": "subtitle", "time": 13630.59, "timestamp": "03:47:10", "text": "中断。嗨，我是"}, {"type": "subtitle", "time": 13633.51, "timestamp": "03:47:13", "text": "后退。我们是否应该有一个终点？"}, {"type": "subtitle", "time": 13636.71, "timestamp": "03:47:16", "text": "太拥挤了？不，我不应该。不，不，不"}, {"type": "subtitle", "time": 13656.87, "timestamp": "03:47:36", "text": "正确的？直播尖叫奖励。"}, {"type": "subtitle", "time": 13660.1, "timestamp": "03:47:40", "text": "接下来是两个三角形"}]
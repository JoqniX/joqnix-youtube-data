[{"type": "subtitle", "time": 16566.39, "timestamp": "04:36:06", "text": "我没有用过其他类似动漫的东西。"}, {"type": "subtitle", "time": 16573.029, "timestamp": "04:36:13", "text": "动漫。对偶像来说，这究竟有多难？"}, {"type": "subtitle", "time": 16575.429, "timestamp": "04:36:15", "text": "梦境让我有点伤感，或者说，现实让我有点伤感。"}, {"type": "subtitle", "time": 16576.949, "timestamp": "04:36:16", "text": "更重要的是多少钱。"}, {"type": "subtitle", "time": 16580.109, "timestamp": "04:36:20", "text": "你可以从"}, {"type": "subtitle", "time": 16583.029, "timestamp": "04:36:23", "text": "粉丝。是的，某种程度上来说，这也是事实。"}, {"type": "subtitle", "time": 16586.39, "timestamp": "04:36:26", "text": "说到偶像之类的东西。这"}, {"type": "subtitle", "time": 16588.75, "timestamp": "04:36:28", "text": "你榨取所有战斗的钱财"}, {"type": "subtitle", "time": 16592.349, "timestamp": "04:36:32", "text": "一切。我反正也不希望那样。"}, {"type": "subtitle", "time": 16600.31, "timestamp": "04:36:40", "text": "是的。哪条流与每股力量有关"}, {"type": "subtitle", "time": 16603.39, "timestamp": "04:36:43", "text": "魔法、希望，还有呃"}, {"type": "subtitle", "time": 16612.029, "timestamp": "04:36:52", "text": "[音乐]"}, {"type": "subtitle", "time": 16615.46, "timestamp": "04:36:55", "text": "想法。好的，我们需要药物。"}]
[{"type": "subtitle", "time": 16740.029, "timestamp": "04:39:00", "text": "就像看孩子一样"}, {"type": "subtitle", "time": 16742.709, "timestamp": "04:39:02", "text": "日本动画片。儿童动画挺有意思的。和"}, {"type": "subtitle", "time": 16744.269, "timestamp": "04:39:04", "text": "为了我的"}, {"type": "subtitle", "time": 16747.23, "timestamp": "04:39:07", "text": "脖子。你想吓唬那孩子，吓唬他。"}, {"type": "subtitle", "time": 16755.869, "timestamp": "04:39:15", "text": "[音乐]"}, {"type": "subtitle", "time": 16758.47, "timestamp": "04:39:18", "text": "那。我蒙主恩宠而得救。"}, {"type": "subtitle", "time": 16760.47, "timestamp": "04:39:20", "text": "某个女孩的动漫，我觉得"}, {"type": "subtitle", "time": 16763.75, "timestamp": "04:39:23", "text": "它们如此吸引人的原因就在于它们的纯粹性。"}, {"type": "subtitle", "time": 16766.91, "timestamp": "04:39:26", "text": "没错。"}, {"type": "subtitle", "time": 16770.551, "timestamp": "04:39:30", "text": "嗯？单人虫火灵感和"}, {"type": "subtitle", "time": 16773.31, "timestamp": "04:39:33", "text": "爱情真是太鼓舞人心了，你"}, {"type": "subtitle", "time": 16775.709, "timestamp": "04:39:35", "text": "知道。我有"}, {"type": "subtitle", "time": 16779.27, "timestamp": "04:39:39", "text": "17000名观众正在观看。我的天哪，他们"}, {"type": "subtitle", "time": 16782.03, "timestamp": "04:39:42", "text": "天使很受欢迎。哦，我的"}, {"type": "subtitle", "time": 16792.03, "timestamp": "04:39:52", "text": "[音乐]"}, {"type": "subtitle", "time": 16794.948, "timestamp": "04:39:54", "text": "女孩们。我喜欢有小女孩的女孩"}, {"type": "subtitle", "time": 16797.83, "timestamp": "04:39:57", "text": "我喜欢有小女孩的动漫。他"}]
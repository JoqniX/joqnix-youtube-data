[{"type": "subtitle", "time": 14820.349, "timestamp": "04:07:00", "text": "[音乐]"}, {"type": "subtitle", "time": 14829.229, "timestamp": "04:07:09", "text": "摄像头。秘密是什么？"}, {"type": "subtitle", "time": 14833.63, "timestamp": "04:07:13", "text": "文本？这里隐藏的文字是什么？"}, {"type": "subtitle", "time": 14836.229, "timestamp": "04:07:16", "text": "嗯？把它们收起来。我想看看什么"}, {"type": "subtitle", "time": 14845.91, "timestamp": "04:07:25", "text": "什么？"}, {"type": "subtitle", "time": 14855.63, "timestamp": "04:07:35", "text": "嗯？"}, {"type": "subtitle", "time": 14858.71, "timestamp": "04:07:38", "text": "什么？我说，嗯，我要倒下了，"}, {"type": "subtitle", "time": 14860.79, "timestamp": "04:07:40", "text": "我不想出名，也不想像100那样。"}, {"type": "subtitle", "time": 14862.63, "timestamp": "04:07:42", "text": "实际上，是一百万。我愿意以最低价格出售它"}, {"type": "subtitle", "time": 14864.52, "timestamp": "04:07:44", "text": "几分钟。所以"}, {"type": "subtitle", "time": 14869.309, "timestamp": "04:07:49", "text": "[音乐]"}]
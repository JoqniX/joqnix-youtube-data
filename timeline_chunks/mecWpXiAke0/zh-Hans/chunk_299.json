[{"type": "subtitle", "time": 17942.47, "timestamp": "04:59:02", "text": "当人们对……感到厌倦时，我会感到惊讶。"}, {"type": "subtitle", "time": 17946.03, "timestamp": "04:59:06", "text": "他们自己的专家。等待，"}, {"type": "subtitle", "time": 17947.94, "timestamp": "04:59:07", "text": "什么？"}, {"type": "subtitle", "time": 17950.11, "timestamp": "04:59:10", "text": "[音乐]"}, {"type": "subtitle", "time": 17954.43, "timestamp": "04:59:14", "text": "亲爱的，不算数。"}, {"type": "subtitle", "time": 17957.54, "timestamp": "04:59:17", "text": "好的。我的天哪。"}, {"type": "subtitle", "time": 17968.868, "timestamp": "04:59:28", "text": "[音乐]"}, {"type": "subtitle", "time": 17971.03, "timestamp": "04:59:31", "text": "我收到了一堆邮件。"}, {"type": "subtitle", "time": 17974.23, "timestamp": "04:59:34", "text": "说些关于税收和国家乱七八糟的事。这"}, {"type": "subtitle", "time": 17985.91, "timestamp": "04:59:45", "text": "上帝。等待。呃，在我们走之前，我需要一个"}, {"type": "subtitle", "time": 17991.868, "timestamp": "04:59:51", "text": "[音乐]"}, {"type": "subtitle", "time": 17993.99, "timestamp": "04:59:53", "text": "她正在寻找她计划要的东西。"}, {"type": "subtitle", "time": 17995.99, "timestamp": "04:59:55", "text": "希望她一切顺利。她的东西"}, {"type": "subtitle", "time": 17999.03, "timestamp": "04:59:59", "text": "她这样做非常恰当，应该去拜访她的朋友们。"}]
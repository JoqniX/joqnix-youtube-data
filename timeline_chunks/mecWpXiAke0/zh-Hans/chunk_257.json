[{"type": "subtitle", "time": 15420.95, "timestamp": "04:17:00", "text": "框架。但最长的绕路方式是"}, {"type": "subtitle", "time": 15422.63, "timestamp": "04:17:02", "text": "右侧是霰弹枪枪架。我不能就这么"}, {"type": "subtitle", "time": 15424.269, "timestamp": "04:17:04", "text": "忽略此内容"}, {"type": "subtitle", "time": 15428.67, "timestamp": "04:17:08", "text": "生长。增长率为38%。哦，我的"}, {"type": "subtitle", "time": 15440.95, "timestamp": "04:17:20", "text": "等级。你会看到一个小小的参考资料，"}, {"type": "subtitle", "time": 15445.03, "timestamp": "04:17:25", "text": "那是我Windows XP系统下的所有屏幕内容。"}, {"type": "subtitle", "time": 15447.229, "timestamp": "04:17:27", "text": "[音乐]"}, {"type": "subtitle", "time": 15451.75, "timestamp": "04:17:31", "text": "哦，等等。我伸手想做一些事"}, {"type": "subtitle", "time": 15453.309, "timestamp": "04:17:33", "text": "[音乐]"}, {"type": "subtitle", "time": 15456.469, "timestamp": "04:17:36", "text": "版本。等等，她达到10000粉丝了吗？哦，"}, {"type": "subtitle", "time": 15457.63, "timestamp": "04:17:37", "text": "等待。她"}, {"type": "subtitle", "time": 15460.51, "timestamp": "04:17:40", "text": "做过。但你很清楚这个案子。其余部分"}, {"type": "subtitle", "time": 15465.11, "timestamp": "04:17:45", "text": "我的脑子里全是龙，还有它"}, {"type": "subtitle", "time": 15467.11, "timestamp": "04:17:47", "text": "原本是为了服务，但我现在在制作内容"}, {"type": "subtitle", "time": 15470.67, "timestamp": "04:17:50", "text": "我的大脑很强大，所以我需要出其不意。"}, {"type": "subtitle", "time": 15474.95, "timestamp": "04:17:54", "text": "那块垫脚石，我迈出的第一步"}, {"type": "subtitle", "time": 15476.87, "timestamp": "04:17:56", "text": "作为一名传奇突袭者，我将……"}, {"type": "subtitle", "time": 15479.309, "timestamp": "04:17:59", "text": "让大家都来庆祝"}]
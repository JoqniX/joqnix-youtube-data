[{"type": "subtitle", "time": 19563.55, "timestamp": "05:26:03", "text": "[音乐]"}, {"type": "subtitle", "time": 19568.628, "timestamp": "05:26:08", "text": "我错过了好多BL剧，我一直很关注它们。"}, {"type": "subtitle", "time": 19578.628, "timestamp": "05:26:18", "text": "BL玩一款经典恐怖游戏，等等"}, {"type": "subtitle", "time": 19581.83, "timestamp": "05:26:21", "text": "瞧瞧，我找到一些真东西了"}, {"type": "subtitle", "time": 19583.43, "timestamp": "05:26:23", "text": "关于百老汇，我认为最好的游戏是"}, {"type": "subtitle", "time": 19585.19, "timestamp": "05:26:25", "text": "晚上玩的直播游戏是恐怖游戏"}, {"type": "subtitle", "time": 19588.55, "timestamp": "05:26:28", "text": "但是，这样做也太容易了。"}, {"type": "subtitle", "time": 19589.708, "timestamp": "05:26:29", "text": "内容"}, {"type": "subtitle", "time": 19592.47, "timestamp": "05:26:32", "text": "我会把所有的钱都花在游戏上，所以游戏"}, {"type": "subtitle", "time": 19595.628, "timestamp": "05:26:35", "text": "夜间游戏是一个绝佳的机会，可以创造……"}, {"type": "subtitle", "time": 19599.03, "timestamp": "05:26:39", "text": "它。我敢打赌，我可以从他们那里榨取到很多东西。"}, {"type": "subtitle", "time": 19600.788, "timestamp": "05:26:40", "text": "虽然有点尖叫。并非如此"}, {"type": "subtitle", "time": 19603.11, "timestamp": "05:26:43", "text": "我会有很多尖叫的机会，因为"}, {"type": "subtitle", "time": 19606.75, "timestamp": "05:26:46", "text": "我找到了归宿，因为我是上帝的信徒。这呃"}, {"type": "subtitle", "time": 19614.07, "timestamp": "05:26:54", "text": "宝贝们，又名哦耶。是的，我知道。我是"}, {"type": "subtitle", "time": 19616.35, "timestamp": "05:26:56", "text": "黄色的。我有时确实会这样读。"}, {"type": "subtitle", "time": 19618.65, "timestamp": "05:26:58", "text": "出色地。全部"}]
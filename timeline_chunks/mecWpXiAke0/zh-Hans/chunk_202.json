[{"type": "subtitle", "time": 12120.47, "timestamp": "03:22:00", "text": "分开。它是"}, {"type": "subtitle", "time": 12127.309, "timestamp": "03:22:07", "text": "好的。好的。为什么"}, {"type": "subtitle", "time": 12132.03, "timestamp": "03:22:12", "text": "究竟为什么会有这样的对话？"}, {"type": "subtitle", "time": 12135.95, "timestamp": "03:22:15", "text": "呗？哦，我自己就能把你打垮。"}, {"type": "subtitle", "time": 12138.269, "timestamp": "03:22:18", "text": "什么？"}, {"type": "subtitle", "time": 12142.469, "timestamp": "03:22:22", "text": "嗯？嗯？我真的不想那样做。"}, {"type": "subtitle", "time": 12146.63, "timestamp": "03:22:26", "text": "作为一个不是“我的天哪”的人。"}, {"type": "subtitle", "time": 12149.19, "timestamp": "03:22:29", "text": "那我把骑师放在这里吧，这样我们"}, {"type": "subtitle", "time": 12156.95, "timestamp": "03:22:36", "text": "好的。是的，你可以。你是什​​么意思"}, {"type": "subtitle", "time": 12160.51, "timestamp": "03:22:40", "text": "你可以吗？喂。不要同意。"}, {"type": "subtitle", "time": 12163.19, "timestamp": "03:22:43", "text": "喂。您可以将密钥集发送回"}, {"type": "subtitle", "time": 12165.83, "timestamp": "03:22:45", "text": "如果你想成为其中一员，那就来找我吧"}]
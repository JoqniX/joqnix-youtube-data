[{"type": "subtitle", "time": 3900.109, "timestamp": "01:05:00", "text": "桌面音频"}, {"type": "subtitle", "time": 3903.15, "timestamp": "01:05:03", "text": "一切，即"}, {"type": "subtitle", "time": 3906.87, "timestamp": "01:05:06", "text": "坏的。这很糟糕。但没关系。我有"}, {"type": "subtitle", "time": 3907.789, "timestamp": "01:05:07", "text": "一个"}, {"type": "subtitle", "time": 3911.069, "timestamp": "01:05:11", "text": "主意。我必须规划我的整个路线"}, {"type": "subtitle", "time": 3913.91, "timestamp": "01:05:13", "text": "事物。所以，我得把我的所有东西都翻过来。"}, {"type": "subtitle", "time": 3922.63, "timestamp": "01:05:22", "text": "[音乐]"}, {"type": "subtitle", "time": 3927.029, "timestamp": "01:05:27", "text": "但是，是啊，我们活着。我不认为"}, {"type": "subtitle", "time": 3929.789, "timestamp": "01:05:29", "text": "很多人会来"}, {"type": "subtitle", "time": 3933.67, "timestamp": "01:05:33", "text": "因为我最近没怎么活跃。但"}, {"type": "subtitle", "time": 3935.67, "timestamp": "01:05:35", "text": "是的，现在信仰之流就在这里了。"}, {"type": "subtitle", "time": 3937.99, "timestamp": "01:05:37", "text": "从现在开始。所以我很兴奋"}, {"type": "subtitle", "time": 3941.95, "timestamp": "01:05:41", "text": "这件事就到此为止。但事情将会是"}, {"type": "subtitle", "time": 3947.39, "timestamp": "01:05:47", "text": "我的电脑运行起来会很吃力。"}, {"type": "subtitle", "time": 3950.349, "timestamp": "01:05:50", "text": "很多。这是我……"}, {"type": "subtitle", "time": 3952.829, "timestamp": "01:05:52", "text": "担心。"}]
[{"type": "subtitle", "time": 16024.87, "timestamp": "04:27:04", "text": "我？我很好。看起来不错，但我"}, {"type": "subtitle", "time": 16026.189, "timestamp": "04:27:06", "text": "有前途"}, {"type": "subtitle", "time": 16028.71, "timestamp": "04:27:08", "text": "没有什么。哦，不。"}, {"type": "subtitle", "time": 16030.99, "timestamp": "04:27:10", "text": "我知道我的手腕有多痛。"}, {"type": "subtitle", "time": 16034.59, "timestamp": "04:27:14", "text": "这是我内心深处的感受。哦"}, {"type": "subtitle", "time": 16037.349, "timestamp": "04:27:17", "text": "不。为什么我无法感同身受？"}, {"type": "subtitle", "time": 16039.99, "timestamp": "04:27:19", "text": "我不知道。黑暗是一个重要的"}, {"type": "subtitle", "time": 16042.269, "timestamp": "04:27:22", "text": "信息。哦"}, {"type": "subtitle", "time": 16053.229, "timestamp": "04:27:33", "text": "永远。哦"}, {"type": "subtitle", "time": 16055.91, "timestamp": "04:27:35", "text": "不。切开后就是闪电"}, {"type": "subtitle", "time": 16058.309, "timestamp": "04:27:38", "text": "我的天啊。"}]
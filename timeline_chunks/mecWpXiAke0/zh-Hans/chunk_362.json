[{"type": "subtitle", "time": 21723.47, "timestamp": "06:02:03", "text": "和"}, {"type": "subtitle", "time": 21725.95, "timestamp": "06:02:05", "text": "授予前往"}, {"type": "subtitle", "time": 21731.628, "timestamp": "06:02:11", "text": "[音乐]"}, {"type": "subtitle", "time": 21734.83, "timestamp": "06:02:14", "text": "黄昏我的"}, {"type": "subtitle", "time": 21738.788, "timestamp": "06:02:18", "text": "图片。我解锁了一些修复程序"}, {"type": "subtitle", "time": 21741.62, "timestamp": "06:02:21", "text": "图片在这里。"}, {"type": "subtitle", "time": 21743.628, "timestamp": "06:02:23", "text": "[音乐]"}, {"type": "subtitle", "time": 21746.15, "timestamp": "06:02:26", "text": "正确的。这些文件是我没有的。"}, {"type": "subtitle", "time": 21748.31, "timestamp": "06:02:28", "text": "开锁。我们今天解锁了这个"}, {"type": "subtitle", "time": 21750.47, "timestamp": "06:02:30", "text": "溪流。"}, {"type": "subtitle", "time": 21752.48, "timestamp": "06:02:32", "text": "看看她。真是太"}, {"type": "subtitle", "time": 21754.19, "timestamp": "06:02:34", "text": "[音乐]"}, {"type": "subtitle", "time": 21767.03, "timestamp": "06:02:47", "text": "在。我一分钟内拉了屎"}, {"type": "subtitle", "time": 21768.91, "timestamp": "06:02:48", "text": "流。我不能"}, {"type": "subtitle", "time": 21771.628, "timestamp": "06:02:51", "text": "没有"}, {"type": "subtitle", "time": 21774.23, "timestamp": "06:02:54", "text": "永远。好的。那么，我该如何保存呢？"}]
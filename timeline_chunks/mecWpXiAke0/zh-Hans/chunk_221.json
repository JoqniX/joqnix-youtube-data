[{"type": "subtitle", "time": 13260.87, "timestamp": "03:41:00", "text": "永远。我的天啊。即使有人"}, {"type": "subtitle", "time": 13262.309, "timestamp": "03:41:02", "text": "试着去找，又不是我"}, {"type": "subtitle", "time": 13264.15, "timestamp": "03:41:04", "text": "犯下犯罪行为。即使感觉"}, {"type": "subtitle", "time": 13266.63, "timestamp": "03:41:06", "text": "就像背叛一样，这就是我们"}, {"type": "subtitle", "time": 13268.83, "timestamp": "03:41:08", "text": "世界运转。哦，我的"}, {"type": "subtitle", "time": 13274.99, "timestamp": "03:41:14", "text": "上帝。什么样的人会做这种事？"}, {"type": "subtitle", "time": 13279.03, "timestamp": "03:41:19", "text": "哇。他们在直播中表现得都很友善"}, {"type": "subtitle", "time": 13284.99, "timestamp": "03:41:24", "text": "哇。"}, {"type": "subtitle", "time": 13304.87, "timestamp": "03:41:44", "text": "粉丝。你想帮我什么？"}, {"type": "subtitle", "time": 13307.51, "timestamp": "03:41:47", "text": "请停止玩游戏"}, {"type": "subtitle", "time": 13314.71, "timestamp": "03:41:54", "text": "它。骑上一只巨大的乌龟。是的。你好"}, {"type": "subtitle", "time": 13316.55, "timestamp": "03:41:56", "text": "儿子爱德华。你今天怎么样？"}, {"type": "subtitle", "time": 13319.19, "timestamp": "03:41:59", "text": "希望你一切都好。让我改变我的"}]
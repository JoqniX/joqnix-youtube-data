[{"type": "subtitle", "time": 21181.59, "timestamp": "05:53:01", "text": "随机。嗨，III。但我害怕……"}, {"type": "subtitle", "time": 21182.91, "timestamp": "05:53:02", "text": "这将"}, {"type": "subtitle", "time": 21186.47, "timestamp": "05:53:06", "text": "去。她和其他主播不一样，"}, {"type": "subtitle", "time": 21193.03, "timestamp": "05:53:13", "text": "当然。但她是个幻影。我的天啊。那是"}, {"type": "subtitle", "time": 21195.47, "timestamp": "05:53:15", "text": "那需要成为"}, {"type": "subtitle", "time": 21197.99, "timestamp": "05:53:17", "text": "我。她让我第一次露出了笑容。"}, {"type": "subtitle", "time": 21199.31, "timestamp": "05:53:19", "text": "在我的生活中。"}, {"type": "subtitle", "time": 21209.788, "timestamp": "05:53:29", "text": "主。"}, {"type": "subtitle", "time": 21212.59, "timestamp": "05:53:32", "text": "保佑。"}, {"type": "subtitle", "time": 21219.708, "timestamp": "05:53:39", "text": "再见。祝福。谢谢你提供的舒适环境"}, {"type": "subtitle", "time": 21224.19, "timestamp": "05:53:44", "text": "虾。好的。而我，确实如此。"}, {"type": "subtitle", "time": 21227.868, "timestamp": "05:53:47", "text": "不小心刚回到家就加了"}, {"type": "subtitle", "time": 21230.23, "timestamp": "05:53:50", "text": "代表？但你真的仔细看过所有的一切吗？"}, {"type": "subtitle", "time": 21239.35, "timestamp": "05:53:59", "text": "朋友们。等等，我到达了“否”。等等，"}]
[{"type": "subtitle", "time": 25280.23, "timestamp": "07:01:20", "text": "這不是事件。它提醒我，"}, {"type": "subtitle", "time": 25291.75, "timestamp": "07:01:31", "text": "或者說讓我堅持下去，就像，即使你在那裡"}, {"type": "subtitle", "time": 25300.468, "timestamp": "07:01:40", "text": "或不在那裡，它只是一輛車，但我是一顆星座，對吧？我會永遠在那裡，在天空中，永遠"}, {"type": "subtitle", "time": 25307.07, "timestamp": "07:01:47", "text": "守護著你，永遠張開雙臂迎接你，"}, {"type": "subtitle", "time": 25317.67, "timestamp": "07:01:57", "text": "就像無論你何時回來，或者即使你只是知道我的存在，對我來說就足夠了，對吧？我的意思是，這並非我第一次有這種感覺。"}]
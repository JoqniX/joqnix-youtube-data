[{"type": "subtitle", "time": 302.39, "timestamp": "00:05:02", "text": "等等。呃，你可以"}, {"type": "subtitle", "time": 305.99, "timestamp": "00:05:05", "text": "提交你的爸爸笑話，還有"}, {"type": "subtitle", "time": 307.15, "timestamp": "00:05:07", "text": "各種各樣的"}, {"type": "subtitle", "time": 311.51, "timestamp": "00:05:11", "text": "東西。很多事情，對吧？按讚"}, {"type": "subtitle", "time": 314.79, "timestamp": "00:05:14", "text": "並按讚查看。它們有個夾子之類的東西"}, {"type": "subtitle", "time": 318.23, "timestamp": "00:05:18", "text": "。你可以向網站提交影片片段"}, {"type": "subtitle", "time": 320.23, "timestamp": "00:05:20", "text": "。你在 YouTube"}, {"type": "subtitle", "time": 321.23, "timestamp": "00:05:21", "text": "或"}, {"type": "subtitle", "time": 327.67, "timestamp": "00:05:27", "text": "天啊。然後他們還有一個"}, {"type": "subtitle", "time": 330.39, "timestamp": "00:05:30", "text": "很酷的東西叫做戰爭聊天。所以這意味著，如果你"}, {"type": "subtitle", "time": 333.189, "timestamp": "00:05:33", "text": "點擊像"}, {"type": "subtitle", "time": 335.749, "timestamp": "00:05:35", "text": "他直播中的某個直播串流，對吧，你可以"}, {"type": "subtitle", "time": 339.029, "timestamp": "00:05:39", "text": "登入 Twitch 來獲取 YouTube"}, {"type": "subtitle", "time": 342.67, "timestamp": "00:05:42", "text": "上該特定直播的 Twitch 回放"}, {"type": "subtitle", "time": 346.07, "timestamp": "00:05:46", "text": "。好的。在 YouTube 上，你可以"}, {"type": "subtitle", "time": 349.67, "timestamp": "00:05:49", "text": "看到它已經嵌入到"}, {"type": "subtitle", "time": 353.11, "timestamp": "00:05:53", "text": "網站本身了。太酷了！不，"}, {"type": "subtitle", "time": 356.51, "timestamp": "00:05:56", "text": "你還能獲得遊戲訊息，"}, {"type": "subtitle", "time": 359.029, "timestamp": "00:05:59", "text": "igdb.com 上的遊戲介紹"}]
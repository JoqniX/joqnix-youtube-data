[{"type": "subtitle", "time": 16742.709, "timestamp": "04:39:02", "text": "不妙。  我睡不著。  不，我"}, {"type": "subtitle", "time": 16747.23, "timestamp": "04:39:07", "text": "不想讓她表現得"}, {"type": "subtitle", "time": 16755.869, "timestamp": "04:39:15", "text": "[音樂]"}, {"type": "subtitle", "time": 16758.47, "timestamp": "04:39:18", "text": "稍等。呃，我可以直播嗎？不，這不是，呃，這不是這個。  她有時就是這樣。我的天啊。  別"}, {"type": "subtitle", "time": 16760.47, "timestamp": "04:39:20", "text": "像個男人。  漢娜。哦，不。不，人們會有不同的反應。"}, {"type": "subtitle", "time": 16779.27, "timestamp": "04:39:39", "text": "哦，不。不，不，不，不，不，不，不"}]
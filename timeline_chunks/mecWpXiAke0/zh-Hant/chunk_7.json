[{"type": "subtitle", "time": 421.189, "timestamp": "00:07:01", "text": "。甚至知道他們玩過哪些遊戲，"}, {"type": "subtitle", "time": 424.309, "timestamp": "00:07:04", "text": "主播玩過哪些"}, {"type": "subtitle", "time": 428.79, "timestamp": "00:07:08", "text": "遊戲，以及所有字母 Q 的遊戲"}, {"type": "subtitle", "time": 431.27, "timestamp": "00:07:11", "text": "等等。兄弟，這正是"}, {"type": "subtitle", "time": 434.43, "timestamp": "00:07:14", "text": "我"}, {"type": "subtitle", "time": 437.07, "timestamp": "00:07:17", "text": "想要的。太棒了。太棒了。"}, {"type": "subtitle", "time": 442.189, "timestamp": "00:07:22", "text": "我想要這個。"}, {"type": "subtitle", "time": 447.15, "timestamp": "00:07:27", "text": "網頁"}, {"type": "subtitle", "time": 453.23, "timestamp": "00:07:33", "text": "設計是誰做的？呃，巴里·卡蘭。"}, {"type": "subtitle", "time": 455.95, "timestamp": "00:07:35", "text": "卡蘭。哇，這"}, {"type": "subtitle", "time": 458.11, "timestamp": "00:07:38", "text": "音樂"}, {"type": "subtitle", "time": 461.749, "timestamp": "00:07:41", "text": "太棒了。太棒了。這個網站"}, {"type": "subtitle", "time": 467.749, "timestamp": "00:07:47", "text": "太棒了。這個網站，他們現在就在線上"}, {"type": "subtitle", "time": 469.27, "timestamp": "00:07:49", "text": "。"}, {"type": "subtitle", "time": 471.51, "timestamp": "00:07:51", "text": "以及玩遊戲。這是什麼遊戲"}, {"type": "subtitle", "time": 478.909, "timestamp": "00:07:58", "text": "藍圖。這真是太有個性了，"}]
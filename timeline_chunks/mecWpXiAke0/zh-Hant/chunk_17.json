[{"type": "subtitle", "time": 1026.949, "timestamp": "00:17:06", "text": "。他們的系統真的很棒。"}, {"type": "subtitle", "time": 1035.909, "timestamp": "00:17:15", "text": "觀眾席和即時互動"}, {"type": "subtitle", "time": 1037.789, "timestamp": "00:17:17", "text": "評論"}, {"type": "subtitle", "time": 1040.429, "timestamp": "00:17:20", "text": "是什麼"}, {"type": "subtitle", "time": 1043.829, "timestamp": "00:17:23", "text": "？視線直播"}, {"type": "subtitle", "time": 1046.949, "timestamp": "00:17:26", "text": "工具會將我引導至開放式直播"}, {"type": "subtitle", "time": 1050.19, "timestamp": "00:17:30", "text": "設定。哦，廣播"}, {"type": "subtitle", "time": 1059.75, "timestamp": "00:17:39", "text": "恢復率、位元率、幀率。嗯，"}, {"type": "subtitle", "time": 1062.63, "timestamp": "00:17:42", "text": "編碼級別，低，中，高。好的，"}, {"type": "subtitle", "time": 1064.51, "timestamp": "00:17:44", "text": "我可以做"}, {"type": "subtitle", "time": 1072.35, "timestamp": "00:17:52", "text": "。"}, {"type": "subtitle", "time": 1075.75, "timestamp": "00:17:55", "text": "嗯，等等，我需要查看那些"}, {"type": "subtitle", "time": 1079.07, "timestamp": "00:17:59", "text": "設定是什麼。這就像一場虛擬"}]
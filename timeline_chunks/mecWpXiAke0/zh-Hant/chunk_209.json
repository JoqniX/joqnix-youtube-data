[{"type": "subtitle", "time": 12546.79, "timestamp": "03:29:06", "text": "打敗這個boss嗎？或許"}, {"type": "subtitle", "time": 12549.03, "timestamp": "03:29:09", "text": "我"}, {"type": "subtitle", "time": 12551.389, "timestamp": "03:29:11", "text": "可以為自己而戰。是我。好吧，這是一件不錯的武器。我開始慢慢掌握"}, {"type": "subtitle", "time": 12553.59, "timestamp": "03:29:13", "text": "串流媒體播放的技巧了。所以，我想做個"}, {"type": "subtitle", "time": 12555.19, "timestamp": "03:29:15", "text": "遊戲實況"}, {"type": "subtitle", "time": 12575.55, "timestamp": "03:29:35", "text": "現在是晚上。  [音樂] 走向黃昏。  他們說金錢買不到幸福，但幸福不是人生中你唯一需要擁有的東西。"}]
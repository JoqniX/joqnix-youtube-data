[{"type": "subtitle", "time": 36372.47, "timestamp": "10:06:12", "text": "沒有。"}, {"type": "subtitle", "time": 36381.11, "timestamp": "10:06:21", "text": "來。  [音樂]"}, {"type": "subtitle", "time": 36383.426, "timestamp": "10:06:23", "text": "他們在拍影片嗎？但他們玩得很開心，並且正在走自己的路。所以我不想打斷你。  所以他們其實是在喝木頭。"}, {"type": "subtitle", "time": 36387.35, "timestamp": "10:06:27", "text": "不，我不想失去我的水藍色毛絨玩具。  你好。他們在拍攝影片嗎"}]
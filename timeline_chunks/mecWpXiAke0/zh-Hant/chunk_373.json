[{"type": "subtitle", "time": 22382.548, "timestamp": "06:13:02", "text": "不用在意語音計量器的彈出視窗。  我換個模式看看。哦，是的，它保存了"}, {"type": "subtitle", "time": 22395.19, "timestamp": "06:13:15", "text": "。確實保存了。好的，保存成功了。那挺好的。那挺好的。確實保存了。"}, {"type": "subtitle", "time": 22420.39, "timestamp": "06:13:40", "text": "我"}, {"type": "subtitle", "time": 22424.43, "timestamp": "06:13:44", "text": "有很多話想說，想對遊戲中的每個事件發表我的看法，但我太專注於其他事情了，而且最近幾天我經常被打斷，今天的"}, {"type": "subtitle", "time": 22427.99, "timestamp": "06:13:47", "text": "直播也是如此。所以我不知道該怎麼辦，"}]
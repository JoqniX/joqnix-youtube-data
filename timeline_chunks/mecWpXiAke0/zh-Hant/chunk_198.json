[{"type": "subtitle", "time": 11882.15, "timestamp": "03:18:02", "text": "你今天怎麼樣？我知道我也忘了跟阿迪塔打招呼。  是的。希望你一切都好。"}, {"type": "subtitle", "time": 11901.87, "timestamp": "03:18:21", "text": "命令我做任何事。我"}, {"type": "subtitle", "time": 11904.309, "timestamp": "03:18:24", "text": "願意做。  向"}, {"type": "subtitle", "time": 11907.91, "timestamp": "03:18:27", "text": "瑪雅·卡桑問好。"}]
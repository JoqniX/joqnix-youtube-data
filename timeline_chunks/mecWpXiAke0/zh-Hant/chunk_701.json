[{"type": "subtitle", "time": 42083.35, "timestamp": "11:41:23", "text": "我知道你最近很忙，希望你一切都好，非常想念你，好久不見了，嗯，好久沒一起"}, {"type": "subtitle", "time": 42089.03, "timestamp": "11:41:29", "text": "玩"}, {"type": "subtitle", "time": 42093.106, "timestamp": "11:41:33", "text": "音樂了，而我，jock，你什麼意思？無線我。我"}, {"type": "subtitle", "time": 42104.39, "timestamp": "11:41:44", "text": "給所有戴無線耳機的人都發了，呃，戴耳機的人只要私訊我你的名字就行了。呃，祖克曼。哦，是的，確實"}]
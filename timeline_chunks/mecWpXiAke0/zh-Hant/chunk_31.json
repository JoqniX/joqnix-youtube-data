[{"type": "subtitle", "time": 1871.47, "timestamp": "00:31:11", "text": "我得換個弓，對吧？  呃，我得換個"}, {"type": "subtitle", "time": 1874.63, "timestamp": "00:31:14", "text": "瀏覽器。  我應該用我下載的那個"}, {"type": "subtitle", "time": 1876.43, "timestamp": "00:31:16", "text": "瀏覽"}, {"type": "subtitle", "time": 1879.909, "timestamp": "00:31:19", "text": "器嗎？那傢伙的瀏覽器是這樣的，對吧？血松露。那我"}, {"type": "subtitle", "time": 1884.95, "timestamp": "00:31:24", "text": "以後就用松露"}]
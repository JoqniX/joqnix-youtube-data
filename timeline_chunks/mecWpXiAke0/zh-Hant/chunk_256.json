[{"type": "subtitle", "time": 15388.269, "timestamp": "04:16:28", "text": "做過哪些令人尷尬的事嗎？我原本想把過去那種緊張忙碌的狀態轉化成內容或其他什麼東西。"}, {"type": "subtitle", "time": 15409.11, "timestamp": "04:16:49", "text": "。真讓我生無可戀。  但正是苦難讓我變得更有趣。所以，"}, {"type": "subtitle", "time": 15415.07, "timestamp": "04:16:55", "text": "我"}, {"type": "subtitle", "time": 15417.87, "timestamp": "04:16:57", "text": "想我必須承認，當主播真的太難了。我黑暗的過去。"}]
[{"type": "subtitle", "time": 12375.75, "timestamp": "03:26:15", "text": "沒讀過。我的天啊。"}, {"type": "subtitle", "time": 12397.75, "timestamp": "03:26:37", "text": "到達那裡。如你所知，我一直都很"}, {"type": "subtitle", "time": 12405.75, "timestamp": "03:26:45", "text": "堅定。你"}, {"type": "subtitle", "time": 12410.309, "timestamp": "03:26:50", "text": "每天都需要告訴我該做什麼。我知道你會為我做出正確的決定。你要我做什麼，我都照做。"}]
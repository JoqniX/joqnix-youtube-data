[{"type": "subtitle", "time": 27008.628, "timestamp": "07:30:08", "text": "為什麼"}, {"type": "subtitle", "time": 27011.51, "timestamp": "07:30:11", "text": "我希望他走向一個糟糕的結局，讓他墮落，讓他的一切──他是誰、他原本的樣子等等──都崩塌呢？是啊，那很糟糕。"}, {"type": "subtitle", "time": 27021.27, "timestamp": "07:30:21", "text": "我那樣想真是太殘忍了。所以，我心情非常糟糕，"}, {"type": "subtitle", "time": 27042.788, "timestamp": "07:30:42", "text": "甚至一想到這件事就哭了整整一個星期。那天我還試著找"}, {"type": "subtitle", "time": 27045.19, "timestamp": "07:30:45", "text": "人來代替"}, {"type": "subtitle", "time": 27048.15, "timestamp": "07:30:48", "text": "我扮演Jock，因為我覺得自己不適合演Jock之類的角色。後來確實有個不錯的替代人選，我和他一起問了問，結果他"}, {"type": "subtitle", "time": 27053.468, "timestamp": "07:30:53", "text": "說不行，Jock是永遠無法取代的，你必須明白，你必須接受這個事實。即使有人扮演Jock，一切都不會再一樣了。之後"}]
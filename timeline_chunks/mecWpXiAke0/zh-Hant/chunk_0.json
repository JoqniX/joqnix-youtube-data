[{"type": "subtitle", "time": 5.749, "timestamp": "00:00:05", "text": "好了，我想我們應該到了。我"}, {"type": "subtitle", "time": 8.03, "timestamp": "00:00:08", "text": "希望它是"}, {"type": "subtitle", "time": 11.87, "timestamp": "00:00:11", "text": "直播的。是的，我們正在直播。好，好，"}, {"type": "subtitle", "time": 16.31, "timestamp": "00:00:16", "text": "好。歡迎來到 Joathon 第 20 天，第"}, {"type": "subtitle", "time": 19.349, "timestamp": "00:00:19", "text": "36 天，抱歉。呃，第 36 天，第二部直播，"}, {"type": "subtitle", "time": 22.07, "timestamp": "00:00:22", "text": "夜間直播。我知道我們通常"}, {"type": "subtitle", "time": 24.79, "timestamp": "00:00:24", "text": "這個時候應該要早睡，但"}, {"type": "subtitle", "time": 28.55, "timestamp": "00:00:28", "text": "我們會12點才睡。從今天晚上開始，我會直播"}, {"type": "subtitle", "time": 31.429, "timestamp": "00:00:31", "text": "Billy Billy的節目"}, {"type": "subtitle", "time": 35.03, "timestamp": "00:00:35", "text": "。我們會測試我的電腦是否能"}, {"type": "subtitle", "time": 38.069, "timestamp": "00:00:38", "text": "勝任這項工作等等。所以，我們"}, {"type": "subtitle", "time": 39.869, "timestamp": "00:00:39", "text": "暫時就先這麼做吧"}, {"type": "subtitle", "time": 44.389, "timestamp": "00:00:44", "text": "。好的，我們暫時就先這樣吧。"}, {"type": "subtitle", "time": 46.029, "timestamp": "00:00:46", "text": "希望一切"}, {"type": "subtitle", "time": 48.83, "timestamp": "00:00:48", "text": "順利。"}, {"type": "subtitle", "time": 51.91, "timestamp": "00:00:51", "text": "我希望大家都已"}, {"type": "subtitle", "time": 54.83, "timestamp": "00:00:54", "text": "成功跳到最新"}, {"type": "subtitle", "time": 58.389, "timestamp": "00:00:58", "text": "直播串流。我忘了，我忘了這件事"}]
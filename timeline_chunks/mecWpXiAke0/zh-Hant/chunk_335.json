[{"type": "subtitle", "time": 20100.708, "timestamp": "05:35:00", "text": "人生"}, {"type": "subtitle", "time": 20107.628, "timestamp": "05:35:07", "text": "[音樂]帳號上發推文怎麼辦？"}, {"type": "subtitle", "time": 20117.19, "timestamp": "05:35:17", "text": "我的訂閱用戶達到了10萬。這是我第一次接觸到這麼多人。我不知道"}, {"type": "subtitle", "time": 20129.31, "timestamp": "05:35:29", "text": "接下來會發生什麼事。我有點緊張。感覺就像在看我的統計數據一樣。"}, {"type": "subtitle", "time": 20133.91, "timestamp": "05:35:33", "text": "我知道我總是抱怨北方什麼的，但如果沒有他們的支持和命運，我就不會站在這裡。  啊，就因為他們的德奧，他們把我從網路上檢舉了。我參加了一次天使時刻活動"}, {"type": "subtitle", "time": 20154.31, "timestamp": "05:35:54", "text": "。下次直播時，我打算"}]
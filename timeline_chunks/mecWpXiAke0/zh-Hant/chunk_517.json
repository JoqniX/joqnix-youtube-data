[{"type": "subtitle", "time": 31029.43, "timestamp": "08:37:09", "text": "我看了一部這樣的電影。它顯示的是一部"}, {"type": "subtitle", "time": 31039.99, "timestamp": "08:37:19", "text": "哦好的。該片於2008年上映。哦，不錯。  好的。  明天什麼都沒有"}, {"type": "subtitle", "time": 31045.11, "timestamp": "08:37:25", "text": "。  呃，明天，沒有明天。我們剛才在玩什麼來著？哦，是的。明天我們要臨時決定要玩《Among Us》。哦，該死。哦"}, {"type": "subtitle", "time": 31067.83, "timestamp": "08:37:47", "text": "，等等。"}, {"type": "subtitle", "time": 31072.51, "timestamp": "08:37:52", "text": "哦。我的天哪。我不小心說了句髒話。哦，不。"}]
[{"type": "subtitle", "time": 17642.73, "timestamp": "04:54:02", "text": "戻る。戻ってきました。戻ってきました。"}, {"type": "subtitle", "time": 17645.15, "timestamp": "04:54:05", "text": "[音楽]"}, {"type": "subtitle", "time": 17648.23, "timestamp": "04:54:08", "text": "小さい。えーと、食べ物をあげながら"}, {"type": "subtitle", "time": 17649.868, "timestamp": "04:54:09", "text": "医者、"}, {"type": "subtitle", "time": 17652.59, "timestamp": "04:54:12", "text": "えっと、私はちょっと"}, {"type": "subtitle", "time": 17656.23, "timestamp": "04:54:16", "text": "寝ている間に散らかしてしまった。だから私は"}, {"type": "subtitle", "time": 17657.39, "timestamp": "04:54:17", "text": "それを掃除する"}, {"type": "subtitle", "time": 17661.19, "timestamp": "04:54:21", "text": "上。さらに、お茶と"}, {"type": "subtitle", "time": 17664.07, "timestamp": "04:54:24", "text": "りんご。小さなリンゴ。うん、それで"}, {"type": "subtitle", "time": 17668.23, "timestamp": "04:54:28", "text": "私を起こして。しかたがない。私を止めて"}, {"type": "subtitle", "time": 17671.51, "timestamp": "04:54:31", "text": "最善を尽くします。わかった。こんにちは。これを取りなさい"}, {"type": "subtitle", "time": 17674.23, "timestamp": "04:54:34", "text": "オフ。"}, {"type": "subtitle", "time": 17676.27, "timestamp": "04:54:36", "text": "音楽は"}, {"type": "subtitle", "time": 17678.708, "timestamp": "04:54:38", "text": "体を揺らす。くそ。この音楽、最高だ。"}, {"type": "subtitle", "time": 17680.948, "timestamp": "04:54:40", "text": "はい。油圧排水チェック。はい。水分補給"}, {"type": "subtitle", "time": 17683.27, "timestamp": "04:54:43", "text": "すべてをチェックしてください。ああ、待ってください。そういえば、"}, {"type": "subtitle", "time": 17684.948, "timestamp": "04:54:44", "text": "水筒に水を補充する必要がある。待って、待って、"}, {"type": "subtitle", "time": 17688.31, "timestamp": "04:54:48", "text": "待って、待って、待って、待って、待って。またね。"}, {"type": "subtitle", "time": 17692.91, "timestamp": "04:54:52", "text": "詰め替えボトルが必要です。待って。 1秒。"}, {"type": "subtitle", "time": 17695.7, "timestamp": "04:54:55", "text": "Y. なぜこれが"}, {"type": "subtitle", "time": 17698.27, "timestamp": "04:54:58", "text": "[音楽]"}]
[{"type": "subtitle", "time": 20361.91, "timestamp": "05:39:21", "text": "[音楽]"}, {"type": "subtitle", "time": 20363.35, "timestamp": "05:39:23", "text": "はい、戻ってきました。戻ってきました。戻ってきました。私は"}, {"type": "subtitle", "time": 20369.35, "timestamp": "05:39:29", "text": "ごめん。わかった。えっと、もう一度やってみましょうか？"}, {"type": "subtitle", "time": 20371.15, "timestamp": "05:39:31", "text": "見てみましょう"}, {"type": "subtitle", "time": 20378.75, "timestamp": "05:39:38", "text": "えっと、私のストレスレベルはどれくらいだったっけ？"}, {"type": "subtitle", "time": 20381.43, "timestamp": "05:39:41", "text": "22. 何が起こるか見てみたい。さあ"}, {"type": "subtitle", "time": 20383.11, "timestamp": "05:39:43", "text": "何が起こるか見てみよう。それは悪いことですか、それとも"}, {"type": "subtitle", "time": 20384.85, "timestamp": "05:39:44", "text": "良い？私はしません"}]
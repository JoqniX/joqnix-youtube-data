[{"type": "subtitle", "time": 21901.07, "timestamp": "06:05:01", "text": "来週の話かな"}, {"type": "subtitle", "time": 21903.67, "timestamp": "06:05:03", "text": "えーと、次の日まであと2日しかないよ"}, {"type": "subtitle", "time": 21905.708, "timestamp": "06:05:05", "text": "今週は正しい"}, {"type": "subtitle", "time": 21908.628, "timestamp": "06:05:08", "text": "ああ、君の右の時だ"}, {"type": "subtitle", "time": 21912.15, "timestamp": "06:05:12", "text": "自由ってことは、えっと、"}, {"type": "subtitle", "time": 21915.35, "timestamp": "06:05:15", "text": "私の家族は私が"}, {"type": "subtitle", "time": 21917.628, "timestamp": "06:05:17", "text": "毎日時間を無駄にしている"}, {"type": "subtitle", "time": 21920.628, "timestamp": "06:05:20", "text": "日、私は彼らに言ったが、私は"}, {"type": "subtitle", "time": 21922.31, "timestamp": "06:05:22", "text": "YouTubeやストリーミング配信とかやってるよ。"}, {"type": "subtitle", "time": 21924.948, "timestamp": "06:05:24", "text": "彼らは私が何をしているのか、きちんと理解していない。"}, {"type": "subtitle", "time": 21928.39, "timestamp": "06:05:28", "text": "彼らは私が「えーっと、えーっと、何？」って思ってるんだ"}, {"type": "subtitle", "time": 21931.11, "timestamp": "06:05:31", "text": "彼らは、私が"}, {"type": "subtitle", "time": 21933.43, "timestamp": "06:05:33", "text": "インターネットで時間を無駄にしている"}, {"type": "subtitle", "time": 21936.15, "timestamp": "06:05:36", "text": "それに、外出しないから"}, {"type": "subtitle", "time": 21940.47, "timestamp": "06:05:40", "text": "まるでエンジェルみたいに"}, {"type": "subtitle", "time": 21944.51, "timestamp": "06:05:44", "text": "私たちが演じていたキャラクターのように"}, {"type": "subtitle", "time": 21947.75, "timestamp": "06:05:47", "text": "まさに彼女そっくりだ。うん。同じものもある"}, {"type": "subtitle", "time": 21949.47, "timestamp": "06:05:49", "text": "同じ 同じ"}, {"type": "subtitle", "time": 21950.99, "timestamp": "06:05:50", "text": "それ。"}, {"type": "subtitle", "time": 21956.548, "timestamp": "06:05:56", "text": "だから私は朝から24時間365日PCを使っているから"}, {"type": "subtitle", "time": 21959.75, "timestamp": "06:05:59", "text": "午後の午前中は、"}]
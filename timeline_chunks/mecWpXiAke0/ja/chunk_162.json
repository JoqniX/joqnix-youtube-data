[{"type": "subtitle", "time": 9750.27, "timestamp": "02:42:30", "text": "ダッシュ。わかった。すべて順調です。"}, {"type": "subtitle", "time": 9769.23, "timestamp": "02:42:49", "text": "お金。私はクリスタルを求めてここに来ました"}, {"type": "subtitle", "time": 9770.99, "timestamp": "02:42:50", "text": "あめ。"}, {"type": "subtitle", "time": 9773.59, "timestamp": "02:42:53", "text": "うん。いや、待って、待って、待って。私たちはする必要があります"}, {"type": "subtitle", "time": 9776.33, "timestamp": "02:42:56", "text": "青い方を完成させる"}, {"type": "subtitle", "time": 9777.71, "timestamp": "02:42:57", "text": "[音楽]"}]
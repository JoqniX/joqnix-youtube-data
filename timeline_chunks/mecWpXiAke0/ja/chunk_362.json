[{"type": "subtitle", "time": 21723.47, "timestamp": "06:02:03", "text": "そして"}, {"type": "subtitle", "time": 21725.95, "timestamp": "06:02:05", "text": "許可を与える"}, {"type": "subtitle", "time": 21731.628, "timestamp": "06:02:11", "text": "[音楽]"}, {"type": "subtitle", "time": 21734.83, "timestamp": "06:02:14", "text": "夕暮れの私の"}, {"type": "subtitle", "time": 21738.788, "timestamp": "06:02:18", "text": "写真。いくつかの修正を解除しました"}, {"type": "subtitle", "time": 21741.62, "timestamp": "06:02:21", "text": "写真はこちら。"}, {"type": "subtitle", "time": 21743.628, "timestamp": "06:02:23", "text": "[音楽]"}, {"type": "subtitle", "time": 21746.15, "timestamp": "06:02:26", "text": "右。これらは私が"}, {"type": "subtitle", "time": 21748.31, "timestamp": "06:02:28", "text": "ロックを解除します。今日これを解錠しました"}, {"type": "subtitle", "time": 21750.47, "timestamp": "06:02:30", "text": "ストリーム。"}, {"type": "subtitle", "time": 21752.48, "timestamp": "06:02:32", "text": "彼女を見て。それはとても"}, {"type": "subtitle", "time": 21754.19, "timestamp": "06:02:34", "text": "[音楽]"}, {"type": "subtitle", "time": 21767.03, "timestamp": "06:02:47", "text": "の上。私のクソは私のすべての1分間"}, {"type": "subtitle", "time": 21768.91, "timestamp": "06:02:48", "text": "ストリーム。私はできませんでした"}, {"type": "subtitle", "time": 21771.628, "timestamp": "06:02:51", "text": "持っていない"}, {"type": "subtitle", "time": 21774.23, "timestamp": "06:02:54", "text": "永遠に。わかった。では、どのように保存して"}]
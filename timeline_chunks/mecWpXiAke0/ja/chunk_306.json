[{"type": "subtitle", "time": 18365.15, "timestamp": "05:06:05", "text": "[音楽]"}, {"type": "subtitle", "time": 18367.75, "timestamp": "05:06:07", "text": "ああ、まるで父から電話がかかってきたみたいだ。ああ、"}, {"type": "subtitle", "time": 18369.08, "timestamp": "05:06:09", "text": "神。"}, {"type": "subtitle", "time": 18398.23, "timestamp": "05:06:38", "text": "何？おやすみ、愛しい天使。私はします"}, {"type": "subtitle", "time": 18399.99, "timestamp": "05:06:39", "text": "いつかあなたにお会いできることを祈っています。私は愛する"}, {"type": "subtitle", "time": 18400.91, "timestamp": "05:06:40", "text": "あなた"}, {"type": "subtitle", "time": 18408.11, "timestamp": "05:06:48", "text": "全て。バカがバカな枝を殴った、だから確信している"}, {"type": "subtitle", "time": 18415.07, "timestamp": "05:06:55", "text": "神。とても高い"}, {"type": "subtitle", "time": 18419.27, "timestamp": "05:06:59", "text": "血液フィル。私には自分自身しかいない"}]
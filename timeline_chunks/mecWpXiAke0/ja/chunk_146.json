[{"type": "subtitle", "time": 8789.469, "timestamp": "02:26:29", "text": "私のPCはどうですか？"}, {"type": "subtitle", "time": 8792.87, "timestamp": "02:26:32", "text": "生き残る？私はどうやって生き延びているのだろうか？それはとても"}, {"type": "subtitle", "time": 8795.83, "timestamp": "02:26:35", "text": "動作が遅い。"}, {"type": "subtitle", "time": 8797.87, "timestamp": "02:26:37", "text": "私はどうですか"}, {"type": "subtitle", "time": 8805.56, "timestamp": "02:26:45", "text": "遅れている？"}, {"type": "subtitle", "time": 8807.309, "timestamp": "02:26:47", "text": "[音楽]"}, {"type": "subtitle", "time": 8810.15, "timestamp": "02:26:50", "text": "えっと、ビリーから見ている人は"}, {"type": "subtitle", "time": 8813.349, "timestamp": "02:26:53", "text": "ビリー、私の配信が遅延しているかどうか教えてください。"}]
[{"type": "subtitle", "time": 3062.549, "timestamp": "00:51:02", "text": "ビデオとかこれら全部だけど、でもまあ、うん"}, {"type": "subtitle", "time": 3065.549, "timestamp": "00:51:05", "text": "今のところ"}, {"type": "subtitle", "time": 3073.71, "timestamp": "00:51:13", "text": "Zonのイベントを配信します。えっと"}, {"type": "subtitle", "time": 3076.27, "timestamp": "00:51:16", "text": "えーと、その後"}, {"type": "subtitle", "time": 3079.589, "timestamp": "00:51:19", "text": "7月はそうします"}, {"type": "subtitle", "time": 3081.309, "timestamp": "00:51:21", "text": "えーと"}, {"type": "subtitle", "time": 3084.109, "timestamp": "00:51:24", "text": "エクスクルーシブ"}, {"type": "subtitle", "time": 3098.67, "timestamp": "00:51:38", "text": "ええと、私たちは風に支えられています"}, {"type": "subtitle", "time": 3116.829, "timestamp": "00:51:56", "text": "の隣に"}]
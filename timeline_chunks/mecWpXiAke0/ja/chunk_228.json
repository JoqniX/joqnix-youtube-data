[{"type": "subtitle", "time": 13683.349, "timestamp": "03:48:03", "text": "ロリータエンジェル、あなたのお気に入りのゴールキーパー、ゴシック"}, {"type": "subtitle", "time": 13687.429, "timestamp": "03:48:07", "text": "私の美しさのために、天使の家。よお"}, {"type": "subtitle", "time": 13693.34, "timestamp": "03:48:13", "text": "GF。"}, {"type": "subtitle", "time": 13694.99, "timestamp": "03:48:14", "text": "[音楽]"}, {"type": "subtitle", "time": 13702.99, "timestamp": "03:48:22", "text": "服を何着か買った。それから私は"}, {"type": "subtitle", "time": 13705.87, "timestamp": "03:48:25", "text": "私の日を買う"}, {"type": "subtitle", "time": 13709.469, "timestamp": "03:48:29", "text": "そして私は行きたい"}, {"type": "subtitle", "time": 13712.71, "timestamp": "03:48:32", "text": "男らしすぎる。もし私が外向的な人間だったら、"}, {"type": "subtitle", "time": 13714.95, "timestamp": "03:48:34", "text": "うーん、たくさん買っていただろうな"}, {"type": "subtitle", "time": 13716.75, "timestamp": "03:48:36", "text": "そして何かをした"}, {"type": "subtitle", "time": 13719.189, "timestamp": "03:48:39", "text": "ストリーム。内向的な人間であることは最悪だ"}, {"type": "subtitle", "time": 13727.229, "timestamp": "03:48:47", "text": "[音楽]"}, {"type": "subtitle", "time": 13730.79, "timestamp": "03:48:50", "text": "じゃあ、私とデートしてくれるの？"}, {"type": "subtitle", "time": 13733.269, "timestamp": "03:48:53", "text": "疑問符。他の誰か。何てことだ。"}, {"type": "subtitle", "time": 13735.83, "timestamp": "03:48:55", "text": "いいえ。あなたは彼女と一緒に行くことは決してできません。"}, {"type": "subtitle", "time": 13736.59, "timestamp": "03:48:56", "text": "と"}, {"type": "subtitle", "time": 13739.63, "timestamp": "03:48:59", "text": "彼女は自分の性格をよく知っている。"}]
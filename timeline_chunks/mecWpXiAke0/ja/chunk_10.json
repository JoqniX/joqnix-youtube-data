[{"type": "subtitle", "time": 609.03, "timestamp": "00:10:09", "text": "私はどのカテゴリーに属していますか？コワーキングと"}, {"type": "subtitle", "time": 611.389, "timestamp": "00:10:11", "text": "座っている。はい、それは"}, {"type": "subtitle", "time": 631.069, "timestamp": "00:10:31", "text": "[音楽]"}, {"type": "subtitle", "time": 634.069, "timestamp": "00:10:34", "text": "えっと、ちょっと待って。私は送りたい"}, {"type": "subtitle", "time": 645.67, "timestamp": "00:10:45", "text": "そして、彼らはcoと呼ばれるものを持っています"}]
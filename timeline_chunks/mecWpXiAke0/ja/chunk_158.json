[{"type": "subtitle", "time": 9481.51, "timestamp": "02:38:01", "text": "誕生日は8月です。だから私はワクワクしています"}, {"type": "subtitle", "time": 9484.71, "timestamp": "02:38:04", "text": "ビリー・ビリーの誕生日ストリームをやって、"}, {"type": "subtitle", "time": 9487.59, "timestamp": "02:38:07", "text": "君とかそういうやつ。私たちは、私は、"}, {"type": "subtitle", "time": 9490.87, "timestamp": "02:38:10", "text": "適切なもの ビリー ビリー 限定ストリーム"}, {"type": "subtitle", "time": 9492.11, "timestamp": "02:38:12", "text": "エクスクルーシブ"}, {"type": "subtitle", "time": 9494.469, "timestamp": "02:38:14", "text": "ストリーム。ええ、それまではただ"}, {"type": "subtitle", "time": 9497.83, "timestamp": "02:38:17", "text": "今のところはマルチリーミングで対応します。私は許可を得ました"}, {"type": "subtitle", "time": 9518.15, "timestamp": "02:38:38", "text": "良い。キャンディーを売らせてください。私 私"}, {"type": "subtitle", "time": 9520.63, "timestamp": "02:38:40", "text": "薬物とは言わない方がいいと思う。私"}, {"type": "subtitle", "time": 9522.95, "timestamp": "02:38:42", "text": "アカウント停止になるかもしれない。気をつけなければならない。"}, {"type": "subtitle", "time": 9525.349, "timestamp": "02:38:45", "text": "ウィリー・ビリーだよ。私にはわからない"}, {"type": "subtitle", "time": 9534.67, "timestamp": "02:38:54", "text": "禁止対象。私は36番のファンです。感謝"}, {"type": "subtitle", "time": 9538.349, "timestamp": "02:38:58", "text": "あなた。ありがとう。ああ、それは"}]
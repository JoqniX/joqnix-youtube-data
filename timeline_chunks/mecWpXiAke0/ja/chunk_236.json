[{"type": "subtitle", "time": 14162.229, "timestamp": "03:56:02", "text": "知る。そのままにしておきます。彼女は確かにハゲていますね。"}, {"type": "subtitle", "time": 14164.11, "timestamp": "03:56:04", "text": "新しい"}, {"type": "subtitle", "time": 14168.07, "timestamp": "03:56:08", "text": "ストリーマー。つまり、彼女はハイパーなんだ"}, {"type": "subtitle", "time": 14170.87, "timestamp": "03:56:10", "text": "精力的な。"}, {"type": "subtitle", "time": 14174.95, "timestamp": "03:56:14", "text": "視聴者数は555人です。ああ、"}, {"type": "subtitle", "time": 14176.51, "timestamp": "03:56:16", "text": "[音楽]"}, {"type": "subtitle", "time": 14181.11, "timestamp": "03:56:21", "text": "神。彼女は私を愛していると言った。いいえ。"}, {"type": "subtitle", "time": 14182.349, "timestamp": "03:56:22", "text": "夢、私の"}, {"type": "subtitle", "time": 14190.429, "timestamp": "03:56:30", "text": "夢。"}, {"type": "subtitle", "time": 14195.269, "timestamp": "03:56:35", "text": "いいえ。でも、私の話を聞いてください。私はそのマグカップを保管しておきます。"}, {"type": "subtitle", "time": 14197.71, "timestamp": "03:56:37", "text": "わかった。良い"}]
[{"type": "subtitle", "time": 11522.349, "timestamp": "03:12:02", "text": "さて、インターネットは本当に"}, {"type": "subtitle", "time": 11525.99, "timestamp": "03:12:05", "text": "地獄から生まれた化膿した"}, {"type": "subtitle", "time": 11528.99, "timestamp": "03:12:08", "text": "現代社会。ああ、なんてことだ、私の"}, {"type": "subtitle", "time": 11531.75, "timestamp": "03:12:11", "text": "声。しかしそれでも、私には他に誰もいない"}, {"type": "subtitle", "time": 11534.67, "timestamp": "03:12:14", "text": "話をする相手。"}, {"type": "subtitle", "time": 11537.59, "timestamp": "03:12:17", "text": "だって、私は出るのが苦手だから"}, {"type": "subtitle", "time": 11539.91, "timestamp": "03:12:19", "text": "朝のベッドから。はい、私です。私"}, {"type": "subtitle", "time": 11541.67, "timestamp": "03:12:21", "text": "外出したくない。それは私です。私はしません"}, {"type": "subtitle", "time": 11543.75, "timestamp": "03:12:23", "text": "ちゃんとした仕事に就きたい。それは私です。私"}, {"type": "subtitle", "time": 11546.469, "timestamp": "03:12:26", "text": "他人を怖がる。それは私です。私"}, {"type": "subtitle", "time": 11549.429, "timestamp": "03:12:29", "text": "私を怒らせないで、私はまだバカよ"}, {"type": "subtitle", "time": 11552.389, "timestamp": "03:12:32", "text": "そして私はまだみんなに"}, {"type": "subtitle", "time": 11553.55, "timestamp": "03:12:33", "text": "フォローオーバー"}, {"type": "subtitle", "time": 11557.67, "timestamp": "03:12:37", "text": "自分。何てことだ。ストリーマーが投げ飛ばされる"}, {"type": "subtitle", "time": 11560.23, "timestamp": "03:12:40", "text": "現在、最も多い。だから私は"}, {"type": "subtitle", "time": 11562.03, "timestamp": "03:12:42", "text": "なりたかった"}, {"type": "subtitle", "time": 11566.79, "timestamp": "03:12:46", "text": "1つ。見てみましょう。私はします。送ってくれてありがとう"}, {"type": "subtitle", "time": 11568.389, "timestamp": "03:12:48", "text": "私の機材すべてとストリーミング配信"}, {"type": "subtitle", "time": 11577.87, "timestamp": "03:12:57", "text": "わかった。 Pchanはプレイヤーです"}]
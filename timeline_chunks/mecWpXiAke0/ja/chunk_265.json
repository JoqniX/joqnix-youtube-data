[{"type": "subtitle", "time": 15901.91, "timestamp": "04:25:01", "text": "私のDMを見てみて、みんな私を無視してるの？私"}, {"type": "subtitle", "time": 15904.149, "timestamp": "04:25:04", "text": "君を見ているよ。私は費やすつもりです"}, {"type": "subtitle", "time": 15906.67, "timestamp": "04:25:06", "text": "すべての"}, {"type": "subtitle", "time": 15909.269, "timestamp": "04:25:09", "text": "スーパー大使館がさらに高い品質を提供"}, {"type": "subtitle", "time": 15915.67, "timestamp": "04:25:15", "text": "はい。えっと、お元気ですか？皆さんこんにちは"}, {"type": "subtitle", "time": 15918.95, "timestamp": "04:25:18", "text": "サーモンはオタクどもを圧倒する。感謝"}, {"type": "subtitle", "time": 15920.87, "timestamp": "04:25:20", "text": "読む。あなたはそれを解決しようとしている"}, {"type": "subtitle", "time": 15922.63, "timestamp": "04:25:22", "text": "世界中の誰もが私の名前を知っている。"}, {"type": "subtitle", "time": 15926.67, "timestamp": "04:25:26", "text": "引き続き応援よろしくお願いします。これはとても"}, {"type": "subtitle", "time": 15929.51, "timestamp": "04:25:29", "text": "かわいい。私はそれを好きになりたい、または"}, {"type": "subtitle", "time": 15935.55, "timestamp": "04:25:35", "text": "[音楽]"}, {"type": "subtitle", "time": 15938.87, "timestamp": "04:25:38", "text": "何か。ああ、もう。なんてこった。なんてこった。なんてこった。"}, {"type": "subtitle", "time": 15940.63, "timestamp": "04:25:40", "text": "なんてこった。なんてこった。なんてこった。なんてこった。なんてこった。おお"}, {"type": "subtitle", "time": 15948.99, "timestamp": "04:25:48", "text": "その"}, {"type": "subtitle", "time": 15956.389, "timestamp": "04:25:56", "text": "自爆する。おい、俺を切ってくれよ。来て。"}, {"type": "subtitle", "time": 15958.99, "timestamp": "04:25:58", "text": "怖がらないで。待って。"}]
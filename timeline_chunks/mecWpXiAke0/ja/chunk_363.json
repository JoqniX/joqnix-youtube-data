[{"type": "subtitle", "time": 21781.11, "timestamp": "06:03:01", "text": "また？チャ。"}, {"type": "subtitle", "time": 21784.628, "timestamp": "06:03:04", "text": "待って、それは、よし、これで終わりだ。わかった。"}, {"type": "subtitle", "time": 21786.67, "timestamp": "06:03:06", "text": "待って、それで保存されるの？"}, {"type": "subtitle", "time": 21789.19, "timestamp": "06:03:09", "text": "けれど？待って、保存されるの？思うに"}, {"type": "subtitle", "time": 21791.99, "timestamp": "06:03:11", "text": "そうです。うん、次の配信では大丈夫だよ。"}, {"type": "subtitle", "time": 21795.548, "timestamp": "06:03:15", "text": "こんにちは。それでは、締めくくりたいと思います。"}, {"type": "subtitle", "time": 21798.39, "timestamp": "06:03:18", "text": "ここ。待って、待機を終了するので、"}, {"type": "subtitle", "time": 21800.75, "timestamp": "06:03:20", "text": "しないよ"}, {"type": "subtitle", "time": 21802.708, "timestamp": "06:03:22", "text": "ちょっと待って、もう一度確認させて。待って、"}, {"type": "subtitle", "time": 21803.91, "timestamp": "06:03:23", "text": "待って、待って、待って、待って、倍にして"}, {"type": "subtitle", "time": 21804.67, "timestamp": "06:03:24", "text": "チェック"}, {"type": "subtitle", "time": 21813.99, "timestamp": "06:03:33", "text": "ええ、音声メーターのポップアップは気にしないでください。"}, {"type": "subtitle", "time": 21817.788, "timestamp": "06:03:37", "text": "切り替えて"}, {"type": "subtitle", "time": 21820.31, "timestamp": "06:03:40", "text": "チェック。ああ、確かに保存されたよ。そうだった"}, {"type": "subtitle", "time": 21822.83, "timestamp": "06:03:42", "text": "保存。はい、そうでした"}, {"type": "subtitle", "time": 21825.03, "timestamp": "06:03:45", "text": "保存。それは良い。それは良い。そうだった"}, {"type": "subtitle", "time": 21831.23, "timestamp": "06:03:51", "text": "保存。 18日目。うん、ちゃんと保存できたよ。こんにちは、"}, {"type": "subtitle", "time": 21833.99, "timestamp": "06:03:53", "text": "ありがとうございます。"}, {"type": "subtitle", "time": 21836.788, "timestamp": "06:03:56", "text": "自分。"}, {"type": "subtitle", "time": 21839.51, "timestamp": "06:03:59", "text": "配信を楽しんでいただけたなら幸いです。私は持っている"}]
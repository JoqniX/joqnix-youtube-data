[{"type": "subtitle", "time": 2221.55, "timestamp": "00:37:01", "text": "もちろん。もう一度確認させてください。それは"}, {"type": "subtitle", "time": 2230.91, "timestamp": "00:37:10", "text": "けれど。ああ、オーケー。"}, {"type": "subtitle", "time": 2258.589, "timestamp": "00:37:38", "text": "わかった。こんにちは"}, {"type": "subtitle", "time": 2263.51, "timestamp": "00:37:43", "text": "みんな。しばらくぶり"}, {"type": "subtitle", "time": 2266.75, "timestamp": "00:37:46", "text": "私はこれに積極的に参加しています"}, {"type": "subtitle", "time": 2270.19, "timestamp": "00:37:50", "text": "プラットフォームとこれと"}, {"type": "subtitle", "time": 2273.069, "timestamp": "00:37:53", "text": "アクティブ"}, {"type": "subtitle", "time": 2277.03, "timestamp": "00:37:57", "text": "本当に"}]
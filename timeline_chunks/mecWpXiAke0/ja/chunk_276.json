[{"type": "subtitle", "time": 16566.39, "timestamp": "04:36:06", "text": "私はアニメのようなものは使いません"}, {"type": "subtitle", "time": 16573.029, "timestamp": "04:36:13", "text": "アニメ。アイドルにとって何がそんなに難しいのか"}, {"type": "subtitle", "time": 16575.429, "timestamp": "04:36:15", "text": "夢を見ると少し悲しくなる、あるいは現実がどうなのか"}, {"type": "subtitle", "time": 16576.949, "timestamp": "04:36:16", "text": "もっと重要なのは、お金がいくらかということだ"}, {"type": "subtitle", "time": 16580.109, "timestamp": "04:36:20", "text": "絞り出すことができる"}, {"type": "subtitle", "time": 16583.029, "timestamp": "04:36:23", "text": "ファン。ええ、それもある意味では真実です。"}, {"type": "subtitle", "time": 16586.39, "timestamp": "04:36:26", "text": "アイドルとかそういうものに関しては。の"}, {"type": "subtitle", "time": 16588.75, "timestamp": "04:36:28", "text": "金はすべての戦いを締め付け、"}, {"type": "subtitle", "time": 16592.349, "timestamp": "04:36:32", "text": "すべて。私はそれがそうであってほしいとは思わない"}, {"type": "subtitle", "time": 16600.31, "timestamp": "04:36:40", "text": "うん。それぞれの電力の流れ"}, {"type": "subtitle", "time": 16603.39, "timestamp": "04:36:43", "text": "魔法と希望と、ええと"}, {"type": "subtitle", "time": 16612.029, "timestamp": "04:36:52", "text": "[音楽]"}, {"type": "subtitle", "time": 16615.46, "timestamp": "04:36:55", "text": "アイデア。よし、薬が必要だ。"}]
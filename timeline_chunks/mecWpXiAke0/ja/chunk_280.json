[{"type": "subtitle", "time": 16817.48, "timestamp": "04:40:17", "text": "おお。なんてこった。下降傾向にある。"}, {"type": "subtitle", "time": 16821.27, "timestamp": "04:40:21", "text": "[音楽]"}, {"type": "subtitle", "time": 16823.19, "timestamp": "04:40:23", "text": "私のペットのバスは"}, {"type": "subtitle", "time": 16825.27, "timestamp": "04:40:25", "text": "精製された。いや、ずっと難しいという意味だったんだ。おお、"}, {"type": "subtitle", "time": 16826.99, "timestamp": "04:40:26", "text": "わかった。"}, {"type": "subtitle", "time": 16833.59, "timestamp": "04:40:33", "text": "右。そうそう。うん。 193人の視聴者"}, {"type": "subtitle", "time": 16835.19, "timestamp": "04:40:35", "text": "70. わかりました。わかった。わかった。うん。うん。うん。"}, {"type": "subtitle", "time": 16836.91, "timestamp": "04:40:36", "text": "うん。それは"}, {"type": "subtitle", "time": 16856.47, "timestamp": "04:40:56", "text": "硬くなる。大手ストリーマーは実際には"}]
[{"type": "subtitle", "time": 20881.868, "timestamp": "05:48:01", "text": "彼女は、"}, {"type": "subtitle", "time": 20885.91, "timestamp": "05:48:05", "text": "覚えてる？セクシーな感じ"}, {"type": "subtitle", "time": 20889.27, "timestamp": "05:48:09", "text": "ストリームですよね？私はそのことを話します"}, {"type": "subtitle", "time": 20889.948, "timestamp": "05:48:09", "text": "あなた"}, {"type": "subtitle", "time": 20893.11, "timestamp": "05:48:13", "text": "ストリームで待って、セクシーなストリームを見てください"}, {"type": "subtitle", "time": 20894.03, "timestamp": "05:48:14", "text": "あまりにも、"}, {"type": "subtitle", "time": 20898.19, "timestamp": "05:48:18", "text": "右？ 4つにすれば"}, {"type": "subtitle", "time": 20901.27, "timestamp": "05:48:21", "text": "5、それが最高、それが"}, {"type": "subtitle", "time": 20904.47, "timestamp": "05:48:24", "text": "減少させる最速の方法"}, {"type": "subtitle", "time": 20913.27, "timestamp": "05:48:33", "text": "それは彼女が"}, {"type": "subtitle", "time": 20915.75, "timestamp": "05:48:35", "text": "彼女は感情的な支えを失い、"}, {"type": "subtitle", "time": 20918.948, "timestamp": "05:48:38", "text": "信頼と希望、そして"}, {"type": "subtitle", "time": 20922.23, "timestamp": "05:48:42", "text": "私を繋ぎ止めるものは何でも彼女を繋ぎ止める"}, {"type": "subtitle", "time": 20924.868, "timestamp": "05:48:44", "text": "私の言うことを聞いて、彼女は"}, {"type": "subtitle", "time": 20928.23, "timestamp": "05:48:48", "text": "彼女は内側から壊れてしまうだろう"}, {"type": "subtitle", "time": 20930.67, "timestamp": "05:48:50", "text": "いずれコメントを見ることになるでしょう"}, {"type": "subtitle", "time": 20933.628, "timestamp": "05:48:53", "text": "そして、それがどうなるか見てみたい。"}]
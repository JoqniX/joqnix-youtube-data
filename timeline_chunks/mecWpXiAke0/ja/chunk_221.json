[{"type": "subtitle", "time": 13260.87, "timestamp": "03:41:00", "text": "永遠に。何てことだ。たとえ誰かが"}, {"type": "subtitle", "time": 13262.309, "timestamp": "03:41:02", "text": "探そうとしているけど、私は"}, {"type": "subtitle", "time": 13264.15, "timestamp": "03:41:04", "text": "犯罪を犯す。たとえそう感じたとしても"}, {"type": "subtitle", "time": 13266.63, "timestamp": "03:41:06", "text": "裏切りのように、それが私たちの"}, {"type": "subtitle", "time": 13268.83, "timestamp": "03:41:08", "text": "世界は機能する。ああ、"}, {"type": "subtitle", "time": 13274.99, "timestamp": "03:41:14", "text": "神。一体どんな人がこんなことをするんだ？"}, {"type": "subtitle", "time": 13279.03, "timestamp": "03:41:19", "text": "おお。彼らは配信ではいい人ぶって、"}, {"type": "subtitle", "time": 13284.99, "timestamp": "03:41:24", "text": "おお。"}, {"type": "subtitle", "time": 13304.87, "timestamp": "03:41:44", "text": "フォロワー。あなたは私をどう助けたかったのですか？"}, {"type": "subtitle", "time": 13307.51, "timestamp": "03:41:47", "text": "ゲームを止めてください"}, {"type": "subtitle", "time": 13314.71, "timestamp": "03:41:54", "text": "それ。巨大なカメに乗ってみよう。うん。こんにちは"}, {"type": "subtitle", "time": 13316.55, "timestamp": "03:41:56", "text": "エドワード、息子。今日の調子はどうですか？"}, {"type": "subtitle", "time": 13319.19, "timestamp": "03:41:59", "text": "お元気でお過ごしでしょうか。私の"}]
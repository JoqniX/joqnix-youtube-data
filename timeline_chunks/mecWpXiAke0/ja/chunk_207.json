[{"type": "subtitle", "time": 12421.91, "timestamp": "03:27:01", "text": "地下で食べる料理にすごく興味がある。私は"}, {"type": "subtitle", "time": 12424.07, "timestamp": "03:27:04", "text": "本当に？私の話は気にしないで。私は行きます"}, {"type": "subtitle", "time": 12426.269, "timestamp": "03:27:06", "text": "学校に持っていく"}, {"type": "subtitle", "time": 12429.429, "timestamp": "03:27:09", "text": "自分。私は参加する必要はありません"}, {"type": "subtitle", "time": 12432.87, "timestamp": "03:27:12", "text": "平和を祈るよ、ああ、これはプライベートなことだ"}, {"type": "subtitle", "time": 12435.75, "timestamp": "03:27:15", "text": "これはアカウントであり、公開アカウントです。"}, {"type": "subtitle", "time": 12436.75, "timestamp": "03:27:16", "text": "わかった。"}, {"type": "subtitle", "time": 12441.269, "timestamp": "03:27:21", "text": "おそらく非常に深く掘り下げる"}, {"type": "subtitle", "time": 12444.469, "timestamp": "03:27:24", "text": "間違いなくアンダーグラウンドのアイドルたちだ。とてもプライベートな"}, {"type": "subtitle", "time": 12447.07, "timestamp": "03:27:27", "text": "私にとって利用可能になります"}, {"type": "subtitle", "time": 12451.51, "timestamp": "03:27:31", "text": "これを見て、公開してください。わかった。なぜなら私の"}, {"type": "subtitle", "time": 12453.51, "timestamp": "03:27:33", "text": "どれも本当に興味深い読み物です。"}, {"type": "subtitle", "time": 12455.75, "timestamp": "03:27:35", "text": "すごく面白い。人々は人々が言い争っているのを目にする"}, {"type": "subtitle", "time": 12458.309, "timestamp": "03:27:38", "text": "それらが本物か虐待的なものかについて。"}, {"type": "subtitle", "time": 12460.71, "timestamp": "03:27:40", "text": "全くのデタラメだ。飽きることはない"}, {"type": "subtitle", "time": 12463.269, "timestamp": "03:27:43", "text": "それ。でも、もしあなたが"}, {"type": "subtitle", "time": 12465.59, "timestamp": "03:27:45", "text": "十分に深く掘り下げると、最終的には"}, {"type": "subtitle", "time": 12468.07, "timestamp": "03:27:48", "text": "遅かれ早かれそうなるだろう。好奇心。殺す"}, {"type": "subtitle", "time": 12471.15, "timestamp": "03:27:51", "text": "猫みたいなやつ。"}, {"type": "subtitle", "time": 12473.91, "timestamp": "03:27:53", "text": "ああ、L。でも私は大丈夫だよ。私は決して許さない"}, {"type": "subtitle", "time": 12476.87, "timestamp": "03:27:56", "text": "それは私にも起こったことです。私は最も論理的な女の子です"}, {"type": "subtitle", "time": 12479.19, "timestamp": "03:27:59", "text": "世界で。唯一の"}]
[{"type": "subtitle", "time": 14708.71, "timestamp": "04:05:08", "text": "探す。これらのゲームの多くは本当に"}, {"type": "subtitle", "time": 14709.79, "timestamp": "04:05:09", "text": "難しい"}, {"type": "subtitle", "time": 14712.309, "timestamp": "04:05:12", "text": "探す。ストリーム。わかった、諦めないよ"}, {"type": "subtitle", "time": 14716.269, "timestamp": "04:05:16", "text": "私が最後の一人まで殺すまで"}, {"type": "subtitle", "time": 14723.99, "timestamp": "04:05:23", "text": "うん。おお。あなたは実際得意です"}, {"type": "subtitle", "time": 14729.71, "timestamp": "04:05:29", "text": "コメント。あなたに"}, {"type": "subtitle", "time": 14731.389, "timestamp": "04:05:31", "text": "[音楽]"}, {"type": "subtitle", "time": 14734.04, "timestamp": "04:05:34", "text": "ヒントはありますか？いいえ。"}, {"type": "subtitle", "time": 14735.79, "timestamp": "04:05:35", "text": "[音楽]"}, {"type": "subtitle", "time": 14750.309, "timestamp": "04:05:50", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 14756.26, "timestamp": "04:05:56", "text": "ヒント。行くよ"}]
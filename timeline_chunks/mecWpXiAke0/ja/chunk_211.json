[{"type": "subtitle", "time": 12664.229, "timestamp": "03:31:04", "text": "オーマイゴッド、君は下手に見えるよ。"}, {"type": "subtitle", "time": 12666.87, "timestamp": "03:31:06", "text": "私はそれを読みません。何が"}, {"type": "subtitle", "time": 12669.309, "timestamp": "03:31:09", "text": "仕事を楽しんでいる限りは仕事に行く"}, {"type": "subtitle", "time": 12680.03, "timestamp": "03:31:20", "text": "[音楽]"}, {"type": "subtitle", "time": 12682.71, "timestamp": "03:31:22", "text": "はい。あれ、なんで削除したんだろう？なぜ"}, {"type": "subtitle", "time": 12700.15, "timestamp": "03:31:40", "text": "もちろん、それがああ、彼女は"}, {"type": "subtitle", "time": 12710.83, "timestamp": "03:31:50", "text": "[音楽]"}, {"type": "subtitle", "time": 12714.229, "timestamp": "03:31:54", "text": "いいえ、ヘッドホンがあります。なぜ削除したのですか？"}, {"type": "subtitle", "time": 12715.65, "timestamp": "03:31:55", "text": "何てことだ。"}]
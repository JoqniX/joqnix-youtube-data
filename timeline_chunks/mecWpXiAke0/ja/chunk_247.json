[{"type": "subtitle", "time": 14820.349, "timestamp": "04:07:00", "text": "[音楽]"}, {"type": "subtitle", "time": 14829.229, "timestamp": "04:07:09", "text": "ウェブカメラ。秘密は何ですか？"}, {"type": "subtitle", "time": 14833.63, "timestamp": "04:07:13", "text": "文章？ここにある秘密のテキストは何ですか？"}, {"type": "subtitle", "time": 14836.229, "timestamp": "04:07:16", "text": "はぁ？片付けなさい。私は何を見たいのか"}, {"type": "subtitle", "time": 14845.91, "timestamp": "04:07:25", "text": "何？"}, {"type": "subtitle", "time": 14855.63, "timestamp": "04:07:35", "text": "はぁ？"}, {"type": "subtitle", "time": 14858.71, "timestamp": "04:07:38", "text": "何？私は、えっと、倒れ込むつもりです"}, {"type": "subtitle", "time": 14860.79, "timestamp": "04:07:40", "text": "有名になりたくないし、100 みたいに"}, {"type": "subtitle", "time": 14862.63, "timestamp": "04:07:42", "text": "実際は百万です。売る理由は"}, {"type": "subtitle", "time": 14864.52, "timestamp": "04:07:44", "text": "数分。それで"}, {"type": "subtitle", "time": 14869.309, "timestamp": "04:07:49", "text": "[音楽]"}]
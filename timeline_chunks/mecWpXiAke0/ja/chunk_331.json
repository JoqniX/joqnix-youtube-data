[{"type": "subtitle", "time": 19862.11, "timestamp": "05:31:02", "text": "うん。"}, {"type": "subtitle", "time": 19864.548, "timestamp": "05:31:04", "text": "えっと、私のチャンネルへようこそ。私は"}, {"type": "subtitle", "time": 19867.47, "timestamp": "05:31:07", "text": "あなたの笑顔をここで待っています。誰でもない"}, {"type": "subtitle", "time": 19871.47, "timestamp": "05:31:11", "text": "何も持っていないと感じるし、"}, {"type": "subtitle", "time": 19874.07, "timestamp": "05:31:14", "text": "1つ。私はよく学校をサボった。私はしませんでした"}, {"type": "subtitle", "time": 19875.948, "timestamp": "05:31:15", "text": "友達がたくさんいる。気にしていたのは人間だけだった"}, {"type": "subtitle", "time": 19878.23, "timestamp": "05:31:18", "text": "高齢者だけが気にする"}, {"type": "subtitle", "time": 19886.07, "timestamp": "05:31:26", "text": "はぁ？君が弱さを見せてくれる時が大好きだ。"}, {"type": "subtitle", "time": 19887.91, "timestamp": "05:31:27", "text": "なんてこった。それはまずい。それはまずい。一度もない"}, {"type": "subtitle", "time": 19889.548, "timestamp": "05:31:29", "text": "弱みを見せて"}, {"type": "subtitle", "time": 19893.15, "timestamp": "05:31:33", "text": "あなたのオンライン上の弱点。人々"}, {"type": "subtitle", "time": 19896.548, "timestamp": "05:31:36", "text": "貫通して、あなたを破壊する"}, {"type": "subtitle", "time": 19904.47, "timestamp": "05:31:44", "text": "あなた。ああ、たぶん自分の"}, {"type": "subtitle", "time": 19906.628, "timestamp": "05:31:46", "text": "言葉を考慮して、それを実行する"}, {"type": "subtitle", "time": 19910.11, "timestamp": "05:31:50", "text": "私もです。"}, {"type": "subtitle", "time": 19912.788, "timestamp": "05:31:52", "text": "えっと、天使は行かなければならないとは知りませんでした"}, {"type": "subtitle", "time": 19914.35, "timestamp": "05:31:54", "text": "学校もね。"}, {"type": "subtitle", "time": 19916.868, "timestamp": "05:31:56", "text": "うん。とても可愛くて綺麗だから。"}, {"type": "subtitle", "time": 19918.27, "timestamp": "05:31:58", "text": "ただ"}]
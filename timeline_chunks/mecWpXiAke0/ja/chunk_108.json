[{"type": "subtitle", "time": 6483.83, "timestamp": "01:48:03", "text": "ああ、じゃあね。こんにちは。おやすみ。良い"}, {"type": "subtitle", "time": 6486.79, "timestamp": "01:48:06", "text": "夜。おやすみ。えっと、待って、待って、待って、"}, {"type": "subtitle", "time": 6490.75, "timestamp": "01:48:10", "text": "待って、待って。グーグル"}, {"type": "subtitle", "time": 6520.47, "timestamp": "01:48:40", "text": "夜。これは増加傾向にある。これは良いことだ。"}, {"type": "subtitle", "time": 6524.74, "timestamp": "01:48:44", "text": "それで"}, {"type": "subtitle", "time": 6531.149, "timestamp": "01:48:51", "text": "[音楽]"}]
[{"type": "subtitle", "time": 14760.91, "timestamp": "04:06:00", "text": "[音楽]"}, {"type": "subtitle", "time": 14763.269, "timestamp": "04:06:03", "text": "また。ああ、大変だ。つまり、実際には"}, {"type": "subtitle", "time": 14766.15, "timestamp": "04:06:06", "text": "私にとって吸血鬼や悪を倒すのは理にかなっている"}, {"type": "subtitle", "time": 14768.67, "timestamp": "04:06:08", "text": "ええと、生き物。私は一番好きです"}, {"type": "subtitle", "time": 14773.87, "timestamp": "04:06:13", "text": "店。私はただ最高のものを目指して行く。"}, {"type": "subtitle", "time": 14776.95, "timestamp": "04:06:16", "text": "待って、私はこう思う、「ああ、彼の彼らの"}, {"type": "subtitle", "time": 14780.53, "timestamp": "04:06:20", "text": "英語はめちゃくちゃだ。ああ、なんてことだ。"}, {"type": "subtitle", "time": 14788.469, "timestamp": "04:06:28", "text": "神。ええと、邪悪ですね。よし、かわいい子たちと遊ぼう"}, {"type": "subtitle", "time": 14790.79, "timestamp": "04:06:30", "text": "自分のために立ち上がり、小さなところへ行きましょう"}, {"type": "subtitle", "time": 14793.189, "timestamp": "04:06:33", "text": "失敗する。だから、ちょっと怖いんだけど"}, {"type": "subtitle", "time": 14796.87, "timestamp": "04:06:36", "text": "それ。私は本当に悪いです、あなたは賭けました"}, {"type": "subtitle", "time": 14799.349, "timestamp": "04:06:39", "text": "あなたのスキルをすべて、私たちがどのように"}, {"type": "subtitle", "time": 14802.229, "timestamp": "04:06:42", "text": "ほとんど話さないだろう。私は学んだように感じます"}, {"type": "subtitle", "time": 14812.51, "timestamp": "04:06:52", "text": "フォロワー数5,84人。はい、結構です。それは"}, {"type": "subtitle", "time": 14818.96, "timestamp": "04:06:58", "text": "それ。"}]
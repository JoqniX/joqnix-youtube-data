[{"type": "subtitle", "time": 20701.548, "timestamp": "05:45:01", "text": "自分自身。彼らはとても"}, {"type": "subtitle", "time": 20704.548, "timestamp": "05:45:04", "text": "バカ。そのような犯罪は存在する。私は望む"}, {"type": "subtitle", "time": 20707.27, "timestamp": "05:45:07", "text": "私は仕事を続けながら、監視を続けることもできる。願わくば"}, {"type": "subtitle", "time": 20708.628, "timestamp": "05:45:08", "text": "彼らの願いを叶えることができるかもしれない。欲しい"}, {"type": "subtitle", "time": 20710.708, "timestamp": "05:45:10", "text": "Dになって街を破壊するために"}, {"type": "subtitle", "time": 20714.15, "timestamp": "05:45:14", "text": "彼ら。それでも他の悪と戦いたい"}, {"type": "subtitle", "time": 20715.83, "timestamp": "05:45:15", "text": "だから人々は私が良い人だと思っている"}, {"type": "subtitle", "time": 20718.43, "timestamp": "05:45:18", "text": "私はフラットですが"}, {"type": "subtitle", "time": 20722.84, "timestamp": "05:45:22", "text": "線と密度の半分"}, {"type": "subtitle", "time": 20735.19, "timestamp": "05:45:35", "text": "ああ、君が何を好きか知ってるよ、君は何をしたい？"}, {"type": "subtitle", "time": 20736.43, "timestamp": "05:45:36", "text": "なりたい"}, {"type": "subtitle", "time": 20740.15, "timestamp": "05:45:40", "text": "もっと多くの人と話すために訴訟を起こしたので、"}, {"type": "subtitle", "time": 20747.71, "timestamp": "05:45:47", "text": "激しい。わかった。ああ、黄金色"}, {"type": "subtitle", "time": 20756.31, "timestamp": "05:45:56", "text": "タスクですが、私は"}]
[{"type": "subtitle", "time": 20100.708, "timestamp": "05:35:00", "text": "ねえ、学校で楽しい一日を過ごすために"}, {"type": "subtitle", "time": 20107.628, "timestamp": "05:35:07", "text": "[音楽]"}, {"type": "subtitle", "time": 20110.07, "timestamp": "05:35:10", "text": "実は。えっと、なんで私に声をかけてくれなかったの？"}, {"type": "subtitle", "time": 20117.19, "timestamp": "05:35:17", "text": "いいえ。あ、待って。私の好感度は100です。"}, {"type": "subtitle", "time": 20119.35, "timestamp": "05:35:19", "text": "何てことだ。ほぼ100。待って。何？おお"}, {"type": "subtitle", "time": 20122.35, "timestamp": "05:35:22", "text": "いいえ。それは悪いことですか、それともそれは"}, {"type": "subtitle", "time": 20124.788, "timestamp": "05:35:24", "text": "良い？えっと、私の友達は本当に怖がっていた"}, {"type": "subtitle", "time": 20126.47, "timestamp": "05:35:26", "text": "その鍵はちょっと面白かった。かもしれない"}, {"type": "subtitle", "time": 20129.31, "timestamp": "05:35:29", "text": "次の課題でそれについて話しましょう。それで、"}, {"type": "subtitle", "time": 20132.07, "timestamp": "05:35:32", "text": "わかった。あなたは自分だけの時間を持っている。私たちは"}, {"type": "subtitle", "time": 20133.91, "timestamp": "05:35:33", "text": "学校の日付。私たちはまだ若者だと思う"}, {"type": "subtitle", "time": 20138.27, "timestamp": "05:35:38", "text": "長い間。私は別の人が怖がっているのを見た"}, {"type": "subtitle", "time": 20147.19, "timestamp": "05:35:47", "text": "ハッピー。私も一緒に行きたい。さあ行こう。"}, {"type": "subtitle", "time": 20154.31, "timestamp": "05:35:54", "text": "今夜。ああ、私の秘密のパス。えっと、これ"}, {"type": "subtitle", "time": 20156.62, "timestamp": "05:35:56", "text": "ならないだろう"}]
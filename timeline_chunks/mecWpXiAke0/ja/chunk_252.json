[{"type": "subtitle", "time": 15122.95, "timestamp": "04:12:02", "text": "ストリーミング配信。ストレスレベルは"}, {"type": "subtitle", "time": 15135.269, "timestamp": "04:12:15", "text": "怖がった。たぶん、プレイしないといけないと思う"}, {"type": "subtitle", "time": 15137.91, "timestamp": "04:12:17", "text": "麻雀を配信して、思い出せるように"}, {"type": "subtitle", "time": 15146.75, "timestamp": "04:12:26", "text": "いつか。その"}, {"type": "subtitle", "time": 15151.79, "timestamp": "04:12:31", "text": "わかった。でも、ごめんなさい。来る"}, {"type": "subtitle", "time": 15159.389, "timestamp": "04:12:39", "text": "[音楽]"}, {"type": "subtitle", "time": 15161.83, "timestamp": "04:12:41", "text": "ごめん。ああ、なんてことだ。彼女は反応しない"}, {"type": "subtitle", "time": 15164.87, "timestamp": "04:12:44", "text": "戻る。何てことだ。あなたはどうですか？私も"}, {"type": "subtitle", "time": 15167.11, "timestamp": "04:12:47", "text": "よくやっている。私も同じように感じています。行う"}]
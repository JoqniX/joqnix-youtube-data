[{"type": "subtitle", "time": 19741.51, "timestamp": "05:29:01", "text": "神。"}, {"type": "subtitle", "time": 19750.948, "timestamp": "05:29:10", "text": "絵文字？あなたが何か言ったような気がする"}, {"type": "subtitle", "time": 19753.75, "timestamp": "05:29:13", "text": "以前にも同様のことがありました。ご来場ありがとうございました"}, {"type": "subtitle", "time": 19761.31, "timestamp": "05:29:21", "text": "私たち。"}, {"type": "subtitle", "time": 19764.07, "timestamp": "05:29:24", "text": "わかった。今は本当に気持ち悪い。うん、君"}, {"type": "subtitle", "time": 19766.11, "timestamp": "05:29:26", "text": "戻るべきだ。"}, {"type": "subtitle", "time": 19769.27, "timestamp": "05:29:29", "text": "何？飽和状態なので難しい"}, {"type": "subtitle", "time": 19771.91, "timestamp": "05:29:31", "text": "伝える。わかった。いつでも君が欲しい"}, {"type": "subtitle", "time": 19779.47, "timestamp": "05:29:39", "text": "はぁ？全て"}, {"type": "subtitle", "time": 19783.59, "timestamp": "05:29:43", "text": "右。私たちを救ってください。待って。みんなが"}, {"type": "subtitle", "time": 19786.03, "timestamp": "05:29:46", "text": "いいコメントですね。待って、"}, {"type": "subtitle", "time": 19787.948, "timestamp": "05:29:47", "text": "何？手に入れた"}, {"type": "subtitle", "time": 19790.628, "timestamp": "05:29:50", "text": "それ。みんなから良いコメントをもらっているよ。"}]
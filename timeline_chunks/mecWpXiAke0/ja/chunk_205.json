[{"type": "subtitle", "time": 12302.15, "timestamp": "03:25:02", "text": "ステージでは、"}, {"type": "subtitle", "time": 12303.75, "timestamp": "03:25:03", "text": "通常のスケジュールを維持するが、"}, {"type": "subtitle", "time": 12305.59, "timestamp": "03:25:05", "text": "代わりに火曜日にコマンドを実行します"}, {"type": "subtitle", "time": 12307.91, "timestamp": "03:25:07", "text": "1つのうちの。疑問符が表示されたら"}, {"type": "subtitle", "time": 12309.429, "timestamp": "03:25:09", "text": "それは新しいアイデアを見つけなければならないという意味です"}, {"type": "subtitle", "time": 12311.19, "timestamp": "03:25:11", "text": "そのコマンドを含むコンテンツに対して。いつ"}, {"type": "subtitle", "time": 12312.389, "timestamp": "03:25:12", "text": "少し途方に暮れているでしょう？"}, {"type": "subtitle", "time": 12314.55, "timestamp": "03:25:14", "text": "それをクリックしてください。だから今は、"}, {"type": "subtitle", "time": 12316.79, "timestamp": "03:25:16", "text": "私は夜に配信します。ほとんどの人が"}, {"type": "subtitle", "time": 12322.269, "timestamp": "03:25:22", "text": "人々はオンラインです。わかった。それでは"}, {"type": "subtitle", "time": 12324.429, "timestamp": "03:25:24", "text": "えーとハング"}, {"type": "subtitle", "time": 12333.229, "timestamp": "03:25:33", "text": "[音楽]"}, {"type": "subtitle", "time": 12335.67, "timestamp": "03:25:35", "text": "ゲーム。何時間も試している。できますか"}, {"type": "subtitle", "time": 12338.63, "timestamp": "03:25:38", "text": "このボスを倒せるか？もしかしたら私は"}, {"type": "subtitle", "time": 12344.67, "timestamp": "03:25:44", "text": "自分。私の。よし、これは良い武器だ"}, {"type": "subtitle", "time": 12347.19, "timestamp": "03:25:47", "text": "遊ぶ。ストリーミングのコツをつかんできました"}, {"type": "subtitle", "time": 12348.87, "timestamp": "03:25:48", "text": "もの。だから、実況プレイをしたいんです。"}, {"type": "subtitle", "time": 12350.75, "timestamp": "03:25:50", "text": "やろう"}, {"type": "subtitle", "time": 12353.83, "timestamp": "03:25:53", "text": "それ。私たちは今、新しいアイデアを持っています"}, {"type": "subtitle", "time": 12357.469, "timestamp": "03:25:57", "text": "ストリーム。過去の配信を投稿する。"}, {"type": "subtitle", "time": 12359.9, "timestamp": "03:25:59", "text": "さて、夜になりましたね。"}]
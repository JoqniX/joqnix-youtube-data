[{"type": "subtitle", "time": 4745.669, "timestamp": "01:19:05", "text": "待って。わかった。そんな風にはいかないよ。"}, {"type": "subtitle", "time": 4747.669, "timestamp": "01:19:07", "text": "わかった。"}, {"type": "subtitle", "time": 4750.91, "timestamp": "01:19:10", "text": "トラックをリンクするにはどうすればよいですか"}, {"type": "subtitle", "time": 4770.669, "timestamp": "01:19:30", "text": "忘れたアプリケーションのキャプチャが表示されます"}, {"type": "subtitle", "time": 4780.79, "timestamp": "01:19:40", "text": "電話。私はこうすべきだと思う"}, {"type": "subtitle", "time": 4782.03, "timestamp": "01:19:42", "text": "何か"}, {"type": "subtitle", "time": 4791.95, "timestamp": "01:19:51", "text": "私？そうやって送信するんです。しかし"}, {"type": "subtitle", "time": 4795.229, "timestamp": "01:19:55", "text": "えっと、これをグーグルで調べなきゃ。"}, {"type": "subtitle", "time": 4797.47, "timestamp": "01:19:57", "text": "今。どうやって"}]
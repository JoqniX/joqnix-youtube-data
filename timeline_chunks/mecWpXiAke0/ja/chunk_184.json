[{"type": "subtitle", "time": 11040.26, "timestamp": "03:04:00", "text": "彼を起こして働かせる"}, {"type": "subtitle", "time": 11041.79, "timestamp": "03:04:01", "text": "[音楽]"}, {"type": "subtitle", "time": 11045.2, "timestamp": "03:04:05", "text": "それ。ええと、マクロ的なことは"}, {"type": "subtitle", "time": 11046.75, "timestamp": "03:04:06", "text": "[音楽]"}, {"type": "subtitle", "time": 11049.71, "timestamp": "03:04:09", "text": "働く。どこにいるの？そこにいる"}, {"type": "subtitle", "time": 11052.389, "timestamp": "03:04:12", "text": "行く。よし。はい、どうぞ。チッピー"}, {"type": "subtitle", "time": 11054.03, "timestamp": "03:04:14", "text": "ジョッキーは"}, {"type": "subtitle", "time": 11056.95, "timestamp": "03:04:16", "text": "ここ。私は今気づいた"}, {"type": "subtitle", "time": 11058.75, "timestamp": "03:04:18", "text": "切り替えるはず"}, {"type": "subtitle", "time": 11062.63, "timestamp": "03:04:22", "text": "周りには、3D ジョック、2D ジョック、ライブ 2D"}, {"type": "subtitle", "time": 11064.95, "timestamp": "03:04:24", "text": "ジョックとちびジョックとビジュアライザー"}, {"type": "subtitle", "time": 11068.07, "timestamp": "03:04:28", "text": "さっき見たスポーツマン。"}, {"type": "subtitle", "time": 11071.75, "timestamp": "03:04:31", "text": "そして私は、"}, {"type": "subtitle", "time": 11076.269, "timestamp": "03:04:36", "text": "長期間勤務する任務犬"}, {"type": "subtitle", "time": 11079.429, "timestamp": "03:04:39", "text": "その間。でも私たちは切り替えます、切り替えます"}, {"type": "subtitle", "time": 11082.269, "timestamp": "03:04:42", "text": "起きてこれを手に入れよう"}, {"type": "subtitle", "time": 11092.51, "timestamp": "03:04:52", "text": "私にさせて"}, {"type": "subtitle", "time": 11096.269, "timestamp": "03:04:56", "text": "ちょっとだけ時間をください"}]
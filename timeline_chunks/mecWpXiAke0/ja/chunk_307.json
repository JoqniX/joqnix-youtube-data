[{"type": "subtitle", "time": 18421.91, "timestamp": "05:07:01", "text": "しかし、非難すべきだ。あ、待って。彼女が投稿したら"}, {"type": "subtitle", "time": 18424.07, "timestamp": "05:07:04", "text": "彼女のメインアカウントが誤って"}, {"type": "subtitle", "time": 18426.93, "timestamp": "05:07:06", "text": "痛い、痛い。なんてこった。"}, {"type": "subtitle", "time": 18450.03, "timestamp": "05:07:30", "text": "いいえ。夕暮れ時へ行こう。えっと、私たちは"}, {"type": "subtitle", "time": 18452.788, "timestamp": "05:07:32", "text": "建設すべきである。ああ、それはとても"}, {"type": "subtitle", "time": 18457.31, "timestamp": "05:07:37", "text": "迷惑な。誰かをトランスジェンダーにすべきだった"}, {"type": "subtitle", "time": 18460.39, "timestamp": "05:07:40", "text": "初め。大丈夫。"}, {"type": "subtitle", "time": 18464.91, "timestamp": "05:07:44", "text": "愛してます。わかった。"}, {"type": "subtitle", "time": 18467.8, "timestamp": "05:07:47", "text": "えっと、"}, {"type": "subtitle", "time": 18478.628, "timestamp": "05:07:58", "text": "モンスターが増えるでしょう。わかった。待って。私は必要としている"}]
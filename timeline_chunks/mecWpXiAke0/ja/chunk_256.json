[{"type": "subtitle", "time": 15368.55, "timestamp": "04:16:08", "text": "[音楽]"}, {"type": "subtitle", "time": 15371.429, "timestamp": "04:16:11", "text": "このバンドリングは、力を感じます"}, {"type": "subtitle", "time": 15381.03, "timestamp": "04:16:21", "text": "奇妙な。キスをありがとう。ありがとう。"}, {"type": "subtitle", "time": 15384.269, "timestamp": "04:16:24", "text": "皆さん、ありがとうございます"}, {"type": "subtitle", "time": 15388.269, "timestamp": "04:16:28", "text": "お母さん。えっと、私はそうするべきでしょうか"}, {"type": "subtitle", "time": 15399.429, "timestamp": "04:16:39", "text": "[音楽]"}, {"type": "subtitle", "time": 15401.59, "timestamp": "04:16:41", "text": "愛と愛の両方を送ってくれる男性が好きです"}, {"type": "subtitle", "time": 15409.11, "timestamp": "04:16:49", "text": "悪い。おい、見たもの気に入ったか？もしそうなら、"}, {"type": "subtitle", "time": 15410.75, "timestamp": "04:16:50", "text": "もう一度プレイしよう"}, {"type": "subtitle", "time": 15414.07, "timestamp": "04:16:54", "text": "明日。それは基地です。それは空だ"}, {"type": "subtitle", "time": 15415.07, "timestamp": "04:16:55", "text": "ブロックI"}, {"type": "subtitle", "time": 15417.87, "timestamp": "04:16:57", "text": "ショットガンについて考える"}]
[{"type": "subtitle", "time": 13623.429, "timestamp": "03:47:03", "text": "[音楽]"}, {"type": "subtitle", "time": 13625.67, "timestamp": "03:47:05", "text": "コメントありがとうございます。私は黙らなければならなかった"}, {"type": "subtitle", "time": 13628.11, "timestamp": "03:47:08", "text": "若干。"}, {"type": "subtitle", "time": 13630.59, "timestamp": "03:47:10", "text": "中断。こんにちは、私は"}, {"type": "subtitle", "time": 13633.51, "timestamp": "03:47:13", "text": "戻る。終わりを迎えるべきなのでしょうか"}, {"type": "subtitle", "time": 13636.71, "timestamp": "03:47:16", "text": "バスも？いいえ、そうすべきではありません。いや、いや、いや、"}, {"type": "subtitle", "time": 13656.87, "timestamp": "03:47:36", "text": "右？ストリームの叫び声ボーナス。"}, {"type": "subtitle", "time": 13660.1, "timestamp": "03:47:40", "text": "次の2つの三角形"}]
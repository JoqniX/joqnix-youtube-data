[{"type": "subtitle", "time": 9541.63, "timestamp": "02:39:01", "text": "警察。感謝"}, {"type": "subtitle", "time": 9564.23, "timestamp": "02:39:24", "text": "でも、私は低い姿勢で寝るつもりです。こんにちは。行く"}, {"type": "subtitle", "time": 9566.07, "timestamp": "02:39:26", "text": "寝る。寝なさい。私も寝ます。"}, {"type": "subtitle", "time": 9568.309, "timestamp": "02:39:28", "text": "単にテストのためにゲームを起動してみました。"}, {"type": "subtitle", "time": 9574.75, "timestamp": "02:39:34", "text": "私は自分の仕事を終えたら、寝ます。"}, {"type": "subtitle", "time": 9585.35, "timestamp": "02:39:45", "text": "おやすみ。良い"}, {"type": "subtitle", "time": 9587.87, "timestamp": "02:39:47", "text": "[音楽]"}]
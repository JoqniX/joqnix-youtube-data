[{"type": "subtitle", "time": 14643.28, "timestamp": "04:04:03", "text": "ヒントはありますか？いい顔してるね。何が"}, {"type": "subtitle", "time": 14644.59, "timestamp": "04:04:04", "text": "[音楽]"}, {"type": "subtitle", "time": 14647.59, "timestamp": "04:04:07", "text": "それ？えーと、壮大なOSみたいな感じ。ボス"}, {"type": "subtitle", "time": 14650.11, "timestamp": "04:04:10", "text": "戦いはかなり難しい"}, {"type": "subtitle", "time": 14652.71, "timestamp": "04:04:12", "text": "今。なぜあなたは"}, {"type": "subtitle", "time": 14669.63, "timestamp": "04:04:29", "text": "もしそれが私だったら、もちろん愛するだろう。"}, {"type": "subtitle", "time": 14695.91, "timestamp": "04:04:55", "text": "[音楽]"}, {"type": "subtitle", "time": 14697.99, "timestamp": "04:04:57", "text": "私はこのような質問をします。オン"}, {"type": "subtitle", "time": 14699.91, "timestamp": "04:04:59", "text": "プレイして死ぬゲーム、多くのゲームは"}]
[{"type": "subtitle", "time": 21126.03, "timestamp": "05:52:06", "text": "[音楽]"}, {"type": "subtitle", "time": 21128.948, "timestamp": "05:52:08", "text": "より低い。母さん、私を産んでくれてありがとう。"}, {"type": "subtitle", "time": 21131.27, "timestamp": "05:52:11", "text": "大きくなるぞ。君が"}, {"type": "subtitle", "time": 21146.55, "timestamp": "05:52:26", "text": "何？丘の下を通り抜ければいい。アンダーヒル"}, {"type": "subtitle", "time": 21155.788, "timestamp": "05:52:35", "text": "[音楽]"}, {"type": "subtitle", "time": 21158.39, "timestamp": "05:52:38", "text": "意味。君のおかげで笑顔になれたよ"}, {"type": "subtitle", "time": 21161.34, "timestamp": "05:52:41", "text": "人生で初めて。"}, {"type": "subtitle", "time": 21178.948, "timestamp": "05:52:58", "text": "特に意味はないけど、ただ言ってみただけ"}]
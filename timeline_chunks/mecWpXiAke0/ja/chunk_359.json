[{"type": "subtitle", "time": 21540.31, "timestamp": "05:59:00", "text": "わかった。次に、私たちはこれを実行しました。これは"}, {"type": "subtitle", "time": 21541.99, "timestamp": "05:59:01", "text": "いい結果。さあ、一緒に過ごそう。私はしない"}, {"type": "subtitle", "time": 21543.788, "timestamp": "05:59:03", "text": "下がる"}, {"type": "subtitle", "time": 21547.15, "timestamp": "05:59:07", "text": "外。代わりに私は"}, {"type": "subtitle", "time": 21554.35, "timestamp": "05:59:14", "text": "これ。寝るまで"}, {"type": "subtitle", "time": 21556.868, "timestamp": "05:59:16", "text": "明日。彼女にこれをあげたい"}]
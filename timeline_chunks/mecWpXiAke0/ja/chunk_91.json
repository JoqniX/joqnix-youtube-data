[{"type": "subtitle", "time": 5461.709, "timestamp": "01:31:01", "text": "えっと、コメント"}, {"type": "subtitle", "time": 5472.189, "timestamp": "01:31:12", "text": "うん。グローバル"}, {"type": "subtitle", "time": 5481.35, "timestamp": "01:31:21", "text": "翻訳。だからチャットに文字を入力できないんです。"}, {"type": "subtitle", "time": 5483.31, "timestamp": "01:31:23", "text": "わかった。待って、"}, {"type": "subtitle", "time": 5486.669, "timestamp": "01:31:26", "text": "秒えっと、"}, {"type": "subtitle", "time": 5489.51, "timestamp": "01:31:29", "text": "こんにちは。はい、こんにちはと言っています。はい、"}, {"type": "subtitle", "time": 5496.229, "timestamp": "01:31:36", "text": "こんにちは。何か入力させてください"}, {"type": "subtitle", "time": 5497.629, "timestamp": "01:31:37", "text": "日本語。"}, {"type": "subtitle", "time": 5500.43, "timestamp": "01:31:40", "text": "えっと、こんにちは"}, {"type": "subtitle", "time": 5517.229, "timestamp": "01:31:57", "text": "こんにちは。私はチェックしようとしています"}]
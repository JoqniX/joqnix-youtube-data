[{"type": "subtitle", "time": 19508.35, "timestamp": "05:25:08", "text": "[音楽]"}, {"type": "subtitle", "time": 19510.67, "timestamp": "05:25:10", "text": "ええ、少なくとも彼女は私たちの味方です。"}, {"type": "subtitle", "time": 19513.39, "timestamp": "05:25:13", "text": "[音楽]"}, {"type": "subtitle", "time": 19517.708, "timestamp": "05:25:17", "text": "うん、時間があるから出かけられるよ"}, {"type": "subtitle", "time": 19521.2, "timestamp": "05:25:21", "text": "複雑になる。彼女には外に出る必要がある。私"}, {"type": "subtitle", "time": 19531.868, "timestamp": "05:25:31", "text": "[音楽]"}, {"type": "subtitle", "time": 19534.47, "timestamp": "05:25:34", "text": "つまり、このゲームは"}, {"type": "subtitle", "time": 19537.708, "timestamp": "05:25:37", "text": "の上。だから"}, {"type": "subtitle", "time": 19541.99, "timestamp": "05:25:41", "text": "夜、洞窟に戻る夜のように"}, {"type": "subtitle", "time": 19551.75, "timestamp": "05:25:51", "text": "今日、私と私のどちらがかわいいか"}]
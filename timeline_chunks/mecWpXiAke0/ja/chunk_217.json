[{"type": "subtitle", "time": 13024.55, "timestamp": "03:37:04", "text": "彼女が遊んでいるとき、私は"}, {"type": "subtitle", "time": 13028.55, "timestamp": "03:37:08", "text": "彼女は遊び方を知っていて、また、私は言う"}, {"type": "subtitle", "time": 13044.79, "timestamp": "03:37:24", "text": "離れて。 233人が視聴しています。わかった。では"}, {"type": "subtitle", "time": 13048.19, "timestamp": "03:37:28", "text": "それは進歩と言えるでしょう。質問"}, {"type": "subtitle", "time": 13052.19, "timestamp": "03:37:32", "text": "マーク。あなたたちは愛していない"}, {"type": "subtitle", "time": 13055.05, "timestamp": "03:37:35", "text": "これら。私は興奮しています。"}, {"type": "subtitle", "time": 13069.389, "timestamp": "03:37:49", "text": "わかった。あなたは陰謀論が好きで、"}, {"type": "subtitle", "time": 13071.67, "timestamp": "03:37:51", "text": "あまりにも？ちょっと共有してもいいかなと思って"}, {"type": "subtitle", "time": 13073.19, "timestamp": "03:37:53", "text": "ここにあなたの好きな人たちが何人かいて、"}, {"type": "subtitle", "time": 13075.02, "timestamp": "03:37:55", "text": "そこには。別の"}]
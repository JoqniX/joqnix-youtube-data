[{"type": "subtitle", "time": 14522.03, "timestamp": "04:02:02", "text": "待って、ストレス値が64になるよ。おお"}, {"type": "subtitle", "time": 14525.71, "timestamp": "04:02:05", "text": "いいえ。ゲーマー女子の体験談。わかった、"}, {"type": "subtitle", "time": 14529.58, "timestamp": "04:02:09", "text": "待って。ウサギの穴"}, {"type": "subtitle", "time": 14538.389, "timestamp": "04:02:18", "text": "ボーナス。待って、私の好感度が下がってしまうわ。"}, {"type": "subtitle", "time": 14546.229, "timestamp": "04:02:26", "text": "それから。彼らにはとても時間があったとだけ言っておきます"}, {"type": "subtitle", "time": 14552.91, "timestamp": "04:02:32", "text": "見る。神に感謝、そうではなかった"}, {"type": "subtitle", "time": 14555.83, "timestamp": "04:02:35", "text": "私が必要としていたもの、あなたは何を"}, {"type": "subtitle", "time": 14569.74, "timestamp": "04:02:49", "text": "木葉原。まず、私がここにいます。さあ行こう。新しい"}, {"type": "subtitle", "time": 14572.11, "timestamp": "04:02:52", "text": "[音楽]"}, {"type": "subtitle", "time": 14574.87, "timestamp": "04:02:54", "text": "人々はただそれらをチェックしているだけだ。私は見たことがない"}, {"type": "subtitle", "time": 14576.349, "timestamp": "04:02:56", "text": "これ"}]
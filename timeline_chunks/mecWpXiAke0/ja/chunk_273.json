[{"type": "subtitle", "time": 16388.99, "timestamp": "04:33:08", "text": "レディ。ちょっと疲れた。ちょっと疲れた。"}, {"type": "subtitle", "time": 16392.789, "timestamp": "04:33:12", "text": "揺れる。うん。あなたは寝るべきです。私は思う"}, {"type": "subtitle", "time": 16399.67, "timestamp": "04:33:19", "text": "明日。アルコールは薬物よりも悪い"}, {"type": "subtitle", "time": 16404.23, "timestamp": "04:33:24", "text": "意見。うん、寝るべきだよ"}, {"type": "subtitle", "time": 16405.949, "timestamp": "04:33:25", "text": "明日。"}, {"type": "subtitle", "time": 16415.59, "timestamp": "04:33:35", "text": "より良い。眠れません。私が手に入れた瞬間"}, {"type": "subtitle", "time": 16417.109, "timestamp": "04:33:37", "text": "ベッドに入ると、これらの恐ろしい記憶がすべて蘇ってきた。"}, {"type": "subtitle", "time": 16420.15, "timestamp": "04:33:40", "text": "私の元へ舞い戻ってきた。なんてこった。たぶん"}, {"type": "subtitle", "time": 16422.99, "timestamp": "04:33:42", "text": "他の人が祈れるように"}, {"type": "subtitle", "time": 16426.789, "timestamp": "04:33:46", "text": "不眠症患者を手に入れれば、"}, {"type": "subtitle", "time": 16429.551, "timestamp": "04:33:49", "text": "今夜は眠ろう。ああ、それは"}, {"type": "subtitle", "time": 16432.869, "timestamp": "04:33:52", "text": "悪い。私が守護天使になります。眠い"}, {"type": "subtitle", "time": 16435.23, "timestamp": "04:33:55", "text": "時間の"}]
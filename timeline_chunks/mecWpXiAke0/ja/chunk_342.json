[{"type": "subtitle", "time": 20522.69, "timestamp": "05:42:02", "text": "平均？待って、知りたいんだ。待って、"}, {"type": "subtitle", "time": 20531.71, "timestamp": "05:42:11", "text": "何？彼女は点々点を打つ"}, {"type": "subtitle", "time": 20533.868, "timestamp": "05:42:13", "text": "[音楽]"}, {"type": "subtitle", "time": 20536.708, "timestamp": "05:42:16", "text": "もの。私はそれを見つけるつもりはありません。えっと、"}, {"type": "subtitle", "time": 20547.628, "timestamp": "05:42:27", "text": "[音楽]"}, {"type": "subtitle", "time": 20550.47, "timestamp": "05:42:30", "text": "わかった。待って。もし私がそれを愛しすぎたら、"}, {"type": "subtitle", "time": 20553.27, "timestamp": "05:42:33", "text": "私は扱いにくい人間なのかもしれない。"}, {"type": "subtitle", "time": 20556.548, "timestamp": "05:42:36", "text": "だから、いい感じに打とうとしてみてください。ああ、いや。それは"}, {"type": "subtitle", "time": 20559.75, "timestamp": "05:42:39", "text": "なぜ。わかった。わかった。わかった。わかった。わかった。走る"}, {"type": "subtitle", "time": 20562.15, "timestamp": "05:42:42", "text": "私のプレゼンテーション。わかった。それが理由です。わかった。"}, {"type": "subtitle", "time": 20563.43, "timestamp": "05:42:43", "text": "わかった。わかった。わかった。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 20564.68, "timestamp": "05:42:44", "text": "わかった。 [音楽]"}]
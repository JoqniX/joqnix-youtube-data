[{"type": "subtitle", "time": 11100.71, "timestamp": "03:05:00", "text": "えっと、ストーリーをインスタグラムに投稿します。"}, {"type": "subtitle", "time": 11119.23, "timestamp": "03:05:19", "text": "えっと、昨日ですよね？"}, {"type": "subtitle", "time": 11122.23, "timestamp": "03:05:22", "text": "えっと、君は僕に気付いたかもしれないから"}, {"type": "subtitle", "time": 11125.55, "timestamp": "03:05:25", "text": "眠いでしょ？私はとても眠かったと思います"}, {"type": "subtitle", "time": 11128.15, "timestamp": "03:05:28", "text": "昨日。そうだったっけ？私が眠ったという事実"}, {"type": "subtitle", "time": 11129.71, "timestamp": "03:05:29", "text": "午前6時"}, {"type": "subtitle", "time": 11133.51, "timestamp": "03:05:33", "text": "今日。信じられない。私は最高だった"}, {"type": "subtitle", "time": 11135.99, "timestamp": "03:05:35", "text": "疲れていて、"}, {"type": "subtitle", "time": 11139.389, "timestamp": "03:05:39", "text": "今日配信開始。もちろん、私は"}, {"type": "subtitle", "time": 11143.91, "timestamp": "03:05:43", "text": "12分か、30分くらい前のことです。だから私の"}, {"type": "subtitle", "time": 11146.11, "timestamp": "03:05:46", "text": "睡眠スケジュール"}, {"type": "subtitle", "time": 11149.349, "timestamp": "03:05:49", "text": "でも心配しないで、来週、来週"}, {"type": "subtitle", "time": 11150.67, "timestamp": "03:05:50", "text": "来週ではない"}, {"type": "subtitle", "time": 11154.389, "timestamp": "03:05:54", "text": "明日は金曜日だと思う。待って"}, {"type": "subtitle", "time": 11155.99, "timestamp": "03:05:55", "text": "明日は金曜日だよね、そう、明日だ。"}, {"type": "subtitle", "time": 11158.469, "timestamp": "03:05:58", "text": "明日の金曜日は2回"}]
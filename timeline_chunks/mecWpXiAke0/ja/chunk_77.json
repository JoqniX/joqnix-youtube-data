[{"type": "subtitle", "time": 4621.189, "timestamp": "01:17:01", "text": "二。ぶっつけ本番でやってみるよ。はい、"}, {"type": "subtitle", "time": 4623.83, "timestamp": "01:17:03", "text": "持っています。プラグインはインストール済みです。私は"}, {"type": "subtitle", "time": 4625.63, "timestamp": "01:17:05", "text": "行く"}, {"type": "subtitle", "time": 4637.189, "timestamp": "01:17:17", "text": "トラックマトリックスを"}, {"type": "subtitle", "time": 4644.71, "timestamp": "01:17:24", "text": "リンク。どうやって"}, {"type": "subtitle", "time": 4649.31, "timestamp": "01:17:29", "text": "[音楽]"}, {"type": "subtitle", "time": 4652.83, "timestamp": "01:17:32", "text": "追跡？これは"}, {"type": "subtitle", "time": 4655.87, "timestamp": "01:17:35", "text": "難しい。私が何を見ているのか知りたいですか"}, {"type": "subtitle", "time": 4658.55, "timestamp": "01:17:38", "text": "何をしているの？あなたは私が大丈夫かどうか知りたいのですね。私"}, {"type": "subtitle", "time": 4661.83, "timestamp": "01:17:41", "text": "私はまだ投稿していません。ああ、Q。えっと、投稿するのを忘れていました。"}]
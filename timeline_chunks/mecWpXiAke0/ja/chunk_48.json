[{"type": "subtitle", "time": 2928.99, "timestamp": "00:48:48", "text": "えっと"}, {"type": "subtitle", "time": 2932.19, "timestamp": "00:48:52", "text": "神様、私は"}, {"type": "subtitle", "time": 2936.51, "timestamp": "00:48:56", "text": "準備ができて。私は準備ができているだろうか？わからない。"}, {"type": "subtitle", "time": 2938.95, "timestamp": "00:48:58", "text": "えっと、コメントに返信しなければならなかったのですが、"}]
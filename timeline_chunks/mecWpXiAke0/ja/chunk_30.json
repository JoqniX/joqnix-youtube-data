[{"type": "subtitle", "time": 1814.549, "timestamp": "00:30:14", "text": "右？あ、待って。このブラウザは"}, {"type": "subtitle", "time": 1818.549, "timestamp": "00:30:18", "text": "私のビリー・ビリーにリンクされています。忘れた。えっと、"}, {"type": "subtitle", "time": 1829.59, "timestamp": "00:30:29", "text": "えっと、別のブラウザを使わないといけないんです。"}, {"type": "subtitle", "time": 1841.87, "timestamp": "00:30:41", "text": "手に入れた？そういうこともある"}, {"type": "subtitle", "time": 1846.59, "timestamp": "00:30:46", "text": "えっと、あの少年のブラウザですよね？血"}, {"type": "subtitle", "time": 1857.19, "timestamp": "00:30:57", "text": "トリュフ。トリュフを使います"}, {"type": "subtitle", "time": 1858.43, "timestamp": "00:30:58", "text": "[音楽]"}, {"type": "subtitle", "time": 1859.9, "timestamp": "00:30:59", "text": "それから。"}]
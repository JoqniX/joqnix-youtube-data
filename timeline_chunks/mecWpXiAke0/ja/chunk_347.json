[{"type": "subtitle", "time": 20820.628, "timestamp": "05:47:00", "text": "インターネットで始まったものは非常に"}, {"type": "subtitle", "time": 20824.23, "timestamp": "05:47:04", "text": "何でもありの楽しい時間。愛している 私は愛している"}, {"type": "subtitle", "time": 20826.39, "timestamp": "05:47:06", "text": "21世紀に生きる。私たち全員が必要"}, {"type": "subtitle", "time": 20828.868, "timestamp": "05:47:08", "text": "私たちの生活には、少しばかりの不気味さがあります。私"}, {"type": "subtitle", "time": 20830.708, "timestamp": "05:47:10", "text": "次の配信で話そうと思います。"}, {"type": "subtitle", "time": 20833.75, "timestamp": "05:47:13", "text": "皆さんも私と同じくらい楽しんでくれるといいな。"}, {"type": "subtitle", "time": 20836.07, "timestamp": "05:47:16", "text": "まず最初に、"}, {"type": "subtitle", "time": 20839.788, "timestamp": "05:47:19", "text": "私はします。ネット"}, {"type": "subtitle", "time": 20849.43, "timestamp": "05:47:29", "text": "あれがアンティアーノであるはずがない。いいね"}, {"type": "subtitle", "time": 20852.07, "timestamp": "05:47:32", "text": "よく考えてみて、間違いは私たちが"}, {"type": "subtitle", "time": 20854.948, "timestamp": "05:47:34", "text": "肯定をゼロにした。彼女はしないだろう"}, {"type": "subtitle", "time": 20856.19, "timestamp": "05:47:36", "text": "聴く"}, {"type": "subtitle", "time": 20860.35, "timestamp": "05:47:40", "text": "自分。彼女は事実上無視するだろう"}, {"type": "subtitle", "time": 20863.35, "timestamp": "05:47:43", "text": "私と彼女は何でもするだろう"}, {"type": "subtitle", "time": 20866.39, "timestamp": "05:47:46", "text": "彼女はそれを望んでいる。現在ここにいる間、"}, {"type": "subtitle", "time": 20869.83, "timestamp": "05:47:49", "text": "選手ピチャンが彼女に何をすべきかを指示している"}, {"type": "subtitle", "time": 20871.67, "timestamp": "05:47:51", "text": "すべてそうですよね？彼女に与えて"}, {"type": "subtitle", "time": 20879.27, "timestamp": "05:47:59", "text": "そういうこと、つまり、そうなんです。うん。私"}]
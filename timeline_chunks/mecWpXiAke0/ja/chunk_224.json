[{"type": "subtitle", "time": 13450.189, "timestamp": "03:44:10", "text": "[音楽]"}, {"type": "subtitle", "time": 13453.51, "timestamp": "03:44:13", "text": "検索。もし君たちがタグ付けするなら"}, {"type": "subtitle", "time": 13456.07, "timestamp": "03:44:16", "text": "インターネットエンジェルで彼らを助ければ、きっと"}, {"type": "subtitle", "time": 13458.79, "timestamp": "03:44:18", "text": "それら全てに目を通す。見なければならない"}, {"type": "subtitle", "time": 13460.309, "timestamp": "03:44:20", "text": "良いと言っているすべての投稿"}, {"type": "subtitle", "time": 13462.229, "timestamp": "03:44:22", "text": "私のピン留めとフレームに関するもの"}, {"type": "subtitle", "time": 13464.63, "timestamp": "03:44:24", "text": "モール。"}, {"type": "subtitle", "time": 13466.429, "timestamp": "03:44:26", "text": "待って、私は"}, {"type": "subtitle", "time": 13469.309, "timestamp": "03:44:29", "text": "アイデア？いいえ。なぜですか？行く"}, {"type": "subtitle", "time": 13472.95, "timestamp": "03:44:32", "text": "夕暮れ。私は何も理解できなかったと思います。"}, {"type": "subtitle", "time": 13475.03, "timestamp": "03:44:35", "text": "飲み物を飲んで"}, {"type": "subtitle", "time": 13476.01, "timestamp": "03:44:36", "text": "実は"}, {"type": "subtitle", "time": 13480.429, "timestamp": "03:44:40", "text": "[音楽]"}, {"type": "subtitle", "time": 13491.42, "timestamp": "03:44:51", "text": "レベル。"}, {"type": "subtitle", "time": 13493.87, "timestamp": "03:44:53", "text": "[音楽]"}, {"type": "subtitle", "time": 13497.55, "timestamp": "03:44:57", "text": "えーと、一緒に遊ぼう"}]
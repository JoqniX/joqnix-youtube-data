[{"type": "subtitle", "time": 960.47, "timestamp": "00:16:00", "text": "これ？生放送。ああ、彼らは"}, {"type": "subtitle", "time": 965.389, "timestamp": "00:16:05", "text": "サードパーティ向けの統合サポート"}, {"type": "subtitle", "time": 968.6, "timestamp": "00:16:08", "text": "アプリケーション。おお。"}, {"type": "subtitle", "time": 979.189, "timestamp": "00:16:19", "text": "何？統合サポート"}, {"type": "subtitle", "time": 979.72, "timestamp": "00:16:19", "text": "の"}, {"type": "subtitle", "time": 980.829, "timestamp": "00:16:20", "text": "[音楽]"}, {"type": "subtitle", "time": 992.47, "timestamp": "00:16:32", "text": "トゥイッチ。彼らは監視していません。わかりました、私は"}, {"type": "subtitle", "time": 998.59, "timestamp": "00:16:38", "text": "オーディオ。"}, {"type": "subtitle", "time": 1008.949, "timestamp": "00:16:48", "text": "ああ、これは今までで一番素晴らしい"}, {"type": "subtitle", "time": 1011.069, "timestamp": "00:16:51", "text": "持っている"}, {"type": "subtitle", "time": 1019.91, "timestamp": "00:16:59", "text": "くそ、これは俺にベストを尽くすよう刺激を与えてくれる"}]
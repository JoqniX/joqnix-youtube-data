[{"type": "subtitle", "time": 16285.349, "timestamp": "04:31:25", "text": "何てことだ。だからこんなことが起きたのです。おお"}, {"type": "subtitle", "time": 16295.429, "timestamp": "04:31:35", "text": "知る。これをもう一度やらせてもいいですか？"}, {"type": "subtitle", "time": 16298.67, "timestamp": "04:31:38", "text": "彼女を落ち着かせるとか、"}, {"type": "subtitle", "time": 16311.99, "timestamp": "04:31:51", "text": "そして私は、これを容認しません"}]
[{"type": "subtitle", "time": 18603.83, "timestamp": "05:10:03", "text": "しかし、それに関しては少し事態が荒れてしまう。"}, {"type": "subtitle", "time": 18606.47, "timestamp": "05:10:06", "text": "ああ、私は彼女が悪者になることを望んでいない"}, {"type": "subtitle", "time": 18615.51, "timestamp": "05:10:15", "text": "ああ、ストレスレベルは"}, {"type": "subtitle", "time": 18621.91, "timestamp": "05:10:21", "text": "難しい。えっと、目が覚めたら太陽がすでに昇っていた"}, {"type": "subtitle", "time": 18624.39, "timestamp": "05:10:24", "text": "設定。ほとんどの後、頭がぼんやりする。できますか"}, {"type": "subtitle", "time": 18626.75, "timestamp": "05:10:26", "text": "ただ寝るだけ？"}, {"type": "subtitle", "time": 18628.51, "timestamp": "05:10:28", "text": "もちろん。"}, {"type": "subtitle", "time": 18630.948, "timestamp": "05:10:30", "text": "うん。今は嘘をつきたくないし、"}, {"type": "subtitle", "time": 18632.51, "timestamp": "05:10:32", "text": "もう。"}, {"type": "subtitle", "time": 18634.91, "timestamp": "05:10:34", "text": "私"}, {"type": "subtitle", "time": 18636.83, "timestamp": "05:10:36", "text": "いいえ"}, {"type": "subtitle", "time": 18649.46, "timestamp": "05:10:49", "text": "もっと。あなたの"}, {"type": "subtitle", "time": 18650.99, "timestamp": "05:10:50", "text": "[音楽]"}]
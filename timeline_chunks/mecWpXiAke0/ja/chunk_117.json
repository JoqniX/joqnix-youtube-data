[{"type": "subtitle", "time": 7036.35, "timestamp": "01:57:16", "text": "つまり、私には選択肢がないということですか？"}, {"type": "subtitle", "time": 7039.189, "timestamp": "01:57:19", "text": "わかりました、問題は私が"}, {"type": "subtitle", "time": 7041.55, "timestamp": "01:57:21", "text": "表示中。わかった、いいよ。私は見せません"}, {"type": "subtitle", "time": 7049.83, "timestamp": "01:57:29", "text": "トゥイッチ。さて、他に何かやるべきことはありますか？"}]
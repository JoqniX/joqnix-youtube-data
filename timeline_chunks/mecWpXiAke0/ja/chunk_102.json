[{"type": "subtitle", "time": 6122.87, "timestamp": "01:42:02", "text": "えっと、私、しくじった？私は"}, {"type": "subtitle", "time": 6124.83, "timestamp": "01:42:04", "text": "実際に台無しにする"}, {"type": "subtitle", "time": 6129.55, "timestamp": "01:42:09", "text": "上？私は本当にしくじってしまったのだろうか？おお、"}, {"type": "subtitle", "time": 6133.27, "timestamp": "01:42:13", "text": "いいえ。えっと、待って、待って、待って、待って、待って。"}, {"type": "subtitle", "time": 6135.18, "timestamp": "01:42:15", "text": "とても混乱しています、"}, {"type": "subtitle", "time": 6136.99, "timestamp": "01:42:16", "text": "[音楽]"}, {"type": "subtitle", "time": 6141.35, "timestamp": "01:42:21", "text": "兄弟。私は予定通りにEPをリリースするでしょうか？私は"}, {"type": "subtitle", "time": 6145.03, "timestamp": "01:42:25", "text": "EPは33？"}, {"type": "subtitle", "time": 6146.59, "timestamp": "01:42:26", "text": "楽しい日曜日を！"}, {"type": "subtitle", "time": 6149.95, "timestamp": "01:42:29", "text": "33. 今日は月曜日です。私たちには"}, {"type": "subtitle", "time": 6151.47, "timestamp": "01:42:31", "text": "わかった。"}, {"type": "subtitle", "time": 6155.79, "timestamp": "01:42:35", "text": "眠りにつけるといいな。"}, {"type": "subtitle", "time": 6174.13, "timestamp": "01:42:54", "text": "わかった。 34 34 33 33。"}]
[{"type": "subtitle", "time": 19260.23, "timestamp": "05:21:00", "text": "ゲームで遊ぶ。信じられない"}, {"type": "subtitle", "time": 19262.708, "timestamp": "05:21:02", "text": "自分の心をさらけ出しながら、ぐるぐる回っている。"}, {"type": "subtitle", "time": 19263.99, "timestamp": "05:21:03", "text": "みんなと遊ぶ。ありがとう"}, {"type": "subtitle", "time": 19265.75, "timestamp": "05:21:05", "text": "私の配信に合わせてプレイしています。"}, {"type": "subtitle", "time": 19267.868, "timestamp": "05:21:07", "text": "愛のためにこのパーティーを続けよう"}, {"type": "subtitle", "time": 19270.46, "timestamp": "05:21:10", "text": "永遠に。ああ、これはとてもかわいい"}, {"type": "subtitle", "time": 19277.21, "timestamp": "05:21:17", "text": "画像。かわいい、"}, {"type": "subtitle", "time": 19279.31, "timestamp": "05:21:19", "text": "[音楽]"}, {"type": "subtitle", "time": 19282.15, "timestamp": "05:21:22", "text": "かわいい。ねえ、私にとって大丈夫だと思う？"}, {"type": "subtitle", "time": 19283.47, "timestamp": "05:21:23", "text": "に"}, {"type": "subtitle", "time": 19285.868, "timestamp": "05:21:25", "text": "殺す？何ですか"}, {"type": "subtitle", "time": 19289.59, "timestamp": "05:21:29", "text": "間違っている？いろいろ考えていたところ。おお、"}, {"type": "subtitle", "time": 19295.19, "timestamp": "05:21:35", "text": "誰かいるかなと思って"}, {"type": "subtitle", "time": 19297.35, "timestamp": "05:21:37", "text": "私がどこかへ行ってしまったら、寂しく思うだろう"}, {"type": "subtitle", "time": 19298.868, "timestamp": "05:21:38", "text": "ビデオゲームを見る、ただ誰かを見る"}, {"type": "subtitle", "time": 19301.59, "timestamp": "05:21:41", "text": "私の人生を配信しよう。えっと、これは私も"}, {"type": "subtitle", "time": 19309.55, "timestamp": "05:21:49", "text": "時々、もし私が"}, {"type": "subtitle", "time": 19312.51, "timestamp": "05:21:52", "text": "消えた"}, {"type": "subtitle", "time": 19315.708, "timestamp": "05:21:55", "text": "どこにも待っていなければ誰かが見逃すだろう"}, {"type": "subtitle", "time": 19318.47, "timestamp": "05:21:58", "text": "もし私がいなくなったら、彼らは"}]
[{"type": "subtitle", "time": 10346.389, "timestamp": "02:52:26", "text": "はい、ゲームは保存されました。私たちは辞めることができます"}, {"type": "subtitle", "time": 10349.99, "timestamp": "02:52:29", "text": "今日。明日も続けます。わかった。"}, {"type": "subtitle", "time": 10355.469, "timestamp": "02:52:35", "text": "明日午前10時30分（インド標準時）に戻ってきます"}, {"type": "subtitle", "time": 10359.11, "timestamp": "02:52:39", "text": "そして中国語にあるものは"}, {"type": "subtitle", "time": 10362.87, "timestamp": "02:52:42", "text": "午後1時になります。わかった。しかし、その流れは"}, {"type": "subtitle", "time": 10366.95, "timestamp": "02:52:46", "text": "そこに行きます。 24時間ライブ配信します"}, {"type": "subtitle", "time": 10369.55, "timestamp": "02:52:49", "text": "毎日。だから、"}, {"type": "subtitle", "time": 10371.15, "timestamp": "02:52:51", "text": "心配。"}, {"type": "subtitle", "time": 10375.03, "timestamp": "02:52:55", "text": "えっと、もう一度繰り返しますが、信じてください"}]
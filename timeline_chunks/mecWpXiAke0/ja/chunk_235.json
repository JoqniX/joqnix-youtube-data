[{"type": "subtitle", "time": 14102.229, "timestamp": "03:55:02", "text": "ほとんどの人がそうする。彼らはバッグを身につけ、"}, {"type": "subtitle", "time": 14109.67, "timestamp": "03:55:09", "text": "アパート。彼女はなぜいつも「祝福」と言うのか"}, {"type": "subtitle", "time": 14114.99, "timestamp": "03:55:14", "text": "わからない"}, {"type": "subtitle", "time": 14121.91, "timestamp": "03:55:21", "text": "かわいい。そして、そうすればあなたは"}, {"type": "subtitle", "time": 14125.269, "timestamp": "03:55:25", "text": "本当の自分。見せびらかす必要はない"}, {"type": "subtitle", "time": 14127.67, "timestamp": "03:55:27", "text": "あなた自身。日本ではプライバシーは"}, {"type": "subtitle", "time": 14129.99, "timestamp": "03:55:29", "text": "重要ですよね？匿名性は"}, {"type": "subtitle", "time": 14132.3, "timestamp": "03:55:32", "text": "重要で"}, {"type": "subtitle", "time": 14134.11, "timestamp": "03:55:34", "text": "[音楽]"}, {"type": "subtitle", "time": 14141.429, "timestamp": "03:55:41", "text": "待って。放棄。その時間は人生だ"}, {"type": "subtitle", "time": 14148.03, "timestamp": "03:55:48", "text": "誰でも。いいえ、これは"}, {"type": "subtitle", "time": 14150.189, "timestamp": "03:55:50", "text": "本物。"}, {"type": "subtitle", "time": 14154.189, "timestamp": "03:55:54", "text": "真実。誰も私のことを気にかけていない"}, {"type": "subtitle", "time": 14157.469, "timestamp": "03:55:57", "text": "どちらか。これを削除した方がいいでしょうか？私はしません"}]
[{"type": "subtitle", "time": 4511.63, "timestamp": "01:15:11", "text": "コンソール？ああ、このコンソール"}, {"type": "subtitle", "time": 4525.11, "timestamp": "01:15:25", "text": "すべて。接続待ちです。わかった、"}, {"type": "subtitle", "time": 4527.59, "timestamp": "01:15:27", "text": "まあ、そうですね。ねえ、私たちは今いる場所にたどり着いたんだ"}, {"type": "subtitle", "time": 4534.59, "timestamp": "01:15:34", "text": "それは良いことだ。それは"}, {"type": "subtitle", "time": 4541.11, "timestamp": "01:15:41", "text": "えっと、ここで私がもっとうまくできることは何でしょうか？そのこと"}, {"type": "subtitle", "time": 4543.59, "timestamp": "01:15:43", "text": "OBSからの音声が聞こえない場合、"}, {"type": "subtitle", "time": 4545.709, "timestamp": "01:15:45", "text": "ストリーミング音楽のように、"}]
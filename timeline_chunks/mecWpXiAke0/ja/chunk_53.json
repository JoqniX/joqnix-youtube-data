[{"type": "subtitle", "time": 3181.03, "timestamp": "00:53:01", "text": "コメント。何も覚えていない"}, {"type": "subtitle", "time": 3183.99, "timestamp": "00:53:03", "text": "積極的に活動していた人々の名前"}, {"type": "subtitle", "time": 3188.309, "timestamp": "00:53:08", "text": "私の配信にビリービリーが来ます。"}, {"type": "subtitle", "time": 3191.15, "timestamp": "00:53:11", "text": "私は呼ばれたくない"}, {"type": "subtitle", "time": 3194.309, "timestamp": "00:53:14", "text": "外。ああ、怖い。でも、ええ、"}, {"type": "subtitle", "time": 3196.87, "timestamp": "00:53:16", "text": "ライブ配信を見てみます。はい、私は"}, {"type": "subtitle", "time": 3198.75, "timestamp": "00:53:18", "text": "準備する"}, {"type": "subtitle", "time": 3202.75, "timestamp": "00:53:22", "text": "精神的に。私は自分自身を準備しなければならない"}, {"type": "subtitle", "time": 3204.99, "timestamp": "00:53:24", "text": "精神的に。おお"}, {"type": "subtitle", "time": 3207.829, "timestamp": "00:53:27", "text": "いいえ、精神的な準備が必要です。私"}, {"type": "subtitle", "time": 3217.75, "timestamp": "00:53:37", "text": "準備ができて。ああ、なんてことだ、心の準備ができていない。"}, {"type": "subtitle", "time": 3238.19, "timestamp": "00:53:58", "text": "シーン。そして"}]
[{"type": "subtitle", "time": 17942.47, "timestamp": "04:59:02", "text": "人々が飽きてしまうと驚く"}, {"type": "subtitle", "time": 17946.03, "timestamp": "04:59:06", "text": "彼ら自身の評論家。待って、"}, {"type": "subtitle", "time": 17947.94, "timestamp": "04:59:07", "text": "何？"}, {"type": "subtitle", "time": 17950.11, "timestamp": "04:59:10", "text": "[音楽]"}, {"type": "subtitle", "time": 17954.43, "timestamp": "04:59:14", "text": "ハニー、それは数に入らないわ。"}, {"type": "subtitle", "time": 17957.54, "timestamp": "04:59:17", "text": "わかった。ああ、大変だ。"}, {"type": "subtitle", "time": 17968.868, "timestamp": "04:59:28", "text": "[音楽]"}, {"type": "subtitle", "time": 17971.03, "timestamp": "04:59:31", "text": "郵便でたくさんの手紙が届いた"}, {"type": "subtitle", "time": 17974.23, "timestamp": "04:59:34", "text": "税金や国のくだらないことについて語る。これ"}, {"type": "subtitle", "time": 17985.91, "timestamp": "04:59:45", "text": "神。待って。えっと、行く前に、"}, {"type": "subtitle", "time": 17991.868, "timestamp": "04:59:51", "text": "[音楽]"}, {"type": "subtitle", "time": 17993.99, "timestamp": "04:59:53", "text": "彼女は自分が計画していたものを探していた。"}, {"type": "subtitle", "time": 17995.99, "timestamp": "04:59:55", "text": "彼女が元気でいるといいな。彼女のもの"}, {"type": "subtitle", "time": 17999.03, "timestamp": "04:59:59", "text": "彼女が友達に会いに行くのはとても的確だ"}]
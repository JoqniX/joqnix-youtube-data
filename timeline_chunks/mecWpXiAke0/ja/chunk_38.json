[{"type": "subtitle", "time": 2288.27, "timestamp": "00:38:08", "text": "えっと、私は"}, {"type": "subtitle", "time": 2295.03, "timestamp": "00:38:15", "text": "えっと、正直に言うと、ストリーミングを始めたかったんです"}, {"type": "subtitle", "time": 2297.23, "timestamp": "00:38:17", "text": "詳細はこちら"}, {"type": "subtitle", "time": 2300.71, "timestamp": "00:38:20", "text": "積極的に。ああ、でも"}, {"type": "subtitle", "time": 2306.67, "timestamp": "00:38:26", "text": "えーと、でも私のPCが"}, {"type": "subtitle", "time": 2314.03, "timestamp": "00:38:34", "text": "マルチ"}, {"type": "subtitle", "time": 2317.15, "timestamp": "00:38:37", "text": "ストリーミング処理"}, {"type": "subtitle", "time": 2322.55, "timestamp": "00:38:42", "text": "ストリーミングを処理する。まあ、難しくなった"}, {"type": "subtitle", "time": 2325.23, "timestamp": "00:38:45", "text": "私にとってより難しい"}, {"type": "subtitle", "time": 2331.27, "timestamp": "00:38:51", "text": "ここでストリームストリームですが、ええと、私は喜んで"}, {"type": "subtitle", "time": 2334.71, "timestamp": "00:38:54", "text": "最善を尽くす"}]
[{"type": "subtitle", "time": 18901.39, "timestamp": "05:15:01", "text": "空白？なんてこった。私が始めたらどうなるだろう？おお"}, {"type": "subtitle", "time": 18904.708, "timestamp": "05:15:04", "text": "いいえ。なんてこった。それはまずい。それはまずい。"}, {"type": "subtitle", "time": 18906.628, "timestamp": "05:15:06", "text": "それはまずい。なんてこった。ああ、私は"}, {"type": "subtitle", "time": 18908.35, "timestamp": "05:15:08", "text": "彼女を倒せ"}, {"type": "subtitle", "time": 18917.75, "timestamp": "05:15:17", "text": "君が私のアイデアを盗んだことは知っているよ"}, {"type": "subtitle", "time": 18919.51, "timestamp": "05:15:19", "text": "以前配信したストリーム。まるであなたがそうしなかったかのように"}, {"type": "subtitle", "time": 18922.11, "timestamp": "05:15:22", "text": "なりたい"}, {"type": "subtitle", "time": 18925.67, "timestamp": "05:15:25", "text": "訴えられた。計画を立てるのにも、もっと時間が必要だ。それで"}, {"type": "subtitle", "time": 18928.15, "timestamp": "05:15:28", "text": "もしあるなら、私は行きます。では教えてください"}, {"type": "subtitle", "time": 18931.99, "timestamp": "05:15:31", "text": "私がこれからすることは、わかりました。なんてこった。私はしません"}, {"type": "subtitle", "time": 18934.19, "timestamp": "05:15:34", "text": "彼女に中毒になってほしい"}, {"type": "subtitle", "time": 18937.708, "timestamp": "05:15:37", "text": "18歳以上向けのもの。それは"}, {"type": "subtitle", "time": 18940.31, "timestamp": "05:15:40", "text": "悪い。それはまずい。それはまずい。私はしません"}, {"type": "subtitle", "time": 18941.708, "timestamp": "05:15:41", "text": "彼女が欲しい"}, {"type": "subtitle", "time": 18955.29, "timestamp": "05:15:55", "text": "何か div。この曲じゃないですか？"}]
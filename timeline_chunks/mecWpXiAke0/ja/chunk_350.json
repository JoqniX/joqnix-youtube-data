[{"type": "subtitle", "time": 21000.788, "timestamp": "05:50:00", "text": "一番重要なのは、私たちは"}, {"type": "subtitle", "time": 21007.67, "timestamp": "05:50:07", "text": "えっと、彼女にそう言わせるストリーマーとか、そうじゃない"}, {"type": "subtitle", "time": 21009.23, "timestamp": "05:50:09", "text": "ブレイクして"}, {"type": "subtitle", "time": 21013.87, "timestamp": "05:50:13", "text": "彼女をそのままにしておくとかそういうこと"}, {"type": "subtitle", "time": 21016.99, "timestamp": "05:50:16", "text": "[音楽]"}, {"type": "subtitle", "time": 21035.59, "timestamp": "05:50:35", "text": "形がすべて"}, {"type": "subtitle", "time": 21043.19, "timestamp": "05:50:43", "text": "何？彼女はなぜリボンジャグリングをしているのですか？"}, {"type": "subtitle", "time": 21045.03, "timestamp": "05:50:45", "text": "揺れている？"}, {"type": "subtitle", "time": 21047.75, "timestamp": "05:50:47", "text": "[音楽]"}, {"type": "subtitle", "time": 21055.628, "timestamp": "05:50:55", "text": "ジャグリング？これらすべてを両立させるのは"}, {"type": "subtitle", "time": 21057.71, "timestamp": "05:50:57", "text": "時間？質問"}]
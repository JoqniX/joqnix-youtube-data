[{"type": "subtitle", "time": 13800.55, "timestamp": "03:50:00", "text": "私たちがやっていると思っていることは何ですか？私たちは遊んでいます"}, {"type": "subtitle", "time": 13802.91, "timestamp": "03:50:02", "text": "困っている配信者"}, {"type": "subtitle", "time": 13806.15, "timestamp": "03:50:06", "text": "オーバーロード。そして現在、K Angelは"}, {"type": "subtitle", "time": 13811.429, "timestamp": "03:50:11", "text": "ロリーゴシックロリータドレスを着ています。そして"}, {"type": "subtitle", "time": 13813.87, "timestamp": "03:50:13", "text": "彼女は新しいフォロワーと新しい"}, {"type": "subtitle", "time": 13820.15, "timestamp": "03:50:20", "text": "支持者。写真をアップロードします"}, {"type": "subtitle", "time": 13822.95, "timestamp": "03:50:22", "text": "後でツイートします。君たちは私に"}, {"type": "subtitle", "time": 13828.07, "timestamp": "03:50:28", "text": "100。ゼロがたくさん並んでいるね。わかった。"}, {"type": "subtitle", "time": 13830.229, "timestamp": "03:50:30", "text": "アンジュとあなたたち全員も、それに従ってください。いいえ、"}, {"type": "subtitle", "time": 13833.99, "timestamp": "03:50:33", "text": "私はロリータに埋葬されるだろう。おお"}, {"type": "subtitle", "time": 13836.229, "timestamp": "03:50:36", "text": "ああ、彼女は本当に可愛い。"}, {"type": "subtitle", "time": 13837.14, "timestamp": "03:50:37", "text": "ロリータ"}, {"type": "subtitle", "time": 13838.269, "timestamp": "03:50:38", "text": "[音楽]"}, {"type": "subtitle", "time": 13848.59, "timestamp": "03:50:48", "text": "神。たぶん15歳まで行くと思う"}, {"type": "subtitle", "time": 13856.87, "timestamp": "03:50:56", "text": "はぁ？彼女にヘッドパスしてもいいですか？いいえ。"}, {"type": "subtitle", "time": 13859.79, "timestamp": "03:50:59", "text": "明日へ行こう。"}]
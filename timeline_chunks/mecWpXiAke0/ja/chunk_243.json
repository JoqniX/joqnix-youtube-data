[{"type": "subtitle", "time": 14580.349, "timestamp": "04:03:00", "text": "前に。あなたは見たことがない"}, {"type": "subtitle", "time": 14595.11, "timestamp": "04:03:15", "text": "犯罪ゲームよりも私は"}, {"type": "subtitle", "time": 14597.389, "timestamp": "04:03:17", "text": "ゲームがまだ開催されているのは嬉しいです"}, {"type": "subtitle", "time": 14600.95, "timestamp": "04:03:20", "text": "良い。犯罪摘発とかそういう"}, {"type": "subtitle", "time": 14602.75, "timestamp": "04:03:22", "text": "それは危険だ。待って、"}, {"type": "subtitle", "time": 14607.229, "timestamp": "04:03:27", "text": "何？ゲームを買いましたか？はい、私は"}, {"type": "subtitle", "time": 14609.99, "timestamp": "04:03:29", "text": "した。吸血鬼ハンターが"}, {"type": "subtitle", "time": 14612.45, "timestamp": "04:03:32", "text": "この邪悪な城。"}, {"type": "subtitle", "time": 14617.59, "timestamp": "04:03:37", "text": "[音楽]"}]
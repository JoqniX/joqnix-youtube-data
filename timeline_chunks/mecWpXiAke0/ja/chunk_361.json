[{"type": "subtitle", "time": 21661.07, "timestamp": "06:01:01", "text": "これ"}, {"type": "subtitle", "time": 21663.75, "timestamp": "06:01:03", "text": "もっと。あまり多くは手に入らない"}, {"type": "subtitle", "time": 21665.43, "timestamp": "06:01:05", "text": "私が望んでいたほどの購読者数。の"}, {"type": "subtitle", "time": 21667.91, "timestamp": "06:01:07", "text": "目を落とした瞬間"}, {"type": "subtitle", "time": 21670.47, "timestamp": "06:01:10", "text": "私が知っているのはこれだけ、あなたは死んでいます"}, {"type": "subtitle", "time": 21673.27, "timestamp": "06:01:13", "text": "水。だから、私は自分自身を選び続けなければならない"}, {"type": "subtitle", "time": 21675.51, "timestamp": "06:01:15", "text": "立ち上がってたくさんのフォロワーを獲得し、"}, {"type": "subtitle", "time": 21677.948, "timestamp": "06:01:17", "text": "1つの購読者"}, {"type": "subtitle", "time": 21680.75, "timestamp": "06:01:20", "text": "ショット。ここでの食事は"}, {"type": "subtitle", "time": 21682.75, "timestamp": "06:01:22", "text": "来る。彼女"}, {"type": "subtitle", "time": 21684.91, "timestamp": "06:01:24", "text": "手に入れた"}, {"type": "subtitle", "time": 21687.15, "timestamp": "06:01:27", "text": "122,000"}, {"type": "subtitle", "time": 21689.548, "timestamp": "06:01:29", "text": "フォロワー。"}, {"type": "subtitle", "time": 21693.07, "timestamp": "06:01:33", "text": "おお。家を殺すべきではない"}, {"type": "subtitle", "time": 21695.46, "timestamp": "06:01:35", "text": "一緒に"}, {"type": "subtitle", "time": 21697.628, "timestamp": "06:01:37", "text": "[音楽]"}, {"type": "subtitle", "time": 21701.27, "timestamp": "06:01:41", "text": "明日はいいよ。わかった。私は自分のやり方を知っています"}, {"type": "subtitle", "time": 21703.19, "timestamp": "06:01:43", "text": "長時間配信します。 3時間ですよね？"}, {"type": "subtitle", "time": 21705.948, "timestamp": "06:01:45", "text": "ストリームを終了すべきだと思う"}, {"type": "subtitle", "time": 21713.75, "timestamp": "06:01:53", "text": "ゲーム。しかし既に、それは私に費用がかかっている"}]
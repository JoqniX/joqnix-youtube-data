[{"type": "subtitle", "time": 16325.349, "timestamp": "04:32:05", "text": "ここ。だから急いで。あ、待って。あなたは何を"}, {"type": "subtitle", "time": 16339.67, "timestamp": "04:32:19", "text": "DMで特別なメッセージをもらいました。よお、私はスポンサーになった"}, {"type": "subtitle", "time": 16340.67, "timestamp": "04:32:20", "text": "大きなリンク、"}, {"type": "subtitle", "time": 16342.87, "timestamp": "04:32:22", "text": "赤ちゃん。何と書いてあるか見てみましょう。私たちは好きです"}, {"type": "subtitle", "time": 16345.11, "timestamp": "04:32:25", "text": "あなたにレビューをお願いします"}, {"type": "subtitle", "time": 16347.269, "timestamp": "04:32:27", "text": "納豆風味コーラ云々と言って"}, {"type": "subtitle", "time": 16349.269, "timestamp": "04:32:29", "text": "彼らは納豆を私に支給してくれるだろう"}, {"type": "subtitle", "time": 16357.03, "timestamp": "04:32:37", "text": "ああ、新しい飲み物の広告を試しているところだ。なぜだめですか？"}, {"type": "subtitle", "time": 16358.79, "timestamp": "04:32:38", "text": "うん、いいんじゃない？仕事。それは仕事だ。そうします"}, {"type": "subtitle", "time": 16360.71, "timestamp": "04:32:40", "text": "私のベスト。これは真のプロフェッショナルを意味します"}, {"type": "subtitle", "time": 16364.07, "timestamp": "04:32:44", "text": "今はストリーマーです。"}, {"type": "subtitle", "time": 16365.389, "timestamp": "04:32:45", "text": "おお"}, {"type": "subtitle", "time": 16376.16, "timestamp": "04:32:56", "text": "もの。私の"}]
[{"type": "subtitle", "time": 67.23, "timestamp": "00:01:07", "text": "ええ、そうですね。わかった。 YouTube を取得させてください"}, {"type": "subtitle", "time": 75.67, "timestamp": "00:01:15", "text": "チャットは今、ええと、たくさんあることはわかっています"}, {"type": "subtitle", "time": 79.67, "timestamp": "00:01:19", "text": "もし私が持っているなら、私は今、たくさんのストレスを抱えるでしょう"}, {"type": "subtitle", "time": 83.51, "timestamp": "00:01:23", "text": "なぜなら、今はビリーもいるから"}, {"type": "subtitle", "time": 86.99, "timestamp": "00:01:26", "text": "混ぜ合わせる。ああ、神様、私は"}, {"type": "subtitle", "time": 88.91, "timestamp": "00:01:28", "text": "得る"}, {"type": "subtitle", "time": 92.429, "timestamp": "00:01:32", "text": "痛み。ああ、読むのを忘れてた"}, {"type": "subtitle", "time": 97.03, "timestamp": "00:01:37", "text": "今日の配信について"}, {"type": "subtitle", "time": 98.67, "timestamp": "00:01:38", "text": "えっと、"}, {"type": "subtitle", "time": 103.22999999999999, "timestamp": "00:01:43", "text": "ここ、ここ、ここ。しかし"}, {"type": "subtitle", "time": 106.19, "timestamp": "00:01:46", "text": "私たちはまだ"}, {"type": "subtitle", "time": 107.789, "timestamp": "00:01:47", "text": "生きている"}, {"type": "subtitle", "time": 110.83, "timestamp": "00:01:50", "text": "現在。ただ"}, {"type": "subtitle", "time": 115.31, "timestamp": "00:01:55", "text": "ちょうど私のちょうど私が"}]
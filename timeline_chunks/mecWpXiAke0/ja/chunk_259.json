[{"type": "subtitle", "time": 15544.149, "timestamp": "04:19:04", "text": "待って、でもまた少ししかない"}, {"type": "subtitle", "time": 15547.389, "timestamp": "04:19:07", "text": "少し左寄りですよね？それは"}, {"type": "subtitle", "time": 15550.55, "timestamp": "04:19:10", "text": "大丈夫。彼女の精神状態は重要ですよね？"}, {"type": "subtitle", "time": 15552.429, "timestamp": "04:19:12", "text": "では"}, {"type": "subtitle", "time": 15560.83, "timestamp": "04:19:20", "text": "知る。 77. それは大きな"}, {"type": "subtitle", "time": 15565.0, "timestamp": "04:19:25", "text": "番号。 71. わかった、いいよ。私がやります。"}, {"type": "subtitle", "time": 15570.229, "timestamp": "04:19:30", "text": "[音楽]"}, {"type": "subtitle", "time": 15573.67, "timestamp": "04:19:33", "text": "主にあなたの精神状態はどうですか？"}, {"type": "subtitle", "time": 15580.07, "timestamp": "04:19:40", "text": "右？私は大好きです 私は"}, {"type": "subtitle", "time": 15581.389, "timestamp": "04:19:41", "text": "私の"}, {"type": "subtitle", "time": 15586.32, "timestamp": "04:19:46", "text": "頭も。何てことだ。さようなら。"}, {"type": "subtitle", "time": 15593.349, "timestamp": "04:19:53", "text": "私はそれを自分の中でやろうと思ったが、うわぁ"}, {"type": "subtitle", "time": 15595.03, "timestamp": "04:19:55", "text": "私の服は結構着心地がいい。私"}, {"type": "subtitle", "time": 15597.79, "timestamp": "04:19:57", "text": "このまま続けても大丈夫だと思う"}]
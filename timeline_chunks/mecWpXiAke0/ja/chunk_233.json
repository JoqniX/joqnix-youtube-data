[{"type": "subtitle", "time": 13981.87, "timestamp": "03:53:01", "text": "それは"}, {"type": "subtitle", "time": 13985.95, "timestamp": "03:53:05", "text": "自分。レトロゲームの中には、ストリーミング配信には向かないものもあります。"}, {"type": "subtitle", "time": 13994.87, "timestamp": "03:53:14", "text": "わかった。つまり、人々は"}, {"type": "subtitle", "time": 13996.79, "timestamp": "03:53:16", "text": "彼女のプライベートアカウントを見たよね？なぜならそれは"}, {"type": "subtitle", "time": 14001.389, "timestamp": "03:53:21", "text": "非公開。実際には誰も見ることができない、"}, {"type": "subtitle", "time": 14003.63, "timestamp": "03:53:23", "text": "右？それは"}, {"type": "subtitle", "time": 14013.79, "timestamp": "03:53:33", "text": "わかった。私はサルを振る舞っています。"}, {"type": "subtitle", "time": 14015.56, "timestamp": "03:53:35", "text": "わかった。ああ、"}, {"type": "subtitle", "time": 14017.469, "timestamp": "03:53:37", "text": "[音楽]"}, {"type": "subtitle", "time": 14031.03, "timestamp": "03:53:51", "text": "いいえ、そう思いますよ。いいえ、それは違います"}, {"type": "subtitle", "time": 14032.63, "timestamp": "03:53:52", "text": "君はそう思うと思うけど、もし君が浮気したら"}, {"type": "subtitle", "time": 14035.22, "timestamp": "03:53:55", "text": "俺がお前を殺してやる。ああ、"}, {"type": "subtitle", "time": 14039.229, "timestamp": "03:53:59", "text": "[音楽]"}]
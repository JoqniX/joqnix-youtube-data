[{"type": "subtitle", "time": 18846.43, "timestamp": "05:14:06", "text": "嘘だ、今は大丈夫だ。"}, {"type": "subtitle", "time": 18861.59, "timestamp": "05:14:21", "text": "でも自分の顔がどれだけ可愛いかはよくわからない"}, {"type": "subtitle", "time": 18863.19, "timestamp": "05:14:23", "text": "それについて話している。次のステップとして、"}, {"type": "subtitle", "time": 18866.31, "timestamp": "05:14:26", "text": "重要なステップ。だから、そうしない限り"}, {"type": "subtitle", "time": 18867.708, "timestamp": "05:14:27", "text": "殺す"}, {"type": "subtitle", "time": 18871.23, "timestamp": "05:14:31", "text": "私にそう言ってくれてありがとう。でも、もしあなたが"}, {"type": "subtitle", "time": 18879.51, "timestamp": "05:14:39", "text": "ストリーマー。なんてこった。"}, {"type": "subtitle", "time": 18890.11, "timestamp": "05:14:50", "text": "[音楽]"}, {"type": "subtitle", "time": 18892.27, "timestamp": "05:14:52", "text": "私が"}]
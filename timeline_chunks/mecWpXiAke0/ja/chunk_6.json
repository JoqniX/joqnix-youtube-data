[{"type": "subtitle", "time": 361.83, "timestamp": "00:06:01", "text": "すべてについて、そしてYouTubeについて"}, {"type": "subtitle", "time": 363.99, "timestamp": "00:06:03", "text": "説明とすべてと"}, {"type": "subtitle", "time": 367.11, "timestamp": "00:06:07", "text": "公開日とその他のストリーム"}, {"type": "subtitle", "time": 370.15, "timestamp": "00:06:10", "text": "そして全て。文字通り、これは"}, {"type": "subtitle", "time": 374.39, "timestamp": "00:06:14", "text": "私は自分のチャンネルのためにずっとやりたかった"}, {"type": "subtitle", "time": 376.83, "timestamp": "00:06:16", "text": "君たちのために"}, {"type": "subtitle", "time": 382.07, "timestamp": "00:06:22", "text": "もの。これが私のやりたかったことだ。"}, {"type": "subtitle", "time": 384.55, "timestamp": "00:06:24", "text": "これは私がずっとやりたかったことです。そして"}, {"type": "subtitle", "time": 386.749, "timestamp": "00:06:26", "text": "彼らは携帯電話を持っている"}, {"type": "subtitle", "time": 389.59, "timestamp": "00:06:29", "text": "サポート。この人は、"}, {"type": "subtitle", "time": 392.87, "timestamp": "00:06:32", "text": "最新情報を入手できるモバイル"}, {"type": "subtitle", "time": 395.71, "timestamp": "00:06:35", "text": "ライブ配信中やその他諸々"}, {"type": "subtitle", "time": 398.30899999999997, "timestamp": "00:06:38", "text": "情報。ゲームをプレイして"}, {"type": "subtitle", "time": 400.55, "timestamp": "00:06:40", "text": "もの。プッシュ通知を受け取ることができます"}, {"type": "subtitle", "time": 403.67, "timestamp": "00:06:43", "text": "アプリ内で視聴することもできます"}, {"type": "subtitle", "time": 406.07, "timestamp": "00:06:46", "text": "YouTubeやTwitchに行くよりも"}, {"type": "subtitle", "time": 409.39, "timestamp": "00:06:49", "text": "アプリ。ああ、"}, {"type": "subtitle", "time": 412.67, "timestamp": "00:06:52", "text": "神。とても良い。それで"}, {"type": "subtitle", "time": 417.629, "timestamp": "00:06:57", "text": "良い。とても良い。ゲームをプレイできます"}]
[{"type": "subtitle", "time": 13930.91, "timestamp": "03:52:10", "text": "電車。私は行くのが大好きです"}, {"type": "subtitle", "time": 13933.79, "timestamp": "03:52:13", "text": "実際は外です。"}, {"type": "subtitle", "time": 13937.429, "timestamp": "03:52:17", "text": "はい。でも次回配信するときはPCで"}, {"type": "subtitle", "time": 13941.51, "timestamp": "03:52:21", "text": "それは超高性能PCからのものだろう。彼らは"}, {"type": "subtitle", "time": 13943.91, "timestamp": "03:52:23", "text": "トロール行為をするのは、それが心理的なものだからだ。しかしそれは"}, {"type": "subtitle", "time": 13945.349, "timestamp": "03:52:25", "text": "実際にはでこぼこしたガラクタがたくさんあって"}, {"type": "subtitle", "time": 13947.91, "timestamp": "03:52:27", "text": "チーンという音と楽しい時間。でも、知ってるでしょ？"}, {"type": "subtitle", "time": 13949.75, "timestamp": "03:52:29", "text": "何が変なの？みんな男たち"}, {"type": "subtitle", "time": 13952.469, "timestamp": "03:52:32", "text": "オタクっぽい人たちだけど、女の子もたくさんいる"}, {"type": "subtitle", "time": 13954.309, "timestamp": "03:52:34", "text": "それらは本当にきれいです。なぜなら"}, {"type": "subtitle", "time": 13957.469, "timestamp": "03:52:37", "text": "カフェと呼ばれるところで働くか、"}, {"type": "subtitle", "time": 13965.469, "timestamp": "03:52:45", "text": "ああ、いい考えだ"}, {"type": "subtitle", "time": 13968.15, "timestamp": "03:52:48", "text": "今回はゲームをゲットしよう。ゲームをいくつか買いました"}, {"type": "subtitle", "time": 13969.99, "timestamp": "03:52:49", "text": "昔からのゲーマーが喜ぶようなもの。後"}, {"type": "subtitle", "time": 13971.349, "timestamp": "03:52:51", "text": "すべて、彼らは"}, {"type": "subtitle", "time": 13979.51, "timestamp": "03:52:59", "text": "わかった。しかし、レトロゲームははるかに難しい。それで"}]
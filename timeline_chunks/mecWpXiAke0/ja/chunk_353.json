[{"type": "subtitle", "time": 21181.59, "timestamp": "05:53:01", "text": "ランダムに。こんにちは、イイ。でも、どうやって"}, {"type": "subtitle", "time": 21182.91, "timestamp": "05:53:02", "text": "これは"}, {"type": "subtitle", "time": 21186.47, "timestamp": "05:53:06", "text": "行く。彼女は他のストリーマーとは違って、"}, {"type": "subtitle", "time": 21193.03, "timestamp": "05:53:13", "text": "もちろん。でも彼女はヴィスです。何てことだ。それは"}, {"type": "subtitle", "time": 21195.48, "timestamp": "05:53:15", "text": "それは 自分。彼女は私を初めて笑顔にしてくれた"}, {"type": "subtitle", "time": 21198.0, "timestamp": "05:53:18", "text": "自分。彼女は私を初めて笑顔にしてくれた 私の人生において。"}, {"type": "subtitle", "time": 21199.32, "timestamp": "05:53:19", "text": "私の人生において。 ありがとうございます。今、泣いています。ああ、"}, {"type": "subtitle", "time": 21209.788, "timestamp": "05:53:29", "text": "主。"}, {"type": "subtitle", "time": 21212.59, "timestamp": "05:53:32", "text": "祝福あれ。"}, {"type": "subtitle", "time": 21219.708, "timestamp": "05:53:39", "text": "さよなら。祝福。快適な時間をありがとう"}, {"type": "subtitle", "time": 21224.19, "timestamp": "05:53:44", "text": "エビ。わかった。そして私はそうしました"}, {"type": "subtitle", "time": 21227.868, "timestamp": "05:53:47", "text": "偶然にも戻ってきたばかりです"}, {"type": "subtitle", "time": 21230.23, "timestamp": "05:53:50", "text": "代表？でも、あなたはすべての"}, {"type": "subtitle", "time": 21239.35, "timestamp": "05:53:59", "text": "友達。待って、No.に到達しました。待って、"}]
[{"type": "subtitle", "time": 3360.47, "timestamp": "00:56:00", "text": "今。私はまだ準備ができていません。えっと、その、その、その"}, {"type": "subtitle", "time": 3373.87, "timestamp": "00:56:13", "text": "タイトル。ああ、"}, {"type": "subtitle", "time": 3379.109, "timestamp": "00:56:19", "text": "神。これは何と言っているのですか？えっと、私は"}, {"type": "subtitle", "time": 3381.589, "timestamp": "00:56:21", "text": "えっと、どんなタイトルを付ければいいですか？"}, {"type": "subtitle", "time": 3385.15, "timestamp": "00:56:25", "text": "ストリーム用ですか？えっと"}, {"type": "subtitle", "time": 3395.71, "timestamp": "00:56:35", "text": "英語"}, {"type": "subtitle", "time": 3397.95, "timestamp": "00:56:37", "text": "v"}, {"type": "subtitle", "time": 3413.99, "timestamp": "00:56:53", "text": "よし、準備はできたと思う。私は"}, {"type": "subtitle", "time": 3418.63, "timestamp": "00:56:58", "text": "データは後で変更すればいいと思う。"}]
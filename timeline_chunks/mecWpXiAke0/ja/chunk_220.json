[{"type": "subtitle", "time": 13202.83, "timestamp": "03:40:02", "text": "th"}, {"type": "subtitle", "time": 13206.99, "timestamp": "03:40:06", "text": "ああ、コンサートが大好きなので"}, {"type": "subtitle", "time": 13209.51, "timestamp": "03:40:09", "text": "多くの。日本を手に入れろ。もしあなたが約束するなら"}, {"type": "subtitle", "time": 13211.63, "timestamp": "03:40:11", "text": "君はたくさんのものを手に入れるだろう"}, {"type": "subtitle", "time": 13215.07, "timestamp": "03:40:15", "text": "約束して"}, {"type": "subtitle", "time": 13217.75, "timestamp": "03:40:17", "text": "ありがとう、あなたは最終的に"}, {"type": "subtitle", "time": 13218.91, "timestamp": "03:40:18", "text": "もし"}, {"type": "subtitle", "time": 13229.07, "timestamp": "03:40:29", "text": "それなら慈悲をかけて私を殺してください、あなたは一体何者ですか"}, {"type": "subtitle", "time": 13231.55, "timestamp": "03:40:31", "text": "言い訳をする"}, {"type": "subtitle", "time": 13234.71, "timestamp": "03:40:34", "text": "私にとって、ただ捨てられるものの一つは真実です"}, {"type": "subtitle", "time": 13237.429, "timestamp": "03:40:37", "text": "ナイフの上で、私はとても誇りに思っています"}, {"type": "subtitle", "time": 13239.269, "timestamp": "03:40:39", "text": "あなたが私の男だという事実、決して騙さないで"}, {"type": "subtitle", "time": 13241.83, "timestamp": "03:40:41", "text": "あなたは私をあなたに背を向けた。本気ですか"}, {"type": "subtitle", "time": 13244.75, "timestamp": "03:40:44", "text": "エンジェル、君はこう言うべきだ"}, {"type": "subtitle", "time": 13248.469, "timestamp": "03:40:48", "text": "チャマ？何てことだ。お前らの悪口を言ってやる"}, {"type": "subtitle", "time": 13251.269, "timestamp": "03:40:51", "text": "私の専用ドアのところへ、ラマ。同様に"}, {"type": "subtitle", "time": 13254.429, "timestamp": "03:40:54", "text": "誰も見つけない限り、彼らはそこに留まることができる"}, {"type": "subtitle", "time": 13256.91, "timestamp": "03:40:56", "text": "全く気づいていない"}]
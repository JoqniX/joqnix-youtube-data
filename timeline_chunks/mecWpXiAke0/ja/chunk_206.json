[{"type": "subtitle", "time": 12373.07, "timestamp": "03:26:13", "text": "夕暮れ時に行く。"}, {"type": "subtitle", "time": 12375.75, "timestamp": "03:26:15", "text": "ええと、彼らはお金では買えないと言いました"}, {"type": "subtitle", "time": 12377.429, "timestamp": "03:26:17", "text": "幸福だけど、幸福は"}, {"type": "subtitle", "time": 12383.87, "timestamp": "03:26:23", "text": "人生。えっと"}, {"type": "subtitle", "time": 12387.71, "timestamp": "03:26:27", "text": "過去に服用した薬の名前 1錠"}, {"type": "subtitle", "time": 12393.95, "timestamp": "03:26:33", "text": "1日1回2錠服用すると、使用者を落ち着かせることができます。"}, {"type": "subtitle", "time": 12397.75, "timestamp": "03:26:37", "text": "下。待って、1日に2回服用してください。それで"}, {"type": "subtitle", "time": 12401.51, "timestamp": "03:26:41", "text": "いや、受け取らない方がいい。私"}, {"type": "subtitle", "time": 12403.19, "timestamp": "03:26:43", "text": "少し取ってください。うーん、なんだか"}, {"type": "subtitle", "time": 12405.75, "timestamp": "03:26:45", "text": "飲みすぎると体が浮いてしまうけど。わかった、"}, {"type": "subtitle", "time": 12408.469, "timestamp": "03:26:48", "text": "では、それを受け取るべきでしょうか？私は"}, {"type": "subtitle", "time": 12410.309, "timestamp": "03:26:50", "text": "朝と夜。それでいい。それで"}, {"type": "subtitle", "time": 12412.87, "timestamp": "03:26:52", "text": "私はソーシャルメディアはやりません。さあ行こう"}, {"type": "subtitle", "time": 12418.51, "timestamp": "03:26:58", "text": "ツイッター。会ったとき、あなたは"}]
[{"type": "subtitle", "time": 13743.87, "timestamp": "03:49:03", "text": "屋根。ロリータ服をあまり見かけない。"}, {"type": "subtitle", "time": 13746.309, "timestamp": "03:49:06", "text": "わかった。うん。こんにちは、エリー。元気ですか"}, {"type": "subtitle", "time": 13747.309, "timestamp": "03:49:07", "text": "行う"}, {"type": "subtitle", "time": 13750.75, "timestamp": "03:49:10", "text": "今日？よお、"}, {"type": "subtitle", "time": 13766.87, "timestamp": "03:49:26", "text": "えっと、あなたは私が"}, {"type": "subtitle", "time": 13768.389, "timestamp": "03:49:28", "text": "欲しい。"}, {"type": "subtitle", "time": 13770.63, "timestamp": "03:49:30", "text": "二人でロリータを着て出かけようよ。"}, {"type": "subtitle", "time": 13772.99, "timestamp": "03:49:32", "text": "待って、"}, {"type": "subtitle", "time": 13777.189, "timestamp": "03:49:37", "text": "彼女は他の人が参加することを許すだろうか？私"}, {"type": "subtitle", "time": 13782.79, "timestamp": "03:49:42", "text": "知る。スーパーチャットが大好きです。ドレスを追加"}, {"type": "subtitle", "time": 13791.229, "timestamp": "03:49:51", "text": "悪い。"}, {"type": "subtitle", "time": 13794.91, "timestamp": "03:49:54", "text": "そうですね。でも、おっしゃる通りです。"}, {"type": "subtitle", "time": 13797.429, "timestamp": "03:49:57", "text": "わかった。何してるの？あなたは何を"}]
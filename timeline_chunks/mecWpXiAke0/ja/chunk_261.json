[{"type": "subtitle", "time": 15679.91, "timestamp": "04:21:19", "text": "待って、私たちはコメントを読んでいません"}, {"type": "subtitle", "time": 15688.55, "timestamp": "04:21:28", "text": "大丈夫。ああ、彼女は部屋を飾り付けて"}, {"type": "subtitle", "time": 15690.14, "timestamp": "04:21:30", "text": "もの。"}, {"type": "subtitle", "time": 15701.55, "timestamp": "04:21:41", "text": "トップスを脱いでください。"}, {"type": "subtitle", "time": 15704.83, "timestamp": "04:21:44", "text": "ああ、気味が悪い"}, {"type": "subtitle", "time": 15708.349, "timestamp": "04:21:48", "text": "バッカ。君はまるで小さなジェット機みたいだ"}, {"type": "subtitle", "time": 15711.91, "timestamp": "04:21:51", "text": "目。あ、待って。なんとなく、なんとなく"}, {"type": "subtitle", "time": 15714.63, "timestamp": "04:21:54", "text": "ちょっとジェット機っぽい雰囲気がありますよね？私"}]
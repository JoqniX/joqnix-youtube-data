[{"type": "subtitle", "time": 6061.229, "timestamp": "01:41:01", "text": "33."}, {"type": "subtitle", "time": 6104.27, "timestamp": "01:41:44", "text": "34。あれは34。そしてこれも34。日曜日は"}, {"type": "subtitle", "time": 6113.83, "timestamp": "01:41:53", "text": "火曜日。とても混乱しています。待ってくれよ。"}, {"type": "subtitle", "time": 6115.629, "timestamp": "01:41:55", "text": "待って。"}, {"type": "subtitle", "time": 6118.669, "timestamp": "01:41:58", "text": "何？のように"}]
[{"type": "subtitle", "time": 15243.63, "timestamp": "04:14:03", "text": "[音楽]"}, {"type": "subtitle", "time": 15250.07, "timestamp": "04:14:10", "text": "けれど。そのコメントは削除します。得る"}, {"type": "subtitle", "time": 15262.11, "timestamp": "04:14:22", "text": "新鮮で、"}, {"type": "subtitle", "time": 15265.11, "timestamp": "04:14:25", "text": "十分。私のガールフレンドは私と結婚します。ここ"}, {"type": "subtitle", "time": 15271.11, "timestamp": "04:14:31", "text": "あなたが何と呼ぶのか、あなたは何と呼ぶのか"}, {"type": "subtitle", "time": 15274.229, "timestamp": "04:14:34", "text": "失業中ってこと？私は失業者ですか？いいえ。"}, {"type": "subtitle", "time": 15276.189, "timestamp": "04:14:36", "text": "エンジェル"}, {"type": "subtitle", "time": 15280.07, "timestamp": "04:14:40", "text": "失業中？あなたは私たち誰よりも努力している。"}, {"type": "subtitle", "time": 15285.349, "timestamp": "04:14:45", "text": "[音楽]"}, {"type": "subtitle", "time": 15287.11, "timestamp": "04:14:47", "text": "生きているだけで"}]
[{"type": "subtitle", "time": 18249.03, "timestamp": "05:04:09", "text": "わかった。新しいファンができましたよ。わかった。"}, {"type": "subtitle", "time": 18254.948, "timestamp": "05:04:14", "text": "わかった。もっと手に入れられるといいな"}, {"type": "subtitle", "time": 18258.68, "timestamp": "05:04:18", "text": "人気のある。はい。"}, {"type": "subtitle", "time": 18276.27, "timestamp": "05:04:36", "text": "[音楽]"}, {"type": "subtitle", "time": 18279.51, "timestamp": "05:04:39", "text": "今。でも、私が良い仕事をしたから買ってください"}, {"type": "subtitle", "time": 18286.628, "timestamp": "05:04:46", "text": "美味しい。とにかく、以上です。祝福あれ。祈る"}, {"type": "subtitle", "time": 18295.12, "timestamp": "05:04:55", "text": "絵文字。私はそれをやったと思います。"}, {"type": "subtitle", "time": 18297.51, "timestamp": "05:04:57", "text": "[音楽]"}]
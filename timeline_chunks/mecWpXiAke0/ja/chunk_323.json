[{"type": "subtitle", "time": 19381.19, "timestamp": "05:23:01", "text": "生きることを許された。もちろんあなたは"}, {"type": "subtitle", "time": 19394.07, "timestamp": "05:23:14", "text": "レベル。命を奪うべきではない"}, {"type": "subtitle", "time": 19395.31, "timestamp": "05:23:15", "text": "真剣に。ありがとう、"}, {"type": "subtitle", "time": 19405.39, "timestamp": "05:23:25", "text": "悪い。私のミスです。私のミスです。私のミスです。愛していますか"}, {"type": "subtitle", "time": 19407.708, "timestamp": "05:23:27", "text": "自分？はい。私は愛する"}, {"type": "subtitle", "time": 19414.868, "timestamp": "05:23:34", "text": "つまり、あなたは今、本当に私を愛しているの？"}, {"type": "subtitle", "time": 19417.15, "timestamp": "05:23:37", "text": "あなたは愛している、愛している、愛している"}, {"type": "subtitle", "time": 19421.31, "timestamp": "05:23:41", "text": "自分。私は本当に愛しています"}, {"type": "subtitle", "time": 19423.55, "timestamp": "05:23:43", "text": "あなた。愛してます、"}, {"type": "subtitle", "time": 19435.31, "timestamp": "05:23:55", "text": "仕事。ベストを尽くして"}, {"type": "subtitle", "time": 19439.23, "timestamp": "05:23:59", "text": "人生。それはあまりにも曖昧だ。ああ、"}]
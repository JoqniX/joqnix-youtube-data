[{"type": "subtitle", "time": 19321.31, "timestamp": "05:22:01", "text": "見る必要はなく、"}, {"type": "subtitle", "time": 19324.19, "timestamp": "05:22:04", "text": "時計。いいえ"}, {"type": "subtitle", "time": 19326.83, "timestamp": "05:22:06", "text": "方法。彼らはただ言っているだけだ"}, {"type": "subtitle", "time": 19342.99, "timestamp": "05:22:22", "text": "見る。なるほど。ええ、"}, {"type": "subtitle", "time": 19355.948, "timestamp": "05:22:35", "text": "自分？誰も要因ではないかのように"}, {"type": "subtitle", "time": 19358.23, "timestamp": "05:22:38", "text": "発達。黒人男性は"}, {"type": "subtitle", "time": 19365.19, "timestamp": "05:22:45", "text": "ライブ。行くよ。待って。すべきではないような気がする"}, {"type": "subtitle", "time": 19367.31, "timestamp": "05:22:47", "text": "許可される。もちろんあなたは"}, {"type": "subtitle", "time": 19371.75, "timestamp": "05:22:51", "text": "許可された。どうか生きてください。待って。まるで"}, {"type": "subtitle", "time": 19373.55, "timestamp": "05:22:53", "text": "すべき。もちろん、そうしてもいいですよ。"}, {"type": "subtitle", "time": 19379.99, "timestamp": "05:22:59", "text": "選ぶ？私はそうすべきではないと感じています"}]
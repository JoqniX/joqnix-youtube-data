[{"type": "subtitle", "time": 11880.07, "timestamp": "03:18:00", "text": "おお。これでモデレーターの仕事が分かりました。"}, {"type": "subtitle", "time": 11882.15, "timestamp": "03:18:02", "text": "わかった。何をプレイしているの？私たちは"}, {"type": "subtitle", "time": 11884.95, "timestamp": "03:18:04", "text": "Needy Streamer Overlordをプレイしています。"}, {"type": "subtitle", "time": 11888.15, "timestamp": "03:18:08", "text": "ずっとストリーマーになりたかったんです。"}, {"type": "subtitle", "time": 11901.87, "timestamp": "03:18:21", "text": "知る。私は彼ら全員に電話をかける"}, {"type": "subtitle", "time": 11904.309, "timestamp": "03:18:24", "text": "夜。ここに来られて本当に嬉しいです。私はできません"}, {"type": "subtitle", "time": 11907.91, "timestamp": "03:18:27", "text": "皆さんにお会いできるのを楽しみにしています。こんにちは、タイガー。"}]
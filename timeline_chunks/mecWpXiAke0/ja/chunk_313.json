[{"type": "subtitle", "time": 18780.15, "timestamp": "05:13:00", "text": "神。私はもうやったと思う"}, {"type": "subtitle", "time": 18782.31, "timestamp": "05:13:02", "text": "これで十分ですよね？はい、あなたは"}, {"type": "subtitle", "time": 18787.868, "timestamp": "05:13:07", "text": "私はそうしました"}, {"type": "subtitle", "time": 18794.43, "timestamp": "05:13:14", "text": "多くの。"}, {"type": "subtitle", "time": 18798.91, "timestamp": "05:13:18", "text": "81 83 83 91 それは"}, {"type": "subtitle", "time": 18811.75, "timestamp": "05:13:31", "text": "病院？あのね？私は行くつもりです"}, {"type": "subtitle", "time": 18828.708, "timestamp": "05:13:48", "text": "[音楽]"}]
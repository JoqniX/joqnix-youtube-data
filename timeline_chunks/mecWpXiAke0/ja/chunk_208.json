[{"type": "subtitle", "time": 12481.67, "timestamp": "03:28:01", "text": "私を狂わせるのはあなたです。ハートの絵文字。心臓"}, {"type": "subtitle", "time": 12482.51, "timestamp": "03:28:02", "text": "絵文字。"}, {"type": "subtitle", "time": 12487.91, "timestamp": "03:28:07", "text": "陰謀論は素晴らしい"}, {"type": "subtitle", "time": 12489.59, "timestamp": "03:28:09", "text": "コンテンツ。それでは、まず"}, {"type": "subtitle", "time": 12495.91, "timestamp": "03:28:15", "text": "ああ、君は何を言えばいいのか全く分からないんだね。何"}, {"type": "subtitle", "time": 12498.429, "timestamp": "03:28:18", "text": "もし政府があなたをオタクにしたら？"}, {"type": "subtitle", "time": 12500.349, "timestamp": "03:28:20", "text": "はい、閉じます"}, {"type": "subtitle", "time": 12502.87, "timestamp": "03:28:22", "text": "それ。今夜行く。よし、夜だ"}, {"type": "subtitle", "time": 12504.03, "timestamp": "03:28:24", "text": "のために"}, {"type": "subtitle", "time": 12506.229, "timestamp": "03:28:26", "text": "ストリーム。シド、君はまだ僕と一緒にいるんだね。"}, {"type": "subtitle", "time": 12514.75, "timestamp": "03:28:34", "text": "ストリーミングして、もっと手に入れよう"}, {"type": "subtitle", "time": 12516.91, "timestamp": "03:28:36", "text": "フォロワー。愛"}, {"type": "subtitle", "time": 12520.309, "timestamp": "03:28:40", "text": "フォロワー。なぜ？いいえ、そう思います。しかし"}, {"type": "subtitle", "time": 12526.75, "timestamp": "03:28:46", "text": "[音楽]"}, {"type": "subtitle", "time": 12534.269, "timestamp": "03:28:54", "text": "ストリームのような絵文字をもっと入手して"}, {"type": "subtitle", "time": 12537.429, "timestamp": "03:28:57", "text": "閲覧数。いい釣果でしたね。よし、"}, {"type": "subtitle", "time": 12538.71, "timestamp": "03:28:58", "text": "ストリーミングのいずれかを実行します。統計によると"}, {"type": "subtitle", "time": 12539.83, "timestamp": "03:28:59", "text": "全く異なる方法で変化する"}]
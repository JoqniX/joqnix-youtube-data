[{"type": "subtitle", "time": 21608.27, "timestamp": "06:00:08", "text": "おいおい、"}, {"type": "subtitle", "time": 21611.42, "timestamp": "06:00:11", "text": "おい。熱。熱。 N."}, {"type": "subtitle", "time": 21645.99, "timestamp": "06:00:45", "text": "戻ってくる。戻ってくる。戻ってくる。来る"}, {"type": "subtitle", "time": 21647.19, "timestamp": "06:00:47", "text": "戻る。"}, {"type": "subtitle", "time": 21650.11, "timestamp": "06:00:50", "text": "私は何回"}, {"type": "subtitle", "time": 21654.83, "timestamp": "06:00:54", "text": "中断されましたか？何？そして私はあの頃が懐かしい"}]
[{"type": "subtitle", "time": 421.189, "timestamp": "00:07:01", "text": "良い。どのゲームかさえ知らない"}, {"type": "subtitle", "time": 424.309, "timestamp": "00:07:04", "text": "ストリーマーがプレイしたものをプレイするなど"}, {"type": "subtitle", "time": 426.87, "timestamp": "00:07:06", "text": "えーと、文字Qのようなものの中に"}, {"type": "subtitle", "time": 428.79, "timestamp": "00:07:08", "text": "彼らがプレイしたすべてのゲームには文字「Q」が含まれています"}, {"type": "subtitle", "time": 431.27, "timestamp": "00:07:11", "text": "そして全て。おい、これは文字通り"}, {"type": "subtitle", "time": 434.43, "timestamp": "00:07:14", "text": "まさに私が"}, {"type": "subtitle", "time": 437.07, "timestamp": "00:07:17", "text": "指名手配。これはとても"}, {"type": "subtitle", "time": 442.189, "timestamp": "00:07:22", "text": "良い。これは本当に美味しい。私はこれが欲しい"}, {"type": "subtitle", "time": 445.029, "timestamp": "00:07:25", "text": "自分自身。私はこれを自分のために欲しい。誰が"}, {"type": "subtitle", "time": 447.15, "timestamp": "00:07:27", "text": "ウェブ"}, {"type": "subtitle", "time": 453.23, "timestamp": "00:07:33", "text": "デザイン？ああ、バリー・カラン。"}, {"type": "subtitle", "time": 455.95, "timestamp": "00:07:35", "text": "カラン。ああ、これはとても"}, {"type": "subtitle", "time": 458.11, "timestamp": "00:07:38", "text": "[音楽]"}, {"type": "subtitle", "time": 461.749, "timestamp": "00:07:41", "text": "良い。これは本当に美味しい。このウェブサイトは"}, {"type": "subtitle", "time": 467.749, "timestamp": "00:07:47", "text": "良い。このウェブサイトはライブ配信中です"}, {"type": "subtitle", "time": 469.27, "timestamp": "00:07:49", "text": "今すぐ。"}, {"type": "subtitle", "time": 471.51, "timestamp": "00:07:51", "text": "ゲームをするのもそうだ。ゲームは何"}, {"type": "subtitle", "time": 478.909, "timestamp": "00:07:58", "text": "設計図。これはとてもカスタムメイドで、"}]
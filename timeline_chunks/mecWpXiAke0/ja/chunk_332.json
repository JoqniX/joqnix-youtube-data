[{"type": "subtitle", "time": 19921.43, "timestamp": "05:32:01", "text": "私もからかわれたことがあります"}, {"type": "subtitle", "time": 19923.59, "timestamp": "05:32:03", "text": "社交的で愚かでめちゃくちゃな"}, {"type": "subtitle", "time": 19925.47, "timestamp": "05:32:05", "text": "の"}, {"type": "subtitle", "time": 19927.31, "timestamp": "05:32:07", "text": "頭。おお、"}, {"type": "subtitle", "time": 19937.59, "timestamp": "05:32:17", "text": "けれど？かわいそうに。"}, {"type": "subtitle", "time": 19944.628, "timestamp": "05:32:24", "text": "同情とか、なんて言うんだっけ？"}, {"type": "subtitle", "time": 19946.39, "timestamp": "05:32:26", "text": "過去について語り、"}, {"type": "subtitle", "time": 19948.27, "timestamp": "05:32:28", "text": "同情した"}, {"type": "subtitle", "time": 19957.35, "timestamp": "05:32:37", "text": "はぁ？これは私にとってすごく共感できる。なぜ"}, {"type": "subtitle", "time": 19964.83, "timestamp": "05:32:44", "text": "知る。アレクサ、ワンゴー。"}, {"type": "subtitle", "time": 19967.628, "timestamp": "05:32:47", "text": "はい。"}, {"type": "subtitle", "time": 19971.11, "timestamp": "05:32:51", "text": "何？あなたは大天使です。誰かへの贈り物"}, {"type": "subtitle", "time": 19973.868, "timestamp": "05:32:53", "text": "誰かが虹のようなスーパーチャットをした"}]
[{"type": "subtitle", "time": 16864.59, "timestamp": "04:41:04", "text": "なぜ。だから今、私はあなただ"}, {"type": "subtitle", "time": 16870.07, "timestamp": "04:41:10", "text": "発表。もちろんお見せします"}, {"type": "subtitle", "time": 16871.99, "timestamp": "04:41:11", "text": "ヘンシオン"}, {"type": "subtitle", "time": 16874.35, "timestamp": "04:41:14", "text": "[音楽]"}, {"type": "subtitle", "time": 16877.48, "timestamp": "04:41:17", "text": "建てる。何のヘンジョン？"}, {"type": "subtitle", "time": 16881.55, "timestamp": "04:41:21", "text": "[音楽]"}, {"type": "subtitle", "time": 16884.39, "timestamp": "04:41:24", "text": "女の子。私は最善を尽くして"}, {"type": "subtitle", "time": 16886.03, "timestamp": "04:41:26", "text": "誰かが"}, {"type": "subtitle", "time": 16889.628, "timestamp": "04:41:29", "text": "さあ、一緒に学校へ行こう"}, {"type": "subtitle", "time": 16894.03, "timestamp": "04:41:34", "text": "自分。それで私は"}, {"type": "subtitle", "time": 16896.47, "timestamp": "04:41:36", "text": "クラブのゲームセンターで座っている。確認する"}, {"type": "subtitle", "time": 16899.31, "timestamp": "04:41:39", "text": "あなたは私に"}, {"type": "subtitle", "time": 16903.91, "timestamp": "04:41:43", "text": "写真。自分の心を痛めつけ、"}, {"type": "subtitle", "time": 16906.83, "timestamp": "04:41:46", "text": "[音楽]"}, {"type": "subtitle", "time": 16908.868, "timestamp": "04:41:48", "text": "お金。もう十分だ。あなたは得られません"}, {"type": "subtitle", "time": 16911.99, "timestamp": "04:41:51", "text": "離れて。ああ、もう。私を無視するのはやめてください。なぜ"}]
[{"type": "subtitle", "time": 20160.59, "timestamp": "05:36:00", "text": "[音楽]"}, {"type": "subtitle", "time": 20164.27, "timestamp": "05:36:04", "text": "悪い。素晴らしい"}, {"type": "subtitle", "time": 20175.27, "timestamp": "05:36:15", "text": "する？あなたと気楽におしゃべりしましょう"}, {"type": "subtitle", "time": 20178.41, "timestamp": "05:36:18", "text": "みんな。これをするべきでしょうか？"}, {"type": "subtitle", "time": 20187.11, "timestamp": "05:36:27", "text": "[音楽]"}, {"type": "subtitle", "time": 20188.948, "timestamp": "05:36:28", "text": "効率が良いことは悪いことなのでしょうか？私はしません"}, {"type": "subtitle", "time": 20191.65, "timestamp": "05:36:31", "text": "だと思う"}, {"type": "subtitle", "time": 20194.59, "timestamp": "05:36:34", "text": "[音楽]"}, {"type": "subtitle", "time": 20198.26, "timestamp": "05:36:38", "text": "悪い。何が起こるか見てみたい。"}, {"type": "subtitle", "time": 20209.27, "timestamp": "05:36:49", "text": "[音楽]"}, {"type": "subtitle", "time": 20211.31, "timestamp": "05:36:51", "text": "待って、時間をかけて"}, {"type": "subtitle", "time": 20213.99, "timestamp": "05:36:53", "text": "一緒に、精神的な"}, {"type": "subtitle", "time": 20217.35, "timestamp": "05:36:57", "text": "暗闇が上昇する。え、何？何てことだ、"}]
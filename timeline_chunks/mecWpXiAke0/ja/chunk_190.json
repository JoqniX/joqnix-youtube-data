[{"type": "subtitle", "time": 11401.83, "timestamp": "03:10:01", "text": "実際の場所や実体に似ており、"}, {"type": "subtitle", "time": 11404.23, "timestamp": "03:10:04", "text": "純粋に憲法的な生活"}, {"type": "subtitle", "time": 11405.63, "timestamp": "03:10:05", "text": "ポルノ"}, {"type": "subtitle", "time": 11408.87, "timestamp": "03:10:08", "text": "見てから伝えるから、あまり受け取らないで"}, {"type": "subtitle", "time": 11411.67, "timestamp": "03:10:11", "text": "真剣に、絶対に試さないでください"}, {"type": "subtitle", "time": 11414.55, "timestamp": "03:10:14", "text": "より極端な、あるいは憂鬱な行動"}, {"type": "subtitle", "time": 11417.389, "timestamp": "03:10:17", "text": "自宅で"}, {"type": "subtitle", "time": 11420.87, "timestamp": "03:10:20", "text": "わかった。ええと、あるいはどこでも同じです。"}, {"type": "subtitle", "time": 11422.63, "timestamp": "03:10:22", "text": "そして、ビデオゲームで目にするものを覚えておいてください。"}, {"type": "subtitle", "time": 11425.07, "timestamp": "03:10:25", "text": "インターネット上では、"}, {"type": "subtitle", "time": 11427.75, "timestamp": "03:10:27", "text": "必ずしも現実を反映しているわけではない"}, {"type": "subtitle", "time": 11431.03, "timestamp": "03:10:31", "text": "人生。お使いのモデルの電源を切ってください"}, {"type": "subtitle", "time": 11433.03, "timestamp": "03:10:33", "text": "いつでも外に出て体験する"}, {"type": "subtitle", "time": 11436.389, "timestamp": "03:10:36", "text": "もしあなたが望むなら、現実世界へ。また"}, {"type": "subtitle", "time": 11439.429, "timestamp": "03:10:39", "text": "イベント中にスラッシュが発生し、"}, {"type": "subtitle", "time": 11443.23, "timestamp": "03:10:43", "text": "ゲーム。この約束を守りたいのですか？"}, {"type": "subtitle", "time": 11448.11, "timestamp": "03:10:48", "text": "はい。わかった。データスロットは3つあります"}]
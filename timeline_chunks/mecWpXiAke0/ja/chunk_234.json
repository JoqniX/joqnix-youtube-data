[{"type": "subtitle", "time": 14041.95, "timestamp": "03:54:01", "text": "神。あなたはこれを逃れることはできない"}, {"type": "subtitle", "time": 14044.16, "timestamp": "03:54:04", "text": "泣いている。"}, {"type": "subtitle", "time": 14045.87, "timestamp": "03:54:05", "text": "[音楽]"}, {"type": "subtitle", "time": 14055.03, "timestamp": "03:54:15", "text": "さよなら。夜ですよね？ごめん。ストリーム"}, {"type": "subtitle", "time": 14065.02, "timestamp": "03:54:25", "text": "日。私はこれをやりたいのですが、"}, {"type": "subtitle", "time": 14074.07, "timestamp": "03:54:34", "text": "陰謀論者の天使のように"}, {"type": "subtitle", "time": 14077.63, "timestamp": "03:54:37", "text": "新しいことに挑戦する"}, {"type": "subtitle", "time": 14080.309, "timestamp": "03:54:40", "text": "もの。私がやっていることは、ただチャットをすることです"}, {"type": "subtitle", "time": 14098.87, "timestamp": "03:54:58", "text": "つまり、人々は実際にそうするし、"}]
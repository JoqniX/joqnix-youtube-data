[{"type": "subtitle", "time": 16740.029, "timestamp": "04:39:00", "text": "子供を見ているような"}, {"type": "subtitle", "time": 16742.709, "timestamp": "04:39:02", "text": "アニメ。子供向けアニメって結構面白いよね。そして"}, {"type": "subtitle", "time": 16744.269, "timestamp": "04:39:04", "text": "私のために"}, {"type": "subtitle", "time": 16747.23, "timestamp": "04:39:07", "text": "ネック。子供をすごく怖がらせたい"}, {"type": "subtitle", "time": 16755.869, "timestamp": "04:39:15", "text": "[音楽]"}, {"type": "subtitle", "time": 16758.47, "timestamp": "04:39:18", "text": "それ。私は主によって救われました"}, {"type": "subtitle", "time": 16760.47, "timestamp": "04:39:20", "text": "特定の女の子のアニメだと思う"}, {"type": "subtitle", "time": 16763.75, "timestamp": "04:39:23", "text": "彼らがとても魅力的である理由は、その純粋さにある"}, {"type": "subtitle", "time": 16766.91, "timestamp": "04:39:26", "text": "彼らです。"}, {"type": "subtitle", "time": 16770.551, "timestamp": "04:39:30", "text": "はぁ？ソロの虫の火のインスピレーションと"}, {"type": "subtitle", "time": 16773.31, "timestamp": "04:39:33", "text": "愛って本当に感動的だよね、"}, {"type": "subtitle", "time": 16775.709, "timestamp": "04:39:35", "text": "知る。私は持っている"}, {"type": "subtitle", "time": 16779.27, "timestamp": "04:39:39", "text": "視聴者数1万7000人。ああ、彼らは"}, {"type": "subtitle", "time": 16782.03, "timestamp": "04:39:42", "text": "天使は人気がある。ああ、"}, {"type": "subtitle", "time": 16792.03, "timestamp": "04:39:52", "text": "[音楽]"}, {"type": "subtitle", "time": 16794.948, "timestamp": "04:39:54", "text": "女の子たち。私は小さな女の子が好きです"}, {"type": "subtitle", "time": 16797.83, "timestamp": "04:39:57", "text": "そして私は、幼い女の子が登場するアニメが大好きです。彼"}]
[{"type": "subtitle", "time": 1026.949, "timestamp": "00:17:06", "text": "男。彼らのシステムは本当に素晴らしい。"}, {"type": "subtitle", "time": 1028.549, "timestamp": "00:17:08", "text": "これは彼らの生放送です"}, {"type": "subtitle", "time": 1035.909, "timestamp": "00:17:15", "text": "観客席とライブインタラクション"}, {"type": "subtitle", "time": 1037.789, "timestamp": "00:17:17", "text": "コメント"}, {"type": "subtitle", "time": 1040.429, "timestamp": "00:17:20", "text": "そしてそれは"}, {"type": "subtitle", "time": 1043.829, "timestamp": "00:17:23", "text": "これ？見通し線ライブ放送局"}, {"type": "subtitle", "time": 1046.949, "timestamp": "00:17:26", "text": "ツールを使ってオープンブロードキャスターをプレイする"}, {"type": "subtitle", "time": 1050.19, "timestamp": "00:17:30", "text": "設定。ああ、放送局"}, {"type": "subtitle", "time": 1059.75, "timestamp": "00:17:39", "text": "復元、ビットレート、フレームレート。えっと、"}, {"type": "subtitle", "time": 1062.63, "timestamp": "00:17:42", "text": "エンコードレベル：低、中、高。わかった、"}, {"type": "subtitle", "time": 1064.51, "timestamp": "00:17:44", "text": "私はできます"}, {"type": "subtitle", "time": 1072.35, "timestamp": "00:17:52", "text": "実は。"}, {"type": "subtitle", "time": 1075.75, "timestamp": "00:17:55", "text": "えっと、ちょっと待って、あれが何なのか確認する必要がある"}, {"type": "subtitle", "time": 1079.07, "timestamp": "00:17:59", "text": "設定は。それは仮想の"}]
[{"type": "subtitle", "time": 11222.55, "timestamp": "03:07:02", "text": "[音楽]"}, {"type": "subtitle", "time": 11226.11, "timestamp": "03:07:06", "text": "ここはどこですか？ここはどこですか？何が"}, {"type": "subtitle", "time": 11242.75, "timestamp": "03:07:22", "text": "わかった。わかった。"}, {"type": "subtitle", "time": 11248.62, "timestamp": "03:07:28", "text": "困り果てた配信者オーバーロード。これを開けてください。"}, {"type": "subtitle", "time": 11251.389, "timestamp": "03:07:31", "text": "[音楽]"}, {"type": "subtitle", "time": 11254.51, "timestamp": "03:07:34", "text": "はい、承知しました。"}, {"type": "subtitle", "time": 11257.23, "timestamp": "03:07:37", "text": "上。さあ"}, {"type": "subtitle", "time": 11260.79, "timestamp": "03:07:40", "text": "行く。はい、お元気ですか？私もそうしています"}, {"type": "subtitle", "time": 11263.51, "timestamp": "03:07:43", "text": "今日は良い日でした。ただ寝てしまっただけです。"}, {"type": "subtitle", "time": 11274.23, "timestamp": "03:07:54", "text": "30分前のことですが。私はしたくなかった"}, {"type": "subtitle", "time": 11275.75, "timestamp": "03:07:55", "text": "泳ぐ。"}, {"type": "subtitle", "time": 11277.78, "timestamp": "03:07:57", "text": "私はしたい"}]
[{"type": "subtitle", "time": 12841.95, "timestamp": "03:34:01", "text": "フォロワーは簡単だ。さあ"}, {"type": "subtitle", "time": 12844.429, "timestamp": "03:34:04", "text": "行く。つまり、"}, {"type": "subtitle", "time": 12847.83, "timestamp": "03:34:07", "text": "つまり、よく考えてみると、"}, {"type": "subtitle", "time": 12850.91, "timestamp": "03:34:10", "text": "家賃やその他諸々を支払うには"}, {"type": "subtitle", "time": 12853.269, "timestamp": "03:34:13", "text": "ストリーミング配信。始めたばかりの方、または"}, {"type": "subtitle", "time": 12855.11, "timestamp": "03:34:15", "text": "あなたはどちらかというと中規模ストリーマーですね。"}, {"type": "subtitle", "time": 12857.75, "timestamp": "03:34:17", "text": "いずれにしてもうまくいかないだろう。超"}, {"type": "subtitle", "time": 12859.469, "timestamp": "03:34:19", "text": "狂ったように"}, {"type": "subtitle", "time": 12865.87, "timestamp": "03:34:25", "text": "少なくとも人気があり、"}, {"type": "subtitle", "time": 12868.71, "timestamp": "03:34:28", "text": "えっと、家賃を払えるようにしないと"}, {"type": "subtitle", "time": 12872.59, "timestamp": "03:34:32", "text": "家賃の支払いはとても高額で、"}, {"type": "subtitle", "time": 12883.67, "timestamp": "03:34:43", "text": "薬を飲ませて、彼女を外出させます"}, {"type": "subtitle", "time": 12889.76, "timestamp": "03:34:49", "text": "どうしてそんなことができるの？彼女を外出させて"}, {"type": "subtitle", "time": 12892.59, "timestamp": "03:34:52", "text": "[音楽]"}, {"type": "subtitle", "time": 12896.67, "timestamp": "03:34:56", "text": "少し。なぜクリックしてしまったのだろう？"}]
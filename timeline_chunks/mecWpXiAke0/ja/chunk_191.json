[{"type": "subtitle", "time": 11464.67, "timestamp": "03:11:04", "text": "いらっしゃいませ。"}, {"type": "subtitle", "time": 11468.429, "timestamp": "03:11:08", "text": "わかった。配信アカウントを取得しました。待って、"}, {"type": "subtitle", "time": 11472.71, "timestamp": "03:11:12", "text": "何？夜。配信アカウントを取得しました。参加する。"}, {"type": "subtitle", "time": 11474.349, "timestamp": "03:11:14", "text": "参加する。ああ、列だ。"}, {"type": "subtitle", "time": 11476.91, "timestamp": "03:11:16", "text": "はい、上部のログイン画面からログインしてください。"}, {"type": "subtitle", "time": 11479.99, "timestamp": "03:11:19", "text": "左。ログインして準備を整えましょう。クリック"}, {"type": "subtitle", "time": 11481.75, "timestamp": "03:11:21", "text": "配信中に私のパスワードでログインしてください。"}, {"type": "subtitle", "time": 11489.95, "timestamp": "03:11:29", "text": "2. わかりました。天使"}, {"type": "subtitle", "time": 11499.19, "timestamp": "03:11:39", "text": "2件取得済み。大丈夫。つまり、フォロワーは1人。見る、"}, {"type": "subtitle", "time": 11500.87, "timestamp": "03:11:40", "text": "ログインしました。以上です。これは"}, {"type": "subtitle", "time": 11503.67, "timestamp": "03:11:43", "text": "ここから私たちのフォロワーが始まります。私たちは"}, {"type": "subtitle", "time": 11505.59, "timestamp": "03:11:45", "text": "何があっても私たちは一緒です"}, {"type": "subtitle", "time": 11508.55, "timestamp": "03:11:48", "text": "人生について。私が死ぬか、私が動揺するか、"}, {"type": "subtitle", "time": 11510.79, "timestamp": "03:11:50", "text": "私は壊れたり刺されたり、私は燃えたり"}, {"type": "subtitle", "time": 11514.469, "timestamp": "03:11:54", "text": "神になるか、さもなければ気が狂う。何てことだ、"}]
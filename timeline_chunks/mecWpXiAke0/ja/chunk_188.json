[{"type": "subtitle", "time": 11296.389, "timestamp": "03:08:16", "text": "大丈夫。外に出られないような気分です"}, {"type": "subtitle", "time": 11297.87, "timestamp": "03:08:17", "text": "の"}, {"type": "subtitle", "time": 11301.389, "timestamp": "03:08:21", "text": "ベッド？ええ、それが私が"}, {"type": "subtitle", "time": 11304.79, "timestamp": "03:08:24", "text": "感じた。それが私の感じたことです。私は欲しい 私は欲しくない"}, {"type": "subtitle", "time": 11307.51, "timestamp": "03:08:27", "text": "でも、ベッドから出たくないんです。私"}, {"type": "subtitle", "time": 11308.67, "timestamp": "03:08:28", "text": "欲しい"}, {"type": "subtitle", "time": 11312.79, "timestamp": "03:08:32", "text": "つまり、私は本当に"}, {"type": "subtitle", "time": 11315.389, "timestamp": "03:08:35", "text": "眠っている。 2時間くらい寝たと思う"}, {"type": "subtitle", "time": 11319.15, "timestamp": "03:08:39", "text": "今日。おお。私はどうして"}, {"type": "subtitle", "time": 11322.469, "timestamp": "03:08:42", "text": "生きている？わからない。まるで寝ていただけみたい"}, {"type": "subtitle", "time": 11325.23, "timestamp": "03:08:45", "text": "2時間"}, {"type": "subtitle", "time": 11327.15, "timestamp": "03:08:47", "text": "今日。しかしそれは"}, {"type": "subtitle", "time": 11331.349, "timestamp": "03:08:51", "text": "大丈夫。 2時間または4時間。うん。だから私は"}, {"type": "subtitle", "time": 11337.15, "timestamp": "03:08:57", "text": "頻繁に何度か目が覚めた。それで、"}, {"type": "subtitle", "time": 11339.75, "timestamp": "03:08:59", "text": "うん。とにかく、えーと、"}]
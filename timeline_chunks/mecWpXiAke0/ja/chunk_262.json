[{"type": "subtitle", "time": 15721.03, "timestamp": "04:22:01", "text": "知る。ニース。"}, {"type": "subtitle", "time": 15724.429, "timestamp": "04:22:04", "text": "スーパーチャットがたくさんあるよ、"}, {"type": "subtitle", "time": 15734.309, "timestamp": "04:22:14", "text": "それ。それは正しい。私、天使は"}, {"type": "subtitle", "time": 15739.59, "timestamp": "04:22:19", "text": "購読者。さらに輝きを増す"}, {"type": "subtitle", "time": 15755.63, "timestamp": "04:22:35", "text": "ラダー。さあ、仕返しするのを見に来て"}, {"type": "subtitle", "time": 15759.11, "timestamp": "04:22:39", "text": "より大きく。井戸ですが、私は何が"}, {"type": "subtitle", "time": 15767.189, "timestamp": "04:22:47", "text": "10k。皆さん、チャンネル登録をお願いします。私たちは作る必要がある"}, {"type": "subtitle", "time": 15770.149, "timestamp": "04:22:50", "text": "必要性が爆発的に高まる。彼女に吹いてもらう必要がある"}, {"type": "subtitle", "time": 15774.11, "timestamp": "04:22:54", "text": "上。何かでお祝いしましょう"}, {"type": "subtitle", "time": 15776.79, "timestamp": "04:22:56", "text": "美味しい。私は本当に大人が嫌いなのか？彼らです"}, {"type": "subtitle", "time": 15779.07, "timestamp": "04:22:59", "text": "いつもそう"}]
[{"type": "subtitle", "time": 19028.27, "timestamp": "05:17:08", "text": "[音楽]"}, {"type": "subtitle", "time": 19030.83, "timestamp": "05:17:10", "text": "いいえ。わかりました。これをして"}, {"type": "subtitle", "time": 19033.67, "timestamp": "05:17:13", "text": "それ。捜索と破壊は"}, {"type": "subtitle", "time": 19035.39, "timestamp": "05:17:15", "text": "生存者は1名。"}, {"type": "subtitle", "time": 19042.39, "timestamp": "05:17:22", "text": "あなたは母親が好きですか？いいえ。それは"}, {"type": "subtitle", "time": 19049.31, "timestamp": "05:17:29", "text": "選ぶ。なぜ10を落としたの？"}, {"type": "subtitle", "time": 19062.708, "timestamp": "05:17:42", "text": "高い社交性と高い協調性を発揮する"}, {"type": "subtitle", "time": 19065.708, "timestamp": "05:17:45", "text": "他の失敗と共に"}, {"type": "subtitle", "time": 19074.55, "timestamp": "05:17:54", "text": "FPSが得意な人の中には"}, {"type": "subtitle", "time": 19077.11, "timestamp": "05:17:57", "text": "彼らは社会適応力も非常に高い。私 私"}]
[{"type": "subtitle", "time": 11707.229, "timestamp": "03:15:07", "text": "キャラクター。の"}, {"type": "subtitle", "time": 11715.07, "timestamp": "03:15:15", "text": "変換。さあ"}, {"type": "subtitle", "time": 11725.11, "timestamp": "03:15:25", "text": "迷惑なコメントと靴の色"}, {"type": "subtitle", "time": 11726.6, "timestamp": "03:15:26", "text": "コメント最高"}, {"type": "subtitle", "time": 11727.79, "timestamp": "03:15:27", "text": "[音楽]"}, {"type": "subtitle", "time": 11730.67, "timestamp": "03:15:30", "text": "チャンス。あ、待って、読んでない"}, {"type": "subtitle", "time": 11735.309, "timestamp": "03:15:35", "text": "それ。やあ、キティ、素敵な応援の挨拶だね"}, {"type": "subtitle", "time": 11739.59, "timestamp": "03:15:39", "text": "ここ。うわー、一晩中見てたよ。"}, {"type": "subtitle", "time": 11741.07, "timestamp": "03:15:41", "text": "それは、それは"}, {"type": "subtitle", "time": 11744.83, "timestamp": "03:15:44", "text": "本当にそれは本当に"}, {"type": "subtitle", "time": 11749.59, "timestamp": "03:15:49", "text": "おお。うん。こんにちは、ヤン。元気ですか？"}, {"type": "subtitle", "time": 11751.67, "timestamp": "03:15:51", "text": "お前は本当にクソ野郎だ。ああ、削除すべきかな"}, {"type": "subtitle", "time": 11759.79, "timestamp": "03:15:59", "text": "V. 削除"}]
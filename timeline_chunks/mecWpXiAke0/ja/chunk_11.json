[{"type": "subtitle", "time": 674.79, "timestamp": "00:11:14", "text": "そんなにいいことなの？ああ、それはとても"}, {"type": "subtitle", "time": 681.67, "timestamp": "00:11:21", "text": "ああ、これらのアバターは"}, {"type": "subtitle", "time": 685.269, "timestamp": "00:11:25", "text": "チャンネルポイントのようなもので、"}, {"type": "subtitle", "time": 686.91, "timestamp": "00:11:26", "text": "その点に関して"}, {"type": "subtitle", "time": 711.67, "timestamp": "00:11:51", "text": "何てことだ。ポイントシステムと同様に、"}, {"type": "subtitle", "time": 712.75, "timestamp": "00:11:52", "text": "あなたはできる"}, {"type": "subtitle", "time": 715.35, "timestamp": "00:11:55", "text": "コンサートで演じるキャラクター"}, {"type": "subtitle", "time": 718.15, "timestamp": "00:11:58", "text": "あなた自身、またはあなたのメッセージが表示されるように"}]
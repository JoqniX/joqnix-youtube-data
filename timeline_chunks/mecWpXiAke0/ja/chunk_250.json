[{"type": "subtitle", "time": 15000.95, "timestamp": "04:10:00", "text": "もっと。 69. ああ、なんてことだ。うん。こんにちは、息子よ。"}, {"type": "subtitle", "time": 15003.59, "timestamp": "04:10:03", "text": "元気ですか？お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 15006.11, "timestamp": "04:10:06", "text": "楽しい休日をお過ごしください。ニア。"}, {"type": "subtitle", "time": 15009.269, "timestamp": "04:10:09", "text": "[音楽]"}, {"type": "subtitle", "time": 15017.269, "timestamp": "04:10:17", "text": "あなた。あの秘密の件、すごく怪しい。"}, {"type": "subtitle", "time": 15034.07, "timestamp": "04:10:34", "text": "ええと、彼女のストレスレベルは近いですね。それで、"}, {"type": "subtitle", "time": 15046.63, "timestamp": "04:10:46", "text": "ゲーム。もしかしたら、もっとオタク友達ができるかも"}, {"type": "subtitle", "time": 15048.309, "timestamp": "04:10:48", "text": "格闘ゲームの配信を始めたら"}, {"type": "subtitle", "time": 15050.349, "timestamp": "04:10:50", "text": "ストリームのコメントはおそらく"}, {"type": "subtitle", "time": 15052.95, "timestamp": "04:10:52", "text": "すごくイライラする。だから、学習していないのかもしれない"}, {"type": "subtitle", "time": 15055.349, "timestamp": "04:10:55", "text": "comは痛みです。私はピザを食べながら囲碁をしたい"}, {"type": "subtitle", "time": 15057.75, "timestamp": "04:10:57", "text": "時間。私がプレイするゲームがあるんだけど、"}]
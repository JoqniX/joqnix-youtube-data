[{"type": "subtitle", "time": 12602.83, "timestamp": "03:30:02", "text": "まるで私と同じようにこれらを持って入ってきてください"}, {"type": "subtitle", "time": 12605.75, "timestamp": "03:30:05", "text": "ジョーク。あなたはここに来たばかりですね。まったく、それは彼のものだ"}, {"type": "subtitle", "time": 12610.18, "timestamp": "03:30:10", "text": "UMの試合をストリーミング配信するのはこれが最後です。懐かしい"}, {"type": "subtitle", "time": 12611.79, "timestamp": "03:30:11", "text": "[音楽]"}, {"type": "subtitle", "time": 12615.349, "timestamp": "03:30:15", "text": "配信はいつ見ても飽きない。わかった。どのゲーム"}, {"type": "subtitle", "time": 12620.51, "timestamp": "03:30:20", "text": "プレイ中？"}, {"type": "subtitle", "time": 12623.03, "timestamp": "03:30:23", "text": "エキサイト。私たちは本当に"}, {"type": "subtitle", "time": 12625.59, "timestamp": "03:30:25", "text": "今日、古代の遺物が展示されている。遺物。"}, {"type": "subtitle", "time": 12629.389, "timestamp": "03:30:29", "text": "原神。疑問符。私はビデオが大好きです"}, {"type": "subtitle", "time": 12633.75, "timestamp": "03:30:33", "text": "ゲーム。みんな、これらのゲームにストレスを感じています"}, {"type": "subtitle", "time": 12635.83, "timestamp": "03:30:35", "text": "日。最近はみんなゲーム配信してるね"}, {"type": "subtitle", "time": 12648.99, "timestamp": "03:30:48", "text": "ゲーム。何ですか"}, {"type": "subtitle", "time": 12655.15, "timestamp": "03:30:55", "text": "選択。それは何ですか？素晴らしい"}, {"type": "subtitle", "time": 12659.67, "timestamp": "03:30:59", "text": "セット。それは素晴らしいチャットですね。あなたは"}]
[{"type": "subtitle", "time": 2460.19, "timestamp": "00:41:00", "text": "私は自分の"}, {"type": "subtitle", "time": 2463.03, "timestamp": "00:41:03", "text": "上げるのが最善"}, {"type": "subtitle", "time": 2464.43, "timestamp": "00:41:04", "text": "[音楽]"}, {"type": "subtitle", "time": 2474.27, "timestamp": "00:41:14", "text": "また、ええと、私は"}, {"type": "subtitle", "time": 2477.23, "timestamp": "00:41:17", "text": "移動する"}, {"type": "subtitle", "time": 2479.87, "timestamp": "00:41:19", "text": "日本"}, {"type": "subtitle", "time": 2483.63, "timestamp": "00:41:23", "text": "7月。私はそこにいます。私"}, {"type": "subtitle", "time": 2488.91, "timestamp": "00:41:28", "text": "えっと、7月までに日本に引っ越す予定です。それで、"}, {"type": "subtitle", "time": 2493.47, "timestamp": "00:41:33", "text": "楽しみです。そしてこれ"}, {"type": "subtitle", "time": 2498.63, "timestamp": "00:41:38", "text": "ジョックは新しい章に興奮している"}, {"type": "subtitle", "time": 2500.51, "timestamp": "00:41:40", "text": "私の"}, {"type": "subtitle", "time": 2502.589, "timestamp": "00:41:42", "text": "人生。さらに"}, {"type": "subtitle", "time": 2507.23, "timestamp": "00:41:47", "text": "ジョッカソンイベントは"}, {"type": "subtitle", "time": 2509.95, "timestamp": "00:41:49", "text": "6月。中頃まで"}, {"type": "subtitle", "time": 2514.15, "timestamp": "00:41:54", "text": "6月。 6月中旬まで。"}]
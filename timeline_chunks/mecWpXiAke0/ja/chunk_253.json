[{"type": "subtitle", "time": 15187.71, "timestamp": "04:13:07", "text": "ああ、わかった。"}, {"type": "subtitle", "time": 15192.269, "timestamp": "04:13:12", "text": "えっと、テンポストリームですよね？愛させてください"}, {"type": "subtitle", "time": 15195.59, "timestamp": "04:13:15", "text": "あなた。いいえ、これをするとストレスが"}, {"type": "subtitle", "time": 15198.79, "timestamp": "04:13:18", "text": "90 まで行く。だから、私はそうすべきではない、私はそうすべきだ"}, {"type": "subtitle", "time": 15201.91, "timestamp": "04:13:21", "text": "おそらく一日寝て、"}, {"type": "subtitle", "time": 15211.71, "timestamp": "04:13:31", "text": "進む。"}, {"type": "subtitle", "time": 15220.07, "timestamp": "04:13:40", "text": "これ。もし私が"}, {"type": "subtitle", "time": 15230.59, "timestamp": "04:13:50", "text": "[音楽]"}, {"type": "subtitle", "time": 15232.189, "timestamp": "04:13:52", "text": "主に。"}, {"type": "subtitle", "time": 15235.309, "timestamp": "04:13:55", "text": "私たちはそれを検討します"}]
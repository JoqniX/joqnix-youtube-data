[{"type": "subtitle", "time": 20943.35, "timestamp": "05:49:03", "text": "それ？彼女にそうさせてあげようかと思う"}, {"type": "subtitle", "time": 20951.27, "timestamp": "05:49:11", "text": "それから。しかし、これは彼女を行かせることにもなる"}, {"type": "subtitle", "time": 20953.83, "timestamp": "05:49:13", "text": "そういう風に考えるということですよね？それは"}, {"type": "subtitle", "time": 20958.15, "timestamp": "05:49:18", "text": "私たちは逃げようとしていたのであって、そうしようとしていたわけではありません。それで、"}, {"type": "subtitle", "time": 20962.63, "timestamp": "05:49:22", "text": "ある意味、そうなるだろうね。さよなら。"}, {"type": "subtitle", "time": 20969.75, "timestamp": "05:49:29", "text": "[音楽]"}, {"type": "subtitle", "time": 20972.03, "timestamp": "05:49:32", "text": "再読み込みするかもしれない"}, {"type": "subtitle", "time": 20977.23, "timestamp": "05:49:37", "text": "保存。セーブデータをロードし直すかもしれません。ああ、"}, {"type": "subtitle", "time": 20980.07, "timestamp": "05:49:40", "text": "神。この日をリロードするかもしれない"}, {"type": "subtitle", "time": 20984.52, "timestamp": "05:49:44", "text": "うまくいかなかった場合の対処法。わからない。"}, {"type": "subtitle", "time": 20992.35, "timestamp": "05:49:52", "text": "しかし、ここでの重要なことは"}]
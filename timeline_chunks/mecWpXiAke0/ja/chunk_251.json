[{"type": "subtitle", "time": 15060.469, "timestamp": "04:11:00", "text": "世界的な不可能な大物になるか、"}, {"type": "subtitle", "time": 15062.95, "timestamp": "04:11:02", "text": "何でも。実際に入ったので、"}, {"type": "subtitle", "time": 15065.51, "timestamp": "04:11:05", "text": "食事を抜いたりするようになった。はい、"}, {"type": "subtitle", "time": 15067.03, "timestamp": "04:11:07", "text": "最近、多くの人が"}, {"type": "subtitle", "time": 15068.87, "timestamp": "04:11:08", "text": "彼らが力を持っている場所のように"}, {"type": "subtitle", "time": 15070.63, "timestamp": "04:11:10", "text": "世界を支配し、さらに減らす"}, {"type": "subtitle", "time": 15073.189, "timestamp": "04:11:13", "text": "人口とかそういうのと、何人かの人々"}, {"type": "subtitle", "time": 15074.87, "timestamp": "04:11:14", "text": "また、それが"}, {"type": "subtitle", "time": 15076.469, "timestamp": "04:11:16", "text": "私たちの世界で起こっていることはこれらを構成します"}, {"type": "subtitle", "time": 15080.07, "timestamp": "04:11:20", "text": "怒りを向ける凶暴なブギーマン"}, {"type": "subtitle", "time": 15081.91, "timestamp": "04:11:21", "text": "プレイすると思いますが、"}, {"type": "subtitle", "time": 15083.59, "timestamp": "04:11:23", "text": "私たちが生きている時代は、"}, {"type": "subtitle", "time": 15085.75, "timestamp": "04:11:25", "text": "人々は誰かや何かが"}, {"type": "subtitle", "time": 15088.389, "timestamp": "04:11:28", "text": "怒っているが、私たちは皆働くべきだ"}, {"type": "subtitle", "time": 15090.15, "timestamp": "04:11:30", "text": "一緒にお願いします、これが私の唯一の願いです"}, {"type": "subtitle", "time": 15091.07, "timestamp": "04:11:31", "text": "インド"}, {"type": "subtitle", "time": 15093.269, "timestamp": "04:11:33", "text": "天使。それは良いことですよね？それでおしまい。"}, {"type": "subtitle", "time": 15095.189, "timestamp": "04:11:35", "text": "よし、それを保存して、どうなるか見てみよう"}, {"type": "subtitle", "time": 15097.91, "timestamp": "04:11:37", "text": "ストリームのことですよね？彼らは私の小さな"}, {"type": "subtitle", "time": 15100.59, "timestamp": "04:11:40", "text": "モルモット。ああ、"}, {"type": "subtitle", "time": 15105.63, "timestamp": "04:11:45", "text": "神。 30年後、たった一人の少女だけが残された。ああ、"}]
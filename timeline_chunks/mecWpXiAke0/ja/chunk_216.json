[{"type": "subtitle", "time": 12966.79, "timestamp": "03:36:06", "text": "よし、生地とか色々用意しなきゃ。 A"}, {"type": "subtitle", "time": 12968.67, "timestamp": "03:36:08", "text": "今夜ストリーミング配信へ"}, {"type": "subtitle", "time": 12971.429, "timestamp": "03:36:11", "text": "時間。私は本当に猫が欲しいのですが、"}, {"type": "subtitle", "time": 12973.91, "timestamp": "03:36:13", "text": "彼に取らせるだけ"}, {"type": "subtitle", "time": 12988.87, "timestamp": "03:36:28", "text": "いや。私は死にたいとは思っていません。待って、"}, {"type": "subtitle", "time": 12992.55, "timestamp": "03:36:32", "text": "何？ヤンドレヤンドレを見つけて、彼女を"}, {"type": "subtitle", "time": 12994.55, "timestamp": "03:36:34", "text": "ヤと恋に落ちて、それから他の2人とも"}, {"type": "subtitle", "time": 13010.51, "timestamp": "03:36:50", "text": "[音楽]"}]
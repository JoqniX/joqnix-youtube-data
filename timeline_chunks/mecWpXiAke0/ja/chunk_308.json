[{"type": "subtitle", "time": 18483.868, "timestamp": "05:08:03", "text": "ない"}, {"type": "subtitle", "time": 18489.09, "timestamp": "05:08:09", "text": "いいえ。いいえ。いいえ。いいえ。いいえ。"}, {"type": "subtitle", "time": 18491.43, "timestamp": "05:08:11", "text": "[音楽]"}, {"type": "subtitle", "time": 18493.61, "timestamp": "05:08:13", "text": "苦痛"}, {"type": "subtitle", "time": 18496.51, "timestamp": "05:08:16", "text": "[音楽]"}, {"type": "subtitle", "time": 18498.69, "timestamp": "05:08:18", "text": "リンダ。"}, {"type": "subtitle", "time": 18502.83, "timestamp": "05:08:22", "text": "[音楽]"}, {"type": "subtitle", "time": 18507.11, "timestamp": "05:08:27", "text": "はぁ？なるほど、それは新しいですね。私は決して待たない、"}, {"type": "subtitle", "time": 18508.43, "timestamp": "05:08:28", "text": "もし私がそうしたら"}, {"type": "subtitle", "time": 18511.99, "timestamp": "05:08:31", "text": "そうなると、私の好感度は下がります。"}, {"type": "subtitle", "time": 18513.67, "timestamp": "05:08:33", "text": "うん、うん、うん。私はこれをすべきではない。"}, {"type": "subtitle", "time": 18524.31, "timestamp": "05:08:44", "text": "[音楽]"}, {"type": "subtitle", "time": 18531.07, "timestamp": "05:08:51", "text": "いつものように友達はあなたを彼らの中にいます"}, {"type": "subtitle", "time": 18533.67, "timestamp": "05:08:53", "text": "心臓。ああ、彼女は来た。ああ、待って。おお、"}, {"type": "subtitle", "time": 18535.27, "timestamp": "05:08:55", "text": "待って。あ、待って。私たちは気が狂いそうだ"}, {"type": "subtitle", "time": 18539.15, "timestamp": "05:08:59", "text": "モード。何てことだ。なぜ私はクリックしたのか"}]
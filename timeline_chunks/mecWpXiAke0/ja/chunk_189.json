[{"type": "subtitle", "time": 11342.99, "timestamp": "03:09:02", "text": "ゲーム。私はもうすぐ終わると思います"}, {"type": "subtitle", "time": 11352.79, "timestamp": "03:09:12", "text": "それ。私がこんな風なのは私のせいだ"}, {"type": "subtitle", "time": 11355.91, "timestamp": "03:09:15", "text": "作業が遅れている。だから私は"}, {"type": "subtitle", "time": 11357.99, "timestamp": "03:09:17", "text": "改めてお詫び申し上げます。"}, {"type": "subtitle", "time": 11361.03, "timestamp": "03:09:21", "text": "しかし、私たちは戻ってきました。場面転換しましょう"}, {"type": "subtitle", "time": 11365.389, "timestamp": "03:09:25", "text": "そして私たちはゲームをする。さあ"}, {"type": "subtitle", "time": 11369.269, "timestamp": "03:09:29", "text": "行く。こちらは我らが主、ニーディ・シュレアです。そして"}, {"type": "subtitle", "time": 11372.23, "timestamp": "03:09:32", "text": "クリスマスには音楽を消します"}, {"type": "subtitle", "time": 11376.63, "timestamp": "03:09:36", "text": "困窮者のための音楽、海のストリーマー音楽。"}, {"type": "subtitle", "time": 11379.91, "timestamp": "03:09:39", "text": "それは、とてもかわいい良い音楽です"}, {"type": "subtitle", "time": 11385.19, "timestamp": "03:09:45", "text": "もっている。このゲームの音楽は本当に素晴らしい"}, {"type": "subtitle", "time": 11390.71, "timestamp": "03:09:50", "text": "皆さんが興味があるかどうかはわかりませんが"}, {"type": "subtitle", "time": 11391.79, "timestamp": "03:09:51", "text": "ジャンルだが"}, {"type": "subtitle", "time": 11395.19, "timestamp": "03:09:55", "text": "ええ、このゲームは"}, {"type": "subtitle", "time": 11398.469, "timestamp": "03:09:58", "text": "現代の日本だが、"}]
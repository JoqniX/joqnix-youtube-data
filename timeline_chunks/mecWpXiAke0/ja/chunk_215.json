[{"type": "subtitle", "time": 12901.79, "timestamp": "03:35:01", "text": "ああ、一晩中眠って過ごす"}, {"type": "subtitle", "time": 12904.87, "timestamp": "03:35:04", "text": "パラダイス。私は毎晩Kエンジェルに祈りを捧げます。"}, {"type": "subtitle", "time": 12906.99, "timestamp": "03:35:06", "text": "彼女は私の女神だ。ああ、"}, {"type": "subtitle", "time": 12910.63, "timestamp": "03:35:10", "text": "神。彼らはそう言っているのですか？シンプ。おお"}, {"type": "subtitle", "time": 12911.71, "timestamp": "03:35:11", "text": "私の"}, {"type": "subtitle", "time": 12915.269, "timestamp": "03:35:15", "text": "神。私たちのデートは10点満点中10点です。"}, {"type": "subtitle", "time": 12917.03, "timestamp": "03:35:17", "text": "葉影はとても楽しかった。多くの人が"}, {"type": "subtitle", "time": 12919.91, "timestamp": "03:35:19", "text": "たくさん服を着ることは個人的な特徴だと思う"}, {"type": "subtitle", "time": 12923.429, "timestamp": "03:35:23", "text": "けれど。うんうん。手伝ってくれてありがとう"}, {"type": "subtitle", "time": 12925.83, "timestamp": "03:35:25", "text": "私が自分のコードを選びます。えっと、私の"}, {"type": "subtitle", "time": 12930.269, "timestamp": "03:35:30", "text": "看護師さん、今夜それを見るのがどれほど良いか。"}, {"type": "subtitle", "time": 12934.15, "timestamp": "03:35:34", "text": "お出かけ用のキャンディゴール。ああ、頑張ってみます"}, {"type": "subtitle", "time": 12937.11, "timestamp": "03:35:37", "text": "アウトロリーゴールリタ。ああ、なんてことだ"}, {"type": "subtitle", "time": 12939.469, "timestamp": "03:35:39", "text": "もう夜だ。待って"}, {"type": "subtitle", "time": 12942.03, "timestamp": "03:35:42", "text": "何？"}, {"type": "subtitle", "time": 12944.389, "timestamp": "03:35:44", "text": "他の場所に行った方がいいでしょうか？"}]
[{"type": "subtitle", "time": 8645.99, "timestamp": "02:24:05", "text": "96. これにより、私は"}, {"type": "subtitle", "time": 8648.99, "timestamp": "02:24:08", "text": "ビデオゲームでも何でもいいからプレイする。"}, {"type": "subtitle", "time": 8651.48, "timestamp": "02:24:11", "text": "おい、兄弟、これは"}, {"type": "subtitle", "time": 8662.75, "timestamp": "02:24:22", "text": "悪い。自分の持ち物を見るにはどうすればいいですか？"}, {"type": "subtitle", "time": 8665.75, "timestamp": "02:24:25", "text": "より良い。もし別のデバイスを持っていたら"}, {"type": "subtitle", "time": 8667.469, "timestamp": "02:24:27", "text": "または電話、私は"}, {"type": "subtitle", "time": 8669.68, "timestamp": "02:24:29", "text": "文字通り確認済み"}, {"type": "subtitle", "time": 8671.07, "timestamp": "02:24:31", "text": "[音楽]"}, {"type": "subtitle", "time": 8674.55, "timestamp": "02:24:34", "text": "それ。よし、リスクを冒してみよう。さあ"}, {"type": "subtitle", "time": 8676.68, "timestamp": "02:24:36", "text": "さあ 打ち上げスケジュール1。そして私はただ"}, {"type": "subtitle", "time": 8679.92, "timestamp": "02:24:39", "text": "打ち上げスケジュール1。そして私はただ それを確認するため。"}, {"type": "subtitle", "time": 8687.15, "timestamp": "02:24:47", "text": "はい、ちょっと確認してみます"}, {"type": "subtitle", "time": 8690.55, "timestamp": "02:24:50", "text": "動作が遅いということです。"}, {"type": "subtitle", "time": 8692.45, "timestamp": "02:24:52", "text": "何てことだ。 100%"}, {"type": "subtitle", "time": 8694.27, "timestamp": "02:24:54", "text": "[音楽]"}]
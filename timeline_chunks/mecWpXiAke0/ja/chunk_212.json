[{"type": "subtitle", "time": 12726.429, "timestamp": "03:32:06", "text": "しないで"}, {"type": "subtitle", "time": 12729.91, "timestamp": "03:32:09", "text": "泣く。古いfsに媚びるのはやめてください"}, {"type": "subtitle", "time": 12731.83, "timestamp": "03:32:11", "text": "インターネット。待って。ああ、これらの息子たちは"}, {"type": "subtitle", "time": 12733.71, "timestamp": "03:32:13", "text": "彼女の配信を見ている。待って、"}, {"type": "subtitle", "time": 12736.63, "timestamp": "03:32:16", "text": "何？はい、大丈夫です。いつも"}, {"type": "subtitle", "time": 12739.03, "timestamp": "03:32:19", "text": "次回。うん、うん、うん。そうするべきです。"}, {"type": "subtitle", "time": 12741.309, "timestamp": "03:32:21", "text": "左クリックしない"}, {"type": "subtitle", "time": 12743.429, "timestamp": "03:32:23", "text": "コメント。あなたはとても美人だから幸運だね。"}, {"type": "subtitle", "time": 12746.57, "timestamp": "03:32:26", "text": "私は親友です。"}, {"type": "subtitle", "time": 12755.429, "timestamp": "03:32:35", "text": "状況が見えるだけです"}, {"type": "subtitle", "time": 12757.07, "timestamp": "03:32:37", "text": "女性にとって適切"}, {"type": "subtitle", "time": 12759.59, "timestamp": "03:32:39", "text": "振られた時、負けた時に泣く"}, {"type": "subtitle", "time": 12761.349, "timestamp": "03:32:41", "text": "あなたの財布と子供がフラッシュするとき"}, {"type": "subtitle", "time": 12763.55, "timestamp": "03:32:43", "text": "ゲームは"}, {"type": "subtitle", "time": 12765.79, "timestamp": "03:32:45", "text": "製造中止"}, {"type": "subtitle", "time": 12767.99, "timestamp": "03:32:47", "text": "もっと。さて、初めてのゲーム配信です。それは"}, {"type": "subtitle", "time": 12770.51, "timestamp": "03:32:50", "text": "本日は以上です。私"}, {"type": "subtitle", "time": 12773.83, "timestamp": "03:32:53", "text": "いや、うまくいかなかったみたいだね。"}, {"type": "subtitle", "time": 12777.269, "timestamp": "03:32:57", "text": "[音楽]"}, {"type": "subtitle", "time": 12779.269, "timestamp": "03:32:59", "text": "何てことだ。自分が知っているなんて信じられない"}]
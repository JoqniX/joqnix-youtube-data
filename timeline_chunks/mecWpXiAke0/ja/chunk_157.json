[{"type": "subtitle", "time": 9420.27, "timestamp": "02:37:00", "text": "できるかどうか疑わしい"}, {"type": "subtitle", "time": 9424.389, "timestamp": "02:37:04", "text": "TWもですが、試してみようと思いました"}, {"type": "subtitle", "time": 9426.429, "timestamp": "02:37:06", "text": "どちらにしても"}, {"type": "subtitle", "time": 9430.07, "timestamp": "02:37:10", "text": "どうにか。そして今、私は"}, {"type": "subtitle", "time": 9432.87, "timestamp": "02:37:12", "text": "ついに夢が叶う"}, {"type": "subtitle", "time": 9434.87, "timestamp": "02:37:14", "text": "YouTubeにも当てはまる。私はYouTubeになった"}, {"type": "subtitle", "time": 9438.309, "timestamp": "02:37:18", "text": "今すぐパートナーになりましょう。つまり、私は収益化できるということだ。"}, {"type": "subtitle", "time": 9440.87, "timestamp": "02:37:20", "text": "YouTubeから削除しました。だから、私は努力したかった"}, {"type": "subtitle", "time": 9442.71, "timestamp": "02:37:22", "text": "ビリービリーについても、私もやっているので"}, {"type": "subtitle", "time": 9447.15, "timestamp": "02:37:27", "text": "この大きなストリーミングの苦労"}, {"type": "subtitle", "time": 9450.27, "timestamp": "02:37:30", "text": "今。だから、フォロワーが100人増えるといいなと思っています"}, {"type": "subtitle", "time": 9453.389, "timestamp": "02:37:33", "text": "何らかの方法で、私の配信を気に入ってくれた人たちが"}, {"type": "subtitle", "time": 9457.87, "timestamp": "02:37:37", "text": "もの。ええ、そうすればマルチリレーションが可能になるので"}, {"type": "subtitle", "time": 9460.309, "timestamp": "02:37:40", "text": "ソフトウェアを使用するのではなく直接"}, {"type": "subtitle", "time": 9463.59, "timestamp": "02:37:43", "text": "そして全て。でも、7月からは"}, {"type": "subtitle", "time": 9465.51, "timestamp": "02:37:45", "text": "7月には日本にいます。だから、私は"}, {"type": "subtitle", "time": 9469.389, "timestamp": "02:37:49", "text": "ノートパソコンとか、その他諸々を買う。"}, {"type": "subtitle", "time": 9473.23, "timestamp": "02:37:53", "text": "えっと、ノートパソコンとか全部。それで"}, {"type": "subtitle", "time": 9478.79, "timestamp": "02:37:58", "text": "7月以降、7月中旬または8月、私の"}]
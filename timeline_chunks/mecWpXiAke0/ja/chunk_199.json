[{"type": "subtitle", "time": 11942.229, "timestamp": "03:19:02", "text": "[音楽]"}, {"type": "subtitle", "time": 11945.309, "timestamp": "03:19:05", "text": "ファンはきっと喜ぶだろうし、"}, {"type": "subtitle", "time": 11948.79, "timestamp": "03:19:08", "text": "寛大。待って、私は"}, {"type": "subtitle", "time": 11951.75, "timestamp": "03:19:11", "text": "あなたが選んだコメント。なんてこった。何てことだ。"}, {"type": "subtitle", "time": 11955.51, "timestamp": "03:19:15", "text": "待って。かわいい天使が来ます。わかった。おい"}, {"type": "subtitle", "time": 11957.67, "timestamp": "03:19:17", "text": "みんな。今回が初対面です。"}, {"type": "subtitle", "time": 11959.51, "timestamp": "03:19:19", "text": "何てことだ。カワイイエンジェル。待って、待って、"}, {"type": "subtitle", "time": 11962.03, "timestamp": "03:19:22", "text": "待って。読めません。"}, {"type": "subtitle", "time": 11966.229, "timestamp": "03:19:26", "text": "フォロワーが10万人になった"}, {"type": "subtitle", "time": 11967.95, "timestamp": "03:19:27", "text": "一発勝負。"}, {"type": "subtitle", "time": 11973.229, "timestamp": "03:19:33", "text": "どうやって？"}, {"type": "subtitle", "time": 11977.83, "timestamp": "03:19:37", "text": "天使がついに世界中で召喚される"}, {"type": "subtitle", "time": 11982.07, "timestamp": "03:19:42", "text": "長い時間を過ごした後で。登録者数が100人になりました"}, {"type": "subtitle", "time": 11984.87, "timestamp": "03:19:44", "text": "購読者数を増やす。はぁ？それは違う"}, {"type": "subtitle", "time": 11986.95, "timestamp": "03:19:46", "text": "十分。もっと多くの人にファンになってもらいたい"}, {"type": "subtitle", "time": 11990.229, "timestamp": "03:19:50", "text": "自分。何？私はとても幸せになるでしょう"}, {"type": "subtitle", "time": 11993.389, "timestamp": "03:19:53", "text": "1000ドル持っていたら、一週間ずっと泣いているだろう"}, {"type": "subtitle", "time": 11995.71, "timestamp": "03:19:55", "text": "フォロワー。ああ、"}, {"type": "subtitle", "time": 11998.79, "timestamp": "03:19:58", "text": "神様、私たちはただ、私たちはただ"}]
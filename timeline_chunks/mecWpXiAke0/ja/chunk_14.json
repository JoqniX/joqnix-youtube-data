[{"type": "subtitle", "time": 842.71, "timestamp": "00:14:02", "text": "言った通りだよ、兄弟、もし君が何を持っているか？私はできません"}, {"type": "subtitle", "time": 845.11, "timestamp": "00:14:05", "text": "男性c仮想男性のストリーム"}, {"type": "subtitle", "time": 847.629, "timestamp": "00:14:07", "text": "キャラクター。何？何"}, {"type": "subtitle", "time": 860.069, "timestamp": "00:14:20", "text": "ゲーム。よし、ゲーマー諸君。大丈夫。では、"}, {"type": "subtitle", "time": 888.509, "timestamp": "00:14:48", "text": "通常の鎧"}, {"type": "subtitle", "time": 891.509, "timestamp": "00:14:51", "text": "取得。私は「ああ、君」が欲しい"}, {"type": "subtitle", "time": 893.269, "timestamp": "00:14:53", "text": "できる。こうすれば複数"}, {"type": "subtitle", "time": 894.509, "timestamp": "00:14:54", "text": "シーンと"}, {"type": "subtitle", "time": 898.47, "timestamp": "00:14:58", "text": "もの。ああ、わかったよ。ぼかし効果を出すにはどうすればいいですか？"}]
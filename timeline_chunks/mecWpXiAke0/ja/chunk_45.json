[{"type": "subtitle", "time": 2707.95, "timestamp": "00:45:07", "text": "それ。翻訳もまた"}, {"type": "subtitle", "time": 2711.03, "timestamp": "00:45:11", "text": "そこには。よし、これで大丈夫だろう。わかった、"}, {"type": "subtitle", "time": 2712.349, "timestamp": "00:45:12", "text": "私は"}, {"type": "subtitle", "time": 2715.75, "timestamp": "00:45:15", "text": "準備ができて。もう準備はできた気がする。私は"}, {"type": "subtitle", "time": 2717.71, "timestamp": "00:45:17", "text": "生まれる"}, {"type": "subtitle", "time": 2720.67, "timestamp": "00:45:20", "text": "準備ができて。はい、"}, {"type": "subtitle", "time": 2739.829, "timestamp": "00:45:39", "text": "また？そうそう。これを変更する必要がある"}, {"type": "subtitle", "time": 2742.71, "timestamp": "00:45:42", "text": "今。 Hはオネクシア家のオーナーです。する必要がある"}, {"type": "subtitle", "time": 2746.309, "timestamp": "00:45:46", "text": "それを変えなさい。ええ、そうですね。こんにちは、私は"}, {"type": "subtitle", "time": 2752.829, "timestamp": "00:45:52", "text": "[音楽]"}]
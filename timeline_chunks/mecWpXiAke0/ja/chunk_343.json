[{"type": "subtitle", "time": 20582.628, "timestamp": "05:43:02", "text": "はぁ？私はそれを隠す必要があると考えています"}, {"type": "subtitle", "time": 20588.868, "timestamp": "05:43:08", "text": "テスト。人間は完全に生きることはできない"}, {"type": "subtitle", "time": 20590.59, "timestamp": "05:43:10", "text": "ストレスフリー。そうでしょう"}, {"type": "subtitle", "time": 20594.07, "timestamp": "05:43:14", "text": "考える？待って、待つよ。エンディングは2つありました"}, {"type": "subtitle", "time": 20596.27, "timestamp": "05:43:16", "text": "連続して。"}, {"type": "subtitle", "time": 20599.15, "timestamp": "05:43:19", "text": "何？ノーミー"}, {"type": "subtitle", "time": 20601.39, "timestamp": "05:43:21", "text": "人生。それで私たちは"}, {"type": "subtitle", "time": 20605.19, "timestamp": "05:43:25", "text": "終末期としての、平坦な人生と平凡な人生。"}, {"type": "subtitle", "time": 20617.24, "timestamp": "05:43:37", "text": "了解しました。"}, {"type": "subtitle", "time": 20619.15, "timestamp": "05:43:39", "text": "[音楽]"}, {"type": "subtitle", "time": 20627.31, "timestamp": "05:43:47", "text": "また。私は何か別のことをしたい、"}, {"type": "subtitle", "time": 20629.83, "timestamp": "05:43:49", "text": "右？あのね？アニメが好きな理由"}, {"type": "subtitle", "time": 20633.23, "timestamp": "05:43:53", "text": "頻繁。私もMCが大好きです"}, {"type": "subtitle", "time": 20635.59, "timestamp": "05:43:55", "text": "女性。それを見るたびに、私は思う"}, {"type": "subtitle", "time": 20638.948, "timestamp": "05:43:58", "text": "いや、アニメがそれを見ずに考えるとどうなるか"}]
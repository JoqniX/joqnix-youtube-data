[{"type": "subtitle", "time": 19681.75, "timestamp": "05:28:01", "text": "おい。視聴者は21人です。 21k"}, {"type": "subtitle", "time": 19698.15, "timestamp": "05:28:18", "text": "おめでとうございます。ちょっと皆さんに話します"}, {"type": "subtitle", "time": 19704.868, "timestamp": "05:28:24", "text": "祝うためにそこにいるよ、教えてあげる"}, {"type": "subtitle", "time": 19710.47, "timestamp": "05:28:30", "text": "自分自身。彼女がこぼさないことを願います"}, {"type": "subtitle", "time": 19712.11, "timestamp": "05:28:32", "text": "多くの。"}, {"type": "subtitle", "time": 19722.11, "timestamp": "05:28:42", "text": "速い。来る"}, {"type": "subtitle", "time": 19732.548, "timestamp": "05:28:52", "text": "はい。天国から地上に降りてきて"}, {"type": "subtitle", "time": 19735.708, "timestamp": "05:28:55", "text": "インターネット上のすべての人を救おう。"}, {"type": "subtitle", "time": 19738.948, "timestamp": "05:28:58", "text": "デフォルト設定は強すぎる。ああ、"}]
[{"type": "subtitle", "time": 20764.15, "timestamp": "05:46:04", "text": "顔。あの顔を見ると腹が立つ。ああ、"}, {"type": "subtitle", "time": 20768.548, "timestamp": "05:46:08", "text": "神。よし。私たちの人物は"}, {"type": "subtitle", "time": 20772.15, "timestamp": "05:46:12", "text": "わかった。だから、私たちはできる、私たちができること"}, {"type": "subtitle", "time": 20774.11, "timestamp": "05:46:14", "text": "やることは閉じる"}, {"type": "subtitle", "time": 20777.75, "timestamp": "05:46:17", "text": "これ。あそこに置いてください。これを上に乗せる"}, {"type": "subtitle", "time": 20793.11, "timestamp": "05:46:33", "text": "モンスター？わかった。"}, {"type": "subtitle", "time": 20795.67, "timestamp": "05:46:35", "text": "もし彼らがファッションゼロを復活させたらどうなるだろうか？私"}, {"type": "subtitle", "time": 20797.39, "timestamp": "05:46:37", "text": "それがどうなるか見てみたい"}, {"type": "subtitle", "time": 20800.708, "timestamp": "05:46:40", "text": "行く。いいえ、ファッションをゼロに減らせば、"}, {"type": "subtitle", "time": 20807.51, "timestamp": "05:46:47", "text": "軍隊、そして彼女はきっと"}, {"type": "subtitle", "time": 20811.51, "timestamp": "05:46:51", "text": "軍隊を解散せよ。さらに、その地域は恐ろしい"}, {"type": "subtitle", "time": 20813.11, "timestamp": "05:46:53", "text": "それらでいっぱいだ。だから、"}, {"type": "subtitle", "time": 20815.43, "timestamp": "05:46:55", "text": "彼ら。彼らは多くの深い調査を行う"}, {"type": "subtitle", "time": 20819.03, "timestamp": "05:46:59", "text": "ネット価格が低かったり、いろいろあります。私たちの命を突き刺す"}]
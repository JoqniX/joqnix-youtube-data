[{"type": "subtitle", "time": 12120.47, "timestamp": "03:22:00", "text": "離れて。その"}, {"type": "subtitle", "time": 12127.309, "timestamp": "03:22:07", "text": "わかった。わかった。なぜ"}, {"type": "subtitle", "time": 12132.03, "timestamp": "03:22:12", "text": "一体なぜ対話は"}, {"type": "subtitle", "time": 12135.95, "timestamp": "03:22:15", "text": "聖歌？ああ、私一人であなたを打ち負かすこともできるわ。"}, {"type": "subtitle", "time": 12138.269, "timestamp": "03:22:18", "text": "何？"}, {"type": "subtitle", "time": 12142.469, "timestamp": "03:22:22", "text": "はぁ？はぁ？私は本当にそれをしたくない"}, {"type": "subtitle", "time": 12146.63, "timestamp": "03:22:26", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 12149.19, "timestamp": "03:22:29", "text": "では、ジョッキーをこちらに置きましょう。"}, {"type": "subtitle", "time": 12156.95, "timestamp": "03:22:36", "text": "わかった。ええ、できますよ。どういう意味"}, {"type": "subtitle", "time": 12160.51, "timestamp": "03:22:40", "text": "あなたは出来る？おい。それには同意しないでください。"}, {"type": "subtitle", "time": 12163.19, "timestamp": "03:22:43", "text": "おい。秘密のセットを返送できます"}, {"type": "subtitle", "time": 12165.83, "timestamp": "03:22:45", "text": "もしあなたがそういう人になりたいなら"}]
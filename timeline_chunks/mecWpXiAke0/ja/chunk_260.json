[{"type": "subtitle", "time": 15601.229, "timestamp": "04:20:01", "text": "カメラ。うっかり"}, {"type": "subtitle", "time": 15606.99, "timestamp": "04:20:06", "text": "フラッシュ。なんてこった。絶対にしないでください。"}, {"type": "subtitle", "time": 15609.99, "timestamp": "04:20:09", "text": "オビー、君のボーイフレンドにはならないで。ああ、"}, {"type": "subtitle", "time": 15611.53, "timestamp": "04:20:11", "text": "神。"}, {"type": "subtitle", "time": 15624.65, "timestamp": "04:20:24", "text": "泣く。何てことだ。私はしません"}, {"type": "subtitle", "time": 15628.91, "timestamp": "04:20:28", "text": "[音楽]"}, {"type": "subtitle", "time": 15631.83, "timestamp": "04:20:31", "text": "知る。あなたは私を愛しているはずなのに。"}, {"type": "subtitle", "time": 15633.59, "timestamp": "04:20:33", "text": "そしてあなたは、"}, {"type": "subtitle", "time": 15635.229, "timestamp": "04:20:35", "text": "あなたの自転車。行く"}, {"type": "subtitle", "time": 15637.99, "timestamp": "04:20:37", "text": "それ。彼女はそこへ行くつもりだ"}, {"type": "subtitle", "time": 15639.67, "timestamp": "04:20:39", "text": "うん。うん。うん。私はそうすべきではない 私はそうすべきだ"}, {"type": "subtitle", "time": 15641.41, "timestamp": "04:20:41", "text": "それはしないで。うん。"}, {"type": "subtitle", "time": 15648.75, "timestamp": "04:20:48", "text": "考えてくれてありがとう。私たちはそうします"}]
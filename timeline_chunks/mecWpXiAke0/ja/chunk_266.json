[{"type": "subtitle", "time": 15964.99, "timestamp": "04:26:04", "text": "[拍手]"}, {"type": "subtitle", "time": 15967.309, "timestamp": "04:26:07", "text": "離れて。私の"}, {"type": "subtitle", "time": 15977.67, "timestamp": "04:26:17", "text": "これはまずい。これはまずい。これが私が"}, {"type": "subtitle", "time": 15980.469, "timestamp": "04:26:20", "text": "配信すべきではなかった。配信すべきではなかった。おお"}, {"type": "subtitle", "time": 15982.61, "timestamp": "04:26:22", "text": "私の"}, {"type": "subtitle", "time": 15984.189, "timestamp": "04:26:24", "text": "[拍手]"}, {"type": "subtitle", "time": 15987.55, "timestamp": "04:26:27", "text": "神。私はしたくない"}, {"type": "subtitle", "time": 15991.229, "timestamp": "04:26:31", "text": "これ。これをスキップする方法はありますか？ああ、"}, {"type": "subtitle", "time": 15994.51, "timestamp": "04:26:34", "text": "神。貯金しておくべきだった。何てことだ。"}, {"type": "subtitle", "time": 16011.83, "timestamp": "04:26:51", "text": "[拍手]"}, {"type": "subtitle", "time": 16013.51, "timestamp": "04:26:53", "text": "私は最善を尽くしています。何を試しているのですか？"}, {"type": "subtitle", "time": 16015.24, "timestamp": "04:26:55", "text": "あなたは作ろうとしているのですか"}]
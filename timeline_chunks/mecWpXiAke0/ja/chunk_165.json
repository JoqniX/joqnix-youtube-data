[{"type": "subtitle", "time": 9922.79, "timestamp": "02:45:22", "text": "この15k。何てことだ。私のディーラーは"}, {"type": "subtitle", "time": 9926.75, "timestamp": "02:45:26", "text": "私のディーラーたちは今、絶好調です。"}, {"type": "subtitle", "time": 9931.79, "timestamp": "02:45:31", "text": "おお。くそ。くそ。ちくしょう、息子よ。"}, {"type": "subtitle", "time": 9933.86, "timestamp": "02:45:33", "text": "ニース。えっと、"}, {"type": "subtitle", "time": 9935.389, "timestamp": "02:45:35", "text": "[音楽]"}]
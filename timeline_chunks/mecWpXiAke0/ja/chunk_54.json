[{"type": "subtitle", "time": 3240.829, "timestamp": "00:54:00", "text": "みんな、私は"}, {"type": "subtitle", "time": 3250.03, "timestamp": "00:54:10", "text": "私はいつも好きだったわけではない"}, {"type": "subtitle", "time": 3252.51, "timestamp": "00:54:12", "text": "これ"}, {"type": "subtitle", "time": 3255.39, "timestamp": "00:54:15", "text": "ヴァカ。何をすべきか"}, {"type": "subtitle", "time": 3258.03, "timestamp": "00:54:18", "text": "あなた？"}, {"type": "subtitle", "time": 3260.39, "timestamp": "00:54:20", "text": "その通り。よし、トイレに行ってくる"}, {"type": "subtitle", "time": 3261.39, "timestamp": "00:54:21", "text": "本物"}, {"type": "subtitle", "time": 3263.91, "timestamp": "00:54:23", "text": "さあ、お腹をやってみよう"}, {"type": "subtitle", "time": 3267.19, "timestamp": "00:54:27", "text": "ストリーム。わかった。しーっ、ワインとか色々。私"}, {"type": "subtitle", "time": 3269.51, "timestamp": "00:54:29", "text": "そうします。私は教えなければならない"}]
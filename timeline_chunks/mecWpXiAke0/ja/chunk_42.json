[{"type": "subtitle", "time": 2528.15, "timestamp": "00:42:08", "text": "日本。だから私が主に伝えたかったのは"}, {"type": "subtitle", "time": 2530.109, "timestamp": "00:42:10", "text": "これを伝える"}, {"type": "subtitle", "time": 2532.27, "timestamp": "00:42:12", "text": "メッセージ"}, {"type": "subtitle", "time": 2535.79, "timestamp": "00:42:15", "text": "みんなと私"}, {"type": "subtitle", "time": 2540.91, "timestamp": "00:42:20", "text": "もしかしたら私に会えるかもしれない"}, {"type": "subtitle", "time": 2543.43, "timestamp": "00:42:23", "text": "こちらでストリーミング配信中です。"}, {"type": "subtitle", "time": 2548.15, "timestamp": "00:42:28", "text": "今日から今日"}, {"type": "subtitle", "time": 2550.91, "timestamp": "00:42:30", "text": "えっと、今日から私は自分の"}, {"type": "subtitle", "time": 2554.99, "timestamp": "00:42:34", "text": "私ができることを覚えておくのが一番"}, {"type": "subtitle", "time": 2561.19, "timestamp": "00:42:41", "text": "チャトンチョンが配信していることだけを覚えておいてください"}, {"type": "subtitle", "time": 2567.55, "timestamp": "00:42:47", "text": "私の"}, {"type": "subtitle", "time": 2571.39, "timestamp": "00:42:51", "text": "ベスト"}, {"type": "subtitle", "time": 2574.19, "timestamp": "00:42:54", "text": "私にとって"}]
[{"type": "subtitle", "time": 20045.56, "timestamp": "05:34:05", "text": "それ。明日会おうね。"}, {"type": "subtitle", "time": 20050.75, "timestamp": "05:34:10", "text": "それなし"}, {"type": "subtitle", "time": 20058.628, "timestamp": "05:34:18", "text": "待って、身体検査を受けるけど、"}, {"type": "subtitle", "time": 20060.15, "timestamp": "05:34:20", "text": "何かをするエネルギーがないので、ただ行きたいだけです"}, {"type": "subtitle", "time": 20063.75, "timestamp": "05:34:23", "text": "そして楽しんで、バカどもは忘れて"}, {"type": "subtitle", "time": 20067.89, "timestamp": "05:34:27", "text": "インターネットはOK、どこに行きたいですか"}, {"type": "subtitle", "time": 20077.868, "timestamp": "05:34:37", "text": "必要なのは土地だけだ。"}, {"type": "subtitle", "time": 20080.88, "timestamp": "05:34:40", "text": "うん。私だけの土地へ"}, {"type": "subtitle", "time": 20092.83, "timestamp": "05:34:52", "text": "[音楽]"}]
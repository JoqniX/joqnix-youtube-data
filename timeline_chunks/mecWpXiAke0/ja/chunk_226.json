[{"type": "subtitle", "time": 13562.55, "timestamp": "03:46:02", "text": "計算された円が与えられたら、私はどのように"}, {"type": "subtitle", "time": 13564.269, "timestamp": "03:46:04", "text": "それ"}, {"type": "subtitle", "time": 13567.03, "timestamp": "03:46:07", "text": "は。人々に何を尋ねるつもりですか？"}, {"type": "subtitle", "time": 13569.67, "timestamp": "03:46:09", "text": "もっとお金をあげるために、もっと与えてください？何？"}, {"type": "subtitle", "time": 13572.389, "timestamp": "03:46:12", "text": "ああ、それはしてはいけません。あ、待って。"}]
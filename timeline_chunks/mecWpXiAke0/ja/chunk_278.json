[{"type": "subtitle", "time": 16701.029, "timestamp": "04:38:21", "text": "私たちはみんな友達です。私たちは皆そうではない。"}, {"type": "subtitle", "time": 16703.47, "timestamp": "04:38:23", "text": "アイドルK"}, {"type": "subtitle", "time": 16707.429, "timestamp": "04:38:27", "text": "天使の友達。ここはどこ？ああ、彼らは"}, {"type": "subtitle", "time": 16713.429, "timestamp": "04:38:33", "text": "彼らは？ニース。"}, {"type": "subtitle", "time": 16716.4, "timestamp": "04:38:36", "text": "真実。アイドルカウンターは有害だ。"}, {"type": "subtitle", "time": 16720.189, "timestamp": "04:38:40", "text": "[音楽]"}, {"type": "subtitle", "time": 16727.789, "timestamp": "04:38:47", "text": "男の子。起き上がるのはとても難しい"}, {"type": "subtitle", "time": 16729.58, "timestamp": "04:38:49", "text": "朝。単に"}, {"type": "subtitle", "time": 16731.869, "timestamp": "04:38:51", "text": "[音楽]"}, {"type": "subtitle", "time": 16734.789, "timestamp": "04:38:54", "text": "それ。君たちは朝5時くらいに起きるの？"}, {"type": "subtitle", "time": 16738.15, "timestamp": "04:38:58", "text": "何歳児でも彼らを見ることができるのか？私はそれらを録音します。私"}]
[{"type": "subtitle", "time": 6720.91, "timestamp": "01:52:00", "text": "夜。寝る"}, {"type": "subtitle", "time": 6750.75, "timestamp": "01:52:30", "text": "待って、ストリームは"}, {"type": "subtitle", "time": 6754.83, "timestamp": "01:52:34", "text": "死ぬのか？開けることができません"}, {"type": "subtitle", "time": 6757.75, "timestamp": "01:52:37", "text": "ソフトウェアだよ、兄弟。私に「そうじゃない」なんて言わないで"}, {"type": "subtitle", "time": 6760.99, "timestamp": "01:52:40", "text": "ストリームについて教えてください"}]
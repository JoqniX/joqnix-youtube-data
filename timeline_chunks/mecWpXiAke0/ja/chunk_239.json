[{"type": "subtitle", "time": 14341.189, "timestamp": "03:59:01", "text": "神。彼女は泣いたの？"}, {"type": "subtitle", "time": 14344.3, "timestamp": "03:59:04", "text": "何か？いいえ。そうです。"}, {"type": "subtitle", "time": 14357.18, "timestamp": "03:59:17", "text": "永遠に"}, {"type": "subtitle", "time": 14360.67, "timestamp": "03:59:20", "text": "[音楽]"}, {"type": "subtitle", "time": 14364.309, "timestamp": "03:59:24", "text": "寝る。彼女にあげるべきでしょうか？よし、"}, {"type": "subtitle", "time": 14367.11, "timestamp": "03:59:27", "text": "彼女の愛情とストレスを感じ取ってください。彼女のストレス"}, {"type": "subtitle", "time": 14369.15, "timestamp": "03:59:29", "text": "は"}, {"type": "subtitle", "time": 14378.15, "timestamp": "03:59:38", "text": "[音楽]"}, {"type": "subtitle", "time": 14380.99, "timestamp": "03:59:40", "text": "何とかしてそれを実現させなければならない"}, {"type": "subtitle", "time": 14385.07, "timestamp": "03:59:45", "text": "下。これは何ですか？ハシュタク ハシュト"}, {"type": "subtitle", "time": 14388.11, "timestamp": "03:59:48", "text": "ハッシュラブは"}, {"type": "subtitle", "time": 14391.71, "timestamp": "03:59:51", "text": "空気。これは何ですか？ストレス"}, {"type": "subtitle", "time": 14395.389, "timestamp": "03:59:55", "text": "46. 職業"}]
[{"type": "subtitle", "time": 14943.03, "timestamp": "04:09:03", "text": "何か。ああ、それはいい考えだ。"}, {"type": "subtitle", "time": 14944.63, "timestamp": "04:09:04", "text": "でも、正直に言うと、私はあまり望んでいない"}, {"type": "subtitle", "time": 14947.349, "timestamp": "04:09:07", "text": "それを実行する。わかった。死にたくなる。"}, {"type": "subtitle", "time": 14950.15, "timestamp": "04:09:10", "text": "しかし、苦しみは私をより強くする"}, {"type": "subtitle", "time": 14952.55, "timestamp": "04:09:12", "text": "面白い。だから、私は"}, {"type": "subtitle", "time": 14955.429, "timestamp": "04:09:15", "text": "ストリーマーになるのは本当に大変だ。私の"}, {"type": "subtitle", "time": 14958.95, "timestamp": "04:09:18", "text": "暗い秘密の過去。おお、"}, {"type": "subtitle", "time": 14963.389, "timestamp": "04:09:23", "text": "[音楽]"}, {"type": "subtitle", "time": 14965.309, "timestamp": "04:09:25", "text": "いいえ。"}, {"type": "subtitle", "time": 14972.63, "timestamp": "04:09:32", "text": "夕暮れ。別に人に聞かれるのが嫌いなわけじゃないんだけど。"}, {"type": "subtitle", "time": 14974.389, "timestamp": "04:09:34", "text": "彼らとコラボレーションしたり何かしたりするつもりはないけど、"}, {"type": "subtitle", "time": 14976.51, "timestamp": "04:09:36", "text": "いつも返信を忘れてしまう"}, {"type": "subtitle", "time": 14987.229, "timestamp": "04:09:47", "text": "それは愛だ"}, {"type": "subtitle", "time": 14990.51, "timestamp": "04:09:50", "text": "永遠に。もう一度、何度でも言ってください。愛"}, {"type": "subtitle", "time": 14994.63, "timestamp": "04:09:54", "text": "永遠に。永遠の愛。永遠の愛。"}, {"type": "subtitle", "time": 14996.67, "timestamp": "04:09:56", "text": "私に送ってください"}]
[{"type": "subtitle", "time": 721.19, "timestamp": "00:12:01", "text": "配信中とかで。クールな方法"}, {"type": "subtitle", "time": 723.99, "timestamp": "00:12:03", "text": "交流や関わり合いなど。 A"}, {"type": "subtitle", "time": 724.829, "timestamp": "00:12:04", "text": "たくさん"}, {"type": "subtitle", "time": 728.15, "timestamp": "00:12:08", "text": "もの。いやー、これめっちゃかっこいい。したい"}, {"type": "subtitle", "time": 729.91, "timestamp": "00:12:09", "text": "これをやれよ、おい。"}, {"type": "subtitle", "time": 731.389, "timestamp": "00:12:11", "text": "私はしたい"}, {"type": "subtitle", "time": 734.389, "timestamp": "00:12:14", "text": "これは、費用がかかるだろう"}, {"type": "subtitle", "time": 746.19, "timestamp": "00:12:26", "text": "すべて。時間がかかるだろう"}, {"type": "subtitle", "time": 749.03, "timestamp": "00:12:29", "text": "永遠に。費用がかさむだろう"}, {"type": "subtitle", "time": 762.629, "timestamp": "00:12:42", "text": "行く。わかった。とにかく、えっと、ビリーをやろう"}, {"type": "subtitle", "time": 765.91, "timestamp": "00:12:45", "text": "ビリーの話題。私は使う必要があるかもしれない"}, {"type": "subtitle", "time": 769.269, "timestamp": "00:12:49", "text": "ビリーについて。わかった。えっと、教えます"}]
[{"type": "subtitle", "time": 12541.75, "timestamp": "03:29:01", "text": "どのアイデアを選ぶかによります。いくつかの"}, {"type": "subtitle", "time": 12543.91, "timestamp": "03:29:03", "text": "ストリーム配信でたくさんのフォロワーを獲得できる"}, {"type": "subtitle", "time": 12546.79, "timestamp": "03:29:06", "text": "しかし、結果や状況によっては"}, {"type": "subtitle", "time": 12549.03, "timestamp": "03:29:09", "text": "あなたが取る行動について。あなたはそうするかもしれない"}, {"type": "subtitle", "time": 12551.389, "timestamp": "03:29:11", "text": "私の期間中にいくつかのボーナスを受け取ることができる"}, {"type": "subtitle", "time": 12553.59, "timestamp": "03:29:13", "text": "ストリーム。例えば、たくさん遊ぶと"}, {"type": "subtitle", "time": 12555.19, "timestamp": "03:29:15", "text": "一緒にゲームをすれば、"}, {"type": "subtitle", "time": 12557.269, "timestamp": "03:29:17", "text": "たくさんの数式を手に入れよう"}, {"type": "subtitle", "time": 12565.07, "timestamp": "03:29:25", "text": "えっと、これは私たちがやったものです"}, {"type": "subtitle", "time": 12569.11, "timestamp": "03:29:29", "text": "いい挑戦だ、落ち着いて、1つやってみよう"}, {"type": "subtitle", "time": 12571.71, "timestamp": "03:29:31", "text": "陰謀論の3つの理論"}, {"type": "subtitle", "time": 12575.55, "timestamp": "03:29:35", "text": "1つやってみよう、遊ぼう"}, {"type": "subtitle", "time": 12593.19, "timestamp": "03:29:53", "text": "デビューの翌日にはもう"}, {"type": "subtitle", "time": 12595.91, "timestamp": "03:29:55", "text": "ストリームで問題が発生しています。ええ、私は"}, {"type": "subtitle", "time": 12599.03, "timestamp": "03:29:59", "text": "ストリームだった、つまり、つまり"}]
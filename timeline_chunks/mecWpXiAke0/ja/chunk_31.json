[{"type": "subtitle", "time": 1862.75, "timestamp": "00:31:02", "text": "[音楽]"}, {"type": "subtitle", "time": 1871.47, "timestamp": "00:31:11", "text": "私が手に入れるなら"}, {"type": "subtitle", "time": 1874.63, "timestamp": "00:31:14", "text": "ログインしてください。私はまだ支払っていません"}, {"type": "subtitle", "time": 1876.43, "timestamp": "00:31:16", "text": "電話"}, {"type": "subtitle", "time": 1879.909, "timestamp": "00:31:19", "text": "番号。支払えるといいな"}, {"type": "subtitle", "time": 1880.83, "timestamp": "00:31:20", "text": "それ"}, {"type": "subtitle", "time": 1882.87, "timestamp": "00:31:22", "text": "働く。あ、待って。私はする必要はありません"}, {"type": "subtitle", "time": 1884.95, "timestamp": "00:31:24", "text": "それ。アプリにログインしました。私はできる"}]
[{"type": "subtitle", "time": 18661.67, "timestamp": "05:11:01", "text": "それ。わかった。 66. ストリーミングできると思います。"}, {"type": "subtitle", "time": 18663.47, "timestamp": "05:11:03", "text": "右？"}, {"type": "subtitle", "time": 18666.628, "timestamp": "05:11:06", "text": "うん。もっと減らさなければならない。"}, {"type": "subtitle", "time": 18668.57, "timestamp": "05:11:08", "text": "それが重要な点です。"}, {"type": "subtitle", "time": 18681.708, "timestamp": "05:11:21", "text": "65増加、"}, {"type": "subtitle", "time": 18704.32, "timestamp": "05:11:44", "text": "病院。よし、いくつか手に入れよう"}, {"type": "subtitle", "time": 18706.27, "timestamp": "05:11:46", "text": "[音楽]"}, {"type": "subtitle", "time": 18708.39, "timestamp": "05:11:48", "text": "治療。でも待って、私は"}, {"type": "subtitle", "time": 18709.45, "timestamp": "05:11:49", "text": "ストリーム、"}, {"type": "subtitle", "time": 18710.91, "timestamp": "05:11:50", "text": "[音楽]"}]
[{"type": "subtitle", "time": 13862.309, "timestamp": "03:51:02", "text": "こんにちは。何をするか？私は"}, {"type": "subtitle", "time": 13864.83, "timestamp": "03:51:04", "text": "Amazonのほしい物リスト。何を置けばいいですか？"}, {"type": "subtitle", "time": 13866.75, "timestamp": "03:51:06", "text": "の上？悪い"}, {"type": "subtitle", "time": 13871.99, "timestamp": "03:51:11", "text": "何？アフロ。待って。いいえ。それは、それは"}, {"type": "subtitle", "time": 13874.309, "timestamp": "03:51:14", "text": "それは怪しい。それは怪しい。いや、いや、そうしないで"}, {"type": "subtitle", "time": 13878.15, "timestamp": "03:51:18", "text": "18歳以上の配信者。そう言う人になりましょう"}, {"type": "subtitle", "time": 13881.389, "timestamp": "03:51:21", "text": "バック。でも18歳になりたい"}, {"type": "subtitle", "time": 13883.309, "timestamp": "03:51:23", "text": "プラス"}, {"type": "subtitle", "time": 13886.11, "timestamp": "03:51:26", "text": "衣装。よし。"}, {"type": "subtitle", "time": 13901.269, "timestamp": "03:51:41", "text": "多くの。あまりないのは残念だ"}, {"type": "subtitle", "time": 13904.99, "timestamp": "03:51:44", "text": "エモ絵文字ステッカー"}, {"type": "subtitle", "time": 13908.269, "timestamp": "03:51:48", "text": "ここ。だから、"}, {"type": "subtitle", "time": 13912.55, "timestamp": "03:51:52", "text": "痛み。今回は出かけて"}]
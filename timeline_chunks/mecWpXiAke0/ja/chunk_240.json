[{"type": "subtitle", "time": 14402.79, "timestamp": "04:00:02", "text": "ねえ、これをして下げるべき？"}, {"type": "subtitle", "time": 14411.389, "timestamp": "04:00:11", "text": "右？"}, {"type": "subtitle", "time": 14414.79, "timestamp": "04:00:14", "text": "えっと、これら全ては減少するだけです"}, {"type": "subtitle", "time": 14429.83, "timestamp": "04:00:29", "text": "明日まで寝ていられるのは"}, {"type": "subtitle", "time": 14435.11, "timestamp": "04:00:35", "text": "ウェイターが落とすようなものよりも少ない。"}, {"type": "subtitle", "time": 14439.469, "timestamp": "04:00:39", "text": "わかった。では、これはどうでしょうか？"}, {"type": "subtitle", "time": 14441.91, "timestamp": "04:00:41", "text": "もの？こうすれば私は"}, {"type": "subtitle", "time": 14445.15, "timestamp": "04:00:45", "text": "ファッションの流行も関係ありますよね？"}, {"type": "subtitle", "time": 14452.51, "timestamp": "04:00:52", "text": "[音楽]"}]
[{"type": "subtitle", "time": 19216.628, "timestamp": "05:20:16", "text": "待って、配信に遅延があるの？の上"}, {"type": "subtitle", "time": 19223.8, "timestamp": "05:20:23", "text": "ストリーム。"}, {"type": "subtitle", "time": 19230.51, "timestamp": "05:20:30", "text": "[音楽]"}, {"type": "subtitle", "time": 19233.03, "timestamp": "05:20:33", "text": "待って、あなたたち誰も持っていないなんて、ああ、なんてことだ、"}, {"type": "subtitle", "time": 19235.03, "timestamp": "05:20:35", "text": "彼女はそちらの方向へ行った。あの道。いいえ、それは"}, {"type": "subtitle", "time": 19252.23, "timestamp": "05:20:52", "text": "ファン。よし、彼女は1000に到達した。"}, {"type": "subtitle", "time": 19255.03, "timestamp": "05:20:55", "text": "フォロワー。はい。いいえ、フォロワーは1万人です。"}, {"type": "subtitle", "time": 19258.15, "timestamp": "05:20:58", "text": "さあ行こう。彼女は入ったかもしれない"}]
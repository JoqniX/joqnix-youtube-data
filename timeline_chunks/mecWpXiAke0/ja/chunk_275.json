[{"type": "subtitle", "time": 16504.629, "timestamp": "04:35:04", "text": "[音楽]"}, {"type": "subtitle", "time": 16516.75, "timestamp": "04:35:16", "text": "ごめん。もう一度スパムを送ってください。ブロックします。おお"}, {"type": "subtitle", "time": 16522.67, "timestamp": "04:35:22", "text": "[音楽]"}, {"type": "subtitle", "time": 16527.51, "timestamp": "04:35:27", "text": "悪い。何てことだ。彼女は本気だったのか？本物"}, {"type": "subtitle", "time": 16530.13, "timestamp": "04:35:30", "text": "マジで？それとも何か別のこと？でも私は"}, {"type": "subtitle", "time": 16542.75, "timestamp": "04:35:42", "text": "[音楽]"}]
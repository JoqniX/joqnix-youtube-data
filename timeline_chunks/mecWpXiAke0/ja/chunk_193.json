[{"type": "subtitle", "time": 11580.95, "timestamp": "03:13:00", "text": "ちゃん。そういう時が来たら、あなたは選ぶでしょう。"}, {"type": "subtitle", "time": 11584.309, "timestamp": "03:13:04", "text": "一緒に考えてください"}, {"type": "subtitle", "time": 11586.75, "timestamp": "03:13:06", "text": "何をするかについて真剣に考える"}, {"type": "subtitle", "time": 11588.59, "timestamp": "03:13:08", "text": "言う。"}, {"type": "subtitle", "time": 11592.91, "timestamp": "03:13:12", "text": "待って。えっと、最後まで言わせてください"}, {"type": "subtitle", "time": 11596.95, "timestamp": "03:13:16", "text": "これ。何てことだ。わかった。ちょっと送らせてください"}, {"type": "subtitle", "time": 11600.429, "timestamp": "03:13:20", "text": "この、このインスタグラムのリアル"}, {"type": "subtitle", "time": 11625.55, "timestamp": "03:13:45", "text": "うん。こんにちは。"}, {"type": "subtitle", "time": 11629.07, "timestamp": "03:13:49", "text": "静かに。わかった。その物語。"}, {"type": "subtitle", "time": 11631.63, "timestamp": "03:13:51", "text": "わかった。"}, {"type": "subtitle", "time": 11635.269, "timestamp": "03:13:55", "text": "ピザ。君は僕のピザだよ、だって君は"}, {"type": "subtitle", "time": 11637.95, "timestamp": "03:13:57", "text": "私にとって完璧です。ああ、"}]
[{"type": "subtitle", "time": 19563.55, "timestamp": "05:26:03", "text": "[音楽]"}, {"type": "subtitle", "time": 19568.628, "timestamp": "05:26:08", "text": "私が残したたくさんのBLに私は目を向けていました"}, {"type": "subtitle", "time": 19578.628, "timestamp": "05:26:18", "text": "BLがカルト的人気を誇るホラーゲームをプレイする"}, {"type": "subtitle", "time": 19581.83, "timestamp": "05:26:21", "text": "見て見て、何か本物を見つけたよ"}, {"type": "subtitle", "time": 19583.43, "timestamp": "05:26:23", "text": "ブロードウェイについて、最高のゲームは"}, {"type": "subtitle", "time": 19585.19, "timestamp": "05:26:25", "text": "夜に配信されるホラーゲーム"}, {"type": "subtitle", "time": 19588.55, "timestamp": "05:26:28", "text": "しかしこれも簡単すぎた"}, {"type": "subtitle", "time": 19589.708, "timestamp": "05:26:29", "text": "コンテンツ"}, {"type": "subtitle", "time": 19592.47, "timestamp": "05:26:32", "text": "ゲームに全財産を費やしたので、ゲーム"}, {"type": "subtitle", "time": 19595.628, "timestamp": "05:26:35", "text": "夜間のゲームは、"}, {"type": "subtitle", "time": 19599.03, "timestamp": "05:26:39", "text": "それ。きっと私は彼らからそれを搾り取ることができるだろう"}, {"type": "subtitle", "time": 19600.788, "timestamp": "05:26:40", "text": "少し叫んではいるけど。そうではない"}, {"type": "subtitle", "time": 19603.11, "timestamp": "05:26:43", "text": "叫ぶべきことがたくさんあるだろう"}, {"type": "subtitle", "time": 19606.75, "timestamp": "05:26:46", "text": "私は神のファンだから、ここにいるんです。これは、えーと"}, {"type": "subtitle", "time": 19614.07, "timestamp": "05:26:54", "text": "赤ちゃん、別名オーイェー。ええ、わかっています。私は"}, {"type": "subtitle", "time": 19616.35, "timestamp": "05:26:56", "text": "黄色。時々、私はそれを読みます"}, {"type": "subtitle", "time": 19618.65, "timestamp": "05:26:58", "text": "良い。すべての"}]
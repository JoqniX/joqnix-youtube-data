[{"type": "subtitle", "time": 16024.87, "timestamp": "04:27:04", "text": "自分？元気です。見た目はいいけど、"}, {"type": "subtitle", "time": 16026.189, "timestamp": "04:27:06", "text": "有望な"}, {"type": "subtitle", "time": 16028.71, "timestamp": "04:27:08", "text": "何もない。なんてこった。"}, {"type": "subtitle", "time": 16030.99, "timestamp": "04:27:10", "text": "手首の痛みはよくわかる"}, {"type": "subtitle", "time": 16034.59, "timestamp": "04:27:14", "text": "それが私の心の奥底にある気持ちです。おお"}, {"type": "subtitle", "time": 16037.349, "timestamp": "04:27:17", "text": "いいえ。なぜ私はこれにあまり共感できないのだろう？"}, {"type": "subtitle", "time": 16039.99, "timestamp": "04:27:19", "text": "わからない。暗闇は重要な"}, {"type": "subtitle", "time": 16042.269, "timestamp": "04:27:22", "text": "メッセージ。おお"}, {"type": "subtitle", "time": 16053.229, "timestamp": "04:27:33", "text": "永遠に。おお"}, {"type": "subtitle", "time": 16055.91, "timestamp": "04:27:35", "text": "いいえ。切り込むと稲妻が走る"}, {"type": "subtitle", "time": 16058.309, "timestamp": "04:27:38", "text": "何てことだ。"}]
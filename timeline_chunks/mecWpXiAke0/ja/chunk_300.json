[{"type": "subtitle", "time": 18001.628, "timestamp": "05:00:01", "text": "そして彼女は楽しむ"}, {"type": "subtitle", "time": 18004.75, "timestamp": "05:00:04", "text": "もっとファン"}, {"type": "subtitle", "time": 18008.07, "timestamp": "05:00:08", "text": "サービス。私は本気だと思う。の"}, {"type": "subtitle", "time": 18009.59, "timestamp": "05:00:09", "text": "あそこにいるのは愚かな考えだ。彼女は"}, {"type": "subtitle", "time": 18012.23, "timestamp": "05:00:12", "text": "頭いい。わかった。あそこの考えは愚かだ。"}, {"type": "subtitle", "time": 18014.54, "timestamp": "05:00:14", "text": "わかった。私たちはそこに行くべきではない"}, {"type": "subtitle", "time": 18017.55, "timestamp": "05:00:17", "text": "[音楽]"}, {"type": "subtitle", "time": 18027.35, "timestamp": "05:00:27", "text": "心理学。あなたはきっと先に進みたいのでしょう。おお、"}, {"type": "subtitle", "time": 18042.59, "timestamp": "05:00:42", "text": "[音楽]"}, {"type": "subtitle", "time": 18049.61, "timestamp": "05:00:49", "text": "h 私には必要です"}, {"type": "subtitle", "time": 18052.83, "timestamp": "05:00:52", "text": "[音楽]"}, {"type": "subtitle", "time": 18056.31, "timestamp": "05:00:56", "text": "スポンサーシップやオープンなイベントを行うことができます"}]
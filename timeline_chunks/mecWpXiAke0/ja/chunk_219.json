[{"type": "subtitle", "time": 13141.95, "timestamp": "03:39:01", "text": "起こる？ああ、それは"}, {"type": "subtitle", "time": 13144.83, "timestamp": "03:39:04", "text": "の曲に合わせて踊らない"}, {"type": "subtitle", "time": 13155.95, "timestamp": "03:39:15", "text": "ヤンドレ。彼女は"}, {"type": "subtitle", "time": 13158.79, "timestamp": "03:39:18", "text": "ヤンドレ。 K、あなたの言うことは何でも信じます"}, {"type": "subtitle", "time": 13160.67, "timestamp": "03:39:20", "text": "天使。なんてこった。実際の"}, {"type": "subtitle", "time": 13163.75, "timestamp": "03:39:23", "text": "シンプ。ああ、あなたは行き​​過ぎている"}, {"type": "subtitle", "time": 13180.63, "timestamp": "03:39:40", "text": "深い。まるで"}, {"type": "subtitle", "time": 13182.59, "timestamp": "03:39:42", "text": "最終的には"}, {"type": "subtitle", "time": 13185.99, "timestamp": "03:39:45", "text": "深い。いいですね、気に入りました。大丈夫です。"}, {"type": "subtitle", "time": 13188.469, "timestamp": "03:39:48", "text": "たとえあなたが操作して狂ったことをしても、"}, {"type": "subtitle", "time": 13191.25, "timestamp": "03:39:51", "text": "実在の人物に会うことができた"}, {"type": "subtitle", "time": 13192.75, "timestamp": "03:39:52", "text": "[音楽]"}, {"type": "subtitle", "time": 13197.75, "timestamp": "03:39:57", "text": "天使。なぜナッツなのか？わからない。"}]
[{"type": "subtitle", "time": 12000.63, "timestamp": "03:20:00", "text": "はじめる。少なくとも1つ必要です"}, {"type": "subtitle", "time": 12002.309, "timestamp": "03:20:02", "text": "今月から100万人のファンが見込まれる。これ"}, {"type": "subtitle", "time": 12006.07, "timestamp": "03:20:06", "text": "拡散には承認が必要です。何？何てことだ。"}, {"type": "subtitle", "time": 12008.63, "timestamp": "03:20:08", "text": "1ヶ月以内には実現できるだろう。"}, {"type": "subtitle", "time": 12010.469, "timestamp": "03:20:10", "text": "それは私にとって大きなモチベーションになった。作ろう"}, {"type": "subtitle", "time": 12013.63, "timestamp": "03:20:13", "text": "今月分をカウントします。聖なる"}, {"type": "subtitle", "time": 12015.99, "timestamp": "03:20:15", "text": "何？世界最大のストリーム"}, {"type": "subtitle", "time": 12018.95, "timestamp": "03:20:18", "text": "協力し合うんですよね？何てことだ。"}, {"type": "subtitle", "time": 12019.71, "timestamp": "03:20:19", "text": "一度もない"}, {"type": "subtitle", "time": 12033.99, "timestamp": "03:20:33", "text": "可能。それは努力次第です"}, {"type": "subtitle", "time": 12035.79, "timestamp": "03:20:35", "text": "そして献身"}, {"type": "subtitle", "time": 12038.309, "timestamp": "03:20:38", "text": "する。本当にこれを成功させたいと思っています"}, {"type": "subtitle", "time": 12040.03, "timestamp": "03:20:40", "text": "頼りにしている"}, {"type": "subtitle", "time": 12043.19, "timestamp": "03:20:43", "text": "あなた。今の私にできることは、"}, {"type": "subtitle", "time": 12045.67, "timestamp": "03:20:45", "text": "彼女がやるべきことをやる動機"}, {"type": "subtitle", "time": 12048.229, "timestamp": "03:20:48", "text": "最高。あなたも私を殴ったら壊れるかもしれない"}, {"type": "subtitle", "time": 12049.99, "timestamp": "03:20:49", "text": "難しい。しかし、そうなれば、"}, {"type": "subtitle", "time": 12051.07, "timestamp": "03:20:51", "text": "破壊する"}, {"type": "subtitle", "time": 12053.11, "timestamp": "03:20:53", "text": "インターネット。破壊するとはどういう意味ですか"}, {"type": "subtitle", "time": 12055.59, "timestamp": "03:20:55", "text": "インターネット？それは怖いですね。うん。"}, {"type": "subtitle", "time": 12059.07, "timestamp": "03:20:59", "text": "こんにちは。こんにちは、ラサン。こんにちは。元気ですか"}]
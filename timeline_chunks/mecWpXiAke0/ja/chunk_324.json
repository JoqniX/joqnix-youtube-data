[{"type": "subtitle", "time": 19442.15, "timestamp": "05:24:02", "text": "ああ、今、本当にリアルな気分だった。の"}, {"type": "subtitle", "time": 19444.55, "timestamp": "05:24:04", "text": "文書 私は続けられる気がする"}, {"type": "subtitle", "time": 19446.23, "timestamp": "05:24:06", "text": "私の言うことを信じてくれる。時には本当に"}, {"type": "subtitle", "time": 19449.03, "timestamp": "05:24:09", "text": "カチカチ音がするけど、こういう時もあるよね。でも私は"}, {"type": "subtitle", "time": 19451.91, "timestamp": "05:24:11", "text": "私が本当に愛していることを覚えておいてください"}, {"type": "subtitle", "time": 19458.948, "timestamp": "05:24:18", "text": "時間。ああ、大変だ。彼女がうっかり"}, {"type": "subtitle", "time": 19460.47, "timestamp": "05:24:20", "text": "他のツイート"}, {"type": "subtitle", "time": 19463.47, "timestamp": "05:24:23", "text": "[音楽]"}, {"type": "subtitle", "time": 19466.27, "timestamp": "05:24:26", "text": "1つ？ 10万に到達しました"}, {"type": "subtitle", "time": 19468.07, "timestamp": "05:24:28", "text": "購読者。これは初めてです"}, {"type": "subtitle", "time": 19469.51, "timestamp": "05:24:29", "text": "非常に多くの人々に影響を与えている。何が"}, {"type": "subtitle", "time": 19472.868, "timestamp": "05:24:32", "text": "ここから何が起こるか。だから私は"}, {"type": "subtitle", "time": 19474.868, "timestamp": "05:24:34", "text": "少し緊張している。見るような感じ"}, {"type": "subtitle", "time": 19477.19, "timestamp": "05:24:37", "text": "私の統計は貝です。私はいつも"}, {"type": "subtitle", "time": 19478.55, "timestamp": "05:24:38", "text": "北部のこととか文句を言って、"}, {"type": "subtitle", "time": 19479.91, "timestamp": "05:24:39", "text": "でも、彼らがいなければ私はここにいなかったでしょう"}, {"type": "subtitle", "time": 19481.708, "timestamp": "05:24:41", "text": "支えと運命。"}, {"type": "subtitle", "time": 19484.628, "timestamp": "05:24:44", "text": "ああ、彼らの装飾のために、彼らは"}, {"type": "subtitle", "time": 19486.708, "timestamp": "05:24:46", "text": "それは私をインターネットから締め出す。私はそうしました"}, {"type": "subtitle", "time": 19488.43, "timestamp": "05:24:48", "text": "天使のところへ行く"}, {"type": "subtitle", "time": 19490.47, "timestamp": "05:24:50", "text": "時間。次の配信では、"}, {"type": "subtitle", "time": 19492.31, "timestamp": "05:24:52", "text": "インターネットについて話して、伝えようとする"}, {"type": "subtitle", "time": 19494.67, "timestamp": "05:24:54", "text": "私がどれだけ遠くにいるか"}]
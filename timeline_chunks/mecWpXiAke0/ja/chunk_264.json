[{"type": "subtitle", "time": 15851.72, "timestamp": "04:24:11", "text": "自然。おい、人々のことなんて言うなよ。ああ、"}, {"type": "subtitle", "time": 15858.4, "timestamp": "04:24:18", "text": "ああ、ベイビー。彼女は「ああ、私の"}, {"type": "subtitle", "time": 15863.71, "timestamp": "04:24:23", "text": "[音楽]"}, {"type": "subtitle", "time": 15866.55, "timestamp": "04:24:26", "text": "「ああ、それを信じたい。」"}, {"type": "subtitle", "time": 15868.469, "timestamp": "04:24:28", "text": "それは本当だったよね？私はよかったと思う"}, {"type": "subtitle", "time": 15869.87, "timestamp": "04:24:29", "text": "共有できる"}, {"type": "subtitle", "time": 15872.31, "timestamp": "04:24:32", "text": "それ。"}, {"type": "subtitle", "time": 15884.83, "timestamp": "04:24:44", "text": "スージーのストレスが増している。ああ、"}, {"type": "subtitle", "time": 15895.03, "timestamp": "04:24:55", "text": "見て？どうして好きなのか、なぜ好きなのか"}, {"type": "subtitle", "time": 15895.36, "timestamp": "04:24:55", "text": "これ"}, {"type": "subtitle", "time": 15897.389, "timestamp": "04:24:57", "text": "[音楽]"}]
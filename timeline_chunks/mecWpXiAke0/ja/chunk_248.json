[{"type": "subtitle", "time": 14880.59, "timestamp": "04:08:00", "text": "する。ああ、これは"}, {"type": "subtitle", "time": 14883.229, "timestamp": "04:08:03", "text": "えっと、チャット。"}, {"type": "subtitle", "time": 14887.79, "timestamp": "04:08:07", "text": "うーん、わからないな。やり方がわからない"}, {"type": "subtitle", "time": 14892.07, "timestamp": "04:08:12", "text": "私の政府を生かしておけ。後退しているのが見える"}, {"type": "subtitle", "time": 14892.99, "timestamp": "04:08:12", "text": "外の世界"}, {"type": "subtitle", "time": 14895.15, "timestamp": "04:08:15", "text": "実は。彼女は"}, {"type": "subtitle", "time": 14911.71, "timestamp": "04:08:31", "text": "子供が私の"}, {"type": "subtitle", "time": 14914.349, "timestamp": "04:08:34", "text": "夢のように流れてくる"}, {"type": "subtitle", "time": 14916.87, "timestamp": "04:08:36", "text": "こういう真実は、私が"}, {"type": "subtitle", "time": 14918.91, "timestamp": "04:08:38", "text": "開始"}, {"type": "subtitle", "time": 14923.189, "timestamp": "04:08:43", "text": "ストリーミング"}, {"type": "subtitle", "time": 14929.229, "timestamp": "04:08:49", "text": "だから私は自分のアシスタントが大好きなんです。ああ、そうだ"}, {"type": "subtitle", "time": 14931.91, "timestamp": "04:08:51", "text": "右？今どきそんなこと言う人いる？でも、"}, {"type": "subtitle", "time": 14933.269, "timestamp": "04:08:53", "text": "恥ずかしいことについて考えたことはありますか"}, {"type": "subtitle", "time": 14935.11, "timestamp": "04:08:55", "text": "人々がしたような"}, {"type": "subtitle", "time": 14936.87, "timestamp": "04:08:56", "text": "過去？過去を変えられると思った"}, {"type": "subtitle", "time": 14939.67, "timestamp": "04:08:59", "text": "過去を圧縮してコンテンツに圧縮するか、"}]
[{"type": "subtitle", "time": 21842.548, "timestamp": "06:04:02", "text": "私はたくさん話して自分の意見を述べたかった"}, {"type": "subtitle", "time": 21845.43, "timestamp": "06:04:05", "text": "各イベントで"}, {"type": "subtitle", "time": 21846.67, "timestamp": "06:04:06", "text": "えーと、"}, {"type": "subtitle", "time": 21849.59, "timestamp": "06:04:09", "text": "ゲームだけど、私は集中しすぎて"}, {"type": "subtitle", "time": 21851.51, "timestamp": "06:04:11", "text": "いろいろあって、しかも何度も邪魔された。"}, {"type": "subtitle", "time": 21854.59, "timestamp": "06:04:14", "text": "最近では、今日のストリームも"}, {"type": "subtitle", "time": 21857.19, "timestamp": "06:04:17", "text": "良い。だから、どうすればいいのかわからない"}, {"type": "subtitle", "time": 21861.59, "timestamp": "06:04:21", "text": "配信時間を短縮すべきでしょうか？"}, {"type": "subtitle", "time": 21864.31, "timestamp": "06:04:24", "text": "ストリーミング配信をずっと続けることはできないようです"}, {"type": "subtitle", "time": 21870.788, "timestamp": "06:04:30", "text": "に。それは、えっと、なんて言うんだっけ"}, {"type": "subtitle", "time": 21872.788, "timestamp": "06:04:32", "text": "それ？私の自由は奪われた、あるいは"}, {"type": "subtitle", "time": 21874.35, "timestamp": "06:04:34", "text": "何か。私はしません"}, {"type": "subtitle", "time": 21878.15, "timestamp": "06:04:38", "text": "知る。わからない。たぶんそれは、"}, {"type": "subtitle", "time": 21880.31, "timestamp": "06:04:40", "text": "一人っ子にはたくさんのことをしなければならない"}, {"type": "subtitle", "time": 21883.31, "timestamp": "06:04:43", "text": "まさに家の中で。だからそれはある意味"}, {"type": "subtitle", "time": 21893.59, "timestamp": "06:04:53", "text": "知る。だから、私はそのことについてよく知らない"}, {"type": "subtitle", "time": 21895.51, "timestamp": "06:04:55", "text": "だから私もやってみます"}, {"type": "subtitle", "time": 21898.11, "timestamp": "06:04:58", "text": "来週時間を変更する"}]
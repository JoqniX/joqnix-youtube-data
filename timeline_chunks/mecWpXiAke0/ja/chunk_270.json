[{"type": "subtitle", "time": 16201.67, "timestamp": "04:30:01", "text": "彼女は時々こういう感じなんです。何てことだ。"}, {"type": "subtitle", "time": 16209.99, "timestamp": "04:30:09", "text": "ハンナ。なんてこった。いいえ。人々は"}, {"type": "subtitle", "time": 16212.07, "timestamp": "04:30:12", "text": "それとは違うやり方で。なんてこった。いいえ。いいえ。いいえ。いいえ。"}, {"type": "subtitle", "time": 16226.229, "timestamp": "04:30:26", "text": "ええと、すべてが対処可能だと感じられると書いてあります"}, {"type": "subtitle", "time": 16229.79, "timestamp": "04:30:29", "text": "もし私が少しだけ飲んだら、もし私が飲みすぎたら。それで"}, {"type": "subtitle", "time": 16232.269, "timestamp": "04:30:32", "text": "待って"}, {"type": "subtitle", "time": 16239.87, "timestamp": "04:30:39", "text": "やってください"}, {"type": "subtitle", "time": 16255.229, "timestamp": "04:30:55", "text": "彼女は実際に配信を終了した。待って、"}, {"type": "subtitle", "time": 16258.389, "timestamp": "04:30:58", "text": "何？いや、彼女は気が狂いかけているんだ。何てことだ、"}]
[{"type": "subtitle", "time": 4564.31, "timestamp": "01:16:04", "text": "アイデアはあるのですが、"}, {"type": "subtitle", "time": 4573.47, "timestamp": "01:16:13", "text": "それ。やりたいです。私は"}, {"type": "subtitle", "time": 4580.47, "timestamp": "01:16:20", "text": "捕獲。よし、やってみるよ。 1つ"}, {"type": "subtitle", "time": 4582.149, "timestamp": "01:16:22", "text": "2番。"}, {"type": "subtitle", "time": 4610.31, "timestamp": "01:16:50", "text": "私は持っていません。持っているかどうかわかりません。"}, {"type": "subtitle", "time": 4612.11, "timestamp": "01:16:52", "text": "えっと"}, {"type": "subtitle", "time": 4614.43, "timestamp": "01:16:54", "text": "プラグイン"}, {"type": "subtitle", "time": 4617.07, "timestamp": "01:16:57", "text": "IO番号"}]
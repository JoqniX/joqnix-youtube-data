[{"type": "subtitle", "time": 10981.19, "timestamp": "03:03:01", "text": "これ。私は話しましたか？"}, {"type": "subtitle", "time": 10983.389, "timestamp": "03:03:03", "text": "皆さん、お元気ですか？"}, {"type": "subtitle", "time": 10986.91, "timestamp": "03:03:06", "text": "うん。皆さん、お元気ですか？"}, {"type": "subtitle", "time": 10996.469, "timestamp": "03:03:16", "text": "良い。それで、今日は、えっと、ちょっと待って、"}, {"type": "subtitle", "time": 10999.79, "timestamp": "03:03:19", "text": "とりあえず今は隠しておこう。何てことだ。"}, {"type": "subtitle", "time": 11002.63, "timestamp": "03:03:22", "text": "待って、とりあえず彼を隠しておこう。"}, {"type": "subtitle", "time": 11005.349, "timestamp": "03:03:25", "text": "はい、どうぞ。こんにちは。では、今日は"}, {"type": "subtitle", "time": 11007.71, "timestamp": "03:03:27", "text": "Needy Streamerをプレイする"}, {"type": "subtitle", "time": 11011.71, "timestamp": "03:03:31", "text": "オーバーロード。とてもかわいい"}, {"type": "subtitle", "time": 11014.309, "timestamp": "03:03:34", "text": "ゲーム。ずっとこれをプレイしたかった"}, {"type": "subtitle", "time": 11015.07, "timestamp": "03:03:35", "text": "ゲーム"}, {"type": "subtitle", "time": 11018.71, "timestamp": "03:03:38", "text": "永遠に。永遠に。でも、それは"}, {"type": "subtitle", "time": 11020.91, "timestamp": "03:03:40", "text": "本当にかわいいかわいい"}, {"type": "subtitle", "time": 11022.91, "timestamp": "03:03:42", "text": "ゲーム。もちろん。"}, {"type": "subtitle", "time": 11026.83, "timestamp": "03:03:46", "text": "もちろん。そして私たちはそれを演奏します"}, {"type": "subtitle", "time": 11030.07, "timestamp": "03:03:50", "text": "今日。それで、"}, {"type": "subtitle", "time": 11032.389, "timestamp": "03:03:52", "text": "えっと、直させてください、ちびキャラをゲットさせてください"}, {"type": "subtitle", "time": 11035.349, "timestamp": "03:03:55", "text": "順位を上げる。しばらくぶり"}, {"type": "subtitle", "time": 11038.15, "timestamp": "03:03:58", "text": "ちびジョッキーを使ったことありますよね？では、"}]
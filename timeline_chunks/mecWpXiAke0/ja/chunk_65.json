[{"type": "subtitle", "time": 3900.109, "timestamp": "01:05:00", "text": "デスクトップオーディオ、"}, {"type": "subtitle", "time": 3903.15, "timestamp": "01:05:03", "text": "すべては"}, {"type": "subtitle", "time": 3906.87, "timestamp": "01:05:06", "text": "悪い。それは良くないことだ。でも大丈夫。私は持っている"}, {"type": "subtitle", "time": 3907.789, "timestamp": "01:05:07", "text": "1"}, {"type": "subtitle", "time": 3911.069, "timestamp": "01:05:11", "text": "アイデア。私は自分の全体をルーティングする必要があります"}, {"type": "subtitle", "time": 3913.91, "timestamp": "01:05:13", "text": "もの。だから、私は自分の全てをやり直さなければならない。"}, {"type": "subtitle", "time": 3922.63, "timestamp": "01:05:22", "text": "[音楽]"}, {"type": "subtitle", "time": 3927.029, "timestamp": "01:05:27", "text": "でも、うん、うん、私たちは生きている。私はそうは思わない"}, {"type": "subtitle", "time": 3929.789, "timestamp": "01:05:29", "text": "たくさんの人が来るでしょう"}, {"type": "subtitle", "time": 3933.67, "timestamp": "01:05:33", "text": "だって、最近ここで活動してなかったから。しかし"}, {"type": "subtitle", "time": 3935.67, "timestamp": "01:05:35", "text": "ええ、今、信念の流れがここにあります"}, {"type": "subtitle", "time": 3937.99, "timestamp": "01:05:37", "text": "今から先は。だから私はワクワクしています"}, {"type": "subtitle", "time": 3941.95, "timestamp": "01:05:41", "text": "これはうまくいくでしょう。しかし、問題は"}, {"type": "subtitle", "time": 3947.39, "timestamp": "01:05:47", "text": "私のPCは苦労するだろうから"}, {"type": "subtitle", "time": 3950.349, "timestamp": "01:05:50", "text": "多くの。それは私が"}, {"type": "subtitle", "time": 3952.829, "timestamp": "01:05:52", "text": "心配した。"}]
[{"type": "subtitle", "time": 19983.31, "timestamp": "05:33:03", "text": "祝福を、"}, {"type": "subtitle", "time": 19987.43, "timestamp": "05:33:07", "text": "祝福あれ、祝福あれ。ストリーミング配信していただきありがとうございます"}, {"type": "subtitle", "time": 19989.03, "timestamp": "05:33:09", "text": "今日もまた配信します。ありがとう"}, {"type": "subtitle", "time": 19990.83, "timestamp": "05:33:10", "text": "再び"}, {"type": "subtitle", "time": 19995.548, "timestamp": "05:33:15", "text": "ストリーム。はぁ？彼女にとって16回目の誕生日です"}, {"type": "subtitle", "time": 19997.39, "timestamp": "05:33:17", "text": "ストリームまたは"}, {"type": "subtitle", "time": 20007.03, "timestamp": "05:33:27", "text": "おお。もし私が微笑んで魂をすり潰したら"}, {"type": "subtitle", "time": 20008.708, "timestamp": "05:33:28", "text": "救済があれば、私は笑顔でい続ける"}, {"type": "subtitle", "time": 20022.628, "timestamp": "05:33:42", "text": "全員を救うことは約束できない。"}, {"type": "subtitle", "time": 20025.75, "timestamp": "05:33:45", "text": "それは嘘だろう。しかし、もし一人が"}, {"type": "subtitle", "time": 20028.07, "timestamp": "05:33:48", "text": "私の人によって救われることができるなら、私は"}, {"type": "subtitle", "time": 20030.43, "timestamp": "05:33:50", "text": "聞く価値のある"}, {"type": "subtitle", "time": 20034.19, "timestamp": "05:33:54", "text": "インターネット。これを見てください。それで"}, {"type": "subtitle", "time": 20035.708, "timestamp": "05:33:55", "text": "かわいい。"}, {"type": "subtitle", "time": 20038.788, "timestamp": "05:33:58", "text": "もしそれが好きになれたら、"}]
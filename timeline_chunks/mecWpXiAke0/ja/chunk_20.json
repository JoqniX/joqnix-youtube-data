[{"type": "subtitle", "time": 1214.51, "timestamp": "00:20:14", "text": "設定。これらは何ですか"}, {"type": "subtitle", "time": 1217.029, "timestamp": "00:20:17", "text": "設定？ハードウェアエンコーディング。デフォルト"}, {"type": "subtitle", "time": 1220.71, "timestamp": "00:20:20", "text": "ハードウェアエンコーディング。チーン。 Do I は何ですか?"}, {"type": "subtitle", "time": 1222.19, "timestamp": "00:20:22", "text": "しなければならない"}, {"type": "subtitle", "time": 1242.39, "timestamp": "00:20:42", "text": "[音楽]"}, {"type": "subtitle", "time": 1244.95, "timestamp": "00:20:44", "text": "これは配信では公開しません。さあ"}, {"type": "subtitle", "time": 1248.39, "timestamp": "00:20:48", "text": "行く。今はビリービリーのセットアップがあります"}, {"type": "subtitle", "time": 1253.71, "timestamp": "00:20:53", "text": "私のプロセスはどうですか？"}, {"type": "subtitle", "time": 1257.43, "timestamp": "00:20:57", "text": "何をしているの？ああ、私はストリーミングしていません。"}]
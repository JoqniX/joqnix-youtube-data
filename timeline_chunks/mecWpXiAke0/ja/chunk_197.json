[{"type": "subtitle", "time": 11820.309, "timestamp": "03:17:00", "text": "わかった。なんてこった。削除するにはどうすればいいですか？"}, {"type": "subtitle", "time": 11835.03, "timestamp": "03:17:15", "text": "私は毎晩愛し合い、癒やした"}, {"type": "subtitle", "time": 11838.87, "timestamp": "03:17:18", "text": "インターネット上にはそういう情報がある。私は"}, {"type": "subtitle", "time": 11842.389, "timestamp": "03:17:22", "text": "私の声と私の持ち物で人々を癒す"}, {"type": "subtitle", "time": 11847.93, "timestamp": "03:17:27", "text": "日。シェアしてください"}, {"type": "subtitle", "time": 11853.229, "timestamp": "03:17:33", "text": "[音楽]"}, {"type": "subtitle", "time": 11855.75, "timestamp": "03:17:35", "text": "お願いします。さあ、今度はそれを私たちに見せてください。"}, {"type": "subtitle", "time": 11860.55, "timestamp": "03:17:40", "text": "いや、違う。後退してください。後退してください。後退してください。"}, {"type": "subtitle", "time": 11862.15, "timestamp": "03:17:42", "text": "新しいものにそんなことをしてはいけません"}, {"type": "subtitle", "time": 11863.229, "timestamp": "03:17:43", "text": "ストリーマー。"}, {"type": "subtitle", "time": 11865.75, "timestamp": "03:17:45", "text": "わかった。新しいストリームに対しては、そんなことはしてはいけません。"}, {"type": "subtitle", "time": 11869.389, "timestamp": "03:17:49", "text": "わかった。自分で自分をぶつけてしまった。バック"}, {"type": "subtitle", "time": 11872.229, "timestamp": "03:17:52", "text": "上。これがモデレーターのやり方だ。わかった。"}, {"type": "subtitle", "time": 11874.71, "timestamp": "03:17:54", "text": "彼らはチャットを見て、読んで、"}, {"type": "subtitle", "time": 11877.229, "timestamp": "03:17:57", "text": "悪いコメントなどを削除してください。"}]
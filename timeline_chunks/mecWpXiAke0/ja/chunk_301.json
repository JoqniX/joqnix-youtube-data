[{"type": "subtitle", "time": 18077.27, "timestamp": "05:01:17", "text": "[音楽]"}, {"type": "subtitle", "time": 18079.43, "timestamp": "05:01:19", "text": "それについて話し合うべき仕事がある"}, {"type": "subtitle", "time": 18087.67, "timestamp": "05:01:27", "text": "仕事。ああ、またか。おめでとうございます、"}, {"type": "subtitle", "time": 18104.31, "timestamp": "05:01:44", "text": "売り切れ？今日はこれをやります。私は"}, {"type": "subtitle", "time": 18106.07, "timestamp": "05:01:46", "text": "ここにたどり着くつもりだ。ああ、彼女は"}, {"type": "subtitle", "time": 18119.27, "timestamp": "05:01:59", "text": "[音楽]"}]
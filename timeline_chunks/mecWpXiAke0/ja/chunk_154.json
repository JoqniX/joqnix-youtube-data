[{"type": "subtitle", "time": 9245.15, "timestamp": "02:34:05", "text": "神。でも私はまだ配信したい"}, {"type": "subtitle", "time": 9264.71, "timestamp": "02:34:24", "text": "いらっしゃいませ。こんにちは。私は今から行くところです"}, {"type": "subtitle", "time": 9277.03, "timestamp": "02:34:37", "text": "テスト中。シングルで、もし私ができるなら"}, {"type": "subtitle", "time": 9280.429, "timestamp": "02:34:40", "text": "マルチリーミングしながらゲーム配信を行う"}, {"type": "subtitle", "time": 9284.55, "timestamp": "02:34:44", "text": "ビリーへ。問題は、私がしなければならないのは、"}, {"type": "subtitle", "time": 9287.15, "timestamp": "02:34:47", "text": "少しラグがあるけど"}, {"type": "subtitle", "time": 9290.19, "timestamp": "02:34:50", "text": "ゲーム。ええ、少し動作が重いですね。"}, {"type": "subtitle", "time": 9295.67, "timestamp": "02:34:55", "text": "はい、それは私がやりたかったことではありません"}, {"type": "subtitle", "time": 9298.79, "timestamp": "02:34:58", "text": "ビリー・ビリーへの直接マルチストリーミングですが"}]
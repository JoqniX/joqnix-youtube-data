[{"type": "subtitle", "time": 18549.23, "timestamp": "05:09:09", "text": "[音楽]"}, {"type": "subtitle", "time": 18552.628, "timestamp": "05:09:12", "text": "よし、これは彼女にとって開かれたものだ。待って、もしかしたら私は"}, {"type": "subtitle", "time": 18555.03, "timestamp": "05:09:15", "text": "待つべきだ。コメントを見たい"}, {"type": "subtitle", "time": 18558.628, "timestamp": "05:09:18", "text": "またしてもくだらないこと。多分"}, {"type": "subtitle", "time": 18560.55, "timestamp": "05:09:20", "text": "彼女は他のことに関しては全てうまくやっている"}, {"type": "subtitle", "time": 18563.11, "timestamp": "05:09:23", "text": "彼女について。はぁ？なぜ？なぜ"}, {"type": "subtitle", "time": 18565.83, "timestamp": "05:09:25", "text": "否定的なコメント？何？よし、私のストレス"}, {"type": "subtitle", "time": 18567.83, "timestamp": "05:09:27", "text": "レベルが上がると、気が狂いそうになる。だから私は"}, {"type": "subtitle", "time": 18568.91, "timestamp": "05:09:28", "text": "すべき"}, {"type": "subtitle", "time": 18578.99, "timestamp": "05:09:38", "text": "72を推測します。"}, {"type": "subtitle", "time": 18587.75, "timestamp": "05:09:47", "text": "悪い。私はまず自分の特別なものを見つけて、"}, {"type": "subtitle", "time": 18589.27, "timestamp": "05:09:49", "text": "彼らと共にその瞬間を迎える。私たちは泳ぐことができます"}, {"type": "subtitle", "time": 18591.31, "timestamp": "05:09:51", "text": "一緒に氷"}, {"type": "subtitle", "time": 18594.91, "timestamp": "05:09:54", "text": "まずクリームを塗ってから、"}, {"type": "subtitle", "time": 18598.75, "timestamp": "05:09:58", "text": "ああ、なんてことだ、"}]
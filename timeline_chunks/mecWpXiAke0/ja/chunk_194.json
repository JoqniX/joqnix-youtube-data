[{"type": "subtitle", "time": 11640.229, "timestamp": "03:14:00", "text": "親切なあなたは、この中で唯一の人です"}, {"type": "subtitle", "time": 11641.51, "timestamp": "03:14:01", "text": "私のことを理解し、支えてくれる。あなたは私の"}, {"type": "subtitle", "time": 11643.83, "timestamp": "03:14:03", "text": "真実の愛はただ一つ。私もプロデューサーが好きです"}, {"type": "subtitle", "time": 11649.269, "timestamp": "03:14:09", "text": "ぴったりです。うん。こんにちは。お元気ですか"}, {"type": "subtitle", "time": 11652.229, "timestamp": "03:14:12", "text": "今日？挨拶するのを忘れていたのは分かっています"}, {"type": "subtitle", "time": 11654.19, "timestamp": "03:14:14", "text": "アディタもそうだ。"}, {"type": "subtitle", "time": 11657.229, "timestamp": "03:14:17", "text": "うん。お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 11660.63, "timestamp": "03:14:20", "text": "いいえ。はい。君は私と同じくらい頭がいいね。それで"}, {"type": "subtitle", "time": 11662.71, "timestamp": "03:14:22", "text": "あなたは私を導いてくれるでしょう。私に指示してください"}, {"type": "subtitle", "time": 11664.349, "timestamp": "03:14:24", "text": "何でも。私がやります。"}, {"type": "subtitle", "time": 11667.269, "timestamp": "03:14:27", "text": "マヤ・カサンさん、こんにちは。元気ですか"}, {"type": "subtitle", "time": 11669.07, "timestamp": "03:14:29", "text": "今日？お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 11672.15, "timestamp": "03:14:32", "text": "良い。いらっしゃいませ。さあ、やろう。やろう"}, {"type": "subtitle", "time": 11673.429, "timestamp": "03:14:33", "text": "これ。さあ、やろう。さあ、やろう。"}, {"type": "subtitle", "time": 11675.19, "timestamp": "03:14:35", "text": "さあ、やろう。さあ、やろう。やろう"}, {"type": "subtitle", "time": 11677.429, "timestamp": "03:14:37", "text": "これ。さあ、やろう。さあ、やろう。"}, {"type": "subtitle", "time": 11678.83, "timestamp": "03:14:38", "text": "やろう"}, {"type": "subtitle", "time": 11681.75, "timestamp": "03:14:41", "text": "これ。何てことだ。私はできません。する必要がある"}, {"type": "subtitle", "time": 11687.03, "timestamp": "03:14:47", "text": "水。私のメイク、いい感じ。私のVに乗って。"}, {"type": "subtitle", "time": 11695.429, "timestamp": "03:14:55", "text": "つまり、これがその人のIR（情報処理）上の自己像です。私"}, {"type": "subtitle", "time": 11697.91, "timestamp": "03:14:57", "text": "彼女の名前を忘れてしまった。彼女は"}]
[{"type": "subtitle", "time": 3345.19, "timestamp": "00:55:45", "text": "我一直想找回"}, {"type": "subtitle", "time": 3347.91, "timestamp": "00:55:47", "text": "童年時的那種感覺，但就是"}, {"type": "subtitle", "time": 3350.71, "timestamp": "00:55:50", "text": "找不到。  我心想：「哇哦。["}, {"type": "subtitle", "time": 3353.19, "timestamp": "00:55:53", "text": "音樂][笑聲]["}, {"type": "subtitle", "time": 3355.51, "timestamp": "00:55:55", "text": "音樂] 水晶覆蓋。祝你帖子不走運"}, {"type": "subtitle", "time": 3358.15, "timestamp": "00:55:58", "text": "。你畫得真好。臉。太可愛了。"}]
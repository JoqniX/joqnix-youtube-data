[{"type": "subtitle", "time": 21312.948, "timestamp": "05:55:12", "text": "我想我現在可以聽到自己的聲音了。不錯。哦，嗨。好的。"}, {"type": "subtitle", "time": 21321.43, "timestamp": "05:55:21", "text": "所以，我需要邀請你，對吧？"}, {"type": "subtitle", "time": 21328.31, "timestamp": "05:55:28", "text": "[音樂]"}, {"type": "subtitle", "time": 21336.23, "timestamp": "05:55:36", "text": "我想沒事了。我想沒事了"}, {"type": "subtitle", "time": 21339.27, "timestamp": "05:55:39", "text": "。我其實呃，不小心把"}, {"type": "subtitle", "time": 21345.27, "timestamp": "05:55:45", "text": "沒事了。"}, {"type": "subtitle", "time": 21347.51, "timestamp": "05:55:47", "text": "歡迎回來，九頭蛇。我們"}, {"type": "subtitle", "time": 21349.67, "timestamp": "05:55:49", "text": "正式開始了。我要走了，耽誤你們"}, {"type": "subtitle", "time": 21353.83, "timestamp": "05:55:53", "text": "30分鐘了。這"}]
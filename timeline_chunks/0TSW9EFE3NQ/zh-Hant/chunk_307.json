[{"type": "subtitle", "time": 18427.91, "timestamp": "05:07:07", "text": "餵。餵。餵。餵。這就是它的名字。誰更高？是的。你多高？我多高？我忘了我的身高。"}, {"type": "subtitle", "time": 18470.07, "timestamp": "05:07:50", "text": "我"}, {"type": "subtitle", "time": 18472.55, "timestamp": "05:07:52", "text": "想我也忘了我的身高。我想大概161左右吧。"}, {"type": "subtitle", "time": 18474.948, "timestamp": "05:07:54", "text": "我不知道。 161。是的。 161"}, {"type": "subtitle", "time": 18477.19, "timestamp": "05:07:57", "text": "左右。嗯。是的。我的身高差不多。嗯。哦，我們差不多。嗯。約翰是不是拿你的屁股寫了首說唱"}]
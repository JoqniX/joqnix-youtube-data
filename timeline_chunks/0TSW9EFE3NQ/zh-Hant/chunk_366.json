[{"type": "subtitle", "time": 21976.31, "timestamp": "06:06:16", "text": "你害怕嗎？你……你害怕了嗎？對不起……我的天哪。嘿，快點。快點。我們走吧。我"}, {"type": "subtitle", "time": 21983.67, "timestamp": "06:06:23", "text": "會跟著你。我不知道。 [音樂]不要快跑，求你了。我害怕。快走。 [笑聲] 哇。"}, {"type": "subtitle", "time": 21988.628, "timestamp": "06:06:28", "text": "哦，天哪。等等，好像……哦，天哪。看著我。看著我"}, {"type": "subtitle", "time": 21997.43, "timestamp": "06:06:37", "text": "。看著我。好吧。這太"}, {"type": "subtitle", "time": 22003.11, "timestamp": "06:06:43", "text": "嚇人了。這太嚇人了，"}]
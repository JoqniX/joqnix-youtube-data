[{"type": "subtitle", "time": 9661.75, "timestamp": "02:41:01", "text": "呃，是這個吧"}, {"type": "subtitle", "time": 9664.15, "timestamp": "02:41:04", "text": "？好的。戰鬥老兵。  我把它命名為“賭注之戰”。  加入。好的。另一台服務器。好的。呃，好吧，我做到了。  什麼？不。好的，我同意。"}, {"type": "subtitle", "time": 9674.71, "timestamp": "02:41:14", "text": "呃，斧頭。好的，好的，這是什麼？"}, {"type": "subtitle", "time": 9687.99, "timestamp": "02:41:27", "text": "呃，計劃。等等，讓"}, {"type": "subtitle", "time": 9690.15, "timestamp": "02:41:30", "text": "我先把這個關掉"}, {"type": "subtitle", "time": 9692.309, "timestamp": "02:41:32", "text": "。制定拆"}, {"type": "subtitle", "time": 9694.15, "timestamp": "02:41:34", "text": "彈計劃。哦，地圖由你來選。好的。好的。  所有車輛。好的。"}, {"type": "subtitle", "time": 9703.429, "timestamp": "02:41:43", "text": "奪旗。  好的。這很"}, {"type": "subtitle", "time": 9714.07, "timestamp": "02:41:54", "text": "有意思。  谷。好的，"}, {"type": "subtitle", "time": 9718.07, "timestamp": "02:41:58", "text": "讓我來繪製地圖。  好的，那我這就來繪製地圖。連接成功。我的天啊。我們"}]
[{"type": "subtitle", "time": 21723.75, "timestamp": "06:02:03", "text": "不。是的"}, {"type": "subtitle", "time": 21726.47, "timestamp": "06:02:06", "text": "。再見。"}, {"type": "subtitle", "time": 21731.99, "timestamp": "06:02:11", "text": "等等，等等。我想"}, {"type": "subtitle", "time": 21738.39, "timestamp": "06:02:18", "text": "我們應該找到彼此。天哪。天哪。是啊"}, {"type": "subtitle", "time": 21740.628, "timestamp": "06:02:20", "text": "，因為我孤單一人。它有控制鍵嗎？滑鼠控制，WS 互動鍵是 E，跑步是左 Shift"}, {"type": "subtitle", "time": 21742.788, "timestamp": "06:02:22", "text": "。我需要我的東西，因為我們是語音聊天。它也有語音聊天功能。口哨是 G。互動鍵是跑 Shift 加蹲伏。"}, {"type": "subtitle", "time": 21746.948, "timestamp": "06:02:26", "text": "我想"}, {"type": "subtitle", "time": 21758.548, "timestamp": "06:02:38", "text": "改一下。收音機手電筒。它也有手電筒。哦"}]
[{"type": "subtitle", "time": 21601.43, "timestamp": "06:00:01", "text": "一個禿頭女白領。禿頭白領。沒穿"}, {"type": "subtitle", "time": 21614.39, "timestamp": "06:00:14", "text": "外套。 [音樂] 我會…這是什麼？完整的萬聖節活動？哦，你會得到……我會"}, {"type": "subtitle", "time": 21625.11, "timestamp": "06:00:25", "text": "扮演一個無家可歸的人。等等，你"}, {"type": "subtitle", "time": 21637.19, "timestamp": "06:00:37", "text": "確定嗎？我們能玩Switch嗎？不，不，不。我會扮演一個無家可歸的"}, {"type": "subtitle", "time": 21640.868, "timestamp": "06:00:40", "text": "男人。嗨，夥計。你"}, {"type": "subtitle", "time": 21653.99, "timestamp": "06:00:53", "text": "準備好了嗎？看起來像"}]
[{"type": "subtitle", "time": 18559.59, "timestamp": "05:09:19", "text": "我更高。我知道。我知道。我知道。那你呢"}, {"type": "subtitle", "time": 18561.99, "timestamp": "05:09:21", "text": "，娜迦？"}, {"type": "subtitle", "time": 18576.23, "timestamp": "05:09:36", "text": "等等。 16米。我都不知道。等等。我覺得5英尺3英寸（5'3）就是160厘米，5英尺4英寸（5'4）就是163厘米。我不太確定。我不知道。我不知道我是不是更高。是的，更高。可是為什麼我的"}, {"type": "subtitle", "time": 18582.55, "timestamp": "05:09:42", "text": "頭這麼大？"}, {"type": "subtitle", "time": 18599.83, "timestamp": "05:09:59", "text": "我一直搞不懂。看看你的頭。你的頭那麼"}]
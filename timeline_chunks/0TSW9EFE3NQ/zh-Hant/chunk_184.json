[{"type": "subtitle", "time": 11050.07, "timestamp": "03:04:10", "text": "任何人上床。  那好吧。邦哈默。"}, {"type": "subtitle", "time": 11051.59, "timestamp": "03:04:11", "text": "我"}, {"type": "subtitle", "time": 11055.429, "timestamp": "03:04:15", "text": "敲打著樹。  等待。你不能。我可以收集日誌，我正在和這個人一起玩《戰地M2》，好的。"}, {"type": "subtitle", "time": 11058.87, "timestamp": "03:04:18", "text": "哦，這真是快速的雙殺。"}, {"type": "subtitle", "time": 11072.79, "timestamp": "03:04:32", "text": "好的。  我的天啊。  你好，"}, {"type": "subtitle", "time": 11086.87, "timestamp": "03:04:46", "text": "隊友。  它們就像一個O。等等，讓我看看你的……等等，讓我看看。等等，好像是上校之類的。  你好"}]
[{"type": "subtitle", "time": 21003.35, "timestamp": "05:50:03", "text": "電腦。所以我媽就買了這台筆記型電腦給我。挺好的。嗯。是"}, {"type": "subtitle", "time": 21006.07, "timestamp": "05:50:06", "text": "啊，很"}, {"type": "subtitle", "time": 21012.23, "timestamp": "05:50:12", "text": "長一段時間我都沒有筆記型電腦，也沒有桌上型電腦。嗯。是"}, {"type": "subtitle", "time": 21022.628, "timestamp": "05:50:22", "text": "啊。好了。還剩3MB。我的天。完成了。快完成了。我的天。走吧。你呢？你"}, {"type": "subtitle", "time": 21031.11, "timestamp": "05:50:31", "text": "玩遊戲嗎？以後打算"}, {"type": "subtitle", "time": 21033.99, "timestamp": "05:50:33", "text": "玩什麼遊戲嗎？嗯，是的。我還沒在直播裡玩過賽車"}, {"type": "subtitle", "time": 21040.31, "timestamp": "05:50:40", "text": "遊戲，所以我想試試看。什麼遊戲？就是"}, {"type": "subtitle", "time": 21048.548, "timestamp": "05:50:48", "text": "那種我還沒玩過的賽車遊戲。賽車遊戲？哦，好的。好的。那你還想玩其他什麼遊戲嗎？哦，有。有一個。呃，藍色協議。我一直在等這個。藍色協定。哦，對。它就像一個大型多人線上角色扮演遊戲。哦，好的。那是我妹妹打來的。"}]
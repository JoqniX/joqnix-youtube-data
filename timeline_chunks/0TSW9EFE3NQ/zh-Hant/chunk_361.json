[{"type": "subtitle", "time": 21663.67, "timestamp": "06:01:03", "text": "我的供應商。你好嗎？今天不太好。"}, {"type": "subtitle", "time": 21674.39, "timestamp": "06:01:14", "text": "走吧。走吧。我是一個無家可歸的男人。它升起來了。這是什麼？我像個白領。我在一個……什麼？這是什麼？我在微軟Excel銷售。"}, {"type": "subtitle", "time": 21688.23, "timestamp": "06:01:28", "text": "我在辦公室睡著了。我打呼嚕的聲音好大。什麼？我是一個打呼很大聲的可愛女孩。哇。音量可以嗎"}, {"type": "subtitle", "time": 21696.548, "timestamp": "06:01:36", "text": "？我"}, {"type": "subtitle", "time": 21705.51, "timestamp": "06:01:45", "text": "醒來時發現自己在某個地方。這是什麼"}, {"type": "subtitle", "time": 21709.67, "timestamp": "06:01:49", "text": "？我也醒來時發現自己在某個地方。"}, {"type": "subtitle", "time": 21717.27, "timestamp": "06:01:57", "text": "我當時在外面跑。等一下。"}]
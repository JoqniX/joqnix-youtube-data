[{"type": "subtitle", "time": 10020.71, "timestamp": "02:47:00", "text": "你的直播一切順利"}, {"type": "subtitle", "time": 10035.99, "timestamp": "02:47:15", "text": "。  希望你今天過得"}, {"type": "subtitle", "time": 10053.429, "timestamp": "02:47:33", "text": "愉快。  謝謝你們的光臨。  看看這個積木。  哦，那隻是一小截。  好吧，我被管理了。  我甚至不敢開槍。"}, {"type": "subtitle", "time": 10058.389, "timestamp": "02:47:38", "text": "我該試著把他拖走嗎？  必須拖拽"}, {"type": "subtitle", "time": 10061.67, "timestamp": "02:47:41", "text": "。  好的，我試著拖動了一下。"}, {"type": "subtitle", "time": 10063.51, "timestamp": "02:47:43", "text": "我拖著他們。  我們走吧。哦，他沒事。  謝謝。  擊殺一人。總共"}, {"type": "subtitle", "time": 10078.71, "timestamp": "02:47:58", "text": "擊殺兩人。"}]
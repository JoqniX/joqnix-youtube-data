[{"type": "subtitle", "time": 22443.51, "timestamp": "06:14:03", "text": "怎麼辦？哦，那裡有個門。那裡有個閘門。是的。我的天哪。我的天哪。我應該習慣一下。是的。"}, {"type": "subtitle", "time": 22449.27, "timestamp": "06:14:09", "text": "哦，天哪。好的。"}, {"type": "subtitle", "time": 22456.548, "timestamp": "06:14:16", "text": "我想這才是真正的……我的天哪。這才是真正的後室。哦"}, {"type": "subtitle", "time": 22461.99, "timestamp": "06:14:21", "text": "不。好的。一。好的。一。"}, {"type": "subtitle", "time": 22466.15, "timestamp": "06:14:26", "text": "四。一。 14。一。 4 02 03 63 63 14142 63 H"}, {"type": "subtitle", "time": 22474.708, "timestamp": "06:14:34", "text": "密碼"}, {"type": "subtitle", "time": 22494.84, "timestamp": "06:14:54", "text": "是什麼？我不知道。我在電梯裡。"}]
[{"type": "subtitle", "time": 13636.87, "timestamp": "03:47:16", "text": "我至少需要一個便宜的滑鼠來做點什麼。好的。"}, {"type": "subtitle", "time": 13639.11, "timestamp": "03:47:19", "text": "救命。他們會來救我嗎？看看那"}, {"type": "subtitle", "time": 13645.51, "timestamp": "03:47:25", "text": "我們試試看。好吧，救援怎麼來了？謝謝大家。他們都死了。我要被拖走了嗎？等等"}, {"type": "subtitle", "time": 13665.99, "timestamp": "03:47:45", "text": "。糖果。他有顆星"}, {"type": "subtitle", "time": 13668.389, "timestamp": "03:47:48", "text": "。讓他走吧。哦。爆頭。我的天哪。紅色雷射。好的，"}, {"type": "subtitle", "time": 13674.389, "timestamp": "03:47:54", "text": "我在解鎖東西。啊，滑鼠。滑鼠。"}]
[{"type": "subtitle", "time": 10687.83, "timestamp": "02:58:07", "text": "我的"}, {"type": "subtitle", "time": 10692.469, "timestamp": "02:58:12", "text": "天，這遊戲跟《"}, {"type": "subtitle", "time": 10715.429, "timestamp": "02:58:35", "text": "哦，是"}, {"type": "subtitle", "time": 10718.23, "timestamp": "02:58:38", "text": "的。我認為"}, {"type": "subtitle", "time": 10720.07, "timestamp": "02:58:40", "text": "你可以。不，我覺得"}, {"type": "subtitle", "time": 10731.91, "timestamp": "02:58:51", "text": "你不能。我不知道。  他媽的。  把他救活了。  是的。  挑挑挑。"}]
[{"type": "subtitle", "time": 20900.868, "timestamp": "05:48:20", "text": "走吧。我"}, {"type": "subtitle", "time": 20904.868, "timestamp": "05:48:24", "text": "看過你玩《狂野飆車》。是的，我玩過《狂野"}, {"type": "subtitle", "time": 20906.708, "timestamp": "05:48:26", "text": "飆車》，但後來我有點……"}, {"type": "subtitle", "time": 20908.548, "timestamp": "05:48:28", "text": "你知道，有點玩膩了。嗯。"}, {"type": "subtitle", "time": 20919.75, "timestamp": "05:48:39", "text": "所以，我就不玩了。是的。那麼，你玩過速度遊戲嗎？"}, {"type": "subtitle", "time": 20925.03, "timestamp": "05:48:45", "text": "快節奏的遊戲。沒有，《極速快感：競速》。我小時候玩過。我玩過。 《"}]
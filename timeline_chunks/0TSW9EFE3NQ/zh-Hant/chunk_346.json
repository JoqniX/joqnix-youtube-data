[{"type": "subtitle", "time": 20782.23, "timestamp": "05:46:22", "text": "哦，不。照顧好自己。沒事的。他的腳踝很粗。照顧好他。那些是軟男孩。硬男孩是我。我的天哪。不。那我是個硬男孩。我們來做一些調查。"}, {"type": "subtitle", "time": 20792.708, "timestamp": "05:46:32", "text": "不。等等。"}, {"type": "subtitle", "time": 20802.23, "timestamp": "05:46:42", "text": "我的"}, {"type": "subtitle", "time": 20804.948, "timestamp": "05:46:44", "text": "天哪。不。所以，是的。有沒有什麼……有沒有什麼你期待在未來玩的遊戲？"}, {"type": "subtitle", "time": 20807.27, "timestamp": "05:46:47", "text": "有沒有什麼我"}, {"type": "subtitle", "time": 20808.708, "timestamp": "05:46:48", "text": "期待未來玩的遊戲？我不知道。我不知道。我真的很想玩。 [音樂]讓我想想。我想我知道"}]
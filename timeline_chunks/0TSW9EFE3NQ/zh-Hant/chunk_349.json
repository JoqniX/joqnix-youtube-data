[{"type": "subtitle", "time": 20943.35, "timestamp": "05:49:03", "text": "極速快感》。我也是。是的，"}, {"type": "subtitle", "time": 20946.708, "timestamp": "05:49:06", "text": "我當時玩過。"}, {"type": "subtitle", "time": 20967.19, "timestamp": "05:49:27", "text": "我當時有一台桌上型電腦，就像我有一台PC，但我把它裝在裡面了。但是，是的，在……之後嗯，"}, {"type": "subtitle", "time": 20979.43, "timestamp": "05:49:39", "text": "我覺得我的桌上型電腦壞了，然後我爸把顯示器、CPU什麼的都帶去他單位了，然後我就沒電腦用了，"}, {"type": "subtitle", "time": 20988.47, "timestamp": "05:49:48", "text": "你知道，後來我買了台筆記型電腦。嗯，"}, {"type": "subtitle", "time": 20997.35, "timestamp": "05:49:57", "text": "我想是因為我當時正在上一個圖形設計課，所以需要一台筆記型"}]
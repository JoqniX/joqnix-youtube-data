[{"type": "subtitle", "time": 14590.309, "timestamp": "04:03:10", "text": "。拿著。我的手雷都沒從手中飛出去。哦，我被拖到安全的地方了。但他"}, {"type": "subtitle", "time": 14599.11, "timestamp": "04:03:19", "text": "死了。拖我的人死了。哦。我不干了。實際上，我要進入鐵血模式。這太痛苦了。問題是滑鼠。"}, {"type": "subtitle", "time": 14614.71, "timestamp": "04:03:34", "text": "看到了嗎？哦，"}, {"type": "subtitle", "time": 14634.469, "timestamp": "04:03:54", "text": "天哪，我的滑鼠。拜託，我是職業選手"}]
[{"type": "subtitle", "time": 20161.03, "timestamp": "05:36:01", "text": "什么？据我所知，他们"}, {"type": "subtitle", "time": 20164.07, "timestamp": "05:36:04", "text": "发布了很多主题相似的“后室”游戏"}, {"type": "subtitle", "time": 20168.23, "timestamp": "05:36:08", "text": "。等等，真的吗？"}, {"type": "subtitle", "time": 20169.99, "timestamp": "05:36:09", "text": "哦，等等，让我查一下。我想他们确实发布了"}, {"type": "subtitle", "time": 20171.43, "timestamp": "05:36:11", "text": "。我想他们确实发布了。"}, {"type": "subtitle", "time": 20175.19, "timestamp": "05:36:15", "text": "我不确定"}, {"type": "subtitle", "time": 20178.15, "timestamp": "05:36:18", "text": "这是否属实。让我看看。让我"}, {"type": "subtitle", "time": 20181.91, "timestamp": "05:36:21", "text": "看看。“后室”游戏。"}, {"type": "subtitle", "time": 20184.788, "timestamp": "05:36:24", "text": "“工作”。这是什么？是的，有很多"}, {"type": "subtitle", "time": 20187.03, "timestamp": "05:36:27", "text": "东西。很多。“后室”"}, {"type": "subtitle", "time": 20189.27, "timestamp": "05:36:29", "text": "游戏。“进入后室”。"}, {"type": "subtitle", "time": 20192.628, "timestamp": "05:36:32", "text": "1998年的“后室”。“后室降临”恐怖"}, {"type": "subtitle", "time": 20195.35, "timestamp": "05:36:35", "text": "游戏。“后室在线”。"}, {"type": "subtitle", "time": 20198.788, "timestamp": "05:36:38", "text": "在线。“后室在线”。不。“后室”"}, {"type": "subtitle", "time": 20201.35, "timestamp": "05:36:41", "text": "3D恐怖游戏。“后室”。“后"}, {"type": "subtitle", "time": 20203.27, "timestamp": "05:36:43", "text": "室计划”。“后"}, {"type": "subtitle", "time": 20205.99, "timestamp": "05:36:45", "text": "室”。“现实的后室”。“后"}, {"type": "subtitle", "time": 20208.948, "timestamp": "05:36:48", "text": "室世界”。进入后室。有"}, {"type": "subtitle", "time": 20211.75, "timestamp": "05:36:51", "text": "多少款游戏？“后室"}, {"type": "subtitle", "time": 20214.628, "timestamp": "05:36:54", "text": "异常”恐怖游戏。“后室逃脱”。“"}, {"type": "subtitle", "time": 20216.708, "timestamp": "05:36:56", "text": "后室之外的后室”"}]
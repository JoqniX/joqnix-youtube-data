[{"type": "subtitle", "time": 21062.548, "timestamp": "05:51:02", "text": "坏了，然后我爸把"}, {"type": "subtitle", "time": 21066.39, "timestamp": "05:51:06", "text": "显示器、"}, {"type": "subtitle", "time": 21069.91, "timestamp": "05:51:09", "text": "CPU什么的都带去他单位了，然后我就没电脑用了，"}, {"type": "subtitle", "time": 21076.15, "timestamp": "05:51:16", "text": "你知道，后来我买了台笔记本电脑"}, {"type": "subtitle", "time": 21081.91, "timestamp": "05:51:21", "text": "。嗯，我想是因为我当时在"}, {"type": "subtitle", "time": 21083.51, "timestamp": "05:51:23", "text": "上一个图形设计课，所以"}, {"type": "subtitle", "time": 21086.31, "timestamp": "05:51:26", "text": "需要一台笔记本电脑。所以我妈"}, {"type": "subtitle", "time": 21090.948, "timestamp": "05:51:30", "text": "就给我买了这台笔记本电脑。挺好的。嗯。"}, {"type": "subtitle", "time": 21092.948, "timestamp": "05:51:32", "text": "是啊，很长一段时间我都没有"}, {"type": "subtitle", "time": 21095.59, "timestamp": "05:51:35", "text": "笔记本电脑，也没有台式机。"}, {"type": "subtitle", "time": 21097.27, "timestamp": "05:51:37", "text": "嗯。是啊。"}, {"type": "subtitle", "time": 21099.91, "timestamp": "05:51:39", "text": "好了。还剩3MB。我的天。"}, {"type": "subtitle", "time": 21101.43, "timestamp": "05:51:41", "text": "完成了。快完成了。我的天。"}, {"type": "subtitle", "time": 21104.31, "timestamp": "05:51:44", "text": "走吧。你呢？你玩游戏吗？"}, {"type": "subtitle", "time": 21105.99, "timestamp": "05:51:45", "text": "你以后打算玩什么游戏吗"}, {"type": "subtitle", "time": 21108.628, "timestamp": "05:51:48", "text": "？嗯，是的。我还没"}, {"type": "subtitle", "time": 21111.67, "timestamp": "05:51:51", "text": "在直播里玩过赛车游戏"}, {"type": "subtitle", "time": 21114.548, "timestamp": "05:51:54", "text": "，所以我想试试。"}, {"type": "subtitle", "time": 21117.67, "timestamp": "05:51:57", "text": "什么游戏？就是那种我还没玩过的"}]
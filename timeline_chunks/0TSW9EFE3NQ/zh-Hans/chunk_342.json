[{"type": "subtitle", "time": 20529.83, "timestamp": "05:42:09", "text": "我以后想吃的是吐司"}, {"type": "subtitle", "time": 20532.39, "timestamp": "05:42:12", "text": "。不行不行，不过说真的"}, {"type": "subtitle", "time": 20534.948, "timestamp": "05:42:14", "text": "。我想让我想想我想吃什么"}, {"type": "subtitle", "time": 20541.51, "timestamp": "05:42:21", "text": "我想……"}, {"type": "subtitle", "time": 20547.35, "timestamp": "05:42:27", "text": "你想吃什么？我不知道。我……我什么"}, {"type": "subtitle", "time": 20549.67, "timestamp": "05:42:29", "text": "都吃。我不"}, {"type": "subtitle", "time": 20552.07, "timestamp": "05:42:32", "text": "知道。呃，我不知道。我从来没"}, {"type": "subtitle", "time": 20554.39, "timestamp": "05:42:34", "text": "这样想过。是啊。但"}, {"type": "subtitle", "time": 20556.39, "timestamp": "05:42:36", "text": "现在我刷Instagram或"}, {"type": "subtitle", "time": 20558.868, "timestamp": "05:42:38", "text": "YouTube，看到好多吃的，"}, {"type": "subtitle", "time": 20562.31, "timestamp": "05:42:42", "text": "我就想…… 它们尝起来会像牛排"}, {"type": "subtitle", "time": 20565.11, "timestamp": "05:42:45", "text": "之类的吗？就是那种肉味的，对吧？这是"}, {"type": "subtitle", "time": 20568.31, "timestamp": "05:42:48", "text": "一方面。还有星巴克那些我从来没"}, {"type": "subtitle", "time": 20571.83, "timestamp": "05:42:51", "text": "吃过的东西。还有什么呢？我想，我"}, {"type": "subtitle", "time": 20574.548, "timestamp": "05:42:54", "text": "想说的是，我以后想吃的一样"}, {"type": "subtitle", "time": 20579.27, "timestamp": "05:42:59", "text": "东西，就是那种你知道的“死亡薯片”之类的。你"}]
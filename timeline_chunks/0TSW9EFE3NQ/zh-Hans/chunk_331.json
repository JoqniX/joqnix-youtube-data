[{"type": "subtitle", "time": 19860.708, "timestamp": "05:31:00", "text": "等等。它就像一个真实生活中的"}, {"type": "subtitle", "time": 19864.39, "timestamp": "05:31:04", "text": "事件。哦，不。等等，是吗？"}, {"type": "subtitle", "time": 19867.67, "timestamp": "05:31:07", "text": "我不知道。哦，天哪。它是真实"}, {"type": "subtitle", "time": 19870.23, "timestamp": "05:31:10", "text": "生活中的事件吗？等等。你好。你好。你"}, {"type": "subtitle", "time": 19873.03, "timestamp": "05:31:13", "text": "今天看起来很棒。不，不是。"}, {"type": "subtitle", "time": 19874.788, "timestamp": "05:31:14", "text": "不是。你说过这不是真实生活"}, {"type": "subtitle", "time": 19876.548, "timestamp": "05:31:16", "text": "经历。不，它是 不。好的，很好。"}, {"type": "subtitle", "time": 19879.75, "timestamp": "05:31:19", "text": "很好。所以，去看看Bugly。这是她的"}, {"type": "subtitle", "time": 19882.548, "timestamp": "05:31:22", "text": "频道，她在谈论回归。哦，我明白了。哦，"}, {"type": "subtitle", "time": 19884.07, "timestamp": "05:31:24", "text": "97%。"}, {"type": "subtitle", "time": 19891.59, "timestamp": "05:31:31", "text": "老兄，我没玩过任何恐怖游戏。"}, {"type": "subtitle", "time": 19894.628, "timestamp": "05:31:34", "text": "你觉得你不会觉得用"}, {"type": "subtitle", "time": 19898.23, "timestamp": "05:31:38", "text": "14个原石去抽那四个"}, {"type": "subtitle", "time": 19900.628, "timestamp": "05:31:40", "text": "恐怖角色很傻吗？"}, {"type": "subtitle", "time": 19904.39, "timestamp": "05:31:44", "text": "哦，是的。我给你看看。你抽到了两个。是的，"}, {"type": "subtitle", "time": 19908.628, "timestamp": "05:31:48", "text": "我昨天一次就抽到了两个娜哈。当时"}, {"type": "subtitle", "time": 19911.35, "timestamp": "05:31:51", "text": "很早，而且概率是50/50。昨天发生了很多"}, {"type": "subtitle", "time": 19914.47, "timestamp": "05:31:54", "text": "不应该"}, {"type": "subtitle", "time": 19917.59, "timestamp": "05:31:57", "text": "发生的事情。"}, {"type": "subtitle", "time": 19919.67, "timestamp": "05:31:59", "text": "我的天啊。该死"}]
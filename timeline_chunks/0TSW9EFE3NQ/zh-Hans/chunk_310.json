[{"type": "subtitle", "time": 18601.83, "timestamp": "05:10:01", "text": "。再次感谢你的"}, {"type": "subtitle", "time": 18603.91, "timestamp": "05:10:03", "text": "到来。"}, {"type": "subtitle", "time": 18608.708, "timestamp": "05:10:08", "text": "然后，那位国王今天也来了，"}, {"type": "subtitle", "time": 18614.23, "timestamp": "05:10:14", "text": "谢谢你的到来。"}, {"type": "subtitle", "time": 18617.43, "timestamp": "05:10:17", "text": "希望你今天玩得开心。谢谢你的"}, {"type": "subtitle", "time": 18622.868, "timestamp": "05:10:22", "text": "到来，这对我意义重大。 非常"}, {"type": "subtitle", "time": 18625.03, "timestamp": "05:10:25", "text": "感谢。希望你"}, {"type": "subtitle", "time": 18632.47, "timestamp": "05:10:32", "text": "巴布加油！谢谢巴布沙"}, {"type": "subtitle", "time": 18635.03, "timestamp": "05:10:35", "text": "今天来过，不管你来没来。希望你"}, {"type": "subtitle", "time": 18638.31, "timestamp": "05:10:38", "text": "今天过得愉快。非常感谢。祝你今晚"}, {"type": "subtitle", "time": 18640.39, "timestamp": "05:10:40", "text": "愉快。"}, {"type": "subtitle", "time": 18642.868, "timestamp": "05:10:42", "text": "魔鬼来了。他们把魔鬼"}, {"type": "subtitle", "time": 18646.39, "timestamp": "05:10:46", "text": "沙玛弄来了。希望你"}, {"type": "subtitle", "time": 18649.43, "timestamp": "05:10:49", "text": "今天过得愉快。还有工作上的照片。是的，工作上的照片。"}, {"type": "subtitle", "time": 18653.59, "timestamp": "05:10:53", "text": "你有工作之类的，对吧？夜班"}, {"type": "subtitle", "time": 18657.59, "timestamp": "05:10:57", "text": "工作。我喜欢夜班工作之类的。所以会很"}]
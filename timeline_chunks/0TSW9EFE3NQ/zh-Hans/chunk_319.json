[{"type": "subtitle", "time": 19173.03, "timestamp": "05:19:33", "text": "[音乐]"}, {"type": "subtitle", "time": 19175.99, "timestamp": "05:19:35", "text": "耶。大家好。"}, {"type": "subtitle", "time": 19179.83, "timestamp": "05:19:39", "text": "耶。你好。耶。你好。耶。你好。"}, {"type": "subtitle", "time": 19181.75, "timestamp": "05:19:41", "text": "大家今天过得怎么样？希望你们一切都好。"}, {"type": "subtitle", "time": 19190.07, "timestamp": "05:19:50", "text": "好的。我听到自己。"}, {"type": "subtitle", "time": 19195.51, "timestamp": "05:19:55", "text": "今天。今天是个特别的日子。"}, {"type": "subtitle", "time": 19199.67, "timestamp": "05:19:59", "text": "哦，今天是你的特别日子。"}]
[{"type": "subtitle", "time": 19800.948, "timestamp": "05:30:00", "text": "上周和你一起玩的《恐鬼症》之外，我没玩过任何恐怖游戏。"}, {"type": "subtitle", "time": 19805.91, "timestamp": "05:30:05", "text": "是啊，我也是。但我最近才"}, {"type": "subtitle", "time": 19807.67, "timestamp": "05:30:07", "text": "开始玩恐怖游戏，因为"}, {"type": "subtitle", "time": 19809.75, "timestamp": "05:30:09", "text": "万圣节。"}, {"type": "subtitle", "time": 19811.91, "timestamp": "05:30:11", "text": "我不知道。我不知道为什么人们会觉得"}, {"type": "subtitle", "time": 19814.15, "timestamp": "05:30:14", "text": "整个万圣节都应该……"}, {"type": "subtitle", "time": 19815.67, "timestamp": "05:30:15", "text": "好吧。是啊，我的意思是 它很符合"}, {"type": "subtitle", "time": 19818.39, "timestamp": "05:30:18", "text": "美学。我明白了。"}, {"type": "subtitle", "time": 19820.708, "timestamp": "05:30:20", "text": "我明白了。你好。你好，暴风雨。你好。"}, {"type": "subtitle", "time": 19822.23, "timestamp": "05:30:22", "text": "你好，里默鲁。你好。你好吗？希望"}, {"type": "subtitle", "time": 19824.15, "timestamp": "05:30:24", "text": "你今天过得愉快。后面的房间是"}, {"type": "subtitle", "time": 19826.31, "timestamp": "05:30:26", "text": "我父亲去买牛奶的地方，"}, {"type": "subtitle", "time": 19828.31, "timestamp": "05:30:28", "text": "我在这里想着他会"}, {"type": "subtitle", "time": 19834.868, "timestamp": "05:30:34", "text": "他会回来的。别担心。他会"}, {"type": "subtitle", "time": 19837.67, "timestamp": "05:30:37", "text": "回来的。是的，你只需要等。他"}, {"type": "subtitle", "time": 19839.51, "timestamp": "05:30:39", "text": "会回来的。但是设计"}, {"type": "subtitle", "time": 19843.51, "timestamp": "05:30:43", "text": "完美契合你的个性。耶。"}, {"type": "subtitle", "time": 19845.27, "timestamp": "05:30:45", "text": "我不知道谈论"}, {"type": "subtitle", "time": 19848.788, "timestamp": "05:30:48", "text": "另一个频道是否合适。你什么意思？"}, {"type": "subtitle", "time": 19852.628, "timestamp": "05:30:52", "text": "他会反抗吗？什么？它不完全是一个"}, {"type": "subtitle", "time": 19855.83, "timestamp": "05:30:55", "text": "游戏。嗯，它只是一个故事，"}, {"type": "subtitle", "time": 19859.11, "timestamp": "05:30:59", "text": "游戏是基于它改编的。哦。哦，"}]
[{"type": "subtitle", "time": 19263.51, "timestamp": "05:21:03", "text": "就像如果你……我不知道。哦，这样"}, {"type": "subtitle", "time": 19267.43, "timestamp": "05:21:07", "text": "很好。我看到了。很好。很好。很好。"}, {"type": "subtitle", "time": 19270.08, "timestamp": "05:21:10", "text": "很好。 今天我们玩……哦，你好，Jo。"}, {"type": "subtitle", "time": 19274.16, "timestamp": "05:21:14", "text": "今天我们玩……哦，你好，Jo。 你好。你好。你好。"}, {"type": "subtitle", "time": 19281.75, "timestamp": "05:21:21", "text": "我很好。你好吗？"}, {"type": "subtitle", "time": 19284.31, "timestamp": "05:21:24", "text": "我很好。谢谢你的关心。等等，"}, {"type": "subtitle", "time": 19286.948, "timestamp": "05:21:26", "text": "你能听到他吗？ 好的。他的音量可以吗"}, {"type": "subtitle", "time": 19290.868, "timestamp": "05:21:30", "text": "？我的音量可以吗？可以。"}, {"type": "subtitle", "time": 19292.788, "timestamp": "05:21:32", "text": "音量可以吗？"}, {"type": "subtitle", "time": 19295.03, "timestamp": "05:21:35", "text": "不用告诉我。大家都知道吗？"}, {"type": "subtitle", "time": 19300.15, "timestamp": "05:21:40", "text": "音量可以吗？我觉得可以。可以。喂。喂。喂。"}, {"type": "subtitle", "time": 19304.948, "timestamp": "05:21:44", "text": "喂。这就是它的"}, {"type": "subtitle", "time": 19308.948, "timestamp": "05:21:48", "text": "名字。谁更高？是的。你"}, {"type": "subtitle", "time": 19311.59, "timestamp": "05:21:51", "text": "多高？我多高？我"}, {"type": "subtitle", "time": 19314.23, "timestamp": "05:21:54", "text": "忘了我的身高。我想我也忘了我的身高"}, {"type": "subtitle", "time": 19317.11, "timestamp": "05:21:57", "text": "。我想大概161左右吧。我不"}, {"type": "subtitle", "time": 19318.708, "timestamp": "05:21:58", "text": "知道。161。是的。161左右。"}]
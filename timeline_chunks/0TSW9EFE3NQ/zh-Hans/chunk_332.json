[{"type": "subtitle", "time": 19921.67, "timestamp": "05:32:01", "text": "。"}, {"type": "subtitle", "time": 19925.03, "timestamp": "05:32:05", "text": "就像我的保底好像是48之类的，"}, {"type": "subtitle", "time": 19927.91, "timestamp": "05:32:07", "text": "然后"}, {"type": "subtitle", "time": 19929.59, "timestamp": "05:32:09", "text": "我就在聊天里解释说，"}, {"type": "subtitle", "time": 19931.67, "timestamp": "05:32:11", "text": "好吧，我不会抽娜哈，"}, {"type": "subtitle", "time": 19934.628, "timestamp": "05:32:14", "text": "因为你知道，我确实想要她，"}, {"type": "subtitle", "time": 19937.59, "timestamp": "05:32:17", "text": "但我是一个零氪玩家，所以我不想把"}, {"type": "subtitle", "time": 19940.868, "timestamp": "05:32:20", "text": "原石花在"}, {"type": "subtitle", "time": 19944.548, "timestamp": "05:32:24", "text": "娜哈身上，因为我想要一个……"}, {"type": "subtitle", "time": 19946.39, "timestamp": "05:32:26", "text": "我刚才还在解释，然后Bacon"}, {"type": "subtitle", "time": 19948.708, "timestamp": "05:32:28", "text": "就说，好吧，你知道吗，那就抽10个吧。"}, {"type": "subtitle", "time": 19951.03, "timestamp": "05:32:31", "text": "为贝内特拉。"}, {"type": "subtitle", "time": 19952.31, "timestamp": "05:32:32", "text": "然后我就想，“好吧，你知道吗？"}, {"type": "subtitle", "time": 19955.11, "timestamp": "05:32:35", "text": "我是48 PD。”所以我就想，“好吧，那我抽"}, {"type": "subtitle", "time": 19957.19, "timestamp": "05:32:37", "text": "一次贝内特吧。”然后那十连"}, {"type": "subtitle", "time": 19963.59, "timestamp": "05:32:43", "text": "抽里，我出了两个娜希达和一个贝内特。"}, {"type": "subtitle", "time": 19966.948, "timestamp": "05:32:46", "text": "太棒了，真是史诗级的。我当时"}, {"type": "subtitle", "time": 19971.19, "timestamp": "05:32:51", "text": "就想，“刚才发生了什么？”"}, {"type": "subtitle", "time": 19973.67, "timestamp": "05:32:53", "text": "欢迎回来。所以，真的。真的。真的"}, {"type": "subtitle", "time": 19976.31, "timestamp": "05:32:56", "text": "。真的，它"}, {"type": "subtitle", "time": 19979.43, "timestamp": "05:32:59", "text": "发生了。我的天啊。我又抽到剃刀了。"}]
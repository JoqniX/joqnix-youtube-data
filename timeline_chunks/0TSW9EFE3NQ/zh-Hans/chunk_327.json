[{"type": "subtitle", "time": 19627.51, "timestamp": "05:27:07", "text": "好的。我们开始吧。我知道《后室》（Back Room）。"}, {"type": "subtitle", "time": 19629.27, "timestamp": "05:27:09", "text": "你对《后室》了解多少？说说"}, {"type": "subtitle", "time": 19631.83, "timestamp": "05:27:11", "text": "你对《后室》的了解吧？"}, {"type": "subtitle", "time": 19633.91, "timestamp": "05:27:13", "text": "等等。好的。就我所见，《"}, {"type": "subtitle", "time": 19637.51, "timestamp": "05:27:17", "text": "后室》是一款游戏，你"}, {"type": "subtitle", "time": 19642.868, "timestamp": "05:27:22", "text": "扮演一个上班族，基本上你"}, {"type": "subtitle", "time": 19644.868, "timestamp": "05:27:24", "text": "在上班的时候睡着了，然后你醒来，"}, {"type": "subtitle", "time": 19648.868, "timestamp": "05:27:28", "text": "然后你会想：我这是在哪儿？我的"}, {"type": "subtitle", "time": 19651.51, "timestamp": "05:27:31", "text": "天哪。它有点像迷宫之"}, {"type": "subtitle", "time": 19653.83, "timestamp": "05:27:33", "text": "类的东西。"}, {"type": "subtitle", "time": 19655.51, "timestamp": "05:27:35", "text": "我不知道它到底"}, {"type": "subtitle", "time": 19658.548, "timestamp": "05:27:38", "text": "恐怖在哪里。我不知道。我不知道"}, {"type": "subtitle", "time": 19661.19, "timestamp": "05:27:41", "text": "它是不是比恐同症更恐怖，或者……"}, {"type": "subtitle", "time": 19664.39, "timestamp": "05:27:44", "text": "我希望不是我，因为"}, {"type": "subtitle", "time": 19668.788, "timestamp": "05:27:48", "text": "我看到别人玩的时候，"}, {"type": "subtitle", "time": 19671.51, "timestamp": "05:27:51", "text": "感觉它没那么恐怖。但是那些玩过的人都说"}, {"type": "subtitle", "time": 19675.75, "timestamp": "05:27:55", "text": "它非常恐怖。它就像是"}, {"type": "subtitle", "time": 19677.51, "timestamp": "05:27:57", "text": "最恐怖的。 恐怖游戏之类的"}, {"type": "subtitle", "time": 19679.91, "timestamp": "05:27:59", "text": "。我当时就想：什么？我的"}]
[{"type": "subtitle", "time": 19683.99, "timestamp": "05:28:03", "text": "天。什么？哦不。所以我不知道。我不知道"}, {"type": "subtitle", "time": 19686.39, "timestamp": "05:28:06", "text": "它更像是恐怖游戏，你"}, {"type": "subtitle", "time": 19688.07, "timestamp": "05:28:08", "text": "知道，"}, {"type": "subtitle", "time": 19692.39, "timestamp": "05:28:12", "text": "比恐同症更甚，或者说，我"}, {"type": "subtitle", "time": 19695.27, "timestamp": "05:28:15", "text": "不知道它属于哪一类，也不知道"}, {"type": "subtitle", "time": 19699.59, "timestamp": "05:28:19", "text": "我们会作何反应。哦不，这就是"}, {"type": "subtitle", "time": 19703.27, "timestamp": "05:28:23", "text": "问题所在。结果"}, {"type": "subtitle", "time": 19705.51, "timestamp": "05:28:25", "text": "会怎样？这是个好"}, {"type": "subtitle", "time": 19709.35, "timestamp": "05:28:29", "text": "决定吗？我希望"}, {"type": "subtitle", "time": 19711.51, "timestamp": "05:28:31", "text": "它能成功。"}, {"type": "subtitle", "time": 19713.75, "timestamp": "05:28:33", "text": "前辈，你觉得这游戏怎么样？"}, {"type": "subtitle", "time": 19716.15, "timestamp": "05:28:36", "text": "哦，我。嗯，"}, {"type": "subtitle", "time": 19718.23, "timestamp": "05:28:38", "text": "在横幅图里，对吧，如果你去"}, {"type": "subtitle", "time": 19720.628, "timestamp": "05:28:40", "text": "Steam，右边，有个诡异的"}, {"type": "subtitle", "time": 19722.948, "timestamp": "05:28:42", "text": "脸。那是我最害怕的地方。我"}, {"type": "subtitle", "time": 19726.15, "timestamp": "05:28:46", "text": "没注意到。什么？就像如果你去"}, {"type": "subtitle", "time": 19729.75, "timestamp": "05:28:49", "text": "图书馆版本，"}, {"type": "subtitle", "time": 19732.07, "timestamp": "05:28:52", "text": "横幅图右边有个"}, {"type": "subtitle", "time": 19733.67, "timestamp": "05:28:53", "text": "诡异的……对。对。对。对。"}, {"type": "subtitle", "time": 19736.868, "timestamp": "05:28:56", "text": "哦对。我的天。哦对。我"}, {"type": "subtitle", "time": 19739.03, "timestamp": "05:28:59", "text": "觉得那就是……"}]
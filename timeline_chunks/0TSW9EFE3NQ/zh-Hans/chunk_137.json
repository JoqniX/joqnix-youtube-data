[{"type": "subtitle", "time": 8234.39, "timestamp": "02:17:14", "text": "勇气"}, {"type": "subtitle", "time": 8243.36, "timestamp": "02:17:23", "text": "[音乐]"}, {"type": "subtitle", "time": 8245.949, "timestamp": "02:17:25", "text": "[笑声]"}, {"type": "subtitle", "time": 8261.75, "timestamp": "02:17:41", "text": "最好擅长画画。"}, {"type": "subtitle", "time": 8263.75, "timestamp": "02:17:43", "text": "是的，我也是。"}, {"type": "subtitle", "time": 8265.75, "timestamp": "02:17:45", "text": "要想画好画，你"}, {"type": "subtitle", "time": 8269.03, "timestamp": "02:17:49", "text": "必须坚持不懈。不停地画，不停地"}, {"type": "subtitle", "time": 8278.309, "timestamp": "02:17:58", "text": "你必须画成千上万幅画，"}]
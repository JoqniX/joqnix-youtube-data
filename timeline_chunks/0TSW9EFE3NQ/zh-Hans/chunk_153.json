[{"type": "subtitle", "time": 9180.71, "timestamp": "02:33:00", "text": "明白，每一颗流星都不是"}, {"type": "subtitle", "time": 9184.07, "timestamp": "02:33:04", "text": "结束，而是开始。   这"}, {"type": "subtitle", "time": 9188.469, "timestamp": "02:33:08", "text": "不是告别，而是一份礼物。"}, {"type": "subtitle", "time": 9192.63, "timestamp": "02:33:12", "text": "因为在这浩瀚的宇宙中，每一束光都会"}, {"type": "subtitle", "time": 9196.469, "timestamp": "02:33:16", "text": "留下自己的印记。 每条路都谱写着自己的"}, {"type": "subtitle", "time": 9200.55, "timestamp": "02:33:20", "text": "故事。 每一颗星星都教会我们如何"}, {"type": "subtitle", "time": 9203.19, "timestamp": "02:33:23", "text": "闪耀。"}, {"type": "subtitle", "time": 9206.79, "timestamp": "02:33:26", "text": "所以，让我们为曾经的星辰、"}, {"type": "subtitle", "time": 9209.11, "timestamp": "02:33:29", "text": "曾经的光芒，以及"}, {"type": "subtitle", "time": 9212.07, "timestamp": "02:33:32", "text": "未来将要形成的星座干杯。"}, {"type": "subtitle", "time": 9216.07, "timestamp": "02:33:36", "text": "亲爱的星星们，请继续闪耀吧。 你的光芒已成为"}, {"type": "subtitle", "time": 9220.79, "timestamp": "02:33:40", "text": "我故事的一部分，我希望我的光芒也能成为"}]
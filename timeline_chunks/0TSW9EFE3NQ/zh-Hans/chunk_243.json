[{"type": "subtitle", "time": 14580.71, "timestamp": "04:03:00", "text": "。 现在可以了。"}, {"type": "subtitle", "time": 14583.429, "timestamp": "04:03:03", "text": "未找到该设备。"}, {"type": "subtitle", "time": 14585.269, "timestamp": "04:03:05", "text": "好的，队友。 我"}, {"type": "subtitle", "time": 14587.59, "timestamp": "04:03:07", "text": "现在要离开那里了。 我们要走了。 繁荣。"}, {"type": "subtitle", "time": 14590.309, "timestamp": "04:03:10", "text": "繁荣。 繁荣。 繁荣。"}, {"type": "subtitle", "time": 14599.11, "timestamp": "04:03:19", "text": "希望我死的时候他们能听到我的呼喊。"}, {"type": "subtitle", "time": 14603.11, "timestamp": "04:03:23", "text": "他们称之为杀戮的"}, {"type": "subtitle", "time": 14610.309, "timestamp": "04:03:30", "text": "大家都到齐了。 我的天啊。 瞧瞧"}, {"type": "subtitle", "time": 14614.71, "timestamp": "04:03:34", "text": "这些陌生人，他们想搞事情。"}, {"type": "subtitle", "time": 14616.87, "timestamp": "04:03:36", "text": "瞧瞧。"}, {"type": "subtitle", "time": 14620.13, "timestamp": "04:03:40", "text": "好的。 那是什么？"}, {"type": "subtitle", "time": 14632.309, "timestamp": "04:03:52", "text": "伙计，"}, {"type": "subtitle", "time": 14634.469, "timestamp": "04:03:54", "text": "这更难。 比我想象的要难"}]
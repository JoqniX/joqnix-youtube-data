[{"type": "subtitle", "time": 6485.43, "timestamp": "01:48:05", "text": "我可以许愿提升这个技能。"}, {"type": "subtitle", "time": 6488.629, "timestamp": "01:48:08", "text": "啊，我抽到了苏克罗。"}, {"type": "subtitle", "time": 6490.629, "timestamp": "01:48:10", "text": "给我看看你的账号。跟"}, {"type": "subtitle", "time": 6493.669, "timestamp": "01:48:13", "text": "上次一样。我什么都没做。跟"}, {"type": "subtitle", "time": 6497.27, "timestamp": "01:48:17", "text": "上次一样。不过确实一样"}, {"type": "subtitle", "time": 6508.149, "timestamp": "01:48:28", "text": "哦对了，我的暴击率和暴击伤害"}, {"type": "subtitle", "time": 6511.669, "timestamp": "01:48:31", "text": "变了。以前是110，"}, {"type": "subtitle", "time": 6515.35, "timestamp": "01:48:35", "text": "但是现在不行了，因为大家都想"}, {"type": "subtitle", "time": 6518.95, "timestamp": "01:48:38", "text": "改我的装备。所以现在，"}, {"type": "subtitle", "time": 6521.35, "timestamp": "01:48:41", "text": "呃，大家都想把我的装备改"}, {"type": "subtitle", "time": 6524.55, "timestamp": "01:48:44", "text": "回去，你也一样，还有其他"}, {"type": "subtitle", "time": 6527.03, "timestamp": "01:48:47", "text": "人也一样。"}, {"type": "subtitle", "time": 6537.83, "timestamp": "01:48:57", "text": "我不想刷。你许愿吧。"}]
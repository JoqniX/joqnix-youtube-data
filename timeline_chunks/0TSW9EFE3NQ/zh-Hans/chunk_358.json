[{"type": "subtitle", "time": 21482.31, "timestamp": "05:58:02", "text": "这是什么？这是什么？一个T字头的镜头。一次"}, {"type": "subtitle", "time": 21485.11, "timestamp": "05:58:05", "text": "试镜。我的天哪。不。就像我看起来"}, {"type": "subtitle", "time": 21489.43, "timestamp": "05:58:09", "text": "像个无家可归的人，但实际上我并不无家可归。"}, {"type": "subtitle", "time": 21492.868, "timestamp": "05:58:12", "text": "等等，他就是个无家可归的人。上面确实"}, {"type": "subtitle", "time": 21495.27, "timestamp": "05:58:15", "text": "写了。看看这个。我，我给"}, {"type": "subtitle", "time": 21497.35, "timestamp": "05:58:17", "text": "你看。我给你看。上面确实写了。哦，"}, {"type": "subtitle", "time": 21500.708, "timestamp": "05:58:20", "text": "等等。什么？在哪儿？在哪儿？"}, {"type": "subtitle", "time": 21503.43, "timestamp": "05:58:23", "text": "我当时想，“哦，它说它看到了一个"}, {"type": "subtitle", "time": 21505.83, "timestamp": "05:58:25", "text": "无家可归的人。”他就是个无家可归的人。"}, {"type": "subtitle", "time": 21507.99, "timestamp": "05:58:27", "text": "看看那个。我的天。"}, {"type": "subtitle", "time": 21519.43, "timestamp": "05:58:39", "text": "。这是一个万圣节"}, {"type": "subtitle", "time": 21521.91, "timestamp": "05:58:41", "text": "活动，伙计。现在找到五个蜡烛袋和一个"}, {"type": "subtitle", "time": 21528.628, "timestamp": "05:58:48", "text": "我现在是一个无家可归的女人。"}, {"type": "subtitle", "time": 21531.19, "timestamp": "05:58:51", "text": "这是一个无家可归的女人。这"}, {"type": "subtitle", "time": 21534.15, "timestamp": "05:58:54", "text": "是什么解锁的隐藏"}, {"type": "subtitle", "time": 21536.31, "timestamp": "05:58:56", "text": "结局？哦，好吧。这是一个 解锁"}, {"type": "subtitle", "time": 21537.35, "timestamp": "05:58:57", "text": "角色。"}]
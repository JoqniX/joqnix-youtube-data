[{"type": "subtitle", "time": 9120.79, "timestamp": "02:32:00", "text": "要知道，有些星星注定会成为"}, {"type": "subtitle", "time": 9124.79, "timestamp": "02:32:04", "text": "永恒的星座，而有些星星"}, {"type": "subtitle", "time": 9128.309, "timestamp": "02:32:08", "text": "注定会成为美丽而短暂的"}, {"type": "subtitle", "time": 9131.51, "timestamp": "02:32:11", "text": "瞬间。 在我生命中出现的每一颗星星"}, {"type": "subtitle", "time": 9135.51, "timestamp": "02:32:15", "text": "，你的光芒都至关重要。"}, {"type": "subtitle", "time": 9139.03, "timestamp": "02:32:19", "text": "每一个共同闪耀的瞬间，每一次学习"}, {"type": "subtitle", "time": 9141.99, "timestamp": "02:32:21", "text": "如何发光的教训。"}, {"type": "subtitle", "time": 9146.15, "timestamp": "02:32:26", "text": "我们都由同样的宇宙尘埃构成。"}, {"type": "subtitle", "time": 9148.79, "timestamp": "02:32:28", "text": "然而，我们每个人的"}, {"type": "subtitle", "time": 9152.15, "timestamp": "02:32:32", "text": "成长方式都是独一无二的。"}, {"type": "subtitle", "time": 9155.67, "timestamp": "02:32:35", "text": "有时，我们的人生轨迹会完美契合。"}, {"type": "subtitle", "time": 9159.51, "timestamp": "02:32:39", "text": "有时候，它们注定要分道扬镳。   这"}, {"type": "subtitle", "time": 9163.429, "timestamp": "02:32:43", "text": "就是成为明星的魅力所在。"}, {"type": "subtitle", "time": 9167.349, "timestamp": "02:32:47", "text": "部件分离时，我们不会变暗。 我们学会以"}, {"type": "subtitle", "time": 9171.27, "timestamp": "02:32:51", "text": "不同的方式绽放光芒，创造新的"}, {"type": "subtitle", "time": 9173.27, "timestamp": "02:32:53", "text": "星群。"}, {"type": "subtitle", "time": 9177.11, "timestamp": "02:32:57", "text": "当这一年即将成为回忆时，我逐渐"}]
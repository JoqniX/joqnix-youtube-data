[{"type": "subtitle", "time": 8715.67, "timestamp": "02:25:15", "text": "好了，我回来了。我回来了。呃，我们需要"}, {"type": "subtitle", "time": 8719.03, "timestamp": "02:25:19", "text": "加快速度。我需要加快速度，"}, {"type": "subtitle", "time": 8722.23, "timestamp": "02:25:22", "text": "因为我得赶紧结束。你知道吗？"}, {"type": "subtitle", "time": 8723.83, "timestamp": "02:25:23", "text": "你知道吗？那就这样吧。我现在就先"}, {"type": "subtitle", "time": 8726.389, "timestamp": "02:25:26", "text": "结束了。我们之后会直播原神"}, {"type": "subtitle", "time": 8730.07, "timestamp": "02:25:30", "text": "。好的。第二天。好的。"}, {"type": "subtitle", "time": 8732.23, "timestamp": "02:25:32", "text": "是的，那我们这边结束直播吧"}, {"type": "subtitle", "time": 8735.27, "timestamp": "02:25:35", "text": "。所以，是的。感谢今天到场的各位"}, {"type": "subtitle", "time": 8736.87, "timestamp": "02:25:36", "text": "。今天到场的"}, {"type": "subtitle", "time": 8739.99, "timestamp": "02:25:39", "text": "各位真的非常"}, {"type": "subtitle", "time": 8743.59, "timestamp": "02:25:43", "text": "开心。"}, {"type": "subtitle", "time": 8746.87, "timestamp": "02:25:46", "text": "谢谢Jo昨天和我一起玩，"}, {"type": "subtitle", "time": 8749.27, "timestamp": "02:25:49", "text": "让我和你一起玩。让我"}, {"type": "subtitle", "time": 8752.55, "timestamp": "02:25:52", "text": "和你一起玩。很有趣。"}, {"type": "subtitle", "time": 8754.63, "timestamp": "02:25:54", "text": "所以，是的。"}, {"type": "subtitle", "time": 8757.99, "timestamp": "02:25:57", "text": "嗯，所以，是的，我们今天就到此为止吧"}]
[{"type": "subtitle", "time": 6366.47, "timestamp": "01:46:06", "text": "那我趁这个机会把它升到满"}, {"type": "subtitle", "time": 6368.58, "timestamp": "01:46:08", "text": "级。"}, {"type": "subtitle", "time": 6370.629, "timestamp": "01:46:10", "text": "[音乐]"}, {"type": "subtitle", "time": 6373.43, "timestamp": "01:46:13", "text": "我不知道我会不会用这"}, {"type": "subtitle", "time": 6374.95, "timestamp": "01:46:14", "text": "玩意儿。"}, {"type": "subtitle", "time": 6377.43, "timestamp": "01:46:17", "text": "没关系。"}, {"type": "subtitle", "time": 6380.95, "timestamp": "01:46:20", "text": "好了，现在让我去看看这"}, {"type": "subtitle", "time": 6400.39, "timestamp": "01:46:40", "text": "欢迎来到刷怪的世界。不，我不会"}, {"type": "subtitle", "time": 6402.79, "timestamp": "01:46:42", "text": "刷怪，但我就是"}, {"type": "subtitle", "time": 6405.03, "timestamp": "01:46:45", "text": "想刷一下。"}, {"type": "subtitle", "time": 6409.03, "timestamp": "01:46:49", "text": "慢慢来，我想也行。"}, {"type": "subtitle", "time": 6411.51, "timestamp": "01:46:51", "text": "[音乐]"}, {"type": "subtitle", "time": 6414.709, "timestamp": "01:46:54", "text": "我会把他们升到40级左右。48"}, {"type": "subtitle", "time": 6417.37, "timestamp": "01:46:57", "text": "16。"}]
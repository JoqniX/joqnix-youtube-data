[{"type": "subtitle", "time": 8820.07, "timestamp": "02:27:00", "text": "星空和星空景观是什么。 哦，"}, {"type": "subtitle", "time": 8824.55, "timestamp": "02:27:04", "text": "还有这个。 嗯。   感谢"}, {"type": "subtitle", "time": 8828.55, "timestamp": "02:27:08", "text": "爱德华的到来。 谢谢"}, {"type": "subtitle", "time": 8831.51, "timestamp": "02:27:11", "text": "光临。 希望您也玩得开心"}, {"type": "subtitle", "time": 8834.63, "timestamp": "02:27:14", "text": "。 啊，我开始"}, {"type": "subtitle", "time": 8838.07, "timestamp": "02:27:18", "text": "看Twitch那篇了。 我的错。 米利森"}, {"type": "subtitle", "time": 8840.389, "timestamp": "02:27:20", "text": "今天来了。 时隔许久，埃德·米利桑再次出现"}, {"type": "subtitle", "time": 8842.79, "timestamp": "02:27:22", "text": "。 感谢你的到来，感谢你"}, {"type": "subtitle", "time": 8844.469, "timestamp": "02:27:24", "text": "在聊天中积极参与"}, {"type": "subtitle", "time": 8848.07, "timestamp": "02:27:28", "text": "互动，也感谢你和我交流。是的，这个任务真的很"}, {"type": "subtitle", "time": 8851.11, "timestamp": "02:27:31", "text": "有趣，"}, {"type": "subtitle", "time": 8853.91, "timestamp": "02:27:33", "text": "玩起来也很有意思。 感谢你们"}, {"type": "subtitle", "time": 8856.309, "timestamp": "02:27:36", "text": "此刻陪伴在我身边。 祝你今晚睡个好觉"}, {"type": "subtitle", "time": 8860.389, "timestamp": "02:27:40", "text": "。  Diablo今天过来串门了"}, {"type": "subtitle", "time": 8862.71, "timestamp": "02:27:42", "text": "。 希望您玩得开心，也期待您"}, {"type": "subtitle", "time": 8864.55, "timestamp": "02:27:44", "text": "接下来的一天。"}, {"type": "subtitle", "time": 8868.309, "timestamp": "02:27:48", "text": "赫克也过来串门了"}, {"type": "subtitle", "time": 8870.389, "timestamp": "02:27:50", "text": "。 我希望有一天我们能一起玩战斗"}, {"type": "subtitle", "time": 8873.59, "timestamp": "02:27:53", "text": "奔跑游戏。 不过，祝你今天一切"}, {"type": "subtitle", "time": 8876.309, "timestamp": "02:27:56", "text": "顺利。 过来一下。"}, {"type": "subtitle", "time": 8878.469, "timestamp": "02:27:58", "text": "Snowy今天也来了。 谢谢"}]
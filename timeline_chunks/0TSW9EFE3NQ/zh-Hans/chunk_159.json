[{"type": "subtitle", "time": 9542.389, "timestamp": "02:39:02", "text": "视频编辑器上传时出现了错误。 我用 Dinci Resolve"}, {"type": "subtitle", "time": 9546.07, "timestamp": "02:39:06", "text": "上传我的 YouTube 内容，包括剪辑"}, {"type": "subtitle", "time": 9548.15, "timestamp": "02:39:08", "text": "和直接编辑视频片段等等，"}, {"type": "subtitle", "time": 9550.79, "timestamp": "02:39:10", "text": "但是没有上传成功，"}, {"type": "subtitle", "time": 9552.87, "timestamp": "02:39:12", "text": "所以我不得不手动操作，还要进行"}, {"type": "subtitle", "time": 9555.11, "timestamp": "02:39:15", "text": "剪辑等等。 它有点像个半吊子的东西"}, {"type": "subtitle", "time": 9557.11, "timestamp": "02:39:17", "text": "。   是的"}, {"type": "subtitle", "time": 9560.15, "timestamp": "02:39:20", "text": "。 你好，伙计。"}, {"type": "subtitle", "time": 9562.389, "timestamp": "02:39:22", "text": "希望你一切都好。"}, {"type": "subtitle", "time": 9565.349, "timestamp": "02:39:25", "text": "法力值如何？ 玛娜正在行动。 等等，"}, {"type": "subtitle", "time": 9567.27, "timestamp": "02:39:27", "text": "我给你起的昵称是什么来着？ 我"}, {"type": "subtitle", "time": 9571.11, "timestamp": "02:39:31", "text": "忘了。 宝贝，明天见。"}, {"type": "subtitle", "time": 9574.309, "timestamp": "02:39:34", "text": "我刚才是不是说了“明天”？"}, {"type": "subtitle", "time": 9577.03, "timestamp": "02:39:37", "text": "哦，是的。 我忘了。 我给你起了一个昵称"}, {"type": "subtitle", "time": 9586.15, "timestamp": "02:39:46", "text": "因为我不能叫你，嗯，就像有"}, {"type": "subtitle", "time": 9588.71, "timestamp": "02:39:48", "text": "两个人，一个"}, {"type": "subtitle", "time": 9593.349, "timestamp": "02:39:53", "text": "叫我，另一个叫我，所以我"}, {"type": "subtitle", "time": 9595.27, "timestamp": "02:39:55", "text": "不能用那两个昵称，那是他们"}, {"type": "subtitle", "time": 9597.99, "timestamp": "02:39:57", "text": "两个人的专属昵称，所以"}]
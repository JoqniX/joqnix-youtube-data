[{"type": "subtitle", "time": 20040.948, "timestamp": "05:34:00", "text": "是吗？嗯。"}, {"type": "subtitle", "time": 20042.628, "timestamp": "05:34:02", "text": "如何在不更新的情况下强制打开这个"}, {"type": "subtitle", "time": 20052.23, "timestamp": "05:34:12", "text": "要是淋浴功能正常就好了。"}, {"type": "subtitle", "time": 20054.708, "timestamp": "05:34:14", "text": "等等，你是什么时候更新的？我是说"}, {"type": "subtitle", "time": 20057.51, "timestamp": "05:34:17", "text": "，我是什么时候更新的？我……"}, {"type": "subtitle", "time": 20061.19, "timestamp": "05:34:21", "text": "好吧，我3点开始准备。"}, {"type": "subtitle", "time": 20065.03, "timestamp": "05:34:25", "text": "哦，3点。哦，3点。我不知道。我"}, {"type": "subtitle", "time": 20067.11, "timestamp": "05:34:27", "text": "只是有点焦虑，万一出了"}, {"type": "subtitle", "time": 20069.43, "timestamp": "05:34:29", "text": "什么事怎么办？所以，我最好"}, {"type": "subtitle", "time": 20073.03, "timestamp": "05:34:33", "text": "提前做好准备。是的。所以，我"}, {"type": "subtitle", "time": 20076.15, "timestamp": "05:34:36", "text": "觉得我花了很长时间"}, {"type": "subtitle", "time": 20080.548, "timestamp": "05:34:40", "text": "才更新，不知道为什么。"}, {"type": "subtitle", "time": 20082.15, "timestamp": "05:34:42", "text": "大概花了10到15"}, {"type": "subtitle", "time": 20084.948, "timestamp": "05:34:44", "text": "分钟吧。 好吧。我们可以"}, {"type": "subtitle", "time": 20087.67, "timestamp": "05:34:47", "text": "等。"}, {"type": "subtitle", "time": 20091.27, "timestamp": "05:34:51", "text": "哦，我或许可以看看你玩玩。"}, {"type": "subtitle", "time": 20093.03, "timestamp": "05:34:53", "text": "也许吧，我不知道。不，不，不。我不会一个人"}, {"type": "subtitle", "time": 20096.708, "timestamp": "05:34:56", "text": "玩。"}, {"type": "subtitle", "time": 20098.788, "timestamp": "05:34:58", "text": "所以，我们一起去，一起受苦"}]
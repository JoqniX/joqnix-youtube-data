[{"type": "subtitle", "time": 9060.389, "timestamp": "02:31:00", "text": "但我相信，"}, {"type": "subtitle", "time": 9063.429, "timestamp": "02:31:03", "text": "群星之间正在谱写着故事。"}, {"type": "subtitle", "time": 9067.11, "timestamp": "02:31:07", "text": "在我的星座中，我看到许多"}, {"type": "subtitle", "time": 9070.389, "timestamp": "02:31:10", "text": "星星划过天际。 某些耀眼"}, {"type": "subtitle", "time": 9073.27, "timestamp": "02:31:13", "text": "夺目的光影永远地改变了我眼中的天空"}, {"type": "subtitle", "time": 9075.51, "timestamp": "02:31:15", "text": "。"}, {"type": "subtitle", "time": 9079.429, "timestamp": "02:31:19", "text": "还有一些人就像默默无闻的光芒，指引我找到"}, {"type": "subtitle", "time": 9082.15, "timestamp": "02:31:22", "text": "新的闪光点。   他们"}, {"type": "subtitle", "time": 9085.429, "timestamp": "02:31:25", "text": "每个人都教会了我一些关于我"}, {"type": "subtitle", "time": 9088.07, "timestamp": "02:31:28", "text": "自身光芒的道理。"}, {"type": "subtitle", "time": 9091.83, "timestamp": "02:31:31", "text": "有流星划过夜空的季节，"}, {"type": "subtitle", "time": 9095.11, "timestamp": "02:31:35", "text": "看着熟悉的星光"}, {"type": "subtitle", "time": 9098.95, "timestamp": "02:31:38", "text": "划过天空，开辟新的轨迹，领悟到"}, {"type": "subtitle", "time": 9102.71, "timestamp": "02:31:42", "text": "有时最耀眼的时刻，"}, {"type": "subtitle", "time": 9105.99, "timestamp": "02:31:45", "text": "教会我们如何以"}, {"type": "subtitle", "time": 9107.51, "timestamp": "02:31:47", "text": "不同的方式闪耀。"}, {"type": "subtitle", "time": 9111.03, "timestamp": "02:31:51", "text": "或许你也曾目睹过你的星辰"}, {"type": "subtitle", "time": 9114.469, "timestamp": "02:31:54", "text": "改变轨迹，感受过"}, {"type": "subtitle", "time": 9118.15, "timestamp": "02:31:58", "text": "地狱与离别之间光年的沉重。"}]
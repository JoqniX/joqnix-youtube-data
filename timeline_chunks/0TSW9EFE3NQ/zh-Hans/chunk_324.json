[{"type": "subtitle", "time": 19443.75, "timestamp": "05:24:03", "text": "你说得对。我不知道。"}, {"type": "subtitle", "time": 19447.35, "timestamp": "05:24:07", "text": "我感觉有点像……呃，我……呃，我在"}, {"type": "subtitle", "time": 19450.31, "timestamp": "05:24:10", "text": "嚼我"}, {"type": "subtitle", "time": 19455.11, "timestamp": "05:24:15", "text": "爸给我买的太妃糖，说是润喉的。"}, {"type": "subtitle", "time": 19457.75, "timestamp": "05:24:17", "text": "所以不知道为什么，我的口水一直在流"}, {"type": "subtitle", "time": 19459.75, "timestamp": "05:24:19", "text": "。"}, {"type": "subtitle", "time": 19461.51, "timestamp": "05:24:21", "text": "嘿，沙卡，"}, {"type": "subtitle", "time": 19465.67, "timestamp": "05:24:25", "text": "没事的。我想知道这次我们是不是也会大喊大叫，"}, {"type": "subtitle", "time": 19467.91, "timestamp": "05:24:27", "text": "或者……是的，今天我们"}, {"type": "subtitle", "time": 19471.51, "timestamp": "05:24:31", "text": "在后台演出。这是一个非常……这"}, {"type": "subtitle", "time": 19473.11, "timestamp": "05:24:33", "text": "是一个决定。我们没想那么多"}, {"type": "subtitle", "time": 19474.948, "timestamp": "05:24:34", "text": "。我们当时就想，“好吧，你知道吗？"}, {"type": "subtitle", "time": 19477.67, "timestamp": "05:24:37", "text": "我们要玩了。”"}, {"type": "subtitle", "time": 19480.39, "timestamp": "05:24:40", "text": "然后我们就玩了。是的。老实说，我不"}, {"type": "subtitle", "time": 19481.83, "timestamp": "05:24:41", "text": "知道你期待什么。我从来没"}, {"type": "subtitle", "time": 19485.67, "timestamp": "05:24:45", "text": "玩过任何密室逃脱游戏。"}, {"type": "subtitle", "time": 19487.43, "timestamp": "05:24:47", "text": "呃，你玩过吗？你"}, {"type": "subtitle", "time": 19489.59, "timestamp": "05:24:49", "text": "玩过吗？没有。从来没有。这是我第一次玩"}, {"type": "subtitle", "time": 19491.59, "timestamp": "05:24:51", "text": "。没有，从来没有。"}, {"type": "subtitle", "time": 19494.15, "timestamp": "05:24:54", "text": "我也是第一次玩。但是，就……哦，对了"}, {"type": "subtitle", "time": 19496.628, "timestamp": "05:24:56", "text": "。我身高54。哦，好的。好的。是的。"}]
[{"type": "subtitle", "time": 18660.948, "timestamp": "05:11:00", "text": "痛苦，但祝你好运。你能行的"}, {"type": "subtitle", "time": 18669.59, "timestamp": "05:11:09", "text": "。然后萨卡玛来了。我的天哪。我"}, {"type": "subtitle", "time": 18673.11, "timestamp": "05:11:13", "text": "好久没在聊天里看到樱了。"}, {"type": "subtitle", "time": 18676.15, "timestamp": "05:11:16", "text": "只有一次。不，我猜是两只眼睛。但是，是的"}, {"type": "subtitle", "time": 18680.47, "timestamp": "05:11:20", "text": "，谢谢樱来过"}, {"type": "subtitle", "time": 18683.03, "timestamp": "05:11:23", "text": "。"}, {"type": "subtitle", "time": 18684.788, "timestamp": "05:11:24", "text": "哦对了，你也应该试试这个。这是"}, {"type": "subtitle", "time": 18687.35, "timestamp": "05:11:27", "text": "一个很棒的FPS游戏，"}, {"type": "subtitle", "time": 18689.19, "timestamp": "05:11:29", "text": "你可以用你的声音之类的，"}, {"type": "subtitle", "time": 18690.948, "timestamp": "05:11:30", "text": "你可以听到其他人说话"}, {"type": "subtitle", "time": 18692.55, "timestamp": "05:11:32", "text": "等等。"}, {"type": "subtitle", "time": 18695.91, "timestamp": "05:11:35", "text": "它看起来更像是一个像素"}, {"type": "subtitle", "time": 18699.99, "timestamp": "05:11:39", "text": "游戏，或者像Roblox。"}, {"type": "subtitle", "time": 18708.47, "timestamp": "05:11:48", "text": "[音乐]"}, {"type": "subtitle", "time": 18711.91, "timestamp": "05:11:51", "text": "然后"}, {"type": "subtitle", "time": 18715.27, "timestamp": "05:11:55", "text": "忍者今天来了。忍者"}]
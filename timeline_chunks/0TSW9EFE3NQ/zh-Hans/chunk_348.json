[{"type": "subtitle", "time": 20881.99, "timestamp": "05:48:01", "text": "温柔又温暖的硬汉男孩吗？有温暖的男孩吗？"}, {"type": "subtitle", "time": 20885.43, "timestamp": "05:48:05", "text": "温暖的男孩。有冷酷的男孩吗？"}, {"type": "subtitle", "time": 20894.23, "timestamp": "05:48:14", "text": "尖锐男孩。什么？"}, {"type": "subtitle", "time": 20897.51, "timestamp": "05:48:17", "text": "什么？  63. H 软男孩擦拭。是的。"}, {"type": "subtitle", "time": 20900.868, "timestamp": "05:48:20", "text": "拜托。他是个椭圆形男孩。是的。"}, {"type": "subtitle", "time": 20904.868, "timestamp": "05:48:24", "text": "我只听过他一次。是的。"}, {"type": "subtitle", "time": 20906.708, "timestamp": "05:48:26", "text": "硬男孩不适合家庭观看。他是个"}, {"type": "subtitle", "time": 20908.548, "timestamp": "05:48:28", "text": "软男孩。你是个软男孩。大家"}, {"type": "subtitle", "time": 20915.51, "timestamp": "05:48:35", "text": "哦，天哪。今天我刚洗完澡。就像"}, {"type": "subtitle", "time": 20919.75, "timestamp": "05:48:39", "text": "男孩向我们展示的那样。所以我扭伤了"}, {"type": "subtitle", "time": 20922.708, "timestamp": "05:48:42", "text": "脚踝。"}, {"type": "subtitle", "time": 20925.03, "timestamp": "05:48:45", "text": "严重扭伤。啊。哦，不。"}, {"type": "subtitle", "time": 20927.03, "timestamp": "05:48:47", "text": "照顾好自己。没事的。他的"}, {"type": "subtitle", "time": 20935.03, "timestamp": "05:48:55", "text": "照顾好他。"}]
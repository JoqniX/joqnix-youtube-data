[{"type": "subtitle", "time": 9780.23, "timestamp": "02:43:00", "text": "但是在我的 Windows 系统中，它的频率被"}, {"type": "subtitle", "time": 9784.71, "timestamp": "02:43:04", "text": "限制在了 266MHz，"}, {"type": "subtitle", "time": 9790.95, "timestamp": "02:43:10", "text": "这就是问题所在。 我当时想，为什么会这样？"}, {"type": "subtitle", "time": 9794.79, "timestamp": "02:43:14", "text": "怎么可能行不通？ 到底"}, {"type": "subtitle", "time": 9797.11, "timestamp": "02:43:17", "text": "是怎么回事？ 等等，为什么游戏"}, {"type": "subtitle", "time": 9799.75, "timestamp": "02:43:19", "text": "启动不了？ 你好吗"}, {"type": "subtitle", "time": 9804.71, "timestamp": "02:43:24", "text": "？"}, {"type": "subtitle", "time": 9807.67, "timestamp": "02:43:27", "text": "哦，什么？ 什么？ 游戏在哪儿？ 不是"}, {"type": "subtitle", "time": 9809.52, "timestamp": "02:43:29", "text": "lonz。"}, {"type": "subtitle", "time": 9811.03, "timestamp": "02:43:31", "text": "[音乐]"}, {"type": "subtitle", "time": 9813.67, "timestamp": "02:43:33", "text": "我的天哪。 你在开玩笑吧？ 哦，找到了"}, {"type": "subtitle", "time": 9815.349, "timestamp": "02:43:35", "text": "。"}, {"type": "subtitle", "time": 9825.51, "timestamp": "02:43:45", "text": "走吧。 这里的声音是谁？"}, {"type": "subtitle", "time": 9827.83, "timestamp": "02:43:47", "text": "希望我的音频和其他一切都正常"}, {"type": "subtitle", "time": 9829.75, "timestamp": "02:43:49", "text": "。"}, {"type": "subtitle", "time": 9832.79, "timestamp": "02:43:52", "text": "我这里没有任何过滤器之类的东西"}, {"type": "subtitle", "time": 9836.95, "timestamp": "02:43:56", "text": "。 它基本上就是一个"}]
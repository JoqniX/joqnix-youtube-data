[{"type": "subtitle", "time": 20464.868, "timestamp": "05:41:04", "text": "我不知道。现在，叫你的朋友"}, {"type": "subtitle", "time": 20467.99, "timestamp": "05:41:07", "text": "乔伊。 对，你可以叫他Joki。"}, {"type": "subtitle", "time": 20470.23, "timestamp": "05:41:10", "text": "目标：活下去，找到出路。"}, {"type": "subtitle", "time": 20472.708, "timestamp": "05:41:12", "text": "这就是目标。"}, {"type": "subtitle", "time": 20474.31, "timestamp": "05:41:14", "text": "除了活下去之外，后面的房间里没有其他目标，那里有"}, {"type": "subtitle", "time": 20482.47, "timestamp": "05:41:22", "text": "这看起来真"}, {"type": "subtitle", "time": 20483.99, "timestamp": "05:41:23", "text": "不错。"}, {"type": "subtitle", "time": 20485.75, "timestamp": "05:41:25", "text": "不过，你"}, {"type": "subtitle", "time": 20488.868, "timestamp": "05:41:28", "text": "以后有没有什么想吃但以前没吃过的东西"}, {"type": "subtitle", "time": 20490.548, "timestamp": "05:41:30", "text": "？有没有"}, {"type": "subtitle", "time": 20494.39, "timestamp": "05:41:34", "text": "什么我以后想吃但"}, {"type": "subtitle", "time": 20497.99, "timestamp": "05:41:37", "text": "以前没吃过的东西？"}, {"type": "subtitle", "time": 20507.75, "timestamp": "05:41:47", "text": "绫。"}, {"type": "subtitle", "time": 20519.35, "timestamp": "05:41:59", "text": "？（笑）他想了好一会儿才想起来"}]
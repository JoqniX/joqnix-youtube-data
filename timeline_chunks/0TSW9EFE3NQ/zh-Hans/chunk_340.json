[{"type": "subtitle", "time": 20401.35, "timestamp": "05:40:01", "text": "根本出不去，对吧"}, {"type": "subtitle", "time": 20403.19, "timestamp": "05:40:03", "text": "？"}, {"type": "subtitle", "time": 20406.948, "timestamp": "05:40:06", "text": "或者说，你能出去多远？你怎么办？"}, {"type": "subtitle", "time": 20409.51, "timestamp": "05:40:09", "text": "面包。你好，布拉德。你好。祝你"}, {"type": "subtitle", "time": 20412.15, "timestamp": "05:40:12", "text": "今天过得愉快。你的朋友是"}, {"type": "subtitle", "time": 20416.15, "timestamp": "05:40:16", "text": "谁？什么？好的。上午好，"}, {"type": "subtitle", "time": 20427.91, "timestamp": "05:40:27", "text": "是的，你可以叫我骑师。是的，你"}, {"type": "subtitle", "time": 20430.708, "timestamp": "05:40:30", "text": "会叫他。"}, {"type": "subtitle", "time": 20432.948, "timestamp": "05:40:32", "text": "谁会叫我骑师？这是"}, {"type": "subtitle", "time": 20435.99, "timestamp": "05:40:35", "text": "一个迷宫。哦，这是一个迷宫。"}, {"type": "subtitle", "time": 20437.83, "timestamp": "05:40:37", "text": "你只要把它们插进去。我猜最后会有一个"}, {"type": "subtitle", "time": 20440.548, "timestamp": "05:40:40", "text": "肉桂卷。什么是"}, {"type": "subtitle", "time": 20442.15, "timestamp": "05:40:42", "text": "肉桂卷？我不知道什么是"}, {"type": "subtitle", "time": 20444.708, "timestamp": "05:40:44", "text": "肉桂卷。嗯，是的。我还听说"}, {"type": "subtitle", "time": 20446.788, "timestamp": "05:40:46", "text": "过……那是什么？那是什么？它是一种"}, {"type": "subtitle", "time": 20450.39, "timestamp": "05:40:50", "text": "甜面包之类的东西吗？什么是"}, {"type": "subtitle", "time": 20452.948, "timestamp": "05:40:52", "text": "肉桂卷？我的意思是，它是"}, {"type": "subtitle", "time": 20455.99, "timestamp": "05:40:55", "text": "你吃的东西，但是就像人们说，“哦，"}, {"type": "subtitle", "time": 20458.15, "timestamp": "05:40:58", "text": "这个人是……什么是肉桂"}]
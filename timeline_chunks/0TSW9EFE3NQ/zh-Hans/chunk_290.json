[{"type": "subtitle", "time": 17416.47, "timestamp": "04:50:16", "text": "扮演游戏里的家伙"}, {"type": "subtitle", "time": 17419.67, "timestamp": "04:50:19", "text": "真的。哇。"}, {"type": "subtitle", "time": 17427.75, "timestamp": "04:50:27", "text": "我的手雷都没从手里飞出去"}, {"type": "subtitle", "time": 17441.19, "timestamp": "04:50:41", "text": "我被拖到安全的地方了。但他"}, {"type": "subtitle", "time": 17445.99, "timestamp": "04:50:45", "text": "死了。拖我的人死了。"}, {"type": "subtitle", "time": 17459.27, "timestamp": "04:50:59", "text": "我不干了。实际上，我要"}]
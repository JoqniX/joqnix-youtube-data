[{"type": "subtitle", "time": 13741.99, "timestamp": "03:49:01", "text": "侧训练。 我拿到了一支手电筒。 好的。"}, {"type": "subtitle", "time": 13744.07, "timestamp": "03:49:04", "text": "有趣的。"}, {"type": "subtitle", "time": 13747.349, "timestamp": "03:49:07", "text": "我还有什么其他东西？ 主要设备。 我"}, {"type": "subtitle", "time": 13749.349, "timestamp": "03:49:09", "text": "解锁了什么东西。"}, {"type": "subtitle", "time": 13750.71, "timestamp": "03:49:10", "text": "阔剑地雷。 好的，我要带上"}, {"type": "subtitle", "time": 13752.469, "timestamp": "03:49:12", "text": "阔剑地雷。"}, {"type": "subtitle", "time": 13756.63, "timestamp": "03:49:16", "text": "自杀 C4。 好吧，那就用阔剑地雷吧。"}, {"type": "subtitle", "time": 13759.59, "timestamp": "03:49:19", "text": "部署。"}, {"type": "subtitle", "time": 13761.51, "timestamp": "03:49:21", "text": "我要部署了。"}, {"type": "subtitle", "time": 13764.71, "timestamp": "03:49:24", "text": "哦，我有手电筒。 哦，"}, {"type": "subtitle", "time": 13768.55, "timestamp": "03:49:28", "text": "战术手电筒。 好的。"}, {"type": "subtitle", "time": 13772.55, "timestamp": "03:49:32", "text": "这是一位日本人。 我"}, {"type": "subtitle", "time": 13775.189, "timestamp": "03:49:35", "text": "连字都看不懂。 看不见。 有人在"}, {"type": "subtitle", "time": 13777.429, "timestamp": "03:49:37", "text": "说话。 哦，是班长在讲话。"}, {"type": "subtitle", "time": 13788.15, "timestamp": "03:49:48", "text": "有人在我身上生成的程序员。 好的。"}, {"type": "subtitle", "time": 13791.51, "timestamp": "03:49:51", "text": "我有一个bong bong锤子。 我是个混蛋，我可以和"}, {"type": "subtitle", "time": 13793.83, "timestamp": "03:49:53", "text": "任何人上床。   那"}, {"type": "subtitle", "time": 13798.63, "timestamp": "03:49:58", "text": "好吧。 邦哈默。 我敲打着树。"}]
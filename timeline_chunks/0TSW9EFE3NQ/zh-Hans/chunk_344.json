[{"type": "subtitle", "time": 20648.948, "timestamp": "05:44:08", "text": "。天堂。他有好多"}, {"type": "subtitle", "time": 20651.75, "timestamp": "05:44:11", "text": "角色。他有Yolan。他有他有他"}, {"type": "subtitle", "time": 20655.43, "timestamp": "05:44:15", "text": "有Ryan。他有Ayaka。他有Timoo。"}, {"type": "subtitle", "time": 20661.51, "timestamp": "05:44:21", "text": "买了肉桂卷。我"}, {"type": "subtitle", "time": 20665.19, "timestamp": "05:44:25", "text": "只会说“喂”。你别谈论"}, {"type": "subtitle", "time": 20668.548, "timestamp": "05:44:28", "text": "肉桂卷。他是，他是"}, {"type": "subtitle", "time": 20673.51, "timestamp": "05:44:33", "text": "所有肉桂卷之王，如果我这么认为的话。"}, {"type": "subtitle", "time": 20675.91, "timestamp": "05:44:35", "text": "不，你是"}, {"type": "subtitle", "time": 20677.75, "timestamp": "05:44:37", "text": "肉桂卷。不，我不是。我不是"}, {"type": "subtitle", "time": 20684.868, "timestamp": "05:44:44", "text": "致命芯片。是的。致命芯片。"}, {"type": "subtitle", "time": 20689.67, "timestamp": "05:44:49", "text": "上帝是。是的。是的。Ayato"}, {"type": "subtitle", "time": 20691.91, "timestamp": "05:44:51", "text": "。"}, {"type": "subtitle", "time": 20696.548, "timestamp": "05:44:56", "text": "哦，天哪。呃 还剩10MB。还剩10MB。快点"}]
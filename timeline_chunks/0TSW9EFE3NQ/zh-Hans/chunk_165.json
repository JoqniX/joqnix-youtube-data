[{"type": "subtitle", "time": 9901.349, "timestamp": "02:45:01", "text": "Discord 账号都连接上了。 呃，我以前从没玩过"}, {"type": "subtitle", "time": 9903.67, "timestamp": "02:45:03", "text": "这个游戏。 那么，让我们去"}, {"type": "subtitle", "time": 9905.59, "timestamp": "02:45:05", "text": "射击场"}, {"type": "subtitle", "time": 9908.469, "timestamp": "02:45:08", "text": "看看这款游戏怎么样吧。 以及所有的一切"}, {"type": "subtitle", "time": 9911.03, "timestamp": "02:45:11", "text": "。"}, {"type": "subtitle", "time": 9913.99, "timestamp": "02:45:13", "text": "好吧，我们走吧。 你们能听到"}, {"type": "subtitle", "time": 9915.91, "timestamp": "02:45:15", "text": "比赛的声音吗？"}, {"type": "subtitle", "time": 9918.95, "timestamp": "02:45:18", "text": "哦，我忘了音乐要开大声。"}, {"type": "subtitle", "time": 9921.59, "timestamp": "02:45:21", "text": "应该会很吵吧？"}, {"type": "subtitle", "time": 9923.67, "timestamp": "02:45:23", "text": "右下方？ 靶场。 射击场目前"}, {"type": "subtitle", "time": 9925.269, "timestamp": "02:45:25", "text": "还不是一项"}, {"type": "subtitle", "time": 9927.03, "timestamp": "02:45:27", "text": "完整的功能。 这意味着大多数小工具"}, {"type": "subtitle", "time": 9929.349, "timestamp": "02:45:29", "text": "在射击场内都无法使用。 然而，它们"}, {"type": "subtitle", "time": 9933.349, "timestamp": "02:45:33", "text": "功能齐全，繁殖速度也比较慢。"}, {"type": "subtitle", "time": 9935.19, "timestamp": "02:45:35", "text": "最后，射击场是近战"}, {"type": "subtitle", "time": 9936.87, "timestamp": "02:45:36", "text": "武器和配件测试的重点。"}, {"type": "subtitle", "time": 9938.469, "timestamp": "02:45:38", "text": "好的。"}, {"type": "subtitle", "time": 9942.55, "timestamp": "02:45:42", "text": "我必须点击它。 好的。 这是什么？"}, {"type": "subtitle", "time": 9947.429, "timestamp": "02:45:47", "text": "装货完毕。 哦，那是M。哦，AK-15。"}, {"type": "subtitle", "time": 9949.269, "timestamp": "02:45:49", "text": "哦。"}, {"type": "subtitle", "time": 9953.03, "timestamp": "02:45:53", "text": "我们实现了零伤亡。"}, {"type": "subtitle", "time": 9956.469, "timestamp": "02:45:56", "text": "哇。 看看这些枪。"}]
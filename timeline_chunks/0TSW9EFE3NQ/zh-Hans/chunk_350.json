[{"type": "subtitle", "time": 21003.35, "timestamp": "05:50:03", "text": "笔记本电脑空间不够。"}, {"type": "subtitle", "time": 21006.07, "timestamp": "05:50:06", "text": "是的。空间。我想玩。是的，"}, {"type": "subtitle", "time": 21007.75, "timestamp": "05:50:07", "text": "我一直都想玩"}, {"type": "subtitle", "time": 21012.23, "timestamp": "05:50:12", "text": "，但我玩不了。"}, {"type": "subtitle", "time": 21015.27, "timestamp": "05:50:15", "text": "所以，等等，你喜欢赛车游戏吗？我"}, {"type": "subtitle", "time": 21019.03, "timestamp": "05:50:19", "text": "喜欢赛车游戏。走吧。我见过你"}, {"type": "subtitle", "time": 21022.628, "timestamp": "05:50:22", "text": "玩《狂野飙车》。是的，我玩过《"}, {"type": "subtitle", "time": 21025.35, "timestamp": "05:50:25", "text": "狂野飙车》，但后来我有点……你"}, {"type": "subtitle", "time": 21028.39, "timestamp": "05:50:28", "text": "知道，有点玩腻了。嗯。所以，我"}, {"type": "subtitle", "time": 21031.11, "timestamp": "05:50:31", "text": "就不玩了。是的"}, {"type": "subtitle", "time": 21033.99, "timestamp": "05:50:33", "text": "。那么，你玩过"}, {"type": "subtitle", "time": 21036.15, "timestamp": "05:50:36", "text": "速度游戏吗？"}, {"type": "subtitle", "time": 21040.31, "timestamp": "05:50:40", "text": "快节奏的游戏。没有，《极品飞车：竞速》"}, {"type": "subtitle", "time": 21042.47, "timestamp": "05:50:42", "text": "。我小时候玩过"}, {"type": "subtitle", "time": 21044.708, "timestamp": "05:50:44", "text": "。我玩过。《"}, {"type": "subtitle", "time": 21048.548, "timestamp": "05:50:48", "text": "极品飞车》。我也是。是的，我当时玩过"}, {"type": "subtitle", "time": 21051.03, "timestamp": "05:50:51", "text": "。我当时有一台台式机，就像我"}, {"type": "subtitle", "time": 21056.868, "timestamp": "05:50:56", "text": "有一台PC，但我把它装在里面了。"}, {"type": "subtitle", "time": 21059.51, "timestamp": "05:50:59", "text": "但是，是的，在……之后 嗯，我觉得我的台式机"}]
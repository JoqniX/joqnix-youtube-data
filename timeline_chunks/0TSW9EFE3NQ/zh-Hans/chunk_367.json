[{"type": "subtitle", "time": 22021.91, "timestamp": "06:07:01", "text": "哦，这里有三个……呃，这个东西。哦，"}, {"type": "subtitle", "time": 22026.07, "timestamp": "06:07:06", "text": "这是收音机。哦。"}, {"type": "subtitle", "time": 22028.31, "timestamp": "06:07:08", "text": "哦，又一个人。你可以蹲下。哦，是的"}, {"type": "subtitle", "time": 22031.91, "timestamp": "06:07:11", "text": "。你可以蹲下。是的。"}, {"type": "subtitle", "time": 22035.35, "timestamp": "06:07:15", "text": "未知实体。"}, {"type": "subtitle", "time": 22038.31, "timestamp": "06:07:18", "text": "它是一个人形生物，似乎是由"}, {"type": "subtitle", "time": 22040.708, "timestamp": "06:07:20", "text": "电缆制成的。出于某种原因，人们认为"}, {"type": "subtitle", "time": 22043.35, "timestamp": "06:07:23", "text": "它控制着这个"}, {"type": "subtitle", "time": 22045.83, "timestamp": "06:07:25", "text": "地方。当它关闭时，"}, {"type": "subtitle", "time": 22048.15, "timestamp": "06:07:28", "text": "房间的环境会发生变化，而且它似乎会被"}, {"type": "subtitle", "time": 22050.708, "timestamp": "06:07:30", "text": "电子设备和"}, {"type": "subtitle", "time": 22054.23, "timestamp": "06:07:34", "text": "无线电频率吸引。哦不。所以当你和它"}, {"type": "subtitle", "time": 22057.19, "timestamp": "06:07:37", "text": "在同一区域时，要非常"}, {"type": "subtitle", "time": 22059.27, "timestamp": "06:07:39", "text": "小心，你不想招来"}, {"type": "subtitle", "time": 22062.47, "timestamp": "06:07:42", "text": "自己的死亡参考。"}, {"type": "subtitle", "time": 22065.59, "timestamp": "06:07:45", "text": "探险队拍下了这张照片，照片中一个由"}, {"type": "subtitle", "time": 22069.19, "timestamp": "06:07:49", "text": "电线制成的生物在房间里徘徊，"}, {"type": "subtitle", "time": 22078.31, "timestamp": "06:07:58", "text": "什么？是什么意思？我"}]
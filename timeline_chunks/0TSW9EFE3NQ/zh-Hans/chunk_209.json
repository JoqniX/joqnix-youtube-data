[{"type": "subtitle", "time": 12540.309, "timestamp": "03:29:00", "text": "有人。"}, {"type": "subtitle", "time": 12563.67, "timestamp": "03:29:23", "text": "好的。 治愈我。"}, {"type": "subtitle", "time": 12580.63, "timestamp": "03:29:40", "text": "哦，他去世了。"}, {"type": "subtitle", "time": 12582.71, "timestamp": "03:29:42", "text": "好吧，行。 我打算直接在他们身上重生"}, {"type": "subtitle", "time": 12590.55, "timestamp": "03:29:50", "text": "不，更确切地说，他们在哪儿？ 好的。 呃，援助，"}, {"type": "subtitle", "time": 12592.229, "timestamp": "03:29:52", "text": "对吧？   是的"}, {"type": "subtitle", "time": 12596.15, "timestamp": "03:29:56", "text": "。 是的。 是的。 有基地。"}]
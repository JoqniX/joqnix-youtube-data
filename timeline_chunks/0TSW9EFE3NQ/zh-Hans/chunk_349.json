[{"type": "subtitle", "time": 20943.35, "timestamp": "05:49:03", "text": "硬男孩是我。"}, {"type": "subtitle", "time": 20946.708, "timestamp": "05:49:06", "text": "我的天哪。不。那我是个硬男孩。"}, {"type": "subtitle", "time": 20949.43, "timestamp": "05:49:09", "text": "我们来做些调查。"}, {"type": "subtitle", "time": 20950.948, "timestamp": "05:49:10", "text": "不。"}, {"type": "subtitle", "time": 20953.43, "timestamp": "05:49:13", "text": "等等。"}, {"type": "subtitle", "time": 20956.788, "timestamp": "05:49:16", "text": "我的天哪。"}, {"type": "subtitle", "time": 20958.31, "timestamp": "05:49:18", "text": "不。"}, {"type": "subtitle", "time": 20961.91, "timestamp": "05:49:21", "text": "所以，是的。有没有什么……有没有什么"}, {"type": "subtitle", "time": 20964.39, "timestamp": "05:49:24", "text": "你期待在未来玩的游戏"}, {"type": "subtitle", "time": 20967.19, "timestamp": "05:49:27", "text": "？有没有什么我期待"}, {"type": "subtitle", "time": 20970.708, "timestamp": "05:49:30", "text": "在未来玩的游戏？我不知道。我"}, {"type": "subtitle", "time": 20974.18, "timestamp": "05:49:34", "text": "不知道。我真的很想玩。"}, {"type": "subtitle", "time": 20976.15, "timestamp": "05:49:36", "text": "[音乐]"}, {"type": "subtitle", "time": 20979.43, "timestamp": "05:49:39", "text": "让我想想。我想我知道"}, {"type": "subtitle", "time": 20982.39, "timestamp": "05:49:42", "text": "我想玩什么了。我真的很想玩。哦，是的"}, {"type": "subtitle", "time": 20985.91, "timestamp": "05:49:45", "text": "。我想玩《地平线》。  5款"}, {"type": "subtitle", "time": 20988.47, "timestamp": "05:49:48", "text": "赛车游戏。你知道吗？哦，是的。是的。是的。"}, {"type": "subtitle", "time": 20990.708, "timestamp": "05:49:50", "text": "你知道吗？是的。《"}, {"type": "subtitle", "time": 20995.11, "timestamp": "05:49:55", "text": "极限竞速：地平线》。是的。没错。《极限竞速：地平线"}, {"type": "subtitle", "time": 20997.35, "timestamp": "05:49:57", "text": "5》。我真的很想玩，但我"}]
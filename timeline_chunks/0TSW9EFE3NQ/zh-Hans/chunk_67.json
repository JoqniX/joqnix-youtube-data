[{"type": "subtitle", "time": 4024.069, "timestamp": "01:07:04", "text": "的天哪，他们戴着面具。"}, {"type": "subtitle", "time": 4026.95, "timestamp": "01:07:06", "text": "我的意思是，当然，如果我看到那个，"}, {"type": "subtitle", "time": 4029.27, "timestamp": "01:07:09", "text": "或者面对面，我当然会"}, {"type": "subtitle", "time": 4060.39, "timestamp": "01:07:40", "text": "[音乐]"}, {"type": "subtitle", "time": 4063.1, "timestamp": "01:07:43", "text": "你为什么"}, {"type": "subtitle", "time": 4070.069, "timestamp": "01:07:50", "text": "下来了？好吧，"}, {"type": "subtitle", "time": 4071.43, "timestamp": "01:07:51", "text": "我要睡觉了。下次"}, {"type": "subtitle", "time": 4073.99, "timestamp": "01:07:53", "text": "直播见。哦，是的。哦，是的。"}, {"type": "subtitle", "time": 4077.99, "timestamp": "01:07:57", "text": "嗨。晚安。雪莉。晚安。晚安"}]
[{"type": "subtitle", "time": 6424.95, "timestamp": "01:47:04", "text": "他让我想起了我自己，但我爱"}, {"type": "subtitle", "time": 6427.51, "timestamp": "01:47:07", "text": "他。"}, {"type": "subtitle", "time": 6429.61, "timestamp": "01:47:09", "text": "再见。"}, {"type": "subtitle", "time": 6443.35, "timestamp": "01:47:23", "text": "我没有紫色尼古拉级别的装备，"}, {"type": "subtitle", "time": 6455.669, "timestamp": "01:47:35", "text": "我想我给阿雅的装备都准备好了。是的，"}, {"type": "subtitle", "time": 6458.79, "timestamp": "01:47:38", "text": "我只需要准备升到50级。我永远"}, {"type": "subtitle", "time": 6461.109, "timestamp": "01:47:41", "text": "不会去 冒险等级50级，"}, {"type": "subtitle", "time": 6464.63, "timestamp": "01:47:44", "text": "不过总有一天我会把它升到80级。"}, {"type": "subtitle", "time": 6467.27, "timestamp": "01:47:47", "text": "[音乐]"}, {"type": "subtitle", "time": 6471.35, "timestamp": "01:47:51", "text": "这些是80级，对吧？嗯，80级。"}]
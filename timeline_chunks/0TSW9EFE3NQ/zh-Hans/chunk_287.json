[{"type": "subtitle", "time": 17231.83, "timestamp": "04:47:11", "text": "所以，为了改变很多东西，你"}, {"type": "subtitle", "time": 17241.75, "timestamp": "04:47:21", "text": "换队怎么样？"}, {"type": "subtitle", "time": 17244.47, "timestamp": "04:47:24", "text": "不行。"}, {"type": "subtitle", "time": 17250.15, "timestamp": "04:47:30", "text": "队伍输的时候不能换队。哇。"}, {"type": "subtitle", "time": 17253.67, "timestamp": "04:47:33", "text": "他们知道。他们知道。他们知道。"}]
[{"type": "subtitle", "time": 18244.39, "timestamp": "05:04:04", "text": "我的天。"}, {"type": "subtitle", "time": 18247.11, "timestamp": "05:04:07", "text": "你玩了多久？2分30秒。好的。是时候"}, {"type": "subtitle", "time": 18251.59, "timestamp": "05:04:11", "text": "收尾了。是的，"}, {"type": "subtitle", "time": 18253.99, "timestamp": "05:04:13", "text": "我们收尾的时候再聊一会儿"}, {"type": "subtitle", "time": 18259.43, "timestamp": "05:04:19", "text": "所以，是的，这游戏太酷了，我玩得很"}, {"type": "subtitle", "time": 18262.39, "timestamp": "05:04:22", "text": "开心。"}, {"type": "subtitle", "time": 18264.948, "timestamp": "05:04:24", "text": "砰砰砰。"}, {"type": "subtitle", "time": 18268.55, "timestamp": "05:04:28", "text": "我现在多少级了？"}, {"type": "subtitle", "time": 18272.07, "timestamp": "05:04:32", "text": "我尿了很多次。我在H。我在Ja。"}, {"type": "subtitle", "time": 18279.19, "timestamp": "05:04:39", "text": "真令人惊讶。呃，好的。等等，等等，"}, {"type": "subtitle", "time": 18280.55, "timestamp": "05:04:40", "text": "等等。 什么？我做了什么？我做了什么"}, {"type": "subtitle", "time": 18282.628, "timestamp": "05:04:42", "text": "？"}, {"type": "subtitle", "time": 18285.67, "timestamp": "05:04:45", "text": "好吧，这个。"}, {"type": "subtitle", "time": 18287.91, "timestamp": "05:04:47", "text": "有个战队之类的东西。我觉得我"}, {"type": "subtitle", "time": 18291.19, "timestamp": "05:04:51", "text": "不会加入。我不想再建"}, {"type": "subtitle", "time": 18292.868, "timestamp": "05:04:52", "text": "战队了。"}, {"type": "subtitle", "time": 18295.51, "timestamp": "05:04:55", "text": "除非很多人带着"}, {"type": "subtitle", "time": 18297.27, "timestamp": "05:04:57", "text": "这把"}]
[{"type": "subtitle", "time": 18724.31, "timestamp": "05:12:04", "text": "谢谢。谢谢。"}, {"type": "subtitle", "time": 18726.868, "timestamp": "05:12:06", "text": "希望这个游戏没让"}, {"type": "subtitle", "time": 18729.59, "timestamp": "05:12:09", "text": "你太难受。我知道你有点"}, {"type": "subtitle", "time": 18732.868, "timestamp": "05:12:12", "text": "晕动症什么的。希望"}, {"type": "subtitle", "time": 18735.35, "timestamp": "05:12:15", "text": "你没被"}, {"type": "subtitle", "time": 18738.39, "timestamp": "05:12:18", "text": "这个快节奏的游戏吓到。总之"}, {"type": "subtitle", "time": 18741.11, "timestamp": "05:12:21", "text": "，谢谢你来。Zuki今天也"}, {"type": "subtitle", "time": 18745.35, "timestamp": "05:12:25", "text": "来了"}, {"type": "subtitle", "time": 18747.11, "timestamp": "05:12:27", "text": "。"}, {"type": "subtitle", "time": 18750.39, "timestamp": "05:12:30", "text": "希望你今晚玩得开心，"}, {"type": "subtitle", "time": 18763.11, "timestamp": "05:12:43", "text": "开心。对了"}, {"type": "subtitle", "time": 18766.15, "timestamp": "05:12:46", "text": "，说到我刚才说的"}, {"type": "subtitle", "time": 18769.67, "timestamp": "05:12:49", "text": "比特币版Valerant，"}, {"type": "subtitle", "time": 18772.47, "timestamp": "05:12:52", "text": "Valerant出了个新版本，对吧？我"}, {"type": "subtitle", "time": 18774.868, "timestamp": "05:12:54", "text": "需要……嗯，考完试什么的之后，"}, {"type": "subtitle", "time": 18777.35, "timestamp": "05:12:57", "text": "我打算玩Valerant。或者我明天"}, {"type": "subtitle", "time": 18779.19, "timestamp": "05:12:59", "text": "早上"}]
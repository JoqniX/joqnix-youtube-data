[{"type": "subtitle", "time": 20762.868, "timestamp": "05:46:02", "text": "知道。我想我从来没见过他。 我"}, {"type": "subtitle", "time": 20773.51, "timestamp": "05:46:13", "text": "不知道。"}, {"type": "subtitle", "time": 20775.75, "timestamp": "05:46:15", "text": "你玩游戏的时候生气过吗？我"}, {"type": "subtitle", "time": 20778.15, "timestamp": "05:46:18", "text": "是说，你有没有暴跳如雷过？"}, {"type": "subtitle", "time": 20782.23, "timestamp": "05:46:22", "text": "呃，没有。更像是哭。"}, {"type": "subtitle", "time": 20784.23, "timestamp": "05:46:24", "text": "这就是“小天使”的定义"}, {"type": "subtitle", "time": 20786.788, "timestamp": "05:46:26", "text": "。“小天使”大概就是那种"}, {"type": "subtitle", "time": 20789.75, "timestamp": "05:46:29", "text": "如果"}, {"type": "subtitle", "time": 20792.708, "timestamp": "05:46:32", "text": "游戏玩得让人沮丧，他们不会"}, {"type": "subtitle", "time": 20794.788, "timestamp": "05:46:34", "text": "大喊大叫，而是会哭。他们只会"}, {"type": "subtitle", "time": 20798.708, "timestamp": "05:46:38", "text": "说：“哦不，"}, {"type": "subtitle", "time": 20802.23, "timestamp": "05:46:42", "text": "为什么会这样？” 我从来"}, {"type": "subtitle", "time": 20804.948, "timestamp": "05:46:44", "text": "没听过他提高嗓门或者"}, {"type": "subtitle", "time": 20807.27, "timestamp": "05:46:47", "text": "生气地说：“去他妈的。” 真是够了"}, {"type": "subtitle", "time": 20808.708, "timestamp": "05:46:48", "text": "。  “我不想玩。” 我"}, {"type": "subtitle", "time": 20811.27, "timestamp": "05:46:51", "text": "从没听过他这么说。他是个小"}, {"type": "subtitle", "time": 20815.19, "timestamp": "05:46:55", "text": "甜心。确认。不。我的天哪。好吧。"}]
[{"type": "subtitle", "time": 21901.43, "timestamp": "06:05:01", "text": "你能读懂这个吗？我……我读不懂。哦，"}, {"type": "subtitle", "time": 21903.59, "timestamp": "06:05:03", "text": "等等。读。哦，等等。是啊。是啊。是啊。"}, {"type": "subtitle", "time": 21906.47, "timestamp": "06:05:06", "text": "我现在能读懂了。在潜伏的黑暗中，"}, {"type": "subtitle", "time": 21908.47, "timestamp": "06:05:08", "text": "信息"}, {"type": "subtitle", "time": 21911.51, "timestamp": "06:05:11", "text": "实体3文件机密。"}, {"type": "subtitle", "time": 21913.91, "timestamp": "06:05:13", "text": "在…… 潜伏的黑暗中，这些墙壁"}, {"type": "subtitle", "time": 21917.11, "timestamp": "06:05:17", "text": "掩藏着某种神秘的东西。一个"}, {"type": "subtitle", "time": 21919.91, "timestamp": "06:05:19", "text": "笑容灿烂的东西，从阴影中显露出来"}, {"type": "subtitle", "time": 21923.83, "timestamp": "06:05:23", "text": "。传言说它有一个"}, {"type": "subtitle", "time": 21929.59, "timestamp": "06:05:29", "text": "肉眼无法看到的实体。人们只知道它"}, {"type": "subtitle", "time": 21934.23, "timestamp": "06:05:34", "text": "与所有光源相连，并将"}, {"type": "subtitle", "time": 21937.03, "timestamp": "06:05:37", "text": "你困在阴影的虚空中"}, {"type": "subtitle", "time": 21939.11, "timestamp": "06:05:39", "text": "。你可能"}, {"type": "subtitle", "time": 21943.19, "timestamp": "06:05:43", "text": "再也见不到光明了。抱紧我。我明白了。记住，"}, {"type": "subtitle", "time": 21945.91, "timestamp": "06:05:45", "text": "微笑并不总是代表和平。"}, {"type": "subtitle", "time": 21948.548, "timestamp": "06:05:48", "text": "它恰恰相反，甚至可以说是"}, {"type": "subtitle", "time": 21950.868, "timestamp": "06:05:50", "text": "完全相反。记住，微笑"}, {"type": "subtitle", "time": 21953.19, "timestamp": "06:05:53", "text": "并不代表和平。实际上，"}, {"type": "subtitle", "time": 21956.07, "timestamp": "06:05:56", "text": "恰恰相反。参考资料。下一张照片是"}, {"type": "subtitle", "time": 21959.59, "timestamp": "06:05:59", "text": "在后室更黑暗的区域拍摄的，"}]
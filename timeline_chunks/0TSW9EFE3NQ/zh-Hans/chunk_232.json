[{"type": "subtitle", "time": 13920.71, "timestamp": "03:52:00", "text": "他关掉了手电筒。"}, {"type": "subtitle", "time": 13923.59, "timestamp": "03:52:03", "text": "让我疗伤。 三个需要治愈。"}, {"type": "subtitle", "time": 13942.229, "timestamp": "03:52:22", "text": "为树木发声。 不知何故，"}, {"type": "subtitle", "time": 13969.59, "timestamp": "03:52:49", "text": "我死了。 他当时正在使我复活，然后就"}, {"type": "subtitle", "time": 13973.03, "timestamp": "03:52:53", "text": "死了。 我的天啊。 好吧，我必须在"}]
[{"type": "subtitle", "time": 20581.67, "timestamp": "05:43:01", "text": "知道那种薯片，那种特别辣的薯片"}, {"type": "subtitle", "time": 20584.39, "timestamp": "05:43:04", "text": "。对，世界上最辣的薯片"}, {"type": "subtitle", "time": 20586.31, "timestamp": "05:43:06", "text": "。我想吃。哦，对。对。对"}, {"type": "subtitle", "time": 20590.788, "timestamp": "05:43:10", "text": "。那肯定很好吃。是的"}, {"type": "subtitle", "time": 20592.708, "timestamp": "05:43:12", "text": "。我想，我想，我想吃"}, {"type": "subtitle", "time": 20595.43, "timestamp": "05:43:15", "text": "。我想，然后第二天就"}, {"type": "subtitle", "time": 20597.19, "timestamp": "05:43:17", "text": "后悔。这就是我"}, {"type": "subtitle", "time": 20599.43, "timestamp": "05:43:19", "text": "想做的。"}, {"type": "subtitle", "time": 20601.19, "timestamp": "05:43:21", "text": "哦，天哪。"}, {"type": "subtitle", "time": 20603.99, "timestamp": "05:43:23", "text": "哦，你怎么知道肉桂"}, {"type": "subtitle", "time": 20606.708, "timestamp": "05:43:26", "text": "卷是什么？对，没错。你怎么知道的？"}, {"type": "subtitle", "time": 20609.99, "timestamp": "05:43:29", "text": "它意味着你很可爱，很可爱，很甜美。"}, {"type": "subtitle", "time": 20612.23, "timestamp": "05:43:32", "text": "你很可爱，很甜美，但什么都做不了"}, {"type": "subtitle", "time": 20614.548, "timestamp": "05:43:34", "text": "。你就是那种人，所以"}, {"type": "subtitle", "time": 20616.948, "timestamp": "05:43:36", "text": "人们想要保护你。然后就是Joker"}, {"type": "subtitle", "time": 20619.11, "timestamp": "05:43:39", "text": "前辈。Joker前辈就是肉桂卷。"}, {"type": "subtitle", "time": 20621.27, "timestamp": "05:43:41", "text": "哦，等等。不，你是…… 肉桂"}, {"type": "subtitle", "time": 20624.868, "timestamp": "05:43:44", "text": "卷。不，我不是，你是肉桂"}, {"type": "subtitle", "time": 20627.11, "timestamp": "05:43:47", "text": "卷。大家都想保护你。"}, {"type": "subtitle", "time": 20630.23, "timestamp": "05:43:50", "text": "我觉得你是我们中最可爱的。"}, {"type": "subtitle", "time": 20635.83, "timestamp": "05:43:55", "text": "不，是你。肉桂卷是最"}, {"type": "subtitle", "time": 20638.31, "timestamp": "05:43:58", "text": "可爱的人。是的，这就是甜心游戏。"}]
[{"type": "subtitle", "time": 19981.67, "timestamp": "05:33:01", "text": "是的。你又抽到剃刀了。剃刀"}, {"type": "subtitle", "time": 19983.27, "timestamp": "05:33:03", "text": "星座。"}, {"type": "subtitle", "time": 19984.948, "timestamp": "05:33:04", "text": "你试过抽她吗？你"}, {"type": "subtitle", "time": 19987.67, "timestamp": "05:33:07", "text": "试过吗？我试过，但是没有。我"}, {"type": "subtitle", "time": 19991.11, "timestamp": "05:33:11", "text": "试过，我想抽努，"}, {"type": "subtitle", "time": 19993.99, "timestamp": "05:33:13", "text": "但我抽了大概80次。我还是"}, {"type": "subtitle", "time": 19996.628, "timestamp": "05:33:16", "text": "没抽到。唉。"}, {"type": "subtitle", "time": 19999.75, "timestamp": "05:33:19", "text": "然后我就没钱抽普拉了。"}, {"type": "subtitle", "time": 20004.23, "timestamp": "05:33:24", "text": "所以我就想，“哦不。”我的天啊。"}, {"type": "subtitle", "time": 20006.788, "timestamp": "05:33:26", "text": "我不知道。我不知道。很多"}, {"type": "subtitle", "time": 20008.548, "timestamp": "05:33:28", "text": "人受伤了。很多人没"}, {"type": "subtitle", "time": 20013.43, "timestamp": "05:33:33", "text": "受伤。是的。但是，是的，这……"}, {"type": "subtitle", "time": 20016.628, "timestamp": "05:33:36", "text": "没想到会遇到"}, {"type": "subtitle", "time": 20018.788, "timestamp": "05:33:38", "text": "娜希达，玩起来感觉怎么样？"}, {"type": "subtitle", "time": 20021.75, "timestamp": "05:33:41", "text": "挺好的。娜希达真的很不错，"}, {"type": "subtitle", "time": 20023.99, "timestamp": "05:33:43", "text": "因为我还没培养她，所以"}, {"type": "subtitle", "time": 20025.51, "timestamp": "05:33:45", "text": "不知道她真正的潜力，但就"}, {"type": "subtitle", "time": 20027.51, "timestamp": "05:33:47", "text": "我目前所知，她是个很强的"}, {"type": "subtitle", "time": 20030.628, "timestamp": "05:33:50", "text": "角色，适合任何反应"}, {"type": "subtitle", "time": 20034.23, "timestamp": "05:33:54", "text": "型队伍。嗯。所以，是的，她真的"}, {"type": "subtitle", "time": 20037.59, "timestamp": "05:33:57", "text": "很好用，呃呃呃，树状施法器，"}]
[{"type": "subtitle", "time": 21799.59, "timestamp": "06:03:19", "text": "嘿，快点。快点。我们走吧。"}, {"type": "subtitle", "time": 21808.31, "timestamp": "06:03:28", "text": "[音乐]"}, {"type": "subtitle", "time": 21812.15, "timestamp": "06:03:32", "text": "不要 快跑，求你了。我害怕。"}, {"type": "subtitle", "time": 21818.39, "timestamp": "06:03:38", "text": "[笑声] 哇哦"}, {"type": "subtitle", "time": 21834.868, "timestamp": "06:03:54", "text": "天哪。"}]
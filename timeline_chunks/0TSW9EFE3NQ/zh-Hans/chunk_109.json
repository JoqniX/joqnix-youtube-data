[{"type": "subtitle", "time": 6541.35, "timestamp": "01:49:01", "text": "你不觉得很痛苦吗？"}, {"type": "subtitle", "time": 6544.629, "timestamp": "01:49:04", "text": "重复性太高了。"}, {"type": "subtitle", "time": 6551.109, "timestamp": "01:49:11", "text": "哦，我看到我的苏克罗有六个。哇哦。"}, {"type": "subtitle", "time": 6552.709, "timestamp": "01:49:12", "text": "该死。"}, {"type": "subtitle", "time": 6578.47, "timestamp": "01:49:38", "text": "整体属性在哪儿呢？魔法速度"}, {"type": "subtitle", "time": 6581.51, "timestamp": "01:49:41", "text": "这么多。攻击力这么多。暴击伤害？哦"}, {"type": "subtitle", "time": 6585.91, "timestamp": "01:49:45", "text": "。哦，对。对。暴击伤害109。"}, {"type": "subtitle", "time": 6587.35, "timestamp": "01:49:47", "text": "哦，对。好的。好的。对，在那儿。在那儿。"}, {"type": "subtitle", "time": 6589.99, "timestamp": "01:49:49", "text": "我的错。我的错。我的错。哦，"}, {"type": "subtitle", "time": 6592.629, "timestamp": "01:49:52", "text": "对。我当时想，“等等，什么？”"}, {"type": "subtitle", "time": 6595.43, "timestamp": "01:49:55", "text": "所以，等等。哦，这是神器。好的。"}]
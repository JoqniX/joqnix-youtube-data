[{"type": "subtitle", "time": 20701.43, "timestamp": "05:45:01", "text": "。拜托。还剩10MB。走吧。"}, {"type": "subtitle", "time": 20703.27, "timestamp": "05:45:03", "text": "所以，如果你想知道为什么我们"}, {"type": "subtitle", "time": 20705.19, "timestamp": "05:45:05", "text": "还没开始，那是因为我的游戏"}, {"type": "subtitle", "time": 20707.75, "timestamp": "05:45:07", "text": "更新太慢了。我不"}, {"type": "subtitle", "time": 20710.47, "timestamp": "05:45:10", "text": "知道今天的服务器怎么了。真是太"}, {"type": "subtitle", "time": 20712.23, "timestamp": "05:45:12", "text": "痛苦了。我"}, {"type": "subtitle", "time": 20715.27, "timestamp": "05:45:15", "text": "花了好一会儿才喜欢上它，"}, {"type": "subtitle", "time": 20718.47, "timestamp": "05:45:18", "text": "它只是一个184MB的更新，但不知道"}, {"type": "subtitle", "time": 20735.51, "timestamp": "05:45:35", "text": "我不知道。我觉得没人知道他"}, {"type": "subtitle", "time": 20737.75, "timestamp": "05:45:37", "text": "是个小可爱。Jok是个小可爱"}, {"type": "subtitle", "time": 20741.83, "timestamp": "05:45:41", "text": "。我可以这么说。嗯哼。不，不，"}, {"type": "subtitle", "time": 20743.59, "timestamp": "05:45:43", "text": "不是我。"}, {"type": "subtitle", "time": 20745.27, "timestamp": "05:45:45", "text": "你们两个都是小可爱，我真的有点想吃"}, {"type": "subtitle", "time": 20748.788, "timestamp": "05:45:48", "text": "甜食了。"}, {"type": "subtitle", "time": 20750.788, "timestamp": "05:45:50", "text": "其实我也想吃点东西。说"}, {"type": "subtitle", "time": 20752.47, "timestamp": "05:45:52", "text": "实话。哦，等等。你"}, {"type": "subtitle", "time": 20756.948, "timestamp": "05:45:56", "text": "一次都没见过他。是的，他是个小"}, {"type": "subtitle", "time": 20759.91, "timestamp": "05:45:59", "text": "可爱。不，他甚至不"}]
[{"type": "subtitle", "time": 13443.83, "timestamp": "03:44:03", "text": "我的死法和很多人一样。"}, {"type": "subtitle", "time": 13446.469, "timestamp": "03:44:06", "text": "事情已经办妥了。"}, {"type": "subtitle", "time": 13447.99, "timestamp": "03:44:07", "text": "等等，有人在拖我。 好的，谢谢"}, {"type": "subtitle", "time": 13467.269, "timestamp": "03:44:27", "text": "你好吗？ 我很好。"}, {"type": "subtitle", "time": 13470.71, "timestamp": "03:44:30", "text": "我一切都好。 你好吗？"}, {"type": "subtitle", "time": 13482.309, "timestamp": "03:44:42", "text": "天哪，外面下雨了。"}]
[{"type": "subtitle", "time": 18366.708, "timestamp": "05:06:06", "text": "我不知道你能得到那里。"}, {"type": "subtitle", "time": 18369.67, "timestamp": "05:06:09", "text": "有桥梁掉落之类的。哇。"}, {"type": "subtitle", "time": 18372.948, "timestamp": "05:06:12", "text": "但是，好吧。好吧，让我放点音乐。"}, {"type": "subtitle", "time": 18375.11, "timestamp": "05:06:15", "text": "好吧。背景音乐，"}, {"type": "subtitle", "time": 18378.948, "timestamp": "05:06:18", "text": "像这样…… 好的。"}, {"type": "subtitle", "time": 18386.39, "timestamp": "05:06:26", "text": "我要结束了。我要感谢大家，因为呃，"}, {"type": "subtitle", "time": 18390.15, "timestamp": "05:06:30", "text": "我要去吃晚饭了。问题"}, {"type": "subtitle", "time": 18393.19, "timestamp": "05:06:33", "text": "是，当我被叫去吃晚饭的时候，我会慢慢地"}, {"type": "subtitle", "time": 18396.628, "timestamp": "05:06:36", "text": "吃饭，就像以前"}, {"type": "subtitle", "time": 18400.15, "timestamp": "05:06:40", "text": "在家的时候一样，我会在"}, {"type": "subtitle", "time": 18402.628, "timestamp": "05:06:42", "text": "房间里吃饭，对吧？我会"}, {"type": "subtitle", "time": 18405.35, "timestamp": "05:06:45", "text": "和你们聊天，边吃边慢慢来，"}, {"type": "subtitle", "time": 18407.43, "timestamp": "05:06:47", "text": "也许还会写写东西，甚至速通一下什么的"}, {"type": "subtitle", "time": 18409.75, "timestamp": "05:06:49", "text": "，对吧？但是，很"}, {"type": "subtitle", "time": 18418.47, "timestamp": "05:06:58", "text": "痛苦，对吧？"}]
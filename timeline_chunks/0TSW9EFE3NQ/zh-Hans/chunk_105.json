[{"type": "subtitle", "time": 6308.709, "timestamp": "01:45:08", "text": "等等，什么？"}, {"type": "subtitle", "time": 6311.75, "timestamp": "01:45:11", "text": "Kaishi，我抽到了Vander。Chama，我抽到了"}, {"type": "subtitle", "time": 6315.75, "timestamp": "01:45:15", "text": "Vander。我抽到他了。我刚刚抽到他了。D，"}, {"type": "subtitle", "time": 6319.03, "timestamp": "01:45:19", "text": "你晚了两秒。"}, {"type": "subtitle", "time": 6321.91, "timestamp": "01:45:21", "text": "你晚了两秒，D。"}, {"type": "subtitle", "time": 6325.27, "timestamp": "01:45:25", "text": "我刚刚抽到他了。哦，我的天。抽到他了。哦，我的天。"}, {"type": "subtitle", "time": 6328.629, "timestamp": "01:45:28", "text": "我抽到他了。哦，我的天。我"}, {"type": "subtitle", "time": 6333.03, "timestamp": "01:45:33", "text": "刚刚抽到他了。哦，我的天。哦，我的天。哦，我的天"}, {"type": "subtitle", "time": 6335.109, "timestamp": "01:45:35", "text": "。"}, {"type": "subtitle", "time": 6339.03, "timestamp": "01:45:39", "text": "让我 那就把那玩意儿升到满级吧。"}, {"type": "subtitle", "time": 6341.91, "timestamp": "01:45:41", "text": "不，我和他们在一起。不过我刚拿到他"}, {"type": "subtitle", "time": 6343.43, "timestamp": "01:45:43", "text": "。"}, {"type": "subtitle", "time": 6353.43, "timestamp": "01:45:53", "text": "我的天。"}]
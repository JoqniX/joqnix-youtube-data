[{"type": "subtitle", "time": 20100.548, "timestamp": "05:35:00", "text": "。是的，我们一起去。我们一起"}, {"type": "subtitle", "time": 20102.788, "timestamp": "05:35:02", "text": "出去。这就是合同。就是这样"}, {"type": "subtitle", "time": 20106.23, "timestamp": "05:35:06", "text": "。"}, {"type": "subtitle", "time": 20109.35, "timestamp": "05:35:09", "text": "是的，这就是交易。在这里我可以弄到一个"}, {"type": "subtitle", "time": 20112.15, "timestamp": "05:35:12", "text": "贝内特和78。可惜妮塔离得太远了"}, {"type": "subtitle", "time": 20114.47, "timestamp": "05:35:14", "text": "。"}, {"type": "subtitle", "time": 20116.39, "timestamp": "05:35:16", "text": "本尼。"}, {"type": "subtitle", "time": 20119.19, "timestamp": "05:35:19", "text": "贝内特。我甚至还没把他造出来，所以"}, {"type": "subtitle", "time": 20122.788, "timestamp": "05:35:22", "text": "我真的不知道。嗯。不过"}, {"type": "subtitle", "time": 20126.31, "timestamp": "05:35:26", "text": "，也没什么好哭的。"}, {"type": "subtitle", "time": 20129.91, "timestamp": "05:35:29", "text": "哦，我的剃须刀C5宝贝。我的天，有点糟糕。看"}, {"type": "subtitle", "time": 20133.83, "timestamp": "05:35:33", "text": "那里。这是什么游戏？你好，莱恩。"}, {"type": "subtitle", "time": 20138.15, "timestamp": "05:35:38", "text": "它叫《后室》。是的。"}, {"type": "subtitle", "time": 20139.67, "timestamp": "05:35:39", "text": "而且是个恐怖游戏。我想是《后"}, {"type": "subtitle", "time": 20141.67, "timestamp": "05:35:41", "text": "室》。是的，是个恐怖游戏。而且我"}, {"type": "subtitle", "time": 20143.91, "timestamp": "05:35:43", "text": "觉得《后室》在恐怖游戏圈子里很受欢迎"}, {"type": "subtitle", "time": 20148.23, "timestamp": "05:35:48", "text": "。哦，我想是"}, {"type": "subtitle", "time": 20150.788, "timestamp": "05:35:50", "text": "梗或者 跟游戏有关，对吧"}, {"type": "subtitle", "time": 20154.708, "timestamp": "05:35:54", "text": "？我不知道。我已经不玩"}]
[{"type": "subtitle", "time": 13582.87, "timestamp": "03:46:22", "text": "呃，好吧，没事了。 呃，部署。 我要"}, {"type": "subtitle", "time": 13586.389, "timestamp": "03:46:26", "text": "派他上岗。 他去世了。 好的。 对付"}, {"type": "subtitle", "time": 13598.389, "timestamp": "03:46:38", "text": "哦。"}, {"type": "subtitle", "time": 13604.63, "timestamp": "03:46:44", "text": "救救我吧。 哦，谢谢。 他"}, {"type": "subtitle", "time": 13607.83, "timestamp": "03:46:47", "text": "要把我拖走。 发生了什么事？ 哦。"}]
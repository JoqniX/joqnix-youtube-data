[{"type": "subtitle", "time": 9060.389, "timestamp": "02:31:00", "text": "but I believe there are stories being"}, {"type": "subtitle", "time": 9063.429, "timestamp": "02:31:03", "text": "written across the stars."}, {"type": "subtitle", "time": 9067.11, "timestamp": "02:31:07", "text": "In my constellation, I watched many"}, {"type": "subtitle", "time": 9070.389, "timestamp": "02:31:10", "text": "stars passed through. Some blazed"}, {"type": "subtitle", "time": 9073.27, "timestamp": "02:31:13", "text": "brilliant parts had changed my sky"}, {"type": "subtitle", "time": 9075.51, "timestamp": "02:31:15", "text": "forever."}, {"type": "subtitle", "time": 9079.429, "timestamp": "02:31:19", "text": "Others were quiet lights that showed me"}, {"type": "subtitle", "time": 9082.15, "timestamp": "02:31:22", "text": "new ways to shine."}, {"type": "subtitle", "time": 9085.429, "timestamp": "02:31:25", "text": "Each one taught me something about my"}, {"type": "subtitle", "time": 9088.07, "timestamp": "02:31:28", "text": "own light."}, {"type": "subtitle", "time": 9091.83, "timestamp": "02:31:31", "text": "There are seasons of shooting stars, of"}, {"type": "subtitle", "time": 9095.11, "timestamp": "02:31:35", "text": "watching familiar lights"}, {"type": "subtitle", "time": 9098.95, "timestamp": "02:31:38", "text": "new paths across my sky, of learning"}, {"type": "subtitle", "time": 9102.71, "timestamp": "02:31:42", "text": "that sometimes the brightest moments are"}, {"type": "subtitle", "time": 9105.99, "timestamp": "02:31:45", "text": "the ones that teach us how to glow"}, {"type": "subtitle", "time": 9107.51, "timestamp": "02:31:47", "text": "differently."}, {"type": "subtitle", "time": 9111.03, "timestamp": "02:31:51", "text": "Perhaps you too have watched your stars"}, {"type": "subtitle", "time": 9114.469, "timestamp": "02:31:54", "text": "change paths, felt the weight of light"}, {"type": "subtitle", "time": 9118.15, "timestamp": "02:31:58", "text": "years between hells and goodbyes."}]
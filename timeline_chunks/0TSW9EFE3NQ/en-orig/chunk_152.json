[{"type": "subtitle", "time": 9120.79, "timestamp": "02:32:00", "text": "Learn that some stars are meant to be"}, {"type": "subtitle", "time": 9124.79, "timestamp": "02:32:04", "text": "permanent constellations while others"}, {"type": "subtitle", "time": 9128.309, "timestamp": "02:32:08", "text": "are meant to be beautiful, fleeting"}, {"type": "subtitle", "time": 9131.51, "timestamp": "02:32:11", "text": "moments. To every star that crossed my"}, {"type": "subtitle", "time": 9135.51, "timestamp": "02:32:15", "text": "path, your light mattered."}, {"type": "subtitle", "time": 9139.03, "timestamp": "02:32:19", "text": "every shared moment of brightness, every"}, {"type": "subtitle", "time": 9141.99, "timestamp": "02:32:21", "text": "lesson in how to shine."}, {"type": "subtitle", "time": 9146.15, "timestamp": "02:32:26", "text": "We're all made of the same cosmic dust."}, {"type": "subtitle", "time": 9148.79, "timestamp": "02:32:28", "text": "Yet, each of us"}, {"type": "subtitle", "time": 9152.15, "timestamp": "02:32:32", "text": "grows uniquely."}, {"type": "subtitle", "time": 9155.67, "timestamp": "02:32:35", "text": "Sometimes our paths align perfectly."}, {"type": "subtitle", "time": 9159.51, "timestamp": "02:32:39", "text": "Sometimes they're meant to diverge."}, {"type": "subtitle", "time": 9163.429, "timestamp": "02:32:43", "text": "And that's the beauty of being stars. We"}, {"type": "subtitle", "time": 9167.349, "timestamp": "02:32:47", "text": "don't dim when parts separate. We learn"}, {"type": "subtitle", "time": 9171.27, "timestamp": "02:32:51", "text": "to shine differently to create new"}, {"type": "subtitle", "time": 9173.27, "timestamp": "02:32:53", "text": "constellations."}, {"type": "subtitle", "time": 9177.11, "timestamp": "02:32:57", "text": "As this year becomes a memory, I'm"}]
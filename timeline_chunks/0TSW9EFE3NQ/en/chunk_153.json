[{"type": "subtitle", "time": 9180.71, "timestamp": "02:33:00", "text": "learning that every shooting star is not"}, {"type": "subtitle", "time": 9184.07, "timestamp": "02:33:04", "text": "an ending but a beginning."}, {"type": "subtitle", "time": 9188.469, "timestamp": "02:33:08", "text": "Not a goodbye, but a gift."}, {"type": "subtitle", "time": 9192.63, "timestamp": "02:33:12", "text": "For in this vast universe, every light"}, {"type": "subtitle", "time": 9196.469, "timestamp": "02:33:16", "text": "leaves his mark. Every path creates its"}, {"type": "subtitle", "time": 9200.55, "timestamp": "02:33:20", "text": "story. Every star teaches us how to"}, {"type": "subtitle", "time": 9203.19, "timestamp": "02:33:23", "text": "shine."}, {"type": "subtitle", "time": 9206.79, "timestamp": "02:33:26", "text": "So here's to the stars we have been, the"}, {"type": "subtitle", "time": 9209.11, "timestamp": "02:33:29", "text": "lights we have shed, and the"}, {"type": "subtitle", "time": 9212.07, "timestamp": "02:33:32", "text": "constellations we are yet to form."}, {"type": "subtitle", "time": 9216.07, "timestamp": "02:33:36", "text": "Keep shining, dear stars. Your light is"}, {"type": "subtitle", "time": 9220.79, "timestamp": "02:33:40", "text": "the part of my story now as I hope mine"}]
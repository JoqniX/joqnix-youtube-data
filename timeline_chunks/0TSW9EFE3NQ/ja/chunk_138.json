[{"type": "subtitle", "time": 8281.03, "timestamp": "02:18:01", "text": "基本的な"}, {"type": "subtitle", "time": 8285.03, "timestamp": "02:18:05", "text": "スキルレベル、"}, {"type": "subtitle", "time": 8287.75, "timestamp": "02:18:07", "text": "中級レベル、あるいは"}, {"type": "subtitle", "time": 8291.75, "timestamp": "02:18:11", "text": "色を塗るなどのスキルレベルに到達するには、何千枚もの絵を描かなければなりません。"}, {"type": "subtitle", "time": 8294.07, "timestamp": "02:18:14", "text": "ええ、1枚か2枚か"}, {"type": "subtitle", "time": 8297.509, "timestamp": "02:18:17", "text": "5枚の絵を描くだけでも十分です。なぜなら、"}, {"type": "subtitle", "time": 8299.99, "timestamp": "02:18:19", "text": "アートは決して学ぶことを止められないものだからです"}, {"type": "subtitle", "time": 8303.19, "timestamp": "02:18:23", "text": "。 毎日、"}, {"type": "subtitle", "time": 8305.75, "timestamp": "02:18:25", "text": "学ぶべきことがたくさんあります。"}, {"type": "subtitle", "time": 8337.83, "timestamp": "02:18:57", "text": "[音楽]"}]
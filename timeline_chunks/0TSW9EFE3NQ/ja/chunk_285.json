[{"type": "subtitle", "time": 17110.47, "timestamp": "04:45:10", "text": "。装備はわかっているので、わかりましたと"}, {"type": "subtitle", "time": 17117.67, "timestamp": "04:45:17", "text": "言います。"}, {"type": "subtitle", "time": 17120.47, "timestamp": "04:45:20", "text": "待ってください。わかりました。マウスホイール。わかりました。マウス"}, {"type": "subtitle", "time": 17123.75, "timestamp": "04:45:23", "text": "ホイール。わかりました。わかりました。わかりました。"}, {"type": "subtitle", "time": 17126.47, "timestamp": "04:45:26", "text": "これは良いです。"}, {"type": "subtitle", "time": 17128.788, "timestamp": "04:45:28", "text": "わかりました。これを"}, {"type": "subtitle", "time": 17131.43, "timestamp": "04:45:31", "text": "短くします。Sh 短距離。"}, {"type": "subtitle", "time": 17133.51, "timestamp": "04:45:33", "text": "短い方をします。長距離、長い"}, {"type": "subtitle", "time": 17154.07, "timestamp": "04:45:54", "text": "、彼らは祈りをしています。"}, {"type": "subtitle", "time": 17155.67, "timestamp": "04:45:55", "text": "祈りの後、"}]
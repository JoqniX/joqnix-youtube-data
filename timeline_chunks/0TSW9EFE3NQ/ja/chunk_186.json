[{"type": "subtitle", "time": 11165.269, "timestamp": "03:06:05", "text": "、アメリカ。 よし、ロシアだよね？ よし、チーム"}, {"type": "subtitle", "time": 11169.349, "timestamp": "03:06:09", "text": "メイトのところにリスポーンするよ。"}, {"type": "subtitle", "time": 11173.349, "timestamp": "03:06:13", "text": "戦闘時に適用する。 わかった。"}, {"type": "subtitle", "time": 11181.67, "timestamp": "03:06:21", "text": "派遣すればいいですか？ わかった。 展開する。 何？   来て"}, {"type": "subtitle", "time": 11185.429, "timestamp": "03:06:25", "text": "。 展開する。   何てことだ"}, {"type": "subtitle", "time": 11192.87, "timestamp": "03:06:32", "text": "、いいよ。 配備します。 うん。"}, {"type": "subtitle", "time": 11196.63, "timestamp": "03:06:36", "text": "ソニックのスポーン。 わかった。 展開する。 今行ってる。   チーム"}, {"type": "subtitle", "time": 11210.63, "timestamp": "03:06:50", "text": "ああ、彼らはチームメイトだ。 私は、私は、私は終わりました"}, {"type": "subtitle", "time": 11217.67, "timestamp": "03:06:57", "text": "ああ、なんてことだ、あの鎧。"}, {"type": "subtitle", "time": 11219.91, "timestamp": "03:06:59", "text": "何？"}]
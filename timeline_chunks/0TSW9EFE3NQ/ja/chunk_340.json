[{"type": "subtitle", "time": 20401.35, "timestamp": "05:40:01", "text": "技術的には出られないようですね"}, {"type": "subtitle", "time": 20403.19, "timestamp": "05:40:03", "text": "。"}, {"type": "subtitle", "time": 20406.948, "timestamp": "05:40:06", "text": "それとも、どれくらい遠くまで？どうするんですか？"}, {"type": "subtitle", "time": 20409.51, "timestamp": "05:40:09", "text": "パン。こんにちは、ブラッド。こんにちは。"}, {"type": "subtitle", "time": 20412.15, "timestamp": "05:40:12", "text": "今日は良い一日を。あなたの友達は"}, {"type": "subtitle", "time": 20416.15, "timestamp": "05:40:16", "text": "誰ですか？わかりました。AM"}, {"type": "subtitle", "time": 20427.91, "timestamp": "05:40:27", "text": "はい、ジョッキーと呼んでください。はい、私のジョッキーと呼んでください。"}, {"type": "subtitle", "time": 20432.948, "timestamp": "05:40:32", "text": "誰が私をジョッキーと呼ぶのですか？"}, {"type": "subtitle", "time": 20435.99, "timestamp": "05:40:35", "text": "迷路です。ああ、迷路です。"}, {"type": "subtitle", "time": 20437.83, "timestamp": "05:40:37", "text": "ただ突き刺すだけです。"}, {"type": "subtitle", "time": 20440.548, "timestamp": "05:40:40", "text": "最後にシナモンロールがあると思います。"}, {"type": "subtitle", "time": 20442.15, "timestamp": "05:40:42", "text": "シナモンロールって何ですか？"}, {"type": "subtitle", "time": 20444.708, "timestamp": "05:40:44", "text": "シナモンロールが何なのかわかりません。ええ、そうです。私も聞いたことがあります。それは"}, {"type": "subtitle", "time": 20446.788, "timestamp": "05:40:46", "text": "何ですか？"}, {"type": "subtitle", "time": 20450.39, "timestamp": "05:40:50", "text": "甘いパンのようなものですか？"}, {"type": "subtitle", "time": 20452.948, "timestamp": "05:40:52", "text": "シナモンロールって何ですか？つまり、"}, {"type": "subtitle", "time": 20455.99, "timestamp": "05:40:55", "text": "食べるものですが、人々は「ああ、"}, {"type": "subtitle", "time": 20458.15, "timestamp": "05:40:58", "text": "この人はシナモン"}]
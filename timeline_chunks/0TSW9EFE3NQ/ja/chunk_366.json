[{"type": "subtitle", "time": 21964.708, "timestamp": "06:06:04", "text": "エンティティ危険クラス2の奥の部屋のさらに暗いエリアで撮影された。"}, {"type": "subtitle", "time": 21967.51, "timestamp": "06:06:07", "text": "これだ。ああ、大変だ。待って。つまり、それは、えーと、"}, {"type": "subtitle", "time": 21971.83, "timestamp": "06:06:11", "text": "暗闇の中にいるということ？"}, {"type": "subtitle", "time": 21976.31, "timestamp": "06:06:16", "text": "インベントリを開くにはどうすればいいですか？"}, {"type": "subtitle", "time": 21980.11, "timestamp": "06:06:20", "text": "ニュースドロップ情報を使います。"}, {"type": "subtitle", "time": 21981.35, "timestamp": "06:06:21", "text": "[音楽] もう"}, {"type": "subtitle", "time": 21983.67, "timestamp": "06:06:23", "text": "一つを取ってもいいですよ。"}, {"type": "subtitle", "time": 21985.75, "timestamp": "06:06:25", "text": "私は1つ取りました。"}, {"type": "subtitle", "time": 21988.628, "timestamp": "06:06:28", "text": "ああ、わかった。これをもらうよ。"}, {"type": "subtitle", "time": 21992.07, "timestamp": "06:06:32", "text": "やあ。待って。もう一つある。"}, {"type": "subtitle", "time": 21997.43, "timestamp": "06:06:37", "text": "うん。うん。暗闇の中にいるんだね。なるほど。"}, {"type": "subtitle", "time": 21999.75, "timestamp": "06:06:39", "text": "そしてこのメ​​モ。"}, {"type": "subtitle", "time": 22003.11, "timestamp": "06:06:43", "text": "アーモンド水。怪我をしているのか？"}, {"type": "subtitle", "time": 22007.11, "timestamp": "06:06:47", "text": "アーモンド水を飲んで魂を癒す。わかった、"}, {"type": "subtitle", "time": 22009.35, "timestamp": "06:06:49", "text": "一つもらうよ。アーモンド水。アーモンド"}, {"type": "subtitle", "time": 22013.43, "timestamp": "06:06:53", "text": "水。うん。このラジオは何だ？"}, {"type": "subtitle", "time": 22017.83, "timestamp": "06:06:57", "text": "怪我をしているのか？これは傷のためのものだ。"}]
[{"type": "subtitle", "time": 4443.43, "timestamp": "01:14:03", "text": "ああ、私たちは"}, {"type": "subtitle", "time": 4463.59, "timestamp": "01:14:23", "text": "プレイヤーのようです。ええと、"}, {"type": "subtitle", "time": 4465.99, "timestamp": "01:14:25", "text": "注意する必要があると言いました。"}, {"type": "subtitle", "time": 4468.31, "timestamp": "01:14:28", "text": "オーケー、プレイヤーはこのボールの隣に行きました"}, {"type": "subtitle", "time": 4478.39, "timestamp": "01:14:38", "text": "プレイヤーはプレイできます。"}, {"type": "subtitle", "time": 4484.87, "timestamp": "01:14:44", "text": "ええ。パイロ、ハイドロ、カイロ、パイロ、ハイドロ、"}, {"type": "subtitle", "time": 4488.23, "timestamp": "01:14:48", "text": "カイロ、そしてオイル。"}, {"type": "subtitle", "time": 4499.59, "timestamp": "01:14:59", "text": "[音楽]"}]
[{"type": "subtitle", "time": 21241.11, "timestamp": "05:54:01", "text": "待って、私の、ああ、待って、待って、待って。私の"}, {"type": "subtitle", "time": 21243.59, "timestamp": "05:54:03", "text": "ゲームがない。"}, {"type": "subtitle", "time": 21251.19, "timestamp": "05:54:11", "text": "設定させて。何？えっと、"}, {"type": "subtitle", "time": 21256.868, "timestamp": "05:54:16", "text": "ゲームを作ったばかりです。"}, {"type": "subtitle", "time": 21275.35, "timestamp": "05:54:35", "text": "魚人のスキンを選択してください。"}, {"type": "subtitle", "time": 21278.47, "timestamp": "05:54:38", "text": "ああ、Discordのオーディオをオフにした。何だって"}, {"type": "subtitle", "time": 21280.23, "timestamp": "05:54:40", "text": "？"}, {"type": "subtitle", "time": 21286.868, "timestamp": "05:54:46", "text": "待って。ああ、待って。"}, {"type": "subtitle", "time": 21290.39, "timestamp": "05:54:50", "text": "まあ、いいの？いいの？わから"}, {"type": "subtitle", "time": 21293.51, "timestamp": "05:54:53", "text": "ない。いいと思う。"}, {"type": "subtitle", "time": 21295.51, "timestamp": "05:54:55", "text": "こっちに可愛い女の子がいる。それを手に入れよう"}]
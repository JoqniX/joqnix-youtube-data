[{"type": "subtitle", "time": 9060.389, "timestamp": "02:31:00", "text": "私は"}, {"type": "subtitle", "time": 9063.429, "timestamp": "02:31:03", "text": "星々の間に物語が紡がれていると信じている。"}, {"type": "subtitle", "time": 9067.11, "timestamp": "02:31:07", "text": "私の星座では、多くの"}, {"type": "subtitle", "time": 9070.389, "timestamp": "02:31:10", "text": "星が通り過ぎていくのを眺めていた。 まばゆいばかりに"}, {"type": "subtitle", "time": 9073.27, "timestamp": "02:31:13", "text": "輝くいくつかの光が、私の空を"}, {"type": "subtitle", "time": 9075.51, "timestamp": "02:31:15", "text": "永遠に変えてしまった。"}, {"type": "subtitle", "time": 9079.429, "timestamp": "02:31:19", "text": "また、静かな光のように、私に"}, {"type": "subtitle", "time": 9082.15, "timestamp": "02:31:22", "text": "新たな輝き方を教えてくれた人もいました。"}, {"type": "subtitle", "time": 9085.429, "timestamp": "02:31:25", "text": "それぞれが、私自身の光について何かを教えてくれた"}, {"type": "subtitle", "time": 9088.07, "timestamp": "02:31:28", "text": "。"}, {"type": "subtitle", "time": 9091.83, "timestamp": "02:31:31", "text": "流れ星が輝く季節もあれば、"}, {"type": "subtitle", "time": 9095.11, "timestamp": "02:31:35", "text": "見慣れた光が"}, {"type": "subtitle", "time": 9098.95, "timestamp": "02:31:38", "text": "空を横切る新たな軌跡を描くのを眺める季節もある。そして、最も"}, {"type": "subtitle", "time": 9102.71, "timestamp": "02:31:42", "text": "輝かしい瞬間とは、時に"}, {"type": "subtitle", "time": 9105.99, "timestamp": "02:31:45", "text": "私たちにこれまでとは違う輝き方を教えてくれる瞬間なのだと気づく季節もある"}, {"type": "subtitle", "time": 9107.51, "timestamp": "02:31:47", "text": "。"}, {"type": "subtitle", "time": 9111.03, "timestamp": "02:31:51", "text": "あなたもまた、自分の運命が"}, {"type": "subtitle", "time": 9114.469, "timestamp": "02:31:54", "text": "変わるのを目の当たりにし、地獄と別れの間にある光年もの重みを感じたことがあるかもしれません"}, {"type": "subtitle", "time": 9118.15, "timestamp": "02:31:58", "text": "。"}]
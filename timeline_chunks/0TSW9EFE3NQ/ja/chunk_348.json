[{"type": "subtitle", "time": 20881.99, "timestamp": "05:48:01", "text": "ハードソフトウォームボーイはいるの？ウォームボーイはいるの？"}, {"type": "subtitle", "time": 20885.43, "timestamp": "05:48:05", "text": "ウォームボーイ。コールドボーイはいるの？"}, {"type": "subtitle", "time": 20894.23, "timestamp": "05:48:14", "text": "トゲトゲボーイ。何？"}, {"type": "subtitle", "time": 20897.51, "timestamp": "05:48:17", "text": "何？ 63。H ソフトボーイが拭く。そう。"}, {"type": "subtitle", "time": 20900.868, "timestamp": "05:48:20", "text": "さあ。彼は楕円形の男の子だ。そう。"}, {"type": "subtitle", "time": 20904.868, "timestamp": "05:48:24", "text": "一度しか聞いたことがない。うん。"}, {"type": "subtitle", "time": 20906.708, "timestamp": "05:48:26", "text": "ハードボーイは家族向けじゃない。彼は"}, {"type": "subtitle", "time": 20908.548, "timestamp": "05:48:28", "text": "ソフトボーイだ。君はソフトボーイだ。みんな"}, {"type": "subtitle", "time": 20915.51, "timestamp": "05:48:35", "text": "ああ、やれやれ。今日はシャワーを浴びなかった。"}, {"type": "subtitle", "time": 20919.75, "timestamp": "05:48:39", "text": "男の子が私たちに見せるように。それで"}, {"type": "subtitle", "time": 20922.708, "timestamp": "05:48:42", "text": "足首をやらなきゃいけなかった。"}, {"type": "subtitle", "time": 20925.03, "timestamp": "05:48:45", "text": "ひどい捻挫。ああ。ああ、だめだ。気をつけて"}, {"type": "subtitle", "time": 20927.03, "timestamp": "05:48:47", "text": "。大丈夫だよ。彼は"}]
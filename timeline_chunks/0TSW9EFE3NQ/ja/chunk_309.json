[{"type": "subtitle", "time": 18549.91, "timestamp": "05:09:09", "text": "それから、ユブさんも来てくれました。来てくれてありがとう。"}, {"type": "subtitle", "time": 18552.948, "timestamp": "05:09:12", "text": "来てくれて"}, {"type": "subtitle", "time": 18557.03, "timestamp": "05:09:17", "text": "ありがとう。"}, {"type": "subtitle", "time": 18559.59, "timestamp": "05:09:19", "text": "楽しんでくれたら嬉しいです。"}, {"type": "subtitle", "time": 18561.99, "timestamp": "05:09:21", "text": "あなたもこのゲームをプレイしますよね？"}, {"type": "subtitle", "time": 18565.51, "timestamp": "05:09:25", "text": "いつか一緒にプレイしましょう。次回配信するときは、"}, {"type": "subtitle", "time": 18568.708, "timestamp": "05:09:28", "text": "Jettoから誰でも参加できるようにしようと思います"}, {"type": "subtitle", "time": 18571.91, "timestamp": "05:09:31", "text": "。そうすれば、みんなで"}, {"type": "subtitle", "time": 18576.23, "timestamp": "05:09:36", "text": "プレイして楽しめると思います。ピュー、かな。"}, {"type": "subtitle", "time": 18579.67, "timestamp": "05:09:39", "text": "うん。それから、このバトルビットというゲームをプレイしていたので、"}, {"type": "subtitle", "time": 18582.55, "timestamp": "05:09:42", "text": "おすすめから私の配信を見つけてくれた新しい人が"}, {"type": "subtitle", "time": 18586.55, "timestamp": "05:09:46", "text": "Fat"}, {"type": "subtitle", "time": 18588.948, "timestamp": "05:09:48", "text": "Catsさんです。Fat Catsさん、今日来てくれてありがとう"}, {"type": "subtitle", "time": 18591.51, "timestamp": "05:09:51", "text": "。本当に本当に嬉しいです。"}, {"type": "subtitle", "time": 18593.51, "timestamp": "05:09:53", "text": "見つけてくれてありがとう。 私、私をチェックしたり"}, {"type": "subtitle", "time": 18596.31, "timestamp": "05:09:56", "text": "色々。今日は楽しんでいただけたでしょうか。"}, {"type": "subtitle", "time": 18599.83, "timestamp": "05:09:59", "text": "今後の"}]
[{"type": "subtitle", "time": 18660.948, "timestamp": "05:11:00", "text": "大変だろうけど、頑張って。君ならできるよ"}, {"type": "subtitle", "time": 18669.59, "timestamp": "05:11:09", "text": "うん。それからサカマがやってきた。なんてこった。"}, {"type": "subtitle", "time": 18673.11, "timestamp": "05:11:13", "text": "チャットでサクラを見たのはずっとぶりだ。"}, {"type": "subtitle", "time": 18676.15, "timestamp": "05:11:16", "text": "一度だけ。いや、目が二つあると思う。でも"}, {"type": "subtitle", "time": 18680.47, "timestamp": "05:11:20", "text": "、サクラ、来てくれてありがとう"}, {"type": "subtitle", "time": 18683.03, "timestamp": "05:11:23", "text": "。"}, {"type": "subtitle", "time": 18684.788, "timestamp": "05:11:24", "text": "ああ、これも試してみるべきだよ。"}, {"type": "subtitle", "time": 18687.35, "timestamp": "05:11:27", "text": "いいFPSゲームだよ"}, {"type": "subtitle", "time": 18689.19, "timestamp": "05:11:29", "text": "自分の声を使ったり、"}, {"type": "subtitle", "time": 18690.948, "timestamp": "05:11:30", "text": "他の人の声を聞いたりできる場所です"}, {"type": "subtitle", "time": 18692.55, "timestamp": "05:11:32", "text": "。"}, {"type": "subtitle", "time": 18695.91, "timestamp": "05:11:35", "text": "ピクセル"}, {"type": "subtitle", "time": 18699.99, "timestamp": "05:11:39", "text": "ゲームかRobloxのような感じですね。"}, {"type": "subtitle", "time": 18708.47, "timestamp": "05:11:48", "text": "[音楽]"}, {"type": "subtitle", "time": 18711.91, "timestamp": "05:11:51", "text": "それから、"}, {"type": "subtitle", "time": 18715.27, "timestamp": "05:11:55", "text": "今日はNinjaが来てくれました。Ninja、"}]
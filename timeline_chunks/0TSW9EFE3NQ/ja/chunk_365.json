[{"type": "subtitle", "time": 21901.43, "timestamp": "06:05:01", "text": "読める？読めないよ。あ、"}, {"type": "subtitle", "time": 21903.59, "timestamp": "06:05:03", "text": "待って。 読んでください。あ、待って。うん。うん。うん。"}, {"type": "subtitle", "time": 21906.47, "timestamp": "06:05:06", "text": "今は読めるよ。潜む暗闇の中で、"}, {"type": "subtitle", "time": 21908.47, "timestamp": "06:05:08", "text": "情報"}, {"type": "subtitle", "time": 21911.51, "timestamp": "06:05:11", "text": "エンティティ3ファイルは機密扱い。"}, {"type": "subtitle", "time": 21913.91, "timestamp": "06:05:13", "text": "潜む暗闇の中で、これらの壁は"}, {"type": "subtitle", "time": 21917.11, "timestamp": "06:05:17", "text": "何か神秘的なものを隠している。影"}, {"type": "subtitle", "time": 21919.91, "timestamp": "06:05:19", "text": "から際立つ明るく微笑むもの"}, {"type": "subtitle", "time": 21923.83, "timestamp": "06:05:23", "text": "。噂では、人間の目には"}, {"type": "subtitle", "time": 21926.39, "timestamp": "06:05:26", "text": "見えない物理的な体を持っていると言われている"}, {"type": "subtitle", "time": 21929.59, "timestamp": "06:05:29", "text": "。それが"}, {"type": "subtitle", "time": 21934.23, "timestamp": "06:05:34", "text": "すべての光源に付着し、"}, {"type": "subtitle", "time": 21937.03, "timestamp": "06:05:37", "text": "あなたを影の虚無に閉じ込めることだけが知られている"}, {"type": "subtitle", "time": 21939.11, "timestamp": "06:05:39", "text": "。おそらくあなたは二度と"}, {"type": "subtitle", "time": 21943.19, "timestamp": "06:05:43", "text": "光を見ることはないだろう。抱きしめて。わかった。覚えておいて、"}, {"type": "subtitle", "time": 21945.91, "timestamp": "06:05:45", "text": "笑顔は必ずしも平和を反映しているわけではない。"}, {"type": "subtitle", "time": 21948.548, "timestamp": "06:05:48", "text": "それは、それは、それは、まったく反対ではないにしても、まったくその"}, {"type": "subtitle", "time": 21950.868, "timestamp": "06:05:50", "text": "逆だ。覚えておいて、笑顔は"}, {"type": "subtitle", "time": 21953.19, "timestamp": "06:05:53", "text": "平和を反映しているわけではない。実際には、まったく"}, {"type": "subtitle", "time": 21956.07, "timestamp": "06:05:56", "text": "その逆だ。参照。次の写真は、"}]
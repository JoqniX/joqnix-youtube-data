[{"type": "subtitle", "time": 20040.948, "timestamp": "05:34:00", "text": "？うん。"}, {"type": "subtitle", "time": 20052.23, "timestamp": "05:34:12", "text": "シャワーがちゃんと動いてくれればいいのに。"}, {"type": "subtitle", "time": 20054.708, "timestamp": "05:34:14", "text": "えっと、いつアップデートしたんですか？"}, {"type": "subtitle", "time": 20057.51, "timestamp": "05:34:17", "text": "つまり、いつアップデートしたんですか？"}, {"type": "subtitle", "time": 20061.19, "timestamp": "05:34:21", "text": "えーっと、3時に設定を始めました。"}, {"type": "subtitle", "time": 20065.03, "timestamp": "05:34:25", "text": "ああ、3時。ああ、3時。分からない。"}, {"type": "subtitle", "time": 20069.43, "timestamp": "05:34:29", "text": "何か悪いことが起こったらどうしようという不安があるんです。だから、"}, {"type": "subtitle", "time": 20073.03, "timestamp": "05:34:33", "text": "事前に準備しておいた方がいいんです。ええ。それで、"}, {"type": "subtitle", "time": 20080.548, "timestamp": "05:34:40", "text": "何らかの理由でアップデートするのに少し時間がかかったと思います。分かりません。10分か"}, {"type": "subtitle", "time": 20082.15, "timestamp": "05:34:42", "text": "15"}, {"type": "subtitle", "time": 20084.948, "timestamp": "05:34:44", "text": "分くらいかかったと思います。大丈夫です。"}, {"type": "subtitle", "time": 20087.67, "timestamp": "05:34:47", "text": "待てるよ。"}, {"type": "subtitle", "time": 20091.27, "timestamp": "05:34:51", "text": "あぁ、君がスタッドをするのを見てもいいかも。"}, {"type": "subtitle", "time": 20093.03, "timestamp": "05:34:53", "text": "たぶん、わからない。いや、いや、いや。"}, {"type": "subtitle", "time": 20096.708, "timestamp": "05:34:56", "text": "一人ではプレイしないよ。"}, {"type": "subtitle", "time": 20098.788, "timestamp": "05:34:58", "text": "だから、一緒に行って、"}]
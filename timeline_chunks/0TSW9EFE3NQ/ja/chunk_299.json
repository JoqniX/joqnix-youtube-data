[{"type": "subtitle", "time": 17943.35, "timestamp": "04:59:03", "text": "レールグリーンレーザーがある。70"}, {"type": "subtitle", "time": 17951.51, "timestamp": "04:59:11", "text": "キル。ああ、拡張には290必要だ。わかった、"}, {"type": "subtitle", "time": 17956.55, "timestamp": "04:59:16", "text": "これだよ。私が言ってるのはこれだ。"}, {"type": "subtitle", "time": 17962.07, "timestamp": "04:59:22", "text": "エリアではできない。"}, {"type": "subtitle", "time": 17964.628, "timestamp": "04:59:24", "text": "ああ、できるよ。わかった。"}, {"type": "subtitle", "time": 17966.788, "timestamp": "04:59:26", "text": "アイアンサイトのほうが好きだ。それはエイム"}, {"type": "subtitle", "time": 17970.55, "timestamp": "04:59:30", "text": "やエイミングなどに良い。"}, {"type": "subtitle", "time": 17977.99, "timestamp": "04:59:37", "text": "マウスがこんな風なのはちょっと悲しい"}]
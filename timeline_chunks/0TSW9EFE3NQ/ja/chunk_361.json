[{"type": "subtitle", "time": 21663.67, "timestamp": "06:01:03", "text": "。インベントリに装備して、ラジオをフラッシュ、ホイッスル"}, {"type": "subtitle", "time": 21668.23, "timestamp": "06:01:08", "text": "G。わかった。ボイスチャットV、チャットを開く"}, {"type": "subtitle", "time": 21669.83, "timestamp": "06:01:09", "text": "D。待って。"}, {"type": "subtitle", "time": 21674.39, "timestamp": "06:01:14", "text": "ああ、だめだ。テンキーがない。"}, {"type": "subtitle", "time": 21676.31, "timestamp": "06:01:16", "text": "ああ、待って。このアクションを1、2、3、5に設定する必要があります"}, {"type": "subtitle", "time": 21680.868, "timestamp": "06:01:20", "text": "。わかった、"}, {"type": "subtitle", "time": 21684.548, "timestamp": "06:01:24", "text": "適用します。矢印に従っています。はい、"}, {"type": "subtitle", "time": 21688.23, "timestamp": "06:01:28", "text": "歩いています。ああ、だめだ。なぜか、えっと、"}, {"type": "subtitle", "time": 21693.19, "timestamp": "06:01:33", "text": "なぜか、私を見て。私はとても、"}, {"type": "subtitle", "time": 21696.548, "timestamp": "06:01:36", "text": "私は、あれは何ですか？"}, {"type": "subtitle", "time": 21698.07, "timestamp": "06:01:38", "text": "待って、"}, {"type": "subtitle", "time": 21702.31, "timestamp": "06:01:42", "text": "待って。あれはあなたの車ですか？はい、大丈夫です。"}, {"type": "subtitle", "time": 21705.51, "timestamp": "06:01:45", "text": "それはあなたを見ています 逃げろ。逃げるのが見えてる。"}, {"type": "subtitle", "time": 21709.67, "timestamp": "06:01:49", "text": "何？そう。"}, {"type": "subtitle", "time": 21712.39, "timestamp": "06:01:52", "text": "ポスターは"}, {"type": "subtitle", "time": 21717.27, "timestamp": "06:01:57", "text": "文字のはしごのところにある。"}]
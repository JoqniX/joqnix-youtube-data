[{"type": "subtitle", "time": 19744.23, "timestamp": "05:29:04", "text": "、これから私たちにやってくるものだと思う。なんてこった。それから、わから"}, {"type": "subtitle", "time": 19746.39, "timestamp": "05:29:06", "text": "ない。"}, {"type": "subtitle", "time": 19749.27, "timestamp": "05:29:09", "text": "これについてどう感じているのかわからない。"}, {"type": "subtitle", "time": 19751.03, "timestamp": "05:29:11", "text": "最初は、"}, {"type": "subtitle", "time": 19753.83, "timestamp": "05:29:13", "text": "SCPみたいなもの、"}, {"type": "subtitle", "time": 19756.548, "timestamp": "05:29:16", "text": "オレンジ色の"}, {"type": "subtitle", "time": 19759.99, "timestamp": "05:29:19", "text": "スーツを着て、いろいろな場所を調査するようなものだと思った。うん"}, {"type": "subtitle", "time": 19763.83, "timestamp": "05:29:23", "text": "。でも、これからどうなるかわからない"}, {"type": "subtitle", "time": 19765.35, "timestamp": "05:29:25", "text": "。"}, {"type": "subtitle", "time": 19773.43, "timestamp": "05:29:33", "text": "え？あれは、えーと、カメラみたいなもんだよね？"}, {"type": "subtitle", "time": 19775.91, "timestamp": "05:29:35", "text": "カメラみたいな。そう。"}, {"type": "subtitle", "time": 19779.75, "timestamp": "05:29:39", "text": "カメラを持って、カメラと一緒に動いて、なんて言うんだっけ"}, {"type": "subtitle", "time": 19783.67, "timestamp": "05:29:43", "text": "？そういう"}, {"type": "subtitle", "time": 19786.39, "timestamp": "05:29:46", "text": "ゲームが1つあったよね。そう、"}, {"type": "subtitle", "time": 19789.03, "timestamp": "05:29:49", "text": "バイオハザードのゲームにそういうのがあったけど、私は"}, {"type": "subtitle", "time": 19791.03, "timestamp": "05:29:51", "text": "プレイしたことがない。"}, {"type": "subtitle", "time": 19796.47, "timestamp": "05:29:56", "text": "バイオハザードはプレイしたことがない。ただ見ただけ。"}]
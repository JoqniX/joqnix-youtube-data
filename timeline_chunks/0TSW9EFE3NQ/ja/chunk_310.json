[{"type": "subtitle", "time": 18601.83, "timestamp": "05:10:01", "text": "配信などでお会いできることを楽しみにしています。また"}, {"type": "subtitle", "time": 18603.91, "timestamp": "05:10:03", "text": "来てくれてありがとう。それから、"}, {"type": "subtitle", "time": 18608.708, "timestamp": "05:10:08", "text": "あの王様が今日来てくれました"}, {"type": "subtitle", "time": 18611.43, "timestamp": "05:10:11", "text": "。"}, {"type": "subtitle", "time": 18614.23, "timestamp": "05:10:14", "text": "来てくれてありがとう。"}, {"type": "subtitle", "time": 18617.43, "timestamp": "05:10:17", "text": "今日は楽しんでいただけたでしょうか。"}, {"type": "subtitle", "time": 18622.868, "timestamp": "05:10:22", "text": "来てくれてありがとう。本当に感謝しています"}, {"type": "subtitle", "time": 18625.03, "timestamp": "05:10:25", "text": "。本当に本当にありがとう。今日は楽しんでいただけたでしょ"}, {"type": "subtitle", "time": 18635.03, "timestamp": "05:10:35", "text": "うか。バブは偉大だ。バブシャ、今日来てくれてありがとう"}, {"type": "subtitle", "time": 18638.31, "timestamp": "05:10:38", "text": "。今日は楽しんでいただけたでしょうか。本当に本当にありがとう。"}, {"type": "subtitle", "time": 18640.39, "timestamp": "05:10:40", "text": "素敵な夜をお過ごしください。"}, {"type": "subtitle", "time": 18642.868, "timestamp": "05:10:42", "text": "悪魔がやってきた。彼らは悪魔"}, {"type": "subtitle", "time": 18646.39, "timestamp": "05:10:46", "text": "シャマを捕まえた。"}, {"type": "subtitle", "time": 18649.43, "timestamp": "05:10:49", "text": "今日は楽しんでいただけたでしょうか。それから、仕事でガンバーも。そう、"}, {"type": "subtitle", "time": 18651.35, "timestamp": "05:10:51", "text": "仕事で。"}, {"type": "subtitle", "time": 18653.59, "timestamp": "05:10:53", "text": "仕事とかあるよね？夜の"}, {"type": "subtitle", "time": 18657.59, "timestamp": "05:10:57", "text": "仕事。私は夜の仕事とかが好きなんです。だから"}]
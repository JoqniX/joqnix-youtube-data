[{"type": "subtitle", "time": 21003.35, "timestamp": "05:50:03", "text": "パソコンに入れるだけの空き容量がないんだ。"}, {"type": "subtitle", "time": 21006.07, "timestamp": "05:50:06", "text": "うん。空き容量。プレイしたい。うん、"}, {"type": "subtitle", "time": 21012.23, "timestamp": "05:50:12", "text": "ずっとプレイしたいんだけど、できないんだ。"}, {"type": "subtitle", "time": 21015.27, "timestamp": "05:50:15", "text": "それで、ちょっと待って、レース ゲームは好き？"}, {"type": "subtitle", "time": 21019.03, "timestamp": "05:50:19", "text": "レース ゲーム大好き。さあ行こう。君が"}, {"type": "subtitle", "time": 21022.628, "timestamp": "05:50:22", "text": "Asphalt をプレイしているのを一度見たことがあるよ。うん、"}, {"type": "subtitle", "time": 21025.35, "timestamp": "05:50:25", "text": "Asphalt はプレイしたけど、まあ、成長して飽きちゃったんだよね"}, {"type": "subtitle", "time": 21028.39, "timestamp": "05:50:28", "text": "。うん。それで、"}, {"type": "subtitle", "time": 21031.11, "timestamp": "05:50:31", "text": "プレイしなくなった。"}, {"type": "subtitle", "time": 21033.99, "timestamp": "05:50:33", "text": "でも、そうだね。それで、"}, {"type": "subtitle", "time": 21036.15, "timestamp": "05:50:36", "text": "スピード系のゲームはプレイしたことある？"}, {"type": "subtitle", "time": 21040.31, "timestamp": "05:50:40", "text": "テンポの速いゲーム。いや、Need for Speed"}, {"type": "subtitle", "time": 21042.47, "timestamp": "05:50:42", "text": "Racing は。Need for は"}, {"type": "subtitle", "time": 21044.708, "timestamp": "05:50:44", "text": "子供の頃にプレイしたことがある。プレイしたことがある。Need for"}, {"type": "subtitle", "time": 21048.548, "timestamp": "05:50:48", "text": "Speed。同じ。うん、あの"}, {"type": "subtitle", "time": 21051.03, "timestamp": "05:50:51", "text": "時はプレイしたよ。実はデスクトップを持ってたんだ。PC を持ってたんだ"}, {"type": "subtitle", "time": 21056.868, "timestamp": "05:50:56", "text": "けど、そこに入れたんだ。"}, {"type": "subtitle", "time": 21059.51, "timestamp": "05:50:59", "text": "でも、しばらくして、私のPCが"}]
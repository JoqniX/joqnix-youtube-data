[{"type": "subtitle", "time": 19201.91, "timestamp": "05:20:01", "text": "今日は、Starscape"}, {"type": "subtitle", "time": 19204.788, "timestamp": "05:20:04", "text": "のLuchi Zuraと一緒に背景の中で遊んでいます。"}, {"type": "subtitle", "time": 19208.55, "timestamp": "05:20:08", "text": "彼女はライブ配信をしていて、私も"}, {"type": "subtitle", "time": 19210.47, "timestamp": "05:20:10", "text": "ライブ配信をしています。説明にある"}, {"type": "subtitle", "time": 19213.35, "timestamp": "05:20:13", "text": "マルチウォッチリンクを使って、私たちの両方の配信を見ることができます"}, {"type": "subtitle", "time": 19216.55, "timestamp": "05:20:16", "text": "。"}, {"type": "subtitle", "time": 19220.47, "timestamp": "05:20:20", "text": "ええ、今日は楽しんでいただければと思います。"}, {"type": "subtitle", "time": 19223.67, "timestamp": "05:20:23", "text": "ああ、そうです"}, {"type": "subtitle", "time": 19226.628, "timestamp": "05:20:26", "text": "。待って、"}, {"type": "subtitle", "time": 19229.83, "timestamp": "05:20:29", "text": "Gを呼びます、待って、待って、待って"}, {"type": "subtitle", "time": 19233.83, "timestamp": "05:20:33", "text": "、待って。呼び出します。"}, {"type": "subtitle", "time": 19238.31, "timestamp": "05:20:38", "text": "よし、入ります。ええ。こんにちは。"}, {"type": "subtitle", "time": 19239.99, "timestamp": "05:20:39", "text": "ああ、待って。画面上で大きすぎます"}, {"type": "subtitle", "time": 19242.788, "timestamp": "05:20:42", "text": "。ええ。ええ、あなたも"}, {"type": "subtitle", "time": 19253.19, "timestamp": "05:20:53", "text": "ピザの上に自分を乗せましょう。ええ。"}, {"type": "subtitle", "time": 19257.67, "timestamp": "05:20:57", "text": "あなたを横に置きましょう。"}, {"type": "subtitle", "time": 19259.91, "timestamp": "05:20:59", "text": "この比率が良いかどうかわかりません。"}]
[{"type": "subtitle", "time": 8715.67, "timestamp": "02:25:15", "text": "よし、戻ってきた。戻ってきた。えっと、"}, {"type": "subtitle", "time": 8719.03, "timestamp": "02:25:19", "text": "これをスピードアップする必要がある。これをスピードアップする必要がある。"}, {"type": "subtitle", "time": 8722.23, "timestamp": "02:25:22", "text": "なぜなら、締めくくらなければならないからだ。ねえ、ねえ、"}, {"type": "subtitle", "time": 8723.83, "timestamp": "02:25:23", "text": "これをやろう。今は"}, {"type": "subtitle", "time": 8726.389, "timestamp": "02:25:26", "text": "締めくくる。後で原神の配信をしよう。"}, {"type": "subtitle", "time": 8730.07, "timestamp": "02:25:30", "text": "よし。次の日。よし。"}, {"type": "subtitle", "time": 8732.23, "timestamp": "02:25:32", "text": "うん、それでは"}, {"type": "subtitle", "time": 8735.27, "timestamp": "02:25:35", "text": "ここで配信を締めくくろう。というわけで、皆さん、"}, {"type": "subtitle", "time": 8736.87, "timestamp": "02:25:36", "text": "今日は来てくれてありがとう。今日来てくれた人たちにとって、本当に本当に"}, {"type": "subtitle", "time": 8743.59, "timestamp": "02:25:43", "text": "楽しかった。"}, {"type": "subtitle", "time": 8746.87, "timestamp": "02:25:46", "text": "ジョー、プレイしてくれてありがとう。 昨日は一緒に"}, {"type": "subtitle", "time": 8749.27, "timestamp": "02:25:49", "text": "遊んでくれてありがとう。一緒に"}, {"type": "subtitle", "time": 8752.55, "timestamp": "02:25:52", "text": "遊んでくれてありがとう。楽しかったよ。うん"}, {"type": "subtitle", "time": 8754.63, "timestamp": "02:25:54", "text": "。えっと"}, {"type": "subtitle", "time": 8757.99, "timestamp": "02:25:57", "text": "、"}]
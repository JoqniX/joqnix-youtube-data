[{"type": "subtitle", "time": 6424.95, "timestamp": "01:47:04", "text": "彼は私に似ているけど、私は"}, {"type": "subtitle", "time": 6427.51, "timestamp": "01:47:07", "text": "彼が好き。"}, {"type": "subtitle", "time": 6429.61, "timestamp": "01:47:09", "text": "さようなら。"}, {"type": "subtitle", "time": 6443.35, "timestamp": "01:47:23", "text": "私はこれを持っていない 紫色のニコラ級だ"}, {"type": "subtitle", "time": 6455.669, "timestamp": "01:47:35", "text": "アヤの装備は終わったと思う。うん、"}, {"type": "subtitle", "time": 6458.79, "timestamp": "01:47:38", "text": "レベル50の準備をするだけだ。"}, {"type": "subtitle", "time": 6461.109, "timestamp": "01:47:41", "text": "冒険ランク50には絶対行かない"}, {"type": "subtitle", "time": 6464.63, "timestamp": "01:47:44", "text": "けど、いつか準備するつもりだ。"}, {"type": "subtitle", "time": 6467.27, "timestamp": "01:47:47", "text": "[音楽]"}, {"type": "subtitle", "time": 6471.35, "timestamp": "01:47:51", "text": "これらは80だよね？うん。80。"}]
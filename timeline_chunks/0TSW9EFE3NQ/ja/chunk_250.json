[{"type": "subtitle", "time": 15032.55, "timestamp": "04:10:32", "text": "GGはどうだった？ わかった。"}, {"type": "subtitle", "time": 15037.03, "timestamp": "04:10:37", "text": "なぜ私はGGなの？"}, {"type": "subtitle", "time": 15040.389, "timestamp": "04:10:40", "text": "みんな親切だ。 有害物質のない街。"}, {"type": "subtitle", "time": 15043.83, "timestamp": "04:10:43", "text": "かっこいい。 それは本当に素晴らしいですね。"}, {"type": "subtitle", "time": 15049.189, "timestamp": "04:10:49", "text": "実際のバトルフィールド系のゲームでそれを見るのは初めてだ。"}]
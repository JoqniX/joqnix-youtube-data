[{"type": "subtitle", "time": 12841.429, "timestamp": "03:34:01", "text": "。 戻ってくる。 来て。 ああ。 わかった。"}, {"type": "subtitle", "time": 12844.15, "timestamp": "03:34:04", "text": "展開する。 わかった。   何てことだ"}, {"type": "subtitle", "time": 12853.429, "timestamp": "03:34:13", "text": "。 戻ってきました。"}, {"type": "subtitle", "time": 12858.469, "timestamp": "03:34:18", "text": "ああ、大変だ。 私は"}, {"type": "subtitle", "time": 12861.91, "timestamp": "03:34:21", "text": "Epic Gamesを修正するために呼ばれました。"}, {"type": "subtitle", "time": 12864.87, "timestamp": "03:34:24", "text": "大家さんの子供に、私のEpic Gamesアカウントで遊ばせてあげるつもりです"}, {"type": "subtitle", "time": 12867.59, "timestamp": "03:34:27", "text": "。 だから、彼は"}, {"type": "subtitle", "time": 12871.59, "timestamp": "03:34:31", "text": "認証カードのあらゆる機能を強化する必要がある。 私はどこへ行くのでしょうか"}, {"type": "subtitle", "time": 12894.309, "timestamp": "03:34:54", "text": "君たちはダジャレの入った"}]
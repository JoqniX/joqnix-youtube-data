[{"type": "subtitle", "time": 20221.11, "timestamp": "05:37:01", "text": "バックルーム探検へ。バックルーム。"}, {"type": "subtitle", "time": 20224.39, "timestamp": "05:37:04", "text": "たくさんあります。"}, {"type": "subtitle", "time": 20226.788, "timestamp": "05:37:06", "text": "普通のバックルーム。レトロバック"}, {"type": "subtitle", "time": 20229.51, "timestamp": "05:37:09", "text": "ルーム。すごい"}, {"type": "subtitle", "time": 20232.868, "timestamp": "05:37:12", "text": "。なんてことだ。 奥の部屋にスレンダーマンがいる"}, {"type": "subtitle", "time": 20234.868, "timestamp": "05:37:14", "text": "。怖い。恐怖の恐怖。怖い。"}, {"type": "subtitle", "time": 20237.99, "timestamp": "05:37:17", "text": "ああ、あれはニコの次のボットじゃない。"}, {"type": "subtitle", "time": 20240.31, "timestamp": "05:37:20", "text": "奥の部屋。たくさん"}, {"type": "subtitle", "time": 20243.35, "timestamp": "05:37:23", "text": "ある。すごい。たくさんある。"}, {"type": "subtitle", "time": 20248.788, "timestamp": "05:37:28", "text": "大変なことだ。うん。"}, {"type": "subtitle", "time": 20250.7, "timestamp": "05:37:30", "text": "奥の部屋。"}, {"type": "subtitle", "time": 20252.788, "timestamp": "05:37:32", "text": "[音楽]"}, {"type": "subtitle", "time": 20256.628, "timestamp": "05:37:36", "text": "何？コミュニティでは大変なことなんだ。"}, {"type": "subtitle", "time": 20266.548, "timestamp": "05:37:46", "text": "こんにちは。そしてもう一人の人は"}, {"type": "subtitle", "time": 20268.39, "timestamp": "05:37:48", "text": "ジョーニー。"}, {"type": "subtitle", "time": 20271.51, "timestamp": "05:37:51", "text": "ああ、言い忘れた。"}, {"type": "subtitle", "time": 20275.51, "timestamp": "05:37:55", "text": "みなさんこんにちは。私はズーです。ズーチアです。そして、私と一緒にいるこの"}, {"type": "subtitle", "time": 20278.31, "timestamp": "05:37:58", "text": "人はジョークニックスです。"}]
[{"type": "subtitle", "time": 20464.868, "timestamp": "05:41:04", "text": "。 さあ、友達をジョイと呼んでください"}, {"type": "subtitle", "time": 20467.99, "timestamp": "05:41:07", "text": "。ええ、ジョキと呼んでもいいですよ。"}, {"type": "subtitle", "time": 20470.23, "timestamp": "05:41:10", "text": "目的：生き延びて脱出方法を見つけること。"}, {"type": "subtitle", "time": 20472.708, "timestamp": "05:41:12", "text": "それが目的です。"}, {"type": "subtitle", "time": 20474.31, "timestamp": "05:41:14", "text": "バックルームには生き延びること以外に目的はありません"}, {"type": "subtitle", "time": 20483.99, "timestamp": "05:41:23", "text": "。出口があります。これはとても美味しそうですね。"}, {"type": "subtitle", "time": 20485.75, "timestamp": "05:41:25", "text": "でも、"}, {"type": "subtitle", "time": 20488.868, "timestamp": "05:41:28", "text": "将来、今まで食べたことのないものを食べてみたいですか"}, {"type": "subtitle", "time": 20490.548, "timestamp": "05:41:30", "text": "？将来、今まで食べたことのない"}, {"type": "subtitle", "time": 20494.39, "timestamp": "05:41:34", "text": "ものを食べてみたいですか"}, {"type": "subtitle", "time": 20497.99, "timestamp": "05:41:37", "text": "？今まで食べたことがない"}, {"type": "subtitle", "time": 20516.548, "timestamp": "05:41:56", "text": "[笑い] それは何"}, {"type": "subtitle", "time": 20519.35, "timestamp": "05:41:59", "text": "？彼がそれを理解するのに少し時間がかかりました"}]
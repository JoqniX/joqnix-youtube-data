[{"type": "subtitle", "time": 13620.71, "timestamp": "03:47:00", "text": "良い地図だった。"}, {"type": "subtitle", "time": 13626.55, "timestamp": "03:47:06", "text": "待って、いや。 待って。 え、何？ もし私が、支配の"}, {"type": "subtitle", "time": 13629.189, "timestamp": "03:47:09", "text": "次には何も言わないと言ったらどうなるだろうか"}, {"type": "subtitle", "time": 13636.87, "timestamp": "03:47:16", "text": "32は30だった。もっと大きな選手のようにプレーしたい"}, {"type": "subtitle", "time": 13639.11, "timestamp": "03:47:19", "text": "。 接続を解除します。 私はすごく"}, {"type": "subtitle", "time": 13645.51, "timestamp": "03:47:25", "text": "32. 私たちは32を経験しました。今度は"}, {"type": "subtitle", "time": 13659.429, "timestamp": "03:47:39", "text": "えっと、ビデオじゃなくてビデオですね。 どちらだったのですか？"}, {"type": "subtitle", "time": 13663.11, "timestamp": "03:47:43", "text": "えっと、ゲームプレイ。   わかった"}, {"type": "subtitle", "time": 13665.99, "timestamp": "03:47:45", "text": "。 ストリーマーボード。"}, {"type": "subtitle", "time": 13668.389, "timestamp": "03:47:48", "text": "友達とのボイスチャット。 友達の名前。 氏族"}, {"type": "subtitle", "time": 13670.87, "timestamp": "03:47:50", "text": "名。 プロフィール。   わかった"}, {"type": "subtitle", "time": 13674.389, "timestamp": "03:47:54", "text": "。 プロフィールを表示する。 これは何ですか？"}, {"type": "subtitle", "time": 13675.83, "timestamp": "03:47:55", "text": "ストリーマーモードをオフにできますか？ 何が"}]
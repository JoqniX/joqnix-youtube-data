[{"type": "subtitle", "time": 19562.23, "timestamp": "05:26:02", "text": "うん。痛い。うん。それが一つ"}, {"type": "subtitle", "time": 19564.15, "timestamp": "05:26:04", "text": "。ジュク先輩のゲームが"}, {"type": "subtitle", "time": 19567.59, "timestamp": "05:26:07", "text": "アップデート中なんだ。うん。"}, {"type": "subtitle", "time": 19570.628, "timestamp": "05:26:10", "text": "アップデート中は96がある。うん、"}, {"type": "subtitle", "time": 19572.39, "timestamp": "05:26:12", "text": "いいチャットができるよ。うん、"}, {"type": "subtitle", "time": 19574.39, "timestamp": "05:26:14", "text": "いいチャットができるよ。"}, {"type": "subtitle", "time": 19576.39, "timestamp": "05:26:16", "text": "うん、"}, {"type": "subtitle", "time": 19579.19, "timestamp": "05:26:19", "text": "いいデザインだね。うん。ジョアイのデザインは"}, {"type": "subtitle", "time": 19581.35, "timestamp": "05:26:21", "text": "本当にいい。"}, {"type": "subtitle", "time": 19583.51, "timestamp": "05:26:23", "text": "どれ？本当にいいよ。すごくいい。"}, {"type": "subtitle", "time": 19589.91, "timestamp": "05:26:29", "text": "要素もすごくいいんだよ"}, {"type": "subtitle", "time": 19593.11, "timestamp": "05:26:33", "text": "。うん。待って、"}, {"type": "subtitle", "time": 19594.868, "timestamp": "05:26:34", "text": "君のデザイン、君のキャラクター。ああ、うんうんうん"}, {"type": "subtitle", "time": 19599.19, "timestamp": "05:26:39", "text": "。君が描いたんだね。だから"}, {"type": "subtitle", "time": 19601.51, "timestamp": "05:26:41", "text": "全部 えーと、あなたに渡されるべきです。"}, {"type": "subtitle", "time": 19603.67, "timestamp": "05:26:43", "text": "勇気は、私が描いたものです"}, {"type": "subtitle", "time": 19606.23, "timestamp": "05:26:46", "text": "が、全体的なデザインは"}, {"type": "subtitle", "time": 19609.59, "timestamp": "05:26:49", "text": "あなたのアイデアだったんですよね？ ええ。だから"}, {"type": "subtitle", "time": 19612.31, "timestamp": "05:26:52", "text": "、本当にうまくいきました。"}, {"type": "subtitle", "time": 19615.43, "timestamp": "05:26:55", "text": "このアイデア全体が、"}]
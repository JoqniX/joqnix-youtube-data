[{"type": "subtitle", "time": 840.48, "timestamp": "00:14:00", "text": "。 【音楽】"}, {"type": "subtitle", "time": 843.279, "timestamp": "00:14:03", "text": "【音楽】 彼はこの分野のプロだ。"}, {"type": "subtitle", "time": 845.64, "timestamp": "00:14:05", "text": "彼はこの分野のプロだ。 【音楽】"}, {"type": "subtitle", "time": 851.279, "timestamp": "00:14:11", "text": "【音楽】 なぜ更新されないのか分かりません。"}, {"type": "subtitle", "time": 853.6, "timestamp": "00:14:13", "text": "なぜ更新されないのか分かりません。 それはスッシュです。"}, {"type": "subtitle", "time": 871.99, "timestamp": "00:14:31", "text": "冒険は終わりに近づいている。 わかった。 また、ギルド"}, {"type": "subtitle", "time": 874.31, "timestamp": "00:14:34", "text": "から先に自分の持ち物を取り出すこともできます"}, {"type": "subtitle", "time": 876.31, "timestamp": "00:14:36", "text": "。"}, {"type": "subtitle", "time": 878.23, "timestamp": "00:14:38", "text": "ギルドから受け取らなければならないもの。"}, {"type": "subtitle", "time": 886.949, "timestamp": "00:14:46", "text": "ああ、それは派遣文字ですね。 わかった。"}, {"type": "subtitle", "time": 888.79, "timestamp": "00:14:48", "text": "私はランダムにキャラクターを選んで、それをやってみる"}, {"type": "subtitle", "time": 891.03, "timestamp": "00:14:51", "text": "。   私は自分が何を"}, {"type": "subtitle", "time": 894.31, "timestamp": "00:14:54", "text": "栽培しているのか気にしていません。"}]
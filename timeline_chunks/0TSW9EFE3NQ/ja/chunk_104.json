[{"type": "subtitle", "time": 6250.87, "timestamp": "01:44:10", "text": "この三角形のやつを手に入れたいな。オーマイゴッド、何、何、何。オーケー、スクリーンショット。スクリーン"}, {"type": "subtitle", "time": 6267.189, "timestamp": "01:44:27", "text": "ショット撮ってるよ"}, {"type": "subtitle", "time": 6269.91, "timestamp": "01:44:29", "text": "。"}, {"type": "subtitle", "time": 6273.43, "timestamp": "01:44:33", "text": "オーマイゴッド。Bを手に入れた。何？"}, {"type": "subtitle", "time": 6278.79, "timestamp": "01:44:38", "text": "待って、何？待って、何？まさか。"}, {"type": "subtitle", "time": 6281.189, "timestamp": "01:44:41", "text": "彼を手に入れた。オーマイゴッド。オーマイゴッド、彼を手に入れた。"}, {"type": "subtitle", "time": 6290.79, "timestamp": "01:44:50", "text": "すごい。じゃあ、プリムを終わらせよう。オーマイゴッド。"}, {"type": "subtitle", "time": 6295.43, "timestamp": "01:44:55", "text": "ヴァンデラマを手に入れた。オーマイゴッド。"}, {"type": "subtitle", "time": 6298.32, "timestamp": "01:44:58", "text": "オーマイゴッド。 ヴァンデラマを手に入れた。"}]
[{"type": "subtitle", "time": 13582.87, "timestamp": "03:46:22", "text": "ああ、わかった、気にしないで。 えっと、展開します。"}, {"type": "subtitle", "time": 13586.389, "timestamp": "03:46:26", "text": "彼を派遣します。 彼は亡くなった。 わかった。"}, {"type": "subtitle", "time": 13598.389, "timestamp": "03:46:38", "text": "おお。   何てことだ"}, {"type": "subtitle", "time": 13604.63, "timestamp": "03:46:44", "text": "人生よ、私を助けてください。 ああ、ありがとうございます。 彼は"}, {"type": "subtitle", "time": 13607.83, "timestamp": "03:46:47", "text": "私を引きずり出そうとしている。 何が起こっていますか？ おお。"}]
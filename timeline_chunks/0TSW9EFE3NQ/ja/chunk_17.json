[{"type": "subtitle", "time": 1025.27, "timestamp": "00:17:05", "text": "シェーブラン。"}, {"type": "subtitle", "time": 1027.829, "timestamp": "00:17:07", "text": "私は今、逃げるべきだろうか？ いいえ、しません。 じゃあ、"}, {"type": "subtitle", "time": 1030.87, "timestamp": "00:17:10", "text": "次回はそこから取り出すよ。"}, {"type": "subtitle", "time": 1032.39, "timestamp": "00:17:12", "text": "なぜそれがうまくいくはずだったのか、私には分かりません。"}, {"type": "subtitle", "time": 1034.549, "timestamp": "00:17:14", "text": "そう、"}, {"type": "subtitle", "time": 1036.309, "timestamp": "00:17:16", "text": "チャットにいる全員に、"}, {"type": "subtitle", "time": 1040.23, "timestamp": "00:17:20", "text": "ヘッドパッドみたいなものを入力している人に渡そうとしていたんだ"}, {"type": "subtitle", "time": 1052.23, "timestamp": "00:17:32", "text": "まあ、うまくいかなかったけど、まあいいか"}, {"type": "subtitle", "time": 1065.35, "timestamp": "00:17:45", "text": "[音楽]"}, {"type": "subtitle", "time": 1079.029, "timestamp": "00:17:59", "text": "【音楽】"}]
[{"type": "subtitle", "time": 9661.75, "timestamp": "02:41:01", "text": "とにかく、えーっと、"}, {"type": "subtitle", "time": 9664.15, "timestamp": "02:41:04", "text": "どこまで話したっけ？ 私はどこまで話したっけ？ 高かった。 正直に言うと"}, {"type": "subtitle", "time": 9667.03, "timestamp": "02:41:07", "text": "、Photoshopは"}, {"type": "subtitle", "time": 9671.19, "timestamp": "02:41:11", "text": "インストールしていなかったのですが、このPhotopiaというウェブサイトは"}, {"type": "subtitle", "time": 9674.71, "timestamp": "02:41:14", "text": "本当に素晴らしいです。 冗談抜きで、すごくクールだよ。"}, {"type": "subtitle", "time": 9677.19, "timestamp": "02:41:17", "text": "とても美味しいです。 とにかく、では、"}, {"type": "subtitle", "time": 9681.67, "timestamp": "02:41:21", "text": "ゲームに入りましょう。 えっと、ちょっと"}, {"type": "subtitle", "time": 9684.23, "timestamp": "02:41:24", "text": "閉じて、"}, {"type": "subtitle", "time": 9687.99, "timestamp": "02:41:27", "text": "画面をお見せしますね。   ああ"}, {"type": "subtitle", "time": 9690.15, "timestamp": "02:41:30", "text": "、"}, {"type": "subtitle", "time": 9692.309, "timestamp": "02:41:32", "text": "スマホで自分の個人情報を漏らさないように気をつけないと。"}, {"type": "subtitle", "time": 9694.15, "timestamp": "02:41:34", "text": "昨日のTwitch配信で、私は"}, {"type": "subtitle", "time": 9696.63, "timestamp": "02:41:36", "text": "自分の個人情報を3回も漏らしてしまいました。"}, {"type": "subtitle", "time": 9700.469, "timestamp": "02:41:40", "text": "ああ、なんてことだ、全部カットしたよ。"}, {"type": "subtitle", "time": 9714.07, "timestamp": "02:41:54", "text": "。 えっと、私は何をしていたんだっけ？"}, {"type": "subtitle", "time": 9718.07, "timestamp": "02:41:58", "text": "はい。 画面をお見せします。"}, {"type": "subtitle", "time": 9719.11, "timestamp": "02:41:59", "text": "ゲームを起動させてください。"}]
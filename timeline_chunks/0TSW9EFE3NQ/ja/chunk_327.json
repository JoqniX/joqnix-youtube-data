[{"type": "subtitle", "time": 19627.51, "timestamp": "05:27:07", "text": "はい。さあ、行きましょう。バックルームについて知っています。"}, {"type": "subtitle", "time": 19629.27, "timestamp": "05:27:09", "text": "バックルームについて何を知っているのですか？"}, {"type": "subtitle", "time": 19631.83, "timestamp": "05:27:11", "text": "バックルームについて何を知っているか教えてください。"}, {"type": "subtitle", "time": 19633.91, "timestamp": "05:27:13", "text": "待ってください。わかりました。私が見た限りでは、"}, {"type": "subtitle", "time": 19637.51, "timestamp": "05:27:17", "text": "バックルームは、あなたが"}, {"type": "subtitle", "time": 19642.868, "timestamp": "05:27:22", "text": "オフィスワーカーで、基本的に"}, {"type": "subtitle", "time": 19644.868, "timestamp": "05:27:24", "text": "職場で寝てしまい、目が覚めると「ここはどこだ"}, {"type": "subtitle", "time": 19648.868, "timestamp": "05:27:28", "text": "？ なんてことだ」というゲームです。"}, {"type": "subtitle", "time": 19651.51, "timestamp": "05:27:31", "text": "迷路のようなものです"}, {"type": "subtitle", "time": 19653.83, "timestamp": "05:27:33", "text": "。何が"}, {"type": "subtitle", "time": 19655.51, "timestamp": "05:27:35", "text": "実際に"}, {"type": "subtitle", "time": 19658.548, "timestamp": "05:27:38", "text": "ホラーなのかはわかりません。わかりません。"}, {"type": "subtitle", "time": 19661.19, "timestamp": "05:27:41", "text": "恐怖症よりも恐ろしいのか、それとも… 私がそうでないことを願います。"}, {"type": "subtitle", "time": 19666.31, "timestamp": "05:27:46", "text": "なぜなら、"}, {"type": "subtitle", "time": 19668.788, "timestamp": "05:27:48", "text": "人々がプレイしているのを見たとき、それほど"}, {"type": "subtitle", "time": 19671.51, "timestamp": "05:27:51", "text": "恐ろしくは見えなかったからです。しかし、それをプレイしていた人々は、"}, {"type": "subtitle", "time": 19675.75, "timestamp": "05:27:55", "text": "とても恐ろしいです。まるで史上"}, {"type": "subtitle", "time": 19677.51, "timestamp": "05:27:57", "text": "最も恐ろしいゲームか"}, {"type": "subtitle", "time": 19679.91, "timestamp": "05:27:59", "text": "何かです。私は「えっ？」「"}]
[{"type": "subtitle", "time": 19860.708, "timestamp": "05:31:00", "text": "待って。これはまるで現実の"}, {"type": "subtitle", "time": 19864.39, "timestamp": "05:31:04", "text": "出来事のようだ。ああ、違う。待って、そうなの？わから"}, {"type": "subtitle", "time": 19867.67, "timestamp": "05:31:07", "text": "ない。ああ、大変だ。これは現実の"}, {"type": "subtitle", "time": 19870.23, "timestamp": "05:31:10", "text": "出来事なの？待って。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 19873.03, "timestamp": "05:31:13", "text": "今日は素敵に見えるよ。 いや、違う。違うよ"}, {"type": "subtitle", "time": 19874.788, "timestamp": "05:31:14", "text": "。現実の経験じゃないって言ったでしょ"}, {"type": "subtitle", "time": 19876.548, "timestamp": "05:31:16", "text": "。違うよ。わかった、よかった。よかった。じゃあ、"}, {"type": "subtitle", "time": 19879.75, "timestamp": "05:31:19", "text": "Buglyを見てみて。彼女の"}, {"type": "subtitle", "time": 19882.548, "timestamp": "05:31:22", "text": "チャンネルで、昔の話をしてるんだ。ああ、わかった。ああ、"}, {"type": "subtitle", "time": 19884.07, "timestamp": "05:31:24", "text": "97%か。"}, {"type": "subtitle", "time": 19891.59, "timestamp": "05:31:31", "text": "おい、俺はホラーゲームなんてやったことないぞ。"}, {"type": "subtitle", "time": 19898.23, "timestamp": "05:31:38", "text": "同じ4つのホラーのために14個の原石を準備するなんて思わないのか"}, {"type": "subtitle", "time": 19900.628, "timestamp": "05:31:40", "text": "？"}, {"type": "subtitle", "time": 19904.39, "timestamp": "05:31:44", "text": "ああ、そうだ。見せてやるよ。2つ手に入れたんだ。そう、"}, {"type": "subtitle", "time": 19908.628, "timestamp": "05:31:48", "text": "昨日1回のTでナハを2つ手に入れたんだ。"}, {"type": "subtitle", "time": 19911.35, "timestamp": "05:31:51", "text": "早い時間で、50/50だった。"}, {"type": "subtitle", "time": 19917.59, "timestamp": "05:31:57", "text": "昨日は起こるべきではないことがたくさん起こった。なんてこった。くそ。"}]
[{"type": "subtitle", "time": 13741.99, "timestamp": "03:49:01", "text": "サイドドリルをやります。 懐中電灯を手に入れた。 わかった。"}, {"type": "subtitle", "time": 13744.07, "timestamp": "03:49:04", "text": "面白い。   他に"}, {"type": "subtitle", "time": 13747.349, "timestamp": "03:49:07", "text": "何かありますか？ 主要ガジェット。"}, {"type": "subtitle", "time": 13749.349, "timestamp": "03:49:09", "text": "何かを解錠した。"}, {"type": "subtitle", "time": 13750.71, "timestamp": "03:49:10", "text": "クレイモア。 よし、"}, {"type": "subtitle", "time": 13752.469, "timestamp": "03:49:12", "text": "クレイモアを使うことにしよう。"}, {"type": "subtitle", "time": 13756.63, "timestamp": "03:49:16", "text": "自殺C4。 よし、じゃあクレイモアで行こう。"}, {"type": "subtitle", "time": 13759.59, "timestamp": "03:49:19", "text": "展開する。"}, {"type": "subtitle", "time": 13761.51, "timestamp": "03:49:21", "text": "展開します。"}, {"type": "subtitle", "time": 13764.71, "timestamp": "03:49:24", "text": "あ、懐中電灯持ってるよ。 ああ、"}, {"type": "subtitle", "time": 13768.55, "timestamp": "03:49:28", "text": "タクティカルフラッシュライトか。 ニース。"}, {"type": "subtitle", "time": 13772.55, "timestamp": "03:49:32", "text": "そして、こちらは日本人です。 私は字も"}, {"type": "subtitle", "time": 13775.189, "timestamp": "03:49:35", "text": "読めない。 見えない。 誰かが"}, {"type": "subtitle", "time": 13777.429, "timestamp": "03:49:37", "text": "話している。 おっと、分隊長が話している。"}, {"type": "subtitle", "time": 13788.15, "timestamp": "03:49:48", "text": "誰かが私の上にスポーンさせたプログラマーを意味します。 ニース。"}, {"type": "subtitle", "time": 13791.51, "timestamp": "03:49:51", "text": "私はボンボンハンマーを持っています。 私は"}, {"type": "subtitle", "time": 13793.83, "timestamp": "03:49:53", "text": "誰とでもセックスできるわ。   しかたがない。"}, {"type": "subtitle", "time": 13798.63, "timestamp": "03:49:58", "text": "ボン・ハンマー。 私は木を鳴らす。"}]
[{"type": "subtitle", "time": 13862.63, "timestamp": "03:51:02", "text": "待って、見せてください。 待って、"}, {"type": "subtitle", "time": 13869.75, "timestamp": "03:51:09", "text": "こんにちは。"}, {"type": "subtitle", "time": 13881.269, "timestamp": "03:51:21", "text": "何も見えない。"}, {"type": "subtitle", "time": 13884.309, "timestamp": "03:51:24", "text": "復活せよ。 誰が亡くなったのですか？"}, {"type": "subtitle", "time": 13894.469, "timestamp": "03:51:34", "text": "誰かが話している。 聞こえません。 つまり、"}, {"type": "subtitle", "time": 13898.15, "timestamp": "03:51:38", "text": "Wait、ドローンを使用している場合。"}, {"type": "subtitle", "time": 13907.189, "timestamp": "03:51:47", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 13909.349, "timestamp": "03:51:49", "text": "誰かが狙撃した。 あ、待って。 あれは"}, {"type": "subtitle", "time": 13912.07, "timestamp": "03:51:52", "text": "守護者か何かでしょう。 何？ 私は"}, {"type": "subtitle", "time": 13914.71, "timestamp": "03:51:54", "text": "保護者の関与がないことを好みます。   何てことだ"}, {"type": "subtitle", "time": 13917.429, "timestamp": "03:51:57", "text": "。"}]
[{"type": "subtitle", "time": 20345.35, "timestamp": "05:39:05", "text": "レベル96738827から"}, {"type": "subtitle", "time": 20351.27, "timestamp": "05:39:11", "text": "6064桁まで送られるから。何？何？"}, {"type": "subtitle", "time": 20353.19, "timestamp": "05:39:13", "text": "レベルがたくさんあるの？なんてこった。"}, {"type": "subtitle", "time": 20357.75, "timestamp": "05:39:17", "text": "何？何があるの？"}, {"type": "subtitle", "time": 20370.23, "timestamp": "05:39:30", "text": "終わりはあるけど、どうやって"}, {"type": "subtitle", "time": 20372.31, "timestamp": "05:39:32", "text": "終わるのかはわからない。どうやら、"}, {"type": "subtitle", "time": 20375.03, "timestamp": "05:39:35", "text": "バックルームの神に会って、彼があなたに寛容なら"}, {"type": "subtitle", "time": 20377.75, "timestamp": "05:39:37", "text": "、解放してくれるらしい。"}, {"type": "subtitle", "time": 20379.67, "timestamp": "05:39:39", "text": "バックルームに繋がるポータルがある。"}, {"type": "subtitle", "time": 20381.99, "timestamp": "05:39:41", "text": "人工のポータル。"}, {"type": "subtitle", "time": 20387.27, "timestamp": "05:39:47", "text": "あ、こんにちは。やあ、だ。大きなことだ とても大きいので、決して出られないかもしれません"}, {"type": "subtitle", "time": 20392.788, "timestamp": "05:39:52", "text": "。"}, {"type": "subtitle", "time": 20396.708, "timestamp": "05:39:56", "text": "ああ、そうですね。ああ。うーん。わかりません。"}, {"type": "subtitle", "time": 20399.03, "timestamp": "05:39:59", "text": "どうやら、"}]
[{"type": "subtitle", "time": 21720.548, "timestamp": "06:02:00", "text": "お互いを見つけなきゃいけないんだと思う。"}, {"type": "subtitle", "time": 21723.75, "timestamp": "06:02:03", "text": "あ、スタミナバーがある。ああ、これは"}, {"type": "subtitle", "time": 21726.47, "timestamp": "06:02:06", "text": "大きすぎる。"}, {"type": "subtitle", "time": 21729.67, "timestamp": "06:02:09", "text": "息切れがひどくて。"}, {"type": "subtitle", "time": 21731.99, "timestamp": "06:02:11", "text": "あ、待って、待って。"}, {"type": "subtitle", "time": 21734.15, "timestamp": "06:02:14", "text": "スタミナがなくなると、どんどん暗くなっていく"}, {"type": "subtitle", "time": 21736.07, "timestamp": "06:02:16", "text": "。"}, {"type": "subtitle", "time": 21738.39, "timestamp": "06:02:18", "text": "ああ、だからあまり走っちゃいけないんだね"}, {"type": "subtitle", "time": 21740.628, "timestamp": "06:02:20", "text": "。うん、"}, {"type": "subtitle", "time": 21742.788, "timestamp": "06:02:22", "text": "あまり走っちゃいけないんだね。"}, {"type": "subtitle", "time": 21745.11, "timestamp": "06:02:25", "text": "ああ、怖い。どこにいるの？わから"}, {"type": "subtitle", "time": 21746.948, "timestamp": "06:02:26", "text": "ない。"}, {"type": "subtitle", "time": 21748.708, "timestamp": "06:02:28", "text": "矢印に従って進んでる。"}, {"type": "subtitle", "time": 21751.75, "timestamp": "06:02:31", "text": "矢印に従って。どうやって"}, {"type": "subtitle", "time": 21755.03, "timestamp": "06:02:35", "text": "待ってたらいいのかわからない。"}, {"type": "subtitle", "time": 21758.548, "timestamp": "06:02:38", "text": "うん、先に進めばいいよ。"}, {"type": "subtitle", "time": 21761.27, "timestamp": "06:02:41", "text": "わかった。たぶん、あ、見えるよ。見えるよ。見えるよ。見えるよ。"}, {"type": "subtitle", "time": 21769.43, "timestamp": "06:02:49", "text": "[笑い]"}, {"type": "subtitle", "time": 21770.87, "timestamp": "06:02:50", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 21773.43, "timestamp": "06:02:53", "text": "[音楽]"}]
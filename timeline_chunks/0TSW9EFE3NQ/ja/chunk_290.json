[{"type": "subtitle", "time": 17416.47, "timestamp": "04:50:16", "text": "RPの男が"}, {"type": "subtitle", "time": 17419.67, "timestamp": "04:50:19", "text": "文字通り。うわあ。"}, {"type": "subtitle", "time": 17427.75, "timestamp": "04:50:27", "text": "私のグレネードは私の"}, {"type": "subtitle", "time": 17441.19, "timestamp": "04:50:41", "text": "私は安全な場所に引きずられている。しかし彼は"}, {"type": "subtitle", "time": 17445.99, "timestamp": "04:50:45", "text": "死んだ。私を引きずっていた人が死んだ。"}, {"type": "subtitle", "time": 17459.27, "timestamp": "04:50:59", "text": "私はこれをしないつもりだ。実際、私は"}]
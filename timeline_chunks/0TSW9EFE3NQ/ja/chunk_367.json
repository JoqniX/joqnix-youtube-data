[{"type": "subtitle", "time": 22021.91, "timestamp": "06:07:01", "text": "ああ、このものが3つある。ああ、"}, {"type": "subtitle", "time": 22026.07, "timestamp": "06:07:06", "text": "これはラジオだ。ああ。"}, {"type": "subtitle", "time": 22028.31, "timestamp": "06:07:08", "text": "ああ、もう一人いる。しゃがむことができる。ああ、"}, {"type": "subtitle", "time": 22031.91, "timestamp": "06:07:11", "text": "うん。しゃがむことができる。うん。"}, {"type": "subtitle", "time": 22035.35, "timestamp": "06:07:15", "text": "未知の存在。"}, {"type": "subtitle", "time": 22040.708, "timestamp": "06:07:20", "text": "ケーブルでできているように見える人型生物だ。何らかの理由で、この"}, {"type": "subtitle", "time": 22045.83, "timestamp": "06:07:25", "text": "場所を制御していると考えられている。閉じると"}, {"type": "subtitle", "time": 22048.15, "timestamp": "06:07:28", "text": "部屋の環境が変化し、"}, {"type": "subtitle", "time": 22050.708, "timestamp": "06:07:30", "text": "電子機器や"}, {"type": "subtitle", "time": 22054.23, "timestamp": "06:07:34", "text": "無線周波数に引き寄せられるようだ。ああ、だめだ。だから、"}, {"type": "subtitle", "time": 22057.19, "timestamp": "06:07:37", "text": "同じ場所にいるときは、"}, {"type": "subtitle", "time": 22062.47, "timestamp": "06:07:42", "text": "自分の死の象徴を引き寄せないように、とても注意しなければならない。"}, {"type": "subtitle", "time": 22065.59, "timestamp": "06:07:45", "text": "探検隊はこの写真を撮影したが、そこには"}, {"type": "subtitle", "time": 22069.19, "timestamp": "06:07:49", "text": "ワイヤーの生き物が徘徊しているように見える。 部屋には"}, {"type": "subtitle", "time": 22078.31, "timestamp": "06:07:58", "text": "何て書いてあるの？どういう意味？"}]
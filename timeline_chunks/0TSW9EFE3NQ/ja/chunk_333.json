[{"type": "subtitle", "time": 19981.67, "timestamp": "05:33:01", "text": "ええ。またレイザーが出ました。レイザー"}, {"type": "subtitle", "time": 19983.27, "timestamp": "05:33:03", "text": "星座。"}, {"type": "subtitle", "time": 19984.948, "timestamp": "05:33:04", "text": "彼女のために引こうとしましたか？"}, {"type": "subtitle", "time": 19987.67, "timestamp": "05:33:07", "text": "試しましたか？私はしましたが、いいえ、していません。ちょっと"}, {"type": "subtitle", "time": 19991.11, "timestamp": "05:33:11", "text": "試しました。ヌーが欲しかったのですが、"}, {"type": "subtitle", "time": 19993.99, "timestamp": "05:33:13", "text": "80回くらい引きました。それでも手に入りませんでした"}, {"type": "subtitle", "time": 19996.628, "timestamp": "05:33:16", "text": "。"}, {"type": "subtitle", "time": 19999.75, "timestamp": "05:33:19", "text": "それからプーラを買うお金がなくなってしまいました。"}, {"type": "subtitle", "time": 20004.23, "timestamp": "05:33:24", "text": "だから「ああ、だめだ」と思いました。ああ、なんてことだ。わかりません"}, {"type": "subtitle", "time": 20006.788, "timestamp": "05:33:26", "text": "。わかりません。多くの"}, {"type": "subtitle", "time": 20008.548, "timestamp": "05:33:28", "text": "人が傷つきました。多くの人が"}, {"type": "subtitle", "time": 20013.43, "timestamp": "05:33:33", "text": "傷つきませんでした。ええ。でも、予想外でした。"}, {"type": "subtitle", "time": 20018.788, "timestamp": "05:33:38", "text": "ナヒダをプレイしてみてどうですか？"}, {"type": "subtitle", "time": 20021.75, "timestamp": "05:33:41", "text": "いいですよ。ナヒダは本当にいいキャラで、まだ"}, {"type": "subtitle", "time": 20023.99, "timestamp": "05:33:43", "text": "育てていないので"}, {"type": "subtitle", "time": 20025.51, "timestamp": "05:33:45", "text": "本当のポテンシャルは分かりませんが、私が"}, {"type": "subtitle", "time": 20027.51, "timestamp": "05:33:47", "text": "知る限り、彼女はとても強い"}, {"type": "subtitle", "time": 20030.628, "timestamp": "05:33:50", "text": "キャラで、リアクション"}, {"type": "subtitle", "time": 20034.23, "timestamp": "05:33:54", "text": "ベースのチームには最適です。うん。だから、うん、本当に"}, {"type": "subtitle", "time": 20037.59, "timestamp": "05:33:57", "text": "いいですよ。えーっと、デンドロアプリケーターですか"}]
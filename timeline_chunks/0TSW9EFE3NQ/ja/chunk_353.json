[{"type": "subtitle", "time": 21184.23, "timestamp": "05:53:04", "text": "おい、俺はタフボーイだな。"}, {"type": "subtitle", "time": 21187.59, "timestamp": "05:53:07", "text": "タフボーイはアルファギガチャットだ。タフボーイは"}, {"type": "subtitle", "time": 21190.31, "timestamp": "05:53:10", "text": "家族向けじゃない。"}, {"type": "subtitle", "time": 21192.31, "timestamp": "05:53:12", "text": "なんてこった。"}, {"type": "subtitle", "time": 21200.628, "timestamp": "05:53:20", "text": "少年はシャオのように感情的で暗い。"}, {"type": "subtitle", "time": 21203.67, "timestamp": "05:53:23", "text": "私を殺しに来ない。シャオのファンはただ"}, {"type": "subtitle", "time": 21207.43, "timestamp": "05:53:27", "text": "真実を言っているだけだ。うん。Jナイト。"}, {"type": "subtitle", "time": 21210.788, "timestamp": "05:53:30", "text": "早く行かなきゃ。早く行かなきゃ。うん。全員捕まえなきゃ"}, {"type": "subtitle", "time": 21215.03, "timestamp": "05:53:35", "text": "。うん。私は1週間アスペル9をプレイした"}, {"type": "subtitle", "time": 21217.75, "timestamp": "05:53:37", "text": "。それから、"}, {"type": "subtitle", "time": 21222.15, "timestamp": "05:53:42", "text": "運転を学ぶのに役立っているのか、それとも"}, {"type": "subtitle", "time": 21225.35, "timestamp": "05:53:45", "text": "現実世界でまだ事故を起こしているのか分からないと思った。だから、"}, {"type": "subtitle", "time": 21227.99, "timestamp": "05:53:47", "text": "プレイをやめた。なんてこった。ああ"}, {"type": "subtitle", "time": 21229.91, "timestamp": "05:53:49", "text": "、待って。イージーレベルか"}, {"type": "subtitle", "time": 21232.548, "timestamp": "05:53:52", "text": "ノーマルレベルがいい？"}, {"type": "subtitle", "time": 21235.83, "timestamp": "05:53:55", "text": "もちろんイージーレベル。うん。なぜ"}, {"type": "subtitle", "time": 21239.03, "timestamp": "05:53:59", "text": "難しいレベルか何かを選ぶの？"}]
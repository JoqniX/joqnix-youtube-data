[{"type": "subtitle", "time": 17231.83, "timestamp": "04:47:11", "text": "だから、大きく変えるには、"}, {"type": "subtitle", "time": 17241.75, "timestamp": "04:47:21", "text": "チームを変えるのはどう？"}, {"type": "subtitle", "time": 17244.47, "timestamp": "04:47:24", "text": "それはうまくいかない。"}, {"type": "subtitle", "time": 17250.15, "timestamp": "04:47:30", "text": "チームが負けている間は、チームを変えることは許されない。うわあ。"}, {"type": "subtitle", "time": 17253.67, "timestamp": "04:47:33", "text": "彼らは知っていた。彼らは知っている。"}]
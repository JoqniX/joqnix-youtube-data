[{"type": "subtitle", "time": 21849.35, "timestamp": "06:04:09", "text": "怖いよ。怖いよ、おい。あ、待って。"}, {"type": "subtitle", "time": 21852.23, "timestamp": "06:04:12", "text": "キャビネットが2つあるみたい。そこにキャビネットが2つある"}, {"type": "subtitle", "time": 21854.39, "timestamp": "06:04:14", "text": "。ああ、そうだね。もしその"}, {"type": "subtitle", "time": 21858.07, "timestamp": "06:04:18", "text": "音が聞こえるなら、それはゲームの音だよ。"}, {"type": "subtitle", "time": 21861.99, "timestamp": "06:04:21", "text": "何？何も聞こえないよ。ああ"}, {"type": "subtitle", "time": 21863.19, "timestamp": "06:04:23", "text": "。ああ。ああ。ああ。ああ。ああ。あれは"}, {"type": "subtitle", "time": 21868.07, "timestamp": "06:04:28", "text": "ゲームの音だよ。ああ。ああ。これは何？E。"}, {"type": "subtitle", "time": 21872.548, "timestamp": "06:04:32", "text": "抗不安薬。この薬は、"}, {"type": "subtitle", "time": 21878.07, "timestamp": "06:04:38", "text": "何て書いてある？落ち着くために使うんだ。"}, {"type": "subtitle", "time": 21881.43, "timestamp": "06:04:41", "text": "不安を軽減するよ。"}, {"type": "subtitle", "time": 21889.91, "timestamp": "06:04:49", "text": "錠飲むよ。E、"}, {"type": "subtitle", "time": 21892.628, "timestamp": "06:04:52", "text": "何て書いてある？エンティティ3"}, {"type": "subtitle", "time": 21894.15, "timestamp": "06:04:54", "text": "機密情報"}, {"type": "subtitle", "time": 21896.628, "timestamp": "06:04:56", "text": "提供者"}, {"type": "subtitle", "time": 21898.948, "timestamp": "06:04:58", "text": "不気味。これは何？"}]
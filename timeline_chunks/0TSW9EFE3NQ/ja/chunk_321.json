[{"type": "subtitle", "time": 19263.51, "timestamp": "05:21:03", "text": "例えば、あなたが 知ってる。ああ、それは"}, {"type": "subtitle", "time": 19267.43, "timestamp": "05:21:07", "text": "いい。見えてるよ。いいよ。いいよ"}, {"type": "subtitle", "time": 19270.07, "timestamp": "05:21:10", "text": "。いいよ。いいよ。"}, {"type": "subtitle", "time": 19274.15, "timestamp": "05:21:14", "text": "今日は、今日は遊んでるよ。ああ、こんにちは、ジョー。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 19281.75, "timestamp": "05:21:21", "text": "元気だよ。元気？"}, {"type": "subtitle", "time": 19284.31, "timestamp": "05:21:24", "text": "元気だよ。聞いてくれてありがとう。待って、"}, {"type": "subtitle", "time": 19286.948, "timestamp": "05:21:26", "text": "彼の声が聞こえる？オーケー。彼の音量は"}, {"type": "subtitle", "time": 19290.868, "timestamp": "05:21:30", "text": "大丈夫？私の音量は大丈夫？うん。"}, {"type": "subtitle", "time": 19292.788, "timestamp": "05:21:32", "text": "音量は大丈夫？教えてくれ"}, {"type": "subtitle", "time": 19295.03, "timestamp": "05:21:35", "text": "ない？みんな知ってる？"}, {"type": "subtitle", "time": 19300.15, "timestamp": "05:21:40", "text": "音量は大丈夫？大丈夫だと思う。うん。こんにちは。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 19304.958, "timestamp": "05:21:44", "text": "こんにちは。 これは何て言うんだっけ。どっちが背が高い？うん。"}, {"type": "subtitle", "time": 19308.958, "timestamp": "05:21:48", "text": "これは何て言うんだっけ。どっちが背が高い？うん。 君の身長は？私の身長は？"}, {"type": "subtitle", "time": 19311.6, "timestamp": "05:21:51", "text": "君の身長は？私の身長は？ 忘れちゃった。私も忘れちゃったと思う。161"}, {"type": "subtitle", "time": 19314.24, "timestamp": "05:21:54", "text": "忘れちゃった。私も忘れちゃったと思う。161 か何かだと思う。わからない。161。うん。161"}]
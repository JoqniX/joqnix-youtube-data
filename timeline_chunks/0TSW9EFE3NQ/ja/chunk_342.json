[{"type": "subtitle", "time": 20532.39, "timestamp": "05:42:12", "text": "将来、トーストを食べたいです。ダメですが、真面目な"}, {"type": "subtitle", "time": 20534.948, "timestamp": "05:42:14", "text": "話。何を"}, {"type": "subtitle", "time": 20544.23, "timestamp": "05:42:24", "text": "何を食べたいですか？何を"}, {"type": "subtitle", "time": 20547.35, "timestamp": "05:42:27", "text": "食べたいですか？わかりません。私は、私は、"}, {"type": "subtitle", "time": 20549.67, "timestamp": "05:42:29", "text": "そこにあるものなら何でも食べます。わかりません"}, {"type": "subtitle", "time": 20552.07, "timestamp": "05:42:32", "text": "。ええと、わかりません。そんな風に"}, {"type": "subtitle", "time": 20554.39, "timestamp": "05:42:34", "text": "考えたことはありませんでした。ええ。でも"}, {"type": "subtitle", "time": 20556.39, "timestamp": "05:42:36", "text": "今はInstagramをスクロールダウンして、"}, {"type": "subtitle", "time": 20558.868, "timestamp": "05:42:38", "text": "YouTubeで、食べ物の動画をたくさん見て、"}, {"type": "subtitle", "time": 20562.31, "timestamp": "05:42:42", "text": "ステーキ"}, {"type": "subtitle", "time": 20565.11, "timestamp": "05:42:45", "text": "とかそういうのってどんな味がするんだろうって思うんだよね。肉っぽいやつだよね？それが"}, {"type": "subtitle", "time": 20568.31, "timestamp": "05:42:48", "text": "一つ。それから、スターバックスの食べ物で、"}, {"type": "subtitle", "time": 20571.83, "timestamp": "05:42:51", "text": "食べたことないもの。他に何かあるかな？"}, {"type": "subtitle", "time": 20576.628, "timestamp": "05:42:56", "text": "将来食べてみたいものといえば、あの激辛チップスみたいなのを試してみたい"}, {"type": "subtitle", "time": 20579.27, "timestamp": "05:42:59", "text": "。あの、あの辛いチップスだよ"}]
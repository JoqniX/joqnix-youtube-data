[{"type": "subtitle", "time": 8940.07, "timestamp": "02:29:00", "text": "チャットをしていたのですが、おそらく"}, {"type": "subtitle", "time": 8943.11, "timestamp": "02:29:03", "text": "午後8時か9時までにはアップされるでしょう。"}, {"type": "subtitle", "time": 8945.75, "timestamp": "02:29:05", "text": "動画の処理が完了したら、おそらく"}, {"type": "subtitle", "time": 8948.15, "timestamp": "02:29:08", "text": "アップロードするでしょう。"}, {"type": "subtitle", "time": 8955.19, "timestamp": "02:29:15", "text": "チャンネル登録を済ませている場合は、通知が届きます。 ええ、そうですね。 皆さん、"}, {"type": "subtitle", "time": 8957.11, "timestamp": "02:29:17", "text": "今日は来てくれてありがとう。 次の配信は明日です。"}, {"type": "subtitle", "time": 8959.91, "timestamp": "02:29:19", "text": "次の配信は明日で、確か"}, {"type": "subtitle", "time": 8964.309, "timestamp": "02:29:24", "text": "オーバーウォッチをプレイします。"}, {"type": "subtitle", "time": 8967.27, "timestamp": "02:29:27", "text": "明日午後3時からオーバーウォッチをプレイします。"}, {"type": "subtitle", "time": 8970.55, "timestamp": "02:29:30", "text": "IST。 だから、最善を尽くそう。"}, {"type": "subtitle", "time": 8973.11, "timestamp": "02:29:33", "text": "はい、明日の朝は"}, {"type": "subtitle", "time": 8974.63, "timestamp": "02:29:34", "text": "Twitchでストリーミング配信も行います"}, {"type": "subtitle", "time": 8978.309, "timestamp": "02:29:38", "text": "。 というわけで、お忘れなく。それでは、失礼します"}, {"type": "subtitle", "time": 8981.429, "timestamp": "02:29:41", "text": "。"}, {"type": "subtitle", "time": 8983.75, "timestamp": "02:29:43", "text": "皆さん、楽しんで、残りの"}]
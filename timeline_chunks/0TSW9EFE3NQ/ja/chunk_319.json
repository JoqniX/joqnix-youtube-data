[{"type": "subtitle", "time": 19173.03, "timestamp": "05:19:33", "text": "[音楽] ["}, {"type": "subtitle", "time": 19175.99, "timestamp": "05:19:35", "text": "ええ。みなさん、こんにちは。"}, {"type": "subtitle", "time": 19179.83, "timestamp": "05:19:39", "text": "ええ。こんにちは。ええ。こんにちは。ええ。こんにちは。"}, {"type": "subtitle", "time": 19181.75, "timestamp": "05:19:41", "text": "みなさん、今日はどうですか？"}, {"type": "subtitle", "time": 19190.07, "timestamp": "05:19:50", "text": "よし。自分の声が聞こえます。"}, {"type": "subtitle", "time": 19195.51, "timestamp": "05:19:55", "text": "今日は特別な日です。"}, {"type": "subtitle", "time": 19199.67, "timestamp": "05:19:59", "text": "ああ、今日はあなたの特別な日です。"}]
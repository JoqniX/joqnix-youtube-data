[{"type": "subtitle", "time": 21062.548, "timestamp": "05:51:02", "text": "壊れて、父が"}, {"type": "subtitle", "time": 21066.39, "timestamp": "05:51:06", "text": "モニターを職場に持って行って、"}, {"type": "subtitle", "time": 21069.91, "timestamp": "05:51:09", "text": "CPUとか全部持って行っちゃったんです。それで、"}, {"type": "subtitle", "time": 21073.27, "timestamp": "05:51:13", "text": "PCも何もなくて、それで、ノートパソコンを手に入れたんです。ええ。確か、"}, {"type": "subtitle", "time": 21083.51, "timestamp": "05:51:23", "text": "グラフィックのコースを受講していたので、ノート"}, {"type": "subtitle", "time": 21086.31, "timestamp": "05:51:26", "text": "パソコンが必要だったんです。それで、母がノート"}, {"type": "subtitle", "time": 21090.948, "timestamp": "05:51:30", "text": "パソコンを買ってくれたんです。いいですね。うん。でも"}, {"type": "subtitle", "time": 21092.948, "timestamp": "05:51:32", "text": "、長い間、"}, {"type": "subtitle", "time": 21095.59, "timestamp": "05:51:35", "text": "ノートパソコンもPCもなかったんです。"}, {"type": "subtitle", "time": 21097.27, "timestamp": "05:51:37", "text": "うん。"}, {"type": "subtitle", "time": 21099.91, "timestamp": "05:51:39", "text": "でも、そうですね。よし。残り3MB。ああ、すごい。終わった"}, {"type": "subtitle", "time": 21101.43, "timestamp": "05:51:41", "text": "。もうすぐ終わる。ああ、すごい。さあ行こう"}, {"type": "subtitle", "time": 21104.31, "timestamp": "05:51:44", "text": "。あなたは？ゲームをしますか？"}, {"type": "subtitle", "time": 21105.99, "timestamp": "05:51:45", "text": "今後、ゲームをプレイする予定はありますか"}, {"type": "subtitle", "time": 21108.628, "timestamp": "05:51:48", "text": "？ええ。"}, {"type": "subtitle", "time": 21111.67, "timestamp": "05:51:51", "text": "まだストリームでレーシングカーレースのジャンルに触れていない"}, {"type": "subtitle", "time": 21114.548, "timestamp": "05:51:54", "text": "ので、それをやりたいんです。"}, {"type": "subtitle", "time": 21117.67, "timestamp": "05:51:57", "text": "どのゲームですか？レースジャンルに触れていないんです"}]
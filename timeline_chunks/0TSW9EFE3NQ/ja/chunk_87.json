[{"type": "subtitle", "time": 5225.59, "timestamp": "01:27:05", "text": "生きてるよ。元気だといいな。"}, {"type": "subtitle", "time": 5229.27, "timestamp": "01:27:09", "text": "うん。でも、えーと、"}, {"type": "subtitle", "time": 5232.149, "timestamp": "01:27:12", "text": "朝と"}, {"type": "subtitle", "time": 5235.03, "timestamp": "01:27:15", "text": "昼と夜に配信すると、いつも"}, {"type": "subtitle", "time": 5238.39, "timestamp": "01:27:18", "text": "眠いようなモードになるのはなぜかわからない。眠いような、つまり、"}, {"type": "subtitle", "time": 5249.83, "timestamp": "01:27:29", "text": "[音楽]"}, {"type": "subtitle", "time": 5252.39, "timestamp": "01:27:32", "text": "待って、あれは何？カニ。やった。"}, {"type": "subtitle", "time": 5278.95, "timestamp": "01:27:58", "text": "[音楽]"}]
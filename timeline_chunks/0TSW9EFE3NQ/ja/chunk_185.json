[{"type": "subtitle", "time": 11100.389, "timestamp": "03:05:00", "text": "ああ、あれはチームメイトだ。 ああ、なんてことだ、あれはチーム"}, {"type": "subtitle", "time": 11113.349, "timestamp": "03:05:13", "text": "私はどのように死んだのですか？"}, {"type": "subtitle", "time": 11120.309, "timestamp": "03:05:20", "text": "武器は"}, {"type": "subtitle", "time": 11124.07, "timestamp": "03:05:24", "text": "銃声を発しません。武器を下げるにはどうすればいいですか？   ちょっとうるさいですね"}, {"type": "subtitle", "time": 11148.87, "timestamp": "03:05:48", "text": "これはどのサーバーですか？ 自分が"}, {"type": "subtitle", "time": 11152.63, "timestamp": "03:05:52", "text": "どの状況にいるのか、どうすれば分かりますか？"}]
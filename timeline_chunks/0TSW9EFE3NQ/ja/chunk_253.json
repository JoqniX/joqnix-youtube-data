[{"type": "subtitle", "time": 15188.46, "timestamp": "04:13:08", "text": "。"}, {"type": "subtitle", "time": 15190.469, "timestamp": "04:13:10", "text": "【音楽】"}, {"type": "subtitle", "time": 15192.07, "timestamp": "04:13:12", "text": "いいよ。"}, {"type": "subtitle", "time": 15194.309, "timestamp": "04:13:14", "text": "蘇生を求めるなら、私のところへ来なさい。 お前らガキどもを"}, {"type": "subtitle", "time": 15196.87, "timestamp": "04:13:16", "text": "蘇生させるつもりはない"}, {"type": "subtitle", "time": 15198.63, "timestamp": "04:13:18", "text": "。"}, {"type": "subtitle", "time": 15207.03, "timestamp": "04:13:27", "text": "ああ、みんなそう言ってるよ。 だから私は"}, {"type": "subtitle", "time": 15209.59, "timestamp": "04:13:29", "text": "挨拶をした。 彼らによると、そのうちの一人が「"}, {"type": "subtitle", "time": 15212.229, "timestamp": "04:13:32", "text": "こんにちは」とか「やあ」とか、何か言ったらしい。 私が"}, {"type": "subtitle", "time": 15214.71, "timestamp": "04:13:34", "text": "挨拶を返すと、"}, {"type": "subtitle", "time": 15216.309, "timestamp": "04:13:36", "text": "彼らは「あれは一体誰だ？」"}, {"type": "subtitle", "time": 15221.91, "timestamp": "04:13:41", "text": "とか「あれは誰だ？」とか言っていました。"}, {"type": "subtitle", "time": 15225.83, "timestamp": "04:13:45", "text": "それから最後の男が「えーと"}]
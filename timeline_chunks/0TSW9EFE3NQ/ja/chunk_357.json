[{"type": "subtitle", "time": 21420.47, "timestamp": "05:57:00", "text": "その方が簡単だ。私はあなたの"}, {"type": "subtitle", "time": 21423.82, "timestamp": "05:57:03", "text": "なぜ私は男であなたは女なの？"}, {"type": "subtitle", "time": 21426.708, "timestamp": "05:57:06", "text": "[笑い]"}, {"type": "subtitle", "time": 21429.43, "timestamp": "05:57:09", "text": "なぜなの？"}, {"type": "subtitle", "time": 21433.03, "timestamp": "05:57:13", "text": "今何を変えたいの？"}, {"type": "subtitle", "time": 21437.03, "timestamp": "05:57:17", "text": "それもうまくいくよ。彼は"}, {"type": "subtitle", "time": 21444.628, "timestamp": "05:57:24", "text": "。"}, {"type": "subtitle", "time": 21446.548, "timestamp": "05:57:26", "text": "何？"}, {"type": "subtitle", "time": 21449.43, "timestamp": "05:57:29", "text": "なんてこった。待って、どうやってなりたい"}, {"type": "subtitle", "time": 21452.948, "timestamp": "05:57:32", "text": "性別を選ぶの？ああ、だって"}, {"type": "subtitle", "time": 21455.27, "timestamp": "05:57:35", "text": "私には決まった性別がないから"}, {"type": "subtitle", "time": 21462.868, "timestamp": "05:57:42", "text": "待って、どうやってやるの？ああ、"}, {"type": "subtitle", "time": 21465.27, "timestamp": "05:57:45", "text": "スキンを選べるんだ。ああ、待って、待って、待って。"}, {"type": "subtitle", "time": 21469.43, "timestamp": "05:57:49", "text": "そう、スキンは君のオフィスマンなんだ。"}, {"type": "subtitle", "time": 21474.07, "timestamp": "05:57:54", "text": "おい、俺は男だ。俺は男だ。待って、"}, {"type": "subtitle", "time": 21476.708, "timestamp": "05:57:56", "text": "君は男なのか？何？ああ。"}, {"type": "subtitle", "time": 21479.03, "timestamp": "05:57:59", "text": "慰めとして、質問はないよ。"}]
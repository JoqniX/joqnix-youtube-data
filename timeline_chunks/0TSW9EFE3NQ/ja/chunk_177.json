[{"type": "subtitle", "time": 10621.03, "timestamp": "02:57:01", "text": "チャットは始めていません。 まだオープン戦は行いません"}, {"type": "subtitle", "time": 10623.83, "timestamp": "02:57:03", "text": "。 やってみます。"}, {"type": "subtitle", "time": 10648.309, "timestamp": "02:57:28", "text": "こういう時はハンマーを使うべきだと思うんだけど"}, {"type": "subtitle", "time": 10655.19, "timestamp": "02:57:35", "text": "うん。 こんにちは、顔猫さん。 いらっしゃいませ。"}, {"type": "subtitle", "time": 10656.95, "timestamp": "02:57:36", "text": "いらっしゃいませ。 あなたとは以前お会いしたことがありません。"}, {"type": "subtitle", "time": 10659.429, "timestamp": "02:57:39", "text": "ここ。 うん。 今日はどうやって私を見つけましたか"}, {"type": "subtitle", "time": 10667.75, "timestamp": "02:57:47", "text": "よし、これだ。 まあ、大"}, {"type": "subtitle", "time": 10672.07, "timestamp": "02:57:52", "text": "ハンマー型の爆薬を使うようなものですよね？"}, {"type": "subtitle", "time": 10674.87, "timestamp": "02:57:54", "text": "爆発物や武器などをもっと入手したり、"}]
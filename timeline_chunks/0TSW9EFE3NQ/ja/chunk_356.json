[{"type": "subtitle", "time": 21361.99, "timestamp": "05:56:01", "text": "パフォーマンスモードだ。"}, {"type": "subtitle", "time": 21364.708, "timestamp": "05:56:04", "text": "それを有効にする。"}, {"type": "subtitle", "time": 21366.868, "timestamp": "05:56:06", "text": "なぜハロウィンのズッキーニなの？"}, {"type": "subtitle", "time": 21370.07, "timestamp": "05:56:10", "text": "わからない。音量チェック。音量はいい。"}, {"type": "subtitle", "time": 21375.43, "timestamp": "05:56:15", "text": "いい。いつもの男の子たちがハードに発砲する。"}, {"type": "subtitle", "time": 21378.15, "timestamp": "05:56:18", "text": "音量はいい？わかった。 わかった。わかった。"}, {"type": "subtitle", "time": 21379.38, "timestamp": "05:56:19", "text": "ゲームを始めよう。"}, {"type": "subtitle", "time": 21382.15, "timestamp": "05:56:22", "text": "[音楽]"}, {"type": "subtitle", "time": 21384.548, "timestamp": "05:56:24", "text": "入るのかな？"}, {"type": "subtitle", "time": 21387.19, "timestamp": "05:56:27", "text": "招待は受けたけど、わからない。うん、"}, {"type": "subtitle", "time": 21390.628, "timestamp": "05:56:30", "text": "こっちに現れるべきだよ。"}, {"type": "subtitle", "time": 21394.31, "timestamp": "05:56:34", "text": "うん、そうするべきだと思う。うん、"}, {"type": "subtitle", "time": 21397.11, "timestamp": "05:56:37", "text": "ロード中だよ。うん。ああ、そう。"}, {"type": "subtitle", "time": 21401.51, "timestamp": "05:56:41", "text": "ロード中。おやおや。セクシーな音量。何？"}, {"type": "subtitle", "time": 21403.59, "timestamp": "05:56:43", "text": "声と音量が見える。なぜ"}, {"type": "subtitle", "time": 21406.07, "timestamp": "05:56:46", "text": "ハロウィンなの？まったくわからない。キティ、"}, {"type": "subtitle", "time": 21408.708, "timestamp": "05:56:48", "text": "ゲーム開始。今始まってるよ。"}, {"type": "subtitle", "time": 21410.23, "timestamp": "05:56:50", "text": "ハードレベル。ハードレベル。"}, {"type": "subtitle", "time": 21413.43, "timestamp": "05:56:53", "text": "黙れ。ハードレベルはない。簡単だよ。"}, {"type": "subtitle", "time": 21416.708, "timestamp": "05:56:56", "text": "このチャンネルではすべてが簡単。"}]
[{"type": "subtitle", "time": 13920.71, "timestamp": "03:52:00", "text": "彼は懐中電灯を消した。   私を"}, {"type": "subtitle", "time": 13923.59, "timestamp": "03:52:03", "text": "癒してください。  ３つを癒す必要がある。"}, {"type": "subtitle", "time": 13942.229, "timestamp": "03:52:22", "text": "木々のために声を上げよう。 どういうわけか、"}, {"type": "subtitle", "time": 13969.59, "timestamp": "03:52:49", "text": "私は死んだ。 彼は私を蘇生させようとしていたが、"}, {"type": "subtitle", "time": 13973.03, "timestamp": "03:52:53", "text": "亡くなった。 何てことだ。 よし、"}]
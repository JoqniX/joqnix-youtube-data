[{"type": "subtitle", "time": 19443.75, "timestamp": "05:24:03", "text": "。私は、えーと、えーと、"}, {"type": "subtitle", "time": 19455.11, "timestamp": "05:24:15", "text": "父が喉のた​​めに買ってくれたタフィーみたいなものを噛んでいる。"}, {"type": "subtitle", "time": 19457.75, "timestamp": "05:24:17", "text": "だから、なぜか口から唾液がたくさん出ている"}, {"type": "subtitle", "time": 19459.75, "timestamp": "05:24:19", "text": "。"}, {"type": "subtitle", "time": 19461.51, "timestamp": "05:24:21", "text": "ねえ、シャカ、"}, {"type": "subtitle", "time": 19465.67, "timestamp": "05:24:25", "text": "大丈夫だよ。"}, {"type": "subtitle", "time": 19467.91, "timestamp": "05:24:27", "text": "今回も大声で叫ぶのかな？それとも、今日は"}, {"type": "subtitle", "time": 19471.51, "timestamp": "05:24:31", "text": "バックルームで演奏するんだ。とてもそれは"}, {"type": "subtitle", "time": 19473.11, "timestamp": "05:24:33", "text": "決断だった。私たちは考えなかった"}, {"type": "subtitle", "time": 19474.948, "timestamp": "05:24:34", "text": "。「よし、いいか？   「"}, {"type": "subtitle", "time": 19477.67, "timestamp": "05:24:37", "text": "遊ぶぞ。」"}, {"type": "subtitle", "time": 19480.39, "timestamp": "05:24:40", "text": "そして、遊んだ。うん。正直、何を"}, {"type": "subtitle", "time": 19481.83, "timestamp": "05:24:41", "text": "期待してたのか分からない。"}, {"type": "subtitle", "time": 19485.67, "timestamp": "05:24:45", "text": "バックルームのゲームは一度もやったことがない。"}, {"type": "subtitle", "time": 19487.43, "timestamp": "05:24:47", "text": "えっと、やったことある？やったことある"}, {"type": "subtitle", "time": 19489.59, "timestamp": "05:24:49", "text": "？ない。一度もない。初めてだ"}, {"type": "subtitle", "time": 19491.59, "timestamp": "05:24:51", "text": "。いや、一度もない。"}, {"type": "subtitle", "time": 19494.15, "timestamp": "05:24:54", "text": "私も初めてだ。でも、ああ、"}, {"type": "subtitle", "time": 19496.628, "timestamp": "05:24:56", "text": "うん。私の身長は54インチ。ああ、わかった。わかった。うん。"}]
[{"type": "subtitle", "time": 21482.31, "timestamp": "05:58:02", "text": "これは何？これは何？Tショット。"}, {"type": "subtitle", "time": 21485.11, "timestamp": "05:58:05", "text": "オーディション。なんてこった。違う。"}, {"type": "subtitle", "time": 21489.43, "timestamp": "05:58:09", "text": "ホームレスじゃないホームレスみたいに見える。"}, {"type": "subtitle", "time": 21492.868, "timestamp": "05:58:12", "text": "待って、ホームレスの男だ。"}, {"type": "subtitle", "time": 21495.27, "timestamp": "05:58:15", "text": "そう書いてある。これを見て。見せてあげる。見せてあげる。"}, {"type": "subtitle", "time": 21497.35, "timestamp": "05:58:17", "text": "そう書いてある。ああ、"}, {"type": "subtitle", "time": 21500.708, "timestamp": "05:58:20", "text": "待って。何？どこ？どこ？"}, {"type": "subtitle", "time": 21503.43, "timestamp": "05:58:23", "text": "「ああ、"}, {"type": "subtitle", "time": 21505.83, "timestamp": "05:58:25", "text": "ホームレスの男が見えるって書いてある」って思ったんだ。ホームレスの男だ。"}, {"type": "subtitle", "time": 21507.99, "timestamp": "05:58:27", "text": "あれを見て。"}, {"type": "subtitle", "time": 21519.43, "timestamp": "05:58:39", "text": "。ハロウィーン"}, {"type": "subtitle", "time": 21521.91, "timestamp": "05:58:41", "text": "イベントだよ。キャンドルバッグを5つと"}, {"type": "subtitle", "time": 21528.628, "timestamp": "05:58:48", "text": "私は今ホームレスの女性だ。"}, {"type": "subtitle", "time": 21531.19, "timestamp": "05:58:51", "text": "これは ホームレスの女性。"}, {"type": "subtitle", "time": 21534.15, "timestamp": "05:58:54", "text": "このアンロックされた代替"}, {"type": "subtitle", "time": 21536.31, "timestamp": "05:58:56", "text": "エンディングは何ですか？ああ、わかりました。アンロックされた"}, {"type": "subtitle", "time": 21537.35, "timestamp": "05:58:57", "text": "キャラクターです。"}]
[{"type": "subtitle", "time": 5822.07, "timestamp": "01:37:02", "text": "おお、いいね。"}, {"type": "subtitle", "time": 5825.59, "timestamp": "01:37:05", "text": "これを手に入れた。剣もある。"}, {"type": "subtitle", "time": 5828.629, "timestamp": "01:37:08", "text": "傘の破片。"}, {"type": "subtitle", "time": 5831.669, "timestamp": "01:37:11", "text": "これとこれも"}, {"type": "subtitle", "time": 5839.01, "timestamp": "01:37:19", "text": "終わらせられるかな。"}, {"type": "subtitle", "time": 5846.79, "timestamp": "01:37:26", "text": "[音楽]"}, {"type": "subtitle", "time": 5854.95, "timestamp": "01:37:34", "text": "。行こう。彼らは中に入ることができる。よし、"}, {"type": "subtitle", "time": 5858.55, "timestamp": "01:37:38", "text": "行く前に、えーと、"}, {"type": "subtitle", "time": 5860.17, "timestamp": "01:37:40", "text": "これを閉じさせてくれ。"}, {"type": "subtitle", "time": 5876.149, "timestamp": "01:37:56", "text": "[音楽] これをえーと、これのために"}, {"type": "subtitle", "time": 5877.99, "timestamp": "01:37:57", "text": "置いて、"}]
[{"type": "subtitle", "time": 6614.629, "timestamp": "01:50:14", "text": "それらをテストしたい。私はそれらをテストしたことがない"}, {"type": "subtitle", "time": 6625.09, "timestamp": "01:50:25", "text": "彼を見て。"}, {"type": "subtitle", "time": 6633.51, "timestamp": "01:50:33", "text": "うわあ。"}, {"type": "subtitle", "time": 6636.56, "timestamp": "01:50:36", "text": "彼は滑空したりできる。"}, {"type": "subtitle", "time": 6638.95, "timestamp": "01:50:38", "text": "[音楽]"}, {"type": "subtitle", "time": 6641.03, "timestamp": "01:50:41", "text": "ああ、これは役に立つ。なぜなら、私は"}, {"type": "subtitle", "time": 6646.39, "timestamp": "01:50:46", "text": "ヴェンティやシャオのようなものを持っていないから。私は使用できる ヴァンダラマが"}, {"type": "subtitle", "time": 6650.87, "timestamp": "01:50:50", "text": "私をあちこちに連れて行ってくれる。ああ"}, {"type": "subtitle", "time": 6654.47, "timestamp": "01:50:54", "text": "、なんて素晴らしいんだ。"}, {"type": "subtitle", "time": 6658.149, "timestamp": "01:50:58", "text": "ああ、わかった。"}]
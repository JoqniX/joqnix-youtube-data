[{"type": "subtitle", "time": 14580.71, "timestamp": "04:03:00", "text": "。 今は正常に動作しています。"}, {"type": "subtitle", "time": 14583.429, "timestamp": "04:03:03", "text": "デバイスが見つかりませんでした。"}, {"type": "subtitle", "time": 14585.269, "timestamp": "04:03:05", "text": "了解だ、チームメイト。 今から"}, {"type": "subtitle", "time": 14587.59, "timestamp": "04:03:07", "text": "そこから出発します。 行くよ。 ブーム。"}, {"type": "subtitle", "time": 14590.309, "timestamp": "04:03:10", "text": "ブーム。 ブーム。 ブーム。"}, {"type": "subtitle", "time": 14599.11, "timestamp": "04:03:19", "text": "私が死んだ後、彼らが私の声を聞いてくれるといいな。 えっと、"}, {"type": "subtitle", "time": 14603.11, "timestamp": "04:03:23", "text": "彼らはそれを殺人、声、声と呼んでいます"}, {"type": "subtitle", "time": 14610.309, "timestamp": "04:03:30", "text": "全員ここにいる。 何てことだ。"}, {"type": "subtitle", "time": 14614.71, "timestamp": "04:03:34", "text": "見知らぬ人たちがドンドンと音を立てようとしているのを見てごらん。 あれを見てください"}, {"type": "subtitle", "time": 14616.87, "timestamp": "04:03:36", "text": "。   わかった"}, {"type": "subtitle", "time": 14620.13, "timestamp": "04:03:40", "text": "。 それは何ですか？"}, {"type": "subtitle", "time": 14632.309, "timestamp": "04:03:52", "text": "いやあ、"}, {"type": "subtitle", "time": 14634.469, "timestamp": "04:03:54", "text": "これは難しいな。 思っていたより難しかった"}]
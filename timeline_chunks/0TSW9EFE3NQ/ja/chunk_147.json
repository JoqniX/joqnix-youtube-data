[{"type": "subtitle", "time": 8820.07, "timestamp": "02:27:00", "text": "星空や星空について周りの人に聞いてみることができます。 ああ、それから"}, {"type": "subtitle", "time": 8824.55, "timestamp": "02:27:04", "text": "これも。 うん。"}, {"type": "subtitle", "time": 8828.55, "timestamp": "02:27:08", "text": "それから、エドワードが来てくれてありがとう。"}, {"type": "subtitle", "time": 8831.51, "timestamp": "02:27:11", "text": "お越しいただきありがとうございます。 お越しいただき、ありがとうございました。楽しんでいただけたなら幸いです"}, {"type": "subtitle", "time": 8834.63, "timestamp": "02:27:14", "text": "。 ああ、"}, {"type": "subtitle", "time": 8838.07, "timestamp": "02:27:18", "text": "Twitchの記事を読み始めたよ。 私のミスです。 ミリサンが"}, {"type": "subtitle", "time": 8840.389, "timestamp": "02:27:20", "text": "今日来た。 エド・ミリサン、本当に久しぶりだ"}, {"type": "subtitle", "time": 8842.79, "timestamp": "02:27:22", "text": "。 来てくださって、"}, {"type": "subtitle", "time": 8844.469, "timestamp": "02:27:24", "text": "チャットで積極的に参加してくださって、そして"}, {"type": "subtitle", "time": 8848.07, "timestamp": "02:27:28", "text": "私と交流してくださってありがとうございます。ええ、このクエストは"}, {"type": "subtitle", "time": 8851.11, "timestamp": "02:27:31", "text": "本当に楽しくて面白くて、"}, {"type": "subtitle", "time": 8853.91, "timestamp": "02:27:33", "text": "プレイしていて楽しかったです。"}, {"type": "subtitle", "time": 8856.309, "timestamp": "02:27:36", "text": "今、一緒にいてくれてありがとう。 素敵な夜をお過ごしください"}, {"type": "subtitle", "time": 8860.389, "timestamp": "02:27:40", "text": "。 ディアブロが今日、遊びに来てくれました"}, {"type": "subtitle", "time": 8862.71, "timestamp": "02:27:42", "text": "。 楽しんでいただけたでしょうか。また、今日もぜひお立ち寄りください"}, {"type": "subtitle", "time": 8864.55, "timestamp": "02:27:44", "text": "。"}, {"type": "subtitle", "time": 8868.309, "timestamp": "02:27:48", "text": "ヘックも立ち寄ってくれた"}, {"type": "subtitle", "time": 8870.389, "timestamp": "02:27:50", "text": "。 いつか一緒にバトルランをプレイできるといいですね"}, {"type": "subtitle", "time": 8873.59, "timestamp": "02:27:53", "text": "。 ええ、それでは"}, {"type": "subtitle", "time": 8876.309, "timestamp": "02:27:56", "text": "良い一日をお過ごしください。 ぜひお越しください。"}, {"type": "subtitle", "time": 8878.469, "timestamp": "02:27:58", "text": "今日はスノーウィーもやって来たよ。"}]
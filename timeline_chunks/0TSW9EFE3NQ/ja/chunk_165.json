[{"type": "subtitle", "time": 9901.349, "timestamp": "02:45:01", "text": "Discordの両方を接続しました。 えっと、"}, {"type": "subtitle", "time": 9903.67, "timestamp": "02:45:03", "text": "これ、今までプレイしたことないんです。 それでは、"}, {"type": "subtitle", "time": 9905.59, "timestamp": "02:45:05", "text": "射撃場に行って、"}, {"type": "subtitle", "time": 9908.469, "timestamp": "02:45:08", "text": "このゲームがどんなものか試してみましょう。 そして"}, {"type": "subtitle", "time": 9911.03, "timestamp": "02:45:11", "text": "全て。   まあ"}, {"type": "subtitle", "time": 9913.99, "timestamp": "02:45:13", "text": "、行こうか。"}, {"type": "subtitle", "time": 9915.91, "timestamp": "02:45:15", "text": "試合の音は聞こえますか？"}, {"type": "subtitle", "time": 9918.95, "timestamp": "02:45:18", "text": "ああ、音楽は大音量で流すべきだったのを忘れてた。"}, {"type": "subtitle", "time": 9921.59, "timestamp": "02:45:21", "text": "うるさいだろうね？"}, {"type": "subtitle", "time": 9923.67, "timestamp": "02:45:23", "text": "低いですよね？ 射撃場。 射撃"}, {"type": "subtitle", "time": 9925.269, "timestamp": "02:45:25", "text": "場は、"}, {"type": "subtitle", "time": 9927.03, "timestamp": "02:45:27", "text": "完全な機能ではありません。 つまり、ほとんどのガジェットは"}, {"type": "subtitle", "time": 9929.349, "timestamp": "02:45:29", "text": "射撃場では機能しないということだ。 しかし、それらは"}, {"type": "subtitle", "time": 9933.349, "timestamp": "02:45:33", "text": "機能的であり、増殖速度は比較的低い。"}, {"type": "subtitle", "time": 9935.19, "timestamp": "02:45:35", "text": "最後に、射撃場は"}, {"type": "subtitle", "time": 9936.87, "timestamp": "02:45:36", "text": "武器やアタッチメントのテストを行うための近接戦闘に特化した場所です。   わかった"}, {"type": "subtitle", "time": 9938.469, "timestamp": "02:45:38", "text": "。"}, {"type": "subtitle", "time": 9942.55, "timestamp": "02:45:42", "text": "クリックしないといけない。 わかった。 これは何ですか？"}, {"type": "subtitle", "time": 9947.429, "timestamp": "02:45:47", "text": "積み込み。 ああ、それはMだ。ああ、AK-15だ。"}, {"type": "subtitle", "time": 9949.269, "timestamp": "02:45:49", "text": "おお。"}, {"type": "subtitle", "time": 9953.03, "timestamp": "02:45:53", "text": "我々のキル数はゼロだった。"}, {"type": "subtitle", "time": 9956.469, "timestamp": "02:45:56", "text": "おお。 これだけの銃を見てみろ。"}]
[{"type": "subtitle", "time": 19925.03, "timestamp": "05:32:05", "text": "ピティが48とかそんな感じだったんだけど、"}, {"type": "subtitle", "time": 19929.59, "timestamp": "05:32:09", "text": "チャットで"}, {"type": "subtitle", "time": 19931.67, "timestamp": "05:32:11", "text": "ナハを引かないって説明してたんだ。だって、ナハは"}, {"type": "subtitle", "time": 19934.628, "timestamp": "05:32:14", "text": "欲しい"}, {"type": "subtitle", "time": 19937.59, "timestamp": "05:32:17", "text": "けど、俺はF2Pプレイヤーだから、お金を使いたくないんだ。"}, {"type": "subtitle", "time": 19940.868, "timestamp": "05:32:20", "text": "プリモスは、"}, {"type": "subtitle", "time": 19944.548, "timestamp": "05:32:24", "text": "いや、"}, {"type": "subtitle", "time": 19946.39, "timestamp": "05:32:26", "text": "私が説明していたところ、ベーコンが「"}, {"type": "subtitle", "time": 19948.708, "timestamp": "05:32:28", "text": "わかった、じゃあ"}, {"type": "subtitle", "time": 19951.03, "timestamp": "05:32:31", "text": "ベネットのために10回引っ張って」と言ったので、"}, {"type": "subtitle", "time": 19952.31, "timestamp": "05:32:32", "text": "私は「わかった、わかった」と言いました。"}, {"type": "subtitle", "time": 19955.11, "timestamp": "05:32:35", "text": "「私は48PDです。」だから「よし、"}, {"type": "subtitle", "time": 19957.19, "timestamp": "05:32:37", "text": "ベネットのために1回やってみよう」と思ったんです。そしてその10回"}, {"type": "subtitle", "time": 19963.59, "timestamp": "05:32:43", "text": "引いたら、ナヒダが2人、ベネットが1人出ました。"}, {"type": "subtitle", "time": 19966.948, "timestamp": "05:32:46", "text": "すごいですね。それは本当にすごい。私は"}, {"type": "subtitle", "time": 19971.19, "timestamp": "05:32:51", "text": "「一体何が起こったんだ？」と思いました"}, {"type": "subtitle", "time": 19973.67, "timestamp": "05:32:53", "text": "。おかえりなさい。ええ、本当に。ええ、本当に。本当に"}, {"type": "subtitle", "time": 19976.31, "timestamp": "05:32:56", "text": "。本当に起こったんです"}, {"type": "subtitle", "time": 19979.43, "timestamp": "05:32:59", "text": "。ああ、なんてことだ。またレイザーが出ました。"}]
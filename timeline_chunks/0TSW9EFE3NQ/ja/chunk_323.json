[{"type": "subtitle", "time": 19384.55, "timestamp": "05:23:04", "text": "それって、私にはわからないくらいだ。待って。5T"}, {"type": "subtitle", "time": 19390.07, "timestamp": "05:23:10", "text": "って5フィート3インチで160cmくらいで、"}, {"type": "subtitle", "time": 19394.708, "timestamp": "05:23:14", "text": "5t 4とか5フィート4インチで163cmだと思う。"}, {"type": "subtitle", "time": 19398.868, "timestamp": "05:23:18", "text": "よくわからない。わからない。"}, {"type": "subtitle", "time": 19402.07, "timestamp": "05:23:22", "text": "私が 背が高い。"}, {"type": "subtitle", "time": 19404.31, "timestamp": "05:23:24", "text": "そう、"}, {"type": "subtitle", "time": 19406.39, "timestamp": "05:23:26", "text": "背が高い。でも、どうして私の頭はこんなに大きいんだろう"}, {"type": "subtitle", "time": 19408.788, "timestamp": "05:23:28", "text": "？ まったく理解できない。"}, {"type": "subtitle", "time": 19410.788, "timestamp": "05:23:30", "text": "あなたの頭を見て。あなたの頭は"}, {"type": "subtitle", "time": 19413.27, "timestamp": "05:23:33", "text": "とても細くて素敵。なのに私の頭は、"}, {"type": "subtitle", "time": 19427.99, "timestamp": "05:23:47", "text": "素晴らしい。こんにちは。こんにちは。素晴らしい。こんにちは。912。215852.35は"}, {"type": "subtitle", "time": 19436.788, "timestamp": "05:23:56", "text": "何に等しい？ 数字だよ。"}]
[{"type": "subtitle", "time": 19683.99, "timestamp": "05:28:03", "text": "やれやれ」「何？」「いやだ」と思いました。だから、私にはわかりません。"}, {"type": "subtitle", "time": 19692.39, "timestamp": "05:28:12", "text": "恐怖症よりもホラーに近いのか、それとも、"}, {"type": "subtitle", "time": 19695.27, "timestamp": "05:28:15", "text": "それがどこに位置づけられ、"}, {"type": "subtitle", "time": 19699.59, "timestamp": "05:28:19", "text": "私たちがどう反応するのかわかりません。いや、それが"}, {"type": "subtitle", "time": 19703.27, "timestamp": "05:28:23", "text": "問題です。"}, {"type": "subtitle", "time": 19705.51, "timestamp": "05:28:25", "text": "これはどうなるのでしょうか？これは良い"}, {"type": "subtitle", "time": 19709.35, "timestamp": "05:28:29", "text": "決断なのでしょうか？うまくいくことを願っています"}, {"type": "subtitle", "time": 19711.51, "timestamp": "05:28:31", "text": "。先輩、この"}, {"type": "subtitle", "time": 19713.75, "timestamp": "05:28:33", "text": "ゲームについてどう思いますか？"}, {"type": "subtitle", "time": 19716.15, "timestamp": "05:28:36", "text": "ああ、私。"}, {"type": "subtitle", "time": 19718.23, "timestamp": "05:28:38", "text": "えっと、バナーアートで、Steamに行くと"}, {"type": "subtitle", "time": 19720.628, "timestamp": "05:28:40", "text": "、右側に不気味な"}, {"type": "subtitle", "time": 19722.948, "timestamp": "05:28:42", "text": "顔があります。それが私を最も怖がらせます。私は"}, {"type": "subtitle", "time": 19726.15, "timestamp": "05:28:46", "text": "それを見ませんでした。何？"}, {"type": "subtitle", "time": 19729.75, "timestamp": "05:28:49", "text": "ライブラリバージョンに行くと、バナーの"}, {"type": "subtitle", "time": 19732.07, "timestamp": "05:28:52", "text": "右側に"}, {"type": "subtitle", "time": 19733.67, "timestamp": "05:28:53", "text": "不気味な顔があります。ええ。ええ。ええ。ええ"}, {"type": "subtitle", "time": 19736.868, "timestamp": "05:28:56", "text": "。ああ、私の ああ、そうだ。あれが、ほら"}]
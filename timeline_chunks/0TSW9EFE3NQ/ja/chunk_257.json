[{"type": "subtitle", "time": 15435.91, "timestamp": "04:17:15", "text": "よし、何を手に入れた？"}, {"type": "subtitle", "time": 15437.91, "timestamp": "04:17:17", "text": "バトル。"}, {"type": "subtitle", "time": 15440.469, "timestamp": "04:17:20", "text": "コンプレッサーを手に入れた。いいね"}, {"type": "subtitle", "time": 15443.67, "timestamp": "04:17:23", "text": "。よし、これを取り除こう。懐中"}, {"type": "subtitle", "time": 15447.59, "timestamp": "04:17:27", "text": "電灯。それはまずい。懐中"}, {"type": "subtitle", "time": 15450.469, "timestamp": "04:17:30", "text": "電灯は痛い。"}]
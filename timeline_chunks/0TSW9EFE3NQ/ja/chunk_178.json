[{"type": "subtitle", "time": 10681.99, "timestamp": "02:58:01", "text": "リスポーンしたりするにはどうすればいいですか？ いいえ。おっと"}, {"type": "subtitle", "time": 10685.429, "timestamp": "02:58:05", "text": "。 あなたはただ「わかった」と言っただけです。 わかった。   わかった"}, {"type": "subtitle", "time": 10687.83, "timestamp": "02:58:07", "text": "。 ええ、まさにこう言ったんです。"}, {"type": "subtitle", "time": 10692.469, "timestamp": "02:58:12", "text": "ああ、これは初デートだったんだ。 わかった。"}, {"type": "subtitle", "time": 10706.309, "timestamp": "02:58:26", "text": "どういうわけか、私にはこういうものがあるんです。 よし、じゃあ"}, {"type": "subtitle", "time": 10711.83, "timestamp": "02:58:31", "text": "ソリ遊びに行ってくるよ。   すぐにそうする"}, {"type": "subtitle", "time": 10713.83, "timestamp": "02:58:33", "text": "べきです。 この"}, {"type": "subtitle", "time": 10715.429, "timestamp": "02:58:35", "text": "建物ですよね？ いや、そうだったのだろうか？ ああ、これだ"}, {"type": "subtitle", "time": 10718.23, "timestamp": "02:58:38", "text": "。 大ハンマー。 お前を迎えに行くぞ"}, {"type": "subtitle", "time": 10720.07, "timestamp": "02:58:40", "text": "。"}, {"type": "subtitle", "time": 10723.11, "timestamp": "02:58:43", "text": "彼が私のおすすめに表示してくれたので、ここに来ました"}, {"type": "subtitle", "time": 10725.11, "timestamp": "02:58:45", "text": "。 ああ、ありがとうございます。 私のプロフィールを"}, {"type": "subtitle", "time": 10731.91, "timestamp": "02:58:51", "text": "壊してもいいんだよ。 うわー、すごい！"}, {"type": "subtitle", "time": 10735.99, "timestamp": "02:58:55", "text": "ああ、V。これを使えばどんな建物でも建てたり壊したりできるよ"}]
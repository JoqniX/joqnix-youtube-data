[{"type": "subtitle", "time": 8760.07, "timestamp": "02:26:00", "text": "今日はこれで終わりにします。今日来てくれたみんなは、えっと、"}, {"type": "subtitle", "time": 8763.75, "timestamp": "02:26:03", "text": "ゴリップ。"}, {"type": "subtitle", "time": 8765.349, "timestamp": "02:26:05", "text": "待って、"}, {"type": "subtitle", "time": 8767.349, "timestamp": "02:26:07", "text": "それはえっと、いや、気にしないで。"}, {"type": "subtitle", "time": 8769.429, "timestamp": "02:26:09", "text": "それはTwitchストリームのためだった。ごめん。"}, {"type": "subtitle", "time": 8772.309, "timestamp": "02:26:12", "text": "セパレーターを入れないと、"}, {"type": "subtitle", "time": 8776.55, "timestamp": "02:26:16", "text": "Twitchの人たちの名前を読み上げてしまうから"}, {"type": "subtitle", "time": 8780.55, "timestamp": "02:26:20", "text": "。来てくれたみんな。うん、"}, {"type": "subtitle", "time": 8782.07, "timestamp": "02:26:22", "text": "最後まで来てくれてありがとう。本当に本当に感謝しています"}, {"type": "subtitle", "time": 8784.07, "timestamp": "02:26:24", "text": "。楽しんでくれたら嬉しいです。"}, {"type": "subtitle", "time": 8787.27, "timestamp": "02:26:27", "text": "アートも持ってきてくださいね。幸運を祈っています。"}, {"type": "subtitle", "time": 8793.75, "timestamp": "02:26:33", "text": "伝統的なものでもデジタルでも、描き続けてください。学び続けて、絵を描き続けてください"}, {"type": "subtitle", "time": 8799.67, "timestamp": "02:26:39", "text": "。こんにちは。アートなど"}, {"type": "subtitle", "time": 8801.91, "timestamp": "02:26:41", "text": "で疑問があれば、"}, {"type": "subtitle", "time": 8807.99, "timestamp": "02:26:47", "text": "デイビッドソンやモーに聞いてみてください。他にも"}, {"type": "subtitle", "time": 8809.91, "timestamp": "02:26:49", "text": "良い人が何人かいますよ。"}, {"type": "subtitle", "time": 8812.63, "timestamp": "02:26:52", "text": "家族やその他様々なコミュニティに属するアーティストたち"}, {"type": "subtitle", "time": 8815.19, "timestamp": "02:26:55", "text": "。 そうですね、"}]
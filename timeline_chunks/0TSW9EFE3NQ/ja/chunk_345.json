[{"type": "subtitle", "time": 20701.43, "timestamp": "05:45:01", "text": "お願い。あと10MB。さあ行こう。ええ"}, {"type": "subtitle", "time": 20703.27, "timestamp": "05:45:03", "text": "、なぜ"}, {"type": "subtitle", "time": 20705.19, "timestamp": "05:45:05", "text": "始めないのか不思議に思っているなら、私のゲームが"}, {"type": "subtitle", "time": 20707.75, "timestamp": "05:45:07", "text": "これを更新するのに永遠に時間がかかっているだけです。"}, {"type": "subtitle", "time": 20710.47, "timestamp": "05:45:10", "text": "今日のサーバーはどうなっているのかわかりません。"}, {"type": "subtitle", "time": 20712.23, "timestamp": "05:45:12", "text": "私の苦痛。"}, {"type": "subtitle", "time": 20715.27, "timestamp": "05:45:15", "text": "好きになるまで時間がかかりました。"}, {"type": "subtitle", "time": 20718.47, "timestamp": "05:45:18", "text": "これは184MBのアップデートで、"}, {"type": "subtitle", "time": 20735.51, "timestamp": "05:45:35", "text": "。誰もシナモンロールだとは知らないと思います"}, {"type": "subtitle", "time": 20737.75, "timestamp": "05:45:37", "text": "。ジョークはシナモン"}, {"type": "subtitle", "time": 20741.83, "timestamp": "05:45:41", "text": "ロールです。私はそう言えます。うん。いいえ、いいえ、"}, {"type": "subtitle", "time": 20743.59, "timestamp": "05:45:43", "text": "私ではありません。"}, {"type": "subtitle", "time": 20745.27, "timestamp": "05:45:45", "text": "あなたたち二人はシナモンロールで、私は"}, {"type": "subtitle", "time": 20748.788, "timestamp": "05:45:48", "text": "甘いものが本当に少しお腹が空いてきました。私も"}, {"type": "subtitle", "time": 20750.788, "timestamp": "05:45:50", "text": "何か食べたいです、実は。"}, {"type": "subtitle", "time": 20752.47, "timestamp": "05:45:52", "text": "嘘をつくつもりはありません。ああ、待って。あなたは"}, {"type": "subtitle", "time": 20756.948, "timestamp": "05:45:56", "text": "一度もあなたの心を持っていませんでした。はい、彼は"}, {"type": "subtitle", "time": 20759.91, "timestamp": "05:45:59", "text": "シナモンロールです。いいえ、彼は わからない"}]
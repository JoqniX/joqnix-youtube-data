[{"type": "subtitle", "time": 14286.87, "timestamp": "03:58:06", "text": "誰かが私を蘇生させている。 ああ、助かった"}, {"type": "subtitle", "time": 14294.309, "timestamp": "03:58:14", "text": "この呼吸。 これは何ですか？"}, {"type": "subtitle", "time": 14303.189, "timestamp": "03:58:23", "text": "わあ、"}, {"type": "subtitle", "time": 14306.71, "timestamp": "03:58:26", "text": "これはすごい。 医者が"}, {"type": "subtitle", "time": 14315.99, "timestamp": "03:58:35", "text": "だから、"}, {"type": "subtitle", "time": 14319.429, "timestamp": "03:58:39", "text": "あの狙撃兵たちを殺したいんだ。   あの狙撃"}, {"type": "subtitle", "time": 14339.99, "timestamp": "03:58:59", "text": "ガキがいる。 生意気なガキがいる。   生意気な"}]
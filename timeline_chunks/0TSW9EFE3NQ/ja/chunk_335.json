[{"type": "subtitle", "time": 20100.548, "timestamp": "05:35:00", "text": "一緒に苦しむんだ。そう、一緒に行く。"}, {"type": "subtitle", "time": 20102.788, "timestamp": "05:35:02", "text": "一緒に出る。それが"}, {"type": "subtitle", "time": 20106.23, "timestamp": "05:35:06", "text": "契約だ。そういうことなんだ。"}, {"type": "subtitle", "time": 20109.35, "timestamp": "05:35:09", "text": "そう、それが取引だ。ここで"}, {"type": "subtitle", "time": 20112.15, "timestamp": "05:35:12", "text": "ベネットと78を1つずつ手に入れることができる。ニタが"}, {"type": "subtitle", "time": 20114.47, "timestamp": "05:35:14", "text": "近くにいないのは残念だ。"}, {"type": "subtitle", "time": 20116.39, "timestamp": "05:35:16", "text": "ベニー。"}, {"type": "subtitle", "time": 20119.19, "timestamp": "05:35:19", "text": "ベネット。彼をビルドすらしていないので、"}, {"type": "subtitle", "time": 20122.788, "timestamp": "05:35:22", "text": "よくわからない。うん。でも"}, {"type": "subtitle", "time": 20126.31, "timestamp": "05:35:26", "text": "、泣くようなことじゃないよ。"}, {"type": "subtitle", "time": 20129.91, "timestamp": "05:35:29", "text": "ああ、私のレイザーC5ボーイ。なんてこった、ひどい。"}, {"type": "subtitle", "time": 20133.83, "timestamp": "05:35:33", "text": "あそこを見て。これは何のゲーム？こんにちは、リーン。"}, {"type": "subtitle", "time": 20138.15, "timestamp": "05:35:38", "text": "それは「インサイド・ザ・バック・ルームズ」というゲームです。そう。"}, {"type": "subtitle", "time": 20139.67, "timestamp": "05:35:39", "text": "ホラーゲームです。バック"}, {"type": "subtitle", "time": 20141.67, "timestamp": "05:35:41", "text": "ルームだと思います。ええ、ホラーゲームです。"}, {"type": "subtitle", "time": 20143.91, "timestamp": "05:35:43", "text": "バックルームは、"}, {"type": "subtitle", "time": 20146.47, "timestamp": "05:35:46", "text": "ホラーゲームの美学のような"}, {"type": "subtitle", "time": 20148.23, "timestamp": "05:35:48", "text": "ものの中でとても人気があると思います。ああ、それは"}, {"type": "subtitle", "time": 20150.788, "timestamp": "05:35:50", "text": "ミームか何かだと思います。 ゲームですよ"}, {"type": "subtitle", "time": 20154.708, "timestamp": "05:35:54", "text": "ね？ まったくわかりません。"}]
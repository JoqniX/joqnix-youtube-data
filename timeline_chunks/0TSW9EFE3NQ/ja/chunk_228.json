[{"type": "subtitle", "time": 13683.429, "timestamp": "03:48:03", "text": "空虚など存在しない。 わかった。"}, {"type": "subtitle", "time": 13687.269, "timestamp": "03:48:07", "text": "127対27サーバーの起動を待っています"}, {"type": "subtitle", "time": 13689.91, "timestamp": "03:48:09", "text": "。 いいえ。なぜ"}, {"type": "subtitle", "time": 13693.03, "timestamp": "03:48:13", "text": "アジアや"}, {"type": "subtitle", "time": 13696.469, "timestamp": "03:48:16", "text": "あそこでは誰もプレイしていないのですか？ なぜアジアでは誰もプレイしないのか？"}, {"type": "subtitle", "time": 13698.63, "timestamp": "03:48:18", "text": "日本に行くべきでしょうか？"}, {"type": "subtitle", "time": 13702.71, "timestamp": "03:48:22", "text": "日本に行ってみたい。 それで、"}, {"type": "subtitle", "time": 13708.469, "timestamp": "03:48:28", "text": "すぐに中に入ることができました。 何？ よし、そろそろ行こう"}, {"type": "subtitle", "time": 13727.11, "timestamp": "03:48:47", "text": "その人物に何が起こっているのか？"}, {"type": "subtitle", "time": 13730.63, "timestamp": "03:48:50", "text": "ああ、ここで、どれが"}, {"type": "subtitle", "time": 13733.51, "timestamp": "03:48:53", "text": "欲しいかなどを選択するんです。 荷物を積み込んで、"}, {"type": "subtitle", "time": 13735.51, "timestamp": "03:48:55", "text": "すべて準備完了。"}, {"type": "subtitle", "time": 13738.229, "timestamp": "03:48:58", "text": "反射神経を鍛える"}]
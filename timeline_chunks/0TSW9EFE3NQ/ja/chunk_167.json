[{"type": "subtitle", "time": 10020.71, "timestamp": "02:47:00", "text": "プレイしてプレイして、色々なものをアンロックする。"}, {"type": "subtitle", "time": 10028.71, "timestamp": "02:47:08", "text": "。 注意喚起。 射撃場にいると、サウンドゲームが"}, {"type": "subtitle", "time": 10030.23, "timestamp": "02:47:10", "text": "正常に機能しません"}, {"type": "subtitle", "time": 10035.99, "timestamp": "02:47:15", "text": "。 わかった。 銃をテストする。 わかった。 チュートリアル"}, {"type": "subtitle", "time": 10038.07, "timestamp": "02:47:18", "text": "ライト。"}, {"type": "subtitle", "time": 10042.23, "timestamp": "02:47:22", "text": "チームメイトの頭上に三角形が表示され、"}, {"type": "subtitle", "time": 10045.349, "timestamp": "02:47:25", "text": "アーマーの要素が光ります"}, {"type": "subtitle", "time": 10047.83, "timestamp": "02:47:27", "text": "。 わかった。 光る。 待って。"}, {"type": "subtitle", "time": 10049.99, "timestamp": "02:47:29", "text": "鎧や金属の発光要素が"}, {"type": "subtitle", "time": 10053.429, "timestamp": "02:47:33", "text": "私には必要となるでしょう。 環境に優しい暮らしを。"}, {"type": "subtitle", "time": 10055.75, "timestamp": "02:47:35", "text": "えっと、"}, {"type": "subtitle", "time": 10058.389, "timestamp": "02:47:38", "text": "どうすればその鎧が分かるんですか？ よし、味方"}, {"type": "subtitle", "time": 10061.67, "timestamp": "02:47:41", "text": "同士の誤射だ。 ヒットした場合、"}, {"type": "subtitle", "time": 10063.51, "timestamp": "02:47:43", "text": "ショットの後にヒットマークが表示された場合は、それは敵です。"}, {"type": "subtitle", "time": 10067.67, "timestamp": "02:47:47", "text": "ああ、よかった。 はい、再読み込みと"}, {"type": "subtitle", "time": 10070.23, "timestamp": "02:47:50", "text": "管理です。   よし"}, {"type": "subtitle", "time": 10078.71, "timestamp": "02:47:58", "text": "えっと、Rキーを1回押すと、通常の低速リロードになります。"}]
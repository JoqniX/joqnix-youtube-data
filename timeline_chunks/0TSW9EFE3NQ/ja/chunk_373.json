[{"type": "subtitle", "time": 22399.03, "timestamp": "06:13:19", "text": "て。[音楽] 武器だ。1 2 3 4。たぶん 1 2 3 4。いや、うまくいかなかった。うまくいかなかった。私の人生は今日ほどひどいことはない。こんにちは、ビーコン。こんにちは。元気ですか？今日はいい日だといいな"}, {"type": "subtitle", "time": 22400.788, "timestamp": "06:13:20", "text": "。今日は最悪な日だ。なんてことだ。ああ、だめだ。"}, {"type": "subtitle", "time": 22404.948, "timestamp": "06:13:24", "text": "大丈夫だよ。誰にでも良い"}, {"type": "subtitle", "time": 22408.868, "timestamp": "06:13:28", "text": "日と悪い日がある。ベーコン。"}, {"type": "subtitle", "time": 22411.75, "timestamp": "06:13:31", "text": "大丈夫だよ。私がそばにいるから。"}, {"type": "subtitle", "time": 22414.39, "timestamp": "06:13:34", "text": "大丈夫になるよ。69 69"}, {"type": "subtitle", "time": 22432.47, "timestamp": "06:13:52", "text": "これはゲームの最初のパズルなのに、"}, {"type": "subtitle", "time": 22436.31, "timestamp": "06:13:56", "text": "それすら解けない。"}, {"type": "subtitle", "time": 22439.75, "timestamp": "06:13:59", "text": "私のベタベタした鍵。"}]
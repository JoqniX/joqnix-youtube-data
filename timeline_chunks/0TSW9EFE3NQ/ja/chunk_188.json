[{"type": "subtitle", "time": 11280.309, "timestamp": "03:08:00", "text": "。"}, {"type": "subtitle", "time": 11284.71, "timestamp": "03:08:04", "text": "誰も。 誰でも？ ディカ。"}, {"type": "subtitle", "time": 11288.23, "timestamp": "03:08:08", "text": "ああ、助けて。   わかった"}, {"type": "subtitle", "time": 11292.71, "timestamp": "03:08:12", "text": "。 私はそれを成し遂げる。   何てことだ"}, {"type": "subtitle", "time": 11296.71, "timestamp": "03:08:16", "text": "。 はい。 友人はあなたを生き返らせてくれる。"}, {"type": "subtitle", "time": 11300.309, "timestamp": "03:08:20", "text": "メニューを見るには、こちらを持ってください。"}, {"type": "subtitle", "time": 11311.99, "timestamp": "03:08:31", "text": "。  4つ。 何のために？"}, {"type": "subtitle", "time": 11323.99, "timestamp": "03:08:43", "text": "ああ、私は一体どこから来たのだろう？"}, {"type": "subtitle", "time": 11325.83, "timestamp": "03:08:45", "text": "このゲームでは、友達を安全な場所に引きずり出して"}]
[{"type": "subtitle", "time": 21303.75, "timestamp": "05:55:03", "text": "何が起こったの？何が起こったの？えっと、"}, {"type": "subtitle", "time": 21306.47, "timestamp": "05:55:06", "text": "待って。自分の声がほとんど聞こえない。Discordの"}, {"type": "subtitle", "time": 21308.948, "timestamp": "05:55:08", "text": "音声をオフにしたんだ。わかった。わかった"}, {"type": "subtitle", "time": 21312.948, "timestamp": "05:55:12", "text": "。今は自分の声が聞こえると思う。"}, {"type": "subtitle", "time": 21317.99, "timestamp": "05:55:17", "text": "いいね。あ、こんにちは。わかった。"}, {"type": "subtitle", "time": 21321.43, "timestamp": "05:55:21", "text": "それで、招待する必要があるよね？"}, {"type": "subtitle", "time": 21328.31, "timestamp": "05:55:28", "text": "[音楽]"}, {"type": "subtitle", "time": 21336.23, "timestamp": "05:55:36", "text": "。大丈夫だと思う"}, {"type": "subtitle", "time": 21339.27, "timestamp": "05:55:39", "text": "。実は、間違って"}, {"type": "subtitle", "time": 21345.27, "timestamp": "05:55:45", "text": "大丈夫。ハイドラ"}, {"type": "subtitle", "time": 21347.51, "timestamp": "05:55:47", "text": "、おかえり。本気で始めるよ"}, {"type": "subtitle", "time": 21349.67, "timestamp": "05:55:49", "text": "。30分か"}, {"type": "subtitle", "time": 21353.83, "timestamp": "05:55:53", "text": "5分くらい君たちを待たせるのはまずいだろう。"}]
[{"type": "subtitle", "time": 17884.31, "timestamp": "04:58:04", "text": "ああ、すごい。2つ手に入れた。手に入れた。ああ、なんてこった。すごい"}, {"type": "subtitle", "time": 17907.75, "timestamp": "04:58:27", "text": "すごい、プレイヤーがたくさんいる。"}, {"type": "subtitle", "time": 17924.628, "timestamp": "04:58:44", "text": "これを変えたい。変えてもいい？"}, {"type": "subtitle", "time": 17927.03, "timestamp": "04:58:47", "text": "走って。ああ、わかった。わかった。"}, {"type": "subtitle", "time": 17929.43, "timestamp": "04:58:49", "text": "これを変える必要はないよ。わかった。わかった。"}, {"type": "subtitle", "time": 17933.99, "timestamp": "04:58:53", "text": "アイアン。アイアンを見たのを覚えている"}, {"type": "subtitle", "time": 17939.91, "timestamp": "04:58:59", "text": "けど、バトルマガジンの下に"}]
[{"type": "subtitle", "time": 14117.99, "timestamp": "03:55:17", "text": "、この二人の狙撃手は"}, {"type": "subtitle", "time": 14121.99, "timestamp": "03:55:21", "text": "すごい狙撃をしている。 あれを見てください。"}, {"type": "subtitle", "time": 14124.229, "timestamp": "03:55:24", "text": "私は死んだ。"}, {"type": "subtitle", "time": 14127.269, "timestamp": "03:55:27", "text": "はい、私は死にました。   何てことだ"}, {"type": "subtitle", "time": 14130.309, "timestamp": "03:55:30", "text": "。"}, {"type": "subtitle", "time": 14158.87, "timestamp": "03:55:58", "text": "こっそり、こっそり、キーキー。   あれだ"}]
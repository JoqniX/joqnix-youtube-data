[{"type": "subtitle", "time": 4501.35, "timestamp": "01:15:01", "text": "オーケー。"}, {"type": "subtitle", "time": 4504.79, "timestamp": "01:15:04", "text": "ええと、もう花火です。いいえ、そうです。わかりません"}, {"type": "subtitle", "time": 4507.59, "timestamp": "01:15:07", "text": "。"}, {"type": "subtitle", "time": 4509.59, "timestamp": "01:15:09", "text": "彼らはそれを時間つぶしにプレイするべきだと思います。"}, {"type": "subtitle", "time": 4514.709, "timestamp": "01:15:14", "text": "わあ。ああ、大丈夫です。わかったと思います。"}, {"type": "subtitle", "time": 4524.709, "timestamp": "01:15:24", "text": "。これは何ですか？わかったと思います"}, {"type": "subtitle", "time": 4527.83, "timestamp": "01:15:27", "text": "。オーケー。"}, {"type": "subtitle", "time": 4530.39, "timestamp": "01:15:30", "text": "パズルゲームなどのようなものです。"}, {"type": "subtitle", "time": 4533.91, "timestamp": "01:15:33", "text": "サクラとマッチングされます。"}, {"type": "subtitle", "time": 4536.41, "timestamp": "01:15:36", "text": "他の誰かがプレイしています"}, {"type": "subtitle", "time": 4552.36, "timestamp": "01:15:52", "text": "うーん"}]
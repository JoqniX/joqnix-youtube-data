[{"type": "subtitle", "time": 22154.548, "timestamp": "06:09:14", "text": "14142 63 H そのパスワードは何？わから"}, {"type": "subtitle", "time": 22164.47, "timestamp": "06:09:24", "text": "ああ、待とう。 どこに行きたいの？ わからない"}, {"type": "subtitle", "time": 22168.548, "timestamp": "06:09:28", "text": "。なぜかわからない。"}, {"type": "subtitle", "time": 22171.19, "timestamp": "06:09:31", "text": "私たちは地下にいるんだよね"}, {"type": "subtitle", "time": 22173.59, "timestamp": "06:09:33", "text": "？ じゃあ"}, {"type": "subtitle", "time": 22177.83, "timestamp": "06:09:37", "text": "1階に行きたい。わかった。"}, {"type": "subtitle", "time": 22180.15, "timestamp": "06:09:40", "text": "待って、それってつまり"}, {"type": "subtitle", "time": 22182.868, "timestamp": "06:09:42", "text": "階のこと？"}, {"type": "subtitle", "time": 22186.39, "timestamp": "06:09:46", "text": "ああ、たぶん。3、6、2、0だと思う。"}, {"type": "subtitle", "time": 22197.35, "timestamp": "06:09:57", "text": "何の後ろにハッシュタグがあるの？ あそこにハッシュタグがある。"}]
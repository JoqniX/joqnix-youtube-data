[{"type": "subtitle", "time": 20762.868, "timestamp": "05:46:02", "text": "。彼が"}, {"type": "subtitle", "time": 20773.51, "timestamp": "05:46:13", "text": "。"}, {"type": "subtitle", "time": 20775.75, "timestamp": "05:46:15", "text": "ゲームで怒ったことある？激怒したことある？"}, {"type": "subtitle", "time": 20782.23, "timestamp": "05:46:22", "text": "いや、ない。泣いた。"}, {"type": "subtitle", "time": 20784.23, "timestamp": "05:46:24", "text": "それがシナモンロールってやつだよ"}, {"type": "subtitle", "time": 20786.788, "timestamp": "05:46:26", "text": "。シナモンロールってのは、"}, {"type": "subtitle", "time": 20792.708, "timestamp": "05:46:32", "text": "ゲームがイライラしても叫ばない人みたいな人"}, {"type": "subtitle", "time": 20794.788, "timestamp": "05:46:34", "text": "。泣くんだ。"}, {"type": "subtitle", "time": 20798.708, "timestamp": "05:46:38", "text": "「ああ、なんで"}, {"type": "subtitle", "time": 20802.23, "timestamp": "05:46:42", "text": "こんなことするの？」って言うだけ。だから、"}, {"type": "subtitle", "time": 20804.948, "timestamp": "05:46:44", "text": "彼が声を荒げたり、「もううんざりだ」って"}, {"type": "subtitle", "time": 20807.27, "timestamp": "05:46:47", "text": "怒ったりするのを聞いたことがない。 もう、"}, {"type": "subtitle", "time": 20808.708, "timestamp": "05:46:48", "text": "うんざりだ。  「遊びたくない。」彼がそんな風に言うのを聞いたことがない"}, {"type": "subtitle", "time": 20811.27, "timestamp": "05:46:51", "text": "。彼は"}, {"type": "subtitle", "time": 20815.19, "timestamp": "05:46:55", "text": "シナモンロールだ。確定。いや。なんてこった。わかった。さようなら"}]
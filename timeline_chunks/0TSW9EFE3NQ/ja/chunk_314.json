[{"type": "subtitle", "time": 18840.55, "timestamp": "05:14:00", "text": "来てくれて本当にありがとう。"}, {"type": "subtitle", "time": 18842.708, "timestamp": "05:14:02", "text": "今日は楽しんでくれたかな。"}, {"type": "subtitle", "time": 18845.43, "timestamp": "05:14:05", "text": "ブラッド、来てくれてありがとう。"}, {"type": "subtitle", "time": 18847.19, "timestamp": "05:14:07", "text": "昨日の配信にも来てくれてありがとう"}, {"type": "subtitle", "time": 18849.11, "timestamp": "05:14:09", "text": "。ありがとう。ありがとう。"}, {"type": "subtitle", "time": 18853.19, "timestamp": "05:14:13", "text": "バブーシャ、ありがとう。うん。こんにちは、"}, {"type": "subtitle", "time": 18855.43, "timestamp": "05:14:15", "text": "バブー、来てくれてありがとう。"}, {"type": "subtitle", "time": 18859.67, "timestamp": "05:14:19", "text": "うん。それで、締めくくろう。"}, {"type": "subtitle", "time": 18862.628, "timestamp": "05:14:22", "text": "時間だ。うん。だから、"}, {"type": "subtitle", "time": 18865.91, "timestamp": "05:14:25", "text": "今後このゲームをもっとプレイするつもりだし、えーと、なんて"}, {"type": "subtitle", "time": 18873.35, "timestamp": "05:14:33", "text": "言うんだっけ？楽しいよ。 友達と遊ぶゲームです"}, {"type": "subtitle", "time": 18876.31, "timestamp": "05:14:36", "text": "。Steamの友達などを招待できます"}, {"type": "subtitle", "time": 18878.39, "timestamp": "05:14:38", "text": "。"}, {"type": "subtitle", "time": 18880.628, "timestamp": "05:14:40", "text": "一緒に遊んだりできます。なので、おそらく"}, {"type": "subtitle", "time": 18886.948, "timestamp": "05:14:46", "text": "今後もっと一緒に遊んだり、コラボしたりする予定です"}, {"type": "subtitle", "time": 18889.43, "timestamp": "05:14:49", "text": "。でも、状況によります。状況によります"}, {"type": "subtitle", "time": 18892.07, "timestamp": "05:14:52", "text": "。でも、本当に楽しかったです。"}, {"type": "subtitle", "time": 18894.788, "timestamp": "05:14:54", "text": "明日、"}, {"type": "subtitle", "time": 18897.51, "timestamp": "05:14:57", "text": "できればまた会いましょう。"}]
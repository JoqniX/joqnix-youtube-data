[{"type": "subtitle", "time": 20823.51, "timestamp": "05:47:03", "text": "シナモンロールだ。"}, {"type": "subtitle", "time": 20827.75, "timestamp": "05:47:07", "text": "私たちの中で一番シナモンロール。"}, {"type": "subtitle", "time": 20838.708, "timestamp": "05:47:18", "text": "愛してる。私も愛してる。こんにちは、Pleu。"}, {"type": "subtitle", "time": 20840.47, "timestamp": "05:47:20", "text": "こんにちは。元気ですか？"}, {"type": "subtitle", "time": 20843.11, "timestamp": "05:47:23", "text": "今日はいい一日を過ごしているといいな。こんにちは。うん。こんにちは。こんにちは"}, {"type": "subtitle", "time": 20846.31, "timestamp": "05:47:26", "text": "。ショーン・"}, {"type": "subtitle", "time": 20848.948, "timestamp": "05:47:28", "text": "Jはどちらかというとシナモンロールだ。そう。ソフト"}, {"type": "subtitle", "time": 20850.948, "timestamp": "05:47:30", "text": "ボーイの雰囲気。"}, {"type": "subtitle", "time": 20853.83, "timestamp": "05:47:33", "text": "何？ソフトボーイって何？わからない。"}, {"type": "subtitle", "time": 20855.91, "timestamp": "05:47:35", "text": "ああ、それは、優しく話す人"}, {"type": "subtitle", "time": 20861.35, "timestamp": "05:47:41", "text": "優しく話す人みたいなもの。"}, {"type": "subtitle", "time": 20864.708, "timestamp": "05:47:44", "text": "ハードボーイはいるの？"}, {"type": "subtitle", "time": 20873.27, "timestamp": "05:47:53", "text": "ソフトボーイなら、"}, {"type": "subtitle", "time": 20878.23, "timestamp": "05:47:58", "text": "ハードボーイって何？ホットボーイって何？"}]
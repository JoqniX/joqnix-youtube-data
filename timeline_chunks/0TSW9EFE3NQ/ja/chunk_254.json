[{"type": "subtitle", "time": 15255.99, "timestamp": "04:14:15", "text": "誰かが私を癒してくれていると思った。 ああ、彼は"}, {"type": "subtitle", "time": 15293.51, "timestamp": "04:14:53", "text": "人々。 私はその"}, {"type": "subtitle", "time": 15296.229, "timestamp": "04:14:56", "text": "瞬間が好きだったのですが、私がそれを台無しにしてしまったと思います。 私は"}, {"type": "subtitle", "time": 15299.59, "timestamp": "04:14:59", "text": "文字通り、このゲームは健全なものではなく、誰も有害な人ではないと言いました"}]
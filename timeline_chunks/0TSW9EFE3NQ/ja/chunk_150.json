[{"type": "subtitle", "time": 9006.71, "timestamp": "02:30:06", "text": "ジョイパイとワンワンパスゴーは、"}, {"type": "subtitle", "time": 9009.99, "timestamp": "02:30:09", "text": "スピードランみたいで、"}, {"type": "subtitle", "time": 9012.79, "timestamp": "02:30:12", "text": "これらすべてを終わらせるようなものですが、"}, {"type": "subtitle", "time": 9029.99, "timestamp": "02:30:29", "text": "明日、おやすみなさい、良い"}, {"type": "subtitle", "time": 9043.51, "timestamp": "02:30:43", "text": "流れ星が"}, {"type": "subtitle", "time": 9046.87, "timestamp": "02:30:46", "text": "空に痕跡を残すことに気づいたことはありますか？"}, {"type": "subtitle", "time": 9049.75, "timestamp": "02:30:49", "text": "彼らがこの世を去った後も、"}, {"type": "subtitle", "time": 9053.51, "timestamp": "02:30:53", "text": "その光は私たちの記憶の中に残り続ける。"}, {"type": "subtitle", "time": 9057.349, "timestamp": "02:30:57", "text": "それらは単なる宇宙の残骸だと言う人もいるが、"}]
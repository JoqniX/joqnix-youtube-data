[{"type": "subtitle", "time": 8880.469, "timestamp": "02:28:00", "text": "スノーウィー、来てくれてありがとう。 本当に本当に大きな意味があります"}, {"type": "subtitle", "time": 8883.349, "timestamp": "02:28:03", "text": "。 楽しんでいただければ幸いです。"}, {"type": "subtitle", "time": 8887.19, "timestamp": "02:28:07", "text": "残りの夜もどうぞお過ごしください。 よく眠ってね。カイが来て、"}, {"type": "subtitle", "time": 8892.07, "timestamp": "02:28:12", "text": "カイが来てくれた。 はい、"}, {"type": "subtitle", "time": 8894.63, "timestamp": "02:28:14", "text": "ヴァンドラ・チャマを入手しました。 だから、ヴァンドラを手に入れられて本当に嬉しいです"}, {"type": "subtitle", "time": 8897.11, "timestamp": "02:28:17", "text": "。"}, {"type": "subtitle", "time": 8905.27, "timestamp": "02:28:25", "text": "よく眠れませんでした。 眠いって言ってたよね"}, {"type": "subtitle", "time": 8914.79, "timestamp": "02:28:34", "text": "荷物と一緒にぐっすり眠ってください。 いや、外は"}, {"type": "subtitle", "time": 8923.03, "timestamp": "02:28:43", "text": "寒いから、暖かくして安全に過ごしてね。 すべての人にとって"}, {"type": "subtitle", "time": 8925.19, "timestamp": "02:28:45", "text": "。 そう、だから、"}, {"type": "subtitle", "time": 8931.83, "timestamp": "02:28:51", "text": "温かい飲み物などを飲むようにしてください。"}, {"type": "subtitle", "time": 8933.75, "timestamp": "02:28:53", "text": "ええ、今日の配信のボードは、"}, {"type": "subtitle", "time": 8935.99, "timestamp": "02:28:55", "text": "私たちがやったように、ただ"}]
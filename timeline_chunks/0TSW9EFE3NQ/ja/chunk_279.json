[{"type": "subtitle", "time": 16741.59, "timestamp": "04:39:01", "text": "よし、別のメガネを選ぼう。"}, {"type": "subtitle", "time": 16744.39, "timestamp": "04:39:04", "text": "みんなメディックに行く。じゃあ私も"}, {"type": "subtitle", "time": 16748.47, "timestamp": "04:39:08", "text": "メディックにしよう。なぜダメなんだ？"}, {"type": "subtitle", "time": 16751.349, "timestamp": "04:39:11", "text": "これは何のため？"}, {"type": "subtitle", "time": 16755.029, "timestamp": "04:39:15", "text": "ああ、中距離。ああ、"}, {"type": "subtitle", "time": 16759.99, "timestamp": "04:39:19", "text": "赤いレーザー。よし、迷彩フラッシュ。"}, {"type": "subtitle", "time": 16763.67, "timestamp": "04:39:23", "text": "ああ、スキンを選択できるようになった。"}, {"type": "subtitle", "time": 16766.869, "timestamp": "04:39:26", "text": "緑にする。"}, {"type": "subtitle", "time": 16772.709, "timestamp": "04:39:32", "text": "この青いのが欲しい。500 キル。 000キル。 なんてこった。 なんてこった。 すごい"}, {"type": "subtitle", "time": 16780.39, "timestamp": "04:39:40", "text": "。"}, {"type": "subtitle", "time": 16792.15, "timestamp": "04:39:52", "text": "バレた。"}]
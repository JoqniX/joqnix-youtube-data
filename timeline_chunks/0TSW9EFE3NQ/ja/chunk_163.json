[{"type": "subtitle", "time": 9780.23, "timestamp": "02:43:00", "text": "Windows上では"}, {"type": "subtitle", "time": 9784.71, "timestamp": "02:43:04", "text": "266MHzに制限されていて、"}, {"type": "subtitle", "time": 9790.95, "timestamp": "02:43:10", "text": "それが問題でした。 私は「どうして？どうしてうまくいかないの"}, {"type": "subtitle", "time": 9794.79, "timestamp": "02:43:14", "text": "？」と思いました。 何が"}, {"type": "subtitle", "time": 9797.11, "timestamp": "02:43:17", "text": "起こっているのか？ 待って、なぜゲームが"}, {"type": "subtitle", "time": 9799.75, "timestamp": "02:43:19", "text": "起動しないの？"}, {"type": "subtitle", "time": 9804.71, "timestamp": "02:43:24", "text": "何に対してこんにちは？"}, {"type": "subtitle", "time": 9807.67, "timestamp": "02:43:27", "text": "え、何？ 何？ 試合はどこにあるの？"}, {"type": "subtitle", "time": 9809.52, "timestamp": "02:43:29", "text": "ロンズではない。"}, {"type": "subtitle", "time": 9811.03, "timestamp": "02:43:31", "text": "[音楽]"}, {"type": "subtitle", "time": 9813.67, "timestamp": "02:43:33", "text": "ああ、なんてことだ。 私をからかってるの？ ああ、そうそう"}, {"type": "subtitle", "time": 9815.349, "timestamp": "02:43:35", "text": "。"}, {"type": "subtitle", "time": 9827.83, "timestamp": "02:43:47", "text": "音声やその他の部分がすべて良好であることを願っています"}, {"type": "subtitle", "time": 9829.75, "timestamp": "02:43:49", "text": "。"}, {"type": "subtitle", "time": 9836.95, "timestamp": "02:43:56", "text": "こちらにはフィルターなどは一切ありません。 基本的には、"}]
[{"type": "subtitle", "time": 15064.469, "timestamp": "04:11:04", "text": "よし、あと1試合残ってる。そしたら"}, {"type": "subtitle", "time": 15065.99, "timestamp": "04:11:05", "text": "呼ばれるかもしれない。 もうすぐ"}, {"type": "subtitle", "time": 15068.389, "timestamp": "04:11:08", "text": "8歳になる。"}, {"type": "subtitle", "time": 15071.189, "timestamp": "04:11:11", "text": "昨日、夕食を食べたのは確か9時頃だったよね？   わからない"}, {"type": "subtitle", "time": 15074.63, "timestamp": "04:11:14", "text": "。 しかし、"}, {"type": "subtitle", "time": 15087.83, "timestamp": "04:11:27", "text": "鉄道関係の何かを見に行きたい。"}, {"type": "subtitle", "time": 15089.59, "timestamp": "04:11:29", "text": "あの地下鉄の路線が立ち並ぶ"}, {"type": "subtitle", "time": 15091.429, "timestamp": "04:11:31", "text": "地区。"}, {"type": "subtitle", "time": 15094.71, "timestamp": "04:11:34", "text": "私は以前ここに来たことがあっただろうか？"}, {"type": "subtitle", "time": 15096.15, "timestamp": "04:11:36", "text": "可能であれば、すべてのマップをプレイしたいです"}, {"type": "subtitle", "time": 15098.71, "timestamp": "04:11:38", "text": "。 でも、そうそう、"}, {"type": "subtitle", "time": 15101.83, "timestamp": "04:11:41", "text": "ところで、私の"}, {"type": "subtitle", "time": 15104.07, "timestamp": "04:11:44", "text": "良いニュースは"}, {"type": "subtitle", "time": 15108.229, "timestamp": "04:11:48", "text": "57％のオペレーションです。 私はすべてを"}, {"type": "subtitle", "time": 15109.83, "timestamp": "04:11:49", "text": "軽く済ませるようにした。   ええ"}, {"type": "subtitle", "time": 15112.469, "timestamp": "04:11:52", "text": "、これにします。"}, {"type": "subtitle", "time": 15115.189, "timestamp": "04:11:55", "text": "よし、これ以上は何も追加しないでおこう"}, {"type": "subtitle", "time": 15117.03, "timestamp": "04:11:57", "text": "。 オーバーレイのみを修正してください。 それでおしまい"}]
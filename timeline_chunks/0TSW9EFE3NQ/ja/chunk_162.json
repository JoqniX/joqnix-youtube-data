[{"type": "subtitle", "time": 9723.27, "timestamp": "02:42:03", "text": "【音楽】さあ行こう"}, {"type": "subtitle", "time": 9726.95, "timestamp": "02:42:06", "text": "。 ゲームシーン。 これを調整する必要があったんですよね"}, {"type": "subtitle", "time": 9729.67, "timestamp": "02:42:09", "text": "？"}, {"type": "subtitle", "time": 9733.19, "timestamp": "02:42:13", "text": "うん。 昨日、私たちは最初"}, {"type": "subtitle", "time": 9735.91, "timestamp": "02:42:15", "text": "から自分たちのシーンのすべてを作り上げたような感じでした"}, {"type": "subtitle", "time": 9738.79, "timestamp": "02:42:18", "text": "。 だから、それは確かに"}, {"type": "subtitle", "time": 9742.87, "timestamp": "02:42:22", "text": "苦痛なことなんだ。 昨日の配信"}, {"type": "subtitle", "time": 9746.15, "timestamp": "02:42:26", "text": "について、どう考えたらいいのか全く分かりません。"}, {"type": "subtitle", "time": 9749.59, "timestamp": "02:42:29", "text": "私たちはできる限り修理しようと試みましたが"}, {"type": "subtitle", "time": 9753.27, "timestamp": "02:42:33", "text": "、それでもうまくいきませんでした。"}, {"type": "subtitle", "time": 9762.95, "timestamp": "02:42:42", "text": "OBS 用に不要なものを削除してサイズを小さくしてできるだけ軽くするたびに、"}, {"type": "subtitle", "time": 9766.63, "timestamp": "02:42:46", "text": "CPU 使用率が 100% になっていましたが、原因は RAM の"}, {"type": "subtitle", "time": 9769.11, "timestamp": "02:42:49", "text": "速度でした。"}, {"type": "subtitle", "time": 9772.79, "timestamp": "02:42:52", "text": "私は32GBのRAMを購入したのですが、その"}, {"type": "subtitle", "time": 9777.349, "timestamp": "02:42:57", "text": "速度は3600MHzくらいで、"}]
[{"type": "subtitle", "time": 18480.39, "timestamp": "05:08:00", "text": "明後日の30日までに椅子とか全部揃えて、"}, {"type": "subtitle", "time": 18483.83, "timestamp": "05:08:03", "text": "快適に座れるようにするかもしれない。うん、"}, {"type": "subtitle", "time": 18486.15, "timestamp": "05:08:06", "text": "待ちきれないよ。"}, {"type": "subtitle", "time": 18489.35, "timestamp": "05:08:09", "text": "でも、うん、本当に楽しかった。OBS"}, {"type": "subtitle", "time": 18492.708, "timestamp": "05:08:12", "text": "でシーンとか色々修正しないといけないんだけど、"}, {"type": "subtitle", "time": 18496.868, "timestamp": "05:08:16", "text": "そういうのは全部"}, {"type": "subtitle", "time": 18500.628, "timestamp": "05:08:20", "text": "終わったんだ。あとはなんて言うんだっけ？"}, {"type": "subtitle", "time": 18503.51, "timestamp": "05:08:23", "text": "えっと、サミーの"}, {"type": "subtitle", "time": 18507.59, "timestamp": "05:08:27", "text": "やつ、自動化のやつ。"}, {"type": "subtitle", "time": 18510.708, "timestamp": "05:08:30", "text": "でも、うん、Twitchで配信するよ。 たぶん"}, {"type": "subtitle", "time": 18513.51, "timestamp": "05:08:33", "text": "、もっと"}, {"type": "subtitle", "time": 18515.11, "timestamp": "05:08:35", "text": "Twitchで配信しないといけないからだと思う。もっと"}, {"type": "subtitle", "time": 18518.23, "timestamp": "05:08:38", "text": "アクティブにしないと。あそこでアクティブにならないとね。まあ"}, {"type": "subtitle", "time": 18524.23, "timestamp": "05:08:44", "text": "、とにかく、"}, {"type": "subtitle", "time": 18526.31, "timestamp": "05:08:46", "text": "配信を締めくくりましょう。皆さん、来てくれてありがとう。"}, {"type": "subtitle", "time": 18529.99, "timestamp": "05:08:49", "text": "今日来てくれた皆さん、来てくれてありがとう"}, {"type": "subtitle", "time": 18536.31, "timestamp": "05:08:56", "text": "。久しぶりに会えてよかった。来てくれて本当にありがとう。"}]
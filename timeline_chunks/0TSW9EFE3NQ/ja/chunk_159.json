[{"type": "subtitle", "time": 9542.389, "timestamp": "02:39:02", "text": "ビデオエ​​ディターでアップロードエラーが発生したため、やらなければならないことがあったからです。 私はDinci Resolveを使って"}, {"type": "subtitle", "time": 9546.07, "timestamp": "02:39:06", "text": "YouTubeに動画や編集したものをアップロードしようとしたのですが、"}, {"type": "subtitle", "time": 9548.15, "timestamp": "02:39:08", "text": "ボードなどを"}, {"type": "subtitle", "time": 9550.79, "timestamp": "02:39:10", "text": "直接YouTubeにアップロードできず、"}, {"type": "subtitle", "time": 9552.87, "timestamp": "02:39:12", "text": "手動で編集したりカットしたりしなければなりませんでした"}, {"type": "subtitle", "time": 9555.11, "timestamp": "02:39:15", "text": "。 それはまあ、何というか、そういうことなんです"}, {"type": "subtitle", "time": 9557.11, "timestamp": "02:39:17", "text": "。"}, {"type": "subtitle", "time": 9560.15, "timestamp": "02:39:20", "text": "うん。 やあ、君。"}, {"type": "subtitle", "time": 9562.389, "timestamp": "02:39:22", "text": "お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 9565.349, "timestamp": "02:39:25", "text": "マナの状態はどうですか？ マナが動いている。 えっと、"}, {"type": "subtitle", "time": 9567.27, "timestamp": "02:39:27", "text": "私があなたにつけたニックネームは何でしたっけ？"}, {"type": "subtitle", "time": 9571.11, "timestamp": "02:39:31", "text": "忘れた。 ベイビー、明日ね。   今、"}, {"type": "subtitle", "time": 9574.309, "timestamp": "02:39:34", "text": "マニャーナって言った？   そうそう"}, {"type": "subtitle", "time": 9577.03, "timestamp": "02:39:37", "text": "。 忘れた。 君にニックネームをつけていたんだ"}, {"type": "subtitle", "time": 9588.71, "timestamp": "02:39:48", "text": "二人いるから、一人は私のニックネーム、もう一人は私のニックネームを持っていて、"}, {"type": "subtitle", "time": 9595.27, "timestamp": "02:39:55", "text": "その二つは使えないんだ。それはその"}, {"type": "subtitle", "time": 9597.99, "timestamp": "02:39:57", "text": "二人専用のニックネームだから、"}]
[{"type": "subtitle", "time": 20584.39, "timestamp": "05:43:04", "text": "。うん。世界で一番辛いチップス"}, {"type": "subtitle", "time": 20586.31, "timestamp": "05:43:06", "text": "。食べてみたい。うんうん。うん。"}, {"type": "subtitle", "time": 20590.788, "timestamp": "05:43:10", "text": "美味しそう。"}, {"type": "subtitle", "time": 20592.708, "timestamp": "05:43:12", "text": "うん。食べてみたい"}, {"type": "subtitle", "time": 20595.43, "timestamp": "05:43:15", "text": "。食べて、次の日に"}, {"type": "subtitle", "time": 20597.19, "timestamp": "05:43:17", "text": "後悔したい。それがしたいこと"}, {"type": "subtitle", "time": 20599.43, "timestamp": "05:43:19", "text": "。"}, {"type": "subtitle", "time": 20601.19, "timestamp": "05:43:21", "text": "ああ、やれやれ。"}, {"type": "subtitle", "time": 20603.99, "timestamp": "05:43:23", "text": "シナモンロールって何だか知ってるの"}, {"type": "subtitle", "time": 20606.708, "timestamp": "05:43:26", "text": "？そう、まさに。どうして知ってるの？"}, {"type": "subtitle", "time": 20609.99, "timestamp": "05:43:29", "text": "それは、あなたが可愛くて、可愛くて、甘いってこと。"}, {"type": "subtitle", "time": 20612.23, "timestamp": "05:43:32", "text": "あなたは可愛くて甘くて、"}, {"type": "subtitle", "time": 20614.548, "timestamp": "05:43:34", "text": "何もできない。だから、あなたのタイプの"}, {"type": "subtitle", "time": 20616.948, "timestamp": "05:43:36", "text": "人はみんなに守ってもらいたくなる。それから、ジョーカー"}, {"type": "subtitle", "time": 20619.11, "timestamp": "05:43:39", "text": "先輩。ジョーク先輩は シナモンロール。"}, {"type": "subtitle", "time": 20621.27, "timestamp": "05:43:41", "text": "あ、待って。いや、君がシナモン"}, {"type": "subtitle", "time": 20624.868, "timestamp": "05:43:44", "text": "ロールだ。いや、私は違う。君がシナモン"}, {"type": "subtitle", "time": 20627.11, "timestamp": "05:43:47", "text": "ロールだ。みんな君を守りたいんだ。"}, {"type": "subtitle", "time": 20630.23, "timestamp": "05:43:50", "text": "君は私たちの中で一番甘いと思う。"}, {"type": "subtitle", "time": 20635.83, "timestamp": "05:43:55", "text": "、君だよ。シナモンロールが一番"}, {"type": "subtitle", "time": 20638.31, "timestamp": "05:43:58", "text": "甘い人だ。そう、それはシュガープレイだ。私の記憶が正しければ、"}]
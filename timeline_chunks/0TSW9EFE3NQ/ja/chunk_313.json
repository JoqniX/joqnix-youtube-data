[{"type": "subtitle", "time": 18781.35, "timestamp": "05:13:01", "text": "起きたらストリームをやろうかな。"}, {"type": "subtitle", "time": 18783.91, "timestamp": "05:13:03", "text": "ええ、それから"}, {"type": "subtitle", "time": 18785.91, "timestamp": "05:13:05", "text": "昨日配信しなかったことを悲しまないよね？明日もね。"}, {"type": "subtitle", "time": 18787.99, "timestamp": "05:13:07", "text": "よし、明日やろう。明日やろう。"}, {"type": "subtitle", "time": 18798.708, "timestamp": "05:13:18", "text": "うん、愚痴配信とかやろう"}, {"type": "subtitle", "time": 18801.03, "timestamp": "05:13:21", "text": "。"}, {"type": "subtitle", "time": 18804.31, "timestamp": "05:13:24", "text": "終わらないで。私のせいだよ。仕事が"}, {"type": "subtitle", "time": 18809.11, "timestamp": "05:13:29", "text": "下手なんだ。ああ、大丈夫だよ。うん、"}, {"type": "subtitle", "time": 18811.11, "timestamp": "05:13:31", "text": "締めくくらなきゃいけなかったんだ。"}, {"type": "subtitle", "time": 18812.788, "timestamp": "05:13:32", "text": "うん。わから"}, {"type": "subtitle", "time": 18829.11, "timestamp": "05:13:49", "text": "も夜勤をしてるんだ。だから、頑張って。頑張って。頑張って。"}, {"type": "subtitle", "time": 18834.788, "timestamp": "05:13:54", "text": "それで、えーと、来てくれてありがとう"}, {"type": "subtitle", "time": 18838.23, "timestamp": "05:13:58", "text": "。"}]
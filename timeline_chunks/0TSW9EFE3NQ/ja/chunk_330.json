[{"type": "subtitle", "time": 19800.948, "timestamp": "05:30:00", "text": "先週あなたとプレイしたPhasmophobia以外、ホラーゲームはプレイしたことがない"}, {"type": "subtitle", "time": 19803.35, "timestamp": "05:30:03", "text": "。"}, {"type": "subtitle", "time": 19805.91, "timestamp": "05:30:05", "text": "うん、私も。でも、最近"}, {"type": "subtitle", "time": 19809.75, "timestamp": "05:30:09", "text": "ハロウィンのせいでホラーゲームを始めたばかりなの。 わから"}, {"type": "subtitle", "time": 19811.91, "timestamp": "05:30:11", "text": "ない。なぜみんなが"}, {"type": "subtitle", "time": 19814.15, "timestamp": "05:30:14", "text": "ハロウィンの期間中ずっとそうするべきなのかわからない。わかった"}, {"type": "subtitle", "time": 19815.67, "timestamp": "05:30:15", "text": "。うん、つまり"}, {"type": "subtitle", "time": 19818.39, "timestamp": "05:30:18", "text": "美学に合っている。わかった。わかった。"}, {"type": "subtitle", "time": 19820.708, "timestamp": "05:30:20", "text": "こんにちは。こんにちは、テンペスト。こんにちは。"}, {"type": "subtitle", "time": 19822.23, "timestamp": "05:30:22", "text": "こんにちは、リメル。こんにちは。お元気ですか？"}, {"type": "subtitle", "time": 19824.15, "timestamp": "05:30:24", "text": "今日は元気だといいな。奥の部屋は"}, {"type": "subtitle", "time": 19826.31, "timestamp": "05:30:26", "text": "父が牛乳を買いに行った場所で、"}, {"type": "subtitle", "time": 19828.31, "timestamp": "05:30:28", "text": "私は彼が"}, {"type": "subtitle", "time": 19834.868, "timestamp": "05:30:34", "text": "彼は戻ってくるよ。心配しないで。彼は戻ってくるよ。"}, {"type": "subtitle", "time": 19837.67, "timestamp": "05:30:37", "text": "そう、ただ待つしかない。彼は戻ってくるよ"}, {"type": "subtitle", "time": 19839.51, "timestamp": "05:30:39", "text": "。でもデザインは"}, {"type": "subtitle", "time": 19843.51, "timestamp": "05:30:43", "text": "あなたの性格に完​​璧に合っている。やった。"}, {"type": "subtitle", "time": 19848.788, "timestamp": "05:30:48", "text": "他のチャンネルについて言っても大丈夫かどうかわからない。どういう意味？"}, {"type": "subtitle", "time": 19852.628, "timestamp": "05:30:52", "text": "彼は反抗するの？何？これは正確には"}, {"type": "subtitle", "time": 19855.83, "timestamp": "05:30:55", "text": "ゲームではない。えっと、これはストーリーのようなもので、"}, {"type": "subtitle", "time": 19859.11, "timestamp": "05:30:59", "text": "ゲームはそれに基づいている。ああ。ああ、"}]
[{"type": "subtitle", "time": 5280.87, "timestamp": "01:28:00", "text": "さあ。"}, {"type": "subtitle", "time": 5282.47, "timestamp": "01:28:02", "text": "うん、このイベントをスピードランして、すぐに"}, {"type": "subtitle", "time": 5285.59, "timestamp": "01:28:05", "text": "ストリームを終わらせようとしてます"}, {"type": "subtitle", "time": 5292.229, "timestamp": "01:28:12", "text": "待って、イベントは終わったの？わからない"}, {"type": "subtitle", "time": 5294.149, "timestamp": "01:28:14", "text": "。"}, {"type": "subtitle", "time": 5298.149, "timestamp": "01:28:18", "text": "イベントクエストがない。"}, {"type": "subtitle", "time": 5310.229, "timestamp": "01:28:30", "text": "行かなきゃいけないんだ。"}, {"type": "subtitle", "time": 5317.51, "timestamp": "01:28:37", "text": "後でもっと詳しく教えて。"}, {"type": "subtitle", "time": 5321.75, "timestamp": "01:28:41", "text": "ああ。ああ、終わった。ああ、これはハイ"}, {"type": "subtitle", "time": 5337.59, "timestamp": "01:28:57", "text": "[音楽]"}, {"type": "subtitle", "time": 5339.27, "timestamp": "01:28:59", "text": "完了してください。よし、終わった。"}]
[{"type": "subtitle", "time": 2115.349, "timestamp": "00:35:15", "text": "他在哪裡？他在哪裡？  我的"}, {"type": "subtitle", "time": 2124.15, "timestamp": "00:35:24", "text": "我有點噎住了。"}, {"type": "subtitle", "time": 2126.55, "timestamp": "00:35:26", "text": "另外，我剛剛發現我的滑鼠設定"}, {"type": "subtitle", "time": 2130.15, "timestamp": "00:35:30", "text": "不一樣。我來改一下。"}, {"type": "subtitle", "time": 2146.71, "timestamp": "00:35:46", "text": "盾牌陣營。"}]
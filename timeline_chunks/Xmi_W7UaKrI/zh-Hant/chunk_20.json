[{"type": "subtitle", "time": 1202.71, "timestamp": "00:20:02", "text": "我們應該沒問題。"}, {"type": "subtitle", "time": 1208.15, "timestamp": "00:20:08", "text": "燈光將在 30 秒後完成，"}, {"type": "subtitle", "time": 1211.59, "timestamp": "00:20:11", "text": "我終於可以開始玩遊戲了。  告訴他們"}, {"type": "subtitle", "time": 1220.31, "timestamp": "00:20:20", "text": "這款遊戲看起來好像沒有原神。"}, {"type": "subtitle", "time": 1222.549, "timestamp": "00:20:22", "text": "呃，這不是原神，這是藍色協議。我在倒數第二次"}, {"type": "subtitle", "time": 1238.789, "timestamp": "00:20:38", "text": "它被稱為藍色協議。"}, {"type": "subtitle", "time": 1241.029, "timestamp": "00:20:41", "text": "呃，"}, {"type": "subtitle", "time": 1245.75, "timestamp": "00:20:45", "text": "如果我的音訊被遊戲或其他東西蓋過了，請告訴我。好的，請告訴我。"}]
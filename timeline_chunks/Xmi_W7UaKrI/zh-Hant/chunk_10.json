[{"type": "subtitle", "time": 601.43, "timestamp": "00:10:01", "text": "。"}, {"type": "subtitle", "time": 616.23, "timestamp": "00:10:16", "text": "？好的。嗯，大概要花"}, {"type": "subtitle", "time": 618.949, "timestamp": "00:10:18", "text": "多久時間？ 7分鐘。"}, {"type": "subtitle", "time": 625.829, "timestamp": "00:10:25", "text": "等待。我們應該一直執行藍色協議直到"}, {"type": "subtitle", "time": 631.19, "timestamp": "00:10:31", "text": "它完成嗎？呃，請問"}, {"type": "subtitle", "time": 633.11, "timestamp": "00:10:33", "text": "我可以暫時換個遊戲玩"}, {"type": "subtitle", "time": 635.99, "timestamp": "00:10:35", "text": "一會兒嗎？"}, {"type": "subtitle", "time": 641.509, "timestamp": "00:10:41", "text": "嗯，你知道嗎？在我們等待期間，"}, {"type": "subtitle", "time": 644.23, "timestamp": "00:10:44", "text": "我先上車。"}, {"type": "subtitle", "time": 646.23, "timestamp": "00:10:46", "text": "我的意思是，只需要"}, {"type": "subtitle", "time": 648.71, "timestamp": "00:10:48", "text": "等7分鐘，所以我不想讓"}, {"type": "subtitle", "time": 650.949, "timestamp": "00:10:50", "text": "你們"}, {"type": "subtitle", "time": 659.509, "timestamp": "00:10:59", "text": "另外，還有一款名為《我們到了嗎？ 》的冒險合作遊戲。"}]
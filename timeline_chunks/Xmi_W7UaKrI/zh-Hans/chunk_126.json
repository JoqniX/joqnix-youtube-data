[{"type": "subtitle", "time": 7568.87, "timestamp": "02:06:08", "text": "我从未扮演过这个角色。 我不"}, {"type": "subtitle", "time": 7575.51, "timestamp": "02:06:15", "text": "我希望……嗯，是的，Cinda"}, {"type": "subtitle", "time": 7591.27, "timestamp": "02:06:31", "text": "[音乐]"}, {"type": "subtitle", "time": 7594.81, "timestamp": "02:06:34", "text": "我有一头蓝头发。 毛莫。"}, {"type": "subtitle", "time": 7602.709, "timestamp": "02:06:42", "text": "这是旅游巴士。 这就是"}, {"type": "subtitle", "time": 7605.91, "timestamp": "02:06:45", "text": "我想要的皮肤，我原本打算"}, {"type": "subtitle", "time": 7611.91, "timestamp": "02:06:51", "text": "那个日本高中"}, {"type": "subtitle", "time": 7614.709, "timestamp": "02:06:54", "text": "女生一样，对吧？ 就是那种事。"}]
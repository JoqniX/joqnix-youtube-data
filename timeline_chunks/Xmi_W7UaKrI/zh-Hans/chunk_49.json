[{"type": "subtitle", "time": 2954.069, "timestamp": "00:49:14", "text": "不，"}, {"type": "subtitle", "time": 2956.87, "timestamp": "00:49:16", "text": "好吧，我死了。 我死了。 好吧，这是我"}, {"type": "subtitle", "time": 2959.51, "timestamp": "00:49:19", "text": "咎由自取。 好吧，这是我咎由自取。 好吧，"}, {"type": "subtitle", "time": 2961.75, "timestamp": "00:49:21", "text": "行。"}, {"type": "subtitle", "time": 2963.75, "timestamp": "00:49:23", "text": "好吧，他们确实是佛罗里达州的人。 他们会"}, {"type": "subtitle", "time": 2965.75, "timestamp": "00:49:25", "text": "说：“兄弟，这"}, {"type": "subtitle", "time": 2972.87, "timestamp": "00:49:32", "text": "“"}, {"type": "subtitle", "time": 2976.96, "timestamp": "00:49:36", "text": "我的天哪。”"}]
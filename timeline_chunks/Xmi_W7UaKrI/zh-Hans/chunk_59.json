[{"type": "subtitle", "time": 3551.109, "timestamp": "00:59:11", "text": "我会尽量在实战中多打出爆头"}, {"type": "subtitle", "time": 3554.309, "timestamp": "00:59:14", "text": "。 我明白，"}, {"type": "subtitle", "time": 3557.109, "timestamp": "00:59:17", "text": "我已经习惯了这款游戏中"}, {"type": "subtitle", "time": 3560.549, "timestamp": "00:59:20", "text": "机器人太多、真人玩家太少的情况，但即便如此，"}, {"type": "subtitle", "time": 3563.99, "timestamp": "00:59:23", "text": "当它是真正的真人玩家时，感觉还是不一样。"}, {"type": "subtitle", "time": 3566.95, "timestamp": "00:59:26", "text": "好了，终于找到队友了。"}, {"type": "subtitle", "time": 3570.39, "timestamp": "00:59:30", "text": "哦，不错。 我们终于有队友了"}]
[{"type": "subtitle", "time": 3310.23, "timestamp": "00:55:10", "text": "[音乐]"}, {"type": "subtitle", "time": 3323.349, "timestamp": "00:55:23", "text": "我应该只在有"}, {"type": "subtitle", "time": 3328.39, "timestamp": "00:55:28", "text": "办法让"}, {"type": "subtitle", "time": 3333.19, "timestamp": "00:55:33", "text": "人们进入我家大厅的情况下才敲门。 我本来很喜欢"}, {"type": "subtitle", "time": 3335.109, "timestamp": "00:55:35", "text": "这款游戏，但是它一直没给我匹配到其他玩家"}]
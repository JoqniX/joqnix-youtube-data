[{"type": "subtitle", "time": 8886.389, "timestamp": "02:28:06", "text": "哦，是的。 这个人其实是扮演"}, {"type": "subtitle", "time": 8890.95, "timestamp": "02:28:10", "text": "法莱的。 我想我找到他们想要的东西了。"}, {"type": "subtitle", "time": 8905.19, "timestamp": "02:28:25", "text": "所以他们就像是"}, {"type": "subtitle", "time": 8927.19, "timestamp": "02:28:47", "text": "而这个人就像是"}]
[{"type": "subtitle", "time": 9065.67, "timestamp": "02:31:05", "text": "是的，我们今天的工作就到此结束了。"}, {"type": "subtitle", "time": 9069.67, "timestamp": "02:31:09", "text": "我的妇产科诊所还没有完全配备这个"}, {"type": "subtitle", "time": 9072.23, "timestamp": "02:31:12", "text": "最基本的设备。 但我只会在"}, {"type": "subtitle", "time": 9077.83, "timestamp": "02:31:17", "text": "玩一些"}, {"type": "subtitle", "time": 9080.55, "timestamp": "02:31:20", "text": "需要更高帧率的游戏时才会使用这种显而易见的技巧。 对于《"}, {"type": "subtitle", "time": 9082.71, "timestamp": "02:31:22", "text": "原神》和其他类型的游戏，我会"}, {"type": "subtitle", "time": 9092.79, "timestamp": "02:31:32", "text": "等等，我把它弄丢了吗？"}, {"type": "subtitle", "time": 9106.23, "timestamp": "02:31:46", "text": "好的，没问题了。 嗯，是的。"}, {"type": "subtitle", "time": 9108.87, "timestamp": "02:31:48", "text": "总之，谢谢观看。 谢谢"}, {"type": "subtitle", "time": 9111.11, "timestamp": "02:31:51", "text": "你今天抽出时间。"}, {"type": "subtitle", "time": 9115.429, "timestamp": "02:31:55", "text": "祝大家未来一切顺利。"}]
[{"type": "subtitle", "time": 7022.149, "timestamp": "01:57:02", "text": "兄弟，"}, {"type": "subtitle", "time": 7023.18, "timestamp": "01:57:03", "text": "不行。"}, {"type": "subtitle", "time": 7031.27, "timestamp": "01:57:11", "text": "为什么？ 等等，等等。 游戏为什么"}, {"type": "subtitle", "time": 7037.43, "timestamp": "01:57:17", "text": "请不要这样对我。 请。 我"}, {"type": "subtitle", "time": 7039.35, "timestamp": "01:57:19", "text": "想要那场胜利。"}, {"type": "subtitle", "time": 7043.75, "timestamp": "01:57:23", "text": "这是一场排位赛。 求求"}, {"type": "subtitle", "time": 7045.589, "timestamp": "01:57:25", "text": "你了。"}, {"type": "subtitle", "time": 7049.189, "timestamp": "01:57:29", "text": "等等，它为什么卡住了？"}, {"type": "subtitle", "time": 7054.39, "timestamp": "01:57:34", "text": "等等，搞什么鬼，兄弟？ 搞什么鬼？"}]
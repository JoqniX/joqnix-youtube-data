[{"type": "subtitle", "time": 7568.87, "timestamp": "02:06:08", "text": "私はこのキャラクターをプレイしたことがありません。"}, {"type": "subtitle", "time": 7575.51, "timestamp": "02:06:15", "text": "ああ、シンダが"}, {"type": "subtitle", "time": 7591.27, "timestamp": "02:06:31", "text": "[音楽]"}, {"type": "subtitle", "time": 7594.81, "timestamp": "02:06:34", "text": "私は青い髪をしています。 マモ。"}, {"type": "subtitle", "time": 7602.709, "timestamp": "02:06:42", "text": "こちらはシーズンバスです。 これが"}, {"type": "subtitle", "time": 7605.91, "timestamp": "02:06:45", "text": "私が欲しい肌で、"}, {"type": "subtitle", "time": 7611.91, "timestamp": "02:06:51", "text": "日本の"}, {"type": "subtitle", "time": 7614.709, "timestamp": "02:06:54", "text": "女子高生みたいな感じだよね？ そういう類のものだ。"}]
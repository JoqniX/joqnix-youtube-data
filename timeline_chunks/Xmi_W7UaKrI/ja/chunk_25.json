[{"type": "subtitle", "time": 1526.149, "timestamp": "00:25:26", "text": "え？ あ、待って。 新しいスキンが登場しました。"}, {"type": "subtitle", "time": 1529.51, "timestamp": "00:25:29", "text": "イベント。 何？ そうそう。"}, {"type": "subtitle", "time": 1537.669, "timestamp": "00:25:37", "text": "。 今、イベントが開催されています。"}, {"type": "subtitle", "time": 1543.269, "timestamp": "00:25:43", "text": "あ、そういえば今イベントがあるんだった。"}, {"type": "subtitle", "time": 1546.71, "timestamp": "00:25:46", "text": "ああ、この肌、大好き。"}, {"type": "subtitle", "time": 1551.269, "timestamp": "00:25:51", "text": "俺はこのリボルバーが欲しいんだよ。"}]
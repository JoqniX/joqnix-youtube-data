[{"type": "subtitle", "time": 541.19, "timestamp": "00:09:01", "text": "時々OBSに切り替えようと思ったことがあるんだけど、"}, {"type": "subtitle", "time": 544.15, "timestamp": "00:09:04", "text": "もし君が僕に聞くなら、"}, {"type": "subtitle", "time": 548.63, "timestamp": "00:09:08", "text": "OBSを使い続ければいいじゃないか？ 答えは、"}, {"type": "subtitle", "time": 558.31, "timestamp": "00:09:18", "text": "軽いゲームには明らかに切り替えた方が良いでしょう。"}, {"type": "subtitle", "time": 562.23, "timestamp": "00:09:22", "text": "重いゲームには切り替えた方が良いでしょう。"}, {"type": "subtitle", "time": 565.99, "timestamp": "00:09:25", "text": "今は軽いセットアップを維持したいからです。 だから、"}, {"type": "subtitle", "time": 569.19, "timestamp": "00:09:29", "text": "すべてを極めて軽量に保つようにしています。"}, {"type": "subtitle", "time": 571.99, "timestamp": "00:09:31", "text": "OBSの方が良いと思う。"}, {"type": "subtitle", "time": 576.47, "timestamp": "00:09:36", "text": "OBS では、新しいアップデート 32 でプラグインを無効化できるようになりました"}, {"type": "subtitle", "time": 584.15, "timestamp": "00:09:44", "text": "。プラグインを簡単に無効化できます。"}, {"type": "subtitle", "time": 586.63, "timestamp": "00:09:46", "text": "ええ、"}, {"type": "subtitle", "time": 589.829, "timestamp": "00:09:49", "text": "軽くてアイテムがストリーミングされるので、"}, {"type": "subtitle", "time": 597.67, "timestamp": "00:09:57", "text": "チャットなどを見るためのマルチリーミングがより簡単になります。"}]
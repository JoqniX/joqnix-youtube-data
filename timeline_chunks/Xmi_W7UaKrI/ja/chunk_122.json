[{"type": "subtitle", "time": 7325.83, "timestamp": "02:02:05", "text": "ああ、ああ、待って。 まだ"}, {"type": "subtitle", "time": 7340.39, "timestamp": "02:02:20", "text": "[音楽]"}, {"type": "subtitle", "time": 7347.43, "timestamp": "02:02:27", "text": "さらに、新しいヒーローも入手できます。 私は"}, {"type": "subtitle", "time": 7351.109, "timestamp": "02:02:31", "text": "現在30,000持っています。"}, {"type": "subtitle", "time": 7352.79, "timestamp": "02:02:32", "text": "このアイテムは他のイベントでも入手可能です"}, {"type": "subtitle", "time": 7355.589, "timestamp": "02:02:35", "text": "。 進む。"}, {"type": "subtitle", "time": 7359.27, "timestamp": "02:02:39", "text": "H. その通りです。"}, {"type": "subtitle", "time": 7376.37, "timestamp": "02:02:56", "text": "機械を無料で配っている。"}]
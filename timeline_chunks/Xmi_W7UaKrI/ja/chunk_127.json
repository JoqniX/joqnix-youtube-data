[{"type": "subtitle", "time": 7631.669, "timestamp": "02:07:11", "text": "今シーズン、何か新しいものはありますか？ そう、黄金の"}, {"type": "subtitle", "time": 7634.39, "timestamp": "02:07:14", "text": "翼だ。 そう、それだ。"}, {"type": "subtitle", "time": 7636.17, "timestamp": "02:07:16", "text": "これはぜひ欲しいです。"}, {"type": "subtitle", "time": 7637.589, "timestamp": "02:07:17", "text": "[音楽]"}, {"type": "subtitle", "time": 7641.109, "timestamp": "02:07:21", "text": "ああ、そういえば、"}, {"type": "subtitle", "time": 7648.87, "timestamp": "02:07:28", "text": "待って、私はゲームを再起動していません。 何？   わかった"}, {"type": "subtitle", "time": 7652.47, "timestamp": "02:07:32", "text": "、気にしないで。 私は「"}, {"type": "subtitle", "time": 7655.669, "timestamp": "02:07:35", "text": "いつ入れるんだろう？」と待っていました。"}, {"type": "subtitle", "time": 7658.39, "timestamp": "02:07:38", "text": "ああ、ゲームを始めたんだ。 それもまた然り。"}]
[{"type": "subtitle", "time": 1081.99, "timestamp": "00:18:01", "text": "。 はい、86％です。"}, {"type": "subtitle", "time": 1083.19, "timestamp": "00:18:03", "text": "切り替えます。"}, {"type": "subtitle", "time": 1100.71, "timestamp": "00:18:20", "text": "終わらせなければならない"}, {"type": "subtitle", "time": 1118.39, "timestamp": "00:18:38", "text": "[音楽]"}, {"type": "subtitle", "time": 1121.669, "timestamp": "00:18:41", "text": "よし、日課は終わりだ。 えっと、"}, {"type": "subtitle", "time": 1124.39, "timestamp": "00:18:44", "text": "ちょっとクエストをこなさないといけないんです。 よし、あと1分くらいかな"}, {"type": "subtitle", "time": 1126.31, "timestamp": "00:18:46", "text": "。 日々の"}, {"type": "subtitle", "time": 1127.909, "timestamp": "00:18:47", "text": "報酬は受け取らない方が良いでしょうか？ スキップしても大丈夫ですよね"}, {"type": "subtitle", "time": 1129.43, "timestamp": "00:18:49", "text": "？"}, {"type": "subtitle", "time": 1139.909, "timestamp": "00:18:59", "text": "あるいは、これは私が"}]
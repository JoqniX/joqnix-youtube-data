[{"type": "subtitle", "time": 668.63, "timestamp": "00:11:08", "text": "えっと、楽しそうなゲームですね。"}, {"type": "subtitle", "time": 673.75, "timestamp": "00:11:13", "text": "キャンピングカーを使って"}, {"type": "subtitle", "time": 681.67, "timestamp": "00:11:21", "text": "どこかへ行ったり、"}, {"type": "subtitle", "time": 683.269, "timestamp": "00:11:23", "text": "山を登ったり、あれこれしたりするゲームです"}, {"type": "subtitle", "time": 685.19, "timestamp": "00:11:25", "text": "。"}, {"type": "subtitle", "time": 689.67, "timestamp": "00:11:29", "text": "面白そうなゲームですね。"}, {"type": "subtitle", "time": 693.75, "timestamp": "00:11:33", "text": "10月21日に再リリースされたばかりです。"}, {"type": "subtitle", "time": 697.35, "timestamp": "00:11:37", "text": "試してみたいです。"}, {"type": "subtitle", "time": 699.59, "timestamp": "00:11:39", "text": "誰か一緒に"}, {"type": "subtitle", "time": 717.75, "timestamp": "00:11:57", "text": "あ、ちょっと接続が切れるかもしれません"}]
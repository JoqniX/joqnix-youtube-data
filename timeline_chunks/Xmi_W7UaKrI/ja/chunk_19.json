[{"type": "subtitle", "time": 1141.43, "timestamp": "00:19:01", "text": "昨日ボスキーをやらなかったということです。"}, {"type": "subtitle", "time": 1146.87, "timestamp": "00:19:06", "text": "だから、鍵を1つ無駄にしたんだ。"}, {"type": "subtitle", "time": 1151.27, "timestamp": "00:19:11", "text": "今朝、1つやりました。 あの、あのね？ それは"}, {"type": "subtitle", "time": 1153.51, "timestamp": "00:19:13", "text": "後で考えます。"}, {"type": "subtitle", "time": 1197.029, "timestamp": "00:19:57", "text": "ええと、わかりました"}, {"type": "subtitle", "time": 1199.11, "timestamp": "00:19:59", "text": "。"}]
[{"type": "subtitle", "time": 1202.71, "timestamp": "00:20:02", "text": "うん、大丈夫だろう。"}, {"type": "subtitle", "time": 1208.15, "timestamp": "00:20:08", "text": "30秒後には照明が点灯するので、"}, {"type": "subtitle", "time": 1211.59, "timestamp": "00:20:11", "text": "ようやくゲームをプレイできます。"}, {"type": "subtitle", "time": 1220.31, "timestamp": "00:20:20", "text": "このゲームには原神が入っていないように見える。"}, {"type": "subtitle", "time": 1222.549, "timestamp": "00:20:22", "text": "えっと、原神じゃなくて、ブルー"}, {"type": "subtitle", "time": 1226.31, "timestamp": "00:20:26", "text": "プロトコルだよ。 このゲームは、前回の配信の2つ前の配信でプレイしました"}, {"type": "subtitle", "time": 1234.71, "timestamp": "00:20:34", "text": "私は前回の配信の2つ前の配信でこのゲームをプレイしました"}, {"type": "subtitle", "time": 1238.789, "timestamp": "00:20:38", "text": "。 それはブループロトコルと呼ばれています。"}, {"type": "subtitle", "time": 1241.029, "timestamp": "00:20:41", "text": "えっと、"}, {"type": "subtitle", "time": 1245.75, "timestamp": "00:20:45", "text": "私の音声が"}]
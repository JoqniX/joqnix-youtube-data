[{"type": "subtitle", "time": 6606.149, "timestamp": "01:50:06", "text": "私はあの箱を見つけなければならなかった。 特別なルート"}, {"type": "subtitle", "time": 6618.55, "timestamp": "01:50:18", "text": "つまり、300個集めれば、"}, {"type": "subtitle", "time": 6621.109, "timestamp": "01:50:21", "text": "新しいキャラクターの新しいスキンが手に入るということですね。 そして、"}, {"type": "subtitle", "time": 6623.51, "timestamp": "01:50:23", "text": "それらを100個集めれば、"}, {"type": "subtitle", "time": 6625.669, "timestamp": "01:50:25", "text": "無料のヒーロー、"}]
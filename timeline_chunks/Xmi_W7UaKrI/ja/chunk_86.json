[{"type": "subtitle", "time": 5161.43, "timestamp": "01:26:01", "text": "死んだ。 私は死んだ。 私は死んだ。 私は死んだ。 私は"}, {"type": "subtitle", "time": 5191.59, "timestamp": "01:26:31", "text": "おい、おい。 ああ、なんてことだ。 我が神よ。 私の忍者"}, {"type": "subtitle", "time": 5204.229, "timestamp": "01:26:44", "text": "私の忍者カード。"}, {"type": "subtitle", "time": 5205.91, "timestamp": "01:26:45", "text": "ああ、ありがとうございます。 誰かが蘇生した。"}, {"type": "subtitle", "time": 5208.149, "timestamp": "01:26:48", "text": "ありがとう。 ありがとう。 ありがとう。 ありがとう。"}, {"type": "subtitle", "time": 5218.149, "timestamp": "01:26:58", "text": "。 私は永遠にあなたに捧げます。"}]
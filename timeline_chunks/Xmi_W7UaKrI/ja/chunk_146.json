[{"type": "subtitle", "time": 8763.59, "timestamp": "02:26:03", "text": "あ、待って、私は"}, {"type": "subtitle", "time": 8767.27, "timestamp": "02:26:07", "text": "今インドで世界トップ100に入ってるの？ 待って、私は今"}, {"type": "subtitle", "time": 8769.51, "timestamp": "02:26:09", "text": "インドでトップ100に入ってるよ。 え、"}, {"type": "subtitle", "time": 8771.83, "timestamp": "02:26:11", "text": "何？ 待って、待って、待って、待って、待って、"}, {"type": "subtitle", "time": 8782.309, "timestamp": "02:26:22", "text": "[音楽]の"}, {"type": "subtitle", "time": 8784.23, "timestamp": "02:26:24", "text": "矢の力とは何ですか？"}, {"type": "subtitle", "time": 8786.63, "timestamp": "02:26:26", "text": "待って、実際は"}, {"type": "subtitle", "time": 8791.59, "timestamp": "02:26:31", "text": "世界のトップ100、オーケー、待って、世界、世界、"}, {"type": "subtitle", "time": 8798.55, "timestamp": "02:26:38", "text": "インドはどうなの？待って、私は今トップなの？"}, {"type": "subtitle", "time": 8803.99, "timestamp": "02:26:43", "text": "リーダーボード"}, {"type": "subtitle", "time": 8805.75, "timestamp": "02:26:45", "text": "ヒーローを確認させてください。"}, {"type": "subtitle", "time": 8807.11, "timestamp": "02:26:47", "text": "[音楽]"}, {"type": "subtitle", "time": 8810.95, "timestamp": "02:26:50", "text": "私は100リストに入ってないよ。"}, {"type": "subtitle", "time": 8813.67, "timestamp": "02:26:53", "text": "[音楽]"}, {"type": "subtitle", "time": 8819.349, "timestamp": "02:26:59", "text": "ああ、これは世界的な問題だ。"}]
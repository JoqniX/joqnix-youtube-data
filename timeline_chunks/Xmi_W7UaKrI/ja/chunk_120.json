[{"type": "subtitle", "time": 7202.629, "timestamp": "02:00:02", "text": "ジョー、そろそろ仕事を終える"}, {"type": "subtitle", "time": 7206.07, "timestamp": "02:00:06", "text": "時間だよ、って言ってるんだと思うよ。"}, {"type": "subtitle", "time": 7210.149, "timestamp": "02:00:10", "text": "私が得ているのはそういうことだと思います。"}, {"type": "subtitle", "time": 7212.95, "timestamp": "02:00:12", "text": "うん、ゲームが「今日はあと"}, {"type": "subtitle", "time": 7217.189, "timestamp": "02:00:17", "text": "2時間で終わりだね」とか言ってるような気がする"}, {"type": "chat", "time": 7223.203, "timestamp": "02:00:23", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/DfgfY9LaNdmMq7IPuI2AaA"}, {"type": "chat", "time": 7234.608, "timestamp": "02:00:34", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "game time??"}, {"type": "subtitle", "time": 7236.31, "timestamp": "02:00:36", "text": "ここに閉じ込められていますが、"}, {"type": "subtitle", "time": 7238.709, "timestamp": "02:00:38", "text": "今日はこれで終わりにしましょう。 今は2時間経ちました"}, {"type": "subtitle", "time": 7242.629, "timestamp": "02:00:42", "text": "。 明日は原神をプレイします"}, {"type": "subtitle", "time": 7245.669, "timestamp": "02:00:45", "text": "。 こんにちは、核兵器担当のショーン。"}, {"type": "subtitle", "time": 7253.03, "timestamp": "02:00:53", "text": "ゲームがクラッシュしたんです"}, {"type": "subtitle", "time": 7255.51, "timestamp": "02:00:55", "text": "。"}, {"type": "subtitle", "time": 7259.51, "timestamp": "02:00:59", "text": "私のランクポイントはなので、もうやめます"}]
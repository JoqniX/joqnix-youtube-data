[{"type": "subtitle", "time": 1389.35, "timestamp": "00:23:09", "text": "。"}, {"type": "subtitle", "time": 1392.63, "timestamp": "00:23:12", "text": "こんにちは、ビデオ。 ついに、長い間待った末に。 あなたに"}, {"type": "subtitle", "time": 1421.59, "timestamp": "00:23:41", "text": "わかりました。 じゃあ、遊ぼうよ。 ちなみに、私はダイヤモンドです"}, {"type": "subtitle", "time": 1426.789, "timestamp": "00:23:46", "text": "。 初めてレベル"}, {"type": "subtitle", "time": 1430.23, "timestamp": "00:23:50", "text": "上げを考えたゲームがこれだった。"}, {"type": "subtitle", "time": 1433.43, "timestamp": "00:23:53", "text": "でも、慣れるために普通の仔犬から始めます"}]
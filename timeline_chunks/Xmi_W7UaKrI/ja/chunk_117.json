[{"type": "subtitle", "time": 7022.149, "timestamp": "01:57:02", "text": "兄弟、ダメだよ"}, {"type": "subtitle", "time": 7023.18, "timestamp": "01:57:03", "text": "。"}, {"type": "subtitle", "time": 7031.27, "timestamp": "01:57:11", "text": "なぜ？ 待って、待って。 ゲームが"}, {"type": "subtitle", "time": 7037.43, "timestamp": "01:57:17", "text": "どうか私にそんなことをしないでください。 お願いします。 私は"}, {"type": "subtitle", "time": 7039.35, "timestamp": "01:57:19", "text": "その勝利が欲しい。"}, {"type": "subtitle", "time": 7043.75, "timestamp": "01:57:23", "text": "それはランキング戦だった。 お願い、"}, {"type": "subtitle", "time": 7045.589, "timestamp": "01:57:25", "text": "お願い。"}, {"type": "subtitle", "time": 7049.189, "timestamp": "01:57:29", "text": "待って、なぜ動かなくなっているの？"}, {"type": "subtitle", "time": 7054.39, "timestamp": "01:57:34", "text": "おいおい、一体どういうことだ？ 一体どういうことだ？"}]
[{"type": "subtitle", "time": 3362.23, "timestamp": "00:56:02", "text": "モバイル。 うん。 うん。 うん。 このゲームは"}, {"type": "subtitle", "time": 3365.03, "timestamp": "00:56:05", "text": "当初モバイル向けにリリースされ、その後"}, {"type": "subtitle", "time": 3376.23, "timestamp": "00:56:16", "text": "ああ、このスキンは無料で手に入るんだ。 わかった。   そうすれば、"}, {"type": "subtitle", "time": 3387.99, "timestamp": "00:56:27", "text": "問題は、私には、えっと、なんて"}, {"type": "subtitle", "time": 3392.23, "timestamp": "00:56:32", "text": "言うんだっけ？ この"}, {"type": "subtitle", "time": 3394.47, "timestamp": "00:56:34", "text": "人たちは誰ですか？"}, {"type": "subtitle", "time": 3410.95, "timestamp": "00:56:50", "text": "ああ、私はインドのトップ100にも入ってないよ。"}, {"type": "subtitle", "time": 3414.71, "timestamp": "00:56:54", "text": "よし、じゃあ素晴らしいね。"}]
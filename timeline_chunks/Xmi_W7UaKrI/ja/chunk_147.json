[{"type": "subtitle", "time": 8821.75, "timestamp": "02:27:01", "text": "モー・ヴァレンティーノって誰？ え、何？"}, {"type": "subtitle", "time": 8842.87, "timestamp": "02:27:22", "text": "[音楽]"}, {"type": "subtitle", "time": 8857.83, "timestamp": "02:27:37", "text": "私はインドで34歳です。 ああ、わかりました。 ニース。  34."}, {"type": "subtitle", "time": 8861.429, "timestamp": "02:27:41", "text": "我々はトップ50に入った。何だって？"}, {"type": "subtitle", "time": 8867.99, "timestamp": "02:27:47", "text": "くそ。"}]
[{"type": "subtitle", "time": 4441.91, "timestamp": "01:14:01", "text": "ランクに関しては、"}, {"type": "subtitle", "time": 4443.91, "timestamp": "01:14:03", "text": "このゲームをプレイしている人が少ないし、"}, {"type": "subtitle", "time": 4446.07, "timestamp": "01:14:06", "text": "ほとんどの場合ロビーが購入されているので"}, {"type": "subtitle", "time": 4447.91, "timestamp": "01:14:07", "text": "、"}, {"type": "subtitle", "time": 4454.07, "timestamp": "01:14:14", "text": "運良く常に"}, {"type": "subtitle", "time": 4460.709, "timestamp": "01:14:20", "text": "そう、そうやって僕は"}, {"type": "subtitle", "time": 4463.83, "timestamp": "01:14:23", "text": "レジェンドランクに到達したんだ。"}, {"type": "subtitle", "time": 4470.95, "timestamp": "01:14:30", "text": "待って、見せてあげるよ。"}, {"type": "subtitle", "time": 4473.59, "timestamp": "01:14:33", "text": "ええ、文字通りです。 例えば、"}, {"type": "subtitle", "time": 4482.55, "timestamp": "01:14:42", "text": "うん。 どうやってこんなに勝てたかって？"}, {"type": "subtitle", "time": 4485.99, "timestamp": "01:14:45", "text": "ほとんどの場合、Bロビーで、"}]
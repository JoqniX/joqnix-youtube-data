[{"type": "subtitle", "time": 9065.67, "timestamp": "02:31:05", "text": "はい、今日はこれで終わりにします。"}, {"type": "subtitle", "time": 9069.67, "timestamp": "02:31:09", "text": "私の産婦人科医は、"}, {"type": "subtitle", "time": 9072.23, "timestamp": "02:31:12", "text": "このための最低限の設備が整っていません。 しかし、"}, {"type": "subtitle", "time": 9075.27, "timestamp": "02:31:15", "text": "このような明らかな設定を使うのは、"}, {"type": "subtitle", "time": 9080.55, "timestamp": "02:31:20", "text": "より高いFPSなどを必要とするゲームをプレイする場合に限られます。"}, {"type": "subtitle", "time": 9082.71, "timestamp": "02:31:22", "text": "原神や他の種類のゲームでは、私は"}, {"type": "subtitle", "time": 9092.79, "timestamp": "02:31:32", "text": "あれ、なくしちゃったのかな？"}, {"type": "subtitle", "time": 9106.23, "timestamp": "02:31:46", "text": "、大丈夫です。 ええ、そうですね。"}, {"type": "subtitle", "time": 9108.87, "timestamp": "02:31:48", "text": "ともあれ、ご視聴ありがとうございました。"}, {"type": "subtitle", "time": 9111.11, "timestamp": "02:31:51", "text": "本日はありがとうございました。"}, {"type": "subtitle", "time": 9115.429, "timestamp": "02:31:55", "text": "皆さん、良い一日をお過ごしください。"}]
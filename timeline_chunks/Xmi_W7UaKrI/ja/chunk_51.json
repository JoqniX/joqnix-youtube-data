[{"type": "subtitle", "time": 3062.39, "timestamp": "00:51:02", "text": "うん。 問題は、ランク戦では"}, {"type": "subtitle", "time": 3066.23, "timestamp": "00:51:06", "text": "少し待たなければならないということです。"}, {"type": "subtitle", "time": 3068.95, "timestamp": "00:51:08", "text": "そこが問題なんです。 それに、私ってよく言葉に"}, {"type": "subtitle", "time": 3093.03, "timestamp": "00:51:33", "text": "ええ、あれは実在の選手です。 あ、待って。"}, {"type": "subtitle", "time": 3107.75, "timestamp": "00:51:47", "text": "ああ、あれは本物の選手だ。"}]
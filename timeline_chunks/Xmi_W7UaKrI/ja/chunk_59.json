[{"type": "subtitle", "time": 3554.309, "timestamp": "00:59:14", "text": "実際のプレイでは、もっとヘッドショットを狙うように心がけます。 分かってるよ、"}, {"type": "subtitle", "time": 3557.109, "timestamp": "00:59:17", "text": "このゲームには"}, {"type": "subtitle", "time": 3560.549, "timestamp": "00:59:20", "text": "ボットが多すぎて、本物のプレイヤーがいないことに慣れすぎているのは。でも、"}, {"type": "subtitle", "time": 3563.99, "timestamp": "00:59:23", "text": "実際に本物のプレイヤーがいるときは。"}, {"type": "subtitle", "time": 3566.95, "timestamp": "00:59:26", "text": "よし、ついにチームメイトだ。"}, {"type": "subtitle", "time": 3570.39, "timestamp": "00:59:30", "text": "おお、いいね。 ついにチームメイトができた"}]
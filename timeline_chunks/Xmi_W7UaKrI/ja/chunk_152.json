[{"type": "subtitle", "time": 9136.07, "timestamp": "02:32:16", "text": "こんにちは。 本日はありがとうございました。"}, {"type": "subtitle", "time": 9138.79, "timestamp": "02:32:18", "text": "これで終わりにします。 わかった。 明日の"}, {"type": "subtitle", "time": 9140.63, "timestamp": "02:32:20", "text": "配信でお会いしましょう。 明日はたぶん午前"}, {"type": "subtitle", "time": 9145.27, "timestamp": "02:32:25", "text": "10時頃だと思う。"}, {"type": "subtitle", "time": 9159.75, "timestamp": "02:32:39", "text": "バイバイ。 良い。 皆さん、お元気で。 また"}, {"type": "subtitle", "time": 9161.67, "timestamp": "02:32:41", "text": "明日ね。"}]
[{"type": "subtitle", "time": 482.71, "timestamp": "00:08:02", "text": "これならいいかも。"}, {"type": "subtitle", "time": 485.51, "timestamp": "00:08:05", "text": "そう、これだ。 ええ、"}, {"type": "subtitle", "time": 487.51, "timestamp": "00:08:07", "text": "私が使っているのはこれです。"}, {"type": "subtitle", "time": 497.909, "timestamp": "00:08:17", "text": "ええと、それなら使えますね。"}, {"type": "subtitle", "time": 504.469, "timestamp": "00:08:24", "text": "待って、私のゲームシーンはどこ？ あ、待って。"}, {"type": "subtitle", "time": 506.29, "timestamp": "00:08:26", "text": "これは私のゲームだ。"}, {"type": "subtitle", "time": 507.43, "timestamp": "00:08:27", "text": "[音楽]"}, {"type": "subtitle", "time": 512.7090000000001, "timestamp": "00:08:32", "text": "オーケー。 知らなかったよ、兄弟。  50％。"}, {"type": "subtitle", "time": 514.31, "timestamp": "00:08:34", "text": "とにかく、"}, {"type": "subtitle", "time": 517.11, "timestamp": "00:08:37", "text": "この場所で自分のシーンをセットアップしなければならない"}, {"type": "subtitle", "time": 520.55, "timestamp": "00:08:40", "text": "。 おお。"}, {"type": "subtitle", "time": 523.029, "timestamp": "00:08:43", "text": "ああ。"}, {"type": "subtitle", "time": 525.19, "timestamp": "00:08:45", "text": "まあ、そうですね。 皆さん、今日の調子はいかがですか？"}, {"type": "subtitle", "time": 528.389, "timestamp": "00:08:48", "text": "こんにちは。 こんにちは。 ようこそ。"}, {"type": "subtitle", "time": 530.79, "timestamp": "00:08:50", "text": "昨晩はいかがでしたか？ 午後、夕方、"}, {"type": "subtitle", "time": 533.19, "timestamp": "00:08:53", "text": "午前は分かります。"}, {"type": "subtitle", "time": 536.71, "timestamp": "00:08:56", "text": "皆さん、お元気ですか？ ディオ、"}]
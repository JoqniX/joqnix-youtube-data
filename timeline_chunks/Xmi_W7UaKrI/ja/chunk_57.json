[{"type": "subtitle", "time": 3430.069, "timestamp": "00:57:10", "text": "ええ、モバイル版もありますよ。"}, {"type": "subtitle", "time": 3431.829, "timestamp": "00:57:11", "text": "モバイルでプレイすると、"}, {"type": "subtitle", "time": 3435.51, "timestamp": "00:57:15", "text": "Apex Legends Mobileみたいな感じがする。"}, {"type": "subtitle", "time": 3437.589, "timestamp": "00:57:17", "text": "そして、Apex Legends Mobileが再び復活するという話を聞きましたが、"}, {"type": "subtitle", "time": 3443.19, "timestamp": "00:57:23", "text": "今回は独立したゲームでは"}, {"type": "subtitle", "time": 3446.71, "timestamp": "00:57:26", "text": "なく、統合されたゲームになるようです。"}]
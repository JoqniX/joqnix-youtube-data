[{"type": "subtitle", "time": 1933.19, "timestamp": "00:32:13", "text": "No, it's like a invisible barrier is"}, {"type": "subtitle", "time": 1936.07, "timestamp": "00:32:16", "text": "like pushing me to the side."}, {"type": "subtitle", "time": 1958.23, "timestamp": "00:32:38", "text": "Damn. Why? Stop pushing me. And I"}, {"type": "subtitle", "time": 1961.269, "timestamp": "00:32:41", "text": "invisible. I could not. Wait, is that"}, {"type": "subtitle", "time": 1976.549, "timestamp": "00:32:56", "text": "I only did once. What are you doing?"}, {"type": "subtitle", "time": 1979.509, "timestamp": "00:32:59", "text": "Jump. Wait."}]
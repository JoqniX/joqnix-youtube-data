[{"type": "subtitle", "time": 23101.91, "timestamp": "06:25:01", "text": "它最好暫時躲在這裡。"}, {"type": "subtitle", "time": 23104.628, "timestamp": "06:25:04", "text": "[音樂]"}, {"type": "subtitle", "time": 23107.15, "timestamp": "06:25:07", "text": "哦，這些人是誰？這是誰"}, {"type": "subtitle", "time": 23110.708, "timestamp": "06:25:10", "text": "？這是誰？我在"}, {"type": "subtitle", "time": 23119.39, "timestamp": "06:25:19", "text": "地方的信息。"}, {"type": "subtitle", "time": 23132.788, "timestamp": "06:25:32", "text": "我的天哪，她長了一隻可怕的手"}, {"type": "subtitle", "time": 23140.47, "timestamp": "06:25:40", "text": "。哇，"}, {"type": "subtitle", "time": 23141.788, "timestamp": "06:25:41", "text": "她看起來真是酷斃了"}, {"type": "subtitle", "time": 23146.11, "timestamp": "06:25:46", "text": "。  她還好，"}]
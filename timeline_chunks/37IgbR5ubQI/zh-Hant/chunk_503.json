[{"type": "subtitle", "time": 30182.548, "timestamp": "08:23:02", "text": "謝謝你，路易斯。是啊，我殺了，我殺了。我的天哪。"}, {"type": "subtitle", "time": 30186.708, "timestamp": "08:23:06", "text": "你們兩個。"}, {"type": "subtitle", "time": 30188.788, "timestamp": "08:23:08", "text": "不，傑克。"}, {"type": "subtitle", "time": 30191.03, "timestamp": "08:23:11", "text": "不，我不能。我不能，我不能，我不能。我"}, {"type": "subtitle", "time": 30195.27, "timestamp": "08:23:15", "text": "可以這樣補充能量。"}, {"type": "subtitle", "time": 30203.91, "timestamp": "08:23:23", "text": "亞歷克斯，我們走吧。"}, {"type": "subtitle", "time": 30206.788, "timestamp": "08:23:26", "text": "好的。他們會"}, {"type": "subtitle", "time": 30210.31, "timestamp": "08:23:30", "text": "製作《求生之路3》嗎？"}, {"type": "subtitle", "time": 30212.15, "timestamp": "08:23:32", "text": "我覺得沒必要製作《"}, {"type": "subtitle", "time": 30213.99, "timestamp": "08:23:33", "text": "求生之路》。如果他們真的製作了《求生之路3》，"}, {"type": "subtitle", "time": 30216.628, "timestamp": "08:23:36", "text": "我想他們會"}, {"type": "subtitle", "time": 30219.75, "timestamp": "08:23:39", "text": "以"}, {"type": "subtitle", "time": 30221.91, "timestamp": "08:23:41", "text": "CEDA的視角來製作。你還記得嗎？ CEDA，對吧？就是"}]
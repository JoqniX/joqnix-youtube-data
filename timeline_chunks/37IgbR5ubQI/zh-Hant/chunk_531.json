[{"type": "subtitle", "time": 31865.27, "timestamp": "08:51:05", "text": "。那個"}, {"type": "subtitle", "time": 31868.948, "timestamp": "08:51:08", "text": "女巫要爆炸了。好了，我想要，我想要，你能給我一個嗎？你想要那個嗎？我想要，我"}, {"type": "subtitle", "time": 31907.28, "timestamp": "08:51:47", "text": "想要，我 想殺了那個女巫。我不在乎，夥計。過來。這個夠嗎？這個夠嗎？哦，等等"}]
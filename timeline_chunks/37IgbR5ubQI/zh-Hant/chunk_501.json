[{"type": "subtitle", "time": 30073.59, "timestamp": "08:21:13", "text": "讓我"}, {"type": "subtitle", "time": 30075.43, "timestamp": "08:21:15", "text": "結束這場直播。 Chug，你在幹嘛？你怎麼死了"}, {"type": "subtitle", "time": 30078.15, "timestamp": "08:21:18", "text": "？我被封禁了。"}, {"type": "subtitle", "time": 30084.468, "timestamp": "08:21:24", "text": "你被封鎖了，Billy。 Billy。"}, {"type": "subtitle", "time": 30087.03, "timestamp": "08:21:27", "text": "哦，Billy。 Billy。我的天哪。 Y。沒事"}, {"type": "subtitle", "time": 30096.31, "timestamp": "08:21:36", "text": "謝謝。那個該死的……那個該死的……那個"}, {"type": "subtitle", "time": 30100.388, "timestamp": "08:21:40", "text": "噴吐者去哪了"}, {"type": "subtitle", "time": 30107.35, "timestamp": "08:21:47", "text": "那是騎師。"}, {"type": "subtitle", "time": 30110.788, "timestamp": "08:21:50", "text": "是的，我是個騎師。來，關掉你的"}, {"type": "subtitle", "time": 30114.468, "timestamp": "08:21:54", "text": "手電筒。他們會看到我們的。"}]
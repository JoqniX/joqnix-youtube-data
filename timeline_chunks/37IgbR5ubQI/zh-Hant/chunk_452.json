[{"type": "subtitle", "time": 27132.07, "timestamp": "07:32:12", "text": "？謝天謝地。是啊，我"}, {"type": "subtitle", "time": 27142.708, "timestamp": "07:32:22", "text": "的 OBS 好像崩潰了。"}, {"type": "subtitle", "time": 27146.388, "timestamp": "07:32:26", "text": "哦，不。我的 OBS 崩潰了。希望我能恢復直播，繼續直播，"}, {"type": "subtitle", "time": 27149.83, "timestamp": "07:32:29", "text": "而不是重新開一個。"}, {"type": "subtitle", "time": 27155.27, "timestamp": "07:32:35", "text": "哦，他們都走了。沒關係。我想他們會在我們玩遊戲的時候加入我們。嗯，我想是這樣。是"}, {"type": "subtitle", "time": 27168.07, "timestamp": "07:32:48", "text": "啊，經典的直升機。直升機。它的操控性"}]
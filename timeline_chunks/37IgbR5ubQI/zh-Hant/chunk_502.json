[{"type": "subtitle", "time": 30122.03, "timestamp": "08:22:02", "text": "總之，我們你要是想要，我可以給你一個管狀炸彈"}, {"type": "subtitle", "time": 30125.11, "timestamp": "08:22:05", "text": "。鯊魚，你在幹嘛？我都要"}, {"type": "subtitle", "time": 30139.59, "timestamp": "08:22:19", "text": "我好像聽到女巫的聲音。"}, {"type": "subtitle", "time": 30152.788, "timestamp": "08:22:32", "text": "傑克，你為什麼在樓上？有人能"}, {"type": "subtitle", "time": 30154.788, "timestamp": "08:22:34", "text": "幫幫我嗎？"}, {"type": "subtitle", "time": 30156.468, "timestamp": "08:22:36", "text": "什麼？"}, {"type": "subtitle", "time": 30158.788, "timestamp": "08:22:38", "text": "我跳不下去。好吧，算了。算了。"}, {"type": "subtitle", "time": 30163.03, "timestamp": "08:22:43", "text": "哦，等等。騎師。我的天哪。"}, {"type": "subtitle", "time": 30166.67, "timestamp": "08:22:46", "text": "法蘭西斯，對不起，法蘭西斯。"}, {"type": "subtitle", "time": 30171.51, "timestamp": "08:22:51", "text": "弗朗西斯。好吧。我想，我想，比爾李。"}, {"type": "subtitle", "time": 30177.75, "timestamp": "08:22:57", "text": "我的天哪。見鬼，法蘭西斯，你個笨蛋。"}]
[{"type": "subtitle", "time": 29042.628, "timestamp": "08:04:02", "text": "我覺得你贏了。紅隊贏了。"}, {"type": "subtitle", "time": 29066.91, "timestamp": "08:04:26", "text": "[音樂] 我希望進入狀態時，有人剛剛殺死了你自己的隊友。"}, {"type": "subtitle", "time": 29069.67, "timestamp": "08:04:29", "text": "我的天啊。  其中一人殺了我。兄弟，為什麼會有兩首[音樂]？"}, {"type": "subtitle", "time": 29082.548, "timestamp": "08:04:42", "text": "我殺了那個新來的傢伙。你不想當隊友嗎？"}]
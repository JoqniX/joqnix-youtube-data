[{"type": "subtitle", "time": 29641.35, "timestamp": "08:14:01", "text": "你開"}, {"type": "subtitle", "time": 29649.35, "timestamp": "08:14:09", "text": "房間？他們可以開。好的。你想找人一起玩mod嗎？ mod？抱歉，不是mod。"}, {"type": "subtitle", "time": 29678.59, "timestamp": "08:14:38", "text": "我是說，你有沒有想好要一起玩遊戲的人？呃"}, {"type": "subtitle", "time": 29681.11, "timestamp": "08:14:41", "text": "，你是說"}, {"type": "subtitle", "time": 29683.75, "timestamp": "08:14:43", "text": "玩家？對，玩家。我們有玩家嗎？呃，很遺憾，"}, {"type": "subtitle", "time": 29685.51, "timestamp": "08:14:45", "text": "沒有。看來其他人都在玩別的遊戲"}, {"type": "subtitle", "time": 29691.788, "timestamp": "08:14:51", "text": "。哦，是的。沒關係。我們可以……我們可以……我們可以……關了。嗯。"}, {"type": "subtitle", "time": 29695.43, "timestamp": "08:14:55", "text": "想去"}, {"type": "subtitle", "time": 29698.31, "timestamp": "08:14:58", "text": "醫院嗎？好啊，當然。醫院。普通好友大廳。叮咚。啵啵。好的，運動健將。你可以加入。"}]
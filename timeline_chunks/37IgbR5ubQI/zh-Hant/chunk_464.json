[{"type": "subtitle", "time": 27845.11, "timestamp": "07:44:05", "text": "。哦，"}, {"type": "subtitle", "time": 27847.27, "timestamp": "07:44:07", "text": "不。算了。"}, {"type": "subtitle", "time": 27850.31, "timestamp": "07:44:10", "text": "我沒死，我想我沒死。查克，你為什麼跑？"}, {"type": "subtitle", "time": 27854.31, "timestamp": "07:44:14", "text": "我死了。我會跑的"}, {"type": "subtitle", "time": 27859.19, "timestamp": "07:44:19", "text": "，迪奧。哦，我的天。你什麼意思？你什麼意思？你得跑，迪奧？你說跑，對吧？那"}, {"type": "subtitle", "time": 27865.75, "timestamp": "07:44:25", "text": "你為什麼要飛？"}, {"type": "subtitle", "time": 27871.19, "timestamp": "07:44:31", "text": "哇。夥計們，我覺得我玩不轉這個遊戲了"}, {"type": "subtitle", "time": 27872.788, "timestamp": "07:44:32", "text": "。呃，我現在……我打到你了。別……好吧。呃，我死了。別擔心。"}, {"type": "subtitle", "time": 27897.99, "timestamp": "07:44:57", "text": "我得去搞個土製炸彈。走吧，兄弟。  哦"}]
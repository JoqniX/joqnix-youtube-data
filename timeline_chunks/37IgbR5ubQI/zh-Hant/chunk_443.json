[{"type": "subtitle", "time": 26587.35, "timestamp": "07:23:07", "text": "殺警察。我的天哪，那是……我的天哪，我殺了他。"}, {"type": "subtitle", "time": 26593.26, "timestamp": "07:23:13", "text": "喬克，別說那些話。別說那些話。天啊，別直播。耶穌基督。哦，對不起。我的天哪。"}, {"type": "subtitle", "time": 26605.11, "timestamp": "07:23:25", "text": "我也在直播。好的。是的。但是杰奎琳也在"}, {"type": "subtitle", "time": 26608.948, "timestamp": "07:23:28", "text": "那裡。是的。是的。除了我以外，其他都"}, {"type": "subtitle", "time": 26615.67, "timestamp": "07:23:35", "text": "適合全家觀賞"}, {"type": "subtitle", "time": 26617.35, "timestamp": "07:23:37", "text": "。敲別人的頭。我是說，呃，哎喲"}, {"type": "subtitle", "time": 26619.59, "timestamp": "07:23:39", "text": "。是的，他在敲別人的頭。沒事。你在開玩笑。他在"}, {"type": "subtitle", "time": 26630.708, "timestamp": "07:23:50", "text": "敲別人的頭，還把人打爆"}]
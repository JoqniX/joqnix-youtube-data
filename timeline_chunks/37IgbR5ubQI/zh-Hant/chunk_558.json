[{"type": "subtitle", "time": 33480.068, "timestamp": "09:18:00", "text": "哦，不。知道了。當然可以。  射手。  重新裝彈。  充電器。充電器。  拿這個。"}, {"type": "subtitle", "time": 33488.31, "timestamp": "09:18:08", "text": "我們趕緊把這東西拿出來。"}, {"type": "subtitle", "time": 33523.388, "timestamp": "09:18:43", "text": "我剛剛才意識到。  是的。我忘了開"}]
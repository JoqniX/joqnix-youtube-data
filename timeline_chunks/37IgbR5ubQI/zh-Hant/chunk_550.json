[{"type": "subtitle", "time": 33012.63, "timestamp": "09:10:12", "text": "，我對坦克沒造成什麼傷害。我確實殺了一個裝船兵。艾德，不是感染的特殊敵人"}, {"type": "subtitle", "time": 33027.35, "timestamp": "09:10:27", "text": "。嗯，哦，我把女巫"}, {"type": "subtitle", "time": 33033.35, "timestamp": "09:10:33", "text": "打得挺好的。我喜歡害羞。哇。現在你是近戰大師了，傑奎先生。傑奎先生，我想之後我要"}, {"type": "subtitle", "time": 33041.99, "timestamp": "09:10:41", "text": "結束直播了。"}, {"type": "subtitle", "time": 33049.268, "timestamp": "09:10:49", "text": "我太累了。走，走，走。天哪，我身上什麼都"}]
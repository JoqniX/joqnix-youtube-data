[{"type": "subtitle", "time": 27302.548, "timestamp": "07:35:02", "text": "我可以說我睡著了嗎？呃，你加入我們其中一個隊伍就行了。我的天啊。"}, {"type": "subtitle", "time": 27310.868, "timestamp": "07:35:10", "text": "你能加入我們嗎？看。我的天啊。那是什麼鬼東西？那就是他們說的"}, {"type": "subtitle", "time": 27319.27, "timestamp": "07:35:19", "text": "抓鉤。總之"}, {"type": "subtitle", "time": 27325.31, "timestamp": "07:35:25", "text": "，我打算"}, {"type": "subtitle", "time": 27342.31, "timestamp": "07:35:42", "text": "玩藍隊。藍隊。哦，你在隊伍裡嗎？呃，哦，是的。是的。走吧。有嗎？是的，我在。是時候揍你們兩個了。你是說，我的天啊。"}, {"type": "subtitle", "time": 27352.868, "timestamp": "07:35:52", "text": "我"}, {"type": "subtitle", "time": 27354.23, "timestamp": "07:35:54", "text": "想對Roco做點什麼。等一下。"}]
[{"type": "subtitle", "time": 33206.95, "timestamp": "09:13:26", "text": "我的"}, {"type": "subtitle", "time": 33209.112, "timestamp": "09:13:29", "text": "天。傑克"}, {"type": "subtitle", "time": 33211.388, "timestamp": "09:13:31", "text": "，怎麼樣？是那個該死的AI擋住你的路了嗎？好了，過來，兄弟。法蘭西斯，替我出去。我不知道為什麼我要下去。"}, {"type": "subtitle", "time": 33217.112, "timestamp": "09:13:37", "text": "好了，終於。我的"}, {"type": "subtitle", "time": 33223.19, "timestamp": "09:13:43", "text": "天。向側跳，好先生。我不知道該怎麼辦。我不知道該說什麼了"}, {"type": "subtitle", "time": 33230.15, "timestamp": "09:13:50", "text": "。嘿，夥計們，我想我們快到了。那是……"}, {"type": "subtitle", "time": 33233.428, "timestamp": "09:13:53", "text": "真有趣。我正在裝彈。"}]
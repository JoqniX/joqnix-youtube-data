[{"type": "subtitle", "time": 28200.868, "timestamp": "07:50:00", "text": "我喜歡和這個人互動的時候，我一轉身，我的天哪。這是哪裡？  順便問一下，傑克"}, {"type": "subtitle", "time": 28205.19, "timestamp": "07:50:05", "text": "是不是想"}, {"type": "subtitle", "time": 28208.708, "timestamp": "07:50:08", "text": "開槍打我？  哦"}, {"type": "subtitle", "time": 28210.31, "timestamp": "07:50:10", "text": "，原來有敵人。有敵人。哦，不。  當時在想什麼？我是誰？  嗯？  我也是你的敵人。你剛剛就做到了"}, {"type": "subtitle", "time": 28216.788, "timestamp": "07:50:16", "text": "。你忘了那件事。"}, {"type": "subtitle", "time": 28227.43, "timestamp": "07:50:27", "text": "我們用細繩。回來。去。還有其他人會試圖殺死我們。當心。  嗯，當然。雅克。我的天哪。  有四名玩家隨機加入。  我不知道他是誰。樓主讓我們贏了。我會輸。誰在乎？  啊"}, {"type": "subtitle", "time": 28243.27, "timestamp": "07:50:43", "text": "，我的天。哦，不。去死吧。  約翰，這並非針對"}]
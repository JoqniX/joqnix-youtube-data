[{"type": "subtitle", "time": 30852.868, "timestamp": "08:34:12", "text": "你在幹嘛？我在這兒。小心。哦，對不起。耶穌討厭哭泣。耶穌。 [音樂] 喔不。抓到他了。"}, {"type": "subtitle", "time": 30870.948, "timestamp": "08:34:30", "text": "搞定了。小心。我去拿這把"}, {"type": "subtitle", "time": 30872.948, "timestamp": "08:34:32", "text": "步槍。重新裝彈。小心。嗨"}, {"type": "subtitle", "time": 30892.468, "timestamp": "08:34:52", "text": "，夥計們。嗨。"}, {"type": "subtitle", "time": 30895.59, "timestamp": "08:34:55", "text": "你在射擊哪裡？我的天哪。"}]
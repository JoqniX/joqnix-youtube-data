[{"type": "subtitle", "time": 16561.869, "timestamp": "04:36:01", "text": "冷靜。身體受傷的感覺，為什麼我這麼不擅長參加派對？"}, {"type": "subtitle", "time": 16592.029, "timestamp": "04:36:32", "text": "我需要玩《黑暗靈魂》的上古卷軸版本嗎？早就料到了"}, {"type": "subtitle", "time": 16600.551, "timestamp": "04:36:40", "text": "。  停止行動。我的日子到了。  兄弟，兄弟，兄弟，現在你給"}]
[{"type": "subtitle", "time": 23040.75, "timestamp": "06:24:00", "text": "走吧。我的天哪，我的陰柔亞麻布勒得好"}, {"type": "subtitle", "time": 23043.43, "timestamp": "06:24:03", "text": "疼。哦對了，我忘了說我"}, {"type": "subtitle", "time": 23045.83, "timestamp": "06:24:05", "text": "還沒把她完全培養到滿級。就連那些頂尖"}, {"type": "subtitle", "time": 23049.03, "timestamp": "06:24:09", "text": "人才也無能為力，所以也無計可施"}, {"type": "subtitle", "time": 23051.75, "timestamp": "06:24:11", "text": "。  我只需要"}, {"type": "subtitle", "time": 23055.51, "timestamp": "06:24:15", "text": "解鎖boss，就"}]
[{"type": "subtitle", "time": 31215.51, "timestamp": "08:40:15", "text": "確定，兄弟。掩護裝彈。我在"}, {"type": "subtitle", "time": 31220.23, "timestamp": "08:40:20", "text": "裝彈。別擔心，我有一把迷你機關槍。好了，安全了。安全了。"}, {"type": "subtitle", "time": 31229.51, "timestamp": "08:40:29", "text": "是啊。等等。我得治療一下。搞定了那個"}, {"type": "subtitle", "time": 31233.59, "timestamp": "08:40:33", "text": "煙鬼。順便說一句，我幹掉了"}, {"type": "subtitle", "time": 31241.75, "timestamp": "08:40:41", "text": "，還有備用彈。超棒的武器。走吧，兄弟。傑克。哦"}]
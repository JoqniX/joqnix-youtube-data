[{"type": "subtitle", "time": 22.189, "timestamp": "00:00:22", "text": "H. 我還"}, {"type": "subtitle", "time": 25.83, "timestamp": "00:00:25", "text": "活著嗎？我還活著嗎？我還活著嗎？我還活著嗎？"}, {"type": "subtitle", "time": 28.429, "timestamp": "00:00:28", "text": "我還活著嗎？我相信我目前"}, {"type": "subtitle", "time": 31.069, "timestamp": "00:00:31", "text": "在線。好了，我想我已經上線了"}, {"type": "subtitle", "time": 35.75, "timestamp": "00:00:35", "text": "。大家好，歡迎各位。"}, {"type": "subtitle", "time": 40.15, "timestamp": "00:00:40", "text": "歡迎來到 Joathon 第 59 天，很抱歉"}, {"type": "subtitle", "time": 42.67, "timestamp": "00:00:42", "text": "直播開始得"}, {"type": "subtitle", "time": 45.83, "timestamp": "00:00:45", "text": "太晚了。呃，我這裡停電了。"}, {"type": "subtitle", "time": 48.549, "timestamp": "00:00:48", "text": "我發現昨天"}, {"type": "subtitle", "time": 51.95, "timestamp": "00:00:51", "text": "晚上直播不知何故在某個"}, {"type": "subtitle", "time": 55.47, "timestamp": "00:00:55", "text": "地方中斷了。我甚至不知道自己"}, {"type": "subtitle", "time": 58.63, "timestamp": "00:00:58", "text": "睡著了，直到我意識到溪流斷了，那"}]
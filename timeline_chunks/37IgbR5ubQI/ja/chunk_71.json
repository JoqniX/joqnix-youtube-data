[{"type": "subtitle", "time": 4260.79, "timestamp": "01:11:00", "text": "こちらはまだ早朝です。私が行きます。見る"}, {"type": "subtitle", "time": 4262.709, "timestamp": "01:11:02", "text": "あなた。死の夜に幸運を祈ります。私"}, {"type": "subtitle", "time": 4264.149, "timestamp": "01:11:04", "text": "何時になるかはわかりません。えっと、"}, {"type": "subtitle", "time": 4266.47, "timestamp": "01:11:06", "text": "午後です。いいえ、夕方です。"}, {"type": "subtitle", "time": 4269.03, "timestamp": "01:11:09", "text": "自分。まあ、お元気で。バイバイ。感謝"}, {"type": "subtitle", "time": 4272.63, "timestamp": "01:11:12", "text": "来てくれてありがとう。ありがとう。ありがとう。"}, {"type": "subtitle", "time": 4274.51, "timestamp": "01:11:14", "text": "すてきな一日を"}, {"type": "subtitle", "time": 4277.189, "timestamp": "01:11:17", "text": "先に。今はまだ早朝です。だから、寝る"}, {"type": "subtitle", "time": 4279.35, "timestamp": "01:11:19", "text": "良い。"}, {"type": "subtitle", "time": 4281.83, "timestamp": "01:11:21", "text": "いいえ、彼らはあなたが外出すると言いました。ええ、そうですね。"}, {"type": "subtitle", "time": 4285.91, "timestamp": "01:11:25", "text": "良い一日をお過ごしください。何てことだ。"}, {"type": "subtitle", "time": 4289.35, "timestamp": "01:11:29", "text": "うん。すてきな一日を。うん。あげてもいいですか"}, {"type": "subtitle", "time": 4291.27, "timestamp": "01:11:31", "text": "あなたも？ええ、もちろん、もちろんです。感じる"}, {"type": "subtitle", "time": 4293.59, "timestamp": "01:11:33", "text": "いくつかゲームをおすすめします。試してみましょう"}, {"type": "chat", "time": 4303.659, "timestamp": "01:11:43", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "joq"}, {"type": "chat", "time": 4310.401, "timestamp": "01:11:50", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "what's your favourite soda 🥤"}]
[{"type": "subtitle", "time": 28082.07, "timestamp": "07:48:02", "text": "このゲームでは炎上はしないよ。私"}, {"type": "subtitle", "time": 28098.708, "timestamp": "07:48:18", "text": "ウィックさん、一体何をしようとしているんですか？ミスターではありません。"}, {"type": "subtitle", "time": 28100.788, "timestamp": "07:48:20", "text": "ウィック、いや、ミスター。"}, {"type": "subtitle", "time": 28103.43, "timestamp": "07:48:23", "text": "私は「ああ、私は"}, {"type": "subtitle", "time": 28106.468, "timestamp": "07:48:26", "text": "何でも。私は文字通り撃ちました"}, {"type": "subtitle", "time": 28109.59, "timestamp": "07:48:29", "text": "文字通り誰かをぼんやりと見つめて"}, {"type": "subtitle", "time": 28112.548, "timestamp": "07:48:32", "text": "そこにいた。"}, {"type": "subtitle", "time": 28115.83, "timestamp": "07:48:35", "text": "あらら。私は死んだと思う。なんてこった。一度もない"}, {"type": "subtitle", "time": 28117.99, "timestamp": "07:48:37", "text": "心。私は死んでいないと思う。"}, {"type": "subtitle", "time": 28120.948, "timestamp": "07:48:40", "text": "チャック、なぜ逃げるんだ？私は死んだ。私はします"}, {"type": "subtitle", "time": 28123.43, "timestamp": "07:48:43", "text": "走れ、ディオ。"}, {"type": "subtitle", "time": 28124.948, "timestamp": "07:48:44", "text": "ああ、なんてことだ。どういう意味ですか？あなたは何を"}, {"type": "subtitle", "time": 28128.07, "timestamp": "07:48:48", "text": "つまり、ディオ、逃げなきゃいけないってことか？"}, {"type": "subtitle", "time": 28129.91, "timestamp": "07:48:49", "text": "走れって言ったよね？例えば、なぜ"}, {"type": "subtitle", "time": 28132.628, "timestamp": "07:48:52", "text": "でも飛行機で行くの？"}, {"type": "subtitle", "time": 28134.468, "timestamp": "07:48:54", "text": "おお。"}, {"type": "subtitle", "time": 28137.27, "timestamp": "07:48:57", "text": "みんな、私には何もできないと思う"}, {"type": "subtitle", "time": 28139.35, "timestamp": "07:48:59", "text": "このゲームで。"}]
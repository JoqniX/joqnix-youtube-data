[{"type": "subtitle", "time": 21065.11, "timestamp": "05:51:05", "text": "これ？まあ、大丈夫ですよ。えっと、ストリームPC、"}, {"type": "subtitle", "time": 21068.708, "timestamp": "05:51:08", "text": "今日死なないでくれ。"}, {"type": "subtitle", "time": 21072.27, "timestamp": "05:51:12", "text": "えっと、こんにちは。それでは、ゲームに移りましょう。"}, {"type": "subtitle", "time": 21076.59, "timestamp": "05:51:16", "text": "はい、少々お待ちください。私はもうすぐ"}, {"type": "subtitle", "time": 21078.67, "timestamp": "05:51:18", "text": "終わり。"}, {"type": "subtitle", "time": 21080.19, "timestamp": "05:51:20", "text": "えっと、"}, {"type": "subtitle", "time": 21083.708, "timestamp": "05:51:23", "text": "待って、待って。ビリー・ビリーの配信は終了したのですか？"}, {"type": "subtitle", "time": 21086.67, "timestamp": "05:51:26", "text": "え、死んだの？"}, {"type": "subtitle", "time": 21091.47, "timestamp": "05:51:31", "text": "待って、待って。私はビリー・ビリーで生放送中です。"}, {"type": "subtitle", "time": 21093.59, "timestamp": "05:51:33", "text": "右？待って、待って、待って、待って、待って、"}, {"type": "subtitle", "time": 21095.67, "timestamp": "05:51:35", "text": "待って。クラッシュしたと表示されています。クラッシュした"}, {"type": "subtitle", "time": 21098.99, "timestamp": "05:51:38", "text": "2回。始まった。はい、はい、"}, {"type": "subtitle", "time": 21101.31, "timestamp": "05:51:41", "text": "わかった。おお、"}, {"type": "subtitle", "time": 21104.548, "timestamp": "05:51:44", "text": "わかった。えっと、怖かったんです。私はこう思った。"}, {"type": "subtitle", "time": 21105.548, "timestamp": "05:51:45", "text": "待って、"}, {"type": "subtitle", "time": 21108.19, "timestamp": "05:51:48", "text": "何？いいえ"}, {"type": "subtitle", "time": 21113.548, "timestamp": "05:51:53", "text": "方法。待って、私の環境では読み込まれない。"}, {"type": "subtitle", "time": 21119.548, "timestamp": "05:51:59", "text": "何？何？"}]
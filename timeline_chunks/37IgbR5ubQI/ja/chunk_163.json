[{"type": "subtitle", "time": 9817.99, "timestamp": "02:43:37", "text": "賽は投げられた。悲惨な結末が待っている。もし私が死ぬなら"}, {"type": "subtitle", "time": 9819.95, "timestamp": "02:43:39", "text": "私は"}, {"type": "subtitle", "time": 9824.71, "timestamp": "02:43:44", "text": "これ。切り取ってください。常に準備万端でいよう。リクエストする"}, {"type": "subtitle", "time": 9827.51, "timestamp": "02:43:47", "text": "変調。"}, {"type": "subtitle", "time": 9835.269, "timestamp": "02:43:55", "text": "1つ。好きにやってみろ。"}]
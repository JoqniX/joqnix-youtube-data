[{"type": "subtitle", "time": 20823.708, "timestamp": "05:47:03", "text": "うん、このVを楽しんで。"}, {"type": "subtitle", "time": 20827.03, "timestamp": "05:47:07", "text": "カリフォルニアの曲をいくつか演奏したと思う。こんにちは、"}, {"type": "subtitle", "time": 20830.23, "timestamp": "05:47:10", "text": "行け。私は戻ってきます。えっと、私は食べます"}, {"type": "subtitle", "time": 20833.11, "timestamp": "05:47:13", "text": "夕食を食べて戻ってきます。楽しむ"}, {"type": "subtitle", "time": 20838.708, "timestamp": "05:47:18", "text": "V。了解。こんにちは、Cameo Dさん。ようこそ。"}, {"type": "subtitle", "time": 20841.19, "timestamp": "05:47:21", "text": "そして今日の配信は良いはずだった"}, {"type": "subtitle", "time": 20843.27, "timestamp": "05:47:23", "text": "夜。おやすみなさいとは言いません。バイバイ。私は"}, {"type": "subtitle", "time": 20846.39, "timestamp": "05:47:26", "text": "戻る。 Vを楽しんでください。私はそうではありませんでした。"}, {"type": "subtitle", "time": 20849.43, "timestamp": "05:47:29", "text": "波を流したかった。私はストリーミング配信だけ"}, {"type": "chat", "time": 20850.278, "timestamp": "05:47:30", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "gnight"}, {"type": "subtitle", "time": 20852.23, "timestamp": "05:47:32", "text": "ストリーミング配信の考えは"}, {"type": "subtitle", "time": 20854.628, "timestamp": "05:47:34", "text": "イベントが終わり、最後の配信をすると"}, {"type": "subtitle", "time": 20857.75, "timestamp": "05:47:37", "text": "私たちは一緒にイベントを行うと言いました"}, {"type": "subtitle", "time": 20861.03, "timestamp": "05:47:41", "text": "なくなる前に。いいえ。だから、そうですね。"}, {"type": "subtitle", "time": 20864.11, "timestamp": "05:47:44", "text": "本当はジャツをやりたかっただけ"}, {"type": "subtitle", "time": 20866.548, "timestamp": "05:47:46", "text": "チャット中。私はただ"}, {"type": "subtitle", "time": 20868.948, "timestamp": "05:47:48", "text": "チャットと"}, {"type": "subtitle", "time": 20871.27, "timestamp": "05:47:51", "text": "えっと、ちょっとおしゃべりしたかったんだけど"}, {"type": "subtitle", "time": 20876.548, "timestamp": "05:47:56", "text": "えっと、ちょっと変なのがあるんだけど"}, {"type": "subtitle", "time": 20879.51, "timestamp": "05:47:59", "text": "ゲーム名"}]
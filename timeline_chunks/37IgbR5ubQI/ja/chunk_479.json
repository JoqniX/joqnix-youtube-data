[{"type": "subtitle", "time": 28741.43, "timestamp": "07:59:01", "text": "なぜ彼らはあなたを拘束しているのですか？わからない、"}, {"type": "subtitle", "time": 28745.59, "timestamp": "07:59:05", "text": "男。誰が気にする？チームなんて誰が気にするんだ？私たちは"}, {"type": "subtitle", "time": 28759.67, "timestamp": "07:59:19", "text": "私は見た、私は見た、私は殺した。ごめん。私"}, {"type": "subtitle", "time": 28762.15, "timestamp": "07:59:22", "text": "指名手配"}, {"type": "subtitle", "time": 28764.628, "timestamp": "07:59:24", "text": "大丈夫だよ、ジャック。大丈夫。あなたはただ"}, {"type": "subtitle", "time": 28766.27, "timestamp": "07:59:26", "text": "勝ちたい"}]
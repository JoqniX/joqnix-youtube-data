[{"type": "subtitle", "time": 16147.79, "timestamp": "04:29:07", "text": "塩。くそっ"}, {"type": "subtitle", "time": 16149.95, "timestamp": "04:29:09", "text": "それ。"}, {"type": "subtitle", "time": 16154.91, "timestamp": "04:29:14", "text": "お願いします。いいえ、違います。それはああ"}, {"type": "subtitle", "time": 16158.55, "timestamp": "04:29:18", "text": "ああ、なんてことだ。何てことだ。私は"}, {"type": "subtitle", "time": 16161.469, "timestamp": "04:29:21", "text": "武器。"}, {"type": "subtitle", "time": 16168.91, "timestamp": "04:29:28", "text": "神。"}, {"type": "subtitle", "time": 16170.91, "timestamp": "04:29:30", "text": "おお"}, {"type": "subtitle", "time": 16174.07, "timestamp": "04:29:34", "text": "はい。私は"}, {"type": "subtitle", "time": 16176.55, "timestamp": "04:29:36", "text": "トレーニングの手助けが必要ですか、"}, {"type": "subtitle", "time": 16178.87, "timestamp": "04:29:38", "text": "健康を維持する。お気軽に"}, {"type": "subtitle", "time": 16181.149, "timestamp": "04:29:41", "text": "私のジムに来てください。彼だ。"}, {"type": "subtitle", "time": 16184.95, "timestamp": "04:29:44", "text": "やあ、兄弟。武器を手に入れました。"}, {"type": "subtitle", "time": 16186.51, "timestamp": "04:29:46", "text": "神。さあ"}, {"type": "subtitle", "time": 16190.55, "timestamp": "04:29:50", "text": "行く。私は世の中で最も完璧なテーマを手に入れた。もし"}, {"type": "subtitle", "time": 16196.349, "timestamp": "04:29:56", "text": "これならできる。私のチーム全員準備万端です。"}]
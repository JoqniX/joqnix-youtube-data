[{"type": "subtitle", "time": 25260.468, "timestamp": "07:01:00", "text": "あまりにも。他の人がそうしているかどうかはわかりません"}, {"type": "subtitle", "time": 25264.39, "timestamp": "07:01:04", "text": "参加しようとした。"}, {"type": "chat", "time": 25266.54, "timestamp": "07:01:06", "author": "@RyzexCh", "avatar": "https://yt4.ggpht.com/amK2Y62apvFDa_Drvh1DcQn8KTERvc2-tn67_8Tfb4CDDptav6v-n5VMsBR3U5XQAh1NLxsr1Q=s64-c-k-c0x00ffffff-no-rj", "message": "man xD"}, {"type": "subtitle", "time": 25267.628, "timestamp": "07:01:07", "text": "人々はいたが、皆忙しかったので私は"}, {"type": "subtitle", "time": 25270.03, "timestamp": "07:01:10", "text": "のように"}, {"type": "chat", "time": 25271.541, "timestamp": "07:01:11", "author": "@RyzexCh", "avatar": "https://yt4.ggpht.com/amK2Y62apvFDa_Drvh1DcQn8KTERvc2-tn67_8Tfb4CDDptav6v-n5VMsBR3U5XQAh1NLxsr1Q=s64-c-k-c0x00ffffff-no-rj", "message": "I will just wait for his msg"}, {"type": "subtitle", "time": 25272.75, "timestamp": "07:01:12", "text": "ドイオ、そして彼は"}, {"type": "subtitle", "time": 25276.39, "timestamp": "07:01:16", "text": "オフラインだけど、ええ、ロードリデンプション、えっと、私は"}, {"type": "subtitle", "time": 25278.11, "timestamp": "07:01:18", "text": "インストールする必要があるかもしれません"}, {"type": "subtitle", "time": 25289.99, "timestamp": "07:01:29", "text": "えっと、待って、もうインストール済みです。"}, {"type": "subtitle", "time": 25292.628, "timestamp": "07:01:32", "text": "一体どういうことだ 一体どういうことだ?何"}, {"type": "subtitle", "time": 25294.23, "timestamp": "07:01:34", "text": "一体どういうことだ？既にインストール済みです"}, {"type": "subtitle", "time": 25296.43, "timestamp": "07:01:36", "text": "昨日。"}, {"type": "subtitle", "time": 25299.19, "timestamp": "07:01:39", "text": "おお。これはもう、道路で擦りむいた傷だ。それは"}, {"type": "subtitle", "time": 25302.31, "timestamp": "07:01:42", "text": "もの。私が思ったのは、「ああ、それは"}, {"type": "subtitle", "time": 25304.11, "timestamp": "07:01:44", "text": "ロアシュ"}, {"type": "subtitle", "time": 25307.51, "timestamp": "07:01:47", "text": "時間だよ。「ロードラッシュをプレイしたのを覚えてるよ」"}, {"type": "subtitle", "time": 25310.868, "timestamp": "07:01:50", "text": "子供の頃はね。毎日目が覚めると"}, {"type": "subtitle", "time": 25314.39, "timestamp": "07:01:54", "text": "ボンを鳴らして、人を蹴り飛ばしたい"}, {"type": "subtitle", "time": 25315.548, "timestamp": "07:01:55", "text": "の"}, {"type": "subtitle", "time": 25319.07, "timestamp": "07:01:59", "text": "自転車。これは私が3歳だった時のことです"}]
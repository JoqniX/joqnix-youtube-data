[{"type": "subtitle", "time": 20301.628, "timestamp": "05:38:21", "text": "究極のスパム行為は狂気の沙汰だ。"}, {"type": "subtitle", "time": 20304.948, "timestamp": "05:38:24", "text": "来て。"}, {"type": "subtitle", "time": 20323.51, "timestamp": "05:38:43", "text": "私がこれに対処できるという事実"}, {"type": "subtitle", "time": 20327.51, "timestamp": "05:38:47", "text": "レベル120のキャラクターに大きなダメージを与える"}, {"type": "subtitle", "time": 20331.03, "timestamp": "05:38:51", "text": "レベル70、1レベル、2レベル"}, {"type": "subtitle", "time": 20333.59, "timestamp": "05:38:53", "text": "70年代で、レベル50のキャラクターが1人"}, {"type": "subtitle", "time": 20337.91, "timestamp": "05:38:57", "text": "非常識な。私たちは共に立ち上がる。"}]
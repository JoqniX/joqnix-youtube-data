[{"type": "subtitle", "time": 27788.868, "timestamp": "07:43:08", "text": "鍵。わかった。私は、私は、ああ、いや。それでも私は"}, {"type": "subtitle", "time": 27790.75, "timestamp": "07:43:10", "text": "炎がまだ来ない。何"}, {"type": "subtitle", "time": 27794.31, "timestamp": "07:43:14", "text": "変人？何か大きなものをレンダリングしているのでしょうか？"}, {"type": "subtitle", "time": 27797.75, "timestamp": "07:43:17", "text": "どうしたの？おお。えっと、そのまま入って"}, {"type": "subtitle", "time": 27799.91, "timestamp": "07:43:19", "text": "明らかな設定とプリセットの変更"}, {"type": "subtitle", "time": 27803.59, "timestamp": "07:43:23", "text": "３つくらいかな。"}, {"type": "subtitle", "time": 27805.67, "timestamp": "07:43:25", "text": "OBSのようなことはできないと思う"}, {"type": "subtitle", "time": 27808.788, "timestamp": "07:43:28", "text": "Mr. Jixをストリーミング配信している間は設定していますが、"}, {"type": "subtitle", "time": 27812.388, "timestamp": "07:43:32", "text": "うん、後でやるよ。"}, {"type": "subtitle", "time": 27815.67, "timestamp": "07:43:35", "text": "私は、えっと、ああ、私は自由ではありません。"}, {"type": "subtitle", "time": 27825.03, "timestamp": "07:43:45", "text": "皆さんは楽しんでいると言えるでしょう"}, {"type": "subtitle", "time": 27826.91, "timestamp": "07:43:46", "text": "ともかく。私は自由になりたい"}, {"type": "subtitle", "time": 27829.83, "timestamp": "07:43:49", "text": "今。ちなみに、私は荷物を降ろしているので、"}, {"type": "subtitle", "time": 27831.75, "timestamp": "07:43:51", "text": "大丈夫。"}, {"type": "subtitle", "time": 27834.15, "timestamp": "07:43:54", "text": "まあ、それでいいと思います。あ、待って。私 私"}]
[{"type": "subtitle", "time": 27246.07, "timestamp": "07:34:06", "text": "私は別の用事でそこへ行ったのですが"}, {"type": "subtitle", "time": 27248.11, "timestamp": "07:34:08", "text": "これを見て、"}, {"type": "subtitle", "time": 27251.11, "timestamp": "07:34:11", "text": "私が望むことは、ダンブルドアを手に入れることです"}, {"type": "subtitle", "time": 27254.15, "timestamp": "07:34:14", "text": "自転車関係のことを色々やってる。そうそう。誰も"}, {"type": "subtitle", "time": 27256.23, "timestamp": "07:34:16", "text": "誰か行くのかなと思った"}, {"type": "subtitle", "time": 27258.388, "timestamp": "07:34:18", "text": "2025年にこのようなゲームをプレイする"}, {"type": "subtitle", "time": 27265.51, "timestamp": "07:34:25", "text": "どういう意味ですか？終わった"}, {"type": "subtitle", "time": 27267.35, "timestamp": "07:34:27", "text": "ダウンロード？"}, {"type": "subtitle", "time": 27269.35, "timestamp": "07:34:29", "text": "うん。"}, {"type": "subtitle", "time": 27273.27, "timestamp": "07:34:33", "text": "ニース。私は準備ができています。チャマさん、出てきてください"}, {"type": "subtitle", "time": 27275.75, "timestamp": "07:34:35", "text": "の"}, {"type": "subtitle", "time": 27279.75, "timestamp": "07:34:39", "text": "ロビー。新しいロビーを作成する必要があります。"}, {"type": "subtitle", "time": 27282.788, "timestamp": "07:34:42", "text": "このガキを殺させてくれ。つまり、私に"}, {"type": "subtitle", "time": 27287.27, "timestamp": "07:34:47", "text": "このガキをポンで叩け。おお。私たちはただセックスしているだけです"}, {"type": "subtitle", "time": 27289.67, "timestamp": "07:34:49", "text": "私たちがここで待っている間に、人々は。わかった。"}, {"type": "subtitle", "time": 27291.91, "timestamp": "07:34:51", "text": "待って。おお。信じられない。私にさせて"}, {"type": "subtitle", "time": 27294.07, "timestamp": "07:34:54", "text": "私も信じられない。私はできません"}, {"type": "subtitle", "time": 27297.35, "timestamp": "07:34:57", "text": "信じられない。何てことだ。わかった。"}, {"type": "subtitle", "time": 27299.31, "timestamp": "07:34:59", "text": "わかった。待って。えっと"}]
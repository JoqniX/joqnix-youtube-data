[{"type": "subtitle", "time": 26640.868, "timestamp": "07:24:00", "text": "いいえ。ああ、f。あ、待って。あなたは持っていません"}, {"type": "subtitle", "time": 26643.27, "timestamp": "07:24:03", "text": "ゲーム。ああ、くそ。つまり、私はそれを持っている、"}, {"type": "subtitle", "time": 26651.59, "timestamp": "07:24:11", "text": "これはどうでしょう？えっと、ダウンロードはしていません"}, {"type": "subtitle", "time": 26654.788, "timestamp": "07:24:14", "text": "別のゲーム。いや、冗談だろ。そうではありません"}, {"type": "subtitle", "time": 26656.948, "timestamp": "07:24:16", "text": "重厚なゲーム。 7ギガか"}, {"type": "subtitle", "time": 26659.83, "timestamp": "07:24:19", "text": "何か。君ならできるよ。私は"}, {"type": "subtitle", "time": 26662.31, "timestamp": "07:24:22", "text": "今は120GBですが、"}, {"type": "subtitle", "time": 26664.23, "timestamp": "07:24:24", "text": "編集。"}, {"type": "subtitle", "time": 26667.91, "timestamp": "07:24:27", "text": "待って、私は参加できない。待っていただけますか？"}, {"type": "subtitle", "time": 26670.23, "timestamp": "07:24:30", "text": "私は新しいものを作ります"}, {"type": "subtitle", "time": 26671.83, "timestamp": "07:24:31", "text": "1つ。"}, {"type": "subtitle", "time": 26680.11, "timestamp": "07:24:40", "text": "Zomboidはお持ちですか？"}, {"type": "subtitle", "time": 26684.23, "timestamp": "07:24:44", "text": "いいえ。買おうと思っていたのですが、"}, {"type": "subtitle", "time": 26686.708, "timestamp": "07:24:46", "text": "最後は「いや、いらない」って感じだった"}, {"type": "subtitle", "time": 26689.35, "timestamp": "07:24:49", "text": "に。したくないってどういう意味ですか？"}, {"type": "subtitle", "time": 26691.75, "timestamp": "07:24:51", "text": "本当に素晴らしいゲームです。それはまるで"}, {"type": "subtitle", "time": 26694.31, "timestamp": "07:24:54", "text": "リアリズムの引用句は愚かな"}, {"type": "subtitle", "time": 26697.99, "timestamp": "07:24:57", "text": "リアリズムゲームのようなもの。そうですね、可能性はあります"}, {"type": "subtitle", "time": 26699.99, "timestamp": "07:24:59", "text": "面倒くさいけど、すごく楽しい。まるで"}]
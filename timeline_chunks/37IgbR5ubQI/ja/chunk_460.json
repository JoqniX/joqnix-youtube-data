[{"type": "subtitle", "time": 27613.51, "timestamp": "07:40:13", "text": "ああ、なんてことだ。一体何が変人だったのか"}, {"type": "subtitle", "time": 27616.15, "timestamp": "07:40:16", "text": "それ？"}, {"type": "subtitle", "time": 27618.51, "timestamp": "07:40:18", "text": "それは彼らが言うところの"}, {"type": "subtitle", "time": 27626.07, "timestamp": "07:40:26", "text": "とにかく、私は青でプレイするつもりです"}, {"type": "subtitle", "time": 27627.59, "timestamp": "07:40:27", "text": "チーム。"}, {"type": "subtitle", "time": 27629.03, "timestamp": "07:40:29", "text": "ブルーチーム。ああ、あなたはチームの一員ですか？"}, {"type": "subtitle", "time": 27632.468, "timestamp": "07:40:32", "text": "けれど？ああ、そうですね。はい。さあ行こう。"}, {"type": "subtitle", "time": 27636.15, "timestamp": "07:40:36", "text": "はい、います。両方を鳴らす時間です"}, {"type": "subtitle", "time": 27639.27, "timestamp": "07:40:39", "text": "あなたについて。"}, {"type": "subtitle", "time": 27643.03, "timestamp": "07:40:43", "text": "「ああ、なんてことだ」って感じ？"}, {"type": "subtitle", "time": 27646.948, "timestamp": "07:40:46", "text": "ロコに何かしてあげたい。 1つ"}, {"type": "subtitle", "time": 27657.468, "timestamp": "07:40:57", "text": "終了した。痛い。フリック。私"}]
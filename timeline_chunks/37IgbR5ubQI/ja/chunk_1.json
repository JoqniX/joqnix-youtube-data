[{"type": "subtitle", "time": 61.59, "timestamp": "00:01:01", "text": "そしてそれは痛みだった。"}, {"type": "subtitle", "time": 64.95, "timestamp": "00:01:04", "text": "だから、私はあなたにできなかった、それは"}, {"type": "subtitle", "time": 67.31, "timestamp": "00:01:07", "text": "だからストリームは5なんだ"}, {"type": "chat", "time": 68.464, "timestamp": "00:01:08", "author": "@ArusuAraeru", "avatar": "https://yt4.ggpht.com/Dc2GWSBeOIoWoV_Yu1KJZ8Rd0EIvVX2NE8TZKOPigrbOXUH6MSPklyA0oUxTSJrKKkxsV3rdQA=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/egJ1XufTKYfegwOo57ewAg"}, {"type": "subtitle", "time": 70.469, "timestamp": "00:01:10", "text": "時間。今日はいくつか物を手に入れました。 1つ"}, {"type": "chat", "time": 70.772, "timestamp": "00:01:10", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Arusu~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 74.23, "timestamp": "00:01:14", "text": "次に、私のモデルを接続します。ええと、今日"}, {"type": "subtitle", "time": 76.469, "timestamp": "00:01:16", "text": "いくつか手に入れました。私たちは"}, {"type": "subtitle", "time": 78.71000000000001, "timestamp": "00:01:18", "text": "ここからいくつかのコラボレーション"}, {"type": "subtitle", "time": 80.23, "timestamp": "00:01:20", "text": "以降"}, {"type": "subtitle", "time": 84.71000000000001, "timestamp": "00:01:24", "text": "ええと、最近は。ええと、私はそうしないことに決めました"}, {"type": "subtitle", "time": 88.23, "timestamp": "00:01:28", "text": "休暇を取りたかったから"}, {"type": "subtitle", "time": 90.71000000000001, "timestamp": "00:01:30", "text": "これらのコラボレーションを完了させて、すべてを完了させる"}, {"type": "subtitle", "time": 94.95, "timestamp": "00:01:34", "text": "だって、あの、あの、私は"}, {"type": "subtitle", "time": 97.429, "timestamp": "00:01:37", "text": "今から出発します。えーと、それら全部に加えて"}, {"type": "subtitle", "time": 101.10900000000001, "timestamp": "00:01:41", "text": "6月を、えっと、"}, {"type": "subtitle", "time": 103.19, "timestamp": "00:01:43", "text": "または3日間の休暇を取るか"}, {"type": "subtitle", "time": 105.59, "timestamp": "00:01:45", "text": "家族と会うのが好きなもの"}, {"type": "subtitle", "time": 108.22999999999999, "timestamp": "00:01:48", "text": "日帰り旅行とかそういうの"}, {"type": "subtitle", "time": 110.31, "timestamp": "00:01:50", "text": "戻ってきて、とか、そんな感じのメッセージ。しかし"}, {"type": "subtitle", "time": 112.469, "timestamp": "00:01:52", "text": "ええ、満員ですよ。私は"}, {"type": "subtitle", "time": 114.95, "timestamp": "00:01:54", "text": "多くの人に連絡を取って、"}, {"type": "subtitle", "time": 117.50999999999999, "timestamp": "00:01:57", "text": "スケジュールを組んだり、その他諸々"}, {"type": "subtitle", "time": 119.28, "timestamp": "00:01:59", "text": "パックファクトパックファクトパックファクトパックファクト 事実を詰めたが、まあ、今日は"}]
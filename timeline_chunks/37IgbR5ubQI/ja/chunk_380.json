[{"type": "subtitle", "time": 22805.39, "timestamp": "06:20:05", "text": "似ているように見えるね。"}, {"type": "subtitle", "time": 22807.788, "timestamp": "06:20:07", "text": "[音楽]"}, {"type": "subtitle", "time": 22839.19, "timestamp": "06:20:39", "text": "なぜヤは心配しているの？まるで誰かが"}, {"type": "subtitle", "time": 22841.948, "timestamp": "06:20:41", "text": "彼女を見ている"}, {"type": "subtitle", "time": 22852.27, "timestamp": "06:20:52", "text": "サス。わかった。えっと、ちょっと待ってください。"}, {"type": "subtitle", "time": 22854.67, "timestamp": "06:20:54", "text": "ええと、私は"}]
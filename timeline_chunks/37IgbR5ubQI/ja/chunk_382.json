[{"type": "subtitle", "time": 22926.19, "timestamp": "06:22:06", "text": "[音楽]"}, {"type": "subtitle", "time": 22929.99, "timestamp": "06:22:09", "text": "2番。私は大丈夫だと思います。私が直します"}, {"type": "subtitle", "time": 22938.27, "timestamp": "06:22:18", "text": "[音楽]"}, {"type": "subtitle", "time": 22941.57, "timestamp": "06:22:21", "text": "シェールアップ。ブレイクを処刑せよ"}, {"type": "subtitle", "time": 22942.91, "timestamp": "06:22:22", "text": "[音楽]"}, {"type": "subtitle", "time": 22944.86, "timestamp": "06:22:24", "text": "咲く。おお。"}, {"type": "subtitle", "time": 22947.51, "timestamp": "06:22:27", "text": "[音楽]"}, {"type": "subtitle", "time": 22949.67, "timestamp": "06:22:29", "text": "共鳴能力。ああ、"}, {"type": "subtitle", "time": 22959.628, "timestamp": "06:22:39", "text": "もの？そこには"}, {"type": "subtitle", "time": 22966.67, "timestamp": "06:22:46", "text": "もっと。ヴェリナ対"}, {"type": "subtitle", "time": 22970.51, "timestamp": "06:22:50", "text": "ヴィナ。わかった。ヤナはなぜ？彼女は何者？"}, {"type": "subtitle", "time": 22978.59, "timestamp": "06:22:58", "text": "気づきましたか？"}]
[{"type": "subtitle", "time": 2460.15, "timestamp": "00:41:00", "text": "右？いや、いや、いや。なぜまだ"}, {"type": "subtitle", "time": 2463.79, "timestamp": "00:41:03", "text": "私を押しているの？ああ、"}, {"type": "subtitle", "time": 2474.15, "timestamp": "00:41:14", "text": "これ。まるで、一度私を撃ったかのようだ。教会の座席"}, {"type": "subtitle", "time": 2492.069, "timestamp": "00:41:32", "text": "後ろ向きに。ほら、ほら、ほら、ほら。私はまだ"}]
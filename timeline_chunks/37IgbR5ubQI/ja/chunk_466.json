[{"type": "subtitle", "time": 27972.788, "timestamp": "07:46:12", "text": "彼は出発した。"}, {"type": "subtitle", "time": 27976.75, "timestamp": "07:46:16", "text": "このゲームは高フレームレートでプレイできますか？"}, {"type": "subtitle", "time": 27981.03, "timestamp": "07:46:21", "text": "いいえ。もっと下げるべきです。"}, {"type": "subtitle", "time": 27984.468, "timestamp": "07:46:24", "text": "はい、どうぞ。わかった。それほどラグがない"}, {"type": "subtitle", "time": 27991.23, "timestamp": "07:46:31", "text": "私は下げるべきだ"}, {"type": "subtitle", "time": 27994.948, "timestamp": "07:46:34", "text": "究極の元カレのためのすべて、えー、えー、えー、何"}, {"type": "subtitle", "time": 27996.83, "timestamp": "07:46:36", "text": "あなたはそれを何と呼びますか？のために"}, {"type": "subtitle", "time": 28000.788, "timestamp": "07:46:40", "text": "究極のFPSのための究極の。"}, {"type": "subtitle", "time": 28003.03, "timestamp": "07:46:43", "text": "誰も私を殺す必要はない。私はただ死ぬだけだ"}, {"type": "subtitle", "time": 28012.15, "timestamp": "07:46:52", "text": "チャック、こっちへ来なさい。チャック、こっちへ来い。"}]
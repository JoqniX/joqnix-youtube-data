[{"type": "subtitle", "time": 17160.31, "timestamp": "04:46:00", "text": "悲惨。彼を捕まえろ。"}, {"type": "subtitle", "time": 17179.07, "timestamp": "04:46:19", "text": "え、何？それは"}, {"type": "subtitle", "time": 17190.628, "timestamp": "04:46:30", "text": "ああ、もう十分だ。たくさん手に入れました。"}, {"type": "subtitle", "time": 17194.03, "timestamp": "04:46:34", "text": "私は2倍の額を受け取った。"}, {"type": "subtitle", "time": 17208.39, "timestamp": "04:46:48", "text": "ダブル。わかった。これでアップグレードできます"}, {"type": "subtitle", "time": 17212.93, "timestamp": "04:46:52", "text": "武器。私はあなたのお手伝いができます"}]
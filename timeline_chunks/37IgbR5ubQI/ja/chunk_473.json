[{"type": "subtitle", "time": 28380.07, "timestamp": "07:53:00", "text": "私もまた、あなたの敵です。あなたはまさに今、それを実行しました。あなた"}, {"type": "subtitle", "time": 28390.628, "timestamp": "07:53:10", "text": "私たちは細い紐を使います。戻ってくる。行く。そこには"}, {"type": "subtitle", "time": 28392.788, "timestamp": "07:53:12", "text": "他の人たちは"}, {"type": "subtitle", "time": 28396.07, "timestamp": "07:53:16", "text": "我々を殺せ。気をつけて。"}, {"type": "subtitle", "time": 28399.75, "timestamp": "07:53:19", "text": "ええ、もちろんです。ジャック。ああ、神様。"}, {"type": "subtitle", "time": 28401.75, "timestamp": "07:53:21", "text": "4人のプレイヤーが参加しました"}, {"type": "subtitle", "time": 28403.51, "timestamp": "07:53:23", "text": "ランダム。"}, {"type": "subtitle", "time": 28405.948, "timestamp": "07:53:25", "text": "私はそれが誰なのか知りません。 OPは私たちに"}, {"type": "subtitle", "time": 28419.868, "timestamp": "07:53:39", "text": "私はイエス・キリストだ。おお、"}, {"type": "subtitle", "time": 28432.708, "timestamp": "07:53:52", "text": "ジョン、個人的なことじゃないよ。ただ"}, {"type": "subtitle", "time": 28435.75, "timestamp": "07:53:55", "text": "どちらかがあなたを殴る。"}]
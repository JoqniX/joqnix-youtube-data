[{"type": "subtitle", "time": 1382.23, "timestamp": "00:23:02", "text": "在庫。開発者はこう考えているのでしょうか。"}, {"type": "subtitle", "time": 1384.07, "timestamp": "00:23:04", "text": "「ええ、ゲームは実行されていませんが、"}, {"type": "subtitle", "time": 1386.549, "timestamp": "00:23:06", "text": "すべてのアイテムを無料で入手できます。それを持っていく"}, {"type": "subtitle", "time": 1394.27, "timestamp": "00:23:14", "text": "[音楽]"}, {"type": "subtitle", "time": 1396.75, "timestamp": "00:23:16", "text": "うん。で"}, {"type": "subtitle", "time": 1399.51, "timestamp": "00:23:19", "text": "ピュー。わかった。 2秒後にダウンロードされます"}]
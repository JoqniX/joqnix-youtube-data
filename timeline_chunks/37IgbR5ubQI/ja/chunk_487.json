[{"type": "subtitle", "time": 29221.628, "timestamp": "08:07:01", "text": "誰かがあなたの"}, {"type": "subtitle", "time": 29225.19, "timestamp": "08:07:05", "text": "チームメイト。何てことだ。"}, {"type": "subtitle", "time": 29232.83, "timestamp": "08:07:12", "text": "なぜ"}, {"type": "subtitle", "time": 29234.75, "timestamp": "08:07:14", "text": "二"}, {"type": "subtitle", "time": 29244.43, "timestamp": "08:07:24", "text": "行く？私はそれを殺した"}, {"type": "subtitle", "time": 29247.91, "timestamp": "08:07:27", "text": "新人。チームメイトはいらないの？"}, {"type": "subtitle", "time": 29251.83, "timestamp": "08:07:31", "text": "いや、いや、いや。あなたのチームメイトは赤です。ああ、わかりました。"}]
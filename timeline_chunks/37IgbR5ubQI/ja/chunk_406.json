[{"type": "subtitle", "time": 24363.948, "timestamp": "06:46:03", "text": "ふむ。私は情報ブローカーです。"}, {"type": "subtitle", "time": 24366.868, "timestamp": "06:46:06", "text": "わかった。私は死後から取引をしています。"}, {"type": "subtitle", "time": 24368.468, "timestamp": "06:46:08", "text": "情報が必要ですか？与えなければならない"}, {"type": "subtitle", "time": 24381.35, "timestamp": "06:46:21", "text": "彼らはただ私たちと取引をしたいだけなのです。私"}, {"type": "subtitle", "time": 24394.788, "timestamp": "06:46:34", "text": "あ、待って。共鳴ビーコン。それは"}, {"type": "subtitle", "time": 24397.51, "timestamp": "06:46:37", "text": "今は像の塔になっているの？なぜストレスを感じる必要があるのか"}, {"type": "subtitle", "time": 24410.468, "timestamp": "06:46:50", "text": "ええと、私はあんこから目が離せないんです。"}, {"type": "subtitle", "time": 24413.868, "timestamp": "06:46:53", "text": "彼女はとても素敵でかっこいい。そして"}, {"type": "subtitle", "time": 24418.59, "timestamp": "06:46:58", "text": "カワイイ、彼女の動きはどれも"}]
[{"type": "subtitle", "time": 27361.11, "timestamp": "07:36:01", "text": "このゲームの動画は1本のみです。"}, {"type": "subtitle", "time": 27364.628, "timestamp": "07:36:04", "text": "ああ、わかりました。うん。"}, {"type": "subtitle", "time": 27367.83, "timestamp": "07:36:07", "text": "わかった。わかった。私は行くつもりです 私は行くつもりです"}, {"type": "subtitle", "time": 27368.91, "timestamp": "07:36:08", "text": "と"}, {"type": "subtitle", "time": 27372.31, "timestamp": "07:36:12", "text": "音楽のことはもうやめよう。私"}, {"type": "subtitle", "time": 27374.548, "timestamp": "07:36:14", "text": "これらが含まれるでしょう。私は対処したくない"}, {"type": "subtitle", "time": 27376.948, "timestamp": "07:36:16", "text": "音楽と共に。ああ、下げてもいいですよ。"}, {"type": "subtitle", "time": 27379.99, "timestamp": "07:36:19", "text": "ええ、実際にはもっと下げた方がいいですよ。"}, {"type": "subtitle", "time": 27391.99, "timestamp": "07:36:31", "text": "参加する。フルモードではありません。"}, {"type": "subtitle", "time": 27395.59, "timestamp": "07:36:35", "text": "最高の武器を手に入れたい。"}, {"type": "subtitle", "time": 27397.628, "timestamp": "07:36:37", "text": "最高の武器。レベル"}, {"type": "subtitle", "time": 27400.948, "timestamp": "07:36:40", "text": "14. 最強の武器は何ですか？"}, {"type": "subtitle", "time": 27402.868, "timestamp": "07:36:42", "text": "待ってください、オーさん。あなたは"}, {"type": "subtitle", "time": 27405.03, "timestamp": "07:36:45", "text": "招待状ですよね？"}, {"type": "subtitle", "time": 27407.83, "timestamp": "07:36:47", "text": "待って、待って。ちょっと待ってください。私にさせて"}, {"type": "subtitle", "time": 27409.99, "timestamp": "07:36:49", "text": "設定などを調整するなど。"}, {"type": "subtitle", "time": 27412.75, "timestamp": "07:36:52", "text": "OBSで録画してみましょう。"}, {"type": "subtitle", "time": 27416.31, "timestamp": "07:36:56", "text": "あまりにも。ああ、なんてことだ。私のOBSがクラッシュしたの？"}]
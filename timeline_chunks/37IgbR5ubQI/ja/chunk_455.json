[{"type": "subtitle", "time": 27302.548, "timestamp": "07:35:02", "text": "オンライン３。待って。どうすれば参加できますか？"}, {"type": "subtitle", "time": 27304.868, "timestamp": "07:35:04", "text": "また？"}, {"type": "subtitle", "time": 27308.388, "timestamp": "07:35:08", "text": "あなたを招待してみましょう。わかった。"}, {"type": "subtitle", "time": 27310.868, "timestamp": "07:35:10", "text": "あなたがゲームに参加できるかどうか確認してみます。もし"}, {"type": "subtitle", "time": 27319.27, "timestamp": "07:35:19", "text": "おお。私の方では開かないんです。私"}, {"type": "subtitle", "time": 27321.15, "timestamp": "07:35:21", "text": "わからない"}, {"type": "subtitle", "time": 27325.31, "timestamp": "07:35:25", "text": "なぜ。おお。おお。ああ、ここにあるよ、"}, {"type": "subtitle", "time": 27328.628, "timestamp": "07:35:28", "text": "みんな。私は思う。なんてこった。"}, {"type": "subtitle", "time": 27330.948, "timestamp": "07:35:30", "text": "あ、そこの君。"}, {"type": "subtitle", "time": 27333.91, "timestamp": "07:35:33", "text": "ちょっと待ってください。"}, {"type": "subtitle", "time": 27336.23, "timestamp": "07:35:36", "text": "ああ、ジョンがここにいる。ニース。おお、いいね、いいね、"}, {"type": "subtitle", "time": 27340.468, "timestamp": "07:35:40", "text": "いいね、いいね。ああ、あのチームと同じですね。おお、"}, {"type": "subtitle", "time": 27342.31, "timestamp": "07:35:42", "text": "うん。あまりプレイする人がいないみたい"}, {"type": "subtitle", "time": 27345.91, "timestamp": "07:35:45", "text": "このゲームだから、もちろん。"}, {"type": "subtitle", "time": 27348.548, "timestamp": "07:35:48", "text": "ああ、ビデオのモンタージュがある"}, {"type": "subtitle", "time": 27351.03, "timestamp": "07:35:51", "text": "推薦する。一体何なんだ？待って、それは"}, {"type": "subtitle", "time": 27352.868, "timestamp": "07:35:52", "text": "免責事項。それは免責事項でした。私"}, {"type": "subtitle", "time": 27354.23, "timestamp": "07:35:54", "text": "その免責事項をもう一度見たい。何"}, {"type": "subtitle", "time": 27356.548, "timestamp": "07:35:56", "text": "あの変人？いいえ、ただこう言っているだけです"}, {"type": "subtitle", "time": 27358.468, "timestamp": "07:35:58", "text": "そう、あらゆるものを収益化できる"}]
[{"type": "subtitle", "time": 22.189, "timestamp": "00:00:22", "text": "H. 私は"}, {"type": "subtitle", "time": 25.83, "timestamp": "00:00:25", "text": "ライブ？私は生きているのか？私は生放送中ですか？私は生放送中ですか？"}, {"type": "subtitle", "time": 28.429, "timestamp": "00:00:28", "text": "私は生放送中ですか？私はそう信じています"}, {"type": "subtitle", "time": 31.069, "timestamp": "00:00:31", "text": "ライブ。はい、私は"}, {"type": "subtitle", "time": 35.75, "timestamp": "00:00:35", "text": "ライブ。皆さん、こんにちは。ようこそお越しくださいました。"}, {"type": "subtitle", "time": 40.15, "timestamp": "00:00:40", "text": "ジョアトン59日目へようこそ、そしてごめんなさい"}, {"type": "subtitle", "time": 42.67, "timestamp": "00:00:42", "text": "ストリームを開始するにはスーパー"}, {"type": "subtitle", "time": 45.83, "timestamp": "00:00:45", "text": "遅い。えっと、停電があって"}, {"type": "subtitle", "time": 48.549, "timestamp": "00:00:48", "text": "すべて。昨日気づいた"}, {"type": "subtitle", "time": 51.95, "timestamp": "00:00:51", "text": "一晩中配信が何らかの形で終了した"}, {"type": "subtitle", "time": 55.47, "timestamp": "00:00:55", "text": "どこかで。私は自分が"}, {"type": "subtitle", "time": 58.63, "timestamp": "00:00:58", "text": "眠って、ストリームが終わったことに気づいた"}]
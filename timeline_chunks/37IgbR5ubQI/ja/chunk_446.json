[{"type": "subtitle", "time": 26763.03, "timestamp": "07:26:03", "text": "えっ？このゲーム、変だ。"}, {"type": "subtitle", "time": 26766.708, "timestamp": "07:26:06", "text": "奇妙なゲームだ。はい、それは"}, {"type": "subtitle", "time": 26768.628, "timestamp": "07:26:08", "text": "ちょっとばかげてる。わかった。わかった。待って、"}, {"type": "subtitle", "time": 26771.03, "timestamp": "07:26:11", "text": "待って、待って。わかった、"}, {"type": "subtitle", "time": 26772.708, "timestamp": "07:26:12", "text": "分。"}, {"type": "subtitle", "time": 26775.59, "timestamp": "07:26:15", "text": "自分が何をすべきか、分かっていると思う。"}, {"type": "subtitle", "time": 26779.91, "timestamp": "07:26:19", "text": "わかった。音楽が強すぎる。うん。うん。"}, {"type": "subtitle", "time": 26782.39, "timestamp": "07:26:22", "text": "音楽の音量も下げてください。"}, {"type": "subtitle", "time": 26788.948, "timestamp": "07:26:28", "text": "わかった。さあ、あなたも私と一緒に参加してもいいと思いますよ。試す"}, {"type": "subtitle", "time": 26793.35, "timestamp": "07:26:33", "text": "私と一緒に来てください。わかった。"}, {"type": "subtitle", "time": 26796.788, "timestamp": "07:26:36", "text": "いやあ、君たち楽しそうだね。いいえ、私たちは"}, {"type": "subtitle", "time": 26798.788, "timestamp": "07:26:38", "text": "ない。"}, {"type": "subtitle", "time": 26801.03, "timestamp": "07:26:41", "text": "わかった。参加しようとしています。君たちは"}, {"type": "subtitle", "time": 26803.75, "timestamp": "07:26:43", "text": "とても楽しい。"}, {"type": "subtitle", "time": 26807.59, "timestamp": "07:26:47", "text": "「参加」をクリックしました。何も起こっていない。"}, {"type": "subtitle", "time": 26809.03, "timestamp": "07:26:49", "text": "君たちが楽しんでいるなんて信じられないよ。"}, {"type": "subtitle", "time": 26812.708, "timestamp": "07:26:52", "text": "ところで、どうやって参加するんですか？えっと、"}, {"type": "subtitle", "time": 26814.788, "timestamp": "07:26:54", "text": "Steamから。"}, {"type": "subtitle", "time": 26817.35, "timestamp": "07:26:57", "text": "私の配信プロフィールにアクセスしてください。いいね。うん。"}, {"type": "subtitle", "time": 26819.59, "timestamp": "07:26:59", "text": "ゲームに参加する"}]
[{"type": "subtitle", "time": 27061.11, "timestamp": "07:31:01", "text": "それだと腰痛になるよ。これは"}, {"type": "subtitle", "time": 27062.628, "timestamp": "07:31:02", "text": "背中の痛みも引き起こすだろう、"}, {"type": "subtitle", "time": 27065.03, "timestamp": "07:31:05", "text": "嘘をつくつもりだけど、アップグレードするかもしれない"}, {"type": "subtitle", "time": 27068.388, "timestamp": "07:31:08", "text": "いつか私の椅子が。ということで、"}, {"type": "subtitle", "time": 27070.67, "timestamp": "07:31:10", "text": "仮定する。はい。"}, {"type": "subtitle", "time": 27074.388, "timestamp": "07:31:14", "text": "では、私がいくらお金を使ったか当ててみてください"}, {"type": "subtitle", "time": 27077.99, "timestamp": "07:31:17", "text": "このテーブルにいくら使いますか？テーブルの上に1,000。"}, {"type": "subtitle", "time": 27080.07, "timestamp": "07:31:20", "text": "えっと、"}, {"type": "subtitle", "time": 27081.75, "timestamp": "07:31:21", "text": "これからいくつか寸法をお伝えします。"}, {"type": "subtitle", "time": 27083.83, "timestamp": "07:31:23", "text": "4トンです。"}, {"type": "subtitle", "time": 27089.43, "timestamp": "07:31:29", "text": "ええと、長さ4フィート、幅3フィートです。"}, {"type": "subtitle", "time": 27092.388, "timestamp": "07:31:32", "text": "とても大きい。それは大きすぎる"}, {"type": "subtitle", "time": 27094.468, "timestamp": "07:31:34", "text": "私のノートパソコン。つまり、本当に倍増しているということだ。"}, {"type": "subtitle", "time": 27099.468, "timestamp": "07:31:39", "text": "私の部屋のテーブルとしても使います。それで、"}, {"type": "subtitle", "time": 27102.43, "timestamp": "07:31:42", "text": "うん。"}, {"type": "subtitle", "time": 27110.15, "timestamp": "07:31:50", "text": "おそらく60ドル。"}, {"type": "subtitle", "time": 27112.23, "timestamp": "07:31:52", "text": "60ドル。まるで、私は考えていないみたいだ"}, {"type": "subtitle", "time": 27115.51, "timestamp": "07:31:55", "text": "彼らはインドでドルを扱っているが、確かに"}, {"type": "subtitle", "time": 27117.67, "timestamp": "07:31:57", "text": "ドルは別だけどね。"}, {"type": "subtitle", "time": 27119.468, "timestamp": "07:31:59", "text": "私は60歳になりました"}]
[{"type": "subtitle", "time": 8343.91, "timestamp": "02:19:03", "text": "なぜ？その時が来た。"}, {"type": "subtitle", "time": 8346.549, "timestamp": "02:19:06", "text": "私は注目された。"}, {"type": "subtitle", "time": 8350.23, "timestamp": "02:19:10", "text": "アードの金庫はすぐそこです。そうみたいです"}, {"type": "subtitle", "time": 8366.07, "timestamp": "02:19:26", "text": "ノア。大丈夫、きっと道は見つかるよ"}, {"type": "subtitle", "time": 8369.509, "timestamp": "02:19:29", "text": "ハードウェアの話に戻りましょう。心配しないで。今、"}, {"type": "subtitle", "time": 8371.429, "timestamp": "02:19:31", "text": "私たちはこの道をたどるだけで"}, {"type": "subtitle", "time": 8374.42, "timestamp": "02:19:34", "text": "金庫室にたどり着く。"}]
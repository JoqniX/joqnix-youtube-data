[{"type": "subtitle", "time": 780.069, "timestamp": "00:13:00", "text": "コープ。半稼働状態ではない"}, {"type": "subtitle", "time": 782.91, "timestamp": "00:13:02", "text": "ゲームプレイ。ああ、わかりました。"}, {"type": "subtitle", "time": 785.949, "timestamp": "00:13:05", "text": "でもあなたは"}, {"type": "subtitle", "time": 789.11, "timestamp": "00:13:09", "text": "何？カスタムを作成するのにいくらかかりますか"}, {"type": "subtitle", "time": 791.67, "timestamp": "00:13:11", "text": "協力プレイ用のネットワーク"}, {"type": "subtitle", "time": 799.55, "timestamp": "00:13:19", "text": "はぁ？公式の方法はありません"}, {"type": "subtitle", "time": 803.67, "timestamp": "00:13:23", "text": "はぁ？待って、これって同じゲームだよね？"}, {"type": "subtitle", "time": 810.11, "timestamp": "00:13:30", "text": "待って。あ、待って。それは全く別のゲームだ。"}, {"type": "subtitle", "time": 817.35, "timestamp": "00:13:37", "text": "アルカディア。わかった。はい、これは1時間です"}, {"type": "subtitle", "time": 818.59, "timestamp": "00:13:38", "text": "無線。"}, {"type": "subtitle", "time": 824.509, "timestamp": "00:13:44", "text": "えーと、接続中"}, {"type": "subtitle", "time": 827.11, "timestamp": "00:13:47", "text": "ネットワーク。わかった。何よりもワードローブが大切。"}]
[{"type": "subtitle", "time": 28200.868, "timestamp": "07:50:00", "text": "配信中です。ジャックさん、それは"}, {"type": "subtitle", "time": 28203.51, "timestamp": "07:50:03", "text": "うん。はい、できますよ。あなたはできる。あなたはできる。私"}, {"type": "subtitle", "time": 28205.19, "timestamp": "07:50:05", "text": "やったよ。なぜ警察は"}, {"type": "subtitle", "time": 28208.708, "timestamp": "07:50:08", "text": "私を追いかけているの？一体何なんだ？"}, {"type": "subtitle", "time": 28210.31, "timestamp": "07:50:10", "text": "彼らは全く気にしていない。えっと、彼は"}, {"type": "subtitle", "time": 28212.31, "timestamp": "07:50:12", "text": "彼はただ一人で死んでいくだけだろう。彼はそうしない"}, {"type": "subtitle", "time": 28214.628, "timestamp": "07:50:14", "text": "何もする必要はない。私たちはする必要はありません"}, {"type": "subtitle", "time": 28216.788, "timestamp": "07:50:16", "text": "彼のために何か特別なものを。彼はただ死んでしまう"}, {"type": "subtitle", "time": 28227.43, "timestamp": "07:50:27", "text": "ああ、危うく衝突しそうになった"}, {"type": "subtitle", "time": 28231.35, "timestamp": "07:50:31", "text": "その車とそれは私に近しいものを与えてくれる"}, {"type": "subtitle", "time": 28234.23, "timestamp": "07:50:34", "text": "電話。とても面白いです"}, {"type": "subtitle", "time": 28237.03, "timestamp": "07:50:37", "text": "ゲームがラグって、頑張る気力が失せてしまう"}, {"type": "subtitle", "time": 28240.31, "timestamp": "07:50:40", "text": "今すぐ撮影する。私はそうするつもりはない"}, {"type": "subtitle", "time": 28243.27, "timestamp": "07:50:43", "text": "嘘。おい。みんな、さあ。来て。"}, {"type": "subtitle", "time": 28253.19, "timestamp": "07:50:53", "text": "はい、お願いします。わーい！痛っ！おお！痛っ！痛っ！痛っ！"}, {"type": "subtitle", "time": 28256.51, "timestamp": "07:50:56", "text": "痛っ！痛っ！変人！変人！変人！ああ、"}, {"type": "subtitle", "time": 28259.43, "timestamp": "07:50:59", "text": "神様！私は誰かを殺そうと必死になっている"}]
[{"type": "subtitle", "time": 23101.91, "timestamp": "06:25:01", "text": "今はここに隠れていた方がいいだろう。"}, {"type": "subtitle", "time": 23104.628, "timestamp": "06:25:04", "text": "[音楽]"}, {"type": "subtitle", "time": 23107.15, "timestamp": "06:25:07", "text": "ああ、この人たちは誰ですか？誰が"}, {"type": "subtitle", "time": 23110.708, "timestamp": "06:25:10", "text": "これ？これは誰ですか？この人を見かけました"}, {"type": "subtitle", "time": 23119.39, "timestamp": "06:25:19", "text": "場所。ああ、彼女はとんでもない"}, {"type": "subtitle", "time": 23132.788, "timestamp": "06:25:32", "text": "彼女は、赤毛です。はい、私は"}, {"type": "subtitle", "time": 23134.67, "timestamp": "06:25:34", "text": "取得"}, {"type": "subtitle", "time": 23136.99, "timestamp": "06:25:36", "text": "彼女の名前は"}, {"type": "subtitle", "time": 23140.47, "timestamp": "06:25:40", "text": "カミラ。わかったよ、カミラ、愛しい人。今、"}, {"type": "subtitle", "time": 23141.788, "timestamp": "06:25:41", "text": "彼女は行ける"}, {"type": "subtitle", "time": 23146.11, "timestamp": "06:25:46", "text": "赤毛。はい、私は行きます"}, {"type": "subtitle", "time": 23149.31, "timestamp": "06:25:49", "text": "私は行く"}, {"type": "subtitle", "time": 23156.67, "timestamp": "06:25:56", "text": "彼女。何？"}]
[{"type": "subtitle", "time": 27901.27, "timestamp": "07:45:01", "text": "いや、いや、いや。私は去りたくない"}, {"type": "subtitle", "time": 27904.628, "timestamp": "07:45:04", "text": "ゲームはめちゃくちゃ大きい。"}, {"type": "subtitle", "time": 27907.35, "timestamp": "07:45:07", "text": "ああ、設定みたいなものですね。ああ、ただ押すだけです"}, {"type": "subtitle", "time": 27909.91, "timestamp": "07:45:09", "text": "遊ぶ。ええと、設定を変更できますよ。"}, {"type": "subtitle", "time": 27912.07, "timestamp": "07:45:12", "text": "ええ、66秒くらいあります"}, {"type": "subtitle", "time": 27915.11, "timestamp": "07:45:15", "text": "ゲームなので、内部で変更できます。"}, {"type": "subtitle", "time": 27917.35, "timestamp": "07:45:17", "text": "ああ、わかりました。どのチームに入るの？"}, {"type": "subtitle", "time": 27918.868, "timestamp": "07:45:18", "text": "チャック？"}, {"type": "subtitle", "time": 27922.948, "timestamp": "07:45:22", "text": "私は青色にします。私は憂鬱だ。"}, {"type": "subtitle", "time": 27932.15, "timestamp": "07:45:32", "text": "私はサンタクロースになるつもりです"}, {"type": "subtitle", "time": 27935.11, "timestamp": "07:45:35", "text": "時間。"}, {"type": "subtitle", "time": 27936.43, "timestamp": "07:45:36", "text": "それはそうあるべきだ"}, {"type": "subtitle", "time": 27940.07, "timestamp": "07:45:40", "text": "ロッキング。待って、違う人だ"}, {"type": "subtitle", "time": 27943.15, "timestamp": "07:45:43", "text": "異なる能力を持っている。"}, {"type": "subtitle", "time": 27946.15, "timestamp": "07:45:46", "text": "はい。さまざまな属性。つまり、"}, {"type": "subtitle", "time": 27957.15, "timestamp": "07:45:57", "text": "銃。彼は警察官のように見える。"}]
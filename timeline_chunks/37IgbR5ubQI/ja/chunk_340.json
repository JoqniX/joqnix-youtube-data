[{"type": "subtitle", "time": 20403.31, "timestamp": "05:40:03", "text": "私は頭をいくつか綴ることができます"}, {"type": "subtitle", "time": 20410.39, "timestamp": "05:40:10", "text": "自分。かかってこい。私の盾は耐えることができる"}, {"type": "subtitle", "time": 20436.948, "timestamp": "05:40:36", "text": "もうすぐだ。彼女は死んだ。ほとんど。"}, {"type": "subtitle", "time": 20438.91, "timestamp": "05:40:38", "text": "来て"}]
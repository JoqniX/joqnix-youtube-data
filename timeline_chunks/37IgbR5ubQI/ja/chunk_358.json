[{"type": "subtitle", "time": 21480.83, "timestamp": "05:58:00", "text": "これ。ああ、大変だ。私は"}, {"type": "subtitle", "time": 21484.07, "timestamp": "05:58:04", "text": "再起動。技術的な問題が発生しました。その"}, {"type": "subtitle", "time": 21490.27, "timestamp": "05:58:10", "text": "[音楽]"}, {"type": "subtitle", "time": 21493.21, "timestamp": "05:58:13", "text": "ああ、わかった。私にやらせてください"}, {"type": "subtitle", "time": 21495.39, "timestamp": "05:58:15", "text": "[音楽]"}, {"type": "subtitle", "time": 21505.91, "timestamp": "05:58:25", "text": "男の子。そうそう。今日、インターネットが使えなくなりました。"}, {"type": "subtitle", "time": 21507.868, "timestamp": "05:58:27", "text": "ああ、それは"}, {"type": "subtitle", "time": 21509.628, "timestamp": "05:58:29", "text": "なぜ。"}, {"type": "subtitle", "time": 21513.628, "timestamp": "05:58:33", "text": "おお。ああ、私は"}, {"type": "subtitle", "time": 21517.868, "timestamp": "05:58:37", "text": "忘れた。そんなことがあったなんて忘れてた"}, {"type": "subtitle", "time": 21527.37, "timestamp": "05:58:47", "text": "なぜ私は"}, {"type": "subtitle", "time": 21536.948, "timestamp": "05:58:56", "text": "忘れた。ああ、なるほど。今は"}, {"type": "subtitle", "time": 21539.35, "timestamp": "05:58:59", "text": "送信中。送信中です。はい、結構です。"}]
[{"type": "subtitle", "time": 2761.27, "timestamp": "00:46:01", "text": "待って。そうしないといけない。うん。うん。今"}, {"type": "subtitle", "time": 2763.39, "timestamp": "00:46:03", "text": "ボンクが好きでなければならない"}, {"type": "subtitle", "time": 2765.309, "timestamp": "00:46:05", "text": "自分。来る"}, {"type": "subtitle", "time": 2769.109, "timestamp": "00:46:09", "text": "ここ。一番上。ここに来て。待って、待って、"}, {"type": "subtitle", "time": 2776.95, "timestamp": "00:46:16", "text": "うん。うん。私を撃ってみて。あ、待って。"}, {"type": "subtitle", "time": 2780.589, "timestamp": "00:46:20", "text": "いや、それはやりすぎだ。待って、待って、待って。"}, {"type": "subtitle", "time": 2784.55, "timestamp": "00:46:24", "text": "ああ、ゆっくりと。一種の起床。あ、待って。"}, {"type": "subtitle", "time": 2787.43, "timestamp": "00:46:27", "text": "飛び降りて戻ってこなくてはならない。私は"}, {"type": "subtitle", "time": 2796.91, "timestamp": "00:46:36", "text": "1秒。私はまたこの場所に戻ってくるだろう。"}, {"type": "subtitle", "time": 2798.91, "timestamp": "00:46:38", "text": "わかった。"}, {"type": "subtitle", "time": 2808.71, "timestamp": "00:46:48", "text": "[笑い]"}, {"type": "subtitle", "time": 2811.51, "timestamp": "00:46:51", "text": "わかった。瀕死の状態だった。"}]
[{"type": "subtitle", "time": 28502.868, "timestamp": "07:55:02", "text": "「このゲームをプレイしているのか？」 わからない。"}, {"type": "subtitle", "time": 28505.868, "timestamp": "07:55:05", "text": "慣れていると言えばいいだけです。ええ、そうです"}, {"type": "subtitle", "time": 28509.628, "timestamp": "07:55:09", "text": "大丈夫。ヘイ、ヘイ、"}, {"type": "subtitle", "time": 28513.67, "timestamp": "07:55:13", "text": "おい。はい。私は警官にゲームを仕掛けました。さあ"}, {"type": "subtitle", "time": 28516.788, "timestamp": "07:55:16", "text": "行けよ、相棒。ついに、私は何かを成し遂げる"}, {"type": "subtitle", "time": 28520.548, "timestamp": "07:55:20", "text": "このゲームでは。さあ行こう。"}, {"type": "subtitle", "time": 28529.59, "timestamp": "07:55:29", "text": "何てことだ。何てことだ。何てことだ。ああ、神様。"}, {"type": "subtitle", "time": 28532.43, "timestamp": "07:55:32", "text": "兄弟。"}, {"type": "subtitle", "time": 28540.15, "timestamp": "07:55:40", "text": "えっと、どこへ行くのか分からないんです"}, {"type": "subtitle", "time": 28541.91, "timestamp": "07:55:41", "text": "もうそうではないけれど、大丈夫。引っ越します"}, {"type": "subtitle", "time": 28543.43, "timestamp": "07:55:43", "text": "フォワード。"}, {"type": "subtitle", "time": 28545.99, "timestamp": "07:55:45", "text": "皆さんが私の配信を見ることができれば、それは私の"}, {"type": "subtitle", "time": 28547.948, "timestamp": "07:55:47", "text": "これは私の配信です。これが私が"}, {"type": "subtitle", "time": 28550.708, "timestamp": "07:55:50", "text": "見ている。誰か私のところに来れば"}, {"type": "subtitle", "time": 28553.19, "timestamp": "07:55:53", "text": "ストリーミングして何が起こっているか見てください、"}]
[{"type": "subtitle", "time": 21242.67, "timestamp": "05:54:02", "text": "誰が誰で誰が誰であるかを覚えておいてください"}, {"type": "subtitle", "time": 21246.15, "timestamp": "05:54:06", "text": "これは、名前が中国語になったためです。"}, {"type": "subtitle", "time": 21248.708, "timestamp": "05:54:08", "text": "中国語の名前は別の名前です"}, {"type": "subtitle", "time": 21251.11, "timestamp": "05:54:11", "text": "えっと、意味とかそういうのがわからない"}, {"type": "subtitle", "time": 21253.27, "timestamp": "05:54:13", "text": "知る"}, {"type": "subtitle", "time": 21259.03, "timestamp": "05:54:19", "text": "そう、漢字とかでね。"}, {"type": "subtitle", "time": 21262.03, "timestamp": "05:54:22", "text": "ええ、私は50歳です。はい、50歳だと知っています。はい。"}, {"type": "subtitle", "time": 21265.35, "timestamp": "05:54:25", "text": "はい。私は見るのに慣れるようにしています"}, {"type": "subtitle", "time": 21268.948, "timestamp": "05:54:28", "text": "ユーザー名を今すぐ入力してください。そして、あなたは"}, {"type": "subtitle", "time": 21273.11, "timestamp": "05:54:33", "text": "7は17か何かみたいな数字だよ。"}, {"type": "subtitle", "time": 21275.868, "timestamp": "05:54:35", "text": "うん、それは少しは役に立つだろう"}, {"type": "subtitle", "time": 21277.948, "timestamp": "05:54:37", "text": "少し。"}, {"type": "subtitle", "time": 21281.47, "timestamp": "05:54:41", "text": "ええ、そうですね。えっと"}, {"type": "subtitle", "time": 21285.19, "timestamp": "05:54:45", "text": "今日は何をしようかな。私たちは、"}, {"type": "subtitle", "time": 21288.15, "timestamp": "05:54:48", "text": "メインクエストを進めてください。わかった。"}, {"type": "subtitle", "time": 21290.59, "timestamp": "05:54:50", "text": "私は自分の"}, {"type": "subtitle", "time": 21294.07, "timestamp": "05:54:54", "text": "えっと、私は、えっと、なんて言うんだっけ、やったと思うんだけど"}, {"type": "subtitle", "time": 21297.788, "timestamp": "05:54:57", "text": "それ？毎日。はい、毎日の課題をこなしました。"}]
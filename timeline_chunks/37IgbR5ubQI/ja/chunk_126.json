[{"type": "subtitle", "time": 7560.51, "timestamp": "02:06:00", "text": "[音楽]"}, {"type": "subtitle", "time": 7562.95, "timestamp": "02:06:02", "text": "神。彼は次のポイントを獲得するだろう。"}, {"type": "subtitle", "time": 7564.35, "timestamp": "02:06:04", "text": "私は"}, {"type": "subtitle", "time": 7568.229, "timestamp": "02:06:08", "text": "もちろん。あなたは今ですか？"}, {"type": "subtitle", "time": 7569.709, "timestamp": "02:06:09", "text": "私"}, {"type": "subtitle", "time": 7596.79, "timestamp": "02:06:36", "text": "はい。"}, {"type": "subtitle", "time": 7598.95, "timestamp": "02:06:38", "text": "先ほども言いました。"}, {"type": "subtitle", "time": 7600.589, "timestamp": "02:06:40", "text": "わかった。最後"}, {"type": "subtitle", "time": 7609.589, "timestamp": "02:06:49", "text": "自分が何回死んだか見てみろ。ああ、"}]
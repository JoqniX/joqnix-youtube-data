[{"type": "subtitle", "time": 841.269, "timestamp": "00:14:01", "text": "質問。世界選抜がある。待って、"}, {"type": "subtitle", "time": 844.87, "timestamp": "00:14:04", "text": "参加すべきですか？待って、試して"}, {"type": "subtitle", "time": 853.389, "timestamp": "00:14:13", "text": "あなた。私も参加します"}, {"type": "subtitle", "time": 868.15, "timestamp": "00:14:28", "text": "リチャード？この人たちは誰ですか？"}, {"type": "subtitle", "time": 880.55, "timestamp": "00:14:40", "text": "スカイ、私もあなたに加わったと思います。"}, {"type": "subtitle", "time": 888.069, "timestamp": "00:14:48", "text": "あなたは私に加わった。ええ、私も参加しました。どこ"}, {"type": "subtitle", "time": 897.35, "timestamp": "00:14:57", "text": "どの船？埠頭。ビーチ。"}]
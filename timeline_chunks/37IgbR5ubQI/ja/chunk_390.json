[{"type": "subtitle", "time": 23406.83, "timestamp": "06:30:06", "text": "あなたはとても特別な種です、私はとても"}, {"type": "subtitle", "time": 23413.27, "timestamp": "06:30:13", "text": "ああ、彼女は1.2で登場するらしいよ。"}, {"type": "subtitle", "time": 23416.59, "timestamp": "06:30:16", "text": "ああ、わかりました。じゃあ、頑張って稼ぐよ。"}, {"type": "subtitle", "time": 23419.43, "timestamp": "06:30:19", "text": "ああ、私はこれをやりたくない"}, {"type": "subtitle", "time": 23431.03, "timestamp": "06:30:31", "text": "[音楽]"}, {"type": "subtitle", "time": 23433.35, "timestamp": "06:30:33", "text": "そんなに簡単に捕まらないでくれよ"}, {"type": "subtitle", "time": 23440.91, "timestamp": "06:30:40", "text": "時間。"}, {"type": "subtitle", "time": 23447.948, "timestamp": "06:30:47", "text": "ああ、変な人に会った"}, {"type": "subtitle", "time": 23450.91, "timestamp": "06:30:50", "text": "女性。彼女は黒人出身です"}]
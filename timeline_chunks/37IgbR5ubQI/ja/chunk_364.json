[{"type": "subtitle", "time": 21844.99, "timestamp": "06:04:04", "text": "うわぁ。ああ、あの、あの、あの"}, {"type": "subtitle", "time": 21872.67, "timestamp": "06:04:32", "text": "新しい体制でスタートすることを約束する"}, {"type": "subtitle", "time": 21875.59, "timestamp": "06:04:35", "text": "ああ、私が"}, {"type": "subtitle", "time": 21877.51, "timestamp": "06:04:37", "text": "気が散っている。私は"}, {"type": "subtitle", "time": 21887.43, "timestamp": "06:04:47", "text": "[音楽]"}, {"type": "subtitle", "time": 21888.69, "timestamp": "06:04:48", "text": "でも私は"}, {"type": "subtitle", "time": 21899.27, "timestamp": "06:04:59", "text": "ここ。えっと、なぜゼニを選んだのか"}]
[{"type": "subtitle", "time": 22443.948, "timestamp": "06:14:03", "text": "ああ、それに近いところまで来ている。"}, {"type": "subtitle", "time": 22445.868, "timestamp": "06:14:05", "text": "何？何が"}, {"type": "subtitle", "time": 22448.948, "timestamp": "06:14:08", "text": "これ？まるで彼女が私たちを導いているか、"}, {"type": "subtitle", "time": 22455.02, "timestamp": "06:14:15", "text": "私たち。ええと、こちらです。私"}, {"type": "subtitle", "time": 22458.83, "timestamp": "06:14:18", "text": "[音楽]"}, {"type": "subtitle", "time": 22461.868, "timestamp": "06:14:21", "text": "知る。もしそれが"}, {"type": "subtitle", "time": 22476.31, "timestamp": "06:14:36", "text": "ああ、彼女は誰かを作ったと思う"}, {"type": "subtitle", "time": 22478.628, "timestamp": "06:14:38", "text": "アリーナ。わかりません。これは私に"}, {"type": "subtitle", "time": 22480.75, "timestamp": "06:14:40", "text": "ヴェリーナ"}, {"type": "subtitle", "time": 22485.628, "timestamp": "06:14:45", "text": "まるで私たちが見つけることを望んでいるかのような雰囲気"}, {"type": "subtitle", "time": 22499.07, "timestamp": "06:14:59", "text": "それは"}]
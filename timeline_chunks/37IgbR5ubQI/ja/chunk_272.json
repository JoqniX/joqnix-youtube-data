[{"type": "subtitle", "time": 16321.51, "timestamp": "04:32:01", "text": "急ぐ必要はありません。せっかちな者は倒れるだろう"}, {"type": "subtitle", "time": 16323.75, "timestamp": "04:32:03", "text": "まさに私たちの膝の上に。何かお手伝いできることがあれば"}, {"type": "subtitle", "time": 16362.63, "timestamp": "04:32:42", "text": "私が抱えているクエストの数を見てください。"}, {"type": "subtitle", "time": 16368.79, "timestamp": "04:32:48", "text": "非常識な。チュートリアルが多すぎる。私はしなければならない"}, {"type": "subtitle", "time": 16369.95, "timestamp": "04:32:49", "text": "これ"}, {"type": "subtitle", "time": 16374.92, "timestamp": "04:32:54", "text": "今。でも、私はまだそこにすら到達していない。"}]
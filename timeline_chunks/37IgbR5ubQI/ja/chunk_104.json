[{"type": "subtitle", "time": 6242.709, "timestamp": "01:44:02", "text": "私を何度撃つつもりですか？"}, {"type": "subtitle", "time": 6249.91, "timestamp": "01:44:09", "text": "死ぬのか？念のため、ディオ。あなたは決して"}, {"type": "subtitle", "time": 6252.51, "timestamp": "01:44:12", "text": "知る。あなたは生まれます"}, {"type": "subtitle", "time": 6256.35, "timestamp": "01:44:16", "text": "死んだ。あなたは本当にプロですね"}, {"type": "subtitle", "time": 6259.07, "timestamp": "01:44:19", "text": "ゲーム。"}]
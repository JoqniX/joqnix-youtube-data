[{"type": "subtitle", "time": 23170.51, "timestamp": "06:26:10", "text": "何？箱いっぱいの"}, {"type": "subtitle", "time": 23172.93, "timestamp": "06:26:12", "text": "驚き。誰が"}, {"type": "subtitle", "time": 23180.15, "timestamp": "06:26:20", "text": "あなた？彼女は白髪だ。彼女は赤くなることができる"}, {"type": "subtitle", "time": 23183.01, "timestamp": "06:26:23", "text": "頭。"}, {"type": "subtitle", "time": 23188.47, "timestamp": "06:26:28", "text": "[音楽]"}, {"type": "subtitle", "time": 23199.45, "timestamp": "06:26:39", "text": "上。あなたには大きな可能性が秘められています。私の質問に答えてください"}, {"type": "subtitle", "time": 23207.99, "timestamp": "06:26:47", "text": "質問。彼女はクールだ。ああ、彼女は着ている"}]
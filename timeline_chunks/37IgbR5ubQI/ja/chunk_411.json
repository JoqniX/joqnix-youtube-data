[{"type": "subtitle", "time": 24662.15, "timestamp": "06:51:02", "text": "それらの？どのように配信しますか？私は配信しません"}, {"type": "subtitle", "time": 24665.11, "timestamp": "06:51:05", "text": "例えば、あなたは何をしますか？それは"}, {"type": "subtitle", "time": 24667.99, "timestamp": "06:51:07", "text": "まるでエコーハンティングみたいだよね？入手"}, {"type": "subtitle", "time": 24671.11, "timestamp": "06:51:11", "text": "最高の反響音とか。農業"}, {"type": "subtitle", "time": 24672.15, "timestamp": "06:51:12", "text": "人工物のようなもの"}, {"type": "subtitle", "time": 24674.03, "timestamp": "06:51:14", "text": "[音楽]"}, {"type": "subtitle", "time": 24689.39, "timestamp": "06:51:29", "text": "推測。俺は、ただ"}, {"type": "subtitle", "time": 24691.23, "timestamp": "06:51:31", "text": "に"}, {"type": "subtitle", "time": 24701.03, "timestamp": "06:51:41", "text": "知ってるかい、壮大な雨。そしてアンコは"}, {"type": "subtitle", "time": 24705.43, "timestamp": "06:51:45", "text": "全部レジに通す。彼女はどうしてこんなに可愛いの？"}, {"type": "subtitle", "time": 24712.99, "timestamp": "06:51:52", "text": "これ。彼女はただ両腕を上げて"}, {"type": "subtitle", "time": 24716.11, "timestamp": "06:51:56", "text": "空気。ああ、"}, {"type": "subtitle", "time": 24718.75, "timestamp": "06:51:58", "text": "ああ、感じさせて"}]
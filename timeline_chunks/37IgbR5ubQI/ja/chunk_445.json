[{"type": "subtitle", "time": 26706.23, "timestamp": "07:25:06", "text": "しかしゾンビはあなたを引き裂くでしょう"}, {"type": "subtitle", "time": 26708.03, "timestamp": "07:25:08", "text": "離れて見ることができます"}, {"type": "subtitle", "time": 26712.83, "timestamp": "07:25:12", "text": "視覚的にね。うん。"}, {"type": "subtitle", "time": 26715.628, "timestamp": "07:25:15", "text": "うん。少し"}, {"type": "subtitle", "time": 26724.23, "timestamp": "07:25:24", "text": "私は何者？うん、"}, {"type": "subtitle", "time": 26729.51, "timestamp": "07:25:29", "text": "キャンプを修了しなければなりません。え、何？"}, {"type": "subtitle", "time": 26732.788, "timestamp": "07:25:32", "text": "キャンペーンを完了する必要があります。"}, {"type": "subtitle", "time": 26736.788, "timestamp": "07:25:36", "text": "なぜオンラインでプレイできないのですか？"}, {"type": "subtitle", "time": 26739.59, "timestamp": "07:25:39", "text": "それは何ですか？それは確かに存在する。クリックすると"}, {"type": "subtitle", "time": 26743.35, "timestamp": "07:25:43", "text": "うわあ、そういうことあるのか。待って、クリック"}, {"type": "subtitle", "time": 26747.19, "timestamp": "07:25:47", "text": "キャンプはオンラインで？うん。パインサーバー、"}, {"type": "subtitle", "time": 26749.99, "timestamp": "07:25:49", "text": "右？それで、一緒に参加しようかと聞いてみたんです"}, {"type": "subtitle", "time": 26753.51, "timestamp": "07:25:53", "text": "ここから。なぜ私は狂っているのだろう？ああ、私は"}, {"type": "subtitle", "time": 26756.468, "timestamp": "07:25:56", "text": "いい感じ。私のモデルは特に理由もなくノリノリだ。"}, {"type": "subtitle", "time": 26759.23, "timestamp": "07:25:59", "text": "なんで俺は参加できないんだよ？何"}]
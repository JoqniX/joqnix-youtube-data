[{"type": "subtitle", "time": 24557.07, "timestamp": "06:49:17", "text": "[音楽]"}, {"type": "subtitle", "time": 24559.75, "timestamp": "06:49:19", "text": "ブドウ栽培。ビーコンはロック解除されるはずです"}, {"type": "subtitle", "time": 24561.11, "timestamp": "06:49:21", "text": "あなた。"}, {"type": "subtitle", "time": 24564.31, "timestamp": "06:49:24", "text": "そこへ行ってください。"}, {"type": "subtitle", "time": 24573.548, "timestamp": "06:49:33", "text": "ペキュリア・ブレイク・ブルーム。はい、結構です。 600 XP。"}, {"type": "subtitle", "time": 24577.27, "timestamp": "06:49:37", "text": "ニース。そうそう。すぐにレベルアップできます"}, {"type": "subtitle", "time": 24580.708, "timestamp": "06:49:40", "text": "本当に大変だった。ストーリーを作っているから"}, {"type": "subtitle", "time": 24581.628, "timestamp": "06:49:41", "text": "クエスト"}, {"type": "subtitle", "time": 24584.708, "timestamp": "06:49:44", "text": "今。ニース。"}, {"type": "subtitle", "time": 24587.19, "timestamp": "06:49:47", "text": "また、私の質問は、今あなたは何をしているのかということです。"}, {"type": "subtitle", "time": 24590.35, "timestamp": "06:49:50", "text": "このゲームでは、"}, {"type": "subtitle", "time": 24593.91, "timestamp": "06:49:53", "text": "毎日のお休みを終えて"}, {"type": "subtitle", "time": 24595.468, "timestamp": "06:49:55", "text": "プレートと"}, {"type": "subtitle", "time": 24599.43, "timestamp": "06:49:59", "text": "他に何をすべきか"}]
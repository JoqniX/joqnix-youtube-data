[{"type": "subtitle", "time": 1805.95, "timestamp": "00:30:05", "text": "[音楽]"}, {"type": "subtitle", "time": 1813.83, "timestamp": "00:30:13", "text": "ああ、これは楽しい。楽しい。"}, {"type": "subtitle", "time": 1825.669, "timestamp": "00:30:25", "text": "想像する。いや、いや、いや、いや、いや、いや、いや。どうやって"}, {"type": "subtitle", "time": 1828.789, "timestamp": "00:30:28", "text": "どうしてそんな風に私を突き放すの？"}, {"type": "subtitle", "time": 1858.87, "timestamp": "00:30:58", "text": "わーい。しかし、あなたは自分自身を打ち上げることはできません"}]
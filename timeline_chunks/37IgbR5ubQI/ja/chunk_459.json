[{"type": "subtitle", "time": 27541.43, "timestamp": "07:39:01", "text": "3席空席、2席空席"}, {"type": "subtitle", "time": 27545.35, "timestamp": "07:39:05", "text": "あるいは、そんな感じ。ここに来て。ここに来て。"}, {"type": "subtitle", "time": 27549.19, "timestamp": "07:39:09", "text": "痛い。マンさん、"}, {"type": "subtitle", "time": 27551.948, "timestamp": "07:39:11", "text": "別のものをクリックしました。君たち"}, {"type": "subtitle", "time": 27554.788, "timestamp": "07:39:14", "text": "サーバーへの接続に失敗しました。私はしません"}, {"type": "subtitle", "time": 27556.388, "timestamp": "07:39:16", "text": "えっと、ちょっと待って。ああ、こうやって試してみてもいいよ"}, {"type": "subtitle", "time": 27559.75, "timestamp": "07:39:19", "text": "また。諦めずに何度も挑戦し続けてください。それは"}, {"type": "subtitle", "time": 27562.788, "timestamp": "07:39:22", "text": "時々、それを示す。"}, {"type": "subtitle", "time": 27565.83, "timestamp": "07:39:25", "text": "そうそう。忘れた。"}, {"type": "subtitle", "time": 27569.388, "timestamp": "07:39:29", "text": "私はあなたです。わーい。それは私"}, {"type": "subtitle", "time": 27581.91, "timestamp": "07:39:41", "text": "おお。おお。これがそれですか？ああ、神様。とは"}, {"type": "subtitle", "time": 27584.91, "timestamp": "07:39:44", "text": "良いセンサー、何に使えるか"}, {"type": "subtitle", "time": 27587.99, "timestamp": "07:39:47", "text": "死？まるで私が死んだみたいだった。いいえ、私は"}, {"type": "subtitle", "time": 27595.11, "timestamp": "07:39:55", "text": "寝たと言ってもいいですか？"}, {"type": "subtitle", "time": 27599.91, "timestamp": "07:39:59", "text": "ええと、私たちの仲間に入ってください。"}]
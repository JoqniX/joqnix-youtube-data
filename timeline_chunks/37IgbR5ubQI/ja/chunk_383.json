[{"type": "subtitle", "time": 22987.35, "timestamp": "06:23:07", "text": "ナンは、そういうものが作られていない場所だ"}, {"type": "subtitle", "time": 22989.15, "timestamp": "06:23:09", "text": "による"}, {"type": "subtitle", "time": 22992.35, "timestamp": "06:23:12", "text": "ミナはそれを"}, {"type": "subtitle", "time": 23006.83, "timestamp": "06:23:26", "text": "えーと"}, {"type": "subtitle", "time": 23010.27, "timestamp": "06:23:30", "text": "[音楽]"}, {"type": "subtitle", "time": 23013.788, "timestamp": "06:23:33", "text": "パパ・ロック、音がどこから聞こえてくるのか"}, {"type": "subtitle", "time": 23016.51, "timestamp": "06:23:36", "text": "から。調査してもいいですか？"}, {"type": "subtitle", "time": 23021.27, "timestamp": "06:23:41", "text": "それ？黒い花びら。ああ、わかりました。彼らだ。"}, {"type": "subtitle", "time": 23023.91, "timestamp": "06:23:43", "text": "ああ、わかりました。黒い花びら部隊のテーマまたは"}, {"type": "subtitle", "time": 23031.788, "timestamp": "06:23:51", "text": "倒す"}, {"type": "subtitle", "time": 23034.91, "timestamp": "06:23:54", "text": "フラクティカス。よし、"}]
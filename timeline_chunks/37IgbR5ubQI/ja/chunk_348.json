[{"type": "subtitle", "time": 20882.708, "timestamp": "05:48:02", "text": "えーとトランポリン、えーとトランペット、トロンボーン、または"}, {"type": "subtitle", "time": 20885.91, "timestamp": "05:48:05", "text": "視覚的に調整できるもの"}, {"type": "subtitle", "time": 20889.75, "timestamp": "05:48:09", "text": "音声変調がはっきりと聞こえる"}, {"type": "subtitle", "time": 20894.31, "timestamp": "05:48:14", "text": "そして全て。だから、とても良い"}, {"type": "subtitle", "time": 20896.07, "timestamp": "05:48:16", "text": "えっと、あれ。できるかどうかわかりません"}, {"type": "subtitle", "time": 20898.23, "timestamp": "05:48:18", "text": "ゲームと呼ぶ人もいるかもしれないが、楽しいよ。私"}, {"type": "subtitle", "time": 20900.27, "timestamp": "05:48:20", "text": "そうしようと思った。もしかしたらやるかもしれない"}, {"type": "subtitle", "time": 20904.59, "timestamp": "05:48:24", "text": "明日。ええ、そうですね。こんにちは。こんにちは、ニハ。"}, {"type": "subtitle", "time": 20907.03, "timestamp": "05:48:27", "text": "ニハ。今日は調子はどうですか？"}, {"type": "subtitle", "time": 20910.31, "timestamp": "05:48:30", "text": "元気です。今日は元気ですか？私は"}, {"type": "subtitle", "time": 20918.788, "timestamp": "05:48:38", "text": "今日。えっと、ちょうど壊れたんです。"}, {"type": "subtitle", "time": 20921.67, "timestamp": "05:48:41", "text": "朝食、夕食。"}, {"type": "subtitle", "time": 20926.15, "timestamp": "05:48:46", "text": "夕食を済ませてここにいます。"}, {"type": "subtitle", "time": 20929.03, "timestamp": "05:48:49", "text": "何でも飛び込む準備はできてるわ、ベイビーたち"}, {"type": "subtitle", "time": 20930.59, "timestamp": "05:48:50", "text": "今日。"}, {"type": "subtitle", "time": 20936.83, "timestamp": "05:48:56", "text": "うん。えっと、私の配信PCがダウンしています。"}]
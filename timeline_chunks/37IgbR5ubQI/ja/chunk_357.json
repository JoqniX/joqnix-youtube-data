[{"type": "subtitle", "time": 21420.83, "timestamp": "05:57:00", "text": "今のところは探求です。巻き戻しを行う"}, {"type": "subtitle", "time": 21423.548, "timestamp": "05:57:03", "text": "雨滴。わかった。さあ行こう"}, {"type": "subtitle", "time": 21428.07, "timestamp": "05:57:08", "text": "ここ。ファストトラベルを使えばいいんです。私にさせて"}, {"type": "subtitle", "time": 21431.868, "timestamp": "05:57:11", "text": "この男がなぜそうしないのかを突き止める"}, {"type": "subtitle", "time": 21465.59, "timestamp": "05:57:45", "text": "2番。どうやって？待って。何？なぜ？何が"}, {"type": "subtitle", "time": 21469.03, "timestamp": "05:57:49", "text": "今日何が起こっているの？待って。何？はぁ？どこ"}, {"type": "subtitle", "time": 21470.75, "timestamp": "05:57:50", "text": "あなたが"}, {"type": "subtitle", "time": 21473.15, "timestamp": "05:57:53", "text": "走っている？どこにいるの"}]
[{"type": "subtitle", "time": 2882.71, "timestamp": "00:48:02", "text": "それで、それは私の図書館にあったので、私は"}, {"type": "subtitle", "time": 2885.589, "timestamp": "00:48:05", "text": "カジュアルなゲームを探していたのですが"}, {"type": "subtitle", "time": 2887.51, "timestamp": "00:48:07", "text": "マルチプレイヤーで、これを見つけました。私は"}, {"type": "subtitle", "time": 2895.589, "timestamp": "00:48:15", "text": "うん。もう一つ試したゲームも"}, {"type": "subtitle", "time": 2897.91, "timestamp": "00:48:17", "text": "そのゲームは開発を中止したか、"}, {"type": "subtitle", "time": 2899.95, "timestamp": "00:48:19", "text": "何か。私たちは参加できず、"}, {"type": "subtitle", "time": 2902.589, "timestamp": "00:48:22", "text": "すべて。となることによって"}, {"type": "subtitle", "time": 2905.309, "timestamp": "00:48:25", "text": "最悪だ。それで"}, {"type": "subtitle", "time": 2908.15, "timestamp": "00:48:28", "text": "うん。ああ、もう一方のゲームは保管しておいたの？"}, {"type": "subtitle", "time": 2912.069, "timestamp": "00:48:32", "text": "Paliaとかをダウンロードする？"}, {"type": "subtitle", "time": 2914.95, "timestamp": "00:48:34", "text": "私の Steam はダウンロードされません"}]
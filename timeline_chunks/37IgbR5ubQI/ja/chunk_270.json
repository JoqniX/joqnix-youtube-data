[{"type": "subtitle", "time": 16201.03, "timestamp": "04:30:01", "text": "OP。彼女を手に入れることができれば。急ぐ必要はありません。悪魔。"}, {"type": "subtitle", "time": 16203.59, "timestamp": "04:30:03", "text": "何かお手伝いできることがあれば、お気軽にお申し付けください。もし私ができるなら"}, {"type": "subtitle", "time": 16211.269, "timestamp": "04:30:11", "text": "神。なあ、これを見てみろよ。強すぎる。私は手に入れた"}, {"type": "subtitle", "time": 16215.149, "timestamp": "04:30:15", "text": "ゲーム内で最高の武器はどれですか？"}, {"type": "subtitle", "time": 16218.99, "timestamp": "04:30:18", "text": "今。冗談でしょう？"}, {"type": "subtitle", "time": 16224.63, "timestamp": "04:30:24", "text": "[音楽]"}, {"type": "subtitle", "time": 16228.79, "timestamp": "04:30:28", "text": "ゲーム内で最強の武器を手に入れた。"}]
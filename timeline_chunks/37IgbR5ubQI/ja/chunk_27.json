[{"type": "subtitle", "time": 1620.669, "timestamp": "00:27:00", "text": "オイルの種類"}, {"type": "subtitle", "time": 1623.789, "timestamp": "00:27:03", "text": "シェイキーバーガータラ"}, {"type": "subtitle", "time": 1635.909, "timestamp": "00:27:15", "text": "部屋の中央の部屋のもの"}, {"type": "subtitle", "time": 1638.31, "timestamp": "00:27:18", "text": "待って、あなたは公開のものに参加したいのですか、それとも"}, {"type": "subtitle", "time": 1640.909, "timestamp": "00:27:20", "text": "参加したいだけです"}, {"type": "subtitle", "time": 1643.149, "timestamp": "00:27:23", "text": "見つける"}, {"type": "subtitle", "time": 1646.47, "timestamp": "00:27:26", "text": "なぜ誰もこの名前でプレイしないのか。"}, {"type": "subtitle", "time": 1651.11, "timestamp": "00:27:31", "text": "何？あなたに送りました"}, {"type": "subtitle", "time": 1666.23, "timestamp": "00:27:46", "text": "わかった。ああ、君のことが分かったよ。待って、誰もプレイしない"}, {"type": "subtitle", "time": 1668.95, "timestamp": "00:27:48", "text": "このゲーム。馬が主催者です。見て、"}, {"type": "subtitle", "time": 1670.11, "timestamp": "00:27:50", "text": "それは"}, {"type": "subtitle", "time": 1674.31, "timestamp": "00:27:54", "text": "猫。それまでの間、猫との時間を楽しんでください。私はします"}, {"type": "subtitle", "time": 1677.029, "timestamp": "00:27:57", "text": "これは猫の画像です。このゲームは何ですか？"}]
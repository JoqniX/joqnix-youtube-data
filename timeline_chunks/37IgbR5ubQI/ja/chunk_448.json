[{"type": "subtitle", "time": 26882.35, "timestamp": "07:28:02", "text": "分。 5分です。私たちは"}, {"type": "subtitle", "time": 26886.628, "timestamp": "07:28:06", "text": "順調です。ああ、ここにいますよ。 5分。私"}, {"type": "subtitle", "time": 26888.788, "timestamp": "07:28:08", "text": "知る。どちらのチームに入りたいですか？私は"}, {"type": "subtitle", "time": 26892.628, "timestamp": "07:28:12", "text": "もし私が青くなるなら。ああ、わかりました。赤くなるよ"}, {"type": "subtitle", "time": 26895.708, "timestamp": "07:28:15", "text": "それから。私は憂鬱なの？わからない"}, {"type": "subtitle", "time": 26899.11, "timestamp": "07:28:19", "text": "私はまさにそうです。そうそう。あなたは あなたは"}, {"type": "subtitle", "time": 26903.35, "timestamp": "07:28:23", "text": "あなたは赤い。いいえ、2つだけです。"}, {"type": "subtitle", "time": 26905.59, "timestamp": "07:28:25", "text": "このゲームは何ですか？ああ、これは"}, {"type": "subtitle", "time": 26912.788, "timestamp": "07:28:32", "text": "私は人々を見る。あれは警察ですか？うん、"}, {"type": "subtitle", "time": 26915.67, "timestamp": "07:28:35", "text": "あれは警察だ。ああ、俺は警官を殺せる。"}, {"type": "subtitle", "time": 26919.51, "timestamp": "07:28:39", "text": "ああ、なんてことだ、ああ、なんてことだ、私は殺した"}, {"type": "subtitle", "time": 26923.19, "timestamp": "07:28:43", "text": "彼。ジョック、そんなこと言うなよ。言わないで"}, {"type": "subtitle", "time": 26926.91, "timestamp": "07:28:46", "text": "あの言葉。神、"}, {"type": "subtitle", "time": 26931.91, "timestamp": "07:28:51", "text": "ストリーミングしないでください。イエス・キリスト。あ、すみません。"}, {"type": "subtitle", "time": 26936.99, "timestamp": "07:28:56", "text": "何てことだ。私も配信しています。よし。"}]
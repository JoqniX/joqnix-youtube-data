[{"type": "subtitle", "time": 22200.51, "timestamp": "06:10:00", "text": "[音楽]"}, {"type": "subtitle", "time": 22204.59, "timestamp": "06:10:04", "text": "若い。おお。若くはないが、"}, {"type": "subtitle", "time": 22209.868, "timestamp": "06:10:09", "text": "成熟した。うん。白髪はほんの少しだけ。"}, {"type": "subtitle", "time": 22213.43, "timestamp": "06:10:13", "text": "うん。彼女を大人っぽく見せる。うん。"}, {"type": "subtitle", "time": 22229.31, "timestamp": "06:10:29", "text": "ブレイク・ブルームを彼女に見せてあげて"}, {"type": "subtitle", "time": 22231.47, "timestamp": "06:10:31", "text": "写真。"}]
[{"type": "subtitle", "time": 22021.67, "timestamp": "06:07:01", "text": "ああ、スキーはもっとずっと高価に違いない"}, {"type": "subtitle", "time": 22047.99, "timestamp": "06:07:27", "text": "ああ、つまり、なんていう名前だったっけ？ブラックショー"}, {"type": "subtitle", "time": 22057.35, "timestamp": "06:07:37", "text": "[音楽]"}, {"type": "subtitle", "time": 22061.59, "timestamp": "06:07:41", "text": "ああ、あの花。それはただの写真です。できない"}, {"type": "subtitle", "time": 22065.35, "timestamp": "06:07:45", "text": "それがどこにあるのか教えてください。えっと、それは私の"}, {"type": "subtitle", "time": 22068.788, "timestamp": "06:07:48", "text": "能力。 Hブラックショーと主催者"}, {"type": "subtitle", "time": 22069.868, "timestamp": "06:07:49", "text": "研究"}, {"type": "subtitle", "time": 22073.27, "timestamp": "06:07:53", "text": "嘆く。ショーのメンバー全員が花を咲かせる"}, {"type": "subtitle", "time": 22078.75, "timestamp": "06:07:58", "text": "このような。 25日頃は空いているでしょう。ええと、24歳です。"}]
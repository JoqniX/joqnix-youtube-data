[{"type": "subtitle", "time": 3306.87, "timestamp": "00:55:06", "text": "私はもうどのゲームをおすすめするか決めています"}, {"type": "subtitle", "time": 3319.03, "timestamp": "00:55:19", "text": "はい。寝室。これは何ですか？それは"}, {"type": "subtitle", "time": 3322.03, "timestamp": "00:55:22", "text": "ロックされていますか？赤いもの。青"}, {"type": "subtitle", "time": 3324.99, "timestamp": "00:55:24", "text": "もの。座って待って"}, {"type": "subtitle", "time": 3333.349, "timestamp": "00:55:33", "text": "置いて、彼らは行った。"}, {"type": "subtitle", "time": 3343.79, "timestamp": "00:55:43", "text": "うん。ああ、旗取りだ。はい。"}, {"type": "subtitle", "time": 3346.549, "timestamp": "00:55:46", "text": "ニース。ピューピューピューと捕獲"}, {"type": "subtitle", "time": 3350.789, "timestamp": "00:55:50", "text": "フラグ。基地に戻りなさい。おお、"}, {"type": "subtitle", "time": 3352.71, "timestamp": "00:55:52", "text": "これが、私たちがこれをすべき理由です"}, {"type": "subtitle", "time": 3355.67, "timestamp": "00:55:55", "text": "おかえりなさい。"}, {"type": "subtitle", "time": 3358.23, "timestamp": "00:55:58", "text": "なんてこった。"}]
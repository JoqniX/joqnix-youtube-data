[{"type": "subtitle", "time": 4550.63, "timestamp": "01:15:50", "text": "あ、待って。私の好きなタイプの"}, {"type": "subtitle", "time": 4551.39, "timestamp": "01:15:51", "text": "意思"}, {"type": "subtitle", "time": 4554.63, "timestamp": "01:15:54", "text": "わからない。私は、私は、私は、私はしない"}, {"type": "subtitle", "time": 4556.63, "timestamp": "01:15:56", "text": "お気に入りがある。何でも構いません"}, {"type": "subtitle", "time": 4558.55, "timestamp": "01:15:58", "text": "実は。"}]
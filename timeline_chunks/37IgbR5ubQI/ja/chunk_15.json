[{"type": "subtitle", "time": 900.629, "timestamp": "00:15:00", "text": "ここに見える大きな石。"}, {"type": "subtitle", "time": 903.829, "timestamp": "00:15:03", "text": "あなたはここにいない。ここ。君の姿が見えない。"}, {"type": "subtitle", "time": 906.389, "timestamp": "00:15:06", "text": "では、その後はどうなるのか？はぁ？"}, {"type": "subtitle", "time": 908.949, "timestamp": "00:15:08", "text": "俺、このゲームよく分からないんだよ。待って。私にさせて"}, {"type": "subtitle", "time": 909.87, "timestamp": "00:15:09", "text": "参加する"}, {"type": "subtitle", "time": 920.189, "timestamp": "00:15:20", "text": "マイナー。私はFキーを押していますか？ない。なぜ"}, {"type": "subtitle", "time": 924.79, "timestamp": "00:15:24", "text": "それ？このゲームは本当にひどい。"}, {"type": "subtitle", "time": 927.67, "timestamp": "00:15:27", "text": "つまり、説明文を読めば、"}, {"type": "subtitle", "time": 930.47, "timestamp": "00:15:30", "text": "それなら、それを責めることはできない。うん、本当だよ。"}, {"type": "subtitle", "time": 931.949, "timestamp": "00:15:31", "text": "真実、"}, {"type": "subtitle", "time": 934.269, "timestamp": "00:15:34", "text": "真実。私"}, {"type": "subtitle", "time": 938.629, "timestamp": "00:15:38", "text": "考えてみよう、もう一度やり直そう。"}, {"type": "subtitle", "time": 942.71, "timestamp": "00:15:42", "text": "えっと、公開ワールドに参加してみましょう。"}, {"type": "subtitle", "time": 944.79, "timestamp": "00:15:44", "text": "選択してください。"}, {"type": "subtitle", "time": 954.31, "timestamp": "00:15:54", "text": "他の人がどこにいるかを選択する"}]
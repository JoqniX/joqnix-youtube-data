[{"type": "subtitle", "time": 26421.91, "timestamp": "07:20:21", "text": "こんにちは。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 26424.548, "timestamp": "07:20:24", "text": "音声が途切れているのか、それとも問題ないのか"}, {"type": "subtitle", "time": 26428.628, "timestamp": "07:20:28", "text": "今？今日は大丈夫です。はい。わかった。私"}, {"type": "subtitle", "time": 26432.15, "timestamp": "07:20:32", "text": "ずっとミュート状態だったことに気づいた。えっと、"}, {"type": "subtitle", "time": 26434.39, "timestamp": "07:20:34", "text": "こんにちは。つい最近登録したばかりだから、どうでもいいよ。私"}, {"type": "subtitle", "time": 26436.468, "timestamp": "07:20:36", "text": "あなたの声が聞こえました。わかった。私は行くつもりです"}, {"type": "subtitle", "time": 26438.468, "timestamp": "07:20:38", "text": "始めます。ああ、始めよう"}, {"type": "subtitle", "time": 26440.07, "timestamp": "07:20:40", "text": "トゥイッチ。 Twitchを始めようと思います。私は"}, {"type": "subtitle", "time": 26442.07, "timestamp": "07:20:42", "text": "ストリームを開始するだけです"}, {"type": "subtitle", "time": 26444.31, "timestamp": "07:20:44", "text": "そして、そこから話を進めていく。大丈夫です。私"}, {"type": "subtitle", "time": 26447.11, "timestamp": "07:20:47", "text": "知る。うん。これから始めます"}, {"type": "subtitle", "time": 26449.548, "timestamp": "07:20:49", "text": "３、２、"}, {"type": "subtitle", "time": 26459.51, "timestamp": "07:20:59", "text": "私が脱落していないことを願おう。私はトップではない"}]
[{"type": "subtitle", "time": 28022.15, "timestamp": "07:47:02", "text": "何てことだ。警察官の方、お願いします。"}, {"type": "subtitle", "time": 28025.23, "timestamp": "07:47:05", "text": "わかった。うん。待って、どうやって探せばいいの？"}, {"type": "subtitle", "time": 28046.43, "timestamp": "07:47:26", "text": "ああ、そうだね。 M. ああ、私の"}, {"type": "subtitle", "time": 28049.38, "timestamp": "07:47:29", "text": "神。何？"}, {"type": "subtitle", "time": 28055.11, "timestamp": "07:47:35", "text": "なぜこの警察官はそんなに執着しているのか"}, {"type": "subtitle", "time": 28074.31, "timestamp": "07:47:54", "text": "くそ？なんてこった。忘れた。"}]
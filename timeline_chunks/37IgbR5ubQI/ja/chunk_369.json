[{"type": "subtitle", "time": 22140.39, "timestamp": "06:09:00", "text": "こんにちは、練習者さん"}, {"type": "subtitle", "time": 22142.59, "timestamp": "06:09:02", "text": "[音楽]"}, {"type": "subtitle", "time": 22146.07, "timestamp": "06:09:06", "text": "予定。それは難しいだろう。うん、"}, {"type": "subtitle", "time": 22148.83, "timestamp": "06:09:08", "text": "花の写真しかありません。"}, {"type": "subtitle", "time": 22152.99, "timestamp": "06:09:12", "text": "いいえ。リンおばあちゃん。誰"}, {"type": "subtitle", "time": 22156.548, "timestamp": "06:09:16", "text": "それ？よし、おばあちゃんに聞いてみよう。"}, {"type": "subtitle", "time": 22161.23, "timestamp": "06:09:21", "text": "彼女はいくつかアドバイスをくれるかもしれない。おお、"}, {"type": "subtitle", "time": 22176.19, "timestamp": "06:09:36", "text": "うん。彼女を探しに行こう。こんにちは。さあ"}, {"type": "subtitle", "time": 22179.948, "timestamp": "06:09:39", "text": "行く。私たちは探しています"}, {"type": "subtitle", "time": 22184.23, "timestamp": "06:09:44", "text": "おばあちゃん。雨を巻き戻す、雨粒。"}, {"type": "subtitle", "time": 22186.548, "timestamp": "06:09:46", "text": "わかった。"}, {"type": "subtitle", "time": 22189.47, "timestamp": "06:09:49", "text": "ああ、彼女はとても近い。"}, {"type": "subtitle", "time": 22194.91, "timestamp": "06:09:54", "text": "わかった。えっと、リンス。わかった。こんにちは、"}, {"type": "subtitle", "time": 22197.19, "timestamp": "06:09:57", "text": "おばあちゃん。彼女は"}]
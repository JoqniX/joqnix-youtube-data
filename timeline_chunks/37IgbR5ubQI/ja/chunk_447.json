[{"type": "subtitle", "time": 26822.15, "timestamp": "07:27:02", "text": "ええと、救済の道において、ですよね？"}, {"type": "subtitle", "time": 26823.99, "timestamp": "07:27:03", "text": "うん。"}, {"type": "subtitle", "time": 26825.388, "timestamp": "07:27:05", "text": "ああ、それは"}, {"type": "subtitle", "time": 26828.628, "timestamp": "07:27:08", "text": "奇妙な。わかった。参加しようとした"}, {"type": "subtitle", "time": 26836.23, "timestamp": "07:27:16", "text": "えっと、ちょっと待って、一緒に参加してみない？"}, {"type": "subtitle", "time": 26840.548, "timestamp": "07:27:20", "text": "じゃあ、えーと、入ってみようかな"}, {"type": "subtitle", "time": 26846.07, "timestamp": "07:27:26", "text": "またオンラインでMTCですね、はい、わかりました。"}, {"type": "subtitle", "time": 26848.628, "timestamp": "07:27:28", "text": "オンラインで、それから2つのサーバーを選択します"}, {"type": "subtitle", "time": 26857.99, "timestamp": "07:27:37", "text": "はい、参加してみてください。"}, {"type": "subtitle", "time": 26860.548, "timestamp": "07:27:40", "text": "わかった。まだ読み込み中ですよね？えっと、"}, {"type": "subtitle", "time": 26862.868, "timestamp": "07:27:42", "text": "オンラインモードになっています。赤チームがあります"}, {"type": "subtitle", "time": 26869.99, "timestamp": "07:27:49", "text": "えーっと、何も表示されません"}, {"type": "subtitle", "time": 26872.628, "timestamp": "07:27:52", "text": "ここ。現在ゲーム内では、ああ、"}, {"type": "subtitle", "time": 26875.51, "timestamp": "07:27:55", "text": "Steamフレンドを招待する。待って、あなたは"}, {"type": "subtitle", "time": 26877.51, "timestamp": "07:27:57", "text": "それ？"}, {"type": "subtitle", "time": 26879.628, "timestamp": "07:27:59", "text": "ああ、わかった。わかった。ええと、5です"}]
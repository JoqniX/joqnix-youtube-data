[{"type": "subtitle", "time": 17898.948, "timestamp": "04:58:18", "text": "ああ、彼女は壊れてしまったんだ。"}, {"type": "subtitle", "time": 17902.31, "timestamp": "04:58:22", "text": "何よりも効率性を重視する。"}, {"type": "subtitle", "time": 17905.47, "timestamp": "04:58:25", "text": "彼女は打ちひしがれている"}, {"type": "subtitle", "time": 17909.27, "timestamp": "04:58:29", "text": "良い。待って、なぜ服がボロボロなの？"}, {"type": "subtitle", "time": 17912.628, "timestamp": "04:58:32", "text": "こんな風に立てるの？ああ、彼女はダメージを受けて"}, {"type": "subtitle", "time": 17915.98, "timestamp": "04:58:35", "text": "もの。ああ、しまった。"}, {"type": "subtitle", "time": 17917.83, "timestamp": "04:58:37", "text": "[音楽]"}, {"type": "subtitle", "time": 17920.788, "timestamp": "04:58:40", "text": "ああ、もし私が完全に癒えたら、ああ、見て。"}, {"type": "subtitle", "time": 17922.11, "timestamp": "04:58:42", "text": "完全に"}, {"type": "subtitle", "time": 17925.19, "timestamp": "04:58:45", "text": "クリア。彼女がダメージを受けたとき。何てことだ、"}, {"type": "subtitle", "time": 17934.03, "timestamp": "04:58:54", "text": "[音楽]"}]
[{"type": "subtitle", "time": 29400.788, "timestamp": "08:10:00", "text": "何？シャワー。待って、レベルは"}, {"type": "subtitle", "time": 29402.788, "timestamp": "08:10:02", "text": "あなた？ 6つくらいかな？プレイしました"}, {"type": "subtitle", "time": 29405.948, "timestamp": "08:10:05", "text": "実際、かなり多いです。"}, {"type": "subtitle", "time": 29408.628, "timestamp": "08:10:08", "text": "何？私がこれを紹介したんです"}, {"type": "subtitle", "time": 29412.628, "timestamp": "08:10:12", "text": "このゲームはここにあります。おお。私は私は手に入れた"}, {"type": "subtitle", "time": 29418.388, "timestamp": "08:10:18", "text": "私とパンと一緒にロクみたいに"}, {"type": "subtitle", "time": 29421.75, "timestamp": "08:10:21", "text": "そしてアルス、それからウィック氏を招待しました"}, {"type": "subtitle", "time": 29426.31, "timestamp": "08:10:26", "text": "ええ、彼は参加できます、と答えました"}, {"type": "subtitle", "time": 29429.83, "timestamp": "08:10:29", "text": "そして、彼はあなたを招待したのだと思います。私 私"}, {"type": "subtitle", "time": 29432.628, "timestamp": "08:10:32", "text": "偶然DGSTがこのゲームをプレイしているのを見かけた。私は"}, {"type": "subtitle", "time": 29433.388, "timestamp": "08:10:33", "text": "のように、"}, {"type": "subtitle", "time": 29442.15, "timestamp": "08:10:42", "text": "ほうきの柄。私はほうきの柄を手に入れたことがありません"}, {"type": "subtitle", "time": 29444.15, "timestamp": "08:10:44", "text": "まだ。"}, {"type": "subtitle", "time": 29447.51, "timestamp": "08:10:47", "text": "よし、私の小さな遊びを"}, {"type": "subtitle", "time": 29452.03, "timestamp": "08:10:52", "text": "ゲームだよ、みんな。ああ、もう行ってしまうの？うん。"}, {"type": "subtitle", "time": 29456.23, "timestamp": "08:10:56", "text": "ああ、ただいま。こんにちは。ロコは"}, {"type": "subtitle", "time": 29458.628, "timestamp": "08:10:58", "text": "去る。"}]
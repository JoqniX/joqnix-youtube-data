[{"type": "subtitle", "time": 27181.75, "timestamp": "07:33:01", "text": "メーカーから直接入手しました。"}, {"type": "subtitle", "time": 27184.388, "timestamp": "07:33:04", "text": "何てことだ。それは本当にそれは"}, {"type": "subtitle", "time": 27186.948, "timestamp": "07:33:06", "text": "本当にお買い得です。"}, {"type": "subtitle", "time": 27189.788, "timestamp": "07:33:09", "text": "これは頑丈なPだ。ほら、見てくれ。私は思った"}, {"type": "subtitle", "time": 27192.23, "timestamp": "07:33:12", "text": "250くらいで、「ああ、うまくいかない」って思った"}, {"type": "subtitle", "time": 27195.19, "timestamp": "07:33:15", "text": "「仕事のために。」いや、大丈夫だよ。頑丈だから。"}, {"type": "subtitle", "time": 27198.708, "timestamp": "07:33:18", "text": "好きになろう、この物のように、好きになろう"}, {"type": "subtitle", "time": 27201.59, "timestamp": "07:33:21", "text": "まるで上に乗って体重を支えているみたいだ。私は"}, {"type": "subtitle", "time": 27204.628, "timestamp": "07:33:24", "text": "大工仕事のようなものをしたり、"}, {"type": "subtitle", "time": 27207.91, "timestamp": "07:33:27", "text": "奇妙な理由で私はこの上に立っていた"}, {"type": "subtitle", "time": 27210.07, "timestamp": "07:33:30", "text": "テーブルを囲んで、それら全てを行い、"}, {"type": "subtitle", "time": 27212.11, "timestamp": "07:33:32", "text": "何も起こらなかったし、何も起こらなかった"}, {"type": "subtitle", "time": 27214.708, "timestamp": "07:33:34", "text": "それで戻ってきて、それから気づいた"}, {"type": "subtitle", "time": 27216.31, "timestamp": "07:33:36", "text": "待って、これは新しいテーブルです。私は"}, {"type": "subtitle", "time": 27218.27, "timestamp": "07:33:38", "text": "するべきこと"}, {"type": "subtitle", "time": 27222.628, "timestamp": "07:33:42", "text": "それは、250にしては非常に頑丈な感じだ。"}, {"type": "subtitle", "time": 27224.27, "timestamp": "07:33:44", "text": "しかしこれは"}, {"type": "subtitle", "time": 27226.868, "timestamp": "07:33:46", "text": "製造業者 直接製造業者"}, {"type": "subtitle", "time": 27229.91, "timestamp": "07:33:49", "text": "明らかに手に入らないもの"}, {"type": "subtitle", "time": 27233.59, "timestamp": "07:33:53", "text": "旅行しなければならないからです。だから私は"}, {"type": "subtitle", "time": 27235.91, "timestamp": "07:33:55", "text": "そこに行くには旅行しなければならないと思う"}, {"type": "subtitle", "time": 27239.27, "timestamp": "07:33:59", "text": "3時間。私は3時間かけてそこへ行きました"}]
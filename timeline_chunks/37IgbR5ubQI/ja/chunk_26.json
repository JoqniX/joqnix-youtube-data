[{"type": "subtitle", "time": 1560.51, "timestamp": "00:26:00", "text": "咳を認識する。わかった。"}, {"type": "subtitle", "time": 1564.11, "timestamp": "00:26:04", "text": "えっと、閉じるをクリックします。"}, {"type": "subtitle", "time": 1566.549, "timestamp": "00:26:06", "text": "右。私にさせて"}, {"type": "subtitle", "time": 1567.89, "timestamp": "00:26:07", "text": "撮影する"}, {"type": "subtitle", "time": 1586.149, "timestamp": "00:26:26", "text": "それ。わかった。どこにいるの？わかった。えっと、"}, {"type": "subtitle", "time": 1590.47, "timestamp": "00:26:30", "text": "服を着替えたりするの？"}, {"type": "subtitle", "time": 1599.47, "timestamp": "00:26:39", "text": "裸の青いキャップトップハット"}, {"type": "subtitle", "time": 1603.87, "timestamp": "00:26:43", "text": "ボブ・ロスを群衆で囲む。おお"}, {"type": "subtitle", "time": 1607.19, "timestamp": "00:26:47", "text": "私の。ああ、それらはああ、買わなければならない"}, {"type": "subtitle", "time": 1614.029, "timestamp": "00:26:54", "text": "[音楽]"}, {"type": "subtitle", "time": 1618.87, "timestamp": "00:26:58", "text": "ああ、弟よ。おい、それはパンの種類だ"}]
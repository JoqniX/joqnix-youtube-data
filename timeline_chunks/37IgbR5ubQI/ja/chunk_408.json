[{"type": "subtitle", "time": 24480.708, "timestamp": "06:48:00", "text": "いらっしゃいませ。なぜダメなの？待って、ゲームはなかった"}, {"type": "subtitle", "time": 24493.59, "timestamp": "06:48:13", "text": "みんな？なぜ？誰も教えてくれなかった理由"}, {"type": "subtitle", "time": 24511.708, "timestamp": "06:48:31", "text": "何？はい、彼らは黒人です"}, {"type": "subtitle", "time": 24532.07, "timestamp": "06:48:52", "text": "植物。それらは本当に黒人のショットによるものですか？"}, {"type": "subtitle", "time": 24533.35, "timestamp": "06:48:53", "text": "少なくとも彼らは走るのが得意だ。病気"}, {"type": "subtitle", "time": 24537.35, "timestamp": "06:48:57", "text": "それを与えてあげなさい。私が何て言ったか覚えてる？私"}, {"type": "subtitle", "time": 24539.27, "timestamp": "06:48:59", "text": "バッチのせいでもあるから、気づかなかったんだ。"}]
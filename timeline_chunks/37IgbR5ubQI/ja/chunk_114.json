[{"type": "subtitle", "time": 6851.43, "timestamp": "01:54:11", "text": "自分？私はただここに立っているだけです。"}, {"type": "subtitle", "time": 6865.55, "timestamp": "01:54:25", "text": "あなたの私は"}, {"type": "subtitle", "time": 6869.51, "timestamp": "01:54:29", "text": "警戒心を感じる。"}, {"type": "subtitle", "time": 6872.47, "timestamp": "01:54:32", "text": "私は死んだ。"}, {"type": "subtitle", "time": 6886.149, "timestamp": "01:54:46", "text": "私たちは勝利を数えるつもりです"}, {"type": "subtitle", "time": 6898.83, "timestamp": "01:54:58", "text": "カウント。そしてクソ"}]
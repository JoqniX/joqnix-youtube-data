[{"type": "subtitle", "time": 12124.469, "timestamp": "03:22:04", "text": "はい、"}, {"type": "subtitle", "time": 12140.55, "timestamp": "03:22:20", "text": "良い。それは良かった。最高だったよ。"}, {"type": "subtitle", "time": 12143.19, "timestamp": "03:22:23", "text": "あれは暑かった。それは痛みだった。"}, {"type": "subtitle", "time": 12145.96, "timestamp": "03:22:25", "text": "良い。無駄にできる時間はない。"}, {"type": "subtitle", "time": 12152.65, "timestamp": "03:22:32", "text": "ああ、大変だ。"}]
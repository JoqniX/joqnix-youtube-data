[{"type": "subtitle", "time": 5244.75, "timestamp": "01:27:24", "text": "泣け。いいえ。"}, {"type": "subtitle", "time": 5248.55, "timestamp": "01:27:28", "text": "いいえ。私は死にました。"}, {"type": "subtitle", "time": 5265.35, "timestamp": "01:27:45", "text": "ドア。どうやってそこへ行ってそれを手に入れるの？"}, {"type": "subtitle", "time": 5268.87, "timestamp": "01:27:48", "text": "もの？それはとても待って、あなたは"}]
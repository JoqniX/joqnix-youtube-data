[{"type": "subtitle", "time": 21001.03, "timestamp": "05:50:01", "text": "えっと、何か考えなきゃいけないことがあるんです。私の"}, {"type": "subtitle", "time": 21008.59, "timestamp": "05:50:08", "text": "悪い。しかし、その翻訳も間違っている。"}, {"type": "subtitle", "time": 21011.91, "timestamp": "05:50:11", "text": "だから、大丈夫だよ。大丈夫。大丈夫。私たちは"}, {"type": "subtitle", "time": 21014.548, "timestamp": "05:50:14", "text": "みんなで解決策を見つけよう。良い"}, {"type": "subtitle", "time": 21016.91, "timestamp": "05:50:16", "text": "考えてみてください"}, {"type": "subtitle", "time": 21020.868, "timestamp": "05:50:20", "text": "外。始める前に、"}, {"type": "subtitle", "time": 21032.67, "timestamp": "05:50:32", "text": "良い。あ、音声が途切れてる。あ、待って、"}, {"type": "subtitle", "time": 21038.91, "timestamp": "05:50:38", "text": "何？ちょっと待って。閉じる必要がある、"}, {"type": "subtitle", "time": 21043.75, "timestamp": "05:50:43", "text": "右？ああ、いや、後戻りできないモードに入るぞ。"}, {"type": "subtitle", "time": 21051.23, "timestamp": "05:50:51", "text": "いいえ。わかりました、翻訳機は使えません"}, {"type": "subtitle", "time": 21055.628, "timestamp": "05:50:55", "text": "今日。ノイズがおかしくなる"}, {"type": "subtitle", "time": 21059.59, "timestamp": "05:50:59", "text": "抑制。ああ、いやだ。ミシ、どうして"}]
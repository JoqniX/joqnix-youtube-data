[{"type": "subtitle", "time": 28563.19, "timestamp": "07:56:03", "text": "黙れ。トゥイッチ。"}, {"type": "subtitle", "time": 28572.548, "timestamp": "07:56:12", "text": "通話終了。奇妙な敗北だ。彼らは彼らは与えた"}, {"type": "subtitle", "time": 28574.31, "timestamp": "07:56:14", "text": "我々の敗北だ、ジャック。何をすればいいのかわからない"}, {"type": "subtitle", "time": 28576.788, "timestamp": "07:56:16", "text": "する。おい、君。私は最終決定ではありません"}, {"type": "subtitle", "time": 28585.27, "timestamp": "07:56:25", "text": "ああ、それは良いことだ。うん。おい、君。私は違います"}, {"type": "subtitle", "time": 28595.67, "timestamp": "07:56:35", "text": "よぉ、Leftをダウンロードしたい？"}, {"type": "subtitle", "time": 28604.548, "timestamp": "07:56:44", "text": "今？うん。神様、今はだめです。"}, {"type": "subtitle", "time": 28606.548, "timestamp": "07:56:46", "text": "わかった。このゲームを削除してから"}, {"type": "subtitle", "time": 28607.91, "timestamp": "07:56:47", "text": "ダウンロードします。遊びたいなら"}, {"type": "subtitle", "time": 28610.628, "timestamp": "07:56:50", "text": "明日、私は遊びたくない"}, {"type": "subtitle", "time": 28612.388, "timestamp": "07:56:52", "text": "明日。私はすでにそれを2回ストリーミングしました"}, {"type": "subtitle", "time": 28614.43, "timestamp": "07:56:54", "text": "この回数"}, {"type": "subtitle", "time": 28617.51, "timestamp": "07:56:57", "text": "週。ええと、私たちは計画していたんです"}, {"type": "subtitle", "time": 28619.75, "timestamp": "07:56:59", "text": "2人のために左へ、しかし道のように"}]
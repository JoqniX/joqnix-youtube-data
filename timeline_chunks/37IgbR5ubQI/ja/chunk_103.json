[{"type": "subtitle", "time": 6180.79, "timestamp": "01:43:00", "text": "いいえ。てっきりいたずらをしているのかと思ったよ。"}, {"type": "subtitle", "time": 6194.87, "timestamp": "01:43:14", "text": "うん。私はあなたが遊んでいると思っていました"}, {"type": "subtitle", "time": 6197.149, "timestamp": "01:43:17", "text": "貿易。とんでもない。私"}, {"type": "subtitle", "time": 6200.79, "timestamp": "01:43:20", "text": "得点した 君が得点したなんてありえない。とんでもない"}, {"type": "subtitle", "time": 6202.51, "timestamp": "01:43:22", "text": "あなたはオール"}]
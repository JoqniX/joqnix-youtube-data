[{"type": "subtitle", "time": 2828.15, "timestamp": "00:47:08", "text": "もっと。私はどうしてまだ生きているのだろう？あ、待って。"}, {"type": "subtitle", "time": 2829.67, "timestamp": "00:47:09", "text": "あ、待って。待って。待って。いや、これはまずい。"}, {"type": "subtitle", "time": 2831.109, "timestamp": "00:47:11", "text": "ダメだ。ダメだ。ダメだ。ダメだ。撃ち続けろ。保つ"}, {"type": "subtitle", "time": 2834.23, "timestamp": "00:47:14", "text": "射撃。待って。待って。私はまだ"}, {"type": "subtitle", "time": 2837.19, "timestamp": "00:47:17", "text": "私は死んでいるはずだった。"}, {"type": "subtitle", "time": 2839.91, "timestamp": "00:47:19", "text": "友達がいなくなってしまった。君の姿が見えない。私"}, {"type": "subtitle", "time": 2842.51, "timestamp": "00:47:22", "text": "あなたに会えません。私は"}, {"type": "subtitle", "time": 2847.79, "timestamp": "00:47:27", "text": "ええと、彼は亡くなりました。よし、"}, {"type": "subtitle", "time": 2850.63, "timestamp": "00:47:30", "text": "見る。ああ、それは体力ゲージですか？そうではない"}, {"type": "subtitle", "time": 2858.27, "timestamp": "00:47:38", "text": "はぁ？体力ゲージはただ盗むだけだと思う"}, {"type": "subtitle", "time": 2861.349, "timestamp": "00:47:41", "text": "抵抗力を与えるものもある"}, {"type": "subtitle", "time": 2865.19, "timestamp": "00:47:45", "text": "重力とか、そういう類のもの。うん。"}, {"type": "subtitle", "time": 2866.95, "timestamp": "00:47:46", "text": "お二人のうち、どちらがこのゲームを発見したのですか？"}, {"type": "subtitle", "time": 2870.23, "timestamp": "00:47:50", "text": "それは推薦だったのですか？見つけたよ。"}, {"type": "subtitle", "time": 2874.55, "timestamp": "00:47:54", "text": "ええ、見つけたのは、私がたくさん追加したからです"}, {"type": "subtitle", "time": 2878.71, "timestamp": "00:47:58", "text": "Stem DB というサイトから入手できる無料ゲーム。"}]
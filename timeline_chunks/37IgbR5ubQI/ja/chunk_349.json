[{"type": "subtitle", "time": 20940.31, "timestamp": "05:49:00", "text": "いいえ。どうすれば開けられますか"}, {"type": "subtitle", "time": 20944.11, "timestamp": "05:49:04", "text": "翻訳ソフト？ O"}, {"type": "subtitle", "time": 20947.23, "timestamp": "05:49:07", "text": "ええ、有効です"}, {"type": "subtitle", "time": 20950.99, "timestamp": "05:49:10", "text": "遅れ。えっと、私がやってみましょう。"}, {"type": "subtitle", "time": 20953.43, "timestamp": "05:49:13", "text": "もちろんラグは発生するだろうが、"}, {"type": "subtitle", "time": 20954.83, "timestamp": "05:49:14", "text": "病気"}, {"type": "subtitle", "time": 20961.07, "timestamp": "05:49:21", "text": "右。全体を遅らせないでください"}, {"type": "subtitle", "time": 20968.27, "timestamp": "05:49:28", "text": "CPU。"}, {"type": "subtitle", "time": 20970.03, "timestamp": "05:49:30", "text": "ああ、"}, {"type": "subtitle", "time": 20973.35, "timestamp": "05:49:33", "text": "フレーム数を数えられますか？はい、"}, {"type": "subtitle", "time": 20976.27, "timestamp": "05:49:36", "text": "君は私がどれだけ遅いかを数える"}, {"type": "subtitle", "time": 20991.59, "timestamp": "05:49:51", "text": "遅れ。動作が遅い。ああ、それは"}, {"type": "subtitle", "time": 20995.59, "timestamp": "05:49:55", "text": "遅れている。それは死につつある。おお。おお。おお。おお。"}, {"type": "subtitle", "time": 20997.31, "timestamp": "05:49:57", "text": "電源を切った方がいいでしょうか？"}]
[{"type": "subtitle", "time": 24189.15, "timestamp": "06:43:09", "text": "まるで彼が踊っているか、"}, {"type": "subtitle", "time": 24192.548, "timestamp": "06:43:12", "text": "心臓。まるで彼が"}, {"type": "subtitle", "time": 24198.708, "timestamp": "06:43:18", "text": "手。もう少しお待ちください。答えは"}, {"type": "subtitle", "time": 24201.51, "timestamp": "06:43:21", "text": "すぐそこです。ああ、それはつまり"}, {"type": "subtitle", "time": 24210.95, "timestamp": "06:43:30", "text": "私たち。ああ、あそこにいる。こんにちは"}, {"type": "subtitle", "time": 24220.548, "timestamp": "06:43:40", "text": "はい。うん。どこへ行くの？"}, {"type": "subtitle", "time": 24222.59, "timestamp": "06:43:42", "text": "これを走破するために"}, {"type": "subtitle", "time": 24225.03, "timestamp": "06:43:45", "text": "時間？私たちはただ確認したかっただけです"}, {"type": "subtitle", "time": 24226.35, "timestamp": "06:43:46", "text": "あなたは"}, {"type": "subtitle", "time": 24229.23, "timestamp": "06:43:49", "text": "一人で。"}, {"type": "subtitle", "time": 24239.11, "timestamp": "06:43:59", "text": "おじさんはあなたに悪いことは何もしませんよ。"}]
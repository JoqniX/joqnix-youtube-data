[{"type": "subtitle", "time": 25322.468, "timestamp": "07:02:02", "text": "標準。私がPCを手に入れた時"}, {"type": "subtitle", "time": 25325.03, "timestamp": "07:02:05", "text": "それは第3センターの間であり、"}, {"type": "subtitle", "time": 25327.67, "timestamp": "07:02:07", "text": "ロドラスと私はよく遊んで、それをやり込んでいました"}, {"type": "subtitle", "time": 25333.07, "timestamp": "07:02:13", "text": "多くの"}, {"type": "subtitle", "time": 25342.75, "timestamp": "07:02:22", "text": "思い出、思い出。"}, {"type": "subtitle", "time": 25347.27, "timestamp": "07:02:27", "text": "えっと、今は9時38分です。ただリラックスしたいだけ？"}, {"type": "subtitle", "time": 25350.468, "timestamp": "07:02:30", "text": "Vの準備ができるまで、ただのんびりしたい。"}, {"type": "subtitle", "time": 25355.708, "timestamp": "07:02:35", "text": "もしくは何か、あるいは私はただ戻ることができます"}]
[{"type": "subtitle", "time": 27005.75, "timestamp": "07:30:05", "text": "あなたは誰ですか？ここから出て行け。"}, {"type": "subtitle", "time": 27019.59, "timestamp": "07:30:19", "text": "あの、撃つのをやめてください。私はしなかった"}, {"type": "subtitle", "time": 27026.468, "timestamp": "07:30:26", "text": "どうやってまた壊すんだ？"}, {"type": "subtitle", "time": 27028.99, "timestamp": "07:30:28", "text": "ああ、ここは空間だ。望むならそうすることもできます"}, {"type": "subtitle", "time": 27032.07, "timestamp": "07:30:32", "text": "失恋のように与えるには、押すことができます"}, {"type": "subtitle", "time": 27034.23, "timestamp": "07:30:34", "text": "空間。おお。"}, {"type": "subtitle", "time": 27037.19, "timestamp": "07:30:37", "text": "あ、ところで、みんな、えっと、関係ないんだけど"}, {"type": "subtitle", "time": 27041.27, "timestamp": "07:30:41", "text": "ゲームへ。実店舗で買ったものですが、"}, {"type": "subtitle", "time": 27044.15, "timestamp": "07:30:44", "text": "ノートパソコン用のテーブルを買いました。その代わり"}, {"type": "subtitle", "time": 27047.03, "timestamp": "07:30:47", "text": "PCでのストリーミングについて、"}, {"type": "subtitle", "time": 27049.75, "timestamp": "07:30:49", "text": "ノートパソコン用のテーブルを買ったので"}, {"type": "subtitle", "time": 27052.708, "timestamp": "07:30:52", "text": "直立した姿勢でストリームを流す代わりに"}, {"type": "subtitle", "time": 27059.51, "timestamp": "07:30:59", "text": "残念な姿勢で"}]
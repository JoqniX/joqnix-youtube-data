[{"type": "subtitle", "time": 23465.11, "timestamp": "06:31:05", "text": "でも、次のバナーでは"}, {"type": "subtitle", "time": 23467.43, "timestamp": "06:31:07", "text": "フェニックスの女の子はすごくクールで、"}, {"type": "subtitle", "time": 23470.03, "timestamp": "06:31:10", "text": "赤毛のディオ。欲しい"}, {"type": "subtitle", "time": 23472.468, "timestamp": "06:31:12", "text": "彼女。私はすべての赤いものを集めるつもりです"}, {"type": "subtitle", "time": 23475.31, "timestamp": "06:31:15", "text": "このヘッドディオ"}, {"type": "subtitle", "time": 23477.948, "timestamp": "06:31:17", "text": "ゲーム。愛してください"}, {"type": "subtitle", "time": 23481.11, "timestamp": "06:31:21", "text": "自分。原神でさえ赤毛の女性を好まなかった"}, {"type": "subtitle", "time": 23484.708, "timestamp": "06:31:24", "text": "これくらいのディオ。このゲームだけ。これまでのところ、"}, {"type": "subtitle", "time": 23487.51, "timestamp": "06:31:27", "text": "このゲームは愛を与えているのを見たことがあるだけです"}, {"type": "subtitle", "time": 23491.99, "timestamp": "06:31:31", "text": "赤毛で、ジンジャーレッドを好む"}, {"type": "subtitle", "time": 23495.59, "timestamp": "06:31:35", "text": "頭の部分。だから私は好きなんです"}]
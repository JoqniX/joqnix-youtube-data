[{"type": "subtitle", "time": 7755.35, "timestamp": "02:09:15", "text": "くそ。 GG。"}, {"type": "subtitle", "time": 7757.43, "timestamp": "02:09:17", "text": "楽しかった。"}, {"type": "subtitle", "time": 7765.83, "timestamp": "02:09:25", "text": "お友達にも送ってください。"}, {"type": "subtitle", "time": 7776.189, "timestamp": "02:09:36", "text": "うん。うん。こんにちは"}, {"type": "subtitle", "time": 7779.189, "timestamp": "02:09:39", "text": "それもそうかもしれない。はい。はい。明日、"}, {"type": "subtitle", "time": 7780.79, "timestamp": "02:09:40", "text": "右？"}, {"type": "subtitle", "time": 7782.31, "timestamp": "02:09:42", "text": "ああ、明日ですか？ええ、土曜日です。"}, {"type": "subtitle", "time": 7784.39, "timestamp": "02:09:44", "text": "うん。"}, {"type": "subtitle", "time": 7793.83, "timestamp": "02:09:53", "text": "みなさん、さようなら。気をつけて。はい、あなた"}, {"type": "subtitle", "time": 7795.47, "timestamp": "02:09:55", "text": "あまりにも。取る"}]
[{"type": "subtitle", "time": 5784.07, "timestamp": "01:36:24", "text": "ロイオ。まだ出現していないのですか？"}, {"type": "subtitle", "time": 5791.43, "timestamp": "01:36:31", "text": "いいえ、何も問題ありません。あなたの国旗"}, {"type": "subtitle", "time": 5793.43, "timestamp": "01:36:33", "text": "出現しなかった。"}, {"type": "subtitle", "time": 5795.11, "timestamp": "01:36:35", "text": "何？"}, {"type": "subtitle", "time": 5801.35, "timestamp": "01:36:41", "text": "うん、"}, {"type": "subtitle", "time": 5804.47, "timestamp": "01:36:44", "text": "あなたのプラグが見当たりません。それはそこにある。私"}, {"type": "subtitle", "time": 5806.31, "timestamp": "01:36:46", "text": "それを見て。"}, {"type": "subtitle", "time": 5808.07, "timestamp": "01:36:48", "text": "しかし、私にはそうは思えません。どうすればいいの？"}, {"type": "subtitle", "time": 5816.03, "timestamp": "01:36:56", "text": "プラグで撮ったのか、それとも"}, {"type": "subtitle", "time": 5818.59, "timestamp": "01:36:58", "text": "何か？"}]
[{"type": "subtitle", "time": 16641.75, "timestamp": "04:37:21", "text": "すべてあなたのものです。私はあなたの近くに移植しました。"}, {"type": "subtitle", "time": 16649.99, "timestamp": "04:37:29", "text": "かかってこい。"}, {"type": "subtitle", "time": 16655.189, "timestamp": "04:37:35", "text": "未だにこのチームの攻略法が分からない。"}, {"type": "subtitle", "time": 16666.709, "timestamp": "04:37:46", "text": "センチネルよ、私に力を授けたまえ。"}, {"type": "subtitle", "time": 16668.949, "timestamp": "04:37:48", "text": "来て。たくさんのことをしているような気がする"}, {"type": "subtitle", "time": 16675.949, "timestamp": "04:37:55", "text": "ええ、私はかなりの損害を与えています。"}]
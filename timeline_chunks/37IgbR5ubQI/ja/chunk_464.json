[{"type": "subtitle", "time": 27840.15, "timestamp": "07:44:00", "text": "ここに来て。"}, {"type": "subtitle", "time": 27845.11, "timestamp": "07:44:05", "text": "何てことだ。ゲームをクリアしました。 O."}, {"type": "subtitle", "time": 27847.27, "timestamp": "07:44:07", "text": "わかった。"}, {"type": "subtitle", "time": 27850.31, "timestamp": "07:44:10", "text": "理解できましたか？私は手に入れたと思います"}, {"type": "subtitle", "time": 27854.31, "timestamp": "07:44:14", "text": "あなた。いいえ。私はまだそこにいます。はい、"}, {"type": "subtitle", "time": 27855.83, "timestamp": "07:44:15", "text": "今すぐ配信を終了してください。ありがとうございます"}, {"type": "subtitle", "time": 27859.19, "timestamp": "07:44:19", "text": "参加しますよ、皆さん。バイバイ。ああ、わかりました。それ"}, {"type": "subtitle", "time": 27863.43, "timestamp": "07:44:23", "text": "私たちにとっては短いセッションのようでした。"}, {"type": "subtitle", "time": 27865.75, "timestamp": "07:44:25", "text": "でも、楽しかったよ。私はまだ"}, {"type": "subtitle", "time": 27868.23, "timestamp": "07:44:28", "text": "君たちと遊んでるよ。心配しないで。"}, {"type": "subtitle", "time": 27871.19, "timestamp": "07:44:31", "text": "わかった。"}, {"type": "subtitle", "time": 27872.788, "timestamp": "07:44:32", "text": "ああ、配信を終了したんですね。わかった。"}, {"type": "subtitle", "time": 27875.59, "timestamp": "07:44:35", "text": "いいえ。ええ。"}, {"type": "subtitle", "time": 27877.91, "timestamp": "07:44:37", "text": "終わり。"}, {"type": "subtitle", "time": 27883.83, "timestamp": "07:44:43", "text": "埃をかぶった。何てことだ。このゲームが"}, {"type": "subtitle", "time": 27889.99, "timestamp": "07:44:49", "text": "まるでバカみたいに歪んでいる。わからない"}, {"type": "subtitle", "time": 27897.99, "timestamp": "07:44:57", "text": "わかった、戻るよ"}, {"type": "subtitle", "time": 27898.91, "timestamp": "07:44:58", "text": "そして"}]
[{"type": "subtitle", "time": 26580.15, "timestamp": "07:23:00", "text": "古代の存在。古い方の。ああ、最初のやつだ。"}, {"type": "subtitle", "time": 26585.11, "timestamp": "07:23:05", "text": "1991年の試合。わかった。自分。ドクはただ"}, {"type": "subtitle", "time": 26587.35, "timestamp": "07:23:07", "text": "まるでGoogleのサービス開始を待っているようなものだ。ドクターは大丈夫です。"}, {"type": "subtitle", "time": 26590.07, "timestamp": "07:23:10", "text": "うん。ウィキペディア。"}, {"type": "subtitle", "time": 26593.26, "timestamp": "07:23:13", "text": "はい、もちろん。もちろんだよ、ジャック。"}, {"type": "subtitle", "time": 26595.11, "timestamp": "07:23:15", "text": "[音楽]"}, {"type": "subtitle", "time": 26597.03, "timestamp": "07:23:17", "text": "ともかく。ところで、お元気ですか、ミスター。"}, {"type": "subtitle", "time": 26598.35, "timestamp": "07:23:18", "text": "ヨーコ？"}, {"type": "subtitle", "time": 26601.27, "timestamp": "07:23:21", "text": "えっと、ジョック、君も一緒にどう？私は思う"}, {"type": "subtitle", "time": 26603.59, "timestamp": "07:23:23", "text": "残り枠はあと1つくらいです。よし、どうぞ。"}, {"type": "subtitle", "time": 26605.11, "timestamp": "07:23:25", "text": "行く。私も参加します。私も参加します。行く"}, {"type": "subtitle", "time": 26606.868, "timestamp": "07:23:26", "text": "私のSteamアカウントに参加してください"}, {"type": "subtitle", "time": 26608.948, "timestamp": "07:23:28", "text": "そこには。"}, {"type": "subtitle", "time": 26613.59, "timestamp": "07:23:33", "text": "スロットは1つだけ。何"}, {"type": "subtitle", "time": 26615.67, "timestamp": "07:23:35", "text": "ランダムなものも含まれています"}, {"type": "subtitle", "time": 26617.35, "timestamp": "07:23:37", "text": "階層。"}, {"type": "subtitle", "time": 26619.59, "timestamp": "07:23:39", "text": "ああ、まったく。ちくしょう。しかし私たちは"}, {"type": "subtitle", "time": 26623.11, "timestamp": "07:23:43", "text": "単に公開を非公開にすることはできない。"}, {"type": "subtitle", "time": 26624.548, "timestamp": "07:23:44", "text": "うん、君が終わったらできるよ"}, {"type": "subtitle", "time": 26627.51, "timestamp": "07:23:47", "text": "ダウンロード部分について。ダウンロード。"}, {"type": "subtitle", "time": 26630.708, "timestamp": "07:23:50", "text": "うん。 「参加」をクリックしました。何もない"}, {"type": "subtitle", "time": 26638.11, "timestamp": "07:23:58", "text": "レオ、君もそれを持っているの？"}]
[{"type": "subtitle", "time": 11544.23, "timestamp": "03:12:24", "text": "我々が見つけた戦利品は、私の報酬には含まれません。"}, {"type": "subtitle", "time": 11546.59, "timestamp": "03:12:26", "text": "すべてあなたのものです。"}, {"type": "subtitle", "time": 11568.95, "timestamp": "03:12:48", "text": "この時点で、私は、えっと"}, {"type": "subtitle", "time": 11575.429, "timestamp": "03:12:55", "text": "地域。サイドクエストすらやらない。私"}, {"type": "subtitle", "time": 11578.309, "timestamp": "03:12:58", "text": "つまり、サイドクエストはあまりない"}]
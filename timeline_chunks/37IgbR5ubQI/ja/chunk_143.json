[{"type": "subtitle", "time": 8581.19, "timestamp": "02:23:01", "text": "[音楽]"}, {"type": "subtitle", "time": 8583.59, "timestamp": "02:23:03", "text": "我々が見つけた戦利品は、私の報酬には含まれません。"}, {"type": "subtitle", "time": 8608.63, "timestamp": "02:23:28", "text": "これを見てください。私はそれを使って"}, {"type": "subtitle", "time": 8634.83, "timestamp": "02:23:54", "text": "はい、私は"}, {"type": "subtitle", "time": 8636.59, "timestamp": "02:23:56", "text": "手に入れた"}, {"type": "subtitle", "time": 8639.15, "timestamp": "02:23:59", "text": "1つ、"}]
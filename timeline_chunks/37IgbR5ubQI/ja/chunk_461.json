[{"type": "subtitle", "time": 27660.628, "timestamp": "07:41:00", "text": "亡くなった。ああ、私の情熱の炎は消えてしまった。待って、"}, {"type": "subtitle", "time": 27662.388, "timestamp": "07:41:02", "text": "ちょっと待ってください。なぜ私はプレイしているのか"}, {"type": "subtitle", "time": 27664.388, "timestamp": "07:41:04", "text": "電話みたい？配信を終了しようと思います"}, {"type": "subtitle", "time": 27665.99, "timestamp": "07:41:05", "text": "ここにいるのは、もうストリーミングを始めているから"}, {"type": "subtitle", "time": 27668.07, "timestamp": "07:41:08", "text": "もう2時間経ちました。"}, {"type": "subtitle", "time": 27672.788, "timestamp": "07:41:12", "text": "え、マジで？ジャック？本当に？"}, {"type": "subtitle", "time": 27675.708, "timestamp": "07:41:15", "text": "おい、お前はこれを狙ってるのか？しないで"}, {"type": "subtitle", "time": 27682.868, "timestamp": "07:41:22", "text": "心配。ここに来て。こっちへ来い、ジョック。月。"}, {"type": "subtitle", "time": 27685.35, "timestamp": "07:41:25", "text": "はい、どうぞ。"}, {"type": "subtitle", "time": 27689.19, "timestamp": "07:41:29", "text": "ここに来て。ここに来て。危なかった。"}, {"type": "subtitle", "time": 27693.03, "timestamp": "07:41:33", "text": "君を手に入れるために、私は壊れるんだ。"}, {"type": "subtitle", "time": 27695.628, "timestamp": "07:41:35", "text": "ああ、ジョー。私はそれを見た"}, {"type": "subtitle", "time": 27700.11, "timestamp": "07:41:40", "text": "彼は素早かった。ああ、ラグってるみたい"}, {"type": "subtitle", "time": 27704.31, "timestamp": "07:41:44", "text": "おお。おお。ああ、危なかった。それは"}, {"type": "subtitle", "time": 27710.31, "timestamp": "07:41:50", "text": "危ないところだったね。それは"}, {"type": "subtitle", "time": 27713.75, "timestamp": "07:41:53", "text": "どこに行くの？さあ、どうだろうね。"}, {"type": "subtitle", "time": 27717.19, "timestamp": "07:41:57", "text": "私を自由にさせてください。ああ、決して"}]
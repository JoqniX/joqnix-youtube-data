[{"type": "subtitle", "time": 25022.948, "timestamp": "06:57:02", "text": "ええ、そうですね。こんにちは、アラクサ。うん。こんにちは、"}, {"type": "subtitle", "time": 25025.548, "timestamp": "06:57:05", "text": "DGST。いらっしゃいませ。"}, {"type": "subtitle", "time": 25027.75, "timestamp": "06:57:07", "text": "いらっしゃいませ。私はただそれをクリックしただけだったのでしょうか？"}, {"type": "subtitle", "time": 25029.07, "timestamp": "06:57:09", "text": "その代わり？"}, {"type": "subtitle", "time": 25031.02, "timestamp": "06:57:11", "text": "わかった。英語、"}, {"type": "subtitle", "time": 25032.43, "timestamp": "06:57:12", "text": "[音楽]"}, {"type": "subtitle", "time": 25041.23, "timestamp": "06:57:21", "text": "誕生日のお祝いの歌声。どのように"}, {"type": "subtitle", "time": 25050.83, "timestamp": "06:57:30", "text": "ハッピー"}, {"type": "subtitle", "time": 25054.23, "timestamp": "06:57:34", "text": "誕生日。あれは何だ？何？"}, {"type": "subtitle", "time": 25057.03, "timestamp": "06:57:37", "text": "来て。本当にあなたのものだと約束します"}, {"type": "subtitle", "time": 25061.03, "timestamp": "06:57:41", "text": "特別な日。いいえ、私は何もプレイしません"}, {"type": "subtitle", "time": 25063.75, "timestamp": "06:57:43", "text": "今回はゲームです。待って。"}, {"type": "subtitle", "time": 25066.468, "timestamp": "06:57:46", "text": "ああ、もうわかってるよ"}, {"type": "subtitle", "time": 25069.75, "timestamp": "06:57:49", "text": "特に予定はない。では、待っていてくれますか？"}, {"type": "subtitle", "time": 25071.67, "timestamp": "06:57:51", "text": "彼女がそれを言ったのはいつだったか知っていますか？の"}, {"type": "subtitle", "time": 25075.03, "timestamp": "06:57:55", "text": "丸一日。何？"}, {"type": "subtitle", "time": 25077.91, "timestamp": "06:57:57", "text": "君を独り占めさせてくれるかい？"}]
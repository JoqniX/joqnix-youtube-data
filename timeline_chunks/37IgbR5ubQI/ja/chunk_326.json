[{"type": "subtitle", "time": 19577.51, "timestamp": "05:26:17", "text": "あなたの。すべて彼女の仕業なのか？そういうことか？私は愛する"}, {"type": "subtitle", "time": 19581.75, "timestamp": "05:26:21", "text": "彼女の座り方がとてもスタイリッシュだ。"}, {"type": "subtitle", "time": 19595.99, "timestamp": "05:26:35", "text": "皆さん全員同時に。私は残業はしません。"}, {"type": "subtitle", "time": 19597.15, "timestamp": "05:26:37", "text": "来て"}]
[{"type": "subtitle", "time": 20103.99, "timestamp": "05:35:03", "text": "まあ、パンツデザイナーのエビを見て"}, {"type": "subtitle", "time": 20118.18, "timestamp": "05:35:18", "text": "欲望。リセットするには、最寄りのビーコンにテレポートしてください。"}, {"type": "subtitle", "time": 20145.07, "timestamp": "05:35:45", "text": "大丈夫。まあ、仕事柄仕方ないのかもしれないね。"}]
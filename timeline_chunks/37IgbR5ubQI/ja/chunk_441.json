[{"type": "subtitle", "time": 26461.27, "timestamp": "07:21:01", "text": "私のMacから。誰も私たちを癒すことはできない、"}, {"type": "subtitle", "time": 26463.83, "timestamp": "07:21:03", "text": "だから、それでいいんです。"}, {"type": "subtitle", "time": 26465.83, "timestamp": "07:21:05", "text": "ゲームはお持ちですか？持っていますか"}, {"type": "subtitle", "time": 26468.23, "timestamp": "07:21:08", "text": "ゲーム「ロード・リデンプション」？"}, {"type": "subtitle", "time": 26471.99, "timestamp": "07:21:11", "text": "いいえ、ダウンロードするだけです。わかった。"}, {"type": "subtitle", "time": 26474.07, "timestamp": "07:21:14", "text": "兄弟、今からダウンロードするよ。"}, {"type": "subtitle", "time": 26478.07, "timestamp": "07:21:18", "text": "2点を狙ってプレイしたいの？"}, {"type": "subtitle", "time": 26480.27, "timestamp": "07:21:20", "text": "しかしRoは"}, {"type": "subtitle", "time": 26484.15, "timestamp": "07:21:24", "text": "彼がプレイしていたので、私も一緒に参加しようと思ったんです。"}, {"type": "subtitle", "time": 26491.91, "timestamp": "07:21:31", "text": "わかった。まるで「こんにちは」と言っているようなものだ。"}, {"type": "subtitle", "time": 26493.19, "timestamp": "07:21:33", "text": "こんにちは。"}, {"type": "subtitle", "time": 26496.23, "timestamp": "07:21:36", "text": "誰が気にするんだ？私はできる 私はできる 私はできる 私はできる 私はできる 私は"}, {"type": "subtitle", "time": 26504.07, "timestamp": "07:21:44", "text": "待って、何やってるの？"}, {"type": "subtitle", "time": 26506.39, "timestamp": "07:21:46", "text": "ええと、私たちはRo Redemptionに期待しています。"}, {"type": "subtitle", "time": 26510.548, "timestamp": "07:21:50", "text": "右？ヴィックがダウンロードしているところです。"}, {"type": "subtitle", "time": 26514.39, "timestamp": "07:21:54", "text": "ゲームをダウンロード中です。"}, {"type": "subtitle", "time": 26517.75, "timestamp": "07:21:57", "text": "はい、これは配信用です。"}]
[{"type": "subtitle", "time": 21180.47, "timestamp": "05:53:00", "text": "アンカーはなぜストリーマーなのか"}, {"type": "subtitle", "time": 21189.67, "timestamp": "05:53:09", "text": "ああ、そうするべきだろうね。 1つ"}, {"type": "subtitle", "time": 21193.31, "timestamp": "05:53:13", "text": "2番。わかった。えっと、私は"}, {"type": "subtitle", "time": 21197.39, "timestamp": "05:53:17", "text": "こういうことを忘れてしまう。私は必要としている"}, {"type": "subtitle", "time": 21201.47, "timestamp": "05:53:21", "text": "君に、私は自分の"}, {"type": "subtitle", "time": 21204.71, "timestamp": "05:53:24", "text": "画面。ちょっと待って。"}, {"type": "subtitle", "time": 21208.51, "timestamp": "05:53:28", "text": "[音楽]"}, {"type": "subtitle", "time": 21217.35, "timestamp": "05:53:37", "text": "翻訳する。私が中国語を話せば、あなたは"}, {"type": "subtitle", "time": 21220.27, "timestamp": "05:53:40", "text": "理解できましたか？いいえ、私はGoogle翻訳を使っています"}, {"type": "subtitle", "time": 21225.548, "timestamp": "05:53:45", "text": "それ。私はコメントをGoogle翻訳します。"}, {"type": "subtitle", "time": 21228.708, "timestamp": "05:53:48", "text": "うん。うん。うん。それが私の仕事です。それで、"}, {"type": "subtitle", "time": 21231.83, "timestamp": "05:53:51", "text": "読まない方が楽だ。しかし、"}, {"type": "subtitle", "time": 21235.83, "timestamp": "05:53:55", "text": "唯一の問題は、えっと、名前ですよね、名前です"}, {"type": "subtitle", "time": 21238.628, "timestamp": "05:53:58", "text": "私ができない人"}]
[{"type": "subtitle", "time": 5820.99, "timestamp": "01:37:00", "text": "どうやって"}, {"type": "subtitle", "time": 5824.629, "timestamp": "01:37:04", "text": "君は私が"}, {"type": "subtitle", "time": 5827.51, "timestamp": "01:37:07", "text": "こっそり？"}, {"type": "subtitle", "time": 5829.99, "timestamp": "01:37:09", "text": "我が神よ。"}, {"type": "subtitle", "time": 5831.59, "timestamp": "01:37:11", "text": "今の問題は、私には見えない"}, {"type": "subtitle", "time": 5834.629, "timestamp": "01:37:14", "text": "あなたの国旗。"}, {"type": "subtitle", "time": 5837.75, "timestamp": "01:37:17", "text": "旗はそこにある。私は死んだ"}, {"type": "subtitle", "time": 5839.83, "timestamp": "01:37:19", "text": "また。でも、どうすれば手に入れられるの？"}, {"type": "subtitle", "time": 5842.07, "timestamp": "01:37:22", "text": "もし私がそれを見なかったら？さあ、行こう。さあ、行こう。"}, {"type": "subtitle", "time": 5845.43, "timestamp": "01:37:25", "text": "これはレンダリングエラーです。"}, {"type": "subtitle", "time": 5853.27, "timestamp": "01:37:33", "text": "ええ、あなたはそれを手に持っています。"}, {"type": "subtitle", "time": 5855.83, "timestamp": "01:37:35", "text": "いいえ、そのプラグは全く見えません。いいえ、"}, {"type": "subtitle", "time": 5861.189, "timestamp": "01:37:41", "text": "基地に戻ってください。うまくいくよ。"}]
[{"type": "subtitle", "time": 9038.79, "timestamp": "02:30:38", "text": "今、獲物は誰だ？"}, {"type": "subtitle", "time": 9041.91, "timestamp": "02:30:41", "text": "目を離さないでください。"}, {"type": "subtitle", "time": 9042.83, "timestamp": "02:30:42", "text": "その"}, {"type": "subtitle", "time": 9046.309, "timestamp": "02:30:46", "text": "時間。奴らを粉々に引き裂け。そうかもしれない"}]
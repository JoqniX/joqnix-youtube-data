[{"type": "subtitle", "time": 1933.19, "timestamp": "00:32:13", "text": "いいえ、それは目に見えない障壁のようなものです"}, {"type": "subtitle", "time": 1936.07, "timestamp": "00:32:16", "text": "まるで私を脇に押しやったみたいだ。"}, {"type": "subtitle", "time": 1958.23, "timestamp": "00:32:38", "text": "くそ。なぜ？私を責めるのはやめてください。そして私は"}, {"type": "subtitle", "time": 1961.269, "timestamp": "00:32:41", "text": "見えない。私にはできなかった。待って、あれは"}, {"type": "subtitle", "time": 1976.549, "timestamp": "00:32:56", "text": "私は一度だけやった。何してるの？"}, {"type": "subtitle", "time": 1979.509, "timestamp": "00:32:59", "text": "ジャンプ。待って。"}]
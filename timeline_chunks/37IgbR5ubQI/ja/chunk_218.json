[{"type": "subtitle", "time": 13082.55, "timestamp": "03:38:02", "text": "彼をどうやって後押しすればいい？"}, {"type": "subtitle", "time": 13089.59, "timestamp": "03:38:09", "text": "牙を剥き出せ。"}, {"type": "subtitle", "time": 13092.269, "timestamp": "03:38:12", "text": "容赦はしない。"}, {"type": "subtitle", "time": 13094.99, "timestamp": "03:38:14", "text": "ザップストレング。これは私たちの幕です"}, {"type": "subtitle", "time": 13098.309, "timestamp": "03:38:18", "text": "電話。私が払います。そうなると思ってたよ。破れ目"}, {"type": "subtitle", "time": 13101.19, "timestamp": "03:38:21", "text": "それらを粉々に砕く。"}]
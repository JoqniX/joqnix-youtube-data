[{"type": "subtitle", "time": 29369.31, "timestamp": "08:09:29", "text": "いいえ。"}, {"type": "subtitle", "time": 29385.15, "timestamp": "08:09:45", "text": "新しい自転車を買いました。それはああ、"}, {"type": "subtitle", "time": 29388.468, "timestamp": "08:09:48", "text": "チョッパー。リロイ・チョッパー。どのレベルが"}, {"type": "subtitle", "time": 29390.15, "timestamp": "08:09:50", "text": "あなた？"}, {"type": "subtitle", "time": 29392.628, "timestamp": "08:09:52", "text": "わからない。"}, {"type": "subtitle", "time": 29396.07, "timestamp": "08:09:56", "text": "私は釘打ちバットを手に入れた。おお、"}, {"type": "subtitle", "time": 29398.07, "timestamp": "08:09:58", "text": "私は日本刀を手に入れた。"}]
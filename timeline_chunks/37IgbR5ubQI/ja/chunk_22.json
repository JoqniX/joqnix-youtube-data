[{"type": "subtitle", "time": 1320.83, "timestamp": "00:22:00", "text": "[音楽]"}, {"type": "subtitle", "time": 1326.83, "timestamp": "00:22:06", "text": "コピー。"}, {"type": "subtitle", "time": 1329.83, "timestamp": "00:22:09", "text": "くそ。待って、猫のピューをダウンロードしたの？"}, {"type": "subtitle", "time": 1331.08, "timestamp": "00:22:11", "text": "ピューゲーム？"}, {"type": "subtitle", "time": 1335.59, "timestamp": "00:22:15", "text": "[音楽]"}, {"type": "subtitle", "time": 1340.549, "timestamp": "00:22:20", "text": "いいえ、ピューピューを手に入れましたか。"}, {"type": "subtitle", "time": 1343.47, "timestamp": "00:22:23", "text": "どうしたの？のんびりしよう。いいえ"}, {"type": "subtitle", "time": 1346.669, "timestamp": "00:22:26", "text": "心配事。何かについて話すと"}, {"type": "subtitle", "time": 1360.87, "timestamp": "00:22:40", "text": "神。もっとたくさん入れたかな？え、何？何"}, {"type": "subtitle", "time": 1361.71, "timestamp": "00:22:41", "text": "は"}, {"type": "subtitle", "time": 1364.549, "timestamp": "00:22:44", "text": "これ？そこから何かを得たようだ"}, {"type": "subtitle", "time": 1373.029, "timestamp": "00:22:53", "text": "ない。ああ、私はすべてのヘアスタイルを手に入れたよ。それで、"}, {"type": "subtitle", "time": 1375.27, "timestamp": "00:22:55", "text": "ああ、ゲームが何を提供しようとも、それは"}]
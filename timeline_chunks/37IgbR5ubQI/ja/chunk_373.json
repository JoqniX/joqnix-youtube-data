[{"type": "subtitle", "time": 22382.788, "timestamp": "06:13:02", "text": "私はぜひ訪れたい場所があります"}, {"type": "subtitle", "time": 22386.31, "timestamp": "06:13:06", "text": "まるで滝が流れ落ちるような場所"}, {"type": "subtitle", "time": 22388.788, "timestamp": "06:13:08", "text": "そしてあなたはただ"}, {"type": "subtitle", "time": 22391.03, "timestamp": "06:13:11", "text": "えーと滝の裏には"}, {"type": "subtitle", "time": 22393.99, "timestamp": "06:13:13", "text": "好きな場所、そう、まるで"}, {"type": "subtitle", "time": 22396.628, "timestamp": "06:13:16", "text": "隠れた場所とか、そういうところ。それはまさに"}, {"type": "subtitle", "time": 22400.15, "timestamp": "06:13:20", "text": "かっこよくて、可愛くて、すごくかっこいい。それは"}, {"type": "subtitle", "time": 22401.23, "timestamp": "06:13:21", "text": "それで"}, {"type": "subtitle", "time": 22407.75, "timestamp": "06:13:27", "text": "うん。はい。はい。ぜひ行きたいです"}, {"type": "subtitle", "time": 22423.43, "timestamp": "06:13:43", "text": "そこには。そうそう。それは、待って、"}, {"type": "subtitle", "time": 22427.15, "timestamp": "06:13:47", "text": "花。なぜヴェリナのように見えるのか"}, {"type": "subtitle", "time": 22430.628, "timestamp": "06:13:50", "text": "花？待って、これとこれみたいな"}, {"type": "subtitle", "time": 22432.67, "timestamp": "06:13:52", "text": "似ていると思いませんか？"}, {"type": "subtitle", "time": 22435.51, "timestamp": "06:13:55", "text": "考える？似ていると思いませんか？"}]
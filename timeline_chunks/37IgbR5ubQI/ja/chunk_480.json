[{"type": "subtitle", "time": 28803.83, "timestamp": "08:00:03", "text": "悪い。君たちはどこにいるの？私はビングです。"}, {"type": "subtitle", "time": 28812.75, "timestamp": "08:00:12", "text": "兄弟。それでも私は"}, {"type": "subtitle", "time": 28827.35, "timestamp": "08:00:27", "text": "ありえない。あれには爆笑したよ。"}, {"type": "subtitle", "time": 28829.35, "timestamp": "08:00:29", "text": "今回で7回目です"}, {"type": "subtitle", "time": 28830.19, "timestamp": "08:00:30", "text": "同じ"}, {"type": "subtitle", "time": 28833.03, "timestamp": "08:00:33", "text": "ポジションは取れたけど、何度も何度も死んでしまう"}, {"type": "subtitle", "time": 28841.31, "timestamp": "08:00:41", "text": "わあ、リックさん。"}, {"type": "subtitle", "time": 28845.51, "timestamp": "08:00:45", "text": "[笑い]"}, {"type": "subtitle", "time": 28847.03, "timestamp": "08:00:47", "text": "自分が何をしているのか、もうわからない。"}, {"type": "subtitle", "time": 28849.51, "timestamp": "08:00:49", "text": "こんにちは、ヴィック。"}, {"type": "subtitle", "time": 28852.27, "timestamp": "08:00:52", "text": "こんにちは、ジャックさん。フックしてみてはどうですか？"}, {"type": "subtitle", "time": 28855.75, "timestamp": "08:00:55", "text": "一緒に？ H、いいえ。いえいえ、結構です。だった"}]
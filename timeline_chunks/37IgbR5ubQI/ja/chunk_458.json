[{"type": "subtitle", "time": 27485.11, "timestamp": "07:38:05", "text": "わかった。適用する。わかった。わかった。みんな、やらないで"}, {"type": "subtitle", "time": 27488.788, "timestamp": "07:38:08", "text": "ゲームを開始しない。私は泣いてしまうでしょう。いいえ、あなた"}, {"type": "subtitle", "time": 27491.75, "timestamp": "07:38:11", "text": "真ん中に加わることができます。"}, {"type": "subtitle", "time": 27494.07, "timestamp": "07:38:14", "text": "ああ、わかりました。それは気にしないでください。ここに来て、"}, {"type": "subtitle", "time": 27495.59, "timestamp": "07:38:15", "text": "チャック。ああ、好きにすればいいよ。何でも好きなようにすればいい。"}, {"type": "subtitle", "time": 27497.11, "timestamp": "07:38:17", "text": "大丈夫です。今は、私たちはただ2人が好きなだけです"}, {"type": "subtitle", "time": 27503.59, "timestamp": "07:38:23", "text": "チャック、こっちへ来い。わかった。私は何をしますか？"}, {"type": "subtitle", "time": 27505.11, "timestamp": "07:38:25", "text": "オンライン。"}, {"type": "subtitle", "time": 27506.43, "timestamp": "07:38:26", "text": "うん、ただ行くだけ"}, {"type": "subtitle", "time": 27509.59, "timestamp": "07:38:29", "text": "オンライン。そしてそこに私の名前を見かけたら、"}, {"type": "subtitle", "time": 27511.03, "timestamp": "07:38:31", "text": "つまり、あなたは正しいということです"}, {"type": "subtitle", "time": 27515.03, "timestamp": "07:38:35", "text": "ロビー。 H. ああ、しまった。"}, {"type": "subtitle", "time": 27517.27, "timestamp": "07:38:37", "text": "ああ、わかりました。どうでも。私も同じことをした"}, {"type": "subtitle", "time": 27519.99, "timestamp": "07:38:39", "text": "もの。"}, {"type": "subtitle", "time": 27523.11, "timestamp": "07:38:43", "text": "何てことだ。あなたを殺さなければならないかもしれない。おお"}, {"type": "subtitle", "time": 27525.51, "timestamp": "07:38:45", "text": "私の。"}, {"type": "subtitle", "time": 27528.19, "timestamp": "07:38:48", "text": "ああ、なんてこった。おお"}, {"type": "subtitle", "time": 27536.15, "timestamp": "07:38:56", "text": "この脳は、"}, {"type": "subtitle", "time": 27538.548, "timestamp": "07:38:58", "text": "運転。サーバーを探す。ああ、それを着る"}]
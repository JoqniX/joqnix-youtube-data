[{"type": "subtitle", "time": 4153.51, "timestamp": "01:09:13", "text": "私はあなたが星座だと思っていましたが、"}, {"type": "subtitle", "time": 4157.55, "timestamp": "01:09:17", "text": "君は今や流れ星だ。私は"}, {"type": "subtitle", "time": 4160.55, "timestamp": "01:09:20", "text": "星座。私はスウェーデンのスターになれる"}, {"type": "subtitle", "time": 4164.39, "timestamp": "01:09:24", "text": "私もそう思います。わからない。いいえ、"}, {"type": "subtitle", "time": 4166.95, "timestamp": "01:09:26", "text": "星座は"}, {"type": "subtitle", "time": 4170.95, "timestamp": "01:09:30", "text": "どこへ行ってはいけないのか。ああ、私は"}, {"type": "subtitle", "time": 4173.87, "timestamp": "01:09:33", "text": "ジャンプするはず"}, {"type": "subtitle", "time": 4176.309, "timestamp": "01:09:36", "text": "下。うん、理解するのは難しいね"}]
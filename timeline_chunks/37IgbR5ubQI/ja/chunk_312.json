[{"type": "subtitle", "time": 18731.31, "timestamp": "05:12:11", "text": "こんにちは。暗い"}, {"type": "subtitle", "time": 18743.948, "timestamp": "05:12:23", "text": "誰もいない、あなたたち全員"}, {"type": "subtitle", "time": 18746.31, "timestamp": "05:12:26", "text": "まったく。来て。来て。来て。来る"}, {"type": "subtitle", "time": 18748.39, "timestamp": "05:12:28", "text": "の上。来て。行く。"}, {"type": "subtitle", "time": 18750.708, "timestamp": "05:12:30", "text": "来て。"}, {"type": "subtitle", "time": 18760.91, "timestamp": "05:12:40", "text": "の上。今、私は報告しなければならない"}, {"type": "subtitle", "time": 18762.51, "timestamp": "05:12:42", "text": "書く。"}, {"type": "subtitle", "time": 18765.59, "timestamp": "05:12:45", "text": "センチネル。答えて下さい。"}, {"type": "subtitle", "time": 18768.55, "timestamp": "05:12:48", "text": "究極の"}, {"type": "subtitle", "time": 18776.35, "timestamp": "05:12:56", "text": "全て"}]
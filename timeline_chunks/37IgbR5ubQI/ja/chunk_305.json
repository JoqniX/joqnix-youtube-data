[{"type": "subtitle", "time": 18322.11, "timestamp": "05:05:22", "text": "闇の勢力が迫り来る"}, {"type": "subtitle", "time": 18326.708, "timestamp": "05:05:26", "text": "警備員。他者を守ることは私の義務だ。いいえ"}, {"type": "subtitle", "time": 18351.628, "timestamp": "05:05:51", "text": "[音楽]"}, {"type": "subtitle", "time": 18356.708, "timestamp": "05:05:56", "text": "ああ、私の理解はそれ以上です。大丈夫。"}]
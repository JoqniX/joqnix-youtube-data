[{"type": "subtitle", "time": 21921.27, "timestamp": "06:05:21", "text": "[音楽]"}, {"type": "subtitle", "time": 21924.548, "timestamp": "06:05:24", "text": "えっと、オプトの意見を尋ねることはありますか？"}, {"type": "subtitle", "time": 21925.23, "timestamp": "06:05:25", "text": "の"}, {"type": "subtitle", "time": 21933.83, "timestamp": "06:05:33", "text": "よし、それから彼女は突然選ばれた"}, {"type": "subtitle", "time": 21935.91, "timestamp": "06:05:35", "text": "彼女にとって、それはとても辛いことだろう。うん、"}, {"type": "subtitle", "time": 21938.35, "timestamp": "06:05:38", "text": "どうやら"}, {"type": "subtitle", "time": 21941.91, "timestamp": "06:05:41", "text": "おそらく厳しい"}, {"type": "subtitle", "time": 21945.19, "timestamp": "06:05:45", "text": "現実があなたに突きつけられるようなもの"}, {"type": "subtitle", "time": 21949.19, "timestamp": "06:05:49", "text": "彼は私たちを次の王子にしようとした、あるいは"}, {"type": "subtitle", "time": 21953.67, "timestamp": "06:05:53", "text": "町の救世主か何か"}, {"type": "subtitle", "time": 21959.708, "timestamp": "06:05:59", "text": "[音楽]"}]
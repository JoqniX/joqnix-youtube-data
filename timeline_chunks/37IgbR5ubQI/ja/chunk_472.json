[{"type": "subtitle", "time": 28325.19, "timestamp": "07:52:05", "text": "あなたの武器は？ええ、私は"}, {"type": "subtitle", "time": 28327.51, "timestamp": "07:52:07", "text": "もし私が死んだら、武器を使わせてください。ええ、そうですね。わかった。おお、"}, {"type": "subtitle", "time": 28329.99, "timestamp": "07:52:09", "text": "うん。あなたはしない。"}, {"type": "subtitle", "time": 28332.948, "timestamp": "07:52:12", "text": "ああ神様、この大きな、えっと、なんて言うんだっけ"}, {"type": "subtitle", "time": 28343.11, "timestamp": "07:52:23", "text": "ああ、私はまだ終わりには程遠い"}, {"type": "subtitle", "time": 28345.83, "timestamp": "07:52:25", "text": "ちなみに、ゲームです。"}, {"type": "subtitle", "time": 28347.91, "timestamp": "07:52:27", "text": "私はちょうど中間地点あたりにいるような感じです。つまり、"}, {"type": "subtitle", "time": 28350.948, "timestamp": "07:52:30", "text": "70%くらいは達成しているよ。うん、大丈夫だよ。"}, {"type": "subtitle", "time": 28353.27, "timestamp": "07:52:33", "text": "大丈夫。わかった。ありがとう。ありがとう、涼子。"}, {"type": "subtitle", "time": 28361.75, "timestamp": "07:52:41", "text": "この男と交代するたびに、"}, {"type": "subtitle", "time": 28363.67, "timestamp": "07:52:43", "text": "私が振り向いた瞬間、ああ、なんてことだ。どこ"}, {"type": "subtitle", "time": 28366.388, "timestamp": "07:52:46", "text": "私はそうでしょうか？"}, {"type": "subtitle", "time": 28369.11, "timestamp": "07:52:49", "text": "ところで、ジャックは私を撃とうとしているの？"}, {"type": "subtitle", "time": 28371.51, "timestamp": "07:52:51", "text": "ああ、敵がいる。そこには"}, {"type": "subtitle", "time": 28373.91, "timestamp": "07:52:53", "text": "敵。なんてこった。"}, {"type": "subtitle", "time": 28375.75, "timestamp": "07:52:55", "text": "何を考えていたんだ？私は何者？"}, {"type": "subtitle", "time": 28378.23, "timestamp": "07:52:58", "text": "はぁ？"}]
[{"type": "subtitle", "time": 28444.468, "timestamp": "07:54:04", "text": "終わり。ああ、めちゃくちゃ面白いよ、"}, {"type": "subtitle", "time": 28447.59, "timestamp": "07:54:07", "text": "男。わからない。スパイダーマン。私は行きます"}, {"type": "subtitle", "time": 28454.07, "timestamp": "07:54:14", "text": "あなたの様子は分かりません。何かあるかな"}, {"type": "subtitle", "time": 28456.708, "timestamp": "07:54:16", "text": "グラップリングフック？ああ、なんてことだ、私は飛んでいる。"}, {"type": "subtitle", "time": 28458.51, "timestamp": "07:54:18", "text": "私は来るつもりです"}, {"type": "subtitle", "time": 28462.07, "timestamp": "07:54:22", "text": "あなた。私はします"}, {"type": "subtitle", "time": 28464.19, "timestamp": "07:54:24", "text": "私は行きます"}, {"type": "subtitle", "time": 28478.75, "timestamp": "07:54:38", "text": "D. ああ、彼はまだそれを持っています"}, {"type": "subtitle", "time": 28495.99, "timestamp": "07:54:55", "text": "誰かが私のゲームを見て、人々が"}, {"type": "subtitle", "time": 28497.67, "timestamp": "07:54:57", "text": "「どうやって"}]
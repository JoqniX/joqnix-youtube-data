[{"type": "subtitle", "time": 26520.788, "timestamp": "07:22:00", "text": "とにかく、とにかく、とにかく、私たちは皆生きている。こんにちは"}, {"type": "subtitle", "time": 26522.39, "timestamp": "07:22:02", "text": "みんな。ミクソです。おかえりなさい"}, {"type": "subtitle", "time": 26525.59, "timestamp": "07:22:05", "text": "チャンネルは、ああ私の"}, {"type": "subtitle", "time": 26529.27, "timestamp": "07:22:09", "text": "まったく、まったく、声。うわぁ。おぞましい。"}, {"type": "subtitle", "time": 26531.51, "timestamp": "07:22:11", "text": "『ロード・ラッシュ』は素晴らしすぎた。そうです。そうだった"}, {"type": "subtitle", "time": 26534.07, "timestamp": "07:22:14", "text": "まるで良質なゲームのように。まるであなたがもし私が"}, {"type": "subtitle", "time": 26536.31, "timestamp": "07:22:16", "text": "今すぐそのゲームをプレイしてみて、最高だよ"}, {"type": "subtitle", "time": 26540.708, "timestamp": "07:22:20", "text": "懐かしいゲーム。 『ロードラッシュ2』があった。"}, {"type": "subtitle", "time": 26542.75, "timestamp": "07:22:22", "text": "ええ、ロードラッシュは"}, {"type": "subtitle", "time": 26545.35, "timestamp": "07:22:25", "text": "実際、有害なゲームの一つだ。そんな"}, {"type": "subtitle", "time": 26548.628, "timestamp": "07:22:28", "text": "人気のゲーム。はい、そうでした。かなり"}, {"type": "subtitle", "time": 26554.39, "timestamp": "07:22:34", "text": "レオ、私たちが毒性について気にするのは誰ですか"}, {"type": "subtitle", "time": 26558.628, "timestamp": "07:22:38", "text": "楽しんでいますか？それは、えっと、私にはできません"}, {"type": "subtitle", "time": 26560.868, "timestamp": "07:22:40", "text": "わからないよ。私は同意できません"}, {"type": "subtitle", "time": 26563.75, "timestamp": "07:22:43", "text": "それ。おいおいおい。あなたが"}, {"type": "subtitle", "time": 26566.39, "timestamp": "07:22:46", "text": "楽しい、何もかもどうでもいい。楽しんでいるようですね。"}, {"type": "subtitle", "time": 26568.628, "timestamp": "07:22:48", "text": "それが全てだ。"}, {"type": "subtitle", "time": 26571.468, "timestamp": "07:22:51", "text": "まあ、あなたの言う通りかもしれませんね。ありました"}, {"type": "subtitle", "time": 26575.43, "timestamp": "07:22:55", "text": "ローは楽しんでいる。"}, {"type": "subtitle", "time": 26577.43, "timestamp": "07:22:57", "text": "何？いいえ、私たちは"}]
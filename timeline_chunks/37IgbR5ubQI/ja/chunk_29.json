[{"type": "subtitle", "time": 1741.559, "timestamp": "00:29:01", "text": "はぁ？ はぁ？私は今、死んだの？"}, {"type": "subtitle", "time": 1745.52, "timestamp": "00:29:05", "text": "はぁ？私は今、死んだの？ プロからのアドバイス。しないで"}, {"type": "subtitle", "time": 1748.039, "timestamp": "00:29:08", "text": "プロからのアドバイス。しないで 最悪だ。"}, {"type": "subtitle", "time": 1750.679, "timestamp": "00:29:10", "text": "最悪だ。 何？おや、別のプレイヤーだ。"}, {"type": "subtitle", "time": 1755.12, "timestamp": "00:29:15", "text": "何？おや、別のプレイヤーだ。 いいえ、私たちだけです。こんにちは。"}, {"type": "subtitle", "time": 1788.789, "timestamp": "00:29:48", "text": "こんにちは。ああ、実は私、死にかけてるんです。待って、"}, {"type": "subtitle", "time": 1789.79, "timestamp": "00:29:49", "text": "待って、待って、待って、"}, {"type": "subtitle", "time": 1793.47, "timestamp": "00:29:53", "text": "[笑い]"}]
[{"type": "subtitle", "time": 13170.55, "timestamp": "03:39:30", "text": "ああ、なんてことだ、彼はそれをリセットした。一体どういうことだ？"}, {"type": "subtitle", "time": 13172.389, "timestamp": "03:39:32", "text": "この際、私がやった方が良い"}, {"type": "subtitle", "time": 13185.99, "timestamp": "03:39:45", "text": "もう我慢できない。迷子になる。"}, {"type": "subtitle", "time": 13188.67, "timestamp": "03:39:48", "text": "10倍にして返済します。任せてください"}, {"type": "subtitle", "time": 13193.389, "timestamp": "03:39:53", "text": "自分。ねえ、私は自分を移植した"}]
[{"type": "subtitle", "time": 4380.11, "timestamp": "01:13:00", "text": "[音楽]"}, {"type": "subtitle", "time": 4382.27, "timestamp": "01:13:02", "text": "試す。待って、私は"}, {"type": "subtitle", "time": 4385.229, "timestamp": "01:13:05", "text": "死にかけている。誰が？どこ？"}, {"type": "subtitle", "time": 4414.81, "timestamp": "01:13:34", "text": "ソーダ？ソーダ。お気に入り"}, {"type": "subtitle", "time": 4420.35, "timestamp": "01:13:40", "text": "ソーダ"}, {"type": "subtitle", "time": 4424.79, "timestamp": "01:13:44", "text": "具体的に言うと、味が良ければ"}, {"type": "subtitle", "time": 4432.229, "timestamp": "01:13:52", "text": "ずっとあなたを撮影し続けている。"}, {"type": "subtitle", "time": 4434.95, "timestamp": "01:13:54", "text": "どうやって生きているんだ？"}, {"type": "subtitle", "time": 4438.07, "timestamp": "01:13:58", "text": "どこにいるの？"}]
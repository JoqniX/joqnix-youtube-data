[{"type": "subtitle", "time": 26942.388, "timestamp": "07:29:02", "text": "はい。しかし、ジャックはそこにいる。はい。はい。"}, {"type": "subtitle", "time": 26945.27, "timestamp": "07:29:05", "text": "家族向けですが、"}, {"type": "subtitle", "time": 26947.91, "timestamp": "07:29:07", "text": "私は人々の頭を叩いている。つまり、えっと"}, {"type": "subtitle", "time": 26949.83, "timestamp": "07:29:09", "text": "うん"}, {"type": "subtitle", "time": 26951.83, "timestamp": "07:29:11", "text": "痛い。ええ、彼は人を殴っていますよ。その"}, {"type": "subtitle", "time": 26954.628, "timestamp": "07:29:14", "text": "大丈夫。"}, {"type": "subtitle", "time": 26956.23, "timestamp": "07:29:16", "text": "冗談でしょう。彼は人々の"}, {"type": "subtitle", "time": 26964.468, "timestamp": "07:29:24", "text": "ええ、私たちはレースの真っ最中でした。"}, {"type": "subtitle", "time": 26968.07, "timestamp": "07:29:28", "text": "それでは、最初から始めましょう。"}, {"type": "subtitle", "time": 26970.23, "timestamp": "07:29:30", "text": "トラブルに巻き込まれるかな"}, {"type": "subtitle", "time": 26973.19, "timestamp": "07:29:33", "text": "意図的にそうしている。君たちが待っていたら"}, {"type": "subtitle", "time": 26975.59, "timestamp": "07:29:35", "text": "3分くらい、"}, {"type": "subtitle", "time": 26977.59, "timestamp": "07:29:37", "text": "君たちが3分間待ってくれるなら"}, {"type": "subtitle", "time": 26979.35, "timestamp": "07:29:39", "text": "分、うん、そうなると思うよ"}, {"type": "subtitle", "time": 26982.548, "timestamp": "07:29:42", "text": "2試合で完了。心配しないで。うん。"}, {"type": "subtitle", "time": 26985.11, "timestamp": "07:29:45", "text": "どういう意味ですか？ 15くらいまで上がる"}, {"type": "subtitle", "time": 26987.43, "timestamp": "07:29:47", "text": "20分くらいかな。何てことだ。"}, {"type": "subtitle", "time": 26991.868, "timestamp": "07:29:51", "text": "どうでも。私は死んだ。私は死んだ。"}, {"type": "subtitle", "time": 26995.35, "timestamp": "07:29:55", "text": "はい。誰がそれらの銃を使っているのか？なんてこった。"}]
[{"type": "subtitle", "time": 22588.948, "timestamp": "06:16:28", "text": "パパ。私たちは特別な人材を探しています"}, {"type": "subtitle", "time": 22597.08, "timestamp": "06:16:37", "text": "1つ。自然界ではめったに見られない、ですって？"}, {"type": "subtitle", "time": 22607.03, "timestamp": "06:16:47", "text": "構造物を見ると、"}, {"type": "subtitle", "time": 22610.19, "timestamp": "06:16:50", "text": "数種類の花が"}, {"type": "subtitle", "time": 22614.13, "timestamp": "06:16:54", "text": "似ている。おお。"}]
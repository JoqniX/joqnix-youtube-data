[{"type": "subtitle", "time": 29461.27, "timestamp": "08:11:01", "text": "大丈夫だよ。申し訳ありません。私は"}, {"type": "subtitle", "time": 29464.31, "timestamp": "08:11:04", "text": "ごめん。大丈夫。大丈夫。遊べるよ"}, {"type": "subtitle", "time": 29471.11, "timestamp": "08:11:11", "text": "バイバイ。"}, {"type": "subtitle", "time": 29478.07, "timestamp": "08:11:18", "text": "とにかく、ショクニクスさん。"}, {"type": "subtitle", "time": 29480.948, "timestamp": "08:11:20", "text": "はい。"}, {"type": "subtitle", "time": 29482.788, "timestamp": "08:11:22", "text": "えっと、私はしたくない"}, {"type": "subtitle", "time": 29485.11, "timestamp": "08:11:25", "text": "このゲームをプレイしてください。しかし、動作が遅い。"}, {"type": "subtitle", "time": 29486.868, "timestamp": "08:11:26", "text": "楽しいゲームだけど、バカみたいに"}, {"type": "subtitle", "time": 29490.868, "timestamp": "08:11:30", "text": "動作が遅い。いいえ、そうではありません。では、切り替えたいですか？"}, {"type": "subtitle", "time": 29493.11, "timestamp": "08:11:33", "text": "J氏が制作するゲームを変えたいのですか？"}]
[{"type": "subtitle", "time": 28621.75, "timestamp": "07:57:01", "text": "挽回は土壇場で訪れた"}, {"type": "subtitle", "time": 28623.31, "timestamp": "07:57:03", "text": "終わり。ほら、"}, {"type": "subtitle", "time": 28627.75, "timestamp": "07:57:07", "text": "何？遊べますよ。一発、一発"}, {"type": "subtitle", "time": 28632.15, "timestamp": "07:57:12", "text": "殺す。この男は誰だ？大横はどこ？"}, {"type": "subtitle", "time": 28634.15, "timestamp": "07:57:14", "text": "ええ、参加します。はい、そうします"}, {"type": "subtitle", "time": 28635.67, "timestamp": "07:57:15", "text": "参加する。"}, {"type": "subtitle", "time": 28639.23, "timestamp": "07:57:19", "text": "いいえ、私たちの場合と同じです。"}, {"type": "subtitle", "time": 28642.31, "timestamp": "07:57:22", "text": "うん、もっと楽しいよ。"}, {"type": "subtitle", "time": 28644.31, "timestamp": "07:57:24", "text": "いいえ、気にしません。はい、どうぞ。私は"}, {"type": "subtitle", "time": 28648.468, "timestamp": "07:57:28", "text": "ここ。私は彼らが誰なのか知らない。"}, {"type": "subtitle", "time": 28652.07, "timestamp": "07:57:32", "text": "さて、どのチームに入るの？"}, {"type": "subtitle", "time": 28654.19, "timestamp": "07:57:34", "text": "私は"}, {"type": "subtitle", "time": 28659.51, "timestamp": "07:57:39", "text": "行く。待って、武器は変更できない。"}, {"type": "subtitle", "time": 28661.11, "timestamp": "07:57:41", "text": "ここで武器を選んでから"}, {"type": "subtitle", "time": 28662.91, "timestamp": "07:57:42", "text": "変更することはできません"}, {"type": "subtitle", "time": 28669.35, "timestamp": "07:57:49", "text": "わかった。教室の中に入ります。"}, {"type": "subtitle", "time": 28672.708, "timestamp": "07:57:52", "text": "私は憂鬱な気分だと思う。"}, {"type": "subtitle", "time": 28675.75, "timestamp": "07:57:55", "text": "じゃあ、赤色にしたい。"}, {"type": "subtitle", "time": 28678.708, "timestamp": "07:57:58", "text": "はい、私もその時に行きます。"}]
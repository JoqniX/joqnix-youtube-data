[{"type": "subtitle", "time": 2171.75, "timestamp": "00:36:11", "text": "消えた。復活した。それは"}, {"type": "subtitle", "time": 2182.109, "timestamp": "00:36:22", "text": "くそ。"}, {"type": "subtitle", "time": 2195.31, "timestamp": "00:36:35", "text": "あなた。"}, {"type": "subtitle", "time": 2198.39, "timestamp": "00:36:38", "text": "くそ。実際のスキルレベルがあります"}, {"type": "subtitle", "time": 2200.19, "timestamp": "00:36:40", "text": "これか？"}, {"type": "subtitle", "time": 2201.87, "timestamp": "00:36:41", "text": "ニース。"}, {"type": "subtitle", "time": 2204.63, "timestamp": "00:36:44", "text": "ロビーが"}, {"type": "subtitle", "time": 2206.87, "timestamp": "00:36:46", "text": "見知らぬ人々。それはどうなるだろうか"}, {"type": "subtitle", "time": 2208.71, "timestamp": "00:36:48", "text": "なれ。"}, {"type": "subtitle", "time": 2211.23, "timestamp": "00:36:51", "text": "それがバスケットボールだ、"}, {"type": "subtitle", "time": 2214.55, "timestamp": "00:36:54", "text": "考える。ええ、プライベートか"}]
[{"type": "subtitle", "time": 1690.029, "timestamp": "00:28:10", "text": "ニース。くそ。なぜこのゲームはこんなに過疎化してしまったのか？"}, {"type": "subtitle", "time": 1704.71, "timestamp": "00:28:24", "text": "ピュー。おっしゃることは分かります。"}, {"type": "subtitle", "time": 1707.51, "timestamp": "00:28:27", "text": "え、何？"}, {"type": "subtitle", "time": 1709.029, "timestamp": "00:28:29", "text": "うん。"}, {"type": "subtitle", "time": 1711.47, "timestamp": "00:28:31", "text": "待って、ゲーム内にマイクがあるか、"}, {"type": "subtitle", "time": 1731.99, "timestamp": "00:28:51", "text": "カーラー？それは排尿用だと思います。"}, {"type": "subtitle", "time": 1735.269, "timestamp": "00:28:55", "text": "いいえ、マウスカーソルです。左に動くと"}, {"type": "subtitle", "time": 1739.789, "timestamp": "00:28:59", "text": "そう、それは私の母に渡る。はぁ？"}]
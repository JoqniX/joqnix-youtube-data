[{"type": "subtitle", "time": 21962.03, "timestamp": "06:06:02", "text": "何かが実行している"}, {"type": "subtitle", "time": 21994.708, "timestamp": "06:06:34", "text": "えっと、Jが私にJを探しに行くように頼んだ"}, {"type": "subtitle", "time": 22003.11, "timestamp": "06:06:43", "text": "時間。待って、ノーフォール荒野は"}, {"type": "subtitle", "time": 22015.83, "timestamp": "06:06:55", "text": "そこには別の監督者がいる"}, {"type": "subtitle", "time": 22018.11, "timestamp": "06:06:58", "text": "疲労が蓄積している。"}]
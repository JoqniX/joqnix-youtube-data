[{"type": "subtitle", "time": 16560.269, "timestamp": "04:36:00", "text": "少し"}, {"type": "subtitle", "time": 16561.869, "timestamp": "04:36:01", "text": "難しい、"}, {"type": "subtitle", "time": 16577.23, "timestamp": "04:36:17", "text": "ブルーバードは私の"}, {"type": "subtitle", "time": 16580.709, "timestamp": "04:36:20", "text": "皇帝の名の下に救済を戦争で"}, {"type": "subtitle", "time": 16592.029, "timestamp": "04:36:32", "text": "私は頭を殴る綴りができます"}, {"type": "subtitle", "time": 16600.551, "timestamp": "04:36:40", "text": "自分。さあ、私のもとへ。"}, {"type": "subtitle", "time": 16601.709, "timestamp": "04:36:41", "text": "ちょうど"}, {"type": "subtitle", "time": 16605.99, "timestamp": "04:36:45", "text": "傷。かすり傷だけです。"}, {"type": "subtitle", "time": 16608.029, "timestamp": "04:36:48", "text": "それは、"}, {"type": "subtitle", "time": 16618.629, "timestamp": "04:36:58", "text": "すべてあなたのものです。来て。"}]
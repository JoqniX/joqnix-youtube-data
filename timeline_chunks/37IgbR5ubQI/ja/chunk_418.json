[{"type": "subtitle", "time": 25091.15, "timestamp": "06:58:11", "text": "VA。"}, {"type": "subtitle", "time": 25095.35, "timestamp": "06:58:15", "text": "くそ。待って、彼らは"}, {"type": "subtitle", "time": 25098.59, "timestamp": "06:58:18", "text": "ボイスラインが本当にたくさん。"}, {"type": "subtitle", "time": 25105.43, "timestamp": "06:58:25", "text": "いいね。龍が如くゼロが"}, {"type": "subtitle", "time": 25114.57, "timestamp": "06:58:34", "text": "顔。こんにちは、私たちは、えーと"}, {"type": "subtitle", "time": 25117.788, "timestamp": "06:58:37", "text": "[音楽]"}, {"type": "subtitle", "time": 25120.548, "timestamp": "06:58:40", "text": "中国語を勉強しているので、中国語（北京語）です。私は必要としている"}, {"type": "subtitle", "time": 25126.15, "timestamp": "06:58:46", "text": "これ。待って、彼女はそれをどう言うだろうか"}, {"type": "subtitle", "time": 25129.19, "timestamp": "06:58:49", "text": "中国語（北京語）？そうねぇ。そしてそれは"}, {"type": "subtitle", "time": 25132.31, "timestamp": "06:58:52", "text": "理解はできるけど、彼女はどうやって"}, {"type": "subtitle", "time": 25137.05, "timestamp": "06:58:57", "text": "言ってみて？どこですか？しかし"}]
[{"type": "subtitle", "time": 2946.63, "timestamp": "00:49:06", "text": "くそ、でもそうだよ、そうなるはずなんだ"}, {"type": "subtitle", "time": 2959.19, "timestamp": "00:49:19", "text": "もっと地図があればいいのに。"}, {"type": "subtitle", "time": 2962.87, "timestamp": "00:49:22", "text": "がある。がある。ああ、それなら試してみましょう"}, {"type": "subtitle", "time": 2966.19, "timestamp": "00:49:26", "text": "ただし、地図は異なります。退出したい"}, {"type": "subtitle", "time": 2973.48, "timestamp": "00:49:33", "text": "何？マウス培養は"}, {"type": "subtitle", "time": 2977.39, "timestamp": "00:49:37", "text": "[音楽]"}, {"type": "subtitle", "time": 2979.309, "timestamp": "00:49:39", "text": "戻る。"}, {"type": "subtitle", "time": 2994.32, "timestamp": "00:49:54", "text": "よし、生きよう。"}]
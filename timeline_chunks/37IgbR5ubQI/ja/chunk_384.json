[{"type": "subtitle", "time": 23040.75, "timestamp": "06:24:00", "text": "行く。ああ、私の陰のリネンがヒット"}, {"type": "subtitle", "time": 23043.43, "timestamp": "06:24:03", "text": "難しい。ああ、言い忘れてたけど"}, {"type": "subtitle", "time": 23045.83, "timestamp": "06:24:05", "text": "彼女の能力を完全に引き出せなかった。タイトルでさえ"}, {"type": "subtitle", "time": 23049.03, "timestamp": "06:24:09", "text": "才能がないので、"}, {"type": "subtitle", "time": 23051.75, "timestamp": "06:24:11", "text": "する。"}, {"type": "subtitle", "time": 23055.51, "timestamp": "06:24:15", "text": "ボスをアンロックするだけでいいので、"}, {"type": "subtitle", "time": 23067.868, "timestamp": "06:24:27", "text": "[音楽]"}]
[{"type": "subtitle", "time": 28273.43, "timestamp": "07:51:13", "text": "ゲーム。イエス・キリスト。何てことだ。ああ、"}, {"type": "subtitle", "time": 28275.19, "timestamp": "07:51:15", "text": "神。"}, {"type": "subtitle", "time": 28283.67, "timestamp": "07:51:23", "text": "動作が遅い。神よ、何をしているのですか？その"}, {"type": "subtitle", "time": 28287.03, "timestamp": "07:51:27", "text": "私にその瞬間を与えてくれない、私はそれを回す"}, {"type": "subtitle", "time": 28296.35, "timestamp": "07:51:36", "text": "死亡する。ああ、"}, {"type": "subtitle", "time": 28299.27, "timestamp": "07:51:39", "text": "神。わかった、ただゲームを落ち着かせているだけだ。来る"}, {"type": "subtitle", "time": 28307.51, "timestamp": "07:51:47", "text": "もうない。"}, {"type": "subtitle", "time": 28311.27, "timestamp": "07:51:51", "text": "いや、まさかそんなことをするなんて。"}, {"type": "subtitle", "time": 28315.59, "timestamp": "07:51:55", "text": "何てことだ。ゲーム、ゲーム。一体何なんだ？私"}, {"type": "subtitle", "time": 28317.27, "timestamp": "07:51:57", "text": "亡くなった。わかった、少なくともわかった、わかった"}, {"type": "subtitle", "time": 28318.948, "timestamp": "07:51:58", "text": "何？少なくとも私は失うのが好きではない"}]
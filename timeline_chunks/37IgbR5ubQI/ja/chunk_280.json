[{"type": "subtitle", "time": 16800.628, "timestamp": "04:40:00", "text": "でも、出発する前にちょっと"}, {"type": "subtitle", "time": 16811.75, "timestamp": "04:40:11", "text": "出発する直前。農作業に行かせてください"}, {"type": "subtitle", "time": 16829.99, "timestamp": "04:40:29", "text": "それでは、今日は"}, {"type": "subtitle", "time": 16839.708, "timestamp": "04:40:39", "text": "今。だから、これが必要だ"}, {"type": "subtitle", "time": 16843.11, "timestamp": "04:40:43", "text": "右。お土産屋。私は思う"}, {"type": "subtitle", "time": 16845.628, "timestamp": "04:40:45", "text": "お土産店は"}]
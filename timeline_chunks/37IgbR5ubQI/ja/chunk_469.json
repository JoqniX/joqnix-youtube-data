[{"type": "subtitle", "time": 28144.788, "timestamp": "07:49:04", "text": "えっと、今ちょっと変わってるんです。"}, {"type": "subtitle", "time": 28148.388, "timestamp": "07:49:08", "text": "君を殴ったよ。ダメです。えっと、私は死んでしまいました。しないで"}, {"type": "subtitle", "time": 28150.708, "timestamp": "07:49:10", "text": "それについて心配してください。"}, {"type": "subtitle", "time": 28153.59, "timestamp": "07:49:13", "text": "パイプ爆弾をぶち込むしかない。さあ行こう、"}, {"type": "subtitle", "time": 28165.51, "timestamp": "07:49:25", "text": "それは何ですか？失った。"}, {"type": "subtitle", "time": 28168.388, "timestamp": "07:49:28", "text": "チョークさん、私はかなり射撃の腕がいいんですよ。何"}, {"type": "subtitle", "time": 28171.51, "timestamp": "07:49:31", "text": "一体どういうことだ？はい、大丈夫です。心配しないで、"}, {"type": "subtitle", "time": 28173.75, "timestamp": "07:49:33", "text": "みんな。これは2人用のゲームです。その"}, {"type": "subtitle", "time": 28176.548, "timestamp": "07:49:36", "text": "3人用のゲームではない。"}, {"type": "subtitle", "time": 28179.67, "timestamp": "07:49:39", "text": "えっと、一番後ろのポケットに入れましたか？"}, {"type": "subtitle", "time": 28182.31, "timestamp": "07:49:42", "text": "はい、それは最低ランクです。わからない"}, {"type": "subtitle", "time": 28184.31, "timestamp": "07:49:44", "text": "もうどうすればいいのか。それから、えーと、"}, {"type": "subtitle", "time": 28186.868, "timestamp": "07:49:46", "text": "明らかに、プリセットを変更してください。試してみてください"}, {"type": "subtitle", "time": 28189.03, "timestamp": "07:49:49", "text": "そうしてください。それは、ええと、あなたにもっと"}, {"type": "subtitle", "time": 28191.99, "timestamp": "07:49:51", "text": "フレーム。私もそうしました。"}, {"type": "subtitle", "time": 28195.11, "timestamp": "07:49:55", "text": "OBSの設定画面を開いてください。"}, {"type": "subtitle", "time": 28196.788, "timestamp": "07:49:56", "text": "私はそうは思わない、"}, {"type": "subtitle", "time": 28198.788, "timestamp": "07:49:58", "text": "OBSの設定で何かを行う間"}]
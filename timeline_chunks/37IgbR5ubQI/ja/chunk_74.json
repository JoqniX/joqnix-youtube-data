[{"type": "subtitle", "time": 4449.229, "timestamp": "01:14:09", "text": "いいえ、何も当たっていません。"}, {"type": "subtitle", "time": 4471.35, "timestamp": "01:14:31", "text": "あ、待って。銃撃事件に送る"}, {"type": "subtitle", "time": 4477.83, "timestamp": "01:14:37", "text": "もうやめます。これで終わりにします。文字が多すぎる。"}, {"type": "subtitle", "time": 4480.229, "timestamp": "01:14:40", "text": "こんにちは。気をつけて。気をつけて。心配ない。"}, {"type": "subtitle", "time": 4481.669, "timestamp": "01:14:41", "text": "来てくれてありがとう"}, {"type": "subtitle", "time": 4485.02, "timestamp": "01:14:45", "text": "ゲームをおすすめする。本当に感謝しています。"}, {"type": "subtitle", "time": 4492.06, "timestamp": "01:14:52", "text": "うん。ああ、どうして"}, {"type": "subtitle", "time": 4494.99, "timestamp": "01:14:54", "text": "[音楽]"}]
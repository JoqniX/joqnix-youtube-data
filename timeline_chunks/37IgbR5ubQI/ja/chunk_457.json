[{"type": "subtitle", "time": 27425.91, "timestamp": "07:37:05", "text": "うん、うん、OBSがクラッシュしたと思う。"}, {"type": "subtitle", "time": 27430.548, "timestamp": "07:37:10", "text": "なんてこった。 OB が壊れました。"}, {"type": "subtitle", "time": 27433.43, "timestamp": "07:37:13", "text": "まあ、受け取れるといいんだけど"}, {"type": "subtitle", "time": 27437.27, "timestamp": "07:37:17", "text": "ストリームを再開する"}, {"type": "subtitle", "time": 27439.51, "timestamp": "07:37:19", "text": "新しいものを作っています。ああ、みんな行ってしまった。"}, {"type": "subtitle", "time": 27441.75, "timestamp": "07:37:21", "text": "とても素晴らしい。彼らは私たちに加わると思う"}, {"type": "subtitle", "time": 27454.75, "timestamp": "07:37:34", "text": "クラシック"}, {"type": "subtitle", "time": 27457.388, "timestamp": "07:37:37", "text": "チョッパー。"}, {"type": "subtitle", "time": 27462.91, "timestamp": "07:37:42", "text": "装甲"}, {"type": "subtitle", "time": 27466.67, "timestamp": "07:37:46", "text": "マノビル。マンティック・マニーがこれらを手に入れた"}, {"type": "subtitle", "time": 27469.43, "timestamp": "07:37:49", "text": "800年代と"}, {"type": "subtitle", "time": 27470.948, "timestamp": "07:37:50", "text": "わかった、"}, {"type": "subtitle", "time": 27472.948, "timestamp": "07:37:52", "text": "赤チームに入ってください。私は青色で行きます"}, {"type": "subtitle", "time": 27476.708, "timestamp": "07:37:56", "text": "チーム。わかった。えっと"}]
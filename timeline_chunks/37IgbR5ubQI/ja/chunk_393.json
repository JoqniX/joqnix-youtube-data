[{"type": "subtitle", "time": 23589.19, "timestamp": "06:33:09", "text": "外。でも、これならできると思う。吹く"}, {"type": "subtitle", "time": 23615.51, "timestamp": "06:33:35", "text": "分。確認しなければならないことがある。なるほど"}, {"type": "subtitle", "time": 23618.948, "timestamp": "06:33:38", "text": "確か黄色い何かだったと思う。何"}, {"type": "subtitle", "time": 23635.91, "timestamp": "06:33:55", "text": "それ？待って、スーパーチャットみたいなものかな、それとも"}]
[{"type": "subtitle", "time": 4323.39, "timestamp": "01:12:03", "text": "ジョー、あなたのお気に入りは？"}, {"type": "subtitle", "time": 4326.149, "timestamp": "01:12:06", "text": "ソーダ？お気に入りのソーダは何ですか？"}, {"type": "subtitle", "time": 4339.07, "timestamp": "01:12:19", "text": "何もない。"}, {"type": "subtitle", "time": 4348.55, "timestamp": "01:12:28", "text": "またね。幸運を。かすかな希望の光。おお、"}, {"type": "subtitle", "time": 4349.55, "timestamp": "01:12:29", "text": "それは"}, {"type": "subtitle", "time": 4355.31, "timestamp": "01:12:35", "text": "チェック。"}, {"type": "subtitle", "time": 4360.149, "timestamp": "01:12:40", "text": "見て。かすかな希望の光。ああ、それは無料です"}, {"type": "subtitle", "time": 4362.91, "timestamp": "01:12:42", "text": "ああ、もう持ってるよ"}, {"type": "subtitle", "time": 4365.75, "timestamp": "01:12:45", "text": "図書館。それは「なんてことだ」です。それはホラーだ"}, {"type": "subtitle", "time": 4372.04, "timestamp": "01:12:52", "text": "私はそうしました"}, {"type": "subtitle", "time": 4378.81, "timestamp": "01:12:58", "text": "できました"}]
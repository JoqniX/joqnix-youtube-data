[{"type": "subtitle", "time": 5784.07, "timestamp": "01:36:24", "text": "Roio. Did you not spawn yet?"}, {"type": "subtitle", "time": 5791.43, "timestamp": "01:36:31", "text": "No, there's nothing wrong. Your flag"}, {"type": "subtitle", "time": 5793.43, "timestamp": "01:36:33", "text": "didn't spawn."}, {"type": "subtitle", "time": 5795.11, "timestamp": "01:36:35", "text": "What?"}, {"type": "subtitle", "time": 5801.35, "timestamp": "01:36:41", "text": "Yeah,"}, {"type": "subtitle", "time": 5804.47, "timestamp": "01:36:44", "text": "I don't see your plug. It is there. I"}, {"type": "subtitle", "time": 5806.31, "timestamp": "01:36:46", "text": "see it."}, {"type": "subtitle", "time": 5808.07, "timestamp": "01:36:48", "text": "But I don't see it. How am I supposed to"}, {"type": "subtitle", "time": 5816.03, "timestamp": "01:36:56", "text": "Well, did you take it on plug or"}, {"type": "subtitle", "time": 5818.59, "timestamp": "01:36:58", "text": "something?"}]
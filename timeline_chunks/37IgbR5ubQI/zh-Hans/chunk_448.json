[{"type": "subtitle", "time": 26882.35, "timestamp": "07:28:02", "text": "分钟。还有5分钟。我们"}, {"type": "subtitle", "time": 26886.628, "timestamp": "07:28:06", "text": "一切顺利。哦，我到了。 5分钟。我"}, {"type": "subtitle", "time": 26888.788, "timestamp": "07:28:08", "text": "知道。你想加入哪支队伍？我是"}, {"type": "subtitle", "time": 26892.628, "timestamp": "07:28:12", "text": "如果我……我会变蓝。哦好的。我会变红"}, {"type": "subtitle", "time": 26895.708, "timestamp": "07:28:15", "text": "然后。我感到忧郁吗？我不知道"}, {"type": "subtitle", "time": 26899.11, "timestamp": "07:28:19", "text": "我就是。哦，是的。你是 你是"}, {"type": "subtitle", "time": 26903.35, "timestamp": "07:28:23", "text": "你脸红了。不，只有两个。"}, {"type": "subtitle", "time": 26905.59, "timestamp": "07:28:25", "text": "这是什么游戏？我的天哪，这是"}, {"type": "subtitle", "time": 26912.788, "timestamp": "07:28:32", "text": "我看到人。那是警察吗？是的，"}, {"type": "subtitle", "time": 26915.67, "timestamp": "07:28:35", "text": "那是警察。是的，我可以杀警察。"}, {"type": "subtitle", "time": 26919.51, "timestamp": "07:28:39", "text": "我的天啊，我的天啊，我杀了"}, {"type": "subtitle", "time": 26923.19, "timestamp": "07:28:43", "text": "他。乔克，别说那些话。别说"}, {"type": "subtitle", "time": 26926.91, "timestamp": "07:28:46", "text": "那些话。上帝，"}, {"type": "subtitle", "time": 26931.91, "timestamp": "07:28:51", "text": "不要直播。耶稣基督。哦，对不起。"}, {"type": "subtitle", "time": 26936.99, "timestamp": "07:28:56", "text": "我的天啊。我也在直播。好的。"}]
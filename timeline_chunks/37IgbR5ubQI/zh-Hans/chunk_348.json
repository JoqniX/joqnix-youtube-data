[{"type": "subtitle", "time": 20882.708, "timestamp": "05:48:02", "text": "呃，蹦床，呃，特朗普，长号，或者"}, {"type": "subtitle", "time": 20885.91, "timestamp": "05:48:05", "text": "可以通过视觉方式进行调节的东西"}, {"type": "subtitle", "time": 20889.75, "timestamp": "05:48:09", "text": "并且可以清楚地听到语音调制之类的东西"}, {"type": "subtitle", "time": 20894.31, "timestamp": "05:48:14", "text": "以及所有的一切。所以，真是太好了……"}, {"type": "subtitle", "time": 20896.07, "timestamp": "05:48:16", "text": "呃，那个东西。我不知道你是否可以"}, {"type": "subtitle", "time": 20898.23, "timestamp": "05:48:18", "text": "你可以把它当成游戏，但它真的很有趣。我"}, {"type": "subtitle", "time": 20900.27, "timestamp": "05:48:20", "text": "我考虑过这样做。或许我们会这么做。"}, {"type": "subtitle", "time": 20904.59, "timestamp": "05:48:24", "text": "明天。是的。你好。你好，Niha。"}, {"type": "subtitle", "time": 20907.03, "timestamp": "05:48:27", "text": "妮哈。你今天过得怎么样？"}, {"type": "subtitle", "time": 20910.31, "timestamp": "05:48:30", "text": "我很好。你今天怎么样？我是"}, {"type": "subtitle", "time": 20918.788, "timestamp": "05:48:38", "text": "今天。呃，我刚才……呃，休息了一下，呃，不是。"}, {"type": "subtitle", "time": 20921.67, "timestamp": "05:48:41", "text": "早餐，晚餐。"}, {"type": "subtitle", "time": 20926.15, "timestamp": "05:48:46", "text": "我吃过晚饭了，我现在在这里，我"}, {"type": "subtitle", "time": 20929.03, "timestamp": "05:48:49", "text": "宝贝们，我已经准备好尝试一切了！"}, {"type": "subtitle", "time": 20930.59, "timestamp": "05:48:50", "text": "今天。"}, {"type": "subtitle", "time": 20936.83, "timestamp": "05:48:56", "text": "是的。我的直播快要结束了，电脑端。"}]
[{"type": "subtitle", "time": 1805.95, "timestamp": "00:30:05", "text": "[音乐]"}, {"type": "subtitle", "time": 1813.83, "timestamp": "00:30:13", "text": "天哪，这太有趣了。乐趣。"}, {"type": "subtitle", "time": 1825.669, "timestamp": "00:30:25", "text": "想象。不，不，不，不，不，不，不。如何"}, {"type": "subtitle", "time": 1828.789, "timestamp": "00:30:28", "text": "你怎么能这样把我推开？"}, {"type": "subtitle", "time": 1858.87, "timestamp": "00:30:58", "text": "耶。但你不能自己发射或"}]
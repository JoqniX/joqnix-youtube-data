[{"type": "subtitle", "time": 28273.43, "timestamp": "07:51:13", "text": "游戏。耶稣基督。我的天啊。哦，我的天"}, {"type": "subtitle", "time": 28275.19, "timestamp": "07:51:15", "text": "上帝。"}, {"type": "subtitle", "time": 28283.67, "timestamp": "07:51:23", "text": "卡顿。上帝啊，这究竟是怎么回事？它是"}, {"type": "subtitle", "time": 28287.03, "timestamp": "07:51:27", "text": "没给我那个我转身的瞬间"}, {"type": "subtitle", "time": 28296.35, "timestamp": "07:51:36", "text": "死亡。哦，我的天"}, {"type": "subtitle", "time": 28299.27, "timestamp": "07:51:39", "text": "上帝。好了，我冷静下来玩游戏。来"}, {"type": "subtitle", "time": 28307.51, "timestamp": "07:51:47", "text": "不再。"}, {"type": "subtitle", "time": 28311.27, "timestamp": "07:51:51", "text": "不，你没有那样做。"}, {"type": "subtitle", "time": 28315.59, "timestamp": "07:51:55", "text": "我的天啊。游戏游戏。这到底是什么怪事？我"}, {"type": "subtitle", "time": 28317.27, "timestamp": "07:51:57", "text": "死了。好吧，至少你知道"}, {"type": "subtitle", "time": 28318.948, "timestamp": "07:51:58", "text": "什么？至少我不喜欢失去我的"}]
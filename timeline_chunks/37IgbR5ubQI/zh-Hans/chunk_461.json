[{"type": "subtitle", "time": 27660.628, "timestamp": "07:41:00", "text": "死了。天哪，我的火焰消失了。等待，"}, {"type": "subtitle", "time": 27662.388, "timestamp": "07:41:02", "text": "稍等片刻。我为什么要玩这个"}, {"type": "subtitle", "time": 27664.388, "timestamp": "07:41:04", "text": "比如打电话？我想我会结束直播。"}, {"type": "subtitle", "time": 27665.99, "timestamp": "07:41:05", "text": "因为我已经在直播了，所以就在这里直播了。"}, {"type": "subtitle", "time": 27668.07, "timestamp": "07:41:08", "text": "已经过了两个小时了。"}, {"type": "subtitle", "time": 27672.788, "timestamp": "07:41:12", "text": "等等，真的吗，杰克？真的吗？"}, {"type": "subtitle", "time": 27675.708, "timestamp": "07:41:15", "text": "哟，你打算追这个吗？不"}, {"type": "subtitle", "time": 27682.868, "timestamp": "07:41:22", "text": "担心。过来。过来，乔克。密苏里州"}, {"type": "subtitle", "time": 27685.35, "timestamp": "07:41:25", "text": "对，就是这样。"}, {"type": "subtitle", "time": 27689.19, "timestamp": "07:41:29", "text": "过来。过来。好险。"}, {"type": "subtitle", "time": 27693.03, "timestamp": "07:41:33", "text": "我挣脱束缚，就是为了能见到你。"}, {"type": "subtitle", "time": 27695.628, "timestamp": "07:41:35", "text": "我的天哪，乔。我看到了"}, {"type": "subtitle", "time": 27700.11, "timestamp": "07:41:40", "text": "他动作很快。哦，我的天，我好像卡顿了。"}, {"type": "subtitle", "time": 27704.31, "timestamp": "07:41:44", "text": "哦。哦。哦，好险。那是一个"}, {"type": "subtitle", "time": 27710.31, "timestamp": "07:41:50", "text": "真是千钧一发。那是"}, {"type": "subtitle", "time": 27713.75, "timestamp": "07:41:53", "text": "你要去哪里？我不知道，伙计。"}, {"type": "subtitle", "time": 27717.19, "timestamp": "07:41:57", "text": "让我自由吧，让我自由吧。哦，绝不"}]
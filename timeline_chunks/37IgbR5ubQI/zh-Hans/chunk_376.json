[{"type": "subtitle", "time": 22588.948, "timestamp": "06:16:28", "text": "爸爸。我们正在寻找一位特别的人"}, {"type": "subtitle", "time": 22597.08, "timestamp": "06:16:37", "text": "一。你说，这种现象在自然界中很少见？"}, {"type": "subtitle", "time": 22607.03, "timestamp": "06:16:47", "text": "观察一个结构时，会发现"}, {"type": "subtitle", "time": 22610.19, "timestamp": "06:16:50", "text": "似乎只有少数几种花。"}, {"type": "subtitle", "time": 22614.13, "timestamp": "06:16:54", "text": "相似的。哦。"}]
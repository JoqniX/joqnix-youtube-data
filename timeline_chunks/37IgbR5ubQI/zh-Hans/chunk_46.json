[{"type": "subtitle", "time": 2761.27, "timestamp": "00:46:01", "text": "等待。我必须这么做。是的。是的。现在"}, {"type": "subtitle", "time": 2763.39, "timestamp": "00:46:03", "text": "你得喜欢邦克"}, {"type": "subtitle", "time": 2765.309, "timestamp": "00:46:05", "text": "我。来"}, {"type": "subtitle", "time": 2769.109, "timestamp": "00:46:09", "text": "这里。最上面。过来。等等，等等，"}, {"type": "subtitle", "time": 2776.95, "timestamp": "00:46:16", "text": "是的。是的。试试看能不能开枪打我。哦，等等。"}, {"type": "subtitle", "time": 2780.589, "timestamp": "00:46:20", "text": "不，这太过分了。等等，等等，等等。"}, {"type": "subtitle", "time": 2784.55, "timestamp": "00:46:24", "text": "哦，慢慢来。有点像起床装扮。哦，等等。"}, {"type": "subtitle", "time": 2787.43, "timestamp": "00:46:27", "text": "我得跳下去再回来。我是"}, {"type": "subtitle", "time": 2796.91, "timestamp": "00:46:36", "text": "一秒钟。我还会再来这里。"}, {"type": "subtitle", "time": 2798.91, "timestamp": "00:46:38", "text": "好的。"}, {"type": "subtitle", "time": 2808.71, "timestamp": "00:46:48", "text": "[笑声]"}, {"type": "subtitle", "time": 2811.51, "timestamp": "00:46:51", "text": "好的。奄奄一息。"}]
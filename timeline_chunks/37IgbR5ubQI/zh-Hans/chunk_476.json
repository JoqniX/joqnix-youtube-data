[{"type": "subtitle", "time": 28563.19, "timestamp": "07:56:03", "text": "住口。抽搐。"}, {"type": "subtitle", "time": 28572.548, "timestamp": "07:56:12", "text": "通话结束。一场莫名其妙的失利。他们给了"}, {"type": "subtitle", "time": 28574.31, "timestamp": "07:56:14", "text": "我们输了，杰克。我不知道该怎么办"}, {"type": "subtitle", "time": 28576.788, "timestamp": "07:56:16", "text": "做。嘿，伙计。我不是，我不是最终的"}, {"type": "subtitle", "time": 28585.27, "timestamp": "07:56:25", "text": "哦，那很好。是的。嘿，伙计。我不是"}, {"type": "subtitle", "time": 28595.67, "timestamp": "07:56:35", "text": "哟，你想下载 Left 吗？"}, {"type": "subtitle", "time": 28604.548, "timestamp": "07:56:44", "text": "现在？是的。天哪，现在不行。"}, {"type": "subtitle", "time": 28606.548, "timestamp": "07:56:46", "text": "好的。我会删除这个游戏，然后我"}, {"type": "subtitle", "time": 28607.91, "timestamp": "07:56:47", "text": "将会下载。如果你想玩"}, {"type": "subtitle", "time": 28610.628, "timestamp": "07:56:50", "text": "明天，我们可以……我不想玩"}, {"type": "subtitle", "time": 28612.388, "timestamp": "07:56:52", "text": "明天。我已经看过两遍了。"}, {"type": "subtitle", "time": 28614.43, "timestamp": "07:56:54", "text": "这次"}, {"type": "subtitle", "time": 28617.51, "timestamp": "07:56:57", "text": "星期。嗯，当时我们就像在计划一样。"}, {"type": "subtitle", "time": 28619.75, "timestamp": "07:56:59", "text": "对于左边的两人来说，但就像这条路一样"}]
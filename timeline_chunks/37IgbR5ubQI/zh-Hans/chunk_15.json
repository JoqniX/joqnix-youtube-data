[{"type": "subtitle", "time": 900.629, "timestamp": "00:15:00", "text": "你看到的这块大石头。"}, {"type": "subtitle", "time": 903.829, "timestamp": "00:15:03", "text": "你不在。这里。我没看见你。"}, {"type": "subtitle", "time": 906.389, "timestamp": "00:15:06", "text": "然后呢？嗯？"}, {"type": "subtitle", "time": 908.949, "timestamp": "00:15:08", "text": "老兄，我真搞不懂这游戏。等待。让我"}, {"type": "subtitle", "time": 909.87, "timestamp": "00:15:09", "text": "加入"}, {"type": "subtitle", "time": 920.189, "timestamp": "00:15:20", "text": "次要的。我是不是按了F键？不是。为什么是"}, {"type": "subtitle", "time": 924.79, "timestamp": "00:15:24", "text": "它？这游戏真是太烂了。"}, {"type": "subtitle", "time": 927.67, "timestamp": "00:15:27", "text": "我的意思是，如果你读过描述的话，"}, {"type": "subtitle", "time": 930.47, "timestamp": "00:15:30", "text": "那你就不能怪它了。是的，没错。"}, {"type": "subtitle", "time": 931.949, "timestamp": "00:15:31", "text": "真的，"}, {"type": "subtitle", "time": 934.269, "timestamp": "00:15:34", "text": "真的。我"}, {"type": "subtitle", "time": 938.629, "timestamp": "00:15:38", "text": "想想，让我重新开始吧。"}, {"type": "subtitle", "time": 942.71, "timestamp": "00:15:42", "text": "呃，我们试试加入一个公共世界吧。"}, {"type": "subtitle", "time": 944.79, "timestamp": "00:15:44", "text": "选择应该有一个"}, {"type": "subtitle", "time": 954.31, "timestamp": "00:15:54", "text": "选择其他人将要出现的位置"}]
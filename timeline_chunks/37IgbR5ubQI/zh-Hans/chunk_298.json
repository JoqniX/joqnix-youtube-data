[{"type": "subtitle", "time": 17898.948, "timestamp": "04:58:18", "text": "我的天哪，她崩溃了。"}, {"type": "subtitle", "time": 17902.31, "timestamp": "04:58:22", "text": "效率至上。"}, {"type": "subtitle", "time": 17905.47, "timestamp": "04:58:25", "text": "她心碎了"}, {"type": "subtitle", "time": 17909.27, "timestamp": "04:58:29", "text": "好的。等等，为什么衣服这么破烂？"}, {"type": "subtitle", "time": 17912.628, "timestamp": "04:58:32", "text": "这样向上？哦，她受到了伤害"}, {"type": "subtitle", "time": 17915.98, "timestamp": "04:58:35", "text": "东西。哦，糟糕。"}, {"type": "subtitle", "time": 17917.83, "timestamp": "04:58:37", "text": "[音乐]"}, {"type": "subtitle", "time": 17920.788, "timestamp": "04:58:40", "text": "哦，如果我痊愈了，哦，看。"}, {"type": "subtitle", "time": 17922.11, "timestamp": "04:58:42", "text": "它完全"}, {"type": "subtitle", "time": 17925.19, "timestamp": "04:58:45", "text": "清除。当她受到伤害时。我的天啊，"}, {"type": "subtitle", "time": 17934.03, "timestamp": "04:58:54", "text": "[音乐]"}]
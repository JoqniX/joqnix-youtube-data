[{"type": "subtitle", "time": 28880.388, "timestamp": "08:01:20", "text": "这场“美美爆炸”到底是怎么回事？"}, {"type": "subtitle", "time": 28882.75, "timestamp": "08:01:22", "text": "啊，是的。我有一根管子"}, {"type": "subtitle", "time": 28912.628, "timestamp": "08:01:52", "text": "该死。服务器平衡团队。哦，它"}, {"type": "subtitle", "time": 28915.83, "timestamp": "08:01:55", "text": "重新平衡它。"}, {"type": "subtitle", "time": 28917.628, "timestamp": "08:01:57", "text": "让我啪啪啪"}]
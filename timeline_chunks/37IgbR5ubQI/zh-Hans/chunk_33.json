[{"type": "subtitle", "time": 1983.35, "timestamp": "00:33:03", "text": "把那个发上去。是的，没有跳板。"}, {"type": "subtitle", "time": 1986.47, "timestamp": "00:33:06", "text": "跳板没反应，哦，现在它有了"}, {"type": "subtitle", "time": 1987.83, "timestamp": "00:33:07", "text": "已生成。"}, {"type": "subtitle", "time": 1994.43, "timestamp": "00:33:14", "text": "跳跃。"}, {"type": "subtitle", "time": 2023.149, "timestamp": "00:33:43", "text": "[音乐]"}, {"type": "subtitle", "time": 2027.789, "timestamp": "00:33:47", "text": "不。如果我……我……我也"}, {"type": "subtitle", "time": 2030.35, "timestamp": "00:33:50", "text": "死了？我"}]
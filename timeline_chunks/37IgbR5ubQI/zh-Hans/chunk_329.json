[{"type": "subtitle", "time": 19750.23, "timestamp": "05:29:10", "text": "看来我们得好好教训一下某些人了。"}, {"type": "subtitle", "time": 19752.23, "timestamp": "05:29:12", "text": "大约。"}, {"type": "subtitle", "time": 19754.35, "timestamp": "05:29:14", "text": "快点"}, {"type": "subtitle", "time": 19757.788, "timestamp": "05:29:17", "text": "我。快点"}, {"type": "subtitle", "time": 19787.91, "timestamp": "05:29:47", "text": "即使你身处那个小小的空间里"}, {"type": "subtitle", "time": 19790.868, "timestamp": "05:29:50", "text": "角落，"}, {"type": "subtitle", "time": 19793.03, "timestamp": "05:29:53", "text": "我一定会来杀了他。如此快乐"}]
[{"type": "subtitle", "time": 1933.19, "timestamp": "00:32:13", "text": "不，就像一道无形的屏障。"}, {"type": "subtitle", "time": 1936.07, "timestamp": "00:32:16", "text": "就像把我推到一边一样。"}, {"type": "subtitle", "time": 1958.23, "timestamp": "00:32:38", "text": "该死。为什么？别再逼我了。我"}, {"type": "subtitle", "time": 1961.269, "timestamp": "00:32:41", "text": "无形的。我做不到。等等，那是……"}, {"type": "subtitle", "time": 1976.549, "timestamp": "00:32:56", "text": "我只做过一次。你在干什么？"}, {"type": "subtitle", "time": 1979.509, "timestamp": "00:32:59", "text": "跳。等待。"}]
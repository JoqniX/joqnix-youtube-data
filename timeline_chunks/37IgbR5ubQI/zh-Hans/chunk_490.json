[{"type": "subtitle", "time": 29400.788, "timestamp": "08:10:00", "text": "什么？淋浴间。等等，这是什么级别？"}, {"type": "subtitle", "time": 29402.788, "timestamp": "08:10:02", "text": "你？六个左右？我玩过。"}, {"type": "subtitle", "time": 29405.948, "timestamp": "08:10:05", "text": "实际上非常喜欢。"}, {"type": "subtitle", "time": 29408.628, "timestamp": "08:10:08", "text": "什么？是我引入了这个概念。"}, {"type": "subtitle", "time": 29412.628, "timestamp": "08:10:12", "text": "游戏就在这里。哇。我 我 我 得到"}, {"type": "subtitle", "time": 29418.388, "timestamp": "08:10:18", "text": "就像我和面包一起用 Roku 看电视一样"}, {"type": "subtitle", "time": 29421.75, "timestamp": "08:10:21", "text": "然后我邀请了阿鲁斯先生，以及维克先生。"}, {"type": "subtitle", "time": 29426.31, "timestamp": "08:10:26", "text": "他说，是的，他可以加入。"}, {"type": "subtitle", "time": 29429.83, "timestamp": "08:10:29", "text": "然后我想是他邀请了你。我 我"}, {"type": "subtitle", "time": 29432.628, "timestamp": "08:10:32", "text": "偶然看到DGST在玩这个游戏。我当时"}, {"type": "subtitle", "time": 29433.388, "timestamp": "08:10:33", "text": "喜欢，"}, {"type": "subtitle", "time": 29442.15, "timestamp": "08:10:42", "text": "扫帚柄。我从来没拿到过扫帚柄"}, {"type": "subtitle", "time": 29444.15, "timestamp": "08:10:44", "text": "然而。"}, {"type": "subtitle", "time": 29447.51, "timestamp": "08:10:47", "text": "好吧，我会玩我的小游戏"}, {"type": "subtitle", "time": 29452.03, "timestamp": "08:10:52", "text": "游戏，伙计们。哦，你要走了？是的。"}, {"type": "subtitle", "time": 29456.23, "timestamp": "08:10:56", "text": "我的天啊，我回来了。你好。 Roco是"}, {"type": "subtitle", "time": 29458.628, "timestamp": "08:10:58", "text": "离开。"}]
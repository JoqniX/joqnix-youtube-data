[{"type": "subtitle", "time": 27181.75, "timestamp": "07:33:01", "text": "直接从厂家进货。"}, {"type": "subtitle", "time": 27184.388, "timestamp": "07:33:04", "text": "我的天啊。那真是……那真是"}, {"type": "subtitle", "time": 27186.948, "timestamp": "07:33:06", "text": "性价比很高。"}, {"type": "subtitle", "time": 27189.788, "timestamp": "07:33:09", "text": "这是一个结实的P。瞧，伙计。我当时想"}, {"type": "subtitle", "time": 27192.23, "timestamp": "07:33:12", "text": "比如，250，我就想，“啊，不行了。”"}, {"type": "subtitle", "time": 27195.19, "timestamp": "07:33:15", "text": "能用。” 不，伙计。它很结实。它它它"}, {"type": "subtitle", "time": 27198.708, "timestamp": "07:33:18", "text": "就像这东西可以像威尔一样"}, {"type": "subtitle", "time": 27201.59, "timestamp": "07:33:21", "text": "就像扛着我的重量一样，就像在上面一样。我当时"}, {"type": "subtitle", "time": 27204.628, "timestamp": "07:33:24", "text": "做一些类似木工之类的工作，以及为了"}, {"type": "subtitle", "time": 27207.91, "timestamp": "07:33:27", "text": "不知为何，我站在了这个上面。"}, {"type": "subtitle", "time": 27210.07, "timestamp": "07:33:30", "text": "表格，然后做了所有这些，并且做到了"}, {"type": "subtitle", "time": 27212.11, "timestamp": "07:33:32", "text": "什么也没发生，这件事也什么都没发生。"}, {"type": "subtitle", "time": 27214.708, "timestamp": "07:33:34", "text": "事情就是这样，我回去后才意识到"}, {"type": "subtitle", "time": 27216.31, "timestamp": "07:33:36", "text": "等等，这是新桌子吗？我不是。"}, {"type": "subtitle", "time": 27218.27, "timestamp": "07:33:38", "text": "应该做"}, {"type": "subtitle", "time": 27222.628, "timestamp": "07:33:42", "text": "它就像是，好吧，非常结实耐用，250。"}, {"type": "subtitle", "time": 27224.27, "timestamp": "07:33:44", "text": "但这就像……"}, {"type": "subtitle", "time": 27226.868, "timestamp": "07:33:46", "text": "制造商 直接制造商"}, {"type": "subtitle", "time": 27229.91, "timestamp": "07:33:49", "text": "你显然不会得到的东西"}, {"type": "subtitle", "time": 27233.59, "timestamp": "07:33:53", "text": "因为我需要出差。所以就像我"}, {"type": "subtitle", "time": 27235.91, "timestamp": "07:33:55", "text": "我认为要到达那里，我必须旅行一段时间。"}, {"type": "subtitle", "time": 27239.27, "timestamp": "07:33:59", "text": "3小时。我花了三个小时在那里旅行。"}]
[{"type": "subtitle", "time": 27485.11, "timestamp": "07:38:05", "text": "好的。申请。好的。好的。各位，不要这样做"}, {"type": "subtitle", "time": 27488.788, "timestamp": "07:38:08", "text": "游戏无法开始。我会哭的。不，你"}, {"type": "subtitle", "time": 27491.75, "timestamp": "07:38:11", "text": "可以加入中间。"}, {"type": "subtitle", "time": 27494.07, "timestamp": "07:38:14", "text": "哦好的。别在意这件事。过来，"}, {"type": "subtitle", "time": 27495.59, "timestamp": "07:38:15", "text": "查克。行，随便你。随便你。"}, {"type": "subtitle", "time": 27497.11, "timestamp": "07:38:17", "text": "没关系。现在，我们就像两个人一样。"}, {"type": "subtitle", "time": 27503.59, "timestamp": "07:38:23", "text": "过来，查克。好的。我该怎么办？"}, {"type": "subtitle", "time": 27505.11, "timestamp": "07:38:25", "text": "在线的。"}, {"type": "subtitle", "time": 27506.43, "timestamp": "07:38:26", "text": "是的，直接去"}, {"type": "subtitle", "time": 27509.59, "timestamp": "07:38:29", "text": "在线的。如果你在那里看到我的名字，"}, {"type": "subtitle", "time": 27511.03, "timestamp": "07:38:31", "text": "那意味着你站在对的一方。"}, {"type": "subtitle", "time": 27515.03, "timestamp": "07:38:35", "text": "大厅。 H：哦，该死。"}, {"type": "subtitle", "time": 27517.27, "timestamp": "07:38:37", "text": "哦好的。没关系。我也这么做了。"}, {"type": "subtitle", "time": 27519.99, "timestamp": "07:38:39", "text": "事物。"}, {"type": "subtitle", "time": 27523.11, "timestamp": "07:38:43", "text": "我的天啊。我可能不得不杀了你。哦"}, {"type": "subtitle", "time": 27525.51, "timestamp": "07:38:45", "text": "我的。"}, {"type": "subtitle", "time": 27528.19, "timestamp": "07:38:48", "text": "哦，我的天啊。哦"}, {"type": "subtitle", "time": 27536.15, "timestamp": "07:38:56", "text": "这个大脑不擅长不擅长"}, {"type": "subtitle", "time": 27538.548, "timestamp": "07:38:58", "text": "开车。查找服务器。呃，把它穿上"}]
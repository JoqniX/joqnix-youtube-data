[{"type": "subtitle", "time": 24363.948, "timestamp": "06:46:03", "text": "嗯。我是一名信息掮客。"}, {"type": "subtitle", "time": 24366.868, "timestamp": "06:46:06", "text": "好的。我之所以能达成交易，是因为我把事情推给了别人。"}, {"type": "subtitle", "time": 24368.468, "timestamp": "06:46:08", "text": "你想了解信息吗？你必须付出"}, {"type": "subtitle", "time": 24381.35, "timestamp": "06:46:21", "text": "他们只是想和我们达成交易。我"}, {"type": "subtitle", "time": 24394.788, "timestamp": "06:46:34", "text": "哦，等等。共振信标。是吗？"}, {"type": "subtitle", "time": 24397.51, "timestamp": "06:46:37", "text": "雕像塔现在怎么样了？我为什么要为此感到压力"}, {"type": "subtitle", "time": 24410.468, "timestamp": "06:46:50", "text": "我忍不住一直盯着安子看。"}, {"type": "subtitle", "time": 24413.868, "timestamp": "06:46:53", "text": "她真是太漂亮太酷了。和"}, {"type": "subtitle", "time": 24418.59, "timestamp": "06:46:58", "text": "她做的每一个动作都好可爱"}]
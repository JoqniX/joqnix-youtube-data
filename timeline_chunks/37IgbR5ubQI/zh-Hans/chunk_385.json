[{"type": "subtitle", "time": 23101.91, "timestamp": "06:25:01", "text": "它最好暂时躲在这里。"}, {"type": "subtitle", "time": 23104.628, "timestamp": "06:25:04", "text": "[音乐]"}, {"type": "subtitle", "time": 23107.15, "timestamp": "06:25:07", "text": "哦，这些人是谁？谁是"}, {"type": "subtitle", "time": 23110.708, "timestamp": "06:25:10", "text": "这？这是谁？我在……上见过这个人"}, {"type": "subtitle", "time": 23119.39, "timestamp": "06:25:19", "text": "地方。我的天哪，她得了个可怕的病"}, {"type": "subtitle", "time": 23132.788, "timestamp": "06:25:32", "text": "她还好，她是红头发。好的，我是"}, {"type": "subtitle", "time": 23134.67, "timestamp": "06:25:34", "text": "获得"}, {"type": "subtitle", "time": 23136.99, "timestamp": "06:25:36", "text": "她的名字是"}, {"type": "subtitle", "time": 23140.47, "timestamp": "06:25:40", "text": "卡米拉。好的，卡米拉，我亲爱的。现在，"}, {"type": "subtitle", "time": 23141.788, "timestamp": "06:25:41", "text": "她可以走了"}, {"type": "subtitle", "time": 23146.11, "timestamp": "06:25:46", "text": "红发女郎。好的，我要走了"}, {"type": "subtitle", "time": 23149.32, "timestamp": "06:25:49", "text": "我要走了 攒钱"}, {"type": "subtitle", "time": 23156.67, "timestamp": "06:25:56", "text": "她。什么？"}]
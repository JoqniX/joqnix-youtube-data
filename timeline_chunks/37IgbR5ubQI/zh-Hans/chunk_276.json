[{"type": "subtitle", "time": 16560.269, "timestamp": "04:36:00", "text": "感觉有点"}, {"type": "subtitle", "time": 16561.869, "timestamp": "04:36:01", "text": "难的，"}, {"type": "subtitle", "time": 16577.23, "timestamp": "04:36:17", "text": "蓝鸟，我的"}, {"type": "subtitle", "time": 16580.709, "timestamp": "04:36:20", "text": "以帝国战争之名进行的救赎"}, {"type": "subtitle", "time": 16592.029, "timestamp": "04:36:32", "text": "我能拼出“打倒几个脑袋”这句话。"}, {"type": "subtitle", "time": 16600.551, "timestamp": "04:36:40", "text": "我。来吧。"}, {"type": "subtitle", "time": 16601.709, "timestamp": "04:36:41", "text": "仅仅是"}, {"type": "subtitle", "time": 16605.99, "timestamp": "04:36:45", "text": "划痕。只是擦伤。"}, {"type": "subtitle", "time": 16608.029, "timestamp": "04:36:48", "text": "那就交给它吧"}, {"type": "subtitle", "time": 16618.629, "timestamp": "04:36:58", "text": "都是你的。快点。"}]
[{"type": "subtitle", "time": 22382.788, "timestamp": "06:13:02", "text": "我真的很想去某个地方参观。"}, {"type": "subtitle", "time": 22386.31, "timestamp": "06:13:06", "text": "就像瀑布一样倾泻而下"}, {"type": "subtitle", "time": 22388.788, "timestamp": "06:13:08", "text": "而你只是"}, {"type": "subtitle", "time": 22391.03, "timestamp": "06:13:11", "text": "瀑布后面好像有个……"}, {"type": "subtitle", "time": 22393.99, "timestamp": "06:13:13", "text": "你可以喜欢的地方，对，就像这样"}, {"type": "subtitle", "time": 22396.628, "timestamp": "06:13:16", "text": "一个隐蔽的地方之类的。确实如此。"}, {"type": "subtitle", "time": 22400.15, "timestamp": "06:13:20", "text": "酷炫又可爱，真是太酷了。那将是"}, {"type": "subtitle", "time": 22401.23, "timestamp": "06:13:21", "text": "所以"}, {"type": "subtitle", "time": 22407.75, "timestamp": "06:13:27", "text": "是的。是的。是的。我很想去"}, {"type": "subtitle", "time": 22423.43, "timestamp": "06:13:43", "text": "那里。哦，是的。那应该是等等，"}, {"type": "subtitle", "time": 22427.15, "timestamp": "06:13:47", "text": "花朵。为什么它看起来像维丽娜的"}, {"type": "subtitle", "time": 22430.628, "timestamp": "06:13:50", "text": "花？等等，这种和这种"}, {"type": "subtitle", "time": 22432.67, "timestamp": "06:13:52", "text": "差不多，不是吗？"}, {"type": "subtitle", "time": 22435.51, "timestamp": "06:13:55", "text": "思考？你不觉得它们很相似吗？"}]
[{"type": "subtitle", "time": 26461.27, "timestamp": "07:21:01", "text": "退出我的Mac电脑。没有人能治愈我们，通过"}, {"type": "subtitle", "time": 26463.83, "timestamp": "07:21:03", "text": "这样就没问题了。"}, {"type": "subtitle", "time": 26465.83, "timestamp": "07:21:05", "text": "你有这款游戏吗？你有吗？"}, {"type": "subtitle", "time": 26468.23, "timestamp": "07:21:08", "text": "游戏《公路救赎》？"}, {"type": "subtitle", "time": 26471.99, "timestamp": "07:21:11", "text": "不，我打算直接下载。好的。"}, {"type": "subtitle", "time": 26474.07, "timestamp": "07:21:14", "text": "兄弟，我这就下载。"}, {"type": "subtitle", "time": 26478.07, "timestamp": "07:21:18", "text": "你想为这两人效力吗？"}, {"type": "subtitle", "time": 26480.27, "timestamp": "07:21:20", "text": "但罗是"}, {"type": "subtitle", "time": 26484.15, "timestamp": "07:21:24", "text": "他当时正在玩，所以我就想，我也加入他吧。"}, {"type": "subtitle", "time": 26491.91, "timestamp": "07:21:31", "text": "好的。就像在说“你好”。"}, {"type": "subtitle", "time": 26493.19, "timestamp": "07:21:33", "text": "你好。"}, {"type": "subtitle", "time": 26496.23, "timestamp": "07:21:36", "text": "我谁在乎？我可以 我可以 我可以 我可以 我可以"}, {"type": "subtitle", "time": 26504.07, "timestamp": "07:21:44", "text": "等等，你在玩什么游戏？"}, {"type": "subtitle", "time": 26506.39, "timestamp": "07:21:46", "text": "呃，我们希望看到《Ro Redemption》，"}, {"type": "subtitle", "time": 26510.548, "timestamp": "07:21:50", "text": "正确的？ Vic正在下载。"}, {"type": "subtitle", "time": 26514.39, "timestamp": "07:21:54", "text": "你正在下载游戏。"}, {"type": "subtitle", "time": 26517.75, "timestamp": "07:21:57", "text": "是的，这是直播用的。"}]
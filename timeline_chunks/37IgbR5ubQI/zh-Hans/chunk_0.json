[{"type": "subtitle", "time": 22.189, "timestamp": "00:00:22", "text": "H. 我是谁？"}, {"type": "subtitle", "time": 25.83, "timestamp": "00:00:25", "text": "居住？我还活着吗？我还活着吗？我还活着吗？"}, {"type": "subtitle", "time": 28.429, "timestamp": "00:00:28", "text": "我还活着吗？我相信我是"}, {"type": "subtitle", "time": 31.069, "timestamp": "00:00:31", "text": "居住。好吧，我想我是"}, {"type": "subtitle", "time": 35.75, "timestamp": "00:00:35", "text": "居住。大家好，欢迎各位。"}, {"type": "subtitle", "time": 40.15, "timestamp": "00:00:40", "text": "欢迎来到 Joathon 第 59 天，我很抱歉"}, {"type": "subtitle", "time": 42.67, "timestamp": "00:00:42", "text": "开始直播超级"}, {"type": "subtitle", "time": 45.83, "timestamp": "00:00:45", "text": "晚的。呃，我家停电了，"}, {"type": "subtitle", "time": 48.549, "timestamp": "00:00:48", "text": "一切。我昨天意识到了这一点"}, {"type": "subtitle", "time": 51.95, "timestamp": "00:00:51", "text": "整晚直播不知为何都中断了。"}, {"type": "subtitle", "time": 55.47, "timestamp": "00:00:55", "text": "某处。我甚至不知道我去过"}, {"type": "subtitle", "time": 58.63, "timestamp": "00:00:58", "text": "睡着后，我意识到一条小溪已经结束了。"}]
[{"type": "subtitle", "time": 28200.868, "timestamp": "07:50:00", "text": "我正在直播。杰奎先生，并非如此。"}, {"type": "subtitle", "time": 28203.51, "timestamp": "07:50:03", "text": "是的。是的，可以。你可以。你可以。我"}, {"type": "subtitle", "time": 28205.19, "timestamp": "07:50:05", "text": "做到了。为什么警察甚至都不在？"}, {"type": "subtitle", "time": 28208.708, "timestamp": "07:50:08", "text": "追我？这到底是什么怪事？"}, {"type": "subtitle", "time": 28210.31, "timestamp": "07:50:10", "text": "他们根本不在乎。就像，啊，他"}, {"type": "subtitle", "time": 28212.31, "timestamp": "07:50:12", "text": "他只会孤独地死去。他没有"}, {"type": "subtitle", "time": 28214.628, "timestamp": "07:50:14", "text": "需要做任何事。我们不需要这样做"}, {"type": "subtitle", "time": 28216.788, "timestamp": "07:50:16", "text": "有什么特别的吗？他就这样死了"}, {"type": "subtitle", "time": 28227.43, "timestamp": "07:50:27", "text": "啊，我差点就撞上了"}, {"type": "subtitle", "time": 28231.35, "timestamp": "07:50:31", "text": "那辆车，它让我感到很亲近"}, {"type": "subtitle", "time": 28234.23, "timestamp": "07:50:34", "text": "称呼。我真是太觉得好笑了"}, {"type": "subtitle", "time": 28237.03, "timestamp": "07:50:37", "text": "游戏卡顿得我根本玩不下去，我真是太努力了。"}, {"type": "subtitle", "time": 28240.31, "timestamp": "07:50:40", "text": "现在就开拍。我不会"}, {"type": "subtitle", "time": 28243.27, "timestamp": "07:50:43", "text": "说谎。嘿。嘿，伙计们，来吧。快点。"}, {"type": "subtitle", "time": 28253.19, "timestamp": "07:50:53", "text": "好的，谢谢。耶！哎哟！哦！哎哟！哎哟！哎哟！"}, {"type": "subtitle", "time": 28256.51, "timestamp": "07:50:56", "text": "哎哟！哎哟！怪物！怪物！怪物！哦，我的天"}, {"type": "subtitle", "time": 28259.43, "timestamp": "07:50:59", "text": "上帝！我拼命想杀人。"}]
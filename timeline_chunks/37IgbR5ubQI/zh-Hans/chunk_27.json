[{"type": "subtitle", "time": 1620.669, "timestamp": "00:27:00", "text": "油的类型"}, {"type": "subtitle", "time": 1623.789, "timestamp": "00:27:03", "text": "我们摇晃的汉堡鳕鱼"}, {"type": "subtitle", "time": 1635.909, "timestamp": "00:27:15", "text": "房间砰砰，房间中心的东西"}, {"type": "subtitle", "time": 1638.31, "timestamp": "00:27:18", "text": "等等，你想加入一个公共的吗？"}, {"type": "subtitle", "time": 1640.909, "timestamp": "00:27:20", "text": "你只想加入"}, {"type": "subtitle", "time": 1643.149, "timestamp": "00:27:23", "text": "找到一个"}, {"type": "subtitle", "time": 1646.47, "timestamp": "00:27:26", "text": "想知道为什么没人玩这个名字。"}, {"type": "subtitle", "time": 1651.11, "timestamp": "00:27:31", "text": "什么？我已将……寄给你"}, {"type": "subtitle", "time": 1666.23, "timestamp": "00:27:46", "text": "好的。啊，我看到你了。等等，没人玩这个游戏"}, {"type": "subtitle", "time": 1668.95, "timestamp": "00:27:48", "text": "这款游戏。这匹马是东道主。看，"}, {"type": "subtitle", "time": 1670.11, "timestamp": "00:27:50", "text": "这是一个"}, {"type": "subtitle", "time": 1674.31, "timestamp": "00:27:54", "text": "猫。与此同时，好好享受养猫的乐趣吧。我愿意"}, {"type": "subtitle", "time": 1677.029, "timestamp": "00:27:57", "text": "这张猫的图片。这是什么游戏？"}]
[{"type": "subtitle", "time": 28621.75, "timestamp": "07:57:01", "text": "救赎来得正是时候。"}, {"type": "subtitle", "time": 28623.31, "timestamp": "07:57:03", "text": "结束了。我心想，你知道的"}, {"type": "subtitle", "time": 28627.75, "timestamp": "07:57:07", "text": "什么？我们可以玩。一枪，一"}, {"type": "subtitle", "time": 28632.15, "timestamp": "07:57:12", "text": "杀。这是谁？ Oyoko在哪里？"}, {"type": "subtitle", "time": 28634.15, "timestamp": "07:57:14", "text": "是的，我不会加入。是的，我会的"}, {"type": "subtitle", "time": 28635.67, "timestamp": "07:57:15", "text": "加入。"}, {"type": "subtitle", "time": 28639.23, "timestamp": "07:57:19", "text": "不，就像我们一样。"}, {"type": "subtitle", "time": 28642.31, "timestamp": "07:57:22", "text": "是啊，更有趣。"}, {"type": "subtitle", "time": 28644.31, "timestamp": "07:57:24", "text": "不，我不在乎。好了。我是"}, {"type": "subtitle", "time": 28648.468, "timestamp": "07:57:28", "text": "这里。我不知道这些人是谁。"}, {"type": "subtitle", "time": 28652.07, "timestamp": "07:57:32", "text": "好的，你要加入哪支队伍？"}, {"type": "subtitle", "time": 28654.19, "timestamp": "07:57:34", "text": "我要"}, {"type": "subtitle", "time": 28659.51, "timestamp": "07:57:39", "text": "去。等等，我无法更换武器。"}, {"type": "subtitle", "time": 28661.11, "timestamp": "07:57:41", "text": "你可以在这里选择武器，然后"}, {"type": "subtitle", "time": 28662.91, "timestamp": "07:57:42", "text": "你无法更改它"}, {"type": "subtitle", "time": 28669.35, "timestamp": "07:57:49", "text": "好的。我要进教室了。"}, {"type": "subtitle", "time": 28672.708, "timestamp": "07:57:52", "text": "我觉得自己很忧郁。"}, {"type": "subtitle", "time": 28675.75, "timestamp": "07:57:55", "text": "好吧，那我想要红色的。"}, {"type": "subtitle", "time": 28678.708, "timestamp": "07:57:58", "text": "好的，那我也马上就来。"}]
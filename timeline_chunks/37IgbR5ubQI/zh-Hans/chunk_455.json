[{"type": "subtitle", "time": 27302.548, "timestamp": "07:35:02", "text": "在线三。等待。我该如何加入你们？"}, {"type": "subtitle", "time": 27304.868, "timestamp": "07:35:04", "text": "再次？"}, {"type": "subtitle", "time": 27308.388, "timestamp": "07:35:08", "text": "让我试着邀请你。好的。"}, {"type": "subtitle", "time": 27310.868, "timestamp": "07:35:10", "text": "我看看你能不能加入游戏。如果"}, {"type": "subtitle", "time": 27319.27, "timestamp": "07:35:19", "text": "哇。它打不开。我"}, {"type": "subtitle", "time": 27321.15, "timestamp": "07:35:21", "text": "不知道"}, {"type": "subtitle", "time": 27325.31, "timestamp": "07:35:25", "text": "为什么。哦。哦。哦，找到了。"}, {"type": "subtitle", "time": 27328.628, "timestamp": "07:35:28", "text": "小伙子们。我认为。哦，不。"}, {"type": "subtitle", "time": 27330.948, "timestamp": "07:35:30", "text": "哦，是你啊。"}, {"type": "subtitle", "time": 27333.91, "timestamp": "07:35:33", "text": "稍等片刻。"}, {"type": "subtitle", "time": 27336.23, "timestamp": "07:35:36", "text": "哦，约翰来了。好的。哦，真好，真好。"}, {"type": "subtitle", "time": 27340.468, "timestamp": "07:35:40", "text": "不错，不错。哦，还是那支队伍。哦，"}, {"type": "subtitle", "time": 27342.31, "timestamp": "07:35:42", "text": "是的。好像没多少人玩这个游戏。"}, {"type": "subtitle", "time": 27345.91, "timestamp": "07:35:45", "text": "当然，这款游戏肯定如此。"}, {"type": "subtitle", "time": 27348.548, "timestamp": "07:35:48", "text": "哦，这里有一段视频剪辑。"}, {"type": "subtitle", "time": 27351.03, "timestamp": "07:35:51", "text": "推荐。这到底是什么怪事？等等，那是"}, {"type": "subtitle", "time": 27352.868, "timestamp": "07:35:52", "text": "免责声明。那是免责声明。我"}, {"type": "subtitle", "time": 27354.23, "timestamp": "07:35:54", "text": "我想再看看那条免责声明。什么"}, {"type": "subtitle", "time": 27356.548, "timestamp": "07:35:56", "text": "那个怪胎？不，它就像是这么说的。"}, {"type": "subtitle", "time": 27358.468, "timestamp": "07:35:58", "text": "是的，就像你可以把所有东西都变现一样。"}]
[{"type": "subtitle", "time": 20940.31, "timestamp": "05:49:00", "text": "不。我该如何打开它？"}, {"type": "subtitle", "time": 20944.11, "timestamp": "05:49:04", "text": "翻译软件？哦"}, {"type": "subtitle", "time": 20947.23, "timestamp": "05:49:07", "text": "呃，有效"}, {"type": "subtitle", "time": 20950.99, "timestamp": "05:49:10", "text": "落后。呃，让我试试。"}, {"type": "subtitle", "time": 20953.43, "timestamp": "05:49:13", "text": "好吧，肯定会有延迟，但是……"}, {"type": "subtitle", "time": 20954.83, "timestamp": "05:49:14", "text": "患病的"}, {"type": "subtitle", "time": 20961.07, "timestamp": "05:49:21", "text": "正确的。请不要拖延整个过程"}, {"type": "subtitle", "time": 20968.27, "timestamp": "05:49:28", "text": "中央处理器。"}, {"type": "subtitle", "time": 20970.03, "timestamp": "05:49:30", "text": "啊，"}, {"type": "subtitle", "time": 20973.35, "timestamp": "05:49:33", "text": "你能数数帧数吗？好的，可以"}, {"type": "subtitle", "time": 20976.27, "timestamp": "05:49:36", "text": "你数数我的速度有多慢"}, {"type": "subtitle", "time": 20991.59, "timestamp": "05:49:51", "text": "落后。它运行缓慢。我的天啊，真是这样吗？"}, {"type": "subtitle", "time": 20995.59, "timestamp": "05:49:55", "text": "滞后。它正在消亡。哦。哦。哦。哦。"}, {"type": "subtitle", "time": 20997.31, "timestamp": "05:49:57", "text": "我应该把它关掉吗？"}]
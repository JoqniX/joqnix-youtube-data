[{"type": "subtitle", "time": 24662.15, "timestamp": "06:51:02", "text": "那些？你会如何直播？我不直播"}, {"type": "subtitle", "time": 24665.11, "timestamp": "06:51:05", "text": "你会怎么做？我认为是"}, {"type": "subtitle", "time": 24667.99, "timestamp": "06:51:07", "text": "就像回声狩猎一样，对吧？获得"}, {"type": "subtitle", "time": 24671.11, "timestamp": "06:51:11", "text": "最好的回声效果等等。农业"}, {"type": "subtitle", "time": 24672.15, "timestamp": "06:51:12", "text": "某种文物"}, {"type": "subtitle", "time": 24674.03, "timestamp": "06:51:14", "text": "[音乐]"}, {"type": "subtitle", "time": 24689.39, "timestamp": "06:51:29", "text": "猜测。我心想，老兄，我就是想要"}, {"type": "subtitle", "time": 24691.23, "timestamp": "06:51:31", "text": "到"}, {"type": "subtitle", "time": 24701.03, "timestamp": "06:51:41", "text": "知道吗，多么壮丽的雨啊。安可"}, {"type": "subtitle", "time": 24705.43, "timestamp": "06:51:45", "text": "全部结算完毕。她为什么这么可爱？"}, {"type": "subtitle", "time": 24712.99, "timestamp": "06:51:52", "text": "这。她只是举起了双臂。"}, {"type": "subtitle", "time": 24716.11, "timestamp": "06:51:56", "text": "空气。比如，哦，"}, {"type": "subtitle", "time": 24718.75, "timestamp": "06:51:58", "text": "哦，让我感受"}]
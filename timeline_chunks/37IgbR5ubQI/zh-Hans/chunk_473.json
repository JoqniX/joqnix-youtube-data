[{"type": "subtitle", "time": 28380.07, "timestamp": "07:53:00", "text": "我也是你的敌人。你刚刚就做到了。你"}, {"type": "subtitle", "time": 28390.628, "timestamp": "07:53:10", "text": "我们用细绳。回来。去。有"}, {"type": "subtitle", "time": 28392.788, "timestamp": "07:53:12", "text": "还有其他人会尝试"}, {"type": "subtitle", "time": 28396.07, "timestamp": "07:53:16", "text": "杀了我们。当心。"}, {"type": "subtitle", "time": 28399.75, "timestamp": "07:53:19", "text": "嗯，当然。雅克。我的天哪。"}, {"type": "subtitle", "time": 28401.75, "timestamp": "07:53:21", "text": "有四名球员加入了"}, {"type": "subtitle", "time": 28403.51, "timestamp": "07:53:23", "text": "随机的。"}, {"type": "subtitle", "time": 28405.948, "timestamp": "07:53:25", "text": "我不知道他是谁。楼主让我们"}, {"type": "subtitle", "time": 28419.868, "timestamp": "07:53:39", "text": "我是耶稣基督，人。哦，"}, {"type": "subtitle", "time": 28432.708, "timestamp": "07:53:52", "text": "约翰，这并非针对你个人。只是"}, {"type": "subtitle", "time": 28435.75, "timestamp": "07:53:55", "text": "要么跟你上床。"}]
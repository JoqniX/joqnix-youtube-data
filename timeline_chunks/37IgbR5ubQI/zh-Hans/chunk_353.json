[{"type": "subtitle", "time": 21180.47, "timestamp": "05:53:00", "text": "为什么是主播？为什么是主播？"}, {"type": "subtitle", "time": 21189.67, "timestamp": "05:53:09", "text": "嗯，是的，我应该那样做。一"}, {"type": "subtitle", "time": 21193.31, "timestamp": "05:53:13", "text": "第二。好的。呃，我需要一个我一直"}, {"type": "subtitle", "time": 21197.39, "timestamp": "05:53:17", "text": "忘记这些事。我需要"}, {"type": "subtitle", "time": 21201.47, "timestamp": "05:53:21", "text": "你这样我就可以……吹我的"}, {"type": "subtitle", "time": 21204.71, "timestamp": "05:53:24", "text": "屏幕。等一下。"}, {"type": "subtitle", "time": 21208.51, "timestamp": "05:53:28", "text": "[音乐]"}, {"type": "subtitle", "time": 21217.35, "timestamp": "05:53:37", "text": "翻译。如果我会说中文，你能……"}, {"type": "subtitle", "time": 21220.27, "timestamp": "05:53:40", "text": "明白了吗？不，我用的是谷歌翻译"}, {"type": "subtitle", "time": 21225.548, "timestamp": "05:53:45", "text": "它。我用谷歌翻译了评论。"}, {"type": "subtitle", "time": 21228.708, "timestamp": "05:53:48", "text": "是的。是的。是的。这就是我做的事。所以，"}, {"type": "subtitle", "time": 21231.83, "timestamp": "05:53:51", "text": "不看书更容易些。但是"}, {"type": "subtitle", "time": 21235.83, "timestamp": "05:53:55", "text": "唯一的问题是……名字，对吧，名字"}, {"type": "subtitle", "time": 21238.628, "timestamp": "05:53:58", "text": "我无法见到的那个人"}]
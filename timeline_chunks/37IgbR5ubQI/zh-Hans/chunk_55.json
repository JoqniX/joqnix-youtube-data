[{"type": "subtitle", "time": 3306.87, "timestamp": "00:55:06", "text": "我已经知道该推荐哪款游戏了。"}, {"type": "subtitle", "time": 3319.03, "timestamp": "00:55:19", "text": "是的。卧室。这是什么？是吗？"}, {"type": "subtitle", "time": 3322.03, "timestamp": "00:55:22", "text": "已锁定？红色的东西。蓝色的"}, {"type": "subtitle", "time": 3324.99, "timestamp": "00:55:24", "text": "事物。请坐下等候"}, {"type": "subtitle", "time": 3333.349, "timestamp": "00:55:33", "text": "他们把东西放好就走了。"}, {"type": "subtitle", "time": 3343.79, "timestamp": "00:55:43", "text": "是的。哦，夺旗游戏。是的。"}, {"type": "subtitle", "time": 3346.549, "timestamp": "00:55:46", "text": "好的。砰砰砰，然后抓住"}, {"type": "subtitle", "time": 3350.789, "timestamp": "00:55:50", "text": "旗帜。回去吧，返回你的基地。哦，"}, {"type": "subtitle", "time": 3352.71, "timestamp": "00:55:52", "text": "这就是为什么我们应该这样做的原因"}, {"type": "subtitle", "time": 3355.67, "timestamp": "00:55:55", "text": "你回来了。"}, {"type": "subtitle", "time": 3358.23, "timestamp": "00:55:58", "text": "哦，不。"}]
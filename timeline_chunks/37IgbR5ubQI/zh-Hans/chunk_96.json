[{"type": "subtitle", "time": 5784.07, "timestamp": "01:36:24", "text": "罗伊奥。你还没生成吗？"}, {"type": "subtitle", "time": 5791.43, "timestamp": "01:36:31", "text": "不，没问题。你的旗帜"}, {"type": "subtitle", "time": 5793.43, "timestamp": "01:36:33", "text": "没有生成。"}, {"type": "subtitle", "time": 5795.11, "timestamp": "01:36:35", "text": "什么？"}, {"type": "subtitle", "time": 5801.35, "timestamp": "01:36:41", "text": "是的，"}, {"type": "subtitle", "time": 5804.47, "timestamp": "01:36:44", "text": "我没看到你的插头。它就在那里。我"}, {"type": "subtitle", "time": 5806.31, "timestamp": "01:36:46", "text": "看看吧。"}, {"type": "subtitle", "time": 5808.07, "timestamp": "01:36:48", "text": "但我没看到。我该怎么做？"}, {"type": "subtitle", "time": 5816.03, "timestamp": "01:36:56", "text": "你是直接插电的吗？"}, {"type": "subtitle", "time": 5818.59, "timestamp": "01:36:58", "text": "某物？"}]
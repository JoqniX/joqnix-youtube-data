[{"type": "subtitle", "time": 27901.27, "timestamp": "07:45:01", "text": "呃，不，不，不。我不想离开"}, {"type": "subtitle", "time": 27904.628, "timestamp": "07:45:04", "text": "游戏规模庞大。"}, {"type": "subtitle", "time": 27907.35, "timestamp": "07:45:07", "text": "哦，就像设置一样。哦，你只要按一下就行了。"}, {"type": "subtitle", "time": 27909.91, "timestamp": "07:45:09", "text": "玩。呃，你可以更改设置。"}, {"type": "subtitle", "time": 27912.07, "timestamp": "07:45:12", "text": "是的，我们还有大约66秒的时间。"}, {"type": "subtitle", "time": 27915.11, "timestamp": "07:45:15", "text": "游戏里，你可以修改它。"}, {"type": "subtitle", "time": 27917.35, "timestamp": "07:45:17", "text": "哦好的。你要加入哪支队伍？"}, {"type": "subtitle", "time": 27918.868, "timestamp": "07:45:18", "text": "查克？"}, {"type": "subtitle", "time": 27922.948, "timestamp": "07:45:22", "text": "我要穿蓝色。我感到忧郁。"}, {"type": "subtitle", "time": 27932.15, "timestamp": "07:45:32", "text": "我要扮成圣诞老人"}, {"type": "subtitle", "time": 27935.11, "timestamp": "07:45:35", "text": "时间。"}, {"type": "subtitle", "time": 27936.43, "timestamp": "07:45:36", "text": "应该是"}, {"type": "subtitle", "time": 27940.07, "timestamp": "07:45:40", "text": "摇滚。等等，是不同的人"}, {"type": "subtitle", "time": 27943.15, "timestamp": "07:45:43", "text": "具有不同的能力。"}, {"type": "subtitle", "time": 27946.15, "timestamp": "07:45:46", "text": "是的。不同的属性。我是说，"}, {"type": "subtitle", "time": 27957.15, "timestamp": "07:45:57", "text": "枪。他看起来像个警察。"}]
[{"type": "subtitle", "time": 28144.788, "timestamp": "07:49:04", "text": "呃，我现在正在改变。"}, {"type": "subtitle", "time": 28148.388, "timestamp": "07:49:08", "text": "我打你了。别这样，好吗？呃，我死了。不"}, {"type": "subtitle", "time": 28150.708, "timestamp": "07:49:10", "text": "别担心。"}, {"type": "subtitle", "time": 28153.59, "timestamp": "07:49:13", "text": "我得去搞个土制炸弹。我们走吧，"}, {"type": "subtitle", "time": 28165.51, "timestamp": "07:49:25", "text": "那是什么？丢失的。"}, {"type": "subtitle", "time": 28168.388, "timestamp": "07:49:28", "text": "查克先生，我的枪法很准。什么"}, {"type": "subtitle", "time": 28171.51, "timestamp": "07:49:31", "text": "搞什么鬼？是的，没问题。不用担心，"}, {"type": "subtitle", "time": 28173.75, "timestamp": "07:49:33", "text": "伙计们。这是一款双人游戏。它是"}, {"type": "subtitle", "time": 28176.548, "timestamp": "07:49:36", "text": "不是三人游戏。"}, {"type": "subtitle", "time": 28179.67, "timestamp": "07:49:39", "text": "呃，你把它放在最下面的后备箱里了吗？"}, {"type": "subtitle", "time": 28182.31, "timestamp": "07:49:42", "text": "是的，它在最低层。我不知道"}, {"type": "subtitle", "time": 28184.31, "timestamp": "07:49:44", "text": "还能怎么办呢？然后，呃，去"}, {"type": "subtitle", "time": 28186.868, "timestamp": "07:49:46", "text": "显而易见，请更改您的预设。尽量"}, {"type": "subtitle", "time": 28189.03, "timestamp": "07:49:49", "text": "照做。它会给你更多"}, {"type": "subtitle", "time": 28191.99, "timestamp": "07:49:51", "text": "帧。我就是这么做的。"}, {"type": "subtitle", "time": 28195.11, "timestamp": "07:49:55", "text": "进入 OBS 设置。"}, {"type": "subtitle", "time": 28196.788, "timestamp": "07:49:56", "text": "我不认为它会允许"}, {"type": "subtitle", "time": 28198.788, "timestamp": "07:49:58", "text": "我在 OBS 设置中做任何事情"}]
[{"type": "subtitle", "time": 21001.03, "timestamp": "05:50:01", "text": "呃，我需要想个办法。我的"}, {"type": "subtitle", "time": 21008.59, "timestamp": "05:50:08", "text": "坏的。但翻译也是错误的。"}, {"type": "subtitle", "time": 21011.91, "timestamp": "05:50:11", "text": "所以，没关系。没关系。没关系。我们"}, {"type": "subtitle", "time": 21014.548, "timestamp": "05:50:14", "text": "大家一起想办法解决吧。出色地"}, {"type": "subtitle", "time": 21016.91, "timestamp": "05:50:16", "text": "想想看"}, {"type": "subtitle", "time": 21020.868, "timestamp": "05:50:20", "text": "出去。开始之前，让我先确认一下……"}, {"type": "subtitle", "time": 21032.67, "timestamp": "05:50:32", "text": "出色地。哦，我的音频有延迟。哦，等等，"}, {"type": "subtitle", "time": 21038.91, "timestamp": "05:50:38", "text": "什么？好的，等等。我需要把它关掉。"}, {"type": "subtitle", "time": 21043.75, "timestamp": "05:50:43", "text": "正确的？哦不，我们要进入不退缩模式了。"}, {"type": "subtitle", "time": 21051.23, "timestamp": "05:50:51", "text": "不。好吧，我不能用翻译器。"}, {"type": "subtitle", "time": 21055.628, "timestamp": "05:50:55", "text": "今天。它会扰乱我的噪音"}, {"type": "subtitle", "time": 21059.59, "timestamp": "05:50:59", "text": "抑制。哦，不。米希，你为什么……"}]
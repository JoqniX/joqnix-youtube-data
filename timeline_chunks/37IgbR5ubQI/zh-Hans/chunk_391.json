[{"type": "subtitle", "time": 23465.11, "timestamp": "06:31:05", "text": "但是，呃，在下一个横幅广告中……"}, {"type": "subtitle", "time": 23467.43, "timestamp": "06:31:07", "text": "凤凰城女孩太酷了，她是一个"}, {"type": "subtitle", "time": 23470.03, "timestamp": "06:31:10", "text": "红发迪奥。我想"}, {"type": "subtitle", "time": 23472.468, "timestamp": "06:31:12", "text": "她。我要收集所有的红色"}, {"type": "subtitle", "time": 23475.31, "timestamp": "06:31:15", "text": "迪奥领衔出场"}, {"type": "subtitle", "time": 23477.948, "timestamp": "06:31:17", "text": "游戏。请爱"}, {"type": "subtitle", "time": 23481.11, "timestamp": "06:31:21", "text": "我。就连原神也不喜欢红头发的人。"}, {"type": "subtitle", "time": 23484.708, "timestamp": "06:31:24", "text": "这么多迪奥。只有这款游戏。迄今为止，"}, {"type": "subtitle", "time": 23487.51, "timestamp": "06:31:27", "text": "我只见过这款游戏给予爱"}, {"type": "subtitle", "time": 23491.99, "timestamp": "06:31:31", "text": "红头发，欣赏姜红色"}, {"type": "subtitle", "time": 23495.59, "timestamp": "06:31:35", "text": "头部的东西。你知道，这就是我喜欢它的原因"}]
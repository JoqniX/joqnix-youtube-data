[{"type": "subtitle", "time": 29221.628, "timestamp": "08:07:01", "text": "有人刚刚杀死了你自己"}, {"type": "subtitle", "time": 29225.19, "timestamp": "08:07:05", "text": "队友。我的天啊。"}, {"type": "subtitle", "time": 29232.83, "timestamp": "08:07:12", "text": "为什么"}, {"type": "subtitle", "time": 29234.75, "timestamp": "08:07:14", "text": "二"}, {"type": "subtitle", "time": 29244.43, "timestamp": "08:07:24", "text": "去？我干掉了它"}, {"type": "subtitle", "time": 29247.91, "timestamp": "08:07:27", "text": "新来的。你不想当队友吗？"}, {"type": "subtitle", "time": 29251.83, "timestamp": "08:07:31", "text": "不，不，不。你的队友是红色的。哦好的。"}]
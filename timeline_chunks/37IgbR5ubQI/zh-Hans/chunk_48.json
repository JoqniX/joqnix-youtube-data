[{"type": "subtitle", "time": 2882.71, "timestamp": "00:48:02", "text": "所以，它就在我的图书馆里，我查了一下。"}, {"type": "subtitle", "time": 2885.589, "timestamp": "00:48:05", "text": "我当时在找一些休闲游戏，"}, {"type": "subtitle", "time": 2887.51, "timestamp": "00:48:07", "text": "这是多人游戏，我发现了这个。我当时"}, {"type": "subtitle", "time": 2895.589, "timestamp": "00:48:15", "text": "是的。我们试玩的另一款游戏也是"}, {"type": "subtitle", "time": 2897.91, "timestamp": "00:48:17", "text": "那款游戏停止了开发或"}, {"type": "subtitle", "time": 2899.95, "timestamp": "00:48:19", "text": "某物。我们无法参与其中。"}, {"type": "subtitle", "time": 2902.589, "timestamp": "00:48:22", "text": "一切。以便"}, {"type": "subtitle", "time": 2905.309, "timestamp": "00:48:25", "text": "真糟糕。所以"}, {"type": "subtitle", "time": 2908.15, "timestamp": "00:48:28", "text": "是的。哦，你把另一款游戏也留着了吗？"}, {"type": "subtitle", "time": 2912.069, "timestamp": "00:48:32", "text": "下载 Palia 之类的东西？"}, {"type": "subtitle", "time": 2914.95, "timestamp": "00:48:34", "text": "呃，我的Steam无法下载。"}]
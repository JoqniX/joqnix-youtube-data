[{"type": "subtitle", "time": 2460.15, "timestamp": "00:41:00", "text": "正确的？不，不，不。为什么它仍然"}, {"type": "subtitle", "time": 2463.79, "timestamp": "00:41:03", "text": "推我？哦，我的天"}, {"type": "subtitle", "time": 2474.15, "timestamp": "00:41:14", "text": "这。就像你只对我做了一次。座位"}, {"type": "subtitle", "time": 2492.069, "timestamp": "00:41:32", "text": "落后。看，看，看，看。我仍然"}]
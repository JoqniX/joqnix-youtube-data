[{"type": "subtitle", "time": 5820.99, "timestamp": "01:37:00", "text": "怎么会这样"}, {"type": "subtitle", "time": 5824.629, "timestamp": "01:37:04", "text": "你，我明明很想得到你，你却这样对我？"}, {"type": "subtitle", "time": 5827.51, "timestamp": "01:37:07", "text": "狡猾？"}, {"type": "subtitle", "time": 5829.99, "timestamp": "01:37:09", "text": "我的上帝。"}, {"type": "subtitle", "time": 5831.59, "timestamp": "01:37:11", "text": "现在的问题是，我看不见"}, {"type": "subtitle", "time": 5834.629, "timestamp": "01:37:14", "text": "你的旗帜。"}, {"type": "subtitle", "time": 5837.75, "timestamp": "01:37:17", "text": "旗帜确实在那里。我死了"}, {"type": "subtitle", "time": 5839.83, "timestamp": "01:37:19", "text": "再次。但我该如何才能得到它呢？"}, {"type": "subtitle", "time": 5842.07, "timestamp": "01:37:22", "text": "如果我没看到呢？走吧。走吧。"}, {"type": "subtitle", "time": 5845.43, "timestamp": "01:37:25", "text": "这是渲染错误。"}, {"type": "subtitle", "time": 5853.27, "timestamp": "01:37:33", "text": "是的，它就在你手里。"}, {"type": "subtitle", "time": 5855.83, "timestamp": "01:37:35", "text": "不，我根本没看到那个插头。不，"}, {"type": "subtitle", "time": 5861.189, "timestamp": "01:37:41", "text": "返回基地。它会奏效的。"}]
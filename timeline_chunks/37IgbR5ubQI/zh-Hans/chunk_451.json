[{"type": "subtitle", "time": 27061.11, "timestamp": "07:31:01", "text": "那会让我背痛。这个是"}, {"type": "subtitle", "time": 27062.628, "timestamp": "07:31:02", "text": "而且还会让我背痛，不是吗？"}, {"type": "subtitle", "time": 27065.03, "timestamp": "07:31:05", "text": "说实话，我可能会升级。"}, {"type": "subtitle", "time": 27068.388, "timestamp": "07:31:08", "text": "有一天，我的椅子。就这样，我"}, {"type": "subtitle", "time": 27070.67, "timestamp": "07:31:10", "text": "认为。是的。"}, {"type": "subtitle", "time": 27074.388, "timestamp": "07:31:14", "text": "所以，你能猜到我赚了多少钱吗？"}, {"type": "subtitle", "time": 27077.99, "timestamp": "07:31:17", "text": "这张桌子上花了多少钱？桌上有1000。"}, {"type": "subtitle", "time": 27080.07, "timestamp": "07:31:20", "text": "呃，"}, {"type": "subtitle", "time": 27081.75, "timestamp": "07:31:21", "text": "我将给你一些测量数据。"}, {"type": "subtitle", "time": 27083.83, "timestamp": "07:31:23", "text": "它是4T。"}, {"type": "subtitle", "time": 27089.43, "timestamp": "07:31:29", "text": "长4英尺，宽3英尺。"}, {"type": "subtitle", "time": 27092.388, "timestamp": "07:31:32", "text": "它非常大。它太大了"}, {"type": "subtitle", "time": 27094.468, "timestamp": "07:31:34", "text": "我的笔记本电脑。所以，这实际上是翻倍了。"}, {"type": "subtitle", "time": 27099.468, "timestamp": "07:31:39", "text": "也把它当做我房间里的桌子。所以，"}, {"type": "subtitle", "time": 27102.43, "timestamp": "07:31:42", "text": "是的。"}, {"type": "subtitle", "time": 27110.15, "timestamp": "07:31:50", "text": "大概60美元。"}, {"type": "subtitle", "time": 27112.23, "timestamp": "07:31:52", "text": "60美元。我好像……我不这么认为"}, {"type": "subtitle", "time": 27115.51, "timestamp": "07:31:55", "text": "印度也用美元，当然可以。"}, {"type": "subtitle", "time": 27117.67, "timestamp": "07:31:57", "text": "不过是美元而已。"}, {"type": "subtitle", "time": 27119.468, "timestamp": "07:31:59", "text": "我去了60岁"}]
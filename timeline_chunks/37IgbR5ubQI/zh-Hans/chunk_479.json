[{"type": "subtitle", "time": 28741.43, "timestamp": "07:59:01", "text": "他们为什么要扣留你？我不知道，"}, {"type": "subtitle", "time": 28745.59, "timestamp": "07:59:05", "text": "男人。谁在乎？谁在乎团队？我们"}, {"type": "subtitle", "time": 28759.67, "timestamp": "07:59:19", "text": "我看到，我看到，我看到我杀了人。对不起。我"}, {"type": "subtitle", "time": 28762.15, "timestamp": "07:59:22", "text": "通缉"}, {"type": "subtitle", "time": 28764.628, "timestamp": "07:59:24", "text": "没关系，杰克。没关系。你只是"}, {"type": "subtitle", "time": 28766.27, "timestamp": "07:59:26", "text": "想赢"}]
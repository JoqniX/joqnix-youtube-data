[{"type": "subtitle", "time": 25260.468, "timestamp": "07:01:00", "text": "也。我不知道是否还有其他人"}, {"type": "subtitle", "time": 25264.39, "timestamp": "07:01:04", "text": "加入。我试着，我试着带来"}, {"type": "chat", "time": 25266.54, "timestamp": "07:01:06", "author": "@RyzexCh", "avatar": "https://yt4.ggpht.com/amK2Y62apvFDa_Drvh1DcQn8KTERvc2-tn67_8Tfb4CDDptav6v-n5VMsBR3U5XQAh1NLxsr1Q=s64-c-k-c0x00ffffff-no-rj", "message": "man xD"}, {"type": "subtitle", "time": 25267.628, "timestamp": "07:01:07", "text": "人很多，但大家都忙，所以我……"}, {"type": "subtitle", "time": 25270.03, "timestamp": "07:01:10", "text": "喜欢"}, {"type": "chat", "time": 25271.541, "timestamp": "07:01:11", "author": "@RyzexCh", "avatar": "https://yt4.ggpht.com/amK2Y62apvFDa_Drvh1DcQn8KTERvc2-tn67_8Tfb4CDDptav6v-n5VMsBR3U5XQAh1NLxsr1Q=s64-c-k-c0x00ffffff-no-rj", "message": "I will just wait for his msg"}, {"type": "subtitle", "time": 25272.75, "timestamp": "07:01:12", "text": "doio，他是"}, {"type": "subtitle", "time": 25276.39, "timestamp": "07:01:16", "text": "离线，但是，嗯，救赎之路，呃，我"}, {"type": "subtitle", "time": 25278.11, "timestamp": "07:01:18", "text": "可能需要安装"}, {"type": "subtitle", "time": 25289.99, "timestamp": "07:01:29", "text": "呃哦等等，它已经安装好了，什么？"}, {"type": "subtitle", "time": 25292.628, "timestamp": "07:01:32", "text": "这到底是怎么回事？这到底是怎么回事？什么"}, {"type": "subtitle", "time": 25294.23, "timestamp": "07:01:34", "text": "搞什么鬼？我已经安装好了。"}, {"type": "subtitle", "time": 25296.43, "timestamp": "07:01:36", "text": "昨天。"}, {"type": "subtitle", "time": 25299.19, "timestamp": "07:01:39", "text": "哇。现在是擦伤了。那就是"}, {"type": "subtitle", "time": 25302.31, "timestamp": "07:01:42", "text": "事物。我当时就想，“哦，原来是这样。”"}, {"type": "subtitle", "time": 25304.11, "timestamp": "07:01:44", "text": "罗阿什"}, {"type": "subtitle", "time": 25307.51, "timestamp": "07:01:47", "text": "时间。” 伙计，我记得玩过《暴力摩托》。"}, {"type": "subtitle", "time": 25310.868, "timestamp": "07:01:50", "text": "小时候，伙计。每天早上醒来"}, {"type": "subtitle", "time": 25314.39, "timestamp": "07:01:54", "text": "想抽大麻，然后踢人"}, {"type": "subtitle", "time": 25315.548, "timestamp": "07:01:55", "text": "这"}, {"type": "subtitle", "time": 25319.07, "timestamp": "07:01:59", "text": "自行车。那时我读三年级。"}]
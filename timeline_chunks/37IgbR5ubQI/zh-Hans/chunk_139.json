[{"type": "subtitle", "time": 8343.91, "timestamp": "02:19:03", "text": "为什么？时候到了。"}, {"type": "subtitle", "time": 8346.549, "timestamp": "02:19:06", "text": "我被看到了。"}, {"type": "subtitle", "time": 8350.23, "timestamp": "02:19:10", "text": "阿多拱门就在前面。它似乎"}, {"type": "subtitle", "time": 8366.07, "timestamp": "02:19:26", "text": "诺亚。嘿，我相信它一定能找到路。"}, {"type": "subtitle", "time": 8369.509, "timestamp": "02:19:29", "text": "回到硬件部分。不用担心。现在，"}, {"type": "subtitle", "time": 8371.429, "timestamp": "02:19:31", "text": "我们只需要沿着这条路走下去"}, {"type": "subtitle", "time": 8374.42, "timestamp": "02:19:34", "text": "到达金库。"}]
[{"type": "subtitle", "time": 28325.19, "timestamp": "07:52:05", "text": "你的武器？是的，我不会失去我的"}, {"type": "subtitle", "time": 28327.51, "timestamp": "07:52:07", "text": "如果我死了，我会用武器。是的。好的。哦，"}, {"type": "subtitle", "time": 28329.99, "timestamp": "07:52:09", "text": "是的。你没有。"}, {"type": "subtitle", "time": 28332.948, "timestamp": "07:52:12", "text": "哦，天哪，这个大的，呃，该怎么称呼它呢？"}, {"type": "subtitle", "time": 28343.11, "timestamp": "07:52:23", "text": "哦，我离结尾还差得远呢。"}, {"type": "subtitle", "time": 28345.83, "timestamp": "07:52:25", "text": "顺便一提，这是个游戏。"}, {"type": "subtitle", "time": 28347.91, "timestamp": "07:52:27", "text": "我感觉自己好像走到了一半。我是说，"}, {"type": "subtitle", "time": 28350.948, "timestamp": "07:52:30", "text": "你已经完成了70%左右。嗯，没关系。"}, {"type": "subtitle", "time": 28353.27, "timestamp": "07:52:33", "text": "没关系。好的。谢谢。谢谢你，凉子。"}, {"type": "subtitle", "time": 28361.75, "timestamp": "07:52:41", "text": "每次我喜欢和这家伙一起转身的时候，"}, {"type": "subtitle", "time": 28363.67, "timestamp": "07:52:43", "text": "我转身的那一刻，我的天哪。在哪里"}, {"type": "subtitle", "time": 28366.388, "timestamp": "07:52:46", "text": "是吗？"}, {"type": "subtitle", "time": 28369.11, "timestamp": "07:52:49", "text": "顺便问一下，杰克是不是想开枪打我？"}, {"type": "subtitle", "time": 28371.51, "timestamp": "07:52:51", "text": "哦，原来有敌人。有一个"}, {"type": "subtitle", "time": 28373.91, "timestamp": "07:52:53", "text": "敌人。哦，不。"}, {"type": "subtitle", "time": 28375.75, "timestamp": "07:52:55", "text": "你当时在想什么？我是谁？"}, {"type": "subtitle", "time": 28378.23, "timestamp": "07:52:58", "text": "嗯？"}]
[{"type": "subtitle", "time": 13170.55, "timestamp": "03:39:30", "text": "我的天哪，他重置了。搞什么鬼？"}, {"type": "subtitle", "time": 13172.389, "timestamp": "03:39:32", "text": "现在看来，我最好还是这么做。"}, {"type": "subtitle", "time": 13185.99, "timestamp": "03:39:45", "text": "我受够了。迷路。"}, {"type": "subtitle", "time": 13188.67, "timestamp": "03:39:48", "text": "我会还你十倍的钱。交给它吧"}, {"type": "subtitle", "time": 13193.389, "timestamp": "03:39:53", "text": "我。嘿，我把自己移植进去了"}]
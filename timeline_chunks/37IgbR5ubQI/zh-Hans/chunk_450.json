[{"type": "subtitle", "time": 27005.75, "timestamp": "07:30:05", "text": "你是谁？快离开这里。"}, {"type": "subtitle", "time": 27019.59, "timestamp": "07:30:19", "text": "呃，别再朝我开枪了。我没做"}, {"type": "subtitle", "time": 27026.468, "timestamp": "07:30:26", "text": "如何再次打破僵局？"}, {"type": "subtitle", "time": 27028.99, "timestamp": "07:30:28", "text": "哦，这是一个空格。如果你想的话，可以。"}, {"type": "subtitle", "time": 27032.07, "timestamp": "07:30:32", "text": "想要像心碎一样付出，你可以按"}, {"type": "subtitle", "time": 27034.23, "timestamp": "07:30:34", "text": "空间。哦。"}, {"type": "subtitle", "time": 27037.19, "timestamp": "07:30:37", "text": "哦，对了，各位，呃，没什么事。"}, {"type": "subtitle", "time": 27041.27, "timestamp": "07:30:41", "text": "进入游戏。这是我现实生活中买的东西，但是"}, {"type": "subtitle", "time": 27044.15, "timestamp": "07:30:44", "text": "我现在有张放笔记本电脑的桌子了。反而"}, {"type": "subtitle", "time": 27047.03, "timestamp": "07:30:47", "text": "在我的电脑上进行流媒体播放，"}, {"type": "subtitle", "time": 27049.75, "timestamp": "07:30:49", "text": "我买了一张放笔记本电脑的桌子，这样我就可以……"}, {"type": "subtitle", "time": 27052.708, "timestamp": "07:30:52", "text": "坐着直播而不是"}, {"type": "subtitle", "time": 27059.51, "timestamp": "07:30:59", "text": "带着这种不幸的姿态"}]
[{"type": "subtitle", "time": 16201.03, "timestamp": "04:30:01", "text": "楼主。如果我能得到她。别着急。小恶魔。"}, {"type": "subtitle", "time": 16203.59, "timestamp": "04:30:03", "text": "有什么我可以帮忙的吗？如果我可以"}, {"type": "subtitle", "time": 16211.269, "timestamp": "04:30:11", "text": "上帝。兄弟，看看这个。是楼主。我得到了"}, {"type": "subtitle", "time": 16215.149, "timestamp": "04:30:15", "text": "游戏中最好的武器，对吧？"}, {"type": "subtitle", "time": 16218.99, "timestamp": "04:30:18", "text": "现在。你现在是在跟我开玩笑吗？"}, {"type": "subtitle", "time": 16224.63, "timestamp": "04:30:24", "text": "[音乐]"}, {"type": "subtitle", "time": 16228.79, "timestamp": "04:30:28", "text": "我拿到了游戏里最强的武器。"}]
[{"type": "subtitle", "time": 28803.83, "timestamp": "08:00:03", "text": "坏的。你们在哪儿？我正在使用 Bing。"}, {"type": "subtitle", "time": 28812.75, "timestamp": "08:00:12", "text": "兄弟。我仍然继续"}, {"type": "subtitle", "time": 28827.35, "timestamp": "08:00:27", "text": "不可能。我简直被它吓死了。"}, {"type": "subtitle", "time": 28829.35, "timestamp": "08:00:29", "text": "这是我第七次参加这个活动了。"}, {"type": "subtitle", "time": 28830.19, "timestamp": "08:00:30", "text": "相同的"}, {"type": "subtitle", "time": 28833.03, "timestamp": "08:00:33", "text": "位置，但我一直死，一直死"}, {"type": "subtitle", "time": 28841.31, "timestamp": "08:00:41", "text": "哇，里克先生。"}, {"type": "subtitle", "time": 28845.51, "timestamp": "08:00:45", "text": "[笑声]"}, {"type": "subtitle", "time": 28847.03, "timestamp": "08:00:47", "text": "我不知道自己到底在做什么了。"}, {"type": "subtitle", "time": 28849.51, "timestamp": "08:00:49", "text": "那是你好，维克。"}, {"type": "subtitle", "time": 28852.27, "timestamp": "08:00:52", "text": "你好，杰克先生。为什么不把它钩住呢？"}, {"type": "subtitle", "time": 28855.75, "timestamp": "08:00:55", "text": "一起？ H，否。不，不，谢谢。曾是"}]
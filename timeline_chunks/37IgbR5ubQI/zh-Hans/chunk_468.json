[{"type": "subtitle", "time": 28082.07, "timestamp": "07:48:02", "text": "我在这款游戏中没有受到任何批评。我"}, {"type": "subtitle", "time": 28098.708, "timestamp": "07:48:18", "text": "你想做什么，维克先生？不是先生。"}, {"type": "subtitle", "time": 28100.788, "timestamp": "07:48:20", "text": "威克先生，我是说威克先生。"}, {"type": "subtitle", "time": 28103.43, "timestamp": "07:48:23", "text": "我当时就想，是啊，我没做。"}, {"type": "subtitle", "time": 28106.468, "timestamp": "07:48:26", "text": "任何事物。我真的开枪打中了"}, {"type": "subtitle", "time": 28109.59, "timestamp": "07:48:29", "text": "茫然地看着某人，一脸茫然"}, {"type": "subtitle", "time": 28112.548, "timestamp": "07:48:32", "text": "我当时在场。"}, {"type": "subtitle", "time": 28115.83, "timestamp": "07:48:35", "text": "糟糕。我觉得我死了。哦，不。绝不"}, {"type": "subtitle", "time": 28117.99, "timestamp": "07:48:37", "text": "头脑。我不认为我死了。"}, {"type": "subtitle", "time": 28120.948, "timestamp": "07:48:40", "text": "查克，你为什么要跑？我死了。我会"}, {"type": "subtitle", "time": 28123.43, "timestamp": "07:48:43", "text": "快跑，迪奥。"}, {"type": "subtitle", "time": 28124.948, "timestamp": "07:48:44", "text": "我的天哪。你是什​​么意思？你是什​​么"}, {"type": "subtitle", "time": 28128.07, "timestamp": "07:48:48", "text": "意思是说你得跑了，迪奥？"}, {"type": "subtitle", "time": 28129.91, "timestamp": "07:48:49", "text": "你说的是跑，对吧？比如，为什么你"}, {"type": "subtitle", "time": 28132.628, "timestamp": "07:48:52", "text": "会飞吗？"}, {"type": "subtitle", "time": 28134.468, "timestamp": "07:48:54", "text": "哇。"}, {"type": "subtitle", "time": 28137.27, "timestamp": "07:48:57", "text": "各位，我觉得我什么都做不了。"}, {"type": "subtitle", "time": 28139.35, "timestamp": "07:48:59", "text": "通过这款游戏。"}]
[{"type": "subtitle", "time": 22200.51, "timestamp": "06:10:00", "text": "[音乐]"}, {"type": "subtitle", "time": 22204.59, "timestamp": "06:10:04", "text": "年轻的。哇。虽然不年轻，但是"}, {"type": "subtitle", "time": 22209.868, "timestamp": "06:10:09", "text": "成熟。是的。只有这缕缕灰白的头发。"}, {"type": "subtitle", "time": 22213.43, "timestamp": "06:10:13", "text": "是的。让她看起来很成熟。是的。"}, {"type": "subtitle", "time": 22229.31, "timestamp": "06:10:29", "text": "给她看看布莱克·布鲁姆。"}, {"type": "subtitle", "time": 22231.47, "timestamp": "06:10:31", "text": "图片。"}]
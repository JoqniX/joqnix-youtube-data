[{"type": "subtitle", "time": 21065.11, "timestamp": "05:51:05", "text": "这？没关系。嗯，串流电脑，"}, {"type": "subtitle", "time": 21068.708, "timestamp": "05:51:08", "text": "今天请不要离开我。"}, {"type": "subtitle", "time": 21072.27, "timestamp": "05:51:12", "text": "嗯，你好。那么，我们来进入游戏环节吧。"}, {"type": "subtitle", "time": 21076.59, "timestamp": "05:51:16", "text": "好的，请稍等片刻。我快要……"}, {"type": "subtitle", "time": 21078.67, "timestamp": "05:51:18", "text": "完毕。"}, {"type": "subtitle", "time": 21080.19, "timestamp": "05:51:20", "text": "呃，"}, {"type": "subtitle", "time": 21083.708, "timestamp": "05:51:23", "text": "等等，等等。 Billy Billy 的直播没了？"}, {"type": "subtitle", "time": 21086.67, "timestamp": "05:51:26", "text": "等等，它死了吗？"}, {"type": "subtitle", "time": 21091.47, "timestamp": "05:51:31", "text": "等等，等等。我正在Billy Billy节目上直播，"}, {"type": "subtitle", "time": 21093.59, "timestamp": "05:51:33", "text": "正确的？等等，等等，等等，等等，等等，"}, {"type": "subtitle", "time": 21095.67, "timestamp": "05:51:35", "text": "等待。它说程序崩溃了。崩溃了"}, {"type": "subtitle", "time": 21098.99, "timestamp": "05:51:38", "text": "两次。开始了。好的，好的。"}, {"type": "subtitle", "time": 21101.31, "timestamp": "05:51:41", "text": "好的。哦，"}, {"type": "subtitle", "time": 21104.548, "timestamp": "05:51:44", "text": "好的。呃，我吓坏了。我当时就想，"}, {"type": "subtitle", "time": 21105.548, "timestamp": "05:51:45", "text": "等待，"}, {"type": "subtitle", "time": 21108.19, "timestamp": "05:51:48", "text": "什么？不"}, {"type": "subtitle", "time": 21113.548, "timestamp": "05:51:53", "text": "方式。等等，我这边加载不出来。"}, {"type": "subtitle", "time": 21119.548, "timestamp": "05:51:59", "text": "什么？什么？"}]
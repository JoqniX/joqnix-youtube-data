[{"type": "subtitle", "time": 28502.868, "timestamp": "07:55:02", "text": "“玩这个游戏吗？”我不知道。"}, {"type": "subtitle", "time": 28505.868, "timestamp": "07:55:05", "text": "就说你已经习惯了。是的，就是这样。"}, {"type": "subtitle", "time": 28509.628, "timestamp": "07:55:09", "text": "美好的。嘿，嘿，"}, {"type": "subtitle", "time": 28513.67, "timestamp": "07:55:13", "text": "嘿。是的。我我我玩游戏骗过了警察。我们开始吧"}, {"type": "subtitle", "time": 28516.788, "timestamp": "07:55:16", "text": "走吧，兄弟。终于，我开始做点什么了。"}, {"type": "subtitle", "time": 28520.548, "timestamp": "07:55:20", "text": "在这场游戏中。我们走吧。"}, {"type": "subtitle", "time": 28529.59, "timestamp": "07:55:29", "text": "我的天啊。我的天啊。我的天啊。我的天哪。"}, {"type": "subtitle", "time": 28532.43, "timestamp": "07:55:32", "text": "兄弟。"}, {"type": "subtitle", "time": 28540.15, "timestamp": "07:55:40", "text": "嗯，我不知道我要去哪里。"}, {"type": "subtitle", "time": 28541.91, "timestamp": "07:55:41", "text": "现在这样也行了，不过没关系。我要搬家了。"}, {"type": "subtitle", "time": 28543.43, "timestamp": "07:55:43", "text": "向前。"}, {"type": "subtitle", "time": 28545.99, "timestamp": "07:55:45", "text": "如果你们能看到我的直播，那就是我的"}, {"type": "subtitle", "time": 28547.948, "timestamp": "07:55:47", "text": "这是我的直播间。这就是我"}, {"type": "subtitle", "time": 28550.708, "timestamp": "07:55:50", "text": "看到了。如果有人能来我家就好了"}, {"type": "subtitle", "time": 28553.19, "timestamp": "07:55:53", "text": "直播看看发生了什么，"}]
[{"type": "subtitle", "time": 13082.55, "timestamp": "03:38:02", "text": "如何逼他？"}, {"type": "subtitle", "time": 13089.59, "timestamp": "03:38:09", "text": "释放獠牙。"}, {"type": "subtitle", "time": 13092.269, "timestamp": "03:38:12", "text": "毫不留情。"}, {"type": "subtitle", "time": 13094.99, "timestamp": "03:38:14", "text": "Zapstreng。这是我们的帷幕"}, {"type": "subtitle", "time": 13098.309, "timestamp": "03:38:18", "text": "称呼。我来付钱。早就料到了。撕"}, {"type": "subtitle", "time": 13101.19, "timestamp": "03:38:21", "text": "将它们撕成碎片。"}]
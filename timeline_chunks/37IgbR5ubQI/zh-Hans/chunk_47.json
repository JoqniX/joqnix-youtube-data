[{"type": "subtitle", "time": 2828.15, "timestamp": "00:47:08", "text": "更多的。我怎么还活着？哦，等等。"}, {"type": "subtitle", "time": 2829.67, "timestamp": "00:47:09", "text": "哦，等等。等待。等待。不，这很糟糕。"}, {"type": "subtitle", "time": 2831.109, "timestamp": "00:47:11", "text": "不，不，不，不。继续射击。保持"}, {"type": "subtitle", "time": 2834.23, "timestamp": "00:47:14", "text": "射击。等待。等待。那就是我依然"}, {"type": "subtitle", "time": 2837.19, "timestamp": "00:47:17", "text": "我本该死了。"}, {"type": "subtitle", "time": 2839.91, "timestamp": "00:47:19", "text": "我们没有朋友了。我没看见你。我"}, {"type": "subtitle", "time": 2842.51, "timestamp": "00:47:22", "text": "没看见你。我当时"}, {"type": "subtitle", "time": 2847.79, "timestamp": "00:47:27", "text": "好吧，他死了。好的，我们开始吧"}, {"type": "subtitle", "time": 2850.63, "timestamp": "00:47:30", "text": "看。哦，那是生命值条吗？不"}, {"type": "subtitle", "time": 2858.27, "timestamp": "00:47:38", "text": "嗯？我觉得生命条简直太坑爹了。"}, {"type": "subtitle", "time": 2861.349, "timestamp": "00:47:41", "text": "有些东西会给你带来一定的抵抗力"}, {"type": "subtitle", "time": 2865.19, "timestamp": "00:47:45", "text": "可能是重力之类的原因。是的。"}, {"type": "subtitle", "time": 2866.95, "timestamp": "00:47:46", "text": "你们两个谁发现了这个游戏？"}, {"type": "subtitle", "time": 2870.23, "timestamp": "00:47:50", "text": "这是推荐吗？我找到了。"}, {"type": "subtitle", "time": 2874.55, "timestamp": "00:47:54", "text": "是的，我们找到了，因为我添加了很多东西。"}, {"type": "subtitle", "time": 2878.71, "timestamp": "00:47:58", "text": "来自 Stem DB 的免费游戏。"}]
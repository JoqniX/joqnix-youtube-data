[{"type": "subtitle", "time": 23170.51, "timestamp": "06:26:10", "text": "什么？满满一箱"}, {"type": "subtitle", "time": 23172.93, "timestamp": "06:26:12", "text": "惊喜。谁是"}, {"type": "subtitle", "time": 23180.15, "timestamp": "06:26:20", "text": "你？她头发是白色的。她会脸红"}, {"type": "subtitle", "time": 23183.01, "timestamp": "06:26:23", "text": "头。"}, {"type": "subtitle", "time": 23188.47, "timestamp": "06:26:28", "text": "[音乐]"}, {"type": "subtitle", "time": 23199.45, "timestamp": "06:26:39", "text": "向上。你很有潜力。回答我的问题"}, {"type": "subtitle", "time": 23207.99, "timestamp": "06:26:47", "text": "问题。她很酷。哦，她穿着"}]
[{"type": "subtitle", "time": 27613.51, "timestamp": "07:40:13", "text": "我的天哪！那怪胎到底是什么？"}, {"type": "subtitle", "time": 27616.15, "timestamp": "07:40:16", "text": "那？"}, {"type": "subtitle", "time": 27618.51, "timestamp": "07:40:18", "text": "这就是他们所说的"}, {"type": "subtitle", "time": 27626.07, "timestamp": "07:40:26", "text": "总之，我打算玩蓝色。"}, {"type": "subtitle", "time": 27627.59, "timestamp": "07:40:27", "text": "团队。"}, {"type": "subtitle", "time": 27629.03, "timestamp": "07:40:29", "text": "蓝队。哦，你是队里的成员吗？"}, {"type": "subtitle", "time": 27632.468, "timestamp": "07:40:32", "text": "尽管？嗯，就像……哦，是的。是的。我们走吧。"}, {"type": "subtitle", "time": 27636.15, "timestamp": "07:40:36", "text": "有吗？是的，我有。是时候一起嗨了"}, {"type": "subtitle", "time": 27639.27, "timestamp": "07:40:39", "text": "你的。"}, {"type": "subtitle", "time": 27643.03, "timestamp": "07:40:43", "text": "你是不是感觉像“我的天哪”？"}, {"type": "subtitle", "time": 27646.948, "timestamp": "07:40:46", "text": "我想对罗科做点什么。一"}, {"type": "subtitle", "time": 27657.468, "timestamp": "07:40:57", "text": "完成的。哦。轻弹。我"}]
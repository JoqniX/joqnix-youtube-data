[{"type": "subtitle", "time": 26942.388, "timestamp": "07:29:02", "text": "是的。但杰奎琳在那里。是的。是的。"}, {"type": "subtitle", "time": 26945.27, "timestamp": "07:29:05", "text": "适合家庭入住，但有以下例外"}, {"type": "subtitle", "time": 26947.91, "timestamp": "07:29:07", "text": "我在敲别人的头。我的意思是……"}, {"type": "subtitle", "time": 26949.83, "timestamp": "07:29:09", "text": "是的"}, {"type": "subtitle", "time": 26951.83, "timestamp": "07:29:11", "text": "哎哟。是的，他和别人发生性关系。它是"}, {"type": "subtitle", "time": 26954.628, "timestamp": "07:29:14", "text": "美好的。"}, {"type": "subtitle", "time": 26956.23, "timestamp": "07:29:16", "text": "你在开玩笑吧。他正在和别人发生性关系"}, {"type": "subtitle", "time": 26964.468, "timestamp": "07:29:24", "text": "是的，当时我们正在比赛途中。"}, {"type": "subtitle", "time": 26968.07, "timestamp": "07:29:28", "text": "现在我们可以从头开始了。"}, {"type": "subtitle", "time": 26970.23, "timestamp": "07:29:30", "text": "我不知道我会不会惹上麻烦。"}, {"type": "subtitle", "time": 26973.19, "timestamp": "07:29:33", "text": "故意如此。如果你们等"}, {"type": "subtitle", "time": 26975.59, "timestamp": "07:29:35", "text": "大概持续了三分钟，"}, {"type": "subtitle", "time": 26977.59, "timestamp": "07:29:37", "text": "如果你们等我3分钟的话"}, {"type": "subtitle", "time": 26979.35, "timestamp": "07:29:39", "text": "几分钟后，我会的。是的，我想我们会……"}, {"type": "subtitle", "time": 26982.548, "timestamp": "07:29:42", "text": "两场比赛就结束了。不用担心。是的。"}, {"type": "subtitle", "time": 26985.11, "timestamp": "07:29:45", "text": "你是什​​么意思？最高可达15"}, {"type": "subtitle", "time": 26987.43, "timestamp": "07:29:47", "text": "大概20分钟左右。我的天啊。"}, {"type": "subtitle", "time": 26991.868, "timestamp": "07:29:51", "text": "没关系。我死了。我死了。"}, {"type": "subtitle", "time": 26995.35, "timestamp": "07:29:55", "text": "是的。谁在使用那些枪？我的天哪。"}]
[{"type": "subtitle", "time": 27840.15, "timestamp": "07:44:00", "text": "过来。"}, {"type": "subtitle", "time": 27845.11, "timestamp": "07:44:05", "text": "我的天啊。游戏结束了。 O."}, {"type": "subtitle", "time": 27847.27, "timestamp": "07:44:07", "text": "好的。"}, {"type": "subtitle", "time": 27850.31, "timestamp": "07:44:10", "text": "我抓到你了吗？我抓到你了吗？我觉得我得到了"}, {"type": "subtitle", "time": 27854.31, "timestamp": "07:44:14", "text": "你。没有。我还在那里。好的，我会"}, {"type": "subtitle", "time": 27855.83, "timestamp": "07:44:15", "text": "直播结束。谢谢"}, {"type": "subtitle", "time": 27859.19, "timestamp": "07:44:19", "text": "加入，各位。再见。哦好的。那"}, {"type": "subtitle", "time": 27863.43, "timestamp": "07:44:23", "text": "对我们来说，这就像一次短暂的会面。"}, {"type": "subtitle", "time": 27865.75, "timestamp": "07:44:25", "text": "但你知道，我们玩得很开心。我仍然"}, {"type": "subtitle", "time": 27868.23, "timestamp": "07:44:28", "text": "和你们一起玩。不用担心。"}, {"type": "subtitle", "time": 27871.19, "timestamp": "07:44:31", "text": "好的。"}, {"type": "subtitle", "time": 27872.788, "timestamp": "07:44:32", "text": "哦，你这是要结束直播吗？好的。"}, {"type": "subtitle", "time": 27875.59, "timestamp": "07:44:35", "text": "不。是的。"}, {"type": "subtitle", "time": 27877.91, "timestamp": "07:44:37", "text": "完毕。"}, {"type": "subtitle", "time": 27883.83, "timestamp": "07:44:43", "text": "掸去灰尘。我的天啊。如果这款游戏是"}, {"type": "subtitle", "time": 27889.99, "timestamp": "07:44:49", "text": "简直蠢透了。我不知道"}, {"type": "subtitle", "time": 27897.99, "timestamp": "07:44:57", "text": "好的，我要回去了。"}, {"type": "subtitle", "time": 27898.91, "timestamp": "07:44:58", "text": "和"}]
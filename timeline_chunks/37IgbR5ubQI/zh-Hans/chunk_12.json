[{"type": "subtitle", "time": 720.03, "timestamp": "00:12:00", "text": "好的。在哪里"}, {"type": "subtitle", "time": 722.67, "timestamp": "00:12:02", "text": "是哪里"}, {"type": "subtitle", "time": 747.19, "timestamp": "00:12:27", "text": "正在尝试。它并没有打开世界，或者"}, {"type": "subtitle", "time": 757.269, "timestamp": "00:12:37", "text": "游戏刚刚开始。是的。我应该吗？"}, {"type": "subtitle", "time": 761.03, "timestamp": "00:12:41", "text": "谷歌一下？我应该，我想我应该。"}, {"type": "subtitle", "time": 767.23, "timestamp": "00:12:47", "text": "阿卡迪亚"}]
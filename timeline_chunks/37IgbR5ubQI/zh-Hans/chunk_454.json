[{"type": "subtitle", "time": 27246.07, "timestamp": "07:34:06", "text": "我本来是去那里办别的事，但是"}, {"type": "subtitle", "time": 27248.11, "timestamp": "07:34:08", "text": "我看到这个的时候就想，你知道吗？"}, {"type": "subtitle", "time": 27251.11, "timestamp": "07:34:11", "text": "我会得到邓布利多"}, {"type": "subtitle", "time": 27254.15, "timestamp": "07:34:14", "text": "骑车干点儿事儿。哦，是的。没有人"}, {"type": "subtitle", "time": 27256.23, "timestamp": "07:34:16", "text": "我当时想，他们会去吗？"}, {"type": "subtitle", "time": 27258.388, "timestamp": "07:34:18", "text": "玩这类游戏到2025年将会……"}, {"type": "subtitle", "time": 27265.51, "timestamp": "07:34:25", "text": "你是什​​么意思？你已经完成了"}, {"type": "subtitle", "time": 27267.35, "timestamp": "07:34:27", "text": "下载？"}, {"type": "subtitle", "time": 27269.35, "timestamp": "07:34:29", "text": "是的。"}, {"type": "subtitle", "time": 27273.27, "timestamp": "07:34:33", "text": "好的。我已经准备好了。查马先生，出来吧"}, {"type": "subtitle", "time": 27275.75, "timestamp": "07:34:35", "text": "这"}, {"type": "subtitle", "time": 27279.75, "timestamp": "07:34:39", "text": "大厅。您需要创建一个新的大厅。"}, {"type": "subtitle", "time": 27282.788, "timestamp": "07:34:42", "text": "让我杀了这小鬼。我的意思是，让我"}, {"type": "subtitle", "time": 27287.27, "timestamp": "07:34:47", "text": "戏弄这个小鬼。哇。我们只是在啪啪啪"}, {"type": "subtitle", "time": 27289.67, "timestamp": "07:34:49", "text": "我们在这里等候的时候，其他人也在。好的。"}, {"type": "subtitle", "time": 27291.91, "timestamp": "07:34:51", "text": "等待。哇。我简直不敢相信。让我"}, {"type": "subtitle", "time": 27294.07, "timestamp": "07:34:54", "text": "我也不敢相信。我不能"}, {"type": "subtitle", "time": 27297.35, "timestamp": "07:34:57", "text": "我简直不敢相信。我的天啊。好的。"}, {"type": "subtitle", "time": 27299.31, "timestamp": "07:34:59", "text": "好的。等待。呃"}]
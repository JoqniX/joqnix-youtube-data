[{"type": "subtitle", "time": 841.269, "timestamp": "00:14:01", "text": "问题。这里有一个世界选择。等待，"}, {"type": "subtitle", "time": 844.87, "timestamp": "00:14:04", "text": "我们应该加入吗？等等，试试看"}, {"type": "subtitle", "time": 853.389, "timestamp": "00:14:13", "text": "你。我会加入你们"}, {"type": "subtitle", "time": 868.15, "timestamp": "00:14:28", "text": "理查德？这些人是谁？"}, {"type": "subtitle", "time": 880.55, "timestamp": "00:14:40", "text": "天空，我想我加入你们了。"}, {"type": "subtitle", "time": 888.069, "timestamp": "00:14:48", "text": "你加入了我。是的，我加入了你们。在哪里"}, {"type": "subtitle", "time": 897.35, "timestamp": "00:14:57", "text": "什么船？码头。海滩。"}]
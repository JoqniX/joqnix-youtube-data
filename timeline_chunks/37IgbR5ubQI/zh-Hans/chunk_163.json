[{"type": "subtitle", "time": 9817.99, "timestamp": "02:43:37", "text": "大局已定。苦难随之而来。我如果"}, {"type": "subtitle", "time": 9819.95, "timestamp": "02:43:39", "text": "我选择"}, {"type": "subtitle", "time": 9824.71, "timestamp": "02:43:44", "text": "这。撕成碎片。保持弹药充足。询问"}, {"type": "subtitle", "time": 9827.51, "timestamp": "02:43:47", "text": "调制。"}, {"type": "subtitle", "time": 9835.269, "timestamp": "02:43:55", "text": "一。放马过来吧。"}]
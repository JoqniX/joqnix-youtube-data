[{"type": "subtitle", "time": 23406.83, "timestamp": "06:30:06", "text": "你是一颗非常特别的种子，我非常"}, {"type": "subtitle", "time": 23413.27, "timestamp": "06:30:13", "text": "哦，我听说她会在1.2版本中亮相。"}, {"type": "subtitle", "time": 23416.59, "timestamp": "06:30:16", "text": "哦好的。那我接下来就要努力奋斗了。"}, {"type": "subtitle", "time": 23419.43, "timestamp": "06:30:19", "text": "哦，我真的不想刷这个"}, {"type": "subtitle", "time": 23431.03, "timestamp": "06:30:31", "text": "[音乐]"}, {"type": "subtitle", "time": 23433.35, "timestamp": "06:30:33", "text": "别让我这么轻易就抓住你。"}, {"type": "subtitle", "time": 23440.91, "timestamp": "06:30:40", "text": "时间。"}, {"type": "subtitle", "time": 23447.948, "timestamp": "06:30:47", "text": "哦，我遇到了一个怪人"}, {"type": "subtitle", "time": 23450.91, "timestamp": "06:30:50", "text": "女士。她来自黑人社区"}]
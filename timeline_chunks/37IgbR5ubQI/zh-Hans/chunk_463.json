[{"type": "subtitle", "time": 27788.868, "timestamp": "07:43:08", "text": "钥匙。好的。我是我吗？哦，不。我仍然"}, {"type": "subtitle", "time": 27790.75, "timestamp": "07:43:10", "text": "仍然没有火焰。什么？"}, {"type": "subtitle", "time": 27794.31, "timestamp": "07:43:14", "text": "怪物？它是不是在渲染大型物体？"}, {"type": "subtitle", "time": 27797.75, "timestamp": "07:43:17", "text": "这是怎么回事？哦。呃，直接进去就行了。"}, {"type": "subtitle", "time": 27799.91, "timestamp": "07:43:19", "text": "设置显而易见的选项并更改您的预设"}, {"type": "subtitle", "time": 27803.59, "timestamp": "07:43:23", "text": "到三人左右。"}, {"type": "subtitle", "time": 27805.67, "timestamp": "07:43:25", "text": "我觉得我做不了像 OBS 那样的东西。"}, {"type": "subtitle", "time": 27808.788, "timestamp": "07:43:28", "text": "我在直播 Mr. Jix 的时候设置了一下，但是"}, {"type": "subtitle", "time": 27812.388, "timestamp": "07:43:32", "text": "好的，我稍后会做。"}, {"type": "subtitle", "time": 27815.67, "timestamp": "07:43:35", "text": "我要……哦，我没有空。"}, {"type": "subtitle", "time": 27825.03, "timestamp": "07:43:45", "text": "我可以肯定地说，你们玩得很开心。"}, {"type": "subtitle", "time": 27826.91, "timestamp": "07:43:46", "text": "反正。我想获得自由"}, {"type": "subtitle", "time": 27829.83, "timestamp": "07:43:49", "text": "现在。顺便说一下，我正在卸货，所以……"}, {"type": "subtitle", "time": 27831.75, "timestamp": "07:43:51", "text": "美好的。"}, {"type": "subtitle", "time": 27834.15, "timestamp": "07:43:54", "text": "我想这样应该没问题。啊，等等。我 我"}]
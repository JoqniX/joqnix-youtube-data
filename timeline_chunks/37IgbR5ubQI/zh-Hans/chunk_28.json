[{"type": "subtitle", "time": 1690.029, "timestamp": "00:28:10", "text": "好的。该死。为什么这款游戏这么冷门？"}, {"type": "subtitle", "time": 1704.71, "timestamp": "00:28:24", "text": "座位。我明白了。"}, {"type": "subtitle", "time": 1707.51, "timestamp": "00:28:27", "text": "等等，什么？"}, {"type": "subtitle", "time": 1709.029, "timestamp": "00:28:29", "text": "是的。"}, {"type": "subtitle", "time": 1711.47, "timestamp": "00:28:31", "text": "等等，游戏里有麦克风吗？"}, {"type": "subtitle", "time": 1731.99, "timestamp": "00:28:51", "text": "卷发器？我想那是用来小便的。"}, {"type": "subtitle", "time": 1735.269, "timestamp": "00:28:55", "text": "不，是鼠标光标。当我向左移动时"}, {"type": "subtitle", "time": 1739.789, "timestamp": "00:28:59", "text": "没错，它将寄给我妈妈。嗯？"}]
[{"type": "subtitle", "time": 22443.948, "timestamp": "06:14:03", "text": "哦，它快要说到重点了。"}, {"type": "subtitle", "time": 22445.868, "timestamp": "06:14:05", "text": "什么？什么是"}, {"type": "subtitle", "time": 22448.948, "timestamp": "06:14:08", "text": "这？就好像她在指引我们一样。"}, {"type": "subtitle", "time": 22455.02, "timestamp": "06:14:15", "text": "我们。嗯，这里。我"}, {"type": "subtitle", "time": 22458.83, "timestamp": "06:14:18", "text": "[音乐]"}, {"type": "subtitle", "time": 22461.868, "timestamp": "06:14:21", "text": "知道。想象一下如果是"}, {"type": "subtitle", "time": 22476.31, "timestamp": "06:14:36", "text": "哦，她做了一个……呃，我想是某人"}, {"type": "subtitle", "time": 22478.628, "timestamp": "06:14:38", "text": "竞技场。我不知道。这让我"}, {"type": "subtitle", "time": 22480.75, "timestamp": "06:14:40", "text": "维丽娜"}, {"type": "subtitle", "time": 22485.628, "timestamp": "06:14:45", "text": "感觉他们好像想让我们找到"}, {"type": "subtitle", "time": 22499.07, "timestamp": "06:14:59", "text": "这是"}]
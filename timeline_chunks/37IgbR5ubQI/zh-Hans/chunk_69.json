[{"type": "subtitle", "time": 4153.51, "timestamp": "01:09:13", "text": "我原以为你是一颗星座，但是"}, {"type": "subtitle", "time": 4157.55, "timestamp": "01:09:17", "text": "你现在就像一颗流星。我是一名"}, {"type": "subtitle", "time": 4160.55, "timestamp": "01:09:20", "text": "星座。我可以成为瑞典明星"}, {"type": "subtitle", "time": 4164.39, "timestamp": "01:09:24", "text": "我也这么认为。我不知道。不，"}, {"type": "subtitle", "time": 4166.95, "timestamp": "01:09:26", "text": "星座是"}, {"type": "subtitle", "time": 4170.95, "timestamp": "01:09:30", "text": "哪些地方不能去。我的天哪，我当时"}, {"type": "subtitle", "time": 4173.87, "timestamp": "01:09:33", "text": "应该跳"}, {"type": "subtitle", "time": 4176.309, "timestamp": "01:09:36", "text": "向下。是的，这很难弄明白。"}]
[{"type": "subtitle", "time": 28444.468, "timestamp": "07:54:04", "text": "完毕。我的天，这真是太搞笑了！"}, {"type": "subtitle", "time": 28447.59, "timestamp": "07:54:07", "text": "男人。我不知道。蜘蛛侠。我要去"}, {"type": "subtitle", "time": 28454.07, "timestamp": "07:54:14", "text": "我不知道你是怎么走的。有类似这样的吗？"}, {"type": "subtitle", "time": 28456.708, "timestamp": "07:54:16", "text": "抓钩？我的天哪，我飞起来了。"}, {"type": "subtitle", "time": 28458.51, "timestamp": "07:54:18", "text": "我要来"}, {"type": "subtitle", "time": 28462.07, "timestamp": "07:54:22", "text": "你。我会"}, {"type": "subtitle", "time": 28464.19, "timestamp": "07:54:24", "text": "我要去"}, {"type": "subtitle", "time": 28478.75, "timestamp": "07:54:38", "text": "D. 我的天哪，他居然还有那个"}, {"type": "subtitle", "time": 28495.99, "timestamp": "07:54:55", "text": "如果有人看到我的游戏，而人们……"}, {"type": "subtitle", "time": 28497.67, "timestamp": "07:54:57", "text": "会像这样：“你怎么会这样？”"}]
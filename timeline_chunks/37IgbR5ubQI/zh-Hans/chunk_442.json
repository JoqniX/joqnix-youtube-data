[{"type": "subtitle", "time": 26520.788, "timestamp": "07:22:00", "text": "总之，总之，我们都活着。你好"}, {"type": "subtitle", "time": 26522.39, "timestamp": "07:22:02", "text": "所有人。是Mixo。欢迎回到"}, {"type": "subtitle", "time": 26525.59, "timestamp": "07:22:05", "text": "因为有啊我的频道"}, {"type": "subtitle", "time": 26529.27, "timestamp": "07:22:09", "text": "该死的声音。呃。真恶心。"}, {"type": "subtitle", "time": 26531.51, "timestamp": "07:22:11", "text": "《暴力摩托》太棒了。这是。那是"}, {"type": "subtitle", "time": 26534.07, "timestamp": "07:22:14", "text": "就像玩一款好游戏。就像如果你如果我"}, {"type": "subtitle", "time": 26536.31, "timestamp": "07:22:16", "text": "现在就去玩玩那个游戏，超棒的！"}, {"type": "subtitle", "time": 26540.708, "timestamp": "07:22:20", "text": "令人怀旧的游戏。还有《暴力摩托2》。"}, {"type": "subtitle", "time": 26542.75, "timestamp": "07:22:22", "text": "是的，《暴力摩托》"}, {"type": "subtitle", "time": 26545.35, "timestamp": "07:22:25", "text": "实际上，这是一款非常糟糕的游戏。这样一个"}, {"type": "subtitle", "time": 26548.628, "timestamp": "07:22:28", "text": "热门游戏。是的，的确如此。它很漂亮"}, {"type": "subtitle", "time": 26554.39, "timestamp": "07:22:34", "text": "谁啊，Leo，谁会在乎有毒的东西，当我们"}, {"type": "subtitle", "time": 26558.628, "timestamp": "07:22:38", "text": "玩得开心吗？嗯……我不能……"}, {"type": "subtitle", "time": 26560.868, "timestamp": "07:22:40", "text": "不知道，伙计。我无法同意。"}, {"type": "subtitle", "time": 26563.75, "timestamp": "07:22:43", "text": "那。嘿，嘿，嘿。当你拥有"}, {"type": "subtitle", "time": 26566.39, "timestamp": "07:22:46", "text": "开心就好，什么都不重要了。你玩得很开心。"}, {"type": "subtitle", "time": 26568.628, "timestamp": "07:22:48", "text": "这才是最重要的。"}, {"type": "subtitle", "time": 26571.468, "timestamp": "07:22:51", "text": "我的意思是，我想你是对的。有"}, {"type": "subtitle", "time": 26575.43, "timestamp": "07:22:55", "text": "罗玩得很开心。"}, {"type": "subtitle", "time": 26577.43, "timestamp": "07:22:57", "text": "什么？不，我们说的是……"}]
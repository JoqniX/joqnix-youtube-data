[{"type": "subtitle", "time": 23040.75, "timestamp": "06:24:00", "text": "去。我的天哪，我的阴柔亚麻布撞到了"}, {"type": "subtitle", "time": 23043.43, "timestamp": "06:24:03", "text": "难的。哦，对了，我忘了说我"}, {"type": "subtitle", "time": 23045.83, "timestamp": "06:24:05", "text": "没能完全发挥出她的全部潜力。甚至标题"}, {"type": "subtitle", "time": 23049.03, "timestamp": "06:24:09", "text": "天赋异禀，所以没什么好担心的。"}, {"type": "subtitle", "time": 23051.75, "timestamp": "06:24:11", "text": "做。"}, {"type": "subtitle", "time": 23055.51, "timestamp": "06:24:15", "text": "我只需要解锁boss就可以了。"}, {"type": "subtitle", "time": 23067.868, "timestamp": "06:24:27", "text": "[音乐]"}]
[{"type": "subtitle", "time": 7206.189, "timestamp": "02:00:06", "text": "是的，我最好把它们保存下来。"}, {"type": "subtitle", "time": 7227.43, "timestamp": "02:00:27", "text": "你最近怎么样？这到底是怎么回事？如何"}, {"type": "subtitle", "time": 7229.35, "timestamp": "02:00:29", "text": "你是怎么拍摄的？"}, {"type": "subtitle", "time": 7231.27, "timestamp": "02:00:31", "text": "墙？你是如何拍摄的？"}, {"type": "subtitle", "time": 7241.669, "timestamp": "02:00:41", "text": "我的天啊。你好。"}]
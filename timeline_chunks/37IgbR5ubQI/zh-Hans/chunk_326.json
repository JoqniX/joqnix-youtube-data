[{"type": "subtitle", "time": 19577.51, "timestamp": "05:26:17", "text": "你的。都是她吗？是那个吗？我爱"}, {"type": "subtitle", "time": 19581.75, "timestamp": "05:26:21", "text": "她坐姿真优雅。"}, {"type": "subtitle", "time": 19595.99, "timestamp": "05:26:35", "text": "你们所有人同时出现。我不加班。"}, {"type": "subtitle", "time": 19597.15, "timestamp": "05:26:37", "text": "来吧"}]
[{"type": "subtitle", "time": 24320.03, "timestamp": "06:45:20", "text": "[音乐]"}, {"type": "subtitle", "time": 24323.11, "timestamp": "06:45:23", "text": "用直钩钩住鱼"}, {"type": "subtitle", "time": 24325.948, "timestamp": "06:45:25", "text": "咬。八。"}, {"type": "subtitle", "time": 24328.67, "timestamp": "06:45:28", "text": "嗯。"}, {"type": "subtitle", "time": 24330.708, "timestamp": "06:45:30", "text": "有趣的。你正在寻找的人"}, {"type": "subtitle", "time": 24333.75, "timestamp": "06:45:33", "text": "就在你眼前。由"}, {"type": "subtitle", "time": 24336.03, "timestamp": "06:45:36", "text": "她用右手抱着自己。"}, {"type": "subtitle", "time": 24343.868, "timestamp": "06:45:43", "text": "可爱。你的球来自黑球"}]
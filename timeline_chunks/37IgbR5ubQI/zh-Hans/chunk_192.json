[{"type": "subtitle", "time": 11544.23, "timestamp": "03:12:24", "text": "我们找到的赃物不属于我的工资。"}, {"type": "subtitle", "time": 11546.59, "timestamp": "03:12:26", "text": "一切都是你的了。"}, {"type": "subtitle", "time": 11568.95, "timestamp": "03:12:48", "text": "此时此刻，我觉得自己就像……"}, {"type": "subtitle", "time": 11575.429, "timestamp": "03:12:55", "text": "区域。连支线任务都不做。我"}, {"type": "subtitle", "time": 11578.309, "timestamp": "03:12:58", "text": "也就是说，支线任务不多。"}]
[{"type": "subtitle", "time": 27972.788, "timestamp": "07:46:12", "text": "他走了。"}, {"type": "subtitle", "time": 27976.75, "timestamp": "07:46:16", "text": "我可以以高帧率运行这款游戏吗？"}, {"type": "subtitle", "time": 27981.03, "timestamp": "07:46:21", "text": "不，我应该把它调低一些。"}, {"type": "subtitle", "time": 27984.468, "timestamp": "07:46:24", "text": "好了。好的。它不像……那样卡顿"}, {"type": "subtitle", "time": 27991.23, "timestamp": "07:46:31", "text": "我应该降低"}, {"type": "subtitle", "time": 27994.948, "timestamp": "07:46:34", "text": "一切都是为了最终的前任，呃呃呃，什么？"}, {"type": "subtitle", "time": 27996.83, "timestamp": "07:46:36", "text": "你管它叫什么？为了"}, {"type": "subtitle", "time": 28000.788, "timestamp": "07:46:40", "text": "终极版，专为终极FPS而生。"}, {"type": "subtitle", "time": 28003.03, "timestamp": "07:46:43", "text": "没人需要杀我。我就会死"}, {"type": "subtitle", "time": 28012.15, "timestamp": "07:46:52", "text": "查克，过来。过来，查克。"}]
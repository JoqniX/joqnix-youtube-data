[{"type": "subtitle", "time": 26078.27, "timestamp": "07:14:38", "text": "笨蛋，哦，好的，哦不，哦"}, {"type": "subtitle", "time": 26079.83, "timestamp": "07:14:39", "text": "我的天哪，我想要，為什麼是沒回血，哦，"}, {"type": "subtitle", "time": 26085.948, "timestamp": "07:14:45", "text": "沒關係，它正在回血，營養液什麼的，你現在只想睡覺，我現在不用睡覺了，所以"}, {"type": "subtitle", "time": 26099.868, "timestamp": "07:14:59", "text": "你現在只想睡覺嗎？不，是因為，是因為腳的設定嗎？我不知道，不不，它只會回血，就像它只會在"}]
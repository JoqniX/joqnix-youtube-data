[{"type": "subtitle", "time": 7810.27, "timestamp": "02:10:10", "text": "我來了。我要幹掉所有我看到的敵人。我要幹掉我的第三方"}, {"type": "subtitle", "time": 7813.91, "timestamp": "02:10:13", "text": "部隊。"}, {"type": "subtitle", "time": 7840.27, "timestamp": "02:10:40", "text": "哦，敵人！敵人！好了好了，附近有敵人。不，兄弟，他把我打得好慘，他把我打得好慘。為什麼我的翻譯變成了印地語？"}]
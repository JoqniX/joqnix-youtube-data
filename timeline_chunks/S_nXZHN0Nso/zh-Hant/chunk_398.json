[{"type": "subtitle", "time": 23893.43, "timestamp": "06:38:13", "text": "阿斯拉打"}, {"type": "subtitle", "time": 23897.19, "timestamp": "06:38:17", "text": "PVP，他把我的圖騰買了。"}, {"type": "subtitle", "time": 23900.468, "timestamp": "06:38:20", "text": "兄弟，怎麼獲得圖騰？怎麼製作"}, {"type": "subtitle", "time": 23904.35, "timestamp": "06:38:24", "text": "圖騰？你可以製作圖騰。"}, {"type": "subtitle", "time": 23911.51, "timestamp": "06:38:31", "text": "呃，你得去刷圖騰。有一種叫喚"}, {"type": "subtitle", "time": 23916.67, "timestamp": "06:38:36", "text": "魔者的怪物，你殺了它，它會掉落圖騰。它會掉落圖騰。然後還有一些自訂怪物，對吧？呃，等等，你看到那個掉落"}]
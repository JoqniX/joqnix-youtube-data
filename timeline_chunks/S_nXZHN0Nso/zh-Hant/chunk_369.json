[{"type": "chat", "time": 22142.347, "timestamp": "06:09:02", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "\"well, who said we couldnt prank you to sire\" the townsfolk saying this to the husband"}, {"type": "subtitle", "time": 22146.75, "timestamp": "06:09:06", "text": "是的，這整個礫石區域，我都會……哦，敵人。 [音樂]苦力怕，你知道我比boss強多了，對吧？給我武器，謝謝。你"}, {"type": "subtitle", "time": 22151.35, "timestamp": "06:09:11", "text": "沒有武器，你這無所事事的無武器老鼠，你死定了，苦力怕金幣，謝謝。在這個遊戲裡打苦力怕太容易了。我要走了，呃，我要走了，再見。你好，保重，保重，保重，末"}, {"type": "chat", "time": 22159.787, "timestamp": "06:09:19", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "the husband, now angered by this notion"}, {"type": "chat", "time": 22162.92, "timestamp": "06:09:22", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "double prank"}, {"type": "chat", "time": 22172.852, "timestamp": "06:09:32", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "drew his knife on his waist...."}, {"type": "subtitle", "time": 22183.708, "timestamp": "06:09:43", "text": "影人，哦，天哪，這傢伙真可怕，哦，他生我的氣了。他去哪了？"}, {"type": "chat", "time": 22196.76, "timestamp": "06:09:56", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "he lunged forward and stabbed the guy who carried the child"}, {"type": "chat", "time": 22199.565, "timestamp": "06:09:59", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTF
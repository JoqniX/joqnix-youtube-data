[{"type": "subtitle", "time": 30625.67, "timestamp": "08:30:25", "text": "我可以肯定地說，"}, {"type": "subtitle", "time": 30634.628, "timestamp": "08:30:34", "text": "我做得太棒了。嘿，Jo，你能幫我弄到發光魷魚嗎？我想知道發光的。哦，我們有很多發光墨水，真的嗎？把它們殺了就行了。是的，呃，龍一，讓我先睡一會兒。所以我就這麼做，用回"}, {"type": "subtitle", "time": 30649.628, "timestamp": "08:30:49", "text": "鍵……不，呃，呃。"}]
[{"type": "subtitle", "time": 8956.269, "timestamp": "02:29:16", "text": "3倍鏡嗎？你好，是的，赫蘭，希望你一切都好。敵人就在那裡，我害怕那邊的傢伙，我"}, {"type": "subtitle", "time": 8959.79, "timestamp": "02:29:19", "text": "害怕那邊的傢伙。你"}, {"type": "subtitle", "time": 8976.95, "timestamp": "02:29:36", "text": "覺得單人模式怎麼樣？我是說，呃，"}, {"type": "subtitle", "time": 8978.55, "timestamp": "02:29:38", "text": "護盾的差別有時候真的很重要。哦，嗨，也希望你一切都好。抱歉，"}, {"type": "subtitle", "time": 8988.389, "timestamp": "02:29:48", "text": "我剛看到訊息。單人模式很有趣，它是為像我這樣只想一個人玩的人設計的。啊，真蠢，巴卡，他有能量。槍手，我想換"}, {"type": "subtitle", "time": 8994.03, "timestamp": "02:29:54", "text": "護盾，但是護盾不在那裡。啊，"}]
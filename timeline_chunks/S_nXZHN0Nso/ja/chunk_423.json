[{"type": "subtitle", "time": 25380.59, "timestamp": "07:03:00", "text": "あなたが知っているように、アスラはあなたの"}, {"type": "subtitle", "time": 25382.27, "timestamp": "07:03:02", "text": "基地は安全ではない"}, {"type": "subtitle", "time": 25385.15, "timestamp": "07:03:05", "text": "それが下にない場合は、それが下にない場合は"}, {"type": "subtitle", "time": 25386.83, "timestamp": "07:03:06", "text": "タワーですね"}, {"type": "subtitle", "time": 25389.75, "timestamp": "07:03:09", "text": "つまり、たとえあなたが"}, {"type": "subtitle", "time": 25391.83, "timestamp": "07:03:11", "text": "ボスと戦って探索して"}, {"type": "subtitle", "time": 25395.388, "timestamp": "07:03:15", "text": "そういう時が来るかもしれないと思う"}, {"type": "subtitle", "time": 25397.628, "timestamp": "07:03:17", "text": "お互いを殺し合わなければならない場所、"}, {"type": "subtitle", "time": 25400.628, "timestamp": "07:03:20", "text": "何か、うん、それは本当だ、つまり誰が"}, {"type": "subtitle", "time": 25402.31, "timestamp": "07:03:22", "text": "我々は、"}, {"type": "subtitle", "time": 25405.51, "timestamp": "07:03:25", "text": "自分のチームじゃないよ"}, {"type": "subtitle", "time": 25415.91, "timestamp": "07:03:35", "text": "M つまり、彼が言ったように"}, {"type": "subtitle", "time": 25419.03, "timestamp": "07:03:39", "text": "最初は、ほら、ただ"}, {"type": "subtitle", "time": 25422.19, "timestamp": "07:03:42", "text": "生きている人は一人しかいない、私たちは生きている、"}, {"type": "subtitle", "time": 25436.03, "timestamp": "07:03:56", "text": "シャベル、もしあなたが"}, {"type": "subtitle", "time": 25439.468, "timestamp": "07:03:59", "text": "金色のショーを現実のものにしたい"}]
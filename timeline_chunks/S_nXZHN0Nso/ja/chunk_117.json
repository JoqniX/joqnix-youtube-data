[{"type": "subtitle", "time": 7022.43, "timestamp": "01:57:02", "text": "チャットのものが手に入らなかった"}, {"type": "subtitle", "time": 7024.91, "timestamp": "01:57:04", "text": "通常は、えっと、なんて言うんだっけ"}, {"type": "subtitle", "time": 7028.39, "timestamp": "01:57:08", "text": "チャットのスクリーンショットとか、えっと、"}, {"type": "subtitle", "time": 7031.55, "timestamp": "01:57:11", "text": "チェックして"}, {"type": "subtitle", "time": 7033.109, "timestamp": "01:57:13", "text": "すべて"}, {"type": "subtitle", "time": 7038.27, "timestamp": "01:57:18", "text": "でも最後の配信は、うーん、忘れてた、忘れてた"}, {"type": "subtitle", "time": 7040.95, "timestamp": "01:57:20", "text": "それを保存するため、そういうことが起こったんです。"}, {"type": "subtitle", "time": 7042.99, "timestamp": "01:57:22", "text": "さあ行こう"}, {"type": "subtitle", "time": 7045.709, "timestamp": "01:57:25", "text": "さあ、射撃場に行こう"}, {"type": "subtitle", "time": 7049.589, "timestamp": "01:57:29", "text": "音声が良好であることを願っています。音声が良好であることを願っています。"}, {"type": "subtitle", "time": 7053.669, "timestamp": "01:57:33", "text": "正常に動作しています。良いのでロックを解除しました。"}, {"type": "subtitle", "time": 7056.55, "timestamp": "01:57:36", "text": "ウルタ、そしてさらに、それは"}, {"type": "subtitle", "time": 7061.589, "timestamp": "01:57:41", "text": "よし、行こう。それでは、"}, {"type": "subtitle", "time": 7065.35, "timestamp": "01:57:45", "text": "オルターワンをプレイしよう"}, {"type": "subtitle", "time": 7069.47, "timestamp": "01:57:49", "text": "ああ、神様、私はとても"}, {"type": "subtitle", "time": 7073.189, "timestamp": "01:57:53", "text": "ワクワクする、これは楽しい"}, {"type": "subtitle", "time": 7077.069, "timestamp": "01:57:57", "text": "ということで、ここにはいくつかの変更があり、"}]
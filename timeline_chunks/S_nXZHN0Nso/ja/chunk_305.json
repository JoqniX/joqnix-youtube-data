[{"type": "subtitle", "time": 18300.99, "timestamp": "05:05:00", "text": "このリセット手順は顔だと思います"}, {"type": "subtitle", "time": 18305.35, "timestamp": "05:05:05", "text": "今は、私の"}, {"type": "subtitle", "time": 18309.99, "timestamp": "05:05:09", "text": "手はティッシュを感じないような感じ"}, {"type": "subtitle", "time": 18313.59, "timestamp": "05:05:13", "text": "なんだかリフレッシュした気分だけど、"}, {"type": "subtitle", "time": 18317.31, "timestamp": "05:05:17", "text": "完全にではない"}, {"type": "subtitle", "time": 18321.75, "timestamp": "05:05:21", "text": "リフレッシュしたよ、たまにはね"}, {"type": "subtitle", "time": 18324.07, "timestamp": "05:05:24", "text": "私は実際"}, {"type": "subtitle", "time": 18334.83, "timestamp": "05:05:34", "text": "休息、ああ、それも良いことだ"}, {"type": "subtitle", "time": 18336.788, "timestamp": "05:05:36", "text": "実は私は服を着るのが得意なんです"}, {"type": "subtitle", "time": 18352.91, "timestamp": "05:05:52", "text": "設定と内容"}, {"type": "subtitle", "time": 18356.07, "timestamp": "05:05:56", "text": "そうでなければ、私は物資が不足することはないはずだ"}, {"type": "subtitle", "time": 18359.31, "timestamp": "05:05:59", "text": "について話す"}]
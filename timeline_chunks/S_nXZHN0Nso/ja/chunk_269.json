[{"type": "subtitle", "time": 16143.149, "timestamp": "04:29:03", "text": "私の運転免許証Pは"}, {"type": "subtitle", "time": 16144.51, "timestamp": "04:29:04", "text": "12月"}, {"type": "subtitle", "time": 16148.309, "timestamp": "04:29:08", "text": "27日なので、ええと、今日は実際に"}, {"type": "subtitle", "time": 16152.309, "timestamp": "04:29:12", "text": "授業は実際には午後2時からです。そうですね、"}, {"type": "subtitle", "time": 16155.309, "timestamp": "04:29:15", "text": "午前中はできないと思います"}, {"type": "subtitle", "time": 16158.389, "timestamp": "04:29:18", "text": "そのため午後の配信なので"}, {"type": "subtitle", "time": 16162.229, "timestamp": "04:29:22", "text": "今日はやめようと思った"}, {"type": "subtitle", "time": 16165.51, "timestamp": "04:29:25", "text": "Asad と一緒に、もしかしたらストリーミング配信するかもしれません"}, {"type": "subtitle", "time": 16175.87, "timestamp": "04:29:35", "text": "ええ、今日は月曜日です。今日は"}, {"type": "subtitle", "time": 16179.79, "timestamp": "04:29:39", "text": "今日は月曜日です。"}, {"type": "subtitle", "time": 16182.71, "timestamp": "04:29:42", "text": "はい、そうですね"}, {"type": "subtitle", "time": 16185.83, "timestamp": "04:29:45", "text": "ええ、それではニュースに移りましょう"}, {"type": "subtitle", "time": 16188.99, "timestamp": "04:29:48", "text": "今日は、それで、"}, {"type": "subtitle", "time": 16192.03, "timestamp": "04:29:52", "text": "私は天気予報士になるのでしょうか"}, {"type": "subtitle", "time": 16196.389, "timestamp": "04:29:56", "text": "敵の少年"}]
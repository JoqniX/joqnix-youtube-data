[{"type": "subtitle", "time": 7800.549, "timestamp": "02:10:00", "text": "えっ、なんてことだ、怖かったよ、あ、待って、"}, {"type": "subtitle", "time": 7802.549, "timestamp": "02:10:02", "text": "リスポーンを忘れた、忘れた"}, {"type": "subtitle", "time": 7804.27, "timestamp": "02:10:04", "text": "復讐のために戻ってくるよ"}, {"type": "subtitle", "time": 7807.549, "timestamp": "02:10:07", "text": "こんにちは、JPさん"}, {"type": "subtitle", "time": 7810.27, "timestamp": "02:10:10", "text": "ようこそ、私は死者を迎えに来た"}, {"type": "subtitle", "time": 7813.91, "timestamp": "02:10:13", "text": "私が参加するパーティー"}, {"type": "subtitle", "time": 7823.91, "timestamp": "02:10:23", "text": "待って、私には無理だと思う。"}, {"type": "subtitle", "time": 7825.91, "timestamp": "02:10:25", "text": "冗談でしょ？冗談じゃないよね？"}, {"type": "subtitle", "time": 7827.31, "timestamp": "02:10:27", "text": "そうですね"}, {"type": "subtitle", "time": 7840.27, "timestamp": "02:10:40", "text": "俺だよ、あ、待てよ、俺も武器を手に入れるんだ、何だって？"}, {"type": "subtitle", "time": 7851.069, "timestamp": "02:10:51", "text": "美しいですね、わかりました、荷物を積み込んでそこへ行きます"}, {"type": "subtitle", "time": 7858.99, "timestamp": "02:10:58", "text": "ああ、私が愛する相棒だ"}]
[{"type": "subtitle", "time": 6420.51, "timestamp": "01:47:00", "text": "残念ながら、ビリーはできませんでした"}, {"type": "subtitle", "time": 6424.87, "timestamp": "01:47:04", "text": "ビリー、私はとても、ええ、私は私が見つけた"}, {"type": "subtitle", "time": 6428.99, "timestamp": "01:47:08", "text": "とても安い、より良いサービス"}, {"type": "subtitle", "time": 6432.79, "timestamp": "01:47:12", "text": "私は、えーと、あの"}, {"type": "subtitle", "time": 6437.229, "timestamp": "01:47:17", "text": "いくらだったの？10ドル、7ドルの植物、えっと、だから私は"}, {"type": "subtitle", "time": 6439.99, "timestamp": "01:47:19", "text": "8つか16のプラットフォームにストリーミングするか、"}, {"type": "subtitle", "time": 6442.629, "timestamp": "01:47:22", "text": "Facebookで配信できるように何か"}, {"type": "subtitle", "time": 6445.229, "timestamp": "01:47:25", "text": "そしてキックして韓国人のように"}, {"type": "subtitle", "time": 6449.149, "timestamp": "01:47:29", "text": "プラットフォーム、彼の名前を忘れたんだけど、えっと、ナバだったかな"}, {"type": "subtitle", "time": 6451.91, "timestamp": "01:47:31", "text": "それから、もう1つあります"}, {"type": "subtitle", "time": 6454.43, "timestamp": "01:47:34", "text": "私が欲しいプラットフォームは"}, {"type": "subtitle", "time": 6457.35, "timestamp": "01:47:37", "text": "目"}, {"type": "subtitle", "time": 6461.109, "timestamp": "01:47:41", "text": "私がここにいることを忘れていました。はい、こんにちは。私はTCHにいます。"}, {"type": "subtitle", "time": 6462.79, "timestamp": "01:47:42", "text": "はい、こんにちは"}, {"type": "subtitle", "time": 6465.43, "timestamp": "01:47:45", "text": "行く"}, {"type": "subtitle", "time": 6469.91, "timestamp": "01:47:49", "text": "パックしたので、ついにできました"}, {"type": "subtitle", "time": 6470.83, "timestamp": "01:47:50", "text": "の"}, {"type": "subtitle", "time": 6473.83, "timestamp": "01:47:53", "text": "課題は、ええ、私は"}, {"type": "subtitle", "time": 6477.99, "timestamp": "01:47:57", "text": "皮膚と材料を手に入れて"}]
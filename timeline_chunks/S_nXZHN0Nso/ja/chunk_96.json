[{"type": "subtitle", "time": 5763.59, "timestamp": "01:36:03", "text": "こんにちは、これらは活動的な人々です"}, {"type": "subtitle", "time": 5765.99, "timestamp": "01:36:05", "text": "チャットで今日私と話しました"}, {"type": "subtitle", "time": 5768.75, "timestamp": "01:36:08", "text": "ストリームとすべてのlersは"}, {"type": "subtitle", "time": 5772.709, "timestamp": "01:36:12", "text": "ストリームに来て、こんにちは"}, {"type": "subtitle", "time": 5777.229, "timestamp": "01:36:17", "text": "Twitchでお会いしましょう"}, {"type": "subtitle", "time": 5779.629, "timestamp": "01:36:19", "text": "明日最も"}, {"type": "subtitle", "time": 5784.109, "timestamp": "01:36:24", "text": "明日はおそらく"}, {"type": "subtitle", "time": 5785.629, "timestamp": "01:36:25", "text": "そうだね"}, {"type": "subtitle", "time": 5788.91, "timestamp": "01:36:28", "text": "もう十分だから、これで失礼します"}, {"type": "subtitle", "time": 5792.629, "timestamp": "01:36:32", "text": "疲れたので、終わった後にやります"}, {"type": "subtitle", "time": 5796.03, "timestamp": "01:36:36", "text": "少しリラックスした後、ストリームが"}, {"type": "subtitle", "time": 5800.91, "timestamp": "01:36:40", "text": "はい、3時間目の配信に来てください。"}, {"type": "subtitle", "time": 5804.03, "timestamp": "01:36:44", "text": "短いけど、それでも節約しなくてはならない"}, {"type": "subtitle", "time": 5807.59, "timestamp": "01:36:47", "text": "私のエネルギーはストリーミングすべきではないと思います"}, {"type": "subtitle", "time": 5812.99, "timestamp": "01:36:52", "text": "多すぎるけど、うんうんだから私は"}, {"type": "subtitle", "time": 5815.149, "timestamp": "01:36:55", "text": "みんなに会えるのは"}, {"type": "subtitle", "time": 5818.07, "timestamp": "01:36:58", "text": "ベッド、次のアカウントで配信するかもしれない"}]
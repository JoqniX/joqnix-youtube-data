[{"type": "subtitle", "time": 18016.39, "timestamp": "05:00:16", "text": "ああ、今日は国連だったので準備不足でした。"}, {"type": "subtitle", "time": 18018.67, "timestamp": "05:00:18", "text": "サイ"}, {"type": "subtitle", "time": 18022.43, "timestamp": "05:00:22", "text": "私にとってそれは、"}, {"type": "subtitle", "time": 18023.51, "timestamp": "05:00:23", "text": "電話"}, {"type": "subtitle", "time": 18028.03, "timestamp": "05:00:28", "text": "それは、自分が"}, {"type": "subtitle", "time": 18031.628, "timestamp": "05:00:31", "text": "えっと、でもそれをどう呼ぶんですか"}, {"type": "subtitle", "time": 18033.67, "timestamp": "05:00:33", "text": "あなたが知っている"}, {"type": "subtitle", "time": 18038.83, "timestamp": "05:00:38", "text": "G と関係するものは限られています"}, {"type": "subtitle", "time": 18041.788, "timestamp": "05:00:41", "text": "あなたが制限しているものも、"}, {"type": "subtitle", "time": 18045.19, "timestamp": "05:00:45", "text": "外に出られることを知っておいてください"}, {"type": "subtitle", "time": 18048.868, "timestamp": "05:00:48", "text": "箱、待って、まるで箱の中にいるみたいだ"}, {"type": "subtitle", "time": 18052.03, "timestamp": "05:00:52", "text": "脱出方法は知っているが、"}, {"type": "subtitle", "time": 18055.27, "timestamp": "05:00:55", "text": "周囲には他にも箱があることを知っておいてください。"}, {"type": "subtitle", "time": 18056.948, "timestamp": "05:00:56", "text": "種の"}]
[{"type": "subtitle", "time": 19682.99, "timestamp": "05:28:02", "text": "簡略化して基本にして"}, {"type": "subtitle", "time": 19685.91, "timestamp": "05:28:05", "text": "楽しい戦いのように簡単に"}, {"type": "subtitle", "time": 19689.91, "timestamp": "05:28:09", "text": "みんなのために みんなのために"}, {"type": "subtitle", "time": 19693.27, "timestamp": "05:28:13", "text": "あらゆるプレイスタイルに対応"}, {"type": "subtitle", "time": 19695.39, "timestamp": "05:28:15", "text": "だから私は"}, {"type": "subtitle", "time": 19700.03, "timestamp": "05:28:20", "text": "正直に言うと、"}, {"type": "subtitle", "time": 19704.03, "timestamp": "05:28:24", "text": "うん、そうなると思う"}, {"type": "subtitle", "time": 19711.07, "timestamp": "05:28:31", "text": "おそらく簡略版のようなものですよね？"}, {"type": "subtitle", "time": 19715.15, "timestamp": "05:28:35", "text": "おそらく、小道具をきちんと分解する必要があるでしょう"}, {"type": "subtitle", "time": 19717.83, "timestamp": "05:28:37", "text": "バージョンはわかりました。では、私は何をすればいいのでしょうか？"}, {"type": "subtitle", "time": 19722.47, "timestamp": "05:28:42", "text": "今日は、えっと、4月1日です。"}, {"type": "subtitle", "time": 19724.83, "timestamp": "05:28:44", "text": "開店前にやらなければならないことがいくつかあった"}, {"type": "subtitle", "time": 19728.47, "timestamp": "05:28:48", "text": "Minecraft でこれらを全部終わらせよう"}]
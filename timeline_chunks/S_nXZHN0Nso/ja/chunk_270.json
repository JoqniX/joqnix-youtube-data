[{"type": "subtitle", "time": 16201.109, "timestamp": "04:30:01", "text": "それで、私は最近"}, {"type": "subtitle", "time": 16203.59, "timestamp": "04:30:03", "text": "ストリームで「うん、これを試してみるよ」と言った"}, {"type": "subtitle", "time": 16206.87, "timestamp": "04:30:06", "text": "天気予報は、えーっと、どれ"}, {"type": "subtitle", "time": 16209.189, "timestamp": "04:30:09", "text": "えーっと、まあ、私は"}, {"type": "subtitle", "time": 16212.349, "timestamp": "04:30:12", "text": "天気とその他すべて"}, {"type": "subtitle", "time": 16214.87, "timestamp": "04:30:14", "text": "それが計画だったけど、今はこう考えている"}, {"type": "subtitle", "time": 16216.55, "timestamp": "04:30:16", "text": "どのように"}, {"type": "subtitle", "time": 16220.109, "timestamp": "04:30:20", "text": "私は配布します"}, {"type": "subtitle", "time": 16222.309, "timestamp": "04:30:22", "text": "それは"}, {"type": "subtitle", "time": 16225.91, "timestamp": "04:30:25", "text": "内容は、"}, {"type": "subtitle", "time": 16229.71, "timestamp": "04:30:29", "text": "少なくとも私にとっては難しいです。"}, {"type": "subtitle", "time": 16231.87, "timestamp": "04:30:31", "text": "なんて言うんだっけ？"}, {"type": "subtitle", "time": 16237.429, "timestamp": "04:30:37", "text": "自分の州に限定すべきでしょうか？"}, {"type": "subtitle", "time": 16239.99, "timestamp": "04:30:39", "text": "予報が"}, {"type": "subtitle", "time": 16243.189, "timestamp": "04:30:43", "text": "インドですが、インドは国ですが、"}, {"type": "subtitle", "time": 16244.309, "timestamp": "04:30:44", "text": "たくさんの"}, {"type": "subtitle", "time": 16247.67, "timestamp": "04:30:47", "text": "どれを使うべきか教えてください"}, {"type": "subtitle", "time": 16250.55, "timestamp": "04:30:50", "text": "州は使用すべきか、それとも単に使用すべきか"}, {"type": "subtitle", "time": 16254.189, "timestamp": "04:30:54", "text": "インド全体として滞在"}, {"type": "subtitle", "time": 16258.03, "timestamp": "04:30:58", "text": "各州にとってより良い"}]
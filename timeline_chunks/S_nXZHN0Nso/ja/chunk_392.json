[{"type": "subtitle", "time": 23525.628, "timestamp": "06:32:05", "text": "死ぬかもしれないけど、もっと強くならなきゃいけないんだよね？"}, {"type": "subtitle", "time": 23529.75, "timestamp": "06:32:09", "text": "[音楽]"}, {"type": "subtitle", "time": 23538.07, "timestamp": "06:32:18", "text": "CH ボス戦は"}, {"type": "subtitle", "time": 23540.708, "timestamp": "06:32:20", "text": "私が滑り込むのは簡単だが、"}, {"type": "subtitle", "time": 23541.99, "timestamp": "06:32:21", "text": "もの"}, {"type": "subtitle", "time": 23545.99, "timestamp": "06:32:25", "text": "ボスが問題を起こしている"}, {"type": "subtitle", "time": 23549.75, "timestamp": "06:32:29", "text": "もしaialがファンダムみたいなものなら、私はもうおしまいだ"}, {"type": "subtitle", "time": 23553.19, "timestamp": "06:32:33", "text": "私はボスと戦うことができません"}, {"type": "subtitle", "time": 23556.19, "timestamp": "06:32:36", "text": "そこには私の現在の弱点が漂っていた"}, {"type": "subtitle", "time": 23558.27, "timestamp": "06:32:38", "text": "そういうことなら、私は"}, {"type": "subtitle", "time": 23564.51, "timestamp": "06:32:44", "text": "私の署名"}, {"type": "subtitle", "time": 23568.548, "timestamp": "06:32:48", "text": "私の特徴的な戦闘スタイルである弓と武器"}, {"type": "subtitle", "time": 23571.23, "timestamp": "06:32:51", "text": "そのトレーニングのために矢印を作りたいのですが"}, {"type": "subtitle", "time": 23579.99, "timestamp": "06:32:59", "text": "アリーナで、ターゲット練習ができるように"}]
[{"type": "subtitle", "time": 15541.309, "timestamp": "04:19:01", "text": "食事前と食事後"}, {"type": "subtitle", "time": 15544.63, "timestamp": "04:19:04", "text": "夕食後一緒に"}, {"type": "subtitle", "time": 15546.59, "timestamp": "04:19:06", "text": "それで何が起こったかというと、私の"}, {"type": "subtitle", "time": 15549.63, "timestamp": "04:19:09", "text": "体がこの薬に慣れていなかった"}, {"type": "subtitle", "time": 15552.429, "timestamp": "04:19:12", "text": "初めてこれを服用します"}, {"type": "subtitle", "time": 15557.389, "timestamp": "04:19:17", "text": "そのため、それは完全に"}, {"type": "subtitle", "time": 15560.109, "timestamp": "04:19:20", "text": "寝ていた時のことを何と呼ぶか"}, {"type": "subtitle", "time": 15563.55, "timestamp": "04:19:23", "text": "ぐっすり眠っていると目が覚めない"}, {"type": "subtitle", "time": 15567.429, "timestamp": "04:19:27", "text": "12時間くらいだったけど、目が覚めたけど"}, {"type": "subtitle", "time": 15569.99, "timestamp": "04:19:29", "text": "また眠くなったので、"}, {"type": "subtitle", "time": 15572.07, "timestamp": "04:19:32", "text": "寝て、寝て、寝る"}, {"type": "subtitle", "time": 15575.99, "timestamp": "04:19:35", "text": "昨日は一晩中、実際には一日中"}, {"type": "subtitle", "time": 15580.309, "timestamp": "04:19:40", "text": "ええ、私には何もできませんでした"}, {"type": "subtitle", "time": 15583.189, "timestamp": "04:19:43", "text": "うん、すごい"}, {"type": "subtitle", "time": 15586.51, "timestamp": "04:19:46", "text": "ええ、それは"}, {"type": "subtitle", "time": 15591.59, "timestamp": "04:19:51", "text": "だから今日は、えーと、続けよう"}, {"type": "subtitle", "time": 15594.189, "timestamp": "04:19:54", "text": "物事について"}, {"type": "subtitle", "time": 15599.109, "timestamp": "04:19:59", "text": "えーっと、今週はこれで終わりです。"}]
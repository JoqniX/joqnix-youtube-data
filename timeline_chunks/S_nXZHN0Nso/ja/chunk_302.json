[{"type": "subtitle", "time": 18123.59, "timestamp": "05:02:03", "text": "インドは獣医のことが好きだが、私は"}, {"type": "subtitle", "time": 18127.31, "timestamp": "05:02:07", "text": "準備して、どうやって"}, {"type": "subtitle", "time": 18132.27, "timestamp": "05:02:12", "text": "それはペイントだと言って天気予報に行く"}, {"type": "subtitle", "time": 18135.39, "timestamp": "05:02:15", "text": "私が最近最後に言ったことは"}, {"type": "subtitle", "time": 18138.708, "timestamp": "05:02:18", "text": "今ストリーミングしようと思う、ああ、そうすべきだ"}, {"type": "subtitle", "time": 18139.67, "timestamp": "05:02:19", "text": "持っている"}, {"type": "subtitle", "time": 18141.868, "timestamp": "05:02:21", "text": "中を見てみるべきだったと思った"}, {"type": "subtitle", "time": 18144.628, "timestamp": "05:02:24", "text": "準備してから話す必要があること"}, {"type": "subtitle", "time": 18151.75, "timestamp": "05:02:31", "text": "集中したけど、代わりにこうしました"}, {"type": "subtitle", "time": 18155.39, "timestamp": "05:02:35", "text": "早朝の無料トーク"}, {"type": "subtitle", "time": 18160.19, "timestamp": "05:02:40", "text": "話すのでASA ASAは朝を意味します"}, {"type": "subtitle", "time": 18171.35, "timestamp": "05:02:51", "text": "ストリームなので、これが最初の"}, {"type": "subtitle", "time": 18174.83, "timestamp": "05:02:54", "text": "最初のシリーズなので、私は"}, {"type": "subtitle", "time": 18177.39, "timestamp": "05:02:57", "text": "考えは、もし私が"}]
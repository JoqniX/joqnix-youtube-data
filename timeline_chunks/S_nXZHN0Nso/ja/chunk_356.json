[{"type": "subtitle", "time": 21363.868, "timestamp": "05:56:03", "text": "4月は希望を失った"}, {"type": "subtitle", "time": 21367.628, "timestamp": "05:56:07", "text": "子供と夫の良い思い出"}, {"type": "subtitle", "time": 21369.5, "timestamp": "05:56:09", "text": "いいえ"}, {"type": "subtitle", "time": 21370.948, "timestamp": "05:56:10", "text": "[音楽]"}, {"type": "chat", "time": 21376.707, "timestamp": "05:56:16", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "\"why did this happened to u....to me, who harbored no ill will against anyone....\""}, {"type": "chat", "time": 21390.071, "timestamp": "05:56:30", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "she waited for the flamed to spread around and engulf her body"}, {"type": "subtitle", "time": 21392.628, "timestamp": "05:56:32", "text": "いいえ、私に何が起こったのか"}, {"type": "chat", "time": 21393.68, "timestamp": "05:56:33", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4"}, {"type": "subtitle", "time": 21395.99, "timestamp": "05:56:35", "text": "誰に対しても悪意はありません、あなたは"}, {"type": "chat", "time": 21400.66, "timestamp": "05:56:40", "author": "@SuzukiZurikoVTuber", "avatar": "https://yt4.ggpht.com/852SZLheWUnfQGntgjphW0AD17oXLR9MhuzMLEzOm451wzhCllgmSUMTMpDu7wtBK7HSHR9J=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2Ak"}, {"type": "subtitle", "time": 21401.11, "timestamp": "05:56:41", "text": "炎が体に広がる理由がわからない"}, {"type": "chat", "time": 21403.143, "timestamp": "05:56:43", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4"}, {"type": "subtitle", "time": 21404.468, "timestamp": "05:56:44", "text": "いたずらじゃないですか"}, {"type": "chat", "time": 21405.376, "timestamp": "05:56:45", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "suddenly, she noticed the flamed werent spreading"}, {"type": "subtitle", "time": 21406.51, "timestamp": "05:56:46", "text": "なぜ"}, {"type": "subtitle", "time": 21408.628, "timestamp": "05:56:48", "text": "いいえ、それは"}, {"type": "subtitle", "time": 21413.11, "timestamp": "05:56:53", "text": "いたずら なぜ何を知っているのか炎"}, {"type": "chat", "time": 21416.321, "timestamp": "05:56:56", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/b8IfY7zOK9iVkNAP_I2A-AY"}, {"type": "chat", "time": 21418.553, "timestamp": "05:56:58", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/b8IfY7zOK9iVkNAP_I2A-AY"}, {"type": "subtitle", "time": 21419.07, "timestamp": "05:56:59", "text": "終わったってからかってるの？"}]
[{"type": "subtitle", "time": 15851.349, "timestamp": "04:24:11", "text": "えーっと、それで私は"}, {"type": "subtitle", "time": 15854.91, "timestamp": "04:24:14", "text": "僕の名前はニックだって知ってるよね？"}, {"type": "subtitle", "time": 15857.83, "timestamp": "04:24:17", "text": "今日は、"}, {"type": "subtitle", "time": 15861.63, "timestamp": "04:24:21", "text": "今日の配信は、あなたがオハジを持っているように"}, {"type": "subtitle", "time": 15866.229, "timestamp": "04:24:26", "text": "そうだよね、君たちは、AAOKは"}, {"type": "subtitle", "time": 15869.71, "timestamp": "04:24:29", "text": "えっと、名前のやつが必要なんです"}, {"type": "subtitle", "time": 15872.79, "timestamp": "04:24:32", "text": "そう、私は名前をつけるのが苦手で、もし"}, {"type": "subtitle", "time": 15875.87, "timestamp": "04:24:35", "text": "あなたは私を名前で意味的に連れて行くので私はとても"}, {"type": "subtitle", "time": 15891.91, "timestamp": "04:24:51", "text": "えっと、なんて言うんだっけ、探したいんだけど"}, {"type": "subtitle", "time": 15893.67, "timestamp": "04:24:53", "text": "名前"}, {"type": "subtitle", "time": 15897.99, "timestamp": "04:24:57", "text": "君たちにとって楽になるよ"}]
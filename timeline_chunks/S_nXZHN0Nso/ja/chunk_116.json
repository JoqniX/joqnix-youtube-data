[{"type": "subtitle", "time": 6960.669, "timestamp": "01:56:00", "text": "以前は、そして今はただプレイする必要がある"}, {"type": "subtitle", "time": 6963.189, "timestamp": "01:56:03", "text": "ゲーム、ああ、始める前に"}, {"type": "subtitle", "time": 6965.79, "timestamp": "01:56:05", "text": "ゲームでは実際に新しいものをすべてチェックします"}, {"type": "subtitle", "time": 6968.47, "timestamp": "01:56:08", "text": "お菓子をもらってからゲームを始めます"}, {"type": "subtitle", "time": 6970.229, "timestamp": "01:56:10", "text": "そうそうそうそうそうそれが私たち"}, {"type": "subtitle", "time": 6984.03, "timestamp": "01:56:24", "text": "えっと、ちょっと手早くやらせて"}, {"type": "subtitle", "time": 6985.069, "timestamp": "01:56:25", "text": "えっと"}, {"type": "subtitle", "time": 6986.79, "timestamp": "01:56:26", "text": "わかった"}, {"type": "subtitle", "time": 6990.109, "timestamp": "01:56:30", "text": "えっと、翻訳が抜けてるかな？"}, {"type": "subtitle", "time": 6992.629, "timestamp": "01:56:32", "text": "右翻訳者"}, {"type": "subtitle", "time": 6995.79, "timestamp": "01:56:35", "text": "停電が起きたら、神様、何か"}, {"type": "subtitle", "time": 6998.709, "timestamp": "01:56:38", "text": "すべてを手に入れるのは大変です"}, {"type": "subtitle", "time": 7003.39, "timestamp": "01:56:43", "text": "仕事は順調で、時々、"}, {"type": "subtitle", "time": 7006.95, "timestamp": "01:56:46", "text": "やるべきことがあるのを忘れて、ET それは"}, {"type": "subtitle", "time": 7009.149, "timestamp": "01:56:49", "text": "ちょっと慌ただしい"}, {"type": "subtitle", "time": 7012.03, "timestamp": "01:56:52", "text": "時々ですが、それはそういうものであり、"}, {"type": "subtitle", "time": 7015.109, "timestamp": "01:56:55", "text": "わかった、画面を1つ吹き飛ばすよ"}, {"type": "subtitle", "time": 7019.03, "timestamp": "01:56:59", "text": "2番目、えっと、最後のビリービリーストリーム"}]
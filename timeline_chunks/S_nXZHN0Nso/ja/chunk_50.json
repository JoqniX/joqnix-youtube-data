[{"type": "subtitle", "time": 3044.67, "timestamp": "00:50:44", "text": "ああ、もう彼女を殺しちゃおう"}, {"type": "subtitle", "time": 3047.349, "timestamp": "00:50:47", "text": "一体何にそんなに時間がかかっているんだ"}, {"type": "subtitle", "time": 3048.95, "timestamp": "00:50:48", "text": "ああ神様、私は"}, {"type": "subtitle", "time": 3051.67, "timestamp": "00:50:51", "text": "何が原因か確認して"}, {"type": "subtitle", "time": 3058.71, "timestamp": "00:50:58", "text": "ああ、神様、本当に？"}]
[{"type": "subtitle", "time": 25581.23, "timestamp": "07:06:21", "text": "もっとこれらを避けさせてください"}, {"type": "subtitle", "time": 25588.27, "timestamp": "07:06:28", "text": "削除しました。シャベルを置く必要があります。"}, {"type": "subtitle", "time": 25598.59, "timestamp": "07:06:38", "text": "無限に"}, {"type": "subtitle", "time": 25600.11, "timestamp": "07:06:40", "text": "矢印"}, {"type": "subtitle", "time": 25602.67, "timestamp": "07:06:42", "text": "ああ、そう、そこには"}, {"type": "subtitle", "time": 25604.83, "timestamp": "07:06:44", "text": "魔法をかけることしかできないもの"}, {"type": "subtitle", "time": 25607.07, "timestamp": "07:06:47", "text": "武器は一度しか持てない"}, {"type": "subtitle", "time": 25609.67, "timestamp": "07:06:49", "text": "一つの魔法、私はそれが嫌いだ、そう、私"}, {"type": "subtitle", "time": 25613.67, "timestamp": "07:06:53", "text": "魔法が多すぎる"}, {"type": "subtitle", "time": 25616.548, "timestamp": "07:06:56", "text": "つばを付けられるとしたら、今も同じです。"}, {"type": "subtitle", "time": 25619.388, "timestamp": "07:06:59", "text": "霜のようなものすべて"}]
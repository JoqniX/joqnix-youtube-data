[{"type": "subtitle", "time": 24961.91, "timestamp": "06:56:01", "text": "ブレード イェーイェー アー イェーイェーイェーイェー"}, {"type": "subtitle", "time": 24963.468, "timestamp": "06:56:03", "text": "うんうん、それがカスタムモブだよ"}, {"type": "subtitle", "time": 24965.23, "timestamp": "06:56:05", "text": "だから、彼らからトーテムをもらうんだ。"}, {"type": "subtitle", "time": 24968.15, "timestamp": "06:56:08", "text": "また、召喚獣のようなモブを解放し、"}, {"type": "subtitle", "time": 24970.27, "timestamp": "06:56:10", "text": "氷のバイオームで、もしあなたが落とすと"}, {"type": "subtitle", "time": 24973.11, "timestamp": "06:56:13", "text": "彼を倒すと、トーテムがドロップされます"}, {"type": "subtitle", "time": 24974.868, "timestamp": "06:56:14", "text": "凍りつく、そしてもし殺すなら"}, {"type": "subtitle", "time": 24977.43, "timestamp": "06:56:17", "text": "幻影1つはトーテムを落とす"}, {"type": "subtitle", "time": 24980.91, "timestamp": "06:56:20", "text": "錯覚、ああ、そうですね、私は"}, {"type": "subtitle", "time": 24982.86, "timestamp": "06:56:22", "text": "残りの部分"}, {"type": "subtitle", "time": 24984.468, "timestamp": "06:56:24", "text": "[音楽]"}, {"type": "subtitle", "time": 24987.27, "timestamp": "06:56:27", "text": "でも待って、リッチのために持ってるんだよね"}, {"type": "subtitle", "time": 24991.868, "timestamp": "06:56:31", "text": "リッチは敵ですよね、ああ、そうです"}, {"type": "subtitle", "time": 24993.91, "timestamp": "06:56:33", "text": "私はLと戦ったことはないが、"}, {"type": "subtitle", "time": 24997.388, "timestamp": "06:56:37", "text": "それと戦うために私も戦いたい"}, {"type": "subtitle", "time": 24999.91, "timestamp": "06:56:39", "text": "一緒に、たぶん私はそれをしたいと思っています"}, {"type": "subtitle", "time": 25002.23, "timestamp": "06:56:42", "text": "チームでは今はソロではできないので、"}, {"type": "subtitle", "time": 25005.43, "timestamp": "06:56:45", "text": "チームと一緒にやりたいことは"}, {"type": "subtitle", "time": 25008.19, "timestamp": "06:56:48", "text": "少し無料トライアルをお願いして、アスラに"}, {"type": "subtitle", "time": 25012.708, "timestamp": "06:56:52", "text": "テレポートとか何かするけど、彼はしないだろう"}, {"type": "subtitle", "time": 25016.468, "timestamp": "06:56:56", "text": "いや、つまり、召喚しなければならない"}, {"type": "subtitle", "time": 25019.628, "timestamp": "06:56:59", "text": "崖っぷちがなければ彼を召喚できない"}]
[{"type": "subtitle", "time": 19563.35, "timestamp": "05:26:03", "text": "いいえ"}, {"type": "subtitle", "time": 19565.75, "timestamp": "05:26:05", "text": "今日は、"}, {"type": "subtitle", "time": 19568.83, "timestamp": "05:26:08", "text": "戦場、私は土地を整理する"}, {"type": "subtitle", "time": 19572.59, "timestamp": "05:26:12", "text": "えっと、整理する"}, {"type": "subtitle", "time": 19577.99, "timestamp": "05:26:17", "text": "土地、問題は今私が本当に欲しいものです"}, {"type": "subtitle", "time": 19585.548, "timestamp": "05:26:25", "text": "ああ、本当に本当にしたい"}, {"type": "subtitle", "time": 19586.59, "timestamp": "05:26:26", "text": "もの"}, {"type": "subtitle", "time": 19592.11, "timestamp": "05:26:32", "text": "私のチームメイトは新参者です"}, {"type": "subtitle", "time": 19595.75, "timestamp": "05:26:35", "text": "つまり、ズキは新人ではなく、"}, {"type": "subtitle", "time": 19597.91, "timestamp": "05:26:37", "text": "ダークソウルをプレイしたので、彼女ならできると思います"}, {"type": "subtitle", "time": 19598.788, "timestamp": "05:26:38", "text": "知る"}, {"type": "subtitle", "time": 19601.628, "timestamp": "05:26:41", "text": "どのように戦術を理解し、知るか"}, {"type": "subtitle", "time": 19603.15, "timestamp": "05:26:43", "text": "破壊するために"}, {"type": "subtitle", "time": 19606.628, "timestamp": "05:26:46", "text": "ボスが免疫を持っている場合、"}, {"type": "subtitle", "time": 19609.31, "timestamp": "05:26:49", "text": "VAの人々と同じようにシールドしている場合"}, {"type": "subtitle", "time": 19611.23, "timestamp": "05:26:51", "text": "波のうねりを演奏する人は、"}, {"type": "subtitle", "time": 19614.948, "timestamp": "05:26:54", "text": "ボスパターンは正しいボスPです"}, {"type": "subtitle", "time": 19617.51, "timestamp": "05:26:57", "text": "彼らが"}]
[{"type": "subtitle", "time": 1503.35, "timestamp": "00:25:03", "text": "いいえ私の"}, {"type": "subtitle", "time": 1506.35, "timestamp": "00:25:06", "text": "あの男に乗る"}, {"type": "subtitle", "time": 1512.669, "timestamp": "00:25:12", "text": "バカな私は"}, {"type": "subtitle", "time": 1515.389, "timestamp": "00:25:15", "text": "痛みがやってくる"}, {"type": "subtitle", "time": 1559.71, "timestamp": "00:25:59", "text": "ああ、彼はボスにたどり着いた"}]
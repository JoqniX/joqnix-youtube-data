[{"type": "subtitle", "time": 16082.91, "timestamp": "04:28:02", "text": "そうする"}, {"type": "subtitle", "time": 16087.309, "timestamp": "04:28:07", "text": "ええ、ええ、それから、私は作りたかったんです"}, {"type": "subtitle", "time": 16089.109, "timestamp": "04:28:09", "text": "オーバーレイの変更と"}, {"type": "subtitle", "time": 16092.63, "timestamp": "04:28:12", "text": "今週のすべてなので、今週中に"}, {"type": "subtitle", "time": 16094.269, "timestamp": "04:28:14", "text": "新たな変更が加えられる予定です"}, {"type": "subtitle", "time": 16095.83, "timestamp": "04:28:15", "text": "オーバーレイ"}, {"type": "subtitle", "time": 16098.95, "timestamp": "04:28:18", "text": "今は、今の状況を見てください"}, {"type": "subtitle", "time": 16101.389, "timestamp": "04:28:21", "text": "すべては平凡ですが、私は"}, {"type": "subtitle", "time": 16102.189, "timestamp": "04:28:22", "text": "それ"}, {"type": "subtitle", "time": 16105.03, "timestamp": "04:28:25", "text": "ストリームのような有益な情報"}, {"type": "subtitle", "time": 16108.51, "timestamp": "04:28:28", "text": "時間、時間、昔は時間があった、そう、"}, {"type": "subtitle", "time": 16112.83, "timestamp": "04:28:32", "text": "昔は時間があったけど、ずいぶん昔のことだけど"}, {"type": "subtitle", "time": 16114.349, "timestamp": "04:28:34", "text": "私は変わった"}, {"type": "subtitle", "time": 16116.349, "timestamp": "04:28:36", "text": "それは今それは"}, {"type": "subtitle", "time": 16119.83, "timestamp": "04:28:39", "text": "PL、ビジュアライザーを持った運動選手が見える"}, {"type": "subtitle", "time": 16126.63, "timestamp": "04:28:46", "text": "でも私はやりたい"}, {"type": "subtitle", "time": 16131.349, "timestamp": "04:28:51", "text": "今週のことは来週のこと、そして"}, {"type": "subtitle", "time": 16134.83, "timestamp": "04:28:54", "text": "あと、ええ、私の運転の授業は"}, {"type": "subtitle", "time": 16139.149, "timestamp": "04:28:59", "text": "レクリエーションに行くのが遅くなったのは、デートがあるから"}]
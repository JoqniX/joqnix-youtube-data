[{"type": "subtitle", "time": 24061.628, "timestamp": "06:41:01", "text": "タンクを飲んで飲む"}, {"type": "subtitle", "time": 24064.708, "timestamp": "06:41:04", "text": "水は役に立つと思うので、"}, {"type": "subtitle", "time": 24068.83, "timestamp": "06:41:08", "text": "ネザーボスまたはプラントボス プラントボス"}, {"type": "subtitle", "time": 24072.628, "timestamp": "06:41:12", "text": "おそらく、vaa や VA に似ている"}, {"type": "subtitle", "time": 24075.03, "timestamp": "06:41:15", "text": "そして下忍植物ボスはどこにどこにどこにいる"}, {"type": "subtitle", "time": 24078.468, "timestamp": "06:41:18", "text": "それらは明らかに深海で発生するだろうか"}, {"type": "subtitle", "time": 24080.708, "timestamp": "06:41:20", "text": "地下空間"}, {"type": "subtitle", "time": 24085.23, "timestamp": "06:41:25", "text": "右と右なので、それが"}, {"type": "subtitle", "time": 24088.19, "timestamp": "06:41:28", "text": "洞窟かどうかに基づくケース"}, {"type": "subtitle", "time": 24090.11, "timestamp": "06:41:30", "text": "洞窟かもしれない、このゲームにはたくさん"}, {"type": "subtitle", "time": 24091.15, "timestamp": "06:41:31", "text": "の"}, {"type": "subtitle", "time": 24095.15, "timestamp": "06:41:35", "text": "洞窟ですね、つまりアイデアは"}, {"type": "subtitle", "time": 24097.07, "timestamp": "06:41:37", "text": "おそらく"}, {"type": "subtitle", "time": 24101.788, "timestamp": "06:41:41", "text": "溶岩が湧くかもしれない、もしそうなら"}, {"type": "subtitle", "time": 24105.27, "timestamp": "06:41:45", "text": "ランダムにスポーンし、溶岩があれば"}, {"type": "subtitle", "time": 24108.388, "timestamp": "06:41:48", "text": "それは問題を引き起こす可能性があるので、その場合は"}, {"type": "subtitle", "time": 24111.51, "timestamp": "06:41:51", "text": "私がやることは、タンクを切り替えることです"}, {"type": "subtitle", "time": 24115.708, "timestamp": "06:41:55", "text": "溶岩を実際に飲んで、その溶岩を手に入れます。"}, {"type": "subtitle", "time": 24118.948, "timestamp": "06:41:58", "text": "強化ブーストで攻撃を繰り出す"}]
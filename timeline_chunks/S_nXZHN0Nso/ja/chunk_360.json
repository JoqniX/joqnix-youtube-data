[{"type": "subtitle", "time": 21628.548, "timestamp": "06:00:28", "text": "ああ、もう心配しないで、彼は無事に戻ってきた"}, {"type": "subtitle", "time": 21632.07, "timestamp": "06:00:32", "text": "家に帰ったが、子供は"}, {"type": "subtitle", "time": 21634.67, "timestamp": "06:00:34", "text": "誰かが聖人を誘拐したと想像してください"}, {"type": "subtitle", "time": 21638.548, "timestamp": "06:00:38", "text": "子供、何、何、神様、暗すぎる"}, {"type": "chat", "time": 21638.913, "timestamp": "06:00:38", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "husband told april, \"you know, half the credit for this practical joke goes to matilda, she killed one of her wee chickens to get that fake blood\""}, {"type": "subtitle", "time": 21642.51, "timestamp": "06:00:42", "text": "ごめん、ごめん、私の脳は脳じゃない"}, {"type": "subtitle", "time": 21648.27, "timestamp": "06:00:48", "text": "彼女は仲間の一人を殺した。"}, {"type": "subtitle", "time": 21654.708, "timestamp": "06:00:54", "text": "血よ"}, {"type": "subtitle", "time": 21656.788, "timestamp": "06:00:56", "text": "いいえ、ああ"}, {"type": "subtitle", "time": 21658.51, "timestamp": "06:00:58", "text": "いいえ"}]
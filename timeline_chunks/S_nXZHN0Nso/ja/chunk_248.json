[{"type": "subtitle", "time": 14887.349, "timestamp": "04:08:07", "text": "男よ"}, {"type": "subtitle", "time": 14891.91, "timestamp": "04:08:11", "text": "3,000ドルあればお金を買うことができます"}, {"type": "subtitle", "time": 14895.79, "timestamp": "04:08:15", "text": "4000コイン持ってるよ、ああ"}, {"type": "subtitle", "time": 14908.75, "timestamp": "04:08:28", "text": "さようなら。でも、今日は楽しかったよ。"}, {"type": "subtitle", "time": 14916.99, "timestamp": "04:08:36", "text": "では、それを包み込むことにします"}, {"type": "subtitle", "time": 14920.229, "timestamp": "04:08:40", "text": "ということで、皆さんに感謝します。"}, {"type": "subtitle", "time": 14924.51, "timestamp": "04:08:44", "text": "今日来たのは残念だった私のインスタグラム"}, {"type": "subtitle", "time": 14927.95, "timestamp": "04:08:47", "text": "ストリームが途中で途切れた。理由はわからない。"}, {"type": "subtitle", "time": 14930.63, "timestamp": "04:08:50", "text": "何度も切断され、"}, {"type": "subtitle", "time": 14933.109, "timestamp": "04:08:53", "text": "もしあなたが"}, {"type": "subtitle", "time": 14936.229, "timestamp": "04:08:56", "text": "私に聞いて、私は実際に考えた"}, {"type": "subtitle", "time": 14938.309, "timestamp": "04:08:58", "text": "今日はテストストリームテストでした"}]
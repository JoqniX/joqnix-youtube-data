[{"type": "subtitle", "time": 24242.388, "timestamp": "06:44:02", "text": "戦うよ、すごく幸せになるよ、ああ、忘れてたよ"}, {"type": "subtitle", "time": 24243.948, "timestamp": "06:44:03", "text": "無効にする"}, {"type": "subtitle", "time": 24246.91, "timestamp": "06:44:06", "text": "ああ、わかった、ちょっと待って、砂利を取り除かせて"}, {"type": "subtitle", "time": 24249.708, "timestamp": "06:44:09", "text": "砂利を少し使って"}, {"type": "subtitle", "time": 24259.67, "timestamp": "06:44:19", "text": "多くの"}, {"type": "subtitle", "time": 24266.22, "timestamp": "06:44:26", "text": "実は"}, {"type": "subtitle", "time": 24268.948, "timestamp": "06:44:28", "text": "[音楽]"}, {"type": "subtitle", "time": 24273.19, "timestamp": "06:44:33", "text": "ああ、ここがその場所ですね。"}]
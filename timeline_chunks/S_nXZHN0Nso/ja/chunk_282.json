[{"type": "subtitle", "time": 16923.44, "timestamp": "04:42:03", "text": "H 708 国連領土"}, {"type": "subtitle", "time": 16926.03, "timestamp": "04:42:06", "text": "[音楽]"}, {"type": "subtitle", "time": 16929.99, "timestamp": "04:42:09", "text": "ああ、今日はこれをプレイするんですね"}, {"type": "subtitle", "time": 16932.23, "timestamp": "04:42:12", "text": "ゲーム"}, {"type": "subtitle", "time": 16934.628, "timestamp": "04:42:14", "text": "私は、えーと"}, {"type": "subtitle", "time": 16939.51, "timestamp": "04:42:19", "text": "VI インタラクティブ VI を実行します"}, {"type": "subtitle", "time": 16942.868, "timestamp": "04:42:22", "text": "参加型ストリームなので、"}, {"type": "subtitle", "time": 16947.03, "timestamp": "04:42:27", "text": "いつかカニゲームをしよう"}, {"type": "subtitle", "time": 16950.43, "timestamp": "04:42:30", "text": "今週は、ストリームの皆さんが"}, {"type": "subtitle", "time": 16954.67, "timestamp": "04:42:34", "text": "一緒に参加して、一緒に遊んでください"}, {"type": "subtitle", "time": 16958.91, "timestamp": "04:42:38", "text": "有名な、えっと、何て言うんだっけ、イカ"}, {"type": "subtitle", "time": 16963.03, "timestamp": "04:42:43", "text": "ゲームの種類 カニ"}, {"type": "subtitle", "time": 16964.75, "timestamp": "04:42:44", "text": "ゲーム"}, {"type": "subtitle", "time": 16968.47, "timestamp": "04:42:48", "text": "うん、君と遊ぶのは楽しいだろうね"}, {"type": "subtitle", "time": 16971.15, "timestamp": "04:42:51", "text": "みんな、今考えてみると、私は"}, {"type": "subtitle", "time": 16972.43, "timestamp": "04:42:52", "text": "終わり"}, {"type": "subtitle", "time": 16976.03, "timestamp": "04:42:56", "text": "参加型の見解"}, {"type": "subtitle", "time": 16979.19, "timestamp": "04:42:59", "text": "ストリーム配信、久しぶり"}]
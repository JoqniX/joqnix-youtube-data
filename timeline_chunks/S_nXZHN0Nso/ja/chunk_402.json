[{"type": "subtitle", "time": 24121.67, "timestamp": "06:42:01", "text": "ボス部屋がある場合はいつでも"}, {"type": "subtitle", "time": 24123.75, "timestamp": "06:42:03", "text": "ボス戦の部屋には溶岩がある"}, {"type": "subtitle", "time": 24126.67, "timestamp": "06:42:06", "text": "スイッチをサックモードに切り替えて"}, {"type": "subtitle", "time": 24129.868, "timestamp": "06:42:09", "text": "溶岩と、チームメイトが"}, {"type": "subtitle", "time": 24132.548, "timestamp": "06:42:12", "text": "シールドボスシールドの破壊"}, {"type": "subtitle", "time": 24135.468, "timestamp": "06:42:15", "text": "そして全て、そう、それは私のものです"}, {"type": "subtitle", "time": 24139.59, "timestamp": "06:42:19", "text": "私が待つのは私の責任です"}, {"type": "subtitle", "time": 24145.388, "timestamp": "06:42:25", "text": "先鋒の役割に加えて、"}, {"type": "subtitle", "time": 24148.91, "timestamp": "06:42:28", "text": "Bボスを手に入れるために何でもする"}, {"type": "subtitle", "time": 24152.548, "timestamp": "06:42:32", "text": "僕の方が速いから注目して"}, {"type": "subtitle", "time": 24160.15, "timestamp": "06:42:40", "text": "右にスライドして"}, {"type": "subtitle", "time": 24162.83, "timestamp": "06:42:42", "text": "そう、そうすればチームメイトがキルできるから"}, {"type": "subtitle", "time": 24164.628, "timestamp": "06:42:44", "text": "そして我々は勝つことができる、それが私の戦略だ"}, {"type": "subtitle", "time": 24166.708, "timestamp": "06:42:46", "text": "持っている"}, {"type": "subtitle", "time": 24171.11, "timestamp": "06:42:51", "text": "うまくいくといいんだけど、どうなるかわからないよ"}, {"type": "subtitle", "time": 24175.628, "timestamp": "06:42:55", "text": "でも、私は疑っています。うまくいくといいのですが。"}, {"type": "subtitle", "time": 24179.35, "timestamp": "06:42:59", "text": "とにかく、私たちはクリアする必要がある"}]
[{"type": "subtitle", "time": 15423.87, "timestamp": "04:17:03", "text": "土曜日は、"}, {"type": "subtitle", "time": 15425.389, "timestamp": "04:17:05", "text": "夕方"}, {"type": "subtitle", "time": 15426.99, "timestamp": "04:17:06", "text": "えっと"}, {"type": "subtitle", "time": 15430.83, "timestamp": "04:17:10", "text": "それで何が起こったかというと、彼女は"}, {"type": "subtitle", "time": 15434.07, "timestamp": "04:17:14", "text": "えっと、このキットは何て呼ぶんだっけ？"}, {"type": "subtitle", "time": 15436.51, "timestamp": "04:17:16", "text": "キッチナと呼ばれるエリア 私は"}, {"type": "subtitle", "time": 15438.79, "timestamp": "04:17:18", "text": "それについて知っている、何をすべきかわからない"}, {"type": "subtitle", "time": 15441.469, "timestamp": "04:17:21", "text": "初めて"}, {"type": "subtitle", "time": 15443.149, "timestamp": "04:17:23", "text": "体験中"}, {"type": "subtitle", "time": 15444.87, "timestamp": "04:17:24", "text": "これ"}, {"type": "subtitle", "time": 15448.91, "timestamp": "04:17:28", "text": "うん、うん、できる限りそこにいるようにしているよ"}, {"type": "subtitle", "time": 15460.95, "timestamp": "04:17:40", "text": "悲しいけど、悲しむ時じゃないよ、ドン。"}, {"type": "subtitle", "time": 15462.91, "timestamp": "04:17:42", "text": "でも悲しくなりたくない、だって彼女は"}, {"type": "subtitle", "time": 15465.59, "timestamp": "04:17:45", "text": "いつも私に幸せと笑顔をもたらしてくれた"}, {"type": "subtitle", "time": 15467.429, "timestamp": "04:17:47", "text": "私の目の前で"}, {"type": "subtitle", "time": 15470.79, "timestamp": "04:17:50", "text": "だから、彼女が天国で笑顔でいるのは分かっている"}, {"type": "subtitle", "time": 15474.99, "timestamp": "04:17:54", "text": "スマイリーが戻ってきて見ている"}, {"type": "subtitle", "time": 15479.07, "timestamp": "04:17:59", "text": "私もそうします、ベストを尽くします"}]
[{"type": "subtitle", "time": 25141.75, "timestamp": "06:59:01", "text": "それで良いことだ"}, {"type": "subtitle", "time": 25142.788, "timestamp": "06:59:02", "text": "作る"}, {"type": "subtitle", "time": 25145.548, "timestamp": "06:59:05", "text": "そう、それでエアリアルの練習ができる"}, {"type": "subtitle", "time": 25148.708, "timestamp": "06:59:08", "text": "そして、アスラをここに連れてくるために"}, {"type": "subtitle", "time": 25151.03, "timestamp": "06:59:11", "text": "戦闘中、私はここでアスラと戦った"}, {"type": "subtitle", "time": 25153.07, "timestamp": "06:59:13", "text": "昨日、ミツキからあなたと同じように連絡がありました"}, {"type": "subtitle", "time": 25155.27, "timestamp": "06:59:15", "text": "f asra どうやって"}, {"type": "subtitle", "time": 25158.708, "timestamp": "06:59:18", "text": "えっと、彼は再生能力を持っていて、私は"}, {"type": "subtitle", "time": 25162.23, "timestamp": "06:59:22", "text": "諦めなかったから、ほら、"}, {"type": "subtitle", "time": 25164.868, "timestamp": "06:59:24", "text": "ええと、彼は死にかけていなかったし、私の"}, {"type": "subtitle", "time": 25166.83, "timestamp": "06:59:26", "text": "トライデントは私にも少し健康を与えてくれました"}, {"type": "subtitle", "time": 25168.43, "timestamp": "06:59:28", "text": "死にそうでもなかったので、私はただ"}, {"type": "subtitle", "time": 25169.91, "timestamp": "06:59:29", "text": "トライデントを投げて逃げる"}, {"type": "subtitle", "time": 25173.548, "timestamp": "06:59:33", "text": "少しだけ、そして戻ってくるので"}, {"type": "subtitle", "time": 25175.03, "timestamp": "06:59:35", "text": "そして彼は私がちょっと"}, {"type": "subtitle", "time": 25177.75, "timestamp": "06:59:37", "text": "何度も何度も後退する"}, {"type": "subtitle", "time": 25181.51, "timestamp": "06:59:41", "text": "ああ、あなたはそれをやったのですね、それで私は"}, {"type": "subtitle", "time": 25184.11, "timestamp": "06:59:44", "text": "私がこれをやっていたことに腹を立てている"}, {"type": "subtitle", "time": 25187.43, "timestamp": "06:59:47", "text": "そして彼を作るのが好き"}, {"type": "subtitle", "time": 25189.628, "timestamp": "06:59:49", "text": "混乱しているが、彼を殺すことはできる。"}, {"type": "subtitle", "time": 25192.868, "timestamp": "06:59:52", "text": "要点はそうだけど、何か得られた？"}, {"type": "subtitle", "time": 25195.628, "timestamp": "06:59:55", "text": "報酬、ああ、彼は私にトーテムをくれた"}, {"type": "subtitle", "time": 25198.99, "timestamp": "06:59:58", "text": "つまり彼は死んだので、彼は私の3つを撃ちました"}]
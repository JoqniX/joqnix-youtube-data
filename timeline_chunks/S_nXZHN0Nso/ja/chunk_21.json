[{"type": "subtitle", "time": 1264.149, "timestamp": "00:21:04", "text": "ストレート、つまり、あなたが言った方法"}, {"type": "subtitle", "time": 1269.87, "timestamp": "00:21:09", "text": "バカ、こんな感じ"}, {"type": "subtitle", "time": 1272.31, "timestamp": "00:21:12", "text": "ああ、待って待って待って待って待って待って"}, {"type": "subtitle", "time": 1277.71, "timestamp": "00:21:17", "text": "これはあなたが言いたかったことです、ああ、待って、私は、私は"}, {"type": "subtitle", "time": 1280.83, "timestamp": "00:21:20", "text": "この方法を知っていれば、実際に"}, {"type": "subtitle", "time": 1282.31, "timestamp": "00:21:22", "text": "する"}, {"type": "subtitle", "time": 1285.39, "timestamp": "00:21:25", "text": "この待ち時間"}, {"type": "subtitle", "time": 1288.669, "timestamp": "00:21:28", "text": "何、待って、何？"}, {"type": "subtitle", "time": 1291.47, "timestamp": "00:21:31", "text": "実際に次のようにすることができます"}, {"type": "subtitle", "time": 1296.51, "timestamp": "00:21:36", "text": "それは一体何だったのか、私は知らなかった"}, {"type": "subtitle", "time": 1304.71, "timestamp": "00:21:44", "text": "いいね、キャプチャカードに送れるよ"}, {"type": "subtitle", "time": 1314.75, "timestamp": "00:21:54", "text": "わあ、すごくクールだね。ちょっと待って、私も試してみよう。"}, {"type": "subtitle", "time": 1317.549, "timestamp": "00:21:57", "text": "送ったけど、君からは連絡がなかったけど、"}]
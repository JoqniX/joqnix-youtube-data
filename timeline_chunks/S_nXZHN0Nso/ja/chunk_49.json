[{"type": "subtitle", "time": 2941.99, "timestamp": "00:49:01", "text": "えっと、PCをリセットしたから"}, {"type": "subtitle", "time": 2943.15, "timestamp": "00:49:03", "text": "理由"}, {"type": "subtitle", "time": 2946.99, "timestamp": "00:49:06", "text": "私のゲーム用PCは、"}, {"type": "subtitle", "time": 2952.589, "timestamp": "00:49:12", "text": "ゲームをしながら、"}, {"type": "subtitle", "time": 2955.39, "timestamp": "00:49:15", "text": "くだらないけど、それは正しくない"}, {"type": "subtitle", "time": 2958.349, "timestamp": "00:49:18", "text": "満杯になってきたので、"}, {"type": "subtitle", "time": 2960.789, "timestamp": "00:49:20", "text": "欲しいのは、"}, {"type": "subtitle", "time": 2971.309, "timestamp": "00:49:31", "text": "あなたたちが誰かを"}, {"type": "subtitle", "time": 2972.549, "timestamp": "00:49:32", "text": "する"}, {"type": "subtitle", "time": 2988.71, "timestamp": "00:49:48", "text": "何だって、HH、一体何なんだ、一体何なんだ"}, {"type": "subtitle", "time": 2998.57, "timestamp": "00:49:58", "text": "誰かが最初に"}]
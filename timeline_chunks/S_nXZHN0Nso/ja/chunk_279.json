[{"type": "subtitle", "time": 16740.75, "timestamp": "04:39:00", "text": "だから私は、最善を尽くそうと思った"}, {"type": "subtitle", "time": 16743.75, "timestamp": "04:39:03", "text": "これだけど、正しいものが手に入らない"}, {"type": "subtitle", "time": 16748.949, "timestamp": "04:39:08", "text": "物資資源を見つけるにはどうすればいいですか"}, {"type": "subtitle", "time": 16755.629, "timestamp": "04:39:15", "text": "ああ、私はとても"}, {"type": "subtitle", "time": 16763.949, "timestamp": "04:39:23", "text": "次"}, {"type": "subtitle", "time": 16766.67, "timestamp": "04:39:26", "text": "ストリーム"}, {"type": "subtitle", "time": 16769.31, "timestamp": "04:39:29", "text": "これに慣れる"}, {"type": "subtitle", "time": 16771.31, "timestamp": "04:39:31", "text": "そしてそれを実行する"}, {"type": "subtitle", "time": 16777.91, "timestamp": "04:39:37", "text": "待って、私は"}, {"type": "subtitle", "time": 16791.51, "timestamp": "04:39:51", "text": "1. どう言うか"}, {"type": "subtitle", "time": 16795.55, "timestamp": "04:39:55", "text": "だから私はムンバイの天気を調べている"}]
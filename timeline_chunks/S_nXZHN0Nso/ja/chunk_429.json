[{"type": "subtitle", "time": 25742.75, "timestamp": "07:09:02", "text": "それは攻撃だ"}, {"type": "subtitle", "time": 25747.15, "timestamp": "07:09:07", "text": "ああ、自動給紙のやつ、ああ、何をするの？"}, {"type": "subtitle", "time": 25748.548, "timestamp": "07:09:08", "text": "設定は何をしましたか？"}, {"type": "subtitle", "time": 25751.468, "timestamp": "07:09:11", "text": "設定がわからないので、"}, {"type": "subtitle", "time": 25752.59, "timestamp": "07:09:12", "text": "つけたままにしておいた"}, {"type": "subtitle", "time": 25755.75, "timestamp": "07:09:15", "text": "デフォルトなし デフォルトは食べる"}, {"type": "subtitle", "time": 25758.948, "timestamp": "07:09:18", "text": "あなたの持ち物の中にあるアイテムは、私が持っていかなければならないもの"}]
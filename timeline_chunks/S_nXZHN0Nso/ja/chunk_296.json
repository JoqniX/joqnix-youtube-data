[{"type": "subtitle", "time": 17761.11, "timestamp": "04:56:01", "text": "最近私はWをよく言っています"}, {"type": "subtitle", "time": 17762.67, "timestamp": "04:56:02", "text": "まるで私が"}, {"type": "subtitle", "time": 17766.27, "timestamp": "04:56:06", "text": "イナ、そう、私は見てたよ"}, {"type": "subtitle", "time": 17788.07, "timestamp": "04:56:28", "text": "たくさんの言葉を作りたい"}, {"type": "subtitle", "time": 17790.43, "timestamp": "04:56:30", "text": "えーっと、フレーズのようなもの"}, {"type": "subtitle", "time": 17794.27, "timestamp": "04:56:34", "text": "私たち自身もドスのために、えっと、今私は"}, {"type": "subtitle", "time": 17799.28, "timestamp": "04:56:39", "text": "ソニックが言う仕事って何？待って"}, {"type": "subtitle", "time": 17801.51, "timestamp": "04:56:41", "text": "[音楽]"}, {"type": "subtitle", "time": 17804.59, "timestamp": "04:56:44", "text": "コミュニティ名を変更することができます"}, {"type": "subtitle", "time": 17806.67, "timestamp": "04:56:46", "text": "その間"}, {"type": "subtitle", "time": 17810.47, "timestamp": "04:56:50", "text": "待って、何て言おうとしてたんだっけ"}, {"type": "subtitle", "time": 17812.11, "timestamp": "04:56:52", "text": "それ"}]
[{"type": "subtitle", "time": 19261.788, "timestamp": "05:21:01", "text": "戦闘エリアを作ることになるが、それは本当に"}, {"type": "subtitle", "time": 19266.99, "timestamp": "05:21:06", "text": "すごくすごくすごく、チームメイト全員が欲しい"}, {"type": "subtitle", "time": 19269.628, "timestamp": "05:21:09", "text": "すすきみつき"}, {"type": "subtitle", "time": 19273.59, "timestamp": "05:21:13", "text": "えっと、私も弓矢を上手に射れるようになりたい"}, {"type": "subtitle", "time": 19276.948, "timestamp": "05:21:16", "text": "アディアルアディアルモブとファントム"}, {"type": "subtitle", "time": 19279.19, "timestamp": "05:21:19", "text": "等"}, {"type": "subtitle", "time": 19282.91, "timestamp": "05:21:22", "text": "そうですね、"}, {"type": "subtitle", "time": 19285.47, "timestamp": "05:21:25", "text": "私は戦闘アリーナを作るつもりだ"}, {"type": "subtitle", "time": 19287.43, "timestamp": "05:21:27", "text": "私は彼らに究極のものを与える"}, {"type": "subtitle", "time": 19290.708, "timestamp": "05:21:30", "text": "トレーニング体制"}, {"type": "subtitle", "time": 19294.03, "timestamp": "05:21:34", "text": "今日、ああ神様、彼らはショックを受けるでしょう"}, {"type": "subtitle", "time": 19296.07, "timestamp": "05:21:36", "text": "私たちは"}, {"type": "subtitle", "time": 19298.91, "timestamp": "05:21:38", "text": "それが私の計画です"}, {"type": "subtitle", "time": 19302.27, "timestamp": "05:21:42", "text": "トレーニング体制は正しい体制です"}, {"type": "subtitle", "time": 19305.19, "timestamp": "05:21:45", "text": "トレーニングプランや"}, {"type": "subtitle", "time": 19309.83, "timestamp": "05:21:49", "text": "プログラムか何か、それが"}, {"type": "subtitle", "time": 19314.548, "timestamp": "05:21:54", "text": "えっと、私に"}]
[{"type": "subtitle", "time": 9661.11, "timestamp": "02:41:01", "text": "愚かなことは話さない"}, {"type": "subtitle", "time": 9663.19, "timestamp": "02:41:03", "text": "それ"}, {"type": "subtitle", "time": 9667.95, "timestamp": "02:41:07", "text": "私たちはそのことについては話さない、ああ神様"}, {"type": "subtitle", "time": 9676.95, "timestamp": "02:41:16", "text": "ビリー、私がすべてを逃したのが気に入っています"}, {"type": "subtitle", "time": 9704.99, "timestamp": "02:41:44", "text": "大丈夫、放送って書いてあるよ、一時的"}, {"type": "subtitle", "time": 9707.15, "timestamp": "02:41:47", "text": "できない、何をすべきでないか分かる"}, {"type": "subtitle", "time": 9709.23, "timestamp": "02:41:49", "text": "ストリーミングが信じられないくらいすごいよ、私が何をしているか分かるでしょ"}, {"type": "subtitle", "time": 9711.99, "timestamp": "02:41:51", "text": "ストリームを閉じます。少し休ませてください。"}, {"type": "subtitle", "time": 9714.67, "timestamp": "02:41:54", "text": "配信を中止します"}]
[{"type": "subtitle", "time": 8580.63, "timestamp": "02:23:00", "text": "いや、私はプレイしただろう、彼はより良い銃を持っていた"}, {"type": "subtitle", "time": 8583.309, "timestamp": "02:23:03", "text": "あるいは何か"}, {"type": "subtitle", "time": 8587.99, "timestamp": "02:23:07", "text": "[音楽]"}, {"type": "subtitle", "time": 8590.309, "timestamp": "02:23:10", "text": "私が何のために来たのか"}, {"type": "subtitle", "time": 8594.75, "timestamp": "02:23:14", "text": "今からこの緑の奴を狙撃する"}]
[{"type": "subtitle", "time": 25621.83, "timestamp": "07:07:01", "text": "ウォーカー、フロストウォーカーのような"}, {"type": "subtitle", "time": 25624.91, "timestamp": "07:07:04", "text": "凍りつき、すべてが"}, {"type": "subtitle", "time": 25627.43, "timestamp": "07:07:07", "text": "剣は同じ剣のように"}, {"type": "subtitle", "time": 25629.51, "timestamp": "07:07:09", "text": "凍えるような炎とともに"}, {"type": "subtitle", "time": 25632.628, "timestamp": "07:07:12", "text": "とてもクールでとてもクールでそれからそれから"}, {"type": "subtitle", "time": 25637.388, "timestamp": "07:07:17", "text": "シャープネスは、おそらく非常に強力になるでしょう。"}, {"type": "subtitle", "time": 25641.11, "timestamp": "07:07:21", "text": "ああ、エンチャントみたいだね"}, {"type": "subtitle", "time": 25644.31, "timestamp": "07:07:24", "text": "注意して、クリーパーは簡単に"}, {"type": "subtitle", "time": 25650.27, "timestamp": "07:07:30", "text": "終わりは痛みです。つまり終わりです。"}, {"type": "subtitle", "time": 25652.468, "timestamp": "07:07:32", "text": "そんなに難しくない"}, {"type": "subtitle", "time": 25655.43, "timestamp": "07:07:35", "text": "わかった、戦いたいんだね、よし、やろう"}, {"type": "subtitle", "time": 25659.03, "timestamp": "07:07:39", "text": "リスポーンを入れたんですね。はい、入れました。大丈夫です。"}, {"type": "subtitle", "time": 25661.83, "timestamp": "07:07:41", "text": "私たちにとって、私は今、そう思う、そうだ、それは"}, {"type": "subtitle", "time": 25666.99, "timestamp": "07:07:46", "text": "心配そうにうん、こんにちは、うん、わかった、３"}, {"type": "subtitle", "time": 25675.83, "timestamp": "07:07:55", "text": "ステータスを取得しましたか？"}]
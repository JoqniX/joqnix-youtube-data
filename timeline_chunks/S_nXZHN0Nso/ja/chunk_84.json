[{"type": "subtitle", "time": 5072.229, "timestamp": "01:24:32", "text": "待って、私のほうき、彼は私のほうきを破壊した"}, {"type": "subtitle", "time": 5090.55, "timestamp": "01:24:50", "text": "一体何をするつもりなんだ、これは私の"}, {"type": "subtitle", "time": 5093.31, "timestamp": "01:24:53", "text": "影の湖の最後のランなので私は"}, {"type": "subtitle", "time": 5097.07, "timestamp": "01:24:57", "text": "これを繰り返す必要はありません"}, {"type": "subtitle", "time": 5099.79, "timestamp": "01:24:59", "text": "グラインドしてこれを手に入れよう"}]
[{"type": "subtitle", "time": 9486.51, "timestamp": "02:38:06", "text": "私は何に生きているのか"}, {"type": "subtitle", "time": 9488.51, "timestamp": "02:38:08", "text": "ライブ"}, {"type": "subtitle", "time": 9491.23, "timestamp": "02:38:11", "text": "はぁ"}, {"type": "subtitle", "time": 9494.15, "timestamp": "02:38:14", "text": "CUはどうですか？私はリストに載っていません"}, {"type": "subtitle", "time": 9497.63, "timestamp": "02:38:17", "text": "そして私はライブ配信を始めました"}, {"type": "subtitle", "time": 9510.87, "timestamp": "02:38:30", "text": "わかった、この試合が終わったら考えてみるよ"}, {"type": "subtitle", "time": 9526.07, "timestamp": "02:38:46", "text": "そこで私はあそこに着陸し、彼を"}]
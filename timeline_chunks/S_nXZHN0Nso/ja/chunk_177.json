[{"type": "subtitle", "time": 10639.07, "timestamp": "02:57:19", "text": "私、あぁ"}, {"type": "subtitle", "time": 10641.63, "timestamp": "02:57:21", "text": "ああ、私は持っていなかった"}, {"type": "subtitle", "time": 10644.67, "timestamp": "02:57:24", "text": "私には選択肢がなかった"}, {"type": "subtitle", "time": 10653.469, "timestamp": "02:57:33", "text": "でも、そう、私は"}, {"type": "subtitle", "time": 10656.99, "timestamp": "02:57:36", "text": "敵を変えてやる、お前を捕まえてやる"}, {"type": "subtitle", "time": 10659.389, "timestamp": "02:57:39", "text": "そして私は銃さえ持っていなかった"}, {"type": "subtitle", "time": 10661.75, "timestamp": "02:57:41", "text": "柱のようなものを登ってみるか、"}, {"type": "subtitle", "time": 10664.91, "timestamp": "02:57:44", "text": "何か大きなパイプがパニックから"}, {"type": "subtitle", "time": 10666.83, "timestamp": "02:57:46", "text": "私は持っていなかった"}, {"type": "subtitle", "time": 10669.71, "timestamp": "02:57:49", "text": "選択肢ですが、私は手に入れました、私は手に入れました"}, {"type": "subtitle", "time": 10672.15, "timestamp": "02:57:52", "text": "殺される前に殴るか蹴る"}, {"type": "subtitle", "time": 10674.83, "timestamp": "02:57:54", "text": "私にとってそれは"}, {"type": "subtitle", "time": 10679.51, "timestamp": "02:57:59", "text": "よかった、少なくとも私は小さなものが好き"}]
[{"type": "subtitle", "time": 7942.95, "timestamp": "02:12:22", "text": "ほら、聞こえるよ"}, {"type": "subtitle", "time": 7945.31, "timestamp": "02:12:25", "text": "人々は私が聞く"}, {"type": "subtitle", "time": 7951.91, "timestamp": "02:12:31", "text": "よし、一つ。"}, {"type": "subtitle", "time": 7954.83, "timestamp": "02:12:34", "text": "2番目、私のマウスは"}, {"type": "subtitle", "time": 7956.91, "timestamp": "02:12:36", "text": "立ち往生"}, {"type": "subtitle", "time": 7959.03, "timestamp": "02:12:39", "text": "いいえ"}, {"type": "subtitle", "time": 7969.03, "timestamp": "02:12:49", "text": "音量"}]
[{"type": "subtitle", "time": 10513.309, "timestamp": "02:55:13", "text": "え、待って、私はインスタグラムでライブ配信してないよ、待って"}, {"type": "subtitle", "time": 10514.71, "timestamp": "02:55:14", "text": "元"}, {"type": "subtitle", "time": 10516.79, "timestamp": "02:55:16", "text": "え、何？"}, {"type": "subtitle", "time": 10519.75, "timestamp": "02:55:19", "text": "何が起こったのか待って私のインスタグラムは"}, {"type": "subtitle", "time": 10521.429, "timestamp": "02:55:21", "text": "餌"}, {"type": "subtitle", "time": 10542.469, "timestamp": "02:55:42", "text": "ああ神様"}, {"type": "subtitle", "time": 10555.51, "timestamp": "02:55:55", "text": "H、もう一度生きさせてくれ、これは痛みだ"}, {"type": "subtitle", "time": 10558.55, "timestamp": "02:55:58", "text": "インスタグラムをやめたい気分です"}]
[{"type": "subtitle", "time": 8282.27, "timestamp": "02:18:02", "text": "ドロップって、視覚的なバグなの？"}, {"type": "subtitle", "time": 8312.27, "timestamp": "02:18:32", "text": "[拍手]"}, {"type": "subtitle", "time": 8315.15, "timestamp": "02:18:35", "text": "モー、ブラッド"}, {"type": "subtitle", "time": 8318.07, "timestamp": "02:18:38", "text": "ああ、それはバグだ、それはバグだ"}, {"type": "subtitle", "time": 8320.469, "timestamp": "02:18:40", "text": "誰もが伝説を持っていない"}, {"type": "subtitle", "time": 8323.549, "timestamp": "02:18:43", "text": "そこに表示されているのはバグですね。"}, {"type": "subtitle", "time": 8326.11, "timestamp": "02:18:46", "text": "それはバグです。はいはいはい、そこに男がいます"}, {"type": "subtitle", "time": 8330.349, "timestamp": "02:18:50", "text": "着陸したら狙撃しようか、狙撃した"}, {"type": "subtitle", "time": 8331.469, "timestamp": "02:18:51", "text": "この男"}, {"type": "subtitle", "time": 8334.99, "timestamp": "02:18:54", "text": "着陸した男がいて、狙撃しようとした"}, {"type": "subtitle", "time": 8336.309, "timestamp": "02:18:56", "text": "これを狙う"}]
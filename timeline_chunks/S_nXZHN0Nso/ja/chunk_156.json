[{"type": "subtitle", "time": 9368.83, "timestamp": "02:36:08", "text": "向こうの男が怖い"}, {"type": "subtitle", "time": 9371.91, "timestamp": "02:36:11", "text": "ここにいる男が怖いんだけど"}, {"type": "subtitle", "time": 9373.67, "timestamp": "02:36:13", "text": "ソロは好きですか？つまり、えーと"}, {"type": "subtitle", "time": 9375.07, "timestamp": "02:36:15", "text": "シールドの違いが重要な場合もあるので"}, {"type": "subtitle", "time": 9388.55, "timestamp": "02:36:28", "text": "メッセージソロは楽しいです。"}, {"type": "subtitle", "time": 9391.87, "timestamp": "02:36:31", "text": "私のようにただ遊びたい人"}, {"type": "subtitle", "time": 9410.429, "timestamp": "02:36:50", "text": "バッカ、彼は私が求めていたガンマンのエネルギーを持っていた"}, {"type": "subtitle", "time": 9412.79, "timestamp": "02:36:52", "text": "シールドを変更するために、しかしシールドは"}, {"type": "subtitle", "time": 9415.11, "timestamp": "02:36:55", "text": "ない"}, {"type": "subtitle", "time": 9419.389, "timestamp": "02:36:59", "text": "ああ、モー、大丈夫だよ、もっと遊べば"}]
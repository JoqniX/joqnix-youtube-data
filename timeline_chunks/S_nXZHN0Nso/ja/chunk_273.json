[{"type": "subtitle", "time": 16380.79, "timestamp": "04:33:00", "text": "ストリームしてあなたと話す"}, {"type": "subtitle", "time": 16382.55, "timestamp": "04:33:02", "text": "人々は何"}, {"type": "subtitle", "time": 16385.59, "timestamp": "04:33:05", "text": "起きてるから"}, {"type": "subtitle", "time": 16388.949, "timestamp": "04:33:08", "text": "うん、それで、バカハニー、睡眠はどうだった？"}, {"type": "subtitle", "time": 16396.429, "timestamp": "04:33:16", "text": "仕事の準備をしているところです。ああ、仕事があるんです。"}, {"type": "subtitle", "time": 16417.15, "timestamp": "04:33:37", "text": "うんうん、睡眠は大丈夫だよ、うんうん、だから"}, {"type": "subtitle", "time": 16420.51, "timestamp": "04:33:40", "text": "昨日は寝過ぎた"}, {"type": "subtitle", "time": 16423.67, "timestamp": "04:33:43", "text": "えっと、新しい薬のせいかな"}, {"type": "subtitle", "time": 16426.551, "timestamp": "04:33:46", "text": "服用していますが、私の体は慣れていません"}, {"type": "subtitle", "time": 16431.709, "timestamp": "04:33:51", "text": "そのため、私の体はより疲れたような感じでした"}, {"type": "subtitle", "time": 16435.31, "timestamp": "04:33:55", "text": "日H 私は寝たと思います"}, {"type": "subtitle", "time": 16439.869, "timestamp": "04:33:59", "text": "15時間くらいから"}]
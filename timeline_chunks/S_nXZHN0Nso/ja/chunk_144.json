[{"type": "subtitle", "time": 8647.39, "timestamp": "02:24:07", "text": "CH おお、バトルガンいいね"}, {"type": "subtitle", "time": 8678.15, "timestamp": "02:24:38", "text": "私は何だったのか"}, {"type": "subtitle", "time": 8680.67, "timestamp": "02:24:40", "text": "私は何をしていたのか"}, {"type": "subtitle", "time": 8683.55, "timestamp": "02:24:43", "text": "彼はいつ何をしたのか"}, {"type": "subtitle", "time": 8687.59, "timestamp": "02:24:47", "text": "おい、こいつらいいな、俺も欲しいよ"}, {"type": "subtitle", "time": 8691.55, "timestamp": "02:24:51", "text": "B 私はできる"}, {"type": "subtitle", "time": 8693.75, "timestamp": "02:24:53", "text": "私は今作っています"}, {"type": "subtitle", "time": 8698.19, "timestamp": "02:24:58", "text": "言い訳だけど、ある意味、私は"}]
[{"type": "subtitle", "time": 6181.31, "timestamp": "01:43:01", "text": "今配信してるから、うんうん、こんにちは"}, {"type": "subtitle", "time": 6185.79, "timestamp": "01:43:05", "text": "ようこそ、こんにちは、こんにちは、メガネがお似合いです"}, {"type": "subtitle", "time": 6188.99, "timestamp": "01:43:08", "text": "昼食は何を食べましたか？はい、食べました。"}, {"type": "subtitle", "time": 6193.79, "timestamp": "01:43:13", "text": "私はそうしました、私は昼食を食べました"}, {"type": "subtitle", "time": 6203.99, "timestamp": "01:43:23", "text": "はい、調子はどうですか、ランはどうですか"}, {"type": "subtitle", "time": 6206.55, "timestamp": "01:43:26", "text": "こんにちは"}, {"type": "subtitle", "time": 6211.629, "timestamp": "01:43:31", "text": "ようこそ、えっと、待って、私のウォーターチャンネル"}, {"type": "subtitle", "time": 6214.149, "timestamp": "01:43:34", "text": "垂直ストリームは大丈夫ですか？何も"}, {"type": "subtitle", "time": 6216.83, "timestamp": "01:43:36", "text": "間違っている、正しい、そうであってほしい"}, {"type": "subtitle", "time": 6221.39, "timestamp": "01:43:41", "text": "まあ、とにかく、昨日はみんなどうだった？"}, {"type": "subtitle", "time": 6225.189, "timestamp": "01:43:45", "text": "私たちは、えっと、何をプレイしたか忘れちゃったんだけど"}, {"type": "subtitle", "time": 6228.31, "timestamp": "01:43:48", "text": "私がプレイしたゲームの名前は"}, {"type": "subtitle", "time": 6231.51, "timestamp": "01:43:51", "text": "昨日はチキンだったんだけど、"}, {"type": "subtitle", "time": 6234.709, "timestamp": "01:43:54", "text": "忘れてたな、ああ、そうだ、"}, {"type": "subtitle", "time": 6236.51, "timestamp": "01:43:56", "text": "昨日私たちがプレイしたゲームは"}, {"type": "subtitle", "time": 6238.83, "timestamp": "01:43:58", "text": "数学的な部分を除いて楽しい"}]
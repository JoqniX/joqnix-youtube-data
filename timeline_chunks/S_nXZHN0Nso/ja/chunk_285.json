[{"type": "subtitle", "time": 17101.47, "timestamp": "04:45:01", "text": "チャットアラート、例えば誰かが「いいね！」したときなど"}, {"type": "subtitle", "time": 17104.75, "timestamp": "04:45:04", "text": "ストリーミングするなら、そうすることもできると思うし、"}, {"type": "subtitle", "time": 17107.03, "timestamp": "04:45:07", "text": "誰かが購読したりスーパーしたりするたびに"}, {"type": "subtitle", "time": 17109.15, "timestamp": "04:45:09", "text": "チャットの後"}, {"type": "subtitle", "time": 17111.15, "timestamp": "04:45:11", "text": "覚えてるよ、でも私は持っていない"}, {"type": "subtitle", "time": 17114.19, "timestamp": "04:45:14", "text": "メンバーのスーパーチャットはまだ使えません"}, {"type": "subtitle", "time": 17116.99, "timestamp": "04:45:16", "text": "でも、主に拡張機能が欲しいんです"}, {"type": "subtitle", "time": 17121.67, "timestamp": "04:45:21", "text": "チャットで歓迎の挨拶をするのは最初のように"}, {"type": "subtitle", "time": 17124.59, "timestamp": "04:45:24", "text": "チャットで話す相手は、"}, {"type": "subtitle", "time": 17130.03, "timestamp": "04:45:30", "text": "ツイッターで私が"}, {"type": "subtitle", "time": 17133.51, "timestamp": "04:45:33", "text": "挨拶をしたり、誰かが入ってきたりすると、"}, {"type": "subtitle", "time": 17137.59, "timestamp": "04:45:37", "text": "オナンがチャットにやってきて「やあ、ジョー、私は"}, {"type": "subtitle", "time": 17141.59, "timestamp": "04:45:41", "text": "Twitchで次回は「うん、こんにちは」と言ってください"}, {"type": "subtitle", "time": 17143.75, "timestamp": "04:45:43", "text": "YouTubeで"}, {"type": "subtitle", "time": 17154.27, "timestamp": "04:45:54", "text": "もっと、うん、最近私は"}, {"type": "subtitle", "time": 17156.708, "timestamp": "04:45:56", "text": "服用している新しい薬のせい"}]
[{"type": "subtitle", "time": 25080.59, "timestamp": "06:58:00", "text": "彼に付け加えてほしいのは、"}, {"type": "subtitle", "time": 25082.75, "timestamp": "06:58:02", "text": "矢印を使わないのは難しいし、"}, {"type": "subtitle", "time": 25085.23, "timestamp": "06:58:05", "text": "つまり、矢を栽培するということは"}, {"type": "subtitle", "time": 25087.91, "timestamp": "06:58:07", "text": "正直言ってかなり簡単だよ、えっと、君のタワー"}, {"type": "subtitle", "time": 25090.948, "timestamp": "06:58:10", "text": "Lがスポーンする場所にスポナーがある"}, {"type": "subtitle", "time": 25094.15, "timestamp": "06:58:14", "text": "そうですね、スポナーが2つありますね。"}, {"type": "subtitle", "time": 25096.23, "timestamp": "06:58:16", "text": "私がやったことは、一種の"}, {"type": "subtitle", "time": 25098.99, "timestamp": "06:58:18", "text": "もっと農場が欲しいので、隅っこに隠れたいだけです"}, {"type": "subtitle", "time": 25101.15, "timestamp": "06:58:21", "text": "そしてモブが出現するのを待って、"}, {"type": "subtitle", "time": 25102.83, "timestamp": "06:58:22", "text": "ただ殺せばドロップして"}, {"type": "subtitle", "time": 25103.83, "timestamp": "06:58:23", "text": "落とす"}, {"type": "subtitle", "time": 25108.388, "timestamp": "06:58:28", "text": "矢印ですが、私の質問は、"}, {"type": "subtitle", "time": 25112.628, "timestamp": "06:58:32", "text": "スポナーを手に取る方法"}, {"type": "subtitle", "time": 25115.868, "timestamp": "06:58:35", "text": "できないよ、できないよ、もし君が"}, {"type": "subtitle", "time": 25118.51, "timestamp": "06:58:38", "text": "何からでも作れますが、"}, {"type": "subtitle", "time": 25121.19, "timestamp": "06:58:41", "text": "シルクタッチ、シルクタッチ、"}, {"type": "subtitle", "time": 25123.31, "timestamp": "06:58:43", "text": "シルクのような手触りで壊れてしまう"}, {"type": "subtitle", "time": 25125.83, "timestamp": "06:58:45", "text": "[音楽]"}, {"type": "subtitle", "time": 25128.23, "timestamp": "06:58:48", "text": "ええ、そう思って"}, {"type": "subtitle", "time": 25132.35, "timestamp": "06:58:52", "text": "戦場はここのどこか"}, {"type": "subtitle", "time": 25136.11, "timestamp": "06:58:56", "text": "はい、どこですか？はい、ここです。はい、それで"}, {"type": "subtitle", "time": 25139.07, "timestamp": "06:58:59", "text": "このエリアを平らにしたいので"}]
[{"type": "subtitle", "time": 24781.43, "timestamp": "06:53:01", "text": "聖"}, {"type": "subtitle", "time": 24789.99, "timestamp": "06:53:09", "text": "死にそうだ、ああ神様、信じられない"}, {"type": "subtitle", "time": 24791.388, "timestamp": "06:53:11", "text": "私は死にかけている"}, {"type": "subtitle", "time": 24795.03, "timestamp": "06:53:15", "text": "午前中に快適"}, {"type": "subtitle", "time": 24798.83, "timestamp": "06:53:18", "text": "群衆 守護者って何？"}, {"type": "subtitle", "time": 24818.59, "timestamp": "06:53:38", "text": "ああ、エンダーマンが2匹いる、ありがとう、君はいい人だ"}, {"type": "subtitle", "time": 24822.708, "timestamp": "06:53:42", "text": "兄弟たち、ここに来てください"}, {"type": "subtitle", "time": 24825.83, "timestamp": "06:53:45", "text": "彼らが嫌がるのは、あなたが彼らを突くときだけです"}, {"type": "subtitle", "time": 24828.548, "timestamp": "06:53:48", "text": "後ろ側は、それは良い弱点だ"}, {"type": "subtitle", "time": 24831.75, "timestamp": "06:53:51", "text": "それは知っておくと良いことですね。"}, {"type": "subtitle", "time": 24833.23, "timestamp": "06:53:53", "text": "で"}, {"type": "subtitle", "time": 24835.42, "timestamp": "06:53:55", "text": "あなたを見ている"}]
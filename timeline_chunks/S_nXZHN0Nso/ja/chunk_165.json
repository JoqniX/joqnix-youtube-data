[{"type": "subtitle", "time": 9906.91, "timestamp": "02:45:06", "text": "アル、元気？エドワードは元気？"}, {"type": "subtitle", "time": 9910.23, "timestamp": "02:45:10", "text": "うまくいっていると本当に汗だくで、"}, {"type": "subtitle", "time": 9912.71, "timestamp": "02:45:12", "text": "20爆弾バッジはもらえるのかな？"}, {"type": "subtitle", "time": 9919.03, "timestamp": "02:45:19", "text": "私が欲しいのはソロでの勝利だけです"}, {"type": "subtitle", "time": 9922.67, "timestamp": "02:45:22", "text": "マッチBのやつは難しいだろうけど"}, {"type": "subtitle", "time": 9928.55, "timestamp": "02:45:28", "text": "試してみます。私ができる最善のことは、"}, {"type": "subtitle", "time": 9931.99, "timestamp": "02:45:31", "text": "ソロプレイでのゲーム感覚は、かなり難しい。"}, {"type": "subtitle", "time": 9935.71, "timestamp": "02:45:35", "text": "もちろんプレイできますよ。"}, {"type": "subtitle", "time": 9938.67, "timestamp": "02:45:38", "text": "ゆっくりやると、ある程度効果があります"}, {"type": "subtitle", "time": 9946.63, "timestamp": "02:45:46", "text": "ゲームをボーダーレスウィンドウモードにするつもりです"}, {"type": "subtitle", "time": 9954.51, "timestamp": "02:45:54", "text": "またもや行き詰まる"}]
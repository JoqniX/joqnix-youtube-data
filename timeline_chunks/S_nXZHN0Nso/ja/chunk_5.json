[{"type": "subtitle", "time": 301.469, "timestamp": "00:05:01", "text": "知っている"}, {"type": "subtitle", "time": 326.189, "timestamp": "00:05:26", "text": "それ以外はほとんどやらなかった"}, {"type": "subtitle", "time": 330.15, "timestamp": "00:05:30", "text": "人々が私のところに来る時"}, {"type": "subtitle", "time": 333.55, "timestamp": "00:05:33", "text": "だから、私が連絡を取るなら、"}, {"type": "chat", "time": 333.879, "timestamp": "00:05:33", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Joq is Currently taking a break! and will be back soon! do enjoy this past memories till he is back!"}, {"type": "subtitle", "time": 336.749, "timestamp": "00:05:36", "text": "その人物を正しく知ることは、また、"}, {"type": "subtitle", "time": 340.23, "timestamp": "00:05:40", "text": "ブラインドコラボはしたくない"}, {"type": "subtitle", "time": 342.99, "timestamp": "00:05:42", "text": "私は自分が誰に行くのかを知っておくべきだ"}, {"type": "subtitle", "time": 346.51, "timestamp": "00:05:46", "text": "付き合ったり、一緒に過ごしたり、遊んだりする"}, {"type": "subtitle", "time": 349.749, "timestamp": "00:05:49", "text": "VI とどのように彼らは"}, {"type": "subtitle", "time": 353.029, "timestamp": "00:05:53", "text": "私の雰囲気を楽しんで、私たちの雰囲気を"}, {"type": "subtitle", "time": 357.189, "timestamp": "00:05:57", "text": "繋がって、そこに何かがあった"}, {"type": "subtitle", "time": 359.07, "timestamp": "00:05:59", "text": "Epic Gamesの最後の良いオファー"}]
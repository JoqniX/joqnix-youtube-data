[{"type": "subtitle", "time": 7690.43, "timestamp": "02:08:10", "text": "ボー、それは内側で死にかけているか、"}, {"type": "subtitle", "time": 7700.43, "timestamp": "02:08:20", "text": "えっと、それをやるよ、ソロで行こう"}, {"type": "subtitle", "time": 7702.03, "timestamp": "02:08:22", "text": "変更を許可します"}, {"type": "subtitle", "time": 7714.27, "timestamp": "02:08:34", "text": "えっと、じゃあ、"}, {"type": "subtitle", "time": 7718.87, "timestamp": "02:08:38", "text": "新しい場所 近くに敵 50分 50m"}, {"type": "subtitle", "time": 7723.03, "timestamp": "02:08:43", "text": "よし、これからはソロで行くから、ポップにしなくちゃ"}, {"type": "subtitle", "time": 7725.549, "timestamp": "02:08:45", "text": "オフ"}, {"type": "subtitle", "time": 7728.51, "timestamp": "02:08:48", "text": "いいですね、ベストを尽くします、私はそうは思いません"}]
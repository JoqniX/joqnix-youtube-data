[{"type": "subtitle", "time": 24003.59, "timestamp": "06:40:03", "text": "外に、待って砂利が役に立つか"}, {"type": "subtitle", "time": 24006.91, "timestamp": "06:40:06", "text": "この缶をチェックします"}, {"type": "subtitle", "time": 24012.02, "timestamp": "06:40:12", "text": "砂利は私たちに砂利を"}, {"type": "subtitle", "time": 24013.19, "timestamp": "06:40:13", "text": "[音楽]"}, {"type": "subtitle", "time": 24015.75, "timestamp": "06:40:15", "text": "解決しない"}, {"type": "subtitle", "time": 24019.628, "timestamp": "06:40:19", "text": "いや、ああ、そうだ、もし私が作ったなら、私は計画した"}, {"type": "subtitle", "time": 24022.948, "timestamp": "06:40:22", "text": "溶岩攻撃に対する私の戦略は"}, {"type": "subtitle", "time": 24026.11, "timestamp": "06:40:26", "text": "私ができることは、あなたに教えることです"}, {"type": "subtitle", "time": 24027.788, "timestamp": "06:40:27", "text": "教えてあげる、待って、私は何になるべき？"}, {"type": "subtitle", "time": 24029.91, "timestamp": "06:40:29", "text": "私の秘密を教えることはわからないが"}, {"type": "subtitle", "time": 24033.75, "timestamp": "06:40:33", "text": "うん、これをつけて、リードをつけて"}, {"type": "subtitle", "time": 24037.868, "timestamp": "06:40:37", "text": "敵がボスなら、一度リードをつけて中に入る"}, {"type": "subtitle", "time": 24041.27, "timestamp": "06:40:41", "text": "前にLAを置いて溶岩を置いて戻る"}, {"type": "subtitle", "time": 24045.07, "timestamp": "06:40:45", "text": "このモードに切り替えると元に戻る"}, {"type": "subtitle", "time": 24047.548, "timestamp": "06:40:47", "text": "この腕を"}, {"type": "subtitle", "time": 24050.31, "timestamp": "06:40:50", "text": "これと来て"}, {"type": "subtitle", "time": 24055.468, "timestamp": "06:40:55", "text": "もし私が溶岩の中に落ちたら、戻って"}, {"type": "subtitle", "time": 24057.75, "timestamp": "06:40:57", "text": "このようにスイッチ"}]
[{"type": "subtitle", "time": 3180.589, "timestamp": "00:53:00", "text": "ああ、神様"}, {"type": "subtitle", "time": 3188.19, "timestamp": "00:53:08", "text": "ダサいな、彼はゆっくりやってる、待って、何の銃？"}, {"type": "subtitle", "time": 3189.589, "timestamp": "00:53:09", "text": "は"}, {"type": "subtitle", "time": 3205.069, "timestamp": "00:53:25", "text": "これは何の銃ですか？ああ、素晴らしい"}, {"type": "subtitle", "time": 3212.47, "timestamp": "00:53:32", "text": "また戻ってきます。楽しんでください。"}, {"type": "subtitle", "time": 3230.67, "timestamp": "00:53:50", "text": "水分補給を忘れずに"}]
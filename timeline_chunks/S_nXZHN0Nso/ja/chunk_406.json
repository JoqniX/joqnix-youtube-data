[{"type": "subtitle", "time": 24361.708, "timestamp": "06:46:01", "text": "完全にそうなので、そうすることができます"}, {"type": "subtitle", "time": 24363.388, "timestamp": "06:46:03", "text": "戦場"}, {"type": "subtitle", "time": 24365.628, "timestamp": "06:46:05", "text": "うん、夜になるよ。"}, {"type": "subtitle", "time": 24367.708, "timestamp": "06:46:07", "text": "3晩寝る"}, {"type": "subtitle", "time": 24371.59, "timestamp": "06:46:11", "text": "えーと、夜になるので"}, {"type": "subtitle", "time": 24374.51, "timestamp": "06:46:14", "text": "ファントムを見つけて、どうすれば"}, {"type": "subtitle", "time": 24376.948, "timestamp": "06:46:16", "text": "アドイルと戦うための戦略をどのように立てるか"}, {"type": "subtitle", "time": 24379.628, "timestamp": "06:46:19", "text": "対戦相手なので、私の現在の弱点は、"}, {"type": "subtitle", "time": 24382.35, "timestamp": "06:46:22", "text": "地面に埋まってしまっている。私はただ"}, {"type": "subtitle", "time": 24386.31, "timestamp": "06:46:26", "text": "地上で敵を攻撃する、なぜなら私は"}, {"type": "subtitle", "time": 24390.59, "timestamp": "06:46:30", "text": "スケルトンを倒す練習をする"}, {"type": "subtitle", "time": 24393.31, "timestamp": "06:46:33", "text": "もっと不気味な"}, {"type": "subtitle", "time": 24396.19, "timestamp": "06:46:36", "text": "外に出るといつもゾンビとかそういうのが出てくる"}, {"type": "subtitle", "time": 24398.948, "timestamp": "06:46:38", "text": "ランビルの世界を探検していますが、私は"}, {"type": "subtitle", "time": 24401.708, "timestamp": "06:46:41", "text": "アドリアの練習はしていません"}, {"type": "subtitle", "time": 24405.868, "timestamp": "06:46:45", "text": "対戦相手は、大きな流れです"}, {"type": "subtitle", "time": 24407.788, "timestamp": "06:46:47", "text": "私の"}, {"type": "subtitle", "time": 24412.27, "timestamp": "06:46:52", "text": "バトルトレーニングだから、私はできる必要がある"}]
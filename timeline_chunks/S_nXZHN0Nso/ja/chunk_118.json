[{"type": "subtitle", "time": 7084.189, "timestamp": "01:58:04", "text": "外"}, {"type": "subtitle", "time": 7087.55, "timestamp": "01:58:07", "text": "ああ、なんてことだ、新しい銃は"}, {"type": "subtitle", "time": 7090.069, "timestamp": "01:58:10", "text": "知らない人のために銃を手に入れた"}, {"type": "subtitle", "time": 7092.55, "timestamp": "01:58:12", "text": "シーズン中、私たちは挑戦し、すべてが"}, {"type": "subtitle", "time": 7096.75, "timestamp": "01:58:16", "text": "これが私たちが手に入れた銃で、"}, {"type": "subtitle", "time": 7099.47, "timestamp": "01:58:19", "text": "永遠に、でも私は実際に全部やった"}, {"type": "subtitle", "time": 7102.99, "timestamp": "01:58:22", "text": "課題やその他すべて、そしてその理由"}, {"type": "subtitle", "time": 7106.03, "timestamp": "01:58:26", "text": "ついに手に入れた"}, {"type": "subtitle", "time": 7107.75, "timestamp": "01:58:27", "text": "わーい"}, {"type": "subtitle", "time": 7111.43, "timestamp": "01:58:31", "text": "はい、では彼女の能力は？"}, {"type": "subtitle", "time": 7119.35, "timestamp": "01:58:39", "text": "これを解明する F2 F1 いいえ F3 はどうすればいいですか?"}, {"type": "subtitle", "time": 7122.709, "timestamp": "01:58:42", "text": "ああ、私は何をしたんだ"}, {"type": "subtitle", "time": 7127.55, "timestamp": "01:58:47", "text": "えっと、私何をしたの？"}, {"type": "subtitle", "time": 7130.069, "timestamp": "01:58:50", "text": "いや、ああ、忘れてた"}, {"type": "subtitle", "time": 7135.109, "timestamp": "01:58:55", "text": "ああああああ待って待ってF5 F6 F7 F8"}, {"type": "subtitle", "time": 7138.709, "timestamp": "01:58:58", "text": "F9 ああ、忘れてた、私は、私は"}]
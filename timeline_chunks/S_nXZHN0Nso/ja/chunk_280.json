[{"type": "subtitle", "time": 16800.51, "timestamp": "04:40:00", "text": "予報によると、それは現れるとのことです"}, {"type": "subtitle", "time": 16807.03, "timestamp": "04:40:07", "text": "ああ、なぜ私はこんなにも初心者のような気分になるのだろう"}, {"type": "subtitle", "time": 16809.55, "timestamp": "04:40:09", "text": "何てことだ"}, {"type": "subtitle", "time": 16818.51, "timestamp": "04:40:18", "text": "[音楽]"}, {"type": "subtitle", "time": 16820.868, "timestamp": "04:40:20", "text": "また、多くの州があり、"}, {"type": "subtitle", "time": 16828.27, "timestamp": "04:40:28", "text": "インドの都市、全部と言った方がいいでしょうか"}, {"type": "subtitle", "time": 16837.43, "timestamp": "04:40:37", "text": "最高の日、ああ神様、ああ神様"}, {"type": "subtitle", "time": 16839.99, "timestamp": "04:40:39", "text": "州っていくつあったっけ？忘れちゃった。"}, {"type": "subtitle", "time": 16852.23, "timestamp": "04:40:52", "text": "これは"}]
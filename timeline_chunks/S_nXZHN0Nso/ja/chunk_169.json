[{"type": "subtitle", "time": 10144.469, "timestamp": "02:49:04", "text": "よし、あの混乱を乗り越えなきゃ。"}, {"type": "subtitle", "time": 10147.23, "timestamp": "02:49:07", "text": "Havoc はとても良いです。彼らは変更しました。"}, {"type": "subtitle", "time": 10149.99, "timestamp": "02:49:09", "text": "献身は今や、彼らはそれをより緊密にした"}, {"type": "subtitle", "time": 10152.269, "timestamp": "02:49:12", "text": "さあ、それを持つと"}, {"type": "subtitle", "time": 10155.349, "timestamp": "02:49:15", "text": "レティクルはこのように広がり、"}, {"type": "subtitle", "time": 10157.269, "timestamp": "02:49:17", "text": "本当に"}]
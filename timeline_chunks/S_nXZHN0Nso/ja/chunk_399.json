[{"type": "subtitle", "time": 23941.59, "timestamp": "06:39:01", "text": "できるけど、もし金のリンゴがあったら"}, {"type": "subtitle", "time": 23945.11, "timestamp": "06:39:05", "text": "黄金のニンジンが64個以上"}, {"type": "subtitle", "time": 23948.388, "timestamp": "06:39:08", "text": "オトウが食べるこれらの食品"}, {"type": "subtitle", "time": 23951.708, "timestamp": "06:39:11", "text": "お腹が空いたときや、"}, {"type": "subtitle", "time": 23955.19, "timestamp": "06:39:15", "text": "心臓、想像してみて、どれだけの力が"}, {"type": "subtitle", "time": 23958.35, "timestamp": "06:39:18", "text": "私が持っている力"}, {"type": "subtitle", "time": 23974.67, "timestamp": "06:39:34", "text": "どれだけのパワーがあるか想像してみてください"}, {"type": "subtitle", "time": 23977.388, "timestamp": "06:39:37", "text": "私は特別な心を持っているだろうし"}, {"type": "subtitle", "time": 23980.628, "timestamp": "06:39:40", "text": "すべて、えっと、何て言うんだっけ"}, {"type": "subtitle", "time": 23983.11, "timestamp": "06:39:43", "text": "Apple はハートまたは"}, {"type": "subtitle", "time": 23987.388, "timestamp": "06:39:47", "text": "何か正しいこと、二つの心が正しいことを想像してみて"}, {"type": "subtitle", "time": 23990.83, "timestamp": "06:39:50", "text": "あなたと同じように、あるいはあなたがそうでないような方法"}, {"type": "subtitle", "time": 23993.83, "timestamp": "06:39:53", "text": "脆弱なのは究極的だ、とにかく私に"}, {"type": "subtitle", "time": 23995.11, "timestamp": "06:39:55", "text": "始める"}, {"type": "subtitle", "time": 23998.51, "timestamp": "06:39:58", "text": "掘り起こす最良の方法は"}]
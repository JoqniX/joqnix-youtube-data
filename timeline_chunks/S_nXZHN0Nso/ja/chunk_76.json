[{"type": "subtitle", "time": 4582.43, "timestamp": "01:16:22", "text": "こんにちは、アップデート後、こんにちは、待って、いつ"}, {"type": "subtitle", "time": 4586.629, "timestamp": "01:16:26", "text": "再び更新されると、新しい"}, {"type": "subtitle", "time": 4588.47, "timestamp": "01:16:28", "text": "地域新"}, {"type": "subtitle", "time": 4598.189, "timestamp": "01:16:38", "text": "ああ神様、私の口の中のこの髪が"}]
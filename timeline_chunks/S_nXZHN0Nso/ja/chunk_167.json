[{"type": "subtitle", "time": 10045.51, "timestamp": "02:47:25", "text": "私はこれを選んだ方がいいと思う"}, {"type": "subtitle", "time": 10049.469, "timestamp": "02:47:29", "text": "だって、私は、殺してくれって思う人たちを見たから"}, {"type": "subtitle", "time": 10072.19, "timestamp": "02:47:52", "text": "私は人々の足跡を辿らなければならない"}, {"type": "subtitle", "time": 10074.269, "timestamp": "02:47:54", "text": "誰が"}, {"type": "subtitle", "time": 10078.15, "timestamp": "02:47:58", "text": "全力で戦ったけど死ななかったよ、だって"}]
[{"type": "subtitle", "time": 25262.388, "timestamp": "07:01:02", "text": "2番目のm"}, {"type": "subtitle", "time": 25264.548, "timestamp": "07:01:04", "text": "カオスチームの調子はどうですか？"}, {"type": "subtitle", "time": 25266.708, "timestamp": "07:01:06", "text": "君はカオスチームにいるんだよね、カオス"}, {"type": "subtitle", "time": 25270.51, "timestamp": "07:01:10", "text": "チーム、つまりグループ全体のことです"}, {"type": "subtitle", "time": 25273.788, "timestamp": "07:01:13", "text": "他のすべてのチームは"}, {"type": "subtitle", "time": 25277.788, "timestamp": "07:01:17", "text": "つまり、私は練習するということです"}, {"type": "subtitle", "time": 25279.99, "timestamp": "07:01:19", "text": "ネザーに向けていくつか戦略を立てる"}, {"type": "subtitle", "time": 25284.07, "timestamp": "07:01:24", "text": "ボスとレッツとフラワーボス"}, {"type": "subtitle", "time": 25286.31, "timestamp": "07:01:26", "text": "ああ、昨日フラワーボスに2つ支払いました"}, {"type": "subtitle", "time": 25288.31, "timestamp": "07:01:28", "text": "私自身は、待つのが少し簡単でした"}, {"type": "subtitle", "time": 25291.51, "timestamp": "07:01:31", "text": "花はどこにあったのか、場所を教えてください。"}, {"type": "subtitle", "time": 25293.948, "timestamp": "07:01:33", "text": "私の基地の近くだったので、"}, {"type": "subtitle", "time": 25296.91, "timestamp": "07:01:36", "text": "ここから本当に遠い"}, {"type": "subtitle", "time": 25300.59, "timestamp": "07:01:40", "text": "ああ、でも、ボスのくだらない話がいくつかあるけど、私は"}, {"type": "subtitle", "time": 25303.788, "timestamp": "07:01:43", "text": "ボブさん、台無しにしたくないんです。"}, {"type": "subtitle", "time": 25304.948, "timestamp": "07:01:44", "text": "ソロ"}, {"type": "subtitle", "time": 25307.868, "timestamp": "07:01:47", "text": "正直に言うととても簡単です"}, {"type": "subtitle", "time": 25309.75, "timestamp": "07:01:49", "text": "トリドンはリーと一緒に投げるだけです"}, {"type": "subtitle", "time": 25312.628, "timestamp": "07:01:52", "text": "ヒルのトリドン、いや、ヒルじゃない"}, {"type": "subtitle", "time": 25313.83, "timestamp": "07:01:53", "text": "トライデントを投げつけるだけで"}, {"type": "subtitle", "time": 25316.91, "timestamp": "07:01:56", "text": "花が咲いて、まるで逃げて、"}]
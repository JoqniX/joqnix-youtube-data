[{"type": "subtitle", "time": 13323.91, "timestamp": "03:42:03", "text": "また、ああ、待って、最高の銃はここにあるよ"}, {"type": "subtitle", "time": 13331.99, "timestamp": "03:42:11", "text": "かなりのエネルギーがあった"}, {"type": "subtitle", "time": 13340.149, "timestamp": "03:42:20", "text": "もっとここに戦利品があるはずだ"}, {"type": "subtitle", "time": 13352.349, "timestamp": "03:42:32", "text": "こちらではあまり多くない"}, {"type": "subtitle", "time": 13354.71, "timestamp": "03:42:34", "text": "ああ、2つ"}, {"type": "subtitle", "time": 13358.75, "timestamp": "03:42:38", "text": "胸部 何でも 何でも"}, {"type": "subtitle", "time": 13368.349, "timestamp": "03:42:48", "text": "金、ああ、それは私が望んでいたものではありません"}, {"type": "subtitle", "time": 13372.55, "timestamp": "03:42:52", "text": "大丈夫、それは"}]
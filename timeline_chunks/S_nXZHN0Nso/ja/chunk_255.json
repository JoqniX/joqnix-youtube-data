[{"type": "subtitle", "time": 15300.63, "timestamp": "04:15:00", "text": "他に天気について話す"}, {"type": "subtitle", "time": 15305.59, "timestamp": "04:15:05", "text": "インドやその他の地域での天気は"}, {"type": "subtitle", "time": 15308.51, "timestamp": "04:15:08", "text": "国々と私たちがなるものすべて"}, {"type": "subtitle", "time": 15310.67, "timestamp": "04:15:10", "text": "右のほうで咳をすると"}, {"type": "subtitle", "time": 15314.109, "timestamp": "04:15:14", "text": "ええ、チューニングすれば参加できます"}, {"type": "subtitle", "time": 15318.98, "timestamp": "04:15:18", "text": "この早期配信に参加するには"}, {"type": "subtitle", "time": 15337.79, "timestamp": "04:15:37", "text": "しばらく配信できなかった"}, {"type": "subtitle", "time": 15340.389, "timestamp": "04:15:40", "text": "えっと、ストリーミングできなかった"}, {"type": "subtitle", "time": 15345.07, "timestamp": "04:15:45", "text": "最近、えっと、最近、つまり私は"}, {"type": "subtitle", "time": 15348.109, "timestamp": "04:15:48", "text": "配信で「戻ってくるよ」と言った。"}, {"type": "subtitle", "time": 15349.79, "timestamp": "04:15:49", "text": "正式に復帰したが、配信はしなかった"}, {"type": "subtitle", "time": 15351.55, "timestamp": "04:15:51", "text": "二"}]
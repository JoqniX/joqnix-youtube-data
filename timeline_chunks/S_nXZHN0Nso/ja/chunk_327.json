[{"type": "subtitle", "time": 19620.788, "timestamp": "05:27:00", "text": "保護シールドを持つゲニンゲニン"}, {"type": "subtitle", "time": 19623.47, "timestamp": "05:27:03", "text": "下忍としてプレイするなら、V のように"}, {"type": "subtitle", "time": 19626.868, "timestamp": "05:27:06", "text": "ボール、えーと、販売用の水晶玉などなど"}, {"type": "subtitle", "time": 19631.07, "timestamp": "05:27:11", "text": "まるでボールが鎧で覆われているかのようだ"}, {"type": "subtitle", "time": 19634.19, "timestamp": "05:27:14", "text": "何かを破壊する、例えばアイテムを。"}, {"type": "subtitle", "time": 19636.868, "timestamp": "05:27:16", "text": "後ろの、周りの"}, {"type": "subtitle", "time": 19638.948, "timestamp": "05:27:18", "text": "エリアか何かで、私たちは"}, {"type": "subtitle", "time": 19641.47, "timestamp": "05:27:21", "text": "私たちもそう思います。"}, {"type": "subtitle", "time": 19644.75, "timestamp": "05:27:24", "text": "特定のアイテムを破壊しなければならない、または"}, {"type": "subtitle", "time": 19648.11, "timestamp": "05:27:28", "text": "えーと、ボスみたいなやつで、えーと、"}, {"type": "subtitle", "time": 19650.75, "timestamp": "05:27:30", "text": "ボスが行くたびに出現する"}, {"type": "subtitle", "time": 19653.03, "timestamp": "05:27:33", "text": "彼は保護モードに入り、"}, {"type": "subtitle", "time": 19655.59, "timestamp": "05:27:35", "text": "すべて順調なので"}, {"type": "subtitle", "time": 19658.67, "timestamp": "05:27:38", "text": "同じパターンを信じて、"}, {"type": "subtitle", "time": 19662.43, "timestamp": "05:27:42", "text": "一種のシステムがここに存在します"}, {"type": "subtitle", "time": 19666.67, "timestamp": "05:27:46", "text": "シャンシャンクの国境のようなものではない"}, {"type": "subtitle", "time": 19669.27, "timestamp": "05:27:49", "text": "フロンティア、あのアニメだよね"}, {"type": "subtitle", "time": 19672.35, "timestamp": "05:27:52", "text": "だから、高度なものになるわけではない"}, {"type": "subtitle", "time": 19674.868, "timestamp": "05:27:54", "text": "高度なものなので、頼らなければならない"}, {"type": "subtitle", "time": 19676.948, "timestamp": "05:27:56", "text": "あなたのスキルと"}, {"type": "subtitle", "time": 19679.548, "timestamp": "05:27:59", "text": "すべて、そしておそらくそれは"}]
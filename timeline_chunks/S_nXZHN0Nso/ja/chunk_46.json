[{"type": "subtitle", "time": 2788.15, "timestamp": "00:46:28", "text": "ビジュアルスタジオの呼び出し"}, {"type": "subtitle", "time": 2791.79, "timestamp": "00:46:31", "text": "バカになるな、バカになるな、"}, {"type": "subtitle", "time": 2799.87, "timestamp": "00:46:39", "text": "お尻こんにちはジョー次はどれくらいかかるの"}, {"type": "subtitle", "time": 2802.15, "timestamp": "00:46:42", "text": "ストリーム"}, {"type": "subtitle", "time": 2809.91, "timestamp": "00:46:49", "text": "場合によりますね。実は制限はないんです。"}, {"type": "subtitle", "time": 2811.95, "timestamp": "00:46:51", "text": "あ、待って、私には"}, {"type": "subtitle", "time": 2815.19, "timestamp": "00:46:55", "text": "制限があります。制限があります。"}, {"type": "subtitle", "time": 2819.109, "timestamp": "00:46:59", "text": "1日に4時間限定で配信"}]
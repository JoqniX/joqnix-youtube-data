[{"type": "subtitle", "time": 25200.83, "timestamp": "07:00:00", "text": "トーテム、そうそう、それで私は"}, {"type": "subtitle", "time": 25203.23, "timestamp": "07:00:03", "text": "彼が私と同じように1つを撃ったことに腹を立てている"}, {"type": "subtitle", "time": 25205.35, "timestamp": "07:00:05", "text": "よし、始めよう"}, {"type": "subtitle", "time": 25209.59, "timestamp": "07:00:09", "text": "ただ楽しむためだけに、それで私がしたことは"}, {"type": "subtitle", "time": 25211.868, "timestamp": "07:00:11", "text": "基本的に私に許可を求めました"}, {"type": "subtitle", "time": 25213.51, "timestamp": "07:00:13", "text": "スーを殺す、彼女が誰なのか分からないから"}, {"type": "subtitle", "time": 25215.43, "timestamp": "07:00:15", "text": "彼を困らせたり、何かして、私は「はい」と答えた。"}, {"type": "subtitle", "time": 25217.628, "timestamp": "07:00:17", "text": "そして彼は私に"}, {"type": "subtitle", "time": 25221.43, "timestamp": "07:00:21", "text": "ミヌット・スイは昨日殺された"}, {"type": "subtitle", "time": 25224.788, "timestamp": "07:00:24", "text": "なぜかって？ わからない、だって彼女は"}, {"type": "subtitle", "time": 25229.788, "timestamp": "07:00:29", "text": "何か言ったけど、彼は気に入らなかった。"}, {"type": "subtitle", "time": 25236.67, "timestamp": "07:00:36", "text": "[音楽]"}, {"type": "subtitle", "time": 25238.99, "timestamp": "07:00:38", "text": "いい感じ"}, {"type": "subtitle", "time": 25242.27, "timestamp": "07:00:42", "text": "慎重に待って、何か見たい"}, {"type": "subtitle", "time": 25244.868, "timestamp": "07:00:44", "text": "もし私がただそれを気に入ったら、彼らはそれを叩かなかった"}, {"type": "subtitle", "time": 25247.548, "timestamp": "07:00:47", "text": "実際には何も起こらないだろう"}, {"type": "subtitle", "time": 25254.75, "timestamp": "07:00:54", "text": "戻るよ、PVPしたいんだね、うん、もちろん"}]
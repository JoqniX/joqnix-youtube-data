[{"type": "subtitle", "time": 15003.71, "timestamp": "04:10:03", "text": "とりあえずこれを使ってみて、どうなるか見てみよう"}, {"type": "subtitle", "time": 15006.63, "timestamp": "04:10:06", "text": "そう、だからそうするだけ"}, {"type": "subtitle", "time": 15008.79, "timestamp": "04:10:08", "text": "今"}, {"type": "subtitle", "time": 15012.03, "timestamp": "04:10:12", "text": "はい、皆さん来てくれてありがとう"}, {"type": "subtitle", "time": 15014.469, "timestamp": "04:10:14", "text": "停電で大変申し訳ありません。"}, {"type": "subtitle", "time": 15017.189, "timestamp": "04:10:17", "text": "私のストリームは利用できませんでした"}, {"type": "subtitle", "time": 15019.99, "timestamp": "04:10:19", "text": "保留状態または読み込み状態のようなもの"}, {"type": "subtitle", "time": 15023.99, "timestamp": "04:10:23", "text": "3時間くらいですか、申し訳ありません。"}, {"type": "subtitle", "time": 15026.91, "timestamp": "04:10:26", "text": "電気関係の件は予想外だった"}, {"type": "subtitle", "time": 15029.79, "timestamp": "04:10:29", "text": "でもまあ、そういうものだし、大丈夫だよ。"}, {"type": "subtitle", "time": 15032.189, "timestamp": "04:10:32", "text": "うん、明日は君たちを"}, {"type": "subtitle", "time": 15034.71, "timestamp": "04:10:34", "text": "明日の出来事について投稿しましたが"}, {"type": "subtitle", "time": 15036.95, "timestamp": "04:10:36", "text": "はい、今日は皆さん来てくださってありがとうございました。"}, {"type": "subtitle", "time": 15040.149, "timestamp": "04:10:40", "text": "犬は何？良い良い"}, {"type": "subtitle", "time": 15042.67, "timestamp": "04:10:42", "text": "これから夜と夕方、または朝"}, {"type": "subtitle", "time": 15044.83, "timestamp": "04:10:44", "text": "もしあなたにとって朝なら、うん、いいよ"}, {"type": "subtitle", "time": 15055.79, "timestamp": "04:10:55", "text": "さようなら、良い一日を"}]
[{"type": "subtitle", "time": 25442.51, "timestamp": "07:04:02", "text": "早く、どうやって待つか、あなたは持っていますか"}, {"type": "subtitle", "time": 25445.91, "timestamp": "07:04:05", "text": "金色の車とリンゴは簡単に作れます"}, {"type": "subtitle", "time": 25449.23, "timestamp": "07:04:09", "text": "ああ、そんなに難しくないよ。金が必要なんだ"}, {"type": "subtitle", "time": 25452.27, "timestamp": "07:04:12", "text": "そうだよ、ゴールデンアップルのために"}, {"type": "subtitle", "time": 25455.51, "timestamp": "07:04:15", "text": "アプリと金塊がたくさん必要ですが、"}, {"type": "subtitle", "time": 25457.91, "timestamp": "07:04:17", "text": "必要なニンジンはゴールデンナゲットと"}, {"type": "subtitle", "time": 25462.31, "timestamp": "07:04:22", "text": "ニンジン、ナゲット、いいですか"}, {"type": "subtitle", "time": 25466.59, "timestamp": "07:04:26", "text": "金の延べ棒と2本を回してもいいですか？"}, {"type": "subtitle", "time": 25469.23, "timestamp": "07:04:29", "text": "ナゲット、うんうん、できるよ、だから9個"}, {"type": "subtitle", "time": 25472.67, "timestamp": "07:04:32", "text": "ナゲットはシングルバーに相当します"}, {"type": "subtitle", "time": 25476.11, "timestamp": "07:04:36", "text": "Hはブロックと同じで、9ゴールドに相当します。"}, {"type": "subtitle", "time": 25479.67, "timestamp": "07:04:39", "text": "バー、そうそう、そしてあなたは"}, {"type": "subtitle", "time": 25483.788, "timestamp": "07:04:43", "text": "単一のインゴットから金塊を移植"}, {"type": "subtitle", "time": 25493.868, "timestamp": "07:04:53", "text": "わかった、ベッドを用意する必要がある"}]
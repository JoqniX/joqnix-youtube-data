[{"type": "subtitle", "time": 16333.63, "timestamp": "04:32:13", "text": "えっと、私が"}, {"type": "subtitle", "time": 16338.269, "timestamp": "04:32:18", "text": "えっと、感じてた"}, {"type": "subtitle", "time": 16345.59, "timestamp": "04:32:25", "text": "うわー、私はHです、一体何が起こっているんですか？"}, {"type": "subtitle", "time": 16349.189, "timestamp": "04:32:29", "text": "こんにちは、ハラさん、ストリーミング配信中ですね。はい、そうです。"}, {"type": "subtitle", "time": 16360.149, "timestamp": "04:32:40", "text": "ああ、そう、これは"}, {"type": "subtitle", "time": 16365.91, "timestamp": "04:32:45", "text": "えーと、ニュース予報はストリームみたいなものです"}, {"type": "subtitle", "time": 16370.03, "timestamp": "04:32:50", "text": "でも今は実際私はそうではない私は私は"}, {"type": "subtitle", "time": 16372.51, "timestamp": "04:32:52", "text": "準備はできていたと思う。うん、わかるよ。"}, {"type": "subtitle", "time": 16376.75, "timestamp": "04:32:56", "text": "代わりにアサドをジョークにするよ"}, {"type": "subtitle", "time": 16378.87, "timestamp": "04:32:58", "text": "朝6時に起きて"}]
[{"type": "subtitle", "time": 25022.83, "timestamp": "06:57:02", "text": "少なくとも彼に勝つことはできるから、もし"}, {"type": "subtitle", "time": 25025.43, "timestamp": "06:57:05", "text": "彼を倒さなきゃいけない、うん、手に入れた、入った"}, {"type": "subtitle", "time": 25030.788, "timestamp": "06:57:10", "text": "どれが問題か、"}, {"type": "subtitle", "time": 25034.19, "timestamp": "06:57:14", "text": "私はただ走っているだけです、ああ"}, {"type": "subtitle", "time": 25036.948, "timestamp": "06:57:16", "text": "神様、ところで私が何を手に入れたか見てください"}, {"type": "subtitle", "time": 25041.59, "timestamp": "06:57:21", "text": "Hもね、おお、いいね、行こう、行こう"}, {"type": "subtitle", "time": 25045.788, "timestamp": "06:57:25", "text": "行って、いい、いい、いい、あなたは隠している"}, {"type": "subtitle", "time": 25049.67, "timestamp": "06:57:29", "text": "バックパックに入れてくれ、いや、違うよ。あ、君を忘れてた。"}, {"type": "subtitle", "time": 25056.35, "timestamp": "06:57:36", "text": "うん、でも私にとってはバックパックは"}, {"type": "subtitle", "time": 25058.388, "timestamp": "06:57:38", "text": "理由はわからないけど、ショー"}, {"type": "subtitle", "time": 25061.548, "timestamp": "06:57:41", "text": "あなたの私は、私ができるかもしれないトールにいるかもしれない"}, {"type": "subtitle", "time": 25063.19, "timestamp": "06:57:43", "text": "可視性"}, {"type": "subtitle", "time": 25064.97, "timestamp": "06:57:44", "text": "これはバックパックです"}, {"type": "subtitle", "time": 25072.628, "timestamp": "06:57:52", "text": "無限の弓も存在する可能性がある"}, {"type": "subtitle", "time": 25075.75, "timestamp": "06:57:55", "text": "インフィニティボウを使いたいけど、"}, {"type": "subtitle", "time": 25076.99, "timestamp": "06:57:56", "text": "そう思う"}]
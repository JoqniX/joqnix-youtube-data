[{"type": "subtitle", "time": 24482.03, "timestamp": "06:48:02", "text": "彼ができれば、私はすべてを変えるだろう"}, {"type": "subtitle", "time": 24484.07, "timestamp": "06:48:04", "text": "ゲーム"}, {"type": "subtitle", "time": 24486.75, "timestamp": "06:48:06", "text": "そして私は勝った"}, {"type": "subtitle", "time": 24505.43, "timestamp": "06:48:25", "text": "えーと"}, {"type": "subtitle", "time": 24512.76, "timestamp": "06:48:32", "text": "ジョン、マルチはどうですか？"}, {"type": "subtitle", "time": 24520.31, "timestamp": "06:48:40", "text": "そしてこれを"}, {"type": "subtitle", "time": 24522.23, "timestamp": "06:48:42", "text": "もの"}, {"type": "subtitle", "time": 24525.35, "timestamp": "06:48:45", "text": "えっと、私のゾンビはどこ？"}, {"type": "subtitle", "time": 24526.75, "timestamp": "06:48:46", "text": "トレーニング"}, {"type": "subtitle", "time": 24535.51, "timestamp": "06:48:55", "text": "ミツキは、あなたが知っているように、彼女が必要としている"}, {"type": "subtitle", "time": 24539.51, "timestamp": "06:48:59", "text": "ブーツとスライドの使い方を学ぶ"}]
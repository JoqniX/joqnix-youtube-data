[{"type": "subtitle", "time": 23702.19, "timestamp": "06:35:02", "text": "できるだけ冷やさなければならないので"}, {"type": "subtitle", "time": 23706.99, "timestamp": "06:35:06", "text": "えーと、できるだけ電話しないといけない"}, {"type": "subtitle", "time": 23710.75, "timestamp": "06:35:10", "text": "あぁ、待って、ソウルスターありがとう"}, {"type": "subtitle", "time": 23713.67, "timestamp": "06:35:13", "text": "わかった、1つ手に入れたよ、St St いいね、いいね、いいね"}, {"type": "subtitle", "time": 23715.788, "timestamp": "06:35:15", "text": "いいねいいねいいね、アンデッドだ"}, {"type": "subtitle", "time": 23717.868, "timestamp": "06:35:17", "text": "アンデッドだ、アンデッドだ、オーケー"}, {"type": "subtitle", "time": 23719.67, "timestamp": "06:35:19", "text": "それは"}, {"type": "subtitle", "time": 23723.27, "timestamp": "06:35:23", "text": "アンデッドだからアンデッドだ、よし、時間だ"}, {"type": "subtitle", "time": 23724.708, "timestamp": "06:35:24", "text": "アンデッドの農場"}, {"type": "subtitle", "time": 23728.27, "timestamp": "06:35:28", "text": "アンデッドが私のところに来る"}, {"type": "subtitle", "time": 23731.708, "timestamp": "06:35:31", "text": "私は普通の骨格です。なぜここにいるのですか？"}, {"type": "subtitle", "time": 23735.27, "timestamp": "06:35:35", "text": "その上で私に持ってきてください"}, {"type": "subtitle", "time": 23737.83, "timestamp": "06:35:37", "text": "アンデッド なぜ朝なんだ 私は欲しい 私は欲しい"}, {"type": "subtitle", "time": 23746.67, "timestamp": "06:35:46", "text": "いや、モブ同士の戦闘にはもっと必要なんだ"}]
[{"type": "subtitle", "time": 17161.35, "timestamp": "04:46:01", "text": "睡眠のうーん、喉と声が"}, {"type": "subtitle", "time": 17164.11, "timestamp": "04:46:04", "text": "喉が痛くて"}, {"type": "subtitle", "time": 17167.51, "timestamp": "04:46:07", "text": "乾燥しているので、何が起こったのか疑問に思っているなら"}, {"type": "subtitle", "time": 17170.15, "timestamp": "04:46:10", "text": "あなたの声にJ、だからそれがここにある"}, {"type": "subtitle", "time": 17172.39, "timestamp": "04:46:12", "text": "あなたの答え"}, {"type": "subtitle", "time": 17176.628, "timestamp": "04:46:16", "text": "喉がすごく乾いて痛いから"}, {"type": "subtitle", "time": 17179.19, "timestamp": "04:46:19", "text": "時々、今は水分補給をしていないので"}, {"type": "subtitle", "time": 17188.67, "timestamp": "04:46:28", "text": "[音楽]"}, {"type": "subtitle", "time": 17198.31, "timestamp": "04:46:38", "text": "保湿効果があって、うん、私は告げ口した"}, {"type": "subtitle", "time": 17202.31, "timestamp": "04:46:42", "text": "私のストリームでは、はい、私は"}, {"type": "subtitle", "time": 17204.628, "timestamp": "04:46:44", "text": "なれ"}, {"type": "subtitle", "time": 17207.47, "timestamp": "04:46:47", "text": "実際にやります"}, {"type": "subtitle", "time": 17214.868, "timestamp": "04:46:54", "text": "やっていると、私は心を開くことになるだろう"}, {"type": "subtitle", "time": 17219.31, "timestamp": "04:46:59", "text": "私は自分の"}]
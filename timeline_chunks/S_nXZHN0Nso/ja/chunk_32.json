[{"type": "subtitle", "time": 1931.629, "timestamp": "00:32:11", "text": "よし、今回はやるよ、私は"}, {"type": "subtitle", "time": 1935.789, "timestamp": "00:32:15", "text": "レベルに到達する"}, {"type": "subtitle", "time": 1941.789, "timestamp": "00:32:21", "text": "ほうきの柄を私は作ります"}, {"type": "subtitle", "time": 1960.59, "timestamp": "00:32:40", "text": "よし、これで完成だ"}, {"type": "subtitle", "time": 1962.549, "timestamp": "00:32:42", "text": "ほうきの柄"}, {"type": "subtitle", "time": 1965.35, "timestamp": "00:32:45", "text": "ああ、本当にそう感じる"}, {"type": "subtitle", "time": 1968.47, "timestamp": "00:32:48", "text": "よかった、あ、待って、私は何をすればいいの？"}]
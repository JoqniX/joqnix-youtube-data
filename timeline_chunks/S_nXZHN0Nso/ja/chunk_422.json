[{"type": "subtitle", "time": 25320.27, "timestamp": "07:02:00", "text": "彼を殴ったが、レオンがレオンを殴った"}, {"type": "subtitle", "time": 25321.99, "timestamp": "07:02:01", "text": "何かあるはずだ、地面にある"}, {"type": "subtitle", "time": 25323.59, "timestamp": "07:02:03", "text": "B、今度は保護装置が付くだろう"}, {"type": "subtitle", "time": 25325.75, "timestamp": "07:02:05", "text": "そう、ジェネレーターを破壊しないといけないんだ。"}, {"type": "subtitle", "time": 25327.708, "timestamp": "07:02:07", "text": "つまり、花のようなもの"}, {"type": "subtitle", "time": 25329.59, "timestamp": "07:02:09", "text": "ワンクリックで簡単に壊せます"}, {"type": "subtitle", "time": 25331.59, "timestamp": "07:02:11", "text": "そしてしばらくすると檻が次々と出現する"}, {"type": "subtitle", "time": 25333.23, "timestamp": "07:02:13", "text": "そう、だから檻を壊して"}, {"type": "subtitle", "time": 25336.31, "timestamp": "07:02:16", "text": "それから花、そしてもし"}, {"type": "subtitle", "time": 25337.91, "timestamp": "07:02:17", "text": "ボスが攻撃してくるので、ただ投げればいい"}, {"type": "subtitle", "time": 25339.75, "timestamp": "07:02:19", "text": "トライデントとBがあれば負けることはない"}, {"type": "subtitle", "time": 25343.11, "timestamp": "07:02:23", "text": "正直に言うと、健康状態がかなり改善しました。"}, {"type": "subtitle", "time": 25346.388, "timestamp": "07:02:26", "text": "トライデントなら、そんなに難しくないよ"}, {"type": "subtitle", "time": 25348.51, "timestamp": "07:02:28", "text": "正直に言うと、私は彼を2回好きです"}, {"type": "subtitle", "time": 25349.99, "timestamp": "07:02:29", "text": "最初は、まあ、わかるでしょ"}, {"type": "subtitle", "time": 25352.19, "timestamp": "07:02:32", "text": "Bを倒そうよ、なぜダメなの？私は好きよ"}, {"type": "subtitle", "time": 25354.67, "timestamp": "07:02:34", "text": "ここで、そして2つ目は、私が"}, {"type": "subtitle", "time": 25358.548, "timestamp": "07:02:38", "text": "よし、これは何をするんだ"}, {"type": "subtitle", "time": 25364.948, "timestamp": "07:02:44", "text": "私にとっては簡単だ、えっと、今は2つある"}, {"type": "subtitle", "time": 25368.31, "timestamp": "07:02:48", "text": "グループ右ボイドTシャツノーウーカオステーマ"}, {"type": "subtitle", "time": 25372.43, "timestamp": "07:02:52", "text": "そして、低いテーマなので、"}, {"type": "subtitle", "time": 25376.23, "timestamp": "07:02:56", "text": "私たちの基地を荒らしたり、権利のないことをしたりする"}]
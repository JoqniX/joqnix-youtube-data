[{"type": "subtitle", "time": 24201.83, "timestamp": "06:43:21", "text": "私たちのボス戦の男によって私は本当に"}, {"type": "subtitle", "time": 24203.38, "timestamp": "06:43:23", "text": "楽しみにしています"}, {"type": "subtitle", "time": 24210.11, "timestamp": "06:43:30", "text": "それはストレスの多いことのようになるだろう"}, {"type": "subtitle", "time": 24213.708, "timestamp": "06:43:33", "text": "なぜなら、チャンスは限られているから"}, {"type": "subtitle", "time": 24225.07, "timestamp": "06:43:45", "text": "私の特別な運命に関して"}, {"type": "subtitle", "time": 24229.19, "timestamp": "06:43:49", "text": "私のチームメイトは、私が"}, {"type": "subtitle", "time": 24232.51, "timestamp": "06:43:52", "text": "与えられたタスクを与えられた私は"}, {"type": "subtitle", "time": 24236.75, "timestamp": "06:43:56", "text": "ソロをリクエストできるかもしれない"}, {"type": "subtitle", "time": 24239.628, "timestamp": "06:43:59", "text": "ソロで戦えるとしたらどうなるか想像してみて"}]
[{"type": "subtitle", "time": 8952.87, "timestamp": "02:29:12", "text": "[音楽]"}, {"type": "subtitle", "time": 8956.269, "timestamp": "02:29:16", "text": "M 3 はパワーナップをします、いいえ、それは、えーと"}, {"type": "subtitle", "time": 8959.79, "timestamp": "02:29:19", "text": "暑さのせいでここはすごく大変だ"}, {"type": "subtitle", "time": 8964.83, "timestamp": "02:29:24", "text": "今から行くから、文字通り"}, {"type": "subtitle", "time": 8967.87, "timestamp": "02:29:27", "text": "工事中はたくさん汗をかくので"}, {"type": "subtitle", "time": 8970.99, "timestamp": "02:29:30", "text": "停電があったので"}, {"type": "subtitle", "time": 8973.75, "timestamp": "02:29:33", "text": "私たちは送り返さなければならなかった"}, {"type": "subtitle", "time": 8976.95, "timestamp": "02:29:36", "text": "労働者たち、えっと、私が思うに、"}, {"type": "subtitle", "time": 8978.55, "timestamp": "02:29:38", "text": "溶接作業か何か、よくわからない"}, {"type": "subtitle", "time": 8980.429, "timestamp": "02:29:40", "text": "いくつか違うものがある"}, {"type": "subtitle", "time": 8982.87, "timestamp": "02:29:42", "text": "パーティーが行き来する"}, {"type": "subtitle", "time": 8984.389, "timestamp": "02:29:44", "text": "工事"}, {"type": "subtitle", "time": 8988.389, "timestamp": "02:29:48", "text": "それで、うん、それで、私はこう思った"}, {"type": "subtitle", "time": 8992.11, "timestamp": "02:29:52", "text": "画家たちがやっているのを見るのは"}, {"type": "subtitle", "time": 8994.03, "timestamp": "02:29:54", "text": "プライマーと呼ばれるもの、または"}, {"type": "subtitle", "time": 8996.07, "timestamp": "02:29:56", "text": "セメントプライマーか何か"}, {"type": "subtitle", "time": 8998.75, "timestamp": "02:29:58", "text": "コーティング剤を塗布する前に"}]
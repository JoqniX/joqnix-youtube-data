[{"type": "subtitle", "time": 18721.548, "timestamp": "05:12:01", "text": "参加する人々に依存する"}, {"type": "subtitle", "time": 18723.83, "timestamp": "05:12:03", "text": "そして私が話している会話に参加してください"}, {"type": "subtitle", "time": 18729.868, "timestamp": "05:12:09", "text": "だいたい合っているけど、もしそれが"}, {"type": "subtitle", "time": 18733.83, "timestamp": "05:12:13", "text": "この段階やTwitterのように"}, {"type": "subtitle", "time": 18735.19, "timestamp": "05:12:15", "text": "空間"}, {"type": "subtitle", "time": 18739.628, "timestamp": "05:12:19", "text": "私が講演する場所と、そこにいる人々"}, {"type": "subtitle", "time": 18742.75, "timestamp": "05:12:22", "text": "できないし、リスナーもできない"}, {"type": "subtitle", "time": 18746.31, "timestamp": "05:12:26", "text": "コメントや返信、その他何でも"}, {"type": "subtitle", "time": 18750.948, "timestamp": "05:12:30", "text": "ただあなたの話を聞いていると"}, {"type": "subtitle", "time": 18754.15, "timestamp": "05:12:34", "text": "そうなったら、もし材料がなくなったらどうなるんだろう？"}, {"type": "subtitle", "time": 18757.11, "timestamp": "05:12:37", "text": "そこで私は何をするだろうか"}, {"type": "subtitle", "time": 18779.67, "timestamp": "05:12:59", "text": "W"}]
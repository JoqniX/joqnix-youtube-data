[{"type": "subtitle", "time": 2823.79, "timestamp": "00:47:03", "text": "しかし、私は12時間働くことに慣れているので"}, {"type": "subtitle", "time": 2826.47, "timestamp": "00:47:06", "text": "ストリームを配信できます。"}, {"type": "subtitle", "time": 2830.99, "timestamp": "00:47:10", "text": "ストリームについては、私は次のように説明します。"}, {"type": "subtitle", "time": 2833.23, "timestamp": "00:47:13", "text": "配信後もまだやるべきことがある"}, {"type": "subtitle", "time": 2836.39, "timestamp": "00:47:16", "text": "そう、非現実的なもの、私はちょっと"}, {"type": "subtitle", "time": 2845.63, "timestamp": "00:47:25", "text": "ああ、4つ以上は行けないという制限があるんです"}, {"type": "subtitle", "time": 2847.43, "timestamp": "00:47:27", "text": "夜間の時間帯"}, {"type": "subtitle", "time": 2849.95, "timestamp": "00:47:29", "text": "朝はどれくらい行けるか"}, {"type": "subtitle", "time": 2859.71, "timestamp": "00:47:39", "text": "一体何で俺を蹴ったと思う？"}]
[{"type": "subtitle", "time": 24600.91, "timestamp": "06:50:00", "text": "そして、もしもあなたがしなければならないかもしれないもの"}, {"type": "subtitle", "time": 24603.35, "timestamp": "06:50:03", "text": "リッチのボス戦では"}, {"type": "subtitle", "time": 24607.75, "timestamp": "06:50:07", "text": "たくさん走り回るよ、だってそれは長い店だから"}, {"type": "subtitle", "time": 24611.99, "timestamp": "06:50:11", "text": "アンデッド、アンデッドF、今そこに"}, {"type": "subtitle", "time": 24615.11, "timestamp": "06:50:15", "text": "たくさんのアンデッドがあなたについてきています"}, {"type": "subtitle", "time": 24617.91, "timestamp": "06:50:17", "text": "これからたくさん動き回るにはどうすればいいですか"}, {"type": "subtitle", "time": 24619.51, "timestamp": "06:50:19", "text": "倒す"}, {"type": "subtitle", "time": 24622.708, "timestamp": "06:50:22", "text": "ボス、ボスはこうなるだろう"}, {"type": "subtitle", "time": 24625.468, "timestamp": "06:50:25", "text": "空気、ああ、待って、君を殺さなきゃ、私は"}, {"type": "subtitle", "time": 24626.75, "timestamp": "06:50:26", "text": "殺す"}, {"type": "subtitle", "time": 24629.3, "timestamp": "06:50:29", "text": "あなたと"}, {"type": "subtitle", "time": 24631.07, "timestamp": "06:50:31", "text": "[音楽]"}, {"type": "subtitle", "time": 24636.99, "timestamp": "06:50:36", "text": "感謝"}, {"type": "subtitle", "time": 24656.868, "timestamp": "06:50:56", "text": "こんにちは、待って、今行くよ、今行くよ、"}]
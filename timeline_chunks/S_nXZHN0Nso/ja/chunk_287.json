[{"type": "subtitle", "time": 17223.47, "timestamp": "04:47:03", "text": "ストリームに寄付リンクがあるので、"}, {"type": "subtitle", "time": 17225.708, "timestamp": "04:47:05", "text": "何と呼ぶか"}, {"type": "subtitle", "time": 17229.99, "timestamp": "04:47:09", "text": "私は何ができるのか、なぜ私は自分の"}, {"type": "subtitle", "time": 17232.59, "timestamp": "04:47:12", "text": "声"}, {"type": "subtitle", "time": 17235.788, "timestamp": "04:47:15", "text": "寄付リンクを開くことができます"}, {"type": "subtitle", "time": 17241.19, "timestamp": "04:47:21", "text": "キャプチャカードを使って、私が手伝うことができるように、"}, {"type": "subtitle", "time": 17243.628, "timestamp": "04:47:23", "text": "それは何て言うんだっけ、ああ神様、なぜ"}, {"type": "subtitle", "time": 17246.948, "timestamp": "04:47:26", "text": "私は混乱しているのでしょうか？"}, {"type": "subtitle", "time": 17255.628, "timestamp": "04:47:35", "text": "戻ってきて、パチパチ、スノップスノップ、止まる"}, {"type": "subtitle", "time": 17261.548, "timestamp": "04:47:41", "text": "止まれ、"}, {"type": "subtitle", "time": 17267.67, "timestamp": "04:47:47", "text": "はい、こんにちは。キャプチャカードについてですが"}, {"type": "subtitle", "time": 17272.67, "timestamp": "04:47:52", "text": "私もちょっと貯金してるから"}, {"type": "subtitle", "time": 17276.07, "timestamp": "04:47:56", "text": "ドンリンクを開設したかったので、"}, {"type": "subtitle", "time": 17279.59, "timestamp": "04:47:59", "text": "君たちは君たちを好きになりたいんだね、君たちが"}]
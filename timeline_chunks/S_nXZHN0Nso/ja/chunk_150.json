[{"type": "subtitle", "time": 9000.67, "timestamp": "02:30:00", "text": "ペンキを塗っていたので、私は"}, {"type": "subtitle", "time": 9003.03, "timestamp": "02:30:03", "text": "彼らがやっているのを見ていた"}, {"type": "subtitle", "time": 9029.83, "timestamp": "02:30:29", "text": "いや、待って、私は"}, {"type": "subtitle", "time": 9054.11, "timestamp": "02:30:54", "text": "ああ、回復は必要ないよ、オートがあるから"}]
[{"type": "subtitle", "time": 3785.789, "timestamp": "01:03:05", "text": "君が持っているものより、まだ持っていないよ。"}, {"type": "subtitle", "time": 3788.109, "timestamp": "01:03:08", "text": "終わったらそれを食べるつもり"}, {"type": "subtitle", "time": 3801.589, "timestamp": "01:03:21", "text": "このタクは赤い軍団兵を危険にさらした"}, {"type": "subtitle", "time": 3803.19, "timestamp": "01:03:23", "text": "それは彼らがどれほど組織的であるかを説明するだろう"}, {"type": "subtitle", "time": 3805.349, "timestamp": "01:03:25", "text": "オリクなしでは、"}, {"type": "subtitle", "time": 3806.789, "timestamp": "01:03:26", "text": "まだ"}, {"type": "subtitle", "time": 3825.549, "timestamp": "01:03:45", "text": "ああ、これらはすべて、18、19、20、21年になります。"}, {"type": "subtitle", "time": 3828.309, "timestamp": "01:03:48", "text": "あと３回走る"}, {"type": "subtitle", "time": 3839.15, "timestamp": "01:03:59", "text": "[音楽]"}]
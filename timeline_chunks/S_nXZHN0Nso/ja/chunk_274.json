[{"type": "subtitle", "time": 16442.99, "timestamp": "04:34:02", "text": "朝から夕方まで、夜は少し"}, {"type": "subtitle", "time": 16449.189, "timestamp": "04:34:09", "text": "ちょっと、それから12くらい、うん、全部"}, {"type": "subtitle", "time": 16452.75, "timestamp": "04:34:12", "text": "夜12時に目が覚めた"}, {"type": "subtitle", "time": 16460.109, "timestamp": "04:34:20", "text": "530 わあ、私はたくさんおしゃべりしているので、私は歩き上がります"}, {"type": "subtitle", "time": 16469.47, "timestamp": "04:34:29", "text": "4時半に起きてお茶を淹れて、少し食べた"}, {"type": "subtitle", "time": 16473.269, "timestamp": "04:34:33", "text": "バナナとスナックを詰める"}, {"type": "subtitle", "time": 16476.51, "timestamp": "04:34:36", "text": "おやつ、そして、うん、もっと起きてるよ"}, {"type": "subtitle", "time": 16478.47, "timestamp": "04:34:38", "text": "薬は健康に問題ないですか？"}, {"type": "subtitle", "time": 16481.189, "timestamp": "04:34:41", "text": "それは、健康に基づいた医療のようなもので、"}, {"type": "subtitle", "time": 16486.109, "timestamp": "04:34:46", "text": "えっと、なんて言うんだっけ、"}, {"type": "subtitle", "time": 16488.029, "timestamp": "04:34:48", "text": "えっと、なんて呼ぶんだっけ？"}, {"type": "subtitle", "time": 16491.109, "timestamp": "04:34:51", "text": "私はそうではないので、薬を飲んでいます"}, {"type": "subtitle", "time": 16494.59, "timestamp": "04:34:54", "text": "睡眠と自分の身の回りの世話"}]
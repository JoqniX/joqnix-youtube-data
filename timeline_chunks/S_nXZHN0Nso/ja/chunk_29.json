[{"type": "subtitle", "time": 1742.909, "timestamp": "00:29:02", "text": "これだけ欲しいんです、ええ、これです"}, {"type": "subtitle", "time": 1746.789, "timestamp": "00:29:06", "text": "コミュニティ専門家が1人待機"}, {"type": "subtitle", "time": 1750.389, "timestamp": "00:29:10", "text": "コミュニティとは何か、私は"}, {"type": "subtitle", "time": 1752.789, "timestamp": "00:29:12", "text": "プロ"}, {"type": "subtitle", "time": 1754.789, "timestamp": "00:29:14", "text": "1つ"}, {"type": "subtitle", "time": 1758.07, "timestamp": "00:29:18", "text": "えっと、何をしたのか分からないけど、うん"}, {"type": "subtitle", "time": 1765.99, "timestamp": "00:29:25", "text": "それをやらせてください"}, {"type": "subtitle", "time": 1769.269, "timestamp": "00:29:29", "text": "ダウンロードしたいのですが、このことが起こりました"}, {"type": "subtitle", "time": 1770.789, "timestamp": "00:29:30", "text": "非現実的"}, {"type": "subtitle", "time": 1775.389, "timestamp": "00:29:35", "text": "できるだけ押し進めたいから"}, {"type": "subtitle", "time": 1785.59, "timestamp": "00:29:45", "text": "なので、今から歩き始めると"}, {"type": "subtitle", "time": 1789.83, "timestamp": "00:29:49", "text": "そして、先延ばしにするようなことは必要ない"}, {"type": "subtitle", "time": 1793.99, "timestamp": "00:29:53", "text": "11でそれに取り組むから、私は働いているんだ"}, {"type": "subtitle", "time": 1797.029, "timestamp": "00:29:57", "text": "今それについて、そして今私が言ったにもかかわらず"}, {"type": "subtitle", "time": 1799.029, "timestamp": "00:29:59", "text": "私自身がしたいこと"}]
[{"type": "subtitle", "time": 16262.429, "timestamp": "04:31:02", "text": "わからない何か"}, {"type": "subtitle", "time": 16270.229, "timestamp": "04:31:10", "text": "つまり、すごい私は"}, {"type": "subtitle", "time": 16273.189, "timestamp": "04:31:13", "text": "良いニュース、私はインド人を使うことができます"}, {"type": "subtitle", "time": 16275.229, "timestamp": "04:31:15", "text": "ニュースですが、"}, {"type": "subtitle", "time": 16278.51, "timestamp": "04:31:18", "text": "国際的ではない私のバカ"}, {"type": "subtitle", "time": 16280.469, "timestamp": "04:31:20", "text": "国際的"}, {"type": "subtitle", "time": 16285.51, "timestamp": "04:31:25", "text": "ヴィアーズなので、H オーケー F にしよう"}, {"type": "subtitle", "time": 16288.99, "timestamp": "04:31:28", "text": "やらないかもしれないと思うよ、大丈夫"}, {"type": "subtitle", "time": 16291.269, "timestamp": "04:31:31", "text": "諦めたくないけど、いつか"}, {"type": "subtitle", "time": 16293.429, "timestamp": "04:31:33", "text": "将来、私はこれができるようになるかもしれない"}, {"type": "subtitle", "time": 16295.91, "timestamp": "04:31:35", "text": "予報のことなので、"}, {"type": "subtitle", "time": 16299.79, "timestamp": "04:31:39", "text": "それでは、朝の講演はそのままにしておきます。"}, {"type": "subtitle", "time": 16311.71, "timestamp": "04:31:51", "text": "目を覚ましているなら、"}, {"type": "subtitle", "time": 16314.67, "timestamp": "04:31:54", "text": "どうぞ、お話しさせてください"}]
[{"type": "subtitle", "time": 8163.709, "timestamp": "02:16:03", "text": "私が来るということは、私は3番目のペアリングだということです"}, {"type": "subtitle", "time": 8178.83, "timestamp": "02:16:18", "text": "パーティー、ああ敵、敵がそれに乗ってる、わかった、わかった"}, {"type": "subtitle", "time": 8211.15, "timestamp": "02:16:51", "text": "いや、彼は私をうまく騙した"}, {"type": "subtitle", "time": 8215.389, "timestamp": "02:16:55", "text": "彼は私をうまく騙した、なぜ私の"}, {"type": "subtitle", "time": 8217.509, "timestamp": "02:16:57", "text": "翻訳中"}]
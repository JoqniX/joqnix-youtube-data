[{"type": "subtitle", "time": 19140.51, "timestamp": "05:19:00", "text": "えーっと、皆さんお元気ですか？"}, {"type": "subtitle", "time": 19143.19, "timestamp": "05:19:03", "text": "ここで、私がまだ生きていることを願っています"}, {"type": "subtitle", "time": 19148.03, "timestamp": "05:19:08", "text": "ああ、気分が悪いよ、寝ちゃったんだ、ただ"}, {"type": "subtitle", "time": 19149.23, "timestamp": "05:19:09", "text": "終了した"}, {"type": "subtitle", "time": 19154.03, "timestamp": "05:19:14", "text": "昼食をとっているので、ここにいます"}, {"type": "subtitle", "time": 19156.67, "timestamp": "05:19:16", "text": "私がやりたいことはいくつかありますが、私たちは"}, {"type": "subtitle", "time": 19159.43, "timestamp": "05:19:19", "text": "他のことをするはずだったけどできない"}, {"type": "subtitle", "time": 19161.51, "timestamp": "05:19:21", "text": "私の"}, {"type": "subtitle", "time": 19164.23, "timestamp": "05:19:24", "text": "頭から離れない"}, {"type": "subtitle", "time": 19171.11, "timestamp": "05:19:31", "text": "頭を下げて何かしたい"}, {"type": "subtitle", "time": 19174.11, "timestamp": "05:19:34", "text": "えっと、何かしたいのですが"}]
[{"type": "subtitle", "time": 23643.15, "timestamp": "06:34:03", "text": "ソウル ソウル ああ ソウル スター 私ができるもの"}, {"type": "subtitle", "time": 23646.548, "timestamp": "06:34:06", "text": "えっと、リッチのボス戦に行きますが、"}, {"type": "subtitle", "time": 23648.83, "timestamp": "06:34:08", "text": "問題はリッチのボス戦だと思う"}, {"type": "subtitle", "time": 23651.788, "timestamp": "06:34:11", "text": "彼はエイアルの男だ、だってリッチだからだろ？"}, {"type": "subtitle", "time": 23653.388, "timestamp": "06:34:13", "text": "彼は"}, {"type": "subtitle", "time": 23658.31, "timestamp": "06:34:18", "text": "地上には、モブのようなモブがいることを知らない"}, {"type": "subtitle", "time": 23660.83, "timestamp": "06:34:20", "text": "アドアルまたは非アドアルのアンデッドモブ"}, {"type": "subtitle", "time": 23664.67, "timestamp": "06:34:24", "text": "アディアルは今、そのすべての理由により"}, {"type": "subtitle", "time": 23668.628, "timestamp": "06:34:28", "text": "私は準備して、どうすればいいのかを学ばなければならない"}, {"type": "subtitle", "time": 23689.51, "timestamp": "06:34:49", "text": "だからファンが来るのを待つよ"}, {"type": "subtitle", "time": 23693.628, "timestamp": "06:34:53", "text": "中に、そして私は7人の弓使いを作らなければならない"}, {"type": "subtitle", "time": 23697.03, "timestamp": "06:34:57", "text": "物を集めなければならないので、できるだけ多くのものを集めなければなりません"}]
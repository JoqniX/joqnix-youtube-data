[{"type": "subtitle", "time": 15362.189, "timestamp": "04:16:02", "text": "昨日、えっと、私配信したっけ？"}, {"type": "subtitle", "time": 15365.55, "timestamp": "04:16:05", "text": "土曜日 土曜日 ああ、私の"}, {"type": "subtitle", "time": 15366.95, "timestamp": "04:16:06", "text": "最後の配信、ああ"}, {"type": "subtitle", "time": 15370.309, "timestamp": "04:16:10", "text": "神様、私の最後の、そう、私の最後の、いつだったかな"}, {"type": "subtitle", "time": 15372.95, "timestamp": "04:16:12", "text": "配信は2日前だったよ、ああ、2日前だ。"}, {"type": "subtitle", "time": 15376.389, "timestamp": "04:16:16", "text": "数日前、金曜日バカだったので私は"}, {"type": "subtitle", "time": 15378.99, "timestamp": "04:16:18", "text": "ストリーム配信"}, {"type": "subtitle", "time": 15387.71, "timestamp": "04:16:27", "text": "ツイートするのを忘れた日があったらどうなったか"}, {"type": "subtitle", "time": 15390.309, "timestamp": "04:16:30", "text": "だった"}, {"type": "subtitle", "time": 15396.109, "timestamp": "04:16:36", "text": "えーっと、そのうちの1つは私の小さな"}, {"type": "subtitle", "time": 15400.71, "timestamp": "04:16:40", "text": "2ヶ月か3ヶ月のニーン"}, {"type": "subtitle", "time": 15403.269, "timestamp": "04:16:43", "text": "古い"}, {"type": "subtitle", "time": 15406.03, "timestamp": "04:16:46", "text": "ああ、名前をつけた"}, {"type": "subtitle", "time": 15412.51, "timestamp": "04:16:52", "text": "彼女の名前は、えっと、リオ・リオ・アイ・ナムです。"}, {"type": "subtitle", "time": 15413.469, "timestamp": "04:16:53", "text": "彼女"}, {"type": "subtitle", "time": 15419.51, "timestamp": "04:16:59", "text": "リオ、それでリオで彼女は亡くなりました"}]
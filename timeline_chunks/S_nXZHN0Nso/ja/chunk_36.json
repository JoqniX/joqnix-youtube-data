[{"type": "subtitle", "time": 2164.87, "timestamp": "00:36:04", "text": "このパーティーで待ってて私だけ？"}, {"type": "subtitle", "time": 2166.79, "timestamp": "00:36:06", "text": "私は唯一の"}, {"type": "subtitle", "time": 2169.349, "timestamp": "00:36:09", "text": "1つ、待って、私だけ、待って"}, {"type": "subtitle", "time": 2171.39, "timestamp": "00:36:11", "text": "彼らのチームメイト"}, {"type": "subtitle", "time": 2208.27, "timestamp": "00:36:48", "text": "危うく私を殺しそうになったが、彼は私を蘇生させなかった。"}, {"type": "subtitle", "time": 2212.47, "timestamp": "00:36:52", "text": "ああ、待って、彼は私を蘇らせてくれた、ありがとう"}]
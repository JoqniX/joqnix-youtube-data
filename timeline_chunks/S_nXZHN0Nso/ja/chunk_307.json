[{"type": "subtitle", "time": 18423.11, "timestamp": "05:07:03", "text": "チャドはそれを歓迎します、はい、私たちは"}, {"type": "subtitle", "time": 18425.27, "timestamp": "05:07:05", "text": "本当に日付を忘れてたよ、うん、忘れてた。"}, {"type": "subtitle", "time": 18430.31, "timestamp": "05:07:10", "text": "デートのことは忘れて、私たちは「えーっと」って感じだった"}, {"type": "subtitle", "time": 18433.91, "timestamp": "05:07:13", "text": "会議をしていて、"}, {"type": "subtitle", "time": 18436.19, "timestamp": "05:07:16", "text": "どんなゲームかとか、その他いろいろ話してる"}, {"type": "subtitle", "time": 18438.75, "timestamp": "05:07:18", "text": "私たちがどのようにすべてのことを行っていたか、そして"}, {"type": "subtitle", "time": 18443.11, "timestamp": "05:07:23", "text": "私たちは2時間で忘れてしまった"}, {"type": "subtitle", "time": 18446.548, "timestamp": "05:07:26", "text": "一日が終わって、私は「待って」って感じだった"}, {"type": "subtitle", "time": 18449.99, "timestamp": "05:07:29", "text": "日付を忘れてしまったので、"}, {"type": "subtitle", "time": 18453.07, "timestamp": "05:07:33", "text": "土曜日と言ったけど、日付を忘れちゃった"}, {"type": "subtitle", "time": 18454.83, "timestamp": "05:07:34", "text": "我が神よ"}, {"type": "subtitle", "time": 18456.23, "timestamp": "05:07:36", "text": "どうやって"}, {"type": "subtitle", "time": 18457.39, "timestamp": "05:07:37", "text": "[音楽]"}, {"type": "subtitle", "time": 18465.03, "timestamp": "05:07:45", "text": "12月11日に言った"}, {"type": "subtitle", "time": 18476.27, "timestamp": "05:07:56", "text": "[音楽]"}, {"type": "subtitle", "time": 18479.15, "timestamp": "05:07:59", "text": "話そう、そう、それは"}]
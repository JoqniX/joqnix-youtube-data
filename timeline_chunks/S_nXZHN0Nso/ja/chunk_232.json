[{"type": "subtitle", "time": 13922.63, "timestamp": "03:52:02", "text": "バン、私はこれを全て残しました"}, {"type": "subtitle", "time": 13926.51, "timestamp": "03:52:06", "text": "絶対に行かないから"}, {"type": "subtitle", "time": 13930.51, "timestamp": "03:52:10", "text": "難しい、なぜこのゲームはこんなに難しいのか"}, {"type": "subtitle", "time": 13933.429, "timestamp": "03:52:13", "text": "ハード いつからストリーミングを始めたんだろう"}, {"type": "subtitle", "time": 13940.309, "timestamp": "03:52:20", "text": "[音楽]"}]
[{"type": "subtitle", "time": 6122.31, "timestamp": "01:42:02", "text": "今日は残念ながらビリーはできませんでした"}, {"type": "subtitle", "time": 6124.51, "timestamp": "01:42:04", "text": "ビリー、私は白を手に入れられなかったから"}, {"type": "subtitle", "time": 6127.95, "timestamp": "01:42:07", "text": "今月のリストを忘れていました"}, {"type": "subtitle", "time": 6131.31, "timestamp": "01:42:11", "text": "ホワイトリストDを事前予約しました。ああ、そうですね。"}, {"type": "subtitle", "time": 6134.47, "timestamp": "01:42:14", "text": "残念ながら、ビリー・ビリーのストリームには"}, {"type": "subtitle", "time": 6138.229, "timestamp": "01:42:18", "text": "白を手に入れるまで待つ"}, {"type": "subtitle", "time": 6141.99, "timestamp": "01:42:21", "text": "リスト、そう、今日はプレイします"}, {"type": "subtitle", "time": 6145.31, "timestamp": "01:42:25", "text": "Apex Legendsの新シーズンがリリースされました"}, {"type": "subtitle", "time": 6148.87, "timestamp": "01:42:28", "text": "新しいレジェンドが登場し、新しいソロモードが追加されました。"}, {"type": "subtitle", "time": 6150.87, "timestamp": "01:42:30", "text": "出てきたものの多くは"}, {"type": "subtitle", "time": 6153.709, "timestamp": "01:42:33", "text": "起こっていることなので、私はとても興奮しています"}, {"type": "subtitle", "time": 6156.27, "timestamp": "01:42:36", "text": "本当に"}, {"type": "subtitle", "time": 6159.39, "timestamp": "01:42:39", "text": "興奮してるから、うん、あ、待って、今気づいた"}, {"type": "subtitle", "time": 6162.91, "timestamp": "01:42:42", "text": "縦型ストリームの私のアバターは、えっと"}, {"type": "subtitle", "time": 6164.95, "timestamp": "01:42:44", "text": "位置が間違っています。ちょっと待って、直させてください。"}, {"type": "subtitle", "time": 6167.27, "timestamp": "01:42:47", "text": "そこにあなたが"}, {"type": "subtitle", "time": 6172.03, "timestamp": "01:42:52", "text": "今日はちょっとぶらぶらしてたんだけど"}, {"type": "subtitle", "time": 6173.91, "timestamp": "01:42:53", "text": "いろいろ直してるんだけど、君に作ってもらったんだ"}, {"type": "subtitle", "time": 6176.79, "timestamp": "01:42:56", "text": "ストリームのオーバーレイなので、"}]
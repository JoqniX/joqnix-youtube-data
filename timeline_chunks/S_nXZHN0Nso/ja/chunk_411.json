[{"type": "subtitle", "time": 24660.07, "timestamp": "06:51:00", "text": "来るよ、来るよ、君が見えるよ、できないよ"}, {"type": "subtitle", "time": 24675.35, "timestamp": "06:51:15", "text": "[音楽]"}, {"type": "subtitle", "time": 24677.28, "timestamp": "06:51:17", "text": "何"}, {"type": "subtitle", "time": 24694.23, "timestamp": "06:51:34", "text": "スペース、えっと、それについては話せません。"}, {"type": "subtitle", "time": 24698.43, "timestamp": "06:51:38", "text": "でも、私が言えるのは、私は下手だということだけです"}, {"type": "subtitle", "time": 24712.59, "timestamp": "06:51:52", "text": "ハードとハッピー、ハッピー"}, {"type": "subtitle", "time": 24715.31, "timestamp": "06:51:55", "text": "火曜日から"}, {"type": "subtitle", "time": 24717.548, "timestamp": "06:51:57", "text": "もっと必要です"}]
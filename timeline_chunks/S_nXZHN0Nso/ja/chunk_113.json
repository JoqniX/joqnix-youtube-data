[{"type": "subtitle", "time": 6791.47, "timestamp": "01:53:11", "text": "[音楽]"}, {"type": "subtitle", "time": 6795.189, "timestamp": "01:53:15", "text": "みなさんこんにちは、ついに戻ってきました"}, {"type": "subtitle", "time": 6797.87, "timestamp": "01:53:17", "text": "神様、私たちはパワーを持っていたことを本当に申し訳なく思います"}, {"type": "subtitle", "time": 6800.75, "timestamp": "01:53:20", "text": "カットしたので、"}, {"type": "subtitle", "time": 6803.589, "timestamp": "01:53:23", "text": "[音楽]"}, {"type": "subtitle", "time": 6807.189, "timestamp": "01:53:27", "text": "ええと、停電なので、"}, {"type": "subtitle", "time": 6815.75, "timestamp": "01:53:35", "text": "ごめん、やっと戻ってきたよ。本当に大変だったんだ。"}, {"type": "subtitle", "time": 6819.27, "timestamp": "01:53:39", "text": "停電があったんだけど、えっと、"}, {"type": "subtitle", "time": 6822.51, "timestamp": "01:53:42", "text": "3時間くらい停電した"}, {"type": "subtitle", "time": 6825.03, "timestamp": "01:53:45", "text": "推測"}, {"type": "subtitle", "time": 6827.47, "timestamp": "01:53:47", "text": "男は"}, {"type": "subtitle", "time": 6831.109, "timestamp": "01:53:51", "text": "はい、こんにちは。はい、正式にライブ配信中です。"}, {"type": "subtitle", "time": 6833.39, "timestamp": "01:53:53", "text": "5つのプラットフォームすべてで"}, {"type": "subtitle", "time": 6837.629, "timestamp": "01:53:57", "text": "ビリービリーが始めたので、うん、いいよ"}]
[{"type": "subtitle", "time": 17050.51, "timestamp": "04:44:10", "text": "よかった、これをリツイートしたらどうなるの？"}, {"type": "subtitle", "time": 17052.788, "timestamp": "04:44:12", "text": "私の配信に表示されるように"}, {"type": "subtitle", "time": 17058.31, "timestamp": "04:44:18", "text": "チャットで、jness がこれをリツイートした"}, {"type": "subtitle", "time": 17062.59, "timestamp": "04:44:22", "text": "あ、待って、Twitchチャットに表示されるけど、"}, {"type": "subtitle", "time": 17066.83, "timestamp": "04:44:26", "text": "YouTubeのチャットにも表示されませんでした"}, {"type": "subtitle", "time": 17071.43, "timestamp": "04:44:31", "text": "LeoボードのYouTube動画が公開されました"}, {"type": "subtitle", "time": 17075.51, "timestamp": "04:44:35", "text": "ええ、拡張機能はリリースされています"}, {"type": "subtitle", "time": 17080.628, "timestamp": "04:44:40", "text": "えっと、いくつか変更する必要があるかもしれません"}, {"type": "subtitle", "time": 17086.628, "timestamp": "04:44:46", "text": "ストリーミングのやり方について、そうですね"}, {"type": "subtitle", "time": 17089.19, "timestamp": "04:44:49", "text": "えっと、なんて言うんだっけ"}, {"type": "subtitle", "time": 17091.868, "timestamp": "04:44:51", "text": "えっと、"}, {"type": "subtitle", "time": 17095.75, "timestamp": "04:44:55", "text": "あなたが私と呼ぶものとは違う、次のように言う"}, {"type": "subtitle", "time": 17097.51, "timestamp": "04:44:57", "text": "コントロールできない"}]
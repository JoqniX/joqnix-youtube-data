[{"type": "subtitle", "time": 18265.23, "timestamp": "05:04:25", "text": "水分補給 なぜかわからない"}, {"type": "subtitle", "time": 18269.11, "timestamp": "05:04:29", "text": "えーっと、だって、だって私は"}, {"type": "subtitle", "time": 18271.868, "timestamp": "05:04:31", "text": "私の体はこうなっていくと思う"}, {"type": "subtitle", "time": 18275.15, "timestamp": "05:04:35", "text": "このリセットフェーズを通して"}, {"type": "subtitle", "time": 18280.948, "timestamp": "05:04:40", "text": "私のリセットはこのようなpHです"}, {"type": "subtitle", "time": 18284.83, "timestamp": "05:04:44", "text": "えっと、それは十分だと思っているから、"}, {"type": "subtitle", "time": 18285.628, "timestamp": "05:04:45", "text": "された"}, {"type": "subtitle", "time": 18287.47, "timestamp": "05:04:47", "text": "寝ている"}, {"type": "subtitle", "time": 18291.868, "timestamp": "05:04:51", "text": "昨日、そのせいで"}, {"type": "subtitle", "time": 18294.59, "timestamp": "05:04:54", "text": "薬を飲んで、たくさん寝たので、"}, {"type": "subtitle", "time": 18297.03, "timestamp": "05:04:57", "text": "体はリセットされていくようなものだ"}]
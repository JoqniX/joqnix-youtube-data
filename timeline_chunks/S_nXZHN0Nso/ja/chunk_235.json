[{"type": "subtitle", "time": 14112.269, "timestamp": "03:55:12", "text": "傷跡、そう、こんにちは女の子、女王、こんにちは"}, {"type": "subtitle", "time": 14123.91, "timestamp": "03:55:23", "text": "彼が私を解放してくれた"}, {"type": "subtitle", "time": 14126.79, "timestamp": "03:55:26", "text": "ガード"}, {"type": "subtitle", "time": 14128.63, "timestamp": "03:55:28", "text": "M"}, {"type": "subtitle", "time": 14135.189, "timestamp": "03:55:35", "text": "神様、私は行かないよ、君は必要ない"}, {"type": "subtitle", "time": 14139.83, "timestamp": "03:55:39", "text": "隠れる、あ、待って、彼は集中しているから"}]
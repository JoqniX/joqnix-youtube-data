[{"type": "chat", "time": 22034.604, "timestamp": "06:07:14", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "but suddenly....the door flew open"}, {"type": "subtitle", "time": 22035.07, "timestamp": "06:07:15", "text": "オオカミのグッディングが子供を養子にしたんだ"}, {"type": "subtitle", "time": 22036.788, "timestamp": "06:07:16", "text": "彼らは泣きながら、自分たちの息子だと分かっていた"}, {"type": "subtitle", "time": 22039.27, "timestamp": "06:07:19", "text": "ああ、あの男の子は彼らの腕に抱かれることは決してないだろう"}, {"type": "subtitle", "time": 22042.67, "timestamp": "06:07:22", "text": "もう一度、わかりました。あなたの"}, {"type": "subtitle", "time": 22045.31, "timestamp": "06:07:25", "text": "第1段落"}, {"type": "subtitle", "time": 22049.628, "timestamp": "06:07:29", "text": "できないの？私をからかってるの？もっと"}, {"type": "subtitle", "time": 22052.27, "timestamp": "06:07:32", "text": "もっとストーリーが必要だが、突然ドアが"}, {"type": "subtitle", "time": 22056.35, "timestamp": "06:07:36", "text": "ダウ f が開いた"}, {"type": "subtitle", "time": 22058.91, "timestamp": "06:07:38", "text": "オオカミのようなチャマがドアをノックした"}, {"type": "subtitle", "time": 22061.91, "timestamp": "06:07:41", "text": "そして、私が連れて行く子供はこう言う"}, {"type": "chat", "time": 22064.214, "timestamp": "06:07:44", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "another townsfolk came with the child and the towssfolk again started laughing again"}, {"type": "subtitle", "time": 22068.35, "timestamp": "06:07:48", "text": "与えて、ああ、そうそう、覚えてるよ"}, {"type": "subtitle", "time": 22069.708, "timestamp": "06:07:49", "text": "視聴中"}, {"type": "subtitle", "time": 22072.39, "timestamp": "06:07:52", "text": "mgly 私は子供と一緒に来ました"}, {"type": "subtitle", "time": 22075.83, "timestamp": "06:07:55", "text": "また笑い始めた"}, {"type": "subtitle", "time": 22079.83, "timestamp": "06:07:59", "text": "なんと彼らは二人とも二重にいたずらをした"}]
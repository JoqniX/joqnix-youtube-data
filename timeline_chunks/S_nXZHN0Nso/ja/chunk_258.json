[{"type": "subtitle", "time": 15486.03, "timestamp": "04:18:06", "text": "あなたと2番目の部分で何が起こったのか"}, {"type": "subtitle", "time": 15489.269, "timestamp": "04:18:09", "text": "とても"}, {"type": "subtitle", "time": 15493.429, "timestamp": "04:18:13", "text": "土曜日の朝に座りました"}, {"type": "subtitle", "time": 15498.67, "timestamp": "04:18:18", "text": "私は犬の医者に行きました"}, {"type": "subtitle", "time": 15502.75, "timestamp": "04:18:22", "text": "予約は犬に渡った"}, {"type": "subtitle", "time": 15506.429, "timestamp": "04:18:26", "text": "それで、それを何と呼ぶか​​、ええ、私たちは行きました"}, {"type": "subtitle", "time": 15511.07, "timestamp": "04:18:31", "text": "電話して話をして、ニュースで呼ばれた"}, {"type": "subtitle", "time": 15514.07, "timestamp": "04:18:34", "text": "そして私は彼らに私の睡眠について話"}, {"type": "subtitle", "time": 15517.67, "timestamp": "04:18:37", "text": "最近の問題や、私が"}, {"type": "subtitle", "time": 15520.349, "timestamp": "04:18:40", "text": "最近は"}, {"type": "subtitle", "time": 15524.309, "timestamp": "04:18:44", "text": "うん、うん、そうだよ"}, {"type": "subtitle", "time": 15528.87, "timestamp": "04:18:48", "text": "車に何かあったが、何が起こったかというと"}, {"type": "subtitle", "time": 15531.67, "timestamp": "04:18:51", "text": "日曜日に私はうっかり"}, {"type": "subtitle", "time": 15536.91, "timestamp": "04:18:56", "text": "土曜の夜に私は実際に"}]
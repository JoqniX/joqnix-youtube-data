[{"type": "subtitle", "time": 23820.708, "timestamp": "06:37:00", "text": "後で蜂蜜を集めなければならない"}, {"type": "subtitle", "time": 23823.388, "timestamp": "06:37:03", "text": "バケツ いくつかバケツがあるので、できると思います"}, {"type": "subtitle", "time": 23826.31, "timestamp": "06:37:06", "text": "つまり、私が変換しなければならないのは"}, {"type": "subtitle", "time": 23828.35, "timestamp": "06:37:08", "text": "このエリアを"}, {"type": "subtitle", "time": 23830.07, "timestamp": "06:37:10", "text": "全体"}, {"type": "subtitle", "time": 23833.03, "timestamp": "06:37:13", "text": "戦場全体"}, {"type": "subtitle", "time": 23836.868, "timestamp": "06:37:16", "text": "そうですね、あるいはこのエリアを刈り取ることもできます"}, {"type": "subtitle", "time": 23838.83, "timestamp": "06:37:18", "text": "この部分は"}, {"type": "subtitle", "time": 23841.83, "timestamp": "06:37:21", "text": "エリアI それは価値があるかどうかわかりません"}, {"type": "subtitle", "time": 23843.868, "timestamp": "06:37:23", "text": "しかし、戦場では私はこう感じる"}, {"type": "subtitle", "time": 23848.31, "timestamp": "06:37:28", "text": "このエリアはとても良いです。より宇宙的です。"}, {"type": "subtitle", "time": 23851.51, "timestamp": "06:37:31", "text": "はい、では始めましょう"}, {"type": "subtitle", "time": 23854.75, "timestamp": "06:37:34", "text": "掘り下げていくと、質問は、私が自分のえーと欲しいかどうかです"}, {"type": "subtitle", "time": 23858.468, "timestamp": "06:37:38", "text": "バトルフィールドアリーナはここにあるべきか、それとも"}, {"type": "subtitle", "time": 23861.07, "timestamp": "06:37:41", "text": "そうあってほしい"}, {"type": "subtitle", "time": 23871.548, "timestamp": "06:37:51", "text": "質問です、それが質問です、私は何を"}]
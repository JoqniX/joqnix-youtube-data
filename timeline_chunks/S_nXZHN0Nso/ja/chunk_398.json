[{"type": "subtitle", "time": 23893.43, "timestamp": "06:38:13", "text": "アストラと取引できたらいいのに"}, {"type": "subtitle", "time": 23897.19, "timestamp": "06:38:17", "text": "試練のためにボスをソロで倒せば、"}, {"type": "subtitle", "time": 23900.468, "timestamp": "06:38:20", "text": "チームメイトに何が起こるかを伝える"}, {"type": "subtitle", "time": 23901.15, "timestamp": "06:38:21", "text": "そして"}, {"type": "subtitle", "time": 23904.35, "timestamp": "06:38:24", "text": "それを打ち負かす方法とその他すべて"}, {"type": "subtitle", "time": 23907.15, "timestamp": "06:38:27", "text": "もしかしたらうまくいくかもしれないけど、"}, {"type": "subtitle", "time": 23911.51, "timestamp": "06:38:31", "text": "情報もまた騙される可能性がある"}, {"type": "subtitle", "time": 23913.83, "timestamp": "06:38:33", "text": "騙されたが、あまり変わらなかった。"}, {"type": "subtitle", "time": 23916.67, "timestamp": "06:38:36", "text": "他のチームメイトや、"}, {"type": "subtitle", "time": 23919.67, "timestamp": "06:38:39", "text": "彼らを死に追いやるか何か"}, {"type": "subtitle", "time": 23921.708, "timestamp": "06:38:41", "text": "想像する"}, {"type": "subtitle", "time": 23938.388, "timestamp": "06:38:58", "text": "きっとそうなるだろう"}]
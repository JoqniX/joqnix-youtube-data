[{"type": "subtitle", "time": 12548.51, "timestamp": "03:29:08", "text": "このオクタン価がそうでないことを願うべきではないでしょうか"}, {"type": "subtitle", "time": 12552.07, "timestamp": "03:29:12", "text": "私を見つけてください、あなたが私なら彼を殺せます、もしあなたが"}, {"type": "subtitle", "time": 12555.309, "timestamp": "03:29:15", "text": "あなたに知ってほしかったけど、私は受け取らない方がいい"}, {"type": "subtitle", "time": 12577.67, "timestamp": "03:29:37", "text": "ライフラインは、"}, {"type": "subtitle", "time": 12580.63, "timestamp": "03:29:40", "text": "私にこれ"}, {"type": "subtitle", "time": 12584.229, "timestamp": "03:29:44", "text": "ライフラインは俺と同じだ、男が彼の"}]
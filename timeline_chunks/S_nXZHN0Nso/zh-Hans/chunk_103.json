[{"type": "subtitle", "time": 6181.31, "timestamp": "01:43:01", "text": "正在直播，所以，嗯嗯，大家好"}, {"type": "subtitle", "time": 6185.79, "timestamp": "01:43:05", "text": "欢迎，你好，你好，眼镜很适合你。"}, {"type": "subtitle", "time": 6188.99, "timestamp": "01:43:08", "text": "你午饭吃了什么？是的，我吃了。"}, {"type": "subtitle", "time": 6193.79, "timestamp": "01:43:13", "text": "我确实吃了午饭。"}, {"type": "subtitle", "time": 6203.99, "timestamp": "01:43:23", "text": "是的，进展如何？局域网怎么样？"}, {"type": "subtitle", "time": 6206.55, "timestamp": "01:43:26", "text": "打招呼"}, {"type": "subtitle", "time": 6211.629, "timestamp": "01:43:31", "text": "欢迎来到我的水频道"}, {"type": "subtitle", "time": 6214.149, "timestamp": "01:43:34", "text": "垂直流没问题吧？"}, {"type": "subtitle", "time": 6216.83, "timestamp": "01:43:36", "text": "对吧？我希望是这样。"}, {"type": "subtitle", "time": 6221.39, "timestamp": "01:43:41", "text": "好吧，总之，大家昨天过得怎么样？"}, {"type": "subtitle", "time": 6225.189, "timestamp": "01:43:45", "text": "我们玩了……嗯……我老是忘了是什么游戏。"}, {"type": "subtitle", "time": 6228.31, "timestamp": "01:43:48", "text": "那是我玩的游戏的名字。"}, {"type": "subtitle", "time": 6231.51, "timestamp": "01:43:51", "text": "昨天呃，是鸡肉，亲爱的。"}, {"type": "subtitle", "time": 6234.709, "timestamp": "01:43:54", "text": "我忘了什么，嗯，对，就是那个。"}, {"type": "subtitle", "time": 6236.51, "timestamp": "01:43:56", "text": "我们昨天玩的游戏是"}, {"type": "subtitle", "time": 6238.83, "timestamp": "01:43:58", "text": "除了数学部分之外，其他部分都很有趣。"}]
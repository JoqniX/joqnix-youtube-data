[{"type": "chat", "time": 22142.347, "timestamp": "06:09:02", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "\"well, who said we couldnt prank you to sire\" the townsfolk saying this to the husband"}, {"type": "subtitle", "time": 22146.75, "timestamp": "06:09:06", "text": "人们为了什么？哦，是吗？我不知道。"}, {"type": "subtitle", "time": 22149.07, "timestamp": "06:09:09", "text": "这真的是个故事吗？嗯，是谁？"}, {"type": "subtitle", "time": 22151.35, "timestamp": "06:09:11", "text": "我们说我们不能捉弄你，所以也捉弄你。"}, {"type": "subtitle", "time": 22155.27, "timestamp": "06:09:15", "text": "s 声音 th F 向"}, {"type": "subtitle", "time": 22157.51, "timestamp": "06:09:17", "text": "丈夫"}, {"type": "chat", "time": 22159.787, "timestamp": "06:09:19", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "the husband, now angered by this notion"}, {"type": "chat", "time": 22162.92, "timestamp": "06:09:22", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "double prank"}, {"type": "subtitle", "time": 22165.468, "timestamp": "06:09:25", "text": "被恶作剧了，那谁来恶作剧呢？"}, {"type": "subtitle", "time": 22166.99, "timestamp": "06:09:26", "text": "城镇"}, {"type": "subtitle", "time": 22170.708, "timestamp": "06:09:30", "text": "丈夫现在很生气"}, {"type": "chat", "time": 22172.852, "timestamp": "06:09:32", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "drew his knife on his waist...."}, {"type": "subtitle", "time": 22175.788, "timestamp": "06:09:35", "text": "没错，这确实是个双重恶作剧。"}, {"type": "subtitle", "time": 22179.468, "timestamp": "06:09:39", "text": "他做了什么？他抓住了……"}, {"type": "subtitle", "time": 22183.708, "timestamp": "06:09:43", "text": "喉咙像被刀划过一样，刀尖抵在他的腰间，哦不"}, {"type": "subtitle", "time": 22184.75, "timestamp": "06:09:44", "text": "哦"}, {"type": "subtitle", "time": 22190.31, "timestamp": "06:09:50", "text": "不哦"}, {"type": "subtitle", "time": 22194.83, "timestamp": "06:09:54", "text": "不，哦不，怎么回事？为什么故事要这样发展？"}, {"type": "chat", "time": 22196.76, "timestamp": "06:09:56", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "he lunged forward and stabbed the guy who carried the child"}, {"type": "subtitle", "time": 22197.75, "timestamp": "06:09:57", "text": "黑暗？哦不，为什么故事要变得黑暗了？"}, {"type": "chat", "time": 22199.565, "timestamp": "06:09:59", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "🌑🕶"}]
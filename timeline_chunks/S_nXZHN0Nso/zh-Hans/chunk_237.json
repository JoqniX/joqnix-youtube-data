[{"type": "subtitle", "time": 14221.11, "timestamp": "03:57:01", "text": "至少要拿到两个人头我才行"}, {"type": "subtitle", "time": 14224.149, "timestamp": "03:57:04", "text": "玩玩或者做点别的，习惯一下。"}, {"type": "subtitle", "time": 14226.87, "timestamp": "03:57:06", "text": "机械和"}, {"type": "subtitle", "time": 14257.63, "timestamp": "03:57:37", "text": "我的天，他把我耍得团团转，他真的耍了我。"}]
[{"type": "subtitle", "time": 3180.589, "timestamp": "00:53:00", "text": "我的天哪"}, {"type": "subtitle", "time": 3188.19, "timestamp": "00:53:08", "text": "他动作很慢，等等，什么枪？"}, {"type": "subtitle", "time": 3189.589, "timestamp": "00:53:09", "text": "是"}, {"type": "subtitle", "time": 3205.069, "timestamp": "00:53:25", "text": "这是什么枪？哦，太好了！"}, {"type": "subtitle", "time": 3212.47, "timestamp": "00:53:32", "text": "我会回来的，祝你旅途愉快！"}, {"type": "subtitle", "time": 3230.67, "timestamp": "00:53:50", "text": "别忘了保持水分充足。"}]
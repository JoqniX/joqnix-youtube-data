[{"type": "subtitle", "time": 18016.39, "timestamp": "05:00:16", "text": "是啊，今天是联合国大会，所以毫无准备，拜托了"}, {"type": "subtitle", "time": 18018.67, "timestamp": "05:00:18", "text": "赛"}, {"type": "subtitle", "time": 18022.43, "timestamp": "05:00:22", "text": "对我来说，这就像一种“你……”的感觉。"}, {"type": "subtitle", "time": 18023.51, "timestamp": "05:00:23", "text": "称呼"}, {"type": "subtitle", "time": 18028.03, "timestamp": "05:00:28", "text": "那种感觉，你知道你拥有"}, {"type": "subtitle", "time": 18031.628, "timestamp": "05:00:31", "text": "你可以，但是该怎么称呼它呢？"}, {"type": "subtitle", "time": 18033.67, "timestamp": "05:00:33", "text": "知道你是"}, {"type": "subtitle", "time": 18038.83, "timestamp": "05:00:38", "text": "有限的，你必须和G有关的东西"}, {"type": "subtitle", "time": 18041.788, "timestamp": "05:00:41", "text": "你所拥有的会限制这一点，但你也一样"}, {"type": "subtitle", "time": 18045.19, "timestamp": "05:00:45", "text": "知道你可以出去。"}, {"type": "subtitle", "time": 18048.868, "timestamp": "05:00:48", "text": "盒子，等等，就像你在一个盒子里一样。"}, {"type": "subtitle", "time": 18052.03, "timestamp": "05:00:52", "text": "你知道怎么出去，但你也知道你"}, {"type": "subtitle", "time": 18055.27, "timestamp": "05:00:55", "text": "要知道你周围还有其他盒子。"}, {"type": "subtitle", "time": 18056.948, "timestamp": "05:00:56", "text": "有点儿"}]
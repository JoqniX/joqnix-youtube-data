[{"type": "chat", "time": 22034.604, "timestamp": "06:07:14", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "but suddenly....the door flew open"}, {"type": "subtitle", "time": 22035.07, "timestamp": "06:07:15", "text": "古丁狼收养了那个孩子，是的。"}, {"type": "subtitle", "time": 22036.788, "timestamp": "06:07:16", "text": "她们哭泣时，认出了自己的孩子"}, {"type": "subtitle", "time": 22039.27, "timestamp": "06:07:19", "text": "呃，这孩子永远不会被他们抱在怀里。"}, {"type": "subtitle", "time": 22042.67, "timestamp": "06:07:22", "text": "好的，我再发一些你的信息。"}, {"type": "subtitle", "time": 22045.31, "timestamp": "06:07:25", "text": "第一段"}, {"type": "subtitle", "time": 22049.628, "timestamp": "06:07:29", "text": "你难道不能吗？你是在戏弄我，我到底在想什么？"}, {"type": "subtitle", "time": 22052.27, "timestamp": "06:07:32", "text": "还需要更多故事，但突然门开了。"}, {"type": "subtitle", "time": 22056.35, "timestamp": "06:07:36", "text": "飞开了哦，双翼"}, {"type": "subtitle", "time": 22058.91, "timestamp": "06:07:38", "text": "狼人查玛敲门了吗？"}, {"type": "subtitle", "time": 22061.91, "timestamp": "06:07:41", "text": "然后就像这样：这是我要带走的孩子。"}, {"type": "chat", "time": 22064.214, "timestamp": "06:07:44", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "another townsfolk came with the child and the towssfolk again started laughing again"}, {"type": "subtitle", "time": 22068.35, "timestamp": "06:07:48", "text": "送人mgly哦耶耶我记得"}, {"type": "subtitle", "time": 22069.708, "timestamp": "06:07:49", "text": "观看"}, {"type": "subtitle", "time": 22072.39, "timestamp": "06:07:52", "text": "mgly 我带着孩子来了"}, {"type": "subtitle", "time": 22075.83, "timestamp": "06:07:55", "text": "又开始笑了起来，什么？"}, {"type": "subtitle", "time": 22079.83, "timestamp": "06:07:59", "text": "他们居然对两人都进行了双重恶作剧！"}]
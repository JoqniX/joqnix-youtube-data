[{"type": "subtitle", "time": 25380.59, "timestamp": "07:03:00", "text": "就像你知道的，阿斯拉说的，在你的"}, {"type": "subtitle", "time": 25382.27, "timestamp": "07:03:02", "text": "基地不安全"}, {"type": "subtitle", "time": 25385.15, "timestamp": "07:03:05", "text": "如果它不在……之下，如果它不是……"}, {"type": "subtitle", "time": 25386.83, "timestamp": "07:03:06", "text": "是的，塔楼"}, {"type": "subtitle", "time": 25389.75, "timestamp": "07:03:09", "text": "那么，即使你是……，这意味着什么呢？"}, {"type": "subtitle", "time": 25391.83, "timestamp": "07:03:11", "text": "与boss战斗并探索"}, {"type": "subtitle", "time": 25395.388, "timestamp": "07:03:15", "text": "我觉得有些事或许会有那么一段时间发生。"}, {"type": "subtitle", "time": 25397.628, "timestamp": "07:03:17", "text": "我们必须互相残杀，或者"}, {"type": "subtitle", "time": 25400.628, "timestamp": "07:03:20", "text": "是啊，没错，我是说谁"}, {"type": "subtitle", "time": 25402.31, "timestamp": "07:03:22", "text": "知道我们甚至可能不得不背叛我们自己"}, {"type": "subtitle", "time": 25405.51, "timestamp": "07:03:25", "text": "自己的队伍没有啊"}, {"type": "subtitle", "time": 25415.91, "timestamp": "07:03:35", "text": "我的意思是，呃，就像他在……里说的那样"}, {"type": "subtitle", "time": 25419.03, "timestamp": "07:03:39", "text": "一开始就像你知道的那样，只有"}, {"type": "subtitle", "time": 25422.19, "timestamp": "07:03:42", "text": "你知道，我们还活着，而且只有一个人活着。"}, {"type": "subtitle", "time": 25436.03, "timestamp": "07:03:56", "text": "如果你愿意，我可以帮你弄一把铲子。"}, {"type": "subtitle", "time": 25439.468, "timestamp": "07:03:59", "text": "我想要的是一场真正的黄金秀"}]
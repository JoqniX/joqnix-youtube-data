[{"type": "subtitle", "time": 15541.309, "timestamp": "04:19:01", "text": "比如饭前和饭后"}, {"type": "subtitle", "time": 15544.63, "timestamp": "04:19:04", "text": "晚上吃完晚饭后，我们一起……"}, {"type": "subtitle", "time": 15546.59, "timestamp": "04:19:06", "text": "所以发生的事情是我的"}, {"type": "subtitle", "time": 15549.63, "timestamp": "04:19:09", "text": "身体对这种药物不太适应"}, {"type": "subtitle", "time": 15552.429, "timestamp": "04:19:12", "text": "这是我第一次服用这个"}, {"type": "subtitle", "time": 15557.389, "timestamp": "04:19:17", "text": "所以，就这一点而言，它就像是一个完整的"}, {"type": "subtitle", "time": 15560.109, "timestamp": "04:19:20", "text": "我当时睡着的样子叫什么？"}, {"type": "subtitle", "time": 15563.55, "timestamp": "04:19:23", "text": "熟睡就像……我没有醒来。"}, {"type": "subtitle", "time": 15567.429, "timestamp": "04:19:27", "text": "大概过了12个小时，但我醒了。"}, {"type": "subtitle", "time": 15569.99, "timestamp": "04:19:29", "text": "我又感到困了，所以继续……"}, {"type": "subtitle", "time": 15572.07, "timestamp": "04:19:32", "text": "睡啊睡啊睡"}, {"type": "subtitle", "time": 15575.99, "timestamp": "04:19:35", "text": "实际上，昨天整夜整天都是如此"}, {"type": "subtitle", "time": 15580.309, "timestamp": "04:19:40", "text": "是啊，我什么都做不了。"}, {"type": "subtitle", "time": 15583.189, "timestamp": "04:19:43", "text": "哇哦"}, {"type": "subtitle", "time": 15586.51, "timestamp": "04:19:46", "text": "是的，那是其中之一。"}, {"type": "subtitle", "time": 15591.59, "timestamp": "04:19:51", "text": "所以今天，呃，我们走吧，呃，我们继续"}, {"type": "subtitle", "time": 15594.189, "timestamp": "04:19:54", "text": "关于一些事情，它会是"}, {"type": "subtitle", "time": 15599.109, "timestamp": "04:19:59", "text": "嗯，这周就先这样吧，所以……"}]
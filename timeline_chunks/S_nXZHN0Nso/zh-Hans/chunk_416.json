[{"type": "subtitle", "time": 24961.91, "timestamp": "06:56:01", "text": "刀锋耶耶啊耶耶耶"}, {"type": "subtitle", "time": 24963.468, "timestamp": "06:56:03", "text": "对对，这些就是自定义怪物。"}, {"type": "subtitle", "time": 24965.23, "timestamp": "06:56:05", "text": "所以你可以从他们那里获得图腾，嗯，有……"}, {"type": "subtitle", "time": 24968.15, "timestamp": "06:56:08", "text": "同时释放一个类似唤魔者的怪物，它会不断生成。"}, {"type": "subtitle", "time": 24970.27, "timestamp": "06:56:10", "text": "在冰原生物群系中，如果你掉下去的话"}, {"type": "subtitle", "time": 24973.11, "timestamp": "06:56:13", "text": "你杀了他，他会掉落一个图腾。"}, {"type": "subtitle", "time": 24974.868, "timestamp": "06:56:14", "text": "是的，如果冻住了，如果你杀了它"}, {"type": "subtitle", "time": 24977.43, "timestamp": "06:56:17", "text": "幻象一：它会掉落一个图腾"}, {"type": "subtitle", "time": 24980.91, "timestamp": "06:56:20", "text": "幻觉啊，是的，我不知道那是什么。"}, {"type": "subtitle", "time": 24982.86, "timestamp": "06:56:22", "text": "其余部分"}, {"type": "subtitle", "time": 24984.468, "timestamp": "06:56:24", "text": "[音乐]"}, {"type": "subtitle", "time": 24987.27, "timestamp": "06:56:27", "text": "不过等等，你对巫妖有办法吧？"}, {"type": "subtitle", "time": 24991.868, "timestamp": "06:56:31", "text": "巫妖是人类的敌人，对吧？哦，是的。"}, {"type": "subtitle", "time": 24993.91, "timestamp": "06:56:33", "text": "虽然我渴望胜利，但我还没有战胜失败。"}, {"type": "subtitle", "time": 24997.388, "timestamp": "06:56:37", "text": "我也想反抗，你也想反抗"}, {"type": "subtitle", "time": 24999.91, "timestamp": "06:56:39", "text": "或许我想和他们一起做这件事"}, {"type": "subtitle", "time": 25002.23, "timestamp": "06:56:42", "text": "现在这支队伍我不能单枪匹马，我必须……"}, {"type": "subtitle", "time": 25005.43, "timestamp": "06:56:45", "text": "和团队一起做这件事，我很乐意。"}, {"type": "subtitle", "time": 25008.19, "timestamp": "06:56:48", "text": "如果可以的话，我想问问阿斯拉，能不能给我一点免费试用时间？"}, {"type": "subtitle", "time": 25012.708, "timestamp": "06:56:52", "text": "把他传送走什么的，但他不会这么做。"}, {"type": "subtitle", "time": 25016.468, "timestamp": "06:56:56", "text": "不会吧？我的意思是，我们必须召唤……"}, {"type": "subtitle", "time": 25019.628, "timestamp": "06:56:59", "text": "我们没有边缘就无法召唤他"}]
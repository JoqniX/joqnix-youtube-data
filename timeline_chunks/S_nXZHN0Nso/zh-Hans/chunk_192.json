[{"type": "subtitle", "time": 11520.67, "timestamp": "03:12:00", "text": "好的，等等，让我拿一下我的……我做了一些"}, {"type": "subtitle", "time": 11562.99, "timestamp": "03:12:42", "text": "说实话，现在一直都在讨论汤"}, {"type": "subtitle", "time": 11565.229, "timestamp": "03:12:45", "text": "自从我去了……之后，我就一直对汤类食物很感兴趣。"}, {"type": "subtitle", "time": 11569.19, "timestamp": "03:12:49", "text": "餐厅喝汤，不，还有……"}, {"type": "subtitle", "time": 11571.99, "timestamp": "03:12:51", "text": "用那个包装袋做汤"}, {"type": "subtitle", "time": 11574.349, "timestamp": "03:12:54", "text": "我忘了是哪个牌子了。"}, {"type": "subtitle", "time": 11578.389, "timestamp": "03:12:58", "text": "我竟然忘了是哪个牌子了"}]
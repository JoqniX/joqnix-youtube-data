[{"type": "subtitle", "time": 25262.388, "timestamp": "07:01:02", "text": "秒 m"}, {"type": "subtitle", "time": 25264.548, "timestamp": "07:01:04", "text": "混乱团队表现如何？"}, {"type": "subtitle", "time": 25266.708, "timestamp": "07:01:06", "text": "你在混乱队，对吧，混乱队"}, {"type": "subtitle", "time": 25270.51, "timestamp": "07:01:10", "text": "团队，我指的是整个团队。"}, {"type": "subtitle", "time": 25273.788, "timestamp": "07:01:13", "text": "其他所有球队我都不了解。"}, {"type": "subtitle", "time": 25277.788, "timestamp": "07:01:17", "text": "我知道我的意思是，我我我练习知道练习"}, {"type": "subtitle", "time": 25279.99, "timestamp": "07:01:19", "text": "我为下界制定了一些策略。"}, {"type": "subtitle", "time": 25284.07, "timestamp": "07:01:24", "text": "老板、让我们和花老板"}, {"type": "subtitle", "time": 25286.31, "timestamp": "07:01:26", "text": "哦，我昨天付了两个花老板的钱。"}, {"type": "subtitle", "time": 25288.31, "timestamp": "07:01:28", "text": "我自己的情况还算容易，等等吧。"}, {"type": "subtitle", "time": 25291.51, "timestamp": "07:01:31", "text": "花在哪里？告诉我它的位置。"}, {"type": "subtitle", "time": 25293.948, "timestamp": "07:01:33", "text": "它离我的基地很近，所以算是……"}, {"type": "subtitle", "time": 25296.91, "timestamp": "07:01:36", "text": "离这里很远"}, {"type": "subtitle", "time": 25300.59, "timestamp": "07:01:40", "text": "哦，但是呃，我知道一些老板的废话，但我会"}, {"type": "subtitle", "time": 25303.788, "timestamp": "07:01:43", "text": "我不想剧透，老板鲍勃，我想……"}, {"type": "subtitle", "time": 25304.948, "timestamp": "07:01:44", "text": "独奏"}, {"type": "subtitle", "time": 25307.868, "timestamp": "07:01:47", "text": "坦诚相待非常容易"}, {"type": "subtitle", "time": 25309.75, "timestamp": "07:01:49", "text": "tridon 就在 Lee 旁边，直接扔掉"}, {"type": "subtitle", "time": 25312.628, "timestamp": "07:01:52", "text": "特里顿在水蛭处，不，不是水蛭"}, {"type": "subtitle", "time": 25313.83, "timestamp": "07:01:53", "text": "你知道，直接把三叉戟扔过去就行了。"}, {"type": "subtitle", "time": 25316.91, "timestamp": "07:01:56", "text": "花朵，就像逃跑一样，试图"}]
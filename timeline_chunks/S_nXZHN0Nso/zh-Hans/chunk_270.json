[{"type": "subtitle", "time": 16201.109, "timestamp": "04:30:01", "text": "所以，我最近就像……"}, {"type": "subtitle", "time": 16203.59, "timestamp": "04:30:03", "text": "直播的时候我说，好的，我会试试这个"}, {"type": "subtitle", "time": 16206.87, "timestamp": "04:30:06", "text": "天气预报用来告诉呃呃哪个"}, {"type": "subtitle", "time": 16209.189, "timestamp": "04:30:09", "text": "呃，就是那种我谈论的……"}, {"type": "subtitle", "time": 16212.349, "timestamp": "04:30:12", "text": "天气和一切"}, {"type": "subtitle", "time": 16214.87, "timestamp": "04:30:14", "text": "原本的计划是这样，但现在我想……"}, {"type": "subtitle", "time": 16216.55, "timestamp": "04:30:16", "text": "它会怎样？"}, {"type": "subtitle", "time": 16220.109, "timestamp": "04:30:20", "text": "我呃分发"}, {"type": "subtitle", "time": 16222.309, "timestamp": "04:30:22", "text": "它就像"}, {"type": "subtitle", "time": 16225.91, "timestamp": "04:30:25", "text": "内容有点像"}, {"type": "subtitle", "time": 16229.71, "timestamp": "04:30:29", "text": "对我来说有点难，至少就像……"}, {"type": "subtitle", "time": 16231.87, "timestamp": "04:30:31", "text": "比如，你管它叫什么？"}, {"type": "subtitle", "time": 16237.429, "timestamp": "04:30:37", "text": "我应该把它限制在我的州内吗？"}, {"type": "subtitle", "time": 16239.99, "timestamp": "04:30:39", "text": "像预测结果显示的国家那样"}, {"type": "subtitle", "time": 16243.189, "timestamp": "04:30:43", "text": "印度，但印度是一个国家，但也有"}, {"type": "subtitle", "time": 16244.309, "timestamp": "04:30:44", "text": "很多"}, {"type": "subtitle", "time": 16247.67, "timestamp": "04:30:47", "text": "说明我应该使用哪些所有"}, {"type": "subtitle", "time": 16250.55, "timestamp": "04:30:50", "text": "我应该使用哪个州，还是应该只使用哪个州"}, {"type": "subtitle", "time": 16254.189, "timestamp": "04:30:54", "text": "印度作为一个整体，并且停留"}, {"type": "subtitle", "time": 16258.03, "timestamp": "04:30:58", "text": "更好的论坛对每个州或"}]
[{"type": "subtitle", "time": 23702.19, "timestamp": "06:35:02", "text": "因为我必须尽可能多地给它上色"}, {"type": "subtitle", "time": 23706.99, "timestamp": "06:35:06", "text": "呃，我得尽可能多地打电话"}, {"type": "subtitle", "time": 23710.75, "timestamp": "06:35:10", "text": "哦哦等等，哦，灵魂之星，谢谢你"}, {"type": "subtitle", "time": 23713.67, "timestamp": "06:35:13", "text": "明白了，我有一个圣圣，真好真好"}, {"type": "subtitle", "time": 23715.788, "timestamp": "06:35:15", "text": "好，好，好，原来是亡灵啊。"}, {"type": "subtitle", "time": 23717.868, "timestamp": "06:35:17", "text": "亡灵，好吧，就是亡灵，好吧"}, {"type": "subtitle", "time": 23719.67, "timestamp": "06:35:19", "text": "这是"}, {"type": "subtitle", "time": 23723.27, "timestamp": "06:35:23", "text": "亡灵，所以亡灵们，好了，是时候了"}, {"type": "subtitle", "time": 23724.708, "timestamp": "06:35:24", "text": "农场亡灵的"}, {"type": "subtitle", "time": 23728.27, "timestamp": "06:35:28", "text": "亡灵，快来，到我这里来。"}, {"type": "subtitle", "time": 23731.708, "timestamp": "06:35:31", "text": "我是普通的骷髅，你为什么在这里？"}, {"type": "subtitle", "time": 23735.27, "timestamp": "06:35:35", "text": "在哪里把东西带给我"}, {"type": "subtitle", "time": 23737.83, "timestamp": "06:35:37", "text": "亡灵，为什么现在是早上？我想要，我想要"}, {"type": "subtitle", "time": 23746.67, "timestamp": "06:35:46", "text": "不，我需要更多怪物来战斗哦"}]
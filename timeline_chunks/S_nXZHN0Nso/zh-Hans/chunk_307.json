[{"type": "subtitle", "time": 18423.11, "timestamp": "05:07:03", "text": "查德，他们很欢迎那件事，是的，我们"}, {"type": "subtitle", "time": 18425.27, "timestamp": "05:07:05", "text": "真的忘了日期，是的，我们确实忘了。"}, {"type": "subtitle", "time": 18430.31, "timestamp": "05:07:10", "text": "别提日期了，我们当时就……嗯……"}, {"type": "subtitle", "time": 18433.91, "timestamp": "05:07:13", "text": "我们正在开会，我们当时"}, {"type": "subtitle", "time": 18436.19, "timestamp": "05:07:16", "text": "谈论游戏以及所有事情"}, {"type": "subtitle", "time": 18438.75, "timestamp": "05:07:18", "text": "我们当时是如何做所有事情的"}, {"type": "subtitle", "time": 18443.11, "timestamp": "05:07:23", "text": "我们花了两个小时，然后就忘了……"}, {"type": "subtitle", "time": 18446.548, "timestamp": "05:07:26", "text": "一天下来，到了最后我心想：等等"}, {"type": "subtitle", "time": 18449.99, "timestamp": "05:07:29", "text": "我们忘了该填哪天日期了，呃，我们"}, {"type": "subtitle", "time": 18453.07, "timestamp": "05:07:33", "text": "星期六说的，结果我们忘了日期哦"}, {"type": "subtitle", "time": 18454.83, "timestamp": "05:07:34", "text": "我的上帝"}, {"type": "subtitle", "time": 18456.23, "timestamp": "05:07:36", "text": "如何"}, {"type": "subtitle", "time": 18457.39, "timestamp": "05:07:37", "text": "[音乐]"}, {"type": "subtitle", "time": 18465.03, "timestamp": "05:07:45", "text": "嗯，他说的是12月11日。"}, {"type": "subtitle", "time": 18476.27, "timestamp": "05:07:56", "text": "[音乐]"}, {"type": "subtitle", "time": 18479.15, "timestamp": "05:07:59", "text": "聊聊，哦，是的，已经很久了"}]
[{"type": "subtitle", "time": 12548.51, "timestamp": "03:29:08", "text": "我难道不应该希望这种辛烷值不会"}, {"type": "subtitle", "time": 12552.07, "timestamp": "03:29:12", "text": "找到我，如果你能找到我，我就可以杀了他。"}, {"type": "subtitle", "time": 12555.309, "timestamp": "03:29:15", "text": "你知道，我想要你，但我不应该接受"}, {"type": "subtitle", "time": 12577.67, "timestamp": "03:29:37", "text": "生命线和它是一样的"}, {"type": "subtitle", "time": 12580.63, "timestamp": "03:29:40", "text": "给我这个"}, {"type": "subtitle", "time": 12584.229, "timestamp": "03:29:44", "text": "生命线，跟我一样，伙计，他正在尝试"}]
[{"type": "subtitle", "time": 4440.99, "timestamp": "01:14:00", "text": "是的，你好"}, {"type": "subtitle", "time": 4452.43, "timestamp": "01:14:12", "text": "来"}, {"type": "subtitle", "time": 4465.47, "timestamp": "01:14:25", "text": "上帝仍然是我的队友"}, {"type": "subtitle", "time": 4468.229, "timestamp": "01:14:28", "text": "哦，它们就在里面。"}, {"type": "subtitle", "time": 4470.79, "timestamp": "01:14:30", "text": "你能得到"}, {"type": "subtitle", "time": 4473.75, "timestamp": "01:14:33", "text": "我过得很好，你呢？"}, {"type": "subtitle", "time": 4477.39, "timestamp": "01:14:37", "text": "我刚吃完午饭，现在还在……"}, {"type": "subtitle", "time": 4480.709, "timestamp": "01:14:40", "text": "是啊，没错，《命运》刷刷刷"}]
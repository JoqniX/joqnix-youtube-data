[{"type": "subtitle", "time": 24003.59, "timestamp": "06:40:03", "text": "所以等等，砾石能帮上忙吗？"}, {"type": "subtitle", "time": 24006.91, "timestamp": "06:40:06", "text": "我要检查一下这个罐子"}, {"type": "subtitle", "time": 24012.02, "timestamp": "06:40:12", "text": "砾石可以让我们用砾石"}, {"type": "subtitle", "time": 24013.19, "timestamp": "06:40:13", "text": "[音乐]"}, {"type": "subtitle", "time": 24015.75, "timestamp": "06:40:15", "text": "解决无"}, {"type": "subtitle", "time": 24019.628, "timestamp": "06:40:19", "text": "不，哦，是的，我，如果我做了，我，我计划了"}, {"type": "subtitle", "time": 24022.948, "timestamp": "06:40:22", "text": "我已经制定了应对熔岩攻击的策略。"}, {"type": "subtitle", "time": 24026.11, "timestamp": "06:40:26", "text": "我能做的就是教你，我会"}, {"type": "subtitle", "time": 24027.788, "timestamp": "06:40:27", "text": "告诉你我的等待，我应该是什么"}, {"type": "subtitle", "time": 24029.91, "timestamp": "06:40:29", "text": "我不知道该如何传授我的秘密，但是"}, {"type": "subtitle", "time": 24033.75, "timestamp": "06:40:33", "text": "对，穿上这个，把牵引绳套上。"}, {"type": "subtitle", "time": 24037.868, "timestamp": "06:40:37", "text": "如果是首领，进入前先用绳子拴住敌人。"}, {"type": "subtitle", "time": 24041.27, "timestamp": "06:40:41", "text": "前面放洛杉矶，放熔岩回去"}, {"type": "subtitle", "time": 24045.07, "timestamp": "06:40:45", "text": "切换到此模式，然后恢复"}, {"type": "subtitle", "time": 24047.548, "timestamp": "06:40:47", "text": "做这个手臂"}, {"type": "subtitle", "time": 24050.31, "timestamp": "06:40:50", "text": "这和来"}, {"type": "subtitle", "time": 24055.468, "timestamp": "06:40:55", "text": "以防万一我掉进岩浆里"}, {"type": "subtitle", "time": 24057.75, "timestamp": "06:40:57", "text": "像这样切换"}]
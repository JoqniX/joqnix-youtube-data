[{"type": "subtitle", "time": 24781.43, "timestamp": "06:53:01", "text": "英石"}, {"type": "subtitle", "time": 24789.99, "timestamp": "06:53:09", "text": "我快要死了吗？我的天哪，我简直不敢相信"}, {"type": "subtitle", "time": 24791.388, "timestamp": "06:53:11", "text": "我快要死了"}, {"type": "subtitle", "time": 24795.03, "timestamp": "06:53:15", "text": "一个令人愉快的"}, {"type": "subtitle", "time": 24798.83, "timestamp": "06:53:18", "text": "暴徒 守护者"}, {"type": "subtitle", "time": 24818.59, "timestamp": "06:53:38", "text": "哦，两只末影人，谢谢你们，你们真棒！"}, {"type": "subtitle", "time": 24822.708, "timestamp": "06:53:42", "text": "兄弟们来这里"}, {"type": "subtitle", "time": 24825.83, "timestamp": "06:53:45", "text": "他们最讨厌的就是你戳他们"}, {"type": "subtitle", "time": 24828.548, "timestamp": "06:53:48", "text": "后面那个……好吧，这倒是个不错的弱点。"}, {"type": "subtitle", "time": 24831.75, "timestamp": "06:53:51", "text": "知道我在寻找什么，这很好。"}, {"type": "subtitle", "time": 24833.23, "timestamp": "06:53:53", "text": "在"}, {"type": "subtitle", "time": 24835.42, "timestamp": "06:53:55", "text": "我看着你"}]
[{"type": "subtitle", "time": 2941.99, "timestamp": "00:49:01", "text": "你知道，因为我重置了电脑。"}, {"type": "subtitle", "time": 2943.15, "timestamp": "00:49:03", "text": "原因"}, {"type": "subtitle", "time": 2946.99, "timestamp": "00:49:06", "text": "我感觉就像我的游戏电脑，就是我那台……"}, {"type": "subtitle", "time": 2952.589, "timestamp": "00:49:12", "text": "玩游戏感觉越来越过了"}, {"type": "subtitle", "time": 2955.39, "timestamp": "00:49:15", "text": "垃圾，但那不是真正的垃圾"}, {"type": "subtitle", "time": 2958.349, "timestamp": "00:49:18", "text": "因为它快满了，我有点"}, {"type": "subtitle", "time": 2960.789, "timestamp": "00:49:20", "text": "想要它就像"}, {"type": "subtitle", "time": 2971.309, "timestamp": "00:49:31", "text": "别告诉我你们没做过什么。"}, {"type": "subtitle", "time": 2972.549, "timestamp": "00:49:32", "text": "做"}, {"type": "subtitle", "time": 2988.71, "timestamp": "00:49:48", "text": "什么？什么鬼？什么鬼？"}, {"type": "subtitle", "time": 2998.57, "timestamp": "00:49:58", "text": "有人是第一个"}]
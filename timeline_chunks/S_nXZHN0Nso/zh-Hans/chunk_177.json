[{"type": "subtitle", "time": 10639.07, "timestamp": "02:57:19", "text": "我啊"}, {"type": "subtitle", "time": 10641.63, "timestamp": "02:57:21", "text": "哦，我没有"}, {"type": "subtitle", "time": 10644.67, "timestamp": "02:57:24", "text": "我别无选择"}, {"type": "subtitle", "time": 10653.469, "timestamp": "02:57:33", "text": "伙计，是啊，感觉就像是，是啊，我"}, {"type": "subtitle", "time": 10656.99, "timestamp": "02:57:36", "text": "我会抓住你，改变敌人，改变你。"}, {"type": "subtitle", "time": 10659.389, "timestamp": "02:57:39", "text": "我当时甚至连枪都没有。"}, {"type": "subtitle", "time": 10661.75, "timestamp": "02:57:41", "text": "试着爬上像柱子一样的东西"}, {"type": "subtitle", "time": 10664.91, "timestamp": "02:57:44", "text": "就像大管道突然从恐慌中冒出来一样"}, {"type": "subtitle", "time": 10666.83, "timestamp": "02:57:46", "text": "我没有"}, {"type": "subtitle", "time": 10669.71, "timestamp": "02:57:49", "text": "选择，但我确实得到了，我确实得到了"}, {"type": "subtitle", "time": 10672.15, "timestamp": "02:57:52", "text": "在他杀死他之前，先揍他或踢他。"}, {"type": "subtitle", "time": 10674.83, "timestamp": "02:57:54", "text": "对我来说，就是这样。"}, {"type": "subtitle", "time": 10679.51, "timestamp": "02:57:59", "text": "还好，我至少给了个赞。"}]
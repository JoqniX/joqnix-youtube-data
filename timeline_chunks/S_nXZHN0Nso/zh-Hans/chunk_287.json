[{"type": "subtitle", "time": 17223.47, "timestamp": "04:47:03", "text": "直播间里会有捐赠链接，这样我就可以……"}, {"type": "subtitle", "time": 17225.708, "timestamp": "04:47:05", "text": "你管它叫什么？"}, {"type": "subtitle", "time": 17229.99, "timestamp": "04:47:09", "text": "我能……呃……为什么我发现我的"}, {"type": "subtitle", "time": 17232.59, "timestamp": "04:47:12", "text": "嗓音"}, {"type": "subtitle", "time": 17235.788, "timestamp": "04:47:15", "text": "我可以打开捐款链接。"}, {"type": "subtitle", "time": 17241.19, "timestamp": "04:47:21", "text": "采集卡，这样我就可以帮忙了，嗯，所以为了"}, {"type": "subtitle", "time": 17243.628, "timestamp": "04:47:23", "text": "那叫什么来着？我的天哪，为什么？"}, {"type": "subtitle", "time": 17246.948, "timestamp": "04:47:26", "text": "我糊涂了，糊涂了哦"}, {"type": "subtitle", "time": 17255.628, "timestamp": "04:47:35", "text": "你回来咔嚓咔嚓，停下"}, {"type": "subtitle", "time": 17261.548, "timestamp": "04:47:41", "text": "停停停停停停停停停"}, {"type": "subtitle", "time": 17267.67, "timestamp": "04:47:47", "text": "是的，哦，天哪，嗨，关于采集卡"}, {"type": "subtitle", "time": 17272.67, "timestamp": "04:47:52", "text": "我也在攒钱，所以……"}, {"type": "subtitle", "time": 17276.07, "timestamp": "04:47:56", "text": "想开一个 Don 链接，这样如果"}, {"type": "subtitle", "time": 17279.59, "timestamp": "04:47:59", "text": "你们想要你们就像如果你们能"}]
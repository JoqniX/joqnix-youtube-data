[{"type": "subtitle", "time": 18123.59, "timestamp": "05:02:03", "text": "印度人喜欢兽医方面的东西，但我做不到。"}, {"type": "subtitle", "time": 18127.31, "timestamp": "05:02:07", "text": "呃，准备一下，还有，呃，你怎么做？"}, {"type": "subtitle", "time": 18132.27, "timestamp": "05:02:12", "text": "就说它是油漆，去天气预报"}, {"type": "subtitle", "time": 18135.39, "timestamp": "05:02:15", "text": "我最近一次说过的话"}, {"type": "subtitle", "time": 18138.708, "timestamp": "05:02:18", "text": "现在开始直播，我想了想，啊，我应该……"}, {"type": "subtitle", "time": 18139.67, "timestamp": "05:02:19", "text": "有"}, {"type": "subtitle", "time": 18141.868, "timestamp": "05:02:21", "text": "我想我当时应该看看的。"}, {"type": "subtitle", "time": 18144.628, "timestamp": "05:02:24", "text": "我需要准备一些东西，然后才能谈到"}, {"type": "subtitle", "time": 18151.75, "timestamp": "05:02:31", "text": "很专注，但是，我却把它弄成了这样"}, {"type": "subtitle", "time": 18155.39, "timestamp": "05:02:35", "text": "清晨免费讲座"}, {"type": "subtitle", "time": 18160.19, "timestamp": "05:02:40", "text": "谈话内容是 ASA，ASA 的意思是早上好。"}, {"type": "subtitle", "time": 18171.35, "timestamp": "05:02:51", "text": "是的，这是直播的第一期。"}, {"type": "subtitle", "time": 18174.83, "timestamp": "05:02:54", "text": "这是第一季，所以我……我是什么？"}, {"type": "subtitle", "time": 18177.39, "timestamp": "05:02:57", "text": "我在想，如果我这样做"}]
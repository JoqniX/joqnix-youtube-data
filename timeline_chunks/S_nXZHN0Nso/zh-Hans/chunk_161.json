[{"type": "subtitle", "time": 9661.11, "timestamp": "02:41:01", "text": "愚蠢的事情我们不谈"}, {"type": "subtitle", "time": 9663.19, "timestamp": "02:41:03", "text": "那"}, {"type": "subtitle", "time": 9667.95, "timestamp": "02:41:07", "text": "我们不谈论那个，我的天哪"}, {"type": "subtitle", "time": 9676.95, "timestamp": "02:41:16", "text": "比利，我喜欢我刚刚错过的每一个"}, {"type": "subtitle", "time": 9704.99, "timestamp": "02:41:44", "text": "好的，上面写着广播，呃，临时的。"}, {"type": "subtitle", "time": 9707.15, "timestamp": "02:41:47", "text": "我不知道我不应该尝试什么"}, {"type": "subtitle", "time": 9709.23, "timestamp": "02:41:49", "text": "难以置信的流媒体播放，你知道我在说什么吗？"}, {"type": "subtitle", "time": 9711.99, "timestamp": "02:41:51", "text": "我离溪流很近，就休息吧。"}, {"type": "subtitle", "time": 9714.67, "timestamp": "02:41:54", "text": "直播我就不播了"}]
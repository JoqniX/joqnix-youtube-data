[{"type": "subtitle", "time": 7382.47, "timestamp": "02:03:02", "text": "好的，你好，嗯，嘘，欢迎回来。"}, {"type": "subtitle", "time": 7384.31, "timestamp": "02:03:04", "text": "猜对了，谢谢"}, {"type": "subtitle", "time": 7388.51, "timestamp": "02:03:08", "text": "你的电力恢复了，伙计，在B点。"}, {"type": "subtitle", "time": 7390.95, "timestamp": "02:03:10", "text": "显然，呃，主电源装置"}, {"type": "subtitle", "time": 7394.55, "timestamp": "02:03:14", "text": "就是那个主要的……呃……电源装置。"}, {"type": "subtitle", "time": 7398.95, "timestamp": "02:03:18", "text": "被轰隆隆地轰了一圈，他们花了很长时间才缓过来。"}, {"type": "subtitle", "time": 7409.31, "timestamp": "02:03:29", "text": "Alex 使用了终极 AEL 加速器，嗯"}, {"type": "subtitle", "time": 7411.149, "timestamp": "02:03:31", "text": "愈合"}, {"type": "subtitle", "time": 7413.91, "timestamp": "02:03:33", "text": "哦"}, {"type": "subtitle", "time": 7434.149, "timestamp": "02:03:54", "text": "嗯，好起来"}, {"type": "subtitle", "time": 7436.669, "timestamp": "02:03:56", "text": "发生了什么事？"}, {"type": "subtitle", "time": 7439.189, "timestamp": "02:03:59", "text": "关于这一点"}]
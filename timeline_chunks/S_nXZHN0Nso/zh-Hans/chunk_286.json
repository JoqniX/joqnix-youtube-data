[{"type": "subtitle", "time": 17161.35, "timestamp": "04:46:01", "text": "嗯，睡眠让我喉咙发紧，声音嘶哑，"}, {"type": "subtitle", "time": 17164.11, "timestamp": "04:46:04", "text": "喉咙感觉好难受"}, {"type": "subtitle", "time": 17167.51, "timestamp": "04:46:07", "text": "所以，如果你想知道发生了什么，那就说明已经很干燥了。"}, {"type": "subtitle", "time": 17170.15, "timestamp": "04:46:10", "text": "听你的声音 J，就是这样，就是这样。"}, {"type": "subtitle", "time": 17172.39, "timestamp": "04:46:12", "text": "您的答案"}, {"type": "subtitle", "time": 17176.628, "timestamp": "04:46:16", "text": "因为我的喉咙很干，而且很疼。"}, {"type": "subtitle", "time": 17179.19, "timestamp": "04:46:19", "text": "有时是因为我现在没有补充水分，"}, {"type": "subtitle", "time": 17188.67, "timestamp": "04:46:28", "text": "[音乐]"}, {"type": "subtitle", "time": 17198.31, "timestamp": "04:46:38", "text": "补水，嗯，我确实……说了。"}, {"type": "subtitle", "time": 17202.31, "timestamp": "04:46:42", "text": "我的直播，是的，我会"}, {"type": "subtitle", "time": 17204.628, "timestamp": "04:46:44", "text": "是"}, {"type": "subtitle", "time": 17207.47, "timestamp": "04:46:47", "text": "我会做的，实际上"}, {"type": "subtitle", "time": 17214.868, "timestamp": "04:46:54", "text": "做吧，我知道我会像敞开心扉一样。"}, {"type": "subtitle", "time": 17219.31, "timestamp": "04:46:59", "text": "我的，我会打开我的嗯"}]
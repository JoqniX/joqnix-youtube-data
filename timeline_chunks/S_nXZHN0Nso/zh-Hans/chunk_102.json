[{"type": "subtitle", "time": 6122.31, "timestamp": "01:42:02", "text": "很遗憾，今天我没能和比利见面。"}, {"type": "subtitle", "time": 6124.51, "timestamp": "01:42:04", "text": "比利，因为我没拿到我的白色"}, {"type": "subtitle", "time": 6127.95, "timestamp": "01:42:07", "text": "这个月的清单我忘了列了。"}, {"type": "subtitle", "time": 6131.31, "timestamp": "01:42:11", "text": "提前预订我的白名单 D 啊，所以是的"}, {"type": "subtitle", "time": 6134.47, "timestamp": "01:42:14", "text": "遗憾的是，比利比利直播将不会有"}, {"type": "subtitle", "time": 6138.229, "timestamp": "01:42:18", "text": "等我拿到我的白色"}, {"type": "subtitle", "time": 6141.99, "timestamp": "01:42:21", "text": "所以，今天我们要玩的就是这个列表。"}, {"type": "subtitle", "time": 6145.31, "timestamp": "01:42:25", "text": "《Apex英雄》新赛季上线了。"}, {"type": "subtitle", "time": 6148.87, "timestamp": "01:42:28", "text": "新传奇角色登场，还有新的单人模式。"}, {"type": "subtitle", "time": 6150.87, "timestamp": "01:42:30", "text": "出来了，很多事情都是"}, {"type": "subtitle", "time": 6153.709, "timestamp": "01:42:33", "text": "事情正在发生，所以我真的很兴奋。"}, {"type": "subtitle", "time": 6156.27, "timestamp": "01:42:36", "text": "真的"}, {"type": "subtitle", "time": 6159.39, "timestamp": "01:42:39", "text": "好激动啊，哦等等，我刚刚意识到"}, {"type": "subtitle", "time": 6162.91, "timestamp": "01:42:42", "text": "我在垂直直播流上的头像呃"}, {"type": "subtitle", "time": 6164.95, "timestamp": "01:42:44", "text": "位置不对，等等，让我调整一下"}, {"type": "subtitle", "time": 6167.27, "timestamp": "01:42:47", "text": "你就在那里"}, {"type": "subtitle", "time": 6172.03, "timestamp": "01:42:52", "text": "我今天到处闲逛，感觉就像……"}, {"type": "subtitle", "time": 6173.91, "timestamp": "01:42:53", "text": "修理东西，我让你做了一个"}, {"type": "subtitle", "time": 6176.79, "timestamp": "01:42:56", "text": "由于我们有流媒体的叠加层，所以"}]
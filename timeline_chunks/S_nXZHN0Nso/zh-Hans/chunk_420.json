[{"type": "subtitle", "time": 25200.83, "timestamp": "07:00:00", "text": "图腾，对，我当时有点……"}, {"type": "subtitle", "time": 25203.23, "timestamp": "07:00:03", "text": "我很生气，他竟然没像我一样就开了一枪。"}, {"type": "subtitle", "time": 25205.35, "timestamp": "07:00:05", "text": "说好的，就像我们应该开始了一样。"}, {"type": "subtitle", "time": 25209.59, "timestamp": "07:00:09", "text": "纯粹为了好玩，对吧？所以我就这么做了。"}, {"type": "subtitle", "time": 25211.868, "timestamp": "07:00:11", "text": "基本上是向我征求许可"}, {"type": "subtitle", "time": 25213.51, "timestamp": "07:00:13", "text": "杀了苏，因为我不知道她是谁"}, {"type": "subtitle", "time": 25215.43, "timestamp": "07:00:15", "text": "打扰他什么的，我说是的"}, {"type": "subtitle", "time": 25217.628, "timestamp": "07:00:17", "text": "他给了我一个去"}, {"type": "subtitle", "time": 25221.43, "timestamp": "07:00:21", "text": "昨天，Minut Sui 被杀了。"}, {"type": "subtitle", "time": 25224.788, "timestamp": "07:00:24", "text": "为什么？呃，我不知道，因为她"}, {"type": "subtitle", "time": 25229.788, "timestamp": "07:00:29", "text": "他说了些什么，但他不喜欢哦我的天"}, {"type": "subtitle", "time": 25236.67, "timestamp": "07:00:36", "text": "[音乐]"}, {"type": "subtitle", "time": 25238.99, "timestamp": "07:00:38", "text": "真好"}, {"type": "subtitle", "time": 25242.27, "timestamp": "07:00:42", "text": "稍等片刻，我想看看情况。"}, {"type": "subtitle", "time": 25244.868, "timestamp": "07:00:44", "text": "如果我只是喜欢它，却没打中他们呢？"}, {"type": "subtitle", "time": 25247.548, "timestamp": "07:00:47", "text": "实际上什么都不会发生。"}, {"type": "subtitle", "time": 25254.75, "timestamp": "07:00:54", "text": "好的，你想玩PVP？嗯，当然可以。"}]
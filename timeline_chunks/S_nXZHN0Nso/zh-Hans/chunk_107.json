[{"type": "subtitle", "time": 6420.51, "timestamp": "01:47:00", "text": "很遗憾，我没能……呃，比利"}, {"type": "subtitle", "time": 6424.87, "timestamp": "01:47:04", "text": "比利，我真是……嗯，是的，我需要一个……我找到了"}, {"type": "subtitle", "time": 6428.99, "timestamp": "01:47:08", "text": "物美价廉的服务"}, {"type": "subtitle", "time": 6432.79, "timestamp": "01:47:12", "text": "我打算买那个，呃，就像那个"}, {"type": "subtitle", "time": 6437.229, "timestamp": "01:47:17", "text": "多少钱？10美元？7美元？植物？呃，所以我可以"}, {"type": "subtitle", "time": 6439.99, "timestamp": "01:47:19", "text": "同时直播到八个或十六个平台，或者"}, {"type": "subtitle", "time": 6442.629, "timestamp": "01:47:22", "text": "这样我就可以在 Facebook 上直播了。"}, {"type": "subtitle", "time": 6445.229, "timestamp": "01:47:25", "text": "踢，就像韩国人一样"}, {"type": "subtitle", "time": 6449.149, "timestamp": "01:47:29", "text": "我忘了他的名字，就像纳瓦一样。"}, {"type": "subtitle", "time": 6451.91, "timestamp": "01:47:31", "text": "然后，嗯，还有另一个"}, {"type": "subtitle", "time": 6454.43, "timestamp": "01:47:34", "text": "我想要的平台，我一直保留着一个"}, {"type": "subtitle", "time": 6457.35, "timestamp": "01:47:37", "text": "我的眼睛"}, {"type": "subtitle", "time": 6461.109, "timestamp": "01:47:41", "text": "我忘了我在这儿，对，你好，我在TCH上"}, {"type": "subtitle", "time": 6462.79, "timestamp": "01:47:42", "text": "好的，嗨，我们开始吧"}, {"type": "subtitle", "time": 6465.43, "timestamp": "01:47:45", "text": "去"}, {"type": "subtitle", "time": 6469.91, "timestamp": "01:47:49", "text": "所以，是的，我终于能够做到了"}, {"type": "subtitle", "time": 6470.83, "timestamp": "01:47:50", "text": "这"}, {"type": "subtitle", "time": 6473.83, "timestamp": "01:47:53", "text": "挑战，嗯，是的，我能够"}, {"type": "subtitle", "time": 6477.99, "timestamp": "01:47:57", "text": "把皮肤和那些东西都弄到手，然后……"}]
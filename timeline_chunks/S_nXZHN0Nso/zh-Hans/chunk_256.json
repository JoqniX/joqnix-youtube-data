[{"type": "subtitle", "time": 15362.189, "timestamp": "04:16:02", "text": "昨天，呃，等等，我直播了吗？"}, {"type": "subtitle", "time": 15365.55, "timestamp": "04:16:05", "text": "星期六 星期六 哦，什么时候 我的"}, {"type": "subtitle", "time": 15366.95, "timestamp": "04:16:06", "text": "最后一次直播哦我的天"}, {"type": "subtitle", "time": 15370.309, "timestamp": "04:16:10", "text": "天哪，我最后一次是什么时候？是的，我的最后一次，最后一次"}, {"type": "subtitle", "time": 15372.95, "timestamp": "04:16:12", "text": "直播是两天前，哦对，两天前"}, {"type": "subtitle", "time": 15376.389, "timestamp": "04:16:16", "text": "几天前是星期五，所以我没去。"}, {"type": "subtitle", "time": 15378.99, "timestamp": "04:16:18", "text": "直播"}, {"type": "subtitle", "time": 15387.71, "timestamp": "04:16:27", "text": "好几天我都忘了发推特，结果发生了什么？"}, {"type": "subtitle", "time": 15390.309, "timestamp": "04:16:30", "text": "曾是"}, {"type": "subtitle", "time": 15396.109, "timestamp": "04:16:36", "text": "呃呃，其中一个是我的呃小"}, {"type": "subtitle", "time": 15400.71, "timestamp": "04:16:40", "text": "尼安当时两个月大或三个月大"}, {"type": "subtitle", "time": 15403.269, "timestamp": "04:16:43", "text": "老的"}, {"type": "subtitle", "time": 15406.03, "timestamp": "04:16:46", "text": "嗯，是的，我命名了"}, {"type": "subtitle", "time": 15412.51, "timestamp": "04:16:52", "text": "我给她取名叫里约·里约·伊·南"}, {"type": "subtitle", "time": 15413.469, "timestamp": "04:16:53", "text": "她"}, {"type": "subtitle", "time": 15419.51, "timestamp": "04:16:59", "text": "里约，所以里约，她去世了，呃……"}]
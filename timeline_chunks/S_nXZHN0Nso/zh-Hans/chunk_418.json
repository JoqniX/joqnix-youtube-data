[{"type": "subtitle", "time": 25080.59, "timestamp": "06:58:00", "text": "我希望他补充说，这将是"}, {"type": "subtitle", "time": 25082.75, "timestamp": "06:58:02", "text": "很难不用箭头键。"}, {"type": "subtitle", "time": 25085.23, "timestamp": "06:58:05", "text": "我指的是所有关于刷箭矢的事情。"}, {"type": "subtitle", "time": 25087.91, "timestamp": "06:58:07", "text": "说实话挺容易的，嗯，你塔"}, {"type": "subtitle", "time": 25090.948, "timestamp": "06:58:10", "text": "L 出生点附近就有一个刷怪笼"}, {"type": "subtitle", "time": 25094.15, "timestamp": "06:58:14", "text": "那里有两个刷怪笼，对吧？"}, {"type": "subtitle", "time": 25096.23, "timestamp": "06:58:16", "text": "我所做的，是创造了一种类似……"}, {"type": "subtitle", "time": 25098.99, "timestamp": "06:58:18", "text": "农场太多，所以我喜欢躲在角落里。"}, {"type": "subtitle", "time": 25101.15, "timestamp": "06:58:21", "text": "然后等待怪物生成，我就可以……"}, {"type": "subtitle", "time": 25102.83, "timestamp": "06:58:22", "text": "杀了它们，它就会掉落。"}, {"type": "subtitle", "time": 25103.83, "timestamp": "06:58:23", "text": "降低"}, {"type": "subtitle", "time": 25108.388, "timestamp": "06:58:28", "text": "箭头，但是呃，我的问题是呃"}, {"type": "subtitle", "time": 25112.628, "timestamp": "06:58:32", "text": "如何将生成器握在手中"}, {"type": "subtitle", "time": 25115.868, "timestamp": "06:58:35", "text": "不行吗？不行吗？是的，不行，如果你"}, {"type": "subtitle", "time": 25118.51, "timestamp": "06:58:38", "text": "用任何东西都能做，它就是……"}, {"type": "subtitle", "time": 25121.19, "timestamp": "06:58:41", "text": "丝滑触感，甚至丝滑触感，即使"}, {"type": "subtitle", "time": 25123.31, "timestamp": "06:58:43", "text": "丝滑触感，它就这么断了"}, {"type": "subtitle", "time": 25125.83, "timestamp": "06:58:45", "text": "[音乐]"}, {"type": "subtitle", "time": 25128.23, "timestamp": "06:58:48", "text": "所以，是的，我想做一个"}, {"type": "subtitle", "time": 25132.35, "timestamp": "06:58:52", "text": "战场就在这附近。"}, {"type": "subtitle", "time": 25136.11, "timestamp": "06:58:56", "text": "好的，它在哪儿？对，就在这儿。"}, {"type": "subtitle", "time": 25139.07, "timestamp": "06:58:59", "text": "我想把这片区域夷为平地。"}]
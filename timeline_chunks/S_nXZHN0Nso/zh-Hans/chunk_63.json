[{"type": "subtitle", "time": 3785.789, "timestamp": "01:03:05", "text": "比你现在拥有的要多？呃，还没有，我还没有"}, {"type": "subtitle", "time": 3788.109, "timestamp": "01:03:08", "text": "等我做完之后就去拿。"}, {"type": "subtitle", "time": 3801.589, "timestamp": "01:03:21", "text": "这位塔克（Tak）暴露了一名红色军团士兵"}, {"type": "subtitle", "time": 3803.19, "timestamp": "01:03:23", "text": "这就能解释他们为何如此有组织了。"}, {"type": "subtitle", "time": 3805.349, "timestamp": "01:03:25", "text": "我一直没有oric，我没想到他们"}, {"type": "subtitle", "time": 3806.789, "timestamp": "01:03:26", "text": "仍然可能"}, {"type": "subtitle", "time": 3825.549, "timestamp": "01:03:45", "text": "啊，所有这些都是 18、19、20、21。"}, {"type": "subtitle", "time": 3828.309, "timestamp": "01:03:48", "text": "再跑三趟哦"}, {"type": "subtitle", "time": 3839.15, "timestamp": "01:03:59", "text": "[音乐]"}]
[{"type": "subtitle", "time": 10144.469, "timestamp": "02:49:04", "text": "好吧，我得先度过那段艰难时期。"}, {"type": "subtitle", "time": 10147.23, "timestamp": "02:49:07", "text": "Havoc真的很好，是的，他们改了"}, {"type": "subtitle", "time": 10149.99, "timestamp": "02:49:09", "text": "现在他们更加虔诚了，他们把事情做得更紧密了。"}, {"type": "subtitle", "time": 10152.269, "timestamp": "02:49:12", "text": "现在当你拿着它的时候，它就变成了"}, {"type": "subtitle", "time": 10155.349, "timestamp": "02:49:15", "text": "十字线会从这样的扩散状态变为"}, {"type": "subtitle", "time": 10157.269, "timestamp": "02:49:17", "text": "真的"}, {"type": "subtitle", "time": 10159.59, "timestamp": "02:49:19", "text": "那真是一记漂亮的射击"}]
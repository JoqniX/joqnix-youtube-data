[{"type": "subtitle", "time": 9060.11, "timestamp": "02:31:00", "text": "[音乐]"}, {"type": "subtitle", "time": 9069.309, "timestamp": "02:31:09", "text": "宝贝，这是什么？等等，他们放了吗？"}, {"type": "subtitle", "time": 9071.71, "timestamp": "02:31:11", "text": "箱子就在这个里面"}, {"type": "subtitle", "time": 9075.429, "timestamp": "02:31:15", "text": "这是什么关卡设计宝箱？"}, {"type": "subtitle", "time": 9078.429, "timestamp": "02:31:18", "text": "设计就像是把其中两个部件混在一起了。"}, {"type": "subtitle", "time": 9095.309, "timestamp": "02:31:35", "text": "我可以带走"}, {"type": "subtitle", "time": 9114.15, "timestamp": "02:31:54", "text": "圆圈在我心中"}, {"type": "subtitle", "time": 9116.429, "timestamp": "02:31:56", "text": "所以我是"}, {"type": "subtitle", "time": 9119.59, "timestamp": "02:31:59", "text": "我害怕会有人进来。"}]
[{"type": "subtitle", "time": 360.39, "timestamp": "00:06:00", "text": "夜晚"}, {"type": "subtitle", "time": 369.83, "timestamp": "00:06:09", "text": "好的，我们玩的游戏都是免费的。"}, {"type": "subtitle", "time": 372.469, "timestamp": "00:06:12", "text": "史诗级游戏在哪里？"}, {"type": "subtitle", "time": 377.589, "timestamp": "00:06:17", "text": "是的，我告诉过你，我告诉过你。"}, {"type": "subtitle", "time": 379.95, "timestamp": "00:06:19", "text": "嗯，你们应该合作，是的，我应该联系你们。"}, {"type": "subtitle", "time": 382.749, "timestamp": "00:06:22", "text": "出去合作"}, {"type": "chat", "time": 389.385, "timestamp": "00:06:29", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "You can watch these fragments of a memories here- https://onxa.link/ihYoSP3i"}, {"type": "subtitle", "time": 394.15999999999997, "timestamp": "00:06:34", "text": "等等，二进制文件不是"}, {"type": "subtitle", "time": 395.79, "timestamp": "00:06:35", "text": "[音乐]"}, {"type": "subtitle", "time": 399.39, "timestamp": "00:06:39", "text": "加载应该没问题，下载成功了吗？"}, {"type": "subtitle", "time": 405.55, "timestamp": "00:06:45", "text": "二进制文件哦耶我呃古墓丽影是"}, {"type": "subtitle", "time": 408.79, "timestamp": "00:06:48", "text": "我仍然自由，我已经声称"}, {"type": "subtitle", "time": 412.55, "timestamp": "00:06:52", "text": "我想我已经把它占为己有了，我的天哪"}, {"type": "subtitle", "time": 417.869, "timestamp": "00:06:57", "text": "这白色，我的眼睛"}]
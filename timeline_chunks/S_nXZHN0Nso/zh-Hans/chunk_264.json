[{"type": "subtitle", "time": 15845.87, "timestamp": "04:24:05", "text": "嗯……呃……该怎么称呼它呢？"}, {"type": "subtitle", "time": 15851.349, "timestamp": "04:24:11", "text": "嗯嗯，所以我想做"}, {"type": "subtitle", "time": 15854.91, "timestamp": "04:24:14", "text": "你知道我的名字叫Jnick，对吧？"}, {"type": "subtitle", "time": 15857.83, "timestamp": "04:24:17", "text": "所以今天你们看到的标题是……"}, {"type": "subtitle", "time": 15861.63, "timestamp": "04:24:21", "text": "今天的直播就像你已经有 ohaj 一样"}, {"type": "subtitle", "time": 15866.229, "timestamp": "04:24:26", "text": "对吧，你们觉得AAOK是"}, {"type": "subtitle", "time": 15869.71, "timestamp": "04:24:29", "text": "好的，呃，我需要那个名字。"}, {"type": "subtitle", "time": 15872.79, "timestamp": "04:24:32", "text": "对，我不太擅长起名字，如果……"}, {"type": "subtitle", "time": 15875.87, "timestamp": "04:24:35", "text": "你用命名的方式带我进入我的世界，我是如此的……"}, {"type": "subtitle", "time": 15891.91, "timestamp": "04:24:51", "text": "嗯……它叫什么来着？我想找找看。"}, {"type": "subtitle", "time": 15893.67, "timestamp": "04:24:53", "text": "一个名字"}, {"type": "subtitle", "time": 15897.99, "timestamp": "04:24:57", "text": "这样对你们来说就更容易了。"}]
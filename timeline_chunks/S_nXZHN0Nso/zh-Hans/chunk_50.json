[{"type": "subtitle", "time": 3044.67, "timestamp": "00:50:44", "text": "哦，我直接杀了她就行了。"}, {"type": "subtitle", "time": 3047.349, "timestamp": "00:50:47", "text": "他们到底在干什么？这么久啊！"}, {"type": "subtitle", "time": 3048.95, "timestamp": "00:50:48", "text": "我的天啊，我好想"}, {"type": "subtitle", "time": 3051.67, "timestamp": "00:50:51", "text": "查查到底是什么东西在折磨他们"}, {"type": "subtitle", "time": 3058.71, "timestamp": "00:50:58", "text": "回来了，我的天啊，上帝，你是认真的吗？"}]
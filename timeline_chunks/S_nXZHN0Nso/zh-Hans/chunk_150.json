[{"type": "subtitle", "time": 9000.67, "timestamp": "02:30:00", "text": "他们正在涂油漆，所以我"}, {"type": "subtitle", "time": 9003.03, "timestamp": "02:30:03", "text": "我只是看着他们做"}, {"type": "subtitle", "time": 9029.83, "timestamp": "02:30:29", "text": "不，哦等等，我要被困住了"}, {"type": "subtitle", "time": 9054.11, "timestamp": "02:30:54", "text": "哦，我不需要治疗，有自动治疗就行了。"}]
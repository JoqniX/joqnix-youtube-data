[{"type": "subtitle", "time": 19140.51, "timestamp": "05:19:00", "text": "呃，大家最近怎么样？我希望我一切都好。"}, {"type": "subtitle", "time": 19143.19, "timestamp": "05:19:03", "text": "我希望我还活着。"}, {"type": "subtitle", "time": 19148.03, "timestamp": "05:19:08", "text": "唉，我感觉很糟糕，我睡着了，我只是"}, {"type": "subtitle", "time": 19149.23, "timestamp": "05:19:09", "text": "完成的"}, {"type": "subtitle", "time": 19154.03, "timestamp": "05:19:14", "text": "我正在吃午饭，所以我在这儿。"}, {"type": "subtitle", "time": 19156.67, "timestamp": "05:19:16", "text": "有些事情我想做，我知道我们正在"}, {"type": "subtitle", "time": 19159.43, "timestamp": "05:19:19", "text": "我应该做其他事，但我做不到。"}, {"type": "subtitle", "time": 19161.51, "timestamp": "05:19:21", "text": "把它从我体内弄出来"}, {"type": "subtitle", "time": 19164.23, "timestamp": "05:19:24", "text": "我真的无法把它从我的脑海里抹去。"}, {"type": "subtitle", "time": 19171.11, "timestamp": "05:19:31", "text": "所以我想做点什么"}, {"type": "subtitle", "time": 19174.11, "timestamp": "05:19:34", "text": "嗯，我想做点什么。"}]
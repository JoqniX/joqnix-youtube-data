[{"type": "subtitle", "time": 9368.83, "timestamp": "02:36:08", "text": "我害怕那边那个人。"}, {"type": "subtitle", "time": 9371.91, "timestamp": "02:36:11", "text": "我有点害怕那边那个人。"}, {"type": "subtitle", "time": 9373.67, "timestamp": "02:36:13", "text": "你喜欢独奏吗？我是说，呃……"}, {"type": "subtitle", "time": 9375.07, "timestamp": "02:36:15", "text": "护盾差异有时很重要，所以"}, {"type": "subtitle", "time": 9388.55, "timestamp": "02:36:28", "text": "单人消息很有趣，它是专门为此而设计的"}, {"type": "subtitle", "time": 9391.87, "timestamp": "02:36:31", "text": "像我这样只想玩游戏的人"}, {"type": "subtitle", "time": 9410.429, "timestamp": "02:36:50", "text": "巴卡，他有我想要的那种枪手的活力"}, {"type": "subtitle", "time": 9412.79, "timestamp": "02:36:52", "text": "更换护盾，但护盾是"}, {"type": "subtitle", "time": 9415.11, "timestamp": "02:36:55", "text": "不是"}, {"type": "subtitle", "time": 9419.389, "timestamp": "02:36:59", "text": "啊，莫，没关系，你玩得越多越好。"}]
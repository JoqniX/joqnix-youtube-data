[{"type": "subtitle", "time": 11402.229, "timestamp": "03:10:02", "text": "我回来了，对不起，我回来了，呃，我刚才去哪儿了？"}, {"type": "subtitle", "time": 11411.87, "timestamp": "03:10:11", "text": "嗯，显然那里很友善。"}, {"type": "subtitle", "time": 11418.59, "timestamp": "03:10:18", "text": "事情发生在我家，在我住的地方，所以我……"}, {"type": "subtitle", "time": 11436.19, "timestamp": "03:10:36", "text": "[音乐]"}, {"type": "subtitle", "time": 11440.09, "timestamp": "03:10:40", "text": "我会一直坚持下去"}]
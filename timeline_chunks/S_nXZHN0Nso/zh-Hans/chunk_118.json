[{"type": "subtitle", "time": 7084.189, "timestamp": "01:58:04", "text": "出去"}, {"type": "subtitle", "time": 7087.55, "timestamp": "01:58:07", "text": "哦我的天啊，这把新枪，所以这就是……"}, {"type": "subtitle", "time": 7090.069, "timestamp": "01:58:10", "text": "我给那些不知道最后情况的人准备的枪"}, {"type": "subtitle", "time": 7092.55, "timestamp": "01:58:12", "text": "这个赛季我们遇到了挑战，一切都很艰难。"}, {"type": "subtitle", "time": 7096.75, "timestamp": "01:58:16", "text": "这就是我们得到的枪，嗯，它花了我……"}, {"type": "subtitle", "time": 7099.47, "timestamp": "01:58:19", "text": "永远，但我实际上都做到了。"}, {"type": "subtitle", "time": 7102.99, "timestamp": "01:58:22", "text": "挑战以及一切，以及为什么"}, {"type": "subtitle", "time": 7106.03, "timestamp": "01:58:26", "text": "我们终于搞定了"}, {"type": "subtitle", "time": 7107.75, "timestamp": "01:58:27", "text": "耶"}, {"type": "subtitle", "time": 7111.43, "timestamp": "01:58:31", "text": "是的，那么阿拉，她的能力是什么呢？我们来谈谈吧。"}, {"type": "subtitle", "time": 7119.35, "timestamp": "01:58:39", "text": "搞清楚，嗯，我该怎么按F2、F1，而不是F3？"}, {"type": "subtitle", "time": 7122.709, "timestamp": "01:58:42", "text": "哦哦，我做了什么？"}, {"type": "subtitle", "time": 7127.55, "timestamp": "01:58:47", "text": "等等，我做了什么？"}, {"type": "subtitle", "time": 7130.069, "timestamp": "01:58:50", "text": "啊，我忘了"}, {"type": "subtitle", "time": 7135.109, "timestamp": "01:58:55", "text": "哦哦哦哦等等等等 F5 F6 F7 F8"}, {"type": "subtitle", "time": 7138.709, "timestamp": "01:58:58", "text": "F9 啊，我忘了，我撞见了"}]
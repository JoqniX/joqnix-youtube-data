[{"type": "subtitle", "time": 2582.549, "timestamp": "00:43:02", "text": "其他东西都在那里，唯独没有"}, {"type": "subtitle", "time": 2591.63, "timestamp": "00:43:11", "text": "哦，它不在这里，我的天哪，我得去做。"}, {"type": "subtitle", "time": 2594.03, "timestamp": "00:43:14", "text": "我会等短篇《鳕鱼》上映。"}, {"type": "subtitle", "time": 2595.15, "timestamp": "00:43:15", "text": "结束"}, {"type": "subtitle", "time": 2600.349, "timestamp": "00:43:20", "text": "正在下载，哦等等，什么？我下载了什么？"}, {"type": "subtitle", "time": 2603.15, "timestamp": "00:43:23", "text": "等等，我排队了。"}, {"type": "subtitle", "time": 2605.71, "timestamp": "00:43:25", "text": "现有 H"}, {"type": "subtitle", "time": 2612.27, "timestamp": "00:43:32", "text": "酷，就是这样。"}, {"type": "subtitle", "time": 2615.15, "timestamp": "00:43:35", "text": "这是最快的攻击。"}, {"type": "subtitle", "time": 2617.109, "timestamp": "00:43:37", "text": "有"}, {"type": "subtitle", "time": 2620.63, "timestamp": "00:43:40", "text": "搞定了，只用了五到十秒钟。"}, {"type": "subtitle", "time": 2624.91, "timestamp": "00:43:44", "text": "六七秒，我到底在干什么？"}, {"type": "subtitle", "time": 2628.109, "timestamp": "00:43:48", "text": "能排队真是幸运"}, {"type": "subtitle", "time": 2631.589, "timestamp": "00:43:51", "text": "当前会话，是的，我们现在开始吧"}, {"type": "subtitle", "time": 2635.109, "timestamp": "00:43:55", "text": "还需要再做五次"}, {"type": "subtitle", "time": 2638.19, "timestamp": "00:43:58", "text": "如果我在我的战队里有个队友，他是谁？"}]
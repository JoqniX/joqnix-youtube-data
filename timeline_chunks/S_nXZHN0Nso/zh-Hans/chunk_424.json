[{"type": "subtitle", "time": 25442.51, "timestamp": "07:04:02", "text": "快点，我等了，你有吗？"}, {"type": "subtitle", "time": 25445.91, "timestamp": "07:04:05", "text": "金车和苹果容易做吗？"}, {"type": "subtitle", "time": 25449.23, "timestamp": "07:04:09", "text": "是的，这并不难，你只需要黄金。"}, {"type": "subtitle", "time": 25452.27, "timestamp": "07:04:12", "text": "对，M，是的，为了金苹果。"}, {"type": "subtitle", "time": 25455.51, "timestamp": "07:04:15", "text": "需要很多应用程序和金条，但是对于"}, {"type": "subtitle", "time": 25457.91, "timestamp": "07:04:17", "text": "你需要金黄色的胡萝卜块和"}, {"type": "subtitle", "time": 25462.31, "timestamp": "07:04:22", "text": "胡萝卜对吧，哦，鸡块，我可以吗？"}, {"type": "subtitle", "time": 25466.59, "timestamp": "07:04:26", "text": "我可以把一根金条和两个一起转吗？"}, {"type": "subtitle", "time": 25469.23, "timestamp": "07:04:29", "text": "鸡块，是的，你可以，所以九"}, {"type": "subtitle", "time": 25472.67, "timestamp": "07:04:32", "text": "块数等于单根棒"}, {"type": "subtitle", "time": 25476.11, "timestamp": "07:04:36", "text": "H 就像一个方块，等于 9 个金币"}, {"type": "subtitle", "time": 25479.67, "timestamp": "07:04:39", "text": "对，酒吧对，所以，是的，你可以"}, {"type": "subtitle", "time": 25483.788, "timestamp": "07:04:43", "text": "将一根金锭嫁接到一根金条上"}, {"type": "subtitle", "time": 25493.868, "timestamp": "07:04:53", "text": "好的，我需要一张床。"}]
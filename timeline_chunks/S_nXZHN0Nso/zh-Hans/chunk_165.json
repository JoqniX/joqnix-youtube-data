[{"type": "subtitle", "time": 9906.91, "timestamp": "02:45:06", "text": "嗨，艾尔，爱德华怎么样了？希望你一切都好。"}, {"type": "subtitle", "time": 9910.23, "timestamp": "02:45:10", "text": "做得好真的会出很多汗，而且如何"}, {"type": "subtitle", "time": 9912.71, "timestamp": "02:45:12", "text": "我能拿到那20颗炸弹的徽章吗？"}, {"type": "subtitle", "time": 9919.03, "timestamp": "02:45:19", "text": "我只想赢，单挑获胜。"}, {"type": "subtitle", "time": 9922.67, "timestamp": "02:45:22", "text": "匹配呃 B 东西会很难，但是"}, {"type": "subtitle", "time": 9928.55, "timestamp": "02:45:28", "text": "尽力而为，我能做的最好的就是得到一个"}, {"type": "subtitle", "time": 9931.99, "timestamp": "02:45:31", "text": "单人游戏体验，难度较高"}, {"type": "subtitle", "time": 9935.71, "timestamp": "02:45:35", "text": "当然，你可以玩，所以呃"}, {"type": "subtitle", "time": 9938.67, "timestamp": "02:45:38", "text": "慢点说，这方法还挺管用。"}, {"type": "subtitle", "time": 9946.63, "timestamp": "02:45:46", "text": "我打算用无边框窗口模式玩游戏"}, {"type": "subtitle", "time": 9954.51, "timestamp": "02:45:54", "text": "又卡住了"}]
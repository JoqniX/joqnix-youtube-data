[{"type": "subtitle", "time": 5072.229, "timestamp": "01:24:32", "text": "等等，我的扫帚！他毁了我的扫帚！"}, {"type": "subtitle", "time": 5090.55, "timestamp": "01:24:50", "text": "见鬼，你打算怎么办？哦，这是我的"}, {"type": "subtitle", "time": 5093.31, "timestamp": "01:24:53", "text": "最后一次穿越暗影湖，所以我"}, {"type": "subtitle", "time": 5097.07, "timestamp": "01:24:57", "text": "无需再重复了。"}, {"type": "subtitle", "time": 5099.79, "timestamp": "01:24:59", "text": "努力，我就能得到这东西"}]
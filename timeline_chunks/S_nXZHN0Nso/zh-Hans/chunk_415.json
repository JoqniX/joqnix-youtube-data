[{"type": "subtitle", "time": 24910.83, "timestamp": "06:55:10", "text": "你是怎么做到的？"}, {"type": "subtitle", "time": 24914.708, "timestamp": "06:55:14", "text": "f 你是怎么好的？你怎么会这样？"}, {"type": "subtitle", "time": 24917.11, "timestamp": "06:55:17", "text": "快速地"}, {"type": "subtitle", "time": 24920.99, "timestamp": "06:55:20", "text": "昨天我也在基地附近。"}, {"type": "subtitle", "time": 24924.948, "timestamp": "06:55:24", "text": "所以我在这里登出了，啊，不错，我的意思是，我"}, {"type": "subtitle", "time": 24927.628, "timestamp": "06:55:27", "text": "好像已经登出了，差不多就那样了，是的。"}, {"type": "subtitle", "time": 24929.788, "timestamp": "06:55:29", "text": "啊，不错不错，还有，你知道，这是个玩笑，你知道的。"}, {"type": "subtitle", "time": 24932.868, "timestamp": "06:55:32", "text": "我的两尊图腾都没了，我当时"}, {"type": "subtitle", "time": 24935.19, "timestamp": "06:55:35", "text": "和阿斯拉一起进行 PvP 对战，他买了我的"}, {"type": "subtitle", "time": 24939.07, "timestamp": "06:55:39", "text": "图腾兄弟，如何获得图腾，如何制作图腾？"}, {"type": "subtitle", "time": 24941.948, "timestamp": "06:55:41", "text": "图腾 你可以制作图腾 嗯，你必须"}, {"type": "subtitle", "time": 24944.388, "timestamp": "06:55:44", "text": "农场里有一群叫做……的怪物"}, {"type": "subtitle", "time": 24947.868, "timestamp": "06:55:47", "text": "唤魔者，你杀了它们，然后它就掉了。"}, {"type": "subtitle", "time": 24950.51, "timestamp": "06:55:50", "text": "图腾掉落飞行物，然后那里"}, {"type": "subtitle", "time": 24953.11, "timestamp": "06:55:53", "text": "自定义生物对吧？呃，你等等，真的吗？"}, {"type": "subtitle", "time": 24956.43, "timestamp": "06:55:56", "text": "你看到了吗？就是那群给我们带来幻觉的人。"}, {"type": "subtitle", "time": 24959.788, "timestamp": "06:55:59", "text": "等等，呃，正在为脚踝而耕作"}]
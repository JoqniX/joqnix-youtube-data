[{"type": "subtitle", "time": 15003.71, "timestamp": "04:10:03", "text": "先这样吧，看看效果如何。"}, {"type": "subtitle", "time": 15006.63, "timestamp": "04:10:06", "text": "是啊，所以，我们只会那样做"}, {"type": "subtitle", "time": 15008.79, "timestamp": "04:10:08", "text": "现在"}, {"type": "subtitle", "time": 15012.03, "timestamp": "04:10:12", "text": "好的，谢谢大家的光临。"}, {"type": "subtitle", "time": 15014.469, "timestamp": "04:10:14", "text": "非常抱歉，我们这里停电了。"}, {"type": "subtitle", "time": 15017.189, "timestamp": "04:10:17", "text": "我的直播不可用"}, {"type": "subtitle", "time": 15019.99, "timestamp": "04:10:19", "text": "待处理状态或类似加载状态"}, {"type": "subtitle", "time": 15023.99, "timestamp": "04:10:23", "text": "比如说，3个小时？我很抱歉。"}, {"type": "subtitle", "time": 15026.91, "timestamp": "04:10:26", "text": "那件事（指电力方面）出乎意料。"}, {"type": "subtitle", "time": 15029.79, "timestamp": "04:10:29", "text": "但没关系，事情就是这样。"}, {"type": "subtitle", "time": 15032.189, "timestamp": "04:10:32", "text": "嗯，明天我会和你们保持联系。"}, {"type": "subtitle", "time": 15034.71, "timestamp": "04:10:34", "text": "发布明天要发生的事情，但是"}, {"type": "subtitle", "time": 15036.95, "timestamp": "04:10:36", "text": "是的，谢谢大家今天光临。"}, {"type": "subtitle", "time": 15040.149, "timestamp": "04:10:40", "text": "那条狗叫什么名字？祝你一切顺利！"}, {"type": "subtitle", "time": 15042.67, "timestamp": "04:10:42", "text": "夜幕降临，傍晚或清晨"}, {"type": "subtitle", "time": 15044.83, "timestamp": "04:10:44", "text": "如果你那边是早上，那就好。"}, {"type": "subtitle", "time": 15055.79, "timestamp": "04:10:55", "text": "拜拜，祝你一切顺利"}]
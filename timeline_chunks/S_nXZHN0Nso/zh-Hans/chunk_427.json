[{"type": "subtitle", "time": 25621.83, "timestamp": "07:07:01", "text": "沃克不是弗罗斯特·沃克，就像……"}, {"type": "subtitle", "time": 25624.91, "timestamp": "07:07:04", "text": "冰冻，一切都在进行中"}, {"type": "subtitle", "time": 25627.43, "timestamp": "07:07:07", "text": "剑在同一个，是的，剑就像"}, {"type": "subtitle", "time": 25629.51, "timestamp": "07:07:09", "text": "伴着冰冷的火焰"}, {"type": "subtitle", "time": 25632.628, "timestamp": "07:07:12", "text": "太酷了，太酷了，然后，然后"}, {"type": "subtitle", "time": 25637.388, "timestamp": "07:07:17", "text": "锐度或许会非常强，所以"}, {"type": "subtitle", "time": 25641.11, "timestamp": "07:07:21", "text": "楼主就像你知道的魔法一样，哦，是"}, {"type": "subtitle", "time": 25644.31, "timestamp": "07:07:24", "text": "小心，呃，爬行者很容易……"}, {"type": "subtitle", "time": 25650.27, "timestamp": "07:07:30", "text": "是，也是结束，Ender 是痛苦，我的意思是结束"}, {"type": "subtitle", "time": 25652.468, "timestamp": "07:07:32", "text": "其实没那么难"}, {"type": "subtitle", "time": 25655.43, "timestamp": "07:07:35", "text": "好吧，你想打架？好啊，来吧！"}, {"type": "subtitle", "time": 25659.03, "timestamp": "07:07:39", "text": "你设置了重生点，是的，我设置了，没问题。"}, {"type": "subtitle", "time": 25661.83, "timestamp": "07:07:41", "text": "对我们来说，我现在觉得是的，就是这样。"}, {"type": "subtitle", "time": 25666.99, "timestamp": "07:07:46", "text": "带着担忧，嗯，嗨，嗯，好的，三"}, {"type": "subtitle", "time": 25675.83, "timestamp": "07:07:55", "text": "你拿到状态了吗？"}]
[{"type": "subtitle", "time": 16981.51, "timestamp": "04:43:01", "text": "不，是的，已经很久了。"}, {"type": "subtitle", "time": 16982.83, "timestamp": "04:43:02", "text": "[音乐]"}, {"type": "subtitle", "time": 16986.628, "timestamp": "04:43:06", "text": "虽然周日早上那场比赛很糟糕，但"}, {"type": "subtitle", "time": 16990.03, "timestamp": "04:43:10", "text": "星期天早上，今天不是，但是是的"}, {"type": "subtitle", "time": 16992.55, "timestamp": "04:43:12", "text": "总有一天"}, {"type": "subtitle", "time": 16995.788, "timestamp": "04:43:15", "text": "那一周可能是我最……"}, {"type": "subtitle", "time": 16999.868, "timestamp": "04:43:19", "text": "可能在晚上等待夜间也许在"}, {"type": "subtitle", "time": 17011.948, "timestamp": "04:43:31", "text": "[音乐]"}, {"type": "subtitle", "time": 17015.51, "timestamp": "04:43:35", "text": "是的，我只是在推特上往下刷而已。"}, {"type": "subtitle", "time": 17019.788, "timestamp": "04:43:39", "text": "清晨，我看到一个鸣人"}, {"type": "subtitle", "time": 17024.59, "timestamp": "04:43:44", "text": "咖啡呃啊纳尔咖啡纳尔特符号"}, {"type": "subtitle", "time": 17028.38, "timestamp": "04:43:48", "text": "咖啡真是太棒了！"}]
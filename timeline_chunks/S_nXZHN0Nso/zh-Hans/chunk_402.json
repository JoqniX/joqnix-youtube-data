[{"type": "subtitle", "time": 24121.67, "timestamp": "06:42:01", "text": "如果有boss房间的话……"}, {"type": "subtitle", "time": 24123.75, "timestamp": "06:42:03", "text": "首领战房间有熔岩"}, {"type": "subtitle", "time": 24126.67, "timestamp": "06:42:06", "text": "切换到类似吸吮的模式，然后开始"}, {"type": "subtitle", "time": 24129.868, "timestamp": "06:42:09", "text": "熔岩，这样我的队友就可以……"}, {"type": "subtitle", "time": 24132.548, "timestamp": "06:42:12", "text": "盾牌首领护盾的破除"}, {"type": "subtitle", "time": 24135.468, "timestamp": "06:42:15", "text": "一切都在我的计划之内。"}, {"type": "subtitle", "time": 24139.59, "timestamp": "06:42:19", "text": "我得等，我得承担责任。"}, {"type": "subtitle", "time": 24145.388, "timestamp": "06:42:25", "text": "先锋的角色加上做呃"}, {"type": "subtitle", "time": 24148.91, "timestamp": "06:42:28", "text": "为了得到B老板，什么都愿意做。"}, {"type": "subtitle", "time": 24152.548, "timestamp": "06:42:32", "text": "大家注意我，因为我速度更快。"}, {"type": "subtitle", "time": 24160.15, "timestamp": "06:42:40", "text": "向右滑动"}, {"type": "subtitle", "time": 24162.83, "timestamp": "06:42:42", "text": "对，这样我的队友就能拿到人头了。"}, {"type": "subtitle", "time": 24164.628, "timestamp": "06:42:44", "text": "我们能赢，这就是我的策略。"}, {"type": "subtitle", "time": 24166.708, "timestamp": "06:42:46", "text": "为"}, {"type": "subtitle", "time": 24171.11, "timestamp": "06:42:51", "text": "现在我只希望一切顺利，伙计，我不知道。"}, {"type": "subtitle", "time": 24175.628, "timestamp": "06:42:55", "text": "但我对此表示怀疑，希望如此。"}, {"type": "subtitle", "time": 24179.35, "timestamp": "06:42:59", "text": "总之，我们需要……我们需要清理一下。"}]
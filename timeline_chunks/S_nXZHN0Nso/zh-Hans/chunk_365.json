[{"type": "chat", "time": 21900.997, "timestamp": "06:05:00", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "yeah chicken blood"}, {"type": "subtitle", "time": 21902.35, "timestamp": "06:05:02", "text": "他们知道那是鸡血还是人血。"}, {"type": "subtitle", "time": 21913.27, "timestamp": "06:05:13", "text": "除非你明白，否则别以为血就是血。"}, {"type": "subtitle", "time": 21916.67, "timestamp": "06:05:16", "text": "除非你把它交给BL（黑衣人）。"}, {"type": "subtitle", "time": 21921.31, "timestamp": "06:05:21", "text": "分析师之类的，我不知道"}, {"type": "subtitle", "time": 21923.75, "timestamp": "06:05:23", "text": "等等，你知道怎么才能做到不同的事情吗？"}, {"type": "chat", "time": 21924.169, "timestamp": "06:05:24", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "while matilda killed one of her farm chickens, and drew his blood, she didnt clear out his corpse from the backyard"}, {"type": "subtitle", "time": 21925.708, "timestamp": "06:05:25", "text": "屎血"}, {"type": "subtitle", "time": 21928.35, "timestamp": "06:05:28", "text": "实际上，每个人都有"}, {"type": "subtitle", "time": 21930.23, "timestamp": "06:05:30", "text": "不同的独特之处"}, {"type": "chat", "time": 21932.764, "timestamp": "06:05:32", "author": "@Boy2Man-1734", "avatar": "https://yt4.ggpht.com/1daIzbC99c0P6u6kGBDibfJrLV-MuZvRI2usaiXscUkJjzE7sYwSsrSOluQzEh-SjvViXQSXyw=s64-c-k-c0x00ffffff-no-rj", "message": "Matilda is playing with my feelings"}, {"type": "subtitle", "time": 21932.948, "timestamp": "06:05:32", "text": "我以为鸡血闻起来很臭。"}, {"type": "chat", "time": 21936.311, "timestamp": "06:05:36", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "and wolfs....have a keen sense of smelll"}, {"type": "subtitle", "time": 21938.59, "timestamp": "06:05:38", "text": "安德鲁，但她没有清理他的"}, {"type": "subtitle", "time": 21942.868, "timestamp": "06:05:42", "text": "来自后院的警察，玛蒂尔达"}, {"type": "subtitle", "time": 21945.51, "timestamp": "06:05:45", "text": "是的，他是在玩弄我的感情，还有B"}, {"type": "subtitle", "time": 21949.03, "timestamp": "06:05:49", "text": "嗅觉要灵敏，好吗？等等"}, {"type": "chat", "time": 21950.761, "timestamp": "06:05:50", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "and even if he didnt find a chicken....he did find a human child...."}, {"type": "subtitle", "time": 21951.75, "timestamp": "06:05:51", "text": "如果"}, {"type": "subtitle", "time": 21958.23, "timestamp": "06:05:58", "text": "鸡，而且没有埋掉，没有"}]
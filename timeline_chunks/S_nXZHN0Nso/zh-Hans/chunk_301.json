[{"type": "subtitle", "time": 18060.39, "timestamp": "05:01:00", "text": "感觉我就是这种感觉"}, {"type": "subtitle", "time": 18062.31, "timestamp": "05:01:02", "text": "现在但是"}, {"type": "subtitle", "time": 18082.788, "timestamp": "05:01:22", "text": "Jo，你直播了吗？是的，我直播了。"}, {"type": "subtitle", "time": 18086.23, "timestamp": "05:01:26", "text": "那时我"}, {"type": "subtitle", "time": 18089.23, "timestamp": "05:01:29", "text": "居住"}, {"type": "subtitle", "time": 18093.07, "timestamp": "05:01:33", "text": "是的，所以我们没有定下日期。"}, {"type": "subtitle", "time": 18102.23, "timestamp": "05:01:42", "text": "所以这就像是"}, {"type": "subtitle", "time": 18108.67, "timestamp": "05:01:48", "text": "正在做"}, {"type": "subtitle", "time": 18112.788, "timestamp": "05:01:52", "text": "所以，呃，一开始是这样的，本来应该是这样的。"}, {"type": "subtitle", "time": 18115.23, "timestamp": "05:01:55", "text": "成为一条溪流"}, {"type": "subtitle", "time": 18119.83, "timestamp": "05:01:59", "text": "我呃，谈谈每日天气预报"}]
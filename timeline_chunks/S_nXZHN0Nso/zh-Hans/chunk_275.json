[{"type": "subtitle", "time": 16501.39, "timestamp": "04:35:01", "text": "是的，因为我的一些"}, {"type": "subtitle", "time": 16507.23, "timestamp": "04:35:07", "text": "注意力缺陷多动症那一套，对，我全都经历过。"}, {"type": "subtitle", "time": 16511.949, "timestamp": "04:35:11", "text": "是的，所以，还有，就像我刚才说的。"}, {"type": "subtitle", "time": 16516.109, "timestamp": "04:35:16", "text": "我最近得了P，对吧？医生"}, {"type": "subtitle", "time": 16523.551, "timestamp": "04:35:23", "text": "高兴了一会儿，我还以为你搬家了呢。"}, {"type": "subtitle", "time": 16526.39, "timestamp": "04:35:26", "text": "给我们播放这个"}, {"type": "subtitle", "time": 16528.551, "timestamp": "04:35:28", "text": "早期的"}, {"type": "subtitle", "time": 16533.869, "timestamp": "04:35:33", "text": "F，不过也许有一天我会和你"}, {"type": "subtitle", "time": 16538.189, "timestamp": "04:35:38", "text": "我知道总有一天我会搬出去，但我不知道。"}, {"type": "subtitle", "time": 16541.23, "timestamp": "04:35:41", "text": "我知道我想搬出去，我也想"}, {"type": "subtitle", "time": 16544.551, "timestamp": "04:35:44", "text": "搬家，独自生活，但这很难，但是"}, {"type": "subtitle", "time": 16548.551, "timestamp": "04:35:48", "text": "是啊，你永远都说不出“对”这几个字。"}]
[{"type": "subtitle", "time": 21628.548, "timestamp": "06:00:28", "text": "哦，别担心，他安全回来了。"}, {"type": "subtitle", "time": 21632.07, "timestamp": "06:00:32", "text": "回到家，但孩子不在。"}, {"type": "subtitle", "time": 21634.67, "timestamp": "06:00:34", "text": "想象一下，有人绑架了圣徒"}, {"type": "subtitle", "time": 21638.548, "timestamp": "06:00:38", "text": "孩子，什么？什么？什么？上帝啊，这太黑暗了。"}, {"type": "chat", "time": 21638.913, "timestamp": "06:00:38", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "husband told april, \"you know, half the credit for this practical joke goes to matilda, she killed one of her wee chickens to get that fake blood\""}, {"type": "subtitle", "time": 21642.51, "timestamp": "06:00:42", "text": "对不起对不起，我的大脑一片空白。"}, {"type": "subtitle", "time": 21648.27, "timestamp": "06:00:48", "text": "她杀了自己人，这真是太好了。"}, {"type": "subtitle", "time": 21654.708, "timestamp": "06:00:54", "text": "血啊"}, {"type": "subtitle", "time": 21656.788, "timestamp": "06:00:56", "text": "不哦"}, {"type": "subtitle", "time": 21658.51, "timestamp": "06:00:58", "text": "不"}]
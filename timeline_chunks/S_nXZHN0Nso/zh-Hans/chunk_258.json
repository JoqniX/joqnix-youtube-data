[{"type": "subtitle", "time": 15486.03, "timestamp": "04:18:06", "text": "你和第二部分发生了什么"}, {"type": "subtitle", "time": 15489.269, "timestamp": "04:18:09", "text": "真是太"}, {"type": "subtitle", "time": 15493.429, "timestamp": "04:18:13", "text": "哦，是的，星期六早上我坐着。"}, {"type": "subtitle", "time": 15498.67, "timestamp": "04:18:18", "text": "我去看了一位狗医生"}, {"type": "subtitle", "time": 15502.75, "timestamp": "04:18:22", "text": "预约去了狗那里"}, {"type": "subtitle", "time": 15506.429, "timestamp": "04:18:26", "text": "那该怎么称呼它呢？是的，我们去了。"}, {"type": "subtitle", "time": 15511.07, "timestamp": "04:18:31", "text": "一个电话，一次谈话和行动，被称为我新闻"}, {"type": "subtitle", "time": 15514.07, "timestamp": "04:18:34", "text": "我跟他们讲了我睡觉的事。"}, {"type": "subtitle", "time": 15517.67, "timestamp": "04:18:37", "text": "最近发生了很多事，我的情况也一直很好。"}, {"type": "subtitle", "time": 15520.349, "timestamp": "04:18:40", "text": "最近如此"}, {"type": "subtitle", "time": 15524.309, "timestamp": "04:18:44", "text": "是的，没错。"}, {"type": "subtitle", "time": 15528.87, "timestamp": "04:18:48", "text": "车之类的东西，但发生的事情是……"}, {"type": "subtitle", "time": 15531.67, "timestamp": "04:18:51", "text": "星期天我不小心"}, {"type": "subtitle", "time": 15536.91, "timestamp": "04:18:56", "text": "周六晚上我实际上吃了"}]
[{"type": "subtitle", "time": 8163.709, "timestamp": "02:16:03", "text": "虽然我是第三对，但我还是要来了"}, {"type": "subtitle", "time": 8178.83, "timestamp": "02:16:18", "text": "派对哦，敌人，敌人就在上面，好吧好吧"}, {"type": "subtitle", "time": 8211.15, "timestamp": "02:16:51", "text": "不，兄弟，他把我耍得团团转。"}, {"type": "subtitle", "time": 8215.389, "timestamp": "02:16:55", "text": "他把我骗得团团转，为什么我的呃……"}, {"type": "subtitle", "time": 8217.509, "timestamp": "02:16:57", "text": "翻译进行中"}]
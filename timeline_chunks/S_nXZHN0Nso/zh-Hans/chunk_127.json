[{"type": "subtitle", "time": 7621.629, "timestamp": "02:07:01", "text": "他们是不是在搞什么Genion之类的玩意儿？"}, {"type": "subtitle", "time": 7624.39, "timestamp": "02:07:04", "text": "为什么？他们为什么要这样做？"}, {"type": "subtitle", "time": 7629.35, "timestamp": "02:07:09", "text": "再加上新的呃呃异国风情"}, {"type": "subtitle", "time": 7632.629, "timestamp": "02:07:12", "text": "异国情调的呃，射击会导致过热，而且"}, {"type": "subtitle", "time": 7636.229, "timestamp": "02:07:16", "text": "神秘的哦哦等等，这太酷了"}, {"type": "subtitle", "time": 7640.51, "timestamp": "02:07:20", "text": "等等，不好意思，我想要这款皮肤，看看……"}, {"type": "subtitle", "time": 7644.229, "timestamp": "02:07:24", "text": "这就是它，它好可爱，它是彩虹色的"}, {"type": "subtitle", "time": 7647.31, "timestamp": "02:07:27", "text": "紫色也是我的菜，没错。"}, {"type": "subtitle", "time": 7651.629, "timestamp": "02:07:31", "text": "你好，罗科，你好吗？"}, {"type": "subtitle", "time": 7655.51, "timestamp": "02:07:35", "text": "迪翁，你花钱了"}, {"type": "subtitle", "time": 7677.189, "timestamp": "02:07:57", "text": "我的电脑卡得要死，直播都卡死了"}, {"type": "subtitle", "time": 7678.99, "timestamp": "02:07:58", "text": "在五个平台上"}]
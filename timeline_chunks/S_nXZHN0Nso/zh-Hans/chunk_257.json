[{"type": "subtitle", "time": 15423.87, "timestamp": "04:17:03", "text": "星期六就像呃在"}, {"type": "subtitle", "time": 15425.389, "timestamp": "04:17:05", "text": "晚上"}, {"type": "subtitle", "time": 15426.99, "timestamp": "04:17:06", "text": "嗯"}, {"type": "subtitle", "time": 15430.83, "timestamp": "04:17:10", "text": "所以，发生了什么事是她"}, {"type": "subtitle", "time": 15434.07, "timestamp": "04:17:14", "text": "那个……那个工具包叫什么来着？"}, {"type": "subtitle", "time": 15436.51, "timestamp": "04:17:16", "text": "有个地方叫厨房，我没有。"}, {"type": "subtitle", "time": 15438.79, "timestamp": "04:17:18", "text": "我知道这件事，但我不知道该怎么办。"}, {"type": "subtitle", "time": 15441.469, "timestamp": "04:17:21", "text": "这是我第一次做这件事"}, {"type": "subtitle", "time": 15443.149, "timestamp": "04:17:23", "text": "体验"}, {"type": "subtitle", "time": 15444.87, "timestamp": "04:17:24", "text": "这"}, {"type": "subtitle", "time": 15448.91, "timestamp": "04:17:28", "text": "嗯，我会尽力到场。"}, {"type": "subtitle", "time": 15460.95, "timestamp": "04:17:40", "text": "很遗憾，但现在不是悲伤的时候，唐诺"}, {"type": "subtitle", "time": 15462.91, "timestamp": "04:17:42", "text": "但我不想难过，因为她"}, {"type": "subtitle", "time": 15465.59, "timestamp": "04:17:45", "text": "总是给我带来快乐和笑容"}, {"type": "subtitle", "time": 15467.429, "timestamp": "04:17:47", "text": "当着我的面"}, {"type": "subtitle", "time": 15470.79, "timestamp": "04:17:50", "text": "所以我知道她在天上微笑着。"}, {"type": "subtitle", "time": 15474.99, "timestamp": "04:17:54", "text": "微笑又回到那里看着"}, {"type": "subtitle", "time": 15479.07, "timestamp": "04:17:59", "text": "是的，我也会尽我所能。"}]
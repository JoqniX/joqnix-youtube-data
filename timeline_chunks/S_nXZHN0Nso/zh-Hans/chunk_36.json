[{"type": "subtitle", "time": 2164.87, "timestamp": "00:36:04", "text": "难道只有我一个人在场吗？等等"}, {"type": "subtitle", "time": 2166.79, "timestamp": "00:36:06", "text": "我是唯一"}, {"type": "subtitle", "time": 2169.349, "timestamp": "00:36:09", "text": "哦等等，我是唯一一个吗？哦等等"}, {"type": "subtitle", "time": 2171.39, "timestamp": "00:36:11", "text": "他们的队友"}, {"type": "subtitle", "time": 2208.27, "timestamp": "00:36:48", "text": "差点就救了我，哦，他没救我。"}, {"type": "subtitle", "time": 2212.47, "timestamp": "00:36:52", "text": "是啊，等等，他确实救了我，谢谢。"}]
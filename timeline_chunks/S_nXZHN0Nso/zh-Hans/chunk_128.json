[{"type": "subtitle", "time": 7690.43, "timestamp": "02:08:10", "text": "它正在内部死去，或者"}, {"type": "subtitle", "time": 7700.43, "timestamp": "02:08:20", "text": "嗯，我打算这么做，然后独自一人，走吧。"}, {"type": "subtitle", "time": 7702.03, "timestamp": "02:08:22", "text": "允许更改"}, {"type": "subtitle", "time": 7714.27, "timestamp": "02:08:34", "text": "好的，我们走吧，我们进去吧。"}, {"type": "subtitle", "time": 7718.87, "timestamp": "02:08:38", "text": "新地点，附近有敌人，50分钟50米"}, {"type": "subtitle", "time": 7723.03, "timestamp": "02:08:43", "text": "好了，我现在要单干了，所以我得走了"}, {"type": "subtitle", "time": 7725.549, "timestamp": "02:08:45", "text": "离开"}, {"type": "subtitle", "time": 7728.51, "timestamp": "02:08:48", "text": "好的，我会尽力的。我不认为我"}]
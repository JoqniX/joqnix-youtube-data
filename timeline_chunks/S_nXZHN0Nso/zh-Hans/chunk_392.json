[{"type": "subtitle", "time": 23525.628, "timestamp": "06:32:05", "text": "我要死了，但我必须变得更强，对吧？"}, {"type": "subtitle", "time": 23529.75, "timestamp": "06:32:09", "text": "[音乐]"}, {"type": "subtitle", "time": 23538.07, "timestamp": "06:32:18", "text": "CH 你知道boss战将会是"}, {"type": "subtitle", "time": 23540.708, "timestamp": "06:32:20", "text": "如果我滑上去就很容易了，但是"}, {"type": "subtitle", "time": 23541.99, "timestamp": "06:32:21", "text": "事物"}, {"type": "subtitle", "time": 23545.99, "timestamp": "06:32:25", "text": "呃，是不是有什么问题？因为如果老板……"}, {"type": "subtitle", "time": 23549.75, "timestamp": "06:32:29", "text": "如果Aial也像粉丝圈一样，那我就完蛋了。"}, {"type": "subtitle", "time": 23553.19, "timestamp": "06:32:33", "text": "我不能，我不能和一个boss战斗，他"}, {"type": "subtitle", "time": 23556.19, "timestamp": "06:32:36", "text": "当时空气中弥漫着我目前的弱点。"}, {"type": "subtitle", "time": 23558.27, "timestamp": "06:32:38", "text": "是这样吗？为此我必须使用……"}, {"type": "subtitle", "time": 23564.51, "timestamp": "06:32:44", "text": "我的签名"}, {"type": "subtitle", "time": 23568.548, "timestamp": "06:32:48", "text": "武器是我的标志性战斗风格弓和"}, {"type": "subtitle", "time": 23571.23, "timestamp": "06:32:51", "text": "我希望为那次训练制作一支箭"}, {"type": "subtitle", "time": 23579.99, "timestamp": "06:32:59", "text": "这样我就可以像在竞技场一样进行射击练习了"}]
[{"type": "subtitle", "time": 18300.99, "timestamp": "05:05:00", "text": "我认为这个重置程序是面部"}, {"type": "subtitle", "time": 18305.35, "timestamp": "05:05:05", "text": "现在，我感觉就像我的"}, {"type": "subtitle", "time": 18309.99, "timestamp": "05:05:09", "text": "双手就像没有感觉一样，蒂什"}, {"type": "subtitle", "time": 18313.59, "timestamp": "05:05:13", "text": "感觉神清气爽，但同时"}, {"type": "subtitle", "time": 18317.31, "timestamp": "05:05:17", "text": "不像完全"}, {"type": "subtitle", "time": 18321.75, "timestamp": "05:05:21", "text": "感觉焕然一新，因为偶尔"}, {"type": "subtitle", "time": 18324.07, "timestamp": "05:05:24", "text": "我其实"}, {"type": "subtitle", "time": 18334.83, "timestamp": "05:05:34", "text": "休息一下，哦，那也是件好事。"}, {"type": "subtitle", "time": 18336.788, "timestamp": "05:05:36", "text": "其实我挺擅长穿衣服的。"}, {"type": "subtitle", "time": 18352.91, "timestamp": "05:05:52", "text": "设置和什么"}, {"type": "subtitle", "time": 18356.07, "timestamp": "05:05:56", "text": "否则，我应该不会缺东西。"}, {"type": "subtitle", "time": 18359.31, "timestamp": "05:05:59", "text": "谈谈"}]
[{"type": "subtitle", "time": 9421.67, "timestamp": "02:37:01", "text": "起こった。私たちは見ることができませんでした"}, {"type": "subtitle", "time": 9424.55, "timestamp": "02:37:04", "text": "ありがとうと言うような、さよならを言うような良い"}, {"type": "subtitle", "time": 9428.429, "timestamp": "02:37:08", "text": "オーディブルからさよなら"}, {"type": "subtitle", "time": 9430.19, "timestamp": "02:37:10", "text": "セレスティア。"}, {"type": "subtitle", "time": 9434.63, "timestamp": "02:37:14", "text": "だって今はもう午前2時だから"}, {"type": "subtitle", "time": 9437.03, "timestamp": "02:37:17", "text": "そして電力が復旧したのはとても遅く、"}, {"type": "subtitle", "time": 9439.27, "timestamp": "02:37:19", "text": "寝てしまった。私は待って待っていました"}, {"type": "subtitle", "time": 9441.03, "timestamp": "02:37:21", "text": "そして私は眠りに落ち、目が覚めたら"}, {"type": "subtitle", "time": 9444.59, "timestamp": "02:37:24", "text": "そして電力は復旧した。ということで、"}, {"type": "subtitle", "time": 9450.99, "timestamp": "02:37:30", "text": "[音楽]"}, {"type": "subtitle", "time": 9454.95, "timestamp": "02:37:34", "text": "ということで、コラボレーションは本当に"}, {"type": "subtitle", "time": 9457.59, "timestamp": "02:37:37", "text": "楽しい。楽しんでいただけたなら幸いです。楽しんでいただけましたら"}, {"type": "subtitle", "time": 9459.51, "timestamp": "02:37:39", "text": "コラボ動画を視聴している方は"}, {"type": "subtitle", "time": 9461.91, "timestamp": "02:37:41", "text": "ストリームを楽しんでいただけたなら、"}, {"type": "subtitle", "time": 9464.63, "timestamp": "02:37:44", "text": "YouTubeでCelestiaをフォローしてください。彼女は配信している"}, {"type": "subtitle", "time": 9468.23, "timestamp": "02:37:48", "text": "YouTubeで。彼女のツイッター、彼女のインスタグラム"}, {"type": "subtitle", "time": 9471.15, "timestamp": "02:37:51", "text": "そしてYouTubeアカウントは"}, {"type": "subtitle", "time": 9475.07, "timestamp": "02:37:55", "text": "詳細は下記をご覧ください。フォローできます"}, {"type": "subtitle", "time": 9477.15, "timestamp": "02:37:57", "text": "彼女。"}, {"type": "subtitle", "time": 9478.91, "timestamp": "02:37:58", "text": "こんにちは。"}]
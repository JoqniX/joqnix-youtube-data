[{"type": "subtitle", "time": 12367.59, "timestamp": "03:26:07", "text": "えっと、もしかしたら、"}, {"type": "subtitle", "time": 12373.15, "timestamp": "03:26:13", "text": "うん。しかし"}, {"type": "subtitle", "time": 12377.229, "timestamp": "03:26:17", "text": "また、人々は"}, {"type": "subtitle", "time": 12379.71, "timestamp": "03:26:19", "text": "毒性がある"}, {"type": "subtitle", "time": 12385.429, "timestamp": "03:26:25", "text": "私はインド出身なので。"}, {"type": "subtitle", "time": 12390.39, "timestamp": "03:26:30", "text": "多くの人から言われた"}, {"type": "subtitle", "time": 12396.63, "timestamp": "03:26:36", "text": "ええと、しかし現在の状況では私は"}, {"type": "subtitle", "time": 12398.71, "timestamp": "03:26:38", "text": "会社が小規模なクリエイターを受け入れてくれることを望んでいます"}, {"type": "subtitle", "time": 12400.469, "timestamp": "03:26:40", "text": "海外出身で言語能力のある人"}, {"type": "subtitle", "time": 12402.95, "timestamp": "03:26:42", "text": "バリア。この閾値は明らかに"}, {"type": "subtitle", "time": 12405.469, "timestamp": "03:26:45", "text": "育てられてきた"}, {"type": "subtitle", "time": 12410.269, "timestamp": "03:26:50", "text": "多くの。うん。結局、彼女もまた"}, {"type": "subtitle", "time": 12412.63, "timestamp": "03:26:52", "text": "「悲しいけど、"}]
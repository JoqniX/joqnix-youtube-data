[{"type": "subtitle", "time": 4441.11, "timestamp": "01:14:01", "text": "ああ、そうだね、そうだね、その通りだ。はい。はい。"}, {"type": "subtitle", "time": 4447.75, "timestamp": "01:14:07", "text": "ええ、それもやらなきゃいけないことですね。"}, {"type": "subtitle", "time": 4451.43, "timestamp": "01:14:11", "text": "無理やり「うん」と言わないようにする。いいえ、違います"}, {"type": "subtitle", "time": 4454.07, "timestamp": "01:14:14", "text": "何かを一時停止する、その後に何か"}, {"type": "subtitle", "time": 4457.35, "timestamp": "01:14:17", "text": "インタビューとか、その他諸々。うん。そして私は"}, {"type": "subtitle", "time": 4460.47, "timestamp": "01:14:20", "text": "後でそうしてしまうかもしれないという恐怖"}, {"type": "subtitle", "time": 4462.669, "timestamp": "01:14:22", "text": "新モデルデビューと"}, {"type": "subtitle", "time": 4464.99, "timestamp": "01:14:24", "text": "もの。えっと"}, {"type": "subtitle", "time": 4470.47, "timestamp": "01:14:30", "text": "それは非常にまずいことになると思う。"}, {"type": "subtitle", "time": 4472.07, "timestamp": "01:14:32", "text": "楽しみにしています。私はとても"}, {"type": "subtitle", "time": 4474.39, "timestamp": "01:14:34", "text": "先輩、楽しみにしています。うまくいくといいな"}, {"type": "subtitle", "time": 4477.189, "timestamp": "01:14:37", "text": "良い。"}, {"type": "subtitle", "time": 4479.83, "timestamp": "01:14:39", "text": "それをあなたに見せましたか？忘れた。私"}, {"type": "subtitle", "time": 4483.43, "timestamp": "01:14:43", "text": "もう忘れてしまった。あなたはそう思っていなかった、"}, {"type": "subtitle", "time": 4487.03, "timestamp": "01:14:47", "text": "でも大丈夫。私は、"}, {"type": "subtitle", "time": 4489.75, "timestamp": "01:14:49", "text": "ここへ来るすべてのゲストは、"}, {"type": "subtitle", "time": 4491.75, "timestamp": "01:14:51", "text": "「ああ、私の"}, {"type": "subtitle", "time": 4494.07, "timestamp": "01:14:54", "text": "まだお母さんですか？"}, {"type": "subtitle", "time": 4496.39, "timestamp": "01:14:56", "text": "いや、それはすごく可愛いよ。それはまるで、"}, {"type": "subtitle", "time": 4498.149, "timestamp": "01:14:58", "text": "知ってるよ、君がすごく誇りに思ってるってわかるよ"}]
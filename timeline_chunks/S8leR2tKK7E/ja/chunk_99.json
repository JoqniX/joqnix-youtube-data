[{"type": "subtitle", "time": 5942.31, "timestamp": "01:39:02", "text": "4年間も同様です。私たちは"}, {"type": "subtitle", "time": 5944.31, "timestamp": "01:39:04", "text": "異なる波の同様の観客が"}, {"type": "subtitle", "time": 5946.709, "timestamp": "01:39:06", "text": "好きは、私たちが好きになる方法にしばしば影響を与えてきました"}, {"type": "subtitle", "time": 5948.79, "timestamp": "01:39:08", "text": "自分自身を描写したり、"}, {"type": "subtitle", "time": 5951.669, "timestamp": "01:39:11", "text": "コミュニティ全般。そして私は思う"}, {"type": "subtitle", "time": 5953.55, "timestamp": "01:39:13", "text": "より簡単にしたり、"}, {"type": "subtitle", "time": 5955.91, "timestamp": "01:39:15", "text": "難しい。あなたと同じように言います"}, {"type": "subtitle", "time": 5957.669, "timestamp": "01:39:17", "text": "最初は星のように知っていた"}, {"type": "subtitle", "time": 5960.07, "timestamp": "01:39:20", "text": "スケートメンバーたちはとても疲れていた"}, {"type": "subtitle", "time": 5962.47, "timestamp": "01:39:22", "text": "人と交流するのが好きで、"}, {"type": "subtitle", "time": 5965.03, "timestamp": "01:39:25", "text": "外部のptubersは会社が好きだから"}, {"type": "subtitle", "time": 5967.35, "timestamp": "01:39:27", "text": "人々がどのように認識しているか、私たちは知りませんでした。"}, {"type": "subtitle", "time": 5970.31, "timestamp": "01:39:30", "text": "私たちも最初はそれが好きでした"}, {"type": "subtitle", "time": 5972.709, "timestamp": "01:39:32", "text": "私に似ていて、そこにいるように感じた"}, {"type": "subtitle", "time": 5973.55, "timestamp": "01:39:33", "text": "だった"}, {"type": "subtitle", "time": 5975.75, "timestamp": "01:39:35", "text": "特定の人々がそうではなかったように"}, {"type": "subtitle", "time": 5978.149, "timestamp": "01:39:38", "text": "とても歓迎されているので、"}, {"type": "subtitle", "time": 5981.189, "timestamp": "01:39:41", "text": "それは私たちの間に一種の不安を生み出し、"}, {"type": "subtitle", "time": 5983.43, "timestamp": "01:39:43", "text": "私たちは、もし私たちが世話をできないなら"}, {"type": "subtitle", "time": 5985.109, "timestamp": "01:39:45", "text": "お互い誰も"}, {"type": "subtitle", "time": 5988.229, "timestamp": "01:39:48", "text": "そこで私たちは、"}, {"type": "subtitle", "time": 5990.149, "timestamp": "01:39:50", "text": "私たち自身にとって助けが必要な場所"}, {"type": "subtitle", "time": 5992.229, "timestamp": "01:39:52", "text": "お互いに親切に"}, {"type": "subtitle", "time": 5993.91, "timestamp": "01:39:53", "text": "共依存。"}, {"type": "subtitle", "time": 5998.189, "timestamp": "01:39:58", "text": "それはまた私が言うように"}]
[{"type": "subtitle", "time": 8161.589, "timestamp": "02:16:01", "text": "シーン。美術関連のものは完全には"}, {"type": "subtitle", "time": 8163.99, "timestamp": "02:16:03", "text": "十分に離れている。だから、"}, {"type": "subtitle", "time": 8167.03, "timestamp": "02:16:07", "text": "変更する方法やその他すべて。"}, {"type": "subtitle", "time": 8169.83, "timestamp": "02:16:09", "text": "だから、あまりリスクを冒すべきではないと思ったんです"}, {"type": "subtitle", "time": 8171.669, "timestamp": "02:16:11", "text": "種の。"}, {"type": "subtitle", "time": 8174.629, "timestamp": "02:16:14", "text": "いくつかやってみるべきだと思う"}, {"type": "subtitle", "time": 8176.95, "timestamp": "02:16:16", "text": "Chocolatonのプレビュー終了時の数秒"}, {"type": "subtitle", "time": 8179.27, "timestamp": "02:16:19", "text": "最終回。"}, {"type": "subtitle", "time": 8181.109, "timestamp": "02:16:21", "text": "数秒でフルカラーまたは"}, {"type": "subtitle", "time": 8184.069, "timestamp": "02:16:24", "text": "シルエットのように"}, {"type": "subtitle", "time": 8187.51, "timestamp": "02:16:27", "text": "あなたが望むものは何でも。あれは、あ、待って。私"}, {"type": "subtitle", "time": 8189.99, "timestamp": "02:16:29", "text": "それにはお金を払わなければならないかもしれないと思う"}, {"type": "subtitle", "time": 8194.07, "timestamp": "02:16:34", "text": "それを行うために。ええ、やってみます。"}, {"type": "subtitle", "time": 8196.309, "timestamp": "02:16:36", "text": "まだ時間があります、"}, {"type": "subtitle", "time": 8202.509, "timestamp": "02:16:42", "text": "そうではない。"}, {"type": "subtitle", "time": 8205.91, "timestamp": "02:16:45", "text": "うん。しかし、ここには不安もありますし"}, {"type": "subtitle", "time": 8209.83, "timestamp": "02:16:49", "text": "そこには。ねえ、もし私のママパパが"}, {"type": "subtitle", "time": 8211.669, "timestamp": "02:16:51", "text": "私を見捨てて、「いや、私は"}, {"type": "subtitle", "time": 8214.23, "timestamp": "02:16:54", "text": "「もうこんなことしたくない」とか、そんな感じ。"}, {"type": "subtitle", "time": 8216.91, "timestamp": "02:16:56", "text": "いいえ、私は母を亡くすことになります。私は"}]
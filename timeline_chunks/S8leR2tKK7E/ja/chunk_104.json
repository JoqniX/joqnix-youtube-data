[{"type": "subtitle", "time": 6241.87, "timestamp": "01:44:01", "text": "非常に長い間生きる。"}, {"type": "subtitle", "time": 6245.99, "timestamp": "01:44:05", "text": "そしてもちろん、人々はとても"}, {"type": "subtitle", "time": 6248.709, "timestamp": "01:44:08", "text": "彼らには独自の"}, {"type": "subtitle", "time": 6251.149, "timestamp": "01:44:11", "text": "個々の人生。だから私たちは知らない"}, {"type": "subtitle", "time": 6254.07, "timestamp": "01:44:14", "text": "状況も関係する。"}, {"type": "subtitle", "time": 6256.87, "timestamp": "01:44:16", "text": "だから、まだ多くのことが必要だと私は思います"}, {"type": "subtitle", "time": 6259.35, "timestamp": "01:44:19", "text": "勇気を出して人に近づいて質問する"}, {"type": "subtitle", "time": 6261.59, "timestamp": "01:44:21", "text": "一般的にコラボレーションのために"}, {"type": "subtitle", "time": 6265.149, "timestamp": "01:44:25", "text": "私はとても内気な人間だからです。私はとても"}, {"type": "subtitle", "time": 6268.55, "timestamp": "01:44:28", "text": "怖いけど、信じられない"}, {"type": "subtitle", "time": 6270.55, "timestamp": "01:44:30", "text": "あなたはそれをやっている。私は多くの"}, {"type": "subtitle", "time": 6272.55, "timestamp": "01:44:32", "text": "人々は本当に楽しみにしている"}, {"type": "subtitle", "time": 6275.75, "timestamp": "01:44:35", "text": "あなたのゲストの一人が「あれは何？」と尋ねた"}, {"type": "subtitle", "time": 6283.229, "timestamp": "01:44:43", "text": "それで"}, {"type": "subtitle", "time": 6285.39, "timestamp": "01:44:45", "text": "それはまるで"}, {"type": "subtitle", "time": 6288.95, "timestamp": "01:44:48", "text": "私はただ好きになりたかっただけです"}, {"type": "subtitle", "time": 6291.51, "timestamp": "01:44:51", "text": "えーと、私にとってはコラボレーションとは見なしていないし、"}, {"type": "subtitle", "time": 6293.91, "timestamp": "01:44:53", "text": "数値的なものとか、"}, {"type": "subtitle", "time": 6295.99, "timestamp": "01:44:55", "text": "取引的なもの、あるいは何であれ。私はただ"}, {"type": "subtitle", "time": 6299.27, "timestamp": "01:44:59", "text": "人とゲームをして、"}]
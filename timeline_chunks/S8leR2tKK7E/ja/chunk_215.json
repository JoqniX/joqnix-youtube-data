[{"type": "subtitle", "time": 12919.349, "timestamp": "03:35:19", "text": "今の私にとって、もし私が"}, {"type": "subtitle", "time": 12924.469, "timestamp": "03:35:24", "text": "正直に言うと、お金があれば"}, {"type": "subtitle", "time": 12926.87, "timestamp": "03:35:26", "text": "私にとっては問題ではなかったのですが、"}, {"type": "subtitle", "time": 12930.79, "timestamp": "03:35:30", "text": "文字通り人を雇って何かをさせた"}, {"type": "subtitle", "time": 12933.19, "timestamp": "03:35:33", "text": "そして、当時の時代背景を考えると、すべてが完璧だった。たとえ私が"}, {"type": "subtitle", "time": 12935.03, "timestamp": "03:35:35", "text": "今はお金がないので、"}, {"type": "subtitle", "time": 12937.75, "timestamp": "03:35:37", "text": "彼らの時間に対して文字通り報酬を支払う"}, {"type": "subtitle", "time": 12952.51, "timestamp": "03:35:52", "text": "右？そしてそれら全て"}, {"type": "subtitle", "time": 12958.29, "timestamp": "03:35:58", "text": "理解する。"}]
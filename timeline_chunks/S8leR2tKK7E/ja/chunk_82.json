[{"type": "subtitle", "time": 4920.76, "timestamp": "01:22:00", "text": "はい。 はい。そして、無料ゲームが悲しいことに"}, {"type": "subtitle", "time": 4924.96, "timestamp": "01:22:04", "text": "はい。そして、無料ゲームが悲しいことに ボットにはこのプライムゲーミングがありません"}, {"type": "subtitle", "time": 4936.229, "timestamp": "01:22:16", "text": "通知。うん。さもなければ人々は"}, {"type": "subtitle", "time": 4938.47, "timestamp": "01:22:18", "text": "誰もが簡単にそれを主張でき、"}, {"type": "subtitle", "time": 4940.91, "timestamp": "01:22:20", "text": "もの。"}, {"type": "subtitle", "time": 4944.99, "timestamp": "01:22:24", "text": "うん。天才。正直言って、天才的な戦略だ。"}, {"type": "subtitle", "time": 4948.11, "timestamp": "01:22:28", "text": "本当に良い戦略だ"}, {"type": "subtitle", "time": 4950.31, "timestamp": "01:22:30", "text": "実は。あなたの一番好きなゲームは何ですか？"}, {"type": "subtitle", "time": 4953.03, "timestamp": "01:22:33", "text": "セレスティア？"}, {"type": "subtitle", "time": 4955.51, "timestamp": "01:22:35", "text": "それは良い質問ですね。私はプレイします"}, {"type": "subtitle", "time": 4957.51, "timestamp": "01:22:37", "text": "友達とゴルフをするが、それは"}, {"type": "subtitle", "time": 4960.07, "timestamp": "01:22:40", "text": "私はあなたが遊ぶのが好きです"}, {"type": "subtitle", "time": 4962.709, "timestamp": "01:22:42", "text": "多くの人々、そしてすべての人と同じように"}, {"type": "subtitle", "time": 4964.79, "timestamp": "01:22:44", "text": "そのゲームに対する反応が異なり、"}, {"type": "subtitle", "time": 4967.03, "timestamp": "01:22:47", "text": "すごく面白い。"}, {"type": "subtitle", "time": 4971.83, "timestamp": "01:22:51", "text": "うん。私もゲームが大好きです。"}, {"type": "subtitle", "time": 4974.229, "timestamp": "01:22:54", "text": "M. もちろん、マインクラフトは大好きです。また、"}, {"type": "subtitle", "time": 4977.83, "timestamp": "01:22:57", "text": "バイオハザードシリーズ全般ですが、"}]
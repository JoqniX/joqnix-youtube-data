[{"type": "subtitle", "time": 5042.149, "timestamp": "01:24:02", "text": "聞いたことがある。以前にも話していましたか？"}, {"type": "subtitle", "time": 5044.31, "timestamp": "01:24:04", "text": "私にとって？"}, {"type": "subtitle", "time": 5047.669, "timestamp": "01:24:07", "text": "いいえ、わかりません。しかし、たった270人だ。"}, {"type": "subtitle", "time": 5049.51, "timestamp": "01:24:09", "text": "オファーがあります。"}, {"type": "subtitle", "time": 5054.11, "timestamp": "01:24:14", "text": "それは先月、29日に発売されました"}, {"type": "subtitle", "time": 5056.91, "timestamp": "01:24:16", "text": "5月。逆転裁判みたいな感じ"}, {"type": "subtitle", "time": 5059.75, "timestamp": "01:24:19", "text": "あれ。友達を一人連れて行くことができます"}, {"type": "subtitle", "time": 5063.189, "timestamp": "01:24:23", "text": "そのうちの1人が裁判官として、または3人の裁判官が裁判官として行動する。"}, {"type": "subtitle", "time": 5067.59, "timestamp": "01:24:27", "text": "そして、検察官のような法律擁護派や"}, {"type": "subtitle", "time": 5069.75, "timestamp": "01:24:29", "text": "何か。うん。議論する人々"}, {"type": "subtitle", "time": 5072.87, "timestamp": "01:24:32", "text": "そして議論。うん。本当に楽しいよ。"}, {"type": "subtitle", "time": 5075.229, "timestamp": "01:24:35", "text": "それは素晴らしいですね。"}, {"type": "subtitle", "time": 5078.55, "timestamp": "01:24:38", "text": "うん。法廷は混乱状態。告発または"}, {"type": "subtitle", "time": 5084.39, "timestamp": "01:24:44", "text": "私はできる、ああ、なんてことだ。私はすでに好きになれる"}, {"type": "subtitle", "time": 5086.629, "timestamp": "01:24:46", "text": "人々がそれについて大騒ぎしているのがわかる。これ"}, {"type": "subtitle", "time": 5090.99, "timestamp": "01:24:50", "text": "それはまたしても素晴らしいアイデアだ。ええ、そうです"}]
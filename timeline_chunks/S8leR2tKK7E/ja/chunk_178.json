[{"type": "subtitle", "time": 10690.87, "timestamp": "02:58:10", "text": "チャンスがあると思っていた。私は思った"}, {"type": "subtitle", "time": 10692.99, "timestamp": "02:58:12", "text": "予定していた"}, {"type": "subtitle", "time": 10694.99, "timestamp": "02:58:14", "text": "手に入れる、君"}, {"type": "subtitle", "time": 10699.95, "timestamp": "02:58:19", "text": "知ってるよ、私は手に入れることができるかもしれない"}, {"type": "subtitle", "time": 10702.309, "timestamp": "02:58:22", "text": "プラットフォーム。私は戻ることができるかもしれない"}, {"type": "subtitle", "time": 10716.11, "timestamp": "02:58:36", "text": "どれの"}]
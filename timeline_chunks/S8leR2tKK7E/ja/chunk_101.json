[{"type": "subtitle", "time": 6061.59, "timestamp": "01:41:01", "text": "奇数。それは私にはできないことです"}, {"type": "subtitle", "time": 6065.99, "timestamp": "01:41:05", "text": "理解する。そうだといい。皆さん、そう願っています"}, {"type": "subtitle", "time": 6073.709, "timestamp": "01:41:13", "text": "それで私はゆっくりと"}, {"type": "subtitle", "time": 6077.35, "timestamp": "01:41:17", "text": "YouTubeの真面目な側面を見てください"}, {"type": "subtitle", "time": 6082.47, "timestamp": "01:41:22", "text": "最近では、それが私をより怖がらせる"}, {"type": "subtitle", "time": 6086.39, "timestamp": "01:41:26", "text": "えーと、人々の行動はどうですか"}, {"type": "subtitle", "time": 6089.109, "timestamp": "01:41:29", "text": "すべてですが、それはただ"}, {"type": "subtitle", "time": 6091.83, "timestamp": "01:41:31", "text": "挑戦は単なる障害物または道筋である"}, {"type": "subtitle", "time": 6094.55, "timestamp": "01:41:34", "text": "これから先、いずれは乗り越えられるだろう"}, {"type": "subtitle", "time": 6098.39, "timestamp": "01:41:38", "text": "それ。はい。それはむしろ試練のようなもので"}, {"type": "subtitle", "time": 6100.87, "timestamp": "01:41:40", "text": "エラー。時々、あなたが働くかもしれない"}, {"type": "subtitle", "time": 6102.55, "timestamp": "01:41:42", "text": "特定の人とは相性が良い時もある"}, {"type": "subtitle", "time": 6104.87, "timestamp": "01:41:44", "text": "そうではないかもしれません。そしてそれは学ぶことの中にある"}, {"type": "subtitle", "time": 6106.87, "timestamp": "01:41:46", "text": "機会があり、学ぶことができます"}, {"type": "subtitle", "time": 6108.95, "timestamp": "01:41:48", "text": "人との接し方と避けるべきこと"}, {"type": "subtitle", "time": 6116.629, "timestamp": "01:41:56", "text": "うん。私は昨日今日それを知りました"}]
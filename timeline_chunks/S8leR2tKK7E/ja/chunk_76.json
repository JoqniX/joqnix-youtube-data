[{"type": "subtitle", "time": 4561.75, "timestamp": "01:16:01", "text": "このようにすることで、あなたはしばしば"}, {"type": "subtitle", "time": 4564.87, "timestamp": "01:16:04", "text": "あなた自身の健康やニーズは"}, {"type": "subtitle", "time": 4567.51, "timestamp": "01:16:07", "text": "必ずしも良いとは限らない。だから、あなたが引っ越すとき"}, {"type": "subtitle", "time": 4569.83, "timestamp": "01:16:09", "text": "日本へ、愛を好きになることを願う"}, {"type": "subtitle", "time": 4571.99, "timestamp": "01:16:11", "text": "自分自身をもっと理解し、自分の限界を知る"}, {"type": "subtitle", "time": 4574.79, "timestamp": "01:16:14", "text": "同じように。先輩"}, {"type": "subtitle", "time": 4576.189, "timestamp": "01:16:16", "text": "私は願っています"}, {"type": "subtitle", "time": 4579.75, "timestamp": "01:16:19", "text": "それで。私に見えるのは日本の初週だけです"}, {"type": "subtitle", "time": 4582.63, "timestamp": "01:16:22", "text": "まるで私が電話をかけているような感じになるでしょう"}, {"type": "subtitle", "time": 4585.03, "timestamp": "01:16:25", "text": "私の父。私はもっ​​と行きたいと思う"}, {"type": "subtitle", "time": 4588.79, "timestamp": "01:16:28", "text": "パパ、戻ってきて。私にはできません。行きたい"}, {"type": "subtitle", "time": 4591.51, "timestamp": "01:16:31", "text": "戻る。これは難しすぎる。私はこう思うだろう"}, {"type": "subtitle", "time": 4594.149, "timestamp": "01:16:34", "text": "それ。"}, {"type": "subtitle", "time": 4596.95, "timestamp": "01:16:36", "text": "それは避けられないことだと思います。あなたはなれます"}, {"type": "subtitle", "time": 4598.55, "timestamp": "01:16:38", "text": "ホームシックになり、あなたも知っているように"}, {"type": "subtitle", "time": 4602.149, "timestamp": "01:16:42", "text": "特に祝祭シーズン中は。でも私は"}, {"type": "subtitle", "time": 4604.229, "timestamp": "01:16:44", "text": "見つけたらもっと良くなると思う"}, {"type": "subtitle", "time": 4606.39, "timestamp": "01:16:46", "text": "あなた自身のコミュニティの人々が"}, {"type": "subtitle", "time": 4609.35, "timestamp": "01:16:49", "text": "一緒にお祝いしましょう。"}, {"type": "subtitle", "time": 4613.11, "timestamp": "01:16:53", "text": "あぁ、七夕が"}, {"type": "subtitle", "time": 4615.27, "timestamp": "01:16:55", "text": "星の祭典が開催されます"}, {"type": "subtitle", "time": 4617.91, "timestamp": "01:16:57", "text": "来月、そしてその月は私が"}]
[{"type": "subtitle", "time": 5581.75, "timestamp": "01:33:01", "text": "えーと、それで、そのプレイを提案してくれたんだけど、えーと"}, {"type": "subtitle", "time": 5585.35, "timestamp": "01:33:05", "text": "彼が通っていた学校とか、"}, {"type": "subtitle", "time": 5588.11, "timestamp": "01:33:08", "text": "彼が学んだ語学学校と"}, {"type": "subtitle", "time": 5592.39, "timestamp": "01:33:12", "text": "その時私は出席していたので"}, {"type": "subtitle", "time": 5596.629, "timestamp": "01:33:16", "text": "以前ここで受講した日本語学習コース"}, {"type": "subtitle", "time": 5599.83, "timestamp": "01:33:19", "text": "それから私はインタビューについて話しました"}, {"type": "subtitle", "time": 5602.229, "timestamp": "01:33:22", "text": "語学学校と提携していて、"}, {"type": "subtitle", "time": 5604.75, "timestamp": "01:33:24", "text": "面接で不要なものは何ですか？"}, {"type": "subtitle", "time": 5607.99, "timestamp": "01:33:27", "text": "インタビュー 知らなかったのですが、私は"}, {"type": "subtitle", "time": 5610.51, "timestamp": "01:33:30", "text": "知らなかったけど、簡単にできるんだ"}, {"type": "subtitle", "time": 5613.75, "timestamp": "01:33:33", "text": "適用して"}, {"type": "subtitle", "time": 5615.59, "timestamp": "01:33:35", "text": "そういう仕組みじゃないの？まず応募する"}, {"type": "subtitle", "time": 5618.229, "timestamp": "01:33:38", "text": "そして面接に呼ばれる"}, {"type": "subtitle", "time": 5620.95, "timestamp": "01:33:40", "text": "うん、でも私にとっては違ったと思う"}, {"type": "subtitle", "time": 5625.189, "timestamp": "01:33:45", "text": "地元の学校のようなもの。彼らはちょうど"}, {"type": "subtitle", "time": 5628.629, "timestamp": "01:33:48", "text": "私のファイルを学校に送ってください。学校"}, {"type": "subtitle", "time": 5630.07, "timestamp": "01:33:50", "text": "チェックしてみると、彼らは「うん、"}, {"type": "subtitle", "time": 5632.79, "timestamp": "01:33:52", "text": "面接のミーティングを設定して、"}, {"type": "subtitle", "time": 5637.149, "timestamp": "01:33:57", "text": "この生徒は子供ですが、生徒は"}]
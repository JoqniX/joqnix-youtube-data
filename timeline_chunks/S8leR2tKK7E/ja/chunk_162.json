[{"type": "subtitle", "time": 9722.27, "timestamp": "02:42:02", "text": "ああ、代表者とは"}, {"type": "subtitle", "time": 9723.389, "timestamp": "02:42:03", "text": "[音楽]"}, {"type": "subtitle", "time": 9726.55, "timestamp": "02:42:06", "text": "平均？え、何？皆さんはどう思いますか？"}, {"type": "subtitle", "time": 9728.91, "timestamp": "02:42:08", "text": "代表者"}, {"type": "subtitle", "time": 9731.11, "timestamp": "02:42:11", "text": "平均？待って、待って、待って、待って、待って。させて"}, {"type": "subtitle", "time": 9734.23, "timestamp": "02:42:14", "text": "もう一度読んでみて。"}, {"type": "subtitle", "time": 9736.79, "timestamp": "02:42:16", "text": "なぜなら、私たちが一緒に仕事をする外国人は通常"}, {"type": "subtitle", "time": 9739.59, "timestamp": "02:42:19", "text": "中国に代表者がいる"}, {"type": "subtitle", "time": 9741.59, "timestamp": "02:42:21", "text": "主にコミュニケーションに便利で、"}, {"type": "subtitle", "time": 9744.83, "timestamp": "02:42:24", "text": "時間などの問題を回避する"}, {"type": "subtitle", "time": 9746.75, "timestamp": "02:42:26", "text": "遅れ。時間"}, {"type": "subtitle", "time": 9750.15, "timestamp": "02:42:30", "text": "遅れ。つまり、どのくらいの時間差の話をしているのでしょうか？"}, {"type": "subtitle", "time": 9751.55, "timestamp": "02:42:31", "text": "それについて"}, {"type": "subtitle", "time": 9762.07, "timestamp": "02:42:42", "text": "えっと、どうすればいいですか？私は何をしますか？何"}, {"type": "subtitle", "time": 9770.51, "timestamp": "02:42:50", "text": "[音楽]"}, {"type": "subtitle", "time": 9778.83, "timestamp": "02:42:58", "text": "リー。"}]
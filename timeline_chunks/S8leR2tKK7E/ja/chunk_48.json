[{"type": "subtitle", "time": 2885.349, "timestamp": "00:48:05", "text": "知る。うん。ハニー、元気？そしてどのように"}, {"type": "subtitle", "time": 2887.79, "timestamp": "00:48:07", "text": "睡眠だったのか？おお、"}, {"type": "subtitle", "time": 2891.55, "timestamp": "00:48:11", "text": "こんにちは。睡眠はどうでしたか？"}, {"type": "subtitle", "time": 2893.54, "timestamp": "00:48:13", "text": "えっと、私は"}, {"type": "subtitle", "time": 2896.19, "timestamp": "00:48:16", "text": "[音楽]"}, {"type": "subtitle", "time": 2898.589, "timestamp": "00:48:18", "text": "私は寝ました"}, {"type": "subtitle", "time": 2901.549, "timestamp": "00:48:21", "text": "4時に目が覚めた"}, {"type": "subtitle", "time": 2907.71, "timestamp": "00:48:27", "text": "[音楽]"}, {"type": "subtitle", "time": 2910.15, "timestamp": "00:48:30", "text": "良い。何らかの理由で、昨日、あなたは"}, {"type": "subtitle", "time": 2913.109, "timestamp": "00:48:33", "text": "知ってるよ、作業中に、"}, {"type": "subtitle", "time": 2915.27, "timestamp": "00:48:35", "text": "えっと、ちゃんと見えなかったんです"}, {"type": "subtitle", "time": 2918.549, "timestamp": "00:48:38", "text": "何らかの理由で。今では見えるようになった"}, {"type": "subtitle", "time": 2920.87, "timestamp": "00:48:40", "text": "文字とか全部ちゃんと"}, {"type": "subtitle", "time": 2923.03, "timestamp": "00:48:43", "text": "すべての文字、眼鏡をかけたすべてのもの"}, {"type": "subtitle", "time": 2925.91, "timestamp": "00:48:45", "text": "の上。しかし昨日、何らかの理由で"}, {"type": "subtitle", "time": 2929.069, "timestamp": "00:48:49", "text": "全てが何だったのか知っていたので"}, {"type": "subtitle", "time": 2932.39, "timestamp": "00:48:52", "text": "ぼやけていて、読むことすらできなかったし、"}, {"type": "subtitle", "time": 2934.51, "timestamp": "00:48:54", "text": "私の本当の"}, {"type": "subtitle", "time": 2939.03, "timestamp": "00:48:59", "text": "頭痛。私は一晩中起きていました"}]
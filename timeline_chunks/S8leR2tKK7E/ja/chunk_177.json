[{"type": "subtitle", "time": 10643.07, "timestamp": "02:57:23", "text": "今。別の"}, {"type": "subtitle", "time": 10646.75, "timestamp": "02:57:26", "text": "頭痛。もう一つ"}, {"type": "subtitle", "time": 10653.63, "timestamp": "02:57:33", "text": "泣く。なぜ難しいのか"}, {"type": "subtitle", "time": 10677.19, "timestamp": "02:57:57", "text": "アクセスできるかい？本当に涙が出てくる。"}]
[{"type": "subtitle", "time": 1032.71, "timestamp": "00:17:12", "text": "ええ、まあ、それが一つ目ですね。ええと、私は"}, {"type": "subtitle", "time": 1036.15, "timestamp": "00:17:16", "text": "私のOnXアカウントでストリーミング配信中です。そうなる"}, {"type": "subtitle", "time": 1040.15, "timestamp": "00:17:20", "text": "ただストリームのために何かをしているだけ"}, {"type": "subtitle", "time": 1042.15, "timestamp": "00:17:22", "text": "OBS関連の実験中、"}, {"type": "subtitle", "time": 1044.949, "timestamp": "00:17:24", "text": "実験する実験する"}, {"type": "subtitle", "time": 1048.47, "timestamp": "00:17:28", "text": "科学的なこと。えっと、仕事みたいに"}, {"type": "subtitle", "time": 1050.029, "timestamp": "00:17:30", "text": "仕事と"}, {"type": "subtitle", "time": 1053.31, "timestamp": "00:17:33", "text": "もの。うん。それは"}, {"type": "subtitle", "time": 1057.27, "timestamp": "00:17:37", "text": "全て。ええ、そうするつもりです"}, {"type": "subtitle", "time": 1061.59, "timestamp": "00:17:41", "text": "私がストリーミング配信するONXコンベンションで。"}, {"type": "subtitle", "time": 1063.31, "timestamp": "00:17:43", "text": "それで"}, {"type": "subtitle", "time": 1067.029, "timestamp": "00:17:47", "text": "ええ、私は作りたいと思っていました"}, {"type": "subtitle", "time": 1069.669, "timestamp": "00:17:49", "text": "舞台裏のようなストリーム"}, {"type": "subtitle", "time": 1073.11, "timestamp": "00:17:53", "text": "メインアカウントで配信作業中だけど、"}, {"type": "subtitle", "time": 1074.07, "timestamp": "00:17:54", "text": "私は思った"}, {"type": "subtitle", "time": 1076.99, "timestamp": "00:17:56", "text": "[音楽]"}]
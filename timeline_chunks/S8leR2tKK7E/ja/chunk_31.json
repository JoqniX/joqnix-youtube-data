[{"type": "subtitle", "time": 1861.59, "timestamp": "00:31:01", "text": "うん。ええ、そうです。それで、誰か漏れてたかな？私"}, {"type": "subtitle", "time": 1866.51, "timestamp": "00:31:06", "text": "本当に、もし私があなた方の誰かを見落としていたら"}, {"type": "subtitle", "time": 1870.63, "timestamp": "00:31:10", "text": "えーと、えーと、誰に話しかけてないの？"}, {"type": "subtitle", "time": 1874.029, "timestamp": "00:31:14", "text": "彼らの名前を呼んでください。"}, {"type": "subtitle", "time": 1877.789, "timestamp": "00:31:17", "text": "えーと、そして"}, {"type": "subtitle", "time": 1880.31, "timestamp": "00:31:20", "text": "うん、私を見てくれて本当に本当に"}, {"type": "subtitle", "time": 1884.029, "timestamp": "00:31:24", "text": "本当に本当に大切なことです。"}, {"type": "subtitle", "time": 1889.389, "timestamp": "00:31:29", "text": "うん。そしてまた、そしてまた、すべての"}, {"type": "subtitle", "time": 1893.549, "timestamp": "00:31:33", "text": "潜伏者 潜伏していたすべての人"}, {"type": "subtitle", "time": 1897.34, "timestamp": "00:31:37", "text": "今日は本当に本当に本当に"}, {"type": "subtitle", "time": 1899.31, "timestamp": "00:31:39", "text": "[音楽]"}, {"type": "subtitle", "time": 1902.63, "timestamp": "00:31:42", "text": "ここで2回も。アキアビ、忘れてるよ。いいえ、私は"}, {"type": "subtitle", "time": 1907.669, "timestamp": "00:31:47", "text": "アキアビの名前を呼んだ。"}, {"type": "subtitle", "time": 1919.23, "timestamp": "00:31:59", "text": "エドワード朝、そしてヴィクター"}]
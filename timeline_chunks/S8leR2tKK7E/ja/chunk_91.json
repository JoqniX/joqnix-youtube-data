[{"type": "subtitle", "time": 5461.39, "timestamp": "01:31:01", "text": "ご存じの通り、彼はとても忙しかったんです。それで"}, {"type": "subtitle", "time": 5465.75, "timestamp": "01:31:05", "text": "忙しい。あのバカはなんでそんなに忙しいの？のように"}, {"type": "subtitle", "time": 5468.149, "timestamp": "01:31:08", "text": "毎日走り回っていて、私は"}, {"type": "subtitle", "time": 5471.27, "timestamp": "01:31:11", "text": "どうすればいいですか？"}, {"type": "subtitle", "time": 5473.669, "timestamp": "01:31:13", "text": "つまり、大男は、ほら、"}, {"type": "subtitle", "time": 5481.55, "timestamp": "01:31:21", "text": "M so"}, {"type": "subtitle", "time": 5485.27, "timestamp": "01:31:25", "text": "はい、私もポを手に入れようと思いました"}, {"type": "subtitle", "time": 5487.59, "timestamp": "01:31:27", "text": "ここにあるものだけど、それは"}, {"type": "subtitle", "time": 5491.51, "timestamp": "01:31:31", "text": "過度に。彼が釈放されるかどうかは分かりません。"}, {"type": "subtitle", "time": 5494.39, "timestamp": "01:31:34", "text": "でも待って、もしポみたいだったらすごく怒るだろう"}, {"type": "subtitle", "time": 5496.31, "timestamp": "01:31:36", "text": "あなたのストリームに出演することに同意する"}, {"type": "subtitle", "time": 5499.75, "timestamp": "01:31:39", "text": "スタースケープのメンバーの誰か。"}, {"type": "subtitle", "time": 5503.669, "timestamp": "01:31:43", "text": "えっと、でも彼は誰かの"}, {"type": "subtitle", "time": 5506.47, "timestamp": "01:31:46", "text": "ストリームですよね？それは誰だったのか？私はしません"}, {"type": "subtitle", "time": 5508.229, "timestamp": "01:31:48", "text": "誰かがインタビューを受けたんですよね？私"}, {"type": "subtitle", "time": 5511.59, "timestamp": "01:31:51", "text": "忘れた。待って、ルミナだったか、それとも"}, {"type": "subtitle", "time": 5513.27, "timestamp": "01:31:53", "text": "待って、あなたはインタビューを受けていなかったの？"}, {"type": "subtitle", "time": 5514.79, "timestamp": "01:31:54", "text": "彼？"}, {"type": "subtitle", "time": 5517.59, "timestamp": "01:31:57", "text": "トカゲ人間か何かが"}]
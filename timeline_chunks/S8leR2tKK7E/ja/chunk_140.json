[{"type": "subtitle", "time": 8401.91, "timestamp": "02:20:01", "text": "雰囲気は悪い時もあるし"}, {"type": "subtitle", "time": 8403.59, "timestamp": "02:20:03", "text": "やり遂げるしかない"}, {"type": "subtitle", "time": 8406.55, "timestamp": "02:20:06", "text": "もっと良いものを買う余裕があるでしょう。うん、"}, {"type": "subtitle", "time": 8409.03, "timestamp": "02:20:09", "text": "それは本当だ。はい。はい。"}, {"type": "subtitle", "time": 8411.27, "timestamp": "02:20:11", "text": "だから、それは旅のようなもので"}, {"type": "subtitle", "time": 8417.51, "timestamp": "02:20:17", "text": "ええ、実はそれこそが私の不安の一つなんです。"}, {"type": "subtitle", "time": 8420.55, "timestamp": "02:20:20", "text": "えっと、予算を抑えて"}, {"type": "subtitle", "time": 8423.99, "timestamp": "02:20:23", "text": "現時点での資産は？人々はこう思うだろうか"}, {"type": "subtitle", "time": 8427.349, "timestamp": "02:20:27", "text": "延期する？彼らは気分が悪くなるだろう、なぜなら"}, {"type": "subtitle", "time": 8429.59, "timestamp": "02:20:29", "text": "彼らはデビューやその他すべてを見ている"}, {"type": "subtitle", "time": 8433.75, "timestamp": "02:20:33", "text": "「えっと、なぜ"}, {"type": "subtitle", "time": 8437.27, "timestamp": "02:20:37", "text": "奇妙な資産？そうなると思った"}, {"type": "subtitle", "time": 8440.07, "timestamp": "02:20:40", "text": "品質が同等であること"}, {"type": "subtitle", "time": 8442.55, "timestamp": "02:20:42", "text": "マテルとか、人々が持っているような"}, {"type": "subtitle", "time": 8444.55, "timestamp": "02:20:44", "text": "彼らが今品質を期待しているとき"}, {"type": "subtitle", "time": 8447.67, "timestamp": "02:20:47", "text": "あなたのデビュー配信を見てください。でも私はそうは思わない"}, {"type": "subtitle", "time": 8450.79, "timestamp": "02:20:50", "text": "多くの人がそうするように考える"}, {"type": "subtitle", "time": 8453.83, "timestamp": "02:20:53", "text": "正面から見ると、彼らはただ、ご存知のように"}, {"type": "subtitle", "time": 8456.55, "timestamp": "02:20:56", "text": "あなたをサポートし、見守るためにそこにいます"}, {"type": "subtitle", "time": 8459.03, "timestamp": "02:20:59", "text": "あなたの旅。それに加えて、"}]
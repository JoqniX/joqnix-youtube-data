[{"type": "subtitle", "time": 3902.51, "timestamp": "01:05:02", "text": "すべてが光。何てことだ。"}, {"type": "subtitle", "time": 3905.51, "timestamp": "01:05:05", "text": "すべて。聞いてください、私には言えません"}, {"type": "subtitle", "time": 3907.75, "timestamp": "01:05:07", "text": "ストレスが溜まっていたのは"}, {"type": "subtitle", "time": 3910.47, "timestamp": "01:05:10", "text": "手順自体がやるべきことがたくさんあるようなものだ"}, {"type": "subtitle", "time": 3911.99, "timestamp": "01:05:11", "text": "そして、法律的な問題もたくさんあります"}, {"type": "subtitle", "time": 3914.15, "timestamp": "01:05:14", "text": "やらなきゃいけないこと、そしてご存知のように"}, {"type": "subtitle", "time": 3916.23, "timestamp": "01:05:16", "text": "通路やその他すべて"}, {"type": "subtitle", "time": 3918.87, "timestamp": "01:05:18", "text": "その上、ビザのようなものと"}, {"type": "subtitle", "time": 3922.309, "timestamp": "01:05:22", "text": "そういうことと、それはとても不安なこと"}, {"type": "subtitle", "time": 3924.63, "timestamp": "01:05:24", "text": "まるで私が移動しなければならなかったかのように誘発する"}, {"type": "subtitle", "time": 3926.71, "timestamp": "01:05:26", "text": "スコットランドのように9月のように"}, {"type": "subtitle", "time": 3930.309, "timestamp": "01:05:30", "text": "2023年、そして6月いっぱい私は"}, {"type": "subtitle", "time": 3933.27, "timestamp": "01:05:33", "text": "何かをする、例えば行く"}, {"type": "subtitle", "time": 3935.51, "timestamp": "01:05:35", "text": "毎日そこにいて、"}, {"type": "subtitle", "time": 3938.63, "timestamp": "01:05:38", "text": "ストレスで食べ過ぎていたのも事実です。私は"}, {"type": "subtitle", "time": 3940.47, "timestamp": "01:05:40", "text": "不安が大きすぎるのは"}, {"type": "subtitle", "time": 3942.39, "timestamp": "01:05:42", "text": "全く新しい場所。わからない"}, {"type": "subtitle", "time": 3945.109, "timestamp": "01:05:45", "text": "誰でも。あなたほどよく知らない"}, {"type": "subtitle", "time": 3946.87, "timestamp": "01:05:46", "text": "地元の人々の生活とはどのようなものか"}, {"type": "subtitle", "time": 3948.71, "timestamp": "01:05:48", "text": "彼らはどんな感じだろうか、あるいは彼らの"}, {"type": "subtitle", "time": 3950.71, "timestamp": "01:05:50", "text": "受付では、まるで誰もいないかのような状況になるでしょう。"}, {"type": "subtitle", "time": 3953.349, "timestamp": "01:05:53", "text": "あなたには何も持っていない。始めなければならないのは"}, {"type": "chat", "time": 3954.933, "timestamp": "01:05:54", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "Yoo"}, {"type": "subtitle", "time": 3957.27, "timestamp": "01:05:57", "text": "傷。怖いけど"}, {"type": "subtitle", "time": 3959.19, "timestamp": "01:05:59", "text": "素晴らしい経験でした。"}]
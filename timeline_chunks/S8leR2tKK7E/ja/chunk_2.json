[{"type": "subtitle", "time": 129.669, "timestamp": "00:02:09", "text": "キッカン、潜伏者が誰なのか分からない"}, {"type": "subtitle", "time": 132.07, "timestamp": "00:02:12", "text": "キックが効くぜ。皆さんに感謝しています。"}, {"type": "subtitle", "time": 134.07, "timestamp": "00:02:14", "text": "男。そして、あなたがもっと潜伏すればするほど"}, {"type": "subtitle", "time": 137.11, "timestamp": "00:02:17", "text": "キック、そこにいたい気持ちが強くなる"}, {"type": "subtitle", "time": 139.15, "timestamp": "00:02:19", "text": "キック"}, {"type": "subtitle", "time": 141.07, "timestamp": "00:02:21", "text": "もっと。"}]
[{"type": "subtitle", "time": 6420.709, "timestamp": "01:47:00", "text": "なぜ少数の人しかいないのか？これに賛成しましょう。私"}, {"type": "subtitle", "time": 6422.55, "timestamp": "01:47:02", "text": "話した人全員とコラボレーションしたい"}, {"type": "subtitle", "time": 6424.95, "timestamp": "01:47:04", "text": "そして私はそれを実行して見せるつもりです"}, {"type": "subtitle", "time": 6427.189, "timestamp": "01:47:07", "text": "自分自身。"}, {"type": "subtitle", "time": 6429.109, "timestamp": "01:47:09", "text": "それが本当に"}, {"type": "subtitle", "time": 6431.669, "timestamp": "01:47:11", "text": "あなたを際立たせるのは、"}, {"type": "subtitle", "time": 6433.99, "timestamp": "01:47:13", "text": "いつも、それはすべてであるか、"}, {"type": "subtitle", "time": 6436.31, "timestamp": "01:47:16", "text": "何もない、そしてまるで今まで"}, {"type": "subtitle", "time": 6438.95, "timestamp": "01:47:18", "text": "差別された人々、または"}, {"type": "subtitle", "time": 6441.669, "timestamp": "01:47:21", "text": "彼らに優先順位を言うと、わかるでしょ？"}, {"type": "subtitle", "time": 6444.87, "timestamp": "01:47:24", "text": "あるいは、何と言いますか"}, {"type": "subtitle", "time": 6446.79, "timestamp": "01:47:26", "text": "偏見を示すあらゆる種類の偏見"}, {"type": "subtitle", "time": 6447.79, "timestamp": "01:47:27", "text": "で"}, {"type": "subtitle", "time": 6450.39, "timestamp": "01:47:30", "text": "コミュニティ、そしてそれにはたくさんの"}, {"type": "subtitle", "time": 6452.709, "timestamp": "01:47:32", "text": "それを実行する力も私にはわからない"}, {"type": "subtitle", "time": 6454.47, "timestamp": "01:47:34", "text": "彼女があなたのように生きていたのはどういうことか"}, {"type": "subtitle", "time": 6456.31, "timestamp": "01:47:36", "text": "毎日たくさんの人と話しているのを知っている"}, {"type": "subtitle", "time": 6466.79, "timestamp": "01:47:46", "text": "私は中にいます。うん、バッテリー残量がすごく少ないんだ。"}, {"type": "subtitle", "time": 6469.83, "timestamp": "01:47:49", "text": "でも、そう、やらなきゃいけないんだ。"}, {"type": "subtitle", "time": 6472.87, "timestamp": "01:47:52", "text": "なぜなら、私はこう言ったから"}, {"type": "subtitle", "time": 6475.43, "timestamp": "01:47:55", "text": "1つ、それとそれもある。そして私は"}, {"type": "subtitle", "time": 6479.189, "timestamp": "01:47:59", "text": "つまり、これが私の最期の瞬間なんだよね？あなた。"}]
[{"type": "subtitle", "time": 1981.19, "timestamp": "00:33:01", "text": "夜になると時々怖がる。だから彼女は"}, {"type": "subtitle", "time": 1984.269, "timestamp": "00:33:04", "text": "彼女は私に一緒に寝てほしいと思っていた"}, {"type": "subtitle", "time": 1990.07, "timestamp": "00:33:10", "text": "今日。そうですね、私はそう思います"}, {"type": "subtitle", "time": 1993.59, "timestamp": "00:33:13", "text": "今夜は寝て休もう。わからない。しかし"}, {"type": "subtitle", "time": 1994.95, "timestamp": "00:33:14", "text": "正直に言うと、私は"}, {"type": "subtitle", "time": 1998.389, "timestamp": "00:33:18", "text": "睡眠スケジュールを修正する"}, {"type": "subtitle", "time": 2001.83, "timestamp": "00:33:21", "text": "ここ数日。でも私は"}, {"type": "subtitle", "time": 2004.149, "timestamp": "00:33:24", "text": "まるで私が"}, {"type": "subtitle", "time": 2008.99, "timestamp": "00:33:28", "text": "えっと、もし私が12時か10時に寝るかどうか分かっていたら"}, {"type": "subtitle", "time": 2012.87, "timestamp": "00:33:32", "text": "11 私は目を開けたまま、"}, {"type": "subtitle", "time": 2016.509, "timestamp": "00:33:36", "text": "夜通し午前6時まで"}, {"type": "subtitle", "time": 2019.63, "timestamp": "00:33:39", "text": "午前。そんなことが起こらないことを願います。"}, {"type": "subtitle", "time": 2022.23, "timestamp": "00:33:42", "text": "今夜、睡眠を改善したいから"}, {"type": "subtitle", "time": 2025.02, "timestamp": "00:33:45", "text": "スケジュールを組むので"}, {"type": "subtitle", "time": 2026.509, "timestamp": "00:33:46", "text": "[音楽]"}, {"type": "subtitle", "time": 2029.19, "timestamp": "00:33:49", "text": "悪い。分かりますよ。私の母も"}, {"type": "subtitle", "time": 2036.31, "timestamp": "00:33:56", "text": "けれど。母は私を自慢げに見せびらかす。彼女は"}]
[{"type": "subtitle", "time": 9660.349, "timestamp": "02:41:00", "text": "あなたのために。私にはそういう人がいます。私は持っています"}, {"type": "subtitle", "time": 9662.34, "timestamp": "02:41:02", "text": "友人。えっと"}, {"type": "subtitle", "time": 9676.95, "timestamp": "02:41:16", "text": "友人は、彼らが終わったかどうか尋ねた。うん。"}, {"type": "subtitle", "time": 9679.67, "timestamp": "02:41:19", "text": "モラフの持つ力。うん。もし彼らが"}, {"type": "subtitle", "time": 9693.83, "timestamp": "02:41:33", "text": "[音楽]"}, {"type": "subtitle", "time": 9697.27, "timestamp": "02:41:37", "text": "ああ、私たちは、どうすれば見つけられるか"}, {"type": "subtitle", "time": 9704.15, "timestamp": "02:41:44", "text": "代表？中国人を見つけるにはどうすればいいですか"}]
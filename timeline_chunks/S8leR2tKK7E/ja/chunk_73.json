[{"type": "subtitle", "time": 4383.03, "timestamp": "01:13:03", "text": "なぜなら、みんなの旅はとても"}, {"type": "subtitle", "time": 4385.229, "timestamp": "01:13:05", "text": "違う"}, {"type": "subtitle", "time": 4390.35, "timestamp": "01:13:10", "text": "今。 M、それは全くその通りです。"}, {"type": "subtitle", "time": 4394.39, "timestamp": "01:13:14", "text": "うん。ええ、まだ"}, {"type": "subtitle", "time": 4397.11, "timestamp": "01:13:17", "text": "のような感覚を体験した"}, {"type": "subtitle", "time": 4400.669, "timestamp": "01:13:20", "text": "たくさんのこと。たくさんのこと、"}, {"type": "subtitle", "time": 4405.27, "timestamp": "01:13:25", "text": "右？でも、もし私がこう言うとしたら"}, {"type": "subtitle", "time": 4407.51, "timestamp": "01:13:27", "text": "たくさんの人に見られていることに対処する"}, {"type": "subtitle", "time": 4410.149, "timestamp": "01:13:30", "text": "同時にそれらを維持し"}, {"type": "subtitle", "time": 4413.669, "timestamp": "01:13:33", "text": "楽しませてくれるとか、そういうこと全部ですよね？"}, {"type": "subtitle", "time": 4417.59, "timestamp": "01:13:37", "text": "えっと、一日の終わりには"}, {"type": "subtitle", "time": 4419.27, "timestamp": "01:13:39", "text": "維持することに重点を置きすぎる"}, {"type": "subtitle", "time": 4421.27, "timestamp": "01:13:41", "text": "全員が満足した。必要がある"}, {"type": "subtitle", "time": 4422.79, "timestamp": "01:13:42", "text": "人々があなたを見ていることを理解し、"}, {"type": "subtitle", "time": 4426.07, "timestamp": "01:13:46", "text": "ありのままのあなたが好き。だから、あなたのようにではなく"}, {"type": "subtitle", "time": 4428.709, "timestamp": "01:13:48", "text": "彼らを喜ばせすぎると、"}, {"type": "subtitle", "time": 4431.83, "timestamp": "01:13:51", "text": "自分らしくいることに集中して"}, {"type": "subtitle", "time": 4434.229, "timestamp": "01:13:54", "text": "好きなことと嫌いなことをする"}, {"type": "subtitle", "time": 4436.229, "timestamp": "01:13:56", "text": "自分自身やあなたの"}, {"type": "subtitle", "time": 4437.91, "timestamp": "01:13:57", "text": "視聴者。"}]
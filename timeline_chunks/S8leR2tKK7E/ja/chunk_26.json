[{"type": "subtitle", "time": 1565.71, "timestamp": "00:26:05", "text": "うん。わかった。"}, {"type": "subtitle", "time": 1569.23, "timestamp": "00:26:09", "text": "こんにちは。ですから、あまり長く待たなかったことを願っています。"}, {"type": "subtitle", "time": 1571.39, "timestamp": "00:26:11", "text": "いいえ、あなたは"}, {"type": "subtitle", "time": 1574.47, "timestamp": "00:26:14", "text": "早い。私はストリームをあまり"}, {"type": "subtitle", "time": 1580.19, "timestamp": "00:26:20", "text": "あなたの。"}, {"type": "subtitle", "time": 1583.51, "timestamp": "00:26:23", "text": "うん。あ、待って。寒くなってきた気がする"}]
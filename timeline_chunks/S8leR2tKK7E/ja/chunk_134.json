[{"type": "subtitle", "time": 8042.229, "timestamp": "02:14:02", "text": "初期のプロトタイプ、たぶん、戻ってきました。"}, {"type": "subtitle", "time": 8044.51, "timestamp": "02:14:04", "text": "君がFitmaにいたことをすっかり忘れてたよ"}, {"type": "subtitle", "time": 8047.83, "timestamp": "02:14:07", "text": "あれ。覚えていますか？何てことだ、"}, {"type": "subtitle", "time": 8050.95, "timestamp": "02:14:10", "text": "覚えていますよ。これは本当に可愛い。"}, {"type": "subtitle", "time": 8054.79, "timestamp": "02:14:14", "text": "とても気に入っています。とても"}, {"type": "subtitle", "time": 8058.069, "timestamp": "02:14:18", "text": "それは何ですか？ゲンシャインっぽい感じ"}, {"type": "subtitle", "time": 8062.55, "timestamp": "02:14:22", "text": "それには美的な意味がある。うん。とても綺麗。私は愛する"}, {"type": "subtitle", "time": 8065.669, "timestamp": "02:14:25", "text": "ローブにあしらわれた星と輝き"}, {"type": "subtitle", "time": 8067.91, "timestamp": "02:14:27", "text": "そして、小さなクジラとか、その他もろもろ。おお"}, {"type": "subtitle", "time": 8069.589, "timestamp": "02:14:29", "text": "ああ、これは信じられない。私はできません"}, {"type": "subtitle", "time": 8073.109, "timestamp": "02:14:33", "text": "あなたが皮をむくのを待っています。それでD。うん、僕だよ"}, {"type": "subtitle", "time": 8075.03, "timestamp": "02:14:35", "text": "あまりにも。"}, {"type": "subtitle", "time": 8078.87, "timestamp": "02:14:38", "text": "いいえ、私は、"}, {"type": "subtitle", "time": 8081.109, "timestamp": "02:14:41", "text": "このレベルのものはまた"}, {"type": "subtitle", "time": 8084.709, "timestamp": "02:14:44", "text": "本当に高い。いや、でも私はこう思った"}, {"type": "subtitle", "time": 8086.709, "timestamp": "02:14:46", "text": "私はこれを丸々一ヶ月間持つつもりです"}, {"type": "subtitle", "time": 8090.709, "timestamp": "02:14:50", "text": "長い時間が経ち、アップグレードのようなものが出てくるだろう"}, {"type": "subtitle", "time": 8093.83, "timestamp": "02:14:53", "text": "後でそれに対して行われた。"}, {"type": "subtitle", "time": 8096.87, "timestamp": "02:14:56", "text": "アニメーションでも、"}, {"type": "subtitle", "time": 8099.99, "timestamp": "02:14:59", "text": "アップグレードが可能であれば何でも"}]
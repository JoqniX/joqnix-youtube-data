[{"type": "subtitle", "time": 7323.43, "timestamp": "02:02:03", "text": "それは私の意見では正気の沙汰ではない。私は思う"}, {"type": "subtitle", "time": 7325.91, "timestamp": "02:02:05", "text": "多くの人は現実を直視する必要がある"}, {"type": "subtitle", "time": 7328.709, "timestamp": "02:02:08", "text": "私のような者も時々"}, {"type": "subtitle", "time": 7331.91, "timestamp": "02:02:11", "text": "ほら、私たちみんなの正気を保つためにね。"}, {"type": "subtitle", "time": 7333.79, "timestamp": "02:02:13", "text": "ええ、そうです"}, {"type": "subtitle", "time": 7335.87, "timestamp": "02:02:15", "text": "真実。それで"}, {"type": "subtitle", "time": 7339.35, "timestamp": "02:02:19", "text": "それから私はどうやってついていくのかわかりません"}, {"type": "subtitle", "time": 7341.95, "timestamp": "02:02:21", "text": "あなたはこれまで、"}, {"type": "subtitle", "time": 7345.75, "timestamp": "02:02:25", "text": "遅すぎるか、そうでないように見える"}, {"type": "subtitle", "time": 7348.39, "timestamp": "02:02:28", "text": "他の人に追いつこうとしている？他の人たちは"}, {"type": "subtitle", "time": 7350.709, "timestamp": "02:02:30", "text": "もっと早く。"}, {"type": "subtitle", "time": 7353.03, "timestamp": "02:02:33", "text": "はい、私もあなたと同じようにそう感じたことがあります。"}, {"type": "subtitle", "time": 7356.07, "timestamp": "02:02:36", "text": "ずっと前の話だけど、これ"}, {"type": "subtitle", "time": 7358.709, "timestamp": "02:02:38", "text": "私はそういう傾向は大丈夫ではない、私はそういうタイプです"}, {"type": "subtitle", "time": 7361.99, "timestamp": "02:02:41", "text": "嫉妬を感じない人"}, {"type": "subtitle", "time": 7363.669, "timestamp": "02:02:43", "text": "とても奇妙なことだと思うけど、"}, {"type": "subtitle", "time": 7367.109, "timestamp": "02:02:47", "text": "嫉妬を感じないけど、"}, {"type": "subtitle", "time": 7369.03, "timestamp": "02:02:49", "text": "仲間外れにされたような気分になるし、そういう感じ"}, {"type": "subtitle", "time": 7372.47, "timestamp": "02:02:52", "text": "あなたも知っているように、私はよく"}, {"type": "subtitle", "time": 7375.189, "timestamp": "02:02:55", "text": "ほら、私の焦点を合わせ直す"}, {"type": "subtitle", "time": 7377.589, "timestamp": "02:02:57", "text": "私は自分の人生で、そしてその部分で"}, {"type": "subtitle", "time": 7379.51, "timestamp": "02:02:59", "text": "彼らは人生の中で、彼らは"}]
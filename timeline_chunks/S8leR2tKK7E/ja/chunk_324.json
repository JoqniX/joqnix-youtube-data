[{"type": "subtitle", "time": 19440.19, "timestamp": "05:24:00", "text": "自作農地。これをスキャンしてください"}, {"type": "subtitle", "time": 19443.75, "timestamp": "05:24:03", "text": "飛行機。水、鉛、タングステン、チタン。おお、"}, {"type": "subtitle", "time": 19445.67, "timestamp": "05:24:05", "text": "ここにはチタンがある。わかりました、"}, {"type": "subtitle", "time": 19448.91, "timestamp": "05:24:08", "text": "それを念頭に置いて。"}, {"type": "subtitle", "time": 19453.91, "timestamp": "05:24:13", "text": "ウィンクランド。さあ行こう。それで、お店があるんです"}, {"type": "subtitle", "time": 19456.55, "timestamp": "05:24:16", "text": "着陸直前の商人"}, {"type": "subtitle", "time": 19460.55, "timestamp": "05:24:20", "text": "中心部。そこに座って、そう、"}, {"type": "subtitle", "time": 19462.47, "timestamp": "05:24:22", "text": "文字通り、すべて買い占める。購入"}, {"type": "subtitle", "time": 19464.788, "timestamp": "05:24:24", "text": "自作農地。ああ、ここは変わっていないな"}, {"type": "subtitle", "time": 19467.99, "timestamp": "05:24:27", "text": "2100年代以降、大きく変化した。"}, {"type": "subtitle", "time": 19470.39, "timestamp": "05:24:30", "text": "ニューホームステッドへようこそ。作成してください"}, {"type": "subtitle", "time": 19471.99, "timestamp": "05:24:31", "text": "建物の端まで行く"}, {"type": "subtitle", "time": 19474.628, "timestamp": "05:24:34", "text": "小道を下り、下のコロニーへと降りていく。"}, {"type": "subtitle", "time": 19479.35, "timestamp": "05:24:39", "text": "それでは、お気をつけて、ご旅行をお楽しみください。"}, {"type": "subtitle", "time": 19481.27, "timestamp": "05:24:41", "text": "私たちは文字通り新たなミッションを解き放った"}, {"type": "subtitle", "time": 19487.59, "timestamp": "05:24:47", "text": "何？あのね？私は自分自身を"}, {"type": "subtitle", "time": 19496.35, "timestamp": "05:24:56", "text": "もの。ああ、重力がある"}]
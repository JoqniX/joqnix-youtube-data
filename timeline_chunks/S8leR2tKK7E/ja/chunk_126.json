[{"type": "subtitle", "time": 7560.55, "timestamp": "02:06:00", "text": "優先順位をつける必要があるのは"}, {"type": "subtitle", "time": 7561.91, "timestamp": "02:06:01", "text": "あなたはそこで何をしたいですか"}, {"type": "subtitle", "time": 7564.27, "timestamp": "02:06:04", "text": "瞬間と、何が有益か"}, {"type": "subtitle", "time": 7567.27, "timestamp": "02:06:07", "text": "あなた。だから私はこう思うようになったと思う"}, {"type": "subtitle", "time": 7570.51, "timestamp": "02:06:10", "text": "私は多くのことを後悔していると言うことが多い"}, {"type": "subtitle", "time": 7575.75, "timestamp": "02:06:15", "text": "少なく、またある意味で私を理解して"}, {"type": "subtitle", "time": 7577.629, "timestamp": "02:06:17", "text": "気分を悪くしないで"}, {"type": "subtitle", "time": 7580.39, "timestamp": "02:06:20", "text": "セレスティアとして周りにいることについて"}, {"type": "subtitle", "time": 7586.31, "timestamp": "02:06:26", "text": "結局のところ、それは人生のようなものだから"}, {"type": "subtitle", "time": 7589.99, "timestamp": "02:06:29", "text": "私が自分で選んだもの。うん。"}, {"type": "subtitle", "time": 7591.51, "timestamp": "02:06:31", "text": "そして、他の誰もその選択をすることはできなかった。"}, {"type": "subtitle", "time": 7593.47, "timestamp": "02:06:33", "text": "のために"}, {"type": "subtitle", "time": 7595.39, "timestamp": "02:06:35", "text": "自分。"}, {"type": "subtitle", "time": 7605.03, "timestamp": "02:06:45", "text": "いやいや、大丈夫ですよ。心配ない。"}, {"type": "subtitle", "time": 7608.229, "timestamp": "02:06:48", "text": "わーい。聞いていて楽しい。まるで"}, {"type": "subtitle", "time": 7610.47, "timestamp": "02:06:50", "text": "つまり、私にとっては初めてのことなんです"}, {"type": "subtitle", "time": 7613.27, "timestamp": "02:06:53", "text": "あなたと座って話をする。それは"}, {"type": "subtitle", "time": 7617.149, "timestamp": "02:06:57", "text": "楽しい。もっと頻繁にやるべきですね。私 私"}]
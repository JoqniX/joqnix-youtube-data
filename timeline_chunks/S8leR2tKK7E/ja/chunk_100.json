[{"type": "subtitle", "time": 6000.95, "timestamp": "01:40:00", "text": "何かが改善したように"}, {"type": "subtitle", "time": 6002.79, "timestamp": "01:40:02", "text": "たぶん1時間くらいかかったと思うし"}, {"type": "subtitle", "time": 6004.55, "timestamp": "01:40:04", "text": "スタースケープのメンバーにとって半年"}, {"type": "subtitle", "time": 6007.109, "timestamp": "01:40:07", "text": "他の人とオープンに交流し始める"}, {"type": "subtitle", "time": 6008.87, "timestamp": "01:40:08", "text": "YouTuber。"}, {"type": "subtitle", "time": 6010.149, "timestamp": "01:40:10", "text": "うん。"}, {"type": "subtitle", "time": 6013.43, "timestamp": "01:40:13", "text": "そして、そのグループ努力があなたを導いたのです"}, {"type": "subtitle", "time": 6018.149, "timestamp": "01:40:18", "text": "君たち、今日君のような存在になりたい。今、その小さな"}, {"type": "subtitle", "time": 6020.149, "timestamp": "01:40:20", "text": "知っているように、その小さな選択を実行してください"}, {"type": "subtitle", "time": 6022.79, "timestamp": "01:40:22", "text": "今こそ立ち上がらなければならない、共に立ち上がらなければならない"}, {"type": "subtitle", "time": 6024.95, "timestamp": "01:40:24", "text": "お互いを守り合って、"}, {"type": "subtitle", "time": 6028.39, "timestamp": "01:40:28", "text": "あなたが言った。うん。"}, {"type": "subtitle", "time": 6031.35, "timestamp": "01:40:31", "text": "その通り。"}, {"type": "subtitle", "time": 6034.51, "timestamp": "01:40:34", "text": "グループの中で自分がどう振る舞うかは分からない"}, {"type": "subtitle", "time": 6037.27, "timestamp": "01:40:37", "text": "設定に関しては、あなたなら素晴らしい仕事をすると思います。"}, {"type": "subtitle", "time": 6039.55, "timestamp": "01:40:39", "text": "あなたは今も素晴らしい活躍をしています。あなたのような"}, {"type": "subtitle", "time": 6042.149, "timestamp": "01:40:42", "text": "まるで私が言ったように、人々は"}, {"type": "subtitle", "time": 6044.149, "timestamp": "01:40:44", "text": "あなたに対しては、全般的に非常に敬意を抱いています。私はしません"}, {"type": "subtitle", "time": 6046.79, "timestamp": "01:40:46", "text": "自分が何者かの一人であるかのように考えてください"}, {"type": "subtitle", "time": 6049.03, "timestamp": "01:40:49", "text": "一番いい人って言うと、"}, {"type": "subtitle", "time": 6050.87, "timestamp": "01:40:50", "text": "今まで出会った中で最も親切な人"}, {"type": "subtitle", "time": 6054.109, "timestamp": "01:40:54", "text": "このコミュニティで出会う"}, {"type": "subtitle", "time": 6056.79, "timestamp": "01:40:56", "text": "そして誰かができないかどうかはわかりません"}, {"type": "subtitle", "time": 6059.75, "timestamp": "01:40:59", "text": "あなたとは気が合います。それはそうだろう"}]
[{"type": "subtitle", "time": 18781.67, "timestamp": "05:13:01", "text": "え？うん。私が寝ていない時に彼女は寝る"}, {"type": "subtitle", "time": 18788.948, "timestamp": "05:13:08", "text": "うん。つまり、文字通りあなたがすることは適応することです"}, {"type": "subtitle", "time": 18791.708, "timestamp": "05:13:11", "text": "額装する。マウスを"}, {"type": "subtitle", "time": 18799.19, "timestamp": "05:13:19", "text": "これが私の稼ぎ方です。これが私のやり方です"}, {"type": "subtitle", "time": 18800.67, "timestamp": "05:13:20", "text": "レベルアップ"}, {"type": "subtitle", "time": 18803.75, "timestamp": "05:13:23", "text": "もっと早く。はい、レベルはあります。私は文字通り"}, {"type": "subtitle", "time": 18806.35, "timestamp": "05:13:26", "text": "効果音をレベルアップしたばかりです"}, {"type": "subtitle", "time": 18809.47, "timestamp": "05:13:29", "text": "そこには。レベルアップしました。"}, {"type": "subtitle", "time": 18813.75, "timestamp": "05:13:33", "text": "ニース。ロマンス。はい、ロマンスはあります"}, {"type": "subtitle", "time": 18823.51, "timestamp": "05:13:43", "text": "MPC。こんにちは。それでおしまい。"}, {"type": "subtitle", "time": 18829.788, "timestamp": "05:13:49", "text": "あのマクロを作っておいてよかった。レベル80"}, {"type": "subtitle", "time": 18832.868, "timestamp": "05:13:52", "text": "ストリーム。ご覧のとおり、"}, {"type": "subtitle", "time": 18834.47, "timestamp": "05:13:54", "text": "前回とは全く違う"}, {"type": "subtitle", "time": 18837.91, "timestamp": "05:13:57", "text": "ストリームか。文字通り半分ロックを解除しました"}, {"type": "subtitle", "time": 18839.948, "timestamp": "05:13:59", "text": "の"}]
[{"type": "subtitle", "time": 18902.948, "timestamp": "05:15:02", "text": "実際にはもっと多くのものがあります"}, {"type": "subtitle", "time": 18907.948, "timestamp": "05:15:07", "text": "文字通り、もっとたくさんのものがあります。うん、"}, {"type": "subtitle", "time": 18915.99, "timestamp": "05:15:15", "text": "フレーム。わからない。私は、私はスーパーに行きました"}, {"type": "subtitle", "time": 18917.55, "timestamp": "05:15:17", "text": "研削"}, {"type": "subtitle", "time": 18927.55, "timestamp": "05:15:27", "text": "ええ、それで、研究では"}, {"type": "subtitle", "time": 18931.19, "timestamp": "05:15:31", "text": "ラボでは武器関連のことだけをやればいい。"}, {"type": "subtitle", "time": 18933.15, "timestamp": "05:15:33", "text": "私は信じている。"}, {"type": "subtitle", "time": 18938.11, "timestamp": "05:15:38", "text": "兵器。うん、これは私が必要なだけ"}, {"type": "subtitle", "time": 18940.27, "timestamp": "05:15:40", "text": "えっと"}, {"type": "subtitle", "time": 18942.83, "timestamp": "05:15:42", "text": "接着剤"}, {"type": "subtitle", "time": 18946.59, "timestamp": "05:15:46", "text": "潤滑剤と、えーと"}, {"type": "subtitle", "time": 18949.35, "timestamp": "05:15:49", "text": "ウタリウム。よし、これだ。では、"}, {"type": "subtitle", "time": 18952.03, "timestamp": "05:15:52", "text": "これを買って、終わらせてしまえ。"}, {"type": "subtitle", "time": 18954.47, "timestamp": "05:15:54", "text": "では、次に進みましょう"}, {"type": "subtitle", "time": 18957.19, "timestamp": "05:15:57", "text": "別の場所で。では、私は何をすればいいのでしょうか？"}, {"type": "subtitle", "time": 18959.19, "timestamp": "05:15:59", "text": "ええ、もちろんジョッキーって言うでしょうね"}]
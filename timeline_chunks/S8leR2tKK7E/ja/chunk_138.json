[{"type": "subtitle", "time": 8280.709, "timestamp": "02:18:00", "text": "クラウドファンディングで資金を集めたんだけど、私はこう思った。"}, {"type": "subtitle", "time": 8284.389, "timestamp": "02:18:04", "text": "私は本当にこの新しいものを使う資格があるのだろうか"}, {"type": "subtitle", "time": 8289.03, "timestamp": "02:18:09", "text": "バカなデザイン？それはあまりにも、その"}, {"type": "subtitle", "time": 8293.19, "timestamp": "02:18:13", "text": "自分のリーグ、わかるでしょ、そして私は"}, {"type": "subtitle", "time": 8297.03, "timestamp": "02:18:17", "text": "私のプロ意識の欠如と、えーと"}, {"type": "subtitle", "time": 8300.03, "timestamp": "02:18:20", "text": "私がするバカげたこと、私は"}, {"type": "subtitle", "time": 8303.15, "timestamp": "02:18:23", "text": "まるで"}, {"type": "subtitle", "time": 8305.83, "timestamp": "02:18:25", "text": "プロ。わからない。"}, {"type": "subtitle", "time": 8312.95, "timestamp": "02:18:32", "text": "わからない。でも、でも、でも、あなたは"}, {"type": "subtitle", "time": 8315.75, "timestamp": "02:18:35", "text": "何かセットがあるような気がする"}, {"type": "subtitle", "time": 8318.709, "timestamp": "02:18:38", "text": "人々が期待するリスト"}, {"type": "subtitle", "time": 8321.15, "timestamp": "02:18:41", "text": "彼らが見るとき"}, {"type": "subtitle", "time": 8326.389, "timestamp": "02:18:46", "text": "これは、内容的にも、"}, {"type": "subtitle", "time": 8329.509, "timestamp": "02:18:49", "text": "美的観点から言うと、ストリーム要素"}, {"type": "subtitle", "time": 8333.309, "timestamp": "02:18:53", "text": "すべてそうですよね？背景"}, {"type": "subtitle", "time": 8336.549, "timestamp": "02:18:56", "text": "もの。俺はこう思ったんだ、「おい、どうやって強盗するんだ？」"}, {"type": "subtitle", "time": 8339.509, "timestamp": "02:18:59", "text": "銀行？"}]
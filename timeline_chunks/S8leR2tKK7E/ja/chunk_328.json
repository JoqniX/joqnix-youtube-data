[{"type": "subtitle", "time": 19688.83, "timestamp": "05:28:08", "text": "これはある億万長者のためのものです"}, {"type": "subtitle", "time": 19692.948, "timestamp": "05:28:12", "text": "今。そして、私たちはいくつか必要とします"}, {"type": "subtitle", "time": 19695.51, "timestamp": "05:28:15", "text": "私たちのデジタル技術"}, {"type": "subtitle", "time": 19700.948, "timestamp": "05:28:20", "text": "ミッション用宇宙服。これを買ってもいいですか？"}, {"type": "subtitle", "time": 19703.03, "timestamp": "05:28:23", "text": "そして彼から金儲けをする？私はただ"}, {"type": "subtitle", "time": 19705.27, "timestamp": "05:28:25", "text": "それ。"}, {"type": "subtitle", "time": 19708.15, "timestamp": "05:28:28", "text": "もしかしたら私たちは"}, {"type": "subtitle", "time": 19710.948, "timestamp": "05:28:30", "text": "えっと、ヘルメット。買って作ります"}, {"type": "subtitle", "time": 19712.19, "timestamp": "05:28:32", "text": "割引"}, {"type": "subtitle", "time": 19714.868, "timestamp": "05:28:34", "text": "彼。正直に言うと、それは"}, {"type": "subtitle", "time": 19717.19, "timestamp": "05:28:37", "text": "すべてを買い占めるのは悪い考えで、"}, {"type": "subtitle", "time": 19720.07, "timestamp": "05:28:40", "text": "それらを売っている。そして、私が今やったように、"}, {"type": "subtitle", "time": 19723.51, "timestamp": "05:28:43", "text": "そう、私が全部買ったんだけど、彼は"}, {"type": "subtitle", "time": 19729.43, "timestamp": "05:28:49", "text": "224,373ドル、そう、彼の中に、なぜなら私は"}, {"type": "subtitle", "time": 19732.23, "timestamp": "05:28:52", "text": "全部買いました。でも私はここにいる"}, {"type": "subtitle", "time": 19739.868, "timestamp": "05:28:59", "text": "86,524ドルですよね？それはまずい"}]
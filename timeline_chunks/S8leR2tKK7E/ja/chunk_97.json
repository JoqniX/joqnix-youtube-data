[{"type": "subtitle", "time": 5824.55, "timestamp": "01:37:04", "text": "頑固で、まだここにいる。 Aと私たちは"}, {"type": "subtitle", "time": 5827.03, "timestamp": "01:37:07", "text": "今も話し合っていて、今も協力し合っている"}, {"type": "subtitle", "time": 5830.47, "timestamp": "01:37:10", "text": "今。それは大きなこと、"}, {"type": "subtitle", "time": 5832.149, "timestamp": "01:37:12", "text": "もし私がセレスティアと長く一緒にいたら、"}, {"type": "subtitle", "time": 5833.91, "timestamp": "01:37:13", "text": "今でもあなたが知っているように遊ぶのが大好きです"}, {"type": "subtitle", "time": 5838.87, "timestamp": "01:37:18", "text": "あなたとあなたは愛を知っているあなたとあなたは"}, {"type": "subtitle", "time": 5840.55, "timestamp": "01:37:20", "text": "なぜなら、特定の人々がいるから"}, {"type": "subtitle", "time": 5843.43, "timestamp": "01:37:23", "text": "過去4年間で出会った人たち"}, {"type": "subtitle", "time": 5845.91, "timestamp": "01:37:25", "text": "私が言いたいことは"}, {"type": "subtitle", "time": 5848.149, "timestamp": "01:37:28", "text": "たとえ"}, {"type": "subtitle", "time": 5858.43, "timestamp": "01:37:38", "text": "ああ、なんてことだ、どうすればいいのかわからない"}, {"type": "subtitle", "time": 5865.43, "timestamp": "01:37:45", "text": "[音楽]"}, {"type": "subtitle", "time": 5868.709, "timestamp": "01:37:48", "text": "そして私は気づいた、まるで"}, {"type": "subtitle", "time": 5872.189, "timestamp": "01:37:52", "text": "最初はあまり知らなかったのですが"}, {"type": "subtitle", "time": 5876.629, "timestamp": "01:37:56", "text": "でも、あなたの視点からすると、どうやって"}, {"type": "subtitle", "time": 5879.75, "timestamp": "01:37:59", "text": "私が最初に発見したとき"}]
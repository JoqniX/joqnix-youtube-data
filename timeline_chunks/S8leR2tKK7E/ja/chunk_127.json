[{"type": "subtitle", "time": 7620.709, "timestamp": "02:07:00", "text": "私は新しい人と話すのが好きで、"}, {"type": "subtitle", "time": 7622.229, "timestamp": "02:07:02", "text": "さまざまなタイプの人々と出会い"}, {"type": "subtitle", "time": 7624.55, "timestamp": "02:07:04", "text": "一般的に言って、人によって違う。"}, {"type": "subtitle", "time": 7626.87, "timestamp": "02:07:06", "text": "ええ、私もこれを通して気づきました"}, {"type": "subtitle", "time": 7629.589, "timestamp": "02:07:09", "text": "ジョギングマラソンみたいなもの。私はこういうのが好きです"}, {"type": "subtitle", "time": 7631.669, "timestamp": "02:07:11", "text": "ただ座って話をするだけの環境"}, {"type": "subtitle", "time": 7634.95, "timestamp": "02:07:14", "text": "物事について、そして私は以前は自分が"}, {"type": "subtitle", "time": 7637.91, "timestamp": "02:07:17", "text": "話すのが下手で、"}, {"type": "subtitle", "time": 7639.99, "timestamp": "02:07:19", "text": "チャット配信とか色々やって、今見て"}, {"type": "subtitle", "time": 7643.589, "timestamp": "02:07:23", "text": "私が口を開けて話そうとしているのを見て"}, {"type": "subtitle", "time": 7647.75, "timestamp": "02:07:27", "text": "もっと話題を考え出したり、何か別のことをしたり。"}, {"type": "subtitle", "time": 7649.75, "timestamp": "02:07:29", "text": "私は「うん、本当にたくさんのことがある」と思った。"}, {"type": "subtitle", "time": 7651.83, "timestamp": "02:07:31", "text": "これらの要因がこれに関係する。あなたがしなければならない"}, {"type": "subtitle", "time": 7654.629, "timestamp": "02:07:34", "text": "論文にトピックを書き留めておく"}, {"type": "subtitle", "time": 7657.35, "timestamp": "02:07:37", "text": "あれこれと。そして今私は"}, {"type": "subtitle", "time": 7660.229, "timestamp": "02:07:40", "text": "正直、どうやって行き当たりばったりでやっているのか自分でもよくわからない。"}, {"type": "subtitle", "time": 7663.51, "timestamp": "02:07:43", "text": "うん。必要なのは"}, {"type": "subtitle", "time": 7665.189, "timestamp": "02:07:45", "text": "最初の数回のレイアウト"}, {"type": "subtitle", "time": 7667.27, "timestamp": "02:07:47", "text": "それをやってしばらくすると、自然と身につく"}, {"type": "subtitle", "time": 7669.55, "timestamp": "02:07:49", "text": "自然に排出される。"}, {"type": "subtitle", "time": 7673.069, "timestamp": "02:07:53", "text": "ええ、自然に出てくるんです。はい。"}, {"type": "subtitle", "time": 7678.069, "timestamp": "02:07:58", "text": "はい。それは本当に素晴らしいですね。まるで私が持っていたように"}]
[{"type": "subtitle", "time": 660.67, "timestamp": "00:11:00", "text": "しかし"}, {"type": "subtitle", "time": 663.59, "timestamp": "00:11:03", "text": "えっと、物語を読んで理解して、"}, {"type": "subtitle", "time": 666.03, "timestamp": "00:11:06", "text": "源珍と"}, {"type": "subtitle", "time": 667.63, "timestamp": "00:11:07", "text": "キャラクター。"}, {"type": "subtitle", "time": 675.63, "timestamp": "00:11:15", "text": "うん、そう思う。そして月曜日には、"}, {"type": "subtitle", "time": 679.59, "timestamp": "00:11:19", "text": "火曜日、ああ水曜日、"}, {"type": "subtitle", "time": 683.91, "timestamp": "00:11:23", "text": "いつも通り水曜日に配信します。でもでも"}, {"type": "subtitle", "time": 688.35, "timestamp": "00:11:28", "text": "でも、でも、どこかで配信する予定です"}, {"type": "subtitle", "time": 695.67, "timestamp": "00:11:35", "text": "その日、他には何もなかった。ええと、公式ではないのですが、"}, {"type": "subtitle", "time": 698.55, "timestamp": "00:11:38", "text": "えっと、皆さんの何人かは知っていると思いますが、私は"}, {"type": "subtitle", "time": 701.509, "timestamp": "00:11:41", "text": "つまり、Twitch を利用しているなら、"}, {"type": "subtitle", "time": 702.75, "timestamp": "00:11:42", "text": "誰だか知ってる、"}, {"type": "subtitle", "time": 704.59, "timestamp": "00:11:44", "text": "右？"}, {"type": "subtitle", "time": 707.829, "timestamp": "00:11:47", "text": "Onxonですよね？カワワイの"}, {"type": "subtitle", "time": 711.67, "timestamp": "00:11:51", "text": "カワイイ、私のパートナーは、"}, {"type": "subtitle", "time": 716.63, "timestamp": "00:11:56", "text": "アンダースコア付きのXのチャットで"}, {"type": "subtitle", "time": 718.71, "timestamp": "00:11:58", "text": "誰かがTwitchでXの名前を名乗った"}]
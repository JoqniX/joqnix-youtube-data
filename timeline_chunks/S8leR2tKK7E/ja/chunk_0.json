[{"type": "subtitle", "time": 9.9, "timestamp": "00:00:09", "text": "人々。ええ、私は手を伸ばす"}, {"type": "subtitle", "time": 21.4, "timestamp": "00:00:21", "text": "明日発売。私は行かなければならない"}, {"type": "subtitle", "time": 22.67, "timestamp": "00:00:22", "text": "[音楽]"}, {"type": "subtitle", "time": 28.07, "timestamp": "00:00:28", "text": "ええと、スーツのために。ヒガンに聞くのを忘れた"}, {"type": "subtitle", "time": 30.39, "timestamp": "00:00:30", "text": "撮影のため。スーツが必要ですか？"}, {"type": "subtitle", "time": 33.11, "timestamp": "00:00:33", "text": "とかそういうの？どんなスーツと"}, {"type": "subtitle", "time": 35.35, "timestamp": "00:00:35", "text": "すべて？聞き忘れていました。それは"}, {"type": "subtitle", "time": 37.709, "timestamp": "00:00:37", "text": "わかった。私"}, {"type": "subtitle", "time": 43.51, "timestamp": "00:00:43", "text": "ジョアトン86日目へようこそ"}, {"type": "subtitle", "time": 45.069, "timestamp": "00:00:45", "text": "パート2"}, {"type": "subtitle", "time": 48.15, "timestamp": "00:00:48", "text": "ストリーム。本日のパートナーはセレスティアです"}, {"type": "subtitle", "time": 52.11, "timestamp": "00:00:52", "text": "ヴォイドとPGスモスは息子である。 PG"}, {"type": "subtitle", "time": 55.43, "timestamp": "00:00:55", "text": "息子。 PTSはここに来るはずだった"}]
[{"type": "subtitle", "time": 11889.03, "timestamp": "03:18:09", "text": "自分。企業関連のものは何でも悪い。それが私の"}, {"type": "subtitle", "time": 11890.55, "timestamp": "03:18:10", "text": "時には人に管理してもらうのも良い"}, {"type": "subtitle", "time": 11892.15, "timestamp": "03:18:12", "text": "あなたが建設に集中している間、あなたの持ち物"}, {"type": "subtitle", "time": 11893.95, "timestamp": "03:18:13", "text": "もの。だから、選んで"}, {"type": "subtitle", "time": 11896.389, "timestamp": "03:18:16", "text": "選ぶ。でもあなたは私が持っていると思っているけれど、私は持っていない"}, {"type": "subtitle", "time": 11898.389, "timestamp": "03:18:18", "text": "物事を手伝ってくれる人や管理してくれる人"}, {"type": "subtitle", "time": 11902.429, "timestamp": "03:18:22", "text": "私の持ち物。私はすべて自分でやっています。人々"}, {"type": "subtitle", "time": 11905.15, "timestamp": "03:18:25", "text": "忙しい。けれど。全て"}, {"type": "subtitle", "time": 11908.15, "timestamp": "03:18:28", "text": "右。えっと"}, {"type": "subtitle", "time": 11926.83, "timestamp": "03:18:46", "text": "[音楽]"}]
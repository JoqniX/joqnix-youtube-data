[{"type": "subtitle", "time": 18660.51, "timestamp": "05:11:00", "text": "えーと"}, {"type": "subtitle", "time": 18664.55, "timestamp": "05:11:04", "text": "鉄。鉄を引っ張る奴らは、"}, {"type": "subtitle", "time": 18666.07, "timestamp": "05:11:06", "text": "引く"}, {"type": "subtitle", "time": 18669.43, "timestamp": "05:11:09", "text": "ええと、アルミニウム。だから私は基本的な農場をやっている"}, {"type": "subtitle", "time": 18672.708, "timestamp": "05:11:12", "text": "こちらです。アルミニウムと鉄の農場。私"}, {"type": "subtitle", "time": 18673.788, "timestamp": "05:11:13", "text": "私の"}, {"type": "subtitle", "time": 18677.19, "timestamp": "05:11:17", "text": "宇宙船と、私は文字通りサラを持っています"}, {"type": "subtitle", "time": 18679.628, "timestamp": "05:11:19", "text": "そちら側。私は文字通りベンを全部持っています"}, {"type": "subtitle", "time": 18682.03, "timestamp": "05:11:22", "text": "ワークベネスラボと"}, {"type": "subtitle", "time": 18684.59, "timestamp": "05:11:24", "text": "すべて。そうそう。うん。"}, {"type": "subtitle", "time": 18693.07, "timestamp": "05:11:33", "text": "方法？ああ、私は"}, {"type": "subtitle", "time": 18696.51, "timestamp": "05:11:36", "text": "ここ。がある"}, {"type": "subtitle", "time": 18698.35, "timestamp": "05:11:38", "text": "自分。しかし"}, {"type": "subtitle", "time": 18702.23, "timestamp": "05:11:42", "text": "ええ、ベッドはありますよ。両面ベッド。"}, {"type": "subtitle", "time": 18706.91, "timestamp": "05:11:46", "text": "私たち二人で使うのにベッドが2つ必要です。だから、彼女も"}, {"type": "subtitle", "time": 18710.788, "timestamp": "05:11:50", "text": "寝る。私は文字通りこれをやっています。やって来る"}, {"type": "subtitle", "time": 18714.39, "timestamp": "05:11:54", "text": "ここ。アルミニウムの純度が999だってわかるでしょ？私"}, {"type": "subtitle", "time": 18716.628, "timestamp": "05:11:56", "text": "こっちに来て。いや、いや、いや。そうしなければならなかった"}, {"type": "subtitle", "time": 18718.07, "timestamp": "05:11:58", "text": "まずは寝る。待って、待って、待って、待って。"}]
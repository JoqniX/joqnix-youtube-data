[{"type": "subtitle", "time": 16026.269, "timestamp": "04:27:06", "text": "人々。"}, {"type": "subtitle", "time": 16058.11, "timestamp": "04:27:38", "text": "えっと、誰か教えてください"}, {"type": "subtitle", "time": 16060.71, "timestamp": "04:27:40", "text": "利用可能。利用可能。"}, {"type": "subtitle", "time": 16065.189, "timestamp": "04:27:45", "text": "今週か来週に。私には時間がある"}, {"type": "subtitle", "time": 16066.91, "timestamp": "04:27:46", "text": "まで"}, {"type": "subtitle", "time": 16070.51, "timestamp": "04:27:50", "text": "21日最善を尽くします"}, {"type": "subtitle", "time": 16073.95, "timestamp": "04:27:53", "text": "置くために"}, {"type": "subtitle", "time": 16078.429, "timestamp": "04:27:58", "text": "少なくとも1つ予約する"}]
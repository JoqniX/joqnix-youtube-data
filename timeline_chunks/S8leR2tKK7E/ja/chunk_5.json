[{"type": "subtitle", "time": 300.31, "timestamp": "00:05:00", "text": "ああ、それは私のビジュアライザーです。はい、同じです"}, {"type": "subtitle", "time": 303.11, "timestamp": "00:05:03", "text": "あれがまた再生されてた。あなたの"}, {"type": "subtitle", "time": 312.31, "timestamp": "00:05:12", "text": "けれど。私の声だけで十分です。つまり"}, {"type": "subtitle", "time": 314.87, "timestamp": "00:05:14", "text": "しかし私は孤立と自立は"}, {"type": "subtitle", "time": 317.909, "timestamp": "00:05:17", "text": "異なるウォームアップは異なるウォームアップです"}, {"type": "subtitle", "time": 321.71, "timestamp": "00:05:21", "text": "心を込めて。"}, {"type": "subtitle", "time": 326.39, "timestamp": "00:05:26", "text": "うん。でも今はそうですね。温かい感じがする"}, {"type": "subtitle", "time": 329.35, "timestamp": "00:05:29", "text": "昔の自分と今の自分を見比べてみる"}, {"type": "subtitle", "time": 333.189, "timestamp": "00:05:33", "text": "昔の自分を知っているように、今の私は今の私です。"}, {"type": "subtitle", "time": 334.35, "timestamp": "00:05:34", "text": "私は感じる"}, {"type": "subtitle", "time": 336.67, "timestamp": "00:05:36", "text": "とても暖かい"}, {"type": "subtitle", "time": 339.629, "timestamp": "00:05:39", "text": "そして快適で"}, {"type": "subtitle", "time": 344.87, "timestamp": "00:05:44", "text": "周りの人たちが安全だと感じる"}, {"type": "subtitle", "time": 348.55, "timestamp": "00:05:48", "text": "安心感"}, {"type": "subtitle", "time": 351.71, "timestamp": "00:05:51", "text": "えっと、あなたと一緒にいると家族みたいに感じる"}, {"type": "subtitle", "time": 357.99, "timestamp": "00:05:57", "text": "男たち、もしくはオニキスギャングの全員。"}]
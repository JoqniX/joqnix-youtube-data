[{"type": "subtitle", "time": 722.71, "timestamp": "00:12:02", "text": "ぶん殴って殺したい"}, {"type": "subtitle", "time": 725.87, "timestamp": "00:12:05", "text": "でも私は渡さなければならなかった"}, {"type": "subtitle", "time": 729.67, "timestamp": "00:12:09", "text": "アンダースコア それは私にあの時のことを思い出させる"}, {"type": "subtitle", "time": 733.15, "timestamp": "00:12:13", "text": "知らない人のために"}, {"type": "subtitle", "time": 738.55, "timestamp": "00:12:18", "text": "以前以前以前私はTwitchで"}, {"type": "subtitle", "time": 740.91, "timestamp": "00:12:20", "text": "先週起こった出来事"}, {"type": "subtitle", "time": 745.069, "timestamp": "00:12:25", "text": "昨年、昨年、または"}, {"type": "subtitle", "time": 749.75, "timestamp": "00:12:29", "text": "何か。私は、それを何と呼ぶのですか？"}, {"type": "subtitle", "time": 752.87, "timestamp": "00:12:32", "text": "YouTubeで名前を変更しなければならなかった、"}, {"type": "subtitle", "time": 756.269, "timestamp": "00:12:36", "text": "YouTubeのユーザー名を何かに"}, {"type": "subtitle", "time": 759.069, "timestamp": "00:12:39", "text": "それ以外。それは"}, {"type": "subtitle", "time": 762.949, "timestamp": "00:12:42", "text": "えっと、なんて言うんでしたっけ？うん、何か"}, {"type": "subtitle", "time": 767.11, "timestamp": "00:12:47", "text": "ああ、あの頃、私に本当にひどいことが起こった"}, {"type": "subtitle", "time": 769.829, "timestamp": "00:12:49", "text": "Twitch で私が始めた頃は"}, {"type": "subtitle", "time": 773.509, "timestamp": "00:12:53", "text": "V2とかにハマる前の話です。だからその後"}, {"type": "subtitle", "time": 776.949, "timestamp": "00:12:56", "text": "何が起こったのか、すべての憎悪率"}]
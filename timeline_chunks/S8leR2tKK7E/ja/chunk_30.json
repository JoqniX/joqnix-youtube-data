[{"type": "subtitle", "time": 1800.11, "timestamp": "00:30:00", "text": "うん、"}, {"type": "subtitle", "time": 1803.669, "timestamp": "00:30:03", "text": "つまり、今日来るということは"}, {"type": "subtitle", "time": 1807.19, "timestamp": "00:30:07", "text": "本当に大きな意味があり、すべての人々"}, {"type": "subtitle", "time": 1816.11, "timestamp": "00:30:16", "text": "今日、ハニーストリーム ニシャド"}, {"type": "subtitle", "time": 1821.11, "timestamp": "00:30:21", "text": "アカブン、それからPがここにいた。それから"}, {"type": "subtitle", "time": 1822.909, "timestamp": "00:30:22", "text": "他に誰が"}, {"type": "subtitle", "time": 1827.59, "timestamp": "00:30:27", "text": "ここ？ああ、あのヴィクターの息子もここにいたのか。それから"}, {"type": "subtitle", "time": 1829.99, "timestamp": "00:30:29", "text": "それからそれからそれから"}, {"type": "subtitle", "time": 1839.23, "timestamp": "00:30:39", "text": "ここ。うん。そしてロクンは"}, {"type": "subtitle", "time": 1842.389, "timestamp": "00:30:42", "text": "ここ。では、他に誰がそこにいたのでしょうか？私は"}, {"type": "subtitle", "time": 1845.669, "timestamp": "00:30:45", "text": "誰か恋しい人いますか？そして、一緒にいる新しい人"}, {"type": "chat", "time": 1846.192, "timestamp": "00:30:46", "author": "@wildan19gta73", "avatar": "https://yt4.ggpht.com/ytc/AIdro_ltgSuqdkVmFy7b8YNX34dHb6whG0lODXr6m68zEAgk=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ8_8KpS3_9EP-duW6QoUCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ8_8KpS3_9EP-duW6QoUCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ8_8KpS3_9EP-duW6QoUCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ8_8KpS3_9EP-duW6QoUCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ8_8KpS3_9EP-duW6QoUCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ8_8KpS3_9EP-duW6Qo"}, {"type": "subtitle", "time": 1851.47, "timestamp": "00:30:51", "text": "レオニアン"}, {"type": "subtitle", "time": 1854.43, "timestamp": "00:30:54", "text": "ハーが来る。本当にそう思うよ。それは、"}, {"type": "subtitle", "time": 1855.95, "timestamp": "00:30:55", "text": "多く。"}]
[{"type": "subtitle", "time": 18241.19, "timestamp": "05:04:01", "text": "とても素晴らしい。"}, {"type": "subtitle", "time": 18261.47, "timestamp": "05:04:21", "text": "はい、それでは早速"}, {"type": "subtitle", "time": 18263.23, "timestamp": "05:04:23", "text": "ああ、そうだった"}, {"type": "subtitle", "time": 18266.948, "timestamp": "05:04:26", "text": "私は何かした？待って、なぜ"}, {"type": "subtitle", "time": 18269.91, "timestamp": "05:04:29", "text": "空白？"}, {"type": "subtitle", "time": 18273.11, "timestamp": "05:04:33", "text": "ああ、わかりました。あれは怖かった。わかった。私は"}, {"type": "subtitle", "time": 18277.708, "timestamp": "05:04:37", "text": "「え？どうして画面が真っ暗になったの？」みたいな感じ。はぁ？"}, {"type": "subtitle", "time": 18284.788, "timestamp": "05:04:44", "text": "はぁ？モー。わかった。もうすぐ終わります"}, {"type": "subtitle", "time": 18287.788, "timestamp": "05:04:47", "text": "もの。本当に申し訳ないです"}]
[{"type": "subtitle", "time": 5640.709, "timestamp": "01:34:00", "text": "「そうするよ。」それが私のやり方です。"}, {"type": "subtitle", "time": 5644.629, "timestamp": "01:34:04", "text": "それはとてもクレイジーだと思います、なぜなら私の"}, {"type": "subtitle", "time": 5647.27, "timestamp": "01:34:07", "text": "イギリスのアプリケーションのようなものは、"}, {"type": "subtitle", "time": 5649.99, "timestamp": "01:34:09", "text": "全く違う。応募したように"}, {"type": "subtitle", "time": 5651.27, "timestamp": "01:34:11", "text": "6つの学校は、私が望まなかったからです"}, {"type": "subtitle", "time": 5654.629, "timestamp": "01:34:14", "text": "やり過ぎて、4つに合格した"}, {"type": "subtitle", "time": 5657.03, "timestamp": "01:34:17", "text": "彼らのうちの。そのうちの一人からは返事がなかった。"}, {"type": "subtitle", "time": 5659.03, "timestamp": "01:34:19", "text": "そしてそのうちの1つが却下されたのですが、"}, {"type": "subtitle", "time": 5661.75, "timestamp": "01:34:21", "text": "大丈夫。でもそれは主にあなたの"}, {"type": "subtitle", "time": 5664.31, "timestamp": "01:34:24", "text": "SOP としてご存知のように、"}, {"type": "subtitle", "time": 5667.189, "timestamp": "01:34:27", "text": "あなたが取り組むことに興味があり、どのように"}, {"type": "subtitle", "time": 5670.149, "timestamp": "01:34:30", "text": "あなたも貢献できます。あなたのエッセイ"}, {"type": "subtitle", "time": 5672.87, "timestamp": "01:34:32", "text": "まるであなたの全体みたいになる、何て言うの？"}, {"type": "chat", "time": 5673.193, "timestamp": "01:34:33", "author": "@dazai8348", "avatar": "https://yt4.ggpht.com/FGjFKkkvDG7xMdh4VOSW06NFnlL3RtbXADws9FQ96lGBLjUzBj_TIiBpeB9bTGrr7SrbCgomrg=s64-c-k-c0x00ffffff-no-rj", "message": "i see"}, {"type": "subtitle", "time": 5675.03, "timestamp": "01:34:35", "text": "あなたがどんな学生であるかを反映している"}, {"type": "subtitle", "time": 5677.43, "timestamp": "01:34:37", "text": "あなたがなりたい人物であり、"}, {"type": "subtitle", "time": 5680.47, "timestamp": "01:34:40", "text": "あなたの能力と私は考えていました"}, {"type": "subtitle", "time": 5682.47, "timestamp": "01:34:42", "text": "インタビューを受けたいかどうか"}, {"type": "subtitle", "time": 5685.189, "timestamp": "01:34:45", "text": "あるいは何かだったけど、私はそうしなかったし、それは"}, {"type": "subtitle", "time": 5688.229, "timestamp": "01:34:48", "text": "なんて言えばいいかな、大きな変化"}, {"type": "subtitle", "time": 5691.03, "timestamp": "01:34:51", "text": "インドの学校から、"}, {"type": "subtitle", "time": 5693.11, "timestamp": "01:34:53", "text": "アプリケーションがあって、"}, {"type": "subtitle", "time": 5694.55, "timestamp": "01:34:54", "text": "書いたか好きかどちらか"}, {"type": "subtitle", "time": 5696.79, "timestamp": "01:34:56", "text": "面接または両方に合格する必要があります"}, {"type": "subtitle", "time": 5698.629, "timestamp": "01:34:58", "text": "それと、それから行かないといけない"}]
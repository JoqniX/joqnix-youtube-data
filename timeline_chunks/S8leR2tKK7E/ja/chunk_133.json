[{"type": "subtitle", "time": 7980.31, "timestamp": "02:13:00", "text": "人々はそれを探しているが、私は"}, {"type": "subtitle", "time": 7982.069, "timestamp": "02:13:02", "text": "私は特に私の"}, {"type": "subtitle", "time": 7983.91, "timestamp": "02:13:03", "text": "私がそのようなものを提供できる人生"}, {"type": "subtitle", "time": 7986.47, "timestamp": "02:13:06", "text": "新しい人にもサービスを提供したり、投資したり"}, {"type": "subtitle", "time": 7989.99, "timestamp": "02:13:09", "text": "そんなにエネルギーが必要なのは、"}, {"type": "subtitle", "time": 8004.27, "timestamp": "02:13:24", "text": "いいえ、あなたはまだセレスティアです"}, {"type": "subtitle", "time": 8007.75, "timestamp": "02:13:27", "text": "男の子。ところで、セレスティアの年齢は分かりますか？"}, {"type": "subtitle", "time": 8010.31, "timestamp": "02:13:30", "text": "忘れた。あなたは年齢を感じない人だと思っていました"}, {"type": "subtitle", "time": 8012.229, "timestamp": "02:13:32", "text": "私のような。"}, {"type": "subtitle", "time": 8014.629, "timestamp": "02:13:34", "text": "ええ、まあ、そんな感じです。あなたは好きになれる"}, {"type": "subtitle", "time": 8018.149, "timestamp": "02:13:38", "text": "私を年齢不詳だと思ってください。わーい。"}, {"type": "subtitle", "time": 8031.43, "timestamp": "02:13:51", "text": "楽しい。そうそう、ああ、私はあなたを送ったわけではありません。これ"}, {"type": "subtitle", "time": 8034.35, "timestamp": "02:13:54", "text": "それが問題なんです。私は気にしない"}, {"type": "subtitle", "time": 8038.51, "timestamp": "02:13:58", "text": "共有。私は、あなたがすでに示していると思います"}]
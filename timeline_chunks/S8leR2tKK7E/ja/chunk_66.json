[{"type": "subtitle", "time": 3961.109, "timestamp": "01:06:01", "text": "[音楽]"}, {"type": "subtitle", "time": 3965.029, "timestamp": "01:06:05", "text": "それはすごいことだ。何てことだ。"}, {"type": "subtitle", "time": 3974.71, "timestamp": "01:06:14", "text": "でも、もしあなたが"}, {"type": "subtitle", "time": 3976.63, "timestamp": "01:06:16", "text": "周りに人がいるか、いない場合"}, {"type": "subtitle", "time": 3979.99, "timestamp": "01:06:19", "text": "人に助けを求めるのが怖いので、"}, {"type": "subtitle", "time": 3983.349, "timestamp": "01:06:23", "text": "大丈夫だと思うよ。なぜなら私は"}, {"type": "subtitle", "time": 3985.349, "timestamp": "01:06:25", "text": "こう言おう、重要なことの一つは"}, {"type": "subtitle", "time": 3987.19, "timestamp": "01:06:27", "text": "スコットランドで私にとって楽になったのは"}, {"type": "subtitle", "time": 3988.87, "timestamp": "01:06:28", "text": "ほら、たくさんの人が"}, {"type": "subtitle", "time": 3991.51, "timestamp": "01:06:31", "text": "とても役に立ちます。たとえ私が"}, {"type": "subtitle", "time": 3992.95, "timestamp": "01:06:32", "text": "食料品の買い物に行き、"}, {"type": "subtitle", "time": 3994.95, "timestamp": "01:06:34", "text": "すべて、すべての雇用主は"}, {"type": "subtitle", "time": 3997.67, "timestamp": "01:06:37", "text": "彼らは私が"}, {"type": "subtitle", "time": 3999.75, "timestamp": "01:06:39", "text": "ほら、新しい人みたいに"}, {"type": "subtitle", "time": 4001.91, "timestamp": "01:06:41", "text": "この国。"}, {"type": "subtitle", "time": 4004.63, "timestamp": "01:06:44", "text": "しかし、あなたも間違いを犯すでしょう"}, {"type": "subtitle", "time": 4006.63, "timestamp": "01:06:46", "text": "それは避けられない。しかし、あなたは学ぶことも"}, {"type": "subtitle", "time": 4008.39, "timestamp": "01:06:48", "text": "そこから。"}, {"type": "subtitle", "time": 4010.789, "timestamp": "01:06:50", "text": "うん。"}, {"type": "subtitle", "time": 4015.71, "timestamp": "01:06:55", "text": "えっと、どうやって"}, {"type": "subtitle", "time": 4019.349, "timestamp": "01:06:59", "text": "あなたはそこに何年間いましたか？"}]
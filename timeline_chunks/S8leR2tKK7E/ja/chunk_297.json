[{"type": "subtitle", "time": 17825.43, "timestamp": "04:57:05", "text": "Starfieldをプレイしてからずいぶん経つ。それで"}, {"type": "subtitle", "time": 17828.948, "timestamp": "04:57:08", "text": "楽しみにしています"}, {"type": "subtitle", "time": 17832.15, "timestamp": "04:57:12", "text": "えっと、このゲームをプレイするために。そして皆さんの多くは"}, {"type": "subtitle", "time": 17833.99, "timestamp": "04:57:13", "text": "あなたが"}, {"type": "subtitle", "time": 17836.11, "timestamp": "04:57:16", "text": "私をフォローしています。"}, {"type": "subtitle", "time": 17839.868, "timestamp": "04:57:19", "text": "えっと、もしあなたが私をフォローしているなら"}, {"type": "subtitle", "time": 17843.39, "timestamp": "04:57:23", "text": "最後の 2 つのストリームでは"}, {"type": "subtitle", "time": 17847.11, "timestamp": "04:57:27", "text": "スターフィールド、私は実際に"}, {"type": "subtitle", "time": 17851.11, "timestamp": "04:57:31", "text": "70～80以上。80を超えたと思う。"}, {"type": "subtitle", "time": 17854.19, "timestamp": "04:57:34", "text": "わからない。 80以上、レベル80または"}, {"type": "subtitle", "time": 17857.35, "timestamp": "04:57:37", "text": "何か。うん。うん。うん。私は到達しました"}, {"type": "subtitle", "time": 17860.55, "timestamp": "04:57:40", "text": "レベル80くらいかな。ええと、スターフィールドで。"}, {"type": "subtitle", "time": 17861.55, "timestamp": "04:57:41", "text": "私"}, {"type": "subtitle", "time": 17863.07, "timestamp": "04:57:43", "text": "挽いた"}, {"type": "subtitle", "time": 17865.91, "timestamp": "04:57:45", "text": "時間。メインクエストは何もやらなかったし、"}, {"type": "subtitle", "time": 17868.39, "timestamp": "04:57:48", "text": "ソルクエストをやりたかったから、全部やったんだ"}, {"type": "subtitle", "time": 17873.51, "timestamp": "04:57:53", "text": "配信中だけど、頑張ってお金を稼いだよ"}, {"type": "subtitle", "time": 17875.67, "timestamp": "04:57:55", "text": "スキルポイントを稼ぎ、"}, {"type": "subtitle", "time": 17877.788, "timestamp": "04:57:57", "text": "農業関連、"}, {"type": "subtitle", "time": 17879.948, "timestamp": "04:57:59", "text": "すべて。推測"}]
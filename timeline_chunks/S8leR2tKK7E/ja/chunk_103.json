[{"type": "subtitle", "time": 6182.109, "timestamp": "01:43:02", "text": "ここら辺らで拒否されている"}, {"type": "subtitle", "time": 6184.95, "timestamp": "01:43:04", "text": "トラウマになるのではなく、"}, {"type": "subtitle", "time": 6188.47, "timestamp": "01:43:08", "text": "私は徐々に、より"}, {"type": "subtitle", "time": 6190.95, "timestamp": "01:43:10", "text": "自信を持って、まだ連絡を取って"}, {"type": "subtitle", "time": 6193.59, "timestamp": "01:43:13", "text": "人々は、今でも人々と話をする。私は思う"}, {"type": "subtitle", "time": 6195.59, "timestamp": "01:43:15", "text": "それは私が学んだ良いことです"}, {"type": "subtitle", "time": 6197.59, "timestamp": "01:43:17", "text": "このスポーツ大会。良いものは何ですか"}, {"type": "subtitle", "time": 6200.35, "timestamp": "01:43:20", "text": "もの？それはとても素晴らしいことです"}, {"type": "subtitle", "time": 6203.59, "timestamp": "01:43:23", "text": "拒絶に直面することは避けられない"}, {"type": "subtitle", "time": 6205.43, "timestamp": "01:43:25", "text": "大きな"}, {"type": "subtitle", "time": 6207.51, "timestamp": "01:43:27", "text": "人々の集まり。常に存在する"}, {"type": "subtitle", "time": 6209.43, "timestamp": "01:43:29", "text": "あなたを拒絶する人やあなたを好きな人は、"}, {"type": "subtitle", "time": 6212.629, "timestamp": "01:43:32", "text": "あなたには同意できません。でも、それは"}, {"type": "subtitle", "time": 6214.55, "timestamp": "01:43:34", "text": "ある種の拒絶療法のようなものでもある。"}, {"type": "subtitle", "time": 6216.31, "timestamp": "01:43:36", "text": "それって聞いたことありますか？のように"}, {"type": "subtitle", "time": 6218.07, "timestamp": "01:43:38", "text": "適当な人に近づいて"}, {"type": "subtitle", "time": 6220.07, "timestamp": "01:43:40", "text": "心に浮かんだことは何でも質問してください。の"}, {"type": "subtitle", "time": 6221.83, "timestamp": "01:43:41", "text": "最悪の場合でも「ノー」と言われるだけだ。彼らはそうではない"}, {"type": "subtitle", "time": 6224.39, "timestamp": "01:43:44", "text": "何を言うべきか好きになるだろう"}, {"type": "subtitle", "time": 6226.709, "timestamp": "01:43:46", "text": "画面が叫んでいるように、あるいはあなたが知っているように"}, {"type": "subtitle", "time": 6229.75, "timestamp": "01:43:49", "text": "首を絞めたり、その他何でも。そしてもしあなたが望むなら"}, {"type": "subtitle", "time": 6231.59, "timestamp": "01:43:51", "text": "あなたは彼らとまだ交流することができます。そしてもし"}, {"type": "subtitle", "time": 6232.79, "timestamp": "01:43:52", "text": "したくないなら、しなくてもいい"}, {"type": "subtitle", "time": 6234.629, "timestamp": "01:43:54", "text": "これは彼らと交流することなので"}, {"type": "subtitle", "time": 6237.51, "timestamp": "01:43:57", "text": "会ったことのない人"}, {"type": "subtitle", "time": 6239.43, "timestamp": "01:43:59", "text": "物理的に、またはあなたの"}]
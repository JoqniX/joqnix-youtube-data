[{"type": "subtitle", "time": 8341.03, "timestamp": "02:19:01", "text": "彼らは言った、「でもそれは最も"}, {"type": "subtitle", "time": 8343.469, "timestamp": "02:19:03", "text": "ストレスの多い部分、例えば、"}, {"type": "subtitle", "time": 8346.27, "timestamp": "02:19:06", "text": "シーンと背景音楽と"}, {"type": "subtitle", "time": 8348.629, "timestamp": "02:19:08", "text": "要素。それは私をよりストレスにさせた"}, {"type": "subtitle", "time": 8351.509, "timestamp": "02:19:11", "text": "例えば、新しいモデルを使うとか"}, {"type": "subtitle", "time": 8354.629, "timestamp": "02:19:14", "text": "それ自体で。」ええ、つまり、私にとってはそれでいいんです。"}, {"type": "subtitle", "time": 8358.309, "timestamp": "02:19:18", "text": "でも、依頼を受ける方が近いかな"}, {"type": "subtitle", "time": 8362.389, "timestamp": "02:19:22", "text": "それらの資産のための人々、それは"}, {"type": "subtitle", "time": 8365.509, "timestamp": "02:19:25", "text": "同等の品質で"}, {"type": "subtitle", "time": 8368.87, "timestamp": "02:19:28", "text": "モデル。いいえ。そうしないと不自然に見えるか、"}, {"type": "subtitle", "time": 8371.75, "timestamp": "02:19:31", "text": "何かあるよね？気づいたことはありますか？"}, {"type": "subtitle", "time": 8374.87, "timestamp": "02:19:34", "text": "そういう問題ですか？"}, {"type": "subtitle", "time": 8378.23, "timestamp": "02:19:38", "text": "個人的には好きになる必要はない"}, {"type": "subtitle", "time": 8380.79, "timestamp": "02:19:40", "text": "それについてあまり心配しすぎないでください。しかし、"}, {"type": "subtitle", "time": 8383.19, "timestamp": "02:19:43", "text": "独立系ビデオ、確かに"}, {"type": "subtitle", "time": 8385.83, "timestamp": "02:19:45", "text": "問題は、私が多くのものを見てきたからです"}, {"type": "subtitle", "time": 8387.75, "timestamp": "02:19:47", "text": "彼らの詳細な設定について"}, {"type": "subtitle", "time": 8390.349, "timestamp": "02:19:50", "text": "資産全体のようなもの、そして、"}, {"type": "subtitle", "time": 8392.71, "timestamp": "02:19:52", "text": "シーンや、どのように複雑で"}, {"type": "subtitle", "time": 8394.389, "timestamp": "02:19:54", "text": "ストレスになるのは、時々"}, {"type": "subtitle", "time": 8396.87, "timestamp": "02:19:56", "text": "無料のものはあまり好きではないかもしれない"}, {"type": "subtitle", "time": 8399.429, "timestamp": "02:19:59", "text": "美的だが、良いが、"}]
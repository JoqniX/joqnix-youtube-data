[{"type": "subtitle", "time": 3495.23, "timestamp": "00:58:15", "text": "これは"}, {"type": "subtitle", "time": 3502.75, "timestamp": "00:58:22", "text": "[音楽]"}, {"type": "subtitle", "time": 3518.79, "timestamp": "00:58:38", "text": "それ。よし、じゃあ最初のやつをやろう。それは"}, {"type": "subtitle", "time": 3520.15, "timestamp": "00:58:40", "text": "[音楽]"}, {"type": "subtitle", "time": 3521.23, "timestamp": "00:58:41", "text": "さあ"}, {"type": "subtitle", "time": 3525.15, "timestamp": "00:58:45", "text": "実際にオーディオ設定を少し修正します"}, {"type": "subtitle", "time": 3528.349, "timestamp": "00:58:48", "text": "すごくうるさいから急いで"}, {"type": "subtitle", "time": 3537.47, "timestamp": "00:58:57", "text": "死にかけている。置くよ"}, {"type": "subtitle", "time": 3539.63, "timestamp": "00:58:59", "text": "20インチ"}]
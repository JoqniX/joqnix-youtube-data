[{"type": "subtitle", "time": 13447.59, "timestamp": "03:44:07", "text": "私は、ある意味で謝罪したいのですが"}, {"type": "subtitle", "time": 13454.349, "timestamp": "03:44:14", "text": "えっと、私は"}, {"type": "subtitle", "time": 13457.349, "timestamp": "03:44:17", "text": "私にとっては少し難しかったと思います"}, {"type": "subtitle", "time": 13460.389, "timestamp": "03:44:20", "text": "自分の感情をコントロールするために、"}, {"type": "subtitle", "time": 13462.189, "timestamp": "03:44:22", "text": "私は脆弱な立場にいる"}, {"type": "subtitle", "time": 13467.349, "timestamp": "03:44:27", "text": "なぜなら、私は知っていたからです。"}, {"type": "subtitle", "time": 13470.429, "timestamp": "03:44:30", "text": "このようなことは指摘されるだろう"}, {"type": "subtitle", "time": 13474.389, "timestamp": "03:44:34", "text": "上に、しかし、呼ばれたり、言われたり"}]
[{"type": "subtitle", "time": 13740.63, "timestamp": "03:49:00", "text": "この状況では、私には何もできません。私は持っている"}, {"type": "subtitle", "time": 13744.75, "timestamp": "03:49:04", "text": "ヨアトンのことを心配してそれを終わらせる"}, {"type": "subtitle", "time": 13746.75, "timestamp": "03:49:06", "text": "オフ。私は持っている"}, {"type": "subtitle", "time": 13750.67, "timestamp": "03:49:10", "text": "次に日本に無事着陸する"}, {"type": "subtitle", "time": 13755.349, "timestamp": "03:49:15", "text": "1ヶ月かけて、何とか落ち着く、ノートパソコンを手に入れるなど。"}, {"type": "subtitle", "time": 13757.429, "timestamp": "03:49:17", "text": "そうすれば、私はこれらのことを心配することができます"}, {"type": "subtitle", "time": 13760.309, "timestamp": "03:49:20", "text": "未来のこと。"}]
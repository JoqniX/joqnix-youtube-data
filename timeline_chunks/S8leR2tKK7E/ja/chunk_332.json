[{"type": "subtitle", "time": 19921.35, "timestamp": "05:32:01", "text": "なぜ眉毛はあんな風に動くのですか？"}, {"type": "subtitle", "time": 19923.75, "timestamp": "05:32:03", "text": "待って、私、気付かなかった。待って、"}, {"type": "subtitle", "time": 19933.27, "timestamp": "05:32:13", "text": "ねえ、何か持ってる？もしあなたが探しているなら"}, {"type": "subtitle", "time": 19935.83, "timestamp": "05:32:15", "text": "取引についてなら、喜んでお手伝いします。"}, {"type": "subtitle", "time": 19937.708, "timestamp": "05:32:17", "text": "そういう意味だったんですね。わかった。"}, {"type": "subtitle", "time": 19940.788, "timestamp": "05:32:20", "text": "わかった。わかった。彼の在庫はそれほど"}, {"type": "subtitle", "time": 19943.19, "timestamp": "05:32:23", "text": "完全にリセットされました。大丈夫。リソース"}, {"type": "subtitle", "time": 19946.31, "timestamp": "05:32:26", "text": "フレームに合わせて、そのまま被せます"}, {"type": "subtitle", "time": 19948.51, "timestamp": "05:32:28", "text": "23"}, {"type": "subtitle", "time": 19950.948, "timestamp": "05:32:30", "text": "24,000。あれはこっちです。下げてみます"}, {"type": "subtitle", "time": 19952.35, "timestamp": "05:32:32", "text": "の"}, {"type": "subtitle", "time": 19956.19, "timestamp": "05:32:36", "text": "量と文字通り彼を引き裂く"}, {"type": "subtitle", "time": 19960.39, "timestamp": "05:32:40", "text": "オフ。彼をゼロモードにさせるように。 70."}, {"type": "subtitle", "time": 19963.51, "timestamp": "05:32:43", "text": "彼に1つだけあげよう"}, {"type": "subtitle", "time": 19967.27, "timestamp": "05:32:47", "text": "クレジット。うん。さて、あなたはどうしますか？取る"}, {"type": "subtitle", "time": 19969.19, "timestamp": "05:32:49", "text": "ケア。自分。これでお金は戻ってきましたね。"}, {"type": "subtitle", "time": 19972.99, "timestamp": "05:32:52", "text": "文字通り座るだけです"}, {"type": "subtitle", "time": 19975.67, "timestamp": "05:32:55", "text": "わかりました。椅子はどこだっけ？それは"}, {"type": "subtitle", "time": 19977.708, "timestamp": "05:32:57", "text": "こんにちはではありません。どこにあるの"}]
[{"type": "subtitle", "time": 16141.87, "timestamp": "04:29:01", "text": "これについて"}, {"type": "subtitle", "time": 16144.189, "timestamp": "04:29:04", "text": "来る"}, {"type": "subtitle", "time": 16151.99, "timestamp": "04:29:11", "text": "カバー。えっと"}, {"type": "subtitle", "time": 16154.429, "timestamp": "04:29:14", "text": "えっと、私は"}, {"type": "subtitle", "time": 16164.67, "timestamp": "04:29:24", "text": "同じ"}, {"type": "subtitle", "time": 16169.59, "timestamp": "04:29:29", "text": "スロットですが、"}, {"type": "subtitle", "time": 16173.63, "timestamp": "04:29:33", "text": "うーん、間に合わないかもしれない。"}, {"type": "subtitle", "time": 16178.349, "timestamp": "04:29:38", "text": "もしそれがあなたにとって都合が良いなら、"}, {"type": "subtitle", "time": 16181.71, "timestamp": "04:29:41", "text": "それだけです。"}, {"type": "subtitle", "time": 16186.55, "timestamp": "04:29:46", "text": "あなた。何も予定がない場合"}, {"type": "subtitle", "time": 16195.71, "timestamp": "04:29:55", "text": "日。ああ、ちょっと待って。 6月11日"}, {"type": "subtitle", "time": 16198.91, "timestamp": "04:29:58", "text": "ああ、6月11日か"}]
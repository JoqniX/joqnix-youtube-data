[{"type": "subtitle", "time": 18609.03, "timestamp": "05:10:09", "text": "私はあなたが到達できるように一生懸命努力しました"}, {"type": "subtitle", "time": 18610.67, "timestamp": "05:10:10", "text": "レベル"}, {"type": "subtitle", "time": 18615.55, "timestamp": "05:10:15", "text": "479. 私の秘密を知りたいですか？ウィンク"}, {"type": "subtitle", "time": 18621.948, "timestamp": "05:10:21", "text": "秘密？できる"}, {"type": "subtitle", "time": 18625.27, "timestamp": "05:10:25", "text": "私？知りたいですか？うん。だから、それらは"}, {"type": "subtitle", "time": 18628.628, "timestamp": "05:10:28", "text": "私の赤ちゃんたちです。ご覧のとおり、"}, {"type": "subtitle", "time": 18631.15, "timestamp": "05:10:31", "text": "胸を上にして"}, {"type": "subtitle", "time": 18633.83, "timestamp": "05:10:33", "text": "ほら、あそこの宝箱、"}, {"type": "subtitle", "time": 18635.51, "timestamp": "05:10:35", "text": "私の赤ちゃんたちです。私の健康は気にしないでください"}, {"type": "subtitle", "time": 18638.07, "timestamp": "05:10:38", "text": "ゼロにするのは、私が超スーパーだから"}, {"type": "subtitle", "time": 18641.99, "timestamp": "05:10:41", "text": "過度に負担がかかっている。だから、これらは"}, {"type": "subtitle", "time": 18645.35, "timestamp": "05:10:45", "text": "こちらでは、行く方がずっと良いと思います"}, {"type": "subtitle", "time": 18647.51, "timestamp": "05:10:47", "text": "に"}, {"type": "subtitle", "time": 18648.75, "timestamp": "05:10:48", "text": "えっと、これ"}, {"type": "subtitle", "time": 18653.23, "timestamp": "05:10:53", "text": "もの。ということで、こちらは私の"}, {"type": "subtitle", "time": 18657.35, "timestamp": "05:10:57", "text": "赤ちゃんたち。これらは引っ張る、私はこれらが"}, {"type": "subtitle", "time": 18659.35, "timestamp": "05:10:59", "text": "引っ張る"}]
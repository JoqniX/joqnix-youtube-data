[{"type": "subtitle", "time": 5700.95, "timestamp": "01:35:00", "text": "を通して。わからないけど、時々"}, {"type": "subtitle", "time": 5707.91, "timestamp": "01:35:07", "text": "そう、だって覚えてるから"}, {"type": "subtitle", "time": 5710.87, "timestamp": "01:35:10", "text": "若い頃はNFTに応募して"}, {"type": "subtitle", "time": 5714.75, "timestamp": "01:35:14", "text": "クリアするには3ラウンドくらいある"}, {"type": "subtitle", "time": 5717.75, "timestamp": "01:35:17", "text": "それは、私が思うように、クリアすれば"}, {"type": "subtitle", "time": 5719.75, "timestamp": "01:35:19", "text": "2ラウンド目では、おそらく"}, {"type": "subtitle", "time": 5720.75, "timestamp": "01:35:20", "text": "何を"}, {"type": "subtitle", "time": 5723.91, "timestamp": "01:35:23", "text": "3ラウンド目に進出すると彼らは言う"}, {"type": "subtitle", "time": 5725.629, "timestamp": "01:35:25", "text": "あなたにインタビューして、"}, {"type": "subtitle", "time": 5733.03, "timestamp": "01:35:33", "text": "いいえ、最初の2ラウンドはやりましたが、その後"}, {"type": "subtitle", "time": 5734.79, "timestamp": "01:35:34", "text": "面接に行かなかった理由は"}, {"type": "subtitle", "time": 5736.39, "timestamp": "01:35:36", "text": "状況もあって、私はこう思いました"}, {"type": "subtitle", "time": 5739.03, "timestamp": "01:35:39", "text": "その頃には既に学位取得を目指していた。しかし"}, {"type": "subtitle", "time": 5752.91, "timestamp": "01:35:52", "text": "でも、どうやって"}, {"type": "subtitle", "time": 5756.709, "timestamp": "01:35:56", "text": "チューブ遊びは楽しんでいますか？その"}, {"type": "subtitle", "time": 5759.83, "timestamp": "01:35:59", "text": "もう4年経ったよね？"}]
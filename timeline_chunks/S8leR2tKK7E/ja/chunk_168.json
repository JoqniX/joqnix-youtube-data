[{"type": "subtitle", "time": 10083.11, "timestamp": "02:48:03", "text": "でも、タイトルでセレスティアにメンションすることはできません。"}, {"type": "subtitle", "time": 10085.55, "timestamp": "02:48:05", "text": "それは普通のことですか、それとも"}, {"type": "subtitle", "time": 10095.349, "timestamp": "02:48:15", "text": "空所。うん。どうすればいいですか？する必要がある"}, {"type": "subtitle", "time": 10096.87, "timestamp": "02:48:16", "text": "サムネイルを変更するんですよね？私はかもしれない"}, {"type": "subtitle", "time": 10099.11, "timestamp": "02:48:19", "text": "サムネイルを変更して、そのままにしておきます"}, {"type": "subtitle", "time": 10109.67, "timestamp": "02:48:29", "text": "えっと、私は、"}, {"type": "subtitle", "time": 10112.71, "timestamp": "02:48:32", "text": "コラボできなかった相手は？どこで"}, {"type": "subtitle", "time": 10134.269, "timestamp": "02:48:54", "text": "えっと、私は尋ねることができます"}, {"type": "subtitle", "time": 10136.11, "timestamp": "02:48:56", "text": "他の友人"}, {"type": "subtitle", "time": 10139.79, "timestamp": "02:48:59", "text": "助けてくれた友人"}]
[{"type": "subtitle", "time": 900.91, "timestamp": "00:15:00", "text": "なぜなら私は所有者ではないから"}, {"type": "subtitle", "time": 905.189, "timestamp": "00:15:05", "text": "ONX は、ONX という名前の主なものの 1 つです。私"}, {"type": "subtitle", "time": 907.509, "timestamp": "00:15:07", "text": "Twitch で、"}, {"type": "subtitle", "time": 911.829, "timestamp": "00:15:11", "text": "すでにバカという名前を取っていた"}, {"type": "subtitle", "time": 914.269, "timestamp": "00:15:14", "text": "誰がボングを手に入れるのか"}, {"type": "subtitle", "time": 916.71, "timestamp": "00:15:16", "text": "いつか私はどうすることもできなくなる"}, {"type": "subtitle", "time": 919.509, "timestamp": "00:15:19", "text": "私にとっては、私はjocknikのオーナーでした"}, {"type": "subtitle", "time": 922.71, "timestamp": "00:15:22", "text": "だって、Jocknixでアカウントを作ったんだもん"}, {"type": "subtitle", "time": 925.03, "timestamp": "00:15:25", "text": "名前を変更してから、私の名前を取得しました"}, {"type": "subtitle", "time": 927.99, "timestamp": "00:15:27", "text": "元のユーザー名は右に戻りますが、ここで"}, {"type": "subtitle", "time": 931.43, "timestamp": "00:15:31", "text": "買わないといけないとかじゃないの？"}, {"type": "subtitle", "time": 935.03, "timestamp": "00:15:35", "text": "でも、Twitchで検索してみたけど、"}, {"type": "subtitle", "time": 938.03, "timestamp": "00:15:38", "text": "その名前を持っていた人"}, {"type": "subtitle", "time": 941.75, "timestamp": "00:15:41", "text": "Xは永久追放された"}, {"type": "subtitle", "time": 945.629, "timestamp": "00:15:45", "text": "理由。私は「え？え？何？」って感じ。"}, {"type": "subtitle", "time": 948.829, "timestamp": "00:15:48", "text": "レニー。」私は「何だって"}, {"type": "subtitle", "time": 952.629, "timestamp": "00:15:52", "text": "「地獄か？」そう、そう。だから私は、"}, {"type": "subtitle", "time": 954.269, "timestamp": "00:15:54", "text": "持つ"}, {"type": "subtitle", "time": 957.55, "timestamp": "00:15:57", "text": "onx_b ですが、私は"}]
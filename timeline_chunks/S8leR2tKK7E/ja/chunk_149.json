[{"type": "subtitle", "time": 8947.429, "timestamp": "02:29:07", "text": "うん。たくさんのこと。"}, {"type": "subtitle", "time": 8950.71, "timestamp": "02:29:10", "text": "その通り。ローラーが楽しみです"}, {"type": "subtitle", "time": 8953.11, "timestamp": "02:29:13", "text": "コースターイベント"}, {"type": "subtitle", "time": 8956.469, "timestamp": "02:29:16", "text": "将来起こること、例えば、たとえ"}, {"type": "subtitle", "time": 8958.79, "timestamp": "02:29:18", "text": "私は何度も考えすぎてしまう"}, {"type": "subtitle", "time": 8961.429, "timestamp": "02:29:21", "text": "でも、前を見ると"}, {"type": "subtitle", "time": 8964.349, "timestamp": "02:29:24", "text": "人生が予期せぬ出来事を起こす"}, {"type": "subtitle", "time": 8967.51, "timestamp": "02:29:27", "text": "それらは本当に楽しみだ"}, {"type": "subtitle", "time": 8970.95, "timestamp": "02:29:30", "text": "だって、たとえあなたがそうであっても、私が気づいたのは"}, {"type": "subtitle", "time": 8973.59, "timestamp": "02:29:33", "text": "私は考えすぎてしまう、ネガティブなことばかり考えてしまう"}, {"type": "subtitle", "time": 8975.469, "timestamp": "02:29:35", "text": "そして良い点"}, {"type": "subtitle", "time": 8978.95, "timestamp": "02:29:38", "text": "しかしほとんどの場合、少なくともこれは"}, {"type": "subtitle", "time": 8981.91, "timestamp": "02:29:41", "text": "考え出されたものやシナリオが展開する"}, {"type": "subtitle", "time": 8985.67, "timestamp": "02:29:45", "text": "実際には。それはまるで狂気の沙汰だ"}, {"type": "subtitle", "time": 8989.67, "timestamp": "02:29:49", "text": "人生の仕組みって本当に素晴らしいと思う。"}, {"type": "subtitle", "time": 8992.15, "timestamp": "02:29:52", "text": "何もかもが不変ではないことは分かっています"}, {"type": "subtitle", "time": 8994.309, "timestamp": "02:29:54", "text": "物事は、唯一の不変の物事は、"}, {"type": "subtitle", "time": 8996.71, "timestamp": "02:29:56", "text": "あなた自身"}, {"type": "subtitle", "time": 8999.429, "timestamp": "02:29:59", "text": "どう対処するか。まるで"}]
[{"type": "subtitle", "time": 3129.19, "timestamp": "00:52:09", "text": "健康に気をつけてください。終わらせないで"}, {"type": "subtitle", "time": 3130.27, "timestamp": "00:52:10", "text": "上へ"}, {"type": "subtitle", "time": 3132.589, "timestamp": "00:52:12", "text": "病院。"}, {"type": "subtitle", "time": 3135.589, "timestamp": "00:52:15", "text": "おい、なんでお前はいつも同じことを言うんだ？私の"}, {"type": "subtitle", "time": 3137.99, "timestamp": "00:52:17", "text": "今日父が私に話して、私たちは口論になった"}, {"type": "subtitle", "time": 3141.95, "timestamp": "00:52:21", "text": "それについて。なぜ同じことを言うのですか"}, {"type": "subtitle", "time": 3144.75, "timestamp": "00:52:24", "text": "もの？えっと、戻る"}, {"type": "subtitle", "time": 3147.069, "timestamp": "00:52:27", "text": "上。"}, {"type": "subtitle", "time": 3149.75, "timestamp": "00:52:29", "text": "バカ。ああ、あなたはこれを聞くだけです"}, {"type": "subtitle", "time": 3151.589, "timestamp": "00:52:31", "text": "尊重する。今は、サクラの言うことは聞かない"}, {"type": "subtitle", "time": 3152.829, "timestamp": "00:52:32", "text": "今日。"}, {"type": "subtitle", "time": 3154.79, "timestamp": "00:52:34", "text": "正直に言うと、私は"}, {"type": "subtitle", "time": 3157.829, "timestamp": "00:52:37", "text": "誰の話でも聞いてみよう。私は本当に準備ができています"}, {"type": "subtitle", "time": 3159.47, "timestamp": "00:52:39", "text": "死ぬ。しないで"}, {"type": "subtitle", "time": 3161.99, "timestamp": "00:52:41", "text": "心配。まあ、でも殺さないでくれよ。私"}, {"type": "subtitle", "time": 3171.99, "timestamp": "00:52:51", "text": "つまり、私にはわからない。私はただ"}, {"type": "subtitle", "time": 3174.43, "timestamp": "00:52:54", "text": "この叫び、"}, {"type": "subtitle", "time": 3177.91, "timestamp": "00:52:57", "text": "知る。これはそうではないことは分かっていますが、"}]
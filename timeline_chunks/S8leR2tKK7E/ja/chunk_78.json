[{"type": "subtitle", "time": 4681.83, "timestamp": "01:18:01", "text": "問題は、彼らが私に次のようなことを求めているということです"}, {"type": "subtitle", "time": 4684.63, "timestamp": "01:18:04", "text": "出席率100％とか、そういうこと。私はそうしなければならない"}, {"type": "subtitle", "time": 4689.709, "timestamp": "01:18:09", "text": "授業開始10分前に到着。ウルトラ"}, {"type": "subtitle", "time": 4694.35, "timestamp": "01:18:14", "text": "厳しい。慣れるのは難しいだろう"}, {"type": "subtitle", "time": 4697.99, "timestamp": "01:18:17", "text": "なぜならここインドでは、まるでショーのようだからです"}, {"type": "subtitle", "time": 4702.87, "timestamp": "01:18:22", "text": "9時に起きてもまだ安全です、"}, {"type": "subtitle", "time": 4704.39, "timestamp": "01:18:24", "text": "何か。時々、先生は"}, {"type": "subtitle", "time": 4708.189, "timestamp": "01:18:28", "text": "それでも夜遅くには、"}, {"type": "subtitle", "time": 4710.11, "timestamp": "01:18:30", "text": "右？そして"}, {"type": "subtitle", "time": 4715.189, "timestamp": "01:18:35", "text": "うん、すごくいい感じになるよ"}, {"type": "subtitle", "time": 4717.59, "timestamp": "01:18:37", "text": "一瞬。私は感じます"}, {"type": "subtitle", "time": 4719.35, "timestamp": "01:18:39", "text": "あなた。"}, {"type": "subtitle", "time": 4721.43, "timestamp": "01:18:41", "text": "はい。そうそう。文化的な"}, {"type": "subtitle", "time": 4725.59, "timestamp": "01:18:45", "text": "その場に居合わせた時の衝撃は？"}, {"type": "subtitle", "time": 4729.669, "timestamp": "01:18:49", "text": "コストコって言いました？ああ、カルチャーショックだ。"}, {"type": "subtitle", "time": 4732.75, "timestamp": "01:18:52", "text": "ああ、カルチャーショックだ。ごめんなさい。"}, {"type": "subtitle", "time": 4736.07, "timestamp": "01:18:56", "text": "私はそれほどではないと思う、なぜなら"}, {"type": "subtitle", "time": 4737.43, "timestamp": "01:18:57", "text": "国際的なものが多かった"}, {"type": "subtitle", "time": 4739.91, "timestamp": "01:18:59", "text": "学生たちだが、私にはいくつかのものがあった"}]
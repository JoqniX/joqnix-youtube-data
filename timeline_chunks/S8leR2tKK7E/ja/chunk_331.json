[{"type": "subtitle", "time": 19863.03, "timestamp": "05:31:03", "text": "通常、いくつかの惑星ではジャンプすると"}, {"type": "subtitle", "time": 19865.75, "timestamp": "05:31:05", "text": "今は、もしあなたが"}, {"type": "subtitle", "time": 19869.39, "timestamp": "05:31:09", "text": "彼らがそんなにたくさん持っているなら、負担になる"}, {"type": "subtitle", "time": 19873.31, "timestamp": "05:31:13", "text": "環境への影響など。"}, {"type": "subtitle", "time": 19876.03, "timestamp": "05:31:16", "text": "いや、それは一種の痛みだ。"}, {"type": "subtitle", "time": 19878.67, "timestamp": "05:31:18", "text": "たとえ"}, {"type": "subtitle", "time": 19888.548, "timestamp": "05:31:28", "text": "環境条件の件ですが、"}, {"type": "subtitle", "time": 19892.47, "timestamp": "05:31:32", "text": "これを最大レベルまで上げるには"}, {"type": "subtitle", "time": 19903.83, "timestamp": "05:31:43", "text": "すべて。それが一番重要な点です。"}]
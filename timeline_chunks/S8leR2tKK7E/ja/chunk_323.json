[{"type": "subtitle", "time": 19382.708, "timestamp": "05:23:02", "text": "心。よし、じゃあ土星に行かなきゃ。"}, {"type": "subtitle", "time": 19385.708, "timestamp": "05:23:05", "text": "土星はどこにある？魂のシステム、"}, {"type": "subtitle", "time": 19389.27, "timestamp": "05:23:09", "text": "右？ソウルとセット、タイタン。そこには"}, {"type": "subtitle", "time": 19390.35, "timestamp": "05:23:10", "text": "あなた"}, {"type": "subtitle", "time": 19394.15, "timestamp": "05:23:14", "text": "は。なぜ私はここに前哨基地を持っているのだろうか？"}, {"type": "subtitle", "time": 19397.15, "timestamp": "05:23:17", "text": "はぁ？わかった。"}, {"type": "subtitle", "time": 19408.67, "timestamp": "05:23:28", "text": "[音楽]"}, {"type": "subtitle", "time": 19412.31, "timestamp": "05:23:32", "text": "そこには。 P."}, {"type": "subtitle", "time": 19414.31, "timestamp": "05:23:34", "text": "造船の話に移ります"}, {"type": "subtitle", "time": 19416.628, "timestamp": "05:23:36", "text": "将来はそうするつもりですが、"}, {"type": "subtitle", "time": 19419.99, "timestamp": "05:23:39", "text": "ストリームカー。私は前進したい"}, {"type": "subtitle", "time": 19422.628, "timestamp": "05:23:42", "text": "今日の記事。現在の状態を維持する"}, {"type": "subtitle", "time": 19431.27, "timestamp": "05:23:51", "text": "スキャン完了。あなたはニューに着陸しました"}, {"type": "subtitle", "time": 19434.19, "timestamp": "05:23:54", "text": "自作農地。こんにちは、どうもありがとうございます"}, {"type": "subtitle", "time": 19437.788, "timestamp": "05:23:57", "text": "多くの。私は新しい場所に着陸します"}]
[{"type": "subtitle", "time": 8220.389, "timestamp": "02:17:00", "text": "特権なし。ああ、それはきっと"}, {"type": "subtitle", "time": 8223.83, "timestamp": "02:17:03", "text": "起こる。私はそういう風には考えない"}, {"type": "subtitle", "time": 8236.309, "timestamp": "02:17:16", "text": "ない。でも綺麗だし、"}, {"type": "subtitle", "time": 8239.87, "timestamp": "02:17:19", "text": "うん、これのためなら一生懸命働くのも構わないよ"}, {"type": "subtitle", "time": 8243.75, "timestamp": "02:17:23", "text": "どれだけ時間がかかっても、モデルを作成する。"}, {"type": "subtitle", "time": 8251.429, "timestamp": "02:17:31", "text": "よかったね。あなたが"}, {"type": "subtitle", "time": 8254.309, "timestamp": "02:17:34", "text": "先輩、目標を達成できますよ。"}, {"type": "subtitle", "time": 8258.07, "timestamp": "02:17:38", "text": "私は時々彼を見つめる傾向がある"}, {"type": "subtitle", "time": 8261.429, "timestamp": "02:17:41", "text": "デスクトップ、またはモデルをじっと見つめる"}, {"type": "subtitle", "time": 8264.83, "timestamp": "02:17:44", "text": "1時間か2時間くらいで、こう言うんだ。"}, {"type": "subtitle", "time": 8267.91, "timestamp": "02:17:47", "text": "「ああ、いつか君は僕のものになる。僕は行くよ"}, {"type": "subtitle", "time": 8272.87, "timestamp": "02:17:52", "text": "「君を独り占めしたいんだ。」待ってて。"}, {"type": "subtitle", "time": 8274.549, "timestamp": "02:17:54", "text": "でも、それも理由の一つです"}, {"type": "subtitle", "time": 8277.429, "timestamp": "02:17:57", "text": "私がジョッカソンに参加した理由。あなたはただ"}]
[{"type": "subtitle", "time": 9844.19, "timestamp": "02:44:04", "text": "それは私が採用しているという意味になります"}, {"type": "subtitle", "time": 9847.349, "timestamp": "02:44:07", "text": "彼女を私の代理人に任命する。いや、待って、"}, {"type": "subtitle", "time": 9850.07, "timestamp": "02:44:10", "text": "待って、待って。まあ、彼女がそれでよければ"}, {"type": "subtitle", "time": 9853.71, "timestamp": "02:44:13", "text": "ボランティアとしてそれを行う"}, {"type": "subtitle", "time": 9856.389, "timestamp": "02:44:16", "text": "自発的に、そうすれば"}, {"type": "subtitle", "time": 9860.87, "timestamp": "02:44:20", "text": "それは問題になるんじゃないでしょうか？しかし、彼女は"}, {"type": "subtitle", "time": 9862.429, "timestamp": "02:44:22", "text": "作業中"}, {"type": "subtitle", "time": 9864.349, "timestamp": "02:44:24", "text": "アダルト。"}, {"type": "subtitle", "time": 9872.87, "timestamp": "02:44:32", "text": "時々、ソマニアックの周りで"}, {"type": "subtitle", "time": 9874.71, "timestamp": "02:44:34", "text": "こんな感じ。今、彼女は"}, {"type": "subtitle", "time": 9877.59, "timestamp": "02:44:37", "text": "多分まだ起きてるだろう。"}, {"type": "subtitle", "time": 9879.349, "timestamp": "02:44:39", "text": "彼女はリストから外されたのかもしれない。はい、大丈夫です。"}, {"type": "subtitle", "time": 9880.83, "timestamp": "02:44:40", "text": "大丈夫。"}, {"type": "subtitle", "time": 9884.59, "timestamp": "02:44:44", "text": "えっと、でもそれでうまくいくかな？"}, {"type": "subtitle", "time": 9887.51, "timestamp": "02:44:47", "text": "けれど？どうやらビリービリーには"}, {"type": "subtitle", "time": 9889.51, "timestamp": "02:44:49", "text": "利用できるホワイトリストは複数あります。"}, {"type": "subtitle", "time": 9892.79, "timestamp": "02:44:52", "text": "えーと、ASMRなら手に入れなきゃ"}, {"type": "subtitle", "time": 9894.95, "timestamp": "02:44:54", "text": "ストリーマー、ASMRみたいな感じにしないと"}, {"type": "subtitle", "time": 9898.23, "timestamp": "02:44:58", "text": "ホワイトリスト。睡眠補助剤 睡眠補助剤 ホワイト"}]
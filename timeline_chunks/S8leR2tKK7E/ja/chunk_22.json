[{"type": "subtitle", "time": 1322.59, "timestamp": "00:22:02", "text": "待って、ちょっと待って、待って、待って"}, {"type": "subtitle", "time": 1324.71, "timestamp": "00:22:04", "text": "上、待って、待って、待って、待って、待って、待って、待って、"}, {"type": "subtitle", "time": 1327.149, "timestamp": "00:22:07", "text": "待って。私はただ"}, {"type": "subtitle", "time": 1331.43, "timestamp": "00:22:11", "text": "気がついた。ちょっと待って、みんな今の見た？"}, {"type": "subtitle", "time": 1333.23, "timestamp": "00:22:13", "text": "おお。おお、"}, {"type": "subtitle", "time": 1335.99, "timestamp": "00:22:15", "text": "神。月曜日は、今日の配信です"}, {"type": "subtitle", "time": 1339.11, "timestamp": "00:22:19", "text": "午後10時30分に予定されていた。そして私は"}, {"type": "subtitle", "time": 1342.029, "timestamp": "00:22:22", "text": "1時間早く配信開始。何"}, {"type": "subtitle", "time": 1352.43, "timestamp": "00:22:32", "text": "え？ああ、神様。午後9時半だと思った。"}, {"type": "subtitle", "time": 1354.83, "timestamp": "00:22:34", "text": "けれど。"}, {"type": "subtitle", "time": 1363.149, "timestamp": "00:22:43", "text": "[音楽]"}, {"type": "subtitle", "time": 1368.29, "timestamp": "00:22:48", "text": "それ。あれ、なんで1030って入力したんだろう？"}, {"type": "subtitle", "time": 1373.47, "timestamp": "00:22:53", "text": "しかし"}, {"type": "subtitle", "time": 1377.35, "timestamp": "00:22:57", "text": "うん、でもみんなが"}, {"type": "subtitle", "time": 1379.83, "timestamp": "00:22:59", "text": "今日の"}]
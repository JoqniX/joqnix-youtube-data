[{"type": "subtitle", "time": 7920.069, "timestamp": "02:12:00", "text": "与えなければならない友情"}, {"type": "subtitle", "time": 7921.91, "timestamp": "02:12:01", "text": "好きになる必要がないので、あまり"}, {"type": "subtitle", "time": 7923.35, "timestamp": "02:12:03", "text": "完全に私生活を投資する"}, {"type": "subtitle", "time": 7926.03, "timestamp": "02:12:06", "text": "それにも入り込むと少し"}, {"type": "subtitle", "time": 7928.55, "timestamp": "02:12:08", "text": "疲れる。 DCに参加するだけでいいですよ"}, {"type": "subtitle", "time": 7931.51, "timestamp": "02:12:11", "text": "いつでも、ゲームをいくつかプレイしたり、冗談を言い合ったり"}, {"type": "subtitle", "time": 7935.79, "timestamp": "02:12:15", "text": "誰かをタイムアウトさせるような感じで"}, {"type": "subtitle", "time": 7938.47, "timestamp": "02:12:18", "text": "だから私は、とても"}, {"type": "subtitle", "time": 7942.75, "timestamp": "02:12:22", "text": "[音楽]"}, {"type": "subtitle", "time": 7950.149, "timestamp": "02:12:30", "text": "これまで、"}, {"type": "subtitle", "time": 7952.55, "timestamp": "02:12:32", "text": "これに貢献するために何か行動を起こしましょう"}, {"type": "subtitle", "time": 7955.83, "timestamp": "02:12:35", "text": "コミュニティや他者を助けるための何か"}, {"type": "subtitle", "time": 7960.31, "timestamp": "02:12:40", "text": "他の新参者とか、何かあったっけ？"}, {"type": "subtitle", "time": 7962.629, "timestamp": "02:12:42", "text": "ある時点で本当に"}, {"type": "subtitle", "time": 7965.27, "timestamp": "02:12:45", "text": "好きになりたかった、本当になりたかった"}, {"type": "subtitle", "time": 7968.149, "timestamp": "02:12:48", "text": "新規参入者向けで、それから"}, {"type": "subtitle", "time": 7971.55, "timestamp": "02:12:51", "text": "こう言うべきかな"}, {"type": "subtitle", "time": 7974.069, "timestamp": "02:12:54", "text": "彼らが頼れる人"}, {"type": "subtitle", "time": 7977.75, "timestamp": "02:12:57", "text": "指導やアドバイスはありますが、多くはありません"}]
[{"type": "subtitle", "time": 19326.628, "timestamp": "05:22:06", "text": "覚えて。わかった。わかった。わかった。手に入れた"}, {"type": "subtitle", "time": 19329.03, "timestamp": "05:22:09", "text": "それ。タイタンだ。実際は、タイタンです。"}, {"type": "subtitle", "time": 19341.868, "timestamp": "05:22:21", "text": "えっと、どこですか"}, {"type": "subtitle", "time": 19348.83, "timestamp": "05:22:28", "text": "タイタン？ああ、スキャンしたの？"}, {"type": "subtitle", "time": 19353.15, "timestamp": "05:22:33", "text": "自分？はい、スキャンします"}, {"type": "subtitle", "time": 19365.948, "timestamp": "05:22:45", "text": "ええと、わかりました。私は"}, {"type": "subtitle", "time": 19368.83, "timestamp": "05:22:48", "text": "戻る。えっと、"}, {"type": "subtitle", "time": 19372.628, "timestamp": "05:22:52", "text": "わかった。ああ、ベンゼンのようなものがある"}, {"type": "subtitle", "time": 19375.07, "timestamp": "05:22:55", "text": "ここ。よし、これは役に立つかもしれない"}, {"type": "subtitle", "time": 19379.39, "timestamp": "05:22:59", "text": "私をセント2に。わかりました、それは残しておきます"}]
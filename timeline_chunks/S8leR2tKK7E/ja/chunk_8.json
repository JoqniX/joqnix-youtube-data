[{"type": "subtitle", "time": 481.55, "timestamp": "00:08:01", "text": "アップロードしたからグレーアウトしたみたい"}, {"type": "subtitle", "time": 485.11, "timestamp": "00:08:05", "text": "月曜日か日曜日、だって私はバカだから"}, {"type": "subtitle", "time": 487.749, "timestamp": "00:08:07", "text": "物事を行うには時間をかける。だから私はバカなんです"}, {"type": "subtitle", "time": 493.07, "timestamp": "00:08:13", "text": "バカ。ということで、今週は"}, {"type": "subtitle", "time": 495.83, "timestamp": "00:08:15", "text": "月曜日に永遠だった私たちは今それが"}, {"type": "subtitle", "time": 498.71, "timestamp": "00:08:18", "text": "今日の配信は永遠回帰です"}, {"type": "subtitle", "time": 501.43, "timestamp": "00:08:21", "text": "午後10時30分私はストリームを始めました"}, {"type": "subtitle", "time": 504.23, "timestamp": "00:08:24", "text": "ストリームを開始してから20分または10分"}, {"type": "subtitle", "time": 505.869, "timestamp": "00:08:25", "text": "数分遅れ"}, {"type": "subtitle", "time": 509.749, "timestamp": "00:08:29", "text": "OBSがクラッシュしたからです。私は言った"}, {"type": "subtitle", "time": 513.67, "timestamp": "00:08:33", "text": "ストーリーは正しいです。私は再インストールしました"}, {"type": "subtitle", "time": 517.469, "timestamp": "00:08:37", "text": "リリース候補第2号"}, {"type": "subtitle", "time": 521.029, "timestamp": "00:08:41", "text": "えっと、テスト版2では"}, {"type": "subtitle", "time": 524.949, "timestamp": "00:08:44", "text": "いくつか修正しましたが、ご覧のとおり、"}, {"type": "subtitle", "time": 527.75, "timestamp": "00:08:47", "text": "ご覧のとおり、私のビジュアライザーは修正されていません。"}, {"type": "subtitle", "time": 531.35, "timestamp": "00:08:51", "text": "話すと視覚的な"}, {"type": "subtitle", "time": 534.63, "timestamp": "00:08:54", "text": "ビジュアライザーレイヤーのようなシーンのような"}, {"type": "subtitle", "time": 536.949, "timestamp": "00:08:56", "text": "彩度は高いが、画像は"}, {"type": "subtitle", "time": 538.03, "timestamp": "00:08:58", "text": "飽和"}]
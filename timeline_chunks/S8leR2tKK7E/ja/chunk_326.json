[{"type": "subtitle", "time": 19562.628, "timestamp": "05:26:02", "text": "農業は本当に重要です。君のパパだよ。"}, {"type": "subtitle", "time": 19570.91, "timestamp": "05:26:10", "text": "私のMPCはどこにあるの？"}, {"type": "subtitle", "time": 19585.75, "timestamp": "05:26:25", "text": "料金プランをご利用いただきありがとうございます。それは"}, {"type": "subtitle", "time": 19588.39, "timestamp": "05:26:28", "text": "あれじゃないよ。私たちはどう思いましたか？"}, {"type": "subtitle", "time": 19609.27, "timestamp": "05:26:49", "text": "ああ、お店。"}, {"type": "subtitle", "time": 19617.83, "timestamp": "05:26:57", "text": "そこにいたんですね。こんにちは、ジェイ。できました"}, {"type": "subtitle", "time": 19619.67, "timestamp": "05:26:59", "text": "おそらく良い値段で買い取ってくれるでしょう。"}]
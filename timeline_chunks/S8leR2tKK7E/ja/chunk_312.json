[{"type": "subtitle", "time": 18720.15, "timestamp": "05:12:00", "text": "この方法でお金を稼ぐ方法をお見せします"}, {"type": "subtitle", "time": 18723.91, "timestamp": "05:12:03", "text": "ゲーム。よし、お金を稼がなくていいよ。もっと高く"}, {"type": "subtitle", "time": 18725.47, "timestamp": "05:12:05", "text": "レベルより"}, {"type": "subtitle", "time": 18729.19, "timestamp": "05:12:09", "text": "初心者です。だから、私は文字通り寝る"}, {"type": "subtitle", "time": 18731.99, "timestamp": "05:12:11", "text": "ここ。 24時間睡眠をとることは"}, {"type": "subtitle", "time": 18736.708, "timestamp": "05:12:16", "text": "文字通り、200時間か150時間（現地時間）"}, {"type": "subtitle", "time": 18740.39, "timestamp": "05:12:20", "text": "時間。そうですね、つまりすべてのすべての"}, {"type": "subtitle", "time": 18743.91, "timestamp": "05:12:23", "text": "場所 えーと、たくさんのヒントを見てきました"}, {"type": "subtitle", "time": 18745.23, "timestamp": "05:12:25", "text": "トリック動画。"}, {"type": "subtitle", "time": 18748.708, "timestamp": "05:12:28", "text": "ああ、ちょっと技術オタクっぽくなっちゃったかも"}, {"type": "subtitle", "time": 18754.75, "timestamp": "05:12:34", "text": "えーと"}, {"type": "subtitle", "time": 18758.868, "timestamp": "05:12:38", "text": "はいはい、ベッドで寝てください。うん、君も"}, {"type": "subtitle", "time": 18761.43, "timestamp": "05:12:41", "text": "ベッドで寝る、それから寝る"}, {"type": "subtitle", "time": 18764.55, "timestamp": "05:12:44", "text": "彼女は床や沼地で眠ることもできます。"}, {"type": "subtitle", "time": 18768.23, "timestamp": "05:12:48", "text": "ええ、彼女も寝ますよ。はい。いいえ、彼女は"}, {"type": "subtitle", "time": 18772.948, "timestamp": "05:12:52", "text": "君とは寝ないよ、いや、僕とは寝ないよ。えっと、もし"}, {"type": "subtitle", "time": 18776.55, "timestamp": "05:12:56", "text": "彼女と恋愛関係にあるわけじゃないけど、彼女は寝てる"}, {"type": "subtitle", "time": 18778.948, "timestamp": "05:12:58", "text": "寝ていない時。ゆっくり休んで、"}]
[{"type": "subtitle", "time": 8520.15, "timestamp": "02:22:00", "text": "テスト対象ではなくテストサブ"}, {"type": "subtitle", "time": 8522.63, "timestamp": "02:22:02", "text": "これからどうなるかを見る旅になるだろう"}, {"type": "subtitle", "time": 8525.03, "timestamp": "02:22:05", "text": "人々はそれに反応するかもしれない、私が"}, {"type": "subtitle", "time": 8527.429, "timestamp": "02:22:07", "text": "今は考えすぎてしまうと"}, {"type": "subtitle", "time": 8529.11, "timestamp": "02:22:09", "text": "現実"}, {"type": "subtitle", "time": 8532.15, "timestamp": "02:22:12", "text": "そして、また、"}, {"type": "subtitle", "time": 8534.95, "timestamp": "02:22:14", "text": "それを支持する、つまり"}, {"type": "subtitle", "time": 8538.15, "timestamp": "02:22:18", "text": "彼らに提供するのに十分な資金が貯まるまで待ってください"}, {"type": "subtitle", "time": 8541.51, "timestamp": "02:22:21", "text": "何か新しいものとかで、ですよね？として"}, {"type": "subtitle", "time": 8543.99, "timestamp": "02:22:23", "text": "Lのビデオみたいなやつ、そういうの全部だよね？"}, {"type": "subtitle", "time": 8545.55, "timestamp": "02:22:25", "text": "それらは"}, {"type": "subtitle", "time": 8549.03, "timestamp": "02:22:29", "text": "高い。ああ、それはまるで"}, {"type": "subtitle", "time": 8552.87, "timestamp": "02:22:32", "text": "一般的に高価である。うん、"}, {"type": "subtitle", "time": 8556.23, "timestamp": "02:22:36", "text": "私は、それは有効だと思います"}, {"type": "subtitle", "time": 8559.59, "timestamp": "02:22:39", "text": "心配ですが、それは、"}, {"type": "subtitle", "time": 8562.15, "timestamp": "02:22:42", "text": "遠い未来の可能性と"}, {"type": "subtitle", "time": 8565.389, "timestamp": "02:22:45", "text": "そもそも起こらなかったかもしれない。"}, {"type": "subtitle", "time": 8568.07, "timestamp": "02:22:48", "text": "だから、何でも大切にする方が良い"}, {"type": "subtitle", "time": 8570.95, "timestamp": "02:22:50", "text": "今のところは、それで十分です。はい。それよりも"}, {"type": "subtitle", "time": 8573.67, "timestamp": "02:22:53", "text": "自分が持っていないものについて考える。"}]
[{"type": "subtitle", "time": 4140.55, "timestamp": "01:09:00", "text": "ウィンク。実際に試してみた"}, {"type": "subtitle", "time": 4142.87, "timestamp": "01:09:02", "text": "スコットランドのユーチューバーとつながりがあるが、"}, {"type": "subtitle", "time": 4144.95, "timestamp": "01:09:04", "text": "それでたくさん見つけられなかった"}, {"type": "subtitle", "time": 4148.47, "timestamp": "01:09:08", "text": "彼らのうち、私は彼らが"}, {"type": "subtitle", "time": 4149.99, "timestamp": "01:09:09", "text": "そういうタイプの人たち"}, {"type": "subtitle", "time": 4154.149, "timestamp": "01:09:14", "text": "突然コラボレーションが始まったのは、"}, {"type": "subtitle", "time": 4156.95, "timestamp": "01:09:16", "text": "ダイナミクスと、完全にその物が好きです"}, {"type": "subtitle", "time": 4160.95, "timestamp": "01:09:20", "text": "違うよね？あなたならそのことを知っているはずだ。"}, {"type": "subtitle", "time": 4163.91, "timestamp": "01:09:23", "text": "そうそう。えっと、数字のことですか？"}, {"type": "subtitle", "time": 4166.63, "timestamp": "01:09:26", "text": "ダイナミクス、あるいはそれを受け入れなければならないような"}, {"type": "subtitle", "time": 4168.709, "timestamp": "01:09:28", "text": "ゆっくりとした動きとして。いいえ、あなたは"}, {"type": "subtitle", "time": 4172.63, "timestamp": "01:09:32", "text": "彼らを知って、それから信頼する、信頼する、信頼する"}, {"type": "subtitle", "time": 4175.669, "timestamp": "01:09:35", "text": "彼らとコラボレーションする"}, {"type": "subtitle", "time": 4178.55, "timestamp": "01:09:38", "text": "互いに協力し合うタイプの人たち。うん"}, {"type": "subtitle", "time": 4180.87, "timestamp": "01:09:40", "text": "それは2番目で、"}, {"type": "subtitle", "time": 4183.269, "timestamp": "01:09:43", "text": "グループを作って、"}, {"type": "subtitle", "time": 4185.189, "timestamp": "01:09:45", "text": "彼らとの友情が輪に入る"}, {"type": "subtitle", "time": 4188.309, "timestamp": "01:09:48", "text": "そして、その時私は持っていなかった"}, {"type": "subtitle", "time": 4191.43, "timestamp": "01:09:51", "text": "そうするための精神的な能力またはエネルギー。"}]
[{"type": "subtitle", "time": 7501.189, "timestamp": "02:05:01", "text": "「ああ、彼らはとてもうまくいっているよ。」私"}, {"type": "subtitle", "time": 7503.109, "timestamp": "02:05:03", "text": "「ああ、彼らはまさにそうしている」"}, {"type": "subtitle", "time": 7506.87, "timestamp": "02:05:06", "text": "良い。彼らはそれに値する。」そして私は"}, {"type": "subtitle", "time": 7509.99, "timestamp": "02:05:09", "text": "私も自分のペースで同じことをすることができます"}, {"type": "subtitle", "time": 7514.07, "timestamp": "02:05:14", "text": "ある日突然、そんなことが起こる。そしてそれは"}, {"type": "subtitle", "time": 7517.35, "timestamp": "02:05:17", "text": "考え方を変えたことは、多少は役に立った。それは役に立った"}, {"type": "subtitle", "time": 7519.589, "timestamp": "02:05:19", "text": "多く。はい。はい。"}, {"type": "subtitle", "time": 7522.47, "timestamp": "02:05:22", "text": "だから私は、"}, {"type": "subtitle", "time": 7526.07, "timestamp": "02:05:26", "text": "その「私」という考え方を打破するために"}, {"type": "subtitle", "time": 7528.229, "timestamp": "02:05:28", "text": "私は失っていると感じていました"}, {"type": "subtitle", "time": 7531.27, "timestamp": "02:05:31", "text": "多くの機会と可能性"}, {"type": "subtitle", "time": 7533.99, "timestamp": "02:05:33", "text": "例えば、私がスコットランドにいた時のように。私は感じる"}, {"type": "subtitle", "time": 7536.07, "timestamp": "02:05:36", "text": "インドを離れたのでインドを離れたのと同じように"}, {"type": "subtitle", "time": 7538.07, "timestamp": "02:05:38", "text": "私は多くのことができなかった"}, {"type": "subtitle", "time": 7540.95, "timestamp": "02:05:40", "text": "コンテンツクリエイターとして。しかし、私はまたこうも思った"}, {"type": "subtitle", "time": 7542.669, "timestamp": "02:05:42", "text": "それは私が選んだ道です"}, {"type": "subtitle", "time": 7546.55, "timestamp": "02:05:46", "text": "私自身と、私が送りたい人生"}, {"type": "subtitle", "time": 7549.189, "timestamp": "02:05:49", "text": "そして、彼らが作っている人々は"}, {"type": "subtitle", "time": 7553.189, "timestamp": "02:05:53", "text": "選択肢と、物事を行うことが好きです"}, {"type": "subtitle", "time": 7555.03, "timestamp": "02:05:55", "text": "何をすべきか分かっているかのようにリードする"}, {"type": "subtitle", "time": 7557.83, "timestamp": "02:05:57", "text": "彼らが欲しいもの、そして私はあなただけ"}]
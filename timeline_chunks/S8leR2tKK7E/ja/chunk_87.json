[{"type": "subtitle", "time": 5225.39, "timestamp": "01:27:05", "text": "だから私はこう思う"}, {"type": "subtitle", "time": 5229.11, "timestamp": "01:27:09", "text": "えっと、楽しみにしています"}, {"type": "subtitle", "time": 5230.189, "timestamp": "01:27:10", "text": "たくさんの"}, {"type": "subtitle", "time": 5232.95, "timestamp": "01:27:12", "text": "えーと、私が見たもの"}, {"type": "subtitle", "time": 5236.229, "timestamp": "01:27:16", "text": "インターネット。それらは本当ですか？"}, {"type": "subtitle", "time": 5239.27, "timestamp": "01:27:19", "text": "コンビニの商品みたいな感じですね。"}, {"type": "subtitle", "time": 5241.03, "timestamp": "01:27:21", "text": "コンビニの裏技、それらすべて"}, {"type": "subtitle", "time": 5246.149, "timestamp": "01:27:26", "text": "もの。給料はバンドの人たちに支払われます"}, {"type": "subtitle", "time": 5248.55, "timestamp": "01:27:28", "text": "実際に給料を見る"}, {"type": "subtitle", "time": 5251.03, "timestamp": "01:27:31", "text": "男性、日本のサラリーマン。それは"}, {"type": "subtitle", "time": 5253.229, "timestamp": "01:27:33", "text": "私の目標の一つです。"}, {"type": "subtitle", "time": 5257.75, "timestamp": "01:27:37", "text": "ええ、私は完全なものを作ったことはありません"}, {"type": "subtitle", "time": 5260.39, "timestamp": "01:27:40", "text": "まだやりたいことリストはないけど、小​​さなリストがある"}, {"type": "subtitle", "time": 5263.07, "timestamp": "01:27:43", "text": "やりたいことリストを念頭に置いておく。"}, {"type": "subtitle", "time": 5264.39, "timestamp": "01:27:44", "text": "[音楽]"}, {"type": "subtitle", "time": 5265.99, "timestamp": "01:27:45", "text": "私も、あなたも好きになるべきだと思います"}, {"type": "subtitle", "time": 5268.189, "timestamp": "01:27:48", "text": "いつでもあなたの体験を撮影してください"}, {"type": "subtitle", "time": 5271.03, "timestamp": "01:27:51", "text": "あなたの多くのものが好きだと思います"}, {"type": "subtitle", "time": 5273.189, "timestamp": "01:27:53", "text": "視聴者はあなたのいいねを見るのも好きです"}, {"type": "subtitle", "time": 5274.87, "timestamp": "01:27:54", "text": "あなたが知っている"}, {"type": "subtitle", "time": 5276.629, "timestamp": "01:27:56", "text": "新しい人との交流の仕方みたいに"}, {"type": "chat", "time": 5277.818, "timestamp": "01:27:57", "author": "@dazai8348"
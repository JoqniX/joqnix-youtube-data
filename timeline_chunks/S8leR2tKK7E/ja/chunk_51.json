[{"type": "subtitle", "time": 3072.19, "timestamp": "00:51:12", "text": "けれど？これが私のスコアです。これは"}, {"type": "subtitle", "time": 3075.29, "timestamp": "00:51:15", "text": "24時間17時間の配信。"}, {"type": "subtitle", "time": 3079.91, "timestamp": "00:51:19", "text": "[音楽]"}, {"type": "subtitle", "time": 3081.63, "timestamp": "00:51:21", "text": "くそ。いつ"}, {"type": "subtitle", "time": 3086.99, "timestamp": "00:51:26", "text": "終わり？あ、待って。変人がそれをするとき"}, {"type": "subtitle", "time": 3090.63, "timestamp": "00:51:30", "text": "終わり？私に言わないでください。ああ、午前6時30分。ああ、"}, {"type": "subtitle", "time": 3092.349, "timestamp": "00:51:32", "text": "午前6時30分"}, {"type": "subtitle", "time": 3096.47, "timestamp": "00:51:36", "text": "わかった。午前6時30分。終わりは午前7時です。"}, {"type": "subtitle", "time": 3100.15, "timestamp": "00:51:40", "text": "明日の朝に終わります。それで、"}, {"type": "subtitle", "time": 3102.109, "timestamp": "00:51:42", "text": "それはつまり"}, {"type": "subtitle", "time": 3104.71, "timestamp": "00:51:44", "text": "ああ神様、私は"}, {"type": "subtitle", "time": 3107.109, "timestamp": "00:51:47", "text": "もっと軽い感じ、わかるでしょ。ねえ、私はやめるよ"}, {"type": "subtitle", "time": 3109.829, "timestamp": "00:51:49", "text": "クローズドベータの報酬を受け取ったら"}, {"type": "subtitle", "time": 3112.91, "timestamp": "00:51:52", "text": "それが最大レベル、最大武器です"}, {"type": "subtitle", "time": 3116.79, "timestamp": "00:51:56", "text": "評価の強化。えーと、それからえーと"}, {"type": "subtitle", "time": 3119.39, "timestamp": "00:51:59", "text": "全ての物"}]
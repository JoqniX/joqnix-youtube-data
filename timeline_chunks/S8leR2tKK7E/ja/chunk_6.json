[{"type": "subtitle", "time": 361.99, "timestamp": "00:06:01", "text": "君たち。 M だから私はいつも"}, {"type": "subtitle", "time": 364.79, "timestamp": "00:06:04", "text": "皆さん一人ひとりに感謝しています"}, {"type": "subtitle", "time": 367.51, "timestamp": "00:06:07", "text": "来てくれて、そして全てに感謝します。しかしそれでも、"}, {"type": "subtitle", "time": 368.43, "timestamp": "00:06:08", "text": "しかし"}, {"type": "subtitle", "time": 371.15, "timestamp": "00:06:11", "text": "まだ"}, {"type": "subtitle", "time": 383.029, "timestamp": "00:06:23", "text": "うん。そう、それが私の望みだったんです"}, {"type": "subtitle", "time": 384.95, "timestamp": "00:06:24", "text": "言う。"}, {"type": "subtitle", "time": 388.87, "timestamp": "00:06:28", "text": "私のことをあまり見ないでください。私は知っている"}, {"type": "subtitle", "time": 391.309, "timestamp": "00:06:31", "text": "時々行ってもいいですか"}, {"type": "subtitle", "time": 401.749, "timestamp": "00:06:41", "text": "それでも、それでも、それでも、しない"}, {"type": "subtitle", "time": 404.71, "timestamp": "00:06:44", "text": "オーバーウォッチ。わかった。私は"}, {"type": "subtitle", "time": 412.87, "timestamp": "00:06:52", "text": "オーバーウォッチ。ああ、神様。まるで私が"}, {"type": "subtitle", "time": 417.15, "timestamp": "00:06:57", "text": "「ああ、ゲームは何？」と言っている。"}, {"type": "subtitle", "time": 419.71, "timestamp": "00:06:59", "text": "でも私は"}]
[{"type": "subtitle", "time": 5100.55, "timestamp": "01:25:00", "text": "本当に素晴らしいコンサートでした。私は"}, {"type": "subtitle", "time": 5102.39, "timestamp": "01:25:02", "text": "君の友達なら僕のこと知ってるよね？ 1つ"}, {"type": "subtitle", "time": 5106.47, "timestamp": "01:25:06", "text": "誰があなたの…ええ、私は彼女を愛しています。すばらしい。"}, {"type": "subtitle", "time": 5110.07, "timestamp": "01:25:10", "text": "私と私とアリサ。私たちはVCにいるようだった"}, {"type": "subtitle", "time": 5113.83, "timestamp": "01:25:13", "text": "数ヶ月前のことだったかな、そして私たちは"}, {"type": "subtitle", "time": 5116.55, "timestamp": "01:25:16", "text": "まるで何気なく話しているようで、ミムは"}, {"type": "subtitle", "time": 5118.95, "timestamp": "01:25:18", "text": "君たちがここにいるし、私も"}, {"type": "subtitle", "time": 5121.43, "timestamp": "01:25:21", "text": "その時は彼女だけを聞いていたと思う"}, {"type": "subtitle", "time": 5124.83, "timestamp": "01:25:24", "text": "彼女は何かをしていた。それで彼女は"}, {"type": "subtitle", "time": 5127.31, "timestamp": "01:25:27", "text": "議論のように"}, {"type": "subtitle", "time": 5130.07, "timestamp": "01:25:30", "text": "何かについて議論していた"}, {"type": "subtitle", "time": 5133.11, "timestamp": "01:25:33", "text": "ランダムなこと。彼女は、えーっと、と付け加えていました"}, {"type": "subtitle", "time": 5136.31, "timestamp": "01:25:36", "text": "彼女は戻ってきてからずっとこうだった"}, {"type": "subtitle", "time": 5139.91, "timestamp": "01:25:39", "text": "裁判官として、私は"}, {"type": "subtitle", "time": 5145.03, "timestamp": "01:25:45", "text": "証拠を提示して、えーと、どうすればいいの？"}, {"type": "subtitle", "time": 5148.39, "timestamp": "01:25:48", "text": "反撃しなければならない、"}, {"type": "subtitle", "time": 5150.709, "timestamp": "01:25:50", "text": "とても楽しい。"}, {"type": "subtitle", "time": 5152.629, "timestamp": "01:25:52", "text": "素晴らしかった。つまり、それはとても"}, {"type": "subtitle", "time": 5155.03, "timestamp": "01:25:55", "text": "楽しい。何てことだ。きっとこんな"}]
[{"type": "subtitle", "time": 7680.87, "timestamp": "02:08:00", "text": "ここには様々なタイプの人々がいる。人々"}, {"type": "subtitle", "time": 7682.51, "timestamp": "02:08:02", "text": "誰が"}, {"type": "subtitle", "time": 7685.669, "timestamp": "02:08:05", "text": "ストリーマーと非ストリーマーと人々"}, {"type": "subtitle", "time": 7687.069, "timestamp": "02:08:07", "text": "かつて"}, {"type": "subtitle", "time": 7691.03, "timestamp": "02:08:11", "text": "ストリームと、ストリームしない人"}, {"type": "subtitle", "time": 7692.189, "timestamp": "02:08:12", "text": "YouTuberと"}, {"type": "subtitle", "time": 7695.35, "timestamp": "02:08:15", "text": "YouTuberは楽しかったです"}, {"type": "subtitle", "time": 7699.51, "timestamp": "02:08:19", "text": "彼ら全員をもっとよく知るために、そして"}, {"type": "subtitle", "time": 7700.91, "timestamp": "02:08:20", "text": "再接続しました"}, {"type": "subtitle", "time": 7704.87, "timestamp": "02:08:24", "text": "それ以来、二度と。うん。"}, {"type": "subtitle", "time": 7707.589, "timestamp": "02:08:27", "text": "正直言って、たくさんのことが"}, {"type": "subtitle", "time": 7709.91, "timestamp": "02:08:29", "text": "素晴らしいスキルでもあるので、"}, {"type": "subtitle", "time": 7711.99, "timestamp": "02:08:31", "text": "日本に行くと、"}, {"type": "subtitle", "time": 7719.629, "timestamp": "02:08:39", "text": "うん、そうだね"}, {"type": "subtitle", "time": 7722.709, "timestamp": "02:08:42", "text": "そうすればもっとこうできたらいいのに"}, {"type": "subtitle", "time": 7724.55, "timestamp": "02:08:44", "text": "将来も、座って"}, {"type": "subtitle", "time": 7727.069, "timestamp": "02:08:47", "text": "複数の人と話す"}, {"type": "subtitle", "time": 7729.31, "timestamp": "02:08:49", "text": "これは私はしないだろう"}, {"type": "subtitle", "time": 7731.91, "timestamp": "02:08:51", "text": "この時点で、もし私が"}, {"type": "subtitle", "time": 7734.229, "timestamp": "02:08:54", "text": "24時間ストリーミングしないでください、それはあまりにも"}, {"type": "subtitle", "time": 7737.35, "timestamp": "02:08:57", "text": "短い理由がわからない"}, {"type": "subtitle", "time": 7739.189, "timestamp": "02:08:59", "text": "それは私が"}]
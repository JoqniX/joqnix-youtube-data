[{"type": "subtitle", "time": 5400.47, "timestamp": "01:30:00", "text": "文字通り私の顔に現れて"}, {"type": "subtitle", "time": 5403.99, "timestamp": "01:30:03", "text": "背面カメラと前面カメラ。ああ、いや、いや。"}, {"type": "subtitle", "time": 5408.39, "timestamp": "01:30:08", "text": "そして私はパニックになった。私は心の中で死んで、私は"}, {"type": "subtitle", "time": 5412.31, "timestamp": "01:30:12", "text": "その「w」を削除しました。"}, {"type": "subtitle", "time": 5414.87, "timestamp": "01:30:14", "text": "似たようなことが起こったと思う"}, {"type": "subtitle", "time": 5417.669, "timestamp": "01:30:17", "text": "私にとってはそうだったが、私は悪い手札を見せて、それから"}, {"type": "subtitle", "time": 5420.55, "timestamp": "01:30:20", "text": "私はそれを病棟から切り離さなければならなかった。私はパニックになった"}, {"type": "subtitle", "time": 5423.35, "timestamp": "01:30:23", "text": "あまり好きではなかったけど、ただ好きだった"}, {"type": "subtitle", "time": 5425.03, "timestamp": "01:30:25", "text": "カメラの下に置いて、"}, {"type": "subtitle", "time": 5426.39, "timestamp": "01:30:26", "text": "その時気づいた、しまった、私は"}, {"type": "subtitle", "time": 5429.189, "timestamp": "01:30:29", "text": "手袋を着用している。そしてその後"}, {"type": "subtitle", "time": 5431.669, "timestamp": "01:30:31", "text": "事は終わったので、パールに連絡した。"}, {"type": "subtitle", "time": 5434.07, "timestamp": "01:30:34", "text": "そして私たちは、ポップとかそういうのが好きなんです。"}, {"type": "subtitle", "time": 5435.83, "timestamp": "01:30:35", "text": "だから私は翌朝まで待たなければならなかった"}, {"type": "subtitle", "time": 5437.43, "timestamp": "01:30:37", "text": "水が処理されるように、"}, {"type": "subtitle", "time": 5439.51, "timestamp": "01:30:39", "text": "それを断ち切ることができる。"}, {"type": "subtitle", "time": 5449.91, "timestamp": "01:30:49", "text": "うん。 Bはどうですか？しばらくぶり"}, {"type": "subtitle", "time": 5451.99, "timestamp": "01:30:51", "text": "話した"}, {"type": "subtitle", "time": 5454.229, "timestamp": "01:30:54", "text": "彼は元気だと思います。私はそう思わない"}, {"type": "subtitle", "time": 5457.27, "timestamp": "01:30:57", "text": "彼はとても活動的だと思う。"}]
[{"type": "subtitle", "time": 17762.55, "timestamp": "04:56:02", "text": "9月。うん。さよなら。もう17位だ"}, {"type": "subtitle", "time": 17764.19, "timestamp": "04:56:04", "text": "今月の、"}, {"type": "subtitle", "time": 17768.15, "timestamp": "04:56:08", "text": "はぁ？信じられますか？すでに"}, {"type": "subtitle", "time": 17769.628, "timestamp": "04:56:09", "text": "17日。"}, {"type": "subtitle", "time": 17773.51, "timestamp": "04:56:13", "text": "またDだ。えっと、シューという音がしないといいんだけど"}, {"type": "subtitle", "time": 17777.27, "timestamp": "04:56:17", "text": "私のマイクから音が聞こえます。もしそうなら、"}, {"type": "subtitle", "time": 17778.59, "timestamp": "04:56:18", "text": "直します"}, {"type": "subtitle", "time": 17782.27, "timestamp": "04:56:22", "text": "それ。面白いこと知ってる？"}, {"type": "subtitle", "time": 17785.67, "timestamp": "04:56:25", "text": "えっと、私だけがこんなことをしなければならない"}, {"type": "subtitle", "time": 17788.51, "timestamp": "04:56:28", "text": "これは、人々がこのプラグインを"}, {"type": "subtitle", "time": 17793.19, "timestamp": "04:56:33", "text": "OBS、完璧に動作しますよ。ただ"}, {"type": "subtitle", "time": 17795.15, "timestamp": "04:56:35", "text": "すべての"}, {"type": "subtitle", "time": 17798.708, "timestamp": "04:56:38", "text": "時間。イコライザーAPRは機能しません"}, {"type": "subtitle", "time": 17801.07, "timestamp": "04:56:41", "text": "これ。このプラグインには適していません。"}, {"type": "subtitle", "time": 17803.91, "timestamp": "04:56:43", "text": "何かある。でも、まあ、ある意味"}, {"type": "subtitle", "time": 17816.07, "timestamp": "04:56:56", "text": "今日は、えーと"}, {"type": "subtitle", "time": 17819.43, "timestamp": "04:56:59", "text": "スターフィールド。しばらくぶり"}]
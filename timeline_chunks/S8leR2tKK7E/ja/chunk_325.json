[{"type": "subtitle", "time": 19510.708, "timestamp": "05:25:10", "text": "ここではあまり長く外にいないでください"}, {"type": "subtitle", "time": 19514.07, "timestamp": "05:25:14", "text": "タイタン。内部に自由な固体が存在します。"}, {"type": "subtitle", "time": 19516.31, "timestamp": "05:25:16", "text": "わかった。私はこれを見つけるだろうと思っていた"}, {"type": "subtitle", "time": 19518.788, "timestamp": "05:25:18", "text": "集落の種類。"}, {"type": "subtitle", "time": 19522.6, "timestamp": "05:25:22", "text": "回避策があるかもしれません。"}, {"type": "subtitle", "time": 19524.07, "timestamp": "05:25:24", "text": "[音楽]"}, {"type": "subtitle", "time": 19526.868, "timestamp": "05:25:26", "text": "くそ。また停電だ。ジョイス"}, {"type": "subtitle", "time": 19535.27, "timestamp": "05:25:35", "text": "チャンクに分けて行く予定なら、"}, {"type": "subtitle", "time": 19537.03, "timestamp": "05:25:37", "text": "ルーサーは誰かを困らせている"}, {"type": "subtitle", "time": 19540.07, "timestamp": "05:25:40", "text": "彼らは助けを求めるための盾となる。"}, {"type": "subtitle", "time": 19541.55, "timestamp": "05:25:41", "text": "講演する"}, {"type": "subtitle", "time": 19543.75, "timestamp": "05:25:43", "text": "ルター。私はこれらの人が誰なのか知りません"}, {"type": "subtitle", "time": 19552.23, "timestamp": "05:25:52", "text": "NPC。彼はどこにいますか？"}, {"type": "subtitle", "time": 19553.59, "timestamp": "05:25:53", "text": "あなたはそれらの惑星のいずれかから来たのですか？"}, {"type": "subtitle", "time": 19559.91, "timestamp": "05:25:59", "text": "私のNPCはどこ？チャマ、私のパパは言う"}]
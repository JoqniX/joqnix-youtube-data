[{"type": "subtitle", "time": 6302.27, "timestamp": "01:45:02", "text": "楽しくて、彼らを知ることができて、"}, {"type": "subtitle", "time": 6305.51, "timestamp": "01:45:05", "text": "それ。今は楽しい旅のようです"}, {"type": "subtitle", "time": 6307.43, "timestamp": "01:45:07", "text": "すべてを競争的または"}, {"type": "subtitle", "time": 6309.709, "timestamp": "01:45:09", "text": "何でも。"}, {"type": "subtitle", "time": 6312.55, "timestamp": "01:45:12", "text": "そして、私は「えー、誰？」って感じかもしれない"}, {"type": "subtitle", "time": 6316.39, "timestamp": "01:45:16", "text": "これが私にインスピレーションを与えてくれたので、"}, {"type": "subtitle", "time": 6318.149, "timestamp": "01:45:18", "text": "怖がるのではなく、"}, {"type": "subtitle", "time": 6321.51, "timestamp": "01:45:21", "text": "コラボレーションやその他諸々について人々に声をかける"}, {"type": "subtitle", "time": 6324.229, "timestamp": "01:45:24", "text": "たまたま見かけたと思う"}, {"type": "subtitle", "time": 6325.75, "timestamp": "01:45:25", "text": "横切って"}, {"type": "subtitle", "time": 6329.99, "timestamp": "01:45:29", "text": "えーと、ルシウス・メリーウェザーのえーと、ショットみたいな"}, {"type": "subtitle", "time": 6332.31, "timestamp": "01:45:32", "text": "それについて、またはそれについてのビデオやストリームを撮影した"}, {"type": "subtitle", "time": 6335.669, "timestamp": "01:45:35", "text": "彼が話していたのは"}, {"type": "subtitle", "time": 6340.629, "timestamp": "01:45:40", "text": "えっと、彼は、えっと、"}, {"type": "subtitle", "time": 6343.43, "timestamp": "01:45:43", "text": "好きな人とコラボしたり、"}, {"type": "subtitle", "time": 6347.109, "timestamp": "01:45:47", "text": "彼は、たとえそれがコロナであっても"}, {"type": "subtitle", "time": 6350.629, "timestamp": "01:45:50", "text": "あるいは独立した彼はそれを必要としている"}, {"type": "subtitle", "time": 6353.27, "timestamp": "01:45:53", "text": "まず数字を取得すると、それは"}, {"type": "subtitle", "time": 6356.149, "timestamp": "01:45:56", "text": "明らかにこの"}, {"type": "subtitle", "time": 6358.59, "timestamp": "01:45:58", "text": "工業用スペース右チューブと"}]
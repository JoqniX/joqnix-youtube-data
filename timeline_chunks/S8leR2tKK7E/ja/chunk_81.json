[{"type": "subtitle", "time": 4861.669, "timestamp": "01:21:01", "text": "それ？フォールアウト。えっと、映画がテレビで"}, {"type": "subtitle", "time": 4863.83, "timestamp": "01:21:03", "text": "シリーズが出たんだ、そう、彼らは"}, {"type": "subtitle", "time": 4867.95, "timestamp": "01:21:07", "text": "無料で入手できます。フォールアウトシリーズ、"}, {"type": "subtitle", "time": 4877.35, "timestamp": "01:21:17", "text": "忘れた。彼らがそうしてくれるのは良いことだ。"}, {"type": "subtitle", "time": 4881.03, "timestamp": "01:21:21", "text": "無料ゲームを入手して楽しむのは楽しいです"}, {"type": "subtitle", "time": 4882.709, "timestamp": "01:21:22", "text": "「ああ、私はそれを所有しているし、"}, {"type": "subtitle", "time": 4888.709, "timestamp": "01:21:28", "text": "お金を使う必要はありません。"}, {"type": "subtitle", "time": 4890.95, "timestamp": "01:21:30", "text": "絶対に。それはとても"}, {"type": "subtitle", "time": 4893.59, "timestamp": "01:21:33", "text": "優れたマーケティング戦略も"}, {"type": "subtitle", "time": 4901.669, "timestamp": "01:21:41", "text": "非常識な。待って。友達とゴルフをすることは"}, {"type": "subtitle", "time": 4904.87, "timestamp": "01:21:44", "text": "Prime会員なら無料。一体どういうことだ？"}, {"type": "subtitle", "time": 4908.709, "timestamp": "01:21:48", "text": "あなたはそれを手に入れなければならない。 Steamで配信中。私はそれを持っています"}, {"type": "subtitle", "time": 4911.47, "timestamp": "01:21:51", "text": "セントの。 GGに掲載されています。"}, {"type": "subtitle", "time": 4914.87, "timestamp": "01:21:54", "text": "わかった。わかった。"}, {"type": "subtitle", "time": 4919.11, "timestamp": "01:21:59", "text": "正直言って、史上最高のゲームだ。はい。"}]
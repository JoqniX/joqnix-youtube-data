[{"type": "subtitle", "time": 19621.67, "timestamp": "05:27:01", "text": "はい、あなたを待っていました。いらっしゃいませ"}, {"type": "subtitle", "time": 19623.91, "timestamp": "05:27:03", "text": "私の小さな店へ。ニューを訪れていますか？"}, {"type": "subtitle", "time": 19626.15, "timestamp": "05:27:06", "text": "初めてホームステッドに引っ越しますか？はい、これです"}, {"type": "subtitle", "time": 19628.23, "timestamp": "05:27:08", "text": "初めてです。ニース。ほら、それは"}, {"type": "subtitle", "time": 19629.67, "timestamp": "05:27:09", "text": "人と会うのはいつも本当に楽しい"}, {"type": "subtitle", "time": 19632.55, "timestamp": "05:27:12", "text": "他の世界から、あるいは単に宇宙から。私はしません"}, {"type": "subtitle", "time": 19635.67, "timestamp": "05:27:15", "text": "裁判官。良い。喜んでお手伝いします"}, {"type": "subtitle", "time": 19637.35, "timestamp": "05:27:17", "text": "あなたが購入しようとしているもの、または"}, {"type": "subtitle", "time": 19638.708, "timestamp": "05:27:18", "text": "売りたいものを何でも見てみましょう。"}, {"type": "subtitle", "time": 19641.75, "timestamp": "05:27:21", "text": "あらゆる種類の商売を歓迎します。"}, {"type": "subtitle", "time": 19643.27, "timestamp": "05:27:23", "text": "何か質問はありますか？"}, {"type": "subtitle", "time": 19645.67, "timestamp": "05:27:25", "text": "ショップ、商品、あるいは単に新しい"}, {"type": "subtitle", "time": 19647.43, "timestamp": "05:27:27", "text": "一般的に、自給自足生活。喜んでお手伝いします"}, {"type": "subtitle", "time": 19650.31, "timestamp": "05:27:30", "text": "あなた。"}, {"type": "subtitle", "time": 19653.99, "timestamp": "05:27:33", "text": "確認してみます。もちろんです。私も"}, {"type": "subtitle", "time": 19655.11, "timestamp": "05:27:35", "text": "購入に興味があります。"}, {"type": "subtitle", "time": 19657.23, "timestamp": "05:27:37", "text": "何でも"}, {"type": "subtitle", "time": 19660.788, "timestamp": "05:27:40", "text": "その音声のために。今、聞こえましたか？いいえ。"}, {"type": "subtitle", "time": 19669.31, "timestamp": "05:27:49", "text": "わかった。そこで、私たちがすることは"}, {"type": "subtitle", "time": 19672.948, "timestamp": "05:27:52", "text": "接着剤を全部買い取らないといけないので"}, {"type": "subtitle", "time": 19675.788, "timestamp": "05:27:55", "text": "文字通り彼の全てを買い取ってくれ"}]
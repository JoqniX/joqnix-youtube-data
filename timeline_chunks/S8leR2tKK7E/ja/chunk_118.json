[{"type": "subtitle", "time": 7080.629, "timestamp": "01:58:00", "text": "人間は"}, {"type": "subtitle", "time": 7082.629, "timestamp": "01:58:02", "text": "それらすべてを管理できるだろう"}, {"type": "subtitle", "time": 7089.79, "timestamp": "01:58:09", "text": "一緒に私はしない"}, {"type": "subtitle", "time": 7093.83, "timestamp": "01:58:13", "text": "わかってる、そして燃え尽き症候群だと思う"}, {"type": "subtitle", "time": 7098.39, "timestamp": "01:58:18", "text": "実際、これらすべてから一度は。えっと、私は"}, {"type": "subtitle", "time": 7100.07, "timestamp": "01:58:20", "text": "わからない。いつだったか覚えていない。うん、"}, {"type": "subtitle", "time": 7104.629, "timestamp": "01:58:24", "text": "その日、あなたは"}, {"type": "subtitle", "time": 7107.99, "timestamp": "01:58:27", "text": "ゲームPCがプレイ後に故障してからしばらく経ちました"}, {"type": "subtitle", "time": 7110.79, "timestamp": "01:58:30", "text": "あのリアルなシューティングゲーム。思うに"}, {"type": "subtitle", "time": 7114.95, "timestamp": "01:58:34", "text": "準備ができていないと言われました、あるいは私が"}, {"type": "subtitle", "time": 7118.149, "timestamp": "01:58:38", "text": "忘れてた、本当に本当に"}, {"type": "subtitle", "time": 7121.51, "timestamp": "01:58:41", "text": "リアルなシューティングゲーム。"}, {"type": "subtitle", "time": 7125.91, "timestamp": "01:58:45", "text": "それが原因であなたのパソコンは壊れました。 M 私は感じる"}, {"type": "subtitle", "time": 7128.31, "timestamp": "01:58:48", "text": "それはPCにとって負荷が大きすぎた"}, {"type": "subtitle", "time": 7131.35, "timestamp": "01:58:51", "text": "扱うけど、それが何なのかも分かっている"}, {"type": "subtitle", "time": 7134.229, "timestamp": "01:58:54", "text": "6年経ったので、ついに"}, {"type": "subtitle", "time": 7137.99, "timestamp": "01:58:57", "text": "生命維持装置があったので、公平だった"}]
[{"type": "subtitle", "time": 12601.389, "timestamp": "03:30:01", "text": "しかし、"}, {"type": "subtitle", "time": 12604.99, "timestamp": "03:30:04", "text": "ワイヤレスアクセス"}, {"type": "subtitle", "time": 12608.75, "timestamp": "03:30:08", "text": "取り消された"}, {"type": "subtitle", "time": 12614.469, "timestamp": "03:30:14", "text": "ええと、会社はなくなってしまいました。"}, {"type": "subtitle", "time": 12618.429, "timestamp": "03:30:18", "text": "私は悲しかったけれど、"}, {"type": "subtitle", "time": 12620.11, "timestamp": "03:30:20", "text": "期待していた"}, {"type": "subtitle", "time": 12625.19, "timestamp": "03:30:25", "text": "どうにかしてまだチャンスはあるかもしれない。しかし"}, {"type": "subtitle", "time": 12626.349, "timestamp": "03:30:26", "text": "私"}, {"type": "subtitle", "time": 12627.83, "timestamp": "03:30:27", "text": "理解する"}, {"type": "subtitle", "time": 12629.87, "timestamp": "03:30:29", "text": "[音楽]"}, {"type": "subtitle", "time": 12645.389, "timestamp": "03:30:45", "text": "プレーヤー。願わくば"}, {"type": "subtitle", "time": 12649.91, "timestamp": "03:30:49", "text": "心配しなくて済むならいいのに"}, {"type": "subtitle", "time": 12652.269, "timestamp": "03:30:52", "text": "これらのことと"}]
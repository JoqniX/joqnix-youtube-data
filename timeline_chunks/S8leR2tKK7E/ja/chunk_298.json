[{"type": "subtitle", "time": 17883.67, "timestamp": "04:58:03", "text": "何？ついにレベルアップしました"}, {"type": "subtitle", "time": 17887.15, "timestamp": "04:58:07", "text": "レベルは私の"}, {"type": "subtitle", "time": 17891.15, "timestamp": "04:58:11", "text": "2番目のストリーム。"}, {"type": "subtitle", "time": 17905.43, "timestamp": "04:58:25", "text": "それ？まだ実感が湧かない"}, {"type": "subtitle", "time": 17908.47, "timestamp": "04:58:28", "text": "ええ、今はむしろより高いレベルにいます。"}, {"type": "subtitle", "time": 17913.47, "timestamp": "04:58:33", "text": "私はレベル9ではありませんが、"}, {"type": "subtitle", "time": 17917.67, "timestamp": "04:58:37", "text": "しかし、私はそれを2番目のストリームに残しました。"}, {"type": "subtitle", "time": 17919.628, "timestamp": "04:58:39", "text": "それで"}, {"type": "subtitle", "time": 17922.788, "timestamp": "04:58:42", "text": "うん、ちょっと嬉しいけど、"}, {"type": "subtitle", "time": 17932.708, "timestamp": "04:58:52", "text": "うん。とにかく、スケジュールもあります"}, {"type": "subtitle", "time": 17934.11, "timestamp": "04:58:54", "text": "これ"}, {"type": "subtitle", "time": 17935.628, "timestamp": "04:58:55", "text": "週。"}, {"type": "subtitle", "time": 17939.03, "timestamp": "04:58:59", "text": "うん。つまり、どうやらそれは"}]
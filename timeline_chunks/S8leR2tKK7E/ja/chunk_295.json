[{"type": "subtitle", "time": 17739.47, "timestamp": "04:55:39", "text": "うん。こんにちは"}, {"type": "subtitle", "time": 17741.59, "timestamp": "04:55:41", "text": "みんな。うん。こんにちは。うん。こんにちは。"}, {"type": "subtitle", "time": 17742.67, "timestamp": "04:55:42", "text": "うん。"}, {"type": "subtitle", "time": 17751.55, "timestamp": "04:55:51", "text": "神。元気。君たちは何をしているの？"}, {"type": "subtitle", "time": 17753.91, "timestamp": "04:55:53", "text": "良い？皆さんお元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 17755.55, "timestamp": "04:55:55", "text": "今日は"}, {"type": "subtitle", "time": 17759.628, "timestamp": "04:55:59", "text": "17日日曜日"}]
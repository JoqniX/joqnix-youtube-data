[{"type": "subtitle", "time": 5163.99, "timestamp": "01:26:03", "text": "私もそこにいたらよかったのに。"}, {"type": "subtitle", "time": 5167.03, "timestamp": "01:26:07", "text": "いつでもコラボレーションを設定できます。"}, {"type": "subtitle", "time": 5169.59, "timestamp": "01:26:09", "text": "うん。それか、ぶらぶらしたりとか。"}, {"type": "subtitle", "time": 5171.43, "timestamp": "01:26:11", "text": "絶対に。私はいつも、"}, {"type": "subtitle", "time": 5173.75, "timestamp": "01:26:13", "text": "ほら、リラックスしたりコラボしたり"}, {"type": "subtitle", "time": 5176.31, "timestamp": "01:26:16", "text": "旅行や"}, {"type": "subtitle", "time": 5182.47, "timestamp": "01:26:22", "text": "[音楽]"}, {"type": "subtitle", "time": 5185.91, "timestamp": "01:26:25", "text": "それで、先輩、"}, {"type": "subtitle", "time": 5187.51, "timestamp": "01:26:27", "text": "楽しみにしていることは何ですか"}, {"type": "subtitle", "time": 5193.42, "timestamp": "01:26:33", "text": "ええと、いい質問ですね。"}, {"type": "subtitle", "time": 5196.03, "timestamp": "01:26:36", "text": "[音楽]"}, {"type": "subtitle", "time": 5199.59, "timestamp": "01:26:39", "text": "えっと、全部言いたいんです。"}, {"type": "subtitle", "time": 5203.99, "timestamp": "01:26:43", "text": "うん。日本に行くことは夢でした"}, {"type": "subtitle", "time": 5208.39, "timestamp": "01:26:48", "text": "私のものです。まさか自分が"}, {"type": "subtitle", "time": 5209.91, "timestamp": "01:26:49", "text": "そして"}, {"type": "subtitle", "time": 5218.79, "timestamp": "01:26:58", "text": "だから、私はあなたのことをとても誇りに思っているし、とても嬉しい。"}]
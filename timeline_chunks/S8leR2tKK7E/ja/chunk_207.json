[{"type": "subtitle", "time": 12420.75, "timestamp": "03:27:00", "text": "これについて私は"}, {"type": "subtitle", "time": 12426.03, "timestamp": "03:27:06", "text": "たくさん、たくさん注意して"}, {"type": "subtitle", "time": 12430.99, "timestamp": "03:27:10", "text": "人々が"}, {"type": "subtitle", "time": 12437.83, "timestamp": "03:27:17", "text": "憎しみや有害な言動など。"}, {"type": "subtitle", "time": 12441.469, "timestamp": "03:27:21", "text": "これまで私が配信した時は"}, {"type": "subtitle", "time": 12443.469, "timestamp": "03:27:23", "text": "のために"}, {"type": "subtitle", "time": 12449.95, "timestamp": "03:27:29", "text": "ストリーミング配信はいいえ、みんな親切で"}, {"type": "subtitle", "time": 12452.75, "timestamp": "03:27:32", "text": "受け入れます。しかし"}, {"type": "subtitle", "time": 12457.79, "timestamp": "03:27:37", "text": "うん、動画を撮る瞬間"}, {"type": "subtitle", "time": 12461.71, "timestamp": "03:27:41", "text": "コンテンツ ビデオ コンテンツについて"}, {"type": "subtitle", "time": 12466.469, "timestamp": "03:27:46", "text": "私はそれを感じることができる。"}, {"type": "subtitle", "time": 12471.389, "timestamp": "03:27:51", "text": "何人かの人に届くでしょう"}]
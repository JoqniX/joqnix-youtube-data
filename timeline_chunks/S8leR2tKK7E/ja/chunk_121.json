[{"type": "subtitle", "time": 7260.87, "timestamp": "02:01:00", "text": "壊す。ストリーミング配信する必要はありません。あなた"}, {"type": "subtitle", "time": 7262.31, "timestamp": "02:01:02", "text": "こうである必要はない"}, {"type": "subtitle", "time": 7264.629, "timestamp": "02:01:04", "text": "公のペルソナ、そして戻ってきたとき"}, {"type": "subtitle", "time": 7267.669, "timestamp": "02:01:07", "text": "気分が良くなりましたね。そして正直に言うと"}, {"type": "subtitle", "time": 7270.55, "timestamp": "02:01:10", "text": "大きな違いを生むのは、"}, {"type": "subtitle", "time": 7272.87, "timestamp": "02:01:12", "text": "それは私が個人的に好きなものです"}, {"type": "subtitle", "time": 7274.87, "timestamp": "02:01:14", "text": "私も同じ経験をしました。まるで私が"}, {"type": "subtitle", "time": 7276.79, "timestamp": "02:01:16", "text": "無理やり配信しようとした"}, {"type": "subtitle", "time": 7278.87, "timestamp": "02:01:18", "text": "精神的に調子が悪かった時、"}, {"type": "subtitle", "time": 7281.109, "timestamp": "02:01:21", "text": "身体的に健康で、川は"}, {"type": "subtitle", "time": 7282.87, "timestamp": "02:01:22", "text": "また不快で、その間の私の気分も"}, {"type": "subtitle", "time": 7285.35, "timestamp": "02:01:25", "text": "川も不快で、"}, {"type": "subtitle", "time": 7287.669, "timestamp": "02:01:27", "text": "また、"}, {"type": "subtitle", "time": 7289.51, "timestamp": "02:01:29", "text": "特定の人を知っているように、"}, {"type": "subtitle", "time": 7291.35, "timestamp": "02:01:31", "text": "コミュニティまたはコミュニティ自体が"}, {"type": "subtitle", "time": 7293.91, "timestamp": "02:01:33", "text": "私に対して非常に否定的で、"}, {"type": "subtitle", "time": 7296.83, "timestamp": "02:01:36", "text": "それも私に辞めさせようとしている。"}, {"type": "subtitle", "time": 7300.149, "timestamp": "02:01:40", "text": "でも結局は、"}, {"type": "subtitle", "time": 7303.27, "timestamp": "02:01:43", "text": "インターネットやストリーミングだけにとどまらない。"}, {"type": "subtitle", "time": 7305.83, "timestamp": "02:01:45", "text": "人生には、たとえ"}, {"type": "subtitle", "time": 7308.629, "timestamp": "02:01:48", "text": "それはこれらすべてと人々を超えるものになるのだろうか"}, {"type": "subtitle", "time": 7311.91, "timestamp": "02:01:51", "text": "まるで自分の"}, {"type": "subtitle", "time": 7315.109, "timestamp": "02:01:55", "text": "インターネット上での自分自身と、自分自身であること"}, {"type": "subtitle", "time": 7316.709, "timestamp": "02:01:56", "text": "それらは機能することができない"}, {"type": "subtitle", "time": 7319.149, "timestamp": "02:01:59", "text": "社会における普通の人間と"}]
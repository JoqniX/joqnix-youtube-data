[{"type": "subtitle", "time": 11226.15, "timestamp": "03:07:06", "text": "自分。誰も教えてくれなかった。"}, {"type": "subtitle", "time": 11228.469, "timestamp": "03:07:08", "text": "えーと、ビデオを分析して、音声を分析して"}, {"type": "subtitle", "time": 11233.11, "timestamp": "03:07:13", "text": "そして英語の字幕を取得して、"}, {"type": "subtitle", "time": 11235.95, "timestamp": "03:07:15", "text": "翻訳"}, {"type": "subtitle", "time": 11238.71, "timestamp": "03:07:18", "text": "問題は、編集しないことです"}, {"type": "subtitle", "time": 11251.91, "timestamp": "03:07:31", "text": "する？私が金持ちだと思う？あなたは私が"}, {"type": "subtitle", "time": 11255.03, "timestamp": "03:07:35", "text": "裕福なビデオエディターを雇える"}, {"type": "subtitle", "time": 11257.19, "timestamp": "03:07:37", "text": "助けて？会社は、単に"}, {"type": "subtitle", "time": 11258.469, "timestamp": "03:07:38", "text": "放送は考慮できない"}, {"type": "subtitle", "time": 11260.83, "timestamp": "03:07:40", "text": "効率的。同社は、"}, {"type": "subtitle", "time": 11263.91, "timestamp": "03:07:43", "text": "シンプルな放送と放送"}, {"type": "subtitle", "time": 11268.11, "timestamp": "03:07:48", "text": "FS 有効とはみなせない"}, {"type": "subtitle", "time": 11270.71, "timestamp": "03:07:50", "text": "サービス。本当にその通りで残念なことに"}, {"type": "subtitle", "time": 11272.349, "timestamp": "03:07:52", "text": "これ"}]
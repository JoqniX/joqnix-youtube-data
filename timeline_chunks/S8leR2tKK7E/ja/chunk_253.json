[{"type": "subtitle", "time": 15210.59, "timestamp": "04:13:30", "text": "次に、それらを組み込む必要がある。"}, {"type": "subtitle", "time": 15212.429, "timestamp": "04:13:32", "text": "えっと、"}, {"type": "subtitle", "time": 15215.469, "timestamp": "04:13:35", "text": "彼らと"}, {"type": "subtitle", "time": 15220.189, "timestamp": "04:13:40", "text": "魚を仕上げる方法"}, {"type": "subtitle", "time": 15222.91, "timestamp": "04:13:42", "text": "誰もが許可する"}, {"type": "subtitle", "time": 15225.87, "timestamp": "04:13:45", "text": "など"}, {"type": "subtitle", "time": 15231.51, "timestamp": "04:13:51", "text": "21日または21日に"}]
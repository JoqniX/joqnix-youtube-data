[{"type": "subtitle", "time": 3672.349, "timestamp": "01:01:12", "text": "とにかく、皆さんこんにちは。私は戻ってきました"}, {"type": "subtitle", "time": 3675.19, "timestamp": "01:01:15", "text": "夕食。さて、本日のスペシャルゲストは"}, {"type": "subtitle", "time": 3678.309, "timestamp": "01:01:18", "text": "今夜のために。ここにはセレスティア・ヴォイドがいます"}, {"type": "subtitle", "time": 3682.15, "timestamp": "01:01:22", "text": "私たちと一緒に。こんにちは、セレスティア。"}, {"type": "subtitle", "time": 3684.309, "timestamp": "01:01:24", "text": "こんにちは、先輩。どうもありがとうございました"}, {"type": "subtitle", "time": 3688.15, "timestamp": "01:01:28", "text": "私をここに招待してくれた。大変光栄です。"}, {"type": "subtitle", "time": 3689.91, "timestamp": "01:01:29", "text": "こんにちは。こんにちは。"}, {"type": "subtitle", "time": 3693.589, "timestamp": "01:01:33", "text": "いいえ、それは私たちにとって光栄なことです"}, {"type": "subtitle", "time": 3697.19, "timestamp": "01:01:37", "text": "ちゃんとしたコラボレーションと言えるでしょうね。史上初"}, {"type": "subtitle", "time": 3699.67, "timestamp": "01:01:39", "text": "方法。つまり、私たちは以前にもコラボレーションしたことがあるし、"}, {"type": "subtitle", "time": 3702.789, "timestamp": "01:01:42", "text": "でも、私たちは腰を据えて話し合ったことはないんです"}, {"type": "subtitle", "time": 3705.51, "timestamp": "01:01:45", "text": "以前、配信で。ええ、まだです"}, {"type": "subtitle", "time": 3708.63, "timestamp": "01:01:48", "text": "やったよ。はい。おかしいよ、だって私は"}, {"type": "subtitle", "time": 3711.589, "timestamp": "01:01:51", "text": "あなたとはも​​う4年以上知り合いですね。"}, {"type": "subtitle", "time": 3713.87, "timestamp": "01:01:53", "text": "そう、4つ"}, {"type": "subtitle", "time": 3718.549, "timestamp": "01:01:58", "text": "年。最近は時間が経つのが本当に早いですね。"}]
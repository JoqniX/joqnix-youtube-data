[{"type": "subtitle", "time": 1145.19, "timestamp": "00:19:05", "text": "良い。新しいファンはまだ私を見たことがないだけだ。"}, {"type": "subtitle", "time": 1147.029, "timestamp": "00:19:07", "text": "Onx、始めよう。待って、どういう意味ですか、"}, {"type": "subtitle", "time": 1157.15, "timestamp": "00:19:17", "text": "平均？お元気でしたね。では"}, {"type": "subtitle", "time": 1160.59, "timestamp": "00:19:20", "text": "あなた？私は"}, {"type": "subtitle", "time": 1162.54, "timestamp": "00:19:22", "text": "だけでなく"}, {"type": "subtitle", "time": 1165.07, "timestamp": "00:19:25", "text": "[音楽]"}, {"type": "subtitle", "time": 1167.23, "timestamp": "00:19:27", "text": "いつも。なぜ"}, {"type": "subtitle", "time": 1172.029, "timestamp": "00:19:32", "text": "アヌキ？あなたは怒っていましたか？なし"}, {"type": "subtitle", "time": 1181.27, "timestamp": "00:19:41", "text": "怒り？犬が独り言を言っている。待って、"}, {"type": "subtitle", "time": 1182.83, "timestamp": "00:19:42", "text": "あなたは何を"}, {"type": "subtitle", "time": 1187.83, "timestamp": "00:19:47", "text": "平均？いいえ。いいえ。では、次は、えーと"}, {"type": "subtitle", "time": 1190.789, "timestamp": "00:19:50", "text": "ええ、水曜日にそのことを言いました"}, {"type": "subtitle", "time": 1194.71, "timestamp": "00:19:54", "text": "休憩時間があり、私は"}, {"type": "subtitle", "time": 1197.11, "timestamp": "00:19:57", "text": "Twitchのonxアカウントで配信中"}]
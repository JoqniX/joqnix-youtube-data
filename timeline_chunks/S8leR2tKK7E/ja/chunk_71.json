[{"type": "subtitle", "time": 4260.87, "timestamp": "01:11:00", "text": "はい、はい、私は愛されるでしょう、私は愛します"}, {"type": "subtitle", "time": 4264.35, "timestamp": "01:11:04", "text": "参加したり、いろいろしたり。だから驚いた"}, {"type": "subtitle", "time": 4267.27, "timestamp": "01:11:07", "text": "自分。もちろん。ええ、あなたは素晴らしい"}, {"type": "subtitle", "time": 4268.87, "timestamp": "01:11:08", "text": "人、先輩。あなたは与えないと思います"}, {"type": "subtitle", "time": 4272.47, "timestamp": "01:11:12", "text": "正直言って、あなたは十分に自分を評価しているよ。私"}, {"type": "subtitle", "time": 4275.27, "timestamp": "01:11:15", "text": "つまり、私は今まで人に会ったことがないし、"}, {"type": "subtitle", "time": 4277.59, "timestamp": "01:11:17", "text": "何か"}, {"type": "subtitle", "time": 4280.55, "timestamp": "01:11:20", "text": "あなたについて悪いことを言うのは良くない。"}, {"type": "subtitle", "time": 4284.229, "timestamp": "01:11:24", "text": "なぜ？いいえ、たくさんありますよ。あなたは何を"}, {"type": "subtitle", "time": 4286.07, "timestamp": "01:11:26", "text": "平均？私は彼らに会ったことがありません。彼らはそうしない"}, {"type": "subtitle", "time": 4291.35, "timestamp": "01:11:31", "text": "それらは存在しない。でも、"}, {"type": "subtitle", "time": 4293.189, "timestamp": "01:11:33", "text": "周りに人がいないとき"}, {"type": "subtitle", "time": 4295.35, "timestamp": "01:11:35", "text": "素晴らしいことを言いたい"}, {"type": "subtitle", "time": 4297.43, "timestamp": "01:11:37", "text": "あなたについて、そしてそれは私にとって"}, {"type": "subtitle", "time": 4298.95, "timestamp": "01:11:38", "text": "個人的に気づいたのは、"}, {"type": "subtitle", "time": 4300.75, "timestamp": "01:11:40", "text": "あなたはとても寛大な人で、"}, {"type": "subtitle", "time": 4303.189, "timestamp": "01:11:43", "text": "心優しい。これまで一度も"}, {"type": "subtitle", "time": 4305.27, "timestamp": "01:11:45", "text": "誰かが助けを求めたとき"}, {"type": "subtitle", "time": 4307.99, "timestamp": "01:11:47", "text": "そして、私を含めて誰も志願していない"}, {"type": "subtitle", "time": 4309.91, "timestamp": "01:11:49", "text": "さらに、文字通り"}, {"type": "subtitle", "time": 4313.03, "timestamp": "01:11:53", "text": "ほら、みんながそう見えるでしょ"}, {"type": "subtitle", "time": 4315.59, "timestamp": "01:11:55", "text": "インドのユーチューバーを連れてこようとしています"}, {"type": "subtitle", "time": 4318.55, "timestamp": "01:11:58", "text": "コミュニティに溶け込むことで、"}]
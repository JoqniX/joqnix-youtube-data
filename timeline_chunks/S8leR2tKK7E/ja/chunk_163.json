[{"type": "subtitle", "time": 9781.23, "timestamp": "02:43:01", "text": "リー、元気ですか？"}, {"type": "subtitle", "time": 9788.55, "timestamp": "02:43:08", "text": "その間。会社に確認してみます。"}, {"type": "subtitle", "time": 9801.349, "timestamp": "02:43:21", "text": "電話？私のイノネスが見つかりません。ああ、そこ"}, {"type": "subtitle", "time": 9810.99, "timestamp": "02:43:30", "text": "あなた。会社に確認してみます。わかった。"}, {"type": "subtitle", "time": 9815.59, "timestamp": "02:43:35", "text": "えっと、もしレレに手伝ってもらって"}, {"type": "subtitle", "time": 9819.19, "timestamp": "02:43:39", "text": "代表者として、そして私の代表者として。話す"}, {"type": "subtitle", "time": 9821.23, "timestamp": "02:43:41", "text": "次に"}, {"type": "subtitle", "time": 9824.51, "timestamp": "02:43:44", "text": "会社。だから彼女は"}, {"type": "subtitle", "time": 9828.79, "timestamp": "02:43:48", "text": "彼女は私の中国人スタッフかもしれない"}, {"type": "subtitle", "time": 9830.309, "timestamp": "02:43:50", "text": "または私を表すもの、または"}, {"type": "subtitle", "time": 9832.389, "timestamp": "02:43:52", "text": "そんな感じ。それは役に立つかもしれない"}, {"type": "subtitle", "time": 9836.15, "timestamp": "02:43:56", "text": "ホワイトリストに登録されている仲介業者を通して。しかしもし"}]
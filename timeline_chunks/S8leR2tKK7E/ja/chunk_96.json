[{"type": "subtitle", "time": 5765.51, "timestamp": "01:36:05", "text": "つまり、それは私が"}, {"type": "subtitle", "time": 5767.35, "timestamp": "01:36:07", "text": "楽しむ。私は本当に好きだと言いたい"}, {"type": "subtitle", "time": 5771.11, "timestamp": "01:36:11", "text": "セレスティアであること、でも時々私の"}, {"type": "subtitle", "time": 5774.629, "timestamp": "01:36:14", "text": "状況によりストリーミング配信ができず、"}, {"type": "subtitle", "time": 5777.189, "timestamp": "01:36:17", "text": "それは残念ですが、私の"}, {"type": "subtitle", "time": 5779.99, "timestamp": "01:36:19", "text": "コミュニティのメンバーはとても寛容です"}, {"type": "subtitle", "time": 5782.47, "timestamp": "01:36:22", "text": "そして、私が来るたびにとても素敵です"}, {"type": "subtitle", "time": 5784.229, "timestamp": "01:36:24", "text": "戻ってきたら、彼らは私を歓迎するためにそこにいた"}, {"type": "subtitle", "time": 5787.669, "timestamp": "01:36:27", "text": "戻る。ああ。だから、それは良い"}, {"type": "subtitle", "time": 5790.629, "timestamp": "01:36:30", "text": "経験。まるで"}, {"type": "subtitle", "time": 5793.27, "timestamp": "01:36:33", "text": "激動の経験。まるで私が"}, {"type": "subtitle", "time": 5796.149, "timestamp": "01:36:36", "text": "良い時もあれば、悪い時もあったし、"}, {"type": "subtitle", "time": 5798.229, "timestamp": "01:36:38", "text": "ストリーム配信をしていた時のような時間がありました"}, {"type": "subtitle", "time": 5800.35, "timestamp": "01:36:40", "text": "数ヶ月くらい。"}, {"type": "subtitle", "time": 5802.87, "timestamp": "01:36:42", "text": "そして私の人生でも、"}, {"type": "subtitle", "time": 5804.95, "timestamp": "01:36:44", "text": "このような大きな劇的変化を通して"}, {"type": "subtitle", "time": 5808.709, "timestamp": "01:36:48", "text": "過去4年間で。そしてそれは一種の"}, {"type": "subtitle", "time": 5810.79, "timestamp": "01:36:50", "text": "興味深いことに、"}, {"type": "subtitle", "time": 5812.95, "timestamp": "01:36:52", "text": "セレスティアは、"}, {"type": "subtitle", "time": 5819.75, "timestamp": "01:36:59", "text": "うん、あなたが"}]
[{"type": "subtitle", "time": 10388.03, "timestamp": "02:53:08", "text": "セクション。ああ、"}, {"type": "subtitle", "time": 10394.51, "timestamp": "02:53:14", "text": "なぜそうなるのか"}, {"type": "subtitle", "time": 10397.349, "timestamp": "02:53:17", "text": "気味の悪い？なぜこんなに不気味なの？何てことだ、"}, {"type": "subtitle", "time": 10399.15, "timestamp": "02:53:19", "text": "それはすごく不気味だ。"}, {"type": "subtitle", "time": 10403.19, "timestamp": "02:53:23", "text": "わかった。何てことだ。わかった。いや、それじゃない。"}, {"type": "subtitle", "time": 10410.389, "timestamp": "02:53:30", "text": "セッション。どうすれば元に戻せるのか？どうやって"}, {"type": "subtitle", "time": 10411.71, "timestamp": "02:53:31", "text": "それ"}, {"type": "subtitle", "time": 10415.79, "timestamp": "02:53:35", "text": "戻る？私には理解できません。どう言えばいいかな"}, {"type": "subtitle", "time": 10417.309, "timestamp": "02:53:37", "text": "戻る？"}, {"type": "subtitle", "time": 10421.03, "timestamp": "02:53:41", "text": "待って。私には理解できません。待って。それで"}, {"type": "subtitle", "time": 10423.63, "timestamp": "02:53:43", "text": "それは"}, {"type": "subtitle", "time": 10434.389, "timestamp": "02:53:54", "text": "アイテム。ああ、それは多すぎる。なぜなら私は"}, {"type": "subtitle", "time": 10437.11, "timestamp": "02:53:57", "text": "彼女が調査をしたいかどうか検索する"}, {"type": "subtitle", "time": 10439.63, "timestamp": "02:53:59", "text": "彼女は多くのことを考慮に入れなかった"}]
[{"type": "subtitle", "time": 4320.709, "timestamp": "01:12:00", "text": "何て言うか認められたような気分で"}, {"type": "subtitle", "time": 4323.27, "timestamp": "01:12:03", "text": "コンテンツクリエイターの一部として含まれる"}, {"type": "subtitle", "time": 4324.189, "timestamp": "01:12:04", "text": "で"}, {"type": "subtitle", "time": 4326.229, "timestamp": "01:12:06", "text": "将軍だから人々はこう呼ぶと思う"}, {"type": "subtitle", "time": 4330.229, "timestamp": "01:12:10", "text": "あなたはインド人ユーチューバーのママですね。"}, {"type": "subtitle", "time": 4332.669, "timestamp": "01:12:12", "text": "ああ、どうすればいいのかわからない"}, {"type": "subtitle", "time": 4336.189, "timestamp": "01:12:16", "text": "言う。それはたくさん それはたくさん"}, {"type": "subtitle", "time": 4346.03, "timestamp": "01:12:26", "text": "ありがとう。でも、理由は分からないんです。"}, {"type": "subtitle", "time": 4348.709, "timestamp": "01:12:28", "text": "ええ、おっしゃる通り、私は"}, {"type": "subtitle", "time": 4350.79, "timestamp": "01:12:30", "text": "私自身の功績です。なぜだかわからない"}, {"type": "subtitle", "time": 4352.75, "timestamp": "01:12:32", "text": "しないで"}, {"type": "subtitle", "time": 4355.99, "timestamp": "01:12:35", "text": "それ。偽物だからかもしれない"}, {"type": "subtitle", "time": 4358.229, "timestamp": "01:12:38", "text": "症候群？わからない。"}, {"type": "subtitle", "time": 4360.229, "timestamp": "01:12:40", "text": "私は前立腺の奥深くにそれを感じています"}, {"type": "subtitle", "time": 4362.87, "timestamp": "01:12:42", "text": "即興かな"}, {"type": "subtitle", "time": 4364.87, "timestamp": "01:12:44", "text": "なぜあなたがここにいるのか理解してください"}, {"type": "subtitle", "time": 4367.03, "timestamp": "01:12:47", "text": "ほとんどの人よりも長くコミュニティにいる"}, {"type": "subtitle", "time": 4369.75, "timestamp": "01:12:49", "text": "知る。"}, {"type": "subtitle", "time": 4373.59, "timestamp": "01:12:53", "text": "まあ、私にとっては、"}, {"type": "subtitle", "time": 4377.11, "timestamp": "01:12:57", "text": "期間または年数ではなく、"}, {"type": "subtitle", "time": 4379.31, "timestamp": "01:12:59", "text": "あまり重要ではない"}]
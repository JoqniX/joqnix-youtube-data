[{"type": "subtitle", "time": 3180.49, "timestamp": "00:53:00", "text": "何かに影響を与える、"}, {"type": "subtitle", "time": 3191.84, "timestamp": "00:53:11", "text": "でも、正直に言うと、私はそうは言っていません。"}, {"type": "subtitle", "time": 3193.71, "timestamp": "00:53:13", "text": "[音楽]"}, {"type": "subtitle", "time": 3196.47, "timestamp": "00:53:16", "text": "正直に言うと、どうすればいいのかわかりません"}, {"type": "subtitle", "time": 3202.01, "timestamp": "00:53:22", "text": "これ。私は話しません"}, {"type": "subtitle", "time": 3203.71, "timestamp": "00:53:23", "text": "[音楽]"}, {"type": "subtitle", "time": 3213.109, "timestamp": "00:53:33", "text": "けれど。私は自分が意地悪なことを言っているのは分かっています"}, {"type": "subtitle", "time": 3215.95, "timestamp": "00:53:35", "text": "ここにいるが、それでも。しかしそれでも"}, {"type": "subtitle", "time": 3219.069, "timestamp": "00:53:39", "text": "けれど。しかし、それでも。"}, {"type": "subtitle", "time": 3222.349, "timestamp": "00:53:42", "text": "えっと。私がやっている努力は"}, {"type": "subtitle", "time": 3225.549, "timestamp": "00:53:45", "text": "不必要で"}, {"type": "subtitle", "time": 3228.309, "timestamp": "00:53:48", "text": "くそっ。この努力をすればよかったのに"}, {"type": "subtitle", "time": 3230.79, "timestamp": "00:53:50", "text": "作成中。もしそれが"}, {"type": "subtitle", "time": 3233.27, "timestamp": "00:53:53", "text": "ストリーミング配信の方が良かっただろう。なぜ"}, {"type": "subtitle", "time": 3236.109, "timestamp": "00:53:56", "text": "私は研磨するべきでしょうか？"}, {"type": "subtitle", "time": 3239.2, "timestamp": "00:53:59", "text": "ああ、そうだね。私が嫌っている兆候"}]
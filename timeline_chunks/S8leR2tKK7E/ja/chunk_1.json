[{"type": "subtitle", "time": 60.389, "timestamp": "00:01:00", "text": "今は、合併症のため"}, {"type": "subtitle", "time": 63.43, "timestamp": "00:01:03", "text": "彼女の側からは、"}, {"type": "subtitle", "time": 65.75, "timestamp": "00:01:05", "text": "それ。確認メールが届いていません"}, {"type": "subtitle", "time": 69.51, "timestamp": "00:01:09", "text": "彼女がその後私たちに加わるかどうか"}, {"type": "subtitle", "time": 71.91, "timestamp": "00:01:11", "text": "Celesteとのコラボレーションは"}, {"type": "subtitle", "time": 75.27, "timestamp": "00:01:15", "text": "午後10時セレスティアを実際に動かすかもしれない"}, {"type": "subtitle", "time": 78.31, "timestamp": "00:01:18", "text": "コラボレーションを少し早めに"}, {"type": "subtitle", "time": 80.63, "timestamp": "00:01:20", "text": "昼食、いや夕食を食べ終えた。"}, {"type": "subtitle", "time": 85.07, "timestamp": "00:01:25", "text": "じゃあ、夕食とか食べに行くね"}, {"type": "subtitle", "time": 88.95, "timestamp": "00:01:28", "text": "今。えっと、"}, {"type": "subtitle", "time": 92.069, "timestamp": "00:01:32", "text": "えーと、夕食に行くんだけど、"}, {"type": "subtitle", "time": 96.91, "timestamp": "00:01:36", "text": "えーと、次の実験は"}, {"type": "chat", "time": 100.765, "timestamp": "00:01:40", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "going for dinner, next collab is by 9:30pm ~"}]
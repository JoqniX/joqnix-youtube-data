[{"type": "subtitle", "time": 6722.709, "timestamp": "01:52:02", "text": "4月はピンク、5月は白"}, {"type": "subtitle", "time": 6727.589, "timestamp": "01:52:07", "text": "6月は最後のことです。何てことだ、"}, {"type": "subtitle", "time": 6729.91, "timestamp": "01:52:09", "text": "それはとても興味深いですね。私は決して"}, {"type": "subtitle", "time": 6733.91, "timestamp": "01:52:13", "text": "それらの色には意味があることを知っていた。"}, {"type": "subtitle", "time": 6736.47, "timestamp": "01:52:16", "text": "ああ、彼らは青いものから来たような"}, {"type": "subtitle", "time": 6738.87, "timestamp": "01:52:18", "text": "左目と紫は右目です"}, {"type": "subtitle", "time": 6742.149, "timestamp": "01:52:22", "text": "目。ピンクはパーカーの色になります。"}, {"type": "subtitle", "time": 6744.79, "timestamp": "01:52:24", "text": "髪は白くなる"}, {"type": "subtitle", "time": 6746.87, "timestamp": "01:52:26", "text": "なぜなら、あなたは色で"}, {"type": "subtitle", "time": 6750.31, "timestamp": "01:52:30", "text": "星座のことですよね？"}, {"type": "subtitle", "time": 6751.83, "timestamp": "01:52:31", "text": "まあ、あなたも"}, {"type": "subtitle", "time": 6754.75, "timestamp": "01:52:34", "text": "数ヶ月間関連している"}, {"type": "subtitle", "time": 6758.43, "timestamp": "01:52:38", "text": "色。とても独創的だ。何てことだ。私はしません"}, {"type": "subtitle", "time": 6761.51, "timestamp": "01:52:41", "text": "知る。それはまるで突発的なアイデアのようだった。私は"}, {"type": "subtitle", "time": 6764.229, "timestamp": "01:52:44", "text": "それはある意味で私が言っているような"}, {"type": "subtitle", "time": 6767.35, "timestamp": "01:52:47", "text": "このモデルともお別れです。しかし神は"}, {"type": "subtitle", "time": 6770.55, "timestamp": "01:52:50", "text": "私がいつデビューするかを知っている。だから、"}, {"type": "subtitle", "time": 6773.91, "timestamp": "01:52:53", "text": "つまり、秘密の見送りをしたかったのですが、"}, {"type": "subtitle", "time": 6777.91, "timestamp": "01:52:57", "text": "このモデルとのひとときのように、"}]
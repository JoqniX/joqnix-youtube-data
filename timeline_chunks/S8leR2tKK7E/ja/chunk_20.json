[{"type": "subtitle", "time": 1201.75, "timestamp": "00:20:01", "text": "木曜日に。それがアペック・アップ・フォー・レジェンズだ"}, {"type": "subtitle", "time": 1203.35, "timestamp": "00:20:03", "text": "伝説。"}, {"type": "subtitle", "time": 1206.39, "timestamp": "00:20:06", "text": "6時30分からApex Legendsをプレイします。"}, {"type": "subtitle", "time": 1218.83, "timestamp": "00:20:18", "text": "6:30から2～3時間の配信。はい。 3時間"}, {"type": "subtitle", "time": 1223.31, "timestamp": "00:20:23", "text": "ストリーム。 3時間になります"}, {"type": "subtitle", "time": 1227.669, "timestamp": "00:20:27", "text": "ストリーム。うん。それから、金曜日には"}, {"type": "subtitle", "time": 1231.029, "timestamp": "00:20:31", "text": "最後はまたもや源珍で締めくくります。しかし"}, {"type": "subtitle", "time": 1236.51, "timestamp": "00:20:36", "text": "うん、Twitchでは6時半から"}, {"type": "subtitle", "time": 1239.75, "timestamp": "00:20:39", "text": "12時頃。君の休憩は休憩じゃない。えっと、"}, {"type": "subtitle", "time": 1250.39, "timestamp": "00:20:50", "text": "えっと、あなたはブレーキの修理を担当します。つまり、あなたのことです"}, {"type": "subtitle", "time": 1255.47, "timestamp": "00:20:55", "text": "勤勉な。バ。待って。ベータ。待って。"}, {"type": "subtitle", "time": 1258.43, "timestamp": "00:20:58", "text": "バ。ベータ。"}]
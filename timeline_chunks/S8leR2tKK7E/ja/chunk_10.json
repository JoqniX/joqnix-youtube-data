[{"type": "subtitle", "time": 604.11, "timestamp": "00:10:04", "text": "えっと、何て言うんだっけ"}, {"type": "subtitle", "time": 608.31, "timestamp": "00:10:08", "text": "それ？えっと、本当に終わらせたかったんです"}, {"type": "subtitle", "time": 612.23, "timestamp": "00:10:12", "text": "ストーリークエストを進めてください。ずっと貯めていたんです。"}, {"type": "subtitle", "time": 614.75, "timestamp": "00:10:14", "text": "ストーリークエストをすべて積み重ねて"}, {"type": "subtitle", "time": 618.47, "timestamp": "00:10:18", "text": "原神は配信で一気にやる"}, {"type": "subtitle", "time": 620.35, "timestamp": "00:10:20", "text": "あなたと一緒に"}, {"type": "subtitle", "time": 622.949, "timestamp": "00:10:22", "text": "みんな。正直に言うと、理由はわかりません"}, {"type": "subtitle", "time": 625.19, "timestamp": "00:10:25", "text": "そして、これを伝えてください。私が原神をプレイするとき、"}, {"type": "subtitle", "time": 628.79, "timestamp": "00:10:28", "text": "会話に関しては、私は会話をスキップします"}, {"type": "subtitle", "time": 631.59, "timestamp": "00:10:31", "text": "稲妻のように超高速。スキップ、"}, {"type": "subtitle", "time": 634.47, "timestamp": "00:10:34", "text": "スキップ、スキップ。私はそれをしたくない。そして"}, {"type": "subtitle", "time": 636.91, "timestamp": "00:10:36", "text": "私は知りたい、私は知りたい"}, {"type": "subtitle", "time": 639.829, "timestamp": "00:10:39", "text": "話。私は何について知りたいのか"}, {"type": "subtitle", "time": 642.63, "timestamp": "00:10:42", "text": "しかし、それは起こった。私が何をしたか知ってる？"}, {"type": "subtitle", "time": 644.99, "timestamp": "00:10:44", "text": "何が起こるのか？何が起こったのか"}, {"type": "subtitle", "time": 647.75, "timestamp": "00:10:47", "text": "チンピラ？私はアーカイブに戻らなければならなかった"}, {"type": "subtitle", "time": 655.15, "timestamp": "00:10:55", "text": "スキップするから"}, {"type": "subtitle", "time": 658.47, "timestamp": "00:10:58", "text": "スキップ。だから、明日はベストを尽くします"}]
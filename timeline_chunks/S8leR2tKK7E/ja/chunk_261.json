[{"type": "subtitle", "time": 15660.71, "timestamp": "04:21:00", "text": "えーと、とてもたくさんの人がいるので"}, {"type": "subtitle", "time": 15665.389, "timestamp": "04:21:05", "text": "うーん、うーん、うーん"}, {"type": "subtitle", "time": 15669.75, "timestamp": "04:21:09", "text": "人々、私はたくさんの人が必要です"}, {"type": "subtitle", "time": 15673.95, "timestamp": "04:21:13", "text": "えっと、仕上げが必要です"}, {"type": "subtitle", "time": 15679.269, "timestamp": "04:21:19", "text": "前に、そして最初に、もし"}, {"type": "subtitle", "time": 15681.229, "timestamp": "04:21:21", "text": "私は"}, {"type": "subtitle", "time": 15682.29, "timestamp": "04:21:22", "text": "に"}, {"type": "subtitle", "time": 15692.59, "timestamp": "04:21:32", "text": "あらら。"}]
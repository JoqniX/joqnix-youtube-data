[{"type": "subtitle", "time": 7862.55, "timestamp": "02:11:02", "text": "私は信じない、なぜなら私は"}, {"type": "subtitle", "time": 7865.27, "timestamp": "02:11:05", "text": "現在、私も同じことをしています。でも私は"}, {"type": "subtitle", "time": 7868.55, "timestamp": "02:11:08", "text": "もっとそう思うけど、そうじゃない。"}, {"type": "subtitle", "time": 7870.069, "timestamp": "02:11:10", "text": "それは絶好の機会を逃したと考えるべきでしょう。私は感じる"}, {"type": "subtitle", "time": 7871.51, "timestamp": "02:11:11", "text": "まるで、"}, {"type": "subtitle", "time": 7874.39, "timestamp": "02:11:14", "text": "到着するだろうし、到着するはずだ。手に入れたと思います"}, {"type": "subtitle", "time": 7877.109, "timestamp": "02:11:17", "text": "たくさんの素晴らしい機会のように"}, {"type": "subtitle", "time": 7880.56, "timestamp": "02:11:20", "text": "これからあなたが勝利を収めることを願っています。"}, {"type": "subtitle", "time": 7894.95, "timestamp": "02:11:34", "text": "そして、このビデオでは、"}, {"type": "subtitle", "time": 7896.87, "timestamp": "02:11:36", "text": "空間？楽しんでいますか？あなたは"}, {"type": "subtitle", "time": 7898.629, "timestamp": "02:11:38", "text": "うん。"}, {"type": "subtitle", "time": 7901.75, "timestamp": "02:11:41", "text": "ええ、気に入っています。私は好きです"}, {"type": "subtitle", "time": 7903.75, "timestamp": "02:11:43", "text": "とても"}, {"type": "subtitle", "time": 7905.669, "timestamp": "02:11:45", "text": "面白い人たちで、彼らは"}, {"type": "subtitle", "time": 7908.229, "timestamp": "02:11:48", "text": "一緒に過ごすのが本当に楽しい人たち"}, {"type": "subtitle", "time": 7910.709, "timestamp": "02:11:50", "text": "そしてゲームをプレイしますが、"}, {"type": "subtitle", "time": 7912.709, "timestamp": "02:11:52", "text": "プレゼンテーションの仕方を気にしすぎる"}, {"type": "subtitle", "time": 7913.99, "timestamp": "02:11:53", "text": "あなた自身も、なぜなら彼ら全員も"}, {"type": "subtitle", "time": 7916.51, "timestamp": "02:11:56", "text": "YouTuberやストリーマーは"}, {"type": "subtitle", "time": 7918.79, "timestamp": "02:11:58", "text": "理解する、それは一種の"}]
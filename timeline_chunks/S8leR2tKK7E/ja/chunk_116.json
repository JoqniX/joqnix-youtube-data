[{"type": "subtitle", "time": 6963.109, "timestamp": "01:56:03", "text": "SKはTwitch以外にも多くのものを見ている。彼らは望んでいる"}, {"type": "subtitle", "time": 6965.83, "timestamp": "01:56:05", "text": "彼らはいつもそこにいてくれるでしょう。私はしません"}, {"type": "subtitle", "time": 6967.589, "timestamp": "01:56:07", "text": "考える"}, {"type": "subtitle", "time": 6969.83, "timestamp": "01:56:09", "text": "どういうことなのか私には理解できない"}, {"type": "subtitle", "time": 6971.669, "timestamp": "01:56:11", "text": "あなたはたくさんのストリームをうまくこなしています"}, {"type": "subtitle", "time": 6974.07, "timestamp": "01:56:14", "text": "プラットフォームは同時に、"}, {"type": "subtitle", "time": 6976.31, "timestamp": "01:56:16", "text": "一つのプラットフォームでライブ配信することさえ怖い"}, {"type": "subtitle", "time": 6978.109, "timestamp": "01:56:18", "text": "私にとってはなおさら"}, {"type": "subtitle", "time": 6981.51, "timestamp": "01:56:21", "text": "他のプラットフォームと同様に、これは、"}, {"type": "subtitle", "time": 6983.07, "timestamp": "01:56:23", "text": "それについて考えるととても"}, {"type": "subtitle", "time": 6986.79, "timestamp": "01:56:26", "text": "不安って、まるで「それで、どうしたらいいの？」って感じ"}, {"type": "subtitle", "time": 6990.87, "timestamp": "01:56:30", "text": "私は、あなたにいろいろなものを見せるのが得意だと言っています。"}, {"type": "subtitle", "time": 6994.629, "timestamp": "01:56:34", "text": "本当に勇敢だね"}, {"type": "subtitle", "time": 6996.189, "timestamp": "01:56:36", "text": "私はしません"}, {"type": "subtitle", "time": 6998.87, "timestamp": "01:56:38", "text": "いいえ、そうです。いいえ、私は配信する予定でした"}, {"type": "subtitle", "time": 7001.75, "timestamp": "01:56:41", "text": "Twitterでプレミアム会員になったから"}, {"type": "subtitle", "time": 7005.03, "timestamp": "01:56:45", "text": "ただその日本のVTuberにDMを送るだけ。私"}, {"type": "subtitle", "time": 7008.31, "timestamp": "01:56:48", "text": "Xで認証の手続きをしました"}, {"type": "subtitle", "time": 7010.149, "timestamp": "01:56:50", "text": "プレミアム。"}, {"type": "subtitle", "time": 7012.229, "timestamp": "01:56:52", "text": "しかし結局、彼らからの返事はなかった。そして"}, {"type": "subtitle", "time": 7014.47, "timestamp": "01:56:54", "text": "「うん、大丈夫だよ」って感じ。それは"}]
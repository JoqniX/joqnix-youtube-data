[{"type": "subtitle", "time": 4201.189, "timestamp": "01:10:01", "text": "痛み。つまり、私が見たとき"}, {"type": "subtitle", "time": 4205.99, "timestamp": "01:10:05", "text": "そうやって気づいたんだ、ああ"}, {"type": "subtitle", "time": 4209.11, "timestamp": "01:10:09", "text": "新しい人に対して私がただ話しかけるだけなら"}, {"type": "subtitle", "time": 4212.47, "timestamp": "01:10:12", "text": "突然現れて、こう言うんだ。「ねえ、欲しいの？」"}, {"type": "subtitle", "time": 4215.11, "timestamp": "01:10:15", "text": "コラボレーションすると奇妙なことになり、"}, {"type": "subtitle", "time": 4219.11, "timestamp": "01:10:19", "text": "実に不快な感じがする。"}, {"type": "subtitle", "time": 4222.55, "timestamp": "01:10:22", "text": "ある意味では。それで私は最近遭遇しました"}, {"type": "subtitle", "time": 4226.47, "timestamp": "01:10:26", "text": "その奇妙なシナリオや状況と、"}, {"type": "subtitle", "time": 4229.149, "timestamp": "01:10:29", "text": "考えもしなかった。私は「ああ、"}, {"type": "subtitle", "time": 4232.51, "timestamp": "01:10:32", "text": "私は彼らを周りで見かけたことを知っています、私は"}, {"type": "subtitle", "time": 4235.189, "timestamp": "01:10:35", "text": "接続して、さらに"}, {"type": "subtitle", "time": 4237.43, "timestamp": "01:10:37", "text": "人と繋がったりするために、"}, {"type": "subtitle", "time": 4239.91, "timestamp": "01:10:39", "text": "しかし、私はそれが"}, {"type": "subtitle", "time": 4241.51, "timestamp": "01:10:41", "text": "態度。」"}, {"type": "subtitle", "time": 4244.39, "timestamp": "01:10:44", "text": "でも、私がすでに知っている人には効果がある"}, {"type": "subtitle", "time": 4246.709, "timestamp": "01:10:46", "text": "コラボレーションしたけど、まだ話してない"}, {"type": "subtitle", "time": 4249.55, "timestamp": "01:10:49", "text": "長期間にわたって協力または連携"}, {"type": "subtitle", "time": 4253.03, "timestamp": "01:10:53", "text": "その間。私が連絡を取ったすべての"}, {"type": "subtitle", "time": 4257.51, "timestamp": "01:10:57", "text": "彼らと皆が親切にもこう言った"}]
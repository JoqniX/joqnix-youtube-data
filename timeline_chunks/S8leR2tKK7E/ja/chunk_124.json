[{"type": "subtitle", "time": 7441.27, "timestamp": "02:04:01", "text": "これ？私は彼らのことを喜ぶべきなのに、なぜ"}, {"type": "subtitle", "time": 7444.39, "timestamp": "02:04:04", "text": "私はこれをこのように見ているのだろうか"}, {"type": "subtitle", "time": 7446.31, "timestamp": "02:04:06", "text": "それが私が疑問に思っていたことだった"}, {"type": "subtitle", "time": 7450.629, "timestamp": "02:04:10", "text": "当時、それはmになった私自身"}, {"type": "subtitle", "time": 7453.91, "timestamp": "02:04:13", "text": "私が彼らの配信を訪れた時に気づいた点"}, {"type": "subtitle", "time": 7456.709, "timestamp": "02:04:16", "text": "この考えが再び浮かび上がり、"}, {"type": "subtitle", "time": 7460.229, "timestamp": "02:04:20", "text": "私は、もしかしたら訪問するかもしれないと思っています"}, {"type": "subtitle", "time": 7462.709, "timestamp": "02:04:22", "text": "チャンネルやコンテンツなどが"}, {"type": "subtitle", "time": 7464.709, "timestamp": "02:04:24", "text": "辛いから、しばらくは離れるよ"}, {"type": "subtitle", "time": 7467.91, "timestamp": "02:04:27", "text": "しばらくすると、時間が経つにつれて"}, {"type": "subtitle", "time": 7470.95, "timestamp": "02:04:30", "text": "ゆっくりと消えていった。私は"}, {"type": "subtitle", "time": 7473.189, "timestamp": "02:04:33", "text": "そうですね、他の人と比較するのではなく"}, {"type": "subtitle", "time": 7475.99, "timestamp": "02:04:35", "text": "あるいは何でもいいから、私のことに集中して"}, {"type": "subtitle", "time": 7479.189, "timestamp": "02:04:39", "text": "私のものを比較する、つまり批評する"}, {"type": "subtitle", "time": 7480.91, "timestamp": "02:04:40", "text": "私自身も好きで"}, {"type": "subtitle", "time": 7484.709, "timestamp": "02:04:44", "text": "過去の自分から改善して、もっと良くなる"}, {"type": "subtitle", "time": 7487.75, "timestamp": "02:04:47", "text": "翌日とか、いろいろあった。うん。もっと良くなろう"}, {"type": "subtitle", "time": 7490.55, "timestamp": "02:04:50", "text": "次回はそうしてください。そしてその考え方"}, {"type": "subtitle", "time": 7491.55, "timestamp": "02:04:51", "text": "した"}, {"type": "subtitle", "time": 7495.51, "timestamp": "02:04:55", "text": "ヘルプ。そして、私がそれを手に入れそうになるといつも"}, {"type": "subtitle", "time": 7498.31, "timestamp": "02:04:58", "text": "ゼリーのような感覚、または、"}]
[{"type": "subtitle", "time": 9481.79, "timestamp": "02:38:01", "text": "えっと、いくつか作らなきゃ"}, {"type": "subtitle", "time": 9485.429, "timestamp": "02:38:05", "text": "準備とチャンスがあります"}, {"type": "subtitle", "time": 9516.429, "timestamp": "02:38:36", "text": "私は実際には1秒も考えません。"}, {"type": "subtitle", "time": 9519.79, "timestamp": "02:38:39", "text": "えっと、手に入れるチャンスがあるかもしれない"}, {"type": "subtitle", "time": 9522.71, "timestamp": "02:38:42", "text": "アクセシビリティ。えっと、私はただ話しているだけです"}, {"type": "subtitle", "time": 9524.87, "timestamp": "02:38:44", "text": "金曜日のコラボパートナー"}, {"type": "subtitle", "time": 9527.59, "timestamp": "02:38:47", "text": "そして、彼女の方にもいくつか問題がある。"}, {"type": "subtitle", "time": 9530.63, "timestamp": "02:38:50", "text": "彼女は金曜日には来られません。"}, {"type": "subtitle", "time": 9533.63, "timestamp": "02:38:53", "text": "緊急。そして彼女はまた手に入れることができた"}, {"type": "subtitle", "time": 9537.59, "timestamp": "02:38:57", "text": "代理店と交渉するために"}]
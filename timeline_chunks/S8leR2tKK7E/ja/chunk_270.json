[{"type": "subtitle", "time": 16211.79, "timestamp": "04:30:11", "text": "えーと。書かなければならない"}, {"type": "subtitle", "time": 16215.91, "timestamp": "04:30:15", "text": "下。荷造りは済んだよ、兄弟。荷造りは終わりました。"}, {"type": "subtitle", "time": 16228.11, "timestamp": "04:30:28", "text": "ええと、午後4時以降"}, {"type": "subtitle", "time": 16234.63, "timestamp": "04:30:34", "text": "CST。えっと、午後2時30分、いや、1時30分、1時30分"}, {"type": "subtitle", "time": 16236.51, "timestamp": "04:30:36", "text": "午後"}, {"type": "subtitle", "time": 16239.63, "timestamp": "04:30:39", "text": "IST。えっと、"}, {"type": "subtitle", "time": 16255.269, "timestamp": "04:30:55", "text": "えーと、6月18日から19日"}]
[{"type": "subtitle", "time": 5520.95, "timestamp": "01:32:00", "text": "サムネイル？それはザナだったのか？"}, {"type": "subtitle", "time": 5522.79, "timestamp": "01:32:02", "text": "ザナかもしれないけど、私は"}, {"type": "subtitle", "time": 5525.31, "timestamp": "01:32:05", "text": "特にポーが"}, {"type": "subtitle", "time": 5528.31, "timestamp": "01:32:08", "text": "ストリーム。彼はとてもミステリアスで、"}, {"type": "subtitle", "time": 5530.229, "timestamp": "01:32:10", "text": "謎の秩序を維持するように"}, {"type": "subtitle", "time": 5533.11, "timestamp": "01:32:13", "text": "彼の周り。"}, {"type": "subtitle", "time": 5535.11, "timestamp": "01:32:15", "text": "ええ、彼は本当に謎めいていますね。あなたは"}, {"type": "subtitle", "time": 5537.27, "timestamp": "01:32:17", "text": "私がファンガールだった頃を覚えてる？"}, {"type": "subtitle", "time": 5543.51, "timestamp": "01:32:23", "text": "何てことだ。"}, {"type": "subtitle", "time": 5547.91, "timestamp": "01:32:27", "text": "わかりました。でも私としては"}, {"type": "subtitle", "time": 5549.75, "timestamp": "01:32:29", "text": "私はいつも彼を"}, {"type": "subtitle", "time": 5552.47, "timestamp": "01:32:32", "text": "指導者タイプの人。"}, {"type": "subtitle", "time": 5555.35, "timestamp": "01:32:35", "text": "ああ、それから、彼が"}, {"type": "subtitle", "time": 5558.31, "timestamp": "01:32:38", "text": "ほぼゼロから会社を立ち上げる"}, {"type": "subtitle", "time": 5562.149, "timestamp": "01:32:42", "text": "傷。そうですね、"}, {"type": "subtitle", "time": 5565.01, "timestamp": "01:32:45", "text": "男。高度な思考を要する内容。"}, {"type": "subtitle", "time": 5567.59, "timestamp": "01:32:47", "text": "[音楽]"}, {"type": "subtitle", "time": 5571.669, "timestamp": "01:32:51", "text": "私はポールが好きです。ポールも私に言いました"}, {"type": "subtitle", "time": 5574.79, "timestamp": "01:32:54", "text": "えっと、彼は日本に行ったと言っていました"}, {"type": "subtitle", "time": 5577.669, "timestamp": "01:32:57", "text": "物と"}]
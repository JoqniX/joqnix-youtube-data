[{"type": "subtitle", "time": 3240.349, "timestamp": "00:54:00", "text": "[音楽]"}, {"type": "subtitle", "time": 3251.67, "timestamp": "00:54:11", "text": "行く。後で後悔するぞ。"}, {"type": "subtitle", "time": 3262.27, "timestamp": "00:54:22", "text": "[音楽]"}, {"type": "subtitle", "time": 3266.19, "timestamp": "00:54:26", "text": "ヨガ。私は自分のしたことを全て後悔しています"}, {"type": "subtitle", "time": 3270.63, "timestamp": "00:54:30", "text": "そこまでやるつもりだ。でもでも"}, {"type": "subtitle", "time": 3272.27, "timestamp": "00:54:32", "text": "これ"}, {"type": "subtitle", "time": 3275.91, "timestamp": "00:54:35", "text": "夢、夢、夢は夢です。"}, {"type": "subtitle", "time": 3278.549, "timestamp": "00:54:38", "text": "つまり、夢は始まりに過ぎない、"}, {"type": "subtitle", "time": 3281.549, "timestamp": "00:54:41", "text": "右？だから、"}, {"type": "subtitle", "time": 3284.309, "timestamp": "00:54:44", "text": "心配。こんにちは、それではゲームに移りましょう"}, {"type": "subtitle", "time": 3285.87, "timestamp": "00:54:45", "text": "シーン。"}, {"type": "subtitle", "time": 3291.19, "timestamp": "00:54:51", "text": "こんにちは。こんにちは。 BSR 2の2日目へようこそ。待って、"}, {"type": "subtitle", "time": 3295.069, "timestamp": "00:54:55", "text": "BS 2 新ジェネシスクロス ベータ版の日"}, {"type": "subtitle", "time": 3299.03, "timestamp": "00:54:59", "text": "二。私は太った人を作るべきだ"}]
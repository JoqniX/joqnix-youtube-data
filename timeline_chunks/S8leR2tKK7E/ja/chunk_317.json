[{"type": "subtitle", "time": 19021.59, "timestamp": "05:17:01", "text": "私の持ち物を全部捨ててください。それでも私は"}, {"type": "subtitle", "time": 19029.868, "timestamp": "05:17:09", "text": "スペースがないから"}, {"type": "subtitle", "time": 19033.23, "timestamp": "05:17:13", "text": "ディオ。だからこれは私ができる最低限のことです"}, {"type": "subtitle", "time": 19036.55, "timestamp": "05:17:16", "text": "する。私は自分のリソースをすべて捨てました。今"}, {"type": "subtitle", "time": 19037.788, "timestamp": "05:17:17", "text": "時間"}, {"type": "subtitle", "time": 19041.788, "timestamp": "05:17:21", "text": "待って、なんでまだこんなに重いんだろう？ O"}, {"type": "subtitle", "time": 19045.23, "timestamp": "05:17:25", "text": "ああ、神様、おしまい。"}, {"type": "subtitle", "time": 19049.948, "timestamp": "05:17:29", "text": "えっと、待って。 Hとは何ですか？重いものは何ですか"}, {"type": "subtitle", "time": 19053.35, "timestamp": "05:17:33", "text": "また？ああ、なんてことだ。私はバカだと思う"}, {"type": "subtitle", "time": 19059.55, "timestamp": "05:17:39", "text": "あまりにも。傭兵"}, {"type": "subtitle", "time": 19062.83, "timestamp": "05:17:42", "text": "パック。ああ、まだ重い、"}, {"type": "subtitle", "time": 19065.15, "timestamp": "05:17:45", "text": "はぁ？私はまだ"}, {"type": "subtitle", "time": 19067.75, "timestamp": "05:17:47", "text": "重い。手榴弾のせいではない。私は確信しています"}, {"type": "subtitle", "time": 19069.868, "timestamp": "05:17:49", "text": "それは"}, {"type": "subtitle", "time": 19072.628, "timestamp": "05:17:52", "text": "手榴弾。ああ、この船かもしれない"}, {"type": "subtitle", "time": 19076.07, "timestamp": "05:17:56", "text": "部品。はい、どうぞ。私の犯人。"}, {"type": "subtitle", "time": 19078.708, "timestamp": "05:17:58", "text": "ジャマ、まだ重いよ。何てことだ。なんてこった、"}]
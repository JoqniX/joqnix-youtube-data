[{"type": "subtitle", "time": 9001.349, "timestamp": "02:30:01", "text": "時にはとてもエキサイティングで、時に"}, {"type": "subtitle", "time": 9004.23, "timestamp": "02:30:04", "text": "怖いけど、それはあなたが見るもの"}, {"type": "subtitle", "time": 9019.469, "timestamp": "02:30:19", "text": "良い。それで、将来は何かありますか？"}, {"type": "subtitle", "time": 9022.55, "timestamp": "02:30:22", "text": "達成したいことや欲しいものに関する計画"}, {"type": "subtitle", "time": 9024.95, "timestamp": "02:30:24", "text": "何をすべきか？"}, {"type": "subtitle", "time": 9028.309, "timestamp": "02:30:28", "text": "ええと、ここ5年くらいで"}, {"type": "subtitle", "time": 9030.389, "timestamp": "02:30:30", "text": "人生を変えるような出来事を数多く経験してきた"}, {"type": "subtitle", "time": 9033.11, "timestamp": "02:30:33", "text": "瞬間や出来事、そして私は"}, {"type": "subtitle", "time": 9035.349, "timestamp": "02:30:35", "text": "仕事をして、ご存知のように、それを続けました"}, {"type": "subtitle", "time": 9037.59, "timestamp": "02:30:37", "text": "物事を次々にこなし、旅行する"}, {"type": "subtitle", "time": 9040.23, "timestamp": "02:30:40", "text": "あまりにも多すぎて、"}, {"type": "subtitle", "time": 9043.91, "timestamp": "02:30:43", "text": "休息したり、ペースを落としたりするために"}, {"type": "subtitle", "time": 9047.67, "timestamp": "02:30:47", "text": "少しだけ。今年は"}, {"type": "subtitle", "time": 9049.67, "timestamp": "02:30:49", "text": "これまでのところ、私ができた1年間は"}, {"type": "subtitle", "time": 9053.349, "timestamp": "02:30:53", "text": "ゆっくりして、"}, {"type": "subtitle", "time": 9056.87, "timestamp": "02:30:56", "text": "人生はありのままに経験し、私は"}, {"type": "subtitle", "time": 9059.99, "timestamp": "02:30:59", "text": "メジャーな作品を作りたいとは思わない"}]
[{"type": "subtitle", "time": 12668.469, "timestamp": "03:31:08", "text": "まあ、面白いクリップは"}, {"type": "subtitle", "time": 12671.03, "timestamp": "03:31:11", "text": "ライブ配信。苦情は"}, {"type": "subtitle", "time": 12672.429, "timestamp": "03:31:12", "text": "そこには。"}, {"type": "subtitle", "time": 12674.469, "timestamp": "03:31:14", "text": "出身地は関係ありません。"}, {"type": "subtitle", "time": 12676.07, "timestamp": "03:31:16", "text": "実際、人々の狂気はすべて"}, {"type": "subtitle", "time": 12677.59, "timestamp": "03:31:17", "text": "同じ。あなたがどの国にいても、"}, {"type": "subtitle", "time": 12678.87, "timestamp": "03:31:18", "text": "みんなこんな感じだよ。彼らは良い"}, {"type": "subtitle", "time": 12680.469, "timestamp": "03:31:20", "text": "彼らは悪い人たちだ。人々"}, {"type": "subtitle", "time": 12684.71, "timestamp": "03:31:24", "text": "悪意を排除する者、"}, {"type": "subtitle", "time": 12686.71, "timestamp": "03:31:26", "text": "あなたがどれだけ優れていても、彼らはどんな攻撃も"}, {"type": "subtitle", "time": 12689.269, "timestamp": "03:31:29", "text": "ランダムなオブジェクト。彼らはそれをアブセクトしている"}, {"type": "subtitle", "time": 12691.03, "timestamp": "03:31:31", "text": "あなたがどこから来たのかは関係ありません。"}, {"type": "subtitle", "time": 12692.75, "timestamp": "03:31:32", "text": "あなたが来た場所"}, {"type": "subtitle", "time": 12696.229, "timestamp": "03:31:36", "text": "から。私は、"}, {"type": "subtitle", "time": 12697.55, "timestamp": "03:31:37", "text": "は"}, {"type": "subtitle", "time": 12706.309, "timestamp": "03:31:46", "text": "機関はほとんどの混乱の責任者です"}, {"type": "subtitle", "time": 12707.51, "timestamp": "03:31:47", "text": "時間。誰もが自分の"}, {"type": "subtitle", "time": 12711.59, "timestamp": "03:31:51", "text": "優先順位。うん。問題は、私はそうではないということです"}]
[{"type": "subtitle", "time": 17942.948, "timestamp": "04:59:02", "text": "来週にしてください、今週ではありません。また私の"}, {"type": "subtitle", "time": 17944.99, "timestamp": "04:59:04", "text": "ミス"}, {"type": "subtitle", "time": 17949.19, "timestamp": "04:59:09", "text": "意思疎通の行き違いが起きた。えーと"}, {"type": "subtitle", "time": 17953.35, "timestamp": "04:59:13", "text": "私は次の日には実際にはそこにいません"}, {"type": "subtitle", "time": 17956.31, "timestamp": "04:59:16", "text": "今月末の週、つまり来週"}, {"type": "subtitle", "time": 17960.27, "timestamp": "04:59:20", "text": "来週の最後の週"}, {"type": "subtitle", "time": 17963.27, "timestamp": "04:59:23", "text": "9月。 9月の最終週ですね。それで"}, {"type": "subtitle", "time": 17967.03, "timestamp": "04:59:27", "text": "今週は休みだから、すごく楽しみ。これは"}, {"type": "subtitle", "time": 17971.27, "timestamp": "04:59:31", "text": "今週のスケジュール。ファンが"}, {"type": "subtitle", "time": 17973.23, "timestamp": "04:59:33", "text": "アートから"}, {"type": "subtitle", "time": 17977.19, "timestamp": "04:59:37", "text": "右側はインフィヤマ。ええ、そうですね。だからこれは"}, {"type": "subtitle", "time": 17978.83, "timestamp": "04:59:38", "text": "今週は"}, {"type": "subtitle", "time": 17982.83, "timestamp": "04:59:42", "text": "ご覧のとおり、上のスターフィールドです。"}, {"type": "subtitle", "time": 17986.708, "timestamp": "04:59:46", "text": "だから明日はスターフィールドがあるんだけど"}, {"type": "subtitle", "time": 17989.27, "timestamp": "04:59:49", "text": "ホグワーツ・レガシーをプレイしています。えっと、それ"}, {"type": "subtitle", "time": 17991.11, "timestamp": "04:59:51", "text": "ホグワーツの7番目の流れとなる"}, {"type": "subtitle", "time": 17993.75, "timestamp": "04:59:53", "text": "遺産。そして火曜日にはコラボレーションがあります"}, {"type": "subtitle", "time": 17998.43, "timestamp": "04:59:58", "text": "アルズと一緒です。私たちはピューピューと撃ちます"}]
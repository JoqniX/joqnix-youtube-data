[{"type": "subtitle", "time": 19080.35, "timestamp": "05:18:00", "text": "私は太っていません。わかった、"}, {"type": "subtitle", "time": 19084.15, "timestamp": "05:18:04", "text": "良い。ああ、これはガラクタだ。"}, {"type": "subtitle", "time": 19086.788, "timestamp": "05:18:06", "text": "かなりの量のガラクタですね。うん。こんにちは。"}, {"type": "subtitle", "time": 19090.788, "timestamp": "05:18:10", "text": "ああ。いらっしゃいませ。どのような感じでしたか"}, {"type": "subtitle", "time": 19092.19, "timestamp": "05:18:12", "text": "これらすべて"}, {"type": "subtitle", "time": 19095.03, "timestamp": "05:18:15", "text": "ジャンク？とても美味しいです。これを試してみるべきだ"}, {"type": "subtitle", "time": 19099.07, "timestamp": "05:18:19", "text": "外。あ、待って。私のバックパックが"}, {"type": "subtitle", "time": 19101.708, "timestamp": "05:18:21", "text": "ここ。ああ、なんてたくさんのガラクタなんだ。"}, {"type": "subtitle", "time": 19109.27, "timestamp": "05:18:29", "text": "さあ、私たちが"}, {"type": "subtitle", "time": 19111.11, "timestamp": "05:18:31", "text": "スピードダンは"}, {"type": "subtitle", "time": 19114.708, "timestamp": "05:18:34", "text": "えっと、材料をいくつか買います。私は信じます、えーと"}, {"type": "subtitle", "time": 19117.31, "timestamp": "05:18:37", "text": "私はそれがどこにあるか知っています"}, {"type": "subtitle", "time": 19120.07, "timestamp": "05:18:40", "text": "そうかもしれないけど、確信はない。わからない。私"}, {"type": "subtitle", "time": 19122.75, "timestamp": "05:18:42", "text": "それがどこにあるか知っています。だからもし私が"}, {"type": "subtitle", "time": 19131.788, "timestamp": "05:18:51", "text": "そうあるべきだ"}, {"type": "subtitle", "time": 19139.67, "timestamp": "05:18:59", "text": "えっと、それはどの惑星だったっけ？どの惑星が"}]
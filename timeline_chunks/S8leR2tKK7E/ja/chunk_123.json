[{"type": "subtitle", "time": 7381.51, "timestamp": "02:03:01", "text": "エネルギーと仕事にさらに集中する"}, {"type": "subtitle", "time": 7383.91, "timestamp": "02:03:03", "text": "特定の目標に向かって、私は"}, {"type": "subtitle", "time": 7385.189, "timestamp": "02:03:05", "text": "そのエネルギーをすべて注ぎ込んで"}, {"type": "subtitle", "time": 7387.99, "timestamp": "02:03:07", "text": "何か別のこと。だから私はこうは思わない"}, {"type": "subtitle", "time": 7390.629, "timestamp": "02:03:10", "text": "一人の人の"}, {"type": "subtitle", "time": 7392.149, "timestamp": "02:03:12", "text": "進歩や成果を知って"}, {"type": "subtitle", "time": 7394.229, "timestamp": "02:03:14", "text": "もう一つは、私たちみんなが"}, {"type": "subtitle", "time": 7396.39, "timestamp": "02:03:16", "text": "さまざまな状況とさまざまな"}, {"type": "subtitle", "time": 7399.27, "timestamp": "02:03:19", "text": "目標や環境を理解しているように"}, {"type": "subtitle", "time": 7401.669, "timestamp": "02:03:21", "text": "そして私たちがアクセスできるもの、そして私たちが"}, {"type": "subtitle", "time": 7403.35, "timestamp": "02:03:23", "text": "やめてください。"}, {"type": "subtitle", "time": 7405.07, "timestamp": "02:03:25", "text": "私"}, {"type": "subtitle", "time": 7408.31, "timestamp": "02:03:28", "text": "人々は最善を尽くしていると思う"}, {"type": "subtitle", "time": 7409.58, "timestamp": "02:03:29", "text": "時間。"}, {"type": "subtitle", "time": 7411.629, "timestamp": "02:03:31", "text": "[音楽]"}, {"type": "subtitle", "time": 7415.75, "timestamp": "02:03:35", "text": "ええ、その通りです。うん、私もちょっと"}, {"type": "subtitle", "time": 7417.87, "timestamp": "02:03:37", "text": "そういう状況だった"}, {"type": "subtitle", "time": 7420.87, "timestamp": "02:03:40", "text": "この奇妙な感覚を覚えた瞬間"}, {"type": "subtitle", "time": 7424.149, "timestamp": "02:03:44", "text": "嫉妬心とか、そんな感じ"}, {"type": "subtitle", "time": 7426.79, "timestamp": "02:03:46", "text": "私の仲間や"}, {"type": "subtitle", "time": 7429.27, "timestamp": "02:03:49", "text": "友達はみんなうまくいってるし、私は"}, {"type": "subtitle", "time": 7432.149, "timestamp": "02:03:52", "text": "仲間外れにされたとか、何かがなかったとか"}, {"type": "subtitle", "time": 7434.79, "timestamp": "02:03:54", "text": "壁か何かに挟まって動けなくなってる。で"}, {"type": "subtitle", "time": 7437.229, "timestamp": "02:03:57", "text": "最初は、なぜこんな気持ちになるんだろうと思った"}]
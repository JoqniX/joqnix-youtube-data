[{"type": "subtitle", "time": 422.99, "timestamp": "00:07:02", "text": "知る。ああ。それで、"}, {"type": "subtitle", "time": 426.43, "timestamp": "00:07:06", "text": "うん。こんにちは。こんにちは。過剰監視はしないでください。私"}, {"type": "subtitle", "time": 429.469, "timestamp": "00:07:09", "text": "繰り返します、私は"}, {"type": "subtitle", "time": 432.469, "timestamp": "00:07:12", "text": "繰り返しますが、絶対に見てはいけません。予約します"}, {"type": "subtitle", "time": 435.79, "timestamp": "00:07:15", "text": "あなた方一人ひとり"}, {"type": "subtitle", "time": 438.029, "timestamp": "00:07:18", "text": "あなた。こんにちは。"}, {"type": "subtitle", "time": 441.23, "timestamp": "00:07:21", "text": "あらら。"}, {"type": "subtitle", "time": 445.71, "timestamp": "00:07:25", "text": "えーと、次は私が話したいこと"}, {"type": "subtitle", "time": 450.23, "timestamp": "00:07:30", "text": "これは何についてですか、それで、私の"}, {"type": "subtitle", "time": 451.79, "timestamp": "00:07:31", "text": "指揮所"}, {"type": "subtitle", "time": 455.83, "timestamp": "00:07:35", "text": "これは私です。私はこちらに引っ越すべきです。"}, {"type": "subtitle", "time": 460.23, "timestamp": "00:07:40", "text": "今週のスケジュールについて教えてください。"}, {"type": "subtitle", "time": 464.23, "timestamp": "00:07:44", "text": "えっと、こんにちは。私は「えーと」と言うはずだった"}, {"type": "subtitle", "time": 467.30899999999997, "timestamp": "00:07:47", "text": "スケジュールを投稿する"}, {"type": "subtitle", "time": 470.79, "timestamp": "00:07:50", "text": "毎週土曜日の終わりか、太陽のような"}, {"type": "subtitle", "time": 474.30899999999997, "timestamp": "00:07:54", "text": "日曜日まで待ってください。だから私の最後のスケジュールは"}, {"type": "subtitle", "time": 477.749, "timestamp": "00:07:57", "text": "そしてこのスケジュールには日曜日が1つあります"}]
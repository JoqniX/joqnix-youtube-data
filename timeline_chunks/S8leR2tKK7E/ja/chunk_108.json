[{"type": "subtitle", "time": 6481.31, "timestamp": "01:48:01", "text": "何が起こり得るかは私にはわからない"}, {"type": "subtitle", "time": 6484.95, "timestamp": "01:48:04", "text": "日本、もしストリーミングできるなら、もしできるなら"}, {"type": "subtitle", "time": 6487.27, "timestamp": "01:48:07", "text": "7月にストリーミング配信するか、"}, {"type": "subtitle", "time": 6489.35, "timestamp": "01:48:09", "text": "少なくとも8月には配信します"}, {"type": "subtitle", "time": 6492.51, "timestamp": "01:48:12", "text": "誕生日、あるいは私が誕生日を迎えるかどうか"}, {"type": "subtitle", "time": 6496.629, "timestamp": "01:48:16", "text": "ストリーム。誰にも分からないよね？それでも私は"}, {"type": "subtitle", "time": 6498.709, "timestamp": "01:48:18", "text": "これらの思い出を大切にしたい"}, {"type": "subtitle", "time": 6501.51, "timestamp": "01:48:21", "text": "私が交流したすべての人に対して"}, {"type": "subtitle", "time": 6505.109, "timestamp": "01:48:25", "text": "彼らと再会したり、その他いろいろ"}, {"type": "subtitle", "time": 6506.95, "timestamp": "01:48:26", "text": "だって、あなたが"}, {"type": "subtitle", "time": 6510.75, "timestamp": "01:48:30", "text": "知ってるよ、人と話すんだ"}, {"type": "subtitle", "time": 6513.99, "timestamp": "01:48:33", "text": "ああ、そうだよ、人と話して、"}, {"type": "subtitle", "time": 6517.189, "timestamp": "01:48:37", "text": "人生がやってきて、"}, {"type": "subtitle", "time": 6519.83, "timestamp": "01:48:39", "text": "前に進めば、彼らのことは忘れてしまう。しかし"}, {"type": "subtitle", "time": 6521.83, "timestamp": "01:48:41", "text": "たとえそれらを見て気づいたとしても"}, {"type": "subtitle", "time": 6522.669, "timestamp": "01:48:42", "text": "彼らの"}, {"type": "subtitle", "time": 6526.87, "timestamp": "01:48:46", "text": "存在、あなたは恐れる、「ああ、もし"}, {"type": "subtitle", "time": 6529.43, "timestamp": "01:48:49", "text": "「私のこと覚えてないのかな？」"}, {"type": "subtitle", "time": 6530.79, "timestamp": "01:48:50", "text": "その事実が気に入らなかった。私はこう思った。"}, {"type": "subtitle", "time": 6533.75, "timestamp": "01:48:53", "text": "「うん、もし君を僕のDiscordで見かけたらね」"}, {"type": "subtitle", "time": 6535.189, "timestamp": "01:48:55", "text": "友達リストからか何か"}, {"type": "chat", "time": 6537.142, "timestamp": "01:48:57", "author": "@dewaldschindler", "avatar": "https://yt4.ggpht.com/3EVruqmqk1scvSVFMNEK-_3U_bDPbV3oLWY0DmJGgIBrob_Npg2Pj8bGvnYQamBzT9SiK6ut1w=s64-c-k-c0x00ffffff-no-rj", "message": "Twitch is offline "}, {"type": "subtitle", "time": 6537.35, "timestamp": "01:48:57", "text": "何かあったら、あなたに連絡します"}, {"type": "chat", "time": 6539.709, "timestamp": "01:48:59", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! dewald schindler~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 6539.83, "timestamp": "01:48:59", "text": "たとえ忘れても"}]
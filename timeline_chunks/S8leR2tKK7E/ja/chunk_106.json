[{"type": "subtitle", "time": 6361.27, "timestamp": "01:46:01", "text": "すべて、そして彼が"}, {"type": "subtitle", "time": 6365.109, "timestamp": "01:46:05", "text": "それを手に入れた彼は、"}, {"type": "subtitle", "time": 6367.83, "timestamp": "01:46:07", "text": "彼が資金提供した相手なら誰とでもコラボレーションするんだよね？そして"}, {"type": "subtitle", "time": 6370.83, "timestamp": "01:46:10", "text": "ユーチューバーでさえも"}, {"type": "subtitle", "time": 6372.51, "timestamp": "01:46:12", "text": "ストリーミング"}, {"type": "subtitle", "time": 6376.87, "timestamp": "01:46:16", "text": "そして、そう、BTuberに話を戻すと、"}, {"type": "subtitle", "time": 6379.95, "timestamp": "01:46:19", "text": "ストリーミングをストリーミングに戻していません"}, {"type": "subtitle", "time": 6382.83, "timestamp": "01:46:22", "text": "彼らを助けるようなこと"}, {"type": "subtitle", "time": 6385.43, "timestamp": "01:46:25", "text": "もっとコンテンツを作って、その他いろいろ。"}, {"type": "subtitle", "time": 6389.189, "timestamp": "01:46:29", "text": "代理店関係者も同様です。そして私が見たとき"}, {"type": "subtitle", "time": 6391.87, "timestamp": "01:46:31", "text": "ええ、それが私にインスピレーションを与えたんです。"}, {"type": "subtitle", "time": 6394.87, "timestamp": "01:46:34", "text": "最初は。私もそうしたいです。"}, {"type": "subtitle", "time": 6396.07, "timestamp": "01:46:36", "text": "なぜだめですか？"}, {"type": "subtitle", "time": 6399.03, "timestamp": "01:46:39", "text": "人と話したり、"}, {"type": "subtitle", "time": 6399.79, "timestamp": "01:46:39", "text": "知る"}, {"type": "subtitle", "time": 6403.99, "timestamp": "01:46:43", "text": "彼らと、そしてお互いに助け合う"}, {"type": "subtitle", "time": 6405.83, "timestamp": "01:46:45", "text": "そして全て。"}, {"type": "subtitle", "time": 6407.709, "timestamp": "01:46:47", "text": "そして私は考えます"}, {"type": "subtitle", "time": 6412.39, "timestamp": "01:46:52", "text": "ジョアソン、私は、えっと、それは私だけだったような気がする"}, {"type": "subtitle", "time": 6414.47, "timestamp": "01:46:54", "text": "数人とのコラボレーションだけを希望する"}, {"type": "subtitle", "time": 6417.91, "timestamp": "01:46:57", "text": "人々は、私の頑固さが表れた。私は"}]
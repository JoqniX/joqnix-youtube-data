[{"type": "subtitle", "time": 2675.75, "timestamp": "00:44:35", "text": "ヤフー。何？あなたはどうですか？私は大丈夫です。"}, {"type": "subtitle", "time": 2677.23, "timestamp": "00:44:37", "text": "私は大丈夫です、"}, {"type": "subtitle", "time": 2680.79, "timestamp": "00:44:40", "text": "実は。ちょっとした大きな"}, {"type": "subtitle", "time": 2683.63, "timestamp": "00:44:43", "text": "頭痛がするけど、私は"}, {"type": "subtitle", "time": 2686.67, "timestamp": "00:44:46", "text": "良い。ええ、そのツイート見ましたよ。"}, {"type": "subtitle", "time": 2696.67, "timestamp": "00:44:56", "text": "[音楽]"}, {"type": "subtitle", "time": 2699.79, "timestamp": "00:44:59", "text": "誰か。こんにちは。ええ、そうですね。"}]
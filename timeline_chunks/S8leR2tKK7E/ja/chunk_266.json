[{"type": "subtitle", "time": 15982.11, "timestamp": "04:26:22", "text": "１、２、"}, {"type": "subtitle", "time": 15985.67, "timestamp": "04:26:25", "text": "三つ。自分があまり話していないことは分かっています。その"}, {"type": "subtitle", "time": 16000.75, "timestamp": "04:26:40", "text": "もの。今回はただ"}, {"type": "subtitle", "time": 16003.71, "timestamp": "04:26:43", "text": "もの。謝罪します。私は話していません"}, {"type": "subtitle", "time": 16005.229, "timestamp": "04:26:45", "text": "たくさん"}, {"type": "subtitle", "time": 16008.429, "timestamp": "04:26:48", "text": "それ。彼の深夜の騎手について考えてみてください"}, {"type": "subtitle", "time": 16012.269, "timestamp": "04:26:52", "text": "考えすぎて最善を尽くす"}, {"type": "subtitle", "time": 16014.51, "timestamp": "04:26:54", "text": "一瞬。"}]
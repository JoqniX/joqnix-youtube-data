[{"type": "subtitle", "time": 4621.03, "timestamp": "01:17:01", "text": "来月そこに行く予定です。だからそれは"}, {"type": "subtitle", "time": 4625.51, "timestamp": "01:17:05", "text": "それは特別なフェスティバルで、"}, {"type": "subtitle", "time": 4627.51, "timestamp": "01:17:07", "text": "だって私は今や星座だから。となることによって"}, {"type": "subtitle", "time": 4630.07, "timestamp": "01:17:10", "text": "それは私にも当てはまります。だから"}, {"type": "subtitle", "time": 4633.91, "timestamp": "01:17:13", "text": "オシマグ、バンボウツリーみたいなやつ"}, {"type": "subtitle", "time": 4636.99, "timestamp": "01:17:16", "text": "そう、そして最初のものは"}, {"type": "subtitle", "time": 4639.51, "timestamp": "01:17:19", "text": "タナヴァタの木"}, {"type": "subtitle", "time": 4642.63, "timestamp": "01:17:22", "text": "今日気づいたんだ、いや、今日だよ"}, {"type": "chat", "time": 4643.818, "timestamp": "01:17:23", "author": "@dazai8348", "avatar": "https://yt4.ggpht.com/FGjFKkkvDG7xMdh4VOSW06NFnlL3RtbXADws9FQ96lGBLjUzBj_TIiBpeB9bTGrr7SrbCgomrg=s64-c-k-c0x00ffffff-no-rj", "message": "i see"}, {"type": "subtitle", "time": 4646.59, "timestamp": "01:17:26", "text": "平和を意図しているのを見ながら"}, {"type": "chat", "time": 4648.283, "timestamp": "01:17:28", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Dazai~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 4649.91, "timestamp": "01:17:29", "text": "そしてそれは運命だ"}, {"type": "subtitle", "time": 4653.35, "timestamp": "01:17:33", "text": "そしてついに、ついに、見ることができる"}, {"type": "subtitle", "time": 4656.47, "timestamp": "01:17:36", "text": "もし現実のその祭りが"}, {"type": "subtitle", "time": 4659.59, "timestamp": "01:17:39", "text": "学校の人たちが私に見に行かせてくれた"}, {"type": "subtitle", "time": 4661.669, "timestamp": "01:17:41", "text": "いいえ、彼らは実際に"}, {"type": "subtitle", "time": 4664.07, "timestamp": "01:17:44", "text": "彼らが好きな生徒たちは、まるでグループのような存在になるでしょう"}, {"type": "subtitle", "time": 4665.59, "timestamp": "01:17:45", "text": "イベント。"}, {"type": "subtitle", "time": 4667.99, "timestamp": "01:17:47", "text": "うん、君はただ、ほら、何をすればいいの？"}, {"type": "subtitle", "time": 4677.83, "timestamp": "01:17:57", "text": "こっそり抜け出す。大丈夫。そうだといい。私はかもしれない"}]
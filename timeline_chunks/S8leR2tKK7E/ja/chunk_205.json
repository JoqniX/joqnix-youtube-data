[{"type": "subtitle", "time": 12300.59, "timestamp": "03:25:00", "text": "すべてだが、そうではなかったかもしれない"}, {"type": "subtitle", "time": 12303.51, "timestamp": "03:25:03", "text": "あなたにとっての結果とか、そういうこと。ええ、それは"}, {"type": "subtitle", "time": 12305.51, "timestamp": "03:25:05", "text": "なぜ代理店の企業物が"}, {"type": "subtitle", "time": 12307.19, "timestamp": "03:25:07", "text": "評判の良いものでない限り、私にとってはサークルです"}, {"type": "subtitle", "time": 12310.07, "timestamp": "03:25:10", "text": "一つとすべてとすべて"}, {"type": "subtitle", "time": 12312.71, "timestamp": "03:25:12", "text": "そうすれば、私は保証できます。"}, {"type": "subtitle", "time": 12315.11, "timestamp": "03:25:15", "text": "私はサポートしてくれる人たちに頼みます"}, {"type": "subtitle", "time": 12317.59, "timestamp": "03:25:17", "text": "私を導いてくれるために、そしてすべてが正しい"}, {"type": "subtitle", "time": 12320.55, "timestamp": "03:25:20", "text": "グループに関してはそういう側面がある"}, {"type": "subtitle", "time": 12322.429, "timestamp": "03:25:22", "text": "グループを形成する"}, {"type": "subtitle", "time": 12327.51, "timestamp": "03:25:27", "text": "いろいろな人が必要なんですよね"}, {"type": "subtitle", "time": 12329.79, "timestamp": "03:25:29", "text": "さまざまな人々が"}, {"type": "chat", "time": 12331.327, "timestamp": "03:25:31", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "agencies are a hit or miss most of the time, everyone's got their own priorities "}, {"type": "subtitle", "time": 12332.87, "timestamp": "03:25:32", "text": "独立して"}, {"type": "subtitle", "time": 12336.229, "timestamp": "03:25:36", "text": "グループワーク"}, {"type": "subtitle", "time": 12338.03, "timestamp": "03:25:38", "text": "えーと"}, {"type": "subtitle", "time": 12341.71, "timestamp": "03:25:41", "text": "ちょっと待って、ちょっと読ませて"}, {"type": "subtitle", "time": 12344.309, "timestamp": "03:25:44", "text": "今、インドでは誰もが"}, {"type": "subtitle", "time": 12346.389, "timestamp": "03:25:46", "text": "ここで言語について何か共有できます"}, {"type": "subtitle", "time": 12348.15, "timestamp": "03:25:48", "text": "そして、"}, {"type": "subtitle", "time": 12350.51, "timestamp": "03:25:50", "text": "身体を動かし、物事を学ぶ"}, {"type": "subtitle", "time": 12352.87, "timestamp": "03:25:52", "text": "その前に怒りはより早く高まる可能性がある"}, {"type": "subtitle", "time": 12354.229, "timestamp": "03:25:54", "text": "そして、あなたの前のコメントの方が良いかもしれません"}, {"type": "subtitle", "time": 12356.309, "timestamp": "03:25:56", "text": "より忍耐強く、他の何人かは"}, {"type": "subtitle", "time": 12358.349, "timestamp": "03:25:58", "text": "ない"}, {"type": "subtitle", "time": 12359.51, "timestamp": "03:25:59", "text": "もちろん"}]
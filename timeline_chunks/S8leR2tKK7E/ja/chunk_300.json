[{"type": "subtitle", "time": 18002.07, "timestamp": "05:00:02", "text": "頂点。頂点。うん。うん。そして水曜日"}, {"type": "subtitle", "time": 18006.15, "timestamp": "05:00:06", "text": "私たちは歌う息の流れを持ちます"}, {"type": "subtitle", "time": 18008.39, "timestamp": "05:00:08", "text": "いつもの。私たちはそれを毎週行っています"}, {"type": "subtitle", "time": 18011.19, "timestamp": "05:00:11", "text": "もの。木曜日は新しい日だ。私"}, {"type": "subtitle", "time": 18013.43, "timestamp": "05:00:13", "text": "今まで試したことはなかったけど、"}, {"type": "subtitle", "time": 18017.03, "timestamp": "05:00:17", "text": "それ以来ずっとそうしている。だから私たちは学ぶことになる"}, {"type": "subtitle", "time": 18022.11, "timestamp": "05:00:22", "text": "ピアノ 音楽の芸術 ピアノ"}, {"type": "subtitle", "time": 18024.43, "timestamp": "05:00:24", "text": "もの。"}, {"type": "subtitle", "time": 18030.43, "timestamp": "05:00:30", "text": "ええ、そうですね、私はそれについてとても楽しみにしています。"}, {"type": "subtitle", "time": 18039.11, "timestamp": "05:00:39", "text": "ええ、だから私はそれについてとても興奮しています。"}, {"type": "subtitle", "time": 18040.35, "timestamp": "05:00:40", "text": "それで"}, {"type": "subtitle", "time": 18044.07, "timestamp": "05:00:44", "text": "うん、ピアノの練習、うまくいくといいな。"}, {"type": "subtitle", "time": 18047.99, "timestamp": "05:00:47", "text": "えっと、あまりよく知らないけど、そうですね"}, {"type": "subtitle", "time": 18050.99, "timestamp": "05:00:50", "text": "土曜日は"}, {"type": "subtitle", "time": 18054.03, "timestamp": "05:00:54", "text": "私たちの3番目"}, {"type": "subtitle", "time": 18056.788, "timestamp": "05:00:56", "text": "記念日は実は初めてです"}]
[{"type": "subtitle", "time": 19204.19, "timestamp": "05:20:04", "text": "[音楽]"}, {"type": "subtitle", "time": 19206.628, "timestamp": "05:20:06", "text": "神。ちょっと待って。ちょっと待って。ちょっと待って。"}, {"type": "subtitle", "time": 19207.99, "timestamp": "05:20:07", "text": "私はこれを手に入れるつもりです。私は行きます"}, {"type": "subtitle", "time": 19221.948, "timestamp": "05:20:21", "text": "[音楽]"}, {"type": "subtitle", "time": 19230.11, "timestamp": "05:20:30", "text": "1つ？いいえ、それは違います。私は"}, {"type": "subtitle", "time": 19234.67, "timestamp": "05:20:34", "text": "希望。まあ、私は1つしか見ていないけど"}, {"type": "subtitle", "time": 19247.868, "timestamp": "05:20:47", "text": "チェック。ああ、彼をノックアウトするべきだった"}, {"type": "subtitle", "time": 19251.43, "timestamp": "05:20:51", "text": "下。つまり、アルファ世紀ではないということだ。それで、"}, {"type": "subtitle", "time": 19254.35, "timestamp": "05:20:54", "text": "えーと、それは"}, {"type": "subtitle", "time": 19257.43, "timestamp": "05:20:57", "text": "変更する。なぜジャンプスタートが必要なのですか？ああ、神様。"}]
[{"type": "subtitle", "time": 8102.47, "timestamp": "02:15:02", "text": "それなら、喜んでやりますよ。うん。"}, {"type": "subtitle", "time": 8106.51, "timestamp": "02:15:06", "text": "あまり大きく変えずに、"}, {"type": "subtitle", "time": 8112.47, "timestamp": "02:15:12", "text": "知る。それで、あなたはそれが好きですか？大好きです。"}, {"type": "subtitle", "time": 8117.589, "timestamp": "02:15:17", "text": "そしてあなたは私を助けてくれました"}, {"type": "subtitle", "time": 8120.589, "timestamp": "02:15:20", "text": "物事がどのように機能するかを理解し、"}, {"type": "subtitle", "time": 8123.669, "timestamp": "02:15:23", "text": "すべて。あなたに聞いてよかった"}, {"type": "subtitle", "time": 8126.39, "timestamp": "02:15:26", "text": "私がすべてのことにとても慣れていなかった日"}, {"type": "subtitle", "time": 8134.709, "timestamp": "02:15:34", "text": "しかし、このモデルは素晴らしい。"}, {"type": "subtitle", "time": 8136.31, "timestamp": "02:15:36", "text": "でも、もしあなたがただ"}, {"type": "subtitle", "time": 8137.91, "timestamp": "02:15:37", "text": "まるでゴミの山に行くようなものだ"}, {"type": "subtitle", "time": 8147.75, "timestamp": "02:15:47", "text": "ストリーム。私は、いいえ、問題は"}, {"type": "subtitle", "time": 8151.109, "timestamp": "02:15:51", "text": "私は、少なくとも"}, {"type": "subtitle", "time": 8154.95, "timestamp": "02:15:54", "text": "Jathan の期間中にアート シングをプレビューします。"}, {"type": "subtitle", "time": 8157.51, "timestamp": "02:15:57", "text": "しかし、その裏で合併症が起こった。"}]
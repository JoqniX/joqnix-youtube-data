[{"type": "subtitle", "time": 2046.87, "timestamp": "00:34:06", "text": "バカは無垢を修正する。純粋さを修復する"}, {"type": "subtitle", "time": 2049.669, "timestamp": "00:34:09", "text": "きちんと睡眠をとって、"}, {"type": "subtitle", "time": 2052.51, "timestamp": "00:34:12", "text": "目覚めて生産的になる"}, {"type": "subtitle", "time": 2076.589, "timestamp": "00:34:36", "text": "睡眠時間または睡眠"}, {"type": "subtitle", "time": 2079.349, "timestamp": "00:34:39", "text": "間隔。私ならできます。私はできる"}, {"type": "subtitle", "time": 2088.23, "timestamp": "00:34:48", "text": "ええ、私の母は怖い猫ではありません。"}, {"type": "subtitle", "time": 2089.93, "timestamp": "00:34:49", "text": "彼女は"}, {"type": "subtitle", "time": 2092.51, "timestamp": "00:34:52", "text": "[音楽]"}, {"type": "subtitle", "time": 2096.389, "timestamp": "00:34:56", "text": "怖い。ええ、そうですね、私は言ったと思います"}, {"type": "subtitle", "time": 2099.27, "timestamp": "00:34:59", "text": "言いたかったことを全て言ってくれた。えっと"}]
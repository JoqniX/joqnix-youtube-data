[{"type": "subtitle", "time": 6900.79, "timestamp": "01:55:00", "text": "このモデル。誕生日だったと思う"}, {"type": "subtitle", "time": 6903.51, "timestamp": "01:55:03", "text": "今すぐ私から贈り物を。"}, {"type": "subtitle", "time": 6906.629, "timestamp": "01:55:06", "text": "ああ、彼女はすごいよ。私は本当に尊敬しています"}, {"type": "subtitle", "time": 6910.31, "timestamp": "01:55:10", "text": "彼女の作品がとても好きです。もし私が好きだったら"}, {"type": "subtitle", "time": 6911.91, "timestamp": "01:55:11", "text": "彼女の手を盗むために何を言いたいか"}, {"type": "subtitle", "time": 6913.91, "timestamp": "01:55:13", "text": "剥製にして保管する"}, {"type": "subtitle", "time": 6920.55, "timestamp": "01:55:20", "text": "Kickで配信してるの？私は"}, {"type": "subtitle", "time": 6922.39, "timestamp": "01:55:22", "text": "Kickでしばらく配信しています。"}, {"type": "subtitle", "time": 6925.75, "timestamp": "01:55:25", "text": "ええ、ヨアトンの1章の始まりの頃だと思います。"}, {"type": "subtitle", "time": 6927.35, "timestamp": "01:55:27", "text": "推測。"}, {"type": "subtitle", "time": 6930.39, "timestamp": "01:55:30", "text": "進捗状況はいかがですか？ H それは"}, {"type": "subtitle", "time": 6931.39, "timestamp": "01:55:31", "text": "行く"}, {"type": "subtitle", "time": 6934.709, "timestamp": "01:55:34", "text": "わかった。ビームストリームとキックは"}, {"type": "subtitle", "time": 6936.27, "timestamp": "01:55:36", "text": "行っています"}, {"type": "subtitle", "time": 6940.149, "timestamp": "01:55:40", "text": "わかった。えっと、ただボットがいるんです"}, {"type": "subtitle", "time": 6943.03, "timestamp": "01:55:43", "text": "まるでDiscordをドロップして入ってくる"}, {"type": "subtitle", "time": 6945.35, "timestamp": "01:55:45", "text": "もっとフォロワーが欲しいなら、私をフォローして追加してください"}, {"type": "subtitle", "time": 6947.75, "timestamp": "01:55:47", "text": "Discordみたいなやつだけど、それでも"}, {"type": "subtitle", "time": 6950.47, "timestamp": "01:55:50", "text": "そこには本当に誠実な人たちがいる"}, {"type": "subtitle", "time": 6952.709, "timestamp": "01:55:52", "text": "実際の視聴者数。"}, {"type": "subtitle", "time": 6955.31, "timestamp": "01:55:55", "text": "うん。それが私がここに通い続ける理由です"}, {"type": "subtitle", "time": 6958.629, "timestamp": "01:55:58", "text": "戻るのは、"}]
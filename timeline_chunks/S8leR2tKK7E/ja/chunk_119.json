[{"type": "subtitle", "time": 7141.75, "timestamp": "01:59:01", "text": "十分だけど、私が言うように、"}, {"type": "subtitle", "time": 7143.35, "timestamp": "01:59:03", "text": "システムに何か起こると"}, {"type": "subtitle", "time": 7145.83, "timestamp": "01:59:05", "text": "やる気をなくさせるようなもので、さらに"}, {"type": "subtitle", "time": 7149.51, "timestamp": "01:59:09", "text": "燃え尽き症候群は、まるで"}, {"type": "subtitle", "time": 7151.669, "timestamp": "01:59:11", "text": "何て言えばいいの、ただそう感じるだけ"}, {"type": "subtitle", "time": 7155.109, "timestamp": "01:59:15", "text": "殴られて、とても時間がかかる"}, {"type": "subtitle", "time": 7157.43, "timestamp": "01:59:17", "text": "エネルギーを再び集めて戻る"}, {"type": "subtitle", "time": 7160.87, "timestamp": "01:59:20", "text": "ライブ。はい。そして私は一般的にそれに直面しました"}, {"type": "subtitle", "time": 7163.75, "timestamp": "01:59:23", "text": "そして私は、"}, {"type": "subtitle", "time": 7166.55, "timestamp": "01:59:26", "text": "ねえ、知ってる？私はしたくない"}, {"type": "subtitle", "time": 7169.31, "timestamp": "01:59:29", "text": "もうこんなことはしたくない。もうやめよう"}, {"type": "subtitle", "time": 7172.51, "timestamp": "01:59:32", "text": "ストリーミングまたは話すのをやめるまたは"}, {"type": "subtitle", "time": 7174.87, "timestamp": "01:59:34", "text": "何かあったから"}, {"type": "subtitle", "time": 7176.51, "timestamp": "01:59:36", "text": "背後で起こっていること"}, {"type": "subtitle", "time": 7178.51, "timestamp": "01:59:38", "text": "そのシーン"}, {"type": "subtitle", "time": 7183.189, "timestamp": "01:59:43", "text": "時間。そして私はストリーミング配信に戻ってきた。それ"}, {"type": "subtitle", "time": 7186.03, "timestamp": "01:59:46", "text": "すべてであり、さらに手に入れた"}, {"type": "subtitle", "time": 7190.31, "timestamp": "01:59:50", "text": "多くのことで傷つき、そして今"}, {"type": "subtitle", "time": 7192.91, "timestamp": "01:59:52", "text": "今私はここで"}, {"type": "subtitle", "time": 7197.47, "timestamp": "01:59:57", "text": "チャソンは、ただ自分の"}]
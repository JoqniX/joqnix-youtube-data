[{"type": "subtitle", "time": 4500.149, "timestamp": "01:15:00", "text": "それを本当に楽しみにしている"}, {"type": "subtitle", "time": 4501.83, "timestamp": "01:15:01", "text": "えっと、何してるの？"}, {"type": "subtitle", "time": 4505.83, "timestamp": "01:15:05", "text": "再びデビューするが、これはどうなるのだろうか"}, {"type": "subtitle", "time": 4507.99, "timestamp": "01:15:07", "text": "あなたの熱意がどれだけあるかを示してください"}, {"type": "subtitle", "time": 4510.99, "timestamp": "01:15:10", "text": "一般的な？"}, {"type": "subtitle", "time": 4514.79, "timestamp": "01:15:14", "text": "うん、最高だよ。つまり、それはかなり"}, {"type": "subtitle", "time": 4516.709, "timestamp": "01:15:16", "text": "私が一生懸命働くという事実"}, {"type": "subtitle", "time": 4520.79, "timestamp": "01:15:20", "text": "このバカが生き返るためには"}, {"type": "subtitle", "time": 4523.669, "timestamp": "01:15:23", "text": "楽しみにしていること"}, {"type": "subtitle", "time": 4526.95, "timestamp": "01:15:26", "text": "膨大な量。でも、私は気にしません"}, {"type": "subtitle", "time": 4530.59, "timestamp": "01:15:30", "text": "日本からパートタイムで一生懸命働いて"}, {"type": "subtitle", "time": 4533.11, "timestamp": "01:15:33", "text": "すべて、何年経っても"}, {"type": "subtitle", "time": 4534.91, "timestamp": "01:15:34", "text": "取る、あなた"}, {"type": "subtitle", "time": 4537.51, "timestamp": "01:15:37", "text": "あなたは既に一生懸命努力していることを知っています。私"}, {"type": "subtitle", "time": 4538.95, "timestamp": "01:15:38", "text": "それはただ、つまり、根付いているものだと思う"}, {"type": "subtitle", "time": 4541.27, "timestamp": "01:15:41", "text": "この時点でのあなた。ほら、"}, {"type": "subtitle", "time": 4543.189, "timestamp": "01:15:43", "text": "徐々に狂っていく人々"}, {"type": "subtitle", "time": 4544.79, "timestamp": "01:15:44", "text": "もしあなたが常に働いていないなら。私"}, {"type": "subtitle", "time": 4546.39, "timestamp": "01:15:46", "text": "あなたはそういう人の一人だと思う"}, {"type": "subtitle", "time": 4548.47, "timestamp": "01:15:48", "text": "今まで見たことないけど、"}, {"type": "subtitle", "time": 4554.83, "timestamp": "01:15:54", "text": "まさにその通りです。"}, {"type": "subtitle", "time": 4558.51, "timestamp": "01:15:58", "text": "M、とても心配です。なぜなら私は"}]
[{"type": "subtitle", "time": 10502.07, "timestamp": "02:55:02", "text": "中国の編集者のほとんどはこれを受け入れない"}, {"type": "subtitle", "time": 10503.389, "timestamp": "02:55:03", "text": "親切"}, {"type": "subtitle", "time": 10507.03, "timestamp": "02:55:07", "text": "は非常に粗雑で、これを待たなければならない"}, {"type": "subtitle", "time": 10507.95, "timestamp": "02:55:07", "text": "種の"}, {"type": "subtitle", "time": 10511.389, "timestamp": "02:55:11", "text": "翻訳もあります。"}, {"type": "subtitle", "time": 10514.429, "timestamp": "02:55:14", "text": "音声の直訳"}, {"type": "subtitle", "time": 10517.19, "timestamp": "02:55:17", "text": "代表者は出席しなければならない"}, {"type": "subtitle", "time": 10521.19, "timestamp": "02:55:21", "text": "彼らが必要とする状況は"}, {"type": "subtitle", "time": 10524.23, "timestamp": "02:55:24", "text": "翻訳は実際の場所とは異なっています。"}, {"type": "subtitle", "time": 10540.15, "timestamp": "02:55:40", "text": "これは私が翻訳した意味です"}, {"type": "subtitle", "time": 10542.23, "timestamp": "02:55:42", "text": "ソフトウェア。私はそう感じる"}, {"type": "subtitle", "time": 10550.99, "timestamp": "02:55:50", "text": "[音楽]"}, {"type": "subtitle", "time": 10555.269, "timestamp": "02:55:55", "text": "えっと、最後に数字を取得する必要があります。はぁ？"}, {"type": "subtitle", "time": 10556.429, "timestamp": "02:55:56", "text": "どこにいても"}]
[{"type": "subtitle", "time": 960.59, "timestamp": "00:16:00", "text": "人々は失礼だと思った"}, {"type": "subtitle", "time": 964.949, "timestamp": "00:16:04", "text": "onx なぜなら彼らは自分たちが b だと思っているから"}, {"type": "subtitle", "time": 967.79, "timestamp": "00:16:07", "text": "彼女はボトのように思うが、彼女はそうではない"}, {"type": "subtitle", "time": 972.389, "timestamp": "00:16:12", "text": "bto 彼らは新しい人々を歓迎するためにそこにいて、"}, {"type": "subtitle", "time": 976.43, "timestamp": "00:16:16", "text": "えっと、皆さんと一緒に旅行します"}, {"type": "subtitle", "time": 980.31, "timestamp": "00:16:20", "text": "私たちの旅でパートナーとして一緒に"}, {"type": "subtitle", "time": 983.59, "timestamp": "00:16:23", "text": "だから私はオニキスに変えようと思った"}, {"type": "subtitle", "time": 986.79, "timestamp": "00:16:26", "text": "何か新しいものがあれば、"}, {"type": "subtitle", "time": 989.43, "timestamp": "00:16:29", "text": "チャットで新参者を聞くと、彼らは「ああ、オニキス」って言うだろう"}, {"type": "subtitle", "time": 997.509, "timestamp": "00:16:37", "text": "Bと既存の、存在しないような"}, {"type": "subtitle", "time": 1002.389, "timestamp": "00:16:42", "text": "えーっと、私のえーっと、知っている人ならわかると思うけど"}, {"type": "subtitle", "time": 1006.389, "timestamp": "00:16:46", "text": "そう、誰が知ってるの？知ってるよ、私はそれが"}, {"type": "subtitle", "time": 1011.23, "timestamp": "00:16:51", "text": "チャンに行こうとしている彼女は、彼女はあなたの"}, {"type": "subtitle", "time": 1013.91, "timestamp": "00:16:53", "text": "妻。しかし彼女は人前ではそうは言わない"}, {"type": "subtitle", "time": 1016.67, "timestamp": "00:16:56", "text": "でも、私のことだ。私は疑問に思う"}]
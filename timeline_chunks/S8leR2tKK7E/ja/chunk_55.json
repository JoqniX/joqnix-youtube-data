[{"type": "subtitle", "time": 3303.829, "timestamp": "00:55:03", "text": "その日2日目、ああ神様、1日1日"}, {"type": "subtitle", "time": 3306.71, "timestamp": "00:55:06", "text": "つまり、いつか私は自分の"}, {"type": "subtitle", "time": 3314.11, "timestamp": "00:55:14", "text": "私を置いていって。"}, {"type": "subtitle", "time": 3316.549, "timestamp": "00:55:16", "text": "[音楽]"}, {"type": "subtitle", "time": 3318.95, "timestamp": "00:55:18", "text": "ああ、くそ。画質を変更するのを忘れていました"}, {"type": "subtitle", "time": 3322.549, "timestamp": "00:55:22", "text": "あれ。ああ、くそ。ああ、くそ。忘れてしまった"}, {"type": "subtitle", "time": 3323.95, "timestamp": "00:55:23", "text": "変化"}, {"type": "subtitle", "time": 3327.829, "timestamp": "00:55:27", "text": "それ。ああ、くそ。実際、私は"}, {"type": "subtitle", "time": 3330.349, "timestamp": "00:55:30", "text": "変更するのを忘れた"}, {"type": "subtitle", "time": 3344.95, "timestamp": "00:55:44", "text": "こんにちは。これらのものが"}, {"type": "subtitle", "time": 3347.109, "timestamp": "00:55:47", "text": "ゲームの音声などが"}]
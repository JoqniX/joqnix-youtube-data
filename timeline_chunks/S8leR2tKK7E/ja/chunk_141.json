[{"type": "subtitle", "time": 8460.71, "timestamp": "02:21:00", "text": "地域にはたくさんの人がいます"}, {"type": "subtitle", "time": 8463.03, "timestamp": "02:21:03", "text": "助けようとしてくれる人、"}, {"type": "subtitle", "time": 8465.11, "timestamp": "02:21:05", "text": "アセットやデザインを作成するなど"}, {"type": "subtitle", "time": 8468.79, "timestamp": "02:21:08", "text": "無料でご提供します。うん。同じように。完了"}, {"type": "subtitle", "time": 8474.87, "timestamp": "02:21:14", "text": "うん。私はこう思った、なぜ私が"}, {"type": "subtitle", "time": 8477.19, "timestamp": "02:21:17", "text": "物事についてとても心配していた"}, {"type": "subtitle", "time": 8479.59, "timestamp": "02:21:19", "text": "まだ起こってないけど、そうだよ"}, {"type": "subtitle", "time": 8483.429, "timestamp": "02:21:23", "text": "オーバーインカー。ああ、あなたが好きなのは分かります"}, {"type": "subtitle", "time": 8486.23, "timestamp": "02:21:26", "text": "不安だけど、いくつかのことは"}, {"type": "subtitle", "time": 8488.63, "timestamp": "02:21:28", "text": "直面したときに対処する必要があるだけです"}, {"type": "subtitle", "time": 8491.19, "timestamp": "02:21:31", "text": "それは橋を燃やしてそれを手に入れるようなものだ"}, {"type": "subtitle", "time": 8494.469, "timestamp": "02:21:34", "text": "そういう類のものだ。うん、君が"}, {"type": "subtitle", "time": 8497.429, "timestamp": "02:21:37", "text": "先に述べたように、私はためらいません"}, {"type": "subtitle", "time": 8499.99, "timestamp": "02:21:39", "text": "物事を試すのをためらって、"}, {"type": "subtitle", "time": 8502.389, "timestamp": "02:21:42", "text": "それを実行するか、何かするか、とにかく何でもいい。忘れた"}, {"type": "subtitle", "time": 8505.349, "timestamp": "02:21:45", "text": "あなたが言ったセリフは、"}, {"type": "subtitle", "time": 8509.11, "timestamp": "02:21:49", "text": "言ったけど、うん、でも、えっと、最終的にはもし"}, {"type": "subtitle", "time": 8511.75, "timestamp": "02:21:51", "text": "私はモデルをデビューさせるか、"}, {"type": "subtitle", "time": 8513.07, "timestamp": "02:21:53", "text": "モデルまたは"}, {"type": "subtitle", "time": 8517.59, "timestamp": "02:21:57", "text": "私が気にしないもの、"}]
[{"type": "subtitle", "time": 19142.83, "timestamp": "05:19:02", "text": "それ？ああ、忘れてた。"}, {"type": "subtitle", "time": 19146.55, "timestamp": "05:19:06", "text": "えっと、どの惑星だったか忘れちゃったけど、"}, {"type": "subtitle", "time": 19150.708, "timestamp": "05:19:10", "text": "あなたが来るとすぐそばに商人がいます。えっと、"}, {"type": "subtitle", "time": 19152.67, "timestamp": "05:19:12", "text": "それはどの惑星だったのか？"}, {"type": "subtitle", "time": 19155.43, "timestamp": "05:19:15", "text": "ああ、そのビデオを見なきゃ。ああ神様、私は"}, {"type": "subtitle", "time": 19157.788, "timestamp": "05:19:17", "text": "それを見なければならない"}, {"type": "subtitle", "time": 19159.788, "timestamp": "05:19:19", "text": "ビデオ。"}, {"type": "subtitle", "time": 19163.15, "timestamp": "05:19:23", "text": "えっと、あれは何だったんですか？"}, {"type": "subtitle", "time": 19166.55, "timestamp": "05:19:26", "text": "ええと、それはとても"}, {"type": "subtitle", "time": 19169.03, "timestamp": "05:19:29", "text": "椅子とか色々あるから使って。そこには"}, {"type": "subtitle", "time": 19171.03, "timestamp": "05:19:31", "text": "商人とかそういう類。あれだったと思う"}, {"type": "subtitle", "time": 19173.39, "timestamp": "05:19:33", "text": "いいえ、木星ではありません。それは"}, {"type": "subtitle", "time": 19175.47, "timestamp": "05:19:35", "text": "タイタン？待って、それは"}, {"type": "subtitle", "time": 19179.91, "timestamp": "05:19:39", "text": "タイタン？待って、あれはタイタン？"}, {"type": "subtitle", "time": 19182.91, "timestamp": "05:19:42", "text": "タイタンはどこ？えっと、タイタンは"}, {"type": "subtitle", "time": 19194.99, "timestamp": "05:19:54", "text": "右？タイタンがここにいる、"}]
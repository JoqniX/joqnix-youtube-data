[{"type": "subtitle", "time": 8642.23, "timestamp": "02:24:02", "text": "運命ならそうなるだろう"}, {"type": "subtitle", "time": 8648.67, "timestamp": "02:24:08", "text": "もちろん。 D. そして、そして、そして私は"}, {"type": "subtitle", "time": 8651.91, "timestamp": "02:24:11", "text": "新しいモデルのために覚えておいてください"}, {"type": "subtitle", "time": 8654.389, "timestamp": "02:24:14", "text": "デビューしたのに、誰にも言わなかったね。あなたは"}, {"type": "subtitle", "time": 8655.99, "timestamp": "02:24:15", "text": "それはあなた自身のことだ。どうやってそれを"}, {"type": "subtitle", "time": 8658.469, "timestamp": "02:24:18", "text": "あなた自身ですか？つまり、私は本当に得意なんです"}, {"type": "subtitle", "time": 8661.03, "timestamp": "02:24:21", "text": "一般的に秘密を守ること。しかしそれは"}, {"type": "subtitle", "time": 8664.23, "timestamp": "02:24:24", "text": "私が本当に探していたもの"}, {"type": "subtitle", "time": 8666.469, "timestamp": "02:24:26", "text": "転送して、私はそれが"}, {"type": "subtitle", "time": 8669.11, "timestamp": "02:24:29", "text": "驚き。私はそれに取り組んでいました"}, {"type": "subtitle", "time": 8671.349, "timestamp": "02:24:31", "text": "舞台裏で、私はそこにいました"}, {"type": "subtitle", "time": 8673.75, "timestamp": "02:24:33", "text": "あなたのようにそれを知っている人はほとんどいない"}, {"type": "subtitle", "time": 8676.309, "timestamp": "02:24:36", "text": "もちろん、人々はそれを知っていた。"}, {"type": "subtitle", "time": 8678.07, "timestamp": "02:24:38", "text": "人々の多くはそれを知らなかったが"}, {"type": "subtitle", "time": 8681.59, "timestamp": "02:24:41", "text": "カイラ・スキナやザヴァナのように、彼女たちは皆"}, {"type": "subtitle", "time": 8685.27, "timestamp": "02:24:45", "text": "ユユのように、彼らは皆それを知っていた。実際、"}, {"type": "subtitle", "time": 8688.23, "timestamp": "02:24:48", "text": "私が作っていたとき、カイラはそこにいました"}, {"type": "subtitle", "time": 8691.83, "timestamp": "02:24:51", "text": "それに関するムードボード。だから、私は本当に"}, {"type": "subtitle", "time": 8693.67, "timestamp": "02:24:53", "text": "好きになろうとしているようなものって何？ガスライト"}, {"type": "subtitle", "time": 8695.75, "timestamp": "02:24:55", "text": "人々は、"}, {"type": "subtitle", "time": 8697.75, "timestamp": "02:24:57", "text": "大きな進歩や大きな変化はないでしょう"}]
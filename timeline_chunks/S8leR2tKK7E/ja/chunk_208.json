[{"type": "subtitle", "time": 12483.389, "timestamp": "03:28:03", "text": "私をそこから引きずり出そうとするのは有害だ"}, {"type": "subtitle", "time": 12488.63, "timestamp": "03:28:08", "text": "これ。行けと言っている 行けと言っている"}, {"type": "subtitle", "time": 12491.15, "timestamp": "03:28:11", "text": "戻るように言われる"}, {"type": "subtitle", "time": 12496.429, "timestamp": "03:28:16", "text": "私が来た場所へ、"}, {"type": "subtitle", "time": 12498.68, "timestamp": "03:28:18", "text": "など。私は少し"}, {"type": "subtitle", "time": 12501.15, "timestamp": "03:28:21", "text": "[音楽]"}, {"type": "subtitle", "time": 12508.83, "timestamp": "03:28:28", "text": "わかってるけど、やってみるよ"}, {"type": "subtitle", "time": 12524.67, "timestamp": "03:28:44", "text": "申し訳ありません"}]
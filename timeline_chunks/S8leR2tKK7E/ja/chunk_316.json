[{"type": "subtitle", "time": 18962.628, "timestamp": "05:16:02", "text": "こんなガラクタ全部持って旅行はできないよ、"}, {"type": "subtitle", "time": 18965.99, "timestamp": "05:16:05", "text": "右？では、私の秘密を教えましょう。何"}, {"type": "subtitle", "time": 18966.99, "timestamp": "05:16:06", "text": "私"}, {"type": "subtitle", "time": 18970.15, "timestamp": "05:16:10", "text": "やります、文字通り全部捨てます"}, {"type": "subtitle", "time": 18977.868, "timestamp": "05:16:17", "text": "ウィンク。それが私が"}, {"type": "subtitle", "time": 18984.708, "timestamp": "05:16:24", "text": "すべて。私は文字通り全てを捨てます"}, {"type": "subtitle", "time": 18988.03, "timestamp": "05:16:28", "text": "隅っこにいて"}, {"type": "subtitle", "time": 18990.948, "timestamp": "05:16:30", "text": "無料。うん。だから、私はここでバカなことをしない"}, {"type": "subtitle", "time": 18993.628, "timestamp": "05:16:33", "text": "だって、まあ、ちょっと、ちょっと、"}, {"type": "subtitle", "time": 18996.35, "timestamp": "05:16:36", "text": "乱雑な。でも私がやっていることは"}, {"type": "subtitle", "time": 19001.19, "timestamp": "05:16:41", "text": "文字通りこちらへ行ってください、"}, {"type": "subtitle", "time": 19002.75, "timestamp": "05:16:42", "text": "行く"}, {"type": "subtitle", "time": 19005.788, "timestamp": "05:16:45", "text": "在庫、"}, {"type": "subtitle", "time": 19009.67, "timestamp": "05:16:49", "text": "リソース、私のコマンドをスパムします。それはRです"}, {"type": "subtitle", "time": 19011.31, "timestamp": "05:16:51", "text": "そして"}]
[{"type": "subtitle", "time": 12544.229, "timestamp": "03:29:04", "text": "えっと、集中できないんです"}, {"type": "subtitle", "time": 12549.75, "timestamp": "03:29:09", "text": "今まさに取り組んでいます。私は引っ越す予定です"}, {"type": "subtitle", "time": 12550.59, "timestamp": "03:29:10", "text": "に"}, {"type": "subtitle", "time": 12561.71, "timestamp": "03:29:21", "text": "月。誰が知っているだろうか？いつになるかは誰にもわからない"}, {"type": "subtitle", "time": 12566.03, "timestamp": "03:29:26", "text": "実際にストリーミングして"}, {"type": "subtitle", "time": 12570.99, "timestamp": "03:29:30", "text": "えっと、配信して色々やってる"}, {"type": "subtitle", "time": 12579.03, "timestamp": "03:29:39", "text": "そこには。だから難しいんです"}, {"type": "subtitle", "time": 12585.55, "timestamp": "03:29:45", "text": "私"}, {"type": "subtitle", "time": 12589.19, "timestamp": "03:29:49", "text": "正直、本当にそうしたかった"}]
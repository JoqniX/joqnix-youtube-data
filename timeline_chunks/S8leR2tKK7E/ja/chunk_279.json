[{"type": "subtitle", "time": 16757.07, "timestamp": "04:39:17", "text": "よし、じゃあ変なカラスを上に置くよ"}, {"type": "subtitle", "time": 16761.029, "timestamp": "04:39:21", "text": "ここ。見てみましょう。私にはこれがあるんです。"}, {"type": "subtitle", "time": 16764.31, "timestamp": "04:39:24", "text": "土曜日は予約に空きがあります。誰が"}, {"type": "subtitle", "time": 16766.551, "timestamp": "04:39:26", "text": "では、誰を置けばよいのでしょうか？待って、私は"}, {"type": "subtitle", "time": 16769.551, "timestamp": "04:39:29", "text": "すべてを再確認する。"}, {"type": "subtitle", "time": 16773.51, "timestamp": "04:39:33", "text": "その他、十分な時間があるときは、"}, {"type": "subtitle", "time": 16780.868, "timestamp": "04:39:40", "text": "日。ええ、"}]
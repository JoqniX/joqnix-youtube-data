[{"type": "subtitle", "time": 12241.469, "timestamp": "03:24:01", "text": "なぜなのか"}, {"type": "subtitle", "time": 12244.429, "timestamp": "03:24:04", "text": "いつもそうなるのはなぜですか"}, {"type": "subtitle", "time": 12246.79, "timestamp": "03:24:06", "text": "数字？私はとても感謝しています"}, {"type": "subtitle", "time": 12248.15, "timestamp": "03:24:08", "text": "私と一緒に手伝ってくれる友人グループ"}, {"type": "subtitle", "time": 12250.469, "timestamp": "03:24:10", "text": "いろいろあって、後でやらなきゃ。たぶん私は"}, {"type": "subtitle", "time": 12268.07, "timestamp": "03:24:28", "text": "私は代理店とはもう関わりたくない。"}, {"type": "subtitle", "time": 12269.99, "timestamp": "03:24:29", "text": "エージェンシーに参加することは、"}, {"type": "subtitle", "time": 12272.87, "timestamp": "03:24:32", "text": "私の友人がそれをしたので、私は自分の"}, {"type": "subtitle", "time": 12276.309, "timestamp": "03:24:36", "text": "友人との経験と彼らは"}, {"type": "subtitle", "time": 12278.63, "timestamp": "03:24:38", "text": "実際に理にかなったアドバイス"}, {"type": "subtitle", "time": 12282.79, "timestamp": "03:24:42", "text": "それは本当だし、すべて、そして私は"}, {"type": "subtitle", "time": 12285.349, "timestamp": "03:24:45", "text": "そんな風には見えなかったけど、"}, {"type": "subtitle", "time": 12287.309, "timestamp": "03:24:47", "text": "本当だ、まるで"}, {"type": "subtitle", "time": 12292.269, "timestamp": "03:24:52", "text": "了解。うまくいくかもしれないし、うまくいかないかもしれない。"}, {"type": "subtitle", "time": 12295.349, "timestamp": "03:24:55", "text": "美しい本であっても"}, {"type": "subtitle", "time": 12296.75, "timestamp": "03:24:56", "text": "約束と"}]
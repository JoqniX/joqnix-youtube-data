[{"type": "subtitle", "time": 1653.149, "timestamp": "00:27:33", "text": "そしてついに、私は戻ってきました。おお"}, {"type": "subtitle", "time": 1656.43, "timestamp": "00:27:36", "text": "神。ねえ、あの"}, {"type": "subtitle", "time": 1660.149, "timestamp": "00:27:40", "text": "司令官。うん。さて、どこまで話しましたっけ？あなた"}, {"type": "subtitle", "time": 1663.59, "timestamp": "00:27:43", "text": "肌に切り替える。"}, {"type": "subtitle", "time": 1666.909, "timestamp": "00:27:46", "text": "こんにちは。ということで、戻ってきました。"}, {"type": "subtitle", "time": 1670.549, "timestamp": "00:27:50", "text": "また。皆さんに不快な思いをさせてしまったのではないかと心配しています。"}, {"type": "subtitle", "time": 1674.11, "timestamp": "00:27:54", "text": "待ちすぎた。こんにちは。それで、"}, {"type": "subtitle", "time": 1677.71, "timestamp": "00:27:57", "text": "えっと、何の話をしていたんだっけ？"}]
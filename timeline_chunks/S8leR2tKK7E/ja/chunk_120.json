[{"type": "subtitle", "time": 7201.03, "timestamp": "02:00:01", "text": "物事を心配するのをやめなさい。私は"}, {"type": "subtitle", "time": 7204.629, "timestamp": "02:00:04", "text": "あなたがまだここにいてくれて本当に嬉しいです。だけでなく"}, {"type": "subtitle", "time": 7207.35, "timestamp": "02:00:07", "text": "これは私の個人的な哲学です"}, {"type": "subtitle", "time": 7209.75, "timestamp": "02:00:09", "text": "もしあなたが、あなたが知っているように、あなたがすることを好むなら"}, {"type": "subtitle", "time": 7212.39, "timestamp": "02:00:12", "text": "あなたが本当に好き、または愛しているもの"}, {"type": "subtitle", "time": 7214.229, "timestamp": "02:00:14", "text": "やめるべきではない理由"}, {"type": "subtitle", "time": 7216.31, "timestamp": "02:00:16", "text": "あなたの状況。私はただ"}, {"type": "subtitle", "time": 7218.07, "timestamp": "02:00:18", "text": "私が言うような少しの"}, {"type": "subtitle", "time": 7219.99, "timestamp": "02:00:19", "text": "距離。離れていればいい"}, {"type": "subtitle", "time": 7221.83, "timestamp": "02:00:21", "text": "しばらくの間、それから離れる、ほら、"}, {"type": "subtitle", "time": 7224.709, "timestamp": "02:00:24", "text": "休憩して、"}, {"type": "subtitle", "time": 7226.55, "timestamp": "02:00:26", "text": "きっとあなたも同じように気に入るでしょう"}, {"type": "subtitle", "time": 7229.27, "timestamp": "02:00:29", "text": "なぜなら、もしあなたが正気でないなら"}, {"type": "subtitle", "time": 7232.39, "timestamp": "02:00:32", "text": "それは一体何なのか、そしてあなたはそれをやり続ける"}, {"type": "subtitle", "time": 7235.91, "timestamp": "02:00:35", "text": "あなたは、ある種のつながりを始めるのが好きになるでしょう"}, {"type": "subtitle", "time": 7238.709, "timestamp": "02:00:38", "text": "その活動に関する否定的なこと"}, {"type": "subtitle", "time": 7241.03, "timestamp": "02:00:41", "text": "それは本当に傷つくことだ。その"}, {"type": "subtitle", "time": 7242.31, "timestamp": "02:00:42", "text": "まるで、とても傷つくようなこと"}, {"type": "subtitle", "time": 7244.229, "timestamp": "02:00:44", "text": "もしあなたがそれを、それは物事であるならば"}, {"type": "subtitle", "time": 7247.51, "timestamp": "02:00:47", "text": "あなたは本当に大好きです。うん。これは"}, {"type": "subtitle", "time": 7249.669, "timestamp": "02:00:49", "text": "私の頼れるアドバイスは"}, {"type": "subtitle", "time": 7252.31, "timestamp": "02:00:52", "text": "私が知っているほとんどのストリーマーにとって"}, {"type": "subtitle", "time": 7254.149, "timestamp": "02:00:54", "text": "ご存知のように、私は会ったことがあり、"}, {"type": "subtitle", "time": 7256.31, "timestamp": "02:00:56", "text": "困難なことがたくさん起こっている"}, {"type": "subtitle", "time": 7259.189, "timestamp": "02:00:59", "text": "ほんの少しの時間で済む"}]
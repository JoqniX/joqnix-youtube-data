[{"type": "subtitle", "time": 10921.91, "timestamp": "03:02:01", "text": "誰もいないから仕事できない"}, {"type": "subtitle", "time": 10923.95, "timestamp": "03:02:03", "text": "私を導くために"}, {"type": "subtitle", "time": 10938.269, "timestamp": "03:02:18", "text": "えっと、私は何をすればいいの？"}, {"type": "subtitle", "time": 10941.19, "timestamp": "03:02:21", "text": "描く？ビリー・ビリーは少なくとも"}, {"type": "subtitle", "time": 10945.03, "timestamp": "03:02:25", "text": "私の心配事の一つです。私はしなければならない"}, {"type": "subtitle", "time": 10953.59, "timestamp": "03:02:33", "text": "すべて。 H でも、それでもそれはあまりにも"}, {"type": "subtitle", "time": 10966.309, "timestamp": "03:02:46", "text": "少なくとも会社は、あなたが"}, {"type": "subtitle", "time": 10972.07, "timestamp": "03:02:52", "text": "もの。会社が"}, {"type": "subtitle", "time": 10975.11, "timestamp": "03:02:55", "text": "あなたがやりたいことはとても"}, {"type": "subtitle", "time": 10977.83, "timestamp": "03:02:57", "text": "有名な。だからそう考える、だからそう考える"}, {"type": "subtitle", "time": 10979.67, "timestamp": "03:02:59", "text": "名を上げることは、"}]
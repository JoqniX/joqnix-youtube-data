[{"type": "subtitle", "time": 16686.269, "timestamp": "04:38:06", "text": "なぜ"}, {"type": "subtitle", "time": 16695.51, "timestamp": "04:38:15", "text": "あなたが私の最初のゲストになると思っていました"}, {"type": "subtitle", "time": 16701.67, "timestamp": "04:38:21", "text": "その日、そしてほとんどの人が好む"}, {"type": "subtitle", "time": 16703.31, "timestamp": "04:38:23", "text": "えーと"}, {"type": "subtitle", "time": 16705.15, "timestamp": "04:38:25", "text": "えっと"}, {"type": "subtitle", "time": 16708.23, "timestamp": "04:38:28", "text": "午後、夕方、そして"}, {"type": "subtitle", "time": 16711.07, "timestamp": "04:38:31", "text": "夜、夜"}, {"type": "subtitle", "time": 16715.23, "timestamp": "04:38:35", "text": "回。少なくとも私は"}, {"type": "subtitle", "time": 16720.189, "timestamp": "04:38:40", "text": "より長いセッションをお楽しみください"}, {"type": "subtitle", "time": 16724.23, "timestamp": "04:38:44", "text": "あなたとのより長いセッション"}]
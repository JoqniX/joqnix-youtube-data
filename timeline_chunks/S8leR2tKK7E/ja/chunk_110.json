[{"type": "subtitle", "time": 6600.109, "timestamp": "01:50:00", "text": "そうなるであろう"}, {"type": "subtitle", "time": 6604.149, "timestamp": "01:50:04", "text": "金銭的な面では、"}, {"type": "subtitle", "time": 6607.03, "timestamp": "01:50:07", "text": "目標設定の方法を知っていて、"}, {"type": "subtitle", "time": 6608.669, "timestamp": "01:50:08", "text": "物事や行動"}, {"type": "subtitle", "time": 6613.27, "timestamp": "01:50:13", "text": "目標設定、ルーレットを回すなど、すべて。"}, {"type": "subtitle", "time": 6615.91, "timestamp": "01:50:15", "text": "大丈夫。まだ時間はあるよ。私はまだ"}, {"type": "subtitle", "time": 6617.99, "timestamp": "01:50:17", "text": "時間はあるけど、やり方もわからない"}, {"type": "subtitle", "time": 6620.47, "timestamp": "01:50:20", "text": "きちんとやりなさい。"}, {"type": "subtitle", "time": 6622.95, "timestamp": "01:50:22", "text": "それは正気の沙汰ではない。まるで"}, {"type": "subtitle", "time": 6624.55, "timestamp": "01:50:24", "text": "やり方がわからないこと"}, {"type": "subtitle", "time": 6627.35, "timestamp": "01:50:27", "text": "それは私にとって全く狂気じみている"}, {"type": "subtitle", "time": 6631.35, "timestamp": "01:50:31", "text": "聞くと、まるで毎回のようにそこにいるから"}, {"type": "subtitle", "time": 6634.189, "timestamp": "01:50:34", "text": "ストリーミングに関連するもの"}, {"type": "subtitle", "time": 6637.229, "timestamp": "01:50:37", "text": "ATMに関しては、まるで全ての答えを持っているかのようです。"}, {"type": "subtitle", "time": 6641.189, "timestamp": "01:50:41", "text": "準備ができたら、またはあなたが学んでから私たちに教えてください。"}, {"type": "subtitle", "time": 6643.43, "timestamp": "01:50:43", "text": "それはまさに何と言えばいいのか"}, {"type": "subtitle", "time": 6645.91, "timestamp": "01:50:45", "text": "あなたがそうしないと聞いて驚愕です"}, {"type": "subtitle", "time": 6651.27, "timestamp": "01:50:51", "text": "何か違うことをしているが、あなたはただ嘘をついているだけだ。"}, {"type": "subtitle", "time": 6653.109, "timestamp": "01:50:53", "text": "知らないはずがない。つまり、"}, {"type": "subtitle", "time": 6655.51, "timestamp": "01:50:55", "text": "やり方はわかってるんだけど、"}]
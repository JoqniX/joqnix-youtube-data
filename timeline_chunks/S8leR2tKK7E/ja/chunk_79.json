[{"type": "subtitle", "time": 4742.87, "timestamp": "01:19:02", "text": "私は慣れる必要があった、すべてではない、"}, {"type": "subtitle", "time": 4745.11, "timestamp": "01:19:05", "text": "すべてのバスルームには鍵が付いているか、付いていないかのどちらかです。"}, {"type": "subtitle", "time": 4746.35, "timestamp": "01:19:06", "text": "天井がある"}, {"type": "subtitle", "time": 4749.669, "timestamp": "01:19:09", "text": "扇風機がない、もしくは洗濯物を干す場所がない"}, {"type": "subtitle", "time": 4753.189, "timestamp": "01:19:13", "text": "ラック全般、そしてもちろん好きではない"}, {"type": "subtitle", "time": 4755.91, "timestamp": "01:19:15", "text": "ハンドシャワーとかジェットとか"}, {"type": "subtitle", "time": 4759.35, "timestamp": "01:19:19", "text": "トイレの近くにスプレーしてください。何てことだ。のように"}, {"type": "subtitle", "time": 4761.75, "timestamp": "01:19:21", "text": "慣れるしかないようなことだった。しかし"}, {"type": "subtitle", "time": 4764.229, "timestamp": "01:19:24", "text": "それから携帯用ジェットスプレーを買いました"}, {"type": "subtitle", "time": 4773.43, "timestamp": "01:19:33", "text": "あらら。うん、それも"}, {"type": "subtitle", "time": 4775.189, "timestamp": "01:19:35", "text": "慣れるしかない。ああ、なんてことだ、"}, {"type": "subtitle", "time": 4779.75, "timestamp": "01:19:39", "text": "たくさんのこと。何てことだ。"}, {"type": "subtitle", "time": 4781.75, "timestamp": "01:19:41", "text": "正直言って、"}, {"type": "subtitle", "time": 4784.229, "timestamp": "01:19:44", "text": "Amazonでも携帯用ジェットスプレーが販売されています。"}, {"type": "subtitle", "time": 4791.35, "timestamp": "01:19:51", "text": "それほど悪くはないよ。"}, {"type": "subtitle", "time": 4793.47, "timestamp": "01:19:53", "text": "えっと、"}, {"type": "subtitle", "time": 4796.95, "timestamp": "01:19:56", "text": "Amazon.comやUK、あるいはそれとは違う"}, {"type": "subtitle", "time": 4799.91, "timestamp": "01:19:59", "text": "地域アカウントを再度利用しますか？"}]
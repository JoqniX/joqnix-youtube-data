[{"type": "subtitle", "time": 4022.309, "timestamp": "01:07:02", "text": "私はそこに1年間滞在しました。"}, {"type": "subtitle", "time": 4025.51, "timestamp": "01:07:05", "text": "うん。はい。うん。"}, {"type": "subtitle", "time": 4029.19, "timestamp": "01:07:09", "text": "知っている。私たちは言ったように、私たちは話しました"}, {"type": "subtitle", "time": 4032.47, "timestamp": "01:07:12", "text": "DMでも以前と同様です。次のような方々へ"}, {"type": "subtitle", "time": 4034.47, "timestamp": "01:07:14", "text": "わからない、私は"}, {"type": "subtitle", "time": 4036.95, "timestamp": "01:07:16", "text": "セレスティアがインドを離れていた"}, {"type": "subtitle", "time": 4039.829, "timestamp": "01:07:19", "text": "ずっと。彼女を再起動したとき"}, {"type": "subtitle", "time": 4043.589, "timestamp": "01:07:23", "text": "時間スケジュール、私は「えー、えー、私は"}, {"type": "subtitle", "time": 4048.19, "timestamp": "01:07:28", "text": "彼女にBSTタイムゾーンを送るのではなく"}, {"type": "subtitle", "time": 4052.789, "timestamp": "01:07:32", "text": "それで私は「え、何？いつ"}, {"type": "subtitle", "time": 4059.75, "timestamp": "01:07:39", "text": "あなたにそれを知ってもらう必要はありません。"}, {"type": "subtitle", "time": 4062.71, "timestamp": "01:07:42", "text": "まるで私が大騒ぎしたみたいに。"}, {"type": "chat", "time": 4064.268, "timestamp": "01:07:44", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "she's in Japan?"}, {"type": "subtitle", "time": 4065.109, "timestamp": "01:07:45", "text": "実家に戻るのも非常にストレスだった。私"}, {"type": "subtitle", "time": 4066.95, "timestamp": "01:07:46", "text": "たくさんのものを小包として渡さなければならなかった"}, {"type": "subtitle", "time": 4068.63, "timestamp": "01:07:48", "text": "たくさんのものを手放した。そして私は"}, {"type": "subtitle", "time": 4070.789, "timestamp": "01:07:50", "text": "時々好きになる人"}, {"type": "subtitle", "time": 4072.75, "timestamp": "01:07:52", "text": "周りの物についてどう思いますか"}, {"type": "subtitle", "time": 4075.75, "timestamp": "01:07:55", "text": "自分。だから、自分の持ち物をたくさん手放す"}, {"type": "subtitle", "time": 4077.91, "timestamp": "01:07:57", "text": "それは難しかった、なぜならそれはまた"}]
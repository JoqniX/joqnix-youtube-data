[{"type": "subtitle", "time": 9971.23, "timestamp": "02:46:11", "text": "ああ、なんて重いんだ"}, {"type": "subtitle", "time": 9974.63, "timestamp": "02:46:14", "text": "雨が降っている。中国人が"}, {"type": "subtitle", "time": 9978.15, "timestamp": "02:46:18", "text": "友人はあらゆることをするためにわざわざ"}, {"type": "subtitle", "time": 9982.55, "timestamp": "02:46:22", "text": "これは私にとって。本当に感謝しています"}, {"type": "subtitle", "time": 9984.11, "timestamp": "02:46:24", "text": "私が望むこと"}, {"type": "subtitle", "time": 9987.03, "timestamp": "02:46:27", "text": "泣く。えっと"}, {"type": "subtitle", "time": 9989.99, "timestamp": "02:46:29", "text": "しかし、今は複雑な事情がある。え、何？"}, {"type": "subtitle", "time": 9993.55, "timestamp": "02:46:33", "text": "スケジュールをどうしたらいいですか"}, {"type": "subtitle", "time": 9997.469, "timestamp": "02:46:37", "text": "PTの息子は作れませんでした"}, {"type": "subtitle", "time": 10000.15, "timestamp": "02:46:40", "text": "それ？ PTの曲は間に合わなかった"}, {"type": "subtitle", "time": 10002.19, "timestamp": "02:46:42", "text": "コラボレーション"}, {"type": "subtitle", "time": 10004.79, "timestamp": "02:46:44", "text": "今日。くたばれ、レイヴン・サン。中国人"}, {"type": "subtitle", "time": 10009.59, "timestamp": "02:46:49", "text": "友達はストリームできない"}, {"type": "subtitle", "time": 10011.59, "timestamp": "02:46:51", "text": "土曜日"}, {"type": "subtitle", "time": 10012.99, "timestamp": "02:46:52", "text": "えーと、午後2時"}, {"type": "subtitle", "time": 10017.15, "timestamp": "02:46:57", "text": "IST。だから、私はこう思う、"}, {"type": "subtitle", "time": 10019.99, "timestamp": "02:46:59", "text": "する？それで、私は「どうすればいいんだろう？」と考えていました。"}]
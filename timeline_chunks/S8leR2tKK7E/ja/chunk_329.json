[{"type": "subtitle", "time": 19743.51, "timestamp": "05:29:03", "text": "なぜなら、たとえ私がリソースに行って、ああ"}, {"type": "subtitle", "time": 19745.868, "timestamp": "05:29:05", "text": "待って、予約を忘れた。"}, {"type": "subtitle", "time": 19751.91, "timestamp": "05:29:11", "text": "ああ、パカパカパカパカパカパカ。あなた"}, {"type": "subtitle", "time": 19754.07, "timestamp": "05:29:14", "text": "ああ、なんてことだ。あなた"}, {"type": "subtitle", "time": 19756.59, "timestamp": "05:29:16", "text": "忘れて"}, {"type": "subtitle", "time": 19759.43, "timestamp": "05:29:19", "text": "もの。あなたは実際にあなたの"}, {"type": "subtitle", "time": 19763.868, "timestamp": "05:29:23", "text": "もの。何？いつでもまた来てください。"}, {"type": "subtitle", "time": 19767.868, "timestamp": "05:29:27", "text": "何？実は私は自分の"}, {"type": "subtitle", "time": 19779.15, "timestamp": "05:29:39", "text": "完全に忘れていました。ああ、"}, {"type": "subtitle", "time": 19793.628, "timestamp": "05:29:53", "text": "私のオープン"}]
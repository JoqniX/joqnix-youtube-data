[{"type": "subtitle", "time": 8820.71, "timestamp": "02:27:00", "text": "きっとそうなるよ。不安な気持ちは分かります"}, {"type": "subtitle", "time": 8823.349, "timestamp": "02:27:03", "text": "でも、うまくいくでしょう。"}, {"type": "subtitle", "time": 8830.469, "timestamp": "02:27:10", "text": "昨日、リガーの息子にDMを送りました。私"}, {"type": "subtitle", "time": 8834.75, "timestamp": "02:27:14", "text": "欲しいです、欲しいです、手に入れたいです"}, {"type": "subtitle", "time": 8837.99, "timestamp": "02:27:17", "text": "応答。今は聞かなくていいよ"}, {"type": "subtitle", "time": 8840.63, "timestamp": "02:27:20", "text": "知っているけど、私は、"}, {"type": "subtitle", "time": 8842.71, "timestamp": "02:27:22", "text": "学習システム。それが"}, {"type": "subtitle", "time": 8844.51, "timestamp": "02:27:24", "text": "良いことだ"}, {"type": "subtitle", "time": 8848.15, "timestamp": "02:27:28", "text": "その学習システム、つまり、あの、ほら。"}, {"type": "subtitle", "time": 8849.71, "timestamp": "02:27:29", "text": "えっと、あなた"}, {"type": "subtitle", "time": 8853.27, "timestamp": "02:27:33", "text": "人々にモデルを作ってもらう"}, {"type": "subtitle", "time": 8856.11, "timestamp": "02:27:36", "text": "契約条件のように"}, {"type": "subtitle", "time": 8860.23, "timestamp": "02:27:40", "text": "あなたが彼らに支払うのは時間とともに"}, {"type": "subtitle", "time": 8862.309, "timestamp": "02:27:42", "text": "そういう類のもので、まだデビューできる"}, {"type": "subtitle", "time": 8864.07, "timestamp": "02:27:44", "text": "それみたいなやつで。わからない"}, {"type": "subtitle", "time": 8865.67, "timestamp": "02:27:45", "text": "それは"}, {"type": "subtitle", "time": 8870.07, "timestamp": "02:27:50", "text": "ああ、EMI（分割払い）とかクレジットみたいな感じですね。 H"}, {"type": "subtitle", "time": 8872.59, "timestamp": "02:27:52", "text": "EMI（電子マネー機関）のようなものだ。"}, {"type": "subtitle", "time": 8875.59, "timestamp": "02:27:55", "text": "それは分割払いみたいなものですね。"}, {"type": "subtitle", "time": 8879.75, "timestamp": "02:27:59", "text": "いいえ。はい。同じものを非常に"}]
[{"type": "subtitle", "time": 2102.109, "timestamp": "00:35:02", "text": "でも、そう、"}, {"type": "subtitle", "time": 2105.19, "timestamp": "00:35:05", "text": "ええ、私が言いたかったことは"}, {"type": "subtitle", "time": 2107.67, "timestamp": "00:35:07", "text": "水曜日の配信時に参加します"}, {"type": "subtitle", "time": 2110.71, "timestamp": "00:35:10", "text": "私のExaconについて。ということで、私は"}, {"type": "subtitle", "time": 2112.95, "timestamp": "00:35:12", "text": "朝から真夜中まで"}, {"type": "subtitle", "time": 2115.39, "timestamp": "00:35:15", "text": "翌日は"}, {"type": "subtitle", "time": 2118.31, "timestamp": "00:35:18", "text": "24時間とかそんな感じ"}, {"type": "subtitle", "time": 2121.51, "timestamp": "00:35:21", "text": "えっと、ストリーム。わからない。私はそうするかもしれない"}, {"type": "subtitle", "time": 2123.829, "timestamp": "00:35:23", "text": "合間にゲームをする。私は働くかもしれない"}, {"type": "subtitle", "time": 2127.47, "timestamp": "00:35:27", "text": "間。知るか？そしてただ眠るだけ"}, {"type": "subtitle", "time": 2129.79, "timestamp": "00:35:29", "text": "オフにして"}, {"type": "subtitle", "time": 2133.79, "timestamp": "00:35:33", "text": "まあ、そういうことだ。私はしません"}, {"type": "subtitle", "time": 2138.39, "timestamp": "00:35:38", "text": "知る。また、YouTube 用 YouTube 用"}, {"type": "subtitle", "time": 2140.03, "timestamp": "00:35:40", "text": "YouTube"}, {"type": "subtitle", "time": 2143.109, "timestamp": "00:35:43", "text": "えっと、YouTubeにはまだアップロードしていません"}, {"type": "subtitle", "time": 2147.15, "timestamp": "00:35:47", "text": "ASMRストリームとコラボ"}, {"type": "subtitle", "time": 2150.23, "timestamp": "00:35:50", "text": "チャットにいるsoenzukiさん。"}, {"type": "subtitle", "time": 2151.99, "timestamp": "00:35:51", "text": "えっと"}, {"type": "subtitle", "time": 2159.39, "timestamp": "00:35:59", "text": "昨日？待って、"}]
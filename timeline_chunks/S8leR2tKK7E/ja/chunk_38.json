[{"type": "subtitle", "time": 2283.349, "timestamp": "00:38:03", "text": "今のところ、行き詰まりの状態です。ジョーは午前3時に"}, {"type": "subtitle", "time": 2286.43, "timestamp": "00:38:06", "text": "朝。 A"}, {"type": "subtitle", "time": 2308.71, "timestamp": "00:38:28", "text": "良い。他に何か？思うに"}, {"type": "subtitle", "time": 2312.55, "timestamp": "00:38:32", "text": "これ以上話すことは何もありません。"}, {"type": "subtitle", "time": 2314.79, "timestamp": "00:38:34", "text": "最近、なぜか記憶力が"}, {"type": "subtitle", "time": 2317.109, "timestamp": "00:38:37", "text": "最近、機嫌が悪い。書き留める必要がある"}, {"type": "subtitle", "time": 2320.31, "timestamp": "00:38:40", "text": "忘れ物があるから忘れ物がある"}, {"type": "subtitle", "time": 2323.27, "timestamp": "00:38:43", "text": "私が言いたかったこと、そして好きなこと"}, {"type": "subtitle", "time": 2326.71, "timestamp": "00:38:46", "text": "配信が終わったら、ああ、私は"}, {"type": "subtitle", "time": 2329.63, "timestamp": "00:38:49", "text": "言い忘れた"}, {"type": "subtitle", "time": 2332.79, "timestamp": "00:38:52", "text": "これ。言い忘れていましたが、"}]
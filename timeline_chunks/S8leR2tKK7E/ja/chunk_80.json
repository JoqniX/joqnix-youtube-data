[{"type": "subtitle", "time": 4802.55, "timestamp": "01:20:02", "text": "ああ、君はただ一つだけ必要なんだ"}, {"type": "subtitle", "time": 4803.99, "timestamp": "01:20:03", "text": "Amazonアカウントですよね？あなたはただ"}, {"type": "subtitle", "time": 4808.55, "timestamp": "01:20:08", "text": "Amazonの海外ストアへアクセスしてください。おお、"}, {"type": "subtitle", "time": 4811.83, "timestamp": "01:20:11", "text": "それが私がやったことです。わかった。わかった。私"}, {"type": "subtitle", "time": 4814.229, "timestamp": "01:20:14", "text": "Amazon JP版を作らなきゃいけないと思った"}, {"type": "subtitle", "time": 4816.709, "timestamp": "01:20:16", "text": "そして私はインド製のものを持っているので、"}, {"type": "subtitle", "time": 4820.63, "timestamp": "01:20:20", "text": "JPとか作らなきゃいけないと思ってた。"}, {"type": "subtitle", "time": 4822.31, "timestamp": "01:20:22", "text": "あなたはただ統合する必要があるだけです"}, {"type": "subtitle", "time": 4827.31, "timestamp": "01:20:27", "text": "Amazonの国際アカウントにアカウントを移行する。"}, {"type": "subtitle", "time": 4829.95, "timestamp": "01:20:29", "text": "ああ、いいね。"}, {"type": "subtitle", "time": 4832.79, "timestamp": "01:20:32", "text": "ニース。プライム会員費を払ってるから"}, {"type": "subtitle", "time": 4835.99, "timestamp": "01:20:35", "text": "Amazonプライムのゲームをしているので"}, {"type": "subtitle", "time": 4838.189, "timestamp": "01:20:38", "text": "私は最高のゲームにアクセスできます"}, {"type": "subtitle", "time": 4841.03, "timestamp": "01:20:41", "text": "そうすれば無料ゲームを入手できるし、"}, {"type": "subtitle", "time": 4844.63, "timestamp": "01:20:44", "text": "毎月無料で何かがもらえる。すばらしい。おお"}, {"type": "subtitle", "time": 4847.91, "timestamp": "01:20:47", "text": "ああ、それは本当に頭がいい。"}, {"type": "subtitle", "time": 4851.03, "timestamp": "01:20:51", "text": "うん、良いゲームもあるよ"}, {"type": "subtitle", "time": 4855.03, "timestamp": "01:20:55", "text": "Falloutとかみたいな無料ゲーム。"}, {"type": "subtitle", "time": 4857.51, "timestamp": "01:20:57", "text": "え、Falloutは無料だと思ってたんだけど、違ったの？"}]
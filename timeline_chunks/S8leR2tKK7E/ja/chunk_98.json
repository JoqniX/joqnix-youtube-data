[{"type": "subtitle", "time": 5883.709, "timestamp": "01:38:03", "text": "あなたが来たとき、出てきたとき、周りにいて"}, {"type": "subtitle", "time": 5887.91, "timestamp": "01:38:07", "text": "もの。そして時間が経つにつれて、"}, {"type": "subtitle", "time": 5891.35, "timestamp": "01:38:11", "text": "セレスティアと交流しました"}, {"type": "subtitle", "time": 5894.87, "timestamp": "01:38:14", "text": "サスカチュワン州の他の女の子たちの他の才能"}, {"type": "subtitle", "time": 5899.27, "timestamp": "01:38:19", "text": "そして私は理解し始めた"}, {"type": "subtitle", "time": 5902.109, "timestamp": "01:38:22", "text": "物事の現状とすべてがゆっくりと"}, {"type": "subtitle", "time": 5904.629, "timestamp": "01:38:24", "text": "ゆっくり。うん。うん。それから私はこれを始めました"}, {"type": "subtitle", "time": 5907.99, "timestamp": "01:38:27", "text": "そして私は似たような経験をした"}, {"type": "subtitle", "time": 5910.79, "timestamp": "01:38:30", "text": "私自身もそう思って、これは"}, {"type": "subtitle", "time": 5912.59, "timestamp": "01:38:32", "text": "これは何か"}, {"type": "subtitle", "time": 5915.669, "timestamp": "01:38:35", "text": "他の人たちが経験していたこと。ああ、"}, {"type": "subtitle", "time": 5916.83, "timestamp": "01:38:36", "text": "神"}, {"type": "subtitle", "time": 5921.75, "timestamp": "01:38:41", "text": "あなたはとても私は私は大きな呼吸です"}, {"type": "subtitle", "time": 5924.47, "timestamp": "01:38:44", "text": "あなたたちのような人たちへ"}, {"type": "subtitle", "time": 5928.629, "timestamp": "01:38:48", "text": "ベストを尽くし、ベストを尽くし、"}, {"type": "subtitle", "time": 5929.709, "timestamp": "01:38:49", "text": "それを保管する"}, {"type": "subtitle", "time": 5933.83, "timestamp": "01:38:53", "text": "上。ええ、それは素晴らしいですね。"}, {"type": "subtitle", "time": 5937.43, "timestamp": "01:38:57", "text": "でもコミュニティは"}, {"type": "subtitle", "time": 5939.99, "timestamp": "01:38:59", "text": "過去に劇的に変化した"}]
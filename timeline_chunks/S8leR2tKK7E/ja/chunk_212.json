[{"type": "subtitle", "time": 12730.83, "timestamp": "03:32:10", "text": "私はグループ活動があまり得意ではないと思います"}, {"type": "subtitle", "time": 12735.07, "timestamp": "03:32:15", "text": "この時点で設定します。私は感じる"}, {"type": "subtitle", "time": 12759.269, "timestamp": "03:32:39", "text": "神。気にしなくて済むならいいのに"}, {"type": "subtitle", "time": 12762.79, "timestamp": "03:32:42", "text": "他のことは何も考えずにただストリーミングして"}, {"type": "subtitle", "time": 12766.63, "timestamp": "03:32:46", "text": "すべて。しかし、私は"}, {"type": "subtitle", "time": 12770.269, "timestamp": "03:32:50", "text": "彼らが何を考えているかという観点から"}]
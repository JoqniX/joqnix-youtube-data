[{"type": "subtitle", "time": 8700.87, "timestamp": "02:25:00", "text": "私のチャンネルは近いうちに変更される予定です。そして私は"}, {"type": "subtitle", "time": 8704.03, "timestamp": "02:25:04", "text": "彼らに食べさせようとし続けた"}, {"type": "subtitle", "time": 8707.429, "timestamp": "02:25:07", "text": "人々。何てことだ。とてもクリエイティブに"}, {"type": "subtitle", "time": 8709.23, "timestamp": "02:25:09", "text": "賢いやり方だね"}, {"type": "subtitle", "time": 8713.03, "timestamp": "02:25:13", "text": "それ。一方、私はこの男と"}, {"type": "subtitle", "time": 8716.07, "timestamp": "02:25:16", "text": "1年以上経っても口を閉ざすことができない"}, {"type": "subtitle", "time": 8718.63, "timestamp": "02:25:18", "text": "シャット。"}, {"type": "subtitle", "time": 8722.469, "timestamp": "02:25:22", "text": "いいね。わからない。私は、ええと"}, {"type": "subtitle", "time": 8724.55, "timestamp": "02:25:24", "text": "ええ、私もそれについては不安を感じています。"}, {"type": "subtitle", "time": 8729.469, "timestamp": "02:25:29", "text": "もし小さなヘビか何かが"}, {"type": "subtitle", "time": 8732.95, "timestamp": "02:25:32", "text": "文字通り外側を舐めるか、ただ使うだけ"}, {"type": "subtitle", "time": 8735.67, "timestamp": "02:25:35", "text": "そのままですか？あるいは、そのままでは使えないのかもしれません。"}, {"type": "subtitle", "time": 8738.63, "timestamp": "02:25:38", "text": "いいえ、しかし私はそれを許しません。私は狩りをする"}, {"type": "subtitle", "time": 8741.23, "timestamp": "02:25:41", "text": "君は倒れた。心配しないで。抱きしめてあげる"}, {"type": "subtitle", "time": 8745.429, "timestamp": "02:25:45", "text": "誰かに盗まれたら、すぐに取り下げてください。まあ、そうですね。えっと"}, {"type": "subtitle", "time": 8748.389, "timestamp": "02:25:48", "text": "でも、ええ、心配だったんです"}, {"type": "subtitle", "time": 8753.67, "timestamp": "02:25:53", "text": "なぜなら、TwitterのイアンとYouTuber"}, {"type": "subtitle", "time": 8755.99, "timestamp": "02:25:55", "text": "Twitterの騒動とかそういうのが"}, {"type": "subtitle", "time": 8759.59, "timestamp": "02:25:59", "text": "コピーとか、その他諸々。私は私の"}]
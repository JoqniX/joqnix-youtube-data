[{"type": "subtitle", "time": 3722.309, "timestamp": "01:02:02", "text": "知っている。先輩、お元気ですか？調子はどうですか？"}, {"type": "subtitle", "time": 3733.27, "timestamp": "01:02:13", "text": "健康状態は、まあ、順調です。"}, {"type": "subtitle", "time": 3737.27, "timestamp": "01:02:17", "text": "そうそう。よく分かりました。うん。"}, {"type": "subtitle", "time": 3739.91, "timestamp": "01:02:19", "text": "でも、でも大丈夫。私は、私は、えっと、私は"}, {"type": "subtitle", "time": 3744.15, "timestamp": "01:02:24", "text": "ある意味、なんとか持ちこたえている。"}, {"type": "subtitle", "time": 3747.43, "timestamp": "01:02:27", "text": "先輩、本当に誇りに思います。あなた"}, {"type": "subtitle", "time": 3749.589, "timestamp": "01:02:29", "text": "毎日たくさんのことを経験する"}, {"type": "subtitle", "time": 3751.589, "timestamp": "01:02:31", "text": "そして、それでもなお、これほど多くのものを広めることができている。"}, {"type": "subtitle", "time": 3753.109, "timestamp": "01:02:33", "text": "他者へのポジティブさと幸福"}, {"type": "subtitle", "time": 3755.03, "timestamp": "01:02:35", "text": "人々。つまり、私はとてもたくさん持っているんです"}, {"type": "subtitle", "time": 3757.51, "timestamp": "01:02:37", "text": "あなたを尊敬します"}, {"type": "subtitle", "time": 3759.549, "timestamp": "01:02:39", "text": "のように"}, {"type": "subtitle", "time": 3764.47, "timestamp": "01:02:44", "text": "本当にそうですね、ええ、"}, {"type": "subtitle", "time": 3766.91, "timestamp": "01:02:46", "text": "その間に起こった多くのこと"}, {"type": "subtitle", "time": 3771.19, "timestamp": "01:02:51", "text": "ジョアソンと、えっと、私は"}, {"type": "subtitle", "time": 3775.03, "timestamp": "01:02:55", "text": "大変だった。ああ、かつては君のような人も"}, {"type": "subtitle", "time": 3777.109, "timestamp": "01:02:57", "text": "それを終わらせる、まるで睡眠のように"}, {"type": "subtitle", "time": 3779.589, "timestamp": "01:02:59", "text": "丸二日間。あなたはそれに値すると思います"}]
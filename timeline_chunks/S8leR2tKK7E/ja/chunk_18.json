[{"type": "subtitle", "time": 1081.029, "timestamp": "00:18:01", "text": "人々はそれを見るだろうか？人々は"}, {"type": "subtitle", "time": 1082.669, "timestamp": "00:18:02", "text": "時計"}, {"type": "subtitle", "time": 1099.87, "timestamp": "00:18:19", "text": "ええ、それが私が"}, {"type": "subtitle", "time": 1102.71, "timestamp": "00:18:22", "text": "考え。いつも通り、私もそこにいます。病気"}, {"type": "subtitle", "time": 1113.15, "timestamp": "00:18:33", "text": "ああ、ぜひ見てみたい。 A：オニキスです"}, {"type": "subtitle", "time": 1116.549, "timestamp": "00:18:36", "text": "チャン。オニキスちゃんです。待って、私は"}, {"type": "subtitle", "time": 1124.75, "timestamp": "00:18:44", "text": "頭のダジャレ"}, {"type": "subtitle", "time": 1135.27, "timestamp": "00:18:55", "text": "ショー。それで、お元気でしたか？希望"}]
[{"type": "subtitle", "time": 10207.79, "timestamp": "02:50:07", "text": "彼女もなぜ寝ていないのか"}, {"type": "subtitle", "time": 10212.11, "timestamp": "02:50:12", "text": "わかった。もう遅いんじゃないの？"}, {"type": "subtitle", "time": 10235.51, "timestamp": "02:50:35", "text": "シミュレーター。わかった。だから書き留めておかないといけない"}, {"type": "subtitle", "time": 10238.87, "timestamp": "02:50:38", "text": "いくつか。実際にはいくつかあります"}, {"type": "subtitle", "time": 10241.63, "timestamp": "02:50:41", "text": "協力パートナー"}, {"type": "subtitle", "time": 10245.469, "timestamp": "02:50:45", "text": "ええ、同意します"}, {"type": "subtitle", "time": 10248.469, "timestamp": "02:50:48", "text": "コラボレーション。ああ、私が言った人たちのこと覚えてる？"}, {"type": "subtitle", "time": 10251.99, "timestamp": "02:50:51", "text": "そうだよね、君の昔の友達は代理店に入ったんだ"}, {"type": "subtitle", "time": 10255.07, "timestamp": "02:50:55", "text": "そして大きくなり、"}, {"type": "subtitle", "time": 10258.55, "timestamp": "02:50:58", "text": "グループと一緒にグループにいるもの"}]
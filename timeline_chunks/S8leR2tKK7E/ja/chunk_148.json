[{"type": "subtitle", "time": 8881.429, "timestamp": "02:28:01", "text": "少額を支払い続け、"}, {"type": "subtitle", "time": 8883.91, "timestamp": "02:28:03", "text": "分割払いで。ああ、それはああ、それは"}, {"type": "subtitle", "time": 8887.07, "timestamp": "02:28:07", "text": "あ、あ、待って。それは"}, {"type": "subtitle", "time": 8890.15, "timestamp": "02:28:10", "text": "全体のリグを完成させた後、"}, {"type": "subtitle", "time": 8892.429, "timestamp": "02:28:12", "text": "以前と同じように"}, {"type": "subtitle", "time": 8896.71, "timestamp": "02:28:16", "text": "使い始めてから。ああ、なるほど"}, {"type": "subtitle", "time": 8897.71, "timestamp": "02:28:17", "text": "それ。"}, {"type": "subtitle", "time": 8900.55, "timestamp": "02:28:20", "text": "ああ、そういえば、彼らに聞いてみようと思ったんだけど"}, {"type": "subtitle", "time": 8903.429, "timestamp": "02:28:23", "text": "それを持っていて、それが可能であれば"}, {"type": "subtitle", "time": 8907.03, "timestamp": "02:28:27", "text": "そして、今は彼らのために、彼らのために私は"}, {"type": "subtitle", "time": 8909.79, "timestamp": "02:28:29", "text": "まるで全くの他人が望んでいるかのように"}, {"type": "subtitle", "time": 8912.95, "timestamp": "02:28:32", "text": "全身全霊を注ぎ込み、"}, {"type": "subtitle", "time": 8916.55, "timestamp": "02:28:36", "text": "二人とも信頼していて、もし私が"}, {"type": "subtitle", "time": 8918.87, "timestamp": "02:28:38", "text": "以前にも複数回彼らと仕事をしたことがある"}, {"type": "subtitle", "time": 8921.59, "timestamp": "02:28:41", "text": "その時は、彼らにとって簡単に"}, {"type": "subtitle", "time": 8924.469, "timestamp": "02:28:44", "text": "ああ、この人知ってるよ"}, {"type": "subtitle", "time": 8927.19, "timestamp": "02:28:47", "text": "私を裏切ったり、騙したりしない"}, {"type": "subtitle", "time": 8930.309, "timestamp": "02:28:50", "text": "彼は信頼できる人物だ。はい。真実。また、"}, {"type": "subtitle", "time": 8932.59, "timestamp": "02:28:52", "text": "誰かが"}, {"type": "subtitle", "time": 8935.67, "timestamp": "02:28:55", "text": "保証のようなものになる"}, {"type": "subtitle", "time": 8937.27, "timestamp": "02:28:57", "text": "「ねえ、この人は私の友達だよ。私は"}]
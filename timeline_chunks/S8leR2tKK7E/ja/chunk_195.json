[{"type": "subtitle", "time": 11708.229, "timestamp": "03:15:08", "text": "えっと、彼女の仕事が終わったら、"}, {"type": "subtitle", "time": 11710.389, "timestamp": "03:15:10", "text": "私に尋ねたようなことを尋ねたようなことを尋ねたような"}, {"type": "chat", "time": 11712.185, "timestamp": "03:15:12", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "thats unfortunate"}, {"type": "subtitle", "time": 11713.03, "timestamp": "03:15:13", "text": "彼女は私の持ち物について尋ねるべきだ"}, {"type": "subtitle", "time": 11716.55, "timestamp": "03:15:16", "text": "彼らは外国人を受け入れ、"}, {"type": "subtitle", "time": 11718.469, "timestamp": "03:15:18", "text": "ホワイトリストなどを提供する。そして彼女はそうした"}, {"type": "subtitle", "time": 11721.429, "timestamp": "03:15:21", "text": "それと、代理店の人たちはあなたみたいな人たちです"}, {"type": "subtitle", "time": 11723.99, "timestamp": "03:15:23", "text": "会社が必要な人は、あなたのような人たちです"}, {"type": "subtitle", "time": 11726.389, "timestamp": "03:15:26", "text": "中国人の代表者が必要だ"}, {"type": "subtitle", "time": 11728.79, "timestamp": "03:15:28", "text": "他にもいろいろあって、もっと動画を作る必要がある"}, {"type": "subtitle", "time": 11730.469, "timestamp": "03:15:30", "text": "コンテンツとか色々。もっと手に入れる必要がある"}, {"type": "subtitle", "time": 11733.11, "timestamp": "03:15:33", "text": "もっと自分の名前を広めたり、そういうことをするべきだ。"}, {"type": "subtitle", "time": 11735.349, "timestamp": "03:15:35", "text": "再生回数が少なかったりしてますね。短い"}, {"type": "subtitle", "time": 11737.349, "timestamp": "03:15:37", "text": "Billybillyアカウントのフォームコンテンツ"}, {"type": "subtitle", "time": 11741.11, "timestamp": "03:15:41", "text": "役に立たない。非アクティブなアップロードと見なされます"}, {"type": "subtitle", "time": 11747.309, "timestamp": "03:15:47", "text": "えーと、非アクティブ、アップロードか何か。そして"}]
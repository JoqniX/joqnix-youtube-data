[{"type": "subtitle", "time": 10144.389, "timestamp": "02:49:04", "text": "ホワイトリストなどを使って私と話す。しかし"}, {"type": "subtitle", "time": 10149.59, "timestamp": "02:49:09", "text": "問題は彼女の応答時間です"}, {"type": "subtitle", "time": 10152.59, "timestamp": "02:49:12", "text": "忙しいなど"}, {"type": "subtitle", "time": 10154.67, "timestamp": "02:49:14", "text": "それから他の"}, {"type": "subtitle", "time": 10157.87, "timestamp": "02:49:17", "text": "選択肢は"}, {"type": "subtitle", "time": 10163.07, "timestamp": "02:49:23", "text": "普通の普通の友達は誰ができるのか"}, {"type": "subtitle", "time": 10167.83, "timestamp": "02:49:27", "text": "ボランティアで手伝ってくれる人はいますか？"}, {"type": "subtitle", "time": 10181.87, "timestamp": "02:49:41", "text": "代表。しかし、彼女はまた"}, {"type": "subtitle", "time": 10188.349, "timestamp": "02:49:48", "text": "でも、彼女はもっと活動的だ"}, {"type": "subtitle", "time": 10190.1, "timestamp": "02:49:50", "text": "信じる"}, {"type": "subtitle", "time": 10191.95, "timestamp": "02:49:51", "text": "[音楽]"}, {"type": "subtitle", "time": 10193.79, "timestamp": "02:49:53", "text": "ク"}, {"type": "subtitle", "time": 10197.79, "timestamp": "02:49:57", "text": "顔だが確認が必要"}]
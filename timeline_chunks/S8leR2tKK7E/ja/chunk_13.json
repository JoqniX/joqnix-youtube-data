[{"type": "subtitle", "time": 782.389, "timestamp": "00:13:02", "text": "そういうことが起こったので、私は"}, {"type": "subtitle", "time": 783.47, "timestamp": "00:13:03", "text": "私の"}, {"type": "subtitle", "time": 787.19, "timestamp": "00:13:07", "text": "名前も知らなかったし、Twitchには"}, {"type": "subtitle", "time": 791.03, "timestamp": "00:13:11", "text": "6秒待たなければならないというポリシールール"}, {"type": "subtitle", "time": 793.59, "timestamp": "00:13:13", "text": "数ヶ月で以前のユーザー名を取り戻す"}, {"type": "subtitle", "time": 795.31, "timestamp": "00:13:15", "text": "前に。"}, {"type": "subtitle", "time": 800.71, "timestamp": "00:13:20", "text": "そして、あなたが"}, {"type": "subtitle", "time": 802.829, "timestamp": "00:13:22", "text": "名前を変えなければならない"}, {"type": "subtitle", "time": 807.19, "timestamp": "00:13:27", "text": "2ヶ月待って、また変更します。私は言った"}, {"type": "subtitle", "time": 809.43, "timestamp": "00:13:29", "text": "確かその話は何度も聞いたと思う"}, {"type": "subtitle", "time": 812.629, "timestamp": "00:13:32", "text": "右。新しい人向けだと分かっています"}, {"type": "subtitle", "time": 816.069, "timestamp": "00:13:36", "text": "新しい家族、新しい家族のメンバー"}, {"type": "subtitle", "time": 819.59, "timestamp": "00:13:39", "text": "いつ知ったかはわからないけど、君たちは知っていると思う。"}, {"type": "subtitle", "time": 824.43, "timestamp": "00:13:44", "text": "古い 古い 既存の 現在"}, {"type": "subtitle", "time": 829.87, "timestamp": "00:13:49", "text": "えーっと、6歳から1歳の家族バカはいいえ"}, {"type": "subtitle", "time": 833.829, "timestamp": "00:13:53", "text": "そう、それで、その出来事の後、私は"}, {"type": "subtitle", "time": 837.389, "timestamp": "00:13:57", "text": "待たなければならなかった"}]
[{"type": "subtitle", "time": 4980.35, "timestamp": "01:23:00", "text": "選べばいいのかどうかわからない"}, {"type": "subtitle", "time": 4985.03, "timestamp": "01:23:05", "text": "1つ。これはあまりにも不公平だ。"}, {"type": "subtitle", "time": 4987.11, "timestamp": "01:23:07", "text": "あなたはこれらが得意なトップ3です"}, {"type": "subtitle", "time": 4995.669, "timestamp": "01:23:15", "text": "場合によります。"}, {"type": "subtitle", "time": 4998.39, "timestamp": "01:23:18", "text": "私は議論が得意だと感じますか？"}, {"type": "subtitle", "time": 5000.83, "timestamp": "01:23:20", "text": "なぜなら私はそうは思わないから"}, {"type": "subtitle", "time": 5004.07, "timestamp": "01:23:24", "text": "それで。いいえ。私はあなたが"}, {"type": "subtitle", "time": 5006.47, "timestamp": "01:23:26", "text": "論理的思考が得意で、"}, {"type": "subtitle", "time": 5009.79, "timestamp": "01:23:29", "text": "そう思う。もっとよく"}, {"type": "subtitle", "time": 5014.43, "timestamp": "01:23:34", "text": "より良い。それで、私が見たゲームがあるんです"}, {"type": "subtitle", "time": 5017.99, "timestamp": "01:23:37", "text": "昨日、えっと、Bow the Veil だったよね？"}, {"type": "subtitle", "time": 5020.709, "timestamp": "01:23:40", "text": "彼女のこと、知ってるよね？うんうん。ベール"}, {"type": "subtitle", "time": 5025.189, "timestamp": "01:23:45", "text": "女の子。ええと、彼女がこれを演奏しているのを見ました。それは、"}, {"type": "subtitle", "time": 5026.91, "timestamp": "01:23:46", "text": "ゲーム"}, {"type": "subtitle", "time": 5032.59, "timestamp": "01:23:52", "text": "「待って、私が取ってきます」と言われた。どうすれば"}, {"type": "subtitle", "time": 5035.43, "timestamp": "01:23:55", "text": "えっと、どうやって見るんですか？はい、それは"}, {"type": "subtitle", "time": 5037.31, "timestamp": "01:23:57", "text": "有罪"}, {"type": "subtitle", "time": 5039.91, "timestamp": "01:23:59", "text": "靴下。完全に有罪。私は"}]
[{"type": "subtitle", "time": 841.23, "timestamp": "00:14:01", "text": "えっと、3月、あ、待って"}, {"type": "subtitle", "time": 845.55, "timestamp": "00:14:05", "text": "今年の5月か3月か"}, {"type": "subtitle", "time": 849.269, "timestamp": "00:14:09", "text": "今年の5月か3月頃"}, {"type": "subtitle", "time": 852.71, "timestamp": "00:14:12", "text": "そして私は「ああ神様、私の名前が"}, {"type": "subtitle", "time": 856.15, "timestamp": "00:14:16", "text": "「戻ってきた」私はジョックニックスが本当に嫌いだった"}, {"type": "subtitle", "time": 860.47, "timestamp": "00:14:20", "text": "そして私の名前に下線を引いてください。だから私は待った"}, {"type": "subtitle", "time": 862.43, "timestamp": "00:14:22", "text": "待って待って"}, {"type": "subtitle", "time": 866.31, "timestamp": "00:14:26", "text": "そしてついに私は"}, {"type": "subtitle", "time": 870.069, "timestamp": "00:14:30", "text": "最初と最初のユーザー名の名前"}, {"type": "subtitle", "time": 872.189, "timestamp": "00:14:32", "text": "私は"}, {"type": "subtitle", "time": 875.829, "timestamp": "00:14:35", "text": "えっと、最初のいいねのためにTwitch"}, {"type": "subtitle", "time": 878.389, "timestamp": "00:14:38", "text": "次に、ジョーに似た名前が最初に出てきた。または"}, {"type": "subtitle", "time": 882.87, "timestamp": "00:14:42", "text": "Q&A X。ええ、2月に手に入れました。待って、"}, {"type": "subtitle", "time": 885.35, "timestamp": "00:14:45", "text": "2月だったかな？ 3月か"}, {"type": "subtitle", "time": 886.87, "timestamp": "00:14:46", "text": "何か。 3月か5月頃だったかな。"}, {"type": "subtitle", "time": 890.269, "timestamp": "00:14:50", "text": "ええ、その後、もしそれが4つくらいだったら"}, {"type": "subtitle", "time": 893.11, "timestamp": "00:14:53", "text": "もしくは、私にはどうすることもできません。"}]
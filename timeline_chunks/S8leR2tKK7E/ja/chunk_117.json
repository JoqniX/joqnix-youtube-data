[{"type": "subtitle", "time": 7020.149, "timestamp": "01:57:00", "text": "少なくとも段落全体を入力できる"}, {"type": "subtitle", "time": 7022.709, "timestamp": "01:57:02", "text": "1つの出来事の概要"}, {"type": "subtitle", "time": 7025.75, "timestamp": "01:57:05", "text": "その日と、コラボレーションがどのように進んだか。私は"}, {"type": "subtitle", "time": 7028.07, "timestamp": "01:57:08", "text": "それで満足です。"}, {"type": "subtitle", "time": 7030.31, "timestamp": "01:57:10", "text": "公平。"}, {"type": "subtitle", "time": 7033.91, "timestamp": "01:57:13", "text": "以前はウェブサイトでそれをやっていました"}, {"type": "subtitle", "time": 7037.109, "timestamp": "01:57:17", "text": "ええ、それは似たようなものになるでしょう"}, {"type": "subtitle", "time": 7041.51, "timestamp": "01:57:21", "text": "スターのウェブサイトのような、"}, {"type": "subtitle", "time": 7044.149, "timestamp": "01:57:24", "text": "たくさんの商品があるお店、"}, {"type": "subtitle", "time": 7046.79, "timestamp": "01:57:26", "text": "右？メニュー内の商品または"}, {"type": "subtitle", "time": 7048.709, "timestamp": "01:57:28", "text": "そんな感じ。私は"}, {"type": "subtitle", "time": 7051.75, "timestamp": "01:57:31", "text": "それを流れとして。クリックするすべてのストリーム"}, {"type": "subtitle", "time": 7054.709, "timestamp": "01:57:34", "text": "サムネイルでは、"}, {"type": "subtitle", "time": 7056.629, "timestamp": "01:57:36", "text": "ページには概要と"}, {"type": "subtitle", "time": 7058.27, "timestamp": "01:57:38", "text": "タイムスタンプと"}, {"type": "subtitle", "time": 7060.79, "timestamp": "01:57:40", "text": "すべて。それはやりすぎだった。そして私は"}, {"type": "subtitle", "time": 7063.669, "timestamp": "01:57:43", "text": "そう、もうそれはやらないよ。"}, {"type": "subtitle", "time": 7065.669, "timestamp": "01:57:45", "text": "うん、でも本当にやることがたくさんあるんだよね。"}, {"type": "subtitle", "time": 7067.43, "timestamp": "01:57:47", "text": "あなたは既に多くのことを成し遂げています"}, {"type": "subtitle", "time": 7070.709, "timestamp": "01:57:50", "text": "現実のコミュニティで、そして"}, {"type": "subtitle", "time": 7071.55, "timestamp": "01:57:51", "text": "公共"}, {"type": "subtitle", "time": 7075.109, "timestamp": "01:57:55", "text": "ペルソナ管理ウェブサイトに加えて"}, {"type": "subtitle", "time": 7077.91, "timestamp": "01:57:57", "text": "助けなしでは狂った先輩のようです"}]
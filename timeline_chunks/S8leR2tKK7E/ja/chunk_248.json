[{"type": "subtitle", "time": 14910.11, "timestamp": "04:08:30", "text": "えっと、"}, {"type": "subtitle", "time": 14916.79, "timestamp": "04:08:36", "text": "あなたがもしあなたがもしあなたが"}, {"type": "subtitle", "time": 14918.75, "timestamp": "04:08:38", "text": "えっと、もしあなたが"}, {"type": "subtitle", "time": 14927.91, "timestamp": "04:08:47", "text": "ああ、新しい人を無理強いするべきじゃない"}, {"type": "subtitle", "time": 14930.229, "timestamp": "04:08:50", "text": "私とコラボレーションすることに賛成。私はただ"}, {"type": "subtitle", "time": 14932.51, "timestamp": "04:08:52", "text": "拭く"}, {"type": "subtitle", "time": 14938.02, "timestamp": "04:08:58", "text": "えーと"}, {"type": "subtitle", "time": 14939.79, "timestamp": "04:08:59", "text": "[音楽]"}]
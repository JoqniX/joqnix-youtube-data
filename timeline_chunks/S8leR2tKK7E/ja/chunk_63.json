[{"type": "subtitle", "time": 3783.549, "timestamp": "01:03:03", "text": "大きな休憩とたくさんの"}, {"type": "subtitle", "time": 3792.069, "timestamp": "01:03:12", "text": "ええ、そうです。はい。そして、私はまだ"}, {"type": "subtitle", "time": 3794.349, "timestamp": "01:03:14", "text": "いつ終了するかを決めた"}, {"type": "subtitle", "time": 3798.95, "timestamp": "01:03:18", "text": "喜び。たとえ私が、えっと、"}, {"type": "subtitle", "time": 3802.23, "timestamp": "01:03:22", "text": "最終日には21日くらい残しておいたけど"}, {"type": "subtitle", "time": 3805.63, "timestamp": "01:03:25", "text": "コラボコラボグッズ"}, {"type": "subtitle", "time": 3809.829, "timestamp": "01:03:29", "text": "えっと、つまり、梱包はそうはならないでしょう"}, {"type": "subtitle", "time": 3812.15, "timestamp": "01:03:32", "text": "そんなに時間をかける必要はないよ、ただ置くだけでいいんだ"}, {"type": "subtitle", "time": 3815.109, "timestamp": "01:03:35", "text": "最後の瞬間にマイクのように"}, {"type": "subtitle", "time": 3818.309, "timestamp": "01:03:38", "text": "他にもいろいろあると思う。わからない。だから私は"}, {"type": "subtitle", "time": 3821.19, "timestamp": "01:03:41", "text": "まるで終わりがないと想像するような"}, {"type": "subtitle", "time": 3822.87, "timestamp": "01:03:42", "text": "チョコレート。残りの部分もずっと続く"}, {"type": "subtitle", "time": 3825.43, "timestamp": "01:03:45", "text": "今年の。"}, {"type": "subtitle", "time": 3829.109, "timestamp": "01:03:49", "text": "私もそうできたらいいのに。"}, {"type": "subtitle", "time": 3835.91, "timestamp": "01:03:55", "text": "楽しい。それはある意味、楽しいだろうね。私は推測する"}, {"type": "chat", "time": 3838.853, "timestamp": "01:03:58", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "meow"}, {"type": "subtitle", "time": 3838.87, "timestamp": "01:03:58", "text": "こう考えれば、私もそうできるかもしれない"}]
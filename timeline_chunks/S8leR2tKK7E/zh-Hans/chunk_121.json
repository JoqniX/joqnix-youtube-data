[{"type": "subtitle", "time": 7260.87, "timestamp": "02:01:00", "text": "休息。你不必观看流媒体。你"}, {"type": "subtitle", "time": 7262.31, "timestamp": "02:01:02", "text": "你不必喜欢这样，你知道的。"}, {"type": "subtitle", "time": 7264.629, "timestamp": "02:01:04", "text": "公众形象，然后再回来"}, {"type": "subtitle", "time": 7267.669, "timestamp": "02:01:07", "text": "你感觉好多了。说实话"}, {"type": "subtitle", "time": 7270.55, "timestamp": "02:01:10", "text": "这会造成很大的不同，因为……"}, {"type": "subtitle", "time": 7272.87, "timestamp": "02:01:12", "text": "这是我个人很喜欢的东西。"}, {"type": "subtitle", "time": 7274.87, "timestamp": "02:01:14", "text": "我也经历过。就像我喜欢"}, {"type": "subtitle", "time": 7276.79, "timestamp": "02:01:16", "text": "试着强迫自己去看直播"}, {"type": "subtitle", "time": 7278.87, "timestamp": "02:01:18", "text": "当我精神状态不佳时，或者"}, {"type": "subtitle", "time": 7281.109, "timestamp": "02:01:21", "text": "身体状况良好，溪流也会畅通无阻。"}, {"type": "subtitle", "time": 7282.87, "timestamp": "02:01:22", "text": "也可能令人不快，我的心情也会受到影响。"}, {"type": "subtitle", "time": 7285.35, "timestamp": "02:01:25", "text": "溪流也会令人不快，而且"}, {"type": "subtitle", "time": 7287.669, "timestamp": "02:01:27", "text": "也曾有过这样的时刻：你"}, {"type": "subtitle", "time": 7289.51, "timestamp": "02:01:29", "text": "认识某些人，就像你认识某些人一样。"}, {"type": "subtitle", "time": 7291.35, "timestamp": "02:01:31", "text": "社区或社区本身有"}, {"type": "subtitle", "time": 7293.91, "timestamp": "02:01:33", "text": "对我的态度非常消极，而且"}, {"type": "subtitle", "time": 7296.83, "timestamp": "02:01:36", "text": "这也想让我辞职。"}, {"type": "subtitle", "time": 7300.149, "timestamp": "02:01:40", "text": "但归根结底，感觉有很多东西需要处理。"}, {"type": "subtitle", "time": 7303.27, "timestamp": "02:01:43", "text": "不仅仅局限于互联网和流媒体。"}, {"type": "subtitle", "time": 7305.83, "timestamp": "02:01:45", "text": "生活如此丰富多彩，甚至包括……"}, {"type": "subtitle", "time": 7308.629, "timestamp": "02:01:48", "text": "难道要超越这一切，超越人们吗？"}, {"type": "subtitle", "time": 7311.91, "timestamp": "02:01:51", "text": "他们会完全沉浸其中，就像他们自己一样。"}, {"type": "subtitle", "time": 7315.109, "timestamp": "02:01:55", "text": "自我以及在互联网上做自己"}, {"type": "subtitle", "time": 7316.709, "timestamp": "02:01:56", "text": "它们不能像……那样发挥作用"}, {"type": "subtitle", "time": 7319.149, "timestamp": "02:01:59", "text": "社会中的普通人"}]
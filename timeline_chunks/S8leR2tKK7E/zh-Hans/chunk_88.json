[{"type": "subtitle", "time": 5280.79, "timestamp": "01:28:00", "text": "体验新鲜事物。嗯。"}, {"type": "subtitle", "time": 5282.629, "timestamp": "01:28:02", "text": "因为那有点像我"}, {"type": "subtitle", "time": 5284.79, "timestamp": "01:28:04", "text": "作为一名 YouTuber 我做不到，但我认为"}, {"type": "subtitle", "time": 5287.83, "timestamp": "01:28:07", "text": "就像你会喜欢这样的好东西一样"}, {"type": "subtitle", "time": 5289.43, "timestamp": "01:28:09", "text": "比如，你的存在感和影响力是什么？"}, {"type": "subtitle", "time": 5293.07, "timestamp": "01:28:13", "text": "就那样吗？"}, {"type": "subtitle", "time": 5295.47, "timestamp": "01:28:15", "text": "嗯。坚持，稍等。等待。"}, {"type": "subtitle", "time": 5300.47, "timestamp": "01:28:20", "text": "呃，你会把手藏起来吗？"}, {"type": "subtitle", "time": 5303.189, "timestamp": "01:28:23", "text": "嗯，是的，我愿意。每当我这样做的时候"}, {"type": "subtitle", "time": 5305.03, "timestamp": "01:28:25", "text": "我觉得我好像做过类似手铐的事"}, {"type": "subtitle", "time": 5309.51, "timestamp": "01:28:29", "text": "三四次之后，我都把它藏了起来。我"}, {"type": "subtitle", "time": 5311.27, "timestamp": "01:28:31", "text": "穿什么衣服？"}, {"type": "subtitle", "time": 5313.75, "timestamp": "01:28:33", "text": "无指手套，然后就像手术手套一样"}, {"type": "subtitle", "time": 5316.87, "timestamp": "01:28:36", "text": "手套和其他所有东西"}, {"type": "subtitle", "time": 5319.83, "timestamp": "01:28:39", "text": "因为人们期望的就是这样。"}, {"type": "subtitle", "time": 5323.709, "timestamp": "01:28:43", "text": "我。而且我当时也觉得，真的"}, {"type": "subtitle", "time": 5327.11, "timestamp": "01:28:47", "text": "那时候我很害怕，就像我喜欢你的时候一样。"}, {"type": "subtitle", "time": 5328.95, "timestamp": "01:28:48", "text": "我知道我开始做手部摄像头直播了"}, {"type": "subtitle", "time": 5331.99, "timestamp": "01:28:51", "text": "当时我既紧张又害怕。我当时"}, {"type": "subtitle", "time": 5334.229, "timestamp": "01:28:54", "text": "究竟什么是最小的？"}, {"type": "subtitle", "time": 5336.55, "timestamp": "01:28:56", "text": "我获得码头的可能性就像"}, {"type": "subtitle", "time": 5339.35, "timestamp": "01:28:59", "text": "对我来说简直太可怕了。"}]
[{"type": "subtitle", "time": 8764.389, "timestamp": "02:26:04", "text": "担心的是，如果这种模式需要很长时间才能建立起来。"}, {"type": "subtitle", "time": 8767.99, "timestamp": "02:26:07", "text": "以便发布。如果有人"}, {"type": "subtitle", "time": 8770.79, "timestamp": "02:26:10", "text": "我之前也有过类似的想法"}, {"type": "subtitle", "time": 8772.87, "timestamp": "02:26:12", "text": "一些事情，当我之后首次亮相时，所以"}, {"type": "subtitle", "time": 8775.11, "timestamp": "02:26:15", "text": "时间长了，他们会说，“哦，这家伙是"}, {"type": "subtitle", "time": 8778.389, "timestamp": "02:26:18", "text": "就这样模仿这个虚拟主播。” 我会"}, {"type": "subtitle", "time": 8781.19, "timestamp": "02:26:21", "text": "感觉心都碎了。"}, {"type": "subtitle", "time": 8783.51, "timestamp": "02:26:23", "text": "我认为只要它不是……就行了。"}, {"type": "subtitle", "time": 8785.11, "timestamp": "02:26:25", "text": "这是故意的，你不用担心。"}, {"type": "subtitle", "time": 8787.27, "timestamp": "02:26:27", "text": "归根结底，因为有"}, {"type": "subtitle", "time": 8789.75, "timestamp": "02:26:29", "text": "设计和创新方式只有这么多。"}, {"type": "subtitle", "time": 8791.349, "timestamp": "02:26:31", "text": "你能想到的关于……"}, {"type": "subtitle", "time": 8793.79, "timestamp": "02:26:33", "text": "像人形生物"}, {"type": "subtitle", "time": 8797.11, "timestamp": "02:26:37", "text": "YouTube 用户。过了一段时间，就像这样的想法。"}, {"type": "subtitle", "time": 8799.389, "timestamp": "02:26:39", "text": "确实经常重复出现，而且是"}, {"type": "subtitle", "time": 8801.99, "timestamp": "02:26:41", "text": "不可避免的。只要它不像"}, {"type": "subtitle", "time": 8804.95, "timestamp": "02:26:44", "text": "故意或公然抄袭任何人"}, {"type": "subtitle", "time": 8806.95, "timestamp": "02:26:46", "text": "或者像无意中做的那样"}, {"type": "subtitle", "time": 8808.55, "timestamp": "02:26:48", "text": "就像你知道的，抄袭别人，我不会。"}, {"type": "subtitle", "time": 8810.85, "timestamp": "02:26:50", "text": "我认为这应该很重要。"}, {"type": "subtitle", "time": 8812.27, "timestamp": "02:26:52", "text": "[音乐]"}, {"type": "subtitle", "time": 8814.67, "timestamp": "02:26:54", "text": "是的。所以，"}, {"type": "subtitle", "time": 8818.389, "timestamp": "02:26:58", "text": "但我希望一切顺利。嗯。"}]
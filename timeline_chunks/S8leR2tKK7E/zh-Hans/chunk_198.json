[{"type": "subtitle", "time": 11889.03, "timestamp": "03:18:09", "text": "我。任何与企业相关的事物都是不好的。那是我的"}, {"type": "subtitle", "time": 11890.55, "timestamp": "03:18:10", "text": "有时候有人管理是件好事。"}, {"type": "subtitle", "time": 11892.15, "timestamp": "03:18:12", "text": "在你专注于建造的同时，保管好你的东西。"}, {"type": "subtitle", "time": 11893.95, "timestamp": "03:18:13", "text": "事物。所以，你知道，你选择和"}, {"type": "subtitle", "time": 11896.389, "timestamp": "03:18:16", "text": "选择。但你认为我，但我没有"}, {"type": "subtitle", "time": 11898.389, "timestamp": "03:18:18", "text": "找人帮我处理事情和管理"}, {"type": "subtitle", "time": 11902.429, "timestamp": "03:18:22", "text": "我的东西。都是我自己做的。人们"}, {"type": "subtitle", "time": 11905.15, "timestamp": "03:18:25", "text": "忙碌的。尽管。全部"}, {"type": "subtitle", "time": 11908.15, "timestamp": "03:18:28", "text": "正确的。嗯"}, {"type": "subtitle", "time": 11926.83, "timestamp": "03:18:46", "text": "[音乐]"}]
[{"type": "subtitle", "time": 19440.19, "timestamp": "05:24:00", "text": "家园。扫描此文件"}, {"type": "subtitle", "time": 19443.75, "timestamp": "05:24:03", "text": "飞机。水铅钨钛。哦，"}, {"type": "subtitle", "time": 19445.67, "timestamp": "05:24:05", "text": "这里有钛。好的，我会保留"}, {"type": "subtitle", "time": 19448.91, "timestamp": "05:24:08", "text": "记住这一点。"}, {"type": "subtitle", "time": 19453.91, "timestamp": "05:24:13", "text": "眨眼之地。我们走吧。所以，这里有一家商店。"}, {"type": "subtitle", "time": 19456.55, "timestamp": "05:24:16", "text": "在你着陆之前，前面有个商贩"}, {"type": "subtitle", "time": 19460.55, "timestamp": "05:24:20", "text": "中心。你坐在那里，然后，嗯，"}, {"type": "subtitle", "time": 19462.47, "timestamp": "05:24:22", "text": "把所有东西都买下来。购买您的"}, {"type": "subtitle", "time": 19464.788, "timestamp": "05:24:24", "text": "家园。唉，这地方一点都没变。"}, {"type": "subtitle", "time": 19467.99, "timestamp": "05:24:27", "text": "自21世纪以来，情况发生了很大变化。"}, {"type": "subtitle", "time": 19470.39, "timestamp": "05:24:30", "text": "欢迎来到新家园。请制作"}, {"type": "subtitle", "time": 19471.99, "timestamp": "05:24:31", "text": "前往尽头那栋建筑的路"}, {"type": "subtitle", "time": 19474.628, "timestamp": "05:24:34", "text": "沿着小路向下，就到了下面的殖民地。"}, {"type": "subtitle", "time": 19479.35, "timestamp": "05:24:39", "text": "好的，注意安全，祝您旅途愉快。"}, {"type": "subtitle", "time": 19481.27, "timestamp": "05:24:41", "text": "我们真的解锁了一个新任务"}, {"type": "subtitle", "time": 19487.59, "timestamp": "05:24:47", "text": "什么？你知道吗？我会把自己关起来"}, {"type": "subtitle", "time": 19496.35, "timestamp": "05:24:56", "text": "东西。哦，还有重力。"}]
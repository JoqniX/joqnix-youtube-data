[{"type": "subtitle", "time": 19981.11, "timestamp": "05:33:01", "text": "椅子？没有椅子。没有。祝您玩得愉快"}, {"type": "subtitle", "time": 19983.19, "timestamp": "05:33:03", "text": "请访问此处。等等，这边没有椅子。"}, {"type": "subtitle", "time": 19985.59, "timestamp": "05:33:05", "text": "这里。什么？你好呀。哦，你在这儿啊。"}, {"type": "subtitle", "time": 19987.67, "timestamp": "05:33:07", "text": "去。坐。"}]
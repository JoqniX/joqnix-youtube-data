[{"type": "subtitle", "time": 3180.49, "timestamp": "00:53:00", "text": "影响任何事，"}, {"type": "subtitle", "time": 3191.84, "timestamp": "00:53:11", "text": "但我没说要对你坦诚。"}, {"type": "subtitle", "time": 3193.71, "timestamp": "00:53:13", "text": "[音乐]"}, {"type": "subtitle", "time": 3196.47, "timestamp": "00:53:16", "text": "说实话，我不知道该怎么做"}, {"type": "subtitle", "time": 3202.01, "timestamp": "00:53:22", "text": "这。我不会和……说话"}, {"type": "subtitle", "time": 3203.71, "timestamp": "00:53:23", "text": "[音乐]"}, {"type": "subtitle", "time": 3213.109, "timestamp": "00:53:33", "text": "尽管。我知道我有点儿矫情。"}, {"type": "subtitle", "time": 3215.95, "timestamp": "00:53:35", "text": "这里，但仍然。但仍然"}, {"type": "subtitle", "time": 3219.069, "timestamp": "00:53:39", "text": "尽管。但是，即便如此。"}, {"type": "subtitle", "time": 3222.349, "timestamp": "00:53:42", "text": "嗯。我知道我正在做的这些努力是"}, {"type": "subtitle", "time": 3225.549, "timestamp": "00:53:45", "text": "不必要的"}, {"type": "subtitle", "time": 3228.309, "timestamp": "00:53:48", "text": "拉屎。如果我当初能把这些努力都投入进去就好了"}, {"type": "subtitle", "time": 3230.79, "timestamp": "00:53:50", "text": "制作。如果那是为……制造东西"}, {"type": "subtitle", "time": 3233.27, "timestamp": "00:53:53", "text": "如果用直播的话会更好。为什么"}, {"type": "subtitle", "time": 3236.109, "timestamp": "00:53:56", "text": "我该研磨吗？"}, {"type": "subtitle", "time": 3239.2, "timestamp": "00:53:59", "text": "啊，是的。我讨厌的迹象"}]
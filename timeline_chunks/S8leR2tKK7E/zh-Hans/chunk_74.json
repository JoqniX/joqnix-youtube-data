[{"type": "subtitle", "time": 4441.11, "timestamp": "01:14:01", "text": "啊，对对对，没错。是的。是的。"}, {"type": "subtitle", "time": 4447.75, "timestamp": "01:14:07", "text": "是的，那也是我需要做的事情。"}, {"type": "subtitle", "time": 4451.43, "timestamp": "01:14:11", "text": "不要强迫自己说“是”。不，不是"}, {"type": "subtitle", "time": 4454.07, "timestamp": "01:14:14", "text": "暂停任何事之后呃"}, {"type": "subtitle", "time": 4457.35, "timestamp": "01:14:17", "text": "面试等等。是的。我"}, {"type": "subtitle", "time": 4460.47, "timestamp": "01:14:20", "text": "担心我之后可能会那样做"}, {"type": "subtitle", "time": 4462.669, "timestamp": "01:14:22", "text": "新款车型首次亮相"}, {"type": "subtitle", "time": 4464.99, "timestamp": "01:14:24", "text": "东西。呃"}, {"type": "subtitle", "time": 4470.47, "timestamp": "01:14:30", "text": "我觉得这会非常糟糕。"}, {"type": "subtitle", "time": 4472.07, "timestamp": "01:14:32", "text": "我很期待。我太"}, {"type": "subtitle", "time": 4474.39, "timestamp": "01:14:34", "text": "前辈，我很期待。我希望它能成功"}, {"type": "subtitle", "time": 4477.189, "timestamp": "01:14:37", "text": "出色地。"}, {"type": "subtitle", "time": 4479.83, "timestamp": "01:14:39", "text": "我给你看过那个东西了吗？我忘了。我"}, {"type": "subtitle", "time": 4483.43, "timestamp": "01:14:43", "text": "已经忘了。我没想到你没有。"}, {"type": "subtitle", "time": 4487.03, "timestamp": "01:14:47", "text": "但没关系。我喜欢这个事实，因为"}, {"type": "subtitle", "time": 4489.75, "timestamp": "01:14:49", "text": "每一位来到这里来的客人，我"}, {"type": "subtitle", "time": 4491.75, "timestamp": "01:14:51", "text": "漫不经心地说：“哦，你看到我的……”"}, {"type": "subtitle", "time": 4494.07, "timestamp": "01:14:54", "text": "妈妈还在世吗？"}, {"type": "subtitle", "time": 4496.39, "timestamp": "01:14:56", "text": "不，那也太可爱了吧。就像，你"}, {"type": "subtitle", "time": 4498.149, "timestamp": "01:14:58", "text": "我知道，我看得出来你为此感到非常自豪。"}]
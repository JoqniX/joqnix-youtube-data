[{"type": "subtitle", "time": 4742.87, "timestamp": "01:19:02", "text": "我不得不习惯，并非所有事情都是如此。"}, {"type": "subtitle", "time": 4745.11, "timestamp": "01:19:05", "text": "所有浴室要么都带锁，要么都不带锁。"}, {"type": "subtitle", "time": 4746.35, "timestamp": "01:19:06", "text": "有天花板"}, {"type": "subtitle", "time": 4749.669, "timestamp": "01:19:09", "text": "风扇或者他们没有晾衣架"}, {"type": "subtitle", "time": 4753.189, "timestamp": "01:19:13", "text": "架子，一般来说，当然也包括不架子。"}, {"type": "subtitle", "time": 4755.91, "timestamp": "01:19:15", "text": "比如手持花洒或者喷水器之类的"}, {"type": "subtitle", "time": 4759.35, "timestamp": "01:19:19", "text": "在马桶附近喷洒。我的天啊。喜欢"}, {"type": "subtitle", "time": 4761.75, "timestamp": "01:19:21", "text": "这是我必须要适应的事情。但"}, {"type": "subtitle", "time": 4764.229, "timestamp": "01:19:24", "text": "然后我买了一个便携式喷射器"}, {"type": "subtitle", "time": 4773.43, "timestamp": "01:19:33", "text": "糟糕。是的，那也是我……"}, {"type": "subtitle", "time": 4775.189, "timestamp": "01:19:35", "text": "必须习惯。我的天哪，有……"}, {"type": "subtitle", "time": 4779.75, "timestamp": "01:19:39", "text": "太多事情了。我的天啊。"}, {"type": "subtitle", "time": 4781.75, "timestamp": "01:19:41", "text": "说实话，有很多类似的例子。"}, {"type": "subtitle", "time": 4784.229, "timestamp": "01:19:44", "text": "亚马逊上也有便携式喷射喷雾器出售。"}, {"type": "subtitle", "time": 4791.35, "timestamp": "01:19:51", "text": "其实没那么糟。"}, {"type": "subtitle", "time": 4793.47, "timestamp": "01:19:53", "text": "呃，你非得做……"}, {"type": "subtitle", "time": 4796.95, "timestamp": "01:19:56", "text": "Amazon.com 或 Amazon.com 英国或其他类似的网站"}, {"type": "subtitle", "time": 4799.91, "timestamp": "01:19:59", "text": "又是地区账户？"}]
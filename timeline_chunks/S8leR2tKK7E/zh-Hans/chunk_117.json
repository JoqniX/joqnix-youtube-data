[{"type": "subtitle", "time": 7020.149, "timestamp": "01:57:00", "text": "至少我可以打出整段文字。"}, {"type": "subtitle", "time": 7022.709, "timestamp": "01:57:02", "text": "事件概要"}, {"type": "subtitle", "time": 7025.75, "timestamp": "01:57:05", "text": "当天的工作情况以及合作进展如何。我是"}, {"type": "subtitle", "time": 7028.07, "timestamp": "01:57:08", "text": "对此我很满意。"}, {"type": "subtitle", "time": 7030.31, "timestamp": "01:57:10", "text": "公平的。"}, {"type": "subtitle", "time": 7033.91, "timestamp": "01:57:13", "text": "我以前都是在网站上做这件事的。"}, {"type": "subtitle", "time": 7037.109, "timestamp": "01:57:17", "text": "是的，那会和……类似"}, {"type": "subtitle", "time": 7041.51, "timestamp": "01:57:21", "text": "呃，就像明星网站，不是……"}, {"type": "subtitle", "time": 7044.149, "timestamp": "01:57:24", "text": "去一家商品种类繁多的商店，"}, {"type": "subtitle", "time": 7046.79, "timestamp": "01:57:26", "text": "正确的？菜单上的商品或"}, {"type": "subtitle", "time": 7048.709, "timestamp": "01:57:28", "text": "大概就是这样。我要"}, {"type": "subtitle", "time": 7051.75, "timestamp": "01:57:31", "text": "就像一条溪流。你点击的每个流"}, {"type": "subtitle", "time": 7054.709, "timestamp": "01:57:34", "text": "在缩略图上，你会看到一个"}, {"type": "subtitle", "time": 7056.629, "timestamp": "01:57:36", "text": "在该页面上，您可以看到摘要和"}, {"type": "subtitle", "time": 7058.27, "timestamp": "01:57:38", "text": "时间戳和"}, {"type": "subtitle", "time": 7060.79, "timestamp": "01:57:40", "text": "一切。那太过分了。而我当时"}, {"type": "subtitle", "time": 7063.669, "timestamp": "01:57:43", "text": "是的，我不再那样做了。"}, {"type": "subtitle", "time": 7065.669, "timestamp": "01:57:45", "text": "是啊，工作真的好多啊。"}, {"type": "subtitle", "time": 7067.43, "timestamp": "01:57:47", "text": "你已经做了很多事情了。"}, {"type": "subtitle", "time": 7070.709, "timestamp": "01:57:50", "text": "在现实生活中的社区里，以及作为一个"}, {"type": "subtitle", "time": 7071.55, "timestamp": "01:57:51", "text": "民众"}, {"type": "subtitle", "time": 7075.109, "timestamp": "01:57:55", "text": "以及个人管理网站"}, {"type": "subtitle", "time": 7077.91, "timestamp": "01:57:57", "text": "没有帮助就像疯了一样，前辈。"}]
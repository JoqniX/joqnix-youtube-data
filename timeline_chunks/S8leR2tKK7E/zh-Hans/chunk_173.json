[{"type": "subtitle", "time": 10388.03, "timestamp": "02:53:08", "text": "部分。哦，我的"}, {"type": "subtitle", "time": 10394.51, "timestamp": "02:53:14", "text": "为什么会这样呢？"}, {"type": "subtitle", "time": 10397.349, "timestamp": "02:53:17", "text": "爬行？为什么这么令人毛骨悚然？我的天啊，"}, {"type": "subtitle", "time": 10399.15, "timestamp": "02:53:19", "text": "太可怕了。"}, {"type": "subtitle", "time": 10403.19, "timestamp": "02:53:23", "text": "好的。我的天啊。好的。呃，不是那个。"}, {"type": "subtitle", "time": 10410.389, "timestamp": "02:53:30", "text": "会议。如何把它拉回来？如何放置"}, {"type": "subtitle", "time": 10411.71, "timestamp": "02:53:31", "text": "它"}, {"type": "subtitle", "time": 10415.79, "timestamp": "02:53:35", "text": "后退？我不明白。我该怎么说呢？"}, {"type": "subtitle", "time": 10417.309, "timestamp": "02:53:37", "text": "后退？"}, {"type": "subtitle", "time": 10421.03, "timestamp": "02:53:41", "text": "等待。我不明白。等待。所以"}, {"type": "subtitle", "time": 10423.63, "timestamp": "02:53:43", "text": "应该是这样。"}, {"type": "subtitle", "time": 10434.389, "timestamp": "02:53:54", "text": "物品。哦不，那太多了，因为我刚刚"}, {"type": "subtitle", "time": 10437.11, "timestamp": "02:53:57", "text": "看看她是否愿意做这些研究"}, {"type": "subtitle", "time": 10439.63, "timestamp": "02:53:59", "text": "考虑到她没有考虑的许多事情"}]
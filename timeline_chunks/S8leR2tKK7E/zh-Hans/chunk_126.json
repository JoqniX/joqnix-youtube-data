[{"type": "subtitle", "time": 7560.55, "timestamp": "02:06:00", "text": "只需要分清轻重缓急，比如什么是……"}, {"type": "subtitle", "time": 7561.91, "timestamp": "02:06:01", "text": "你当时想做什么？"}, {"type": "subtitle", "time": 7564.27, "timestamp": "02:06:04", "text": "此刻以及什么可能对……有益"}, {"type": "subtitle", "time": 7567.27, "timestamp": "02:06:07", "text": "你。所以我觉得这让我喜欢上了什么"}, {"type": "subtitle", "time": 7570.51, "timestamp": "02:06:10", "text": "我经常说后悔很多事。"}, {"type": "subtitle", "time": 7575.75, "timestamp": "02:06:15", "text": "少一些，也喜欢以这种方式让我……"}, {"type": "subtitle", "time": 7577.629, "timestamp": "02:06:17", "text": "不要为此感到难过"}, {"type": "subtitle", "time": 7580.39, "timestamp": "02:06:20", "text": "就像以天界使者的身份存在一样"}, {"type": "subtitle", "time": 7586.31, "timestamp": "02:06:26", "text": "因为归根结底，这就像人生一样。"}, {"type": "subtitle", "time": 7589.99, "timestamp": "02:06:29", "text": "这是我为自己做出的选择。是的。"}, {"type": "subtitle", "time": 7591.51, "timestamp": "02:06:31", "text": "其他人都无法做出这样的选择。"}, {"type": "subtitle", "time": 7593.47, "timestamp": "02:06:33", "text": "为了"}, {"type": "subtitle", "time": 7595.39, "timestamp": "02:06:35", "text": "我。"}, {"type": "subtitle", "time": 7605.03, "timestamp": "02:06:45", "text": "不，不，一切都很好。不用担心。"}, {"type": "subtitle", "time": 7608.229, "timestamp": "02:06:48", "text": "耶。听起来很有趣。就像一直以来"}, {"type": "subtitle", "time": 7610.47, "timestamp": "02:06:50", "text": "我的意思是，这是我第一次"}, {"type": "subtitle", "time": 7613.27, "timestamp": "02:06:53", "text": "坐下来和你聊聊。这是"}, {"type": "subtitle", "time": 7617.149, "timestamp": "02:06:57", "text": "乐趣。我应该更经常这样做。我 我"}]
[{"type": "subtitle", "time": 12483.389, "timestamp": "03:28:03", "text": "试图把我弄出去是有毒的"}, {"type": "subtitle", "time": 12488.63, "timestamp": "03:28:08", "text": "这。叫我走，叫我走"}, {"type": "subtitle", "time": 12491.15, "timestamp": "03:28:11", "text": "叫我回去"}, {"type": "subtitle", "time": 12496.429, "timestamp": "03:28:16", "text": "我来自的地方，"}, {"type": "subtitle", "time": 12498.68, "timestamp": "03:28:18", "text": "等等。我有点"}, {"type": "subtitle", "time": 12501.15, "timestamp": "03:28:21", "text": "[音乐]"}, {"type": "subtitle", "time": 12508.83, "timestamp": "03:28:28", "text": "我知道，但我会试试"}, {"type": "subtitle", "time": 12524.67, "timestamp": "03:28:44", "text": "抱歉"}]
[{"type": "subtitle", "time": 9901.429, "timestamp": "02:45:01", "text": "列表。这取决于你制作什么内容。"}, {"type": "subtitle", "time": 9915.469, "timestamp": "02:45:15", "text": "疯狂的。那是"}, {"type": "subtitle", "time": 9919.67, "timestamp": "02:45:19", "text": "疯狂的。我离目标很近了。我是一个行动的人"}, {"type": "subtitle", "time": 9921.15, "timestamp": "02:45:21", "text": "某公司"}, {"type": "subtitle", "time": 9924.63, "timestamp": "02:45:24", "text": "其实我并不介意和外国人交往"}, {"type": "subtitle", "time": 9927.83, "timestamp": "02:45:27", "text": "帮助外国人。"}, {"type": "subtitle", "time": 9930.389, "timestamp": "02:45:30", "text": "天知道这是否与合同有关。"}, {"type": "subtitle", "time": 9932.75, "timestamp": "02:45:32", "text": "但他们确实允许了"}, {"type": "subtitle", "time": 9934.71, "timestamp": "02:45:34", "text": "多流传输。我的天哪，他们真的这么做了。"}, {"type": "subtitle", "time": 9936.269, "timestamp": "02:45:36", "text": "允许"}]
[{"type": "subtitle", "time": 9781.23, "timestamp": "02:43:01", "text": "Le，你好吗？"}, {"type": "subtitle", "time": 9788.55, "timestamp": "02:43:08", "text": "尽管。我会和公司确认一下。"}, {"type": "subtitle", "time": 9801.349, "timestamp": "02:43:21", "text": "电话？我的 inones 不见了。哦，那里"}, {"type": "subtitle", "time": 9810.99, "timestamp": "02:43:30", "text": "你。我会向公司核实。好的。"}, {"type": "subtitle", "time": 9815.59, "timestamp": "02:43:35", "text": "呃，如果我能让乐乐帮我成为一个……"}, {"type": "subtitle", "time": 9819.19, "timestamp": "02:43:39", "text": "代表我，并代表我。讲话"}, {"type": "subtitle", "time": 9821.23, "timestamp": "02:43:41", "text": "接下来是"}, {"type": "subtitle", "time": 9824.51, "timestamp": "02:43:44", "text": "公司。所以她可能是"}, {"type": "subtitle", "time": 9828.79, "timestamp": "02:43:48", "text": "我的天，她可能是我的中国员工"}, {"type": "subtitle", "time": 9830.309, "timestamp": "02:43:50", "text": "或者某种可以代表我的东西"}, {"type": "subtitle", "time": 9832.389, "timestamp": "02:43:52", "text": "差不多就是这样。那或许会有帮助。"}, {"type": "subtitle", "time": 9836.15, "timestamp": "02:43:56", "text": "通过白名单中间人。但是如果"}]
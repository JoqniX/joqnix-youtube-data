[{"type": "subtitle", "time": 3240.349, "timestamp": "00:54:00", "text": "[音乐]"}, {"type": "subtitle", "time": 3251.67, "timestamp": "00:54:11", "text": "去。你以后会后悔的。"}, {"type": "subtitle", "time": 3262.27, "timestamp": "00:54:22", "text": "[音乐]"}, {"type": "subtitle", "time": 3266.19, "timestamp": "00:54:26", "text": "瑜伽。我后悔我所做的一切"}, {"type": "subtitle", "time": 3270.63, "timestamp": "00:54:30", "text": "我已经尽力了。但是但是"}, {"type": "subtitle", "time": 3272.27, "timestamp": "00:54:32", "text": "这"}, {"type": "subtitle", "time": 3275.91, "timestamp": "00:54:35", "text": "梦，梦，梦就是梦。"}, {"type": "subtitle", "time": 3278.549, "timestamp": "00:54:38", "text": "我的意思是，梦想，这些都是开始。"}, {"type": "subtitle", "time": 3281.549, "timestamp": "00:54:41", "text": "正确的？所以，不要"}, {"type": "subtitle", "time": 3284.309, "timestamp": "00:54:44", "text": "担心。嗨，我们开始游戏吧。"}, {"type": "subtitle", "time": 3285.87, "timestamp": "00:54:45", "text": "场景。"}, {"type": "subtitle", "time": 3291.19, "timestamp": "00:54:51", "text": "你好。你好。欢迎来到BSR 2第二天。等待，"}, {"type": "subtitle", "time": 3295.069, "timestamp": "00:54:55", "text": "BS 2 新创世交叉测试日"}, {"type": "subtitle", "time": 3299.03, "timestamp": "00:54:59", "text": "二。我应该做一个胖子，上面写着"}]
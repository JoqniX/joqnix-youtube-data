[{"type": "subtitle", "time": 15982.11, "timestamp": "04:26:22", "text": "一，二，"}, {"type": "subtitle", "time": 15985.67, "timestamp": "04:26:25", "text": "三。我知道我话不多。它是"}, {"type": "subtitle", "time": 16000.75, "timestamp": "04:26:40", "text": "事物。这次我只专注于"}, {"type": "subtitle", "time": 16003.71, "timestamp": "04:26:43", "text": "事物。我道歉。我不是在说话"}, {"type": "subtitle", "time": 16005.229, "timestamp": "04:26:45", "text": "很多"}, {"type": "subtitle", "time": 16008.429, "timestamp": "04:26:48", "text": "它。想想他深夜的骑师"}, {"type": "subtitle", "time": 16012.269, "timestamp": "04:26:52", "text": "想得太多，但他尽力了"}, {"type": "subtitle", "time": 16014.51, "timestamp": "04:26:54", "text": "片刻。"}]
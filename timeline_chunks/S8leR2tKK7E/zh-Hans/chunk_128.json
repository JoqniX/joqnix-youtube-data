[{"type": "subtitle", "time": 7680.87, "timestamp": "02:08:00", "text": "这里有各种各样的人。人们"}, {"type": "subtitle", "time": 7682.51, "timestamp": "02:08:02", "text": "他们是"}, {"type": "subtitle", "time": 7685.669, "timestamp": "02:08:05", "text": "主播和非主播以及人们"}, {"type": "subtitle", "time": 7687.069, "timestamp": "02:08:07", "text": "曾经是谁"}, {"type": "subtitle", "time": 7691.03, "timestamp": "02:08:11", "text": "直播，以及谁想直播非直播"}, {"type": "subtitle", "time": 7692.189, "timestamp": "02:08:12", "text": "YouTuber 和"}, {"type": "subtitle", "time": 7695.35, "timestamp": "02:08:15", "text": "YouTuber们，这很有趣，就像是……"}, {"type": "subtitle", "time": 7699.51, "timestamp": "02:08:19", "text": "更深入地了解他们，并成为"}, {"type": "subtitle", "time": 7700.91, "timestamp": "02:08:20", "text": "重新连接"}, {"type": "subtitle", "time": 7704.87, "timestamp": "02:08:24", "text": "从那以后，这种情况一直持续。是的。"}, {"type": "subtitle", "time": 7707.589, "timestamp": "02:08:27", "text": "说实话，太多事情了，真是……"}, {"type": "subtitle", "time": 7709.91, "timestamp": "02:08:29", "text": "拥有这项技能也很棒，因为现在"}, {"type": "subtitle", "time": 7711.99, "timestamp": "02:08:31", "text": "当你去日本的时候，只会是你"}, {"type": "subtitle", "time": 7719.629, "timestamp": "02:08:39", "text": "是的，所以"}, {"type": "subtitle", "time": 7722.709, "timestamp": "02:08:42", "text": "我希望我能更多地这样做。"}, {"type": "subtitle", "time": 7724.55, "timestamp": "02:08:44", "text": "未来也一样，你知道，坐下来吧。"}, {"type": "subtitle", "time": 7727.069, "timestamp": "02:08:47", "text": "与多人交谈"}, {"type": "subtitle", "time": 7729.31, "timestamp": "02:08:49", "text": "我不会这么做。"}, {"type": "subtitle", "time": 7731.91, "timestamp": "02:08:51", "text": "此时此刻，我觉得如果我"}, {"type": "subtitle", "time": 7734.229, "timestamp": "02:08:54", "text": "不要连续24小时直播，感觉太过了。"}, {"type": "subtitle", "time": 7737.35, "timestamp": "02:08:57", "text": "我不知道为什么"}, {"type": "subtitle", "time": 7739.189, "timestamp": "02:08:59", "text": "你知道，这是我……"}]
[{"type": "subtitle", "time": 8642.23, "timestamp": "02:24:02", "text": "如果命中注定，它就会如此。"}, {"type": "subtitle", "time": 8648.67, "timestamp": "02:24:08", "text": "当然。 D. 而且而且而且我"}, {"type": "subtitle", "time": 8651.91, "timestamp": "02:24:11", "text": "记住你的新模型"}, {"type": "subtitle", "time": 8654.389, "timestamp": "02:24:14", "text": "出道时，你没告诉任何人。你一直"}, {"type": "subtitle", "time": 8655.99, "timestamp": "02:24:15", "text": "自己留着吧。你是如何保守这个秘密的？"}, {"type": "subtitle", "time": 8658.469, "timestamp": "02:24:18", "text": "你自己？我的意思是，我真的很擅长"}, {"type": "subtitle", "time": 8661.03, "timestamp": "02:24:21", "text": "保守秘密。但事实并非如此。"}, {"type": "subtitle", "time": 8664.23, "timestamp": "02:24:24", "text": "我一直在寻找的东西"}, {"type": "subtitle", "time": 8666.469, "timestamp": "02:24:26", "text": "向前看，我不希望它成为……"}, {"type": "subtitle", "time": 8669.11, "timestamp": "02:24:29", "text": "惊喜。我当时就像在做这件事一样"}, {"type": "subtitle", "time": 8671.349, "timestamp": "02:24:31", "text": "幕后，我当时就在那里。"}, {"type": "subtitle", "time": 8673.75, "timestamp": "02:24:33", "text": "很少有人像你一样了解它。"}, {"type": "subtitle", "time": 8676.309, "timestamp": "02:24:36", "text": "当然，问问那些知道的人，就像有些人一样。"}, {"type": "subtitle", "time": 8678.07, "timestamp": "02:24:38", "text": "很多人甚至都不知道这一点，但"}, {"type": "subtitle", "time": 8681.59, "timestamp": "02:24:41", "text": "像Kyra Sukina，像Zavana，她们都"}, {"type": "subtitle", "time": 8685.27, "timestamp": "02:24:45", "text": "就像悠悠一样，他们其实都知道这一点。"}, {"type": "subtitle", "time": 8688.23, "timestamp": "02:24:48", "text": "凯拉当时也在场，我当时正在做这件事。"}, {"type": "subtitle", "time": 8691.83, "timestamp": "02:24:51", "text": "为它制作情绪板。所以，我当时真的非常"}, {"type": "subtitle", "time": 8693.67, "timestamp": "02:24:53", "text": "就像试图喜欢它一样？那是什么？煤气灯"}, {"type": "subtitle", "time": 8695.75, "timestamp": "02:24:55", "text": "人们开始认为好像有……"}, {"type": "subtitle", "time": 8697.75, "timestamp": "02:24:57", "text": "不会有太大的进展或影响"}]
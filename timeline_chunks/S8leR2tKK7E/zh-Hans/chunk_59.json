[{"type": "subtitle", "time": 3542.67, "timestamp": "00:59:02", "text": "游戏媒体音量"}, {"type": "subtitle", "time": 3545.63, "timestamp": "00:59:05", "text": "30号语音应该清晰"}, {"type": "subtitle", "time": 3557.309, "timestamp": "00:59:17", "text": "疼痛。你这儿有这位妹妹"}, {"type": "subtitle", "time": 3559.309, "timestamp": "00:59:19", "text": "车。你让我"}, {"type": "subtitle", "time": 3562.87, "timestamp": "00:59:22", "text": "知道。我暂时先把它设为60吧。"}, {"type": "subtitle", "time": 3565.71, "timestamp": "00:59:25", "text": "伙计们。你告诉我一声。"}, {"type": "subtitle", "time": 3568.15, "timestamp": "00:59:28", "text": "好的。我会关掉压缩机。"}, {"type": "subtitle", "time": 3570.15, "timestamp": "00:59:30", "text": "每当我说话时，它就不会"}, {"type": "subtitle", "time": 3572.349, "timestamp": "00:59:32", "text": "影响游戏"}, {"type": "subtitle", "time": 3594.99, "timestamp": "00:59:54", "text": "不过，呃，说到……"}]
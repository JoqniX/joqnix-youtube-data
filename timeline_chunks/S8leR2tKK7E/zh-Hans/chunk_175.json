[{"type": "subtitle", "time": 10502.07, "timestamp": "02:55:02", "text": "中国大多数编辑不接受这种说法。"}, {"type": "subtitle", "time": 10503.389, "timestamp": "02:55:03", "text": "种类"}, {"type": "subtitle", "time": 10507.03, "timestamp": "02:55:07", "text": "这些非常粗糙，而且需要等待。"}, {"type": "subtitle", "time": 10507.95, "timestamp": "02:55:07", "text": "有点儿"}, {"type": "subtitle", "time": 10511.389, "timestamp": "02:55:11", "text": "嗯，翻译，还有"}, {"type": "subtitle", "time": 10514.429, "timestamp": "02:55:14", "text": "语音直译"}, {"type": "subtitle", "time": 10517.19, "timestamp": "02:55:17", "text": "代表必须到场。"}, {"type": "subtitle", "time": 10521.19, "timestamp": "02:55:21", "text": "当他们需要类似这种情况时"}, {"type": "subtitle", "time": 10524.23, "timestamp": "02:55:24", "text": "翻译内容不准确。"}, {"type": "subtitle", "time": 10540.15, "timestamp": "02:55:40", "text": "很多这就是我所说的翻译的意思"}, {"type": "subtitle", "time": 10542.23, "timestamp": "02:55:42", "text": "软件。我感觉我好像有这种感觉。"}, {"type": "subtitle", "time": 10550.99, "timestamp": "02:55:50", "text": "[音乐]"}, {"type": "subtitle", "time": 10555.269, "timestamp": "02:55:55", "text": "呃，最后我需要获取一些数字。嗯？"}, {"type": "subtitle", "time": 10556.429, "timestamp": "02:55:56", "text": "无论我在哪里"}]
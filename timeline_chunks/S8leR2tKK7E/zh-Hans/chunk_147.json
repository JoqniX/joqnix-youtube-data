[{"type": "subtitle", "time": 8820.71, "timestamp": "02:27:00", "text": "我相信会的。我知道你很焦虑"}, {"type": "subtitle", "time": 8823.349, "timestamp": "02:27:03", "text": "但一切都会顺利的。"}, {"type": "subtitle", "time": 8830.469, "timestamp": "02:27:10", "text": "我昨天私信了那个索具工的儿子。我"}, {"type": "subtitle", "time": 8834.75, "timestamp": "02:27:14", "text": "希望拥有，我希望我能得到一个"}, {"type": "subtitle", "time": 8837.99, "timestamp": "02:27:17", "text": "回复。我当时不得不问，现在我不知道了"}, {"type": "subtitle", "time": 8840.63, "timestamp": "02:27:20", "text": "我知道我见过有些人这样做，就像……"}, {"type": "subtitle", "time": 8842.71, "timestamp": "02:27:22", "text": "学习系统。我不知道是不是"}, {"type": "subtitle", "time": 8844.51, "timestamp": "02:27:24", "text": "做得好"}, {"type": "subtitle", "time": 8848.15, "timestamp": "02:27:28", "text": "那个学习系统，嗯，你知道的"}, {"type": "subtitle", "time": 8849.71, "timestamp": "02:27:29", "text": "嗯，你"}, {"type": "subtitle", "time": 8853.27, "timestamp": "02:27:33", "text": "让这些人来帮你做模型"}, {"type": "subtitle", "time": 8856.11, "timestamp": "02:27:36", "text": "根据合同，例如一项条款"}, {"type": "subtitle", "time": 8860.23, "timestamp": "02:27:40", "text": "你就是那个人，你会分期偿还他们。"}, {"type": "subtitle", "time": 8862.309, "timestamp": "02:27:42", "text": "类似的东西，你仍然可以首次亮相"}, {"type": "subtitle", "time": 8864.07, "timestamp": "02:27:44", "text": "就是那种东西。我不知道是否"}, {"type": "subtitle", "time": 8865.67, "timestamp": "02:27:45", "text": "那就是"}, {"type": "subtitle", "time": 8870.07, "timestamp": "02:27:50", "text": "哦，就像分期付款或者信用额度那样。 H"}, {"type": "subtitle", "time": 8872.59, "timestamp": "02:27:52", "text": "就像EMI（分期付款）一样。"}, {"type": "subtitle", "time": 8875.59, "timestamp": "02:27:55", "text": "嗯，这就像分期付款一样。"}, {"type": "subtitle", "time": 8879.75, "timestamp": "02:27:59", "text": "不。是。你买它就像买一个非常"}]
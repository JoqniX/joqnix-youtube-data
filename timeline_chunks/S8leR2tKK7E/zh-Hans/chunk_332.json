[{"type": "subtitle", "time": 19921.35, "timestamp": "05:32:01", "text": "为什么眉毛会那样动？"}, {"type": "subtitle", "time": 19923.75, "timestamp": "05:32:03", "text": "等等，我……我没注意到。等待，"}, {"type": "subtitle", "time": 19933.27, "timestamp": "05:32:13", "text": "嘿，有什么东西吗？如果您正在寻找"}, {"type": "subtitle", "time": 19935.83, "timestamp": "05:32:15", "text": "交易方面，我很乐意帮忙。"}, {"type": "subtitle", "time": 19937.708, "timestamp": "05:32:17", "text": "你就是这个意思。好的。"}, {"type": "subtitle", "time": 19940.788, "timestamp": "05:32:20", "text": "好的。好的。他的库存并不那么……"}, {"type": "subtitle", "time": 19943.19, "timestamp": "05:32:23", "text": "完全重置。没关系。资源"}, {"type": "subtitle", "time": 19946.31, "timestamp": "05:32:26", "text": "适应框架，然后我们把它直接放上去。"}, {"type": "subtitle", "time": 19948.51, "timestamp": "05:32:28", "text": "23"}, {"type": "subtitle", "time": 19950.948, "timestamp": "05:32:30", "text": "24,000。那边就是。让我降低"}, {"type": "subtitle", "time": 19952.35, "timestamp": "05:32:32", "text": "这"}, {"type": "subtitle", "time": 19956.19, "timestamp": "05:32:36", "text": "数量，简直就像把他撕碎了一样。"}, {"type": "subtitle", "time": 19960.39, "timestamp": "05:32:40", "text": "离开。让他进入零模式。 70."}, {"type": "subtitle", "time": 19963.51, "timestamp": "05:32:43", "text": "我会给他，就给他一个。"}, {"type": "subtitle", "time": 19967.27, "timestamp": "05:32:47", "text": "信用。是的。现在你打算怎么办？拿"}, {"type": "subtitle", "time": 19969.19, "timestamp": "05:32:49", "text": "关心。我。现在你已经拿回了退款。"}, {"type": "subtitle", "time": 19972.99, "timestamp": "05:32:52", "text": "如果你在……的话，你只需坐下即可。"}, {"type": "subtitle", "time": 19975.67, "timestamp": "05:32:55", "text": "好的。椅子在哪儿来着？那是"}, {"type": "subtitle", "time": 19977.708, "timestamp": "05:32:57", "text": "不是“你好”。在哪里？"}]
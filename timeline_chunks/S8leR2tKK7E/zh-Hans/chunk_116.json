[{"type": "subtitle", "time": 6963.109, "timestamp": "01:56:03", "text": "SK观看的直播内容不止Twitch。他们想要"}, {"type": "subtitle", "time": 6965.83, "timestamp": "01:56:05", "text": "他们会一直在那里。我不"}, {"type": "subtitle", "time": 6967.589, "timestamp": "01:56:07", "text": "思考"}, {"type": "subtitle", "time": 6969.83, "timestamp": "01:56:09", "text": "感觉就像我无法理解……"}, {"type": "subtitle", "time": 6971.669, "timestamp": "01:56:11", "text": "你居然能在这么多平台上点赞直播？"}, {"type": "subtitle", "time": 6974.07, "timestamp": "01:56:14", "text": "同时在多个平台上，因为就像"}, {"type": "subtitle", "time": 6976.31, "timestamp": "01:56:16", "text": "即使只是在一个平台上直播也让人感到害怕。"}, {"type": "subtitle", "time": 6978.109, "timestamp": "01:56:18", "text": "更别提我了。"}, {"type": "subtitle", "time": 6981.51, "timestamp": "01:56:21", "text": "和其他平台一样，这种想法"}, {"type": "subtitle", "time": 6983.07, "timestamp": "01:56:23", "text": "它给了我很多"}, {"type": "subtitle", "time": 6986.79, "timestamp": "01:56:26", "text": "焦虑就像你那样，所以，怎么办？"}, {"type": "subtitle", "time": 6990.87, "timestamp": "01:56:30", "text": "我说我擅长给你展示东西，"}, {"type": "subtitle", "time": 6994.629, "timestamp": "01:56:34", "text": "说真的，你太勇敢了。"}, {"type": "subtitle", "time": 6996.189, "timestamp": "01:56:36", "text": "我不"}, {"type": "subtitle", "time": 6998.87, "timestamp": "01:56:38", "text": "不，我有。不，我本来应该直播的。"}, {"type": "subtitle", "time": 7001.75, "timestamp": "01:56:41", "text": "我在推特上发帖是因为我开了高级会员。"}, {"type": "subtitle", "time": 7005.03, "timestamp": "01:56:45", "text": "只是想私信那位日本虚拟主播。我"}, {"type": "subtitle", "time": 7008.31, "timestamp": "01:56:48", "text": "我用 X 做了那个验证。"}, {"type": "subtitle", "time": 7010.149, "timestamp": "01:56:50", "text": "优质的。"}, {"type": "subtitle", "time": 7012.229, "timestamp": "01:56:52", "text": "但最终，他们没有回复。和"}, {"type": "subtitle", "time": 7014.47, "timestamp": "01:56:54", "text": "我心想，嗯，没关系。这是一个"}]
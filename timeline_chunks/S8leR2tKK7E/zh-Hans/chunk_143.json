[{"type": "subtitle", "time": 8580.389, "timestamp": "02:23:00", "text": "是的，我很高兴拥有这一切。"}, {"type": "subtitle", "time": 8583.83, "timestamp": "02:23:03", "text": "这个模型。就像我"}, {"type": "subtitle", "time": 8586.67, "timestamp": "02:23:06", "text": "不知道为什么。或许是最好的"}, {"type": "subtitle", "time": 8590.07, "timestamp": "02:23:10", "text": "也许发生了一些事"}, {"type": "subtitle", "time": 8592.55, "timestamp": "02:23:12", "text": "原因。不。"}, {"type": "subtitle", "time": 8595.429, "timestamp": "02:23:15", "text": "拿出来。是的。我从未预料到"}, {"type": "subtitle", "time": 8597.67, "timestamp": "02:23:17", "text": "我自己想要一个像新型号一样的东西"}, {"type": "subtitle", "time": 8598.95, "timestamp": "02:23:18", "text": "任何事物。我当时就想，“是啊，我要去。”"}, {"type": "subtitle", "time": 8602.23, "timestamp": "02:23:22", "text": "暂时先用现在的这个。"}, {"type": "subtitle", "time": 8605.27, "timestamp": "02:23:25", "text": "也许将来如果我赢了"}, {"type": "subtitle", "time": 8607.99, "timestamp": "02:23:27", "text": "中彩票，或者如果我发财了，或者如果我得到"}, {"type": "subtitle", "time": 8610.469, "timestamp": "02:23:30", "text": "如果能找到一份好工作，我就可以"}, {"type": "subtitle", "time": 8613.309, "timestamp": "02:23:33", "text": "委托做某事"}, {"type": "subtitle", "time": 8617.03, "timestamp": "02:23:37", "text": "以后再做或者自己做。我当时"}, {"type": "subtitle", "time": 8619.27, "timestamp": "02:23:39", "text": "那。我当时想，我要做点类似的事情"}, {"type": "subtitle", "time": 8620.429, "timestamp": "02:23:40", "text": "那个和"}, {"type": "subtitle", "time": 8624.55, "timestamp": "02:23:44", "text": "东西，但我没想到自己会"}, {"type": "subtitle", "time": 8627.83, "timestamp": "02:23:47", "text": "有这种东西，或者甚至是"}, {"type": "subtitle", "time": 8631.83, "timestamp": "02:23:51", "text": "甚至有机会来到这里，拥有这一切。"}, {"type": "subtitle", "time": 8636.07, "timestamp": "02:23:56", "text": "等等等等，我很高兴。"}, {"type": "subtitle", "time": 8639.75, "timestamp": "02:23:59", "text": "所以事情的发生都是有原因的。确切地。"}]
[{"type": "subtitle", "time": 7201.03, "timestamp": "02:00:01", "text": "别担心，别再为这些事烦恼了。我是"}, {"type": "subtitle", "time": 7204.629, "timestamp": "02:00:04", "text": "很高兴你还在。但是也"}, {"type": "subtitle", "time": 7207.35, "timestamp": "02:00:07", "text": "这就是我的个人哲学"}, {"type": "subtitle", "time": 7209.75, "timestamp": "02:00:09", "text": "如果你喜欢做某事，你知道你喜欢做什么。"}, {"type": "subtitle", "time": 7212.39, "timestamp": "02:00:12", "text": "你真正喜欢或热爱的东西"}, {"type": "subtitle", "time": 7214.229, "timestamp": "02:00:14", "text": "比如你不应该因为……而放弃"}, {"type": "subtitle", "time": 7216.31, "timestamp": "02:00:16", "text": "你的情况。我觉得就是这样"}, {"type": "subtitle", "time": 7218.07, "timestamp": "02:00:18", "text": "需要像我刚才说的那么一点"}, {"type": "subtitle", "time": 7219.99, "timestamp": "02:00:19", "text": "距离。你只需要远离就行了。"}, {"type": "subtitle", "time": 7221.83, "timestamp": "02:00:21", "text": "暂时远离它，就像你知道的，休息一段时间"}, {"type": "subtitle", "time": 7224.709, "timestamp": "02:00:24", "text": "暂时放下这件事，等你回来的时候"}, {"type": "subtitle", "time": 7226.55, "timestamp": "02:00:26", "text": "你一定会同样喜欢它"}, {"type": "subtitle", "time": 7229.27, "timestamp": "02:00:29", "text": "因为如果你心境不对……"}, {"type": "subtitle", "time": 7232.39, "timestamp": "02:00:32", "text": "那到底是什么？你却一直这样做。"}, {"type": "subtitle", "time": 7235.91, "timestamp": "02:00:35", "text": "你会喜欢这种开始建立联系的方式。"}, {"type": "subtitle", "time": 7238.709, "timestamp": "02:00:38", "text": "关于这项活动的负面因素"}, {"type": "subtitle", "time": 7241.03, "timestamp": "02:00:41", "text": "这真的太伤人了。它是"}, {"type": "subtitle", "time": 7242.31, "timestamp": "02:00:42", "text": "就像一件非常伤人的事一样"}, {"type": "subtitle", "time": 7244.229, "timestamp": "02:00:44", "text": "如果你认为这是某件事，那就是"}, {"type": "subtitle", "time": 7247.51, "timestamp": "02:00:47", "text": "你绝对喜欢。是的。就像这样"}, {"type": "subtitle", "time": 7249.669, "timestamp": "02:00:49", "text": "就像我的建议一直是我首选的参考依据"}, {"type": "subtitle", "time": 7252.31, "timestamp": "02:00:52", "text": "对于我认识的大多数主播来说，"}, {"type": "subtitle", "time": 7254.149, "timestamp": "02:00:54", "text": "就像你知道的，我已经见过并且是"}, {"type": "subtitle", "time": 7256.31, "timestamp": "02:00:56", "text": "经历了很多困难"}, {"type": "subtitle", "time": 7259.189, "timestamp": "02:00:59", "text": "有时候只需要一个小时"}]
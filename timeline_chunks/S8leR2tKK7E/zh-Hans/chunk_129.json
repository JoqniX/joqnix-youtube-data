[{"type": "subtitle", "time": 7741.03, "timestamp": "02:09:01", "text": "我个人一直想做我这样的事"}, {"type": "subtitle", "time": 7743.03, "timestamp": "02:09:03", "text": "一直想引进很多"}, {"type": "subtitle", "time": 7744.79, "timestamp": "02:09:04", "text": "人们也喜欢融入社区"}, {"type": "subtitle", "time": 7747.109, "timestamp": "02:09:07", "text": "然后和成员们坐下来交谈"}, {"type": "subtitle", "time": 7748.629, "timestamp": "02:09:08", "text": "就像你知道的，谈论他们"}, {"type": "subtitle", "time": 7751.589, "timestamp": "02:09:11", "text": "比如他们的艺术之类的东西，但是"}, {"type": "subtitle", "time": 7754.79, "timestamp": "02:09:14", "text": "当然，就像我作为一名 YouTuber 一样。"}, {"type": "subtitle", "time": 7756.31, "timestamp": "02:09:16", "text": "背景有点难做"}, {"type": "subtitle", "time": 7759.03, "timestamp": "02:09:19", "text": "而且你还需要稍微谨慎一些。"}, {"type": "subtitle", "time": 7760.229, "timestamp": "02:09:20", "text": "因为有很多"}, {"type": "subtitle", "time": 7762.709, "timestamp": "02:09:22", "text": "互联网上形形色色的人"}, {"type": "subtitle", "time": 7766.229, "timestamp": "02:09:26", "text": "嗯。你可能喜欢，也可能不喜欢。"}, {"type": "subtitle", "time": 7768.52, "timestamp": "02:09:28", "text": "最佳体验。"}, {"type": "subtitle", "time": 7785.109, "timestamp": "02:09:45", "text": "这太棒了。就像我感觉一样"}, {"type": "subtitle", "time": 7789.35, "timestamp": "02:09:49", "text": "就像我一样，我确实没有天赋，但是"}, {"type": "subtitle", "time": 7792.51, "timestamp": "02:09:52", "text": "完成这项工作所需的技能不多。"}, {"type": "subtitle", "time": 7796.109, "timestamp": "02:09:56", "text": "有点像播客吧。我不知道。哦，我的"}, {"type": "subtitle", "time": 7798.87, "timestamp": "02:09:58", "text": "上帝。我觉得那就像"}]
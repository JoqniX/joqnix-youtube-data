[{"type": "subtitle", "time": 12367.59, "timestamp": "03:26:07", "text": "嗯，或许我可以分享一些关于……"}, {"type": "subtitle", "time": 12373.15, "timestamp": "03:26:13", "text": "是的。但"}, {"type": "subtitle", "time": 12377.229, "timestamp": "03:26:17", "text": "人们也可以获得"}, {"type": "subtitle", "time": 12379.71, "timestamp": "03:26:19", "text": "对……有毒"}, {"type": "subtitle", "time": 12385.429, "timestamp": "03:26:25", "text": "我来自印度。"}, {"type": "subtitle", "time": 12390.39, "timestamp": "03:26:30", "text": "许多人都告诉我这一点。"}, {"type": "subtitle", "time": 12396.63, "timestamp": "03:26:36", "text": "呃，然而在目前情况下，我"}, {"type": "subtitle", "time": 12398.71, "timestamp": "03:26:38", "text": "希望公司接纳小型创作者"}, {"type": "subtitle", "time": 12400.469, "timestamp": "03:26:40", "text": "来自海外，精通某种语言"}, {"type": "subtitle", "time": 12402.95, "timestamp": "03:26:42", "text": "障碍。这个阈值显然已经存在。"}, {"type": "subtitle", "time": 12405.469, "timestamp": "03:26:45", "text": "也从小就被培养出来"}, {"type": "subtitle", "time": 12410.269, "timestamp": "03:26:50", "text": "很多。是的。最终，她也是"}, {"type": "subtitle", "time": 12412.63, "timestamp": "03:26:52", "text": "我心想，“这很令人难过，但我认为你"}]
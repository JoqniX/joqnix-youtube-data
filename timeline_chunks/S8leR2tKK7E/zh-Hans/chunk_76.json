[{"type": "subtitle", "time": 4561.75, "timestamp": "01:16:01", "text": "这样做你往往会忽略"}, {"type": "subtitle", "time": 4564.87, "timestamp": "01:16:04", "text": "您自身的健康和需求，这便是"}, {"type": "subtitle", "time": 4567.51, "timestamp": "01:16:07", "text": "未必是好事。所以当你搬家的时候"}, {"type": "subtitle", "time": 4569.83, "timestamp": "01:16:09", "text": "致日本，我希望你学会享受爱。"}, {"type": "subtitle", "time": 4571.99, "timestamp": "01:16:11", "text": "多了解自己，然后明白自己的极限"}, {"type": "subtitle", "time": 4574.79, "timestamp": "01:16:14", "text": "也一样。前辈"}, {"type": "subtitle", "time": 4576.189, "timestamp": "01:16:16", "text": "我希望"}, {"type": "subtitle", "time": 4579.75, "timestamp": "01:16:19", "text": "所以。我只能看到日本的第一周。"}, {"type": "subtitle", "time": 4582.63, "timestamp": "01:16:22", "text": "会像……一样，我会像……一样打电话"}, {"type": "subtitle", "time": 4585.03, "timestamp": "01:16:25", "text": "我的爸爸。我会像我一样想来"}, {"type": "subtitle", "time": 4588.79, "timestamp": "01:16:28", "text": "回来吧，爸爸。我做不到。我想来"}, {"type": "subtitle", "time": 4591.51, "timestamp": "01:16:31", "text": "后退。这太难了。我会像这样"}, {"type": "subtitle", "time": 4594.149, "timestamp": "01:16:34", "text": "那。"}, {"type": "subtitle", "time": 4596.95, "timestamp": "01:16:36", "text": "我认为这是不可避免的。你会"}, {"type": "subtitle", "time": 4598.55, "timestamp": "01:16:38", "text": "想家了，你会像你知道的那样。"}, {"type": "subtitle", "time": 4602.149, "timestamp": "01:16:42", "text": "尤其是在节日期间。但我"}, {"type": "subtitle", "time": 4604.229, "timestamp": "01:16:44", "text": "我觉得如果你找到的话，情况可能会更好。"}, {"type": "subtitle", "time": 4606.39, "timestamp": "01:16:46", "text": "你所在社区的人们"}, {"type": "subtitle", "time": 4609.35, "timestamp": "01:16:49", "text": "一起庆祝吧。"}, {"type": "subtitle", "time": 4613.11, "timestamp": "01:16:53", "text": "哦，嗯，​​我刚刚意识到七夕节"}, {"type": "subtitle", "time": 4615.27, "timestamp": "01:16:55", "text": "星祭正在举行"}, {"type": "subtitle", "time": 4617.91, "timestamp": "01:16:57", "text": "下个月，那个月就是我的……"}]
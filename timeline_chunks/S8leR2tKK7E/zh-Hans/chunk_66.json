[{"type": "subtitle", "time": 3961.109, "timestamp": "01:06:01", "text": "[音乐]"}, {"type": "subtitle", "time": 3965.029, "timestamp": "01:06:05", "text": "那可真是件了不起的事。我的天啊。"}, {"type": "subtitle", "time": 3974.71, "timestamp": "01:06:14", "text": "但我觉得，如果你喜欢的话……"}, {"type": "subtitle", "time": 3976.63, "timestamp": "01:06:16", "text": "你身边有人陪伴吗？或者如果你没有？"}, {"type": "subtitle", "time": 3979.99, "timestamp": "01:06:19", "text": "我害怕向别人寻求帮助，我"}, {"type": "subtitle", "time": 3983.349, "timestamp": "01:06:23", "text": "我想你会没事的。因为我会"}, {"type": "subtitle", "time": 3985.349, "timestamp": "01:06:25", "text": "这么说吧，其中一件大事是……"}, {"type": "subtitle", "time": 3987.19, "timestamp": "01:06:27", "text": "在苏格兰，这让我的处境变得轻松许多。"}, {"type": "subtitle", "time": 3988.87, "timestamp": "01:06:28", "text": "你知道，很多人都……"}, {"type": "subtitle", "time": 3991.51, "timestamp": "01:06:31", "text": "非常有帮助。即使像我"}, {"type": "subtitle", "time": 3992.95, "timestamp": "01:06:32", "text": "会去杂货店购物"}, {"type": "subtitle", "time": 3994.95, "timestamp": "01:06:34", "text": "所有的一切，所有雇主都像这样"}, {"type": "subtitle", "time": 3997.67, "timestamp": "01:06:37", "text": "他们帮了我很多，因为他们知道我是"}, {"type": "subtitle", "time": 3999.75, "timestamp": "01:06:39", "text": "就像，你知道，就像一个新人"}, {"type": "subtitle", "time": 4001.91, "timestamp": "01:06:41", "text": "这个国家。"}, {"type": "subtitle", "time": 4004.63, "timestamp": "01:06:44", "text": "所以，但你也会犯错。"}, {"type": "subtitle", "time": 4006.63, "timestamp": "01:06:46", "text": "这是不可避免的。但你也会学到"}, {"type": "subtitle", "time": 4008.39, "timestamp": "01:06:48", "text": "从中。"}, {"type": "subtitle", "time": 4010.789, "timestamp": "01:06:50", "text": "是的。"}, {"type": "subtitle", "time": 4013.87, "timestamp": "01:06:53", "text": "嗯。这是真的。"}, {"type": "subtitle", "time": 4015.71, "timestamp": "01:06:55", "text": "呃，如何"}, {"type": "subtitle", "time": 4019.349, "timestamp": "01:06:59", "text": "你在那里待了多少年？"}]
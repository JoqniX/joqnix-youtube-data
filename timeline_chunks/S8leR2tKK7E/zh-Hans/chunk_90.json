[{"type": "subtitle", "time": 5400.47, "timestamp": "01:30:00", "text": "它真的直接把我的脸露了出来"}, {"type": "subtitle", "time": 5403.99, "timestamp": "01:30:03", "text": "后置摄像头，前置摄像头。哦不，不。"}, {"type": "subtitle", "time": 5408.39, "timestamp": "01:30:08", "text": "我当时慌了。我内心已​​经死去，我"}, {"type": "subtitle", "time": 5412.31, "timestamp": "01:30:12", "text": "把那个 w 删掉了。"}, {"type": "subtitle", "time": 5414.87, "timestamp": "01:30:14", "text": "我觉得好像也发生过类似的事情。"}, {"type": "subtitle", "time": 5417.669, "timestamp": "01:30:17", "text": "对我来说，但我却暴露了我的弱点，然后"}, {"type": "subtitle", "time": 5420.55, "timestamp": "01:30:20", "text": "我不得不把它从我的病房里剔除出去。我慌了。"}, {"type": "subtitle", "time": 5423.35, "timestamp": "01:30:23", "text": "虽然我其实并不喜欢，但我就是喜欢。"}, {"type": "subtitle", "time": 5425.03, "timestamp": "01:30:25", "text": "把它放在相机下面，"}, {"type": "subtitle", "time": 5426.39, "timestamp": "01:30:26", "text": "然后我意识到，糟了，我不是"}, {"type": "subtitle", "time": 5429.189, "timestamp": "01:30:29", "text": "戴上手套。然后就像之后一样"}, {"type": "subtitle", "time": 5431.669, "timestamp": "01:30:31", "text": "事情结束了，我联系了珀尔。"}, {"type": "subtitle", "time": 5434.07, "timestamp": "01:30:34", "text": "我们喜欢泡泡之类的东西。"}, {"type": "subtitle", "time": 5435.83, "timestamp": "01:30:35", "text": "所以我不得不等到第二天早上。"}, {"type": "subtitle", "time": 5437.43, "timestamp": "01:30:37", "text": "为了处理水，以便我"}, {"type": "subtitle", "time": 5439.51, "timestamp": "01:30:39", "text": "可以切断它。"}, {"type": "subtitle", "time": 5449.91, "timestamp": "01:30:49", "text": "是的。 B怎么样？已经有一段时间了。"}, {"type": "subtitle", "time": 5451.99, "timestamp": "01:30:51", "text": "交谈过"}, {"type": "subtitle", "time": 5454.229, "timestamp": "01:30:54", "text": "我觉得他没事。就像我不这样"}, {"type": "subtitle", "time": 5457.27, "timestamp": "01:30:57", "text": "我觉得他一直都很活跃，因为"}]
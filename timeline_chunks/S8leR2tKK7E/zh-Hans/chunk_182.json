[{"type": "subtitle", "time": 10921.91, "timestamp": "03:02:01", "text": "因为我没有工作，我没有任何人。"}, {"type": "subtitle", "time": 10923.95, "timestamp": "03:02:03", "text": "指引我"}, {"type": "subtitle", "time": 10938.269, "timestamp": "03:02:18", "text": "呃，我该怎么办？"}, {"type": "subtitle", "time": 10941.19, "timestamp": "03:02:21", "text": "画？我知道比利比利至少"}, {"type": "subtitle", "time": 10945.03, "timestamp": "03:02:25", "text": "就像我的担忧之一。我必须"}, {"type": "subtitle", "time": 10953.59, "timestamp": "03:02:33", "text": "一切。唉，但还是太……"}, {"type": "subtitle", "time": 10966.309, "timestamp": "03:02:46", "text": "至少该公司认为你"}, {"type": "subtitle", "time": 10972.07, "timestamp": "03:02:52", "text": "事物。可能是该公司"}, {"type": "subtitle", "time": 10975.11, "timestamp": "03:02:55", "text": "认为你想做的事情非常"}, {"type": "subtitle", "time": 10977.83, "timestamp": "03:02:57", "text": "著名的。所以它这么认为，所以它这么认为"}, {"type": "subtitle", "time": 10979.67, "timestamp": "03:02:59", "text": "在某个领域，成名是必要的。"}]
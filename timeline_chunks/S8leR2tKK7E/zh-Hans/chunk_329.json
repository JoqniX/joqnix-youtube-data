[{"type": "subtitle", "time": 19743.51, "timestamp": "05:29:03", "text": "因为即使我去查阅资源，哦"}, {"type": "subtitle", "time": 19745.868, "timestamp": "05:29:05", "text": "等等，我忘了拿我的回复。"}, {"type": "subtitle", "time": 19751.91, "timestamp": "05:29:11", "text": "噢，我帕卡帕卡帕卡帕卡帕卡帕卡。你"}, {"type": "subtitle", "time": 19754.07, "timestamp": "05:29:14", "text": "忘了带上你的“我的天哪”。你"}, {"type": "subtitle", "time": 19756.59, "timestamp": "05:29:16", "text": "忘了带你的"}, {"type": "subtitle", "time": 19759.43, "timestamp": "05:29:19", "text": "东西。你居然忘了带你的"}, {"type": "subtitle", "time": 19763.868, "timestamp": "05:29:23", "text": "东西。什么？欢迎随时回来。"}, {"type": "subtitle", "time": 19767.868, "timestamp": "05:29:27", "text": "什么？我竟然忘了带我的"}, {"type": "subtitle", "time": 19779.15, "timestamp": "05:29:39", "text": "我真的忘了。哦，我的"}, {"type": "subtitle", "time": 19793.628, "timestamp": "05:29:53", "text": "我的开放"}]
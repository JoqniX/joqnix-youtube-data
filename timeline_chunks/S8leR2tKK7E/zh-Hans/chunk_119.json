[{"type": "subtitle", "time": 7141.75, "timestamp": "01:59:01", "text": "足够了，但也像我说的那样，如果"}, {"type": "subtitle", "time": 7143.35, "timestamp": "01:59:03", "text": "系统出现任何问题……"}, {"type": "subtitle", "time": 7145.83, "timestamp": "01:59:05", "text": "就像已经足够打击士气一样，而且雪上加霜的是"}, {"type": "subtitle", "time": 7149.51, "timestamp": "01:59:09", "text": "倦怠感就像是，就这么……"}, {"type": "subtitle", "time": 7151.669, "timestamp": "01:59:11", "text": "我该说什么呢，你只是感觉……"}, {"type": "subtitle", "time": 7155.109, "timestamp": "01:59:15", "text": "被打得鼻青脸肿，而且需要很长时间"}, {"type": "subtitle", "time": 7157.43, "timestamp": "01:59:17", "text": "就像重新积蓄能量回去一样"}, {"type": "subtitle", "time": 7160.87, "timestamp": "01:59:20", "text": "居住。是的。我通常都会面临这种情况。"}, {"type": "subtitle", "time": 7163.75, "timestamp": "01:59:23", "text": "我当时的情况是……"}, {"type": "subtitle", "time": 7166.55, "timestamp": "01:59:26", "text": "你知道吗？我不想这样做"}, {"type": "subtitle", "time": 7169.31, "timestamp": "01:59:29", "text": "不再这样了。我应该就此打住"}, {"type": "subtitle", "time": 7172.51, "timestamp": "01:59:32", "text": "直播或停止谈话或"}, {"type": "subtitle", "time": 7174.87, "timestamp": "01:59:34", "text": "因为东西太多了。"}, {"type": "subtitle", "time": 7176.51, "timestamp": "01:59:36", "text": "幕后发生的事情"}, {"type": "subtitle", "time": 7178.51, "timestamp": "01:59:38", "text": "当时的场景"}, {"type": "subtitle", "time": 7183.189, "timestamp": "01:59:43", "text": "时间。于是我又回归了直播行业。它"}, {"type": "subtitle", "time": 7186.03, "timestamp": "01:59:46", "text": "一切都结束了，而且得到了更多"}, {"type": "subtitle", "time": 7190.31, "timestamp": "01:59:50", "text": "我曾因很多事情而受伤，现在"}, {"type": "subtitle", "time": 7192.91, "timestamp": "01:59:52", "text": "我现在在这里做"}, {"type": "subtitle", "time": 7197.47, "timestamp": "01:59:57", "text": "Chathon 是一种让我去做自己想做的事的方式。"}]
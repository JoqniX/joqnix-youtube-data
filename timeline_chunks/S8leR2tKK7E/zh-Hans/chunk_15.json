[{"type": "subtitle", "time": 900.91, "timestamp": "00:15:00", "text": "因为我不是所有者"}, {"type": "subtitle", "time": 905.189, "timestamp": "00:15:05", "text": "onx 是 onx 的主要名称之一。我"}, {"type": "subtitle", "time": 907.509, "timestamp": "00:15:07", "text": "意思是像在 Twitch 上直播的那个人"}, {"type": "subtitle", "time": 911.829, "timestamp": "00:15:11", "text": "已经取了“baka”这个名字。"}, {"type": "subtitle", "time": 914.269, "timestamp": "00:15:14", "text": "谁会得到那个水烟筒？"}, {"type": "subtitle", "time": 916.71, "timestamp": "00:15:16", "text": "总有一天我会对此无能为力。"}, {"type": "subtitle", "time": 919.509, "timestamp": "00:15:19", "text": "对我来说没错，我是jocknik的老板"}, {"type": "subtitle", "time": 922.71, "timestamp": "00:15:22", "text": "因为我当时是在Jocknix上注册的账号。"}, {"type": "subtitle", "time": 925.03, "timestamp": "00:15:25", "text": "改了名字，然后得到了我的名字"}, {"type": "subtitle", "time": 927.99, "timestamp": "00:15:27", "text": "原来的用户名在右边，但是在这里我"}, {"type": "subtitle", "time": 931.43, "timestamp": "00:15:31", "text": "难道我就不能买下来吗？"}, {"type": "subtitle", "time": 935.03, "timestamp": "00:15:35", "text": "但是如果我在 Twitch 上搜索，似乎"}, {"type": "subtitle", "time": 938.03, "timestamp": "00:15:38", "text": "就像那个名字出现在屏幕上的人一样。"}, {"type": "subtitle", "time": 941.75, "timestamp": "00:15:41", "text": "X 因某些原因被永久封禁"}, {"type": "subtitle", "time": 945.629, "timestamp": "00:15:45", "text": "原因。我当时就想：“啊？啊？什么？”"}, {"type": "subtitle", "time": 948.829, "timestamp": "00:15:48", "text": "伦尼。”我心想，“什么鬼？”"}, {"type": "subtitle", "time": 952.629, "timestamp": "00:15:52", "text": "“见鬼？”所以，是的。所以我以为我用"}, {"type": "subtitle", "time": 954.269, "timestamp": "00:15:54", "text": "拥有"}, {"type": "subtitle", "time": 957.55, "timestamp": "00:15:57", "text": "onx_b 但我认为我"}]
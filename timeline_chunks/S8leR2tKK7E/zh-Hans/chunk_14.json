[{"type": "subtitle", "time": 841.23, "timestamp": "00:14:01", "text": "呃，三月，哦等等"}, {"type": "subtitle", "time": 845.55, "timestamp": "00:14:05", "text": "今年五月，或者三月，或者"}, {"type": "subtitle", "time": 849.269, "timestamp": "00:14:09", "text": "今年三月或五月发生的某件事"}, {"type": "subtitle", "time": 852.71, "timestamp": "00:14:12", "text": "我当时就想，“哦，天哪，我要取名字了。”"}, {"type": "subtitle", "time": 856.15, "timestamp": "00:14:16", "text": "回来了。”我真的讨厌有乔克尼克斯"}, {"type": "subtitle", "time": 860.47, "timestamp": "00:14:20", "text": "并在我的名字下方加下划线。所以我等了。"}, {"type": "subtitle", "time": 862.43, "timestamp": "00:14:22", "text": "等啊等"}, {"type": "subtitle", "time": 866.31, "timestamp": "00:14:26", "text": "最后我终于找回了我的"}, {"type": "subtitle", "time": 870.069, "timestamp": "00:14:30", "text": "首先，第一个用户名就是我的名字"}, {"type": "subtitle", "time": 872.189, "timestamp": "00:14:32", "text": "我制作了"}, {"type": "subtitle", "time": 875.829, "timestamp": "00:14:35", "text": "嗯，Twitch 上第一个点赞"}, {"type": "subtitle", "time": 878.389, "timestamp": "00:14:38", "text": "接下来第一个名字和 Jo 很像。或者"}, {"type": "subtitle", "time": 882.87, "timestamp": "00:14:42", "text": "问答 X. 是的，我二月份收到的。等待，"}, {"type": "subtitle", "time": 885.35, "timestamp": "00:14:45", "text": "是二月份吗？我认为是三月或"}, {"type": "subtitle", "time": 886.87, "timestamp": "00:14:46", "text": "某物。三月或五月之类的。"}, {"type": "subtitle", "time": 890.269, "timestamp": "00:14:50", "text": "是的，那样的话，如果是四次的话。"}, {"type": "subtitle", "time": 893.11, "timestamp": "00:14:53", "text": "或者我对此无能为力……"}]
[{"type": "subtitle", "time": 18902.948, "timestamp": "05:15:02", "text": "实际上还有更多东西"}, {"type": "subtitle", "time": 18907.948, "timestamp": "05:15:07", "text": "还有更多东西呢。是的，"}, {"type": "subtitle", "time": 18915.99, "timestamp": "05:15:15", "text": "框架。我不知道。我进去后超级"}, {"type": "subtitle", "time": 18917.55, "timestamp": "05:15:17", "text": "研磨"}, {"type": "subtitle", "time": 18927.55, "timestamp": "05:15:27", "text": "是的，所以，呃，在研究中"}, {"type": "subtitle", "time": 18931.19, "timestamp": "05:15:31", "text": "实验室里我只需要做武器相关的部分。"}, {"type": "subtitle", "time": 18933.15, "timestamp": "05:15:33", "text": "我相信。"}, {"type": "subtitle", "time": 18938.11, "timestamp": "05:15:38", "text": "武器。是的，我只需要这个。"}, {"type": "subtitle", "time": 18940.27, "timestamp": "05:15:40", "text": "嗯"}, {"type": "subtitle", "time": 18942.83, "timestamp": "05:15:42", "text": "粘合剂"}, {"type": "subtitle", "time": 18946.59, "timestamp": "05:15:46", "text": "还有润滑剂，呃"}, {"type": "subtitle", "time": 18949.35, "timestamp": "05:15:49", "text": "铀矿。好的，这些东西。所以，我们将"}, {"type": "subtitle", "time": 18952.03, "timestamp": "05:15:52", "text": "买下这个，然后把它完成。"}, {"type": "subtitle", "time": 18954.47, "timestamp": "05:15:54", "text": "好的，接下来我们继续讨论一些内容。"}, {"type": "subtitle", "time": 18957.19, "timestamp": "05:15:57", "text": "别的地方。好吧，那我该怎么办？"}, {"type": "subtitle", "time": 18959.19, "timestamp": "05:15:59", "text": "当然，你会说骑师。"}]
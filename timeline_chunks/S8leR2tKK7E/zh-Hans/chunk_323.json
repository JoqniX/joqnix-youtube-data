[{"type": "subtitle", "time": 19382.708, "timestamp": "05:23:02", "text": "头脑。好的，我需要去土星。"}, {"type": "subtitle", "time": 19385.708, "timestamp": "05:23:05", "text": "土星在哪里？灵魂系统"}, {"type": "subtitle", "time": 19389.27, "timestamp": "05:23:09", "text": "正确的？灵魂和设定那个呃泰坦。那里"}, {"type": "subtitle", "time": 19390.35, "timestamp": "05:23:10", "text": "你"}, {"type": "subtitle", "time": 19394.15, "timestamp": "05:23:14", "text": "是。为什么我在这里会设立一个前哨站？"}, {"type": "subtitle", "time": 19397.15, "timestamp": "05:23:17", "text": "嗯？好的。"}, {"type": "subtitle", "time": 19408.67, "timestamp": "05:23:28", "text": "[音乐]"}, {"type": "subtitle", "time": 19412.31, "timestamp": "05:23:32", "text": "那里。 P."}, {"type": "subtitle", "time": 19414.31, "timestamp": "05:23:34", "text": "我们将深入探讨造船方面的内容。"}, {"type": "subtitle", "time": 19416.628, "timestamp": "05:23:36", "text": "将来会，但我现在不会这么做。"}, {"type": "subtitle", "time": 19419.99, "timestamp": "05:23:39", "text": "流水车。我想在以下方面取得进展"}, {"type": "subtitle", "time": 19422.628, "timestamp": "05:23:42", "text": "今天的故事。保持您当前的"}, {"type": "subtitle", "time": 19431.27, "timestamp": "05:23:51", "text": "扫描完成。你降落在新"}, {"type": "subtitle", "time": 19434.19, "timestamp": "05:23:54", "text": "家园。您好，非常感谢"}, {"type": "subtitle", "time": 19437.788, "timestamp": "05:23:57", "text": "很多。我将降落在新的地方"}]
[{"type": "subtitle", "time": 5581.75, "timestamp": "01:33:01", "text": "呃，甚至还向我推荐了这部剧，呃……"}, {"type": "subtitle", "time": 5585.35, "timestamp": "01:33:05", "text": "他读书的学校等等。"}, {"type": "subtitle", "time": 5588.11, "timestamp": "01:33:08", "text": "他学习的语言学校和"}, {"type": "subtitle", "time": 5592.39, "timestamp": "01:33:12", "text": "因为那段时间我正在参加一些活动。"}, {"type": "subtitle", "time": 5596.629, "timestamp": "01:33:16", "text": "之前在这里上的日语学习课程"}, {"type": "subtitle", "time": 5599.83, "timestamp": "01:33:19", "text": "然后我谈到了那次采访。"}, {"type": "subtitle", "time": 5602.229, "timestamp": "01:33:22", "text": "与语言学校合作，而且是"}, {"type": "subtitle", "time": 5604.75, "timestamp": "01:33:24", "text": "比如你不需要的面试"}, {"type": "subtitle", "time": 5607.99, "timestamp": "01:33:27", "text": "面试的时候我不知道你可以直接……"}, {"type": "subtitle", "time": 5610.51, "timestamp": "01:33:30", "text": "我不知道你可以简单地"}, {"type": "subtitle", "time": 5613.75, "timestamp": "01:33:33", "text": "申请，因此"}, {"type": "subtitle", "time": 5615.59, "timestamp": "01:33:35", "text": "难道不是这样吗？首先你申请。"}, {"type": "subtitle", "time": 5618.229, "timestamp": "01:33:38", "text": "然后你会接到面试通知。"}, {"type": "subtitle", "time": 5620.95, "timestamp": "01:33:40", "text": "是的，但我觉得我的情况不一样。"}, {"type": "subtitle", "time": 5625.189, "timestamp": "01:33:45", "text": "就像当地的学院一样。他们只是给了"}, {"type": "subtitle", "time": 5628.629, "timestamp": "01:33:48", "text": "我的文件已提交给学校。学校"}, {"type": "subtitle", "time": 5630.07, "timestamp": "01:33:50", "text": "去看看，他们会说：“是啊，"}, {"type": "subtitle", "time": 5632.79, "timestamp": "01:33:52", "text": "我们安排一次面试吧。"}, {"type": "subtitle", "time": 5637.149, "timestamp": "01:33:57", "text": "这个学生，一个孩子，表现如何？"}]
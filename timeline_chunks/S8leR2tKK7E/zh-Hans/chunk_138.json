[{"type": "subtitle", "time": 8280.709, "timestamp": "02:18:00", "text": "虽然有人为它众筹，但我当时想的是，"}, {"type": "subtitle", "time": 8284.389, "timestamp": "02:18:04", "text": "我真的有资格使用这个新玩意儿吗？"}, {"type": "subtitle", "time": 8289.03, "timestamp": "02:18:09", "text": "笨蛋设计？它太……太……呃……在它的"}, {"type": "subtitle", "time": 8293.19, "timestamp": "02:18:13", "text": "你知道，这是我自己的联赛，我觉得……"}, {"type": "subtitle", "time": 8297.03, "timestamp": "02:18:17", "text": "由于我的不专业，还有呃……"}, {"type": "subtitle", "time": 8300.03, "timestamp": "02:18:20", "text": "我做的那些蠢事，我感觉"}, {"type": "subtitle", "time": 8303.15, "timestamp": "02:18:23", "text": "就像它可能一样"}, {"type": "subtitle", "time": 8305.83, "timestamp": "02:18:25", "text": "专业的。我不知道。"}, {"type": "subtitle", "time": 8312.95, "timestamp": "02:18:32", "text": "我不知道。但是，是的，但是，但是你可以"}, {"type": "subtitle", "time": 8315.75, "timestamp": "02:18:35", "text": "感觉好像会有一套"}, {"type": "subtitle", "time": 8318.709, "timestamp": "02:18:38", "text": "人们的期望清单"}, {"type": "subtitle", "time": 8321.15, "timestamp": "02:18:41", "text": "当他们看到"}, {"type": "subtitle", "time": 8326.389, "timestamp": "02:18:46", "text": "无论是内容方面还是"}, {"type": "subtitle", "time": 8329.509, "timestamp": "02:18:49", "text": "呃，从美学角度来看，流媒体元素"}, {"type": "subtitle", "time": 8333.309, "timestamp": "02:18:53", "text": "一切都对吧？背景介绍"}, {"type": "subtitle", "time": 8336.549, "timestamp": "02:18:56", "text": "事物。我心想，兄弟，我该怎么抢劫？"}, {"type": "subtitle", "time": 8339.509, "timestamp": "02:18:59", "text": "银行？"}]
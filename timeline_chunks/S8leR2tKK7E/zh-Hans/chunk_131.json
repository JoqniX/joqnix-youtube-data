[{"type": "subtitle", "time": 7862.55, "timestamp": "02:11:02", "text": "我不相信你，因为我……"}, {"type": "subtitle", "time": 7865.27, "timestamp": "02:11:05", "text": "目前我也在做同样的事情。但我"}, {"type": "subtitle", "time": 7868.55, "timestamp": "02:11:08", "text": "我觉得更像是这样，但其实不是，我不会。"}, {"type": "subtitle", "time": 7870.069, "timestamp": "02:11:10", "text": "把它看作是错失良机吧。我感觉"}, {"type": "subtitle", "time": 7871.51, "timestamp": "02:11:11", "text": "就像这是一个机会一样"}, {"type": "subtitle", "time": 7874.39, "timestamp": "02:11:14", "text": "它会到达，而且应该到达。我觉得你得到了"}, {"type": "subtitle", "time": 7877.109, "timestamp": "02:11:17", "text": "就像很多绝佳的机会一样"}, {"type": "subtitle", "time": 7880.56, "timestamp": "02:11:20", "text": "祝你未来取得胜利，我希望你能做到。"}, {"type": "subtitle", "time": 7894.95, "timestamp": "02:11:34", "text": "嗯，这个视频里的情况怎么样？"}, {"type": "subtitle", "time": 7896.87, "timestamp": "02:11:36", "text": "空间？你喜欢吗？你喜欢"}, {"type": "subtitle", "time": 7898.629, "timestamp": "02:11:38", "text": "是的。"}, {"type": "subtitle", "time": 7901.75, "timestamp": "02:11:41", "text": "是的，我想我确实挺喜欢的。我喜欢"}, {"type": "subtitle", "time": 7903.75, "timestamp": "02:11:43", "text": "交到了非常像我的朋友"}, {"type": "subtitle", "time": 7905.669, "timestamp": "02:11:45", "text": "有趣的人，而且他们也像"}, {"type": "subtitle", "time": 7908.229, "timestamp": "02:11:48", "text": "和他们一起玩真的很有趣。"}, {"type": "subtitle", "time": 7910.709, "timestamp": "02:11:50", "text": "和别人一起玩游戏，但你没有"}, {"type": "subtitle", "time": 7912.709, "timestamp": "02:11:52", "text": "不要过分担心自己的表现。"}, {"type": "subtitle", "time": 7913.99, "timestamp": "02:11:53", "text": "你自己，因为他们所有人也都是如此。"}, {"type": "subtitle", "time": 7916.51, "timestamp": "02:11:56", "text": "YouTuber 或主播，所以他们"}, {"type": "subtitle", "time": 7918.79, "timestamp": "02:11:58", "text": "理解它不像是一种"}]
[{"type": "subtitle", "time": 1981.19, "timestamp": "00:33:01", "text": "有时晚上会害怕。所以她"}, {"type": "subtitle", "time": 1984.269, "timestamp": "00:33:04", "text": "她想让我和她一起睡。"}, {"type": "subtitle", "time": 1990.07, "timestamp": "00:33:10", "text": "今天。所以，是的，我想我可能会"}, {"type": "subtitle", "time": 1993.59, "timestamp": "00:33:13", "text": "今晚好好睡一觉。我不知道。但是"}, {"type": "subtitle", "time": 1994.95, "timestamp": "00:33:14", "text": "说实话，我一直在努力"}, {"type": "subtitle", "time": 1998.389, "timestamp": "00:33:18", "text": "睡眠，调整我的睡眠时间表，就像……"}, {"type": "subtitle", "time": 2001.83, "timestamp": "00:33:21", "text": "过去几天。但我并不觉得"}, {"type": "subtitle", "time": 2004.149, "timestamp": "00:33:24", "text": "比如如果我"}, {"type": "subtitle", "time": 2008.99, "timestamp": "00:33:28", "text": "呃，如果我知道我是在12点还是10点睡觉的话。"}, {"type": "subtitle", "time": 2012.87, "timestamp": "00:33:32", "text": "11 我会睁大眼睛，坦诚相待，就像"}, {"type": "subtitle", "time": 2016.509, "timestamp": "00:33:36", "text": "整夜直到早上6点"}, {"type": "subtitle", "time": 2019.63, "timestamp": "00:33:39", "text": "上午。我希望这种情况不会发生。"}, {"type": "subtitle", "time": 2022.23, "timestamp": "00:33:42", "text": "今晚我想改善睡眠。"}, {"type": "subtitle", "time": 2025.02, "timestamp": "00:33:45", "text": "安排好时间"}, {"type": "subtitle", "time": 2026.509, "timestamp": "00:33:46", "text": "[音乐]"}, {"type": "subtitle", "time": 2029.19, "timestamp": "00:33:49", "text": "坏的。我明白了。我妈妈也是"}, {"type": "subtitle", "time": 2036.31, "timestamp": "00:33:56", "text": "尽管。我妈妈喜欢向别人炫耀我。她是一个"}]
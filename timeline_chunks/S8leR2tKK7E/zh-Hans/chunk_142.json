[{"type": "subtitle", "time": 8520.15, "timestamp": "02:22:00", "text": "测试子程序，而非测试对象"}, {"type": "subtitle", "time": 8522.63, "timestamp": "02:22:02", "text": "就像现在要踏上一段旅程，看看会发生什么"}, {"type": "subtitle", "time": 8525.03, "timestamp": "02:22:05", "text": "人们对此的反应可能和我一样。"}, {"type": "subtitle", "time": 8527.429, "timestamp": "02:22:07", "text": "现在过度思考可能会变成"}, {"type": "subtitle", "time": 8529.11, "timestamp": "02:22:09", "text": "现实"}, {"type": "subtitle", "time": 8532.15, "timestamp": "02:22:12", "text": "而且，嗯，也会有人会"}, {"type": "subtitle", "time": 8534.95, "timestamp": "02:22:14", "text": "表示支持，即愿意……"}, {"type": "subtitle", "time": 8538.15, "timestamp": "02:22:18", "text": "等我攒够钱再给他们"}, {"type": "subtitle", "time": 8541.51, "timestamp": "02:22:21", "text": "是一些新东西之类的，对吧？作为"}, {"type": "subtitle", "time": 8543.99, "timestamp": "02:22:23", "text": "就像 L 视频里那些东西一样，对吧？"}, {"type": "subtitle", "time": 8545.55, "timestamp": "02:22:25", "text": "那些是"}, {"type": "subtitle", "time": 8549.03, "timestamp": "02:22:29", "text": "昂贵的。我的天哪，这简直太像了"}, {"type": "subtitle", "time": 8552.87, "timestamp": "02:22:32", "text": "总体来说价格昂贵。是的，"}, {"type": "subtitle", "time": 8556.23, "timestamp": "02:22:36", "text": "我认为，我的意思是，这是有效的。"}, {"type": "subtitle", "time": 8559.59, "timestamp": "02:22:39", "text": "担忧，但就像它是什么一样"}, {"type": "subtitle", "time": 8562.15, "timestamp": "02:22:42", "text": "对遥远未来的可能性及其"}, {"type": "subtitle", "time": 8565.389, "timestamp": "02:22:45", "text": "这件事可能根本没发生过。"}, {"type": "subtitle", "time": 8568.07, "timestamp": "02:22:48", "text": "所以最好珍惜一切。"}, {"type": "subtitle", "time": 8570.95, "timestamp": "02:22:50", "text": "你现在拥有的就是这些。是的。而不是"}, {"type": "subtitle", "time": 8573.67, "timestamp": "02:22:53", "text": "总是想着自己没有的东西。"}]
[{"type": "subtitle", "time": 7323.43, "timestamp": "02:02:03", "text": "我觉得这太疯狂了。我认为一个"}, {"type": "subtitle", "time": 7325.91, "timestamp": "02:02:05", "text": "很多人确实需要认清现实。"}, {"type": "subtitle", "time": 7328.709, "timestamp": "02:02:08", "text": "也包括像我这样偶尔会这样做的人"}, {"type": "subtitle", "time": 7331.91, "timestamp": "02:02:11", "text": "就像你知道的那样，让我们​​所有人都保持理智。"}, {"type": "subtitle", "time": 7333.79, "timestamp": "02:02:13", "text": "是的，就是这样。"}, {"type": "subtitle", "time": 7335.87, "timestamp": "02:02:15", "text": "真的。所以"}, {"type": "subtitle", "time": 7339.35, "timestamp": "02:02:19", "text": "那我……我不知道该如何跟上……"}, {"type": "subtitle", "time": 7341.95, "timestamp": "02:02:21", "text": "你是否曾经有过这样的感觉？"}, {"type": "subtitle", "time": 7345.75, "timestamp": "02:02:25", "text": "太慢了或者感觉你不是"}, {"type": "subtitle", "time": 7348.39, "timestamp": "02:02:28", "text": "赶上其他人了吗？其他人正在前往"}, {"type": "subtitle", "time": 7350.709, "timestamp": "02:02:30", "text": "快点。"}, {"type": "subtitle", "time": 7353.03, "timestamp": "02:02:33", "text": "是的，我也有过那种感觉。"}, {"type": "subtitle", "time": 7356.07, "timestamp": "02:02:36", "text": "很久以前，但我有这个"}, {"type": "subtitle", "time": 7358.709, "timestamp": "02:02:38", "text": "我有一种倾向，比如我不……好吧，我就是那种人"}, {"type": "subtitle", "time": 7361.99, "timestamp": "02:02:41", "text": "一个不嫉妒的人"}, {"type": "subtitle", "time": 7363.669, "timestamp": "02:02:43", "text": "我觉得这很奇怪，但是……"}, {"type": "subtitle", "time": 7367.109, "timestamp": "02:02:47", "text": "感觉自己好像不嫉妒，但是当"}, {"type": "subtitle", "time": 7369.03, "timestamp": "02:02:49", "text": "我感觉被冷落了，诸如此类的事情。"}, {"type": "subtitle", "time": 7372.47, "timestamp": "02:02:52", "text": "要知道，就像你知道的那样，我经常尝试"}, {"type": "subtitle", "time": 7375.189, "timestamp": "02:02:55", "text": "就像你知道的，重新调整我的关注点是什么"}, {"type": "subtitle", "time": 7377.589, "timestamp": "02:02:57", "text": "我正在努力规划我的人生，以及其中的一部分……"}, {"type": "subtitle", "time": 7379.51, "timestamp": "02:02:59", "text": "他们正处于人生之中，他们可能"}]
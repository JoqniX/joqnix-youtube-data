[{"type": "subtitle", "time": 19621.67, "timestamp": "05:27:01", "text": "是的，我一直在等你。欢迎"}, {"type": "subtitle", "time": 19623.91, "timestamp": "05:27:03", "text": "到我的小店来。您正在访问新"}, {"type": "subtitle", "time": 19626.15, "timestamp": "05:27:06", "text": "第一次在霍姆斯特德定居？是的，就是这样"}, {"type": "subtitle", "time": 19628.23, "timestamp": "05:27:08", "text": "这是我第一次。好的。你知道，就是"}, {"type": "subtitle", "time": 19629.67, "timestamp": "05:27:09", "text": "很高兴见到大家"}, {"type": "subtitle", "time": 19632.55, "timestamp": "05:27:12", "text": "来自其他世界或太空。我不"}, {"type": "subtitle", "time": 19635.67, "timestamp": "05:27:15", "text": "法官。好的。我很乐意帮你找到"}, {"type": "subtitle", "time": 19637.35, "timestamp": "05:27:17", "text": "你想买什么，或者拿一个"}, {"type": "subtitle", "time": 19638.708, "timestamp": "05:27:18", "text": "看看你想卖什么。"}, {"type": "subtitle", "time": 19641.75, "timestamp": "05:27:21", "text": "这里欢迎各种形式的交易。"}, {"type": "subtitle", "time": 19643.27, "timestamp": "05:27:23", "text": "关于这方面，您还有什么问题要问我吗？"}, {"type": "subtitle", "time": 19645.67, "timestamp": "05:27:25", "text": "商店、商品，甚至只是新的"}, {"type": "subtitle", "time": 19647.43, "timestamp": "05:27:27", "text": "一般而言，就是家园生活。我很乐意帮忙。"}, {"type": "subtitle", "time": 19650.31, "timestamp": "05:27:30", "text": "你。"}, {"type": "subtitle", "time": 19653.99, "timestamp": "05:27:33", "text": "我看看。当然可以。我也是"}, {"type": "subtitle", "time": 19655.11, "timestamp": "05:27:35", "text": "如果您有兴趣购买，请联系我。"}, {"type": "subtitle", "time": 19657.23, "timestamp": "05:27:37", "text": "任何事物"}, {"type": "subtitle", "time": 19660.788, "timestamp": "05:27:40", "text": "这段音频。你听到了吗？不。"}, {"type": "subtitle", "time": 19669.31, "timestamp": "05:27:49", "text": "好的。所以，我们将要做的是……"}, {"type": "subtitle", "time": 19672.948, "timestamp": "05:27:52", "text": "因为真的把所有的粘合剂都买光了。"}, {"type": "subtitle", "time": 19675.788, "timestamp": "05:27:55", "text": "简直是把他的一切都买下来了。"}]
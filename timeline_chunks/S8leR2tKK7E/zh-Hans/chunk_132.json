[{"type": "subtitle", "time": 7920.069, "timestamp": "02:12:00", "text": "你必须付出的友谊"}, {"type": "subtitle", "time": 7921.91, "timestamp": "02:12:01", "text": "因为你不需要喜欢"}, {"type": "subtitle", "time": 7923.35, "timestamp": "02:12:03", "text": "全身心投入你的个人生活"}, {"type": "subtitle", "time": 7926.03, "timestamp": "02:12:06", "text": "也投入其中，这可能会有点"}, {"type": "subtitle", "time": 7928.55, "timestamp": "02:12:08", "text": "累死了。你可以在华盛顿特区加入。"}, {"type": "subtitle", "time": 7931.51, "timestamp": "02:12:11", "text": "随时都可以，玩几局游戏，开开玩笑。"}, {"type": "subtitle", "time": 7935.79, "timestamp": "02:12:15", "text": "就像你知道的，暂停某人……"}, {"type": "subtitle", "time": 7938.47, "timestamp": "02:12:18", "text": "所以这就是我为什么说它非常"}, {"type": "subtitle", "time": 7942.75, "timestamp": "02:12:22", "text": "[音乐]"}, {"type": "subtitle", "time": 7950.149, "timestamp": "02:12:30", "text": "你有没有想过想要……"}, {"type": "subtitle", "time": 7952.55, "timestamp": "02:12:32", "text": "做些事情来为此做出贡献。"}, {"type": "subtitle", "time": 7955.83, "timestamp": "02:12:35", "text": "社区或其他可以帮助他人的事物"}, {"type": "subtitle", "time": 7960.31, "timestamp": "02:12:40", "text": "还有其他新人吗？"}, {"type": "subtitle", "time": 7962.629, "timestamp": "02:12:42", "text": "我觉得在某个时候我真的"}, {"type": "subtitle", "time": 7965.27, "timestamp": "02:12:45", "text": "想成为我真的很想成为的人"}, {"type": "subtitle", "time": 7968.149, "timestamp": "02:12:48", "text": "那里是给新来的，然后就像什么"}, {"type": "subtitle", "time": 7971.55, "timestamp": "02:12:51", "text": "我该说有点像吗？"}, {"type": "subtitle", "time": 7974.069, "timestamp": "02:12:54", "text": "他们可以联系的人"}, {"type": "subtitle", "time": 7977.75, "timestamp": "02:12:57", "text": "指导和建议，但不多"}]
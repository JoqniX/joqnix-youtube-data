[{"type": "subtitle", "time": 6302.27, "timestamp": "01:45:02", "text": "既有趣又能了解他们，这就足够了。"}, {"type": "subtitle", "time": 6305.51, "timestamp": "01:45:05", "text": "它。现在这更像是一段有趣的旅程。"}, {"type": "subtitle", "time": 6307.43, "timestamp": "01:45:07", "text": "而不是看到一切都充满竞争或"}, {"type": "subtitle", "time": 6309.709, "timestamp": "01:45:09", "text": "任何事物。"}, {"type": "subtitle", "time": 6312.55, "timestamp": "01:45:12", "text": "也许我感觉就像，呃，什么人"}, {"type": "subtitle", "time": 6316.39, "timestamp": "01:45:16", "text": "这件事启发了我，让我想要……"}, {"type": "subtitle", "time": 6318.149, "timestamp": "01:45:18", "text": "这样而不是害怕"}, {"type": "subtitle", "time": 6321.51, "timestamp": "01:45:21", "text": "向人们寻求合作等等"}, {"type": "subtitle", "time": 6324.229, "timestamp": "01:45:24", "text": "我想我碰巧看到了一些"}, {"type": "subtitle", "time": 6325.75, "timestamp": "01:45:25", "text": "穿过"}, {"type": "subtitle", "time": 6329.99, "timestamp": "01:45:29", "text": "呃，卢修斯·梅里韦瑟的呃，就像射击一样"}, {"type": "subtitle", "time": 6332.31, "timestamp": "01:45:32", "text": "关于这件事，或者拍摄视频或直播。"}, {"type": "subtitle", "time": 6335.669, "timestamp": "01:45:35", "text": "他在那里谈到了"}, {"type": "subtitle", "time": 6340.629, "timestamp": "01:45:40", "text": "嗯，你知道，嗯，他想……"}, {"type": "subtitle", "time": 6343.43, "timestamp": "01:45:43", "text": "他可以和任何人合作，无论他喜欢与谁合作，或者他与任何人合作。"}, {"type": "subtitle", "time": 6347.109, "timestamp": "01:45:47", "text": "他想要的，即使是即使是新冠病毒感染者。"}, {"type": "subtitle", "time": 6350.629, "timestamp": "01:45:50", "text": "或者说，他需要独立完成这件事。"}, {"type": "subtitle", "time": 6353.27, "timestamp": "01:45:53", "text": "先得到数字，也就是，也就是"}, {"type": "subtitle", "time": 6356.149, "timestamp": "01:45:56", "text": "显然，这其中一件至关重要的事是……"}, {"type": "subtitle", "time": 6358.59, "timestamp": "01:45:58", "text": "工业空间右侧管道和"}]
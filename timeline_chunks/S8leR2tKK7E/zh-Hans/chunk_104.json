[{"type": "subtitle", "time": 6241.87, "timestamp": "01:44:01", "text": "生命非常长久。"}, {"type": "subtitle", "time": 6245.99, "timestamp": "01:44:05", "text": "当然，就像人们非常"}, {"type": "subtitle", "time": 6248.709, "timestamp": "01:44:08", "text": "怎么说呢，他们有自己的"}, {"type": "subtitle", "time": 6251.149, "timestamp": "01:44:11", "text": "个体的生活。所以我们不知道"}, {"type": "subtitle", "time": 6254.07, "timestamp": "01:44:14", "text": "情况也是如此。"}, {"type": "subtitle", "time": 6256.87, "timestamp": "01:44:16", "text": "所以我认为这仍然需要很多……"}, {"type": "subtitle", "time": 6259.35, "timestamp": "01:44:19", "text": "要有勇气走到别人面前问问题"}, {"type": "subtitle", "time": 6261.59, "timestamp": "01:44:21", "text": "他们总体上是为了合作而来的。"}, {"type": "subtitle", "time": 6265.149, "timestamp": "01:44:25", "text": "因为我性格很害羞。我变得如此"}, {"type": "subtitle", "time": 6268.55, "timestamp": "01:44:28", "text": "有点害怕，但感觉太不可思议了。"}, {"type": "subtitle", "time": 6270.55, "timestamp": "01:44:30", "text": "你正在这样做。我认为很多"}, {"type": "subtitle", "time": 6272.55, "timestamp": "01:44:32", "text": "人们真的很期待喜欢"}, {"type": "subtitle", "time": 6275.75, "timestamp": "01:44:35", "text": "你的客人中有人问：那是什么？"}, {"type": "subtitle", "time": 6283.229, "timestamp": "01:44:43", "text": "所以，"}, {"type": "subtitle", "time": 6285.39, "timestamp": "01:44:45", "text": "它就像是"}, {"type": "subtitle", "time": 6288.95, "timestamp": "01:44:48", "text": "我只是想喜欢"}, {"type": "subtitle", "time": 6291.51, "timestamp": "01:44:51", "text": "嗯，对我来说，我不认为这是一次合作或"}, {"type": "subtitle", "time": 6293.91, "timestamp": "01:44:53", "text": "比如数字之类的东西"}, {"type": "subtitle", "time": 6295.99, "timestamp": "01:44:55", "text": "交易性的或其他什么的。我只想"}, {"type": "subtitle", "time": 6299.27, "timestamp": "01:44:59", "text": "只是和大家一起玩游戏而已。"}]
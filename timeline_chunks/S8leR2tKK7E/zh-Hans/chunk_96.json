[{"type": "subtitle", "time": 5765.51, "timestamp": "01:36:05", "text": "我的意思是，这是我……"}, {"type": "subtitle", "time": 5767.35, "timestamp": "01:36:07", "text": "享受。我想说，我真的很喜欢"}, {"type": "subtitle", "time": 5771.11, "timestamp": "01:36:11", "text": "我是塞拉斯蒂娅，但有时又像我"}, {"type": "subtitle", "time": 5774.629, "timestamp": "01:36:14", "text": "种种原因让我无法直播。"}, {"type": "subtitle", "time": 5777.189, "timestamp": "01:36:17", "text": "我很遗憾，但我知道就像我"}, {"type": "subtitle", "time": 5779.99, "timestamp": "01:36:19", "text": "社区成员们都非常包容。"}, {"type": "subtitle", "time": 5782.47, "timestamp": "01:36:22", "text": "而且感觉真好，每次我来"}, {"type": "subtitle", "time": 5784.229, "timestamp": "01:36:24", "text": "回来后，他们是来欢迎我的。"}, {"type": "subtitle", "time": 5787.669, "timestamp": "01:36:27", "text": "后退。啊。所以，这段时间过得很愉快。"}, {"type": "subtitle", "time": 5790.629, "timestamp": "01:36:30", "text": "经验。一直以来都是这样"}, {"type": "subtitle", "time": 5793.27, "timestamp": "01:36:33", "text": "一段动荡的经历。就像我曾经拥有过我的"}, {"type": "subtitle", "time": 5796.149, "timestamp": "01:36:36", "text": "我经历过高峰，也经历过低谷，而且我还……"}, {"type": "subtitle", "time": 5798.229, "timestamp": "01:36:38", "text": "就像我直播的时候那样"}, {"type": "subtitle", "time": 5800.35, "timestamp": "01:36:40", "text": "比如几个月。"}, {"type": "subtitle", "time": 5802.87, "timestamp": "01:36:42", "text": "即使在我这样的人生中，我也曾如此。"}, {"type": "subtitle", "time": 5804.95, "timestamp": "01:36:44", "text": "通过诸如此类重大而剧烈的变化"}, {"type": "subtitle", "time": 5808.709, "timestamp": "01:36:48", "text": "在过去的4年里。它就像一种"}, {"type": "subtitle", "time": 5810.79, "timestamp": "01:36:50", "text": "想想这很有趣，就像……"}, {"type": "subtitle", "time": 5812.95, "timestamp": "01:36:52", "text": "Celestia一直是其中之一"}, {"type": "subtitle", "time": 5819.75, "timestamp": "01:36:59", "text": "是的，我很高兴你这么想。"}]
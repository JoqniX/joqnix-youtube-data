[{"type": "subtitle", "time": 2046.87, "timestamp": "00:34:06", "text": "baka 修复无辜。修复无辜"}, {"type": "subtitle", "time": 2049.669, "timestamp": "00:34:09", "text": "好好睡一觉，这样我才能……"}, {"type": "subtitle", "time": 2052.51, "timestamp": "00:34:12", "text": "我醒来后精力充沛，工作效率很高。"}, {"type": "subtitle", "time": 2076.589, "timestamp": "00:34:36", "text": "睡眠时间或睡眠"}, {"type": "subtitle", "time": 2079.349, "timestamp": "00:34:39", "text": "期间。我可以做到。我可以做到"}, {"type": "subtitle", "time": 2088.23, "timestamp": "00:34:48", "text": "是的，我妈妈可不是只可怕的猫。"}, {"type": "subtitle", "time": 2089.93, "timestamp": "00:34:49", "text": "她是"}, {"type": "subtitle", "time": 2092.51, "timestamp": "00:34:52", "text": "[音乐]"}, {"type": "subtitle", "time": 2096.389, "timestamp": "00:34:56", "text": "可怕的。所以，嗯，我想我告诉过……"}, {"type": "subtitle", "time": 2099.27, "timestamp": "00:34:59", "text": "我想说的都说了。呃"}]
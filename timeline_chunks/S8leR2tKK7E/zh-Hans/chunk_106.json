[{"type": "subtitle", "time": 6361.27, "timestamp": "01:46:01", "text": "一切，一旦他能够……"}, {"type": "subtitle", "time": 6365.109, "timestamp": "01:46:05", "text": "得到它之后，他就能做到他喜欢做的事。"}, {"type": "subtitle", "time": 6367.83, "timestamp": "01:46:07", "text": "和所有他资助过的人合作，对吧？和"}, {"type": "subtitle", "time": 6370.83, "timestamp": "01:46:10", "text": "甚至还请来了那些根本不是YouTube博主的人。"}, {"type": "subtitle", "time": 6372.51, "timestamp": "01:46:12", "text": "流媒体"}, {"type": "subtitle", "time": 6376.87, "timestamp": "01:46:16", "text": "是的，甚至回到了BTubers身上，"}, {"type": "subtitle", "time": 6379.95, "timestamp": "01:46:19", "text": "没有回传到流媒体平台"}, {"type": "subtitle", "time": 6382.83, "timestamp": "01:46:22", "text": "比如帮助他们"}, {"type": "subtitle", "time": 6385.43, "timestamp": "01:46:25", "text": "比如多做一些内容等等。"}, {"type": "subtitle", "time": 6389.189, "timestamp": "01:46:29", "text": "甚至包括机构成员。当我看着"}, {"type": "subtitle", "time": 6391.87, "timestamp": "01:46:31", "text": "是的，这就是我的灵感来源。"}, {"type": "subtitle", "time": 6394.87, "timestamp": "01:46:34", "text": "最初。我也想那样做，因为"}, {"type": "subtitle", "time": 6396.07, "timestamp": "01:46:36", "text": "为什么不呢？"}, {"type": "subtitle", "time": 6399.03, "timestamp": "01:46:39", "text": "和人交谈很有趣，而且……"}, {"type": "subtitle", "time": 6399.79, "timestamp": "01:46:39", "text": "知道"}, {"type": "subtitle", "time": 6403.99, "timestamp": "01:46:43", "text": "他们，还有，也互相帮助。"}, {"type": "subtitle", "time": 6405.83, "timestamp": "01:46:45", "text": "以及所有的一切。"}, {"type": "subtitle", "time": 6407.709, "timestamp": "01:46:47", "text": "我仔细思考了一番。"}, {"type": "subtitle", "time": 6412.39, "timestamp": "01:46:52", "text": "乔森，我觉得……嗯，只有我一个人……"}, {"type": "subtitle", "time": 6414.47, "timestamp": "01:46:54", "text": "原本只打算和少数人合作。"}, {"type": "subtitle", "time": 6417.91, "timestamp": "01:46:57", "text": "然后我的固执就显露出来了。我是"}]
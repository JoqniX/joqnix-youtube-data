[{"type": "subtitle", "time": 3843.589, "timestamp": "01:04:03", "text": "像 OBS 云服务器一样运行并放置"}, {"type": "subtitle", "time": 3845.99, "timestamp": "01:04:05", "text": "哦，等等。对，就把东西放上去。"}, {"type": "subtitle", "time": 3849.549, "timestamp": "01:04:09", "text": "有。哦，等等。那会怎样呢？"}, {"type": "subtitle", "time": 3852.15, "timestamp": "01:04:12", "text": "工作？哦，我可能得买下它"}, {"type": "subtitle", "time": 3855.43, "timestamp": "01:04:15", "text": "贵的。 1000美元的那款。哦，那是"}, {"type": "subtitle", "time": 3857.27, "timestamp": "01:04:17", "text": "太多了。我没有钱。"}, {"type": "subtitle", "time": 3859.349, "timestamp": "01:04:19", "text": "不，但也不要太在意。我"}, {"type": "subtitle", "time": 3862.63, "timestamp": "01:04:22", "text": "我觉得这不是个好主意。"}, {"type": "subtitle", "time": 3864.23, "timestamp": "01:04:24", "text": "我认为当你去一个新的地方时"}, {"type": "subtitle", "time": 3866.15, "timestamp": "01:04:26", "text": "我觉得你应该慢慢来。"}, {"type": "subtitle", "time": 3868.549, "timestamp": "01:04:28", "text": "就像安定下来探索一样"}, {"type": "subtitle", "time": 3871.67, "timestamp": "01:04:31", "text": "在户外，在自己的环境中"}, {"type": "subtitle", "time": 3873.75, "timestamp": "01:04:33", "text": "与其只是花钱，不如先享受一下。"}, {"type": "subtitle", "time": 3876.23, "timestamp": "01:04:36", "text": "在电脑前花费的时间太长了。"}, {"type": "subtitle", "time": 3884.63, "timestamp": "01:04:44", "text": "是的。我怎么会相信你是唯一一个"}, {"type": "subtitle", "time": 3888.549, "timestamp": "01:04:48", "text": "我从所有人那里都认识一个"}, {"type": "subtitle", "time": 3891.43, "timestamp": "01:04:51", "text": "实际上离开了印度，并且作为一名"}, {"type": "subtitle", "time": 3894.95, "timestamp": "01:04:54", "text": "YouTuber之类的，还有呃之类的。如何"}, {"type": "subtitle", "time": 3897.99, "timestamp": "01:04:57", "text": "您搬进去和离开的经历如何？"}, {"type": "subtitle", "time": 3899.589, "timestamp": "01:04:59", "text": "去一个新的国家，一切的一切？"}]
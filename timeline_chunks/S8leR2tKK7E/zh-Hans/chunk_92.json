[{"type": "subtitle", "time": 5520.95, "timestamp": "01:32:00", "text": "缩略图？是扎娜吗？"}, {"type": "subtitle", "time": 5522.79, "timestamp": "01:32:02", "text": "可能是扎娜，但我不太确定。"}, {"type": "subtitle", "time": 5525.31, "timestamp": "01:32:05", "text": "特别记得阿宝曾经出现过"}, {"type": "subtitle", "time": 5528.31, "timestamp": "01:32:08", "text": "溪流。他很神秘，而且他喜欢……"}, {"type": "subtitle", "time": 5530.229, "timestamp": "01:32:10", "text": "就像维持那种神秘秩序一样"}, {"type": "subtitle", "time": 5533.11, "timestamp": "01:32:13", "text": "他周围。"}, {"type": "subtitle", "time": 5535.11, "timestamp": "01:32:15", "text": "是啊，他真是个神秘人物。你"}, {"type": "subtitle", "time": 5537.27, "timestamp": "01:32:17", "text": "还记得我当时像个狂热分子一样吗？"}, {"type": "subtitle", "time": 5543.51, "timestamp": "01:32:23", "text": "我的天啊。"}, {"type": "subtitle", "time": 5547.91, "timestamp": "01:32:27", "text": "我明白。但我认为对我来说就像"}, {"type": "subtitle", "time": 5549.75, "timestamp": "01:32:29", "text": "我一直觉得他就像……"}, {"type": "subtitle", "time": 5552.47, "timestamp": "01:32:32", "text": "像导师一样的人。"}, {"type": "subtitle", "time": 5555.35, "timestamp": "01:32:35", "text": "哦，我还见过他这样"}, {"type": "subtitle", "time": 5558.31, "timestamp": "01:32:38", "text": "从几乎零开始创办公司"}, {"type": "subtitle", "time": 5562.149, "timestamp": "01:32:42", "text": "划痕。是的，"}, {"type": "subtitle", "time": 5565.01, "timestamp": "01:32:45", "text": "男人。真是高智商的事。"}, {"type": "subtitle", "time": 5567.59, "timestamp": "01:32:47", "text": "[音乐]"}, {"type": "subtitle", "time": 5571.669, "timestamp": "01:32:51", "text": "我喜欢保罗，保罗也告诉我"}, {"type": "subtitle", "time": 5574.79, "timestamp": "01:32:54", "text": "他告诉我他去了日本"}, {"type": "subtitle", "time": 5577.669, "timestamp": "01:32:57", "text": "东西，还有"}]
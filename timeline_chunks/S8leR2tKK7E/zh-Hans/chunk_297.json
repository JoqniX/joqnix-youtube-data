[{"type": "subtitle", "time": 17825.43, "timestamp": "04:57:05", "text": "好久没玩星空了。所以"}, {"type": "subtitle", "time": 17828.948, "timestamp": "04:57:08", "text": "我很期待"}, {"type": "subtitle", "time": 17832.15, "timestamp": "04:57:12", "text": "呃，喜欢玩这个游戏。还有你们中的许多人"}, {"type": "subtitle", "time": 17833.99, "timestamp": "04:57:13", "text": "如果你一直……我会很惊讶。"}, {"type": "subtitle", "time": 17836.11, "timestamp": "04:57:16", "text": "关注我。"}, {"type": "subtitle", "time": 17839.868, "timestamp": "04:57:19", "text": "呃，如果你一直关注我的话"}, {"type": "subtitle", "time": 17843.39, "timestamp": "04:57:23", "text": "在最后两股流中"}, {"type": "subtitle", "time": 17847.11, "timestamp": "04:57:27", "text": "星空，我实际上到达了更多的地方"}, {"type": "subtitle", "time": 17851.11, "timestamp": "04:57:31", "text": "超过70、80岁了。我想我超过了80岁。"}, {"type": "subtitle", "time": 17854.19, "timestamp": "04:57:34", "text": "不知道。超过 80，80 级或"}, {"type": "subtitle", "time": 17857.35, "timestamp": "04:57:37", "text": "某物。是的。是的。是的。我到达"}, {"type": "subtitle", "time": 17860.55, "timestamp": "04:57:40", "text": "80级左右。呃，在星空里。"}, {"type": "subtitle", "time": 17861.55, "timestamp": "04:57:41", "text": "我"}, {"type": "subtitle", "time": 17863.07, "timestamp": "04:57:43", "text": "研磨"}, {"type": "subtitle", "time": 17865.91, "timestamp": "04:57:45", "text": "小时。我没有做任何主线任务或"}, {"type": "subtitle", "time": 17868.39, "timestamp": "04:57:48", "text": "我完全是因为想做才去做Sol Quest的。"}, {"type": "subtitle", "time": 17873.51, "timestamp": "04:57:53", "text": "直播中，但我努力赚钱了。"}, {"type": "subtitle", "time": 17875.67, "timestamp": "04:57:55", "text": "刷了那些技能点，那些"}, {"type": "subtitle", "time": 17877.788, "timestamp": "04:57:57", "text": "农用物品，"}, {"type": "subtitle", "time": 17879.948, "timestamp": "04:57:59", "text": "一切。猜测"}]
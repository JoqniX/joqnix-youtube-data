[{"type": "subtitle", "time": 18241.19, "timestamp": "05:04:01", "text": "太好了。"}, {"type": "subtitle", "time": 18261.47, "timestamp": "05:04:21", "text": "是的，无需赘言，我们……"}, {"type": "subtitle", "time": 18263.23, "timestamp": "05:04:23", "text": "哦，是吗？"}, {"type": "subtitle", "time": 18266.948, "timestamp": "05:04:26", "text": "我做了什么吗？等等，为什么会这样？"}, {"type": "subtitle", "time": 18269.91, "timestamp": "05:04:29", "text": "空白的？"}, {"type": "subtitle", "time": 18273.11, "timestamp": "05:04:33", "text": "哦好的。真是吓人。好的。我当时"}, {"type": "subtitle", "time": 18277.708, "timestamp": "05:04:37", "text": "比如，“什么？屏幕怎么变黑了？”嗯？"}, {"type": "subtitle", "time": 18284.788, "timestamp": "05:04:44", "text": "嗯？好的。我快完成了"}, {"type": "subtitle", "time": 18287.788, "timestamp": "05:04:47", "text": "东西。我对此深感抱歉。"}]
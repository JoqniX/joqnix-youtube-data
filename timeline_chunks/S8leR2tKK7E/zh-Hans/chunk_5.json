[{"type": "subtitle", "time": 300.31, "timestamp": "00:05:00", "text": "哦，那是我的可视化工具。好的，一样。"}, {"type": "subtitle", "time": 303.11, "timestamp": "00:05:03", "text": "这首歌又在我这里播放了。你的"}, {"type": "subtitle", "time": 312.31, "timestamp": "00:05:12", "text": "尽管。我的声音就足够了。我是说"}, {"type": "subtitle", "time": 314.87, "timestamp": "00:05:14", "text": "但我认为孤立和自立是"}, {"type": "subtitle", "time": 317.909, "timestamp": "00:05:17", "text": "不同的热身方式就是不同的热身方式。"}, {"type": "subtitle", "time": 321.71, "timestamp": "00:05:21", "text": "发自内心。"}, {"type": "subtitle", "time": 326.39, "timestamp": "00:05:26", "text": "是的。但现在是的。我感觉很温暖，就像……"}, {"type": "subtitle", "time": 329.35, "timestamp": "00:05:29", "text": "我审视着过去的自己和现在的自己。"}, {"type": "subtitle", "time": 333.189, "timestamp": "00:05:33", "text": "现在我就像以前的自己一样，我就是现在的我。"}, {"type": "subtitle", "time": 334.35, "timestamp": "00:05:34", "text": "我感觉"}, {"type": "subtitle", "time": 336.67, "timestamp": "00:05:36", "text": "好温暖"}, {"type": "subtitle", "time": 339.629, "timestamp": "00:05:39", "text": "而且舒适"}, {"type": "subtitle", "time": 344.87, "timestamp": "00:05:44", "text": "和这些人在一起感觉很安全。"}, {"type": "subtitle", "time": 348.55, "timestamp": "00:05:48", "text": "感到安全"}, {"type": "subtitle", "time": 351.71, "timestamp": "00:05:51", "text": "嗯，感觉就像和你一家人在一起一样。"}, {"type": "subtitle", "time": 357.99, "timestamp": "00:05:57", "text": "Onyx帮派的成员们。"}]
[{"type": "subtitle", "time": 5700.95, "timestamp": "01:35:00", "text": "通过。我不知道，有时候你有"}, {"type": "subtitle", "time": 5707.91, "timestamp": "01:35:07", "text": "是啊，因为我记得……"}, {"type": "subtitle", "time": 5710.87, "timestamp": "01:35:10", "text": "我年轻的时候申请过NFT，"}, {"type": "subtitle", "time": 5714.75, "timestamp": "01:35:14", "text": "它好像要清空三轮。"}, {"type": "subtitle", "time": 5717.75, "timestamp": "01:35:17", "text": "我觉得就像如果你清除"}, {"type": "subtitle", "time": 5719.75, "timestamp": "01:35:19", "text": "第二轮你很可能就像"}, {"type": "subtitle", "time": 5720.75, "timestamp": "01:35:20", "text": "什么"}, {"type": "subtitle", "time": 5723.91, "timestamp": "01:35:23", "text": "比如说，他们被分到了第三轮。"}, {"type": "subtitle", "time": 5725.629, "timestamp": "01:35:25", "text": "面试你并给你一个"}, {"type": "subtitle", "time": 5733.03, "timestamp": "01:35:33", "text": "不，我完成了前两轮，但之后我"}, {"type": "subtitle", "time": 5734.79, "timestamp": "01:35:34", "text": "因为……我没去参加面试。"}, {"type": "subtitle", "time": 5736.39, "timestamp": "01:35:36", "text": "虽然当时的情况是这样，但我也觉得"}, {"type": "subtitle", "time": 5739.03, "timestamp": "01:35:39", "text": "那时他已经在攻读学位了。但"}, {"type": "subtitle", "time": 5752.91, "timestamp": "01:35:52", "text": "但我还想问问你，你过得怎么样？"}, {"type": "subtitle", "time": 5756.709, "timestamp": "01:35:56", "text": "你最近玩漂流圈玩得开心吗？它是"}, {"type": "subtitle", "time": 5759.83, "timestamp": "01:35:59", "text": "已经四年了吧？"}]
[{"type": "subtitle", "time": 5461.39, "timestamp": "01:31:01", "text": "你知道他一直都很忙。所以"}, {"type": "subtitle", "time": 5465.75, "timestamp": "01:31:05", "text": "忙碌的。那个笨蛋怎么这么忙？喜欢"}, {"type": "subtitle", "time": 5468.149, "timestamp": "01:31:08", "text": "每天都忙得团团转，我感觉自己就像……"}, {"type": "subtitle", "time": 5471.27, "timestamp": "01:31:11", "text": "你是怎么做到的？"}, {"type": "subtitle", "time": 5473.669, "timestamp": "01:31:13", "text": "我的意思是，大个子男人得……你知道，得……"}, {"type": "subtitle", "time": 5481.55, "timestamp": "01:31:21", "text": "M 所以"}, {"type": "subtitle", "time": 5485.27, "timestamp": "01:31:25", "text": "是的，我甚至想过要弄到钱。"}, {"type": "subtitle", "time": 5487.59, "timestamp": "01:31:27", "text": "这里的东西很多，但我感觉那就是……"}, {"type": "subtitle", "time": 5491.51, "timestamp": "01:31:31", "text": "太多了。我不知道他是否会获得自由。"}, {"type": "subtitle", "time": 5494.39, "timestamp": "01:31:34", "text": "等等，如果像po那样，我会非常生气"}, {"type": "subtitle", "time": 5496.31, "timestamp": "01:31:36", "text": "同意在你的直播间出现"}, {"type": "subtitle", "time": 5499.75, "timestamp": "01:31:39", "text": "任何一位星景成员。"}, {"type": "subtitle", "time": 5503.669, "timestamp": "01:31:43", "text": "等等，但他确实出现在某人的……"}, {"type": "subtitle", "time": 5506.47, "timestamp": "01:31:46", "text": "是直播吗？是谁？我不"}, {"type": "subtitle", "time": 5508.229, "timestamp": "01:31:48", "text": "有人去面试了，对吧？我"}, {"type": "subtitle", "time": 5511.59, "timestamp": "01:31:51", "text": "忘了。等等，是Lumina还是……"}, {"type": "subtitle", "time": 5513.27, "timestamp": "01:31:53", "text": "等等，你不是接受过面试吗？"}, {"type": "subtitle", "time": 5514.79, "timestamp": "01:31:54", "text": "他？"}, {"type": "subtitle", "time": 5517.59, "timestamp": "01:31:57", "text": "蜥蜴人或其他什么东西是谁？"}]
[{"type": "subtitle", "time": 6120.149, "timestamp": "01:42:00", "text": "实际上，我私信别人是个大错误。"}, {"type": "subtitle", "time": 6122.55, "timestamp": "01:42:02", "text": "未经充分调查的人"}, {"type": "subtitle", "time": 6126.31, "timestamp": "01:42:06", "text": "他们。我在信息中说了是"}, {"type": "subtitle", "time": 6127.39, "timestamp": "01:42:07", "text": "对我们来说"}, {"type": "subtitle", "time": 6130.39, "timestamp": "01:42:10", "text": "JPv2 会说英语。他们"}, {"type": "subtitle", "time": 6133.59, "timestamp": "01:42:13", "text": "直播就像是 YouTuber 那种类型的直播"}, {"type": "subtitle", "time": 6136.55, "timestamp": "01:42:16", "text": "我的英语非常流利，而且我当时在……"}, {"type": "subtitle", "time": 6138.629, "timestamp": "01:42:18", "text": "给人的印象是他们正在学习"}, {"type": "subtitle", "time": 6142.27, "timestamp": "01:42:22", "text": "英语，并努力做到最好"}, {"type": "subtitle", "time": 6147.03, "timestamp": "01:42:27", "text": "而且我认为它也可以是"}, {"type": "subtitle", "time": 6149.99, "timestamp": "01:42:29", "text": "以某种方式解释被误解"}, {"type": "subtitle", "time": 6152.669, "timestamp": "01:42:32", "text": "我就像在说你的英语太……"}, {"type": "subtitle", "time": 6156.149, "timestamp": "01:42:36", "text": "低劣之类的东西。那"}, {"type": "subtitle", "time": 6158.31, "timestamp": "01:42:38", "text": "那很糟糕。那很糟糕。我不知道"}, {"type": "subtitle", "time": 6160.229, "timestamp": "01:42:40", "text": "为什么。也许是我多虑了，但是"}, {"type": "subtitle", "time": 6163.59, "timestamp": "01:42:43", "text": "是的，他们确实说过他们做不到。呃，"}, {"type": "subtitle", "time": 6166.07, "timestamp": "01:42:46", "text": "是的，他们确实说过他们做不到。"}, {"type": "subtitle", "time": 6168.95, "timestamp": "01:42:48", "text": "去做。此外，他们的人数也很多。"}, {"type": "subtitle", "time": 6172.79, "timestamp": "01:42:52", "text": "规模也很大，而且他们也很忙。所以，"}, {"type": "subtitle", "time": 6175.669, "timestamp": "01:42:55", "text": "确实有那件事。但我注意到一件事"}, {"type": "subtitle", "time": 6178.629, "timestamp": "01:42:58", "text": "是因为我更……嗯，尽管有"}]
[{"type": "subtitle", "time": 9062.71, "timestamp": "02:31:02", "text": "例如未来几个月的计划"}, {"type": "subtitle", "time": 9064.55, "timestamp": "02:31:04", "text": "因为我只是想表达欣赏之情。"}, {"type": "subtitle", "time": 9066.07, "timestamp": "02:31:06", "text": "无论我得到什么，以及小的"}, {"type": "subtitle", "time": 9068.15, "timestamp": "02:31:08", "text": "生活中的种种"}, {"type": "subtitle", "time": 9068.83, "timestamp": "02:31:08", "text": "所以"}, {"type": "subtitle", "time": 9071.83, "timestamp": "02:31:11", "text": "这真的很耗费精力，而且是成人的。"}, {"type": "subtitle", "time": 9074.15, "timestamp": "02:31:14", "text": "事情有时候真的很难，我"}, {"type": "subtitle", "time": 9077.27, "timestamp": "02:31:17", "text": "感觉就像在度假一样，"}, {"type": "subtitle", "time": 9079.429, "timestamp": "02:31:19", "text": "你知道，我会更关注我的健康和我的"}, {"type": "subtitle", "time": 9082.79, "timestamp": "02:31:22", "text": "关注心理健康，而不是急于求成"}, {"type": "subtitle", "time": 9087.19, "timestamp": "02:31:27", "text": "就像把一件事物和另一件事物联系起来一样。是的。和"}, {"type": "subtitle", "time": 9088.27, "timestamp": "02:31:28", "text": "什么"}, {"type": "subtitle", "time": 9091.99, "timestamp": "02:31:31", "text": "我想从你那里看到的是……"}, {"type": "subtitle", "time": 9094.309, "timestamp": "02:31:34", "text": "音乐，更多音乐相关的东西。你真棒"}, {"type": "subtitle", "time": 9098.55, "timestamp": "02:31:38", "text": "在音乐方面。我的天啊。我确实喜欢拥有一个"}, {"type": "subtitle", "time": 9100.469, "timestamp": "02:31:40", "text": "很多，怎么说呢，真的很有才华。"}, {"type": "subtitle", "time": 9102.469, "timestamp": "02:31:42", "text": "像扎瓦娜这样的人也帮助了我。"}, {"type": "subtitle", "time": 9105.27, "timestamp": "02:31:45", "text": "还有 Luminell，你知道像他们这样的人"}, {"type": "subtitle", "time": 9106.79, "timestamp": "02:31:46", "text": "Mim 和其他喜欢的人"}, {"type": "subtitle", "time": 9110.11, "timestamp": "02:31:50", "text": "非常棒的艺术作品，我喜欢你"}, {"type": "subtitle", "time": 9112.51, "timestamp": "02:31:52", "text": "知道如何让它更"}, {"type": "subtitle", "time": 9115.99, "timestamp": "02:31:55", "text": "神奇，但我努力尝试，我有很多"}]
[{"type": "subtitle", "time": 19688.83, "timestamp": "05:28:08", "text": "这对某些百万富翁来说"}, {"type": "subtitle", "time": 19692.948, "timestamp": "05:28:12", "text": "现在。然后我们确实需要一些……"}, {"type": "subtitle", "time": 19695.51, "timestamp": "05:28:15", "text": "我们的数字化"}, {"type": "subtitle", "time": 19700.948, "timestamp": "05:28:20", "text": "执行太空任务的宇航服。我可以买这个吗？"}, {"type": "subtitle", "time": 19703.03, "timestamp": "05:28:23", "text": "然后从他身上赚钱？我这就去做"}, {"type": "subtitle", "time": 19705.27, "timestamp": "05:28:25", "text": "那。"}, {"type": "subtitle", "time": 19708.15, "timestamp": "05:28:28", "text": "或许我们可以"}, {"type": "subtitle", "time": 19710.948, "timestamp": "05:28:30", "text": "呃，头盔。我直接买下来自己做就行了。"}, {"type": "subtitle", "time": 19712.19, "timestamp": "05:28:32", "text": "优惠"}, {"type": "subtitle", "time": 19714.868, "timestamp": "05:28:34", "text": "他。说实话，那是一个"}, {"type": "subtitle", "time": 19717.19, "timestamp": "05:28:37", "text": "把所有东西都买下来是个糟糕的主意"}, {"type": "subtitle", "time": 19720.07, "timestamp": "05:28:40", "text": "卖掉它们。就像我刚才做的那样，"}, {"type": "subtitle", "time": 19723.51, "timestamp": "05:28:43", "text": "对，是我把所有东西都买齐了，而他有"}, {"type": "subtitle", "time": 19729.43, "timestamp": "05:28:49", "text": "224373 块钱，对吧，在他身上，因为我"}, {"type": "subtitle", "time": 19732.23, "timestamp": "05:28:52", "text": "全部都买了。但我在这里"}, {"type": "subtitle", "time": 19739.868, "timestamp": "05:28:59", "text": "86,524 块钱，对吧？那可就糟了。"}]
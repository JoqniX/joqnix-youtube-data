[{"type": "subtitle", "time": 18121.83, "timestamp": "05:02:01", "text": "庆祝我们的周年纪念日"}, {"type": "subtitle", "time": 18127.67, "timestamp": "05:02:07", "text": "比如，5月20日，5月20日是因为五月"}, {"type": "subtitle", "time": 18130.708, "timestamp": "05:02:10", "text": "28号被认为是我的直播日"}, {"type": "subtitle", "time": 18133.83, "timestamp": "05:02:13", "text": "周年纪念日或者其他什么你可以说的话"}, {"type": "subtitle", "time": 18137.03, "timestamp": "05:02:17", "text": "我喜欢优先考虑我的虚拟主播之路。"}, {"type": "subtitle", "time": 18139.83, "timestamp": "05:02:19", "text": "虽然我更喜欢他而不是那个运动健将。"}, {"type": "subtitle", "time": 18143.75, "timestamp": "05:02:23", "text": "我几乎什么都没做。"}, {"type": "subtitle", "time": 18146.55, "timestamp": "05:02:26", "text": "就是……呃，直播直播直播，就是这样。"}, {"type": "subtitle", "time": 18149.91, "timestamp": "05:02:29", "text": "它。是的，我想优先考虑"}, {"type": "subtitle", "time": 18153.43, "timestamp": "05:02:33", "text": "就像给他们……我其实想……"}, {"type": "subtitle", "time": 18157.628, "timestamp": "05:02:37", "text": "嗯，给我，你知道的"}, {"type": "subtitle", "time": 18161.35, "timestamp": "05:02:41", "text": "自我探索之旅，感受爱。所以这就是我们"}, {"type": "subtitle", "time": 18163.99, "timestamp": "05:02:43", "text": "将于九月发布"}, {"type": "subtitle", "time": 18167.91, "timestamp": "05:02:47", "text": "23日那是我第一次直播"}, {"type": "subtitle", "time": 18172.31, "timestamp": "05:02:52", "text": "呃，用标签直播了"}, {"type": "subtitle", "time": 18176.788, "timestamp": "05:02:56", "text": "标题：有抱负的 YouTuber。所以，呃，我"}]
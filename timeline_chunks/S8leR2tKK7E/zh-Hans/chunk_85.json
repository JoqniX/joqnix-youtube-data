[{"type": "subtitle", "time": 5100.55, "timestamp": "01:25:00", "text": "真是一场很棒的演唱会。我喜欢"}, {"type": "subtitle", "time": 5102.39, "timestamp": "01:25:02", "text": "你的朋友认识我，对吧？那个"}, {"type": "subtitle", "time": 5106.47, "timestamp": "01:25:06", "text": "谁做的？是的，我爱她。惊人的。"}, {"type": "subtitle", "time": 5110.07, "timestamp": "01:25:10", "text": "我，我和Arisa。我们当时就像在风险投资行业一样。"}, {"type": "subtitle", "time": 5113.83, "timestamp": "01:25:13", "text": "很久以前，大概几个月前，我们"}, {"type": "subtitle", "time": 5116.55, "timestamp": "01:25:16", "text": "他们就像在随意聊天，而Mim是"}, {"type": "subtitle", "time": 5118.95, "timestamp": "01:25:18", "text": "既然你们都在这里，而我"}, {"type": "subtitle", "time": 5121.43, "timestamp": "01:25:21", "text": "当时我只听她说话，我想。"}, {"type": "subtitle", "time": 5124.83, "timestamp": "01:25:24", "text": "她当时正在做某事。所以她就走了"}, {"type": "subtitle", "time": 5127.31, "timestamp": "01:25:27", "text": "比如关于辩论"}, {"type": "subtitle", "time": 5130.07, "timestamp": "01:25:30", "text": "我们俩当时正在讨论某件事。"}, {"type": "subtitle", "time": 5133.11, "timestamp": "01:25:33", "text": "一些随机的东西。她接着说，呃……"}, {"type": "subtitle", "time": 5136.31, "timestamp": "01:25:36", "text": "她回来之后就像"}, {"type": "subtitle", "time": 5139.91, "timestamp": "01:25:39", "text": "呃，作为一名法官，我不得不"}, {"type": "subtitle", "time": 5145.03, "timestamp": "01:25:45", "text": "拿出证据，呃，呃，我该怎么做？"}, {"type": "subtitle", "time": 5148.39, "timestamp": "01:25:48", "text": "必须反击，还有其他一些事情。"}, {"type": "subtitle", "time": 5150.709, "timestamp": "01:25:50", "text": "真有趣。"}, {"type": "subtitle", "time": 5152.629, "timestamp": "01:25:52", "text": "太棒了。我的意思是，听起来如此"}, {"type": "subtitle", "time": 5155.03, "timestamp": "01:25:55", "text": "乐趣。我的天啊。你一定有过类似的经历"}]
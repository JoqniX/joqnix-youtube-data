[{"type": "subtitle", "time": 18781.67, "timestamp": "05:13:01", "text": "嗯？是的。我不在家的时候她就睡觉了"}, {"type": "subtitle", "time": 18788.948, "timestamp": "05:13:08", "text": "是的。所以，你实际要做的就是适应"}, {"type": "subtitle", "time": 18791.708, "timestamp": "05:13:11", "text": "装裱。将鼠标悬停"}, {"type": "subtitle", "time": 18799.19, "timestamp": "05:13:19", "text": "这就是我赚钱的方式。这就是我的方式"}, {"type": "subtitle", "time": 18800.67, "timestamp": "05:13:20", "text": "升级"}, {"type": "subtitle", "time": 18803.75, "timestamp": "05:13:23", "text": "快点。是的，这里面有层次。我真的"}, {"type": "subtitle", "time": 18806.35, "timestamp": "05:13:26", "text": "刚刚把那个音效升级了。"}, {"type": "subtitle", "time": 18809.47, "timestamp": "05:13:29", "text": "那里。我升级了。"}, {"type": "subtitle", "time": 18813.75, "timestamp": "05:13:33", "text": "好的。浪漫。是的，有浪漫情调。"}, {"type": "subtitle", "time": 18823.51, "timestamp": "05:13:43", "text": "MPC。你好。就是这样。"}, {"type": "subtitle", "time": 18829.788, "timestamp": "05:13:49", "text": "我很庆幸自己制作了这个宏。第 80 关"}, {"type": "subtitle", "time": 18832.868, "timestamp": "05:13:52", "text": "溪流。所以，呃，正如你所看到的，呃，它"}, {"type": "subtitle", "time": 18834.47, "timestamp": "05:13:54", "text": "看起来和我上次的很不一样。"}, {"type": "subtitle", "time": 18837.91, "timestamp": "05:13:57", "text": "直播吗？我真的解锁了一半"}, {"type": "subtitle", "time": 18839.948, "timestamp": "05:13:59", "text": "的"}]
[{"type": "subtitle", "time": 1861.59, "timestamp": "00:31:01", "text": "嗯。是的。那么，我漏掉了谁吗？我"}, {"type": "subtitle", "time": 1866.51, "timestamp": "00:31:06", "text": "真的，如果我真的漏掉了你们中的任何一位，"}, {"type": "subtitle", "time": 1870.63, "timestamp": "00:31:10", "text": "呃，谁？嗯，我没说话，呃，告诉"}, {"type": "subtitle", "time": 1874.029, "timestamp": "00:31:14", "text": "喊出他们的名字，呼喊他们的名字。"}, {"type": "subtitle", "time": 1877.789, "timestamp": "00:31:17", "text": "呃，还有"}, {"type": "subtitle", "time": 1880.31, "timestamp": "00:31:20", "text": "谢谢你一直关注我，真的非常感谢。"}, {"type": "subtitle", "time": 1884.029, "timestamp": "00:31:24", "text": "真的意义重大。"}, {"type": "subtitle", "time": 1889.389, "timestamp": "00:31:29", "text": "嗯。而且，而且还有所有"}, {"type": "subtitle", "time": 1893.549, "timestamp": "00:31:33", "text": "潜水者，所有潜水的人"}, {"type": "subtitle", "time": 1897.34, "timestamp": "00:31:37", "text": "今天真的真的真的要做一个"}, {"type": "subtitle", "time": 1899.31, "timestamp": "00:31:39", "text": "[音乐]"}, {"type": "subtitle", "time": 1902.63, "timestamp": "00:31:42", "text": "这里出现了两次。阿基亚比，你忘了。不，我"}, {"type": "subtitle", "time": 1907.669, "timestamp": "00:31:47", "text": "确实喊出了阿基亚比的名字。"}, {"type": "subtitle", "time": 1919.23, "timestamp": "00:31:59", "text": "爱德华时代，然后是维克多"}]
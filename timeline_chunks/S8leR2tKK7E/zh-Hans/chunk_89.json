[{"type": "subtitle", "time": 5342.96, "timestamp": "01:29:02", "text": "但现在我觉得我没那么在意了。"}, {"type": "subtitle", "time": 5344.31, "timestamp": "01:29:04", "text": "[音乐]"}, {"type": "subtitle", "time": 5346.55, "timestamp": "01:29:06", "text": "你知道最有趣的事实是什么吗？"}, {"type": "subtitle", "time": 5349.91, "timestamp": "01:29:09", "text": "直播时意外人肉搜索。"}, {"type": "subtitle", "time": 5350.99, "timestamp": "01:29:10", "text": "文本"}, {"type": "subtitle", "time": 5353.99, "timestamp": "01:29:13", "text": "像在直播中支持唐博士一样"}, {"type": "subtitle", "time": 5355.47, "timestamp": "01:29:15", "text": "字面上地"}, {"type": "subtitle", "time": 5360.55, "timestamp": "01:29:20", "text": "大概凌晨12点或1点左右。"}, {"type": "subtitle", "time": 5364.55, "timestamp": "01:29:24", "text": "所以，嗯嗯"}, {"type": "subtitle", "time": 5369.149, "timestamp": "01:29:29", "text": "呃，有个叫……的人，嗯……"}, {"type": "subtitle", "time": 5373.91, "timestamp": "01:29:33", "text": "嗯，是来自马岛的Mitsukishi。所以她是"}, {"type": "subtitle", "time": 5377.669, "timestamp": "01:29:37", "text": "比如，“乔，我不知道。我该怎么混音？”"}, {"type": "subtitle", "time": 5380.87, "timestamp": "01:29:40", "text": "或者剪辑我的YouTube视频，然后点赞"}, {"type": "subtitle", "time": 5383.189, "timestamp": "01:29:43", "text": "把视频片段剪辑到 YouTube 镜头里？不。"}, {"type": "subtitle", "time": 5385.99, "timestamp": "01:29:45", "text": "我当时正在展示这一点，同时还在展示"}, {"type": "subtitle", "time": 5388.07, "timestamp": "01:29:48", "text": "我的手机，就像那种Windows手机一样，"}, {"type": "subtitle", "time": 5390.47, "timestamp": "01:29:50", "text": "直接在电脑上"}, {"type": "subtitle", "time": 5393.229, "timestamp": "01:29:53", "text": "这就是那个应用，YouTube。"}, {"type": "subtitle", "time": 5397.03, "timestamp": "01:29:57", "text": "应用程序。我点击这张卡片编辑按钮后，"}]
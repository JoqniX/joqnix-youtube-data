[{"type": "subtitle", "time": 8460.71, "timestamp": "02:21:00", "text": "社区里人很多"}, {"type": "subtitle", "time": 8463.03, "timestamp": "02:21:03", "text": "比如谁愿意尝试帮忙？"}, {"type": "subtitle", "time": 8465.11, "timestamp": "02:21:05", "text": "就像你知道的，创建资产或设计"}, {"type": "subtitle", "time": 8468.79, "timestamp": "02:21:08", "text": "免费提供给您。是的。也一样。完成了"}, {"type": "subtitle", "time": 8474.87, "timestamp": "02:21:14", "text": "是的。我当时就想，我也不知道为什么。"}, {"type": "subtitle", "time": 8477.19, "timestamp": "02:21:17", "text": "非常担心那些事情"}, {"type": "subtitle", "time": 8479.59, "timestamp": "02:21:19", "text": "还没发生，但确实如此"}, {"type": "subtitle", "time": 8483.429, "timestamp": "02:21:23", "text": "补墨。哦，我明白你喜欢"}, {"type": "subtitle", "time": 8486.23, "timestamp": "02:21:26", "text": "焦虑，但有些事我觉得你"}, {"type": "subtitle", "time": 8488.63, "timestamp": "02:21:28", "text": "遇到这种情况就得想办法解决。"}, {"type": "subtitle", "time": 8491.19, "timestamp": "02:21:31", "text": "就像烧掉桥梁然后得到那个一样。"}, {"type": "subtitle", "time": 8494.469, "timestamp": "02:21:34", "text": "差不多就是这样。是的，自从你"}, {"type": "subtitle", "time": 8497.429, "timestamp": "02:21:37", "text": "前面提到的“不”，我毫不犹豫。"}, {"type": "subtitle", "time": 8499.99, "timestamp": "02:21:39", "text": "犹豫不决，不敢尝试新事物，就这样"}, {"type": "subtitle", "time": 8502.389, "timestamp": "02:21:42", "text": "做做看，或者做点别的什么。我忘了"}, {"type": "subtitle", "time": 8505.349, "timestamp": "02:21:45", "text": "你说的那句话到底是什么意思？"}, {"type": "subtitle", "time": 8509.11, "timestamp": "02:21:49", "text": "说过，但是，嗯，但是最终如果"}, {"type": "subtitle", "time": 8511.75, "timestamp": "02:21:51", "text": "我首次展示这款模型或产品。"}, {"type": "subtitle", "time": 8513.07, "timestamp": "02:21:53", "text": "模型或"}, {"type": "subtitle", "time": 8517.59, "timestamp": "02:21:57", "text": "我不介意被视为……"}]
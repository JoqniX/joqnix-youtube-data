[{"type": "subtitle", "time": 8042.229, "timestamp": "02:14:02", "text": "我想，最初的原型机又回来了。"}, {"type": "subtitle", "time": 8044.51, "timestamp": "02:14:04", "text": "我竟然忘了你也在Fitma"}, {"type": "subtitle", "time": 8047.83, "timestamp": "02:14:07", "text": "东西。你还记得这件事吗？我的天啊，"}, {"type": "subtitle", "time": 8050.95, "timestamp": "02:14:10", "text": "我记得这件事。这也太可爱了吧。"}, {"type": "subtitle", "time": 8054.79, "timestamp": "02:14:14", "text": "我太喜欢它了。它非常像"}, {"type": "subtitle", "time": 8058.069, "timestamp": "02:14:18", "text": "那是什么？有点像原神那种风格"}, {"type": "subtitle", "time": 8062.55, "timestamp": "02:14:22", "text": "它具有美感。是的。真漂亮。我爱"}, {"type": "subtitle", "time": 8065.669, "timestamp": "02:14:25", "text": "长袍上的星星和亮片"}, {"type": "subtitle", "time": 8067.91, "timestamp": "02:14:27", "text": "还有那条小鲸鱼，以及其他一切。哦"}, {"type": "subtitle", "time": 8069.589, "timestamp": "02:14:29", "text": "我的天哪，这太不可思议了。我不能"}, {"type": "subtitle", "time": 8073.109, "timestamp": "02:14:33", "text": "等你剥皮。所以D。是的，我"}, {"type": "subtitle", "time": 8075.03, "timestamp": "02:14:35", "text": "也。"}, {"type": "subtitle", "time": 8078.87, "timestamp": "02:14:38", "text": "不，我当时在想，呃，自从有了……"}, {"type": "subtitle", "time": 8081.109, "timestamp": "02:14:41", "text": "这种品质的东西也像"}, {"type": "subtitle", "time": 8084.709, "timestamp": "02:14:44", "text": "非常贵。不，但我当时就想："}, {"type": "subtitle", "time": 8086.709, "timestamp": "02:14:46", "text": "我会一直保留这个"}, {"type": "subtitle", "time": 8090.709, "timestamp": "02:14:50", "text": "时间很长，我会进行一些升级。"}, {"type": "subtitle", "time": 8093.83, "timestamp": "02:14:53", "text": "后来才对它进行处理。"}, {"type": "subtitle", "time": 8096.87, "timestamp": "02:14:56", "text": "无论是动画还是其他什么"}, {"type": "subtitle", "time": 8099.99, "timestamp": "02:14:59", "text": "如果可以升级的话，任何方法都可以。"}]
[{"type": "subtitle", "time": 422.99, "timestamp": "00:07:02", "text": "知道。啊。所以，"}, {"type": "subtitle", "time": 426.43, "timestamp": "00:07:06", "text": "是的。你好。你好。不要过度监视。我"}, {"type": "subtitle", "time": 429.469, "timestamp": "00:07:09", "text": "重复一遍，我"}, {"type": "subtitle", "time": 432.469, "timestamp": "00:07:12", "text": "再说一遍，你敢看试试！我会预订"}, {"type": "subtitle", "time": 435.79, "timestamp": "00:07:15", "text": "你们每一个人"}, {"type": "subtitle", "time": 438.029, "timestamp": "00:07:18", "text": "你。你好。"}, {"type": "subtitle", "time": 441.23, "timestamp": "00:07:21", "text": "糟糕。"}, {"type": "subtitle", "time": 445.71, "timestamp": "00:07:25", "text": "嗯，接下来我想谈谈"}, {"type": "subtitle", "time": 450.23, "timestamp": "00:07:30", "text": "关于这应该做什么，所以呃，让我"}, {"type": "subtitle", "time": 451.79, "timestamp": "00:07:31", "text": "指挥所"}, {"type": "subtitle", "time": 455.83, "timestamp": "00:07:35", "text": "这就是我，我应该搬到这里来。"}, {"type": "subtitle", "time": 460.23, "timestamp": "00:07:40", "text": "嘿，关于本周的日程安排。"}, {"type": "subtitle", "time": 464.23, "timestamp": "00:07:44", "text": "嗯，嗨嗨嗨。我本来应该说“呃”"}, {"type": "subtitle", "time": 467.30899999999997, "timestamp": "00:07:47", "text": "比如发布日程安排"}, {"type": "subtitle", "time": 470.79, "timestamp": "00:07:50", "text": "每个星期六结束时，或者像太阳一样"}, {"type": "subtitle", "time": 474.30899999999997, "timestamp": "00:07:54", "text": "等到星期天。这就是为什么我上次的日程安排"}, {"type": "subtitle", "time": 477.749, "timestamp": "00:07:57", "text": "这个日程安排中，星期日是其中之一。"}]
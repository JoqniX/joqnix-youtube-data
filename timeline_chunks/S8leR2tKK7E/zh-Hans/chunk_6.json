[{"type": "subtitle", "time": 361.99, "timestamp": "00:06:01", "text": "你们。这就是我总是"}, {"type": "subtitle", "time": 364.79, "timestamp": "00:06:04", "text": "感谢你们每一个人。"}, {"type": "subtitle", "time": 367.51, "timestamp": "00:06:07", "text": "来吧，以及所有的一切。但是，"}, {"type": "subtitle", "time": 368.43, "timestamp": "00:06:08", "text": "但"}, {"type": "subtitle", "time": 371.15, "timestamp": "00:06:11", "text": "仍然"}, {"type": "subtitle", "time": 383.029, "timestamp": "00:06:23", "text": "嗯。是的，那正是我想要的。"}, {"type": "subtitle", "time": 384.95, "timestamp": "00:06:24", "text": "说。"}, {"type": "subtitle", "time": 388.87, "timestamp": "00:06:28", "text": "不要太关注我。我知道我"}, {"type": "subtitle", "time": 391.309, "timestamp": "00:06:31", "text": "我有时可以去"}, {"type": "subtitle", "time": 401.749, "timestamp": "00:06:41", "text": "仍然，但仍然，但仍然不"}, {"type": "subtitle", "time": 404.71, "timestamp": "00:06:44", "text": "守望先锋。好的。我不是在说……"}, {"type": "subtitle", "time": 412.87, "timestamp": "00:06:52", "text": "守望先锋。我的天哪。听起来我好像……"}, {"type": "subtitle", "time": 417.15, "timestamp": "00:06:57", "text": "说“哦，这是什么游戏？”"}, {"type": "subtitle", "time": 419.71, "timestamp": "00:06:59", "text": "但我"}]
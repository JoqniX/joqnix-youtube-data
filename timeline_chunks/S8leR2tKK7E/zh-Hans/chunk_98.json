[{"type": "subtitle", "time": 5883.709, "timestamp": "01:38:03", "text": "你来了，出来了，绕了一圈……"}, {"type": "subtitle", "time": 5887.91, "timestamp": "01:38:07", "text": "东西。随着时间的推移，我越来越……"}, {"type": "subtitle", "time": 5891.35, "timestamp": "01:38:11", "text": "和你互动过，塞拉斯蒂娅，"}, {"type": "subtitle", "time": 5894.87, "timestamp": "01:38:14", "text": "萨斯喀彻温省其他女孩的其他才能"}, {"type": "subtitle", "time": 5899.27, "timestamp": "01:38:19", "text": "还有一些事情，我开始明白了。"}, {"type": "subtitle", "time": 5902.109, "timestamp": "01:38:22", "text": "事情就是这样，一切都很缓慢。"}, {"type": "subtitle", "time": 5904.629, "timestamp": "01:38:24", "text": "慢慢地。是的。是的。然后我开始做这件事"}, {"type": "subtitle", "time": 5907.99, "timestamp": "01:38:27", "text": "然后我也经历了类似的事情。"}, {"type": "subtitle", "time": 5910.79, "timestamp": "01:38:30", "text": "我当时就想，哇，这就是这个"}, {"type": "subtitle", "time": 5912.59, "timestamp": "01:38:32", "text": "这是什么？"}, {"type": "subtitle", "time": 5915.669, "timestamp": "01:38:35", "text": "其他人正在经历什么。哦，我的"}, {"type": "subtitle", "time": 5916.83, "timestamp": "01:38:36", "text": "上帝"}, {"type": "subtitle", "time": 5921.75, "timestamp": "01:38:41", "text": "你真是太好了，我简直是一个巨大的喘息机会。"}, {"type": "subtitle", "time": 5924.47, "timestamp": "01:38:44", "text": "致那些像你们一样做事的人们"}, {"type": "subtitle", "time": 5928.629, "timestamp": "01:38:48", "text": "尽你所能，并且仍在努力。"}, {"type": "subtitle", "time": 5929.709, "timestamp": "01:38:49", "text": "保留它"}, {"type": "subtitle", "time": 5933.83, "timestamp": "01:38:53", "text": "向上。是啊，太棒了。"}, {"type": "subtitle", "time": 5937.43, "timestamp": "01:38:57", "text": "但我也觉得社区有"}, {"type": "subtitle", "time": 5939.99, "timestamp": "01:38:59", "text": "就像过去发生了翻天覆地的变化一样"}]
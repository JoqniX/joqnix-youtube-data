[{"type": "subtitle", "time": 19204.19, "timestamp": "05:20:04", "text": "[音乐]"}, {"type": "subtitle", "time": 19206.628, "timestamp": "05:20:06", "text": "上帝。稍等片刻。稍等片刻。稍等片刻。"}, {"type": "subtitle", "time": 19207.99, "timestamp": "05:20:07", "text": "我就是要去拿这个。我要去"}, {"type": "subtitle", "time": 19221.948, "timestamp": "05:20:21", "text": "[音乐]"}, {"type": "subtitle", "time": 19230.11, "timestamp": "05:20:30", "text": "一？不，不是那个。我是"}, {"type": "subtitle", "time": 19234.67, "timestamp": "05:20:34", "text": "希望。我只看过一部。"}, {"type": "subtitle", "time": 19247.868, "timestamp": "05:20:47", "text": "查看。呃，我应该把他打晕的。"}, {"type": "subtitle", "time": 19251.43, "timestamp": "05:20:51", "text": "向下。所以，这不是一个阿尔法世纪。所以，"}, {"type": "subtitle", "time": 19254.35, "timestamp": "05:20:54", "text": "呃，它应该是……"}, {"type": "subtitle", "time": 19257.43, "timestamp": "05:20:57", "text": "改变。我为什么需要搭电？我的天哪。"}]
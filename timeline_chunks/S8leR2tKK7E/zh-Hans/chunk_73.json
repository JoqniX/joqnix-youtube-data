[{"type": "subtitle", "time": 4383.03, "timestamp": "01:13:03", "text": "因为每个人的旅程都非常"}, {"type": "subtitle", "time": 4385.229, "timestamp": "01:13:05", "text": "不同的"}, {"type": "subtitle", "time": 4390.35, "timestamp": "01:13:10", "text": "现在。确实如此。"}, {"type": "subtitle", "time": 4394.39, "timestamp": "01:13:14", "text": "是的。嗯，是的，我还没有"}, {"type": "subtitle", "time": 4397.11, "timestamp": "01:13:17", "text": "体验过拥有类似……的感觉"}, {"type": "subtitle", "time": 4400.669, "timestamp": "01:13:20", "text": "太多事情了。很多事情，"}, {"type": "subtitle", "time": 4405.27, "timestamp": "01:13:25", "text": "正确的？但是，呃，如果我要说“如何”的话"}, {"type": "subtitle", "time": 4407.51, "timestamp": "01:13:27", "text": "要应对那么多人的注视"}, {"type": "subtitle", "time": 4410.149, "timestamp": "01:13:30", "text": "同时并保持它们"}, {"type": "subtitle", "time": 4413.669, "timestamp": "01:13:33", "text": "娱乐，诸如此类的事情，对吧？"}, {"type": "subtitle", "time": 4417.59, "timestamp": "01:13:37", "text": "嗯，我觉得更像是一天结束时……"}, {"type": "subtitle", "time": 4419.27, "timestamp": "01:13:39", "text": "比如过于关注保持"}, {"type": "subtitle", "time": 4421.27, "timestamp": "01:13:41", "text": "大家都满意了。你需要"}, {"type": "subtitle", "time": 4422.79, "timestamp": "01:13:42", "text": "要明白有人在看着你。"}, {"type": "subtitle", "time": 4426.07, "timestamp": "01:13:46", "text": "喜欢你，就是喜欢你。所以，与其像你一样，不如……"}, {"type": "subtitle", "time": 4428.709, "timestamp": "01:13:48", "text": "知道过度取悦他们，你应该"}, {"type": "subtitle", "time": 4431.83, "timestamp": "01:13:51", "text": "专注于做你自己就好。"}, {"type": "subtitle", "time": 4434.229, "timestamp": "01:13:54", "text": "做你喜欢和不喜欢的事情"}, {"type": "subtitle", "time": 4436.229, "timestamp": "01:13:56", "text": "强迫自己或他人做任何事"}, {"type": "subtitle", "time": 4437.91, "timestamp": "01:13:57", "text": "观众。"}]
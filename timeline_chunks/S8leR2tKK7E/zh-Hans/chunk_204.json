[{"type": "subtitle", "time": 12241.469, "timestamp": "03:24:01", "text": "为什么？"}, {"type": "subtitle", "time": 12244.429, "timestamp": "03:24:04", "text": "这就是为什么总是"}, {"type": "subtitle", "time": 12246.79, "timestamp": "03:24:06", "text": "数字？我非常感激我拥有"}, {"type": "subtitle", "time": 12248.15, "timestamp": "03:24:08", "text": "一群朋友和我一起帮忙"}, {"type": "subtitle", "time": 12250.469, "timestamp": "03:24:10", "text": "东西，我之后应该会处理。也许我"}, {"type": "subtitle", "time": 12268.07, "timestamp": "03:24:28", "text": "我不再跟中介合作了，因为"}, {"type": "subtitle", "time": 12269.99, "timestamp": "03:24:29", "text": "加入一家代理机构就像中了圈套"}, {"type": "subtitle", "time": 12272.87, "timestamp": "03:24:32", "text": "我的一个朋友也这么做了，我分享了我的"}, {"type": "subtitle", "time": 12276.309, "timestamp": "03:24:36", "text": "和朋友一起经历，他们给了"}, {"type": "subtitle", "time": 12278.63, "timestamp": "03:24:38", "text": "一些真正有道理的建议，例如"}, {"type": "subtitle", "time": 12282.79, "timestamp": "03:24:42", "text": "这是真的，一切都是真的，嗯，我"}, {"type": "subtitle", "time": 12285.349, "timestamp": "03:24:45", "text": "没看到这么合适的，但也是"}, {"type": "subtitle", "time": 12287.309, "timestamp": "03:24:47", "text": "真的，就像……"}, {"type": "subtitle", "time": 12292.269, "timestamp": "03:24:52", "text": "明白了，可能有效也可能无效。"}, {"type": "subtitle", "time": 12295.349, "timestamp": "03:24:55", "text": "即使是那些倾向于给出优美评价的书。"}, {"type": "subtitle", "time": 12296.75, "timestamp": "03:24:56", "text": "承诺和"}]
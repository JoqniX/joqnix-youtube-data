[{"type": "subtitle", "time": 18002.07, "timestamp": "05:00:02", "text": "顶点。顶点。是的。是的。然后是星期三"}, {"type": "subtitle", "time": 18006.15, "timestamp": "05:00:06", "text": "我们将拥有如歌般的呼吸流"}, {"type": "subtitle", "time": 18008.39, "timestamp": "05:00:08", "text": "通常。我们每周都会这样做。"}, {"type": "subtitle", "time": 18011.19, "timestamp": "05:00:11", "text": "事物。那么，星期四就成了新鲜事了。我"}, {"type": "subtitle", "time": 18013.43, "timestamp": "05:00:13", "text": "我以前从未尝试过，但我很想尝试一下。"}, {"type": "subtitle", "time": 18017.03, "timestamp": "05:00:17", "text": "从那以后就一直这样做。所以我们将要学习"}, {"type": "subtitle", "time": 18022.11, "timestamp": "05:00:22", "text": "钢琴，音乐的艺术，钢琴"}, {"type": "subtitle", "time": 18024.43, "timestamp": "05:00:24", "text": "东西。"}, {"type": "subtitle", "time": 18030.43, "timestamp": "05:00:30", "text": "嗯，是的，我对此感到非常兴奋。"}, {"type": "subtitle", "time": 18040.35, "timestamp": "05:00:40", "text": "所以"}, {"type": "subtitle", "time": 18044.07, "timestamp": "05:00:44", "text": "是的，学习钢琴，希望一切顺利。"}, {"type": "subtitle", "time": 18047.99, "timestamp": "05:00:47", "text": "呃，我不太了解，不过，嗯。"}, {"type": "subtitle", "time": 18050.99, "timestamp": "05:00:50", "text": "星期六我们有"}, {"type": "subtitle", "time": 18054.03, "timestamp": "05:00:54", "text": "我们的第三个"}, {"type": "subtitle", "time": 18056.788, "timestamp": "05:00:56", "text": "其实周年纪念日是我第一次过。"}]
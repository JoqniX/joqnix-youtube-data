[{"type": "subtitle", "time": 6900.79, "timestamp": "01:55:00", "text": "这个型号。我猜那天是生日。"}, {"type": "subtitle", "time": 6903.51, "timestamp": "01:55:03", "text": "现在就送我这份礼物吧。"}, {"type": "subtitle", "time": 6906.629, "timestamp": "01:55:06", "text": "哦，老兄，她太棒了。我非常欣赏"}, {"type": "subtitle", "time": 6910.31, "timestamp": "01:55:10", "text": "我非常喜欢她的艺术作品。如果我能像我一样"}, {"type": "subtitle", "time": 6911.91, "timestamp": "01:55:11", "text": "想知道该说什么才能偷走她的手"}, {"type": "subtitle", "time": 6913.91, "timestamp": "01:55:13", "text": "把它做成标本，然后带在身边。"}, {"type": "subtitle", "time": 6920.55, "timestamp": "01:55:20", "text": "你是在Kick上直播吗？我已经"}, {"type": "subtitle", "time": 6922.39, "timestamp": "01:55:22", "text": "已经在Kick上直播一段时间了。"}, {"type": "subtitle", "time": 6925.75, "timestamp": "01:55:25", "text": "对，就像我觉得《乔森一世》的开头那样。"}, {"type": "subtitle", "time": 6927.35, "timestamp": "01:55:27", "text": "猜测。"}, {"type": "subtitle", "time": 6930.39, "timestamp": "01:55:30", "text": "进展如何？已经很久了"}, {"type": "subtitle", "time": 6931.39, "timestamp": "01:55:31", "text": "去"}, {"type": "subtitle", "time": 6934.709, "timestamp": "01:55:34", "text": "好的。 Bem 是一束光束，踢了起来"}, {"type": "subtitle", "time": 6936.27, "timestamp": "01:55:36", "text": "一直在"}, {"type": "subtitle", "time": 6940.149, "timestamp": "01:55:40", "text": "好的。嗯，只是因为有机器人而已。"}, {"type": "subtitle", "time": 6943.03, "timestamp": "01:55:43", "text": "就像这样，突然插队，放弃了他们的 Discord 账号。"}, {"type": "subtitle", "time": 6945.35, "timestamp": "01:55:45", "text": "想获得更多粉丝？关注我，加我好友！"}, {"type": "subtitle", "time": 6947.75, "timestamp": "01:55:47", "text": "在 Discord 之类的平台上，但仍然"}, {"type": "subtitle", "time": 6950.47, "timestamp": "01:55:50", "text": "那里确实有一些真诚的人。"}, {"type": "subtitle", "time": 6952.709, "timestamp": "01:55:52", "text": "实际观看人数。"}, {"type": "subtitle", "time": 6955.31, "timestamp": "01:55:55", "text": "嗯。这就是我坚持下去的动力。"}, {"type": "subtitle", "time": 6958.629, "timestamp": "01:55:58", "text": "回来是因为有些人更喜欢"}]
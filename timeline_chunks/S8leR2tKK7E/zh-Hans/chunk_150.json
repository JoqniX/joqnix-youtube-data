[{"type": "subtitle", "time": 9001.349, "timestamp": "02:30:01", "text": "有时非常刺激，有时则不然"}, {"type": "subtitle", "time": 9004.23, "timestamp": "02:30:04", "text": "虽然可怕，但这是你必须面对的。"}, {"type": "subtitle", "time": 9019.469, "timestamp": "02:30:19", "text": "好的。所以，你有什么未来计划吗？"}, {"type": "subtitle", "time": 9022.55, "timestamp": "02:30:22", "text": "计划实现你想要的东西"}, {"type": "subtitle", "time": 9024.95, "timestamp": "02:30:24", "text": "要做什么？"}, {"type": "subtitle", "time": 9028.309, "timestamp": "02:30:28", "text": "嗯，我觉得在过去的五年里，我"}, {"type": "subtitle", "time": 9030.389, "timestamp": "02:30:30", "text": "经历了许多人一生中发生的巨大变化"}, {"type": "subtitle", "time": 9033.11, "timestamp": "02:30:33", "text": "那些时刻和事件，我一直都保留着。"}, {"type": "subtitle", "time": 9035.349, "timestamp": "02:30:35", "text": "工作，就像你知道的那样，一直都在做"}, {"type": "subtitle", "time": 9037.59, "timestamp": "02:30:37", "text": "事情一件接着一件，还有旅行"}, {"type": "subtitle", "time": 9040.23, "timestamp": "02:30:40", "text": "事情太多，以至于我都没时间……"}, {"type": "subtitle", "time": 9043.91, "timestamp": "02:30:43", "text": "比如休息，你知道，放慢速度。"}, {"type": "subtitle", "time": 9047.67, "timestamp": "02:30:47", "text": "一点。我觉得今年就是这样"}, {"type": "subtitle", "time": 9049.67, "timestamp": "02:30:49", "text": "到目前为止，我一年来一直能够……"}, {"type": "subtitle", "time": 9053.349, "timestamp": "02:30:53", "text": "比如慢下来，你知道的"}, {"type": "subtitle", "time": 9056.87, "timestamp": "02:30:56", "text": "体验生活，顺其自然，我"}, {"type": "subtitle", "time": 9059.99, "timestamp": "02:30:59", "text": "我觉得我不想做任何重大决定。"}]
[{"type": "subtitle", "time": 4980.35, "timestamp": "01:23:00", "text": "不知道我能不能随便选"}, {"type": "subtitle", "time": 4985.03, "timestamp": "01:23:05", "text": "一。这感觉太不公平了。"}, {"type": "subtitle", "time": 4987.11, "timestamp": "01:23:07", "text": "你擅长这三件事吗？"}, {"type": "subtitle", "time": 4995.669, "timestamp": "01:23:15", "text": "这取决于。"}, {"type": "subtitle", "time": 4998.39, "timestamp": "01:23:18", "text": "我觉得自己擅长辩论吗？"}, {"type": "subtitle", "time": 5000.83, "timestamp": "01:23:20", "text": "因为我不认为"}, {"type": "subtitle", "time": 5004.07, "timestamp": "01:23:24", "text": "所以。不。我觉得你你你"}, {"type": "subtitle", "time": 5006.47, "timestamp": "01:23:26", "text": "擅长逻辑思维之类的东西，而且喜欢"}, {"type": "subtitle", "time": 5009.79, "timestamp": "01:23:29", "text": "想着，是啊。更好"}, {"type": "subtitle", "time": 5014.43, "timestamp": "01:23:34", "text": "更好的。我当时看到一个游戏。"}, {"type": "subtitle", "time": 5017.99, "timestamp": "01:23:37", "text": "昨天就像……嗯，Bow the Veil，对吧？"}, {"type": "subtitle", "time": 5020.709, "timestamp": "01:23:40", "text": "你认识她，对吧？嗯哼。面纱"}, {"type": "subtitle", "time": 5025.189, "timestamp": "01:23:45", "text": "女孩。嗯，我看过她演奏这个。呃，这是一个"}, {"type": "subtitle", "time": 5026.91, "timestamp": "01:23:46", "text": "游戏"}, {"type": "subtitle", "time": 5032.59, "timestamp": "01:23:52", "text": "打电话：等等，让我去拿。我该怎么做？"}, {"type": "subtitle", "time": 5035.43, "timestamp": "01:23:55", "text": "呃，我该怎么看？好的，它叫做"}, {"type": "subtitle", "time": 5037.31, "timestamp": "01:23:57", "text": "有罪"}, {"type": "subtitle", "time": 5039.91, "timestamp": "01:23:59", "text": "短袜。罪孽深重。我想我已经"}]
[{"type": "subtitle", "time": 9971.23, "timestamp": "02:46:11", "text": "我的天哪，它好重啊"}, {"type": "subtitle", "time": 9974.63, "timestamp": "02:46:14", "text": "下雨了。那个中国人"}, {"type": "subtitle", "time": 9978.15, "timestamp": "02:46:18", "text": "朋友竭尽全力做了所有的事情"}, {"type": "subtitle", "time": 9982.55, "timestamp": "02:46:22", "text": "对我来说就是这样。老天，我真是太感激了。"}, {"type": "subtitle", "time": 9984.11, "timestamp": "02:46:24", "text": "我想"}, {"type": "subtitle", "time": 9987.03, "timestamp": "02:46:27", "text": "哭。呃"}, {"type": "subtitle", "time": 9989.99, "timestamp": "02:46:29", "text": "但现在情况变得复杂了。呃，什么"}, {"type": "subtitle", "time": 9993.55, "timestamp": "02:46:33", "text": "我该如何安排日程呢？"}, {"type": "subtitle", "time": 9997.469, "timestamp": "02:46:37", "text": "呃，PT儿子没能做到"}, {"type": "subtitle", "time": 10000.15, "timestamp": "02:46:40", "text": "它？ PT歌曲未能成功"}, {"type": "subtitle", "time": 10002.19, "timestamp": "02:46:42", "text": "合作"}, {"type": "subtitle", "time": 10004.79, "timestamp": "02:46:44", "text": "今天。去你的，乌鸦之子。中国人"}, {"type": "subtitle", "time": 10009.59, "timestamp": "02:46:49", "text": "朋友们不能直播"}, {"type": "subtitle", "time": 10011.59, "timestamp": "02:46:51", "text": "周六"}, {"type": "subtitle", "time": 10012.99, "timestamp": "02:46:52", "text": "下午2点"}, {"type": "subtitle", "time": 10017.15, "timestamp": "02:46:57", "text": "IST。所以，我就想，我该怎么办？"}, {"type": "subtitle", "time": 10019.99, "timestamp": "02:46:59", "text": "做？所以，我就在想，我该怎么办？"}]
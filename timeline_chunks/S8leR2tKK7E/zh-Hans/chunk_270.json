[{"type": "subtitle", "time": 16211.79, "timestamp": "04:30:11", "text": "呃。我必须写下来"}, {"type": "subtitle", "time": 16215.91, "timestamp": "04:30:15", "text": "向下。兄弟，我收拾好了。我已经收拾好行李了。"}, {"type": "subtitle", "time": 16228.11, "timestamp": "04:30:28", "text": "呃，下午 4 点以后。"}, {"type": "subtitle", "time": 16234.63, "timestamp": "04:30:34", "text": "中部标准时间。呃，下午2:30，不，是1:30，1:30"}, {"type": "subtitle", "time": 16236.51, "timestamp": "04:30:36", "text": "下午"}, {"type": "subtitle", "time": 16239.63, "timestamp": "04:30:39", "text": "IST。呃，"}, {"type": "subtitle", "time": 16255.269, "timestamp": "04:30:55", "text": "呃，6月18日至19日"}]
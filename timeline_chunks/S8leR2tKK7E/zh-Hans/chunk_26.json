[{"type": "subtitle", "time": 1565.71, "timestamp": "00:26:05", "text": "嗯。好的。"}, {"type": "subtitle", "time": 1569.23, "timestamp": "00:26:09", "text": "你好。所以，我希望你没等太久。"}, {"type": "subtitle", "time": 1571.39, "timestamp": "00:26:11", "text": "不，你当时"}, {"type": "subtitle", "time": 1574.47, "timestamp": "00:26:14", "text": "早期的。我的直播通常不会"}, {"type": "subtitle", "time": 1580.19, "timestamp": "00:26:20", "text": "你的。"}, {"type": "subtitle", "time": 1583.51, "timestamp": "00:26:23", "text": "是的。哦，等等。我觉得我有点冷了。"}]
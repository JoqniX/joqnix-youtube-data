[{"type": "subtitle", "time": 8341.03, "timestamp": "02:19:01", "text": "他们说：“但这就像最……”"}, {"type": "subtitle", "time": 8343.469, "timestamp": "02:19:03", "text": "压力最大的部分，就像重做你所有的事情一样。"}, {"type": "subtitle", "time": 8346.27, "timestamp": "02:19:06", "text": "场景和背景音乐以及"}, {"type": "subtitle", "time": 8348.629, "timestamp": "02:19:08", "text": "元素。那件事比什么都让我压力更大"}, {"type": "subtitle", "time": 8351.509, "timestamp": "02:19:11", "text": "比如，你知道，使用一种新模型"}, {"type": "subtitle", "time": 8354.629, "timestamp": "02:19:14", "text": "“它自己。”嗯，我的意思是，对我来说没问题。"}, {"type": "subtitle", "time": 8358.309, "timestamp": "02:19:18", "text": "但更像是我必须接受委托。"}, {"type": "subtitle", "time": 8362.389, "timestamp": "02:19:22", "text": "这些人为了这些资产，必须……"}, {"type": "subtitle", "time": 8365.509, "timestamp": "02:19:25", "text": "与……质量相当"}, {"type": "subtitle", "time": 8368.87, "timestamp": "02:19:28", "text": "模型。不。否则看起来会很奇怪。"}, {"type": "subtitle", "time": 8371.75, "timestamp": "02:19:31", "text": "算是吧？你有没有注意到"}, {"type": "subtitle", "time": 8374.87, "timestamp": "02:19:34", "text": "是那种问题吗？"}, {"type": "subtitle", "time": 8378.23, "timestamp": "02:19:38", "text": "就我个人而言，我并不一定喜欢"}, {"type": "subtitle", "time": 8380.79, "timestamp": "02:19:40", "text": "想太多了。但作为"}, {"type": "subtitle", "time": 8383.19, "timestamp": "02:19:43", "text": "独立视频，我肯定能看出来。"}, {"type": "subtitle", "time": 8385.83, "timestamp": "02:19:45", "text": "问题在于，我见过很多这样的例子。"}, {"type": "subtitle", "time": 8387.75, "timestamp": "02:19:47", "text": "就像你深入了解他们的设置一样"}, {"type": "subtitle", "time": 8390.349, "timestamp": "02:19:50", "text": "整体类似资产，然后类似"}, {"type": "subtitle", "time": 8392.71, "timestamp": "02:19:52", "text": "场景以及如何像复杂和"}, {"type": "subtitle", "time": 8394.389, "timestamp": "02:19:54", "text": "这会让人感到压力，因为有时"}, {"type": "subtitle", "time": 8396.87, "timestamp": "02:19:56", "text": "免费的东西可能不太受欢迎。"}, {"type": "subtitle", "time": 8399.429, "timestamp": "02:19:59", "text": "美观，但不错，但没有"}]
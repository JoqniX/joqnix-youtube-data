[{"type": "subtitle", "time": 19510.708, "timestamp": "05:25:10", "text": "不要在这里待太久"}, {"type": "subtitle", "time": 19514.07, "timestamp": "05:25:14", "text": "泰坦。内部自由固体。"}, {"type": "subtitle", "time": 19516.31, "timestamp": "05:25:16", "text": "好的。我预料到会偶然发现这个"}, {"type": "subtitle", "time": 19518.788, "timestamp": "05:25:18", "text": "聚落类型。"}, {"type": "subtitle", "time": 19522.6, "timestamp": "05:25:22", "text": "可能是在想办法绕过这个问题。"}, {"type": "subtitle", "time": 19524.07, "timestamp": "05:25:24", "text": "[音乐]"}, {"type": "subtitle", "time": 19526.868, "timestamp": "05:25:26", "text": "该死。电力又出故障了。乔伊斯"}, {"type": "subtitle", "time": 19535.27, "timestamp": "05:25:35", "text": "如果你打算分块进行，"}, {"type": "subtitle", "time": 19537.03, "timestamp": "05:25:37", "text": "路德一直在骚扰所有人"}, {"type": "subtitle", "time": 19540.07, "timestamp": "05:25:40", "text": "他们用盾牌寻求帮助。"}, {"type": "subtitle", "time": 19541.55, "timestamp": "05:25:41", "text": "发言"}, {"type": "subtitle", "time": 19543.75, "timestamp": "05:25:43", "text": "路德。我不知道这些人是谁。"}, {"type": "subtitle", "time": 19552.23, "timestamp": "05:25:52", "text": "非玩家角色。他在哪儿？"}, {"type": "subtitle", "time": 19553.59, "timestamp": "05:25:53", "text": "你来自那些星球之一吗？"}, {"type": "subtitle", "time": 19559.91, "timestamp": "05:25:59", "text": "我的NPC在哪儿？查玛，我爸爸说"}]
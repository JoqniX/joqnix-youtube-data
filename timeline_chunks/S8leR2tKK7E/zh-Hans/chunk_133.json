[{"type": "subtitle", "time": 7980.31, "timestamp": "02:13:00", "text": "人们都在寻找它，但我认为我"}, {"type": "subtitle", "time": 7982.069, "timestamp": "02:13:02", "text": "我特别喜欢我所在的地方。"}, {"type": "subtitle", "time": 7983.91, "timestamp": "02:13:03", "text": "过上我能提供那种生活的生活"}, {"type": "subtitle", "time": 7986.47, "timestamp": "02:13:06", "text": "为新人提供服务或投资"}, {"type": "subtitle", "time": 7989.99, "timestamp": "02:13:09", "text": "我之所以拥有这么多精力，是因为我……"}, {"type": "subtitle", "time": 8004.27, "timestamp": "02:13:24", "text": "不，你仍然是塞拉斯蒂娅。"}, {"type": "subtitle", "time": 8007.75, "timestamp": "02:13:27", "text": "男生。但你知道塞拉斯蒂娅的年龄吗？"}, {"type": "subtitle", "time": 8010.31, "timestamp": "02:13:30", "text": "我忘了。我以为你永葆青春"}, {"type": "subtitle", "time": 8012.229, "timestamp": "02:13:32", "text": "像我这样的。"}, {"type": "subtitle", "time": 8014.629, "timestamp": "02:13:34", "text": "是的，算是吧。你可以喜欢"}, {"type": "subtitle", "time": 8018.149, "timestamp": "02:13:38", "text": "请把我当成永葆青春的人。耶。"}, {"type": "subtitle", "time": 8031.43, "timestamp": "02:13:51", "text": "乐趣。所以，所以哦，我没有派你去。这"}, {"type": "subtitle", "time": 8034.35, "timestamp": "02:13:54", "text": "就是这样。我不介意"}, {"type": "subtitle", "time": 8038.51, "timestamp": "02:13:58", "text": "分享。我认为你已经展示了"}]
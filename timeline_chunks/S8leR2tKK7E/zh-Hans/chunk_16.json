[{"type": "subtitle", "time": 960.59, "timestamp": "00:16:00", "text": "我以为人们会对他们无礼"}, {"type": "subtitle", "time": 964.949, "timestamp": "00:16:04", "text": "onx 因为他们认为自己是 b 因为他们"}, {"type": "subtitle", "time": 967.79, "timestamp": "00:16:07", "text": "觉得自己像个机器人，但她不是。"}, {"type": "subtitle", "time": 972.389, "timestamp": "00:16:12", "text": "他们在那里是为了欢迎新来的人。"}, {"type": "subtitle", "time": 976.43, "timestamp": "00:16:16", "text": "嗯，我会和你们在一起的，正在旅行中。"}, {"type": "subtitle", "time": 980.31, "timestamp": "00:16:20", "text": "携手共进，共创美好未来"}, {"type": "subtitle", "time": 983.59, "timestamp": "00:16:23", "text": "所以我决定如果……我会改成缟玛瑙色。"}, {"type": "subtitle", "time": 986.79, "timestamp": "00:16:26", "text": "所以，如果有新的任何人在场的话"}, {"type": "subtitle", "time": 989.43, "timestamp": "00:16:29", "text": "聊天时，如果有人是新来的，他们会说“啊，Onyx”。"}, {"type": "subtitle", "time": 997.509, "timestamp": "00:16:37", "text": "B 和现有的呃，比如不存在"}, {"type": "subtitle", "time": 1002.389, "timestamp": "00:16:42", "text": "就像……呃……我的……呃……就像……呃……对于那些知道的人来说"}, {"type": "subtitle", "time": 1006.389, "timestamp": "00:16:46", "text": "对，谁知道呢，你知道，我知道，那是"}, {"type": "subtitle", "time": 1011.23, "timestamp": "00:16:51", "text": "正要变脸，她说她是你的"}, {"type": "subtitle", "time": 1013.91, "timestamp": "00:16:53", "text": "妻子。但她不会当面说这些。"}, {"type": "subtitle", "time": 1016.67, "timestamp": "00:16:56", "text": "不过，对我来说……我想知道"}]
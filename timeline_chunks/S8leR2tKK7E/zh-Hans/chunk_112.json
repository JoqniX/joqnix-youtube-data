[{"type": "subtitle", "time": 6722.709, "timestamp": "01:52:02", "text": "四月是粉色，五月是白色"}, {"type": "subtitle", "time": 6727.589, "timestamp": "01:52:07", "text": "六月份的最后一件事。我的天啊，"}, {"type": "subtitle", "time": 6729.91, "timestamp": "01:52:09", "text": "真是太有趣了。我从未"}, {"type": "subtitle", "time": 6733.91, "timestamp": "01:52:13", "text": "我知道这些颜色都有特定的含义。"}, {"type": "subtitle", "time": 6736.47, "timestamp": "01:52:16", "text": "哦，它们就像来自蓝色的……"}, {"type": "subtitle", "time": 6738.87, "timestamp": "01:52:18", "text": "左眼，紫色的是右眼。"}, {"type": "subtitle", "time": 6742.149, "timestamp": "01:52:22", "text": "眼睛。粉色的就是那件连帽衫。"}, {"type": "subtitle", "time": 6744.79, "timestamp": "01:52:24", "text": "白色将是头发"}, {"type": "subtitle", "time": 6746.87, "timestamp": "01:52:26", "text": "因为就像你身处色彩之中一样"}, {"type": "subtitle", "time": 6750.31, "timestamp": "01:52:30", "text": "星座，对吧？"}, {"type": "subtitle", "time": 6751.83, "timestamp": "01:52:31", "text": "真是太疯狂了，你居然也这样？"}, {"type": "subtitle", "time": 6754.75, "timestamp": "01:52:34", "text": "与月份相关的"}, {"type": "subtitle", "time": 6758.43, "timestamp": "01:52:38", "text": "颜色。太有创意了。我的天啊。我不"}, {"type": "subtitle", "time": 6761.51, "timestamp": "01:52:41", "text": "知道。这就像一个突发奇想。我当时"}, {"type": "subtitle", "time": 6764.229, "timestamp": "01:52:44", "text": "就像我刚才说的那种感觉"}, {"type": "subtitle", "time": 6767.35, "timestamp": "01:52:47", "text": "这个型号也该告别了。但上帝"}, {"type": "subtitle", "time": 6770.55, "timestamp": "01:52:50", "text": "知道我何时出道。所以，在"}, {"type": "subtitle", "time": 6773.91, "timestamp": "01:52:53", "text": "或者，我想秘密送别。"}, {"type": "subtitle", "time": 6777.91, "timestamp": "01:52:57", "text": "就像和这位模特相处的那一刻，"}]
[{"type": "subtitle", "time": 7501.189, "timestamp": "02:05:01", "text": "“哦，他们做得真好。”我"}, {"type": "subtitle", "time": 7503.109, "timestamp": "02:05:03", "text": "就像这样，“是啊，他们肯定会这么做的。”"}, {"type": "subtitle", "time": 7506.87, "timestamp": "02:05:06", "text": "出色地。他们值得拥有这一切。”我觉得"}, {"type": "subtitle", "time": 7509.99, "timestamp": "02:05:09", "text": "我也可以按照自己的节奏做同样的事情。"}, {"type": "subtitle", "time": 7514.07, "timestamp": "02:05:14", "text": "有一天，诸如此类的事情。而那"}, {"type": "subtitle", "time": 7517.35, "timestamp": "02:05:17", "text": "心态确实起到了一定的作用。那确实有所帮助。"}, {"type": "subtitle", "time": 7519.589, "timestamp": "02:05:19", "text": "很多。是的。是的。"}, {"type": "subtitle", "time": 7522.47, "timestamp": "02:05:22", "text": "所以我完全理解接下来会发生什么。"}, {"type": "subtitle", "time": 7526.07, "timestamp": "02:05:26", "text": "也要打破那种“我”的心态，因为"}, {"type": "subtitle", "time": 7528.229, "timestamp": "02:05:28", "text": "我感觉自己正在失去一些东西。"}, {"type": "subtitle", "time": 7531.27, "timestamp": "02:05:31", "text": "很多机会，而且很有潜力"}, {"type": "subtitle", "time": 7533.99, "timestamp": "02:05:33", "text": "就像我在苏格兰的时候一样。我感觉"}, {"type": "subtitle", "time": 7536.07, "timestamp": "02:05:36", "text": "就像离开印度一样，因为我离开了印度。"}, {"type": "subtitle", "time": 7538.07, "timestamp": "02:05:38", "text": "感觉自己很多事情都做不了。"}, {"type": "subtitle", "time": 7540.95, "timestamp": "02:05:40", "text": "作为内容创作者。但我也觉得"}, {"type": "subtitle", "time": 7542.669, "timestamp": "02:05:42", "text": "这是我选择的道路。"}, {"type": "subtitle", "time": 7546.55, "timestamp": "02:05:46", "text": "我自己以及我想要的生活"}, {"type": "subtitle", "time": 7549.189, "timestamp": "02:05:49", "text": "以及他们正在制造的那些人"}, {"type": "subtitle", "time": 7553.189, "timestamp": "02:05:53", "text": "选择和喜欢做事情"}, {"type": "subtitle", "time": 7555.03, "timestamp": "02:05:55", "text": "领导时要像你清楚自己该做什么一样。"}, {"type": "subtitle", "time": 7557.83, "timestamp": "02:05:57", "text": "他们想要的东西，而我只是你"}]
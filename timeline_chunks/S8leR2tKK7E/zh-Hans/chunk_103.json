[{"type": "subtitle", "time": 6182.109, "timestamp": "01:43:02", "text": "这里那里都有拒绝，我"}, {"type": "subtitle", "time": 6184.95, "timestamp": "01:43:04", "text": "与其遭受创伤，不如积极行动。"}, {"type": "subtitle", "time": 6188.47, "timestamp": "01:43:08", "text": "它，我正慢慢地变得越来越……"}, {"type": "subtitle", "time": 6190.95, "timestamp": "01:43:10", "text": "有信心仍然会主动联系"}, {"type": "subtitle", "time": 6193.59, "timestamp": "01:43:13", "text": "人们，仍然要和人们交谈。我认为"}, {"type": "subtitle", "time": 6195.59, "timestamp": "01:43:15", "text": "这是我通过……学到的一件好事"}, {"type": "subtitle", "time": 6197.59, "timestamp": "01:43:17", "text": "这场运动马拉松。好的"}, {"type": "subtitle", "time": 6200.35, "timestamp": "01:43:20", "text": "事物？那真是太神奇了，因为"}, {"type": "subtitle", "time": 6203.59, "timestamp": "01:43:23", "text": "就像遭遇拒绝是不可避免的一样。"}, {"type": "subtitle", "time": 6205.43, "timestamp": "01:43:25", "text": "当你试图够到一大块东西时"}, {"type": "subtitle", "time": 6207.51, "timestamp": "01:43:27", "text": "一群人。总会有"}, {"type": "subtitle", "time": 6209.43, "timestamp": "01:43:29", "text": "拒绝你的人或者喜欢你的人"}, {"type": "subtitle", "time": 6212.629, "timestamp": "01:43:32", "text": "我不同意你的观点。但你知道它是"}, {"type": "subtitle", "time": 6214.55, "timestamp": "01:43:34", "text": "也有点像是一种拒绝疗法。"}, {"type": "subtitle", "time": 6216.31, "timestamp": "01:43:36", "text": "你听说过那东西吗？喜欢"}, {"type": "subtitle", "time": 6218.07, "timestamp": "01:43:38", "text": "你只要走到一个陌生人面前，然后"}, {"type": "subtitle", "time": 6220.07, "timestamp": "01:43:40", "text": "把你心里想的都问出来。这"}, {"type": "subtitle", "time": 6221.83, "timestamp": "01:43:41", "text": "最坏的结果也就是被拒绝而已。他们不是"}, {"type": "subtitle", "time": 6224.39, "timestamp": "01:43:44", "text": "就像……怎么说呢，出来……"}, {"type": "subtitle", "time": 6226.709, "timestamp": "01:43:46", "text": "你的屏幕发出尖叫，或者就像你知道的那样"}, {"type": "subtitle", "time": 6229.75, "timestamp": "01:43:49", "text": "掐死你什么的。如果你愿意的话"}, {"type": "subtitle", "time": 6231.59, "timestamp": "01:43:51", "text": "你仍然可以与他们互动。如果"}, {"type": "subtitle", "time": 6232.79, "timestamp": "01:43:52", "text": "你不想，你也不必"}, {"type": "subtitle", "time": 6234.629, "timestamp": "01:43:54", "text": "与他们互动，因为这是"}, {"type": "subtitle", "time": 6237.51, "timestamp": "01:43:57", "text": "你不喜欢的人"}, {"type": "subtitle", "time": 6239.43, "timestamp": "01:43:59", "text": "身体上或类似地参与其中"}]
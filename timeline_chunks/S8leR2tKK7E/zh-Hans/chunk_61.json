[{"type": "subtitle", "time": 3672.349, "timestamp": "01:01:12", "text": "总之，大家好。我回来了"}, {"type": "subtitle", "time": 3675.19, "timestamp": "01:01:15", "text": "晚餐。好了，我们迎来了一位特别嘉宾。"}, {"type": "subtitle", "time": 3678.309, "timestamp": "01:01:18", "text": "今晚。这里是塞莱斯蒂亚虚空"}, {"type": "subtitle", "time": 3682.15, "timestamp": "01:01:22", "text": "和我们一起。你好，塞拉斯蒂娅。"}, {"type": "subtitle", "time": 3684.309, "timestamp": "01:01:24", "text": "你好，前辈。非常感谢！"}, {"type": "subtitle", "time": 3688.15, "timestamp": "01:01:28", "text": "邀请我来这里。这真是我的荣幸。"}, {"type": "subtitle", "time": 3689.91, "timestamp": "01:01:29", "text": "你好。你好。"}, {"type": "subtitle", "time": 3693.589, "timestamp": "01:01:33", "text": "不，这对我来说是一种荣幸，因为这是我们的"}, {"type": "subtitle", "time": 3697.19, "timestamp": "01:01:37", "text": "这算是正式合作吧。史无前例"}, {"type": "subtitle", "time": 3699.67, "timestamp": "01:01:39", "text": "方式。我的意思是，我们以前合作过。"}, {"type": "subtitle", "time": 3702.789, "timestamp": "01:01:42", "text": "但我们还没有坐下来好好谈过。"}, {"type": "subtitle", "time": 3705.51, "timestamp": "01:01:45", "text": "在之前的一条小溪上。是的，我们还没有。"}, {"type": "subtitle", "time": 3708.63, "timestamp": "01:01:48", "text": "已经完成了。是的。这太疯狂了，因为我"}, {"type": "subtitle", "time": 3711.589, "timestamp": "01:01:51", "text": "认识你四年多了。"}, {"type": "subtitle", "time": 3713.87, "timestamp": "01:01:53", "text": "是的，四个"}, {"type": "subtitle", "time": 3718.549, "timestamp": "01:01:58", "text": "年。时间过得真快。"}]
[{"type": "subtitle", "time": 722.71, "timestamp": "00:12:02", "text": "真想狠狠地揍他们一顿，然后杀了他们！"}, {"type": "subtitle", "time": 725.87, "timestamp": "00:12:05", "text": "但我不得不放弃"}, {"type": "subtitle", "time": 729.67, "timestamp": "00:12:09", "text": "这让我想起了那段时光……"}, {"type": "subtitle", "time": 733.15, "timestamp": "00:12:13", "text": "对于那些不了解的人来说"}, {"type": "subtitle", "time": 738.55, "timestamp": "00:12:18", "text": "之前，之前，之前，我在Twitch上直播"}, {"type": "subtitle", "time": 740.91, "timestamp": "00:12:20", "text": "过去发生的事情"}, {"type": "subtitle", "time": 745.069, "timestamp": "00:12:25", "text": "去年，上去年，或者"}, {"type": "subtitle", "time": 749.75, "timestamp": "00:12:29", "text": "某物。我不得不……该怎么称呼它呢？"}, {"type": "subtitle", "time": 752.87, "timestamp": "00:12:32", "text": "我不得不更改我在 YouTube 上的名字，我的"}, {"type": "subtitle", "time": 756.269, "timestamp": "00:12:36", "text": "YouTube 用户名变成某种东西"}, {"type": "subtitle", "time": 759.069, "timestamp": "00:12:39", "text": "别的。那是"}, {"type": "subtitle", "time": 762.949, "timestamp": "00:12:42", "text": "嗯，该怎么称呼它呢？是啊，一些事。"}, {"type": "subtitle", "time": 767.11, "timestamp": "00:12:47", "text": "那段时间我经历了很多糟糕的事情。"}, {"type": "subtitle", "time": 769.829, "timestamp": "00:12:49", "text": "在Twitch上，我开始直播的日子比我……"}, {"type": "subtitle", "time": 773.509, "timestamp": "00:12:53", "text": "在我接触V2之类的东西之前。所以之后"}, {"type": "subtitle", "time": 776.949, "timestamp": "00:12:56", "text": "发生了什么？所有的仇恨值都降到零了。"}]
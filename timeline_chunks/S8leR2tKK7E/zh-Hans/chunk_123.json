[{"type": "subtitle", "time": 7381.51, "timestamp": "02:03:01", "text": "把更多精力和精力集中在工作上"}, {"type": "subtitle", "time": 7383.91, "timestamp": "02:03:03", "text": "为了实现某个特定目标，我可能会"}, {"type": "subtitle", "time": 7385.189, "timestamp": "02:03:05", "text": "把所有这些精力投入到"}, {"type": "subtitle", "time": 7387.99, "timestamp": "02:03:07", "text": "别的什么。所以我不这么认为"}, {"type": "subtitle", "time": 7390.629, "timestamp": "02:03:10", "text": "将一个人的喜好与其他人的喜好进行比较是公平的。"}, {"type": "subtitle", "time": 7392.149, "timestamp": "02:03:12", "text": "你知道进展或成就"}, {"type": "subtitle", "time": 7394.229, "timestamp": "02:03:14", "text": "另一个原因是，我们都有喜欢"}, {"type": "subtitle", "time": 7396.39, "timestamp": "02:03:16", "text": "不同的情况和不同的"}, {"type": "subtitle", "time": 7399.27, "timestamp": "02:03:19", "text": "就像你知道的目标和环境一样"}, {"type": "subtitle", "time": 7401.669, "timestamp": "02:03:21", "text": "以及我们能够获得什么，以及我们"}, {"type": "subtitle", "time": 7403.35, "timestamp": "02:03:23", "text": "不。"}, {"type": "subtitle", "time": 7405.07, "timestamp": "02:03:25", "text": "我"}, {"type": "subtitle", "time": 7408.31, "timestamp": "02:03:28", "text": "认为大多数人只是尽力而为。"}, {"type": "subtitle", "time": 7409.58, "timestamp": "02:03:29", "text": "时间。"}, {"type": "subtitle", "time": 7411.629, "timestamp": "02:03:31", "text": "[音乐]"}, {"type": "subtitle", "time": 7415.75, "timestamp": "02:03:35", "text": "是的，没错。是啊，我也有点儿"}, {"type": "subtitle", "time": 7417.87, "timestamp": "02:03:37", "text": "有过那种经历"}, {"type": "subtitle", "time": 7420.87, "timestamp": "02:03:40", "text": "那一刻，我感到一阵莫名的怪异"}, {"type": "subtitle", "time": 7424.149, "timestamp": "02:03:44", "text": "嫉妒之类的感觉"}, {"type": "subtitle", "time": 7426.79, "timestamp": "02:03:46", "text": "这种令人窒息的感觉，让我的同龄人或"}, {"type": "subtitle", "time": 7429.27, "timestamp": "02:03:49", "text": "朋友们都过得很好，而我却……"}, {"type": "subtitle", "time": 7432.149, "timestamp": "02:03:52", "text": "被排除在外，或者说，没有……"}, {"type": "subtitle", "time": 7434.79, "timestamp": "02:03:54", "text": "好像卡在墙里了。在"}, {"type": "subtitle", "time": 7437.229, "timestamp": "02:03:57", "text": "一开始我心想，为什么我会有这种感觉？"}]
[{"type": "subtitle", "time": 9660.349, "timestamp": "02:41:00", "text": "为你。我确实有对象。我确实有一个"}, {"type": "subtitle", "time": 9662.34, "timestamp": "02:41:02", "text": "朋友。呃"}, {"type": "subtitle", "time": 9676.95, "timestamp": "02:41:16", "text": "朋友问他们是否已经完成了。是的。"}, {"type": "subtitle", "time": 9679.67, "timestamp": "02:41:19", "text": "莫拉夫的力量。是的。如果他们愿意"}, {"type": "subtitle", "time": 9693.83, "timestamp": "02:41:33", "text": "[音乐]"}, {"type": "subtitle", "time": 9697.27, "timestamp": "02:41:37", "text": "我的天哪，我们需要一个“我该如何找到一个”"}, {"type": "subtitle", "time": 9704.15, "timestamp": "02:41:44", "text": "代表？我如何找到一个中国人"}]
[{"type": "subtitle", "time": 604.11, "timestamp": "00:10:04", "text": "嗯，我想问的是，呃，该怎么称呼它呢？"}, {"type": "subtitle", "time": 608.31, "timestamp": "00:10:08", "text": "它？嗯，我真的很想完成它。"}, {"type": "subtitle", "time": 612.23, "timestamp": "00:10:12", "text": "把主线任务升到最高级，因为我一直在攒资源"}, {"type": "subtitle", "time": 614.75, "timestamp": "00:10:14", "text": "把所有故事任务都堆在一起"}, {"type": "subtitle", "time": 618.47, "timestamp": "00:10:18", "text": "原神会在直播中一次性完成"}, {"type": "subtitle", "time": 620.35, "timestamp": "00:10:20", "text": "和你一起"}, {"type": "subtitle", "time": 622.949, "timestamp": "00:10:22", "text": "伙计们。我不知道为什么，我会坦白地说。"}, {"type": "subtitle", "time": 625.19, "timestamp": "00:10:25", "text": "把这件事告诉大家。当我玩原神的时候，"}, {"type": "subtitle", "time": 628.79, "timestamp": "00:10:28", "text": "如果涉及到对话，我会跳过对话。"}, {"type": "subtitle", "time": 631.59, "timestamp": "00:10:31", "text": "速度快如闪电。跳过，"}, {"type": "subtitle", "time": 634.47, "timestamp": "00:10:34", "text": "跳过，跳过。我不想那样做。和"}, {"type": "subtitle", "time": 636.91, "timestamp": "00:10:36", "text": "我想知道，我想知道关于……"}, {"type": "subtitle", "time": 639.829, "timestamp": "00:10:39", "text": "故事。我想知道关于什么"}, {"type": "subtitle", "time": 642.63, "timestamp": "00:10:42", "text": "事情确实发生了。你知道我做了什么吗？"}, {"type": "subtitle", "time": 644.99, "timestamp": "00:10:44", "text": "接下来会发生什么？发生了什么事？"}, {"type": "subtitle", "time": 647.75, "timestamp": "00:10:47", "text": "呆子？我不得不回到档案馆。"}, {"type": "subtitle", "time": 655.15, "timestamp": "00:10:55", "text": "因为我跳过了这件事"}, {"type": "subtitle", "time": 658.47, "timestamp": "00:10:58", "text": "跳过。所以，明天我会尽力而为。"}]
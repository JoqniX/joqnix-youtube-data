[{"type": "subtitle", "time": 4861.669, "timestamp": "01:21:01", "text": "它？掉出来。嗯，当电影电视"}, {"type": "subtitle", "time": 4863.83, "timestamp": "01:21:03", "text": "剧集播出了，对吧，他们当时正在……"}, {"type": "subtitle", "time": 4867.95, "timestamp": "01:21:07", "text": "免费获取。辐射系列"}, {"type": "subtitle", "time": 4877.35, "timestamp": "01:21:17", "text": "忘了。他们这样做很好。"}, {"type": "subtitle", "time": 4881.03, "timestamp": "01:21:21", "text": "领取免费游戏真的很有趣"}, {"type": "subtitle", "time": 4882.709, "timestamp": "01:21:22", "text": "就像，“是的，我拥有它，而且我打算……”"}, {"type": "subtitle", "time": 4888.709, "timestamp": "01:21:28", "text": "它。”无需花钱。"}, {"type": "subtitle", "time": 4890.95, "timestamp": "01:21:30", "text": "绝对地。我觉得这就像……"}, {"type": "subtitle", "time": 4893.59, "timestamp": "01:21:33", "text": "出色的营销策略也是为了获得"}, {"type": "subtitle", "time": 4901.669, "timestamp": "01:21:41", "text": "疯狂的。等待。和朋友一起打高尔夫球"}, {"type": "subtitle", "time": 4904.87, "timestamp": "01:21:44", "text": "Prime会员免费。搞什么鬼？"}, {"type": "subtitle", "time": 4908.709, "timestamp": "01:21:48", "text": "你必须得到它。在Steam平台上。我有"}, {"type": "subtitle", "time": 4911.47, "timestamp": "01:21:51", "text": "在圣。它在GG上。"}, {"type": "subtitle", "time": 4914.87, "timestamp": "01:21:54", "text": "好的。好的。"}, {"type": "subtitle", "time": 4919.11, "timestamp": "01:21:59", "text": "说真的，这是有史以来最好的游戏。是的。"}]
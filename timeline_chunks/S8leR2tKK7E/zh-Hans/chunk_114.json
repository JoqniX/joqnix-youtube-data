[{"type": "subtitle", "time": 6842.229, "timestamp": "01:54:02", "text": "PNG格式的，是Zi给我画的。没有人"}, {"type": "subtitle", "time": 6846.229, "timestamp": "01:54:06", "text": "还记得PNG格式的那个吗？"}, {"type": "subtitle", "time": 6848.31, "timestamp": "01:54:08", "text": "一切都还好。"}, {"type": "subtitle", "time": 6851.99, "timestamp": "01:54:11", "text": "Jo，你能问问KSI起飞的事吗？"}, {"type": "subtitle", "time": 6855.27, "timestamp": "01:54:15", "text": "覆盖？什么？"}, {"type": "subtitle", "time": 6856.589, "timestamp": "01:54:16", "text": "哦，我的"}, {"type": "subtitle", "time": 6860.47, "timestamp": "01:54:20", "text": "上帝。这是谁？就是这样"}, {"type": "subtitle", "time": 6862.31, "timestamp": "01:54:22", "text": "亚历克斯。"}, {"type": "subtitle", "time": 6865.03, "timestamp": "01:54:25", "text": "当然是亚历克斯。我让他唱歌"}, {"type": "subtitle", "time": 6867.35, "timestamp": "01:54:27", "text": "就像前几天直播里的 Sigma Boy 一样。"}, {"type": "subtitle", "time": 6870.39, "timestamp": "01:54:30", "text": "他只是坐在替补席上。"}, {"type": "subtitle", "time": 6872.83, "timestamp": "01:54:32", "text": "哦，我的"}, {"type": "subtitle", "time": 6875.149, "timestamp": "01:54:35", "text": "上帝。是的。"}, {"type": "subtitle", "time": 6877.75, "timestamp": "01:54:37", "text": "再见。好的。我会把这个发给你。"}, {"type": "subtitle", "time": 6881.189, "timestamp": "01:54:41", "text": "这样我就可以随时观看 YouTube 和 Twitch 了。"}, {"type": "subtitle", "time": 6882.87, "timestamp": "01:54:42", "text": "并获得"}, {"type": "subtitle", "time": 6884.149, "timestamp": "01:54:44", "text": "有一些事情需要跟上你的所有步伐"}, {"type": "subtitle", "time": 6893.709, "timestamp": "01:54:53", "text": "疯狂的。嗯，是的。"}, {"type": "subtitle", "time": 6897.99, "timestamp": "01:54:57", "text": "2022年8月。呃，2022年是我获得……的那一年。"}]
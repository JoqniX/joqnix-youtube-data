[{"type": "subtitle", "time": 5942.31, "timestamp": "01:39:02", "text": "也是四年。我们已经拥有"}, {"type": "subtitle", "time": 5944.31, "timestamp": "01:39:04", "text": "不同浪潮的类似受众"}, {"type": "subtitle", "time": 5946.709, "timestamp": "01:39:06", "text": "就像经常影响我们喜欢什么一样"}, {"type": "subtitle", "time": 5948.79, "timestamp": "01:39:08", "text": "描绘我们自己或感知我们"}, {"type": "subtitle", "time": 5951.669, "timestamp": "01:39:11", "text": "社区整体而言。而且我认为"}, {"type": "subtitle", "time": 5953.55, "timestamp": "01:39:13", "text": "似乎要么让它变得更容易，要么"}, {"type": "subtitle", "time": 5955.91, "timestamp": "01:39:15", "text": "难的。我要说的是，就像你一样"}, {"type": "subtitle", "time": 5957.669, "timestamp": "01:39:17", "text": "起初就知道，就像星星一样。"}, {"type": "subtitle", "time": 5960.07, "timestamp": "01:39:20", "text": "我们这些滑板队员都非常疲惫"}, {"type": "subtitle", "time": 5962.47, "timestamp": "01:39:22", "text": "喜欢与人互动，也喜欢"}, {"type": "subtitle", "time": 5965.03, "timestamp": "01:39:25", "text": "ptubers 像公司一样在外面，因为"}, {"type": "subtitle", "time": 5967.35, "timestamp": "01:39:27", "text": "我们不知道人们是如何看待和看待这件事的。"}, {"type": "subtitle", "time": 5970.31, "timestamp": "01:39:30", "text": "我们也喜欢一开始的时候"}, {"type": "subtitle", "time": 5972.709, "timestamp": "01:39:32", "text": "感觉就像我一样，所以我觉得自己也在那里。"}, {"type": "subtitle", "time": 5973.55, "timestamp": "01:39:33", "text": "曾是"}, {"type": "subtitle", "time": 5975.75, "timestamp": "01:39:35", "text": "就像有些人并非如此"}, {"type": "subtitle", "time": 5978.149, "timestamp": "01:39:38", "text": "非常热情好客，就像那样"}, {"type": "subtitle", "time": 5981.189, "timestamp": "01:39:41", "text": "这在我们中间造成了一种焦虑感，"}, {"type": "subtitle", "time": 5983.43, "timestamp": "01:39:43", "text": "我们当时就想，如果我们照顾不好……"}, {"type": "subtitle", "time": 5985.109, "timestamp": "01:39:45", "text": "彼此无人"}, {"type": "subtitle", "time": 5988.229, "timestamp": "01:39:48", "text": "所以我们营造了一种环境"}, {"type": "subtitle", "time": 5990.149, "timestamp": "01:39:50", "text": "我们自己需要帮助的地方"}, {"type": "subtitle", "time": 5992.229, "timestamp": "01:39:52", "text": "互相帮助，并友善待人。"}, {"type": "subtitle", "time": 5993.91, "timestamp": "01:39:53", "text": "相互依赖。"}, {"type": "subtitle", "time": 5998.189, "timestamp": "01:39:58", "text": "我觉得这也就像我刚才说的那样。"}]
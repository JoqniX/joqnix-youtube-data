[{"type": "subtitle", "time": 17942.948, "timestamp": "04:59:02", "text": "是下周，不是这周。又一次"}, {"type": "subtitle", "time": 17944.99, "timestamp": "04:59:04", "text": "呃，想念"}, {"type": "subtitle", "time": 17949.19, "timestamp": "04:59:09", "text": "沟通上出现了一些误会。所以，呃"}, {"type": "subtitle", "time": 17953.35, "timestamp": "04:59:13", "text": "下次我不会在那里了。"}, {"type": "subtitle", "time": 17956.31, "timestamp": "04:59:16", "text": "本月底那周，也就是下周。"}, {"type": "subtitle", "time": 17960.27, "timestamp": "04:59:20", "text": "下下周，也就是最后一周"}, {"type": "subtitle", "time": 17963.27, "timestamp": "04:59:23", "text": "九月。所以是九月的最后一周。所以"}, {"type": "subtitle", "time": 17967.03, "timestamp": "04:59:27", "text": "这周我有空，我超兴奋。所以这是"}, {"type": "subtitle", "time": 17971.27, "timestamp": "04:59:31", "text": "本周日程安排。我们得到了一位粉丝"}, {"type": "subtitle", "time": 17973.23, "timestamp": "04:59:33", "text": "来自艺术"}, {"type": "subtitle", "time": 17977.19, "timestamp": "04:59:37", "text": "右边是因菲亚马。是的。所以这"}, {"type": "subtitle", "time": 17978.83, "timestamp": "04:59:38", "text": "本周我们正在进行"}, {"type": "subtitle", "time": 17982.83, "timestamp": "04:59:42", "text": "嗯，正如你在顶部的星空图中所看到的。"}, {"type": "subtitle", "time": 17986.708, "timestamp": "04:59:46", "text": "所以，我们明天有《星空》……"}, {"type": "subtitle", "time": 17989.27, "timestamp": "04:59:49", "text": "正在玩《霍格沃茨之遗》。呃，那个"}, {"type": "subtitle", "time": 17991.11, "timestamp": "04:59:51", "text": "这将是霍格沃茨的第七条线索"}, {"type": "subtitle", "time": 17993.75, "timestamp": "04:59:53", "text": "遗产。然后周二我们有个合作项目。"}, {"type": "subtitle", "time": 17998.43, "timestamp": "04:59:58", "text": "与 Aruzu 一起。我们将开始射击。"}]
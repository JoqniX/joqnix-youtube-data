[{"type": "subtitle", "time": 18962.628, "timestamp": "05:16:02", "text": "你不能带着这么多杂物旅行。"}, {"type": "subtitle", "time": 18965.99, "timestamp": "05:16:05", "text": "正确的？那么，我就告诉你我的秘密吧。什么"}, {"type": "subtitle", "time": 18966.99, "timestamp": "05:16:06", "text": "我"}, {"type": "subtitle", "time": 18970.15, "timestamp": "05:16:10", "text": "没错，我真的把它们全都倒进了一个"}, {"type": "subtitle", "time": 18977.868, "timestamp": "05:16:17", "text": "眨眼。这就是我"}, {"type": "subtitle", "time": 18984.708, "timestamp": "05:16:24", "text": "一切。我真的把所有东西都扔掉了"}, {"type": "subtitle", "time": 18988.03, "timestamp": "05:16:28", "text": "躲在角落里"}, {"type": "subtitle", "time": 18990.948, "timestamp": "05:16:30", "text": "自由的。是的。所以，我在这里并不愚蠢。"}, {"type": "subtitle", "time": 18993.628, "timestamp": "05:16:33", "text": "因为呃，有点儿有点儿有点儿得逞了。"}, {"type": "subtitle", "time": 18996.35, "timestamp": "05:16:36", "text": "凌乱的。但我所做的是"}, {"type": "subtitle", "time": 19001.19, "timestamp": "05:16:41", "text": "直接过来这边，"}, {"type": "subtitle", "time": 19002.75, "timestamp": "05:16:42", "text": "前往"}, {"type": "subtitle", "time": 19005.788, "timestamp": "05:16:45", "text": "库存，前往"}, {"type": "subtitle", "time": 19009.67, "timestamp": "05:16:49", "text": "资源，滥用我的命令。那是R"}, {"type": "subtitle", "time": 19011.31, "timestamp": "05:16:51", "text": "和"}]
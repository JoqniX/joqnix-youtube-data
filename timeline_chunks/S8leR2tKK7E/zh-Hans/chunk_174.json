[{"type": "subtitle", "time": 10442.23, "timestamp": "02:54:02", "text": "有。你不会替补的。我非常"}, {"type": "subtitle", "time": 10464.79, "timestamp": "02:54:24", "text": "因为我查看了她的账户。如果她"}, {"type": "subtitle", "time": 10466.389, "timestamp": "02:54:26", "text": "想做好，那就拍视频"}, {"type": "subtitle", "time": 10468.309, "timestamp": "02:54:28", "text": "提交内容和直播必须"}, {"type": "subtitle", "time": 10470.95, "timestamp": "02:54:30", "text": "值得考虑。她拍摄的许多视频"}, {"type": "subtitle", "time": 10473.51, "timestamp": "02:54:33", "text": "帖子浏览量不高。"}, {"type": "subtitle", "time": 10475.469, "timestamp": "02:54:35", "text": "因为它们没有对应的"}, {"type": "subtitle", "time": 10478.91, "timestamp": "02:54:38", "text": "字幕非常粗糙，而且没有"}, {"type": "subtitle", "time": 10481.55, "timestamp": "02:54:41", "text": "情境"}, {"type": "subtitle", "time": 10489.03, "timestamp": "02:54:49", "text": "相互作用。这种提交方式是"}, {"type": "subtitle", "time": 10491.67, "timestamp": "02:54:51", "text": "在B站无效。所以"}, {"type": "subtitle", "time": 10493.91, "timestamp": "02:54:53", "text": "代表必须具备以下能力："}, {"type": "subtitle", "time": 10497.03, "timestamp": "02:54:57", "text": "给她找个能编辑这种格式文件的编辑。"}, {"type": "subtitle", "time": 10499.59, "timestamp": "02:54:59", "text": "外国风味切片。在这方面，因为"}]
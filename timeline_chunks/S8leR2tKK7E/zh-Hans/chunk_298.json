[{"type": "subtitle", "time": 17883.67, "timestamp": "04:58:03", "text": "什么？我终于达到了更高的等级"}, {"type": "subtitle", "time": 17887.15, "timestamp": "04:58:07", "text": "比我当时的水平要高。"}, {"type": "subtitle", "time": 17891.15, "timestamp": "04:58:11", "text": "第二股流。"}, {"type": "subtitle", "time": 17905.43, "timestamp": "04:58:25", "text": "它？我还是不太明白。"}, {"type": "subtitle", "time": 17908.47, "timestamp": "04:58:28", "text": "是的，我现在水平更高了。"}, {"type": "subtitle", "time": 17913.47, "timestamp": "04:58:33", "text": "我不是9级，但我已经离开了。"}, {"type": "subtitle", "time": 17917.67, "timestamp": "04:58:37", "text": "但我把它留在了第二个流里。"}, {"type": "subtitle", "time": 17919.628, "timestamp": "04:58:39", "text": "所以"}, {"type": "subtitle", "time": 17922.788, "timestamp": "04:58:42", "text": "是的，我对此感到有点高兴，但是"}, {"type": "subtitle", "time": 17932.708, "timestamp": "04:58:52", "text": "是的。总之，我们也有日程安排。"}, {"type": "subtitle", "time": 17934.11, "timestamp": "04:58:54", "text": "这"}, {"type": "subtitle", "time": 17935.628, "timestamp": "04:58:55", "text": "星期。"}, {"type": "subtitle", "time": 17939.03, "timestamp": "04:58:59", "text": "是的。所以，显然它原本应该是……"}]
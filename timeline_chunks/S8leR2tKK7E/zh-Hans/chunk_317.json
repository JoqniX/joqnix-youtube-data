[{"type": "subtitle", "time": 19021.59, "timestamp": "05:17:01", "text": "把我的所有东西都扔掉吧。但我还是……"}, {"type": "subtitle", "time": 19029.868, "timestamp": "05:17:09", "text": "东西太多了，因为我没地方放。"}, {"type": "subtitle", "time": 19033.23, "timestamp": "05:17:13", "text": "迪奥。所以这是我至少能做的。"}, {"type": "subtitle", "time": 19036.55, "timestamp": "05:17:16", "text": "做。我倾尽所有资源。现在"}, {"type": "subtitle", "time": 19037.788, "timestamp": "05:17:17", "text": "时间"}, {"type": "subtitle", "time": 19041.788, "timestamp": "05:17:21", "text": "等等，为什么我还是这么重？哦"}, {"type": "subtitle", "time": 19045.23, "timestamp": "05:17:25", "text": "哦哦，老天保佑。"}, {"type": "subtitle", "time": 19049.948, "timestamp": "05:17:29", "text": "呃，等等。 H是什么？重物是什么？"}, {"type": "subtitle", "time": 19053.35, "timestamp": "05:17:33", "text": "再次？我的天哪。我觉得我应该变笨"}, {"type": "subtitle", "time": 19059.55, "timestamp": "05:17:39", "text": "也。雇佣兵"}, {"type": "subtitle", "time": 19062.83, "timestamp": "05:17:42", "text": "盒。哦，我还是好重。"}, {"type": "subtitle", "time": 19065.15, "timestamp": "05:17:45", "text": "嗯？我仍然"}, {"type": "subtitle", "time": 19067.75, "timestamp": "05:17:47", "text": "重的。不是手榴弹。我敢肯定"}, {"type": "subtitle", "time": 19069.868, "timestamp": "05:17:49", "text": "不是的"}, {"type": "subtitle", "time": 19072.628, "timestamp": "05:17:52", "text": "手榴弹。哦，可能是这艘船。"}, {"type": "subtitle", "time": 19076.07, "timestamp": "05:17:56", "text": "部分。对，就是这样。我的罪魁祸首。"}, {"type": "subtitle", "time": 19078.708, "timestamp": "05:17:58", "text": "Jama，我依然很重。我的天啊。哦不，"}]
[{"type": "subtitle", "time": 13447.59, "timestamp": "03:44:07", "text": "我想为类似的事情道歉"}, {"type": "subtitle", "time": 13454.349, "timestamp": "03:44:14", "text": "嗯，我"}, {"type": "subtitle", "time": 13457.349, "timestamp": "03:44:17", "text": "我觉得这对我来说有点难。"}, {"type": "subtitle", "time": 13460.389, "timestamp": "03:44:20", "text": "你知道，为了控制我的情绪，"}, {"type": "subtitle", "time": 13462.189, "timestamp": "03:44:22", "text": "我处于脆弱状态"}, {"type": "subtitle", "time": 13467.349, "timestamp": "03:44:27", "text": "因为我再次意识到了这一点，我知道我知道"}, {"type": "subtitle", "time": 13470.429, "timestamp": "03:44:30", "text": "类似的事情会被指出来。"}, {"type": "subtitle", "time": 13474.389, "timestamp": "03:44:34", "text": "向……发出呼喊或被告知"}]
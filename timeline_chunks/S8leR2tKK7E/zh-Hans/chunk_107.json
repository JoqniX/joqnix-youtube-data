[{"type": "subtitle", "time": 6420.709, "timestamp": "01:47:00", "text": "为什么人这么少？我们赞成这个方案。我"}, {"type": "subtitle", "time": 6422.55, "timestamp": "01:47:02", "text": "我想和所有我谈过的人合作。"}, {"type": "subtitle", "time": 6424.95, "timestamp": "01:47:04", "text": "我会去做，然后展示给……"}, {"type": "subtitle", "time": 6427.189, "timestamp": "01:47:07", "text": "我。"}, {"type": "subtitle", "time": 6429.109, "timestamp": "01:47:09", "text": "我觉得这才是真正的"}, {"type": "subtitle", "time": 6431.669, "timestamp": "01:47:11", "text": "这让你与众不同，因为就像你一样"}, {"type": "subtitle", "time": 6433.99, "timestamp": "01:47:13", "text": "总是感觉好像一切都是那样，或者"}, {"type": "subtitle", "time": 6436.31, "timestamp": "01:47:16", "text": "什么都没有，而且就像你从未……"}, {"type": "subtitle", "time": 6438.95, "timestamp": "01:47:18", "text": "歧视他人或给予"}, {"type": "subtitle", "time": 6441.669, "timestamp": "01:47:21", "text": "他们就像你知道我说的优先顺序一样。"}, {"type": "subtitle", "time": 6444.87, "timestamp": "01:47:24", "text": "或者任何类型的，比如，你说什么？"}, {"type": "subtitle", "time": 6446.79, "timestamp": "01:47:26", "text": "偏袒会表现出任何形式的偏袒。"}, {"type": "subtitle", "time": 6447.79, "timestamp": "01:47:27", "text": "在"}, {"type": "subtitle", "time": 6450.39, "timestamp": "01:47:30", "text": "社区，这需要很多"}, {"type": "subtitle", "time": 6452.709, "timestamp": "01:47:32", "text": "我不知道自己是否有能力做到这一点。"}, {"type": "subtitle", "time": 6454.47, "timestamp": "01:47:34", "text": "她怎么还能像你一样活着呢？"}, {"type": "subtitle", "time": 6456.31, "timestamp": "01:47:36", "text": "我知道，和这么多人交谈过，"}, {"type": "subtitle", "time": 6466.79, "timestamp": "01:47:46", "text": "我在里面。是啊，我的电池电量太低了。"}, {"type": "subtitle", "time": 6469.83, "timestamp": "01:47:49", "text": "但我心想，是啊，我必须这么做。"}, {"type": "subtitle", "time": 6472.87, "timestamp": "01:47:52", "text": "因为我说我会这么做，因为在这个"}, {"type": "subtitle", "time": 6475.43, "timestamp": "01:47:55", "text": "一个，呃，还有那个。而我当时"}, {"type": "subtitle", "time": 6479.189, "timestamp": "01:47:59", "text": "感觉就像是我生命的最后时刻，对吧？你。"}]
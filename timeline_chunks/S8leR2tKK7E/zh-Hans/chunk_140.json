[{"type": "subtitle", "time": 8401.91, "timestamp": "02:20:01", "text": "有时候感觉气氛很糟糕，"}, {"type": "subtitle", "time": 8403.59, "timestamp": "02:20:03", "text": "你只需要坚持下去，直到……"}, {"type": "subtitle", "time": 8406.55, "timestamp": "02:20:06", "text": "你完全可以买得起更好的。是的，"}, {"type": "subtitle", "time": 8409.03, "timestamp": "02:20:09", "text": "这是真的。是的。是的。"}, {"type": "subtitle", "time": 8411.27, "timestamp": "02:20:11", "text": "所以，这就像是一次旅程。"}, {"type": "subtitle", "time": 8417.51, "timestamp": "02:20:17", "text": "嗯，这其实也是我担心的事之一。"}, {"type": "subtitle", "time": 8420.55, "timestamp": "02:20:20", "text": "嗯，如果我选择预算友好的方案呢？"}, {"type": "subtitle", "time": 8423.99, "timestamp": "02:20:23", "text": "目前有哪些资产？人们会这样吗？"}, {"type": "subtitle", "time": 8427.349, "timestamp": "02:20:27", "text": "推迟？他们会因为什么而感到不自在吗？"}, {"type": "subtitle", "time": 8429.59, "timestamp": "02:20:29", "text": "他们确实看到了首映礼以及所有的一切。"}, {"type": "subtitle", "time": 8433.75, "timestamp": "02:20:33", "text": "他们会说：“呃，为什么是……”"}, {"type": "subtitle", "time": 8437.27, "timestamp": "02:20:37", "text": "资产类型很奇怪？我以为它会……"}, {"type": "subtitle", "time": 8440.07, "timestamp": "02:20:40", "text": "与……的质量相当"}, {"type": "subtitle", "time": 8442.55, "timestamp": "02:20:42", "text": "美泰或者类似的东西，人们有"}, {"type": "subtitle", "time": 8444.55, "timestamp": "02:20:44", "text": "现在他们对质量的期望是这样的"}, {"type": "subtitle", "time": 8447.67, "timestamp": "02:20:47", "text": "观看你的首秀直播。但我没有"}, {"type": "subtitle", "time": 8450.79, "timestamp": "02:20:50", "text": "想想很多人都会那样做"}, {"type": "subtitle", "time": 8453.83, "timestamp": "02:20:53", "text": "一开始就这么说，因为他们就像你知道的那样。"}, {"type": "subtitle", "time": 8456.55, "timestamp": "02:20:56", "text": "在那里支持你，也喜欢观看"}, {"type": "subtitle", "time": 8459.03, "timestamp": "02:20:59", "text": "你的旅程。除此之外，就像那里"}]
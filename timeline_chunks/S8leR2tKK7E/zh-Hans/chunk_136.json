[{"type": "subtitle", "time": 8161.589, "timestamp": "02:16:01", "text": "场景。艺术方面的东西还没完全……"}, {"type": "subtitle", "time": 8163.99, "timestamp": "02:16:03", "text": "足够远。所以可能存在"}, {"type": "subtitle", "time": 8167.03, "timestamp": "02:16:07", "text": "改变它的方法等等。"}, {"type": "subtitle", "time": 8169.83, "timestamp": "02:16:09", "text": "所以我就想，我不应该冒太大的风险。"}, {"type": "subtitle", "time": 8171.669, "timestamp": "02:16:11", "text": "有点儿。"}, {"type": "subtitle", "time": 8174.629, "timestamp": "02:16:14", "text": "我觉得你应该做一些类似的事情。"}, {"type": "subtitle", "time": 8176.95, "timestamp": "02:16:16", "text": "Chocolaton 预览结束几秒钟"}, {"type": "subtitle", "time": 8179.27, "timestamp": "02:16:19", "text": "最后一集。"}, {"type": "subtitle", "time": 8181.109, "timestamp": "02:16:21", "text": "几秒钟就像全彩或"}, {"type": "subtitle", "time": 8184.069, "timestamp": "02:16:24", "text": "像一个轮廓"}, {"type": "subtitle", "time": 8187.51, "timestamp": "02:16:27", "text": "任何你想要的。哦，等等。我"}, {"type": "subtitle", "time": 8189.99, "timestamp": "02:16:29", "text": "我想我可能得为此付费。"}, {"type": "subtitle", "time": 8194.07, "timestamp": "02:16:34", "text": "为了做到这一点。好的，我会试试。"}, {"type": "subtitle", "time": 8196.309, "timestamp": "02:16:36", "text": "你还有时间喜欢你"}, {"type": "subtitle", "time": 8202.509, "timestamp": "02:16:42", "text": "并非如此。"}, {"type": "subtitle", "time": 8205.91, "timestamp": "02:16:45", "text": "是的。但我确实有些担忧，"}, {"type": "subtitle", "time": 8209.83, "timestamp": "02:16:49", "text": "那里。你知道，如果我的爸爸妈妈"}, {"type": "subtitle", "time": 8211.669, "timestamp": "02:16:51", "text": "抛弃我，然后说：“不，我不想。”"}, {"type": "subtitle", "time": 8214.23, "timestamp": "02:16:54", "text": "我还想继续做下去吗？”或者类似的话。"}, {"type": "subtitle", "time": 8216.91, "timestamp": "02:16:56", "text": "不，我会失去母亲。我将"}]
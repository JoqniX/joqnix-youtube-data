[{"type": "subtitle", "time": 3129.19, "timestamp": "00:52:09", "text": "嗯，注意身体健康。不要结束"}, {"type": "subtitle", "time": 3130.27, "timestamp": "00:52:10", "text": "向上"}, {"type": "subtitle", "time": 3132.589, "timestamp": "00:52:12", "text": "医院。"}, {"type": "subtitle", "time": 3135.589, "timestamp": "00:52:15", "text": "兄弟，你为什么总是说同样的话？我的"}, {"type": "subtitle", "time": 3137.99, "timestamp": "00:52:17", "text": "今天爸爸告诉我这件事，我们为此吵了一架。"}, {"type": "subtitle", "time": 3141.95, "timestamp": "00:52:21", "text": "关于那件事。你为什么这么说？"}, {"type": "subtitle", "time": 3144.75, "timestamp": "00:52:24", "text": "东西？呃，回来"}, {"type": "subtitle", "time": 3147.069, "timestamp": "00:52:27", "text": "向上。"}, {"type": "subtitle", "time": 3149.75, "timestamp": "00:52:29", "text": "笨蛋。哦，你只听这个"}, {"type": "subtitle", "time": 3151.589, "timestamp": "00:52:31", "text": "看待。现在，我不会听樱的话了。"}, {"type": "subtitle", "time": 3152.829, "timestamp": "00:52:32", "text": "今天。"}, {"type": "subtitle", "time": 3154.79, "timestamp": "00:52:34", "text": "其实，老实说，我不会"}, {"type": "subtitle", "time": 3157.829, "timestamp": "00:52:37", "text": "听任何人的话。我已经准备好了"}, {"type": "subtitle", "time": 3159.47, "timestamp": "00:52:39", "text": "去死。不"}, {"type": "subtitle", "time": 3161.99, "timestamp": "00:52:41", "text": "担心。我的意思是，别杀我。我"}, {"type": "subtitle", "time": 3171.99, "timestamp": "00:52:51", "text": "也就是说，我不知道。我只需要做"}, {"type": "subtitle", "time": 3174.43, "timestamp": "00:52:54", "text": "这声哭喊，你"}, {"type": "subtitle", "time": 3177.91, "timestamp": "00:52:57", "text": "知道。我知道这不是这样，这不"}]
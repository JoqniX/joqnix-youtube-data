[{"type": "subtitle", "time": 2675.75, "timestamp": "00:44:35", "text": "雅虎。什么？你呢？我很好。"}, {"type": "subtitle", "time": 2677.23, "timestamp": "00:44:37", "text": "我很好，"}, {"type": "subtitle", "time": 2680.79, "timestamp": "00:44:40", "text": "实际上。只是拥有某种主修学位"}, {"type": "subtitle", "time": 2683.63, "timestamp": "00:44:43", "text": "头疼，但我"}, {"type": "subtitle", "time": 2686.67, "timestamp": "00:44:46", "text": "好的。是的，我看到了那条推文。"}, {"type": "subtitle", "time": 2696.67, "timestamp": "00:44:56", "text": "[音乐]"}, {"type": "subtitle", "time": 2699.79, "timestamp": "00:44:59", "text": "某人。你好。嗯，是的。"}]
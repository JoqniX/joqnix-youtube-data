[{"type": "subtitle", "time": 1800.11, "timestamp": "00:30:00", "text": "是的，"}, {"type": "subtitle", "time": 1803.669, "timestamp": "00:30:03", "text": "所以我的意思是，对于今天到来的这件事来说"}, {"type": "subtitle", "time": 1807.19, "timestamp": "00:30:07", "text": "真的意义重大，所有人都如此"}, {"type": "subtitle", "time": 1816.11, "timestamp": "00:30:16", "text": "今天蜂蜜溪尼沙德"}, {"type": "subtitle", "time": 1821.11, "timestamp": "00:30:21", "text": "当时 Akabun 来了，然后 P 也来了。然后"}, {"type": "subtitle", "time": 1822.909, "timestamp": "00:30:22", "text": "还有谁？"}, {"type": "subtitle", "time": 1827.59, "timestamp": "00:30:27", "text": "这里？哦，维克多的儿子来过这里。然后"}, {"type": "subtitle", "time": 1829.99, "timestamp": "00:30:29", "text": "然后然后"}, {"type": "subtitle", "time": 1839.23, "timestamp": "00:30:39", "text": "这里。嗯。然后是罗坤"}, {"type": "subtitle", "time": 1842.389, "timestamp": "00:30:42", "text": "这里。那么当时还有谁？我是否"}, {"type": "subtitle", "time": 1845.669, "timestamp": "00:30:45", "text": "想念谁吗？还有一个新人和他在一起"}, {"type": "chat", "time": 1846.192, "timestamp": "00:30:46", "author": "@wildan19gta73", "avatar": "https://yt4.ggpht.com/ytc/AIdro_ltgSuqdkVmFy7b8YNX34dHb6whG0lODXr6m68zEAgk=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ8_8KpS3_9EP-duW6QoUCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ8_8KpS3_9EP-duW6QoUCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ8_8KpS3_9EP-duW6QoUCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ8_8KpS3_9EP-duW6QoUCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ8_8KpS3_9EP-duW6QoUCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ8_8KpS3_9EP-duW6Qo"}, {"type": "subtitle", "time": 1851.47, "timestamp": "00:30:51", "text": "利奥尼亚"}, {"type": "subtitle", "time": 1854.43, "timestamp": "00:30:54", "text": "哈尔来了。真的，老兄。这意味着"}, {"type": "subtitle", "time": 1855.95, "timestamp": "00:30:55", "text": "很多。"}]
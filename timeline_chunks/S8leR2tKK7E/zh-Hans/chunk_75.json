[{"type": "subtitle", "time": 4500.149, "timestamp": "01:15:00", "text": "你真的很期待"}, {"type": "subtitle", "time": 4501.83, "timestamp": "01:15:01", "text": "你知道，它到底在做什么？"}, {"type": "subtitle", "time": 4505.83, "timestamp": "01:15:05", "text": "再次以它作为首秀，这会是……"}, {"type": "subtitle", "time": 4507.99, "timestamp": "01:15:07", "text": "展现你对……的热情"}, {"type": "subtitle", "time": 4510.99, "timestamp": "01:15:10", "text": "一般的？"}, {"type": "subtitle", "time": 4514.79, "timestamp": "01:15:14", "text": "是啊，太棒了。我的意思是，它很漂亮"}, {"type": "subtitle", "time": 4516.709, "timestamp": "01:15:16", "text": "我会努力工作的事实"}, {"type": "subtitle", "time": 4520.79, "timestamp": "01:15:20", "text": "所以，这个笨蛋之所以能活过来，是因为"}, {"type": "subtitle", "time": 4523.669, "timestamp": "01:15:23", "text": "我对此感到兴奋，因为它是……"}, {"type": "subtitle", "time": 4526.95, "timestamp": "01:15:26", "text": "数量巨大。所以，不过话说回来，我并不介意。"}, {"type": "subtitle", "time": 4530.59, "timestamp": "01:15:30", "text": "我在日本努力兼职工作"}, {"type": "subtitle", "time": 4533.11, "timestamp": "01:15:33", "text": "一切，无论多少年"}, {"type": "subtitle", "time": 4534.91, "timestamp": "01:15:34", "text": "需要，你"}, {"type": "subtitle", "time": 4537.51, "timestamp": "01:15:37", "text": "要知道，你已经很努力了。我"}, {"type": "subtitle", "time": 4538.95, "timestamp": "01:15:38", "text": "我觉得这已经根深蒂固了。"}, {"type": "subtitle", "time": 4541.27, "timestamp": "01:15:41", "text": "此时此刻的你。你知道，有"}, {"type": "subtitle", "time": 4543.189, "timestamp": "01:15:43", "text": "有些人会慢慢发疯"}, {"type": "subtitle", "time": 4544.79, "timestamp": "01:15:44", "text": "如果你不是一直在工作的话。我"}, {"type": "subtitle", "time": 4546.39, "timestamp": "01:15:46", "text": "我认为你就是那种人，因为"}, {"type": "subtitle", "time": 4548.47, "timestamp": "01:15:48", "text": "我从没见过你这样，你知道的，"}, {"type": "subtitle", "time": 4554.83, "timestamp": "01:15:54", "text": "说得太对了。"}, {"type": "subtitle", "time": 4558.51, "timestamp": "01:15:58", "text": "M，这太令人担忧了，因为我觉得"}]
[{"type": "subtitle", "time": 18660.51, "timestamp": "05:11:00", "text": "呃"}, {"type": "subtitle", "time": 18664.55, "timestamp": "05:11:04", "text": "铁。那些拉铁的人"}, {"type": "subtitle", "time": 18666.07, "timestamp": "05:11:06", "text": "拉"}, {"type": "subtitle", "time": 18669.43, "timestamp": "05:11:09", "text": "呃，铝。所以我现在在做基础农场工作。"}, {"type": "subtitle", "time": 18672.708, "timestamp": "05:11:12", "text": "这边。铝铁矿场。我"}, {"type": "subtitle", "time": 18673.788, "timestamp": "05:11:13", "text": "有我的"}, {"type": "subtitle", "time": 18677.19, "timestamp": "05:11:17", "text": "飞船，而我真的有萨拉"}, {"type": "subtitle", "time": 18679.628, "timestamp": "05:11:19", "text": "在那边。我拥有所有本"}, {"type": "subtitle", "time": 18682.03, "timestamp": "05:11:22", "text": "工作福利实验室和"}, {"type": "subtitle", "time": 18684.59, "timestamp": "05:11:24", "text": "一切。哦，是的。是的。"}, {"type": "subtitle", "time": 18693.07, "timestamp": "05:11:33", "text": "方式？哦，我是"}, {"type": "subtitle", "time": 18696.51, "timestamp": "05:11:36", "text": "这里。有"}, {"type": "subtitle", "time": 18698.35, "timestamp": "05:11:38", "text": "我。但"}, {"type": "subtitle", "time": 18702.23, "timestamp": "05:11:42", "text": "是的，我有一张床。双面床。"}, {"type": "subtitle", "time": 18706.91, "timestamp": "05:11:46", "text": "两张床，够我们两个人用。所以她也可以"}, {"type": "subtitle", "time": 18710.788, "timestamp": "05:11:50", "text": "睡觉。我真的会这么做。过来"}, {"type": "subtitle", "time": 18714.39, "timestamp": "05:11:54", "text": "这里。你看，铝的纯度是999%吗？我"}, {"type": "subtitle", "time": 18716.628, "timestamp": "05:11:56", "text": "过来这边。不，不，不。我不得不"}, {"type": "subtitle", "time": 18718.07, "timestamp": "05:11:58", "text": "先睡觉。等等，等等，等等，等等。"}]
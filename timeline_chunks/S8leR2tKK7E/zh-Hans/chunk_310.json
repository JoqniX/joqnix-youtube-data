[{"type": "subtitle", "time": 18609.03, "timestamp": "05:10:09", "text": "我付出了那么多努力，才让你达到目标。"}, {"type": "subtitle", "time": 18610.67, "timestamp": "05:10:10", "text": "等级"}, {"type": "subtitle", "time": 18615.55, "timestamp": "05:10:15", "text": "479. 你想知道我的秘密吗？眨眼"}, {"type": "subtitle", "time": 18621.948, "timestamp": "05:10:21", "text": "秘密？能"}, {"type": "subtitle", "time": 18625.27, "timestamp": "05:10:25", "text": "我？你想知道吗？是的。所以，那些"}, {"type": "subtitle", "time": 18628.628, "timestamp": "05:10:28", "text": "是我的宝贝们。如你所见，那些"}, {"type": "subtitle", "time": 18631.15, "timestamp": "05:10:31", "text": "胸部上方"}, {"type": "subtitle", "time": 18633.83, "timestamp": "05:10:33", "text": "那边，那边的那些箱子，那些"}, {"type": "subtitle", "time": 18635.51, "timestamp": "05:10:35", "text": "是我的宝贝们。别管我的健康状况"}, {"type": "subtitle", "time": 18638.07, "timestamp": "05:10:38", "text": "归零是因为我太超级超级"}, {"type": "subtitle", "time": 18641.99, "timestamp": "05:10:41", "text": "负担过重。所以，这些"}, {"type": "subtitle", "time": 18645.35, "timestamp": "05:10:45", "text": "我觉得这边去要好得多。"}, {"type": "subtitle", "time": 18647.51, "timestamp": "05:10:47", "text": "到"}, {"type": "subtitle", "time": 18648.75, "timestamp": "05:10:48", "text": "呃，这个"}, {"type": "subtitle", "time": 18653.23, "timestamp": "05:10:53", "text": "事物。所以，这些是我的"}, {"type": "subtitle", "time": 18657.35, "timestamp": "05:10:57", "text": "婴儿。这些拉，呃，我相信，呃，这些"}, {"type": "subtitle", "time": 18659.35, "timestamp": "05:10:59", "text": "像"}]
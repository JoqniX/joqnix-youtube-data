[{"type": "subtitle", "time": 6660.31, "timestamp": "01:51:00", "text": "我该如何自己动手呢？"}, {"type": "subtitle", "time": 6665.07, "timestamp": "01:51:05", "text": "随便挑几个人来帮你。"}, {"type": "subtitle", "time": 6668.47, "timestamp": "01:51:08", "text": "是的。就像在参加 Jakathon 马拉松之前一样，我确实有"}, {"type": "subtitle", "time": 6672.75, "timestamp": "01:51:12", "text": "嗯，我问过一些人。"}, {"type": "subtitle", "time": 6675.43, "timestamp": "01:51:15", "text": "因为那些参加过萨巴松的人"}, {"type": "subtitle", "time": 6678.709, "timestamp": "01:51:18", "text": "之前在 Twitch 上，我该怎么做？"}, {"type": "subtitle", "time": 6679.709, "timestamp": "01:51:19", "text": "和"}, {"type": "subtitle", "time": 6684.149, "timestamp": "01:51:24", "text": "尤其是因为我同时在进行多目标开发。"}, {"type": "subtitle", "time": 6686.39, "timestamp": "01:51:26", "text": "呃，YouTube现在的缩略图问题"}, {"type": "subtitle", "time": 6690.47, "timestamp": "01:51:30", "text": "一切都是因为，嗯，我没有其他人。"}, {"type": "subtitle", "time": 6692.99, "timestamp": "01:51:32", "text": "在执行多路复用操作时"}, {"type": "subtitle", "time": 6696.47, "timestamp": "01:51:36", "text": "虽然很辛苦，但我还是完成了。"}, {"type": "subtitle", "time": 6699.51, "timestamp": "01:51:39", "text": "注意其他创作者做了什么"}, {"type": "subtitle", "time": 6702.87, "timestamp": "01:51:42", "text": "就像你，他们也有同样的"}, {"type": "subtitle", "time": 6705.669, "timestamp": "01:51:45", "text": "一直都有缩略图，所以我才这么做了"}, {"type": "subtitle", "time": 6709.109, "timestamp": "01:51:49", "text": "格式一样，但是是用我的……做的"}, {"type": "subtitle", "time": 6711.669, "timestamp": "01:51:51", "text": "我用它做了些改变，我把我的"}, {"type": "subtitle", "time": 6714.95, "timestamp": "01:51:54", "text": "这款模型的配色方案也融入其中。"}, {"type": "subtitle", "time": 6719.43, "timestamp": "01:51:59", "text": "比如三月的蓝色，紫罗兰色的紫色"}]
[{"type": "subtitle", "time": 3722.309, "timestamp": "01:02:02", "text": "我知道。前辈，你好吗？怎么样？"}, {"type": "subtitle", "time": 3733.27, "timestamp": "01:02:13", "text": "健康状况一直不太好。"}, {"type": "subtitle", "time": 3737.27, "timestamp": "01:02:17", "text": "哦，是的。完全理解。是的。"}, {"type": "subtitle", "time": 3739.91, "timestamp": "01:02:19", "text": "但是，没关系。我，我，嗯，我"}, {"type": "subtitle", "time": 3744.15, "timestamp": "01:02:24", "text": "闲逛，或者说，以某种方式待在那里。"}, {"type": "subtitle", "time": 3747.43, "timestamp": "01:02:27", "text": "我的意思是，前辈，我真为你感到骄傲。你"}, {"type": "subtitle", "time": 3749.589, "timestamp": "01:02:29", "text": "就像每天都要经历那么多事一样"}, {"type": "subtitle", "time": 3751.589, "timestamp": "01:02:31", "text": "而且仍然设法传播了这么多"}, {"type": "subtitle", "time": 3753.109, "timestamp": "01:02:33", "text": "给他人带来积极和快乐"}, {"type": "subtitle", "time": 3755.03, "timestamp": "01:02:35", "text": "人们。我的意思是，我有很多"}, {"type": "subtitle", "time": 3757.51, "timestamp": "01:02:37", "text": "尊重你"}, {"type": "subtitle", "time": 3759.549, "timestamp": "01:02:39", "text": "喜欢"}, {"type": "subtitle", "time": 3764.47, "timestamp": "01:02:44", "text": "真的，是的，是的，一直都有"}, {"type": "subtitle", "time": 3766.91, "timestamp": "01:02:46", "text": "期间发生了很多事情"}, {"type": "subtitle", "time": 3771.19, "timestamp": "01:02:51", "text": "乔森，呃，我是"}, {"type": "subtitle", "time": 3775.03, "timestamp": "01:02:55", "text": "这段时间很艰难。是的，曾经像你一样。"}, {"type": "subtitle", "time": 3777.109, "timestamp": "01:02:57", "text": "完成它，就像睡觉一样。"}, {"type": "subtitle", "time": 3779.589, "timestamp": "01:02:59", "text": "整整两天。我认为你值得拥有"}]
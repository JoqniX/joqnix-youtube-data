[{"type": "subtitle", "time": 9722.27, "timestamp": "02:42:02", "text": "啊，代表是做什么的？"}, {"type": "subtitle", "time": 9723.389, "timestamp": "02:42:03", "text": "[音乐]"}, {"type": "subtitle", "time": 9726.55, "timestamp": "02:42:06", "text": "意思是？等等，什么？你们觉得怎么样？"}, {"type": "subtitle", "time": 9728.91, "timestamp": "02:42:08", "text": "代表"}, {"type": "subtitle", "time": 9731.11, "timestamp": "02:42:11", "text": "意思是？等等，等等，等等，等等，等等。让"}, {"type": "subtitle", "time": 9734.23, "timestamp": "02:42:14", "text": "让我再读一遍。"}, {"type": "subtitle", "time": 9736.79, "timestamp": "02:42:16", "text": "因为我们通常和外国人一起工作"}, {"type": "subtitle", "time": 9739.59, "timestamp": "02:42:19", "text": "在中国设有代表处，即"}, {"type": "subtitle", "time": 9741.59, "timestamp": "02:42:21", "text": "主要方便沟通和"}, {"type": "subtitle", "time": 9744.83, "timestamp": "02:42:24", "text": "避免诸如时间之类的问题"}, {"type": "subtitle", "time": 9746.75, "timestamp": "02:42:26", "text": "落后。时间"}, {"type": "subtitle", "time": 9750.15, "timestamp": "02:42:30", "text": "落后。我的意思是，我们说的时间延迟是多少？"}, {"type": "subtitle", "time": 9751.55, "timestamp": "02:42:31", "text": "关于你"}, {"type": "subtitle", "time": 9762.07, "timestamp": "02:42:42", "text": "啊，我该怎么办？我该怎么办？什么"}, {"type": "subtitle", "time": 9770.51, "timestamp": "02:42:50", "text": "[音乐]"}, {"type": "subtitle", "time": 9778.83, "timestamp": "02:42:58", "text": "莉娅。"}]
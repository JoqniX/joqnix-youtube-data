[{"type": "subtitle", "time": 12668.469, "timestamp": "03:31:08", "text": "嗯，我想里面有一些有趣的片段。"}, {"type": "subtitle", "time": 12671.03, "timestamp": "03:31:11", "text": "直播。我猜投诉都消失了。"}, {"type": "subtitle", "time": 12672.429, "timestamp": "03:31:12", "text": "那里。"}, {"type": "subtitle", "time": 12674.469, "timestamp": "03:31:14", "text": "你来自哪里并不重要。"}, {"type": "subtitle", "time": 12676.07, "timestamp": "03:31:16", "text": "事实上，人们的疯狂才是全部。"}, {"type": "subtitle", "time": 12677.59, "timestamp": "03:31:17", "text": "相同的。无论你来自哪个国家，"}, {"type": "subtitle", "time": 12678.87, "timestamp": "03:31:18", "text": "大家都这样。他们很好"}, {"type": "subtitle", "time": 12680.469, "timestamp": "03:31:20", "text": "这些人，而且他们是坏人。人们"}, {"type": "subtitle", "time": 12684.71, "timestamp": "03:31:24", "text": "谁排除恶意，无论"}, {"type": "subtitle", "time": 12686.71, "timestamp": "03:31:26", "text": "无论你多么优秀，他们都会攻击你。"}, {"type": "subtitle", "time": 12689.269, "timestamp": "03:31:29", "text": "随机物体。它们是解剖它有"}, {"type": "subtitle", "time": 12691.03, "timestamp": "03:31:31", "text": "你来的地方没什么事可做，"}, {"type": "subtitle", "time": 12692.75, "timestamp": "03:31:32", "text": "你来了"}, {"type": "subtitle", "time": 12696.229, "timestamp": "03:31:36", "text": "从。我听说有些人"}, {"type": "subtitle", "time": 12697.55, "timestamp": "03:31:37", "text": "是"}, {"type": "subtitle", "time": 12706.309, "timestamp": "03:31:46", "text": "各机构是造成混乱的罪魁祸首。"}, {"type": "subtitle", "time": 12707.51, "timestamp": "03:31:47", "text": "时间。每个人都有自己的"}, {"type": "subtitle", "time": 12711.59, "timestamp": "03:31:51", "text": "优先事项。是的。问题是我没有"}]
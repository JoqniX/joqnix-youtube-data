[{"type": "subtitle", "time": 1653.149, "timestamp": "00:27:33", "text": "我终于又回来了。哦"}, {"type": "subtitle", "time": 1656.43, "timestamp": "00:27:36", "text": "上帝。嘿，嗯……"}, {"type": "subtitle", "time": 1660.149, "timestamp": "00:27:40", "text": "指挥官。嗯。我刚才说到哪儿了？你"}, {"type": "subtitle", "time": 1663.59, "timestamp": "00:27:43", "text": "切换到皮肤。"}, {"type": "subtitle", "time": 1666.909, "timestamp": "00:27:46", "text": "你好。我回来了"}, {"type": "subtitle", "time": 1670.549, "timestamp": "00:27:50", "text": "再次。我希望我没让你们觉得……呃"}, {"type": "subtitle", "time": 1674.11, "timestamp": "00:27:54", "text": "等待时间太长了。你好。所以，"}, {"type": "subtitle", "time": 1677.71, "timestamp": "00:27:57", "text": "呃，我刚才说到哪儿了？"}]
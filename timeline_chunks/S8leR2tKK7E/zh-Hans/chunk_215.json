[{"type": "subtitle", "time": 12919.349, "timestamp": "03:35:19", "text": "就像我现在这样，如果我……"}, {"type": "subtitle", "time": 12924.469, "timestamp": "03:35:24", "text": "说实话，我觉得如果我有钱的话"}, {"type": "subtitle", "time": 12926.87, "timestamp": "03:35:26", "text": "当时对我来说这不是问题。"}, {"type": "subtitle", "time": 12930.79, "timestamp": "03:35:30", "text": "确实雇人做了些事"}, {"type": "subtitle", "time": 12933.19, "timestamp": "03:35:33", "text": "以及他们所拥有的一切。即使我"}, {"type": "subtitle", "time": 12935.03, "timestamp": "03:35:35", "text": "我现在没钱，我会"}, {"type": "subtitle", "time": 12937.75, "timestamp": "03:35:37", "text": "实际上，他们是因付出时间而获得报酬。"}, {"type": "subtitle", "time": 12952.51, "timestamp": "03:35:52", "text": "正确的？以及所有这一切"}, {"type": "subtitle", "time": 12958.29, "timestamp": "03:35:58", "text": "理解。"}]
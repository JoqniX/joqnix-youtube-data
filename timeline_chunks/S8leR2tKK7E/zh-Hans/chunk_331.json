[{"type": "subtitle", "time": 19863.03, "timestamp": "05:31:03", "text": "通常在某些星球上，当你跳跃时"}, {"type": "subtitle", "time": 19865.75, "timestamp": "05:31:05", "text": "现在，如果你超过这个值，就会立即死亡。"}, {"type": "subtitle", "time": 19869.39, "timestamp": "05:31:09", "text": "如果他们有这么多……那就太累赘了"}, {"type": "subtitle", "time": 19873.31, "timestamp": "05:31:13", "text": "比如环境影响之类的影响。"}, {"type": "subtitle", "time": 19876.03, "timestamp": "05:31:16", "text": "不，这有点疼。"}, {"type": "subtitle", "time": 19878.67, "timestamp": "05:31:18", "text": "即使"}, {"type": "subtitle", "time": 19888.548, "timestamp": "05:31:28", "text": "环境条件什么的，我需要"}, {"type": "subtitle", "time": 19892.47, "timestamp": "05:31:32", "text": "要将其升级到最高等级才能"}, {"type": "subtitle", "time": 19903.83, "timestamp": "05:31:43", "text": "一切。这是最重要的事。"}]
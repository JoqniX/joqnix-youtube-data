[{"type": "subtitle", "time": 6481.31, "timestamp": "01:48:01", "text": "我永远无法预知未来会发生什么。"}, {"type": "subtitle", "time": 6484.95, "timestamp": "01:48:04", "text": "如果我能够直播的话，我会去日本。"}, {"type": "subtitle", "time": 6487.27, "timestamp": "01:48:07", "text": "7 月份可以观看吗？或者我还能……"}, {"type": "subtitle", "time": 6489.35, "timestamp": "01:48:09", "text": "至少在八月份我的直播期间会进行直播。"}, {"type": "subtitle", "time": 6492.51, "timestamp": "01:48:12", "text": "生日，或者我是否会过生日"}, {"type": "subtitle", "time": 6496.629, "timestamp": "01:48:16", "text": "溪流。谁知道呢，对吧？但是，我"}, {"type": "subtitle", "time": 6498.709, "timestamp": "01:48:18", "text": "想好好珍藏这些回忆"}, {"type": "subtitle", "time": 6501.51, "timestamp": "01:48:21", "text": "我接触过的每一个人"}, {"type": "subtitle", "time": 6505.109, "timestamp": "01:48:25", "text": "和他们重新建立联系等等"}, {"type": "subtitle", "time": 6506.95, "timestamp": "01:48:26", "text": "因为我不喜欢你这个事实。"}, {"type": "subtitle", "time": 6510.75, "timestamp": "01:48:30", "text": "你知道，你和人们交谈"}, {"type": "subtitle", "time": 6513.99, "timestamp": "01:48:33", "text": "嗯，是的，你和人们交谈，因为"}, {"type": "subtitle", "time": 6517.189, "timestamp": "01:48:37", "text": "你走吧，生活来了，你为了……"}, {"type": "subtitle", "time": 6519.83, "timestamp": "01:48:39", "text": "继续前进，把他们忘掉。但"}, {"type": "subtitle", "time": 6521.83, "timestamp": "01:48:41", "text": "即使你看着它们并注意到"}, {"type": "subtitle", "time": 6522.669, "timestamp": "01:48:42", "text": "他们的"}, {"type": "subtitle", "time": 6526.87, "timestamp": "01:48:46", "text": "存在感，你会害怕，就像，“哦，如果……”"}, {"type": "subtitle", "time": 6529.43, "timestamp": "01:48:49", "text": "他们不记得我了吗？"}, {"type": "subtitle", "time": 6530.79, "timestamp": "01:48:50", "text": "我不喜欢这个事实。我当时想，"}, {"type": "subtitle", "time": 6533.75, "timestamp": "01:48:53", "text": "“嗯，如果我在我的Discord服务器上看到你……”"}, {"type": "subtitle", "time": 6535.189, "timestamp": "01:48:55", "text": "来自我的朋友列表之类的"}, {"type": "chat", "time": 6537.142, "timestamp": "01:48:57", "author": "@dewaldschindler", "avatar": "https://yt4.ggpht.com/3EVruqmqk1scvSVFMNEK-_3U_bDPbV3oLWY0DmJGgIBrob_Npg2Pj8bGvnYQamBzT9SiK6ut1w=s64-c-k-c0x00ffffff-no-rj", "message": "Twitch is offline "}, {"type": "subtitle", "time": 6537.35, "timestamp": "01:48:57", "text": "我打算联系你。"}, {"type": "chat", "time": 6539.709, "timestamp": "01:48:59", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! dewald schindler~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 6539.83, "timestamp": "01:48:59", "text": "即使你忘记了"}]
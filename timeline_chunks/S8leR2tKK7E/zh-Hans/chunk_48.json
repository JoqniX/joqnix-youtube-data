[{"type": "subtitle", "time": 2885.349, "timestamp": "00:48:05", "text": "知道。是的。亲爱的，你好吗？以及如何"}, {"type": "subtitle", "time": 2887.79, "timestamp": "00:48:07", "text": "睡着了吗？哦，"}, {"type": "subtitle", "time": 2891.55, "timestamp": "00:48:11", "text": "你好。睡眠质量如何？"}, {"type": "subtitle", "time": 2893.54, "timestamp": "00:48:13", "text": "嗯，我甚至应该"}, {"type": "subtitle", "time": 2896.19, "timestamp": "00:48:16", "text": "[音乐]"}, {"type": "subtitle", "time": 2898.589, "timestamp": "00:48:18", "text": "我睡着了"}, {"type": "subtitle", "time": 2901.549, "timestamp": "00:48:21", "text": "4，醒来"}, {"type": "subtitle", "time": 2907.71, "timestamp": "00:48:27", "text": "[音乐]"}, {"type": "subtitle", "time": 2910.15, "timestamp": "00:48:30", "text": "好的。昨天，不知何故，你"}, {"type": "subtitle", "time": 2913.109, "timestamp": "00:48:33", "text": "我知道，在做事情的时候，"}, {"type": "subtitle", "time": 2915.27, "timestamp": "00:48:35", "text": "呃，我当时都看不清东西。"}, {"type": "subtitle", "time": 2918.549, "timestamp": "00:48:38", "text": "原因不明。就像现在我能看到"}, {"type": "subtitle", "time": 2920.87, "timestamp": "00:48:40", "text": "像所有信件之类的东西一样妥善处理"}, {"type": "subtitle", "time": 2923.03, "timestamp": "00:48:43", "text": "每一个字母，每一件事，都伴随着我的眼镜"}, {"type": "subtitle", "time": 2925.91, "timestamp": "00:48:45", "text": "在。但昨天不知何故你"}, {"type": "subtitle", "time": 2929.069, "timestamp": "00:48:49", "text": "知道一切究竟是什么"}, {"type": "subtitle", "time": 2932.39, "timestamp": "00:48:52", "text": "模糊不清，我甚至都看不清字。"}, {"type": "subtitle", "time": 2934.51, "timestamp": "00:48:54", "text": "我当时真的"}, {"type": "subtitle", "time": 2939.03, "timestamp": "00:48:59", "text": "头痛。我熬了一整夜"}]
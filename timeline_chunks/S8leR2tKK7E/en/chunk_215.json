[{"type": "subtitle", "time": 12919.349, "timestamp": "03:35:19", "text": "Like it's like for me now if I were to"}, {"type": "subtitle", "time": 12924.469, "timestamp": "03:35:24", "text": "be honest I feel like if I had if money"}, {"type": "subtitle", "time": 12926.87, "timestamp": "03:35:26", "text": "was not an issue for me then I would"}, {"type": "subtitle", "time": 12930.79, "timestamp": "03:35:30", "text": "have literally hired people to do stuff"}, {"type": "subtitle", "time": 12933.19, "timestamp": "03:35:33", "text": "and everything for their time. Even if I"}, {"type": "subtitle", "time": 12935.03, "timestamp": "03:35:35", "text": "didn't have money at the moment, I will"}, {"type": "subtitle", "time": 12937.75, "timestamp": "03:35:37", "text": "literally pay them because of their time"}, {"type": "subtitle", "time": 12952.51, "timestamp": "03:35:52", "text": "right? And all that"}, {"type": "subtitle", "time": 12958.29, "timestamp": "03:35:58", "text": "understand."}]
[{"type": "subtitle", "time": 5163.99, "timestamp": "01:26:03", "text": "I wish I was there."}, {"type": "subtitle", "time": 5167.03, "timestamp": "01:26:07", "text": "You can always set up a collab."}, {"type": "subtitle", "time": 5169.59, "timestamp": "01:26:09", "text": "Yeah. Or hang out or something."}, {"type": "subtitle", "time": 5171.43, "timestamp": "01:26:11", "text": "Absolutely. I'm always down for like,"}, {"type": "subtitle", "time": 5173.75, "timestamp": "01:26:13", "text": "you know, chilling and collabs in"}, {"type": "subtitle", "time": 5176.31, "timestamp": "01:26:16", "text": "general when I'm not traveling or being"}, {"type": "subtitle", "time": 5182.47, "timestamp": "01:26:22", "text": "[Music]"}, {"type": "subtitle", "time": 5185.91, "timestamp": "01:26:25", "text": "So, senpai,"}, {"type": "subtitle", "time": 5187.51, "timestamp": "01:26:27", "text": "what are you looking forward to the"}, {"type": "subtitle", "time": 5193.42, "timestamp": "01:26:33", "text": "Uh, good question."}, {"type": "subtitle", "time": 5196.03, "timestamp": "01:26:36", "text": "[Music]"}, {"type": "subtitle", "time": 5199.59, "timestamp": "01:26:39", "text": "Um, I want to say everything."}, {"type": "subtitle", "time": 5203.99, "timestamp": "01:26:43", "text": "Mhm. It's um going to Japan was a dream"}, {"type": "subtitle", "time": 5208.39, "timestamp": "01:26:48", "text": "of mine. I never thought I could have"}, {"type": "subtitle", "time": 5209.91, "timestamp": "01:26:49", "text": "and"}, {"type": "subtitle", "time": 5212.709, "timestamp": "01:26:52", "text": "And the fact that I'm able to go itself"}, {"type": "subtitle", "time": 5218.79, "timestamp": "01:26:58", "text": "So I'm like so proud of you and so happy"}]
[{"type": "subtitle", "time": 40383.19, "timestamp": "11:13:03", "text": "我知道，對吧。漢字真的很難學。我閱讀漢字也很困難。  太難了。  你好。  我的"}, {"type": "subtitle", "time": 40386.31, "timestamp": "11:13:06", "text": "天哪，"}, {"type": "subtitle", "time": 40398.95, "timestamp": "11:13:18", "text": "謝謝。  裡面。是的。  我的天哪，我好害怕。我的天哪，我居然和別人"}, {"type": "subtitle", "time": 40425.266, "timestamp": "11:13:45", "text": "聊起來了。我的天啊，什麼事？  [音樂] 他們人真好。他們人真好，也真可愛。我的天啊。寶貝"}, {"type": "subtitle", "time": 40439.35, "timestamp": "11:13:59", "text": "，對不起。"}]
[{"type": "subtitle", "time": 7260.87, "timestamp": "02:01:00", "text": "你只"}, {"type": "subtitle", "time": 7262.31, "timestamp": "02:01:02", "text": "需要喜歡它就好，它沒那麼糟"}, {"type": "subtitle", "time": 7274.87, "timestamp": "02:01:14", "text": "。  呃，"}, {"type": "subtitle", "time": 7287.669, "timestamp": "02:01:27", "text": "你是不是又要註冊一個亞馬遜美國站、英國站"}, {"type": "subtitle", "time": 7291.35, "timestamp": "02:01:31", "text": "或其他類似地區的帳號？  哦，你只需要一個亞馬遜帳戶就行了，對吧？你只需要去亞馬遜國際商店就行了。哦，原來是我這麼做的"}, {"type": "subtitle", "time": 7296.83, "timestamp": "02:01:36", "text": "。好的。好的。我以為我"}, {"type": "subtitle", "time": 7316.709, "timestamp": "02:01:56", "text": "必須做一個亞馬遜日本版的，因為我已經有了印度版的，"}]
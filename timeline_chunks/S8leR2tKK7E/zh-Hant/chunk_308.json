[{"type": "subtitle", "time": 18481.35, "timestamp": "05:08:01", "text": "Fitma那個計畫。你還記得這件事嗎？我的天哪，我記得"}, {"type": "subtitle", "time": 18484.47, "timestamp": "05:08:04", "text": "這件事"}, {"type": "subtitle", "time": 18487.75, "timestamp": "05:08:07", "text": "。這也太可愛了吧。  我太喜歡它了。它看起來很像"}, {"type": "subtitle", "time": 18490.708, "timestamp": "05:08:10", "text": "，那是什麼"}]
[{"type": "subtitle", "time": 19923.75, "timestamp": "05:32:03", "text": "，我當時真的想弄清楚，那到底是什麼？誤導人們，讓他們以為我的"}, {"type": "subtitle", "time": 19940.788, "timestamp": "05:32:20", "text": "頻道近期不會有任何重大進展或變化"}, {"type": "subtitle", "time": 19943.19, "timestamp": "05:32:23", "text": "。我一直"}, {"type": "subtitle", "time": 19946.31, "timestamp": "05:32:26", "text": "嘗試把它們餵給別人"}, {"type": "subtitle", "time": 19960.39, "timestamp": "05:32:40", "text": "。我的天啊"}, {"type": "subtitle", "time": 19967.27, "timestamp": "05:32:47", "text": "。你的做法真是太有創意、太聰明了。同時，我和這個人在一起一年多了，但我卻管不住"}, {"type": "subtitle", "time": 19969.19, "timestamp": "05:32:49", "text": "自己的嘴。"}, {"type": "subtitle", "time": 19975.67, "timestamp": "05:32:55", "text": "涼爽的。我不知道。我確實想……"}]
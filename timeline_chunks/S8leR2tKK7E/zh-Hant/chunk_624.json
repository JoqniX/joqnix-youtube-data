[{"type": "subtitle", "time": 37449.266, "timestamp": "10:24:09", "text": "不，我剛才"}, {"type": "subtitle", "time": 37452.07, "timestamp": "10:24:12", "text": "做了“哦，不”。不，不，不，不。哦，還剩"}, {"type": "subtitle", "time": 37458.586, "timestamp": "10:24:18", "text": "一分鐘。"}, {"type": "subtitle", "time": 37487.586, "timestamp": "10:24:47", "text": "呃，沒關係。不，我本來想考80分，不過沒關係"}]
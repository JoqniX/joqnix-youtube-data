[{"type": "subtitle", "time": 40108.07, "timestamp": "11:08:28", "text": "YouTube"}, {"type": "subtitle", "time": 40112.31, "timestamp": "11:08:32", "text": "還是Twitch 之類的平台，我都會記錄聊天記錄，這樣我就"}, {"type": "subtitle", "time": 40117.83, "timestamp": "11:08:37", "text": "不會忘記每個人了。但最終，在直播結束時，我還是會確保閱讀所有留言，因為我知道那種感覺，你知道"}]
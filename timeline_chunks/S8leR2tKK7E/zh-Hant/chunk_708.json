[{"type": "subtitle", "time": 42514.07, "timestamp": "11:48:34", "text": "我來說，IST"}, {"type": "subtitle", "time": 42519.67, "timestamp": "11:48:39", "text": "是印度標準時間。你得在你的設備上告訴我你的時區。等等，讓我找找，然後發給你。"}, {"type": "subtitle", "time": 42522.55, "timestamp": "11:48:42", "text": "呃，我找找看。請稍等一秒。"}, {"type": "subtitle", "time": 42529.51, "timestamp": "11:48:49", "text": "我在等生日。是的，有一個。有一個。那"}]
[{"type": "subtitle", "time": 36001.47, "timestamp": "10:00:01", "text": "做？哦，我做不到。  嗯？沒關係。好的。手槍靶。標準彈藥。容量大。為什麼不呢？突擊"}, {"type": "subtitle", "time": 36031.99, "timestamp": "10:00:31", "text": "步槍。水平方向會增加後坐力。垂直價差增益。容量大。是的，我們選擇囤積、爭論"}, {"type": "subtitle", "time": 36042.87, "timestamp": "10:00:42", "text": "和諾瑪雷。  這次我們走吧。我們就選九頭蛇吧。我不知道那門課是"}, {"type": "subtitle", "time": 36048.23, "timestamp": "10:00:48", "text": "做什麼的。所有單位的"}]
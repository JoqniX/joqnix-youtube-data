[{"type": "subtitle", "time": 35402.266, "timestamp": "09:50:02", "text": "什麼？道嗎？ 我們提高了我的……我的瞄準鏡靈敏度太低了。"}, {"type": "subtitle", "time": 35414.35, "timestamp": "09:50:14", "text": "好地"}, {"type": "subtitle", "time": 35433.83, "timestamp": "09:50:33", "text": "控制它"}, {"type": "subtitle", "time": 35438.99, "timestamp": "09:50:38", "text": "。好的。 ，我忘了這不是最高難度。及的。 好的，謝謝兄弟。麼"}, {"type": "subtitle", "time": 35441.19, "timestamp": "09:50:41", "text": "意思？ 你知道我"}, {"type": "subtitle", "time": 35457.83, "timestamp": "09:50:57", "text": "玩得有多好，對吧？ 你們兩個只是……"}, {"type": "subtitle", "time": 35459.19, "timestamp": "09:50:59", "text": "別"}]
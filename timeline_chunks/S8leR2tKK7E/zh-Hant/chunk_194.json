[{"type": "subtitle", "time": 11665.99, "timestamp": "03:14:25", "text": "類似的事情，他們一直用同一個縮圖，所以我用了同樣的格式，但做了一些改動，我把我的模型的配色方案放了進去，比如三月是藍色，四月是紫羅蘭色，五月是粉紅色，六月是白色。最後一點。我的天哪，這太"}, {"type": "chat", "time": 11671.471, "timestamp": "03:14:31", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "no one is immediately good at something Joqqy"}, {"type": "chat", "time": 11682.658, "timestamp": "03:14:42", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "you just gotta start somewhere"}, {"type": "chat", "time": 11696.395, "timestamp": "03:14:56", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "learn and improve slowly "}]
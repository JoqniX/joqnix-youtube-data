[{"type": "subtitle", "time": 41023.51, "timestamp": "11:23:43", "text": "哦，有個可愛的小傢伙。他果然如他所料。我的天啊。他以為自己終於討好了他的同類，"}, {"type": "subtitle", "time": 41029.746, "timestamp": "11:23:49", "text": "但那全是些英國式的廢話"}, {"type": "subtitle", "time": 41033.35, "timestamp": "11:23:53", "text": "。我想多"}, {"type": "subtitle", "time": 41036.87, "timestamp": "11:23:56", "text": "看看印度的東西，這樣我就可以和他們交朋友什麼的，聊聊天什麼的。我"}]
[{"type": "subtitle", "time": 38249.63, "timestamp": "10:37:29", "text": "知道，每天固定一個時間，直播這個那個"}, {"type": "subtitle", "time": 38251.67, "timestamp": "10:37:31", "text": "。我從來沒有過那種「啊，我應該直播嗎？ 」之類的想法。我的意思是，當我直播的時候，因為時間安排很嚴格，"}, {"type": "subtitle", "time": 38258.746, "timestamp": "10:37:38", "text": "我確實會有那種感覺。所以，但在像"}, {"type": "subtitle", "time": 38277.35, "timestamp": "10:37:57", "text": "大猩猩一樣的溪流中，我從未有過這種感覺。是不是"}, {"type": "subtitle", "time": 38279.266, "timestamp": "10:37:59", "text": "壓力太大導致的？我感覺好像是壓力太大導致的。我感覺像條狗，你"}]
[{"type": "subtitle", "time": 8820.71, "timestamp": "02:27:00", "text": "你必須通過這些環節，"}, {"type": "subtitle", "time": 8823.349, "timestamp": "02:27:03", "text": "然後才能繼續"}, {"type": "subtitle", "time": 8842.71, "timestamp": "02:27:22", "text": "學習。我不知道，有時候流程太多了，是啊，因為我記得我年輕的時候申請過NFT，好像要經過三輪才能通過，我覺得如果你通過了第二輪，你很可能就會進入第三輪，他們"}, {"type": "subtitle", "time": 8860.23, "timestamp": "02:27:40", "text": "會面試你，"}]
[{"type": "subtitle", "time": 4924.95, "timestamp": "01:22:04", "text": "封閉測試的獎勵，也就是滿級、武器"}, {"type": "subtitle", "time": 4936.229, "timestamp": "01:22:16", "text": "評估強化到最高等級，我就停下來。呃，然後，呃，"}, {"type": "subtitle", "time": 4938.47, "timestamp": "01:22:18", "text": "所有那些東西，真是痛苦。啊，痛苦，"}, {"type": "subtitle", "time": 4944.99, "timestamp": "01:22:24", "text": "嗯，注意身體。別進醫院。"}, {"type": "subtitle", "time": 4957.51, "timestamp": "01:22:37", "text": "兄弟，為什麼也這麼說？什麼事？我爸今天跟我說了，我們還為此吵了一架。為什麼老是說同樣的話"}]
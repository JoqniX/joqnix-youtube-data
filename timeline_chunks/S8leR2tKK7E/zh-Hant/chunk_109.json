[{"type": "subtitle", "time": 6553.43, "timestamp": "01:49:13", "text": "我不知道。我內心深處有那種渴望，"}, {"type": "subtitle", "time": 6560.59, "timestamp": "01:49:20", "text": "我想我能理解"}, {"type": "subtitle", "time": 6563.51, "timestamp": "01:49:23", "text": "為什麼你在這個圈子裡的時間比我認識的大多數人都長"}, {"type": "subtitle", "time": 6573.43, "timestamp": "01:49:33", "text": "。嗯"}, {"type": "subtitle", "time": 6575.35, "timestamp": "01:49:35", "text": "，對"}, {"type": "subtitle", "time": 6594.55, "timestamp": "01:49:54", "text": "我來說，我覺得時間長短或年數並不重要，因為每個人的經驗都截然不同。嗯，你說得對。是的。而且，嗯，是的，"}, {"type": "subtitle", "time": 6597.95, "timestamp": "01:49:57", "text": "我還沒有體驗過同時擁有這麼多東西是什麼感覺"}]
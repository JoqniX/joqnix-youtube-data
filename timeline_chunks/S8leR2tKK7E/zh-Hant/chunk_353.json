[{"type": "subtitle", "time": 21193.27, "timestamp": "05:53:13", "text": "不過我覺得那真的很有趣"}, {"type": "subtitle", "time": 21195.83, "timestamp": "05:53:15", "text": "。"}, {"type": "subtitle", "time": 21212.868, "timestamp": "05:53:32", "text": "我當時想，「我的天哪，這些人都是真實存在的"}, {"type": "subtitle", "time": 21217.35, "timestamp": "05:53:37", "text": "。」這些人都是真人，活生生的人"}, {"type": "subtitle", "time": 21220.03, "timestamp": "05:53:40", "text": "。 」"}, {"type": "subtitle", "time": 21226.03, "timestamp": "05:53:46", "text": "想想能把某些聲音"}, {"type": "subtitle", "time": 21235.91, "timestamp": "05:53:55", "text": "和某些面孔聯繫起來，真是有點不可思議。的意思是，如果我想的話"}]
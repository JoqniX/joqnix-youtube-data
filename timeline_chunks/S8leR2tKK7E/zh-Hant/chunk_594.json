[{"type": "subtitle", "time": 35642.87, "timestamp": "09:54:02", "text": "週日快樂（音樂）！另外，我忘了跟瓦爾迪什人打招呼。歡迎瓦爾迪什和你的馬克斯。  你好。"}, {"type": "subtitle", "time": 35659.67, "timestamp": "09:54:19", "text": "部署。  好的。相信我們能"}, {"type": "subtitle", "time": 35663.71, "timestamp": "09:54:23", "text": "做到。他們為什麼要開槍？"}, {"type": "subtitle", "time": 35670.39, "timestamp": "09:54:30", "text": "不，慢點。真慢。哦，他們正在開槍打人。我怎麼會"}, {"type": "subtitle", "time": 35672.55, "timestamp": "09:54:32", "text": "錯過呢？ 我怎麼會錯過呢？ 不，別殺我。別死。  當然，"}, {"type": "subtitle", "time": 35685.35, "timestamp": "09:54:45", "text": "我搞砸了那唯一一次拍攝機會"}]
[{"type": "subtitle", "time": 20179.948, "timestamp": "05:36:19", "text": "不是故意或公然抄襲任何人，或並非有意抄襲任何人，我認為"}, {"type": "subtitle", "time": 20182.43, "timestamp": "05:36:22", "text": "這應該不會造成太大影響"}, {"type": "subtitle", "time": 20185.548, "timestamp": "05:36:25", "text": "。"}, {"type": "subtitle", "time": 20189.47, "timestamp": "05:36:29", "text": "[音樂] 是啊"}, {"type": "subtitle", "time": 20195.03, "timestamp": "05:36:35", "text": "。就這樣吧，但我希望一切順利。嗯。  我相信會的。我知道你很焦慮，但一切都會順利的。"}]
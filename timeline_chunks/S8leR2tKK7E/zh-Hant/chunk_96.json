[{"type": "subtitle", "time": 5765.51, "timestamp": "01:36:05", "text": "這不是個好主意"}, {"type": "subtitle", "time": 5767.35, "timestamp": "01:36:07", "text": "。我覺得"}, {"type": "subtitle", "time": 5782.47, "timestamp": "01:36:22", "text": "當你去一個新地方的時候，你應該花點時間安頓下來，自己去探索周圍的環境，"}, {"type": "subtitle", "time": 5796.149, "timestamp": "01:36:36", "text": "而不是把太多"}, {"type": "subtitle", "time": 5798.229, "timestamp": "01:36:38", "text": "時間都花在電腦前"}, {"type": "subtitle", "time": 5800.35, "timestamp": "01:36:40", "text": "。嗯。嗯。是啊。我記得好像只有你一個人"}, {"type": "subtitle", "time": 5802.87, "timestamp": "01:36:42", "text": "離開過"}, {"type": "subtitle", "time": 5812.95, "timestamp": "01:36:52", "text": "印度，而且還是個油管部落客什麼的。你搬到一個新的國家是什麼感覺？一切都很順利。我的"}]
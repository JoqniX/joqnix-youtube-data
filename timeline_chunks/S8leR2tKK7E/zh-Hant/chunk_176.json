[{"type": "subtitle", "time": 10585.19, "timestamp": "02:56:25", "text": "乾脆不做，而且你從不歧視任何人，也不會"}, {"type": "subtitle", "time": 10608.349, "timestamp": "02:56:48", "text": "給予任何人優先權或任何形式的"}, {"type": "subtitle", "time": 10616.389, "timestamp": "02:56:56", "text": "偏袒，在社區裡表現出任何偏袒，做到這一點需要很大的勇氣。我"}, {"type": "subtitle", "time": 10619.63, "timestamp": "02:56:59", "text": "不知道她是怎麼活下來的，你知道，她每天都要和那麼多人交談，還要外出，因為我待在家裡。是啊，"}]
[{"type": "subtitle", "time": 6305.51, "timestamp": "01:45:05", "text": "奇怪，甚至"}, {"type": "subtitle", "time": 6309.709, "timestamp": "01:45:09", "text": "有點讓人反感。某種程度上來說。所以，我最近遇到了這種情況，"}, {"type": "subtitle", "time": 6321.51, "timestamp": "01:45:21", "text": "但"}, {"type": "subtitle", "time": 6324.229, "timestamp": "01:45:24", "text": "我之前並沒有意識到。我當時想的是：「哦，我知道"}, {"type": "subtitle", "time": 6340.629, "timestamp": "01:45:40", "text": "我見過他們，我想和他們建立聯繫，既然我正在招募更多的人，"}]
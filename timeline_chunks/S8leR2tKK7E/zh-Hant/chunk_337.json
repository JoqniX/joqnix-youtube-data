[{"type": "subtitle", "time": 20221.27, "timestamp": "05:37:01", "text": "嗨，我昨天私訊了索具工人的兒子。我希望能夠"}, {"type": "subtitle", "time": 20223.07, "timestamp": "05:37:03", "text": "得到"}, {"type": "subtitle", "time": 20234.628, "timestamp": "05:37:14", "text": "回覆。"}, {"type": "subtitle", "time": 20256.59, "timestamp": "05:37:36", "text": "我現在不得不問，我不知道，我看過有些人使用類似學習系統的方法。我不知道這種學習系統是否好，你知道，就是讓別人"}, {"type": "subtitle", "time": 20260.27, "timestamp": "05:37:40", "text": "根據合約為你製作"}]
[{"type": "subtitle", "time": 2706.47, "timestamp": "00:45:06", "text": "到晚上 12 點左右"}, {"type": "subtitle", "time": 2711.19, "timestamp": "00:45:11", "text": "。你的休息時間根本不算休息時間。呃，你是在休息時間工作的。  呃，你是修"}, {"type": "subtitle", "time": 2715.03, "timestamp": "00:45:15", "text": "煞車的。我是說你非常勤奮。巴。等待。測試版。等待。  巴。測試版。  巴。是的，"}, {"type": "subtitle", "time": 2744.39, "timestamp": "00:45:44", "text": "我想你說過你想寫bacha，對吧？"}, {"type": "subtitle", "time": 2759.71, "timestamp": "00:45:59", "text": "我不是個巴查（bacha，指未成年人），對吧？你巴查。等等，bacha 是什麼來著？是寶寶吧？"}]
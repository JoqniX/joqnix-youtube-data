[{"type": "subtitle", "time": 9240.63, "timestamp": "02:34:00", "text": "哦，太疯狂了。哇，太酷了。"}, {"type": "subtitle", "time": 9242.55, "timestamp": "02:34:02", "text": "如何？比如，你有没有类似……"}, {"type": "subtitle", "time": 9244.309, "timestamp": "02:34:04", "text": "偏好任何类似流媒体"}, {"type": "subtitle", "time": 9248.389, "timestamp": "02:34:08", "text": "目前为止的平台是什么样的？嗯，我的意思是，我的意思是"}, {"type": "subtitle", "time": 9251.83, "timestamp": "02:34:11", "text": "最初是 YouTube 和 Twitch，因为我"}, {"type": "subtitle", "time": 9254.389, "timestamp": "02:34:14", "text": "最初是从Twitch开始直播的"}, {"type": "subtitle", "time": 9257.67, "timestamp": "02:34:17", "text": "所以 Twitch 永远是我的家，没错。"}, {"type": "subtitle", "time": 9260.55, "timestamp": "02:34:20", "text": "正确的。从那以后，嗯，就像以前一样。"}, {"type": "subtitle", "time": 9262.79, "timestamp": "02:34:22", "text": "Joathon 和一些东西，我以前会给更多"}, {"type": "subtitle", "time": 9265.349, "timestamp": "02:34:25", "text": "优先考虑 YouTube，这样我就可以……"}, {"type": "subtitle", "time": 9269.83, "timestamp": "02:34:29", "text": "唯一的YouTube合作伙伴。正确的。所以因为"}, {"type": "subtitle", "time": 9273.11, "timestamp": "02:34:33", "text": "Twitch 提供很多功能。"}, {"type": "subtitle", "time": 9274.95, "timestamp": "02:34:34", "text": "比如聊天规则等等"}, {"type": "subtitle", "time": 9278.07, "timestamp": "02:34:38", "text": "你直接在弹出的聊天窗口中输入内容即可。"}, {"type": "subtitle", "time": 9280.55, "timestamp": "02:34:40", "text": "以及重定向突袭功能"}, {"type": "subtitle", "time": 9282.87, "timestamp": "02:34:42", "text": "一切都被锁在这个U之下"}, {"type": "subtitle", "time": 9286.71, "timestamp": "02:34:46", "text": "YouTube的盈利机制，哦"}, {"type": "subtitle", "time": 9290.469, "timestamp": "02:34:50", "text": "我之前不知道这件事。"}, {"type": "subtitle", "time": 9292.87, "timestamp": "02:34:52", "text": "还有表情之类的东西，我做了一个"}, {"type": "subtitle", "time": 9296.07, "timestamp": "02:34:56", "text": "7TV出了问题。我当时正在展示"}, {"type": "subtitle", "time": 9298.63, "timestamp": "02:34:58", "text": "直播中有人。有一个人"}]
[{"type": "subtitle", "time": 15480.389, "timestamp": "04:18:00", "text": "我知道，我一直都想和她谈谈。"}, {"type": "subtitle", "time": 15484.71, "timestamp": "04:18:04", "text": "感觉自己太害羞了。我当时就想：呃呃"}, {"type": "chat", "time": 15485.261, "timestamp": "04:18:05", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "hm hm"}, {"type": "subtitle", "time": 15487.99, "timestamp": "04:18:07", "text": "我想说话，可是我该怎么办？什么"}, {"type": "subtitle", "time": 15492.63, "timestamp": "04:18:12", "text": "我甚至会说话吗？而我当时确实是"}, {"type": "subtitle", "time": 15495.269, "timestamp": "04:18:15", "text": "真的很害羞"}, {"type": "subtitle", "time": 15498.07, "timestamp": "04:18:18", "text": "还有其他一些东西。我真的很高兴"}, {"type": "subtitle", "time": 15503.349, "timestamp": "04:18:23", "text": "那天，就像2021年一样，发现了她。"}, {"type": "subtitle", "time": 15505.11, "timestamp": "04:18:25", "text": "是的。她当时正在Twitch上直播。"}, {"type": "subtitle", "time": 15508.149, "timestamp": "04:18:28", "text": "玩游戏时精力充沛"}, {"type": "subtitle", "time": 15511.51, "timestamp": "04:18:31", "text": "而且很快乐。是的，她就是。我看到我"}, {"type": "subtitle", "time": 15513.91, "timestamp": "04:18:33", "text": "我发现她的时候，她正在Twitch上直播。"}, {"type": "subtitle", "time": 15516.95, "timestamp": "04:18:36", "text": "就像印度标签、印度和VTuber一样。"}, {"type": "subtitle", "time": 15520.63, "timestamp": "04:18:40", "text": "在她的 Twitch 频道上打标签。而我当时"}, {"type": "subtitle", "time": 15523.11, "timestamp": "04:18:43", "text": "比如，“我的天哪，一个印度 YouTuber”"}, {"type": "subtitle", "time": 15526.149, "timestamp": "04:18:46", "text": "抽搐。我不再孤单了。"}, {"type": "chat", "time": 15530.357, "timestamp": "04:18:50", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "noice"}, {"type": "subtitle", "time": 15532.149, "timestamp": "04:18:52", "text": "见到你让我非常开心"}, {"type": "chat", "time": 15533.671, "timestamp": "04:18:53", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/HvgfY93GEYmqvwLUuYDwAQUCkszU2WH9gy1mb0dV-11UJg/HvgfY93GEYmqvwLUuYDwAQUCkszU2WH9gy1mb0dV-11UJg/HvgfY93GEYmqvwLUuYDwAQ"}, {"type": "subtitle", "time": 15533.99, "timestamp": "04:18:53", "text": "某人。"}, {"type": "subtitle", "time": 15535.99, "timestamp": "04:18:55", "text": "是的。"}, {"type": "subtitle", "time": 15539.51, "timestamp": "04:18:59", "text": "她和我讲同一种语言。"}]
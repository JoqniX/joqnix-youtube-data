[{"type": "subtitle", "time": 1321.669, "timestamp": "00:22:01", "text": "一"}, {"type": "subtitle", "time": 1325.669, "timestamp": "00:22:05", "text": "速跑，呃，速跑，就像"}, {"type": "subtitle", "time": 1327.909, "timestamp": "00:22:07", "text": "甚至连字幕和那些东西都让人信以为真"}, {"type": "subtitle", "time": 1331.909, "timestamp": "00:22:11", "text": "像这样。我已经有点习惯了。"}, {"type": "subtitle", "time": 1335.43, "timestamp": "00:22:15", "text": "保存，就完成了。我们回到"}, {"type": "subtitle", "time": 1337.669, "timestamp": "00:22:17", "text": "比利。"}, {"type": "subtitle", "time": 1343.11, "timestamp": "00:22:23", "text": "上传中文版。请点击此处。"}, {"type": "subtitle", "time": 1346.149, "timestamp": "00:22:26", "text": "你们的字幕是什么？"}, {"type": "subtitle", "time": 1350.39, "timestamp": "00:22:30", "text": "对，中国制造。然后是英语。"}, {"type": "subtitle", "time": 1353.99, "timestamp": "00:22:33", "text": "照做。这样做。"}, {"type": "subtitle", "time": 1358.39, "timestamp": "00:22:38", "text": "请告诉我。好的。好的。你好。呃，帖子"}, {"type": "subtitle", "time": 1361.75, "timestamp": "00:22:41", "text": "东西。我输入了什么？我打了什么字？"}, {"type": "subtitle", "time": 1364.39, "timestamp": "00:22:44", "text": "昨天又来了？"}, {"type": "subtitle", "time": 1365.75, "timestamp": "00:22:45", "text": "我直接复制粘贴就行了。"}, {"type": "subtitle", "time": 1367.27, "timestamp": "00:22:47", "text": "昨天的。"}, {"type": "subtitle", "time": 1374.87, "timestamp": "00:22:54", "text": "是啊，如果我能找到的话。我为什么会打字"}, {"type": "subtitle", "time": 1377.75, "timestamp": "00:22:57", "text": "昨天？这个。不。不。前一天"}]
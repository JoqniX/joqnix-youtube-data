[{"type": "subtitle", "time": 7320.629, "timestamp": "02:02:00", "text": "如果我躺下写作会发生什么？"}, {"type": "subtitle", "time": 7322.39, "timestamp": "02:02:02", "text": "让我们设想一下我……的情景"}, {"type": "subtitle", "time": 7324.47, "timestamp": "02:02:04", "text": "躺下。我只能仰望"}, {"type": "subtitle", "time": 7326.07, "timestamp": "02:02:06", "text": "是显示器吗？继续下去"}, {"type": "subtitle", "time": 7329.189, "timestamp": "02:02:09", "text": "写作。将麦克风放在桌子下面或"}, {"type": "subtitle", "time": 7333.75, "timestamp": "02:02:13", "text": "就像在扬声器附近一样，这样我就可以"}, {"type": "subtitle", "time": 7337.669, "timestamp": "02:02:17", "text": "这样我的声音才能被听到。我们试试看。"}, {"type": "subtitle", "time": 7339.43, "timestamp": "02:02:19", "text": "等待，"}, {"type": "subtitle", "time": 7341.75, "timestamp": "02:02:21", "text": "我可以也滑下去一会儿吗？"}, {"type": "subtitle", "time": 7346.79, "timestamp": "02:02:26", "text": "也许我可以移动一下键盘。"}, {"type": "subtitle", "time": 7349.109, "timestamp": "02:02:29", "text": "一切。这款产品能提供更大的空间。"}, {"type": "subtitle", "time": 7363.83, "timestamp": "02:02:43", "text": "我的天啊。有点尴尬。诡异的。"}, {"type": "subtitle", "time": 7367.75, "timestamp": "02:02:47", "text": "是啊，感觉好难。"}, {"type": "subtitle", "time": 7369.75, "timestamp": "02:02:49", "text": "我会提高麦克风的灵敏度。"}, {"type": "subtitle", "time": 7374.47, "timestamp": "02:02:54", "text": "把麦克风放到我头顶上更大的位置。"}, {"type": "subtitle", "time": 7377.83, "timestamp": "02:02:57", "text": "你能听到吗？这就是问题所在。"}]
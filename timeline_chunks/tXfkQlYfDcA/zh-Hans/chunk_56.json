[{"type": "subtitle", "time": 3362.71, "timestamp": "00:56:02", "text": "或者在此验证中有效"}, {"type": "subtitle", "time": 3369.75, "timestamp": "00:56:09", "text": "但仍然"}, {"type": "subtitle", "time": 3377.43, "timestamp": "00:56:17", "text": "[音乐]"}, {"type": "subtitle", "time": 3379.67, "timestamp": "00:56:19", "text": "我现在晚上11点睡觉。所以，我是"}, {"type": "subtitle", "time": 3381.91, "timestamp": "00:56:21", "text": "还可以再坚持两个小时。哦，真好，真好。"}, {"type": "subtitle", "time": 3383.75, "timestamp": "00:56:23", "text": "好的，"}, {"type": "subtitle", "time": 3386.309, "timestamp": "00:56:26", "text": "精彩的演出。精彩的演出。"}, {"type": "subtitle", "time": 3388.789, "timestamp": "00:56:28", "text": "我记得你的时区是美国东部标准时间（EST），对吗？"}, {"type": "subtitle", "time": 3398.789, "timestamp": "00:56:38", "text": "祝你的笑话大获成功。"}, {"type": "subtitle", "time": 3402.71, "timestamp": "00:56:42", "text": "再过三年。三年后"}, {"type": "subtitle", "time": 3404.87, "timestamp": "00:56:44", "text": "好了，我做完了。我不想看"}, {"type": "subtitle", "time": 3407.67, "timestamp": "00:56:47", "text": "又犯傻了。我的意思是仅"}, {"type": "subtitle", "time": 3409.67, "timestamp": "00:56:49", "text": "我为什么会选择文学专业呢？"}, {"type": "subtitle", "time": 3412.309, "timestamp": "00:56:52", "text": "因为我想再次写一本书。"}, {"type": "subtitle", "time": 3415.19, "timestamp": "00:56:55", "text": "我下半身的东西，Onexia 的东西，我只想"}, {"type": "subtitle", "time": 3416.95, "timestamp": "00:56:56", "text": "最后，我只想知道如何"}, {"type": "subtitle", "time": 3419.75, "timestamp": "00:56:59", "text": "身为作家的感觉"}]
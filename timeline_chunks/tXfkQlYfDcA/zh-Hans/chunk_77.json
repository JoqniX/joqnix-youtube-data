[{"type": "subtitle", "time": 4624.149, "timestamp": "01:17:04", "text": "是染发剂之类的东西吗？ H"}, {"type": "subtitle", "time": 4627.43, "timestamp": "01:17:07", "text": "我的想法是什么？我的意思是，我也是，我也这么做"}, {"type": "subtitle", "time": 4629.59, "timestamp": "01:17:09", "text": "想把头发染成银色，或者"}, {"type": "subtitle", "time": 4633.51, "timestamp": "01:17:13", "text": "有一天突然变得像黑色一样泛白，"}, {"type": "subtitle", "time": 4637.189, "timestamp": "01:17:17", "text": "但有时候，你知道，或者"}, {"type": "subtitle", "time": 4640.71, "timestamp": "01:17:20", "text": "原色，自然色"}, {"type": "subtitle", "time": 4642.79, "timestamp": "01:17:22", "text": "[音乐]"}, {"type": "subtitle", "time": 4644.709, "timestamp": "01:17:24", "text": "染发就像涂抹……"}, {"type": "subtitle", "time": 4647.11, "timestamp": "01:17:27", "text": "化学品之类的东西，一切都对"}, {"type": "subtitle", "time": 4648.709, "timestamp": "01:17:28", "text": "在天然头发之上"}, {"type": "subtitle", "time": 4652.39, "timestamp": "01:17:32", "text": "一切。但是，尽管"}, {"type": "subtitle", "time": 4654.79, "timestamp": "01:17:34", "text": "就像"}, {"type": "subtitle", "time": 4657.35, "timestamp": "01:17:37", "text": "你会失去一些非常重要的东西。"}, {"type": "subtitle", "time": 4660.47, "timestamp": "01:17:40", "text": "你对你来说很重要，就像你一样"}, {"type": "subtitle", "time": 4663.43, "timestamp": "01:17:43", "text": "生活中失去某些东西"}, {"type": "subtitle", "time": 4667.43, "timestamp": "01:17:47", "text": "你与生俱来的那种天赋"}, {"type": "subtitle", "time": 4671.669, "timestamp": "01:17:51", "text": "那经典的发色"}, {"type": "subtitle", "time": 4674.07, "timestamp": "01:17:54", "text": "是的，我觉得你可以染发。"}, {"type": "subtitle", "time": 4676.07, "timestamp": "01:17:56", "text": "我不知道你是否能得到它。"}, {"type": "subtitle", "time": 4679.27, "timestamp": "01:17:59", "text": "如果你把它洗掉或者涂抹，它会恢复原状。"}]
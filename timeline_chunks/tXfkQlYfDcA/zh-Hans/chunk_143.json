[{"type": "subtitle", "time": 8582.15, "timestamp": "02:23:02", "text": "然后我参加了考试，并通过了。"}, {"type": "subtitle", "time": 8584.55, "timestamp": "02:23:04", "text": "然后他们给了我机会，"}, {"type": "subtitle", "time": 8587.91, "timestamp": "02:23:07", "text": "因为要去学校面试，所以……"}, {"type": "subtitle", "time": 8591.349, "timestamp": "02:23:11", "text": "我还在读学位呢，呃，我"}, {"type": "subtitle", "time": 8594.63, "timestamp": "02:23:14", "text": "我只上过一所学校，是的，我成绩很好。"}, {"type": "subtitle", "time": 8597.67, "timestamp": "02:23:17", "text": "那次采访。是我在说话"}, {"type": "subtitle", "time": 8601.91, "timestamp": "02:23:21", "text": "太多了。是的。我的天哪，太棒了！"}, {"type": "subtitle", "time": 8607.03, "timestamp": "02:23:27", "text": "恭喜。耶。我的天哪。嗯，是的。"}, {"type": "subtitle", "time": 8609.11, "timestamp": "02:23:29", "text": "面试之类的都过去了。是的，"}, {"type": "subtitle", "time": 8611.91, "timestamp": "02:23:31", "text": "现在他们告诉我，作为补偿，他们"}, {"type": "subtitle", "time": 8614.95, "timestamp": "02:23:34", "text": "将为我提供N4课程，N4到"}, {"type": "subtitle", "time": 8619.27, "timestamp": "02:23:39", "text": "N3，一点点N3。所以到明年"}, {"type": "subtitle", "time": 8622.389, "timestamp": "02:23:42", "text": "四月，呃，三月，对，三月底，就像"}, {"type": "subtitle", "time": 8625.349, "timestamp": "02:23:45", "text": "大约这个时候，嗯，我就完全恢复了。"}, {"type": "subtitle", "time": 8627.27, "timestamp": "02:23:47", "text": "做好准备，我就可以拥有更多"}, {"type": "subtitle", "time": 8630.63, "timestamp": "02:23:50", "text": "现在在日本可以享受到的机会"}, {"type": "subtitle", "time": 8632.71, "timestamp": "02:23:52", "text": "呃，兼职工作，因为我能说一口流利的英语。"}, {"type": "subtitle", "time": 8635.51, "timestamp": "02:23:55", "text": "那时N4就完成了"}, {"type": "subtitle", "time": 8639.59, "timestamp": "02:23:59", "text": "所以从N3开始，我就可以从日本学习了。"}]
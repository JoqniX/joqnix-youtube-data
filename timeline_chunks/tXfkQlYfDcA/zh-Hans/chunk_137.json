[{"type": "subtitle", "time": 8220.469, "timestamp": "02:17:00", "text": "这就像我第一次参加频道活动一样，我"}, {"type": "subtitle", "time": 8223.83, "timestamp": "02:17:03", "text": "猜测。呃"}, {"type": "subtitle", "time": 8227.349, "timestamp": "02:17:07", "text": "我从来没有，呃，我不知道该怎么做，呃"}, {"type": "subtitle", "time": 8230.15, "timestamp": "02:17:10", "text": "订阅或捐款活动都有效。我知道"}, {"type": "subtitle", "time": 8232.549, "timestamp": "02:17:12", "text": "你必须制定激励措施，"}, {"type": "subtitle", "time": 8236.87, "timestamp": "02:17:16", "text": "目标之类的，但是当我开始的时候……"}, {"type": "subtitle", "time": 8241.11, "timestamp": "02:17:21", "text": "我发烧了，没能准备太多。"}, {"type": "subtitle", "time": 8246.15, "timestamp": "02:17:26", "text": "这是紧急情况下发生的，但"}, {"type": "subtitle", "time": 8249.589, "timestamp": "02:17:29", "text": "嗯，就像……呃，紧急情况之类的。"}, {"type": "subtitle", "time": 8253.19, "timestamp": "02:17:33", "text": "我必须这样做，否则就忘了这件事。"}, {"type": "subtitle", "time": 8255.589, "timestamp": "02:17:35", "text": "我的模型。所以，我就想，“是啊，我要……”"}, {"type": "subtitle", "time": 8258.389, "timestamp": "02:17:38", "text": "“我要捍卫我的模型，我想要它。”"}, {"type": "subtitle", "time": 8260.709, "timestamp": "02:17:40", "text": "只是我没钱。呃，"}, {"type": "subtitle", "time": 8263.349, "timestamp": "02:17:43", "text": "这是一个巨大的数字。比如，2000美元就像"}, {"type": "subtitle", "time": 8265.91, "timestamp": "02:17:45", "text": "数量巨大，对吧？"}, {"type": "subtitle", "time": 8268.87, "timestamp": "02:17:48", "text": "我的天哪。哦，我的肾脏就像，哦，"}, {"type": "subtitle", "time": 8273.75, "timestamp": "02:17:53", "text": "那种痛苦。是的。是啊，真是这样"}, {"type": "subtitle", "time": 8276.709, "timestamp": "02:17:56", "text": "数量巨大。而我，我开始的时候"}, {"type": "subtitle", "time": 8279.03, "timestamp": "02:17:59", "text": "明知无法达到目标，因为"}]
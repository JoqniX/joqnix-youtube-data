[{"type": "subtitle", "time": 14940.229, "timestamp": "04:09:00", "text": "很容易陷入那种境地，嗯……"}, {"type": "subtitle", "time": 14942.07, "timestamp": "04:09:02", "text": "我对此感到满意。让我先说明一下"}, {"type": "subtitle", "time": 14943.59, "timestamp": "04:09:03", "text": "坚持这个作息规律。让我坚持下去"}, {"type": "subtitle", "time": 14945.189, "timestamp": "04:09:05", "text": "就这样。因为这就是我遇到的情况。"}, {"type": "subtitle", "time": 14947.03, "timestamp": "04:09:07", "text": "我有时也会做类似这样的事："}, {"type": "subtitle", "time": 14949.269, "timestamp": "04:09:09", "text": "是的，我感觉这样挺舒服的。"}, {"type": "subtitle", "time": 14951.91, "timestamp": "04:09:11", "text": "这些类似的事情"}, {"type": "subtitle", "time": 14955.11, "timestamp": "04:09:15", "text": "一系列类似……嗯……兑换之类的东西，我是"}, {"type": "subtitle", "time": 14956.71, "timestamp": "04:09:16", "text": "我不喜欢改变现状，我曾经是"}, {"type": "subtitle", "time": 14959.99, "timestamp": "04:09:19", "text": "就像h也许也许人们正在做他们是"}, {"type": "subtitle", "time": 14961.59, "timestamp": "04:09:21", "text": "就像感到无聊一样，他们喜欢渴望"}, {"type": "subtitle", "time": 14963.44, "timestamp": "04:09:23", "text": "一些新的东西"}, {"type": "subtitle", "time": 14965.83, "timestamp": "04:09:25", "text": "[音乐]"}, {"type": "subtitle", "time": 14967.83, "timestamp": "04:09:27", "text": "哦，这就是……这就是你……"}, {"type": "subtitle", "time": 14969.67, "timestamp": "04:09:29", "text": "正在做？是的。是的。这就是我的做法。"}, {"type": "subtitle", "time": 14976.87, "timestamp": "04:09:36", "text": "哦，正在加载。是的，这需要一个"}, {"type": "subtitle", "time": 14979.75, "timestamp": "04:09:39", "text": "因为这是运动，对吧？是的。"}, {"type": "subtitle", "time": 14981.83, "timestamp": "04:09:41", "text": "哦，不错。"}, {"type": "subtitle", "time": 14983.99, "timestamp": "04:09:43", "text": "它从YouTube获取缩略图，"}, {"type": "subtitle", "time": 14986.389, "timestamp": "04:09:46", "text": "我做了什么。这就是我必须做的"}, {"type": "subtitle", "time": 14989.03, "timestamp": "04:09:49", "text": "手动输入。一样。相同的"}, {"type": "subtitle", "time": 14991.67, "timestamp": "04:09:51", "text": "事情发生在推特上。细节何时"}, {"type": "subtitle", "time": 14994.389, "timestamp": "04:09:54", "text": "结束了。观看你的直播，比利比利"}, {"type": "subtitle", "time": 14997.11, "timestamp": "04:09:57", "text": "东西和时间戳"}, {"type": "subtitle", "time": 14999.189, "timestamp": "04:09:59", "text": "就像，当你改变了它的时候"}]
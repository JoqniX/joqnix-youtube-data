[{"type": "subtitle", "time": 10081.03, "timestamp": "02:48:01", "text": "就像尝试了很多事情一样，尝试"}, {"type": "subtitle", "time": 10083.349, "timestamp": "02:48:03", "text": "不同的事情，比如，敬酒"}, {"type": "subtitle", "time": 10085.429, "timestamp": "02:48:05", "text": "更像是需要更多年的时间去尝试。"}, {"type": "subtitle", "time": 10087.429, "timestamp": "02:48:07", "text": "事物和景象，就像你喜欢的东西一样，"}, {"type": "subtitle", "time": 10089.91, "timestamp": "02:48:09", "text": "什么能粘住，对吧？就像找到"}, {"type": "subtitle", "time": 10092.389, "timestamp": "02:48:12", "text": "你的热情所在。是的。谁知道呢？"}, {"type": "subtitle", "time": 10095.51, "timestamp": "02:48:15", "text": "或许明年，日本。哇。十字路口"}, {"type": "subtitle", "time": 10098.389, "timestamp": "02:48:18", "text": "手指。"}, {"type": "subtitle", "time": 10099.99, "timestamp": "02:48:19", "text": "是的。"}, {"type": "subtitle", "time": 10109.429, "timestamp": "02:48:29", "text": "所以，哦，我没有。哦，等等。我觉得我"}, {"type": "subtitle", "time": 10112.389, "timestamp": "02:48:32", "text": "还没给你看过片段呢"}, {"type": "subtitle", "time": 10116.469, "timestamp": "02:48:36", "text": "我即将推出的新模型。"}, {"type": "subtitle", "time": 10119.269, "timestamp": "02:48:39", "text": "我很想看看。"}, {"type": "subtitle", "time": 10122.389, "timestamp": "02:48:42", "text": "你愿意吗？好的。"}, {"type": "subtitle", "time": 10124.23, "timestamp": "02:48:44", "text": "是的，没问题。我觉得没问题。我"}, {"type": "subtitle", "time": 10127.83, "timestamp": "02:48:47", "text": "不会的，我不会惹上麻烦。喜欢"}, {"type": "subtitle", "time": 10130.15, "timestamp": "02:48:50", "text": "不，没有压力。我不想"}, {"type": "subtitle", "time": 10132.309, "timestamp": "02:48:52", "text": "因为如果你想做像慢动作那样的事情"}, {"type": "subtitle", "time": 10134.95, "timestamp": "02:48:54", "text": "对所有人来说，这完全是揭晓的"}, {"type": "subtitle", "time": 10137.349, "timestamp": "02:48:57", "text": "好的。我会耐心等待，但我"}, {"type": "subtitle", "time": 10139.83, "timestamp": "02:48:59", "text": "还特别爱管闲事。我当时就想，哦，我好兴奋啊！"}]
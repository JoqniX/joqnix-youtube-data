[{"type": "subtitle", "time": 11220.55, "timestamp": "03:07:00", "text": "有很多值得细细品味的地方。"}, {"type": "subtitle", "time": 11222.469, "timestamp": "03:07:02", "text": "有很多事情需要经历。出色地，"}, {"type": "subtitle", "time": 11224.469, "timestamp": "03:07:04", "text": "你会想，当然好啊。我很高兴我是"}, {"type": "subtitle", "time": 11226.63, "timestamp": "03:07:06", "text": "很高兴你愿意尝试涉足这个领域。"}, {"type": "subtitle", "time": 11228.309, "timestamp": "03:07:08", "text": "这也是我一直想做的事。"}, {"type": "subtitle", "time": 11229.83, "timestamp": "03:07:09", "text": "冒险进入，但感觉就像这样"}, {"type": "subtitle", "time": 11232.389, "timestamp": "03:07:12", "text": "有时会让人感到难以承受。就像我，我不"}, {"type": "subtitle", "time": 11234.87, "timestamp": "03:07:14", "text": "我觉得我跟你一样都是完美主义者。"}, {"type": "subtitle", "time": 11238.55, "timestamp": "03:07:18", "text": "但我绝对是那种……呃，我不……"}, {"type": "subtitle", "time": 11240.55, "timestamp": "03:07:20", "text": "知道该怎么做。我感到压力很大。"}, {"type": "subtitle", "time": 11242.309, "timestamp": "03:07:22", "text": "我有很多想做的事情，"}, {"type": "subtitle", "time": 11244.15, "timestamp": "03:07:24", "text": "那么时间就不够了。所以是"}, {"type": "subtitle", "time": 11246.23, "timestamp": "03:07:26", "text": "就像，哦，好吧，"}, {"type": "subtitle", "time": 11251.349, "timestamp": "03:07:31", "text": "我还是不做了。问题解决了。"}, {"type": "subtitle", "time": 11254.63, "timestamp": "03:07:34", "text": "但最初我只想放些音乐。"}, {"type": "subtitle", "time": 11256.79, "timestamp": "03:07:36", "text": "比如原创音乐之类的东西"}, {"type": "subtitle", "time": 11258.309, "timestamp": "03:07:38", "text": "实际上，这样做是有益的"}, {"type": "subtitle", "time": 11261.429, "timestamp": "03:07:41", "text": "聆听并专业地看待音乐。"}, {"type": "subtitle", "time": 11264.389, "timestamp": "03:07:44", "text": "在主频道上。我其实想要"}, {"type": "subtitle", "time": 11266.23, "timestamp": "03:07:46", "text": "上传这些照片和视频片段"}, {"type": "subtitle", "time": 11268.15, "timestamp": "03:07:48", "text": "V 通道上的所有内容。那是我的"}, {"type": "subtitle", "time": 11271.11, "timestamp": "03:07:51", "text": "去年的最初想法，现在我感觉就像"}, {"type": "subtitle", "time": 11273.59, "timestamp": "03:07:53", "text": "是的，没问题。莫里·卡利奥皮 他们"}, {"type": "subtitle", "time": 11277.11, "timestamp": "03:07:57", "text": "她已经喜欢上了表演"}]
[{"type": "subtitle", "time": 11160.389, "timestamp": "03:06:00", "text": "关于？哦，那是关于我的第一个视频。"}, {"type": "subtitle", "time": 11162.95, "timestamp": "03:06:02", "text": "这是我第一次做这件事。那时"}, {"type": "subtitle", "time": 11165.11, "timestamp": "03:06:05", "text": "我谈到了我想成为一名……"}, {"type": "subtitle", "time": 11167.83, "timestamp": "03:06:07", "text": "我小时候是个油管博主，我试过"}, {"type": "subtitle", "time": 11170.23, "timestamp": "03:06:10", "text": "很多事情。所以它进入了一个"}, {"type": "subtitle", "time": 11173.51, "timestamp": "03:06:13", "text": "中间穿插了一些题外话。呃，所以"}, {"type": "subtitle", "time": 11176.63, "timestamp": "03:06:16", "text": "我当时想，因为我更像个“我”型人格"}, {"type": "subtitle", "time": 11179.83, "timestamp": "03:06:19", "text": "我经常自我批评。所以我就想，是啊"}, {"type": "subtitle", "time": 11182.55, "timestamp": "03:06:22", "text": "我记下了很多问题。"}, {"type": "subtitle", "time": 11185.51, "timestamp": "03:06:25", "text": "就像我突然跑题了一样，"}, {"type": "subtitle", "time": 11188.71, "timestamp": "03:06:28", "text": "比如我在视觉方面犯了多少错误"}, {"type": "subtitle", "time": 11192.23, "timestamp": "03:06:32", "text": "我自己也觉得挺有道理的。所以我注意到"}, {"type": "subtitle", "time": 11194.389, "timestamp": "03:06:34", "text": "把它记下来，这样下次我录制的时候或者"}, {"type": "subtitle", "time": 11196.469, "timestamp": "03:06:36", "text": "下次会是这样的"}, {"type": "subtitle", "time": 11199.349, "timestamp": "03:06:39", "text": "更好的。所以有一天我可以这样，这是这样。"}, {"type": "subtitle", "time": 11201.349, "timestamp": "03:06:41", "text": "我这样做的方式是："}, {"type": "subtitle", "time": 11204.469, "timestamp": "03:06:44", "text": "最终，当我观看自己的内容时。"}, {"type": "subtitle", "time": 11207.67, "timestamp": "03:06:47", "text": "我也可以很开心，可以露出笑容。"}, {"type": "subtitle", "time": 11210.23, "timestamp": "03:06:50", "text": "然后就像，是啊，那场直播真有趣。"}, {"type": "subtitle", "time": 11212.15, "timestamp": "03:06:52", "text": "就像能看到你的一样"}, {"type": "subtitle", "time": 11214.469, "timestamp": "03:06:54", "text": "有了这些，成长会变得容易一些。"}, {"type": "subtitle", "time": 11217.429, "timestamp": "03:06:57", "text": "像这样的内容，对吧？然而，"}, {"type": "subtitle", "time": 11219.03, "timestamp": "03:06:59", "text": "就像视频点播之类的，感觉就像，好吧，"}]
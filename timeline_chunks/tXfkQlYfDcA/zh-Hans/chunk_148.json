[{"type": "subtitle", "time": 8881.75, "timestamp": "02:28:01", "text": "或者也包括一些独家内容。"}, {"type": "subtitle", "time": 8886.389, "timestamp": "02:28:06", "text": "确实如此，而且我意识到那些……"}, {"type": "subtitle", "time": 8888.95, "timestamp": "02:28:08", "text": "屏幕上的字幕之类的东西"}, {"type": "subtitle", "time": 8891.99, "timestamp": "02:28:11", "text": "行不通。它不理解我"}, {"type": "subtitle", "time": 8895.67, "timestamp": "02:28:15", "text": "我当时就想，为什么？"}, {"type": "subtitle", "time": 8899.51, "timestamp": "02:28:19", "text": "所以我唯一的选择就是学习普通话。"}, {"type": "subtitle", "time": 8902.15, "timestamp": "02:28:22", "text": "是的，我想大概是世界上最好的之一吧"}, {"type": "subtitle", "time": 8904.389, "timestamp": "02:28:24", "text": "最难的语言。嗯，没关系。"}, {"type": "subtitle", "time": 8906.63, "timestamp": "02:28:26", "text": "你一定可以的。说实话，如果你喜欢"}, {"type": "subtitle", "time": 8909.11, "timestamp": "02:28:29", "text": "日语学到这个程度了，而且很喜欢"}, {"type": "subtitle", "time": 8910.87, "timestamp": "02:28:30", "text": "显然，这就像是那种激情……"}, {"type": "subtitle", "time": 8913.59, "timestamp": "02:28:33", "text": "就像开车送你一样，对吧？所以，我确信"}, {"type": "subtitle", "time": 8915.429, "timestamp": "02:28:35", "text": "我相信你一定能完美把握机会。"}, {"type": "subtitle", "time": 8919.11, "timestamp": "02:28:39", "text": "容易地。没事的。将会是"}, {"type": "subtitle", "time": 8923.59, "timestamp": "02:28:43", "text": "非常好。是的。是的。令人兴奋。嗯。"}, {"type": "subtitle", "time": 8926.79, "timestamp": "02:28:46", "text": "呃，现在我好像失去了访问权限。"}, {"type": "subtitle", "time": 8928.95, "timestamp": "02:28:48", "text": "之所以说有价值，是因为这家公司提供了帮助。"}, {"type": "subtitle", "time": 8932.07, "timestamp": "02:28:52", "text": "对我来说，他们已经不在那里了。所以，我是"}, {"type": "subtitle", "time": 8935.91, "timestamp": "02:28:55", "text": "就像我像个自由球员，正在寻找……"}, {"type": "subtitle", "time": 8939.59, "timestamp": "02:28:59", "text": "恢复直播的方法。因为呃"}]
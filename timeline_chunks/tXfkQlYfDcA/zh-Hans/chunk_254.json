[{"type": "subtitle", "time": 15241.269, "timestamp": "04:14:01", "text": "一起创作内容"}, {"type": "subtitle", "time": 15243.99, "timestamp": "04:14:03", "text": "一起。是的。所以，这就好比是……"}, {"type": "subtitle", "time": 15246.309, "timestamp": "04:14:06", "text": "非常令人兴奋。这让人不知所措。"}, {"type": "subtitle", "time": 15248.71, "timestamp": "04:14:08", "text": "同时，因为就像所有"}, {"type": "subtitle", "time": 15250.469, "timestamp": "04:14:10", "text": "这段时间我一直都像这样：是的，我正在做"}, {"type": "subtitle", "time": 15253.189, "timestamp": "04:14:13", "text": "以前都是我自己做的，但现在感觉就像在等……"}, {"type": "subtitle", "time": 15255.59, "timestamp": "04:14:15", "text": "我独自一人与他人一起做事。"}, {"type": "subtitle", "time": 15259.349, "timestamp": "04:14:19", "text": "但我们正在一起做这件事。"}, {"type": "subtitle", "time": 15261.51, "timestamp": "04:14:21", "text": "但这很有趣。很有趣。嗯，我真的"}, {"type": "subtitle", "time": 15262.95, "timestamp": "04:14:22", "text": "非常期待。我在看"}, {"type": "subtitle", "time": 15265.67, "timestamp": "04:14:25", "text": "也转发一下。我的天啊。我太"}, {"type": "subtitle", "time": 15273.75, "timestamp": "04:14:33", "text": "我的天啊。太棒了。而且我可以"}, {"type": "subtitle", "time": 15276.389, "timestamp": "04:14:36", "text": "从预告片中可以看出。是啊，真是太……"}, {"type": "subtitle", "time": 15280.149, "timestamp": "04:14:40", "text": "说起来容易做起来难，那就是你。"}, {"type": "subtitle", "time": 15285.189, "timestamp": "04:14:45", "text": "比如她不会告诉任何人。你好。你好。"}, {"type": "subtitle", "time": 15287.269, "timestamp": "04:14:47", "text": "保守秘密。我会假装是"}, {"type": "subtitle", "time": 15290.309, "timestamp": "04:14:50", "text": "出道时感到很意外。是的。是的。"}, {"type": "subtitle", "time": 15292.63, "timestamp": "04:14:52", "text": "没错，这算是我的好消息吧。"}, {"type": "subtitle", "time": 15296.149, "timestamp": "04:14:56", "text": "耶。那件事就在几天后，对吧？"}, {"type": "subtitle", "time": 15299.429, "timestamp": "04:14:59", "text": "16. 是的。所以，就像我们现在在……"}]
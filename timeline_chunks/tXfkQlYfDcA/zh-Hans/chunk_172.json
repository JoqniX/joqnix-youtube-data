[{"type": "subtitle", "time": 10323.67, "timestamp": "02:52:03", "text": "元素就像……甚至你也能看到……"}, {"type": "subtitle", "time": 10326.389, "timestamp": "02:52:06", "text": "我目前这款机型上有这些东西。"}, {"type": "subtitle", "time": 10328.469, "timestamp": "02:52:08", "text": "就像鼹鼠一样，对吧？它们就像"}, {"type": "subtitle", "time": 10331.67, "timestamp": "02:52:11", "text": "IRL 鼹鼠。是的。"}, {"type": "subtitle", "time": 10335.11, "timestamp": "02:52:15", "text": "所以，就好像我也把自己现实生活中的自己放进去了一样。"}, {"type": "subtitle", "time": 10337.19, "timestamp": "02:52:17", "text": "投入其中。"}, {"type": "subtitle", "time": 10338.71, "timestamp": "02:52:18", "text": "是的。"}, {"type": "subtitle", "time": 10340.309, "timestamp": "02:52:20", "text": "我的意思是，你在说什么？这是"}, {"type": "subtitle", "time": 10344.15, "timestamp": "02:52:24", "text": "现实生活中的你。喜欢，"}, {"type": "subtitle", "time": 10345.349, "timestamp": "02:52:25", "text": "[音乐]"}, {"type": "subtitle", "time": 10349.349, "timestamp": "02:52:29", "text": "太漂亮了。和"}, {"type": "subtitle", "time": 10352.15, "timestamp": "02:52:32", "text": "前进。是的。你在说：哦，不。我"}, {"type": "subtitle", "time": 10353.349, "timestamp": "02:52:33", "text": "我只是说，就像你的模型一样"}, {"type": "subtitle", "time": 10355.75, "timestamp": "02:52:35", "text": "现在就已经很可爱了，所以"}, {"type": "subtitle", "time": 10359.59, "timestamp": "02:52:39", "text": "空灵的，就像你的声音一样。"}, {"type": "subtitle", "time": 10361.67, "timestamp": "02:52:41", "text": "简直太适合了"}, {"type": "subtitle", "time": 10364.71, "timestamp": "02:52:44", "text": "你所追求的美学风格。"}, {"type": "subtitle", "time": 10368.389, "timestamp": "02:52:48", "text": "看到这个感觉就像，我的天哪，"}, {"type": "subtitle", "time": 10371.67, "timestamp": "02:52:51", "text": "简直完美！圣"}, {"type": "subtitle", "time": 10375.19, "timestamp": "02:52:55", "text": "钼。因为我以为我的已经我的"}, {"type": "subtitle", "time": 10378.15, "timestamp": "02:52:58", "text": "语音对某些人来说可能比较混乱，所以我"}]
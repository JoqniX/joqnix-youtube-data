[{"type": "subtitle", "time": 10620.55, "timestamp": "02:57:00", "text": "本来应该很顺利，但可惜什么都没发生。"}, {"type": "subtitle", "time": 10622.23, "timestamp": "02:57:02", "text": "发生了。"}, {"type": "subtitle", "time": 10624.309, "timestamp": "02:57:04", "text": "所以，我无法接受事情发生的事实，"}, {"type": "subtitle", "time": 10627.269, "timestamp": "02:57:07", "text": "人生总会发生各种各样的事情，对吧？所以我无法说话。"}, {"type": "subtitle", "time": 10629.03, "timestamp": "02:57:09", "text": "我不是，我没被允许和……交谈"}, {"type": "subtitle", "time": 10632.79, "timestamp": "02:57:12", "text": "其他人还没到，因为我被告知要等。"}, {"type": "subtitle", "time": 10635.99, "timestamp": "02:57:15", "text": "我很有耐心。哦，不。所以，当时我是"}, {"type": "subtitle", "time": 10638.07, "timestamp": "02:57:18", "text": "比如，“是的，我要自己去做。”"}, {"type": "subtitle", "time": 10640.15, "timestamp": "02:57:20", "text": "我会把它买回来什么的。”"}, {"type": "subtitle", "time": 10643.19, "timestamp": "02:57:23", "text": "他们会说：“好的。”呃，我们"}, {"type": "subtitle", "time": 10647.19, "timestamp": "02:57:27", "text": "协商和许可租赁"}, {"type": "subtitle", "time": 10649.51, "timestamp": "02:57:29", "text": "那东西就在那里，还有所有那些东西。"}, {"type": "subtitle", "time": 10652.87, "timestamp": "02:57:32", "text": "东西。所以，是的，然后我直接"}, {"type": "subtitle", "time": 10655.75, "timestamp": "02:57:35", "text": "联系了艺术家，他们回复说："}, {"type": "subtitle", "time": 10658.23, "timestamp": "02:57:38", "text": "“是啊，已经有一段时间了。你可能……”"}, {"type": "subtitle", "time": 10660.07, "timestamp": "02:57:40", "text": "为了补偿"}, {"type": "subtitle", "time": 10662.71, "timestamp": "02:57:42", "text": "如果我，如果你，如果我需要修理东西，"}, {"type": "subtitle", "time": 10666.71, "timestamp": "02:57:46", "text": "一切。” 我当时就想，是啊，我"}, {"type": "subtitle", "time": 10670.469, "timestamp": "02:57:50", "text": "呃，因为我收到的文件"}, {"type": "subtitle", "time": 10673.83, "timestamp": "02:57:53", "text": "我们遇到了很多问题，比如……"}, {"type": "subtitle", "time": 10675.75, "timestamp": "02:57:55", "text": "脂肪之类的东西。部分内容并非如此"}, {"type": "subtitle", "time": 10678.23, "timestamp": "02:57:58", "text": "分开了。所以，它是无法操纵的。"}]
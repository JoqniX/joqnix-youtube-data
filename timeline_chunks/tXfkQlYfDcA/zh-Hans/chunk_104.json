[{"type": "subtitle", "time": 6241.669, "timestamp": "01:44:01", "text": "实际上。"}, {"type": "subtitle", "time": 6243.91, "timestamp": "01:44:03", "text": "哇。"}, {"type": "subtitle", "time": 6245.91, "timestamp": "01:44:05", "text": "它们是预制的吗？好的。作为一名服务器管理员，我的意思是，"}, {"type": "subtitle", "time": 6248.709, "timestamp": "01:44:08", "text": "如何管理歌曲列表？呃"}, {"type": "subtitle", "time": 6250.55, "timestamp": "01:44:10", "text": "管理您服务器的当前服务器"}, {"type": "subtitle", "time": 6252.79, "timestamp": "01:44:12", "text": "直接前往服务器设置"}, {"type": "subtitle", "time": 6255.03, "timestamp": "01:44:15", "text": "木板。我在大多数服务器上都是如此。"}, {"type": "subtitle", "time": 6260.149, "timestamp": "01:44:20", "text": "版主：我没看到这个东西"}, {"type": "subtitle", "time": 6262.87, "timestamp": "01:44:22", "text": "移除任何内容。所以你必须上传"}, {"type": "subtitle", "time": 6269.59, "timestamp": "01:44:29", "text": "你需要在这里上传音频文件。"}, {"type": "subtitle", "time": 6272.709, "timestamp": "01:44:32", "text": "人们可以使用它。我不认为"}, {"type": "subtitle", "time": 6276.149, "timestamp": "01:44:36", "text": "嗯……我觉得没有办法。"}, {"type": "subtitle", "time": 6278.79, "timestamp": "01:44:38", "text": "因为我认为没有默认值。"}, {"type": "subtitle", "time": 6281.43, "timestamp": "01:44:41", "text": "听起来像贴纸和表情符号"}, {"type": "subtitle", "time": 6284.47, "timestamp": "01:44:44", "text": "你们有服务器所有者，可以叫管理员"}, {"type": "subtitle", "time": 6288.07, "timestamp": "01:44:48", "text": "他们需要上传自己的音频文件。"}, {"type": "subtitle", "time": 6290.149, "timestamp": "01:44:50", "text": "是的。"}, {"type": "subtitle", "time": 6292.149, "timestamp": "01:44:52", "text": "你也可以在游戏叠加层中使用它。"}, {"type": "subtitle", "time": 6294.31, "timestamp": "01:44:54", "text": "当你玩游戏时，玩家"}]
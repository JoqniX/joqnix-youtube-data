[{"type": "subtitle", "time": 12301.429, "timestamp": "03:25:01", "text": "更多经验值可解锁某些功能，例如"}, {"type": "subtitle", "time": 12304.309, "timestamp": "03:25:04", "text": "例如上传超过 16 GB 的文件"}, {"type": "subtitle", "time": 12307.51, "timestamp": "03:25:07", "text": "视频。是的，他们有文件数量限制。"}, {"type": "subtitle", "time": 12309.99, "timestamp": "03:25:09", "text": "东西。所以，我不应该上传"}, {"type": "subtitle", "time": 12313.269, "timestamp": "03:25:13", "text": "超过10GB的文件。所以，为了"}, {"type": "subtitle", "time": 12317.67, "timestamp": "03:25:17", "text": "达到 32GB 或 64GB 的上传限制"}, {"type": "subtitle", "time": 12321.11, "timestamp": "03:25:21", "text": "呃，扩展包，我必须达到三级。"}, {"type": "subtitle", "time": 12323.83, "timestamp": "03:25:23", "text": "我当时真的卡在第二关了。"}, {"type": "subtitle", "time": 12326.63, "timestamp": "03:25:26", "text": "好吧，那是两年前的事了。我的天啊。"}, {"type": "subtitle", "time": 12329.349, "timestamp": "03:25:29", "text": "现在他们改了。他们改了。"}, {"type": "subtitle", "time": 12332.95, "timestamp": "03:25:32", "text": "你必须拥有10万粉丝"}, {"type": "subtitle", "time": 12334.63, "timestamp": "03:25:34", "text": "到"}, {"type": "subtitle", "time": 12338.87, "timestamp": "03:25:38", "text": "具备 4K 画质，可以像上传功能一样上传"}, {"type": "subtitle", "time": 12342.07, "timestamp": "03:25:42", "text": "更高质量的内容。甚至"}, {"type": "subtitle", "time": 12343.91, "timestamp": "03:25:43", "text": "署名之类的东西，对吧？你是什​​么"}, {"type": "subtitle", "time": 12346.469, "timestamp": "03:25:46", "text": "叫它什么？比如版权保护"}, {"type": "subtitle", "time": 12349.83, "timestamp": "03:25:49", "text": "各种东西，以及所有那些必需品。"}, {"type": "subtitle", "time": 12352.229, "timestamp": "03:25:52", "text": "那些被锁定在 1 之下的。"}, {"type": "subtitle", "time": 12355.91, "timestamp": "03:25:55", "text": "百万粉丝什么的。我就像1"}, {"type": "subtitle", "time": 12357.429, "timestamp": "03:25:57", "text": "百万。"}, {"type": "subtitle", "time": 12359.11, "timestamp": "03:25:59", "text": "是的。"}]
[{"type": "subtitle", "time": 12661.83, "timestamp": "03:31:01", "text": "去愚弄 Billy Billy 管理员说"}, {"type": "subtitle", "time": 12665.51, "timestamp": "03:31:05", "text": "这让我看起来像是在玩游戏"}, {"type": "subtitle", "time": 12669.429, "timestamp": "03:31:09", "text": "东西。所以我把它调成了全屏模式，然后……"}, {"type": "subtitle", "time": 12671.269, "timestamp": "03:31:11", "text": "Twitch、YouTube 和其他我创建的地方"}, {"type": "subtitle", "time": 12674.55, "timestamp": "03:31:14", "text": "一条专门给比利·比利的置顶评论。我"}, {"type": "subtitle", "time": 12677.03, "timestamp": "03:31:17", "text": "我用英语写道：我会回来的。"}, {"type": "subtitle", "time": 12680.95, "timestamp": "03:31:20", "text": "某物。我原本以为管理员不会"}, {"type": "subtitle", "time": 12683.83, "timestamp": "03:31:23", "text": "当你尝试理解英语时"}, {"type": "subtitle", "time": 12686.389, "timestamp": "03:31:26", "text": "稍后回来等等。不。所以，有些日子"}, {"type": "subtitle", "time": 12689.83, "timestamp": "03:31:29", "text": "没事。有些日子就像我"}, {"type": "subtitle", "time": 12691.349, "timestamp": "03:31:31", "text": "我觉得是另一位工作人员。"}, {"type": "subtitle", "time": 12693.51, "timestamp": "03:31:33", "text": "正确的？所以，他们大致弄明白了。"}, {"type": "subtitle", "time": 12697.75, "timestamp": "03:31:37", "text": "不是我。然后我意识到他们看着"}, {"type": "subtitle", "time": 12700.87, "timestamp": "03:31:40", "text": "聊天互动也是如此。他们会"}, {"type": "subtitle", "time": 12703.11, "timestamp": "03:31:43", "text": "用另一个账号检查一下"}, {"type": "subtitle", "time": 12705.83, "timestamp": "03:31:45", "text": "主播可能会回应，也可能不会。和"}, {"type": "subtitle", "time": 12708.63, "timestamp": "03:31:48", "text": "他们做那种事是为了加倍努力。"}, {"type": "subtitle", "time": 12712.389, "timestamp": "03:31:52", "text": "查看。什么？是的。"}, {"type": "subtitle", "time": 12715.51, "timestamp": "03:31:55", "text": "太疯狂了。"}, {"type": "subtitle", "time": 12717.349, "timestamp": "03:31:57", "text": "情况很糟糕。但那里可能存在"}, {"type": "subtitle", "time": 12719.75, "timestamp": "03:31:59", "text": "有些情况下，人们不喜欢付费。"}]
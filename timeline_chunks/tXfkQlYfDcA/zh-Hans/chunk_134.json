[{"type": "subtitle", "time": 8040.31, "timestamp": "02:14:00", "text": "那是不是什么东西？等等，稍等"}, {"type": "subtitle", "time": 8043.669, "timestamp": "02:14:03", "text": "向上。呃，为什么你的反应不是这样？"}, {"type": "subtitle", "time": 8046.069, "timestamp": "02:14:06", "text": "加载中，请稍等片刻？让我调试一下"}, {"type": "subtitle", "time": 8049.669, "timestamp": "02:14:09", "text": "它。哦，不。是的。是的。是的。"}, {"type": "subtitle", "time": 8051.189, "timestamp": "02:14:11", "text": "什么时候"}, {"type": "subtitle", "time": 8054.31, "timestamp": "02:14:14", "text": "真是累人，真是……"}, {"type": "subtitle", "time": 8058.47, "timestamp": "02:14:18", "text": "完全是这样，但我活了下来，我想。"}, {"type": "subtitle", "time": 8061.27, "timestamp": "02:14:21", "text": "绝对的。你就像你就像"}, {"type": "subtitle", "time": 8064.069, "timestamp": "02:14:24", "text": "现在正全力推进。我必须这样做"}, {"type": "subtitle", "time": 8070.149, "timestamp": "02:14:30", "text": "你当时真的很期待"}, {"type": "subtitle", "time": 8072.39, "timestamp": "02:14:32", "text": "是的，我大概两周后就能完成。"}, {"type": "subtitle", "time": 8075.51, "timestamp": "02:14:35", "text": "自由了，你就会想：哦，算了。"}, {"type": "subtitle", "time": 8078.47, "timestamp": "02:14:38", "text": "对，事情就是这样。我的天啊。我"}, {"type": "subtitle", "time": 8080.31, "timestamp": "02:14:40", "text": "希望你一切安好。"}, {"type": "subtitle", "time": 8084.149, "timestamp": "02:14:44", "text": "休息一下。很多。是的。"}, {"type": "subtitle", "time": 8088.069, "timestamp": "02:14:48", "text": "很多。嗯。"}, {"type": "subtitle", "time": 8093.35, "timestamp": "02:14:53", "text": "是的。我的天哪。真是令人兴奋。"}, {"type": "subtitle", "time": 8096.47, "timestamp": "02:14:56", "text": "我希望我能像那样，你知道的"}, {"type": "subtitle", "time": 8099.109, "timestamp": "02:14:59", "text": "就像流媒体一样具有韧性"}]
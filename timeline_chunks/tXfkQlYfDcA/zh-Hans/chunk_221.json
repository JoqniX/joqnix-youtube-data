[{"type": "subtitle", "time": 13262.229, "timestamp": "03:41:02", "text": "这太疯狂了，因为开发人员不多。"}, {"type": "subtitle", "time": 13265.51, "timestamp": "03:41:05", "text": "可以直接为比利实施"}, {"type": "subtitle", "time": 13267.75, "timestamp": "03:41:07", "text": "比利。不，因为你需要像一个"}, {"type": "subtitle", "time": 13270.95, "timestamp": "03:41:10", "text": "中国身份证，还有一张中国身份证和一部手机"}, {"type": "subtitle", "time": 13273.349, "timestamp": "03:41:13", "text": "申请所需的号码和材料"}, {"type": "subtitle", "time": 13276.469, "timestamp": "03:41:16", "text": "那里有开发者账号。所以它真是太……"}, {"type": "subtitle", "time": 13279.99, "timestamp": "03:41:19", "text": "疼痛。所以这就是为什么这些第三方"}, {"type": "subtitle", "time": 13283.349, "timestamp": "03:41:23", "text": "人们在这个时候会提供很多帮助。"}, {"type": "subtitle", "time": 13287.83, "timestamp": "03:41:27", "text": "诸如此类的事情。是的。我甚至我"}, {"type": "subtitle", "time": 13290.63, "timestamp": "03:41:30", "text": "甚至还向 Streamabot 请求了人员"}, {"type": "subtitle", "time": 13292.95, "timestamp": "03:41:32", "text": "还有其他一些东西。我还没做过 Mix It Up 呢。"}, {"type": "subtitle", "time": 13295.349, "timestamp": "03:41:35", "text": "因为我不太常用 Mix It Up。我"}, {"type": "subtitle", "time": 13297.59, "timestamp": "03:41:37", "text": "试过一两次，但我感觉……"}, {"type": "subtitle", "time": 13300.71, "timestamp": "03:41:40", "text": "我全心全意为 Sammy 和 Streamabot 服务。"}, {"type": "subtitle", "time": 13304.229, "timestamp": "03:41:44", "text": "他们一直是我所有事情的后盾。"}, {"type": "subtitle", "time": 13306.07, "timestamp": "03:41:46", "text": "是的。"}, {"type": "subtitle", "time": 13308.229, "timestamp": "03:41:48", "text": "哇哦。"}, {"type": "subtitle", "time": 13310.389, "timestamp": "03:41:50", "text": "而且，我甚至还发现了这个新东西。"}, {"type": "subtitle", "time": 13312.87, "timestamp": "03:41:52", "text": "我发现了一个叫做"}, {"type": "subtitle", "time": 13315.59, "timestamp": "03:41:55", "text": "光束流。呃，我不知道你有没有听说。"}, {"type": "subtitle", "time": 13319.03, "timestamp": "03:41:59", "text": "关于它，它就像一个平台"}]
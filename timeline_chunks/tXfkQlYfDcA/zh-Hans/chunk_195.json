[{"type": "subtitle", "time": 11700.95, "timestamp": "03:15:00", "text": "正确的。难道你没有这种感觉吗？"}, {"type": "subtitle", "time": 11703.83, "timestamp": "03:15:03", "text": "你喜欢创作音乐还是从事艺术创作？"}, {"type": "subtitle", "time": 11705.91, "timestamp": "03:15:05", "text": "最后感觉就像是，“什么？”"}, {"type": "subtitle", "time": 11708.07, "timestamp": "03:15:08", "text": "你好？"}, {"type": "subtitle", "time": 11709.75, "timestamp": "03:15:09", "text": "这是怎么发生的？这一切是怎么发生的？"}, {"type": "subtitle", "time": 11711.11, "timestamp": "03:15:11", "text": "聚在一起？"}, {"type": "subtitle", "time": 11714.9, "timestamp": "03:15:14", "text": "是啊，那种感觉真的很好。"}, {"type": "subtitle", "time": 11716.71, "timestamp": "03:15:16", "text": "[音乐]"}, {"type": "subtitle", "time": 11720.309, "timestamp": "03:15:20", "text": "我认为其中一个我认为我"}, {"type": "subtitle", "time": 11722.469, "timestamp": "03:15:22", "text": "认为你的模型是你的模型之一"}, {"type": "subtitle", "time": 11725.83, "timestamp": "03:15:25", "text": "作品被像一个大呃一样的人使用"}, {"type": "subtitle", "time": 11730.389, "timestamp": "03:15:30", "text": "是那种喜欢度假的油管博主吧？啊，是的。"}, {"type": "subtitle", "time": 11733.349, "timestamp": "03:15:33", "text": "是的。我当时就像"}, {"type": "subtitle", "time": 11736.63, "timestamp": "03:15:36", "text": "简直疯了。什么？你去了哪里？"}, {"type": "subtitle", "time": 11739.67, "timestamp": "03:15:39", "text": "来自？是的，它就像是根据"}, {"type": "subtitle", "time": 11741.83, "timestamp": "03:15:41", "text": "就像她画的涂鸦一样，就像我"}, {"type": "subtitle", "time": 11743.75, "timestamp": "03:15:43", "text": "想想看，就像溪流之后那样。就像"}, {"type": "subtitle", "time": 11745.99, "timestamp": "03:15:45", "text": "长腿奥利"}, {"type": "subtitle", "time": 11748.87, "timestamp": "03:15:48", "text": "我当时就想，当然，这太……了！"}, {"type": "subtitle", "time": 11750.469, "timestamp": "03:15:50", "text": "就像恰到好处的傻气和"}, {"type": "subtitle", "time": 11752.71, "timestamp": "03:15:52", "text": "我当时傻乎乎的，心想：是啊，我可以像鞭子一样抽打人。"}, {"type": "subtitle", "time": 11754.95, "timestamp": "03:15:54", "text": "这首歌大概几小节就唱完了。"}, {"type": "subtitle", "time": 11757.11, "timestamp": "03:15:57", "text": "然后我就把它发出来了，好像在想哈哈"}, {"type": "subtitle", "time": 11759.11, "timestamp": "03:15:59", "text": "可能有些人会喜欢它"}]
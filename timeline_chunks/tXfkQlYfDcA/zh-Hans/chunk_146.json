[{"type": "subtitle", "time": 8761.75, "timestamp": "02:26:01", "text": "溪流。所以我也得学普通话。"}, {"type": "subtitle", "time": 8765.51, "timestamp": "02:26:05", "text": "离开。所以我就想，“哦，哇。我会的。”"}, {"type": "subtitle", "time": 8768.309, "timestamp": "02:26:08", "text": "我得先把日语学完，然后我"}, {"type": "subtitle", "time": 8770.63, "timestamp": "02:26:10", "text": "浅尝辄止地学点汉语。"}, {"type": "subtitle", "time": 8773.91, "timestamp": "02:26:13", "text": "我的天啊。一直以来都是这样吗？嗯……"}, {"type": "subtitle", "time": 8775.83, "timestamp": "02:26:15", "text": "这是你想做的事吗？就像你一样"}, {"type": "subtitle", "time": 8777.91, "timestamp": "02:26:17", "text": "了解、学习日语、学习普通话。"}, {"type": "subtitle", "time": 8779.91, "timestamp": "02:26:19", "text": "就像你对学习情有独钟一样"}, {"type": "subtitle", "time": 8781.59, "timestamp": "02:26:21", "text": "语言，或者类似的东西"}, {"type": "subtitle", "time": 8783.349, "timestamp": "02:26:23", "text": "还有其他人像推你一样吗？我不知道。"}, {"type": "subtitle", "time": 8786.79, "timestamp": "02:26:26", "text": "我当时就想，我是说，日本动漫之类的。"}, {"type": "subtitle", "time": 8789.99, "timestamp": "02:26:29", "text": "真的很有趣。我这样真的很有趣"}, {"type": "subtitle", "time": 8793.03, "timestamp": "02:26:33", "text": "我也喜欢日本流行音乐，所以我就想，"}, {"type": "subtitle", "time": 8799.27, "timestamp": "02:26:39", "text": "这就是全部所需。"}, {"type": "subtitle", "time": 8803.11, "timestamp": "02:26:43", "text": "给你。嗯。呃，为了呃，为了"}, {"type": "subtitle", "time": 8805.75, "timestamp": "02:26:45", "text": "至于普通话方面的内容，是因为……"}, {"type": "subtitle", "time": 8808.55, "timestamp": "02:26:48", "text": "我的一位观众，呃，"}, {"type": "subtitle", "time": 8811.03, "timestamp": "02:26:51", "text": "第一次来看我比赛的人"}, {"type": "subtitle", "time": 8813.27, "timestamp": "02:26:53", "text": "他们是中国人，他们说："}, {"type": "subtitle", "time": 8815.51, "timestamp": "02:26:55", "text": "他们必须使用 VPN 之类的东西才能观看"}, {"type": "subtitle", "time": 8817.51, "timestamp": "02:26:57", "text": "YouTube之类的。所以我不知道什么"}]
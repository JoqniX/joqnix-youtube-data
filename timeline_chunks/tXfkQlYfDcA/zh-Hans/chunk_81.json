[{"type": "subtitle", "time": 4865.59, "timestamp": "01:21:05", "text": "我今天得了DSA。这就是所谓的"}, {"type": "subtitle", "time": 4869.669, "timestamp": "01:21:09", "text": "多沙玛萨拉多沙？我想我应该没有"}, {"type": "subtitle", "time": 4873.35, "timestamp": "01:21:13", "text": "知道。我得从我这里把它吃掉。"}, {"type": "subtitle", "time": 4875.75, "timestamp": "01:21:15", "text": "我不想用手。"}, {"type": "subtitle", "time": 4879.189, "timestamp": "01:21:19", "text": "所以，伙计，该休息了。"}, {"type": "subtitle", "time": 4887.83, "timestamp": "01:21:27", "text": "我很高兴我一直带着我的万能宝贝"}, {"type": "subtitle", "time": 4889.91, "timestamp": "01:21:29", "text": "勺子、叉子、刀子，我的所有餐具"}, {"type": "subtitle", "time": 4891.669, "timestamp": "01:21:31", "text": "房间。"}, {"type": "subtitle", "time": 4893.75, "timestamp": "01:21:33", "text": "你想把头发染成灰色吗？我"}, {"type": "subtitle", "time": 4897.03, "timestamp": "01:21:37", "text": "不知道。不，不是灰色。"}, {"type": "subtitle", "time": 4904.55, "timestamp": "01:21:44", "text": "你说的很客气点。"}, {"type": "subtitle", "time": 4906.63, "timestamp": "01:21:46", "text": "我的天啊。为什么打破它如此困难"}, {"type": "subtitle", "time": 4909.189, "timestamp": "01:21:49", "text": "向下？"}, {"type": "subtitle", "time": 4911.91, "timestamp": "01:21:51", "text": "我的天啊。这体质学知识真难懂。是"}, {"type": "subtitle", "time": 4914.07, "timestamp": "01:21:54", "text": "这是我的菜吗？哇，真热啊。为什么"}, {"type": "subtitle", "time": 4917.91, "timestamp": "01:21:57", "text": "用勺子捣碎东西会很烫吗？"}, {"type": "subtitle", "time": 4919.5, "timestamp": "01:21:59", "text": "和"}]
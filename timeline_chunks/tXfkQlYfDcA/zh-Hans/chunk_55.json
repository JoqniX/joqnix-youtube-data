[{"type": "subtitle", "time": 3300.87, "timestamp": "00:55:00", "text": "我当时说的是三股流之类的。"}, {"type": "subtitle", "time": 3305.27, "timestamp": "00:55:05", "text": "讲的是我有多讨厌坐着之类的。"}, {"type": "subtitle", "time": 3308.23, "timestamp": "00:55:08", "text": "还有一些其他的东西，我在这里。"}, {"type": "subtitle", "time": 3311.589, "timestamp": "00:55:11", "text": "因为再次为了生存"}, {"type": "subtitle", "time": 3314.23, "timestamp": "00:55:14", "text": "在这个社会里，你必须获得那些"}, {"type": "subtitle", "time": 3317.109, "timestamp": "00:55:17", "text": "文件、纸张和杂物"}, {"type": "subtitle", "time": 3320.87, "timestamp": "00:55:20", "text": "你喜欢那个学位，但那会很痛苦。"}, {"type": "subtitle", "time": 3322.95, "timestamp": "00:55:22", "text": "看着我。"}, {"type": "subtitle", "time": 3327.03, "timestamp": "00:55:27", "text": "那个说我会……呃，好吧，我不会"}, {"type": "subtitle", "time": 3329.75, "timestamp": "00:55:29", "text": "诚实地进入大学，并认真考虑"}, {"type": "subtitle", "time": 3333.589, "timestamp": "00:55:33", "text": "现在的我。疼痛。现在我知道那种感觉了"}, {"type": "subtitle", "time": 3336.87, "timestamp": "00:55:36", "text": "做个达克人。那是大学生。哦，我的"}, {"type": "subtitle", "time": 3339.19, "timestamp": "00:55:39", "text": "上帝，"}, {"type": "subtitle", "time": 3344.87, "timestamp": "00:55:44", "text": "在你去之前，是的，我不想"}, {"type": "subtitle", "time": 3349.19, "timestamp": "00:55:49", "text": "走吧。那是痛苦。"}, {"type": "subtitle", "time": 3351.27, "timestamp": "00:55:51", "text": "我不想那样做，我的意思是……"}, {"type": "subtitle", "time": 3353.51, "timestamp": "00:55:53", "text": "四年没去了，三四年都没去。"}, {"type": "subtitle", "time": 3357.75, "timestamp": "00:55:57", "text": "但我仍然需要获得学位。"}, {"type": "subtitle", "time": 3359.829, "timestamp": "00:55:59", "text": "不能"}]
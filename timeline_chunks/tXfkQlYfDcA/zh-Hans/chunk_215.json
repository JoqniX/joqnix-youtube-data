[{"type": "subtitle", "time": 12900.229, "timestamp": "03:35:00", "text": "Sammy 和类似主播的东西"}, {"type": "subtitle", "time": 12903.349, "timestamp": "03:35:03", "text": "记录我在 YouTube 上的评论"}, {"type": "subtitle", "time": 12907.19, "timestamp": "03:35:07", "text": "Twitch 转 Discord。所以我想要一种方法"}, {"type": "subtitle", "time": 12909.67, "timestamp": "03:35:09", "text": "是的。是的。我这么做。所以那样就像"}, {"type": "subtitle", "time": 12914.309, "timestamp": "03:35:14", "text": "如果，呃，如果用户要发送某些东西"}, {"type": "subtitle", "time": 12917.67, "timestamp": "03:35:17", "text": "坏坏的，把它删掉，然后隐藏起来，就像……"}, {"type": "subtitle", "time": 12920.07, "timestamp": "03:35:20", "text": "像个安全的地方，对吧？那里"}, {"type": "subtitle", "time": 12922.469, "timestamp": "03:35:22", "text": "将会有一份日志，记录这些内容以及改装赛车手。"}, {"type": "subtitle", "time": 12925.91, "timestamp": "03:35:25", "text": "Discord 可以这样对你使用。"}, {"type": "subtitle", "time": 12928.469, "timestamp": "03:35:28", "text": "知道要惩罚观众之类的，因为……"}, {"type": "subtitle", "time": 12930.63, "timestamp": "03:35:30", "text": "YouTube 上曾经有一些喷子"}, {"type": "subtitle", "time": 12933.59, "timestamp": "03:35:33", "text": "那样做，我就想，是啊，现在你"}, {"type": "subtitle", "time": 12936.95, "timestamp": "03:35:36", "text": "证据确凿，无法掩盖。"}, {"type": "subtitle", "time": 12939.91, "timestamp": "03:35:39", "text": "还有一些类似“是啊，我做了那件事”之类的话。所以"}, {"type": "subtitle", "time": 12943.03, "timestamp": "03:35:43", "text": "有趣的是，日志事件也记录了下来。"}, {"type": "subtitle", "time": 12945.349, "timestamp": "03:35:45", "text": "嗯，接下来会讲到很多细节，所以……"}, {"type": "subtitle", "time": 12947.75, "timestamp": "03:35:47", "text": "你可以用这种方法来记录事情。所以，我"}, {"type": "subtitle", "time": 12950.95, "timestamp": "03:35:50", "text": "确实如此。那很好。我当时就像"}, {"type": "subtitle", "time": 12954.87, "timestamp": "03:35:54", "text": "当然，我也有类似的经历。"}, {"type": "subtitle", "time": 12957.11, "timestamp": "03:35:57", "text": "仅限 Twitch，但通常情况下"}, {"type": "subtitle", "time": 12959.11, "timestamp": "03:35:59", "text": "就像你在模组视图中看到的所有东西一样"}]
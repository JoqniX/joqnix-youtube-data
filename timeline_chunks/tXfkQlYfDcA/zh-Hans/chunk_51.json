[{"type": "subtitle", "time": 3061.91, "timestamp": "00:51:01", "text": "我们回来了。"}, {"type": "subtitle", "time": 3065.43, "timestamp": "00:51:05", "text": "欢迎回来。"}, {"type": "subtitle", "time": 3067.67, "timestamp": "00:51:07", "text": "希望你已经吃过早餐了。"}, {"type": "subtitle", "time": 3080.95, "timestamp": "00:51:20", "text": "宗教"}, {"type": "subtitle", "time": 3082.79, "timestamp": "00:51:22", "text": "身份。"}, {"type": "subtitle", "time": 3091.67, "timestamp": "00:51:31", "text": "被认为很重要。消耗"}, {"type": "subtitle", "time": 3092.8, "timestamp": "00:51:32", "text": "重要。"}, {"type": "subtitle", "time": 3094.95, "timestamp": "00:51:34", "text": "[音乐]"}, {"type": "subtitle", "time": 3096.95, "timestamp": "00:51:36", "text": "好的，我想只有三行。"}, {"type": "subtitle", "time": 3099.75, "timestamp": "00:51:39", "text": "本页左侧"}, {"type": "subtitle", "time": 3101.829, "timestamp": "00:51:41", "text": "在本页末尾。所以，我觉得我"}, {"type": "subtitle", "time": 3105.109, "timestamp": "00:51:45", "text": "我想，应该可以再翻出一页新页吧。"}, {"type": "subtitle", "time": 3108.549, "timestamp": "00:51:48", "text": "而不是写在这里。等待，"}, {"type": "subtitle", "time": 3112.23, "timestamp": "00:51:52", "text": "这个看起来少一些。性似乎"}, {"type": "subtitle", "time": 3117.51, "timestamp": "00:51:57", "text": "更像是一句话两句的简单概括。我可以吗？"}, {"type": "subtitle", "time": 3119.67, "timestamp": "00:51:59", "text": "做出来了吗？我可以写吗？不，我没有"}]
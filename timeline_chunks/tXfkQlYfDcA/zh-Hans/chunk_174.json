[{"type": "subtitle", "time": 10441.51, "timestamp": "02:54:01", "text": "算了吧。但是，但是，然后我"}, {"type": "subtitle", "time": 10444.55, "timestamp": "02:54:04", "text": "是的，这位艺术家确实很努力。我"}, {"type": "subtitle", "time": 10447.349, "timestamp": "02:54:07", "text": "努力建造了这个复杂的"}, {"type": "subtitle", "time": 10450.469, "timestamp": "02:54:10", "text": "复杂的事情。"}, {"type": "subtitle", "time": 10452.07, "timestamp": "02:54:12", "text": "是的。我当时就想，我觉得你"}, {"type": "subtitle", "time": 10454.309, "timestamp": "02:54:14", "text": "应该放手。就像又一次……"}, {"type": "subtitle", "time": 10456.15, "timestamp": "02:54:16", "text": "你提到如果这样做行不通"}, {"type": "subtitle", "time": 10457.91, "timestamp": "02:54:17", "text": "总是有另一种选择。"}, {"type": "subtitle", "time": 10460.15, "timestamp": "02:54:20", "text": "考虑做兼职或"}, {"type": "subtitle", "time": 10461.75, "timestamp": "02:54:21", "text": "就像你知道的，考虑到……"}, {"type": "subtitle", "time": 10464.469, "timestamp": "02:54:24", "text": "继续直播等等"}, {"type": "subtitle", "time": 10467.269, "timestamp": "02:54:27", "text": "最终应该会解决的，但是"}, {"type": "subtitle", "time": 10469.59, "timestamp": "02:54:29", "text": "你再次认为存在某种"}, {"type": "subtitle", "time": 10471.99, "timestamp": "02:54:31", "text": "比如你想达成的截止日期，或者你"}, {"type": "subtitle", "time": 10474.389, "timestamp": "02:54:34", "text": "想放松一下吗？我要"}, {"type": "subtitle", "time": 10477.03, "timestamp": "02:54:37", "text": "我想好好放松一下。是的，"}, {"type": "subtitle", "time": 10481.11, "timestamp": "02:54:41", "text": "因为嗯嗯，因为只要什么都没有"}, {"type": "subtitle", "time": 10483.269, "timestamp": "02:54:43", "text": "发生，"}, {"type": "subtitle", "time": 10486.95, "timestamp": "02:54:46", "text": "只要就像怎么说呢？嗯"}, {"type": "subtitle", "time": 10491.349, "timestamp": "02:54:51", "text": "只要我能还清就行了，至少……"}, {"type": "subtitle", "time": 10494.23, "timestamp": "02:54:54", "text": "呃，至少应该还钱，而且既然我已经……"}, {"type": "subtitle", "time": 10497.19, "timestamp": "02:54:57", "text": "也为了资助我自己的索具设备。"}]
[{"type": "subtitle", "time": 13980.07, "timestamp": "03:53:00", "text": "结识新朋友，喜欢上别人"}, {"type": "subtitle", "time": 13982.229, "timestamp": "03:53:02", "text": "一起。是的。但是，是的，还有……"}, {"type": "subtitle", "time": 13984.229, "timestamp": "03:53:04", "text": "有时候你需要采取一些措施"}, {"type": "subtitle", "time": 13987.91, "timestamp": "03:53:07", "text": "给自己一点喘息的时间。但是就像"}, {"type": "subtitle", "time": 13990.71, "timestamp": "03:53:10", "text": "是的。嗯，我觉得你有一个非常漂亮的"}, {"type": "subtitle", "time": 13992.87, "timestamp": "03:53:12", "text": "善于把人们聚集在一起的能力"}, {"type": "subtitle", "time": 13994.79, "timestamp": "03:53:14", "text": "比如主动联系他人，寻找"}, {"type": "subtitle", "time": 13997.51, "timestamp": "03:53:17", "text": "人们。我觉得就像那样"}, {"type": "subtitle", "time": 14000.15, "timestamp": "03:53:20", "text": "90%的工作。只是结识新朋友"}, {"type": "subtitle", "time": 14002.15, "timestamp": "03:53:22", "text": "就像和他们聊天一样，感受一下气氛。"}, {"type": "subtitle", "time": 14005.189, "timestamp": "03:53:25", "text": "就是那种事。"}, {"type": "subtitle", "time": 14008.95, "timestamp": "03:53:28", "text": "我看到了，我看到了，我看到你，运动健将。我会的"}, {"type": "subtitle", "time": 14012.65, "timestamp": "03:53:32", "text": "我要狠狠揍那个冒牌货一顿。"}, {"type": "subtitle", "time": 14015.03, "timestamp": "03:53:35", "text": "[音乐]"}, {"type": "subtitle", "time": 14024.63, "timestamp": "03:53:44", "text": "是的，我有很多想参加的活动。"}, {"type": "subtitle", "time": 14026.79, "timestamp": "03:53:46", "text": "但我希望做的一件事是"}, {"type": "subtitle", "time": 14030.15, "timestamp": "03:53:50", "text": "嗯，我一直梦想着做我的"}, {"type": "subtitle", "time": 14032.469, "timestamp": "03:53:52", "text": "自己的演唱会"}, {"type": "subtitle", "time": 14036.07, "timestamp": "03:53:56", "text": "以及3D演唱会相关内容。"}, {"type": "subtitle", "time": 14038.63, "timestamp": "03:53:58", "text": "你认识这位名叫……的主播吗？"}]
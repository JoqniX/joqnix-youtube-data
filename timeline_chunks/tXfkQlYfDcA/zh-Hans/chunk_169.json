[{"type": "subtitle", "time": 10143.03, "timestamp": "02:49:03", "text": "看。不，我懂你的感受。没关系。它是"}, {"type": "subtitle", "time": 10146.469, "timestamp": "02:49:06", "text": "好的。是的。不用担心。我明白了。它是"}, {"type": "subtitle", "time": 10150.469, "timestamp": "02:49:10", "text": "更像是……嗯……我想我已经展示过了"}, {"type": "subtitle", "time": 10152.87, "timestamp": "02:49:12", "text": "最初我把它告诉了少数人。"}, {"type": "subtitle", "time": 10157.429, "timestamp": "02:49:17", "text": "本来想在Joathon活动期间稍微透露一下，但是"}, {"type": "subtitle", "time": 10159.75, "timestamp": "02:49:19", "text": "呃，因为就像……呃"}, {"type": "subtitle", "time": 10161.83, "timestamp": "02:49:21", "text": "幕后种种复杂情况"}, {"type": "subtitle", "time": 10164.71, "timestamp": "02:49:24", "text": "这些东西，还有我必须获得的许可证。"}, {"type": "subtitle", "time": 10167.03, "timestamp": "02:49:27", "text": "能够证明这一点，以及很多"}, {"type": "subtitle", "time": 10171.429, "timestamp": "02:49:31", "text": "事物。什么？是的。等等，什么？我不"}, {"type": "subtitle", "time": 10173.349, "timestamp": "02:49:33", "text": "知道。哇。事情正在变得"}, {"type": "subtitle", "time": 10176.51, "timestamp": "02:49:36", "text": "这里情况比较复杂。"}, {"type": "subtitle", "time": 10182.63, "timestamp": "02:49:42", "text": "是的，我给你发了私信。就是这样。"}, {"type": "subtitle", "time": 10184.63, "timestamp": "02:49:44", "text": "发生了。"}, {"type": "subtitle", "time": 10186.63, "timestamp": "02:49:46", "text": "所以还行"}, {"type": "subtitle", "time": 10190.23, "timestamp": "02:49:50", "text": "哦不，"}, {"type": "subtitle", "time": 10193.83, "timestamp": "02:49:53", "text": "因为我要走自己的路。"}]
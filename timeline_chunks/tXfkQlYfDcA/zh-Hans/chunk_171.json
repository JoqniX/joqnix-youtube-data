[{"type": "subtitle", "time": 10263.11, "timestamp": "02:51:03", "text": "准备好迎接震撼吧。"}, {"type": "subtitle", "time": 10266.15, "timestamp": "02:51:06", "text": "太漂亮了。"}, {"type": "subtitle", "time": 10269.349, "timestamp": "02:51:09", "text": "我的天啊。"}, {"type": "subtitle", "time": 10273.269, "timestamp": "02:51:13", "text": "就像当谈到喜欢的时候那样"}, {"type": "subtitle", "time": 10276.63, "timestamp": "02:51:16", "text": "选择某些元素？你刚才是不是……"}, {"type": "subtitle", "time": 10279.03, "timestamp": "02:51:19", "text": "知道自己想要什么吗？"}, {"type": "subtitle", "time": 10281.269, "timestamp": "02:51:21", "text": "呃，我希望这将是我的原创作品"}, {"type": "subtitle", "time": 10285.19, "timestamp": "02:51:25", "text": "某种程度上来说，这其实是官方版本。嗯，还有"}, {"type": "subtitle", "time": 10287.67, "timestamp": "02:51:27", "text": "我把现在的运动员和"}, {"type": "subtitle", "time": 10291.91, "timestamp": "02:51:31", "text": "PNG初始设计、PNG 3D和实时电视"}, {"type": "subtitle", "time": 10295.03, "timestamp": "02:51:35", "text": "jocks 嗯，初始设计系列的东西"}, {"type": "subtitle", "time": 10297.75, "timestamp": "02:51:37", "text": "我在这里，但我以为我不在这里"}, {"type": "subtitle", "time": 10299.99, "timestamp": "02:51:39", "text": "星座或天体主题就足够了。"}, {"type": "subtitle", "time": 10302.23, "timestamp": "02:51:42", "text": "所以我就想，我干脆就用了整个“我”这个概念。"}, {"type": "subtitle", "time": 10305.349, "timestamp": "02:51:45", "text": "在这方面下了很大功夫，使它变得独一无二。"}, {"type": "subtitle", "time": 10307.67, "timestamp": "02:51:47", "text": "可能的。简直是超凡脱俗"}, {"type": "subtitle", "time": 10309.91, "timestamp": "02:51:49", "text": "就像星座一样。"}, {"type": "subtitle", "time": 10319.59, "timestamp": "02:51:59", "text": "所以，嗯，我，嗯，是的，大部分"}]
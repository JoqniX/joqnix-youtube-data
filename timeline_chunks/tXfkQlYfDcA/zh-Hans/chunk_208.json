[{"type": "subtitle", "time": 12482.469, "timestamp": "03:28:02", "text": "这对YouTube用户来说处于不利地位，而且"}, {"type": "subtitle", "time": 12484.389, "timestamp": "03:28:04", "text": "他们必须挺身而出，奋起反抗。"}, {"type": "subtitle", "time": 12486.95, "timestamp": "03:28:06", "text": "然后发起请愿之类的活动来表达喜爱之情。"}, {"type": "subtitle", "time": 12489.429, "timestamp": "03:28:09", "text": "改变。如果很多人都在说"}, {"type": "subtitle", "time": 12491.11, "timestamp": "03:28:11", "text": "如果要改变某些事情，那么他们就会"}, {"type": "subtitle", "time": 12494.15, "timestamp": "03:28:14", "text": "破例等等。和"}, {"type": "subtitle", "time": 12497.349, "timestamp": "03:28:17", "text": "我就是这样学会了如何做这件事。"}, {"type": "subtitle", "time": 12500.15, "timestamp": "03:28:20", "text": "Billy Billy 有他们自己的虚拟主播"}, {"type": "subtitle", "time": 12502.309, "timestamp": "03:28:22", "text": "市场，是的，他们有一个"}, {"type": "subtitle", "time": 12505.03, "timestamp": "03:28:25", "text": "实际上，他们的资产都在市场上出售。"}, {"type": "subtitle", "time": 12508.07, "timestamp": "03:28:28", "text": "就像所有这些流媒体叠加层一样"}, {"type": "subtitle", "time": 12510.55, "timestamp": "03:28:30", "text": "还有插件之类的东西，对吧，给比利"}, {"type": "subtitle", "time": 12512.71, "timestamp": "03:28:32", "text": "比利。那就像比利那样"}, {"type": "subtitle", "time": 12514.95, "timestamp": "03:28:34", "text": "比利本人。就像有一个单独的"}, {"type": "subtitle", "time": 12517.269, "timestamp": "03:28:37", "text": "市场。是的。是的。是的。和"}, {"type": "subtitle", "time": 12520.229, "timestamp": "03:28:40", "text": "对第三方来说，这太疯狂了"}, {"type": "subtitle", "time": 12523.349, "timestamp": "03:28:43", "text": "东西。他们称之为比利·普莱或"}, {"type": "subtitle", "time": 12526.07, "timestamp": "03:28:46", "text": "某物。"}, {"type": "subtitle", "time": 12527.83, "timestamp": "03:28:47", "text": "比利有他们自己的游戏，"}, {"type": "subtitle", "time": 12529.75, "timestamp": "03:28:49", "text": "一切都对吧？游戏商店之类的，"}, {"type": "subtitle", "time": 12532.15, "timestamp": "03:28:52", "text": "电影、电视剧，所有那些东西。"}, {"type": "subtitle", "time": 12533.99, "timestamp": "03:28:53", "text": "是的，他们有自己的游戏。是的，"}, {"type": "subtitle", "time": 12536.309, "timestamp": "03:28:56", "text": "谷歌。它完全就像一场流媒体播放。"}, {"type": "subtitle", "time": 12539.11, "timestamp": "03:28:59", "text": "类似 YouTube 的平台。"}]
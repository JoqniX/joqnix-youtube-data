[{"type": "subtitle", "time": 15003.349, "timestamp": "04:10:03", "text": "流式传输。哦，那太酷了。哦。"}, {"type": "subtitle", "time": 15005.91, "timestamp": "04:10:05", "text": "哦，我看到你们所有人都像这样……"}, {"type": "subtitle", "time": 15007.83, "timestamp": "04:10:07", "text": "摘要。哦，太可爱了。所以，我们"}, {"type": "subtitle", "time": 15010.229, "timestamp": "04:10:10", "text": "把所有缩略图都放在一起了。"}, {"type": "subtitle", "time": 15011.83, "timestamp": "04:10:11", "text": "是的。是的。这就像……"}, {"type": "subtitle", "time": 15017.11, "timestamp": "04:10:17", "text": "我以前做过的一项实验。是的。"}, {"type": "subtitle", "time": 15019.59, "timestamp": "04:10:19", "text": "是啊，我真希望自己会编程。我可以"}, {"type": "subtitle", "time": 15021.429, "timestamp": "04:10:21", "text": "做了很多事。有这么多"}, {"type": "subtitle", "time": 15023.75, "timestamp": "04:10:23", "text": "我有很多想做的事情。你也会的"}, {"type": "subtitle", "time": 15027.03, "timestamp": "04:10:27", "text": "杰克，你很厉害。就是这样。"}, {"type": "subtitle", "time": 15029.349, "timestamp": "04:10:29", "text": "大自然不得不让它谦卑，不得不让它谦卑。"}, {"type": "subtitle", "time": 15032.389, "timestamp": "04:10:32", "text": "有点像……"}, {"type": "subtitle", "time": 15034.469, "timestamp": "04:10:34", "text": "想象一下，如果你拥有……你将拥有多么强大的力量"}, {"type": "subtitle", "time": 15036.469, "timestamp": "04:10:36", "text": "对啊，我简直就是个大师。"}, {"type": "subtitle", "time": 15039.99, "timestamp": "04:10:39", "text": "编程也太厉害了，我的天哪，没人会这么做"}, {"type": "subtitle", "time": 15042.469, "timestamp": "04:10:42", "text": "能够有机会"}, {"type": "subtitle", "time": 15049.51, "timestamp": "04:10:49", "text": "哇"}, {"type": "subtitle", "time": 15054.229, "timestamp": "04:10:54", "text": "是啊，很多类似的事情都很有趣。"}, {"type": "subtitle", "time": 15057.03, "timestamp": "04:10:57", "text": "从某种意义上说，它更像是一种灵感。"}]
[{"type": "subtitle", "time": 2169.829, "timestamp": "00:36:09", "text": "一些备用方案。"}, {"type": "subtitle", "time": 2173.43, "timestamp": "00:36:13", "text": "欢迎回来。嗨，我又回来了。"}, {"type": "subtitle", "time": 2182.39, "timestamp": "00:36:22", "text": "是的，你可能会再次受到欢迎，因为"}, {"type": "subtitle", "time": 2184.71, "timestamp": "00:36:24", "text": "它重启了。"}, {"type": "subtitle", "time": 2187.349, "timestamp": "00:36:27", "text": "我轮班去祝愿萨米一切顺利"}, {"type": "subtitle", "time": 2191.43, "timestamp": "00:36:31", "text": "重启了吗？"}, {"type": "subtitle", "time": 2194.23, "timestamp": "00:36:34", "text": "我们开始写作吧。"}, {"type": "subtitle", "time": 2196.069, "timestamp": "00:36:36", "text": "和往常一样，我的直播正在进行中。"}, {"type": "subtitle", "time": 2200.87, "timestamp": "00:36:40", "text": "向下。直播可能会变成B。呃，"}, {"type": "subtitle", "time": 2202.71, "timestamp": "00:36:42", "text": "我的天啊。没关系。我不想"}, {"type": "subtitle", "time": 2206.79, "timestamp": "00:36:46", "text": "好好想想。没关系。讨论"}, {"type": "subtitle", "time": 2209.91, "timestamp": "00:36:49", "text": "身份的社会基础。"}, {"type": "subtitle", "time": 2211.75, "timestamp": "00:36:51", "text": "哦，这关乎阶级和种族。"}, {"type": "subtitle", "time": 2216.57, "timestamp": "00:36:56", "text": "宗教。哦好的。我的天啊。"}, {"type": "subtitle", "time": 2217.75, "timestamp": "00:36:57", "text": "[音乐]"}]
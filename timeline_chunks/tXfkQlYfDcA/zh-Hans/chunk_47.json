[{"type": "subtitle", "time": 2821.43, "timestamp": "00:47:01", "text": "哦。哦，是的。我忘了提VC。"}, {"type": "subtitle", "time": 2823.75, "timestamp": "00:47:03", "text": "Face现在也配备了RTX追踪器，就像……"}, {"type": "subtitle", "time": 2826.87, "timestamp": "00:47:06", "text": "YouTube 工作室。"}, {"type": "subtitle", "time": 2829.349, "timestamp": "00:47:09", "text": "我当时就想，哇。"}, {"type": "subtitle", "time": 2831.829, "timestamp": "00:47:11", "text": "好的。好的。"}, {"type": "subtitle", "time": 2834.87, "timestamp": "00:47:14", "text": "说到这里，我们还没有拿出来"}, {"type": "subtitle", "time": 2839.589, "timestamp": "00:47:19", "text": "我们的3D骑师很久没出现了，对吧？"}, {"type": "subtitle", "time": 2841.91, "timestamp": "00:47:21", "text": "我一直在使用 Live 2D Jockey，大概有……"}, {"type": "subtitle", "time": 2844.39, "timestamp": "00:47:24", "text": "现在一切都结束了。"}, {"type": "subtitle", "time": 2847.19, "timestamp": "00:47:27", "text": "我并没有忘记骑师或"}, {"type": "subtitle", "time": 2849.91, "timestamp": "00:47:29", "text": "迷你骑师。"}, {"type": "subtitle", "time": 2851.91, "timestamp": "00:47:31", "text": "它们还在那里。"}, {"type": "subtitle", "time": 2854.79, "timestamp": "00:47:34", "text": "仍然需要一个，因为我就像在分享我的"}, {"type": "subtitle", "time": 2858.47, "timestamp": "00:47:38", "text": "在这两个桃子之间装填。"}, {"type": "subtitle", "time": 2861.829, "timestamp": "00:47:41", "text": "所以，我只能打开 GB Jockey。"}, {"type": "subtitle", "time": 2865.829, "timestamp": "00:47:45", "text": "在我的流式 Py 中，但如果我使用 3D 的话"}, {"type": "subtitle", "time": 2868.63, "timestamp": "00:47:48", "text": "或者我必须在 Joy 上使用它的实时 2D 模式。"}, {"type": "subtitle", "time": 2871.51, "timestamp": "00:47:51", "text": "Py"}, {"type": "subtitle", "time": 2873.91, "timestamp": "00:47:53", "text": "就像使用 NDI 发送一样"}, {"type": "subtitle", "time": 2877.349, "timestamp": "00:47:57", "text": "使用 OBS，这样你们就能看到了。这是善意的"}]
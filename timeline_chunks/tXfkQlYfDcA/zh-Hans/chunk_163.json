[{"type": "subtitle", "time": 9781.03, "timestamp": "02:43:01", "text": "对音乐方面的东西感兴趣。我小时候"}, {"type": "subtitle", "time": 9784.55, "timestamp": "02:43:04", "text": "就像，呃，当我进入电脑时，我感觉就像……"}, {"type": "subtitle", "time": 9786.55, "timestamp": "02:43:06", "text": "就像三年级学生一样上网。所以，我"}, {"type": "subtitle", "time": 9788.469, "timestamp": "02:43:08", "text": "就像理解互联网是如何运作的一样"}, {"type": "subtitle", "time": 9790.23, "timestamp": "02:43:10", "text": "工作和其他一切。陷入了这个"}, {"type": "subtitle", "time": 9793.03, "timestamp": "02:43:13", "text": "音乐方面，比如电子舞曲之类的"}, {"type": "subtitle", "time": 9795.67, "timestamp": "02:43:15", "text": "音乐等等。不。所以我想要"}, {"type": "subtitle", "time": 9798.63, "timestamp": "02:43:18", "text": "成为DJ或制作人，音乐"}, {"type": "subtitle", "time": 9801.67, "timestamp": "02:43:21", "text": "像我这样的制作人，喜欢自己动手做东西。"}, {"type": "subtitle", "time": 9803.27, "timestamp": "02:43:23", "text": "音乐，"}, {"type": "subtitle", "time": 9805.99, "timestamp": "02:43:25", "text": "让人们快乐，让人们微笑"}, {"type": "subtitle", "time": 9809.67, "timestamp": "02:43:29", "text": "让我的情绪和想法自由流露"}, {"type": "subtitle", "time": 9812.389, "timestamp": "02:43:32", "text": "以音乐音调的形式表达出来"}, {"type": "subtitle", "time": 9815.67, "timestamp": "02:43:35", "text": "东西。这就是我制作运动护裆的方法。"}, {"type": "subtitle", "time": 9817.99, "timestamp": "02:43:37", "text": "最初就像艺名一样"}, {"type": "subtitle", "time": 9823.83, "timestamp": "02:43:43", "text": "东西。然后我就很可爱。嗯。嗯，我得到了"}, {"type": "subtitle", "time": 9826.309, "timestamp": "02:43:46", "text": "在这个音乐vlog里，我遇到了点问题。"}, {"type": "subtitle", "time": 9828.07, "timestamp": "02:43:48", "text": "我无法取得进展。我被困住了"}, {"type": "subtitle", "time": 9831.269, "timestamp": "02:43:51", "text": "看了好多FL Studio教程"}, {"type": "subtitle", "time": 9833.429, "timestamp": "02:43:53", "text": "我当时感觉筋疲力尽，然后就想：啊"}, {"type": "subtitle", "time": 9836.71, "timestamp": "02:43:56", "text": "我完全不会写歌。我被困住了。我"}, {"type": "subtitle", "time": 9839.429, "timestamp": "02:43:59", "text": "不知道哪里出了问题，"}]
[{"type": "subtitle", "time": 7201.03, "timestamp": "02:00:01", "text": "那句老话总是这么说，对吧？"}, {"type": "subtitle", "time": 7204.709, "timestamp": "02:00:04", "text": "乔伊得到了这个"}, {"type": "subtitle", "time": 7208.55, "timestamp": "02:00:08", "text": "男人。我当时在想自己会不会生病"}, {"type": "subtitle", "time": 7212.95, "timestamp": "02:00:12", "text": "喝茶时感到疲倦"}, {"type": "subtitle", "time": 7215.51, "timestamp": "02:00:15", "text": "我感觉到了什么。我觉得我"}, {"type": "subtitle", "time": 7217.669, "timestamp": "02:00:17", "text": "不知道。我感觉"}, {"type": "subtitle", "time": 7220.629, "timestamp": "02:00:20", "text": "我感觉怪怪的。啊，"}, {"type": "subtitle", "time": 7228.98, "timestamp": "02:00:28", "text": "等待。"}, {"type": "subtitle", "time": 7231.27, "timestamp": "02:00:31", "text": "[音乐]"}, {"type": "subtitle", "time": 7246.79, "timestamp": "02:00:46", "text": "班级"}, {"type": "subtitle", "time": 7249.43, "timestamp": "02:00:49", "text": "基于"}, {"type": "subtitle", "time": 7256.229, "timestamp": "02:00:56", "text": "分层。"}, {"type": "subtitle", "time": 7258.95, "timestamp": "02:00:58", "text": "汇报"}]
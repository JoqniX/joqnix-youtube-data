[{"type": "subtitle", "time": 8820.469, "timestamp": "02:27:00", "text": "这意味着。所以我查了一下，然后"}, {"type": "subtitle", "time": 8823.19, "timestamp": "02:27:03", "text": "明白中国人不能"}, {"type": "subtitle", "time": 8825.349, "timestamp": "02:27:05", "text": "访问 YouTube、Twitch 和 Discord"}, {"type": "subtitle", "time": 8828.23, "timestamp": "02:27:08", "text": "一切。啊，所以我当时就想，我已经……"}, {"type": "subtitle", "time": 8830.71, "timestamp": "02:27:10", "text": "从关注Hol的直播之类的事情中了解到的。"}, {"type": "subtitle", "time": 8833.03, "timestamp": "02:27:13", "text": "他们曾在Billy Billy上直播过。所以，我"}, {"type": "subtitle", "time": 8835.27, "timestamp": "02:27:15", "text": "选择去那里。很难找到一个"}, {"type": "subtitle", "time": 8839.51, "timestamp": "02:27:19", "text": "直播之类的方式，但谢天谢地我"}, {"type": "subtitle", "time": 8842.55, "timestamp": "02:27:22", "text": "我找到了一个帮助我的人。"}, {"type": "subtitle", "time": 8844.79, "timestamp": "02:27:24", "text": "呃，为了获得无线网络接入之类的东西"}, {"type": "subtitle", "time": 8847.27, "timestamp": "02:27:27", "text": "一切。然后我开始直播"}, {"type": "subtitle", "time": 8850.07, "timestamp": "02:27:30", "text": "当时我就想，是啊，大家都在那里。"}, {"type": "subtitle", "time": 8852.95, "timestamp": "02:27:32", "text": "不懂英语。它完全是中文的。"}, {"type": "subtitle", "time": 8856.79, "timestamp": "02:27:36", "text": "是的。是的。还有语言障碍"}, {"type": "subtitle", "time": 8860.15, "timestamp": "02:27:40", "text": "这很难，我当时就想，我希望"}, {"type": "subtitle", "time": 8863.91, "timestamp": "02:27:43", "text": "与这里的人们交流"}, {"type": "subtitle", "time": 8866.389, "timestamp": "02:27:46", "text": "没错，这样他们才能理解我。"}, {"type": "subtitle", "time": 8869.11, "timestamp": "02:27:49", "text": "因为我不想让他们使用 VPN"}, {"type": "subtitle", "time": 8871.349, "timestamp": "02:27:51", "text": "加速器之类的东西，还有……"}, {"type": "subtitle", "time": 8874.79, "timestamp": "02:27:54", "text": "YouTube 上的内容太多了，对吧？"}, {"type": "subtitle", "time": 8876.79, "timestamp": "02:27:56", "text": "如果我在那里，对他们来说会很方便。"}, {"type": "subtitle", "time": 8879.349, "timestamp": "02:27:59", "text": "而且我随时都可以进行多线程编程，对吧？"}]
[{"type": "subtitle", "time": 5761.35, "timestamp": "01:36:01", "text": "我带着茶回来了。我刚刚完成了我的"}, {"type": "subtitle", "time": 5764.95, "timestamp": "01:36:04", "text": "现在吃早餐就像……嗯，前31名"}, {"type": "subtitle", "time": 5768.709, "timestamp": "01:36:08", "text": "我的问题"}, {"type": "subtitle", "time": 5773.51, "timestamp": "01:36:13", "text": "所以，呃，这个问题似乎有点……"}, {"type": "subtitle", "time": 5776.149, "timestamp": "01:36:16", "text": "这是……等等，这是油吗？等等，什么？"}, {"type": "subtitle", "time": 5779.189, "timestamp": "01:36:19", "text": "什么？什么？"}, {"type": "subtitle", "time": 5782.629, "timestamp": "01:36:22", "text": "是她的写作吗？我的天啊。"}, {"type": "subtitle", "time": 5785.59, "timestamp": "01:36:25", "text": "是的。你好，Zuki。你好吗？"}, {"type": "subtitle", "time": 5787.189, "timestamp": "01:36:27", "text": "希望你一切都好。早上好。"}, {"type": "subtitle", "time": 5793.03, "timestamp": "01:36:33", "text": "您正在观看流媒体。等等，这可能"}, {"type": "subtitle", "time": 5795.669, "timestamp": "01:36:35", "text": "可能是你正在观看直播的那个小时，"}, {"type": "subtitle", "time": 5798.26, "timestamp": "01:36:38", "text": "正确的？"}, {"type": "subtitle", "time": 5804.87, "timestamp": "01:36:44", "text": "[音乐]"}, {"type": "subtitle", "time": 5806.709, "timestamp": "01:36:46", "text": "让我"}, {"type": "subtitle", "time": 5809.75, "timestamp": "01:36:49", "text": "用水擦拭干净。我不"}, {"type": "subtitle", "time": 5812.79, "timestamp": "01:36:52", "text": "我希望我的纸张能沾上油或其他什么东西。"}, {"type": "subtitle", "time": 5814.629, "timestamp": "01:36:54", "text": "不"}, {"type": "subtitle", "time": 5816.79, "timestamp": "01:36:56", "text": "疼痛。在这样的时刻，我多么希望自己能……"}, {"type": "subtitle", "time": 5819.669, "timestamp": "01:36:59", "text": "考试委员会之类的。"}]
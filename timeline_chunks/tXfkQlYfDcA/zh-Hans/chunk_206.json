[{"type": "subtitle", "time": 12361.91, "timestamp": "03:26:01", "text": "这并非疯狂之举。那是给"}, {"type": "subtitle", "time": 12363.83, "timestamp": "03:26:03", "text": "喜欢视频内容的人会看视频"}, {"type": "subtitle", "time": 12367.349, "timestamp": "03:26:07", "text": "创造者。就像视频上传者和创作者一样"}, {"type": "subtitle", "time": 12371.19, "timestamp": "03:26:11", "text": "适用于直播用户。我的天哪，他们"}, {"type": "subtitle", "time": 12374.71, "timestamp": "03:26:14", "text": "最近添加了一条 OBS 第三方规则"}, {"type": "subtitle", "time": 12377.99, "timestamp": "03:26:17", "text": "而早在去年到去年这段时间里……"}, {"type": "subtitle", "time": 12380.389, "timestamp": "03:26:20", "text": "那一年，你只需要100"}, {"type": "subtitle", "time": 12384.469, "timestamp": "03:26:24", "text": "粉丝们可以直接使用 OBS 进行操作"}, {"type": "subtitle", "time": 12387.349, "timestamp": "03:26:27", "text": "像 RTMP 服务一样向 Billy 提供流媒体服务"}, {"type": "subtitle", "time": 12390.95, "timestamp": "03:26:30", "text": "对，我需要RTMP协议。"}, {"type": "subtitle", "time": 12392.79, "timestamp": "03:26:32", "text": "比利提供的链接，可以把它放上去"}, {"type": "subtitle", "time": 12395.51, "timestamp": "03:26:35", "text": "多流传输，所以我不需要添加更多内容"}, {"type": "subtitle", "time": 12398.389, "timestamp": "03:26:38", "text": "OBS 提供的额外资源"}, {"type": "subtitle", "time": 12403.67, "timestamp": "03:26:43", "text": "没错。现在他们把它改成了这样"}, {"type": "subtitle", "time": 12406.79, "timestamp": "03:26:46", "text": "我曾经……我当时好像不到50岁。"}, {"type": "subtitle", "time": 12409.11, "timestamp": "03:26:49", "text": "那段时间。所以，我还需要大约50个。"}, {"type": "subtitle", "time": 12412.07, "timestamp": "03:26:52", "text": "我当时只是想凑够100个粉丝。"}, {"type": "subtitle", "time": 12414.15, "timestamp": "03:26:54", "text": "他们建议你使用"}, {"type": "subtitle", "time": 12417.11, "timestamp": "03:26:57", "text": "他们的平台官方流媒体"}]
[{"type": "subtitle", "time": 14281.83, "timestamp": "03:58:01", "text": "如果你处于紧张刺激的游戏环境中"}, {"type": "subtitle", "time": 14283.83, "timestamp": "03:58:03", "text": "你将无法按下该键，但是"}, {"type": "subtitle", "time": 14286.63, "timestamp": "03:58:06", "text": "对，你会被困住的。所以脚"}, {"type": "subtitle", "time": 14291.429, "timestamp": "03:58:11", "text": "踩踏板可以起到作用。确切地。哦，是的。"}, {"type": "subtitle", "time": 14293.75, "timestamp": "03:58:13", "text": "我还有我的脚踏板。你通常会这样做"}, {"type": "subtitle", "time": 14297.03, "timestamp": "03:58:17", "text": "那。我以前也那样做，但自从我"}, {"type": "subtitle", "time": 14300.71, "timestamp": "03:58:20", "text": "我的游戏电脑显卡丢了，显卡也丢了。"}, {"type": "subtitle", "time": 14304.229, "timestamp": "03:58:24", "text": "CPU 使用 6 年后损坏。它"}, {"type": "subtitle", "time": 14306.63, "timestamp": "03:58:26", "text": "不是生命维持系统。"}, {"type": "subtitle", "time": 14310.55, "timestamp": "03:58:30", "text": "我以前用的是双电脑配置。所以"}, {"type": "subtitle", "time": 14313.03, "timestamp": "03:58:33", "text": "我以前经常用脚踏板。"}, {"type": "subtitle", "time": 14316.71, "timestamp": "03:58:36", "text": "自从我得到它之后。而那时我……"}, {"type": "subtitle", "time": 14318.71, "timestamp": "03:58:38", "text": "因为它没有在印度上映。"}, {"type": "subtitle", "time": 14321.189, "timestamp": "03:58:41", "text": "然而。 Elgato脚踏板，对吧？溪流"}, {"type": "subtitle", "time": 14323.189, "timestamp": "03:58:43", "text": "踏板式唱盘。是的。未发布"}, {"type": "subtitle", "time": 14325.91, "timestamp": "03:58:45", "text": "印度尚未出现。所以我不得不从……订购。"}, {"type": "subtitle", "time": 14329.11, "timestamp": "03:58:49", "text": "就像点餐一样，嗯，是的。像这样订购"}, {"type": "subtitle", "time": 14331.67, "timestamp": "03:58:51", "text": "来自美国之类的。所以就在那时"}, {"type": "subtitle", "time": 14334.309, "timestamp": "03:58:54", "text": "我了解了海关这种东西。"}, {"type": "subtitle", "time": 14338.87, "timestamp": "03:58:58", "text": "我的天哪。哦不，"}]
[{"type": "subtitle", "time": 6305.27, "timestamp": "01:45:05", "text": "事情就是这样发生的。当你玩游戏时"}, {"type": "subtitle", "time": 6308.229, "timestamp": "01:45:08", "text": "发出声音后，就会显示表情符号。"}, {"type": "subtitle", "time": 6310.79, "timestamp": "01:45:10", "text": "它会显示该图标。这意味着当"}, {"type": "subtitle", "time": 6313.189, "timestamp": "01:45:13", "text": "你可以添加声音，也可以添加图像。"}, {"type": "subtitle", "time": 6315.59, "timestamp": "01:45:15", "text": "出色地。所以那张图片就会弹出来。"}, {"type": "subtitle", "time": 6318.95, "timestamp": "01:45:18", "text": "你的声音装置。有趣的。那是"}, {"type": "subtitle", "time": 6321.669, "timestamp": "01:45:21", "text": "凉爽的。这是声音图标。你会"}, {"type": "subtitle", "time": 6323.51, "timestamp": "01:45:23", "text": "看"}, {"type": "subtitle", "time": 6325.83, "timestamp": "01:45:25", "text": "你在风险投资中"}, {"type": "subtitle", "time": 6333.189, "timestamp": "01:45:33", "text": "不，这是为了……而不是为了"}, {"type": "subtitle", "time": 6340.229, "timestamp": "01:45:40", "text": "我觉得这应该不是给硝基燃料用的。"}, {"type": "subtitle", "time": 6342.229, "timestamp": "01:45:42", "text": "这适用于所有人，就像"}, {"type": "subtitle", "time": 6345.109, "timestamp": "01:45:45", "text": "活动。"}, {"type": "subtitle", "time": 6346.95, "timestamp": "01:45:46", "text": "他们会把它做成高级商品。"}, {"type": "subtitle", "time": 6351.03, "timestamp": "01:45:51", "text": "加起来就像，是的，他们做到了。"}, {"type": "subtitle", "time": 6353.91, "timestamp": "01:45:53", "text": "他们做到了"}, {"type": "subtitle", "time": 6356.629, "timestamp": "01:45:56", "text": "就像贴纸和表情符号一样"}, {"type": "subtitle", "time": 6359.43, "timestamp": "01:45:59", "text": "服务器端的表情符号。预版本"}]
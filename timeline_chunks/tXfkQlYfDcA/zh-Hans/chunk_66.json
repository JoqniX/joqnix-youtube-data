[{"type": "subtitle", "time": 3961.67, "timestamp": "01:06:01", "text": "例如，如果你已经完成了学业，那么……"}, {"type": "subtitle", "time": 3965.51, "timestamp": "01:06:05", "text": "你完成了十年级考试"}, {"type": "subtitle", "time": 3968.069, "timestamp": "01:06:08", "text": "东西，但一旦你得到结果，大多数"}, {"type": "subtitle", "time": 3970.15, "timestamp": "01:06:10", "text": "你可能已经通过邮件或视频获得了结果。"}, {"type": "subtitle", "time": 3974.23, "timestamp": "01:06:14", "text": "下个月，四月或者五月，你"}, {"type": "subtitle", "time": 3976.789, "timestamp": "01:06:16", "text": "你得找到下一所学校或者类似的地方"}, {"type": "subtitle", "time": 3979.51, "timestamp": "01:06:19", "text": "当然，或者适合11年级或以上学生的课程。"}, {"type": "subtitle", "time": 3982.39, "timestamp": "01:06:22", "text": "12年级。所以你们之间有点差距。"}, {"type": "subtitle", "time": 3984.63, "timestamp": "01:06:24", "text": "直至六月"}, {"type": "subtitle", "time": 3987.99, "timestamp": "01:06:27", "text": "或者可能是七月份开学。"}, {"type": "subtitle", "time": 3991.67, "timestamp": "01:06:31", "text": "但有时他们会额外加一些……"}, {"type": "subtitle", "time": 3994.789, "timestamp": "01:06:34", "text": "类似主类之前的那些类"}, {"type": "subtitle", "time": 3998.309, "timestamp": "01:06:38", "text": "就像那些额外的夏天一样开始"}, {"type": "subtitle", "time": 4001.349, "timestamp": "01:06:41", "text": "就是那种课堂上才会出现的东西，对吧？"}, {"type": "subtitle", "time": 4005.19, "timestamp": "01:06:45", "text": "嗯，是的，暑期课程什么的。"}, {"type": "subtitle", "time": 4007.829, "timestamp": "01:06:47", "text": "这件事发生在五月份。"}, {"type": "subtitle", "time": 4009.75, "timestamp": "01:06:49", "text": "猜测"}, {"type": "subtitle", "time": 4012.069, "timestamp": "01:06:52", "text": "我认为。是的，"}, {"type": "subtitle", "time": 4014.069, "timestamp": "01:06:54", "text": "我想其他人也是这样。"}, {"type": "subtitle", "time": 4016.71, "timestamp": "01:06:56", "text": "如今。我不知道。我不知道是否"}, {"type": "subtitle", "time": 4018.63, "timestamp": "01:06:58", "text": "如果系统已经改变或"}]
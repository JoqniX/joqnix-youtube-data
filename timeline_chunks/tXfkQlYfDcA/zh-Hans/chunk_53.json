[{"type": "subtitle", "time": 3185.67, "timestamp": "00:53:05", "text": "是的，我们要加速跑完这段路。"}, {"type": "subtitle", "time": 3188.549, "timestamp": "00:53:08", "text": "如此之多，以至于我即将开始下一个"}, {"type": "subtitle", "time": 3191.75, "timestamp": "00:53:11", "text": "今天就有两个主题。我正在吃我的"}, {"type": "subtitle", "time": 3195.27, "timestamp": "00:53:15", "text": "早餐。是的，很好，很好，很好。好的。"}, {"type": "subtitle", "time": 3198.47, "timestamp": "00:53:18", "text": "我也是。"}, {"type": "subtitle", "time": 3201.03, "timestamp": "00:53:21", "text": "我还没吃早饭呢。等级"}, {"type": "subtitle", "time": 3204.309, "timestamp": "00:53:24", "text": "很可能很快就会发生。"}, {"type": "subtitle", "time": 3211.91, "timestamp": "00:53:31", "text": "你在吃印度薄饼和嵌花。哦，不错。"}, {"type": "subtitle", "time": 3213.91, "timestamp": "00:53:33", "text": "不错，不错。"}, {"type": "subtitle", "time": 3218.95, "timestamp": "00:53:38", "text": "如何把它们两个都吃掉？巴。哇。"}, {"type": "subtitle", "time": 3222.069, "timestamp": "00:53:42", "text": "你看着我。我就吃一张印度薄饼。"}, {"type": "subtitle", "time": 3227.91, "timestamp": "00:53:47", "text": "我吃得少了。"}, {"type": "subtitle", "time": 3236.28, "timestamp": "00:53:56", "text": "性存在"}]
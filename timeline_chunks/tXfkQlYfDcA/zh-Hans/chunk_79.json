[{"type": "subtitle", "time": 4743.11, "timestamp": "01:19:03", "text": "正确的？就这样。所以，无论你"}, {"type": "subtitle", "time": 4747.27, "timestamp": "01:19:07", "text": "没错，那道印记永远都会存在。"}, {"type": "subtitle", "time": 4749.51, "timestamp": "01:19:09", "text": "就是这样。所以，是的，如果你问我什么"}, {"type": "subtitle", "time": 4751.43, "timestamp": "01:19:11", "text": "你考虑过染发吗？"}, {"type": "subtitle", "time": 4754.149, "timestamp": "01:19:14", "text": "凉爽的。我也想这么做。我也想"}, {"type": "subtitle", "time": 4756.55, "timestamp": "01:19:16", "text": "去做这件事，但同时我也感觉自己失去了我的"}, {"type": "subtitle", "time": 4760.31, "timestamp": "01:19:20", "text": "也是天然发色，对吧？"}, {"type": "subtitle", "time": 4762.47, "timestamp": "01:19:22", "text": "就是这样。"}, {"type": "subtitle", "time": 4764.63, "timestamp": "01:19:24", "text": "不过染发确实很酷。不是"}, {"type": "subtitle", "time": 4766.95, "timestamp": "01:19:26", "text": "我要撒谎。呃，有很多"}, {"type": "subtitle", "time": 4769.43, "timestamp": "01:19:29", "text": "你可以接受的辐射治疗。"}, {"type": "subtitle", "time": 4783.189, "timestamp": "01:19:43", "text": "就像拉直头发一样。我有自己的"}, {"type": "subtitle", "time": 4785.59, "timestamp": "01:19:45", "text": "我拉直头发的体验。我"}, {"type": "subtitle", "time": 4788.63, "timestamp": "01:19:48", "text": "我的头发好像掉光了。"}, {"type": "subtitle", "time": 4790.63, "timestamp": "01:19:50", "text": "结构。"}, {"type": "subtitle", "time": 4792.95, "timestamp": "01:19:52", "text": "是的，我的头发是直发。"}, {"type": "subtitle", "time": 4797.91, "timestamp": "01:19:57", "text": "因为我一直用直板夹，所以头发都乱了。我"}]
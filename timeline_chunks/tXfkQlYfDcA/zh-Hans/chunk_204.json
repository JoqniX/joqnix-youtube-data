[{"type": "subtitle", "time": 12240.71, "timestamp": "03:24:00", "text": "游戏和处于萎靡不振的状态"}, {"type": "subtitle", "time": 12245.269, "timestamp": "03:24:05", "text": "我得到的“凋零的波浪”类别"}, {"type": "subtitle", "time": 12248.309, "timestamp": "03:24:08", "text": "是的，我的也被撤下来了。"}, {"type": "subtitle", "time": 12250.07, "timestamp": "03:24:10", "text": "朋友当时正在 YouTube 上直播，是的。"}, {"type": "subtitle", "time": 12251.83, "timestamp": "03:24:11", "text": "他们讨厌 YouTube、Twitch 和其他平台。"}, {"type": "subtitle", "time": 12253.67, "timestamp": "03:24:13", "text": "我无法显示的外国平台"}, {"type": "subtitle", "time": 12258.15, "timestamp": "03:24:18", "text": "标志或网站本身，甚至"}, {"type": "subtitle", "time": 12261.51, "timestamp": "03:24:21", "text": "在聊天中输入“YouTube”是被禁止的。"}, {"type": "subtitle", "time": 12263.269, "timestamp": "03:24:23", "text": "或者类似这样的评论"}, {"type": "subtitle", "time": 12269.11, "timestamp": "03:24:29", "text": "已被平台标记。太疯狂了。"}, {"type": "subtitle", "time": 12273.03, "timestamp": "03:24:33", "text": "真是太疯狂了。什么？我想念"}, {"type": "subtitle", "time": 12275.75, "timestamp": "03:24:35", "text": "即使到了今天，你仍然可以在那里观看直播。我的意思是，比如"}, {"type": "subtitle", "time": 12278.389, "timestamp": "03:24:38", "text": "我在那里开始积累了一小批粉丝。"}, {"type": "subtitle", "time": 12282.07, "timestamp": "03:24:42", "text": "因为那个平台更像是……观点"}, {"type": "subtitle", "time": 12285.349, "timestamp": "03:24:45", "text": "像你一样注重观点，我会告诉你"}, {"type": "subtitle", "time": 12288.389, "timestamp": "03:24:48", "text": "他们有一个等级系统。"}, {"type": "subtitle", "time": 12290.79, "timestamp": "03:24:50", "text": "东西。嗯哼。初始水平系统"}, {"type": "subtitle", "time": 12293.51, "timestamp": "03:24:53", "text": "就像订婚之类的事情。越多"}, {"type": "subtitle", "time": 12295.429, "timestamp": "03:24:55", "text": "你的内容互动情况"}, {"type": "subtitle", "time": 12298.07, "timestamp": "03:24:58", "text": "发布视频之类的东西，这样你就能……"}]
[{"type": "subtitle", "time": 10681.59, "timestamp": "02:58:01", "text": "可装配的。正因为如此，我当时就想，是啊。"}, {"type": "subtitle", "time": 10683.67, "timestamp": "02:58:03", "text": "我不应该做剪影之类的东西"}, {"type": "subtitle", "time": 10686.87, "timestamp": "02:58:06", "text": "然后戏弄它。我当时已经准备好去做了。"}, {"type": "subtitle", "time": 10689.91, "timestamp": "02:58:09", "text": "然后我又遇到了另一个问题。"}, {"type": "subtitle", "time": 10693.349, "timestamp": "02:58:13", "text": "所以，我就想，啊，我该怎么办？"}, {"type": "subtitle", "time": 10697.11, "timestamp": "02:58:17", "text": "即使现在，我仍然冒着这样的风险，因为"}, {"type": "subtitle", "time": 10701.19, "timestamp": "02:58:21", "text": "我正在延长 Joathon 的时间，我可以呃"}, {"type": "subtitle", "time": 10704.63, "timestamp": "02:58:24", "text": "拿到驾照，有效期一年。"}, {"type": "subtitle", "time": 10707.19, "timestamp": "02:58:27", "text": "然后就像……嗯，逗弄它，就像逗弄它"}, {"type": "subtitle", "time": 10711.67, "timestamp": "02:58:31", "text": "慢慢地炒作，但我必须这么做"}, {"type": "subtitle", "time": 10713.67, "timestamp": "02:58:33", "text": "等艺术方面的事情完全完成后再做这件事。"}, {"type": "subtitle", "time": 10715.67, "timestamp": "02:58:35", "text": "问题解决了，一切都很好。"}, {"type": "subtitle", "time": 10718.71, "timestamp": "02:58:38", "text": "只是现在所有索具工都必须这样做。"}, {"type": "subtitle", "time": 10722.55, "timestamp": "02:58:42", "text": "照那样做。嗯。现在我去了"}, {"type": "subtitle", "time": 10725.11, "timestamp": "02:58:45", "text": "因为这位艺术家是韩国人，所以我选择了"}, {"type": "subtitle", "time": 10727.03, "timestamp": "02:58:47", "text": "呃，是她推荐的，因为我没有。"}, {"type": "subtitle", "time": 10730.23, "timestamp": "02:58:50", "text": "希望沟通问题能够发生。"}, {"type": "subtitle", "time": 10734.309, "timestamp": "02:58:54", "text": "对对对，嗯，索具工是"}, {"type": "subtitle", "time": 10737.59, "timestamp": "02:58:57", "text": "准备在这里打破僵局时，他们就像……呃，我们"}]
[{"type": "subtitle", "time": 6181.03, "timestamp": "01:43:01", "text": "服务器，我收到了那条通知，内容是："}, {"type": "subtitle", "time": 6182.55, "timestamp": "01:43:02", "text": "呃"}, {"type": "subtitle", "time": 6185.669, "timestamp": "01:43:05", "text": "声音听起来不错，或者有什么办法让我……"}, {"type": "subtitle", "time": 6189.03, "timestamp": "01:43:09", "text": "打开维希和东西"}, {"type": "subtitle", "time": 6191.91, "timestamp": "01:43:11", "text": "我们查看并确认，没有声音。"}, {"type": "subtitle", "time": 6194.629, "timestamp": "01:43:14", "text": "好的，可以。"}, {"type": "subtitle", "time": 6196.629, "timestamp": "01:43:16", "text": "哦，是的。我需要一项权利。是的，我需要一个"}, {"type": "subtitle", "time": 6198.149, "timestamp": "01:43:18", "text": "正确的。"}, {"type": "subtitle", "time": 6200.629, "timestamp": "01:43:20", "text": "好的，我会给这些设备授予权限。"}, {"type": "subtitle", "time": 6206.31, "timestamp": "01:43:26", "text": "Zak 目前确实需要使用机载设备。"}, {"type": "subtitle", "time": 6209.189, "timestamp": "01:43:29", "text": "路径"}, {"type": "subtitle", "time": 6211.109, "timestamp": "01:43:31", "text": "应该可以做到。可能需要"}, {"type": "subtitle", "time": 6214.47, "timestamp": "01:43:34", "text": "执行类别泵并覆盖它。"}, {"type": "subtitle", "time": 6223.109, "timestamp": "01:43:43", "text": "我可以更改音量或选择退出吗？"}, {"type": "subtitle", "time": 6226.39, "timestamp": "01:43:46", "text": "音板？是的，您可以选择退出。"}, {"type": "subtitle", "time": 6228.95, "timestamp": "01:43:48", "text": "来自哦，那里。等等，那岂不是说还有……"}, {"type": "subtitle", "time": 6231.51, "timestamp": "01:43:51", "text": "语音和视频的新设置"}, {"type": "subtitle", "time": 6234.87, "timestamp": "01:43:54", "text": "音板。音量大小是可以控制的。"}, {"type": "subtitle", "time": 6236.55, "timestamp": "01:43:56", "text": "声音是为你个人准备的。点击"}, {"type": "subtitle", "time": 6239.03, "timestamp": "01:43:59", "text": "这里"}]
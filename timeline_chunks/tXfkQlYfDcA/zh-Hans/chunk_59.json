[{"type": "subtitle", "time": 3540.63, "timestamp": "00:59:00", "text": "那。是的，我们会拿到的。"}, {"type": "subtitle", "time": 3542.15, "timestamp": "00:59:02", "text": "几乎"}, {"type": "subtitle", "time": 3564.23, "timestamp": "00:59:24", "text": "和"}, {"type": "subtitle", "time": 3571.51, "timestamp": "00:59:31", "text": "哦，那真是个传奇。好的。"}, {"type": "subtitle", "time": 3582.23, "timestamp": "00:59:42", "text": "对，午饭前吧？我去拿"}, {"type": "subtitle", "time": 3585.589, "timestamp": "00:59:45", "text": "洗澡。我去小便，然后去洗澡。"}, {"type": "subtitle", "time": 3588.23, "timestamp": "00:59:48", "text": "然后回来。我猜"}, {"type": "subtitle", "time": 3590.39, "timestamp": "00:59:50", "text": "我即将死去"}, {"type": "subtitle", "time": 3592.95, "timestamp": "00:59:52", "text": "在这种炎热的天气里。"}, {"type": "subtitle", "time": 3595.75, "timestamp": "00:59:55", "text": "是的，我们把时钟调回去。"}, {"type": "subtitle", "time": 3598.87, "timestamp": "00:59:58", "text": "我们的冬天，然后我们又回来了。"}]
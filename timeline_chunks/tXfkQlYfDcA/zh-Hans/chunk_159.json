[{"type": "subtitle", "time": 9541.11, "timestamp": "02:39:01", "text": "就这么一点点。哦，"}, {"type": "subtitle", "time": 9543.51, "timestamp": "02:39:03", "text": "那很好。再说一遍，就像你只是"}, {"type": "subtitle", "time": 9546.55, "timestamp": "02:39:06", "text": "为所有人着想。那是"}, {"type": "subtitle", "time": 9549.83, "timestamp": "02:39:09", "text": "挺不错的。是啊，因为呃，我从来没有"}, {"type": "subtitle", "time": 9553.75, "timestamp": "02:39:13", "text": "我原本打算参加安息日活动或其他活动。"}, {"type": "subtitle", "time": 9555.91, "timestamp": "02:39:15", "text": "类似这样的。我一直都想这么做。"}, {"type": "subtitle", "time": 9558.23, "timestamp": "02:39:18", "text": "但我当时想，我还是做这个慈善活动吧。"}, {"type": "subtitle", "time": 9559.75, "timestamp": "02:39:19", "text": "主要，"}, {"type": "subtitle", "time": 9562.07, "timestamp": "02:39:22", "text": "你知道。正确的。正确的。那是为了"}, {"type": "subtitle", "time": 9565.75, "timestamp": "02:39:25", "text": "一个原因。不。我当时就想，不，人们"}, {"type": "subtitle", "time": 9567.91, "timestamp": "02:39:27", "text": "在我身上花钱，太多了。"}, {"type": "subtitle", "time": 9570.07, "timestamp": "02:39:30", "text": "那就像太自私一样，或者"}, {"type": "subtitle", "time": 9573.19, "timestamp": "02:39:33", "text": "某物。然后我就想，我想要"}, {"type": "subtitle", "time": 9575.51, "timestamp": "02:39:35", "text": "为争取我的权利，我的道德"}, {"type": "subtitle", "time": 9577.27, "timestamp": "02:39:37", "text": "权利等等。我想"}, {"type": "subtitle", "time": 9579.67, "timestamp": "02:39:39", "text": "你知道，嗯，呃，该怎么称呼它呢？"}, {"type": "subtitle", "time": 9582.309, "timestamp": "02:39:42", "text": "它？坚持到底，我一定要得到它。"}, {"type": "subtitle", "time": 9585.59, "timestamp": "02:39:45", "text": "这是我的设计。我投入了很多精力。"}, {"type": "subtitle", "time": 9588.63, "timestamp": "02:39:48", "text": "所以我就想，是啊，我要这么做。"}, {"type": "subtitle", "time": 9591.75, "timestamp": "02:39:51", "text": "它。我要把我的……放在一边"}, {"type": "subtitle", "time": 9594.389, "timestamp": "02:39:54", "text": "最初的想法。我们仍然可以这样做。"}, {"type": "subtitle", "time": 9596.71, "timestamp": "02:39:56", "text": "正确的？出道之后，我可以"}, {"type": "subtitle", "time": 9599.429, "timestamp": "02:39:59", "text": "未来还会继续参加Joathon活动，"}]
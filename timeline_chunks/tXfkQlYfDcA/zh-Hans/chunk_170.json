[{"type": "subtitle", "time": 10208.79, "timestamp": "02:50:08", "text": "加载中。"}, {"type": "subtitle", "time": 10210.79, "timestamp": "02:50:10", "text": "就像我在做鼓架一样"}, {"type": "subtitle", "time": 10213.99, "timestamp": "02:50:13", "text": "我自己也想说"}, {"type": "subtitle", "time": 10215.83, "timestamp": "02:50:15", "text": "什么"}, {"type": "subtitle", "time": 10219.91, "timestamp": "02:50:19", "text": "我的天啊。那挺好的。"}, {"type": "subtitle", "time": 10222.309, "timestamp": "02:50:22", "text": "停止。"}, {"type": "subtitle", "time": 10227.349, "timestamp": "02:50:27", "text": "努力去做。努力去做。努力去做。是的。做"}, {"type": "subtitle", "time": 10230.63, "timestamp": "02:50:30", "text": "太漂亮了。我的天啊。我没有"}, {"type": "subtitle", "time": 10234.309, "timestamp": "02:50:34", "text": "想想可能还有更多像你这样的人"}, {"type": "subtitle", "time": 10237.67, "timestamp": "02:50:37", "text": "有点像模特，但是哦，我看得出来我"}, {"type": "subtitle", "time": 10239.83, "timestamp": "02:50:39", "text": "我明白你为什么这么努力了。那是"}, {"type": "subtitle", "time": 10243.51, "timestamp": "02:50:43", "text": "就像你的精力，你的雪橇一样，"}, {"type": "subtitle", "time": 10246.71, "timestamp": "02:50:46", "text": "你太棒了。"}, {"type": "subtitle", "time": 10249.429, "timestamp": "02:50:49", "text": "真漂亮。"}, {"type": "subtitle", "time": 10252.63, "timestamp": "02:50:52", "text": "我的天哪。嗯，对于任何可能的人来说"}, {"type": "subtitle", "time": 10254.95, "timestamp": "02:50:54", "text": "就像戴着小护目镜一样看着我们"}, {"type": "subtitle", "time": 10258.79, "timestamp": "02:50:58", "text": "屏幕，就像你们看到这个的时候一样，"}]
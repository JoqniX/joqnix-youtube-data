[{"type": "subtitle", "time": 7268.95, "timestamp": "02:01:08", "text": "好的。好的。所以，我没法完成这四项。"}, {"type": "subtitle", "time": 7273.51, "timestamp": "02:01:13", "text": "问题已解决。差不多完成了。"}, {"type": "subtitle", "time": 7277.669, "timestamp": "02:01:17", "text": "你可以休息一下，玩玩游戏。"}, {"type": "subtitle", "time": 7279.589, "timestamp": "02:01:19", "text": "我不想玩游戏。我想要"}, {"type": "subtitle", "time": 7283.589, "timestamp": "02:01:23", "text": "工作。这就是我想要的。"}, {"type": "subtitle", "time": 7286.229, "timestamp": "02:01:26", "text": "但可惜的是，我还有 ZDS 要完成。"}, {"type": "subtitle", "time": 7288.76, "timestamp": "02:01:28", "text": "游戏。所以我别无选择。"}, {"type": "subtitle", "time": 7296.95, "timestamp": "02:01:36", "text": "[音乐]"}, {"type": "subtitle", "time": 7299.03, "timestamp": "02:01:39", "text": "有时我觉得我好像提过这件事。"}, {"type": "subtitle", "time": 7302.55, "timestamp": "02:01:42", "text": "我的直播里经常出现这种情况，对吧？有时我"}, {"type": "subtitle", "time": 7304.31, "timestamp": "02:01:44", "text": "想玩游戏，也想浪费时间"}, {"type": "subtitle", "time": 7311.91, "timestamp": "02:01:51", "text": "等等，我可以躺下写作吗？"}, {"type": "subtitle", "time": 7314.39, "timestamp": "02:01:54", "text": "那样做会有帮助吗？还是我不应该那样做？"}, {"type": "subtitle", "time": 7316.95, "timestamp": "02:01:56", "text": "它？"}]
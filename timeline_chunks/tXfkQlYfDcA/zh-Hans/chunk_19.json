[{"type": "subtitle", "time": 1144.63, "timestamp": "00:19:04", "text": "除了“好的，我保留了”之外，其余部分都换行。"}, {"type": "subtitle", "time": 1147.99, "timestamp": "00:19:07", "text": "它。我忘了我通常的设置是什么"}, {"type": "subtitle", "time": 1150.47, "timestamp": "00:19:10", "text": "GPU 2060"}, {"type": "subtitle", "time": 1153.98, "timestamp": "00:19:13", "text": "正常的 2016 年，不是 TI。"}, {"type": "subtitle", "time": 1155.83, "timestamp": "00:19:15", "text": "[音乐]"}, {"type": "subtitle", "time": 1158.63, "timestamp": "00:19:18", "text": "呃，固定锁式虚线"}, {"type": "subtitle", "time": 1161.27, "timestamp": "00:19:21", "text": "沟通持续进行。好的，这个"}, {"type": "subtitle", "time": 1170.549, "timestamp": "00:19:30", "text": "希望我不需要“不”，是2060年，而不是30年。"}, {"type": "subtitle", "time": 1174.39, "timestamp": "00:19:34", "text": "它有5年历史了"}, {"type": "subtitle", "time": 1178.23, "timestamp": "00:19:38", "text": "副总裁。我猜是生物学吧。我忘了是什么时候了"}, {"type": "subtitle", "time": 1187.029, "timestamp": "00:19:47", "text": "不，我记得。我记得我买的时候"}, {"type": "subtitle", "time": 1189.51, "timestamp": "00:19:49", "text": "它。就像"}, {"type": "subtitle", "time": 1191.669, "timestamp": "00:19:51", "text": "2020"}, {"type": "subtitle", "time": 1196.71, "timestamp": "00:19:56", "text": "我想大概是五月吧。可能不会呃"}]
[{"type": "subtitle", "time": 840.31, "timestamp": "00:14:00", "text": "再加点内存。我已经有16GB内存了"}, {"type": "subtitle", "time": 843.269, "timestamp": "00:14:03", "text": "还。早上好，Alexan。"}, {"type": "subtitle", "time": 845.67, "timestamp": "00:14:05", "text": "早上好。早上好。"}, {"type": "subtitle", "time": 848.31, "timestamp": "00:14:08", "text": "希望你一切都好。"}, {"type": "subtitle", "time": 859.99, "timestamp": "00:14:19", "text": "但我很高兴我能立即……"}, {"type": "subtitle", "time": 861.829, "timestamp": "00:14:21", "text": "原本应该在4点或"}, {"type": "subtitle", "time": 864.629, "timestamp": "00:14:24", "text": "某物，就像放进去一样。"}, {"type": "subtitle", "time": 866.47, "timestamp": "00:14:26", "text": "昨天发布的文字可供下载"}, {"type": "subtitle", "time": 869.59, "timestamp": "00:14:29", "text": "就像睡着了一样，但我忘了我睡着了。"}, {"type": "subtitle", "time": 873.75, "timestamp": "00:14:33", "text": "滚开，伙计。我的错。"}, {"type": "subtitle", "time": 875.829, "timestamp": "00:14:35", "text": "我真的有必要这样做吗？"}, {"type": "subtitle", "time": 877.91, "timestamp": "00:14:37", "text": "下载最新版本？不，正是如此。"}, {"type": "subtitle", "time": 879.94, "timestamp": "00:14:39", "text": "不是。但"}, {"type": "subtitle", "time": 881.829, "timestamp": "00:14:41", "text": "[音乐]"}, {"type": "subtitle", "time": 884.31, "timestamp": "00:14:44", "text": "等等，3.6.11，"}, {"type": "subtitle", "time": 887.829, "timestamp": "00:14:47", "text": "正确的？我上个月没下载吗？"}, {"type": "subtitle", "time": 891.509, "timestamp": "00:14:51", "text": "我没有。这篇文章发表于1月38日。"}, {"type": "subtitle", "time": 895.03, "timestamp": "00:14:55", "text": "啊，我没有。这就是原因。"}, {"type": "subtitle", "time": 896.31, "timestamp": "00:14:56", "text": "[音乐]"}]
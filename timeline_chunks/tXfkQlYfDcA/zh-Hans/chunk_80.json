[{"type": "subtitle", "time": 4801.43, "timestamp": "01:20:01", "text": "我一直用熨斗熨我的头发，没有任何"}, {"type": "subtitle", "time": 4803.669, "timestamp": "01:20:03", "text": "补充剂的意思就像没有任何补充剂一样"}, {"type": "subtitle", "time": 4807.35, "timestamp": "01:20:07", "text": "比如直发保护"}, {"type": "subtitle", "time": 4810.229, "timestamp": "01:20:10", "text": "乳霜或其他任何东西。我一直在熨衣服"}, {"type": "subtitle", "time": 4813.75, "timestamp": "01:20:13", "text": "就这么直接。我就是喜欢我"}, {"type": "subtitle", "time": 4816.149, "timestamp": "01:20:16", "text": "他这样做持续了大约一年，"}, {"type": "subtitle", "time": 4819.51, "timestamp": "01:20:19", "text": "现在我的头发结构完全消失了。就像这样"}, {"type": "subtitle", "time": 4824.149, "timestamp": "01:20:24", "text": "所以，呃，这太痛苦了，而且很脏。"}, {"type": "subtitle", "time": 4826.63, "timestamp": "01:20:26", "text": "我必须经历很多……"}, {"type": "subtitle", "time": 4829.189, "timestamp": "01:20:29", "text": "使用护发产品让头发恢复原状"}, {"type": "subtitle", "time": 4847.43, "timestamp": "01:20:47", "text": "是的。即使现在我的结构仍然"}, {"type": "subtitle", "time": 4851.27, "timestamp": "01:20:51", "text": "这是破损的网格。不得不做很多事。"}, {"type": "subtitle", "time": 4854.95, "timestamp": "01:20:54", "text": "总有一天会发现人性的阴暗面。"}, {"type": "subtitle", "time": 4858.07, "timestamp": "01:20:58", "text": "是的。你知道，有人不喜欢这样。我"}]
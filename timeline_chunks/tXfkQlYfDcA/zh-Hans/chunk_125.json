[{"type": "subtitle", "time": 7500.39, "timestamp": "02:05:00", "text": "那么我们就遇到了帧率问题。"}, {"type": "subtitle", "time": 7502.39, "timestamp": "02:05:02", "text": "我知道为什么我想打开这个"}, {"type": "subtitle", "time": 7511.589, "timestamp": "02:05:11", "text": "实际上并没有全屏显示。好了。"}, {"type": "subtitle", "time": 7515.27, "timestamp": "02:05:15", "text": "躺下时，在我右边。"}, {"type": "subtitle", "time": 7518.07, "timestamp": "02:05:18", "text": "我把相机弄丢了一点，所以我可以"}, {"type": "subtitle", "time": 7520.56, "timestamp": "02:05:20", "text": "仍然跟踪我。"}, {"type": "subtitle", "time": 7521.83, "timestamp": "02:05:21", "text": "[音乐]"}, {"type": "subtitle", "time": 7532.47, "timestamp": "02:05:32", "text": "甚至"}, {"type": "subtitle", "time": 7538.47, "timestamp": "02:05:38", "text": "[音乐]"}, {"type": "subtitle", "time": 7542.149, "timestamp": "02:05:42", "text": "好的，我能像这样写作，就像我"}, {"type": "subtitle", "time": 7543.589, "timestamp": "02:05:43", "text": "不知道你能不能听到我说话。我是"}, {"type": "subtitle", "time": 7545.43, "timestamp": "02:05:45", "text": "我说话的时候，可能是在回应。"}, {"type": "subtitle", "time": 7547.35, "timestamp": "02:05:47", "text": "麦克风"}, {"type": "subtitle", "time": 7550.95, "timestamp": "02:05:50", "text": "但我可以把它调整成这样"}, {"type": "subtitle", "time": 7552.79, "timestamp": "02:05:52", "text": "这意味着我将无法"}, {"type": "subtitle", "time": 7556.149, "timestamp": "02:05:56", "text": "虽然有点不知所措，但我想应该没关系。"}, {"type": "subtitle", "time": 7559.91, "timestamp": "02:05:59", "text": "我会偶尔瞥一眼峰顶。"}]
[{"type": "subtitle", "time": 3720.95, "timestamp": "01:02:00", "text": "不过，确实，一点也不麻烦。就像"}, {"type": "subtitle", "time": 3722.71, "timestamp": "01:02:02", "text": "就像你的父母之类的"}, {"type": "subtitle", "time": 3726.23, "timestamp": "01:02:06", "text": "在你的或者就像是呃所有的"}, {"type": "subtitle", "time": 3729.03, "timestamp": "01:02:09", "text": "时钟"}, {"type": "subtitle", "time": 3732.15, "timestamp": "01:02:12", "text": "呃，你房间里所有的钟，你只是"}, {"type": "subtitle", "time": 3735.03, "timestamp": "01:02:15", "text": "呃，放，就像放，呃，你只是呃，改变"}, {"type": "subtitle", "time": 3739.99, "timestamp": "01:02:19", "text": "最好提前一小时做好。"}, {"type": "subtitle", "time": 3743.27, "timestamp": "01:02:23", "text": "还有其他一些东西。甚至你的手机时钟，也是"}, {"type": "subtitle", "time": 3745.67, "timestamp": "01:02:25", "text": "就像你过着你理想中的生活一样"}, {"type": "subtitle", "time": 3748.95, "timestamp": "01:02:28", "text": "生活方式。比预定时间早一个小时。"}, {"type": "subtitle", "time": 3751.27, "timestamp": "01:02:31", "text": "就像这样，“哦，等等。我需要去……”"}, {"type": "subtitle", "time": 3753.67, "timestamp": "01:02:33", "text": "准备好。我早上五点就醒了。但是……"}, {"type": "subtitle", "time": 3756.069, "timestamp": "01:02:36", "text": "已经是这样了，但实际上，你醒了。"}, {"type": "subtitle", "time": 3758.309, "timestamp": "01:02:38", "text": "凌晨4点"}, {"type": "subtitle", "time": 3761.19, "timestamp": "01:02:41", "text": "就像那样。”所以，就像，但是你必须这样做"}, {"type": "subtitle", "time": 3763.829, "timestamp": "01:02:43", "text": "它适用于家中所有其他钟表。"}, {"type": "subtitle", "time": 3765.75, "timestamp": "01:02:45", "text": "哦，"}, {"type": "subtitle", "time": 3767.99, "timestamp": "01:02:47", "text": "那是痛苦。"}, {"type": "subtitle", "time": 3770.549, "timestamp": "01:02:50", "text": "这条线路总是更爱音乐"}, {"type": "subtitle", "time": 3774.309, "timestamp": "01:02:54", "text": "没有什么能阻止你享受音乐。"}]
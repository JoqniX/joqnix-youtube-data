[{"type": "subtitle", "time": 14101.91, "timestamp": "03:55:01", "text": "这样就向 OBS 发送一个信号源。那是"}, {"type": "subtitle", "time": 14105.99, "timestamp": "03:55:05", "text": "简单的。真的太酷了。我当时就想："}, {"type": "subtitle", "time": 14108.469, "timestamp": "03:55:08", "text": "现在我知道它需要什么，我需要什么了。"}, {"type": "subtitle", "time": 14112.469, "timestamp": "03:55:12", "text": "做一场现场演唱会式的单人表演"}, {"type": "subtitle", "time": 14115.349, "timestamp": "03:55:15", "text": "比如这些虚拟主播演唱会之类的。"}, {"type": "subtitle", "time": 14117.59, "timestamp": "03:55:17", "text": "需要很多人喜欢灯光"}, {"type": "subtitle", "time": 14122.309, "timestamp": "03:55:22", "text": "等等等等。但是看《寿司龙》的时候，"}, {"type": "subtitle", "time": 14123.75, "timestamp": "03:55:23", "text": "看《寿司龙》的时候，我就想，"}, {"type": "subtitle", "time": 14125.99, "timestamp": "03:55:25", "text": "“是的，我可以弄个手持控制器。”"}, {"type": "subtitle", "time": 14127.99, "timestamp": "03:55:27", "text": "以及像按下按钮、宏和"}, {"type": "subtitle", "time": 14132.07, "timestamp": "03:55:32", "text": "东西，控制它，唱歌、移动、跳舞，"}, {"type": "subtitle", "time": 14135.75, "timestamp": "03:55:35", "text": "一切。那太酷了。”现在，所以"}, {"type": "subtitle", "time": 14137.429, "timestamp": "03:55:37", "text": "我应该那样做。比如，你当时在吗？"}, {"type": "subtitle", "time": 14140.79, "timestamp": "03:55:40", "text": "我在想，嗯……它叫什么来着？"}, {"type": "subtitle", "time": 14143.99, "timestamp": "03:55:43", "text": "就像3D动作捕捉那种情况一样"}, {"type": "subtitle", "time": 14145.189, "timestamp": "03:55:45", "text": "然后你就会像……"}, {"type": "subtitle", "time": 14146.87, "timestamp": "03:55:46", "text": "摄像机和灯光由谁控制？"}, {"type": "subtitle", "time": 14148.55, "timestamp": "03:55:48", "text": "想尝试点不一样的？"}, {"type": "subtitle", "time": 14152.15, "timestamp": "03:55:52", "text": "我考虑过这样做，嗯，我考虑过……"}, {"type": "subtitle", "time": 14156.229, "timestamp": "03:55:56", "text": "用普通的网络摄像头设备操作"}, {"type": "subtitle", "time": 14158.07, "timestamp": "03:55:58", "text": "但将来我希望成为像……"}]
[{"type": "subtitle", "time": 9126.79, "timestamp": "02:32:06", "text": "是的"}, {"type": "subtitle", "time": 9130.469, "timestamp": "02:32:10", "text": "他们知道我可以在那里直播。"}, {"type": "subtitle", "time": 9135.349, "timestamp": "02:32:15", "text": "那是尼斯。哇哦。就像你一样"}, {"type": "subtitle", "time": 9137.83, "timestamp": "02:32:17", "text": "我得注册更多账号。"}, {"type": "subtitle", "time": 9139.67, "timestamp": "02:32:19", "text": "就像你的每个家庭成员一样"}, {"type": "subtitle", "time": 9142.07, "timestamp": "02:32:22", "text": "得去办另一张卡才行。"}, {"type": "subtitle", "time": 9145.349, "timestamp": "02:32:25", "text": "你使用它。是的。就好像你有"}, {"type": "subtitle", "time": 9147.91, "timestamp": "02:32:27", "text": "拿着另一张牌自拍"}, {"type": "subtitle", "time": 9151.91, "timestamp": "02:32:31", "text": "和朋友一起回来。哦，什么？他们是"}, {"type": "subtitle", "time": 9155.11, "timestamp": "02:32:35", "text": "对这些人要求严格。"}, {"type": "subtitle", "time": 9157.51, "timestamp": "02:32:37", "text": "该死。是啊。他们就像他们"}, {"type": "subtitle", "time": 9166.23, "timestamp": "02:32:46", "text": "我的天啊。"}, {"type": "subtitle", "time": 9168.309, "timestamp": "02:32:48", "text": "你为了努力奋斗而做的事情，"}, {"type": "subtitle", "time": 9170.95, "timestamp": "02:32:50", "text": "内容创作者的艰辛之路。"}, {"type": "subtitle", "time": 9173.11, "timestamp": "02:32:53", "text": "是的。"}, {"type": "subtitle", "time": 9175.59, "timestamp": "02:32:55", "text": "现在每个人都在进行多目标学习。前往"}, {"type": "subtitle", "time": 9178.79, "timestamp": "02:32:58", "text": "踢和其他平台。嗯哼。正确的。"}]
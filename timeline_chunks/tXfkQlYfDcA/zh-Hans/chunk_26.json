[{"type": "subtitle", "time": 1560.07, "timestamp": "00:26:00", "text": "从昨天开始，有一个"}, {"type": "subtitle", "time": 1561.59, "timestamp": "00:26:01", "text": "给我留一点空间"}, {"type": "subtitle", "time": 1563.83, "timestamp": "00:26:03", "text": "请完成此页。那么我们就从……开始吧"}, {"type": "subtitle", "time": 1565.99, "timestamp": "00:26:05", "text": "主题二。"}, {"type": "subtitle", "time": 1568.63, "timestamp": "00:26:08", "text": "我们来完成第四个问题。"}, {"type": "subtitle", "time": 1571.75, "timestamp": "00:26:11", "text": "然后我们再切换回主题一。"}, {"type": "subtitle", "time": 1573.669, "timestamp": "00:26:13", "text": "第四个问题。就这样，我们"}, {"type": "subtitle", "time": 1577.59, "timestamp": "00:26:17", "text": "今天已经完成了七道题。那"}, {"type": "subtitle", "time": 1580.07, "timestamp": "00:26:20", "text": "也就是说，呃，又是12个小时。"}, {"type": "subtitle", "time": 1582.39, "timestamp": "00:26:22", "text": "溪流。乔，请帮帮我。发生了什么"}, {"type": "subtitle", "time": 1586.549, "timestamp": "00:26:26", "text": "发生了什么？"}, {"type": "subtitle", "time": 1589.35, "timestamp": "00:26:29", "text": "如何开始一场谈话？如何开始一场谈话"}, {"type": "subtitle", "time": 1591.35, "timestamp": "00:26:31", "text": "如何交朋友？你觉得我"}, {"type": "subtitle", "time": 1594.549, "timestamp": "00:26:34", "text": "知道吗？"}, {"type": "subtitle", "time": 1603.83, "timestamp": "00:26:43", "text": "我的意思是，这好像会很难。"}, {"type": "subtitle", "time": 1607.75, "timestamp": "00:26:47", "text": "这会很难，但即便如此，"}, {"type": "subtitle", "time": 1610.549, "timestamp": "00:26:50", "text": "一开始会很难，但是"}, {"type": "subtitle", "time": 1612.23, "timestamp": "00:26:52", "text": "就好像你需要找到什么东西一样。"}, {"type": "subtitle", "time": 1615.19, "timestamp": "00:26:55", "text": "经常被提及的话题。德克萨斯州有地方吗？"}, {"type": "subtitle", "time": 1619.19, "timestamp": "00:26:59", "text": "聊天和 Twitch 是否支持语音功能？嗯，"}]
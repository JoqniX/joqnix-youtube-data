[{"type": "subtitle", "time": 421.909, "timestamp": "00:07:01", "text": "读完“等等，我忘了，我忘了……”"}, {"type": "subtitle", "time": 424.87, "timestamp": "00:07:04", "text": "我忘记了边界边界"}, {"type": "subtitle", "time": 428.23, "timestamp": "00:07:08", "text": "啊，边界"}, {"type": "subtitle", "time": 431.67, "timestamp": "00:07:11", "text": "总是忘记边界之类的东西"}, {"type": "subtitle", "time": 434.309, "timestamp": "00:07:14", "text": "生活是怎样的？"}, {"type": "subtitle", "time": 436.79, "timestamp": "00:07:16", "text": "我一直努力忘记忘记……"}, {"type": "subtitle", "time": 439.71, "timestamp": "00:07:19", "text": "边界。"}, {"type": "subtitle", "time": 442.71, "timestamp": "00:07:22", "text": "[音乐]"}, {"type": "subtitle", "time": 447.029, "timestamp": "00:07:27", "text": "是的。例如，你会看到呃，当它"}, {"type": "subtitle", "time": 449.029, "timestamp": "00:07:29", "text": "遇到这类事情，我需要……"}, {"type": "subtitle", "time": 451.749, "timestamp": "00:07:31", "text": "调整我的"}, {"type": "subtitle", "time": 454.30899999999997, "timestamp": "00:07:34", "text": "这东西"}, {"type": "subtitle", "time": 457.43, "timestamp": "00:07:37", "text": "因为边界问题。"}, {"type": "subtitle", "time": 459.749, "timestamp": "00:07:39", "text": "是的。我还在这里。我需要把艺术品放好。"}, {"type": "subtitle", "time": 462.71, "timestamp": "00:07:42", "text": "里面的东西。"}, {"type": "subtitle", "time": 465.51, "timestamp": "00:07:45", "text": "是的。是的，我犯了个错误。我很高兴"}, {"type": "subtitle", "time": 468.39, "timestamp": "00:07:48", "text": "我注意到了。"}, {"type": "subtitle", "time": 470.87, "timestamp": "00:07:50", "text": "很高兴我注意到了这一点。所以，我需要"}, {"type": "subtitle", "time": 473.189, "timestamp": "00:07:53", "text": "搬出去"}, {"type": "subtitle", "time": 476.95, "timestamp": "00:07:56", "text": "这个。这个人。"}, {"type": "subtitle", "time": 479.11, "timestamp": "00:07:59", "text": "是的。你好，阿里。早上好。怎样"}]
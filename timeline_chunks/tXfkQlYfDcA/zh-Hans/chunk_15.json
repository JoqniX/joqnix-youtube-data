[{"type": "subtitle", "time": 903.67, "timestamp": "00:15:03", "text": "但它快要完成了，对吧？几乎"}, {"type": "subtitle", "time": 905.67, "timestamp": "00:15:05", "text": "完毕。正在添加。停下"}, {"type": "subtitle", "time": 907.59, "timestamp": "00:15:07", "text": "正在添加。"}, {"type": "subtitle", "time": 909.43, "timestamp": "00:15:09", "text": "你为什么眨眼？你做完了吗？"}, {"type": "subtitle", "time": 911.03, "timestamp": "00:15:11", "text": "正在上传？好了，我想已经完成了。"}, {"type": "subtitle", "time": 914.79, "timestamp": "00:15:14", "text": "正在上传。我只需要点击一下……"}, {"type": "subtitle", "time": 917.269, "timestamp": "00:15:17", "text": "确认。在此之前，我想完成"}, {"type": "subtitle", "time": 919.59, "timestamp": "00:15:19", "text": "制作字幕。"}, {"type": "subtitle", "time": 921.43, "timestamp": "00:15:21", "text": "让我先把字幕弄完。等待，"}, {"type": "subtitle", "time": 923.91, "timestamp": "00:15:23", "text": "等等，等等，等等。我稍后会更新。"}, {"type": "subtitle", "time": 927.03, "timestamp": "00:15:27", "text": "我的天啊，"}, {"type": "subtitle", "time": 934.71, "timestamp": "00:15:34", "text": "好了，我这就关闭这个窗口。"}, {"type": "subtitle", "time": 937.75, "timestamp": "00:15:37", "text": "为什么会有两个？等待，"}, {"type": "subtitle", "time": 941.67, "timestamp": "00:15:41", "text": "为什么会有两个这样的条目？"}, {"type": "subtitle", "time": 951.99, "timestamp": "00:15:51", "text": "我正在挤出时间。我需要权利"}, {"type": "subtitle", "time": 954.629, "timestamp": "00:15:54", "text": "笨蛋笨蛋"}, {"type": "subtitle", "time": 956.71, "timestamp": "00:15:56", "text": "应该让我停下三二"}, {"type": "subtitle", "time": 959.11, "timestamp": "00:15:59", "text": "几分钟而已，但我们现在花了很长时间。"}]
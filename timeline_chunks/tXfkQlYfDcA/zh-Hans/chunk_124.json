[{"type": "subtitle", "time": 7441.75, "timestamp": "02:04:01", "text": "然后是椅子。好的，我会下去看看。"}, {"type": "subtitle", "time": 7448.95, "timestamp": "02:04:08", "text": "我的天啊，这很难吗？"}, {"type": "subtitle", "time": 7451.35, "timestamp": "02:04:11", "text": "哦，下去吧。我会是个小个子。一个"}, {"type": "subtitle", "time": 7453.99, "timestamp": "02:04:13", "text": "小男孩。是的，她下去了。你是"}, {"type": "subtitle", "time": 7455.669, "timestamp": "02:04:15", "text": "向下。"}, {"type": "subtitle", "time": 7458.31, "timestamp": "02:04:18", "text": "哦，现在可以躺下了。是的，因为"}, {"type": "subtitle", "time": 7462.07, "timestamp": "02:04:22", "text": "房间里有一把椅子。"}, {"type": "subtitle", "time": 7464.95, "timestamp": "02:04:24", "text": "现在它就像一把小男孩的椅子。哦"}, {"type": "subtitle", "time": 7467.109, "timestamp": "02:04:27", "text": "我的上帝。"}, {"type": "subtitle", "time": 7468.79, "timestamp": "02:04:28", "text": "你好。"}, {"type": "subtitle", "time": 7472.39, "timestamp": "02:04:32", "text": "我没问题。"}, {"type": "subtitle", "time": 7474.79, "timestamp": "02:04:34", "text": "我可以再次申请吗？如果我不是"}, {"type": "subtitle", "time": 7484.0, "timestamp": "02:04:44", "text": "因为我会一直盯着那盏灯看。"}, {"type": "subtitle", "time": 7489.82, "timestamp": "02:04:49", "text": "FDI犬只挣扎。"}, {"type": "subtitle", "time": 7497.109, "timestamp": "02:04:57", "text": "[音乐]"}]
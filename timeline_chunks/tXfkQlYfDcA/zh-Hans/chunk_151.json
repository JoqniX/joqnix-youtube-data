[{"type": "subtitle", "time": 9060.07, "timestamp": "02:31:00", "text": "通常情况下，当你不喜欢“是”的时候就是这种情况。"}, {"type": "subtitle", "time": 9061.51, "timestamp": "02:31:01", "text": "就像另一张卡片不一样"}, {"type": "subtitle", "time": 9064.15, "timestamp": "02:31:04", "text": "适用的。我觉得你应该没问题。"}, {"type": "subtitle", "time": 9065.99, "timestamp": "02:31:05", "text": "但愿如此。"}, {"type": "subtitle", "time": 9068.71, "timestamp": "02:31:08", "text": "是的。我希望如此。"}, {"type": "subtitle", "time": 9072.07, "timestamp": "02:31:12", "text": "是的。哦，我有两个，我有两个"}, {"type": "subtitle", "time": 9074.15, "timestamp": "02:31:14", "text": "频道确实存在。所以你必须"}, {"type": "subtitle", "time": 9076.07, "timestamp": "02:31:16", "text": "创建一个新的电话号码"}, {"type": "subtitle", "time": 9080.309, "timestamp": "02:31:20", "text": "实际上是新频道。所以，嗯，我想……"}, {"type": "subtitle", "time": 9083.11, "timestamp": "02:31:23", "text": "正在观看的人，他们嗯嗯地"}, {"type": "subtitle", "time": 9085.349, "timestamp": "02:31:25", "text": "YouTube之类的。不，那是因为"}, {"type": "subtitle", "time": 9088.309, "timestamp": "02:31:28", "text": "小型频道没有办法"}, {"type": "subtitle", "time": 9091.75, "timestamp": "02:31:31", "text": "提供视频点播服务。所以当时"}, {"type": "subtitle", "time": 9093.67, "timestamp": "02:31:33", "text": "比如，我也会开一个点播频道做同样的事情。"}, {"type": "subtitle", "time": 9096.23, "timestamp": "02:31:36", "text": "我在 YouTube 上做的一件事"}, {"type": "subtitle", "time": 9098.79, "timestamp": "02:31:38", "text": "渠道。所以我把所有Twitch直播都上传了。"}, {"type": "subtitle", "time": 9102.309, "timestamp": "02:31:42", "text": "还有 YouTube 直播。"}, {"type": "subtitle", "time": 9108.55, "timestamp": "02:31:48", "text": "所以，是的，为了那个，我不得不……"}, {"type": "subtitle", "time": 9111.67, "timestamp": "02:31:51", "text": "是的，我的主要其他东西，还有我做的东西"}, {"type": "subtitle", "time": 9113.83, "timestamp": "02:31:53", "text": "为此，该频道"}, {"type": "subtitle", "time": 9116.55, "timestamp": "02:31:56", "text": "实际上是为了我的流媒体账户"}, {"type": "subtitle", "time": 9119.429, "timestamp": "02:31:59", "text": "主要的那个文档下一个嗯，我不得不使用我的"}]
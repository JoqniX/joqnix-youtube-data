[{"type": "subtitle", "time": 7141.35, "timestamp": "01:59:01", "text": "我无法休息，甚至无法停止我的"}, {"type": "subtitle", "time": 7144.07, "timestamp": "01:59:04", "text": "写着，但我的手还在，但我做不到"}, {"type": "subtitle", "time": 7146.87, "timestamp": "01:59:06", "text": "休息"}, {"type": "subtitle", "time": 7148.87, "timestamp": "01:59:08", "text": "也。"}, {"type": "subtitle", "time": 7151.51, "timestamp": "01:59:11", "text": "12小时。感觉就像我要坐着"}, {"type": "subtitle", "time": 7153.99, "timestamp": "01:59:13", "text": "在这里待了12个小时。一次就能完成的"}, {"type": "subtitle", "time": 7156.07, "timestamp": "01:59:16", "text": "东西。"}, {"type": "subtitle", "time": 7158.229, "timestamp": "01:59:18", "text": "但是，我会再次训练我的身体，努力做到……"}, {"type": "subtitle", "time": 7162.55, "timestamp": "01:59:22", "text": "承受住这一切。还有两天。"}, {"type": "subtitle", "time": 7165.189, "timestamp": "01:59:25", "text": "还要再熬两天。还有两天"}, {"type": "subtitle", "time": 7167.43, "timestamp": "01:59:27", "text": "2小时直播"}, {"type": "subtitle", "time": 7171.35, "timestamp": "01:59:31", "text": "没事的。我们完成了。我猜"}, {"type": "subtitle", "time": 7173.589, "timestamp": "01:59:33", "text": "我不用考虑我是否会得到"}, {"type": "subtitle", "time": 7176.629, "timestamp": "01:59:36", "text": "生病的。如果我思考我自己，如果如果我思考"}, {"type": "subtitle", "time": 7180.229, "timestamp": "01:59:40", "text": "关于生病之类的事情，实际上"}, {"type": "subtitle", "time": 7182.07, "timestamp": "01:59:42", "text": "生病了，但实际上停止呕吐了"}, {"type": "subtitle", "time": 7185.91, "timestamp": "01:59:45", "text": "周围等等。"}, {"type": "subtitle", "time": 7188.229, "timestamp": "01:59:48", "text": "是啊，我不应该去想生病的事。"}, {"type": "subtitle", "time": 7191.189, "timestamp": "01:59:51", "text": "吃东西或喝水的时候。"}, {"type": "subtitle", "time": 7194.229, "timestamp": "01:59:54", "text": "那会很痛苦。"}, {"type": "subtitle", "time": 7196.149, "timestamp": "01:59:56", "text": "再说一遍，如果你立了遗嘱的话……"}]
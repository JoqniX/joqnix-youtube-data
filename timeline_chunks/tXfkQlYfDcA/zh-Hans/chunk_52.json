[{"type": "subtitle", "time": 3122.63, "timestamp": "00:52:02", "text": "我觉得我可以。"}, {"type": "subtitle", "time": 3123.829, "timestamp": "00:52:03", "text": "你知道吗？我会把它写成新的"}, {"type": "subtitle", "time": 3128.14, "timestamp": "00:52:08", "text": "页。好的。今日第二页。"}, {"type": "subtitle", "time": 3147.27, "timestamp": "00:52:27", "text": "无页码。我很高兴我还有页面库存。"}, {"type": "subtitle", "time": 3148.95, "timestamp": "00:52:28", "text": "文件。"}, {"type": "subtitle", "time": 3151.829, "timestamp": "00:52:31", "text": "我的意思是，这件事仍然没有发生。"}, {"type": "subtitle", "time": 3156.39, "timestamp": "00:52:36", "text": "虽然还没完成，但我仍然很高兴。"}, {"type": "subtitle", "time": 3159.03, "timestamp": "00:52:39", "text": "我的天啊。我很高兴。"}, {"type": "subtitle", "time": 3162.87, "timestamp": "00:52:42", "text": "你好。四五六七"}, {"type": "subtitle", "time": 3165.43, "timestamp": "00:52:45", "text": "积分。然后我们进入第五部分。"}, {"type": "subtitle", "time": 3167.27, "timestamp": "00:52:47", "text": "问题。在我们进入第五部分之前"}, {"type": "subtitle", "time": 3169.51, "timestamp": "00:52:49", "text": "问题是，我们需要做第一门课。"}, {"type": "subtitle", "time": 3173.27, "timestamp": "00:52:53", "text": "第四个问题。反之亦然，在两个之前"}, {"type": "subtitle", "time": 3175.91, "timestamp": "00:52:55", "text": "超过一。我会把这整个……"}]
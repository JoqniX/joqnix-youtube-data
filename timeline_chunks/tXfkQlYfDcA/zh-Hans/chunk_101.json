[{"type": "subtitle", "time": 6064.149, "timestamp": "01:41:04", "text": "嗯？"}, {"type": "subtitle", "time": 6067.109, "timestamp": "01:41:07", "text": "哦，使用音效板。允许成员"}, {"type": "subtitle", "time": 6069.109, "timestamp": "01:41:09", "text": "从服务器音板发送歌曲"}, {"type": "subtitle", "time": 6072.629, "timestamp": "01:41:12", "text": "这个语音频道。了解更多。"}, {"type": "subtitle", "time": 6074.229, "timestamp": "01:41:14", "text": "音板 10 天前。这"}, {"type": "subtitle", "time": 6077.27, "timestamp": "01:41:17", "text": "实验性功能仅供试玩。"}, {"type": "subtitle", "time": 6079.43, "timestamp": "01:41:19", "text": "管理他们，数量仍然有限。"}, {"type": "subtitle", "time": 6082.229, "timestamp": "01:41:22", "text": "更多社区信息。你需要"}, {"type": "subtitle", "time": 6083.669, "timestamp": "01:41:23", "text": "能够听到播放的声音"}, {"type": "subtitle", "time": 6085.99, "timestamp": "01:41:25", "text": "音控台。好的。什么是"}, {"type": "subtitle", "time": 6087.27, "timestamp": "01:41:27", "text": "音控台？音板是一种声音"}, {"type": "subtitle", "time": 6088.709, "timestamp": "01:41:28", "text": "频道功能允许您播放"}, {"type": "subtitle", "time": 6090.709, "timestamp": "01:41:30", "text": "一段可以听到的短音频片段"}, {"type": "subtitle", "time": 6092.79, "timestamp": "01:41:32", "text": "所有参与者用同一种声音"}, {"type": "subtitle", "time": 6094.95, "timestamp": "01:41:34", "text": "渠道。"}, {"type": "subtitle", "time": 6097.59, "timestamp": "01:41:37", "text": "好的。好的。这很有意思。你可以"}, {"type": "subtitle", "time": 6101.27, "timestamp": "01:41:41", "text": "使用您自己的服务器，服务器所有者"}, {"type": "subtitle", "time": 6104.55, "timestamp": "01:41:44", "text": "服务器管理员可以上传"}, {"type": "subtitle", "time": 6107.91, "timestamp": "01:41:47", "text": "他们可以上传自己的声音。"}, {"type": "subtitle", "time": 6111.27, "timestamp": "01:41:51", "text": "待添加成员。好的。那是否意味着"}, {"type": "subtitle", "time": 6115.59, "timestamp": "01:41:55", "text": "我们能在Exia上买到吗？我们也收到了吗？"}, {"type": "subtitle", "time": 6119.51, "timestamp": "01:41:59", "text": "请告诉我把它录下来。"}]
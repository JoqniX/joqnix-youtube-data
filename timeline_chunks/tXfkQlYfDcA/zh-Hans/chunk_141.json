[{"type": "subtitle", "time": 8462.79, "timestamp": "02:21:02", "text": "合作。"}, {"type": "subtitle", "time": 8472.469, "timestamp": "02:21:12", "text": "但我……我应该以为你是"}, {"type": "subtitle", "time": 8474.63, "timestamp": "02:21:14", "text": "感觉像是在另一个时代，所以我没有"}, {"type": "subtitle", "time": 8477.59, "timestamp": "02:21:17", "text": "知道你当时在那个地方"}, {"type": "subtitle", "time": 8480.15, "timestamp": "02:21:20", "text": "前面已经提到过。是的。哦不，是"}, {"type": "subtitle", "time": 8481.67, "timestamp": "02:21:21", "text": "好的。就像是公开信息一样"}, {"type": "subtitle", "time": 8484.79, "timestamp": "02:21:24", "text": "是的，我目前居住在迪拜。是的"}, {"type": "subtitle", "time": 8486.63, "timestamp": "02:21:26", "text": "我住在迪拜，所以感觉不太一样。"}, {"type": "subtitle", "time": 8489.51, "timestamp": "02:21:29", "text": "离印度那么远，你知道的"}, {"type": "subtitle", "time": 8492.309, "timestamp": "02:21:32", "text": "时区。嗯，我非常喜欢"}, {"type": "subtitle", "time": 8495.349, "timestamp": "02:21:35", "text": "夜行者。我比较喜欢"}, {"type": "subtitle", "time": 8498.389, "timestamp": "02:21:38", "text": "像晚上那样运作，因为就像"}, {"type": "subtitle", "time": 8500.309, "timestamp": "02:21:40", "text": "我经常与很多人合作"}, {"type": "subtitle", "time": 8502.469, "timestamp": "02:21:42", "text": "我一起工作的人总是像往常一样"}, {"type": "subtitle", "time": 8504.95, "timestamp": "02:21:44", "text": "例如美国时区。所以我就想，好吧，这样"}, {"type": "subtitle", "time": 8508.55, "timestamp": "02:21:48", "text": "现在这是我的时区。"}, {"type": "subtitle", "time": 8510.23, "timestamp": "02:21:50", "text": "是的。所以，就像有好几天一样。"}, {"type": "subtitle", "time": 8511.59, "timestamp": "02:21:51", "text": "我只想去……"}, {"type": "subtitle", "time": 8513.75, "timestamp": "02:21:53", "text": "我大概早上六点睡觉，然后就像我"}, {"type": "subtitle", "time": 8515.11, "timestamp": "02:21:55", "text": "早上九点左右起床，然后，"}, {"type": "subtitle", "time": 8518.63, "timestamp": "02:21:58", "text": "“好了，又得开始我平常的一天了。”"}]
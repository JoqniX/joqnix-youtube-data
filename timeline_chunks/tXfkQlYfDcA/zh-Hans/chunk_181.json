[{"type": "subtitle", "time": 10863.11, "timestamp": "03:01:03", "text": "有趣的。我的生日是8月20日。"}, {"type": "subtitle", "time": 10866.469, "timestamp": "03:01:06", "text": "我们关系非常亲密。是的。"}, {"type": "subtitle", "time": 10870.469, "timestamp": "03:01:10", "text": "八月。我的天啊。我们走吧。"}, {"type": "subtitle", "time": 10872.63, "timestamp": "03:01:12", "text": "我不知道你有没有注意到。我不"}, {"type": "subtitle", "time": 10875.19, "timestamp": "03:01:15", "text": "你有没有注意到？呃，你看，狮子座"}, {"type": "subtitle", "time": 10878.23, "timestamp": "03:01:18", "text": "星座？ Leo 就是 Leo"}, {"type": "subtitle", "time": 10885.11, "timestamp": "03:01:25", "text": "努力去做。我的天哪，看看这"}, {"type": "subtitle", "time": 10887.83, "timestamp": "03:01:27", "text": "对疯狂的关注"}, {"type": "subtitle", "time": 10890.389, "timestamp": "03:01:30", "text": "注重细节。紧挨着"}, {"type": "subtitle", "time": 10894.309, "timestamp": "03:01:34", "text": "等级。什么？"}, {"type": "subtitle", "time": 10896.23, "timestamp": "03:01:36", "text": "哇。"}, {"type": "subtitle", "time": 10899.91, "timestamp": "03:01:39", "text": "惊人的。惊人的。"}, {"type": "subtitle", "time": 10903.75, "timestamp": "03:01:43", "text": "太多事情了。但就像很多事情一样。"}, {"type": "subtitle", "time": 10905.59, "timestamp": "03:01:45", "text": "就像你在同时处理很多事情一样"}, {"type": "subtitle", "time": 10909.269, "timestamp": "03:01:49", "text": "一次。具体该怎么做呢？比如怎么做"}, {"type": "subtitle", "time": 10912.389, "timestamp": "03:01:52", "text": "你有时间吗？"}, {"type": "subtitle", "time": 10915.59, "timestamp": "03:01:55", "text": "但你也注意到，如果我……"}, {"type": "subtitle", "time": 10919.59, "timestamp": "03:01:59", "text": "首次亮相，它会，它会，嗯，有很多。"}]
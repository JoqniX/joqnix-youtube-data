[{"type": "subtitle", "time": 9841.83, "timestamp": "02:44:01", "text": "东西。所以我想，如果真是那样的话……"}, {"type": "subtitle", "time": 9844.469, "timestamp": "02:44:04", "text": "我将专注于其他创意领域。"}, {"type": "subtitle", "time": 9847.99, "timestamp": "02:44:07", "text": "比如平面设计之类的。我做了我的"}, {"type": "subtitle", "time": 9850.87, "timestamp": "02:44:10", "text": "在学习 Illustrator 的同时，设计自己的 logo"}, {"type": "subtitle", "time": 9854.469, "timestamp": "02:44:14", "text": "一切。然后，因为我一直想要"}, {"type": "subtitle", "time": 9857.03, "timestamp": "02:44:17", "text": "就像制作商品一样，就像我"}, {"type": "subtitle", "time": 9859.03, "timestamp": "02:44:19", "text": "就像DJ制作人自己制作的那种锯子一样"}, {"type": "subtitle", "time": 9861.59, "timestamp": "02:44:21", "text": "他们有自己的周边产品和服装品牌。"}, {"type": "subtitle", "time": 9864.07, "timestamp": "02:44:24", "text": "所以我从……学习了服装设计"}, {"type": "subtitle", "time": 9866.389, "timestamp": "02:44:26", "text": "YouTube 并试图拆解我的所有东西"}, {"type": "subtitle", "time": 9868.79, "timestamp": "02:44:28", "text": "小件衣服，比如用来修补它们。"}, {"type": "subtitle", "time": 9873.91, "timestamp": "02:44:33", "text": "一起。好的。我的天啊。好的。"}, {"type": "subtitle", "time": 9877.91, "timestamp": "02:44:37", "text": "是的，我以前确实这样做过。然后我"}, {"type": "subtitle", "time": 9881.51, "timestamp": "02:44:41", "text": "当时我就想，好吧，那也不对，也不是"}, {"type": "subtitle", "time": 9885.11, "timestamp": "02:44:45", "text": "一切顺利。然后我就想，我来做吧"}, {"type": "subtitle", "time": 9887.83, "timestamp": "02:44:47", "text": "呃，视频剪辑之类的东西，或者"}, {"type": "subtitle", "time": 9890.309, "timestamp": "02:44:50", "text": "我学过Blender 3D软件，因为我"}, {"type": "subtitle", "time": 9892.79, "timestamp": "02:44:52", "text": "想做一个类似3D舞台的东西，"}, {"type": "subtitle", "time": 9895.19, "timestamp": "02:44:55", "text": "一切就绪，还要举办一场音乐会。我得到了"}]
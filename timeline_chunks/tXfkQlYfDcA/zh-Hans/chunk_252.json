[{"type": "subtitle", "time": 15121.189, "timestamp": "04:12:01", "text": "未来我们仍然可以继续合作。"}, {"type": "subtitle", "time": 15123.269, "timestamp": "04:12:03", "text": "好吧，玩你之前玩的那款游戏吧。"}, {"type": "subtitle", "time": 15124.95, "timestamp": "04:12:04", "text": "应该玩耍。是的。确切地。你"}, {"type": "subtitle", "time": 15126.71, "timestamp": "04:12:06", "text": "知道什么？是的。其实我很喜欢"}, {"type": "subtitle", "time": 15128.63, "timestamp": "04:12:08", "text": "游戏直播"}, {"type": "subtitle", "time": 15131.75, "timestamp": "04:12:11", "text": "我们原以为我们会这样做。哦"}, {"type": "subtitle", "time": 15133.67, "timestamp": "04:12:13", "text": "哇。但你知道吗？请考虑这一点"}, {"type": "subtitle", "time": 15136.71, "timestamp": "04:12:16", "text": "就像……就像热身一样。就像"}, {"type": "subtitle", "time": 15139.03, "timestamp": "04:12:19", "text": "破冰环节。 Icebreer 会话。"}, {"type": "subtitle", "time": 15143.59, "timestamp": "04:12:23", "text": "是的。正确的。天哪，那真是太有趣了。那是"}, {"type": "subtitle", "time": 15146.309, "timestamp": "04:12:26", "text": "真好玩。"}, {"type": "subtitle", "time": 15148.469, "timestamp": "04:12:28", "text": "祝你一切顺利。"}, {"type": "subtitle", "time": 15150.71, "timestamp": "04:12:30", "text": "再次感谢家人。很多"}, {"type": "subtitle", "time": 15153.91, "timestamp": "04:12:33", "text": "很有趣，我知道你注定会成就一番伟业。"}, {"type": "subtitle", "time": 15156.55, "timestamp": "04:12:36", "text": "事物。祝你一切顺利！"}, {"type": "subtitle", "time": 15159.51, "timestamp": "04:12:39", "text": "一切。谢谢。"}, {"type": "subtitle", "time": 15161.75, "timestamp": "04:12:41", "text": "您之前还有什么想说的吗？"}, {"type": "subtitle", "time": 15163.83, "timestamp": "04:12:43", "text": "你走了吗？任何消息或公告"}, {"type": "subtitle", "time": 15165.67, "timestamp": "04:12:45", "text": "或者其他什么？"}, {"type": "subtitle", "time": 15168.229, "timestamp": "04:12:48", "text": "嗯，我"}, {"type": "subtitle", "time": 15172.309, "timestamp": "04:12:52", "text": "没什么特别多的，但是，嗯……"}, {"type": "subtitle", "time": 15175.03, "timestamp": "04:12:55", "text": "你可以在我的所有社交媒体账号上找到我："}, {"type": "subtitle", "time": 15177.51, "timestamp": "04:12:57", "text": "目前类似 Twitch、Twitter、YouTube 等平台"}, {"type": "subtitle", "time": 15179.59, "timestamp": "04:12:59", "text": "还有 Instagram，它们都使用同一个名称。"}]
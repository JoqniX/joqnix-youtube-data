[{"type": "subtitle", "time": 14223.59, "timestamp": "03:57:03", "text": "阅读您的评论。你好。"}, {"type": "subtitle", "time": 14226.309, "timestamp": "03:57:06", "text": "是的。是的。我们被困住了。我们"}, {"type": "subtitle", "time": 14232.469, "timestamp": "03:57:12", "text": "我们被困住了。不过，我在看书。"}, {"type": "subtitle", "time": 14235.349, "timestamp": "03:57:15", "text": "评论。只是我不太会说话。"}, {"type": "subtitle", "time": 14237.67, "timestamp": "03:57:17", "text": "大声说出来，朗读出来"}, {"type": "subtitle", "time": 14239.91, "timestamp": "03:57:19", "text": "评论可能会打断讨论。"}, {"type": "subtitle", "time": 14243.429, "timestamp": "03:57:23", "text": "现在开始对话。所以，是的，但是不要"}, {"type": "subtitle", "time": 14249.429, "timestamp": "03:57:29", "text": "是啊，就像别让我……就像别让我……就像"}, {"type": "subtitle", "time": 14251.03, "timestamp": "03:57:31", "text": "阻碍你前进。如果你想的话"}, {"type": "subtitle", "time": 14254.15, "timestamp": "03:57:34", "text": "请回复他人。对不起。"}, {"type": "subtitle", "time": 14256.309, "timestamp": "03:57:36", "text": "你知道，你知道最好的方法是什么"}, {"type": "subtitle", "time": 14259.189, "timestamp": "03:57:39", "text": "找到解决办法了吗？就像……虽然"}, {"type": "subtitle", "time": 14261.189, "timestamp": "03:57:41", "text": "你正在进行合作，并且你想说话"}, {"type": "subtitle", "time": 14265.03, "timestamp": "03:57:45", "text": "大多数情况下，聊天记录都会出现在你的聊天记录中。"}, {"type": "subtitle", "time": 14266.71, "timestamp": "03:57:46", "text": "感到孤独，或者他们会觉得你不合群。"}, {"type": "subtitle", "time": 14270.07, "timestamp": "03:57:50", "text": "给我们一些关注之类的。所以，我"}, {"type": "subtitle", "time": 14271.99, "timestamp": "03:57:51", "text": "认为最好的办法是拥有"}, {"type": "subtitle", "time": 14275.269, "timestamp": "03:57:55", "text": "就像踩踏板一样，踩下去就能静音。"}, {"type": "subtitle", "time": 14278.87, "timestamp": "03:57:58", "text": "按键通话装置。哦，对对，就像"}]
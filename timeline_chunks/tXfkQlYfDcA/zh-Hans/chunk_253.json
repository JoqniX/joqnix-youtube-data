[{"type": "subtitle", "time": 15183.429, "timestamp": "04:13:03", "text": "达尔鲁普。实际上，我确实有一个"}, {"type": "subtitle", "time": 15186.309, "timestamp": "04:13:06", "text": "一个小好消息。嗯，我可能"}, {"type": "subtitle", "time": 15188.87, "timestamp": "04:13:08", "text": "成为这个令人兴奋的团队的一员"}, {"type": "subtitle", "time": 15192.309, "timestamp": "04:13:12", "text": "即将推出。那就像首次亮相"}, {"type": "subtitle", "time": 15194.87, "timestamp": "04:13:14", "text": "本月15日。第15街和"}, {"type": "subtitle", "time": 15197.83, "timestamp": "04:13:17", "text": "20日嗯，"}, {"type": "subtitle", "time": 15201.03, "timestamp": "04:13:21", "text": "薇薇娅。哦，我想我在……上看到过。"}, {"type": "subtitle", "time": 15203.429, "timestamp": "04:13:23", "text": "叽叽喳喳。我不知道。哦，这是秘密。"}, {"type": "subtitle", "time": 15205.51, "timestamp": "04:13:25", "text": "尽管。"}, {"type": "subtitle", "time": 15208.309, "timestamp": "04:13:28", "text": "嗯，它就像是维护得很差。"}, {"type": "subtitle", "time": 15211.429, "timestamp": "04:13:31", "text": "我参与其中这件事是个秘密，但是……"}, {"type": "subtitle", "time": 15214.63, "timestamp": "04:13:34", "text": "我们即将首次亮相。所以，我会"}, {"type": "subtitle", "time": 15216.87, "timestamp": "04:13:36", "text": "如果大家能够帮忙，我将不胜感激。"}, {"type": "subtitle", "time": 15220.309, "timestamp": "04:13:40", "text": "去看看，嗯，是的，去看看。"}, {"type": "subtitle", "time": 15223.99, "timestamp": "04:13:43", "text": "我的 Gen 聚会。嗯，我非常兴奋。"}, {"type": "subtitle", "time": 15226.87, "timestamp": "04:13:46", "text": "等等，你要去的是，这是一个，这是一个"}, {"type": "subtitle", "time": 15229.429, "timestamp": "04:13:49", "text": "下士。她是个独立自主的女孩。它是"}, {"type": "subtitle", "time": 15231.429, "timestamp": "04:13:51", "text": "不是。它不是。它非常独立。"}, {"type": "subtitle", "time": 15233.51, "timestamp": "04:13:53", "text": "是的。啊，明白了。"}, {"type": "subtitle", "time": 15235.59, "timestamp": "04:13:55", "text": "是的。是的。是的。是的。但是，嗯……"}, {"type": "subtitle", "time": 15237.51, "timestamp": "04:13:57", "text": "我们肯定比这多得多"}, {"type": "subtitle", "time": 15239.59, "timestamp": "04:13:59", "text": "像放松一样。嗯，有点像得到"}]
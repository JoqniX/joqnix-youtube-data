[{"type": "subtitle", "time": 9300.71, "timestamp": "02:35:00", "text": "问：“如何将您的 7TV 连接到"}, {"type": "subtitle", "time": 9303.27, "timestamp": "02:35:03", "text": "YouTube？”然后我就想，“哦，嗯，"}, {"type": "subtitle", "time": 9305.349, "timestamp": "02:35:05", "text": "我的已经连接上了。我会取消链接。"}, {"type": "subtitle", "time": 9307.51, "timestamp": "02:35:07", "text": "并向你展示如何连接。”而我"}, {"type": "subtitle", "time": 9311.67, "timestamp": "02:35:11", "text": "我难道没忘记7有一个"}, {"type": "subtitle", "time": 9314.07, "timestamp": "02:35:14", "text": "YouTube出了问题，他们解决了。"}, {"type": "subtitle", "time": 9315.91, "timestamp": "02:35:15", "text": "不可用"}, {"type": "subtitle", "time": 9318.23, "timestamp": "02:35:18", "text": "重新连接或连接您的"}, {"type": "subtitle", "time": 9329.51, "timestamp": "02:35:29", "text": "哦，什么？哦，天哪。"}, {"type": "subtitle", "time": 9332.309, "timestamp": "02:35:32", "text": "哦，真糟糕。就在那里。"}, {"type": "subtitle", "time": 9335.83, "timestamp": "02:35:35", "text": "是的，我不用看教程。"}, {"type": "subtitle", "time": 9338.95, "timestamp": "02:35:38", "text": "橘子树。我本来可以啊"}, {"type": "subtitle", "time": 9340.55, "timestamp": "02:35:40", "text": "你只是想帮忙而已。"}, {"type": "subtitle", "time": 9341.83, "timestamp": "02:35:41", "text": "你看，这就是我说的。"}, {"type": "subtitle", "time": 9343.91, "timestamp": "02:35:43", "text": "关于。你总是那么乐于喜欢"}, {"type": "subtitle", "time": 9345.75, "timestamp": "02:35:45", "text": "帮助了别人之后，你会想：“啊，"}, {"type": "subtitle", "time": 9348.55, "timestamp": "02:35:48", "text": "我这就取消链接。让我来帮忙"}, {"type": "subtitle", "time": 9351.99, "timestamp": "02:35:51", "text": "“他们。”哦，没事了。"}, {"type": "subtitle", "time": 9355.59, "timestamp": "02:35:55", "text": "哦，这太疯狂了"}, {"type": "subtitle", "time": 9358.07, "timestamp": "02:35:58", "text": "然后。就像……所以，我希望"}, {"type": "subtitle", "time": 9359.99, "timestamp": "02:35:59", "text": "就像通过这次 Joathon 活动，你能够……"}]
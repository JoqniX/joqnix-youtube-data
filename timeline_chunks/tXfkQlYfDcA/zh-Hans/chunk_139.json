[{"type": "subtitle", "time": 8341.429, "timestamp": "02:19:01", "text": "要做的事情，我总能努力奋斗。"}, {"type": "subtitle", "time": 8344.15, "timestamp": "02:19:04", "text": "兼职工作，在现实生活中工作，并喜欢攒钱，"}, {"type": "subtitle", "time": 8347.429, "timestamp": "02:19:07", "text": "正确的？所以，没问题。不必那么着急。所以，"}, {"type": "subtitle", "time": 8349.669, "timestamp": "02:19:09", "text": "我当时也想那样做。"}, {"type": "subtitle", "time": 8353.27, "timestamp": "02:19:13", "text": "现在我有了更多时间。所以，我当时就想，"}, {"type": "subtitle", "time": 8359.429, "timestamp": "02:19:19", "text": "“好吧，那就让我自己去破坏我的内衬吧。”是的。"}, {"type": "subtitle", "time": 8361.589, "timestamp": "02:19:21", "text": "我的天啊。"}, {"type": "subtitle", "time": 8364.309, "timestamp": "02:19:24", "text": "祝你一切顺利。我知道。我知道。你"}, {"type": "subtitle", "time": 8366.07, "timestamp": "02:19:26", "text": "你身上有这种潜质。你真是太坚强了。"}, {"type": "subtitle", "time": 8369.349, "timestamp": "02:19:29", "text": "你一直都很坚强。嗯，就像我"}, {"type": "subtitle", "time": 8370.87, "timestamp": "02:19:30", "text": "是的，就像你说的，这不是重点。"}, {"type": "subtitle", "time": 8372.79, "timestamp": "02:19:32", "text": "就像最终目标一样。而且，它就像"}, {"type": "subtitle", "time": 8374.95, "timestamp": "02:19:34", "text": "像你以前那样和人说话，你不喜欢这样"}, {"type": "subtitle", "time": 8376.87, "timestamp": "02:19:36", "text": "好久没联系了。因为就像我"}, {"type": "subtitle", "time": 8378.87, "timestamp": "02:19:38", "text": "还记得我第一次来的时候吗？"}, {"type": "subtitle", "time": 8380.87, "timestamp": "02:19:40", "text": "在虚拟主播圈，你就像其中一员"}, {"type": "subtitle", "time": 8383.349, "timestamp": "02:19:43", "text": "第一批我喜欢与之交谈的人"}, {"type": "subtitle", "time": 8385.03, "timestamp": "02:19:45", "text": "就像你知道的，要理解"}, {"type": "subtitle", "time": 8388.63, "timestamp": "02:19:48", "text": "到底发生了什么？呃，什么？"}, {"type": "subtitle", "time": 8390.309, "timestamp": "02:19:50", "text": "真的吗？"}, {"type": "subtitle", "time": 8395.19, "timestamp": "02:19:55", "text": "是的。就像我觉得我们最初那样"}, {"type": "subtitle", "time": 8397.75, "timestamp": "02:19:57", "text": "当你……嗯，像那个团体一样……"}]
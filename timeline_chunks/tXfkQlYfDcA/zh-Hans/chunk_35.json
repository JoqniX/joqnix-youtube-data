[{"type": "subtitle", "time": 2100.069, "timestamp": "00:35:00", "text": "今天差了很多。"}, {"type": "subtitle", "time": 2102.069, "timestamp": "00:35:02", "text": "这是你的车。"}, {"type": "subtitle", "time": 2104.71, "timestamp": "00:35:04", "text": "后退。"}, {"type": "subtitle", "time": 2107.27, "timestamp": "00:35:07", "text": "对，是我。我回来了。"}, {"type": "subtitle", "time": 2118.23, "timestamp": "00:35:18", "text": "让我来做这件事。"}, {"type": "subtitle", "time": 2120.51, "timestamp": "00:35:20", "text": "我需要做几件事。"}, {"type": "subtitle", "time": 2124.63, "timestamp": "00:35:24", "text": "[音乐]"}, {"type": "subtitle", "time": 2127.19, "timestamp": "00:35:27", "text": "好的，我刚刚意识到 loi 和"}, {"type": "subtitle", "time": 2129.349, "timestamp": "00:35:29", "text": "背景音乐响起，"}, {"type": "subtitle", "time": 2132.15, "timestamp": "00:35:32", "text": "把所有东西混在一起。为什么没有"}, {"type": "subtitle", "time": 2139.589, "timestamp": "00:35:39", "text": "更多取消置顶消息。好的。"}, {"type": "subtitle", "time": 2142.87, "timestamp": "00:35:42", "text": "大家好，我们又回来了。这需要一点时间"}, {"type": "subtitle", "time": 2145.99, "timestamp": "00:35:45", "text": "虽然你可能会得到一切。"}, {"type": "subtitle", "time": 2148.31, "timestamp": "00:35:48", "text": "你们或许会再次受到欢迎，因为"}, {"type": "subtitle", "time": 2151.91, "timestamp": "00:35:51", "text": "我的所有东西都被重置了，重启后就没了。"}, {"type": "subtitle", "time": 2155.67, "timestamp": "00:35:55", "text": "重置一下。好的，我们继续吧。"}, {"type": "subtitle", "time": 2157.6, "timestamp": "00:35:57", "text": "写成文字。好的，"}, {"type": "subtitle", "time": 2159.109, "timestamp": "00:35:59", "text": "[音乐]"}]
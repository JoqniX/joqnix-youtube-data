[{"type": "subtitle", "time": 3482.63, "timestamp": "00:58:02", "text": "你是否取得了一些进展？"}, {"type": "subtitle", "time": 3484.39, "timestamp": "00:58:04", "text": "就那样吗？"}, {"type": "subtitle", "time": 3498.63, "timestamp": "00:58:18", "text": "重掌政权。等等，什么是等等？"}, {"type": "subtitle", "time": 3500.39, "timestamp": "00:58:20", "text": "这种情况确实会发生。等等，我不知道。"}, {"type": "subtitle", "time": 3503.91, "timestamp": "00:58:23", "text": "它会改变时区。等等，什么？"}, {"type": "subtitle", "time": 3507.19, "timestamp": "00:58:27", "text": "我快完成了。我们走吧。"}, {"type": "subtitle", "time": 3510.309, "timestamp": "00:58:30", "text": "我也需要在之后开始这样做，比如"}, {"type": "subtitle", "time": 3513.67, "timestamp": "00:58:33", "text": "呃，这个月发生的所有这些事。我先开始。"}, {"type": "subtitle", "time": 3517.19, "timestamp": "00:58:37", "text": "我想我应该正式开始了。"}, {"type": "subtitle", "time": 3520.63, "timestamp": "00:58:40", "text": "让自己真正变得高效起来"}, {"type": "subtitle", "time": 3523.25, "timestamp": "00:58:43", "text": "类似的东西"}, {"type": "subtitle", "time": 3525.109, "timestamp": "00:58:45", "text": "[音乐]"}, {"type": "subtitle", "time": 3530.23, "timestamp": "00:58:50", "text": "至少四月份的所有事情都是如此。"}, {"type": "subtitle", "time": 3531.91, "timestamp": "00:58:51", "text": "当然，我需要准备我的交换材料。"}, {"type": "subtitle", "time": 3535.589, "timestamp": "00:58:55", "text": "但我仍然会去做，而且这件事……"}]
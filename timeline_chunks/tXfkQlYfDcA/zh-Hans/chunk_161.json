[{"type": "subtitle", "time": 9661.19, "timestamp": "02:41:01", "text": "好久不见了。嗯。嗯。嗯，是的"}, {"type": "subtitle", "time": 9665.51, "timestamp": "02:41:05", "text": "肯定是在类似公司那段时间，而且我当时在家。"}, {"type": "subtitle", "time": 9669.11, "timestamp": "02:41:09", "text": "从大学之类的，因为，呃，当然"}, {"type": "subtitle", "time": 9672.309, "timestamp": "02:41:12", "text": "没有课程进行。嗯，但是"}, {"type": "subtitle", "time": 9674.71, "timestamp": "02:41:14", "text": "就像我们当时还在上网课一样"}, {"type": "subtitle", "time": 9677.03, "timestamp": "02:41:17", "text": "就像强迫自己那样"}, {"type": "subtitle", "time": 9680.15, "timestamp": "02:41:20", "text": "比如，我做工作的方式就是直播，因为"}, {"type": "subtitle", "time": 9682.389, "timestamp": "02:41:22", "text": "我当时就像，当我独自一人时……"}, {"type": "subtitle", "time": 9684.469, "timestamp": "02:41:24", "text": "感觉很难完成任何工作。"}, {"type": "subtitle", "time": 9686.23, "timestamp": "02:41:26", "text": "但如果我拥有像这样的人"}, {"type": "subtitle", "time": 9688.309, "timestamp": "02:41:28", "text": "闲逛或者就像这样"}, {"type": "subtitle", "time": 9690.309, "timestamp": "02:41:30", "text": "我督促自己完成我的"}, {"type": "subtitle", "time": 9692.55, "timestamp": "02:41:32", "text": "工作。我就是这样开始的"}, {"type": "subtitle", "time": 9694.389, "timestamp": "02:41:34", "text": "流媒体，"}, {"type": "subtitle", "time": 9697.51, "timestamp": "02:41:37", "text": "正确的？是不是就像，几乎就像哦"}, {"type": "subtitle", "time": 9699.59, "timestamp": "02:41:39", "text": "好吧，如果我做不完这件事，它就完了。"}, {"type": "subtitle", "time": 9703.03, "timestamp": "02:41:43", "text": "可耻的。是的。是的。是的。是的。我 我"}, {"type": "subtitle", "time": 9706.23, "timestamp": "02:41:46", "text": "甚至为了学习之类的也这么做。"}, {"type": "subtitle", "time": 9708.87, "timestamp": "02:41:48", "text": "或者比如，如果我有一项任务要做，我"}, {"type": "subtitle", "time": 9710.469, "timestamp": "02:41:50", "text": "当时就说：“是啊，我打算这么做。”"}, {"type": "subtitle", "time": 9713.349, "timestamp": "02:41:53", "text": "这样我就可以集中注意力，或者"}, {"type": "subtitle", "time": 9715.51, "timestamp": "02:41:55", "text": "否则我就会拖延。"}, {"type": "subtitle", "time": 9717.75, "timestamp": "02:41:57", "text": "浪费时间。我的天哪。"}]
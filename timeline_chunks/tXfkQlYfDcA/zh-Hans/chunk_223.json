[{"type": "subtitle", "time": 13381.429, "timestamp": "03:43:01", "text": "诸如此类的设置。正确的。正确的。和"}, {"type": "subtitle", "time": 13383.91, "timestamp": "03:43:03", "text": "你发送信息流，然后选择呃……"}, {"type": "subtitle", "time": 13385.59, "timestamp": "03:43:05", "text": "平台以及所有的一切，并确保"}, {"type": "subtitle", "time": 13389.429, "timestamp": "03:43:09", "text": "呃，就是那些信息流，就像……"}, {"type": "subtitle", "time": 13390.95, "timestamp": "03:43:10", "text": "垂直方向，你必须抓住"}, {"type": "subtitle", "time": 13393.59, "timestamp": "03:43:13", "text": "垂直流。对于普通的你"}, {"type": "subtitle", "time": 13395.269, "timestamp": "03:43:15", "text": "只需按下开机按钮即可。"}, {"type": "subtitle", "time": 13398.07, "timestamp": "03:43:18", "text": "就是这样。他们还有一个大学聊天群。"}, {"type": "subtitle", "time": 13401.99, "timestamp": "03:43:21", "text": "出色地。所以这就像是支持的平台一样。"}, {"type": "subtitle", "time": 13404.79, "timestamp": "03:43:24", "text": "呃，它们就像 YouTube、Twitch、Kick 一样。"}, {"type": "subtitle", "time": 13407.75, "timestamp": "03:43:27", "text": "麻烦，所有这些平台。呃，他们"}, {"type": "subtitle", "time": 13410.15, "timestamp": "03:43:30", "text": "进行一次独特的聊天。所以他们所有的"}, {"type": "subtitle", "time": 13412.79, "timestamp": "03:43:32", "text": "其他人都在聊天。"}, {"type": "subtitle", "time": 13414.63, "timestamp": "03:43:34", "text": "在其他平台上与你的直播互动"}, {"type": "subtitle", "time": 13417.269, "timestamp": "03:43:37", "text": "他们的聊天记录将显示在服务中"}, {"type": "subtitle", "time": 13421.429, "timestamp": "03:43:41", "text": "Beam上的大学聊天。所以就像艾伦一样"}, {"type": "subtitle", "time": 13423.51, "timestamp": "03:43:43", "text": "链接，所以你可以在这里看到"}, {"type": "subtitle", "time": 13426.229, "timestamp": "03:43:46", "text": "YouTube 和 Twitch 的踢人聊天室之类的东西。"}, {"type": "subtitle", "time": 13429.11, "timestamp": "03:43:49", "text": "说实话，它真的很方便。"}, {"type": "subtitle", "time": 13430.63, "timestamp": "03:43:50", "text": "是的，我感觉这是第一次"}, {"type": "subtitle", "time": 13432.229, "timestamp": "03:43:52", "text": "我听说过。谢谢分享"}, {"type": "subtitle", "time": 13435.269, "timestamp": "03:43:55", "text": "那。什么？"}, {"type": "subtitle", "time": 13438.389, "timestamp": "03:43:58", "text": "唯一的不足之处在于……"}]
[{"type": "subtitle", "time": 7622.629, "timestamp": "02:07:02", "text": "在我右侧的两侧"}, {"type": "subtitle", "time": 7629.669, "timestamp": "02:07:09", "text": "感觉就像触电一样。"}, {"type": "subtitle", "time": 7631.04, "timestamp": "02:07:11", "text": "东西。"}, {"type": "subtitle", "time": 7642.47, "timestamp": "02:07:22", "text": "如何把它拉下来？这个椅子的高度。"}, {"type": "subtitle", "time": 7645.83, "timestamp": "02:07:25", "text": "快点。下去。下去。我认为"}, {"type": "subtitle", "time": 7654.709, "timestamp": "02:07:34", "text": "这个把手"}, {"type": "subtitle", "time": 7657.109, "timestamp": "02:07:37", "text": "只有这个把手可以像这样弯曲。"}, {"type": "subtitle", "time": 7659.43, "timestamp": "02:07:39", "text": "走进了椅子"}, {"type": "subtitle", "time": 7661.91, "timestamp": "02:07:41", "text": "缓解疼痛。这里更像个办公室"}, {"type": "subtitle", "time": 7665.189, "timestamp": "02:07:45", "text": "椅子。这个"}, {"type": "subtitle", "time": 7666.87, "timestamp": "02:07:46", "text": "您可以在这里调节高度和"}, {"type": "subtitle", "time": 7669.91, "timestamp": "02:07:49", "text": "东西。它有一个头枕"}, {"type": "subtitle", "time": 7673.35, "timestamp": "02:07:53", "text": "那里只有一把游戏椅。我可以这么说"}]
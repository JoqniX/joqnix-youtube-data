[{"type": "subtitle", "time": 14.87, "timestamp": "00:00:14", "text": "大家好，我们又回来了。"}, {"type": "subtitle", "time": 17.67, "timestamp": "00:00:17", "text": "欢迎来到 Joadon 第 92 天第二部分"}, {"type": "subtitle", "time": 20.55, "timestamp": "00:00:20", "text": "溪流。呃，我们的下一位嘉宾是……"}, {"type": "subtitle", "time": 25.509, "timestamp": "00:00:25", "text": "苏苏丹山。嗯，客人还没到。"}, {"type": "subtitle", "time": 28.07, "timestamp": "00:00:28", "text": "准备好了吗？我正在等客人。"}, {"type": "subtitle", "time": 30.87, "timestamp": "00:00:30", "text": "如果客人未到场，则需另行通知。"}, {"type": "subtitle", "time": 33.43, "timestamp": "00:00:33", "text": "嗯，如果当天有空的话就没问题。我们"}, {"type": "chat", "time": 35.314, "timestamp": "00:00:35", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "Yoooo"}, {"type": "subtitle", "time": 37.11, "timestamp": "00:00:37", "text": "可以随时重新安排时间，但是，是的"}, {"type": "subtitle", "time": 39.67, "timestamp": "00:00:39", "text": "晚上10点左右。我们有"}, {"type": "subtitle", "time": 43.59, "timestamp": "00:00:43", "text": "与 daddy do palms 合作"}, {"type": "subtitle", "time": 45.51, "timestamp": "00:00:45", "text": "我很期待。那是"}, {"type": "subtitle", "time": 48.709, "timestamp": "00:00:48", "text": "我们的第一次接触。是的。那么，我们开始吧"}, {"type": "subtitle", "time": 51.43, "timestamp": "00:00:51", "text": "希望客人尽快到来。"}, {"type": "subtitle", "time": 54.229, "timestamp": "00:00:54", "text": "或者稍后。是的，我会等着。我"}, {"type": "subtitle", "time": 56.79, "timestamp": "00:00:56", "text": "我要去撒尿、办事，然后回来"}]
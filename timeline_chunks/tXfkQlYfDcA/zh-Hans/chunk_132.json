[{"type": "subtitle", "time": 7930.95, "timestamp": "02:12:10", "text": "我不应该躺着写作。"}, {"type": "subtitle", "time": 7937.51, "timestamp": "02:12:17", "text": "是的。你好。"}, {"type": "subtitle", "time": 7957.35, "timestamp": "02:12:37", "text": "这是我的名字。我忘了他的名字。"}, {"type": "subtitle", "time": 7962.31, "timestamp": "02:12:42", "text": "与L. Lewis有关。不，"}, {"type": "subtitle", "time": 7964.629, "timestamp": "02:12:44", "text": "我忘了。等待。我应该用谷歌搜索吗？我"}, {"type": "subtitle", "time": 7966.629, "timestamp": "02:12:46", "text": "不知道。"}, {"type": "subtitle", "time": 7968.87, "timestamp": "02:12:48", "text": "呃"}, {"type": "subtitle", "time": 7971.51, "timestamp": "02:12:51", "text": "那个人就像他的一切，他总是"}, {"type": "subtitle", "time": 7974.47, "timestamp": "02:12:54", "text": "就像“买我的课程，买我的课程”"}, {"type": "subtitle", "time": 7977.43, "timestamp": "02:12:57", "text": "了解并掌握赚钱的方法"}]
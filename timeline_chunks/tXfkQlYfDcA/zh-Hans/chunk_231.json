[{"type": "subtitle", "time": 13860.389, "timestamp": "03:51:00", "text": "在日本 YouTuber 之间搭建桥梁"}, {"type": "subtitle", "time": 13862.469, "timestamp": "03:51:02", "text": "还有 YouTuber 之类的，这样他们就可以"}, {"type": "subtitle", "time": 13866.469, "timestamp": "03:51:06", "text": "协作起来很容易，对吧？ JP和Ken"}, {"type": "subtitle", "time": 13868.87, "timestamp": "03:51:08", "text": "还有其他一些东西。所以如果我把它们都带来"}, {"type": "subtitle", "time": 13871.59, "timestamp": "03:51:11", "text": "一起，举办一个大型活动之类的。"}, {"type": "subtitle", "time": 13874.229, "timestamp": "03:51:14", "text": "他们可以交往，他们也可以……"}, {"type": "subtitle", "time": 13876.15, "timestamp": "03:51:16", "text": "这将是一个很好的机会，让他们……"}, {"type": "subtitle", "time": 13878.469, "timestamp": "03:51:18", "text": "结识喜欢这样的新朋友。这是有益的"}, {"type": "subtitle", "time": 13881.189, "timestamp": "03:51:21", "text": "两端都是如此，对吧？这就是我"}, {"type": "subtitle", "time": 13883.429, "timestamp": "03:51:23", "text": "我一直在思考，感觉自己好像还没有……"}, {"type": "subtitle", "time": 13885.83, "timestamp": "03:51:25", "text": "为社区做出了巨大贡献。我当时"}, {"type": "subtitle", "time": 13888.63, "timestamp": "03:51:28", "text": "或许我会这么做。"}, {"type": "subtitle", "time": 13890.389, "timestamp": "03:51:30", "text": "你怎么敢这么说！你接受那个"}, {"type": "subtitle", "time": 13894.07, "timestamp": "03:51:34", "text": "马上回来。你在干什么？"}, {"type": "subtitle", "time": 13896.95, "timestamp": "03:51:36", "text": "你贡献了很多，就像你带来了很多东西。"}, {"type": "subtitle", "time": 13899.189, "timestamp": "03:51:39", "text": "这么多人聚在一起。你做了个喜欢"}, {"type": "subtitle", "time": 13902.15, "timestamp": "03:51:42", "text": "疯狂的，就像一大群人，你知道的"}, {"type": "subtitle", "time": 13904.469, "timestamp": "03:51:44", "text": "试图让人们参与进来"}, {"type": "subtitle", "time": 13906.469, "timestamp": "03:51:46", "text": "在社区中，参与每个"}, {"type": "subtitle", "time": 13909.75, "timestamp": "03:51:49", "text": "其他。嗯，想认识一些新朋友。"}, {"type": "subtitle", "time": 13912.79, "timestamp": "03:51:52", "text": "那工作量简直太大了。不"}, {"type": "subtitle", "time": 13914.63, "timestamp": "03:51:54", "text": "你敢！你胆敢把自己置于险境？"}, {"type": "subtitle", "time": 13917.67, "timestamp": "03:51:57", "text": "向下。我会揍你。我会给你做一个"}]
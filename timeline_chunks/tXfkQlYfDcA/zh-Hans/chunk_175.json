[{"type": "subtitle", "time": 10500.07, "timestamp": "02:55:00", "text": "这次因为人民"}, {"type": "subtitle", "time": 10502.309, "timestamp": "02:55:02", "text": "那些帮助我的人，他们根本抽不出人手。"}, {"type": "subtitle", "time": 10506.15, "timestamp": "02:55:06", "text": "资金。所以我就想，我得自己来做。所以"}, {"type": "subtitle", "time": 10507.83, "timestamp": "02:55:07", "text": "呃，因为他们现在好像在休息，"}, {"type": "subtitle", "time": 10510.389, "timestamp": "02:55:10", "text": "所以我就想，是啊，我要走了。"}, {"type": "subtitle", "time": 10514.71, "timestamp": "02:55:14", "text": "我自己来做，看看结果如何。"}, {"type": "subtitle", "time": 10517.99, "timestamp": "02:55:17", "text": "我确实特意向他提到了这一点。"}, {"type": "subtitle", "time": 10520.15, "timestamp": "02:55:20", "text": "艺术家，以及那种感觉，是的，我会是"}, {"type": "subtitle", "time": 10523.03, "timestamp": "02:55:23", "text": "做 Joathon 之类的活动，还有所有的一切"}, {"type": "subtitle", "time": 10525.91, "timestamp": "02:55:25", "text": "像这样，我觉得我更像"}, {"type": "subtitle", "time": 10528.79, "timestamp": "02:55:28", "text": "我感觉自己太……呃……太……"}, {"type": "subtitle", "time": 10531.03, "timestamp": "02:55:31", "text": "因为我跟客户很像，所以想跟他合作。"}, {"type": "subtitle", "time": 10534.23, "timestamp": "02:55:34", "text": "挑剔且完美主义。我和每个人一样"}, {"type": "subtitle", "time": 10538.15, "timestamp": "02:55:38", "text": "花时间指出缺点之类的。"}, {"type": "subtitle", "time": 10541.03, "timestamp": "02:55:41", "text": "我不知道。但我感觉就像……"}, {"type": "subtitle", "time": 10542.79, "timestamp": "02:55:42", "text": "比如我接了一些委托"}, {"type": "subtitle", "time": 10544.95, "timestamp": "02:55:44", "text": "通常我很感激客户。"}, {"type": "subtitle", "time": 10546.87, "timestamp": "02:55:46", "text": "那些花时间说“嘿，"}, {"type": "subtitle", "time": 10548.23, "timestamp": "02:55:48", "text": "比如，这里有几件事……"}, {"type": "subtitle", "time": 10549.83, "timestamp": "02:55:49", "text": "想换衣服，他们总是"}, {"type": "subtitle", "time": 10551.99, "timestamp": "02:55:51", "text": "比如指出具体的事情。”而我"}, {"type": "subtitle", "time": 10554.23, "timestamp": "02:55:54", "text": "当然，就像你一样，嗯，那些艺术家们。"}, {"type": "subtitle", "time": 10555.99, "timestamp": "02:55:55", "text": "非常感谢你的付出。"}, {"type": "subtitle", "time": 10558.309, "timestamp": "02:55:58", "text": "详细说明你想要什么以及喜欢什么"}]
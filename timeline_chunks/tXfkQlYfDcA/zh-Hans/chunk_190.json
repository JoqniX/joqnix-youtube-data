[{"type": "subtitle", "time": 11400.55, "timestamp": "03:10:00", "text": "是的。感觉有点像"}, {"type": "subtitle", "time": 11402.55, "timestamp": "03:10:02", "text": "就像一声悲伤的警钟，当它像"}, {"type": "subtitle", "time": 11405.11, "timestamp": "03:10:05", "text": "啊，糟了。好的。显然，这里并非如此。"}, {"type": "subtitle", "time": 11407.269, "timestamp": "03:10:07", "text": "我现在就能做的事。但是就像"}, {"type": "subtitle", "time": 11409.429, "timestamp": "03:10:09", "text": "依赖它并不是一件坏事"}, {"type": "subtitle", "time": 11411.91, "timestamp": "03:10:11", "text": "人们。我很高兴，嗯，我很高兴你这样"}, {"type": "subtitle", "time": 11415.67, "timestamp": "03:10:15", "text": "当然，决定依靠几个人"}, {"type": "subtitle", "time": 11417.83, "timestamp": "03:10:17", "text": "那些显然花费了大量时间的人"}, {"type": "subtitle", "time": 11420.309, "timestamp": "03:10:20", "text": "花费时间和精力去追求完美"}, {"type": "subtitle", "time": 11423.03, "timestamp": "03:10:23", "text": "艺术和完善他们喜欢的技能。它是"}, {"type": "subtitle", "time": 11427.19, "timestamp": "03:10:27", "text": "这完全不是什么坏事。是的。"}, {"type": "subtitle", "time": 11429.75, "timestamp": "03:10:29", "text": "哇。"}, {"type": "subtitle", "time": 11431.83, "timestamp": "03:10:31", "text": "我们完全忘记了我们曾经是"}, {"type": "subtitle", "time": 11433.83, "timestamp": "03:10:33", "text": "应该玩游戏。我们当时正在聊天"}, {"type": "subtitle", "time": 11442.07, "timestamp": "03:10:42", "text": "这太有趣了。我喜欢唠叨。嗯"}, {"type": "subtitle", "time": 11444.87, "timestamp": "03:10:44", "text": "我喜欢唠叨。我们就像你喜欢的那样"}, {"type": "subtitle", "time": 11447.429, "timestamp": "03:10:47", "text": "新来的人就像哦耶，我们就像……"}, {"type": "subtitle", "time": 11451.51, "timestamp": "03:10:51", "text": "好好谈谈。让我们点赞吧。"}, {"type": "subtitle", "time": 11453.59, "timestamp": "03:10:53", "text": "我的天啊。"}, {"type": "subtitle", "time": 11455.67, "timestamp": "03:10:55", "text": "不过，这很值得。我意识到我"}, {"type": "subtitle", "time": 11459.03, "timestamp": "03:10:59", "text": "我一直害怕我更像我"}]
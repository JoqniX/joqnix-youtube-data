[{"type": "subtitle", "time": 7860.229, "timestamp": "02:11:00", "text": "弧"}, {"type": "subtitle", "time": 7863.51, "timestamp": "02:11:03", "text": "很久以前。"}, {"type": "subtitle", "time": 7866.31, "timestamp": "02:11:06", "text": "我的天哪，我竟然知道了这件事。我一直"}, {"type": "subtitle", "time": 7869.109, "timestamp": "02:11:09", "text": "观看每一个视频都非常喜欢"}, {"type": "subtitle", "time": 7871.99, "timestamp": "02:11:11", "text": "关于此事的视频。"}, {"type": "subtitle", "time": 7874.55, "timestamp": "02:11:14", "text": "所有这些"}, {"type": "subtitle", "time": 7881.75, "timestamp": "02:11:21", "text": "[音乐]"}, {"type": "subtitle", "time": 7884.709, "timestamp": "02:11:24", "text": "所有这些"}, {"type": "subtitle", "time": 7896.229, "timestamp": "02:11:36", "text": "制作视频的人的名字"}, {"type": "subtitle", "time": 7898.55, "timestamp": "02:11:38", "text": "如何赚钱"}, {"type": "subtitle", "time": 7901.91, "timestamp": "02:11:41", "text": "当他待在车库里的时候。"}, {"type": "subtitle", "time": 7903.83, "timestamp": "02:11:43", "text": "他叫什么名字来着？谁像谁"}, {"type": "subtitle", "time": 7905.91, "timestamp": "02:11:45", "text": "戴眼镜什么的？谁拥有"}, {"type": "subtitle", "time": 7909.75, "timestamp": "02:11:49", "text": "眼镜之类的东西？我忘了他的名字。那"}, {"type": "subtitle", "time": 7911.42, "timestamp": "02:11:51", "text": "男。"}, {"type": "subtitle", "time": 7914.47, "timestamp": "02:11:54", "text": "[音乐]"}, {"type": "subtitle", "time": 7918.39, "timestamp": "02:11:58", "text": "我以前经常看他们的视频之类的。"}]
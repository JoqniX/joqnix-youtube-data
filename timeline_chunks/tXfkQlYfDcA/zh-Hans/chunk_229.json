[{"type": "subtitle", "time": 13740.79, "timestamp": "03:49:00", "text": "想考虑一下YouTube之类的平台，但是"}, {"type": "subtitle", "time": 13743.429, "timestamp": "03:49:03", "text": "然后我就想，呃，就像从……开始"}, {"type": "subtitle", "time": 13751.03, "timestamp": "03:49:11", "text": "如今人们喜欢对人持开放态度"}, {"type": "subtitle", "time": 13753.11, "timestamp": "03:49:13", "text": "比如在其他平台发布他们的内容"}, {"type": "subtitle", "time": 13755.75, "timestamp": "03:49:15", "text": "现在的地方。所以现在情况就是这样了……"}, {"type": "subtitle", "time": 13759.269, "timestamp": "03:49:19", "text": "多平台直播的趋势似乎已经出现了。"}, {"type": "subtitle", "time": 13762.389, "timestamp": "03:49:22", "text": "好的。现在 Twitch 允许前往"}, {"type": "subtitle", "time": 13764.71, "timestamp": "03:49:24", "text": "使垂直流成为"}, {"type": "subtitle", "time": 13766.71, "timestamp": "03:49:26", "text": "现在想想，如果你只是"}, {"type": "subtitle", "time": 13769.269, "timestamp": "03:49:29", "text": "流式传输到水平方向。"}, {"type": "subtitle", "time": 13771.99, "timestamp": "03:49:31", "text": "是的。我觉得他们真的……你可以"}, {"type": "subtitle", "time": 13775.03, "timestamp": "03:49:35", "text": "还可以看到，在他们尝试……"}, {"type": "subtitle", "time": 13777.189, "timestamp": "03:49:37", "text": "像短裤或者像 Twitch 那样"}, {"type": "subtitle", "time": 13780.07, "timestamp": "03:49:40", "text": "发现信息流简直像个完整的"}, {"type": "subtitle", "time": 13782.63, "timestamp": "03:49:42", "text": "垂直的东西。我当时就想，哦，什么？在哪儿？"}, {"type": "subtitle", "time": 13786.55, "timestamp": "03:49:46", "text": "这是从哪里来的？什么？"}, {"type": "subtitle", "time": 13788.63, "timestamp": "03:49:48", "text": "是的。但非常有趣。我认为是"}, {"type": "subtitle", "time": 13792.15, "timestamp": "03:49:52", "text": "也绝对喜欢TikTok之类的东西"}, {"type": "subtitle", "time": 13795.11, "timestamp": "03:49:55", "text": "TikTok 就这样让我们彻底沦陷了。"}, {"type": "subtitle", "time": 13797.59, "timestamp": "03:49:57", "text": "把我们耍得团团转。所以感觉就像，哦"}, {"type": "subtitle", "time": 13799.51, "timestamp": "03:49:59", "text": "是啊，得想办法弄明白。"}]
[{"type": "subtitle", "time": 13921.59, "timestamp": "03:52:01", "text": "现在的星座。"}, {"type": "subtitle", "time": 13922.95, "timestamp": "03:52:02", "text": "是的。"}, {"type": "subtitle", "time": 13926.63, "timestamp": "03:52:06", "text": "我的天啊。我觉得是我的……我觉得是"}, {"type": "subtitle", "time": 13929.59, "timestamp": "03:52:09", "text": "我患有这种自我冒充综合症。"}, {"type": "subtitle", "time": 13932.389, "timestamp": "03:52:12", "text": "大概是什么东西吧。嗯哼。我认为是"}, {"type": "subtitle", "time": 13935.03, "timestamp": "03:52:15", "text": "那。嗯，我会在这里打破这个魔咒。"}, {"type": "subtitle", "time": 13946.229, "timestamp": "03:52:26", "text": "哇。"}, {"type": "subtitle", "time": 13948.07, "timestamp": "03:52:28", "text": "嗯，我觉得就是这样，嗯，你"}, {"type": "subtitle", "time": 13951.11, "timestamp": "03:52:31", "text": "显然对……充满热情"}, {"type": "subtitle", "time": 13953.59, "timestamp": "03:52:33", "text": "把人们聚集在一起做某事"}, {"type": "subtitle", "time": 13955.91, "timestamp": "03:52:35", "text": "某些事物确实喜欢相互交融"}, {"type": "subtitle", "time": 13958.63, "timestamp": "03:52:38", "text": "其他人就像一个非常像社交达人的人"}, {"type": "subtitle", "time": 13960.71, "timestamp": "03:52:40", "text": "这真是太有趣了。"}, {"type": "subtitle", "time": 13964.389, "timestamp": "03:52:44", "text": "是的。不，我是个内向的人。我太害羞了。"}, {"type": "subtitle", "time": 13967.75, "timestamp": "03:52:47", "text": "就像消音器一样。太疯狂了。我 我"}, {"type": "subtitle", "time": 13969.67, "timestamp": "03:52:49", "text": "我真的不认为你是内向的人"}, {"type": "subtitle", "time": 13972.389, "timestamp": "03:52:52", "text": "因为我觉得你可能"}, {"type": "subtitle", "time": 13974.63, "timestamp": "03:52:54", "text": "就像一件双面艺术品，你知道吗？你就像"}, {"type": "subtitle", "time": 13976.87, "timestamp": "03:52:56", "text": "非常外向"}, {"type": "subtitle", "time": 13978.229, "timestamp": "03:52:58", "text": "嗯，说到你知道的"}]
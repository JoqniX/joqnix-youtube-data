[{"type": "subtitle", "time": 3840.549, "timestamp": "01:04:00", "text": "但你尝试过，你投入了几个小时。"}, {"type": "subtitle", "time": 3843.75, "timestamp": "01:04:03", "text": "即使你没有取得进展"}, {"type": "subtitle", "time": 3847.27, "timestamp": "01:04:07", "text": "有时候你喜欢 h 我做完了 我不能"}, {"type": "subtitle", "time": 3849.75, "timestamp": "01:04:09", "text": "过一会儿，你休息一下，然后回来"}, {"type": "subtitle", "time": 3851.51, "timestamp": "01:04:11", "text": "经过一番激励后，我又回来了。"}, {"type": "subtitle", "time": 3854.39, "timestamp": "01:04:14", "text": "你可以通过它取得一些进展。"}, {"type": "subtitle", "time": 3857.51, "timestamp": "01:04:17", "text": "走了一半，之后你就终于到了"}, {"type": "subtitle", "time": 3860.23, "timestamp": "01:04:20", "text": "是的，做过类似的事情。"}, {"type": "subtitle", "time": 3862.069, "timestamp": "01:04:22", "text": "除了春季学龄儿童外，其他时间都存在危险"}, {"type": "subtitle", "time": 3865.109, "timestamp": "01:04:25", "text": "因为这意味着一天换一天"}, {"type": "subtitle", "time": 3867.349, "timestamp": "01:04:27", "text": "他们得早起上学，起床时间比预计时间早一个小时。"}, {"type": "subtitle", "time": 3870.069, "timestamp": "01:04:30", "text": "之后。是的，"}, {"type": "subtitle", "time": 3872.87, "timestamp": "01:04:32", "text": "这对学龄儿童来说确实很痛苦。等待，"}, {"type": "subtitle", "time": 3875.029, "timestamp": "01:04:35", "text": "难道不就像暑假一样吗？"}, {"type": "subtitle", "time": 3877.829, "timestamp": "01:04:37", "text": "现在每个人都这样吗？"}, {"type": "subtitle", "time": 3879.19, "timestamp": "01:04:39", "text": "或者说，是吗？"}, {"type": "subtitle", "time": 3882.309, "timestamp": "01:04:42", "text": "[音乐]"}, {"type": "subtitle", "time": 3884.069, "timestamp": "01:04:44", "text": "喜欢"}, {"type": "subtitle", "time": 3887.19, "timestamp": "01:04:47", "text": "像很多人一样，喜欢这个国家的大部分人"}, {"type": "subtitle", "time": 3890.63, "timestamp": "01:04:50", "text": "我想很可能是在印度和其他地方。"}, {"type": "subtitle", "time": 3893.75, "timestamp": "01:04:53", "text": "就像三月、四月、五月一样"}, {"type": "subtitle", "time": 3897.27, "timestamp": "01:04:57", "text": "三月底"}]
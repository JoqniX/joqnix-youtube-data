[{"type": "subtitle", "time": 12061.11, "timestamp": "03:21:01", "text": "离开或者像睡着一样，你们俩"}, {"type": "subtitle", "time": 12064.15, "timestamp": "03:21:04", "text": "朋友们可以聊天娱乐，还可以一起玩游戏。"}, {"type": "subtitle", "time": 12066.07, "timestamp": "03:21:06", "text": "他们会直播自己的游戏之类的，对吧？"}, {"type": "subtitle", "time": 12068.229, "timestamp": "03:21:08", "text": "通过 Discord。所以，我做了某件事。"}, {"type": "subtitle", "time": 12071.99, "timestamp": "03:21:11", "text": "就像和一位值得信赖的朋友那样"}, {"type": "subtitle", "time": 12074.469, "timestamp": "03:21:14", "text": "Billy Billy 管理员真的把网站关掉了"}, {"type": "subtitle", "time": 12077.67, "timestamp": "03:21:17", "text": "我的直播持续了30秒。是的。说"}, {"type": "subtitle", "time": 12081.19, "timestamp": "03:21:21", "text": "那个负面的直播玩意儿"}, {"type": "subtitle", "time": 12084.07, "timestamp": "03:21:24", "text": "我意识到，呃，是在和呃……交谈之后。"}, {"type": "subtitle", "time": 12087.349, "timestamp": "03:21:27", "text": "视频里我正在和 Next 合作。"}, {"type": "subtitle", "time": 12091.67, "timestamp": "03:21:31", "text": "一周后，她说，嗯，比利"}, {"type": "subtitle", "time": 12094.309, "timestamp": "03:21:34", "text": "比利需要一个像样的版权声明。"}, {"type": "subtitle", "time": 12097.83, "timestamp": "03:21:37", "text": "任何内容的许可和相关事宜"}, {"type": "subtitle", "time": 12099.99, "timestamp": "03:21:39", "text": "你甚至还会播放 YouTube 视频之类的东西"}, {"type": "subtitle", "time": 12104.229, "timestamp": "03:21:44", "text": "你需要版权许可"}, {"type": "subtitle", "time": 12107.59, "timestamp": "03:21:47", "text": "来自原作者和相关内容。我是"}, {"type": "subtitle", "time": 12110.63, "timestamp": "03:21:50", "text": "播放我自己录制的视频点播。那不"}, {"type": "subtitle", "time": 12113.59, "timestamp": "03:21:53", "text": "工作也是如此。"}, {"type": "subtitle", "time": 12115.75, "timestamp": "03:21:55", "text": "等等，你是在玩你自己的WD游戏吗？"}, {"type": "subtitle", "time": 12117.75, "timestamp": "03:21:57", "text": "他们会说，你需要获得许可。"}]
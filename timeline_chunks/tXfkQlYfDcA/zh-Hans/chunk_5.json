[{"type": "subtitle", "time": 301.27, "timestamp": "00:05:01", "text": "那里的直播是一小时，呃，是10小时。"}, {"type": "subtitle", "time": 303.35, "timestamp": "00:05:03", "text": "我们沿着一条长长的溪流向下砍伐"}, {"type": "subtitle", "time": 305.99, "timestamp": "00:05:05", "text": "一点。得稍微修剪一下。"}, {"type": "subtitle", "time": 308.79, "timestamp": "00:05:08", "text": "少量。成功了。"}, {"type": "subtitle", "time": 315.27, "timestamp": "00:05:15", "text": "那就是"}, {"type": "subtitle", "time": 317.59, "timestamp": "00:05:17", "text": "呃"}, {"type": "subtitle", "time": 327.35, "timestamp": "00:05:27", "text": "我想要这个颜色。"}, {"type": "subtitle", "time": 338.95, "timestamp": "00:05:38", "text": "好了，这样我就可以速通了。好的，"}, {"type": "subtitle", "time": 342.469, "timestamp": "00:05:42", "text": "让我速通一下。对不起。"}, {"type": "subtitle", "time": 344.629, "timestamp": "00:05:44", "text": "我相信你肯定让男人们看到了这一点。"}, {"type": "subtitle", "time": 348.1, "timestamp": "00:05:48", "text": "没错，我要速通这个游戏。"}, {"type": "subtitle", "time": 350.31, "timestamp": "00:05:50", "text": "[音乐]"}, {"type": "subtitle", "time": 352.79, "timestamp": "00:05:52", "text": "等等，这些没有编号。"}, {"type": "subtitle", "time": 354.23, "timestamp": "00:05:54", "text": "是流媒体，对吧？是的，没有"}, {"type": "subtitle", "time": 357.43, "timestamp": "00:05:57", "text": "编号。所以，没有必要这样做。"}]
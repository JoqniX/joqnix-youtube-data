[{"type": "subtitle", "time": 1741.029, "timestamp": "00:29:01", "text": "是的。你好。布拉德，你好吗？"}, {"type": "subtitle", "time": 1744.47, "timestamp": "00:29:04", "text": "希望你一切都好。早上好。"}, {"type": "subtitle", "time": 1746.11, "timestamp": "00:29:06", "text": "早安，面包。"}, {"type": "subtitle", "time": 1747.43, "timestamp": "00:29:07", "text": "[音乐]"}, {"type": "subtitle", "time": 1754.78, "timestamp": "00:29:14", "text": "呃，"}, {"type": "subtitle", "time": 1757.029, "timestamp": "00:29:17", "text": "[音乐]"}, {"type": "subtitle", "time": 1758.87, "timestamp": "00:29:18", "text": "早上好。"}, {"type": "subtitle", "time": 1760.87, "timestamp": "00:29:20", "text": "你有SIM卡吗？抱歉。对不起。"}, {"type": "subtitle", "time": 1765.19, "timestamp": "00:29:25", "text": "我正在设置VTS雾效，因为……"}, {"type": "subtitle", "time": 1767.11, "timestamp": "00:29:27", "text": "我忘了还要设置文本转语音功能。"}, {"type": "subtitle", "time": 1772.07, "timestamp": "00:29:32", "text": "呃，用于 YouTube 聊天。"}, {"type": "subtitle", "time": 1773.909, "timestamp": "00:29:33", "text": "另外，我还需要用到这个小东西。"}, {"type": "subtitle", "time": 1778.23, "timestamp": "00:29:38", "text": "伙计，这个笨蛋。我想制作"}, {"type": "subtitle", "time": 1781.75, "timestamp": "00:29:41", "text": "让他说话。是的，"}, {"type": "subtitle", "time": 1784.47, "timestamp": "00:29:44", "text": "我一直让他躲在……后面"}, {"type": "subtitle", "time": 1787.269, "timestamp": "00:29:47", "text": "大家的头像都这样。"}, {"type": "subtitle", "time": 1790.389, "timestamp": "00:29:50", "text": "所以，是的，我想让他……动起来。"}, {"type": "subtitle", "time": 1792.71, "timestamp": "00:29:52", "text": "就像你们聊天时发的短信一样"}, {"type": "subtitle", "time": 1795.11, "timestamp": "00:29:55", "text": "语音指令。"}]
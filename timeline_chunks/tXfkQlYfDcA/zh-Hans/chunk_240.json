[{"type": "subtitle", "time": 14400.71, "timestamp": "04:00:00", "text": "一直在等待和聆听这一切"}, {"type": "subtitle", "time": 14402.95, "timestamp": "04:00:02", "text": "争吵和打斗不断，而我……"}, {"type": "subtitle", "time": 14406.55, "timestamp": "04:00:06", "text": "他恳求道，最后他同意了，他"}, {"type": "subtitle", "time": 14408.95, "timestamp": "04:00:08", "text": "付了钱，最后我拿到了我的"}, {"type": "subtitle", "time": 14413.59, "timestamp": "04:00:13", "text": "我当时就想，哇，我，我面对着一个"}, {"type": "subtitle", "time": 14417.67, "timestamp": "04:00:17", "text": "战争都是因为这家伙。"}, {"type": "subtitle", "time": 14419.67, "timestamp": "04:00:19", "text": "等等，但他们难道不喜欢说吗？"}, {"type": "subtitle", "time": 14421.83, "timestamp": "04:00:21", "text": "事先就像，哦，可能会有……"}, {"type": "subtitle", "time": 14425.75, "timestamp": "04:00:25", "text": "海关方面，比如价格，或者不，我没有"}, {"type": "subtitle", "time": 14428.389, "timestamp": "04:00:28", "text": "知道。好像是DHL之类的，我"}, {"type": "subtitle", "time": 14431.349, "timestamp": "04:00:31", "text": "当时我就想，哦，对啊，这在……"}, {"type": "subtitle", "time": 14438.95, "timestamp": "04:00:38", "text": "是的。而且这样做也没什么帮助，就好像……"}, {"type": "subtitle", "time": 14442.79, "timestamp": "04:00:42", "text": "比如电子设备之类的"}, {"type": "subtitle", "time": 14444.95, "timestamp": "04:00:44", "text": "异国他乡。那就是他们"}, {"type": "subtitle", "time": 14447.189, "timestamp": "04:00:47", "text": "喜欢。哦，是的，我们必须把我们必须"}, {"type": "subtitle", "time": 14452.71, "timestamp": "04:00:52", "text": "[音乐]"}, {"type": "subtitle", "time": 14456.469, "timestamp": "04:00:56", "text": "它是 f。但现在你拥有了。"}, {"type": "subtitle", "time": 14458.95, "timestamp": "04:00:58", "text": "是的，我现在有了，因为我正在……"}]
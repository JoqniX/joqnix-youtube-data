[{"type": "subtitle", "time": 11100.79, "timestamp": "03:05:00", "text": "上传了第一张照片，然后我就……"}, {"type": "subtitle", "time": 11103.429, "timestamp": "03:05:03", "text": "有点自信就行了，如果是这样的话。"}, {"type": "subtitle", "time": 11106.63, "timestamp": "03:05:06", "text": "未完全编辑或未公开或其他"}, {"type": "subtitle", "time": 11108.71, "timestamp": "03:05:08", "text": "然后我开始上传所有视频片段。"}, {"type": "subtitle", "time": 11111.11, "timestamp": "03:05:11", "text": "人们在 YouTube 和 Twitch 上创作。开始"}, {"type": "subtitle", "time": 11115.19, "timestamp": "03:05:15", "text": "上传的时候，我慢慢地……"}, {"type": "subtitle", "time": 11118.55, "timestamp": "03:05:18", "text": "呃，更有信心去做这件事，你"}, {"type": "subtitle", "time": 11120.469, "timestamp": "03:05:20", "text": "了解人们在生活中如何记录他们的生活"}, {"type": "subtitle", "time": 11122.15, "timestamp": "03:05:22", "text": "正在直播，并且喜欢把它做成"}, {"type": "subtitle", "time": 11124.469, "timestamp": "03:05:24", "text": "视频。"}, {"type": "subtitle", "time": 11126.23, "timestamp": "03:05:26", "text": "是的。是的。我试着那样做。"}, {"type": "subtitle", "time": 11128.23, "timestamp": "03:05:28", "text": "试试看效果如何。"}, {"type": "subtitle", "time": 11131.83, "timestamp": "03:05:31", "text": "因为要录视频，而我就是那样。"}, {"type": "subtitle", "time": 11134.309, "timestamp": "03:05:34", "text": "太多了。我要这么多"}, {"type": "subtitle", "time": 11137.51, "timestamp": "03:05:37", "text": "剪辑成第一、第二、第三遍。但"}, {"type": "subtitle", "time": 11139.59, "timestamp": "03:05:39", "text": "当直播进行时，我不知道什么"}, {"type": "subtitle", "time": 11141.75, "timestamp": "03:05:41", "text": "事情发生了。我大多数时候都能明白。"}, {"type": "subtitle", "time": 11143.91, "timestamp": "03:05:43", "text": "一次就成功了，因为……"}, {"type": "subtitle", "time": 11147.19, "timestamp": "03:05:47", "text": "就像原始的情感，对吧？我感觉"}, {"type": "subtitle", "time": 11149.269, "timestamp": "03:05:49", "text": "那样会更好，我也尝试过了。"}, {"type": "subtitle", "time": 11151.83, "timestamp": "03:05:51", "text": "上传一个视频试试效果。"}, {"type": "subtitle", "time": 11155.11, "timestamp": "03:05:55", "text": "我很高兴我这么做了，而且"}, {"type": "subtitle", "time": 11157.11, "timestamp": "03:05:57", "text": "感觉就像是。视频就像什么样？"}]
[{"type": "subtitle", "time": 13623.349, "timestamp": "03:47:03", "text": "我们不记得的事情，但它是"}, {"type": "subtitle", "time": 13625.83, "timestamp": "03:47:05", "text": "但我感觉我已经见过很多这样的例子了。"}, {"type": "subtitle", "time": 13628.55, "timestamp": "03:47:08", "text": "突然冒出来一个念头，然后就想，哦，算了。它是"}, {"type": "subtitle", "time": 13630.79, "timestamp": "03:47:10", "text": "只是不想久留或者喜欢"}, {"type": "subtitle", "time": 13632.95, "timestamp": "03:47:12", "text": "开发人员通常就像一个单人团队。"}, {"type": "subtitle", "time": 13635.99, "timestamp": "03:47:15", "text": "就是那种事。真是的，哎呀，这该怎么……"}, {"type": "subtitle", "time": 13639.189, "timestamp": "03:47:19", "text": "你指望他们做所有事吗？"}, {"type": "subtitle", "time": 13641.349, "timestamp": "03:47:21", "text": "是的。"}, {"type": "subtitle", "time": 13645.91, "timestamp": "03:47:25", "text": "好多东西。而现在，呃，最近……"}, {"type": "subtitle", "time": 13648.469, "timestamp": "03:47:28", "text": "一个叫噪音之类的平台"}, {"type": "subtitle", "time": 13651.75, "timestamp": "03:47:31", "text": "解散并停止运作。是的，是我"}, {"type": "subtitle", "time": 13654.469, "timestamp": "03:47:34", "text": "真的毫无头绪。"}, {"type": "subtitle", "time": 13657.03, "timestamp": "03:47:37", "text": "很多平台都好像在停摆。"}, {"type": "subtitle", "time": 13660.63, "timestamp": "03:47:40", "text": "过了一段时间。所以我希望这"}, {"type": "subtitle", "time": 13663.189, "timestamp": "03:47:43", "text": "不会停止。它对……非常有益"}, {"type": "subtitle", "time": 13665.11, "timestamp": "03:47:45", "text": "想要进行多流媒体直播的人"}, {"type": "subtitle", "time": 13669.03, "timestamp": "03:47:49", "text": "多流。正确的。正确的。是的。"}, {"type": "subtitle", "time": 13670.95, "timestamp": "03:47:50", "text": "嗯，如果你一直告诉他们“请”的话"}, {"type": "subtitle", "time": 13672.87, "timestamp": "03:47:52", "text": "伙计们"}, {"type": "subtitle", "time": 13676.309, "timestamp": "03:47:56", "text": "别走。是的，"}, {"type": "subtitle", "time": 13678.63, "timestamp": "03:47:58", "text": "它也获得了许多支持。我来到"}]
[{"type": "subtitle", "time": 14342.63, "timestamp": "03:59:02", "text": "我不知道。我为流"}, {"type": "subtitle", "time": 14345.67, "timestamp": "03:59:05", "text": "甲板伙伴就像在附近"}, {"type": "subtitle", "time": 14348.87, "timestamp": "03:59:08", "text": "大概9000左右。"}, {"type": "subtitle", "time": 14354.309, "timestamp": "03:59:14", "text": "差不多那么多。大概9000左右。"}, {"type": "subtitle", "time": 14358.79, "timestamp": "03:59:18", "text": "大约 10,000 卢比。以及习俗"}, {"type": "subtitle", "time": 14361.91, "timestamp": "03:59:21", "text": "不得不支付6000。"}, {"type": "subtitle", "time": 14366.229, "timestamp": "03:59:26", "text": "什么？是的。 6. 那几乎就是"}, {"type": "subtitle", "time": 14371.189, "timestamp": "03:59:31", "text": "它的成本。是的。太疯狂了。"}, {"type": "subtitle", "time": 14373.51, "timestamp": "03:59:33", "text": "我苦苦哀求爸爸。他是"}, {"type": "subtitle", "time": 14375.91, "timestamp": "03:59:35", "text": "比如，“这东西有什么用？”"}, {"type": "subtitle", "time": 14378.309, "timestamp": "03:59:38", "text": "不需要这个。我们不，我们不会给"}, {"type": "subtitle", "time": 14380.55, "timestamp": "03:59:40", "text": "“你要钱。”我哭着哀求。"}, {"type": "subtitle", "time": 14383.67, "timestamp": "03:59:43", "text": "恳求。终于把那东西给了我。"}, {"type": "subtitle", "time": 14386.389, "timestamp": "03:59:46", "text": "我可以把钱收回去。"}, {"type": "subtitle", "time": 14390.389, "timestamp": "03:59:50", "text": "东西。哦，因为外面有个男的。"}, {"type": "subtitle", "time": 14393.99, "timestamp": "03:59:53", "text": "和我的东西。它确实就在那里，但是"}, {"type": "subtitle", "time": 14396.79, "timestamp": "03:59:56", "text": "我买不起，因为没钱。我"}, {"type": "subtitle", "time": 14398.71, "timestamp": "03:59:58", "text": "他苦苦哀求他回来，可怜的家伙"}]
[{"type": "subtitle", "time": 8520.55, "timestamp": "02:22:00", "text": "但后来就变成了“是啊”。我的大部分工作"}, {"type": "subtitle", "time": 8522.15, "timestamp": "02:22:02", "text": "我的大部分东西通常都……"}, {"type": "subtitle", "time": 8524.95, "timestamp": "02:22:04", "text": "夜晚。是的。这就是你的原因"}, {"type": "subtitle", "time": 8530.79, "timestamp": "02:22:10", "text": "这是你通常点赞的时间吗？"}, {"type": "subtitle", "time": 8534.71, "timestamp": "02:22:14", "text": "呃，我的直播时间呃，跟平时一样。"}, {"type": "subtitle", "time": 8538.71, "timestamp": "02:22:18", "text": "以前是在早上"}, {"type": "subtitle", "time": 8542.55, "timestamp": "02:22:22", "text": "大概上午十点左右，因为……因为我"}, {"type": "subtitle", "time": 8546.07, "timestamp": "02:22:26", "text": "好像有课什么的，因为……"}, {"type": "subtitle", "time": 8548.95, "timestamp": "02:22:28", "text": "那段时间，我想是最后一次"}, {"type": "subtitle", "time": 8550.63, "timestamp": "02:22:30", "text": "十二月以及我经历的那些事"}, {"type": "subtitle", "time": 8554.07, "timestamp": "02:22:34", "text": "日语课程。所以它会在"}, {"type": "subtitle", "time": 8559.03, "timestamp": "02:22:39", "text": "晚上7点，呃，7点半到7点，对，7点，7点半"}, {"type": "subtitle", "time": 8561.99, "timestamp": "02:22:41", "text": "下午大概到10岁左右吧。现在"}, {"type": "subtitle", "time": 8567.11, "timestamp": "02:22:47", "text": "由于招生工作要到四月份才开始，所以他们呃"}, {"type": "subtitle", "time": 8570.389, "timestamp": "02:22:50", "text": "我上的是一所类似当地学院的学校。"}, {"type": "subtitle", "time": 8573.83, "timestamp": "02:22:53", "text": "所以，这就是我通过考试的经过。"}, {"type": "subtitle", "time": 8578.63, "timestamp": "02:22:58", "text": "他们做了，我做了，呃，N5，呃，JLPT N5，学习过"}]
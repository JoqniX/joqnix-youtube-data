[{"type": "subtitle", "time": 4320.87, "timestamp": "01:12:00", "text": "这更难。如果我只能点赞就好了"}, {"type": "subtitle", "time": 4323.75, "timestamp": "01:12:03", "text": "对某人或类似聊天和触发"}, {"type": "subtitle", "time": 4327.51, "timestamp": "01:12:07", "text": "给那个人的消息命令。"}, {"type": "subtitle", "time": 4329.75, "timestamp": "01:12:09", "text": "那样会更好。但我没有"}, {"type": "subtitle", "time": 4332.709, "timestamp": "01:12:12", "text": "知道该怎么做。"}, {"type": "subtitle", "time": 4335.189, "timestamp": "01:12:15", "text": "是否可以？我认为这是有可能的。"}, {"type": "subtitle", "time": 4340.29, "timestamp": "01:12:20", "text": "呃"}, {"type": "subtitle", "time": 4343.27, "timestamp": "01:12:23", "text": "[音乐]"}, {"type": "subtitle", "time": 4344.95, "timestamp": "01:12:24", "text": "的"}, {"type": "subtitle", "time": 4350.47, "timestamp": "01:12:30", "text": "通讯。"}, {"type": "subtitle", "time": 4352.55, "timestamp": "01:12:32", "text": "好了，我们差不多回答完这个问题了。"}, {"type": "subtitle", "time": 4363.11, "timestamp": "01:12:43", "text": "呃，我们需要切换到主题一。"}, {"type": "subtitle", "time": 4365.35, "timestamp": "01:12:45", "text": "因为我当时正在写第二部分"}, {"type": "subtitle", "time": 4367.75, "timestamp": "01:12:47", "text": "一直以来都是这样。"}, {"type": "subtitle", "time": 4370.87, "timestamp": "01:12:50", "text": "我们需要切换到第二个主题。等待，"}, {"type": "subtitle", "time": 4375.27, "timestamp": "01:12:55", "text": "主题一。是的。身份。"}, {"type": "subtitle", "time": 4378.47, "timestamp": "01:12:58", "text": "和菜肴"}]
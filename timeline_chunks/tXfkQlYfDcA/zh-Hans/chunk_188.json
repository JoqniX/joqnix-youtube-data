[{"type": "subtitle", "time": 11280.07, "timestamp": "03:08:00", "text": "展示自己，好像成为另一个人也没什么不好"}, {"type": "subtitle", "time": 11282.87, "timestamp": "03:08:02", "text": "艺术家音乐艺术家，并上传"}, {"type": "subtitle", "time": 11285.429, "timestamp": "03:08:05", "text": "YouTuber 相关内容等等"}, {"type": "subtitle", "time": 11287.99, "timestamp": "03:08:07", "text": "在 YouTube 上。绝对地。还有 YouTube"}, {"type": "subtitle", "time": 11292.63, "timestamp": "03:08:12", "text": "添加了发布选项卡，这使得它变得如此重要。"}, {"type": "subtitle", "time": 11294.63, "timestamp": "03:08:14", "text": "这样更容易，而且短裤"}, {"type": "subtitle", "time": 11298.07, "timestamp": "03:08:18", "text": "也包括 Tab 键。所以，是的，我总是可以"}, {"type": "subtitle", "time": 11299.59, "timestamp": "03:08:19", "text": "播放音乐。它将包含在发布版本中。"}, {"type": "subtitle", "time": 11301.75, "timestamp": "03:08:21", "text": "标签。视频将在“视频”标签页中。"}, {"type": "subtitle", "time": 11304.15, "timestamp": "03:08:24", "text": "直播将照常进行。短裤会很短"}, {"type": "subtitle", "time": 11307.349, "timestamp": "03:08:27", "text": "有条理的。正确的。正确的。正确的。是的。"}, {"type": "subtitle", "time": 11309.03, "timestamp": "03:08:29", "text": "它既不杂乱也不令人困惑"}, {"type": "subtitle", "time": 11310.87, "timestamp": "03:08:30", "text": "有人喜欢来你的频道吗？"}, {"type": "subtitle", "time": 11312.87, "timestamp": "03:08:32", "text": "就像第一次一样。他们喜欢说：“哦，"}, {"type": "subtitle", "time": 11315.349, "timestamp": "03:08:35", "text": "好的。好了，乔，别闹了。你是"}, {"type": "subtitle", "time": 11323.99, "timestamp": "03:08:43", "text": "是的。哦，那太酷了。"}, {"type": "subtitle", "time": 11326.79, "timestamp": "03:08:46", "text": "我当时也是这么想的。就是这样。"}, {"type": "subtitle", "time": 11329.269, "timestamp": "03:08:49", "text": "为什么一开始我会想，“是的，因为"}, {"type": "subtitle", "time": 11331.91, "timestamp": "03:08:51", "text": "乔安娜，我想要的是音乐徽章，而不是……"}, {"type": "subtitle", "time": 11335.269, "timestamp": "03:08:55", "text": "“已验证的 YouTube 徽章。”"}, {"type": "subtitle", "time": 11338.469, "timestamp": "03:08:58", "text": "好的。好的。太可爱了。我喜欢"}]
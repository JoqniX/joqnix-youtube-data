[{"type": "subtitle", "time": 9002.71, "timestamp": "02:30:02", "text": "把你的其他卡之类的东西也给我。"}, {"type": "subtitle", "time": 9006.71, "timestamp": "02:30:06", "text": "哦，哇。但是，但是我犯了个错误。呃，"}, {"type": "subtitle", "time": 9009.59, "timestamp": "02:30:09", "text": "因为哦，不。我要去日本。我"}, {"type": "subtitle", "time": 9012.15, "timestamp": "02:30:12", "text": "我之前竟然不知道这件事。我做了"}, {"type": "subtitle", "time": 9016.15, "timestamp": "02:30:16", "text": "它大概持续了两年左右。所以，我给了"}, {"type": "subtitle", "time": 9017.99, "timestamp": "02:30:17", "text": "我的另一辆车。现在，我应该已经给了"}, {"type": "subtitle", "time": 9020.309, "timestamp": "02:30:20", "text": "实际上，我的护照，因为我要去……"}, {"type": "subtitle", "time": 9023.51, "timestamp": "02:30:23", "text": "日本之类的。呃，如果我住在那里的话"}, {"type": "subtitle", "time": 9025.51, "timestamp": "02:30:25", "text": "东西，我的其他卡之类的东西会是"}, {"type": "subtitle", "time": 9027.83, "timestamp": "02:30:27", "text": "走了，对吧？"}, {"type": "subtitle", "time": 9030.309, "timestamp": "02:30:30", "text": "哦，是的。"}, {"type": "subtitle", "time": 9032.389, "timestamp": "02:30:32", "text": "我有两个频道。卡仅"}, {"type": "subtitle", "time": 9034.55, "timestamp": "02:30:34", "text": "喜欢的话就点赞吧，切换"}, {"type": "subtitle", "time": 9037.59, "timestamp": "02:30:37", "text": "公民身份，对吧？是吗？我不是"}, {"type": "subtitle", "time": 9040.55, "timestamp": "02:30:40", "text": "当然。我觉得是这样，因为我仍然"}, {"type": "subtitle", "time": 9042.63, "timestamp": "02:30:42", "text": "我还有另一张卡，但是就像……"}, {"type": "subtitle", "time": 9045.03, "timestamp": "02:30:45", "text": "显然喜欢住在这里。嗯，我没有"}, {"type": "subtitle", "time": 9046.23, "timestamp": "02:30:46", "text": "我觉得这像是个问题。我不"}, {"type": "subtitle", "time": 9047.83, "timestamp": "02:30:47", "text": "我觉得你必须把它扔掉。"}, {"type": "subtitle", "time": 9050.95, "timestamp": "02:30:50", "text": "毫米-毫米。只有当你服用时才会这样。"}, {"type": "subtitle", "time": 9053.349, "timestamp": "02:30:53", "text": "嗯，那里的公民身份，就像你一样。"}, {"type": "subtitle", "time": 9055.51, "timestamp": "02:30:55", "text": "我知道你正在移除你像印度人一样的东西"}, {"type": "subtitle", "time": 9058.07, "timestamp": "02:30:58", "text": "完全赞同公民身份。那是"}]
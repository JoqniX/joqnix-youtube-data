[{"type": "subtitle", "time": 2053.51, "timestamp": "00:34:13", "text": "但是，老兄，"}, {"type": "subtitle", "time": 2057.27, "timestamp": "00:34:17", "text": "这是 699K 吗？我的天啊。 70万。是的。"}, {"type": "subtitle", "time": 2059.75, "timestamp": "00:34:19", "text": "再见。"}, {"type": "subtitle", "time": 2062.869, "timestamp": "00:34:22", "text": "我以前会查看我的私人账号。这"}, {"type": "subtitle", "time": 2064.55, "timestamp": "00:34:24", "text": "这是我的一个玩笑账号，对吧？我没有。"}, {"type": "subtitle", "time": 2068.31, "timestamp": "00:34:28", "text": "虽然没有订阅她的频道，但仍然"}, {"type": "subtitle", "time": 2072.069, "timestamp": "00:34:32", "text": "我以前，呃，我知道，我以前经常看她。"}, {"type": "subtitle", "time": 2079.75, "timestamp": "00:34:39", "text": "我的天啊。"}, {"type": "subtitle", "time": 2081.43, "timestamp": "00:34:41", "text": "我需要继续写作。我不应该"}, {"type": "subtitle", "time": 2082.869, "timestamp": "00:34:42", "text": "继续说。我一直在谈论"}, {"type": "subtitle", "time": 2085.75, "timestamp": "00:34:45", "text": "大约40分钟。我浪费了40分钟。"}, {"type": "subtitle", "time": 2087.829, "timestamp": "00:34:47", "text": "我的天啊。"}, {"type": "subtitle", "time": 2092.629, "timestamp": "00:34:52", "text": "烦我一下。正确的。"}, {"type": "subtitle", "time": 2094.31, "timestamp": "00:34:54", "text": "好的。我要回去。我要回去"}, {"type": "subtitle", "time": 2097.03, "timestamp": "00:34:57", "text": "写作。看来我要挨打了。"}]
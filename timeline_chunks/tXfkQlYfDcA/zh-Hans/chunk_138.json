[{"type": "subtitle", "time": 8281.19, "timestamp": "02:18:01", "text": "我的频道规模比较小，对吧？然后我"}, {"type": "subtitle", "time": 8283.509, "timestamp": "02:18:03", "text": "我意识到我还是会去做这件事。我是"}, {"type": "subtitle", "time": 8287.349, "timestamp": "02:18:07", "text": "我打算表明，呃，我也想……"}, {"type": "subtitle", "time": 8289.19, "timestamp": "02:18:09", "text": "给我自己看看。新模型是"}, {"type": "subtitle", "time": 8291.83, "timestamp": "02:18:11", "text": "非常漂亮，非常高端，而且"}, {"type": "subtitle", "time": 8294.79, "timestamp": "02:18:14", "text": "我想问一下，嗯……它叫什么？证明"}, {"type": "subtitle", "time": 8298.389, "timestamp": "02:18:18", "text": "我自己觉得我值得使用它。哦"}, {"type": "subtitle", "time": 8302.469, "timestamp": "02:18:22", "text": "是的。因为我不想出道后就……"}, {"type": "subtitle", "time": 8304.549, "timestamp": "02:18:24", "text": "这是一次失败。不，是因为我自身的不足。"}, {"type": "subtitle", "time": 8307.75, "timestamp": "02:18:27", "text": "技能。但我希望那个模型"}, {"type": "subtitle", "time": 8309.589, "timestamp": "02:18:29", "text": "真正绽放它应有的光芒"}, {"type": "subtitle", "time": 8311.99, "timestamp": "02:18:31", "text": "值得。所以我就想，是啊，我不会。"}, {"type": "subtitle", "time": 8315.349, "timestamp": "02:18:35", "text": "做这一切只是为了得到那个"}, {"type": "subtitle", "time": 8317.83, "timestamp": "02:18:37", "text": "那里有更多爱"}, {"type": "subtitle", "time": 8320.709, "timestamp": "02:18:40", "text": "是的"}, {"type": "subtitle", "time": 8323.75, "timestamp": "02:18:43", "text": "而且，由于我最初的计划是……"}, {"type": "subtitle", "time": 8327.429, "timestamp": "02:18:47", "text": "下周结束这场马拉松比赛吧？"}, {"type": "subtitle", "time": 8329.99, "timestamp": "02:18:49", "text": "我当时想，既然没能联系上贾尔，我"}, {"type": "subtitle", "time": 8332.469, "timestamp": "02:18:52", "text": "当时的想法是：还好，至少我得到了……"}, {"type": "subtitle", "time": 8334.709, "timestamp": "02:18:54", "text": "美好的回忆，而且我还能和大家聊天。"}, {"type": "subtitle", "time": 8337.27, "timestamp": "02:18:57", "text": "我做了很多我以前害怕的新事情。"}]
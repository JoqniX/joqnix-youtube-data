[{"type": "subtitle", "time": 4920.79, "timestamp": "01:22:00", "text": "[音乐]"}, {"type": "subtitle", "time": 4923.99, "timestamp": "01:22:03", "text": "应该是这样，我的意思是，这是我的喜欢"}, {"type": "subtitle", "time": 4926.07, "timestamp": "01:22:06", "text": "这是我第一次来这里，呃，两年了。"}, {"type": "subtitle", "time": 4928.47, "timestamp": "01:22:08", "text": "几个月来我一直在吃一种体质。"}, {"type": "subtitle", "time": 4930.229, "timestamp": "01:22:10", "text": "比如印度薄饼之类的。我不知道那是什么"}, {"type": "subtitle", "time": 4932.55, "timestamp": "01:22:12", "text": "它又打来了电话。这是印度薄饼吗？我不"}, {"type": "subtitle", "time": 4935.75, "timestamp": "01:22:15", "text": "知道。让我看看包装。"}, {"type": "subtitle", "time": 4943.43, "timestamp": "01:22:23", "text": "两个月来的第一次。"}, {"type": "subtitle", "time": 4953.35, "timestamp": "01:22:33", "text": "[音乐]"}]
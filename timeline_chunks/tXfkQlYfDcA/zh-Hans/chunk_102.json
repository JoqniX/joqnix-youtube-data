[{"type": "subtitle", "time": 6122.07, "timestamp": "01:42:02", "text": "请告诉我也要录下来。请"}, {"type": "subtitle", "time": 6123.95, "timestamp": "01:42:03", "text": "求求你了。"}, {"type": "subtitle", "time": 6126.79, "timestamp": "01:42:06", "text": "[音乐]"}, {"type": "subtitle", "time": 6130.629, "timestamp": "01:42:10", "text": "不，我们没收到。不，等等。我们做到了"}, {"type": "subtitle", "time": 6132.79, "timestamp": "01:42:12", "text": "得到它。好的，你这个音效板。好的，我"}, {"type": "subtitle", "time": 6135.75, "timestamp": "01:42:15", "text": "已获得成员许可。好的，走吧。"}, {"type": "subtitle", "time": 6141.43, "timestamp": "01:42:21", "text": "我们走吧。好的，好的，好的。你听起来"}, {"type": "subtitle", "time": 6143.03, "timestamp": "01:42:23", "text": "等待"}, {"type": "subtitle", "time": 6146.79, "timestamp": "01:42:26", "text": "表情符号贴纸。所以我们没有得到呃"}, {"type": "subtitle", "time": 6149.91, "timestamp": "01:42:29", "text": "这个东西。让我加入聊天。让我"}, {"type": "subtitle", "time": 6154.07, "timestamp": "01:42:34", "text": "加入普通的VC频道。"}, {"type": "subtitle", "time": 6157.03, "timestamp": "01:42:37", "text": "我没有获得许可。"}, {"type": "subtitle", "time": 6161.109, "timestamp": "01:42:41", "text": "我有 Jocknix，对吧？是的。这东西"}, {"type": "subtitle", "time": 6164.229, "timestamp": "01:42:44", "text": "拥有该权限。"}, {"type": "subtitle", "time": 6166.629, "timestamp": "01:42:46", "text": "但这两者之间有什么区别呢？"}, {"type": "subtitle", "time": 6169.03, "timestamp": "01:42:49", "text": "我没有收到任何弹出窗口提示。"}, {"type": "subtitle", "time": 6171.75, "timestamp": "01:42:51", "text": "音板现在可以使用音板了"}, {"type": "subtitle", "time": 6175.83, "timestamp": "01:42:55", "text": "或者说，这是祖基的什么地方？"}]
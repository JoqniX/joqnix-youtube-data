[{"type": "subtitle", "time": 14762.469, "timestamp": "04:06:02", "text": "uh 网站建设工具开放交易。所以就像"}, {"type": "subtitle", "time": 14766.389, "timestamp": "04:06:06", "text": "无需代码即可搭建网站。所以，呃，我做了"}, {"type": "subtitle", "time": 14770.07, "timestamp": "04:06:10", "text": "我把它做成这样，让它看起来像"}, {"type": "subtitle", "time": 14772.71, "timestamp": "04:06:12", "text": "所有直播流的汇总信息。所以它会"}, {"type": "subtitle", "time": 14774.71, "timestamp": "04:06:14", "text": "有流媒体。"}, {"type": "subtitle", "time": 14776.55, "timestamp": "04:06:16", "text": "是的。就像你可能见过的那种新的"}, {"type": "subtitle", "time": 14778.79, "timestamp": "04:06:18", "text": "就像某些网站上那样，他们会有"}, {"type": "subtitle", "time": 14781.349, "timestamp": "04:06:21", "text": "一系列物品，对吧？点赞新闻"}, {"type": "subtitle", "time": 14784.55, "timestamp": "04:06:24", "text": "类似新闻之类的东西。它就像旋转木马一样，或者"}, {"type": "subtitle", "time": 14785.99, "timestamp": "04:06:25", "text": "某物。你可以滚动浏览等等，"}, {"type": "subtitle", "time": 14788.229, "timestamp": "04:06:28", "text": "正确的？是的。是的。是的。就是这样。我"}, {"type": "subtitle", "time": 14790.15, "timestamp": "04:06:30", "text": "使其显示 YouTube"}, {"type": "subtitle", "time": 14792.55, "timestamp": "04:06:32", "text": "缩略图、YouTube 标题和日期"}, {"type": "subtitle", "time": 14795.83, "timestamp": "04:06:35", "text": "直播流以及它的类别是什么？"}, {"type": "subtitle", "time": 14797.91, "timestamp": "04:06:37", "text": "一切。你点击它，就会得到"}, {"type": "subtitle", "time": 14800.79, "timestamp": "04:06:40", "text": "所有事物的时间戳。所以我做了"}, {"type": "subtitle", "time": 14803.91, "timestamp": "04:06:43", "text": "就像双向时间戳系统一样。所以一个"}, {"type": "subtitle", "time": 14806.71, "timestamp": "04:06:46", "text": "就像自动的一样。所以每一幕我"}, {"type": "subtitle", "time": 14810.71, "timestamp": "04:06:50", "text": "每次切换，所以我取消静音并显示。"}, {"type": "subtitle", "time": 14813.59, "timestamp": "04:06:53", "text": "藏好一切，或者万一我泄露了什么"}, {"type": "subtitle", "time": 14816.07, "timestamp": "04:06:56", "text": "模糊紧急模糊是指"}, {"type": "subtitle", "time": 14818.15, "timestamp": "04:06:58", "text": "那些东西我以后有时间处理。"}]
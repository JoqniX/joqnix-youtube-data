[{"type": "subtitle", "time": 15005.91, "timestamp": "04:10:05", "text": "我了解到海關這種東西了"}, {"type": "subtitle", "time": 15007.83, "timestamp": "04:10:07", "text": "。"}, {"type": "subtitle", "time": 15017.11, "timestamp": "04:10:17", "text": "我的天哪。哦不"}, {"type": "subtitle", "time": 15019.59, "timestamp": "04:10:19", "text": "，我不知道。我買的 Stream Deck Pal 大概是 9000 左右。  大概9000左右。嗯，是的。是的。  差不多"}, {"type": "subtitle", "time": 15021.429, "timestamp": "04:10:21", "text": "那麼多。大概9000左右。  大約 10,000 盧比。還有，"}, {"type": "subtitle", "time": 15023.75, "timestamp": "04:10:23", "text": "我得繳6000元的關稅。  什麼？是的。 6. 那幾乎就是它的價格了。是的"}, {"type": "subtitle", "time": 15027.03, "timestamp": "04:10:27", "text": "。太瘋狂了。  我苦苦"}, {"type": "subtitle", "time": 15029.349, "timestamp": "04:10:29", "text": "哀求爸爸。他當時說：「這東西有什麼用？"}, {"type": "subtitle", "time": 15034.469, "timestamp": "04:10:34", "text": "你不需要它。我們也不會給你錢。"}, {"type": "subtitle", "time": 15039.99, "timestamp": "04:10:39", "text": "」我哭著哀求。我苦苦哀求。最後他把錢給了我，我可以去收錢了。哦"}]
[{"type": "subtitle", "time": 26314.948, "timestamp": "07:18:34", "text": "我有足夠的時間準備"}, {"type": "subtitle", "time": 26316.788, "timestamp": "07:18:36", "text": "。下個月我要開始上四個等級的日文課了。"}, {"type": "subtitle", "time": 26318.788, "timestamp": "07:18:38", "text": "所以我會很忙。晚上我還會"}, {"type": "subtitle", "time": 26333.19, "timestamp": "07:18:53", "text": "我會……我會……我會……嗯……我會……嗯……我會……嗯……我會……該怎麼說呢？"}]
[{"type": "subtitle", "time": 4920.79, "timestamp": "01:22:00", "text": "[音樂] 我們呃看到我屁股也不哦上帝。我會有空間嗎？我會在同一時間回來。  接下來該如何處理已售出的身份資訊呢？之後"}, {"type": "subtitle", "time": 4928.47, "timestamp": "01:22:08", "text": "我會吃早餐、洗手，然後，好的，我們先從主題一開始。"}, {"type": "subtitle", "time": 4930.229, "timestamp": "01:22:10", "text": "什麼"}, {"type": "subtitle", "time": 4932.55, "timestamp": "01:22:12", "text": "問題？  [音樂] 是的，同意。  你有什麼想法？你對"}, {"type": "subtitle", "time": 4935.75, "timestamp": "01:22:15", "text": "染髮有什麼看法？頭髮染色。請定義頭髮染色。您指的是藝術作品中的頭髮著色，"}]
[{"type": "subtitle", "time": 14.87, "timestamp": "00:00:14", "text": "大家好，我們又回來了。"}, {"type": "subtitle", "time": 17.67, "timestamp": "00:00:17", "text": "歡迎來到 Joadon 第 92 天第二部分"}, {"type": "subtitle", "time": 20.55, "timestamp": "00:00:20", "text": "直播。下一位嘉賓是"}, {"type": "subtitle", "time": 25.509, "timestamp": "00:00:25", "text": "蘇安·蘇丹·山。嗯，客人還沒"}, {"type": "subtitle", "time": 28.07, "timestamp": "00:00:28", "text": "準備好。所以我正在等客人"}, {"type": "subtitle", "time": 30.87, "timestamp": "00:00:30", "text": "出現，或是客人"}, {"type": "subtitle", "time": 33.43, "timestamp": "00:00:33", "text": "當天沒空也沒關係。我們"}, {"type": "chat", "time": 35.314, "timestamp": "00:00:35", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "Yoooo"}, {"type": "subtitle", "time": 37.11, "timestamp": "00:00:37", "text": "可以隨時重新安排時間，但"}, {"type": "subtitle", "time": 39.67, "timestamp": "00:00:39", "text": "晚上10點前都可以。我們"}, {"type": "subtitle", "time": 43.59, "timestamp": "00:00:43", "text": "和 Daddy Do Palms 有合作，"}, {"type": "subtitle", "time": 45.51, "timestamp": "00:00:45", "text": "我很期待。這是"}, {"type": "subtitle", "time": 48.709, "timestamp": "00:00:48", "text": "我們第一次見面。是的。所以，讓我們"}, {"type": "subtitle", "time": 51.43, "timestamp": "00:00:51", "text": "祈禱客人早晚都能出現"}, {"type": "subtitle", "time": 54.229, "timestamp": "00:00:54", "text": "。是的，我會等。我"}, {"type": "subtitle", "time": 56.79, "timestamp": "00:00:56", "text": "去小便，辦完事就回來"}]
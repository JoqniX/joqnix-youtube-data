[{"type": "subtitle", "time": 20948.788, "timestamp": "05:49:08", "text": "、用戶發送訊息的連結"}, {"type": "subtitle", "time": 20951.19, "timestamp": "05:49:11", "text": "以及所有詳細資訊。好的。 Twitch 也"}, {"type": "subtitle", "time": 20954.15, "timestamp": "05:49:14", "text": "需要這個功能。  Twitch 上也有類似的功能，"}, {"type": "subtitle", "time": 20959.27, "timestamp": "05:49:19", "text": "我做了一些改進。"}, {"type": "subtitle", "time": 20969.67, "timestamp": "05:49:29", "text": "所以，嗯，用戶名、頭像、訊息、頻道連結、聊天記錄以及訊息發布日期。"}, {"type": "subtitle", "time": 20983.51, "timestamp": "05:49:43", "text": "我最新添置的，呃，是為了比利比利。 Billy Billy是我直播使用的一個中國平台。  目前，我無法存取白名單，因為我之前簽約的、幫我辦理"}, {"type": "subtitle", "time": 20991.75, "timestamp": "05:49:51", "text": "白名單的公司已經解散了"}, {"type": "subtitle", "time": 20994.788, "timestamp": "05:49:54", "text": "。所以我一直在尋找方法。是的，看起來一樣。我可以"}, {"type": "subtitle", "time": 20998.07, "timestamp": "05:49:58", "text": "輸入使用者名稱、個人資料、"}]
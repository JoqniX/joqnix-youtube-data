[{"type": "subtitle", "time": 4920.79, "timestamp": "01:22:00", "text": "[音楽]"}, {"type": "subtitle", "time": 4923.99, "timestamp": "01:22:03", "text": "本来はこうあるべきなんだ、つまりそれは私の"}, {"type": "subtitle", "time": 4926.07, "timestamp": "01:22:06", "text": "これは私が2回行った初めてのことです"}, {"type": "subtitle", "time": 4928.47, "timestamp": "01:22:08", "text": "数ヶ月間、私はドーシャを食べています"}, {"type": "subtitle", "time": 4930.229, "timestamp": "01:22:10", "text": "ドーサとか、そんな感じの料理。何が"}, {"type": "subtitle", "time": 4932.55, "timestamp": "01:22:12", "text": "また電話がかかってきた。これはドーサですか？私はしません"}, {"type": "subtitle", "time": 4935.75, "timestamp": "01:22:15", "text": "知る。パッケージを見せてください。"}, {"type": "subtitle", "time": 4943.43, "timestamp": "01:22:23", "text": "2ヶ月ぶり。"}, {"type": "subtitle", "time": 4953.35, "timestamp": "01:22:33", "text": "[音楽]"}]
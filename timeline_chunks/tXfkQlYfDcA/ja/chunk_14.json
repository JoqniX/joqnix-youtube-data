[{"type": "subtitle", "time": 840.31, "timestamp": "00:14:00", "text": "RAMをもう少し増やそう。私は既に16GBのRAMを搭載しています"}, {"type": "subtitle", "time": 843.269, "timestamp": "00:14:03", "text": "また。おはようございます、アレクサン。"}, {"type": "subtitle", "time": 845.67, "timestamp": "00:14:05", "text": "おはよう。おはよう。"}, {"type": "subtitle", "time": 848.31, "timestamp": "00:14:08", "text": "お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 859.99, "timestamp": "00:14:19", "text": "でも、すぐに"}, {"type": "subtitle", "time": 861.829, "timestamp": "00:14:21", "text": "4時に起きるはずだった"}, {"type": "subtitle", "time": 864.629, "timestamp": "00:14:24", "text": "何かを置いて、それを置いたり、置いたりする"}, {"type": "subtitle", "time": 866.47, "timestamp": "00:14:26", "text": "昨日の単語をダウンロード用にアップロードしました"}, {"type": "subtitle", "time": 869.59, "timestamp": "00:14:29", "text": "そして眠りに落ちたが、眠ったことを忘れていた"}, {"type": "subtitle", "time": 873.75, "timestamp": "00:14:33", "text": "やめろよ。私のミスです。"}, {"type": "subtitle", "time": 875.829, "timestamp": "00:14:35", "text": "私が本当に必要なことでしょうか"}, {"type": "subtitle", "time": 877.91, "timestamp": "00:14:37", "text": "最新バージョンをダウンロードしますか？いいえ、そうです"}, {"type": "subtitle", "time": 879.94, "timestamp": "00:14:39", "text": "ない。しかし"}, {"type": "subtitle", "time": 881.829, "timestamp": "00:14:41", "text": "[音楽]"}, {"type": "subtitle", "time": 884.31, "timestamp": "00:14:44", "text": "待って、3.6.11、"}, {"type": "subtitle", "time": 887.829, "timestamp": "00:14:47", "text": "右？先月ダウンロードしなかったっけ？"}, {"type": "subtitle", "time": 891.509, "timestamp": "00:14:51", "text": "私はしませんでした。これは1月38日に発売されました。"}, {"type": "subtitle", "time": 895.03, "timestamp": "00:14:55", "text": "ああ、そうじゃなかったよ。それが理由です。"}, {"type": "subtitle", "time": 896.31, "timestamp": "00:14:56", "text": "[音楽]"}]
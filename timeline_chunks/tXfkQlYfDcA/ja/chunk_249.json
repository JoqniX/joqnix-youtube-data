[{"type": "subtitle", "time": 14940.229, "timestamp": "04:09:00", "text": "そういうことに陥るのはとても簡単です。"}, {"type": "subtitle", "time": 14942.07, "timestamp": "04:09:02", "text": "私はこれで構いません。ちょっと待ってください"}, {"type": "subtitle", "time": 14943.59, "timestamp": "04:09:03", "text": "このルーティンを守りましょう。そのままにして"}, {"type": "subtitle", "time": 14945.189, "timestamp": "04:09:05", "text": "これで。だってそれが私が捕まえるものだから"}, {"type": "subtitle", "time": 14947.03, "timestamp": "04:09:07", "text": "私自身が時々やっていること"}, {"type": "subtitle", "time": 14949.269, "timestamp": "04:09:09", "text": "うん、私はこれで安心している"}, {"type": "subtitle", "time": 14951.91, "timestamp": "04:09:11", "text": "これらの一連の、えーと、やるべきこと"}, {"type": "subtitle", "time": 14955.11, "timestamp": "04:09:15", "text": "えーっと、引き換えとかそういうののセットで、私は"}, {"type": "subtitle", "time": 14956.71, "timestamp": "04:09:16", "text": "物事を変えるのが好きではなかった私は"}, {"type": "subtitle", "time": 14959.99, "timestamp": "04:09:19", "text": "たぶん、たぶん人々は、"}, {"type": "subtitle", "time": 14961.59, "timestamp": "04:09:21", "text": "退屈して、"}, {"type": "subtitle", "time": 14963.44, "timestamp": "04:09:23", "text": "何か新しいもの"}, {"type": "subtitle", "time": 14965.83, "timestamp": "04:09:25", "text": "[音楽]"}, {"type": "subtitle", "time": 14967.83, "timestamp": "04:09:27", "text": "ああ、これは、えっと、これはあなたが"}, {"type": "subtitle", "time": 14969.67, "timestamp": "04:09:29", "text": "何をしているの？うん。うん。私がやったことはこうです"}, {"type": "subtitle", "time": 14976.87, "timestamp": "04:09:36", "text": "ああ、読み込み中です。ええ、"}, {"type": "subtitle", "time": 14979.75, "timestamp": "04:09:39", "text": "だって、それは動きだからですよね？うん。"}, {"type": "subtitle", "time": 14981.83, "timestamp": "04:09:41", "text": "おお、いいね。"}, {"type": "subtitle", "time": 14983.99, "timestamp": "04:09:43", "text": "YouTubeからサムネイルを取得し、"}, {"type": "subtitle", "time": 14986.389, "timestamp": "04:09:46", "text": "私がしたこと。これは私がしなければならないことです"}, {"type": "subtitle", "time": 14989.03, "timestamp": "04:09:49", "text": "手動で書いてください。同じことだ。同じ"}, {"type": "subtitle", "time": 14991.67, "timestamp": "04:09:51", "text": "ツイッターで話題になる。詳細は"}, {"type": "subtitle", "time": 14994.389, "timestamp": "04:09:54", "text": "終わった。ビリービリー、ストリームを見て"}, {"type": "subtitle", "time": 14997.11, "timestamp": "04:09:57", "text": "あれとタイムスタンプ"}, {"type": "subtitle", "time": 14999.189, "timestamp": "04:09:59", "text": "そして、そう、あなたがそれを変えたとき"}]
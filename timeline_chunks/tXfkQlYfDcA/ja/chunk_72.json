[{"type": "subtitle", "time": 4320.87, "timestamp": "01:12:00", "text": "より困難だ。クリックするだけで"}, {"type": "subtitle", "time": 4323.75, "timestamp": "01:12:03", "text": "人物に対して、またはチャットのようにトリガーする"}, {"type": "subtitle", "time": 4327.51, "timestamp": "01:12:07", "text": "その人物へのメッセージに対するコマンド。"}, {"type": "subtitle", "time": 4329.75, "timestamp": "01:12:09", "text": "そっちの方がずっと良いでしょう。でも私はそうは思わない"}, {"type": "subtitle", "time": 4332.709, "timestamp": "01:12:12", "text": "その方法を知っている。"}, {"type": "subtitle", "time": 4335.189, "timestamp": "01:12:15", "text": "出来ますか？可能だと思う"}, {"type": "subtitle", "time": 4340.29, "timestamp": "01:12:20", "text": "えーと"}, {"type": "subtitle", "time": 4343.27, "timestamp": "01:12:23", "text": "[音楽]"}, {"type": "subtitle", "time": 4344.95, "timestamp": "01:12:24", "text": "の"}, {"type": "subtitle", "time": 4350.47, "timestamp": "01:12:30", "text": "通信"}, {"type": "subtitle", "time": 4352.55, "timestamp": "01:12:32", "text": "さて、質問はもうすぐ終わりです。"}, {"type": "subtitle", "time": 4363.11, "timestamp": "01:12:43", "text": "えーと、主題1に切り替える必要があります"}, {"type": "subtitle", "time": 4365.35, "timestamp": "01:12:45", "text": "なぜなら私は2番目の科目を書いていたからです"}, {"type": "subtitle", "time": 4367.75, "timestamp": "01:12:47", "text": "ずっとこの間ずっと。"}, {"type": "subtitle", "time": 4370.87, "timestamp": "01:12:50", "text": "2つ目のテーマに切り替える必要があります。待って、"}, {"type": "subtitle", "time": 4375.27, "timestamp": "01:12:55", "text": "被験者１。うん。身元。"}, {"type": "subtitle", "time": 4378.47, "timestamp": "01:12:58", "text": "そして料理"}]
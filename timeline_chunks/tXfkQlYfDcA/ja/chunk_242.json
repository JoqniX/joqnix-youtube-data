[{"type": "subtitle", "time": 14521.189, "timestamp": "04:02:01", "text": "「ええ、なぜそんなことをするんですか、なぜそんなことをするんですか」"}, {"type": "subtitle", "time": 14523.75, "timestamp": "04:02:03", "text": "シャットダウンしたPCの名前変更？"}, {"type": "subtitle", "time": 14525.75, "timestamp": "04:02:05", "text": "真剣に、もしあなたが働いていたらどうする？"}, {"type": "subtitle", "time": 14527.429, "timestamp": "04:02:07", "text": "何かについて話しているのですが、それはただ「ああ、"}, {"type": "subtitle", "time": 14529.99, "timestamp": "04:02:09", "text": "どうでも。 「ほら、行くよ。」私はこう言った。"}, {"type": "subtitle", "time": 14533.11, "timestamp": "04:02:13", "text": "確認同意システム。まるで"}, {"type": "subtitle", "time": 14536.07, "timestamp": "04:02:16", "text": "誰かがそれを引き換えたとしたら、そして"}, {"type": "subtitle", "time": 14538.229, "timestamp": "04:02:18", "text": "「はい、保存する必要があります」のようなメッセージ"}, {"type": "subtitle", "time": 14541.03, "timestamp": "04:02:21", "text": "入力した内容を確認したら、はいまたはいいえを押してください。"}, {"type": "subtitle", "time": 14543.349, "timestamp": "04:02:23", "text": "答えがイエスなら、シャットダウンします。それは"}, {"type": "subtitle", "time": 14544.95, "timestamp": "04:02:24", "text": "数秒後にシャットダウンを開始する"}, {"type": "subtitle", "time": 14547.59, "timestamp": "04:02:27", "text": "分。いいえ、それが相殺するなら"}, {"type": "subtitle", "time": 14551.189, "timestamp": "04:02:31", "text": "何かを引き換えて、その人に返金する。"}, {"type": "subtitle", "time": 14555.51, "timestamp": "04:02:35", "text": "右。右。何てことだ。まるでそんな感じ"}, {"type": "subtitle", "time": 14558.389, "timestamp": "04:02:38", "text": "過激。"}, {"type": "subtitle", "time": 14560.07, "timestamp": "04:02:40", "text": "私が見たもののように、"}, {"type": "subtitle", "time": 14562.229, "timestamp": "04:02:42", "text": "まるで下流の供給を停止するようなものだ。それはまるで"}, {"type": "subtitle", "time": 14564.229, "timestamp": "04:02:44", "text": "ああ、もしあなたが百万ドル持っているなら"}, {"type": "subtitle", "time": 14566.87, "timestamp": "04:02:46", "text": "下流で停止できるポイント。でも私は"}, {"type": "subtitle", "time": 14569.03, "timestamp": "04:02:49", "text": "あなたがそこまでしてくれたことが好きです。"}, {"type": "subtitle", "time": 14571.03, "timestamp": "04:02:51", "text": "私は「ああ、全部削除してくれ」って感じ"}, {"type": "subtitle", "time": 14573.189, "timestamp": "04:02:53", "text": "システム。"}, {"type": "subtitle", "time": 14575.83, "timestamp": "04:02:55", "text": "誰かのツイッターで見たと思う"}, {"type": "subtitle", "time": 14577.99, "timestamp": "04:02:57", "text": "パソコンのシャットダウン処理をしています。私はこう思った"}]
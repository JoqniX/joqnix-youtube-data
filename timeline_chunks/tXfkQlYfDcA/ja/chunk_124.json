[{"type": "subtitle", "time": 7441.75, "timestamp": "02:04:01", "text": "それでは椅子に座りましょう。わかりました、下に行きます"}, {"type": "subtitle", "time": 7448.95, "timestamp": "02:04:08", "text": "ああ、これは苦戦ですか？"}, {"type": "subtitle", "time": 7451.35, "timestamp": "02:04:11", "text": "ああ、降りて。僕は小柄な男になるよ。 A"}, {"type": "subtitle", "time": 7453.99, "timestamp": "02:04:13", "text": "小さな男の子。はい、彼女は降りていきました。あなたは"}, {"type": "subtitle", "time": 7455.669, "timestamp": "02:04:15", "text": "下。"}, {"type": "subtitle", "time": 7458.31, "timestamp": "02:04:18", "text": "ああ、これで横になれるようになった。はい、なぜなら"}, {"type": "subtitle", "time": 7462.07, "timestamp": "02:04:22", "text": "椅子は部屋の中にあります。"}, {"type": "subtitle", "time": 7464.95, "timestamp": "02:04:24", "text": "まるで小さな男の子の椅子みたいだ。おお"}, {"type": "subtitle", "time": 7467.109, "timestamp": "02:04:27", "text": "我が神よ。"}, {"type": "subtitle", "time": 7468.79, "timestamp": "02:04:28", "text": "こんにちは。"}, {"type": "subtitle", "time": 7472.39, "timestamp": "02:04:32", "text": "私は大丈夫です。"}, {"type": "subtitle", "time": 7474.79, "timestamp": "02:04:34", "text": "書き直してもいいですか？もし私がそうでないなら"}, {"type": "subtitle", "time": 7484.0, "timestamp": "02:04:44", "text": "だって、私はあの光をじっと見つめているだろうから。"}, {"type": "subtitle", "time": 7489.82, "timestamp": "02:04:49", "text": "FDIの犬は苦戦している。"}, {"type": "subtitle", "time": 7497.109, "timestamp": "02:04:57", "text": "[音楽]"}]
[{"type": "subtitle", "time": 2280.069, "timestamp": "00:38:00", "text": "階層化。ああ、それは聞いたことがない"}, {"type": "subtitle", "time": 2282.79, "timestamp": "00:38:02", "text": "その言葉、久しぶりに聞いた。"}, {"type": "subtitle", "time": 2299.67, "timestamp": "00:38:19", "text": "[音楽]"}, {"type": "subtitle", "time": 2301.19, "timestamp": "00:38:21", "text": "スラッシュ"}, {"type": "subtitle", "time": 2304.069, "timestamp": "00:38:24", "text": "キャスト"}, {"type": "subtitle", "time": 2307.109, "timestamp": "00:38:27", "text": "スラッシュクラス"}, {"type": "subtitle", "time": 2321.67, "timestamp": "00:38:41", "text": "あ、待って。すべてを定義する必要があると思います"}, {"type": "subtitle", "time": 2328.79, "timestamp": "00:38:48", "text": "これ"}, {"type": "subtitle", "time": 2331.589, "timestamp": "00:38:51", "text": "有効な。"}, {"type": "subtitle", "time": 2333.829, "timestamp": "00:38:53", "text": "よし。次のページ。"}, {"type": "subtitle", "time": 2336.23, "timestamp": "00:38:56", "text": "これで完了です。"}]
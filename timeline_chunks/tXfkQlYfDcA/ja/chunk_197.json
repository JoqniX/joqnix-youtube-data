[{"type": "subtitle", "time": 11822.55, "timestamp": "03:17:02", "text": "YouTubeやInstagram、またはその他何でも"}, {"type": "subtitle", "time": 11826.389, "timestamp": "03:17:06", "text": "TwitterやTwitch以外で。まるで"}, {"type": "subtitle", "time": 11834.87, "timestamp": "03:17:14", "text": "私はTwitter Xへの投稿を減らしていません。"}, {"type": "subtitle", "time": 11837.03, "timestamp": "03:17:17", "text": "どうしてこんなことができるのか理解できない。どのように"}, {"type": "subtitle", "time": 11839.51, "timestamp": "03:17:19", "text": "君はそんなことするの？"}, {"type": "subtitle", "time": 11843.03, "timestamp": "03:17:23", "text": "わからない。全く見当もつきません。知っている。"}, {"type": "subtitle", "time": 11845.91, "timestamp": "03:17:25", "text": "毎週のように新しい"}, {"type": "subtitle", "time": 11847.99, "timestamp": "03:17:27", "text": "アルゴリズム、そしてあなたは試す必要がある"}, {"type": "subtitle", "time": 11851.03, "timestamp": "03:17:31", "text": "自分で考えてみよう。それは、それはただ"}, {"type": "subtitle", "time": 11852.79, "timestamp": "03:17:32", "text": "アルゴリズムも結局は"}, {"type": "subtitle", "time": 11854.71, "timestamp": "03:17:34", "text": "一貫している必要があるような"}, {"type": "subtitle", "time": 11857.75, "timestamp": "03:17:37", "text": "投稿はしているが、あまり一貫性がない。"}, {"type": "subtitle", "time": 11859.19, "timestamp": "03:17:39", "text": "するとTwitterはこう言うだろう"}, {"type": "subtitle", "time": 11862.79, "timestamp": "03:17:42", "text": "ボットって何？何が起こってるの？えっと、でも"}, {"type": "subtitle", "time": 11865.269, "timestamp": "03:17:45", "text": "また、人々が何を望んでいるのかを知ることも好きです。"}, {"type": "subtitle", "time": 11867.99, "timestamp": "03:17:47", "text": "見るのがすごく重要だと思うのは、"}, {"type": "subtitle", "time": 11870.55, "timestamp": "03:17:50", "text": "何度も気づいたのですが"}, {"type": "subtitle", "time": 11872.55, "timestamp": "03:17:52", "text": "もし私がツイートした内容が"}, {"type": "subtitle", "time": 11874.389, "timestamp": "03:17:54", "text": "少し手の届かないところに行ってしまった、私の"}, {"type": "subtitle", "time": 11876.63, "timestamp": "03:17:56", "text": "観客のように、通常は"}, {"type": "subtitle", "time": 11879.19, "timestamp": "03:17:59", "text": "それはとてもばかげたことか、"}]
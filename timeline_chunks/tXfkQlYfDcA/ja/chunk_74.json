[{"type": "subtitle", "time": 4446.07, "timestamp": "01:14:06", "text": "明示的な集合。その言葉を知ってるよ"}, {"type": "subtitle", "time": 4450.709, "timestamp": "01:14:10", "text": "明示的。露骨な。うん。私はただ来ただけです"}, {"type": "subtitle", "time": 4454.39, "timestamp": "01:14:14", "text": "Spotifyとかで知ったんだけど"}, {"type": "subtitle", "time": 4456.149, "timestamp": "01:14:16", "text": "いくつかの曲には、"}, {"type": "subtitle", "time": 4459.669, "timestamp": "01:14:19", "text": "明示的なタグか何か。"}, {"type": "subtitle", "time": 4461.51, "timestamp": "01:14:21", "text": "だから私は「え、これって何？」って思った"}, {"type": "subtitle", "time": 4464.07, "timestamp": "01:14:24", "text": "パック"}, {"type": "subtitle", "time": 4465.75, "timestamp": "01:14:25", "text": "そして私はグーグルで検索したと思う"}, {"type": "subtitle", "time": 4468.31, "timestamp": "01:14:28", "text": "何か忘れてしまった。何を忘れたんだろう？"}, {"type": "subtitle", "time": 4472.31, "timestamp": "01:14:32", "text": "それは一体どういう意味なのか、今となっては"}, {"type": "subtitle", "time": 4474.63, "timestamp": "01:14:34", "text": "ずっと昔のこと"}, {"type": "subtitle", "time": 4476.63, "timestamp": "01:14:36", "text": "うん"}]
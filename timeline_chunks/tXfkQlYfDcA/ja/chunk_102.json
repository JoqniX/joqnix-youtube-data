[{"type": "subtitle", "time": 6122.07, "timestamp": "01:42:02", "text": "それも録音してください。お願いします"}, {"type": "subtitle", "time": 6123.95, "timestamp": "01:42:03", "text": "お願い、お願い。"}, {"type": "subtitle", "time": 6126.79, "timestamp": "01:42:06", "text": "[音楽]"}, {"type": "subtitle", "time": 6130.629, "timestamp": "01:42:10", "text": "いいえ、受け取っていません。いや、待って。私たちは"}, {"type": "subtitle", "time": 6132.79, "timestamp": "01:42:12", "text": "それを得る。よし、君の意見を聞かせてくれ。はい、私は"}, {"type": "subtitle", "time": 6135.75, "timestamp": "01:42:15", "text": "メンバーの許可を得ました。はい、どうぞ。"}, {"type": "subtitle", "time": 6141.43, "timestamp": "01:42:21", "text": "さあ行こう。はい、はい、はい。 H あなたは"}, {"type": "subtitle", "time": 6143.03, "timestamp": "01:42:23", "text": "待って"}, {"type": "subtitle", "time": 6146.79, "timestamp": "01:42:26", "text": "絵文字ステッカー。だから私たちはそれを手に入れなかった"}, {"type": "subtitle", "time": 6149.91, "timestamp": "01:42:29", "text": "これ。テキストに参加させてください。私にさせて"}, {"type": "subtitle", "time": 6154.07, "timestamp": "01:42:34", "text": "通常のビデオ会議チャンネルに参加してください。"}, {"type": "subtitle", "time": 6157.03, "timestamp": "01:42:37", "text": "私には許可がありません。"}, {"type": "subtitle", "time": 6161.109, "timestamp": "01:42:41", "text": "私はJocknixを持っていますよね？うん。この物"}, {"type": "subtitle", "time": 6164.229, "timestamp": "01:42:44", "text": "その許可を得ている。"}, {"type": "subtitle", "time": 6166.629, "timestamp": "01:42:46", "text": "しかし、これと何が違うのでしょうか？"}, {"type": "subtitle", "time": 6169.03, "timestamp": "01:42:49", "text": "ポップアップが表示されなかった"}, {"type": "subtitle", "time": 6171.75, "timestamp": "01:42:51", "text": "サウンドボードは今すぐサウンドボードを使用できます"}, {"type": "subtitle", "time": 6175.83, "timestamp": "01:42:55", "text": "あるいは、これは月でどこかにあったのでしょうか"}]
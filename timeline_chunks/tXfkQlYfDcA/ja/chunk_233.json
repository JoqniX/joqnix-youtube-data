[{"type": "subtitle", "time": 13980.07, "timestamp": "03:53:00", "text": "新しい人と出会い、人が好きになる"}, {"type": "subtitle", "time": 13982.229, "timestamp": "03:53:02", "text": "一緒に。うん。でも、そう、"}, {"type": "subtitle", "time": 13984.229, "timestamp": "03:53:04", "text": "時には、"}, {"type": "subtitle", "time": 13987.91, "timestamp": "03:53:07", "text": "少しの間、自分だけの時間を作りましょう。でも、"}, {"type": "subtitle", "time": 13990.71, "timestamp": "03:53:10", "text": "うん。えっと、あなたは本当に素敵だと思います"}, {"type": "subtitle", "time": 13992.87, "timestamp": "03:53:12", "text": "人々をまとめるスキルと"}, {"type": "subtitle", "time": 13994.79, "timestamp": "03:53:14", "text": "人々に手を差し伸べ、見つける"}, {"type": "subtitle", "time": 13997.51, "timestamp": "03:53:17", "text": "人々。それは、私が思うに、それは"}, {"type": "subtitle", "time": 14000.15, "timestamp": "03:53:20", "text": "作業の90%。新しい人を見つける"}, {"type": "subtitle", "time": 14002.15, "timestamp": "03:53:22", "text": "そして彼らと話したり、雰囲気を確かめたりするのが好きです"}, {"type": "subtitle", "time": 14005.189, "timestamp": "03:53:25", "text": "そういう類のもの。"}, {"type": "subtitle", "time": 14008.95, "timestamp": "03:53:28", "text": "なるほど、なるほど、君はスポーツマンだな。私はそうします"}, {"type": "subtitle", "time": 14012.65, "timestamp": "03:53:32", "text": "あの偽者を叩きのめしてやる。"}, {"type": "subtitle", "time": 14015.03, "timestamp": "03:53:35", "text": "[音楽]"}, {"type": "subtitle", "time": 14024.63, "timestamp": "03:53:44", "text": "ええ、やりたいイベントはたくさんあります。"}, {"type": "subtitle", "time": 14026.79, "timestamp": "03:53:46", "text": "しかし、私がやりたいことの一つは"}, {"type": "subtitle", "time": 14030.15, "timestamp": "03:53:50", "text": "えっと、私はずっと自分の夢を叶えることを夢見ていました"}, {"type": "subtitle", "time": 14032.469, "timestamp": "03:53:52", "text": "自分たちのコンサート企画"}, {"type": "subtitle", "time": 14036.07, "timestamp": "03:53:56", "text": "そして3Dコンサート関連コンテンツ。"}, {"type": "subtitle", "time": 14038.63, "timestamp": "03:53:58", "text": "このストリーマーを知っていますか？"}]
[{"type": "subtitle", "time": 60.549, "timestamp": "00:01:00", "text": "少ししたら戻ります。少し時間をください。わかった。"}, {"type": "subtitle", "time": 63.51, "timestamp": "00:01:03", "text": "それから、vとか色々入れておきますね。他に"}, {"type": "subtitle", "time": 66.95, "timestamp": "00:01:06", "text": "私が少し入れた？だから私はいくつか入れます"}, {"type": "subtitle", "time": 69.51, "timestamp": "00:01:09", "text": "Vとか色々やってみるよ。待っています"}, {"type": "subtitle", "time": 72.07, "timestamp": "00:01:12", "text": "ええと、ゲストが現れたとき。切り替えます"}, {"type": "subtitle", "time": 74.31, "timestamp": "00:01:14", "text": "そして戻ってきてコラボレーションを始めましょう"}, {"type": "subtitle", "time": 77.83, "timestamp": "00:01:17", "text": "あれのことですよね？うん。では、そうしましょう。"}, {"type": "subtitle", "time": 79.429, "timestamp": "00:01:19", "text": "こんにちは。"}, {"type": "subtitle", "time": 82.23, "timestamp": "00:01:22", "text": "じゃあ、また後でね。わかった。"}, {"type": "subtitle", "time": 85.27, "timestamp": "00:01:25", "text": "VODをお楽しみください。私は戻ってきます。私は"}, {"type": "subtitle", "time": 87.91, "timestamp": "00:01:27", "text": "夕食を食べている"}, {"type": "chat", "time": 113.826, "timestamp": "00:01:53", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Joq is Currently taking a break! and will be back soon! do enjoy this past memories till he is back!"}]
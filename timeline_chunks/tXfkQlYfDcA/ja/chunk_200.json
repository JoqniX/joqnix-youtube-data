[{"type": "subtitle", "time": 12000.469, "timestamp": "03:20:00", "text": "うん。つまり、Twitchでは許可されていません"}, {"type": "subtitle", "time": 12003.99, "timestamp": "03:20:03", "text": "おしゃべりが盛りだくさんですよね？右。うんうん。うんうん。 M"}, {"type": "subtitle", "time": 12006.71, "timestamp": "03:20:06", "text": "それで、あの件は"}, {"type": "subtitle", "time": 12008.71, "timestamp": "03:20:08", "text": "マルチストリーミングでは、"}, {"type": "subtitle", "time": 12011.19, "timestamp": "03:20:11", "text": "何も壊さないように配慮する"}, {"type": "subtitle", "time": 12015.429, "timestamp": "03:20:15", "text": "プラットフォームのルールに従って、私が配信を始めてから"}, {"type": "subtitle", "time": 12018.309, "timestamp": "03:20:18", "text": "ビリー・ビリーは非常に制限が多い"}, {"type": "subtitle", "time": 12022.229, "timestamp": "03:20:22", "text": "多くのことについて、グロテスクな描写はありません。"}, {"type": "subtitle", "time": 12025.19, "timestamp": "03:20:25", "text": "どんな種類の物でも、"}, {"type": "subtitle", "time": 12027.59, "timestamp": "03:20:27", "text": "ジョッカソンをやっていて、とても苦労しました"}, {"type": "subtitle", "time": 12030.63, "timestamp": "03:20:30", "text": "そこでたくさんの警告を受けた"}, {"type": "subtitle", "time": 12033.83, "timestamp": "03:20:33", "text": "そしてあちらでは罰則があるから"}, {"type": "subtitle", "time": 12036.229, "timestamp": "03:20:36", "text": "うん。うん。彼らは寝ることを許可していません"}, {"type": "subtitle", "time": 12039.19, "timestamp": "03:20:39", "text": "寝る、ストリームで寝る、そして"}, {"type": "subtitle", "time": 12042.71, "timestamp": "03:20:42", "text": "AFK時間が長すぎると、彼らは"}, {"type": "subtitle", "time": 12046.87, "timestamp": "03:20:46", "text": "あなた以外の誰かに見せることを許可する"}, {"type": "subtitle", "time": 12050.07, "timestamp": "03:20:50", "text": "例えば私がやったことは"}, {"type": "subtitle", "time": 12052.55, "timestamp": "03:20:52", "text": "自分がそれを遅くに知ったことを知っている"}, {"type": "subtitle", "time": 12055.429, "timestamp": "03:20:55", "text": "サバトンとかそういうの、えーっと"}, {"type": "subtitle", "time": 12057.269, "timestamp": "03:20:57", "text": "サバトンとか友達がいる"}, {"type": "subtitle", "time": 12059.11, "timestamp": "03:20:59", "text": "ストリームを乗っ取るとき、あなたは"}]
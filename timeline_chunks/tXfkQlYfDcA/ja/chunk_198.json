[{"type": "subtitle", "time": 11882.07, "timestamp": "03:18:02", "text": "十分に一般的なもの、"}, {"type": "subtitle", "time": 11884.469, "timestamp": "03:18:04", "text": "しかし、多くの人が好むように"}, {"type": "subtitle", "time": 11888.469, "timestamp": "03:18:08", "text": "それを見て。そういうことなんです。えっと、そして"}, {"type": "subtitle", "time": 11891.03, "timestamp": "03:18:11", "text": "知ってるよ、それは"}, {"type": "subtitle", "time": 11892.15, "timestamp": "03:18:12", "text": "人々が話してきたが、"}, {"type": "subtitle", "time": 11894.07, "timestamp": "03:18:14", "text": "リンクなどを入れるのは通常"}, {"type": "subtitle", "time": 11898.229, "timestamp": "03:18:18", "text": "Twitterのように、眉をひそめられる。リンク"}, {"type": "subtitle", "time": 11901.19, "timestamp": "03:18:21", "text": "コメントまたは投稿内のリンク、または"}, {"type": "subtitle", "time": 11904.309, "timestamp": "03:18:24", "text": "ハッシュタグを付けてください。それは、"}, {"type": "subtitle", "time": 11906.79, "timestamp": "03:18:26", "text": "人々はそれを気に入っているが、リーチは好きではない"}, {"type": "subtitle", "time": 11909.429, "timestamp": "03:18:29", "text": "これは本当にクレイジーなことだけど、"}, {"type": "subtitle", "time": 11913.11, "timestamp": "03:18:33", "text": "拡大するために助けが必要なもの"}, {"type": "subtitle", "time": 11914.95, "timestamp": "03:18:34", "text": "視聴者層を広げるが、一部の人にとっては"}, {"type": "subtitle", "time": 11917.83, "timestamp": "03:18:37", "text": "うまくいかない理由。うん。"}, {"type": "subtitle", "time": 11920.469, "timestamp": "03:18:40", "text": "うん。私はまだ理解できていないし、"}, {"type": "subtitle", "time": 11924.07, "timestamp": "03:18:44", "text": "効果がないと分かっていても、それを実行する。その"}, {"type": "subtitle", "time": 11927.269, "timestamp": "03:18:47", "text": "大丈夫。右。右。うん。でも、"}, {"type": "subtitle", "time": 11928.95, "timestamp": "03:18:48", "text": "クロスオスティングのような場合、"}, {"type": "subtitle", "time": 11931.269, "timestamp": "03:18:51", "text": "本当に重要なことですよね？まるで"}, {"type": "subtitle", "time": 11933.03, "timestamp": "03:18:53", "text": "TikTokを始めなきゃいけないって分かってるよね、"}, {"type": "subtitle", "time": 11934.71, "timestamp": "03:18:54", "text": "Instagram を始めなきゃ、"}, {"type": "subtitle", "time": 11936.87, "timestamp": "03:18:56", "text": "YouTubeスターになるには、"}, {"type": "subtitle", "time": 11938.95, "timestamp": "03:18:58", "text": "Twitterを開いて、「オーマイゴッド」って感じ"}]
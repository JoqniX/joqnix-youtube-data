[{"type": "subtitle", "time": 2169.829, "timestamp": "00:36:09", "text": "バックアップを少し。"}, {"type": "subtitle", "time": 2173.43, "timestamp": "00:36:13", "text": "おかえり。こんにちは、戻ってきました。"}, {"type": "subtitle", "time": 2182.39, "timestamp": "00:36:22", "text": "うん、また歓迎されるかもしれないよ"}, {"type": "subtitle", "time": 2184.71, "timestamp": "00:36:24", "text": "再起動されました。"}, {"type": "subtitle", "time": 2187.349, "timestamp": "00:36:27", "text": "サミーに願い事をするためにシフトに入り、すべてがうまくいきました。"}, {"type": "subtitle", "time": 2191.43, "timestamp": "00:36:31", "text": "再起動されたんですよね？"}, {"type": "subtitle", "time": 2194.23, "timestamp": "00:36:34", "text": "さあ、書き始めましょう。"}, {"type": "subtitle", "time": 2196.069, "timestamp": "00:36:36", "text": "いつものように私のストリームは上昇し、"}, {"type": "subtitle", "time": 2200.87, "timestamp": "00:36:40", "text": "下。ストリームはBになるかもしれない。"}, {"type": "subtitle", "time": 2202.71, "timestamp": "00:36:42", "text": "何てことだ。大丈夫です。私はしたくない"}, {"type": "subtitle", "time": 2206.79, "timestamp": "00:36:46", "text": "よく考えてみて。大丈夫です。議論する"}, {"type": "subtitle", "time": 2209.91, "timestamp": "00:36:49", "text": "アイデンティティの社会的基盤。"}, {"type": "subtitle", "time": 2211.75, "timestamp": "00:36:51", "text": "ああ、それは階級と人種の問題で、"}, {"type": "subtitle", "time": 2216.57, "timestamp": "00:36:56", "text": "宗教。ああ、わかりました。何てことだ。"}, {"type": "subtitle", "time": 2217.75, "timestamp": "00:36:57", "text": "[音楽]"}]
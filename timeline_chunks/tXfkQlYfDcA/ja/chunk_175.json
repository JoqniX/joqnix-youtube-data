[{"type": "subtitle", "time": 10500.07, "timestamp": "02:55:00", "text": "今回は、人々が"}, {"type": "subtitle", "time": 10502.309, "timestamp": "02:55:02", "text": "私を助けてくれた人たちは、時間を割くことができなかった"}, {"type": "subtitle", "time": 10506.15, "timestamp": "02:55:06", "text": "資金。だから私は「自分でやる」と思ったんです。それで"}, {"type": "subtitle", "time": 10507.83, "timestamp": "02:55:07", "text": "えっと、彼らは休憩中なので"}, {"type": "subtitle", "time": 10510.389, "timestamp": "02:55:10", "text": "すべてだったので、私は「うん、行くよ」と言いました"}, {"type": "subtitle", "time": 10514.71, "timestamp": "02:55:14", "text": "自分でやってみて、どうなるか見てみよう"}, {"type": "subtitle", "time": 10517.99, "timestamp": "02:55:17", "text": "そして私は必ず"}, {"type": "subtitle", "time": 10520.15, "timestamp": "02:55:20", "text": "アーティストと、そう思うと、私は"}, {"type": "subtitle", "time": 10523.03, "timestamp": "02:55:23", "text": "ヨアトンとかそういうことを全部やってる"}, {"type": "subtitle", "time": 10525.91, "timestamp": "02:55:25", "text": "こんな感じで、私はもっとこう思う"}, {"type": "subtitle", "time": 10528.79, "timestamp": "02:55:28", "text": "私は本当に、えーと、"}, {"type": "subtitle", "time": 10531.03, "timestamp": "02:55:31", "text": "一緒に仕事をするクライアントは、私も"}, {"type": "subtitle", "time": 10534.23, "timestamp": "02:55:34", "text": "神経質で完璧主義者。私はみんなと同じように"}, {"type": "subtitle", "time": 10538.15, "timestamp": "02:55:38", "text": "欠点を指摘したりするのに時間を費やす。"}, {"type": "subtitle", "time": 10541.03, "timestamp": "02:55:41", "text": "わからない。でも、えっと、"}, {"type": "subtitle", "time": 10542.79, "timestamp": "02:55:42", "text": "いくつか依頼を受けたことがある"}, {"type": "subtitle", "time": 10544.95, "timestamp": "02:55:44", "text": "そして私は通常クライアントに感謝しています"}, {"type": "subtitle", "time": 10546.87, "timestamp": "02:55:46", "text": "「ねえ、"}, {"type": "subtitle", "time": 10548.23, "timestamp": "02:55:48", "text": "例えば、私が"}, {"type": "subtitle", "time": 10549.83, "timestamp": "02:55:49", "text": "変化したいと思うし、彼らはいつも"}, {"type": "subtitle", "time": 10551.99, "timestamp": "02:55:51", "text": "「例えば、具体的なことを指摘する、といった感じです。」そして私は"}, {"type": "subtitle", "time": 10554.23, "timestamp": "02:55:54", "text": "確かに、あなたが好きなアーティストたち"}, {"type": "subtitle", "time": 10555.99, "timestamp": "02:55:55", "text": "一緒に仕事をして本当に感謝しています"}, {"type": "subtitle", "time": 10558.309, "timestamp": "02:55:58", "text": "あなたが望むことや好きなことを詳しく教えてください"}]
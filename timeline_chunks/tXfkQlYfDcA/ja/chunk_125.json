[{"type": "subtitle", "time": 7500.39, "timestamp": "02:05:00", "text": "次に、フレームレートの問題があります。"}, {"type": "subtitle", "time": 7502.39, "timestamp": "02:05:02", "text": "これを開けたい理由がわかっている"}, {"type": "subtitle", "time": 7511.589, "timestamp": "02:05:11", "text": "実際にはフルスクリーン表示ではありません。はい、どうぞ。"}, {"type": "subtitle", "time": 7515.27, "timestamp": "02:05:15", "text": "横になっているときの私の右側。"}, {"type": "subtitle", "time": 7518.07, "timestamp": "02:05:18", "text": "カメラを少し紛失したので"}, {"type": "subtitle", "time": 7520.56, "timestamp": "02:05:20", "text": "まだ私を追跡している。"}, {"type": "subtitle", "time": 7521.83, "timestamp": "02:05:21", "text": "[音楽]"}, {"type": "subtitle", "time": 7532.47, "timestamp": "02:05:32", "text": "どれほど"}, {"type": "subtitle", "time": 7538.47, "timestamp": "02:05:38", "text": "[音楽]"}, {"type": "subtitle", "time": 7542.149, "timestamp": "02:05:42", "text": "はい、私はこのように書くことができます"}, {"type": "subtitle", "time": 7543.589, "timestamp": "02:05:43", "text": "聞こえているかどうかわかりません。私は"}, {"type": "subtitle", "time": 7545.43, "timestamp": "02:05:45", "text": "話していると、私は逆のことを話しているかもしれない"}, {"type": "subtitle", "time": 7547.35, "timestamp": "02:05:47", "text": "マイク"}, {"type": "subtitle", "time": 7550.95, "timestamp": "02:05:50", "text": "でも、これをこのように調整することもできます"}, {"type": "subtitle", "time": 7552.79, "timestamp": "02:05:52", "text": "これは私ができないことを意味する"}, {"type": "subtitle", "time": 7556.149, "timestamp": "02:05:56", "text": "連絡はしたけど、まあいいと思う。"}, {"type": "subtitle", "time": 7559.91, "timestamp": "02:05:59", "text": "頂上をちらりと見る程度にしよう。"}]
[{"type": "subtitle", "time": 4563.91, "timestamp": "01:16:03", "text": "取引"}, {"type": "subtitle", "time": 4568.31, "timestamp": "01:16:08", "text": "この後、朝食を食べます"}, {"type": "subtitle", "time": 4570.63, "timestamp": "01:16:10", "text": "そして"}, {"type": "subtitle", "time": 4573.99, "timestamp": "01:16:13", "text": "手を洗って、"}, {"type": "subtitle", "time": 4576.95, "timestamp": "01:16:16", "text": "はい、では最初のテーマから始めましょう。何"}, {"type": "subtitle", "time": 4579.9, "timestamp": "01:16:19", "text": "質問？"}, {"type": "subtitle", "time": 4593.27, "timestamp": "01:16:33", "text": "どう思われますか？あなたの"}, {"type": "subtitle", "time": 4596.07, "timestamp": "01:16:36", "text": "髪を染めることについてどう思いますか？着色"}, {"type": "subtitle", "time": 4600.149, "timestamp": "01:16:40", "text": "毛。ヘアカラーリングとは何かを定義してください。あなたは"}, {"type": "subtitle", "time": 4604.709, "timestamp": "01:16:44", "text": "芸術で髪を着色するという意味ですか、それとも"}, {"type": "subtitle", "time": 4607.83, "timestamp": "01:16:47", "text": "色付きの髪や染めた髪で"}, {"type": "subtitle", "time": 4610.63, "timestamp": "01:16:50", "text": "一般的な？"}, {"type": "subtitle", "time": 4618.87, "timestamp": "01:16:58", "text": "髪を染めるってこと？髪を染める"}]
[{"type": "subtitle", "time": 10562.309, "timestamp": "02:56:02", "text": "あなたが望むように。そうだといい。その"}, {"type": "subtitle", "time": 10565.349, "timestamp": "02:56:05", "text": "私もそう願っています。わからない。最後に"}, {"type": "subtitle", "time": 10567.03, "timestamp": "02:56:07", "text": "その日、あなたがどうだったかはわかりませんが"}, {"type": "subtitle", "time": 10569.429, "timestamp": "02:56:09", "text": "クライアントですが、少なくとも"}, {"type": "subtitle", "time": 10571.83, "timestamp": "02:56:11", "text": "私たちのやり取りがどんなものであったとしても、私は確信しています"}, {"type": "subtitle", "time": 10574.15, "timestamp": "02:56:14", "text": "あなたは素晴らしかった。"}, {"type": "subtitle", "time": 10576.15, "timestamp": "02:56:16", "text": "いいえ。ええ、そうだと思います。"}, {"type": "subtitle", "time": 10578.79, "timestamp": "02:56:18", "text": "感謝しています。彼らは言及していたと思います"}, {"type": "subtitle", "time": 10582.469, "timestamp": "02:56:22", "text": "メッセージの中にそれが入っている。ええと、そうですね、"}, {"type": "subtitle", "time": 10585.67, "timestamp": "02:56:25", "text": "長いコミュニティのようなものがあった"}, {"type": "subtitle", "time": 10588.71, "timestamp": "02:56:28", "text": "長い間隔。これは実行された。あなたが"}, {"type": "subtitle", "time": 10591.269, "timestamp": "02:56:31", "text": "視聴は最新のイテレーションです"}, {"type": "subtitle", "time": 10593.83, "timestamp": "02:56:33", "text": "生放送のテレビで調整が行われたようなものだった。"}, {"type": "subtitle", "time": 10596.71, "timestamp": "02:56:36", "text": "別れとかそういうこと。つまり最初の"}, {"type": "subtitle", "time": 10599.429, "timestamp": "02:56:39", "text": "1つは去年の私の誕生日に作られました。"}, {"type": "subtitle", "time": 10603.99, "timestamp": "02:56:43", "text": "8月11日。 12日に手に入れました。うん。それで"}, {"type": "subtitle", "time": 10606.87, "timestamp": "02:56:46", "text": "とんでもない。何？"}, {"type": "subtitle", "time": 10609.429, "timestamp": "02:56:49", "text": "ええ、それはほとんど"}, {"type": "subtitle", "time": 10611.429, "timestamp": "02:56:51", "text": "1年くらいかな。しかし周囲は"}, {"type": "subtitle", "time": 10614.71, "timestamp": "02:56:54", "text": "今回は、最終段階だった。"}, {"type": "subtitle", "time": 10617.99, "timestamp": "02:56:57", "text": "えっと、6月か7月ですよね？うん。状況は"}]
[{"type": "subtitle", "time": 12900.229, "timestamp": "03:35:00", "text": "サミーやストリーマー関連のものが好きです"}, {"type": "subtitle", "time": 12903.349, "timestamp": "03:35:03", "text": "YouTube からのコメントを記録し、"}, {"type": "subtitle", "time": 12907.19, "timestamp": "03:35:07", "text": "TwitchからDiscordへ。だから私は"}, {"type": "subtitle", "time": 12909.67, "timestamp": "03:35:09", "text": "うん。うん。私はそうします。そういう風に"}, {"type": "subtitle", "time": 12914.309, "timestamp": "03:35:14", "text": "ユーザーが何かを送信する場合"}, {"type": "subtitle", "time": 12917.67, "timestamp": "03:35:17", "text": "ひどい、ひどい、削除して隠す、えーと"}, {"type": "subtitle", "time": 12920.07, "timestamp": "03:35:20", "text": "まるで安全な場所みたいだよね？そこには"}, {"type": "subtitle", "time": 12922.469, "timestamp": "03:35:22", "text": "それと改造レーサーのログがあります"}, {"type": "subtitle", "time": 12925.91, "timestamp": "03:35:25", "text": "Discord からそれを使うことができます"}, {"type": "subtitle", "time": 12928.469, "timestamp": "03:35:28", "text": "視聴者を罰するなど、"}, {"type": "subtitle", "time": 12930.63, "timestamp": "03:35:30", "text": "YouTubeにはかつて荒らしがいて"}, {"type": "subtitle", "time": 12933.59, "timestamp": "03:35:33", "text": "そうしたら、私は「ああ、今君は"}, {"type": "subtitle", "time": 12936.95, "timestamp": "03:35:36", "text": "証拠は隠せない"}, {"type": "subtitle", "time": 12939.91, "timestamp": "03:35:39", "text": "「ああ、だからそうしたんだ」みたいな感じ。それで"}, {"type": "subtitle", "time": 12943.03, "timestamp": "03:35:43", "text": "興味深いことに、ログイベントもあります。"}, {"type": "subtitle", "time": 12945.349, "timestamp": "03:35:45", "text": "よくビットやすべてに従うので、"}, {"type": "subtitle", "time": 12947.75, "timestamp": "03:35:47", "text": "物事を把握するための方法。だから私は"}, {"type": "subtitle", "time": 12950.95, "timestamp": "03:35:50", "text": "気に入ったよ。それはすばらしい。私はこう思った"}, {"type": "subtitle", "time": 12954.87, "timestamp": "03:35:54", "text": "意識している、ええと、もちろん私の経験"}, {"type": "subtitle", "time": 12957.11, "timestamp": "03:35:57", "text": "Twitchのみで、通常通り"}, {"type": "subtitle", "time": 12959.11, "timestamp": "03:35:59", "text": "あなたのモッドビューですべてが表示されます"}]
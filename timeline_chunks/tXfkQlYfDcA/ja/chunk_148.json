[{"type": "subtitle", "time": 8881.75, "timestamp": "02:28:01", "text": "または限定コンテンツも"}, {"type": "subtitle", "time": 8886.389, "timestamp": "02:28:06", "text": "それでうまくいって、それに気付いた"}, {"type": "subtitle", "time": 8888.95, "timestamp": "02:28:08", "text": "画面上の字幕のようなもの"}, {"type": "subtitle", "time": 8891.99, "timestamp": "02:28:11", "text": "機能しません。それは私を理解していない"}, {"type": "subtitle", "time": 8895.67, "timestamp": "02:28:15", "text": "そして私は「なぜ？」と思った。"}, {"type": "subtitle", "time": 8899.51, "timestamp": "02:28:19", "text": "だから、私に残された唯一の選択肢は中国語を学ぶことだ。"}, {"type": "subtitle", "time": 8902.15, "timestamp": "02:28:22", "text": "ええ、世界でも有​​数の"}, {"type": "subtitle", "time": 8904.389, "timestamp": "02:28:24", "text": "最も難しい言語のほとんど。うん、大丈夫だよ。"}, {"type": "subtitle", "time": 8906.63, "timestamp": "02:28:26", "text": "君ならできるよ。正直に言うと、もしあなたが"}, {"type": "subtitle", "time": 8909.11, "timestamp": "02:28:29", "text": "日本語でここまで来たけど、"}, {"type": "subtitle", "time": 8910.87, "timestamp": "02:28:30", "text": "明らかにそれは情熱のようなもので"}, {"type": "subtitle", "time": 8913.59, "timestamp": "02:28:33", "text": "運転するのと同じような感じですよね？だから、私は確信しています"}, {"type": "subtitle", "time": 8915.429, "timestamp": "02:28:35", "text": "きっと君はそれを完璧にこなすだろう"}, {"type": "subtitle", "time": 8919.11, "timestamp": "02:28:39", "text": "簡単に。うん、大丈夫だよ。それは"}, {"type": "subtitle", "time": 8923.59, "timestamp": "02:28:43", "text": "本当に良い。うん。うん。エキサイティング。うん。"}, {"type": "subtitle", "time": 8926.79, "timestamp": "02:28:46", "text": "そして、今はアクセスできなくなってしまいました"}, {"type": "subtitle", "time": 8928.95, "timestamp": "02:28:48", "text": "支援してくれた会社のおかげで、"}, {"type": "subtitle", "time": 8932.07, "timestamp": "02:28:52", "text": "私の中では、彼らはもうそこにいない。だから私は"}, {"type": "subtitle", "time": 8935.91, "timestamp": "02:28:55", "text": "私はフリーエージェントで、"}, {"type": "subtitle", "time": 8939.59, "timestamp": "02:28:59", "text": "彼らの配信を取り戻す方法。なぜなら"}]
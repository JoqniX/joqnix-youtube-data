[{"type": "subtitle", "time": 14881.67, "timestamp": "04:08:01", "text": "ビリービリーのボードとか色々。うん。"}, {"type": "subtitle", "time": 14885.51, "timestamp": "04:08:05", "text": "そしてその時、私は自分が何をしているのかに気づいた"}, {"type": "subtitle", "time": 14887.83, "timestamp": "04:08:07", "text": "多すぎるもの"}, {"type": "subtitle", "time": 14891.67, "timestamp": "04:08:11", "text": "圧倒されるでしょう？そして私は気づいた"}, {"type": "subtitle", "time": 14893.99, "timestamp": "04:08:13", "text": "優先順位をつけていくつか削減する必要がある"}, {"type": "subtitle", "time": 14898.229, "timestamp": "04:08:18", "text": "不要な物や雑多なもの。"}, {"type": "subtitle", "time": 14900.71, "timestamp": "04:08:20", "text": "そしてある意味で私は親切で、私は少し切り捨てる"}, {"type": "subtitle", "time": 14903.67, "timestamp": "04:08:23", "text": "多くのものを手放したが、まだ"}, {"type": "subtitle", "time": 14907.03, "timestamp": "04:08:27", "text": "そのウェブサイトのあれを使ってください。"}, {"type": "subtitle", "time": 14910.55, "timestamp": "04:08:30", "text": "でも、ああ、あれをやっていた頃が懐かしいよ。"}, {"type": "subtitle", "time": 14913.189, "timestamp": "04:08:33", "text": "実際、楽しかったよ。"}, {"type": "subtitle", "time": 14915.51, "timestamp": "04:08:35", "text": "とても楽しそうですね。しかし"}, {"type": "subtitle", "time": 14917.189, "timestamp": "04:08:37", "text": "ええ、あなたの言うことはとても正しいです。"}, {"type": "subtitle", "time": 14919.189, "timestamp": "04:08:39", "text": "まるで簡単に火傷してしまうような"}, {"type": "subtitle", "time": 14921.75, "timestamp": "04:08:41", "text": "一度にたくさんのことをこなしている。おお"}, {"type": "subtitle", "time": 14923.429, "timestamp": "04:08:43", "text": "うん、たぶん最終的には"}, {"type": "subtitle", "time": 14926.469, "timestamp": "04:08:46", "text": "すべてを見直して"}, {"type": "subtitle", "time": 14928.63, "timestamp": "04:08:48", "text": "「ふむ、もしかしたらこれが人々が"}, {"type": "subtitle", "time": 14930.87, "timestamp": "04:08:50", "text": "「欲しい」。もしかしたら人々は本当に"}, {"type": "subtitle", "time": 14933.03, "timestamp": "04:08:53", "text": "これはたくさんだ。そうすれば、その時に"}, {"type": "subtitle", "time": 14935.03, "timestamp": "04:08:55", "text": "それに取り組む時間を確保するということです。でもそれは良いことだ"}, {"type": "subtitle", "time": 14937.269, "timestamp": "04:08:57", "text": "あなたは新しいことに挑戦するのが好きなんですね。えっと"}]
[{"type": "subtitle", "time": 3362.71, "timestamp": "00:56:02", "text": "または、この中で有効である val 有効 検証済み"}, {"type": "subtitle", "time": 3369.75, "timestamp": "00:56:09", "text": "しかしそれでも"}, {"type": "subtitle", "time": 3377.43, "timestamp": "00:56:17", "text": "[音楽]"}, {"type": "subtitle", "time": 3379.67, "timestamp": "00:56:19", "text": "私の就寝時間は午後11時になりました。だから私は"}, {"type": "subtitle", "time": 3381.91, "timestamp": "00:56:21", "text": "あと２時間なら大丈夫。おお、いいね、いいね、"}, {"type": "subtitle", "time": 3383.75, "timestamp": "00:56:23", "text": "ニース、"}, {"type": "subtitle", "time": 3386.309, "timestamp": "00:56:26", "text": "素晴らしいショーでした。素晴らしいショーでした。"}, {"type": "subtitle", "time": 3388.789, "timestamp": "00:56:28", "text": "あなたのタイムゾーンはEST（米国東部標準時）だったと思いますが、合っていますか？"}, {"type": "subtitle", "time": 3398.789, "timestamp": "00:56:38", "text": "あなたのジョークがうまくいくことを祈っています。"}, {"type": "subtitle", "time": 3402.71, "timestamp": "00:56:42", "text": "あと3年。それからさらに3年後"}, {"type": "subtitle", "time": 3404.87, "timestamp": "00:56:44", "text": "これで終わりだ。見たくない"}, {"type": "subtitle", "time": 3407.67, "timestamp": "00:56:47", "text": "この馬鹿げた話に戻る。つまり、"}, {"type": "subtitle", "time": 3409.67, "timestamp": "00:56:49", "text": "私が文学を選んだ理由は"}, {"type": "subtitle", "time": 3412.309, "timestamp": "00:56:52", "text": "もう一度本を書きたかったから"}, {"type": "subtitle", "time": 3415.19, "timestamp": "00:56:55", "text": "私の下半身のオネクシアの物が欲しいだけ"}, {"type": "subtitle", "time": 3416.95, "timestamp": "00:56:56", "text": "最後に、どうすればいいのか知りたかっただけです"}, {"type": "subtitle", "time": 3419.75, "timestamp": "00:56:59", "text": "作家になった気分"}]
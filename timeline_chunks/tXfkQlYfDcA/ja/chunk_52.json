[{"type": "subtitle", "time": 3122.63, "timestamp": "00:52:02", "text": "できると思う。"}, {"type": "subtitle", "time": 3123.829, "timestamp": "00:52:03", "text": "あのね？新しい"}, {"type": "subtitle", "time": 3128.14, "timestamp": "00:52:08", "text": "ページ。わかった。本日2ページ目。"}, {"type": "subtitle", "time": 3147.27, "timestamp": "00:52:27", "text": "ページがありません。ページを在庫しておいてよかった"}, {"type": "subtitle", "time": 3148.95, "timestamp": "00:52:28", "text": "論文。"}, {"type": "subtitle", "time": 3151.829, "timestamp": "00:52:31", "text": "つまり、これはまだこのことは"}, {"type": "subtitle", "time": 3156.39, "timestamp": "00:52:36", "text": "終わったけど、それでも嬉しい。"}, {"type": "subtitle", "time": 3159.03, "timestamp": "00:52:39", "text": "何てことだ。私は嬉しい。"}, {"type": "subtitle", "time": 3162.87, "timestamp": "00:52:42", "text": "こんにちは。 4 5 6 7"}, {"type": "subtitle", "time": 3165.43, "timestamp": "00:52:45", "text": "ポイント。そして5番目へ"}, {"type": "subtitle", "time": 3167.27, "timestamp": "00:52:47", "text": "質問。 5番目に行く前に"}, {"type": "subtitle", "time": 3169.51, "timestamp": "00:52:49", "text": "質問ですが、私たちは科目１に取り組む必要があります"}, {"type": "subtitle", "time": 3173.27, "timestamp": "00:52:53", "text": "4つ目の質問。 2つ前は逆"}, {"type": "subtitle", "time": 3175.91, "timestamp": "00:52:55", "text": "1以上。この全体を終わらせます"}]
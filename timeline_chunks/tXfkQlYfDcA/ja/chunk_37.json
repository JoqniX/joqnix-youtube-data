[{"type": "subtitle", "time": 2220.71, "timestamp": "00:37:00", "text": "基礎"}, {"type": "subtitle", "time": 2222.58, "timestamp": "00:37:02", "text": "身元。"}, {"type": "subtitle", "time": 2225.829, "timestamp": "00:37:05", "text": "[音楽]"}, {"type": "subtitle", "time": 2230.069, "timestamp": "00:37:10", "text": "こんにちは。さあ、答えを書こう。"}, {"type": "subtitle", "time": 2234.87, "timestamp": "00:37:14", "text": "なぜ？今回は集中してスピードアップするよ。"}, {"type": "subtitle", "time": 2237.51, "timestamp": "00:37:17", "text": "ええ、私は実際集中しています、そして"}, {"type": "subtitle", "time": 2239.75, "timestamp": "00:37:19", "text": "スピードを上げる"}, {"type": "subtitle", "time": 2242.71, "timestamp": "00:37:22", "text": "時間を無駄にするよりも。"}, {"type": "subtitle", "time": 2245.43, "timestamp": "00:37:25", "text": "ジョシュアベース"}, {"type": "subtitle", "time": 2254.7, "timestamp": "00:37:34", "text": "関係"}, {"type": "subtitle", "time": 2257.109, "timestamp": "00:37:37", "text": "[音楽]"}, {"type": "subtitle", "time": 2261.73, "timestamp": "00:37:41", "text": "そのアイデンティティの前に"}, {"type": "subtitle", "time": 2263.51, "timestamp": "00:37:43", "text": "[音楽]"}, {"type": "subtitle", "time": 2265.83, "timestamp": "00:37:45", "text": "根付いている"}, {"type": "subtitle", "time": 2268.15, "timestamp": "00:37:48", "text": "[音楽]"}, {"type": "subtitle", "time": 2270.71, "timestamp": "00:37:50", "text": "多くの点で"}, {"type": "subtitle", "time": 2274.23, "timestamp": "00:37:54", "text": "多くのシステムが存在するが、実際には多くの方法が存在するわけではない。"}, {"type": "subtitle", "time": 2276.06, "timestamp": "00:37:56", "text": "社会の"}, {"type": "subtitle", "time": 2277.91, "timestamp": "00:37:57", "text": "[音楽]"}]
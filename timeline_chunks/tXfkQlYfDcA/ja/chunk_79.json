[{"type": "subtitle", "time": 4743.11, "timestamp": "01:19:03", "text": "右？まさにその通り。だから、あなたが"}, {"type": "subtitle", "time": 4747.27, "timestamp": "01:19:07", "text": "そうすると、その跡が常に残るだろう"}, {"type": "subtitle", "time": 4749.51, "timestamp": "01:19:09", "text": "そんな感じ。ええ、もし私に何と聞くなら"}, {"type": "subtitle", "time": 4751.43, "timestamp": "01:19:11", "text": "髪を染めることを考えていますか？"}, {"type": "subtitle", "time": 4754.149, "timestamp": "01:19:14", "text": "いいね。私もやってみたい。私も欲しい"}, {"type": "subtitle", "time": 4756.55, "timestamp": "01:19:16", "text": "それを実行するため、しかし同時に、"}, {"type": "subtitle", "time": 4760.31, "timestamp": "01:19:20", "text": "自然な髪色もそうですよね？"}, {"type": "subtitle", "time": 4762.47, "timestamp": "01:19:22", "text": "それでおしまい。"}, {"type": "subtitle", "time": 4764.63, "timestamp": "01:19:24", "text": "でも、髪を染めるのはかっこいいよね。ない"}, {"type": "subtitle", "time": 4766.95, "timestamp": "01:19:26", "text": "嘘をつくつもりだ。ええと、たくさんあります"}, {"type": "subtitle", "time": 4769.43, "timestamp": "01:19:29", "text": "あなたができる放射線。"}, {"type": "subtitle", "time": 4783.189, "timestamp": "01:19:43", "text": "それはまるで、髪をまっすぐにするようなものだ。私は自分の"}, {"type": "subtitle", "time": 4785.59, "timestamp": "01:19:45", "text": "髪をストレートにした時の経験。私"}, {"type": "subtitle", "time": 4788.63, "timestamp": "01:19:48", "text": "私は元の髪を失ってしまった"}, {"type": "subtitle", "time": 4790.63, "timestamp": "01:19:50", "text": "構造。"}, {"type": "subtitle", "time": 4792.95, "timestamp": "01:19:52", "text": "ええ、私のストレートヘアの構造"}, {"type": "subtitle", "time": 4797.91, "timestamp": "01:19:57", "text": "髪は、私がヘアアイロンを使い続けたせいで。私"}]
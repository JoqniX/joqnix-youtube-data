[{"type": "subtitle", "time": 129.589, "timestamp": "00:02:09", "text": "一体私は何をしてしまったんだ？"}, {"type": "subtitle", "time": 131.83, "timestamp": "00:02:11", "text": "こんにちは。"}, {"type": "subtitle", "time": 138.39, "timestamp": "00:02:18", "text": "すみません。わかった。わかった。わかった。楽しんでください"}, {"type": "subtitle", "time": 140.39, "timestamp": "00:02:20", "text": "V. わかりました。ごめんなさい。わからない。何"}, {"type": "subtitle", "time": 151.19, "timestamp": "00:02:31", "text": "V.パスワードをお楽しみください。わかった。こんにちは。"}, {"type": "subtitle", "time": 153.27, "timestamp": "00:02:33", "text": "よし。それでは、執筆に取り掛かります。それで、"}, {"type": "chat", "time": 153.701, "timestamp": "00:02:33", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Joq is Currently taking a break! and will be back soon! do enjoy this past memories till he is back!"}, {"type": "subtitle", "time": 154.949, "timestamp": "00:02:34", "text": "昨日私たちは4番目に立ち寄りました"}, {"type": "subtitle", "time": 158.39, "timestamp": "00:02:38", "text": "質問。被験者1、被験者2。"}, {"type": "subtitle", "time": 161.11, "timestamp": "00:02:41", "text": "また、私がここにいる間に話しておきますが、"}, {"type": "subtitle", "time": 165.27, "timestamp": "00:02:45", "text": "私は現在、YouTubeに動画をアップロードしています"}, {"type": "chat", "time": 168.191, "timestamp": "00:02:48", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "You can watch these fragments of a memories here- %line0%"}, {"type": "subtitle", "time": 168.47, "timestamp": "00:02:48", "text": "一昨日の配信から"}, {"type": "subtitle", "time": 174.47, "timestamp": "00:02:54", "text": "ビリー、ビリー。はい。そして、そして、それから"}, {"type": "subtitle", "time": 176.63, "timestamp": "00:02:56", "text": "サムネイルを作成する必要があるだけです"}, {"type": "subtitle", "time": 179.50900000000001, "timestamp": "00:02:59", "text": "あれ。知っている。私もダウンロードしています"}]
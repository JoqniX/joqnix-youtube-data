[{"type": "subtitle", "time": 13921.59, "timestamp": "03:52:01", "text": "現在の星座。"}, {"type": "subtitle", "time": 13922.95, "timestamp": "03:52:02", "text": "うん。"}, {"type": "subtitle", "time": 13926.63, "timestamp": "03:52:06", "text": "何てことだ。それは私のものだと思います。それは"}, {"type": "subtitle", "time": 13929.59, "timestamp": "03:52:09", "text": "私は自己不信症候群を抱えている"}, {"type": "subtitle", "time": 13932.389, "timestamp": "03:52:12", "text": "まあ、そういうことかな。うんうん。それは"}, {"type": "subtitle", "time": 13935.03, "timestamp": "03:52:15", "text": "それ。よし、それを超えるためにここにいるぞ"}, {"type": "subtitle", "time": 13946.229, "timestamp": "03:52:26", "text": "おお。"}, {"type": "subtitle", "time": 13948.07, "timestamp": "03:52:28", "text": "うん、そうだね、そうだね"}, {"type": "subtitle", "time": 13951.11, "timestamp": "03:52:31", "text": "明らかに情熱を持っている"}, {"type": "subtitle", "time": 13953.59, "timestamp": "03:52:33", "text": "人々をまとめて"}, {"type": "subtitle", "time": 13955.91, "timestamp": "03:52:35", "text": "特定のものは互いに混ざり合うのが好きです"}, {"type": "subtitle", "time": 13958.63, "timestamp": "03:52:38", "text": "社交的な人"}, {"type": "subtitle", "time": 13960.71, "timestamp": "03:52:40", "text": "それはとてもとても興味深いですね。"}, {"type": "subtitle", "time": 13964.389, "timestamp": "03:52:44", "text": "うん。いいえ、私は内向的な人間です。私は恥ずかしがり屋です"}, {"type": "subtitle", "time": 13967.75, "timestamp": "03:52:47", "text": "そして消音器のようなもの。それはおかしい。私 私"}, {"type": "subtitle", "time": 13969.67, "timestamp": "03:52:49", "text": "あなたは内向的だとは全く思わない"}, {"type": "subtitle", "time": 13972.389, "timestamp": "03:52:52", "text": "たぶんあなたは"}, {"type": "subtitle", "time": 13974.63, "timestamp": "03:52:54", "text": "まるでアンビエントワークみたいだよね？あなたはまるで"}, {"type": "subtitle", "time": 13976.87, "timestamp": "03:52:56", "text": "非常に外向的"}, {"type": "subtitle", "time": 13978.229, "timestamp": "03:52:58", "text": "えっと、そういうことに関しては、"}]
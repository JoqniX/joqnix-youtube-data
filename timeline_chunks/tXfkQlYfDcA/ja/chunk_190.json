[{"type": "subtitle", "time": 11400.55, "timestamp": "03:10:00", "text": "うん。まるで少し"}, {"type": "subtitle", "time": 11402.55, "timestamp": "03:10:02", "text": "悲しい目覚めの呼びかけのように"}, {"type": "subtitle", "time": 11405.11, "timestamp": "03:10:05", "text": "ああ、くそ。わかった。これは明らかにそうではない"}, {"type": "subtitle", "time": 11407.269, "timestamp": "03:10:07", "text": "今すぐできること。でも、"}, {"type": "subtitle", "time": 11409.429, "timestamp": "03:10:09", "text": "頼ることは悪いことではない"}, {"type": "subtitle", "time": 11411.91, "timestamp": "03:10:11", "text": "人々。よかった、えっと、あなたが"}, {"type": "subtitle", "time": 11415.67, "timestamp": "03:10:15", "text": "そうだ、数人に頼ることに決めた"}, {"type": "subtitle", "time": 11417.83, "timestamp": "03:10:17", "text": "明らかに"}, {"type": "subtitle", "time": 11420.309, "timestamp": "03:10:20", "text": "時間とエネルギーをかけて、"}, {"type": "subtitle", "time": 11423.03, "timestamp": "03:10:23", "text": "芸術を極め、同様のスキルを磨く。その"}, {"type": "subtitle", "time": 11427.19, "timestamp": "03:10:27", "text": "全く悪いことではない。うん。"}, {"type": "subtitle", "time": 11429.75, "timestamp": "03:10:29", "text": "おお。"}, {"type": "subtitle", "time": 11431.83, "timestamp": "03:10:31", "text": "そして私たちは、"}, {"type": "subtitle", "time": 11433.83, "timestamp": "03:10:33", "text": "ゲームをプレイすることになっている。私たちは話していました"}, {"type": "subtitle", "time": 11442.07, "timestamp": "03:10:42", "text": "これは本当に楽しい。私はおしゃべりするのが大好きなんです。えっと"}, {"type": "subtitle", "time": 11444.87, "timestamp": "03:10:44", "text": "私はおしゃべりが大好きだ。私たちはあなたと同じように"}, {"type": "subtitle", "time": 11447.429, "timestamp": "03:10:47", "text": "新しい人たちは、ああ、そうだね、そうしよう"}, {"type": "subtitle", "time": 11451.51, "timestamp": "03:10:51", "text": "話し合ってみよう。いいね！してやりましょう。"}, {"type": "subtitle", "time": 11453.59, "timestamp": "03:10:53", "text": "何てことだ。"}, {"type": "subtitle", "time": 11455.67, "timestamp": "03:10:55", "text": "でも、それだけの価値はあるよ。私は気づいた"}, {"type": "subtitle", "time": 11459.03, "timestamp": "03:10:59", "text": "私はいつも自分が"}]
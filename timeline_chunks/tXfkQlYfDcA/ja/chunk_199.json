[{"type": "subtitle", "time": 11941.11, "timestamp": "03:19:01", "text": "一度にやらなければならないことが多すぎる。"}, {"type": "subtitle", "time": 11944.469, "timestamp": "03:19:04", "text": "私にはまともに一つもできない。私は手に入れた"}, {"type": "subtitle", "time": 11947.75, "timestamp": "03:19:07", "text": "実際、そのせいで燃え尽きてしまった。のように"}, {"type": "subtitle", "time": 11953.19, "timestamp": "03:19:13", "text": "えっと、Twitterをやってたよ、うん、Twitterをやってた。"}, {"type": "subtitle", "time": 11955.03, "timestamp": "03:19:15", "text": "WhatsAppグループ、Telegramグループ、"}, {"type": "subtitle", "time": 11958.309, "timestamp": "03:19:18", "text": "Facebook、Tumblr、そして他には何がある？えっと"}, {"type": "subtitle", "time": 11960.469, "timestamp": "03:19:20", "text": "他にもたくさんのRedditがあった。おお"}, {"type": "subtitle", "time": 11963.269, "timestamp": "03:19:23", "text": "そう、Reddit、Discord。ああ、私のReddit。おお"}, {"type": "subtitle", "time": 11970.95, "timestamp": "03:19:30", "text": "Redditってすごいよね。うん、Discordもね。"}, {"type": "subtitle", "time": 11972.55, "timestamp": "03:19:32", "text": "忘れることはできない。そうですね、私はこう思います"}, {"type": "subtitle", "time": 11974.95, "timestamp": "03:19:34", "text": "Discordは、えっと、かなり良いですね"}, {"type": "subtitle", "time": 11978.55, "timestamp": "03:19:38", "text": "コミュニティがあって、えっと、そうじゃない"}, {"type": "subtitle", "time": 11981.19, "timestamp": "03:19:41", "text": "コンテンツにいいね！それは純粋に"}, {"type": "subtitle", "time": 11984.63, "timestamp": "03:19:44", "text": "本当に素敵なコミュニティです。うん。"}, {"type": "subtitle", "time": 11988.63, "timestamp": "03:19:48", "text": "でも、そうですね。それは私が"}, {"type": "subtitle", "time": 11990.55, "timestamp": "03:19:50", "text": "あなたが言ったとき、私の衝撃を想像してみてください。"}, {"type": "subtitle", "time": 11992.95, "timestamp": "03:19:52", "text": "Twitch、ケーキのようなマルチストリーム、"}, {"type": "subtitle", "time": 11997.269, "timestamp": "03:19:57", "text": "YouTube は「えっ？」みたいな感じ？どうやって全部こなしているんですか？"}]
[{"type": "subtitle", "time": 11641.429, "timestamp": "03:14:01", "text": "いや、何かしないといけないんだ"}, {"type": "subtitle", "time": 11644.55, "timestamp": "03:14:04", "text": "これに特化したものです。だから、その時私は"}, {"type": "subtitle", "time": 11647.11, "timestamp": "03:14:07", "text": "Blenderを開いて泣いた"}, {"type": "subtitle", "time": 11649.269, "timestamp": "03:14:09", "text": "何百万ガロンもの涙を流して"}, {"type": "subtitle", "time": 11652.309, "timestamp": "03:14:12", "text": "物事を理解して、それから、うん、えーと"}, {"type": "subtitle", "time": 11654.309, "timestamp": "03:14:14", "text": "その時、私は3D制作を始めたんです"}, {"type": "subtitle", "time": 11658.15, "timestamp": "03:14:18", "text": "ユーチューバーモデルのような。えっと、そしてここにこれ"}, {"type": "subtitle", "time": 11660.55, "timestamp": "03:14:20", "text": "それが今の私の仕事で、フルタイムでやっていることです。"}, {"type": "subtitle", "time": 11663.03, "timestamp": "03:14:23", "text": "とても楽しいです。えっと、3Dを作るのは大変です"}, {"type": "subtitle", "time": 11665.11, "timestamp": "03:14:25", "text": "楽しい。いつも"}, {"type": "subtitle", "time": 11668.389, "timestamp": "03:14:28", "text": "毎日何か新しいことを学ぶ。えっと、"}, {"type": "subtitle", "time": 11671.269, "timestamp": "03:14:31", "text": "でもそれは同時に圧倒されるようなものでもある。"}, {"type": "subtitle", "time": 11673.429, "timestamp": "03:14:33", "text": "まるで、"}, {"type": "subtitle", "time": 11676.07, "timestamp": "03:14:36", "text": "人々が好きなもの"}, {"type": "subtitle", "time": 11677.99, "timestamp": "03:14:37", "text": "モデルを使って達成すること"}, {"type": "subtitle", "time": 11679.51, "timestamp": "03:14:39", "text": "何年も経って、「ああ、私は"}, {"type": "subtitle", "time": 11681.51, "timestamp": "03:14:41", "text": "それをやりたいんです。"}, {"type": "subtitle", "time": 11683.59, "timestamp": "03:14:43", "text": "うん。でも、それをやろうとすると、"}, {"type": "subtitle", "time": 11686.469, "timestamp": "03:14:46", "text": "「まあ、ちょっと"}, {"type": "subtitle", "time": 11689.11, "timestamp": "03:14:49", "text": "難しい。 「私たちはそれを手に入れるだろう。」でも私はこう思う"}, {"type": "subtitle", "time": 11691.11, "timestamp": "03:14:51", "text": "最も満足できるのは、"}, {"type": "subtitle", "time": 11693.349, "timestamp": "03:14:53", "text": "全てが終わった時の終わりは、「地獄」のようだ"}, {"type": "subtitle", "time": 11699.11, "timestamp": "03:14:59", "text": "ええ、そうしました。よお、行こうぜ。うん。"}]
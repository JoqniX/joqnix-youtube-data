[{"type": "subtitle", "time": 2053.51, "timestamp": "00:34:13", "text": "でも、"}, {"type": "subtitle", "time": 2057.27, "timestamp": "00:34:17", "text": "これは699Kですか？何てことだ。 70万。うん。"}, {"type": "subtitle", "time": 2059.75, "timestamp": "00:34:19", "text": "さよなら。"}, {"type": "subtitle", "time": 2062.869, "timestamp": "00:34:22", "text": "私は以前、自分のプライベートアカウントを見ていました。これ"}, {"type": "subtitle", "time": 2064.55, "timestamp": "00:34:24", "text": "これは私のジョークアカウントですよね？私はそうしなかった、私は"}, {"type": "subtitle", "time": 2068.31, "timestamp": "00:34:28", "text": "彼女の購読はしていないが、それでも"}, {"type": "subtitle", "time": 2072.069, "timestamp": "00:34:32", "text": "昔は、ええと、彼女を見てたの"}, {"type": "subtitle", "time": 2079.75, "timestamp": "00:34:39", "text": "何てことだ。"}, {"type": "subtitle", "time": 2081.43, "timestamp": "00:34:41", "text": "私は書き続けなければならない。私はすべきではない"}, {"type": "subtitle", "time": 2082.869, "timestamp": "00:34:42", "text": "話し続けてください。私はずっと話してきました"}, {"type": "subtitle", "time": 2085.75, "timestamp": "00:34:45", "text": "約40分。私は40分を無駄にした。"}, {"type": "subtitle", "time": 2087.829, "timestamp": "00:34:47", "text": "何てことだ。"}, {"type": "subtitle", "time": 2092.629, "timestamp": "00:34:52", "text": "私を悩ませて。右。"}, {"type": "subtitle", "time": 2094.31, "timestamp": "00:34:54", "text": "わかった。私は戻ります。私は戻る"}, {"type": "subtitle", "time": 2097.03, "timestamp": "00:34:57", "text": "書き込み。殴られそうだ"}]
[{"type": "subtitle", "time": 1800.87, "timestamp": "00:30:00", "text": "ああ、ビットレートが上がってきて"}, {"type": "subtitle", "time": 1803.51, "timestamp": "00:30:03", "text": "このダウンロードが原因でダウンしています。"}, {"type": "subtitle", "time": 1809.51, "timestamp": "00:30:09", "text": "ニース。"}, {"type": "subtitle", "time": 1812.47, "timestamp": "00:30:12", "text": "ええ、皆さんは聞きましたか？"}, {"type": "subtitle", "time": 1819.43, "timestamp": "00:30:19", "text": "知らない人のために説明すると、"}, {"type": "subtitle", "time": 1824.23, "timestamp": "00:30:24", "text": "今日は土曜日です。なぜ、なぜ私は"}, {"type": "subtitle", "time": 1825.99, "timestamp": "00:30:25", "text": "軽くたたく？チャットで話しているから、"}, {"type": "subtitle", "time": 1828.23, "timestamp": "00:30:28", "text": "右？チャットで話す人は、"}, {"type": "subtitle", "time": 1830.31, "timestamp": "00:30:30", "text": "頭をパタパタと叩いた。"}, {"type": "subtitle", "time": 1834.23, "timestamp": "00:30:34", "text": "うん。つまり、これが最新の噂話だ。"}, {"type": "subtitle", "time": 1837.029, "timestamp": "00:30:37", "text": "えーと、最近の噂話は誰の最近の噂話ですか"}, {"type": "subtitle", "time": 1842.149, "timestamp": "00:30:42", "text": "実際、誰がひどく打撃を受けるのか。はい。"}, {"type": "subtitle", "time": 1844.23, "timestamp": "00:30:44", "text": "そうですね、"}, {"type": "subtitle", "time": 1846.789, "timestamp": "00:30:46", "text": "Vumingを知らない人のために"}, {"type": "subtitle", "time": 1850.23, "timestamp": "00:30:50", "text": "悲しい日だ。雨の日です"}, {"type": "subtitle", "time": 1854.63, "timestamp": "00:30:54", "text": "なぜならOGの1人、いやOGヘブンリー"}, {"type": "subtitle", "time": 1858.47, "timestamp": "00:30:58", "text": "ヘブンリー・キングスは引退します"}]
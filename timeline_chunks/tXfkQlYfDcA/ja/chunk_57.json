[{"type": "subtitle", "time": 3423.589, "timestamp": "00:57:03", "text": "そう、だから音楽も消えたんだ"}, {"type": "subtitle", "time": 3425.78, "timestamp": "00:57:05", "text": "理論"}, {"type": "subtitle", "time": 3435.109, "timestamp": "00:57:15", "text": "でも待って、音楽理論にも"}, {"type": "subtitle", "time": 3437.51, "timestamp": "00:57:17", "text": "理論的な内容が多い。もちろん、"}, {"type": "subtitle", "time": 3440.069, "timestamp": "00:57:20", "text": "必要なものは揃っている。"}, {"type": "subtitle", "time": 3443.109, "timestamp": "00:57:23", "text": "ああ、痛い。"}, {"type": "subtitle", "time": 3445.91, "timestamp": "00:57:25", "text": "あなたの持ち物すべてに、その物が入っているでしょう。私"}, {"type": "subtitle", "time": 3454.23, "timestamp": "00:57:34", "text": "そして"}, {"type": "subtitle", "time": 3474.87, "timestamp": "00:57:54", "text": "そうそう。ああ、君のプロジェクトはどう？"}, {"type": "subtitle", "time": 3477.19, "timestamp": "00:57:57", "text": "作業中ですか？それはあなたができたことですか"}, {"type": "subtitle", "time": 3479.829, "timestamp": "00:57:59", "text": "仕事とか全部終わらせた？"}]
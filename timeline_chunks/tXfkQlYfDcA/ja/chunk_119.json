[{"type": "subtitle", "time": 7141.35, "timestamp": "01:59:01", "text": "休むことも、止めることもできない"}, {"type": "subtitle", "time": 7144.07, "timestamp": "01:59:04", "text": "書いているけど、手を動かせない"}, {"type": "subtitle", "time": 7146.87, "timestamp": "01:59:06", "text": "休む"}, {"type": "subtitle", "time": 7148.87, "timestamp": "01:59:08", "text": "あまりにも。"}, {"type": "subtitle", "time": 7151.51, "timestamp": "01:59:11", "text": "12時間。まるで私が座ろうとしているみたいだ"}, {"type": "subtitle", "time": 7153.99, "timestamp": "01:59:13", "text": "ここに12時間滞在します。一度に座るような"}, {"type": "subtitle", "time": 7156.07, "timestamp": "01:59:16", "text": "あれ。"}, {"type": "subtitle", "time": 7158.229, "timestamp": "01:59:18", "text": "でも、また、私は自分の体を鍛えて"}, {"type": "subtitle", "time": 7162.55, "timestamp": "01:59:22", "text": "それに耐える。あと2日。"}, {"type": "subtitle", "time": 7165.189, "timestamp": "01:59:25", "text": "あと2日間、苦難が続く。あと2日"}, {"type": "subtitle", "time": 7167.43, "timestamp": "01:59:27", "text": "2時間分の配信"}, {"type": "subtitle", "time": 7171.35, "timestamp": "01:59:31", "text": "大丈夫だよ。終わりました。私は推測する"}, {"type": "subtitle", "time": 7173.589, "timestamp": "01:59:33", "text": "私は自分が手に入れることについて考える必要はありません"}, {"type": "subtitle", "time": 7176.629, "timestamp": "01:59:36", "text": "病気。もし私が自分のことを考えるなら、もし私が考えるなら"}, {"type": "subtitle", "time": 7180.229, "timestamp": "01:59:40", "text": "実際、病気とかそういうことについて"}, {"type": "subtitle", "time": 7182.07, "timestamp": "01:59:42", "text": "病気になって実際に嘔吐が止まる"}, {"type": "subtitle", "time": 7185.91, "timestamp": "01:59:45", "text": "周りの様子とか、そういうこと全部。"}, {"type": "subtitle", "time": 7188.229, "timestamp": "01:59:48", "text": "ああ、病気になるなんて考えちゃいけないな"}, {"type": "subtitle", "time": 7191.189, "timestamp": "01:59:51", "text": "飲食中。"}, {"type": "subtitle", "time": 7194.229, "timestamp": "01:59:54", "text": "それは辛いことかもしれない。"}, {"type": "subtitle", "time": 7196.149, "timestamp": "01:59:56", "text": "繰り返しますが、遺言書があれば、"}]
[{"type": "subtitle", "time": 8702.469, "timestamp": "02:25:02", "text": "そういうことばかり。うん。今私は"}, {"type": "subtitle", "time": 8705.83, "timestamp": "02:25:05", "text": "今の私の困難は、読まなければならないことです"}, {"type": "subtitle", "time": 8707.75, "timestamp": "02:25:07", "text": "問題用紙と"}, {"type": "subtitle", "time": 8711.11, "timestamp": "02:25:11", "text": "今、試験の勉強をしなければならない。"}, {"type": "subtitle", "time": 8714.87, "timestamp": "02:25:14", "text": "うん。ああ、なんてことだ、怖い。うん。だから私は"}, {"type": "subtitle", "time": 8717.67, "timestamp": "02:25:17", "text": "もっと読んで練習する必要があるし、"}, {"type": "subtitle", "time": 8721.99, "timestamp": "02:25:21", "text": "文法面の作業と"}, {"type": "subtitle", "time": 8725.429, "timestamp": "02:25:25", "text": "もっと話してください。うん。右。右。ああ、"}, {"type": "subtitle", "time": 8728.07, "timestamp": "02:25:28", "text": "神。何をするつもりですか？"}, {"type": "subtitle", "time": 8730.15, "timestamp": "02:25:30", "text": "ジョーが話す。"}, {"type": "subtitle", "time": 8731.91, "timestamp": "02:25:31", "text": "うん。"}, {"type": "subtitle", "time": 8735.11, "timestamp": "02:25:35", "text": "うわー、すごい！のように"}, {"type": "subtitle", "time": 8737.349, "timestamp": "02:25:37", "text": "正直、心から尊敬します。学習のように"}, {"type": "subtitle", "time": 8739.99, "timestamp": "02:25:39", "text": "新しい言語を学ぶのは簡単ではないですよね？だから、"}, {"type": "subtitle", "time": 8741.67, "timestamp": "02:25:41", "text": "あなたはただここにいて、「うん、"}, {"type": "subtitle", "time": 8743.11, "timestamp": "02:25:43", "text": "何でも。私はただ学びたいだけです"}, {"type": "subtitle", "time": 8745.83, "timestamp": "02:25:45", "text": "全く新しい何かを完成させる。えっと"}, {"type": "subtitle", "time": 8748.07, "timestamp": "02:25:48", "text": "最終的にはその国へ旅行する"}, {"type": "subtitle", "time": 8750.87, "timestamp": "02:25:50", "text": "そして、その芸術を完璧にすることができるようになる。」"}, {"type": "subtitle", "time": 8752.87, "timestamp": "02:25:52", "text": "それは素晴らしいですね。"}, {"type": "subtitle", "time": 8756.55, "timestamp": "02:25:56", "text": "うん。そして、日本人だけでなく、"}, {"type": "subtitle", "time": 8758.469, "timestamp": "02:25:58", "text": "ビリー・ビリーのストリーム配信だよね？以前はよく＿＿していた"}]
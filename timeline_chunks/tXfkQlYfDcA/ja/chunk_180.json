[{"type": "subtitle", "time": 10800.469, "timestamp": "03:00:00", "text": "人気者向けの芸術。だから彼女は"}, {"type": "subtitle", "time": 10805.19, "timestamp": "03:00:05", "text": "彼女はますます忙しくなったが、それでも彼女は"}, {"type": "subtitle", "time": 10808.63, "timestamp": "03:00:08", "text": "私のモデルに最適で満足しています"}, {"type": "subtitle", "time": 10810.95, "timestamp": "03:00:10", "text": "初めてではあるけれど、"}, {"type": "subtitle", "time": 10813.99, "timestamp": "03:00:13", "text": "彼女は最善を尽くした。うん。右。うん。のように、"}, {"type": "subtitle", "time": 10816.71, "timestamp": "03:00:16", "text": "これは彼らにとって初めてのことではないようだ"}, {"type": "subtitle", "time": 10819.269, "timestamp": "03:00:19", "text": "VTuberモデルのような作品を作る。見た目"}, {"type": "subtitle", "time": 10821.429, "timestamp": "03:00:21", "text": "とても綺麗で、プロフェッショナルな印象です。私"}, {"type": "subtitle", "time": 10828.23, "timestamp": "03:00:28", "text": "うん。うまくいきますように"}, {"type": "subtitle", "time": 10831.99, "timestamp": "03:00:31", "text": "そして、何かが解明されることもある。"}, {"type": "subtitle", "time": 10834.55, "timestamp": "03:00:34", "text": "絶対に手放してはいけない。私が言いたいのはそれだけです"}, {"type": "subtitle", "time": 10836.63, "timestamp": "03:00:36", "text": "言えることは言えます。あなたは回復力があるね。あなたは"}, {"type": "subtitle", "time": 10841.59, "timestamp": "03:00:41", "text": "強い。ああ、君ならできるよ。うん。"}, {"type": "subtitle", "time": 10844.71, "timestamp": "03:00:44", "text": "うん。私はそれを壁紙にしていました"}, {"type": "subtitle", "time": 10847.99, "timestamp": "03:00:47", "text": "誕生日以来ずっと電話を使っている。そうだった"}, {"type": "subtitle", "time": 10850.71, "timestamp": "03:00:50", "text": "最高の誕生日プレゼント"}, {"type": "subtitle", "time": 10853.99, "timestamp": "03:00:53", "text": "持っている。とても貴重です。"}, {"type": "subtitle", "time": 10855.59, "timestamp": "03:00:55", "text": "うん。また、誕生日についても言及しますか？"}, {"type": "subtitle", "time": 10859.75, "timestamp": "03:00:59", "text": "8月11日ですか？ええ、8月11日です。おお、"}]
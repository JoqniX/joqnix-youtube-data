[{"type": "subtitle", "time": 8520.55, "timestamp": "02:22:00", "text": "でも、そうね。私の作品のほとんど"}, {"type": "subtitle", "time": 8522.15, "timestamp": "02:22:02", "text": "そして私の物のほとんどは、いつものように"}, {"type": "subtitle", "time": 8524.95, "timestamp": "02:22:04", "text": "夜。うん。だからあなたは"}, {"type": "subtitle", "time": 8530.79, "timestamp": "02:22:10", "text": "これはいつものタイミングですか？"}, {"type": "subtitle", "time": 8534.71, "timestamp": "02:22:14", "text": "えっと、私の配信タイミングは、通常のように"}, {"type": "subtitle", "time": 8538.71, "timestamp": "02:22:18", "text": "以前は朝に配信していた"}, {"type": "subtitle", "time": 8542.55, "timestamp": "02:22:22", "text": "午前10時とか、だって、だって私は"}, {"type": "subtitle", "time": 8546.07, "timestamp": "02:22:26", "text": "授業とか色々あったから"}, {"type": "subtitle", "time": 8548.95, "timestamp": "02:22:28", "text": "私が最後に経験したあの時"}, {"type": "subtitle", "time": 8550.63, "timestamp": "02:22:30", "text": "12月と私が持っていたもの"}, {"type": "subtitle", "time": 8554.07, "timestamp": "02:22:34", "text": "日本語教室。つまり、"}, {"type": "subtitle", "time": 8559.03, "timestamp": "02:22:39", "text": "夕方7時、えっと7時半から7時くらい、そう、7時、7時半"}, {"type": "subtitle", "time": 8561.99, "timestamp": "02:22:41", "text": "午後10くらいかな。そして今"}, {"type": "subtitle", "time": 8567.11, "timestamp": "02:22:47", "text": "入学は4月なので、"}, {"type": "subtitle", "time": 8570.389, "timestamp": "02:22:50", "text": "私が通っていたのは地元の学校のような学校でした。"}, {"type": "subtitle", "time": 8573.83, "timestamp": "02:22:53", "text": "それで私は合格した"}, {"type": "subtitle", "time": 8578.63, "timestamp": "02:22:58", "text": "彼らはやった、私はやった、ええと、JLPT N5を勉強した"}]
[{"type": "subtitle", "time": 662.069, "timestamp": "00:11:02", "text": "昨日の12時間配信。ほとんど"}, {"type": "subtitle", "time": 665.59, "timestamp": "00:11:05", "text": "終わり。もうすぐ終わります。"}, {"type": "subtitle", "time": 668.389, "timestamp": "00:11:08", "text": "それを2つに分割したりしないといけない。"}, {"type": "subtitle", "time": 672.47, "timestamp": "00:11:12", "text": "仕事量が多すぎる。しかし、私たちは今日それを実行します。"}, {"type": "subtitle", "time": 676.389, "timestamp": "00:11:16", "text": "そして、課題に基づいた内容です。私たちはする必要があります"}, {"type": "subtitle", "time": 679.99, "timestamp": "00:11:19", "text": "ここから始めましょう。"}, {"type": "subtitle", "time": 682.389, "timestamp": "00:11:22", "text": "私は文章を書くことから学び始める必要がある"}, {"type": "subtitle", "time": 687.269, "timestamp": "00:11:27", "text": "この部分からだと思う。"}, {"type": "subtitle", "time": 688.949, "timestamp": "00:11:28", "text": "待って、"}, {"type": "subtitle", "time": 692.31, "timestamp": "00:11:32", "text": "私は書き始めます"}, {"type": "subtitle", "time": 694.79, "timestamp": "00:11:34", "text": "この部分は全て完了しました。 2番"}, {"type": "subtitle", "time": 698.87, "timestamp": "00:11:38", "text": "質問、3番目の質問。"}, {"type": "subtitle", "time": 700.79, "timestamp": "00:11:40", "text": "3つ目の質問です。これを終えました"}, {"type": "subtitle", "time": 703.269, "timestamp": "00:11:43", "text": "昨日。"}, {"type": "subtitle", "time": 705.269, "timestamp": "00:11:45", "text": "4番目の質問から始めなければなりません"}, {"type": "subtitle", "time": 707.63, "timestamp": "00:11:47", "text": "先へ。うん、"}, {"type": "subtitle", "time": 709.91, "timestamp": "00:11:49", "text": "[音楽]"}, {"type": "subtitle", "time": 712.47, "timestamp": "00:11:52", "text": "字幕の作業をきちんとやらせてください"}]
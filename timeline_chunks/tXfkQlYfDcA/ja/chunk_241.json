[{"type": "subtitle", "time": 14463.03, "timestamp": "04:01:03", "text": "以前のPCが故障したので、ストリーミングPCに切り替えました。えっと"}, {"type": "subtitle", "time": 14466.07, "timestamp": "04:01:06", "text": "なんてこった。私は今の自分のことを好きでなければならない"}, {"type": "subtitle", "time": 14468.79, "timestamp": "04:01:08", "text": "あまり使ってないよ、制限しないといけないから"}, {"type": "subtitle", "time": 14471.67, "timestamp": "04:01:11", "text": "私が配信中に使うアプリケーション。"}, {"type": "subtitle", "time": 14475.67, "timestamp": "04:01:15", "text": "えっと、OBS、何度も改良しなければならなかったんです"}, {"type": "subtitle", "time": 14478.79, "timestamp": "04:01:18", "text": "回。 OBSに関しては、私は"}, {"type": "subtitle", "time": 14481.269, "timestamp": "04:01:21", "text": "やりすぎる、たくさん加える"}, {"type": "subtitle", "time": 14484.15, "timestamp": "04:01:24", "text": "プラグインを使って、たくさんのエフェクトなどを作る"}, {"type": "subtitle", "time": 14487.189, "timestamp": "04:01:27", "text": "スシドラゴンがやったように。そして私は気づいた、"}, {"type": "subtitle", "time": 14492.15, "timestamp": "04:01:32", "text": "うん、CPUの過負荷はよく起こるし"}, {"type": "subtitle", "time": 14495.269, "timestamp": "04:01:35", "text": "全てを手に入れることはできない。私は昔"}, {"type": "subtitle", "time": 14497.349, "timestamp": "04:01:37", "text": "本当にクールなチャンネルポイントがあり、"}, {"type": "subtitle", "time": 14500.389, "timestamp": "04:01:40", "text": "人々が主張できるもの"}, {"type": "subtitle", "time": 14502.229, "timestamp": "04:01:42", "text": "チャンネルポイントを交換して私の"}, {"type": "subtitle", "time": 14505.51, "timestamp": "04:01:45", "text": "パソコンとかそういうもの。"}, {"type": "subtitle", "time": 14508.71, "timestamp": "04:01:48", "text": "どうすればそれが機能するようになるんですか？"}, {"type": "subtitle", "time": 14511.269, "timestamp": "04:01:51", "text": "ああ、使ったものがたくさん"}, {"type": "subtitle", "time": 14515.11, "timestamp": "04:01:55", "text": "実験するために、私は諦めなければなりませんでした"}, {"type": "subtitle", "time": 14518.07, "timestamp": "04:01:58", "text": "それら全て。うん、そうだね。"}, {"type": "subtitle", "time": 14519.59, "timestamp": "04:01:59", "text": "私はこう思うだろう、"}]
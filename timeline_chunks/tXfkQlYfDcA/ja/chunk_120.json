[{"type": "subtitle", "time": 7201.03, "timestamp": "02:00:01", "text": "昔から言われているように、物事はいつだってそういうものですよね？"}, {"type": "subtitle", "time": 7204.709, "timestamp": "02:00:04", "text": "ジョイがこれをやってくれる"}, {"type": "subtitle", "time": 7208.55, "timestamp": "02:00:08", "text": "男。気分が悪くなりそうだった"}, {"type": "subtitle", "time": 7212.95, "timestamp": "02:00:12", "text": "お茶を飲んでいると疲れる"}, {"type": "subtitle", "time": 7215.51, "timestamp": "02:00:15", "text": "そして、何かを感じる。私は"}, {"type": "subtitle", "time": 7217.669, "timestamp": "02:00:17", "text": "わからない。私は感じる"}, {"type": "subtitle", "time": 7220.629, "timestamp": "02:00:20", "text": "なんだか変な感じがする。ああ、"}, {"type": "subtitle", "time": 7228.98, "timestamp": "02:00:28", "text": "待って。"}, {"type": "subtitle", "time": 7231.27, "timestamp": "02:00:31", "text": "[音楽]"}, {"type": "subtitle", "time": 7246.79, "timestamp": "02:00:46", "text": "クラス"}, {"type": "subtitle", "time": 7249.43, "timestamp": "02:00:49", "text": "ベース"}, {"type": "subtitle", "time": 7256.229, "timestamp": "02:00:56", "text": "階層化の。"}, {"type": "subtitle", "time": 7258.95, "timestamp": "02:00:58", "text": "協会"}]
[{"type": "subtitle", "time": 9420.87, "timestamp": "02:37:00", "text": "名前。つまり、それが基本的な選択肢です。おお"}, {"type": "subtitle", "time": 9425.99, "timestamp": "02:37:05", "text": "我が神よ。ああ、それは正気の沙汰じゃない。だから唯一の"}, {"type": "subtitle", "time": 9428.95, "timestamp": "02:37:08", "text": "正しい方法はチャンネルを登録することです"}, {"type": "subtitle", "time": 9433.11, "timestamp": "02:37:13", "text": "個人事業主として、"}, {"type": "subtitle", "time": 9436.469, "timestamp": "02:37:16", "text": "当座預金口座ですよね？それは"}, {"type": "subtitle", "time": 9440.309, "timestamp": "02:37:20", "text": "選択肢があって、ああ、痛いなと思いました。だから私は"}, {"type": "subtitle", "time": 9443.91, "timestamp": "02:37:23", "text": "私はこう言った、私が"}, {"type": "subtitle", "time": 9445.67, "timestamp": "02:37:25", "text": "YouTubeパートナーになれば、"}, {"type": "subtitle", "time": 9448.15, "timestamp": "02:37:28", "text": "YouTube のユーザーにとってより簡単になるように"}, {"type": "subtitle", "time": 9450.87, "timestamp": "02:37:30", "text": "送ってもいいですよ。大金は要りません。その"}, {"type": "subtitle", "time": 9453.27, "timestamp": "02:37:33", "text": "むしろ、あなたが望むことは何でもできるような感じ"}, {"type": "subtitle", "time": 9456.71, "timestamp": "02:37:36", "text": "少なくとも1ルピーを共有するのも"}, {"type": "subtitle", "time": 9459.27, "timestamp": "02:37:39", "text": "良い。私はお金はいらない。むしろこうだ"}, {"type": "subtitle", "time": 9461.429, "timestamp": "02:37:41", "text": "私は幸運な人々に感謝します"}, {"type": "subtitle", "time": 9463.51, "timestamp": "02:37:43", "text": "川にやって来て、幸運と"}, {"type": "subtitle", "time": 9466.07, "timestamp": "02:37:46", "text": "もの。いいえ。そういうことです。右。右。"}, {"type": "subtitle", "time": 9469.59, "timestamp": "02:37:49", "text": "Twitchは多額の費用がかかる。"}, {"type": "subtitle", "time": 9472.87, "timestamp": "02:37:52", "text": "何てことだ。うん。カットとか色々あるよ"}, {"type": "subtitle", "time": 9476.55, "timestamp": "02:37:56", "text": "そこにも。だから私は「ああ、そうだね」って感じだった"}, {"type": "subtitle", "time": 9479.27, "timestamp": "02:37:59", "text": "みんなはそれを私と"}]
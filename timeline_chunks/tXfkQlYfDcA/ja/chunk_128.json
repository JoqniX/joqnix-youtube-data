[{"type": "subtitle", "time": 7685.03, "timestamp": "02:08:05", "text": "待つ。"}, {"type": "subtitle", "time": 7687.589, "timestamp": "02:08:07", "text": "[音楽]"}, {"type": "subtitle", "time": 7690.95, "timestamp": "02:08:10", "text": "これで思い出したのは、私が"}, {"type": "subtitle", "time": 7694.229, "timestamp": "02:08:14", "text": "森林コラボレーション中に"}, {"type": "subtitle", "time": 7696.87, "timestamp": "02:08:16", "text": "ニャーとマッチ"}, {"type": "subtitle", "time": 7705.109, "timestamp": "02:08:25", "text": "そして彼らが来たとき、私は泣いていました"}, {"type": "subtitle", "time": 7707.669, "timestamp": "02:08:27", "text": "またはそれらの"}, {"type": "subtitle", "time": 7709.99, "timestamp": "02:08:29", "text": "えーと、人々が来た"}, {"type": "subtitle", "time": 7727.27, "timestamp": "02:08:47", "text": "[音楽]"}, {"type": "subtitle", "time": 7737.589, "timestamp": "02:08:57", "text": "Jedで最高のゲーム。はい。"}]
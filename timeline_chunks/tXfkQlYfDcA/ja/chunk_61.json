[{"type": "subtitle", "time": 3661.23, "timestamp": "01:01:01", "text": "会議ほどかっこよくはない。"}, {"type": "subtitle", "time": 3671.75, "timestamp": "01:01:11", "text": "待って、それは便利だ。あ、待って。あなたはできる"}, {"type": "subtitle", "time": 3674.15, "timestamp": "01:01:14", "text": "スマホに入れればいいだけですよね？の"}, {"type": "subtitle", "time": 3676.789, "timestamp": "01:01:16", "text": "正しい時刻。待って、待って、待って、待って、"}, {"type": "subtitle", "time": 3679.99, "timestamp": "01:01:19", "text": "待って、待って。あなたは待ちますか。"}, {"type": "subtitle", "time": 3683.51, "timestamp": "01:01:23", "text": "時計は1時間後には戻ります"}, {"type": "subtitle", "time": 3685.67, "timestamp": "01:01:25", "text": "冬は戻ってきて、春には1時間だけ。"}, {"type": "subtitle", "time": 3689.19, "timestamp": "01:01:29", "text": "それはまるで人々が手作業でやっているようなものだ"}, {"type": "subtitle", "time": 3693.109, "timestamp": "01:01:33", "text": "すべて自動的に行われます。のように、"}, {"type": "subtitle", "time": 3695.109, "timestamp": "01:01:35", "text": "待って、自動的に"}, {"type": "subtitle", "time": 3699.19, "timestamp": "01:01:39", "text": "する？いや、いや、待って。待って。それはまるで"}, {"type": "subtitle", "time": 3701.43, "timestamp": "01:01:41", "text": "これで直ったんですよね？ UTCプラスのような"}, {"type": "subtitle", "time": 3704.71, "timestamp": "01:01:44", "text": "5時30分。タイムゾーンの君は私の"}, {"type": "subtitle", "time": 3708.95, "timestamp": "01:01:48", "text": "あれ。えっと、手動ですか、それとも"}, {"type": "subtitle", "time": 3715.91, "timestamp": "01:01:55", "text": "私にはタイムストーンが全く理解できない。その"}, {"type": "subtitle", "time": 3717.47, "timestamp": "01:01:57", "text": "痛み。"}, {"type": "subtitle", "time": 3718.789, "timestamp": "01:01:58", "text": "[音楽]"}]
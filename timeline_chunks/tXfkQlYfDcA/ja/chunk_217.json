[{"type": "subtitle", "time": 13020.95, "timestamp": "03:37:00", "text": "時間をかけてセットアップを改良して、"}, {"type": "subtitle", "time": 13024.229, "timestamp": "03:37:04", "text": "えーと、まず、えーと、まず、どうやって"}, {"type": "subtitle", "time": 13026.309, "timestamp": "03:37:06", "text": "私の理解は合っていますか？どう言えばいいですか？すべてと同じように"}, {"type": "subtitle", "time": 13029.99, "timestamp": "03:37:09", "text": "初めてユーザーがリストに追加されます"}, {"type": "subtitle", "time": 13031.99, "timestamp": "03:37:11", "text": "この人が来たように、この人が来た"}, {"type": "subtitle", "time": 13034.07, "timestamp": "03:37:14", "text": "この時期とか、そういうこと。そうして私は"}, {"type": "subtitle", "time": 13035.91, "timestamp": "03:37:15", "text": "今は全員をタグ付けできます"}, {"type": "subtitle", "time": 13038.469, "timestamp": "03:37:18", "text": "上にスクロールして、すべてが"}, {"type": "subtitle", "time": 13042.87, "timestamp": "03:37:22", "text": "そんな感じ。それはとても役に立ちました。それで、えっと"}, {"type": "subtitle", "time": 13045.03, "timestamp": "03:37:25", "text": "主に節度を保つため"}, {"type": "subtitle", "time": 13047.03, "timestamp": "03:37:27", "text": "そして、これらを振り返ると"}, {"type": "subtitle", "time": 13050.229, "timestamp": "03:37:30", "text": "メッセージと懐かしさ、そう、これ"}, {"type": "subtitle", "time": 13053.11, "timestamp": "03:37:33", "text": "視聴者は3年ほど前に訪れました。ああ、私は"}, {"type": "subtitle", "time": 13057.349, "timestamp": "03:37:37", "text": "今でもそういうメッセージを覚えています。"}, {"type": "subtitle", "time": 13060.71, "timestamp": "03:37:40", "text": "うん、可愛いね。そんな感じ。文字通り"}, {"type": "subtitle", "time": 13064.63, "timestamp": "03:37:44", "text": "まるで思い出の道を歩いているようだ。はぁ。うん。"}, {"type": "subtitle", "time": 13067.67, "timestamp": "03:37:47", "text": "そして、ラップレスには"}, {"type": "subtitle", "time": 13070.95, "timestamp": "03:37:50", "text": "何かをする機会、つまり能力"}, {"type": "subtitle", "time": 13074.469, "timestamp": "03:37:54", "text": "適切な人がいないので、そのように"}, {"type": "subtitle", "time": 13076.87, "timestamp": "03:37:56", "text": "これらのストリームすべてについて"}, {"type": "subtitle", "time": 13078.71, "timestamp": "03:37:58", "text": "これらの人々は今、全員がそうではない"}]
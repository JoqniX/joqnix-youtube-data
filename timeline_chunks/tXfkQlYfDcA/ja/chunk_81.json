[{"type": "subtitle", "time": 4865.59, "timestamp": "01:21:05", "text": "今日はDSA（歯科診療所）があります。これは何と呼ばれるものですか"}, {"type": "subtitle", "time": 4869.669, "timestamp": "01:21:09", "text": "ドーシャマサラドーシャ？私はそうは思わない"}, {"type": "subtitle", "time": 4873.35, "timestamp": "01:21:13", "text": "知る。私はそれを自分のものから食べなければならない"}, {"type": "subtitle", "time": 4875.75, "timestamp": "01:21:15", "text": "手を使いたくない。"}, {"type": "subtitle", "time": 4879.189, "timestamp": "01:21:19", "text": "休憩時間だよ、君か"}, {"type": "subtitle", "time": 4887.83, "timestamp": "01:21:27", "text": "私は自分の便利なダンディを手元に置いておいてよかった"}, {"type": "subtitle", "time": 4889.91, "timestamp": "01:21:29", "text": "スプーン、フォーク、ナイフ、私の"}, {"type": "subtitle", "time": 4891.669, "timestamp": "01:21:31", "text": "部屋。"}, {"type": "subtitle", "time": 4893.75, "timestamp": "01:21:33", "text": "髪をグレーに染めたいですか？私"}, {"type": "subtitle", "time": 4897.03, "timestamp": "01:21:37", "text": "わからない。いいえ。ええ、灰色ではありません。"}, {"type": "subtitle", "time": 4904.55, "timestamp": "01:21:44", "text": "親切なことだと言えるでしょう。"}, {"type": "subtitle", "time": 4906.63, "timestamp": "01:21:46", "text": "何てことだ。なぜ壊れるのがそんなに難しいのか"}, {"type": "subtitle", "time": 4909.189, "timestamp": "01:21:49", "text": "下？"}, {"type": "subtitle", "time": 4911.91, "timestamp": "01:21:51", "text": "何てことだ。ドーシャって難しいよね。は"}, {"type": "subtitle", "time": 4914.07, "timestamp": "01:21:54", "text": "それは私の得意分野？うわー、暑いね。なぜ"}, {"type": "subtitle", "time": 4917.91, "timestamp": "01:21:57", "text": "スプーンで分解するのは暑いですか"}, {"type": "subtitle", "time": 4919.5, "timestamp": "01:21:59", "text": "そしてそこに"}]
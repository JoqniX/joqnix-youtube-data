[{"type": "subtitle", "time": 4144.309, "timestamp": "01:09:04", "text": "社会"}, {"type": "subtitle", "time": 4146.95, "timestamp": "01:09:06", "text": "さらに。社会的なものを見ている"}, {"type": "subtitle", "time": 4149.189, "timestamp": "01:09:09", "text": "また。何てことだ。私は何回"}, {"type": "subtitle", "time": 4152.39, "timestamp": "01:09:12", "text": "昨日、社会について書いた？あ、待って。私の"}, {"type": "subtitle", "time": 4156.87, "timestamp": "01:09:16", "text": "ペンは違います。待って、このペン使い切ったっけ？"}, {"type": "subtitle", "time": 4161.03, "timestamp": "01:09:21", "text": "ああ、無理です。待って、このペン使い切ったよ。"}, {"type": "subtitle", "time": 4163.59, "timestamp": "01:09:23", "text": "えっと、ちょっと待って。このペンを使い切った。わかった、"}, {"type": "subtitle", "time": 4166.709, "timestamp": "01:09:26", "text": "ペンが1本減りました。 1人倒れた。私たちは"}, {"type": "subtitle", "time": 4170.07, "timestamp": "01:09:30", "text": "補充が必要です。待って、実際に"}, {"type": "subtitle", "time": 4176.39, "timestamp": "01:09:36", "text": "待って。本当に終わったの？ああ、それは"}, {"type": "subtitle", "time": 4179.99, "timestamp": "01:09:39", "text": "実際に終わった。おお。"}, {"type": "subtitle", "time": 4181.51, "timestamp": "01:09:41", "text": "私は気にしない。私は行くつもりです"}, {"type": "subtitle", "time": 4190.39, "timestamp": "01:09:50", "text": "ペンの隣には"}]
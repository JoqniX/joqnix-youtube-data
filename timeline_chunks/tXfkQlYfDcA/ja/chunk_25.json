[{"type": "subtitle", "time": 1502.71, "timestamp": "00:25:02", "text": "私のチャンネルに時間があるよね？それで、"}, {"type": "subtitle", "time": 1504.149, "timestamp": "00:25:04", "text": "今日はどうやって私を見つけたのですか？"}, {"type": "subtitle", "time": 1505.99, "timestamp": "00:25:05", "text": "あなた？"}, {"type": "subtitle", "time": 1519.59, "timestamp": "00:25:19", "text": "[音楽]"}, {"type": "subtitle", "time": 1526.47, "timestamp": "00:25:26", "text": "わかった、"}, {"type": "subtitle", "time": 1528.549, "timestamp": "00:25:28", "text": "全てを投稿したわけではありません"}, {"type": "subtitle", "time": 1532.39, "timestamp": "00:25:32", "text": "今日は色々あったよね？はい、そうしました。こんにちは。えっと、"}, {"type": "subtitle", "time": 1533.99, "timestamp": "00:25:33", "text": "ようこそ、執筆活動に戻ってきてください"}, {"type": "subtitle", "time": 1537.59, "timestamp": "00:25:37", "text": "アニメーション。完全に遅れます。えっと"}, {"type": "subtitle", "time": 1539.51, "timestamp": "00:25:39", "text": "この2つの科目を終わらせる必要がある"}, {"type": "subtitle", "time": 1542.87, "timestamp": "00:25:42", "text": "今日。昨日、私たちはなんとかやり遂げました"}, {"type": "subtitle", "time": 1545.269, "timestamp": "00:25:45", "text": "4つ目の質問へ。"}, {"type": "subtitle", "time": 1547.11, "timestamp": "00:25:47", "text": "今度は、終わらせる必要があることを思い出さなければならない"}, {"type": "subtitle", "time": 1552.39, "timestamp": "00:25:52", "text": "残りの7人の男はなぜ"}, {"type": "subtitle", "time": 1554.789, "timestamp": "00:25:54", "text": "大丈夫です。私たちは終わった。私たちは"}, {"type": "subtitle", "time": 1557.909, "timestamp": "00:25:57", "text": "最高。ということで、今日の配信では"}]
[{"type": "subtitle", "time": 3251.109, "timestamp": "00:54:11", "text": "[音楽]"}, {"type": "subtitle", "time": 3253.349, "timestamp": "00:54:13", "text": "元気ですか？"}, {"type": "subtitle", "time": 3261.349, "timestamp": "00:54:21", "text": "調子はどうですか？"}, {"type": "subtitle", "time": 3263.349, "timestamp": "00:54:23", "text": "お元気でお過ごしでしょうか。もう遅いんじゃない？"}, {"type": "subtitle", "time": 3266.79, "timestamp": "00:54:26", "text": "あなたのために？あなたは寝るべきですか？"}, {"type": "subtitle", "time": 3269.589, "timestamp": "00:54:29", "text": "疑問符。"}, {"type": "subtitle", "time": 3276.23, "timestamp": "00:54:36", "text": "今日は楽しんでいただけたでしょうか。"}, {"type": "subtitle", "time": 3278.47, "timestamp": "00:54:38", "text": "おはよう、ジョー。私はジェニです。願わくば"}, {"type": "subtitle", "time": 3280.39, "timestamp": "00:54:40", "text": "あまりにも。はい、"}, {"type": "subtitle", "time": 3282.79, "timestamp": "00:54:42", "text": "元気です。スピードランニング"}, {"type": "subtitle", "time": 3285.75, "timestamp": "00:54:45", "text": "課題。痛み"}, {"type": "subtitle", "time": 3288.79, "timestamp": "00:54:48", "text": "大学生活は大変だ"}, {"type": "subtitle", "time": 3291.19, "timestamp": "00:54:51", "text": "君は覚えているだろう、あの時のことを。"}, {"type": "subtitle", "time": 3294.47, "timestamp": "00:54:54", "text": "あなたがやって来て、私は"}, {"type": "subtitle", "time": 3297.349, "timestamp": "00:54:57", "text": "初めてのような日々に"}, {"type": "subtitle", "time": 3299.109, "timestamp": "00:54:59", "text": "最初の３つ２つまたは"}]
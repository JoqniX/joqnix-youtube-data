[{"type": "subtitle", "time": 2401.75, "timestamp": "00:40:01", "text": "はい、書かなければならない質問が2つあります。"}, {"type": "subtitle", "time": 2417.829, "timestamp": "00:40:17", "text": "見て"}, {"type": "subtitle", "time": 2419.349, "timestamp": "00:40:19", "text": "で"}, {"type": "subtitle", "time": 2423.67, "timestamp": "00:40:23", "text": "それぞれが。待って、アディティの質問に答えたっけ？"}, {"type": "subtitle", "time": 2427.829, "timestamp": "00:40:27", "text": "質問したのか、しなかったのか？忘れた。"}, {"type": "subtitle", "time": 2430.55, "timestamp": "00:40:30", "text": "そして彼が戻ってきたら、私はおそらく"}, {"type": "subtitle", "time": 2436.87, "timestamp": "00:40:36", "text": "もう一度話して答えてください。うん。うん。"}, {"type": "subtitle", "time": 2439.46, "timestamp": "00:40:39", "text": "ごく簡単に。"}, {"type": "subtitle", "time": 2440.87, "timestamp": "00:40:40", "text": "[音楽]"}, {"type": "subtitle", "time": 2443.43, "timestamp": "00:40:43", "text": "最初のもの"}, {"type": "subtitle", "time": 2446.95, "timestamp": "00:40:46", "text": "人種／民族"}, {"type": "subtitle", "time": 2452.31, "timestamp": "00:40:52", "text": "そして都市。それで、私たちが話していたように"}, {"type": "subtitle", "time": 2455.349, "timestamp": "00:40:55", "text": "その時ストリームが途絶えた"}, {"type": "subtitle", "time": 2457.99, "timestamp": "00:40:57", "text": "停電のため。"}]
[{"type": "subtitle", "time": 10143.03, "timestamp": "02:49:03", "text": "見る。ええ、お気持ちはよく分かります。大丈夫。その"}, {"type": "subtitle", "time": 10146.469, "timestamp": "02:49:06", "text": "わかった。うん。心配ない。分かりますよ。その"}, {"type": "subtitle", "time": 10150.469, "timestamp": "02:49:10", "text": "どちらかというと、えーっと、もう見せたと思う"}, {"type": "subtitle", "time": 10152.87, "timestamp": "02:49:12", "text": "最初は数人に"}, {"type": "subtitle", "time": 10157.429, "timestamp": "02:49:17", "text": "ジョアソンの時にちょっと匂わせたかったんだけど"}, {"type": "subtitle", "time": 10159.75, "timestamp": "02:49:19", "text": "えーと、だって、えーと"}, {"type": "subtitle", "time": 10161.83, "timestamp": "02:49:21", "text": "舞台裏での複雑な事情"}, {"type": "subtitle", "time": 10164.71, "timestamp": "02:49:24", "text": "その物資と、私はライセンスを取得する必要がありました"}, {"type": "subtitle", "time": 10167.03, "timestamp": "02:49:27", "text": "それを見せることができ、そして多くの"}, {"type": "subtitle", "time": 10171.429, "timestamp": "02:49:31", "text": "もの。何？うん。え、何？私はしません"}, {"type": "subtitle", "time": 10173.349, "timestamp": "02:49:33", "text": "知る。おお。状況は悪化している"}, {"type": "subtitle", "time": 10176.51, "timestamp": "02:49:36", "text": "ここは複雑だ。"}, {"type": "subtitle", "time": 10182.63, "timestamp": "02:49:42", "text": "はい、DMを送りました。つまり"}, {"type": "subtitle", "time": 10184.63, "timestamp": "02:49:44", "text": "起こった。"}, {"type": "subtitle", "time": 10186.63, "timestamp": "02:49:46", "text": "まあまあ"}, {"type": "subtitle", "time": 10190.23, "timestamp": "02:49:50", "text": "なんてこった、"}, {"type": "subtitle", "time": 10193.83, "timestamp": "02:49:53", "text": "私は自分の方向へ進んでいるので。"}]
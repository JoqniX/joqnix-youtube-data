[{"type": "subtitle", "time": 3720.95, "timestamp": "01:02:00", "text": "でも、確かに不便なことは全くないですね。まるで"}, {"type": "subtitle", "time": 3722.71, "timestamp": "01:02:02", "text": "それはあなたの両親か何か"}, {"type": "subtitle", "time": 3726.23, "timestamp": "01:02:06", "text": "あなたの中で、あるいはそれは、えーと、すべての"}, {"type": "subtitle", "time": 3729.03, "timestamp": "01:02:09", "text": "あなたの時計"}, {"type": "subtitle", "time": 3732.15, "timestamp": "01:02:12", "text": "えーと、あなたの部屋にある時計は全部、"}, {"type": "subtitle", "time": 3735.03, "timestamp": "01:02:15", "text": "えーっと、入れる、入れる、えーっと、変えるだけ"}, {"type": "subtitle", "time": 3739.99, "timestamp": "01:02:19", "text": "1時間前にする時間"}, {"type": "subtitle", "time": 3743.27, "timestamp": "01:02:23", "text": "などなど。あなたの携帯電話の時計でさえ、"}, {"type": "subtitle", "time": 3745.67, "timestamp": "01:02:25", "text": "まるであなたが生きているかのように"}, {"type": "subtitle", "time": 3748.95, "timestamp": "01:02:28", "text": "ライフスタイル。ちょうど1時間進んでいるような感じです。"}, {"type": "subtitle", "time": 3751.27, "timestamp": "01:02:31", "text": "「あ、待って。"}, {"type": "subtitle", "time": 3753.67, "timestamp": "01:02:33", "text": "準備ができて。私は午前5時に起きます。でもそれは"}, {"type": "subtitle", "time": 3756.069, "timestamp": "01:02:36", "text": "すでにそうなっているが、実際には、あなたは目を覚ました"}, {"type": "subtitle", "time": 3758.309, "timestamp": "01:02:38", "text": "午前4時"}, {"type": "subtitle", "time": 3761.19, "timestamp": "01:02:41", "text": "「そんな感じ。」だから、でも、やらなきゃいけない"}, {"type": "subtitle", "time": 3763.829, "timestamp": "01:02:43", "text": "家にある他のすべての時計にも適用されます。"}, {"type": "subtitle", "time": 3765.75, "timestamp": "01:02:45", "text": "おお、"}, {"type": "subtitle", "time": 3767.99, "timestamp": "01:02:47", "text": "それは痛みだ。"}, {"type": "subtitle", "time": 3770.549, "timestamp": "01:02:50", "text": "この線はいつも音楽をより愛している"}, {"type": "subtitle", "time": 3774.309, "timestamp": "01:02:54", "text": "音楽を妨げるものは何もない。"}]
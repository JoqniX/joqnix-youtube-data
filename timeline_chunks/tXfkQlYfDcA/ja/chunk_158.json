[{"type": "subtitle", "time": 9481.429, "timestamp": "02:38:01", "text": "もの。ご自身でお使いください。だから私は"}, {"type": "subtitle", "time": 9483.429, "timestamp": "02:38:03", "text": "それに関しては、ちょっとこだわりすぎだったみたい。私は"}, {"type": "subtitle", "time": 9485.99, "timestamp": "02:38:05", "text": "ああ、私にお金を無駄にしないで。平"}, {"type": "subtitle", "time": 9489.27, "timestamp": "02:38:09", "text": "私はそうしていたのですが、"}, {"type": "subtitle", "time": 9495.99, "timestamp": "02:38:15", "text": "それでも人々は少しばかりお金を使った"}, {"type": "subtitle", "time": 9498.95, "timestamp": "02:38:18", "text": "そして私が会員になったとき"}, {"type": "subtitle", "time": 9501.51, "timestamp": "02:38:21", "text": "みんなが会員になった"}, {"type": "subtitle", "time": 9505.03, "timestamp": "02:38:25", "text": "私を幸せにしてくれたので、最低価格にしました"}, {"type": "subtitle", "time": 9507.27, "timestamp": "02:38:27", "text": "可能な価格 可能な例え まるで"}, {"type": "subtitle", "time": 9511.349, "timestamp": "02:38:31", "text": "30ルピー、30ルピーか20ルピーかな。うん。"}, {"type": "subtitle", "time": 9513.03, "timestamp": "02:38:33", "text": "つまり、そんなことできるなんて知らなかった、という感じですね。"}, {"type": "subtitle", "time": 9516.71, "timestamp": "02:38:36", "text": "どれくらい送るか選ぶ"}, {"type": "subtitle", "time": 9519.429, "timestamp": "02:38:39", "text": "メンバーシップを作成する、興味深いティアI"}, {"type": "subtitle", "time": 9521.75, "timestamp": "02:38:41", "text": "ティアの金額を変更しました。だから私は"}, {"type": "subtitle", "time": 9524.469, "timestamp": "02:38:44", "text": "1つの階層のみを維持し、"}, {"type": "subtitle", "time": 9526.07, "timestamp": "02:38:46", "text": "最低。"}, {"type": "subtitle", "time": 9529.27, "timestamp": "02:38:49", "text": "うん。だから他の人にとっては、"}, {"type": "subtitle", "time": 9532.95, "timestamp": "02:38:52", "text": "えっと、なんて言うんでしたっけ？えっと"}, {"type": "subtitle", "time": 9535.51, "timestamp": "02:38:55", "text": "ギフト用の会員権とか。そうなるだろう"}]
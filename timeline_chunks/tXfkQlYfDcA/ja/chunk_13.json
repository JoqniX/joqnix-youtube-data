[{"type": "subtitle", "time": 782.389, "timestamp": "00:13:02", "text": "一瞬。"}, {"type": "subtitle", "time": 785.269, "timestamp": "00:13:05", "text": "そうそう。これが原因だったことを忘れていました。"}, {"type": "subtitle", "time": 788.31, "timestamp": "00:13:08", "text": "インターネットダウンロードマネージャーが"}, {"type": "subtitle", "time": 791.19, "timestamp": "00:13:11", "text": "ダウンロードしたファイルパーツをすべて追加するようなものです"}, {"type": "subtitle", "time": 793.99, "timestamp": "00:13:13", "text": "右、そして音声を追加するとこうなります"}, {"type": "subtitle", "time": 796.71, "timestamp": "00:13:16", "text": "お使いのPCへ。それはそれをある程度後押しする"}, {"type": "subtitle", "time": 799.509, "timestamp": "00:13:19", "text": "メモリとGPUをすべて消費します"}, {"type": "subtitle", "time": 801.829, "timestamp": "00:13:21", "text": "すべて一度に。"}, {"type": "subtitle", "time": 804.93, "timestamp": "00:13:24", "text": "それは痛みを伴うだろう。"}, {"type": "subtitle", "time": 806.15, "timestamp": "00:13:26", "text": "[音楽]"}, {"type": "subtitle", "time": 807.67, "timestamp": "00:13:27", "text": "それは痛みを伴うだろう。ああ、新しい"}, {"type": "subtitle", "time": 811.67, "timestamp": "00:13:31", "text": "字幕編集版。"}, {"type": "subtitle", "time": 819.59, "timestamp": "00:13:39", "text": "書き始めなければならない。"}, {"type": "subtitle", "time": 836.389, "timestamp": "00:13:56", "text": "[音楽]"}]
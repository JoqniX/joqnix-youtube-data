[{"type": "subtitle", "time": 11160.389, "timestamp": "03:06:00", "text": "について？ああ、それは私の最初の動画についての話でした。"}, {"type": "subtitle", "time": 11162.95, "timestamp": "03:06:02", "text": "今回が初めてです。その時"}, {"type": "subtitle", "time": 11165.11, "timestamp": "03:06:05", "text": "私は自分がなりたいものについて話しました"}, {"type": "subtitle", "time": 11167.83, "timestamp": "03:06:07", "text": "子供の頃はYouTuberで、"}, {"type": "subtitle", "time": 11170.23, "timestamp": "03:06:10", "text": "たくさんのこと。それでそれは"}, {"type": "subtitle", "time": 11173.51, "timestamp": "03:06:13", "text": "ところどころ話が脱線しています。えっと、"}, {"type": "subtitle", "time": 11176.63, "timestamp": "03:06:16", "text": "私はどちらかというと"}, {"type": "subtitle", "time": 11179.83, "timestamp": "03:06:19", "text": "私自身もよく批判する。だから私は「うん」って感じ"}, {"type": "subtitle", "time": 11182.55, "timestamp": "03:06:22", "text": "私が抱えている多くの問題を書き留めました"}, {"type": "subtitle", "time": 11185.51, "timestamp": "03:06:25", "text": "まるで私が脱線モードに入ったみたいで"}, {"type": "subtitle", "time": 11188.71, "timestamp": "03:06:28", "text": "視覚的にどれだけのミスを犯したかなど"}, {"type": "subtitle", "time": 11192.23, "timestamp": "03:06:32", "text": "そして、それを自分自身に賢く話す。そこで私は"}, {"type": "subtitle", "time": 11194.389, "timestamp": "03:06:34", "text": "次回録音するときや"}, {"type": "subtitle", "time": 11196.469, "timestamp": "03:06:36", "text": "次回は何か"}, {"type": "subtitle", "time": 11199.349, "timestamp": "03:06:39", "text": "より良い。だからいつか私はこれがこれが"}, {"type": "subtitle", "time": 11201.349, "timestamp": "03:06:41", "text": "私がそれをする方法は"}, {"type": "subtitle", "time": 11204.469, "timestamp": "03:06:44", "text": "最終的には、自分のコンテンツを見る時が来る。"}, {"type": "subtitle", "time": 11207.67, "timestamp": "03:06:47", "text": "私も幸せで笑顔になれる"}, {"type": "subtitle", "time": 11210.23, "timestamp": "03:06:50", "text": "そして「うん、楽しい配信だったね」と言う"}, {"type": "subtitle", "time": 11212.15, "timestamp": "03:06:52", "text": "そして、あなたの"}, {"type": "subtitle", "time": 11214.469, "timestamp": "03:06:54", "text": "成長は少し楽になります"}, {"type": "subtitle", "time": 11217.429, "timestamp": "03:06:57", "text": "そういうコンテンツですよね？一方、"}, {"type": "subtitle", "time": 11219.03, "timestamp": "03:06:59", "text": "VODとかそういうのは、まあ、"}]
[{"type": "subtitle", "time": 4263.189, "timestamp": "01:11:03", "text": "えっと、ちょっと待って"}, {"type": "subtitle", "time": 4275.51, "timestamp": "01:11:15", "text": "また？"}, {"type": "subtitle", "time": 4277.83, "timestamp": "01:11:17", "text": "だから私はアイデアの1つが必要だと思う"}, {"type": "subtitle", "time": 4280.47, "timestamp": "01:11:20", "text": "ちょうどいい"}, {"type": "subtitle", "time": 4284.07, "timestamp": "01:11:24", "text": "言葉の一部を変更すること"}, {"type": "subtitle", "time": 4286.709, "timestamp": "01:11:26", "text": "誰かが退出するときのコマンド"}, {"type": "subtitle", "time": 4288.79, "timestamp": "01:11:28", "text": "チャットする"}, {"type": "subtitle", "time": 4292.07, "timestamp": "01:11:32", "text": "ストリームから離れる時か何か"}, {"type": "subtitle", "time": 4296.39, "timestamp": "01:11:36", "text": "私たちが持っているもののいくつか"}, {"type": "subtitle", "time": 4299.59, "timestamp": "01:11:39", "text": "GTGを追加しようと考えていたと思います"}, {"type": "subtitle", "time": 4305.35, "timestamp": "01:11:45", "text": "行かなければならない、または出発しなければならないが"}, {"type": "subtitle", "time": 4313.669, "timestamp": "01:11:53", "text": "えっと、戻ります。いいえ。"}, {"type": "subtitle", "time": 4315.75, "timestamp": "01:11:55", "text": "うん、時々そうなるよ"}, {"type": "subtitle", "time": 4318.149, "timestamp": "01:11:58", "text": "もっと強く。いつになったら私は"}]
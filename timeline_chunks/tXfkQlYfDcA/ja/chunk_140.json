[{"type": "subtitle", "time": 8400.63, "timestamp": "02:20:00", "text": "インドのVTuberとかそういうのがあって、"}, {"type": "subtitle", "time": 8402.79, "timestamp": "02:20:02", "text": "そこにはたくさんの人がいて"}, {"type": "subtitle", "time": 8404.79, "timestamp": "02:20:04", "text": "あなたはいつも導いてくれて、"}, {"type": "subtitle", "time": 8407.27, "timestamp": "02:20:07", "text": "甘くて、いつも助けたいと思う"}, {"type": "subtitle", "time": 8409.19, "timestamp": "02:20:09", "text": "人々が外に出ている。私は「ああ、それは"}, {"type": "subtitle", "time": 8411.51, "timestamp": "02:20:11", "text": "とても甘い。私には耐えられない"}, {"type": "subtitle", "time": 8413.59, "timestamp": "02:20:13", "text": "私自身も、そしてあなたもここで対処している"}, {"type": "subtitle", "time": 8415.75, "timestamp": "02:20:15", "text": "自分自身も好きで、他の人を助けようとすることが好きです"}, {"type": "subtitle", "time": 8418.15, "timestamp": "02:20:18", "text": "人々を集めてコミュニティを作ろうとしている。"}, {"type": "subtitle", "time": 8421.11, "timestamp": "02:20:21", "text": "私はあなたのそういうところをずっと尊敬してきました。"}, {"type": "subtitle", "time": 8423.51, "timestamp": "02:20:23", "text": "えっと、だから、あなたが"}, {"type": "subtitle", "time": 8425.11, "timestamp": "02:20:25", "text": "手を差し伸べて、「やあ、"}, {"type": "subtitle", "time": 8426.71, "timestamp": "02:20:26", "text": "「乗りたいの？」"}, {"type": "subtitle", "time": 8428.15, "timestamp": "02:20:28", "text": "「ああ、そうだ、それは"}, {"type": "subtitle", "time": 8431.429, "timestamp": "02:20:31", "text": "「素晴らしいものになる。」何だって？"}, {"type": "subtitle", "time": 8433.59, "timestamp": "02:20:33", "text": "うん。私はいつも連絡を取りたいと思っていましたが、"}, {"type": "subtitle", "time": 8436.71, "timestamp": "02:20:36", "text": "恥ずかしがり屋だったんだよ。"}, {"type": "subtitle", "time": 8439.429, "timestamp": "02:20:39", "text": "いえ、あなたの気持ちは分かります。分かりますよ。私は恥ずかしがり屋で、"}, {"type": "subtitle", "time": 8441.11, "timestamp": "02:20:41", "text": "また、連絡を取ることに関しては"}, {"type": "subtitle", "time": 8442.55, "timestamp": "02:20:42", "text": "人々に。 「待って、もし彼らが"}, {"type": "subtitle", "time": 8444.87, "timestamp": "02:20:44", "text": "「ノーと言う？」つまり、それは"}, {"type": "subtitle", "time": 8447.03, "timestamp": "02:20:47", "text": "問題だけど、まるで"}, {"type": "subtitle", "time": 8449.75, "timestamp": "02:20:49", "text": "恥ずかしさ。"}, {"type": "subtitle", "time": 8451.99, "timestamp": "02:20:51", "text": "ああ、神様。でも、あなたがそうしてくれて本当に嬉しいです。"}, {"type": "subtitle", "time": 8454.79, "timestamp": "02:20:54", "text": "こうして一緒にいられて嬉しいです。わーい。"}, {"type": "subtitle", "time": 8457.429, "timestamp": "02:20:57", "text": "ええ、本当に話せてよかったです"}, {"type": "subtitle", "time": 8459.91, "timestamp": "02:20:59", "text": "あなたにとって初めてのことです。私はただ"}]
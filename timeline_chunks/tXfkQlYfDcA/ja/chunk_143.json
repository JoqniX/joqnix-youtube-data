[{"type": "subtitle", "time": 8582.15, "timestamp": "02:23:02", "text": "そこで試験を受けて合格した"}, {"type": "subtitle", "time": 8584.55, "timestamp": "02:23:04", "text": "そして彼らは私に機会を与え、"}, {"type": "subtitle", "time": 8587.91, "timestamp": "02:23:07", "text": "学校との面接を受ける"}, {"type": "subtitle", "time": 8591.349, "timestamp": "02:23:11", "text": "私はまだ学位取得の勉強をしているところです。"}, {"type": "subtitle", "time": 8594.63, "timestamp": "02:23:14", "text": "学校は1校しかなかったけど、ええ、私は優秀な成績を収めました"}, {"type": "subtitle", "time": 8597.67, "timestamp": "02:23:17", "text": "あのインタビュー。話したのは私だった"}, {"type": "subtitle", "time": 8601.91, "timestamp": "02:23:21", "text": "そんなに。はい。ああ、それはすごい。"}, {"type": "subtitle", "time": 8607.03, "timestamp": "02:23:27", "text": "おめでとうございます。わーい。なんてこった。ええ、そうですね。"}, {"type": "subtitle", "time": 8609.11, "timestamp": "02:23:29", "text": "面接とかそういうのが終わった後。そうですね、"}, {"type": "subtitle", "time": 8611.91, "timestamp": "02:23:31", "text": "今、彼らは補償として私に言った"}, {"type": "subtitle", "time": 8614.95, "timestamp": "02:23:34", "text": "N4クラスを提供してくれる予定です。N4から"}, {"type": "subtitle", "time": 8619.27, "timestamp": "02:23:39", "text": "N3、少しだけN3。だから来年までに"}, {"type": "subtitle", "time": 8622.389, "timestamp": "02:23:42", "text": "4月、いや3月、そう、3月が終わるような感じ"}, {"type": "subtitle", "time": 8625.349, "timestamp": "02:23:45", "text": "この頃には、私は完全に"}, {"type": "subtitle", "time": 8627.27, "timestamp": "02:23:47", "text": "準備ができたらもっと"}, {"type": "subtitle", "time": 8630.63, "timestamp": "02:23:50", "text": "現在日本にいる間に楽しめる機会"}, {"type": "subtitle", "time": 8632.71, "timestamp": "02:23:52", "text": "ええと、パートタイムの仕事です。流暢に話せるようになるので。"}, {"type": "subtitle", "time": 8635.51, "timestamp": "02:23:55", "text": "その頃にはN4が終わっているだろう"}, {"type": "subtitle", "time": 8639.59, "timestamp": "02:23:59", "text": "N3以降は日本から勉強できます"}]
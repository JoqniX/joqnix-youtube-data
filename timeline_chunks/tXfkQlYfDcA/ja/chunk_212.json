[{"type": "subtitle", "time": 12721.429, "timestamp": "03:32:01", "text": "チャットに注目してください。彼らは本当に"}, {"type": "subtitle", "time": 12724.309, "timestamp": "03:32:04", "text": "彼らは自分がやっていることに没頭している。しかし"}, {"type": "subtitle", "time": 12726.71, "timestamp": "03:32:06", "text": "ええ、そのためには、そのためには、そこになければなりません"}, {"type": "subtitle", "time": 12728.71, "timestamp": "03:32:08", "text": "たくさんの人がいるはずだ"}, {"type": "subtitle", "time": 12730.63, "timestamp": "03:32:10", "text": "君のことを見守ってるみたいな感じ。右。"}, {"type": "subtitle", "time": 12732.79, "timestamp": "03:32:12", "text": "右。右。右。それは本当だ。うん。"}, {"type": "subtitle", "time": 12735.19, "timestamp": "03:32:15", "text": "しかし、中国人も来るだろう。右。私は"}, {"type": "subtitle", "time": 12737.19, "timestamp": "03:32:17", "text": "英語を話す唯一の外国人"}, {"type": "subtitle", "time": 12738.87, "timestamp": "03:32:18", "text": "そうでなければ、彼らは理解できないだろう。うん。"}, {"type": "subtitle", "time": 12741.269, "timestamp": "03:32:21", "text": "そこが問題なんです。それで、あなたは"}, {"type": "subtitle", "time": 12743.67, "timestamp": "03:32:23", "text": "テキストメッセージを好む場合、"}, {"type": "subtitle", "time": 12746.469, "timestamp": "03:32:26", "text": "中国語で、または中国語のように"}, {"type": "subtitle", "time": 12748.389, "timestamp": "03:32:28", "text": "何でも？好きにならなきゃいけなかったの？"}, {"type": "subtitle", "time": 12750.229, "timestamp": "03:32:30", "text": "常に翻訳機のように使用し、"}, {"type": "subtitle", "time": 12751.67, "timestamp": "03:32:31", "text": "そんな風に話しかけたり、そこにいたり"}, {"type": "subtitle", "time": 12753.75, "timestamp": "03:32:33", "text": "英語のコメントをくれる人たち"}, {"type": "subtitle", "time": 12755.75, "timestamp": "03:32:35", "text": "で？英語のコメントが寄せられました"}, {"type": "subtitle", "time": 12759.349, "timestamp": "03:32:39", "text": "英語などを学んでいる人たち"}, {"type": "subtitle", "time": 12763.03, "timestamp": "03:32:43", "text": "または英語で。そして私はこれを見つけた"}, {"type": "subtitle", "time": 12766.87, "timestamp": "03:32:46", "text": "「ラップレス・ライフ」というサービスです。だからそれは実行された"}, {"type": "subtitle", "time": 12769.59, "timestamp": "03:32:49", "text": "まるで私が何に基づいているか"}, {"type": "subtitle", "time": 12772.309, "timestamp": "03:32:52", "text": "理解しているところによると、それは"}, {"type": "subtitle", "time": 12776.389, "timestamp": "03:32:56", "text": "VTuberとそのVTuberにはたくさんの"}]
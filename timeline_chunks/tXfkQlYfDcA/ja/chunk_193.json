[{"type": "subtitle", "time": 11580.23, "timestamp": "03:13:00", "text": "その通り。ゲームは依然として"}, {"type": "subtitle", "time": 11582.95, "timestamp": "03:13:02", "text": "そこには。しかし、この会話は。うん。"}, {"type": "subtitle", "time": 11585.21, "timestamp": "03:13:05", "text": "私たちはそれを継続していくつもりです。"}, {"type": "subtitle", "time": 11586.389, "timestamp": "03:13:06", "text": "[音楽]"}, {"type": "subtitle", "time": 11589.03, "timestamp": "03:13:09", "text": "何てことだ。"}, {"type": "subtitle", "time": 11592.71, "timestamp": "03:13:12", "text": "あなたのTwitterをフォローしています。"}, {"type": "subtitle", "time": 11596.309, "timestamp": "03:13:16", "text": "3Dのやり方がすごくクールだね"}, {"type": "subtitle", "time": 11598.95, "timestamp": "03:13:18", "text": "Blender関連のもの。"}, {"type": "subtitle", "time": 11601.429, "timestamp": "03:13:21", "text": "ありがとう。"}, {"type": "subtitle", "time": 11606.63, "timestamp": "03:13:26", "text": "うん。 3Dは予想外のものでした"}, {"type": "subtitle", "time": 11609.99, "timestamp": "03:13:29", "text": "えっと、飛び込むような感じ。最初は"}, {"type": "subtitle", "time": 11611.67, "timestamp": "03:13:31", "text": "昔は色々なことをやっていた"}, {"type": "subtitle", "time": 11615.99, "timestamp": "03:13:35", "text": "2Dとか3Dとか、えっと、スキディ、わからないけど"}, {"type": "subtitle", "time": 11620.07, "timestamp": "03:13:40", "text": "でも、えっと、私は「わかった」って感じだった"}, {"type": "subtitle", "time": 11622.07, "timestamp": "03:13:42", "text": "3Dを作りたかった"}, {"type": "subtitle", "time": 11624.15, "timestamp": "03:13:44", "text": "自分のモデルにしたのは、最初は"}, {"type": "subtitle", "time": 11628.309, "timestamp": "03:13:48", "text": "ヴォイドストリーマーみたいになろう、えっと、でも私は"}, {"type": "subtitle", "time": 11631.269, "timestamp": "03:13:51", "text": "何か特別なことをしたかった"}, {"type": "subtitle", "time": 11632.87, "timestamp": "03:13:52", "text": "私がプレイした最初のゲームは、最初のゲームではありませんでした"}, {"type": "subtitle", "time": 11634.63, "timestamp": "03:13:54", "text": "私がプレイしたゲームですが、最初のゲームのように"}, {"type": "subtitle", "time": 11635.91, "timestamp": "03:13:55", "text": "配信でプレイするのが本当に楽しみでした"}, {"type": "subtitle", "time": 11639.11, "timestamp": "03:13:59", "text": "それは龍が如く 龍が如く ゼロで、私は"}]
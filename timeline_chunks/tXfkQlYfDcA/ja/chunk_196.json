[{"type": "subtitle", "time": 11762.15, "timestamp": "03:16:02", "text": "でも、オリーは「ああ、なんてこった」って感じだった"}, {"type": "subtitle", "time": 11765.349, "timestamp": "03:16:05", "text": "よし、行くぞ。"}, {"type": "subtitle", "time": 11767.67, "timestamp": "03:16:07", "text": "ええ、本当にすごかったですよ。でもそれはとても"}, {"type": "subtitle", "time": 11770.469, "timestamp": "03:16:10", "text": "残念なことに、私が使用したビデオは"}, {"type": "subtitle", "time": 11772.95, "timestamp": "03:16:12", "text": "えっと、私が使った音楽はケイティでした"}, {"type": "subtitle", "time": 11777.91, "timestamp": "03:16:17", "text": "ペリーのカリフォルニアガールズと最近"}, {"type": "subtitle", "time": 11780.87, "timestamp": "03:16:20", "text": "著作権侵害のようなコピーが"}, {"type": "subtitle", "time": 11785.19, "timestamp": "03:16:25", "text": "Twitterは投稿を削除した。えっと、"}, {"type": "subtitle", "time": 11787.51, "timestamp": "03:16:27", "text": "まるでそれが跡形もなく消え去ったかのように。それはまるで"}, {"type": "subtitle", "time": 11790.309, "timestamp": "03:16:30", "text": "失われたメディア。何てことだ。私が好まない限り"}, {"type": "subtitle", "time": 11793.67, "timestamp": "03:16:33", "text": "再投稿を検討してみて、いいね"}, {"type": "subtitle", "time": 11796.229, "timestamp": "03:16:36", "text": "別の曲だけど、よくわからない。私はただ"}, {"type": "subtitle", "time": 11797.91, "timestamp": "03:16:37", "text": "やる価値があるかどうか分からない。"}, {"type": "subtitle", "time": 11800.389, "timestamp": "03:16:40", "text": "ただただ悲しい。なくなるのは残念だ。"}, {"type": "subtitle", "time": 11801.91, "timestamp": "03:16:41", "text": "あなたは、"}, {"type": "subtitle", "time": 11803.67, "timestamp": "03:16:43", "text": "ビデオ。ああ、うん、うん、うん。のように"}, {"type": "subtitle", "time": 11805.99, "timestamp": "03:16:45", "text": "ファイルはそこにあります。それはむしろ、"}, {"type": "subtitle", "time": 11807.83, "timestamp": "03:16:47", "text": "その投稿は、ほら、"}, {"type": "subtitle", "time": 11809.91, "timestamp": "03:16:49", "text": "ツイッターに投稿されたのは"}, {"type": "subtitle", "time": 11811.99, "timestamp": "03:16:51", "text": "いい感じだけど、まだ持ってるよ"}, {"type": "subtitle", "time": 11813.67, "timestamp": "03:16:53", "text": "他の場所。私はそれをつけていると思う"}, {"type": "subtitle", "time": 11817.11, "timestamp": "03:16:57", "text": "インスタグラムかユーチューブ。よくわからない。えっと、私は"}, {"type": "subtitle", "time": 11819.59, "timestamp": "03:16:59", "text": "本当に、投稿するのが苦手なんです"}]
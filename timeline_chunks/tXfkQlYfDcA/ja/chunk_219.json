[{"type": "subtitle", "time": 13141.75, "timestamp": "03:39:01", "text": "ユーザーのコメントやイベントなど"}, {"type": "subtitle", "time": 13143.91, "timestamp": "03:39:03", "text": "彼らはウェブソケットしか持っていないと言った"}, {"type": "subtitle", "time": 13146.309, "timestamp": "03:39:06", "text": "スーパーチャットなどのイベント用のもの"}, {"type": "subtitle", "time": 13148.87, "timestamp": "03:39:08", "text": "すべて、贈り物、その他諸々。彼らは"}, {"type": "subtitle", "time": 13151.67, "timestamp": "03:39:11", "text": "TikTokみたいなギフトが欲しいな"}, {"type": "subtitle", "time": 13155.269, "timestamp": "03:39:15", "text": "もの。うん。"}, {"type": "subtitle", "time": 13157.11, "timestamp": "03:39:17", "text": "理解した。"}, {"type": "subtitle", "time": 13159.349, "timestamp": "03:39:19", "text": "人々はチャージして支払いをすることができます"}, {"type": "subtitle", "time": 13161.269, "timestamp": "03:39:21", "text": "ギフトか、無料のギフトがもらえます"}, {"type": "subtitle", "time": 13163.349, "timestamp": "03:39:23", "text": "毎週とか、毎日とか、そんな感じで。"}, {"type": "subtitle", "time": 13166.229, "timestamp": "03:39:26", "text": "そうやってできますよ。ああ、わかりました。それで"}, {"type": "subtitle", "time": 13167.83, "timestamp": "03:39:27", "text": "人々は、"}, {"type": "subtitle", "time": 13170.95, "timestamp": "03:39:30", "text": "欲しい。彼らが望む場所、そして"}, {"type": "subtitle", "time": 13173.91, "timestamp": "03:39:33", "text": "配信者に向かって。彼らはこれを持っている"}, {"type": "subtitle", "time": 13176.71, "timestamp": "03:39:36", "text": "キャプテン・ボイジャーの旗"}, {"type": "subtitle", "time": 13179.269, "timestamp": "03:39:39", "text": "Twitchのものと同じようなネームタグも"}, {"type": "subtitle", "time": 13182.15, "timestamp": "03:39:42", "text": "グローバルバッジですよね？あなたはできる"}, {"type": "subtitle", "time": 13184.63, "timestamp": "03:39:44", "text": "ストリーマーを代表する"}, {"type": "subtitle", "time": 13187.91, "timestamp": "03:39:47", "text": "えーと、あなたが他のメンバーである"}, {"type": "subtitle", "time": 13189.429, "timestamp": "03:39:49", "text": "場所。"}, {"type": "subtitle", "time": 13191.75, "timestamp": "03:39:51", "text": "それは本当に素晴らしいですね。ニース。たくさん"}, {"type": "subtitle", "time": 13194.15, "timestamp": "03:39:54", "text": "そのような機能。すばらしい。うん。親切"}, {"type": "subtitle", "time": 13196.63, "timestamp": "03:39:56", "text": "まるで自分の海を表現できるかのように。"}, {"type": "subtitle", "time": 13199.429, "timestamp": "03:39:59", "text": "うん。うん。うん。その通り。彼らは持っている"}]
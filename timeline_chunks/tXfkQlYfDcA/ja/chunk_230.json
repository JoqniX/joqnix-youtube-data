[{"type": "subtitle", "time": 13801.75, "timestamp": "03:50:01", "text": "Instagramのリアル、すべて縦長です"}, {"type": "subtitle", "time": 13804.229, "timestamp": "03:50:04", "text": "コンテンツ。うん。でも、どうしてそうなるのか不思議です"}, {"type": "subtitle", "time": 13805.75, "timestamp": "03:50:05", "text": "あなたがうまく翻訳したいとき"}, {"type": "subtitle", "time": 13807.349, "timestamp": "03:50:07", "text": "ゲームをプレイしているような、"}, {"type": "subtitle", "time": 13809.11, "timestamp": "03:50:09", "text": "水平方向のことを知っている。それは単なる"}, {"type": "subtitle", "time": 13812.79, "timestamp": "03:50:12", "text": "本当に小さな画面？全く見当もつきません。私"}, {"type": "subtitle", "time": 13815.51, "timestamp": "03:50:15", "text": "私も全く見当がつかない。"}, {"type": "subtitle", "time": 13818.469, "timestamp": "03:50:18", "text": "でも、かっこよさそうだね。"}, {"type": "subtitle", "time": 13821.99, "timestamp": "03:50:21", "text": "うん。うん。物事はどのような感じか"}, {"type": "subtitle", "time": 13823.54, "timestamp": "03:50:23", "text": "すべて？"}, {"type": "subtitle", "time": 13825.189, "timestamp": "03:50:25", "text": "[音楽]"}, {"type": "subtitle", "time": 13827.67, "timestamp": "03:50:27", "text": "うん。何かそういうものがあるのでしょうか"}, {"type": "subtitle", "time": 13829.429, "timestamp": "03:50:29", "text": "楽しみにしているコンテンツ"}, {"type": "subtitle", "time": 13832.15, "timestamp": "03:50:32", "text": "将来的に作るとか、ご存知のように"}, {"type": "subtitle", "time": 13833.91, "timestamp": "03:50:33", "text": "あなたがどんなに似ているか"}, {"type": "subtitle", "time": 13835.429, "timestamp": "03:50:35", "text": "あなたが楽しみにしているイベント"}, {"type": "subtitle", "time": 13838.63, "timestamp": "03:50:38", "text": "未来は？ああ、イベントだ。と言えば"}, {"type": "subtitle", "time": 13840.79, "timestamp": "03:50:40", "text": "イベントですね。えーと、私が"}, {"type": "subtitle", "time": 13844.15, "timestamp": "03:50:44", "text": "私がやりたいと思っていたことを計画しています"}, {"type": "subtitle", "time": 13847.83, "timestamp": "03:50:47", "text": "もし私が来月日本に行ったら、"}, {"type": "subtitle", "time": 13850.87, "timestamp": "03:50:50", "text": "実際にはもっとコラボレーションをすることだった"}, {"type": "subtitle", "time": 13853.83, "timestamp": "03:50:53", "text": "そして日本のYouTubeの世界へ足を踏み入れる"}, {"type": "subtitle", "time": 13856.95, "timestamp": "03:50:56", "text": "実は。右。それで、私は考えていたのですが"}]
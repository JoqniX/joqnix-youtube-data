[{"type": "subtitle", "time": 903.67, "timestamp": "00:15:03", "text": "でも、もうすぐ終わりですよね？ほとんど"}, {"type": "subtitle", "time": 905.67, "timestamp": "00:15:05", "text": "終わり。追加中。さあ、止まって"}, {"type": "subtitle", "time": 907.59, "timestamp": "00:15:07", "text": "追加しています。"}, {"type": "subtitle", "time": 909.43, "timestamp": "00:15:09", "text": "なぜまばたきをしているのですか？終わりましたか？"}, {"type": "subtitle", "time": 911.03, "timestamp": "00:15:11", "text": "アップロード中ですか？はい、これで完了だと思います。"}, {"type": "subtitle", "time": 914.79, "timestamp": "00:15:14", "text": "アップロード中。クリックするだけで"}, {"type": "subtitle", "time": 917.269, "timestamp": "00:15:17", "text": "確認する。その前に、"}, {"type": "subtitle", "time": 919.59, "timestamp": "00:15:19", "text": "字幕を作成する。"}, {"type": "subtitle", "time": 921.43, "timestamp": "00:15:21", "text": "字幕の作業を終わらせましょう。待って、"}, {"type": "subtitle", "time": 923.91, "timestamp": "00:15:23", "text": "待って、待って、待って。後で更新します。"}, {"type": "subtitle", "time": 927.03, "timestamp": "00:15:27", "text": "ああ神様、"}, {"type": "subtitle", "time": 930.71, "timestamp": "00:15:30", "text": "ああ、みんな、どれくらい遅いんだ。何てことだ。"}, {"type": "subtitle", "time": 934.71, "timestamp": "00:15:34", "text": "わかりました、これでこの件は解決です。"}, {"type": "subtitle", "time": 937.75, "timestamp": "00:15:37", "text": "なぜ2つあるのか？待って、"}, {"type": "subtitle", "time": 941.67, "timestamp": "00:15:41", "text": "なぜこれが2つあるのか？"}, {"type": "subtitle", "time": 951.99, "timestamp": "00:15:51", "text": "時間を作っています。権利が必要です"}, {"type": "subtitle", "time": 954.629, "timestamp": "00:15:54", "text": "バカバカ"}, {"type": "subtitle", "time": 956.71, "timestamp": "00:15:56", "text": "3、2の間私を引き止めるはずだった"}, {"type": "subtitle", "time": 959.11, "timestamp": "00:15:59", "text": "数分で済むはずだったのに、今はものすごく時間がかかっている。"}]
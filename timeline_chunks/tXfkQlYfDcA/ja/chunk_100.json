[{"type": "subtitle", "time": 6001.99, "timestamp": "01:40:01", "text": "ここで何をしているのですか？"}, {"type": "subtitle", "time": 6004.629, "timestamp": "01:40:04", "text": "それは何をしているのですか？近日公開。"}, {"type": "subtitle", "time": 6007.03, "timestamp": "01:40:07", "text": "サウンドボード。え、何？ズキは待って、"}, {"type": "subtitle", "time": 6010.47, "timestamp": "01:40:10", "text": "待って。 Space Madeサーバーにサウンドボードが搭載されました"}, {"type": "subtitle", "time": 6018.47, "timestamp": "01:40:18", "text": "サウンドボードを使用してください。わかった。"}, {"type": "subtitle", "time": 6033.109, "timestamp": "01:40:33", "text": "つまり、ああ、彼女は私たち"}, {"type": "subtitle", "time": 6034.87, "timestamp": "01:40:34", "text": "その機能は利用できませんでした。わかった。わかった。それで"}, {"type": "subtitle", "time": 6037.83, "timestamp": "01:40:37", "text": "つまり、船内で音声を使用できるということだ。"}, {"type": "subtitle", "time": 6041.189, "timestamp": "01:40:41", "text": "VCチャンネル内のアイテム。疑問符または"}, {"type": "subtitle", "time": 6050.07, "timestamp": "01:40:50", "text": "はぁ？"}, {"type": "subtitle", "time": 6054.07, "timestamp": "01:40:54", "text": "これはどのように作動しますか？興味があります。"}]
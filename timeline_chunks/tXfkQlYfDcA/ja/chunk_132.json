[{"type": "subtitle", "time": 7930.95, "timestamp": "02:12:10", "text": "寝転がって文章を書くべきではない。"}, {"type": "subtitle", "time": 7937.51, "timestamp": "02:12:17", "text": "うん。こんにちは。"}, {"type": "subtitle", "time": 7957.35, "timestamp": "02:12:37", "text": "私の名前はこれです。彼の名前を忘れてしまった。"}, {"type": "subtitle", "time": 7962.31, "timestamp": "02:12:42", "text": "L・ルイスに関係する何か。いいえ、"}, {"type": "subtitle", "time": 7964.629, "timestamp": "02:12:44", "text": "忘れた。待って。 Googleで検索した方がいいでしょうか？私"}, {"type": "subtitle", "time": 7966.629, "timestamp": "02:12:46", "text": "わからない。"}, {"type": "subtitle", "time": 7968.87, "timestamp": "02:12:48", "text": "えっと"}, {"type": "subtitle", "time": 7971.51, "timestamp": "02:12:51", "text": "1つは、彼がいつも"}, {"type": "subtitle", "time": 7974.47, "timestamp": "02:12:54", "text": "私のコースを買って、私のコースを買って、"}, {"type": "subtitle", "time": 7977.43, "timestamp": "02:12:57", "text": "お金の稼ぎ方を知る"}]
[{"type": "subtitle", "time": 421.909, "timestamp": "00:07:01", "text": "読んで待って、忘れてた、忘れてた"}, {"type": "subtitle", "time": 424.87, "timestamp": "00:07:04", "text": "境界線 境界線 忘れた"}, {"type": "subtitle", "time": 428.23, "timestamp": "00:07:08", "text": "ああ、境界線"}, {"type": "subtitle", "time": 431.67, "timestamp": "00:07:11", "text": "境界線のことをいつも忘れてしまう"}, {"type": "subtitle", "time": 434.309, "timestamp": "00:07:14", "text": "人生とはどういうものか。"}, {"type": "subtitle", "time": 436.79, "timestamp": "00:07:16", "text": "私は忘れ続け、"}, {"type": "subtitle", "time": 439.71, "timestamp": "00:07:19", "text": "境界。"}, {"type": "subtitle", "time": 442.71, "timestamp": "00:07:22", "text": "[音楽]"}, {"type": "subtitle", "time": 447.029, "timestamp": "00:07:27", "text": "うん。例えば、"}, {"type": "subtitle", "time": 449.029, "timestamp": "00:07:29", "text": "こういうことに関しては、"}, {"type": "subtitle", "time": 451.749, "timestamp": "00:07:31", "text": "調整する"}, {"type": "subtitle", "time": 454.30899999999997, "timestamp": "00:07:34", "text": "これ"}, {"type": "subtitle", "time": 457.43, "timestamp": "00:07:37", "text": "境界線のせいだ。"}, {"type": "subtitle", "time": 459.749, "timestamp": "00:07:39", "text": "うん。まだここにいる。アートを置く必要がある"}, {"type": "subtitle", "time": 462.71, "timestamp": "00:07:42", "text": "この中に何か入っている。"}, {"type": "subtitle", "time": 465.51, "timestamp": "00:07:45", "text": "うん。ええ、間違いを犯しました。私は"}, {"type": "subtitle", "time": 468.39, "timestamp": "00:07:48", "text": "気づきました。"}, {"type": "subtitle", "time": 470.87, "timestamp": "00:07:50", "text": "気づいてよかった。だから、私は"}, {"type": "subtitle", "time": 473.189, "timestamp": "00:07:53", "text": "引っ越す"}, {"type": "subtitle", "time": 476.95, "timestamp": "00:07:56", "text": "これです。この男。"}, {"type": "subtitle", "time": 479.11, "timestamp": "00:07:59", "text": "うん。こんにちは、アリ。おはよう。調子はどうですか"}]
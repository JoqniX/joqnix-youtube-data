[{"type": "subtitle", "time": 5761.35, "timestamp": "01:36:01", "text": "お茶を持って戻ってきました。私はちょうど"}, {"type": "subtitle", "time": 5764.95, "timestamp": "01:36:04", "text": "朝食は今、トップ31のような感じ"}, {"type": "subtitle", "time": 5768.709, "timestamp": "01:36:08", "text": "私の質問"}, {"type": "subtitle", "time": 5773.51, "timestamp": "01:36:13", "text": "それで、この質問は、"}, {"type": "subtitle", "time": 5776.149, "timestamp": "01:36:16", "text": "これは、待て、これは石油か？え、何？"}, {"type": "subtitle", "time": 5779.189, "timestamp": "01:36:19", "text": "何だ何だ"}, {"type": "subtitle", "time": 5782.629, "timestamp": "01:36:22", "text": "彼女の文章は？何てことだ。"}, {"type": "subtitle", "time": 5785.59, "timestamp": "01:36:25", "text": "うん。こんにちは、ズキ。元気ですか？"}, {"type": "subtitle", "time": 5787.189, "timestamp": "01:36:27", "text": "お元気でお過ごしでしょうか。おはよう。"}, {"type": "subtitle", "time": 5793.03, "timestamp": "01:36:33", "text": "あなたはストリーミング配信中です。待って、これはこれかもしれない"}, {"type": "subtitle", "time": 5795.669, "timestamp": "01:36:35", "text": "あなたがストリーミングしているかもしれない時間、"}, {"type": "subtitle", "time": 5798.26, "timestamp": "01:36:38", "text": "右？"}, {"type": "subtitle", "time": 5804.87, "timestamp": "01:36:44", "text": "[音楽]"}, {"type": "subtitle", "time": 5806.709, "timestamp": "01:36:46", "text": "私にさせて"}, {"type": "subtitle", "time": 5809.75, "timestamp": "01:36:49", "text": "水で拭いてください。私はしません"}, {"type": "subtitle", "time": 5812.79, "timestamp": "01:36:52", "text": "紙が油っぽくなったり、何か変なことが起こったりするのは嫌だ。"}, {"type": "subtitle", "time": 5814.629, "timestamp": "01:36:54", "text": "いいえ"}, {"type": "subtitle", "time": 5816.79, "timestamp": "01:36:56", "text": "痛み。こんな時は、"}, {"type": "subtitle", "time": 5819.669, "timestamp": "01:36:59", "text": "試験委員会か何か。"}]
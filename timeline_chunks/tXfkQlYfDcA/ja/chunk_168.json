[{"type": "subtitle", "time": 10081.03, "timestamp": "02:48:01", "text": "たくさんのことを試しているように、"}, {"type": "subtitle", "time": 10083.349, "timestamp": "02:48:03", "text": "いろいろなこと、そして"}, {"type": "subtitle", "time": 10085.429, "timestamp": "02:48:05", "text": "むしろ、さらに何年もかけてもっと試す必要がある"}, {"type": "subtitle", "time": 10087.429, "timestamp": "02:48:07", "text": "好きなものを見て、"}, {"type": "subtitle", "time": 10089.91, "timestamp": "02:48:09", "text": "記憶に残るもの、ですよね？そして見つけることのように"}, {"type": "subtitle", "time": 10092.389, "timestamp": "02:48:12", "text": "あなたの情熱。うん。そして、誰が知っているだろうか、"}, {"type": "subtitle", "time": 10095.51, "timestamp": "02:48:15", "text": "来年、日本が実現するかもしれませんね。おお。横断"}, {"type": "subtitle", "time": 10098.389, "timestamp": "02:48:18", "text": "指。"}, {"type": "subtitle", "time": 10099.99, "timestamp": "02:48:19", "text": "うん。"}, {"type": "subtitle", "time": 10109.429, "timestamp": "02:48:29", "text": "えっと、ああ、私はまだ… ああ、待って。私は思う"}, {"type": "subtitle", "time": 10112.389, "timestamp": "02:48:32", "text": "あなたには、スニペットのようなものを見せていません"}, {"type": "subtitle", "time": 10116.469, "timestamp": "02:48:36", "text": "私の新しい次期モデルが今、登場します。"}, {"type": "subtitle", "time": 10119.269, "timestamp": "02:48:39", "text": "ぜひ見てみたいです。"}, {"type": "subtitle", "time": 10122.389, "timestamp": "02:48:42", "text": "いいですか。"}, {"type": "subtitle", "time": 10124.23, "timestamp": "02:48:44", "text": "うん、大丈夫だよ。問題ないと思います。私"}, {"type": "subtitle", "time": 10127.83, "timestamp": "02:48:47", "text": "問題にはならないよ。のように"}, {"type": "subtitle", "time": 10130.15, "timestamp": "02:48:50", "text": "いや、プレッシャーはないよ。私はしたくない"}, {"type": "subtitle", "time": 10132.309, "timestamp": "02:48:52", "text": "だって、もしあなたがゆっくりとした感じでやりたいなら"}, {"type": "subtitle", "time": 10134.95, "timestamp": "02:48:54", "text": "みんなに明かすのは完全に"}, {"type": "subtitle", "time": 10137.349, "timestamp": "02:48:57", "text": "わかった。私は辛抱強く待ちますが、"}, {"type": "subtitle", "time": 10139.83, "timestamp": "02:48:59", "text": "しかも、とても詮索好きだ。私は「わぁ、楽しみだ」って感じ"}]
[{"type": "subtitle", "time": 14160.87, "timestamp": "03:56:00", "text": "追跡装置とかそういう類。うん。うん。右。"}, {"type": "subtitle", "time": 14163.99, "timestamp": "03:56:03", "text": "うん。何てことだ。しかしこれは簡単に"}, {"type": "subtitle", "time": 14166.55, "timestamp": "03:56:06", "text": "今日のテクノロジーで実現した"}, {"type": "subtitle", "time": 14169.11, "timestamp": "03:56:09", "text": "バターは別だけどね。右。右。うんうん。"}, {"type": "subtitle", "time": 14172.07, "timestamp": "03:56:12", "text": "うんうん。そして私はこう思う、私は、私は、私は"}, {"type": "subtitle", "time": 14177.03, "timestamp": "03:56:17", "text": "遠回りして行ってみよう。ウィンク。の"}, {"type": "subtitle", "time": 14179.429, "timestamp": "03:56:19", "text": "もちろん、どうぞ。 「えっ、"}, {"type": "subtitle", "time": 14182.15, "timestamp": "03:56:22", "text": "これを何回ループさせることができますか？"}, {"type": "subtitle", "time": 14184.71, "timestamp": "03:56:24", "text": "どうすればこれを"}, {"type": "subtitle", "time": 14188.309, "timestamp": "03:56:28", "text": "マハーバーラタ全体のような価値がある"}, {"type": "subtitle", "time": 14196.63, "timestamp": "03:56:36", "text": "うん。ああ、それは本当に素晴らしい。私"}, {"type": "subtitle", "time": 14198.87, "timestamp": "03:56:38", "text": "あなたがそれを理解できることを願っています"}, {"type": "subtitle", "time": 14200.63, "timestamp": "03:56:40", "text": "そして、ほら、いくつか見ることになるだろう"}, {"type": "subtitle", "time": 14207.59, "timestamp": "03:56:47", "text": "こんにちは、Hungai impactへようこそ。"}, {"type": "subtitle", "time": 14210.87, "timestamp": "03:56:50", "text": "Dさん、いつ挨拶しましたか？私たちは"}, {"type": "subtitle", "time": 14213.67, "timestamp": "03:56:53", "text": "会話が盛り上がって、私たちは"}, {"type": "subtitle", "time": 14216.63, "timestamp": "03:56:56", "text": "会話の瞬間と"}, {"type": "subtitle", "time": 14219.67, "timestamp": "03:56:59", "text": "チャットを読んでいなくてごめんなさい"}]
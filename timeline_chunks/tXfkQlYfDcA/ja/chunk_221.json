[{"type": "subtitle", "time": 13262.229, "timestamp": "03:41:02", "text": "クレイジーだよ、だって開発者はそんなに多くないから"}, {"type": "subtitle", "time": 13265.51, "timestamp": "03:41:05", "text": "ビリーの直接実装が可能です"}, {"type": "subtitle", "time": 13267.75, "timestamp": "03:41:07", "text": "ビリー。いいえ、なぜなら、"}, {"type": "subtitle", "time": 13270.95, "timestamp": "03:41:10", "text": "中国の身分証明書と、中国の身分証明書と電話"}, {"type": "subtitle", "time": 13273.349, "timestamp": "03:41:13", "text": "番号と申請するもの"}, {"type": "subtitle", "time": 13276.469, "timestamp": "03:41:16", "text": "そこに開発者アカウントがあります。だからそれはとても"}, {"type": "subtitle", "time": 13279.99, "timestamp": "03:41:19", "text": "痛み。だから、これらのサードパーティ"}, {"type": "subtitle", "time": 13283.349, "timestamp": "03:41:23", "text": "人々は、"}, {"type": "subtitle", "time": 13287.83, "timestamp": "03:41:27", "text": "こういったことに対して。うん。私自身も"}, {"type": "subtitle", "time": 13290.63, "timestamp": "03:41:30", "text": "Streamabot の人々にリクエストしたこともあります"}, {"type": "subtitle", "time": 13292.95, "timestamp": "03:41:32", "text": "などなど。私はまだMix It Upをプレイしていません"}, {"type": "subtitle", "time": 13295.349, "timestamp": "03:41:35", "text": "私はMix It Upをあまり使わないので。私"}, {"type": "subtitle", "time": 13297.59, "timestamp": "03:41:37", "text": "1、2回試してみたけど、"}, {"type": "subtitle", "time": 13300.71, "timestamp": "03:41:40", "text": "私はSammyとStreamabotに心酔しています。"}, {"type": "subtitle", "time": 13304.229, "timestamp": "03:41:44", "text": "彼らは私のあらゆる活動を支えてくれた。"}, {"type": "subtitle", "time": 13306.07, "timestamp": "03:41:46", "text": "うん。"}, {"type": "subtitle", "time": 13308.229, "timestamp": "03:41:48", "text": "わあ、すごい。"}, {"type": "subtitle", "time": 13310.389, "timestamp": "03:41:50", "text": "そして、私は新しいものも"}, {"type": "subtitle", "time": 13312.87, "timestamp": "03:41:52", "text": "私が発見したストリーミングプラットフォームは"}, {"type": "subtitle", "time": 13315.59, "timestamp": "03:41:55", "text": "ビームストリーム。えっと、聞いたかどうかわかりませんが"}, {"type": "subtitle", "time": 13319.03, "timestamp": "03:41:59", "text": "それについてですが、それはプラットフォームのようなものです"}]
[{"type": "subtitle", "time": 8220.469, "timestamp": "02:17:00", "text": "まるで私の初めてのチャンネルイベントみたいだ。"}, {"type": "subtitle", "time": 8223.83, "timestamp": "02:17:03", "text": "推測。そして、"}, {"type": "subtitle", "time": 8227.349, "timestamp": "02:17:07", "text": "そして私は決して、私はどうやって"}, {"type": "subtitle", "time": 8230.15, "timestamp": "02:17:10", "text": "サブサトンやドナソンは有効です。私はそれを知っています"}, {"type": "subtitle", "time": 8232.549, "timestamp": "02:17:12", "text": "インセンティブのようなものを作らなければならないし"}, {"type": "subtitle", "time": 8236.87, "timestamp": "02:17:16", "text": "目標とか色々あるけど、始めた頃は"}, {"type": "subtitle", "time": 8241.11, "timestamp": "02:17:21", "text": "熱があったのであまり準備できず、"}, {"type": "subtitle", "time": 8246.15, "timestamp": "02:17:26", "text": "これは緊急事態として起こったことですが"}, {"type": "subtitle", "time": 8249.589, "timestamp": "02:17:29", "text": "えっと、緊急事態みたいな感じですね"}, {"type": "subtitle", "time": 8253.19, "timestamp": "02:17:33", "text": "私はこれをしなければならなかった、さもなければ忘れてしまった"}, {"type": "subtitle", "time": 8255.589, "timestamp": "02:17:35", "text": "私のモデル。だから私は「うん、私は"}, {"type": "subtitle", "time": 8258.389, "timestamp": "02:17:38", "text": "「私のモデルのために戦って、私はそれを欲しいんだ。」"}, {"type": "subtitle", "time": 8260.709, "timestamp": "02:17:40", "text": "ただ、私にはお金がないんです。えっと、"}, {"type": "subtitle", "time": 8263.349, "timestamp": "02:17:43", "text": "それは膨大な量だ。 2,000ドルは"}, {"type": "subtitle", "time": 8265.91, "timestamp": "02:17:45", "text": "ものすごい量ですよね？"}, {"type": "subtitle", "time": 8268.87, "timestamp": "02:17:48", "text": "ああ、神様。ああ、私の腎臓は、ああ、"}, {"type": "subtitle", "time": 8273.75, "timestamp": "02:17:53", "text": "その痛み。ああ、そうだね。ええ、本当に"}, {"type": "subtitle", "time": 8276.709, "timestamp": "02:17:56", "text": "膨大な量。そして私は始めた"}, {"type": "subtitle", "time": 8279.03, "timestamp": "02:17:59", "text": "目標には達しないと分かっているから"}]
[{"type": "subtitle", "time": 15424.63, "timestamp": "04:17:04", "text": "こんにちは。皆さんも楽しんでいただけたでしょうか。"}, {"type": "subtitle", "time": 15429.67, "timestamp": "04:17:09", "text": "つまり、ある意味ではこれで一件落着ということだ。えっと"}, {"type": "subtitle", "time": 15432.95, "timestamp": "04:17:12", "text": "ということで、終了しました"}, {"type": "subtitle", "time": 15435.429, "timestamp": "04:17:15", "text": "えっと、2回目のコラボが終わりました"}, {"type": "subtitle", "time": 15439.59, "timestamp": "04:17:19", "text": "その日の。ええと、ゲストが1人いました"}, {"type": "subtitle", "time": 15442.149, "timestamp": "04:17:22", "text": "後日改めて日程が組まれ、"}, {"type": "subtitle", "time": 15449.11, "timestamp": "04:17:29", "text": "6月20日（金）に。そうですね、"}, {"type": "subtitle", "time": 15450.95, "timestamp": "04:17:30", "text": "そういうこともある。"}, {"type": "subtitle", "time": 15452.87, "timestamp": "04:17:32", "text": "うん。"}, {"type": "subtitle", "time": 15462.55, "timestamp": "04:17:42", "text": "えっと"}, {"type": "chat", "time": 15462.751, "timestamp": "04:17:42", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "she was super energetic just like ya said good job on keeping up"}, {"type": "subtitle", "time": 15468.55, "timestamp": "04:17:48", "text": "こんにちは。"}, {"type": "subtitle", "time": 15470.63, "timestamp": "04:17:50", "text": "彼女はあなたが言った通り、とても元気だった。"}, {"type": "subtitle", "time": 15474.07, "timestamp": "04:17:54", "text": "よくついてきてるね。こんにちは。ええ、私は"}, {"type": "subtitle", "time": 15476.87, "timestamp": "04:17:56", "text": "爆弾級の息子と話せてよかった。あなた"}]
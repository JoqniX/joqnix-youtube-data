[{"type": "subtitle", "time": 10981.83, "timestamp": "03:03:01", "text": "背景とかアラートとかだけど"}, {"type": "subtitle", "time": 10985.11, "timestamp": "03:03:05", "text": "それには別の問題も生じるだろう"}, {"type": "subtitle", "time": 10989.349, "timestamp": "03:03:09", "text": "それは、えっと、視聴者の誰かが"}, {"type": "subtitle", "time": 10991.03, "timestamp": "03:03:11", "text": "モールを見に行くと、"}, {"type": "subtitle", "time": 10993.11, "timestamp": "03:03:13", "text": "あなたのストリームを見て、彼らはアセットを見て、"}, {"type": "subtitle", "time": 10995.51, "timestamp": "03:03:15", "text": "そういうことに対して、彼らは「いや、そうじゃない」と言うだろう"}, {"type": "subtitle", "time": 10998.389, "timestamp": "03:03:18", "text": "まあまあ合う。あの感覚、分かりますよね？"}, {"type": "subtitle", "time": 11001.67, "timestamp": "03:03:21", "text": "「何かおかしい。」それで、私はいくつか"}, {"type": "subtitle", "time": 11003.99, "timestamp": "03:03:23", "text": "YouTuberたちは、"}, {"type": "subtitle", "time": 11007.19, "timestamp": "03:03:27", "text": "鉄製の渦巻き装置のようなモデル、"}, {"type": "subtitle", "time": 11010.15, "timestamp": "03:03:30", "text": "でも、すべてが予算のようだった"}, {"type": "subtitle", "time": 11014.07, "timestamp": "03:03:34", "text": "フレンドリー。ええ、そうですね。ある意味では、"}, {"type": "subtitle", "time": 11017.269, "timestamp": "03:03:37", "text": "なんだかおかしいというか、変な感じがする"}, {"type": "subtitle", "time": 11020.469, "timestamp": "03:03:40", "text": "何か、何か、何か。"}, {"type": "subtitle", "time": 11023.83, "timestamp": "03:03:43", "text": "うん。雰囲気の質が良い"}, {"type": "subtitle", "time": 11027.11, "timestamp": "03:03:47", "text": "雰囲気はストリーマーのやつだけど"}, {"type": "subtitle", "time": 11031.59, "timestamp": "03:03:51", "text": "えーっと、視聴品質が今それなので私は"}, {"type": "subtitle", "time": 11034.79, "timestamp": "03:03:54", "text": "そうですね、いずれ直面することになるでしょう"}, {"type": "subtitle", "time": 11037.75, "timestamp": "03:03:57", "text": "その問題はあるけど、みんな最初は大丈夫"}, {"type": "subtitle", "time": 11039.83, "timestamp": "03:03:59", "text": "今どこかにいるから、見せようと思う"}]
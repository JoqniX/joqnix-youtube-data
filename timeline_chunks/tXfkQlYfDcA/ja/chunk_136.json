[{"type": "subtitle", "time": 8162.709, "timestamp": "02:16:02", "text": "それを改良したら、今ではまるで"}, {"type": "subtitle", "time": 8166.229, "timestamp": "02:16:06", "text": "プレイリスト。プレイリストは独自の"}, {"type": "subtitle", "time": 8169.109, "timestamp": "02:16:09", "text": "30本の動画からなるプレイリスト。だから、その30人全員"}, {"type": "subtitle", "time": 8170.55, "timestamp": "02:16:10", "text": "ストリームはランダム化され、完全に"}, {"type": "subtitle", "time": 8174.87, "timestamp": "02:16:14", "text": "無作為化された。そして、主な"}, {"type": "subtitle", "time": 8177.03, "timestamp": "02:16:17", "text": "1つ目は、ランダムな最初のバージョンです。"}, {"type": "subtitle", "time": 8179.91, "timestamp": "02:16:19", "text": "最初の動画はランダムなタイムスタンプになります"}, {"type": "subtitle", "time": 8182.629, "timestamp": "02:16:22", "text": "そんな風に演奏するなんて。だから、もし私が"}, {"type": "subtitle", "time": 8185.35, "timestamp": "02:16:25", "text": "寝る前に、ランダムな投票を行う。"}, {"type": "subtitle", "time": 8187.35, "timestamp": "02:16:27", "text": "まるで懐かしい瞬間のようだ。今"}, {"type": "subtitle", "time": 8190.47, "timestamp": "02:16:30", "text": "みんながその古いジョークを見ることになる。"}, {"type": "subtitle", "time": 8192.95, "timestamp": "02:16:32", "text": "うん、すごく可愛いね。そしてそれは"}, {"type": "subtitle", "time": 8194.389, "timestamp": "02:16:34", "text": "あなたが言ったことですよね？その"}, {"type": "subtitle", "time": 8196.95, "timestamp": "02:16:36", "text": "ジョアソン全体は、"}, {"type": "subtitle", "time": 8199.99, "timestamp": "02:16:39", "text": "旅そのものを楽しむ。えっと、どういう風に"}, {"type": "subtitle", "time": 8203.669, "timestamp": "02:16:43", "text": "あなたはここまでよくやってきた。それは素晴らしいですね。"}, {"type": "subtitle", "time": 8205.83, "timestamp": "02:16:45", "text": "おお。"}, {"type": "subtitle", "time": 8208.389, "timestamp": "02:16:48", "text": "涙はまだ流されていないのか、ああ"}, {"type": "subtitle", "time": 8214.549, "timestamp": "02:16:54", "text": "うん、"}, {"type": "subtitle", "time": 8217.669, "timestamp": "02:16:57", "text": "私は幸せです。それは、ええと、何かです。"}]
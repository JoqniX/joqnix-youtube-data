[{"type": "subtitle", "time": 6421.03, "timestamp": "01:47:01", "text": "一番重要なのは、あなたのサーバーには"}, {"type": "subtitle", "time": 6424.629, "timestamp": "01:47:04", "text": "ニトロブーストして、"}, {"type": "subtitle", "time": 6426.79, "timestamp": "01:47:06", "text": "より多くの音を使用できます"}, {"type": "subtitle", "time": 6429.75, "timestamp": "01:47:09", "text": "図書館とか、そんな感じの場所。えっと"}, {"type": "subtitle", "time": 6433.43, "timestamp": "01:47:13", "text": "そんな感じ。うん、"}, {"type": "subtitle", "time": 6436.31, "timestamp": "01:47:16", "text": "絵文字やステッカーと同じものです。同じ"}, {"type": "subtitle", "time": 6438.39, "timestamp": "01:47:18", "text": "まあ、そういうことかな。"}, {"type": "subtitle", "time": 6440.149, "timestamp": "01:47:20", "text": "面白い。さあ、もう私を行かせてください"}, {"type": "subtitle", "time": 6444.85, "timestamp": "01:47:24", "text": "執筆に戻って、それから送信する。"}, {"type": "subtitle", "time": 6446.79, "timestamp": "01:47:26", "text": "[音楽]"}, {"type": "subtitle", "time": 6448.95, "timestamp": "01:47:28", "text": "でも、それはそれでいいよ。それから私は"}, {"type": "subtitle", "time": 6451.83, "timestamp": "01:47:31", "text": "これを見てください。"}, {"type": "subtitle", "time": 6453.91, "timestamp": "01:47:33", "text": "つまり、毎日やるべきことなんだ"}, {"type": "subtitle", "time": 6456.55, "timestamp": "01:47:36", "text": "Redditを開いてDiscordに行く"}, {"type": "subtitle", "time": 6472.39, "timestamp": "01:47:52", "text": "ほとんどの人が最初にそちらに報告するから"}, {"type": "subtitle", "time": 6474.87, "timestamp": "01:47:54", "text": "新機能や新しい機能は何であれ"}, {"type": "subtitle", "time": 6476.709, "timestamp": "01:47:56", "text": "彼らが見る今後の機能または新しい"}]
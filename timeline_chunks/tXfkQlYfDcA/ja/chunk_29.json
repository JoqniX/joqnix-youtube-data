[{"type": "subtitle", "time": 1741.029, "timestamp": "00:29:01", "text": "うん。こんにちは。ブラッド、元気かい？"}, {"type": "subtitle", "time": 1744.47, "timestamp": "00:29:04", "text": "お元気でお過ごしでしょうか。おはよう。"}, {"type": "subtitle", "time": 1746.11, "timestamp": "00:29:06", "text": "おはよう、パン。"}, {"type": "subtitle", "time": 1747.43, "timestamp": "00:29:07", "text": "[音楽]"}, {"type": "subtitle", "time": 1754.78, "timestamp": "00:29:14", "text": "えっと、"}, {"type": "subtitle", "time": 1757.029, "timestamp": "00:29:17", "text": "[音楽]"}, {"type": "subtitle", "time": 1758.87, "timestamp": "00:29:18", "text": "おはよう。"}, {"type": "subtitle", "time": 1760.87, "timestamp": "00:29:20", "text": "SIMカードはお持ちですか？はい、すみません。ごめんなさい。"}, {"type": "subtitle", "time": 1765.19, "timestamp": "00:29:25", "text": "VTSフォグを設定しているところです。"}, {"type": "subtitle", "time": 1767.11, "timestamp": "00:29:27", "text": "テキスト読み上げの設定を忘れていた"}, {"type": "subtitle", "time": 1772.07, "timestamp": "00:29:32", "text": "YouTubeチャット用です。"}, {"type": "subtitle", "time": 1773.909, "timestamp": "00:29:33", "text": "それと、この小さな"}, {"type": "subtitle", "time": 1778.23, "timestamp": "00:29:38", "text": "このバカバカ仲間。私は作りたい"}, {"type": "subtitle", "time": 1781.75, "timestamp": "00:29:41", "text": "彼に話してもらいましょう。そうですね、"}, {"type": "subtitle", "time": 1784.47, "timestamp": "00:29:44", "text": "私は彼を後ろに隠していました"}, {"type": "subtitle", "time": 1787.269, "timestamp": "00:29:47", "text": "みんなのアバターはこんな感じ。"}, {"type": "subtitle", "time": 1790.389, "timestamp": "00:29:50", "text": "そう、彼に動かしてもらいたいんだ"}, {"type": "subtitle", "time": 1792.71, "timestamp": "00:29:52", "text": "テキストを書くときに話すように"}, {"type": "subtitle", "time": 1795.11, "timestamp": "00:29:55", "text": "音声コマンド。"}]
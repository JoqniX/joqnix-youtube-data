[{"type": "subtitle", "time": 9603.67, "timestamp": "02:40:03", "text": "例えば、2026年か2027年のジョアソン大会のように。それを置いて、それをする"}, {"type": "subtitle", "time": 9606.95, "timestamp": "02:40:06", "text": "警官にとっては正当な理由とかね。"}, {"type": "subtitle", "time": 9610.95, "timestamp": "02:40:10", "text": "こんな感じ、ああ、こんな感じ、そしてまたこんな感じ"}, {"type": "subtitle", "time": 9612.95, "timestamp": "02:40:12", "text": "人々に無理強いしているわけではない"}, {"type": "subtitle", "time": 9615.03, "timestamp": "02:40:15", "text": "ナイフを突きつけられたとか、そんな感じ"}, {"type": "subtitle", "time": 9616.309, "timestamp": "02:40:16", "text": "あなたはただ「もしあなたが望むなら」と言うだけです"}, {"type": "subtitle", "time": 9618.79, "timestamp": "02:40:18", "text": "それでいいよ、サポートしてくれる人たち"}, {"type": "subtitle", "time": 9620.469, "timestamp": "02:40:20", "text": "本当にサポートしたいと思っていて、"}, {"type": "subtitle", "time": 9623.91, "timestamp": "02:40:23", "text": "それで全く問題ないよ"}, {"type": "subtitle", "time": 9625.03, "timestamp": "02:40:25", "text": "[音楽]"}, {"type": "subtitle", "time": 9628.55, "timestamp": "02:40:28", "text": "それはとても素敵ですが、私はそう願っています"}, {"type": "subtitle", "time": 9631.67, "timestamp": "02:40:31", "text": "すべて順調です、ああ"}, {"type": "subtitle", "time": 9633.67, "timestamp": "02:40:33", "text": "保存したい。うん。すべてがうまくいくことを願っています"}, {"type": "subtitle", "time": 9636.55, "timestamp": "02:40:36", "text": "うまくいった。"}, {"type": "subtitle", "time": 9638.15, "timestamp": "02:40:38", "text": "うん。"}, {"type": "subtitle", "time": 9640.71, "timestamp": "02:40:40", "text": "えっと、待って、いつから始めたの？"}, {"type": "subtitle", "time": 9644.469, "timestamp": "02:40:44", "text": "ストリーミングチューブとかそういうの？えっと、私たちは"}, {"type": "subtitle", "time": 9647.429, "timestamp": "02:40:47", "text": "チューブ。私は始めたと思います"}, {"type": "subtitle", "time": 9650.63, "timestamp": "02:40:50", "text": "20 21"}, {"type": "subtitle", "time": 9653.11, "timestamp": "02:40:53", "text": "疑問符。確かその頃だったと思います。"}, {"type": "subtitle", "time": 9655.75, "timestamp": "02:40:55", "text": "まるで4年が経ったかのようだ"}, {"type": "subtitle", "time": 9658.15, "timestamp": "02:40:58", "text": "私が覚えているのはそれだけです。そう、"}]
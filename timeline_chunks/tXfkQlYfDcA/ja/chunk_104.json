[{"type": "subtitle", "time": 6241.669, "timestamp": "01:44:01", "text": "実は。"}, {"type": "subtitle", "time": 6243.91, "timestamp": "01:44:03", "text": "おお。"}, {"type": "subtitle", "time": 6245.91, "timestamp": "01:44:05", "text": "彼らは妊娠しているのですか？わかった。サーバーとして、つまり、"}, {"type": "subtitle", "time": 6248.709, "timestamp": "01:44:08", "text": "ソングボードの管理方法を教えてください。えっと、"}, {"type": "subtitle", "time": 6250.55, "timestamp": "01:44:10", "text": "サーバーの現在のサーバーを管理します"}, {"type": "subtitle", "time": 6252.79, "timestamp": "01:44:12", "text": "サーバー設定にヘッドオン"}, {"type": "subtitle", "time": 6255.03, "timestamp": "01:44:15", "text": "ボード。ほとんどのサーバーで私は"}, {"type": "subtitle", "time": 6260.149, "timestamp": "01:44:20", "text": "「この物が見えません」のモデレーター"}, {"type": "subtitle", "time": 6262.87, "timestamp": "01:44:22", "text": "すべて削除する。だからアップロードする必要がある"}, {"type": "subtitle", "time": 6269.59, "timestamp": "01:44:29", "text": "ここに音声をアップロードする必要があります"}, {"type": "subtitle", "time": 6272.709, "timestamp": "01:44:32", "text": "人々がそれを利用できるように。私はそうは思わない"}, {"type": "subtitle", "time": 6276.149, "timestamp": "01:44:36", "text": "方法はないと思います"}, {"type": "subtitle", "time": 6278.79, "timestamp": "01:44:38", "text": "デフォルト設定はないと思うので"}, {"type": "subtitle", "time": 6281.43, "timestamp": "01:44:41", "text": "音はするけど、ステッカーや絵文字みたいなもの"}, {"type": "subtitle", "time": 6284.47, "timestamp": "01:44:44", "text": "サーバーオーナーは管理者に連絡できます"}, {"type": "subtitle", "time": 6288.07, "timestamp": "01:44:48", "text": "自分の音源をアップロードする必要がある。"}, {"type": "subtitle", "time": 6290.149, "timestamp": "01:44:50", "text": "うん。"}, {"type": "subtitle", "time": 6292.149, "timestamp": "01:44:52", "text": "ゲームオーバーレイで使用できます"}, {"type": "subtitle", "time": 6294.31, "timestamp": "01:44:54", "text": "ゲームプレイヤーとしてプレイしているとき"}]
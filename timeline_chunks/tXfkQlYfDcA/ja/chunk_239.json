[{"type": "subtitle", "time": 14342.63, "timestamp": "03:59:02", "text": "知りませんでした。私はストリームのために"}, {"type": "subtitle", "time": 14345.67, "timestamp": "03:59:05", "text": "デッキ仲間はこんな感じだった"}, {"type": "subtitle", "time": 14348.87, "timestamp": "03:59:08", "text": "9000とかそんな感じ。"}, {"type": "subtitle", "time": 14354.309, "timestamp": "03:59:14", "text": "そのくらいだ。 9000とかそんな感じ。"}, {"type": "subtitle", "time": 14358.79, "timestamp": "03:59:18", "text": "約10,000ルピー。そして私は"}, {"type": "subtitle", "time": 14361.91, "timestamp": "03:59:21", "text": "6,000ドル支払わなければならなかった。"}, {"type": "subtitle", "time": 14366.229, "timestamp": "03:59:26", "text": "何？うん。 6. それはほとんど"}, {"type": "subtitle", "time": 14371.189, "timestamp": "03:59:31", "text": "その費用。うん。それはおかしい。"}, {"type": "subtitle", "time": 14373.51, "timestamp": "03:59:33", "text": "そして私は父に何度も懇願した。彼は"}, {"type": "subtitle", "time": 14375.91, "timestamp": "03:59:35", "text": "「これって何の役に立つの？」"}, {"type": "subtitle", "time": 14378.309, "timestamp": "03:59:38", "text": "これは必要ない。私たちは与えません"}, {"type": "subtitle", "time": 14380.55, "timestamp": "03:59:40", "text": "「お金ちょうだい」と言って、私は泣きながら懇願した。"}, {"type": "subtitle", "time": 14383.67, "timestamp": "03:59:43", "text": "懇願した。ついに私にくれた彼が私にくれた"}, {"type": "subtitle", "time": 14386.389, "timestamp": "03:59:46", "text": "お金を受け取ることができ、"}, {"type": "subtitle", "time": 14390.389, "timestamp": "03:59:50", "text": "もの。ああ、だって外に男がいたから"}, {"type": "subtitle", "time": 14393.99, "timestamp": "03:59:53", "text": "私の持ち物と一緒に。文字通りそこにあるのですが、"}, {"type": "subtitle", "time": 14396.79, "timestamp": "03:59:56", "text": "お金がないから買えない。私"}, {"type": "subtitle", "time": 14398.71, "timestamp": "03:59:58", "text": "彼に懇願して、かわいそうな男"}]
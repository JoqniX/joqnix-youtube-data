[{"type": "subtitle", "time": 1682.23, "timestamp": "00:28:02", "text": "一つと、もう一つ。だからあなたは"}, {"type": "subtitle", "time": 1684.87, "timestamp": "00:28:04", "text": "APIキーなどを使用して"}, {"type": "subtitle", "time": 1688.63, "timestamp": "00:28:08", "text": "そんな感じだ。そして現在、私は"}, {"type": "subtitle", "time": 1690.47, "timestamp": "00:28:10", "text": "戦争をダウンロードすると、"}, {"type": "subtitle", "time": 1692.23, "timestamp": "00:28:12", "text": "遅れ"}, {"type": "subtitle", "time": 1695.19, "timestamp": "00:28:15", "text": "ビットレートのせいで"}, {"type": "subtitle", "time": 1699.51, "timestamp": "00:28:19", "text": "一貫性がない。だから覚えておいてください"}, {"type": "subtitle", "time": 1701.59, "timestamp": "00:28:21", "text": "皆さんが経験するであろう"}, {"type": "subtitle", "time": 1704.789, "timestamp": "00:28:24", "text": "それに気づくのに少し遅れ"}, {"type": "subtitle", "time": 1714.47, "timestamp": "00:28:34", "text": "えっと、もしそうなら、"}, {"type": "subtitle", "time": 1716.549, "timestamp": "00:28:36", "text": "時間が経てば、あなたも理解できるかもしれません。そこには"}, {"type": "subtitle", "time": 1719.11, "timestamp": "00:28:39", "text": "2分、3分の遅延になるかもしれません"}, {"type": "subtitle", "time": 1720.95, "timestamp": "00:28:40", "text": "遅れ。場合によります。でも今のところは"}, {"type": "subtitle", "time": 1725.669, "timestamp": "00:28:45", "text": "安定化の。合がありました"}, {"type": "subtitle", "time": 1728.71, "timestamp": "00:28:48", "text": "えっと、少し前ですが、今は"}, {"type": "subtitle", "time": 1731.11, "timestamp": "00:28:51", "text": "大丈夫。"}, {"type": "subtitle", "time": 1734.31, "timestamp": "00:28:54", "text": "そうですね、"}, {"type": "subtitle", "time": 1737.43, "timestamp": "00:28:57", "text": "私たちは大丈夫でしょう。はい。それはパンです。"}, {"type": "chat", "time": 1737.453, "timestamp": "00:28:57", "author": "@Totembtw", "avatar": "https://yt4.ggpht.com/hioaXnlAE2bO9zkq1LR7obAzNHeT2CyJQVDqLyLs1xpQtflZ50pJJfeodntXZC_QCm0VDoyEgA=s64-c-k-c0x00ffffff-no-rj", "message": "ello"}]
[{"type": "subtitle", "time": 8281.19, "timestamp": "02:18:01", "text": "私は小規模なチャンネルですよね？それから私は"}, {"type": "subtitle", "time": 8283.509, "timestamp": "02:18:03", "text": "それでも私はそれをやるつもりだと気づいた。私は"}, {"type": "subtitle", "time": 8287.349, "timestamp": "02:18:07", "text": "それをお見せします。私も、"}, {"type": "subtitle", "time": 8289.19, "timestamp": "02:18:09", "text": "自分自身に見せてみて。新モデルは"}, {"type": "subtitle", "time": 8291.83, "timestamp": "02:18:11", "text": "本当に綺麗で本当に高級感があって"}, {"type": "subtitle", "time": 8294.79, "timestamp": "02:18:14", "text": "えっと、なんて言うんでしたっけ？証明する"}, {"type": "subtitle", "time": 8298.389, "timestamp": "02:18:18", "text": "自分自身に、それを使う価値があると確信している。おお"}, {"type": "subtitle", "time": 8302.469, "timestamp": "02:18:22", "text": "うん。デビューして"}, {"type": "subtitle", "time": 8304.549, "timestamp": "02:18:24", "text": "それは失敗だった。いいえ、私自身の欠点のせいです"}, {"type": "subtitle", "time": 8307.75, "timestamp": "02:18:27", "text": "スキルの。しかし、私はそのモデルに"}, {"type": "subtitle", "time": 8309.589, "timestamp": "02:18:29", "text": "真にふさわしい輝きを放つ"}, {"type": "subtitle", "time": 8311.99, "timestamp": "02:18:31", "text": "ふさわしい。だから私は「うん、しないよ」って言った"}, {"type": "subtitle", "time": 8315.349, "timestamp": "02:18:35", "text": "これらすべてをするのは、それを手に入れるためだけです"}, {"type": "subtitle", "time": 8317.83, "timestamp": "02:18:37", "text": "そこにはもっと愛がある"}, {"type": "subtitle", "time": 8320.709, "timestamp": "02:18:40", "text": "はい"}, {"type": "subtitle", "time": 8323.75, "timestamp": "02:18:43", "text": "そして、私の最初の計画は"}, {"type": "subtitle", "time": 8327.429, "timestamp": "02:18:47", "text": "ジョアソンは来週で終わるよね？"}, {"type": "subtitle", "time": 8329.99, "timestamp": "02:18:49", "text": "ジャルに届かなかったので、"}, {"type": "subtitle", "time": 8332.469, "timestamp": "02:18:52", "text": "まあいいか、少なくとも私は"}, {"type": "subtitle", "time": 8334.709, "timestamp": "02:18:54", "text": "思い出ができて、みんなと話すことができた"}, {"type": "subtitle", "time": 8337.27, "timestamp": "02:18:57", "text": "私は恐れていた多くの新しいことに挑戦しました"}]
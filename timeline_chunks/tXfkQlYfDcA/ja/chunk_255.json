[{"type": "subtitle", "time": 15301.59, "timestamp": "04:15:01", "text": "挽く。"}, {"type": "subtitle", "time": 15304.309, "timestamp": "04:15:04", "text": "さあ行こう。さあ"}, {"type": "subtitle", "time": 15310.95, "timestamp": "04:15:10", "text": "あなたの幸運を祈っています。ありがとう。そして私は"}, {"type": "subtitle", "time": 15313.269, "timestamp": "04:15:13", "text": "あなたが最高であることを願っています。ほら、私たちを見てよ。"}, {"type": "subtitle", "time": 15316.79, "timestamp": "04:15:16", "text": "まるで一緒に頑張っているみたいに私たちを見てください。"}, {"type": "subtitle", "time": 15330.469, "timestamp": "04:15:30", "text": "はい、今日はありがとうございました。そうだった"}, {"type": "subtitle", "time": 15332.63, "timestamp": "04:15:32", "text": "君と一緒に過ごすのは本当に楽しかったよ。できない"}, {"type": "subtitle", "time": 15335.349, "timestamp": "04:15:35", "text": "これが私たちの最初の集まりだと信じています、"}, {"type": "chat", "time": 15335.396, "timestamp": "04:15:35", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "great work keep upbthe grind"}, {"type": "subtitle", "time": 15337.75, "timestamp": "04:15:37", "text": "協力し合い、話し合う。それはありました"}, {"type": "subtitle", "time": 15347.03, "timestamp": "04:15:47", "text": "うん。本日はありがとうございました。"}, {"type": "subtitle", "time": 15349.189, "timestamp": "04:15:49", "text": "将来的に協力し、"}, {"type": "subtitle", "time": 15353.189, "timestamp": "04:15:53", "text": "素晴らしい夜になりそうだ。ポムサ。ありがとう。あなた"}, {"type": "subtitle", "time": 15354.95, "timestamp": "04:15:54", "text": "あまりにも。"}, {"type": "subtitle", "time": 15357.189, "timestamp": "04:15:57", "text": "さよなら。"}, {"type": "subtitle", "time": 15359.91, "timestamp": "04:15:59", "text": "バイバイ。チャットの全員がさよならを言う"}]
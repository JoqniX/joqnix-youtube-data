[{"type": "subtitle", "time": 3185.67, "timestamp": "00:53:05", "text": "ああ、これをスピードアップするつもりだ"}, {"type": "subtitle", "time": 3188.549, "timestamp": "00:53:08", "text": "あまりにも多くのので、私は次のことを始めます"}, {"type": "subtitle", "time": 3191.75, "timestamp": "00:53:11", "text": "本日は2つのテーマについて議論します。私は食べています"}, {"type": "subtitle", "time": 3195.27, "timestamp": "00:53:15", "text": "朝食。うん、いいよ、いいよ、いいよ。ニース。"}, {"type": "subtitle", "time": 3198.47, "timestamp": "00:53:18", "text": "私も。"}, {"type": "subtitle", "time": 3201.03, "timestamp": "00:53:21", "text": "私はまだ朝食を食べていません。レベル"}, {"type": "subtitle", "time": 3204.309, "timestamp": "00:53:24", "text": "おそらく近いうちに。"}, {"type": "subtitle", "time": 3211.91, "timestamp": "00:53:31", "text": "あなたはドーサとインレイを食べています。おお、いいね、"}, {"type": "subtitle", "time": 3213.91, "timestamp": "00:53:33", "text": "いいね、いいね。"}, {"type": "subtitle", "time": 3218.95, "timestamp": "00:53:38", "text": "両方どうやって食べるのですか？バ。おお。"}, {"type": "subtitle", "time": 3222.069, "timestamp": "00:53:42", "text": "私を見てなさい。ドーサを1枚だけ食べます"}, {"type": "subtitle", "time": 3227.91, "timestamp": "00:53:47", "text": "食べる量が減りました。"}, {"type": "subtitle", "time": 3236.28, "timestamp": "00:53:56", "text": "性的な存在"}]
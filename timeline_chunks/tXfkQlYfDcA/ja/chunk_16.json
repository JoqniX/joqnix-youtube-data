[{"type": "subtitle", "time": 961.19, "timestamp": "00:16:01", "text": "何？"}, {"type": "subtitle", "time": 967.59, "timestamp": "00:16:07", "text": "[音楽]"}, {"type": "subtitle", "time": 969.99, "timestamp": "00:16:09", "text": "あのね？とりあえず、お前を殺してやる。"}, {"type": "subtitle", "time": 973.189, "timestamp": "00:16:13", "text": "私は殺される。"}, {"type": "subtitle", "time": 988.87, "timestamp": "00:16:28", "text": "えっと、私のGPUが過負荷になっているのかもしれません"}, {"type": "subtitle", "time": 991.189, "timestamp": "00:16:31", "text": "RTXトラッカーを使用しているため"}, {"type": "subtitle", "time": 995.269, "timestamp": "00:16:35", "text": "VIPスタジオでのレコーディング用。"}, {"type": "subtitle", "time": 997.43, "timestamp": "00:16:37", "text": "だから私は時々注意する必要がある"}, {"type": "subtitle", "time": 1000.949, "timestamp": "00:16:40", "text": "オープンアプリケーションは、"}, {"type": "subtitle", "time": 1003.91, "timestamp": "00:16:43", "text": "GPUリソ​​ースが多すぎる"}, {"type": "subtitle", "time": 1007.43, "timestamp": "00:16:47", "text": "でも、それほど多くはないですよね"}, {"type": "subtitle", "time": 1009.35, "timestamp": "00:16:49", "text": "19％"}, {"type": "subtitle", "time": 1014.069, "timestamp": "00:16:54", "text": "少し時間がかかるけど、30～40％くらいかな。"}, {"type": "subtitle", "time": 1016.71, "timestamp": "00:16:56", "text": "だから、大丈夫だよ"}, {"type": "subtitle", "time": 1018.79, "timestamp": "00:16:58", "text": "これは何ですか"}]
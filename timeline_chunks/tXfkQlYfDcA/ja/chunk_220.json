[{"type": "subtitle", "time": 13204.389, "timestamp": "03:40:04", "text": "このファンクラブみたいなのもね。うん。それで、"}, {"type": "subtitle", "time": 13208.229, "timestamp": "03:40:08", "text": "ラッププラスライブには、"}, {"type": "subtitle", "time": 13211.11, "timestamp": "03:40:11", "text": "そういうイベントのためだけに。だから私は"}, {"type": "subtitle", "time": 13213.91, "timestamp": "03:40:13", "text": "チャットイベントが可能かどうか尋ねた"}, {"type": "subtitle", "time": 13215.91, "timestamp": "03:40:15", "text": "チャットメッセージとか、全部含まれてるよね？それで、"}, {"type": "subtitle", "time": 13219.75, "timestamp": "03:40:19", "text": "彼らは、えーと、何を作ったのか"}, {"type": "subtitle", "time": 13222.71, "timestamp": "03:40:22", "text": "あなたはそれを何と呼ぶのですか？彼らはイベントのようにした"}, {"type": "subtitle", "time": 13225.269, "timestamp": "03:40:25", "text": "橋。つまり、イベントだけでなく、"}, {"type": "subtitle", "time": 13227.349, "timestamp": "03:40:27", "text": "コメントやその他起こることすべて"}, {"type": "subtitle", "time": 13231.59, "timestamp": "03:40:31", "text": "ストリーマーのライブルームは、えーと、"}, {"type": "subtitle", "time": 13233.91, "timestamp": "03:40:33", "text": "そこにいるよ。だから、ああ、そうだね"}, {"type": "subtitle", "time": 13236.63, "timestamp": "03:40:36", "text": "コードを開くとか、そういうこと"}, {"type": "subtitle", "time": 13238.95, "timestamp": "03:40:38", "text": "コマンドは物事を推進し、それを維持する必要がある"}, {"type": "subtitle", "time": 13241.75, "timestamp": "03:40:41", "text": "そこが走っていて、それが接続します"}, {"type": "subtitle", "time": 13245.11, "timestamp": "03:40:45", "text": "ウェブソケット関連のものがサミーに接続し、"}, {"type": "subtitle", "time": 13247.269, "timestamp": "03:40:47", "text": "Sammy から Discord に送信され、"}, {"type": "subtitle", "time": 13250.15, "timestamp": "03:40:50", "text": "そういうことばかり。ああ、それは"}, {"type": "subtitle", "time": 13253.03, "timestamp": "03:40:53", "text": "クレイジー。ループのように"}, {"type": "subtitle", "time": 13254.95, "timestamp": "03:40:54", "text": "ジャンプして1つ手に入れる"}, {"type": "subtitle", "time": 13257.59, "timestamp": "03:40:57", "text": "仕事が好きになること。信じられない。うん、そうだね"}]
[{"type": "subtitle", "time": 14400.71, "timestamp": "04:00:00", "text": "待っていて、これらすべてを聞いていた"}, {"type": "subtitle", "time": 14402.95, "timestamp": "04:00:02", "text": "口論や喧嘩が続いていて、私は"}, {"type": "subtitle", "time": 14406.55, "timestamp": "04:00:06", "text": "お願いしますと言って、ついに彼は同意して、"}, {"type": "subtitle", "time": 14408.95, "timestamp": "04:00:08", "text": "支払いを済ませて、ついに手に入れました"}, {"type": "subtitle", "time": 14413.59, "timestamp": "04:00:13", "text": "それで私は「うわー、私は直面した」と思った"}, {"type": "subtitle", "time": 14417.67, "timestamp": "04:00:17", "text": "この男のせいで戦争になった。"}, {"type": "subtitle", "time": 14419.67, "timestamp": "04:00:19", "text": "待って、でも彼らはこう言わないの？"}, {"type": "subtitle", "time": 14421.83, "timestamp": "04:00:21", "text": "事前に、ああ、こうかもしれない"}, {"type": "subtitle", "time": 14425.75, "timestamp": "04:00:25", "text": "関税、価格など、いいえ、私は"}, {"type": "subtitle", "time": 14428.389, "timestamp": "04:00:28", "text": "知る。 DHLか何かで、"}, {"type": "subtitle", "time": 14431.349, "timestamp": "04:00:31", "text": "ああ、これは"}, {"type": "subtitle", "time": 14438.95, "timestamp": "04:00:38", "text": "うん。そして、それは役に立たない、"}, {"type": "subtitle", "time": 14442.79, "timestamp": "04:00:42", "text": "電子機器のようなものから"}, {"type": "subtitle", "time": 14444.95, "timestamp": "04:00:44", "text": "異国の地のような。それが彼らの"}, {"type": "subtitle", "time": 14447.189, "timestamp": "04:00:47", "text": "のように。ああ、私たちは置かなければならない、私たちは置かなければならない"}, {"type": "subtitle", "time": 14452.71, "timestamp": "04:00:52", "text": "[音楽]"}, {"type": "subtitle", "time": 14456.469, "timestamp": "04:00:56", "text": "それはfです。でも今はもう手に入れたじゃないか。"}, {"type": "subtitle", "time": 14458.95, "timestamp": "04:00:58", "text": "ええ、今は持っています。"}]
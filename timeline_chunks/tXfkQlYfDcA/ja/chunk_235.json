[{"type": "subtitle", "time": 14101.91, "timestamp": "03:55:01", "text": "そうやってOBSに1つのフィードを送信する。それは"}, {"type": "subtitle", "time": 14105.99, "timestamp": "03:55:05", "text": "簡単。すごくかっこいい。そして私はこう思った"}, {"type": "subtitle", "time": 14108.469, "timestamp": "03:55:08", "text": "今、私は何が必要なのか、何が必要なのかを知っています"}, {"type": "subtitle", "time": 14112.469, "timestamp": "03:55:12", "text": "ライブコンサート形式のワンマンショーを行う"}, {"type": "subtitle", "time": 14115.349, "timestamp": "03:55:15", "text": "こういうVTuberのコンサートとか"}, {"type": "subtitle", "time": 14117.59, "timestamp": "03:55:17", "text": "ライトにはたくさんの人が必要です"}, {"type": "subtitle", "time": 14122.309, "timestamp": "03:55:22", "text": "などなど。しかし、寿司ドラゴンを見ると、"}, {"type": "subtitle", "time": 14123.75, "timestamp": "03:55:23", "text": "『スシドラゴン』を見て、私はこう思った。"}, {"type": "subtitle", "time": 14125.99, "timestamp": "03:55:25", "text": "「ああ、ハンドコントローラーみたいなのが手に入るよ」"}, {"type": "subtitle", "time": 14127.99, "timestamp": "03:55:27", "text": "そして、ボタンを押す、マクロ、"}, {"type": "subtitle", "time": 14132.07, "timestamp": "03:55:32", "text": "物をコントロールし、歌って動き、踊る、"}, {"type": "subtitle", "time": 14135.75, "timestamp": "03:55:35", "text": "すべて。それはすごくクールだね。」さて、"}, {"type": "subtitle", "time": 14137.429, "timestamp": "03:55:37", "text": "そうするべきだ。えっと、あなたは"}, {"type": "subtitle", "time": 14140.79, "timestamp": "03:55:40", "text": "えっと、なんていう名前だったっけ？"}, {"type": "subtitle", "time": 14143.99, "timestamp": "03:55:43", "text": "3Dモーションキャプチャのような状況で"}, {"type": "subtitle", "time": 14145.189, "timestamp": "03:55:45", "text": "すると、"}, {"type": "subtitle", "time": 14146.87, "timestamp": "03:55:46", "text": "カメラとライトは制御されているのか、それとも"}, {"type": "subtitle", "time": 14148.55, "timestamp": "03:55:48", "text": "何か違うものが欲しいですか？"}, {"type": "subtitle", "time": 14152.15, "timestamp": "03:55:52", "text": "やろうと思ったんだけど、"}, {"type": "subtitle", "time": 14156.229, "timestamp": "03:55:56", "text": "普通のウェブカメラを使ってやってる"}, {"type": "subtitle", "time": 14158.07, "timestamp": "03:55:58", "text": "しかし将来は、"}]
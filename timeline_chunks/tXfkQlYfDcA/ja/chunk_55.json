[{"type": "subtitle", "time": 3300.87, "timestamp": "00:55:00", "text": "３つの流れか何かについて話していた"}, {"type": "subtitle", "time": 3305.27, "timestamp": "00:55:05", "text": "座るのが嫌いだったとかそういうことについて"}, {"type": "subtitle", "time": 3308.23, "timestamp": "00:55:08", "text": "などなど、そして私はここにいます"}, {"type": "subtitle", "time": 3311.589, "timestamp": "00:55:11", "text": "なぜなら、生きるためには"}, {"type": "subtitle", "time": 3314.23, "timestamp": "00:55:14", "text": "この社会では、"}, {"type": "subtitle", "time": 3317.109, "timestamp": "00:55:17", "text": "書類や書類、その他諸々"}, {"type": "subtitle", "time": 3320.87, "timestamp": "00:55:20", "text": "君はその学位が好きだけど、そういうのは苦痛なんだね。"}, {"type": "subtitle", "time": 3322.95, "timestamp": "00:55:22", "text": "私を見て。"}, {"type": "subtitle", "time": 3327.03, "timestamp": "00:55:27", "text": "「私はそうする」と言った人は、いや、そうしない"}, {"type": "subtitle", "time": 3329.75, "timestamp": "00:55:29", "text": "正直に大学に入学して、"}, {"type": "subtitle", "time": 3333.589, "timestamp": "00:55:33", "text": "今の私。痛み。今、私はどんな気持ちか分かります"}, {"type": "subtitle", "time": 3336.87, "timestamp": "00:55:36", "text": "ダックになろう。それは大学生です。ああ、"}, {"type": "subtitle", "time": 3339.19, "timestamp": "00:55:39", "text": "神、"}, {"type": "subtitle", "time": 3344.87, "timestamp": "00:55:44", "text": "あなたが行く前に、私は"}, {"type": "subtitle", "time": 3349.19, "timestamp": "00:55:49", "text": "持ち帰り。それは痛みだ。"}, {"type": "subtitle", "time": 3351.27, "timestamp": "00:55:51", "text": "私は行きたくなかった、つまり私は"}, {"type": "subtitle", "time": 3353.51, "timestamp": "00:55:53", "text": "4、3、4年間は行かなかった"}, {"type": "subtitle", "time": 3357.75, "timestamp": "00:55:57", "text": "しかし、私は学位も取得しなければならなかった"}, {"type": "subtitle", "time": 3359.829, "timestamp": "00:55:59", "text": "できない"}]
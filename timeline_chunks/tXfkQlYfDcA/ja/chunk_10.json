[{"type": "subtitle", "time": 600.87, "timestamp": "00:10:00", "text": "人生は終わった。そう、私は"}, {"type": "subtitle", "time": 603.67, "timestamp": "00:10:03", "text": "前日の字幕"}, {"type": "subtitle", "time": 610.47, "timestamp": "00:10:10", "text": "Photoshopの使い方を手伝ってくれますか？うん、"}, {"type": "subtitle", "time": 612.55, "timestamp": "00:10:12", "text": "はい、はい、はい。やってみます、やってみます"}, {"type": "subtitle", "time": 620.389, "timestamp": "00:10:20", "text": "噂をすれば影、字幕"}, {"type": "subtitle", "time": 627.03, "timestamp": "00:10:27", "text": "字幕とかをダウンロードさせてください"}, {"type": "subtitle", "time": 631.03, "timestamp": "00:10:31", "text": "既に完了しているので、アップロードしてください。"}, {"type": "subtitle", "time": 633.75, "timestamp": "00:10:33", "text": "えっと、これ"}, {"type": "subtitle", "time": 637.19, "timestamp": "00:10:37", "text": "これをスピードダンで欲しい。"}, {"type": "subtitle", "time": 640.55, "timestamp": "00:10:40", "text": "これをスピードランするつもりだ"}, {"type": "subtitle", "time": 645.509, "timestamp": "00:10:45", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 646.949, "timestamp": "00:10:46", "text": "こんなことを"}, {"type": "subtitle", "time": 650.069, "timestamp": "00:10:50", "text": "ストリーム。でも、そうせざるを得なかったんだ。"}, {"type": "subtitle", "time": 653.03, "timestamp": "00:10:53", "text": "私は一日遅れている"}, {"type": "subtitle", "time": 655.35, "timestamp": "00:10:55", "text": "ボードをアップロードしています。"}, {"type": "subtitle", "time": 659.269, "timestamp": "00:10:59", "text": "そう、まだダウンロード中なんだ"}]
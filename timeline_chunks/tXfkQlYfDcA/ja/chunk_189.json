[{"type": "subtitle", "time": 11340.23, "timestamp": "03:09:00", "text": "周りにある小さな音符"}, {"type": "subtitle", "time": 11342.15, "timestamp": "03:09:02", "text": "あれがバッジですよね？の"}, {"type": "subtitle", "time": 11344.95, "timestamp": "03:09:04", "text": "小さな音符。"}, {"type": "subtitle", "time": 11347.11, "timestamp": "03:09:07", "text": "すごく可愛いですね。"}, {"type": "subtitle", "time": 11349.349, "timestamp": "03:09:09", "text": "完璧を目指せ。"}, {"type": "subtitle", "time": 11352.15, "timestamp": "03:09:12", "text": "うん。全てがうまくいくことを願っています。しかし"}, {"type": "subtitle", "time": 11353.67, "timestamp": "03:09:13", "text": "うん。"}, {"type": "subtitle", "time": 11358.87, "timestamp": "03:09:18", "text": "非常に勤勉。えっと、あのね"}, {"type": "subtitle", "time": 11360.95, "timestamp": "03:09:20", "text": "あなたが望むもの。だから、それは良いことだと思う"}, {"type": "subtitle", "time": 11363.269, "timestamp": "03:09:23", "text": "目標を持って働くのが好きです"}, {"type": "subtitle", "time": 11365.51, "timestamp": "03:09:25", "text": "これに向かってそれに向かってそれはとても"}, {"type": "subtitle", "time": 11368.15, "timestamp": "03:09:28", "text": "目的もなく彷徨うよりはましだ。"}, {"type": "subtitle", "time": 11371.59, "timestamp": "03:09:31", "text": "ああ、いろいろ試してみたよ。うん、"}, {"type": "subtitle", "time": 11374.15, "timestamp": "03:09:34", "text": "なぜなら、ここで障害物が現れて"}, {"type": "subtitle", "time": 11377.75, "timestamp": "03:09:37", "text": "そこで私は自分の限界に気づきました"}, {"type": "subtitle", "time": 11380.79, "timestamp": "03:09:40", "text": "私は何でも屋なので、"}, {"type": "subtitle", "time": 11383.83, "timestamp": "03:09:43", "text": "ナイの達人。私は多くのことに手を出しています"}, {"type": "subtitle", "time": 11386.71, "timestamp": "03:09:46", "text": "いろいろあって、完全に終わらせることができない"}, {"type": "subtitle", "time": 11389.51, "timestamp": "03:09:49", "text": "そういう感じで、私は"}, {"type": "subtitle", "time": 11393.03, "timestamp": "03:09:53", "text": "私には手伝ってくれる人が必要で、私にはできない"}, {"type": "subtitle", "time": 11395.75, "timestamp": "03:09:55", "text": "これまでずっと一人でやってきたことです。"}, {"type": "subtitle", "time": 11397.67, "timestamp": "03:09:57", "text": "右。うん。"}]
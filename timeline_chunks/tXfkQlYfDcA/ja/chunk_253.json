[{"type": "subtitle", "time": 15183.429, "timestamp": "04:13:03", "text": "ダー・ラップ。そして実際、私は"}, {"type": "subtitle", "time": 15186.309, "timestamp": "04:13:06", "text": "ちょっとした嬉しいニュースです。えっと、私は"}, {"type": "subtitle", "time": 15188.87, "timestamp": "04:13:08", "text": "非常に刺激的なグループの一員になり、"}, {"type": "subtitle", "time": 15192.309, "timestamp": "04:13:12", "text": "まもなくデビュー。それはデビューするようなものです"}, {"type": "subtitle", "time": 15194.87, "timestamp": "04:13:14", "text": "今月の15日。 15日と"}, {"type": "subtitle", "time": 15197.83, "timestamp": "04:13:17", "text": "20日。えっと、"}, {"type": "subtitle", "time": 15201.03, "timestamp": "04:13:21", "text": "ヴィヴィア。ああ、それは"}, {"type": "subtitle", "time": 15203.429, "timestamp": "04:13:23", "text": "ツイッター。いや、秘密だよ"}, {"type": "subtitle", "time": 15205.51, "timestamp": "04:13:25", "text": "けれど。"}, {"type": "subtitle", "time": 15208.309, "timestamp": "04:13:28", "text": "えっと、それはとても手入れが行き届いていない"}, {"type": "subtitle", "time": 15211.429, "timestamp": "04:13:31", "text": "私がその一員であることは秘密だけど、えっと"}, {"type": "subtitle", "time": 15214.63, "timestamp": "04:13:34", "text": "私たちはまもなくデビューします。だから私は"}, {"type": "subtitle", "time": 15216.87, "timestamp": "04:13:36", "text": "皆さんが協力してくださると本当にありがたいです"}, {"type": "subtitle", "time": 15220.309, "timestamp": "04:13:40", "text": "チェックして、ええ、チェックしてみてください"}, {"type": "subtitle", "time": 15223.99, "timestamp": "04:13:43", "text": "私の世代が集まります。ええと、とてもワクワクしています。"}, {"type": "subtitle", "time": 15226.87, "timestamp": "04:13:46", "text": "でも待って、あなたはそれはそれは"}, {"type": "subtitle", "time": 15229.429, "timestamp": "04:13:49", "text": "伍長。彼女は自立した女の子だ。その"}, {"type": "subtitle", "time": 15231.429, "timestamp": "04:13:51", "text": "ない。そうではありません。非常に独立心が強い。"}, {"type": "subtitle", "time": 15233.51, "timestamp": "04:13:53", "text": "うん。ああ、なるほど。"}, {"type": "subtitle", "time": 15235.59, "timestamp": "04:13:55", "text": "うん。うん。うん。うん。でも、えっと"}, {"type": "subtitle", "time": 15237.51, "timestamp": "04:13:57", "text": "私たちは間違いなくもっと"}, {"type": "subtitle", "time": 15239.59, "timestamp": "04:13:59", "text": "リラックスした感じ。えっと、まるで"}]
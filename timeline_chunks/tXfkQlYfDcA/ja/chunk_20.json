[{"type": "subtitle", "time": 1201.669, "timestamp": "00:20:01", "text": "4月12日だったかな？ああ神様"}, {"type": "subtitle", "time": 1204.95, "timestamp": "00:20:04", "text": "その単語はダウンロードされました。どのようにどのように"}, {"type": "subtitle", "time": 1208.71, "timestamp": "00:20:08", "text": "例えば、ファイルサイズは7GBです。待って"}, {"type": "subtitle", "time": 1219.19, "timestamp": "00:20:19", "text": "何？ 7 GB"}, {"type": "subtitle", "time": 1222.63, "timestamp": "00:20:22", "text": "はぁ？いいえ、これは違います。何"}, {"type": "subtitle", "time": 1225.19, "timestamp": "00:20:25", "text": "はぁ？"}, {"type": "subtitle", "time": 1227.669, "timestamp": "00:20:27", "text": "えっと、何をダウンロードしたんだっけ？何"}, {"type": "subtitle", "time": 1229.75, "timestamp": "00:20:29", "text": "待って、"}, {"type": "subtitle", "time": 1233.19, "timestamp": "00:20:33", "text": "バカ。なぜ私はあなたをダウンロードしたのか"}, {"type": "subtitle", "time": 1235.75, "timestamp": "00:20:35", "text": "間違ったストリームをダウンロードしてしまいました。ああ、"}, {"type": "subtitle", "time": 1238.07, "timestamp": "00:20:38", "text": "ああ、間違ったストリームをダウンロードしてしまった。私"}, {"type": "subtitle", "time": 1240.95, "timestamp": "00:20:40", "text": "間違ったストリームをダウンロードしました。私"}, {"type": "subtitle", "time": 1244.149, "timestamp": "00:20:44", "text": "間違ったストリームをダウンロードしました。何てことだ、"}, {"type": "subtitle", "time": 1247.19, "timestamp": "00:20:47", "text": "私は1時間待った"}, {"type": "subtitle", "time": 1253.83, "timestamp": "00:20:53", "text": "何てことだ。前日にダウンロードしました"}, {"type": "subtitle", "time": 1255.51, "timestamp": "00:20:55", "text": "昨日の配信。これをダウンロードしました"}, {"type": "subtitle", "time": 1259.19, "timestamp": "00:20:59", "text": "1つ。 10時間配信を再び。たぶん"}]
[{"type": "subtitle", "time": 5821.91, "timestamp": "01:37:01", "text": "でも、私はこれをこんな風に使っています"}, {"type": "subtitle", "time": 5825.83, "timestamp": "01:37:05", "text": "この大きな本。私は持っている"}, {"type": "subtitle", "time": 5829.96, "timestamp": "01:37:09", "text": "これは一体どんな種類の本ですか？"}, {"type": "subtitle", "time": 5831.35, "timestamp": "01:37:11", "text": "[音楽]"}, {"type": "subtitle", "time": 5836.47, "timestamp": "01:37:16", "text": "実際はノートです。これは大変なことだ。"}, {"type": "subtitle", "time": 5838.709, "timestamp": "01:37:18", "text": "ああ、これはどんな種類の本ですか？しかしそれは"}, {"type": "subtitle", "time": 5842.629, "timestamp": "01:37:22", "text": "紙のグリッドから。かなり大きい。どうやら"}, {"type": "subtitle", "time": 5846.709, "timestamp": "01:37:26", "text": "A4サイズのページ。"}, {"type": "subtitle", "time": 5849.669, "timestamp": "01:37:29", "text": "ええ、これを使っています。終わった"}, {"type": "subtitle", "time": 5852.39, "timestamp": "01:37:32", "text": "3つの科目のようなもの。現在進行中"}, {"type": "subtitle", "time": 5855.03, "timestamp": "01:37:35", "text": "4、3、4、5、4で"}, {"type": "subtitle", "time": 5857.43, "timestamp": "01:37:37", "text": "そして5番目の科目。"}, {"type": "subtitle", "time": 5859.59, "timestamp": "01:37:39", "text": "そして配信の最後には、"}, {"type": "subtitle", "time": 5862.709, "timestamp": "01:37:42", "text": "最後の3科目から始めましょう。"}, {"type": "subtitle", "time": 5866.149, "timestamp": "01:37:46", "text": "3人まとめてスピードランする。"}, {"type": "subtitle", "time": 5873.35, "timestamp": "01:37:53", "text": "うん、3つまとめてスピードランに挑戦してみるよ"}, {"type": "subtitle", "time": 5876.95, "timestamp": "01:37:56", "text": "行く。うん、3つまとめてスピードランするよ。"}, {"type": "subtitle", "time": 5878.79, "timestamp": "01:37:58", "text": "どうなるか見てみましょう。もちろん、"}]
[{"type": "subtitle", "time": 11220.55, "timestamp": "03:07:00", "text": "じっくりと見て回るべき点がたくさんある。"}, {"type": "subtitle", "time": 11222.469, "timestamp": "03:07:02", "text": "検討すべきことがたくさんある。良い、"}, {"type": "subtitle", "time": 11224.469, "timestamp": "03:07:04", "text": "あなたは「もちろん！」って感じ。私は嬉しいです"}, {"type": "subtitle", "time": 11226.63, "timestamp": "03:07:06", "text": "あなたがそういう分野に挑戦してくれて嬉しいです。"}, {"type": "subtitle", "time": 11228.309, "timestamp": "03:07:08", "text": "私もそうしたかった"}, {"type": "subtitle", "time": 11229.83, "timestamp": "03:07:09", "text": "冒険に出るけど、それはまるで"}, {"type": "subtitle", "time": 11232.389, "timestamp": "03:07:12", "text": "時に圧倒されるほどだ。私はそうは思わない"}, {"type": "subtitle", "time": 11234.87, "timestamp": "03:07:14", "text": "君と同じように完璧主義者だと思うよ、"}, {"type": "subtitle", "time": 11238.55, "timestamp": "03:07:18", "text": "でも私は絶対にそうじゃない"}, {"type": "subtitle", "time": 11240.55, "timestamp": "03:07:20", "text": "何をすべきかを知っている。私は圧倒されてしまう。"}, {"type": "subtitle", "time": 11242.309, "timestamp": "03:07:22", "text": "やりたいことがたくさんあるし"}, {"type": "subtitle", "time": 11244.15, "timestamp": "03:07:24", "text": "そうすると時間が足りなくなる。だからそれは"}, {"type": "subtitle", "time": 11246.23, "timestamp": "03:07:26", "text": "ああ、わかった、"}, {"type": "subtitle", "time": 11251.349, "timestamp": "03:07:31", "text": "やらないことにします。問題解決。"}, {"type": "subtitle", "time": 11254.63, "timestamp": "03:07:34", "text": "でも最初は音楽だけを入れたかったんです"}, {"type": "subtitle", "time": 11256.79, "timestamp": "03:07:36", "text": "オリジナル音楽のようなもの"}, {"type": "subtitle", "time": 11258.309, "timestamp": "03:07:38", "text": "実際に作ると良い"}, {"type": "subtitle", "time": 11261.429, "timestamp": "03:07:41", "text": "音楽を聴いて、プロフェッショナルな音楽に"}, {"type": "subtitle", "time": 11264.389, "timestamp": "03:07:44", "text": "メインチャンネルで。私は実際に"}, {"type": "subtitle", "time": 11266.23, "timestamp": "03:07:46", "text": "これらのショットやクリップをアップロードして"}, {"type": "subtitle", "time": 11268.15, "timestamp": "03:07:48", "text": "Vチャンネルのすべて。それは私の"}, {"type": "subtitle", "time": 11271.11, "timestamp": "03:07:51", "text": "去年の最初のアイデアで、今はこう"}, {"type": "subtitle", "time": 11273.59, "timestamp": "03:07:53", "text": "うん、大丈夫だよ。森カリオピ彼ら彼らは"}, {"type": "subtitle", "time": 11277.11, "timestamp": "03:07:57", "text": "彼女はすでに好きだったショーをしました"}]
[{"type": "subtitle", "time": 9781.03, "timestamp": "02:43:01", "text": "音楽関係のことが好きです。子供の頃の私は"}, {"type": "subtitle", "time": 9784.55, "timestamp": "02:43:04", "text": "えっと、入ろうとした時にPCを手に入れた"}, {"type": "subtitle", "time": 9786.55, "timestamp": "02:43:06", "text": "そして、まるで小学校3年生の頃のようなインターネット環境。だから私は"}, {"type": "subtitle", "time": 9788.469, "timestamp": "02:43:08", "text": "インターネットの仕組みを理解するようなもの"}, {"type": "subtitle", "time": 9790.23, "timestamp": "02:43:10", "text": "作品もその他すべて。これにハマった"}, {"type": "subtitle", "time": 9793.03, "timestamp": "02:43:13", "text": "音楽面では、EDMのような"}, {"type": "subtitle", "time": 9795.67, "timestamp": "02:43:15", "text": "音楽も何もかも。いいえ。だから私は"}, {"type": "subtitle", "time": 9798.63, "timestamp": "02:43:18", "text": "DJやプロデューサーのように音楽"}, {"type": "subtitle", "time": 9801.67, "timestamp": "02:43:21", "text": "自分で作るタイプのプロデューサー"}, {"type": "subtitle", "time": 9803.27, "timestamp": "02:43:23", "text": "音楽、"}, {"type": "subtitle", "time": 9805.99, "timestamp": "02:43:25", "text": "人々を幸せにし、人々を笑顔にしよう"}, {"type": "subtitle", "time": 9809.67, "timestamp": "02:43:29", "text": "そして私の感情や思考を"}, {"type": "subtitle", "time": 9812.389, "timestamp": "02:43:32", "text": "音楽的な音色として出力され、"}, {"type": "subtitle", "time": 9815.67, "timestamp": "02:43:35", "text": "もの。こうして私はジョックネックを作ったのです"}, {"type": "subtitle", "time": 9817.99, "timestamp": "02:43:37", "text": "最初は芸名のようなもので"}, {"type": "subtitle", "time": 9823.83, "timestamp": "02:43:43", "text": "もの。それから私はかわいい。うん。そして、私は"}, {"type": "subtitle", "time": 9826.309, "timestamp": "02:43:46", "text": "この音楽Vlogで私が行き詰まったのは"}, {"type": "subtitle", "time": 9828.07, "timestamp": "02:43:48", "text": "私は先に進むことができなかった。私は行き詰まっていました"}, {"type": "subtitle", "time": 9831.269, "timestamp": "02:43:51", "text": "FL Studioのチュートリアルをたくさん見て、"}, {"type": "subtitle", "time": 9833.429, "timestamp": "02:43:53", "text": "私は燃え尽きていて、ああ"}, {"type": "subtitle", "time": 9836.71, "timestamp": "02:43:56", "text": "私は全く曲を作ることができません。行き詰まってしまった。私"}, {"type": "subtitle", "time": 9839.429, "timestamp": "02:43:59", "text": "どこが悪いのか分からないし"}]
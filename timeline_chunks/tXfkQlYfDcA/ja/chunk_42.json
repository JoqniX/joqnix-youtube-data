[{"type": "subtitle", "time": 2521.91, "timestamp": "00:42:01", "text": "ああ、そうそう、昨日私は読んでいた"}, {"type": "subtitle", "time": 2529.43, "timestamp": "00:42:09", "text": "入学率が低い。私は到達したと思います"}, {"type": "subtitle", "time": 2533.27, "timestamp": "00:42:13", "text": "第60章まで。うん。うん。うん。から"}, {"type": "subtitle", "time": 2536.55, "timestamp": "00:42:16", "text": "第24章から第60章まで読んでいました。"}, {"type": "subtitle", "time": 2539.91, "timestamp": "00:42:19", "text": "すべては半夜で、そしてまるで"}, {"type": "subtitle", "time": 2542.87, "timestamp": "00:42:22", "text": "12歳くらいかな。いいえ。ええ。 12または"}, {"type": "subtitle", "time": 2545.27, "timestamp": "00:42:25", "text": "何か。うん。うん。うん。 3つで3"}, {"type": "subtitle", "time": 2549.99, "timestamp": "00:42:29", "text": "数時間か2時間後、私は眠ってしまった。"}, {"type": "subtitle", "time": 2553.03, "timestamp": "00:42:33", "text": "うん。私はただ"}, {"type": "subtitle", "time": 2555.19, "timestamp": "00:42:35", "text": "少し読んで、書かれたものが好きです"}, {"type": "subtitle", "time": 2557.27, "timestamp": "00:42:37", "text": "何か"}, {"type": "subtitle", "time": 2560.47, "timestamp": "00:42:40", "text": "私の手は王様だった。だから私は"}, {"type": "subtitle", "time": 2567.27, "timestamp": "00:42:47", "text": "これを読んでみます"}, {"type": "subtitle", "time": 2571.43, "timestamp": "00:42:51", "text": "そして、リラックスする、かな。"}, {"type": "subtitle", "time": 2573.43, "timestamp": "00:42:53", "text": "人種グループ"}, {"type": "subtitle", "time": 2576.15, "timestamp": "00:42:56", "text": "は"}, {"type": "subtitle", "time": 2577.58, "timestamp": "00:42:57", "text": "アフリカ系アメリカ人"}]
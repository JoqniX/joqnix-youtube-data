[{"type": "subtitle", "time": 9126.79, "timestamp": "02:32:06", "text": "うん"}, {"type": "subtitle", "time": 9130.469, "timestamp": "02:32:10", "text": "彼らは私がそこでストリーミング配信できることを知っている"}, {"type": "subtitle", "time": 9135.349, "timestamp": "02:32:15", "text": "それがナイスだ。わあ、すごい。あなたと同じように"}, {"type": "subtitle", "time": 9137.83, "timestamp": "02:32:17", "text": "もっとアカウントを作らないといけない。"}, {"type": "subtitle", "time": 9139.67, "timestamp": "02:32:19", "text": "それはあなたの家族一人ひとりのようなものです"}, {"type": "subtitle", "time": 9142.07, "timestamp": "02:32:22", "text": "他のカードも手に入れなければならない"}, {"type": "subtitle", "time": 9145.349, "timestamp": "02:32:25", "text": "それを使用するには、うん。まるで"}, {"type": "subtitle", "time": 9147.91, "timestamp": "02:32:27", "text": "もう一方のカードを持って自撮りをする"}, {"type": "subtitle", "time": 9151.91, "timestamp": "02:32:31", "text": "そして友人と戻ってきました。え、何？彼らです"}, {"type": "subtitle", "time": 9155.11, "timestamp": "02:32:35", "text": "それらに関しては厳格だ。"}, {"type": "subtitle", "time": 9157.51, "timestamp": "02:32:37", "text": "くそ。そうだよね。彼らはまるで"}, {"type": "subtitle", "time": 9166.23, "timestamp": "02:32:46", "text": "何てことだ。"}, {"type": "subtitle", "time": 9168.309, "timestamp": "02:32:48", "text": "努力のためにすること、"}, {"type": "subtitle", "time": 9170.95, "timestamp": "02:32:50", "text": "コンテンツクリエイターの苦労。"}, {"type": "subtitle", "time": 9173.11, "timestamp": "02:32:53", "text": "うん。"}, {"type": "subtitle", "time": 9175.59, "timestamp": "02:32:55", "text": "今や誰もがマルチリーミングをしている。行く"}, {"type": "subtitle", "time": 9178.79, "timestamp": "02:32:58", "text": "Kickやその他のプラットフォーム。うんうん。右。"}]
[{"type": "subtitle", "time": 8462.79, "timestamp": "02:21:02", "text": "協力する。"}, {"type": "subtitle", "time": 8472.469, "timestamp": "02:21:12", "text": "でも、私はあなたが"}, {"type": "subtitle", "time": 8474.63, "timestamp": "02:21:14", "text": "まるで別の時代のことなので、私は"}, {"type": "subtitle", "time": 8477.59, "timestamp": "02:21:17", "text": "あなたがそこにいたことを知ってください"}, {"type": "subtitle", "time": 8480.15, "timestamp": "02:21:20", "text": "先に述べたとおりです。うん。ああ、それは"}, {"type": "subtitle", "time": 8481.67, "timestamp": "02:21:21", "text": "わかった。まるで公然の知識のように"}, {"type": "subtitle", "time": 8484.79, "timestamp": "02:21:24", "text": "ええ、私はドバイを拠点に活動しています。うん"}, {"type": "subtitle", "time": 8486.63, "timestamp": "02:21:26", "text": "私はドバイを拠点にしているので、"}, {"type": "subtitle", "time": 8489.51, "timestamp": "02:21:29", "text": "それは、えっと、インドのそれとはかけ離れています。"}, {"type": "subtitle", "time": 8492.309, "timestamp": "02:21:32", "text": "タイムゾーン。えっと、私はただとても"}, {"type": "subtitle", "time": 8495.349, "timestamp": "02:21:35", "text": "夜型人間。私は"}, {"type": "subtitle", "time": 8498.389, "timestamp": "02:21:38", "text": "夜間のように機能するため、"}, {"type": "subtitle", "time": 8500.309, "timestamp": "02:21:40", "text": "私がコラボレーションする多くの人々"}, {"type": "subtitle", "time": 8502.469, "timestamp": "02:21:42", "text": "一緒に働く人たちはいつも"}, {"type": "subtitle", "time": 8504.95, "timestamp": "02:21:44", "text": "アメリカのタイムゾーンと同じです。だから私はこう思った"}, {"type": "subtitle", "time": 8508.55, "timestamp": "02:21:48", "text": "これが私の現在のタイムゾーンです。"}, {"type": "subtitle", "time": 8510.23, "timestamp": "02:21:50", "text": "うん。だから、数日ある"}, {"type": "subtitle", "time": 8511.59, "timestamp": "02:21:51", "text": "私はただ、ただ行きたいだけです"}, {"type": "subtitle", "time": 8513.75, "timestamp": "02:21:53", "text": "午前6時頃に寝て、それから"}, {"type": "subtitle", "time": 8515.11, "timestamp": "02:21:55", "text": "午前9時頃に起きて、"}, {"type": "subtitle", "time": 8518.63, "timestamp": "02:21:58", "text": "「よし、いつものように一日頑張ろう。」"}]
[{"type": "subtitle", "time": 12960.389, "timestamp": "03:36:00", "text": "人々が見てきたように"}, {"type": "subtitle", "time": 12962.63, "timestamp": "03:36:02", "text": "タイピング。それらを禁止しても、"}, {"type": "subtitle", "time": 12964.55, "timestamp": "03:36:04", "text": "コレクションのようなものを持っている"}, {"type": "subtitle", "time": 12967.67, "timestamp": "03:36:07", "text": "彼らはそう言った。えっと、そして、似たようなビットでも"}, {"type": "subtitle", "time": 12970.07, "timestamp": "03:36:10", "text": "それに、彼らは何ていうか"}, {"type": "subtitle", "time": 12972.71, "timestamp": "03:36:12", "text": "電話した？みんなの要約みたいに"}, {"type": "subtitle", "time": 12975.429, "timestamp": "03:36:15", "text": "寄付とかそういう類のもの。それが最初の"}, {"type": "subtitle", "time": 12977.349, "timestamp": "03:36:17", "text": "誰かがそれをやっているのを聞いたのはいつだったかな"}, {"type": "subtitle", "time": 12979.75, "timestamp": "03:36:19", "text": "すぐにDiscordを好きになる。"}, {"type": "subtitle", "time": 12981.91, "timestamp": "03:36:21", "text": "面白い。そしてそれは"}, {"type": "subtitle", "time": 12983.67, "timestamp": "03:36:23", "text": "すべてを扱いやすくする"}, {"type": "subtitle", "time": 12985.99, "timestamp": "03:36:25", "text": "それから？これらすべてと同じように扱う"}, {"type": "subtitle", "time": 12989.83, "timestamp": "03:36:29", "text": "マルチリーム。うん。ええと、そういう意味で私は"}, {"type": "subtitle", "time": 12995.269, "timestamp": "03:36:35", "text": "えーと、それは、えーと、維持するのに役立ちます。"}, {"type": "subtitle", "time": 12997.51, "timestamp": "03:36:37", "text": "メッセージやいいね！した人の追跡"}, {"type": "subtitle", "time": 12999.99, "timestamp": "03:36:39", "text": "誰かが私にゲームを勧めたとか、"}, {"type": "subtitle", "time": 13004.309, "timestamp": "03:36:44", "text": "何か。えっと、重要なことは何か"}, {"type": "subtitle", "time": 13007.11, "timestamp": "03:36:47", "text": "忘れてしまった。いつでも戻ることができる"}, {"type": "subtitle", "time": 13009.269, "timestamp": "03:36:49", "text": "そしてチャットログを見てください"}, {"type": "subtitle", "time": 13012.87, "timestamp": "03:36:52", "text": "それ。以前は、"}, {"type": "subtitle", "time": 13015.03, "timestamp": "03:36:55", "text": "かつては視聴者一人ひとりに感謝していた"}, {"type": "subtitle", "time": 13017.67, "timestamp": "03:36:57", "text": "ストリーム配信などに来た人たち。それで"}]
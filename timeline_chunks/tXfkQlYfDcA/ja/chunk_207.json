[{"type": "subtitle", "time": 12421.67, "timestamp": "03:27:01", "text": "ソフトウェアとか、そういう類のもの。だから私は"}, {"type": "subtitle", "time": 12424.389, "timestamp": "03:27:04", "text": "信者をストリーミング配信するため。だから私は"}, {"type": "subtitle", "time": 12426.229, "timestamp": "03:27:06", "text": "OBSの仮想カメラを使用するには、"}, {"type": "subtitle", "time": 12429.19, "timestamp": "03:27:09", "text": "OBSからソフトウェアにオーディオをルーティングする"}, {"type": "subtitle", "time": 12431.75, "timestamp": "03:27:11", "text": "仮想ケーブルを使用する。そして、"}, {"type": "subtitle", "time": 12435.83, "timestamp": "03:27:15", "text": "ストリーム。何？うん。"}, {"type": "subtitle", "time": 12440.309, "timestamp": "03:27:20", "text": "うん。本当に大変だった。そして今、"}, {"type": "subtitle", "time": 12443.429, "timestamp": "03:27:23", "text": "ついに10,000に到達した"}, {"type": "subtitle", "time": 12446.22, "timestamp": "03:27:26", "text": "フォロワー。"}, {"type": "subtitle", "time": 12448.15, "timestamp": "03:27:28", "text": "[音楽]"}, {"type": "subtitle", "time": 12451.429, "timestamp": "03:27:31", "text": "それは違う、それは多すぎる"}, {"type": "subtitle", "time": 12456.55, "timestamp": "03:27:36", "text": "常軌を逸したジャンプ。 100から10,000まで。"}, {"type": "subtitle", "time": 12460.07, "timestamp": "03:27:40", "text": "うん。そして、誰もがそれに腹を立てていた。そして"}, {"type": "subtitle", "time": 12462.63, "timestamp": "03:27:42", "text": "そして、その時私は学んだのです"}, {"type": "subtitle", "time": 12466.309, "timestamp": "03:27:46", "text": "私が話していたユーチューバーは"}, {"type": "subtitle", "time": 12469.429, "timestamp": "03:27:49", "text": "多くのユーチューバーがそうであるように"}, {"type": "subtitle", "time": 12472.95, "timestamp": "03:27:52", "text": "戦うのは、生き残るためだ"}, {"type": "subtitle", "time": 12476.469, "timestamp": "03:27:56", "text": "そのプラットフォームでは、多くの"}, {"type": "subtitle", "time": 12479.429, "timestamp": "03:27:59", "text": "機能やその他はスーパーで"}]
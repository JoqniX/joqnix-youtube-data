[{"type": "subtitle", "time": 2100.069, "timestamp": "00:35:00", "text": "今日はかなり大きく変わりました。"}, {"type": "subtitle", "time": 2102.069, "timestamp": "00:35:02", "text": "それはあなたの車です。"}, {"type": "subtitle", "time": 2104.71, "timestamp": "00:35:04", "text": "後退してください。"}, {"type": "subtitle", "time": 2107.27, "timestamp": "00:35:07", "text": "ええ、私です。戻ってきました。"}, {"type": "subtitle", "time": 2118.23, "timestamp": "00:35:18", "text": "私にやらせてください。"}, {"type": "subtitle", "time": 2120.51, "timestamp": "00:35:20", "text": "いくつかやらなければならないことがある。"}, {"type": "subtitle", "time": 2124.63, "timestamp": "00:35:24", "text": "[音楽]"}, {"type": "subtitle", "time": 2127.19, "timestamp": "00:35:27", "text": "わかりました、loi と"}, {"type": "subtitle", "time": 2129.349, "timestamp": "00:35:29", "text": "背景では一緒に演奏していた、"}, {"type": "subtitle", "time": 2132.15, "timestamp": "00:35:32", "text": "全てを混ぜ合わせる。なぜ誰も"}, {"type": "subtitle", "time": 2139.589, "timestamp": "00:35:39", "text": "ピン留め解除メッセージをもっと見る。わかった。"}, {"type": "subtitle", "time": 2142.87, "timestamp": "00:35:42", "text": "こんにちは、戻ってきました。少し時間がかかります"}, {"type": "subtitle", "time": 2145.99, "timestamp": "00:35:45", "text": "すべてにおいて、あなたは"}, {"type": "subtitle", "time": 2148.31, "timestamp": "00:35:48", "text": "君たちはまた歓迎されるかもしれないよ"}, {"type": "subtitle", "time": 2151.91, "timestamp": "00:35:51", "text": "私の持ち物はすべて再処理されました。"}, {"type": "subtitle", "time": 2155.67, "timestamp": "00:35:55", "text": "リセットしてください。では、戻りましょう"}, {"type": "subtitle", "time": 2157.6, "timestamp": "00:35:57", "text": "文章にする。わかった、"}, {"type": "subtitle", "time": 2159.109, "timestamp": "00:35:59", "text": "[音楽]"}]
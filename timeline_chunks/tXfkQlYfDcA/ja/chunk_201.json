[{"type": "subtitle", "time": 12061.11, "timestamp": "03:21:01", "text": "離れて寝たり、カップルで寝たりするのが好きです"}, {"type": "subtitle", "time": 12064.15, "timestamp": "03:21:04", "text": "友達はチャットやゲームを楽しめます"}, {"type": "subtitle", "time": 12066.07, "timestamp": "03:21:06", "text": "ゲームとか配信するんだよね、"}, {"type": "subtitle", "time": 12068.229, "timestamp": "03:21:08", "text": "Discord経由で。だから私は"}, {"type": "subtitle", "time": 12071.99, "timestamp": "03:21:11", "text": "信頼できる友人とそうやって"}, {"type": "subtitle", "time": 12074.469, "timestamp": "03:21:14", "text": "ビリービリーの管理者は文字通り"}, {"type": "subtitle", "time": 12077.67, "timestamp": "03:21:17", "text": "私の配信を30秒間。うん。言う"}, {"type": "subtitle", "time": 12081.19, "timestamp": "03:21:21", "text": "あのネガティブなライブストリーミングのこと"}, {"type": "subtitle", "time": 12084.07, "timestamp": "03:21:24", "text": "そして、話した後で気づいたのですが"}, {"type": "subtitle", "time": 12087.349, "timestamp": "03:21:27", "text": "次に登場する動画は"}, {"type": "subtitle", "time": 12091.67, "timestamp": "03:21:31", "text": "週、彼女は「うん、ビリー」と言った"}, {"type": "subtitle", "time": 12094.309, "timestamp": "03:21:34", "text": "ビリーにはちゃんとした著作権が必要だ"}, {"type": "subtitle", "time": 12097.83, "timestamp": "03:21:37", "text": "あらゆるコンテンツに対する許可など"}, {"type": "subtitle", "time": 12099.99, "timestamp": "03:21:39", "text": "YouTubeの動画なども再生する"}, {"type": "subtitle", "time": 12104.229, "timestamp": "03:21:44", "text": "著作権の許可が必要です"}, {"type": "subtitle", "time": 12107.59, "timestamp": "03:21:47", "text": "元の人物や資料から。私は"}, {"type": "subtitle", "time": 12110.63, "timestamp": "03:21:50", "text": "自分のVODを再生している。それは"}, {"type": "subtitle", "time": 12113.59, "timestamp": "03:21:53", "text": "仕事もね。"}, {"type": "subtitle", "time": 12115.75, "timestamp": "03:21:55", "text": "待って、あなたは自分のWDをプレイしていて、"}, {"type": "subtitle", "time": 12117.75, "timestamp": "03:21:57", "text": "彼らは、許可が必要だ"}]
[{"type": "subtitle", "time": 3540.63, "timestamp": "00:59:00", "text": "それ。うん、手に入れるよ。"}, {"type": "subtitle", "time": 3542.15, "timestamp": "00:59:02", "text": "実質的に"}, {"type": "subtitle", "time": 3564.23, "timestamp": "00:59:24", "text": "そして再び"}, {"type": "subtitle", "time": 3571.51, "timestamp": "00:59:31", "text": "ああ、それは伝説だ。わかった。"}, {"type": "subtitle", "time": 3582.23, "timestamp": "00:59:42", "text": "うん、昼食前だよね？取りに行きます"}, {"type": "subtitle", "time": 3585.589, "timestamp": "00:59:45", "text": "お風呂。トイレに行って、お風呂に入ってきます。"}, {"type": "subtitle", "time": 3588.23, "timestamp": "00:59:48", "text": "そして戻ってきてください。私は推測する"}, {"type": "subtitle", "time": 3590.39, "timestamp": "00:59:50", "text": "私は死ぬだろう"}, {"type": "subtitle", "time": 3592.95, "timestamp": "00:59:52", "text": "この暑さの中で。"}, {"type": "subtitle", "time": 3595.75, "timestamp": "00:59:55", "text": "ええ、時計を戻して"}, {"type": "subtitle", "time": 3598.87, "timestamp": "00:59:58", "text": "私たちの冬、そして私たちは戻って戻って"}]
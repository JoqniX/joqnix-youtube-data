[{"type": "subtitle", "time": 10921.99, "timestamp": "03:02:01", "text": "モデルが良いので期待が高まります"}, {"type": "subtitle", "time": 10924.23, "timestamp": "03:02:04", "text": "そう、だから私もこれをやっているんです"}, {"type": "subtitle", "time": 10927.11, "timestamp": "03:02:07", "text": "ドカソンだから、ほら、えっと、私は"}, {"type": "subtitle", "time": 10930.309, "timestamp": "03:02:10", "text": "今の自分にはまだ合わない気がする"}, {"type": "subtitle", "time": 10933.429, "timestamp": "03:02:13", "text": "なぜなら、もっと必要だから、"}, {"type": "subtitle", "time": 10934.87, "timestamp": "03:02:14", "text": "今はもっと努力して、すべてにおいて"}, {"type": "subtitle", "time": 10936.95, "timestamp": "03:02:16", "text": "全てにおいて、よりプロフェッショナルな対応が求められる。"}, {"type": "subtitle", "time": 10939.83, "timestamp": "03:02:19", "text": "そして品質に対する期待があり、"}, {"type": "subtitle", "time": 10941.99, "timestamp": "03:02:21", "text": "資産においても同様"}, {"type": "subtitle", "time": 10944.15, "timestamp": "03:02:24", "text": "そして全てと凝縮されたスタイル"}, {"type": "subtitle", "time": 10947.429, "timestamp": "03:02:27", "text": "すべてを変えなければならない、そうでしょう？それで"}, {"type": "subtitle", "time": 10950.23, "timestamp": "03:02:30", "text": "そういうの全部あるし、ああ"}, {"type": "subtitle", "time": 10956.95, "timestamp": "03:02:36", "text": "なんてこった。まるで今すぐ働かなければならないかのように"}, {"type": "subtitle", "time": 10962.469, "timestamp": "03:02:42", "text": "160%増くらい。ああ、なんてことだ。"}, {"type": "subtitle", "time": 10965.429, "timestamp": "03:02:45", "text": "うん。だから私は、"}, {"type": "subtitle", "time": 10968.15, "timestamp": "03:02:48", "text": "今のところはモデルだが、残りのアセット"}, {"type": "subtitle", "time": 10971.67, "timestamp": "03:02:51", "text": "今はゆっくりと手に入れることができる"}, {"type": "subtitle", "time": 10973.99, "timestamp": "03:02:53", "text": "もちろん、私が好きになる方法があります"}, {"type": "subtitle", "time": 10977.67, "timestamp": "03:02:57", "text": "予算に優しい資産を選ぶ"}]
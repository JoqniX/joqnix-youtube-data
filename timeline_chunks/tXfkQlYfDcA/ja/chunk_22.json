[{"type": "subtitle", "time": 1321.669, "timestamp": "00:22:01", "text": "1つ"}, {"type": "subtitle", "time": 1325.669, "timestamp": "00:22:05", "text": "スピードランのように"}, {"type": "subtitle", "time": 1327.909, "timestamp": "00:22:07", "text": "字幕やその他諸々も信じがたい"}, {"type": "subtitle", "time": 1331.909, "timestamp": "00:22:11", "text": "このような。私はそれに慣れていて、"}, {"type": "subtitle", "time": 1335.43, "timestamp": "00:22:15", "text": "保存すれば完了です。私たちは"}, {"type": "subtitle", "time": 1337.669, "timestamp": "00:22:17", "text": "ビリー。"}, {"type": "subtitle", "time": 1343.11, "timestamp": "00:22:23", "text": "中国語版をアップロードしてください。ここへ行ってください。"}, {"type": "subtitle", "time": 1346.149, "timestamp": "00:22:26", "text": "字幕って何ですか？"}, {"type": "subtitle", "time": 1350.39, "timestamp": "00:22:30", "text": "ええ、中国人です。それから英語。"}, {"type": "subtitle", "time": 1353.99, "timestamp": "00:22:33", "text": "そうしてください。これをやってください。"}, {"type": "subtitle", "time": 1358.39, "timestamp": "00:22:38", "text": "教えてください。良い。良い。こんにちは。えっと、投稿"}, {"type": "subtitle", "time": 1361.75, "timestamp": "00:22:41", "text": "あれ。私は何を入力したのだろう？私は何を入力したのか"}, {"type": "subtitle", "time": 1364.39, "timestamp": "00:22:44", "text": "また昨日のことか？"}, {"type": "subtitle", "time": 1365.75, "timestamp": "00:22:45", "text": "コピー＆ペーストします"}, {"type": "subtitle", "time": 1367.27, "timestamp": "00:22:47", "text": "昨日の。"}, {"type": "subtitle", "time": 1374.87, "timestamp": "00:22:54", "text": "ああ、もしこれが見つかればね。なぜ私はタイプしたのか"}, {"type": "subtitle", "time": 1377.75, "timestamp": "00:22:57", "text": "昨日？これです。いいえ。いいえ。前日"}]
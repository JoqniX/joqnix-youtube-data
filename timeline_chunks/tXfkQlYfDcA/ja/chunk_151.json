[{"type": "subtitle", "time": 9060.07, "timestamp": "02:31:00", "text": "それは大抵、あなたが「うん」を好きではないときです。"}, {"type": "subtitle", "time": 9061.51, "timestamp": "02:31:01", "text": "他のカードはそうではない"}, {"type": "subtitle", "time": 9064.15, "timestamp": "02:31:04", "text": "該当する。大丈夫だと思いますよ"}, {"type": "subtitle", "time": 9065.99, "timestamp": "02:31:05", "text": "うまくいけば。"}, {"type": "subtitle", "time": 9068.71, "timestamp": "02:31:08", "text": "うん。そうだといい。"}, {"type": "subtitle", "time": 9072.07, "timestamp": "02:31:12", "text": "うん。ああ、それから私は2つ持っています。"}, {"type": "subtitle", "time": 9074.15, "timestamp": "02:31:14", "text": "チャンネルは実際に存在します。だからあなたは"}, {"type": "subtitle", "time": 9076.07, "timestamp": "02:31:16", "text": "新しい番号、電話番号を作成する"}, {"type": "subtitle", "time": 9080.309, "timestamp": "02:31:20", "text": "新しいチャンネルです。それで、えっと、私は思ったんだけど"}, {"type": "subtitle", "time": 9083.11, "timestamp": "02:31:23", "text": "見ている人たちは"}, {"type": "subtitle", "time": 9085.349, "timestamp": "02:31:25", "text": "YouTubeとか。いいえ、それは"}, {"type": "subtitle", "time": 9088.309, "timestamp": "02:31:28", "text": "小さなチャンネルには方法がありません"}, {"type": "subtitle", "time": 9091.75, "timestamp": "02:31:31", "text": "VOD（ビデオオンデマンド）配信を提供する。だから私は"}, {"type": "subtitle", "time": 9093.67, "timestamp": "02:31:33", "text": "同じことをVODチャンネルでやろう"}, {"type": "subtitle", "time": 9096.23, "timestamp": "02:31:36", "text": "YouTubeでやったこと"}, {"type": "subtitle", "time": 9098.79, "timestamp": "02:31:38", "text": "チャネル。 Twitchの動画を全部アップロードしました"}, {"type": "subtitle", "time": 9102.309, "timestamp": "02:31:42", "text": "そして、そこでYouTubeの配信も行われます。"}, {"type": "subtitle", "time": 9108.55, "timestamp": "02:31:48", "text": "だから、そう、そのためには、えっと"}, {"type": "subtitle", "time": 9111.67, "timestamp": "02:31:51", "text": "うん、私のメインのもう1つのものと私が作ったもの"}, {"type": "subtitle", "time": 9113.83, "timestamp": "02:31:53", "text": "そのアカウントのどのチャンネル"}, {"type": "subtitle", "time": 9116.55, "timestamp": "02:31:56", "text": "実際、私のストリーミングアカウントでは"}, {"type": "subtitle", "time": 9119.429, "timestamp": "02:31:59", "text": "メインのドキュメント、次のドキュメント、えっと、私は自分の"}]
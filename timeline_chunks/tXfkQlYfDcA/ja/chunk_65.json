[{"type": "subtitle", "time": 3900.39, "timestamp": "01:05:00", "text": "そうなります。うん。 4月5月と"}, {"type": "subtitle", "time": 3903.029, "timestamp": "01:05:03", "text": "4月と5月は2ヶ月目になるだろう"}, {"type": "subtitle", "time": 3905.589, "timestamp": "01:05:05", "text": "夏休みですよね？それは、それは、"}, {"type": "subtitle", "time": 3908.87, "timestamp": "01:05:08", "text": "それはどこでも同じですか？"}, {"type": "subtitle", "time": 3910.789, "timestamp": "01:05:10", "text": "春休み期間を終了してください"}, {"type": "subtitle", "time": 3912.48, "timestamp": "01:05:12", "text": "学生たち。おお、"}, {"type": "subtitle", "time": 3915.19, "timestamp": "01:05:15", "text": "[音楽]"}, {"type": "subtitle", "time": 3919.67, "timestamp": "01:05:19", "text": "主観的な経験。経験"}, {"type": "subtitle", "time": 3922.309, "timestamp": "01:05:22", "text": "成人"}, {"type": "subtitle", "time": 3924.069, "timestamp": "01:05:24", "text": "は"}, {"type": "subtitle", "time": 3932.79, "timestamp": "01:05:32", "text": "どちらも性格的な問題であって、個人的な問題ではない。"}, {"type": "subtitle", "time": 3935.109, "timestamp": "01:05:35", "text": "[音楽]"}, {"type": "subtitle", "time": 3937.829, "timestamp": "01:05:37", "text": "なぜあなたはたった2ヶ月しか休暇をもらえないのですか？私 私"}, {"type": "subtitle", "time": 3940.47, "timestamp": "01:05:40", "text": "考える。待って。うん、夏休みは2"}, {"type": "subtitle", "time": 3942.309, "timestamp": "01:05:42", "text": "数ヶ月ですよね？どういう意味ですか？それは"}, {"type": "subtitle", "time": 3947.43, "timestamp": "01:05:47", "text": "すごく大きいとか、それとも"}, {"type": "subtitle", "time": 3949.19, "timestamp": "01:05:49", "text": "3つ以上であるはず"}, {"type": "subtitle", "time": 3951.029, "timestamp": "01:05:51", "text": "4つ？"}, {"type": "subtitle", "time": 3953.91, "timestamp": "01:05:53", "text": "いいえ。そうですね。わからない。まるで"}, {"type": "subtitle", "time": 3955.75, "timestamp": "01:05:55", "text": "のように"}, {"type": "subtitle", "time": 3958.47, "timestamp": "01:05:58", "text": "高校を卒業するような学生"}]
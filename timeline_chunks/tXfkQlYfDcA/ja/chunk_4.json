[{"type": "subtitle", "time": 248.07, "timestamp": "00:04:08", "text": "それをクリックしてください。"}, {"type": "subtitle", "time": 271.03, "timestamp": "00:04:31", "text": "ああ、もう。問題はこれだ"}, {"type": "subtitle", "time": 273.67, "timestamp": "00:04:33", "text": "作物ですよね？"}, {"type": "subtitle", "time": 275.59000000000003, "timestamp": "00:04:35", "text": "未記入。"}, {"type": "subtitle", "time": 277.35, "timestamp": "00:04:37", "text": "ええ、満員でした。はい、わかりました。手に入れた"}, {"type": "subtitle", "time": 282.95, "timestamp": "00:04:42", "text": "こんにちは。ええと、そうしてください。えっと、他に何かありますか？何"}, {"type": "subtitle", "time": 286.55, "timestamp": "00:04:46", "text": "それ以外？家。これはダウンしているはずですよね？"}, {"type": "subtitle", "time": 288.79, "timestamp": "00:04:48", "text": "うん。下。"}, {"type": "subtitle", "time": 292.07, "timestamp": "00:04:52", "text": "こんなスポーツマンは必要ない。"}, {"type": "subtitle", "time": 295.27, "timestamp": "00:04:55", "text": "えっと、番号リング"}, {"type": "subtitle", "time": 297.67, "timestamp": "00:04:57", "text": "そして、植木鉢。部品は必要ありません。"}]
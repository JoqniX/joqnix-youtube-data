[{"type": "subtitle", "time": 5473.11, "timestamp": "01:31:13", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 5474.79, "timestamp": "01:31:14", "text": "さあ、手を洗って、"}, {"type": "subtitle", "time": 5489.11, "timestamp": "01:31:29", "text": "わかった。 3番目の待ち時間は80です。"}, {"type": "subtitle", "time": 5494.229, "timestamp": "01:31:34", "text": "よし、昼食後に自分にご褒美をあげよう。"}, {"type": "subtitle", "time": 5497.43, "timestamp": "01:31:37", "text": "いいえ、昼食中に章を読む"}, {"type": "subtitle", "time": 5501.11, "timestamp": "01:31:41", "text": "第87章以降。うん、"}, {"type": "subtitle", "time": 5512.149, "timestamp": "01:31:52", "text": "12時までにこれを終わらせる必要がある。"}, {"type": "subtitle", "time": 5518.87, "timestamp": "01:31:58", "text": "次にインドの村について書く必要がある"}]
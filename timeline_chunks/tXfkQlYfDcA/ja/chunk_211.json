[{"type": "subtitle", "time": 12661.83, "timestamp": "03:31:01", "text": "ビリーを騙すつもりだ、ビリー管理者が言うには"}, {"type": "subtitle", "time": 12665.51, "timestamp": "03:31:05", "text": "まるで私がプレイしているように見える"}, {"type": "subtitle", "time": 12669.429, "timestamp": "03:31:09", "text": "あれ。それで、フルスクリーンにしてオンにした"}, {"type": "subtitle", "time": 12671.269, "timestamp": "03:31:11", "text": "Twitch、YouTube、その他私が作った場所"}, {"type": "subtitle", "time": 12674.55, "timestamp": "03:31:14", "text": "ビリー・ビリー専用の固定コメント。私"}, {"type": "subtitle", "time": 12677.03, "timestamp": "03:31:17", "text": "英語で書いたばかりです。戻ってきます。"}, {"type": "subtitle", "time": 12680.95, "timestamp": "03:31:20", "text": "何か。管理者がそうしないことを期待していた"}, {"type": "subtitle", "time": 12683.83, "timestamp": "03:31:23", "text": "英語を理解しようとすると、"}, {"type": "subtitle", "time": 12686.389, "timestamp": "03:31:26", "text": "すぐ戻るよ、とか色々。いいえ。だから、ある日は"}, {"type": "subtitle", "time": 12689.83, "timestamp": "03:31:29", "text": "大丈夫だった。ある日は、"}, {"type": "subtitle", "time": 12691.349, "timestamp": "03:31:31", "text": "別のスタッフだと思う。"}, {"type": "subtitle", "time": 12693.51, "timestamp": "03:31:33", "text": "右？だから、彼らはそれが"}, {"type": "subtitle", "time": 12697.75, "timestamp": "03:31:37", "text": "私じゃない。そして私は彼らが見ていることに気づいた"}, {"type": "subtitle", "time": 12700.87, "timestamp": "03:31:40", "text": "チャットでのやり取りも同様です。彼らは"}, {"type": "subtitle", "time": 12703.11, "timestamp": "03:31:43", "text": "別のアカウントを使用して確認します"}, {"type": "subtitle", "time": 12705.83, "timestamp": "03:31:45", "text": "配信者は返信する場合もあれば、しない場合もある。そして"}, {"type": "subtitle", "time": 12708.63, "timestamp": "03:31:48", "text": "彼らは倍増するためにそういうことをする"}, {"type": "subtitle", "time": 12712.389, "timestamp": "03:31:52", "text": "チェック。何？うん。"}, {"type": "subtitle", "time": 12715.51, "timestamp": "03:31:55", "text": "それはおかしい。"}, {"type": "subtitle", "time": 12717.349, "timestamp": "03:31:57", "text": "大変だった。しかし、そこには"}, {"type": "subtitle", "time": 12719.75, "timestamp": "03:31:59", "text": "人々が支払いを好まないケース"}]
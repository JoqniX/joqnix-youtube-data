[{"type": "subtitle", "time": 15060.309, "timestamp": "04:11:00", "text": "他のユーチューバーとかから、ですよね？"}, {"type": "subtitle", "time": 15062.79, "timestamp": "04:11:02", "text": "うん。だから、私もそうしたいと思ったんです"}, {"type": "subtitle", "time": 15065.11, "timestamp": "04:11:05", "text": "何かクールでユニークなことをしたいので、"}, {"type": "subtitle", "time": 15074.63, "timestamp": "04:11:14", "text": "それはすごくクールだね。そして私は気づいた、それは"}, {"type": "subtitle", "time": 15078.309, "timestamp": "04:11:18", "text": "ほぼ2時間。えっと、ああ、"}, {"type": "subtitle", "time": 15083.03, "timestamp": "04:11:23", "text": "何？うん。何てことだ。わかった。うん。時間"}, {"type": "subtitle", "time": 15085.59, "timestamp": "04:11:25", "text": "本当に飛ぶんだね？はい。はい。私たちが"}, {"type": "subtitle", "time": 15087.91, "timestamp": "04:11:27", "text": "話したり、リラックスしたり。うん、食べる必要があるよ"}, {"type": "subtitle", "time": 15091.03, "timestamp": "04:11:31", "text": "そうですね？はい、そうします。私のお腹は"}, {"type": "subtitle", "time": 15092.71, "timestamp": "04:11:32", "text": "ゴロゴロと音がする。"}, {"type": "subtitle", "time": 15094.87, "timestamp": "04:11:34", "text": "それは、自らの存在を明らかにしつつある。その"}, {"type": "subtitle", "time": 15103.11, "timestamp": "04:11:43", "text": "でも、ああ、本当にありがとう"}, {"type": "subtitle", "time": 15105.83, "timestamp": "04:11:45", "text": "私を出演させてくれるなんて。とても楽しいです。それはとても"}, {"type": "subtitle", "time": 15107.429, "timestamp": "04:11:47", "text": "本当にこれ大好き。まるで"}, {"type": "subtitle", "time": 15111.03, "timestamp": "04:11:51", "text": "すごく落ち着いているけど、ちょっとお茶目なところもある"}, {"type": "subtitle", "time": 15112.63, "timestamp": "04:11:52", "text": "君と一緒に過ごすのが好きで、"}, {"type": "subtitle", "time": 15114.469, "timestamp": "04:11:54", "text": "本当に感謝しています。ありがとうございます"}, {"type": "subtitle", "time": 15119.03, "timestamp": "04:11:59", "text": "ジョアソンに招待してくれた。素晴らしいですね。"}]
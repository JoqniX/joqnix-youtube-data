[{"type": "subtitle", "time": 13740.79, "timestamp": "03:49:00", "text": "YouTubeなども検討したいのですが、"}, {"type": "subtitle", "time": 13743.429, "timestamp": "03:49:03", "text": "それから私は、えーと、"}, {"type": "subtitle", "time": 13751.03, "timestamp": "03:49:11", "text": "現代の人々は、"}, {"type": "subtitle", "time": 13753.11, "timestamp": "03:49:13", "text": "他のプラットフォームでコンテンツを公開するなど"}, {"type": "subtitle", "time": 13755.75, "timestamp": "03:49:15", "text": "今はそういう場所がある。それで、"}, {"type": "subtitle", "time": 13759.269, "timestamp": "03:49:19", "text": "マルチストリーミングのトレンドが起こったのでしょうね。"}, {"type": "subtitle", "time": 13762.389, "timestamp": "03:49:22", "text": "わかった。 Twitch では、"}, {"type": "subtitle", "time": 13764.71, "timestamp": "03:49:24", "text": "垂直の流れが"}, {"type": "subtitle", "time": 13766.71, "timestamp": "03:49:26", "text": "もしあなたがただ"}, {"type": "subtitle", "time": 13769.269, "timestamp": "03:49:29", "text": "水平方向にストリーミング配信。"}, {"type": "subtitle", "time": 13771.99, "timestamp": "03:49:31", "text": "うん。本当に、あなたは"}, {"type": "subtitle", "time": 13775.03, "timestamp": "03:49:35", "text": "また、彼らの試みでは"}, {"type": "subtitle", "time": 13777.189, "timestamp": "03:49:37", "text": "ショートパンツみたい、もしくはTwitchみたい"}, {"type": "subtitle", "time": 13780.07, "timestamp": "03:49:40", "text": "発見フィードはフルサイズで"}, {"type": "subtitle", "time": 13782.63, "timestamp": "03:49:42", "text": "縦長のもの。私は「え、何？」って感じでした"}, {"type": "subtitle", "time": 13786.55, "timestamp": "03:49:46", "text": "これはどこから来たのですか？何？"}, {"type": "subtitle", "time": 13788.63, "timestamp": "03:49:48", "text": "うん。しかし、非常に興味深い。それは"}, {"type": "subtitle", "time": 13792.15, "timestamp": "03:49:52", "text": "TikTokからも間違いなくそう思います"}, {"type": "subtitle", "time": 13795.11, "timestamp": "03:49:55", "text": "TikTokは私たちを救ってくれた"}, {"type": "subtitle", "time": 13797.59, "timestamp": "03:49:57", "text": "つま先を掴まれた。だから、ああ"}, {"type": "subtitle", "time": 13799.51, "timestamp": "03:49:59", "text": "うん、それを手に入れようとしないといけない"}]
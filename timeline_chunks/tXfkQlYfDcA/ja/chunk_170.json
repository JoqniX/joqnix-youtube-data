[{"type": "subtitle", "time": 10208.79, "timestamp": "02:50:08", "text": "ロード中。"}, {"type": "subtitle", "time": 10210.79, "timestamp": "02:50:10", "text": "ドラムレールをやっているような感じ"}, {"type": "subtitle", "time": 10213.99, "timestamp": "02:50:13", "text": "私自身が言うには"}, {"type": "subtitle", "time": 10215.83, "timestamp": "02:50:15", "text": "何"}, {"type": "subtitle", "time": 10222.309, "timestamp": "02:50:22", "text": "停止。"}, {"type": "subtitle", "time": 10227.349, "timestamp": "02:50:27", "text": "頑張って。頑張って。頑張って。はい。する"}, {"type": "subtitle", "time": 10230.63, "timestamp": "02:50:30", "text": "それは素晴らしいですね。何てことだ。私はしませんでした"}, {"type": "subtitle", "time": 10234.309, "timestamp": "02:50:34", "text": "もっとあなたのような人がいるかもしれないと思う"}, {"type": "subtitle", "time": 10237.67, "timestamp": "02:50:37", "text": "モデルみたいな感じだけど、ああ、わかるよ"}, {"type": "subtitle", "time": 10239.83, "timestamp": "02:50:39", "text": "あなたがそんなに頑張っている理由がよく分かります。それは"}, {"type": "subtitle", "time": 10243.51, "timestamp": "02:50:43", "text": "文字通りあなたのエネルギー、あなたのそりのように、"}, {"type": "subtitle", "time": 10246.71, "timestamp": "02:50:46", "text": "あなたは素晴らしい。"}, {"type": "subtitle", "time": 10249.429, "timestamp": "02:50:49", "text": "とても綺麗。"}, {"type": "subtitle", "time": 10252.63, "timestamp": "02:50:52", "text": "なんてこった。えーと、もし"}, {"type": "subtitle", "time": 10254.95, "timestamp": "02:50:54", "text": "まるで小さなゴーグルをつけたように私たちを見ている"}, {"type": "subtitle", "time": 10258.79, "timestamp": "02:50:58", "text": "画面、例えば皆さんがこれを見たとき、"}]
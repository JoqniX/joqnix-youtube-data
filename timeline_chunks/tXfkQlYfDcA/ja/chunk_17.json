[{"type": "subtitle", "time": 1023.99, "timestamp": "00:17:03", "text": "え、こうあるべきなの？待って"}, {"type": "subtitle", "time": 1027.35, "timestamp": "00:17:07", "text": "これはゲームソフトですか？知っている"}, {"type": "subtitle", "time": 1028.949, "timestamp": "00:17:08", "text": "何かが起こった。待って、何かした"}, {"type": "subtitle", "time": 1032.549, "timestamp": "00:17:12", "text": "あなたにも起こりましたか？何？"}, {"type": "subtitle", "time": 1042.799, "timestamp": "00:17:22", "text": "何？ ああ、それはデフォルトの壁紙ですね。私は違います"}, {"type": "subtitle", "time": 1044.959, "timestamp": "00:17:24", "text": "ああ、それはデフォルトの壁紙ですね。私は違います 自分の壁紙を貼るから"}, {"type": "subtitle", "time": 1048.88, "timestamp": "00:17:28", "text": "自分の壁紙を貼るから また、"}, {"type": "subtitle", "time": 1051.039, "timestamp": "00:17:31", "text": "また、 なぜなぜなぜそれは待て、"}, {"type": "subtitle", "time": 1060.07, "timestamp": "00:17:40", "text": "待って、待って、待って、待って。営業再開してください。"}, {"type": "subtitle", "time": 1061.83, "timestamp": "00:17:41", "text": "いいえ、自動バックアップは不要です。何"}, {"type": "subtitle", "time": 1063.99, "timestamp": "00:17:43", "text": "設定に何か変化があったのでしょうか？"}, {"type": "subtitle", "time": 1071.35, "timestamp": "00:17:51", "text": "オプション設定？それは白です。私の目"}, {"type": "subtitle", "time": 1077.43, "timestamp": "00:17:57", "text": "来て。"}]
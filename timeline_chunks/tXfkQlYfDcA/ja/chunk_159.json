[{"type": "subtitle", "time": 9541.11, "timestamp": "02:39:01", "text": "そんな感じの少量でいいんです。おお、"}, {"type": "subtitle", "time": 9543.51, "timestamp": "02:39:03", "text": "それはすばらしい。また、まるで"}, {"type": "subtitle", "time": 9546.55, "timestamp": "02:39:06", "text": "すべての人に配慮すること。それは"}, {"type": "subtitle", "time": 9549.83, "timestamp": "02:39:09", "text": "いい感じですね。ええ、だって私は一度も"}, {"type": "subtitle", "time": 9553.75, "timestamp": "02:39:13", "text": "安息日を過ごすか、"}, {"type": "subtitle", "time": 9555.91, "timestamp": "02:39:15", "text": "こんな感じ。私はいつもそうしたいと思っていました、"}, {"type": "subtitle", "time": 9558.23, "timestamp": "02:39:18", "text": "でも、チャリティーのためにやろうと思ったんです"}, {"type": "subtitle", "time": 9559.75, "timestamp": "02:39:19", "text": "主に、"}, {"type": "subtitle", "time": 9562.07, "timestamp": "02:39:22", "text": "あなたが知っている。右。右。それは"}, {"type": "subtitle", "time": 9565.75, "timestamp": "02:39:25", "text": "大義。いや。そして私は「いや、みんな」って言った。"}, {"type": "subtitle", "time": 9567.91, "timestamp": "02:39:27", "text": "私にお金を使うなんて、やりすぎだよ。"}, {"type": "subtitle", "time": 9570.07, "timestamp": "02:39:30", "text": "それは利己的すぎるか、"}, {"type": "subtitle", "time": 9573.19, "timestamp": "02:39:33", "text": "何か。それで私はこう思った、私は欲しい"}, {"type": "subtitle", "time": 9575.51, "timestamp": "02:39:35", "text": "自分の権利のために戦う、自分の道徳"}, {"type": "subtitle", "time": 9577.27, "timestamp": "02:39:37", "text": "権利もその他すべて。そして私は"}, {"type": "subtitle", "time": 9579.67, "timestamp": "02:39:39", "text": "えっと、あの、なんて言うんだっけ"}, {"type": "subtitle", "time": 9582.309, "timestamp": "02:39:42", "text": "それ？頑固に主張してくれれば、私はそれを手に入れたい。"}, {"type": "subtitle", "time": 9585.59, "timestamp": "02:39:45", "text": "これは私のデザインです。私は多くの努力をしました。"}, {"type": "subtitle", "time": 9588.63, "timestamp": "02:39:48", "text": "だから、私は「うん、やるよ」って思ったんだ"}, {"type": "subtitle", "time": 9591.75, "timestamp": "02:39:51", "text": "それ。私は自分の"}, {"type": "subtitle", "time": 9594.389, "timestamp": "02:39:54", "text": "当初はそう考えていた。私たちはまだそれをすることができます、"}, {"type": "subtitle", "time": 9596.71, "timestamp": "02:39:56", "text": "右？デビューとか色々やって、"}, {"type": "subtitle", "time": 9599.429, "timestamp": "02:39:59", "text": "今後もジョアトンも引き続き担当します。"}]
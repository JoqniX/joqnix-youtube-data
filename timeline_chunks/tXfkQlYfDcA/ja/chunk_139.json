[{"type": "subtitle", "time": 8341.429, "timestamp": "02:19:01", "text": "やるべきことは、そして私はいつも努力し続けることができる"}, {"type": "subtitle", "time": 8344.15, "timestamp": "02:19:04", "text": "パートタイムで働き、実際に貯金する、"}, {"type": "subtitle", "time": 8347.429, "timestamp": "02:19:07", "text": "右？だから、大丈夫です。そんなに急ぐ必要はない。それで、"}, {"type": "subtitle", "time": 8349.669, "timestamp": "02:19:09", "text": "私はそうしようと考えていました"}, {"type": "subtitle", "time": 8353.27, "timestamp": "02:19:13", "text": "今はもっと時間がある。だから私はこう思った、"}, {"type": "subtitle", "time": 8359.429, "timestamp": "02:19:19", "text": "「よし、自分の裏地を破ってみよう。」うん。"}, {"type": "subtitle", "time": 8361.589, "timestamp": "02:19:21", "text": "何てことだ。"}, {"type": "subtitle", "time": 8364.309, "timestamp": "02:19:24", "text": "あなたの幸運を祈っています。知っている。知っている。あなた"}, {"type": "subtitle", "time": 8366.07, "timestamp": "02:19:26", "text": "君ならできるよ。あなたは本当に強い人ですね。"}, {"type": "subtitle", "time": 8369.349, "timestamp": "02:19:29", "text": "あなたは本当に強かった。えっと、そして私は"}, {"type": "subtitle", "time": 8370.87, "timestamp": "02:19:30", "text": "ええ、おっしゃる通り、"}, {"type": "subtitle", "time": 8372.79, "timestamp": "02:19:32", "text": "最終目標のようなもの。また、それは"}, {"type": "subtitle", "time": 8374.95, "timestamp": "02:19:34", "text": "まるで今まで話したことがない人のように話す"}, {"type": "subtitle", "time": 8376.87, "timestamp": "02:19:36", "text": "しばらく連絡を取っていなかった。だって私は"}, {"type": "subtitle", "time": 8378.87, "timestamp": "02:19:38", "text": "初めて来た時のことを覚えてる？"}, {"type": "subtitle", "time": 8380.87, "timestamp": "02:19:40", "text": "Vチューブシーンでは、あなたは"}, {"type": "subtitle", "time": 8383.349, "timestamp": "02:19:43", "text": "最初に話した人たちと"}, {"type": "subtitle", "time": 8385.03, "timestamp": "02:19:45", "text": "分かるように理解する"}, {"type": "subtitle", "time": 8388.63, "timestamp": "02:19:48", "text": "何が起こってるの？えっと、何？"}, {"type": "subtitle", "time": 8390.309, "timestamp": "02:19:50", "text": "本当に？"}, {"type": "subtitle", "time": 8395.19, "timestamp": "02:19:55", "text": "うん。最初は"}, {"type": "subtitle", "time": 8397.75, "timestamp": "02:19:57", "text": "あなたがそのグループを作ったとき"}]
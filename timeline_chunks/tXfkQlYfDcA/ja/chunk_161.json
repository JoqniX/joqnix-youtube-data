[{"type": "subtitle", "time": 9661.19, "timestamp": "02:41:01", "text": "久しぶりですね。うん。うん。ええと、それは"}, {"type": "subtitle", "time": 9665.51, "timestamp": "02:41:05", "text": "確かに、私が家にいたとき、co のような感じでした。"}, {"type": "subtitle", "time": 9669.11, "timestamp": "02:41:09", "text": "大学から、だって、もちろん"}, {"type": "subtitle", "time": 9672.309, "timestamp": "02:41:12", "text": "授業は全く行われていなかった。えっと、でも"}, {"type": "subtitle", "time": 9674.71, "timestamp": "02:41:14", "text": "オンライン授業がまだあった頃"}, {"type": "subtitle", "time": 9677.03, "timestamp": "02:41:17", "text": "そして、自分に無理やり"}, {"type": "subtitle", "time": 9680.15, "timestamp": "02:41:20", "text": "私の仕事はストリーミングでやっていたから"}, {"type": "subtitle", "time": 9682.389, "timestamp": "02:41:22", "text": "一人でいるときは"}, {"type": "subtitle", "time": 9684.469, "timestamp": "02:41:24", "text": "仕事が全く手につかない。"}, {"type": "subtitle", "time": 9686.23, "timestamp": "02:41:26", "text": "でも、もし私が"}, {"type": "subtitle", "time": 9688.309, "timestamp": "02:41:28", "text": "ぶらぶらしているとか、そんな感じ"}, {"type": "subtitle", "time": 9690.309, "timestamp": "02:41:30", "text": "自分の責任でやり遂げる"}, {"type": "subtitle", "time": 9692.55, "timestamp": "02:41:32", "text": "仕事。そうやって私は始めたんです"}, {"type": "subtitle", "time": 9694.389, "timestamp": "02:41:34", "text": "ストリーミング、"}, {"type": "subtitle", "time": 9697.51, "timestamp": "02:41:37", "text": "右？まるで、ああ"}, {"type": "subtitle", "time": 9699.59, "timestamp": "02:41:39", "text": "よし、これを終わらせなければ"}, {"type": "subtitle", "time": 9703.03, "timestamp": "02:41:43", "text": "恥ずべきことである。はい。はい。はい。はい。私 私"}, {"type": "subtitle", "time": 9706.23, "timestamp": "02:41:46", "text": "勉強とかそういうのにもそれを使った"}, {"type": "subtitle", "time": 9708.87, "timestamp": "02:41:48", "text": "あるいは、もし私がやらなければならない仕事があったとしたら、"}, {"type": "subtitle", "time": 9710.469, "timestamp": "02:41:50", "text": "「うん、やるよ」"}, {"type": "subtitle", "time": 9713.349, "timestamp": "02:41:53", "text": "ストリーム配信すれば、より集中できるし、"}, {"type": "subtitle", "time": 9715.51, "timestamp": "02:41:55", "text": "そうしないと先延ばしにしてしまうので、"}, {"type": "subtitle", "time": 9717.75, "timestamp": "02:41:57", "text": "時間の無駄だ。ああ、なんてことだ。"}]
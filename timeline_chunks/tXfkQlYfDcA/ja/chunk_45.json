[{"type": "subtitle", "time": 2700.309, "timestamp": "00:45:00", "text": "そしてそうではない"}, {"type": "subtitle", "time": 2702.55, "timestamp": "00:45:02", "text": "アメリカ。"}, {"type": "subtitle", "time": 2707.43, "timestamp": "00:45:07", "text": "でも、ああ、2つ目のクラス。"}, {"type": "subtitle", "time": 2710.87, "timestamp": "00:45:10", "text": "それら全てを定義しなければならない。幾つか？"}, {"type": "subtitle", "time": 2714.069, "timestamp": "00:45:14", "text": "待って。ラ。"}, {"type": "subtitle", "time": 2718.47, "timestamp": "00:45:18", "text": "わかった。待って。最後の 2 3 4 5 6 7 の"}, {"type": "subtitle", "time": 2721.51, "timestamp": "00:45:21", "text": "ああ、なんてことだ、"}, {"type": "subtitle", "time": 2738.79, "timestamp": "00:45:38", "text": "意味のあるアイデンティティが見過ごされる"}, {"type": "subtitle", "time": 2750.15, "timestamp": "00:45:50", "text": "意味"}, {"type": "subtitle", "time": 2755.47, "timestamp": "00:45:55", "text": "柔らかい"}, {"type": "subtitle", "time": 2757.349, "timestamp": "00:45:57", "text": "[音楽]"}, {"type": "subtitle", "time": 2758.4, "timestamp": "00:45:58", "text": "戦利品"}]
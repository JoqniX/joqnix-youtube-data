[{"type": "subtitle", "time": 7860.229, "timestamp": "02:11:00", "text": "アーク"}, {"type": "subtitle", "time": 7863.51, "timestamp": "02:11:03", "text": "ずっと昔のこと。"}, {"type": "subtitle", "time": 7866.31, "timestamp": "02:11:06", "text": "ああ、これについて知ったよ。私は"}, {"type": "subtitle", "time": 7869.109, "timestamp": "02:11:09", "text": "文字通りたくさんのものを見ている"}, {"type": "subtitle", "time": 7871.99, "timestamp": "02:11:11", "text": "それに関する動画。"}, {"type": "subtitle", "time": 7874.55, "timestamp": "02:11:14", "text": "それら全て"}, {"type": "subtitle", "time": 7881.75, "timestamp": "02:11:21", "text": "[音楽]"}, {"type": "subtitle", "time": 7884.709, "timestamp": "02:11:24", "text": "それらすべて"}, {"type": "subtitle", "time": 7896.229, "timestamp": "02:11:36", "text": "ビデオを作っている人の名前"}, {"type": "subtitle", "time": 7898.55, "timestamp": "02:11:38", "text": "お金を稼ぐ方法について"}, {"type": "subtitle", "time": 7901.91, "timestamp": "02:11:41", "text": "彼がガレージにいるとき。"}, {"type": "subtitle", "time": 7903.83, "timestamp": "02:11:43", "text": "彼の名前は何でしたっけ？誰が誰に似ているか"}, {"type": "subtitle", "time": 7905.91, "timestamp": "02:11:45", "text": "眼鏡とかかけてる？誰が持っているのか"}, {"type": "subtitle", "time": 7909.75, "timestamp": "02:11:49", "text": "メガネとかそういうの？彼の名前を忘れてしまった。それ"}, {"type": "subtitle", "time": 7911.42, "timestamp": "02:11:51", "text": "男。"}, {"type": "subtitle", "time": 7914.47, "timestamp": "02:11:54", "text": "[音楽]"}, {"type": "subtitle", "time": 7918.39, "timestamp": "02:11:58", "text": "彼らのビデオとかをよく見てたよ"}]
[{"type": "subtitle", "time": 7981.589, "timestamp": "02:13:01", "text": "このスペースとか、その他諸々。それら全て"}, {"type": "subtitle", "time": 7984.069, "timestamp": "02:13:04", "text": "起業家精神。"}, {"type": "subtitle", "time": 7987.66, "timestamp": "02:13:07", "text": "私のコースを購入するためのもの。"}, {"type": "subtitle", "time": 7990.069, "timestamp": "02:13:10", "text": "[音楽]"}, {"type": "subtitle", "time": 8008.79, "timestamp": "02:13:28", "text": "こんにちは、みんな。ジョアソンへようこそ"}, {"type": "subtitle", "time": 8012.31, "timestamp": "02:13:32", "text": "92日目パート2の配信。それでは始めましょう"}, {"type": "subtitle", "time": 8015.03, "timestamp": "02:13:35", "text": "夜の小川から。だから私たちは"}, {"type": "subtitle", "time": 8017.83, "timestamp": "02:13:37", "text": "ゲストダラン。"}, {"type": "subtitle", "time": 8019.75, "timestamp": "02:13:39", "text": "こんにちは。"}, {"type": "subtitle", "time": 8028.39, "timestamp": "02:13:48", "text": "興奮した。また、92日目おめでとうございます。"}, {"type": "subtitle", "time": 8032.79, "timestamp": "02:13:52", "text": "あなたのジョギングマラソンの。それは正気の沙汰ではない。"}, {"type": "subtitle", "time": 8037.27, "timestamp": "02:13:57", "text": "ありがとう。おお。これまでのところ、どうでしたか？それ"}]
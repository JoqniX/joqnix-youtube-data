[{"type": "subtitle", "time": 6305.27, "timestamp": "01:45:05", "text": "そういうものなんです。プレイするとき"}, {"type": "subtitle", "time": 6308.229, "timestamp": "01:45:08", "text": "音が鳴ると、絵文字が表示されます。"}, {"type": "subtitle", "time": 6310.79, "timestamp": "01:45:10", "text": "アイコンが表示されます。つまり、"}, {"type": "subtitle", "time": 6313.189, "timestamp": "01:45:13", "text": "音を追加すると、画像も追加できます。"}, {"type": "subtitle", "time": 6315.59, "timestamp": "01:45:15", "text": "良い。そのため、その画像はポップアップ表示されます"}, {"type": "subtitle", "time": 6318.95, "timestamp": "01:45:18", "text": "あなたの声のやつ。面白い。それは"}, {"type": "subtitle", "time": 6321.669, "timestamp": "01:45:21", "text": "いいね。これはサウンドアイコンです。あなたはするであろう"}, {"type": "subtitle", "time": 6323.51, "timestamp": "01:45:23", "text": "見る"}, {"type": "subtitle", "time": 6325.83, "timestamp": "01:45:25", "text": "VCにいるあなた"}, {"type": "subtitle", "time": 6333.189, "timestamp": "01:45:33", "text": "いいえ、これは、これは、"}, {"type": "subtitle", "time": 6340.229, "timestamp": "01:45:40", "text": "これはニトロ用ではないと思う。"}, {"type": "subtitle", "time": 6342.229, "timestamp": "01:45:42", "text": "これは、"}, {"type": "subtitle", "time": 6345.109, "timestamp": "01:45:45", "text": "活動。"}, {"type": "subtitle", "time": 6346.95, "timestamp": "01:45:46", "text": "彼らはそれをプレミアムにするだろう"}, {"type": "subtitle", "time": 6351.03, "timestamp": "01:45:51", "text": "合計すると、そうですね、彼らはそれを"}, {"type": "subtitle", "time": 6353.91, "timestamp": "01:45:53", "text": "彼らはそれを作る"}, {"type": "subtitle", "time": 6356.629, "timestamp": "01:45:56", "text": "ステッカーや絵文字みたいな感じ"}, {"type": "subtitle", "time": 6359.43, "timestamp": "01:45:59", "text": "サーバー用の絵文字。プレバージョン"}]
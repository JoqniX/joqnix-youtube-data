[{"type": "subtitle", "time": 1560.07, "timestamp": "00:26:00", "text": "昨日から始まっている"}, {"type": "subtitle", "time": 1561.59, "timestamp": "00:26:01", "text": "私には少しスペースがあります"}, {"type": "subtitle", "time": 1563.83, "timestamp": "00:26:03", "text": "このページを読み終えてください。それでは、"}, {"type": "subtitle", "time": 1565.99, "timestamp": "00:26:05", "text": "被験者２。"}, {"type": "subtitle", "time": 1568.63, "timestamp": "00:26:08", "text": "4つ目の質問を終えましょう。"}, {"type": "subtitle", "time": 1571.75, "timestamp": "00:26:11", "text": "そして、最初のテーマに戻ります。"}, {"type": "subtitle", "time": 1573.669, "timestamp": "00:26:13", "text": "4つ目の質問。まさにそのようにして私たちは"}, {"type": "subtitle", "time": 1577.59, "timestamp": "00:26:17", "text": "今日までに7問を解き終えた。それ"}, {"type": "subtitle", "time": 1580.07, "timestamp": "00:26:20", "text": "つまり、また12時間になります"}, {"type": "subtitle", "time": 1582.39, "timestamp": "00:26:22", "text": "ストリーム。ジョー、助けてください。どうしたの"}, {"type": "subtitle", "time": 1586.549, "timestamp": "00:26:26", "text": "何が起こったのですか？"}, {"type": "subtitle", "time": 1589.35, "timestamp": "00:26:29", "text": "講演を始めるにはどうすればいいですか？会話の始め方"}, {"type": "subtitle", "time": 1591.35, "timestamp": "00:26:31", "text": "では、どうすれば友達を作れるのでしょうか？あなたは私が"}, {"type": "subtitle", "time": 1594.549, "timestamp": "00:26:34", "text": "知ってる？"}, {"type": "subtitle", "time": 1603.83, "timestamp": "00:26:43", "text": "つまり、それは難しいだろうということです。"}, {"type": "subtitle", "time": 1607.75, "timestamp": "00:26:47", "text": "大変だろうけど、それでも、"}, {"type": "subtitle", "time": 1610.549, "timestamp": "00:26:50", "text": "最初は大変だろうけど、"}, {"type": "subtitle", "time": 1612.23, "timestamp": "00:26:52", "text": "何かを見つける必要があるような"}, {"type": "subtitle", "time": 1615.19, "timestamp": "00:26:55", "text": "よく話題に上る。テキサスはありますか"}, {"type": "subtitle", "time": 1619.19, "timestamp": "00:26:59", "text": "チャットとTwitchの音声オプションはありますか？えっと、"}]
[{"type": "subtitle", "time": 8040.31, "timestamp": "02:14:00", "text": "それは何かだったのだろうか。ちょっと待って"}, {"type": "subtitle", "time": 8043.669, "timestamp": "02:14:03", "text": "上。えっと、なぜあなたのリアクティブではないのですか"}, {"type": "subtitle", "time": 8046.069, "timestamp": "02:14:06", "text": "読み込みに1秒かかりますか？デバッグさせてください"}, {"type": "subtitle", "time": 8049.669, "timestamp": "02:14:09", "text": "それ。なんてこった。うん。うん。うん。"}, {"type": "subtitle", "time": 8051.189, "timestamp": "02:14:11", "text": "いつ"}, {"type": "subtitle", "time": 8054.31, "timestamp": "02:14:14", "text": "疲れた、それは何か"}, {"type": "subtitle", "time": 8058.47, "timestamp": "02:14:18", "text": "完全に生き延びたと思う"}, {"type": "subtitle", "time": 8061.27, "timestamp": "02:14:21", "text": "全くその通りです。あなたはまるで、あなたはまるで"}, {"type": "subtitle", "time": 8064.069, "timestamp": "02:14:24", "text": "今、かなり強く攻めている。私はしなければならない"}, {"type": "subtitle", "time": 8070.149, "timestamp": "02:14:30", "text": "あなたは本当に楽しみにしていた"}, {"type": "subtitle", "time": 8072.39, "timestamp": "02:14:32", "text": "はい、2週間くらいで終わります"}, {"type": "subtitle", "time": 8075.51, "timestamp": "02:14:35", "text": "自由になったのに、ああ、気にしないでって感じ。"}, {"type": "subtitle", "time": 8078.47, "timestamp": "02:14:38", "text": "ええ、まさにその通りです。何てことだ。私"}, {"type": "subtitle", "time": 8080.31, "timestamp": "02:14:40", "text": "ゆっくり休んでいけることを願っています"}, {"type": "subtitle", "time": 8084.149, "timestamp": "02:14:44", "text": "少し休む。かなりの量だ。うん、そうだね"}, {"type": "subtitle", "time": 8088.069, "timestamp": "02:14:48", "text": "多いですね。うん。"}, {"type": "subtitle", "time": 8093.35, "timestamp": "02:14:53", "text": "うん。ああ、もう。でも、ワクワクするね。"}, {"type": "subtitle", "time": 8096.47, "timestamp": "02:14:56", "text": "ああ、私もこうだったらいいのに、"}, {"type": "subtitle", "time": 8099.109, "timestamp": "02:14:59", "text": "ストリーミングのように回復力がある"}]
[{"type": "subtitle", "time": 8942.07, "timestamp": "02:29:02", "text": "ジョアソンのおかげで私は確保することができました"}, {"type": "subtitle", "time": 8944.95, "timestamp": "02:29:04", "text": "ビリー・ビリーみたいに、中国人みたい"}, {"type": "subtitle", "time": 8947.99, "timestamp": "02:29:07", "text": "YouTuberとのコラボで、最初は"}, {"type": "subtitle", "time": 8950.07, "timestamp": "02:29:10", "text": "ビリー・ビリーにストリーミングして、"}, {"type": "subtitle", "time": 8952.95, "timestamp": "02:29:12", "text": "彼らともコラボレーションして、私も学びたい"}, {"type": "subtitle", "time": 8955.59, "timestamp": "02:29:15", "text": "プラットフォームについてもっとよく理解し、物事がどのように進むか"}, {"type": "subtitle", "time": 8958.309, "timestamp": "02:29:18", "text": "すべてですが、私は失いました"}, {"type": "subtitle", "time": 8961.349, "timestamp": "02:29:21", "text": "ビリー・ビリー側がチャンスを"}, {"type": "subtitle", "time": 8963.349, "timestamp": "02:29:23", "text": "ストリームは消えたけど大丈夫、"}, {"type": "subtitle", "time": 8965.51, "timestamp": "02:29:25", "text": "来週も引き続きコラボレーションしますので"}, {"type": "subtitle", "time": 8968.389, "timestamp": "02:29:28", "text": "うん、それはワクワクするね"}, {"type": "subtitle", "time": 8971.11, "timestamp": "02:29:31", "text": "待って、それってメールを使うのと違うの？"}, {"type": "subtitle", "time": 8973.75, "timestamp": "02:29:33", "text": "ビリー・ビリーにアクセスするには？私は持っている"}, {"type": "subtitle", "time": 8976.79, "timestamp": "02:29:36", "text": "全く見当もつかない。ああ、まるで、"}, {"type": "subtitle", "time": 8978.79, "timestamp": "02:29:38", "text": "電話番号で登録する必要がありますが"}, {"type": "subtitle", "time": 8980.95, "timestamp": "02:29:40", "text": "インドは中国製品と同様に禁止した"}, {"type": "subtitle", "time": 8984.389, "timestamp": "02:29:44", "text": "アプリですよね？それで、でもビリービリーは"}, {"type": "subtitle", "time": 8988.309, "timestamp": "02:29:48", "text": "アクセスは可能ですが、QQなどの他のアプリでは、"}, {"type": "subtitle", "time": 8990.87, "timestamp": "02:29:50", "text": "VChatとかそういうのは、"}, {"type": "subtitle", "time": 8994.79, "timestamp": "02:29:54", "text": "アクセス可能。それで、えーと、ビリービリー、"}, {"type": "subtitle", "time": 8996.95, "timestamp": "02:29:56", "text": "自分の番号とかを使うことができた"}, {"type": "subtitle", "time": 8998.63, "timestamp": "02:29:58", "text": "そんな感じ。ストリーミングするには、"}]
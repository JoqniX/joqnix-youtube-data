[{"type": "subtitle", "time": 13623.349, "timestamp": "03:47:03", "text": "私たちが覚えていないことですが、それは"}, {"type": "subtitle", "time": 13625.83, "timestamp": "03:47:05", "text": "それでも私は、"}, {"type": "subtitle", "time": 13628.55, "timestamp": "03:47:08", "text": "近づいてきて、ああ、気にしないで。その"}, {"type": "subtitle", "time": 13630.79, "timestamp": "03:47:10", "text": "長居しない、あるいは"}, {"type": "subtitle", "time": 13632.95, "timestamp": "03:47:12", "text": "開発者は通常、一人チームのようなものだ"}, {"type": "subtitle", "time": 13635.99, "timestamp": "03:47:15", "text": "そういう類のもの。ああ、どうやって"}, {"type": "subtitle", "time": 13639.189, "timestamp": "03:47:19", "text": "彼らに何でもやってくれるとでも思っているの？"}, {"type": "subtitle", "time": 13641.349, "timestamp": "03:47:21", "text": "うん。"}, {"type": "subtitle", "time": 13645.91, "timestamp": "03:47:25", "text": "たくさんの物。そして最近"}, {"type": "subtitle", "time": 13648.469, "timestamp": "03:47:28", "text": "ノイズとかいうプラットフォーム"}, {"type": "subtitle", "time": 13651.75, "timestamp": "03:47:31", "text": "解散し、活動を停止した。ええ、私です"}, {"type": "subtitle", "time": 13654.469, "timestamp": "03:47:34", "text": "本当に全く見当もつかない。"}, {"type": "subtitle", "time": 13657.03, "timestamp": "03:47:37", "text": "多くのプラットフォームが停止している"}, {"type": "subtitle", "time": 13660.63, "timestamp": "03:47:40", "text": "しばらく経ってから。だから私はこれが"}, {"type": "subtitle", "time": 13663.189, "timestamp": "03:47:43", "text": "止まらない。それはとても有益です"}, {"type": "subtitle", "time": 13665.11, "timestamp": "03:47:45", "text": "マルチストリーミングを希望する人々"}, {"type": "subtitle", "time": 13669.03, "timestamp": "03:47:49", "text": "マルチストリーム。右。右。うん。"}, {"type": "subtitle", "time": 13670.95, "timestamp": "03:47:50", "text": "まあ、もしあなたが彼らにそう言い続けるなら"}, {"type": "subtitle", "time": 13672.87, "timestamp": "03:47:52", "text": "みんな"}, {"type": "subtitle", "time": 13676.309, "timestamp": "03:47:56", "text": "まだ私たちのもとを離れないでください。うん、"}, {"type": "subtitle", "time": 13678.63, "timestamp": "03:47:58", "text": "それには多くの支持もある。私は来た"}]
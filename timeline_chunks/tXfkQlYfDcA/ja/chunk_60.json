[{"type": "subtitle", "time": 3601.75, "timestamp": "01:00:01", "text": "前へ進み、春と夏がやってくる"}, {"type": "subtitle", "time": 3604.23, "timestamp": "01:00:04", "text": "戻る。わあ、それは知らなかった。それはとても"}, {"type": "subtitle", "time": 3606.95, "timestamp": "01:00:06", "text": "いいね。"}, {"type": "subtitle", "time": 3612.61, "timestamp": "01:00:12", "text": "それはすごくクールだね。"}, {"type": "subtitle", "time": 3620.63, "timestamp": "01:00:20", "text": "こんにちは、友よ。今日の調子はどうですか？"}, {"type": "subtitle", "time": 3632.34, "timestamp": "01:00:32", "text": "お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 3635.27, "timestamp": "01:00:35", "text": "[音楽]"}, {"type": "subtitle", "time": 3643.19, "timestamp": "01:00:43", "text": "年齢は"}, {"type": "subtitle", "time": 3648.63, "timestamp": "01:00:48", "text": "定義できる"}, {"type": "subtitle", "time": 3653.349, "timestamp": "01:00:53", "text": "実年齢も問題ありません。"}]
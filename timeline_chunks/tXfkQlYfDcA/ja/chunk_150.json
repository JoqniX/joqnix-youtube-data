[{"type": "subtitle", "time": 9002.71, "timestamp": "02:30:02", "text": "他のカードなども渡してください。"}, {"type": "subtitle", "time": 9006.71, "timestamp": "02:30:06", "text": "わあ、すごい。しかし、しかし、私は間違いを犯しました。えっと、"}, {"type": "subtitle", "time": 9009.59, "timestamp": "02:30:09", "text": "ああ、いやだ。私は日本に行きます。私"}, {"type": "subtitle", "time": 9012.15, "timestamp": "02:30:12", "text": "知らなかった。私はこれを知らなかった。私はそうしました"}, {"type": "subtitle", "time": 9016.15, "timestamp": "02:30:16", "text": "それは約2年前から続いていました。だから私は"}, {"type": "subtitle", "time": 9017.99, "timestamp": "02:30:17", "text": "私のもう一台の車。今、私は"}, {"type": "subtitle", "time": 9020.309, "timestamp": "02:30:20", "text": "私のパスポートは実際には"}, {"type": "subtitle", "time": 9023.51, "timestamp": "02:30:23", "text": "日本とかそういうやつ。えっと、もし私がそこに住んでいて"}, {"type": "subtitle", "time": 9025.51, "timestamp": "02:30:25", "text": "物、私の他のカードや物は"}, {"type": "subtitle", "time": 9027.83, "timestamp": "02:30:27", "text": "もうなくなったんですよね？"}, {"type": "subtitle", "time": 9030.309, "timestamp": "02:30:30", "text": "そうそう。"}, {"type": "subtitle", "time": 9032.389, "timestamp": "02:30:32", "text": "そして、私は2つのチャンネルを持っています。カードは"}, {"type": "subtitle", "time": 9034.55, "timestamp": "02:30:34", "text": "スイッチが好きなら、"}, {"type": "subtitle", "time": 9037.59, "timestamp": "02:30:37", "text": "市民権のことですよね？そうなんですか？私は違います"}, {"type": "subtitle", "time": 9040.55, "timestamp": "02:30:40", "text": "もちろん。そう思うのは、まだ"}, {"type": "subtitle", "time": 9042.63, "timestamp": "02:30:42", "text": "もう一枚カードを持っているけど、私は"}, {"type": "subtitle", "time": 9045.03, "timestamp": "02:30:45", "text": "明らかにここを拠点としている。えっと、私は"}, {"type": "subtitle", "time": 9046.23, "timestamp": "02:30:46", "text": "それは問題だと思う。私はしません"}, {"type": "subtitle", "time": 9047.83, "timestamp": "02:30:47", "text": "それを処分した方がいいと思う。"}, {"type": "subtitle", "time": 9050.95, "timestamp": "02:30:50", "text": "んーん。それは、あなたが服用しているときだけです"}, {"type": "subtitle", "time": 9053.349, "timestamp": "02:30:53", "text": "えっと、そこの市民権と、あなたのように"}, {"type": "subtitle", "time": 9055.51, "timestamp": "02:30:55", "text": "インド人のようなあなたのものを削除していることを知っています"}, {"type": "subtitle", "time": 9058.07, "timestamp": "02:30:58", "text": "市民権と全く同じようなものです。それは"}]
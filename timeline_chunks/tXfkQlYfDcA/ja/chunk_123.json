[{"type": "subtitle", "time": 7386.629, "timestamp": "02:03:06", "text": "これは効果がありますか？わからない。私は"}, {"type": "subtitle", "time": 7395.75, "timestamp": "02:03:15", "text": "そうなんですか？カメラが追跡機能を使っていません。それは"}, {"type": "subtitle", "time": 7397.91, "timestamp": "02:03:17", "text": "大丈夫。"}, {"type": "subtitle", "time": 7400.55, "timestamp": "02:03:20", "text": "私は死にかけている。"}, {"type": "subtitle", "time": 7409.75, "timestamp": "02:03:29", "text": "[音楽]"}, {"type": "subtitle", "time": 7412.629, "timestamp": "02:03:32", "text": "ええ、ちょっとだけやります"}, {"type": "subtitle", "time": 7422.229, "timestamp": "02:03:42", "text": "[音楽]"}, {"type": "subtitle", "time": 7424.87, "timestamp": "02:03:44", "text": "私が何をしようとも。"}, {"type": "subtitle", "time": 7428.2, "timestamp": "02:03:48", "text": "これにはどうやって書き込むのですか？何てことだ。"}, {"type": "subtitle", "time": 7430.629, "timestamp": "02:03:50", "text": "[音楽]"}, {"type": "subtitle", "time": 7438.229, "timestamp": "02:03:58", "text": "はい、高さを調整します"}]
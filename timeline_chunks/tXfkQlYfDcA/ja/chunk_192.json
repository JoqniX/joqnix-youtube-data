[{"type": "subtitle", "time": 11520.37, "timestamp": "03:12:00", "text": "確かに、確かに、確かに。うん。"}, {"type": "subtitle", "time": 11522.469, "timestamp": "03:12:02", "text": "[音楽]"}, {"type": "subtitle", "time": 11524.23, "timestamp": "03:12:04", "text": "だから、あなたがそうしたいかどうかはあなた次第です"}, {"type": "subtitle", "time": 11526.389, "timestamp": "03:12:06", "text": "ゲームを今すぐやる、それともただ"}, {"type": "subtitle", "time": 11528.63, "timestamp": "03:12:08", "text": "話し続けたいですか？何ですか、何ですか"}, {"type": "subtitle", "time": 11531.51, "timestamp": "03:12:11", "text": "何をしたいですか？何でもやります。"}, {"type": "subtitle", "time": 11533.83, "timestamp": "03:12:13", "text": "正直言って、この雰囲気すごく気に入ってる。"}, {"type": "subtitle", "time": 11536.07, "timestamp": "03:12:16", "text": "ただ話し合うだけ、みたいな感じ。例えば私たちが"}, {"type": "subtitle", "time": 11538.63, "timestamp": "03:12:18", "text": "ゲームが好きになりたい。えっと、でも私も"}, {"type": "subtitle", "time": 11541.11, "timestamp": "03:12:21", "text": "どれくらい時間があるか分からない。おお、"}, {"type": "subtitle", "time": 11543.59, "timestamp": "03:12:23", "text": "大丈夫です。あなたは最後の、最後のゲストです"}, {"type": "subtitle", "time": 11546.63, "timestamp": "03:12:26", "text": "今夜はそこで寝て、それから出発します。"}, {"type": "subtitle", "time": 11549.59, "timestamp": "03:12:29", "text": "わかった。わかった。でも、食べに行かなきゃ"}, {"type": "subtitle", "time": 11552.07, "timestamp": "03:12:32", "text": "夕食だけど、それがそこにあることは分かってるよね。"}, {"type": "subtitle", "time": 11554.15, "timestamp": "03:12:34", "text": "うん。私もあまり長く滞在できないでしょう"}, {"type": "subtitle", "time": 11556.469, "timestamp": "03:12:36", "text": "どちらも長くはない。えっと、仕事もあるし"}, {"type": "subtitle", "time": 11559.19, "timestamp": "03:12:39", "text": "する。私は完全な夜型人間です。これは"}, {"type": "subtitle", "time": 11561.91, "timestamp": "03:12:41", "text": "技術的には私の仕事の一日の始まり"}, {"type": "subtitle", "time": 11563.99, "timestamp": "03:12:43", "text": "今すぐ。だから、まずは"}, {"type": "subtitle", "time": 11566.309, "timestamp": "03:12:46", "text": "ジョックとコラボするのは最高だ。地獄"}, {"type": "subtitle", "time": 11568.309, "timestamp": "03:12:48", "text": "うん。"}, {"type": "subtitle", "time": 11573.429, "timestamp": "03:12:53", "text": "[音楽]"}, {"type": "subtitle", "time": 11575.269, "timestamp": "03:12:55", "text": "うん。私たちはいつでもゲームをすることができます"}, {"type": "subtitle", "time": 11577.83, "timestamp": "03:12:57", "text": "後で一緒に。私はここに11ヶ月滞在します。"}]
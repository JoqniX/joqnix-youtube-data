[{"type": "subtitle", "time": 4084.49, "timestamp": "01:08:04", "text": "重要な日付とか、そういうこと全部。"}, {"type": "subtitle", "time": 4104.95, "timestamp": "01:08:24", "text": "もう10時だ。ああ、もっとスピードを上げて。する必要がある"}, {"type": "subtitle", "time": 4112.229, "timestamp": "01:08:32", "text": "えーと、とにかく、お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 4114.309, "timestamp": "01:08:34", "text": "私は今から仕事に行くつもりはありません。こんにちは、"}, {"type": "subtitle", "time": 4118.39, "timestamp": "01:08:38", "text": "ガム。頑張ってください、そしてお休みください。"}, {"type": "subtitle", "time": 4121.03, "timestamp": "01:08:41", "text": "だって、2週間寝ることになるんだから"}, {"type": "subtitle", "time": 4123.11, "timestamp": "01:08:43", "text": "時間。"}, {"type": "subtitle", "time": 4126.87, "timestamp": "01:08:46", "text": "そうそう。良い夜をお過ごしください。感謝"}]
[{"type": "subtitle", "time": 12240.71, "timestamp": "03:24:00", "text": "ゲームの衰退と"}, {"type": "subtitle", "time": 12245.269, "timestamp": "03:24:05", "text": "枯れゆく波のカテゴリーを手に入れました"}, {"type": "subtitle", "time": 12248.309, "timestamp": "03:24:08", "text": "ああ、それも理由で削除されたんだ"}, {"type": "subtitle", "time": 12250.07, "timestamp": "03:24:10", "text": "友達がYouTubeで配信してたよ"}, {"type": "subtitle", "time": 12251.83, "timestamp": "03:24:11", "text": "彼らはYouTubeやTwitchなどを嫌っている"}, {"type": "subtitle", "time": 12253.67, "timestamp": "03:24:13", "text": "プラットフォーム 外国のプラットフォーム 表示できません"}, {"type": "subtitle", "time": 12258.15, "timestamp": "03:24:18", "text": "ロゴやウェブサイトをそのまま、あるいは"}, {"type": "subtitle", "time": 12261.51, "timestamp": "03:24:21", "text": "チャットでYouTubeと入力すると禁止されます"}, {"type": "subtitle", "time": 12263.269, "timestamp": "03:24:23", "text": "あるいは、そのコメントは"}, {"type": "subtitle", "time": 12269.11, "timestamp": "03:24:29", "text": "プラットフォームによってフラグが立てられました。それはおかしい。"}, {"type": "subtitle", "time": 12273.03, "timestamp": "03:24:33", "text": "本当に信じられないことだ。何？恋しい"}, {"type": "subtitle", "time": 12275.75, "timestamp": "03:24:35", "text": "今でもそこで配信されている。つまり、"}, {"type": "subtitle", "time": 12278.389, "timestamp": "03:24:38", "text": "そこで少しずつフォロワーが増え始めた"}, {"type": "subtitle", "time": 12282.07, "timestamp": "03:24:42", "text": "なぜなら、そのプラットフォームは、ビューのようなものだから"}, {"type": "subtitle", "time": 12285.349, "timestamp": "03:24:45", "text": "あなたと同じように、私もそう思う。"}, {"type": "subtitle", "time": 12288.389, "timestamp": "03:24:48", "text": "彼らにはレベルアップシステムがあります"}, {"type": "subtitle", "time": 12290.79, "timestamp": "03:24:50", "text": "もの。うんうん。初期水準測量システム"}, {"type": "subtitle", "time": 12293.51, "timestamp": "03:24:53", "text": "婚約とかそういう類のことだった。より"}, {"type": "subtitle", "time": 12295.429, "timestamp": "03:24:55", "text": "コンテンツに対するエンゲージメント、"}, {"type": "subtitle", "time": 12298.07, "timestamp": "03:24:58", "text": "動画などを投稿すると、"}]
[{"type": "subtitle", "time": 13681.91, "timestamp": "03:48:01", "text": "これ、ストリーマーから知ったんだけど"}, {"type": "subtitle", "time": 13684.95, "timestamp": "03:48:04", "text": "フォーラム。私はフィーチャーしようとしていました"}, {"type": "subtitle", "time": 13688.63, "timestamp": "03:48:08", "text": "ビリー・ビリーのグッズについてのリクエスト"}, {"type": "subtitle", "time": 13692.15, "timestamp": "03:48:12", "text": "フォーラムのウェブサイトでこれを見つけました"}, {"type": "subtitle", "time": 13694.469, "timestamp": "03:48:14", "text": "実装を依頼する人"}, {"type": "subtitle", "time": 13697.269, "timestamp": "03:48:17", "text": "ビームストリーム。それで私は「ああ、これは何だ」と思った"}, {"type": "subtitle", "time": 13699.429, "timestamp": "03:48:19", "text": "このビームストリーム？調べてみたら"}, {"type": "subtitle", "time": 13701.75, "timestamp": "03:48:21", "text": "「え？ネイティブに"}, {"type": "subtitle", "time": 13703.83, "timestamp": "03:48:23", "text": "再リーム？"}, {"type": "subtitle", "time": 13707.269, "timestamp": "03:48:27", "text": "おお。ちょっと待ってください。これは正しい"}, {"type": "subtitle", "time": 13709.429, "timestamp": "03:48:29", "text": "君の得意分野だね。"}, {"type": "subtitle", "time": 13710.95, "timestamp": "03:48:30", "text": "うん、"}, {"type": "subtitle", "time": 13713.67, "timestamp": "03:48:33", "text": "とても素敵なウェブサイトですね。ああ、送ります"}, {"type": "subtitle", "time": 13717.349, "timestamp": "03:48:37", "text": "リンクはこちらです。ああ、ありがとうございます。"}, {"type": "subtitle", "time": 13718.95, "timestamp": "03:48:38", "text": "うん、みんなチェックしてみるべきだよ"}, {"type": "subtitle", "time": 13723.91, "timestamp": "03:48:43", "text": "うん、本当に楽しいし、うん、私も"}, {"type": "subtitle", "time": 13725.59, "timestamp": "03:48:45", "text": "YouTuberは数人いると思う"}, {"type": "subtitle", "time": 13727.75, "timestamp": "03:48:47", "text": "そこには。圧倒的だ。ええ、そうです"}, {"type": "subtitle", "time": 13734.309, "timestamp": "03:48:54", "text": "なるほど、考えてみる価値はあるね。まるで私が"}, {"type": "subtitle", "time": 13736.71, "timestamp": "03:48:56", "text": "いつもこう思ってた、ああ、ほら、私は"}, {"type": "subtitle", "time": 13738.87, "timestamp": "03:48:58", "text": "Twitchでのみ配信しています。多分そうかもしれない"}]
[{"type": "subtitle", "time": 3961.67, "timestamp": "01:06:01", "text": "例えば学校を終えたら"}, {"type": "subtitle", "time": 3965.51, "timestamp": "01:06:05", "text": "あなたは10年生の試験を終えました"}, {"type": "subtitle", "time": 3968.069, "timestamp": "01:06:08", "text": "いろいろあるけど、結果が出ればほとんど"}, {"type": "subtitle", "time": 3970.15, "timestamp": "01:06:10", "text": "おそらく、あなたは結果を得ました"}, {"type": "subtitle", "time": 3974.23, "timestamp": "01:06:14", "text": "来月の4月か5月には"}, {"type": "subtitle", "time": 3976.789, "timestamp": "01:06:16", "text": "次の学校を探さなければならない、または"}, {"type": "subtitle", "time": 3979.51, "timestamp": "01:06:19", "text": "コースか、11年生に適した何か"}, {"type": "subtitle", "time": 3982.39, "timestamp": "01:06:22", "text": "12年生。つまり、ある種のギャップがあるということだ"}, {"type": "subtitle", "time": 3984.63, "timestamp": "01:06:24", "text": "6月まで"}, {"type": "subtitle", "time": 3987.99, "timestamp": "01:06:27", "text": "授業開始は7月頃になるかもしれない。"}, {"type": "subtitle", "time": 3991.67, "timestamp": "01:06:31", "text": "でも時々、余分なものを入れる"}, {"type": "subtitle", "time": 3994.789, "timestamp": "01:06:34", "text": "メインクラスの前のクラスのようなクラス"}, {"type": "subtitle", "time": 3998.309, "timestamp": "01:06:38", "text": "夏の特別な始まりのように"}, {"type": "subtitle", "time": 4001.349, "timestamp": "01:06:41", "text": "授業みたいなもんだよね？"}, {"type": "subtitle", "time": 4005.19, "timestamp": "01:06:45", "text": "ええ、夏期講習とか"}, {"type": "subtitle", "time": 4007.829, "timestamp": "01:06:47", "text": "それは5月1日に起こります"}, {"type": "subtitle", "time": 4009.75, "timestamp": "01:06:49", "text": "推測"}, {"type": "subtitle", "time": 4012.069, "timestamp": "01:06:52", "text": "私は思う。うん、"}, {"type": "subtitle", "time": 4014.069, "timestamp": "01:06:54", "text": "他の人もそうだと思う"}, {"type": "subtitle", "time": 4016.71, "timestamp": "01:06:56", "text": "最近では。わからない。わからない"}, {"type": "subtitle", "time": 4018.63, "timestamp": "01:06:58", "text": "システムが変更された場合、または"}]
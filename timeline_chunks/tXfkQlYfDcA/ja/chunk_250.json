[{"type": "subtitle", "time": 15003.349, "timestamp": "04:10:03", "text": "ストリーミング配信する。ああ、それはすごくクールだね。おお。"}, {"type": "subtitle", "time": 15005.91, "timestamp": "04:10:05", "text": "ああ、そして、あなたのすべてが"}, {"type": "subtitle", "time": 15007.83, "timestamp": "04:10:07", "text": "要約。ああ、それはとてもかわいいですね。だから私たちは"}, {"type": "subtitle", "time": 15010.229, "timestamp": "04:10:10", "text": "サムネイルを全部まとめてみました。"}, {"type": "subtitle", "time": 15011.83, "timestamp": "04:10:11", "text": "うん。うん。これはまるで"}, {"type": "subtitle", "time": 15017.11, "timestamp": "04:10:17", "text": "以前よくやっていた実験的なこと。うん。"}, {"type": "subtitle", "time": 15019.59, "timestamp": "04:10:19", "text": "でも、そうですね、プログラミングができたらいいのにと思います。できました"}, {"type": "subtitle", "time": 15021.429, "timestamp": "04:10:21", "text": "たくさんのことをやってきた。とても"}, {"type": "subtitle", "time": 15023.75, "timestamp": "04:10:23", "text": "やりたいことがたくさんあった。あなたもそうでしょう"}, {"type": "subtitle", "time": 15027.03, "timestamp": "04:10:27", "text": "力強いね、ジャック。そういうことなんです。"}, {"type": "subtitle", "time": 15029.349, "timestamp": "04:10:29", "text": "自然は謙虚にならなければならなかった、謙虚にならなければならなかった"}, {"type": "subtitle", "time": 15032.389, "timestamp": "04:10:32", "text": "ほんの少しだけ、"}, {"type": "subtitle", "time": 15034.469, "timestamp": "04:10:34", "text": "あなたが"}, {"type": "subtitle", "time": 15036.469, "timestamp": "04:10:36", "text": "そう、私はまさに達人"}, {"type": "subtitle", "time": 15039.99, "timestamp": "04:10:39", "text": "コーディングも、ああ、誰も"}, {"type": "subtitle", "time": 15042.469, "timestamp": "04:10:42", "text": "チャンスがある"}, {"type": "subtitle", "time": 15049.51, "timestamp": "04:10:49", "text": "おお"}, {"type": "subtitle", "time": 15054.229, "timestamp": "04:10:54", "text": "うん、そういうのがたくさんあるし、楽しいよ"}, {"type": "subtitle", "time": 15057.03, "timestamp": "04:10:57", "text": "ある意味、それはインスピレーションに近い"}]
[{"type": "subtitle", "time": 3482.63, "timestamp": "00:58:02", "text": "何か進展はありましたか？"}, {"type": "subtitle", "time": 3484.39, "timestamp": "00:58:04", "text": "それで？"}, {"type": "subtitle", "time": 3498.63, "timestamp": "00:58:18", "text": "権力に復帰する。待って、待ってって何？"}, {"type": "subtitle", "time": 3500.39, "timestamp": "00:58:20", "text": "そういうこともあります。待って、それは知らなかった"}, {"type": "subtitle", "time": 3503.91, "timestamp": "00:58:23", "text": "タイムゾーンが変更されます。え、何？"}, {"type": "subtitle", "time": 3507.19, "timestamp": "00:58:27", "text": "もうすぐ終わります。さあ行こう。"}, {"type": "subtitle", "time": 3510.309, "timestamp": "00:58:30", "text": "私も、"}, {"type": "subtitle", "time": 3513.67, "timestamp": "00:58:33", "text": "えっと、今月はこういうこと全部です。私が始めます"}, {"type": "subtitle", "time": 3517.19, "timestamp": "00:58:37", "text": "本格的に始めようと思います"}, {"type": "subtitle", "time": 3520.63, "timestamp": "00:58:40", "text": "実際に生産的になる"}, {"type": "subtitle", "time": 3523.25, "timestamp": "00:58:43", "text": "似たようなものと一緒に"}, {"type": "subtitle", "time": 3525.109, "timestamp": "00:58:45", "text": "[音楽]"}, {"type": "subtitle", "time": 3530.23, "timestamp": "00:58:50", "text": "そして少なくとも4月にはすべての項目が対象となります。"}, {"type": "subtitle", "time": 3531.91, "timestamp": "00:58:51", "text": "もちろん、交換留学の準備をする必要があります。"}, {"type": "subtitle", "time": 3535.589, "timestamp": "00:58:55", "text": "それでも私はそれをやるし、そして"}]
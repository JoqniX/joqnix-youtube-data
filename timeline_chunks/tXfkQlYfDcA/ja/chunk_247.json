[{"type": "subtitle", "time": 14821.189, "timestamp": "04:07:01", "text": "スタンプを押すと、私は書かなければならない"}, {"type": "subtitle", "time": 14823.429, "timestamp": "04:07:03", "text": "そのためには、録音も行う必要があります。"}, {"type": "subtitle", "time": 14826.229, "timestamp": "04:07:06", "text": "正しく動作するように書き込む"}, {"type": "subtitle", "time": 14829.67, "timestamp": "04:07:09", "text": "ファイルに書き込まれ、そして、"}, {"type": "subtitle", "time": 14831.99, "timestamp": "04:07:11", "text": "2つ目の方法は、ユーザーのタイムスタンプのようなものです"}, {"type": "chat", "time": 14833.595, "timestamp": "04:07:13", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "crazy stuff"}, {"type": "subtitle", "time": 14833.83, "timestamp": "04:07:13", "text": "チャットの人たちがいいねできるように"}, {"type": "subtitle", "time": 14835.51, "timestamp": "04:07:15", "text": "感嘆符"}, {"type": "subtitle", "time": 14838.07, "timestamp": "04:07:18", "text": "ストリームにマークを付けると、"}, {"type": "subtitle", "time": 14840.389, "timestamp": "04:07:20", "text": "切り取れるもの、または"}, {"type": "subtitle", "time": 14843.91, "timestamp": "04:07:23", "text": "タイムスタンプを付けることで、それをマークすることができます。"}, {"type": "subtitle", "time": 14847.189, "timestamp": "04:07:27", "text": "うん。そして私がすることは、"}, {"type": "subtitle", "time": 14850.55, "timestamp": "04:07:30", "text": "CSV 全体、つまりすべてのもの"}, {"type": "subtitle", "time": 14853.51, "timestamp": "04:07:33", "text": "私がNotierに入力したすべてのタイムスタンプ"}, {"type": "subtitle", "time": 14856.389, "timestamp": "04:07:36", "text": "考えからすると、それは次のようなウェブサイトに行きます"}, {"type": "subtitle", "time": 14859.429, "timestamp": "04:07:39", "text": "そうすれば人々は要約を読むことができる"}, {"type": "subtitle", "time": 14863.429, "timestamp": "04:07:43", "text": "私たちが何をしたにせよ、そしてまた"}, {"type": "subtitle", "time": 14866.63, "timestamp": "04:07:46", "text": "YouTubeからタイムスタンプを取得する"}, {"type": "subtitle", "time": 14869.91, "timestamp": "04:07:49", "text": "Twitchの有効期限が切れるので、"}, {"type": "subtitle", "time": 14872.07, "timestamp": "04:07:52", "text": "それ。ええ、彼らはそれをクリックして、"}, {"type": "subtitle", "time": 14874.63, "timestamp": "04:07:54", "text": "まさにその瞬間を捉える。そして私はそれをした"}, {"type": "subtitle", "time": 14878.15, "timestamp": "04:07:58", "text": "ビリービリーもいるから、今は楽になったよ。"}]
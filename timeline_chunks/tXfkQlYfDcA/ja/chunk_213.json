[{"type": "subtitle", "time": 12780.07, "timestamp": "03:33:00", "text": "彼らの膝の下にいる人々のグループプラス"}, {"type": "subtitle", "time": 12782.469, "timestamp": "03:33:02", "text": "人材開発チームとか、そういうやつ。だから彼らは"}, {"type": "subtitle", "time": 12784.79, "timestamp": "03:33:04", "text": "まるでウェブサイト全体を作ったようなもので、"}, {"type": "subtitle", "time": 12788.07, "timestamp": "03:33:08", "text": "分析など、必要なものはすべて"}, {"type": "subtitle", "time": 12790.87, "timestamp": "03:33:10", "text": "ビリー・ビリー・アンド・スタッフ・チャンネルから"}, {"type": "subtitle", "time": 12792.95, "timestamp": "03:33:12", "text": "文字通り、あなたが持っているすべてのストリーム"}, {"type": "subtitle", "time": 12794.87, "timestamp": "03:33:14", "text": "Twitchトラッカーのように、"}, {"type": "subtitle", "time": 12797.99, "timestamp": "03:33:17", "text": "彼らのウェブサイトでは、"}, {"type": "subtitle", "time": 12801.83, "timestamp": "03:33:21", "text": "OBSはライブチャットのようなチャットボックスですよね？"}, {"type": "subtitle", "time": 12804.87, "timestamp": "03:33:24", "text": "それがマクチャットの件で、それから彼らは"}, {"type": "subtitle", "time": 12808.07, "timestamp": "03:33:28", "text": "カバーに似た時計があります"}, {"type": "subtitle", "time": 12810.63, "timestamp": "03:33:30", "text": "エンターテイメント時計、まさにそれ"}, {"type": "subtitle", "time": 12813.75, "timestamp": "03:33:33", "text": "うんうんウィジェット。それから彼らは音楽を持っている"}, {"type": "subtitle", "time": 12816.79, "timestamp": "03:33:36", "text": "YouTuberのプレイヤーが"}, {"type": "subtitle", "time": 12818.469, "timestamp": "03:33:38", "text": "音楽のカバー曲なども展示されます。"}, {"type": "subtitle", "time": 12821.83, "timestamp": "03:33:41", "text": "それから、たくさんの有益な情報があり、"}, {"type": "subtitle", "time": 12824.79, "timestamp": "03:33:44", "text": "YouTuberなどには良いし、"}, {"type": "subtitle", "time": 12827.83, "timestamp": "03:33:47", "text": "これはすごい、と思った。人々は"}, {"type": "subtitle", "time": 12830.229, "timestamp": "03:33:50", "text": "彼らのチャットサービスは実際にはチャットです"}, {"type": "subtitle", "time": 12834.469, "timestamp": "03:33:54", "text": "ボックスみたいなやつで、機能が追加されました"}, {"type": "subtitle", "time": 12837.11, "timestamp": "03:33:57", "text": "AIがそこで人気になったので"}]
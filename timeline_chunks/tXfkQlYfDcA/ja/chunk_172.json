[{"type": "subtitle", "time": 10323.67, "timestamp": "02:52:03", "text": "要素は、えーと、あなたも見て、えーと"}, {"type": "subtitle", "time": 10326.389, "timestamp": "02:52:06", "text": "私が現在使用しているモデルに搭載されているものとして"}, {"type": "subtitle", "time": 10328.469, "timestamp": "02:52:08", "text": "ほくろみたいに、あれは"}, {"type": "subtitle", "time": 10331.67, "timestamp": "02:52:11", "text": "現実世界のモグラ。うん。"}, {"type": "subtitle", "time": 10335.11, "timestamp": "02:52:15", "text": "つまり、現実の自分もそこにいるようなものだ"}, {"type": "subtitle", "time": 10337.19, "timestamp": "02:52:17", "text": "これへ。"}, {"type": "subtitle", "time": 10338.71, "timestamp": "02:52:18", "text": "うん。"}, {"type": "subtitle", "time": 10340.309, "timestamp": "02:52:20", "text": "つまり、何を言っているんですか？これは"}, {"type": "subtitle", "time": 10344.15, "timestamp": "02:52:24", "text": "あなたの現実の姿。のように、"}, {"type": "subtitle", "time": 10345.349, "timestamp": "02:52:25", "text": "[音楽]"}, {"type": "subtitle", "time": 10349.349, "timestamp": "02:52:29", "text": "それは素晴らしいですね。そして"}, {"type": "subtitle", "time": 10352.15, "timestamp": "02:52:32", "text": "どうぞ。うん。あなたは「ああ、いやだ」と言っています。私"}, {"type": "subtitle", "time": 10353.349, "timestamp": "02:52:33", "text": "あなたのモデルみたいって言ってただけだよ"}, {"type": "subtitle", "time": 10355.75, "timestamp": "02:52:35", "text": "今のところすでにとてもかわいいので、"}, {"type": "subtitle", "time": 10359.59, "timestamp": "02:52:39", "text": "まるであなたの声のように、神秘的"}, {"type": "subtitle", "time": 10361.67, "timestamp": "02:52:41", "text": "は、"}, {"type": "subtitle", "time": 10364.71, "timestamp": "02:52:44", "text": "あなたが目指す美意識。"}, {"type": "subtitle", "time": 10368.389, "timestamp": "02:52:48", "text": "これを見ると、ああ、なんてことだ、"}, {"type": "subtitle", "time": 10371.67, "timestamp": "02:52:51", "text": "それは、まさに絶品になるでしょう。聖なる"}, {"type": "subtitle", "time": 10375.19, "timestamp": "02:52:55", "text": "モリー。私はすでに私の"}, {"type": "subtitle", "time": 10378.15, "timestamp": "02:52:58", "text": "声は一部の人にとって紛らわしいので、"}]
[{"type": "subtitle", "time": 1384.39, "timestamp": "00:23:04", "text": "はい。"}, {"type": "subtitle", "time": 1386.149, "timestamp": "00:23:06", "text": "えっと"}, {"type": "subtitle", "time": 1393.27, "timestamp": "00:23:13", "text": "今日は"}, {"type": "subtitle", "time": 1396.23, "timestamp": "00:23:16", "text": "えっと、私たちは"}, {"type": "subtitle", "time": 1404.07, "timestamp": "00:23:24", "text": "CNNの最も可能性の高い人々は"}, {"type": "subtitle", "time": 1405.909, "timestamp": "00:23:25", "text": "これを読むことができないか、あるいは"}, {"type": "subtitle", "time": 1409.43, "timestamp": "00:23:29", "text": "英語がわかる人向け"}, {"type": "subtitle", "time": 1411.59, "timestamp": "00:23:31", "text": "これは理解できるけど、私はそうじゃない"}, {"type": "subtitle", "time": 1413.75, "timestamp": "00:23:33", "text": "これを中国語に翻訳中ですが"}, {"type": "subtitle", "time": 1417.51, "timestamp": "00:23:37", "text": "それでも私たちはただおしゃべりしただけだった"}, {"type": "subtitle", "time": 1419.669, "timestamp": "00:23:39", "text": "えっと"}, {"type": "subtitle", "time": 1421.51, "timestamp": "00:23:41", "text": "弦"}, {"type": "subtitle", "time": 1424.63, "timestamp": "00:23:44", "text": "えっと、私は"}, {"type": "subtitle", "time": 1432.07, "timestamp": "00:23:52", "text": "そして話した"}, {"type": "subtitle", "time": 1433.59, "timestamp": "00:23:53", "text": "皆さんとお話できてよかったです。きっとあなたも"}, {"type": "subtitle", "time": 1436.07, "timestamp": "00:23:56", "text": "男たちはそれに気づく。"}, {"type": "subtitle", "time": 1438.87, "timestamp": "00:23:58", "text": "うん、それで十分だろう。そして"}]
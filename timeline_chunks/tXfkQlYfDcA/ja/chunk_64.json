[{"type": "subtitle", "time": 3840.549, "timestamp": "01:04:00", "text": "でも、何時間もかけてやってみるんだ"}, {"type": "subtitle", "time": 3843.75, "timestamp": "01:04:03", "text": "たとえ進歩がなくても"}, {"type": "subtitle", "time": 3847.27, "timestamp": "01:04:07", "text": "時々、あなたは私が終わったのが好きで、私はできません"}, {"type": "subtitle", "time": 3849.75, "timestamp": "01:04:09", "text": "少し休憩してから、"}, {"type": "subtitle", "time": 3851.51, "timestamp": "01:04:11", "text": "少しやる気が出て戻ってきた"}, {"type": "subtitle", "time": 3854.39, "timestamp": "01:04:14", "text": "そして、ある程度進歩することができます"}, {"type": "subtitle", "time": 3857.51, "timestamp": "01:04:17", "text": "半分まで来て、その後ついに"}, {"type": "subtitle", "time": 3860.23, "timestamp": "01:04:20", "text": "そういうことがあったら、そうかもしれないね"}, {"type": "subtitle", "time": 3862.069, "timestamp": "01:04:22", "text": "春の学童を除く危険"}, {"type": "subtitle", "time": 3865.109, "timestamp": "01:04:25", "text": "それは、一日一日が意味するからです。"}, {"type": "subtitle", "time": 3867.349, "timestamp": "01:04:27", "text": "彼らは学校に行くために1時間前に起きなければならなかった"}, {"type": "subtitle", "time": 3870.069, "timestamp": "01:04:30", "text": "後で。うん、"}, {"type": "subtitle", "time": 3872.87, "timestamp": "01:04:32", "text": "それは学童たちにとって苦痛なことだろう。待って、"}, {"type": "subtitle", "time": 3875.029, "timestamp": "01:04:35", "text": "夏休みみたいじゃない？"}, {"type": "subtitle", "time": 3877.829, "timestamp": "01:04:37", "text": "最近の人はみんな？"}, {"type": "subtitle", "time": 3879.19, "timestamp": "01:04:39", "text": "それとも"}, {"type": "subtitle", "time": 3882.309, "timestamp": "01:04:42", "text": "[音楽]"}, {"type": "subtitle", "time": 3884.069, "timestamp": "01:04:44", "text": "のように"}, {"type": "subtitle", "time": 3887.19, "timestamp": "01:04:47", "text": "多くの国の人々のように、"}, {"type": "subtitle", "time": 3890.63, "timestamp": "01:04:50", "text": "インドや他の場所ではおそらく"}, {"type": "subtitle", "time": 3893.75, "timestamp": "01:04:53", "text": "3月、4月、5月は"}, {"type": "subtitle", "time": 3897.27, "timestamp": "01:04:57", "text": "3月末まで"}]
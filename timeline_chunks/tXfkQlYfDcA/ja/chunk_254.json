[{"type": "subtitle", "time": 15241.269, "timestamp": "04:14:01", "text": "一緒にコンテンツを作成する"}, {"type": "subtitle", "time": 15243.99, "timestamp": "04:14:03", "text": "一緒に。うん。だから、それは"}, {"type": "subtitle", "time": 15246.309, "timestamp": "04:14:06", "text": "とてもワクワクする。とても圧倒される"}, {"type": "subtitle", "time": 15248.71, "timestamp": "04:14:08", "text": "また同時に、すべてと同じように"}, {"type": "subtitle", "time": 15250.469, "timestamp": "04:14:10", "text": "これまでは「うん、やってるよ」って感じだったんだけど"}, {"type": "subtitle", "time": 15253.189, "timestamp": "04:14:13", "text": "自分で物事をこなしていたが、今は待って"}, {"type": "subtitle", "time": 15255.59, "timestamp": "04:14:15", "text": "私は他の人と一緒に一人で物事を行っています"}, {"type": "subtitle", "time": 15259.349, "timestamp": "04:14:19", "text": "でも、私たちは一緒にやっているんです。"}, {"type": "subtitle", "time": 15261.51, "timestamp": "04:14:21", "text": "でも楽しいよ。楽しいよ。えっと、本当に"}, {"type": "subtitle", "time": 15262.95, "timestamp": "04:14:22", "text": "楽しみにしています。探しています"}, {"type": "subtitle", "time": 15265.67, "timestamp": "04:14:25", "text": "私も楽しみにしています。何てことだ。私はとても"}, {"type": "subtitle", "time": 15273.75, "timestamp": "04:14:33", "text": "何てことだ。これは本当に美味しい。そして私はできる"}, {"type": "subtitle", "time": 15276.389, "timestamp": "04:14:36", "text": "予告編からご覧ください。ええ、本当に"}, {"type": "subtitle", "time": 15280.149, "timestamp": "04:14:40", "text": "言うのは簡単だ、それは君だ"}, {"type": "subtitle", "time": 15285.189, "timestamp": "04:14:45", "text": "誰にも言わないでね。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 15287.269, "timestamp": "04:14:47", "text": "秘密にしておいてください。私はふりをする"}, {"type": "subtitle", "time": 15290.309, "timestamp": "04:14:50", "text": "デビューが実現したときは驚いた。はい。はい。"}, {"type": "subtitle", "time": 15292.63, "timestamp": "04:14:52", "text": "ええ、それは私にとって嬉しいニュースなんです。"}, {"type": "subtitle", "time": 15296.149, "timestamp": "04:14:56", "text": "わーい。それって数日後のことですよね？"}, {"type": "subtitle", "time": 15299.429, "timestamp": "04:14:59", "text": "16. ええ、そうです。だから、私たちは"}]
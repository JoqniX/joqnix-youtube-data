[{"type": "subtitle", "time": 11042.87, "timestamp": "03:04:02", "text": "物事を逆転させることが可能になる"}, {"type": "subtitle", "time": 11047.03, "timestamp": "03:04:07", "text": "周りにいて、私がそこにいても大丈夫です"}, {"type": "subtitle", "time": 11050.07, "timestamp": "03:04:10", "text": "えっと、高品質な車を何と呼ぶんですか？"}, {"type": "subtitle", "time": 11057.11, "timestamp": "03:04:17", "text": "まあいいか。そして明らかにこれは"}, {"type": "subtitle", "time": 11059.11, "timestamp": "03:04:19", "text": "あなたがとても好きなもの"}, {"type": "subtitle", "time": 11061.51, "timestamp": "03:04:21", "text": "興味があります。あなたは細部にとてもこだわる"}, {"type": "subtitle", "time": 11063.83, "timestamp": "03:04:23", "text": "方向性があるよね？だから、"}, {"type": "subtitle", "time": 11065.91, "timestamp": "03:04:25", "text": "うん、追加分を取っておいた方がいいかもね"}, {"type": "subtitle", "time": 11067.99, "timestamp": "03:04:27", "text": "すべてが次のようになっていることを確認する手順"}, {"type": "subtitle", "time": 11071.349, "timestamp": "03:04:31", "text": "汚れがなく、完璧だ。うん、私は"}, {"type": "subtitle", "time": 11074.469, "timestamp": "03:04:34", "text": "完璧主義者。理由がわからない。それは"}, {"type": "subtitle", "time": 11076.79, "timestamp": "03:04:36", "text": "コンテンツについても同じことが言えます。"}, {"type": "subtitle", "time": 11079.269, "timestamp": "03:04:39", "text": "動画とか写真とか色々。私はこう思った"}, {"type": "subtitle", "time": 11081.83, "timestamp": "03:04:41", "text": "こだわりが強すぎてそうしないわけにはいかないし、みんな"}, {"type": "subtitle", "time": 11084.389, "timestamp": "03:04:44", "text": "私の周りは、スポーツ選手がショートパンツをアップロードしているような感じでした。"}, {"type": "subtitle", "time": 11087.269, "timestamp": "03:04:47", "text": "それはあなたのチャンネルなどを強化し、"}, {"type": "subtitle", "time": 11090.07, "timestamp": "03:04:50", "text": "ジョアソンを通して私は"}, {"type": "subtitle", "time": 11092.309, "timestamp": "03:04:52", "text": "完璧主義者を取り除いて"}, {"type": "subtitle", "time": 11095.75, "timestamp": "03:04:55", "text": "脇に置いて、みんなで始めるよ"}, {"type": "subtitle", "time": 11098.71, "timestamp": "03:04:58", "text": "どこかにアップロードしても問題ない"}]
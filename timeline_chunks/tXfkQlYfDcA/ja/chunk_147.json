[{"type": "subtitle", "time": 8820.469, "timestamp": "02:27:00", "text": "それはつまり。それで調べてみたところ、"}, {"type": "subtitle", "time": 8823.19, "timestamp": "02:27:03", "text": "中国人は理解できない"}, {"type": "subtitle", "time": 8825.349, "timestamp": "02:27:05", "text": "YouTube、Twitch、Discordにアクセスする"}, {"type": "subtitle", "time": 8828.23, "timestamp": "02:27:08", "text": "すべて。ああ、それで私はすでに"}, {"type": "subtitle", "time": 8830.71, "timestamp": "02:27:10", "text": "Holのライブ配信などをフォローしていたので知っていました"}, {"type": "subtitle", "time": 8833.03, "timestamp": "02:27:13", "text": "彼らはビリービリーでストリーミング配信していた。だから私は"}, {"type": "subtitle", "time": 8835.27, "timestamp": "02:27:15", "text": "そこへ行くことを選んだ。見つけるのが難しかった"}, {"type": "subtitle", "time": 8839.51, "timestamp": "02:27:19", "text": "ストリーミングの方法などですが、ありがたいことに"}, {"type": "subtitle", "time": 8842.55, "timestamp": "02:27:22", "text": "私を助けてくれる人を見つけることができました"}, {"type": "subtitle", "time": 8844.79, "timestamp": "02:27:24", "text": "ワイヤレスアクセスを取得するために"}, {"type": "subtitle", "time": 8847.27, "timestamp": "02:27:27", "text": "すべて。そして私はストリーミング配信を始めた"}, {"type": "subtitle", "time": 8850.07, "timestamp": "02:27:30", "text": "そこにいて、みんながそう言った"}, {"type": "subtitle", "time": 8852.95, "timestamp": "02:27:32", "text": "英語がわからない。完全に中国製です"}, {"type": "subtitle", "time": 8856.79, "timestamp": "02:27:36", "text": "ええ、そうです。うん。そして言語の壁"}, {"type": "subtitle", "time": 8860.15, "timestamp": "02:27:40", "text": "難しかったし、私はこう思いました"}, {"type": "subtitle", "time": 8863.91, "timestamp": "02:27:43", "text": "ここからの人たちとコミュニケーションをとる"}, {"type": "subtitle", "time": 8866.389, "timestamp": "02:27:46", "text": "彼らが私を理解できるように、そして"}, {"type": "subtitle", "time": 8869.11, "timestamp": "02:27:49", "text": "VPNを使わせたくないから、そういうことをするんだ"}, {"type": "subtitle", "time": 8871.349, "timestamp": "02:27:51", "text": "加速器関連のものや、"}, {"type": "subtitle", "time": 8874.79, "timestamp": "02:27:54", "text": "YouTube は多すぎるでしょう、そして"}, {"type": "subtitle", "time": 8876.79, "timestamp": "02:27:56", "text": "私がそこにいれば彼らにとって都合が良いだろう"}, {"type": "subtitle", "time": 8879.349, "timestamp": "02:27:59", "text": "それに、マルチリーミングもいつでもできます。"}]
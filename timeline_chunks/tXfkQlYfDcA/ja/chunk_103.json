[{"type": "subtitle", "time": 6181.03, "timestamp": "01:43:01", "text": "サーバーから通知を受け取りました。"}, {"type": "subtitle", "time": 6182.55, "timestamp": "01:43:02", "text": "えーと"}, {"type": "subtitle", "time": 6185.669, "timestamp": "01:43:05", "text": "サウンドビッシュ利用可能か何か"}, {"type": "subtitle", "time": 6189.03, "timestamp": "01:43:09", "text": "ヴィシを開けて"}, {"type": "subtitle", "time": 6191.91, "timestamp": "01:43:11", "text": "見て確認しましたが、音はしません"}, {"type": "subtitle", "time": 6194.629, "timestamp": "01:43:14", "text": "利用可能です。了解しました。"}, {"type": "subtitle", "time": 6196.629, "timestamp": "01:43:16", "text": "そうそう。私には権利が必要だ。うん、私には"}, {"type": "subtitle", "time": 6198.149, "timestamp": "01:43:18", "text": "右。"}, {"type": "subtitle", "time": 6200.629, "timestamp": "01:43:20", "text": "はい、ポッドに許可を与えます"}, {"type": "subtitle", "time": 6206.31, "timestamp": "01:43:26", "text": "ザックは今のところ実際に機内で使用する予定だ。"}, {"type": "subtitle", "time": 6209.189, "timestamp": "01:43:29", "text": "パスオン"}, {"type": "subtitle", "time": 6211.109, "timestamp": "01:43:31", "text": "それでできるはずだ。必要になるかもしれない"}, {"type": "subtitle", "time": 6214.47, "timestamp": "01:43:34", "text": "カテゴリポンプを実行して上書きします。"}, {"type": "subtitle", "time": 6223.109, "timestamp": "01:43:43", "text": "音量を変更したり、オプトアウトしたりできますか？"}, {"type": "subtitle", "time": 6226.39, "timestamp": "01:43:46", "text": "サウンドボードの？はい、オプトアウトできます"}, {"type": "subtitle", "time": 6228.95, "timestamp": "01:43:48", "text": "ああ、そこだ。待って、それはつまり"}, {"type": "subtitle", "time": 6231.51, "timestamp": "01:43:51", "text": "音声とビデオの新しい設定"}, {"type": "subtitle", "time": 6234.87, "timestamp": "01:43:54", "text": "サウンドボード。音量を調節できます"}, {"type": "subtitle", "time": 6236.55, "timestamp": "01:43:56", "text": "音はあなた個人のためのものです。クリック"}, {"type": "subtitle", "time": 6239.03, "timestamp": "01:43:59", "text": "ここ"}]
[{"type": "subtitle", "time": 4624.149, "timestamp": "01:17:04", "text": "そういうもの、もしくは髪を染めるようなもの？ H"}, {"type": "subtitle", "time": 4627.43, "timestamp": "01:17:07", "text": "私がどう思うかって？つまり、私も私も"}, {"type": "subtitle", "time": 4629.59, "timestamp": "01:17:09", "text": "髪を銀色に染めたい、または"}, {"type": "subtitle", "time": 4633.51, "timestamp": "01:17:13", "text": "ある日は白っぽく、まるで暗かったかのように、"}, {"type": "subtitle", "time": 4637.189, "timestamp": "01:17:17", "text": "でも時々、ほら、"}, {"type": "subtitle", "time": 4640.71, "timestamp": "01:17:20", "text": "元の色、自然な色、"}, {"type": "subtitle", "time": 4642.79, "timestamp": "01:17:22", "text": "[音楽]"}, {"type": "subtitle", "time": 4644.709, "timestamp": "01:17:24", "text": "髪を染めることは、"}, {"type": "subtitle", "time": 4647.11, "timestamp": "01:17:27", "text": "化学薬品とか色々あるよね"}, {"type": "subtitle", "time": 4648.709, "timestamp": "01:17:28", "text": "自然な髪の上に"}, {"type": "subtitle", "time": 4652.39, "timestamp": "01:17:32", "text": "すべて。しかしそれでも"}, {"type": "subtitle", "time": 4654.79, "timestamp": "01:17:34", "text": "それはまるで"}, {"type": "subtitle", "time": 4657.35, "timestamp": "01:17:37", "text": "あなたは大切なものを失うでしょう"}, {"type": "subtitle", "time": 4660.47, "timestamp": "01:17:40", "text": "あなたが大切に思うこと"}, {"type": "subtitle", "time": 4663.43, "timestamp": "01:17:43", "text": "人生で何かを失う"}, {"type": "subtitle", "time": 4667.43, "timestamp": "01:17:47", "text": "あなたが生まれ持った自然なもの"}, {"type": "subtitle", "time": 4671.669, "timestamp": "01:17:51", "text": "あのOG OGのヘアカラー"}, {"type": "subtitle", "time": 4674.07, "timestamp": "01:17:54", "text": "うん、髪の色は手に入ると思うよ"}, {"type": "subtitle", "time": 4676.07, "timestamp": "01:17:56", "text": "戻る 入手できるかどうかわかりません"}, {"type": "subtitle", "time": 4679.27, "timestamp": "01:17:59", "text": "洗い流したり、塗布したりしても元に戻ります"}]
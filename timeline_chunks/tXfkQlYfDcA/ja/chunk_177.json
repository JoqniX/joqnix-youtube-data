[{"type": "subtitle", "time": 10620.55, "timestamp": "02:57:00", "text": "うまくいくはずだったのに、残念ながら何も"}, {"type": "subtitle", "time": 10622.23, "timestamp": "02:57:02", "text": "起こった。"}, {"type": "subtitle", "time": 10624.309, "timestamp": "02:57:04", "text": "だから私は物事が起こることを許容できなかった、"}, {"type": "subtitle", "time": 10627.269, "timestamp": "02:57:07", "text": "人生には色々なことが起こるものですよね？だから私は話せなかった。"}, {"type": "subtitle", "time": 10629.03, "timestamp": "02:57:09", "text": "私は話すことを許されていませんでした"}, {"type": "subtitle", "time": 10632.79, "timestamp": "02:57:12", "text": "他の人たちはまだ来ていない。待つように言われたからだ。"}, {"type": "subtitle", "time": 10635.99, "timestamp": "02:57:15", "text": "そして私は辛抱強く待った。なんてこった。それで私は"}, {"type": "subtitle", "time": 10638.07, "timestamp": "02:57:18", "text": "「ああ、自分でやるよ」みたいな感じ。"}, {"type": "subtitle", "time": 10640.15, "timestamp": "02:57:20", "text": "「買い戻すか、何でもするよ。」"}, {"type": "subtitle", "time": 10643.19, "timestamp": "02:57:23", "text": "彼らは「わかった」という感じだった。そして、私たちは"}, {"type": "subtitle", "time": 10647.19, "timestamp": "02:57:27", "text": "交渉済みライセンスリース"}, {"type": "subtitle", "time": 10649.51, "timestamp": "02:57:29", "text": "あれがそこにあって、それらすべてが"}, {"type": "subtitle", "time": 10652.87, "timestamp": "02:57:32", "text": "もの。ええ、それで私は直接"}, {"type": "subtitle", "time": 10655.75, "timestamp": "02:57:35", "text": "アーティストに連絡したら、彼らはこう言った。"}, {"type": "subtitle", "time": 10658.23, "timestamp": "02:57:38", "text": "「ええ、久しぶりですね。"}, {"type": "subtitle", "time": 10660.07, "timestamp": "02:57:40", "text": "補償するために"}, {"type": "subtitle", "time": 10662.71, "timestamp": "02:57:42", "text": "もし私が、もしあなたが、もし私が物事を修正する必要があるなら、"}, {"type": "subtitle", "time": 10666.71, "timestamp": "02:57:46", "text": "「すべて。」そして私は「うん、そうだ」と思った。"}, {"type": "subtitle", "time": 10670.469, "timestamp": "02:57:50", "text": "えっと、私が手に入れたファイルは"}, {"type": "subtitle", "time": 10673.83, "timestamp": "02:57:53", "text": "たくさんの問題がありました。"}, {"type": "subtitle", "time": 10675.75, "timestamp": "02:57:55", "text": "脂肪とかそういうもの。一部は"}, {"type": "subtitle", "time": 10678.23, "timestamp": "02:57:58", "text": "別れた。つまり、不正操作は不可能だった。"}]
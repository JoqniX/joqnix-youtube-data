[{"type": "subtitle", "time": 7622.629, "timestamp": "02:07:02", "text": "私の右側の両側"}, {"type": "subtitle", "time": 7629.669, "timestamp": "02:07:09", "text": "まるで電気ショックを受けたような感覚"}, {"type": "subtitle", "time": 7631.04, "timestamp": "02:07:11", "text": "あれ。"}, {"type": "subtitle", "time": 7642.47, "timestamp": "02:07:22", "text": "どうやって引き剥がすのですか？この椅子の高さ。"}, {"type": "subtitle", "time": 7645.83, "timestamp": "02:07:25", "text": "来て。下へ降りてください。下へ降りてください。私は思う"}, {"type": "subtitle", "time": 7654.709, "timestamp": "02:07:34", "text": "このハンドル"}, {"type": "subtitle", "time": 7657.109, "timestamp": "02:07:37", "text": "この取っ手だけがこのように曲げることができた"}, {"type": "subtitle", "time": 7659.43, "timestamp": "02:07:39", "text": "椅子に座った"}, {"type": "subtitle", "time": 7661.91, "timestamp": "02:07:41", "text": "痛みのために。これはどちらかというとオフィスに近い"}, {"type": "subtitle", "time": 7665.189, "timestamp": "02:07:45", "text": "椅子。これです"}, {"type": "subtitle", "time": 7666.87, "timestamp": "02:07:46", "text": "高さ調節が可能で、"}, {"type": "subtitle", "time": 7669.91, "timestamp": "02:07:49", "text": "もの。ヘッドレストが付いています"}, {"type": "subtitle", "time": 7673.35, "timestamp": "02:07:53", "text": "そこにはゲーミングチェアしかなかった。私はこう言える"}]
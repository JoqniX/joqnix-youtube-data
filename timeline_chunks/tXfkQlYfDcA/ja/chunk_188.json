[{"type": "subtitle", "time": 11280.07, "timestamp": "03:08:00", "text": "ショーケースは、"}, {"type": "subtitle", "time": 11282.87, "timestamp": "03:08:02", "text": "アーティストの音楽アーティスト、そしてアップロードも"}, {"type": "subtitle", "time": 11285.429, "timestamp": "03:08:05", "text": "YouTuber関連のコンテンツとかそういうのだよね"}, {"type": "subtitle", "time": 11287.99, "timestamp": "03:08:07", "text": "YouTubeで。絶対に。そしてYouTube"}, {"type": "subtitle", "time": 11292.63, "timestamp": "03:08:12", "text": "リリース タブを追加して、"}, {"type": "subtitle", "time": 11294.63, "timestamp": "03:08:14", "text": "そうすればもっと簡単になり、ショートパンツも"}, {"type": "subtitle", "time": 11298.07, "timestamp": "03:08:18", "text": "タブも。そう、そう、私はいつでも"}, {"type": "subtitle", "time": 11299.59, "timestamp": "03:08:19", "text": "音楽がある。リリースに含まれます"}, {"type": "subtitle", "time": 11301.75, "timestamp": "03:08:21", "text": "タブ。動画は「動画」タブに表示されます。"}, {"type": "subtitle", "time": 11304.15, "timestamp": "03:08:24", "text": "生放送は生放送です。ショーツは"}, {"type": "subtitle", "time": 11307.349, "timestamp": "03:08:27", "text": "整頓された。右。右。右。うん。"}, {"type": "subtitle", "time": 11309.03, "timestamp": "03:08:29", "text": "ごちゃごちゃしていなくて分かりにくい"}, {"type": "subtitle", "time": 11310.87, "timestamp": "03:08:30", "text": "誰でもあなたのチャンネルに来るのが好きです"}, {"type": "subtitle", "time": 11312.87, "timestamp": "03:08:32", "text": "初めてのように。彼らは「ああ、"}, {"type": "subtitle", "time": 11315.349, "timestamp": "03:08:35", "text": "わかった。よし、ジョー、やってくれ。あなたは"}, {"type": "subtitle", "time": 11323.99, "timestamp": "03:08:43", "text": "うん。ああ、それはすごくクールだね。"}, {"type": "subtitle", "time": 11326.79, "timestamp": "03:08:46", "text": "私もそうしようと思ったんです。そしてそれは"}, {"type": "subtitle", "time": 11329.269, "timestamp": "03:08:49", "text": "最初は「うん、"}, {"type": "subtitle", "time": 11331.91, "timestamp": "03:08:51", "text": "ジョアンナ、私は音楽バッジが欲しいのであって、"}, {"type": "subtitle", "time": 11335.269, "timestamp": "03:08:55", "text": "認証済みYouTubeバッジ。"}, {"type": "subtitle", "time": 11338.469, "timestamp": "03:08:58", "text": "わかった。わかった。すごく可愛いですね。私は好きです"}]
[{"type": "subtitle", "time": 10681.59, "timestamp": "02:58:01", "text": "改造可能。だから私は、そう、"}, {"type": "subtitle", "time": 10683.67, "timestamp": "02:58:03", "text": "シルエットのやつはやらない方がいい"}, {"type": "subtitle", "time": 10686.87, "timestamp": "02:58:06", "text": "そしてそれをからかう。私はそれをやる準備ができていた。"}, {"type": "subtitle", "time": 10689.91, "timestamp": "02:58:09", "text": "そして、私は別の問題に遭遇しました。"}, {"type": "subtitle", "time": 10693.349, "timestamp": "02:58:13", "text": "それで、私は「ああ、どうすればいいんだろう？」って思ったんです。"}, {"type": "subtitle", "time": 10697.11, "timestamp": "02:58:17", "text": "私は今でもリスクを冒しています"}, {"type": "subtitle", "time": 10701.19, "timestamp": "02:58:21", "text": "ジョアソンを延長します。私は、ええと"}, {"type": "subtitle", "time": 10704.63, "timestamp": "02:58:24", "text": "1年間のライセンスを取得する"}, {"type": "subtitle", "time": 10707.19, "timestamp": "02:58:27", "text": "そして、えーっと、からかって、からかうように"}, {"type": "subtitle", "time": 10711.67, "timestamp": "02:58:31", "text": "そしてゆっくりと盛り上げていくけど、"}, {"type": "subtitle", "time": 10713.67, "timestamp": "02:58:33", "text": "アート関連の作業が完全に終わってからそれをしてください"}, {"type": "subtitle", "time": 10715.67, "timestamp": "02:58:35", "text": "直ったし、すべて順調だ。"}, {"type": "subtitle", "time": 10718.71, "timestamp": "02:58:38", "text": "ただ、今やリガーだけが"}, {"type": "subtitle", "time": 10722.55, "timestamp": "02:58:42", "text": "そうやってやってください。うん。今はレギュレーターで"}, {"type": "subtitle", "time": 10725.11, "timestamp": "02:58:45", "text": "アーティストは韓国人なので、"}, {"type": "subtitle", "time": 10727.03, "timestamp": "02:58:47", "text": "彼女の推薦で、私はそうしなかったから"}, {"type": "subtitle", "time": 10730.23, "timestamp": "02:58:50", "text": "コミュニケーションの問題が発生することを望んでいます"}, {"type": "subtitle", "time": 10734.309, "timestamp": "02:58:54", "text": "そうそう、リガーは"}, {"type": "subtitle", "time": 10737.59, "timestamp": "02:58:57", "text": "ここで休憩する準備ができた彼らは、えーと私たちは"}]
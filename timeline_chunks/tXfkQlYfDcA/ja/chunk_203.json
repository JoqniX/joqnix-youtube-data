[{"type": "subtitle", "time": 12182.389, "timestamp": "03:23:02", "text": "そして物事は、"}, {"type": "subtitle", "time": 12185.11, "timestamp": "03:23:05", "text": "政治的なことや、その他そういう類のことなら何でもいい。"}, {"type": "subtitle", "time": 12187.83, "timestamp": "03:23:07", "text": "うん。私はたくさんのものを数え、"}, {"type": "subtitle", "time": 12191.59, "timestamp": "03:23:11", "text": "たとえ 2 分間 AFK であっても、"}, {"type": "subtitle", "time": 12194.71, "timestamp": "03:23:14", "text": "すべてのものをチェックする管理者"}, {"type": "subtitle", "time": 12196.71, "timestamp": "03:23:16", "text": "人々の配信 なぜ彼らが"}, {"type": "subtitle", "time": 12200.55, "timestamp": "03:23:20", "text": "そうするけど、うん、彼らが見たら"}, {"type": "subtitle", "time": 12203.11, "timestamp": "03:23:23", "text": "声が出ない、もしくは"}, {"type": "subtitle", "time": 12205.11, "timestamp": "03:23:25", "text": "彼らが配信を停止したのが聞こえた。もし"}, {"type": "subtitle", "time": 12207.51, "timestamp": "03:23:27", "text": "私は彼らが削除するカテゴリーに該当しない"}, {"type": "subtitle", "time": 12210.87, "timestamp": "03:23:30", "text": "小川。そういうことがたくさんあります。"}, {"type": "subtitle", "time": 12213.03, "timestamp": "03:23:33", "text": "うん。文字通り間違った方向に進んでいる"}, {"type": "subtitle", "time": 12214.87, "timestamp": "03:23:34", "text": "カテゴリ。"}, {"type": "subtitle", "time": 12218.63, "timestamp": "03:23:38", "text": "うん。とても大きくて、ゲームには"}, {"type": "subtitle", "time": 12222.229, "timestamp": "03:23:42", "text": "例えばゲームにはumがありません"}, {"type": "subtitle", "time": 12223.91, "timestamp": "03:23:43", "text": "魔法使いのようなガチャゲームみたいに"}, {"type": "subtitle", "time": 12228.389, "timestamp": "03:23:48", "text": "基地とかそういうもの。私はそれをストリーミング配信していて、"}, {"type": "subtitle", "time": 12230.55, "timestamp": "03:23:50", "text": "私の配信は2回停止されました"}, {"type": "subtitle", "time": 12235.19, "timestamp": "03:23:55", "text": "理由は2つあります。一つは、えーと遊ぶためだった"}, {"type": "subtitle", "time": 12237.99, "timestamp": "03:23:57", "text": "英語の西洋外国語版"}]
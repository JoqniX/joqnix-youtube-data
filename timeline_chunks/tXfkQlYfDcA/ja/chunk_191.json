[{"type": "subtitle", "time": 11461.11, "timestamp": "03:11:01", "text": "ゲームをしていると、"}, {"type": "subtitle", "time": 11463.429, "timestamp": "03:11:03", "text": "もっと集中して、そういう感じ。それは話さない"}, {"type": "subtitle", "time": 11466.469, "timestamp": "03:11:06", "text": "多くの。うんうん。そして私は自分が下手だと感じた"}, {"type": "subtitle", "time": 11469.11, "timestamp": "03:11:09", "text": "チャットしたり話したりしているだけです"}, {"type": "subtitle", "time": 11471.67, "timestamp": "03:11:11", "text": "ストリームの種類。そして時が経つにつれて私は"}, {"type": "subtitle", "time": 11473.99, "timestamp": "03:11:13", "text": "私は適応できることに気づき、"}, {"type": "subtitle", "time": 11477.83, "timestamp": "03:11:17", "text": "できる。ジェイダを通して私は気づいた"}, {"type": "subtitle", "time": 11480.87, "timestamp": "03:11:20", "text": "ほとんどの人にとって私が決めたことは"}, {"type": "subtitle", "time": 11483.11, "timestamp": "03:11:23", "text": "ゲームでは、"}, {"type": "subtitle", "time": 11485.03, "timestamp": "03:11:25", "text": "ゲームすら必要なかった。私たちはちょうど"}, {"type": "subtitle", "time": 11487.91, "timestamp": "03:11:27", "text": "拭いたり冷やしたりしすぎですよね？"}, {"type": "subtitle", "time": 11491.429, "timestamp": "03:11:31", "text": "うん。うん。時間が経つのはあっという間だった"}, {"type": "subtitle", "time": 11493.11, "timestamp": "03:11:33", "text": "そしてあなたは「え？」って感じ。それで、それについてですが"}, {"type": "subtitle", "time": 11498.07, "timestamp": "03:11:38", "text": "[音楽]"}, {"type": "subtitle", "time": 11500.389, "timestamp": "03:11:40", "text": "うん。まるで、私はそれが"}, {"type": "subtitle", "time": 11501.99, "timestamp": "03:11:41", "text": "少し難しい"}, {"type": "subtitle", "time": 11504.309, "timestamp": "03:11:44", "text": "心と心を通わせるように話す"}, {"type": "subtitle", "time": 11506.309, "timestamp": "03:11:46", "text": "会話とか、支払いとか"}, {"type": "subtitle", "time": 11508.309, "timestamp": "03:11:48", "text": "あなたがしようとしているとき、注意を向けてください"}, {"type": "subtitle", "time": 11510.79, "timestamp": "03:11:50", "text": "ゲームで生き残る。"}, {"type": "subtitle", "time": 11512.55, "timestamp": "03:11:52", "text": "はい。でもそれは悪いことではない"}, {"type": "subtitle", "time": 11514.469, "timestamp": "03:11:54", "text": "どちらか。また、ゲームは"}, {"type": "subtitle", "time": 11516.15, "timestamp": "03:11:56", "text": "あなたに好きなものを提供する機会"}, {"type": "subtitle", "time": 11518.07, "timestamp": "03:11:58", "text": "それについても話しましょうか？"}]
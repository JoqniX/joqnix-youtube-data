[{"type": "subtitle", "time": 13081.51, "timestamp": "03:38:01", "text": "まだ知らないからサポートしてくれない"}, {"type": "subtitle", "time": 13084.389, "timestamp": "03:38:04", "text": "それについてあまり話さないが、誰も"}, {"type": "subtitle", "time": 13088.229, "timestamp": "03:38:08", "text": "それを機能させるためのイニシアチブはまだなので、私は"}, {"type": "subtitle", "time": 13091.19, "timestamp": "03:38:11", "text": "要望された機能、ラプラスの人々に参加しよう"}, {"type": "subtitle", "time": 13094.55, "timestamp": "03:38:14", "text": "Discordがあったのでラッキーでした"}, {"type": "subtitle", "time": 13096.79, "timestamp": "03:38:16", "text": "VChatのように参加する必要があると思っていました"}, {"type": "subtitle", "time": 13099.59, "timestamp": "03:38:19", "text": "グループとかQQグループとかそういうの。まさにそれだった"}, {"type": "subtitle", "time": 13102.95, "timestamp": "03:38:22", "text": "今はそこに行くのは難しいです、なぜなら"}, {"type": "subtitle", "time": 13105.51, "timestamp": "03:38:25", "text": "VCAはインドの電話番号を許可していません"}, {"type": "subtitle", "time": 13108.87, "timestamp": "03:38:28", "text": "数字。だから、もし私が"}, {"type": "subtitle", "time": 13111.19, "timestamp": "03:38:31", "text": "ええ、禁止措置のせいですね。"}, {"type": "subtitle", "time": 13113.83, "timestamp": "03:38:33", "text": "ありがたいことに、古いものを取り戻すことができました"}, {"type": "subtitle", "time": 13118.07, "timestamp": "03:38:38", "text": "私が作った古いQQアカウント。えっと"}, {"type": "subtitle", "time": 13122.63, "timestamp": "03:38:42", "text": "QってWhatsAppみたいなやつだよ"}, {"type": "subtitle", "time": 13124.87, "timestamp": "03:38:44", "text": "またはWhatsAppやメッセンジャーのようなもの"}, {"type": "subtitle", "time": 13128.71, "timestamp": "03:38:48", "text": "中国にはQペイなどがあり、"}, {"type": "subtitle", "time": 13130.389, "timestamp": "03:38:50", "text": "多くのことと同じように、"}, {"type": "subtitle", "time": 13133.91, "timestamp": "03:38:53", "text": "メッセージングアプリケーションの権利"}, {"type": "subtitle", "time": 13136.71, "timestamp": "03:38:56", "text": "それで、Discordサーバーに行って質問しました"}, {"type": "subtitle", "time": 13139.03, "timestamp": "03:38:59", "text": "彼らに、うん、ログに記録したい"}]
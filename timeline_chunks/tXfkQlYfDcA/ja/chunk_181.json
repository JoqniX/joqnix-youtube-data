[{"type": "subtitle", "time": 10863.11, "timestamp": "03:01:03", "text": "面白い。私の誕生日は8月20日です。"}, {"type": "subtitle", "time": 10866.469, "timestamp": "03:01:06", "text": "私たちはとても仲が良いんです。うん。"}, {"type": "subtitle", "time": 10870.469, "timestamp": "03:01:10", "text": "8月。何てことだ。さあ行こう。"}, {"type": "subtitle", "time": 10872.63, "timestamp": "03:01:12", "text": "気付いたかどうか分かりませんが。私はしません"}, {"type": "subtitle", "time": 10875.19, "timestamp": "03:01:15", "text": "気づいたかどうか教えてください。ええと、レオが見えます"}, {"type": "subtitle", "time": 10878.23, "timestamp": "03:01:18", "text": "星座？レオは実はレオです"}, {"type": "subtitle", "time": 10885.11, "timestamp": "03:01:25", "text": "頑張って。うわぁ、見て"}, {"type": "subtitle", "time": 10887.83, "timestamp": "03:01:27", "text": "狂気の注目"}, {"type": "subtitle", "time": 10890.389, "timestamp": "03:01:30", "text": "細部へのこだわり。文字通り次"}, {"type": "subtitle", "time": 10894.309, "timestamp": "03:01:34", "text": "レベル。何？"}, {"type": "subtitle", "time": 10896.23, "timestamp": "03:01:36", "text": "おお。"}, {"type": "subtitle", "time": 10899.91, "timestamp": "03:01:39", "text": "すばらしい。すばらしい。"}, {"type": "subtitle", "time": 10903.75, "timestamp": "03:01:43", "text": "たくさんのこと。しかし、多くの物事と同じように。"}, {"type": "subtitle", "time": 10905.59, "timestamp": "03:01:45", "text": "まるでたくさんのことを同時にこなしているみたいだ"}, {"type": "subtitle", "time": 10909.269, "timestamp": "03:01:49", "text": "一度。どうやってやるんですか？どうやって"}, {"type": "subtitle", "time": 10912.389, "timestamp": "03:01:52", "text": "お時間ありますか？"}, {"type": "subtitle", "time": 10915.59, "timestamp": "03:01:55", "text": "でも、もし私が"}, {"type": "subtitle", "time": 10919.59, "timestamp": "03:01:59", "text": "デビューするだろう、それはたくさん"}]
[{"type": "subtitle", "time": 3061.91, "timestamp": "00:51:01", "text": "私たちは戻ってきました。"}, {"type": "subtitle", "time": 3065.43, "timestamp": "00:51:05", "text": "おかえりなさい。"}, {"type": "subtitle", "time": 3067.67, "timestamp": "00:51:07", "text": "朝食はちゃんと食べましたか？"}, {"type": "subtitle", "time": 3080.95, "timestamp": "00:51:20", "text": "宗教的"}, {"type": "subtitle", "time": 3082.79, "timestamp": "00:51:22", "text": "アイデンティティ。"}, {"type": "subtitle", "time": 3091.67, "timestamp": "00:51:31", "text": "重要性を帯びた。消費"}, {"type": "subtitle", "time": 3092.8, "timestamp": "00:51:32", "text": "重要。"}, {"type": "subtitle", "time": 3094.95, "timestamp": "00:51:34", "text": "[音楽]"}, {"type": "subtitle", "time": 3096.95, "timestamp": "00:51:36", "text": "はい、3行しかないと思います"}, {"type": "subtitle", "time": 3099.75, "timestamp": "00:51:39", "text": "このページを左に"}, {"type": "subtitle", "time": 3101.829, "timestamp": "00:51:41", "text": "このページの一番下にあります。だから、私は"}, {"type": "subtitle", "time": 3105.109, "timestamp": "00:51:45", "text": "もう一枚新しいページを引き出せると思うよ。"}, {"type": "subtitle", "time": 3108.549, "timestamp": "00:51:48", "text": "ここに書く代わりに。待って、"}, {"type": "subtitle", "time": 3112.23, "timestamp": "00:51:52", "text": "こちらはそれほどではないようです。性欲は"}, {"type": "subtitle", "time": 3117.51, "timestamp": "00:51:57", "text": "1、2行の短いフレーズのようなもの。できますか"}, {"type": "subtitle", "time": 3119.67, "timestamp": "00:51:59", "text": "作る？書いてもいいですか？いいえ、私はしません"}]
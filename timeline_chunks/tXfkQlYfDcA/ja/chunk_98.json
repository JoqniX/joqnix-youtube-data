[{"type": "subtitle", "time": 5883.75, "timestamp": "01:38:03", "text": "完成までには時間がかかるだろうが、それでも"}, {"type": "subtitle", "time": 5887.51, "timestamp": "01:38:07", "text": "終わったら、私は自由になれる。私は"}, {"type": "subtitle", "time": 5890.87, "timestamp": "01:38:10", "text": "無料。私は"}, {"type": "subtitle", "time": 5893.189, "timestamp": "01:38:13", "text": "この拷問から解放され、"}, {"type": "subtitle", "time": 5895.189, "timestamp": "01:38:15", "text": "この地獄、"}, {"type": "subtitle", "time": 5903.75, "timestamp": "01:38:23", "text": "でも、私は戦うよ"}, {"type": "subtitle", "time": 5905.91, "timestamp": "01:38:25", "text": "私は最善を尽くし、最後まで戦い抜く"}, {"type": "subtitle", "time": 5908.87, "timestamp": "01:38:28", "text": "自由は訪れる。ええ、ベストを尽くします。"}, {"type": "subtitle", "time": 5911.109, "timestamp": "01:38:31", "text": "それは2、3、または2、さらに2、または"}, {"type": "subtitle", "time": 5913.99, "timestamp": "01:38:33", "text": "今週はあと３回か３回配信します。"}, {"type": "subtitle", "time": 5918.07, "timestamp": "01:38:38", "text": "これは、この課題のスピードアップのようなものです。"}, {"type": "subtitle", "time": 5919.59, "timestamp": "01:38:39", "text": "うん、"}, {"type": "subtitle", "time": 5923.35, "timestamp": "01:38:43", "text": "4つの質問。 1つ提出してください。さあ行こう。"}, {"type": "subtitle", "time": 5926.87, "timestamp": "01:38:46", "text": "私は"}, {"type": "subtitle", "time": 5928.79, "timestamp": "01:38:48", "text": "遠隔。"}, {"type": "subtitle", "time": 5930.33, "timestamp": "01:38:50", "text": "念のため確認させてください。"}]
[{"type": "subtitle", "time": 7320.629, "timestamp": "02:02:00", "text": "横になって文章を書いたらどうなる？"}, {"type": "subtitle", "time": 7322.39, "timestamp": "02:02:02", "text": "私が"}, {"type": "subtitle", "time": 7324.47, "timestamp": "02:02:04", "text": "横になっている。私はただ見上げるしかない"}, {"type": "subtitle", "time": 7326.07, "timestamp": "02:02:06", "text": "モニターのことですよね？そして、そのまま続けてください。"}, {"type": "subtitle", "time": 7329.189, "timestamp": "02:02:09", "text": "書き込み。マイクを机の下に置くか、"}, {"type": "subtitle", "time": 7333.75, "timestamp": "02:02:13", "text": "スピーカーの近くで、"}, {"type": "subtitle", "time": 7337.669, "timestamp": "02:02:17", "text": "だから、私の声が聞こえるようにしているんです。それを試してみましょう。"}, {"type": "subtitle", "time": 7339.43, "timestamp": "02:02:19", "text": "待って、"}, {"type": "subtitle", "time": 7341.75, "timestamp": "02:02:21", "text": "私も少しだけ滑り降りてもいいですか？"}, {"type": "subtitle", "time": 7346.79, "timestamp": "02:02:26", "text": "キーボードを動かして"}, {"type": "subtitle", "time": 7349.109, "timestamp": "02:02:29", "text": "すべて。このスペースをもっと広く"}, {"type": "subtitle", "time": 7363.83, "timestamp": "02:02:43", "text": "何てことだ。ちょっと気まずいね。奇妙な。"}, {"type": "subtitle", "time": 7367.75, "timestamp": "02:02:47", "text": "うん、すごく辛いよ。"}, {"type": "subtitle", "time": 7369.75, "timestamp": "02:02:49", "text": "マイクの感度を上げます。"}, {"type": "subtitle", "time": 7374.47, "timestamp": "02:02:54", "text": "頭の上にあるマイクを大きくしてください。"}, {"type": "subtitle", "time": 7377.83, "timestamp": "02:02:57", "text": "聞こえますか？それが問題だ。"}]
[{"type": "subtitle", "time": 11700.95, "timestamp": "03:15:00", "text": "右。あなたも同じように感じませんか？"}, {"type": "subtitle", "time": 11703.83, "timestamp": "03:15:03", "text": "音楽を作るのが好きですか、それともアートをするのが好きですか？"}, {"type": "subtitle", "time": 11705.91, "timestamp": "03:15:05", "text": "最後は「えっ？」って感じ。"}, {"type": "subtitle", "time": 11708.07, "timestamp": "03:15:08", "text": "こんにちは？"}, {"type": "subtitle", "time": 11709.75, "timestamp": "03:15:09", "text": "一体どうしてこんなことが起きたのか？どうしてこうなったのか"}, {"type": "subtitle", "time": 11711.11, "timestamp": "03:15:11", "text": "一緒になるのか？"}, {"type": "subtitle", "time": 11714.9, "timestamp": "03:15:14", "text": "うん、あの感覚は本当に気持ちいいよ。"}, {"type": "subtitle", "time": 11716.71, "timestamp": "03:15:16", "text": "[音楽]"}, {"type": "subtitle", "time": 11720.309, "timestamp": "03:15:20", "text": "私は、私が思うに、"}, {"type": "subtitle", "time": 11722.469, "timestamp": "03:15:22", "text": "あなたのモデルはあなたの"}, {"type": "subtitle", "time": 11725.83, "timestamp": "03:15:25", "text": "クリエーションは、大きな"}, {"type": "subtitle", "time": 11730.389, "timestamp": "03:15:30", "text": "休暇中のユーチューバーですよね？ああ、そうですね。"}, {"type": "subtitle", "time": 11733.349, "timestamp": "03:15:33", "text": "うん。私はこう思った"}, {"type": "subtitle", "time": 11736.63, "timestamp": "03:15:36", "text": "正真正銘の狂人だ。何？どこで"}, {"type": "subtitle", "time": 11739.67, "timestamp": "03:15:39", "text": "どこから来たの？ええ、それは"}, {"type": "subtitle", "time": 11741.83, "timestamp": "03:15:41", "text": "彼女が描いた落書きのようなもの"}, {"type": "subtitle", "time": 11743.75, "timestamp": "03:15:43", "text": "川の流れの後を想像してみてください。まるで"}, {"type": "subtitle", "time": 11745.99, "timestamp": "03:15:45", "text": "足の長いオリー"}, {"type": "subtitle", "time": 11748.87, "timestamp": "03:15:48", "text": "そして私は「ああ、そうだ、それはとてもそうだ」と思った。"}, {"type": "subtitle", "time": 11750.469, "timestamp": "03:15:50", "text": "ちょうどいい具合にバカバカしくて"}, {"type": "subtitle", "time": 11752.71, "timestamp": "03:15:52", "text": "ふざけて、私は「うん、鞭打てるよ」って感じだった"}, {"type": "subtitle", "time": 11754.95, "timestamp": "03:15:54", "text": "数小節でこれをアップして"}, {"type": "subtitle", "time": 11757.11, "timestamp": "03:15:57", "text": "それから、私はこう思いながら投稿しました。"}, {"type": "subtitle", "time": 11759.11, "timestamp": "03:15:59", "text": "数人が楽しめるかもしれない"}]
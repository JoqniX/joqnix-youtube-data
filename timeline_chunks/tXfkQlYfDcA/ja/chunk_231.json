[{"type": "subtitle", "time": 13860.389, "timestamp": "03:51:00", "text": "日本のユーチューバー間の架け橋を築く"}, {"type": "subtitle", "time": 13862.469, "timestamp": "03:51:02", "text": "そしてユーチューバーなど、"}, {"type": "subtitle", "time": 13866.469, "timestamp": "03:51:06", "text": "簡単に共同作業ができる、そうでしょう？ JPとケン"}, {"type": "subtitle", "time": 13868.87, "timestamp": "03:51:08", "text": "などなど。だから、もし私が全部連れて行ったら"}, {"type": "subtitle", "time": 13871.59, "timestamp": "03:51:11", "text": "一緒に大きなイベントか何かをして"}, {"type": "subtitle", "time": 13874.229, "timestamp": "03:51:14", "text": "彼らは交流することもできるし、"}, {"type": "subtitle", "time": 13876.15, "timestamp": "03:51:16", "text": "彼らにとって良い機会となるでしょう"}, {"type": "subtitle", "time": 13878.469, "timestamp": "03:51:18", "text": "同じような考えを持つ新しい人々と出会う。それは有益です"}, {"type": "subtitle", "time": 13881.189, "timestamp": "03:51:21", "text": "両端ともそうですよね？だから私は"}, {"type": "subtitle", "time": 13883.429, "timestamp": "03:51:23", "text": "考えていたのですが、私は"}, {"type": "subtitle", "time": 13885.83, "timestamp": "03:51:25", "text": "地域社会に多大な貢献をした。私は"}, {"type": "subtitle", "time": 13888.63, "timestamp": "03:51:28", "text": "もしかしたら、これをやってみようかな。"}, {"type": "subtitle", "time": 13890.389, "timestamp": "03:51:30", "text": "よくもそんなことが言えますね。それを取ります"}, {"type": "subtitle", "time": 13894.07, "timestamp": "03:51:34", "text": "今すぐ戻ってきました。何してるの？"}, {"type": "subtitle", "time": 13896.95, "timestamp": "03:51:36", "text": "あなたはとても貢献しました、まるで"}, {"type": "subtitle", "time": 13899.189, "timestamp": "03:51:39", "text": "たくさんの人が集まっている。あなたはまるで"}, {"type": "subtitle", "time": 13902.15, "timestamp": "03:51:42", "text": "狂ってる、巨大な集団、ほら、"}, {"type": "subtitle", "time": 13904.469, "timestamp": "03:51:44", "text": "人々を巻き込もうとしている"}, {"type": "subtitle", "time": 13906.469, "timestamp": "03:51:46", "text": "地域社会で、それぞれに関わっています"}, {"type": "subtitle", "time": 13909.75, "timestamp": "03:51:49", "text": "他の。新しい人と知り合おうとしているんです"}, {"type": "subtitle", "time": 13912.79, "timestamp": "03:51:52", "text": "それは途方もない量の仕事だ。しないで"}, {"type": "subtitle", "time": 13914.63, "timestamp": "03:51:54", "text": "よくもまあ。自分を危険にさらすな"}, {"type": "subtitle", "time": 13917.67, "timestamp": "03:51:57", "text": "下。ぶちのめしてやる。あなたに"}]
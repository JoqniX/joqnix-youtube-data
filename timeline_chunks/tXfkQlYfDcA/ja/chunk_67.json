[{"type": "subtitle", "time": 4020.23, "timestamp": "01:07:00", "text": "何か、"}, {"type": "subtitle", "time": 4026.309, "timestamp": "01:07:06", "text": "例えば、そう、たくさんある"}, {"type": "subtitle", "time": 4029.829, "timestamp": "01:07:09", "text": "休日の。ああ、そうなるだろう"}, {"type": "subtitle", "time": 4032.23, "timestamp": "01:07:12", "text": "12月のクリスマス休暇は"}, {"type": "subtitle", "time": 4034.63, "timestamp": "01:07:14", "text": "おそらく1週間でしょう。"}, {"type": "subtitle", "time": 4037.109, "timestamp": "01:07:17", "text": "うん。 1週間くらいかな。時々"}, {"type": "subtitle", "time": 4039.91, "timestamp": "01:07:19", "text": "1週間以上。うん。"}, {"type": "subtitle", "time": 4042.549, "timestamp": "01:07:22", "text": "2週間くらいかな。うん。それから"}, {"type": "subtitle", "time": 4048.95, "timestamp": "01:07:28", "text": "ほかに何か？"}, {"type": "subtitle", "time": 4053.029, "timestamp": "01:07:33", "text": "すると、お祭りのようなことが起こるでしょう"}, {"type": "subtitle", "time": 4054.95, "timestamp": "01:07:34", "text": "祝祭期間中。そうなるだろう"}, {"type": "subtitle", "time": 4058.15, "timestamp": "01:07:38", "text": "1日か2日を休日にするようなものです。私"}, {"type": "subtitle", "time": 4060.63, "timestamp": "01:07:40", "text": "推測"}, {"type": "subtitle", "time": 4063.349, "timestamp": "01:07:43", "text": "モデルを忘れてしまった。うん。の"}, {"type": "subtitle", "time": 4068.87, "timestamp": "01:07:48", "text": "これで全てだと思います。私はしません"}, {"type": "subtitle", "time": 4070.71, "timestamp": "01:07:50", "text": "知る。たくさんあります"}, {"type": "subtitle", "time": 4073.74, "timestamp": "01:07:53", "text": "休日。はい。はい。"}, {"type": "subtitle", "time": 4076.309, "timestamp": "01:07:56", "text": "[音楽]"}, {"type": "subtitle", "time": 4079.109, "timestamp": "01:07:59", "text": "お祭りや"}]
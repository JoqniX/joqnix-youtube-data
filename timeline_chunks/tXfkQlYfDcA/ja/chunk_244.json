[{"type": "subtitle", "time": 14642.71, "timestamp": "04:04:02", "text": "そして配信も全部やる。何？"}, {"type": "subtitle", "time": 14646.309, "timestamp": "04:04:06", "text": "うん。停電が発生した場合、"}, {"type": "subtitle", "time": 14650.71, "timestamp": "04:04:10", "text": "リモートで電源を入れることはできますか？"}, {"type": "subtitle", "time": 14653.269, "timestamp": "04:04:13", "text": "もし私が家にいるなら、Wi-Fi経由で"}, {"type": "subtitle", "time": 14655.51, "timestamp": "04:04:15", "text": "それは可能です。もし私がそうでないなら、それは"}, {"type": "subtitle", "time": 14657.91, "timestamp": "04:04:17", "text": "問題はあるが、大丈夫だ。そうだよ"}, {"type": "subtitle", "time": 14659.83, "timestamp": "04:04:19", "text": "自動的に最初にオンになります"}, {"type": "subtitle", "time": 14662.309, "timestamp": "04:04:22", "text": "ブートアップはすべてのチェックです"}, {"type": "subtitle", "time": 14664.15, "timestamp": "04:04:24", "text": "実行に必要なアプリケーション"}, {"type": "subtitle", "time": 14667.349, "timestamp": "04:04:27", "text": "ストリームボットそれらのすべて、それから"}, {"type": "subtitle", "time": 14671.349, "timestamp": "04:04:31", "text": "1分後にOBSを起動して、それからええ"}, {"type": "subtitle", "time": 14674.79, "timestamp": "04:04:34", "text": "すべてはそう、それからストリームが始まります"}, {"type": "subtitle", "time": 14679.11, "timestamp": "04:04:39", "text": "えーっと、VAみたいなやつで"}, {"type": "subtitle", "time": 14680.95, "timestamp": "04:04:40", "text": "それが今の私の状況です"}, {"type": "subtitle", "time": 14682.63, "timestamp": "04:04:42", "text": "ビームストリームを使えば"}, {"type": "subtitle", "time": 14685.59, "timestamp": "04:04:45", "text": "マルチリームフィードを制御する"}, {"type": "subtitle", "time": 14687.67, "timestamp": "04:04:47", "text": "YouTubeのフィードが停止しました。再接続できます"}, {"type": "subtitle", "time": 14690.309, "timestamp": "04:04:50", "text": "それとかそういう類。それを変えなさい。あなた"}, {"type": "subtitle", "time": 14692.15, "timestamp": "04:04:52", "text": "全てを再起動する必要はありません。"}, {"type": "subtitle", "time": 14694.309, "timestamp": "04:04:54", "text": "右？はい。再起動する必要はありません"}, {"type": "subtitle", "time": 14699.59, "timestamp": "04:04:59", "text": "もの。大きなチャンスがたくさんあった。"}]
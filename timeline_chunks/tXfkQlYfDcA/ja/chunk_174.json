[{"type": "subtitle", "time": 10441.51, "timestamp": "02:54:01", "text": "忘れてください。でも、でも、私は"}, {"type": "subtitle", "time": 10444.55, "timestamp": "02:54:04", "text": "そう、アーティストは一生懸命働いたんだ。私も"}, {"type": "subtitle", "time": 10447.349, "timestamp": "02:54:07", "text": "この複合施設を建設するために懸命に努力しました"}, {"type": "subtitle", "time": 10450.469, "timestamp": "02:54:10", "text": "複雑な問題だ。"}, {"type": "subtitle", "time": 10452.07, "timestamp": "02:54:12", "text": "うん。私は、"}, {"type": "subtitle", "time": 10454.309, "timestamp": "02:54:14", "text": "もう手放すべきだ。それはまた"}, {"type": "subtitle", "time": 10456.15, "timestamp": "02:54:16", "text": "もしこれがうまくいかなかったら"}, {"type": "subtitle", "time": 10457.91, "timestamp": "02:54:17", "text": "常に選択肢がある"}, {"type": "subtitle", "time": 10460.15, "timestamp": "02:54:20", "text": "パートタイムや"}, {"type": "subtitle", "time": 10461.75, "timestamp": "02:54:21", "text": "ほら、考えてみてよ"}, {"type": "subtitle", "time": 10464.469, "timestamp": "02:54:24", "text": "ストリーミング配信などを続ける"}, {"type": "subtitle", "time": 10467.269, "timestamp": "02:54:27", "text": "最終的にはうまくいくと思うけど"}, {"type": "subtitle", "time": 10469.59, "timestamp": "02:54:29", "text": "もう一度、特定の"}, {"type": "subtitle", "time": 10471.99, "timestamp": "02:54:31", "text": "締め切りのように、あなたが守りたいもの、または"}, {"type": "subtitle", "time": 10474.389, "timestamp": "02:54:34", "text": "のんびりしたいですか？私は"}, {"type": "subtitle", "time": 10477.03, "timestamp": "02:54:37", "text": "ゆっくり過ごしたいな。うん、"}, {"type": "subtitle", "time": 10481.11, "timestamp": "02:54:41", "text": "だって、えーと、だって、何も"}, {"type": "subtitle", "time": 10483.269, "timestamp": "02:54:43", "text": "起こる、"}, {"type": "subtitle", "time": 10486.95, "timestamp": "02:54:46", "text": "どう言えばいいかな？えっと"}, {"type": "subtitle", "time": 10491.349, "timestamp": "02:54:51", "text": "少なくとも返済できる限りは"}, {"type": "subtitle", "time": 10494.23, "timestamp": "02:54:54", "text": "えーと、少なくとも返済して、"}, {"type": "subtitle", "time": 10497.19, "timestamp": "02:54:57", "text": "自分のリギング用品の資金も調達するために"}]
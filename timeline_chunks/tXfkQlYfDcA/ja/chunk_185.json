[{"type": "subtitle", "time": 11100.79, "timestamp": "03:05:00", "text": "最初のショットをアップロードしたら、"}, {"type": "subtitle", "time": 11103.429, "timestamp": "03:05:03", "text": "少し自信があれば大丈夫です"}, {"type": "subtitle", "time": 11106.63, "timestamp": "03:05:06", "text": "完全に編集されていない、または未編集、または何か"}, {"type": "subtitle", "time": 11108.71, "timestamp": "03:05:08", "text": "それから、すべての動画クリップをアップロードし始めます。"}, {"type": "subtitle", "time": 11111.11, "timestamp": "03:05:11", "text": "YouTubeやTwitchで活動している人々。始める"}, {"type": "subtitle", "time": 11115.19, "timestamp": "03:05:15", "text": "それをアップロードして、ゆっくりと私は"}, {"type": "subtitle", "time": 11118.55, "timestamp": "03:05:18", "text": "ああ、もっと自信を持って、そして"}, {"type": "subtitle", "time": 11120.469, "timestamp": "03:05:20", "text": "人々がどのように生活しているかを知る"}, {"type": "subtitle", "time": 11122.15, "timestamp": "03:05:22", "text": "ストリーミング配信して、"}, {"type": "subtitle", "time": 11124.469, "timestamp": "03:05:24", "text": "ビデオ。"}, {"type": "subtitle", "time": 11126.23, "timestamp": "03:05:26", "text": "うん。うん。私はそれを試みました"}, {"type": "subtitle", "time": 11128.23, "timestamp": "03:05:28", "text": "それを試してみて、それがどうなるか見てみましょう"}, {"type": "subtitle", "time": 11131.83, "timestamp": "03:05:31", "text": "ビデオを録画しているから、私は"}, {"type": "subtitle", "time": 11134.309, "timestamp": "03:05:34", "text": "多すぎるくらい。たくさんください"}, {"type": "subtitle", "time": 11137.51, "timestamp": "03:05:37", "text": "テイクワン、ツー、スリーのようなカット。しかし"}, {"type": "subtitle", "time": 11139.59, "timestamp": "03:05:39", "text": "生放送の時は、何が起こるかわからない"}, {"type": "subtitle", "time": 11141.75, "timestamp": "03:05:41", "text": "起こる。ほとんどの場合、私はそれを手に入れます"}, {"type": "subtitle", "time": 11143.91, "timestamp": "03:05:43", "text": "最初のテイクで、"}, {"type": "subtitle", "time": 11147.19, "timestamp": "03:05:47", "text": "生々しい感情って感じですよね？そして私は感じた"}, {"type": "subtitle", "time": 11149.269, "timestamp": "03:05:49", "text": "そうすればもっと良くなるだろうし、私は"}, {"type": "subtitle", "time": 11151.83, "timestamp": "03:05:51", "text": "動画を1本アップロードして、どうなるか見てみましょう。"}, {"type": "subtitle", "time": 11155.11, "timestamp": "03:05:55", "text": "そして私はそれをして幸せを感じたし、"}, {"type": "subtitle", "time": 11157.11, "timestamp": "03:05:57", "text": "うん、そんな感じ。そのビデオはどうでしたか？"}]
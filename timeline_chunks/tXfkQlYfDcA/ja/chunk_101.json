[{"type": "subtitle", "time": 6064.149, "timestamp": "01:41:04", "text": "はぁ？"}, {"type": "subtitle", "time": 6067.109, "timestamp": "01:41:07", "text": "ああ、サウンドボードを使えばいいよ。メンバーに許可する"}, {"type": "subtitle", "time": 6069.109, "timestamp": "01:41:09", "text": "サーバーサウンドボードから曲を送信"}, {"type": "subtitle", "time": 6072.629, "timestamp": "01:41:12", "text": "この音声チャンネル。もっと詳しく知る。"}, {"type": "subtitle", "time": 6074.229, "timestamp": "01:41:14", "text": "サウンドボード 10日前。これ"}, {"type": "subtitle", "time": 6077.27, "timestamp": "01:41:17", "text": "実験的な機能はプレイと"}, {"type": "subtitle", "time": 6079.43, "timestamp": "01:41:19", "text": "管理する um はまだ限られています"}, {"type": "subtitle", "time": 6082.229, "timestamp": "01:41:22", "text": "より多くのコミュニティのために。あなたは"}, {"type": "subtitle", "time": 6083.669, "timestamp": "01:41:23", "text": "再生された音を聞くことができる"}, {"type": "subtitle", "time": 6085.99, "timestamp": "01:41:25", "text": "サウンドボード。わかった。とは"}, {"type": "subtitle", "time": 6087.27, "timestamp": "01:41:27", "text": "サウンドボード？サウンドボードは声です"}, {"type": "subtitle", "time": 6088.709, "timestamp": "01:41:28", "text": "再生できるチャンネル機能"}, {"type": "subtitle", "time": 6090.709, "timestamp": "01:41:30", "text": "聞くことができる短い音声クリップ"}, {"type": "subtitle", "time": 6092.79, "timestamp": "01:41:32", "text": "参加者全員が同じ声で"}, {"type": "subtitle", "time": 6094.95, "timestamp": "01:41:34", "text": "チャネル。"}, {"type": "subtitle", "time": 6097.59, "timestamp": "01:41:37", "text": "わかった。わかった。これは興味深い。あなたはできる"}, {"type": "subtitle", "time": 6101.27, "timestamp": "01:41:41", "text": "自分のサーバーを使用する サーバー所有者"}, {"type": "subtitle", "time": 6104.55, "timestamp": "01:41:44", "text": "またはサーバーモデレーターがアップロードできます"}, {"type": "subtitle", "time": 6107.91, "timestamp": "01:41:47", "text": "独自のサウンドをアップロードできます"}, {"type": "subtitle", "time": 6111.27, "timestamp": "01:41:51", "text": "追加するメンバー。わかった。それはつまり"}, {"type": "subtitle", "time": 6115.59, "timestamp": "01:41:55", "text": "エクシアで入手できますか？私たちもそれを受け取ったのでしょうか？"}, {"type": "subtitle", "time": 6119.51, "timestamp": "01:41:59", "text": "録音するように言ってください。"}]
[{"type": "subtitle", "time": 4200.709, "timestamp": "01:10:00", "text": "次は日本。はい、どうぞ。"}, {"type": "subtitle", "time": 4209.11, "timestamp": "01:10:09", "text": "ああ、とても明るいですね。私は書いていた"}, {"type": "subtitle", "time": 4213.27, "timestamp": "01:10:13", "text": "全体的に見て、まあ、そういうことなんです"}, {"type": "subtitle", "time": 4215.59, "timestamp": "01:10:15", "text": "他のペンは生きようと奮闘していた"}, {"type": "subtitle", "time": 4220.07, "timestamp": "01:10:20", "text": "もっとよく知ると、実際はもっと軽かったのですが"}, {"type": "subtitle", "time": 4223.189, "timestamp": "01:10:23", "text": "わあ、すごく明るいね。わかった。どこで"}, {"type": "subtitle", "time": 4226.709, "timestamp": "01:10:26", "text": "終わり？えっと"}, {"type": "subtitle", "time": 4229.92, "timestamp": "01:10:29", "text": "年齢猫"}, {"type": "subtitle", "time": 4235.189, "timestamp": "01:10:35", "text": "[音楽]"}, {"type": "subtitle", "time": 4254.19, "timestamp": "01:10:54", "text": "定義済み。そして"}, {"type": "subtitle", "time": 4255.83, "timestamp": "01:10:55", "text": "[音楽]"}, {"type": "subtitle", "time": 4257.02, "timestamp": "01:10:57", "text": "そして"}, {"type": "subtitle", "time": 4258.79, "timestamp": "01:10:58", "text": "[音楽]"}]
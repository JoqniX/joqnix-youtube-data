[{"type": "subtitle", "time": 4801.43, "timestamp": "01:20:01", "text": "髪をアイロンがけし続けたが、"}, {"type": "subtitle", "time": 4803.669, "timestamp": "01:20:03", "text": "サプリメントとは、何もないようなものを意味します。"}, {"type": "subtitle", "time": 4807.35, "timestamp": "01:20:07", "text": "えーっと、ストレートヘア保護みたいな"}, {"type": "subtitle", "time": 4810.229, "timestamp": "01:20:10", "text": "クリームでも何でも。私はアイロンがけを続けた"}, {"type": "subtitle", "time": 4813.75, "timestamp": "01:20:13", "text": "まさにそのように直接的に。私はただ"}, {"type": "subtitle", "time": 4816.149, "timestamp": "01:20:16", "text": "それを1年くらい続けて、"}, {"type": "subtitle", "time": 4819.51, "timestamp": "01:20:19", "text": "今、私の髪の構造は失われてしまった。まるで"}, {"type": "subtitle", "time": 4824.149, "timestamp": "01:20:24", "text": "えっと、すごく痛くて、擦り傷みたいな感じ"}, {"type": "subtitle", "time": 4826.63, "timestamp": "01:20:26", "text": "私はたくさんのことを経験しなければならない"}, {"type": "subtitle", "time": 4829.189, "timestamp": "01:20:29", "text": "髪を元の状態に戻すためのヘアトリートメント用品"}, {"type": "subtitle", "time": 4847.43, "timestamp": "01:20:47", "text": "うん。今でも私の構造は"}, {"type": "subtitle", "time": 4851.27, "timestamp": "01:20:51", "text": "この壊れたメッシュ。たくさんやらなければならなかった"}, {"type": "subtitle", "time": 4854.95, "timestamp": "01:20:54", "text": "いつかは暗黒面を見つけることになるだろう。"}, {"type": "subtitle", "time": 4858.07, "timestamp": "01:20:58", "text": "うん。彼がそれを好まないのは分かります。私"}]
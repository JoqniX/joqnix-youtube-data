[{"type": "subtitle", "time": 4205.03, "timestamp": "01:10:05", "text": "ええ、彼らは死んでいます。 ありがとう。   はい"}, {"type": "subtitle", "time": 4207.91, "timestamp": "01:10:07", "text": "、ありがとうございます。"}, {"type": "subtitle", "time": 4210.07, "timestamp": "01:10:10", "text": "治ったと思う。 おお。"}, {"type": "subtitle", "time": 4211.51, "timestamp": "01:10:11", "text": "彼はたった10馬力だった。"}, {"type": "subtitle", "time": 4213.35, "timestamp": "01:10:13", "text": "調子はどうだい？ 真面目な話は"}, {"type": "subtitle", "time": 4216.63, "timestamp": "01:10:16", "text": "良かった。 順調に進んでいます。 今日はまるで新"}, {"type": "subtitle", "time": 4221.91, "timestamp": "01:10:21", "text": "安市のような日だった。 えーと、それは、えーと、さまざまな"}, {"type": "subtitle", "time": 4225.99, "timestamp": "01:10:25", "text": "大学の"}, {"type": "subtitle", "time": 4228.47, "timestamp": "01:10:28", "text": "代表者や、"}, {"type": "subtitle", "time": 4230.63, "timestamp": "01:10:30", "text": "職業訓練校の代表者のようなサンガコが来るイベントで、"}, {"type": "subtitle", "time": 4234.39, "timestamp": "01:10:34", "text": "誰がそう言ったのですか? えっと、"}, {"type": "subtitle", "time": 4237.99, "timestamp": "01:10:37", "text": "試験とか、入学試験とか、"}, {"type": "subtitle", "time": 4239.83, "timestamp": "01:10:39", "text": "学生が大学に入学することに興味があるとか、そういう話をするんですよね。"}, {"type": "subtitle", "time": 4243.27, "timestamp": "01:10:43", "text": "私はそれがすごく"}, {"type": "subtitle", "time": 4246.07, "timestamp": "01:10:46", "text": "便利でいいと思うし、"}, {"type": "subtitle", "time": 4249.03, "timestamp": "01:10:49", "text": "1年生で今は"}, {"type": "subtitle", "time": 4250.229, "timestamp": "01:10:50", "text": "2年生なんですけど、"}, {"type": "subtitle", "time": 4258.63, "timestamp": "01:10:58", "text": "私には"}]
[{"type": "subtitle", "time": 5882.47, "timestamp": "01:38:02", "text": "皮を剥ぐ作業はほぼゼロです。"}, {"type": "subtitle", "time": 5883.189, "timestamp": "01:38:03", "text": "うんうん。"}, {"type": "subtitle", "time": 5884.629, "timestamp": "01:38:04", "text": "友達のアカウントでプレイしているので、私のアカウントでは"}, {"type": "subtitle", "time": 5886.95, "timestamp": "01:38:06", "text": "ないんです。"}, {"type": "subtitle", "time": 5891.91, "timestamp": "01:38:11", "text": "よし、捕まえたぞ。"}, {"type": "subtitle", "time": 5892.79, "timestamp": "01:38:12", "text": "私はただ黙っているだけです。   何てことだ"}, {"type": "subtitle", "time": 5914.629, "timestamp": "01:38:34", "text": "あ、ありがとう。"}, {"type": "subtitle", "time": 5923.91, "timestamp": "01:38:43", "text": "残る敵の一人ということになる。"}, {"type": "subtitle", "time": 5926.39, "timestamp": "01:38:46", "text": "ああ、ラグは左側から来るものですね"}, {"type": "subtitle", "time": 5927.91, "timestamp": "01:38:47", "text": "。"}, {"type": "subtitle", "time": 5934.79, "timestamp": "01:38:54", "text": "ああ、私はダメだ。"}, {"type": "subtitle", "time": 5935.75, "timestamp": "01:38:55", "text": "最後のプレイヤー。"}, {"type": "subtitle", "time": 5937.75, "timestamp": "01:38:57", "text": "私はダメな人間だ。 待って。 これを勝ち取れ。"}, {"type": "subtitle", "time": 5939.51, "timestamp": "01:38:59", "text": "K. カイリーがこれらを勝ち取ります。 カイリーがこれらを勝ち取る。   わかった"}]
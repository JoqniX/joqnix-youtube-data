[{"type": "subtitle", "time": 2711.51, "timestamp": "00:45:11", "text": "ああ、誰かいたよ。"}, {"type": "subtitle", "time": 2712.15, "timestamp": "00:45:12", "text": "敵は一人。"}, {"type": "subtitle", "time": 2715.43, "timestamp": "00:45:15", "text": "私は、私が乗り越えたことを乗り越えたのだろうか？"}, {"type": "subtitle", "time": 2718.63, "timestamp": "00:45:18", "text": "ええ、見ましたよ。 それを見たよ。  「え、"}, {"type": "subtitle", "time": 2720.23, "timestamp": "00:45:20", "text": "どうやってやったの？」って感じでした。"}, {"type": "subtitle", "time": 2724.309, "timestamp": "00:45:24", "text": "あのラグはひどかったね？   わかった"}, {"type": "subtitle", "time": 2726.79, "timestamp": "00:45:26", "text": "。 彼は店を閉めようとしていたのに、それでもその店の前を"}, {"type": "subtitle", "time": 2728.39, "timestamp": "00:45:28", "text": "通り過ぎた。   とんでも"}, {"type": "subtitle", "time": 2730.79, "timestamp": "00:45:30", "text": "ない。 ああ、くそ。"}, {"type": "subtitle", "time": 2732.39, "timestamp": "00:45:32", "text": "どこですか？"}, {"type": "subtitle", "time": 2738.87, "timestamp": "00:45:38", "text": "ああ、彼はただ「"}, {"type": "subtitle", "time": 2741.43, "timestamp": "00:45:41", "text": "この男を倒してやる」と見ているだけだ。 この"}, {"type": "subtitle", "time": 2741.99, "timestamp": "00:45:41", "text": "男を倒させてくれ。"}, {"type": "subtitle", "time": 2749.43, "timestamp": "00:45:49", "text": "いいえ。"}, {"type": "subtitle", "time": 2756.39, "timestamp": "00:45:56", "text": "大丈夫。 私はジョーを信じている。 たとえ"}, {"type": "subtitle", "time": 2757.99, "timestamp": "00:45:57", "text": "ジョーが生きていても、彼女は勝つだろう。"}]
[{"type": "subtitle", "time": 8040.39, "timestamp": "02:14:00", "text": "え、何？ あ、"}, {"type": "subtitle", "time": 8042.87, "timestamp": "02:14:02", "text": "ちなみに140だよ。 ちなみに、140です。"}, {"type": "subtitle", "time": 8050.87, "timestamp": "02:14:10", "text": "待って、ゲーム中に私の声が聞こえますか？"}, {"type": "subtitle", "time": 8053.35, "timestamp": "02:14:13", "text": "私の場合、それは私があなたをミュートしたからではありません。   そうそう"}, {"type": "subtitle", "time": 8055.27, "timestamp": "02:14:15", "text": "。 うん。"}, {"type": "subtitle", "time": 8057.83, "timestamp": "02:14:17", "text": "パーティーの話をしているんだ。"}, {"type": "subtitle", "time": 8060.47, "timestamp": "02:14:20", "text": "うん。"}, {"type": "subtitle", "time": 8069.589, "timestamp": "02:14:29", "text": "皆さん、わかりました。 私も出かけます。 私も"}, {"type": "subtitle", "time": 8071.03, "timestamp": "02:14:31", "text": "昼食を買いに行きます。 お腹が空きました"}, {"type": "subtitle", "time": 8072.069, "timestamp": "02:14:32", "text": "。   わかった"}, {"type": "subtitle", "time": 8077.99, "timestamp": "02:14:37", "text": "さよなら。 気をつけて。 時間とゲームをありがとうございました"}, {"type": "subtitle", "time": 8080.229, "timestamp": "02:14:40", "text": "。 すごく楽しかった。"}, {"type": "subtitle", "time": 8082.629, "timestamp": "02:14:42", "text": "また一緒に遊んでくれるのを楽しみにしています。 あなたは恐らく"}, {"type": "subtitle", "time": 8084.629, "timestamp": "02:14:44", "text": "聞いていないでしょう。 またね。 バイバイ。   気をつけて"}, {"type": "subtitle", "time": 8085.75, "timestamp": "02:14:45", "text": "。"}, {"type": "subtitle", "time": 8088.709, "timestamp": "02:14:48", "text": "バイバイ。"}]
[{"type": "subtitle", "time": 7652.39, "timestamp": "02:07:32", "text": "敵はあと一体。 おお。   何てことだ"}, {"type": "subtitle", "time": 7653.27, "timestamp": "02:07:33", "text": "。"}, {"type": "subtitle", "time": 7656.069, "timestamp": "02:07:36", "text": "ああ、信じられない。"}, {"type": "subtitle", "time": 7659.35, "timestamp": "02:07:39", "text": "文字通り狂ってる。"}, {"type": "subtitle", "time": 7668.87, "timestamp": "02:07:48", "text": "おお。 おお。 おお。 おお。 おお。 おお。 私が台無しにしてしまった。 私が"}, {"type": "subtitle", "time": 7669.83, "timestamp": "02:07:49", "text": "台無しにしてしまった。 私のミスです。"}, {"type": "subtitle", "time": 7672.87, "timestamp": "02:07:52", "text": "おお、いいね。 ニース。 ああ、マジでヤバいよ。   さあ行こう"}, {"type": "subtitle", "time": 7673.83, "timestamp": "02:07:53", "text": "。"}, {"type": "subtitle", "time": 7675.35, "timestamp": "02:07:55", "text": "最高だったよ、兄弟。"}, {"type": "subtitle", "time": 7677.669, "timestamp": "02:07:57", "text": "そんな感じ。 無料です。"}, {"type": "subtitle", "time": 7678.95, "timestamp": "02:07:58", "text": "素晴らしい。   それでも"}]
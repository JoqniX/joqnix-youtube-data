[{"type": "subtitle", "time": 6480.07, "timestamp": "01:48:00", "text": "冗談みたいだ。"}, {"type": "subtitle", "time": 6481.75, "timestamp": "01:48:01", "text": "うん。 うん。"}, {"type": "subtitle", "time": 6490.229, "timestamp": "01:48:10", "text": "私もトレーニングコースを進む必要がある。"}, {"type": "subtitle", "time": 6493.83, "timestamp": "01:48:13", "text": "昨日、ゲームをインストールしました。"}, {"type": "subtitle", "time": 6497.109, "timestamp": "01:48:17", "text": "ああ、なんてこった。 何てことだ。"}, {"type": "subtitle", "time": 6498.07, "timestamp": "01:48:18", "text": "その場所は、"}, {"type": "subtitle", "time": 6501.75, "timestamp": "01:48:21", "text": "ああ、なんてことだ。 ああ、そうだよ。"}, {"type": "subtitle", "time": 6503.59, "timestamp": "01:48:23", "text": "昨日ダウンロードして、それで"}, {"type": "subtitle", "time": 6506.31, "timestamp": "01:48:26", "text": "プレイしたんだ。 くそ。"}, {"type": "subtitle", "time": 6509.03, "timestamp": "01:48:29", "text": "彼が1ヶ月間"}, {"type": "subtitle", "time": 6511.27, "timestamp": "01:48:31", "text": "ずっとプレイし、その後、彼は"}, {"type": "subtitle", "time": 6514.629, "timestamp": "01:48:34", "text": "実際には輝いていて、実際に、"}, {"type": "subtitle", "time": 6518.39, "timestamp": "01:48:38", "text": "ああ、小さな人々、私は"}, {"type": "subtitle", "time": 6519.35, "timestamp": "01:48:39", "text": "心配します、と言うだけです。"}, {"type": "subtitle", "time": 6521.91, "timestamp": "01:48:41", "text": "ああ、神様、"}, {"type": "subtitle", "time": 6525.51, "timestamp": "01:48:45", "text": "私たちを見下ろしてください。"}, {"type": "subtitle", "time": 6527.43, "timestamp": "01:48:47", "text": "彼がそれをしないのはそのためだと思います。"}, {"type": "subtitle", "time": 6529.27, "timestamp": "01:48:49", "text": "彼は謙遜している。"}, {"type": "subtitle", "time": 6531.59, "timestamp": "01:48:51", "text": "ああ、彼はそうだ"}, {"type": "subtitle", "time": 6533.43, "timestamp": "01:48:53", "text": "。 彼は謙虚すぎるんだよ、兄弟。 彼は"}, {"type": "subtitle", "time": 6534.07, "timestamp": "01:48:54", "text": "謙虚すぎる。"}]
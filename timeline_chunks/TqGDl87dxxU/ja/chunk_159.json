[{"type": "subtitle", "time": 9541.59, "timestamp": "02:39:01", "text": "技術的な面ではあなたは私とは違うレベルにいるけれど、一体何を"}, {"type": "subtitle", "time": 9549.349, "timestamp": "02:39:09", "text": "ええ、昨日もそのことについて話しましたよ。"}, {"type": "subtitle", "time": 9552.87, "timestamp": "02:39:12", "text": "技術的なことは本当に"}, {"type": "subtitle", "time": 9557.75, "timestamp": "02:39:17", "text": "面倒くさい。 だから、Cloudflare の自動イベントや自動アナウンスなどの Discord の"}, {"type": "subtitle", "time": 9559.51, "timestamp": "02:39:19", "text": "自動化が機能しているのは嬉しいのですが、まだ"}, {"type": "chat", "time": 9566.926, "timestamp": "02:39:26", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "mhm"}, {"type": "subtitle", "time": 9571.83, "timestamp": "02:39:31", "text": "修正しなければならないことがたくさんあります"}, {"type": "subtitle", "time": 9576.15, "timestamp": "02:39:36", "text": "。 うん。   まあ、でも、"}, {"type": "subtitle", "time": 9580.55, "timestamp": "02:39:40", "text": "時間をかけてやっていきますよ。"}, {"type": "subtitle", "time": 9583.349, "timestamp": "02:39:43", "text": "時間。"}, {"type": "subtitle", "time": 9586.389, "timestamp": "02:39:46", "text": "私は、自分の"}, {"type": "subtitle", "time": 9592.55, "timestamp": "02:39:52", "text": "時間を有効に使うように心がけ続けます。"}, {"type": "subtitle", "time": 9595.19, "timestamp": "02:39:55", "text": "こんにちは。 でも、私の性格はご存知でしょうから、"}, {"type": "subtitle", "time": 9596.79, "timestamp": "02:39:56", "text": "少し時間がかかると思います。"}, {"type": "subtitle", "time": 9599.11, "timestamp": "02:39:59", "text": "何かを考えたら、必ず実行します。 それが"}]
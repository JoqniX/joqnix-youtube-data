[{"type": "subtitle", "time": 361.27, "timestamp": "00:06:01", "text": "聞こえる？"}, {"type": "subtitle", "time": 362.95, "timestamp": "00:06:02", "text": "音声はありますか？   聞こえますか"}, {"type": "subtitle", "time": 364.15, "timestamp": "00:06:04", "text": "？"}, {"type": "subtitle", "time": 372.309, "timestamp": "00:06:12", "text": "はい、はい、はい、はい、はい。 ニース。   まず最初に"}, {"type": "subtitle", "time": 374.55, "timestamp": "00:06:14", "text": "、これが"}, {"type": "subtitle", "time": 377.43, "timestamp": "00:06:17", "text": "私の最初の配信であり、デスクトップ"}, {"type": "subtitle", "time": 381.749, "timestamp": "00:06:21", "text": "配信であり、"}, {"type": "subtitle", "time": 384.87, "timestamp": "00:06:24", "text": "今日"}, {"type": "chat", "time": 387.032, "timestamp": "00:06:27", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "hi"}, {"type": "subtitle", "time": 387.35, "timestamp": "00:06:27", "text": "ここにいる多くのクリエイターとのコラボレーション配信であることをお伝えしたいと思います。 ええと、新しい顔ぶれもいれば、"}, {"type": "subtitle", "time": 391.83, "timestamp": "00:06:31", "text": "過去にコラボレーションしたことのある人もいます。 そう、全部"}, {"type": "subtitle", "time": 394.629, "timestamp": "00:06:34", "text": "インド人の私です。 というわけで、良い"}, {"type": "subtitle", "time": 398.629, "timestamp": "00:06:38", "text": "一日をお過ごしください。 皆さんのリンクは、"}, {"type": "subtitle", "time": 403.11, "timestamp": "00:06:43", "text": "YouTubeの説明欄にあります。 えーと、"}, {"type": "subtitle", "time": 406.23, "timestamp": "00:06:46", "text": "Twitchとかやってる人向けだけど、"}, {"type": "subtitle", "time": 408.55, "timestamp": "00:06:48", "text": "今日Twitchで配信してる人がいるかどうかはわからないけど"}, {"type": "subtitle", "time": 412.55, "timestamp": "00:06:52", "text": "、YouTubeにアップしてね。 えっと、"}, {"type": "subtitle", "time": 415.189, "timestamp": "00:06:55", "text": "説明欄に記載されています。 わかりました、"}, {"type": "subtitle", "time": 418.23, "timestamp": "00:06:58", "text": "チャットに入力してみます。  1秒。"}]
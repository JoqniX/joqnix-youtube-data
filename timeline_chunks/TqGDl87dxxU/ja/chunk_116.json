[{"type": "subtitle", "time": 6960.39, "timestamp": "01:56:00", "text": "よし、"}, {"type": "subtitle", "time": 6962.149, "timestamp": "01:56:02", "text": "プレイ方法がわからない別のエージェントを使ってみよう」と思って、そのエージェントでブリッジを取ったら、"}, {"type": "subtitle", "time": 6971.51, "timestamp": "01:56:11", "text": "同じ試合でサンセットをもらったんです。 ええ、あれは一種の"}, {"type": "subtitle", "time": 6973.43, "timestamp": "01:56:13", "text": "不具合でしたね。 彼らは違反行為を認めているように見せかけたが、"}, {"type": "subtitle", "time": 6977.03, "timestamp": "01:56:17", "text": "実際には代わりに日没を与えたのだ"}, {"type": "subtitle", "time": 6979.43, "timestamp": "01:56:19", "text": "。"}, {"type": "subtitle", "time": 6982.149, "timestamp": "01:56:22", "text": "奇妙な不具合だった。 わからない。 すぐ戻ります"}, {"type": "subtitle", "time": 6985.189, "timestamp": "01:56:25", "text": "。 ちょっとトイレに行ってきます"}, {"type": "subtitle", "time": 6995.589, "timestamp": "01:56:35", "text": "。  1秒。   はい"}, {"type": "subtitle", "time": 6997.109, "timestamp": "01:56:37", "text": "、戻ってきました。"}, {"type": "subtitle", "time": 7000.149, "timestamp": "01:56:40", "text": "あれはつまらなかった。   びっくりしたよ、"}, {"type": "subtitle", "time": 7002.47, "timestamp": "01:56:42", "text": "誰かが"}, {"type": "subtitle", "time": 7004.79, "timestamp": "01:56:44", "text": "外から窓をノックしているのかと思った。   何てことだ"}, {"type": "subtitle", "time": 7006.629, "timestamp": "01:56:46", "text": "。 何てことだ。"}, {"type": "subtitle", "time": 7010.07, "timestamp": "01:56:50", "text": "確認する必要があった。 速報。"}, {"type": "subtitle", "time": 7013.35, "timestamp": "01:56:53", "text": "大丈夫だよ、兄弟。 まだ確認が必要です。"}, {"type": "subtitle", "time": 7015.83, "timestamp": "01:56:55", "text": "うん。 少なくとも私は誰にも会えなかった。   ほら"}, {"type": "subtitle", "time": 7017.91, "timestamp": "01:56:57", "text": "、夜中に"}, {"type": "subtitle", "time": 7018.79, "timestamp": "01:56:58", "text": "物音が聞こえたら、"}]
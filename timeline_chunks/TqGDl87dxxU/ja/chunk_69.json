[{"type": "subtitle", "time": 4143.11, "timestamp": "01:09:03", "text": "ああ、なんてことだ、あの盾があの男を守っていたんだ"}, {"type": "subtitle", "time": 4149.59, "timestamp": "01:09:09", "text": "彼は一体なぜそんなことをしているのだろうか？"}, {"type": "subtitle", "time": 4152.789, "timestamp": "01:09:12", "text": "そして、そこには壁がある。   さあ行こう"}, {"type": "subtitle", "time": 4154.789, "timestamp": "01:09:14", "text": "。 さあ行こう。 カイラー、二人とも"}, {"type": "subtitle", "time": 4156.95, "timestamp": "01:09:16", "text": "壁の向こう側にいるよ。"}, {"type": "subtitle", "time": 4158.47, "timestamp": "01:09:18", "text": "待って、カイド、私と一緒に来て。 私と来て。"}, {"type": "subtitle", "time": 4159.51, "timestamp": "01:09:19", "text": "ここ。 ここ。 ここに来て。 ここに来て。 ここに来て"}, {"type": "subtitle", "time": 4161.11, "timestamp": "01:09:21", "text": "。 カイド、来い。 ここに来て。"}, {"type": "subtitle", "time": 4162.39, "timestamp": "01:09:22", "text": "うん。 うん。   わかった"}, {"type": "subtitle", "time": 4166.07, "timestamp": "01:09:26", "text": "。 えーと、ここへ行って、長押ししてください"}, {"type": "subtitle", "time": 4177.349, "timestamp": "01:09:37", "text": "。 ジョー、"}, {"type": "subtitle", "time": 4189.99, "timestamp": "01:09:49", "text": "彼を捕まえさせてください。 彼を捕まえさせてください。"}, {"type": "subtitle", "time": 4195.75, "timestamp": "01:09:55", "text": "ああ、くそ。   あの"}, {"type": "subtitle", "time": 4197.75, "timestamp": "01:09:57", "text": "野郎が、"}]
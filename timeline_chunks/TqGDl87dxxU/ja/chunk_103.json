[{"type": "subtitle", "time": 6180.55, "timestamp": "01:43:00", "text": "あなたは私が自閉症だと言っていたのですか？"}, {"type": "subtitle", "time": 6184.31, "timestamp": "01:43:04", "text": "いいえ、自閉症ではありません。 私は「ええ、そうですね、"}, {"type": "subtitle", "time": 6185.99, "timestamp": "01:43:05", "text": "耳鳴りがしていますね」と言いました。 耳鳴りがしているようですね"}, {"type": "subtitle", "time": 6187.75, "timestamp": "01:43:07", "text": "。   うんうん"}, {"type": "subtitle", "time": 6188.87, "timestamp": "01:43:08", "text": "。 うんうん。   うんうん"}, {"type": "subtitle", "time": 6189.669, "timestamp": "01:43:09", "text": "。 うんうん。"}, {"type": "subtitle", "time": 6195.28, "timestamp": "01:43:15", "text": "。 ニース。"}, {"type": "subtitle", "time": 6203.51, "timestamp": "01:43:23", "text": "彼らは戻る。   何てことだ"}, {"type": "subtitle", "time": 6215.27, "timestamp": "01:43:35", "text": "だって、実際に"}, {"type": "subtitle", "time": 6216.47, "timestamp": "01:43:36", "text": "植えたり、植えたり、植えたり、"}, {"type": "subtitle", "time": 6223.27, "timestamp": "01:43:43", "text": "私はここから出て行く。"}, {"type": "subtitle", "time": 6226.87, "timestamp": "01:43:46", "text": "おお。 おお。 おお。 いいもの。"}, {"type": "subtitle", "time": 6228.55, "timestamp": "01:43:48", "text": "ああ、彼はここにいたんだ。 立っている。"}, {"type": "subtitle", "time": 6232.55, "timestamp": "01:43:52", "text": "おお。 おお。 おお。 おお。 アンティ。  ent."}]
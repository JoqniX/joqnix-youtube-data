[{"type": "subtitle", "time": 6549.51, "timestamp": "01:49:09", "text": "続きを話すの？   わからない"}, {"type": "subtitle", "time": 6552.31, "timestamp": "01:49:12", "text": "。 終わらせることもできるけど、"}, {"type": "subtitle", "time": 6554.229, "timestamp": "01:49:14", "text": "これが私が"}, {"type": "subtitle", "time": 6556.55, "timestamp": "01:49:16", "text": "プレイできる唯一の時間だから、もう少しプレイしたい。"}, {"type": "subtitle", "time": 6557.59, "timestamp": "01:49:17", "text": "うん。 うん。"}, {"type": "subtitle", "time": 6560.95, "timestamp": "01:49:20", "text": "ああ、わかりました。 そうすれば遊べるよ。   私たちと"}, {"type": "subtitle", "time": 6562.149, "timestamp": "01:49:22", "text": "一緒にプレイしたいですか？それとも"}, {"type": "subtitle", "time": 6564.149, "timestamp": "01:49:24", "text": "一人でプレイしたいですか？ ああ、"}, {"type": "subtitle", "time": 6566.229, "timestamp": "01:49:26", "text": "君たちが気が向いたら一緒に遊ぼうよ。 私は自由だ。"}, {"type": "subtitle", "time": 6568.229, "timestamp": "01:49:28", "text": "夕食は食べましたか？ えっと、夕食じゃなくて、"}, {"type": "subtitle", "time": 6569.83, "timestamp": "01:49:29", "text": "昼食です。"}, {"type": "subtitle", "time": 6573.669, "timestamp": "01:49:33", "text": "私はしていません。 でも、後でやります。"}, {"type": "subtitle", "time": 6576.229, "timestamp": "01:49:36", "text": "私はしていません。 でも今はただぶらぶらしているだけです"}, {"type": "subtitle", "time": 6577.83, "timestamp": "01:49:37", "text": "。   たとえ"}, {"type": "subtitle", "time": 6579.99, "timestamp": "01:49:39", "text": "横道に逸れてやったとしても、ただ"}, {"type": "subtitle", "time": 6582.229, "timestamp": "01:49:42", "text": "喋り続けるだけだろう。"}, {"type": "subtitle", "time": 6585.75, "timestamp": "01:49:45", "text": "うん、試験があるんだ。"}, {"type": "subtitle", "time": 6587.109, "timestamp": "01:49:47", "text": "何？"}, {"type": "subtitle", "time": 6587.51, "timestamp": "01:49:47", "text": "うん。   何てことだ"}, {"type": "subtitle", "time": 6589.35, "timestamp": "01:49:49", "text": "。 ではごきげんよう。   私にとっては"}, {"type": "subtitle", "time": 6591.59, "timestamp": "01:49:51", "text": "素晴らしい試験なのに、私は"}, {"type": "subtitle", "time": 6594.47, "timestamp": "01:49:54", "text": "勉強しない。 なぜ？ わからない。"}, {"type": "subtitle", "time": 6598.47, "timestamp": "01:49:58", "text": "私はただ、パンを1つだけ食べただけです。   なんてこった。"}]
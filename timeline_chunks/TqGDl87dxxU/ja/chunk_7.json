[{"type": "subtitle", "time": 421.67, "timestamp": "00:07:01", "text": "わかりました。招待しなければならないものは何ですか？"}, {"type": "subtitle", "time": 438.71, "timestamp": "00:07:18", "text": "少ししたらミュートを解除する必要があります。 はい、少々お待ちください"}, {"type": "subtitle", "time": 440.23, "timestamp": "00:07:20", "text": "。 私はこれをスピードランでやっています。"}, {"type": "subtitle", "time": 443.43, "timestamp": "00:07:23", "text": "こんにちは、アディサさん。 こんにちは、忘れっぽい人。 いらっしゃいませ。"}, {"type": "subtitle", "time": 445.36, "timestamp": "00:07:25", "text": "いらっしゃいませ。 ええ、そうですね"}, {"type": "subtitle", "time": 455.83, "timestamp": "00:07:35", "text": "。 えっと"}, {"type": "subtitle", "time": 460.79, "timestamp": "00:07:40", "text": "、今日はコラボ配信です。 えっと、"}, {"type": "subtitle", "time": 465.749, "timestamp": "00:07:45", "text": "チャットはあまり読めないと思いますが、"}]
[{"type": "subtitle", "time": 2164.31, "timestamp": "00:36:04", "text": "おいおい、兄弟。 ではごきげんよう。   何てことだ"}, {"type": "subtitle", "time": 2165.43, "timestamp": "00:36:05", "text": "。"}, {"type": "subtitle", "time": 2167.67, "timestamp": "00:36:07", "text": "一発でいいんだよ、兄弟。 弾丸は一発だけでよかったんだよ"}, {"type": "subtitle", "time": 2169.109, "timestamp": "00:36:09", "text": "、兄弟。"}, {"type": "subtitle", "time": 2170.55, "timestamp": "00:36:10", "text": "顔写真。   何てことだ"}, {"type": "subtitle", "time": 2171.27, "timestamp": "00:36:11", "text": "。"}, {"type": "subtitle", "time": 2172.23, "timestamp": "00:36:12", "text": "ヘッド・ショット。"}, {"type": "subtitle", "time": 2174.47, "timestamp": "00:36:14", "text": "それで、私のシステムは"}, {"type": "subtitle", "time": 2175.51, "timestamp": "00:36:15", "text": "勝手にシャットダウンしてしまったんです。"}, {"type": "subtitle", "time": 2176.31, "timestamp": "00:36:16", "text": "はぁ？   うーん、"}, {"type": "subtitle", "time": 2187.91, "timestamp": "00:36:27", "text": "では、私が…なので、私たちは何をするつもりですか？"}, {"type": "subtitle", "time": 2189.349, "timestamp": "00:36:29", "text": "ああ、私たちは何もするつもりはありません。 私たちはただ、"}, {"type": "subtitle", "time": 2194.55, "timestamp": "00:36:34", "text": "そう、ただそれをそのままにしておくだけです。"}, {"type": "subtitle", "time": 2196.63, "timestamp": "00:36:36", "text": "あなたは再接続できますよね？"}, {"type": "subtitle", "time": 2198.069, "timestamp": "00:36:38", "text": "うん。 ええ、できますよ。 できます。 今行ってる。"}, {"type": "subtitle", "time": 2199.27, "timestamp": "00:36:39", "text": "近日公開。"}, {"type": "subtitle", "time": 2199.589, "timestamp": "00:36:39", "text": "うん。"}, {"type": "subtitle", "time": 2201.67, "timestamp": "00:36:41", "text": "pingの問題はありません。   それは"}, {"type": "subtitle", "time": 2208.39, "timestamp": "00:36:48", "text": "ええ、pingが出ています。"}, {"type": "subtitle", "time": 2214.31, "timestamp": "00:36:54", "text": "ピング値170。  156 ping。 ピング値100。   わかった"}, {"type": "subtitle", "time": 2214.79, "timestamp": "00:36:54", "text": "。"}, {"type": "subtitle", "time": 2216.63, "timestamp": "00:36:56", "text": "彼らはまたそこにいるのか？"}]
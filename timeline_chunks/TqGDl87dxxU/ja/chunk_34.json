[{"type": "subtitle", "time": 2050.069, "timestamp": "00:34:10", "text": "私はチャイを食べます。 私はチャイなしでは生きていけない。   ご"}, {"type": "chat", "time": 2050.79, "timestamp": "00:34:10", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "Daamn playing valo"}, {"type": "subtitle", "time": 2052.23, "timestamp": "00:34:12", "text": "指摘ありがとうございます。 私は"}, {"type": "subtitle", "time": 2055.349, "timestamp": "00:34:15", "text": "ここでコーヒーを飲んだだけで、お酒は飲んでいません。 とても"}, {"type": "subtitle", "time": 2056.869, "timestamp": "00:34:16", "text": "寒い。"}, {"type": "subtitle", "time": 2058.31, "timestamp": "00:34:18", "text": "おお。   いっそのこと"}, {"type": "subtitle", "time": 2060.23, "timestamp": "00:34:20", "text": "氷を入れて、"}, {"type": "subtitle", "time": 2061.27, "timestamp": "00:34:21", "text": "冷たいコーヒーを飲んだ方がいいんじゃないか。"}, {"type": "subtitle", "time": 2067.109, "timestamp": "00:34:27", "text": "アイスクリームを入れてしまえばいいのに"}, {"type": "subtitle", "time": 2077.19, "timestamp": "00:34:37", "text": "それはどう発音するのですか？"}, {"type": "subtitle", "time": 2078.71, "timestamp": "00:34:38", "text": "カビスかな。"}, {"type": "subtitle", "time": 2079.99, "timestamp": "00:34:39", "text": "Yを押してみてください。"}, {"type": "subtitle", "time": 2080.869, "timestamp": "00:34:40", "text": "どう発音しますか？"}, {"type": "subtitle", "time": 2083.109, "timestamp": "00:34:43", "text": "Y。"}, {"type": "subtitle", "time": 2087.349, "timestamp": "00:34:47", "text": "まさにそのように発音します。"}, {"type": "subtitle", "time": 2089.909, "timestamp": "00:34:49", "text": "Yキーを押してみてください。キーがキーに割り当てられています"}, {"type": "subtitle", "time": 2093.51, "timestamp": "00:34:53", "text": "。  Yはヤード（庭）のY。"}, {"type": "subtitle", "time": 2095.19, "timestamp": "00:34:55", "text": "うん、プレイしてるよ。"}]
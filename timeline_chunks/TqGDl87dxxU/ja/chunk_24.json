[{"type": "subtitle", "time": 1455.43, "timestamp": "00:24:15", "text": "待って。 うん。 私も聞こえません。"}, {"type": "subtitle", "time": 1469.35, "timestamp": "00:24:29", "text": "ああ、私は何をしたんだろう？"}, {"type": "subtitle", "time": 1472.31, "timestamp": "00:24:32", "text": "ああ、なんてこった。"}, {"type": "subtitle", "time": 1473.669, "timestamp": "00:24:33", "text": "ああ、なんてことだ、"}, {"type": "subtitle", "time": 1475.99, "timestamp": "00:24:35", "text": "私はただ走っただけだ。"}, {"type": "subtitle", "time": 1478.31, "timestamp": "00:24:38", "text": "これが"}, {"type": "subtitle", "time": 1480.07, "timestamp": "00:24:40", "text": "最後の敵だったことを忘れていた。"}, {"type": "subtitle", "time": 1482.47, "timestamp": "00:24:42", "text": "ああ、くそ。 ああ、これは大丈夫だ"}, {"type": "subtitle", "time": 1489.59, "timestamp": "00:24:49", "text": "待って。"}, {"type": "subtitle", "time": 1493.669, "timestamp": "00:24:53", "text": "おお、いいね。"}, {"type": "subtitle", "time": 1497.43, "timestamp": "00:24:57", "text": "ああ、なんてことだ。 わかった。 わかった。 あれこそ"}]
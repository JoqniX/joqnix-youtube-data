[{"type": "subtitle", "time": 4381.03, "timestamp": "01:13:01", "text": "ああ、何が見えるの？ 待って。 いや、"}, {"type": "subtitle", "time": 4383.59, "timestamp": "01:13:03", "text": "もう少し待ってくれ。"}, {"type": "subtitle", "time": 4386.47, "timestamp": "01:13:06", "text": "次のラウンドは私が勝ちます。 うんうん。 うんうん。"}, {"type": "subtitle", "time": 4389.51, "timestamp": "01:13:09", "text": "いいよ、君にあげるよ。"}, {"type": "subtitle", "time": 4392.47, "timestamp": "01:13:12", "text": "そして私は、私は、私は、"}, {"type": "subtitle", "time": 4396.87, "timestamp": "01:13:16", "text": "なぜできないのですか？"}, {"type": "subtitle", "time": 4420.63, "timestamp": "01:13:40", "text": "ああ、ここに植えて、ここに来て"}, {"type": "subtitle", "time": 4421.59, "timestamp": "01:13:41", "text": "押して、"}]
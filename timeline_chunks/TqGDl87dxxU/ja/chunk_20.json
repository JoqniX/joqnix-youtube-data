[{"type": "subtitle", "time": 1200.31, "timestamp": "00:20:00", "text": "パンが来て全部準備してくれたから、"}, {"type": "subtitle", "time": 1203.35, "timestamp": "00:20:03", "text": "ええ、始めたんです。 うん。 うん。"}, {"type": "subtitle", "time": 1205.35, "timestamp": "00:20:05", "text": "一緒に楽しい時間を過ごせるといいですね。   わかった"}, {"type": "subtitle", "time": 1206.95, "timestamp": "00:20:06", "text": "。"}, {"type": "subtitle", "time": 1209.27, "timestamp": "00:20:09", "text": "ぜひ"}, {"type": "subtitle", "time": 1212.15, "timestamp": "00:20:12", "text": "KaidasanとSuryakunの配信をフォローして応援してください。お"}, {"type": "subtitle", "time": 1213.75, "timestamp": "00:20:13", "text": "二人とも"}, {"type": "subtitle", "time": 1216.63, "timestamp": "00:20:16", "text": "今日配信中です。 ええ、どうぞご自由にご覧ください"}, {"type": "subtitle", "time": 1220.39, "timestamp": "00:20:20", "text": "。 彼らを応援しよう。"}, {"type": "subtitle", "time": 1225.029, "timestamp": "00:20:25", "text": "今日は楽しい一日になりそうだ。 わかった。 では"}, {"type": "subtitle", "time": 1227.43, "timestamp": "00:20:27", "text": "、皆さん揃っていますか？ はい、到着しました"}, {"type": "subtitle", "time": 1229.99, "timestamp": "00:20:29", "text": "。 ニース。   わかった"}, {"type": "subtitle", "time": 1233.43, "timestamp": "00:20:33", "text": "。 こんにちは、"}, {"type": "subtitle", "time": 1241.43, "timestamp": "00:20:41", "text": "こんにちは。 ああ、設定するのを忘れてた。 わかった。 こんにちは。   さあ行こう"}, {"type": "subtitle", "time": 1249.35, "timestamp": "00:20:49", "text": "、じゃあ、どのサーバーを選べばいいんだっけ"}, {"type": "subtitle", "time": 1254.789, "timestamp": "00:20:54", "text": "ああ、シンガポールを滅ぼすこともできる。"}, {"type": "subtitle", "time": 1257.029, "timestamp": "00:20:57", "text": "キス・シンガポール。 わかった。 こんにちは。"}, {"type": "subtitle", "time": 1258.95, "timestamp": "00:20:58", "text": "うん。"}]
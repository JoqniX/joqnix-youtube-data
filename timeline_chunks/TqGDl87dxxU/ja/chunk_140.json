[{"type": "subtitle", "time": 8411.19, "timestamp": "02:20:11", "text": "それでおしまい。"}, {"type": "subtitle", "time": 8416.15, "timestamp": "02:20:16", "text": "敵はあと一体。"}, {"type": "subtitle", "time": 8426.309, "timestamp": "02:20:26", "text": "ここ。"}, {"type": "subtitle", "time": 8433.03, "timestamp": "02:20:33", "text": "それで、彼はどこにいるの？"}, {"type": "subtitle", "time": 8435.83, "timestamp": "02:20:35", "text": "彼のことは全く知らない。 あ、そこだ。   そこには"}, {"type": "subtitle", "time": 8441.59, "timestamp": "02:20:41", "text": "あれが彼らの最高傑作だった。"}, {"type": "subtitle", "time": 8444.23, "timestamp": "02:20:44", "text": "感心しなかった。"}, {"type": "subtitle", "time": 8459.19, "timestamp": "02:20:59", "text": "あ、待って。 ええと、この"}]
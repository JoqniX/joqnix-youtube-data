[{"type": "subtitle", "time": 7947.99, "timestamp": "02:12:27", "text": "彼はあなたの後ろにいました。"}, {"type": "subtitle", "time": 7950.629, "timestamp": "02:12:30", "text": "彼はどうやって背後に回り込んだのか？"}, {"type": "subtitle", "time": 7952.39, "timestamp": "02:12:32", "text": "私は当然知っている？ 私も彼がここで先頭にいると思っていました"}, {"type": "subtitle", "time": 7960.95, "timestamp": "02:12:40", "text": "。"}]
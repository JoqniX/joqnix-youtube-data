[{"type": "subtitle", "time": 1113.99, "timestamp": "00:18:33", "text": "ああ、神様。 招待状は届きましたか？"}, {"type": "subtitle", "time": 1116.549, "timestamp": "00:18:36", "text": "ええ、そう思います。"}, {"type": "subtitle", "time": 1116.95, "timestamp": "00:18:36", "text": "待って。"}, {"type": "subtitle", "time": 1117.909, "timestamp": "00:18:37", "text": "あ、"}, {"type": "subtitle", "time": 1120.39, "timestamp": "00:18:40", "text": "待って。 香港で試合ができると思う。"}, {"type": "subtitle", "time": 1122.39, "timestamp": "00:18:42", "text": "私はここにいます。"}, {"type": "subtitle", "time": 1123.51, "timestamp": "00:18:43", "text": "うん。 わかった。 待って。   で"}, {"type": "subtitle", "time": 1126.07, "timestamp": "00:18:46", "text": "。"}, {"type": "subtitle", "time": 1127.59, "timestamp": "00:18:47", "text": "うん。   少々お待ちください"}, {"type": "subtitle", "time": 1130.07, "timestamp": "00:18:50", "text": "。"}]
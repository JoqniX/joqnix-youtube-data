[{"type": "subtitle", "time": 5221.59, "timestamp": "01:27:01", "text": "毎回"}, {"type": "subtitle", "time": 5225.83, "timestamp": "01:27:05", "text": "システムが彼らがAFKであると伝え続けることになります。"}, {"type": "subtitle", "time": 5231.91, "timestamp": "01:27:11", "text": "おい、実際はここまでひどくはなかったぞ。"}, {"type": "subtitle", "time": 5243.35, "timestamp": "01:27:23", "text": "ああ、どうやって私は生き延びたんだろう？"}, {"type": "subtitle", "time": 5252.47, "timestamp": "01:27:32", "text": "ああ、ごめんよ"}, {"type": "subtitle", "time": 5253.75, "timestamp": "01:27:33", "text": "、兄弟。"}, {"type": "subtitle", "time": 5255.59, "timestamp": "01:27:35", "text": "エース。 ああ、エースが手に入らない。   何てことだ"}, {"type": "subtitle", "time": 5258.709, "timestamp": "01:27:38", "text": "。 よし、行こう。 さあ行こう。 行くよ。"}, {"type": "subtitle", "time": 5261.669, "timestamp": "01:27:41", "text": "どこ？ どこ？ どこ？ どこ？"}, {"type": "subtitle", "time": 5262.95, "timestamp": "01:27:42", "text": "ここ。 ここ。   降りてきてください"}, {"type": "subtitle", "time": 5265.27, "timestamp": "01:27:45", "text": "。 私の目の前で冗談を言う。"}, {"type": "subtitle", "time": 5266.629, "timestamp": "01:27:46", "text": "どこ？   来て"}, {"type": "subtitle", "time": 5268.31, "timestamp": "01:27:48", "text": "。 ジョーク。 ジョーク。 ジョーク。 うん。"}, {"type": "subtitle", "time": 5269.59, "timestamp": "01:27:49", "text": "どこ？ 待って。"}, {"type": "subtitle", "time": 5270.07, "timestamp": "01:27:50", "text": "私は待ちます"}, {"type": "subtitle", "time": 5271.43, "timestamp": "01:27:51", "text": "。 待って。 背後から破壊してやる"}, {"type": "subtitle", "time": 5272.95, "timestamp": "01:27:52", "text": "。"}]
[{"type": "subtitle", "time": 4520.149, "timestamp": "01:15:20", "text": "ああ、彼らは中堅レベルだ。"}, {"type": "subtitle", "time": 4522.39, "timestamp": "01:15:22", "text": "彼らは中位ですか？"}, {"type": "subtitle", "time": 4523.189, "timestamp": "01:15:23", "text": "彼らです。"}, {"type": "subtitle", "time": 4529.99, "timestamp": "01:15:29", "text": "ああ、なんてことだ、私はとても落ち込んでいる。"}, {"type": "subtitle", "time": 4531.03, "timestamp": "01:15:31", "text": "ああ、こっちへ来てください。 ここに来て。 ここに来て。   ここに"}, {"type": "subtitle", "time": 4533.35, "timestamp": "01:15:33", "text": "来て。 ここに来て。"}, {"type": "subtitle", "time": 4534.87, "timestamp": "01:15:34", "text": "行け！行け！行け。"}, {"type": "subtitle", "time": 4535.75, "timestamp": "01:15:35", "text": "こちらです。 こちらです。"}, {"type": "subtitle", "time": 4538.07, "timestamp": "01:15:38", "text": "ここへ行ってください。"}, {"type": "subtitle", "time": 4539.59, "timestamp": "01:15:39", "text": "ああ、ああ、なんてことだ"}, {"type": "subtitle", "time": 4542.63, "timestamp": "01:15:42", "text": "。 神。 何てことだ。"}, {"type": "subtitle", "time": 4546.07, "timestamp": "01:15:46", "text": "あ、待って。 どうやって？   なんてこった。 なんてこった。"}, {"type": "subtitle", "time": 4548.63, "timestamp": "01:15:48", "text": "私は死にかけている。 何てことだ。   はい"}, {"type": "subtitle", "time": 4550.87, "timestamp": "01:15:50", "text": "、申し訳ありません。 一応送ってみたんだ"}, {"type": "subtitle", "time": 4553.51, "timestamp": "01:15:53", "text": "けど、君なら知ってるかもしれないと思って。 えっと、ああ"}, {"type": "subtitle", "time": 4555.83, "timestamp": "01:15:55", "text": "、いいですね。 マイクを通して癒されることができる。"}, {"type": "subtitle", "time": 4559.27, "timestamp": "01:15:59", "text": "彼らは私たちを煽り立てて死んだ、と私たちは信じています"}]
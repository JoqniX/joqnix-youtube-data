[{"type": "subtitle", "time": 7741.109, "timestamp": "02:09:01", "text": "。"}, {"type": "subtitle", "time": 7742.47, "timestamp": "02:09:02", "text": "うん。 うん。 うん。 はい、できますよ。   ミュートを解除しないでください"}, {"type": "subtitle", "time": 7744.79, "timestamp": "02:09:04", "text": "。 ゲーム内で私のミュートを解除してください。"}, {"type": "subtitle", "time": 7746.87, "timestamp": "02:09:06", "text": "うん。"}, {"type": "subtitle", "time": 7750.95, "timestamp": "02:09:10", "text": "こんにちは。 私も。"}, {"type": "subtitle", "time": 7753.51, "timestamp": "02:09:13", "text": "私は党の立場から発言します。"}, {"type": "subtitle", "time": 7753.83, "timestamp": "02:09:13", "text": "何？"}, {"type": "subtitle", "time": 7755.51, "timestamp": "02:09:15", "text": "うん。 うん。"}, {"type": "subtitle", "time": 7769.75, "timestamp": "02:09:29", "text": "あ、"}, {"type": "subtitle", "time": 7777.75, "timestamp": "02:09:37", "text": "ぶらぶらしているだけです。"}, {"type": "subtitle", "time": 7781.27, "timestamp": "02:09:41", "text": "あ、待って。 ああ、忘れてた。"}, {"type": "subtitle", "time": 7784.229, "timestamp": "02:09:44", "text": "ああ、それも忘れてた。 え、"}, {"type": "subtitle", "time": 7784.87, "timestamp": "02:09:44", "text": "何？ 何？   どうでも。"}, {"type": "subtitle", "time": 7791.43, "timestamp": "02:09:51", "text": "何が起きたのか、なぜ起動しないのか？ すると、"}, {"type": "subtitle", "time": 7794.47, "timestamp": "02:09:54", "text": "自分の家が空っぽになっていることに気づいた。"}]
[{"type": "subtitle", "time": 8280.79, "timestamp": "02:18:00", "text": "再装填中。"}, {"type": "subtitle", "time": 8282.469, "timestamp": "02:18:02", "text": "ありがとう。"}, {"type": "subtitle", "time": 8283.589, "timestamp": "02:18:03", "text": "再装填中。"}, {"type": "subtitle", "time": 8291.27, "timestamp": "02:18:11", "text": "。 再装填してください。"}, {"type": "subtitle", "time": 8292.87, "timestamp": "02:18:12", "text": "よお、俺にヒールをくれ。"}, {"type": "subtitle", "time": 8294.709, "timestamp": "02:18:14", "text": "敵はあと一体。"}, {"type": "subtitle", "time": 8296.95, "timestamp": "02:18:16", "text": "待って、君はどこにいるの？"}, {"type": "subtitle", "time": 8298.87, "timestamp": "02:18:18", "text": "わかった。"}, {"type": "subtitle", "time": 8300.95, "timestamp": "02:18:20", "text": "待って、私がヒール役をやらせてよ。"}, {"type": "subtitle", "time": 8318.07, "timestamp": "02:18:38", "text": "ああ、より"}, {"type": "subtitle", "time": 8321.509, "timestamp": "02:18:41", "text": "長く立っている。 何てことだ。 とんでもない。   私は自分を"}, {"type": "subtitle", "time": 8322.15, "timestamp": "02:18:42", "text": "信じている。   とんでも"}, {"type": "subtitle", "time": 8323.429, "timestamp": "02:18:43", "text": "ない。 君たちが私にそんなことをしたんだ。"}, {"type": "subtitle", "time": 8330.15, "timestamp": "02:18:50", "text": "私は自分自身を信用できない。"}, {"type": "subtitle", "time": 8338.23, "timestamp": "02:18:58", "text": "いいえ、彼は出演していません。 オンではありません。 オンではありません。 オンではありません。"}, {"type": "subtitle", "time": 8338.87, "timestamp": "02:18:58", "text": "行け！行け！行け。"}]
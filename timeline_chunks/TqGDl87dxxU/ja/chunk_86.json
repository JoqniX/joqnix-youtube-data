[{"type": "subtitle", "time": 5160.32, "timestamp": "01:26:00", "text": "よぉ、ジョーがコーナージョークで 大騒ぎしてるよ。"}, {"type": "subtitle", "time": 5161.36, "timestamp": "01:26:01", "text": "大騒ぎしてるよ。 最後に残ったプレイヤー。"}, {"type": "subtitle", "time": 5171.669, "timestamp": "01:26:11", "text": "ああ、もう一人プレイヤーがいるよ。 何てことだ"}, {"type": "subtitle", "time": 5174.149, "timestamp": "01:26:14", "text": "。"}, {"type": "subtitle", "time": 5176.95, "timestamp": "01:26:16", "text": "君ならできるよ、兄弟。   何てことだ"}, {"type": "subtitle", "time": 5177.59, "timestamp": "01:26:17", "text": "。"}, {"type": "subtitle", "time": 5180.149, "timestamp": "01:26:20", "text": "もちろん。 もちろん。 それは私も"}, {"type": "subtitle", "time": 5189.189, "timestamp": "01:26:29", "text": "ああ、戻ってきたんだね。   どうして"}, {"type": "subtitle", "time": 5189.83, "timestamp": "01:26:29", "text": "？"}, {"type": "subtitle", "time": 5191.669, "timestamp": "01:26:31", "text": "どうして俺は戻ってきたんだ？ 俺の全てが"}, {"type": "subtitle", "time": 5192.95, "timestamp": "01:26:32", "text": "停止したんだよ、兄弟。   わかった"}, {"type": "subtitle", "time": 5195.83, "timestamp": "01:26:35", "text": "。 うん。 だから、俺のPCは電源が切れてるんだよ。"}, {"type": "subtitle", "time": 5198.39, "timestamp": "01:26:38", "text": "私のパソコンは電源が切れています。"}, {"type": "subtitle", "time": 5200.629, "timestamp": "01:26:40", "text": "俺は公園に座ってるんだよ、兄弟。 わからない"}, {"type": "subtitle", "time": 5201.59, "timestamp": "01:26:41", "text": "。"}, {"type": "subtitle", "time": 5203.35, "timestamp": "01:26:43", "text": "側面が入れ替わると、まるで"}, {"type": "subtitle", "time": 5208.149, "timestamp": "01:26:48", "text": "背中を向けているような感じになります。"}, {"type": "subtitle", "time": 5208.95, "timestamp": "01:26:48", "text": "うん。"}, {"type": "subtitle", "time": 5210.07, "timestamp": "01:26:50", "text": "ええと、"}, {"type": "subtitle", "time": 5212.47, "timestamp": "01:26:52", "text": "敵に余分なキルを与えてしまうだけです。"}, {"type": "subtitle", "time": 5215.35, "timestamp": "01:26:55", "text": "彼らはそれを自慢したいのです。"}, {"type": "subtitle", "time": 5217.43, "timestamp": "01:26:57", "text": "彼らは、あなたが何らかの方法で禁止措置を取ることを望んでおり、そうすれば"}]
[{"type": "subtitle", "time": 8102.95, "timestamp": "02:15:02", "text": "120人の死者のうちの1人が出ている。"}, {"type": "subtitle", "time": 8127.589, "timestamp": "02:15:27", "text": "こんにちは。"}, {"type": "subtitle", "time": 8130.069, "timestamp": "02:15:30", "text": "スキンを獲得した後。"}, {"type": "subtitle", "time": 8130.95, "timestamp": "02:15:30", "text": "はい。"}, {"type": "subtitle", "time": 8133.83, "timestamp": "02:15:33", "text": "おお。 それが欲しい。 はい、どうぞ。"}, {"type": "subtitle", "time": 8135.27, "timestamp": "02:15:35", "text": "あなたは何が必要ですか？"}, {"type": "subtitle", "time": 8158.87, "timestamp": "02:15:58", "text": "いや、いや、いや、いや。 彼女を連れて行け。"}]
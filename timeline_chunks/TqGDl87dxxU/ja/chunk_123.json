[{"type": "subtitle", "time": 7381.189, "timestamp": "02:03:01", "text": "よぉ、俺はヤバい。 何てことだ。"}, {"type": "subtitle", "time": 7381.91, "timestamp": "02:03:01", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 7385.109, "timestamp": "02:03:05", "text": "ああ、楽しかった。 ああ、77の後ろだ。"}, {"type": "subtitle", "time": 7391.99, "timestamp": "02:03:11", "text": "最後のプレイヤーだ。"}, {"type": "subtitle", "time": 7399.189, "timestamp": "02:03:19", "text": "もしあなたがこれに勝ったら。 いや、もし"}, {"type": "subtitle", "time": 7403.589, "timestamp": "02:03:23", "text": "。"}, {"type": "subtitle", "time": 7404.39, "timestamp": "02:03:24", "text": "敵はあと一体。   何てことだ"}, {"type": "subtitle", "time": 7405.75, "timestamp": "02:03:25", "text": "。"}, {"type": "subtitle", "time": 7408.07, "timestamp": "02:03:28", "text": "1台は遅れるだろう。 はい、どうぞ。   はい"}, {"type": "subtitle", "time": 7410.629, "timestamp": "02:03:30", "text": "、どうぞ。 ああ、"}, {"type": "subtitle", "time": 7411.91, "timestamp": "02:03:31", "text": "これは一体何でしたっけ？   何てことだ"}, {"type": "subtitle", "time": 7416.07, "timestamp": "02:03:36", "text": "。 ああ、壮大な"}, {"type": "subtitle", "time": 7418.55, "timestamp": "02:03:38", "text": "物語だ。   何てことだ"}, {"type": "subtitle", "time": 7424.149, "timestamp": "02:03:44", "text": "これはすごい。"}, {"type": "subtitle", "time": 7426.31, "timestamp": "02:03:46", "text": "私は癒しを必要としている。 いや、"}, {"type": "subtitle", "time": 7434.149, "timestamp": "02:03:54", "text": "彼女は実は私から学んだんです。   わかった"}, {"type": "subtitle", "time": 7436.55, "timestamp": "02:03:56", "text": "。   どうぞお"}, {"type": "subtitle", "time": 7438.229, "timestamp": "02:03:58", "text": "気軽にお話ください。"}, {"type": "subtitle", "time": 7438.87, "timestamp": "02:03:58", "text": "ありがとう。"}]
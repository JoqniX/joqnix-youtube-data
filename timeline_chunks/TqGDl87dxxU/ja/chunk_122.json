[{"type": "subtitle", "time": 7326.629, "timestamp": "02:02:06", "text": "兄弟との最後のラウンド。"}, {"type": "subtitle", "time": 7339.27, "timestamp": "02:02:19", "text": "昼食は何なのか確認させてください。   返してやるよ"}, {"type": "subtitle", "time": 7342.47, "timestamp": "02:02:22", "text": "。"}, {"type": "subtitle", "time": 7354.39, "timestamp": "02:02:34", "text": "先輩、きっと気に入りますよ。 カレー"}, {"type": "subtitle", "time": 7358.629, "timestamp": "02:02:38", "text": "ベースです。 カレーライスです。 知っている。"}, {"type": "subtitle", "time": 7361.27, "timestamp": "02:02:41", "text": "私はカレーライスが大好きです。"}, {"type": "subtitle", "time": 7364.47, "timestamp": "02:02:44", "text": "どのカレーが好きですか？"}, {"type": "subtitle", "time": 7366.07, "timestamp": "02:02:46", "text": "インド版のことですよね"}, {"type": "subtitle", "time": 7371.51, "timestamp": "02:02:51", "text": "そうそう。   見えない"}, {"type": "subtitle", "time": 7372.79, "timestamp": "02:02:52", "text": "。 再読み込みできません。"}, {"type": "subtitle", "time": 7374.39, "timestamp": "02:02:54", "text": "結局、私はそれを彼らにあげました。 いいえ、私は"}]
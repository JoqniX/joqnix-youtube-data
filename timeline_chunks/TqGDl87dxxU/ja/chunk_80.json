[{"type": "subtitle", "time": 4801.189, "timestamp": "01:20:01", "text": "キックチャンネルを忘れないでください。"}, {"type": "subtitle", "time": 4803.03, "timestamp": "01:20:03", "text": "ああ、"}, {"type": "subtitle", "time": 4806.63, "timestamp": "01:20:06", "text": "それについては話さないでおくよね？"}, {"type": "subtitle", "time": 4807.91, "timestamp": "01:20:07", "text": "私は複数の配信を同時に行っています。"}, {"type": "subtitle", "time": 4810.87, "timestamp": "01:20:10", "text": "うん、ラグだね。"}, {"type": "subtitle", "time": 4813.189, "timestamp": "01:20:13", "text": "その通り。 うん。 ええ、そうですね。 ああ、"}, {"type": "subtitle", "time": 4813.99, "timestamp": "01:20:13", "text": "ラグのせいだよ。"}, {"type": "subtitle", "time": 4815.189, "timestamp": "01:20:15", "text": "不具合。 不具合。"}, {"type": "subtitle", "time": 4817.11, "timestamp": "01:20:17", "text": "そうです。 うん。 わかんねえよ、兄弟。 ヴァルの"}, {"type": "subtitle", "time": 4820.31, "timestamp": "01:20:20", "text": "ゲームは変だと思う。   ただの"}, {"type": "subtitle", "time": 4823.03, "timestamp": "01:20:23", "text": "サーバーだと思います。"}, {"type": "subtitle", "time": 4825.27, "timestamp": "01:20:25", "text": "ええ、ムンバイのサーバーはすごく"}, {"type": "subtitle", "time": 4826.39, "timestamp": "01:20:26", "text": "有害ですね。   ああ"}, {"type": "subtitle", "time": 4829.189, "timestamp": "01:20:29", "text": "、いつかはね。"}, {"type": "subtitle", "time": 4831.03, "timestamp": "01:20:31", "text": "ムンバイサーバーのデバフがいつ適用されるのか、よくわからない"}, {"type": "subtitle", "time": 4831.83, "timestamp": "01:20:31", "text": "。"}, {"type": "subtitle", "time": 4834.229, "timestamp": "01:20:34", "text": "うん。 うん。 うん。 私たちはその点で本当に"}, {"type": "subtitle", "time": 4843.43, "timestamp": "01:20:43", "text": "うん。 分かりますか？"}, {"type": "subtitle", "time": 4851.75, "timestamp": "01:20:51", "text": "ええ、そうです。"}, {"type": "subtitle", "time": 4853.43, "timestamp": "01:20:53", "text": "もちろん、私のシュートは当たりません。"}]
[{"type": "subtitle", "time": 6124.95, "timestamp": "01:42:04", "text": "また膝を骨折したのか。 それは幸運だった。"}, {"type": "subtitle", "time": 6127.03, "timestamp": "01:42:07", "text": "それは"}, {"type": "subtitle", "time": 6128.47, "timestamp": "01:42:08", "text": "幸運だった。"}, {"type": "subtitle", "time": 6131.27, "timestamp": "01:42:11", "text": "いや、わかるだろ。 うん。 あのね？ じゃあ、行きます"}, {"type": "subtitle", "time": 6132.55, "timestamp": "01:42:12", "text": "。"}, {"type": "subtitle", "time": 6135.109, "timestamp": "01:42:15", "text": "幸運を祈って。 幸運を祈って。 また。 もう一度言うけど、"}, {"type": "subtitle", "time": 6136.39, "timestamp": "01:42:16", "text": "俺は、兄弟。 今、そうしました。"}, {"type": "subtitle", "time": 6138.39, "timestamp": "01:42:18", "text": "サイファーはちょっとクレイジーだ。"}, {"type": "subtitle", "time": 6138.95, "timestamp": "01:42:18", "text": "いいもの。"}, {"type": "subtitle", "time": 6142.149, "timestamp": "01:42:22", "text": "ああ、そうですね。"}, {"type": "subtitle", "time": 6144.709, "timestamp": "01:42:24", "text": "なあ、"}, {"type": "subtitle", "time": 6147.189, "timestamp": "01:42:27", "text": "お前らには分からないだろうけど、吉野才はマジで自慢してるんだよ"}, {"type": "subtitle", "time": 6154.07, "timestamp": "01:42:34", "text": "彼女はすごいアウトローで、クレイジーな"}, {"type": "subtitle", "time": 6156.47, "timestamp": "01:42:36", "text": "メカニズムをやってるんだけど、"}, {"type": "subtitle", "time": 6159.189, "timestamp": "01:42:39", "text": "ああ、すごい。"}, {"type": "subtitle", "time": 6159.75, "timestamp": "01:42:39", "text": "ああ、そうだよ。"}, {"type": "subtitle", "time": 6162.149, "timestamp": "01:42:42", "text": "私はかろうじて生き延びた。 私は今、蘇生した。   何てことだ"}, {"type": "subtitle", "time": 6167.83, "timestamp": "01:42:47", "text": "。 ああ、彼女は生き延びたんだ、ただ"}, {"type": "subtitle", "time": 6170.87, "timestamp": "01:42:50", "text": "言葉が出てこないんだよ、兄弟。"}, {"type": "subtitle", "time": 6173.59, "timestamp": "01:42:53", "text": "いいえ、大丈夫です。 私も自閉症です。"}, {"type": "subtitle", "time": 6174.87, "timestamp": "01:42:54", "text": "さあ、"}, {"type": "subtitle", "time": 6176.47, "timestamp": "01:42:56", "text": "飛び立とう。"}, {"type": "subtitle", "time": 6178.55, "timestamp": "01:42:58", "text": "あなたは待って、待って、待って、待って。"}]
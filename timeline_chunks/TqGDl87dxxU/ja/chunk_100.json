[{"type": "subtitle", "time": 6001.75, "timestamp": "01:40:01", "text": "俺の盾になってくれたんだよ、兄弟。 そこには。"}, {"type": "subtitle", "time": 6005.35, "timestamp": "01:40:05", "text": "うん。 うん。 まさに"}, {"type": "subtitle", "time": 6011.99, "timestamp": "01:40:11", "text": "ああ、神様。   今から皆さんのところへ行きます"}, {"type": "subtitle", "time": 6018.629, "timestamp": "01:40:18", "text": "ああ、彼は脇役みたいなものだ。"}, {"type": "subtitle", "time": 6021.35, "timestamp": "01:40:21", "text": "彼はどこにいますか？ 彼はどこにいますか？ 彼はどこにいますか？"}, {"type": "subtitle", "time": 6021.51, "timestamp": "01:40:21", "text": "あちら"}, {"type": "subtitle", "time": 6023.59, "timestamp": "01:40:23", "text": "側。"}, {"type": "subtitle", "time": 6027.51, "timestamp": "01:40:27", "text": "私は狩人だ。"}, {"type": "subtitle", "time": 6027.669, "timestamp": "01:40:27", "text": "彼は"}, {"type": "subtitle", "time": 6034.709, "timestamp": "01:40:34", "text": "最後に残ったプレイヤー。   ではごきげんよう"}, {"type": "subtitle", "time": 6038.55, "timestamp": "01:40:38", "text": "。 ああ、"}, {"type": "chat", "time": 6040.404, "timestamp": "01:40:40", "author": "@MRTEDDY-1401", "avatar": "https://yt4.ggpht.com/v510NQZUUxn-kYA-mj4sLnvLBE_ct_gKXcimoMlgGatkEuNTMrDun0C850mLX7-pcFASlbfp7ys=s64-c-k-c0x00ffffff-no-rj", "message": "ntUCkszU2WH9gy1mb0dV-11UJg/b8IfY7zOK9iVkNAP_I2A-AYUCkszU2WH9gy1mb0dV-11UJg/b8IfY7zOK9iVkNAP_I2A-AY"}, {"type": "subtitle", "time": 6040.709, "timestamp": "01:40:40", "text": "兄弟。 彼らは5秒先を行っているよ、"}, {"type": "subtitle", "time": 6042.87, "timestamp": "01:40:42", "text": "兄弟。"}, {"type": "subtitle", "time": 6043.83, "timestamp": "01:40:43", "text": "ほぼその通りです。"}, {"type": "subtitle", "time": 6045.99, "timestamp": "01:40:45", "text": "彼らは未来にいるんだよ、兄弟。"}, {"type": "subtitle", "time": 6047.83, "timestamp": "01:40:47", "text": "彼らは未来にいる。 日本は常に"}, {"type": "subtitle", "time": 6050.39, "timestamp": "01:40:50", "text": "未来を見据えてきた。   もちろんだよ"}, {"type": "subtitle", "time": 6052.149, "timestamp": "01:40:52", "text": "、兄弟。"}, {"type": "subtitle", "time": 6059.109, "timestamp": "01:40:59", "text": "私を癒してください。   癒やし、癒やし"}]
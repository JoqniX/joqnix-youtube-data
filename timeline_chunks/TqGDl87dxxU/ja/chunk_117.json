[{"type": "subtitle", "time": 7020.87, "timestamp": "01:57:00", "text": "確認するけど、何もないことを願うでしょ"}, {"type": "subtitle", "time": 7022.79, "timestamp": "01:57:02", "text": "。"}, {"type": "subtitle", "time": 7024.47, "timestamp": "01:57:04", "text": "うん。 うん。 うん。"}, {"type": "subtitle", "time": 7025.83, "timestamp": "01:57:05", "text": "うん。 それでいい。 だから、"}, {"type": "subtitle", "time": 7028.47, "timestamp": "01:57:08", "text": "誰かいたら「誰かいるのか」って叫ぶんだ。それは俺の"}, {"type": "subtitle", "time": 7033.83, "timestamp": "01:57:13", "text": "悪夢の一つなんだ。 自分が一人で"}, {"type": "subtitle", "time": 7037.589, "timestamp": "01:57:17", "text": "恐ろしい場所にいるところを想像してみてください。 君は"}, {"type": "subtitle", "time": 7038.629, "timestamp": "01:57:18", "text": "キティだよ、兄弟。"}, {"type": "subtitle", "time": 7040.709, "timestamp": "01:57:20", "text": "そして彼らは「こんにちは、お元気ですか"}, {"type": "subtitle", "time": 7043.83, "timestamp": "01:57:23", "text": "？」と言うのです。 ほら、俺は"}, {"type": "subtitle", "time": 7046.39, "timestamp": "01:57:26", "text": "心臓発作で死ぬんだ、まるで自分が"}, {"type": "subtitle", "time": 7048.87, "timestamp": "01:57:28", "text": "実在しないみたいにさ。"}, {"type": "subtitle", "time": 7049.589, "timestamp": "01:57:29", "text": "素晴らしい。"}, {"type": "subtitle", "time": 7053.109, "timestamp": "01:57:33", "text": "うん。 例えば、"}, {"type": "subtitle", "time": 7055.35, "timestamp": "01:57:35", "text": "もし俺が"}, {"type": "subtitle", "time": 7072.79, "timestamp": "01:57:52", "text": "Bをスパイクで落とせ。気が"}, {"type": "subtitle", "time": 7073.75, "timestamp": "01:57:53", "text": "狂いそうだ。"}]
[{"type": "subtitle", "time": 6600.149, "timestamp": "01:50:00", "text": "いや、それは良くない。"}, {"type": "subtitle", "time": 6604.31, "timestamp": "01:50:04", "text": "いや、いや。おい、お前は食事が必要だぞ。"}, {"type": "subtitle", "time": 6606.55, "timestamp": "01:50:06", "text": "カイド、君は毎回こうするんだね。 あなたは"}, {"type": "subtitle", "time": 6609.669, "timestamp": "01:50:09", "text": "食べるのが好きである必要があります。 せめて"}, {"type": "subtitle", "time": 6611.51, "timestamp": "01:50:11", "text": "軽食くらいは持参してください。"}, {"type": "subtitle", "time": 6613.35, "timestamp": "01:50:13", "text": "ああ、食べなきゃいけないんだ。"}, {"type": "subtitle", "time": 6614.87, "timestamp": "01:50:14", "text": "うん、今からちゃんと"}, {"type": "subtitle", "time": 6617.91, "timestamp": "01:50:17", "text": "昼食をとるよ。"}, {"type": "subtitle", "time": 6619.99, "timestamp": "01:50:19", "text": "ええ、私もあなたのストリーミングを電話したいです"}, {"type": "subtitle", "time": 6622.629, "timestamp": "01:50:22", "text": "。"}, {"type": "subtitle", "time": 6624.629, "timestamp": "01:50:24", "text": "はぁ？"}, {"type": "subtitle", "time": 6627.51, "timestamp": "01:50:27", "text": "うん。 今まさにあなたの配信を見ています"}, {"type": "subtitle", "time": 6630.39, "timestamp": "01:50:30", "text": "。"}, {"type": "subtitle", "time": 6631.91, "timestamp": "01:50:31", "text": "ああ、ありがとうございます。"}, {"type": "subtitle", "time": 6635.43, "timestamp": "01:50:35", "text": "うん。 うん。 いやいや、"}, {"type": "subtitle", "time": 6644.39, "timestamp": "01:50:44", "text": "表示されているモデルが消えてしまったような感じです。 うん。   ごめん"}, {"type": "subtitle", "time": 6647.99, "timestamp": "01:50:47", "text": "。 ノートパソコンでストリーミング配信をしているので、スマホのバッテリーが足りなくなります"}, {"type": "subtitle", "time": 6651.03, "timestamp": "01:50:51", "text": "。"}, {"type": "subtitle", "time": 6652.629, "timestamp": "01:50:52", "text": "はい、わかりました。"}, {"type": "subtitle", "time": 6654.39, "timestamp": "01:50:54", "text": "元気ですか？ どうやって手に入れたの？ 私は"}, {"type": "subtitle", "time": 6655.59, "timestamp": "01:50:55", "text": "日本からノートパソコンを買ったの。"}, {"type": "subtitle", "time": 6657.109, "timestamp": "01:50:57", "text": "待って、私の友達が"}]
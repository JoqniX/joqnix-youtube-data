[{"type": "subtitle", "time": 1681.83, "timestamp": "00:28:01", "text": "。"}, {"type": "subtitle", "time": 1683.83, "timestamp": "00:28:03", "text": "うん。 そうだよね"}, {"type": "subtitle", "time": 1685.269, "timestamp": "00:28:05", "text": "。 私はあなたを信頼します。"}, {"type": "subtitle", "time": 1686.389, "timestamp": "00:28:06", "text": "うん。 うん。"}, {"type": "subtitle", "time": 1688.389, "timestamp": "00:28:08", "text": "うん、君を信頼してるよ。 そんなことは全くない。私は"}, {"type": "subtitle", "time": 1691.51, "timestamp": "00:28:11", "text": "あなたの配信に参加したこともないし、"}, {"type": "subtitle", "time": 1692.71, "timestamp": "00:28:12", "text": "あなたが何を言っているのかも分からない。"}, {"type": "subtitle", "time": 1708.07, "timestamp": "00:28:28", "text": "これを受け取って。 行け！行け！行け。"}, {"type": "subtitle", "time": 1709.11, "timestamp": "00:28:29", "text": "ネオンカラーに。   ありえないよ"}, {"type": "subtitle", "time": 1724.47, "timestamp": "00:28:44", "text": "明らかだ。"}, {"type": "subtitle", "time": 1726.31, "timestamp": "00:28:46", "text": "つまり、"}, {"type": "subtitle", "time": 1729.029, "timestamp": "00:28:49", "text": "料金が"}]
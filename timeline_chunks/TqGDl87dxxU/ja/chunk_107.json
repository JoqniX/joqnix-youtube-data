[{"type": "subtitle", "time": 6424.79, "timestamp": "01:47:04", "text": "そして見事に片側からもう片側へと移動していて、自分が何をしているのか"}, {"type": "subtitle", "time": 6426.629, "timestamp": "01:47:06", "text": "分かっていたんです。"}, {"type": "subtitle", "time": 6428.709, "timestamp": "01:47:08", "text": "すべて。"}, {"type": "subtitle", "time": 6430.39, "timestamp": "01:47:10", "text": "とても良い。"}, {"type": "subtitle", "time": 6433.75, "timestamp": "01:47:13", "text": "植物は素晴らしかったけどね。"}, {"type": "subtitle", "time": 6435.51, "timestamp": "01:47:15", "text": "はい。"}, {"type": "subtitle", "time": 6438.55, "timestamp": "01:47:18", "text": "そして、ミニミニガンでたくさんのキルを稼いだね"}, {"type": "subtitle", "time": 6440.07, "timestamp": "01:47:20", "text": "。 それは何という名前ですか？"}, {"type": "subtitle", "time": 6445.99, "timestamp": "01:47:25", "text": "銃のことだよ。 ミニガンでたくさんキルしたね"}, {"type": "subtitle", "time": 6448.629, "timestamp": "01:47:28", "text": "。 えっと、なんていう名前だっけ？"}, {"type": "subtitle", "time": 6451.03, "timestamp": "01:47:31", "text": "銃の名前を忘れてしまった。"}, {"type": "subtitle", "time": 6452.95, "timestamp": "01:47:32", "text": "ああ、オーディン。 オーディン。   いや"}, {"type": "subtitle", "time": 6453.83, "timestamp": "01:47:33", "text": "、違うよ。"}, {"type": "subtitle", "time": 6455.03, "timestamp": "01:47:35", "text": "オーディン。"}, {"type": "subtitle", "time": 6460.149, "timestamp": "01:47:40", "text": "君はめちゃくちゃハイロビーの"}, {"type": "subtitle", "time": 6462.149, "timestamp": "01:47:42", "text": "プレイヤーを捕まえてるね。 何を言っているんだ？"}, {"type": "subtitle", "time": 6465.75, "timestamp": "01:47:45", "text": "あなたは素晴らしい仕事をしています。"}, {"type": "subtitle", "time": 6467.669, "timestamp": "01:47:47", "text": "彼女は宇宙人を使っていたんだと思う。"}, {"type": "subtitle", "time": 6471.03, "timestamp": "01:47:51", "text": "うん。 うん。 うん。"}, {"type": "subtitle", "time": 6477.99, "timestamp": "01:47:57", "text": "ジョークみたいになるには、オフラインでたくさん練習しないといけないと思う。"}]
[{"type": "subtitle", "time": 2760.47, "timestamp": "00:46:00", "text": "うん。 ではごきげんよう。"}, {"type": "subtitle", "time": 2761.67, "timestamp": "00:46:01", "text": "あなたの前に現れます。 彼は"}, {"type": "subtitle", "time": 2762.39, "timestamp": "00:46:02", "text": "あなたの前に現れるでしょう。"}, {"type": "subtitle", "time": 2764.39, "timestamp": "00:46:04", "text": "フォローする。"}, {"type": "subtitle", "time": 2766.15, "timestamp": "00:46:06", "text": "ああ、彼は勝ちたくないんだろうね。"}, {"type": "subtitle", "time": 2772.47, "timestamp": "00:46:12", "text": "最終ラウンドだ。 なぜ？   何てことだ"}, {"type": "subtitle", "time": 2776.069, "timestamp": "00:46:16", "text": "。 彼を見つけてくれよ、兄弟。   まさか"}, {"type": "subtitle", "time": 2777.27, "timestamp": "00:46:17", "text": "私がそれを名曲でやらなきゃいけないなんて、あなたは知らなかったでしょう"}, {"type": "subtitle", "time": 2806.71, "timestamp": "00:46:46", "text": "それは良かった。"}, {"type": "subtitle", "time": 2808.47, "timestamp": "00:46:48", "text": "それは壮大だった。"}, {"type": "subtitle", "time": 2810.71, "timestamp": "00:46:50", "text": "はい、"}]
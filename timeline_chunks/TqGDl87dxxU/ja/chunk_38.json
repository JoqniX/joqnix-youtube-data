[{"type": "subtitle", "time": 2281.75, "timestamp": "00:38:01", "text": "待って。 私は今、姿を現している。 どうやって？ ああ、私は"}, {"type": "subtitle", "time": 2290.79, "timestamp": "00:38:10", "text": "男、すごいバックステップをやってるな。"}, {"type": "subtitle", "time": 2301.91, "timestamp": "00:38:21", "text": "おお。"}, {"type": "subtitle", "time": 2303.91, "timestamp": "00:38:23", "text": "おお、いいショットだ。"}, {"type": "subtitle", "time": 2310.55, "timestamp": "00:38:30", "text": "ああ、壮大だ。"}, {"type": "subtitle", "time": 2315.43, "timestamp": "00:38:35", "text": "やっぱりいいや。"}, {"type": "subtitle", "time": 2319.27, "timestamp": "00:38:39", "text": "ボールを食べろ。 エースって何だか知ってる？"}, {"type": "subtitle", "time": 2321.67, "timestamp": "00:38:41", "text": "いいえ、できません。 どうでも。"}, {"type": "subtitle", "time": 2324.31, "timestamp": "00:38:44", "text": "冗談はただの暗号だよ、"}, {"type": "subtitle", "time": 2326.23, "timestamp": "00:38:46", "text": "兄弟。   お前ら"}, {"type": "subtitle", "time": 2327.91, "timestamp": "00:38:47", "text": "、おかしいよ。"}, {"type": "subtitle", "time": 2329.349, "timestamp": "00:38:49", "text": "彼は特に努力もしていないのに、あれだけのキル数を稼いでいる"}, {"type": "subtitle", "time": 2330.87, "timestamp": "00:38:50", "text": "。 何てことだ。   何てことだ"}, {"type": "subtitle", "time": 2333.829, "timestamp": "00:38:53", "text": "。 彼は努力すらしていない。"}, {"type": "subtitle", "time": 2339.91, "timestamp": "00:38:59", "text": "ああ、そうだよ。 チュートリアルビデオが必要なんだよ、"}]
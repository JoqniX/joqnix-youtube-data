[{"type": "subtitle", "time": 5941.109, "timestamp": "01:39:01", "text": "。 うん。   何てことだ"}, {"type": "subtitle", "time": 5943.27, "timestamp": "01:39:03", "text": "。 インダンディ。"}, {"type": "subtitle", "time": 5944.87, "timestamp": "01:39:04", "text": "いいもの。"}, {"type": "subtitle", "time": 5945.59, "timestamp": "01:39:05", "text": "TNT。"}, {"type": "subtitle", "time": 5958.709, "timestamp": "01:39:18", "text": "切り替え前の最後のラウンドです。"}, {"type": "subtitle", "time": 5961.59, "timestamp": "01:39:21", "text": "あ、そうそう、カイド、あの、あの"}, {"type": "subtitle", "time": 5964.39, "timestamp": "01:39:24", "text": "、クラシックには2つのモードがあるんだよ。 えっと、"}, {"type": "subtitle", "time": 5966.629, "timestamp": "01:39:26", "text": "左クリックは単発射撃で、"}, {"type": "subtitle", "time": 5969.189, "timestamp": "01:39:29", "text": "右クリックは連射です。 つまり、"}, {"type": "subtitle", "time": 5972.149, "timestamp": "01:39:32", "text": "右クリックはショットガンみたいなものだ。 だから、"}, {"type": "subtitle", "time": 5973.83, "timestamp": "01:39:33", "text": "敵に近づきすぎた時に、"}, {"type": "subtitle", "time": 5976.95, "timestamp": "01:39:36", "text": "それを使うことができる。"}, {"type": "subtitle", "time": 5979.43, "timestamp": "01:39:39", "text": "それは役に立つでしょう。"}, {"type": "subtitle", "time": 5982.149, "timestamp": "01:39:42", "text": "ああ、まるで一度に何発もの弾丸を撃ち出すような感じだ"}, {"type": "subtitle", "time": 5982.79, "timestamp": "01:39:42", "text": "。   わかった"}, {"type": "subtitle", "time": 5984.709, "timestamp": "01:39:44", "text": "。"}, {"type": "subtitle", "time": 5986.39, "timestamp": "01:39:46", "text": "うん。"}, {"type": "subtitle", "time": 5989.27, "timestamp": "01:39:49", "text": "正直に言うと、パニックになった時は、"}, {"type": "subtitle", "time": 5993.51, "timestamp": "01:39:53", "text": "敵に近づきすぎた時にそれをクリックしてしまうんです。"}, {"type": "subtitle", "time": 5995.669, "timestamp": "01:39:55", "text": "おお、素晴らしいサポートですね。"}, {"type": "subtitle", "time": 5998.31, "timestamp": "01:39:58", "text": "それは素晴らしかった。"}]
[{"type": "subtitle", "time": 7567.43, "timestamp": "02:06:07", "text": "彼は140だ。"}, {"type": "subtitle", "time": 7584.87, "timestamp": "02:06:24", "text": "ああ、兄弟。"}, {"type": "subtitle", "time": 7587.51, "timestamp": "02:06:27", "text": "おい、みんな吉野さんの"}, {"type": "subtitle", "time": 7591.35, "timestamp": "02:06:31", "text": "視点を見てみるべきだよ。"}, {"type": "subtitle", "time": 7596.149, "timestamp": "02:06:36", "text": "私が主観的であるべきだというのは最悪の意見だ。"}, {"type": "subtitle", "time": 7599.27, "timestamp": "02:06:39", "text": "なあ、彼女は地図認識能力みたいなもんだよ"}, {"type": "subtitle", "time": 7601.669, "timestamp": "02:06:41", "text": "。 まったくひどい。"}, {"type": "subtitle", "time": 7611.03, "timestamp": "02:06:51", "text": "おお、いいね。"}]
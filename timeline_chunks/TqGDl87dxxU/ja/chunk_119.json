[{"type": "subtitle", "time": 7142.88, "timestamp": "01:59:02", "text": "俺は米なしでは生きていけないんだよ、 兄弟。 お前は"}, {"type": "subtitle", "time": 7144.719, "timestamp": "01:59:04", "text": "兄弟。 お前は これを知ったら俺を恨むだろうな、兄弟。"}, {"type": "subtitle", "time": 7145.76, "timestamp": "01:59:05", "text": "これを知ったら俺を恨むだろうな、兄弟。 今はもう"}, {"type": "subtitle", "time": 7149.119, "timestamp": "01:59:09", "text": "今はもう 言いません。"}, {"type": "subtitle", "time": 7150.88, "timestamp": "01:59:10", "text": "言いません。 いや、"}, {"type": "subtitle", "time": 7151.679, "timestamp": "01:59:11", "text": "いや、 いや。言ってみて。 言ってみて。 実際に言ってみてください。"}, {"type": "subtitle", "time": 7154.239, "timestamp": "01:59:14", "text": "いや。言ってみて。 言ってみて。 実際に言ってみてください。 私はあまりご飯が好きではありません。"}, {"type": "subtitle", "time": 7157.599, "timestamp": "01:59:17", "text": "私はあまりご飯が好きではありません。 大丈夫。"}, {"type": "subtitle", "time": 7159.92, "timestamp": "01:59:19", "text": "大丈夫。 うん。   あまり好まないですね"}, {"type": "subtitle", "time": 7165.91, "timestamp": "01:59:25", "text": "。  「私の好み」というよりは、「"}, {"type": "subtitle", "time": 7170.709, "timestamp": "01:59:30", "text": "ご飯と一緒に食べるものは何ですか？」という質問に近いものです。   私はそれが"}, {"type": "subtitle", "time": 7172.95, "timestamp": "01:59:32", "text": "好きです。 ええと、カレーの時もあれば、"}, {"type": "subtitle", "time": 7182.95, "timestamp": "01:59:42", "text": "学校でよく食べていたのを覚えています"}, {"type": "subtitle", "time": 7184.87, "timestamp": "01:59:44", "text": "。 物語にふさわしいかどうかはわかりませんが、"}, {"type": "subtitle", "time": 7189.75, "timestamp": "01:59:49", "text": "共有します。あの、あの、"}, {"type": "subtitle", "time": 7194.149, "timestamp": "01:59:54", "text": "魔法のマサラパケットのことです。"}, {"type": "subtitle", "time": 7195.27, "timestamp": "01:59:55", "text": "うん。 うん。 うん。"}, {"type": "subtitle", "time": 7198.31, "timestamp": "01:59:58", "text": "えっと、魔法のマサラパケット。 それで、えーと、母は"}]
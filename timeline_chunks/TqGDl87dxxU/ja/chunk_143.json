[{"type": "subtitle", "time": 8593.67, "timestamp": "02:23:13", "text": "蘇生のことだと思う。"}, {"type": "subtitle", "time": 8595.75, "timestamp": "02:23:15", "text": "最後に残ったプレイヤー。"}, {"type": "subtitle", "time": 8620.95, "timestamp": "02:23:40", "text": "我々の勝ちだ。 ニャー。 ライナ。 おお。   私は、"}, {"type": "subtitle", "time": 8623.03, "timestamp": "02:23:43", "text": "彼が"}, {"type": "subtitle", "time": 8625.59, "timestamp": "02:23:45", "text": "私だけにそうするつもりだと分かっていました。 兄貴は"}, {"type": "subtitle", "time": 8629.99, "timestamp": "02:23:49", "text": "前にたくさんの人を見たみたいだ。 彼は私を選んでくれた。 ニース。   何てことだ"}, {"type": "subtitle", "time": 8630.71, "timestamp": "02:23:50", "text": "。"}]
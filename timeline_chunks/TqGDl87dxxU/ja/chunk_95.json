[{"type": "subtitle", "time": 5701.189, "timestamp": "01:35:01", "text": "ピング音みたいですね。"}, {"type": "subtitle", "time": 5703.27, "timestamp": "01:35:03", "text": "うん、ピン。 ほら、"}, {"type": "subtitle", "time": 5705.83, "timestamp": "01:35:05", "text": "5秒くらいの遅延みたいな感じだよ。 あなたは"}, {"type": "subtitle", "time": 5707.35, "timestamp": "01:35:07", "text": "動くたびに、何かに直面しているようなものだ。"}, {"type": "subtitle", "time": 5708.87, "timestamp": "01:35:08", "text": "たとえ1つでも手に入れば、私はとても"}, {"type": "subtitle", "time": 5709.59, "timestamp": "01:35:09", "text": "幸せになるでしょう。"}, {"type": "subtitle", "time": 5716.87, "timestamp": "01:35:16", "text": "おお、いいぞ。 さあ行こう"}, {"type": "subtitle", "time": 5721.669, "timestamp": "01:35:21", "text": "。 さあ行こう。 短かったですね。"}, {"type": "subtitle", "time": 5724.709, "timestamp": "01:35:24", "text": "残り数秒。 ああ、"}, {"type": "subtitle", "time": 5727.11, "timestamp": "01:35:27", "text": "彼は私を殺す前に撃ったんだ。 何？"}, {"type": "subtitle", "time": 5727.59, "timestamp": "01:35:27", "text": "うん。"}, {"type": "subtitle", "time": 5728.149, "timestamp": "01:35:28", "text": "ああ、そうだよ。   それを"}, {"type": "subtitle", "time": 5728.95, "timestamp": "01:35:28", "text": "見たよ。"}, {"type": "subtitle", "time": 5731.59, "timestamp": "01:35:31", "text": "うん。 うん。 なぜなら、彼にとってあなたは、"}, {"type": "subtitle", "time": 5733.189, "timestamp": "01:35:33", "text": "その5秒前の存在だったからだ。"}, {"type": "subtitle", "time": 5734.47, "timestamp": "01:35:34", "text": "5秒なんて信じられない。"}, {"type": "subtitle", "time": 5735.51, "timestamp": "01:35:35", "text": "くそ。"}, {"type": "subtitle", "time": 5738.149, "timestamp": "01:35:38", "text": "待って。 あの、あなたの無法者をいただけますか？"}, {"type": "subtitle", "time": 5740.31, "timestamp": "01:35:40", "text": "楽しんでいる人はいますか？"}, {"type": "subtitle", "time": 5742.87, "timestamp": "01:35:42", "text": "ああ、本当にありがとうございます。   そうする必要はありません"}, {"type": "subtitle", "time": 5746.55, "timestamp": "01:35:46", "text": "。 これを買います。"}, {"type": "subtitle", "time": 5749.75, "timestamp": "01:35:49", "text": "行け！行け！行け。   君も私が"}, {"type": "subtitle", "time": 5752.229, "timestamp": "01:35:52", "text": "作ったんだよ。   私はこちらへ行きます"}, {"type": "subtitle", "time": 5753.11, "timestamp": "01:35:53", "text": "。"}]
[{"type": "subtitle", "time": 3909.51, "timestamp": "01:05:09", "text": "彼らは私がどれほど冷酷な人間か全く分かっていない。"}, {"type": "subtitle", "time": 3910.63, "timestamp": "01:05:10", "text": "冷酷だ。"}, {"type": "subtitle", "time": 3913.43, "timestamp": "01:05:13", "text": "ライナは本当にカッコいい。"}, {"type": "subtitle", "time": 3917.029, "timestamp": "01:05:17", "text": "私は彼女のあらゆる面が大好きです。"}, {"type": "subtitle", "time": 3919.91, "timestamp": "01:05:19", "text": "ボイスラインの登場人物たちは彼女に夢中だ。"}, {"type": "subtitle", "time": 3922.71, "timestamp": "01:05:22", "text": "ええ、"}, {"type": "subtitle", "time": 3924.789, "timestamp": "01:05:24", "text": "ちなみに、彼女の笑い声が大好きなんです。 あの"}, {"type": "subtitle", "time": 3927.75, "timestamp": "01:05:27", "text": "邪悪な笑い声。"}, {"type": "subtitle", "time": 3929.51, "timestamp": "01:05:29", "text": "うん。 うん。 誰かを殺した時、"}, {"type": "subtitle", "time": 3930.71, "timestamp": "01:05:30", "text": "ああ、わかってるよ。   そうそう"}, {"type": "subtitle", "time": 3933.75, "timestamp": "01:05:33", "text": "。"}, {"type": "subtitle", "time": 3935.829, "timestamp": "01:05:35", "text": "私はその患者の誰一人として知りません"}, {"type": "subtitle", "time": 3936.39, "timestamp": "01:05:36", "text": "。   あの"}, {"type": "subtitle", "time": 3944.95, "timestamp": "01:05:44", "text": "。"}, {"type": "subtitle", "time": 3948.069, "timestamp": "01:05:48", "text": "ああ、実は私たちは香港にいるんです。 おお。 えっと、"}, {"type": "subtitle", "time": 3950.95, "timestamp": "01:05:50", "text": "香港って最近追加されたんですか？それとも"}, {"type": "subtitle", "time": 3952.87, "timestamp": "01:05:52", "text": "前からあったんですか？"}, {"type": "subtitle", "time": 3955.43, "timestamp": "01:05:55", "text": "マニラが追加される前からそこにありました。"}, {"type": "subtitle", "time": 3957.349, "timestamp": "01:05:57", "text": "彼らは最近マニラを追加した。"}]
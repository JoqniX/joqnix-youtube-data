[{"type": "subtitle", "time": 3365.75, "timestamp": "00:56:05", "text": "あ、そこだ。 そう、そう、彼は"}, {"type": "subtitle", "time": 3367.19, "timestamp": "00:56:07", "text": "そこでキャンプしてたんだ。すごいね"}, {"type": "subtitle", "time": 3367.67, "timestamp": "00:56:07", "text": "。"}, {"type": "subtitle", "time": 3376.15, "timestamp": "00:56:16", "text": "ああ、彼は遅れている。 最後に残ったプレイヤー。"}, {"type": "subtitle", "time": 3378.63, "timestamp": "00:56:18", "text": "彼は遅れをとっている。"}, {"type": "subtitle", "time": 3386.789, "timestamp": "00:56:26", "text": "待って、私もラグっているみたいだ。"}, {"type": "subtitle", "time": 3387.75, "timestamp": "00:56:27", "text": "ああ、そうだね。   ああ"}, {"type": "subtitle", "time": 3389.43, "timestamp": "00:56:29", "text": "、なぜ？"}, {"type": "subtitle", "time": 3390.71, "timestamp": "00:56:30", "text": "君たちにはあらゆる悪いことが起こっているね。 はい、戻ってきました"}, {"type": "subtitle", "time": 3392.63, "timestamp": "00:56:32", "text": "。   わからない"}, {"type": "subtitle", "time": 3394.47, "timestamp": "00:56:34", "text": "。 私はこれで"}, {"type": "subtitle", "time": 3395.99, "timestamp": "00:56:35", "text": "2回目の退場処分を受けた。"}, {"type": "subtitle", "time": 3397.43, "timestamp": "00:56:37", "text": "うん。"}, {"type": "subtitle", "time": 3399.27, "timestamp": "00:56:39", "text": "再装填中。"}, {"type": "subtitle", "time": 3400.87, "timestamp": "00:56:40", "text": "ありがとう。   それでも"}, {"type": "subtitle", "time": 3408.47, "timestamp": "00:56:48", "text": "つまり、あなたが私の上にいるから、"}, {"type": "subtitle", "time": 3410.95, "timestamp": "00:56:50", "text": "あなたはさらに素晴らしい存在になるんです。"}]
[{"type": "subtitle", "time": 5401.03, "timestamp": "01:30:01", "text": "弾丸が実は君を裏切ったんだ。"}, {"type": "subtitle", "time": 5401.91, "timestamp": "01:30:01", "text": "うん。   絶対に"}, {"type": "subtitle", "time": 5405.669, "timestamp": "01:30:05", "text": "あなたに勝たせるわけがない。"}, {"type": "subtitle", "time": 5407.83, "timestamp": "01:30:07", "text": "君はいつだって最高だよ"}, {"type": "subtitle", "time": 5411.91, "timestamp": "01:30:11", "text": "。"}, {"type": "subtitle", "time": 5414.31, "timestamp": "01:30:14", "text": "それは詐欺だよ。 兄弟、私は"}, {"type": "subtitle", "time": 5419.669, "timestamp": "01:30:19", "text": "。"}, {"type": "subtitle", "time": 5421.75, "timestamp": "01:30:21", "text": "あ、待って。 では、待ってください。 電気は"}, {"type": "subtitle", "time": 5423.189, "timestamp": "01:30:23", "text": "復旧しましたか？"}, {"type": "subtitle", "time": 5424.629, "timestamp": "01:30:24", "text": "いいえ、いいえ、いいえ、兄弟。 私は"}, {"type": "subtitle", "time": 5425.91, "timestamp": "01:30:25", "text": "暗闇の中に座っている。"}, {"type": "subtitle", "time": 5427.27, "timestamp": "01:30:27", "text": "あ、待って。"}, {"type": "subtitle", "time": 5429.99, "timestamp": "01:30:29", "text": "私は、えっと、何て"}, {"type": "subtitle", "time": 5433.11, "timestamp": "01:30:33", "text": "言うんだっけ？に1つだけ持ってるんだ。 私のノートパソコンは動かせます。"}, {"type": "subtitle", "time": 5436.31, "timestamp": "01:30:36", "text": "ゲームに参加することはできますが、それは"}, {"type": "subtitle", "time": 5439.59, "timestamp": "01:30:39", "text": "インバーターと呼ばれるものが必要になると思います。 でも、それでも"}, {"type": "subtitle", "time": 5443.51, "timestamp": "01:30:43", "text": "全部実行できるとは思えません。"}, {"type": "subtitle", "time": 5444.31, "timestamp": "01:30:44", "text": "ああ、大丈夫だよ。"}, {"type": "subtitle", "time": 5445.91, "timestamp": "01:30:45", "text": "ゲームに参加して、"}, {"type": "subtitle", "time": 5450.07, "timestamp": "01:30:50", "text": "インバーターをあまり使わないようにしようかな。"}, {"type": "subtitle", "time": 5452.87, "timestamp": "01:30:52", "text": "ええ、それも問題ですね"}, {"type": "subtitle", "time": 5453.43, "timestamp": "01:30:53", "text": "。"}, {"type": "subtitle", "time": 5453.91, "timestamp": "01:30:53", "text": "うん。"}, {"type": "subtitle", "time": 5456.87, "timestamp": "01:30:56", "text": "ストリームをただ見てください。 うん。"}, {"type": "subtitle", "time": 5458.79, "timestamp": "01:30:58", "text": "うん。 今はただ見守っているだけです。"}, {"type": "subtitle", "time": 5459.51, "timestamp": "01:30:59", "text": "うん。 うん。"}]
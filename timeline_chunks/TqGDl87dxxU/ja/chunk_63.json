[{"type": "subtitle", "time": 3785.829, "timestamp": "01:03:05", "text": "説明文を設定したので、皆さんのリンクもすべて把握しています。それで質問しようと思っていました。"}, {"type": "subtitle", "time": 3788.15, "timestamp": "01:03:08", "text": "じゃあ、"}, {"type": "subtitle", "time": 3796.87, "timestamp": "01:03:16", "text": "Valチャットみたいに、試合ごとにチャットにそれを追加するようにしたらいいですか？"}, {"type": "subtitle", "time": 3798.95, "timestamp": "01:03:18", "text": "うん。 うん。 昨日のことについて話しましたよね"}, {"type": "subtitle", "time": 3801.43, "timestamp": "01:03:21", "text": "。 恥ずかしい、恥ずかしいこと。"}, {"type": "subtitle", "time": 3802.069, "timestamp": "01:03:22", "text": "うん。"}, {"type": "subtitle", "time": 3809.029, "timestamp": "01:03:29", "text": "。   何てことだ"}, {"type": "subtitle", "time": 3810.309, "timestamp": "01:03:30", "text": "。   面白そうだ"}, {"type": "subtitle", "time": 3812.549, "timestamp": "01:03:32", "text": "。"}, {"type": "subtitle", "time": 3814.39, "timestamp": "01:03:34", "text": "本気ですか？"}, {"type": "subtitle", "time": 3817.43, "timestamp": "01:03:37", "text": "。 わからない。 私は"}, {"type": "subtitle", "time": 3817.829, "timestamp": "01:03:37", "text": "そんなことはしたことがない。"}, {"type": "subtitle", "time": 3820.309, "timestamp": "01:03:40", "text": "1つ。 私もやったことないです。"}, {"type": "subtitle", "time": 3822.23, "timestamp": "01:03:42", "text": "いいえ、できます。 我々はできる。 我々はできる。 我々はできる。 やってみます"}, {"type": "subtitle", "time": 3823.43, "timestamp": "01:03:43", "text": "。"}, {"type": "subtitle", "time": 3833.589, "timestamp": "01:03:53", "text": "巨人。"}, {"type": "subtitle", "time": 3835.51, "timestamp": "01:03:55", "text": "Kaidのping値は21くらいだ。"}]
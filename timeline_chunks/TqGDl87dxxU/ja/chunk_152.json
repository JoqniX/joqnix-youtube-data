[{"type": "chat", "time": 9125.017, "timestamp": "02:32:05", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ-7tIYCO_9EPt-GMgAwUCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ-7tIYCO_9EPt-GMgAw"}, {"type": "subtitle", "time": 9126.469, "timestamp": "02:32:06", "text": "こんにちは。 まあ、そうですね。 土曜日の私の計画は、"}, {"type": "subtitle", "time": 9129.03, "timestamp": "02:32:09", "text": "会員登録していただきありがとうございます、ということです。"}, {"type": "subtitle", "time": 9134.55, "timestamp": "02:32:14", "text": "土曜日は音楽配信をする予定です。"}, {"type": "subtitle", "time": 9138.63, "timestamp": "02:32:18", "text": "えっと、実は最近は"}, {"type": "subtitle", "time": 9141.59, "timestamp": "02:32:21", "text": "音楽関係のことをちょこちょこやってるだけなんです"}, {"type": "subtitle", "time": 9143.67, "timestamp": "02:32:23", "text": "。 だから、私は"}, {"type": "subtitle", "time": 9147.67, "timestamp": "02:32:27", "text": "それらをきちんと行うために、きちんと時間を確保できていなかったのです。 でも、"}, {"type": "subtitle", "time": 9150.23, "timestamp": "02:32:30", "text": "少なくともその配信はやってみたい。"}, {"type": "subtitle", "time": 9152.71, "timestamp": "02:32:32", "text": "土曜日は、仕事がないと思います。 えっと、もっと"}, {"type": "subtitle", "time": 9155.83, "timestamp": "02:32:35", "text": "長い配信もできるかな。 今日は"}, {"type": "subtitle", "time": 9158.23, "timestamp": "02:32:38", "text": "2時間30分ほど配信しました。"}, {"type": "subtitle", "time": 9169.11, "timestamp": "02:32:49", "text": "でも、そうですね、これからは"}, {"type": "subtitle", "time": 9171.11, "timestamp": "02:32:51", "text": "もっと"}, {"type": "subtitle", "time": 9173.429, "timestamp": "02:32:53", "text": "日本語を話さないといけないですね。 この配信は英語の"}, {"type": "subtitle", "time": 9175.83, "timestamp": "02:32:55", "text": "配信になりましたが、"}, {"type": "subtitle", "time": 9179.349, "timestamp": "02:32:59", "text": "今日はコラボがあったので例外です。"}]
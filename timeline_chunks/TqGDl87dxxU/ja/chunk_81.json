[{"type": "subtitle", "time": 4860.87, "timestamp": "01:21:00", "text": "すごい。 私のシュートは当たりません。"}, {"type": "subtitle", "time": 4862.07, "timestamp": "01:21:02", "text": "何してるの？   何てことだ"}, {"type": "subtitle", "time": 4863.59, "timestamp": "01:21:03", "text": "。"}, {"type": "subtitle", "time": 4863.91, "timestamp": "01:21:03", "text": "行く。"}, {"type": "subtitle", "time": 4865.83, "timestamp": "01:21:05", "text": "ああ、なんてこった。"}, {"type": "subtitle", "time": 4866.63, "timestamp": "01:21:06", "text": "行く。"}, {"type": "subtitle", "time": 4867.91, "timestamp": "01:21:07", "text": "ああ、なんてこった。"}, {"type": "subtitle", "time": 4869.35, "timestamp": "01:21:09", "text": "あなたは悲観論者ですね。 行く。 あなたは"}, {"type": "subtitle", "time": 4873.91, "timestamp": "01:21:13", "text": "悲観論者ですね。 行く。 わかった、行くよ。"}, {"type": "subtitle", "time": 4877.11, "timestamp": "01:21:17", "text": "彼らは私をそこに一人残して、"}, {"type": "subtitle", "time": 4880.07, "timestamp": "01:21:20", "text": "好き勝手に振る舞った。"}, {"type": "subtitle", "time": 4881.59, "timestamp": "01:21:21", "text": "スパイクが植えられました。   ただ、ただ、ただ、それを"}, {"type": "subtitle", "time": 4901.91, "timestamp": "01:21:41", "text": "なぜそれが正しいのか？"}, {"type": "subtitle", "time": 4906.39, "timestamp": "01:21:46", "text": "彼は落ち込んでいる。 彼は落ち込んでいる。 私は彼を殴った。   私は"}, {"type": "subtitle", "time": 4907.27, "timestamp": "01:21:47", "text": "彼を殴った。"}, {"type": "subtitle", "time": 4910.229, "timestamp": "01:21:50", "text": "再装填中。"}, {"type": "subtitle", "time": 4911.59, "timestamp": "01:21:51", "text": "ナイスショット。   わかった"}, {"type": "subtitle", "time": 4915.99, "timestamp": "01:21:55", "text": "。 電気が止まったんだよ、兄弟。"}, {"type": "subtitle", "time": 4917.59, "timestamp": "01:21:57", "text": "停電です。"}, {"type": "subtitle", "time": 4918.47, "timestamp": "01:21:58", "text": "最後のプレイヤー。"}, {"type": "chat", "time": 4919.495, "timestamp": "01:21:59", "author": "@MRTEDDY-1401", "avatar": "https://yt4.ggpht.com/v510NQZUUxn-kYA-mj4sLnvLBE_ct_gKXcimoMlgGatkEuNTMrDun0C850mLX7-pcFASlbfp7ys=s64-c-k-c0x00ffffff-no-r
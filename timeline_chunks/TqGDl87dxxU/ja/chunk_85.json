[{"type": "subtitle", "time": 5100.55, "timestamp": "01:25:00", "text": "うん。 私は配信していないのでしょうか？   そうだと"}, {"type": "subtitle", "time": 5101.59, "timestamp": "01:25:01", "text": "思いますよ。 私は"}, {"type": "subtitle", "time": 5104.55, "timestamp": "01:25:04", "text": "配信を視聴しています。   どけ"}, {"type": "subtitle", "time": 5107.189, "timestamp": "01:25:07", "text": "。"}, {"type": "subtitle", "time": 5125.91, "timestamp": "01:25:25", "text": "敵を発見。"}, {"type": "subtitle", "time": 5134.79, "timestamp": "01:25:34", "text": "ジェット機に乗るのは最高だ。"}, {"type": "subtitle", "time": 5136.95, "timestamp": "01:25:36", "text": "ニース。"}, {"type": "subtitle", "time": 5138.79, "timestamp": "01:25:38", "text": "ああ、ヨシ。"}, {"type": "subtitle", "time": 5139.99, "timestamp": "01:25:39", "text": "うん。"}, {"type": "subtitle", "time": 5141.51, "timestamp": "01:25:41", "text": "いいえ、いいえ、何も。"}, {"type": "subtitle", "time": 5151.91, "timestamp": "01:25:51", "text": "さあ行こう、ジョック。 ジョック、君ならできるよ。   何てことだ"}, {"type": "subtitle", "time": 5152.639, "timestamp": "01:25:52", "text": "。   何てことだ 。   何てことだ"}, {"type": "subtitle", "time": 5154.4, "timestamp": "01:25:54", "text": "。   何てことだ 。"}, {"type": "subtitle", "time": 5155.52, "timestamp": "01:25:55", "text": "。 ああ、彼は歌っている。"}, {"type": "subtitle", "time": 5158.08, "timestamp": "01:25:58", "text": "ああ、彼は歌っている。 よぉ、ジョーがコーナージョークで"}]
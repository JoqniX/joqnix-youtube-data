[{"type": "subtitle", "time": 7807.51, "timestamp": "02:10:07", "text": "8時頃になりそうです。 それで、"}, {"type": "subtitle", "time": 7813.75, "timestamp": "02:10:13", "text": "ルームメイトに何があったんだろうって思ったんです。"}, {"type": "subtitle", "time": 7820.79, "timestamp": "02:10:20", "text": "彼はまるであなたのために良い子にしているみたいで、私は「"}, {"type": "subtitle", "time": 7824.149, "timestamp": "02:10:24", "text": "ああ、私の可愛いジョッカー、私は"}, {"type": "subtitle", "time": 7834.069, "timestamp": "02:10:34", "text": "これが最後になります。この後、"}, {"type": "subtitle", "time": 7844.79, "timestamp": "02:10:44", "text": "手伝いに行きます。"}]
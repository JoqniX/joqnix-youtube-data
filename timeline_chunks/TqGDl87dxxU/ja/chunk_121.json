[{"type": "subtitle", "time": 7260.79, "timestamp": "02:01:00", "text": "持ち込み始めた。"}, {"type": "subtitle", "time": 7292.149, "timestamp": "02:01:32", "text": "スパイクが植えられた。"}, {"type": "subtitle", "time": 7292.87, "timestamp": "02:01:32", "text": "敵を倒した。"}, {"type": "subtitle", "time": 7294.39, "timestamp": "02:01:34", "text": "上空で何をしているんだ？"}, {"type": "subtitle", "time": 7300.229, "timestamp": "02:01:40", "text": "ああ、みんな。"}, {"type": "subtitle", "time": 7304.07, "timestamp": "02:01:44", "text": "ジョグ。 ジョークが欲しい。   何てことだ"}, {"type": "subtitle", "time": 7306.31, "timestamp": "02:01:46", "text": "。"}, {"type": "subtitle", "time": 7311.75, "timestamp": "02:01:51", "text": "私はダメな人間だ。 私はダメな人間だ。 私はダメな人間だ。"}]
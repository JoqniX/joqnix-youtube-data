[{"type": "subtitle", "time": 2640.55, "timestamp": "00:44:00", "text": "。"}, {"type": "subtitle", "time": 2642.55, "timestamp": "00:44:02", "text": "残り10秒。 あなたは彼をほんの一瞬だけ見た"}, {"type": "subtitle", "time": 2643.67, "timestamp": "00:44:03", "text": "。 おお。"}, {"type": "subtitle", "time": 2644.71, "timestamp": "00:44:04", "text": "スパイクを手に入れた。"}, {"type": "subtitle", "time": 2646.71, "timestamp": "00:44:06", "text": "ああ、兄弟。"}, {"type": "subtitle", "time": 2647.75, "timestamp": "00:44:07", "text": "何？   マジかよ"}, {"type": "subtitle", "time": 2650.15, "timestamp": "00:44:10", "text": "、兄弟。 おい、"}, {"type": "subtitle", "time": 2651.43, "timestamp": "00:44:11", "text": "切り取ってくれよ。"}, {"type": "subtitle", "time": 2652.63, "timestamp": "00:44:12", "text": "よお。 おい、"}, {"type": "subtitle", "time": 2654.87, "timestamp": "00:44:14", "text": "一体どういうことだ？"}, {"type": "subtitle", "time": 2656.15, "timestamp": "00:44:16", "text": "神。"}, {"type": "subtitle", "time": 2657.91, "timestamp": "00:44:17", "text": "うん。 つまり、それは別のレベルで起こるんだよ、兄弟。   2回"}, {"type": "subtitle", "time": 2659.51, "timestamp": "00:44:19", "text": "。 年に1、2回くらい起こるようなことだ"}, {"type": "subtitle", "time": 2661.829, "timestamp": "00:44:21", "text": "。 うん。   何てことだ"}, {"type": "subtitle", "time": 2663.52, "timestamp": "00:44:23", "text": "。   何てことだ 。   何てことだ"}, {"type": "subtitle", "time": 2665.52, "timestamp": "00:44:25", "text": "。   何てことだ 。 あの、パリパリの狙撃ショットだよ"}, {"type": "subtitle", "time": 2670.88, "timestamp": "00:44:30", "text": "。 あの、パリパリの狙撃ショットだよ 、兄弟。"}, {"type": "subtitle", "time": 2672.24, "timestamp": "00:44:32", "text": "、兄弟。 ああ、ありがとうございます。"}, {"type": "subtitle", "time": 2673.68, "timestamp": "00:44:33", "text": "ああ、ありがとうございます。 ありがとう。 ありがとう。 私はまだ"}, {"type": "subtitle", "time": 2675.04, "timestamp": "00:44:35", "text": "ありがとう。 ありがとう。 私はまだ ジョーほど上手ではないけれど、まあね。 ありがとう。"}, {"type": "subtitle", "time": 2677.119, "timestamp": "00:44:37", "text": "ジョーほど上手ではないけれど、まあね。 ありがとう。 いいえ、何も。   どけ"}, {"type": "subtitle", "time": 2690.23, "timestamp": "00:44:50", "text": "。"}, {"type": "subtitle", "time": 2692.79, "timestamp": "00:44:52", "text": "え、何？ 彼はかなり高いところにいるから、気を付けて"}, {"type": "subtitle", "time": 2694.71, "timestamp": "00:44:54", "text": "。"}, {"type": "subtitle", "time": 2699.349, "timestamp": "00:44:59", "text": "彼を捕まえろ、ジョー。 何てことだ。 何てことだ。 私はひどくもたついた"}]
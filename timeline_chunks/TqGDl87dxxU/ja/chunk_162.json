[{"type": "subtitle", "time": 9720.71, "timestamp": "02:42:00", "text": "。   こんにちは"}, {"type": "chat", "time": 9721.261, "timestamp": "02:42:01", "author": "@nullZ1R0", "avatar": "https://yt4.ggpht.com/gfCnIq6HKGBm3XIs8AyJerBQ5X47zEsdPfn-Z5Sh_Htnj2P4Pr9WYai35E3WJ639q7ycBjY7=s64-c-k-c0x00ffffff-no-rj", "message": "noice "}, {"type": "subtitle", "time": 9751.83, "timestamp": "02:42:31", "text": "明日の配信にはぜひ遊びに来てください。 たぶん、午後"}, {"type": "subtitle", "time": 9760.07, "timestamp": "02:42:40", "text": "7時頃になると思います。  JSTは、私が言おうとしていたように、"}, {"type": "subtitle", "time": 9765.51, "timestamp": "02:42:45", "text": "こんにちはです。 土曜日は、午前"}, {"type": "subtitle", "time": 9767.67, "timestamp": "02:42:47", "text": "6時から配信をします。何もすることがなければ、もっと"}, {"type": "subtitle", "time": 9771.349, "timestamp": "02:42:51", "text": "早い時間から配信するかもしれません。 えっと、それで"}, {"type": "subtitle", "time": 9773.349, "timestamp": "02:42:53", "text": "明日は早く寝なきゃいけなかったんです。"}, {"type": "subtitle", "time": 9775.349, "timestamp": "02:42:55", "text": "ええ、明日も短い配信を続けましょう"}, {"type": "subtitle", "time": 9778.23, "timestamp": "02:42:58", "text": "。 わかった。 こんにちは。 それでは、さようなら。"}]
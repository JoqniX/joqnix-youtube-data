[{"type": "subtitle", "time": 7205.109, "timestamp": "02:00:05", "text": "栄養満点のご飯を作ってくれて、"}, {"type": "subtitle", "time": 7207.589, "timestamp": "02:00:07", "text": "私は小学校1"}, {"type": "subtitle", "time": 7210.709, "timestamp": "02:00:10", "text": "年生の時にそれを持っていって、いつもマサラの"}, {"type": "subtitle", "time": 7212.229, "timestamp": "02:00:12", "text": "パックを"}, {"type": "subtitle", "time": 7215.51, "timestamp": "02:00:15", "text": "学校に持って行って、みんなが"}, {"type": "subtitle", "time": 7218.629, "timestamp": "02:00:18", "text": "そこにいる時にそれを食べていたんです。そうすると、"}, {"type": "subtitle", "time": 7220.87, "timestamp": "02:00:20", "text": "クラス全員が私と一緒に食べていました。   うんうん"}, {"type": "subtitle", "time": 7222.87, "timestamp": "02:00:22", "text": "。 何てことだ。"}, {"type": "subtitle", "time": 7230.709, "timestamp": "02:00:30", "text": "あなたがいなくて寂しいです。"}, {"type": "subtitle", "time": 7232.87, "timestamp": "02:00:32", "text": "いい感じですね。"}, {"type": "subtitle", "time": 7235.35, "timestamp": "02:00:35", "text": "うん。   何てことだ"}, {"type": "subtitle", "time": 7237.189, "timestamp": "02:00:37", "text": "。"}, {"type": "subtitle", "time": 7237.75, "timestamp": "02:00:37", "text": "ありがとう、"}, {"type": "subtitle", "time": 7239.35, "timestamp": "02:00:39", "text": "兄弟。 最初の立ち寄りが終わる頃には"}, {"type": "subtitle", "time": 7241.109, "timestamp": "02:00:41", "text": "、みんながそれぞれ1袋ずつ持っていた"}, {"type": "subtitle", "time": 7242.55, "timestamp": "02:00:42", "text": "。"}, {"type": "subtitle", "time": 7243.91, "timestamp": "02:00:43", "text": "うん。"}, {"type": "subtitle", "time": 7245.91, "timestamp": "02:00:45", "text": "ええ、わかっています。 ああ、授業中にさえ、そういうものを軽く操作している人を見たことがあるんだけど、"}, {"type": "subtitle", "time": 7254.39, "timestamp": "02:00:54", "text": "「おお、すごいね」って思ったよ。"}, {"type": "subtitle", "time": 7256.79, "timestamp": "02:00:56", "text": "あっという間に広まった。 最初は"}, {"type": "subtitle", "time": 7258.629, "timestamp": "02:00:58", "text": "冗談だったんだけど、みんなが"}]
[{"type": "subtitle", "time": 1263.669, "timestamp": "00:21:03", "text": "シンガポール。 停止。 待って。 ゲームオーバー。 それは"}, {"type": "subtitle", "time": 1265.35, "timestamp": "00:21:05", "text": "正しいですか？ 私には見えません。"}, {"type": "subtitle", "time": 1280.63, "timestamp": "00:21:20", "text": "うん。 だから、大変なことになっているんです。 前に言ったように、途中で"}, {"type": "subtitle", "time": 1290.63, "timestamp": "00:21:30", "text": "こんにちは、カツキさん。 こんにちは。 私は"}, {"type": "subtitle", "time": 1303.51, "timestamp": "00:21:43", "text": "ああ、"}]
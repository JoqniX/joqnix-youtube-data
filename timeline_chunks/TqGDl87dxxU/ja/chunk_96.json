[{"type": "subtitle", "time": 5790.55, "timestamp": "01:36:30", "text": "私だけでしょうか？日本人ってすごく"}, {"type": "subtitle", "time": 5793.03, "timestamp": "01:36:33", "text": "汗っかきですよね？"}, {"type": "subtitle", "time": 5800.55, "timestamp": "01:36:40", "text": "それは、韓国人と"}, {"type": "subtitle", "time": 5802.79, "timestamp": "01:36:42", "text": "日本人が本当に"}, {"type": "subtitle", "time": 5814.55, "timestamp": "01:36:54", "text": "おお、いいね。"}, {"type": "subtitle", "time": 5815.75, "timestamp": "01:36:55", "text": "再装填中。"}]
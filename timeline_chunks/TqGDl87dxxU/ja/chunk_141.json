[{"type": "subtitle", "time": 8461.91, "timestamp": "02:21:01", "text": "最後の試合を最後にしなければなりません。 ルームメイトが来るよ。 ええと、"}, {"type": "subtitle", "time": 8463.03, "timestamp": "02:21:03", "text": "お客様がいらっしゃいます。"}, {"type": "subtitle", "time": 8465.349, "timestamp": "02:21:05", "text": "私も同じです。"}, {"type": "subtitle", "time": 8467.19, "timestamp": "02:21:07", "text": "うん、終わらせよう。"}, {"type": "subtitle", "time": 8483.83, "timestamp": "02:21:23", "text": "上がった。"}, {"type": "subtitle", "time": 8487.51, "timestamp": "02:21:27", "text": "冗談はもう終わりだ。 お前は死んだ。"}, {"type": "subtitle", "time": 8490.55, "timestamp": "02:21:30", "text": "彼はどうやって"}, {"type": "subtitle", "time": 8491.27, "timestamp": "02:21:31", "text": "見つけたんだ？"}, {"type": "subtitle", "time": 8493.67, "timestamp": "02:21:33", "text": "ああ、なんてことだ。 後ろから誰かが来るような気がする"}, {"type": "subtitle", "time": 8514.389, "timestamp": "02:21:54", "text": "敵はあと一体。"}]
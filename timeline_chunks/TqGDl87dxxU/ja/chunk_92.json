[{"type": "subtitle", "time": 5520.39, "timestamp": "01:32:00", "text": "ええ、"}, {"type": "subtitle", "time": 5522.629, "timestamp": "01:32:02", "text": "あなたの植物は素晴らしいですね。 あなたは"}, {"type": "subtitle", "time": 5525.11, "timestamp": "01:32:05", "text": "毎回、適切な場所に種を蒔いていますね。"}, {"type": "subtitle", "time": 5528.149, "timestamp": "01:32:08", "text": "ええ、文字通り毎回です。"}, {"type": "subtitle", "time": 5530.149, "timestamp": "01:32:10", "text": "うん、サンセットマップでも君は本当に"}, {"type": "subtitle", "time": 5532.55, "timestamp": "01:32:12", "text": "素晴らしい活躍をしているね。"}, {"type": "subtitle", "time": 5533.91, "timestamp": "01:32:13", "text": "ええ、自分は"}, {"type": "subtitle", "time": 5538.709, "timestamp": "01:32:18", "text": "最善を尽くしていると思っていました。"}, {"type": "subtitle", "time": 5540.55, "timestamp": "01:32:20", "text": "いや、いや、いや。 あなたは素晴らしいです。"}, {"type": "subtitle", "time": 5541.43, "timestamp": "01:32:21", "text": "いや、いや、いや。"}, {"type": "subtitle", "time": 5542.07, "timestamp": "01:32:22", "text": "素晴らしい。"}, {"type": "subtitle", "time": 5543.75, "timestamp": "01:32:23", "text": "あなたは素晴らしいです。 このゲームは"}, {"type": "subtitle", "time": 5546.149, "timestamp": "01:32:26", "text": "キル数だけを重視しているわけではない。 いいえ、"}, {"type": "subtitle", "time": 5548.39, "timestamp": "01:32:28", "text": "スパイクにもサポートがあります。"}, {"type": "subtitle", "time": 5550.149, "timestamp": "01:32:30", "text": "後ろを振り返ることで、"}, {"type": "subtitle", "time": 5551.75, "timestamp": "01:32:31", "text": "人々が心配する必要がなくなるようなものだ。 君は"}, {"type": "subtitle", "time": 5555.03, "timestamp": "01:32:35", "text": "サポート役として素晴らしい働きをしているよ、兄弟。"}, {"type": "subtitle", "time": 5555.59, "timestamp": "01:32:35", "text": "真実。"}, {"type": "subtitle", "time": 5557.83, "timestamp": "01:32:37", "text": "待って、初めてプレイしているのは私だけ"}, {"type": "subtitle", "time": 5561.189, "timestamp": "01:32:41", "text": "？"}, {"type": "subtitle", "time": 5562.55, "timestamp": "01:32:42", "text": "ええ、そうですね"}, {"type": "subtitle", "time": 5564.55, "timestamp": "01:32:44", "text": "。"}, {"type": "subtitle", "time": 5564.87, "timestamp": "01:32:44", "text": "うん。"}, {"type": "subtitle", "time": 5566.629, "timestamp": "01:32:46", "text": "ああ、"}, {"type": "subtitle", "time": 5571.59, "timestamp": "01:32:51", "text": "先輩はプラチナ級ですね。 ええと、そう言ってるんだけど、"}, {"type": "subtitle", "time": 5573.189, "timestamp": "01:32:53", "text": "彼はプラスチックで覆われてるんだ。   わかった"}, {"type": "subtitle", "time": 5573.669, "timestamp": "01:32:53", "text": "。 だから、"}, {"type": "subtitle", "time": 5575.27, "timestamp": "01:32:55", "text": "私はプラスチックの中にいるんです。"}, {"type": "subtitle", "time": 5576.709, "timestamp": "01:32:56", "text": "素晴らしいプレーだった。"}, {"type": "subtitle", "time": 5578.79, "timestamp": "01:32:58", "text": "すべてのプラチナは、何でも言っています"}]
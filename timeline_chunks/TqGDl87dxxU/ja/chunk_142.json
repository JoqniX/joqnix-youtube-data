[{"type": "subtitle", "time": 8527.75, "timestamp": "02:22:07", "text": "えっと、あなたを買うことはできますか？"}, {"type": "subtitle", "time": 8528.63, "timestamp": "02:22:08", "text": "うん。"}, {"type": "subtitle", "time": 8541.429, "timestamp": "02:22:21", "text": "インディアナから昔やっていたように、好きなだけハウス"}, {"type": "subtitle", "time": 8544.23, "timestamp": "02:22:24", "text": "マッチをプレイすることはできないということを忘れてしまった。 ルームメイトがいることを忘れていた"}, {"type": "subtitle", "time": 8545.59, "timestamp": "02:22:25", "text": "。"}, {"type": "subtitle", "time": 8548.15, "timestamp": "02:22:28", "text": "私は別のタイムゾーンにいます。"}, {"type": "subtitle", "time": 8549.91, "timestamp": "02:22:29", "text": "明日仕事がある。 私は今でもあなたの途切れることのない長いストリームを覚えています"}, {"type": "subtitle", "time": 8571.99, "timestamp": "02:22:51", "text": "いや。"}, {"type": "subtitle", "time": 8574.55, "timestamp": "02:22:54", "text": "敵を倒した。"}, {"type": "subtitle", "time": 8576.07, "timestamp": "02:22:56", "text": "脱落。 ニース。"}]
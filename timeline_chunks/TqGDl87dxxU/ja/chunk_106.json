[{"type": "subtitle", "time": 6361.76, "timestamp": "01:46:01", "text": "。 ありがとう。"}, {"type": "subtitle", "time": 6363.28, "timestamp": "01:46:03", "text": "ありがとう。 私と私の"}, {"type": "subtitle", "time": 6364.639, "timestamp": "01:46:04", "text": "私と私の ふざけた行動を招いてくださり、ありがとうございました。"}, {"type": "subtitle", "time": 6375.51, "timestamp": "01:46:15", "text": "ありがとう。 ありがとう。"}, {"type": "subtitle", "time": 6376.31, "timestamp": "01:46:16", "text": "私も少し楽しんだよ。"}, {"type": "subtitle", "time": 6379.43, "timestamp": "01:46:19", "text": "すごく楽しかったよ、兄弟。"}, {"type": "subtitle", "time": 6381.51, "timestamp": "01:46:21", "text": "最高だったよ、兄弟。 最高だったよ。"}, {"type": "subtitle", "time": 6383.51, "timestamp": "01:46:23", "text": "クリップ映像もたくさん入手しました。 つまり、"}, {"type": "subtitle", "time": 6384.55, "timestamp": "01:46:24", "text": "それはコンテンツですね。"}, {"type": "subtitle", "time": 6386.31, "timestamp": "01:46:26", "text": "ええ、確かに。"}, {"type": "subtitle", "time": 6388.07, "timestamp": "01:46:28", "text": "実際に。   もちろんさ"}, {"type": "subtitle", "time": 6389.109, "timestamp": "01:46:29", "text": "。"}, {"type": "chat", "time": 6389.66, "timestamp": "01:46:29", "author": "@Anshikaa-0ok", "avatar": "https://yt4.ggpht.com/TpeznIQ2yHK6m0yofUjDvHTiYNjCZYhnen9pplJLGn4RRsUvCKplgQzxRgGHZZr4CVUpYpK4=s64-c-k-c0x00ffffff-no-rj", "message": "Bye have a nice day"}, {"type": "subtitle", "time": 6390.55, "timestamp": "01:46:30", "text": "これは誰にとっても楽しめるコンテンツです。   何度も"}, {"type": "subtitle", "time": 6393.43, "timestamp": "01:46:33", "text": "死にかけたけど、それでも楽しかった。"}, {"type": "subtitle", "time": 6394.47, "timestamp": "01:46:34", "text": "大丈夫。"}, {"type": "subtitle", "time": 6397.75, "timestamp": "01:46:37", "text": "あなたは素晴らしかった。 君はすごくかっこよかったよ。"}, {"type": "subtitle", "time": 6400.79, "timestamp": "01:46:40", "text": "君は試合の生命線だったよ、兄弟。"}, {"type": "subtitle", "time": 6402.229, "timestamp": "01:46:42", "text": "文字通り。"}, {"type": "subtitle", "time": 6404.149, "timestamp": "01:46:44", "text": "本当に？"}, {"type": "subtitle", "time": 6405.51, "timestamp": "01:46:45", "text": "ああ、そうだよ。"}, {"type": "subtitle", "time": 6408.709, "timestamp": "01:46:48", "text": "誰に聞いてもわかるよ、兄弟。 誰に聞いても構わない。 わかった。"}, {"type": "subtitle", "time": 6410.87, "timestamp": "01:46:50", "text": "吉野先輩。"}, {"type": "subtitle", "time": 6413.27, "timestamp": "01:46:53", "text": "カイはそこにいて、「うん」って言ってなかったっけ。 うん。 うん。"}, {"type": "subtitle", "time": 6414.629, "timestamp": "01:46:54", "text": "カイ、君はチームの支えだった。"}, {"type": "subtitle", "time": 6417.27, "timestamp": "01:46:57", "text": "私が初心者だった頃は、"}, {"type": "subtitle", "time": 6419.59, "timestamp": "01:46:59", "text": "銃の拾い方すら分からなかったのに、彼女はまるで完璧に、"}]
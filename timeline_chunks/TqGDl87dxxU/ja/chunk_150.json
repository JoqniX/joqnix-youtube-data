[{"type": "subtitle", "time": 9002.79, "timestamp": "02:30:02", "text": "配信をしたいと思っていますが、おそらく"}, {"type": "subtitle", "time": 9005.99, "timestamp": "02:30:05", "text": "音楽配信が中心になるでしょう。"}, {"type": "subtitle", "time": 9008.07, "timestamp": "02:30:08", "text": "でも、たまにゲーム配信もします"}, {"type": "subtitle", "time": 9009.91, "timestamp": "02:30:09", "text": "。 できません。"}, {"type": "subtitle", "time": 9014.71, "timestamp": "02:30:14", "text": "時間の無駄なのでやりたくありません。 でも明日は金曜日だ。"}, {"type": "subtitle", "time": 9018.309, "timestamp": "02:30:18", "text": "金曜日のプロ、えっと、金曜日。 あ、ちょっと待って、私には"}, {"type": "subtitle", "time": 9020.87, "timestamp": "02:30:20", "text": "予定があるんです。"}, {"type": "chat", "time": 9022.666, "timestamp": "02:30:22", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "mhm mhm sankyou"}, {"type": "subtitle", "time": 9023.03, "timestamp": "02:30:23", "text": "金曜日って何？ えっと、"}, {"type": "subtitle", "time": 9032.389, "timestamp": "02:30:32", "text": "金曜日。 えっと、その日は朝から"}, {"type": "subtitle", "time": 9038.87, "timestamp": "02:30:38", "text": "あなたと一緒にプレイする配信ができたんです。 ありがとうございます。 とても"}, {"type": "subtitle", "time": 9041.83, "timestamp": "02:30:41", "text": "嬉しいです。 私は"}, {"type": "subtitle", "time": 9053.67, "timestamp": "02:30:53", "text": "今別の地域にいるため、皆さんの足を引っ張ってしまうのではないかととても心配していました。 だから、痛みも今、感じている"}, {"type": "subtitle", "time": 9057.27, "timestamp": "02:30:57", "text": "。 とても楽しかったです。 こんにちは、レッド。"}, {"type": "subtitle", "time": 9059.59, "timestamp": "02:30:59", "text": "いらっしゃいませ。   というわけで"}]
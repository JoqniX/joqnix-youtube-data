[{"type": "subtitle", "time": 2881.03, "timestamp": "00:48:01", "text": "。 わかった。 では、ええと、数えましょう"}, {"type": "subtitle", "time": 2913.75, "timestamp": "00:48:33", "text": "パソコンでフレームレート（FPS）を上げるにはどうすればいいですか？"}, {"type": "subtitle", "time": 2916.309, "timestamp": "00:48:36", "text": "あ、待って。 いくら？ いくら？"}, {"type": "subtitle", "time": 2918.309, "timestamp": "00:48:38", "text": "入手方法"}, {"type": "subtitle", "time": 2921.43, "timestamp": "00:48:41", "text": "現在、180です。"}, {"type": "subtitle", "time": 2922.95, "timestamp": "00:48:42", "text": "変動しています。"}, {"type": "subtitle", "time": 2924.71, "timestamp": "00:48:44", "text": "配信しているからかもしれない。"}, {"type": "subtitle", "time": 2927.349, "timestamp": "00:48:47", "text": "おお。"}, {"type": "subtitle", "time": 2929.75, "timestamp": "00:48:49", "text": "ああ、フルスクリーンですね。 全画面表示でプレイするのを忘れていました"}, {"type": "subtitle", "time": 2932.309, "timestamp": "00:48:52", "text": "。"}, {"type": "subtitle", "time": 2933.43, "timestamp": "00:48:53", "text": "よし、行こう。"}, {"type": "subtitle", "time": 2936.15, "timestamp": "00:48:56", "text": "フルスクリーンじゃなかったのに、君はすごく上手くプレイしてたよ、兄弟。"}, {"type": "subtitle", "time": 2938.79, "timestamp": "00:48:58", "text": "おお。 うわー、すごいね。   何てことだ"}]
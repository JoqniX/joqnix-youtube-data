[{"type": "subtitle", "time": 3725.19, "timestamp": "01:02:05", "text": "毎回本当に最悪だよ、兄弟。   とんでも"}, {"type": "subtitle", "time": 3730.87, "timestamp": "01:02:10", "text": "ここには人がいる。"}, {"type": "subtitle", "time": 3742.549, "timestamp": "01:02:22", "text": "Aですか、Bですか、それともAですか？ 右。"}, {"type": "subtitle", "time": 3750.95, "timestamp": "01:02:30", "text": "ああ、だめだ。 遊びたい？ 遊ぼう。"}, {"type": "subtitle", "time": 3754.789, "timestamp": "01:02:34", "text": "あなたの真上です。 最後に残ったプレイヤー。"}, {"type": "subtitle", "time": 3771.27, "timestamp": "01:02:51", "text": "勝利。"}, {"type": "subtitle", "time": 3774.069, "timestamp": "01:02:54", "text": "それはピンク色の差分だった。"}]
[{"type": "subtitle", "time": 9181.03, "timestamp": "02:33:01", "text": "ええと、"}, {"type": "subtitle", "time": 9206.95, "timestamp": "02:33:26", "text": "、これから"}, {"type": "subtitle", "time": 9208.63, "timestamp": "02:33:28", "text": "もっと日本語で話したり、"}, {"type": "subtitle", "time": 9211.27, "timestamp": "02:33:31", "text": "日本語で話したことを英語に翻訳したりするように頑張ります。"}, {"type": "chat", "time": 9211.886, "timestamp": "02:33:31", "author": "@YoshinoForger", "avatar": "https://yt4.ggpht.com/8gvoFZRCC3O1WtnuXJ-8nNaJku7JJTjtn6w5sm-PHzI80a-qpWom6sTXzcrDXoKhi0Ggs3FkOg=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ-7tIYCO_9EPt-GMgAwUCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ-7tIYCO_9EPt-GMgAwUCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ-7tIYCO_9EPt-GMgAw"}, {"type": "subtitle", "time": 9215.11, "timestamp": "02:33:35", "text": "ですから、どうぞ英語で「いいね！」やコメントをしてください"}, {"type": "subtitle", "time": 9218.95, "timestamp": "02:33:38", "text": "。 まず"}, {"type": "subtitle", "time": 9220.71, "timestamp": "02:33:40", "text": "英語のコメントを読んでから"}, {"type": "subtitle", "time": 9223.27, "timestamp": "02:33:43", "text": "日本語に翻訳できます。"}, {"type": "subtitle", "time": 9225.99, "timestamp": "02:33:45", "text": "最善を尽くします。 こんにちは。"}, {"type": "subtitle", "time": 9232.55, "timestamp": "02:33:52", "text": "背景など、設定しなければならないことがたくさんあるんです。 まるで無地の青い"}, {"type": "subtitle", "time": 9235.59, "timestamp": "02:33:55", "text": "背景みたいだ。 たくさんのこと。 ええ、"}, {"type": "chat", "time": 9236.218, "timestamp": "02:33:56", "author": "@YoshinoForger", "avatar": "https://yt4.ggpht.com/8gvoFZRCC3O1WtnuXJ-8nNaJku7JJTjtn6w5sm-PHzI80a-qpWom6sTXzcrDXoKhi0Ggs3FkOg=s64-c-k-c0x00ffffff-no-rj", "message": "ganbatte ne joq san"}, {"type": "subtitle", "time": 9239.99, "timestamp": "02:33:59", "text": "ゆっくり進めましょう。 ゆっくりと、しかし確実に。 こんにちは。"}]
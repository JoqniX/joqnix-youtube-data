[{"type": "subtitle", "time": 606.23, "timestamp": "00:10:06", "text": "音声メーターは、えーと、あなたの"}, {"type": "subtitle", "time": 610.63, "timestamp": "00:10:10", "text": "脳には負担が大きすぎます。 それはやりすぎだ。 私は死にかけている。"}, {"type": "subtitle", "time": 612.47, "timestamp": "00:10:12", "text": "うん。   わかった"}, {"type": "subtitle", "time": 616.069, "timestamp": "00:10:16", "text": "。 やらせて。そうするべき？うん、"}, {"type": "subtitle", "time": 618.79, "timestamp": "00:10:18", "text": "大丈夫だと思うよ。 認めるべきだろうか？ 待って、"}, {"type": "subtitle", "time": 622.87, "timestamp": "00:10:22", "text": "カイドがここにいるはずだけど、"}, {"type": "subtitle", "time": 632.949, "timestamp": "00:10:32", "text": "。 うん、その方がいいだろう。"}, {"type": "subtitle", "time": 635.269, "timestamp": "00:10:35", "text": "うん。 私が誰と話しているのか、誰も知らないだろう"}]
[{"type": "subtitle", "time": 3602.87, "timestamp": "01:00:02", "text": "彼が私たちに隠していたやり方が問題なんです。   まるで"}, {"type": "subtitle", "time": 3605.27, "timestamp": "01:00:05", "text": "Forsakenみたいだ。 たぶんForsakenみたいな感じかな"}, {"type": "subtitle", "time": 3608.23, "timestamp": "01:00:08", "text": "。"}, {"type": "subtitle", "time": 3609.829, "timestamp": "01:00:09", "text": "ああ、想像してみて。 ああ、神様。"}, {"type": "subtitle", "time": 3613.109, "timestamp": "01:00:13", "text": "遊びたい？ 遊ぼう。"}, {"type": "subtitle", "time": 3618.15, "timestamp": "01:00:18", "text": "準備完了。   なんてこった。"}, {"type": "subtitle", "time": 3622.39, "timestamp": "01:00:22", "text": "彼はそこにたった一人だった。"}, {"type": "subtitle", "time": 3624.39, "timestamp": "01:00:24", "text": "さあ、Pさん、行こう。よし、誰もいないね。 来てごらん。 来てごらん。"}, {"type": "subtitle", "time": 3625.43, "timestamp": "01:00:25", "text": "誰もいない。   どうぞ"}, {"type": "subtitle", "time": 3626.87, "timestamp": "01:00:26", "text": "。   ここに"}, {"type": "subtitle", "time": 3629.19, "timestamp": "01:00:29", "text": "来て。 ここに来て。"}, {"type": "subtitle", "time": 3631.99, "timestamp": "01:00:31", "text": "彼は天国のOPみたいなものだ。 はい、気をつけてください"}, {"type": "subtitle", "time": 3633.589, "timestamp": "01:00:33", "text": "。 スパイクが植えられました。"}, {"type": "subtitle", "time": 3635.75, "timestamp": "01:00:35", "text": "ナイフを抜いて、"}, {"type": "subtitle", "time": 3642.71, "timestamp": "01:00:42", "text": "散らすものは何もない。"}, {"type": "subtitle", "time": 3649.67, "timestamp": "01:00:49", "text": "。 私の"}, {"type": "subtitle", "time": 3651.51, "timestamp": "01:00:51", "text": "待ち時間は短いです。 彼はプレーを続けるだろう。"}, {"type": "subtitle", "time": 3655.349, "timestamp": "01:00:55", "text": "スパイクをタップするだけです。"}, {"type": "subtitle", "time": 3657.67, "timestamp": "01:00:57", "text": "敵はあと一体。"}, {"type": "subtitle", "time": 3657.91, "timestamp": "01:00:57", "text": "よし、"}, {"type": "subtitle", "time": 3659.19, "timestamp": "01:00:59", "text": "君なら勝てる。 事態を収拾できます。 行け！行け！"}]
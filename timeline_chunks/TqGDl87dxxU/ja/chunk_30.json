[{"type": "subtitle", "time": 1813.35, "timestamp": "00:30:13", "text": "一緒に戦いに行こう。"}, {"type": "subtitle", "time": 1817.269, "timestamp": "00:30:17", "text": "おい、2人組で"}, {"type": "subtitle", "time": 1833.35, "timestamp": "00:30:33", "text": "敵を発見。  A地点にスパイクを落としてください。"}, {"type": "subtitle", "time": 1835.669, "timestamp": "00:30:35", "text": "敵はあと1体残っています。   何てことだ"}, {"type": "subtitle", "time": 1836.399, "timestamp": "00:30:36", "text": "。   何てことだ 。   さあ行こう"}, {"type": "subtitle", "time": 1838.88, "timestamp": "00:30:38", "text": "。   さあ行こう 。"}, {"type": "subtitle", "time": 1851.029, "timestamp": "00:30:51", "text": "彼女は自分の能力を隠していた。"}, {"type": "subtitle", "time": 1852.95, "timestamp": "00:30:52", "text": "彼女は彼らを撃った。"}, {"type": "chat", "time": 1855.36, "timestamp": "00:30:55", "author": "@Bunny_cutu108", "avatar": "https://yt4.ggpht.com/AXMhGlyclaujICGi4XU5I_LqljHooYve6vxvfFNIdEVdsfGvxjDreYWCi-lFFqQJI6UjShJGPw=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2AkUCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2AkUCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2Ak"}]
[{"type": "subtitle", "time": 2342.71, "timestamp": "00:39:02", "text": "兄弟。"}, {"type": "subtitle", "time": 2345.91, "timestamp": "00:39:05", "text": "私はただ走りながら撃つだけです。"}, {"type": "subtitle", "time": 2346.31, "timestamp": "00:39:06", "text": "いや。   何てことだ"}, {"type": "subtitle", "time": 2347.51, "timestamp": "00:39:07", "text": "。"}, {"type": "subtitle", "time": 2349.27, "timestamp": "00:39:09", "text": "彼はヴァレラントをプレイしていない。 彼は"}, {"type": "subtitle", "time": 2350.31, "timestamp": "00:39:10", "text": "Apex Legendsをプレイしている。"}, {"type": "subtitle", "time": 2355.43, "timestamp": "00:39:15", "text": "えっと、実は私、Apexが下手なんです。"}, {"type": "subtitle", "time": 2357.829, "timestamp": "00:39:17", "text": "それももう一つの点です。"}, {"type": "subtitle", "time": 2361.67, "timestamp": "00:39:21", "text": "何？ ああ、なんてこった。 何てことだ。"}, {"type": "subtitle", "time": 2362.47, "timestamp": "00:39:22", "text": "遊ぼう。"}, {"type": "subtitle", "time": 2363.67, "timestamp": "00:39:23", "text": "カイドウはもう終わりだと思う。"}, {"type": "subtitle", "time": 2371.349, "timestamp": "00:39:31", "text": "おお。"}, {"type": "subtitle", "time": 2372.47, "timestamp": "00:39:32", "text": "ああ、私は殺された。"}, {"type": "subtitle", "time": 2379.51, "timestamp": "00:39:39", "text": "はぁ？"}, {"type": "subtitle", "time": 2381.829, "timestamp": "00:39:41", "text": "最後に残ったプレイヤー。"}, {"type": "subtitle", "time": 2383.27, "timestamp": "00:39:43", "text": "私の狙いは最高だ。"}, {"type": "subtitle", "time": 2396.71, "timestamp": "00:39:56", "text": "。 彼はどこにいますか？   何てことだ"}]
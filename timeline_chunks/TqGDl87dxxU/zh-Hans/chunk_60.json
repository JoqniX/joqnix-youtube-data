[{"type": "subtitle", "time": 3602.87, "timestamp": "01:00:02", "text": "是他一直瞒着我们。   就像《"}, {"type": "subtitle", "time": 3605.27, "timestamp": "01:00:05", "text": "被遗弃者》一样。 或许像被遗弃者那样吧"}, {"type": "subtitle", "time": 3608.23, "timestamp": "01:00:08", "text": "。"}, {"type": "subtitle", "time": 3609.829, "timestamp": "01:00:09", "text": "哦，真是难以想象。 我的天哪。"}, {"type": "subtitle", "time": 3613.109, "timestamp": "01:00:13", "text": "你想玩吗？ 让我们玩。"}, {"type": "subtitle", "time": 3618.15, "timestamp": "01:00:18", "text": "准备好了。"}, {"type": "subtitle", "time": 3622.39, "timestamp": "01:00:22", "text": "哦，不。 他当时独自一人待在那里。"}, {"type": "subtitle", "time": 3624.39, "timestamp": "01:00:24", "text": "走吧，P。好的，这里没人。 过来就好"}, {"type": "subtitle", "time": 3625.43, "timestamp": "01:00:25", "text": "。 过来就好。 这里没人。"}, {"type": "subtitle", "time": 3626.87, "timestamp": "01:00:26", "text": "前进。"}, {"type": "subtitle", "time": 3629.19, "timestamp": "01:00:29", "text": "过来。 过来。"}, {"type": "subtitle", "time": 3631.99, "timestamp": "01:00:31", "text": "他就像天堂里的OP一样。 好的，"}, {"type": "subtitle", "time": 3633.589, "timestamp": "01:00:33", "text": "小心点。 已种下穗。"}, {"type": "subtitle", "time": 3635.75, "timestamp": "01:00:35", "text": "你可以拔出刀，然后"}, {"type": "subtitle", "time": 3636.95, "timestamp": "01:00:36", "text": "跑得更快，因为"}, {"type": "subtitle", "time": 3642.71, "timestamp": "01:00:42", "text": "不受干扰。"}, {"type": "subtitle", "time": 3649.67, "timestamp": "01:00:49", "text": "不错。 我的"}, {"type": "subtitle", "time": 3651.51, "timestamp": "01:00:51", "text": "等待时间很短。 他还要继续比赛。   轻轻"}, {"type": "subtitle", "time": 3655.349, "timestamp": "01:00:55", "text": "敲击尖刺即可。"}, {"type": "subtitle", "time": 3657.67, "timestamp": "01:00:57", "text": "还剩一个敌人。"}, {"type": "subtitle", "time": 3657.91, "timestamp": "01:00:57", "text": "好吧，"}, {"type": "subtitle", "time": 3659.19, "timestamp": "01:00:59", "text": "你可以打败它。 你可以拆除它。 去！去！"}]
[{"type": "subtitle", "time": 6061.27, "timestamp": "01:41:01", "text": "治愈治愈。"}, {"type": "subtitle", "time": 6063.43, "timestamp": "01:41:03", "text": "按E键。好的。   是的"}, {"type": "subtitle", "time": 6064.39, "timestamp": "01:41:04", "text": "。"}, {"type": "subtitle", "time": 6065.99, "timestamp": "01:41:05", "text": "呃，现在点击鼠标左键。"}, {"type": "subtitle", "time": 6066.629, "timestamp": "01:41:06", "text": "点击。"}, {"type": "subtitle", "time": 6072.629, "timestamp": "01:41:12", "text": "等待。 你真的做到了。 左边。"}, {"type": "subtitle", "time": 6073.03, "timestamp": "01:41:13", "text": "单击鼠标左键。"}, {"type": "subtitle", "time": 6075.83, "timestamp": "01:41:15", "text": "等待。 回合开始前。"}, {"type": "subtitle", "time": 6078.229, "timestamp": "01:41:18", "text": "哦，他从"}, {"type": "subtitle", "time": 6079.35, "timestamp": "01:41:19", "text": "破损的地方跳了下来。   是的"}, {"type": "subtitle", "time": 6079.75, "timestamp": "01:41:19", "text": "。"}, {"type": "subtitle", "time": 6081.59, "timestamp": "01:41:21", "text": "是的，我起步的时候犯了错。 你"}, {"type": "subtitle", "time": 6082.79, "timestamp": "01:41:22", "text": "不能。"}, {"type": "subtitle", "time": 6083.669, "timestamp": "01:41:23", "text": "你可以。 你可以。"}, {"type": "subtitle", "time": 6084.55, "timestamp": "01:41:24", "text": "该死。"}, {"type": "subtitle", "time": 6097.189, "timestamp": "01:41:37", "text": "哦，等等。 我杀了两个。"}, {"type": "subtitle", "time": 6098.149, "timestamp": "01:41:38", "text": "什么？"}, {"type": "subtitle", "time": 6098.87, "timestamp": "01:41:38", "text": "真快。"}, {"type": "subtitle", "time": 6100.31, "timestamp": "01:41:40", "text": "我的天啊。"}, {"type": "subtitle", "time": 6103.75, "timestamp": "01:41:43", "text": "好的。"}, {"type": "subtitle", "time": 6106.629, "timestamp": "01:41:46", "text": "哇。 抵押品。"}, {"type": "subtitle", "time": 6109.75, "timestamp": "01:41:49", "text": "疯狂的。 好吧，那个日本人其实是在他们"}, {"type": "subtitle", "time": 6112.629, "timestamp": "01:41:52", "text": "身后绕后。 我们升级了。"}, {"type": "subtitle", "time": 6113.59, "timestamp": "01:41:53", "text": "还剩一个敌人。   是的"}, {"type": "subtitle", "time": 6115.91, "timestamp": "01:41:55", "text": "。 我们走吧。   是的"}]
[{"type": "subtitle", "time": 5220.0, "timestamp": "01:27:00", "text": "你知道是怎么回事一样，这样 每次"}, {"type": "subtitle", "time": 5221.6, "timestamp": "01:27:01", "text": "每次 系统都会显示他们挂机。"}, {"type": "subtitle", "time": 5225.84, "timestamp": "01:27:05", "text": "系统都会显示他们挂机。 嗯。"}, {"type": "subtitle", "time": 5231.91, "timestamp": "01:27:11", "text": "兄弟，情况还没那么糟。 就像"}, {"type": "subtitle", "time": 5243.35, "timestamp": "01:27:23", "text": "天哪，我是怎么活下来的？"}, {"type": "subtitle", "time": 5252.47, "timestamp": "01:27:32", "text": "嘿，兄弟"}, {"type": "subtitle", "time": 5253.75, "timestamp": "01:27:33", "text": "，真抱歉。"}, {"type": "subtitle", "time": 5255.59, "timestamp": "01:27:35", "text": "高手。 我的天哪，我拿不到Ace。"}, {"type": "subtitle", "time": 5258.709, "timestamp": "01:27:38", "text": "我的天啊。 好了，我们走吧。 我们走吧。 我要走了"}, {"type": "subtitle", "time": 5259.83, "timestamp": "01:27:39", "text": "。"}, {"type": "subtitle", "time": 5261.669, "timestamp": "01:27:41", "text": "在哪里？ 在哪里？ 在哪里？ 在哪里？"}, {"type": "subtitle", "time": 5262.95, "timestamp": "01:27:42", "text": "这里。 这里。"}, {"type": "subtitle", "time": 5265.27, "timestamp": "01:27:45", "text": "请下来。 当着我的面开玩笑。"}, {"type": "subtitle", "time": 5266.629, "timestamp": "01:27:46", "text": "在哪里？"}, {"type": "subtitle", "time": 5268.31, "timestamp": "01:27:48", "text": "快点。 开玩笑。 开玩笑。 开玩笑。 是的。"}, {"type": "subtitle", "time": 5269.59, "timestamp": "01:27:49", "text": "在哪里？ 等待。"}, {"type": "subtitle", "time": 5270.07, "timestamp": "01:27:50", "text": "我打算"}, {"type": "subtitle", "time": 5271.43, "timestamp": "01:27:51", "text": "等等。 等待。 我将从"}, {"type": "subtitle", "time": 5272.95, "timestamp": "01:27:52", "text": "背后摧毁一切。   是的"}]
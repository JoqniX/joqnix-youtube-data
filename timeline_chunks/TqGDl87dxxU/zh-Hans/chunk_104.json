[{"type": "subtitle", "time": 6250.31, "timestamp": "01:44:10", "text": "？ 哦，是的。 你的子弹还在"}, {"type": "subtitle", "time": 6252.87, "timestamp": "01:44:12", "text": "枪里。 你还记得那5秒钟吗？"}, {"type": "subtitle", "time": 6254.47, "timestamp": "01:44:14", "text": "他们来自未来，是吗？"}, {"type": "subtitle", "time": 6256.47, "timestamp": "01:44:16", "text": "我懂了。   是的"}, {"type": "subtitle", "time": 6259.189, "timestamp": "01:44:19", "text": "。"}, {"type": "subtitle", "time": 6263.51, "timestamp": "01:44:23", "text": "瞧，乔又在炫耀他的肌肉了，兄弟。"}, {"type": "subtitle", "time": 6265.75, "timestamp": "01:44:25", "text": "他可是世界级人物，兄弟。 粉色并不能定义"}, {"type": "subtitle", "time": 6267.59, "timestamp": "01:44:27", "text": "他，兄弟。"}, {"type": "subtitle", "time": 6269.91, "timestamp": "01:44:29", "text": "不，兄弟。 他可是全球知名的，兄弟。 他"}, {"type": "subtitle", "time": 6272.149, "timestamp": "01:44:32", "text": "居然在后备队里，兄弟。  Paper"}, {"type": "subtitle", "time": 6273.189, "timestamp": "01:44:33", "text": "X。"}, {"type": "subtitle", "time": 6275.189, "timestamp": "01:44:35", "text": "是的，我知道。   当然"}, {"type": "subtitle", "time": 6276.07, "timestamp": "01:44:36", "text": "，兄弟。"}, {"type": "subtitle", "time": 6278.07, "timestamp": "01:44:38", "text": "你为什么会有“哦”？ 哦，你回"}, {"type": "subtitle", "time": 6279.03, "timestamp": "01:44:39", "text": "新加坡了。   是的"}, {"type": "subtitle", "time": 6280.79, "timestamp": "01:44:40", "text": "。 是的。 我们应该回"}, {"type": "subtitle", "time": 6283.35, "timestamp": "01:44:43", "text": "新加坡吗？ 你以后还想去吗"}, {"type": "subtitle", "time": 6286.709, "timestamp": "01:44:46", "text": "？ 不，回到过去。   这"}, {"type": "subtitle", "time": 6288.47, "timestamp": "01:44:48", "text": "告诉我，无论未来如何，无论身在"}, {"type": "subtitle", "time": 6290.709, "timestamp": "01:44:50", "text": "何处，我都安然无恙。 但实际上并没有什么"}, {"type": "subtitle", "time": 6292.07, "timestamp": "01:44:52", "text": "区别。   是"}, {"type": "subtitle", "time": 6293.669, "timestamp": "01:44:53", "text": "啊，未来一片黯淡。"}]
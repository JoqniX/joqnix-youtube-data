[{"type": "subtitle", "time": 7500.47, "timestamp": "02:05:00", "text": "接受治疗。 承受压力。"}, {"type": "subtitle", "time": 7504.47, "timestamp": "02:05:04", "text": "哦，这太酷了。 这家伙可能会反悔，因为他"}, {"type": "subtitle", "time": 7507.589, "timestamp": "02:05:07", "text": "破坏了愈合过程。"}, {"type": "subtitle", "time": 7511.03, "timestamp": "02:05:11", "text": "你知道吗？ 他现在还剩下93个。"}, {"type": "subtitle", "time": 7511.669, "timestamp": "02:05:11", "text": "抱歉。"}, {"type": "subtitle", "time": 7514.07, "timestamp": "02:05:14", "text": "如何重新装弹？"}, {"type": "subtitle", "time": 7515.83, "timestamp": "02:05:15", "text": "我的天啊。"}, {"type": "subtitle", "time": 7517.51, "timestamp": "02:05:17", "text": "它不起作用。"}, {"type": "subtitle", "time": 7518.95, "timestamp": "02:05:18", "text": "还在纠结中。 仍在"}, {"type": "subtitle", "time": 7519.99, "timestamp": "02:05:19", "text": "绑定上。   是的"}, {"type": "subtitle", "time": 7521.75, "timestamp": "02:05:21", "text": "。"}, {"type": "subtitle", "time": 7524.229, "timestamp": "02:05:24", "text": "呃，"}, {"type": "subtitle", "time": 7527.43, "timestamp": "02:05:27", "text": "减益效果是真实存在的，兄弟。"}, {"type": "subtitle", "time": 7527.99, "timestamp": "02:05:27", "text": "哦，"}, {"type": "subtitle", "time": 7529.27, "timestamp": "02:05:29", "text": "你刚才说的是……"}, {"type": "subtitle", "time": 7531.669, "timestamp": "02:05:31", "text": "现在快捷键修复了吗？"}, {"type": "subtitle", "time": 7534.709, "timestamp": "02:05:34", "text": "它有没有检查R是否"}, {"type": "subtitle", "time": 7536.87, "timestamp": "02:05:36", "text": "与其他任何东西连接？"}, {"type": "subtitle", "time": 7538.39, "timestamp": "02:05:38", "text": "它与其他任何东西都没有连接。"}, {"type": "subtitle", "time": 7539.99, "timestamp": "02:05:39", "text": "我可以要你的结尾部分吗？ 我可以要你的"}, {"type": "subtitle", "time": 7541.51, "timestamp": "02:05:41", "text": "结尾部分吗？"}, {"type": "subtitle", "time": 7543.83, "timestamp": "02:05:43", "text": "这就是原因。"}, {"type": "subtitle", "time": 7549.83, "timestamp": "02:05:49", "text": "可能。"}, {"type": "subtitle", "time": 7550.87, "timestamp": "02:05:50", "text": "但在"}, {"type": "subtitle", "time": 7552.149, "timestamp": "02:05:52", "text": "这里，标记不起作用。"}, {"type": "subtitle", "time": 7555.109, "timestamp": "02:05:55", "text": "这些符号不一样吗？ 不，"}, {"type": "subtitle", "time": 7558.39, "timestamp": "02:05:58", "text": "但关键仍然是按键绑定。"}]
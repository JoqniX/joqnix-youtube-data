[{"type": "subtitle", "time": 1263.669, "timestamp": "00:21:03", "text": "新加坡。 停止。 等待。 游戏结束。 这样说"}, {"type": "subtitle", "time": 1265.35, "timestamp": "00:21:05", "text": "对吗？ 我看不见。"}, {"type": "subtitle", "time": 1280.63, "timestamp": "00:21:20", "text": "。 所以，情况变得非常糟糕。 正如我所说，"}, {"type": "subtitle", "time": 1290.63, "timestamp": "00:21:30", "text": "你好，卡槻。 下午好。 我"}, {"type": "subtitle", "time": 1303.51, "timestamp": "00:21:43", "text": "哦，它们不是"}]
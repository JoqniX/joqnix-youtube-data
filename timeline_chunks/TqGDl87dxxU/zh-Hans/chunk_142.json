[{"type": "subtitle", "time": 8527.75, "timestamp": "02:22:07", "text": "呃，你能买下你吗？   是的"}, {"type": "subtitle", "time": 8528.63, "timestamp": "02:22:08", "text": "。"}, {"type": "subtitle", "time": 8538.87, "timestamp": "02:22:18", "text": "我忘了我"}, {"type": "subtitle", "time": 8541.429, "timestamp": "02:22:21", "text": "现在不能像以前在印第安纳州那样玩了，比如玩过家家游戏，想玩"}, {"type": "subtitle", "time": 8544.23, "timestamp": "02:22:24", "text": "多久就玩多久。 我忘了家里还有"}, {"type": "subtitle", "time": 8545.59, "timestamp": "02:22:25", "text": "个室友。"}, {"type": "subtitle", "time": 8548.15, "timestamp": "02:22:28", "text": "我身处不同的时区。 我"}, {"type": "subtitle", "time": 8549.91, "timestamp": "02:22:29", "text": "明天要上班。 我至今仍记得你那"}, {"type": "subtitle", "time": 8571.99, "timestamp": "02:22:51", "text": "不。"}, {"type": "subtitle", "time": 8574.55, "timestamp": "02:22:54", "text": "敌军倒下。"}, {"type": "subtitle", "time": 8576.07, "timestamp": "02:22:56", "text": "已淘汰。 好的。"}]
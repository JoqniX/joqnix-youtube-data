[{"type": "subtitle", "time": 5701.189, "timestamp": "01:35:01", "text": "听到“叮”的一声。   是"}, {"type": "subtitle", "time": 5703.27, "timestamp": "01:35:03", "text": "的，叮。 你知道，就像有大约"}, {"type": "subtitle", "time": 5705.83, "timestamp": "01:35:05", "text": "5 秒的延迟一样。 你就像"}, {"type": "subtitle", "time": 5707.35, "timestamp": "01:35:07", "text": "每次移动时都要面对它一样。"}, {"type": "subtitle", "time": 5708.87, "timestamp": "01:35:08", "text": "就算只得到一个，我也会非常"}, {"type": "subtitle", "time": 5709.59, "timestamp": "01:35:09", "text": "开心。   是的"}, {"type": "subtitle", "time": 5716.87, "timestamp": "01:35:16", "text": "哦，不错。 我们"}, {"type": "subtitle", "time": 5721.669, "timestamp": "01:35:21", "text": "走吧。 我们走吧。 时间很短。"}, {"type": "subtitle", "time": 5724.709, "timestamp": "01:35:24", "text": "还剩几秒钟。 哦，"}, {"type": "subtitle", "time": 5727.11, "timestamp": "01:35:27", "text": "他先开枪打伤了我，然后才杀了我。 什么？   是的"}, {"type": "subtitle", "time": 5727.59, "timestamp": "01:35:27", "text": "。   是的"}, {"type": "subtitle", "time": 5728.149, "timestamp": "01:35:28", "text": "，兄弟。"}, {"type": "subtitle", "time": 5728.95, "timestamp": "01:35:28", "text": "我看到了。   是的"}, {"type": "subtitle", "time": 5731.59, "timestamp": "01:35:31", "text": "。 是的。 因为对他来说，你比"}, {"type": "subtitle", "time": 5733.189, "timestamp": "01:35:33", "text": "那早了5秒钟。"}, {"type": "subtitle", "time": 5734.47, "timestamp": "01:35:34", "text": "5秒钟太疯狂了。"}, {"type": "subtitle", "time": 5735.51, "timestamp": "01:35:35", "text": "该死。"}, {"type": "subtitle", "time": 5738.149, "timestamp": "01:35:38", "text": "等待。 呃，我可以要你的亡命之徒吗？"}, {"type": "subtitle", "time": 5740.31, "timestamp": "01:35:40", "text": "有人玩得开心吗？"}, {"type": "subtitle", "time": 5742.87, "timestamp": "01:35:42", "text": "哦，非常感谢。"}, {"type": "subtitle", "time": 5746.55, "timestamp": "01:35:46", "text": "不必如此。 我要这个。"}, {"type": "subtitle", "time": 5749.75, "timestamp": "01:35:49", "text": "去！去！去。"}, {"type": "subtitle", "time": 5752.229, "timestamp": "01:35:52", "text": "你也是我造就的。"}, {"type": "subtitle", "time": 5753.11, "timestamp": "01:35:53", "text": "我走这边。"}]
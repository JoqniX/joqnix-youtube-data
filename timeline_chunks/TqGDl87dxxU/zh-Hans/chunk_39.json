[{"type": "subtitle", "time": 2342.71, "timestamp": "00:39:02", "text": "兄弟。"}, {"type": "subtitle", "time": 2345.91, "timestamp": "00:39:05", "text": "我只是边跑边打。"}, {"type": "subtitle", "time": 2346.31, "timestamp": "00:39:06", "text": "不。"}, {"type": "subtitle", "time": 2347.51, "timestamp": "00:39:07", "text": "我的天啊。"}, {"type": "subtitle", "time": 2349.27, "timestamp": "00:39:09", "text": "他没玩《Valerant》。 他在玩"}, {"type": "subtitle", "time": 2350.31, "timestamp": "00:39:10", "text": "Apex英雄。   是的"}, {"type": "subtitle", "time": 2355.43, "timestamp": "00:39:15", "text": "其实，我玩Apex很菜。"}, {"type": "subtitle", "time": 2357.829, "timestamp": "00:39:17", "text": "还有另一件事。"}, {"type": "subtitle", "time": 2361.67, "timestamp": "00:39:21", "text": "什么？ 我的天啊，兄弟。 我的天啊。"}, {"type": "subtitle", "time": 2362.47, "timestamp": "00:39:22", "text": "让我们玩。"}, {"type": "subtitle", "time": 2363.67, "timestamp": "00:39:23", "text": "我觉得海道已经完蛋了。"}, {"type": "subtitle", "time": 2370.95, "timestamp": "00:39:30", "text": "我接到你了。"}, {"type": "subtitle", "time": 2371.349, "timestamp": "00:39:31", "text": "哦。"}, {"type": "subtitle", "time": 2372.47, "timestamp": "00:39:32", "text": "哦，我被杀了。"}, {"type": "subtitle", "time": 2379.51, "timestamp": "00:39:39", "text": "嗯？"}, {"type": "subtitle", "time": 2381.829, "timestamp": "00:39:41", "text": "最后一名幸存者。"}, {"type": "subtitle", "time": 2383.27, "timestamp": "00:39:43", "text": "我的目标很棒。"}, {"type": "subtitle", "time": 2396.71, "timestamp": "00:39:56", "text": "我的天啊。 他在哪儿？"}]
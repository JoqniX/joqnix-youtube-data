[{"type": "subtitle", "time": 4037.029, "timestamp": "01:07:17", "text": "它就明晃晃地摆在那里。"}, {"type": "subtitle", "time": 4047.99, "timestamp": "01:07:27", "text": "我情绪低落。"}, {"type": "subtitle", "time": 4048.95, "timestamp": "01:07:28", "text": "你有视野吗？"}, {"type": "subtitle", "time": 4050.87, "timestamp": "01:07:30", "text": "他来了。"}, {"type": "subtitle", "time": 4053.51, "timestamp": "01:07:33", "text": "我失明了。"}, {"type": "subtitle", "time": 4055.589, "timestamp": "01:07:35", "text": "哦，没事了。"}, {"type": "subtitle", "time": 4057.109, "timestamp": "01:07:37", "text": "过来。 未来。"}, {"type": "subtitle", "time": 4059.67, "timestamp": "01:07:39", "text": "禁止偷看。"}, {"type": "subtitle", "time": 4067.27, "timestamp": "01:07:47", "text": "我是否会怀念你以前的配置？ 有点儿。"}, {"type": "subtitle", "time": 4069.589, "timestamp": "01:07:49", "text": "就是显示器之类的东西。 我喜欢这样的"}, {"type": "subtitle", "time": 4073.91, "timestamp": "01:07:53", "text": "布置。 是5060。是的"}, {"type": "subtitle", "time": 4077.19, "timestamp": "01:07:57", "text": "。 比旧款好太多了。"}, {"type": "subtitle", "time": 4079.43, "timestamp": "01:07:59", "text": "我确实很想念我的游戏电脑和直播电脑"}]
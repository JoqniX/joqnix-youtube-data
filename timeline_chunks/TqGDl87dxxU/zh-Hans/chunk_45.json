[{"type": "subtitle", "time": 2711.51, "timestamp": "00:45:11", "text": "哦，原来有人。"}, {"type": "subtitle", "time": 2712.15, "timestamp": "00:45:12", "text": "一个敌人。"}, {"type": "subtitle", "time": 2715.43, "timestamp": "00:45:15", "text": "我是否面对过我所面对的一切？"}, {"type": "subtitle", "time": 2718.63, "timestamp": "00:45:18", "text": "是的，我看到了。 我看到了。 我当时就想，"}, {"type": "subtitle", "time": 2720.23, "timestamp": "00:45:20", "text": "等等，你是怎么做到的？"}, {"type": "subtitle", "time": 2724.309, "timestamp": "00:45:24", "text": "那延迟也太严重了吧？"}, {"type": "subtitle", "time": 2726.79, "timestamp": "00:45:26", "text": "好的。 所以，他当时正要关门，但"}, {"type": "subtitle", "time": 2728.39, "timestamp": "00:45:28", "text": "还是路过了那里。"}, {"type": "subtitle", "time": 2730.79, "timestamp": "00:45:30", "text": "决不。 妈的。"}, {"type": "subtitle", "time": 2732.39, "timestamp": "00:45:32", "text": "它在哪里？"}, {"type": "subtitle", "time": 2738.87, "timestamp": "00:45:38", "text": "哦，他可以"}, {"type": "subtitle", "time": 2739.75, "timestamp": "00:45:39", "text": "看看“"}, {"type": "subtitle", "time": 2741.43, "timestamp": "00:45:41", "text": "让我赢这家伙”。 让我揍他一顿"}, {"type": "subtitle", "time": 2741.99, "timestamp": "00:45:41", "text": "。   是的"}, {"type": "subtitle", "time": 2749.43, "timestamp": "00:45:49", "text": "不，"}, {"type": "subtitle", "time": 2756.39, "timestamp": "00:45:56", "text": "没关系。 我相信乔。 即使"}, {"type": "subtitle", "time": 2757.99, "timestamp": "00:45:57", "text": "乔还活着，她也一定会赢。   是的"}]
[{"type": "subtitle", "time": 8280.79, "timestamp": "02:18:00", "text": "重新装弹。"}, {"type": "subtitle", "time": 8282.469, "timestamp": "02:18:02", "text": "谢谢。"}, {"type": "subtitle", "time": 8283.589, "timestamp": "02:18:03", "text": "重新装弹。"}, {"type": "subtitle", "time": 8289.509, "timestamp": "02:18:09", "text": "我怪罪于出发"}, {"type": "subtitle", "time": 8291.27, "timestamp": "02:18:11", "text": "。 重新加载。"}, {"type": "subtitle", "time": 8292.87, "timestamp": "02:18:12", "text": "哟，给我治疗。"}, {"type": "subtitle", "time": 8294.709, "timestamp": "02:18:14", "text": "还剩一个敌人。"}, {"type": "subtitle", "time": 8296.95, "timestamp": "02:18:16", "text": "等等，你在哪里？"}, {"type": "subtitle", "time": 8298.87, "timestamp": "02:18:18", "text": "知道了。"}, {"type": "subtitle", "time": 8300.95, "timestamp": "02:18:20", "text": "等等，让我来处理一下。"}, {"type": "subtitle", "time": 8318.07, "timestamp": "02:18:38", "text": "哦，"}, {"type": "subtitle", "time": 8321.509, "timestamp": "02:18:41", "text": "最后站立的人。 我的天啊。 决不。"}, {"type": "subtitle", "time": 8322.15, "timestamp": "02:18:42", "text": "我相信自己。"}, {"type": "subtitle", "time": 8323.429, "timestamp": "02:18:43", "text": "决不。 你们对我做了这种事。"}, {"type": "subtitle", "time": 8330.15, "timestamp": "02:18:50", "text": "我不信任自己。"}, {"type": "subtitle", "time": 8338.23, "timestamp": "02:18:58", "text": "不，他没在线。 不开。 不开。 不开。"}, {"type": "subtitle", "time": 8338.87, "timestamp": "02:18:58", "text": "去！去！去。   是的"}]
[{"type": "subtitle", "time": 6180.55, "timestamp": "01:43:00", "text": "说我是自闭症患者吗？"}, {"type": "subtitle", "time": 6184.31, "timestamp": "01:43:04", "text": "不，我不是自闭症患者。 我说，嗯，是的，你的"}, {"type": "subtitle", "time": 6185.99, "timestamp": "01:43:05", "text": "耳朵在嗡嗡作响。 我觉得你耳朵"}, {"type": "subtitle", "time": 6187.75, "timestamp": "01:43:07", "text": "嗡嗡作响。"}, {"type": "subtitle", "time": 6188.87, "timestamp": "01:43:08", "text": "嗯哼。 嗯哼。"}, {"type": "subtitle", "time": 6195.27, "timestamp": "01:43:15", "text": "我的天啊。"}, {"type": "subtitle", "time": 6203.51, "timestamp": "01:43:23", "text": "他们要回去了。"}, {"type": "subtitle", "time": 6215.27, "timestamp": "01:43:35", "text": "因为我真的没办法种下一株种子"}, {"type": "subtitle", "time": 6223.27, "timestamp": "01:43:43", "text": "我走了。"}, {"type": "subtitle", "time": 6226.87, "timestamp": "01:43:46", "text": "哦。 哦。 哦。 好一个。"}, {"type": "subtitle", "time": 6228.55, "timestamp": "01:43:48", "text": "哦，他来过这里。 常设。"}, {"type": "subtitle", "time": 6232.55, "timestamp": "01:43:52", "text": "哦。 哦。 哦。 哦。 安提。 一个实体。"}]
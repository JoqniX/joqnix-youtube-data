[{"type": "subtitle", "time": 4205.03, "timestamp": "01:10:05", "text": "，他们死了。 谢谢。   是"}, {"type": "subtitle", "time": 4207.91, "timestamp": "01:10:07", "text": "啊，谢谢。"}, {"type": "subtitle", "time": 4210.07, "timestamp": "01:10:10", "text": "我想，已经痊愈了。 哦。"}, {"type": "subtitle", "time": 4211.51, "timestamp": "01:10:11", "text": "他只有10点生命值。"}, {"type": "subtitle", "time": 4213.35, "timestamp": "01:10:13", "text": "东西怎么样，兄弟？ 严肃的事情进展"}, {"type": "subtitle", "time": 4216.63, "timestamp": "01:10:16", "text": "顺利。 他们进展顺利。 今天我们这里"}, {"type": "subtitle", "time": 4221.91, "timestamp": "01:10:21", "text": "就像个新安集市。 呃，这是"}, {"type": "subtitle", "time": 4225.99, "timestamp": "01:10:25", "text": "一个活动，会有不同大学的"}, {"type": "subtitle", "time": 4228.47, "timestamp": "01:10:28", "text": "代表和"}, {"type": "subtitle", "time": 4230.63, "timestamp": "01:10:30", "text": "职业学校的代表参加，是"}, {"type": "subtitle", "time": 4234.39, "timestamp": "01:10:34", "text": "谁说的？ 嗯，你谈到了"}, {"type": "subtitle", "time": 4237.99, "timestamp": "01:10:37", "text": "考试、入学考试以及"}, {"type": "subtitle", "time": 4239.83, "timestamp": "01:10:39", "text": "学生是否有兴趣加入"}, {"type": "subtitle", "time": 4242.55, "timestamp": "01:10:42", "text": "大学等等，"}, {"type": "subtitle", "time": 4243.27, "timestamp": "01:10:43", "text": "我确实很"}, {"type": "subtitle", "time": 4246.07, "timestamp": "01:10:46", "text": "喜欢这一点，这真的很方便，真的"}, {"type": "subtitle", "time": 4249.03, "timestamp": "01:10:49", "text": "很好。作为一个大一新生，现在"}, {"type": "subtitle", "time": 4250.229, "timestamp": "01:10:50", "text": "大二了，"}]
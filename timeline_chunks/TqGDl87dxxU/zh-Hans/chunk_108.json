[{"type": "subtitle", "time": 6480.07, "timestamp": "01:48:00", "text": "就像开玩笑一样。   是的"}, {"type": "subtitle", "time": 6481.75, "timestamp": "01:48:01", "text": "。 是的。"}, {"type": "subtitle", "time": 6490.229, "timestamp": "01:48:10", "text": "我也需要参加一个培训项目。"}, {"type": "subtitle", "time": 6493.83, "timestamp": "01:48:13", "text": "我昨天安装了这款游戏。"}, {"type": "subtitle", "time": 6497.109, "timestamp": "01:48:17", "text": "我的天啊，兄弟。 我的天啊。"}, {"type": "subtitle", "time": 6498.07, "timestamp": "01:48:18", "text": "这地方简直……"}, {"type": "subtitle", "time": 6501.75, "timestamp": "01:48:21", "text": "我的天哪。 是的，兄弟。"}, {"type": "subtitle", "time": 6503.59, "timestamp": "01:48:23", "text": "昨天下载的，他就是这么"}, {"type": "subtitle", "time": 6506.31, "timestamp": "01:48:26", "text": "玩的。 该死。"}, {"type": "subtitle", "time": 6509.03, "timestamp": "01:48:29", "text": "想象一下他连续玩了一个月，"}, {"type": "subtitle", "time": 6511.27, "timestamp": "01:48:31", "text": "然后他就像容光焕发，"}, {"type": "subtitle", "time": 6514.629, "timestamp": "01:48:34", "text": "真的就像在说，"}, {"type": "subtitle", "time": 6518.39, "timestamp": "01:48:38", "text": "哦，你们这些小家伙，我会"}, {"type": "subtitle", "time": 6519.35, "timestamp": "01:48:39", "text": "担心的。"}, {"type": "subtitle", "time": 6521.91, "timestamp": "01:48:41", "text": "我的天啊，请"}, {"type": "subtitle", "time": 6525.51, "timestamp": "01:48:45", "text": "俯视我们吧……"}, {"type": "subtitle", "time": 6527.43, "timestamp": "01:48:47", "text": "我想这就是他不做这件事的原因。"}, {"type": "subtitle", "time": 6529.27, "timestamp": "01:48:49", "text": "他这是在自谦。   是的，"}, {"type": "subtitle", "time": 6531.59, "timestamp": "01:48:51", "text": "他是"}, {"type": "subtitle", "time": 6533.43, "timestamp": "01:48:53", "text": "。 他太谦虚了，兄弟。 他太"}, {"type": "subtitle", "time": 6534.07, "timestamp": "01:48:54", "text": "谦虚了。"}]
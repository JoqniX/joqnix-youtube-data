[{"type": "subtitle", "time": 6124.95, "timestamp": "01:42:04", "text": "你膝盖又骨折了。 真是幸运。"}, {"type": "subtitle", "time": 6127.03, "timestamp": "01:42:07", "text": "真是"}, {"type": "subtitle", "time": 6128.47, "timestamp": "01:42:08", "text": "幸运。"}, {"type": "subtitle", "time": 6131.27, "timestamp": "01:42:11", "text": "不，你知道的。 是的。 你知道吗？ 我去"}, {"type": "subtitle", "time": 6132.55, "timestamp": "01:42:12", "text": "。"}, {"type": "subtitle", "time": 6135.109, "timestamp": "01:42:15", "text": "为了好运。 为了好运。 再次。 再说一遍，"}, {"type": "subtitle", "time": 6136.39, "timestamp": "01:42:16", "text": "兄弟。 我刚刚就这么做了。"}, {"type": "subtitle", "time": 6138.39, "timestamp": "01:42:18", "text": "Cypher有点疯。"}, {"type": "subtitle", "time": 6138.95, "timestamp": "01:42:18", "text": "好一个。"}, {"type": "subtitle", "time": 6142.149, "timestamp": "01:42:22", "text": "啊，是的。"}, {"type": "subtitle", "time": 6144.709, "timestamp": "01:42:24", "text": "兄弟，"}, {"type": "subtitle", "time": 6147.189, "timestamp": "01:42:27", "text": "你们可能没注意到，但吉野斋可是真的在拼命炫耀肌肉呢"}, {"type": "subtitle", "time": 6154.07, "timestamp": "01:42:34", "text": "她就像个了不起的亡命之徒，"}, {"type": "subtitle", "time": 6156.47, "timestamp": "01:42:36", "text": "她做着疯狂的机械工作，"}, {"type": "subtitle", "time": 6159.189, "timestamp": "01:42:39", "text": "我的天哪。   是的"}, {"type": "subtitle", "time": 6159.75, "timestamp": "01:42:39", "text": "，兄弟。"}, {"type": "subtitle", "time": 6162.149, "timestamp": "01:42:42", "text": "我侥幸活了下来。 我刚刚苏醒过来。"}, {"type": "subtitle", "time": 6167.83, "timestamp": "01:42:47", "text": "我的天啊。 是的，她活了下来，只是"}, {"type": "subtitle", "time": 6170.87, "timestamp": "01:42:50", "text": "我说话有点结巴，兄弟。"}, {"type": "subtitle", "time": 6173.59, "timestamp": "01:42:53", "text": "没关系。 我也是自闭症患者。"}, {"type": "subtitle", "time": 6174.87, "timestamp": "01:42:54", "text": "所以，"}, {"type": "subtitle", "time": 6176.47, "timestamp": "01:42:56", "text": "起飞吧。"}, {"type": "subtitle", "time": 6178.55, "timestamp": "01:42:58", "text": "你还在等，等，等，等。 你刚才是在"}]
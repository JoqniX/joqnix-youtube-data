[{"type": "subtitle", "time": 7807.51, "timestamp": "02:10:07", "text": "8点了。"}, {"type": "subtitle", "time": 7810.79, "timestamp": "02:10:10", "text": "我当时就想，"}, {"type": "subtitle", "time": 7813.75, "timestamp": "02:10:13", "text": "我的室友到底发生了什么事？"}, {"type": "subtitle", "time": 7820.79, "timestamp": "02:10:20", "text": "他好像在为你做事，"}, {"type": "subtitle", "time": 7824.149, "timestamp": "02:10:24", "text": "就像我会说“哦，我的小宝贝，我会一直陪着"}, {"type": "subtitle", "time": 7834.069, "timestamp": "02:10:34", "text": "所以这将是我最后一次来这里了，之后"}, {"type": "subtitle", "time": 7844.79, "timestamp": "02:10:44", "text": "帮忙。"}]
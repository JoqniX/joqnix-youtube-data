[{"type": "subtitle", "time": 7144.709, "timestamp": "01:59:04", "text": "兄弟，我离不开米饭。 兄弟，你肯定会恨死我的"}, {"type": "subtitle", "time": 7145.75, "timestamp": "01:59:05", "text": "。"}, {"type": "subtitle", "time": 7149.109, "timestamp": "01:59:09", "text": "现在我"}, {"type": "subtitle", "time": 7150.87, "timestamp": "01:59:10", "text": "不说了。"}, {"type": "subtitle", "time": 7151.669, "timestamp": "01:59:11", "text": "不，"}, {"type": "subtitle", "time": 7157.589, "timestamp": "01:59:17", "text": "我其实不太喜欢米饭。"}, {"type": "subtitle", "time": 7159.91, "timestamp": "01:59:19", "text": "没关系。"}, {"type": "subtitle", "time": 7165.91, "timestamp": "01:59:25", "text": "我不会说我更喜欢这样。 不是我喜欢的那种吃法，"}, {"type": "subtitle", "time": 7168.07, "timestamp": "01:59:28", "text": "比如，"}, {"type": "subtitle", "time": 7170.709, "timestamp": "01:59:30", "text": "你通常用米饭搭配什么？"}, {"type": "subtitle", "time": 7172.95, "timestamp": "01:59:32", "text": "我喜欢。 嗯，有时候是咖喱，"}, {"type": "subtitle", "time": 7180.31, "timestamp": "01:59:40", "text": "我记得以前"}, {"type": "subtitle", "time": 7182.95, "timestamp": "01:59:42", "text": "上学的时候，我经常吃这个"}, {"type": "subtitle", "time": 7184.87, "timestamp": "01:59:44", "text": "。 我不知道这算不算讲故事，"}, {"type": "subtitle", "time": 7189.75, "timestamp": "01:59:49", "text": "但我还是想分享一下，你知道那种"}, {"type": "subtitle", "time": 7194.149, "timestamp": "01:59:54", "text": "神奇的香料包。   是的"}, {"type": "subtitle", "time": 7195.27, "timestamp": "01:59:55", "text": "。 是的。 是的。"}, {"type": "subtitle", "time": 7198.31, "timestamp": "01:59:58", "text": "呃，神奇的香料包。 所以，呃，我妈妈"}]
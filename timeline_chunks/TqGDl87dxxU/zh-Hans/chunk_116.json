[{"type": "subtitle", "time": 6960.39, "timestamp": "01:56:00", "text": "好吧，我再选一个我"}, {"type": "subtitle", "time": 6962.149, "timestamp": "01:56:02", "text": "不知道怎么玩的特工，我选了那个"}, {"type": "subtitle", "time": 6965.669, "timestamp": "01:56:05", "text": "桥，然后他们居然在"}, {"type": "subtitle", "time": 6971.51, "timestamp": "01:56:11", "text": "同一场比赛里给了我日落。 对，那"}, {"type": "subtitle", "time": 6973.43, "timestamp": "01:56:13", "text": "就像个小故障。 他们表面上表示会"}, {"type": "subtitle", "time": 6974.79, "timestamp": "01:56:14", "text": "破例，"}, {"type": "subtitle", "time": 6977.03, "timestamp": "01:56:17", "text": "但实际上却给了他们致命一击"}, {"type": "subtitle", "time": 6979.43, "timestamp": "01:56:19", "text": "。"}, {"type": "subtitle", "time": 6982.149, "timestamp": "01:56:22", "text": "这是一个奇怪的故障。 我不知道。 我马上回来"}, {"type": "subtitle", "time": 6985.189, "timestamp": "01:56:25", "text": "。 我去趟洗手间，一会儿就回来"}, {"type": "subtitle", "time": 6995.589, "timestamp": "01:56:35", "text": "我马上回来。 一秒钟。"}, {"type": "subtitle", "time": 6997.109, "timestamp": "01:56:37", "text": "好了，我回来了。"}, {"type": "subtitle", "time": 7000.149, "timestamp": "01:56:40", "text": "太逊了。"}, {"type": "subtitle", "time": 7002.47, "timestamp": "01:56:42", "text": "吓死我了，我还以为有人在"}, {"type": "subtitle", "time": 7004.79, "timestamp": "01:56:44", "text": "外面敲我的窗户呢。"}, {"type": "subtitle", "time": 7006.629, "timestamp": "01:56:46", "text": "我的天啊。 我的天啊。"}, {"type": "subtitle", "time": 7010.07, "timestamp": "01:56:50", "text": "我需要确认一下。 突发。"}, {"type": "subtitle", "time": 7013.35, "timestamp": "01:56:53", "text": "我没事，兄弟。 我还需要再确认一下。   是的"}, {"type": "subtitle", "time": 7015.83, "timestamp": "01:56:55", "text": "。 至少我没找到任何人。"}, {"type": "subtitle", "time": 7017.91, "timestamp": "01:56:57", "text": "你知道，就像晚上听到"}, {"type": "subtitle", "time": 7018.79, "timestamp": "01:56:58", "text": "动静时，"}]
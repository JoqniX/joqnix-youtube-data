[{"type": "subtitle", "time": 6549.51, "timestamp": "01:49:09", "text": "继续？"}, {"type": "subtitle", "time": 6552.31, "timestamp": "01:49:12", "text": "我不知道。 我可以结束了，但我"}, {"type": "subtitle", "time": 6554.229, "timestamp": "01:49:14", "text": "还想再玩一会儿，因为这"}, {"type": "subtitle", "time": 6556.55, "timestamp": "01:49:16", "text": "是我唯一一次玩游戏的机会。   是的"}, {"type": "subtitle", "time": 6557.59, "timestamp": "01:49:17", "text": "。 是的。"}, {"type": "subtitle", "time": 6560.95, "timestamp": "01:49:20", "text": "哦好的。 然后我们就可以玩了。"}, {"type": "subtitle", "time": 6562.149, "timestamp": "01:49:22", "text": "你想和我们一起玩还是"}, {"type": "subtitle", "time": 6564.149, "timestamp": "01:49:24", "text": "想单人玩？ 哦，"}, {"type": "subtitle", "time": 6566.229, "timestamp": "01:49:26", "text": "如果你们愿意的话，我们可以一起玩。 我自由了。"}, {"type": "subtitle", "time": 6568.229, "timestamp": "01:49:28", "text": "你吃晚饭了吗？ 呃，不是晚餐，是"}, {"type": "subtitle", "time": 6569.83, "timestamp": "01:49:29", "text": "午餐。"}, {"type": "subtitle", "time": 6573.669, "timestamp": "01:49:33", "text": "我没有。 但我稍后会做。"}, {"type": "subtitle", "time": 6576.229, "timestamp": "01:49:36", "text": "我没有。 但我现在只是闲逛而已"}, {"type": "subtitle", "time": 6577.83, "timestamp": "01:49:37", "text": "。"}, {"type": "subtitle", "time": 6579.99, "timestamp": "01:49:39", "text": "即使我偷偷摸摸地做，也只会"}, {"type": "subtitle", "time": 6582.229, "timestamp": "01:49:42", "text": "胡说八道。"}, {"type": "subtitle", "time": 6585.75, "timestamp": "01:49:45", "text": "是的，我要考试。"}, {"type": "subtitle", "time": 6587.109, "timestamp": "01:49:47", "text": "什么？   是的"}, {"type": "subtitle", "time": 6587.51, "timestamp": "01:49:47", "text": "。"}, {"type": "subtitle", "time": 6589.35, "timestamp": "01:49:49", "text": "我的天啊。 一切顺利。"}, {"type": "subtitle", "time": 6591.59, "timestamp": "01:49:51", "text": "这是我那场难考的考试，但我没"}, {"type": "subtitle", "time": 6594.47, "timestamp": "01:49:54", "text": "复习。 为什么？ 我不知道。"}, {"type": "subtitle", "time": 6598.47, "timestamp": "01:49:58", "text": "我只买了一个面包，因为还有其他的。"}, {"type": "subtitle", "time": 6598.95, "timestamp": "01:49:58", "text": "哦，不。"}]
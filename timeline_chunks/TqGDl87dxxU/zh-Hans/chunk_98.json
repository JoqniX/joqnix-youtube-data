[{"type": "subtitle", "time": 5882.47, "timestamp": "01:38:02", "text": "我前面几乎没有剥皮的余地。"}, {"type": "subtitle", "time": 5883.189, "timestamp": "01:38:03", "text": "嗯哼。"}, {"type": "subtitle", "time": 5884.629, "timestamp": "01:38:04", "text": "我用的是朋友的账号，所以"}, {"type": "subtitle", "time": 5886.95, "timestamp": "01:38:06", "text": "这根本不是我的账号。"}, {"type": "subtitle", "time": 5891.91, "timestamp": "01:38:11", "text": "好了，我抓到他了。"}, {"type": "subtitle", "time": 5892.79, "timestamp": "01:38:12", "text": "我闭嘴了。"}, {"type": "subtitle", "time": 5914.629, "timestamp": "01:38:34", "text": "哦，谢谢。"}, {"type": "subtitle", "time": 5923.91, "timestamp": "01:38:43", "text": "最后一个敌人了。"}, {"type": "subtitle", "time": 5926.39, "timestamp": "01:38:46", "text": "哦，左侧"}, {"type": "subtitle", "time": 5927.91, "timestamp": "01:38:47", "text": "来电延迟很严重。"}, {"type": "subtitle", "time": 5934.79, "timestamp": "01:38:54", "text": "哦，我真糟糕。"}, {"type": "subtitle", "time": 5935.75, "timestamp": "01:38:55", "text": "最后一名玩家。"}, {"type": "subtitle", "time": 5937.75, "timestamp": "01:38:57", "text": "我很糟糕。 等待。 赢下这场比赛。"}, {"type": "subtitle", "time": 5939.51, "timestamp": "01:38:59", "text": "K. Kylie赢得了这些比赛。 凯莉赢了。"}]
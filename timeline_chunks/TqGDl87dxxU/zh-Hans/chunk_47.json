[{"type": "subtitle", "time": 2822.069, "timestamp": "00:47:02", "text": "你还在玩吗？ 不，不，不。 呃，是"}, {"type": "subtitle", "time": 2824.23, "timestamp": "00:47:04", "text": "新加坡，对吧？ 是的，我们在"}, {"type": "subtitle", "time": 2825.27, "timestamp": "00:47:05", "text": "新加坡。 是的，"}, {"type": "subtitle", "time": 2833.99, "timestamp": "00:47:13", "text": "我好像能从你们那里得到一些反应，"}, {"type": "subtitle", "time": 2837.109, "timestamp": "00:47:17", "text": "然后我会把这些反应发出来。"}, {"type": "subtitle", "time": 2839.349, "timestamp": "00:47:19", "text": "哦，你去吧，兄弟。"}, {"type": "subtitle", "time": 2842.23, "timestamp": "00:47:22", "text": "兄弟，这就是那次狂欢。 那次"}, {"type": "subtitle", "time": 2844.55, "timestamp": "00:47:24", "text": "挥鞭子最后三次都落空了。"}, {"type": "subtitle", "time": 2846.309, "timestamp": "00:47:26", "text": "太棒了。"}, {"type": "subtitle", "time": 2851.829, "timestamp": "00:47:31", "text": "所以呢？"}, {"type": "subtitle", "time": 2854.23, "timestamp": "00:47:34", "text": "不，不，不。"}, {"type": "subtitle", "time": 2856.309, "timestamp": "00:47:36", "text": "快点。 现在不要后退。 不，"}, {"type": "subtitle", "time": 2859.27, "timestamp": "00:47:39", "text": "其实，其实，其实真的。"}, {"type": "subtitle", "time": 2865.27, "timestamp": "00:47:45", "text": "哦，呃，我做了几个俯卧撑来弥补之前的不足。 我得"}, {"type": "subtitle", "time": 2866.63, "timestamp": "00:47:46", "text": "去做，请稍等片刻。"}, {"type": "subtitle", "time": 2868.79, "timestamp": "00:47:48", "text": "我的天哪。 多少？"}, {"type": "subtitle", "time": 2871.589, "timestamp": "00:47:51", "text": "我认为是五。 呃，请稍等一下。"}, {"type": "subtitle", "time": 2872.39, "timestamp": "00:47:52", "text": "你一定可以的。"}]
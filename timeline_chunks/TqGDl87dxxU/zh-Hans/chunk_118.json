[{"type": "subtitle", "time": 7080.07, "timestamp": "01:58:00", "text": "等等，治好我。 治愈我。 治愈我。 治愈"}, {"type": "subtitle", "time": 7087.99, "timestamp": "01:58:07", "text": "我听到一声“不”。我把它"}, {"type": "subtitle", "time": 7089.75, "timestamp": "01:58:09", "text": "弄坏了。 我把它弄坏了。 我的天啊。 我把它弄坏了"}, {"type": "subtitle", "time": 7104.229, "timestamp": "01:58:24", "text": "我们很着急。"}, {"type": "subtitle", "time": 7104.79, "timestamp": "01:58:24", "text": "哦，"}, {"type": "subtitle", "time": 7106.39, "timestamp": "01:58:26", "text": "万一"}, {"type": "subtitle", "time": 7114.95, "timestamp": "01:58:34", "text": "是的，"}, {"type": "subtitle", "time": 7116.39, "timestamp": "01:58:36", "text": "我打了他。 去，去，去杀了他。 杀了"}, {"type": "subtitle", "time": 7116.629, "timestamp": "01:58:36", "text": "他。"}, {"type": "subtitle", "time": 7118.31, "timestamp": "01:58:38", "text": "这是。"}, {"type": "subtitle", "time": 7119.99, "timestamp": "01:58:39", "text": "我打了他的头。"}, {"type": "subtitle", "time": 7122.07, "timestamp": "01:58:42", "text": "好了，我回来了。 我回来了。"}, {"type": "subtitle", "time": 7122.47, "timestamp": "01:58:42", "text": "欢迎回来。"}, {"type": "subtitle", "time": 7127.589, "timestamp": "01:58:47", "text": "我认为他是其中之一。 好的。"}, {"type": "subtitle", "time": 7129.99, "timestamp": "01:58:49", "text": "他显然患有T1型甲状腺疾病。"}, {"type": "subtitle", "time": 7132.47, "timestamp": "01:58:52", "text": "嗯哼。"}, {"type": "subtitle", "time": 7133.669, "timestamp": "01:58:53", "text": "凉爽的。"}, {"type": "subtitle", "time": 7137.109, "timestamp": "01:58:57", "text": "我之后要去吃点米饭。"}, {"type": "subtitle", "time": 7137.75, "timestamp": "01:58:57", "text": "啊，"}, {"type": "subtitle", "time": 7138.47, "timestamp": "01:58:58", "text": "我走了。   是的"}, {"type": "subtitle", "time": 7139.589, "timestamp": "01:58:59", "text": "。"}]
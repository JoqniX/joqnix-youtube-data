[{"type": "subtitle", "time": 2640.55, "timestamp": "00:44:00", "text": "真是见鬼了。"}, {"type": "subtitle", "time": 2642.55, "timestamp": "00:44:02", "text": "还剩10秒。 你只看到了他一个"}, {"type": "subtitle", "time": 2643.67, "timestamp": "00:44:03", "text": "像素。 哇。"}, {"type": "subtitle", "time": 2644.71, "timestamp": "00:44:04", "text": "我得了尖峰病。"}, {"type": "subtitle", "time": 2646.71, "timestamp": "00:44:06", "text": "哦，兄弟。"}, {"type": "subtitle", "time": 2647.75, "timestamp": "00:44:07", "text": "什么？"}, {"type": "subtitle", "time": 2650.15, "timestamp": "00:44:10", "text": "我的天哪，兄弟。 兄弟，"}, {"type": "subtitle", "time": 2651.43, "timestamp": "00:44:11", "text": "剪掉，兄弟。"}, {"type": "subtitle", "time": 2652.63, "timestamp": "00:44:12", "text": "哟。 兄弟，这到底是"}, {"type": "subtitle", "time": 2654.87, "timestamp": "00:44:14", "text": "怎么回事？"}, {"type": "subtitle", "time": 2656.15, "timestamp": "00:44:16", "text": "上帝。   是的"}, {"type": "subtitle", "time": 2657.91, "timestamp": "00:44:17", "text": "。 所以，事情发展到了另一个层次，兄弟。"}, {"type": "subtitle", "time": 2659.51, "timestamp": "00:44:19", "text": "两次。 好像每年会发生一"}, {"type": "subtitle", "time": 2661.829, "timestamp": "00:44:21", "text": "两次。 是的。"}, {"type": "subtitle", "time": 2663.51, "timestamp": "00:44:23", "text": "我的天啊。"}, {"type": "subtitle", "time": 2673.67, "timestamp": "00:44:33", "text": "啊，谢谢。"}, {"type": "subtitle", "time": 2675.03, "timestamp": "00:44:35", "text": "谢谢。 谢谢。 我还不如"}, {"type": "subtitle", "time": 2677.109, "timestamp": "00:44:37", "text": "乔，不过，是的。 谢谢。"}, {"type": "subtitle", "time": 2690.23, "timestamp": "00:44:50", "text": "我的天啊。"}, {"type": "subtitle", "time": 2692.79, "timestamp": "00:44:52", "text": "哦，什么？ 他就像在天上一样，所以要"}, {"type": "subtitle", "time": 2694.71, "timestamp": "00:44:54", "text": "小心。"}, {"type": "subtitle", "time": 2699.349, "timestamp": "00:44:59", "text": "抓住他，乔。 我的天啊。 我的天啊。 我笨手笨脚地"}]
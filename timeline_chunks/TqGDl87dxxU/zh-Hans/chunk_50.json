[{"type": "subtitle", "time": 3002.15, "timestamp": "00:50:02", "text": "按四号位。 按四。 保持"}, {"type": "subtitle", "time": 3005.109, "timestamp": "00:50:05", "text": "四档。"}, {"type": "subtitle", "time": 3007.27, "timestamp": "00:50:07", "text": "最后一名幸存者。   是的"}, {"type": "subtitle", "time": 3008.39, "timestamp": "00:50:08", "text": "。"}, {"type": "subtitle", "time": 3008.87, "timestamp": "00:50:08", "text": "房间。"}, {"type": "subtitle", "time": 3011.03, "timestamp": "00:50:11", "text": "我的天啊。 他赢了。 我向上帝发誓，"}, {"type": "subtitle", "time": 3012.23, "timestamp": "00:50:12", "text": "如果你赢了。"}, {"type": "subtitle", "time": 3021.67, "timestamp": "00:50:21", "text": "哦，你得保护好尖刺。"}, {"type": "subtitle", "time": 3023.03, "timestamp": "00:50:23", "text": "它们会扩散开来。 哦，等等。 她"}, {"type": "subtitle", "time": 3026.069, "timestamp": "00:50:26", "text": "有自己的策略。 等待。"}, {"type": "subtitle", "time": 3029.829, "timestamp": "00:50:29", "text": "哦，不错。 安迪和他会有"}, {"type": "subtitle", "time": 3030.309, "timestamp": "00:50:30", "text": "地方住。"}, {"type": "subtitle", "time": 3043.109, "timestamp": "00:50:43", "text": "我了。"}, {"type": "subtitle", "time": 3044.95, "timestamp": "00:50:44", "text": "是的，"}]
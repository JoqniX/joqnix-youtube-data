[{"type": "subtitle", "time": 4143.11, "timestamp": "01:09:03", "text": "我的天啊，盾牌保护了那"}, {"type": "subtitle", "time": 4149.59, "timestamp": "01:09:09", "text": "他为什么要做这些事？"}, {"type": "subtitle", "time": 4152.789, "timestamp": "01:09:12", "text": "还有一堵墙。   我们"}, {"type": "subtitle", "time": 4154.789, "timestamp": "01:09:14", "text": "走吧。 我们走吧。 凯勒，他们两个都在"}, {"type": "subtitle", "time": 4156.95, "timestamp": "01:09:16", "text": "墙后面。"}, {"type": "subtitle", "time": 4158.47, "timestamp": "01:09:18", "text": "等等，凯德，跟我来。 跟我来。"}, {"type": "subtitle", "time": 4159.51, "timestamp": "01:09:19", "text": "这里。 这里。 过来。 过来。 过来"}, {"type": "subtitle", "time": 4161.11, "timestamp": "01:09:21", "text": "。 凯德，过来。 过来。   是的"}, {"type": "subtitle", "time": 4162.39, "timestamp": "01:09:22", "text": "。 是的。"}, {"type": "subtitle", "time": 4166.07, "timestamp": "01:09:26", "text": "好的。 呃，到这里，然后呃，按住呃，"}, {"type": "subtitle", "time": 4177.349, "timestamp": "01:09:37", "text": "我的天啊。 乔，"}, {"type": "subtitle", "time": 4189.99, "timestamp": "01:09:49", "text": "让我去抓他。 让我去抓他。 让我"}, {"type": "subtitle", "time": 4195.75, "timestamp": "01:09:55", "text": "啊，真他妈的。"}, {"type": "subtitle", "time": 4197.75, "timestamp": "01:09:57", "text": "那个混蛋刚才打断了"}]
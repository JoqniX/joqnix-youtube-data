[{"type": "subtitle", "time": 7947.99, "timestamp": "02:12:27", "text": "他就在你身后。"}, {"type": "subtitle", "time": 7950.629, "timestamp": "02:12:30", "text": "他怎么会落后呢？"}, {"type": "subtitle", "time": 7952.39, "timestamp": "02:12:32", "text": "我知道，对吧？ 我也以为他在"}, {"type": "subtitle", "time": 7960.95, "timestamp": "02:12:40", "text": "这里领先。"}]
[{"type": "subtitle", "time": 8593.67, "timestamp": "02:23:13", "text": "我觉得是复活那件事。"}, {"type": "subtitle", "time": 8595.75, "timestamp": "02:23:15", "text": "最后一名幸存者。"}, {"type": "subtitle", "time": 8620.95, "timestamp": "02:23:40", "text": "我们赢了。 喵。 雷娜。 哇。"}, {"type": "subtitle", "time": 8623.03, "timestamp": "02:23:43", "text": "我当时就知道他只会对"}, {"type": "subtitle", "time": 8625.59, "timestamp": "02:23:45", "text": "我这么做。 就像兄弟之前看到那么多人一样"}, {"type": "subtitle", "time": 8629.99, "timestamp": "02:23:49", "text": "。 他选择了我。 好的。"}, {"type": "subtitle", "time": 8630.71, "timestamp": "02:23:50", "text": "我的天啊。"}]
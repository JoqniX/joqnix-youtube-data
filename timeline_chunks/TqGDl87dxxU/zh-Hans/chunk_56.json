[{"type": "subtitle", "time": 3365.75, "timestamp": "00:56:05", "text": "哦，在那儿。 是啊，就像，他当时在"}, {"type": "subtitle", "time": 3367.19, "timestamp": "00:56:07", "text": "那里露营，"}, {"type": "subtitle", "time": 3367.67, "timestamp": "00:56:07", "text": "哇。"}, {"type": "subtitle", "time": 3376.15, "timestamp": "00:56:16", "text": "哦，他落后了。 最后一名幸存者。"}, {"type": "subtitle", "time": 3378.63, "timestamp": "00:56:18", "text": "他进度落后了。   是的"}, {"type": "subtitle", "time": 3386.789, "timestamp": "00:56:26", "text": "等等，我觉得我也卡住了。"}, {"type": "subtitle", "time": 3387.75, "timestamp": "00:56:27", "text": "哦，你真是。"}, {"type": "subtitle", "time": 3389.43, "timestamp": "00:56:29", "text": "我的天啊，为什么？"}, {"type": "subtitle", "time": 3390.71, "timestamp": "00:56:30", "text": "你们遭遇了各种各样的不幸。 好了，"}, {"type": "subtitle", "time": 3392.63, "timestamp": "00:56:32", "text": "我回来了。"}, {"type": "subtitle", "time": 3394.47, "timestamp": "00:56:34", "text": "我不知道。 我已经"}, {"type": "subtitle", "time": 3395.99, "timestamp": "00:56:35", "text": "两次被踢出游戏了。   是的"}, {"type": "subtitle", "time": 3397.43, "timestamp": "00:56:37", "text": "。"}, {"type": "subtitle", "time": 3399.27, "timestamp": "00:56:39", "text": "重新装弹。"}, {"type": "subtitle", "time": 3400.87, "timestamp": "00:56:40", "text": "谢谢。"}, {"type": "subtitle", "time": 3408.47, "timestamp": "00:56:48", "text": "我的意思是，你压在我身上，这让"}, {"type": "subtitle", "time": 3410.95, "timestamp": "00:56:50", "text": "你更加令人惊叹。"}]
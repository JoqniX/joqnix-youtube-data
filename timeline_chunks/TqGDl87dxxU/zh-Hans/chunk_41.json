[{"type": "subtitle", "time": 2474.069, "timestamp": "00:41:14", "text": "不，"}, {"type": "subtitle", "time": 2476.55, "timestamp": "00:41:16", "text": "哦，他瞬间移动了。"}, {"type": "subtitle", "time": 2479.91, "timestamp": "00:41:19", "text": "他们都出去了。"}, {"type": "subtitle", "time": 2481.829, "timestamp": "00:41:21", "text": "如何重新装弹？ 如何重新装弹？ 我的天啊。"}, {"type": "subtitle", "time": 2482.79, "timestamp": "00:41:22", "text": "什么方法都不管用。"}, {"type": "subtitle", "time": 2484.71, "timestamp": "00:41:24", "text": "全部。"}, {"type": "subtitle", "time": 2486.23, "timestamp": "00:41:26", "text": "哦，不错。"}, {"type": "subtitle", "time": 2502.63, "timestamp": "00:41:42", "text": "哦，你也有这个。"}, {"type": "subtitle", "time": 2505.349, "timestamp": "00:41:45", "text": "如果你能拿到这个人头，我就给你来个喷气式飞机特技"}, {"type": "subtitle", "time": 2514.79, "timestamp": "00:41:54", "text": "他们为什么玩得好像这是VCP之类的游戏一样"}, {"type": "subtitle", "time": 2516.87, "timestamp": "00:41:56", "text": "？"}, {"type": "subtitle", "time": 2517.67, "timestamp": "00:41:57", "text": "兄弟，是"}, {"type": "subtitle", "time": 2519.43, "timestamp": "00:41:59", "text": "我。"}]
[{"type": "subtitle", "time": 7202.87, "timestamp": "02:00:02", "text": "以前会做一种叫做“"}, {"type": "subtitle", "time": 7205.109, "timestamp": "02:00:05", "text": "营养米饭”的新片，"}, {"type": "subtitle", "time": 7207.589, "timestamp": "02:00:07", "text": "我一"}, {"type": "subtitle", "time": 7210.709, "timestamp": "02:00:10", "text": "年级的时候就经常吃，我通常会把调料"}, {"type": "subtitle", "time": 7212.229, "timestamp": "02:00:12", "text": "包"}, {"type": "subtitle", "time": 7215.51, "timestamp": "02:00:15", "text": "放在学校里，当时大家都"}, {"type": "subtitle", "time": 7218.629, "timestamp": "02:00:18", "text": "在，然后"}, {"type": "subtitle", "time": 7220.87, "timestamp": "02:00:20", "text": "全班同学都会和我一起吃。"}, {"type": "subtitle", "time": 7222.87, "timestamp": "02:00:22", "text": "嗯哼。 我的天啊。"}, {"type": "subtitle", "time": 7230.709, "timestamp": "02:00:30", "text": "我想你。   挺"}, {"type": "subtitle", "time": 7232.87, "timestamp": "02:00:32", "text": "不错的。"}, {"type": "subtitle", "time": 7235.35, "timestamp": "02:00:35", "text": "嗯。"}, {"type": "subtitle", "time": 7237.189, "timestamp": "02:00:37", "text": "我的天啊。"}, {"type": "subtitle", "time": 7237.75, "timestamp": "02:00:37", "text": "谢谢"}, {"type": "subtitle", "time": 7239.35, "timestamp": "02:00:39", "text": "兄弟。 就像第一次站在"}, {"type": "subtitle", "time": 7241.109, "timestamp": "02:00:41", "text": "那里一样，到最后每个人都带着一包东西"}, {"type": "subtitle", "time": 7242.55, "timestamp": "02:00:42", "text": "。   是的"}, {"type": "subtitle", "time": 7245.91, "timestamp": "02:00:45", "text": "，我知道。 哦，我见过有人"}, {"type": "subtitle", "time": 7248.95, "timestamp": "02:00:48", "text": "甚至在上课的时候就随手拨弄那玩意儿，"}, {"type": "subtitle", "time": 7251.51, "timestamp": "02:00:51", "text": "我就想，"}, {"type": "subtitle", "time": 7254.39, "timestamp": "02:00:54", "text": "“哦，哇，真不错。”"}, {"type": "subtitle", "time": 7256.79, "timestamp": "02:00:56", "text": "它传播得非常快。 起初他们"}, {"type": "subtitle", "time": 7258.629, "timestamp": "02:00:58", "text": "只是开玩笑，后来大家都开始"}]
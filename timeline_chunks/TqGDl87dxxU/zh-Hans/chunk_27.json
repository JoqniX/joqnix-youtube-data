[{"type": "subtitle", "time": 1628.07, "timestamp": "00:27:08", "text": "这里有个男的。 引导你向下走。   在"}, {"type": "subtitle", "time": 1630.47, "timestamp": "00:27:10", "text": "你身后。 按E键。按E键。按"}, {"type": "subtitle", "time": 1641.35, "timestamp": "00:27:21", "text": "沉默。 我的终极技能已经准备好了。"}, {"type": "subtitle", "time": 1642.71, "timestamp": "00:27:22", "text": "还剩一个敌人。   哟"}, {"type": "subtitle", "time": 1648.63, "timestamp": "00:27:28", "text": "哟，神话级。"}, {"type": "subtitle", "time": 1649.75, "timestamp": "00:27:29", "text": "你可以做到。"}, {"type": "subtitle", "time": 1652.47, "timestamp": "00:27:32", "text": "我相信你。"}, {"type": "subtitle", "time": 1653.029, "timestamp": "00:27:33", "text": "旋转。"}, {"type": "subtitle", "time": 1654.23, "timestamp": "00:27:34", "text": "我的天啊，兄弟。"}, {"type": "subtitle", "time": 1655.59, "timestamp": "00:27:35", "text": "你知道吗？ 等等，我要跟"}, {"type": "subtitle", "time": 1658.23, "timestamp": "00:27:38", "text": "他打一架。"}, {"type": "subtitle", "time": 1665.669, "timestamp": "00:27:45", "text": "好一个。"}, {"type": "subtitle", "time": 1667.59, "timestamp": "00:27:47", "text": "好的。 好的。 那么，谁看到了？ 谁"}, {"type": "subtitle", "time": 1669.11, "timestamp": "00:27:49", "text": "看到了？ 好的。 谁看到了？"}, {"type": "subtitle", "time": 1679.75, "timestamp": "00:27:59", "text": "这种情况会发生一两次。 大概"}]
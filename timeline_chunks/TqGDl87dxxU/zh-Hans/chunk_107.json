[{"type": "subtitle", "time": 6424.79, "timestamp": "01:47:04", "text": "如此流畅、如此优雅地从一边移动到另一边，她显然"}, {"type": "subtitle", "time": 6426.629, "timestamp": "01:47:06", "text": "知道自己在做什么。"}, {"type": "subtitle", "time": 6428.709, "timestamp": "01:47:08", "text": "一切。"}, {"type": "subtitle", "time": 6430.39, "timestamp": "01:47:10", "text": "超好的。"}, {"type": "subtitle", "time": 6433.75, "timestamp": "01:47:13", "text": "那些植物真是太美了。   是的"}, {"type": "subtitle", "time": 6435.51, "timestamp": "01:47:15", "text": "。"}, {"type": "subtitle", "time": 6438.55, "timestamp": "01:47:18", "text": "你用迷你机枪杀了很多敌人"}, {"type": "subtitle", "time": 6440.07, "timestamp": "01:47:20", "text": "。 它叫什么名字？"}, {"type": "subtitle", "time": 6443.109, "timestamp": "01:47:23", "text": "那东西，那把"}, {"type": "subtitle", "time": 6445.99, "timestamp": "01:47:25", "text": "枪。 你用迷你机枪杀了很多敌人"}, {"type": "subtitle", "time": 6448.629, "timestamp": "01:47:28", "text": "。 等等，它叫什么来着？ 我"}, {"type": "subtitle", "time": 6451.03, "timestamp": "01:47:31", "text": "忘了那把枪的名字。"}, {"type": "subtitle", "time": 6452.95, "timestamp": "01:47:32", "text": "呃，奥丁。 奥丁。"}, {"type": "subtitle", "time": 6453.83, "timestamp": "01:47:33", "text": "不，兄弟。"}, {"type": "subtitle", "time": 6455.03, "timestamp": "01:47:35", "text": "奥丁。"}, {"type": "subtitle", "time": 6460.149, "timestamp": "01:47:40", "text": "你简直是在锁定那些顶级"}, {"type": "subtitle", "time": 6462.149, "timestamp": "01:47:42", "text": "玩家，兄弟。 你在跟我说什么？"}, {"type": "subtitle", "time": 6465.75, "timestamp": "01:47:45", "text": "你在这方面做得非常出色。"}, {"type": "subtitle", "time": 6467.669, "timestamp": "01:47:47", "text": "我猜她是在利用外星人。   是的"}, {"type": "subtitle", "time": 6471.03, "timestamp": "01:47:51", "text": "。 是的。 是的。"}, {"type": "subtitle", "time": 6474.07, "timestamp": "01:47:54", "text": "我觉得我现在得"}, {"type": "subtitle", "time": 6477.99, "timestamp": "01:47:57", "text": "在线下努力刷很多东西才能变得像Joke一样厉害。"}]
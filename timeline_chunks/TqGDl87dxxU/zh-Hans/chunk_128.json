[{"type": "subtitle", "time": 7681.83, "timestamp": "02:08:01", "text": "还是不如粉笔好用。"}, {"type": "subtitle", "time": 7684.95, "timestamp": "02:08:04", "text": "我知道。 我很糟糕。"}, {"type": "subtitle", "time": 7691.03, "timestamp": "02:08:11", "text": "请让我变得像你说的那么坏。 我"}, {"type": "subtitle", "time": 7693.189, "timestamp": "02:08:13", "text": "想变得像"}, {"type": "subtitle", "time": 7695.51, "timestamp": "02:08:15", "text": "我从未存在过一样糟糕。 如果他继续"}, {"type": "subtitle", "time": 7711.51, "timestamp": "02:08:31", "text": "只管玩乐。   是的"}, {"type": "subtitle", "time": 7713.03, "timestamp": "02:08:33", "text": "，那样会更好。 我想我"}, {"type": "subtitle", "time": 7725.91, "timestamp": "02:08:45", "text": "你们能听到背景噪音吗？"}, {"type": "subtitle", "time": 7726.149, "timestamp": "02:08:46", "text": "我会像"}, {"type": "subtitle", "time": 7728.39, "timestamp": "02:08:48", "text": "我妈妈在后面说话一样，用派对的语气说话"}, {"type": "subtitle", "time": 7730.39, "timestamp": "02:08:50", "text": "。"}, {"type": "subtitle", "time": 7731.03, "timestamp": "02:08:51", "text": "感谢上帝。"}, {"type": "subtitle", "time": 7733.43, "timestamp": "02:08:53", "text": "但如果我说话聚会，大家就听不到"}, {"type": "subtitle", "time": 7735.109, "timestamp": "02:08:55", "text": "我说话了，对吧？"}, {"type": "subtitle", "time": 7738.229, "timestamp": "02:08:58", "text": "不，或许我们可以在游戏里互相静音"}]
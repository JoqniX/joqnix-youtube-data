[{"type": "subtitle", "time": 3909.51, "timestamp": "01:05:09", "text": "他们根本不知道我有多冷酷无情。"}, {"type": "subtitle", "time": 3910.63, "timestamp": "01:05:10", "text": "狠心。"}, {"type": "subtitle", "time": 3913.43, "timestamp": "01:05:13", "text": "Raina真是个狠角色。"}, {"type": "subtitle", "time": 3917.029, "timestamp": "01:05:17", "text": "我爱她的一切。"}, {"type": "subtitle", "time": 3919.91, "timestamp": "01:05:19", "text": "语音台词都对她赞不绝口。   对了"}, {"type": "subtitle", "time": 3922.71, "timestamp": "01:05:22", "text": "，"}, {"type": "subtitle", "time": 3924.789, "timestamp": "01:05:24", "text": "我很喜欢她的笑声。"}, {"type": "subtitle", "time": 3927.75, "timestamp": "01:05:27", "text": "那邪恶的笑声。   是的"}, {"type": "subtitle", "time": 3929.51, "timestamp": "01:05:29", "text": "。 是的。 当你杀了一个人，是的"}, {"type": "subtitle", "time": 3930.71, "timestamp": "01:05:30", "text": "，我知道。"}, {"type": "subtitle", "time": 3933.75, "timestamp": "01:05:33", "text": "哦，是的。"}, {"type": "subtitle", "time": 3935.829, "timestamp": "01:05:35", "text": "我甚至连一个病人都不认识"}, {"type": "subtitle", "time": 3936.39, "timestamp": "01:05:36", "text": "。"}, {"type": "subtitle", "time": 3938.15, "timestamp": "01:05:38", "text": "我会拼尽全力，甚至不惜"}, {"type": "subtitle", "time": 3944.95, "timestamp": "01:05:44", "text": "我愿意做。"}, {"type": "subtitle", "time": 3948.069, "timestamp": "01:05:48", "text": "哦，我们其实在香港。 哇。 等等，"}, {"type": "subtitle", "time": 3950.95, "timestamp": "01:05:50", "text": "香港是最近才加入的，还是"}, {"type": "subtitle", "time": 3952.87, "timestamp": "01:05:52", "text": "之前就有了？   在"}, {"type": "subtitle", "time": 3955.43, "timestamp": "01:05:55", "text": "马尼拉加入之前它就已经在那里了。"}, {"type": "subtitle", "time": 3957.349, "timestamp": "01:05:57", "text": "他们最近新增了马尼拉地区。"}]
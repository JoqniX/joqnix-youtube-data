[{"type": "subtitle", "time": 3367.19, "timestamp": "00:56:07", "text": "血液交易。好的。"}, {"type": "subtitle", "time": 3376.15, "timestamp": "00:56:16", "text": "哦，不。  等待。那香港伺服器怎麼樣？對所有人來說，像香港那樣可以嗎"}, {"type": "subtitle", "time": 3389.43, "timestamp": "00:56:29", "text": "？  沒關係。別理我。我玩得很開心。沒關係。  如果這對"}, {"type": "subtitle", "time": 3390.71, "timestamp": "00:56:30", "text": "你來說這麼不好，我想我們可以試試看別的。  沒關係。  哦，沒關係。我的天哪。  他加入後會變得更強。"}, {"type": "subtitle", "time": 3394.47, "timestamp": "00:56:34", "text": "我知道，對吧？他好像要把它們都買下來。"}]
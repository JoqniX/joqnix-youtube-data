[{"type": "subtitle", "time": 2293.829, "timestamp": "00:38:13", "text": "視野"}, {"type": "subtitle", "time": 2319.27, "timestamp": "00:38:39", "text": "抓住他。  哦，是的。  耶。我想我們走吧。  嘿。  你好。為什麼喜歡玩遊戲？  歡迎。好久不見了。"}, {"type": "subtitle", "time": 2327.91, "timestamp": "00:38:47", "text": "你好。  過來。  等待。我突然出現了。如何？哦，我有四次"}, {"type": "subtitle", "time": 2330.87, "timestamp": "00:38:50", "text": "擊殺。"}, {"type": "subtitle", "time": 2339.91, "timestamp": "00:38:59", "text": "哇，這人後撤步跳得真棒！  高處的風景。  哦"}]
[{"type": "subtitle", "time": 3613.109, "timestamp": "01:00:13", "text": "開玩笑吧。大家好。開玩笑吧。我的天啊。  我是怎麼做到的？  我的天啊。  我什至不知道。  打不過他。"}, {"type": "subtitle", "time": 3631.99, "timestamp": "01:00:31", "text": "他隔著牆向他們開槍。就像我們和他們一樣，就像他們展示的那樣，只有一個人。  我的天啊。  現在"}, {"type": "subtitle", "time": 3635.75, "timestamp": "01:00:35", "text": "還能殺死它們嗎？  狗狗"}, {"type": "subtitle", "time": 3655.349, "timestamp": "01:00:55", "text": "PRX效力的。我專業上知道。  不，是他一直瞞著我們。  就像《被遺棄"}, {"type": "subtitle", "time": 3657.67, "timestamp": "01:00:57", "text": "者》一樣。或許像被"}]
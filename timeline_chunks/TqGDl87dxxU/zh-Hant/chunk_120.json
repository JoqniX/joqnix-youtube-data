[{"type": "subtitle", "time": 7215.51, "timestamp": "02:00:15", "text": "有人在那兒，就大聲喊「誰在"}, {"type": "subtitle", "time": 7218.629, "timestamp": "02:00:18", "text": "那裡？」兄弟，那是我最害怕的事情之一，"}, {"type": "subtitle", "time": 7222.87, "timestamp": "02:00:22", "text": "兄弟。想像一下你獨自一人處一個可怕的地方。你這隻小貓咪，兄弟。"}, {"type": "subtitle", "time": 7239.35, "timestamp": "02:00:39", "text": "兄弟。  精彩的。  是的。例如，如果我們被他們栽贓陷害兩次，我們該怎麼辦，兄弟？  B點下降。我快瘋了。  還剩一個"}, {"type": "subtitle", "time": 7245.91, "timestamp": "02:00:45", "text": "敵人。  等等，治好我。治愈我。治愈我。治愈我。  我聽到一聲"}, {"type": "subtitle", "time": 7254.39, "timestamp": "02:00:54", "text": "「不」。我把它弄壞了"}, {"type": "subtitle", "time": 7256.79, "timestamp": "02:00:56", "text": "。我把它弄壞了。"}]
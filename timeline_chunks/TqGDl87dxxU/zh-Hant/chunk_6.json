[{"type": "subtitle", "time": 361.27, "timestamp": "00:06:01", "text": "你們聽得到我說話嗎？有"}, {"type": "subtitle", "time": 362.95, "timestamp": "00:06:02", "text": "音頻嗎？"}, {"type": "subtitle", "time": 364.15, "timestamp": "00:06:04", "text": "你們聽得到我說話嗎？"}, {"type": "subtitle", "time": 372.309, "timestamp": "00:06:12", "text": "好的，好的，好的，好的，好的。好的。"}, {"type": "subtitle", "time": 374.55, "timestamp": "00:06:14", "text": "首先，我想說這將"}, {"type": "subtitle", "time": 377.43, "timestamp": "00:06:17", "text": "是我的第一次直播，一次桌面"}, {"type": "subtitle", "time": 381.749, "timestamp": "00:06:21", "text": "直播，呃，也是一次合作直播，呃，"}, {"type": "subtitle", "time": 384.87, "timestamp": "00:06:24", "text": "今天在場的許多創作者"}, {"type": "chat", "time": 387.032, "timestamp": "00:06:27", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "hi"}, {"type": "subtitle", "time": 387.35, "timestamp": "00:06:27", "text": "。嗯，既有新面孔，也"}, {"type": "subtitle", "time": 389.27, "timestamp": "00:06:29", "text": "有我以前合作過的人"}, {"type": "subtitle", "time": 391.83, "timestamp": "00:06:31", "text": "。是的，他們都是"}, {"type": "subtitle", "time": 394.629, "timestamp": "00:06:34", "text": "印度版的我。所以，祝你一切順利"}, {"type": "subtitle", "time": 398.629, "timestamp": "00:06:38", "text": "。所有連結（包括所有相關"}, {"type": "subtitle", "time": 400.469, "timestamp": "00:06:40", "text": "連結）都會放在"}, {"type": "subtitle", "time": 403.11, "timestamp": "00:06:43", "text": "YouTube 影片的描述中。呃，對於那些"}, {"type": "subtitle", "time": 406.23, "timestamp": "00:06:46", "text": "在 Twitch 之類的平台上直播的人來說，我不確定"}, {"type": "subtitle", "time": 408.55, "timestamp": "00:06:48", "text": "今天是否有人在 Twitch 上直播，但是，可以"}, {"type": "subtitle", "time": 412.55, "timestamp": "00:06:52", "text": "去 YouTube 上看。嗯，會在"}, {"type": "subtitle", "time": 415.189, "timestamp": "00:06:55", "text": "描述裡寫。好的，我把它打到"}, {"type": "subtitle", "time": 418.23, "timestamp": "00:06:58", "text": "聊天框裡。一秒鐘。"}]
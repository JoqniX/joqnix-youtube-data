[{"type": "subtitle", "time": 7684.95, "timestamp": "02:08:04", "text": "我的天啊。我的天哪，太棒了！  我的天啊。  這"}, {"type": "subtitle", "time": 7691.03, "timestamp": "02:08:11", "text": "我"}, {"type": "subtitle", "time": 7693.189, "timestamp": "02:08:13", "text": "需要療癒。不，那太酷了。"}, {"type": "subtitle", "time": 7695.51, "timestamp": "02:08:15", "text": "她其實是跟"}, {"type": "subtitle", "time": 7711.51, "timestamp": "02:08:31", "text": "學的。"}, {"type": "subtitle", "time": 7713.03, "timestamp": "02:08:33", "text": "好的。  歡迎暢所欲言。"}, {"type": "subtitle", "time": 7731.03, "timestamp": "02:08:51", "text": "謝謝。  揚聲器 2.0。是的。  哦，是你嗎？哦，對不起。  給自己買把槍。  或者說，太棒了。  費用已用完。"}, {"type": "subtitle", "time": 7733.43, "timestamp": "02:08:53", "text": "我沒貨了，我忘了買錯東西。  敵方目標。  我的天啊。  我走了。  順便說一句，我需要"}, {"type": "subtitle", "time": 7738.229, "timestamp": "02:08:58", "text": "療傷。哦"}]
[{"type": "subtitle", "time": 7947.99, "timestamp": "02:12:27", "text": ">> He was behind you."}, {"type": "subtitle", "time": 7950.629, "timestamp": "02:12:30", "text": ">> How did he go behind?"}, {"type": "subtitle", "time": 7952.39, "timestamp": "02:12:32", "text": ">> I know, right? I also thought he was in"}, {"type": "subtitle", "time": 7960.95, "timestamp": "02:12:40", "text": "here."}]
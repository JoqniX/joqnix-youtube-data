[{"type": "subtitle", "time": 7320.79, "timestamp": "02:02:00", "text": "跳跃。呃，与电机相反。"}, {"type": "subtitle", "time": 7334.87, "timestamp": "02:02:14", "text": "但我认为你应该相信地图。"}, {"type": "subtitle", "time": 7336.149, "timestamp": "02:02:16", "text": "是的，我认为你应该依靠你的"}, {"type": "subtitle", "time": 7338.47, "timestamp": "02:02:18", "text": "操 L。"}, {"type": "subtitle", "time": 7347.43, "timestamp": "02:02:27", "text": "各位，我玩这个游戏超厉害的。与……不同"}, {"type": "subtitle", "time": 7355.75, "timestamp": "02:02:35", "text": "好了，伙计们，上车吧。他妈的为什么？"}, {"type": "subtitle", "time": 7359.589, "timestamp": "02:02:39", "text": "谁把这里弄得一团糟？我的天啊。什么"}, {"type": "subtitle", "time": 7361.91, "timestamp": "02:02:41", "text": "这是吗？我没有做这件事。谁干的"}, {"type": "subtitle", "time": 7365.03, "timestamp": "02:02:45", "text": "兄弟，是这个吗？"}, {"type": "subtitle", "time": 7367.109, "timestamp": "02:02:47", "text": "是你们其中一个人干的。我向上帝发誓，如果"}, {"type": "subtitle", "time": 7369.669, "timestamp": "02:02:49", "text": "这是你们中的一个。我甚至连一个都没有"}, {"type": "subtitle", "time": 7372.149, "timestamp": "02:02:52", "text": "跨性别的东西。"}, {"type": "subtitle", "time": 7379.589, "timestamp": "02:02:59", "text": "请。开门。开门。"}]
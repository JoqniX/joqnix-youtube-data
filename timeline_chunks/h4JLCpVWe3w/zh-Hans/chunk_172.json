[{"type": "subtitle", "time": 10321.269, "timestamp": "02:52:01", "text": "原料。没有垃圾。不行"}, {"type": "subtitle", "time": 10323.83, "timestamp": "02:52:03", "text": "汽油。等等，如果我混合"}, {"type": "subtitle", "time": 10326.87, "timestamp": "02:52:06", "text": "阿斯彭因饮用红牛而死亡？是的，你可以"}, {"type": "subtitle", "time": 10331.51, "timestamp": "02:52:11", "text": "照做。你收到“这他妈什么鬼？”好的。"}, {"type": "subtitle", "time": 10333.19, "timestamp": "02:52:13", "text": "你甚至可以把它抽掉。"}, {"type": "subtitle", "time": 10336.389, "timestamp": "02:52:16", "text": "观察效果。是的。"}, {"type": "subtitle", "time": 10339.309, "timestamp": "02:52:19", "text": "好的。把它放进去"}, {"type": "subtitle", "time": 10341.19, "timestamp": "02:52:21", "text": "那里。尽量做到最好"}, {"type": "subtitle", "time": 10344.75, "timestamp": "02:52:24", "text": "复杂的药物"}, {"type": "subtitle", "time": 10347.55, "timestamp": "02:52:27", "text": "这里。阿斯彭"}, {"type": "subtitle", "time": 10359.269, "timestamp": "02:52:39", "text": "好的。我该抽这个吗？抽一口。"}, {"type": "subtitle", "time": 10369.429, "timestamp": "02:52:49", "text": "哦。哦，我觉得你的脸变大了。我的"}, {"type": "subtitle", "time": 10371.91, "timestamp": "02:52:51", "text": "脸。哦，是的。哦，是的。你长久"}, {"type": "subtitle", "time": 10375.59, "timestamp": "02:52:55", "text": "脸。我的脖子好痛。我的脖子……你按压"}, {"type": "subtitle", "time": 10377.349, "timestamp": "02:52:57", "text": "按下键盘上的 V 键即可看到自己。"}, {"type": "subtitle", "time": 10378.71, "timestamp": "02:52:58", "text": "是的。是的，我就是这样。"}]
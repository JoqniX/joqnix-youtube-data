[{"type": "subtitle", "time": 4141.03, "timestamp": "01:09:01", "text": "做。我可以蹲下吗？"}, {"type": "subtitle", "time": 4147.43, "timestamp": "01:09:07", "text": "我们该不该剧透，或者像……"}, {"type": "subtitle", "time": 4152.309, "timestamp": "01:09:12", "text": "嗯嗯，好的，关于主游戏"}, {"type": "subtitle", "time": 4155.43, "timestamp": "01:09:15", "text": "大概。我只想说，拿走吧。"}, {"type": "subtitle", "time": 4157.669, "timestamp": "01:09:17", "text": "你库存里的东西"}, {"type": "subtitle", "time": 4161.349, "timestamp": "01:09:21", "text": "在你离开之前。就这样。哦，它"}, {"type": "subtitle", "time": 4164.87, "timestamp": "01:09:24", "text": "这将对你大有帮助。哦好的。好的。"}, {"type": "subtitle", "time": 4166.789, "timestamp": "01:09:26", "text": "好的。等等，你没玩过这个游戏吗？"}, {"type": "subtitle", "time": 4169.99, "timestamp": "01:09:29", "text": "游戏，伊曼？不，不。我喜欢“没有东西是”"}, {"type": "subtitle", "time": 4172.709, "timestamp": "01:09:32", "text": "好像我没做过似的。"}, {"type": "subtitle", "time": 4174.709, "timestamp": "01:09:34", "text": "是的。"}, {"type": "subtitle", "time": 4177.269, "timestamp": "01:09:37", "text": "好的。"}, {"type": "subtitle", "time": 4183.669, "timestamp": "01:09:43", "text": "不能。等等，还有更多可以收获的吗？"}, {"type": "subtitle", "time": 4192.55, "timestamp": "01:09:52", "text": "就像我想的那样，一旦你"}]
[{"type": "subtitle", "time": 18541.35, "timestamp": "05:09:01", "text": "临界点。我好像听到了什么。什么？哦，我"}, {"type": "subtitle", "time": 18546.788, "timestamp": "05:09:06", "text": "听她说。哦，千万别动。"}, {"type": "subtitle", "time": 18548.788, "timestamp": "05:09:08", "text": "用手电筒可以吗？"}, {"type": "subtitle", "time": 18550.708, "timestamp": "05:09:10", "text": "相机？"}, {"type": "subtitle", "time": 18553.35, "timestamp": "05:09:13", "text": "那不是手电筒。那是你的"}, {"type": "subtitle", "time": 18554.948, "timestamp": "05:09:14", "text": "手电筒。"}, {"type": "subtitle", "time": 18558.15, "timestamp": "05:09:18", "text": "是的。你关门了吗？是的，我"}, {"type": "subtitle", "time": 18562.708, "timestamp": "05:09:22", "text": "做过。好的。不用担心。"}, {"type": "subtitle", "time": 18574.75, "timestamp": "05:09:34", "text": "我的天哪。"}, {"type": "subtitle", "time": 18579.11, "timestamp": "05:09:39", "text": "好的。因此，最长狩猎持续时间可以"}, {"type": "subtitle", "time": 18582.708, "timestamp": "05:09:42", "text": "最多持续 1 分钟。"}, {"type": "subtitle", "time": 18584.628, "timestamp": "05:09:44", "text": "1分钟。"}, {"type": "subtitle", "time": 18587.59, "timestamp": "05:09:47", "text": "40秒。 50秒。 1分钟。打猎"}, {"type": "subtitle", "time": 18589.75, "timestamp": "05:09:49", "text": "期间。如果猎杀率很高，那么狩猎就会进行。"}, {"type": "subtitle", "time": 18591.59, "timestamp": "05:09:51", "text": "持续时间中等，20秒，40"}, {"type": "subtitle", "time": 18594.15, "timestamp": "05:09:54", "text": "秒，50秒，狩猎持续时间短，"}, {"type": "subtitle", "time": 18597.99, "timestamp": "05:09:57", "text": "15秒、30秒、40秒。"}]
[{"type": "subtitle", "time": 14582.79, "timestamp": "04:03:02", "text": "每次你打开……的时候，都这么说"}, {"type": "subtitle", "time": 14585.229, "timestamp": "04:03:05", "text": "游戏将会是，将会是"}, {"type": "subtitle", "time": 14589.349, "timestamp": "04:03:09", "text": "重置骨骼。呃，不。哦，对了"}, {"type": "subtitle", "time": 14591.269, "timestamp": "04:03:11", "text": "骨头可能不会重置，但我并不这么认为。"}, {"type": "subtitle", "time": 14593.189, "timestamp": "04:03:13", "text": "知道。我玩得不多。我"}, {"type": "subtitle", "time": 14596.349, "timestamp": "04:03:16", "text": "我觉得很可能是这样。"}, {"type": "subtitle", "time": 14599.75, "timestamp": "04:03:19", "text": "好的。因为上次我相信我这么做了"}, {"type": "subtitle", "time": 14602.389, "timestamp": "04:03:22", "text": "解锁两张地图，但我玩的时候"}, {"type": "subtitle", "time": 14604.229, "timestamp": "04:03:24", "text": "今天，一切都从这里开始了。"}, {"type": "subtitle", "time": 14608.71, "timestamp": "04:03:28", "text": "开始。事情是这样的，嗯……我猜"}, {"type": "subtitle", "time": 14611.03, "timestamp": "04:03:31", "text": "这取决于"}, {"type": "subtitle", "time": 14612.79, "timestamp": "04:03:32", "text": "呃，有多少名玩家？"}, {"type": "subtitle", "time": 14614.429, "timestamp": "04:03:34", "text": "一起演奏。大概是吧"}, {"type": "subtitle", "time": 14618.15, "timestamp": "04:03:38", "text": "像一两个或者四五个，它就开始了。"}, {"type": "subtitle", "time": 14621.83, "timestamp": "04:03:41", "text": "很快。但是如果有像……"}, {"type": "subtitle", "time": 14623.51, "timestamp": "04:03:43", "text": "玩家数量非常少，而且"}, {"type": "subtitle", "time": 14626.469, "timestamp": "04:03:46", "text": "延伸很长。就像第一部那样"}, {"type": "subtitle", "time": 14628.95, "timestamp": "04:03:48", "text": "你看到的地图，我们花了将近30分钟。"}, {"type": "subtitle", "time": 14631.83, "timestamp": "04:03:51", "text": "之所以用分钟，是因为它不喜欢"}, {"type": "subtitle", "time": 14634.07, "timestamp": "04:03:54", "text": "第一张地图花费的时间太长了。所以"}, {"type": "subtitle", "time": 14636.309, "timestamp": "04:03:56", "text": "这就是我讨厌玩第一张地图的原因。"}, {"type": "subtitle", "time": 14639.67, "timestamp": "04:03:59", "text": "另外，如果你没有进入……"}]
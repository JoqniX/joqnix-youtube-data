[{"type": "subtitle", "time": 16800.55, "timestamp": "04:40:00", "text": "盘子朝我飞过来了。"}, {"type": "subtitle", "time": 16803.51, "timestamp": "04:40:03", "text": "我的天啊。"}, {"type": "subtitle", "time": 16806.55, "timestamp": "04:40:06", "text": "等待。我们拉屎了，是吗？"}, {"type": "subtitle", "time": 16809.83, "timestamp": "04:40:09", "text": "嗯，我觉得听起来不会太吵。我"}, {"type": "subtitle", "time": 16814.15, "timestamp": "04:40:14", "text": "我想我们大概能听到，你知道的"}, {"type": "subtitle", "time": 16815.99, "timestamp": "04:40:15", "text": "鞋子还是锤子更重要。我不"}, {"type": "subtitle", "time": 16819.83, "timestamp": "04:40:19", "text": "知道。哦，她是要攻击我吗？"}, {"type": "subtitle", "time": 16822.47, "timestamp": "04:40:22", "text": "不，她做的也是同样的事情。真是"}, {"type": "subtitle", "time": 16824.948, "timestamp": "04:40:24", "text": "蠢货。你想让我挪动吗？我是说，"}, {"type": "subtitle", "time": 16828.67, "timestamp": "04:40:28", "text": "如果你愿意，你可以。我正在获得"}, {"type": "subtitle", "time": 16832.628, "timestamp": "04:40:32", "text": "无聊的。去你妈的，贱人。"}, {"type": "subtitle", "time": 16835.19, "timestamp": "04:40:35", "text": "让我们来看看。"}, {"type": "subtitle", "time": 16836.708, "timestamp": "04:40:36", "text": "等等，在这里等一下。看看她会不会来。"}]
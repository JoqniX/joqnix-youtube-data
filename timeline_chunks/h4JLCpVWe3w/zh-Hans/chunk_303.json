[{"type": "subtitle", "time": 18181.43, "timestamp": "05:03:01", "text": "待在那儿。别说，别说，别说"}, {"type": "subtitle", "time": 18183.35, "timestamp": "05:03:03", "text": "任何事物。是的。是的。去。坐在那儿。坐"}, {"type": "subtitle", "time": 18186.55, "timestamp": "05:03:06", "text": "那里。停止。关掉所有设备。不"}, {"type": "subtitle", "time": 18189.11, "timestamp": "05:03:09", "text": "尖叫声不断。冷静下来。冷静下来。"}, {"type": "subtitle", "time": 18191.51, "timestamp": "05:03:11", "text": "记住你所说的那个东西"}, {"type": "subtitle", "time": 18195.27, "timestamp": "05:03:15", "text": "那些？这是一个梗。"}, {"type": "subtitle", "time": 18198.47, "timestamp": "05:03:18", "text": "记住“是”。它叫什么名字？这"}, {"type": "subtitle", "time": 18202.868, "timestamp": "05:03:22", "text": "鱼爸爸。啊。是的。哦。"}, {"type": "subtitle", "time": 18204.868, "timestamp": "05:03:24", "text": "我的天啊。"}, {"type": "subtitle", "time": 18207.27, "timestamp": "05:03:27", "text": "是的。看看我的小弟弟。你这该死的靴子。"}, {"type": "subtitle", "time": 18209.51, "timestamp": "05:03:29", "text": "你这该死的艾米莉·狄金森。我接受"}, {"type": "subtitle", "time": 18211.51, "timestamp": "05:03:31", "text": "把你的鸡巴露出来。"}, {"type": "subtitle", "time": 18213.03, "timestamp": "05:03:33", "text": "男生，"}, {"type": "subtitle", "time": 18215.83, "timestamp": "05:03:35", "text": "我无法确定相机是否出了问题。啊，不"}, {"type": "subtitle", "time": 18217.67, "timestamp": "05:03:37", "text": "担忧。您可以稍后再放置。"}, {"type": "subtitle", "time": 18221.75, "timestamp": "05:03:41", "text": "也。保持冷静。不要打开你的"}, {"type": "subtitle", "time": 18223.43, "timestamp": "05:03:43", "text": "盒子。"}, {"type": "subtitle", "time": 18227.11, "timestamp": "05:03:47", "text": "打开你的日记本。我呃，检查一下是否"}, {"type": "subtitle", "time": 18230.19, "timestamp": "05:03:50", "text": "腌制完成。呃"}, {"type": "subtitle", "time": 18234.47, "timestamp": "05:03:54", "text": "家里的盐罐没装满。啊，糟糕。"}, {"type": "subtitle", "time": 18235.83, "timestamp": "05:03:55", "text": "你本可以，你应该把"}, {"type": "subtitle", "time": 18238.788, "timestamp": "05:03:58", "text": "盐排成一排，对吧？所以如果她或我"}, {"type": "subtitle", "time": 18239.83, "timestamp": "05:03:59", "text": "不知道那鬼到底是什么鬼"}]
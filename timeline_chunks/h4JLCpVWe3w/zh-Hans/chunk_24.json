[{"type": "subtitle", "time": 1444.23, "timestamp": "00:24:04", "text": "担心。我们走吧。我完成了那个任务。"}, {"type": "subtitle", "time": 1446.31, "timestamp": "00:24:06", "text": "最后。"}, {"type": "subtitle", "time": 1447.789, "timestamp": "00:24:07", "text": "去"}, {"type": "subtitle", "time": 1450.47, "timestamp": "00:24:10", "text": "干净的。这里到处都是杂物。"}, {"type": "subtitle", "time": 1458.87, "timestamp": "00:24:18", "text": "干净的。伙计们，让我发财吧。嗯，我是"}, {"type": "subtitle", "time": 1462.95, "timestamp": "00:24:22", "text": "兴奋不已，因为我能让自己变得非常富有。我是"}, {"type": "subtitle", "time": 1465.51, "timestamp": "00:24:25", "text": "我要去做很多事"}, {"type": "subtitle", "time": 1468.99, "timestamp": "00:24:28", "text": "事物。我等不及了。让我"}, {"type": "subtitle", "time": 1477.19, "timestamp": "00:24:37", "text": "还有，你想来点冰毒吗？你不想"}, {"type": "subtitle", "time": 1478.51, "timestamp": "00:24:38", "text": "那？"}, {"type": "subtitle", "time": 1482.269, "timestamp": "00:24:42", "text": "好的。你想来点吗？拿"}, {"type": "subtitle", "time": 1487.149, "timestamp": "00:24:47", "text": "它。你想来点吗？拿"}, {"type": "subtitle", "time": 1490.43, "timestamp": "00:24:50", "text": "它。变成外星人。"}, {"type": "subtitle", "time": 1493.149, "timestamp": "00:24:53", "text": "迪奥。你想"}]
[{"type": "subtitle", "time": 6242.48, "timestamp": "01:44:02", "text": "到底怎么回事，兄弟？ 好的。"}, {"type": "subtitle", "time": 6245.44, "timestamp": "01:44:05", "text": "好的。 好的。他们抓不到我。他们不能"}, {"type": "subtitle", "time": 6248.719, "timestamp": "01:44:08", "text": "好的。他们抓不到我。他们不能 别再抓我了。"}, {"type": "subtitle", "time": 6254.55, "timestamp": "01:44:14", "text": "我在集装箱上面。我们开始吧"}, {"type": "subtitle", "time": 6256.07, "timestamp": "01:44:16", "text": "去。"}, {"type": "subtitle", "time": 6257.669, "timestamp": "01:44:17", "text": "你好吗？编辑"}, {"type": "subtitle", "time": 6260.87, "timestamp": "01:44:20", "text": "扩大。你要小心点。"}, {"type": "subtitle", "time": 6263.99, "timestamp": "01:44:23", "text": "你们。你好吗，大个子？好的。"}, {"type": "subtitle", "time": 6270.39, "timestamp": "01:44:30", "text": "他妈的？唐娜在哪儿？唐娜死了吗？"}, {"type": "subtitle", "time": 6272.47, "timestamp": "01:44:32", "text": "不知道。唐娜要逃跑了。"}, {"type": "subtitle", "time": 6274.629, "timestamp": "01:44:34", "text": "唐娜在哪儿？唐娜，我需要租……"}, {"type": "subtitle", "time": 6284.95, "timestamp": "01:44:44", "text": "我是唐娜，我想和你谈谈，姑娘。"}, {"type": "subtitle", "time": 6287.83, "timestamp": "01:44:47", "text": "呃，我想租个房间。将是75"}, {"type": "subtitle", "time": 6290.79, "timestamp": "01:44:50", "text": "本周。美好的。一号房间。"}, {"type": "subtitle", "time": 6293.99, "timestamp": "01:44:53", "text": "好了，各位。我们有房间。"}, {"type": "subtitle", "time": 6296.79, "timestamp": "01:44:56", "text": "你还好吗？进来吧。快点。我们走吧。"}, {"type": "subtitle", "time": 6298.47, "timestamp": "01:44:58", "text": "是的。进去。进去。我进不去。"}]
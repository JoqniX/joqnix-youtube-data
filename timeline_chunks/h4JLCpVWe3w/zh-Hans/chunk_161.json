[{"type": "subtitle", "time": 9661.95, "timestamp": "02:41:01", "text": "电力厂狙击手地块"}, {"type": "subtitle", "time": 9665.75, "timestamp": "02:41:05", "text": "戳。我简直就是个小混混。"}, {"type": "subtitle", "time": 9669.75, "timestamp": "02:41:09", "text": "等待。搅拌站。哦，那是"}, {"type": "subtitle", "time": 9678.23, "timestamp": "02:41:18", "text": "韦斯特韦尔。哦，我们解锁了新区域。"}, {"type": "subtitle", "time": 9680.99, "timestamp": "02:41:20", "text": "好，好，好，好。好的，我要走了"}, {"type": "subtitle", "time": 9683.99, "timestamp": "02:41:23", "text": "没错。你为……打开大门"}, {"type": "subtitle", "time": 9688.55, "timestamp": "02:41:28", "text": "我。不，这就是你的用处。"}, {"type": "subtitle", "time": 9690.79, "timestamp": "02:41:30", "text": "他妈的。不。好吧，我要买了。"}, {"type": "subtitle", "time": 9698.83, "timestamp": "02:41:38", "text": "酒店。呃，我想买个房间。"}, {"type": "subtitle", "time": 9701.03, "timestamp": "02:41:41", "text": "是的。你可以在哪里找到后面的房间"}, {"type": "subtitle", "time": 9702.469, "timestamp": "02:41:42", "text": "楼上的餐厅。好的。"}, {"type": "subtitle", "time": 9704.79, "timestamp": "02:41:44", "text": "谢谢您，温克夫人。你对……感兴趣吗？"}, {"type": "subtitle", "time": 9707.429, "timestamp": "02:41:47", "text": "或许是我们的样品？"}, {"type": "subtitle", "time": 9711.91, "timestamp": "02:41:51", "text": "即使是好的那种也只有74%的效果，兄弟。"}, {"type": "subtitle", "time": 9713.99, "timestamp": "02:41:53", "text": "哦，可以。她还是会接受的，我"}, {"type": "subtitle", "time": 9719.27, "timestamp": "02:41:59", "text": "好的。"}]
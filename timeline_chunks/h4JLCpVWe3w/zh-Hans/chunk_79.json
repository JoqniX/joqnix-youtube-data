[{"type": "subtitle", "time": 4740.79, "timestamp": "01:19:00", "text": "我的天啊。哦，不。之后你"}, {"type": "subtitle", "time": 4743.59, "timestamp": "01:19:03", "text": "只需要回去，警察就会"}, {"type": "subtitle", "time": 4745.83, "timestamp": "01:19:05", "text": "也扫描你。我必须隐瞒"}, {"type": "subtitle", "time": 4748.709, "timestamp": "01:19:08", "text": "毒品等等。我的天啊。我需要"}, {"type": "subtitle", "time": 4751.87, "timestamp": "01:19:11", "text": "要么卖掉毒品，要么他就扫描"}, {"type": "subtitle", "time": 4754.669, "timestamp": "01:19:14", "text": "我。这非常专业。我可以是"}, {"type": "subtitle", "time": 4758.229, "timestamp": "01:19:18", "text": "受过培训。好吧，我又回来找他了。"}, {"type": "subtitle", "time": 4768.32, "timestamp": "01:19:28", "text": "乔"}, {"type": "subtitle", "time": 4769.87, "timestamp": "01:19:29", "text": "[音乐]"}, {"type": "subtitle", "time": 4772.39, "timestamp": "01:19:32", "text": "安迪。好的。等待。四处巡视。"}, {"type": "subtitle", "time": 4774.149, "timestamp": "01:19:34", "text": "从……购买两份土壤"}, {"type": "subtitle", "time": 4777.189, "timestamp": "01:19:37", "text": "五金店。哦好的。"}, {"type": "subtitle", "time": 4778.31, "timestamp": "01:19:38", "text": "是的。"}, {"type": "subtitle", "time": 4780.07, "timestamp": "01:19:40", "text": "或许我得去做些外部事务。"}, {"type": "subtitle", "time": 4782.669, "timestamp": "01:19:42", "text": "这是什么？硬件在哪里？"}, {"type": "subtitle", "time": 4786.55, "timestamp": "01:19:46", "text": "店铺？那是赫克托的性爱"}, {"type": "subtitle", "time": 4788.709, "timestamp": "01:19:48", "text": "轮椅？"}, {"type": "subtitle", "time": 4789.63, "timestamp": "01:19:49", "text": "哦"}, {"type": "subtitle", "time": 4798.63, "timestamp": "01:19:58", "text": "赫克托。这款游戏里可以买到布加迪吗？"}]
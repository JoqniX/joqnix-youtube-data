[{"type": "subtitle", "time": 10380.87, "timestamp": "02:53:00", "text": "看到了现在的自己。"}, {"type": "subtitle", "time": 10385.11, "timestamp": "02:53:05", "text": "我的天哪，我被打了。"}, {"type": "subtitle", "time": 10389.59, "timestamp": "02:53:09", "text": "嗯？我该如何获得"}, {"type": "subtitle", "time": 10393.15, "timestamp": "02:53:13", "text": "哦。哦。对不起。"}, {"type": "subtitle", "time": 10401.99, "timestamp": "02:53:21", "text": "他自杀了。"}, {"type": "subtitle", "time": 10404.87, "timestamp": "02:53:24", "text": "这怎么可能？"}, {"type": "subtitle", "time": 10406.83, "timestamp": "02:53:26", "text": "让我去买点东西"}, {"type": "subtitle", "time": 10410.55, "timestamp": "02:53:30", "text": "可口可乐。可口可乐。可口可乐。"}, {"type": "subtitle", "time": 10412.469, "timestamp": "02:53:32", "text": "溪流。"}, {"type": "subtitle", "time": 10414.469, "timestamp": "02:53:34", "text": "显然，如果你审视自己，"}, {"type": "subtitle", "time": 10417.75, "timestamp": "02:53:37", "text": "点击鼠标左键，你会打到自己。"}, {"type": "subtitle", "time": 10423.51, "timestamp": "02:53:43", "text": "我这边没发生这种情况。它不是"}, {"type": "subtitle", "time": 10425.91, "timestamp": "02:53:45", "text": "发生在我身上。"}, {"type": "subtitle", "time": 10428.95, "timestamp": "02:53:48", "text": "嗯？真奇怪。游戏开始时间较早"}, {"type": "subtitle", "time": 10431.11, "timestamp": "02:53:51", "text": "访问权限，因此"}]
[{"type": "subtitle", "time": 7980.669, "timestamp": "02:13:00", "text": "哪些宝可梦会住在这里？"}, {"type": "subtitle", "time": 7984.069, "timestamp": "02:13:04", "text": "我要把这一切都抹去。"}, {"type": "subtitle", "time": 7987.43, "timestamp": "02:13:07", "text": "人口。这个国家。"}, {"type": "subtitle", "time": 7988.83, "timestamp": "02:13:08", "text": "嘿，"}, {"type": "subtitle", "time": 7995.75, "timestamp": "02:13:15", "text": "哦"}, {"type": "subtitle", "time": 8001.83, "timestamp": "02:13:21", "text": "我们从唐娜那里得到了钱。等等，我可以"}, {"type": "subtitle", "time": 8004.03, "timestamp": "02:13:24", "text": "走吧"}, {"type": "subtitle", "time": 8014.39, "timestamp": "02:13:34", "text": "贱人。哦，天哪。全部"}, {"type": "subtitle", "time": 8016.629, "timestamp": "02:13:36", "text": "没错，唐娜。唐娜在买我们的东西。"}, {"type": "subtitle", "time": 8018.95, "timestamp": "02:13:38", "text": "WHO？我当时正试图向……推销东西"}, {"type": "subtitle", "time": 8021.069, "timestamp": "02:13:41", "text": "唐娜，伙计。来"}, {"type": "subtitle", "time": 8024.709, "timestamp": "02:13:44", "text": "在。他逃走是因为你，伊冯。"}, {"type": "subtitle", "time": 8027.03, "timestamp": "02:13:47", "text": "你又死了。哦。哦，等等，等等。"}, {"type": "subtitle", "time": 8029.43, "timestamp": "02:13:49", "text": "等等，等等。我偷的。我偷来的"}, {"type": "subtitle", "time": 8036.069, "timestamp": "02:13:56", "text": "你偷了他的东西？他偷了什么？卡车。"}]
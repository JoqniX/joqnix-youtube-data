[{"type": "subtitle", "time": 12241.83, "timestamp": "03:24:01", "text": "电磁场。怎么样？"}, {"type": "subtitle", "time": 12245.269, "timestamp": "03:24:05", "text": "她在哪儿？哦，她在楼梯上。"}, {"type": "subtitle", "time": 12246.79, "timestamp": "03:24:06", "text": "正好在楼梯顶端，"}, {"type": "subtitle", "time": 12248.469, "timestamp": "03:24:08", "text": "大概。"}, {"type": "subtitle", "time": 12250.229, "timestamp": "03:24:10", "text": "哦，"}, {"type": "subtitle", "time": 12252.63, "timestamp": "03:24:12", "text": "你必须去。哦，等等。呃，我做了。"}, {"type": "subtitle", "time": 12256.15, "timestamp": "03:24:16", "text": "别拿。等等，让我来拿。一"}, {"type": "subtitle", "time": 12266.55, "timestamp": "03:24:26", "text": "好的。知道了。知道了。知道了。知道了。"}, {"type": "subtitle", "time": 12269.269, "timestamp": "03:24:29", "text": "哦，你拿着火炬呢。是啊，是啊，是啊。"}, {"type": "subtitle", "time": 12271.429, "timestamp": "03:24:31", "text": "我当时有这样的想法。"}, {"type": "subtitle", "time": 12274.309, "timestamp": "03:24:34", "text": "好的。好的。当……所以每当你看到"}, {"type": "subtitle", "time": 12283.51, "timestamp": "03:24:43", "text": "每当你看到鬼魂的时候，就……"}, {"type": "subtitle", "time": 12285.349, "timestamp": "03:24:45", "text": "如果你看不到或听不到我的电磁场，"}, {"type": "subtitle", "time": 12287.67, "timestamp": "03:24:47", "text": "只需清洁该区域，呃，就像……"}, {"type": "subtitle", "time": 12290.469, "timestamp": "03:24:50", "text": "它。好的。但就像使用这种灯光一样，"}, {"type": "subtitle", "time": 12292.229, "timestamp": "03:24:52", "text": "正确的？"}]
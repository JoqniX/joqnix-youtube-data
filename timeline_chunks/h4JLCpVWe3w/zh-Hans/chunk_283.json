[{"type": "subtitle", "time": 16985.55, "timestamp": "04:43:05", "text": "她根本不在这里。她消失了。"}, {"type": "subtitle", "time": 16988.91, "timestamp": "04:43:08", "text": "就像去"}, {"type": "subtitle", "time": 17011.11, "timestamp": "04:43:31", "text": "我的天啊。同样的策略。去我的"}, {"type": "subtitle", "time": 17014.868, "timestamp": "04:43:34", "text": "身体回来了，走到那里。不，你"}, {"type": "subtitle", "time": 17017.51, "timestamp": "04:43:37", "text": "你想让我出去吗？不。不。"}, {"type": "subtitle", "time": 17020.15, "timestamp": "04:43:40", "text": "不，不，不。我现在无聊死了。"}, {"type": "subtitle", "time": 17023.27, "timestamp": "04:43:43", "text": "现在。如果我可以出去呢？"}, {"type": "subtitle", "time": 17026.39, "timestamp": "04:43:46", "text": "出来，你这婊子养的。好的。她呃"}, {"type": "subtitle", "time": 17028.708, "timestamp": "04:43:48", "text": "已消失。我的意思是，呃，她会产卵"}, {"type": "subtitle", "time": 17031.27, "timestamp": "04:43:51", "text": "我猜又是从厕所里拿出来的。所以，你"}, {"type": "subtitle", "time": 17034.55, "timestamp": "04:43:54", "text": "你想让我出去玩吗？"}, {"type": "subtitle", "time": 17037.51, "timestamp": "04:43:57", "text": "我真是无聊透了。你动不了"}]
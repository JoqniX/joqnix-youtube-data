[{"type": "subtitle", "time": 6963.75, "timestamp": "01:56:03", "text": "等待。呃，在网上微不足道。我该怎么做？"}, {"type": "subtitle", "time": 6966.149, "timestamp": "01:56:06", "text": "我们一无所有。哦，你去ATM机那边取钱。"}, {"type": "subtitle", "time": 6969.109, "timestamp": "01:56:09", "text": "这里外面"}, {"type": "subtitle", "time": 6971.83, "timestamp": "01:56:11", "text": "并将现金存入银行。"}, {"type": "subtitle", "time": 6973.83, "timestamp": "01:56:13", "text": "将钱存入自动取款机。"}, {"type": "subtitle", "time": 6974.99, "timestamp": "01:56:14", "text": "好的。"}, {"type": "subtitle", "time": 6985.43, "timestamp": "01:56:25", "text": "哦，我也能得100分。这是什么？"}, {"type": "subtitle", "time": 6989.99, "timestamp": "01:56:29", "text": "它？不，银行已关闭。现金并非如此。哦，"}, {"type": "subtitle", "time": 6993.589, "timestamp": "01:56:33", "text": "好的。现在我明白了。好的。好的。只有一个"}, {"type": "subtitle", "time": 6996.229, "timestamp": "01:56:36", "text": "土壤，对吧？或者就像“是啊”。是的。一"}, {"type": "subtitle", "time": 6998.709, "timestamp": "01:56:38", "text": "选择。是的。"}, {"type": "subtitle", "time": 7005.51, "timestamp": "01:56:45", "text": "我当时正在吃饼干。我知道。我听说"}, {"type": "subtitle", "time": 7007.189, "timestamp": "01:56:47", "text": "它。"}, {"type": "subtitle", "time": 7010.229, "timestamp": "01:56:50", "text": "好像只有一种选择。"}, {"type": "subtitle", "time": 7013.83, "timestamp": "01:56:53", "text": "好的。我弄到了土壤。对不起。辣椒。"}, {"type": "subtitle", "time": 7018.07, "timestamp": "01:56:58", "text": "嗨，W先生。我是"}]
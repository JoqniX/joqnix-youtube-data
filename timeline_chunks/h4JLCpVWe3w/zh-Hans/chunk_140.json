[{"type": "subtitle", "time": 8403.59, "timestamp": "02:20:03", "text": "交易。四件160元。"}, {"type": "subtitle", "time": 8408.07, "timestamp": "02:20:08", "text": "我该考虑她的提议吗？嗯，当然。它是"}, {"type": "subtitle", "time": 8413.71, "timestamp": "02:20:13", "text": "每40 80"}, {"type": "subtitle", "time": 8417.91, "timestamp": "02:20:17", "text": "40 可以凑成 142。"}, {"type": "subtitle", "time": 8419.99, "timestamp": "02:20:19", "text": "好了，我回来了。"}, {"type": "subtitle", "time": 8422.55, "timestamp": "02:20:22", "text": "不，我想是的。不，我说那是"}, {"type": "subtitle", "time": 8425.91, "timestamp": "02:20:25", "text": "价格合理。是的。呃，我会把她放进去"}, {"type": "subtitle", "time": 8428.07, "timestamp": "02:20:28", "text": "上午的时间。"}, {"type": "subtitle", "time": 8432.309, "timestamp": "02:20:32", "text": "好的。哦，不。然后，哦，糟糕。"}, {"type": "subtitle", "time": 8434.79, "timestamp": "02:20:34", "text": "为什么？发生了什么？呃，因为我不喜欢"}, {"type": "subtitle", "time": 8437.349, "timestamp": "02:20:37", "text": "我觉得它会长得那么快。不，我有"}, {"type": "subtitle", "time": 8440.469, "timestamp": "02:20:40", "text": "我已经够了。好的。我会说我"}, {"type": "subtitle", "time": 8442.23, "timestamp": "02:20:42", "text": "猜最好的方式就像深夜一样，因为你会"}, {"type": "subtitle", "time": 8446.07, "timestamp": "02:20:46", "text": "获得额外奖励。咖啡奖励就是这个。"}, {"type": "subtitle", "time": 8448.15, "timestamp": "02:20:48", "text": "好的。"}, {"type": "subtitle", "time": 8450.79, "timestamp": "02:20:50", "text": "但这就像管理时间一样。"}, {"type": "subtitle", "time": 8453.349, "timestamp": "02:20:53", "text": "出色地。"}, {"type": "subtitle", "time": 8456.07, "timestamp": "02:20:56", "text": "是的，我知道。这就是我的原因"}]
[{"type": "subtitle", "time": 7502.47, "timestamp": "02:05:02", "text": "是的。一叠是20个。好的。 20. 而我是"}, {"type": "subtitle", "time": 7504.629, "timestamp": "02:05:04", "text": "还要再买一个修剪器。"}, {"type": "subtitle", "time": 7508.109, "timestamp": "02:05:08", "text": "你们。好的。我不会扒窃。"}, {"type": "subtitle", "time": 7511.589, "timestamp": "02:05:11", "text": "他。我需要钱。我该选谁？是的，"}, {"type": "subtitle", "time": 7513.35, "timestamp": "02:05:13", "text": "你继续。你们买个修剪器"}, {"type": "subtitle", "time": 7514.95, "timestamp": "02:05:14", "text": "也为了你们自己。我要走了"}, {"type": "subtitle", "time": 7518.07, "timestamp": "02:05:18", "text": "把这些东西做出来。我可以把我的"}, {"type": "subtitle", "time": 7520.229, "timestamp": "02:05:20", "text": "存货？比如，哦，你可以放进去"}, {"type": "subtitle", "time": 7524.07, "timestamp": "02:05:24", "text": "呃，货架储物架或室外"}, {"type": "subtitle", "time": 7526.79, "timestamp": "02:05:26", "text": "那里有个类似架子的东西。好的。这"}, {"type": "subtitle", "time": 7533.75, "timestamp": "02:05:33", "text": "这里。超级甜的生长。我不需要"}, {"type": "subtitle", "time": 7536.589, "timestamp": "02:05:36", "text": "那。暂且称之为土壤。我不需要"}, {"type": "subtitle", "time": 7541.07, "timestamp": "02:05:41", "text": "那。好的。咱们来修剪一下边角料吧。"}, {"type": "subtitle", "time": 7543.51, "timestamp": "02:05:43", "text": "修剪。伙计们，这看起来不太像很"}, {"type": "subtitle", "time": 7550.39, "timestamp": "02:05:50", "text": "大麻。基本气体。"}]
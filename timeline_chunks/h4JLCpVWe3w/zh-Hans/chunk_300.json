[{"type": "subtitle", "time": 18004.31, "timestamp": "05:00:04", "text": "呃，回你的卡车去看看吧。"}, {"type": "subtitle", "time": 18007.27, "timestamp": "05:00:07", "text": "按照它说的做。请参阅对……的回复"}, {"type": "subtitle", "time": 18012.628, "timestamp": "05:00:12", "text": "它会，它会像它说的那样在那里。"}, {"type": "subtitle", "time": 18018.55, "timestamp": "05:00:18", "text": "看看对什么的回应？哦"}, {"type": "subtitle", "time": 18021.67, "timestamp": "05:00:21", "text": "对孤独的人的回应。"}, {"type": "subtitle", "time": 18039.51, "timestamp": "05:00:39", "text": "为什么这么黑？我的意思是，很明显是这样。"}, {"type": "subtitle", "time": 18041.27, "timestamp": "05:00:41", "text": "一个闹鬼的地方。黑暗将会降临。"}, {"type": "subtitle", "time": 18045.83, "timestamp": "05:00:45", "text": "这到底是怎么回事？什么？罐子在滚动"}, {"type": "subtitle", "time": 18048.07, "timestamp": "05:00:48", "text": "单独。拿起AMF读取器。电磁场"}, {"type": "subtitle", "time": 18050.91, "timestamp": "05:00:50", "text": "读者。拿走"}, {"type": "subtitle", "time": 18055.99, "timestamp": "05:00:55", "text": "出去。任何事物。哦，三个。三。好的。"}, {"type": "subtitle", "time": 18057.59, "timestamp": "05:00:57", "text": "放点盐。放点盐。加盐"}]
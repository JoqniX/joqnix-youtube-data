[{"type": "subtitle", "time": 13931.03, "timestamp": "03:52:11", "text": "等等，乔克。是的。书在哪儿？"}, {"type": "subtitle", "time": 13933.11, "timestamp": "03:52:13", "text": "是的。进去。你会经历一些"}, {"type": "subtitle", "time": 13939.91, "timestamp": "03:52:19", "text": "请告诉我们，是否有五个级别的……"}, {"type": "subtitle", "time": 13942.429, "timestamp": "03:52:22", "text": "电磁脉冲。还有，把手电筒给我。"}, {"type": "subtitle", "time": 13946.07, "timestamp": "03:52:26", "text": "好的。呃，放下。你需要一张沙发，是吗？"}, {"type": "subtitle", "time": 13962.79, "timestamp": "03:52:42", "text": "丹尼尔，我把书放在桌子上了。"}, {"type": "subtitle", "time": 13965.429, "timestamp": "03:52:45", "text": "餐桌。呃，就是这边的桌子。"}, {"type": "subtitle", "time": 13966.99, "timestamp": "03:52:46", "text": "我冷死了，我"}, {"type": "subtitle", "time": 13969.63, "timestamp": "03:52:49", "text": "相信。"}]
[{"type": "subtitle", "time": 12966.229, "timestamp": "03:36:06", "text": "上帝。我的天啊，等等。我想我当时"}, {"type": "subtitle", "time": 12980.19, "timestamp": "03:36:20", "text": "未来。什么？我当时正在跟我说话"}, {"type": "subtitle", "time": 12984.469, "timestamp": "03:36:24", "text": "麦克风。我觉得她看穿我了。"}, {"type": "subtitle", "time": 12986.349, "timestamp": "03:36:26", "text": "哦好的。"}, {"type": "subtitle", "time": 12989.19, "timestamp": "03:36:29", "text": "好的。天哪，我尖叫得那么厉害，以至于我的"}, {"type": "subtitle", "time": 12990.91, "timestamp": "03:36:30", "text": "祖母洞穴探险。什么"}, {"type": "subtitle", "time": 12993.79, "timestamp": "03:36:33", "text": "发生了吗？哦"}, {"type": "subtitle", "time": 12997.67, "timestamp": "03:36:37", "text": "上帝。圣。"}, {"type": "subtitle", "time": 13001.03, "timestamp": "03:36:41", "text": "我会回来的。你好。那么，你为什么不……"}, {"type": "subtitle", "time": 13004.55, "timestamp": "03:36:44", "text": "你在说话吗，兄弟？稍等，按下按钮。"}, {"type": "subtitle", "time": 13008.19, "timestamp": "03:36:48", "text": "等等，我没说话。什么？哦，"}, {"type": "subtitle", "time": 13011.67, "timestamp": "03:36:51", "text": "什么？啊，我把它改成按键通话了。"}, {"type": "subtitle", "time": 13013.67, "timestamp": "03:36:53", "text": "我一直在催促，但你还是……"}, {"type": "subtitle", "time": 13017.19, "timestamp": "03:36:57", "text": "没听到。稍等片刻。"}]
[{"type": "subtitle", "time": 562.67, "timestamp": "00:09:22", "text": "您好，欢迎光临。"}, {"type": "subtitle", "time": 566.31, "timestamp": "00:09:26", "text": "嗯，可卡因农场配种。是的，这是"}, {"type": "subtitle", "time": 568.75, "timestamp": "00:09:28", "text": "我的呃可卡因"}, {"type": "subtitle", "time": 571.829, "timestamp": "00:09:31", "text": "农场。从这里，我能弄到可卡因。"}, {"type": "subtitle", "time": 573.91, "timestamp": "00:09:33", "text": "哦，等等。我忘了。呃，我需要预订"}, {"type": "subtitle", "time": 575.67, "timestamp": "00:09:35", "text": "可卡因。呃，等等，等等，等等。我忘了。"}, {"type": "subtitle", "time": 577.47, "timestamp": "00:09:37", "text": "我忘了。我忘了。我忘了。我忘了。"}, {"type": "subtitle", "time": 581.19, "timestamp": "00:09:41", "text": "忘了。联系方式。呃，消息。让我"}, {"type": "subtitle", "time": 584.03, "timestamp": "00:09:44", "text": "清除所有这些"}, {"type": "subtitle", "time": 587.509, "timestamp": "00:09:47", "text": "伙计们。萨尔瓦德，我需要付他钱。"}, {"type": "subtitle", "time": 595.99, "timestamp": "00:09:55", "text": "哦，好的。我会付钱给你，兄弟。在哪里？"}, {"type": "subtitle", "time": 598.19, "timestamp": "00:09:58", "text": "你？这里，"}]
[{"type": "subtitle", "time": 8700.83, "timestamp": "02:25:00", "text": "好了，杰西，快点，快点。来"}, {"type": "subtitle", "time": 8703.79, "timestamp": "02:25:03", "text": "在。她可以熬夜"}, {"type": "subtitle", "time": 8706.91, "timestamp": "02:25:06", "text": "那里。约翰，停下"}, {"type": "subtitle", "time": 8711.11, "timestamp": "02:25:11", "text": "展开调查。跑步。"}, {"type": "subtitle", "time": 8714.07, "timestamp": "02:25:14", "text": "我要去汽车旅馆。那是宝吗？"}, {"type": "subtitle", "time": 8716.63, "timestamp": "02:25:16", "text": "是的。"}, {"type": "subtitle", "time": 8720.4, "timestamp": "02:25:20", "text": "哦，我拿到水了。坚持，稍等。"}, {"type": "subtitle", "time": 8723.19, "timestamp": "02:25:23", "text": "[音乐]"}, {"type": "subtitle", "time": 8725.51, "timestamp": "02:25:25", "text": "我们完全和平地进行毒品交易。"}, {"type": "subtitle", "time": 8727.23, "timestamp": "02:25:27", "text": "团体。"}, {"type": "subtitle", "time": 8736.469, "timestamp": "02:25:36", "text": "嘿，版主。为什么我不把所有东西都关掉呢？"}, {"type": "subtitle", "time": 8739.429, "timestamp": "02:25:39", "text": "这里灯亮着，你为什么不来？"}, {"type": "subtitle", "time": 8748.389, "timestamp": "02:25:48", "text": "不。我们可以收获吗？哦，不。患病的"}, {"type": "subtitle", "time": 8753.03, "timestamp": "02:25:53", "text": "所以，我们是不是得玩这个游戏？"}, {"type": "subtitle", "time": 8755.27, "timestamp": "02:25:55", "text": "每次都一起吗？哦，不。你可以"}, {"type": "subtitle", "time": 8757.429, "timestamp": "02:25:57", "text": "也可以独自游玩。是的，你可以玩"}, {"type": "subtitle", "time": 8759.59, "timestamp": "02:25:59", "text": "独自的。是的。"}]
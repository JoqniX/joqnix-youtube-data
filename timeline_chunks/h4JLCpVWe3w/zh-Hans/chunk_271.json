[{"type": "subtitle", "time": 16260.149, "timestamp": "04:31:00", "text": "方式？露丝，你知道路吗？操"}, {"type": "subtitle", "time": 16262.83, "timestamp": "04:31:02", "text": "方式。去你的，"}, {"type": "subtitle", "time": 16265.11, "timestamp": "04:31:05", "text": "露丝。她为什么这么迷恋你"}, {"type": "subtitle", "time": 16267.91, "timestamp": "04:31:07", "text": "尸体？你甚至有受到伤害吗？"}, {"type": "subtitle", "time": 16270.55, "timestamp": "04:31:10", "text": "鬼？搞什么鬼？ Ch，"}, {"type": "subtitle", "time": 16273.51, "timestamp": "04:31:13", "text": "为什么她的声音听起来很近？哦，她进来了。"}, {"type": "subtitle", "time": 16279.03, "timestamp": "04:31:19", "text": "哦，她哭是因为你去世了。"}, {"type": "subtitle", "time": 16283.03, "timestamp": "04:31:23", "text": "什么？她要去哪里？她是"}, {"type": "subtitle", "time": 16286.07, "timestamp": "04:31:26", "text": "准备跳起来。她正在爬行。婊子"}, {"type": "subtitle", "time": 16288.95, "timestamp": "04:31:28", "text": "滞后。这是俄亥俄州的鬼魂。哦，她"}, {"type": "subtitle", "time": 16291.99, "timestamp": "04:31:31", "text": "扔了什么东西。搞什么鬼？"}, {"type": "subtitle", "time": 16293.83, "timestamp": "04:31:33", "text": "是的，她扔了东西。这就是这个"}, {"type": "subtitle", "time": 16295.91, "timestamp": "04:31:35", "text": "这是我妈拒绝购买后我的反应"}, {"type": "subtitle", "time": 16298.429, "timestamp": "04:31:38", "text": "对我来说，这很重要。"}, {"type": "subtitle", "time": 16301.83, "timestamp": "04:31:41", "text": "超级市场。妈妈，请给我买东西"}, {"type": "subtitle", "time": 16304.87, "timestamp": "04:31:44", "text": "那该死的宝可梦牙刷。请"}, {"type": "subtitle", "time": 16307.429, "timestamp": "04:31:47", "text": "给我买皮卡丘图案的内裤。患病的"}, {"type": "subtitle", "time": 16309.03, "timestamp": "04:31:49", "text": "穿上它，向我身边的每个人展示。"}, {"type": "subtitle", "time": 16313.11, "timestamp": "04:31:53", "text": "学校。我的天哪。等等，她来过这里吗？"}, {"type": "subtitle", "time": 16316.389, "timestamp": "04:31:56", "text": "不。对。呃，不。她确实来过这里。"}]
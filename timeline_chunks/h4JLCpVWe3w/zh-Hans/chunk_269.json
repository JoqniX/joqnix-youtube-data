[{"type": "subtitle", "time": 16143.03, "timestamp": "04:29:03", "text": "哦，所以不会显示全身。"}, {"type": "subtitle", "time": 16145.11, "timestamp": "04:29:05", "text": "正确的？它会像……一样闪烁"}, {"type": "subtitle", "time": 16146.55, "timestamp": "04:29:06", "text": "是的。是的。它会显示鬼魂的存在。"}, {"type": "subtitle", "time": 16149.429, "timestamp": "04:29:09", "text": "屏幕闪烁。呃，保持这个角度"}, {"type": "subtitle", "time": 16151.51, "timestamp": "04:29:11", "text": "你可以看到我和那艘幽灵船。"}, {"type": "subtitle", "time": 16154.07, "timestamp": "04:29:14", "text": "你好，爱德华。你好吗？是的。"}, {"type": "subtitle", "time": 16156.55, "timestamp": "04:29:16", "text": "你好，爱德华。你好吗？我和乔克"}, {"type": "subtitle", "time": 16158.469, "timestamp": "04:29:18", "text": "正在玩《恐同症》。"}, {"type": "subtitle", "time": 16160.63, "timestamp": "04:29:20", "text": "是的，我们正在玩《恐鬼症》，而且"}, {"type": "subtitle", "time": 16162.99, "timestamp": "04:29:22", "text": "死了。我来这里是为了"}, {"type": "subtitle", "time": 16165.51, "timestamp": "04:29:25", "text": "证人哦，他是来见证一个"}, {"type": "subtitle", "time": 16167.349, "timestamp": "04:29:27", "text": "谋杀。"}, {"type": "subtitle", "time": 16169.51, "timestamp": "04:29:29", "text": "我猜她应该在二楼。"}, {"type": "subtitle", "time": 16172.79, "timestamp": "04:29:32", "text": "是的。是的，她要下来了。是的，"}, {"type": "subtitle", "time": 16175.91, "timestamp": "04:29:35", "text": "她要下来了。"}, {"type": "subtitle", "time": 16189.51, "timestamp": "04:29:49", "text": "她为什么不来？"}, {"type": "subtitle", "time": 16194.229, "timestamp": "04:29:54", "text": "贱人。如果你想让我死，我"}, {"type": "subtitle", "time": 16196.67, "timestamp": "04:29:56", "text": "我可以把我的矿机关掉。不，不，不"}]
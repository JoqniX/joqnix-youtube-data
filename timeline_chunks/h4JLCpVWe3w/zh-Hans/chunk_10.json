[{"type": "subtitle", "time": 601.19, "timestamp": "00:10:01", "text": "正确的？我离得好远。我需要做这件事"}, {"type": "subtitle", "time": 620.23, "timestamp": "00:10:20", "text": "再次。我很少按空格键。"}, {"type": "subtitle", "time": 621.01, "timestamp": "00:10:21", "text": "你没事。"}, {"type": "subtitle", "time": 648.069, "timestamp": "00:10:48", "text": "任何。好的。我将加入"}, {"type": "subtitle", "time": 650.87, "timestamp": "00:10:50", "text": "加入他们并非为了合作。是的，"}, {"type": "subtitle", "time": 653.509, "timestamp": "00:10:53", "text": "我不知道。我，他们挂着，我不挂。"}, {"type": "subtitle", "time": 655.35, "timestamp": "00:10:55", "text": "不知道这算不算合作，但是"}, {"type": "subtitle", "time": 658.11, "timestamp": "00:10:58", "text": "我只是过来凑个热闹。那是"}]
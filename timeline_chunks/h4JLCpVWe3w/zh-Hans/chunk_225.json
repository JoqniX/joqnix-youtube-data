[{"type": "subtitle", "time": 13514.83, "timestamp": "03:45:14", "text": "上帝。我接受"}, {"type": "subtitle", "time": 13537.79, "timestamp": "03:45:37", "text": "去。听着，我会跟着。"}, {"type": "subtitle", "time": 13541.1, "timestamp": "03:45:41", "text": "我。我们开始吧"}, {"type": "subtitle", "time": 13542.83, "timestamp": "03:45:42", "text": "[音乐]"}, {"type": "subtitle", "time": 13548.11, "timestamp": "03:45:48", "text": "去。我的天哪。有点奇怪。"}, {"type": "subtitle", "time": 13550.11, "timestamp": "03:45:50", "text": "活动"}, {"type": "subtitle", "time": 13553.67, "timestamp": "03:45:53", "text": "还记得《捉鬼敢死队》吗？"}]
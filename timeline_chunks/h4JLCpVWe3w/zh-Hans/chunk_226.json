[{"type": "subtitle", "time": 13567.349, "timestamp": "03:46:07", "text": "丹尼尔。丹尼尔。丹尼尔。 Mr. Beast 刚刚"}, {"type": "subtitle", "time": 13568.95, "timestamp": "03:46:08", "text": "与 PewDiePie 交配。你的反应是什么？"}, {"type": "subtitle", "time": 13572.15, "timestamp": "03:46:12", "text": "丹尼尔，你在吗？"}, {"type": "subtitle", "time": 13578.309, "timestamp": "03:46:18", "text": "“哦，”他回答道。他来了。等等，什么？"}, {"type": "subtitle", "time": 13581.59, "timestamp": "03:46:21", "text": "他说：“是的，他参与其中。”"}, {"type": "subtitle", "time": 13584.71, "timestamp": "03:46:24", "text": "什么？丹尼尔，你喜欢艾登·罗斯吗？"}, {"type": "subtitle", "time": 13592.229, "timestamp": "03:46:32", "text": "丹尼尔，最新发布的重要视频。"}, {"type": "subtitle", "time": 13596.07, "timestamp": "03:46:36", "text": "丹尼尔，你喜欢顶部的G吗？"}, {"type": "subtitle", "time": 13599.91, "timestamp": "03:46:39", "text": "顶级G。你呢？"}, {"type": "subtitle", "time": 13603.229, "timestamp": "03:46:43", "text": "你喜欢吸吮吗？"}, {"type": "subtitle", "time": 13606.389, "timestamp": "03:46:46", "text": "迪克？我想应该不是。丹尼尔，新一代的坎耶"}]
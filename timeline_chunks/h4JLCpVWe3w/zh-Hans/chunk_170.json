[{"type": "subtitle", "time": 10200.07, "timestamp": "02:50:00", "text": "我放入了马精液。放马。哦，"}, {"type": "subtitle", "time": 10202.95, "timestamp": "02:50:02", "text": "把马放平。我们怎么才能弄到那些东西？"}, {"type": "subtitle", "time": 10204.91, "timestamp": "02:50:04", "text": "尽管？哦，结束了。"}, {"type": "subtitle", "time": 10208.07, "timestamp": "02:50:08", "text": "这里。在我们家。来，走，走"}, {"type": "subtitle", "time": 10212.07, "timestamp": "02:50:12", "text": "去！去！去。我偷的。它就在那里。"}, {"type": "subtitle", "time": 10214.389, "timestamp": "02:50:14", "text": "什么鬼？来吧，来吧，来吧，来吧"}, {"type": "subtitle", "time": 10216.63, "timestamp": "02:50:16", "text": "回来。坚持，稍等。我正在卖一些东西"}, {"type": "subtitle", "time": 10222.95, "timestamp": "02:50:22", "text": "正确的。得到它。得到它。得到它。得到它"}, {"type": "subtitle", "time": 10225.59, "timestamp": "02:50:25", "text": "从货架上取下。架子。上面的架子。"}, {"type": "subtitle", "time": 10228.71, "timestamp": "02:50:28", "text": "直截了当。我的天哪。"}, {"type": "subtitle", "time": 10231.63, "timestamp": "02:50:31", "text": "不，等等。你是怎么弄到这些东西的？"}, {"type": "subtitle", "time": 10235.59, "timestamp": "02:50:35", "text": "尽管？那是杰西的。"}, {"type": "subtitle", "time": 10239.349, "timestamp": "02:50:39", "text": "我就是偷的。"}, {"type": "subtitle", "time": 10243.75, "timestamp": "02:50:43", "text": "你把那东西放进生的呃呃呃呃里，然后你"}, {"type": "subtitle", "time": 10245.67, "timestamp": "02:50:45", "text": "混合一下。"}, {"type": "subtitle", "time": 10251.91, "timestamp": "02:50:51", "text": "正确的。各位，还有4秒。我们将要"}]
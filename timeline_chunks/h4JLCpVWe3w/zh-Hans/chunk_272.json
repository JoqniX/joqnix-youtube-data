[{"type": "subtitle", "time": 16323.75, "timestamp": "04:32:03", "text": "我仍然喜欢她，她听起来像个"}, {"type": "subtitle", "time": 16326.71, "timestamp": "04:32:06", "text": "口腔医学学士。她来了。她来了。哦，我是"}, {"type": "subtitle", "time": 16330.99, "timestamp": "04:32:10", "text": "即将死去。哦，她又走了。"}, {"type": "subtitle", "time": 16335.75, "timestamp": "04:32:15", "text": "她为什么用两条腿站立？"}, {"type": "subtitle", "time": 16341.91, "timestamp": "04:32:21", "text": "我又哭又笑"}, {"type": "subtitle", "time": 16344.71, "timestamp": "04:32:24", "text": "同时。怎么了？"}, {"type": "subtitle", "time": 16347.03, "timestamp": "04:32:27", "text": "你晚饭吃什么？呃"}, {"type": "subtitle", "time": 16350.469, "timestamp": "04:32:30", "text": "我，呃，今天，嗯，我想我有什么？"}, {"type": "subtitle", "time": 16354.149, "timestamp": "04:32:34", "text": "再次？呃，是印度薄饼，对吧？你知道段落。"}, {"type": "subtitle", "time": 16356.149, "timestamp": "04:32:36", "text": "是的，我知道。我们称之为 parota"}, {"type": "subtitle", "time": 16360.149, "timestamp": "04:32:40", "text": "孟加拉口音。哦，不错。是的，我"}, {"type": "subtitle", "time": 16363.91, "timestamp": "04:32:43", "text": "有。嗯。嗯。呃，我当时就像"}, {"type": "subtitle", "time": 16366.87, "timestamp": "04:32:46", "text": "一些鸡肉块和烤饼。所以我有"}, {"type": "subtitle", "time": 16369.03, "timestamp": "04:32:49", "text": "你知道，就是米饭，可惜我忘了。"}, {"type": "subtitle", "time": 16371.269, "timestamp": "04:32:51", "text": "你需要像平时那样把米饭加热。"}, {"type": "subtitle", "time": 16373.269, "timestamp": "04:32:53", "text": "天。我把它放在冰箱里，然后"}, {"type": "subtitle", "time": 16376.07, "timestamp": "04:32:56", "text": "忘了，呃，简直就像"}, {"type": "subtitle", "time": 16378.95, "timestamp": "04:32:58", "text": "情况很糟糕。"}]
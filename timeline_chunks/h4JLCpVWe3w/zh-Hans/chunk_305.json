[{"type": "subtitle", "time": 18302.628, "timestamp": "05:05:02", "text": "打猎。哦，原来是这样。"}, {"type": "subtitle", "time": 18305.35, "timestamp": "05:05:05", "text": "所有看到的人都点赞了，就是这样。"}, {"type": "subtitle", "time": 18307.59, "timestamp": "05:05:07", "text": "表明你需要隐藏或"}, {"type": "subtitle", "time": 18309.99, "timestamp": "05:05:09", "text": "做好接受OK的准备。我的意思是，你可以"}, {"type": "subtitle", "time": 18313.19, "timestamp": "05:05:13", "text": "听起来像那种嘟嘟声。是的。是的。"}, {"type": "subtitle", "time": 18322.75, "timestamp": "05:05:22", "text": "我的天啊，我又尖叫起来了。我的天啊。"}, {"type": "subtitle", "time": 18325.35, "timestamp": "05:05:25", "text": "记住她的名字里有个“鸡巴”的字眼。只是"}, {"type": "subtitle", "time": 18328.15, "timestamp": "05:05:28", "text": "哈哈，笑一笑吧。别害怕。是的，我"}, {"type": "subtitle", "time": 18329.99, "timestamp": "05:05:29", "text": "迪克。"}, {"type": "subtitle", "time": 18336.23, "timestamp": "05:05:36", "text": "还有，我不……等等，让我看看。让我"}, {"type": "subtitle", "time": 18338.31, "timestamp": "05:05:38", "text": "谷歌。疟原虫的狩猎期有多长？"}, {"type": "subtitle", "time": 18359.55, "timestamp": "05:05:59", "text": "[音乐]"}]
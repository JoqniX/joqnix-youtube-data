[{"type": "subtitle", "time": 6062.149, "timestamp": "01:41:02", "text": "这样做是错误的。他认为人们"}, {"type": "subtitle", "time": 6064.229, "timestamp": "01:41:04", "text": "他们既活着，又死了。他真的"}, {"type": "subtitle", "time": 6070.55, "timestamp": "01:41:10", "text": "在公用电话亭跟纳尔逊叔叔通话。"}, {"type": "subtitle", "time": 6075.75, "timestamp": "01:41:15", "text": "好的。哦，公用电话。我们走吧。妈的。"}, {"type": "subtitle", "time": 6077.51, "timestamp": "01:41:17", "text": "这并非理想情况。废话，一点没错。有"}, {"type": "subtitle", "time": 6081.07, "timestamp": "01:41:21", "text": "城里一个势力强大的卡特尔。奔驰的"}, {"type": "subtitle", "time": 6083.75, "timestamp": "01:41:23", "text": "家庭。我猜他们会"}, {"type": "subtitle", "time": 6085.669, "timestamp": "01:41:25", "text": "最终可能会成为一个问题。他们会发现"}, {"type": "subtitle", "time": 6087.43, "timestamp": "01:41:27", "text": "赶紧出去。看来你要"}, {"type": "subtitle", "time": 6090.149, "timestamp": "01:41:30", "text": "需要一个比较安静的住处"}, {"type": "subtitle", "time": 6091.83, "timestamp": "01:41:31", "text": "一阵子。前往莫尔特尔，"}, {"type": "subtitle", "time": 6096.55, "timestamp": "01:41:36", "text": "问问他们。这就是凡人。死亡。"}, {"type": "subtitle", "time": 6099.03, "timestamp": "01:41:39", "text": "我会回来的。"}, {"type": "subtitle", "time": 6100.87, "timestamp": "01:41:40", "text": "你在哪里？房间。之后，你将"}, {"type": "subtitle", "time": 6102.149, "timestamp": "01:41:42", "text": "需要一些东西。哦，我们得付钱。"}, {"type": "subtitle", "time": 6105.03, "timestamp": "01:41:45", "text": "电话。过来。好的。我们必须去"}, {"type": "subtitle", "time": 6108.47, "timestamp": "01:41:48", "text": "呃，去汽车旅馆。去汽车旅馆。"}, {"type": "subtitle", "time": 6110.709, "timestamp": "01:41:50", "text": "这是一家汽车旅馆。"}, {"type": "subtitle", "time": 6112.87, "timestamp": "01:41:52", "text": "汽车旅馆。好的，我们直走吧。是的。"}]
[{"type": "subtitle", "time": 17040.55, "timestamp": "04:44:00", "text": "不过，就在那个房间附近。我不"}, {"type": "subtitle", "time": 17044.07, "timestamp": "04:44:04", "text": "我觉得我可以。她会听到的。"}, {"type": "subtitle", "time": 17046.35, "timestamp": "04:44:06", "text": "等等，难道没有办法……"}, {"type": "subtitle", "time": 17051.708, "timestamp": "04:44:11", "text": "与……一起走，哦，等等。哦，是的。我是"}, {"type": "subtitle", "time": 17053.47, "timestamp": "04:44:13", "text": "跳跃。"}, {"type": "subtitle", "time": 17057.19, "timestamp": "04:44:17", "text": "去你的。鬼。去你的。杀了我，"}, {"type": "subtitle", "time": 17059.19, "timestamp": "04:44:19", "text": "混蛋。贱人。鬼。我看不见"}, {"type": "subtitle", "time": 17063.51, "timestamp": "04:44:23", "text": "你，但来找我吧。来啊，贱人。"}, {"type": "subtitle", "time": 17078.07, "timestamp": "04:44:38", "text": "没有什么。我听到开门的声音。门"}, {"type": "subtitle", "time": 17085.27, "timestamp": "04:44:45", "text": "声音。嗯？你确定吗？因为我"}, {"type": "subtitle", "time": 17087.91, "timestamp": "04:44:47", "text": "什么都看不见。"}, {"type": "subtitle", "time": 17091.03, "timestamp": "04:44:51", "text": "她一声不吭。"}, {"type": "subtitle", "time": 17094.15, "timestamp": "04:44:54", "text": "没有什么。为什么会有这么大的延误？不，"}, {"type": "subtitle", "time": 17096.91, "timestamp": "04:44:56", "text": "延迟的意思就像"}, {"type": "subtitle", "time": 17099.27, "timestamp": "04:44:59", "text": "差距。等等，我觉得她变了。"}]
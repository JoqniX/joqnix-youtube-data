[{"type": "subtitle", "time": 7021.27, "timestamp": "01:57:01", "text": "呃，我不想参与这种肮脏的事情。"}, {"type": "subtitle", "time": 7024.229, "timestamp": "01:57:04", "text": "商业。我必须去选择我的梦想"}, {"type": "subtitle", "time": 7027.51, "timestamp": "01:57:07", "text": "工作。做个垃圾。你不会离开"}, {"type": "subtitle", "time": 7029.91, "timestamp": "01:57:09", "text": "我，父亲。"}, {"type": "subtitle", "time": 7033.99, "timestamp": "01:57:13", "text": "不。另外，你应该买个滑板。"}, {"type": "subtitle", "time": 7037.91, "timestamp": "01:57:17", "text": "哦，滑板在哪儿？一旦你呃制作了一个"}, {"type": "subtitle", "time": 7041.99, "timestamp": "01:57:21", "text": "很多钱。这边。这边。"}, {"type": "subtitle", "time": 7043.91, "timestamp": "01:57:23", "text": "这边。你是什​​么意思？在哪里？"}, {"type": "subtitle", "time": 7046.83, "timestamp": "01:57:26", "text": "你？呃，在前面"}, {"type": "subtitle", "time": 7050.87, "timestamp": "01:57:30", "text": "呃，街机游戏厅。在游戏厅前面。呃"}, {"type": "subtitle", "time": 7054.149, "timestamp": "01:57:34", "text": "前面，就在“是”旁边。是的。"}, {"type": "subtitle", "time": 7060.47, "timestamp": "01:57:40", "text": "我以为那是一把枪"}, {"type": "subtitle", "time": 7063.43, "timestamp": "01:57:43", "text": "表情。什么？哦，那是垃圾。"}, {"type": "subtitle", "time": 7068.109, "timestamp": "01:57:48", "text": "好的。滑板。嗯。是的。只是"}, {"type": "subtitle", "time": 7071.109, "timestamp": "01:57:51", "text": "1500。顺便说一句，金色的更好。"}, {"type": "subtitle", "time": 7073.589, "timestamp": "01:57:53", "text": "是的。更快获得黄金。相当"}, {"type": "subtitle", "time": 7075.109, "timestamp": "01:57:55", "text": "在这里赚钱很容易，所以"}, {"type": "subtitle", "time": 7077.589, "timestamp": "01:57:57", "text": "应该没问题。是的。是的。是的。 ID"}]
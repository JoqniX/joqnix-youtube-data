[{"type": "subtitle", "time": 4921.669, "timestamp": "01:22:01", "text": "正确的。"}, {"type": "subtitle", "time": 4923.99, "timestamp": "01:22:03", "text": "谁会在乎警察呢？甚至"}, {"type": "subtitle", "time": 4925.99, "timestamp": "01:22:05", "text": "虽然他们可能是终结者，但他们"}, {"type": "subtitle", "time": 4928.229, "timestamp": "01:22:08", "text": "别他妈的被撞死了"}, {"type": "subtitle", "time": 4952.229, "timestamp": "01:22:32", "text": "感觉有点卡顿。等等，哪里有……"}, {"type": "subtitle", "time": 4954.35, "timestamp": "01:22:34", "text": "又是汽车旅馆？"}, {"type": "subtitle", "time": 4957.669, "timestamp": "01:22:37", "text": "呃，就在五金店旁边那家店的后面"}, {"type": "subtitle", "time": 4959.75, "timestamp": "01:22:39", "text": "医生。"}, {"type": "subtitle", "time": 4960.95, "timestamp": "01:22:40", "text": "如果你一直直接从"}, {"type": "subtitle", "time": 4963.35, "timestamp": "01:22:43", "text": "医生，你会找到的。哦，我的车"}, {"type": "subtitle", "time": 4964.59, "timestamp": "01:22:44", "text": "只是"}, {"type": "subtitle", "time": 4966.51, "timestamp": "01:22:46", "text": "翻转。哦，"}, {"type": "subtitle", "time": 4975.91, "timestamp": "01:22:55", "text": "哦，不。哦，他在那里。他在那里。"}, {"type": "subtitle", "time": 4979.27, "timestamp": "01:22:59", "text": "谢天谢地他在那里。你能吗？我不能。"}]
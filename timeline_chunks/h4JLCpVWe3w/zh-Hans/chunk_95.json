[{"type": "subtitle", "time": 5700.07, "timestamp": "01:35:00", "text": "他以前就这么做过。他知道。"}, {"type": "subtitle", "time": 5704.229, "timestamp": "01:35:04", "text": "好了，各位。我们不得不放弃。哦，不。"}, {"type": "subtitle", "time": 5707.189, "timestamp": "01:35:07", "text": "妈的。为什么乔会……"}, {"type": "subtitle", "time": 5710.91, "timestamp": "01:35:10", "text": "不再。不，他做坏事。"}, {"type": "subtitle", "time": 5718.39, "timestamp": "01:35:18", "text": "乔克。好的，我们这就……"}, {"type": "subtitle", "time": 5721.39, "timestamp": "01:35:21", "text": "别理会那个。对不起，"}, {"type": "subtitle", "time": 5724.709, "timestamp": "01:35:24", "text": "女士。你好，乔伊斯。活。你不能"}, {"type": "subtitle", "time": 5727.75, "timestamp": "01:35:27", "text": "给任何人免费样品。这是什么？"}, {"type": "subtitle", "time": 5731.83, "timestamp": "01:35:31", "text": "我被打败了。不。哦，"}, {"type": "subtitle", "time": 5733.189, "timestamp": "01:35:33", "text": "我听说你遇到了一些麻烦，但是"}, {"type": "subtitle", "time": 5735.27, "timestamp": "01:35:35", "text": "这不是谈话，或者随便什么都行。嘿，"}, {"type": "subtitle", "time": 5737.79, "timestamp": "01:35:37", "text": "女士。我可以吗？我可以给你吗？不，过来。"}, {"type": "subtitle", "time": 5741.59, "timestamp": "01:35:41", "text": "后退。她刚进去。回来吧。哦，"}, {"type": "subtitle", "time": 5744.149, "timestamp": "01:35:44", "text": "伙计们，那儿有自助洗衣店。"}, {"type": "subtitle", "time": 5752.31, "timestamp": "01:35:52", "text": "等等，这是什么？理发店。嘿，"}, {"type": "subtitle", "time": 5754.669, "timestamp": "01:35:54", "text": "理发师。你是"}, {"type": "subtitle", "time": 5757.51, "timestamp": "01:35:57", "text": "理发师？我不能，我不能给任何人"}, {"type": "subtitle", "time": 5759.91, "timestamp": "01:35:59", "text": "样品。"}]
[{"type": "subtitle", "time": 15960.229, "timestamp": "04:26:00", "text": "用手电筒。你有"}, {"type": "subtitle", "time": 15962.51, "timestamp": "04:26:02", "text": "手电筒。"}, {"type": "subtitle", "time": 15965.429, "timestamp": "04:26:05", "text": "哦。哦，我确实有一个。"}, {"type": "subtitle", "time": 15970.91, "timestamp": "04:26:10", "text": "好的。等等。"}, {"type": "subtitle", "time": 15974.95, "timestamp": "04:26:14", "text": "所以，帮我个忙吧。是的。不，你"}, {"type": "subtitle", "time": 15976.469, "timestamp": "04:26:16", "text": "我可以在这里等。你可以看到鬼魂"}, {"type": "subtitle", "time": 15979.349, "timestamp": "04:26:19", "text": "朝我袭来。所以，等等。所以，你是"}, {"type": "subtitle", "time": 15981.11, "timestamp": "04:26:21", "text": "活。"}, {"type": "subtitle", "time": 15984.07, "timestamp": "04:26:24", "text": "是的，我还活着。哦，她来了。哦，"}, {"type": "subtitle", "time": 15985.389, "timestamp": "04:26:25", "text": "她是"}, {"type": "subtitle", "time": 15990.309, "timestamp": "04:26:30", "text": "未来。我的天啊。她在哭。"}, {"type": "subtitle", "time": 15997.51, "timestamp": "04:26:37", "text": "去卡车那里看看狩猎活动是否进行。"}, {"type": "subtitle", "time": 16006.55, "timestamp": "04:26:46", "text": "正确的。 10 分中的 10 分将会下降。"}, {"type": "subtitle", "time": 16014.87, "timestamp": "04:26:54", "text": "呃，我怎么才能知道狩猎地点呢？"}, {"type": "subtitle", "time": 16016.87, "timestamp": "04:26:56", "text": "总活动量。用那个。使用"}]
[{"type": "subtitle", "time": 11886.55, "timestamp": "03:18:06", "text": "地方。他没说是太空猴子。"}, {"type": "subtitle", "time": 11889.349, "timestamp": "03:18:09", "text": "他说的是地下室。是的。是的。"}, {"type": "subtitle", "time": 11891.67, "timestamp": "03:18:11", "text": "地下室。我说的是地下室。是的。"}, {"type": "subtitle", "time": 11899.99, "timestamp": "03:18:19", "text": "哦，索菲，你在吗？真是个白痴。"}, {"type": "subtitle", "time": 11908.55, "timestamp": "03:18:28", "text": "苏菲，你在吗？苏菲，是你吗？"}, {"type": "subtitle", "time": 11911.75, "timestamp": "03:18:31", "text": "这里？你在这里？"}, {"type": "subtitle", "time": 11914.87, "timestamp": "03:18:34", "text": "这他妈是什么玩意儿？苏菲，是你吗？"}, {"type": "subtitle", "time": 11918.71, "timestamp": "03:18:38", "text": "这里？我把你的锤子扔了。"}, {"type": "subtitle", "time": 11923.11, "timestamp": "03:18:43", "text": "苏菲，我这里堆满了垃圾。"}, {"type": "subtitle", "time": 11927.91, "timestamp": "03:18:47", "text": "苏菲，你在里面吗？苏菲。"}, {"type": "subtitle", "time": 11934.309, "timestamp": "03:18:54", "text": "苏菲，我要去……我要去卖……"}, {"type": "subtitle", "time": 11936.03, "timestamp": "03:18:56", "text": "将您的物品存放于仓库"}]
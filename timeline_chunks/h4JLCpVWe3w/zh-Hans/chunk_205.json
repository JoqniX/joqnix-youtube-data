[{"type": "subtitle", "time": 12305.51, "timestamp": "03:25:05", "text": "是的。你好，凯拉。为什么星星是"}, {"type": "subtitle", "time": 12308.229, "timestamp": "03:25:08", "text": "过境吗？哦，那不是星星。它是"}, {"type": "subtitle", "time": 12317.51, "timestamp": "03:25:17", "text": "婊子。"}, {"type": "subtitle", "time": 12321.19, "timestamp": "03:25:21", "text": "苏菲，我找到你的棋子了。"}, {"type": "subtitle", "time": 12330.71, "timestamp": "03:25:30", "text": "对了，你觉得热吗？我单身。"}, {"type": "subtitle", "time": 12333.429, "timestamp": "03:25:33", "text": "喜欢与人交往。你喜欢与人交往吗？"}, {"type": "subtitle", "time": 12336.07, "timestamp": "03:25:36", "text": "哦，那是什么？尖叫。"}, {"type": "subtitle", "time": 12338.79, "timestamp": "03:25:38", "text": "哦，她打开了灯。希拉"}, {"type": "subtitle", "time": 12341.83, "timestamp": "03:25:41", "text": "打开了灯。冷冻。嘿，"}, {"type": "subtitle", "time": 12345.429, "timestamp": "03:25:45", "text": "走吧，苏菲。我知道。我知道。"}, {"type": "subtitle", "time": 12346.4, "timestamp": "03:25:46", "text": "我"}, {"type": "subtitle", "time": 12359.59, "timestamp": "03:25:59", "text": "嘿，索菲，我们就知道我们手里有宝贝。"}]
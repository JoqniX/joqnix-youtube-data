[{"type": "subtitle", "time": 14940.79, "timestamp": "04:09:00", "text": "好的，去那里打开几盏灯。"}, {"type": "subtitle", "time": 14943.429, "timestamp": "04:09:03", "text": "这样你就能知道他要来了。"}, {"type": "subtitle", "time": 14946.87, "timestamp": "04:09:06", "text": "好了，别再用游戏里的麦克风了。好的。"}, {"type": "subtitle", "time": 14948.95, "timestamp": "04:09:08", "text": "不，不，是走廊的灯。走廊的灯。"}, {"type": "subtitle", "time": 14952.71, "timestamp": "04:09:12", "text": "全线。走到前面，就在那个位置。"}, {"type": "subtitle", "time": 14955.67, "timestamp": "04:09:15", "text": "你要走了。那里一片漆黑。"}, {"type": "subtitle", "time": 14957.51, "timestamp": "04:09:17", "text": "停止使用游戏内麦克风并关闭"}, {"type": "subtitle", "time": 14961.03, "timestamp": "04:09:21", "text": "灯亮了。是的。是的。是的。是的。现在走"}, {"type": "subtitle", "time": 14962.469, "timestamp": "04:09:22", "text": "在大厅中央，他喊着他的名字。"}, {"type": "subtitle", "time": 14964.389, "timestamp": "04:09:24", "text": "姓名。如果他来了，主厅"}, {"type": "subtitle", "time": 14967.03, "timestamp": "04:09:27", "text": "灯光会闪烁，并且正好持续一段时间。"}, {"type": "subtitle", "time": 14979.03, "timestamp": "04:09:39", "text": "更近了。房间。露丝。出来。出来。"}, {"type": "subtitle", "time": 14981.11, "timestamp": "04:09:41", "text": "Ruth Everly 念出他的全名。"}, {"type": "subtitle", "time": 14985.07, "timestamp": "04:09:45", "text": "呃，露丝·埃弗利，请出来一下。可以"}, {"type": "subtitle", "time": 14987.229, "timestamp": "04:09:47", "text": "你带着"}, {"type": "subtitle", "time": 14994.55, "timestamp": "04:09:54", "text": "我意识到我产生了不良影响。"}]
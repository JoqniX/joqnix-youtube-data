[{"type": "subtitle", "time": 15.589, "timestamp": "00:00:15", "text": "你好。我们正在直播吗？是的，我们是。欢迎来到"}, {"type": "subtitle", "time": 18.91, "timestamp": "00:00:18", "text": "第二部分 白天的流"}, {"type": "subtitle", "time": 21.51, "timestamp": "00:00:21", "text": "33，夜溪。嗯，我会的"}, {"type": "subtitle", "time": 24.75, "timestamp": "00:00:24", "text": "早睡。我希望如此。我祈祷"}, {"type": "subtitle", "time": 28.15, "timestamp": "00:00:28", "text": "所以。此外，我们一直在努力做到这一点。"}, {"type": "subtitle", "time": 30.83, "timestamp": "00:00:30", "text": "这款游戏取得了很大进展。真是太"}, {"type": "subtitle", "time": 36.03, "timestamp": "00:00:36", "text": "既有趣又令人上瘾"}, {"type": "subtitle", "time": 38.19, "timestamp": "00:00:38", "text": "出色地。"}, {"type": "subtitle", "time": 41.869, "timestamp": "00:00:41", "text": "是的，它确实会上瘾。"}, {"type": "subtitle", "time": 45.63, "timestamp": "00:00:45", "text": "乐趣。而且很好"}, {"type": "subtitle", "time": 49.11, "timestamp": "00:00:49", "text": "出色地。问题是我现在太困了。"}, {"type": "subtitle", "time": 53.029, "timestamp": "00:00:53", "text": "现在。喝醉了睡着了。我的身体感觉"}, {"type": "subtitle", "time": 55.709, "timestamp": "00:00:55", "text": "疲劳的。我感觉我随时都会晕倒。"}, {"type": "subtitle", "time": 58.31, "timestamp": "00:00:58", "text": "片刻。但我的朋友们也在玩"}]
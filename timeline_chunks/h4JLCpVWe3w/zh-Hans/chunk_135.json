[{"type": "subtitle", "time": 8100.709, "timestamp": "02:15:00", "text": "这里。有那么一根漂亮的鸡巴吗？"}, {"type": "subtitle", "time": 8103.99, "timestamp": "02:15:03", "text": "你在这里画画吗？"}, {"type": "subtitle", "time": 8105.91, "timestamp": "02:15:05", "text": "好吧，我们要去……我们是不是应该……"}, {"type": "subtitle", "time": 8111.91, "timestamp": "02:15:11", "text": "或者，我希望你能进去看看游戏厅。"}, {"type": "subtitle", "time": 8114.229, "timestamp": "02:15:14", "text": "放点什么出来玩。"}, {"type": "subtitle", "time": 8116.709, "timestamp": "02:15:16", "text": "哦，对了，你可以在赌场玩。你"}, {"type": "subtitle", "time": 8119.43, "timestamp": "02:15:19", "text": "可以在赌场玩。"}, {"type": "subtitle", "time": 8123.43, "timestamp": "02:15:23", "text": "当然，你知道你是在赌博。"}, {"type": "subtitle", "time": 8125.75, "timestamp": "02:15:25", "text": "伙计们，我们需要清理水坝。"}, {"type": "subtitle", "time": 8129.27, "timestamp": "02:15:29", "text": "操他妈的房子，兄弟。快点。"}, {"type": "subtitle", "time": 8135.189, "timestamp": "02:15:35", "text": "几天。"}, {"type": "subtitle", "time": 8139.229, "timestamp": "02:15:39", "text": "哇。这人是谁干的？这是你吗？"}, {"type": "subtitle", "time": 8143.27, "timestamp": "02:15:43", "text": "不，我连那个都没有。"}, {"type": "subtitle", "time": 8145.91, "timestamp": "02:15:45", "text": "你确定吗？你的笑并不能改变“不”的事实。"}, {"type": "subtitle", "time": 8147.99, "timestamp": "02:15:47", "text": "我不知道。不，其实我有"}, {"type": "subtitle", "time": 8151.589, "timestamp": "02:15:51", "text": "我没做过 我做过 我不做过。"}, {"type": "subtitle", "time": 8159.109, "timestamp": "02:15:59", "text": "垃圾桶在哪里？我刚做完"}]
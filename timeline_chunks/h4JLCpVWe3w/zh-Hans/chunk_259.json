[{"type": "subtitle", "time": 15546.55, "timestamp": "04:19:06", "text": "不要打开太多灯。好的。"}, {"type": "subtitle", "time": 15548.71, "timestamp": "04:19:08", "text": "让我看看。无电磁场读数，无"}, {"type": "subtitle", "time": 15551.429, "timestamp": "04:19:11", "text": "没有什么。哦，因为我们两个在这里，我"}, {"type": "subtitle", "time": 15553.269, "timestamp": "04:19:13", "text": "思考。"}, {"type": "subtitle", "time": 15561.07, "timestamp": "04:19:21", "text": "这里。那里有什么东西吗？"}, {"type": "subtitle", "time": 15563.269, "timestamp": "04:19:23", "text": "车库？不要打开太多灯。"}, {"type": "subtitle", "time": 15565.269, "timestamp": "04:19:25", "text": "乔。记住？好的，我这就关掉。"}, {"type": "subtitle", "time": 15568.389, "timestamp": "04:19:28", "text": "我打开的灯。是的。是的。"}, {"type": "subtitle", "time": 15570.87, "timestamp": "04:19:30", "text": "先关掉一个，然后再打开另一个，就像这样"}, {"type": "subtitle", "time": 15576.229, "timestamp": "04:19:36", "text": "我们只需要一张该死的照片。记住"}, {"type": "subtitle", "time": 15580.63, "timestamp": "04:19:40", "text": "那。是的。没有“哦，你在喂食”这种说法"}, {"type": "subtitle", "time": 15582.83, "timestamp": "04:19:42", "text": "二。"}, {"type": "subtitle", "time": 15591.189, "timestamp": "04:19:51", "text": "哦，那是因为我上去了。哦好的。"}, {"type": "subtitle", "time": 15593.269, "timestamp": "04:19:53", "text": "你上去了。不，EMF读数是"}, {"type": "subtitle", "time": 15595.67, "timestamp": "04:19:55", "text": "我所在的地方。不，不，不。就像你曾经那样"}, {"type": "subtitle", "time": 15597.269, "timestamp": "04:19:57", "text": "独自一人在地下室。呃，这是"}, {"type": "subtitle", "time": 15599.429, "timestamp": "04:19:59", "text": "地面塌陷，对吧？是的。或许像"}]
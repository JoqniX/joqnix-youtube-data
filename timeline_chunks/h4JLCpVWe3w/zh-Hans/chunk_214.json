[{"type": "subtitle", "time": 12842.67, "timestamp": "03:34:02", "text": "[音乐]"}, {"type": "subtitle", "time": 12846.229, "timestamp": "03:34:06", "text": "上帝。我知道。我知道。我认识那个鬼魂。"}, {"type": "subtitle", "time": 12858.95, "timestamp": "03:34:18", "text": "上帝。哦，这是哪里？哦，为什么会这样？"}, {"type": "subtitle", "time": 12860.87, "timestamp": "03:34:20", "text": "必须发生吗？我为什么躲在……"}, {"type": "subtitle", "time": 12862.349, "timestamp": "03:34:22", "text": "角落"}, {"type": "subtitle", "time": 12865.19, "timestamp": "03:34:25", "text": "我的队友们都在那里。"}, {"type": "subtitle", "time": 12868.229, "timestamp": "03:34:28", "text": "努力奋斗，尽力而为"}, {"type": "subtitle", "time": 12871.07, "timestamp": "03:34:31", "text": "有人在吗？我当时就想，“哦，我的天哪！”"}, {"type": "subtitle", "time": 12874.07, "timestamp": "03:34:34", "text": "天哪，我真的配得上这个鬼魂吗？"}, {"type": "subtitle", "time": 12888.83, "timestamp": "03:34:48", "text": "一，"}, {"type": "subtitle", "time": 12896.15, "timestamp": "03:34:56", "text": "去。回到房间。你愿意吗？"}]
[{"type": "subtitle", "time": 3181.75, "timestamp": "00:53:01", "text": "它只会把声音静音。是的，它会"}, {"type": "subtitle", "time": 3183.829, "timestamp": "00:53:03", "text": "让墙壁静音。你不会做的事"}, {"type": "subtitle", "time": 3213.109, "timestamp": "00:53:33", "text": "你好。是的。你好。"}, {"type": "subtitle", "time": 3216.309, "timestamp": "00:53:36", "text": "我忘了。我想起来了。呃，什么？"}, {"type": "subtitle", "time": 3219.27, "timestamp": "00:53:39", "text": "就像重置一切一样，对吧？所以，呃……"}, {"type": "subtitle", "time": 3222.67, "timestamp": "00:53:42", "text": "我的声音设备的输出设备是"}, {"type": "subtitle", "time": 3227.75, "timestamp": "00:53:47", "text": "不是耳机。好的。哦，"}, {"type": "subtitle", "time": 3229.589, "timestamp": "00:53:49", "text": "我直到尝试的时候才意识到这一点"}, {"type": "subtitle", "time": 3231.109, "timestamp": "00:53:51", "text": "播放视频，但什么也没给我。"}, {"type": "subtitle", "time": 3237.109, "timestamp": "00:53:57", "text": "哦，对了，它也修复了我的 OBS。是的。"}]
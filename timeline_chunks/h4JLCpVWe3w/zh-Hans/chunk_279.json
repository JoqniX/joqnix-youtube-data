[{"type": "subtitle", "time": 16741.39, "timestamp": "04:39:01", "text": "面包车。"}, {"type": "subtitle", "time": 16743.51, "timestamp": "04:39:03", "text": "好的。顺便说一句，如果你死了，你"}, {"type": "subtitle", "time": 16744.789, "timestamp": "04:39:04", "text": "可以穿墙。你没有"}, {"type": "subtitle", "time": 16747.269, "timestamp": "04:39:07", "text": "需要开门。"}, {"type": "subtitle", "time": 16749.029, "timestamp": "04:39:09", "text": "哦好的。"}, {"type": "subtitle", "time": 16751.109, "timestamp": "04:39:11", "text": "哦，我无法改变你无法改变"}, {"type": "subtitle", "time": 16752.39, "timestamp": "04:39:12", "text": "地图。你不能碰任何东西"}, {"type": "subtitle", "time": 16755.83, "timestamp": "04:39:15", "text": "因为你会死。哦，她朝我走过来。"}, {"type": "subtitle", "time": 16764.07, "timestamp": "04:39:24", "text": "对了，现在我还要告诉你一件事。"}, {"type": "subtitle", "time": 16766.23, "timestamp": "04:39:26", "text": "呃，去她扔球的那个盘子那里。"}, {"type": "subtitle", "time": 16770.629, "timestamp": "04:39:30", "text": "盘子。按 E 键选择盘子。"}, {"type": "subtitle", "time": 16773.75, "timestamp": "04:39:33", "text": "呃，盘子。她把什么东西扔到哪里去了？"}, {"type": "subtitle", "time": 16775.75, "timestamp": "04:39:35", "text": "盘子？"}, {"type": "subtitle", "time": 16778.948, "timestamp": "04:39:38", "text": "哦，明白了。吃掉它。我拿到盘子了。"}, {"type": "subtitle", "time": 16781.07, "timestamp": "04:39:41", "text": "来"}, {"type": "subtitle", "time": 16784.708, "timestamp": "04:39:44", "text": "把它扔到我腿上，这样我就可以看到了。"}, {"type": "subtitle", "time": 16786.47, "timestamp": "04:39:46", "text": "盘子。所以那时候我们正在做……"}, {"type": "subtitle", "time": 16790.27, "timestamp": "04:39:50", "text": "电锯、锤子和集市。"}, {"type": "subtitle", "time": 16794.27, "timestamp": "04:39:54", "text": "哦，原来你们一直在做这件事？哦，我的"}, {"type": "subtitle", "time": 16797.19, "timestamp": "04:39:57", "text": "上帝。感觉就像我真的能看到……"}]
[{"type": "subtitle", "time": 13448.229, "timestamp": "03:44:08", "text": "热的。我觉得我需要多喝点水。没有把握"}, {"type": "subtitle", "time": 13475.189, "timestamp": "03:44:35", "text": "好了，我们到了。看看"}, {"type": "subtitle", "time": 13476.95, "timestamp": "03:44:36", "text": "准备好设备并进行相应准备。"}, {"type": "subtitle", "time": 13484.63, "timestamp": "03:44:44", "text": "丹尼尔·史蒂文斯在此。好的，去拿一个"}, {"type": "subtitle", "time": 13488.91, "timestamp": "03:44:48", "text": "仔细看看。在它追逐的时候检查一下"}, {"type": "subtitle", "time": 13491.269, "timestamp": "03:44:51", "text": "某人。我没有多少棍子。"}]
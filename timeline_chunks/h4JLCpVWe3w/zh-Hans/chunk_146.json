[{"type": "subtitle", "time": 8761.51, "timestamp": "02:26:01", "text": "因为乔说你们必须一起玩。我"}, {"type": "subtitle", "time": 8767.27, "timestamp": "02:26:07", "text": "哦，不。我当时说的是，我觉得……"}, {"type": "subtitle", "time": 8770.07, "timestamp": "02:26:10", "text": "哦，不。我不认为那像"}, {"type": "subtitle", "time": 8773.91, "timestamp": "02:26:13", "text": "这款游戏我玩了将近 60 个小时。"}, {"type": "subtitle", "time": 8776.71, "timestamp": "02:26:16", "text": "什么？你怎么会花60个小时在这上面？"}, {"type": "subtitle", "time": 8778.87, "timestamp": "02:26:18", "text": "游戏？好的。"}, {"type": "subtitle", "time": 8781.309, "timestamp": "02:26:21", "text": "嗯，我一直"}, {"type": "subtitle", "time": 8784.469, "timestamp": "02:26:24", "text": "打电话时声音嘶哑。"}, {"type": "subtitle", "time": 8788.03, "timestamp": "02:26:28", "text": "我们性生活很糟糕。叔叔"}, {"type": "subtitle", "time": 8790.75, "timestamp": "02:26:30", "text": "纳尔逊，这家伙是"}, {"type": "subtitle", "time": 8793.429, "timestamp": "02:26:33", "text": "出现故障。他的头是他的头是"}]
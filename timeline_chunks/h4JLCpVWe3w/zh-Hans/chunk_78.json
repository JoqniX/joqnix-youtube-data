[{"type": "subtitle", "time": 4688.669, "timestamp": "01:18:08", "text": "安迪，道格，我应该得到"}, {"type": "subtitle", "time": 4690.95, "timestamp": "01:18:10", "text": "切斯利？解锁新内容的最快方法"}, {"type": "subtitle", "time": 4692.47, "timestamp": "01:18:12", "text": "顾客会向他们提供免费样品。"}, {"type": "subtitle", "time": 4695.27, "timestamp": "01:18:15", "text": "朋友，不是现有客户。"}, {"type": "subtitle", "time": 4697.59, "timestamp": "01:18:17", "text": "好的。所以，我必须免费给道格"}, {"type": "subtitle", "time": 4701.03, "timestamp": "01:18:21", "text": "样品。呃，不。我觉得哦，"}, {"type": "subtitle", "time": 4704.47, "timestamp": "01:18:24", "text": "这个人ch 我对你免费的感兴趣吗？"}, {"type": "subtitle", "time": 4707.03, "timestamp": "01:18:27", "text": "样本？"}, {"type": "subtitle", "time": 4717.669, "timestamp": "01:18:37", "text": "成功。那可是好东西。你会听到"}, {"type": "subtitle", "time": 4718.99, "timestamp": "01:18:38", "text": "从"}, {"type": "subtitle", "time": 4724.229, "timestamp": "01:18:44", "text": "我。好的。好的。这里是盾牌。在此疗伤。"}, {"type": "subtitle", "time": 4726.39, "timestamp": "01:18:46", "text": "好了，现在怎么办？你已解锁切尔西"}, {"type": "subtitle", "time": 4737.03, "timestamp": "01:18:57", "text": "现在你已经和那家伙进行过专业的交谈了。好的。"}, {"type": "subtitle", "time": 4738.63, "timestamp": "01:18:58", "text": "这篇序章要写多长？"}]
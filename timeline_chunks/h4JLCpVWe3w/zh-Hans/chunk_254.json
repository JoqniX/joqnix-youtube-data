[{"type": "subtitle", "time": 15241.59, "timestamp": "04:14:01", "text": "好的。打开它。点击它。点击它。"}, {"type": "subtitle", "time": 15244.149, "timestamp": "04:14:04", "text": "点击它。点击保险丝。好的。呃，是"}, {"type": "subtitle", "time": 15248.55, "timestamp": "04:14:08", "text": "完毕。是的。完毕。它已开放。"}, {"type": "subtitle", "time": 15257.51, "timestamp": "04:14:17", "text": "主。我的天啊。"}, {"type": "subtitle", "time": 15259.99, "timestamp": "04:14:19", "text": "再试着给他打个电话，就在附近。好的。"}, {"type": "subtitle", "time": 15261.67, "timestamp": "04:14:21", "text": "就在这附近。他上次来过这里。"}, {"type": "subtitle", "time": 15263.59, "timestamp": "04:14:23", "text": "所以，我希望他能再次来到这里。"}, {"type": "subtitle", "time": 15266.71, "timestamp": "04:14:26", "text": "露丝，你在哪里？露丝，我们只会"}, {"type": "subtitle", "time": 15268.229, "timestamp": "04:14:28", "text": "如果你一个人，它会回复你，对吗？"}, {"type": "subtitle", "time": 15271.269, "timestamp": "04:14:31", "text": "所以，请待在大厅里。我要去某个地方。"}, {"type": "subtitle", "time": 15279.83, "timestamp": "04:14:39", "text": "好的。露丝·埃弗利，你在哪里？哦，"}, {"type": "subtitle", "time": 15282.55, "timestamp": "04:14:42", "text": "等待。她说了些什么。离开。说"}, {"type": "subtitle", "time": 15285.75, "timestamp": "04:14:45", "text": "某物。离开或者别的什么。稍等"}, {"type": "subtitle", "time": 15287.429, "timestamp": "04:14:47", "text": "第二。这是从厕所里拿出来的。这"}, {"type": "subtitle", "time": 15293.83, "timestamp": "04:14:53", "text": "露丝，你能出来一会儿吗？"}, {"type": "subtitle", "time": 15295.429, "timestamp": "04:14:55", "text": "少量？"}, {"type": "subtitle", "time": 15297.51, "timestamp": "04:14:57", "text": "好的，待在那儿。记住要使用"}]
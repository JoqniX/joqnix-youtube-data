[{"type": "subtitle", "time": 6600.709, "timestamp": "01:50:00", "text": "我们应该购买吗？呃，你必须"}, {"type": "subtitle", "time": 6603.83, "timestamp": "01:50:03", "text": "你只能通过网上银行购买。"}, {"type": "subtitle", "time": 6607.47, "timestamp": "01:50:07", "text": "在商店里。获得一个"}, {"type": "subtitle", "time": 6610.109, "timestamp": "01:50:10", "text": "帐篷。呃，那"}, {"type": "subtitle", "time": 6613.149, "timestamp": "01:50:13", "text": "土壤。呃"}, {"type": "subtitle", "time": 6617.109, "timestamp": "01:50:17", "text": "呃，帐篷在哪儿？种植帐篷。这是"}, {"type": "subtitle", "time": 6618.99, "timestamp": "01:50:18", "text": "第一的"}, {"type": "subtitle", "time": 6622.79, "timestamp": "01:50:22", "text": "选项。哦好的。"}, {"type": "subtitle", "time": 6625.91, "timestamp": "01:50:25", "text": "是的。等等，等等，等等。我打算这样做"}, {"type": "subtitle", "time": 6627.75, "timestamp": "01:50:27", "text": "那个故障。"}, {"type": "subtitle", "time": 6630.39, "timestamp": "01:50:30", "text": "搞什么鬼？好的。我们需要的在哪里？"}, {"type": "subtitle", "time": 6632.39, "timestamp": "01:50:32", "text": "一个锅。"}, {"type": "subtitle", "time": 6634.87, "timestamp": "01:50:34", "text": "是的，你可以这样做。等等，等等，等等。"}, {"type": "subtitle", "time": 6640.03, "timestamp": "01:50:40", "text": "去做。找个好地方做。"}, {"type": "subtitle", "time": 6642.229, "timestamp": "01:50:42", "text": "嗯哼。什么好地方？我在"}, {"type": "subtitle", "time": 6644.07, "timestamp": "01:50:44", "text": "中间。哦，等等。过来，过来。来"}, {"type": "subtitle", "time": 6646.79, "timestamp": "01:50:46", "text": "这里。过来。最佳地点将是"}, {"type": "subtitle", "time": 6650.79, "timestamp": "01:50:50", "text": "我在Agl农业公司工作。担，"}, {"type": "subtitle", "time": 6652.31, "timestamp": "01:50:52", "text": "谢谢。"}, {"type": "subtitle", "time": 6654.39, "timestamp": "01:50:54", "text": "好的。这个破坏者将会是一个好东西"}, {"type": "subtitle", "time": 6656.55, "timestamp": "01:50:56", "text": "地方。你们都去哪儿了？什么？"}, {"type": "subtitle", "time": 6659.51, "timestamp": "01:50:59", "text": "他妈的？呃，我们站在凡人面前。"}]
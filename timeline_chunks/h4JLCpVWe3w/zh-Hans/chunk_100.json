[{"type": "subtitle", "time": 6000.55, "timestamp": "01:40:00", "text": "是的。"}, {"type": "subtitle", "time": 6002.79, "timestamp": "01:40:02", "text": "不，我以为我买到了蜡籽之类的东西。"}, {"type": "subtitle", "time": 6006.629, "timestamp": "01:40:06", "text": "兄弟。搞什么鬼？"}, {"type": "subtitle", "time": 6009.43, "timestamp": "01:40:09", "text": "等等，你们在哪儿？好了，我现在是"}, {"type": "subtitle", "time": 6014.87, "timestamp": "01:40:14", "text": "在汽车经销店。好吧，我想"}, {"type": "subtitle", "time": 6018.629, "timestamp": "01:40:18", "text": "我知道我们要做什么。"}, {"type": "subtitle", "time": 6021.51, "timestamp": "01:40:21", "text": "你可以按 F 键来获得类似……"}, {"type": "subtitle", "time": 6025.629, "timestamp": "01:40:25", "text": "手电筒。哦好的。是的，你是"}, {"type": "subtitle", "time": 6028.59, "timestamp": "01:40:28", "text": "闪闪发光。现在你不是了。现在"}, {"type": "subtitle", "time": 6032.07, "timestamp": "01:40:32", "text": "你被闪光灯闪到了。不是在恶作剧中"}, {"type": "subtitle", "time": 6034.229, "timestamp": "01:40:34", "text": "方式。"}, {"type": "subtitle", "time": 6036.95, "timestamp": "01:40:36", "text": "呃，这里为什么会有一具尸体？我"}, {"type": "subtitle", "time": 6039.75, "timestamp": "01:40:39", "text": "杀死了它。乔克。"}, {"type": "subtitle", "time": 6042.91, "timestamp": "01:40:42", "text": "哦，他还活着。"}, {"type": "subtitle", "time": 6047.51, "timestamp": "01:40:47", "text": "乔克。陌生女子。不，他还活着。这"}, {"type": "subtitle", "time": 6050.47, "timestamp": "01:40:50", "text": "他还活着。他死了。我可以挑选"}, {"type": "subtitle", "time": 6055.99, "timestamp": "01:40:55", "text": "把它们举起来。等等，我的屏幕上他明明还活着。"}, {"type": "subtitle", "time": 6058.79, "timestamp": "01:40:58", "text": "什么？我害怕运动健将。乔克的"}]
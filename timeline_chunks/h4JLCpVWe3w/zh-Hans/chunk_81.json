[{"type": "subtitle", "time": 4862.47, "timestamp": "01:21:02", "text": "来自美泰公司的人。"}, {"type": "subtitle", "time": 4864.63, "timestamp": "01:21:04", "text": "但你确实做到了。是的。是的，你没事。"}, {"type": "subtitle", "time": 4871.27, "timestamp": "01:21:11", "text": "Line 的目标。事实上，他已经欠了一些钱。"}, {"type": "subtitle", "time": 4873.59, "timestamp": "01:21:13", "text": "现金。哦，不。他一直表现不错"}, {"type": "subtitle", "time": 4876.83, "timestamp": "01:21:16", "text": "敬拜他"}, {"type": "subtitle", "time": 4879.669, "timestamp": "01:21:19", "text": "很快。今天是 Bonsi。美好的。但如果"}, {"type": "subtitle", "time": 4882.27, "timestamp": "01:21:22", "text": "如果不付钱，他就要付钱。"}, {"type": "subtitle", "time": 4885.189, "timestamp": "01:21:25", "text": "好的。妈的。哦，该死。妈的。这是一个"}, {"type": "subtitle", "time": 4887.27, "timestamp": "01:21:27", "text": "是个警察。是个警察。我可以杀人吗？"}, {"type": "subtitle", "time": 4889.83, "timestamp": "01:21:29", "text": "他？揍他一顿。揍他一顿。"}, {"type": "subtitle", "time": 4893.03, "timestamp": "01:21:33", "text": "揍他一顿。揍他一顿。揍他一顿。"}, {"type": "subtitle", "time": 4896.07, "timestamp": "01:21:36", "text": "我可以杀了他吗？呃，你可以把他打倒。"}, {"type": "subtitle", "time": 4897.669, "timestamp": "01:21:37", "text": "离开。对，把他干掉。是的，我只是"}, {"type": "subtitle", "time": 4900.95, "timestamp": "01:21:40", "text": "杀了他。不，我只是开车撞了他。哦，"}, {"type": "subtitle", "time": 4902.31, "timestamp": "01:21:42", "text": "这样效率更高。就是这样"}, {"type": "subtitle", "time": 4903.91, "timestamp": "01:21:43", "text": "美好的。我的天哪。不，他还活着。什么？"}, {"type": "subtitle", "time": 4906.79, "timestamp": "01:21:46", "text": "他妈的？搞什么鬼？我把你碾碎了，"}, {"type": "subtitle", "time": 4910.55, "timestamp": "01:21:50", "text": "男人。什么鬼？但严格来说，它是"}, {"type": "subtitle", "time": 4913.75, "timestamp": "01:21:53", "text": "教你如何躲避身体"}, {"type": "subtitle", "time": 4916.709, "timestamp": "01:21:56", "text": "搜索机制。我这就跑"}, {"type": "subtitle", "time": 4919.669, "timestamp": "01:21:59", "text": "离开。开车返回牧场。全部"}]
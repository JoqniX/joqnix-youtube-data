[{"type": "subtitle", "time": 17520.788, "timestamp": "04:52:00", "text": "这样也行吗？"}, {"type": "subtitle", "time": 17523.27, "timestamp": "04:52:03", "text": "呃，如果我能看到游戏画面的话，那么我"}, {"type": "subtitle", "time": 17525.43, "timestamp": "04:52:05", "text": "没问题。"}, {"type": "subtitle", "time": 17530.19, "timestamp": "04:52:10", "text": "你可以看到直播画面。"}, {"type": "subtitle", "time": 17540.708, "timestamp": "04:52:20", "text": "屏幕。我喜欢它根本就做不到这一点。"}, {"type": "subtitle", "time": 17544.868, "timestamp": "04:52:24", "text": "拍下我和那个鬼魂的对比照，看看它有多蠢。"}, {"type": "subtitle", "time": 17548.708, "timestamp": "04:52:28", "text": "小幽灵。小幽灵。"}, {"type": "subtitle", "time": 17557.75, "timestamp": "04:52:37", "text": "抓住这个人。为什么没有显示"}, {"type": "subtitle", "time": 17561.55, "timestamp": "04:52:41", "text": "可以共享屏幕吗？好的，明白了。"}, {"type": "subtitle", "time": 17564.43, "timestamp": "04:52:44", "text": "它。"}, {"type": "subtitle", "time": 17569.99, "timestamp": "04:52:49", "text": "嗯，窗户。好了，开始直播。好的。是的，我"}, {"type": "subtitle", "time": 17574.15, "timestamp": "04:52:54", "text": "我看到了。是的，我看到了。是的。是的。"}]
[{"type": "subtitle", "time": 12609.59, "timestamp": "03:30:09", "text": "好吧，他确实把门锁上了。什么"}, {"type": "subtitle", "time": 12611.71, "timestamp": "03:30:11", "text": "这"}, {"type": "subtitle", "time": 12613.71, "timestamp": "03:30:13", "text": "什么？大"}, {"type": "subtitle", "time": 12637.83, "timestamp": "03:30:37", "text": "二。哦，他确实这么做了。等待。我认为是"}, {"type": "subtitle", "time": 12652.75, "timestamp": "03:30:52", "text": "哦。哦，我死了。笑话出自。不。"}, {"type": "subtitle", "time": 12659.309, "timestamp": "03:30:59", "text": "不。米奇"}]
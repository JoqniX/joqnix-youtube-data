[{"type": "subtitle", "time": 3960.64, "timestamp": "01:06:00", "text": "等等，我应该直接开个新游戏吗？哦，"}, {"type": "subtitle", "time": 3961.789, "timestamp": "01:06:01", "text": "[音乐]"}, {"type": "subtitle", "time": 3964.39, "timestamp": "01:06:04", "text": "是的。你玩上了一款新游戏。是的，就是"}, {"type": "subtitle", "time": 3967.51, "timestamp": "01:06:07", "text": "唯一的选择，对吧？好的。等等，你"}, {"type": "subtitle", "time": 3970.23, "timestamp": "01:06:10", "text": "无法继续。哦，不。我认为是博拉的"}, {"type": "subtitle", "time": 3972.069, "timestamp": "01:06:12", "text": "刚刚开始。"}, {"type": "subtitle", "time": 3974.27, "timestamp": "01:06:14", "text": "好的。好的。好的。是的。是的。是的。"}, {"type": "subtitle", "time": 3977.029, "timestamp": "01:06:17", "text": "是的。是的。是的。是的。坚持，稍等。那里"}, {"type": "subtitle", "time": 3980.71, "timestamp": "01:06:20", "text": "你去。现在你可以看到同性恋了。"}, {"type": "subtitle", "time": 3983.349, "timestamp": "01:06:23", "text": "好的。所以，我们到底在做什么？做"}, {"type": "subtitle", "time": 3987.43, "timestamp": "01:06:27", "text": "我们是走《绝命毒师》那种路线，还是走类似……"}, {"type": "subtitle", "time": 3988.87, "timestamp": "01:06:28", "text": "这将是你的“实际上”"}, {"type": "subtitle", "time": 3990.63, "timestamp": "01:06:30", "text": "不知道结局，就像我们能做到的那样"}, {"type": "subtitle", "time": 3992.87, "timestamp": "01:06:32", "text": "可以像人们通常那样开始。"}, {"type": "subtitle", "time": 3995.99, "timestamp": "01:06:35", "text": "随便玩玩就行了。哦不，就像"}, {"type": "subtitle", "time": 3998.63, "timestamp": "01:06:38", "text": "这里将成为你们的大厅。所以就像"}, {"type": "subtitle", "time": 4001.589, "timestamp": "01:06:41", "text": "我们有角色扮演吗？"}, {"type": "subtitle", "time": 4004.589, "timestamp": "01:06:44", "text": "自定义角色，使其符合你的喜好。"}, {"type": "subtitle", "time": 4008.789, "timestamp": "01:06:48", "text": "满足感，所以你是个自恋狂"}, {"type": "subtitle", "time": 4011.71, "timestamp": "01:06:51", "text": "性格可以是"}, {"type": "subtitle", "time": 4014.95, "timestamp": "01:06:54", "text": "性爱很满足。"}, {"type": "subtitle", "time": 4016.23, "timestamp": "01:06:56", "text": "好了伙计们，我们要杀人了"}]
[{"type": "subtitle", "time": 6722.149, "timestamp": "01:52:02", "text": "你发送的垃圾邮件越多，你的等级就越高。是的。"}, {"type": "subtitle", "time": 6724.47, "timestamp": "01:52:04", "text": "是的。是的。"}, {"type": "subtitle", "time": 6734.79, "timestamp": "01:52:14", "text": "去他妈的。就是这样。我要下药"}, {"type": "subtitle", "time": 6737.43, "timestamp": "01:52:17", "text": "交易。我就是我。"}, {"type": "subtitle", "time": 6740.629, "timestamp": "01:52:20", "text": "什么？你做了饭。嘿。嘿，山姆。会"}, {"type": "subtitle", "time": 6742.95, "timestamp": "01:52:22", "text": "你想……呃，得到我们的一些东西"}, {"type": "subtitle", "time": 6746.229, "timestamp": "01:52:26", "text": "产品？什么？干得好。这里"}, {"type": "subtitle", "time": 6748.55, "timestamp": "01:52:28", "text": "去。你们玩得开心的时候，我"}, {"type": "subtitle", "time": 6751.03, "timestamp": "01:52:31", "text": "我在这里像个真正的毒贩一样贩毒。"}, {"type": "subtitle", "time": 6754.07, "timestamp": "01:52:34", "text": "毒贩。你刚才是不是……我想……"}, {"type": "subtitle", "time": 6759.47, "timestamp": "01:52:39", "text": "帮助。嘿，回来吧。等等，什么先生"}, {"type": "subtitle", "time": 6762.99, "timestamp": "01:52:42", "text": "你有没有，"}, {"type": "subtitle", "time": 6766.07, "timestamp": "01:52:46", "text": "婊子？我分享了你的想法，他认为他认为。"}, {"type": "subtitle", "time": 6769.109, "timestamp": "01:52:49", "text": "他可以随时逃离我，而且不会买我的"}, {"type": "subtitle", "time": 6770.95, "timestamp": "01:52:50", "text": "产品。乔，你能想象吗？"}, {"type": "subtitle", "time": 6774.99, "timestamp": "01:52:54", "text": "他妈的。你能想象吗？"}, {"type": "subtitle", "time": 6777.87, "timestamp": "01:52:57", "text": "别担心。"}]
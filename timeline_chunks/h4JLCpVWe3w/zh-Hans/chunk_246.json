[{"type": "subtitle", "time": 14760.63, "timestamp": "04:06:00", "text": "好的。所以，我点击了鼠标左键，对吧？嗯，是的。"}, {"type": "subtitle", "time": 14762.229, "timestamp": "04:06:02", "text": "你右键点击，然后就会……"}, {"type": "subtitle", "time": 14763.83, "timestamp": "04:06:03", "text": "一张图片。但现在别拍照。"}, {"type": "subtitle", "time": 14765.429, "timestamp": "04:06:05", "text": "每当你看到鬼魂时，就拿"}, {"type": "subtitle", "time": 14768.63, "timestamp": "04:06:08", "text": "图片。我们需要那个。好的。"}, {"type": "subtitle", "time": 14770.229, "timestamp": "04:06:10", "text": "我将告诉你接下来的活动。"}, {"type": "subtitle", "time": 14772.87, "timestamp": "04:06:12", "text": "从卡车上。露丝，你在哪里？"}, {"type": "subtitle", "time": 14775.429, "timestamp": "04:06:15", "text": "露丝，出来。出来。无论你在哪里"}, {"type": "subtitle", "time": 14786.229, "timestamp": "04:06:26", "text": "跟他说点什么，问他一些问题，或者"}, {"type": "subtitle", "time": 14788.189, "timestamp": "04:06:28", "text": "威胁他。"}, {"type": "subtitle", "time": 14790.87, "timestamp": "04:06:30", "text": "好的，兄弟。你知道你要去哪里吗？"}, {"type": "subtitle", "time": 14793.99, "timestamp": "04:06:33", "text": "被我们杀死，但不是被我们猎杀？如何"}, {"type": "subtitle", "time": 14798.07, "timestamp": "04:06:38", "text": "搞什么鬼？他已经死了。"}, {"type": "subtitle", "time": 14800.309, "timestamp": "04:06:40", "text": "哦，是的。忘了。"}, {"type": "subtitle", "time": 14802.389, "timestamp": "04:06:42", "text": "问他：“你好吗？”是"}, {"type": "subtitle", "time": 14806.91, "timestamp": "04:06:46", "text": "你在这里？是的。是的。它怎么样？"}, {"type": "subtitle", "time": 14810.349, "timestamp": "04:06:50", "text": "鲁德，你今天过得怎么样？"}, {"type": "subtitle", "time": 14813.429, "timestamp": "04:06:53", "text": "露丝，你过得怎么样？顺便问一下，"}, {"type": "subtitle", "time": 14815.75, "timestamp": "04:06:55", "text": "使用灵盒进行游戏。那只是"}, {"type": "subtitle", "time": 14817.51, "timestamp": "04:06:57", "text": "他什么时候会回复？使用灵盒。"}, {"type": "subtitle", "time": 14819.83, "timestamp": "04:06:59", "text": "哦好的。好的。好的。是的，如果他"}]
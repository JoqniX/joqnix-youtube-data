[{"type": "subtitle", "time": 16501.83, "timestamp": "04:35:01", "text": "可能会让你想过来拿"}, {"type": "subtitle", "time": 16503.83, "timestamp": "04:35:03", "text": "相机之类的东西。我不知道。但"}, {"type": "subtitle", "time": 16506.15, "timestamp": "04:35:06", "text": "问题是因为他正在狩猎"}, {"type": "subtitle", "time": 16509.189, "timestamp": "04:35:09", "text": "对，我什么都看不见，如果我"}, {"type": "subtitle", "time": 16512.15, "timestamp": "04:35:12", "text": "是的，她也是黑人，所以我的意思是，不是"}, {"type": "subtitle", "time": 16515.349, "timestamp": "04:35:15", "text": "一片漆黑，不，她身处阴影之中。是的。"}, {"type": "subtitle", "time": 16518.869, "timestamp": "04:35:18", "text": "谢谢。是的。所以我会像这样：不"}, {"type": "subtitle", "time": 16521.189, "timestamp": "04:35:21", "text": "我能看见她，她会杀了我。"}, {"type": "subtitle", "time": 16523.429, "timestamp": "04:35:23", "text": "是的。"}, {"type": "subtitle", "time": 16525.75, "timestamp": "04:35:25", "text": "对，是你，Obo。她好小啊"}, {"type": "subtitle", "time": 16529.15, "timestamp": "04:35:29", "text": "就像你一样。是的。你是只青蛙。小的"}, {"type": "subtitle", "time": 16532.629, "timestamp": "04:35:32", "text": "把青蛙设为头像。"}, {"type": "subtitle", "time": 16535.269, "timestamp": "04:35:35", "text": "呃，她来了。"}, {"type": "subtitle", "time": 16538.949, "timestamp": "04:35:38", "text": "她来了。嘿哟，"}, {"type": "subtitle", "time": 16540.551, "timestamp": "04:35:40", "text": "别再摔盘子了，你这个坏孩子！"}, {"type": "subtitle", "time": 16548.07, "timestamp": "04:35:48", "text": "上次我和凯拉还有塞莱斯特一起玩"}, {"type": "subtitle", "time": 16549.91, "timestamp": "04:35:49", "text": "它，Celeste 和 Kyra 简直就是"}, {"type": "subtitle", "time": 16551.429, "timestamp": "04:35:51", "text": "寻找该死的骨头。我当时就想，"}]
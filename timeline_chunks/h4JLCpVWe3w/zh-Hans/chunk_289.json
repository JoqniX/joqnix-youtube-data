[{"type": "subtitle", "time": 17344.948, "timestamp": "04:49:04", "text": "哦，所以没有呃哦，他们是"}, {"type": "subtitle", "time": 17347.19, "timestamp": "04:49:07", "text": "楼上。好吧，想象一下你叫他"}, {"type": "subtitle", "time": 17348.948, "timestamp": "04:49:08", "text": "待处理，然后是幽灵回复。"}, {"type": "subtitle", "time": 17354.948, "timestamp": "04:49:14", "text": "把我的手电筒拿走。"}, {"type": "subtitle", "time": 17356.788, "timestamp": "04:49:16", "text": "好的。"}, {"type": "subtitle", "time": 17361.51, "timestamp": "04:49:21", "text": "利用电磁场探测超自然现象的证据"}, {"type": "subtitle", "time": 17364.23, "timestamp": "04:49:24", "text": "电磁场读数器。获取幽灵攻略"}, {"type": "subtitle", "time": 17366.15, "timestamp": "04:49:26", "text": "停滞不前。探测超自然声音"}, {"type": "subtitle", "time": 17367.75, "timestamp": "04:49:27", "text": "抛物线麦克风。我们没有抛物线"}, {"type": "subtitle", "time": 17371.51, "timestamp": "04:49:31", "text": "麦克风。所以，我们来看一下“哦，我的游戏是……”"}, {"type": "subtitle", "time": 17375.51, "timestamp": "04:49:35", "text": "滞后。等等，不对。好的，那就拿走"}, {"type": "subtitle", "time": 17379.67, "timestamp": "04:49:39", "text": "灵盒。是的。等等，它只显示我一个人。"}, {"type": "subtitle", "time": 17382.39, "timestamp": "04:49:42", "text": "你的游戏在哪里？哦，你玩过这个游戏吗？"}, {"type": "subtitle", "time": 17384.15, "timestamp": "04:49:44", "text": "碰撞？"}, {"type": "subtitle", "time": 17386.47, "timestamp": "04:49:46", "text": "是的，我觉得它崩溃了。"}, {"type": "subtitle", "time": 17393.6, "timestamp": "04:49:53", "text": "它崩溃了。 艺术速写。"}, {"type": "subtitle", "time": 17395.68, "timestamp": "04:49:55", "text": "艺术速写。 你想让我再生吗？还是你？"}, {"type": "subtitle", "time": 17397.36, "timestamp": "04:49:57", "text": "你想让我再生吗？还是你？ 快点完成吗？我的意思是，我可以"}]
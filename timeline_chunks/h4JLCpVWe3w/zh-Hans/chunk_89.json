[{"type": "subtitle", "time": 5343.83, "timestamp": "01:29:03", "text": "去。完毕。我已经准备好了。你好，"}, {"type": "subtitle", "time": 5345.99, "timestamp": "01:29:05", "text": "乔克。我们他妈的为什么会选择这个？"}, {"type": "subtitle", "time": 5349.03, "timestamp": "01:29:09", "text": "同一件事？"}, {"type": "subtitle", "time": 5351.99, "timestamp": "01:29:11", "text": "你好。"}, {"type": "subtitle", "time": 5360.87, "timestamp": "01:29:20", "text": "我的计划？我们有车吗？我们没有"}, {"type": "subtitle", "time": 5365.35, "timestamp": "01:29:25", "text": "汽车。不，我想我们必须买。"}, {"type": "subtitle", "time": 5367.43, "timestamp": "01:29:27", "text": "是的，我们得买。好的。全部"}, {"type": "subtitle", "time": 5369.83, "timestamp": "01:29:29", "text": "好的，各位。我们可以将迪士尼乐园打造成……"}, {"type": "subtitle", "time": 5372.11, "timestamp": "01:29:32", "text": "最大的卡车或"}, {"type": "subtitle", "time": 5375.55, "timestamp": "01:29:35", "text": "耶。伊曼在哪里？抓住"}, {"type": "subtitle", "time": 5378.95, "timestamp": "01:29:38", "text": "向上。呃，"}, {"type": "subtitle", "time": 5384.629, "timestamp": "01:29:44", "text": "好的，乔。我急需这个。我们开始吧"}, {"type": "subtitle", "time": 5387.27, "timestamp": "01:29:47", "text": "去。我们走吧。"}, {"type": "subtitle", "time": 5390.55, "timestamp": "01:29:50", "text": "哟，先生。"}, {"type": "subtitle", "time": 5393.99, "timestamp": "01:29:53", "text": "我喜欢我的外表"}, {"type": "subtitle", "time": 5397.669, "timestamp": "01:29:57", "text": "杰西。我需要大麻。杰西。哟，闭嘴"}]
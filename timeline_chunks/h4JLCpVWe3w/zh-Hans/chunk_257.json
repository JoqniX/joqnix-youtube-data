[{"type": "subtitle", "time": 15426.07, "timestamp": "04:17:06", "text": "[音乐]"}, {"type": "subtitle", "time": 15427.83, "timestamp": "04:17:07", "text": "把手电筒稍微关掉一点，然后走吧。"}, {"type": "subtitle", "time": 15433.67, "timestamp": "04:17:13", "text": "回到地下室并使用"}, {"type": "subtitle", "time": 15435.11, "timestamp": "04:17:15", "text": "用手电筒照明并打开它。我看看有没有"}, {"type": "subtitle", "time": 15439.83, "timestamp": "04:17:19", "text": "是任何球体吗？地下室。好的。是的。"}, {"type": "subtitle", "time": 15442.55, "timestamp": "04:17:22", "text": "呃，有娃娃咔哒咔哒的声音。我是"}, {"type": "subtitle", "time": 15444.149, "timestamp": "04:17:24", "text": "我要去……呃，我要去……"}, {"type": "subtitle", "time": 15447.349, "timestamp": "04:17:27", "text": "地下室。是的。是的。是的。不要说话"}, {"type": "subtitle", "time": 15449.269, "timestamp": "04:17:29", "text": "在游戏里，对吧？这样她就听不见了"}, {"type": "subtitle", "time": 15452.55, "timestamp": "04:17:32", "text": "你。好的。是的，"}, {"type": "subtitle", "time": 15455.189, "timestamp": "04:17:35", "text": "你现在知道了。哪里是……"}, {"type": "subtitle", "time": 15457.99, "timestamp": "04:17:37", "text": "发电机？好的。是的，那我应该走了"}, {"type": "subtitle", "time": 15460.07, "timestamp": "04:17:40", "text": "那里。哦，我看到一个光球。拿起日记本"}, {"type": "subtitle", "time": 15462.63, "timestamp": "04:17:42", "text": "取出并放入球体。乔克。"}, {"type": "subtitle", "time": 15466.149, "timestamp": "04:17:46", "text": "一本日记。证据。是的。幽灵宝珠。"}, {"type": "subtitle", "time": 15469.55, "timestamp": "04:17:49", "text": "还要加上一个灵盒。精神"}, {"type": "subtitle", "time": 15472.91, "timestamp": "04:17:52", "text": "盒子。你的kai开了吗？"}, {"type": "subtitle", "time": 15475.91, "timestamp": "04:17:55", "text": "我好像听到什么了？呃，不。不要"}, {"type": "subtitle", "time": 15477.67, "timestamp": "04:17:57", "text": "使用。好的。你听到什么了吗？来。"}, {"type": "subtitle", "time": 15479.59, "timestamp": "04:17:59", "text": "过来。跟我来。跟我来。"}]
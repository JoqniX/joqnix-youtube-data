[{"type": "subtitle", "time": 4626.87, "timestamp": "01:17:06", "text": "好的。好的。我们来看看是什么。"}, {"type": "subtitle", "time": 4629.91, "timestamp": "01:17:09", "text": "这里正在发生什么。"}, {"type": "subtitle", "time": 4633.43, "timestamp": "01:17:13", "text": "你好。 H. 你好，我是纳尔逊的联系人。这是什么？"}, {"type": "subtitle", "time": 4639.43, "timestamp": "01:17:19", "text": "你好。是的，我需要和纳尔逊谈谈。"}, {"type": "subtitle", "time": 4650.07, "timestamp": "01:17:30", "text": "什么？他只是说了声你好。我该怎么做？"}, {"type": "subtitle", "time": 4653.03, "timestamp": "01:17:33", "text": "哦，不。不。呃，你们提供一次免费赠送。"}, {"type": "subtitle", "time": 4656.39, "timestamp": "01:17:36", "text": "给旁边一位护士送去样本"}, {"type": "subtitle", "time": 4659.91, "timestamp": "01:17:39", "text": "医生办公室。好的。"}, {"type": "subtitle", "time": 4663.59, "timestamp": "01:17:43", "text": "它就在你的左边，星星和"}, {"type": "subtitle", "time": 4665.83, "timestamp": "01:17:45", "text": "一切。"}, {"type": "subtitle", "time": 4668.149, "timestamp": "01:17:48", "text": "密切关注制作过程"}, {"type": "subtitle", "time": 4670.31, "timestamp": "01:17:50", "text": "回合。打开联系人应用。我已经"}, {"type": "subtitle", "time": 4673.83, "timestamp": "01:17:53", "text": "确实传开了。好的。呃，你……"}, {"type": "subtitle", "time": 4675.35, "timestamp": "01:17:55", "text": "点击“哦”，你打开了联系人。"}, {"type": "subtitle", "time": 4679.87, "timestamp": "01:17:59", "text": "正确的？不是文本。哦好的。"}]
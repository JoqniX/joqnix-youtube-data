[{"type": "subtitle", "time": 3900.19, "timestamp": "01:05:00", "text": "我们甚至还有社会"}, {"type": "subtitle", "time": 3903.99, "timestamp": "01:05:03", "text": "标准。当然。当然。亚当"}, {"type": "subtitle", "time": 3911.829, "timestamp": "01:05:11", "text": "好的。亚当，"}, {"type": "subtitle", "time": 3913.91, "timestamp": "01:05:13", "text": "我真为那个人感到难过。他是 他是"}, {"type": "subtitle", "time": 3915.91, "timestamp": "01:05:15", "text": "新来的。他……我不认识他。"}, {"type": "subtitle", "time": 3918.47, "timestamp": "01:05:18", "text": "实际上。他只是，不，他只是，他只是"}, {"type": "subtitle", "time": 3921.029, "timestamp": "01:05:21", "text": "他进来了。他就像个陌生人。我很抱歉。"}, {"type": "subtitle", "time": 3922.549, "timestamp": "01:05:22", "text": "我"}, {"type": "subtitle", "time": 3924.23, "timestamp": "01:05:24", "text": "如果你想封禁他，你可以封禁他。"}, {"type": "subtitle", "time": 3933.349, "timestamp": "01:05:33", "text": "好久不见。已经过去一段时间了。"}, {"type": "subtitle", "time": 3935.43, "timestamp": "01:05:35", "text": "出色地，"}, {"type": "subtitle", "time": 3937.67, "timestamp": "01:05:37", "text": "呃，我已经多久没直播了？"}, {"type": "subtitle", "time": 3942.549, "timestamp": "01:05:42", "text": "已经过去多久了？ 24年。 24年。我"}, {"type": "subtitle", "time": 3946.71, "timestamp": "01:05:46", "text": "我根本没问你的意见。"}, {"type": "subtitle", "time": 3949.029, "timestamp": "01:05:49", "text": "非常感谢各位。谢谢。哦，"}, {"type": "subtitle", "time": 3952.63, "timestamp": "01:05:52", "text": "操我屁眼。我的天哪。"}, {"type": "subtitle", "time": 3954.309, "timestamp": "01:05:54", "text": "嘿，那是个问题，不，我"}, {"type": "subtitle", "time": 3957.109, "timestamp": "01:05:57", "text": "我不是那个意思。不，不，不，不。"}]
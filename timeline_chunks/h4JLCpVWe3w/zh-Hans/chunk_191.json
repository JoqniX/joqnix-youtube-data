[{"type": "subtitle", "time": 11473.15, "timestamp": "03:11:13", "text": "哇。我的天哪。那是你的"}, {"type": "subtitle", "time": 11476.309, "timestamp": "03:11:16", "text": "男生。如果……我会尖叫得撕心裂肺"}, {"type": "subtitle", "time": 11479.269, "timestamp": "03:11:19", "text": "鬼先抓住了我。我的天啊。"}, {"type": "subtitle", "time": 11484.03, "timestamp": "03:11:24", "text": "欢迎回来。幽灵莫罗伊·莫伊骨"}, {"type": "subtitle", "time": 11486.19, "timestamp": "03:11:26", "text": "证据。"}, {"type": "subtitle", "time": 11490.389, "timestamp": "03:11:30", "text": "哦，升级了。解锁三脚架边缘场"}, {"type": "subtitle", "time": 11495.269, "timestamp": "03:11:35", "text": "道路和山脊景观绳索。哦，我们走吧。"}, {"type": "subtitle", "time": 11497.63, "timestamp": "03:11:37", "text": "我升级了"}, {"type": "subtitle", "time": 11500.23, "timestamp": "03:11:40", "text": "向上。我们走吧。我升级了。我他妈的"}, {"type": "subtitle", "time": 11502.95, "timestamp": "03:11:42", "text": "问鬼魂是不是英国人"}, {"type": "subtitle", "time": 11506.07, "timestamp": "03:11:46", "text": "他对此感到不满。我当时站着"}, {"type": "subtitle", "time": 11507.99, "timestamp": "03:11:47", "text": "那里。他刚从我右边走过来，然后他"}, {"type": "subtitle", "time": 11510.07, "timestamp": "03:11:50", "text": "当时的感觉就像，“哦。”他当时说：“嘿，"}]
[{"type": "subtitle", "time": 6120.99, "timestamp": "01:42:00", "text": "伙计们，我们得离开这里。"}, {"type": "subtitle", "time": 6124.31, "timestamp": "01:42:04", "text": "这里。我想知道你是否可以 哦，那里有一个"}, {"type": "subtitle", "time": 6128.149, "timestamp": "01:42:08", "text": "警察局。我可以报警吗？"}, {"type": "subtitle", "time": 6130.47, "timestamp": "01:42:10", "text": "你为什么要报警？"}, {"type": "subtitle", "time": 6133.109, "timestamp": "01:42:13", "text": "贝利。让我给贝利警官打电话。哦，"}, {"type": "subtitle", "time": 6136.31, "timestamp": "01:42:16", "text": "那是爸爸。当心。当心。"}, {"type": "subtitle", "time": 6139.83, "timestamp": "01:42:19", "text": "哦，不。我当时就想：我的天哪。我没做任何事"}, {"type": "subtitle", "time": 6142.47, "timestamp": "01:42:22", "text": "什么也没做。我不是。你可以"}, {"type": "subtitle", "time": 6144.55, "timestamp": "01:42:24", "text": "躲在垃圾箱里。"}, {"type": "subtitle", "time": 6151.27, "timestamp": "01:42:31", "text": "哦，他们现在在追我。好的。"}, {"type": "subtitle", "time": 6154.109, "timestamp": "01:42:34", "text": "你可以打开它。"}, {"type": "subtitle", "time": 6157.99, "timestamp": "01:42:37", "text": "哦，我来了。我来了。"}, {"type": "subtitle", "time": 6162.31, "timestamp": "01:42:42", "text": "哦，你可以跳到屋顶上。"}, {"type": "subtitle", "time": 6164.229, "timestamp": "01:42:44", "text": "也一样。对，屋顶。是的。他们"}, {"type": "subtitle", "time": 6166.07, "timestamp": "01:42:46", "text": "他们抓不到你，而且他们很快就会忘记。"}, {"type": "subtitle", "time": 6168.87, "timestamp": "01:42:48", "text": "你曾存在过。好的。好吧，他们让他们……"}, {"type": "subtitle", "time": 6177.59, "timestamp": "01:42:57", "text": "汽车旅馆的经理在哪里？"}, {"type": "subtitle", "time": 6178.709, "timestamp": "01:42:58", "text": "我认为他们会留在……"}]
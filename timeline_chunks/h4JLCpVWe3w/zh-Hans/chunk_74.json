[{"type": "subtitle", "time": 4441.43, "timestamp": "01:14:01", "text": "交易。呃，物品拆分。移动"}, {"type": "subtitle", "time": 4443.75, "timestamp": "01:14:03", "text": "消费者周围，右键单击，拖动，然后"}, {"type": "subtitle", "time": 4456.47, "timestamp": "01:14:16", "text": "滚动。我该如何拆分这些物品？呃"}, {"type": "subtitle", "time": 4458.63, "timestamp": "01:14:18", "text": "按住鼠标左键，然后点击右边"}, {"type": "subtitle", "time": 4460.31, "timestamp": "01:14:20", "text": "点击。右键单击该项目。哦，"}, {"type": "subtitle", "time": 4462.149, "timestamp": "01:14:22", "text": "好的。点击右键。我以为那是一个"}, {"type": "subtitle", "time": 4464.95, "timestamp": "01:14:24", "text": "点击鼠标左键。按住Shift键，然后点击鼠标右键"}, {"type": "subtitle", "time": 4467.75, "timestamp": "01:14:27", "text": "单个商品。"}, {"type": "subtitle", "time": 4472.07, "timestamp": "01:14:32", "text": "好的。哦。哦好的。是的，我明白了。"}, {"type": "subtitle", "time": 4473.75, "timestamp": "01:14:33", "text": "但如果你按住鼠标右键，你"}, {"type": "subtitle", "time": 4475.27, "timestamp": "01:14:35", "text": "可以使用滚轮来增加或"}, {"type": "subtitle", "time": 4478.87, "timestamp": "01:14:38", "text": "减少数量。该死。是的。"}, {"type": "subtitle", "time": 4481.91, "timestamp": "01:14:41", "text": "是的。我的鼠标滚轮坏了。所以"}, {"type": "subtitle", "time": 4484.709, "timestamp": "01:14:44", "text": "哦。呃，去你的，伊曼。这一切都是你的"}, {"type": "subtitle", "time": 4486.55, "timestamp": "01:14:46", "text": "过错。"}, {"type": "subtitle", "time": 4488.229, "timestamp": "01:14:48", "text": "然后按住Shift键点击右键。所以我可以"}, {"type": "subtitle", "time": 4490.149, "timestamp": "01:14:50", "text": "再加一个。"}, {"type": "subtitle", "time": 4492.47, "timestamp": "01:14:52", "text": "让我查一下。好的，我找到乔了。等等，不对。"}, {"type": "subtitle", "time": 4494.35, "timestamp": "01:14:54", "text": "那是"}, {"type": "subtitle", "time": 4496.79, "timestamp": "01:14:56", "text": "安迪。呃，好的。我们必须去"}]
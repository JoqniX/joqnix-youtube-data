[{"type": "subtitle", "time": 7080.07, "timestamp": "01:58:00", "text": "想买滑板。呃，我应该吗？"}, {"type": "subtitle", "time": 7082.629, "timestamp": "01:58:02", "text": "买250那个吗？不，不，还是攒钱吧。"}, {"type": "subtitle", "time": 7085.35, "timestamp": "01:58:05", "text": "攒点钱，然后卖些肉。出售和"}, {"type": "subtitle", "time": 7088.149, "timestamp": "01:58:08", "text": "是的。好的。"}, {"type": "subtitle", "time": 7090.47, "timestamp": "01:58:10", "text": "你不能，你不能偷钱"}, {"type": "subtitle", "time": 7092.55, "timestamp": "01:58:12", "text": "他。我相信"}, {"type": "subtitle", "time": 7095.669, "timestamp": "01:58:15", "text": "下午6点他离开时，趁机扒窃他的东西。"}, {"type": "subtitle", "time": 7097.189, "timestamp": "01:58:17", "text": "好的，"}, {"type": "subtitle", "time": 7099.27, "timestamp": "01:58:19", "text": "我们会扒他的钱包，然后我们就有"}, {"type": "subtitle", "time": 7101.99, "timestamp": "01:58:21", "text": "同样数额的钱。什么？我们有，我们必须"}, {"type": "subtitle", "time": 7105.109, "timestamp": "01:58:25", "text": "回收杰西。把宝宝放进蓝色里。"}, {"type": "subtitle", "time": 7107.35, "timestamp": "01:58:27", "text": "杰西，"}, {"type": "subtitle", "time": 7110.07, "timestamp": "01:58:30", "text": "你好。返回汽车旅馆房间。全部"}, {"type": "subtitle", "time": 7112.229, "timestamp": "01:58:32", "text": "正确的。好的。让我来装饰一下我们的瓶子吧。"}, {"type": "subtitle", "time": 7113.99, "timestamp": "01:58:33", "text": "也。好的。呃，我该如何放置……"}, {"type": "subtitle", "time": 7115.83, "timestamp": "01:58:35", "text": "发光的。这是那个发光的帐篷吗？哦，"}, {"type": "subtitle", "time": 7118.39, "timestamp": "01:58:38", "text": "这开始了。是的。"}, {"type": "subtitle", "time": 7124.31, "timestamp": "01:58:44", "text": "好的。把土放在这里。是的。"}, {"type": "subtitle", "time": 7126.55, "timestamp": "01:58:46", "text": "哦，你能……你能……你好，主人"}, {"type": "subtitle", "time": 7128.87, "timestamp": "01:58:48", "text": "印度骑兵。感谢关注。"}, {"type": "subtitle", "time": 7131.589, "timestamp": "01:58:51", "text": "好了。入门很容易。是的，你"}, {"type": "subtitle", "time": 7134.95, "timestamp": "01:58:54", "text": "能。我差点就通关了。是"}, {"type": "subtitle", "time": 7137.03, "timestamp": "01:58:57", "text": "我解锁了狗狗们和我房间里的一切。"}, {"type": "subtitle", "time": 7139.91, "timestamp": "01:58:59", "text": "安全的。呃，有人有水吗？"}]
[{"type": "subtitle", "time": 16622.15, "timestamp": "04:37:02", "text": "她要走了，我要走了"}, {"type": "subtitle", "time": 16623.91, "timestamp": "04:37:03", "text": "沉默了一会儿。看看她能不能做到"}, {"type": "subtitle", "time": 16626.949, "timestamp": "04:37:06", "text": "找到我。好的。等等，你刚才在说什么？"}, {"type": "subtitle", "time": 16629.349, "timestamp": "04:37:09", "text": "游戏里一直都是这样吗？哦，我不是。"}, {"type": "subtitle", "time": 16631.51, "timestamp": "04:37:11", "text": "游戏内对话。我刚才在跟你说话。"}, {"type": "subtitle", "time": 16632.949, "timestamp": "04:37:12", "text": "我不说话了。我需要"}, {"type": "subtitle", "time": 16636.31, "timestamp": "04:37:16", "text": "补水。好的。好的。好的。好的。看"}, {"type": "subtitle", "time": 16640.15, "timestamp": "04:37:20", "text": "看着我站在那里。"}, {"type": "subtitle", "time": 16643.83, "timestamp": "04:37:23", "text": "哦，她朝我走过来。是吗？不，我"}, {"type": "subtitle", "time": 16650.23, "timestamp": "04:37:30", "text": "等等，她在这里吗？他妈的。不，不，不。"}, {"type": "subtitle", "time": 16654.15, "timestamp": "04:37:34", "text": "她比我地位高吗？"}, {"type": "subtitle", "time": 16656.551, "timestamp": "04:37:36", "text": "哦，我觉得她已经升天了。等等，不对。你"}, {"type": "subtitle", "time": 16659.189, "timestamp": "04:37:39", "text": "知道发生了什么事吗？我见过她。这"}, {"type": "subtitle", "time": 16662.47, "timestamp": "04:37:42", "text": "灯光闪烁。我吓坏了"}, {"type": "subtitle", "time": 16665.109, "timestamp": "04:37:45", "text": "球。我去那里是为了寻找"}, {"type": "subtitle", "time": 16666.869, "timestamp": "04:37:46", "text": "在某个地方，我亲眼目睹了你的死亡。所以，我"}, {"type": "subtitle", "time": 16669.109, "timestamp": "04:37:49", "text": "突然停止了移动，独自站着。"}, {"type": "subtitle", "time": 16670.949, "timestamp": "04:37:50", "text": "因为我知道她要杀了你，所以才站在我这边。"}]
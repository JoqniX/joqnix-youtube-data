[{"type": "subtitle", "time": 8880.07, "timestamp": "02:28:00", "text": "我们需要……我会把现金存入……"}, {"type": "subtitle", "time": 8882.309, "timestamp": "02:28:02", "text": "银行，因为我觉得需要弄点东西。"}, {"type": "subtitle", "time": 8885.87, "timestamp": "02:28:05", "text": "塑料袋和"}, {"type": "subtitle", "time": 8888.11, "timestamp": "02:28:08", "text": "呃，可能是另一个"}, {"type": "subtitle", "time": 8896.07, "timestamp": "02:28:16", "text": "这家伙穷得叮当响。他只有"}, {"type": "subtitle", "time": 8901.51, "timestamp": "02:28:21", "text": "是你偷了他的东西。你"}, {"type": "subtitle", "time": 8907.19, "timestamp": "02:28:27", "text": "我们真的在抱怨什么？"}, {"type": "subtitle", "time": 8911.91, "timestamp": "02:28:31", "text": "用匹克球从别人那里赢一美元？"}, {"type": "subtitle", "time": 8914.79, "timestamp": "02:28:34", "text": "这是什么地方？是这里吗？"}, {"type": "subtitle", "time": 8915.79, "timestamp": "02:28:35", "text": "我们将要"}, {"type": "subtitle", "time": 8929.91, "timestamp": "02:28:49", "text": "哦，过来一下。大井。"}, {"type": "subtitle", "time": 8933.27, "timestamp": "02:28:53", "text": "试着向他出售毒品。"}, {"type": "subtitle", "time": 8935.19, "timestamp": "02:28:55", "text": "在哪里？在哪里？"}, {"type": "subtitle", "time": 8937.91, "timestamp": "02:28:57", "text": "杂货店可能就在前面"}]
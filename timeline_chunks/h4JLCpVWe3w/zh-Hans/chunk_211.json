[{"type": "subtitle", "time": 12661.469, "timestamp": "03:31:01", "text": "死了。米奇"}, {"type": "subtitle", "time": 12663.91, "timestamp": "03:31:03", "text": "死了。天哪，我浑身发冷。哦"}, {"type": "subtitle", "time": 12665.99, "timestamp": "03:31:05", "text": "天哪，我浑身发冷。我是"}, {"type": "subtitle", "time": 12668.87, "timestamp": "03:31:08", "text": "开始发冷了。哦不，我快要……"}, {"type": "subtitle", "time": 12669.55, "timestamp": "03:31:09", "text": "这"}, {"type": "subtitle", "time": 12675.389, "timestamp": "03:31:15", "text": "打了个寒颤。我的天哪。我的天哪。哦"}, {"type": "subtitle", "time": 12682.269, "timestamp": "03:31:22", "text": "你有没有看到"}, {"type": "subtitle", "time": 12686.55, "timestamp": "03:31:26", "text": "那？突然冒出个东西。什么？什么"}, {"type": "subtitle", "time": 12704.469, "timestamp": "03:31:44", "text": "看。我为什么会被关在这里？"}]
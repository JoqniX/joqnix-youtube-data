[{"type": "subtitle", "time": 9240.63, "timestamp": "02:34:00", "text": "收成。"}, {"type": "subtitle", "time": 9243.11, "timestamp": "02:34:03", "text": "好的，父亲。"}, {"type": "subtitle", "time": 9247.51, "timestamp": "02:34:07", "text": "我没有“哦，等等”。它需要水。"}, {"type": "subtitle", "time": 9252.27, "timestamp": "02:34:12", "text": "妈的。呃，等等。我得到了"}, {"type": "subtitle", "time": 9255.03, "timestamp": "02:34:15", "text": "它。父亲，您真是太慢了。"}, {"type": "subtitle", "time": 9258.07, "timestamp": "02:34:18", "text": "等等，这个高级会员是什么？"}, {"type": "subtitle", "time": 9261.11, "timestamp": "02:34:21", "text": "哇。是的。哇。爸爸，你是怎么到这儿的？"}, {"type": "subtitle", "time": 9262.95, "timestamp": "02:34:22", "text": "这些东西？"}, {"type": "subtitle", "time": 9264.389, "timestamp": "02:34:24", "text": "让我们来看看。他们会得到额外报酬吗？"}, {"type": "subtitle", "time": 9267.83, "timestamp": "02:34:27", "text": "为了这？呃，不。我认为这更"}, {"type": "subtitle", "time": 9271.03, "timestamp": "02:34:31", "text": "他们非常欣赏它，并取得了很高的成功率。"}, {"type": "subtitle", "time": 9274.55, "timestamp": "02:34:34", "text": "嗯，还有很多。所以，我当时"}, {"type": "subtitle", "time": 9276.55, "timestamp": "02:34:36", "text": "认为我们可以提供那种服务。"}, {"type": "subtitle", "time": 9278.71, "timestamp": "02:34:38", "text": "或许可以，或者我觉得我们可以。"}, {"type": "subtitle", "time": 9280.469, "timestamp": "02:34:40", "text": "这或许能帮助我们获得更高的价格。"}, {"type": "subtitle", "time": 9282.99, "timestamp": "02:34:42", "text": "出色地。好的。我打算继续"}, {"type": "subtitle", "time": 9284.91, "timestamp": "02:34:44", "text": "全部"}, {"type": "subtitle", "time": 9288.51, "timestamp": "02:34:48", "text": "他们。是时候了吗？"}, {"type": "subtitle", "time": 9291.349, "timestamp": "02:34:51", "text": "然而？还有4个小时。"}, {"type": "subtitle", "time": 9295.67, "timestamp": "02:34:55", "text": "我会去奥斯汀卖东西"}, {"type": "subtitle", "time": 9299.51, "timestamp": "02:34:59", "text": "奥斯汀，那个便宜货。是的。好的。等待，"}]
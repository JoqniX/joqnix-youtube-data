[{"type": "subtitle", "time": 17640.23, "timestamp": "04:54:00", "text": "是的。这里待处理，你在这里吗？你"}, {"type": "subtitle", "time": 17641.75, "timestamp": "04:54:01", "text": "可以用灵盒听他说话，但是"}, {"type": "subtitle", "time": 17643.99, "timestamp": "04:54:03", "text": "你可以用类似他名字的称呼来称呼他。"}, {"type": "subtitle", "time": 17645.75, "timestamp": "04:54:05", "text": "任何人都可以给他打电话，但为了听到"}, {"type": "subtitle", "time": 17654.31, "timestamp": "04:54:14", "text": "哦，我开的灯太多了，我"}, {"type": "subtitle", "time": 17656.708, "timestamp": "04:54:16", "text": "猜测。等等，这里有多少盏灯？"}, {"type": "subtitle", "time": 17660.47, "timestamp": "04:54:20", "text": "那玩意儿？我没数。对不起。"}, {"type": "subtitle", "time": 17661.47, "timestamp": "04:54:21", "text": "这是一个"}, {"type": "subtitle", "time": 17665.708, "timestamp": "04:54:25", "text": "车。所以，我应该关掉"}, {"type": "subtitle", "time": 17669.35, "timestamp": "04:54:29", "text": "呃，这个。不要打开大门"}, {"type": "subtitle", "time": 17672.59, "timestamp": "04:54:32", "text": "出口处的灯光。好的。"}, {"type": "subtitle", "time": 17676.55, "timestamp": "04:54:36", "text": "呃，你可以把剩下的都关掉。"}, {"type": "subtitle", "time": 17693.83, "timestamp": "04:54:53", "text": "碰撞？哦，我真的需要升级内存了。"}, {"type": "subtitle", "time": 17696.23, "timestamp": "04:54:56", "text": "兄弟，我打算升级一下内存。"}, {"type": "subtitle", "time": 17698.83, "timestamp": "04:54:58", "text": "销售款项到账了。"}]
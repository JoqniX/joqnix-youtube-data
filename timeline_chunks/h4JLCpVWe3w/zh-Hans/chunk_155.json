[{"type": "subtitle", "time": 9302.83, "timestamp": "02:35:02", "text": "这里不是有滑板吗？"}, {"type": "subtitle", "time": 9311.59, "timestamp": "02:35:11", "text": "它。好的，今晚有三场。我们有"}, {"type": "subtitle", "time": 9314.59, "timestamp": "02:35:14", "text": "生孩子"}, {"type": "subtitle", "time": 9317.59, "timestamp": "02:35:17", "text": "今晚。住口。"}, {"type": "subtitle", "time": 9318.349, "timestamp": "02:35:18", "text": "关闭"}, {"type": "subtitle", "time": 9319.99, "timestamp": "02:35:19", "text": "向上。"}, {"type": "subtitle", "time": 9326.91, "timestamp": "02:35:26", "text": "我的天，还有两个。圣"}, {"type": "subtitle", "time": 9328.99, "timestamp": "02:35:28", "text": "拉屎。"}, {"type": "subtitle", "time": 9331.309, "timestamp": "02:35:31", "text": "呃，"}, {"type": "subtitle", "time": 9334.79, "timestamp": "02:35:34", "text": "交易。我们够用吗？"}, {"type": "subtitle", "time": 9337.11, "timestamp": "02:35:37", "text": "呃，我有三个。你有多少？"}, {"type": "subtitle", "time": 9339.27, "timestamp": "02:35:39", "text": "你有多少个？我有五个，"}, {"type": "subtitle", "time": 9341.349, "timestamp": "02:35:41", "text": "八个，还有八个。我认为我们会"}, {"type": "subtitle", "time": 9343.91, "timestamp": "02:35:43", "text": "够了。哦，是的。没关系。"}, {"type": "subtitle", "time": 9347.19, "timestamp": "02:35:47", "text": "我们今晚就做。好的。我要去"}, {"type": "subtitle", "time": 9348.87, "timestamp": "02:35:48", "text": "把其中一些放进下一个"}, {"type": "subtitle", "time": 9351.91, "timestamp": "02:35:51", "text": "下午，这样我们就有足够的时间。"}, {"type": "subtitle", "time": 9355.03, "timestamp": "02:35:55", "text": "是的。不，最好在深夜做。我知道，"}, {"type": "subtitle", "time": 9357.59, "timestamp": "02:35:57", "text": "但我们肯定不够。"}]
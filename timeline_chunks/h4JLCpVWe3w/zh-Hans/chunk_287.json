[{"type": "subtitle", "time": 17220.59, "timestamp": "04:47:00", "text": "格拉夫顿农舍就在那里"}, {"type": "subtitle", "time": 17223.43, "timestamp": "04:47:03", "text": "这是布利兹代尔农舍。哪一个"}, {"type": "subtitle", "time": 17227.11, "timestamp": "04:47:07", "text": "你想要？我们可以去格拉夫顿。"}, {"type": "subtitle", "time": 17228.31, "timestamp": "04:47:08", "text": "等待。"}, {"type": "subtitle", "time": 17231.11, "timestamp": "04:47:11", "text": "你能选到它吗？哦，我想"}, {"type": "subtitle", "time": 17233.91, "timestamp": "04:47:13", "text": "你可以。哦，真好，真好，真好。你可以吗"}, {"type": "subtitle", "time": 17237.35, "timestamp": "04:47:17", "text": "选择？哦，我可以准备一下。是的。是的。"}, {"type": "subtitle", "time": 17241.67, "timestamp": "04:47:21", "text": "没关系。我打算买些东西。"}, {"type": "subtitle", "time": 17244.31, "timestamp": "04:47:24", "text": "你如何购买东西？点击加号，"}, {"type": "subtitle", "time": 17248.47, "timestamp": "04:47:28", "text": "正确的？是的。点击加号。所以，我们需要一个"}, {"type": "subtitle", "time": 17250.43, "timestamp": "04:47:30", "text": "我要一根蜡烛。一个"}, {"type": "subtitle", "time": 17257.31, "timestamp": "04:47:37", "text": "我不需要任何温度计或"}, {"type": "subtitle", "time": 17260.07, "timestamp": "04:47:40", "text": "任何事物。手电筒。我还要一个"}, {"type": "subtitle", "time": 17263.67, "timestamp": "04:47:43", "text": "我们俩都用手电筒。"}, {"type": "subtitle", "time": 17268.43, "timestamp": "04:47:48", "text": "呃，我要盐。患病的"}, {"type": "subtitle", "time": 17271.67, "timestamp": "04:47:51", "text": "买。好的。我们该做好准备吗？"}, {"type": "subtitle", "time": 17273.59, "timestamp": "04:47:53", "text": "是的。是的。"}, {"type": "subtitle", "time": 17276.628, "timestamp": "04:47:56", "text": "我买了盐。"}]
[{"type": "subtitle", "time": 8223.669, "timestamp": "02:17:03", "text": "我们该如何清除污渍？"}, {"type": "subtitle", "time": 8229.03, "timestamp": "02:17:09", "text": "好的。总有一天我们会买一辆新的"}, {"type": "subtitle", "time": 8231.83, "timestamp": "02:17:11", "text": "房子，伙计们。我保证。"}, {"type": "subtitle", "time": 8235.669, "timestamp": "02:17:15", "text": "我来收拾一下。"}, {"type": "subtitle", "time": 8238.389, "timestamp": "02:17:18", "text": "请前往包装站。"}, {"type": "subtitle", "time": 8241.469, "timestamp": "02:17:21", "text": "什么？包装。"}, {"type": "subtitle", "time": 8244.629, "timestamp": "02:17:24", "text": "等等，你是什么时候收割的大麻？"}, {"type": "subtitle", "time": 8253.75, "timestamp": "02:17:33", "text": "那样你会死的。等等，我该如何检查？"}, {"type": "subtitle", "time": 8266.389, "timestamp": "02:17:46", "text": "好的。一切。"}, {"type": "subtitle", "time": 8268.709, "timestamp": "02:17:48", "text": "哦，对于包装，你可以右键单击"}, {"type": "subtitle", "time": 8274.23, "timestamp": "02:17:54", "text": "呃，堆放在家里。等等，我会来见你。"}, {"type": "subtitle", "time": 8277.589, "timestamp": "02:17:57", "text": "三个表示“好的，我会在旁边等你”。"}]
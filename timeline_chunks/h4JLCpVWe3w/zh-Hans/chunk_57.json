[{"type": "subtitle", "time": 3420.23, "timestamp": "00:57:00", "text": "哦，TK。是的。是的。等等，呃……"}, {"type": "subtitle", "time": 3424.23, "timestamp": "00:57:04", "text": "独行升级结局。什么鬼？"}, {"type": "subtitle", "time": 3426.309, "timestamp": "00:57:06", "text": "EK今年做了很多事。"}, {"type": "subtitle", "time": 3429.43, "timestamp": "00:57:09", "text": "他做了我心目中的英雄OP。搞什么鬼？他确实"}, {"type": "subtitle", "time": 3433.87, "timestamp": "00:57:13", "text": "我的英雄。是的。是的。是的。"}, {"type": "subtitle", "time": 3436.75, "timestamp": "00:57:16", "text": "正确的。"}, {"type": "subtitle", "time": 3439.67, "timestamp": "00:57:19", "text": "什么？我不知道。所以，我认为他"}, {"type": "subtitle", "time": 3442.309, "timestamp": "00:57:22", "text": "还在其他地方做过一个动画片头曲？"}, {"type": "subtitle", "time": 3445.19, "timestamp": "00:57:25", "text": "就像我不知道的那首歌一样。 DK"}, {"type": "subtitle", "time": 3446.789, "timestamp": "00:57:26", "text": "看起来像个只会为了这种事而干这事的人"}, {"type": "subtitle", "time": 3450.71, "timestamp": "00:57:30", "text": "一些哥特或者emo之类的玩意儿。单人"}, {"type": "subtitle", "time": 3452.87, "timestamp": "00:57:32", "text": "等级设定是合理的。我的英雄是"}, {"type": "subtitle", "time": 3454.51, "timestamp": "00:57:34", "text": "经历它的哥特式"}, {"type": "subtitle", "time": 3457.43, "timestamp": "00:57:37", "text": "阶段。什么？"}, {"type": "subtitle", "time": 3460.71, "timestamp": "00:57:40", "text": "我的天啊。"}]
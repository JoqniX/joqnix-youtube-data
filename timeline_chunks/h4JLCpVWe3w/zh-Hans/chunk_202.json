[{"type": "subtitle", "time": 12120.07, "timestamp": "03:22:00", "text": "那是坨屎。但她究竟是怎么做到的？"}, {"type": "subtitle", "time": 12123.51, "timestamp": "03:22:03", "text": "在这间狭小的厕所里拉屎？"}, {"type": "subtitle", "time": 12126.87, "timestamp": "03:22:06", "text": "索菲，宝贝，你是不是在这里拉屎了？"}, {"type": "subtitle", "time": 12128.95, "timestamp": "03:22:08", "text": "然后，再看看这扇门。"}, {"type": "subtitle", "time": 12130.95, "timestamp": "03:22:10", "text": "这就是你打开的地方。"}, {"type": "subtitle", "time": 12132.469, "timestamp": "03:22:12", "text": "然后她就说：“哦，我要拿走。”"}, {"type": "subtitle", "time": 12135.99, "timestamp": "03:22:15", "text": "一坨屎。对不起。"}, {"type": "subtitle", "time": 12139.269, "timestamp": "03:22:19", "text": "苏菲，你在吗？这这这"}, {"type": "subtitle", "time": 12140.349, "timestamp": "03:22:20", "text": "字面上地"}, {"type": "subtitle", "time": 12143.269, "timestamp": "03:22:23", "text": "这让我很生气。苏菲，是你吗？"}, {"type": "subtitle", "time": 12148.469, "timestamp": "03:22:28", "text": "这里？她是如何阅读烹饪专业的？"}, {"type": "subtitle", "time": 12162.55, "timestamp": "03:22:42", "text": "再见，"}, {"type": "subtitle", "time": 12166.309, "timestamp": "03:22:46", "text": "苏菲。你好，Eizent。你好吗，"}, {"type": "subtitle", "time": 12169.51, "timestamp": "03:22:49", "text": "苏菲？发布新专辑。索菲，"}, {"type": "subtitle", "time": 12179.59, "timestamp": "03:22:59", "text": "离开。索菲亚。"}]
[{"type": "subtitle", "time": 10020.71, "timestamp": "02:47:00", "text": "毒品。好的，我去看看其他人。"}, {"type": "subtitle", "time": 10023.59, "timestamp": "02:47:03", "text": "你认为我永远也得不到那种药吗？"}, {"type": "subtitle", "time": 10027.71, "timestamp": "02:47:07", "text": "儿子，你永远也搞不到毒品。"}, {"type": "subtitle", "time": 10032.19, "timestamp": "02:47:12", "text": "哦，你是我的爸爸。"}, {"type": "subtitle", "time": 10036.55, "timestamp": "02:47:16", "text": "我会"}, {"type": "subtitle", "time": 10040.15, "timestamp": "02:47:20", "text": "砸碎这颗坚果。"}, {"type": "subtitle", "time": 10043.59, "timestamp": "02:47:23", "text": "呃，还有，赫克托也打电话来了。"}, {"type": "subtitle", "time": 10055.59, "timestamp": "02:47:35", "text": "呃，我的天哪。四乘以 90。太棒了。"}, {"type": "subtitle", "time": 10058.63, "timestamp": "02:47:38", "text": "晚安，宝贝女儿。彼得档案。彼得"}, {"type": "subtitle", "time": 10060.75, "timestamp": "02:47:40", "text": "文件。搞什么鬼？"}, {"type": "subtitle", "time": 10064.11, "timestamp": "02:47:44", "text": "什么？伟大的。我会在……与你见面"}, {"type": "subtitle", "time": 10068.309, "timestamp": "02:47:48", "text": "我什么都没做。我没能得到"}, {"type": "subtitle", "time": 10070.429, "timestamp": "02:47:50", "text": "他。我们开始吧"}, {"type": "subtitle", "time": 10072.71, "timestamp": "02:47:52", "text": "讲话。已经建立了一个不错的行动基地。"}, {"type": "subtitle", "time": 10074.23, "timestamp": "02:47:54", "text": "以及不断增长的客户群体。他会是"}, {"type": "subtitle", "time": 10075.83, "timestamp": "02:47:55", "text": "现在确实赚到了一些不错的收入，但是"}, {"type": "subtitle", "time": 10077.87, "timestamp": "02:47:57", "text": "他需要协助管理所有……"}, {"type": "subtitle", "time": 10079.91, "timestamp": "02:47:59", "text": "顾客。考虑一下招聘事宜"}]
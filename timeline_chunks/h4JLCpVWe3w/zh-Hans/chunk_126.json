[{"type": "subtitle", "time": 7560.99, "timestamp": "02:06:00", "text": "收成"}, {"type": "subtitle", "time": 7566.709, "timestamp": "02:06:06", "text": "包装上写着某个名字或药品。"}, {"type": "subtitle", "time": 7569.43, "timestamp": "02:06:09", "text": "哦，是的。"}, {"type": "subtitle", "time": 7575.83, "timestamp": "02:06:15", "text": "哦，原来是给药物命名啊。我觉得你"}, {"type": "subtitle", "time": 7578.47, "timestamp": "02:06:18", "text": "就像你开始混合药物一样"}, {"type": "subtitle", "time": 7580.31, "timestamp": "02:06:20", "text": "然后开始明白，哦，你可以命名"}, {"type": "subtitle", "time": 7582.95, "timestamp": "02:06:22", "text": "随机化。直接逃脱重来就行了"}, {"type": "subtitle", "time": 7585.91, "timestamp": "02:06:25", "text": "再次。好的。呃，我要去……"}, {"type": "subtitle", "time": 7589.99, "timestamp": "02:06:29", "text": "再挖一些土。等待。好的。我需要"}, {"type": "subtitle", "time": 7593.189, "timestamp": "02:06:33", "text": "我认为在手机上你可以重命名你的"}, {"type": "subtitle", "time": 7594.87, "timestamp": "02:06:34", "text": "产品。"}, {"type": "subtitle", "time": 7597.43, "timestamp": "02:06:37", "text": "你可以。没关系。好的。不，哦，不。"}, {"type": "subtitle", "time": 7599.51, "timestamp": "02:06:39", "text": "走了。"}, {"type": "subtitle", "time": 7601.43, "timestamp": "02:06:41", "text": "没关系。我们可能需要混合一些"}, {"type": "subtitle", "time": 7609.47, "timestamp": "02:06:49", "text": "就是这样，伙计们。我玩这个游戏太厉害了。它是"}, {"type": "subtitle", "time": 7611.35, "timestamp": "02:06:51", "text": "太可怕了。我不知道我要去哪里"}, {"type": "subtitle", "time": 7612.43, "timestamp": "02:06:52", "text": "到"}, {"type": "subtitle", "time": 7617.189, "timestamp": "02:06:57", "text": "做。好的。狠狠地掏空某人的口袋。贱人。"}]
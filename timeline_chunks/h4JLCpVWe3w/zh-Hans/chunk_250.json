[{"type": "subtitle", "time": 15000.63, "timestamp": "04:10:00", "text": "无活动。零。你可以成为你可以成为"}, {"type": "subtitle", "time": 15003.349, "timestamp": "04:10:03", "text": "冷静的。无活动。哦，对了，点击"}, {"type": "subtitle", "time": 15006.71, "timestamp": "04:10:06", "text": "汽车。点击汽车。这辆车"}, {"type": "subtitle", "time": 15011.75, "timestamp": "04:10:11", "text": "你身后。是的。呃，就像……不，只是"}, {"type": "subtitle", "time": 15014.389, "timestamp": "04:10:14", "text": "用鼠标点击它。是吗？"}, {"type": "subtitle", "time": 15018.469, "timestamp": "04:10:18", "text": "发出声音？不。啊，好的。没关系。"}, {"type": "subtitle", "time": 15019.91, "timestamp": "04:10:19", "text": "因为上次我们这么做的时候，车子……"}, {"type": "subtitle", "time": 15021.67, "timestamp": "04:10:21", "text": "他发出声音，然后就被吸引住了。"}, {"type": "subtitle", "time": 15031.189, "timestamp": "04:10:31", "text": "如果可以的话，试着扔东西。我"}, {"type": "subtitle", "time": 15032.87, "timestamp": "04:10:32", "text": "不知道该怎么做。只有米奇"}, {"type": "subtitle", "time": 15034.309, "timestamp": "04:10:34", "text": "知道。这就是我请他……的原因"}, {"type": "subtitle", "time": 15036.07, "timestamp": "04:10:36", "text": "停止并绕圈。"}, {"type": "subtitle", "time": 15038.71, "timestamp": "04:10:38", "text": "他是怎么做到的？"}, {"type": "subtitle", "time": 15040.79, "timestamp": "04:10:40", "text": "按 E 键。"}, {"type": "subtitle", "time": 15044.15, "timestamp": "04:10:44", "text": "按下 E 键没有用。"}, {"type": "subtitle", "time": 15048.79, "timestamp": "04:10:48", "text": "呃，去杯子那里。按下 E. E，无反应"}, {"type": "subtitle", "time": 15051.67, "timestamp": "04:10:51", "text": "事情发生了。好的。"}, {"type": "subtitle", "time": 15054.63, "timestamp": "04:10:54", "text": "他是怎么做到的？"}, {"type": "subtitle", "time": 15058.11, "timestamp": "04:10:58", "text": "再去那个大厅，试试 E。"}]
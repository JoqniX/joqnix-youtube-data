[{"type": "subtitle", "time": 9540.15, "timestamp": "02:39:00", "text": "在银行的顶层。这是吗？哦，这是"}, {"type": "subtitle", "time": 9542.15, "timestamp": "02:39:02", "text": "奥斯汀。是的。"}, {"type": "subtitle", "time": 9544.309, "timestamp": "02:39:04", "text": "嘿，奥斯汀。你好吗？我的天啊。我"}, {"type": "subtitle", "time": 9547.75, "timestamp": "02:39:07", "text": "已经到达很远的地方了。"}, {"type": "subtitle", "time": 9550.15, "timestamp": "02:39:10", "text": "我到达了加油站。他一直"}, {"type": "subtitle", "time": 9552.389, "timestamp": "02:39:12", "text": "等待。买到了质量较差的那款。"}, {"type": "subtitle", "time": 9558.03, "timestamp": "02:39:18", "text": "你。好了。干杯。是的，"}, {"type": "subtitle", "time": 9559.83, "timestamp": "02:39:19", "text": "任何。好的，我们去……"}, {"type": "subtitle", "time": 9566.07, "timestamp": "02:39:26", "text": "我喜欢这里有尸体，还有你。"}, {"type": "subtitle", "time": 9569.83, "timestamp": "02:39:29", "text": "我知道它一直都是那样做的。"}, {"type": "subtitle", "time": 9572.23, "timestamp": "02:39:32", "text": "为什么？就像有尸体一样。我得到了"}, {"type": "subtitle", "time": 9578.71, "timestamp": "02:39:38", "text": "我们拿到钱了。血卫，你需要"}, {"type": "subtitle", "time": 9590.349, "timestamp": "02:39:50", "text": "关掉。等待。"}, {"type": "subtitle", "time": 9592.309, "timestamp": "02:39:52", "text": "对不起。好的。好的，我明白了。"}, {"type": "subtitle", "time": 9595.11, "timestamp": "02:39:55", "text": "毒品卷土重来。我也想卖一些。"}, {"type": "subtitle", "time": 9598.15, "timestamp": "02:39:58", "text": "但身体健康。"}]
[{"type": "subtitle", "time": 7680.149, "timestamp": "02:08:00", "text": "去那里？他可能是顾客。"}, {"type": "subtitle", "time": 7687.35, "timestamp": "02:08:07", "text": "蝙蝠。哦，你可以把它给唐娜。"}, {"type": "subtitle", "time": 7690.47, "timestamp": "02:08:10", "text": "办公室里有甜甜圈。唐娜喜欢毒品"}, {"type": "subtitle", "time": 7692.95, "timestamp": "02:08:12", "text": "也一样。是的，但她需要主动提出要求。"}, {"type": "subtitle", "time": 7694.79, "timestamp": "02:08:14", "text": "确实如此，对吧？哦，不。你给予"}, {"type": "subtitle", "time": 7697.189, "timestamp": "02:08:17", "text": "免费样品。是的，我送了免费样品。"}, {"type": "subtitle", "time": 7699.43, "timestamp": "02:08:19", "text": "前。"}, {"type": "subtitle", "time": 7702.31, "timestamp": "02:08:22", "text": "哦，杰西来了。哦，嗨，杰西。"}, {"type": "subtitle", "time": 7705.669, "timestamp": "02:08:25", "text": "杰西？杰西？哦，那是另一种情况。"}, {"type": "subtitle", "time": 7707.669, "timestamp": "02:08:27", "text": "有点像杰西。"}, {"type": "subtitle", "time": 7711.91, "timestamp": "02:08:31", "text": "什么？哦，这正是我喜欢的那种杰西。哇。"}, {"type": "subtitle", "time": 7713.43, "timestamp": "02:08:33", "text": "哇。哇。哇。你会有吗？"}, {"type": "subtitle", "time": 7715.669, "timestamp": "02:08:35", "text": "毒品？哦，等等。你有她吗？"}, {"type": "subtitle", "time": 7718.709, "timestamp": "02:08:38", "text": "你们都不跟我说话。她会说：嘿，"}, {"type": "subtitle", "time": 7721.43, "timestamp": "02:08:41", "text": "嘿。哦，她看到了那东西，她当时"}, {"type": "subtitle", "time": 7724.79, "timestamp": "02:08:44", "text": "比如，“好的，给我。”"}, {"type": "subtitle", "time": 7728.229, "timestamp": "02:08:48", "text": "嘿，杰西。那玩意儿。你是做什么的？"}, {"type": "subtitle", "time": 7731.75, "timestamp": "02:08:51", "text": "回来。不。嘿。嘿。嘿。嘿，"}, {"type": "subtitle", "time": 7732.83, "timestamp": "02:08:52", "text": "伙伴。伙伴。"}, {"type": "subtitle", "time": 7737.03, "timestamp": "02:08:57", "text": "伙伴。市中心区域一定是兄弟。"}, {"type": "subtitle", "time": 7739.99, "timestamp": "02:08:59", "text": "是的。一些NPC。你必须解锁"}]
[{"type": "subtitle", "time": 16440.31, "timestamp": "04:34:00", "text": "好的。她上楼了。"}, {"type": "subtitle", "time": 16443.109, "timestamp": "04:34:03", "text": "我猜这是 Obo。就像这是 OBO 一样。"}, {"type": "subtitle", "time": 16445.67, "timestamp": "04:34:05", "text": "确切地。"}, {"type": "subtitle", "time": 16453.189, "timestamp": "04:34:13", "text": "不要杀我。 Obo，别杀我。我"}, {"type": "subtitle", "time": 16457.189, "timestamp": "04:34:17", "text": "再说一遍。请不要"}, {"type": "subtitle", "time": 16460.23, "timestamp": "04:34:20", "text": "某种程度上来说。我有点"}, {"type": "subtitle", "time": 16462.07, "timestamp": "04:34:22", "text": "爱德华，你最近怎么样？怎样"}, {"type": "subtitle", "time": 16465.75, "timestamp": "04:34:25", "text": "你？好久不见。他又再生了。"}, {"type": "subtitle", "time": 16468.869, "timestamp": "04:34:28", "text": "你说她又生了？"}, {"type": "subtitle", "time": 16471.51, "timestamp": "04:34:31", "text": "我的天啊。她只是在做她只是"}, {"type": "subtitle", "time": 16473.429, "timestamp": "04:34:33", "text": "像《龙珠Z》里那样瞬间移动"}, {"type": "subtitle", "time": 16476.07, "timestamp": "04:34:36", "text": "事物。我希望，我希望他们能像真的一样。"}, {"type": "subtitle", "time": 16480.31, "timestamp": "04:34:40", "text": "幽灵模型，但这种方法也行得通。"}, {"type": "subtitle", "time": 16483.551, "timestamp": "04:34:43", "text": "她在这里吗？"}, {"type": "subtitle", "time": 16486.39, "timestamp": "04:34:46", "text": "她哦，她又出现在你身后了。她"}, {"type": "subtitle", "time": 16488.789, "timestamp": "04:34:48", "text": "出现在你身后的桌子上。"}, {"type": "subtitle", "time": 16491.109, "timestamp": "04:34:51", "text": "在后面。好的。是的。是的，她在那里。"}, {"type": "subtitle", "time": 16492.39, "timestamp": "04:34:52", "text": "在那里诞生。我不知道她在哪里。"}, {"type": "subtitle", "time": 16494.59, "timestamp": "04:34:54", "text": "去了。"}, {"type": "subtitle", "time": 16497.109, "timestamp": "04:34:57", "text": "什么？某种程度上，我希望你喜欢"}, {"type": "subtitle", "time": 16499.349, "timestamp": "04:34:59", "text": "她上去的时候，对吧？我以为我"}]
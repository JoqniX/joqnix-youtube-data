[{"type": "subtitle", "time": 5580.87, "timestamp": "01:33:00", "text": "婴儿。等等，我们可以选吗？不。市中心"}, {"type": "subtitle", "time": 5584.41, "timestamp": "01:33:04", "text": "必须解锁该区域。滚开。"}, {"type": "subtitle", "time": 5591.669, "timestamp": "01:33:11", "text": "看来我们的货用完了。好的。记忆"}, {"type": "subtitle", "time": 5594.629, "timestamp": "01:33:14", "text": "等等，每个人都必须……"}, {"type": "subtitle", "time": 5599.189, "timestamp": "01:33:19", "text": "接受吗？不，只有你一个人。哦，"}, {"type": "subtitle", "time": 5603.189, "timestamp": "01:33:23", "text": "看来我也得这么做。"}, {"type": "subtitle", "time": 5606.39, "timestamp": "01:33:26", "text": "你可以在藏匿处或市政厅找到它。"}, {"type": "subtitle", "time": 5611.51, "timestamp": "01:33:31", "text": "哦，是警察。警察。警察殉职。"}, {"type": "subtitle", "time": 5619.51, "timestamp": "01:33:39", "text": "这是谁？"}, {"type": "subtitle", "time": 5621.11, "timestamp": "01:33:41", "text": "哦，等等。伙计们，我也不知道。我"}, {"type": "subtitle", "time": 5623.43, "timestamp": "01:33:43", "text": "我觉得她想加入我们。你是"}, {"type": "subtitle", "time": 5625.27, "timestamp": "01:33:45", "text": "跟我们一起去。你。我们没有"}, {"type": "subtitle", "time": 5626.87, "timestamp": "01:33:46", "text": "机会。"}, {"type": "subtitle", "time": 5629.59, "timestamp": "01:33:49", "text": "伙计们，咱们去喷泉那儿吧。钱"}, {"type": "subtitle", "time": 5632.55, "timestamp": "01:33:52", "text": "藏在那儿。纳尔逊。纳尔逊叔叔说"}, {"type": "subtitle", "time": 5635.35, "timestamp": "01:33:55", "text": "我。所以，那是什么？是水烟筒吗？"}, {"type": "subtitle", "time": 5638.55, "timestamp": "01:33:58", "text": "哦，是的。小"}]
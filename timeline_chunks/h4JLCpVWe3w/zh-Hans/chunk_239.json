[{"type": "subtitle", "time": 14342.229, "timestamp": "03:59:02", "text": "是的。哦，等等。我们什么也没买。我"}, {"type": "subtitle", "time": 14350.83, "timestamp": "03:59:10", "text": "美好的。我刚才尖叫得好厉害。哦，我的"}, {"type": "subtitle", "time": 14382.55, "timestamp": "03:59:42", "text": "哇，就像某种冰冻的东西即将到来"}, {"type": "subtitle", "time": 14385.03, "timestamp": "03:59:45", "text": "从他嘴里说出来。好的。好的。就是这样。"}, {"type": "subtitle", "time": 14387.349, "timestamp": "03:59:47", "text": "当你预感到鬼魂即将到来时"}, {"type": "subtitle", "time": 14391.59, "timestamp": "03:59:51", "text": "追捕你。哦好的。好的。是的。我"}, {"type": "subtitle", "time": 14393.67, "timestamp": "03:59:53", "text": "我刚刚才意识到你被静音了。"}, {"type": "subtitle", "time": 14395.99, "timestamp": "03:59:55", "text": "溪流。我的天啊。好的，我已经解除你的静音了。"}, {"type": "subtitle", "time": 14398.63, "timestamp": "03:59:58", "text": "感谢上帝。对那些人的回应"}]
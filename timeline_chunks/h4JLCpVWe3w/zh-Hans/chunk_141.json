[{"type": "subtitle", "time": 8465.83, "timestamp": "02:21:05", "text": "呃，她多少钱？三。在那里"}, {"type": "subtitle", "time": 8469.79, "timestamp": "02:21:09", "text": "去。好了。好了，就是这样。"}, {"type": "subtitle", "time": 8478.11, "timestamp": "02:21:18", "text": "亲爱的"}, {"type": "subtitle", "time": 8481.99, "timestamp": "02:21:21", "text": "没关系。呃，你在哪里？"}, {"type": "subtitle", "time": 8484.389, "timestamp": "02:21:24", "text": "我正在促成交易。好的，我会"}, {"type": "subtitle", "time": 8506.07, "timestamp": "02:21:46", "text": "我应该这么做。"}, {"type": "subtitle", "time": 8510.75, "timestamp": "02:21:50", "text": "我之前不知道我竟然真的得到了它"}, {"type": "subtitle", "time": 8514.15, "timestamp": "02:21:54", "text": "外汇盗窃。你说要省钱。"}]
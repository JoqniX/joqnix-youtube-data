[{"type": "subtitle", "time": 13864.71, "timestamp": "03:51:04", "text": "我就要这个东西。"}, {"type": "subtitle", "time": 13877.189, "timestamp": "03:51:17", "text": "等等，我们没看到它到底在哪儿。"}, {"type": "subtitle", "time": 13878.469, "timestamp": "03:51:18", "text": "沙发。我们没看到那玩意儿在哪儿"}, {"type": "subtitle", "time": 13881.03, "timestamp": "03:51:21", "text": "我们需要把它打开。"}, {"type": "subtitle", "time": 13882.59, "timestamp": "03:51:22", "text": "对，就是这个"}, {"type": "subtitle", "time": 13889.99, "timestamp": "03:51:29", "text": "请把它填入表格中。哦，冰冻"}, {"type": "subtitle", "time": 13892.16, "timestamp": "03:51:32", "text": "温度。冰点温度他要去打猎。"}, {"type": "subtitle", "time": 13902.15, "timestamp": "03:51:42", "text": "他妈的。那家伙要去……那家伙是"}, {"type": "subtitle", "time": 13903.51, "timestamp": "03:51:43", "text": "准备去打猎。他将要"}, {"type": "subtitle", "time": 13906.63, "timestamp": "03:51:46", "text": "开始狩猎。"}, {"type": "subtitle", "time": 13912.309, "timestamp": "03:51:52", "text": "利用蓝光寻找"}]
[{"type": "subtitle", "time": 14822.07, "timestamp": "04:07:02", "text": "独自一人时，你会像你独自一人时一样，他会"}, {"type": "subtitle", "time": 14824.11, "timestamp": "04:07:04", "text": "回答你。好的。"}, {"type": "subtitle", "time": 14827.67, "timestamp": "04:07:07", "text": "好的。露丝，你好吗？你在这里"}, {"type": "subtitle", "time": 14830.469, "timestamp": "04:07:10", "text": "你在听我说话吗？你能听到我吗？问"}, {"type": "subtitle", "time": 14832.79, "timestamp": "04:07:12", "text": "他，你在吗？给我们一个信号。是"}, {"type": "subtitle", "time": 14835.67, "timestamp": "04:07:15", "text": "你在这里？露丝，请给我们一个信号。"}, {"type": "subtitle", "time": 14838.75, "timestamp": "04:07:18", "text": "你在这里？你是"}, {"type": "subtitle", "time": 14842.07, "timestamp": "04:07:22", "text": "这里？我，我，我会去。你在这里，"}, {"type": "subtitle", "time": 14845.03, "timestamp": "04:07:25", "text": "露丝？露丝，你在哪里？"}, {"type": "subtitle", "time": 14846.269, "timestamp": "04:07:26", "text": "哦，"}, {"type": "subtitle", "time": 14849.429, "timestamp": "04:07:29", "text": "离开。我的天啊。是的。是的。是的。超过"}, {"type": "subtitle", "time": 14851.269, "timestamp": "04:07:31", "text": "这里。在哪里？这边。好的。等待。我是"}, {"type": "subtitle", "time": 14853.269, "timestamp": "04:07:33", "text": "未来。点击照片。记住，"}, {"type": "subtitle", "time": 14854.71, "timestamp": "04:07:34", "text": "每当他来的时候，每当你看到"}, {"type": "subtitle", "time": 14856.87, "timestamp": "04:07:36", "text": "灯光，按下快门。我想和……谈谈"}, {"type": "subtitle", "time": 14859.03, "timestamp": "04:07:39", "text": "你。"}, {"type": "subtitle", "time": 14861.83, "timestamp": "04:07:41", "text": "来。请他出来。出来。"}, {"type": "subtitle", "time": 14866.229, "timestamp": "04:07:46", "text": "展现你自己。你能露面吗？"}, {"type": "subtitle", "time": 14868.55, "timestamp": "04:07:48", "text": "好的。记住要迅速转身"}, {"type": "subtitle", "time": 14871.11, "timestamp": "04:07:51", "text": "相机关机了。嗯？每当提到这件事的时候。我"}, {"type": "subtitle", "time": 14873.67, "timestamp": "04:07:53", "text": "我觉得我得把我的手电筒扔掉了。所以"}, {"type": "subtitle", "time": 14875.75, "timestamp": "04:07:55", "text": "当我滚动鼠标滚轮时，它会跳转到"}, {"type": "subtitle", "time": 14879.03, "timestamp": "04:07:59", "text": "火炬。呃，手电筒。那么你很可能会"}]
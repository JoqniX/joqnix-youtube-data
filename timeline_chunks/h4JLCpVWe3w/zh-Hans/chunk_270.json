[{"type": "subtitle", "time": 16200.429, "timestamp": "04:30:00", "text": "不。好的。我不想要你"}, {"type": "subtitle", "time": 16203.99, "timestamp": "04:30:03", "text": "兄弟，我只是想拍到那张照片而已。"}, {"type": "subtitle", "time": 16212.309, "timestamp": "04:30:12", "text": "所以，你死的时候，看到冰冻了吗？"}, {"type": "subtitle", "time": 16214.07, "timestamp": "04:30:14", "text": "温度或其他什么？你看到那张嘴了吗？"}, {"type": "subtitle", "time": 16217.79, "timestamp": "04:30:17", "text": "你嘴里吐出来的东西？呃，不。"}, {"type": "subtitle", "time": 16221.67, "timestamp": "04:30:21", "text": "好的。呃，那么电磁场读数是多少？"}, {"type": "subtitle", "time": 16224.87, "timestamp": "04:30:24", "text": "哦，除非我死了，否则她不会死。"}, {"type": "subtitle", "time": 16226.55, "timestamp": "04:30:26", "text": "等等，她得爬到你尸体上才行。什么？"}, {"type": "subtitle", "time": 16228.469, "timestamp": "04:30:28", "text": "怪物？"}, {"type": "subtitle", "time": 16231.83, "timestamp": "04:30:31", "text": "是的。呃，她去过那里。"}, {"type": "subtitle", "time": 16234.59, "timestamp": "04:30:34", "text": "哦，AMF的喂料工作是做什么的？呃，它"}, {"type": "subtitle", "time": 16238.79, "timestamp": "04:30:38", "text": "是四、五。不，是三。三，四。"}, {"type": "subtitle", "time": 16242.67, "timestamp": "04:30:42", "text": "哦，她来了。好了，她离开了。"}, {"type": "subtitle", "time": 16246.149, "timestamp": "04:30:46", "text": "这他妈到底是怎么回事？她离开了"}, {"type": "subtitle", "time": 16249.75, "timestamp": "04:30:49", "text": "楼梯。好吧，她很可能名列前茅。"}, {"type": "subtitle", "time": 16251.03, "timestamp": "04:30:51", "text": "她想找到我，但她没找到。"}, {"type": "subtitle", "time": 16254.75, "timestamp": "04:30:54", "text": "我知道我被逼到了墙角。嘿，小子。嘿。"}, {"type": "subtitle", "time": 16257.67, "timestamp": "04:30:57", "text": "嘿。嘿，鬼魂。嘿，你知道……"}]
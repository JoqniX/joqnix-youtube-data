[{"type": "subtitle", "time": 14642.15, "timestamp": "04:04:02", "text": "期刊就像证据一样，我想……"}, {"type": "subtitle", "time": 14643.91, "timestamp": "04:04:03", "text": "它不会记录你正在升级。"}, {"type": "subtitle", "time": 14645.59, "timestamp": "04:04:05", "text": "向上或有点像或没有解锁更多"}, {"type": "subtitle", "time": 14650.07, "timestamp": "04:04:10", "text": "地图。哦好的。露丝·埃弗利，请给我们一个"}, {"type": "subtitle", "time": 14652.389, "timestamp": "04:04:12", "text": "符号。露丝·埃弗利，你在哪里？给"}, {"type": "subtitle", "time": 14655.429, "timestamp": "04:04:15", "text": "这是给我们的一个信号。哦，是的。你无法将我静音。"}, {"type": "subtitle", "time": 14657.99, "timestamp": "04:04:17", "text": "露丝，我正在你沙发上拉屎。"}, {"type": "subtitle", "time": 14667.91, "timestamp": "04:04:27", "text": "给我们一个信号。"}, {"type": "subtitle", "time": 14673.03, "timestamp": "04:04:33", "text": "这是你的猫吗？这是你的猫吗？这样的"}, {"type": "subtitle", "time": 14677.51, "timestamp": "04:04:37", "text": "一只愚蠢的猫，我要杀了你的猫，露丝。"}, {"type": "subtitle", "time": 14680.71, "timestamp": "04:04:40", "text": "杀死你的猫。是的，我会杀了你的猫。"}, {"type": "subtitle", "time": 14683.83, "timestamp": "04:04:43", "text": "哦。哦。"}, {"type": "subtitle", "time": 14685.75, "timestamp": "04:04:45", "text": "是你吗？"}, {"type": "subtitle", "time": 14687.59, "timestamp": "04:04:47", "text": "什么？我当时正在开门。你"}, {"type": "subtitle", "time": 14689.99, "timestamp": "04:04:49", "text": "开门？你哦，你打开了门。"}, {"type": "subtitle", "time": 14693.189, "timestamp": "04:04:53", "text": "好的。好的。是的。是的。露丝，我会杀了她"}, {"type": "subtitle", "time": 14695.349, "timestamp": "04:04:55", "text": "你的猫，因为我是唯一的强者"}, {"type": "subtitle", "time": 14698.309, "timestamp": "04:04:58", "text": "猫来了。露丝，是的，我才是最优秀的。"}]
[{"type": "subtitle", "time": 8648.389, "timestamp": "02:24:08", "text": "我爱杰西。她是我初恋。"}, {"type": "subtitle", "time": 8650.95, "timestamp": "02:24:10", "text": "我要杀了她。这就是我拥有的吗？"}, {"type": "subtitle", "time": 8652.95, "timestamp": "02:24:12", "text": "现在成为？她手里拿着的是什么？"}, {"type": "subtitle", "time": 8655.349, "timestamp": "02:24:15", "text": "保持？那是一个瓶子。碎瓶子"}, {"type": "subtitle", "time": 8663.67, "timestamp": "02:24:23", "text": "杰西，你他妈闭嘴。"}, {"type": "subtitle", "time": 8666.79, "timestamp": "02:24:26", "text": "杰西。你好。喝杯可乐。喝杯可乐。"}, {"type": "subtitle", "time": 8669.51, "timestamp": "02:24:29", "text": "喝杯可乐。走吧，杰西。出色地"}, {"type": "subtitle", "time": 8673.19, "timestamp": "02:24:33", "text": "直接把你扔进垃圾桶。"}, {"type": "subtitle", "time": 8675.309, "timestamp": "02:24:35", "text": "我很抱歉，"}, {"type": "subtitle", "time": 8683.75, "timestamp": "02:24:43", "text": "再见，杰西。好吧，让我喝点东西。"}, {"type": "subtitle", "time": 8693.19, "timestamp": "02:24:53", "text": "脸。哦，杰西。"}, {"type": "subtitle", "time": 8695.349, "timestamp": "02:24:55", "text": "给杰西2美元。她就是这么抠门。哦，"}, {"type": "subtitle", "time": 8698.15, "timestamp": "02:24:58", "text": "她已经不在人世了。"}]
[{"type": "subtitle", "time": 7920.35, "timestamp": "02:12:00", "text": "地狱？哦，我因此赚了22美元。圣"}, {"type": "subtitle", "time": 7925.669, "timestamp": "02:12:05", "text": "拉屎。等等，我可以把鲑鱼放进去。"}, {"type": "subtitle", "time": 7926.75, "timestamp": "02:12:06", "text": "什么？"}, {"type": "subtitle", "time": 7928.55, "timestamp": "02:12:08", "text": "地狱？"}, {"type": "subtitle", "time": 7931.709, "timestamp": "02:12:11", "text": "你害怕山姆吗？"}, {"type": "subtitle", "time": 7934.39, "timestamp": "02:12:14", "text": "什么？被抓住了。"}, {"type": "subtitle", "time": 7938.47, "timestamp": "02:12:18", "text": "你是？你是什么？哦，不。"}, {"type": "subtitle", "time": 7940.31, "timestamp": "02:12:20", "text": "抓到他了。被抓住了。你真是这么说的吗？"}, {"type": "subtitle", "time": 7943.589, "timestamp": "02:12:23", "text": "你被抓包了。波波。波波。波波。你 你"}, {"type": "subtitle", "time": 7945.39, "timestamp": "02:12:25", "text": "被抓获"}, {"type": "subtitle", "time": 7947.39, "timestamp": "02:12:27", "text": "不是"}, {"type": "subtitle", "time": 7954.629, "timestamp": "02:12:34", "text": "不。好的。产品。是的。这是为了"}, {"type": "subtitle", "time": 7977.83, "timestamp": "02:12:57", "text": "我在这方面堪称神。我只选择"}]
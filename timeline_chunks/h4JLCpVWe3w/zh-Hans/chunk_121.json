[{"type": "subtitle", "time": 7262.709, "timestamp": "02:01:02", "text": "好的。各位，我们点多少？喜欢"}, {"type": "subtitle", "time": 7266.39, "timestamp": "02:01:06", "text": "你想点多少？多少"}, {"type": "subtitle", "time": 7268.31, "timestamp": "02:01:08", "text": "我们负担得起吗？我们只要订一个就行了。"}, {"type": "subtitle", "time": 7272.149, "timestamp": "02:01:12", "text": "现在。当然可以。"}, {"type": "subtitle", "time": 7274.55, "timestamp": "02:01:14", "text": "大概需要30分钟。美好的。"}, {"type": "subtitle", "time": 7281.149, "timestamp": "02:01:21", "text": "这"}, {"type": "subtitle", "time": 7283.91, "timestamp": "02:01:23", "text": "警察很快就要开始行动了，伙计们。各位，我们"}, {"type": "subtitle", "time": 7285.91, "timestamp": "02:01:25", "text": "得去莫特尔看看。好的。"}, {"type": "subtitle", "time": 7294.07, "timestamp": "02:01:34", "text": "哇。哇。我提供很多免费的东西"}, {"type": "subtitle", "time": 7296.149, "timestamp": "02:01:36", "text": "这里有一些例子，各位。快点。快点。"}, {"type": "subtitle", "time": 7299.669, "timestamp": "02:01:39", "text": "巨额资金。快点。快点。"}, {"type": "subtitle", "time": 7302.709, "timestamp": "02:01:42", "text": "哦。搞什么鬼？客户拒绝"}, {"type": "subtitle", "time": 7303.99, "timestamp": "02:01:43", "text": "样品。它在这里。它在这里。它是"}, {"type": "subtitle", "time": 7305.75, "timestamp": "02:01:45", "text": "这里。"}, {"type": "subtitle", "time": 7308.03, "timestamp": "02:01:48", "text": "在哪里？在哪里？在哪里？出来"}, {"type": "subtitle", "time": 7311.629, "timestamp": "02:01:51", "text": "停车场附近的凡人"}, {"type": "subtitle", "time": 7314.629, "timestamp": "02:01:54", "text": "车库。这边。这边。这边。"}, {"type": "subtitle", "time": 7317.31, "timestamp": "02:01:57", "text": "呃，主控机器人。见我"}]
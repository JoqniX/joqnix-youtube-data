[{"type": "subtitle", "time": 15125.389, "timestamp": "04:12:05", "text": "露丝。罗，你今天过得怎么样？在哪里？"}, {"type": "subtitle", "time": 15128.71, "timestamp": "04:12:08", "text": "你？我要上楼了。我要去"}, {"type": "subtitle", "time": 15131.189, "timestamp": "04:12:11", "text": "楼上。好的。是的。请告诉我是否"}, {"type": "subtitle", "time": 15133.55, "timestamp": "04:12:13", "text": "他说了些什么。"}, {"type": "subtitle", "time": 15136.229, "timestamp": "04:12:16", "text": "好的。露丝。"}, {"type": "subtitle", "time": 15139.349, "timestamp": "04:12:19", "text": "哦，谁把灯关了？呃，不。"}, {"type": "subtitle", "time": 15141.99, "timestamp": "04:12:21", "text": "是你吗？呃，我当时正在开灯。"}, {"type": "subtitle", "time": 15145.75, "timestamp": "04:12:25", "text": "通过提供。哦，原来如此。这就是原因。"}, {"type": "subtitle", "time": 15148.389, "timestamp": "04:12:28", "text": "呃，发电机在哪儿？以下。这"}, {"type": "subtitle", "time": 15152.63, "timestamp": "04:12:32", "text": "北。如下所示。呃，我想等等，我"}, {"type": "subtitle", "time": 15154.63, "timestamp": "04:12:34", "text": "需要查看地图。我认为它在……"}, {"type": "subtitle", "time": 15156.91, "timestamp": "04:12:36", "text": "车库。"}, {"type": "subtitle", "time": 15160.55, "timestamp": "04:12:40", "text": "罗伊，你在哪里？住在附近"}, {"type": "subtitle", "time": 15162.469, "timestamp": "04:12:42", "text": "门。待在门口附近。靠近出口"}, {"type": "subtitle", "time": 15164.13, "timestamp": "04:12:44", "text": "门。好的。"}, {"type": "subtitle", "time": 15167.389, "timestamp": "04:12:47", "text": "[音乐]"}, {"type": "subtitle", "time": 15176.229, "timestamp": "04:12:56", "text": "好的。呃，乔克，去地下室。"}, {"type": "subtitle", "time": 15178.229, "timestamp": "04:12:58", "text": "好的。"}, {"type": "subtitle", "time": 15179.91, "timestamp": "04:12:59", "text": "关闭游戏内麦克风，这样他就不会听到你的声音了。"}]
[{"type": "subtitle", "time": 10742.11, "timestamp": "02:59:02", "text": "左边。我也换了。我也去"}, {"type": "subtitle", "time": 10744.349, "timestamp": "02:59:04", "text": "睡觉。哦，我的"}, {"type": "subtitle", "time": 10746.87, "timestamp": "02:59:06", "text": "上帝。我原本应该在晚上十点睡觉。"}, {"type": "subtitle", "time": 10748.63, "timestamp": "02:59:08", "text": "顺便一提。没关系。现在是1点。我"}, {"type": "subtitle", "time": 10751.75, "timestamp": "02:59:11", "text": "参加了合作项目。谢天谢地，它过去了"}, {"type": "subtitle", "time": 10753.03, "timestamp": "02:59:13", "text": "出色地。"}, {"type": "subtitle", "time": 10755.269, "timestamp": "02:59:15", "text": "我担心自己睡得太沉，喝得太醉了。"}, {"type": "subtitle", "time": 10775.349, "timestamp": "02:59:35", "text": "它。我正在上传视频，然后我就走了"}]
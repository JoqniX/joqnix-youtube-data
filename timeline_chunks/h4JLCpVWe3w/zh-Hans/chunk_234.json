[{"type": "subtitle", "time": 14040.87, "timestamp": "03:54:00", "text": "哦，你看到了吗？他只是扔了"}, {"type": "subtitle", "time": 14050.269, "timestamp": "03:54:10", "text": "它"}, {"type": "subtitle", "time": 14054.15, "timestamp": "03:54:14", "text": "就把书放在桌子上。"}, {"type": "subtitle", "time": 14057.51, "timestamp": "03:54:17", "text": "对，就是那边那张桌子。"}, {"type": "subtitle", "time": 14062.15, "timestamp": "03:54:22", "text": "哦，我看到了一个光球。哦，你死了。"}, {"type": "subtitle", "time": 14068.55, "timestamp": "03:54:28", "text": "哦，是故障。我感觉事情还在继续。"}, {"type": "subtitle", "time": 14076.309, "timestamp": "03:54:36", "text": "我确实看到了一个光球。"}, {"type": "subtitle", "time": 14079.07, "timestamp": "03:54:39", "text": "我们走吧。我们完成了那项工作。"}, {"type": "subtitle", "time": 14082.63, "timestamp": "03:54:42", "text": "拉屎。这份工作是你选的吗？呃，哪个"}, {"type": "subtitle", "time": 14084.229, "timestamp": "03:54:44", "text": "一？等等，如果我死了，我就不会……"}, {"type": "subtitle", "time": 14087.349, "timestamp": "03:54:47", "text": "获得积分。什么？"}, {"type": "subtitle", "time": 14090.389, "timestamp": "03:54:50", "text": "乔克。是的。是的。是的。如果我那样做你"}, {"type": "subtitle", "time": 14093.429, "timestamp": "03:54:53", "text": "补充证据了吗？"}, {"type": "subtitle", "time": 14096.15, "timestamp": "03:54:56", "text": "呃，不。等待。你是怎么做到的？"}]
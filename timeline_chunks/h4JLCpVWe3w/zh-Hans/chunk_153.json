[{"type": "subtitle", "time": 9180.469, "timestamp": "02:33:00", "text": "你眼花了。你没看到他。"}, {"type": "subtitle", "time": 9182.63, "timestamp": "02:33:02", "text": "哦，我被捕了。哦，不。唯一"}, {"type": "subtitle", "time": 9184.23, "timestamp": "02:33:04", "text": "我看到的问题是这辆车没有"}, {"type": "subtitle", "time": 9192.11, "timestamp": "02:33:12", "text": "只是"}, {"type": "subtitle", "time": 9195.27, "timestamp": "02:33:15", "text": "等待。哦，现在我能看到警察了。"}, {"type": "subtitle", "time": 9198.389, "timestamp": "02:33:18", "text": "哦，那"}, {"type": "subtitle", "time": 9202.51, "timestamp": "02:33:22", "text": "我是无辜的。我什么都没做。我是"}, {"type": "subtitle", "time": 9205.59, "timestamp": "02:33:25", "text": "清白的。我刚刚杀了你，我爱你"}, {"type": "subtitle", "time": 9208.469, "timestamp": "02:33:28", "text": "警察。那是"}, {"type": "subtitle", "time": 9210.63, "timestamp": "02:33:30", "text": "到底该怎么办？"}, {"type": "subtitle", "time": 9222.07, "timestamp": "02:33:42", "text": "男人。蛋白质棒味道真好。"}, {"type": "subtitle", "time": 9228.469, "timestamp": "02:33:48", "text": "我是说，什么口味？"}, {"type": "subtitle", "time": 9232.389, "timestamp": "02:33:52", "text": "只有巧克力。哦，"}, {"type": "subtitle", "time": 9233.67, "timestamp": "02:33:53", "text": "我的意思是，它确实很贵。有"}, {"type": "subtitle", "time": 9237.83, "timestamp": "02:33:57", "text": "整个酒吧大概要70美元。实际上"}]
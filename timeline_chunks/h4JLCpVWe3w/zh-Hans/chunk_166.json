[{"type": "subtitle", "time": 9967.87, "timestamp": "02:46:07", "text": "杰西"}, {"type": "subtitle", "time": 9970.429, "timestamp": "02:46:10", "text": "34. 打算等等"}, {"type": "subtitle", "time": 9973.349, "timestamp": "02:46:13", "text": "这太搞笑了。这真是太……"}, {"type": "subtitle", "time": 9975.83, "timestamp": "02:46:15", "text": "有趣的。"}, {"type": "subtitle", "time": 9981.309, "timestamp": "02:46:21", "text": "那是赫克托的吗？呃，赫克托，赫克托的"}, {"type": "subtitle", "time": 9984.23, "timestamp": "02:46:24", "text": "轮椅？我想把它买下来"}, {"type": "subtitle", "time": 9987.309, "timestamp": "02:46:27", "text": "把它带到我们家来"}, {"type": "subtitle", "time": 9990.71, "timestamp": "02:46:30", "text": "我们在这里建造这座纪念碑，呃，整个"}, {"type": "subtitle", "time": 9993.83, "timestamp": "02:46:33", "text": "公园。这里发生了什么事？跟随"}, {"type": "subtitle", "time": 9996.309, "timestamp": "02:46:36", "text": "警察。"}, {"type": "subtitle", "time": 9997.15, "timestamp": "02:46:37", "text": "他是"}, {"type": "subtitle", "time": 10007.349, "timestamp": "02:46:47", "text": "好的。该死的。我可以带进来吗？"}, {"type": "subtitle", "time": 10010.469, "timestamp": "02:46:50", "text": "这里？哦，下一个，呃，下一个交易"}, {"type": "subtitle", "time": 10012.469, "timestamp": "02:46:52", "text": "正在发生。是的。是的。是的。是的。我"}, {"type": "subtitle", "time": 10014.63, "timestamp": "02:46:54", "text": "如果需要，我会去。你有药吗？"}, {"type": "subtitle", "time": 10016.79, "timestamp": "02:46:56", "text": "是的，我弄到了毒品。是的，我明白了。"}]
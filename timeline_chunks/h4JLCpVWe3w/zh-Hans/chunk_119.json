[{"type": "subtitle", "time": 7142.07, "timestamp": "01:59:02", "text": "事物？它在壳里。"}, {"type": "subtitle", "time": 7144.629, "timestamp": "01:59:04", "text": "哦，我有，我有，我有，它是"}, {"type": "subtitle", "time": 7146.95, "timestamp": "01:59:06", "text": "美好的。我得到了它。"}, {"type": "subtitle", "time": 7148.87, "timestamp": "01:59:08", "text": "没关系，伊曼。你不需要"}, {"type": "subtitle", "time": 7154.79, "timestamp": "01:59:14", "text": "速度滚筒。我他妈怎么才能得到一个"}, {"type": "subtitle", "time": 7157.589, "timestamp": "01:59:17", "text": "增长速度？哦，是的。我还有一个"}, {"type": "subtitle", "time": 7159.83, "timestamp": "01:59:19", "text": "快速抽屉。"}, {"type": "subtitle", "time": 7163.03, "timestamp": "01:59:23", "text": "我没买任何毒品。糟糕。我可以"}, {"type": "subtitle", "time": 7166.95, "timestamp": "01:59:26", "text": "我把它种在这里吗？完毕。等等，我可以"}, {"type": "subtitle", "time": 7170.55, "timestamp": "01:59:30", "text": "抽一口。你可以抽它。你也可以"}, {"type": "subtitle", "time": 7171.47, "timestamp": "01:59:31", "text": "哦，我的"}, {"type": "subtitle", "time": 7173.95, "timestamp": "01:59:33", "text": "上帝。是的，"}, {"type": "subtitle", "time": 7176.55, "timestamp": "01:59:36", "text": "婴儿。我感觉自己像个婊子。什么？"}, {"type": "subtitle", "time": 7182.07, "timestamp": "01:59:42", "text": "我们必须和纳尔逊叔叔谈谈，"}, {"type": "subtitle", "time": 7184.75, "timestamp": "01:59:44", "text": "公用电话来了。哦，是的。哦"}, {"type": "subtitle", "time": 7188.229, "timestamp": "01:59:48", "text": "老兄，是纳尔逊叔叔，我……"}, {"type": "subtitle", "time": 7190.229, "timestamp": "01:59:50", "text": "告诉你，或许我们应该"}, {"type": "subtitle", "time": 7192.229, "timestamp": "01:59:52", "text": "与这个人无关。我不"}, {"type": "subtitle", "time": 7195.189, "timestamp": "01:59:55", "text": "她看起来很漂亮。什么？这是什么？"}, {"type": "subtitle", "time": 7197.91, "timestamp": "01:59:57", "text": "整个萨拉曼卡怎么样？"}]
[{"type": "subtitle", "time": 4564.39, "timestamp": "01:16:04", "text": "他们。蓝色房子的外面。好的。"}, {"type": "subtitle", "time": 4566.149, "timestamp": "01:16:06", "text": "我们走吧。我们去蓝房子吧"}, {"type": "subtitle", "time": 4568.709, "timestamp": "01:16:08", "text": "现在。"}, {"type": "subtitle", "time": 4571.51, "timestamp": "01:16:11", "text": "哦，找到了。好的。好的。我可以杀人吗？"}, {"type": "subtitle", "time": 4573.11, "timestamp": "01:16:13", "text": "他们？"}, {"type": "subtitle", "time": 4575.07, "timestamp": "01:16:15", "text": "兄弟，我杀了"}, {"type": "subtitle", "time": 4578.79, "timestamp": "01:16:18", "text": "他。对不起。当然。我杀了他。哦"}, {"type": "subtitle", "time": 4581.83, "timestamp": "01:16:21", "text": "我的上帝。警察。我的天啊。我真的"}, {"type": "subtitle", "time": 4585.07, "timestamp": "01:16:25", "text": "现在正开车经过这里。请。请。"}, {"type": "subtitle", "time": 4588.39, "timestamp": "01:16:28", "text": "哦，不。你开始在其他地区杀人"}, {"type": "subtitle", "time": 4592.55, "timestamp": "01:16:32", "text": "游戏也是如此。不。我的天哪。你不能"}, {"type": "subtitle", "time": 4604.63, "timestamp": "01:16:44", "text": "不。"}, {"type": "subtitle", "time": 4608.31, "timestamp": "01:16:48", "text": "我可以自己运行它们吗？是的。去做。去做。"}, {"type": "subtitle", "time": 4611.189, "timestamp": "01:16:51", "text": "快点。去做。不。他是我的客户。"}, {"type": "subtitle", "time": 4613.75, "timestamp": "01:16:53", "text": "任何。好的。我以为是"}, {"type": "subtitle", "time": 4616.31, "timestamp": "01:16:56", "text": "警察。我的天哪，是警察。打"}, {"type": "subtitle", "time": 4618.229, "timestamp": "01:16:58", "text": "把它们举起来。揍他们一顿。斗争。斗争。我"}, {"type": "subtitle", "time": 4619.99, "timestamp": "01:16:59", "text": "什么也没做。警察。好的。我需要"}]
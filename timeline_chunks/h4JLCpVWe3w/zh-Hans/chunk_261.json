[{"type": "subtitle", "time": 15662.389, "timestamp": "04:21:02", "text": "我。她每次出来的时候。现在，呃，你"}, {"type": "subtitle", "time": 15664.149, "timestamp": "04:21:04", "text": "跑步。"}, {"type": "subtitle", "time": 15667.75, "timestamp": "04:21:07", "text": "你看到这个车库了吗？请点击此处。进去"}, {"type": "subtitle", "time": 15671.59, "timestamp": "04:21:11", "text": "然后像这样关闭它。是的。"}, {"type": "subtitle", "time": 15673.91, "timestamp": "04:21:13", "text": "这样她就追捕不到你了。我将前往"}, {"type": "subtitle", "time": 15675.55, "timestamp": "04:21:15", "text": "卡车，记住她也在这里"}, {"type": "subtitle", "time": 15677.83, "timestamp": "04:21:17", "text": "去洗手间，我这就检查一下你。"}, {"type": "subtitle", "time": 15679.269, "timestamp": "04:21:19", "text": "相机。这里有一台摄像头。患病的"}, {"type": "subtitle", "time": 15685.349, "timestamp": "04:21:25", "text": "好的。当灯光亮起的那一刻"}, {"type": "subtitle", "time": 15687.83, "timestamp": "04:21:27", "text": "关掉了，对吧？好的。你听到的那些时刻"}, {"type": "subtitle", "time": 15689.75, "timestamp": "04:21:29", "text": "她喜欢心跳之类的感觉。"}, {"type": "subtitle", "time": 15691.59, "timestamp": "04:21:31", "text": "还要记住，气温可能骤降。"}, {"type": "subtitle", "time": 15693.429, "timestamp": "04:21:33", "text": "因为如果你看到冰点温度"}, {"type": "subtitle", "time": 15696.309, "timestamp": "04:21:36", "text": "嗯，是的，我们可以把它添加到……"}, {"type": "subtitle", "time": 15697.99, "timestamp": "04:21:37", "text": "证据。"}, {"type": "subtitle", "time": 15701.03, "timestamp": "04:21:41", "text": "好的。有四个运动员。共有四个"}, {"type": "subtitle", "time": 15703.429, "timestamp": "04:21:43", "text": "活动。它降到了两个。"}, {"type": "subtitle", "time": 15704.87, "timestamp": "04:21:44", "text": "你在哪里？浴室里"}, {"type": "subtitle", "time": 15707.429, "timestamp": "04:21:47", "text": "她在那里。哦，它在闪烁。"}, {"type": "subtitle", "time": 15708.429, "timestamp": "04:21:48", "text": "它是"}, {"type": "subtitle", "time": 15712.149, "timestamp": "04:21:52", "text": "闪烁。露丝，你在吗？露丝，"}, {"type": "subtitle", "time": 15716.149, "timestamp": "04:21:56", "text": "你在这里？进去。"}, {"type": "subtitle", "time": 15718.55, "timestamp": "04:21:58", "text": "迅速进屋，走到水槽附近。"}, {"type": "subtitle", "time": 15719.83, "timestamp": "04:21:59", "text": "看看有没有结冰"}]
[{"type": "subtitle", "time": 15602.87, "timestamp": "04:20:02", "text": "那。嗯，我觉得是这样，因为她回应了。"}, {"type": "subtitle", "time": 15605.429, "timestamp": "04:20:05", "text": "致孤独的人。上楼"}, {"type": "subtitle", "time": 15634.95, "timestamp": "04:20:34", "text": "H，给她打电话。给她打电话。"}, {"type": "subtitle", "time": 15640.55, "timestamp": "04:20:40", "text": "艾弗莉，你在哪里？露丝，我想"}, {"type": "subtitle", "time": 15642.95, "timestamp": "04:20:42", "text": "她之所以在这个浴室里，是因为它变成了"}, {"type": "subtitle", "time": 15646.07, "timestamp": "04:20:46", "text": "在。她来了。我的天哪。冷静下来。"}, {"type": "subtitle", "time": 15650.309, "timestamp": "04:20:50", "text": "她在水槽里的马桶里拉屎了。"}, {"type": "subtitle", "time": 15653.59, "timestamp": "04:20:53", "text": "过来。我出去。记住，打电话"}, {"type": "subtitle", "time": 15655.59, "timestamp": "04:20:55", "text": "她从浴室出来，然后就走了"}, {"type": "subtitle", "time": 15658.189, "timestamp": "04:20:58", "text": "拍张照片，然后跟我走。随"}]
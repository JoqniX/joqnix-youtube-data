[{"type": "subtitle", "time": 15301.11, "timestamp": "04:15:01", "text": "相机，嗯，就是那台相机。去那里，"}, {"type": "subtitle", "time": 15303.51, "timestamp": "04:15:03", "text": "给她打电话，还有，记住乔克，过来"}, {"type": "subtitle", "time": 15304.71, "timestamp": "04:15:04", "text": "和我在一起。过来。我来给你看"}, {"type": "subtitle", "time": 15309.11, "timestamp": "04:15:09", "text": "某物。哦，好的。呃，所以如果你听到"}, {"type": "subtitle", "time": 15311.51, "timestamp": "04:15:11", "text": "她就像开始狩猎一样，门会"}, {"type": "subtitle", "time": 15313.59, "timestamp": "04:15:13", "text": "被锁起来。门锁上了，你"}, {"type": "subtitle", "time": 15315.67, "timestamp": "04:15:15", "text": "转不动了。所以当你和她在一起的时候"}, {"type": "subtitle", "time": 15318.11, "timestamp": "04:15:18", "text": "开始狩猎，用你的手电筒走"}, {"type": "subtitle", "time": 15320.229, "timestamp": "04:15:20", "text": "上楼，进一个房间，然后锁上门。"}, {"type": "subtitle", "time": 15322.95, "timestamp": "04:15:22", "text": "你自己。直到她出来才行"}, {"type": "subtitle", "time": 15324.79, "timestamp": "04:15:24", "text": "停止狩猎。不要发出声音"}, {"type": "subtitle", "time": 15327.11, "timestamp": "04:15:27", "text": "因为她能听到你说话。正确的。好的。"}, {"type": "subtitle", "time": 15330.389, "timestamp": "04:15:30", "text": "好的。好的。现在去厕所附近。称呼"}, {"type": "subtitle", "time": 15332.87, "timestamp": "04:15:32", "text": "她。打开厕所的灯。"}, {"type": "subtitle", "time": 15334.309, "timestamp": "04:15:34", "text": "给她打电话。每当她出来的时候，"}, {"type": "subtitle", "time": 15336.229, "timestamp": "04:15:36", "text": "拍张照片然后往上跑，我"}, {"type": "subtitle", "time": 15339.03, "timestamp": "04:15:39", "text": "告诉你这项活动。正确的。好的。"}, {"type": "subtitle", "time": 15340.71, "timestamp": "04:15:40", "text": "是的。稍等片刻。让我去……"}, {"type": "subtitle", "time": 15344.91, "timestamp": "04:15:44", "text": "卡车先行。好的。"}, {"type": "subtitle", "time": 15350.11, "timestamp": "04:15:50", "text": "不。好的。去做。"}, {"type": "subtitle", "time": 15352.07, "timestamp": "04:15:52", "text": "露丝莉，拜托了。快点。不要去"}, {"type": "subtitle", "time": 15355.269, "timestamp": "04:15:55", "text": "在厕所里面。好的。好的。露丝，你"}]
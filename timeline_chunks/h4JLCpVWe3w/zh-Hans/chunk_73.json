[{"type": "subtitle", "time": 4383.83, "timestamp": "01:13:03", "text": "天哪，各位。我们有 Forza"}, {"type": "subtitle", "time": 4391.43, "timestamp": "01:13:11", "text": "难以置信，这竟然是一个人做的。"}, {"type": "subtitle", "time": 4397.43, "timestamp": "01:13:17", "text": "游戏。哦，确实如此。是啊，太疯狂了。"}, {"type": "subtitle", "time": 4400.63, "timestamp": "01:13:20", "text": "正确的？是的。"}, {"type": "subtitle", "time": 4402.229, "timestamp": "01:13:22", "text": "他们很可能到现在都已经是千万富翁了。"}, {"type": "subtitle", "time": 4405.03, "timestamp": "01:13:25", "text": "现在。我的天啊。"}, {"type": "subtitle", "time": 4407.63, "timestamp": "01:13:27", "text": "我的天哪。我的天哪。"}, {"type": "subtitle", "time": 4415.91, "timestamp": "01:13:35", "text": "开车。哦，是的。等等，我该如何检查？"}, {"type": "subtitle", "time": 4422.11, "timestamp": "01:13:42", "text": "哦，现在是8点"}, {"type": "subtitle", "time": 4426.39, "timestamp": "01:13:46", "text": "周六。我该如何出去？"}, {"type": "subtitle", "time": 4430.149, "timestamp": "01:13:50", "text": "我该如何下车？嗯，嗯，是的。"}, {"type": "subtitle", "time": 4438.59, "timestamp": "01:13:58", "text": "嘿。嘿，安迪。干得好。完全的"}]
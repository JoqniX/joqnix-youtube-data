[{"type": "subtitle", "time": 17581.75, "timestamp": "04:53:01", "text": "首先打开你的设置"}, {"type": "subtitle", "time": 17584.55, "timestamp": "04:53:04", "text": "转到选项"}, {"type": "subtitle", "time": 17590.31, "timestamp": "04:53:10", "text": "视频关闭，亮度调至 50%。"}, {"type": "subtitle", "time": 17593.59, "timestamp": "04:53:13", "text": "50 将是 2.0。"}, {"type": "subtitle", "time": 17597.43, "timestamp": "04:53:17", "text": "是的。好的。申请。是的。哦，是"}, {"type": "subtitle", "time": 17600.47, "timestamp": "04:53:20", "text": "更亮一些。好的。是的。你利用的是电磁场。"}, {"type": "subtitle", "time": 17602.868, "timestamp": "04:53:22", "text": "谁会受到电磁场的影响？"}, {"type": "subtitle", "time": 17605.43, "timestamp": "04:53:25", "text": "我接受了“你检测电磁场吗？”这个问题。好的。"}, {"type": "subtitle", "time": 17608.868, "timestamp": "04:53:28", "text": "现在打开它，进去吧。好的。做"}, {"type": "subtitle", "time": 17612.15, "timestamp": "04:53:32", "text": "你也吃盐吗？是的。好的。好的。"}, {"type": "subtitle", "time": 17613.43, "timestamp": "04:53:33", "text": "以电磁场为例。现在检查一下"}, {"type": "subtitle", "time": 17622.23, "timestamp": "04:53:42", "text": "圣。这是一栋木屋。好的。"}, {"type": "subtitle", "time": 17631.91, "timestamp": "04:53:51", "text": "这样你就可以按V键，然后点赞询问了。"}, {"type": "subtitle", "time": 17633.67, "timestamp": "04:53:53", "text": "待处理，你在这里吗？请给我们一个"}, {"type": "subtitle", "time": 17636.83, "timestamp": "04:53:56", "text": "符号。待办的。"}]
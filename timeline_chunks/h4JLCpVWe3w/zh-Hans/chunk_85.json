[{"type": "subtitle", "time": 5102.79, "timestamp": "01:25:02", "text": "等等，你事先计划好要抽大麻了吗？"}, {"type": "subtitle", "time": 5106.39, "timestamp": "01:25:06", "text": "是的，我做了。哇。哦，我在开车。"}, {"type": "subtitle", "time": 5109.11, "timestamp": "01:25:09", "text": "离开。编号。赫克托。赫克托。这"}, {"type": "subtitle", "time": 5112.47, "timestamp": "01:25:12", "text": "警察。赫克托。"}, {"type": "subtitle", "time": 5115.629, "timestamp": "01:25:15", "text": "哦。呃，别他妈的哦，是的。不。哦，"}, {"type": "subtitle", "time": 5117.87, "timestamp": "01:25:17", "text": "是的。"}, {"type": "subtitle", "time": 5128.709, "timestamp": "01:25:28", "text": "这一切都是因为你，因为这一切都是因为你"}, {"type": "subtitle", "time": 5131.91, "timestamp": "01:25:31", "text": "因为有你。等等，什么？我做了什么"}, {"type": "subtitle", "time": 5135.51, "timestamp": "01:25:35", "text": "做？收藏家去世了。收藏家去世了"}, {"type": "subtitle", "time": 5140.709, "timestamp": "01:25:40", "text": "因为你知道这是你想要的。"}, {"type": "subtitle", "time": 5142.709, "timestamp": "01:25:42", "text": "你是个来自……的小毒贩"}, {"type": "subtitle", "time": 5152.39, "timestamp": "01:25:52", "text": "如果可以的话。只有你才知道，只有你才知道"}, {"type": "subtitle", "time": 5154.39, "timestamp": "01:25:54", "text": "导致崩溃的一种方法。该走了"}, {"type": "subtitle", "time": 5159.11, "timestamp": "01:25:59", "text": "工作。好的。现在我新建一个文件。"}]
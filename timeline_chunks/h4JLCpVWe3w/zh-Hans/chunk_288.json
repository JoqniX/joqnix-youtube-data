[{"type": "subtitle", "time": 17282.07, "timestamp": "04:48:02", "text": "好的。好的。我当场就买了。好的。好的。"}, {"type": "subtitle", "time": 17284.948, "timestamp": "04:48:04", "text": "我必须开始了。准备好了吗？是的。是的，我"}, {"type": "subtitle", "time": 17293.27, "timestamp": "04:48:13", "text": "一座废弃已久的农舍。"}, {"type": "subtitle", "time": 17295.03, "timestamp": "04:48:15", "text": "荒郊野外。在中间"}, {"type": "subtitle", "time": 17298.23, "timestamp": "04:48:18", "text": "无处。谁知道里面还剩下什么呢？"}, {"type": "subtitle", "time": 17302.07, "timestamp": "04:48:22", "text": "无尖端距离声？远处传来声音。"}, {"type": "subtitle", "time": 17304.628, "timestamp": "04:48:24", "text": "你说的远处的声音是什么意思？还"}, {"type": "subtitle", "time": 17308.788, "timestamp": "04:48:28", "text": "就像我是个指关节一样。乌干达指节"}, {"type": "subtitle", "time": 17311.59, "timestamp": "04:48:31", "text": "在你的直播流中。我是个指关节。哦是的，"}, {"type": "subtitle", "time": 17314.39, "timestamp": "04:48:34", "text": "你真是个笨蛋。"}, {"type": "subtitle", "time": 17317.27, "timestamp": "04:48:37", "text": "哦，对啊，这个梗已经过时了吧？你"}, {"type": "subtitle", "time": 17320.868, "timestamp": "04:48:40", "text": "知道路吗？你知道路吗？哦，"}, {"type": "subtitle", "time": 17322.47, "timestamp": "04:48:42", "text": "对了，看看上面有没有写什么。"}, {"type": "subtitle", "time": 17327.03, "timestamp": "04:48:47", "text": "在最上面。呃，待定。它说哦，是"}, {"type": "subtitle", "time": 17329.83, "timestamp": "04:48:49", "text": "它是第一关出现的幽灵。"}, {"type": "subtitle", "time": 17332.15, "timestamp": "04:48:52", "text": "回复待处理事项？所以，如果你说"}, {"type": "subtitle", "time": 17334.15, "timestamp": "04:48:54", "text": "待定，无论如何它都会做出回应"}, {"type": "subtitle", "time": 17337.708, "timestamp": "04:48:57", "text": "无论你是否独自一人。"}]
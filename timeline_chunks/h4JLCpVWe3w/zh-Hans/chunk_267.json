[{"type": "subtitle", "time": 16021.59, "timestamp": "04:27:01", "text": "相机。相机。好的。"}, {"type": "subtitle", "time": 16025.59, "timestamp": "04:27:05", "text": "能听到她的声音。搞什么鬼？"}, {"type": "subtitle", "time": 16027.11, "timestamp": "04:27:07", "text": "我们将使用摄像机。什么？"}, {"type": "subtitle", "time": 16028.55, "timestamp": "04:27:08", "text": "哦，大概是因为你已经死了。来"}, {"type": "subtitle", "time": 16030.149, "timestamp": "04:27:10", "text": "后退。回来。好的，我会通知你。"}, {"type": "subtitle", "time": 16034.389, "timestamp": "04:27:14", "text": "如果她停止行走。嗯？好的。"}, {"type": "subtitle", "time": 16037.429, "timestamp": "04:27:17", "text": "天哪，这房子太让人痛苦了。"}, {"type": "subtitle", "time": 16041.189, "timestamp": "04:27:21", "text": "我肾上腺素飙升。爱它。爱"}, {"type": "subtitle", "time": 16047.349, "timestamp": "04:27:27", "text": "对，你就待在角落里。"}, {"type": "subtitle", "time": 16049.71, "timestamp": "04:27:29", "text": "你会看到她向我冲过来。"}, {"type": "subtitle", "time": 16053.67, "timestamp": "04:27:33", "text": "好的。她知道你在这里。我"}, {"type": "subtitle", "time": 16055.269, "timestamp": "04:27:35", "text": "嗯，是的。这就是她继续下去的原因。"}, {"type": "subtitle", "time": 16057.349, "timestamp": "04:27:37", "text": "我自己追捕我自己。我动不了。我做不到"}, {"type": "subtitle", "time": 16061.59, "timestamp": "04:27:41", "text": "拉屎。哦，我听到她来了。好的，过来"}, {"type": "subtitle", "time": 16064.07, "timestamp": "04:27:44", "text": "回到我家，看看我"}, {"type": "subtitle", "time": 16065.75, "timestamp": "04:27:45", "text": "那"}, {"type": "subtitle", "time": 16068.389, "timestamp": "04:27:48", "text": "我的上帝。"}, {"type": "subtitle", "time": 16071.75, "timestamp": "04:27:51", "text": "哦，我听到她说话了。她朝我走过来。"}, {"type": "subtitle", "time": 16074.71, "timestamp": "04:27:54", "text": "是的。"}]
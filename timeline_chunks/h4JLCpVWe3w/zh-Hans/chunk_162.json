[{"type": "subtitle", "time": 9728.99, "timestamp": "02:42:08", "text": "她慢跑着，然后长叹一声。"}, {"type": "subtitle", "time": 9731.99, "timestamp": "02:42:11", "text": "宽慰。好了，各位。我们拿到了新的"}, {"type": "subtitle", "time": 9733.75, "timestamp": "02:42:13", "text": "房子。"}, {"type": "subtitle", "time": 9735.03, "timestamp": "02:42:15", "text": "我们走吧。"}, {"type": "subtitle", "time": 9738.78, "timestamp": "02:42:18", "text": "把旧房子里的东西都搬走。"}, {"type": "subtitle", "time": 9740.95, "timestamp": "02:42:20", "text": "[音乐]"}, {"type": "subtitle", "time": 9744.63, "timestamp": "02:42:24", "text": "我们可以点击并取走它。你知道"}, {"type": "subtitle", "time": 9747.91, "timestamp": "02:42:27", "text": "新房子在哪儿？对吧？是的。全部"}, {"type": "subtitle", "time": 9750.51, "timestamp": "02:42:30", "text": "正确的。把它放进去"}, {"type": "subtitle", "time": 9753.349, "timestamp": "02:42:33", "text": "那里。嗨，唐娜。我们正要……"}, {"type": "subtitle", "time": 9757.11, "timestamp": "02:42:37", "text": "离开。但是，呃，收获那东西，"}, {"type": "subtitle", "time": 9760.07, "timestamp": "02:42:40", "text": "这株植物，这样我们就可以把它带走。"}, {"type": "subtitle", "time": 9762.91, "timestamp": "02:42:42", "text": "这里。让我来收割它。挑选"}, {"type": "subtitle", "time": 9766.11, "timestamp": "02:42:46", "text": "物体。鼠标右键。"}, {"type": "subtitle", "time": 9772.19, "timestamp": "02:42:52", "text": "第一的。全部"}, {"type": "subtitle", "time": 9779.349, "timestamp": "02:42:59", "text": "八。好的。我拿到这些东西了。我是"}]
[{"type": "subtitle", "time": 17940.788, "timestamp": "04:59:00", "text": "啊，"}, {"type": "subtitle", "time": 17943.03, "timestamp": "04:59:03", "text": "所以我们就一直在尖叫"}, {"type": "subtitle", "time": 17945.43, "timestamp": "04:59:05", "text": "第一轮就像个傻瓜一样等待"}, {"type": "subtitle", "time": 17947.11, "timestamp": "04:59:07", "text": "当我们玩耍的时候，当我和……一起玩耍的时候"}, {"type": "subtitle", "time": 17949.19, "timestamp": "04:59:09", "text": "米察伊。我当时尖叫着，尖叫着"}, {"type": "subtitle", "time": 17952.788, "timestamp": "04:59:12", "text": "像个傻瓜一样等待。哇。"}, {"type": "subtitle", "time": 17954.55, "timestamp": "04:59:14", "text": "精彩的比赛。精彩的比赛。我真是个笨蛋"}, {"type": "subtitle", "time": 17957.19, "timestamp": "04:59:17", "text": "拉屎。"}, {"type": "subtitle", "time": 17959.59, "timestamp": "04:59:19", "text": "艾米莉·迪克森。她真是个混蛋"}, {"type": "subtitle", "time": 17968.948, "timestamp": "04:59:28", "text": "哦，你想让我弹吗？还是……呃……你"}, {"type": "subtitle", "time": 17971.99, "timestamp": "04:59:31", "text": "又起来了？嗯，继续玩吧。我"}, {"type": "subtitle", "time": 17974.47, "timestamp": "04:59:34", "text": "我的意思是，呃，我甚至都没在直播。"}, {"type": "subtitle", "time": 17976.948, "timestamp": "04:59:36", "text": "我只是看着你，如果你愿意，我会帮助你。"}, {"type": "subtitle", "time": 17980.55, "timestamp": "04:59:40", "text": "想。好的，"}, {"type": "subtitle", "time": 17981.708, "timestamp": "04:59:41", "text": "艾米丽"}, {"type": "subtitle", "time": 17984.31, "timestamp": "04:59:44", "text": "迪克森。我猜她真的很喜欢那样。"}, {"type": "subtitle", "time": 17986.868, "timestamp": "04:59:46", "text": "迪克。"}, {"type": "subtitle", "time": 17988.39, "timestamp": "04:59:48", "text": "艾米丽，"}, {"type": "subtitle", "time": 17991.11, "timestamp": "04:59:51", "text": "让他吸你的"}, {"type": "subtitle", "time": 17994.23, "timestamp": "04:59:54", "text": "让他去抢你的工作吧。"}, {"type": "subtitle", "time": 17998.55, "timestamp": "04:59:58", "text": "艾米丽，你在哪里？没有回应。好的，"}]
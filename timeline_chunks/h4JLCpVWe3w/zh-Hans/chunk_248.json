[{"type": "subtitle", "time": 14881.03, "timestamp": "04:08:01", "text": "因为他很可能会失明，所以他可能会……"}, {"type": "subtitle", "time": 14884.269, "timestamp": "04:08:04", "text": "关灯了。哦，是的。是的。"}, {"type": "subtitle", "time": 14886.76, "timestamp": "04:08:06", "text": "是的。 粗鲁的。出来。出来。你能谈谈吗？"}, {"type": "subtitle", "time": 14889.76, "timestamp": "04:08:09", "text": "粗鲁的。出来。出来。你能谈谈吗？ 大部头书？你需要，你需要靠近"}, {"type": "subtitle", "time": 14892.239, "timestamp": "04:08:12", "text": "大部头书？你需要，你需要靠近 对他来说则不然。哦好的。根"}, {"type": "subtitle", "time": 14900.95, "timestamp": "04:08:20", "text": "查拉根。好的。只有一个"}, {"type": "subtitle", "time": 14911.189, "timestamp": "04:08:31", "text": "好的。露丝，你听见我说话了吗？"}, {"type": "subtitle", "time": 14914.87, "timestamp": "04:08:34", "text": "你必须靠近一点。我很害怕。我知道"}, {"type": "subtitle", "time": 14917.429, "timestamp": "04:08:37", "text": "你很害怕，但我帮不了你。那是"}, {"type": "subtitle", "time": 14919.99, "timestamp": "04:08:39", "text": "只有我们两个人。"}, {"type": "subtitle", "time": 14923.59, "timestamp": "04:08:43", "text": "Root，你在哪里？好的，有"}, {"type": "subtitle", "time": 14925.189, "timestamp": "04:08:45", "text": "三。走，走，继续走。三"}, {"type": "subtitle", "time": 14927.51, "timestamp": "04:08:47", "text": "仅此地有活动。打开灯。"}, {"type": "subtitle", "time": 14930.83, "timestamp": "04:08:50", "text": "打开走廊的灯。"}, {"type": "subtitle", "time": 14936.87, "timestamp": "04:08:56", "text": "哦，你是说，呃，他说了什么吗？"}, {"type": "subtitle", "time": 14938.71, "timestamp": "04:08:58", "text": "什么？"}]
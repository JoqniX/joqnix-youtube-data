[{"type": "subtitle", "time": 7206.39, "timestamp": "02:00:06", "text": "呃，为了方便翻译，各位，我说"}, {"type": "subtitle", "time": 7209.51, "timestamp": "02:00:09", "text": "母亲的眼睛。"}, {"type": "subtitle", "time": 7213.51, "timestamp": "02:00:13", "text": "那并没有击中这个"}, {"type": "subtitle", "time": 7216.55, "timestamp": "02:00:16", "text": "已经打不动了。你们谈过吗？"}, {"type": "subtitle", "time": 7219.589, "timestamp": "02:00:19", "text": "用手机吗？"}, {"type": "subtitle", "time": 7221.27, "timestamp": "02:00:21", "text": "为什么这里只有一部公用电话？"}, {"type": "subtitle", "time": 7222.95, "timestamp": "02:00:22", "text": "搞什么鬼？你差不多准备好了，但是"}, {"type": "subtitle", "time": 7224.87, "timestamp": "02:00:24", "text": "伙计，你还差一把钥匙。你需要"}, {"type": "subtitle", "time": 7226.75, "timestamp": "02:00:26", "text": "联系供应商。获得你的"}, {"type": "subtitle", "time": 7229.35, "timestamp": "02:00:29", "text": "手。呃，我已经把你的电话号码转给了别人。"}, {"type": "subtitle", "time": 7231.83, "timestamp": "02:00:31", "text": "致阿尔伯特·胡佛。"}, {"type": "subtitle", "time": 7234.39, "timestamp": "02:00:34", "text": "好的。"}, {"type": "subtitle", "time": 7236.95, "timestamp": "02:00:36", "text": "死信箱。我为你输了，所以……"}, {"type": "subtitle", "time": 7238.189, "timestamp": "02:00:38", "text": "付清费用"}, {"type": "subtitle", "time": 7254.55, "timestamp": "02:00:54", "text": "[音乐]"}, {"type": "subtitle", "time": 7256.84, "timestamp": "02:00:56", "text": "好的。去你的。"}, {"type": "subtitle", "time": 7259.83, "timestamp": "02:00:59", "text": "[音乐]"}]
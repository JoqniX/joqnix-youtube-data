[{"type": "subtitle", "time": 17111.628, "timestamp": "04:45:11", "text": "去。哦，她是"}, {"type": "subtitle", "time": 17115.11, "timestamp": "04:45:15", "text": "未来。哦，她来了。你？我 我"}, {"type": "subtitle", "time": 17121.19, "timestamp": "04:45:21", "text": "她杀了你。"}, {"type": "subtitle", "time": 17123.43, "timestamp": "04:45:23", "text": "是啊，她杀了我。我什么也没看见。"}, {"type": "subtitle", "time": 17124.75, "timestamp": "04:45:24", "text": "哦，我的"}, {"type": "subtitle", "time": 17127.91, "timestamp": "04:45:27", "text": "上帝。不。"}, {"type": "subtitle", "time": 17130.83, "timestamp": "04:45:30", "text": "我以前也和你一样。好的。正是如此"}, {"type": "subtitle", "time": 17134.868, "timestamp": "04:45:34", "text": "想法。你好，乔克。你好。确切地"}, {"type": "subtitle", "time": 17136.31, "timestamp": "04:45:36", "text": "我的想法。所以，这场比赛并没有成功。"}, {"type": "subtitle", "time": 17138.59, "timestamp": "04:45:38", "text": "注册我的路径。"}, {"type": "subtitle", "time": 17141.43, "timestamp": "04:45:41", "text": "哦，哇。"}, {"type": "subtitle", "time": 17144.23, "timestamp": "04:45:44", "text": "所以，我一搬出那个地方，"}, {"type": "subtitle", "time": 17146.628, "timestamp": "04:45:46", "text": "它检测到了这一点。"}, {"type": "subtitle", "time": 17148.948, "timestamp": "04:45:48", "text": "个人。所以就像每当"}, {"type": "subtitle", "time": 17152.628, "timestamp": "04:45:52", "text": "角色死亡，你的身体也随之死亡，人工智能也随之死亡。"}, {"type": "subtitle", "time": 17156.23, "timestamp": "04:45:56", "text": "它会记录你身体发出的那种感觉，就像你……"}, {"type": "subtitle", "time": 17158.708, "timestamp": "04:45:58", "text": "死了，但东西还在那里。所以"}]
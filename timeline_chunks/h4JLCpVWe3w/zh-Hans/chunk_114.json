[{"type": "subtitle", "time": 6844.629, "timestamp": "01:54:04", "text": "我仍然身无分文。搞什么鬼？"}, {"type": "subtitle", "time": 6847.51, "timestamp": "01:54:07", "text": "我认为你很有钱。"}, {"type": "subtitle", "time": 6850.47, "timestamp": "01:54:10", "text": "我当时还是那个W，"}, {"type": "subtitle", "time": 6852.95, "timestamp": "01:54:12", "text": "兄弟。对我来说，他的头就像他的身体一样"}, {"type": "subtitle", "time": 6856.03, "timestamp": "01:54:16", "text": "完全分裂开来，就像"}, {"type": "subtitle", "time": 6858.87, "timestamp": "01:54:18", "text": "延伸到另一边。"}, {"type": "subtitle", "time": 6871.189, "timestamp": "01:54:31", "text": "什么？"}, {"type": "subtitle", "time": 6875.589, "timestamp": "01:54:35", "text": "哦，是的。买瓶可乐恢复活力。"}, {"type": "subtitle", "time": 6878.669, "timestamp": "01:54:38", "text": "哦，你可以买一个哦，"}, {"type": "subtitle", "time": 6882.229, "timestamp": "01:54:42", "text": "是的。哦，你最好弄一个"}, {"type": "subtitle", "time": 6884.83, "timestamp": "01:54:44", "text": "他妈的。你知道那些捡垃圾的人吗？"}, {"type": "subtitle", "time": 6895.669, "timestamp": "01:54:55", "text": "是的。也就是，给我们买一块土壤。土壤。"}]
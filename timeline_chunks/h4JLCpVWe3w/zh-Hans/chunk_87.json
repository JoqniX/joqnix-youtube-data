[{"type": "subtitle", "time": 5221.669, "timestamp": "01:27:01", "text": "邀请。我会尽量加入你们。加入游戏。"}, {"type": "subtitle", "time": 5231.189, "timestamp": "01:27:11", "text": "伙计们，我干脆剃光头算了？"}, {"type": "subtitle", "time": 5235.39, "timestamp": "01:27:15", "text": "秃。我就是你出生点。"}, {"type": "subtitle", "time": 5239.43, "timestamp": "01:27:19", "text": "玩家，但这必须像"}, {"type": "subtitle", "time": 5241.91, "timestamp": "01:27:21", "text": "哦，我明白了，你只是个小角色而已。"}, {"type": "subtitle", "time": 5243.55, "timestamp": "01:27:23", "text": "好吧，我明白了。"}, {"type": "subtitle", "time": 5247.35, "timestamp": "01:27:27", "text": "哦，真好真好"}, {"type": "subtitle", "time": 5251.43, "timestamp": "01:27:31", "text": "好的，没问题，我们走吧，我可以跳过这部分。"}, {"type": "subtitle", "time": 5254.55, "timestamp": "01:27:34", "text": "白色好的，是的，就是这样，脸部略微"}, {"type": "subtitle", "time": 5256.75, "timestamp": "01:27:36", "text": "微笑"}, {"type": "subtitle", "time": 5264.79, "timestamp": "01:27:44", "text": "死。不，我不想留胡子。"}, {"type": "subtitle", "time": 5268.75, "timestamp": "01:27:48", "text": "皱纹。呃，雀斑。"}, {"type": "subtitle", "time": 5273.27, "timestamp": "01:27:53", "text": "没有任何。细节强度。好的，下一个。"}]
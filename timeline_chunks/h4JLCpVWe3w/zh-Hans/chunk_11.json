[{"type": "subtitle", "time": 666.79, "timestamp": "00:11:06", "text": "所以，你的藏匿处在教堂后面。"}, {"type": "subtitle", "time": 667.949, "timestamp": "00:11:07", "text": "什么？"}, {"type": "subtitle", "time": 676.47, "timestamp": "00:11:16", "text": "好的，我会从……订购一些可卡因"}, {"type": "subtitle", "time": 678.03, "timestamp": "00:11:18", "text": "你"}, {"type": "subtitle", "time": 681.829, "timestamp": "00:11:21", "text": "萨尔瓦多，我要订购"}, {"type": "subtitle", "time": 685.19, "timestamp": "00:11:25", "text": "批量订购这个实际上我可以做到"}, {"type": "subtitle", "time": 689.03, "timestamp": "00:11:29", "text": "20 等等，我可以上去，哦等等等等"}, {"type": "subtitle", "time": 692.55, "timestamp": "00:11:32", "text": "上限是10，好吧，我想我可以增加。"}, {"type": "subtitle", "time": 707.11, "timestamp": "00:11:47", "text": "小时。你现在的深度是 680。哦，等等。"}, {"type": "subtitle", "time": 708.389, "timestamp": "00:11:48", "text": "我会付钱给你。不用担心。不"}, {"type": "subtitle", "time": 711.11, "timestamp": "00:11:51", "text": "担心。我有钱。我 我 我 我"}, {"type": "subtitle", "time": 718.23, "timestamp": "00:11:58", "text": "婴儿。我有点儿富裕。就是这样。"}]
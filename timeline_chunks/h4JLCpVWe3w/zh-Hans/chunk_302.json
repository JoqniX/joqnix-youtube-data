[{"type": "subtitle", "time": 18121.75, "timestamp": "05:02:01", "text": "不，不，拿盐。好的。但我"}, {"type": "subtitle", "time": 18125.11, "timestamp": "05:02:05", "text": "盐不能用。啊，等等。"}, {"type": "subtitle", "time": 18127.03, "timestamp": "05:02:07", "text": "结束了。"}, {"type": "subtitle", "time": 18130.07, "timestamp": "05:02:10", "text": "我记得用了三次。哦，等等。"}, {"type": "subtitle", "time": 18131.51, "timestamp": "05:02:11", "text": "带上相机。拿"}, {"type": "subtitle", "time": 18133.75, "timestamp": "05:02:13", "text": "相机。去拿相机。放好"}, {"type": "subtitle", "time": 18136.55, "timestamp": "05:02:16", "text": "就在那个滚动的罐子附近。"}, {"type": "subtitle", "time": 18141.51, "timestamp": "05:02:21", "text": "把它放在滚动的罐子附近。"}, {"type": "subtitle", "time": 18144.15, "timestamp": "05:02:24", "text": "这样你就可以看看有没有什么问题了。"}, {"type": "subtitle", "time": 18148.55, "timestamp": "05:02:28", "text": "不管是不是光球。请勿用于麦克风。"}, {"type": "subtitle", "time": 18150.628, "timestamp": "05:02:30", "text": "我应该把它放在这里吗？去吧"}, {"type": "subtitle", "time": 18153.51, "timestamp": "05:02:33", "text": "向后看。向后看。"}, {"type": "subtitle", "time": 18156.948, "timestamp": "05:02:36", "text": "就在那附近。这样你就能看到了。"}, {"type": "subtitle", "time": 18158.628, "timestamp": "05:02:38", "text": "不，不，在架子上。在架子上。在"}, {"type": "subtitle", "time": 18159.788, "timestamp": "05:02:39", "text": "架子。在"}, {"type": "subtitle", "time": 18161.788, "timestamp": "05:02:41", "text": "架子。地方"}, {"type": "subtitle", "time": 18163.708, "timestamp": "05:02:43", "text": "它。哦"}, {"type": "subtitle", "time": 18167.27, "timestamp": "05:02:47", "text": "他妈的。有鬼。上。上。去"}, {"type": "subtitle", "time": 18169.868, "timestamp": "05:02:49", "text": "向上。跑步。跑步。某处。上。不是"}, {"type": "subtitle", "time": 18172.39, "timestamp": "05:02:52", "text": "那里。是的。上。上。上。"}, {"type": "subtitle", "time": 18173.75, "timestamp": "05:02:53", "text": "里面。房间里面。在"}, {"type": "subtitle", "time": 18174.948, "timestamp": "05:02:54", "text": "房间。在某个房间里。关门。"}, {"type": "subtitle", "time": 18176.59, "timestamp": "05:02:56", "text": "进入某个房间"}, {"type": "subtitle", "time": 18179.43, "timestamp": "05:02:59", "text": "然后关上门。关门。是的。"}]
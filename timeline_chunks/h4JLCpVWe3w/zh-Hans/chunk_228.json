[{"type": "subtitle", "time": 13681.51, "timestamp": "03:48:01", "text": "我是阿道夫·希特勒，联合国军总司令"}, {"type": "subtitle", "time": 13685.03, "timestamp": "03:48:05", "text": "第三辆自行车，鲜为人知的事实也是"}, {"type": "subtitle", "time": 13686.269, "timestamp": "03:48:06", "text": "这"}, {"type": "subtitle", "time": 13731.67, "timestamp": "03:48:51", "text": "等等，你们觉得我应该转身吗？"}]
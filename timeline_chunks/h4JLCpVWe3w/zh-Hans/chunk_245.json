[{"type": "subtitle", "time": 14701.79, "timestamp": "04:05:01", "text": "猫。奈吉德，请给我们一个启示。"}, {"type": "subtitle", "time": 14709.269, "timestamp": "04:05:09", "text": "打开一扇门。呃，乔，做一件事。去"}, {"type": "subtitle", "time": 14711.03, "timestamp": "04:05:11", "text": "在二楼浴室。我会检查一下"}, {"type": "subtitle", "time": 14712.95, "timestamp": "04:05:12", "text": "这项活动。"}, {"type": "subtitle", "time": 14714.71, "timestamp": "04:05:14", "text": "第二？哦，我在二楼。"}, {"type": "subtitle", "time": 14717.67, "timestamp": "04:05:17", "text": "好的。呃，如果你看到活动或"}, {"type": "subtitle", "time": 14718.95, "timestamp": "04:05:18", "text": "灯，打开灯，如果"}, {"type": "subtitle", "time": 14720.389, "timestamp": "04:05:20", "text": "灯光闪烁，请告知我。患病的"}, {"type": "subtitle", "time": 14721.99, "timestamp": "04:05:21", "text": "回来拍张照片。就这样"}, {"type": "subtitle", "time": 14724.11, "timestamp": "04:05:24", "text": "我们想要。"}, {"type": "subtitle", "time": 14728.389, "timestamp": "04:05:28", "text": "好的。我打开了灯。"}, {"type": "subtitle", "time": 14730.55, "timestamp": "04:05:30", "text": "哦，那里有一个"}, {"type": "subtitle", "time": 14732.55, "timestamp": "04:05:32", "text": "那里曾经有过一点点。回来。"}, {"type": "subtitle", "time": 14734.309, "timestamp": "04:05:34", "text": "带上相机。记住，"}, {"type": "subtitle", "time": 14735.91, "timestamp": "04:05:35", "text": "每当鬼魂出现时，就拿走"}, {"type": "subtitle", "time": 14739.87, "timestamp": "04:05:39", "text": "图片。你在哪里？呃，我是"}, {"type": "subtitle", "time": 14743.99, "timestamp": "04:05:43", "text": "外部。哦，等等。圣哉上帝。是什么"}, {"type": "subtitle", "time": 14747.189, "timestamp": "04:05:47", "text": "那？拿着这台相机。好的。点击"}, {"type": "subtitle", "time": 14749.11, "timestamp": "04:05:49", "text": "一张图，对吧？好的。好的。那"}, {"type": "subtitle", "time": 14751.91, "timestamp": "04:05:51", "text": "摄像机？呃，给我吧。"}]
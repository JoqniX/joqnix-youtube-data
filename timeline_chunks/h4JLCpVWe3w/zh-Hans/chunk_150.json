[{"type": "subtitle", "time": 9000.67, "timestamp": "02:30:00", "text": "我认为我们可以做到"}, {"type": "subtitle", "time": 9011.99, "timestamp": "02:30:11", "text": "快点。巨额资金。巨额资金。得到21"}, {"type": "subtitle", "time": 9015.27, "timestamp": "02:30:15", "text": "由此而来。糟糕，我们不够。"}, {"type": "subtitle", "time": 9017.91, "timestamp": "02:30:17", "text": "好了，现在你们可以开始吐槽了。"}, {"type": "subtitle", "time": 9024.02, "timestamp": "02:30:24", "text": "在。我们说的“丢弃”是什么意思？"}, {"type": "subtitle", "time": 9036.02, "timestamp": "02:30:36", "text": "哦，好的。"}, {"type": "subtitle", "time": 9037.75, "timestamp": "02:30:37", "text": "[音乐]"}]
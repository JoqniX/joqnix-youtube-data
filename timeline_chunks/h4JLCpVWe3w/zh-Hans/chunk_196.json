[{"type": "subtitle", "time": 11766.55, "timestamp": "03:16:06", "text": "卡特，我们这里有很多帅气的单身男士。"}, {"type": "subtitle", "time": 11773.79, "timestamp": "03:16:13", "text": "我的天啊。你在这里？"}, {"type": "subtitle", "time": 11789.19, "timestamp": "03:16:29", "text": "感觉什么事都没发生。"}, {"type": "subtitle", "time": 11807.11, "timestamp": "03:16:47", "text": "苏菲，你在吗？"}, {"type": "subtitle", "time": 11808.99, "timestamp": "03:16:48", "text": "我的天啊，好吓人"}, {"type": "subtitle", "time": 11817.63, "timestamp": "03:16:57", "text": "苏菲，那是你吗？"}, {"type": "subtitle", "time": 11819.95, "timestamp": "03:16:59", "text": "车？这是你的"}]
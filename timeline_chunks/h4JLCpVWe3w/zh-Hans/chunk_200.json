[{"type": "subtitle", "time": 12001.83, "timestamp": "03:20:01", "text": "我们来看看索菲是不是英国人。"}, {"type": "subtitle", "time": 12004.15, "timestamp": "03:20:04", "text": "你在这里？苏菲，你在吗？"}, {"type": "subtitle", "time": 12006.79, "timestamp": "03:20:06", "text": "苏菲，你在吗？问问她是不是"}, {"type": "subtitle", "time": 12008.309, "timestamp": "03:20:08", "text": "英国人。"}, {"type": "subtitle", "time": 12014.71, "timestamp": "03:20:14", "text": "我想她应该在楼上。你确定吗？"}, {"type": "subtitle", "time": 12017.269, "timestamp": "03:20:17", "text": "是的。我的天啊。这是这个房间"}, {"type": "subtitle", "time": 12020.71, "timestamp": "03:20:20", "text": "亮得要命。"}, {"type": "subtitle", "time": 12023.51, "timestamp": "03:20:23", "text": "路在哪里？哦，这边走。苏菲，"}, {"type": "subtitle", "time": 12033.07, "timestamp": "03:20:33", "text": "苏菲，你是……"}, {"type": "subtitle", "time": 12036.07, "timestamp": "03:20:36", "text": "英国人？你是英国人吗，苏菲？"}, {"type": "subtitle", "time": 12038.87, "timestamp": "03:20:38", "text": "苏菲，你在吗？你在 Do 吗？"}, {"type": "subtitle", "time": 12042.229, "timestamp": "03:20:42", "text": "你有什么？嗯？你有吗？你有吗？"}, {"type": "subtitle", "time": 12045.03, "timestamp": "03:20:45", "text": "你有饼干吗？"}, {"type": "subtitle", "time": 12052.15, "timestamp": "03:20:52", "text": "你这样做吗？你通过什么方式旅行？"}, {"type": "subtitle", "time": 12053.83, "timestamp": "03:20:53", "text": "飞机？"}]
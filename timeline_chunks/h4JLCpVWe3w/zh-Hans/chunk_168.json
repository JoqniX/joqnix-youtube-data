[{"type": "subtitle", "time": 10083.11, "timestamp": "02:48:03", "text": "经销商。有个叫本吉·科尔曼的家伙。"}, {"type": "subtitle", "time": 10085.91, "timestamp": "02:48:05", "text": "他的名字叫本吉。首先你可以"}, {"type": "subtitle", "time": 10087.99, "timestamp": "02:48:07", "text": "与……合作。你将无法雇佣一个"}, {"type": "subtitle", "time": 10089.83, "timestamp": "02:48:09", "text": "直到他们的朋友之一成为经销商为止"}, {"type": "subtitle", "time": 10091.99, "timestamp": "02:48:11", "text": "推荐给你。本吉是朋友"}, {"type": "subtitle", "time": 10094.67, "timestamp": "02:48:14", "text": "佩吉、贝丝和"}, {"type": "subtitle", "time": 10100.469, "timestamp": "02:48:20", "text": "与……达到友好关系状态"}, {"type": "subtitle", "time": 10104.07, "timestamp": "02:48:24", "text": "科尔、莱维格或贝丝。好吧，我想呃……"}, {"type": "subtitle", "time": 10106.87, "timestamp": "02:48:26", "text": "我觉得我们可以就此打住，不再讨论这个游戏了。"}, {"type": "subtitle", "time": 10109.429, "timestamp": "02:48:29", "text": "伙计们。好的，"}, {"type": "subtitle", "time": 10111.349, "timestamp": "02:48:31", "text": "我会把所有的现金都放进袋子里。"}, {"type": "subtitle", "time": 10113.99, "timestamp": "02:48:33", "text": "然后保存。哦，是的。我们需要混合"}, {"type": "subtitle", "time": 10115.75, "timestamp": "02:48:35", "text": "对吧？"}, {"type": "subtitle", "time": 10118.389, "timestamp": "02:48:38", "text": "是的，我想我们等等，我想我们有"}, {"type": "subtitle", "time": 10120.07, "timestamp": "02:48:40", "text": "足够的。是的，我们足够了。我有"}, {"type": "subtitle", "time": 10123.51, "timestamp": "02:48:43", "text": "93. 我觉得我们还有一点。我"}, {"type": "subtitle", "time": 10127.19, "timestamp": "02:48:47", "text": "我有很多现金。"}, {"type": "subtitle", "time": 10129.83, "timestamp": "02:48:49", "text": "什么？你知道，我不会告诉你们这些事"}, {"type": "subtitle", "time": 10130.83, "timestamp": "02:48:50", "text": "我的"}, {"type": "subtitle", "time": 10135.67, "timestamp": "02:48:55", "text": "现金交易。什么？这是正确的。你"}, {"type": "subtitle", "time": 10137.83, "timestamp": "02:48:57", "text": "男生们永远不会知道。好的，让我"}, {"type": "subtitle", "time": 10139.63, "timestamp": "02:48:59", "text": "去买"}]
[{"type": "subtitle", "time": 8040.31, "timestamp": "02:14:00", "text": "是啊，看看你的暗恋对象。我偷了"}, {"type": "subtitle", "time": 8042.229, "timestamp": "02:14:02", "text": "它。"}, {"type": "subtitle", "time": 8044.589, "timestamp": "02:14:04", "text": "我得到了"}, {"type": "subtitle", "time": 8048.069, "timestamp": "02:14:08", "text": "在你的第一笔交易中。哦"}, {"type": "subtitle", "time": 8052.87, "timestamp": "02:14:12", "text": "我的上帝。最后。凯尔"}, {"type": "subtitle", "time": 8055.83, "timestamp": "02:14:15", "text": "130. 这笔交易划算吗？是的。我"}, {"type": "subtitle", "time": 8058.47, "timestamp": "02:14:18", "text": "触摸我触摸50。等三。不，"}, {"type": "subtitle", "time": 8060.149, "timestamp": "02:14:20", "text": "这笔交易并不划算。她要求"}, {"type": "subtitle", "time": 8062.629, "timestamp": "02:14:22", "text": "三。是的。"}, {"type": "subtitle", "time": 8063.91, "timestamp": "02:14:23", "text": "哦，等等。这笔交易很划算。绝不"}, {"type": "subtitle", "time": 8066.31, "timestamp": "02:14:26", "text": "头脑。交易。我们想什么时候和她见面？"}, {"type": "subtitle", "time": 8070.229, "timestamp": "02:14:30", "text": "伙计们？早晨。呃，晚上睡觉。日期。晚的"}, {"type": "subtitle", "time": 8071.75, "timestamp": "02:14:31", "text": "夜晚。深夜。是啊，晚了。"}, {"type": "subtitle", "time": 8075.589, "timestamp": "02:14:35", "text": "夜晚。好的，你会获得经验值和更多金钱。"}, {"type": "subtitle", "time": 8077.83, "timestamp": "02:14:37", "text": "岛屿射击场。射击场在哪里？"}, {"type": "subtitle", "time": 8081.589, "timestamp": "02:14:41", "text": "让我们来看看。你会得到额外的钱，而且"}, {"type": "subtitle", "time": 8083.589, "timestamp": "02:14:43", "text": "凌晨4点，时间停止。所以，你有"}, {"type": "subtitle", "time": 8087.27, "timestamp": "02:14:47", "text": "有足够的时间去卖毒品。好的，"}, {"type": "subtitle", "time": 8089.51, "timestamp": "02:14:49", "text": "靶场就在附近。"}, {"type": "subtitle", "time": 8097.31, "timestamp": "02:14:57", "text": "是啊，没错"}]
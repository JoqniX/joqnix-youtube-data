[{"type": "subtitle", "time": 7620.47, "timestamp": "02:07:00", "text": "什么？去扒窃。如果你是专业人士"}, {"type": "subtitle", "time": 7623.109, "timestamp": "02:07:03", "text": "你做这件事感觉很好。哦，是的。"}, {"type": "subtitle", "time": 7626.589, "timestamp": "02:07:06", "text": "要不我扒了你屁股上的钱包？"}, {"type": "subtitle", "time": 7629.51, "timestamp": "02:07:09", "text": "不，不。"}, {"type": "subtitle", "time": 7631.51, "timestamp": "02:07:11", "text": "我该怎么做？好吧，我们还没有得到"}, {"type": "subtitle", "time": 7635.87, "timestamp": "02:07:15", "text": "任何客户要求。这有点像"}, {"type": "subtitle", "time": 7638.669, "timestamp": "02:07:18", "text": "等等，他是……他曾经是"}, {"type": "subtitle", "time": 7641.27, "timestamp": "02:07:21", "text": "死的。什么？"}, {"type": "subtitle", "time": 7644.229, "timestamp": "02:07:24", "text": "他们总是会回来再来。"}, {"type": "subtitle", "time": 7647.35, "timestamp": "02:07:27", "text": "那不是我想说的。那不是我想说的。"}, {"type": "subtitle", "time": 7650.47, "timestamp": "02:07:30", "text": "他们总是会回来的"}, {"type": "subtitle", "time": 7652.87, "timestamp": "02:07:32", "text": "无论如何，都死了。他怎么回来了？"}, {"type": "subtitle", "time": 7655.83, "timestamp": "02:07:35", "text": "尽管？这一切都是模拟。穆拉，"}, {"type": "subtitle", "time": 7656.99, "timestamp": "02:07:36", "text": "我是一名"}, {"type": "subtitle", "time": 7672.75, "timestamp": "02:07:52", "text": "再现。你错过了。你错过了"}, {"type": "subtitle", "time": 7676.91, "timestamp": "02:07:56", "text": "再次。你最终是怎么做到的"}]
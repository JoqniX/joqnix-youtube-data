[{"type": "subtitle", "time": 6902.91, "timestamp": "01:55:02", "text": "谢谢。"}, {"type": "subtitle", "time": 6917.95, "timestamp": "01:55:17", "text": "没有什么。 6美元一盒。仅售6美元。 6美元等于多少？"}, {"type": "subtitle", "time": 6928.91, "timestamp": "01:55:28", "text": "低价房间出售，仅需300美元。这并非"}, {"type": "subtitle", "time": 6934.31, "timestamp": "01:55:34", "text": "便宜的。肥龙中餐馆。"}, {"type": "subtitle", "time": 6936.149, "timestamp": "01:55:36", "text": "嘿，先生。你想试试我的"}, {"type": "subtitle", "time": 6943.109, "timestamp": "01:55:43", "text": "哦，等等。你知道那是你，奥斯汀"}, {"type": "subtitle", "time": 6945.35, "timestamp": "01:55:45", "text": "不想展示我的我的我的我的我的"}, {"type": "subtitle", "time": 6946.27, "timestamp": "01:55:46", "text": "非常"}, {"type": "subtitle", "time": 6948.03, "timestamp": "01:55:48", "text": "好的"}, {"type": "subtitle", "time": 6951.35, "timestamp": "01:55:51", "text": "图画。你们是要买土壤吗？我是"}, {"type": "subtitle", "time": 6953.189, "timestamp": "01:55:53", "text": "试图购买垃圾拾荒者。"}, {"type": "subtitle", "time": 6956.07, "timestamp": "01:55:56", "text": "我要去当垃圾收集员。"}, {"type": "subtitle", "time": 6959.51, "timestamp": "01:55:59", "text": "你就是这样的人。你这个垃圾。"}]
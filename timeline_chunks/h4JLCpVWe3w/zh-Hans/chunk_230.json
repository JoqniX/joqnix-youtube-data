[{"type": "subtitle", "time": 13815.71, "timestamp": "03:50:15", "text": "死。哦，我的"}, {"type": "subtitle", "time": 13819.11, "timestamp": "03:50:19", "text": "上帝。他说去死。"}, {"type": "subtitle", "time": 13823.11, "timestamp": "03:50:23", "text": "他说去死。我的天啊。"}, {"type": "subtitle", "time": 13831.59, "timestamp": "03:50:31", "text": "等待。我的天啊。这说明了一些问题。"}, {"type": "subtitle", "time": 13834.63, "timestamp": "03:50:34", "text": "比如，“是的。”我的天啊。咄咄逼人的言论"}, {"type": "subtitle", "time": 13837.83, "timestamp": "03:50:37", "text": "这款游戏里他表现太差了。它甚至都不"}, {"type": "subtitle", "time": 13839.91, "timestamp": "03:50:39", "text": "工作。哇。"}, {"type": "subtitle", "time": 13843.429, "timestamp": "03:50:43", "text": "我们没有带相机。"}, {"type": "subtitle", "time": 13849.91, "timestamp": "03:50:49", "text": "沙发。拿着。带走你这混蛋。拿"}, {"type": "subtitle", "time": 13852.389, "timestamp": "03:50:52", "text": "你带着灵盒。好的。患病的"}]
[{"type": "subtitle", "time": 16864.15, "timestamp": "04:41:04", "text": "哦，我想她"}, {"type": "subtitle", "time": 16866.47, "timestamp": "04:41:06", "text": "你这个贱人。"}, {"type": "subtitle", "time": 16876.708, "timestamp": "04:41:16", "text": "我。快走，快走，快到我这里来。到我这里来。去"}, {"type": "subtitle", "time": 16879.19, "timestamp": "04:41:19", "text": "大部头书。然后，呃，待在树那里。她"}, {"type": "subtitle", "time": 16881.99, "timestamp": "04:41:21", "text": "他可能知道我在哪里。好的。她是"}, {"type": "subtitle", "time": 16884.868, "timestamp": "04:41:24", "text": "朝我袭来。"}, {"type": "subtitle", "time": 16886.708, "timestamp": "04:41:26", "text": "是的。就住这儿吧。她会来找我麻烦。"}, {"type": "subtitle", "time": 16897.11, "timestamp": "04:41:37", "text": "我听到她说话了。是的，她要来，因为我"}, {"type": "subtitle", "time": 16902.31, "timestamp": "04:41:42", "text": "现在和灵盒对话了。哦，"}, {"type": "subtitle", "time": 16903.868, "timestamp": "04:41:43", "text": "他妈的蠢货"}, {"type": "subtitle", "time": 16907.35, "timestamp": "04:41:47", "text": "贱人。留下来看。你是什​​么意思"}, {"type": "subtitle", "time": 16909.67, "timestamp": "04:41:49", "text": "她退出了游戏？"}, {"type": "subtitle", "time": 16913.03, "timestamp": "04:41:53", "text": "她离开了那里"}, {"type": "subtitle", "time": 16916.788, "timestamp": "04:41:56", "text": "再次。我的天啊。"}]
[{"type": "subtitle", "time": 434.07, "timestamp": "00:07:14", "text": "而我，这些产品变成了"}, {"type": "subtitle", "time": 436.67, "timestamp": "00:07:16", "text": "随机的人喜欢喜欢"}, {"type": "subtitle", "time": 444.67, "timestamp": "00:07:24", "text": "独眼巨人。没错，它太容易上瘾了。"}, {"type": "subtitle", "time": 447.35, "timestamp": "00:07:27", "text": "也。哦，等等。我检查过吗？我忘了"}, {"type": "subtitle", "time": 449.51, "timestamp": "00:07:29", "text": "查看。是那种新型可卡因吗？"}, {"type": "subtitle", "time": 461.469, "timestamp": "00:07:41", "text": "去。马"}, {"type": "subtitle", "time": 468.87, "timestamp": "00:07:48", "text": "这里。马奶。是的，我不该这么说。"}]
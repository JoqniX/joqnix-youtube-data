[{"type": "subtitle", "time": 301.03, "timestamp": "00:05:01", "text": "四步农场。仅四种混音。这是"}, {"type": "subtitle", "time": 305.51, "timestamp": "00:05:05", "text": "就像低级低效农场一样。"}, {"type": "subtitle", "time": 308.31, "timestamp": "00:05:08", "text": "我就是在这里长大，并最终赚到数百万美元的。"}, {"type": "subtitle", "time": 312.27, "timestamp": "00:05:12", "text": "并制造甲基苯丙胺、甲烷和甲烷农场"}, {"type": "subtitle", "time": 315.11, "timestamp": "00:05:15", "text": "东西。我想，这就是我的起点吧。不是"}, {"type": "subtitle", "time": 316.83, "timestamp": "00:05:16", "text": "起点，但是"}, {"type": "subtitle", "time": 322.35, "timestamp": "00:05:22", "text": "与员工一起创造更美好的未来。所以"}, {"type": "subtitle", "time": 324.71, "timestamp": "00:05:24", "text": "是的，所有的农场都是我建的。有"}, {"type": "subtitle", "time": 326.469, "timestamp": "00:05:26", "text": "无事可做。仅仅是杀害警察和"}, {"type": "subtitle", "time": 339.749, "timestamp": "00:05:39", "text": "什么？我没有什么可以给你的。"}]
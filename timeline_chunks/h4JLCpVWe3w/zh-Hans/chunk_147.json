[{"type": "subtitle", "time": 8821.03, "timestamp": "02:27:01", "text": "好了，各位。我们必须攒够800美元。"}, {"type": "subtitle", "time": 8823.67, "timestamp": "02:27:03", "text": "好的。不错。"}, {"type": "subtitle", "time": 8825.51, "timestamp": "02:27:05", "text": "实际上，我们或许可以做到这一点。"}, {"type": "subtitle", "time": 8833.83, "timestamp": "02:27:13", "text": "你知道。我们仍然会得到"}, {"type": "subtitle", "time": 8836.27, "timestamp": "02:27:16", "text": "顾客们一个接一个地进来。"}, {"type": "subtitle", "time": 8841.71, "timestamp": "02:27:21", "text": "糟糕，我做了一个特别的"}, {"type": "subtitle", "time": 8844.71, "timestamp": "02:27:24", "text": "我用了肥料，然后推了推。"}, {"type": "subtitle", "time": 8848.55, "timestamp": "02:27:28", "text": "施肥能提高品质。所以，呃"}, {"type": "subtitle", "time": 8852.79, "timestamp": "02:27:32", "text": "你可以用那堆苦力"}, {"type": "subtitle", "time": 8854.95, "timestamp": "02:27:34", "text": "就在理发店旁边。然后我们"}, {"type": "subtitle", "time": 8857.03, "timestamp": "02:27:37", "text": "有奥斯汀。奥斯汀，你他妈的没……"}, {"type": "subtitle", "time": 8858.83, "timestamp": "02:27:38", "text": "就像我的毒品一样，"}, {"type": "subtitle", "time": 8862.309, "timestamp": "02:27:42", "text": "兄弟。又熬夜了。伟大的。好的，"}, {"type": "subtitle", "time": 8865.11, "timestamp": "02:27:45", "text": "我会去见你。紫色的那些"}, {"type": "subtitle", "time": 8867.349, "timestamp": "02:27:47", "text": "地图。你必须给他们免费样品。"}, {"type": "subtitle", "time": 8870.469, "timestamp": "02:27:50", "text": "并让他们对成为制造商产生兴趣"}, {"type": "subtitle", "time": 8872.55, "timestamp": "02:27:52", "text": "给他们找买家。"}, {"type": "subtitle", "time": 8874.79, "timestamp": "02:27:54", "text": "好的，我要去给他们。"}, {"type": "subtitle", "time": 8877.67, "timestamp": "02:27:57", "text": "一些例子。继续种植。我们"}]
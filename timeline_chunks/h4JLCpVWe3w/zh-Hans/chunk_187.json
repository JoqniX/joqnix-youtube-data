[{"type": "subtitle", "time": 11250.23, "timestamp": "03:07:30", "text": "这。我的天哪。"}, {"type": "subtitle", "time": 11252.269, "timestamp": "03:07:32", "text": "我是"}, {"type": "subtitle", "time": 11255.67, "timestamp": "03:07:35", "text": "完毕。我睡觉了。晚安，你"}, {"type": "subtitle", "time": 11257.87, "timestamp": "03:07:37", "text": "伙计们。祝你一切顺利"}, {"type": "subtitle", "time": 11262.91, "timestamp": "03:07:42", "text": "一。明天见。好的。"}]
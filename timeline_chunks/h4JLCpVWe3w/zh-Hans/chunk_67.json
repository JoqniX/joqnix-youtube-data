[{"type": "subtitle", "time": 4021.43, "timestamp": "01:07:01", "text": "伊曼今晚的计划，每次他都会……"}, {"type": "subtitle", "time": 4024.309, "timestamp": "01:07:04", "text": "今天就杀了他。呃，我知道我是"}, {"type": "subtitle", "time": 4026.15, "timestamp": "01:07:06", "text": "他自恋，但他不必打电话。"}, {"type": "subtitle", "time": 4030.549, "timestamp": "01:07:10", "text": "把我赶出去。他好像已经完蛋了。他完蛋了。"}, {"type": "subtitle", "time": 4032.39, "timestamp": "01:07:12", "text": "呃，所以我直接按了“新游戏”，对吧？"}, {"type": "subtitle", "time": 4035.27, "timestamp": "01:07:15", "text": "新游戏。是的。是的。好的。请输入姓名。"}, {"type": "subtitle", "time": 4038.63, "timestamp": "01:07:18", "text": "我们组织里怎么称呼它？"}, {"type": "subtitle", "time": 4047.109, "timestamp": "01:07:27", "text": "好的。"}, {"type": "subtitle", "time": 4048.87, "timestamp": "01:07:28", "text": "嘿，迪士尼，我们开玩笑的。请不要"}, {"type": "subtitle", "time": 4051.47, "timestamp": "01:07:31", "text": "杀了我们。我们只是开玩笑而已，伙计们。我们"}, {"type": "subtitle", "time": 4055.67, "timestamp": "01:07:35", "text": "只需阅读序章即可。不。对。哦，不。我"}, {"type": "subtitle", "time": 4057.349, "timestamp": "01:07:37", "text": "想想序言部分。可能会这么做"}, {"type": "subtitle", "time": 4059.75, "timestamp": "01:07:39", "text": "待办事项本身。就像你可以学习一样"}, {"type": "subtitle", "time": 4061.23, "timestamp": "01:07:41", "text": "待办事项。全部"}, {"type": "subtitle", "time": 4063.829, "timestamp": "01:07:43", "text": "正确的。 S：哦，那上面只写着“好的”。"}, {"type": "subtitle", "time": 4065.349, "timestamp": "01:07:45", "text": "对不起。没关系。没关系。绝不"}, {"type": "subtitle", "time": 4066.87, "timestamp": "01:07:46", "text": "头脑。我以为那是性交易"}, {"type": "subtitle", "time": 4073.27, "timestamp": "01:07:53", "text": "哦，我醒了，各位。我醒了。"}, {"type": "subtitle", "time": 4075.76, "timestamp": "01:07:55", "text": "我醒了。 灰烬和尘埃。"}, {"type": "subtitle", "time": 4078.799, "timestamp": "01:07:58", "text": "灰烬和尘埃。 我的天啊。就像《绝命毒师》一样。它是"}]
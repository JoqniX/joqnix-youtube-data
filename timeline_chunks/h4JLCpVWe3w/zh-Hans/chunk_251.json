[{"type": "subtitle", "time": 15062.67, "timestamp": "04:11:02", "text": "露丝莉。没有零活动。"}, {"type": "subtitle", "time": 15070.75, "timestamp": "04:11:10", "text": "只有当你……时，他才会回复你。"}, {"type": "subtitle", "time": 15073.59, "timestamp": "04:11:13", "text": "独自的。啊，等等。你只需等待。只是"}, {"type": "subtitle", "time": 15077.189, "timestamp": "04:11:17", "text": "请在走廊等候。我会很快过来。"}, {"type": "subtitle", "time": 15081.0, "timestamp": "04:11:21", "text": "我这就去查一下那里的电磁场强度。好的。"}, {"type": "subtitle", "time": 15093.99, "timestamp": "04:11:33", "text": "和露丝谈谈。露丝，你在这里吗？"}, {"type": "subtitle", "time": 15095.95, "timestamp": "04:11:35", "text": "我们"}, {"type": "subtitle", "time": 15108.03, "timestamp": "04:11:48", "text": "他不在。好的。无电磁场。我想要"}, {"type": "subtitle", "time": 15111.309, "timestamp": "04:11:51", "text": "向下看"}, {"type": "subtitle", "time": 15115.03, "timestamp": "04:11:55", "text": "地下室。为什么会有这个标志？等待。哦，"}, {"type": "subtitle", "time": 15117.75, "timestamp": "04:11:57", "text": "这就是我。那是我打开这该死的"}]
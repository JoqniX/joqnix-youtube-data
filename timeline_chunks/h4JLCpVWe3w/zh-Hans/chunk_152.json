[{"type": "subtitle", "time": 9121.71, "timestamp": "02:32:01", "text": "我玩完视频了。"}, {"type": "subtitle", "time": 9125.19, "timestamp": "02:32:05", "text": "游戏。快点。"}, {"type": "subtitle", "time": 9128.349, "timestamp": "02:32:08", "text": "哦，我们来了个新人。路德维希"}, {"type": "subtitle", "time": 9132.03, "timestamp": "02:32:12", "text": "再次。当然可以。当然。"}, {"type": "subtitle", "time": 9139.349, "timestamp": "02:32:19", "text": "路德维希。好了，各位。我们将要"}, {"type": "subtitle", "time": 9141.03, "timestamp": "02:32:21", "text": "我们要做一些X。好的。你"}, {"type": "subtitle", "time": 9143.67, "timestamp": "02:32:23", "text": "哥们儿，你们自己也有点儿大麻吗？"}, {"type": "subtitle", "time": 9147.11, "timestamp": "02:32:27", "text": "呃，仓库里有三个。好的。"}, {"type": "subtitle", "time": 9149.91, "timestamp": "02:32:29", "text": "你也能看到这些优惠吗？"}, {"type": "subtitle", "time": 9152.15, "timestamp": "02:32:32", "text": "是的，你也能看到这些优惠。全部"}, {"type": "subtitle", "time": 9161.11, "timestamp": "02:32:41", "text": "好的。我打算卖掉它。等等，我确实"}, {"type": "subtitle", "time": 9162.97, "timestamp": "02:32:42", "text": "看看这个人。"}, {"type": "subtitle", "time": 9169.03, "timestamp": "02:32:49", "text": "乔克。我觉得你杀的人太多了。"}, {"type": "subtitle", "time": 9173.99, "timestamp": "02:32:53", "text": "人们。不，不，不。宝还活着。"}, {"type": "subtitle", "time": 9177.99, "timestamp": "02:32:57", "text": "这里一个人也没有。乔克。什么？"}]
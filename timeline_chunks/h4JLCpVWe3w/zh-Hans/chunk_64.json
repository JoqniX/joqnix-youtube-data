[{"type": "subtitle", "time": 3840.71, "timestamp": "01:04:00", "text": "我们应该开始吗？大概吧"}, {"type": "subtitle", "time": 3842.95, "timestamp": "01:04:02", "text": "抑制住想要说“没关系”的冲动。它是"}, {"type": "subtitle", "time": 3845.27, "timestamp": "01:04:05", "text": "美好的。不用担心。哦，按我们的"}, {"type": "subtitle", "time": 3849.109, "timestamp": "01:04:09", "text": "兄弟，这是冲动。好了，冷静点，兄弟。你 你"}, {"type": "subtitle", "time": 3852.549, "timestamp": "01:04:12", "text": "笨蛋。你个混蛋。"}, {"type": "subtitle", "time": 3855.109, "timestamp": "01:04:15", "text": "各位，你们能给伊曼纽尔发点仇恨信息吗？"}, {"type": "subtitle", "time": 3858.549, "timestamp": "01:04:18", "text": "这就是他们的频道。"}, {"type": "subtitle", "time": 3859.39, "timestamp": "01:04:19", "text": "你可以吗"}, {"type": "subtitle", "time": 3863.829, "timestamp": "01:04:23", "text": "直接全面进攻？"}, {"type": "subtitle", "time": 3872.23, "timestamp": "01:04:32", "text": "瞧，这是乔克。乔是个很可爱的人。"}, {"type": "subtitle", "time": 3876.87, "timestamp": "01:04:36", "text": "他是个英俊的男人。呃，他"}, {"type": "subtitle", "time": 3879.67, "timestamp": "01:04:39", "text": "当我们在赌场赌博的时候"}, {"type": "subtitle", "time": 3885.109, "timestamp": "01:04:45", "text": "朋友家。什么？ Markiplier。"}, {"type": "subtitle", "time": 3888.47, "timestamp": "01:04:48", "text": "哦，是的。记住，他没有给"}, {"type": "subtitle", "time": 3890.87, "timestamp": "01:04:50", "text": "扯淡我们赌博的事。这样一个"}, {"type": "subtitle", "time": 3892.87, "timestamp": "01:04:52", "text": "很好的朋友。这就是每个朋友的方式"}, {"type": "subtitle", "time": 3895.349, "timestamp": "01:04:55", "text": "应该如此。保持安静。当我们"}, {"type": "subtitle", "time": 3898.15, "timestamp": "01:04:58", "text": "我们正在应对的社会现状"}]
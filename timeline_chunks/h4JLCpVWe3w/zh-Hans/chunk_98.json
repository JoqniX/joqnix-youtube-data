[{"type": "subtitle", "time": 5893.79, "timestamp": "01:38:13", "text": "我找到藏匿处了。"}, {"type": "subtitle", "time": 5896.31, "timestamp": "01:38:16", "text": "175美元。返回房车。我们回去吧"}, {"type": "subtitle", "time": 5903.83, "timestamp": "01:38:23", "text": "等待。伊曼，你的东西都带齐了吗？"}, {"type": "subtitle", "time": 5906.31, "timestamp": "01:38:26", "text": "比如包装之类的东西？我有"}, {"type": "subtitle", "time": 5909.59, "timestamp": "01:38:29", "text": "包装系统。他妈的。啊，我搞砸了"}, {"type": "subtitle", "time": 5912.95, "timestamp": "01:38:32", "text": "东西。等等，房车……快离开这里。"}, {"type": "subtitle", "time": 5916.39, "timestamp": "01:38:36", "text": "等等，我们走吧。那声音怎么样？"}, {"type": "subtitle", "time": 5919.59, "timestamp": "01:38:39", "text": "欢迎前来调查爆炸事件。"}, {"type": "subtitle", "time": 5922.39, "timestamp": "01:38:42", "text": "什么爆炸？爆炸发生在什么地方？"}, {"type": "subtitle", "time": 5925.03, "timestamp": "01:38:45", "text": "笔直，笔直，笔直。你好。"}, {"type": "subtitle", "time": 5928.229, "timestamp": "01:38:48", "text": "它是直的。等待，"}, {"type": "subtitle", "time": 5932.31, "timestamp": "01:38:52", "text": "那是房车吗？那不就是我们的所在地吗？"}, {"type": "subtitle", "time": 5934.83, "timestamp": "01:38:54", "text": "哦，不。这是"}]
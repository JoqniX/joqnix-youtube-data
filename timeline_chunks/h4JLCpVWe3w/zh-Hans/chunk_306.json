[{"type": "subtitle", "time": 18362.47, "timestamp": "05:06:02", "text": "好的。物理显现和"}, {"type": "subtitle", "time": 18364.07, "timestamp": "05:06:04", "text": "接下来在附近四处走动"}, {"type": "subtitle", "time": 18366.15, "timestamp": "05:06:06", "text": "下令杀死一名或多名玩家"}, {"type": "subtitle", "time": 18367.83, "timestamp": "05:06:07", "text": "狩猎持续时间。灯光"}, {"type": "subtitle", "time": 18370.07, "timestamp": "05:06:10", "text": "鬼影般的电流房间会闪烁。全部"}, {"type": "subtitle", "time": 18371.67, "timestamp": "05:06:11", "text": "出口门将被锁上。"}, {"type": "subtitle", "time": 18373.35, "timestamp": "05:06:13", "text": "鬼魂会引发附近所有电子设备的故障。"}, {"type": "subtitle", "time": 18375.99, "timestamp": "05:06:15", "text": "设备发生故障。一场被诅咒的狩猎"}, {"type": "subtitle", "time": 18377.67, "timestamp": "05:06:17", "text": "这是由诅咒引起的狩猎变体"}, {"type": "subtitle", "time": 18386.31, "timestamp": "05:06:26", "text": "好的。好的。狩猎结束后，就会有……"}, {"type": "subtitle", "time": 18388.948, "timestamp": "05:06:28", "text": "至少冷却25秒后再进行"}, {"type": "subtitle", "time": 18390.47, "timestamp": "05:06:30", "text": "幽灵可以尝试发起"}, {"type": "subtitle", "time": 18392.948, "timestamp": "05:06:32", "text": "又一次狩猎。"}, {"type": "subtitle", "time": 18395.35, "timestamp": "05:06:35", "text": "哦，这适用于基于理智的两种情况。"}, {"type": "subtitle", "time": 18397.43, "timestamp": "05:06:37", "text": "以及基于能力的狩猎。鬼魂"}, {"type": "subtitle", "time": 18399.03, "timestamp": "05:06:39", "text": "一旦发现这一点，就必须立即展开搜寻。"}, {"type": "subtitle", "time": 18402.868, "timestamp": "05:06:42", "text": "冷却期结束了。所以25秒后你就会"}, {"type": "subtitle", "time": 18405.91, "timestamp": "05:06:45", "text": "狩猎结束后，就可以撒盐了。"}, {"type": "subtitle", "time": 18408.15, "timestamp": "05:06:48", "text": "回去或者去那里，否则它就会开始"}, {"type": "subtitle", "time": 18411.67, "timestamp": "05:06:51", "text": "打猎。等盐放回去。所以我用了三个"}, {"type": "subtitle", "time": 18413.75, "timestamp": "05:06:53", "text": "次数。那么，你可以使用多少次？"}, {"type": "subtitle", "time": 18419.67, "timestamp": "05:06:59", "text": "又是盐？让我们看看能做多少次"}]
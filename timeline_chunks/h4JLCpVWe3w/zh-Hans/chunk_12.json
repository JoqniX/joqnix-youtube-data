[{"type": "subtitle", "time": 728.23, "timestamp": "00:12:08", "text": "是啊，还有，我的可卡因……呃，冰毒呢？去哪儿了？"}, {"type": "subtitle", "time": 730.87, "timestamp": "00:12:10", "text": "去？我需要弄到冰毒。我放了吗？"}, {"type": "subtitle", "time": 736.63, "timestamp": "00:12:16", "text": "[掌声]"}, {"type": "subtitle", "time": 746.55, "timestamp": "00:12:26", "text": "农场？我应该把它放在哪里？我该去哪里？"}, {"type": "subtitle", "time": 748.55, "timestamp": "00:12:28", "text": "留着吗？我应该把它放在哪里？我该去哪里？"}, {"type": "subtitle", "time": 773.31, "timestamp": "00:12:53", "text": "是。这是怎么回事？"}]
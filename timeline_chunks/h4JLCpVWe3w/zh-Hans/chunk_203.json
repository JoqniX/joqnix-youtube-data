[{"type": "subtitle", "time": 12182.79, "timestamp": "03:23:02", "text": "哦，是不是有人多开了一盏灯？"}, {"type": "subtitle", "time": 12184.349, "timestamp": "03:23:04", "text": "我没有转身"}, {"type": "subtitle", "time": 12192.469, "timestamp": "03:23:12", "text": "是啊，也许是苏菲。哦，苏菲是"}, {"type": "subtitle", "time": 12194.99, "timestamp": "03:23:14", "text": "这里。"}, {"type": "subtitle", "time": 12198.07, "timestamp": "03:23:18", "text": "是的。我们来到这里的原因。所以大概"}, {"type": "subtitle", "time": 12199.83, "timestamp": "03:23:19", "text": "她就像在说：“嘿，你们这些笨蛋。”他妈的"}, {"type": "subtitle", "time": 12202.15, "timestamp": "03:23:22", "text": "我。好的。"}, {"type": "subtitle", "time": 12209.269, "timestamp": "03:23:29", "text": "他妈的是什么？"}, {"type": "subtitle", "time": 12211.51, "timestamp": "03:23:31", "text": "谁拍下了这张照片？等待，"}, {"type": "subtitle", "time": 12213.99, "timestamp": "03:23:33", "text": "什么？"}, {"type": "subtitle", "time": 12215.59, "timestamp": "03:23:35", "text": "有人把一些东西打掉了"}, {"type": "subtitle", "time": 12220.429, "timestamp": "03:23:40", "text": "桌子。哦，原来是苏菲啊。"}, {"type": "subtitle", "time": 12227.03, "timestamp": "03:23:47", "text": "等等，我们找到可以用这个的东西了吗？"}, {"type": "subtitle", "time": 12229.269, "timestamp": "03:23:49", "text": "需要多少棍子？"}, {"type": "subtitle", "time": 12230.83, "timestamp": "03:23:50", "text": "不。"}, {"type": "subtitle", "time": 12235.75, "timestamp": "03:23:55", "text": "哦，快跑。多少钱？多少钱？多少？"}, {"type": "subtitle", "time": 12238.71, "timestamp": "03:23:58", "text": "多少个电磁场，笨蛋？三。我有"}]
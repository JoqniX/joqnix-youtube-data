[{"type": "subtitle", "time": 15794.59, "timestamp": "04:23:14", "text": "等待，"}, {"type": "subtitle", "time": 15796.63, "timestamp": "04:23:16", "text": "什么？好的。不，我不认为这是"}, {"type": "subtitle", "time": 15798.67, "timestamp": "04:23:18", "text": "放置的最佳地点"}, {"type": "subtitle", "time": 15806.79, "timestamp": "04:23:26", "text": "这里。不。我可以转动中间的灯吗？"}, {"type": "subtitle", "time": 15811.229, "timestamp": "04:23:31", "text": "这里？哦，是的。"}, {"type": "subtitle", "time": 15822.469, "timestamp": "04:23:42", "text": "这里。好的。"}, {"type": "subtitle", "time": 15825.91, "timestamp": "04:23:45", "text": "是的，她在那儿。呃，你能走吗？"}, {"type": "subtitle", "time": 15828.91, "timestamp": "04:23:48", "text": "把灵盒给我。"}, {"type": "subtitle", "time": 15831.63, "timestamp": "04:23:51", "text": "好的。你拿走这个"}, {"type": "subtitle", "time": 15834.389, "timestamp": "04:23:54", "text": "电磁场。如果有五级电磁场辐射，让我……"}, {"type": "subtitle", "time": 15839.79, "timestamp": "04:23:59", "text": "知道。进到那个房间去，给她打电话。"}]
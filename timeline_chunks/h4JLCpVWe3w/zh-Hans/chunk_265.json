[{"type": "subtitle", "time": 15901.269, "timestamp": "04:25:01", "text": "我在那里。我到了。这仍然是"}, {"type": "subtitle", "time": 15903.189, "timestamp": "04:25:03", "text": "打猎。"}, {"type": "subtitle", "time": 15904.63, "timestamp": "04:25:04", "text": "然后呢？是的。是的。去那里。去"}, {"type": "subtitle", "time": 15906.87, "timestamp": "04:25:06", "text": "那里。去那里。去那里。继续你的"}, {"type": "subtitle", "time": 15908.07, "timestamp": "04:25:08", "text": "正确的。"}, {"type": "subtitle", "time": 15909.75, "timestamp": "04:25:09", "text": "好的。"}, {"type": "subtitle", "time": 15912.55, "timestamp": "04:25:12", "text": "不，不要往右边走。呃，"}, {"type": "subtitle", "time": 15915.11, "timestamp": "04:25:15", "text": "左边。正确的。好的。正确的。不。是的。"}, {"type": "subtitle", "time": 15917.429, "timestamp": "04:25:17", "text": "直的。直的。直的。直的。"}, {"type": "subtitle", "time": 15919.429, "timestamp": "04:25:19", "text": "好的。直的。这里不行。左边。"}, {"type": "subtitle", "time": 15921.269, "timestamp": "04:25:21", "text": "直的。"}, {"type": "subtitle", "time": 15924.63, "timestamp": "04:25:24", "text": "哪个房间？哪个房间？呃，回来吧。"}, {"type": "subtitle", "time": 15926.75, "timestamp": "04:25:26", "text": "正确的。好的。"}, {"type": "subtitle", "time": 15929.67, "timestamp": "04:25:29", "text": "直的。确切地。在前厅。"}, {"type": "subtitle", "time": 15933.349, "timestamp": "04:25:33", "text": "前厅。前厅。好的。呃，"}, {"type": "subtitle", "time": 15934.75, "timestamp": "04:25:34", "text": "是的。直的。直行。去"}, {"type": "subtitle", "time": 15940.389, "timestamp": "04:25:40", "text": "直的。我正在看你的直播。好的。"}, {"type": "subtitle", "time": 15944.07, "timestamp": "04:25:44", "text": "你是一路走来的吗？不。走吧。"}, {"type": "subtitle", "time": 15945.99, "timestamp": "04:25:45", "text": "走吧。直的。像你一样笔直"}, {"type": "subtitle", "time": 15947.99, "timestamp": "04:25:47", "text": "走吧，你会在角落里看到我。"}, {"type": "subtitle", "time": 15950.59, "timestamp": "04:25:50", "text": "不，别回去。"}, {"type": "subtitle", "time": 15954.469, "timestamp": "04:25:54", "text": "好的。哦。哦，是的。你在这里。"}, {"type": "subtitle", "time": 15958.63, "timestamp": "04:25:58", "text": "是的。我的天啊。"}]
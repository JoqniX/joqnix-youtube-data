[{"type": "subtitle", "time": 17767.628, "timestamp": "04:56:07", "text": "给我们一个信号。"}, {"type": "subtitle", "time": 17770.07, "timestamp": "04:56:10", "text": "待办的。你在这里？你是傻瓜吗？"}, {"type": "subtitle", "time": 17775.868, "timestamp": "04:56:15", "text": "这是你吗？这是你的照片吗？"}, {"type": "subtitle", "time": 17796.23, "timestamp": "04:56:36", "text": "好的。做一件事。呃，去把"}, {"type": "subtitle", "time": 17799.83, "timestamp": "04:56:39", "text": "呃，像卡车一样的摄像头，然后带来"}, {"type": "subtitle", "time": 17805.91, "timestamp": "04:56:45", "text": "呃，灵盒。用它来说话。好的。"}, {"type": "subtitle", "time": 17808.15, "timestamp": "04:56:48", "text": "我想……哦，好吧。所以，无论你在哪里看到"}, {"type": "subtitle", "time": 17810.55, "timestamp": "04:56:50", "text": "她说的或者他说的或者别的什么，我"}, {"type": "subtitle", "time": 17812.868, "timestamp": "04:56:52", "text": "完全不知道那是什么玩意儿。呃，"}, {"type": "subtitle", "time": 17817.03, "timestamp": "04:56:57", "text": "使用电磁场检测仪检查电磁场强度。"}, {"type": "subtitle", "time": 17819.47, "timestamp": "04:56:59", "text": "降落。"}]
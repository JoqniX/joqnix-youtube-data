[{"type": "subtitle", "time": 14461.91, "timestamp": "04:01:01", "text": "所以我需要滴一滴。我会和……一起来"}, {"type": "subtitle", "time": 14464.07, "timestamp": "04:01:04", "text": "你。我跟你一起去。正确的。你只是"}, {"type": "subtitle", "time": 14466.55, "timestamp": "04:01:06", "text": "你只需要放置好摄像头，然后"}, {"type": "subtitle", "time": 14470.87, "timestamp": "04:01:10", "text": "给鬼魂拍张照片。好的。"}, {"type": "subtitle", "time": 14477.99, "timestamp": "04:01:17", "text": "记住，你需要独处一段时间。"}, {"type": "subtitle", "time": 14482.15, "timestamp": "04:01:22", "text": "这。好的。所以，等等，拿着这个。"}, {"type": "subtitle", "time": 14484.469, "timestamp": "04:01:24", "text": "拿着。我来拿相机。好的。"}, {"type": "subtitle", "time": 14485.99, "timestamp": "04:01:25", "text": "我会把照片给你。照片"}, {"type": "subtitle", "time": 14488.469, "timestamp": "04:01:28", "text": "相机。照相机。照相机。"}, {"type": "subtitle", "time": 14491.03, "timestamp": "04:01:31", "text": "是的。拿起这个灵盒，用它来……"}, {"type": "subtitle", "time": 14492.79, "timestamp": "04:01:32", "text": "记住要独处，不要交换角色"}, {"type": "subtitle", "time": 14500.469, "timestamp": "04:01:40", "text": "还有，别跑得太厉害，对吧？你会"}, {"type": "subtitle", "time": 14504.71, "timestamp": "04:01:44", "text": "气喘吁吁。哦好的。"}, {"type": "subtitle", "time": 14506.389, "timestamp": "04:01:46", "text": "当你和鬼魂说话时，你"}, {"type": "subtitle", "time": 14508.15, "timestamp": "04:01:48", "text": "需要打开摄像头。我的意思是，不是"}, {"type": "subtitle", "time": 14519.67, "timestamp": "04:01:59", "text": "好的。哦，该死。啊，真他妈的。误。"}]
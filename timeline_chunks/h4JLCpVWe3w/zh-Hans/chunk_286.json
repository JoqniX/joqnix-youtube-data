[{"type": "subtitle", "time": 17160.39, "timestamp": "04:46:00", "text": "角色将进入半径范围内"}, {"type": "subtitle", "time": 17162.868, "timestamp": "04:46:02", "text": "你看到的，是要搬动尸体的那具。"}, {"type": "subtitle", "time": 17165.19, "timestamp": "04:46:05", "text": "塑造事物的性格。"}, {"type": "subtitle", "time": 17167.35, "timestamp": "04:46:07", "text": "所以它才会有相同的情况。"}, {"type": "subtitle", "time": 17170.15, "timestamp": "04:46:10", "text": "身体上下运动的模式。"}, {"type": "subtitle", "time": 17172.788, "timestamp": "04:46:12", "text": "所以当我一踏进屋里就喜欢"}, {"type": "subtitle", "time": 17175.75, "timestamp": "04:46:15", "text": "它探测到我时，我的身体处于活动半径范围内。"}, {"type": "subtitle", "time": 17179.67, "timestamp": "04:46:19", "text": "向我袭来。好的。好的。好的。多么破碎"}, {"type": "subtitle", "time": 17184.31, "timestamp": "04:46:24", "text": "这是游戏吗？是的。真是个奇怪的bug。"}, {"type": "subtitle", "time": 17187.83, "timestamp": "04:46:27", "text": "幽灵属性是M。好的。哦。你"}, {"type": "subtitle", "time": 17189.43, "timestamp": "04:46:29", "text": "还想再玩一会儿吗？还是已经玩够了？"}, {"type": "subtitle", "time": 17192.948, "timestamp": "04:46:32", "text": "你？我的意思是，我完了。我们还可以多玩一会儿。"}, {"type": "subtitle", "time": 17195.43, "timestamp": "04:46:35", "text": "你要在那里待多久？你打算怎么待？"}, {"type": "subtitle", "time": 17199.59, "timestamp": "04:46:39", "text": "呃，好像是211，对吧？所以我可以"}, {"type": "subtitle", "time": 17204.03, "timestamp": "04:46:44", "text": "最多三个。三。好的。"}, {"type": "subtitle", "time": 17212.23, "timestamp": "04:46:52", "text": "好的。呃"}, {"type": "subtitle", "time": 17214.43, "timestamp": "04:46:54", "text": "有两个新的"}, {"type": "subtitle", "time": 17216.59, "timestamp": "04:46:56", "text": "地点。那里"}]
[{"type": "subtitle", "time": 10562.389, "timestamp": "02:56:02", "text": "我不知道我有多少小时。"}, {"type": "subtitle", "time": 10566.63, "timestamp": "02:56:06", "text": "已经通过了，就像我一开始那样。"}, {"type": "subtitle", "time": 10568.91, "timestamp": "02:56:08", "text": "3月12日。"}, {"type": "subtitle", "time": 10578.23, "timestamp": "02:56:18", "text": "好几个小时。哦，7792小时。我的天哪。"}, {"type": "subtitle", "time": 10611.91, "timestamp": "02:56:51", "text": "我邋遢得很。"}]
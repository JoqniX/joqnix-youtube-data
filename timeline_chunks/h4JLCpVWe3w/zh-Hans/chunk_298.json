[{"type": "subtitle", "time": 17884.35, "timestamp": "04:58:04", "text": "游戏提示的关键在于倾听远处的声音"}, {"type": "subtitle", "time": 17888.19, "timestamp": "04:58:08", "text": "声音。你听到远处的声音了吗？"}, {"type": "subtitle", "time": 17895.07, "timestamp": "04:58:15", "text": "声音？不，我"}, {"type": "subtitle", "time": 17899.23, "timestamp": "04:58:19", "text": "不。我没事。等等，我为什么会看到"}, {"type": "subtitle", "time": 17902.628, "timestamp": "04:58:22", "text": "艾米莉·迪克森？哦，"}, {"type": "subtitle", "time": 17905.99, "timestamp": "04:58:25", "text": "你的名字是艾米丽。"}, {"type": "subtitle", "time": 17909.43, "timestamp": "04:58:29", "text": "不，它显示的是案例概述名称。艾米丽"}, {"type": "subtitle", "time": 17911.91, "timestamp": "04:58:31", "text": "迪克森。好的，回到卡车上去。"}, {"type": "subtitle", "time": 17914.55, "timestamp": "04:58:34", "text": "核对名称。等等，什么？他们真的这么做了吗？"}, {"type": "subtitle", "time": 17916.39, "timestamp": "04:58:36", "text": "改个名字之类的？我不"}, {"type": "subtitle", "time": 17917.99, "timestamp": "04:58:37", "text": "我认为它会更改这个名字。"}, {"type": "subtitle", "time": 17926.43, "timestamp": "04:58:46", "text": "那是什么？"}, {"type": "subtitle", "time": 17928.35, "timestamp": "04:58:48", "text": "显示？"}, {"type": "subtitle", "time": 17932.31, "timestamp": "04:58:52", "text": "啊，已经不是待处理状态了。哇。什么"}, {"type": "subtitle", "time": 17934.47, "timestamp": "04:58:54", "text": "搞什么鬼？"}, {"type": "subtitle", "time": 17936.55, "timestamp": "04:58:56", "text": "我猜，我猜“待定”的意思就是"}, {"type": "subtitle", "time": 17938.55, "timestamp": "04:58:58", "text": "姓名待定。"}]
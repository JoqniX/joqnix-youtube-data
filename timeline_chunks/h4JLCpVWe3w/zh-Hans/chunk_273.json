[{"type": "subtitle", "time": 16381.189, "timestamp": "04:33:01", "text": "所以我向米奇求助，他"}, {"type": "subtitle", "time": 16382.55, "timestamp": "04:33:02", "text": "比如，“是啊，是啊，我给你发一些”"}, {"type": "subtitle", "time": 16384.15, "timestamp": "04:33:04", "text": "“现在就给我钱。”他给我寄了一些钱。"}, {"type": "subtitle", "time": 16387.269, "timestamp": "04:33:07", "text": "我喜欢吃东西，因为呃，我的"}, {"type": "subtitle", "time": 16390.269, "timestamp": "04:33:10", "text": "银行方面没有回应。哦"}, {"type": "subtitle", "time": 16392.23, "timestamp": "04:33:12", "text": "不。"}, {"type": "subtitle", "time": 16394.15, "timestamp": "04:33:14", "text": "是的。好，好，好。我明白了，我明白了"}, {"type": "subtitle", "time": 16400.31, "timestamp": "04:33:20", "text": "薄煎饼和呃鸡肉蒂卡。哦，不错。"}, {"type": "subtitle", "time": 16401.91, "timestamp": "04:33:21", "text": "是的。你知道最愚蠢的事情是什么吗？"}, {"type": "subtitle", "time": 16407.349, "timestamp": "04:33:27", "text": "你们有鸡蛋咖喱，价格是38。"}, {"type": "subtitle", "time": 16410.07, "timestamp": "04:33:30", "text": "鸡肉咖喱售价40卢比。所以"}, {"type": "subtitle", "time": 16412.949, "timestamp": "04:33:32", "text": "告诉我为什么我不愿意多付两块钱。"}, {"type": "subtitle", "time": 16414.551, "timestamp": "04:33:34", "text": "卢比，或者额外加三卢比"}, {"type": "subtitle", "time": 16417.67, "timestamp": "04:33:37", "text": "鸡肉咖喱？是的，"}, {"type": "subtitle", "time": 16424.949, "timestamp": "04:33:44", "text": "她简直就是在这里爬来爬去。"}, {"type": "subtitle", "time": 16429.83, "timestamp": "04:33:49", "text": "那具尸体。普通的Jocknik粉丝。"}, {"type": "subtitle", "time": 16432.31, "timestamp": "04:33:52", "text": "普通的Jocknik粉丝意识到这一点时"}, {"type": "subtitle", "time": 16434.07, "timestamp": "04:33:54", "text": "当他们意识到自己没看到时"}]
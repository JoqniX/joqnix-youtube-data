[{"type": "subtitle", "time": 16682.551, "timestamp": "04:38:02", "text": "哦，我能听到她的声音。哦，是的。是的。我"}, {"type": "subtitle", "time": 16685.67, "timestamp": "04:38:05", "text": "听听那个婊子是怎么回事。"}, {"type": "subtitle", "time": 16688.709, "timestamp": "04:38:08", "text": "哦，她确实是。她为什么要上楼？"}, {"type": "subtitle", "time": 16692.39, "timestamp": "04:38:12", "text": "一直都是这样吗？哦，她在那儿。看看"}, {"type": "subtitle", "time": 16694.47, "timestamp": "04:38:14", "text": "OPO。"}, {"type": "subtitle", "time": 16697.67, "timestamp": "04:38:17", "text": "是啊，我猜这该死的游戏是"}, {"type": "subtitle", "time": 16699.429, "timestamp": "04:38:19", "text": "出故障了，对吧？所以，问题是……"}, {"type": "subtitle", "time": 16701.429, "timestamp": "04:38:21", "text": "正在发生。它没有把我注册进去。"}, {"type": "subtitle", "time": 16703.029, "timestamp": "04:38:23", "text": "底层。所以，它正在记录"}, {"type": "subtitle", "time": 16704.789, "timestamp": "04:38:24", "text": "我在顶楼。所以，鬼魂是"}, {"type": "subtitle", "time": 16706.47, "timestamp": "04:38:26", "text": "到达顶部并精确到达"}, {"type": "subtitle", "time": 16709.429, "timestamp": "04:38:29", "text": "我所在的位置在一楼。"}, {"type": "subtitle", "time": 16713.75, "timestamp": "04:38:33", "text": "哦，我也这么认为。我也这么认为。我不是"}, {"type": "subtitle", "time": 16715.429, "timestamp": "04:38:35", "text": "准确的。"}, {"type": "subtitle", "time": 16717.59, "timestamp": "04:38:37", "text": "所以，那样的话，一切就结束了。"}, {"type": "subtitle", "time": 16727.029, "timestamp": "04:38:47", "text": "大概。他什么时候停止狩猎？"}, {"type": "subtitle", "time": 16729.349, "timestamp": "04:38:49", "text": "这到底是什么怪事？"}, {"type": "subtitle", "time": 16731.51, "timestamp": "04:38:51", "text": "等等，狩猎活动要持续多久？"}, {"type": "subtitle", "time": 16733.75, "timestamp": "04:38:53", "text": "再次？我完全不知道。如果你"}, {"type": "subtitle", "time": 16736.07, "timestamp": "04:38:56", "text": "你们想要我吗？我现在就可以死。等待。不，"}, {"type": "subtitle", "time": 16738.23, "timestamp": "04:38:58", "text": "不，不，不，不。好的，我去看看。"}]
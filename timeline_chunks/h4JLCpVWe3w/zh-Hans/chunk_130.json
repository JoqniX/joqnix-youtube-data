[{"type": "subtitle", "time": 7805.679, "timestamp": "02:10:05", "text": "哦，你是要乘以1.6吗？所以是68。 坚持，稍等。大麻标准。好的。"}, {"type": "subtitle", "time": 7808.239, "timestamp": "02:10:08", "text": "坚持，稍等。大麻标准。好的。 出售清单。好了。应该"}, {"type": "subtitle", "time": 7810.56, "timestamp": "02:10:10", "text": "出售清单。好了。应该 我们涨价吗？是的。是的。向上"}, {"type": "subtitle", "time": 7814.48, "timestamp": "02:10:14", "text": "我们涨价吗？是的。是的。向上 按客户要求的价格出售。糟糕。什么时候"}, {"type": "subtitle", "time": 7817.599, "timestamp": "02:10:17", "text": "按客户要求的价格出售。糟糕。什么时候 他们提出了这个要求。好的。"}, {"type": "subtitle", "time": 7820.0, "timestamp": "02:10:20", "text": "他们提出了这个要求。好的。 你可以像反交易那样做，比如"}, {"type": "subtitle", "time": 7822.4, "timestamp": "02:10:22", "text": "你可以像反交易那样做，比如 提高价格。好的，我们是"}, {"type": "subtitle", "time": 7825.119, "timestamp": "02:10:25", "text": "提高价格。好的，我们是 那我就去等顾客了。我们开始吧"}, {"type": "subtitle", "time": 7826.96, "timestamp": "02:10:26", "text": "那我就去等顾客了。我们开始吧 拿个垃圾袋。"}, {"type": "subtitle", "time": 7833.35, "timestamp": "02:10:33", "text": "爸爸，你又开始打篮球了吗？"}, {"type": "subtitle", "time": 7834.87, "timestamp": "02:10:34", "text": "不。"}, {"type": "subtitle", "time": 7846.43, "timestamp": "02:10:46", "text": "蝙蝠。哦，我还可以弄到一根球棒。"}, {"type": "subtitle", "time": 7851.47, "timestamp": "02:10:51", "text": "我杀了他。你让我付出了代价"}, {"type": "subtitle", "time": 7853.069, "timestamp": "02:10:53", "text": "医疗的"}, {"type": "subtitle", "time": 7856.95, "timestamp": "02:10:56", "text": "账单。我得付33美元。我失去了一切"}, {"type": "subtitle", "time": 7859.03, "timestamp": "02:10:59", "text": "钱。"}]
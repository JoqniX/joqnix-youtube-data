[{"type": "subtitle", "time": 10142.99, "timestamp": "02:49:02", "text": "你想要一些吗？"}, {"type": "subtitle", "time": 10151.11, "timestamp": "02:49:11", "text": "通常情况下？呃，提供一个电子邮件地址。哦，不。"}, {"type": "subtitle", "time": 10158.67, "timestamp": "02:49:18", "text": "好的，混合在哪里？"}, {"type": "subtitle", "time": 10162.11, "timestamp": "02:49:22", "text": "事物？好的，我明白了。"}, {"type": "subtitle", "time": 10165.36, "timestamp": "02:49:25", "text": "它。是时候开发一些新产品了。"}, {"type": "subtitle", "time": 10168.59, "timestamp": "02:49:28", "text": "[音乐]"}, {"type": "subtitle", "time": 10171.429, "timestamp": "02:49:31", "text": "伙计们。我的笔记本电脑发出类似……的声音"}, {"type": "subtitle", "time": 10173.23, "timestamp": "02:49:33", "text": "航空公司权利"}, {"type": "subtitle", "time": 10191.429, "timestamp": "02:49:51", "text": "混合器。如果我……哦，我放了"}, {"type": "subtitle", "time": 10194.63, "timestamp": "02:49:54", "text": "香蕉之类的东西。你不能那样做。"}, {"type": "subtitle", "time": 10196.95, "timestamp": "02:49:56", "text": "香蕉或类似"}]
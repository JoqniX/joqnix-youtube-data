[{"type": "subtitle", "time": 15363.11, "timestamp": "04:16:03", "text": "露丝莉，我听到了一声响。"}, {"type": "subtitle", "time": 15366.149, "timestamp": "04:16:06", "text": "听到声音。我听到一个声音。让我"}, {"type": "subtitle", "time": 15368.07, "timestamp": "04:16:08", "text": "看。活动内容是什么？共有三个"}, {"type": "subtitle", "time": 15370.229, "timestamp": "04:16:10", "text": "活动。好的，她在那儿。"}, {"type": "subtitle", "time": 15372.469, "timestamp": "04:16:12", "text": "好了，记住，我们只需要一个他妈的"}, {"type": "subtitle", "time": 15375.189, "timestamp": "04:16:15", "text": "图片。就是这样。就是这样。"}, {"type": "subtitle", "time": 15384.95, "timestamp": "04:16:24", "text": "呃，等等。呃，我呃，跑上楼去。"}, {"type": "subtitle", "time": 15386.389, "timestamp": "04:16:26", "text": "正确的？当她开始狩猎的时候。对，走"}, {"type": "subtitle", "time": 15388.63, "timestamp": "04:16:28", "text": "当她开始狩猎的时候。快跑上楼去"}, {"type": "subtitle", "time": 15390.79, "timestamp": "04:16:30", "text": "进入房间并关上房门。做"}, {"type": "subtitle", "time": 15392.55, "timestamp": "04:16:32", "text": "不要打开，不要发出任何声音"}, {"type": "subtitle", "time": 15394.63, "timestamp": "04:16:34", "text": "麦克风。你可以在 Discord 上发言，但是……"}, {"type": "subtitle", "time": 15396.71, "timestamp": "04:16:36", "text": "不在游戏中。关闭灵盒"}, {"type": "subtitle", "time": 15400.229, "timestamp": "04:16:40", "text": "也。我可以打开任何门，任何房间。"}, {"type": "subtitle", "time": 15403.91, "timestamp": "04:16:43", "text": "随便走进一个房间，对吧？嗯，是的，进去"}, {"type": "subtitle", "time": 15405.75, "timestamp": "04:16:45", "text": "任何房间，甚至可以去任何房间"}, {"type": "subtitle", "time": 15408.63, "timestamp": "04:16:48", "text": "进入车库，然后进入储物柜。等待，"}, {"type": "subtitle", "time": 15410.309, "timestamp": "04:16:50", "text": "灯灭了。灯光亮了"}, {"type": "subtitle", "time": 15412.309, "timestamp": "04:16:52", "text": "离开。门需要关上。"}, {"type": "subtitle", "time": 15414.95, "timestamp": "04:16:54", "text": "正确的？是的，门也会是"}, {"type": "subtitle", "time": 15417.75, "timestamp": "04:16:57", "text": "关闭。"}]
[{"type": "subtitle", "time": 11285.59, "timestamp": "03:08:05", "text": "是的。是的。他出生在这里。"}, {"type": "subtitle", "time": 11291.67, "timestamp": "03:08:11", "text": "凯文，就是这本书。等待，"}, {"type": "subtitle", "time": 11294.07, "timestamp": "03:08:14", "text": "大家都出去。只做那一个"}, {"type": "subtitle", "time": 11296.99, "timestamp": "03:08:16", "text": "男。凯文，你能听到吗？"}, {"type": "subtitle", "time": 11301.349, "timestamp": "03:08:21", "text": "我？哦，等等。我该出去吗？"}, {"type": "subtitle", "time": 11304.63, "timestamp": "03:08:24", "text": "不，你就待在这里。好的。仅有的"}, {"type": "subtitle", "time": 11306.349, "timestamp": "03:08:26", "text": "一个人去"}, {"type": "subtitle", "time": 11309.03, "timestamp": "03:08:29", "text": "出去。凯文·贝尔菲尔德。大家都出去。"}, {"type": "subtitle", "time": 11312.71, "timestamp": "03:08:32", "text": "去他妈的。去你妈的。好的。你只是"}, {"type": "subtitle", "time": 11315.269, "timestamp": "03:08:35", "text": "待在那儿。"}, {"type": "subtitle", "time": 11318.11, "timestamp": "03:08:38", "text": "凯文·贝尔菲尔德。出来吧"}, {"type": "subtitle", "time": 11320.389, "timestamp": "03:08:40", "text": "猫。出来。只能有一个"}, {"type": "subtitle", "time": 11325.59, "timestamp": "03:08:45", "text": "Bfield。凯文·贝尔菲尔德。你看起来像个"}, {"type": "subtitle", "time": 11327.83, "timestamp": "03:08:47", "text": "操"}, {"type": "subtitle", "time": 11328.83, "timestamp": "03:08:48", "text": "哦，我的"}, {"type": "subtitle", "time": 11331.91, "timestamp": "03:08:51", "text": "上帝。他正在全力追捕那个鬼魂。"}]
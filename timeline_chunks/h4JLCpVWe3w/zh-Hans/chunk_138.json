[{"type": "subtitle", "time": 8281.03, "timestamp": "02:18:01", "text": "巴特的板子在早上6点到多少之间"}, {"type": "subtitle", "time": 8283.11, "timestamp": "02:18:03", "text": "我们有吗？我们有多少个？我们有"}, {"type": "subtitle", "time": 8285.99, "timestamp": "02:18:05", "text": "目前有两笔交易。不，不。有多少个呃"}, {"type": "subtitle", "time": 8294.389, "timestamp": "02:18:14", "text": "哦，不。我们有 我们有 20。我"}, {"type": "subtitle", "time": 8299.11, "timestamp": "02:18:19", "text": "有20个。7个，对吧？我有12和7。"}, {"type": "subtitle", "time": 8301.27, "timestamp": "02:18:21", "text": "好的。 3 4. 好的，那就好。是的，"}, {"type": "subtitle", "time": 8305.83, "timestamp": "02:18:25", "text": "那挺好的。呃，整晚都在忙。"}, {"type": "subtitle", "time": 8307.589, "timestamp": "02:18:27", "text": "是的，已经定在晚上了。"}, {"type": "subtitle", "time": 8310.309, "timestamp": "02:18:30", "text": "夜晚。另外，我们来讨论一些问题。"}, {"type": "subtitle", "time": 8313.669, "timestamp": "02:18:33", "text": "从经销商处购买。有人可以点餐吗？"}, {"type": "subtitle", "time": 8317.509, "timestamp": "02:18:37", "text": "我来订餐。呃，多少钱？等等，我们"}, {"type": "subtitle", "time": 8327.83, "timestamp": "02:18:47", "text": "呃，我想买那些香烟"}, {"type": "subtitle", "time": 8330.83, "timestamp": "02:18:50", "text": "漏洞。拜托，老兄。在那里"}, {"type": "subtitle", "time": 8334.549, "timestamp": "02:18:54", "text": "去。好的。这慢慢地变成了"}]
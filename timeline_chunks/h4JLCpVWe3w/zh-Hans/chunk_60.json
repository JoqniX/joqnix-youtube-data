[{"type": "subtitle", "time": 3603.19, "timestamp": "01:00:03", "text": "好的。"}, {"type": "subtitle", "time": 3605.69, "timestamp": "01:00:05", "text": "你死定了，小子。"}, {"type": "subtitle", "time": 3612.15, "timestamp": "01:00:12", "text": "好了，我们切换到实际内容。"}, {"type": "subtitle", "time": 3614.23, "timestamp": "01:00:14", "text": "大厅场景。"}, {"type": "subtitle", "time": 3618.71, "timestamp": "01:00:18", "text": "哦，我的模型不见了。哦，天哪。我的我的"}, {"type": "subtitle", "time": 3622.47, "timestamp": "01:00:22", "text": "我的熨斗套装，型号和我一样。哦，你在这儿啊。"}, {"type": "subtitle", "time": 3625.349, "timestamp": "01:00:25", "text": "去。你们现在可以听见了。向……问好"}, {"type": "subtitle", "time": 3629.829, "timestamp": "01:00:29", "text": "查德，伙计们。打个招呼。你好。"}, {"type": "subtitle", "time": 3633.109, "timestamp": "01:00:33", "text": "好的。是的，你最好是这样。我的天哪。"}, {"type": "subtitle", "time": 3634.95, "timestamp": "01:00:34", "text": "另外，我在动漫展上没见到你。我"}, {"type": "subtitle", "time": 3636.47, "timestamp": "01:00:36", "text": "我不是要去孟买吗？"}, {"type": "subtitle", "time": 3640.349, "timestamp": "01:00:40", "text": "动漫展。我太忙了，没时间去孟买"}, {"type": "subtitle", "time": 3646.71, "timestamp": "01:00:46", "text": "打嗝。那是因为我和阿拉不能"}, {"type": "subtitle", "time": 3649.27, "timestamp": "01:00:49", "text": "想办法从地下室出去。"}, {"type": "subtitle", "time": 3651.27, "timestamp": "01:00:51", "text": "是的，尖叫者。我们出不去了"}, {"type": "subtitle", "time": 3653.829, "timestamp": "01:00:53", "text": "地下室。这就是他妈的Hello。欢迎"}, {"type": "subtitle", "time": 3656.63, "timestamp": "01:00:56", "text": "致聊天者。聊天者聊天"}, {"type": "subtitle", "time": 3659.109, "timestamp": "01:00:59", "text": "闲聊者。我在和妈妈聊天"}]
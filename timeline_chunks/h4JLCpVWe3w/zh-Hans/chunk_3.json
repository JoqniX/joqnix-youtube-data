[{"type": "subtitle", "time": 180.55, "timestamp": "00:03:00", "text": "我。嗯，我可以暂时加入一下。我当时"}, {"type": "subtitle", "time": 198.55, "timestamp": "00:03:18", "text": "嗯，是的，他们可以加入我。"}, {"type": "subtitle", "time": 200.47, "timestamp": "00:03:20", "text": "但现在无计可施了。我已经"}, {"type": "subtitle", "time": 202.63, "timestamp": "00:03:22", "text": "把所有农场都干完了。这"}, {"type": "subtitle", "time": 204.869, "timestamp": "00:03:24", "text": "这是我的可卡因农场。另一个地方是"}, {"type": "subtitle", "time": 208.149, "timestamp": "00:03:28", "text": "制毒窝点和另一个地方"}, {"type": "subtitle", "time": 211.869, "timestamp": "00:03:31", "text": "就像在前面一样"}, {"type": "subtitle", "time": 220.869, "timestamp": "00:03:40", "text": "第二。我们走吧。我会给你看……"}, {"type": "subtitle", "time": 222.82999999999998, "timestamp": "00:03:42", "text": "其他"}]
[{"type": "subtitle", "time": 8940.11, "timestamp": "02:29:00", "text": "旁边那家五金店"}, {"type": "subtitle", "time": 8942.23, "timestamp": "02:29:02", "text": "比萨店。你可以打开地图，然后你"}, {"type": "subtitle", "time": 8944.83, "timestamp": "02:29:04", "text": "可以看到慢跑"}, {"type": "subtitle", "time": 8949.469, "timestamp": "02:29:09", "text": "喜欢这种风格。嘿，伙计，你好吗？"}, {"type": "subtitle", "time": 8952.67, "timestamp": "02:29:12", "text": "这里有一些"}, {"type": "subtitle", "time": 8954.83, "timestamp": "02:29:14", "text": "标准。"}, {"type": "subtitle", "time": 8962.11, "timestamp": "02:29:22", "text": "出色地。"}, {"type": "subtitle", "time": 8966.75, "timestamp": "02:29:26", "text": "好了，快点。快点。 79% 的概率"}, {"type": "subtitle", "time": 8970.91, "timestamp": "02:29:30", "text": "成功。还不错。我们开始吧"}, {"type": "subtitle", "time": 8975.03, "timestamp": "02:29:35", "text": "去。我们拿到了假发。我的天啊。 Lwig，你"}, {"type": "subtitle", "time": 8977.51, "timestamp": "02:29:37", "text": "你不能做这种事。假发。"}, {"type": "subtitle", "time": 8979.83, "timestamp": "02:29:39", "text": "什么？"}, {"type": "subtitle", "time": 8981.83, "timestamp": "02:29:41", "text": "你是最火的主播。你必须"}, {"type": "subtitle", "time": 8982.75, "timestamp": "02:29:42", "text": "正在做"}, {"type": "subtitle", "time": 8984.99, "timestamp": "02:29:44", "text": "这。也"}, {"type": "subtitle", "time": 8988.79, "timestamp": "02:29:48", "text": "晚的。你说太迟了？为时已晚"}, {"type": "subtitle", "time": 8990.67, "timestamp": "02:29:50", "text": "说"}, {"type": "subtitle", "time": 8996.11, "timestamp": "02:29:56", "text": "对不起。我呃，我同意，这太过了。"}, {"type": "subtitle", "time": 8998.309, "timestamp": "02:29:58", "text": "晚的。好了，我要把这些垃圾装袋了。"}]
[{"type": "subtitle", "time": 4500.229, "timestamp": "01:15:00", "text": "现在是一家当铺。"}, {"type": "subtitle", "time": 4504.27, "timestamp": "01:15:04", "text": "哦，这是贩毒集团的人。"}, {"type": "subtitle", "time": 4508.39, "timestamp": "01:15:08", "text": "卡特尔？这到底是怎么回事？"}, {"type": "subtitle", "time": 4512.55, "timestamp": "01:15:12", "text": "哇。哇。哇。哇。哇。哇。"}, {"type": "subtitle", "time": 4515.11, "timestamp": "01:15:15", "text": "哇。当铺在哪里？我一直"}, {"type": "subtitle", "time": 4519.35, "timestamp": "01:15:19", "text": "忘记《绝命毒师》剧组了。喜欢，"}, {"type": "subtitle", "time": 4522.95, "timestamp": "01:15:22", "text": "我其实还没看过《绝命毒师》。"}, {"type": "subtitle", "time": 4525.51, "timestamp": "01:15:25", "text": "哦，天哪。你怎么能做出这种事？哦，我的"}, {"type": "subtitle", "time": 4528.31, "timestamp": "01:15:28", "text": "上帝。我的驾驶技术一旦你……"}, {"type": "subtitle", "time": 4529.91, "timestamp": "01:15:29", "text": "或许你应该开始看贝克尔的节目了。"}, {"type": "subtitle", "time": 4532.63, "timestamp": "01:15:32", "text": "就像，“我的天，我知道这个。我知道。”"}, {"type": "subtitle", "time": 4537.189, "timestamp": "01:15:37", "text": "我知道这一点"}, {"type": "subtitle", "time": 4538.95, "timestamp": "01:15:38", "text": "在当铺里或当铺后面"}, {"type": "subtitle", "time": 4541.11, "timestamp": "01:15:41", "text": "商店。”他来了。我的天哪。他看起来"}, {"type": "subtitle", "time": 4543.11, "timestamp": "01:15:43", "text": "就像吸毒者一样。"}, {"type": "subtitle", "time": 4548.63, "timestamp": "01:15:48", "text": "土壤。好的。等等，他是个瘾君子。"}, {"type": "subtitle", "time": 4552.95, "timestamp": "01:15:52", "text": "有点像你。哦，不。警察。警察。"}, {"type": "subtitle", "time": 4556.47, "timestamp": "01:15:56", "text": "警察。警察。警察。这一切都是"}, {"type": "subtitle", "time": 4559.51, "timestamp": "01:15:59", "text": "警察。我可以吗？哦，我想开车。"}]
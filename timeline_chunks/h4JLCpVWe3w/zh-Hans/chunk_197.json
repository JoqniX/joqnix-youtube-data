[{"type": "subtitle", "time": 11822.67, "timestamp": "03:17:02", "text": "车？它是"}, {"type": "subtitle", "time": 11836.07, "timestamp": "03:17:16", "text": "你知道你可以买到这些。是什么"}, {"type": "subtitle", "time": 11838.349, "timestamp": "03:17:18", "text": "那？是什么"}, {"type": "subtitle", "time": 11842.07, "timestamp": "03:17:22", "text": "那？等待。喵。米奇。你做了吗？"}, {"type": "subtitle", "time": 11845.07, "timestamp": "03:17:25", "text": "那声音？你看到了吗？你听到了吗？"}, {"type": "subtitle", "time": 11848.91, "timestamp": "03:17:28", "text": "那？等待。有什么东西打开了。"}, {"type": "subtitle", "time": 11852.429, "timestamp": "03:17:32", "text": "边。我觉得它低于……"}, {"type": "subtitle", "time": 11854.389, "timestamp": "03:17:34", "text": "地下室。哦，是地下室。它是"}, {"type": "subtitle", "time": 11856.87, "timestamp": "03:17:36", "text": "地下室。这是地下室。我在眨眼。"}, {"type": "subtitle", "time": 11859.429, "timestamp": "03:17:39", "text": "呃，我的手电筒在闪烁。哦，我的"}, {"type": "subtitle", "time": 11861.309, "timestamp": "03:17:41", "text": "天哪，是"}, {"type": "subtitle", "time": 11865.389, "timestamp": "03:17:45", "text": "地下室。我的天啊。你好，太空"}, {"type": "subtitle", "time": 11867.79, "timestamp": "03:17:47", "text": "猴。哦，你"}]
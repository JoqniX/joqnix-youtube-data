[{"type": "subtitle", "time": 16561.189, "timestamp": "04:36:01", "text": "等等，他们擅长恐怖片吗？"}, {"type": "subtitle", "time": 16562.789, "timestamp": "04:36:02", "text": "某物？"}, {"type": "subtitle", "time": 16564.39, "timestamp": "04:36:04", "text": "WHO？"}, {"type": "subtitle", "time": 16567.269, "timestamp": "04:36:07", "text": "一个 Kyus。"}, {"type": "subtitle", "time": 16568.709, "timestamp": "04:36:08", "text": "是的，他们很擅长恐怖片。那是"}, {"type": "subtitle", "time": 16570.629, "timestamp": "04:36:10", "text": "只有我一个人在尖叫。我当时就想，"}, {"type": "subtitle", "time": 16573.75, "timestamp": "04:36:13", "text": "“打开，打开，跑出去，然后我"}, {"type": "subtitle", "time": 16576.189, "timestamp": "04:36:16", "text": "操他妈的"}, {"type": "subtitle", "time": 16578.869, "timestamp": "04:36:18", "text": "死了。”真是太有趣了。你可以查一下"}, {"type": "subtitle", "time": 16581.51, "timestamp": "04:36:21", "text": "就像 Celeste 和 Kyra 那样的直播"}, {"type": "subtitle", "time": 16585.91, "timestamp": "04:36:25", "text": "溪流。惊人的。还有，呃，记得……"}, {"type": "subtitle", "time": 16588.551, "timestamp": "04:36:28", "text": "剪辑你的直播片段，因为这些片段很好。"}, {"type": "subtitle", "time": 16590.869, "timestamp": "04:36:30", "text": "不错的片段。不错的片段。是的，我会告诉"}, {"type": "subtitle", "time": 16594.949, "timestamp": "04:36:34", "text": "你看完直播后的一切。是的，"}, {"type": "subtitle", "time": 16597.91, "timestamp": "04:36:37", "text": "我知道。我感到震惊。为什么她会这样？但我"}, {"type": "subtitle", "time": 16602.07, "timestamp": "04:36:42", "text": "还是会让你很困扰。小心背后。"}, {"type": "subtitle", "time": 16604.949, "timestamp": "04:36:44", "text": "我真的非常确定，不，她没有。她听起来像"}, {"type": "subtitle", "time": 16608.47, "timestamp": "04:36:48", "text": "她试图把你比作电锯人。"}]
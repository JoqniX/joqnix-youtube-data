[{"type": "subtitle", "time": 4323.55, "timestamp": "01:12:03", "text": "好的。嗯，我们还是选早上吧。"}, {"type": "subtitle", "time": 4325.75, "timestamp": "01:12:05", "text": "再次。伟大的。我会在后面等你。"}, {"type": "subtitle", "time": 4328.03, "timestamp": "01:12:08", "text": "典当行"}, {"type": "subtitle", "time": 4330.87, "timestamp": "01:12:10", "text": "好的。好的。我该如何开车离开"}, {"type": "subtitle", "time": 4332.55, "timestamp": "01:12:12", "text": "尽管？"}, {"type": "subtitle", "time": 4336.149, "timestamp": "01:12:16", "text": "嗯，是的，我想你可以开车。哦。"}, {"type": "subtitle", "time": 4339.11, "timestamp": "01:12:19", "text": "哦，你可能跟纳尔逊谈过，然后"}, {"type": "subtitle", "time": 4341.51, "timestamp": "01:12:21", "text": "哦好的。好的。纳尔逊，我是说赫克托"}, {"type": "subtitle", "time": 4346.709, "timestamp": "01:12:26", "text": "赫克托，我跟一些人有点事要办。"}, {"type": "subtitle", "time": 4347.91, "timestamp": "01:12:27", "text": "那些留在楼下的人们"}, {"type": "subtitle", "time": 4349.75, "timestamp": "01:12:29", "text": "中间。我会告诉他们你是来这里做什么的"}, {"type": "subtitle", "time": 4352.95, "timestamp": "01:12:32", "text": "一个包裹。无需支付任何费用。"}, {"type": "subtitle", "time": 4354.47, "timestamp": "01:12:34", "text": "如果您想购买物资"}, {"type": "subtitle", "time": 4357.31, "timestamp": "01:12:37", "text": "你自己看着办吧，直接扔到我身上就行了。"}, {"type": "subtitle", "time": 4360.149, "timestamp": "01:12:40", "text": "标签。谢谢，兄弟。请随意拿走我的"}, {"type": "subtitle", "time": 4362.27, "timestamp": "01:12:42", "text": "卡车。哦，当然！我正在服用"}, {"type": "subtitle", "time": 4365.11, "timestamp": "01:12:45", "text": "卡车。我可以吗？我的天哪。我可以开车进去。"}, {"type": "subtitle", "time": 4377.35, "timestamp": "01:12:57", "text": "塞雷纳公寓。我应该待在那里吗？"}]
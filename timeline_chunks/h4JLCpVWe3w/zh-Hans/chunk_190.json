[{"type": "subtitle", "time": 11400.55, "timestamp": "03:10:00", "text": "他要抢我们的工作吗？"}, {"type": "subtitle", "time": 11408.67, "timestamp": "03:10:08", "text": "是的。想象一下他把我从"}, {"type": "subtitle", "time": 11412.87, "timestamp": "03:10:12", "text": "在后面。喵喵说，呃，他是个殖民者"}, {"type": "subtitle", "time": 11415.07, "timestamp": "03:10:15", "text": "这就是原因。"}, {"type": "subtitle", "time": 11436.309, "timestamp": "03:10:36", "text": "零？等等，理智到底是什么意思？"}, {"type": "subtitle", "time": 11439.19, "timestamp": "03:10:39", "text": "比如，你有多害怕？"}, {"type": "subtitle", "time": 11441.67, "timestamp": "03:10:41", "text": "还是别的什么？"}, {"type": "subtitle", "time": 11444.15, "timestamp": "03:10:44", "text": "是的，就是你花费的时间。"}, {"type": "subtitle", "time": 11446.87, "timestamp": "03:10:46", "text": "接触过超自然现象。"}, {"type": "subtitle", "time": 11448.71, "timestamp": "03:10:48", "text": "好的。好的。游戏中，你会获得药丸。"}, {"type": "subtitle", "time": 11452.91, "timestamp": "03:10:52", "text": "这可以提升你的精神状态。好的。"}]
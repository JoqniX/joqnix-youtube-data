[{"type": "subtitle", "time": 15181.51, "timestamp": "04:13:01", "text": "我听不到你说话。好的。转变精神"}, {"type": "subtitle", "time": 15184.71, "timestamp": "04:13:04", "text": "盒子也拆掉了。"}, {"type": "subtitle", "time": 15187.11, "timestamp": "04:13:07", "text": "呃，往下看。请向下看。继续前往"}, {"type": "subtitle", "time": 15190.59, "timestamp": "04:13:10", "text": "地下室。向下。"}, {"type": "subtitle", "time": 15194.309, "timestamp": "04:13:14", "text": "好的。我的天哪。是的。我要去"}, {"type": "subtitle", "time": 15197.07, "timestamp": "04:13:17", "text": "不过是地下室。好的。现在，转动你的"}, {"type": "subtitle", "time": 15200.389, "timestamp": "04:13:20", "text": "正确的。进入后右转。"}, {"type": "subtitle", "time": 15203.349, "timestamp": "04:13:23", "text": "是的。最后，去到……"}, {"type": "subtitle", "time": 15204.63, "timestamp": "04:13:24", "text": "结束了。在你的右边，你会发现一个"}, {"type": "subtitle", "time": 15209.429, "timestamp": "04:13:29", "text": "好的。"}, {"type": "subtitle", "time": 15211.189, "timestamp": "04:13:31", "text": "是的。然后你就可以开灯了。"}, {"type": "subtitle", "time": 15214.51, "timestamp": "04:13:34", "text": "为什么我打不开它？我听说"}, {"type": "subtitle", "time": 15218.07, "timestamp": "04:13:38", "text": "某人。我打不开发电机箱。"}, {"type": "subtitle", "time": 15219.189, "timestamp": "04:13:39", "text": "你的意思是说你不能打开一个"}, {"type": "subtitle", "time": 15222.229, "timestamp": "04:13:42", "text": "发电机箱？它还没开门。"}, {"type": "subtitle", "time": 15224.469, "timestamp": "04:13:44", "text": "哦，你大概是"}, {"type": "subtitle", "time": 15226.71, "timestamp": "04:13:46", "text": "决不。这里有人。比如当"}, {"type": "subtitle", "time": 15230.83, "timestamp": "04:13:50", "text": "我点击它，就听到声音了。"}, {"type": "subtitle", "time": 15233.67, "timestamp": "04:13:53", "text": "未来。什么？哦。哦。好的。我不得不"}, {"type": "subtitle", "time": 15236.55, "timestamp": "04:13:56", "text": "等等。我的天啊。"}, {"type": "subtitle", "time": 15239.349, "timestamp": "04:13:59", "text": "点不开。"}]
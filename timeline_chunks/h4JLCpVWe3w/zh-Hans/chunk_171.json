[{"type": "subtitle", "time": 10260.95, "timestamp": "02:51:00", "text": "长面白杨死亡。阿斯彭死了。什么"}, {"type": "subtitle", "time": 10265.11, "timestamp": "02:51:05", "text": "什么鬼？是的。哦，你可以……改变"}, {"type": "subtitle", "time": 10268.309, "timestamp": "02:51:08", "text": "名字就像……呃，当……的时候就退出"}, {"type": "subtitle", "time": 10271.269, "timestamp": "02:51:11", "text": "名称显示。你可以获得一个随机名字"}, {"type": "subtitle", "time": 10283.389, "timestamp": "02:51:23", "text": "是的。糟透了。耶。"}, {"type": "subtitle", "time": 10286.429, "timestamp": "02:51:26", "text": "产品。剑在哪儿？"}, {"type": "subtitle", "time": 10290.63, "timestamp": "02:51:30", "text": "柴油机？我该如何重命名它？"}, {"type": "subtitle", "time": 10294.389, "timestamp": "02:51:34", "text": "哦，很遗憾，你不能更改它的名字。"}, {"type": "subtitle", "time": 10296.71, "timestamp": "02:51:36", "text": "你只能重命名它。"}, {"type": "subtitle", "time": 10299.75, "timestamp": "02:51:39", "text": "一旦你研制出这种药物并且喜欢它"}, {"type": "subtitle", "time": 10302.389, "timestamp": "02:51:42", "text": "这表明"}, {"type": "subtitle", "time": 10306.71, "timestamp": "02:51:46", "text": "我们每次都能找到骑兵。"}, {"type": "subtitle", "time": 10311.03, "timestamp": "02:51:51", "text": "等等，我可以把红牛和饮料混在一起喝吗？是的，你可以"}, {"type": "subtitle", "time": 10313.51, "timestamp": "02:51:53", "text": "可以混合任何成分，即"}, {"type": "subtitle", "time": 10315.349, "timestamp": "02:51:55", "text": "可用、混合和最大值。那"}, {"type": "subtitle", "time": 10319.11, "timestamp": "02:51:59", "text": "垃圾？不，不是垃圾。全部"}]
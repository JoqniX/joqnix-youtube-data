[{"type": "subtitle", "time": 16920.03, "timestamp": "04:42:00", "text": "你很可疑。你很可疑。露丝"}, {"type": "subtitle", "time": 16933.75, "timestamp": "04:42:13", "text": "为什么她不是？如果你愿意，我可以去。"}, {"type": "subtitle", "time": 16937.11, "timestamp": "04:42:17", "text": "出去。不，不，不，不。你想让我打电话"}, {"type": "subtitle", "time": 16939.11, "timestamp": "04:42:19", "text": "她在这个房间里，所以你可以看到她"}, {"type": "subtitle", "time": 16942.628, "timestamp": "04:42:22", "text": "死亡动画？不，不，不。"}, {"type": "subtitle", "time": 16944.31, "timestamp": "04:42:24", "text": "我的意思是，最终，我不认为她"}, {"type": "subtitle", "time": 16946.47, "timestamp": "04:42:26", "text": "我现在就停止狩猎。你可以"}, {"type": "subtitle", "time": 16948.23, "timestamp": "04:42:28", "text": "等等，查一下，谷歌一下。持续多久？"}, {"type": "subtitle", "time": 16948.99, "timestamp": "04:42:28", "text": "拿"}, {"type": "subtitle", "time": 16951.99, "timestamp": "04:42:31", "text": "狩猎动画有多长？"}, {"type": "subtitle", "time": 16955.27, "timestamp": "04:42:35", "text": "狩猎模拟游戏？哦。哦，她是吗？哦，什么？"}, {"type": "subtitle", "time": 16959.67, "timestamp": "04:42:39", "text": "愚蠢。真是个蠢女人。"}, {"type": "subtitle", "time": 16963.19, "timestamp": "04:42:43", "text": "她为什么要上楼？"}, {"type": "subtitle", "time": 16964.868, "timestamp": "04:42:44", "text": "比如，她正在做这件事。蠢货。来"}, {"type": "subtitle", "time": 16967.11, "timestamp": "04:42:47", "text": "傻瓜，看着我。你个混蛋。蠢货。笨蛋"}, {"type": "subtitle", "time": 16970.07, "timestamp": "04:42:50", "text": "贱人。我在房间里。正确的。没错"}, {"type": "subtitle", "time": 16971.59, "timestamp": "04:42:51", "text": "没错，你这婊子。我给你"}, {"type": "subtitle", "time": 16973.708, "timestamp": "04:42:53", "text": "指示，你这个蠢货"}, {"type": "subtitle", "time": 16977.03, "timestamp": "04:42:57", "text": "人工智能。蠢货。请往下看。坠落。"}]
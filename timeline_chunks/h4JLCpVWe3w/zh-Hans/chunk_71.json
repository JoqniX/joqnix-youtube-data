[{"type": "subtitle", "time": 4262.149, "timestamp": "01:11:02", "text": "伙计们，我在抽大麻。这是"}, {"type": "subtitle", "time": 4265.27, "timestamp": "01:11:05", "text": "大麻。我的天啊。我终于成为了我理想中的自己。"}, {"type": "subtitle", "time": 4269.189, "timestamp": "01:11:09", "text": "我一直都想成为这样的人。什么？"}, {"type": "subtitle", "time": 4271.35, "timestamp": "01:11:11", "text": "你在说什么？这就是你"}, {"type": "subtitle", "time": 4273.11, "timestamp": "01:11:13", "text": "父亲教导了我。你告诉过我"}, {"type": "subtitle", "time": 4275.11, "timestamp": "01:11:15", "text": "我回想起我们刚在一起的时候"}, {"type": "subtitle", "time": 4279.75, "timestamp": "01:11:19", "text": "成长。你们强迫我们。我告诉"}, {"type": "subtitle", "time": 4282.709, "timestamp": "01:11:22", "text": "你谈起家人。又一天过去了。回应"}, {"type": "subtitle", "time": 4284.39, "timestamp": "01:11:24", "text": "通过消息传递方式与您的客户沟通"}, {"type": "subtitle", "time": 4286.669, "timestamp": "01:11:26", "text": "应用程序。如何制作制谱？"}, {"type": "subtitle", "time": 4290.55, "timestamp": "01:11:30", "text": "好的。我有安迪。我们有董。我们有"}, {"type": "subtitle", "time": 4295.11, "timestamp": "01:11:35", "text": "乔。好的。呃，我提供两个。好的。我"}, {"type": "subtitle", "time": 4297.63, "timestamp": "01:11:37", "text": "可以花60块钱买。"}, {"type": "subtitle", "time": 4301.83, "timestamp": "01:11:41", "text": "是的。什么？你唯一能做的就是与时间抗争。"}, {"type": "subtitle", "time": 4303.35, "timestamp": "01:11:43", "text": "您现在就可以做出选择。选择"}, {"type": "subtitle", "time": 4305.79, "timestamp": "01:11:45", "text": "早晨。"}, {"type": "subtitle", "time": 4308.31, "timestamp": "01:11:48", "text": "好的。加油站后面"}, {"type": "subtitle", "time": 4311.07, "timestamp": "01:11:51", "text": "6:00 和 8:00。"}, {"type": "subtitle", "time": 4313.709, "timestamp": "01:11:53", "text": "好的。"}, {"type": "subtitle", "time": 4315.63, "timestamp": "01:11:55", "text": "是的。好的。"}, {"type": "subtitle", "time": 4318.91, "timestamp": "01:11:58", "text": "早晨。蓝色的房子。"}]
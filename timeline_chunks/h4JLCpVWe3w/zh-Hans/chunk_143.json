[{"type": "subtitle", "time": 8582.91, "timestamp": "02:23:02", "text": "等等，在哪儿？哦，这边走。这边走。"}, {"type": "subtitle", "time": 8585.83, "timestamp": "02:23:05", "text": "直的。它在河边。呃，这个"}, {"type": "subtitle", "time": 8587.75, "timestamp": "02:23:07", "text": "海边。"}, {"type": "subtitle", "time": 8590.309, "timestamp": "02:23:10", "text": "哦，是的。哦，原来是那里。"}, {"type": "subtitle", "time": 8599.99, "timestamp": "02:23:19", "text": "呃，是杰西要药吗？"}, {"type": "subtitle", "time": 8601.59, "timestamp": "02:23:21", "text": "交易？"}, {"type": "subtitle", "time": 8605.83, "timestamp": "02:23:25", "text": "我打算从她那儿偷点钱。"}, {"type": "subtitle", "time": 8614.23, "timestamp": "02:23:34", "text": "杰西。那只是个玩笑。去做。"}, {"type": "subtitle", "time": 8616.469, "timestamp": "02:23:36", "text": "我扒窃失败了。你是"}, {"type": "subtitle", "time": 8620.389, "timestamp": "02:23:40", "text": "可以出售吗？不，我说过我已经做了。"}, {"type": "subtitle", "time": 8622.389, "timestamp": "02:23:42", "text": "好的。嘿，试试扒窃。尝试"}, {"type": "subtitle", "time": 8624.349, "timestamp": "02:23:44", "text": "扒窃。我做不到。"}, {"type": "subtitle", "time": 8627.87, "timestamp": "02:23:47", "text": "再次。呃，走到她身后。蹲伏"}, {"type": "subtitle", "time": 8630.63, "timestamp": "02:23:50", "text": "我会帮助他。好吧，你错过了。"}, {"type": "subtitle", "time": 8639.83, "timestamp": "02:23:59", "text": "杀了她。"}]
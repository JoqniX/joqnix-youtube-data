[{"type": "subtitle", "time": 6966.149, "timestamp": "01:56:06", "text": "，我會穿涼鞋。  好的"}, {"type": "subtitle", "time": 6974.99, "timestamp": "01:56:14", "text": "。我的藍色涼鞋。好了。完畢。"}, {"type": "subtitle", "time": 6982.229, "timestamp": "01:56:22", "text": "我已經準備好了。你好，喬克。我們他媽的為什麼會"}, {"type": "subtitle", "time": 6998.709, "timestamp": "01:56:38", "text": "選擇一樣的東西？  你好。  你好。你喜歡我的計劃嗎？我們有車嗎？我們沒有車。不，我想我們必須買。  是的，"}, {"type": "subtitle", "time": 7005.51, "timestamp": "01:56:45", "text": "我們得買。好的。好了，各位。我們可以讓迪士尼樂園成為最大的卡車，或者說，耶！伊曼在"}]
[{"type": "subtitle", "time": 12305.51, "timestamp": "03:25:05", "text": "。夥計們，我們得趕緊把這該死的房子打掃乾淨，​​兄弟。快點。  幾天時間。"}, {"type": "subtitle", "time": 12308.229, "timestamp": "03:25:08", "text": "哇。這人是誰幹的？這是你嗎？"}, {"type": "subtitle", "time": 12336.07, "timestamp": "03:25:36", "text": "不，我連那個都沒有。  你確定嗎？你的笑不能改變什麼，不，"}, {"type": "subtitle", "time": 12345.429, "timestamp": "03:25:45", "text": "我不知道。"}, {"type": "subtitle", "time": 12359.59, "timestamp": "03:25:59", "text": "不，其實我有/我沒有/我做過/我不做那個。  你"}]
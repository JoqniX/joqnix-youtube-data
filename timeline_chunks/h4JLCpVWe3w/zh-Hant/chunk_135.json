[{"type": "subtitle", "time": 8105.91, "timestamp": "02:15:05", "text": "好的。"}, {"type": "subtitle", "time": 8116.709, "timestamp": "02:15:16", "text": "哦，公用電話。我們"}, {"type": "subtitle", "time": 8129.27, "timestamp": "02:15:29", "text": "走吧。媽的。  這並非理想情況。廢話，一點沒錯"}, {"type": "subtitle", "time": 8147.99, "timestamp": "02:15:47", "text": "。城裡有個勢力強大的販毒集團。本齊一家。我早就料到他們遲早會成為問題。他們很快就會發現這一點。看來你需要找個安靜的地方待一段時間。去祭壇問他們。這就是凡人。死亡。  我會回來的。"}, {"type": "subtitle", "time": 8159.109, "timestamp": "02:15:59", "text": "哪裡？房間。之後，你需要"}]
[{"type": "subtitle", "time": 15.589, "timestamp": "00:00:15", "text": "你好。我們正在直播嗎？是的，我們是。歡迎收看第"}, {"type": "subtitle", "time": 21.51, "timestamp": "00:00:21", "text": "33 天直播的第二部分，夜間直播。好了，我要"}, {"type": "subtitle", "time": 24.75, "timestamp": "00:00:24", "text": "早點睡了。我希望如此。我祈禱"}, {"type": "subtitle", "time": 28.15, "timestamp": "00:00:28", "text": "如此。此外，我們"}, {"type": "subtitle", "time": 30.83, "timestamp": "00:00:30", "text": "在這款遊戲中取得了巨大的進步。它既"}, {"type": "subtitle", "time": 36.03, "timestamp": "00:00:36", "text": "好玩又讓人上癮"}, {"type": "subtitle", "time": 38.19, "timestamp": "00:00:38", "text": "。"}, {"type": "subtitle", "time": 41.869, "timestamp": "00:00:41", "text": "是的，它既讓人上癮又很"}, {"type": "subtitle", "time": 45.63, "timestamp": "00:00:45", "text": "有趣。而且也很好"}, {"type": "subtitle", "time": 49.11, "timestamp": "00:00:49", "text": "。問題是我"}, {"type": "subtitle", "time": 53.029, "timestamp": "00:00:53", "text": "現在太睏了。喝醉了睡著了。我覺得身體"}, {"type": "subtitle", "time": 55.709, "timestamp": "00:00:55", "text": "很累。我感覺自己隨時都會暈倒"}, {"type": "subtitle", "time": 58.31, "timestamp": "00:00:58", "text": "。但我的朋友們也在玩"}]
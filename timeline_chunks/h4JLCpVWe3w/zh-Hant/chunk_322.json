[{"type": "subtitle", "time": 19324.23, "timestamp": "05:22:04", "text": "所以溫度沒有下降。呃，我怎麼知道狩獵還在繼續？總活動量。用那個。用攝影機。網路"}, {"type": "subtitle", "time": 19335.99, "timestamp": "05:22:15", "text": "攝影機.好的。能"}, {"type": "subtitle", "time": 19341.35, "timestamp": "05:22:21", "text": "聽到她的聲音。什麼鬼？我們要用攝影機。什麼？哦，因為你可能已經死了。回來。回來。好的"}, {"type": "subtitle", "time": 19350.07, "timestamp": "05:22:30", "text": "，如果她停止走動，我會告訴她。"}, {"type": "subtitle", "time": 19361.03, "timestamp": "05:22:41", "text": "嗯？好的。天哪，"}, {"type": "subtitle", "time": 19364.39, "timestamp": "05:22:44", "text": "這房子真讓人痛苦。我腎上腺素飆升。喜歡。喜歡這個遊戲。對，就待在角落。你會看到她朝我"}, {"type": "subtitle", "time": 19375.91, "timestamp": "05:22:55", "text": "走過來。好的。她知道你在這裡。我的意思是，是的。"}, {"type": "subtitle", "time": 19379.15, "timestamp": "05:22:59", "text": "這就是她繼續追殺我的原因。我動不了。我什麼都做不了。哦，我聽到她來了。好的，回到我的地方，看著我，這樣我的天"}]
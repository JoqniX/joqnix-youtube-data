[{"type": "subtitle", "time": 4745.83, "timestamp": "01:19:05", "text": "壓抑自己說"}, {"type": "subtitle", "time": 4748.709, "timestamp": "01:19:08", "text": "髒話的衝動？沒關係。沒關係。不用擔心。哦"}, {"type": "subtitle", "time": 4758.229, "timestamp": "01:19:18", "text": "，兄弟，我們這是在滿足自己的慾望。好了"}, {"type": "subtitle", "time": 4777.189, "timestamp": "01:19:37", "text": "，冷靜點，兄弟。你這個混蛋。你個混蛋。  各位，"}, {"type": "subtitle", "time": 4780.07, "timestamp": "01:19:40", "text": "你們能給伊曼紐爾發點仇恨訊息嗎？  這"}, {"type": "subtitle", "time": 4782.669, "timestamp": "01:19:42", "text": "就是他們的"}, {"type": "subtitle", "time": 4786.55, "timestamp": "01:19:46", "text": "頻道。  你"}, {"type": "subtitle", "time": 4798.63, "timestamp": "01:19:58", "text": "能直接對他們發動全面攻擊嗎？  不，不，他們什麼都不配得到"}]
[{"type": "subtitle", "time": 12128.95, "timestamp": "03:22:08", "text": "想把東西賣給唐娜，老兄。快點。他逃走是因為你，伊馮。  你又死了。哦。"}, {"type": "subtitle", "time": 12132.469, "timestamp": "03:22:12", "text": "哦，等等，等等，等等，等等。我偷的。我從"}, {"type": "subtitle", "time": 12139.269, "timestamp": "03:22:19", "text": "唐娜那裡偷來的。  你偷了他的東西？他偷了"}, {"type": "subtitle", "time": 12166.309, "timestamp": "03:22:46", "text": "。  我參與了你的"}, {"type": "subtitle", "time": 12169.51, "timestamp": "03:22:49", "text": "第一筆交易。我的天啊。最後。 Kell ke 130。這價格划算嗎"}]
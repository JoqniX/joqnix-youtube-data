[{"type": "subtitle", "time": 29162.388, "timestamp": "08:06:02", "text": "名，電子郵件，就像週二那天一樣，情況更糟，那真是"}, {"type": "subtitle", "time": 29182.868, "timestamp": "08:06:22", "text": "痛苦不堪，就像我的……該怎麼稱呼它呢，是蜜蜂嗎？ 或者，是的，就像我"}, {"type": "subtitle", "time": 29192.51, "timestamp": "08:06:32", "text": "真的……我想，就像幾個朋友或者某個人……在跟我開玩笑什麼的"}, {"type": "subtitle", "time": 29200.15, "timestamp": "08:06:40", "text": "。他們好像把我的地址和"}, {"type": "subtitle", "time": 29211.23, "timestamp": "08:06:51", "text": "輪胎都貼出來了，我當時就想，「我的天哪，"}]
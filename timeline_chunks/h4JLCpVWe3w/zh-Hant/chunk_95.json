[{"type": "subtitle", "time": 5710.91, "timestamp": "01:35:10", "text": "嗯，嗯，是的。  是"}, {"type": "subtitle", "time": 5718.39, "timestamp": "01:35:18", "text": "的，我"}, {"type": "subtitle", "time": 5721.39, "timestamp": "01:35:21", "text": "明白了。我得到了它。  嘿。"}, {"type": "subtitle", "time": 5724.709, "timestamp": "01:35:24", "text": "嘿，安迪。幹得好。交易完成。呃，物品"}, {"type": "subtitle", "time": 5727.75, "timestamp": "01:35:27", "text": "拆分。若要行動消費者，請右鍵點選、拖曳並捲動項目。好的。  滾動。我該"}, {"type": "subtitle", "time": 5752.31, "timestamp": "01:35:52", "text": "哦好的"}, {"type": "subtitle", "time": 5754.669, "timestamp": "01:35:54", "text": "。點擊右鍵。"}, {"type": "subtitle", "time": 5757.51, "timestamp": "01:35:57", "text": "我以為是滑鼠左鍵點擊。"}]
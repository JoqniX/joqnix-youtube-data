[{"type": "subtitle", "time": 11412.87, "timestamp": "03:10:12", "text": "甜甜圈。唐娜也喜歡毒品。是啊，但她得主動"}, {"type": "subtitle", "time": 11444.15, "timestamp": "03:10:44", "text": "你提供"}, {"type": "subtitle", "time": 11446.87, "timestamp": "03:10:46", "text": "免費樣品。是的"}, {"type": "subtitle", "time": 11448.71, "timestamp": "03:10:48", "text": "，我之前送過免費樣品"}, {"type": "subtitle", "time": 11452.91, "timestamp": "03:10:52", "text": "。  哦，傑西來了。哦，嗨，傑西。  傑西？傑西？哦，那是另一種傑西"}]
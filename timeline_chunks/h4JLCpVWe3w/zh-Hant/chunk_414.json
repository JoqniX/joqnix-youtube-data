[{"type": "subtitle", "time": 24851.95, "timestamp": "06:54:11", "text": "。是"}, {"type": "subtitle", "time": 24857.708, "timestamp": "06:54:17", "text": "熊貓先生。熊貓先生通常是一隻非常溫順的貓。"}, {"type": "subtitle", "time": 24861.548, "timestamp": "06:54:21", "text": "只有偶爾，某首歌會突然無緣無故地響起，然後他就會發瘋。身材高大啊？他身材高大。"}, {"type": "subtitle", "time": 24881.708, "timestamp": "06:54:41", "text": "[音樂] Biggie，給我一個大塊頭"}, {"type": "subtitle", "time": 24893.788, "timestamp": "06:54:53", "text": "[音樂] 傢伙。知道了。"}]
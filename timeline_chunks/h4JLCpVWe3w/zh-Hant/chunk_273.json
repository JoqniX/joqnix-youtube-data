[{"type": "subtitle", "time": 16381.189, "timestamp": "04:33:01", "text": "說一下，我原本應該10點睡覺的。"}, {"type": "subtitle", "time": 16382.55, "timestamp": "04:33:02", "text": "沒關係。"}, {"type": "subtitle", "time": 16384.15, "timestamp": "04:33:04", "text": "現在是1點。我參加了這次合作活動。謝天謝地，一切順利。"}, {"type": "subtitle", "time": 16394.15, "timestamp": "04:33:14", "text": "我當時很擔心自己會因為"}, {"type": "subtitle", "time": 16407.349, "timestamp": "04:33:27", "text": "睡意朦朧而說出蠢話，但我很高興我這麼做了"}, {"type": "subtitle", "time": 16429.83, "timestamp": "04:33:49", "text": "音樂] 嗯嗯。"}]
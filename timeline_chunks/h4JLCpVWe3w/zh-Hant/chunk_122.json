[{"type": "subtitle", "time": 7334.87, "timestamp": "02:02:14", "text": "接受"}, {"type": "subtitle", "time": 7361.91, "timestamp": "02:02:41", "text": "這是誰？  哦，等等。夥計們，我也不知道。我認為她想加入我們。你要跟我們一起去。你。"}, {"type": "subtitle", "time": 7369.669, "timestamp": "02:02:49", "text": "我們沒有機會。  夥計們，咱們去噴泉那兒吧。那裡藏著錢。納爾遜。納爾遜叔叔告訴我的。"}]
[{"type": "subtitle", "time": 4472.07, "timestamp": "01:14:32", "text": "我的天哪。"}, {"type": "subtitle", "time": 4473.75, "timestamp": "01:14:33", "text": "另外，我在動漫展沒見到你"}, {"type": "subtitle", "time": 4484.709, "timestamp": "01:14:44", "text": "。我不打算去孟買動漫展。我太忙了，沒時間去孟買那次。"}, {"type": "subtitle", "time": 4488.229, "timestamp": "01:14:48", "text": "打嗝。那是因為我和阿拉不知道怎麼才能從地下室出去。  是的，尖叫者。我們"}, {"type": "subtitle", "time": 4496.79, "timestamp": "01:14:56", "text": "出不去"}]
[{"type": "subtitle", "time": 28200.83, "timestamp": "07:50:00", "text": "笨蛋一樣。的。不，"}, {"type": "subtitle", "time": 28204.788, "timestamp": "07:50:04", "text": "我需要"}, {"type": "subtitle", "time": 28208.07, "timestamp": "07:50:08", "text": "去買那個。雖然有點痛苦，但事情就是這樣。笨蛋，笨蛋，任何人，別再"}, {"type": "subtitle", "time": 28211.19, "timestamp": "07:50:11", "text": "拖延了。  再見。再見。  對我來說，音樂。是的。大家好。是的。你好。是的。  [音樂] 你好。所以，今天我有點遲到了，"}, {"type": "subtitle", "time": 28240.868, "timestamp": "07:50:40", "text": "不過是的。  我的天啊。我依然是對的。好的。好的。  好的。  好的。是的。我們打算再出去散步。我的天哪。"}]
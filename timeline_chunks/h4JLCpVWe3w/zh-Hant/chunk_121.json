[{"type": "subtitle", "time": 7283.91, "timestamp": "02:01:23", "text": "叔叔還活著。  想揍這個人一頓。  哦，等等。他在哪裡？被困在這裡，一股難聞的氣味。給我們錢。呃，等等，"}, {"type": "subtitle", "time": 7294.07, "timestamp": "02:01:34", "text": "我弄到了一些"}, {"type": "subtitle", "time": 7296.149, "timestamp": "02:01:36", "text": "現金。嘿，寶貝。"}, {"type": "subtitle", "time": 7299.669, "timestamp": "02:01:39", "text": "等等，我們可以選嗎"}, {"type": "subtitle", "time": 7302.709, "timestamp": "02:01:42", "text": "？不，"}, {"type": "subtitle", "time": 7311.629, "timestamp": "02:01:51", "text": "市中心區域必須解鎖。滾開。"}]
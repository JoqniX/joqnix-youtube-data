[{"type": "subtitle", "time": 5460.95, "timestamp": "01:31:00", "text": "夥計們，我在抽大麻。這是大麻。我的天啊。我終於成為我一直以來都想成為的人了。什麼？  你在說什麼？父親，這是您教我的。這是你小時候告訴我的。"}, {"type": "subtitle", "time": 5466.07, "timestamp": "01:31:06", "text": "你們強迫我們"}, {"type": "subtitle", "time": 5470.47, "timestamp": "01:31:10", "text": "。我跟你講過家庭的事。又一天過去了。透過即時通訊應用程式回覆"}, {"type": "subtitle", "time": 5476.709, "timestamp": "01:31:16", "text": "您的客戶。如何製作製譜？  好的"}, {"type": "subtitle", "time": 5492.629, "timestamp": "01:31:32", "text": "。我有安迪。我們有"}, {"type": "subtitle", "time": 5510.629, "timestamp": "01:31:50", "text": "董。我們有喬。好的。呃，我提供兩個。好的。我可以出60塊買它。  是的。什麼？你唯一能做的就是與時間抗爭。  您現在就可以做出選擇。選擇"}, {"type": "subtitle", "time": 5517.59, "timestamp": "01:31:57", "text": "上午。  好的。早上6點到"}]
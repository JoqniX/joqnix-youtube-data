[{"type": "subtitle", "time": 28337.868, "timestamp": "07:52:17", "text": "應該把它拿出來，因為我看起來很尷尬"}, {"type": "subtitle", "time": 28341.59, "timestamp": "07:52:21", "text": "。"}, {"type": "subtitle", "time": 28349.19, "timestamp": "07:52:29", "text": "它軟乎乎的，但又亂糟糟的。  快完成了。只剩下哈希值。我畫了那棵樹。"}, {"type": "subtitle", "time": 28357.27, "timestamp": "07:52:37", "text": "我完成了這場"}]
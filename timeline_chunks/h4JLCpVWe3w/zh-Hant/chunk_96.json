[{"type": "subtitle", "time": 5764.31, "timestamp": "01:36:04", "text": "按住Shift鍵並點選滑鼠右鍵可以選取單一物品。  好的。哦。哦好的。是的，我明白了。"}, {"type": "subtitle", "time": 5773.75, "timestamp": "01:36:13", "text": "但是"}, {"type": "subtitle", "time": 5776.629, "timestamp": "01:36:16", "text": "，如果您按住滑鼠右鍵，則可以使用滾輪來增加或減少數量"}, {"type": "subtitle", "time": 5779.669, "timestamp": "01:36:19", "text": "。該死。是的。  是的。我的滑鼠滾輪破了。"}, {"type": "subtitle", "time": 5783.59, "timestamp": "01:36:23", "text": "哦。"}, {"type": "subtitle", "time": 5790.709, "timestamp": "01:36:30", "text": "呃，去"}, {"type": "subtitle", "time": 5802.709, "timestamp": "01:36:42", "text": "你的，伊曼。這都是你的錯。  然後按住Shift鍵點選右鍵。所以我還可以再加一個。  讓我查一下。好的，我"}, {"type": "subtitle", "time": 5809.109, "timestamp": "01:36:49", "text": "找到喬了。等等，不對，那是安迪。"}, {"type": "subtitle", "time": 5818.95, "timestamp": "01:36:58", "text": "呃，好的。我們現在得去當舖了。  哦，這是販毒集團的人。"}]
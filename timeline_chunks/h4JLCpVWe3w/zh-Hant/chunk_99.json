[{"type": "subtitle", "time": 5962.629, "timestamp": "01:39:22", "text": "我可以殺了它們嗎？  兄弟，我殺了他。對不起。當然。我殺了他。我的天啊。警察。我的天啊。我現在正開車經過這裡。請。請。  哦，"}, {"type": "subtitle", "time": 5968.629, "timestamp": "01:39:28", "text": "不。你甚至在其他遊戲中也開始殺人。"}, {"type": "subtitle", "time": 5979.43, "timestamp": "01:39:39", "text": "不。我的天哪。你"}, {"type": "subtitle", "time": 5995.109, "timestamp": "01:39:55", "text": "不能躺在那裡"}]
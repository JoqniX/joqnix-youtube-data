[{"type": "subtitle", "time": 18847.43, "timestamp": "05:14:07", "text": "遊戲裡不要說話，對吧？"}, {"type": "subtitle", "time": 18855.43, "timestamp": "05:14:15", "text": "這樣她就听不到"}, {"type": "subtitle", "time": 18868.31, "timestamp": "05:14:28", "text": "你說話了。好的。是的，你現在知道了。發電機在哪裡？好的。是的，那我應該去那裡。"}, {"type": "subtitle", "time": 18873.75, "timestamp": "05:14:33", "text": "哦，我看到一個光球。取出日記本，放入寶珠。"}, {"type": "subtitle", "time": 18875.91, "timestamp": "05:14:35", "text": "喬克。  一本日記。"}, {"type": "subtitle", "time": 18885.43, "timestamp": "05:14:45", "text": "證據。是的。幽靈寶珠。  還要加上一個靈盒。靈盒。"}, {"type": "subtitle", "time": 18887.67, "timestamp": "05:14:47", "text": "你開著Kai嗎？我好像聽到"}, {"type": "subtitle", "time": 18890.628, "timestamp": "05:14:50", "text": "什麼了？呃"}, {"type": "subtitle", "time": 18895.75, "timestamp": "05:14:55", "text": "，不。請勿使用。好的。你聽到什麼了嗎？來。  過來。跟我來"}]
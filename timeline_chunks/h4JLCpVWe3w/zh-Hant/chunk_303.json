[{"type": "subtitle", "time": 18181.43, "timestamp": "05:03:01", "text": "走吧。我的天哪。是啊。是啊。是啊。這邊。哪裡？這邊。好的。等等。我來了。"}, {"type": "subtitle", "time": 18195.27, "timestamp": "05:03:15", "text": "拍照。"}, {"type": "subtitle", "time": 18198.47, "timestamp": "05:03:18", "text": "記住，每當他出現，每當你看到光亮，就拍照。我想和你談談。過來。讓他出來。出來。露個面。"}, {"type": "subtitle", "time": 18217.67, "timestamp": "05:03:37", "text": "你能露個面嗎？好的。記住要迅速關掉你的相機。"}, {"type": "subtitle", "time": 18238.788, "timestamp": "05:03:58", "text": "嗯？每當它出現的時候。我想我需要放下我的……呃手電筒。 。"}]
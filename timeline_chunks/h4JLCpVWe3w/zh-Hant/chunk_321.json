[{"type": "subtitle", "time": 19294.788, "timestamp": "05:21:34", "text": "我的天啊。  用手電筒。你有手電筒。  哦。"}, {"type": "subtitle", "time": 19301.83, "timestamp": "05:21:41", "text": "哦，我"}, {"type": "subtitle", "time": 19304.39, "timestamp": "05:21:44", "text": "確實有一個手電筒。  好的。等等。所以，幫我個忙吧。去卡車那邊看看狩獵結束了沒有。"}, {"type": "subtitle", "time": 19312.31, "timestamp": "05:21:52", "text": "好的。好的。溫度會下降。"}]
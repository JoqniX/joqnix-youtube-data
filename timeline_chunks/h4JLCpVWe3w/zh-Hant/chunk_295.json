[{"type": "subtitle", "time": 17707.67, "timestamp": "04:55:07", "text": "我在哪兒？哦，為什麼會這樣？為什麼我躲在角落裡，而我的隊友們卻在那邊拼命掙扎，"}, {"type": "subtitle", "time": 17713.59, "timestamp": "04:55:13", "text": "竭盡全力？我心想，“我的天啊，我真的適合這份捉鬼工作嗎？ 」三，二，一，開始。"}, {"type": "subtitle", "time": 17715.99, "timestamp": "04:55:15", "text": "我"}, {"type": "subtitle", "time": 17728.628, "timestamp": "04:55:28", "text": "不在乎要去"}, {"type": "subtitle", "time": 17735.59, "timestamp": "04:55:35", "text": "哪裡"}, {"type": "subtitle", "time": 17738.628, "timestamp": "04:55:38", "text": "。回房間來。你是認真的嗎？"}]
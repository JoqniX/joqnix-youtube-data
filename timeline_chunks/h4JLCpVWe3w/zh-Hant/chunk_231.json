[{"type": "subtitle", "time": 13877.189, "timestamp": "03:51:17", "text": "再見，傑西。那我喝點可樂，然後吐到她臉上"}, {"type": "subtitle", "time": 13878.469, "timestamp": "03:51:18", "text": "。"}, {"type": "subtitle", "time": 13882.59, "timestamp": "03:51:22", "text": "哦，傑西。"}, {"type": "subtitle", "time": 13889.99, "timestamp": "03:51:29", "text": "。約翰，別再調查了。跑步。  我要去"}, {"type": "subtitle", "time": 13903.51, "timestamp": "03:51:43", "text": "汽車旅館。那"}]
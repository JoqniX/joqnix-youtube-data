[{"type": "subtitle", "time": 8165.91, "timestamp": "02:16:05", "text": "一些東西。哦，我們得付費打電話。過來。好的。我們得去汽車旅館。去汽車旅館。  這是"}, {"type": "subtitle", "time": 8205.19, "timestamp": "02:16:45", "text": "汽車旅館。  汽車旅館。好的，我們直走吧。是的。  警方宵禁持續到凌晨5點。夥計們，我們得離開這裡。我想知道你是否可以……哦，那裡有"}, {"type": "subtitle", "time": 8207.99, "timestamp": "02:16:47", "text": "個"}, {"type": "subtitle", "time": 8209.669, "timestamp": "02:16:49", "text": "警察局。我可以"}, {"type": "subtitle", "time": 8212.389, "timestamp": "02:16:52", "text": "報警嗎"}, {"type": "subtitle", "time": 8214.709, "timestamp": "02:16:54", "text": "？  為什麼要報警？  貝利。"}]
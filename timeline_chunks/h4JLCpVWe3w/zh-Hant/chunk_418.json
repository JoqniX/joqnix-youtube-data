[{"type": "subtitle", "time": 25091.548, "timestamp": "06:58:11", "text": "？  哦。哦。哦。知道了。知道了。知道了。知道了。知道了。知道了。知道了。"}, {"type": "subtitle", "time": 25094.548, "timestamp": "06:58:14", "text": "我的天啊。  知道了。"}, {"type": "subtitle", "time": 25102.86, "timestamp": "06:58:22", "text": "核桃。這是一隻蚊子貓。他喜歡藏東西。它看起來"}, {"type": "subtitle", "time": 25128.07, "timestamp": "06:58:48", "text": "好的。你"}, {"type": "subtitle", "time": 25133.628, "timestamp": "06:58:53", "text": "看著他。  [音樂]我的滑鼠有時不聽我的指揮。 [音樂]。"}]
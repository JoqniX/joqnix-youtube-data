[{"type": "subtitle", "time": 14100.79, "timestamp": "03:55:00", "text": "搞什麼鬼？  等等，我被打到了。好的。  [音樂] 好了，各位。"}, {"type": "subtitle", "time": 14105.429, "timestamp": "03:55:05", "text": "我們必須存夠800美元。  好的。不錯。  實際上，"}, {"type": "subtitle", "time": 14154.71, "timestamp": "03:55:54", "text": "我們或許可以透過賣"}, {"type": "subtitle", "time": 14157.75, "timestamp": "03:55:57", "text": "垃圾來獲得現金。我們仍然會陸續"}]
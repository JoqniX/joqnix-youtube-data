[{"type": "subtitle", "time": 19023.59, "timestamp": "05:17:03", "text": "打開了。她來了。我的天哪。冷靜下來。  她在水槽裡的馬桶里拉屎了。  過來。我出去。"}, {"type": "subtitle", "time": 19036.23, "timestamp": "05:17:16", "text": "記住，從這間浴室給她打電話，拍張照片，然後跟我走。跟我來。她每次出來的時候。現在"}, {"type": "subtitle", "time": 19042.868, "timestamp": "05:17:22", "text": "，呃，"}, {"type": "subtitle", "time": 19046.31, "timestamp": "05:17:26", "text": "你跑。  你看到這個車庫了嗎？請點擊此處。"}, {"type": "subtitle", "time": 19053.75, "timestamp": "05:17:33", "text": "進入這個區域，然後像這樣關閉它。是的。這樣她就"}, {"type": "subtitle", "time": 19056.948, "timestamp": "05:17:36", "text": "追捕不到你了。  好的。有四個運動員。共有四項活動。你所在的位置正好降到了2。她就在浴室裡。哦"}, {"type": "subtitle", "time": 19067.43, "timestamp": "05:17:47", "text": "，它在閃爍。  它在"}, {"type": "subtitle", "time": 19071.19, "timestamp": "05:17:51", "text": "閃爍。露絲，你在嗎？露絲，你在嗎？進去。  迅速"}]
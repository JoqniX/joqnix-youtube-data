[{"type": "subtitle", "time": 17581.75, "timestamp": "04:53:01", "text": "桌子上的東西"}, {"type": "subtitle", "time": 17590.31, "timestamp": "04:53:10", "text": "打翻了。哦，所以是索菲，然後是索菲。等等，"}, {"type": "subtitle", "time": 17600.47, "timestamp": "04:53:20", "text": "我們找到什麼東西可以用了嗎？堅持嗎？不。哦，"}, {"type": "subtitle", "time": 17608.868, "timestamp": "04:53:28", "text": "快跑。多少錢？少電磁場，笨蛋？ 三個。"}, {"type": "subtitle", "time": 17613.43, "timestamp": "04:53:33", "text": "手電筒。知道怎麼做。那是什麼？尖叫"}, {"type": "subtitle", "time": 17633.67, "timestamp": "04:53:53", "text": "想讓我哭。 ，天哪。"}]
[{"type": "subtitle", "time": 10321.269, "timestamp": "02:52:01", "text": "材料。ゴミは入れない。できません"}, {"type": "subtitle", "time": 10323.83, "timestamp": "02:52:03", "text": "ガソリン。待って、もし私が混ぜたらどうなる？"}, {"type": "subtitle", "time": 10326.87, "timestamp": "02:52:06", "text": "アスペンでレッドブルを飲んで死亡？はい、できます"}, {"type": "subtitle", "time": 10331.51, "timestamp": "02:52:11", "text": "そうしてください。 「何だって？」って思うよね？わかった。"}, {"type": "subtitle", "time": 10333.19, "timestamp": "02:52:13", "text": "喫煙することもできますし"}, {"type": "subtitle", "time": 10336.389, "timestamp": "02:52:16", "text": "その効果を見てください。うん。"}, {"type": "subtitle", "time": 10339.309, "timestamp": "02:52:19", "text": "よし。それを入れる"}, {"type": "subtitle", "time": 10341.19, "timestamp": "02:52:21", "text": "そこには。最大限に活用するつもりです"}, {"type": "subtitle", "time": 10344.75, "timestamp": "02:52:24", "text": "複雑な薬"}, {"type": "subtitle", "time": 10347.55, "timestamp": "02:52:27", "text": "ここ。アスペン"}, {"type": "subtitle", "time": 10359.269, "timestamp": "02:52:39", "text": "ニース。これ吸ってみるべき？吸ってみて。"}, {"type": "subtitle", "time": 10369.429, "timestamp": "02:52:49", "text": "おお。あら、あなたの顔が大きくなったみたいね。私の"}, {"type": "subtitle", "time": 10371.91, "timestamp": "02:52:51", "text": "顔。そうそう。そうそう。あなたの長い"}, {"type": "subtitle", "time": 10375.59, "timestamp": "02:52:55", "text": "顔。ああ、首が痛い。私の首はあなたが押す"}, {"type": "subtitle", "time": 10377.349, "timestamp": "02:52:57", "text": "自分の姿を見るには、キーボードの「V」キーを押してください。"}, {"type": "subtitle", "time": 10378.71, "timestamp": "02:52:58", "text": "うん。そう、それが私のやり方"}]
[{"type": "subtitle", "time": 11886.55, "timestamp": "03:18:06", "text": "場所。彼は「宇宙猿」とは言っていない。"}, {"type": "subtitle", "time": 11889.349, "timestamp": "03:18:09", "text": "彼は地下室と言っている。うん。うん。"}, {"type": "subtitle", "time": 11891.67, "timestamp": "03:18:11", "text": "地下。地下室のことだよ。はい。"}, {"type": "subtitle", "time": 11899.99, "timestamp": "03:18:19", "text": "ああ、ソフィー、ここにいるの？とんでもないバカだ。"}, {"type": "subtitle", "time": 11908.55, "timestamp": "03:18:28", "text": "ソフィー、ここにいる？ソフィー、あなたは"}, {"type": "subtitle", "time": 11911.75, "timestamp": "03:18:31", "text": "ここ？あなたはここにいますか？"}, {"type": "subtitle", "time": 11914.87, "timestamp": "03:18:34", "text": "これは一体何だ？ソフィー、あなたは"}, {"type": "subtitle", "time": 11918.71, "timestamp": "03:18:38", "text": "ここ？君のハンマーを投げたよ。"}, {"type": "subtitle", "time": 11923.11, "timestamp": "03:18:43", "text": "ソフィー、ここにはゴミが山ほどあるわ。"}, {"type": "subtitle", "time": 11927.91, "timestamp": "03:18:47", "text": "ソフィー、ここにいるの？ソフィー。"}, {"type": "subtitle", "time": 11934.309, "timestamp": "03:18:54", "text": "ソフィー、私は売るつもりです"}, {"type": "subtitle", "time": 11936.03, "timestamp": "03:18:56", "text": "荷物を保管する"}]
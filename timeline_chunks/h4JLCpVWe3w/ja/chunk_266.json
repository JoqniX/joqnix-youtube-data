[{"type": "subtitle", "time": 15960.229, "timestamp": "04:26:00", "text": "懐中電灯を使ってください。あなたは"}, {"type": "subtitle", "time": 15962.51, "timestamp": "04:26:02", "text": "懐中電灯。"}, {"type": "subtitle", "time": 15965.429, "timestamp": "04:26:05", "text": "おお。ああ、私は持っています、ああ、私は持っています"}, {"type": "subtitle", "time": 15970.91, "timestamp": "04:26:10", "text": "わかった。えっと、ちょっと待って。"}, {"type": "subtitle", "time": 15974.95, "timestamp": "04:26:14", "text": "だから、お願いがあるんだけど。うん。いいえ、あなた"}, {"type": "subtitle", "time": 15976.469, "timestamp": "04:26:16", "text": "ここで待つことができます。幽霊が見える"}, {"type": "subtitle", "time": 15979.349, "timestamp": "04:26:19", "text": "私に向かってくる。では、待ってください。つまり、あなたは"}, {"type": "subtitle", "time": 15981.11, "timestamp": "04:26:21", "text": "生きている。"}, {"type": "subtitle", "time": 15984.07, "timestamp": "04:26:24", "text": "はい、私は生きています。ああ、彼女が来るわ。おお、"}, {"type": "subtitle", "time": 15985.389, "timestamp": "04:26:25", "text": "彼女は"}, {"type": "subtitle", "time": 15990.309, "timestamp": "04:26:30", "text": "来るよ。何てことだ。彼女は泣いている。"}, {"type": "subtitle", "time": 15997.51, "timestamp": "04:26:37", "text": "トラックに行って狩猟が行われているかどうか確認する"}, {"type": "subtitle", "time": 16006.55, "timestamp": "04:26:46", "text": "右。 10から10に下がる。"}, {"type": "subtitle", "time": 16014.87, "timestamp": "04:26:54", "text": "えっと、どうやって狩猟について知ったんだっけ？"}, {"type": "subtitle", "time": 16016.87, "timestamp": "04:26:56", "text": "総活動量。それを使ってください。使用する"}]
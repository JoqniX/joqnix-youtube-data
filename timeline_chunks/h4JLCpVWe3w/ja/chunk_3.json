[{"type": "subtitle", "time": 180.55, "timestamp": "00:03:00", "text": "自分。ええ、少しの間なら参加できますよ。私は"}, {"type": "subtitle", "time": 198.55, "timestamp": "00:03:18", "text": "ええ、そうですね、彼らは私と一緒に参加できます、"}, {"type": "subtitle", "time": 200.47, "timestamp": "00:03:20", "text": "しかし、今はどうすることもできない。私はすでに"}, {"type": "subtitle", "time": 202.63, "timestamp": "00:03:22", "text": "農場も何もかも全部やった。これ"}, {"type": "subtitle", "time": 204.869, "timestamp": "00:03:24", "text": "ここは私のコカイン農園です。もう一つの場所は"}, {"type": "subtitle", "time": 208.149, "timestamp": "00:03:28", "text": "メタンフェタミン製造所とその他の場所"}, {"type": "subtitle", "time": 211.869, "timestamp": "00:03:31", "text": "最前線にいるような感じだった"}, {"type": "subtitle", "time": 220.869, "timestamp": "00:03:40", "text": "2番。さあ行こう。お見せします"}, {"type": "subtitle", "time": 222.82999999999998, "timestamp": "00:03:42", "text": "他の"}]
[{"type": "subtitle", "time": 960.69, "timestamp": "00:16:00", "text": "ロビーシステムはどうなっているのだろうか"}, {"type": "subtitle", "time": 962.509, "timestamp": "00:16:02", "text": "[音楽]"}, {"type": "subtitle", "time": 966.509, "timestamp": "00:16:06", "text": "作品。ロビーシステムはどうなっているのだろうか"}, {"type": "subtitle", "time": 970.55, "timestamp": "00:16:10", "text": "作品。あ、待って。ゲームユクティサンはこちら。おお"}, {"type": "subtitle", "time": 973.269, "timestamp": "00:16:13", "text": "我が神よ。こんにちは。皆さん、よく勉強していますね。"}, {"type": "subtitle", "time": 977.509, "timestamp": "00:16:17", "text": "クラックコカインの製造方法を学ぶ方法。ああ、"}, {"type": "subtitle", "time": 980.55, "timestamp": "00:16:20", "text": "あなたが正しい。あなたが正しい。 D. わかりました、"}, {"type": "subtitle", "time": 982.55, "timestamp": "00:16:22", "text": "従業員は復帰する。はい、作業員"}, {"type": "subtitle", "time": 993.23, "timestamp": "00:16:33", "text": "ニース。このゲーム、すごく楽しい。わからない"}, {"type": "subtitle", "time": 996.949, "timestamp": "00:16:36", "text": "なぜ。それと、少し眠れる。の"}, {"type": "subtitle", "time": 998.99, "timestamp": "00:16:38", "text": "新しい一日が始まります"}, {"type": "subtitle", "time": 1003.59, "timestamp": "00:16:43", "text": "今。私は全て正しくやったと思う。しかし"}, {"type": "subtitle", "time": 1006.629, "timestamp": "00:16:46", "text": "完了しました。これも終わった。"}, {"type": "subtitle", "time": 1009.829, "timestamp": "00:16:49", "text": "うん、何が起こるか見ない限り眠れるよ"}, {"type": "subtitle", "time": 1012.91, "timestamp": "00:16:52", "text": "ちくしょう。 XPを失いました"}]
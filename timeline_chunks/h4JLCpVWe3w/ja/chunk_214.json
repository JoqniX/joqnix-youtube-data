[{"type": "subtitle", "time": 12842.67, "timestamp": "03:34:02", "text": "[音楽]"}, {"type": "subtitle", "time": 12846.229, "timestamp": "03:34:06", "text": "神。知っている。知っている。私はその幽霊を知っている。"}, {"type": "subtitle", "time": 12858.95, "timestamp": "03:34:18", "text": "神。ああ、ここはどこだろう？ああ、なぜこれが"}, {"type": "subtitle", "time": 12860.87, "timestamp": "03:34:20", "text": "必ず起こることなのか？なぜ私は隠れているのか"}, {"type": "subtitle", "time": 12862.349, "timestamp": "03:34:22", "text": "コーナーで"}, {"type": "subtitle", "time": 12865.19, "timestamp": "03:34:25", "text": "私のチームメイトはあそこにいます"}, {"type": "subtitle", "time": 12868.229, "timestamp": "03:34:28", "text": "最善を尽くすように奮闘する"}, {"type": "subtitle", "time": 12871.07, "timestamp": "03:34:31", "text": "外に？私は「ああ、"}, {"type": "subtitle", "time": 12874.07, "timestamp": "03:34:34", "text": "神よ、私はこの幽霊にふさわしいのだろうか"}, {"type": "subtitle", "time": 12888.83, "timestamp": "03:34:48", "text": "1つ、"}, {"type": "subtitle", "time": 12896.15, "timestamp": "03:34:56", "text": "行くよ。部屋に戻ってきてください。あなたは"}]
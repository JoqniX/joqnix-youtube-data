[{"type": "subtitle", "time": 17821.83, "timestamp": "04:57:01", "text": "それと、もう一つ言っておきます。覚えて、"}, {"type": "subtitle", "time": 17823.99, "timestamp": "04:57:03", "text": "彼女または彼があなたのところまで歩いて来ることができます"}, {"type": "subtitle", "time": 17827.91, "timestamp": "04:57:07", "text": "トラックもだ。え、何？うん。つまり、"}, {"type": "subtitle", "time": 17830.23, "timestamp": "04:57:10", "text": "トラックの中ではなく、近くに"}, {"type": "subtitle", "time": 17834.788, "timestamp": "04:57:14", "text": "トラック。前回EMF5を見たとき"}, {"type": "subtitle", "time": 17838.15, "timestamp": "04:57:18", "text": "トラックへ向かう通路で読書をしている。おお"}, {"type": "subtitle", "time": 17845.19, "timestamp": "04:57:25", "text": "[音楽]"}, {"type": "subtitle", "time": 17847.03, "timestamp": "04:57:27", "text": "ええ、あなたもどこにあるか知っていますよね"}, {"type": "subtitle", "time": 17849.948, "timestamp": "04:57:29", "text": "安全なルートへ。だから覚えておいてください"}, {"type": "subtitle", "time": 17852.27, "timestamp": "04:57:32", "text": "生きている。うん。"}, {"type": "subtitle", "time": 17861.708, "timestamp": "04:57:41", "text": "保留中。保留中。"}, {"type": "subtitle", "time": 17865.19, "timestamp": "04:57:45", "text": "S. ハートの中のX印は何ですか？"}, {"type": "subtitle", "time": 17868.948, "timestamp": "04:57:48", "text": "あれ？応答がないと表示されます。わかった。もし彼が"}, {"type": "subtitle", "time": 17870.868, "timestamp": "04:57:50", "text": "または彼女が応答すると、"}, {"type": "subtitle", "time": 17879.708, "timestamp": "04:57:59", "text": "[音楽]"}]
[{"type": "subtitle", "time": 4262.149, "timestamp": "01:11:02", "text": "みんな、俺はマリファナを吸ってるんだ。これは"}, {"type": "subtitle", "time": 4265.27, "timestamp": "01:11:05", "text": "雑草。何てことだ。私はついに自分がなりたかったものになった"}, {"type": "subtitle", "time": 4269.189, "timestamp": "01:11:09", "text": "ずっとなりたかったもの。何？"}, {"type": "subtitle", "time": 4271.35, "timestamp": "01:11:11", "text": "何を言っている？これはあなたが"}, {"type": "subtitle", "time": 4273.11, "timestamp": "01:11:13", "text": "父が教えてくれた。これはあなたが言ったことです"}, {"type": "subtitle", "time": 4275.11, "timestamp": "01:11:15", "text": "僕がまだ"}, {"type": "subtitle", "time": 4279.75, "timestamp": "01:11:19", "text": "育つ。あなたは私たちに強制する。私は言った"}, {"type": "subtitle", "time": 4282.709, "timestamp": "01:11:22", "text": "家族について。また一日が過ぎた。応答する"}, {"type": "subtitle", "time": 4284.39, "timestamp": "01:11:24", "text": "メッセージを通じて顧客に"}, {"type": "subtitle", "time": 4286.669, "timestamp": "01:11:26", "text": "アプリ。タブキーの使い方は？"}, {"type": "subtitle", "time": 4290.55, "timestamp": "01:11:30", "text": "わかった。私にはアンディがいる。ドンがいます。我々は持っています"}, {"type": "subtitle", "time": 4295.11, "timestamp": "01:11:35", "text": "ジョー。わかった。ええと、私は2つのオファーを受けています。わかった。私"}, {"type": "subtitle", "time": 4297.63, "timestamp": "01:11:37", "text": "60ドル払ってもいいよ。"}, {"type": "subtitle", "time": 4301.83, "timestamp": "01:11:41", "text": "はい。何？対処できるのは時間だけだ。"}, {"type": "subtitle", "time": 4303.35, "timestamp": "01:11:43", "text": "今すぐ選択できます。選択してください"}, {"type": "subtitle", "time": 4305.79, "timestamp": "01:11:45", "text": "朝。"}, {"type": "subtitle", "time": 4308.31, "timestamp": "01:11:48", "text": "わかった。ガソリンスタンドの裏手"}, {"type": "subtitle", "time": 4311.07, "timestamp": "01:11:51", "text": "6時と8時。"}, {"type": "subtitle", "time": 4313.709, "timestamp": "01:11:53", "text": "わかった。"}, {"type": "subtitle", "time": 4315.63, "timestamp": "01:11:55", "text": "はい。わかった。"}, {"type": "subtitle", "time": 4318.91, "timestamp": "01:11:58", "text": "朝。青い家。"}]
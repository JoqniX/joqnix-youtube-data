[{"type": "subtitle", "time": 7441.109, "timestamp": "02:04:01", "text": "うん、寝られるね。"}, {"type": "subtitle", "time": 7442.51, "timestamp": "02:04:02", "text": "全て"}, {"type": "subtitle", "time": 7445.35, "timestamp": "02:04:05", "text": "右。みんな、この部屋をとても"}, {"type": "subtitle", "time": 7447.189, "timestamp": "02:04:07", "text": "かわいい。"}, {"type": "subtitle", "time": 7456.31, "timestamp": "02:04:16", "text": "よし、デッドドロップは必要ない"}, {"type": "subtitle", "time": 7458.91, "timestamp": "02:04:18", "text": "いつでも。収穫の時期が来たよ、みんな。全て"}, {"type": "subtitle", "time": 7461.27, "timestamp": "02:04:21", "text": "そうだ、誰かがそれを収穫してそれを手に入れよう"}, {"type": "subtitle", "time": 7465.43, "timestamp": "02:04:25", "text": "準備ができて。ピンセットを持っていません。"}, {"type": "subtitle", "time": 7467.669, "timestamp": "02:04:27", "text": "ええ、よりスリムに。トリマーはお持ちですか？私たちは"}, {"type": "subtitle", "time": 7471.35, "timestamp": "02:04:31", "text": "それは買えるよ。私はトリマーを持っています。ああ、それなら"}, {"type": "subtitle", "time": 7478.149, "timestamp": "02:04:38", "text": "袋を買いに行ってきます。私は"}, {"type": "subtitle", "time": 7480.87, "timestamp": "02:04:40", "text": "パッケージを購入する。いいえ、あなた"}, {"type": "subtitle", "time": 7482.31, "timestamp": "02:04:42", "text": "持続する。"}, {"type": "subtitle", "time": 7484.55, "timestamp": "02:04:44", "text": "袋を何枚買いますか"}, {"type": "subtitle", "time": 7488.07, "timestamp": "02:04:48", "text": "必要？ 10. えーと20。"}, {"type": "subtitle", "time": 7489.75, "timestamp": "02:04:49", "text": "H"}, {"type": "subtitle", "time": 7492.55, "timestamp": "02:04:52", "text": "スタックの最大数は20です。うん。うん。"}, {"type": "subtitle", "time": 7495.83, "timestamp": "02:04:55", "text": "うん。いいえ、20個以上購入できます。はい。"}, {"type": "subtitle", "time": 7498.87, "timestamp": "02:04:58", "text": "うん。 1つのスタックは20です。20ですよ。"}]
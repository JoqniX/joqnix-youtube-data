[{"type": "subtitle", "time": 9121.71, "timestamp": "02:32:01", "text": "動画を再生し終えました"}, {"type": "subtitle", "time": 9125.19, "timestamp": "02:32:05", "text": "ゲーム。来て。"}, {"type": "subtitle", "time": 9128.349, "timestamp": "02:32:08", "text": "ああ、新しいメンバーが来たよ。ルートヴィヒ"}, {"type": "subtitle", "time": 9132.03, "timestamp": "02:32:12", "text": "また。ええ、もちろんです。もちろん。"}, {"type": "subtitle", "time": 9139.349, "timestamp": "02:32:19", "text": "ルートヴィヒ。よし、みんな。私たちは"}, {"type": "subtitle", "time": 9141.03, "timestamp": "02:32:21", "text": "Xを作ります。わかりました。あなたは"}, {"type": "subtitle", "time": 9143.67, "timestamp": "02:32:23", "text": "君たちも自分たち用のマリファナを持ってるの？"}, {"type": "subtitle", "time": 9147.11, "timestamp": "02:32:27", "text": "ええと、倉庫に3つあります。わかった。"}, {"type": "subtitle", "time": 9149.91, "timestamp": "02:32:29", "text": "お得な情報もご覧いただけますか？"}, {"type": "subtitle", "time": 9152.15, "timestamp": "02:32:32", "text": "ええ、お得な情報も目にしますよ。全て"}, {"type": "subtitle", "time": 9161.11, "timestamp": "02:32:41", "text": "よし。売るつもりです。待って、私は"}, {"type": "subtitle", "time": 9162.97, "timestamp": "02:32:42", "text": "この男を見てください。"}, {"type": "subtitle", "time": 9169.03, "timestamp": "02:32:49", "text": "ジョック。殺しすぎだと思う"}, {"type": "subtitle", "time": 9173.99, "timestamp": "02:32:53", "text": "人々。いや、いや、いや。ポーは生きている。"}, {"type": "subtitle", "time": 9177.99, "timestamp": "02:32:57", "text": "ここには誰もいない。ジョック。何？"}]
[{"type": "subtitle", "time": 13567.349, "timestamp": "03:46:07", "text": "ダニエル。ダニエル。ダニエル。ミスタービーストは"}, {"type": "subtitle", "time": 13568.95, "timestamp": "03:46:08", "text": "PewDiePieと交差した。あなたの反応は？"}, {"type": "subtitle", "time": 13572.15, "timestamp": "03:46:12", "text": "ダニエル、ここにいる？"}, {"type": "subtitle", "time": 13578.309, "timestamp": "03:46:18", "text": "「ああ」と彼は答えた。彼はここにいる。え、何？"}, {"type": "subtitle", "time": 13581.59, "timestamp": "03:46:21", "text": "彼は「ああ、彼も参加しているよ」と言った。"}, {"type": "subtitle", "time": 13584.71, "timestamp": "03:46:24", "text": "何？ダニエル、エイデン・ロスは好き？"}, {"type": "subtitle", "time": 13592.229, "timestamp": "03:46:32", "text": "ダニエル、新しい批判的な動画が公開されました。"}, {"type": "subtitle", "time": 13596.07, "timestamp": "03:46:36", "text": "ダニエル、君はトップGが好きかい？"}, {"type": "subtitle", "time": 13599.91, "timestamp": "03:46:39", "text": "一番上のG。あなたは？"}, {"type": "subtitle", "time": 13603.229, "timestamp": "03:46:43", "text": "吸うのが好きですか"}, {"type": "subtitle", "time": 13606.389, "timestamp": "03:46:46", "text": "ちんこ？そうではないと思う。ダニエル、新しいカニエ"}]
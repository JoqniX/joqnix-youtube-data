[{"type": "subtitle", "time": 3725.349, "timestamp": "01:02:05", "text": "よし、みんな。もし"}, {"type": "subtitle", "time": 3728.789, "timestamp": "01:02:08", "text": "それらは配信で聞こえます。こんにちは"}, {"type": "subtitle", "time": 3735.829, "timestamp": "01:02:15", "text": "こんにちは。ああ、どうしたの？特に何もない。"}, {"type": "subtitle", "time": 3739.589, "timestamp": "01:02:19", "text": "私たちはそれをやっているのか、やっているのか、えっと"}, {"type": "subtitle", "time": 3741.829, "timestamp": "01:02:21", "text": "ヘロインかマリファナか？うわ、うわ、うわ、"}, {"type": "subtitle", "time": 3744.71, "timestamp": "01:02:24", "text": "うわぁ。それともコカインが欲しいですか？"}, {"type": "subtitle", "time": 3748.549, "timestamp": "01:02:28", "text": "数学？うわぁ。あれはチャドではない。えっと"}, {"type": "subtitle", "time": 3750.87, "timestamp": "01:02:30", "text": "イマンは嘘をついている。私は彼らを招待しなかった"}, {"type": "subtitle", "time": 3756.069, "timestamp": "01:02:36", "text": "専門的な薬物を使用する。待って、"}, {"type": "subtitle", "time": 3758.71, "timestamp": "01:02:38", "text": "私たちは麻薬取引はしていません。いいえ、いいえ、"}, {"type": "subtitle", "time": 3760.95, "timestamp": "01:02:40", "text": "いいえ。それは今日の私たちの目的ではありません。"}, {"type": "subtitle", "time": 3763.51, "timestamp": "01:02:43", "text": "ああ、今日私たちがやろうとしていることは"}, {"type": "subtitle", "time": 3768.95, "timestamp": "01:02:48", "text": "レモンのOをチェックしてください。え、何？うん、君"}, {"type": "subtitle", "time": 3772.789, "timestamp": "01:02:52", "text": "うん。ええ、そうしています。さて、私は"}, {"type": "subtitle", "time": 3775.51, "timestamp": "01:02:55", "text": "彼らがあなたの叫び声を聞いてくれることを願います"}, {"type": "subtitle", "time": 3778.069, "timestamp": "01:02:58", "text": "恐怖の。"}]
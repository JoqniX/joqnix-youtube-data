[{"type": "subtitle", "time": 14302.349, "timestamp": "03:58:22", "text": "神。"}, {"type": "subtitle", "time": 14310.51, "timestamp": "03:58:30", "text": "何でも構いません。どう感じますか？"}, {"type": "subtitle", "time": 14313.269, "timestamp": "03:58:33", "text": "のように？私は6時に仕事に行かなければなりません"}, {"type": "subtitle", "time": 14315.309, "timestamp": "03:58:35", "text": "朝。それでは、さようなら。こんにちは。取る"}, {"type": "subtitle", "time": 14319.03, "timestamp": "03:58:39", "text": "ケア。わかった。私たちが選んだものを選びましょう"}, {"type": "subtitle", "time": 14321.229, "timestamp": "03:58:41", "text": "先ほど演奏しました。もつれ"}, {"type": "subtitle", "time": 14323.51, "timestamp": "03:58:43", "text": "木材。あ、待って。待って。そうします。"}, {"type": "subtitle", "time": 14326.63, "timestamp": "03:58:46", "text": "そうします。待って。君を後押しするよ。そこには"}, {"type": "subtitle", "time": 14332.03, "timestamp": "03:58:52", "text": "行く。"}, {"type": "subtitle", "time": 14334.189, "timestamp": "03:58:54", "text": "わかった。"}, {"type": "subtitle", "time": 14336.349, "timestamp": "03:58:56", "text": "準備完了。"}, {"type": "subtitle", "time": 14338.99, "timestamp": "03:58:58", "text": "わかった。"}]
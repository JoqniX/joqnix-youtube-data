[{"type": "subtitle", "time": 3661.75, "timestamp": "01:01:01", "text": "今夜。のように、"}, {"type": "subtitle", "time": 3663.19, "timestamp": "01:01:03", "text": "その発言に満足していますか？"}, {"type": "subtitle", "time": 3664.87, "timestamp": "01:01:04", "text": "インターネット上で作ったばかりですか？あなたは"}, {"type": "subtitle", "time": 3667.51, "timestamp": "01:01:07", "text": "それでも満足できますか？うん。ああ、"}, {"type": "subtitle", "time": 3669.67, "timestamp": "01:01:09", "text": "神。ああ、そうなんですね？あなたは自分の"}, {"type": "subtitle", "time": 3672.99, "timestamp": "01:01:12", "text": "インターネット インターネット うーん"}, {"type": "subtitle", "time": 3676.309, "timestamp": "01:01:16", "text": "えっと、なんていう名前ですか？"}, {"type": "subtitle", "time": 3678.95, "timestamp": "01:01:18", "text": "サービスプロバイダー。私はインターネットを持っています"}, {"type": "subtitle", "time": 3697.39, "timestamp": "01:01:37", "text": "できる"}, {"type": "subtitle", "time": 3701.27, "timestamp": "01:01:41", "text": "君は、私はこれが望んでいない、私はこれが望んでいない"}, {"type": "subtitle", "time": 3704.19, "timestamp": "01:01:44", "text": "あ、待って。これを置けばいい"}, {"type": "subtitle", "time": 3707.23, "timestamp": "01:01:47", "text": "はい、どうぞ。あなた"}, {"type": "subtitle", "time": 3709.549, "timestamp": "01:01:49", "text": "男たちは"}, {"type": "subtitle", "time": 3712.789, "timestamp": "01:01:52", "text": "さあ、ニャー。"}, {"type": "subtitle", "time": 3714.87, "timestamp": "01:01:54", "text": "もう一度ニャーと言ってみてください。"}, {"type": "subtitle", "time": 3716.39, "timestamp": "01:01:56", "text": "起こる。"}, {"type": "subtitle", "time": 3718.63, "timestamp": "01:01:58", "text": "えっと、ずっとミュート状態だったことに気づいた"}]
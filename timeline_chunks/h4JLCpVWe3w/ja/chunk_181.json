[{"type": "subtitle", "time": 10862.349, "timestamp": "03:01:02", "text": "ゲーム。だから、休憩を取るのは全く問題ない。"}, {"type": "subtitle", "time": 10866.59, "timestamp": "03:01:06", "text": "スケジュール1から少し外れます。それで、"}, {"type": "subtitle", "time": 10870.429, "timestamp": "03:01:10", "text": "うん、ちゃんと寝ないとね"}, {"type": "subtitle", "time": 10872.67, "timestamp": "03:01:12", "text": "もっと"}, {"type": "subtitle", "time": 10906.429, "timestamp": "03:01:46", "text": "わかった。実際に辞めた"}, {"type": "subtitle", "time": 10909.83, "timestamp": "03:01:49", "text": "ゲーム。ゲームをやめろ。ええ、それは本当に"}, {"type": "subtitle", "time": 10913.83, "timestamp": "03:01:53", "text": "楽しく過ごし、スケジュール通りに過ごす"}, {"type": "subtitle", "time": 10917.309, "timestamp": "03:01:57", "text": "一つは赤村との共演。赤村と"}]
[{"type": "subtitle", "time": 17400.23, "timestamp": "04:50:00", "text": "これを早く終わらせますか？つまり、私は"}, {"type": "subtitle", "time": 17401.91, "timestamp": "04:50:01", "text": "試す。"}, {"type": "subtitle", "time": 17403.99, "timestamp": "04:50:03", "text": "えっと、もし終わらせたいなら教えてください"}, {"type": "subtitle", "time": 17406.31, "timestamp": "04:50:06", "text": "それだけなら、参加して試してみます"}, {"type": "subtitle", "time": 17408.948, "timestamp": "04:50:08", "text": "すぐに参加しましょう。ああ、あなたも参加できますよ"}, {"type": "subtitle", "time": 17412.31, "timestamp": "04:50:12", "text": "既存のもの。うーん、よくわからない。私は試してみます"}, {"type": "subtitle", "time": 17414.47, "timestamp": "04:50:14", "text": "最高。では、どうすればいいか教えてあげましょう。"}, {"type": "subtitle", "time": 17416.47, "timestamp": "04:50:16", "text": "わかった。ええと、何も必要ありません。あなた"}, {"type": "subtitle", "time": 17418.628, "timestamp": "04:50:18", "text": "必要なのは塩とEMF測定器だけだ。"}, {"type": "subtitle", "time": 17420.708, "timestamp": "04:50:20", "text": "EMFで証拠を取る必要があります"}, {"type": "subtitle", "time": 17425.43, "timestamp": "04:50:25", "text": "リーダー。 EMP5を5つ見つけたら行ってみて"}, {"type": "subtitle", "time": 17428.868, "timestamp": "04:50:28", "text": "証拠を見てこう言う"}, {"type": "subtitle", "time": 17431.27, "timestamp": "04:50:31", "text": "EMP5、そして幽霊を歩かせなければならない"}, {"type": "subtitle", "time": 17434.23, "timestamp": "04:50:34", "text": "塩を通して。だから、彼らが挑戦する時はいつでも"}, {"type": "subtitle", "time": 17436.55, "timestamp": "04:50:36", "text": "塩を入れる"}, {"type": "subtitle", "time": 17439.59, "timestamp": "04:50:39", "text": "オーブはどこから来るのか、オーブは"}, {"type": "subtitle", "time": 17441.75, "timestamp": "04:50:41", "text": "そして、あなたが見るオーブをどのように"}, {"type": "subtitle", "time": 17444.47, "timestamp": "04:50:44", "text": "ビデオカメラ"}, {"type": "subtitle", "time": 17447.59, "timestamp": "04:50:47", "text": "ああ、EMPが届かない場所に置いてください"}, {"type": "subtitle", "time": 17451.67, "timestamp": "04:50:51", "text": "リーダーは電磁場を検出します"}, {"type": "subtitle", "time": 17455.03, "timestamp": "04:50:55", "text": "カメラをFでそこに置いて"}, {"type": "subtitle", "time": 17457.75, "timestamp": "04:50:57", "text": "それからトラックでここに来てチェックします"}, {"type": "subtitle", "time": 17459.708, "timestamp": "04:50:59", "text": "カメラがもし"}]
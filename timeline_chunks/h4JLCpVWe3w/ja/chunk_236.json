[{"type": "subtitle", "time": 14160.63, "timestamp": "03:56:00", "text": "その通り。それが私たちがここでやっていることです。"}, {"type": "subtitle", "time": 14162.389, "timestamp": "03:56:02", "text": "わかった。"}, {"type": "subtitle", "time": 14166.75, "timestamp": "03:56:06", "text": "ああ、私はそれを終えた"}, {"type": "subtitle", "time": 14174.71, "timestamp": "03:56:14", "text": "おかえり。ああ、ポイントは獲得できたよ。"}, {"type": "subtitle", "time": 14177.15, "timestamp": "03:56:17", "text": "はい。さあ"}, {"type": "subtitle", "time": 14180.55, "timestamp": "03:56:20", "text": "行く。 60ドル。さあ行こう。ああ、私はレベル3です。"}, {"type": "subtitle", "time": 14182.189, "timestamp": "03:56:22", "text": "さあ"}, {"type": "subtitle", "time": 14187.11, "timestamp": "03:56:27", "text": "行く。ああ、正気を保つ薬を手に入れたよ。さあ行こう。"}, {"type": "subtitle", "time": 14189.269, "timestamp": "03:56:29", "text": "おお、いいね。あなたはレベル5に到達しました。"}, {"type": "subtitle", "time": 14191.51, "timestamp": "03:56:31", "text": "ニース。"}, {"type": "subtitle", "time": 14207.67, "timestamp": "03:56:47", "text": "死ななくてよかった。では、何が何だか"}, {"type": "subtitle", "time": 14211.189, "timestamp": "03:56:51", "text": "この頭蓋骨みたいなもの全部ですか？ミッチ"}, {"type": "subtitle", "time": 14214.15, "timestamp": "03:56:54", "text": "左。ええと、私たちだけが"}, {"type": "subtitle", "time": 14219.429, "timestamp": "03:56:59", "text": "遊ぶ。わかった。ああ、彼は去ってしまった。こんにちは。"}]
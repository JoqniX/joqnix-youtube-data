[{"type": "subtitle", "time": 14701.79, "timestamp": "04:05:01", "text": "猫。ネシドよ、何らかの兆候を示してくれ。"}, {"type": "subtitle", "time": 14709.269, "timestamp": "04:05:09", "text": "ドアを開ける。えっと、ジョー、一つだけお願いがあるんだけど。行く"}, {"type": "subtitle", "time": 14711.03, "timestamp": "04:05:11", "text": "2階の浴室で。確認してみます"}, {"type": "subtitle", "time": 14712.95, "timestamp": "04:05:12", "text": "その活動。"}, {"type": "subtitle", "time": 14714.71, "timestamp": "04:05:14", "text": "2番目？ああ、私は2階にいます。"}, {"type": "subtitle", "time": 14717.67, "timestamp": "04:05:17", "text": "わかった。ええと、活動や"}, {"type": "subtitle", "time": 14718.95, "timestamp": "04:05:18", "text": "ライトを点灯し、ライトを点灯すると、"}, {"type": "subtitle", "time": 14720.389, "timestamp": "04:05:20", "text": "照明がちらつく場合は、お知らせください。病気"}, {"type": "subtitle", "time": 14721.99, "timestamp": "04:05:21", "text": "戻ってきて写真を撮ってください。それだけです"}, {"type": "subtitle", "time": 14724.11, "timestamp": "04:05:24", "text": "私たちはそれを望んでいます。"}, {"type": "subtitle", "time": 14728.389, "timestamp": "04:05:28", "text": "わかった。私はライトをつけた"}, {"type": "subtitle", "time": 14730.55, "timestamp": "04:05:30", "text": "ああ、そこには、そこには、そこには"}, {"type": "subtitle", "time": 14732.55, "timestamp": "04:05:32", "text": "ほんの少しだけ、一つだけありました。戻ってくる。"}, {"type": "subtitle", "time": 14734.309, "timestamp": "04:05:34", "text": "カメラを持って行ってください。覚えて、"}, {"type": "subtitle", "time": 14735.91, "timestamp": "04:05:35", "text": "幽霊が来たら、"}, {"type": "subtitle", "time": 14739.87, "timestamp": "04:05:39", "text": "写真。どこにいるの？えっと、私は"}, {"type": "subtitle", "time": 14743.99, "timestamp": "04:05:43", "text": "外。あ、待って。聖なる神よ。何が"}, {"type": "subtitle", "time": 14747.189, "timestamp": "04:05:47", "text": "それ？このカメラを持って行ってください。わかった。クリックするだけ"}, {"type": "subtitle", "time": 14749.11, "timestamp": "04:05:49", "text": "写真ですよね？わかった。わかった。では"}, {"type": "subtitle", "time": 14751.91, "timestamp": "04:05:51", "text": "ビデオカメラ？えっと、それをください。"}]
[{"type": "subtitle", "time": 3540.069, "timestamp": "00:59:00", "text": "そのDiscordステッカーは何なんだ、"}, {"type": "subtitle", "time": 3544.23, "timestamp": "00:59:04", "text": "兄弟？何？何ですって？何？ひどく落ち込んでいるね、"}, {"type": "subtitle", "time": 3546.549, "timestamp": "00:59:06", "text": "兄弟。 「ひどく落ち込む」とはどういう意味ですか？良い、"}, {"type": "subtitle", "time": 3548.789, "timestamp": "00:59:08", "text": "受け入れることに何の問題もない"}, {"type": "subtitle", "time": 3551.19, "timestamp": "00:59:11", "text": "ネクタイ。"}, {"type": "subtitle", "time": 3553.829, "timestamp": "00:59:13", "text": "ネクタイは、私が言うべきことのようなものです"}, {"type": "subtitle", "time": 3556.23, "timestamp": "00:59:16", "text": "あなたの妻。"}, {"type": "subtitle", "time": 3564.789, "timestamp": "00:59:24", "text": "何てことだ。"}, {"type": "subtitle", "time": 3566.39, "timestamp": "00:59:26", "text": "どれ？ボラ。来て。来て。"}, {"type": "subtitle", "time": 3583.19, "timestamp": "00:59:43", "text": "うん。どれ？どれ？何？どれの？"}, {"type": "subtitle", "time": 3586.75, "timestamp": "00:59:46", "text": "どれがどれ？どれの"}, {"type": "subtitle", "time": 3589.75, "timestamp": "00:59:49", "text": "1つ？何？何をする？私は"}]
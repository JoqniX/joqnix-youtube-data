[{"type": "subtitle", "time": 14822.07, "timestamp": "04:07:02", "text": "一人でいると、あなたは一人でいると、彼は"}, {"type": "subtitle", "time": 14824.11, "timestamp": "04:07:04", "text": "お答えします。わかった。"}, {"type": "subtitle", "time": 14827.67, "timestamp": "04:07:07", "text": "わかった。ルース、元気？あなたはここにいますか"}, {"type": "subtitle", "time": 14830.469, "timestamp": "04:07:10", "text": "私の話を聞いていますか？聞こえますか？聞く"}, {"type": "subtitle", "time": 14832.79, "timestamp": "04:07:12", "text": "彼、ここにいますか？何か兆候を見せてください。は"}, {"type": "subtitle", "time": 14835.67, "timestamp": "04:07:15", "text": "ここにいる？ルース、何かサインを見せてよ。"}, {"type": "subtitle", "time": 14838.75, "timestamp": "04:07:18", "text": "あなたはここにいますか？あなたは"}, {"type": "subtitle", "time": 14842.07, "timestamp": "04:07:22", "text": "ここ？私は行きます。あなたはここにいますか、"}, {"type": "subtitle", "time": 14845.03, "timestamp": "04:07:25", "text": "ルース？ルース、どこにいるの？"}, {"type": "subtitle", "time": 14846.269, "timestamp": "04:07:26", "text": "おお、"}, {"type": "subtitle", "time": 14849.429, "timestamp": "04:07:29", "text": "離れる。何てことだ。うん。うん。うん。以上"}, {"type": "subtitle", "time": 14851.269, "timestamp": "04:07:31", "text": "ここ。どこ？こちらです。わかった。待って。私は"}, {"type": "subtitle", "time": 14853.269, "timestamp": "04:07:33", "text": "来るよ。写真をクリックしてください。覚えて、"}, {"type": "subtitle", "time": 14854.71, "timestamp": "04:07:34", "text": "彼が来るときはいつでも、あなたが"}, {"type": "subtitle", "time": 14856.87, "timestamp": "04:07:36", "text": "光を当てて、写真を撮ってください。私は話したい"}, {"type": "subtitle", "time": 14859.03, "timestamp": "04:07:39", "text": "あなた。"}, {"type": "subtitle", "time": 14861.83, "timestamp": "04:07:41", "text": "来る。彼に出てくるように頼んでください。出てくる。"}, {"type": "subtitle", "time": 14866.229, "timestamp": "04:07:46", "text": "姿を見せろ。姿を見せていただけますか？"}, {"type": "subtitle", "time": 14868.55, "timestamp": "04:07:48", "text": "わかった。すぐに回転することを覚えておいてください"}, {"type": "subtitle", "time": 14871.11, "timestamp": "04:07:51", "text": "カメラアウト。はぁ？話題に上るたびに。私"}, {"type": "subtitle", "time": 14873.67, "timestamp": "04:07:53", "text": "トーチを落とす必要があると思う。それで"}, {"type": "subtitle", "time": 14875.75, "timestamp": "04:07:55", "text": "スクロールホイールを回すと、"}, {"type": "subtitle", "time": 14879.03, "timestamp": "04:07:59", "text": "トーチ。えっと、懐中電灯。そうすればおそらく"}]
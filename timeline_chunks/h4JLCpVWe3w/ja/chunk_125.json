[{"type": "subtitle", "time": 7502.47, "timestamp": "02:05:02", "text": "うん。 1つのスタックは20です。わかりました。 20歳。そして私は"}, {"type": "subtitle", "time": 7504.629, "timestamp": "02:05:04", "text": "さらに、トリマーをもう1台購入する予定です。"}, {"type": "subtitle", "time": 7508.109, "timestamp": "02:05:08", "text": "みんな。よし。私はスリができません"}, {"type": "subtitle", "time": 7511.589, "timestamp": "02:05:11", "text": "彼。お金が必要です。誰を選べばいいの？うん、"}, {"type": "subtitle", "time": 7513.35, "timestamp": "02:05:13", "text": "続けてください。君たちはトリマーを買う"}, {"type": "subtitle", "time": 7514.95, "timestamp": "02:05:14", "text": "あなた自身のためにも。私は行くつもりです"}, {"type": "subtitle", "time": 7518.07, "timestamp": "02:05:18", "text": "材料を作ろう。どこに置けばいいですか"}, {"type": "subtitle", "time": 7520.229, "timestamp": "02:05:20", "text": "在庫？例えば、ああ、入れることができる"}, {"type": "subtitle", "time": 7524.07, "timestamp": "02:05:24", "text": "えーと、棚の収納または屋外"}, {"type": "subtitle", "time": 7526.79, "timestamp": "02:05:26", "text": "棚みたいなものがあるんです。わかった。の"}, {"type": "subtitle", "time": 7533.75, "timestamp": "02:05:33", "text": "ここ。最高の栽培体験でした。私は必要ない"}, {"type": "subtitle", "time": 7536.589, "timestamp": "02:05:36", "text": "それ。とりあえず土壌で。私は必要ない"}, {"type": "subtitle", "time": 7541.07, "timestamp": "02:05:41", "text": "それ。よし。トリミングしましょう"}, {"type": "subtitle", "time": 7543.51, "timestamp": "02:05:43", "text": "トリム。みんな、これはあまり"}, {"type": "subtitle", "time": 7550.39, "timestamp": "02:05:50", "text": "雑草。基本的なガス。"}]
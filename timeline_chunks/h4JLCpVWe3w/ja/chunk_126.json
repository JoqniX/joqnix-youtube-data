[{"type": "subtitle", "time": 7560.99, "timestamp": "02:06:00", "text": "収穫"}, {"type": "subtitle", "time": 7566.709, "timestamp": "02:06:06", "text": "パッケージに名前や薬の名前を記載する。"}, {"type": "subtitle", "time": 7569.43, "timestamp": "02:06:09", "text": "そうそう。"}, {"type": "subtitle", "time": 7575.83, "timestamp": "02:06:15", "text": "ああ、薬に名前をつけることね。あなただと思う"}, {"type": "subtitle", "time": 7578.47, "timestamp": "02:06:18", "text": "まるで薬物を混ぜ始めるかのように"}, {"type": "subtitle", "time": 7580.31, "timestamp": "02:06:20", "text": "そして、名前を付けることから始めてください"}, {"type": "subtitle", "time": 7582.95, "timestamp": "02:06:22", "text": "ランダム化する。逃げ出してやり直せばいい"}, {"type": "subtitle", "time": 7585.91, "timestamp": "02:06:25", "text": "また。よし。えっと、私は"}, {"type": "subtitle", "time": 7589.99, "timestamp": "02:06:29", "text": "再び土を少し落としてください。待って。わかった。私は必要としている"}, {"type": "subtitle", "time": 7593.189, "timestamp": "02:06:33", "text": "電話では名前を変更できると思います"}, {"type": "subtitle", "time": 7594.87, "timestamp": "02:06:34", "text": "製品。"}, {"type": "subtitle", "time": 7597.43, "timestamp": "02:06:37", "text": "あなたはできる。どうでも。わかった。いや。ああ、いやだ。"}, {"type": "subtitle", "time": 7599.51, "timestamp": "02:06:39", "text": "去った。"}, {"type": "subtitle", "time": 7601.43, "timestamp": "02:06:41", "text": "大丈夫。私たちは混ぜ合わせる必要があるかもしれません"}, {"type": "subtitle", "time": 7609.47, "timestamp": "02:06:49", "text": "皆さん、どうぞ。私はこのゲームが本当に得意なんです。その"}, {"type": "subtitle", "time": 7611.35, "timestamp": "02:06:51", "text": "恐ろしい。自分が何をしようとしているのか分からない"}, {"type": "subtitle", "time": 7612.43, "timestamp": "02:06:52", "text": "に"}, {"type": "subtitle", "time": 7617.189, "timestamp": "02:06:57", "text": "する。わかった。誰かを大金持ちにしている。[ __ ]。"}]
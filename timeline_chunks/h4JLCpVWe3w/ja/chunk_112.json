[{"type": "subtitle", "time": 6722.149, "timestamp": "01:52:02", "text": "スパムを多く送れば送るほど、あなたの順位は上がります。はい。"}, {"type": "subtitle", "time": 6724.47, "timestamp": "01:52:04", "text": "はい。はい。"}, {"type": "subtitle", "time": 6734.79, "timestamp": "01:52:14", "text": "そんなのまっぴらだ。それでおしまい。私は薬物を投与するつもりです"}, {"type": "subtitle", "time": 6737.43, "timestamp": "01:52:17", "text": "取引。私はこれです。"}, {"type": "subtitle", "time": 6740.629, "timestamp": "01:52:20", "text": "何？あなたが料理を作ったのですね。おい。やあ、サム。だろう"}, {"type": "subtitle", "time": 6742.95, "timestamp": "01:52:22", "text": "あなたは私たちの"}, {"type": "subtitle", "time": 6746.229, "timestamp": "01:52:26", "text": "製品？何？どうぞ。ここに"}, {"type": "subtitle", "time": 6748.55, "timestamp": "01:52:28", "text": "行く。君たちが楽しんでいる間、私は"}, {"type": "subtitle", "time": 6751.03, "timestamp": "01:52:31", "text": "私はここでちゃんと麻薬取引をしている"}, {"type": "subtitle", "time": 6754.07, "timestamp": "01:52:34", "text": "麻薬密売人。今、私は、私は、"}, {"type": "subtitle", "time": 6759.47, "timestamp": "01:52:39", "text": "ヘルプ。おい、戻ってこいよ。待ってください、何さん。"}, {"type": "subtitle", "time": 6762.99, "timestamp": "01:52:42", "text": "持っていますか、"}, {"type": "subtitle", "time": 6766.07, "timestamp": "01:52:46", "text": "[ __ ]？私はあなたの考えを共有しました。"}, {"type": "subtitle", "time": 6769.109, "timestamp": "01:52:49", "text": "彼は私から逃げることができ、私の"}, {"type": "subtitle", "time": 6770.95, "timestamp": "01:52:50", "text": "製品。ジョー、想像できる？"}, {"type": "subtitle", "time": 6774.99, "timestamp": "01:52:54", "text": "くそ。想像できますか？"}, {"type": "subtitle", "time": 6777.87, "timestamp": "01:52:57", "text": "まあ、気にしなくていいよ。"}]
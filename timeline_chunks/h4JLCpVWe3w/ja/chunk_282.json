[{"type": "subtitle", "time": 16920.03, "timestamp": "04:42:00", "text": "君は怪しい。君は怪しい。ルース"}, {"type": "subtitle", "time": 16933.75, "timestamp": "04:42:13", "text": "なぜ彼女はそうではないのか？もしよければ、私も行けます"}, {"type": "subtitle", "time": 16937.11, "timestamp": "04:42:17", "text": "外。いや、いや、いや、いや。電話してほしいの？"}, {"type": "subtitle", "time": 16939.11, "timestamp": "04:42:19", "text": "彼女がこの部屋の中にいるので、"}, {"type": "subtitle", "time": 16942.628, "timestamp": "04:42:22", "text": "死亡アニメーション？いや、いや、いや。"}, {"type": "subtitle", "time": 16944.31, "timestamp": "04:42:24", "text": "つまり、最終的には、彼女は"}, {"type": "subtitle", "time": 16946.47, "timestamp": "04:42:26", "text": "今すぐ狩猟を中止します。あなたはできる"}, {"type": "subtitle", "time": 16948.23, "timestamp": "04:42:28", "text": "ちょっと待って、確認して、グーグルで調べてみて。どれくらい時間がかかりますか"}, {"type": "subtitle", "time": 16948.99, "timestamp": "04:42:28", "text": "取る"}, {"type": "subtitle", "time": 16951.99, "timestamp": "04:42:31", "text": "狩猟アニメーションの長さはどれくらいですか、または"}, {"type": "subtitle", "time": 16955.27, "timestamp": "04:42:35", "text": "狩猟シミュレーター？おお。ああ、彼女はああ、何"}, {"type": "subtitle", "time": 16959.67, "timestamp": "04:42:39", "text": "愚鈍化。なんてバカな女だ。"}, {"type": "subtitle", "time": 16963.19, "timestamp": "04:42:43", "text": "彼女はなぜ二階へ上がっていくのですか？"}, {"type": "subtitle", "time": 16964.868, "timestamp": "04:42:44", "text": "彼女はこれをやっているんです。バカ女。来る"}, {"type": "subtitle", "time": 16967.11, "timestamp": "04:42:47", "text": "私を見て、バカ。お前はクソ野郎だ。バカ野郎。ばか"}, {"type": "subtitle", "time": 16970.07, "timestamp": "04:42:50", "text": "[ __ ]。私はその部屋にいる。右。その通り"}, {"type": "subtitle", "time": 16971.59, "timestamp": "04:42:51", "text": "正しいよ、この[ __ ]。あなたにあげます"}, {"type": "subtitle", "time": 16973.708, "timestamp": "04:42:53", "text": "方向、このバカ野郎"}, {"type": "subtitle", "time": 16977.03, "timestamp": "04:42:57", "text": "AI。バカ女。下へ降りてください。降りてくる。"}]
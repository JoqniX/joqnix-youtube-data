[{"type": "subtitle", "time": 6600.709, "timestamp": "01:50:00", "text": "購入すべきでしょうか？えっと、あなたは"}, {"type": "subtitle", "time": 6603.83, "timestamp": "01:50:03", "text": "オンライン銀行経由でのみ購入できます。"}, {"type": "subtitle", "time": 6607.47, "timestamp": "01:50:07", "text": "店内で。ゲット"}, {"type": "subtitle", "time": 6610.109, "timestamp": "01:50:10", "text": "テント。えっと、それから"}, {"type": "subtitle", "time": 6613.149, "timestamp": "01:50:13", "text": "土壌。えっと"}, {"type": "subtitle", "time": 6617.109, "timestamp": "01:50:17", "text": "えっと、テントはどこ？栽培用テント。それは"}, {"type": "subtitle", "time": 6618.99, "timestamp": "01:50:18", "text": "初め"}, {"type": "subtitle", "time": 6622.79, "timestamp": "01:50:22", "text": "オプション。ああ、わかりました。"}, {"type": "subtitle", "time": 6625.91, "timestamp": "01:50:25", "text": "うん。待って、待って、待って。私は"}, {"type": "subtitle", "time": 6627.75, "timestamp": "01:50:27", "text": "その不具合。"}, {"type": "subtitle", "time": 6630.39, "timestamp": "01:50:30", "text": "一体どういうことだ？わかった。どこに必要なのか"}, {"type": "subtitle", "time": 6632.39, "timestamp": "01:50:32", "text": "鍋。"}, {"type": "subtitle", "time": 6634.87, "timestamp": "01:50:34", "text": "ええ、できますよ。待って、待って、待って。"}, {"type": "subtitle", "time": 6640.03, "timestamp": "01:50:40", "text": "やってみろ。良い場所でやってください。"}, {"type": "subtitle", "time": 6642.229, "timestamp": "01:50:42", "text": "うんうん。どんな良い場所？私"}, {"type": "subtitle", "time": 6644.07, "timestamp": "01:50:44", "text": "真ん中。あ、待って。さあ、こっちへおいで。来る"}, {"type": "subtitle", "time": 6646.79, "timestamp": "01:50:46", "text": "ここ。ここに来て。最高の場所は"}, {"type": "subtitle", "time": 6650.79, "timestamp": "01:50:50", "text": "私は農業に従事しています。ダン、"}, {"type": "subtitle", "time": 6652.31, "timestamp": "01:50:52", "text": "ありがとう。"}, {"type": "subtitle", "time": 6654.39, "timestamp": "01:50:54", "text": "わかった。このバスターは良いものになるでしょう"}, {"type": "subtitle", "time": 6656.55, "timestamp": "01:50:56", "text": "場所。みんなはどこに行っていたの？何"}, {"type": "subtitle", "time": 6659.51, "timestamp": "01:50:59", "text": "くそ？ええと、私たちは死すべき運命の前にいます。"}]
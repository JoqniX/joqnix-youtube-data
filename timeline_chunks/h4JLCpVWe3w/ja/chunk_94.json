[{"type": "subtitle", "time": 5642.39, "timestamp": "01:34:02", "text": "ああ、このゲームのこのゴミ。見て、"}, {"type": "subtitle", "time": 5643.91, "timestamp": "01:34:03", "text": "シガレット。"}, {"type": "subtitle", "time": 5651.83, "timestamp": "01:34:11", "text": "取りに来てください。これです"}, {"type": "subtitle", "time": 5652.95, "timestamp": "01:34:12", "text": "ここ。"}, {"type": "subtitle", "time": 5655.27, "timestamp": "01:34:15", "text": "お金はどこにあるの？わかりますか？"}, {"type": "subtitle", "time": 5657.669, "timestamp": "01:34:17", "text": "小さな地図を確認してください。小さな"}, {"type": "subtitle", "time": 5661.59, "timestamp": "01:34:21", "text": "これです。これです。これは、えーと"}, {"type": "subtitle", "time": 5664.39, "timestamp": "01:34:24", "text": "お金。"}, {"type": "subtitle", "time": 5666.629, "timestamp": "01:34:26", "text": "よし。 120. 皆さんも"}, {"type": "subtitle", "time": 5671.83, "timestamp": "01:34:31", "text": "120？いいえ。いいえ。ああ、そこにはありません。うん。"}, {"type": "subtitle", "time": 5674.39, "timestamp": "01:34:34", "text": "ああ、みんな。オッポ。おい。こんにちは。警察。いいえ。"}, {"type": "subtitle", "time": 5677.83, "timestamp": "01:34:37", "text": "法律を遵守していないだけだ。犬は飼っていません。そこには"}, {"type": "subtitle", "time": 5679.83, "timestamp": "01:34:39", "text": "すぐそこに警察官がいた。"}, {"type": "subtitle", "time": 5681.51, "timestamp": "01:34:41", "text": "暴力的なことを望んでいるのは分かっています"}, {"type": "subtitle", "time": 5684.47, "timestamp": "01:34:44", "text": "いろいろあったけど、本当にひどい。ねえ、これ何？"}, {"type": "subtitle", "time": 5690.91, "timestamp": "01:34:50", "text": "ああ、ボード"}, {"type": "subtitle", "time": 5693.629, "timestamp": "01:34:53", "text": "検索中。そこには"}, {"type": "subtitle", "time": 5696.95, "timestamp": "01:34:56", "text": "君に勝てるものは何もなかった。"}]
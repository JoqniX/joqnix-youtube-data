[{"type": "subtitle", "time": 11521.95, "timestamp": "03:12:01", "text": "神。"}, {"type": "subtitle", "time": 11525.03, "timestamp": "03:12:05", "text": "聖なる。あと2枚、好きな地図があります。ニース。男"}, {"type": "subtitle", "time": 11534.87, "timestamp": "03:12:14", "text": "彼はなぜそんなことをしたのか？待って、彼の"}, {"type": "subtitle", "time": 11538.59, "timestamp": "03:12:18", "text": "名前をもう一度教えてください。忘れた。ケビン。"}, {"type": "subtitle", "time": 11554.03, "timestamp": "03:12:34", "text": "2番目のマップに進んでください。 CH"}]
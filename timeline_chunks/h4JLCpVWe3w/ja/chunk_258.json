[{"type": "subtitle", "time": 15484.389, "timestamp": "04:18:04", "text": "出てくる。出てくる。うん。うん。"}, {"type": "subtitle", "time": 15488.469, "timestamp": "04:18:08", "text": "では、これをお受け取りください。"}, {"type": "subtitle", "time": 15490.87, "timestamp": "04:18:10", "text": "EMFの測定値が5かどうか確認してください。行く"}, {"type": "subtitle", "time": 15493.189, "timestamp": "04:18:13", "text": "その浴室の中。 EMF を確認してください"}, {"type": "subtitle", "time": 15496.07, "timestamp": "04:18:16", "text": "読解力は5です。わかった。私は、えーと、私は、"}, {"type": "subtitle", "time": 15497.429, "timestamp": "04:18:17", "text": "そこへ行かせてください。あなたはただ"}, {"type": "subtitle", "time": 15499.91, "timestamp": "04:18:19", "text": "写真。わかった。"}, {"type": "subtitle", "time": 15501.95, "timestamp": "04:18:21", "text": "私と来て。見せてください 見せてください"}, {"type": "subtitle", "time": 15513.189, "timestamp": "04:18:33", "text": "え、電源を入れてないの？何？えっと、"}, {"type": "subtitle", "time": 15516.79, "timestamp": "04:18:36", "text": "光。うん。えっと、あなたは私に"}, {"type": "subtitle", "time": 15519.67, "timestamp": "04:18:39", "text": "発電機を起動してください。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 15532.95, "timestamp": "04:18:52", "text": "彼女はバスルームにいる。その通り。"}, {"type": "subtitle", "time": 15536.87, "timestamp": "04:18:56", "text": "水道水が流れ始めたからだ。"}]
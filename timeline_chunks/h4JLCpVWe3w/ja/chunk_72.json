[{"type": "subtitle", "time": 4323.55, "timestamp": "01:12:03", "text": "わかった。えっと、朝にしましょう"}, {"type": "subtitle", "time": 4325.75, "timestamp": "01:12:05", "text": "また。素晴らしい。後ろで会いましょう"}, {"type": "subtitle", "time": 4328.03, "timestamp": "01:12:08", "text": "質屋と"}, {"type": "subtitle", "time": 4330.87, "timestamp": "01:12:10", "text": "わかった。わかった。どうすれば運転して出発できますか"}, {"type": "subtitle", "time": 4332.55, "timestamp": "01:12:12", "text": "けれど？"}, {"type": "subtitle", "time": 4336.149, "timestamp": "01:12:16", "text": "ええ、運転できると思いますよ。おお。"}, {"type": "subtitle", "time": 4339.11, "timestamp": "01:12:19", "text": "ああ、ネルソンと話してから"}, {"type": "subtitle", "time": 4341.51, "timestamp": "01:12:21", "text": "ああ、わかりました。わかった。ネルソン、いやヘクター"}, {"type": "subtitle", "time": 4346.709, "timestamp": "01:12:26", "text": "ヘクター、ちょっと用事があるんだけど"}, {"type": "subtitle", "time": 4347.91, "timestamp": "01:12:27", "text": "下にいる人たちは"}, {"type": "subtitle", "time": 4349.75, "timestamp": "01:12:29", "text": "真ん中。あなたがここにいる理由を彼らに伝えます"}, {"type": "subtitle", "time": 4352.95, "timestamp": "01:12:32", "text": "パッケージ。何も支払う必要はありません。"}, {"type": "subtitle", "time": 4354.47, "timestamp": "01:12:34", "text": "物資を調達したい場合は"}, {"type": "subtitle", "time": 4357.31, "timestamp": "01:12:37", "text": "自分のために、私の"}, {"type": "subtitle", "time": 4360.149, "timestamp": "01:12:40", "text": "タブ。ありがとう、相棒。どうぞご自由に"}, {"type": "subtitle", "time": 4362.27, "timestamp": "01:12:42", "text": "トラック。ああ、もちろんさ。私は"}, {"type": "subtitle", "time": 4365.11, "timestamp": "01:12:45", "text": "トラック。ああ、なんてことだ。私は運転できます"}, {"type": "subtitle", "time": 4377.35, "timestamp": "01:12:57", "text": "セレナ・フラッツ。そこが私のいるべき場所ですか？"}]
[{"type": "subtitle", "time": 6062.149, "timestamp": "01:41:02", "text": "そうであるのは間違っている。彼は人々が"}, {"type": "subtitle", "time": 6064.229, "timestamp": "01:41:04", "text": "彼らは生きているし、死んでいる。彼は文字通り"}, {"type": "subtitle", "time": 6070.55, "timestamp": "01:41:10", "text": "公衆電話でネルソンおじさんと話してください。"}, {"type": "subtitle", "time": 6075.75, "timestamp": "01:41:15", "text": "わかった。ああ、公衆電話だ。さあ行こう。ああ、くそ。"}, {"type": "subtitle", "time": 6077.51, "timestamp": "01:41:17", "text": "それは理想的とは言えません。ああ、まったくだ。そこには"}, {"type": "subtitle", "time": 6081.07, "timestamp": "01:41:21", "text": "町に強力な麻薬カルテルが存在する。ベンジーズ"}, {"type": "subtitle", "time": 6083.75, "timestamp": "01:41:23", "text": "家族。彼らは"}, {"type": "subtitle", "time": 6085.669, "timestamp": "01:41:25", "text": "いずれ問題になるだろう。彼らは見つけるだろう"}, {"type": "subtitle", "time": 6087.43, "timestamp": "01:41:27", "text": "すぐに出て行け。どうやらあなたは"}, {"type": "subtitle", "time": 6090.149, "timestamp": "01:41:30", "text": "どこか人目につかない場所に泊まりたい"}, {"type": "subtitle", "time": 6091.83, "timestamp": "01:41:31", "text": "しばらくの間。モーテルへ行って"}, {"type": "subtitle", "time": 6096.55, "timestamp": "01:41:36", "text": "彼らに聞いてみてください。これが人間だ。死ぬこと。"}, {"type": "subtitle", "time": 6099.03, "timestamp": "01:41:39", "text": "また戻ってきます。"}, {"type": "subtitle", "time": 6100.87, "timestamp": "01:41:40", "text": "どこにいるの？部屋。その後、"}, {"type": "subtitle", "time": 6102.149, "timestamp": "01:41:42", "text": "何かが必要だ。ああ、支払わなければならない"}, {"type": "subtitle", "time": 6105.03, "timestamp": "01:41:45", "text": "電話。ここに来て。わかった。私たちは行かなければならない"}, {"type": "subtitle", "time": 6108.47, "timestamp": "01:41:48", "text": "えーと、モーテルへ。モーテルへ。"}, {"type": "subtitle", "time": 6110.709, "timestamp": "01:41:50", "text": "ここはモーテルです。"}, {"type": "subtitle", "time": 6112.87, "timestamp": "01:41:52", "text": "モーテル。うん、まっすぐ行こう。うん。"}]
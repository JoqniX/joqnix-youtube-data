[{"type": "subtitle", "time": 15062.67, "timestamp": "04:11:02", "text": "容赦なく。活動なし。"}, {"type": "subtitle", "time": 15070.75, "timestamp": "04:11:10", "text": "あなたが"}, {"type": "subtitle", "time": 15073.59, "timestamp": "04:11:13", "text": "一人で。あ、待って。待っていればいい。ただ"}, {"type": "subtitle", "time": 15077.189, "timestamp": "04:11:17", "text": "廊下でお待ちください。すぐに行きます"}, {"type": "subtitle", "time": 15081.0, "timestamp": "04:11:21", "text": "そこの電磁界を調べてみます。わかった。"}, {"type": "subtitle", "time": 15093.99, "timestamp": "04:11:33", "text": "ルースに話しかけてください。ルース、あなたは誰と一緒にここにいるのですか？"}, {"type": "subtitle", "time": 15095.95, "timestamp": "04:11:35", "text": "私たち"}, {"type": "subtitle", "time": 15108.03, "timestamp": "04:11:48", "text": "彼はここにはいません。わかった。電磁波なし。したい"}, {"type": "subtitle", "time": 15111.309, "timestamp": "04:11:51", "text": "下へ"}, {"type": "subtitle", "time": 15115.03, "timestamp": "04:11:55", "text": "地下。なぜ看板があるのですか？待って。おお、"}, {"type": "subtitle", "time": 15117.75, "timestamp": "04:11:57", "text": "それは私です。これは私がこのクソを開けているところです"}]
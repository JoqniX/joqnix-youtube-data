[{"type": "subtitle", "time": 11285.59, "timestamp": "03:08:05", "text": "うん。うん。彼はここでスポーンした。"}, {"type": "subtitle", "time": 11291.67, "timestamp": "03:08:11", "text": "ケビン、この本の上でお願いします。待って、"}, {"type": "subtitle", "time": 11294.07, "timestamp": "03:08:14", "text": "みんな外に出て。一人だけになる"}, {"type": "subtitle", "time": 11296.99, "timestamp": "03:08:16", "text": "男。ケビン、聞こえるか？"}, {"type": "subtitle", "time": 11301.349, "timestamp": "03:08:21", "text": "自分？あ、待って。外出するべきでしょうか？"}, {"type": "subtitle", "time": 11304.63, "timestamp": "03:08:24", "text": "いいえ、あなたはここにいてください。わかった。のみ"}, {"type": "subtitle", "time": 11306.349, "timestamp": "03:08:26", "text": "一人行く"}, {"type": "subtitle", "time": 11309.03, "timestamp": "03:08:29", "text": "外。ケビン・ベルフィールド。全員外に出て。"}, {"type": "subtitle", "time": 11312.71, "timestamp": "03:08:32", "text": "ふざけるな。お前ら全員クソくらえだ。わかった。あなたはただ"}, {"type": "subtitle", "time": 11315.269, "timestamp": "03:08:35", "text": "そこに留まりなさい。"}, {"type": "subtitle", "time": 11318.11, "timestamp": "03:08:38", "text": "ケビン・ベルフィールド。出てきなさい"}, {"type": "subtitle", "time": 11320.389, "timestamp": "03:08:40", "text": "[ __ ]。出てくる。一人しか存在できない"}, {"type": "subtitle", "time": 11325.59, "timestamp": "03:08:45", "text": "Bフィールド。ケビン・ベルフィールド。あなたは"}, {"type": "subtitle", "time": 11327.83, "timestamp": "03:08:47", "text": "クソッ"}, {"type": "subtitle", "time": 11328.83, "timestamp": "03:08:48", "text": "ああ、"}, {"type": "subtitle", "time": 11331.91, "timestamp": "03:08:51", "text": "神。彼は幽霊に猛烈に攻撃を仕掛けている"}]
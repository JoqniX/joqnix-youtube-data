[{"type": "subtitle", "time": 8040.31, "timestamp": "02:14:00", "text": "ああ、君の好きな人を見てごらん。私は盗んだ"}, {"type": "subtitle", "time": 8042.229, "timestamp": "02:14:02", "text": "それ。"}, {"type": "subtitle", "time": 8044.589, "timestamp": "02:14:04", "text": "私は手に入れた"}, {"type": "subtitle", "time": 8048.069, "timestamp": "02:14:08", "text": "最初の取引で。おお"}, {"type": "subtitle", "time": 8052.87, "timestamp": "02:14:12", "text": "我が神よ。ついに。ケルケ"}, {"type": "subtitle", "time": 8055.83, "timestamp": "02:14:15", "text": "130. それはお得な取引ですか？うん。私"}, {"type": "subtitle", "time": 8058.47, "timestamp": "02:14:18", "text": "50に触れた。3つ待つ。いいえ、"}, {"type": "subtitle", "time": 8060.149, "timestamp": "02:14:20", "text": "それは良い取引とは言えません。彼女は求めている"}, {"type": "subtitle", "time": 8062.629, "timestamp": "02:14:22", "text": "三つ。うん。"}, {"type": "subtitle", "time": 8063.91, "timestamp": "02:14:23", "text": "あ、待って。それは良い取引ですね。一度もない"}, {"type": "subtitle", "time": 8066.31, "timestamp": "02:14:26", "text": "心。取引。いつ彼女に会いたいですか、"}, {"type": "subtitle", "time": 8070.229, "timestamp": "02:14:30", "text": "みんな？朝。えっと、夜をやってください。日付。遅い"}, {"type": "subtitle", "time": 8071.75, "timestamp": "02:14:31", "text": "夜。深夜。うん、遅いね"}, {"type": "subtitle", "time": 8075.589, "timestamp": "02:14:35", "text": "夜。はい、経験値とより多くのお金が手に入ります。"}, {"type": "subtitle", "time": 8077.83, "timestamp": "02:14:37", "text": "島の射撃場。射撃場はどこですか？"}, {"type": "subtitle", "time": 8081.589, "timestamp": "02:14:41", "text": "見てみましょう。追加のお金がもらえます"}, {"type": "subtitle", "time": 8083.589, "timestamp": "02:14:43", "text": "午前4時、時間が止まる。つまり、"}, {"type": "subtitle", "time": 8087.27, "timestamp": "02:14:47", "text": "麻薬を売るのに十分な時間。わかった、"}, {"type": "subtitle", "time": 8089.51, "timestamp": "02:14:49", "text": "射撃場はすぐそこにある"}, {"type": "subtitle", "time": 8097.31, "timestamp": "02:14:57", "text": "そうですね"}]
[{"type": "subtitle", "time": 17940.788, "timestamp": "04:59:00", "text": "ああ、"}, {"type": "subtitle", "time": 17943.03, "timestamp": "04:59:03", "text": "だから私たちはただ叫んでいた"}, {"type": "subtitle", "time": 17945.43, "timestamp": "04:59:05", "text": "最初のラウンドでバカみたいに保留"}, {"type": "subtitle", "time": 17947.11, "timestamp": "04:59:07", "text": "私たちが遊んでいたとき 私が遊んでいたとき"}, {"type": "subtitle", "time": 17949.19, "timestamp": "04:59:09", "text": "ミツァイ。私は叫んでいた"}, {"type": "subtitle", "time": 17952.788, "timestamp": "04:59:12", "text": "バカみたいに保留中。おお。"}, {"type": "subtitle", "time": 17954.55, "timestamp": "04:59:14", "text": "いい試合だった。いい試合だった。私は本当にバカだ"}, {"type": "subtitle", "time": 17957.19, "timestamp": "04:59:17", "text": "くそっ。"}, {"type": "subtitle", "time": 17959.59, "timestamp": "04:59:19", "text": "エミリー・ディクソン。彼女はなんて嫌な奴なんだ"}, {"type": "subtitle", "time": 17968.948, "timestamp": "04:59:28", "text": "ああ、私がそれを演奏してほしいのか、それとも、えっと、Va 君が"}, {"type": "subtitle", "time": 17971.99, "timestamp": "04:59:31", "text": "また立ち上がったの？ああ、そのまま演奏を続けてください。私"}, {"type": "subtitle", "time": 17974.47, "timestamp": "04:59:34", "text": "つまり、私はストリーミング配信すらしていないので"}, {"type": "subtitle", "time": 17976.948, "timestamp": "04:59:36", "text": "私はただあなたが助けているのを見ているだけです"}, {"type": "subtitle", "time": 17980.55, "timestamp": "04:59:40", "text": "欲しい。よし、"}, {"type": "subtitle", "time": 17981.708, "timestamp": "04:59:41", "text": "エミリー"}, {"type": "subtitle", "time": 17984.31, "timestamp": "04:59:44", "text": "ディクソン。彼女はそれが本当に好きなんだと思う"}, {"type": "subtitle", "time": 17986.868, "timestamp": "04:59:46", "text": "ちんこ。"}, {"type": "subtitle", "time": 17988.39, "timestamp": "04:59:48", "text": "エミリー、"}, {"type": "subtitle", "time": 17991.11, "timestamp": "04:59:51", "text": "彼に吸わせて"}, {"type": "subtitle", "time": 17994.23, "timestamp": "04:59:54", "text": "彼に仕事を奪わせてやろう。"}, {"type": "subtitle", "time": 17998.55, "timestamp": "04:59:58", "text": "エミリー、どこにいるの？応答なし。わかった、"}]
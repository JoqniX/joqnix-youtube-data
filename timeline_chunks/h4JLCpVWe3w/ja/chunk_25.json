[{"type": "subtitle", "time": 1510.31, "timestamp": "00:25:10", "text": "よし、コカインを調べてみよう。その"}, {"type": "subtitle", "time": 1535.23, "timestamp": "00:25:35", "text": "君たちはなぜ働いていないの？あなたに支払いました"}, {"type": "subtitle", "time": 1544.43, "timestamp": "00:25:44", "text": "それぞれ。しかしそれでも"}, {"type": "subtitle", "time": 1549.07, "timestamp": "00:25:49", "text": "ここ。すべての材料は正しいものであるべきです"}, {"type": "subtitle", "time": 1552.99, "timestamp": "00:25:52", "text": "けれど。プレミアムを買います"}, {"type": "subtitle", "time": 1556.87, "timestamp": "00:25:56", "text": "メタミン。心配しないで。この休息を終える"}, {"type": "subtitle", "time": 1558.43, "timestamp": "00:25:58", "text": "この青いレベル"}]
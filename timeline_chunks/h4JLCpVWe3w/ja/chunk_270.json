[{"type": "subtitle", "time": 16200.429, "timestamp": "04:30:00", "text": "いいえ。わかった。君は要らない"}, {"type": "subtitle", "time": 16203.99, "timestamp": "04:30:03", "text": "とにかくその写真が必要なんだよ、兄弟。"}, {"type": "subtitle", "time": 16212.309, "timestamp": "04:30:12", "text": "それで、あなたが亡くなった時、凍りつくのを見ましたか？"}, {"type": "subtitle", "time": 16214.07, "timestamp": "04:30:14", "text": "気温とか何か？口が見えましたか？"}, {"type": "subtitle", "time": 16217.79, "timestamp": "04:30:17", "text": "あなたの口から出てくるものは何ですか？いや、違うよ。"}, {"type": "subtitle", "time": 16221.67, "timestamp": "04:30:21", "text": "わかった。えっと、電磁場（EMF）の測定値はどうでしたか？"}, {"type": "subtitle", "time": 16224.87, "timestamp": "04:30:24", "text": "ああ、彼女は私の死体の上にいる。"}, {"type": "subtitle", "time": 16226.55, "timestamp": "04:30:26", "text": "待って、彼女はあなたの死体の上にいるわよ。何"}, {"type": "subtitle", "time": 16228.469, "timestamp": "04:30:28", "text": "変人？"}, {"type": "subtitle", "time": 16231.83, "timestamp": "04:30:31", "text": "うん。ええ、彼女はそこへ行ったんです。"}, {"type": "subtitle", "time": 16234.59, "timestamp": "04:30:34", "text": "ああ、AMF給餌の仕事って何だったの？えっと、それは"}, {"type": "subtitle", "time": 16238.79, "timestamp": "04:30:38", "text": "4、5だった。いいえ、３つです。 ３、４。"}, {"type": "subtitle", "time": 16242.67, "timestamp": "04:30:42", "text": "ああ、彼女が来るわ。わかった、彼女は去った"}, {"type": "subtitle", "time": 16246.149, "timestamp": "04:30:46", "text": "一体何が起こっているんだ。彼女は去った"}, {"type": "subtitle", "time": 16249.75, "timestamp": "04:30:49", "text": "階段。うん、おそらく彼女がトップだろうね。"}, {"type": "subtitle", "time": 16251.03, "timestamp": "04:30:51", "text": "彼女は私を探しているが、"}, {"type": "subtitle", "time": 16254.75, "timestamp": "04:30:54", "text": "自分が隅っこにいるって分かってるでしょ。おい、坊や。おい。"}, {"type": "subtitle", "time": 16257.67, "timestamp": "04:30:57", "text": "おい。おい、幽霊。ねえ、知ってる？"}]
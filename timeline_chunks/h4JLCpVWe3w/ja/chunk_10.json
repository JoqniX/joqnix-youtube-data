[{"type": "subtitle", "time": 601.19, "timestamp": "00:10:01", "text": "右？私はとても遠くにいる。私は"}, {"type": "subtitle", "time": 620.23, "timestamp": "00:10:20", "text": "また。私はあまりスペースキーを押さなかった。"}, {"type": "subtitle", "time": 621.01, "timestamp": "00:10:21", "text": "大丈夫ですよ。"}, {"type": "subtitle", "time": 648.069, "timestamp": "00:10:48", "text": "何でも。わかった。私は参加します"}, {"type": "subtitle", "time": 650.87, "timestamp": "00:10:50", "text": "コラボレーションではなく、彼らに参加する。うん、"}, {"type": "subtitle", "time": 653.509, "timestamp": "00:10:53", "text": "わかりません。彼らはぶら下がっている 私はそうしない"}, {"type": "subtitle", "time": 655.35, "timestamp": "00:10:55", "text": "コラボレーションと呼べるかどうかはわかりませんが、"}, {"type": "subtitle", "time": 658.11, "timestamp": "00:10:58", "text": "ちょっとだけ参加させてください。それは"}]
[{"type": "subtitle", "time": 17520.788, "timestamp": "04:52:00", "text": "それもうまくいくの？"}, {"type": "subtitle", "time": 17523.27, "timestamp": "04:52:03", "text": "えっと、もしゲームが見えるなら、"}, {"type": "subtitle", "time": 17525.43, "timestamp": "04:52:05", "text": "問題ありません。"}, {"type": "subtitle", "time": 17530.19, "timestamp": "04:52:10", "text": "ストリーミング画面の1つを見ることができます。"}, {"type": "subtitle", "time": 17540.708, "timestamp": "04:52:20", "text": "画面。文字通りできないところが気に入っています"}, {"type": "subtitle", "time": 17544.868, "timestamp": "04:52:24", "text": "私を捕まえて、あの幽霊がいかに愚かだったかを見せてください。"}, {"type": "subtitle", "time": 17548.708, "timestamp": "04:52:28", "text": "小さな幽霊。小さな幽霊。"}, {"type": "subtitle", "time": 17557.75, "timestamp": "04:52:37", "text": "この男を捕まえろ。なぜ表示されないのか"}, {"type": "subtitle", "time": 17561.55, "timestamp": "04:52:41", "text": "画面共有はありますか？はい、わかりました"}, {"type": "subtitle", "time": 17564.43, "timestamp": "04:52:44", "text": "それ。"}, {"type": "subtitle", "time": 17569.99, "timestamp": "04:52:49", "text": "えっと、窓。よし、ライブ配信を始めよう。わかった。はい、私は"}, {"type": "subtitle", "time": 17574.15, "timestamp": "04:52:54", "text": "私はそれを見ました。はい、見ています。はい。はい。"}]
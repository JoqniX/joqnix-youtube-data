[{"type": "subtitle", "time": 11822.67, "timestamp": "03:17:02", "text": "車？それは"}, {"type": "subtitle", "time": 11836.07, "timestamp": "03:17:16", "text": "あなたはこれらが手に入ることを知っています。何が"}, {"type": "subtitle", "time": 11838.349, "timestamp": "03:17:18", "text": "それ？何が"}, {"type": "subtitle", "time": 11842.07, "timestamp": "03:17:22", "text": "それ？待って。ニャー。ミッチ。作りましたか"}, {"type": "subtitle", "time": 11845.07, "timestamp": "03:17:25", "text": "あの音？見て、聞いて"}, {"type": "subtitle", "time": 11848.91, "timestamp": "03:17:28", "text": "それ？待って。何かが開いた"}, {"type": "subtitle", "time": 11852.429, "timestamp": "03:17:32", "text": "側。それは"}, {"type": "subtitle", "time": 11854.389, "timestamp": "03:17:34", "text": "地下。ああ、地下室ですね。その"}, {"type": "subtitle", "time": 11856.87, "timestamp": "03:17:36", "text": "地下。地下室です。私はまばたきをしている。"}, {"type": "subtitle", "time": 11859.429, "timestamp": "03:17:39", "text": "あの、懐中電灯が点滅しています。ああ、"}, {"type": "subtitle", "time": 11861.309, "timestamp": "03:17:41", "text": "神よ、それは"}, {"type": "subtitle", "time": 11865.389, "timestamp": "03:17:45", "text": "地下。何てことだ。こんにちは、宇宙"}, {"type": "subtitle", "time": 11867.79, "timestamp": "03:17:47", "text": "猿。ああ、君"}]
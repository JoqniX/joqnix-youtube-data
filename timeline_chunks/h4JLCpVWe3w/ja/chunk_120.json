[{"type": "subtitle", "time": 7206.39, "timestamp": "02:00:06", "text": "えっと、翻訳のために、みんな、私は言った"}, {"type": "subtitle", "time": 7209.51, "timestamp": "02:00:09", "text": "母の目。"}, {"type": "subtitle", "time": 7213.51, "timestamp": "02:00:13", "text": "それは、それは、これを打たない"}, {"type": "subtitle", "time": 7216.55, "timestamp": "02:00:16", "text": "もう全く効かない。話しましたか？"}, {"type": "subtitle", "time": 7219.589, "timestamp": "02:00:19", "text": "電話を使って？"}, {"type": "subtitle", "time": 7221.27, "timestamp": "02:00:21", "text": "なんでここに公衆電話しかないんだよ？"}, {"type": "subtitle", "time": 7222.95, "timestamp": "02:00:22", "text": "一体どういうことだ？もうすぐ準備は整いますが、"}, {"type": "subtitle", "time": 7224.87, "timestamp": "02:00:24", "text": "鍵が1つ足りないよ。あなたには"}, {"type": "subtitle", "time": 7226.75, "timestamp": "02:00:26", "text": "供給業者に問い合わせてください。手に入れる"}, {"type": "subtitle", "time": 7229.35, "timestamp": "02:00:29", "text": "手。えっと、あなたの電話番号を伝えました"}, {"type": "subtitle", "time": 7231.83, "timestamp": "02:00:31", "text": "アルバート・フーバーへ。"}, {"type": "subtitle", "time": 7234.39, "timestamp": "02:00:34", "text": "わかった。"}, {"type": "subtitle", "time": 7236.95, "timestamp": "02:00:36", "text": "デッドドロップ。私はあなたのために負けたので"}, {"type": "subtitle", "time": 7238.189, "timestamp": "02:00:38", "text": "支払いを済ませる"}, {"type": "subtitle", "time": 7254.55, "timestamp": "02:00:54", "text": "[音楽]"}, {"type": "subtitle", "time": 7256.84, "timestamp": "02:00:56", "text": "わかった。くたばれ。"}, {"type": "subtitle", "time": 7259.83, "timestamp": "02:00:59", "text": "[音楽]"}]
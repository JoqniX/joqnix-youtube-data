[{"type": "subtitle", "time": 3603.19, "timestamp": "01:00:03", "text": "良い。"}, {"type": "subtitle", "time": 3605.69, "timestamp": "01:00:05", "text": "お前はもう終わりだ、坊や。"}, {"type": "subtitle", "time": 3612.15, "timestamp": "01:00:12", "text": "よし、実際の"}, {"type": "subtitle", "time": 3614.23, "timestamp": "01:00:14", "text": "ロビーのシーン。"}, {"type": "subtitle", "time": 3618.71, "timestamp": "01:00:18", "text": "ああ、私のモデルが見つからない。ああ、もう。私の私の"}, {"type": "subtitle", "time": 3622.47, "timestamp": "01:00:22", "text": "私のモデルのアイロンセット。ああ、そこにいる"}, {"type": "subtitle", "time": 3625.349, "timestamp": "01:00:25", "text": "行く。君たちの声が聞こえるようになったよ。こんにちは"}, {"type": "subtitle", "time": 3629.829, "timestamp": "01:00:29", "text": "チャドだよ、みんな。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 3633.109, "timestamp": "01:00:33", "text": "うん、よかった。ああ、そうするべきだ。ああ、もう。"}, {"type": "subtitle", "time": 3634.95, "timestamp": "01:00:34", "text": "それと、コミコンであなたを見かけませんでした。私"}, {"type": "subtitle", "time": 3636.47, "timestamp": "01:00:36", "text": "私はムンバイには行かない"}, {"type": "subtitle", "time": 3640.349, "timestamp": "01:00:40", "text": "コミコン。ムンバイに行くには忙しすぎる"}, {"type": "subtitle", "time": 3646.71, "timestamp": "01:00:46", "text": "げっぷ。それは私とアラができなかったから"}, {"type": "subtitle", "time": 3649.27, "timestamp": "01:00:49", "text": "地下室から出る方法を考え出す。"}, {"type": "subtitle", "time": 3651.27, "timestamp": "01:00:51", "text": "はい、叫び声です。私たちは"}, {"type": "subtitle", "time": 3653.829, "timestamp": "01:00:53", "text": "地下。それはまさに「こんにちは」だ。いらっしゃいませ"}, {"type": "subtitle", "time": 3656.63, "timestamp": "01:00:56", "text": "チャット参加者へ。チャットチャット"}, {"type": "subtitle", "time": 3659.109, "timestamp": "01:00:59", "text": "おしゃべり。母とチャットしています"}]
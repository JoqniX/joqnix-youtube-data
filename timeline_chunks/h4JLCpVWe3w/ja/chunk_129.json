[{"type": "subtitle", "time": 7742.43, "timestamp": "02:09:02", "text": "世界のより多くの部分"}, {"type": "subtitle", "time": 7746.629, "timestamp": "02:09:06", "text": "たくさんやっています。これは"}, {"type": "subtitle", "time": 7758.35, "timestamp": "02:09:18", "text": "あ、ここに公衆電話があるよ。"}, {"type": "subtitle", "time": 7762.83, "timestamp": "02:09:22", "text": "兄弟。トンプソン建設と"}, {"type": "subtitle", "time": 7766.149, "timestamp": "02:09:26", "text": "デモ。えーと、OG キャッシュを販売リストに載せてください"}, {"type": "subtitle", "time": 7767.99, "timestamp": "02:09:27", "text": "プロダクトマネージャー向けアプリ。あ、待って。我々は持っています"}, {"type": "subtitle", "time": 7770.149, "timestamp": "02:09:30", "text": "それをリストアップする。わかった。そうそう。そうそう。"}, {"type": "subtitle", "time": 7771.83, "timestamp": "02:09:31", "text": "うん。"}, {"type": "subtitle", "time": 7773.709, "timestamp": "02:09:33", "text": "まあ、誰も私に言わないで"}, {"type": "subtitle", "time": 7779.109, "timestamp": "02:09:39", "text": "それ。お前はオタクだ。レーベン。"}, {"type": "subtitle", "time": 7781.83, "timestamp": "02:09:41", "text": "あなたは愛し、愛し続ける。"}, {"type": "subtitle", "time": 7785.589, "timestamp": "02:09:45", "text": "いや、そんなことはないよ。"}, {"type": "subtitle", "time": 7788.629, "timestamp": "02:09:48", "text": "どうやって売ればいいですか？マリファナ。えっと、今私たちは"}, {"type": "subtitle", "time": 7791.43, "timestamp": "02:09:51", "text": "顧客を待つか、または私たちは"}, {"type": "subtitle", "time": 7794.149, "timestamp": "02:09:54", "text": "無料サンプルを提供するなど"}, {"type": "subtitle", "time": 7797.27, "timestamp": "02:09:57", "text": "顧客。待って、私たちはそれを売る"}, {"type": "subtitle", "time": 7799.75, "timestamp": "02:09:59", "text": "希望価格は38です。"}]
[{"type": "subtitle", "time": 8522.15, "timestamp": "02:22:02", "text": "よし。誰かが注文したんですか？"}, {"type": "subtitle", "time": 8524.309, "timestamp": "02:22:04", "text": "ええ、注文しましたよ。種は"}, {"type": "subtitle", "time": 8525.83, "timestamp": "02:22:05", "text": "ストレージ。"}, {"type": "subtitle", "time": 8527.27, "timestamp": "02:22:07", "text": "よし。みんな、寝ようよ。私たちには"}, {"type": "subtitle", "time": 8529.59, "timestamp": "02:22:09", "text": "午前中に取引する。"}, {"type": "subtitle", "time": 8537.469, "timestamp": "02:22:17", "text": "おお、いいね。"}, {"type": "subtitle", "time": 8546.389, "timestamp": "02:22:26", "text": "ストリート・ラット4。"}, {"type": "subtitle", "time": 8549.51, "timestamp": "02:22:29", "text": "よし、行こう。"}, {"type": "subtitle", "time": 8552.55, "timestamp": "02:22:32", "text": "もう一つ植物を買わないといけない。"}, {"type": "subtitle", "time": 8554.469, "timestamp": "02:22:34", "text": "ひどい。"}, {"type": "subtitle", "time": 8556.67, "timestamp": "02:22:36", "text": "よく眠れたね。私"}, {"type": "subtitle", "time": 8558.67, "timestamp": "02:22:38", "text": "すべて手に入れました"}, {"type": "subtitle", "time": 8570.55, "timestamp": "02:22:50", "text": "猫はどこ？えっと、この人はどこにいるんですか？おお、"}, {"type": "subtitle", "time": 8573.51, "timestamp": "02:22:53", "text": "彼らはまだ到着していません。なんてこった。"}]
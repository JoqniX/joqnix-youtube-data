[{"type": "subtitle", "time": 4626.87, "timestamp": "01:17:06", "text": "よし。よし。何が"}, {"type": "subtitle", "time": 4629.91, "timestamp": "01:17:09", "text": "ここで起きていること。"}, {"type": "subtitle", "time": 4633.43, "timestamp": "01:17:13", "text": "こんにちは。 H. こんにちは、ネルソンの連絡先です。これですか"}, {"type": "subtitle", "time": 4639.43, "timestamp": "01:17:19", "text": "こんにちは。ええ、ネルソンと話をする必要があります"}, {"type": "subtitle", "time": 4650.07, "timestamp": "01:17:30", "text": "何？彼はただ「こんにちは」と言うだけです。私は"}, {"type": "subtitle", "time": 4653.03, "timestamp": "01:17:33", "text": "なんてこった。いいえ。ええと、1つ無料で提供しています"}, {"type": "subtitle", "time": 4656.39, "timestamp": "01:17:36", "text": "隣の看護師の一人にサンプルを渡す"}, {"type": "subtitle", "time": 4659.91, "timestamp": "01:17:39", "text": "診療所。わかった。"}, {"type": "subtitle", "time": 4663.59, "timestamp": "01:17:43", "text": "それはあなたの左側にあります、星と"}, {"type": "subtitle", "time": 4665.83, "timestamp": "01:17:45", "text": "すべて。"}, {"type": "subtitle", "time": 4668.149, "timestamp": "01:17:48", "text": "製造過程を注意深く観察してください。"}, {"type": "subtitle", "time": 4670.31, "timestamp": "01:17:50", "text": "ラウンド。連絡先アプリを開きます。私はすでに"}, {"type": "subtitle", "time": 4673.83, "timestamp": "01:17:53", "text": "噂は広まった。わかった。えっと、あなたは"}, {"type": "subtitle", "time": 4675.35, "timestamp": "01:17:55", "text": "「ああ、連絡先を開く」をクリックします。"}, {"type": "subtitle", "time": 4679.87, "timestamp": "01:17:59", "text": "右？テキストではない。ああ、わかりました。"}]
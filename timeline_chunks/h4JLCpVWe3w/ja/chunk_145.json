[{"type": "subtitle", "time": 8700.83, "timestamp": "02:25:00", "text": "よし、ジェシー、行くぞ、行くぞ。来る"}, {"type": "subtitle", "time": 8703.79, "timestamp": "02:25:03", "text": "の上。彼女は起きていられる"}, {"type": "subtitle", "time": 8706.91, "timestamp": "02:25:06", "text": "そこには。ジョン、止まれ"}, {"type": "subtitle", "time": 8711.11, "timestamp": "02:25:11", "text": "調査を開始する。走る。"}, {"type": "subtitle", "time": 8714.07, "timestamp": "02:25:14", "text": "モーテルに行くよ。あれはポーですか？"}, {"type": "subtitle", "time": 8716.63, "timestamp": "02:25:16", "text": "うん。"}, {"type": "subtitle", "time": 8720.4, "timestamp": "02:25:20", "text": "ああ、水は手に入れたよ。持続する。"}, {"type": "subtitle", "time": 8723.19, "timestamp": "02:25:23", "text": "[音楽]"}, {"type": "subtitle", "time": 8725.51, "timestamp": "02:25:25", "text": "私たちは完全に平和的な麻薬取引業者です"}, {"type": "subtitle", "time": 8727.23, "timestamp": "02:25:27", "text": "グループ。"}, {"type": "subtitle", "time": 8736.469, "timestamp": "02:25:36", "text": "やあ、モデレーター。なぜ私はすべての"}, {"type": "subtitle", "time": 8739.429, "timestamp": "02:25:39", "text": "ここの照明はどうですか？"}, {"type": "subtitle", "time": 8748.389, "timestamp": "02:25:48", "text": "いいえ。それを収穫できますか？なんてこった。病気"}, {"type": "subtitle", "time": 8753.03, "timestamp": "02:25:53", "text": "では、私たちはプレイしなければならないのでしょうか"}, {"type": "subtitle", "time": 8755.27, "timestamp": "02:25:55", "text": "毎回一緒に？なんてこった。あなたはできる"}, {"type": "subtitle", "time": 8757.429, "timestamp": "02:25:57", "text": "一人でもプレイできます。はい、プレイできます"}, {"type": "subtitle", "time": 8759.59, "timestamp": "02:25:59", "text": "一人で。うん。"}]
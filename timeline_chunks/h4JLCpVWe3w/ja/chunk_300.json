[{"type": "subtitle", "time": 18004.31, "timestamp": "05:00:04", "text": "えっと、トラックに戻って見てみて"}, {"type": "subtitle", "time": 18007.27, "timestamp": "05:00:07", "text": "書かれている通りに答えてください。回答を参照してください"}, {"type": "subtitle", "time": 18012.628, "timestamp": "05:00:12", "text": "そこに書いてあるとおり、そこにあります"}, {"type": "subtitle", "time": 18018.55, "timestamp": "05:00:18", "text": "何に対する反応を見るのですか？おお"}, {"type": "subtitle", "time": 18021.67, "timestamp": "05:00:21", "text": "孤独な人への対応。"}, {"type": "subtitle", "time": 18039.51, "timestamp": "05:00:39", "text": "なぜこんなに暗いのですか？つまり、明らかにそれは"}, {"type": "subtitle", "time": 18041.27, "timestamp": "05:00:41", "text": "幽霊が出る場所。暗闇が訪れるだろう。"}, {"type": "subtitle", "time": 18045.83, "timestamp": "05:00:45", "text": "一体どういうこと？何？缶が転がっている"}, {"type": "subtitle", "time": 18048.07, "timestamp": "05:00:48", "text": "それ自体で。 AMFリーダーを取り出してください。 EMF"}, {"type": "subtitle", "time": 18050.91, "timestamp": "05:00:50", "text": "リーダー。それを持っていく"}, {"type": "subtitle", "time": 18055.99, "timestamp": "05:00:55", "text": "外。何でも。ああ、３つ。三つ。わかった。"}, {"type": "subtitle", "time": 18057.59, "timestamp": "05:00:57", "text": "そこに塩を入れてください。そこに塩を入れてください。塩を入れる"}]
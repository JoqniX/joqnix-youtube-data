[{"type": "subtitle", "time": 9000.67, "timestamp": "02:30:00", "text": "そして、私たちは"}, {"type": "subtitle", "time": 9011.99, "timestamp": "02:30:11", "text": "来て。巨額の資金。巨額の資金。 21個ゲット"}, {"type": "subtitle", "time": 9015.27, "timestamp": "02:30:15", "text": "そこから。ああ、足りない。"}, {"type": "subtitle", "time": 9017.91, "timestamp": "02:30:17", "text": "よし、みんな、今から批判を始めよう"}, {"type": "subtitle", "time": 9024.02, "timestamp": "02:30:24", "text": "の上。ゴミを捨てるってどういう意味？"}, {"type": "subtitle", "time": 9036.02, "timestamp": "02:30:36", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 9037.75, "timestamp": "02:30:37", "text": "[音楽]"}]
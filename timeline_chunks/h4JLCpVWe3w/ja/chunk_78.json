[{"type": "subtitle", "time": 4688.669, "timestamp": "01:18:08", "text": "アンディ、ダグ、私は"}, {"type": "subtitle", "time": 4690.95, "timestamp": "01:18:10", "text": "チェスリー？新しいロックを解除する最速の方法"}, {"type": "subtitle", "time": 4692.47, "timestamp": "01:18:12", "text": "顧客に無料サンプルを提供する"}, {"type": "subtitle", "time": 4695.27, "timestamp": "01:18:15", "text": "既存顧客ではなく、友人。"}, {"type": "subtitle", "time": 4697.59, "timestamp": "01:18:17", "text": "わかった。だから、ダグには無料であげなければならない"}, {"type": "subtitle", "time": 4701.03, "timestamp": "01:18:21", "text": "サンプル。いや、違うよ。ああ、"}, {"type": "subtitle", "time": 4704.47, "timestamp": "01:18:24", "text": "この男は、無料の"}, {"type": "subtitle", "time": 4707.03, "timestamp": "01:18:27", "text": "サンプル？"}, {"type": "subtitle", "time": 4717.669, "timestamp": "01:18:37", "text": "成功。それは素晴らしいですね。聞くことになるでしょう"}, {"type": "subtitle", "time": 4718.99, "timestamp": "01:18:38", "text": "から"}, {"type": "subtitle", "time": 4724.229, "timestamp": "01:18:44", "text": "自分。わかった。わかった。シールドはこちら。ここで癒やしなさい。"}, {"type": "subtitle", "time": 4726.39, "timestamp": "01:18:46", "text": "さて、次はどうする？チェルシーをアンロックしました"}, {"type": "subtitle", "time": 4737.03, "timestamp": "01:18:57", "text": "これで君はプロとして彼と話をしたことになる。わかった。"}, {"type": "subtitle", "time": 4738.63, "timestamp": "01:18:58", "text": "このプロローグはどれくらいの長さになる予定ですか？"}]
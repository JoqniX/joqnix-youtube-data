[{"type": "subtitle", "time": 9785.99, "timestamp": "02:43:05", "text": "ディズニーパークは順調に進んでいると思う"}, {"type": "subtitle", "time": 9795.75, "timestamp": "02:43:15", "text": "エモ、パッケージを取ってもらえますか？"}, {"type": "subtitle", "time": 9799.75, "timestamp": "02:43:19", "text": "駅とかそういうの？ああ、そうそう。全て"}, {"type": "subtitle", "time": 9801.75, "timestamp": "02:43:21", "text": "右。ベッドを取るか"}, {"type": "subtitle", "time": 9803.99, "timestamp": "02:43:23", "text": "何か。私たちはまだベッドを買うことができます"}, {"type": "subtitle", "time": 9805.75, "timestamp": "02:43:25", "text": "未来。あ、待って、ベッドは必要ないんだった。"}, {"type": "subtitle", "time": 9808.55, "timestamp": "02:43:28", "text": "どうでも。ベッドがあります。私たちは共有できます"}, {"type": "subtitle", "time": 9811.07, "timestamp": "02:43:31", "text": "ベッド。一緒に寄り添うことができます。大丈夫。"}, {"type": "subtitle", "time": 9815.75, "timestamp": "02:43:35", "text": "何が欲しいの？なんてこった。いいえ。"}, {"type": "subtitle", "time": 9818.67, "timestamp": "02:43:38", "text": "大きくなったね。"}]
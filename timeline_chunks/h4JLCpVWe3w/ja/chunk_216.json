[{"type": "subtitle", "time": 12966.229, "timestamp": "03:36:06", "text": "神。ああ、ああ、待って。私はそうだったと思います"}, {"type": "subtitle", "time": 12980.19, "timestamp": "03:36:20", "text": "来るよ。何？私は私に話しかけていました"}, {"type": "subtitle", "time": 12984.469, "timestamp": "03:36:24", "text": "マイク。彼女にやられたと思う。"}, {"type": "subtitle", "time": 12986.349, "timestamp": "03:36:26", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 12989.19, "timestamp": "03:36:29", "text": "わかった。ああ、私はとても激しく叫んだので、"}, {"type": "subtitle", "time": 12990.91, "timestamp": "03:36:30", "text": "おばあちゃんが洞窟に落ちた。何"}, {"type": "subtitle", "time": 12993.79, "timestamp": "03:36:33", "text": "何が起こったのか？おお"}, {"type": "subtitle", "time": 12997.67, "timestamp": "03:36:37", "text": "神。聖なる。"}, {"type": "subtitle", "time": 13001.03, "timestamp": "03:36:41", "text": "私は戻ってきます。こんにちは。さて、なぜあなたはそうしないのですか？"}, {"type": "subtitle", "time": 13004.55, "timestamp": "03:36:44", "text": "話してるの？待って、ボタンを押して。"}, {"type": "subtitle", "time": 13008.19, "timestamp": "03:36:48", "text": "待って、私は話していなかった。何？おお、"}, {"type": "subtitle", "time": 13011.67, "timestamp": "03:36:51", "text": "何？ああ、プッシュトゥトークに変更しました"}, {"type": "subtitle", "time": 13013.67, "timestamp": "03:36:53", "text": "そして私はそれを押していたが、それでもあなたは"}, {"type": "subtitle", "time": 13017.19, "timestamp": "03:36:57", "text": "聞こえなかった。ちょっと待って。"}]
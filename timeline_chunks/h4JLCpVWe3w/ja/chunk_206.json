[{"type": "subtitle", "time": 12369.25, "timestamp": "03:26:09", "text": "ああ、ソフィー、私は"}, {"type": "subtitle", "time": 12376.469, "timestamp": "03:26:16", "text": "なれ。いいえ、まだ続きがあります。ああ、まあまあ"}, {"type": "subtitle", "time": 12377.55, "timestamp": "03:26:17", "text": "キャラクターは"}, {"type": "subtitle", "time": 12380.79, "timestamp": "03:26:20", "text": "凍りつく。凍りつく。"}, {"type": "subtitle", "time": 12416.59, "timestamp": "03:26:56", "text": "ああ、それは"}, {"type": "subtitle", "time": 12418.91, "timestamp": "03:26:58", "text": "ビープ音が鳴っている。おお。おお。"}]
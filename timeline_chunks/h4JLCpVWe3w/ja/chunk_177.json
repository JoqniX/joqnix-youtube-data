[{"type": "subtitle", "time": 10620.71, "timestamp": "02:57:00", "text": "来て。雨に濡れろ。"}, {"type": "subtitle", "time": 10631.99, "timestamp": "02:57:11", "text": "友達に挨拶しに来てください。ああ、くそ。"}, {"type": "subtitle", "time": 10644.51, "timestamp": "02:57:24", "text": "ポケモンが欲しい人はいますか？楽しむ"}, {"type": "subtitle", "time": 10647.75, "timestamp": "02:57:27", "text": "あなた方自身。皆さん、また明日。全て"}, {"type": "subtitle", "time": 10651.07, "timestamp": "02:57:31", "text": "はい、皆さん。ありがとうございます"}]
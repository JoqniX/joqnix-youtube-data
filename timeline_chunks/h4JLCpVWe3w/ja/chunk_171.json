[{"type": "subtitle", "time": 10260.95, "timestamp": "02:51:00", "text": "アスペンの木が枯れる。アスペンが亡くなった。何"}, {"type": "subtitle", "time": 10265.11, "timestamp": "02:51:05", "text": "なんだって？うん。ああ、変更できるよ"}, {"type": "subtitle", "time": 10268.309, "timestamp": "02:51:08", "text": "名前は、えーと、ただ終了するだけです"}, {"type": "subtitle", "time": 10271.269, "timestamp": "02:51:11", "text": "名前が表示されます。ランダムな名前を取得できます"}, {"type": "subtitle", "time": 10283.389, "timestamp": "02:51:23", "text": "はい。同じくらい悪い。わーい。"}, {"type": "subtitle", "time": 10286.429, "timestamp": "02:51:26", "text": "製品。剣はどこだ"}, {"type": "subtitle", "time": 10290.63, "timestamp": "02:51:30", "text": "ディーゼル？名前を変更するにはどうすればいいですか？"}, {"type": "subtitle", "time": 10294.389, "timestamp": "02:51:34", "text": "ああ、残念ながら名前は変更できません。"}, {"type": "subtitle", "time": 10296.71, "timestamp": "02:51:36", "text": "名前を変更することしかできません。"}, {"type": "subtitle", "time": 10299.75, "timestamp": "02:51:39", "text": "薬を作って気に入ったら"}, {"type": "subtitle", "time": 10302.389, "timestamp": "02:51:42", "text": "示しているのは"}, {"type": "subtitle", "time": 10306.71, "timestamp": "02:51:46", "text": "毎回必ず騎馬隊が現れる。"}, {"type": "subtitle", "time": 10311.03, "timestamp": "02:51:51", "text": "待って、レッドブルを混ぜてもいい？はい、できます"}, {"type": "subtitle", "time": 10313.51, "timestamp": "02:51:53", "text": "あらゆる材料を混ぜ合わせることができます"}, {"type": "subtitle", "time": 10315.349, "timestamp": "02:51:55", "text": "利用可能で、組み合わせ自由です。では"}, {"type": "subtitle", "time": 10319.11, "timestamp": "02:51:59", "text": "ごみ？いいえ、ゴミではありません。全て"}]
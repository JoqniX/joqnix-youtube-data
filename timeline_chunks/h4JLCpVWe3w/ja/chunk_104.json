[{"type": "subtitle", "time": 6242.48, "timestamp": "01:44:02", "text": "一体何が起こってるんだ、兄弟？ 良い。"}, {"type": "subtitle", "time": 6245.44, "timestamp": "01:44:05", "text": "良い。 わかった。彼らは私を捕まえられない。彼らはできない"}, {"type": "subtitle", "time": 6248.719, "timestamp": "01:44:08", "text": "わかった。彼らは私を捕まえられない。彼らはできない もう私を捕まえることはできない。"}, {"type": "subtitle", "time": 6254.55, "timestamp": "01:44:14", "text": "私はコンテナの上にいます。さあ"}, {"type": "subtitle", "time": 6256.07, "timestamp": "01:44:16", "text": "行く。"}, {"type": "subtitle", "time": 6257.669, "timestamp": "01:44:17", "text": "お元気ですか？編集する"}, {"type": "subtitle", "time": 6260.87, "timestamp": "01:44:20", "text": "拡大。あなたは注意して"}, {"type": "subtitle", "time": 6263.99, "timestamp": "01:44:23", "text": "君たち。お元気ですか、大男さん？良い。"}, {"type": "subtitle", "time": 6270.39, "timestamp": "01:44:30", "text": "くそ？ドナはどこ？ドナは死んだのか？"}, {"type": "subtitle", "time": 6272.47, "timestamp": "01:44:32", "text": "わからない。ドナは逃げている。"}, {"type": "subtitle", "time": 6274.629, "timestamp": "01:44:34", "text": "ドナはどこ？ドナ、私は"}, {"type": "subtitle", "time": 6284.95, "timestamp": "01:44:44", "text": "ドナ、あなたと話したいことがあるのよ。"}, {"type": "subtitle", "time": 6287.83, "timestamp": "01:44:47", "text": "あの、部屋を借りたいのですが。 75度になるでしょう"}, {"type": "subtitle", "time": 6290.79, "timestamp": "01:44:50", "text": "今週分。大丈夫。 1号室。"}, {"type": "subtitle", "time": 6293.99, "timestamp": "01:44:53", "text": "よし、みんな。部屋があります。"}, {"type": "subtitle", "time": 6296.79, "timestamp": "01:44:56", "text": "大丈夫ですか？入って。さあ。さあ行こう。"}, {"type": "subtitle", "time": 6298.47, "timestamp": "01:44:58", "text": "うん。入って。入って。私は入れない"}]
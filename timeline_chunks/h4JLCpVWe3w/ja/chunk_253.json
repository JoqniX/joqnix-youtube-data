[{"type": "subtitle", "time": 15181.51, "timestamp": "04:13:01", "text": "聞こえません。わかった。精神を転換する"}, {"type": "subtitle", "time": 15184.71, "timestamp": "04:13:04", "text": "ボックスオフも。"}, {"type": "subtitle", "time": 15187.11, "timestamp": "04:13:07", "text": "えっと、下へどうぞ。下へ進んでください。続けて"}, {"type": "subtitle", "time": 15190.59, "timestamp": "04:13:10", "text": "地下室。下。"}, {"type": "subtitle", "time": 15194.309, "timestamp": "04:13:14", "text": "わかった。なんてこった。うん。私は"}, {"type": "subtitle", "time": 15197.07, "timestamp": "04:13:17", "text": "地下室だけどね。わかった。さあ、あなたの"}, {"type": "subtitle", "time": 15200.389, "timestamp": "04:13:20", "text": "右。中に入って右折してください。"}, {"type": "subtitle", "time": 15203.349, "timestamp": "04:13:23", "text": "うん。そして最後に、"}, {"type": "subtitle", "time": 15204.63, "timestamp": "04:13:24", "text": "終わり。右側には"}, {"type": "subtitle", "time": 15209.429, "timestamp": "04:13:29", "text": "わかった。"}, {"type": "subtitle", "time": 15211.189, "timestamp": "04:13:31", "text": "うん。それから、電気をつけてください。"}, {"type": "subtitle", "time": 15214.51, "timestamp": "04:13:34", "text": "なぜ開けられないのですか？聞くところによると"}, {"type": "subtitle", "time": 15218.07, "timestamp": "04:13:38", "text": "誰か。発電機の筐体を開けることができません。"}, {"type": "subtitle", "time": 15219.189, "timestamp": "04:13:39", "text": "開けられないってどういう意味ですか"}, {"type": "subtitle", "time": 15222.229, "timestamp": "04:13:42", "text": "発電機ボックス？営業していません。"}, {"type": "subtitle", "time": 15224.469, "timestamp": "04:13:44", "text": "ああ、あなたはきっと"}, {"type": "subtitle", "time": 15226.71, "timestamp": "04:13:46", "text": "とんでもない。ここに誰かいる。例えば"}, {"type": "subtitle", "time": 15230.83, "timestamp": "04:13:50", "text": "クリックすると音が鳴る"}, {"type": "subtitle", "time": 15233.67, "timestamp": "04:13:53", "text": "来るよ。何？おお。おお。わかった。そうしなければならなかった"}, {"type": "subtitle", "time": 15236.55, "timestamp": "04:13:56", "text": "それを持っていてください。何てことだ。"}, {"type": "subtitle", "time": 15239.349, "timestamp": "04:13:59", "text": "クリックできません。"}]
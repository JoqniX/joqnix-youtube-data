[{"type": "subtitle", "time": 18362.47, "timestamp": "05:06:02", "text": "わかりました。物理的に顕現し、"}, {"type": "subtitle", "time": 18364.07, "timestamp": "05:06:04", "text": "場所を歩き回る"}, {"type": "subtitle", "time": 18366.15, "timestamp": "05:06:06", "text": "1人以上のプレイヤーを殺害する命令"}, {"type": "subtitle", "time": 18367.83, "timestamp": "05:06:07", "text": "狩猟の期間。光"}, {"type": "subtitle", "time": 18370.07, "timestamp": "05:06:10", "text": "幽霊のいる部屋がちらつきます。全て"}, {"type": "subtitle", "time": 18371.67, "timestamp": "05:06:11", "text": "出口のドアはロックされ、"}, {"type": "subtitle", "time": 18373.35, "timestamp": "05:06:13", "text": "幽霊は近くのすべての電子機器に"}, {"type": "subtitle", "time": 18375.99, "timestamp": "05:06:15", "text": "機器が故障する。呪われた狩り"}, {"type": "subtitle", "time": 18377.67, "timestamp": "05:06:17", "text": "呪われた者によって引き起こされる狩りの変種"}, {"type": "subtitle", "time": 18386.31, "timestamp": "05:06:26", "text": "わかった。わかった。狩りが終わると"}, {"type": "subtitle", "time": 18388.948, "timestamp": "05:06:28", "text": "最低25秒間のクールダウン"}, {"type": "subtitle", "time": 18390.47, "timestamp": "05:06:30", "text": "幽霊は開始を試みることができる"}, {"type": "subtitle", "time": 18392.948, "timestamp": "05:06:32", "text": "別の狩り。"}, {"type": "subtitle", "time": 18395.35, "timestamp": "05:06:35", "text": "ああ、これは正気度に基づくものにも当てはまる"}, {"type": "subtitle", "time": 18397.43, "timestamp": "05:06:37", "text": "そして、能力に基づいた狩り。幽霊が"}, {"type": "subtitle", "time": 18399.03, "timestamp": "05:06:39", "text": "この状況になったらすぐに狩りをする必要がある"}, {"type": "subtitle", "time": 18402.868, "timestamp": "05:06:42", "text": "クールダウンは終了しました。つまり25秒で"}, {"type": "subtitle", "time": 18405.91, "timestamp": "05:06:45", "text": "この狩りが終わったら塩を振る"}, {"type": "subtitle", "time": 18408.15, "timestamp": "05:06:48", "text": "戻るかそこへ行かないと、"}, {"type": "subtitle", "time": 18411.67, "timestamp": "05:06:51", "text": "ハント。塩を戻すのを待ってください。だから私は３つ使う"}, {"type": "subtitle", "time": 18413.75, "timestamp": "05:06:53", "text": "回。では、何回使用できますか"}, {"type": "subtitle", "time": 18419.67, "timestamp": "05:06:59", "text": "また塩？何回できるか見てみましょう"}]
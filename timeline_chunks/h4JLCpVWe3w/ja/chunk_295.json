[{"type": "subtitle", "time": 17703.67, "timestamp": "04:55:03", "text": "うん。待って。ああ、わかった。うん。ジェネレータ。"}, {"type": "subtitle", "time": 17707.67, "timestamp": "04:55:07", "text": "なぜ私はそれを殺したのか？わかった。"}, {"type": "subtitle", "time": 17711.03, "timestamp": "04:55:11", "text": "うん、前回はこんな感じだった"}, {"type": "subtitle", "time": 17713.59, "timestamp": "04:55:13", "text": "左クリックしようとしたのですが、"}, {"type": "subtitle", "time": 17715.99, "timestamp": "04:55:15", "text": "働く。私はそれを持っている。うまくいかない。私"}, {"type": "subtitle", "time": 17717.83, "timestamp": "04:55:17", "text": "そうしなければならなかった、なぜなら続ける必要があるから"}, {"type": "subtitle", "time": 17720.75, "timestamp": "04:55:20", "text": "掴んで引っ張ってください。ええ、知りませんでした"}, {"type": "subtitle", "time": 17723.59, "timestamp": "04:55:23", "text": "隅っこみたいに。だからあなたは"}, {"type": "subtitle", "time": 17725.75, "timestamp": "04:55:25", "text": "立ち往生。ドアの上部は閉まっていた。"}, {"type": "subtitle", "time": 17728.628, "timestamp": "04:55:28", "text": "そうそう。 「ベイビー、開けられないよ」って感じだった。"}, {"type": "subtitle", "time": 17735.59, "timestamp": "04:55:35", "text": "だから外に出るドアは外に開くが"}, {"type": "subtitle", "time": 17738.628, "timestamp": "04:55:38", "text": "内側の扉は外側に開く。オープンはありません"}, {"type": "subtitle", "time": 17747.67, "timestamp": "04:55:47", "text": "ああ、神様。彼に電話をかけ続けなさい。"}, {"type": "subtitle", "time": 17750.03, "timestamp": "04:55:50", "text": "じゃあ、"}, {"type": "subtitle", "time": 17752.31, "timestamp": "04:55:52", "text": "保留中。 EMFをチェックできます"}, {"type": "subtitle", "time": 17754.948, "timestamp": "04:55:54", "text": "読者でもある。"}, {"type": "subtitle", "time": 17757.2, "timestamp": "04:55:57", "text": "保留中。"}]
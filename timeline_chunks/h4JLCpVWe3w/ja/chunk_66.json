[{"type": "subtitle", "time": 3960.64, "timestamp": "01:06:00", "text": "待って、新しいゲームを始めるべきか、それとも、ああ、"}, {"type": "subtitle", "time": 3961.789, "timestamp": "01:06:01", "text": "[音楽]"}, {"type": "subtitle", "time": 3964.39, "timestamp": "01:06:04", "text": "うん。新しいゲームが登場しました。はい、それは"}, {"type": "subtitle", "time": 3967.51, "timestamp": "01:06:07", "text": "他に選択肢はないよね？わかった。待って、君"}, {"type": "subtitle", "time": 3970.23, "timestamp": "01:06:10", "text": "続行できません。なんてこった。ボラの"}, {"type": "subtitle", "time": 3972.069, "timestamp": "01:06:12", "text": "始まったばかりだ。"}, {"type": "subtitle", "time": 3974.27, "timestamp": "01:06:14", "text": "わかった。わかった。わかった。うん。うん。うん。"}, {"type": "subtitle", "time": 3977.029, "timestamp": "01:06:17", "text": "うん。うん。うん。うん。持続する。そこには"}, {"type": "subtitle", "time": 3980.71, "timestamp": "01:06:20", "text": "あなたが行く。これでゲイが見えるようになった。"}, {"type": "subtitle", "time": 3983.349, "timestamp": "01:06:23", "text": "よし。では、私たちは何をしているのでしょうか？する"}, {"type": "subtitle", "time": 3987.43, "timestamp": "01:06:27", "text": "ブレイキング・バッドに行くか、それとも、えーと、"}, {"type": "subtitle", "time": 3988.87, "timestamp": "01:06:28", "text": "これはあなたの"}, {"type": "subtitle", "time": 3990.63, "timestamp": "01:06:30", "text": "終わりを知らないし、私たちにできるように"}, {"type": "subtitle", "time": 3992.87, "timestamp": "01:06:32", "text": "最初は普通に始まることができます。"}, {"type": "subtitle", "time": 3995.99, "timestamp": "01:06:35", "text": "適当にゲームをプレイすればいい。ああ、いいえ"}, {"type": "subtitle", "time": 3998.63, "timestamp": "01:06:38", "text": "ここがあなたのロビーになります。だから、"}, {"type": "subtitle", "time": 4001.589, "timestamp": "01:06:41", "text": "私たちはロールプレイングをする必要があるのでしょうか"}, {"type": "subtitle", "time": 4004.589, "timestamp": "01:06:44", "text": "キャラクターをカスタマイズして、"}, {"type": "subtitle", "time": 4008.789, "timestamp": "01:06:48", "text": "満足感、だからあなたはナルシスト"}, {"type": "subtitle", "time": 4011.71, "timestamp": "01:06:51", "text": "性格は"}, {"type": "subtitle", "time": 4014.95, "timestamp": "01:06:54", "text": "満足のいくセックス。"}, {"type": "subtitle", "time": 4016.23, "timestamp": "01:06:56", "text": "よし、みんな、これから殺すぞ"}]
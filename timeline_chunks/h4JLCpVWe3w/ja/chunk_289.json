[{"type": "subtitle", "time": 17344.948, "timestamp": "04:49:04", "text": "ああ、だから、えーと、ああ、彼らは"}, {"type": "subtitle", "time": 17347.19, "timestamp": "04:49:07", "text": "2階へ。よし、彼に電話すると想像してみて"}, {"type": "subtitle", "time": 17348.948, "timestamp": "04:49:08", "text": "保留中、そしてゴーストの応答は"}, {"type": "subtitle", "time": 17354.948, "timestamp": "04:49:14", "text": "私のトーチを受け取ってください。"}, {"type": "subtitle", "time": 17356.788, "timestamp": "04:49:16", "text": "わかった。"}, {"type": "subtitle", "time": 17361.51, "timestamp": "04:49:21", "text": "EMで超常現象の証拠を見つける"}, {"type": "subtitle", "time": 17364.23, "timestamp": "04:49:24", "text": "電磁場測定器。幽霊の攻略ガイドを入手しよう"}, {"type": "subtitle", "time": 17366.15, "timestamp": "04:49:26", "text": "停止した。超常現象の音を検知する"}, {"type": "subtitle", "time": 17367.75, "timestamp": "04:49:27", "text": "パラボラマイク。放物線はありません"}, {"type": "subtitle", "time": 17371.51, "timestamp": "04:49:31", "text": "マイク。では、私のゲームは"}, {"type": "subtitle", "time": 17375.51, "timestamp": "04:49:35", "text": "遅れている。いや、違う。使用してください。では、"}, {"type": "subtitle", "time": 17379.67, "timestamp": "04:49:39", "text": "スピリットボックス。うん。待って、それは私だけを表示する"}, {"type": "subtitle", "time": 17382.39, "timestamp": "04:49:42", "text": "あなたのゲームはどこにあるの？"}, {"type": "subtitle", "time": 17384.15, "timestamp": "04:49:44", "text": "クラッシュ？"}, {"type": "subtitle", "time": 17386.47, "timestamp": "04:49:46", "text": "ええ、クラッシュしたと思います。"}, {"type": "subtitle", "time": 17393.59, "timestamp": "04:49:53", "text": "墜落した。"}, {"type": "subtitle", "time": 17395.67, "timestamp": "04:49:55", "text": "芸術は熱狂した。"}, {"type": "subtitle", "time": 17397.35, "timestamp": "04:49:57", "text": "再生してほしいですか、それとも"}]
[{"type": "subtitle", "time": 11600.75, "timestamp": "03:13:20", "text": "わかった。エッジフィールド"}, {"type": "subtitle", "time": 11608.389, "timestamp": "03:13:28", "text": "わかった。これは何ですか？その部分を洗浄する"}, {"type": "subtitle", "time": 11611.349, "timestamp": "03:13:31", "text": "幽霊退治用のスマッジスティックを使用する。幽霊を捕まえる"}, {"type": "subtitle", "time": 11613.51, "timestamp": "03:13:33", "text": "塩の中を歩く。よし、"}, {"type": "subtitle", "time": 11617.349, "timestamp": "03:13:37", "text": "私たちはここにいます。超常現象の証拠を見つける"}, {"type": "subtitle", "time": 11620.389, "timestamp": "03:13:40", "text": "EMF測定器を用いて。"}, {"type": "subtitle", "time": 11626.63, "timestamp": "03:13:46", "text": "わあ、今回はたくさんの物があるね。"}, {"type": "subtitle", "time": 11629.03, "timestamp": "03:13:49", "text": "見てみてください。使えるかもしれません"}]
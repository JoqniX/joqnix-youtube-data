[{"type": "subtitle", "time": 14523.189, "timestamp": "04:02:03", "text": "えっと、じゃあ1つしか取れないの？"}, {"type": "subtitle", "time": 14526.309, "timestamp": "04:02:06", "text": "いいえ、最大でも5個までしか持ち込めません。"}, {"type": "subtitle", "time": 14528.389, "timestamp": "04:02:08", "text": "ああ、わかりました。名前は何でしたっけ？病気"}, {"type": "subtitle", "time": 14541.349, "timestamp": "04:02:21", "text": "えっと、あの幽霊の名前は何ですか？それで、"}, {"type": "subtitle", "time": 14545.55, "timestamp": "04:02:25", "text": "彼の名前は、ええと、ルース・エヴァリーです。ルース"}, {"type": "subtitle", "time": 14548.229, "timestamp": "04:02:28", "text": "エヴァリー。ルース、あなたはここにいますか、それとも"}, {"type": "subtitle", "time": 14549.38, "timestamp": "04:02:29", "text": "ルース？"}, {"type": "subtitle", "time": 14560.429, "timestamp": "04:02:40", "text": "ルース、根、根。チャマ、どこにいるの？"}, {"type": "subtitle", "time": 14563.67, "timestamp": "04:02:43", "text": "あなた？何？ああ、これは骨片ですか？"}, {"type": "subtitle", "time": 14566.389, "timestamp": "04:02:46", "text": "わかりました、それをいただきます。"}, {"type": "subtitle", "time": 14568.55, "timestamp": "04:02:48", "text": "ええ、ロビーに置きますよ。のように"}, {"type": "subtitle", "time": 14570.91, "timestamp": "04:02:50", "text": "ガラス窓が見える場所。"}, {"type": "subtitle", "time": 14574.229, "timestamp": "04:02:54", "text": "ああ、それはいつもの「あなたはここにいますか？」みたいなものですか？与える"}, {"type": "subtitle", "time": 14577.429, "timestamp": "04:02:57", "text": "それは私たちに何かの兆候を与えてくれる。ああ、あれは怖かった。いいえ、それは"}, {"type": "subtitle", "time": 14579.99, "timestamp": "04:02:59", "text": "怖かった。どうでも。わかった。えっと、私は"}]
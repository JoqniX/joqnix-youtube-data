[{"type": "subtitle", "time": 8582.91, "timestamp": "02:23:02", "text": "え、どこ？ああ、こちらです。こちらです。"}, {"type": "subtitle", "time": 8585.83, "timestamp": "02:23:05", "text": "真っ直ぐ。川沿いにある。えーと、"}, {"type": "subtitle", "time": 8587.75, "timestamp": "02:23:07", "text": "海の場所。"}, {"type": "subtitle", "time": 8590.309, "timestamp": "02:23:10", "text": "そうそう。ああ、そこだ、そこだ。"}, {"type": "subtitle", "time": 8599.99, "timestamp": "02:23:19", "text": "えっと、ジェシーが薬を要求しているの？"}, {"type": "subtitle", "time": 8601.59, "timestamp": "02:23:21", "text": "取引？"}, {"type": "subtitle", "time": 8605.83, "timestamp": "02:23:25", "text": "彼女からお金を盗む。"}, {"type": "subtitle", "time": 8614.23, "timestamp": "02:23:34", "text": "ジェシー。それは冗談だった。やってみろ。"}, {"type": "subtitle", "time": 8616.469, "timestamp": "02:23:36", "text": "私はスリの訓練に失敗しました。あなたは"}, {"type": "subtitle", "time": 8620.389, "timestamp": "02:23:40", "text": "販売可能でしょうか？いいえ、私は今やったと言ったんです。"}, {"type": "subtitle", "time": 8622.389, "timestamp": "02:23:42", "text": "よし。ねえ、スリをやってみたら？試す"}, {"type": "subtitle", "time": 8624.349, "timestamp": "02:23:44", "text": "スリ。私にはできません"}, {"type": "subtitle", "time": 8627.87, "timestamp": "02:23:47", "text": "また。えっと、彼女の後ろに回ってください。しゃがむ"}, {"type": "subtitle", "time": 8630.63, "timestamp": "02:23:50", "text": "そして、私も彼を助けます。はい、外れましたね。"}, {"type": "subtitle", "time": 8639.83, "timestamp": "02:23:59", "text": "彼女を殺せ。"}]
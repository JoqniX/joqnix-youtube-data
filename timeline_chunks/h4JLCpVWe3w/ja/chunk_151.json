[{"type": "subtitle", "time": 9060.79, "timestamp": "02:31:00", "text": "何してるの？ビデオを再生しています"}, {"type": "subtitle", "time": 9065.19, "timestamp": "02:31:05", "text": "ゲーム。いや、いや。くたばれ。お前は狼だ。"}, {"type": "subtitle", "time": 9067.429, "timestamp": "02:31:07", "text": "外出禁止だ。"}, {"type": "subtitle", "time": 9069.03, "timestamp": "02:31:09", "text": "大丈夫。もう二度と私と遊ばないで。私は"}, {"type": "subtitle", "time": 9076.07, "timestamp": "02:31:16", "text": "クソみたいな音楽ってそういうものじゃないの？なぜ"}, {"type": "subtitle", "time": 9077.75, "timestamp": "02:31:17", "text": "の"}, {"type": "subtitle", "time": 9080.55, "timestamp": "02:31:20", "text": "なぜpoは引きずっているように見えるのですか？誰"}, {"type": "subtitle", "time": 9091.349, "timestamp": "02:31:31", "text": "そいつが引きずられてるのが見えるぜ、兄弟。おお、"}, {"type": "subtitle", "time": 9094.63, "timestamp": "02:31:34", "text": "ソースが見えますか、"}, {"type": "subtitle", "time": 9097.75, "timestamp": "02:31:37", "text": "待って、これ見える？いいえ、彼は"}, {"type": "subtitle", "time": 9100.23, "timestamp": "02:31:40", "text": "まるで何気なく歩いているように見える。"}, {"type": "subtitle", "time": 9102.07, "timestamp": "02:31:42", "text": "でも私の画面では彼は文字通り"}, {"type": "subtitle", "time": 9105.03, "timestamp": "02:31:45", "text": "死んでいて、まるで引きずられているかのようだった。"}, {"type": "subtitle", "time": 9107.67, "timestamp": "02:31:47", "text": "ああ、彼は体が不自由で、足が"}, {"type": "subtitle", "time": 9111.429, "timestamp": "02:31:51", "text": "歪んでいる。何てことだ。なんてこった。やり方を知っている"}, {"type": "subtitle", "time": 9116.86, "timestamp": "02:31:56", "text": "死者はこんな風に見える。何てことだ。なぜ？"}, {"type": "subtitle", "time": 9119.349, "timestamp": "02:31:59", "text": "[音楽]"}]
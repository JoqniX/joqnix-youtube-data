[{"type": "subtitle", "time": 8761.51, "timestamp": "02:26:01", "text": "ジョーが、一緒に遊ばなきゃダメだって言ってたから。私"}, {"type": "subtitle", "time": 8767.27, "timestamp": "02:26:07", "text": "なんてこった。私が思うに、"}, {"type": "subtitle", "time": 8770.07, "timestamp": "02:26:10", "text": "ああ、いやだ。それはそうではないと思います"}, {"type": "subtitle", "time": 8773.91, "timestamp": "02:26:13", "text": "このゲームに費やした最後の60時間。"}, {"type": "subtitle", "time": 8776.71, "timestamp": "02:26:16", "text": "何？どうやってこれに60時間も費やしたの？"}, {"type": "subtitle", "time": 8778.87, "timestamp": "02:26:18", "text": "ゲーム？わかった。"}, {"type": "subtitle", "time": 8781.309, "timestamp": "02:26:21", "text": "ええと、私は"}, {"type": "subtitle", "time": 8784.469, "timestamp": "02:26:24", "text": "電話を切る。"}, {"type": "subtitle", "time": 8788.03, "timestamp": "02:26:28", "text": "ひどいセックスだった。叔父"}, {"type": "subtitle", "time": 8790.75, "timestamp": "02:26:30", "text": "ネルソン、この男は"}, {"type": "subtitle", "time": 8793.429, "timestamp": "02:26:33", "text": "不具合が発生しています。彼の頭は 彼の頭は"}]
[{"type": "subtitle", "time": 11127.55, "timestamp": "03:05:27", "text": "私は"}, {"type": "subtitle", "time": 11139.51, "timestamp": "03:05:39", "text": "待って。ああ、つまり私はダブルレイドをしました"}, {"type": "subtitle", "time": 11142.389, "timestamp": "03:05:42", "text": "彼らの共通の友人。ニース。ニース。私は"}, {"type": "subtitle", "time": 11145.03, "timestamp": "03:05:45", "text": "しばらくそれを見ていた。"}, {"type": "subtitle", "time": 11147.83, "timestamp": "03:05:47", "text": "それは作成モードですか、ええと、Akaは"}, {"type": "subtitle", "time": 11150.07, "timestamp": "03:05:50", "text": "私に何を話してくれているの？ああ、なんてことだ、とても"}, {"type": "subtitle", "time": 11152.07, "timestamp": "03:05:52", "text": "良い。また、これもシム作成です"}, {"type": "subtitle", "time": 11153.37, "timestamp": "03:05:53", "text": "種の"}, {"type": "subtitle", "time": 11155.63, "timestamp": "03:05:55", "text": "[音楽]"}, {"type": "subtitle", "time": 11159.349, "timestamp": "03:05:59", "text": "もの。うん、良さそうだね。私はほしくない"}]
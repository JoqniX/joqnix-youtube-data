[{"type": "subtitle", "time": 4500.229, "timestamp": "01:15:00", "text": "今すぐ質屋へ。"}, {"type": "subtitle", "time": 4504.27, "timestamp": "01:15:04", "text": "ああ、こいつらは麻薬カルテルの連中だ。"}, {"type": "subtitle", "time": 4508.39, "timestamp": "01:15:08", "text": "カルテルって、一体何なんだ？"}, {"type": "subtitle", "time": 4512.55, "timestamp": "01:15:12", "text": "おお。おお。おお。おお。おお。おお。"}, {"type": "subtitle", "time": 4515.11, "timestamp": "01:15:15", "text": "おお。質屋はどこですか？私は"}, {"type": "subtitle", "time": 4519.35, "timestamp": "01:15:19", "text": "『ブレイキング・バッド』の制作チームを忘れてしまった。のように、"}, {"type": "subtitle", "time": 4522.95, "timestamp": "01:15:22", "text": "実は「ブレイキング・バッド」は見たことがないんです。"}, {"type": "subtitle", "time": 4525.51, "timestamp": "01:15:25", "text": "ああ、もう。どうしてこんなことができるの？ああ、"}, {"type": "subtitle", "time": 4528.31, "timestamp": "01:15:28", "text": "神。私の運転技術は一度"}, {"type": "subtitle", "time": 4529.91, "timestamp": "01:15:29", "text": "ベッカーを見始めると、"}, {"type": "subtitle", "time": 4532.63, "timestamp": "01:15:32", "text": "「うわ、これ知ってるよ。知ってるよ」"}, {"type": "subtitle", "time": 4537.189, "timestamp": "01:15:37", "text": "私が知っていることはこれだ"}, {"type": "subtitle", "time": 4538.95, "timestamp": "01:15:38", "text": "質屋の中、または質屋の裏側"}, {"type": "subtitle", "time": 4541.11, "timestamp": "01:15:41", "text": "店だ。彼がここにいる。なんてことだ。彼は"}, {"type": "subtitle", "time": 4543.11, "timestamp": "01:15:43", "text": "まるで麻薬中毒者のように。"}, {"type": "subtitle", "time": 4548.63, "timestamp": "01:15:48", "text": "土壌。わかった。待って、彼は薬物中毒者だ。"}, {"type": "subtitle", "time": 4552.95, "timestamp": "01:15:52", "text": "君に似ているね。なんてこった。警察。警察。"}, {"type": "subtitle", "time": 4556.47, "timestamp": "01:15:56", "text": "警察。警察。警察。それはすべて"}, {"type": "subtitle", "time": 4559.51, "timestamp": "01:15:59", "text": "警察。キャンキャンアイ、ああ、運転したい"}]
[{"type": "subtitle", "time": 7142.07, "timestamp": "01:59:02", "text": "もの？それは殻の中にあります。"}, {"type": "subtitle", "time": 7144.629, "timestamp": "01:59:04", "text": "ああ、私は持っています、私は持っています、私は持っています、それは"}, {"type": "subtitle", "time": 7146.95, "timestamp": "01:59:06", "text": "大丈夫。わかった。"}, {"type": "subtitle", "time": 7148.87, "timestamp": "01:59:08", "text": "大丈夫だよ、イマン。あなたは必要ない"}, {"type": "subtitle", "time": 7154.79, "timestamp": "01:59:14", "text": "スピードローラー。どうすれば手に入れられるのか"}, {"type": "subtitle", "time": 7157.589, "timestamp": "01:59:17", "text": "成長速度？そうそう。私も持っています"}, {"type": "subtitle", "time": 7159.83, "timestamp": "01:59:19", "text": "スピードドロワー。"}, {"type": "subtitle", "time": 7163.03, "timestamp": "01:59:23", "text": "私はスピード剤を一切買わなかった。あらら。私はできる、できる"}, {"type": "subtitle", "time": 7166.95, "timestamp": "01:59:26", "text": "これをここに植えてもいいですか？終わり。待って、私はできる"}, {"type": "subtitle", "time": 7170.55, "timestamp": "01:59:30", "text": "吸ってみて。吸っても構いません。また、"}, {"type": "subtitle", "time": 7171.47, "timestamp": "01:59:31", "text": "ああ、"}, {"type": "subtitle", "time": 7173.95, "timestamp": "01:59:33", "text": "神。うん、"}, {"type": "subtitle", "time": 7176.55, "timestamp": "01:59:36", "text": "赤ちゃん。気分が悪い。何"}, {"type": "subtitle", "time": 7182.07, "timestamp": "01:59:42", "text": "私たちはネルソンおじさんと話をしなければならなかった"}, {"type": "subtitle", "time": 7184.75, "timestamp": "01:59:44", "text": "公衆電話が来る。そうそう。おお"}, {"type": "subtitle", "time": 7188.229, "timestamp": "01:59:48", "text": "おい、ネルソンおじさんだよ、俺は"}, {"type": "subtitle", "time": 7190.229, "timestamp": "01:59:50", "text": "あなたに伝えるべきかもしれない"}, {"type": "subtitle", "time": 7192.229, "timestamp": "01:59:52", "text": "この男とは無関係だ。私はしません"}, {"type": "subtitle", "time": 7195.189, "timestamp": "01:59:55", "text": "彼女はとても綺麗に見える 何？これは一体何だったのか？"}, {"type": "subtitle", "time": 7197.91, "timestamp": "01:59:57", "text": "サラマンカはどうですか？"}]
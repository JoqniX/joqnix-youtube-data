[{"type": "subtitle", "time": 18181.43, "timestamp": "05:03:01", "text": "そこにいてください。言わないで、言わないで、言わないで"}, {"type": "subtitle", "time": 18183.35, "timestamp": "05:03:03", "text": "何でも。うん。うん。行く。そこに座って。座る"}, {"type": "subtitle", "time": 18186.55, "timestamp": "05:03:06", "text": "そこには。停止。すべて電源を切ってください。しないで"}, {"type": "subtitle", "time": 18189.11, "timestamp": "05:03:09", "text": "とても叫ぶ。落ち着け。落ち着け。"}, {"type": "subtitle", "time": 18191.51, "timestamp": "05:03:11", "text": "何て言うんだっけ覚えておいて"}, {"type": "subtitle", "time": 18195.27, "timestamp": "05:03:15", "text": "それらの？それはミームだ。"}, {"type": "subtitle", "time": 18198.47, "timestamp": "05:03:18", "text": "「イエス」を忘れないで。それは何と呼ばれていますか？の"}, {"type": "subtitle", "time": 18202.868, "timestamp": "05:03:22", "text": "パパフィッシュ。ああ。はい。おお。"}, {"type": "subtitle", "time": 18204.868, "timestamp": "05:03:24", "text": "何てことだ。"}, {"type": "subtitle", "time": 18207.27, "timestamp": "05:03:27", "text": "うん。俺の[ __ ]をチェックしてくれ。このクソ野郎。"}, {"type": "subtitle", "time": 18209.51, "timestamp": "05:03:29", "text": "お前はエミリー・ディキンソンだ。私は"}, {"type": "subtitle", "time": 18211.51, "timestamp": "05:03:31", "text": "[ __ ]を出して。"}, {"type": "subtitle", "time": 18213.03, "timestamp": "05:03:33", "text": "男の子、"}, {"type": "subtitle", "time": 18215.83, "timestamp": "05:03:35", "text": "カメラの不具合箇所を特定できませんでした。ああ、いや"}, {"type": "subtitle", "time": 18217.67, "timestamp": "05:03:37", "text": "心配事。後で配置できます。"}, {"type": "subtitle", "time": 18221.75, "timestamp": "05:03:41", "text": "あまりにも。ただ落ち着いて。開けないでください"}, {"type": "subtitle", "time": 18223.43, "timestamp": "05:03:43", "text": "箱。"}, {"type": "subtitle", "time": 18227.11, "timestamp": "05:03:47", "text": "日記を開いてください。えっと、確認します"}, {"type": "subtitle", "time": 18230.19, "timestamp": "05:03:50", "text": "塩漬けが終わりました。えっと"}, {"type": "subtitle", "time": 18234.47, "timestamp": "05:03:54", "text": "家庭用塩入れが満タンになっていません。ああ、くそ。"}, {"type": "subtitle", "time": 18235.83, "timestamp": "05:03:55", "text": "あなたは、"}, {"type": "subtitle", "time": 18238.788, "timestamp": "05:03:58", "text": "塩を一列に並べる、ということですよね？だからもし彼女か私が"}, {"type": "subtitle", "time": 18239.83, "timestamp": "05:03:59", "text": "あの幽霊が一体何なのか分からない"}]
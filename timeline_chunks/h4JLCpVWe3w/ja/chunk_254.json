[{"type": "subtitle", "time": 15241.59, "timestamp": "04:14:01", "text": "わかった。電源を入れてください。それをクリックしてください。それをクリックしてください。"}, {"type": "subtitle", "time": 15244.149, "timestamp": "04:14:04", "text": "それをクリックしてください。ヒューズをクリックしてください。わかった。えっと、それは"}, {"type": "subtitle", "time": 15248.55, "timestamp": "04:14:08", "text": "終わり。うん。終わり。営業中です。"}, {"type": "subtitle", "time": 15257.51, "timestamp": "04:14:17", "text": "主。何てことだ。"}, {"type": "subtitle", "time": 15259.99, "timestamp": "04:14:19", "text": "もう一度、この辺りから彼に電話をかけてみてください。わかった。"}, {"type": "subtitle", "time": 15261.67, "timestamp": "04:14:21", "text": "この場所の近く。彼が前回ここに来た時。"}, {"type": "subtitle", "time": 15263.59, "timestamp": "04:14:23", "text": "だから、彼がまたここに来てくれることを願っています。"}, {"type": "subtitle", "time": 15266.71, "timestamp": "04:14:26", "text": "ルース、どこにいるの？ルース、私たちは"}, {"type": "subtitle", "time": 15268.229, "timestamp": "04:14:28", "text": "あなたが一人でいるときに、あなたに反応してくれるんですよね？"}, {"type": "subtitle", "time": 15271.269, "timestamp": "04:14:31", "text": "だから、ホールに留まってください。どこかへ行く"}, {"type": "subtitle", "time": 15279.83, "timestamp": "04:14:39", "text": "わかった。ルース・エヴァリー、あなたはどこにいるの？おお、"}, {"type": "subtitle", "time": 15282.55, "timestamp": "04:14:42", "text": "待って。彼女は何か言った。離れる。言った"}, {"type": "subtitle", "time": 15285.75, "timestamp": "04:14:45", "text": "何か。立ち去るか、何か行動を起こすか。待って"}, {"type": "subtitle", "time": 15287.429, "timestamp": "04:14:47", "text": "2番。トイレからのものです。これ"}, {"type": "subtitle", "time": 15293.83, "timestamp": "04:14:53", "text": "ルース、ちょっと出てきてもらえる？"}, {"type": "subtitle", "time": 15295.429, "timestamp": "04:14:55", "text": "少し？"}, {"type": "subtitle", "time": 15297.51, "timestamp": "04:14:57", "text": "はい、そこにいてください。忘れずに使用してください"}]
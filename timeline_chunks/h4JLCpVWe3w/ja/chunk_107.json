[{"type": "subtitle", "time": 6420.79, "timestamp": "01:47:00", "text": "いいえ、マインクラフトではありません。全く違います。"}, {"type": "subtitle", "time": 6422.95, "timestamp": "01:47:02", "text": "君ができたらいいのに、君ができたらいいのに。"}, {"type": "subtitle", "time": 6425.35, "timestamp": "01:47:05", "text": "起きていて一日が進むが、いや、"}, {"type": "subtitle", "time": 6427.35, "timestamp": "01:47:07", "text": "あなたはできません。寝なきゃダメだよ。"}, {"type": "subtitle", "time": 6430.39, "timestamp": "01:47:10", "text": "そうしないと時間が止まってしまう。その通り。"}, {"type": "subtitle", "time": 6432.55, "timestamp": "01:47:12", "text": "でも、麻薬の売人が出てくるんじゃないの？"}, {"type": "subtitle", "time": 6440.79, "timestamp": "01:47:20", "text": "午前4時。私ならわかる。うん。そして私はすべて"}, {"type": "subtitle", "time": 6443.51, "timestamp": "01:47:23", "text": "はい、皆さん。午前4時だ。行こう。"}, {"type": "subtitle", "time": 6445.75, "timestamp": "01:47:25", "text": "A"}, {"type": "subtitle", "time": 6447.99, "timestamp": "01:47:27", "text": "寝る。"}, {"type": "subtitle", "time": 6451.51, "timestamp": "01:47:31", "text": "なぜか38ドルの収益がありました。"}, {"type": "subtitle", "time": 6454.629, "timestamp": "01:47:34", "text": "待って、他のプレイヤーを待っていると表示されています。"}, {"type": "subtitle", "time": 6456.709, "timestamp": "01:47:36", "text": "わかったよ、ストリートチルドレン。ああ、それは"}, {"type": "subtitle", "time": 6458.31, "timestamp": "01:47:38", "text": "朝。皆さん、おはようございます。目覚め"}, {"type": "subtitle", "time": 6462.47, "timestamp": "01:47:42", "text": "上。起きて起きて。待って、"}, {"type": "subtitle", "time": 6464.149, "timestamp": "01:47:44", "text": "何？"}, {"type": "subtitle", "time": 6466.83, "timestamp": "01:47:46", "text": "私はまだ他の人を待っている状態です"}, {"type": "subtitle", "time": 6471.95, "timestamp": "01:47:51", "text": "プレイヤー。勝ったのか？うん、起きてるよ。"}, {"type": "subtitle", "time": 6475.35, "timestamp": "01:47:55", "text": "うん。わかった。我慢する。ピーター、撃ってもいい？"}, {"type": "subtitle", "time": 6477.51, "timestamp": "01:47:57", "text": "無料サンプルはいかがですか？ああ、それはすべて"}]
[{"type": "subtitle", "time": 9967.87, "timestamp": "02:46:07", "text": "ジェシー"}, {"type": "subtitle", "time": 9970.429, "timestamp": "02:46:10", "text": "34. 待つことにする"}, {"type": "subtitle", "time": 9973.349, "timestamp": "02:46:13", "text": "これはとても面白い。これはとても"}, {"type": "subtitle", "time": 9975.83, "timestamp": "02:46:15", "text": "面白い。"}, {"type": "subtitle", "time": 9981.309, "timestamp": "02:46:21", "text": "あれはヘクターの、えっと、ヘクター、ヘクターの"}, {"type": "subtitle", "time": 9984.23, "timestamp": "02:46:24", "text": "車椅子？これを拾って"}, {"type": "subtitle", "time": 9987.309, "timestamp": "02:46:27", "text": "それを私たちの家に持ってきて"}, {"type": "subtitle", "time": 9990.71, "timestamp": "02:46:30", "text": "私たちがこの記念碑全体を作る"}, {"type": "subtitle", "time": 9993.83, "timestamp": "02:46:33", "text": "公園。ここで一体何が起こっているんだ？フォローする"}, {"type": "subtitle", "time": 9996.309, "timestamp": "02:46:36", "text": "警官たち。"}, {"type": "subtitle", "time": 9997.15, "timestamp": "02:46:37", "text": "彼は"}, {"type": "subtitle", "time": 10007.349, "timestamp": "02:46:47", "text": "よし。くそ。持ち込んでもいいですか？"}, {"type": "subtitle", "time": 10010.469, "timestamp": "02:46:50", "text": "ここ？ああ、次の取引"}, {"type": "subtitle", "time": 10012.469, "timestamp": "02:46:52", "text": "起こっている。うん。うん。うん。うん。私"}, {"type": "subtitle", "time": 10014.63, "timestamp": "02:46:54", "text": "必要なら行きます。薬は持っていますか？"}, {"type": "subtitle", "time": 10016.79, "timestamp": "02:46:56", "text": "ああ、薬は手に入れたよ。うん、手に入れたよ"}]
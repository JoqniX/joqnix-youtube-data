[{"type": "subtitle", "time": 14940.79, "timestamp": "04:09:00", "text": "よし、そこに行って電気をつけてくれ"}, {"type": "subtitle", "time": 14943.429, "timestamp": "04:09:03", "text": "そうすれば、彼が来るのがわかる。"}, {"type": "subtitle", "time": 14946.87, "timestamp": "04:09:06", "text": "はい、ゲーム内マイクの使用はやめてください。わかった。"}, {"type": "subtitle", "time": 14948.95, "timestamp": "04:09:08", "text": "いや、いや、廊下の明かりだよ。廊下の照明。"}, {"type": "subtitle", "time": 14952.71, "timestamp": "04:09:12", "text": "ライン全体。正面へ進んでください"}, {"type": "subtitle", "time": 14955.67, "timestamp": "04:09:15", "text": "あなたは行くのよ。そこには暗闇があった。"}, {"type": "subtitle", "time": 14957.51, "timestamp": "04:09:17", "text": "ゲーム内マイクの使用をやめて、"}, {"type": "subtitle", "time": 14961.03, "timestamp": "04:09:21", "text": "ライト点灯。はい。うん。うん。うん。さあ行こう"}, {"type": "subtitle", "time": 14962.469, "timestamp": "04:09:22", "text": "ホールの真ん中で彼の"}, {"type": "subtitle", "time": 14964.389, "timestamp": "04:09:24", "text": "名前。彼が来たら、メインの最後のホール"}, {"type": "subtitle", "time": 14967.03, "timestamp": "04:09:27", "text": "ライトがちらつき、正確に"}, {"type": "subtitle", "time": 14979.03, "timestamp": "04:09:39", "text": "もっと近くで。部屋。ルース。出てくる。出てくる。"}, {"type": "subtitle", "time": 14981.11, "timestamp": "04:09:41", "text": "ルース・エヴァリーは、彼のフルネームを発音する。"}, {"type": "subtitle", "time": 14985.07, "timestamp": "04:09:45", "text": "ルース・エヴァリーさん、どうぞ出てきてください。できた"}, {"type": "subtitle", "time": 14987.229, "timestamp": "04:09:47", "text": "あなたは一緒に来ます"}, {"type": "subtitle", "time": 14994.55, "timestamp": "04:09:54", "text": "私は自分が悪影響を与えてしまったようだ"}]
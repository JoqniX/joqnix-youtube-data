[{"type": "subtitle", "time": 12784.19, "timestamp": "03:33:04", "text": "何？何"}, {"type": "subtitle", "time": 12801.75, "timestamp": "03:33:21", "text": "靴。待って、あれってミッチだよね？待って、"}, {"type": "subtitle", "time": 12815.03, "timestamp": "03:33:35", "text": "ミッチが靴を壊した。"}, {"type": "subtitle", "time": 12817.469, "timestamp": "03:33:37", "text": "それはあり得ない"}, {"type": "subtitle", "time": 12819.79, "timestamp": "03:33:39", "text": "おばけ。わかった。"}, {"type": "subtitle", "time": 12823.19, "timestamp": "03:33:43", "text": "あの、M、知ってる？私はミイではありません、私は"}, {"type": "subtitle", "time": 12836.75, "timestamp": "03:33:56", "text": "待って。誰かが"}, {"type": "subtitle", "time": 12839.82, "timestamp": "03:33:59", "text": "来るよ。誰かが来る。何てことだ。私の"}]
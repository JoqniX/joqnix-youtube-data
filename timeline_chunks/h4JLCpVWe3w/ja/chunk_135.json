[{"type": "subtitle", "time": 8100.709, "timestamp": "02:15:00", "text": "ここ。素敵な素敵なペニスはありますか？"}, {"type": "subtitle", "time": 8103.99, "timestamp": "02:15:03", "text": "ここで絵を描いているの？"}, {"type": "subtitle", "time": 8105.91, "timestamp": "02:15:05", "text": "よし、私たちは"}, {"type": "subtitle", "time": 8111.91, "timestamp": "02:15:11", "text": "もしくは、ゲームセンターの中に入れたらいいのに。"}, {"type": "subtitle", "time": 8114.229, "timestamp": "02:15:14", "text": "そして何か演奏する。"}, {"type": "subtitle", "time": 8116.709, "timestamp": "02:15:16", "text": "ああ、カジノで遊べるよ。あなた"}, {"type": "subtitle", "time": 8119.43, "timestamp": "02:15:19", "text": "カジノで遊ぶことができます。"}, {"type": "subtitle", "time": 8123.43, "timestamp": "02:15:23", "text": "もちろん、あなたはギャンブルをしていることを知っています"}, {"type": "subtitle", "time": 8125.75, "timestamp": "02:15:25", "text": "みんな、この汚物を片付けなきゃ"}, {"type": "subtitle", "time": 8129.27, "timestamp": "02:15:29", "text": "クソみたいな家だよ、兄弟。来て。"}, {"type": "subtitle", "time": 8135.189, "timestamp": "02:15:35", "text": "数日。"}, {"type": "subtitle", "time": 8139.229, "timestamp": "02:15:39", "text": "おお。一体誰がこんなことしてるんだ？これはあなたですか？"}, {"type": "subtitle", "time": 8143.27, "timestamp": "02:15:43", "text": "いいえ、それすら持っていません。"}, {"type": "subtitle", "time": 8145.91, "timestamp": "02:15:45", "text": "あなたは確かに？笑ってもダメ、"}, {"type": "subtitle", "time": 8147.99, "timestamp": "02:15:47", "text": "わからない。いいえ、実は私は"}, {"type": "subtitle", "time": 8151.589, "timestamp": "02:15:51", "text": "やったことがない 私はやる 私はやらない。"}, {"type": "subtitle", "time": 8159.109, "timestamp": "02:15:59", "text": "ゴミ箱はどこですか？ちょうど作ったところです"}]
[{"type": "subtitle", "time": 16800.55, "timestamp": "04:40:00", "text": "皿がこちらに向かってくる。"}, {"type": "subtitle", "time": 16803.51, "timestamp": "04:40:03", "text": "何てことだ。"}, {"type": "subtitle", "time": 16806.55, "timestamp": "04:40:06", "text": "待って。クソ、か？"}, {"type": "subtitle", "time": 16809.83, "timestamp": "04:40:09", "text": "ええと、それほど大きな音にはならないと思いますよ。私"}, {"type": "subtitle", "time": 16814.15, "timestamp": "04:40:14", "text": "えっと、聞こえますよね、"}, {"type": "subtitle", "time": 16815.99, "timestamp": "04:40:15", "text": "靴かハンマーのどちらか。私はしません"}, {"type": "subtitle", "time": 16819.83, "timestamp": "04:40:19", "text": "知る。おや、彼女は私に向かってくるの？"}, {"type": "subtitle", "time": 16822.47, "timestamp": "04:40:22", "text": "いいえ、彼女も同じことをしています。なんてことだ"}, {"type": "subtitle", "time": 16824.948, "timestamp": "04:40:24", "text": "ばか。移動しましょうか？つまり、"}, {"type": "subtitle", "time": 16828.67, "timestamp": "04:40:28", "text": "望むなら、そうすることもできます。私は"}, {"type": "subtitle", "time": 16832.628, "timestamp": "04:40:32", "text": "退屈。くたばれ、この[ __ ]。"}, {"type": "subtitle", "time": 16835.19, "timestamp": "04:40:35", "text": "見てみましょう。"}, {"type": "subtitle", "time": 16836.708, "timestamp": "04:40:36", "text": "待って、ここで待って。彼女が来るかどうか見てみよう"}]
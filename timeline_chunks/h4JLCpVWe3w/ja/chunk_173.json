[{"type": "subtitle", "time": 10380.87, "timestamp": "02:53:00", "text": "今の自分を見ている。"}, {"type": "subtitle", "time": 10385.11, "timestamp": "02:53:05", "text": "ああ、ああ、なんてことだ、私は打たれた。"}, {"type": "subtitle", "time": 10389.59, "timestamp": "02:53:09", "text": "はぁ？どうやって"}, {"type": "subtitle", "time": 10393.15, "timestamp": "02:53:13", "text": "痛い。痛い。ごめん。"}, {"type": "subtitle", "time": 10401.99, "timestamp": "02:53:21", "text": "彼は自殺した。"}, {"type": "subtitle", "time": 10404.87, "timestamp": "02:53:24", "text": "そんなことがどうして可能なのか？"}, {"type": "subtitle", "time": 10406.83, "timestamp": "02:53:26", "text": "ちょっと買いに行ってきます"}, {"type": "subtitle", "time": 10410.55, "timestamp": "02:53:30", "text": "コカ・コーラ。コカコーラ。コカコーラ。"}, {"type": "subtitle", "time": 10412.469, "timestamp": "02:53:32", "text": "ストリーム。"}, {"type": "subtitle", "time": 10414.469, "timestamp": "02:53:34", "text": "どうやら、自分自身を見て"}, {"type": "subtitle", "time": 10417.75, "timestamp": "02:53:37", "text": "左クリックすると、自分自身に当たります。"}, {"type": "subtitle", "time": 10423.51, "timestamp": "02:53:43", "text": "私にはそんなことは起こりません。そうではありません"}, {"type": "subtitle", "time": 10425.91, "timestamp": "02:53:45", "text": "私にとっては起こっていることです。"}, {"type": "subtitle", "time": 10428.95, "timestamp": "02:53:48", "text": "はぁ？それは奇妙だ。試合は早い"}, {"type": "subtitle", "time": 10431.11, "timestamp": "02:53:51", "text": "アクセス、"}]
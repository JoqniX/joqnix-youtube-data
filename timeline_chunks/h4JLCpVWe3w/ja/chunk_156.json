[{"type": "subtitle", "time": 9360.55, "timestamp": "02:36:00", "text": "作ることができます。おお。あ、待って。私は持っている"}, {"type": "subtitle", "time": 9363.349, "timestamp": "02:36:03", "text": "外国為替、"}, {"type": "subtitle", "time": 9365.67, "timestamp": "02:36:05", "text": "兄弟。"}, {"type": "subtitle", "time": 9368.15, "timestamp": "02:36:08", "text": "大丈夫です。彼女は今、オフィスにいます。"}, {"type": "subtitle", "time": 9371.349, "timestamp": "02:36:11", "text": "うん。うん。ケイティとの契約は期限切れとなる"}, {"type": "subtitle", "time": 9374.63, "timestamp": "02:36:14", "text": "4時間3時間。キャシーはどこ？えーと理髪師"}, {"type": "subtitle", "time": 9377.429, "timestamp": "02:36:17", "text": "店。ああ、それは難しいな。えっと、来て"}, {"type": "subtitle", "time": 9380.15, "timestamp": "02:36:20", "text": "モラ、私についてきて。モラ、モラ。ああ、モラ。"}, {"type": "subtitle", "time": 9381.15, "timestamp": "02:36:21", "text": "ああ、フォロー"}, {"type": "subtitle", "time": 9386.469, "timestamp": "02:36:26", "text": "自分。え、何？よし、警官が来た"}, {"type": "subtitle", "time": 9387.99, "timestamp": "02:36:27", "text": "見ている。"}, {"type": "subtitle", "time": 9388.83, "timestamp": "02:36:28", "text": "うん。"}, {"type": "subtitle", "time": 9391.99, "timestamp": "02:36:31", "text": "じゃあ、私が警官の注意をそらすわ。あなたがやる"}, {"type": "subtitle", "time": 9394.63, "timestamp": "02:36:34", "text": "キャシーはどこにいるの？どこ"}, {"type": "subtitle", "time": 9396.63, "timestamp": "02:36:36", "text": "あなたは？"}, {"type": "subtitle", "time": 9401.63, "timestamp": "02:36:41", "text": "私はここにいます。君の後ろにいるよ。わかった。えっと、"}, {"type": "subtitle", "time": 9405.75, "timestamp": "02:36:45", "text": "キャシーはここにいるよ。"}, {"type": "subtitle", "time": 9413.91, "timestamp": "02:36:53", "text": "気をそらす。気をそらす。よし。逃げる。"}, {"type": "subtitle", "time": 9415.429, "timestamp": "02:36:55", "text": "逃げる。逃げる。逃げる。おお。おお。"}, {"type": "subtitle", "time": 9417.63, "timestamp": "02:36:57", "text": "待って。わかった。もし彼らが"}]
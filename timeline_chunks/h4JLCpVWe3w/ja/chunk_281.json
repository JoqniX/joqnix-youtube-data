[{"type": "subtitle", "time": 16864.15, "timestamp": "04:41:04", "text": "ああ、彼女は"}, {"type": "subtitle", "time": 16866.47, "timestamp": "04:41:06", "text": "この[ __ ]め。"}, {"type": "subtitle", "time": 16876.708, "timestamp": "04:41:16", "text": "自分。行け、行け、行け、私のところへ行け。私のところへ来なさい。行く"}, {"type": "subtitle", "time": 16879.19, "timestamp": "04:41:19", "text": "私にとって。そして、木のそばにいてください。彼女"}, {"type": "subtitle", "time": 16881.99, "timestamp": "04:41:21", "text": "おそらく私の居場所を知っているだろう。わかった。彼女は"}, {"type": "subtitle", "time": 16884.868, "timestamp": "04:41:24", "text": "私に向かってくる。"}, {"type": "subtitle", "time": 16886.708, "timestamp": "04:41:26", "text": "うん。ここにいてください。彼女は私に向かってくるだろう。"}, {"type": "subtitle", "time": 16897.11, "timestamp": "04:41:37", "text": "彼女の声が聞こえる。ええ、彼女は来るよ、なぜなら"}, {"type": "subtitle", "time": 16902.31, "timestamp": "04:41:42", "text": "今、スピリットボックスと話しました。おお、"}, {"type": "subtitle", "time": 16903.868, "timestamp": "04:41:43", "text": "クソバカ"}, {"type": "subtitle", "time": 16907.35, "timestamp": "04:41:47", "text": "[ __ ]。そのまま見守ってください。どういう意味"}, {"type": "subtitle", "time": 16909.67, "timestamp": "04:41:49", "text": "彼女は試合を辞めたの？"}, {"type": "subtitle", "time": 16913.03, "timestamp": "04:41:53", "text": "彼女はそれを残した"}, {"type": "subtitle", "time": 16916.788, "timestamp": "04:41:56", "text": "また。何てことだ。"}]
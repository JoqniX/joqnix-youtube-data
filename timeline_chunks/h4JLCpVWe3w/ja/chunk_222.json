[{"type": "subtitle", "time": 13352.51, "timestamp": "03:42:32", "text": "戻ってくる。戻ってくる。来る"}, {"type": "subtitle", "time": 13356.469, "timestamp": "03:42:36", "text": "戻る。本当に申し訳ありません。わかった。あなたは手に入れた"}, {"type": "subtitle", "time": 13359.03, "timestamp": "03:42:39", "text": "君は夜におっぱいを手に入れたね。何？あなたの"}, {"type": "subtitle", "time": 13361.95, "timestamp": "03:42:41", "text": "おっぱい。あなたのボブから。"}, {"type": "subtitle", "time": 13364.95, "timestamp": "03:42:44", "text": "何？待って。ああ、私は女性キャラクターです。"}, {"type": "subtitle", "time": 13366.67, "timestamp": "03:42:46", "text": "右？"}, {"type": "subtitle", "time": 13370.87, "timestamp": "03:42:50", "text": "ああ、アシュワン。ニャー。猫。マックスは嫌がらせをする"}, {"type": "subtitle", "time": 13378.389, "timestamp": "03:42:58", "text": "この女を追放する時が来た。"}]
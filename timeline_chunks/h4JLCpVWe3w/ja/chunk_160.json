[{"type": "subtitle", "time": 9600.23, "timestamp": "02:40:00", "text": "待って、私ってここにいるべきなの？いいえ、違います"}, {"type": "subtitle", "time": 9603.349, "timestamp": "02:40:03", "text": "ここ。何てことだ。"}, {"type": "subtitle", "time": 9606.469, "timestamp": "02:40:06", "text": "あと、皆さんはどれくらいの時間プレイしているんですか？"}, {"type": "subtitle", "time": 9609.429, "timestamp": "02:40:09", "text": "えっと、あと10秒か15秒くらい待ってください"}, {"type": "subtitle", "time": 9617.349, "timestamp": "02:40:17", "text": "わかった。"}, {"type": "subtitle", "time": 9619.11, "timestamp": "02:40:19", "text": "えっと、別の取引があるはずなんだけど"}, {"type": "subtitle", "time": 9621.99, "timestamp": "02:40:21", "text": "ここ。しかし、それはいつのことですか？それは"}, {"type": "subtitle", "time": 9623.99, "timestamp": "02:40:23", "text": "午後。ああ、それは午後のことだ。"}, {"type": "subtitle", "time": 9625.91, "timestamp": "02:40:25", "text": "よし、これで全部終わったと思う"}, {"type": "subtitle", "time": 9628.23, "timestamp": "02:40:28", "text": "深夜のセール。ええ、3つあります"}, {"type": "subtitle", "time": 9630.87, "timestamp": "02:40:30", "text": "メッセージ。ミンクの取引は11時間後に成立します。"}, {"type": "subtitle", "time": 9633.429, "timestamp": "02:40:33", "text": "昇進する。オールライトさんと話してみてください。うん、"}, {"type": "subtitle", "time": 9637.59, "timestamp": "02:40:37", "text": "みんな、ここを出よう。来て。"}, {"type": "subtitle", "time": 9639.91, "timestamp": "02:40:39", "text": "こんにちは。"}, {"type": "subtitle", "time": 9643.27, "timestamp": "02:40:43", "text": "さもなければ、ホテルとミンクの件になるだろう"}, {"type": "subtitle", "time": 9645.83, "timestamp": "02:40:45", "text": "そして、これで配信を終了します。全て"}, {"type": "subtitle", "time": 9650.13, "timestamp": "02:40:50", "text": "右。うん。 EPの時間です。"}, {"type": "subtitle", "time": 9652.07, "timestamp": "02:40:52", "text": "[音楽]"}, {"type": "subtitle", "time": 9658.63, "timestamp": "02:40:58", "text": "ボーナス。私は今、ストリートチルドレンの5人目です。"}]
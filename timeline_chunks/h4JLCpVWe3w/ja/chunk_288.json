[{"type": "subtitle", "time": 17282.07, "timestamp": "04:48:02", "text": "わかった。わかった。私は思い切ってそれを買った。わかった。わかった。"}, {"type": "subtitle", "time": 17284.948, "timestamp": "04:48:04", "text": "始めなければ。準備はいいですか？うん。はい、私は"}, {"type": "subtitle", "time": 17293.27, "timestamp": "04:48:13", "text": "長い間放置された農家。"}, {"type": "subtitle", "time": 17295.03, "timestamp": "04:48:15", "text": "人里離れた場所。真ん中で"}, {"type": "subtitle", "time": 17298.23, "timestamp": "04:48:18", "text": "どこにもない。中に何が隠されているかは誰にもわからない"}, {"type": "subtitle", "time": 17302.07, "timestamp": "04:48:22", "text": "先端のない距離音？遠くから聞こえる音。"}, {"type": "subtitle", "time": 17304.628, "timestamp": "04:48:24", "text": "遠くから聞こえる音とはどういう意味ですか？また"}, {"type": "subtitle", "time": 17308.788, "timestamp": "04:48:28", "text": "まるで私が拳骨みたいだ。ウガンダナックル"}, {"type": "subtitle", "time": 17311.59, "timestamp": "04:48:31", "text": "あなたの配信で。私は拳骨だ。ああ、そうだね。"}, {"type": "subtitle", "time": 17314.39, "timestamp": "04:48:34", "text": "お前はバカだ。"}, {"type": "subtitle", "time": 17317.27, "timestamp": "04:48:37", "text": "ああ、このミームはもう廃れたんだよね？あなたは"}, {"type": "subtitle", "time": 17320.868, "timestamp": "04:48:40", "text": "道は知っていますか？道はご存知ですか？おお、"}, {"type": "subtitle", "time": 17322.47, "timestamp": "04:48:42", "text": "ところで、何か書いてあるか確認してみて"}, {"type": "subtitle", "time": 17327.03, "timestamp": "04:48:47", "text": "一番上に。ええと、保留中です。 「ああ、それは」"}, {"type": "subtitle", "time": 17329.83, "timestamp": "04:48:49", "text": "レベル1に現れる幽霊です"}, {"type": "subtitle", "time": 17332.15, "timestamp": "04:48:52", "text": "保留中のものに応答しますか？だから、もしあなたが言うなら"}, {"type": "subtitle", "time": 17334.15, "timestamp": "04:48:54", "text": "保留中であっても、それに対して応答します"}, {"type": "subtitle", "time": 17337.708, "timestamp": "04:48:57", "text": "あなたが一人であろうとなかろうと。"}]
[{"type": "subtitle", "time": 7805.669, "timestamp": "02:10:05", "text": "ああ、1.6を掛けたいんですね？つまり68。"}, {"type": "subtitle", "time": 7808.229, "timestamp": "02:10:08", "text": "持続する。マリファナの基準。わかった。"}, {"type": "subtitle", "time": 7810.55, "timestamp": "02:10:10", "text": "販売リスト。はい、どうぞ。すべき"}, {"type": "subtitle", "time": 7814.47, "timestamp": "02:10:14", "text": "価格を上げるべきでしょうか？うん。うん。上へ"}, {"type": "subtitle", "time": 7817.589, "timestamp": "02:10:17", "text": "価格については、ご要望に応じて提示いたします。あらら。いつ"}, {"type": "subtitle", "time": 7819.99, "timestamp": "02:10:19", "text": "彼らはそれを要求している。わかった。"}, {"type": "subtitle", "time": 7822.39, "timestamp": "02:10:22", "text": "カウンター取引のように、"}, {"type": "subtitle", "time": 7825.109, "timestamp": "02:10:25", "text": "アンプは価格を上げる。よし、私たちは"}, {"type": "subtitle", "time": 7826.95, "timestamp": "02:10:26", "text": "それでは、お客様をお待ちします。さあ"}, {"type": "subtitle", "time": 7833.35, "timestamp": "02:10:33", "text": "お父さん、またバスケットボールやってるの？"}, {"type": "subtitle", "time": 7834.87, "timestamp": "02:10:34", "text": "いいえ。"}, {"type": "subtitle", "time": 7846.43, "timestamp": "02:10:46", "text": "バット。ああ、バットも手に入れられるよ。"}, {"type": "subtitle", "time": 7851.47, "timestamp": "02:10:51", "text": "私が彼を殺した。あなたは私に支払わせた"}, {"type": "subtitle", "time": 7853.069, "timestamp": "02:10:53", "text": "医学"}, {"type": "subtitle", "time": 7856.95, "timestamp": "02:10:56", "text": "法案。私は33ドル支払わなければならなかった。私はすべてを失った"}, {"type": "subtitle", "time": 7859.03, "timestamp": "02:10:59", "text": "お金。"}]
[{"type": "subtitle", "time": 16501.83, "timestamp": "04:35:01", "text": "あなたを「来て、手に入れて」と思わせることができる"}, {"type": "subtitle", "time": 16503.83, "timestamp": "04:35:03", "text": "カメラか何か。わからない。しかし"}, {"type": "subtitle", "time": 16506.15, "timestamp": "04:35:06", "text": "問題は彼が狩りをしているから"}, {"type": "subtitle", "time": 16509.189, "timestamp": "04:35:09", "text": "そうですね、何も見えませんし、もし私が"}, {"type": "subtitle", "time": 16512.15, "timestamp": "04:35:12", "text": "うん、彼女も黒人だから、つまりそうじゃない"}, {"type": "subtitle", "time": 16515.349, "timestamp": "04:35:15", "text": "黒くて、彼女は影の中にいる。はい。"}, {"type": "subtitle", "time": 16518.869, "timestamp": "04:35:18", "text": "ありがとう。はい。だから私はこう言うだろう"}, {"type": "subtitle", "time": 16521.189, "timestamp": "04:35:21", "text": "彼女に会ったら、彼女は私を殺すだろう。"}, {"type": "subtitle", "time": 16523.429, "timestamp": "04:35:23", "text": "はい。"}, {"type": "subtitle", "time": 16525.75, "timestamp": "04:35:25", "text": "ああ、君だよ、オボ。彼女はとても小さい"}, {"type": "subtitle", "time": 16529.15, "timestamp": "04:35:29", "text": "あなたのような。はい。あなたはカエルです。小さい"}, {"type": "subtitle", "time": 16532.629, "timestamp": "04:35:32", "text": "カエルをプロフィール画像に設定しましょう。"}, {"type": "subtitle", "time": 16535.269, "timestamp": "04:35:35", "text": "ああ、彼女が来るよ。"}, {"type": "subtitle", "time": 16538.949, "timestamp": "04:35:38", "text": "彼女が来る。やあ、"}, {"type": "subtitle", "time": 16540.551, "timestamp": "04:35:40", "text": "お皿を投げるのはやめなさい、あなたは甘やかされている、"}, {"type": "subtitle", "time": 16548.07, "timestamp": "04:35:48", "text": "前回、私とカイラとセレステが遊んだとき"}, {"type": "subtitle", "time": 16549.91, "timestamp": "04:35:49", "text": "それと、セレステとカイラは文字通り"}, {"type": "subtitle", "time": 16551.429, "timestamp": "04:35:51", "text": "クソみたいな骨を探してる。私はこう思う、"}]
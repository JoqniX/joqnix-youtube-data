[{"type": "subtitle", "time": 8340.509, "timestamp": "02:19:00", "text": "シミュレーター。ああ、そうそう。私は保存しました"}, {"type": "subtitle", "time": 8343.27, "timestamp": "02:19:03", "text": "ゲーム。大丈夫だよ、みんな。私たちは保存しました"}, {"type": "subtitle", "time": 8344.629, "timestamp": "02:19:04", "text": "ゲーム。"}, {"type": "subtitle", "time": 8347.99, "timestamp": "02:19:07", "text": "なんてこった。"}, {"type": "subtitle", "time": 8350.709, "timestamp": "02:19:10", "text": "新しいシャツとか何かありますか？"}, {"type": "subtitle", "time": 8352.83, "timestamp": "02:19:12", "text": "得る？そうそう。あなたはできる。それは"}, {"type": "subtitle", "time": 8362.87, "timestamp": "02:19:22", "text": "右。ひたすら努力している。最初の"}, {"type": "subtitle", "time": 8366.589, "timestamp": "02:19:26", "text": "取引。私はとても興奮しています。"}, {"type": "subtitle", "time": 8369.589, "timestamp": "02:19:29", "text": "いいえ。いいえ。"}, {"type": "subtitle", "time": 8374.389, "timestamp": "02:19:34", "text": "父さん、今の私はあなたより優れているよ。いいえ。"}, {"type": "subtitle", "time": 8392.63, "timestamp": "02:19:52", "text": "それでおしまい。今こそチャンスを逃す時だ。ああ、了解。"}]
[{"type": "subtitle", "time": 18242.47, "timestamp": "05:04:02", "text": "性別は、もし彼が入ってきたら、"}, {"type": "subtitle", "time": 18245.83, "timestamp": "05:04:05", "text": "まるで塩の下を歩いたような気分だ。うん。そして"}, {"type": "subtitle", "time": 18247.83, "timestamp": "05:04:07", "text": "また、もう一つ良い点として、"}, {"type": "subtitle", "time": 18251.67, "timestamp": "05:04:11", "text": "十字架、そう、それは反発するだろうが、"}, {"type": "subtitle", "time": 18253.91, "timestamp": "05:04:13", "text": "後でまた来ます。"}, {"type": "subtitle", "time": 18256.948, "timestamp": "05:04:16", "text": "ああ、だから十字架は"}, {"type": "subtitle", "time": 18265.83, "timestamp": "05:04:25", "text": "そしてあなたは私がそこに立っているのを見た"}, {"type": "subtitle", "time": 18268.39, "timestamp": "05:04:28", "text": "彼（彼または彼女）が狩りをしているように。だから今あなたは"}, {"type": "subtitle", "time": 18271.03, "timestamp": "05:04:31", "text": "何をすべきかを知っている。"}, {"type": "subtitle", "time": 18272.55, "timestamp": "05:04:32", "text": "ああ、そうだね。まだ持っていますか"}, {"type": "subtitle", "time": 18274.47, "timestamp": "05:04:34", "text": "塩？"}, {"type": "subtitle", "time": 18277.27, "timestamp": "05:04:37", "text": "私はそうは思いません。"}, {"type": "subtitle", "time": 18280.788, "timestamp": "05:04:40", "text": "ああ、くそ。そうすれば、あなたはこうできたでしょう"}, {"type": "subtitle", "time": 18283.35, "timestamp": "05:04:43", "text": "塩をドアの近くに置いて、外に出る"}, {"type": "subtitle", "time": 18285.99, "timestamp": "05:04:45", "text": "外出先で彼女に電話をしたら、彼女は中に入ることができた。"}, {"type": "subtitle", "time": 18287.83, "timestamp": "05:04:47", "text": "うん。だから、たとえ死んでも、"}, {"type": "subtitle", "time": 18290.948, "timestamp": "05:04:50", "text": "一つのことをやり遂げる。うん。待って、彼女は"}, {"type": "subtitle", "time": 18294.868, "timestamp": "05:04:54", "text": "現在、狩猟を行っていますか？はい。"}, {"type": "subtitle", "time": 18296.628, "timestamp": "05:04:56", "text": "聖なる。彼女を見たよね？そこに立っている"}, {"type": "subtitle", "time": 18299.19, "timestamp": "05:04:59", "text": "あなたの目の前に。うん。ええ、彼女は"}]
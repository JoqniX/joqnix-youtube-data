[{"type": "subtitle", "time": 4564.39, "timestamp": "01:16:04", "text": "彼ら。青い家の外観。わかった。"}, {"type": "subtitle", "time": 4566.149, "timestamp": "01:16:06", "text": "さあ行こう。青い家に行こう"}, {"type": "subtitle", "time": 4568.709, "timestamp": "01:16:08", "text": "今。"}, {"type": "subtitle", "time": 4571.51, "timestamp": "01:16:11", "text": "ああ、あった。わかった。わかった。殺してもいいですか"}, {"type": "subtitle", "time": 4573.11, "timestamp": "01:16:13", "text": "彼ら？"}, {"type": "subtitle", "time": 4575.07, "timestamp": "01:16:15", "text": "おい、俺は殺した"}, {"type": "subtitle", "time": 4578.79, "timestamp": "01:16:18", "text": "彼。ごめん。もちろん。私が彼を殺した。おお"}, {"type": "subtitle", "time": 4581.83, "timestamp": "01:16:21", "text": "我が神よ。警察。何てことだ。私は文字通り"}, {"type": "subtitle", "time": 4585.07, "timestamp": "01:16:25", "text": "今、車で通り過ぎているところです。お願いします。お願いします。"}, {"type": "subtitle", "time": 4588.39, "timestamp": "01:16:28", "text": "なんてこった。他の場所で人を殺し始める"}, {"type": "subtitle", "time": 4592.55, "timestamp": "01:16:32", "text": "ゲームも同様です。いや。ああ、なんてことだ。あなたはできません"}, {"type": "subtitle", "time": 4604.63, "timestamp": "01:16:44", "text": "いいえ。"}, {"type": "subtitle", "time": 4608.31, "timestamp": "01:16:48", "text": "そのまま実行してもいいですか？うん。やってみろ。やってみろ。"}, {"type": "subtitle", "time": 4611.189, "timestamp": "01:16:51", "text": "来て。やってみろ。いや。彼は私の顧客です。"}, {"type": "subtitle", "time": 4613.75, "timestamp": "01:16:53", "text": "何でも。わかった。私はそれが"}, {"type": "subtitle", "time": 4616.31, "timestamp": "01:16:56", "text": "警察。ああ、なんてことだ、警察だ。ビート"}, {"type": "subtitle", "time": 4618.229, "timestamp": "01:16:58", "text": "彼らを持ち上げる。彼らを叩きのめせ。戦い。戦い。私"}, {"type": "subtitle", "time": 4619.99, "timestamp": "01:16:59", "text": "何も行動を起こさなかった。警察。わかった。私は必要としている"}]
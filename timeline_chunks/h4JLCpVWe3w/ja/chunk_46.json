[{"type": "subtitle", "time": 2770.63, "timestamp": "00:46:10", "text": "え、君たち配信してるの？誰でも？誰"}, {"type": "subtitle", "time": 2772.27, "timestamp": "00:46:12", "text": "ストリーミング"}, {"type": "subtitle", "time": 2799.51, "timestamp": "00:46:39", "text": "協同組合がどうなっているかは確認していません"}, {"type": "subtitle", "time": 2808.309, "timestamp": "00:46:48", "text": "興奮した。まだしていないことは分かっています。"}, {"type": "subtitle", "time": 2818.23, "timestamp": "00:46:58", "text": "うん。いいえ。私は一人だったので、"}]
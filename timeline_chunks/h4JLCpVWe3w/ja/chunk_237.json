[{"type": "subtitle", "time": 14223.189, "timestamp": "03:57:03", "text": "わかった。それで、"}, {"type": "subtitle", "time": 14225.75, "timestamp": "03:57:05", "text": "はい。"}, {"type": "subtitle", "time": 14228.469, "timestamp": "03:57:08", "text": "えっと、ちょっと待ってください。見逃してみよう"}, {"type": "subtitle", "time": 14237.91, "timestamp": "03:57:17", "text": "VCA。私からもよろしくお伝えください。ああ、"}, {"type": "subtitle", "time": 14240.67, "timestamp": "03:57:20", "text": "一緒に遊んでくれてありがとう。ミッチ、"}, {"type": "subtitle", "time": 14243.83, "timestamp": "03:57:23", "text": "あと、VC（ベンチャーキャピタル）は今すぐ欲しいですか？そうそう。"}, {"type": "subtitle", "time": 14245.75, "timestamp": "03:57:25", "text": "ええ、もちろん、もちろんです。私たちはできる"}]
[{"type": "subtitle", "time": 6302.229, "timestamp": "01:45:02", "text": "だって、私は生ける死人だから。"}, {"type": "subtitle", "time": 6304.55, "timestamp": "01:45:04", "text": "一体どういうことだよ、兄弟？持続する。手伝います"}, {"type": "subtitle", "time": 6307.03, "timestamp": "01:45:07", "text": "あなた。手伝いますよ。いいえ、私はトップにいます"}, {"type": "subtitle", "time": 6309.27, "timestamp": "01:45:09", "text": "私は屋根の上にいます。わかりました。"}, {"type": "subtitle", "time": 6310.87, "timestamp": "01:45:10", "text": "隠れる。そして隠れる。まあまあだよ、みんな。"}, {"type": "subtitle", "time": 6312.47, "timestamp": "01:45:12", "text": "私はビデオゲームをするつもりです"}, {"type": "subtitle", "time": 6314.47, "timestamp": "01:45:14", "text": "ゲーム。"}, {"type": "subtitle", "time": 6316.149, "timestamp": "01:45:16", "text": "まあ、近いから。卵男は"}, {"type": "subtitle", "time": 6319.229, "timestamp": "01:45:19", "text": "ペニスを持っている？一体何が起こっているんだ？"}, {"type": "subtitle", "time": 6322.55, "timestamp": "01:45:22", "text": "ああ、後ろを見てごらん。待って、"}, {"type": "subtitle", "time": 6327.229, "timestamp": "01:45:27", "text": "人間、人間、入口。あなたは私に会います？おお。"}, {"type": "subtitle", "time": 6330.87, "timestamp": "01:45:30", "text": "我慢する。何かもらえるかな"}, {"type": "subtitle", "time": 6334.629, "timestamp": "01:45:34", "text": "それを落とす。ああ、くそ。"}, {"type": "subtitle", "time": 6338.149, "timestamp": "01:45:38", "text": "ああ、わかりました。クレーターから来た。"}, {"type": "subtitle", "time": 6340.39, "timestamp": "01:45:40", "text": "これをちょっと掃除させてください。ポパは"}, {"type": "subtitle", "time": 6344.87, "timestamp": "01:45:44", "text": "来る？なんてこった。なんてこった。なんてこった。やめて、やめて"}, {"type": "subtitle", "time": 6347.669, "timestamp": "01:45:47", "text": "少し顔色が青白くなっただけ。顔色が少し青白くなっただけ。"}, {"type": "subtitle", "time": 6349.51, "timestamp": "01:45:49", "text": "逮捕されますよ。クソしたい"}, {"type": "subtitle", "time": 6352.39, "timestamp": "01:45:52", "text": "全人口を抹殺する。"}, {"type": "subtitle", "time": 6353.83, "timestamp": "01:45:53", "text": "それは私たちが薬物を扱う方法ではない"}, {"type": "subtitle", "time": 6356.31, "timestamp": "01:45:56", "text": "このクソみたいな町で商売をする。私たちはできる"}, {"type": "subtitle", "time": 6359.189, "timestamp": "01:45:59", "text": "警察がいなければ、麻薬取引が行われる。"}]
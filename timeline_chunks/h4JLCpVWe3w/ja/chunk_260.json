[{"type": "subtitle", "time": 15602.87, "timestamp": "04:20:02", "text": "それ。ええ、そう思います。なぜなら彼女はこう答えるからです。"}, {"type": "subtitle", "time": 15605.429, "timestamp": "04:20:05", "text": "孤独な人へ。二階へ上がってください"}, {"type": "subtitle", "time": 15634.95, "timestamp": "04:20:34", "text": "H、彼女に電話して。彼女に電話して。"}, {"type": "subtitle", "time": 15640.55, "timestamp": "04:20:40", "text": "エヴァリー、どこにいるの？ルース、私は思う"}, {"type": "subtitle", "time": 15642.95, "timestamp": "04:20:42", "text": "彼女がこのバスルームにいるのは、"}, {"type": "subtitle", "time": 15646.07, "timestamp": "04:20:46", "text": "の上。彼女はここにいる。ああ、神様。落ち着け。"}, {"type": "subtitle", "time": 15650.309, "timestamp": "04:20:50", "text": "彼女はシンクのT字型の部分にうんちをした。"}, {"type": "subtitle", "time": 15653.59, "timestamp": "04:20:53", "text": "ここに来て。出かけます。覚えておいてください、電話してください"}, {"type": "subtitle", "time": 15655.59, "timestamp": "04:20:55", "text": "彼女をこのバスルームから連れ出して、"}, {"type": "subtitle", "time": 15658.189, "timestamp": "04:20:58", "text": "写真を見てから、私と一緒に来てください。一緒に来てください"}]
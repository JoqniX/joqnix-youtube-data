[{"type": "subtitle", "time": 15125.389, "timestamp": "04:12:05", "text": "ルース。ロー、今日はどんな一日だった？どこに"}, {"type": "subtitle", "time": 15128.71, "timestamp": "04:12:08", "text": "あなた？二階へ上がります。私は行きます"}, {"type": "subtitle", "time": 15131.189, "timestamp": "04:12:11", "text": "2階へ。わかった。うん。お知らせいただければ"}, {"type": "subtitle", "time": 15133.55, "timestamp": "04:12:13", "text": "彼は何かを言う。"}, {"type": "subtitle", "time": 15136.229, "timestamp": "04:12:16", "text": "わかった。ルース。"}, {"type": "subtitle", "time": 15139.349, "timestamp": "04:12:19", "text": "あら、誰が電気を消したの？いや、違うよ。"}, {"type": "subtitle", "time": 15141.99, "timestamp": "04:12:21", "text": "あなたですか？えっと、電気をつけていたんです"}, {"type": "subtitle", "time": 15145.75, "timestamp": "04:12:25", "text": "提供することによって。ああ、そういうことか。それが理由です。"}, {"type": "subtitle", "time": 15148.389, "timestamp": "04:12:28", "text": "えっと、発電機はどこですか？下に。の"}, {"type": "subtitle", "time": 15152.63, "timestamp": "04:12:32", "text": "北。以下に記載されています。えっと、待って、"}, {"type": "subtitle", "time": 15154.63, "timestamp": "04:12:34", "text": "地図を見る必要がある。それは"}, {"type": "subtitle", "time": 15156.91, "timestamp": "04:12:36", "text": "ガレージ。"}, {"type": "subtitle", "time": 15160.55, "timestamp": "04:12:40", "text": "よし、ロイ、どこにいるんだ？近くに滞在する"}, {"type": "subtitle", "time": 15162.469, "timestamp": "04:12:42", "text": "ドア。ドアの近くにいてください。出口付近に留まる"}, {"type": "subtitle", "time": 15164.13, "timestamp": "04:12:44", "text": "ドア。わかった。"}, {"type": "subtitle", "time": 15167.389, "timestamp": "04:12:47", "text": "[音楽]"}, {"type": "subtitle", "time": 15176.229, "timestamp": "04:12:56", "text": "わかった。えっと、ジョック、地下室に行って。"}, {"type": "subtitle", "time": 15178.229, "timestamp": "04:12:58", "text": "わかった。"}, {"type": "subtitle", "time": 15179.91, "timestamp": "04:12:59", "text": "ゲーム内のマイクをオフにして、"}]
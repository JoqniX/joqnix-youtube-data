[{"type": "subtitle", "time": 14760.63, "timestamp": "04:06:00", "text": "わかった。それで、左クリックしたんですよね？ええ、そうです。"}, {"type": "subtitle", "time": 14762.229, "timestamp": "04:06:02", "text": "右クリックすると、"}, {"type": "subtitle", "time": 14763.83, "timestamp": "04:06:03", "text": "写真。でも、今は写真を撮らないでください。"}, {"type": "subtitle", "time": 14765.429, "timestamp": "04:06:05", "text": "幽霊を見たら、"}, {"type": "subtitle", "time": 14768.63, "timestamp": "04:06:08", "text": "写真。私たちにはそれが必要なのです。わかった。"}, {"type": "subtitle", "time": 14770.229, "timestamp": "04:06:10", "text": "ここからの活動について説明します"}, {"type": "subtitle", "time": 14772.87, "timestamp": "04:06:12", "text": "トラックから。ルース、どこにいるの？"}, {"type": "subtitle", "time": 14775.429, "timestamp": "04:06:15", "text": "ルース、出てきて。出てくる。どこにいても"}, {"type": "subtitle", "time": 14786.229, "timestamp": "04:06:26", "text": "彼にいくつか質問するか、"}, {"type": "subtitle", "time": 14788.189, "timestamp": "04:06:28", "text": "彼を脅迫する。"}, {"type": "subtitle", "time": 14790.87, "timestamp": "04:06:30", "text": "わかったよ、兄弟。あなたは自分が行くことを知っていますか"}, {"type": "subtitle", "time": 14793.99, "timestamp": "04:06:33", "text": "殺されるが、我々に追われることはない？どうやって"}, {"type": "subtitle", "time": 14798.07, "timestamp": "04:06:38", "text": "一体どういうことだ？彼は既に死んでいる。"}, {"type": "subtitle", "time": 14800.309, "timestamp": "04:06:40", "text": "そうそう。忘れていた。"}, {"type": "subtitle", "time": 14802.389, "timestamp": "04:06:42", "text": "「調子はどうですか？」と彼に聞いてみてください。は"}, {"type": "subtitle", "time": 14806.91, "timestamp": "04:06:46", "text": "ここにいる？うん。うん。どうだった？"}, {"type": "subtitle", "time": 14810.349, "timestamp": "04:06:50", "text": "失礼な人ね。今日はどんな一日だった？"}, {"type": "subtitle", "time": 14813.429, "timestamp": "04:06:53", "text": "ルース、良い一日を過ごしましたか？ところで、"}, {"type": "subtitle", "time": 14815.75, "timestamp": "04:06:55", "text": "スピリットボックスを使って遊んでください。それは"}, {"type": "subtitle", "time": 14817.51, "timestamp": "04:06:57", "text": "彼がいつ答えるか。スピリットボックスを使ってください。"}, {"type": "subtitle", "time": 14819.83, "timestamp": "04:06:59", "text": "ああ、わかりました。わかった。わかった。ああ、もし彼が"}]
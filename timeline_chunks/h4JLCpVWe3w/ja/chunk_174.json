[{"type": "subtitle", "time": 10447.59, "timestamp": "02:54:07", "text": "アカ、君のためにもっとお金を用意したよ。私は行きます"}, {"type": "subtitle", "time": 10448.83, "timestamp": "02:54:08", "text": "預金する"}, {"type": "subtitle", "time": 10458.55, "timestamp": "02:54:18", "text": "よし、みんな。私は出発します"}, {"type": "subtitle", "time": 10460.95, "timestamp": "02:54:20", "text": "このゲーム。"}, {"type": "subtitle", "time": 10463.19, "timestamp": "02:54:23", "text": "こんにちは。"}, {"type": "subtitle", "time": 10466.87, "timestamp": "02:54:26", "text": "よし。やめる。何って言ったの？おお、"}, {"type": "subtitle", "time": 10472.75, "timestamp": "02:54:32", "text": "おお"}, {"type": "subtitle", "time": 10477.59, "timestamp": "02:54:37", "text": "いいえ。なんてこった。自動保存されると思います。いいえ。"}, {"type": "subtitle", "time": 10480.95, "timestamp": "02:54:40", "text": "いいえ。もう一度ログインしてください。もう一度ログインして確認してください。"}, {"type": "subtitle", "time": 10483.19, "timestamp": "02:54:43", "text": "わかった。"}, {"type": "subtitle", "time": 10484.95, "timestamp": "02:54:44", "text": "つまり、時間があるときは、"}, {"type": "subtitle", "time": 10488.389, "timestamp": "02:54:48", "text": "今日やったことをやり直そう。うん。つまり、私は"}]
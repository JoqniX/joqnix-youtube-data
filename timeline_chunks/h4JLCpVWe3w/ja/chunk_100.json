[{"type": "subtitle", "time": 6000.55, "timestamp": "01:40:00", "text": "はい。"}, {"type": "subtitle", "time": 6002.79, "timestamp": "01:40:02", "text": "いいえ。ワックスシードも全部手に入れたと思ったのですが、"}, {"type": "subtitle", "time": 6006.629, "timestamp": "01:40:06", "text": "兄弟。一体どういうことだ？"}, {"type": "subtitle", "time": 6009.43, "timestamp": "01:40:09", "text": "待って、君たちはどこにいるの？よし、今私は"}, {"type": "subtitle", "time": 6014.87, "timestamp": "01:40:14", "text": "えーと、自動車販売店で。はい、"}, {"type": "subtitle", "time": 6018.629, "timestamp": "01:40:18", "text": "これからどうするかは分かっている。"}, {"type": "subtitle", "time": 6021.51, "timestamp": "01:40:21", "text": "F を押すと、"}, {"type": "subtitle", "time": 6025.629, "timestamp": "01:40:25", "text": "懐中電灯。ああ、わかりました。うん、君は"}, {"type": "subtitle", "time": 6028.59, "timestamp": "01:40:28", "text": "輝いている。今はもう違います。今"}, {"type": "subtitle", "time": 6032.07, "timestamp": "01:40:32", "text": "フラッシュを浴びた。悪ふざけには関わらない"}, {"type": "subtitle", "time": 6034.229, "timestamp": "01:40:34", "text": "方法。"}, {"type": "subtitle", "time": 6036.95, "timestamp": "01:40:36", "text": "えっと、なんでここに死体があるの？私"}, {"type": "subtitle", "time": 6039.75, "timestamp": "01:40:39", "text": "最高だった。ジョック。"}, {"type": "subtitle", "time": 6042.91, "timestamp": "01:40:42", "text": "ああ、彼は生きている。"}, {"type": "subtitle", "time": 6047.51, "timestamp": "01:40:47", "text": "ジョック。見知らぬ女性。いいえ、彼は生きています。の"}, {"type": "subtitle", "time": 6050.47, "timestamp": "01:40:50", "text": "彼は生きている。彼は死んだ。選ぶことができます"}, {"type": "subtitle", "time": 6055.99, "timestamp": "01:40:55", "text": "彼らを持ち上げる。待って、私の画面では彼は生きている。"}, {"type": "subtitle", "time": 6058.79, "timestamp": "01:40:58", "text": "何？君は怖いよ、スポーツマン。ジョックの"}]
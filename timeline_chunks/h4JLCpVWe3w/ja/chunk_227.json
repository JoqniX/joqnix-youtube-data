[{"type": "subtitle", "time": 13631.51, "timestamp": "03:47:11", "text": "何だって、ああ、"}, {"type": "subtitle", "time": 13640.389, "timestamp": "03:47:20", "text": "カンヤ。ダニエル、何かサインを見せてくれ。あなたは"}, {"type": "subtitle", "time": 13648.87, "timestamp": "03:47:28", "text": "ダニエル、君はこの部屋にいるのか？"}, {"type": "subtitle", "time": 13651.99, "timestamp": "03:47:31", "text": "ダニエル、ここにいる？ダニエル、"}, {"type": "subtitle", "time": 13653.67, "timestamp": "03:47:33", "text": "お前はクソを飲んでるんだ。ダニエル、私たちに"}, {"type": "subtitle", "time": 13655.269, "timestamp": "03:47:35", "text": "サイン。"}, {"type": "subtitle", "time": 13658.63, "timestamp": "03:47:38", "text": "何か兆候を見せてください。ダニエル、"}, {"type": "subtitle", "time": 13662.07, "timestamp": "03:47:42", "text": "ダニエル、俺はお前の元カノとヤったんだ。"}, {"type": "subtitle", "time": 13673.15, "timestamp": "03:47:53", "text": "[音楽]"}]
[{"type": "subtitle", "time": 4081.52, "timestamp": "01:08:01", "text": "何てことだ。まるで『ブレイキング・バッド』みたいだ。その とてもリアルだ。"}, {"type": "subtitle", "time": 4089.71, "timestamp": "01:08:09", "text": "あ、待って。いいえ、開始位置が違います。くそっ。"}, {"type": "subtitle", "time": 4092.549, "timestamp": "01:08:12", "text": "おお。何てことだ。あれはヘクターか？"}, {"type": "subtitle", "time": 4096.309, "timestamp": "01:08:16", "text": "ヘクターだ。それは、それは蜜です。その"}, {"type": "subtitle", "time": 4100.47, "timestamp": "01:08:20", "text": "ネクターおじさん。待って、君たちはどこにいるの？"}, {"type": "subtitle", "time": 4102.55, "timestamp": "01:08:22", "text": "あ、待って。私はチュートリアルをやっていました。私"}, {"type": "subtitle", "time": 4104.87, "timestamp": "01:08:24", "text": "つまり、それは「ああ、いや」です。これはただ"}, {"type": "subtitle", "time": 4107.43, "timestamp": "01:08:27", "text": "こうやって始まるのか？えっと、待って。私は"}, {"type": "subtitle", "time": 4109.749, "timestamp": "01:08:29", "text": "バン。どこにいるの？"}, {"type": "subtitle", "time": 4111.829, "timestamp": "01:08:31", "text": "いいえ、プロローグで。ええ、"}, {"type": "subtitle", "time": 4113.43, "timestamp": "01:08:33", "text": "プロローグはこちら。シングルプレイヤー専用です。"}, {"type": "subtitle", "time": 4115.269, "timestamp": "01:08:35", "text": "モード。プロローグの後は"}, {"type": "subtitle", "time": 4119.59, "timestamp": "01:08:39", "text": "マルチプレイヤー。わかった。わかった。ああ、ええと。"}, {"type": "subtitle", "time": 4121.189, "timestamp": "01:08:41", "text": "だから、プロローグをやらなければならない。わかった。"}, {"type": "subtitle", "time": 4125.669, "timestamp": "01:08:45", "text": "終わったら話しかけてね"}, {"type": "subtitle", "time": 4126.95, "timestamp": "01:08:46", "text": "すべては私が何者なのか"}, {"type": "subtitle", "time": 4129.43, "timestamp": "01:08:49", "text": "やるべきことは、よし。えっと、今"}, {"type": "subtitle", "time": 4134.03, "timestamp": "01:08:54", "text": "バンの中を探検してみよう。えーと、きらめきを使って"}, {"type": "subtitle", "time": 4137.11, "timestamp": "01:08:57", "text": "収穫。ここにプライマーはありますか？ああ、私は"}]
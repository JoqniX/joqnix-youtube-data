[{"type": "subtitle", "time": 10142.99, "timestamp": "02:49:02", "text": "欲しいですか？"}, {"type": "subtitle", "time": 10151.11, "timestamp": "02:49:11", "text": "通常？ええと、メールアドレスをお送りします。なんてこった。"}, {"type": "subtitle", "time": 10158.67, "timestamp": "02:49:18", "text": "さて、ミキシングはどこで行うのですか？"}, {"type": "subtitle", "time": 10162.11, "timestamp": "02:49:22", "text": "もの？わかった、わかった"}, {"type": "subtitle", "time": 10165.36, "timestamp": "02:49:25", "text": "それ。新しい製品を作る時期が来た。"}, {"type": "subtitle", "time": 10168.59, "timestamp": "02:49:28", "text": "[音楽]"}, {"type": "subtitle", "time": 10171.429, "timestamp": "02:49:31", "text": "みんな。私のノートパソコンは"}, {"type": "subtitle", "time": 10173.23, "timestamp": "02:49:33", "text": "航空会社の権利"}, {"type": "subtitle", "time": 10191.429, "timestamp": "02:49:51", "text": "ミキサー。もし私が、ああ、私は"}, {"type": "subtitle", "time": 10194.63, "timestamp": "02:49:54", "text": "バナナとかそういうもの。それは試せない"}, {"type": "subtitle", "time": 10196.95, "timestamp": "02:49:56", "text": "バナナか何か"}]
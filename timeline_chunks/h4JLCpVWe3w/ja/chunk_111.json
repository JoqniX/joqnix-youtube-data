[{"type": "subtitle", "time": 6664.629, "timestamp": "01:51:04", "text": "うん。うん。だから常に最新の情報を入手し、"}, {"type": "subtitle", "time": 6668.87, "timestamp": "01:51:08", "text": "ベンチ。それから、スペースをスパムします"}, {"type": "subtitle", "time": 6672.87, "timestamp": "01:51:12", "text": "右に進んで上に上がる。おお、"}, {"type": "subtitle", "time": 6675.669, "timestamp": "01:51:15", "text": "わかった。これはひどい。あなたはまだできる"}, {"type": "subtitle", "time": 6682.229, "timestamp": "01:51:22", "text": "おそらくこれがゲームが続く理由です"}, {"type": "subtitle", "time": 6684.709, "timestamp": "01:51:24", "text": "クラッシュしています。"}, {"type": "subtitle", "time": 6686.79, "timestamp": "01:51:26", "text": "今はどうやって降りるんですか？ごきげんよう"}, {"type": "subtitle", "time": 6692.07, "timestamp": "01:51:32", "text": "これ？椅子のところへ行ってください。スパムスペース"}, {"type": "subtitle", "time": 6707.91, "timestamp": "01:51:47", "text": "あ、待って。いや、いや。わかった。うん。見てごらん。"}, {"type": "subtitle", "time": 6711.109, "timestamp": "01:51:51", "text": "頭がぶつからないように注意してください"}, {"type": "subtitle", "time": 6714.229, "timestamp": "01:51:54", "text": "シーリング。いいえ、見てください。えっと、立ってもいいですよ"}, {"type": "subtitle", "time": 6715.95, "timestamp": "01:51:55", "text": "そして見る"}, {"type": "subtitle", "time": 6719.669, "timestamp": "01:51:59", "text": "私にスパムを送り続けてください。長いと思う"}]
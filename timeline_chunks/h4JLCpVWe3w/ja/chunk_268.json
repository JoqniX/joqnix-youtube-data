[{"type": "subtitle", "time": 16083.67, "timestamp": "04:28:03", "text": "はぁ？待って。彼女は行ってしまったよ、兄弟。"}, {"type": "subtitle", "time": 16086.87, "timestamp": "04:28:06", "text": "ああ、こんにちは、Ou。うん。こんにちは。いらっしゃいませ。"}, {"type": "subtitle", "time": 16089.75, "timestamp": "04:28:09", "text": "いらっしゃいませ。元気ですか？ジョックは"}, {"type": "subtitle", "time": 16091.349, "timestamp": "04:28:11", "text": "彼が家の迂回路を通ったのは"}, {"type": "subtitle", "time": 16094.309, "timestamp": "04:28:14", "text": "死んでる、そして私は生き延びようとしている。うん。"}, {"type": "subtitle", "time": 16101.349, "timestamp": "04:28:21", "text": "はい。私には何もできない。私は持っています"}, {"type": "subtitle", "time": 16103.83, "timestamp": "04:28:23", "text": "ただ今、何も触らずに座っているだけ"}, {"type": "subtitle", "time": 16107.269, "timestamp": "04:28:27", "text": "私のキーボード。それで、ジョック、今日はどんな一日だった？"}, {"type": "subtitle", "time": 16110.309, "timestamp": "04:28:30", "text": "よかった。"}, {"type": "subtitle", "time": 16113.51, "timestamp": "04:28:33", "text": "でも、くれぐれもズボンにうんちを漏らさないでくださいね。"}, {"type": "subtitle", "time": 16116.71, "timestamp": "04:28:36", "text": "はい、彼女の声は聞こえます。彼女が来る。はい、"}, {"type": "subtitle", "time": 16124.07, "timestamp": "04:28:44", "text": "私たち。彼女の声が聞こえる。戻ってくる。私は思う"}, {"type": "subtitle", "time": 16126.95, "timestamp": "04:28:46", "text": "彼女が私に向かってくる。"}, {"type": "subtitle", "time": 16134.389, "timestamp": "04:28:54", "text": "私のもとに戻ってきて。ああ、そこにいてくれ。滞在する"}, {"type": "subtitle", "time": 16137.189, "timestamp": "04:28:57", "text": "そこには。そこに留まって、彼女が来るかどうか見てみよう"}]
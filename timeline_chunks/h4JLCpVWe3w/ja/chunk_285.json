[{"type": "subtitle", "time": 17111.628, "timestamp": "04:45:11", "text": "行くよ。ああ、彼女は"}, {"type": "subtitle", "time": 17115.11, "timestamp": "04:45:15", "text": "来るよ。ああ、彼女が来るわ。あなたは？私 私"}, {"type": "subtitle", "time": 17121.19, "timestamp": "04:45:21", "text": "彼女があなたを殺したのです。"}, {"type": "subtitle", "time": 17123.43, "timestamp": "04:45:23", "text": "ああ、彼女に殺されたんだ。何も見てないよ。"}, {"type": "subtitle", "time": 17124.75, "timestamp": "04:45:24", "text": "ああ、"}, {"type": "subtitle", "time": 17127.91, "timestamp": "04:45:27", "text": "神。いいえ。"}, {"type": "subtitle", "time": 17130.83, "timestamp": "04:45:30", "text": "私もあなたと同じだった。わかった。まさに私が"}, {"type": "subtitle", "time": 17134.868, "timestamp": "04:45:34", "text": "考え。こんにちは、ジョック。こんにちは。その通り"}, {"type": "subtitle", "time": 17136.31, "timestamp": "04:45:36", "text": "私が思った通りだ。だから、ゲームは"}, {"type": "subtitle", "time": 17138.59, "timestamp": "04:45:38", "text": "自分の歩みを記録する。"}, {"type": "subtitle", "time": 17141.43, "timestamp": "04:45:41", "text": "わあ、すごい。"}, {"type": "subtitle", "time": 17144.23, "timestamp": "04:45:44", "text": "だから、その場所から引っ越すとすぐに、"}, {"type": "subtitle", "time": 17146.628, "timestamp": "04:45:46", "text": "それは、"}, {"type": "subtitle", "time": 17148.948, "timestamp": "04:45:48", "text": "個人。だから、"}, {"type": "subtitle", "time": 17152.628, "timestamp": "04:45:52", "text": "キャラクターが死ぬと、あなたの体も死ぬ。今度はAIが"}, {"type": "subtitle", "time": 17156.23, "timestamp": "04:45:56", "text": "あなたの体からそれを記録します"}, {"type": "subtitle", "time": 17158.708, "timestamp": "04:45:58", "text": "亡くなったが、その持ち主はそこにいる。だから"}]
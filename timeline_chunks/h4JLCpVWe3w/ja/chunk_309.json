[{"type": "subtitle", "time": 18541.35, "timestamp": "05:09:01", "text": "しきい値。何か音が聞こえる。何？ああ、私は"}, {"type": "subtitle", "time": 18546.788, "timestamp": "05:09:06", "text": "彼女の声を聞け。ああ、動かないで。"}, {"type": "subtitle", "time": 18548.788, "timestamp": "05:09:08", "text": "懐中電灯を使うのは大丈夫ですか"}, {"type": "subtitle", "time": 18550.708, "timestamp": "05:09:10", "text": "カメラ？"}, {"type": "subtitle", "time": 18553.35, "timestamp": "05:09:13", "text": "それは懐中電灯ではありません。それはあなたの"}, {"type": "subtitle", "time": 18554.948, "timestamp": "05:09:14", "text": "懐中電灯。"}, {"type": "subtitle", "time": 18558.15, "timestamp": "05:09:18", "text": "うん。ドアは閉めましたか？はい、私は"}, {"type": "subtitle", "time": 18562.708, "timestamp": "05:09:22", "text": "した。わかりました。心配ない。"}, {"type": "subtitle", "time": 18574.75, "timestamp": "05:09:34", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 18579.11, "timestamp": "05:09:39", "text": "わかった。つまり、最大狩猟期間は"}, {"type": "subtitle", "time": 18582.708, "timestamp": "05:09:42", "text": "最大1分まで。"}, {"type": "subtitle", "time": 18584.628, "timestamp": "05:09:44", "text": "1分。"}, {"type": "subtitle", "time": 18587.59, "timestamp": "05:09:47", "text": "40秒。 50秒。 1分。ハント"}, {"type": "subtitle", "time": 18589.75, "timestamp": "05:09:49", "text": "間隔。高い場合は、狩猟"}, {"type": "subtitle", "time": 18591.59, "timestamp": "05:09:51", "text": "持続時間は中程度、20秒、40秒"}, {"type": "subtitle", "time": 18594.15, "timestamp": "05:09:54", "text": "秒、50秒、狩猟期間が短い、"}, {"type": "subtitle", "time": 18597.99, "timestamp": "05:09:57", "text": "15秒、30秒、40秒。"}]
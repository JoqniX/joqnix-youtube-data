[{"type": "subtitle", "time": 13815.71, "timestamp": "03:50:15", "text": "死ぬ。ああ、"}, {"type": "subtitle", "time": 13819.11, "timestamp": "03:50:19", "text": "神。彼は「死ね」と言った。"}, {"type": "subtitle", "time": 13823.11, "timestamp": "03:50:23", "text": "彼は「死ね」と言った。何てことだ。"}, {"type": "subtitle", "time": 13831.59, "timestamp": "03:50:31", "text": "待って。何てことだ。これは何かを物語っている"}, {"type": "subtitle", "time": 13834.63, "timestamp": "03:50:34", "text": "「うん」って感じ。何てことだ。押し付けがましい話"}, {"type": "subtitle", "time": 13837.83, "timestamp": "03:50:37", "text": "このゲームでは、それは非常に悪い。それは"}, {"type": "subtitle", "time": 13839.91, "timestamp": "03:50:39", "text": "仕事。おお。"}, {"type": "subtitle", "time": 13843.429, "timestamp": "03:50:43", "text": "持って行ってくれない カメラを持って行ってくれ"}, {"type": "subtitle", "time": 13849.91, "timestamp": "03:50:49", "text": "ソファー。これを受け取って。持って行け、この野郎。取っていく"}, {"type": "subtitle", "time": 13852.389, "timestamp": "03:50:52", "text": "あなたと一緒にスピリットボックスを使います。よし。病気"}]
[{"type": "subtitle", "time": 1690.19, "timestamp": "00:28:10", "text": "[音楽]"}, {"type": "subtitle", "time": 1693.59, "timestamp": "00:28:13", "text": "の上。よし、私の知識の深さは報われた、ということかな？"}, {"type": "subtitle", "time": 1694.59, "timestamp": "00:28:14", "text": "ああ、"}, {"type": "subtitle", "time": 1703.75, "timestamp": "00:28:23", "text": "薬物。よし、たくさん作ろう"}, {"type": "subtitle", "time": 1705.31, "timestamp": "00:28:25", "text": "お金"}]
[{"type": "subtitle", "time": 11250.23, "timestamp": "03:07:30", "text": "これ。ああ、神様。"}, {"type": "subtitle", "time": 11252.269, "timestamp": "03:07:32", "text": "私は"}, {"type": "subtitle", "time": 11255.67, "timestamp": "03:07:35", "text": "終わり。私は眠りにつく。おやすみなさい、"}, {"type": "subtitle", "time": 11257.87, "timestamp": "03:07:37", "text": "みんな。良い一日を"}, {"type": "subtitle", "time": 11262.91, "timestamp": "03:07:42", "text": "1つ。また明日。わかった。"}]
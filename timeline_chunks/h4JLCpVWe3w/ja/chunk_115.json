[{"type": "subtitle", "time": 6902.91, "timestamp": "01:55:02", "text": "ありがとう。"}, {"type": "subtitle", "time": 6917.95, "timestamp": "01:55:17", "text": "何もない。 6ドルの箱。たったの6ドル。 6ドルとは何ですか？"}, {"type": "subtitle", "time": 6928.91, "timestamp": "01:55:28", "text": "300ドルの格安部屋販売中。これは違う"}, {"type": "subtitle", "time": 6934.31, "timestamp": "01:55:34", "text": "安い。ファットドラゴ​​ン中華レストラン。"}, {"type": "subtitle", "time": 6936.149, "timestamp": "01:55:36", "text": "こんにちは、先生。私の"}, {"type": "subtitle", "time": 6943.109, "timestamp": "01:55:43", "text": "あ、待って。君はオースティンだって知ってるよね"}, {"type": "subtitle", "time": 6945.35, "timestamp": "01:55:45", "text": "私の私の私の私の私のを見せたくない"}, {"type": "subtitle", "time": 6946.27, "timestamp": "01:55:46", "text": "とても"}, {"type": "subtitle", "time": 6948.03, "timestamp": "01:55:48", "text": "ニース"}, {"type": "subtitle", "time": 6951.35, "timestamp": "01:55:51", "text": "図面。土を買うのですか？私は"}, {"type": "subtitle", "time": 6953.189, "timestamp": "01:55:53", "text": "ゴミ収集車を購入しようとしている。"}, {"type": "subtitle", "time": 6956.07, "timestamp": "01:55:56", "text": "私はゴミ収集員になるつもりです。"}, {"type": "subtitle", "time": 6959.51, "timestamp": "01:55:59", "text": "それが君の正体だ。お前はクズだ。"}]
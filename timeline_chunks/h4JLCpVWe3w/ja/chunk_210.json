[{"type": "subtitle", "time": 12609.59, "timestamp": "03:30:09", "text": "ああ、彼は実際にドアに鍵をかけたんだ。何"}, {"type": "subtitle", "time": 12611.71, "timestamp": "03:30:11", "text": "の"}, {"type": "subtitle", "time": 12613.71, "timestamp": "03:30:13", "text": "えっ？大きな"}, {"type": "subtitle", "time": 12637.83, "timestamp": "03:30:37", "text": "二。ああ、彼はそうしたよ。待って。それは"}, {"type": "subtitle", "time": 12652.75, "timestamp": "03:30:52", "text": "おお。ああ、私は死んだ。ジョークの作者。いいえ。"}, {"type": "subtitle", "time": 12659.309, "timestamp": "03:30:59", "text": "いいえ。ミッチ"}]
[{"type": "subtitle", "time": 16323.75, "timestamp": "04:32:03", "text": "私はまだ好きです 彼女はまるで"}, {"type": "subtitle", "time": 16326.71, "timestamp": "04:32:06", "text": "BDS（歯学士）彼女が来る。彼女が来る。ああ、私は"}, {"type": "subtitle", "time": 16330.99, "timestamp": "04:32:10", "text": "死ぬだろう。ああ、彼女はまた行ってしまった。"}, {"type": "subtitle", "time": 16335.75, "timestamp": "04:32:15", "text": "なぜ彼女は二本足で立っているのか？"}, {"type": "subtitle", "time": 16341.91, "timestamp": "04:32:21", "text": "私は笑ったり泣いたりしています"}, {"type": "subtitle", "time": 16344.71, "timestamp": "04:32:24", "text": "同時に。何が起こっている？"}, {"type": "subtitle", "time": 16347.03, "timestamp": "04:32:27", "text": "夕食は何を食べますか？えっと"}, {"type": "subtitle", "time": 16350.469, "timestamp": "04:32:30", "text": "えっと、今日、えっと、私は何を食べたと思う"}, {"type": "subtitle", "time": 16354.149, "timestamp": "04:32:34", "text": "また？えっと、パラタですよね？パラを知ってるよね。"}, {"type": "subtitle", "time": 16356.149, "timestamp": "04:32:36", "text": "ええ、わかっています。私たちはそれをパロタと呼びます"}, {"type": "subtitle", "time": 16360.149, "timestamp": "04:32:40", "text": "ベンガル語訛り。おお、いいね。ええ、私は"}, {"type": "subtitle", "time": 16363.91, "timestamp": "04:32:43", "text": "それがあった。うん。はぁ。えっと、私は"}, {"type": "subtitle", "time": 16366.87, "timestamp": "04:32:46", "text": "チキンティッカとロティ。だから私は"}, {"type": "subtitle", "time": 16369.03, "timestamp": "04:32:49", "text": "お米のことだけど、残念ながら忘れてた"}, {"type": "subtitle", "time": 16371.269, "timestamp": "04:32:51", "text": "ご飯を温める必要がある"}, {"type": "subtitle", "time": 16373.269, "timestamp": "04:32:53", "text": "日。冷蔵庫に入れておいたのですが、"}, {"type": "subtitle", "time": 16376.07, "timestamp": "04:32:56", "text": "忘れてたんだけど、文字通り"}, {"type": "subtitle", "time": 16378.95, "timestamp": "04:32:58", "text": "ひどくなったんだよ。"}]
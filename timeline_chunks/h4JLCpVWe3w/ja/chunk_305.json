[{"type": "subtitle", "time": 18302.628, "timestamp": "05:05:02", "text": "狩猟。ああ、それがポイントなんですね"}, {"type": "subtitle", "time": 18305.35, "timestamp": "05:05:05", "text": "見た人みんながそう思う、そしてそれが"}, {"type": "subtitle", "time": 18307.59, "timestamp": "05:05:07", "text": "隠す必要がある、または"}, {"type": "subtitle", "time": 18309.99, "timestamp": "05:05:09", "text": "準備してください。つまり、"}, {"type": "subtitle", "time": 18313.19, "timestamp": "05:05:13", "text": "ダブダブみたいな音が聞こえる。うん。うん。"}, {"type": "subtitle", "time": 18322.75, "timestamp": "05:05:22", "text": "ああ、またしても大声で叫んでしまった。何てことだ。"}, {"type": "subtitle", "time": 18325.35, "timestamp": "05:05:25", "text": "彼女の名前には「ディック」という言葉が入っていることを覚えておいてください。ただ"}, {"type": "subtitle", "time": 18328.15, "timestamp": "05:05:28", "text": "それを見て笑ってください。怖がらないで。はい、私は"}, {"type": "subtitle", "time": 18329.99, "timestamp": "05:05:29", "text": "ちんこ。"}, {"type": "subtitle", "time": 18336.23, "timestamp": "05:05:36", "text": "また、私は待って、見せてください。私にさせて"}, {"type": "subtitle", "time": 18338.31, "timestamp": "05:05:38", "text": "グーグル。 Plasmophobiaはどれくらいの期間狩りをしますか？"}, {"type": "subtitle", "time": 18359.55, "timestamp": "05:05:59", "text": "[音楽]"}]
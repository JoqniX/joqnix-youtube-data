[{"type": "subtitle", "time": 9240.63, "timestamp": "02:34:00", "text": "収穫。"}, {"type": "subtitle", "time": 9243.11, "timestamp": "02:34:03", "text": "わかったよ、父さん。"}, {"type": "subtitle", "time": 9247.51, "timestamp": "02:34:07", "text": "私は持っていません。あ、待って。水が必要です。"}, {"type": "subtitle", "time": 9252.27, "timestamp": "02:34:12", "text": "ああ、くそ。えっと、ちょっと待ってください。私は手に入れた"}, {"type": "subtitle", "time": 9255.03, "timestamp": "02:34:15", "text": "それ。お父さん、あなたはとても遅いよ。"}, {"type": "subtitle", "time": 9258.07, "timestamp": "02:34:18", "text": "待って、このプレミアムって何？"}, {"type": "subtitle", "time": 9261.11, "timestamp": "02:34:21", "text": "うわぁ。うん。うわぁ。お父さん、どうやって"}, {"type": "subtitle", "time": 9262.95, "timestamp": "02:34:22", "text": "これですか？"}, {"type": "subtitle", "time": 9264.389, "timestamp": "02:34:24", "text": "見てみましょう。彼らは追加で受け取るのでしょうか"}, {"type": "subtitle", "time": 9267.83, "timestamp": "02:34:27", "text": "このために？いや、違うよ。これはもっと"}, {"type": "subtitle", "time": 9271.03, "timestamp": "02:34:31", "text": "彼らがそれを高く評価してくれたことは大きな成功だった。"}, {"type": "subtitle", "time": 9274.55, "timestamp": "02:34:34", "text": "ええ、まだまだたくさんありますよ。だから私は"}, {"type": "subtitle", "time": 9276.55, "timestamp": "02:34:36", "text": "私たちはそのようなものを与えることができると考えています"}, {"type": "subtitle", "time": 9278.71, "timestamp": "02:34:38", "text": "サンプルかもしれないし、できると思う"}, {"type": "subtitle", "time": 9280.469, "timestamp": "02:34:40", "text": "それによって価格が高くなる可能性がある"}, {"type": "subtitle", "time": 9282.99, "timestamp": "02:34:42", "text": "良い。よし。私はただ続けるつもりです"}, {"type": "subtitle", "time": 9284.91, "timestamp": "02:34:44", "text": "全ての"}, {"type": "subtitle", "time": 9288.51, "timestamp": "02:34:48", "text": "彼ら。その時が来たのか"}, {"type": "subtitle", "time": 9291.349, "timestamp": "02:34:51", "text": "まだ？あと4時間。"}, {"type": "subtitle", "time": 9295.67, "timestamp": "02:34:55", "text": "オースティンをターゲットにして売りに行くよ"}, {"type": "subtitle", "time": 9299.51, "timestamp": "02:34:59", "text": "オースティンは安い人だ。うん。わかった。待って、"}]
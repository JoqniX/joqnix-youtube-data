[{"type": "subtitle", "time": 7680.149, "timestamp": "02:08:00", "text": "それをやる？彼は客だったかもしれない。"}, {"type": "subtitle", "time": 7687.35, "timestamp": "02:08:07", "text": "バット。ああ、それはドナにあげてもいいよ。"}, {"type": "subtitle", "time": 7690.47, "timestamp": "02:08:10", "text": "オフィスにドーナツがある。ドナはドラッグが好きだ"}, {"type": "subtitle", "time": 7692.95, "timestamp": "02:08:12", "text": "同じように。ええ、でも彼女は頼む必要があります"}, {"type": "subtitle", "time": 7694.79, "timestamp": "02:08:14", "text": "そうですよね？なんてこった。あなたは"}, {"type": "subtitle", "time": 7697.189, "timestamp": "02:08:17", "text": "無料サンプル。ええ、無料サンプルをあげました"}, {"type": "subtitle", "time": 7699.43, "timestamp": "02:08:19", "text": "前に。"}, {"type": "subtitle", "time": 7702.31, "timestamp": "02:08:22", "text": "ああ、ジェスがここにいる。あ、やあ、ジェシー。"}, {"type": "subtitle", "time": 7705.669, "timestamp": "02:08:25", "text": "ジェシー？ジェシー？ああ、それは違う"}, {"type": "subtitle", "time": 7707.669, "timestamp": "02:08:27", "text": "ジェシーみたいな感じ。"}, {"type": "subtitle", "time": 7711.91, "timestamp": "02:08:31", "text": "何？ああ、まさに私のタイプのジェシーだわ。うわぁ。"}, {"type": "subtitle", "time": 7713.43, "timestamp": "02:08:33", "text": "うわぁ。うわぁ。うわぁ。あなたには"}, {"type": "subtitle", "time": 7715.669, "timestamp": "02:08:35", "text": "薬物？あ、待って。 She を持っていますか?"}, {"type": "subtitle", "time": 7718.709, "timestamp": "02:08:38", "text": "みんな、私とは話してくれないよ。彼女は、ねえ、"}, {"type": "subtitle", "time": 7721.43, "timestamp": "02:08:41", "text": "おい。ああ、彼女はそれを見て、"}, {"type": "subtitle", "time": 7724.79, "timestamp": "02:08:44", "text": "「はい、ください」という感じ。"}, {"type": "subtitle", "time": 7728.229, "timestamp": "02:08:48", "text": "やあ、ジェシー。あのクソ野郎。あなたは何者ですか？"}, {"type": "subtitle", "time": 7731.75, "timestamp": "02:08:51", "text": "戻ってくる。いいえ。ねえ。おい。おい。おい、"}, {"type": "subtitle", "time": 7732.83, "timestamp": "02:08:52", "text": "相棒。相棒。"}, {"type": "subtitle", "time": 7737.03, "timestamp": "02:08:57", "text": "相棒。ダウンタウン地域は兄弟に違いない。"}, {"type": "subtitle", "time": 7739.99, "timestamp": "02:08:59", "text": "うん。一部のNPC。ロックを解除する必要があります"}]
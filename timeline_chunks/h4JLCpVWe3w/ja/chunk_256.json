[{"type": "subtitle", "time": 15363.11, "timestamp": "04:16:03", "text": "正直に言うと、私は音を聞いた。"}, {"type": "subtitle", "time": 15366.149, "timestamp": "04:16:06", "text": "音を聞いてください。音が聞こえた。私にさせて"}, {"type": "subtitle", "time": 15368.07, "timestamp": "04:16:08", "text": "見る。どのような活動ですか？ 3つあります"}, {"type": "subtitle", "time": 15370.229, "timestamp": "04:16:10", "text": "活動。はい、彼女はそこにいます。"}, {"type": "subtitle", "time": 15372.469, "timestamp": "04:16:12", "text": "わかった、覚えておいてくれ、必要なのはクソだ"}, {"type": "subtitle", "time": 15375.189, "timestamp": "04:16:15", "text": "写真。それでおしまい。それでおしまい。"}, {"type": "subtitle", "time": 15384.95, "timestamp": "04:16:24", "text": "えっと、ちょっと待って。えっと、ちょっと二階に駆け上がります。"}, {"type": "subtitle", "time": 15386.389, "timestamp": "04:16:26", "text": "右？彼女が狩りを始めるとき。うん、行くよ"}, {"type": "subtitle", "time": 15388.63, "timestamp": "04:16:28", "text": "彼女が狩りを始めるとき。二階へ走って行って"}, {"type": "subtitle", "time": 15390.79, "timestamp": "04:16:30", "text": "部屋に入り、部屋のドアを閉める。する"}, {"type": "subtitle", "time": 15392.55, "timestamp": "04:16:32", "text": "開けないでください、音を立てないでください"}, {"type": "subtitle", "time": 15394.63, "timestamp": "04:16:34", "text": "マイク。 Discordで話すことはできますが、"}, {"type": "subtitle", "time": 15396.71, "timestamp": "04:16:36", "text": "ゲーム内では発生しません。スピリットボックスの電源を切る"}, {"type": "subtitle", "time": 15400.229, "timestamp": "04:16:40", "text": "あまりにも。私はどんなドアでも、どんな部屋でも開けることができます。"}, {"type": "subtitle", "time": 15403.91, "timestamp": "04:16:43", "text": "どの部屋にも入れるんですよね？はい、どうぞ"}, {"type": "subtitle", "time": 15405.75, "timestamp": "04:16:45", "text": "どの部屋でも、あるいは"}, {"type": "subtitle", "time": 15408.63, "timestamp": "04:16:48", "text": "ガレージに入ってロッカーの中に入ってください。待って、"}, {"type": "subtitle", "time": 15410.309, "timestamp": "04:16:50", "text": "明かりが消えた。ライトが点灯した"}, {"type": "subtitle", "time": 15412.309, "timestamp": "04:16:52", "text": "オフ。ドアは閉まる必要がある、"}, {"type": "subtitle", "time": 15414.95, "timestamp": "04:16:54", "text": "右？はい、ドアも"}, {"type": "subtitle", "time": 15417.75, "timestamp": "04:16:57", "text": "閉店しました。"}]
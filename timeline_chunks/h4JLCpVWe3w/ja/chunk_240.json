[{"type": "subtitle", "time": 14401.349, "timestamp": "04:00:01", "text": "一人で。だから、私が行くしかないんです。わかった、"}, {"type": "subtitle", "time": 14402.71, "timestamp": "04:00:02", "text": "これがあなたの配信です。中に入る"}, {"type": "subtitle", "time": 14405.11, "timestamp": "04:00:05", "text": "そして、それが反応なので検索します"}, {"type": "subtitle", "time": 14406.63, "timestamp": "04:00:06", "text": "孤独な人々へ。教えてあげよう"}, {"type": "subtitle", "time": 14409.189, "timestamp": "04:00:09", "text": "総活動量はどれくらいですか。そのため、"}, {"type": "subtitle", "time": 14411.11, "timestamp": "04:00:11", "text": "活動が活発な場合、判断することができます"}, {"type": "subtitle", "time": 14414.229, "timestamp": "04:00:14", "text": "幽霊がいる部屋はどこか。わかった。はい。"}, {"type": "subtitle", "time": 14415.51, "timestamp": "04:00:15", "text": "わかった。そして、"}, {"type": "subtitle", "time": 14417.51, "timestamp": "04:00:17", "text": "もの。幽霊を歩かせよう"}, {"type": "subtitle", "time": 14420.07, "timestamp": "04:00:20", "text": "塩。塩がありません。幽霊を捕まえて"}, {"type": "subtitle", "time": 14421.75, "timestamp": "04:00:21", "text": "ろうそくの火を吹き消す。わかった。持っていない"}, {"type": "subtitle", "time": 14424.07, "timestamp": "04:00:24", "text": "キャンドル。だから、必要なのは写真だけです"}, {"type": "subtitle", "time": 14426.95, "timestamp": "04:00:26", "text": "幽霊。このカメラを持って行ってください。保つ"}, {"type": "subtitle", "time": 14430.15, "timestamp": "04:00:30", "text": "トーチ。わかった。カメラを手に入れた。これを取りなさい"}, {"type": "subtitle", "time": 14432.79, "timestamp": "04:00:32", "text": "このトーチ。この懐中電灯。ああ、わかりました。病気"}, {"type": "subtitle", "time": 14436.87, "timestamp": "04:00:36", "text": "UVランプを落としてください。うん。そして、このビデオを見てください"}, {"type": "subtitle", "time": 14439.83, "timestamp": "04:00:39", "text": "カメラ。ビデオカメラ。わかった。えーと"}, {"type": "subtitle", "time": 14441.99, "timestamp": "04:00:41", "text": "この部屋や"}, {"type": "subtitle", "time": 14444.15, "timestamp": "04:00:44", "text": "この部屋には最も多くの"}, {"type": "subtitle", "time": 14445.91, "timestamp": "04:00:45", "text": "活動の、"}, {"type": "subtitle", "time": 14448.95, "timestamp": "04:00:48", "text": "このカメラをそこに置いて、"}, {"type": "subtitle", "time": 14450.87, "timestamp": "04:00:50", "text": "オーブが存在するかどうかを確認できます。それで"}, {"type": "subtitle", "time": 14453.349, "timestamp": "04:00:53", "text": "私たちは幽霊の種類を判断できる。"}, {"type": "subtitle", "time": 14456.07, "timestamp": "04:00:56", "text": "まず、スピリットボックスとこれ"}, {"type": "subtitle", "time": 14459.269, "timestamp": "04:00:59", "text": "電磁場と懐中電灯。"}]
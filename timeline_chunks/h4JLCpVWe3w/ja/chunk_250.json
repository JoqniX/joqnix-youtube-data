[{"type": "subtitle", "time": 15000.63, "timestamp": "04:10:00", "text": "活動なし。ゼロ。あなたはできる あなたはできる"}, {"type": "subtitle", "time": 15003.349, "timestamp": "04:10:03", "text": "落ち着いた。活動なし。あ、そういえば、クリック"}, {"type": "subtitle", "time": 15006.71, "timestamp": "04:10:06", "text": "車。車をクリックしてください。車"}, {"type": "subtitle", "time": 15011.75, "timestamp": "04:10:11", "text": "あなたの後ろに。うん。えっと、いいえ、ただ"}, {"type": "subtitle", "time": 15014.389, "timestamp": "04:10:14", "text": "マウスでクリックしてください。そうですか"}, {"type": "subtitle", "time": 15018.469, "timestamp": "04:10:18", "text": "音を立てる？いいえ。ああ、わかりました。どうでも。"}, {"type": "subtitle", "time": 15019.91, "timestamp": "04:10:19", "text": "前回やった時は車が"}, {"type": "subtitle", "time": 15021.67, "timestamp": "04:10:21", "text": "音がして、彼は"}, {"type": "subtitle", "time": 15031.189, "timestamp": "04:10:31", "text": "できるなら、物を投げてみてください。私"}, {"type": "subtitle", "time": 15032.87, "timestamp": "04:10:32", "text": "やり方がわからない。ミッチだけ"}, {"type": "subtitle", "time": 15034.309, "timestamp": "04:10:34", "text": "知っている。だから私は彼に頼んだのです"}, {"type": "subtitle", "time": 15036.07, "timestamp": "04:10:36", "text": "止まってぐるっと回る。"}, {"type": "subtitle", "time": 15038.71, "timestamp": "04:10:38", "text": "彼はどうやってそれを成し遂げたのだろうか？"}, {"type": "subtitle", "time": 15040.79, "timestamp": "04:10:40", "text": "Eキーを押してください。"}, {"type": "subtitle", "time": 15044.15, "timestamp": "04:10:44", "text": "Eキーを押しても効果はありません。"}, {"type": "subtitle", "time": 15048.79, "timestamp": "04:10:48", "text": "えっと、カップのところへ行ってください。 Eキーを押してください。E、何も起こりません。"}, {"type": "subtitle", "time": 15051.67, "timestamp": "04:10:51", "text": "起こる。わかった。"}, {"type": "subtitle", "time": 15054.63, "timestamp": "04:10:54", "text": "彼はどうやってそれを成し遂げたのか？"}, {"type": "subtitle", "time": 15058.11, "timestamp": "04:10:58", "text": "もう一度そのホールに行って、E を試してみてください。"}]
[{"type": "subtitle", "time": 6480.629, "timestamp": "01:48:00", "text": "朝。よし、いいね。すべてを保持します"}, {"type": "subtitle", "time": 6483.03, "timestamp": "01:48:03", "text": "はい、在庫品はそのままにしておいてください"}, {"type": "subtitle", "time": 6485.75, "timestamp": "01:48:05", "text": "そこには。さあ、ピーター。それは良い"}, {"type": "subtitle", "time": 6487.669, "timestamp": "01:48:07", "text": "もの。うん。よし。ニース。ピーターの"}, {"type": "subtitle", "time": 6490.55, "timestamp": "01:48:10", "text": "私たち。さあ行こう。"}, {"type": "subtitle", "time": 6494.55, "timestamp": "01:48:14", "text": "中にいるのは誰？ドアを開けてください。くたばれ。"}, {"type": "subtitle", "time": 6497.79, "timestamp": "01:48:17", "text": "ドアを開けてください。あ、やあ、ジェシー。どうやって"}, {"type": "subtitle", "time": 6499.55, "timestamp": "01:48:19", "text": "何をしているの？私は"}, {"type": "subtitle", "time": 6501.83, "timestamp": "01:48:21", "text": "良い。何？"}, {"type": "subtitle", "time": 6505.75, "timestamp": "01:48:25", "text": "何？ホワイトさん、私は行きます。"}, {"type": "subtitle", "time": 6509.51, "timestamp": "01:48:29", "text": "なんだか居心地が悪い。"}, {"type": "chat", "time": 6510.339, "timestamp": "01:48:30", "author": "@everestfujich", "avatar": "https://yt4.ggpht.com/cGf4x80kyXWdAQCEpiCAT1VX7LnsLDD0GjZXaK-xsp1-Ky9Av7IrQcFxwWsVy873fVtPRn54UQ=s64-c-k-c0x00ffffff-no-rj", "message": "oh its the 'substance' business game "}, {"type": "subtitle", "time": 6512.91, "timestamp": "01:48:32", "text": "何？[ __ ]、"}, {"type": "subtitle", "time": 6517.03, "timestamp": "01:48:37", "text": "[ __ ]。今、私に文句を言ったの？"}, {"type": "subtitle", "time": 6518.709, "timestamp": "01:48:38", "text": "B."}, {"type": "subtitle", "time": 6522.39, "timestamp": "01:48:42", "text": "はい。では、金属加工ラボはどこにあるのでしょうか？"}, {"type": "subtitle", "time": 6524.79, "timestamp": "01:48:44", "text": "どうなるの？私のゲーム。つまり、いや、それは"}, {"type": "subtitle", "time": 6527.43, "timestamp": "01:48:47", "text": "クラッシュしなかった。それは凍りついた。それはそれは"}, {"type": "subtitle", "time": 6530.109, "timestamp": "01:48:50", "text": "凍りついた。あなたは時々、凍りついていましたね。"}, {"type": "subtitle", "time": 6535.51, "timestamp": "01:48:55", "text": "ああ、毎週火曜日にゲームがクラッシュするんだよ、兄弟。"}, {"type": "subtitle", "time": 6537.91, "timestamp": "01:48:57", "text": "まず金物店に行かなければならない。"}]
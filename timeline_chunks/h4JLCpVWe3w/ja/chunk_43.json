[{"type": "subtitle", "time": 2592.109, "timestamp": "00:43:12", "text": "迅速な配送。あ、余剰資金ができたよ。"}, {"type": "subtitle", "time": 2594.75, "timestamp": "00:43:14", "text": "ニース。私は赤い"}, {"type": "subtitle", "time": 2603.19, "timestamp": "00:43:23", "text": "ハッピー。えっと、雑草が静かになってきています"}, {"type": "subtitle", "time": 2605.51, "timestamp": "00:43:25", "text": "成長している。"}, {"type": "subtitle", "time": 2608.309, "timestamp": "00:43:28", "text": "大丈夫ですか？体が乾いてしまって。時間がかかります"}, {"type": "subtitle", "time": 2610.51, "timestamp": "00:43:30", "text": "時間。それは"}, {"type": "subtitle", "time": 2635.19, "timestamp": "00:43:55", "text": "じゃあ、いい感じ？私たちはたくさん稼いだ。"}]
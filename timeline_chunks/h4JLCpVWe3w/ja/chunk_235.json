[{"type": "subtitle", "time": 14100.79, "timestamp": "03:55:00", "text": "証拠。わかった。日記と証拠。"}, {"type": "subtitle", "time": 14105.429, "timestamp": "03:55:05", "text": "わかった。だから、幽霊をやらなきゃいけないんだよね？"}, {"type": "subtitle", "time": 14108.15, "timestamp": "03:55:08", "text": "幽霊、スピリットボックス、氷点下の気温。"}, {"type": "subtitle", "time": 14111.349, "timestamp": "03:55:11", "text": "氷点下の気温。わかった。それで、えーと"}, {"type": "subtitle", "time": 14115.75, "timestamp": "03:55:15", "text": "リオには幽霊がいる。はい。はい。選択"}, {"type": "subtitle", "time": 14119.229, "timestamp": "03:55:19", "text": "それ。わかった。それでは、ここを出ましょう。"}, {"type": "subtitle", "time": 14122.429, "timestamp": "03:55:22", "text": "わかった。私たちは"}, {"type": "subtitle", "time": 14125.67, "timestamp": "03:55:25", "text": "これは残しておいて。右。待って。上にあります"}, {"type": "subtitle", "time": 14154.71, "timestamp": "03:55:54", "text": "ニース。ああ、それでポイントがもらえるんだ"}, {"type": "subtitle", "time": 14157.75, "timestamp": "03:55:57", "text": "幽霊を推測したりとか。はい。はい、"}]
[{"type": "subtitle", "time": 16440.31, "timestamp": "04:34:00", "text": "わかった。彼女は二階へ上がった。"}, {"type": "subtitle", "time": 16443.109, "timestamp": "04:34:03", "text": "これがオボだと思う。これはOBOのようなものだ。"}, {"type": "subtitle", "time": 16445.67, "timestamp": "04:34:05", "text": "その通り。"}, {"type": "subtitle", "time": 16453.189, "timestamp": "04:34:13", "text": "私を殺さないで。オボ、私を殺さないで。私"}, {"type": "subtitle", "time": 16457.189, "timestamp": "04:34:17", "text": "失礼しました。しないでください"}, {"type": "subtitle", "time": 16460.23, "timestamp": "04:34:20", "text": "ある意味では。私はちょっと"}, {"type": "subtitle", "time": 16462.07, "timestamp": "04:34:22", "text": "エドワード、調子はどう？調子はどうですか"}, {"type": "subtitle", "time": 16465.75, "timestamp": "04:34:25", "text": "あなた？お久しぶりです。彼は再び出現した。"}, {"type": "subtitle", "time": 16468.869, "timestamp": "04:34:28", "text": "彼女が再び出現したってどういう意味ですか？"}, {"type": "subtitle", "time": 16471.51, "timestamp": "04:34:31", "text": "何てことだ。彼女はただやっているだけです 彼女はただ"}, {"type": "subtitle", "time": 16473.429, "timestamp": "04:34:33", "text": "ドラゴンボールZの瞬間移動をやってみて"}, {"type": "subtitle", "time": 16476.07, "timestamp": "04:34:36", "text": "もの。本物みたいにしてほしい"}, {"type": "subtitle", "time": 16480.31, "timestamp": "04:34:40", "text": "ゴーストモデルですが、これも有効です。"}, {"type": "subtitle", "time": 16483.551, "timestamp": "04:34:43", "text": "彼女はここにいますか？"}, {"type": "subtitle", "time": 16486.39, "timestamp": "04:34:46", "text": "ああ、彼女はあなたの後ろにスポーンしました。彼女"}, {"type": "subtitle", "time": 16488.789, "timestamp": "04:34:48", "text": "あなたの後ろのテーブルに出現しました"}, {"type": "subtitle", "time": 16491.109, "timestamp": "04:34:51", "text": "後ろに。わかった。うん。ああ、彼女はそこにいる"}, {"type": "subtitle", "time": 16492.39, "timestamp": "04:34:52", "text": "そこでスポーンした。彼女がどこにいるのか分からない"}, {"type": "subtitle", "time": 16494.59, "timestamp": "04:34:54", "text": "行った。"}, {"type": "subtitle", "time": 16497.109, "timestamp": "04:34:57", "text": "何？ある意味、私はあなたに好きになってほしかった"}, {"type": "subtitle", "time": 16499.349, "timestamp": "04:34:59", "text": "彼女が上がるときですよね？私は思った"}]
[{"type": "subtitle", "time": 15721.59, "timestamp": "04:22:01", "text": "温度、"}, {"type": "subtitle", "time": 15730.07, "timestamp": "04:22:10", "text": "いいえ。照明がちらつきましたか？"}, {"type": "subtitle", "time": 15736.63, "timestamp": "04:22:16", "text": "いや、違うよ。わかった。死んだ。活動なし。ゼロ。"}, {"type": "subtitle", "time": 15739.67, "timestamp": "04:22:19", "text": "彼女は引っ越したの？えっと、"}, {"type": "subtitle", "time": 15741.389, "timestamp": "04:22:21", "text": "メインをチェック"}, {"type": "subtitle", "time": 15743.229, "timestamp": "04:22:23", "text": "ホール。"}, {"type": "subtitle", "time": 15760.469, "timestamp": "04:22:40", "text": "ルース、ちょっと待って。ちょっと待って。私"}, {"type": "subtitle", "time": 15778.87, "timestamp": "04:22:58", "text": "ああ、照明がちらついている。ああ、"}]
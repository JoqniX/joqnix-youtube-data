[{"type": "subtitle", "time": 15.589, "timestamp": "00:00:15", "text": "こんにちは。生放送中ですか？はい、そうです。ようこそ"}, {"type": "subtitle", "time": 18.91, "timestamp": "00:00:18", "text": "パート2 日の流れ"}, {"type": "subtitle", "time": 21.51, "timestamp": "00:00:21", "text": "33、夜の流れ。ええ、私は"}, {"type": "subtitle", "time": 24.75, "timestamp": "00:00:24", "text": "早く寝る。そうだといい。私は祈ります"}, {"type": "subtitle", "time": 28.15, "timestamp": "00:00:28", "text": "それで。さらに、私たちはこれまで"}, {"type": "subtitle", "time": 30.83, "timestamp": "00:00:30", "text": "このゲームは大きく進歩した。それはとても"}, {"type": "subtitle", "time": 36.03, "timestamp": "00:00:36", "text": "楽しくて中毒性もある"}, {"type": "subtitle", "time": 38.19, "timestamp": "00:00:38", "text": "良い。"}, {"type": "subtitle", "time": 41.869, "timestamp": "00:00:41", "text": "うん、中毒性があるし"}, {"type": "subtitle", "time": 45.63, "timestamp": "00:00:45", "text": "楽しい。そして良い"}, {"type": "subtitle", "time": 49.11, "timestamp": "00:00:49", "text": "良い。問題は、私が眠すぎるということです。"}, {"type": "subtitle", "time": 53.029, "timestamp": "00:00:53", "text": "今。酔って寝すぎた。私の体は"}, {"type": "subtitle", "time": 55.709, "timestamp": "00:00:55", "text": "疲れた。気を失いそうになる"}, {"type": "subtitle", "time": 58.31, "timestamp": "00:00:58", "text": "一瞬。でも友達も遊んでるよ"}]
[{"type": "subtitle", "time": 14881.03, "timestamp": "04:08:01", "text": "盲目になるだろう、なぜなら彼はおそらく"}, {"type": "subtitle", "time": 14884.269, "timestamp": "04:08:04", "text": "電気を消した。そうそう。うん。"}, {"type": "subtitle", "time": 14886.76, "timestamp": "04:08:06", "text": "うん。 失礼。出てくる。出てくる。話せますか？"}, {"type": "subtitle", "time": 14889.76, "timestamp": "04:08:09", "text": "失礼。出てくる。出てくる。話せますか？ 私にとって？近づく必要がある"}, {"type": "subtitle", "time": 14892.239, "timestamp": "04:08:12", "text": "私にとって？近づく必要がある 彼にとって、それ以外のことはあり得ない。ああ、わかりました。根"}, {"type": "subtitle", "time": 14900.95, "timestamp": "04:08:20", "text": "チャラ根。わかった。 1つあります"}, {"type": "subtitle", "time": 14911.189, "timestamp": "04:08:31", "text": "わかった。ルース、聞こえる？"}, {"type": "subtitle", "time": 14914.87, "timestamp": "04:08:34", "text": "近づかなければならない。私は怖いです。知っている"}, {"type": "subtitle", "time": 14917.429, "timestamp": "04:08:37", "text": "あなたは怖がっているけれど、私にはどうすることもできない。それは"}, {"type": "subtitle", "time": 14919.99, "timestamp": "04:08:39", "text": "私たち二人だけ。"}, {"type": "subtitle", "time": 14923.59, "timestamp": "04:08:43", "text": "ルート、どこにいるの？はい、あります"}, {"type": "subtitle", "time": 14925.189, "timestamp": "04:08:45", "text": "三つ。行け、行け、そのまま進み続けろ。三つ"}, {"type": "subtitle", "time": 14927.51, "timestamp": "04:08:47", "text": "そこでの活動のみ。明かりをつけてください。"}, {"type": "subtitle", "time": 14930.83, "timestamp": "04:08:50", "text": "廊下の電気をつけてください。"}, {"type": "subtitle", "time": 14936.87, "timestamp": "04:08:56", "text": "ああ、えっと、彼は言ったとか、そういう言い方をするんですか？"}, {"type": "subtitle", "time": 14938.71, "timestamp": "04:08:58", "text": "何？"}]
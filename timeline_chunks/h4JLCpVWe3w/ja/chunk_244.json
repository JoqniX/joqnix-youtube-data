[{"type": "subtitle", "time": 14642.15, "timestamp": "04:04:02", "text": "証拠のようなジャーナル、たぶん"}, {"type": "subtitle", "time": 14643.91, "timestamp": "04:04:03", "text": "レベルアップしていることが認識されない"}, {"type": "subtitle", "time": 14645.59, "timestamp": "04:04:05", "text": "上またはある程度またはそれ以上ロック解除しない"}, {"type": "subtitle", "time": 14650.07, "timestamp": "04:04:10", "text": "地図。ああ、わかりました。ルース・エヴァリー、"}, {"type": "subtitle", "time": 14652.389, "timestamp": "04:04:12", "text": "サイン。ルース・エヴァリー、あなたはどこにいるの？与える"}, {"type": "subtitle", "time": 14655.429, "timestamp": "04:04:15", "text": "それは私たちに何かの兆候を与えてくれる。そうそう。私をミュートすることはできません。"}, {"type": "subtitle", "time": 14657.99, "timestamp": "04:04:17", "text": "ルース、君のソファでうんこするよ。"}, {"type": "subtitle", "time": 14667.91, "timestamp": "04:04:27", "text": "何か兆候を見せてください。"}, {"type": "subtitle", "time": 14673.03, "timestamp": "04:04:33", "text": "この猫はあなたの猫ですか？この猫はあなたの猫ですか？そのような"}, {"type": "subtitle", "time": 14677.51, "timestamp": "04:04:37", "text": "「お前の猫を殺してやる、ルース」という愚かな猫。"}, {"type": "subtitle", "time": 14680.71, "timestamp": "04:04:40", "text": "猫を殺せ。はい、あなたの猫を殺します。"}, {"type": "subtitle", "time": 14683.83, "timestamp": "04:04:43", "text": "おお。おお。"}, {"type": "subtitle", "time": 14685.75, "timestamp": "04:04:45", "text": "あれはあなただったの？"}, {"type": "subtitle", "time": 14687.59, "timestamp": "04:04:47", "text": "何？私はドアを開けていた。あなたは"}, {"type": "subtitle", "time": 14689.99, "timestamp": "04:04:49", "text": "ドアを開ける？ああ、あなたがドアを開けるんだ。"}, {"type": "subtitle", "time": 14693.189, "timestamp": "04:04:53", "text": "わかった。わかった。うん。うん。ルース、私は殺す"}, {"type": "subtitle", "time": 14695.349, "timestamp": "04:04:55", "text": "あなたの猫たち、なぜなら私が唯一の優位者だから"}, {"type": "subtitle", "time": 14698.309, "timestamp": "04:04:58", "text": "猫がここにいます。ルース、そう、私の方が優れている"}]
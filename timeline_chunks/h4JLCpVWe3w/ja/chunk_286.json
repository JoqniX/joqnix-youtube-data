[{"type": "subtitle", "time": 17160.39, "timestamp": "04:46:00", "text": "文字は半径内に入り"}, {"type": "subtitle", "time": 17162.868, "timestamp": "04:46:02", "text": "死体を拾うために、"}, {"type": "subtitle", "time": 17165.19, "timestamp": "04:46:05", "text": "その素材の特徴を捉える。"}, {"type": "subtitle", "time": 17167.35, "timestamp": "04:46:07", "text": "だから同じだった"}, {"type": "subtitle", "time": 17170.15, "timestamp": "04:46:10", "text": "体から上へ、そして体から出るようなパターン。"}, {"type": "subtitle", "time": 17172.788, "timestamp": "04:46:12", "text": "だから私が中に入るとすぐに"}, {"type": "subtitle", "time": 17175.75, "timestamp": "04:46:15", "text": "あなたの体の半径で、それが私を検知し、"}, {"type": "subtitle", "time": 17179.67, "timestamp": "04:46:19", "text": "私に向かってきた。わかった。わかった。わかった。どれほど壊れているか"}, {"type": "subtitle", "time": 17184.31, "timestamp": "04:46:24", "text": "これはゲームですか？うん。奇妙なバグですね。"}, {"type": "subtitle", "time": 17187.83, "timestamp": "04:46:27", "text": "ゴーストタイプはMです。わかりました。おお。あなたは"}, {"type": "subtitle", "time": 17189.43, "timestamp": "04:46:29", "text": "もっと遊びたいですか、それとも"}, {"type": "subtitle", "time": 17192.948, "timestamp": "04:46:32", "text": "あなた？もう限界だ。もっと遊べるよ。"}, {"type": "subtitle", "time": 17195.43, "timestamp": "04:46:35", "text": "どれくらい時間がかかりますか？どうやってそこに着きますか？"}, {"type": "subtitle", "time": 17199.59, "timestamp": "04:46:39", "text": "えっと、211番ですよね？だから私は"}, {"type": "subtitle", "time": 17204.03, "timestamp": "04:46:44", "text": "最大3つまで。三つ。わかった。"}, {"type": "subtitle", "time": 17212.23, "timestamp": "04:46:52", "text": "わかった。えっと"}, {"type": "subtitle", "time": 17214.43, "timestamp": "04:46:54", "text": "2つの新しい"}, {"type": "subtitle", "time": 17216.59, "timestamp": "04:46:56", "text": "場所。そこには"}]
[{"type": "subtitle", "time": 12241.83, "timestamp": "03:24:01", "text": "電磁界。どうでしたか？"}, {"type": "subtitle", "time": 12245.269, "timestamp": "03:24:05", "text": "彼女はどこにいるの？ああ、彼女は階段にいる。"}, {"type": "subtitle", "time": 12246.79, "timestamp": "03:24:06", "text": "階段の一番上まで来たところで、"}, {"type": "subtitle", "time": 12248.469, "timestamp": "03:24:08", "text": "おそらく。"}, {"type": "subtitle", "time": 12250.229, "timestamp": "03:24:10", "text": "おお、"}, {"type": "subtitle", "time": 12252.63, "timestamp": "03:24:12", "text": "あなたは絶対に行かなければならない。あ、待って。ええ、そうしました"}, {"type": "subtitle", "time": 12256.15, "timestamp": "03:24:16", "text": "それを受け取らない。待って、私が受け取ってあげる。 1つ"}, {"type": "subtitle", "time": 12266.55, "timestamp": "03:24:26", "text": "わかった。わかった。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 12269.269, "timestamp": "03:24:29", "text": "ああ、君はトーチを持っていたんだね。うん、うん、うん。"}, {"type": "subtitle", "time": 12271.429, "timestamp": "03:24:31", "text": "私はそう考えた。"}, {"type": "subtitle", "time": 12274.309, "timestamp": "03:24:34", "text": "わかった。わかった。えっと、あなたが見るたびに"}, {"type": "subtitle", "time": 12283.51, "timestamp": "03:24:43", "text": "幽霊を見たら、"}, {"type": "subtitle", "time": 12285.349, "timestamp": "03:24:45", "text": "もし私のEMFが聞こえないなら、"}, {"type": "subtitle", "time": 12287.67, "timestamp": "03:24:47", "text": "その部分を洗浄するだけです。"}, {"type": "subtitle", "time": 12290.469, "timestamp": "03:24:50", "text": "それ。わかった。しかし、このライトを使うと、"}, {"type": "subtitle", "time": 12292.229, "timestamp": "03:24:52", "text": "右？"}]
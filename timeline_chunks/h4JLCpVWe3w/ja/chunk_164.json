[{"type": "subtitle", "time": 9845.83, "timestamp": "02:44:05", "text": "地獄。他にどんな特典がありますか？混合"}, {"type": "subtitle", "time": 9855.19, "timestamp": "02:44:15", "text": "この件については、ここまでにしておきましょう。全て"}, {"type": "subtitle", "time": 9857.389, "timestamp": "02:44:17", "text": "そう、私たちは買った"}, {"type": "subtitle", "time": 9859.79, "timestamp": "02:44:19", "text": "それ。ここに必要なものは全て揃っていますか？"}, {"type": "subtitle", "time": 9868.389, "timestamp": "02:44:28", "text": "もの。私たちは新しい製品を作ります"}, {"type": "subtitle", "time": 9871.11, "timestamp": "02:44:31", "text": "そして、ああ、わかりました。私は到達したい"}, {"type": "subtitle", "time": 9879.71, "timestamp": "02:44:39", "text": "よし、では見てみよう。荷造りの方法は？"}, {"type": "subtitle", "time": 9882.63, "timestamp": "02:44:42", "text": "もう？ベッドは外に置くべきですか？"}, {"type": "subtitle", "time": 9884.67, "timestamp": "02:44:44", "text": "ああ、混ぜるのに十分な量がない。"}, {"type": "subtitle", "time": 9893.83, "timestamp": "02:44:53", "text": "私は164個持っています。"}, {"type": "subtitle", "time": 9896.469, "timestamp": "02:44:56", "text": "ああ、足りなくなるだろう。私たちは私たちは"}, {"type": "subtitle", "time": 9899.99, "timestamp": "02:44:59", "text": "十分あります。いくらですか？"}]
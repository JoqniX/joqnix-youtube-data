[{"type": "subtitle", "time": 10501.429, "timestamp": "02:55:01", "text": "くそ。待って"}, {"type": "subtitle", "time": 10505.15, "timestamp": "02:55:05", "text": "我々はちょうどそれを買った。いや、いや、我々はそうだ。"}, {"type": "subtitle", "time": 10507.87, "timestamp": "02:55:07", "text": "いいえ、それはただ"}, {"type": "subtitle", "time": 10510.87, "timestamp": "02:55:10", "text": "えっと、私たちは以前借りていた物件を買ったわけではありません"}, {"type": "subtitle", "time": 10512.55, "timestamp": "02:55:12", "text": "私たちは節約しました。だから、大丈夫です。大丈夫です。ああ、"}, {"type": "subtitle", "time": 10514.63, "timestamp": "02:55:14", "text": "わかった。大丈夫。大丈夫。私たちはまだ"}, {"type": "subtitle", "time": 10516.15, "timestamp": "02:55:16", "text": "お金はあるから、買えばいい"}, {"type": "subtitle", "time": 10519.11, "timestamp": "02:55:19", "text": "次回。"}, {"type": "subtitle", "time": 10523.03, "timestamp": "02:55:23", "text": "うん。大丈夫。よし、チャットしよう。私は"}, {"type": "subtitle", "time": 10526.35, "timestamp": "02:55:26", "text": "終わらせるつもりだ。"}, {"type": "subtitle", "time": 10529.19, "timestamp": "02:55:29", "text": "[音楽]"}, {"type": "subtitle", "time": 10530.95, "timestamp": "02:55:30", "text": "しばらく配信していませんでした。"}, {"type": "subtitle", "time": 10536.95, "timestamp": "02:55:36", "text": "[音楽]"}, {"type": "subtitle", "time": 10539.67, "timestamp": "02:55:39", "text": "また時間ができた。また配信します。"}, {"type": "subtitle", "time": 10541.11, "timestamp": "02:55:41", "text": "ジョー、君はどう？あなたはまだ"}, {"type": "subtitle", "time": 10544.389, "timestamp": "02:55:44", "text": "ストリーミング配信。はい。寝ます。実は、"}, {"type": "subtitle", "time": 10546.23, "timestamp": "02:55:46", "text": "水をかけます。寝る。私は思った"}, {"type": "subtitle", "time": 10547.99, "timestamp": "02:55:47", "text": "あなたはこう言おうとしていました"}, {"type": "subtitle", "time": 10550.63, "timestamp": "02:55:50", "text": "ストリーミングを続けてください。"}, {"type": "subtitle", "time": 10553.91, "timestamp": "02:55:53", "text": "この男は誓う"}, {"type": "subtitle", "time": 10557.59, "timestamp": "02:55:57", "text": "仕事が辞めるなら、ジョックストリーム"}, {"type": "subtitle", "time": 10559.91, "timestamp": "02:55:59", "text": "ライブ。"}]
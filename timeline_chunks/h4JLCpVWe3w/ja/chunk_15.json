[{"type": "subtitle", "time": 901.389, "timestamp": "00:15:01", "text": "それ。"}, {"type": "subtitle", "time": 905.95, "timestamp": "00:15:05", "text": "えっと、それで、私は一体何をしていたんだっけ？私"}, {"type": "subtitle", "time": 912.43, "timestamp": "00:15:12", "text": "忘れた。"}, {"type": "subtitle", "time": 914.71, "timestamp": "00:15:14", "text": "ここのすべては良いです。"}, {"type": "subtitle", "time": 920.47, "timestamp": "00:15:20", "text": "従業員の一部が立ち往生している。私にさせて"}, {"type": "subtitle", "time": 921.949, "timestamp": "00:15:21", "text": "保存"}, {"type": "subtitle", "time": 925.99, "timestamp": "00:15:25", "text": "ゲーム。少しお待ちください。動き回ってください。多分"}, {"type": "subtitle", "time": 936.189, "timestamp": "00:15:36", "text": "海。私は"}]
[{"type": "subtitle", "time": 5823.91, "timestamp": "01:37:03", "text": "そうだよ、男。あなたは何を失いましたか？鍋と"}, {"type": "subtitle", "time": 5825.91, "timestamp": "01:37:05", "text": "の"}, {"type": "subtitle", "time": 5830.39, "timestamp": "01:37:10", "text": "ライトと拡張と"}, {"type": "subtitle", "time": 5833.83, "timestamp": "01:37:13", "text": "戻る。ああ、ちくしょう。"}, {"type": "subtitle", "time": 5836.07, "timestamp": "01:37:16", "text": "私はゲームのせいだと思った。切断されました"}, {"type": "subtitle", "time": 5842.47, "timestamp": "01:37:22", "text": "地図を開いてください。はい、地図を開いてください。どうやって"}, {"type": "subtitle", "time": 5845.35, "timestamp": "01:37:25", "text": "ああ、くそ。開けるんだ。ええ、その通りです"}, {"type": "subtitle", "time": 5847.91, "timestamp": "01:37:27", "text": "ブラックホール。"}, {"type": "subtitle", "time": 5853.83, "timestamp": "01:37:33", "text": "地図。ブラックホールはどこにあるの？えっと、それは"}, {"type": "subtitle", "time": 5855.99, "timestamp": "01:37:35", "text": "なんだかすごく色褪せている感じ。小さな"}, {"type": "subtitle", "time": 5858.95, "timestamp": "01:37:38", "text": "ブラックホール。小さな点。そうそう。うん。"}, {"type": "subtitle", "time": 5863.99, "timestamp": "01:37:43", "text": "うん。あれが隠し場所だ。そこが"}, {"type": "subtitle", "time": 5867.229, "timestamp": "01:37:47", "text": "待って。地図をもう一度。おお、"}, {"type": "subtitle", "time": 5871.669, "timestamp": "01:37:51", "text": "わかった。待って。上部のGPSに従ってください。"}, {"type": "subtitle", "time": 5874.55, "timestamp": "01:37:54", "text": "ええ、私たちの上にあるGPSは"}, {"type": "subtitle", "time": 5876.47, "timestamp": "01:37:56", "text": "コンパス。"}]
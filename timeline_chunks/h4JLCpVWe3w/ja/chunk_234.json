[{"type": "subtitle", "time": 14040.87, "timestamp": "03:54:00", "text": "ああ、今の見た？彼は投げた"}, {"type": "subtitle", "time": 14050.269, "timestamp": "03:54:10", "text": "それ"}, {"type": "subtitle", "time": 14054.15, "timestamp": "03:54:14", "text": "えっと、本をテーブルの上に置いてください。"}, {"type": "subtitle", "time": 14057.51, "timestamp": "03:54:17", "text": "ああ、あそこのテーブルだよ。"}, {"type": "subtitle", "time": 14062.15, "timestamp": "03:54:22", "text": "ああ、球体を見たよ。ああ、君は死んだんだね。"}, {"type": "subtitle", "time": 14068.55, "timestamp": "03:54:28", "text": "ああ、これは不具合だ。何かが起こっているように感じます。"}, {"type": "subtitle", "time": 14076.309, "timestamp": "03:54:36", "text": "確かに球体を見た。"}, {"type": "subtitle", "time": 14079.07, "timestamp": "03:54:39", "text": "さあ行こう。私たちはそれを完了しました"}, {"type": "subtitle", "time": 14082.63, "timestamp": "03:54:42", "text": "くそっ。あなたが選んだ仕事ですか？えっと、それは"}, {"type": "subtitle", "time": 14084.229, "timestamp": "03:54:44", "text": "1つ？待って、もし私が死んだら、私は"}, {"type": "subtitle", "time": 14087.349, "timestamp": "03:54:47", "text": "ポイントを獲得する。何？"}, {"type": "subtitle", "time": 14090.389, "timestamp": "03:54:50", "text": "ジョック。うん。うん。うん。もし私があなたに"}, {"type": "subtitle", "time": 14093.429, "timestamp": "03:54:53", "text": "証拠を追加しましたか？"}, {"type": "subtitle", "time": 14096.15, "timestamp": "03:54:56", "text": "いや、違うよ。待って。どうすればいいのですか？"}]
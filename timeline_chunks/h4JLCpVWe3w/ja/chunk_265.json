[{"type": "subtitle", "time": 15901.269, "timestamp": "04:25:01", "text": "私はそこにいます。私はそこにいます。これはまだ"}, {"type": "subtitle", "time": 15903.189, "timestamp": "04:25:03", "text": "狩猟。"}, {"type": "subtitle", "time": 15904.63, "timestamp": "04:25:04", "text": "では、どこへ行くのか？うん。うん。そこへ行ってみなさい。行く"}, {"type": "subtitle", "time": 15906.87, "timestamp": "04:25:06", "text": "そこには。そこへ行ってみなさい。そこへ行ってみなさい。続けてください"}, {"type": "subtitle", "time": 15908.07, "timestamp": "04:25:08", "text": "右。"}, {"type": "subtitle", "time": 15909.75, "timestamp": "04:25:09", "text": "わかった。"}, {"type": "subtitle", "time": 15912.55, "timestamp": "04:25:12", "text": "いいえ、右側には出ないでください。えっと、"}, {"type": "subtitle", "time": 15915.11, "timestamp": "04:25:15", "text": "左。右。わかった。右。いいえ。ええ。"}, {"type": "subtitle", "time": 15917.429, "timestamp": "04:25:17", "text": "真っ直ぐ。真っ直ぐ。真っ直ぐ。真っ直ぐ。"}, {"type": "subtitle", "time": 15919.429, "timestamp": "04:25:19", "text": "わかった。真っ直ぐ。ここでは違う。左。"}, {"type": "subtitle", "time": 15921.269, "timestamp": "04:25:21", "text": "真っ直ぐ。"}, {"type": "subtitle", "time": 15924.63, "timestamp": "04:25:24", "text": "どの部屋ですか？どの部屋ですか？えっと、戻ってきてください。"}, {"type": "subtitle", "time": 15926.75, "timestamp": "04:25:26", "text": "右。わかった。"}, {"type": "subtitle", "time": 15929.67, "timestamp": "04:25:29", "text": "真っ直ぐ。その通り。正面の部屋で。"}, {"type": "subtitle", "time": 15933.349, "timestamp": "04:25:33", "text": "正面の部屋。居間。わかった。えっと、"}, {"type": "subtitle", "time": 15934.75, "timestamp": "04:25:34", "text": "うん。真っ直ぐ。真っ直ぐ進んで下さい。行く"}, {"type": "subtitle", "time": 15940.389, "timestamp": "04:25:40", "text": "真っ直ぐ。あなたの配信を見ています。わかった。"}, {"type": "subtitle", "time": 15944.07, "timestamp": "04:25:44", "text": "ここまでずっと歩いてきたの？いいえ。行け行け"}, {"type": "subtitle", "time": 15945.99, "timestamp": "04:25:45", "text": "うん、いいよ。真っ直ぐ。まっすぐに"}, {"type": "subtitle", "time": 15947.99, "timestamp": "04:25:47", "text": "そこへ行けば、隅っこに私がいるはずです。"}, {"type": "subtitle", "time": 15950.59, "timestamp": "04:25:50", "text": "いいえ、戻ってはいけません。"}, {"type": "subtitle", "time": 15954.469, "timestamp": "04:25:54", "text": "わかった。おお。そうそう。あなたはここにいます。"}, {"type": "subtitle", "time": 15958.63, "timestamp": "04:25:58", "text": "うん。何てことだ。"}]
[{"type": "subtitle", "time": 4383.83, "timestamp": "01:13:03", "text": "ああ、みんな、私。 Forzaがあります"}, {"type": "subtitle", "time": 4391.43, "timestamp": "01:13:11", "text": "たった一人の人間がこれを作ったなんて信じられない"}, {"type": "subtitle", "time": 4397.43, "timestamp": "01:13:17", "text": "ゲーム。ああ、そうだね。ああ、それは狂気だ。"}, {"type": "subtitle", "time": 4400.63, "timestamp": "01:13:20", "text": "右？うん。"}, {"type": "subtitle", "time": 4402.229, "timestamp": "01:13:22", "text": "彼らは恐らく億万長者だろう"}, {"type": "subtitle", "time": 4405.03, "timestamp": "01:13:25", "text": "今。何てことだ。"}, {"type": "subtitle", "time": 4407.63, "timestamp": "01:13:27", "text": "ああ、なんてことだ。ああ、なんてことだ。"}, {"type": "subtitle", "time": 4415.91, "timestamp": "01:13:35", "text": "運転。そうそう。待って、どうやって確認するの？"}, {"type": "subtitle", "time": 4422.11, "timestamp": "01:13:42", "text": "ああ、8時だ"}, {"type": "subtitle", "time": 4426.39, "timestamp": "01:13:46", "text": "土曜日。どうすればここから出られますか？"}, {"type": "subtitle", "time": 4430.149, "timestamp": "01:13:50", "text": "車から降りるにはどうすればいいですか？ああ、ああ、そうだね。"}, {"type": "subtitle", "time": 4438.59, "timestamp": "01:13:58", "text": "おい。やあ、アンディ。どうぞ。完了"}]
[{"type": "subtitle", "time": 9728.99, "timestamp": "02:42:08", "text": "彼女はジョギングしながら、大きなため息をついた。"}, {"type": "subtitle", "time": 9731.99, "timestamp": "02:42:11", "text": "安心。よし、みんな。新しい"}, {"type": "subtitle", "time": 9733.75, "timestamp": "02:42:13", "text": "家。"}, {"type": "subtitle", "time": 9735.03, "timestamp": "02:42:15", "text": "さあ行こう。"}, {"type": "subtitle", "time": 9738.78, "timestamp": "02:42:18", "text": "古いものからすべてのものを取り出して。"}, {"type": "subtitle", "time": 9740.95, "timestamp": "02:42:20", "text": "[音楽]"}, {"type": "subtitle", "time": 9744.63, "timestamp": "02:42:24", "text": "クリックして受け取ることができます。あなたが知っている"}, {"type": "subtitle", "time": 9747.91, "timestamp": "02:42:27", "text": "新しい家がある場所ですよね？うん。全て"}, {"type": "subtitle", "time": 9750.51, "timestamp": "02:42:30", "text": "右。それを置いて"}, {"type": "subtitle", "time": 9753.349, "timestamp": "02:42:33", "text": "そこには。やあ、ドナ。私たちはただ"}, {"type": "subtitle", "time": 9757.11, "timestamp": "02:42:37", "text": "離れる。でも、でも、それを収穫すると、"}, {"type": "subtitle", "time": 9760.07, "timestamp": "02:42:40", "text": "植物を採取して"}, {"type": "subtitle", "time": 9762.91, "timestamp": "02:42:42", "text": "ここ。収穫させてください。ピッキング"}, {"type": "subtitle", "time": 9766.11, "timestamp": "02:42:46", "text": "オブジェクト。マウスの右ボタン。"}, {"type": "subtitle", "time": 9772.19, "timestamp": "02:42:52", "text": "初め。全て"}, {"type": "subtitle", "time": 9779.349, "timestamp": "02:42:59", "text": "八。よし。これを手に入れました。私は"}]
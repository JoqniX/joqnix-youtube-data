[{"type": "subtitle", "time": 17220.59, "timestamp": "04:47:00", "text": "グラフトン農家があり、"}, {"type": "subtitle", "time": 17223.43, "timestamp": "04:47:03", "text": "ブリーズデール農家です。どれが"}, {"type": "subtitle", "time": 17227.11, "timestamp": "04:47:07", "text": "あなたはしたい？グラフトンに行けますよ。"}, {"type": "subtitle", "time": 17228.31, "timestamp": "04:47:08", "text": "待って。"}, {"type": "subtitle", "time": 17231.11, "timestamp": "04:47:11", "text": "あなたはそれを選ぶことができますか？ああ、そう思う"}, {"type": "subtitle", "time": 17233.91, "timestamp": "04:47:13", "text": "あなたはできる。おお、いいね、いいね、いいね。できますか？"}, {"type": "subtitle", "time": 17237.35, "timestamp": "04:47:17", "text": "選ぶ？ああ、準備はできますよ。はい。はい。"}, {"type": "subtitle", "time": 17241.67, "timestamp": "04:47:21", "text": "大丈夫です。何か買ってみます。"}, {"type": "subtitle", "time": 17244.31, "timestamp": "04:47:24", "text": "どうやって物を買うの？プラスをクリックしてください。"}, {"type": "subtitle", "time": 17248.47, "timestamp": "04:47:28", "text": "右？はい。プラスボタンをクリックしてください。だから、私たちは"}, {"type": "subtitle", "time": 17250.43, "timestamp": "04:47:30", "text": "ろうそくを1本ください。 A"}, {"type": "subtitle", "time": 17257.31, "timestamp": "04:47:37", "text": "温度計も必要ないですし"}, {"type": "subtitle", "time": 17260.07, "timestamp": "04:47:40", "text": "何でも。懐中電灯。追加で1つください"}, {"type": "subtitle", "time": 17263.67, "timestamp": "04:47:43", "text": "二人分の懐中電灯。"}, {"type": "subtitle", "time": 17268.43, "timestamp": "04:47:48", "text": "えっと、塩をください。病気"}, {"type": "subtitle", "time": 17271.67, "timestamp": "04:47:51", "text": "買う。わかった。準備を始めるべきでしょうか？"}, {"type": "subtitle", "time": 17273.59, "timestamp": "04:47:53", "text": "うん。うん。"}, {"type": "subtitle", "time": 17276.628, "timestamp": "04:47:56", "text": "塩を買いました。"}]
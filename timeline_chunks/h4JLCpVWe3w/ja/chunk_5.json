[{"type": "subtitle", "time": 301.03, "timestamp": "00:05:01", "text": "4段階農場。 4種類のミックスのみ。これは"}, {"type": "subtitle", "time": 305.51, "timestamp": "00:05:05", "text": "低レベルで効率的な農場のようなもの。"}, {"type": "subtitle", "time": 308.31, "timestamp": "00:05:08", "text": "私はここで育ち、何百万ドルも稼いだ。"}, {"type": "subtitle", "time": 312.27, "timestamp": "00:05:12", "text": "そしてメタンガス製造所を作り、"}, {"type": "subtitle", "time": 315.11, "timestamp": "00:05:15", "text": "もの。私の出発点と言えるでしょう。ない"}, {"type": "subtitle", "time": 316.83, "timestamp": "00:05:16", "text": "出発点だが、"}, {"type": "subtitle", "time": 322.35, "timestamp": "00:05:22", "text": "労働者と共に、より良い場所を築き始める。それで"}, {"type": "subtitle", "time": 324.71, "timestamp": "00:05:24", "text": "ええ、農場は全部私が作りました。そこには"}, {"type": "subtitle", "time": 326.469, "timestamp": "00:05:26", "text": "何もすることがない。警官を殺して"}, {"type": "subtitle", "time": 339.749, "timestamp": "00:05:39", "text": "えっ？あなたにあげるものは何もありません。"}]
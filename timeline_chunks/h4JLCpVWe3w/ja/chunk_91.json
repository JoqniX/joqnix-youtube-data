[{"type": "subtitle", "time": 5460.95, "timestamp": "01:31:00", "text": "うん。うん。トリマー。これらは"}, {"type": "subtitle", "time": 5463.43, "timestamp": "01:31:03", "text": "トリマー。うん。ニース。よし。私は"}, {"type": "subtitle", "time": 5466.07, "timestamp": "01:31:06", "text": "行くよ、行くよ、これを持って行こう"}, {"type": "subtitle", "time": 5470.47, "timestamp": "01:31:10", "text": "私たち。あ、もう包装材は置いてないんです。"}, {"type": "subtitle", "time": 5474.07, "timestamp": "01:31:14", "text": "この雑草をここに保管してもいいですか？ああ、プットプット"}, {"type": "subtitle", "time": 5476.709, "timestamp": "01:31:16", "text": "それはあなたのインベントリにあります。"}, {"type": "subtitle", "time": 5479.189, "timestamp": "01:31:19", "text": "それは私の持ち物の中にあります。"}, {"type": "subtitle", "time": 5485.629, "timestamp": "01:31:25", "text": "それでは、これをいただきます。私はしません"}, {"type": "subtitle", "time": 5490.229, "timestamp": "01:31:30", "text": "さあ、行こう。 Bも取得してください。なぜ"}, {"type": "subtitle", "time": 5492.629, "timestamp": "01:31:32", "text": "ない？よし。なんてこった？おい。おい。"}, {"type": "subtitle", "time": 5493.95, "timestamp": "01:31:33", "text": "おい。あなたが"}, {"type": "subtitle", "time": 5496.51, "timestamp": "01:31:36", "text": "行く"}, {"type": "subtitle", "time": 5500.229, "timestamp": "01:31:40", "text": "中を覗いてみようか？あなたは逃げ出した。"}, {"type": "subtitle", "time": 5502.31, "timestamp": "01:31:42", "text": "二度と戻ってくるな。二度と戻ってくるな。いいえ。"}, {"type": "subtitle", "time": 5504.44, "timestamp": "01:31:44", "text": "いいえ。 いいえ。お願いします。私が払います。ああ、見て。の"}, {"type": "subtitle", "time": 5506.96, "timestamp": "01:31:46", "text": "いいえ。お願いします。私が払います。ああ、見て。の 販売店。あなたは車を買うことができます。おお。どうやって"}, {"type": "subtitle", "time": 5510.639, "timestamp": "01:31:50", "text": "販売店。あなたは車を買うことができます。おお。どうやって これはいくらですか？ 40,000。"}, {"type": "subtitle", "time": 5513.84, "timestamp": "01:31:53", "text": "これはいくらですか？ 40,000。 いくら？"}, {"type": "subtitle", "time": 5515.8, "timestamp": "01:31:55", "text": "いくら？ 25,000ドル。"}, {"type": "subtitle", "time": 5517.6, "timestamp": "01:31:57", "text": "25,000ドル。 何てことだ。 12,000で、これは5,000です。"}]
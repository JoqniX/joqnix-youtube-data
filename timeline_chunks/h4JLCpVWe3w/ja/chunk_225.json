[{"type": "subtitle", "time": 13514.83, "timestamp": "03:45:14", "text": "神。私は"}, {"type": "subtitle", "time": 13537.79, "timestamp": "03:45:37", "text": "行く。見て、私もついていくよ"}, {"type": "subtitle", "time": 13541.1, "timestamp": "03:45:41", "text": "自分。さあ"}, {"type": "subtitle", "time": 13542.83, "timestamp": "03:45:42", "text": "[音楽]"}, {"type": "subtitle", "time": 13548.11, "timestamp": "03:45:48", "text": "行く。ああ、大変だ。何かおかしい。"}, {"type": "subtitle", "time": 13550.11, "timestamp": "03:45:50", "text": "イベント"}, {"type": "subtitle", "time": 13553.67, "timestamp": "03:45:53", "text": "そして、『ゴーストバスターズ』を思い出してください。"}]
[{"type": "subtitle", "time": 5947.83, "timestamp": "01:39:07", "text": "注記。いいえ。"}, {"type": "subtitle", "time": 5950.149, "timestamp": "01:39:10", "text": "は。"}, {"type": "subtitle", "time": 5953.59, "timestamp": "01:39:13", "text": "吸い込む。残っているのはそれだけだ。"}, {"type": "subtitle", "time": 5955.109, "timestamp": "01:39:15", "text": "中には何も入っていなかった。薬物"}, {"type": "subtitle", "time": 5958.629, "timestamp": "01:39:18", "text": "中毒者。いいえ、在庫を失ってしまいました。いいえ、それで、"}, {"type": "subtitle", "time": 5962.629, "timestamp": "01:39:22", "text": "私が保存していたアイテムを失ってしまいました。"}, {"type": "subtitle", "time": 5966.31, "timestamp": "01:39:26", "text": "あなたにあげるべきだった。"}, {"type": "subtitle", "time": 5968.629, "timestamp": "01:39:28", "text": "おお。メモがあります。何がそうではないのですか？おお、"}, {"type": "subtitle", "time": 5973.03, "timestamp": "01:39:33", "text": "メモがあります。どこ？どこ？下に。あなた"}, {"type": "subtitle", "time": 5976.07, "timestamp": "01:39:36", "text": "受け取った。下に。"}, {"type": "subtitle", "time": 5979.43, "timestamp": "01:39:39", "text": "どこ？下に。待って、私が受け取ったわ。いいえ、私は"}, {"type": "subtitle", "time": 5981.99, "timestamp": "01:39:41", "text": "それを読んでください。"}, {"type": "subtitle", "time": 5983.83, "timestamp": "01:39:43", "text": "どうでも。はい、それはああ、"}, {"type": "subtitle", "time": 5986.709, "timestamp": "01:39:46", "text": "進歩は共有されるものだと思う。"}, {"type": "subtitle", "time": 5990.79, "timestamp": "01:39:50", "text": "それは奇妙だ。そのメモは何ですか？と書いてあります"}, {"type": "subtitle", "time": 5995.109, "timestamp": "01:39:55", "text": "ああ、私たちのトンTBに手を出さないで"}]
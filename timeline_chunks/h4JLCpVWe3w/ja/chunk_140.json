[{"type": "subtitle", "time": 8403.59, "timestamp": "02:20:03", "text": "取引。 4回で160点。"}, {"type": "subtitle", "time": 8408.07, "timestamp": "02:20:08", "text": "彼女の申し出を考慮に入れるべきだろうか？ええ、もちろんです。その"}, {"type": "subtitle", "time": 8413.71, "timestamp": "02:20:13", "text": "40 80あたり"}, {"type": "subtitle", "time": 8417.91, "timestamp": "02:20:17", "text": "40を加えると142になる。"}, {"type": "subtitle", "time": 8419.99, "timestamp": "02:20:19", "text": "はい、戻ってきました。"}, {"type": "subtitle", "time": 8422.55, "timestamp": "02:20:22", "text": "いいえ、私たちはそう思います。いいえ、それは"}, {"type": "subtitle", "time": 8425.91, "timestamp": "02:20:25", "text": "適正価格。うん。えっと、彼女を"}, {"type": "subtitle", "time": 8428.07, "timestamp": "02:20:28", "text": "午前中。"}, {"type": "subtitle", "time": 8432.309, "timestamp": "02:20:32", "text": "よし。なんてこった。それから、ああ、やばい。"}, {"type": "subtitle", "time": 8434.79, "timestamp": "02:20:34", "text": "なぜ？どうしたの？だって、私はそうじゃないから"}, {"type": "subtitle", "time": 8437.349, "timestamp": "02:20:37", "text": "そんなに早く成長するとは思わない。いいえ、私は"}, {"type": "subtitle", "time": 8440.469, "timestamp": "02:20:40", "text": "もう十分だ。わかった。そして私はこう言うだろう"}, {"type": "subtitle", "time": 8442.23, "timestamp": "02:20:42", "text": "たぶん一番いいのは深夜みたいなものだと思うよ、だって"}, {"type": "subtitle", "time": 8446.07, "timestamp": "02:20:46", "text": "追加ボーナスを獲得しましょう。コーヒーボーナスと呼ばれています。"}, {"type": "subtitle", "time": 8448.15, "timestamp": "02:20:48", "text": "わかった。"}, {"type": "subtitle", "time": 8450.79, "timestamp": "02:20:50", "text": "でもそれはすべて時間管理のようなもので"}, {"type": "subtitle", "time": 8453.349, "timestamp": "02:20:53", "text": "良い。"}, {"type": "subtitle", "time": 8456.07, "timestamp": "02:20:56", "text": "ええ、それは知っていましたよ。だから私は"}]
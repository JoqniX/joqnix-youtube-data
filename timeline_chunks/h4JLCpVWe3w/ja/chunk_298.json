[{"type": "subtitle", "time": 17884.35, "timestamp": "04:58:04", "text": "ゲームのヒントをヒンジで聞く 遠くから"}, {"type": "subtitle", "time": 17888.19, "timestamp": "04:58:08", "text": "音。遠くから何か聞こえますか？"}, {"type": "subtitle", "time": 17895.07, "timestamp": "04:58:15", "text": "音？いいえ、私は"}, {"type": "subtitle", "time": 17899.23, "timestamp": "04:58:19", "text": "やめてください。大丈夫です。待って、なぜ私は見ているの？"}, {"type": "subtitle", "time": 17902.628, "timestamp": "04:58:22", "text": "エミリー・ディクソン？おお、"}, {"type": "subtitle", "time": 17905.99, "timestamp": "04:58:25", "text": "あなたの名前はエミリーですね。"}, {"type": "subtitle", "time": 17909.43, "timestamp": "04:58:29", "text": "いいえ、概要ケース名と表示されています。エミリー"}, {"type": "subtitle", "time": 17911.91, "timestamp": "04:58:31", "text": "ディクソン。よし、トラックに戻って"}, {"type": "subtitle", "time": 17914.55, "timestamp": "04:58:34", "text": "名前を確認してください。え、何？彼らは"}, {"type": "subtitle", "time": 17916.39, "timestamp": "04:58:36", "text": "名前を変えるとか？私はしません"}, {"type": "subtitle", "time": 17917.99, "timestamp": "04:58:37", "text": "そう思うと名前が変わるだろう"}, {"type": "subtitle", "time": 17926.43, "timestamp": "04:58:46", "text": "それは何？"}, {"type": "subtitle", "time": 17928.35, "timestamp": "04:58:48", "text": "表示していますか？"}, {"type": "subtitle", "time": 17932.31, "timestamp": "04:58:52", "text": "ああ、もう保留状態ではなくなったんですね。おお。何"}, {"type": "subtitle", "time": 17934.47, "timestamp": "04:58:54", "text": "一体どういうことだ？"}, {"type": "subtitle", "time": 17936.55, "timestamp": "04:58:56", "text": "保留中だったということは"}, {"type": "subtitle", "time": 17938.55, "timestamp": "04:58:58", "text": "名前は保留中でした。"}]
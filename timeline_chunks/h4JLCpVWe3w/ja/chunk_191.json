[{"type": "subtitle", "time": 11473.15, "timestamp": "03:11:13", "text": "おお。ああ、大変だ。それはあなたの"}, {"type": "subtitle", "time": 11476.309, "timestamp": "03:11:16", "text": "男の子。もし"}, {"type": "subtitle", "time": 11479.269, "timestamp": "03:11:19", "text": "最初に幽霊に捕まったのは私だった。何てことだ。"}, {"type": "subtitle", "time": 11484.03, "timestamp": "03:11:24", "text": "おかえり。ゴースト・モロイ・モイ・ボーン"}, {"type": "subtitle", "time": 11486.19, "timestamp": "03:11:26", "text": "証拠。"}, {"type": "subtitle", "time": 11490.389, "timestamp": "03:11:30", "text": "ああ、レベルアップだ。三脚エッジフィールドのロックを解除"}, {"type": "subtitle", "time": 11495.269, "timestamp": "03:11:35", "text": "道路と尾根の眺望を示すコード。さあ、行こう。"}, {"type": "subtitle", "time": 11497.63, "timestamp": "03:11:37", "text": "レベルアップしました"}, {"type": "subtitle", "time": 11500.23, "timestamp": "03:11:40", "text": "上。さあ行こう。レベルアップした。俺はクソだ"}, {"type": "subtitle", "time": 11502.95, "timestamp": "03:11:42", "text": "幽霊にイギリス人かと尋ねたところ、"}, {"type": "subtitle", "time": 11506.07, "timestamp": "03:11:46", "text": "彼はそれに腹を立てた。私は立っていた"}, {"type": "subtitle", "time": 11507.99, "timestamp": "03:11:47", "text": "そこには。彼は私の右側から来て、"}, {"type": "subtitle", "time": 11510.07, "timestamp": "03:11:50", "text": "「ああ」という感じだった。そして彼はこう言った。「おい、"}]
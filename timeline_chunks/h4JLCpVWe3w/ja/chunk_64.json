[{"type": "subtitle", "time": 3840.71, "timestamp": "01:04:00", "text": "たぶん、始めようかな"}, {"type": "subtitle", "time": 3842.95, "timestamp": "01:04:02", "text": "衝動を抑え込むのは大丈夫です。その"}, {"type": "subtitle", "time": 3845.27, "timestamp": "01:04:05", "text": "大丈夫。心配ない。ああ、私たちの"}, {"type": "subtitle", "time": 3849.109, "timestamp": "01:04:09", "text": "促すよ、兄弟。わかったよ、落ち着けよ。あなた あなた"}, {"type": "subtitle", "time": 3852.549, "timestamp": "01:04:12", "text": "バカ。お前はクソ野郎だ。"}, {"type": "subtitle", "time": 3855.109, "timestamp": "01:04:15", "text": "みんな、エマニュエルに嫌がらせのメッセージを送ってくれないか？"}, {"type": "subtitle", "time": 3858.549, "timestamp": "01:04:18", "text": "ええ、これが彼らのチャンネルです。"}, {"type": "subtitle", "time": 3859.39, "timestamp": "01:04:19", "text": "できますか？"}, {"type": "subtitle", "time": 3863.829, "timestamp": "01:04:23", "text": "いっそ完全に攻撃してしまえばいいんじゃない？"}, {"type": "subtitle", "time": 3872.23, "timestamp": "01:04:32", "text": "はい、こちらがジョックです。ジョーは素敵な人だ。"}, {"type": "subtitle", "time": 3876.87, "timestamp": "01:04:36", "text": "彼は美しい男性です。えへへ"}, {"type": "subtitle", "time": 3879.67, "timestamp": "01:04:39", "text": "私たちがギャンブルをしている間"}, {"type": "subtitle", "time": 3885.109, "timestamp": "01:04:45", "text": "友達の家。何？マークプライヤー。"}, {"type": "subtitle", "time": 3888.47, "timestamp": "01:04:48", "text": "そうそう。彼が与えなかったことを覚えておいてください"}, {"type": "subtitle", "time": 3890.87, "timestamp": "01:04:50", "text": "私たちのSCやギャンブルについてのクソ。そんな"}, {"type": "subtitle", "time": 3892.87, "timestamp": "01:04:52", "text": "素晴らしい友人。友達みんなが"}, {"type": "subtitle", "time": 3895.349, "timestamp": "01:04:55", "text": "そうあるべきだ。静かにして。私たちが"}, {"type": "subtitle", "time": 3898.15, "timestamp": "01:04:58", "text": "私たちが対処している社会に対処する"}]
[{"type": "subtitle", "time": 10921.03, "timestamp": "03:02:01", "text": "イマンは一人だったので本当に楽しかったです"}, {"type": "subtitle", "time": 10924.07, "timestamp": "03:02:04", "text": "このゲームをやり込んでいる。いいえ、予想していませんでした"}, {"type": "subtitle", "time": 10927.75, "timestamp": "03:02:07", "text": "とても楽しいでしょう、またはあなたが"}, {"type": "subtitle", "time": 10930.15, "timestamp": "03:02:10", "text": "他の人とも一緒に遊んでください。それはとても"}, {"type": "subtitle", "time": 10935.11, "timestamp": "03:02:15", "text": "えーっと、他の人と遊んでいるとき"}, {"type": "subtitle", "time": 10937.99, "timestamp": "03:02:17", "text": "最も重要なことは、"}, {"type": "subtitle", "time": 10940.95, "timestamp": "03:02:20", "text": "進歩よりも楽しさを重視し、"}, {"type": "subtitle", "time": 10942.79, "timestamp": "03:02:22", "text": "お金を稼ぐとか、そういうストレス"}, {"type": "subtitle", "time": 10947.15, "timestamp": "03:02:27", "text": "そこにはありません、またはそれをゆっくり行うことができます"}, {"type": "subtitle", "time": 10950.269, "timestamp": "03:02:30", "text": "でも私はそれが好き"}, {"type": "subtitle", "time": 10952.269, "timestamp": "03:02:32", "text": "それから私は"}, {"type": "subtitle", "time": 10955.91, "timestamp": "03:02:35", "text": "私はすでにゲームで多くのことを達成しました"}, {"type": "subtitle", "time": 10958.79, "timestamp": "03:02:38", "text": "今いる場所で幸せです。ただプレイしたいだけです。"}, {"type": "subtitle", "time": 10961.15, "timestamp": "03:02:41", "text": "参加するなら楽しいよ"}, {"type": "subtitle", "time": 10973.83, "timestamp": "03:02:53", "text": "うん。また、明日の配信は"}]
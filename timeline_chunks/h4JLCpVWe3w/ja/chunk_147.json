[{"type": "subtitle", "time": 8821.03, "timestamp": "02:27:01", "text": "よし、みんな。私たちは800ドル貯金しなければならない。"}, {"type": "subtitle", "time": 8823.67, "timestamp": "02:27:03", "text": "わかった。悪くない。"}, {"type": "subtitle", "time": 8825.51, "timestamp": "02:27:05", "text": "実際、おそらくそれは"}, {"type": "subtitle", "time": 8833.83, "timestamp": "02:27:13", "text": "あなたが知っている。私たちはまだ手に入れるでしょう"}, {"type": "subtitle", "time": 8836.27, "timestamp": "02:27:16", "text": "次から次へと客がやってくる。"}, {"type": "subtitle", "time": 8841.71, "timestamp": "02:27:21", "text": "ああ、特別な"}, {"type": "subtitle", "time": 8844.71, "timestamp": "02:27:24", "text": "肥料を使って押して"}, {"type": "subtitle", "time": 8848.55, "timestamp": "02:27:28", "text": "肥料はより良い品質をもたらす。それで、えーと"}, {"type": "subtitle", "time": 8852.79, "timestamp": "02:27:32", "text": "その山積みのクーリーを使うことができます"}, {"type": "subtitle", "time": 8854.95, "timestamp": "02:27:34", "text": "えっと、理髪店の隣です。そして私たちは"}, {"type": "subtitle", "time": 8857.03, "timestamp": "02:27:37", "text": "オースティンがいる。オースティン、お前はクソくらえ"}, {"type": "subtitle", "time": 8858.83, "timestamp": "02:27:38", "text": "私の薬のように、"}, {"type": "subtitle", "time": 8862.309, "timestamp": "02:27:42", "text": "兄弟。また夜遅くまで起きてる。素晴らしい。わかった、"}, {"type": "subtitle", "time": 8865.11, "timestamp": "02:27:45", "text": "会いましょう。紫色の"}, {"type": "subtitle", "time": 8867.349, "timestamp": "02:27:47", "text": "地図。無料サンプルを提供しなければなりません"}, {"type": "subtitle", "time": 8870.469, "timestamp": "02:27:50", "text": "そして、彼らに製作に興味を持たせる"}, {"type": "subtitle", "time": 8872.55, "timestamp": "02:27:52", "text": "彼らに買い手を見つける。"}, {"type": "subtitle", "time": 8874.79, "timestamp": "02:27:54", "text": "よし、じゃあ彼らに渡そう"}, {"type": "subtitle", "time": 8877.67, "timestamp": "02:27:57", "text": "いくつかのサンプル。栽培を続けましょう。私たちは"}]
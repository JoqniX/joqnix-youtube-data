[{"type": "subtitle", "time": 11766.55, "timestamp": "03:16:06", "text": "カーター、あなたのところには魅力的な独身男性がいます"}, {"type": "subtitle", "time": 11773.79, "timestamp": "03:16:13", "text": "何てことだ。あなたはここにいますか？"}, {"type": "subtitle", "time": 11789.19, "timestamp": "03:16:29", "text": "文字通り何も進展がないように見える。"}, {"type": "subtitle", "time": 11807.11, "timestamp": "03:16:47", "text": "ソフィー、そこにいるの？"}, {"type": "subtitle", "time": 11808.99, "timestamp": "03:16:48", "text": "ああ、なんて怖いんだ"}, {"type": "subtitle", "time": 11817.63, "timestamp": "03:16:57", "text": "ソフィー、それはあなたの"}, {"type": "subtitle", "time": 11819.95, "timestamp": "03:16:59", "text": "車？これはあなたのものですか？"}]
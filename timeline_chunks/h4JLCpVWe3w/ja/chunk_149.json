[{"type": "subtitle", "time": 8940.11, "timestamp": "02:29:00", "text": "金物店の隣にある"}, {"type": "subtitle", "time": 8942.23, "timestamp": "02:29:02", "text": "ピザ屋。マップを開いて"}, {"type": "subtitle", "time": 8944.83, "timestamp": "02:29:04", "text": "ジョグスが見える"}, {"type": "subtitle", "time": 8949.469, "timestamp": "02:29:09", "text": "スタイルが好きです。やあ、元気かい？"}, {"type": "subtitle", "time": 8952.67, "timestamp": "02:29:12", "text": "いくつかご紹介します"}, {"type": "subtitle", "time": 8954.83, "timestamp": "02:29:14", "text": "標準。"}, {"type": "subtitle", "time": 8962.11, "timestamp": "02:29:22", "text": "良い。"}, {"type": "subtitle", "time": 8966.75, "timestamp": "02:29:26", "text": "よし、行こう。来て。 79％の確率で"}, {"type": "subtitle", "time": 8970.91, "timestamp": "02:29:30", "text": "成功。悪くないね。さあ"}, {"type": "subtitle", "time": 8975.03, "timestamp": "02:29:35", "text": "行く。ルウィグを手に入れた。何てことだ。ルウィグ、君"}, {"type": "subtitle", "time": 8977.51, "timestamp": "02:29:37", "text": "こんなことしちゃダメだよ。ルウィグ。"}, {"type": "subtitle", "time": 8979.83, "timestamp": "02:29:39", "text": "何？"}, {"type": "subtitle", "time": 8981.83, "timestamp": "02:29:41", "text": "あなたは一番人気のストリーマーです。あなたは"}, {"type": "subtitle", "time": 8982.75, "timestamp": "02:29:42", "text": "する"}, {"type": "subtitle", "time": 8984.99, "timestamp": "02:29:44", "text": "これ。あまりにも"}, {"type": "subtitle", "time": 8988.79, "timestamp": "02:29:48", "text": "遅い。もう遅すぎるって言ったの？遅すぎる"}, {"type": "subtitle", "time": 8990.67, "timestamp": "02:29:50", "text": "言う"}, {"type": "subtitle", "time": 8996.11, "timestamp": "02:29:56", "text": "ごめん。ええと、私もそう思います。"}, {"type": "subtitle", "time": 8998.309, "timestamp": "02:29:58", "text": "遅い。よし、このゴミを袋に詰めよう"}]
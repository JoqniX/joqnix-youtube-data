[{"type": "subtitle", "time": 1444.23, "timestamp": "00:24:04", "text": "心配。さあ行こう。そのクエストを完了しました。"}, {"type": "subtitle", "time": 1446.31, "timestamp": "00:24:06", "text": "ついに。"}, {"type": "subtitle", "time": 1447.789, "timestamp": "00:24:07", "text": "行く"}, {"type": "subtitle", "time": 1450.47, "timestamp": "00:24:10", "text": "クリーン。ここにはガラクタが山ほどある。"}, {"type": "subtitle", "time": 1458.87, "timestamp": "00:24:18", "text": "クリーン。みんな、俺を金持ちにしてくれよ。えっと、私は"}, {"type": "subtitle", "time": 1462.95, "timestamp": "00:24:22", "text": "自分が大金持ちになれることに興奮している。私は"}, {"type": "subtitle", "time": 1465.51, "timestamp": "00:24:25", "text": "ああ、たくさんやるつもりだよ"}, {"type": "subtitle", "time": 1468.99, "timestamp": "00:24:28", "text": "もの。待ちきれない。私を作る"}, {"type": "subtitle", "time": 1477.19, "timestamp": "00:24:37", "text": "それと、メタンフェタミン欲しい？あなたは望んでいない"}, {"type": "subtitle", "time": 1478.51, "timestamp": "00:24:38", "text": "それ？"}, {"type": "subtitle", "time": 1482.269, "timestamp": "00:24:42", "text": "わかった。欲しい？取る"}, {"type": "subtitle", "time": 1487.149, "timestamp": "00:24:47", "text": "それ。欲しい？取る"}, {"type": "subtitle", "time": 1490.43, "timestamp": "00:24:50", "text": "それ。異星人になれ。"}, {"type": "subtitle", "time": 1493.149, "timestamp": "00:24:53", "text": "ディオ。あなたは欲しい"}]
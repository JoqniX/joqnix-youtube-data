[{"type": "subtitle", "time": 13448.229, "timestamp": "03:44:08", "text": "熱い。もっと水が必要だと思う。わからない"}, {"type": "subtitle", "time": 13475.189, "timestamp": "03:44:35", "text": "よし、着いたぞ。見てください"}, {"type": "subtitle", "time": 13476.95, "timestamp": "03:44:36", "text": "機器を準備し、それに応じて対応します。"}, {"type": "subtitle", "time": 13484.63, "timestamp": "03:44:44", "text": "こちらがダニエル・スティーブンスです。よし、行って"}, {"type": "subtitle", "time": 13488.91, "timestamp": "03:44:48", "text": "もっと詳しく見てみましょう。追いかけている間にチェックする"}, {"type": "subtitle", "time": 13491.269, "timestamp": "03:44:51", "text": "誰か。それに、棒はあまり持っていない"}]
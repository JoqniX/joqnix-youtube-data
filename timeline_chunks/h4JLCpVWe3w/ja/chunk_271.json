[{"type": "subtitle", "time": 16260.149, "timestamp": "04:31:00", "text": "方法？ルース、道を知っているかい？クソッ"}, {"type": "subtitle", "time": 16262.83, "timestamp": "04:31:02", "text": "方法。くたばれ、"}, {"type": "subtitle", "time": 16265.11, "timestamp": "04:31:05", "text": "ルース。なぜ彼女はあなたの"}, {"type": "subtitle", "time": 16267.91, "timestamp": "04:31:07", "text": "死体？害さえも"}, {"type": "subtitle", "time": 16270.55, "timestamp": "04:31:10", "text": "おばけ？一体どういうことだ？チャ、"}, {"type": "subtitle", "time": 16273.51, "timestamp": "04:31:13", "text": "なぜ彼女の声が近くに聞こえるのですか？ああ、彼女は"}, {"type": "subtitle", "time": 16279.03, "timestamp": "04:31:19", "text": "ああ、彼女はあなたが亡くなったから泣いているのよ。"}, {"type": "subtitle", "time": 16283.03, "timestamp": "04:31:23", "text": "何？ああ、彼女はどこへ行くのだろう？彼女は"}, {"type": "subtitle", "time": 16286.07, "timestamp": "04:31:26", "text": "飛び上がるつもりだ。彼女はハイハイしている。[ __ ]"}, {"type": "subtitle", "time": 16288.95, "timestamp": "04:31:28", "text": "遅れている。これはオハイオ州の幽霊です。ああ、彼女は"}, {"type": "subtitle", "time": 16291.99, "timestamp": "04:31:31", "text": "何かを投げた。一体どういうことだ？"}, {"type": "subtitle", "time": 16293.83, "timestamp": "04:31:33", "text": "ええ、彼女は何かを投げました。これはこれです"}, {"type": "subtitle", "time": 16295.91, "timestamp": "04:31:35", "text": "母が買うのを拒否した後の私"}, {"type": "subtitle", "time": 16298.429, "timestamp": "04:31:38", "text": "私にとって何か"}, {"type": "subtitle", "time": 16301.83, "timestamp": "04:31:41", "text": "スーパーマーケット。ママ、お願いだから買って"}, {"type": "subtitle", "time": 16304.87, "timestamp": "04:31:44", "text": "あのクソポケモン歯ブラシ。お願いします"}, {"type": "subtitle", "time": 16307.429, "timestamp": "04:31:47", "text": "ピカチュウの顔がプリントされた下着を買ってくれ。病気"}, {"type": "subtitle", "time": 16309.03, "timestamp": "04:31:49", "text": "それを着て、私の周りのみんなに見せて"}, {"type": "subtitle", "time": 16313.11, "timestamp": "04:31:53", "text": "学校。ああ、大変だ。待って、彼女はここに来たの？"}, {"type": "subtitle", "time": 16316.389, "timestamp": "04:31:56", "text": "いいえ。そうです。いや、違うよ。彼女はここに来た、"}]
[{"type": "subtitle", "time": 728.23, "timestamp": "00:12:08", "text": "ああ、あと、私のコカイン、いやメタンフェタミンはどこに行ったの？"}, {"type": "subtitle", "time": 730.87, "timestamp": "00:12:10", "text": "行く？メタンフェタミンを入手する必要がある。私は"}, {"type": "subtitle", "time": 736.63, "timestamp": "00:12:16", "text": "[拍手]"}, {"type": "subtitle", "time": 746.55, "timestamp": "00:12:26", "text": "農場？どこに保管すればいいですか？どこで"}, {"type": "subtitle", "time": 748.55, "timestamp": "00:12:28", "text": "保管しておく？どこに保管すればいいですか？どこで"}, {"type": "subtitle", "time": 773.31, "timestamp": "00:12:53", "text": "は。どうしたの？"}]
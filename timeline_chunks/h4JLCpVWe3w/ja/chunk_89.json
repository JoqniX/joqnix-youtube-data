[{"type": "subtitle", "time": 5343.83, "timestamp": "01:29:03", "text": "行く。終わり。私は本当に準備万端です。こんにちは、"}, {"type": "subtitle", "time": 5345.99, "timestamp": "01:29:05", "text": "ジョック。なぜ私たちは"}, {"type": "subtitle", "time": 5349.03, "timestamp": "01:29:09", "text": "同じこと？"}, {"type": "subtitle", "time": 5351.99, "timestamp": "01:29:11", "text": "こんにちは。"}, {"type": "subtitle", "time": 5360.87, "timestamp": "01:29:20", "text": "私の計画？私たちは車を持っていますか？持っていません"}, {"type": "subtitle", "time": 5365.35, "timestamp": "01:29:25", "text": "車。いや、買わないといけないと思う。"}, {"type": "subtitle", "time": 5367.43, "timestamp": "01:29:27", "text": "ええ、買わなきゃいけませんね。よし。全て"}, {"type": "subtitle", "time": 5369.83, "timestamp": "01:29:29", "text": "はい、皆さん。私たちはディズニーパークを"}, {"type": "subtitle", "time": 5372.11, "timestamp": "01:29:32", "text": "最大のトラックまたは"}, {"type": "subtitle", "time": 5375.55, "timestamp": "01:29:35", "text": "わーい。イマンはどこにいますか？所有"}, {"type": "subtitle", "time": 5378.95, "timestamp": "01:29:38", "text": "上。えっと、"}, {"type": "subtitle", "time": 5384.629, "timestamp": "01:29:44", "text": "わかったよ、ジョー。至急必要です。さあ"}, {"type": "subtitle", "time": 5387.27, "timestamp": "01:29:47", "text": "行く。さあ行こう。"}, {"type": "subtitle", "time": 5390.55, "timestamp": "01:29:50", "text": "よお、ミスター。"}, {"type": "subtitle", "time": 5393.99, "timestamp": "01:29:53", "text": "私は自分の見た目が大好きです"}, {"type": "subtitle", "time": 5397.669, "timestamp": "01:29:57", "text": "ジェシー。マリファナが必要だ。ジェシー。おい、黙れ"}]
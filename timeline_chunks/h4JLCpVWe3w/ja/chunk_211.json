[{"type": "subtitle", "time": 12661.469, "timestamp": "03:31:01", "text": "亡くなった。ミッチ"}, {"type": "subtitle", "time": 12663.91, "timestamp": "03:31:03", "text": "亡くなった。ああ、ゾクゾクする。おお"}, {"type": "subtitle", "time": 12665.99, "timestamp": "03:31:05", "text": "ああ、ゾクゾクする。私は"}, {"type": "subtitle", "time": 12668.87, "timestamp": "03:31:08", "text": "ゾクゾクする。ああ、私は"}, {"type": "subtitle", "time": 12669.55, "timestamp": "03:31:09", "text": "の"}, {"type": "subtitle", "time": 12675.389, "timestamp": "03:31:15", "text": "震える。ああ、神様。ああ、神様。おお"}, {"type": "subtitle", "time": 12682.269, "timestamp": "03:31:22", "text": "あなたは見ましたか"}, {"type": "subtitle", "time": 12686.55, "timestamp": "03:31:26", "text": "それ？何かが突然現れた。何？何"}, {"type": "subtitle", "time": 12704.469, "timestamp": "03:31:44", "text": "見る。なぜ私はここに閉じ込められているのか"}]
[{"type": "subtitle", "time": 6782.149, "timestamp": "01:53:02", "text": "えっと、サムには家族がいなかったんですよね？"}, {"type": "subtitle", "time": 6785.43, "timestamp": "01:53:05", "text": "えっと、私はそうは思わない。彼は何をしたの？私たちは"}, {"type": "subtitle", "time": 6789.07, "timestamp": "01:53:09", "text": "彼は現金で彼を売った"}, {"type": "subtitle", "time": 6792.709, "timestamp": "01:53:12", "text": "え。 H 私は自分のことを言うべきだった、ほら、"}, {"type": "subtitle", "time": 6795.51, "timestamp": "01:53:15", "text": "実際に何かできることがある。彼を抱き上げて。"}, {"type": "subtitle", "time": 6797.99, "timestamp": "01:53:17", "text": "彼を持ち上げて入れて。燃やそう"}, {"type": "subtitle", "time": 6799.51, "timestamp": "01:53:19", "text": "彼。"}, {"type": "subtitle", "time": 6802.149, "timestamp": "01:53:22", "text": "そうそう。やけど。"}, {"type": "subtitle", "time": 6805.27, "timestamp": "01:53:25", "text": "私の体調はまだ万全ではありません。ああ。おお。おお。"}, {"type": "subtitle", "time": 6809.189, "timestamp": "01:53:29", "text": "ああ、彼にはコーラを買ってあげられるよ。"}, {"type": "subtitle", "time": 6810.95, "timestamp": "01:53:30", "text": "私がしたことは気にしないでください。あなたが"}, {"type": "subtitle", "time": 6813.43, "timestamp": "01:53:33", "text": "何をしているの？これがあなたがこれからすることだ"}, {"type": "subtitle", "time": 6815.629, "timestamp": "01:53:35", "text": "それは"}, {"type": "subtitle", "time": 6818.55, "timestamp": "01:53:38", "text": "もしあなたが私の言うことを聞かないなら、彼はこうなるでしょう。は"}, {"type": "subtitle", "time": 6822.79, "timestamp": "01:53:42", "text": "これが分からないの？シーッ、デーモン。"}, {"type": "subtitle", "time": 6824.47, "timestamp": "01:53:44", "text": "わかった、入れたよ。入れるよ"}, {"type": "subtitle", "time": 6829.03, "timestamp": "01:53:49", "text": "ポット。待って、彼を入れたよ。よし、"}, {"type": "subtitle", "time": 6833.51, "timestamp": "01:53:53", "text": "ゴミは中に入れてください。えーと、俺は嫌い"}, {"type": "subtitle", "time": 6837.35, "timestamp": "01:53:57", "text": "私は大丈夫です。おお、いいね。ニース。アレクサ、"}]
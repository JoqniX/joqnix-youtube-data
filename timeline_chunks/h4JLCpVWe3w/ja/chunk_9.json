[{"type": "subtitle", "time": 562.67, "timestamp": "00:09:22", "text": "こんにちは、ようこそ。"}, {"type": "subtitle", "time": 566.31, "timestamp": "00:09:26", "text": "えっと、コカイン農場から交配まで。ええ、これは"}, {"type": "subtitle", "time": 568.75, "timestamp": "00:09:28", "text": "私のコカイン"}, {"type": "subtitle", "time": 571.829, "timestamp": "00:09:31", "text": "農場。これでコカインを手に入れる。"}, {"type": "subtitle", "time": 573.91, "timestamp": "00:09:33", "text": "あ、待って。忘れた。えっと、予約する必要がある"}, {"type": "subtitle", "time": 575.67, "timestamp": "00:09:35", "text": "コカイン。えっと、待って、待って、待って。忘れた。"}, {"type": "subtitle", "time": 577.47, "timestamp": "00:09:37", "text": "忘れた。忘れた。忘れた。忘れた。"}, {"type": "subtitle", "time": 581.19, "timestamp": "00:09:41", "text": "忘れていた。連絡先。えっと、メッセージです。私にさせて"}, {"type": "subtitle", "time": 584.03, "timestamp": "00:09:44", "text": "これら全てをクリアする"}, {"type": "subtitle", "time": 587.509, "timestamp": "00:09:47", "text": "みんな。サルバド、彼にお金を支払わなければならない。"}, {"type": "subtitle", "time": 595.99, "timestamp": "00:09:55", "text": "ああ、わかった。払ってやるよ、兄弟。どこに"}, {"type": "subtitle", "time": 598.19, "timestamp": "00:09:58", "text": "あなた？ここ、"}]
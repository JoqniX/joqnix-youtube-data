[{"type": "subtitle", "time": 1200.669, "timestamp": "00:20:00", "text": "轢かれる"}, {"type": "subtitle", "time": 1203.87, "timestamp": "00:20:03", "text": "そこには。コカイン農園を見てみたい"}, {"type": "subtitle", "time": 1207.07, "timestamp": "00:20:07", "text": "実際にドアのところで"}, {"type": "subtitle", "time": 1209.909, "timestamp": "00:20:09", "text": "倉庫。それを開けて。なぜそうしないのですか？"}, {"type": "subtitle", "time": 1215.27, "timestamp": "00:20:15", "text": "えっ？いや、いや、いや、いや、いや、いや、いや。あなたは"}, {"type": "subtitle", "time": 1216.71, "timestamp": "00:20:16", "text": "うまくいくはずだ。なんてこった。いや、いや、いや、"}, {"type": "subtitle", "time": 1226.789, "timestamp": "00:20:26", "text": "6 2 3 4 ああ、足りない。する"}, {"type": "subtitle", "time": 1233.47, "timestamp": "00:20:33", "text": "もの。えっと、私は"}, {"type": "subtitle", "time": 1236.43, "timestamp": "00:20:36", "text": "の"}, {"type": "subtitle", "time": 1240.19, "timestamp": "00:20:40", "text": "うん。なぜみんなが尋ねているのか"}, {"type": "subtitle", "time": 1244.75, "timestamp": "00:20:44", "text": "虹？一体どういうことだ？私は持っていません"}, {"type": "subtitle", "time": 1248.19, "timestamp": "00:20:48", "text": "十分。ちょっと待って。"}, {"type": "subtitle", "time": 1250.75, "timestamp": "00:20:50", "text": "えっと、"}, {"type": "subtitle", "time": 1253.83, "timestamp": "00:20:53", "text": "サルバドールを指揮してください、私に"}]
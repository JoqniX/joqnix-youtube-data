[{"type": "subtitle", "time": 5762.149, "timestamp": "01:36:02", "text": "待って、これを収集しましたか"}, {"type": "subtitle", "time": 5764.31, "timestamp": "01:36:04", "text": "統計データは？の後ろに隠してある物資を集めてください"}, {"type": "subtitle", "time": 5766.31, "timestamp": "01:36:06", "text": "スーパーマーケット。あ、待って。隠しておこう"}, {"type": "subtitle", "time": 5767.83, "timestamp": "01:36:07", "text": "スーパーマーケットの裏手にも。おお、"}, {"type": "subtitle", "time": 5770.79, "timestamp": "01:36:10", "text": "うん。うん。"}, {"type": "subtitle", "time": 5772.31, "timestamp": "01:36:12", "text": "えっと、スーパーはどこですか？ああ、これは"}, {"type": "subtitle", "time": 5773.75, "timestamp": "01:36:13", "text": "スーパーマーケット。いいえ、それはガソリンスタンドです。"}, {"type": "subtitle", "time": 5776.629, "timestamp": "01:36:16", "text": "待って、接続が切れたか、"}, {"type": "subtitle", "time": 5779.669, "timestamp": "01:36:19", "text": "何か。ホストがゲームを退出したのはなぜですか？"}, {"type": "subtitle", "time": 5783.59, "timestamp": "01:36:23", "text": "ああ、私はここにいます。いいえ、"}, {"type": "subtitle", "time": 5786.47, "timestamp": "01:36:26", "text": "わかりました、もう一度参加させてください。"}, {"type": "subtitle", "time": 5790.709, "timestamp": "01:36:30", "text": "ああ、なんてことだ、お前はクソだ。"}, {"type": "subtitle", "time": 5793.83, "timestamp": "01:36:33", "text": "ああ、なんてことだ、君は血で屁をしたんだ。私"}, {"type": "subtitle", "time": 5802.709, "timestamp": "01:36:42", "text": "これはあなたにだけ起こることです。"}, {"type": "subtitle", "time": 5804.87, "timestamp": "01:36:44", "text": "エマ、もしあなたが言うことを聞かないなら。あ、待って。私 私"}, {"type": "subtitle", "time": 5809.109, "timestamp": "01:36:49", "text": "在庫を失う。いいえ、私はOhを失いました、"}, {"type": "subtitle", "time": 5812.79, "timestamp": "01:36:52", "text": "いいえ。胸部もその他すべて。"}, {"type": "subtitle", "time": 5814.39, "timestamp": "01:36:54", "text": "よし。あなたを処分しましょうか、"}, {"type": "subtitle", "time": 5818.95, "timestamp": "01:36:58", "text": "ちっちゃな子？はい、どうぞ。なんてこった。負けました"}]
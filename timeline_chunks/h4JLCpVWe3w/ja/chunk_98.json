[{"type": "subtitle", "time": 5893.79, "timestamp": "01:38:13", "text": "隠し場所を見つけた。"}, {"type": "subtitle", "time": 5896.31, "timestamp": "01:38:16", "text": "175ドル。キャンピングカーに戻ってください。戻りましょう"}, {"type": "subtitle", "time": 5903.83, "timestamp": "01:38:23", "text": "待って。えっと、イマン、荷物は持ってる？"}, {"type": "subtitle", "time": 5906.31, "timestamp": "01:38:26", "text": "パッケージのことですか？私は"}, {"type": "subtitle", "time": 5909.59, "timestamp": "01:38:29", "text": "包装システム。くそ。ああ、私は"}, {"type": "subtitle", "time": 5912.95, "timestamp": "01:38:32", "text": "あれ。待って、キャンピングカーはここから出て行け。"}, {"type": "subtitle", "time": 5916.39, "timestamp": "01:38:36", "text": "待って、行こう。音はどうでしたか？"}, {"type": "subtitle", "time": 5919.59, "timestamp": "01:38:39", "text": "爆発事故の調査へようこそ。"}, {"type": "subtitle", "time": 5922.39, "timestamp": "01:38:42", "text": "何の爆発？爆発はどこで起きたのですか？"}, {"type": "subtitle", "time": 5925.03, "timestamp": "01:38:45", "text": "まっすぐ、まっすぐ、まっすぐ。こんにちは。"}, {"type": "subtitle", "time": 5928.229, "timestamp": "01:38:48", "text": "まっすぐです。待って、"}, {"type": "subtitle", "time": 5932.31, "timestamp": "01:38:52", "text": "あれはキャンピングカーですか？そこは私たちの"}, {"type": "subtitle", "time": 5934.83, "timestamp": "01:38:54", "text": "なんてこった。それは"}]
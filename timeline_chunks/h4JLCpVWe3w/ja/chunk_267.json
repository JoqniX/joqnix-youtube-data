[{"type": "subtitle", "time": 16021.59, "timestamp": "04:27:01", "text": "カメラ。カメラ。わかった。"}, {"type": "subtitle", "time": 16025.59, "timestamp": "04:27:05", "text": "彼女の声が聞こえる。一体どういうことだ？"}, {"type": "subtitle", "time": 16027.11, "timestamp": "04:27:07", "text": "カメラを使います。何"}, {"type": "subtitle", "time": 16028.55, "timestamp": "04:27:08", "text": "ああ、たぶん君はもう死んでるからだろうね。来る"}, {"type": "subtitle", "time": 16030.149, "timestamp": "04:27:10", "text": "戻る。戻ってくる。わかりました、お知らせします。"}, {"type": "subtitle", "time": 16034.389, "timestamp": "04:27:14", "text": "彼女が歩くのをやめたら。はぁ？わかった。"}, {"type": "subtitle", "time": 16037.429, "timestamp": "04:27:17", "text": "ああ、この家は本当に苦痛だ。"}, {"type": "subtitle", "time": 16041.189, "timestamp": "04:27:21", "text": "アドレナリンが分泌されている。大好きです。愛"}, {"type": "subtitle", "time": 16047.349, "timestamp": "04:27:27", "text": "うん、そのまま隅っこにいて。"}, {"type": "subtitle", "time": 16049.71, "timestamp": "04:27:29", "text": "彼女が私に向かってくるのを見るだろう。"}, {"type": "subtitle", "time": 16053.67, "timestamp": "04:27:33", "text": "わかった。彼女はあなたがここにいることを知っている。私"}, {"type": "subtitle", "time": 16055.269, "timestamp": "04:27:35", "text": "ええ、そうですね。だから彼女は続けている"}, {"type": "subtitle", "time": 16057.349, "timestamp": "04:27:37", "text": "私自身が私を狩っている。動けません。私はできません"}, {"type": "subtitle", "time": 16061.59, "timestamp": "04:27:41", "text": "くそっ。ああ、彼女が来る音が聞こえる。よし、来い"}, {"type": "subtitle", "time": 16064.07, "timestamp": "04:27:44", "text": "私の家に戻って私を見て"}, {"type": "subtitle", "time": 16065.75, "timestamp": "04:27:45", "text": "それ"}, {"type": "subtitle", "time": 16068.389, "timestamp": "04:27:48", "text": "我が神よ。"}, {"type": "subtitle", "time": 16071.75, "timestamp": "04:27:51", "text": "ああ、彼女の声が聞こえる。彼女が私に向かってくる。"}, {"type": "subtitle", "time": 16074.71, "timestamp": "04:27:54", "text": "うん。"}]
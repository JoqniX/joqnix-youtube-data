[{"type": "subtitle", "time": 15546.55, "timestamp": "04:19:06", "text": "あまり多くの照明をつけないでください。わかった。"}, {"type": "subtitle", "time": 15548.71, "timestamp": "04:19:08", "text": "ええと、ここを見てみましょう。 EMFの測定値なし、"}, {"type": "subtitle", "time": 15551.429, "timestamp": "04:19:11", "text": "何もない。ああ、私たち二人がここにいるから、"}, {"type": "subtitle", "time": 15553.269, "timestamp": "04:19:13", "text": "考える。"}, {"type": "subtitle", "time": 15561.07, "timestamp": "04:19:21", "text": "ここ。何かありますか？"}, {"type": "subtitle", "time": 15563.269, "timestamp": "04:19:23", "text": "ガレージ？あまり多くのライトをつけないでください。"}, {"type": "subtitle", "time": 15565.269, "timestamp": "04:19:25", "text": "ジョー。覚えて？はい、オフにします"}, {"type": "subtitle", "time": 15568.389, "timestamp": "04:19:28", "text": "私が点灯したライト。うん。うん。"}, {"type": "subtitle", "time": 15570.87, "timestamp": "04:19:30", "text": "片方をオフにしてから、もう片方をオンにする"}, {"type": "subtitle", "time": 15576.229, "timestamp": "04:19:36", "text": "とにかく写真が必要なんだ。覚えて"}, {"type": "subtitle", "time": 15580.63, "timestamp": "04:19:40", "text": "それ。はい。 「ああ、あなたは餌を与えている」ということはありません"}, {"type": "subtitle", "time": 15582.83, "timestamp": "04:19:42", "text": "二。"}, {"type": "subtitle", "time": 15591.189, "timestamp": "04:19:51", "text": "ああ、それは私が上に上がったからだよ。ああ、わかりました。"}, {"type": "subtitle", "time": 15593.269, "timestamp": "04:19:53", "text": "あなたは昇進した。いいえ、EMFの測定値は"}, {"type": "subtitle", "time": 15595.67, "timestamp": "04:19:55", "text": "私がいる場所。いや、いや、いや。まるであなたが"}, {"type": "subtitle", "time": 15597.269, "timestamp": "04:19:57", "text": "地下室に一人きり。えっと、これは"}, {"type": "subtitle", "time": 15599.429, "timestamp": "04:19:59", "text": "地面に落ちたんですよね？うん。たぶんこんな感じ"}]
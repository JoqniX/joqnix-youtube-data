[{"type": "subtitle", "time": 12305.51, "timestamp": "03:25:05", "text": "うん。こんにちは、カイラ。なぜ星は"}, {"type": "subtitle", "time": 12308.229, "timestamp": "03:25:08", "text": "渡るのですか？ああ、それは星じゃないよ。その"}, {"type": "subtitle", "time": 12317.51, "timestamp": "03:25:17", "text": "クソ女。"}, {"type": "subtitle", "time": 12321.19, "timestamp": "03:25:21", "text": "ソフィー、あなたのポーンを見つけたわ。"}, {"type": "subtitle", "time": 12330.71, "timestamp": "03:25:30", "text": "ところで、あなたは暑いですか？私は独身です。"}, {"type": "subtitle", "time": 12333.429, "timestamp": "03:25:33", "text": "人付き合いが好きです。あなたは人と交流するのが好きですか？"}, {"type": "subtitle", "time": 12336.07, "timestamp": "03:25:36", "text": "ああ、あれは何だったの？キーッ。"}, {"type": "subtitle", "time": 12338.79, "timestamp": "03:25:38", "text": "ああ、彼女は電気をつけた。シーラ"}, {"type": "subtitle", "time": 12341.83, "timestamp": "03:25:41", "text": "電気をつけた。凍りつく。おい、"}, {"type": "subtitle", "time": 12345.429, "timestamp": "03:25:45", "text": "さあ、行こう、ソフィー。知っていた。知っていた。"}, {"type": "subtitle", "time": 12346.4, "timestamp": "03:25:46", "text": "私"}, {"type": "subtitle", "time": 12357.429, "timestamp": "03:25:57", "text": "彼女がここにいることを知っていた。この部屋で。"}, {"type": "subtitle", "time": 12359.59, "timestamp": "03:25:59", "text": "ねえソフィー、私たちは何か特別なものがあると知っていたの"}]
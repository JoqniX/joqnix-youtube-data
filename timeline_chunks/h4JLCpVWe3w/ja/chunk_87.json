[{"type": "subtitle", "time": 5221.669, "timestamp": "01:27:01", "text": "招待する。私も参加してみます。ゲームに参加してください。"}, {"type": "subtitle", "time": 5231.189, "timestamp": "01:27:11", "text": "いっそ坊主にした方がいいのかな？"}, {"type": "subtitle", "time": 5235.39, "timestamp": "01:27:15", "text": "ハゲ。私はただあなただけを産み出す"}, {"type": "subtitle", "time": 5239.43, "timestamp": "01:27:19", "text": "プレイヤーだが、それはこうでなければならない"}, {"type": "subtitle", "time": 5241.91, "timestamp": "01:27:21", "text": "ああ、君はちっぽけなドラゴンだってことはわかったよ"}, {"type": "subtitle", "time": 5243.55, "timestamp": "01:27:23", "text": "でもわかった、わかった"}, {"type": "subtitle", "time": 5247.35, "timestamp": "01:27:27", "text": "ああ、いいいいいい"}, {"type": "subtitle", "time": 5251.43, "timestamp": "01:27:31", "text": "うん、これでいいよ。行こう。私はスキップできる。"}, {"type": "subtitle", "time": 5254.55, "timestamp": "01:27:34", "text": "白、はい、どうぞ、顔は少し"}, {"type": "subtitle", "time": 5256.75, "timestamp": "01:27:36", "text": "笑顔"}, {"type": "subtitle", "time": 5264.79, "timestamp": "01:27:44", "text": "死ぬ。いいえ、私は顔の毛は生やしたくありません。"}, {"type": "subtitle", "time": 5268.75, "timestamp": "01:27:48", "text": "しわ。えっと、そばかす。"}, {"type": "subtitle", "time": 5273.27, "timestamp": "01:27:53", "text": "なし。ディテールの強度。よし、次。"}]
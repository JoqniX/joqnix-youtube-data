[{"type": "subtitle", "time": 8281.03, "timestamp": "02:18:01", "text": "午前6時から何時までバットのボード"}, {"type": "subtitle", "time": 8283.11, "timestamp": "02:18:03", "text": "私たちにはそれがありますか？何個ありますか？我々は持っています"}, {"type": "subtitle", "time": 8285.99, "timestamp": "02:18:05", "text": "現在、2件の取引があります。いや、いや。何人ですか"}, {"type": "subtitle", "time": 8294.389, "timestamp": "02:18:14", "text": "なんてこった。私たちは持っています 私たちは持っています 私は20を持っています。"}, {"type": "subtitle", "time": 8299.11, "timestamp": "02:18:19", "text": "20個あります。7個ですよね？私は12と7を持っています。"}, {"type": "subtitle", "time": 8301.27, "timestamp": "02:18:21", "text": "わかった。 3 4. よし、それでいい。うん、"}, {"type": "subtitle", "time": 8305.83, "timestamp": "02:18:25", "text": "それは良い。ええと、ずっと夜遅くまで。"}, {"type": "subtitle", "time": 8307.589, "timestamp": "02:18:27", "text": "ええ、もう遅い時間に設定されているんです"}, {"type": "subtitle", "time": 8310.309, "timestamp": "02:18:30", "text": "夜。また、いくつか質問をしてみましょう"}, {"type": "subtitle", "time": 8313.669, "timestamp": "02:18:33", "text": "販売店から。誰か注文できますか？"}, {"type": "subtitle", "time": 8317.509, "timestamp": "02:18:37", "text": "注文します。えっと、いくらですか？待って、私たちは"}, {"type": "subtitle", "time": 8327.83, "timestamp": "02:18:47", "text": "えっと、タバコを買って、"}, {"type": "subtitle", "time": 8330.83, "timestamp": "02:18:50", "text": "バグ。おいおい、頼むよ。そこにいる"}, {"type": "subtitle", "time": 8334.549, "timestamp": "02:18:54", "text": "行く。よし。これは徐々に"}]
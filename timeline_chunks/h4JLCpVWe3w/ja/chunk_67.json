[{"type": "subtitle", "time": 4021.43, "timestamp": "01:07:01", "text": "イマンは今夜、毎回計画します。"}, {"type": "subtitle", "time": 4024.309, "timestamp": "01:07:04", "text": "今日中に彼を殺せ。ええと、私は自分が"}, {"type": "subtitle", "time": 4026.15, "timestamp": "01:07:06", "text": "ナルシストだが、電話する必要はなかった"}, {"type": "subtitle", "time": 4030.549, "timestamp": "01:07:10", "text": "私を外します。彼はもうダメだ。彼はもう終わりだ。"}, {"type": "subtitle", "time": 4032.39, "timestamp": "01:07:12", "text": "えっと、それで、ニューゲームを押したんですよね？"}, {"type": "subtitle", "time": 4035.27, "timestamp": "01:07:15", "text": "新しいゲーム。うん。うん。わかった。名前を入力してください。"}, {"type": "subtitle", "time": 4038.63, "timestamp": "01:07:18", "text": "私たちの組織では、それを何と呼ぶべきでしょうか？"}, {"type": "subtitle", "time": 4047.109, "timestamp": "01:07:27", "text": "わかった。"}, {"type": "subtitle", "time": 4048.87, "timestamp": "01:07:28", "text": "ディズニーさん、冗談ですよ。やめてください"}, {"type": "subtitle", "time": 4051.47, "timestamp": "01:07:31", "text": "我々を殺せ。冗談だよ、みんな。私たちは"}, {"type": "subtitle", "time": 4055.67, "timestamp": "01:07:35", "text": "プロローグだけ読んでください。いいえ。そうです。なんてこった。私"}, {"type": "subtitle", "time": 4057.349, "timestamp": "01:07:37", "text": "プロローグを考えてみてください。おそらく"}, {"type": "subtitle", "time": 4059.75, "timestamp": "01:07:39", "text": "それ自体がやるべきことだ。学習できるように"}, {"type": "subtitle", "time": 4061.23, "timestamp": "01:07:41", "text": "やるべきこと。全て"}, {"type": "subtitle", "time": 4063.829, "timestamp": "01:07:43", "text": "右。 S. ああ、それはただ「オーケー」と書いてあるだけです。"}, {"type": "subtitle", "time": 4065.349, "timestamp": "01:07:45", "text": "ごめん。どうでも。どうでも。一度もない"}, {"type": "subtitle", "time": 4066.87, "timestamp": "01:07:46", "text": "心。それはセックスだと思った"}, {"type": "subtitle", "time": 4073.27, "timestamp": "01:07:53", "text": "ああ、目が覚めたよ、みんな。目が覚める。"}, {"type": "subtitle", "time": 4075.76, "timestamp": "01:07:55", "text": "目が覚める。 灰と塵。"}, {"type": "subtitle", "time": 4078.799, "timestamp": "01:07:58", "text": "灰と塵。 何てことだ。まるで『ブレイキング・バッド』みたいだ。その"}]
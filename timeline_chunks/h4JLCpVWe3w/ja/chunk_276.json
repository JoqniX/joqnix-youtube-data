[{"type": "subtitle", "time": 16561.189, "timestamp": "04:36:01", "text": "待って、彼らはホラーが得意だったのか、それとも"}, {"type": "subtitle", "time": 16562.789, "timestamp": "04:36:02", "text": "何か？"}, {"type": "subtitle", "time": 16564.39, "timestamp": "04:36:04", "text": "誰が？"}, {"type": "subtitle", "time": 16567.269, "timestamp": "04:36:07", "text": "キュウ。"}, {"type": "subtitle", "time": 16568.709, "timestamp": "04:36:08", "text": "ええ、彼らはホラーが得意です。そうだった"}, {"type": "subtitle", "time": 16570.629, "timestamp": "04:36:10", "text": "「クソッ！」と叫んだのは私だけだった。私はこう思う、"}, {"type": "subtitle", "time": 16573.75, "timestamp": "04:36:13", "text": "「開けて、開けて、走り去って、私は"}, {"type": "subtitle", "time": 16576.189, "timestamp": "04:36:16", "text": "クソッ"}, {"type": "subtitle", "time": 16578.869, "timestamp": "04:36:18", "text": "死んだ。」とても楽しかった。"}, {"type": "subtitle", "time": 16581.51, "timestamp": "04:36:21", "text": "セレストやカイラのストリームみたいに出て行く"}, {"type": "subtitle", "time": 16585.91, "timestamp": "04:36:25", "text": "ストリーム。すばらしい。また、覚えておいてください"}, {"type": "subtitle", "time": 16588.551, "timestamp": "04:36:28", "text": "ストリームをクリップしてください。これらは良いものです"}, {"type": "subtitle", "time": 16590.869, "timestamp": "04:36:30", "text": "良いクリップですね。良いクリップですね。はい、お伝えします"}, {"type": "subtitle", "time": 16594.949, "timestamp": "04:36:34", "text": "配信が終わったら、あなたはすべてを手に入れます。うん、"}, {"type": "subtitle", "time": 16597.91, "timestamp": "04:36:37", "text": "知っている。ショックです。彼女はなぜでも私は"}, {"type": "subtitle", "time": 16602.07, "timestamp": "04:36:42", "text": "それでも君を困らせる。背後に気をつけろ。"}, {"type": "subtitle", "time": 16604.949, "timestamp": "04:36:44", "text": "私はそうは思いません。いいえ、彼女はそうしません。彼女は"}, {"type": "subtitle", "time": 16608.47, "timestamp": "04:36:48", "text": "彼女はチェーンソーマンみたいに頑張ってる。"}]
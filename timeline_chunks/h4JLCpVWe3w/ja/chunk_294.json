[{"type": "subtitle", "time": 17640.23, "timestamp": "04:54:00", "text": "うん。こちらをご覧ください。保留中です。あなたはここにいますか？あなた"}, {"type": "subtitle", "time": 17641.75, "timestamp": "04:54:01", "text": "スピリットボックスで彼の声を聞くことができるが、"}, {"type": "subtitle", "time": 17643.99, "timestamp": "04:54:03", "text": "彼をその名前のように呼ぶことができます"}, {"type": "subtitle", "time": 17645.75, "timestamp": "04:54:05", "text": "誰でも彼に電話できますが、聞くためには"}, {"type": "subtitle", "time": 17654.31, "timestamp": "04:54:14", "text": "ああ、ライトをつけすぎた、"}, {"type": "subtitle", "time": 17656.708, "timestamp": "04:54:16", "text": "推測。待って、ライトは何個あるの？"}, {"type": "subtitle", "time": 17660.47, "timestamp": "04:54:20", "text": "あれ？私は数えませんでした。ごめんなさい。"}, {"type": "subtitle", "time": 17661.47, "timestamp": "04:54:21", "text": "それは"}, {"type": "subtitle", "time": 17665.708, "timestamp": "04:54:25", "text": "車。だから、私は電源を切るべきだ"}, {"type": "subtitle", "time": 17669.35, "timestamp": "04:54:29", "text": "えっと、これ。正門のスイッチを入れないでください"}, {"type": "subtitle", "time": 17672.59, "timestamp": "04:54:32", "text": "出口ゲート付近のような場所が明るい。わかった。"}, {"type": "subtitle", "time": 17676.55, "timestamp": "04:54:36", "text": "ええと、残りはオフにできます。"}, {"type": "subtitle", "time": 17693.83, "timestamp": "04:54:53", "text": "クラッシュ？ああ、本当にRAMの増設が必要だ。"}, {"type": "subtitle", "time": 17696.23, "timestamp": "04:54:56", "text": "RAMをアップグレードするつもりだよ、もし"}, {"type": "subtitle", "time": 17698.83, "timestamp": "04:54:58", "text": "売上が入る。"}]
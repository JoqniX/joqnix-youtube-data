[{"type": "subtitle", "time": 7920.35, "timestamp": "02:12:00", "text": "地獄？ああ、それで22ドルもらったよ。聖なる"}, {"type": "subtitle", "time": 7925.669, "timestamp": "02:12:05", "text": "くそっ。待って、ここに鮭を入れてもいいよ。"}, {"type": "subtitle", "time": 7926.75, "timestamp": "02:12:06", "text": "何"}, {"type": "subtitle", "time": 7928.55, "timestamp": "02:12:08", "text": "地獄？"}, {"type": "subtitle", "time": 7931.709, "timestamp": "02:12:11", "text": "サムのことが怖いですか、それとも"}, {"type": "subtitle", "time": 7934.39, "timestamp": "02:12:14", "text": "何？バレた。"}, {"type": "subtitle", "time": 7938.47, "timestamp": "02:12:18", "text": "あなたは、あなたは一体何者ですか？なんてこった。"}, {"type": "subtitle", "time": 7940.31, "timestamp": "02:12:20", "text": "捕まえたぞ。バレた。あなたが言ったのはそういうことですか？"}, {"type": "subtitle", "time": 7943.589, "timestamp": "02:12:23", "text": "バレちゃったね。ポポ。ポポ。ポポ。あなた あなた"}, {"type": "subtitle", "time": 7945.39, "timestamp": "02:12:25", "text": "壊れた、つまり"}, {"type": "subtitle", "time": 7947.39, "timestamp": "02:12:27", "text": "ない"}, {"type": "subtitle", "time": 7954.629, "timestamp": "02:12:34", "text": "いいえ。わかりました。製品。うん。これは"}, {"type": "subtitle", "time": 7977.83, "timestamp": "02:12:57", "text": "私はこの分野における神だ。私は"}]
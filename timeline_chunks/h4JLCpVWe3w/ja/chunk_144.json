[{"type": "subtitle", "time": 8648.389, "timestamp": "02:24:08", "text": "私はジェシーが大好きです。彼女は私の初恋の人だった。"}, {"type": "subtitle", "time": 8650.95, "timestamp": "02:24:10", "text": "私は彼女を殺してやる。これが私が"}, {"type": "subtitle", "time": 8652.95, "timestamp": "02:24:12", "text": "今はどうなる？彼女が持っているあれは何ですか"}, {"type": "subtitle", "time": 8655.349, "timestamp": "02:24:15", "text": "保持していますか？それはボトルです。割れた瓶"}, {"type": "subtitle", "time": 8663.67, "timestamp": "02:24:23", "text": "ジェシー、黙れ。"}, {"type": "subtitle", "time": 8666.79, "timestamp": "02:24:26", "text": "ジェス。こんにちは。コーラを飲んでください。コーラを飲んでください。"}, {"type": "subtitle", "time": 8669.51, "timestamp": "02:24:29", "text": "コーラを飲んでください。さあ行こう、ジェシー。良い"}, {"type": "subtitle", "time": 8673.19, "timestamp": "02:24:33", "text": "ゴミ箱に放り込んでやるよ。"}, {"type": "subtitle", "time": 8675.309, "timestamp": "02:24:35", "text": "ごめんなさい、"}, {"type": "subtitle", "time": 8683.75, "timestamp": "02:24:43", "text": "さようなら、ジェシー。では、少し飲ませてください。"}, {"type": "subtitle", "time": 8693.19, "timestamp": "02:24:53", "text": "顔。ああ、ジェシー。"}, {"type": "subtitle", "time": 8695.349, "timestamp": "02:24:55", "text": "ジェシーに2ドル。彼女はそれほどケチなんだ。おお、"}, {"type": "subtitle", "time": 8698.15, "timestamp": "02:24:58", "text": "彼女は生きていない。"}]
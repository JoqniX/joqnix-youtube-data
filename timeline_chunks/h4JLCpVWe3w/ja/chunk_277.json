[{"type": "subtitle", "time": 16622.15, "timestamp": "04:37:02", "text": "そして彼女は私が行くことになる"}, {"type": "subtitle", "time": 16623.91, "timestamp": "04:37:03", "text": "しばらく沈黙が続いた。彼女ができるかどうか見てみましょう"}, {"type": "subtitle", "time": 16626.949, "timestamp": "04:37:06", "text": "私を見つけてください。わかった。待って、あなたは話していましたか？"}, {"type": "subtitle", "time": 16629.349, "timestamp": "04:37:09", "text": "ゲーム内でずっとこの間ずっと？ああ、私はそうではなかった"}, {"type": "subtitle", "time": 16631.51, "timestamp": "04:37:11", "text": "ゲーム内で会話する。私はあなたと話していました。"}, {"type": "subtitle", "time": 16632.949, "timestamp": "04:37:12", "text": "もう話すのはやめます。私は必要としている"}, {"type": "subtitle", "time": 16636.31, "timestamp": "04:37:16", "text": "水分補給。わかった。わかった。わかった。わかった。見て"}, {"type": "subtitle", "time": 16640.15, "timestamp": "04:37:20", "text": "そこにただ立っている私を見て。"}, {"type": "subtitle", "time": 16643.83, "timestamp": "04:37:23", "text": "ああ、彼女が私に向かってくる。彼女はそうなのか？いいえ。"}, {"type": "subtitle", "time": 16650.23, "timestamp": "04:37:30", "text": "待って、彼女はここにいるの？くそ。いや、いや、いや。"}, {"type": "subtitle", "time": 16654.15, "timestamp": "04:37:34", "text": "彼女は私より上の立場ですか？"}, {"type": "subtitle", "time": 16656.551, "timestamp": "04:37:36", "text": "ああ、彼女は上だと思うよ。いや、違う。あなた"}, {"type": "subtitle", "time": 16659.189, "timestamp": "04:37:39", "text": "何が起こったか知っていますか？私は彼女を見た。の"}, {"type": "subtitle", "time": 16662.47, "timestamp": "04:37:42", "text": "照明がちらついた。私は怖くて"}, {"type": "subtitle", "time": 16665.109, "timestamp": "04:37:45", "text": "ボール。私はそこへ行って探しました"}, {"type": "subtitle", "time": 16666.869, "timestamp": "04:37:46", "text": "どこかで、君が死ぬのを見たよ。だから私は"}, {"type": "subtitle", "time": 16669.109, "timestamp": "04:37:49", "text": "動きを止めて、"}, {"type": "subtitle", "time": 16670.949, "timestamp": "04:37:50", "text": "彼女があなたを殺そうとしていることを知っていたから、私は彼女の味方だった。"}]
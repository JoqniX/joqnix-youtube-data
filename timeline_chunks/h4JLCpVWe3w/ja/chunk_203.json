[{"type": "subtitle", "time": 12182.79, "timestamp": "03:23:02", "text": "あれ、誰かが余分に電気をつけたの？"}, {"type": "subtitle", "time": 12184.349, "timestamp": "03:23:04", "text": "私は振り返らなかった"}, {"type": "subtitle", "time": 12192.469, "timestamp": "03:23:12", "text": "うん、ソフィーかもしれないね。ああ、ソフィーは"}, {"type": "subtitle", "time": 12194.99, "timestamp": "03:23:14", "text": "ここ。"}, {"type": "subtitle", "time": 12198.07, "timestamp": "03:23:18", "text": "はい。私たちがここにいる理由。おそらく"}, {"type": "subtitle", "time": 12199.83, "timestamp": "03:23:19", "text": "彼女は「おい、バカども」って感じ。くそ"}, {"type": "subtitle", "time": 12202.15, "timestamp": "03:23:22", "text": "自分。わかった。"}, {"type": "subtitle", "time": 12209.269, "timestamp": "03:23:29", "text": "なんだこれ？"}, {"type": "subtitle", "time": 12211.51, "timestamp": "03:23:31", "text": "この写真を撮ったのは誰？待って、"}, {"type": "subtitle", "time": 12213.99, "timestamp": "03:23:33", "text": "何？"}, {"type": "subtitle", "time": 12215.59, "timestamp": "03:23:35", "text": "誰かがいくつかのものを叩き落とした"}, {"type": "subtitle", "time": 12220.429, "timestamp": "03:23:40", "text": "テーブル。ああ、ソフィーですね"}, {"type": "subtitle", "time": 12227.03, "timestamp": "03:23:47", "text": "待って、これを使うための何か見つかった？"}, {"type": "subtitle", "time": 12229.269, "timestamp": "03:23:49", "text": "そんなに批判するべきなの？"}, {"type": "subtitle", "time": 12230.83, "timestamp": "03:23:50", "text": "いいえ。"}, {"type": "subtitle", "time": 12235.75, "timestamp": "03:23:55", "text": "ああ、逃げろ。いくらですか？いくら？"}, {"type": "subtitle", "time": 12238.71, "timestamp": "03:23:58", "text": "EMFはいくつあるんだ、バカ？三つ。私は"}]
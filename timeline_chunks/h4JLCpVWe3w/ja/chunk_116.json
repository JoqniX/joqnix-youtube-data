[{"type": "subtitle", "time": 6963.75, "timestamp": "01:56:03", "text": "待って。オンラインでは取るに足らない存在です。どうすればいいですか"}, {"type": "subtitle", "time": 6966.149, "timestamp": "01:56:06", "text": "ゼロです。ああ、ATMに行くと"}, {"type": "subtitle", "time": 6969.109, "timestamp": "01:56:09", "text": "ここ外"}, {"type": "subtitle", "time": 6971.83, "timestamp": "01:56:11", "text": "そして現金を預け入れてください。"}, {"type": "subtitle", "time": 6973.83, "timestamp": "01:56:13", "text": "ATMに投入する。"}, {"type": "subtitle", "time": 6974.99, "timestamp": "01:56:14", "text": "よし。"}, {"type": "subtitle", "time": 6985.43, "timestamp": "01:56:25", "text": "ああ、私も100点もらえるよ。"}, {"type": "subtitle", "time": 6989.99, "timestamp": "01:56:29", "text": "それ？いいえ。銀行は閉鎖されています。現金はそうではない。おお、"}, {"type": "subtitle", "time": 6993.589, "timestamp": "01:56:33", "text": "わかった。やっと分かった。わかった。わかった。唯一"}, {"type": "subtitle", "time": 6996.229, "timestamp": "01:56:36", "text": "土壌ですよね？あるいは、「うん」みたいな感じ。うん。 1つ"}, {"type": "subtitle", "time": 6998.709, "timestamp": "01:56:38", "text": "選択。うん。"}, {"type": "subtitle", "time": 7005.51, "timestamp": "01:56:45", "text": "私はビスケットを食べていました。知っている。私は聞いた"}, {"type": "subtitle", "time": 7007.189, "timestamp": "01:56:47", "text": "それ。"}, {"type": "subtitle", "time": 7010.229, "timestamp": "01:56:50", "text": "選択肢は一つしかない。"}, {"type": "subtitle", "time": 7013.83, "timestamp": "01:56:53", "text": "よし。土を手に入れました。ごめん。チリ。"}, {"type": "subtitle", "time": 7018.07, "timestamp": "01:56:58", "text": "こんにちは、Wさん。"}]
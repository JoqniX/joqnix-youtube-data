[{"type": "subtitle", "time": 5290.78, "timestamp": "01:28:10", "text": "待って、"}, {"type": "subtitle", "time": 5300.07, "timestamp": "01:28:20", "text": "今、料理してるよ。"}, {"type": "subtitle", "time": 5302.03, "timestamp": "01:28:22", "text": "私は"}, {"type": "subtitle", "time": 5306.43, "timestamp": "01:28:26", "text": "キャラクター。ベッド2台。ここは"}, {"type": "subtitle", "time": 5310.149, "timestamp": "01:28:30", "text": "私たちの車はどこですか？私はカスタマイズしています"}, {"type": "subtitle", "time": 5313.79, "timestamp": "01:28:33", "text": "私の性格。持続する。これも"}, {"type": "subtitle", "time": 5323.51, "timestamp": "01:28:43", "text": "神様、私がゲームをプレイしているとき、新しい"}, {"type": "subtitle", "time": 5325.31, "timestamp": "01:28:45", "text": "ゲーム、"}, {"type": "subtitle", "time": 5335.11, "timestamp": "01:28:55", "text": "サンダル。あ、サンダルを履きます。"}, {"type": "subtitle", "time": 5336.43, "timestamp": "01:28:56", "text": "全て"}, {"type": "subtitle", "time": 5339.87, "timestamp": "01:28:59", "text": "右。私の青いサンダル。そこにいる"}]
[{"type": "subtitle", "time": 17040.55, "timestamp": "04:44:00", "text": "でも、その部屋のあたりではね。私はしません"}, {"type": "subtitle", "time": 17044.07, "timestamp": "04:44:04", "text": "できると思う。彼女は私の声を聞いてくれるだろう。"}, {"type": "subtitle", "time": 17046.35, "timestamp": "04:44:06", "text": "えっと、待って、"}, {"type": "subtitle", "time": 17051.708, "timestamp": "04:44:11", "text": "一緒に歩く。あ、待って。そうそう。私は"}, {"type": "subtitle", "time": 17053.47, "timestamp": "04:44:13", "text": "ジャンプする。"}, {"type": "subtitle", "time": 17057.19, "timestamp": "04:44:17", "text": "おい、くたばれ。おばけ。くたばれ。私を殺して、"}, {"type": "subtitle", "time": 17059.19, "timestamp": "04:44:19", "text": "クソ野郎。[ __ ]。おばけ。見えない"}, {"type": "subtitle", "time": 17063.51, "timestamp": "04:44:23", "text": "お前だ、だが、かかってこい。かかってこいよ、この[ __ ]。"}, {"type": "subtitle", "time": 17078.07, "timestamp": "04:44:38", "text": "何もない。ドアの音が聞こえる。ドア"}, {"type": "subtitle", "time": 17085.27, "timestamp": "04:44:45", "text": "音。はぁ？本気ですか？なぜなら私は"}, {"type": "subtitle", "time": 17087.91, "timestamp": "04:44:47", "text": "何も見えない。"}, {"type": "subtitle", "time": 17091.03, "timestamp": "04:44:51", "text": "彼女は何も音を立てていない。"}, {"type": "subtitle", "time": 17094.15, "timestamp": "04:44:54", "text": "何もない。なぜこれほど大幅な遅延が発生しているのですか？いいえ、"}, {"type": "subtitle", "time": 17096.91, "timestamp": "04:44:56", "text": "遅延の意味"}, {"type": "subtitle", "time": 17099.27, "timestamp": "04:44:59", "text": "ギャップ。待って、彼女は変わったと思う"}]
[{"type": "subtitle", "time": 9918.07, "timestamp": "02:45:18", "text": "よし、午後のセールがあるぞ"}, {"type": "subtitle", "time": 9919.63, "timestamp": "02:45:19", "text": "と共に"}, {"type": "subtitle", "time": 9925.99, "timestamp": "02:45:25", "text": "タコス。おい、君。ああ、ダブ。おいおい、勘弁してくれよ。"}, {"type": "subtitle", "time": 9929.429, "timestamp": "02:45:29", "text": "うん。ニース。取引が成立しました"}, {"type": "subtitle", "time": 9954.75, "timestamp": "02:45:54", "text": "土壌は馬を手に入れようとしている"}, {"type": "subtitle", "time": 9956.67, "timestamp": "02:45:56", "text": "え。"}, {"type": "subtitle", "time": 9959.83, "timestamp": "02:45:59", "text": "何？何？わかった、私はいくつか"}]
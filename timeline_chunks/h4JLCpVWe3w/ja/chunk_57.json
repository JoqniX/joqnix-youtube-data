[{"type": "subtitle", "time": 3420.23, "timestamp": "00:57:00", "text": "ああ、TK。うん。うん。待って、それは何のために"}, {"type": "subtitle", "time": 3424.23, "timestamp": "00:57:04", "text": "ソロレベリングのエンディング。何だって？"}, {"type": "subtitle", "time": 3426.309, "timestamp": "00:57:06", "text": "EKは今年、多くのことを成し遂げてきた。"}, {"type": "subtitle", "time": 3429.43, "timestamp": "00:57:09", "text": "彼は私のヒーローOPをやった。一体どういうことだ？彼は"}, {"type": "subtitle", "time": 3433.87, "timestamp": "00:57:13", "text": "私のヒーロー。うん。うん。うん。"}, {"type": "subtitle", "time": 3436.75, "timestamp": "00:57:16", "text": "右。"}, {"type": "subtitle", "time": 3439.67, "timestamp": "00:57:19", "text": "何？わかりません。だから、彼は"}, {"type": "subtitle", "time": 3442.309, "timestamp": "00:57:22", "text": "どこかでアニメのオープニングをもう1つやったか、"}, {"type": "subtitle", "time": 3445.19, "timestamp": "00:57:25", "text": "まるで歌みたい、わからない。 DK"}, {"type": "subtitle", "time": 3446.789, "timestamp": "00:57:26", "text": "まるで、"}, {"type": "subtitle", "time": 3450.71, "timestamp": "00:57:30", "text": "ゴシック系とかエモ系のくだらないもの。ソロ"}, {"type": "subtitle", "time": 3452.87, "timestamp": "00:57:32", "text": "レベルアップは理にかなっている。そして私のヒーローは"}, {"type": "subtitle", "time": 3454.51, "timestamp": "00:57:34", "text": "ゴスを通り抜けて"}, {"type": "subtitle", "time": 3457.43, "timestamp": "00:57:37", "text": "段階。何？"}, {"type": "subtitle", "time": 3460.71, "timestamp": "00:57:40", "text": "何てことだ。"}]
[{"type": "subtitle", "time": 6361.03, "timestamp": "01:46:01", "text": "あなたはただ"}, {"type": "subtitle", "time": 6364.31, "timestamp": "01:46:04", "text": "さっさと家に入れよ。"}, {"type": "subtitle", "time": 6367.35, "timestamp": "01:46:07", "text": "ああ、分かってほしいんだ。"}, {"type": "subtitle", "time": 6369.91, "timestamp": "01:46:09", "text": "おっと。ああ、ゲームをセーブできるよ。ゲーム"}, {"type": "subtitle", "time": 6374.229, "timestamp": "01:46:14", "text": "保存。うん。うん。保存。あなたを引っ張って"}, {"type": "subtitle", "time": 6376.55, "timestamp": "01:46:16", "text": "外にいてください。私は寝ています。うん。うん。"}, {"type": "subtitle", "time": 6379.669, "timestamp": "01:46:19", "text": "うん。うん。他のプレイヤーのために睡眠時間を確保する。"}, {"type": "subtitle", "time": 6381.99, "timestamp": "01:46:21", "text": "何てことだ。"}, {"type": "subtitle", "time": 6386.83, "timestamp": "01:46:26", "text": "どうしたの？何がそんなに悲しいの？私は手に入れた"}, {"type": "subtitle", "time": 6389.51, "timestamp": "01:46:29", "text": "ちょうど走って入ってきたところだった。私は行きます"}, {"type": "subtitle", "time": 6391.91, "timestamp": "01:46:31", "text": "彼がビデオゲームをしている間"}, {"type": "subtitle", "time": 6394.87, "timestamp": "01:46:34", "text": "そこにはない。何てことだ。よし。全て"}, {"type": "subtitle", "time": 6397.27, "timestamp": "01:46:37", "text": "右。そうするつもりです。あ、待って。"}, {"type": "subtitle", "time": 6400.709, "timestamp": "01:46:40", "text": "これで大丈夫です。でも、それを教えてよ。できますか？"}, {"type": "subtitle", "time": 6404.39, "timestamp": "01:46:44", "text": "ビデオゲームをしながら私を見てるの？"}, {"type": "subtitle", "time": 6406.79, "timestamp": "01:46:46", "text": "何も書いていない。"}, {"type": "subtitle", "time": 6409.109, "timestamp": "01:46:49", "text": "ああ、わかりました。キャラクターが私を見るとき"}, {"type": "subtitle", "time": 6411.91, "timestamp": "01:46:51", "text": "私はあなたのそばにいます。"}, {"type": "subtitle", "time": 6414.47, "timestamp": "01:46:54", "text": "こんにちは。寝よう。"}, {"type": "subtitle", "time": 6417.99, "timestamp": "01:46:57", "text": "よし。まるでマインクラフトみたいだ。"}]
[{"type": "subtitle", "time": 4862.47, "timestamp": "01:21:02", "text": "マテル社の担当者から。"}, {"type": "subtitle", "time": 4864.63, "timestamp": "01:21:04", "text": "でも、あなたはそうする。うん。うん、大丈夫だよ"}, {"type": "subtitle", "time": 4871.27, "timestamp": "01:21:11", "text": "ラインの狙い。実際、すでにいくらかの借金がある"}, {"type": "subtitle", "time": 4873.59, "timestamp": "01:21:13", "text": "現金。なんてこった。彼は"}, {"type": "subtitle", "time": 4876.83, "timestamp": "01:21:16", "text": "彼を崇拝する"}, {"type": "subtitle", "time": 4879.669, "timestamp": "01:21:19", "text": "すぐ。今日は盆栽。大丈夫。しかし、もしそれが"}, {"type": "subtitle", "time": 4882.27, "timestamp": "01:21:22", "text": "支払わなければ、彼は支払うことになる。"}, {"type": "subtitle", "time": 4885.189, "timestamp": "01:21:25", "text": "わかった。ああ、くそ。ああ、くそ。ああ、くそ。それは"}, {"type": "subtitle", "time": 4887.27, "timestamp": "01:21:27", "text": "警官だ。警官だ。殺してもいいですか？"}, {"type": "subtitle", "time": 4889.83, "timestamp": "01:21:29", "text": "彼？彼を殴り倒せ。彼を殴り倒せ。"}, {"type": "subtitle", "time": 4893.03, "timestamp": "01:21:33", "text": "彼を殴り倒せ。彼を殴り倒せ。彼を殴り倒せ。"}, {"type": "subtitle", "time": 4896.07, "timestamp": "01:21:36", "text": "彼を殺してもいいですか？えっと、彼をノックしてもいいですよ"}, {"type": "subtitle", "time": 4897.669, "timestamp": "01:21:37", "text": "オフ。ああ、そいつをやっつけろ。ええ、ただ"}, {"type": "subtitle", "time": 4900.95, "timestamp": "01:21:40", "text": "彼を殺した。いや、ただ轢いてしまっただけだ。おお、"}, {"type": "subtitle", "time": 4902.31, "timestamp": "01:21:42", "text": "その方が効率的だ。それは それは"}, {"type": "subtitle", "time": 4903.91, "timestamp": "01:21:43", "text": "大丈夫。ああ、神様。いいえ、彼は生きています。何"}, {"type": "subtitle", "time": 4906.79, "timestamp": "01:21:46", "text": "くそ？一体どういうことだ？私はあなたを打ち砕いた、"}, {"type": "subtitle", "time": 4910.55, "timestamp": "01:21:50", "text": "男。何だって？でも、技術的には"}, {"type": "subtitle", "time": 4913.75, "timestamp": "01:21:53", "text": "体を避ける方法を教える"}, {"type": "subtitle", "time": 4916.709, "timestamp": "01:21:56", "text": "検索メカニック。私はただ走るだけです"}, {"type": "subtitle", "time": 4919.669, "timestamp": "01:21:59", "text": "離れて。牧場まで車で戻る。全て"}]
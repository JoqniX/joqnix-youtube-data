[{"type": "subtitle", "time": 3245.23, "timestamp": "00:54:05", "text": "くたばれ、モン。すべてはあなたのおかげです。"}, {"type": "subtitle", "time": 3247.75, "timestamp": "00:54:07", "text": "ああ、気分はどうですか？気分はどうですか、"}, {"type": "subtitle", "time": 3251.51, "timestamp": "00:54:11", "text": "相棒？気分はどうですか？"}, {"type": "subtitle", "time": 3255.03, "timestamp": "00:54:15", "text": "自分の息子にこんなことをするなんて、どういうこと？は"}, {"type": "subtitle", "time": 3258.069, "timestamp": "00:54:18", "text": "それがあなたの望みですか？"}, {"type": "subtitle", "time": 3270.39, "timestamp": "00:54:30", "text": "待って、Twitchでシェアチャットやってるの？"}, {"type": "subtitle", "time": 3276.47, "timestamp": "00:54:36", "text": "ミックスみたいだからやりたくない"}, {"type": "subtitle", "time": 3279.43, "timestamp": "00:54:39", "text": "チャット。うん、読むのは大変だろうね。"}, {"type": "subtitle", "time": 3281.19, "timestamp": "00:54:41", "text": "うん。"}, {"type": "subtitle", "time": 3285.589, "timestamp": "00:54:45", "text": "おそらく役に立つであろうデバイスだが、"}, {"type": "subtitle", "time": 3289.349, "timestamp": "00:54:49", "text": "うん。つまり、Twitchは"}, {"type": "subtitle", "time": 3299.67, "timestamp": "00:54:59", "text": "私はこの画面で配信を開始しました。"}]
[{"type": "subtitle", "time": 12001.83, "timestamp": "03:20:01", "text": "ソフィーがイギリス人かどうか見てみましょう。"}, {"type": "subtitle", "time": 12004.15, "timestamp": "03:20:04", "text": "あなたはここにいますか？ソフィー、ここにいる？"}, {"type": "subtitle", "time": 12006.79, "timestamp": "03:20:06", "text": "ソフィー、ここにいる？彼女に、"}, {"type": "subtitle", "time": 12008.309, "timestamp": "03:20:08", "text": "イギリス人。"}, {"type": "subtitle", "time": 12014.71, "timestamp": "03:20:14", "text": "彼女は二階にいると思う。本気ですか？"}, {"type": "subtitle", "time": 12017.269, "timestamp": "03:20:17", "text": "うん。何てことだ。これはこの部屋は"}, {"type": "subtitle", "time": 12020.71, "timestamp": "03:20:20", "text": "めちゃくちゃ明るい。"}, {"type": "subtitle", "time": 12023.51, "timestamp": "03:20:23", "text": "道はどこにあるのですか？ああ、こちらです。ソフィー、"}, {"type": "subtitle", "time": 12033.07, "timestamp": "03:20:33", "text": "ソフィー、あなたは"}, {"type": "subtitle", "time": 12036.07, "timestamp": "03:20:36", "text": "イギリス人？あなたはイギリス人のソフィーですか？"}, {"type": "subtitle", "time": 12038.87, "timestamp": "03:20:38", "text": "ソフィー、ここにいる？あなたはDoにいますか？"}, {"type": "subtitle", "time": 12042.229, "timestamp": "03:20:42", "text": "何をお持ちですか？はぁ？あなたは持っていますか"}, {"type": "subtitle", "time": 12045.03, "timestamp": "03:20:45", "text": "ビスケットはありますか？"}, {"type": "subtitle", "time": 12052.15, "timestamp": "03:20:52", "text": "あなたは旅行しますか?"}, {"type": "subtitle", "time": 12053.83, "timestamp": "03:20:53", "text": "飛行機？"}]
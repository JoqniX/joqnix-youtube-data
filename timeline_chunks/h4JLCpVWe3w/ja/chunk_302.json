[{"type": "subtitle", "time": 18121.75, "timestamp": "05:02:01", "text": "彼らは、いや、いや、塩を取ってください。わかった。でも私は"}, {"type": "subtitle", "time": 18125.11, "timestamp": "05:02:05", "text": "塩は使えません。あ、待って。"}, {"type": "subtitle", "time": 18127.03, "timestamp": "05:02:07", "text": "終わりました。"}, {"type": "subtitle", "time": 18130.07, "timestamp": "05:02:10", "text": "確か3回使ったと思います。あ、待って。"}, {"type": "subtitle", "time": 18131.51, "timestamp": "05:02:11", "text": "カメラを持って行ってください。取っていく"}, {"type": "subtitle", "time": 18133.75, "timestamp": "05:02:13", "text": "カメラ。カメラを持って行って。置く"}, {"type": "subtitle", "time": 18136.55, "timestamp": "05:02:16", "text": "あの転がる缶みたいなものの近くで。"}, {"type": "subtitle", "time": 18141.51, "timestamp": "05:02:21", "text": "転がる缶の近くに置いてください"}, {"type": "subtitle", "time": 18144.15, "timestamp": "05:02:24", "text": "何かあるかどうか確認できるように"}, {"type": "subtitle", "time": 18148.55, "timestamp": "05:02:28", "text": "球体であろうとなかろうと。マイクには使用しないでください。"}, {"type": "subtitle", "time": 18150.628, "timestamp": "05:02:30", "text": "ここに置いた方がいいですか？行く"}, {"type": "subtitle", "time": 18153.51, "timestamp": "05:02:33", "text": "後ろを振り返ってみてください。後ろを振り返ってみてください。"}, {"type": "subtitle", "time": 18156.948, "timestamp": "05:02:36", "text": "あの辺りのどこかに。ご覧いただけるように。"}, {"type": "subtitle", "time": 18158.628, "timestamp": "05:02:38", "text": "いいえ。いいえ。棚の中にあります。棚の中に。で"}, {"type": "subtitle", "time": 18159.788, "timestamp": "05:02:39", "text": "棚。では"}, {"type": "subtitle", "time": 18161.788, "timestamp": "05:02:41", "text": "棚。場所"}, {"type": "subtitle", "time": 18163.708, "timestamp": "05:02:43", "text": "それ。おお"}, {"type": "subtitle", "time": 18167.27, "timestamp": "05:02:47", "text": "くそ。幽霊がいる。上へ行け。上へ行け。行く"}, {"type": "subtitle", "time": 18169.868, "timestamp": "05:02:49", "text": "上。走る。走る。どこかで。上へ行け。ない"}, {"type": "subtitle", "time": 18172.39, "timestamp": "05:02:52", "text": "そこには。うん。上へ行け。上へ行け。上へ行け。"}, {"type": "subtitle", "time": 18173.75, "timestamp": "05:02:53", "text": "内部。部屋の中に。内部"}, {"type": "subtitle", "time": 18174.948, "timestamp": "05:02:54", "text": "部屋。部屋の中。ドアを閉める。"}, {"type": "subtitle", "time": 18176.59, "timestamp": "05:02:56", "text": "部屋に入ってください"}, {"type": "subtitle", "time": 18179.43, "timestamp": "05:02:59", "text": "そしてドアを閉めてください。ドアを閉める。はい。"}]
[{"type": "subtitle", "time": 9540.15, "timestamp": "02:39:00", "text": "銀行の最上部で。これは、ああ、これは"}, {"type": "subtitle", "time": 9542.15, "timestamp": "02:39:02", "text": "オースティン。うん。"}, {"type": "subtitle", "time": 9544.309, "timestamp": "02:39:04", "text": "やあ、オースティン。元気かい？何てことだ。私"}, {"type": "subtitle", "time": 9547.75, "timestamp": "02:39:07", "text": "ここまで到達しました。"}, {"type": "subtitle", "time": 9550.15, "timestamp": "02:39:10", "text": "ガソリンスタンドに着いた。彼は"}, {"type": "subtitle", "time": 9552.389, "timestamp": "02:39:12", "text": "待っている。低品質のものを入手した。"}, {"type": "subtitle", "time": 9558.03, "timestamp": "02:39:18", "text": "あなた。はい、どうぞ。乾杯。うん、"}, {"type": "subtitle", "time": 9559.83, "timestamp": "02:39:19", "text": "何でも。よし、では"}, {"type": "subtitle", "time": 9566.07, "timestamp": "02:39:26", "text": "死体があって、"}, {"type": "subtitle", "time": 9569.83, "timestamp": "02:39:29", "text": "そういうことをずっとやってきたってこと、わかってるよ。"}, {"type": "subtitle", "time": 9572.23, "timestamp": "02:39:32", "text": "なぜ？まるで死体があるみたいだ。私は"}, {"type": "subtitle", "time": 9578.71, "timestamp": "02:39:38", "text": "私たちはお金を手に入れます。ブラッドウィグ、君は"}, {"type": "subtitle", "time": 9590.349, "timestamp": "02:39:50", "text": "それで終わり。待って。"}, {"type": "subtitle", "time": 9592.309, "timestamp": "02:39:52", "text": "ごめん。よし。わかった、"}, {"type": "subtitle", "time": 9595.11, "timestamp": "02:39:55", "text": "薬物が再び蔓延する。私も少し売らせてください。"}, {"type": "subtitle", "time": 9598.15, "timestamp": "02:39:58", "text": "しかし、健康状態は良好です。"}]
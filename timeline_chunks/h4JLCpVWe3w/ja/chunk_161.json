[{"type": "subtitle", "time": 9661.95, "timestamp": "02:41:01", "text": "電気植物剪定区画"}, {"type": "subtitle", "time": 9665.75, "timestamp": "02:41:05", "text": "スティック。俺は完全な悪党だ。"}, {"type": "subtitle", "time": 9669.75, "timestamp": "02:41:09", "text": "待って。混合ステーション。ああ、それは"}, {"type": "subtitle", "time": 9678.23, "timestamp": "02:41:18", "text": "ウェストウェル。おお、新しい地域が解放されました。"}, {"type": "subtitle", "time": 9680.99, "timestamp": "02:41:20", "text": "いいね、いいね、いいね、いいね。わかった、行くよ"}, {"type": "subtitle", "time": 9683.99, "timestamp": "02:41:23", "text": "その通りです。あなたはドアを開けて"}, {"type": "subtitle", "time": 9688.55, "timestamp": "02:41:28", "text": "自分。いや、それが君の得意分野なんだ。"}, {"type": "subtitle", "time": 9690.79, "timestamp": "02:41:30", "text": "くそ。いいえ。わかりました、買います"}, {"type": "subtitle", "time": 9698.83, "timestamp": "02:41:38", "text": "ホテル。ええと、部屋を買いたいのですが。"}, {"type": "subtitle", "time": 9701.03, "timestamp": "02:41:41", "text": "はい。後ろの部屋に入れる場所"}, {"type": "subtitle", "time": 9702.469, "timestamp": "02:41:42", "text": "上の階にあるレストラン。よし。"}, {"type": "subtitle", "time": 9704.79, "timestamp": "02:41:44", "text": "ウィンクさん、ありがとうございます。興味がありますか？"}, {"type": "subtitle", "time": 9707.429, "timestamp": "02:41:47", "text": "私たちのサンプルでしょうか？"}, {"type": "subtitle", "time": 9711.91, "timestamp": "02:41:51", "text": "良いものでも74%しかできないんだよ、兄弟。"}, {"type": "subtitle", "time": 9713.99, "timestamp": "02:41:53", "text": "ああ、できるよ。彼女はそれでも受け入れるだろう、私は"}, {"type": "subtitle", "time": 9719.27, "timestamp": "02:41:59", "text": "よし。"}]
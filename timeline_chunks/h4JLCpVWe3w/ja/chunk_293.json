[{"type": "subtitle", "time": 17581.75, "timestamp": "04:53:01", "text": "まず設定を開いてください"}, {"type": "subtitle", "time": 17584.55, "timestamp": "04:53:04", "text": "オプションに移動"}, {"type": "subtitle", "time": 17590.31, "timestamp": "04:53:10", "text": "ビデオをオフにして、明るさを50%に下げてください。"}, {"type": "subtitle", "time": 17593.59, "timestamp": "04:53:13", "text": "50は2.0になります。"}, {"type": "subtitle", "time": 17597.43, "timestamp": "04:53:17", "text": "うん。わかった。適用する。うん。ああ、それは"}, {"type": "subtitle", "time": 17600.47, "timestamp": "04:53:20", "text": "より明るく。わかった。うん。あなたはEMFを利用します。"}, {"type": "subtitle", "time": 17602.868, "timestamp": "04:53:22", "text": "誰がEMFを摂取するのか？"}, {"type": "subtitle", "time": 17605.43, "timestamp": "04:53:25", "text": "EMFをお持ちですか？わかった。"}, {"type": "subtitle", "time": 17608.868, "timestamp": "04:53:28", "text": "さあ、電源を入れて中に入ってください。わかった。する"}, {"type": "subtitle", "time": 17612.15, "timestamp": "04:53:32", "text": "塩も摂るの？はい。わかった。ニース。"}, {"type": "subtitle", "time": 17613.43, "timestamp": "04:53:33", "text": "EMFを例にとってみましょう。そして今チェック"}, {"type": "subtitle", "time": 17622.23, "timestamp": "04:53:42", "text": "聖なる。それは木造の家です。わかった。"}, {"type": "subtitle", "time": 17631.91, "timestamp": "04:53:51", "text": "これにより、V を押して質問することができます"}, {"type": "subtitle", "time": 17633.67, "timestamp": "04:53:53", "text": "保留中ですか？ここにいますか？私たちに"}, {"type": "subtitle", "time": 17636.83, "timestamp": "04:53:56", "text": "サイン。保留中。"}]
[{"type": "subtitle", "time": 13987.389, "timestamp": "03:53:07", "text": "[音楽]"}, {"type": "subtitle", "time": 14007.269, "timestamp": "03:53:27", "text": "あの緑色の箱みたいなのは何ですか？"}, {"type": "subtitle", "time": 14011.429, "timestamp": "03:53:31", "text": "ああ、緑。緑色の物体はおそらく"}, {"type": "subtitle", "time": 14015.229, "timestamp": "03:53:35", "text": "モーションセンサーのようなもの。ああ、モーションセンサーだ。"}, {"type": "subtitle", "time": 14023.83, "timestamp": "03:53:43", "text": "[音楽]"}, {"type": "subtitle", "time": 14027.269, "timestamp": "03:53:47", "text": "ああ、動きが意地悪だ。"}]
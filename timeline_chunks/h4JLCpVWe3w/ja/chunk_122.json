[{"type": "subtitle", "time": 7320.79, "timestamp": "02:02:00", "text": "ジャンプする。ええと、モーターの反対側です。"}, {"type": "subtitle", "time": 7334.87, "timestamp": "02:02:14", "text": "でも、地図を頼りにするべきだと思います。"}, {"type": "subtitle", "time": 7336.149, "timestamp": "02:02:16", "text": "うん、君は自分の"}, {"type": "subtitle", "time": 7338.47, "timestamp": "02:02:18", "text": "クソL。"}, {"type": "subtitle", "time": 7347.43, "timestamp": "02:02:27", "text": "みんな、私、このゲームすごく得意なんだよ。とは異なり"}, {"type": "subtitle", "time": 7355.75, "timestamp": "02:02:35", "text": "よし、みんな、乗って。一体何なんだ？"}, {"type": "subtitle", "time": 7359.589, "timestamp": "02:02:39", "text": "誰がこの場所を荒らしたんだ？何てことだ。何"}, {"type": "subtitle", "time": 7361.91, "timestamp": "02:02:41", "text": "これですか？私はこれをしていません。誰が"}, {"type": "subtitle", "time": 7365.03, "timestamp": "02:02:45", "text": "これだよ、兄弟？"}, {"type": "subtitle", "time": 7367.109, "timestamp": "02:02:47", "text": "犯人は君たちのうちの一人だった。神に誓って、もし"}, {"type": "subtitle", "time": 7369.669, "timestamp": "02:02:49", "text": "それはあなたたちのうちの一人です。私は持っていません"}, {"type": "subtitle", "time": 7372.149, "timestamp": "02:02:52", "text": "トランスジェンダーのこと。"}, {"type": "subtitle", "time": 7379.589, "timestamp": "02:02:59", "text": "お願いします。ドアを開けてください。ドアを開けてください。"}]
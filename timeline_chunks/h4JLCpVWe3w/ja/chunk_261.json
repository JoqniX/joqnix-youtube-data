[{"type": "subtitle", "time": 15662.389, "timestamp": "04:21:02", "text": "自分。彼女が出てくるときはいつでも。さて、えっと、あなたは"}, {"type": "subtitle", "time": 15664.149, "timestamp": "04:21:04", "text": "走る。"}, {"type": "subtitle", "time": 15667.75, "timestamp": "04:21:07", "text": "このガレージが見えますか？ここへ行ってください。中に入って"}, {"type": "subtitle", "time": 15671.59, "timestamp": "04:21:11", "text": "これをやって、それからこのように閉じます。うん。"}, {"type": "subtitle", "time": 15673.91, "timestamp": "04:21:13", "text": "そうすれば彼女はあなたを狩ることができない。私は行く"}, {"type": "subtitle", "time": 15675.55, "timestamp": "04:21:15", "text": "トラックに乗って、彼女がこのトラックに乗っていることを覚えておいてください"}, {"type": "subtitle", "time": 15677.83, "timestamp": "04:21:17", "text": "バスルームで、これを通して確認します"}, {"type": "subtitle", "time": 15679.269, "timestamp": "04:21:19", "text": "カメラ。ここにカメラがあります。病気"}, {"type": "subtitle", "time": 15685.349, "timestamp": "04:21:25", "text": "わかった。ライトが点灯した瞬間"}, {"type": "subtitle", "time": 15687.83, "timestamp": "04:21:27", "text": "オフですよね？わかった。耳にする瞬間"}, {"type": "subtitle", "time": 15689.75, "timestamp": "04:21:29", "text": "彼女は心臓の鼓動とか、そういう全てが好きなんです。"}, {"type": "subtitle", "time": 15691.59, "timestamp": "04:21:31", "text": "また、氷点下の気温にも注意してください。"}, {"type": "subtitle", "time": 15693.429, "timestamp": "04:21:33", "text": "氷点下の気温が見られる場合"}, {"type": "subtitle", "time": 15696.309, "timestamp": "04:21:36", "text": "ええ、それなら追加できます"}, {"type": "subtitle", "time": 15697.99, "timestamp": "04:21:37", "text": "証拠。"}, {"type": "subtitle", "time": 15701.03, "timestamp": "04:21:41", "text": "わかった。運動部員は4人いる。 4つあります"}, {"type": "subtitle", "time": 15703.429, "timestamp": "04:21:43", "text": "活動。ちょうど2にまで下がった"}, {"type": "subtitle", "time": 15704.87, "timestamp": "04:21:44", "text": "あなたがどこにいるか。バスルームで"}, {"type": "subtitle", "time": 15707.429, "timestamp": "04:21:47", "text": "彼女がそこにいる。ああ、ちらついている。"}, {"type": "subtitle", "time": 15708.429, "timestamp": "04:21:48", "text": "その"}, {"type": "subtitle", "time": 15712.149, "timestamp": "04:21:52", "text": "ちらつく。ルース、ここにいる？ルース、"}, {"type": "subtitle", "time": 15716.149, "timestamp": "04:21:56", "text": "あなたはここにいますか？中に入ってください。"}, {"type": "subtitle", "time": 15718.55, "timestamp": "04:21:58", "text": "急いで中に入って、シンクの近くに行ってください。"}, {"type": "subtitle", "time": 15719.83, "timestamp": "04:21:59", "text": "凍結しているかどうか確認してください"}]
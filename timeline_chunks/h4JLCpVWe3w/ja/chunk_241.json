[{"type": "subtitle", "time": 14461.91, "timestamp": "04:01:01", "text": "だから、一滴必要だ。私も一緒に行きます"}, {"type": "subtitle", "time": 14464.07, "timestamp": "04:01:04", "text": "あなた。私も一緒に行きます。右。あなたはただ"}, {"type": "subtitle", "time": 14466.55, "timestamp": "04:01:06", "text": "カメラを配置するだけで"}, {"type": "subtitle", "time": 14470.87, "timestamp": "04:01:10", "text": "幽霊の写真を撮る。わかった。"}, {"type": "subtitle", "time": 14477.99, "timestamp": "04:01:17", "text": "そして覚えておいてください、あなたは一人になる必要があります"}, {"type": "subtitle", "time": 14482.15, "timestamp": "04:01:22", "text": "これ。わかった。だから、待って、これを受け取って。"}, {"type": "subtitle", "time": 14484.469, "timestamp": "04:01:24", "text": "これを受け取って。カメラは私が持っていきます。わかった。"}, {"type": "subtitle", "time": 14485.99, "timestamp": "04:01:25", "text": "写真をお渡しします。写真"}, {"type": "subtitle", "time": 14488.469, "timestamp": "04:01:28", "text": "カメラ。写真カメラ。写真カメラ。"}, {"type": "subtitle", "time": 14491.03, "timestamp": "04:01:31", "text": "うん。このスピリットボックスを使って"}, {"type": "subtitle", "time": 14492.79, "timestamp": "04:01:32", "text": "一人でいることを忘れずに、切り替えないでください"}, {"type": "subtitle", "time": 14500.469, "timestamp": "04:01:40", "text": "あと、走りすぎないようにね？あなたは"}, {"type": "subtitle", "time": 14504.71, "timestamp": "04:01:44", "text": "息切れする。ああ、わかりました。"}, {"type": "subtitle", "time": 14506.389, "timestamp": "04:01:46", "text": "そして幽霊に話しかけるとき、"}, {"type": "subtitle", "time": 14508.15, "timestamp": "04:01:48", "text": "カメラをオンにする必要があります。つまり、そうではない"}, {"type": "subtitle", "time": 14519.67, "timestamp": "04:01:59", "text": "わかった。ああ、くそ。ああ、くそ。間違いです。"}]
[{"type": "subtitle", "time": 15426.07, "timestamp": "04:17:06", "text": "[音楽]"}, {"type": "subtitle", "time": 15427.83, "timestamp": "04:17:07", "text": "懐中電灯を少し消して"}, {"type": "subtitle", "time": 15433.67, "timestamp": "04:17:13", "text": "地下室に戻って"}, {"type": "subtitle", "time": 15435.11, "timestamp": "04:17:15", "text": "懐中電灯を点ける。そこに"}, {"type": "subtitle", "time": 15439.83, "timestamp": "04:17:19", "text": "球体は何かありますか。地下。わかった。うん。"}, {"type": "subtitle", "time": 15442.55, "timestamp": "04:17:22", "text": "えっと、人形がカチカチ鳴る音がする。私は"}, {"type": "subtitle", "time": 15444.149, "timestamp": "04:17:24", "text": "行くよ、えっと、行くよ"}, {"type": "subtitle", "time": 15447.349, "timestamp": "04:17:27", "text": "地下。うん。うん。うん。話さないで"}, {"type": "subtitle", "time": 15449.269, "timestamp": "04:17:29", "text": "ゲームの中で、ですよね？彼女が聞こえないように"}, {"type": "subtitle", "time": 15452.55, "timestamp": "04:17:32", "text": "あなた。わかった。うん、"}, {"type": "subtitle", "time": 15455.189, "timestamp": "04:17:35", "text": "もうお分かりでしょう。どこに"}, {"type": "subtitle", "time": 15457.99, "timestamp": "04:17:37", "text": "ジェネレータ？わかった。ええ、だから私は行かなきゃ"}, {"type": "subtitle", "time": 15460.07, "timestamp": "04:17:40", "text": "そこには。ああ、球体が見える。日記帳を持って"}, {"type": "subtitle", "time": 15462.63, "timestamp": "04:17:42", "text": "取り出してオーブを追加する。ジョック。"}, {"type": "subtitle", "time": 15466.149, "timestamp": "04:17:46", "text": "日記。証拠。うん。ゴーストオーブ。"}, {"type": "subtitle", "time": 15469.55, "timestamp": "04:17:49", "text": "さらに、スピリットボックスも追加してください。精神"}, {"type": "subtitle", "time": 15472.91, "timestamp": "04:17:52", "text": "箱。カイはオンですか？"}, {"type": "subtitle", "time": 15475.91, "timestamp": "04:17:55", "text": "何か聞こえましたか？いや、違うよ。しないでください"}, {"type": "subtitle", "time": 15477.67, "timestamp": "04:17:57", "text": "使用。わかった。何か聞こえましたか？来る。"}, {"type": "subtitle", "time": 15479.59, "timestamp": "04:17:59", "text": "やってくる。私と来て。私と来て。"}]
[{"type": "subtitle", "time": 5041.27, "timestamp": "01:24:01", "text": "実際、人間だ。それは"}, {"type": "subtitle", "time": 5043.51, "timestamp": "01:24:03", "text": "人間。えっと、私は理解できなかったと思う"}, {"type": "subtitle", "time": 5046.629, "timestamp": "01:24:06", "text": "なぜなら、えっと、私のインベントリがいっぱいだったからです。"}, {"type": "subtitle", "time": 5051.91, "timestamp": "01:24:11", "text": "私は植物も何もかも持ち帰りました。ああ、"}, {"type": "subtitle", "time": 5054.629, "timestamp": "01:24:14", "text": "すばらしい。"}, {"type": "subtitle", "time": 5057.43, "timestamp": "01:24:17", "text": "開始時点で、あなたの持ち物は満杯でした。"}, {"type": "subtitle", "time": 5059.669, "timestamp": "01:24:19", "text": "一体どういうことだ？"}, {"type": "subtitle", "time": 5061.11, "timestamp": "01:24:21", "text": "ああ、それは試してみないと。待って、待って、"}, {"type": "subtitle", "time": 5063.75, "timestamp": "01:24:23", "text": "持続する。"}, {"type": "subtitle", "time": 5068.07, "timestamp": "01:24:28", "text": "彼らがまだ生きていることを願っています"}, {"type": "subtitle", "time": 5071.03, "timestamp": "01:24:31", "text": "男はまだそこにいるが、彼は"}, {"type": "subtitle", "time": 5072.709, "timestamp": "01:24:32", "text": "引きずられた。どうやらまだ"}, {"type": "subtitle", "time": 5074.39, "timestamp": "01:24:34", "text": "身体検査はしたが、何もなかった。"}, {"type": "subtitle", "time": 5078.55, "timestamp": "01:24:38", "text": "彼。既に種子が含まれています。よし。"}, {"type": "subtitle", "time": 5081.59, "timestamp": "01:24:41", "text": "わかった。彼から金品を奪うのは無理だと思う。"}, {"type": "subtitle", "time": 5083.27, "timestamp": "01:24:43", "text": "準備ができたら寝てください。はい、私は"}, {"type": "subtitle", "time": 5086.11, "timestamp": "01:24:46", "text": "それでは、もう寝ます。"}, {"type": "subtitle", "time": 5089.39, "timestamp": "01:24:49", "text": "寝る。いいえ、私は"}, {"type": "subtitle", "time": 5096.31, "timestamp": "01:24:56", "text": "薬はちゃんと届きましたか？"}, {"type": "subtitle", "time": 5099.83, "timestamp": "01:24:59", "text": "ああ、プールが。ここに警察がいます。"}]
[{"type": "subtitle", "time": 4921.669, "timestamp": "01:22:01", "text": "右。"}, {"type": "subtitle", "time": 4923.99, "timestamp": "01:22:03", "text": "警察なんて誰が気にするんだよ？平"}, {"type": "subtitle", "time": 4925.99, "timestamp": "01:22:05", "text": "彼らはターミネーターかもしれないが、"}, {"type": "subtitle", "time": 4928.229, "timestamp": "01:22:08", "text": "轢いた時に死ぬなよ"}, {"type": "subtitle", "time": 4952.229, "timestamp": "01:22:32", "text": "ちょっと動作が重いと思う。待って、"}, {"type": "subtitle", "time": 4954.35, "timestamp": "01:22:34", "text": "またモーテル？"}, {"type": "subtitle", "time": 4957.669, "timestamp": "01:22:37", "text": "ええと、金物屋の裏、隣に"}, {"type": "subtitle", "time": 4959.75, "timestamp": "01:22:39", "text": "医者。"}, {"type": "subtitle", "time": 4960.95, "timestamp": "01:22:40", "text": "そのまままっすぐ進むと"}, {"type": "subtitle", "time": 4963.35, "timestamp": "01:22:43", "text": "先生、きっと見つかりますよ。ああ、私の車"}, {"type": "subtitle", "time": 4964.59, "timestamp": "01:22:44", "text": "ただ"}, {"type": "subtitle", "time": 4966.51, "timestamp": "01:22:46", "text": "ひっくり返った。おお、"}, {"type": "subtitle", "time": 4975.91, "timestamp": "01:22:55", "text": "なんてこった。彼は、ああ、そこにいる。彼はそこにいる。"}, {"type": "subtitle", "time": 4979.27, "timestamp": "01:22:59", "text": "彼がいてくれて本当に良かった。できますか？できません"}]
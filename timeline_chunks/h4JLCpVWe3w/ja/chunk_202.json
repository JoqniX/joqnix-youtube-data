[{"type": "subtitle", "time": 12120.07, "timestamp": "03:22:00", "text": "それはうんちです。でも、彼女はどうやって"}, {"type": "subtitle", "time": 12123.51, "timestamp": "03:22:03", "text": "こんな狭いトイレでうんちするの？"}, {"type": "subtitle", "time": 12126.87, "timestamp": "03:22:06", "text": "ソフィー、ここでウンチしたの？"}, {"type": "subtitle", "time": 12128.95, "timestamp": "03:22:08", "text": "そして、それからこのドアを見てください。"}, {"type": "subtitle", "time": 12130.95, "timestamp": "03:22:10", "text": "これはまさにあなたが開けるような場所です"}, {"type": "subtitle", "time": 12132.469, "timestamp": "03:22:12", "text": "それをすると彼女は「ああ、私は"}, {"type": "subtitle", "time": 12135.99, "timestamp": "03:22:15", "text": "クソ。失礼します。"}, {"type": "subtitle", "time": 12139.269, "timestamp": "03:22:19", "text": "ソフィー、ここにいる？これこれこれ"}, {"type": "subtitle", "time": 12140.349, "timestamp": "03:22:20", "text": "文字通り"}, {"type": "subtitle", "time": 12143.269, "timestamp": "03:22:23", "text": "腹が立つ。ソフィー、あなたは"}, {"type": "subtitle", "time": 12148.469, "timestamp": "03:22:28", "text": "ここ？彼女は料理のプロとしてどのように読書をしているのでしょうか？"}, {"type": "subtitle", "time": 12162.55, "timestamp": "03:22:42", "text": "バイバイ、"}, {"type": "subtitle", "time": 12166.309, "timestamp": "03:22:46", "text": "ソフィー。こんにちは、アイゼントさん。元気かい、"}, {"type": "subtitle", "time": 12169.51, "timestamp": "03:22:49", "text": "ソフィー？ニューアルバムをリリースしてください。ソフィーは"}, {"type": "subtitle", "time": 12179.59, "timestamp": "03:22:59", "text": "オフ。ソフィア。"}]
[{"type": "subtitle", "time": 6120.99, "timestamp": "01:42:00", "text": "みんな、ここから出なくちゃ"}, {"type": "subtitle", "time": 6124.31, "timestamp": "01:42:04", "text": "ここ。できるかどうか疑問に思う。ああ、"}, {"type": "subtitle", "time": 6128.149, "timestamp": "01:42:08", "text": "警察署。警察を呼んでもいいですか？"}, {"type": "subtitle", "time": 6130.47, "timestamp": "01:42:10", "text": "なぜ警察を呼びたいのですか？"}, {"type": "subtitle", "time": 6133.109, "timestamp": "01:42:13", "text": "ベイリー。ベイリー巡査に電話させてください。おお、"}, {"type": "subtitle", "time": 6136.31, "timestamp": "01:42:16", "text": "あれはパパだ。気をつけて。気をつけて。"}, {"type": "subtitle", "time": 6139.83, "timestamp": "01:42:19", "text": "なんてこった。ああ、神様。私は何もしていません"}, {"type": "subtitle", "time": 6142.47, "timestamp": "01:42:22", "text": "何もしなかった。私はそうではなかった あなたはできる"}, {"type": "subtitle", "time": 6144.55, "timestamp": "01:42:24", "text": "ゴミ箱に隠れる。"}, {"type": "subtitle", "time": 6151.27, "timestamp": "01:42:31", "text": "ああ、奴らが私を追いかけている。ニース。"}, {"type": "subtitle", "time": 6154.109, "timestamp": "01:42:34", "text": "これを開けることができます。"}, {"type": "subtitle", "time": 6157.99, "timestamp": "01:42:37", "text": "ああ、今行くよ。今行ってる。"}, {"type": "subtitle", "time": 6162.31, "timestamp": "01:42:42", "text": "ああ、屋根の上に飛び乗ることもできるよ"}, {"type": "subtitle", "time": 6164.229, "timestamp": "01:42:44", "text": "同じように。ええ、屋上ですね。うん。彼らは"}, {"type": "subtitle", "time": 6166.07, "timestamp": "01:42:46", "text": "捕まえられないし、忘れてしまうだろう"}, {"type": "subtitle", "time": 6168.87, "timestamp": "01:42:48", "text": "あなたは存在していた。わかった。まあ、彼らは"}, {"type": "subtitle", "time": 6177.59, "timestamp": "01:42:57", "text": "モーテルの支配人はどこですか？"}, {"type": "subtitle", "time": 6178.709, "timestamp": "01:42:58", "text": "彼らはそこに滞在すると思います"}]
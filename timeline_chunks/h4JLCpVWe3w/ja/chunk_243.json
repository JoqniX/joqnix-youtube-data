[{"type": "subtitle", "time": 14582.79, "timestamp": "04:03:02", "text": "毎回開くたびに"}, {"type": "subtitle", "time": 14585.229, "timestamp": "04:03:05", "text": "ゲームはそうなるだろう"}, {"type": "subtitle", "time": 14589.349, "timestamp": "04:03:09", "text": "骨をリセットします。いや、違うよ。ああ、"}, {"type": "subtitle", "time": 14591.269, "timestamp": "04:03:11", "text": "骨はリセットされないだろうけど、私は"}, {"type": "subtitle", "time": 14593.189, "timestamp": "04:03:13", "text": "知る。それほどプレイしたことはない。私"}, {"type": "subtitle", "time": 14596.349, "timestamp": "04:03:16", "text": "おそらくそうだと思う。"}, {"type": "subtitle", "time": 14599.75, "timestamp": "04:03:19", "text": "わかった。前回はそうだったと思う"}, {"type": "subtitle", "time": 14602.389, "timestamp": "04:03:22", "text": "2 つのマップをアンロックしましたが、プレイしたとき"}, {"type": "subtitle", "time": 14604.229, "timestamp": "04:03:24", "text": "今日は、"}, {"type": "subtitle", "time": 14608.71, "timestamp": "04:03:28", "text": "始まり。えっと、たぶん"}, {"type": "subtitle", "time": 14611.03, "timestamp": "04:03:31", "text": "それは"}, {"type": "subtitle", "time": 14612.79, "timestamp": "04:03:32", "text": "えーと、プレイヤーは何人いますか"}, {"type": "subtitle", "time": 14614.429, "timestamp": "04:03:34", "text": "一緒に演奏する。おそらく、"}, {"type": "subtitle", "time": 14618.15, "timestamp": "04:03:38", "text": "1つか2つか4つくらいで始まる"}, {"type": "subtitle", "time": 14621.83, "timestamp": "04:03:41", "text": "非常に速く。でも、もし、えっと"}, {"type": "subtitle", "time": 14623.51, "timestamp": "04:03:43", "text": "プレイヤーの数が非常に少なく、"}, {"type": "subtitle", "time": 14626.469, "timestamp": "04:03:46", "text": "非常に長く伸びた。最初のように"}, {"type": "subtitle", "time": 14628.95, "timestamp": "04:03:48", "text": "あなたが見た地図は、私たちに30分近くかかりました"}, {"type": "subtitle", "time": 14631.83, "timestamp": "04:03:51", "text": "分というのは、それは好きではないからです"}, {"type": "subtitle", "time": 14634.07, "timestamp": "04:03:54", "text": "最初のマップで時間がかかりすぎる。それで"}, {"type": "subtitle", "time": 14636.309, "timestamp": "04:03:56", "text": "だから私は最初のマップをプレイするのが嫌いなんです。"}, {"type": "subtitle", "time": 14639.67, "timestamp": "04:03:59", "text": "また、エントリーしない場合は"}]
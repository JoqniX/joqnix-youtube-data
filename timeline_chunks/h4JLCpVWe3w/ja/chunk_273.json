[{"type": "subtitle", "time": 16381.189, "timestamp": "04:33:01", "text": "そこで私はミッチに助けを求めたところ、彼は"}, {"type": "subtitle", "time": 16382.55, "timestamp": "04:33:02", "text": "「うんうん、君に送るよ」"}, {"type": "subtitle", "time": 16384.15, "timestamp": "04:33:04", "text": "「今すぐお金が欲しい。」彼は私にいくらか送ってくれた。"}, {"type": "subtitle", "time": 16387.269, "timestamp": "04:33:07", "text": "そして私は食べ物を手に入れました、なぜなら私の"}, {"type": "subtitle", "time": 16390.269, "timestamp": "04:33:10", "text": "銀行からの応答がありません。おお"}, {"type": "subtitle", "time": 16392.23, "timestamp": "04:33:12", "text": "いいえ。"}, {"type": "subtitle", "time": 16394.15, "timestamp": "04:33:14", "text": "うん。いいぞ、いいぞ、いいぞ。私は手に入れた 私は手に入れた"}, {"type": "subtitle", "time": 16400.31, "timestamp": "04:33:20", "text": "チャパティとチキンティッカ。おお、いいね。"}, {"type": "subtitle", "time": 16401.91, "timestamp": "04:33:21", "text": "うん。一番馬鹿げているのは"}, {"type": "subtitle", "time": 16407.349, "timestamp": "04:33:27", "text": "卵カレーは38です"}, {"type": "subtitle", "time": 16410.07, "timestamp": "04:33:30", "text": "チキンティッカは40ルピーです。それで"}, {"type": "subtitle", "time": 16412.949, "timestamp": "04:33:32", "text": "なぜ私が2ドル余分に払わないのか教えてください"}, {"type": "subtitle", "time": 16414.551, "timestamp": "04:33:34", "text": "ルピーまたは3ルピー追加で"}, {"type": "subtitle", "time": 16417.67, "timestamp": "04:33:37", "text": "チキンティッカ？うん、"}, {"type": "subtitle", "time": 16424.949, "timestamp": "04:33:44", "text": "彼女は文字通りここを這い回っている"}, {"type": "subtitle", "time": 16429.83, "timestamp": "04:33:49", "text": "その遺体。ごく普通のジョックニックファン。"}, {"type": "subtitle", "time": 16432.31, "timestamp": "04:33:52", "text": "平均的なジョックニックファンが気づいたとき"}, {"type": "subtitle", "time": 16434.07, "timestamp": "04:33:54", "text": "彼らが見ていないことに気づいたとき"}]
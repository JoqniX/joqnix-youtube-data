[{"type": "subtitle", "time": 10200.07, "timestamp": "02:50:00", "text": "私は馬の精液を入れた。馬を置く。おお、"}, {"type": "subtitle", "time": 10202.95, "timestamp": "02:50:02", "text": "馬を均等に置く。どうすればそれらのものを手に入れられるのか"}, {"type": "subtitle", "time": 10204.91, "timestamp": "02:50:04", "text": "けれど？ああ、終わった"}, {"type": "subtitle", "time": 10208.07, "timestamp": "02:50:08", "text": "ここ。私たちの家で。来て、行って、行って、"}, {"type": "subtitle", "time": 10212.07, "timestamp": "02:50:12", "text": "行け！行け！行け。私はそれを盗みました。そこにある。"}, {"type": "subtitle", "time": 10214.389, "timestamp": "02:50:14", "text": "何だって？おいで、おいで、おいで、おいで、"}, {"type": "subtitle", "time": 10216.63, "timestamp": "02:50:16", "text": "戻ってくる。持続する。私はいくつか売っています"}, {"type": "subtitle", "time": 10222.95, "timestamp": "02:50:22", "text": "右。それを得る。それを得る。それを得る。それを得る"}, {"type": "subtitle", "time": 10225.59, "timestamp": "02:50:25", "text": "棚から。棚。あそこの棚。"}, {"type": "subtitle", "time": 10228.71, "timestamp": "02:50:28", "text": "率直に言って。なんてこった。"}, {"type": "subtitle", "time": 10231.63, "timestamp": "02:50:31", "text": "いや、待って。どうやってこれを手に入れるの？"}, {"type": "subtitle", "time": 10235.59, "timestamp": "02:50:35", "text": "けれど？あれはジェシーのものだった。"}, {"type": "subtitle", "time": 10239.349, "timestamp": "02:50:39", "text": "私はそれを盗んだだけです。"}, {"type": "subtitle", "time": 10243.75, "timestamp": "02:50:43", "text": "それを生の ugish に入れて、"}, {"type": "subtitle", "time": 10245.67, "timestamp": "02:50:45", "text": "混ぜてください。"}, {"type": "subtitle", "time": 10251.91, "timestamp": "02:50:51", "text": "右。あと4秒だよ、みんな。私たちは"}]
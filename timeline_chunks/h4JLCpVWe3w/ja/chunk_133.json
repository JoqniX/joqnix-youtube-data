[{"type": "subtitle", "time": 7980.669, "timestamp": "02:13:00", "text": "どのポケモンが住むのか"}, {"type": "subtitle", "time": 7984.069, "timestamp": "02:13:04", "text": "私はそれを完全に消し去るつもりです"}, {"type": "subtitle", "time": 7987.43, "timestamp": "02:13:07", "text": "人口。この国。"}, {"type": "subtitle", "time": 7988.83, "timestamp": "02:13:08", "text": "おい、"}, {"type": "subtitle", "time": 7995.75, "timestamp": "02:13:15", "text": "O"}, {"type": "subtitle", "time": 8001.83, "timestamp": "02:13:21", "text": "私たちはドナからお金をもらった。待って、私はできる"}, {"type": "subtitle", "time": 8004.03, "timestamp": "02:13:24", "text": "ただ行くだけ"}, {"type": "subtitle", "time": 8014.39, "timestamp": "02:13:34", "text": "[ __ ]。ああ、もう。全て"}, {"type": "subtitle", "time": 8016.629, "timestamp": "02:13:36", "text": "そうね、ドナ。ドナが私たちの商品を買ってくれる。"}, {"type": "subtitle", "time": 8018.95, "timestamp": "02:13:38", "text": "誰が？私は物を売ろうとしていました"}, {"type": "subtitle", "time": 8021.069, "timestamp": "02:13:41", "text": "ドナ、おい。来る"}, {"type": "subtitle", "time": 8024.709, "timestamp": "02:13:44", "text": "の上。彼は君のせいで逃げ出したんだよ、イヴォン。"}, {"type": "subtitle", "time": 8027.03, "timestamp": "02:13:47", "text": "君はまた死んだんだね。おお。あ、待って、待って、"}, {"type": "subtitle", "time": 8029.43, "timestamp": "02:13:49", "text": "待って、待って。盗んだんだ。盗んだのは"}, {"type": "subtitle", "time": 8036.069, "timestamp": "02:13:56", "text": "あなたは盗んだのですか？ 彼は何を盗んだのですか？トラック。"}]
[{"type": "subtitle", "time": 8223.669, "timestamp": "02:17:03", "text": "汚れを落とすにはどうすればいいですか"}, {"type": "subtitle", "time": 8229.03, "timestamp": "02:17:09", "text": "よし。いつか私たちは新しいものを買うでしょう"}, {"type": "subtitle", "time": 8231.83, "timestamp": "02:17:11", "text": "家だよ、みんな。約束します。"}, {"type": "subtitle", "time": 8235.669, "timestamp": "02:17:15", "text": "これを梱包しましょう。"}, {"type": "subtitle", "time": 8238.389, "timestamp": "02:17:18", "text": "梱包ステーションへ行ってください。"}, {"type": "subtitle", "time": 8241.469, "timestamp": "02:17:21", "text": "何ですって？パッケージ。"}, {"type": "subtitle", "time": 8244.629, "timestamp": "02:17:24", "text": "待って、その雑草はいつ収穫したの？"}, {"type": "subtitle", "time": 8253.75, "timestamp": "02:17:33", "text": "そうやって人は死ぬんだ。待って、どうやって確認するの？"}, {"type": "subtitle", "time": 8266.389, "timestamp": "02:17:46", "text": "よし。すべて。"}, {"type": "subtitle", "time": 8268.709, "timestamp": "02:17:48", "text": "ああ、パッケージングの場合は、右クリックしてください"}, {"type": "subtitle", "time": 8274.23, "timestamp": "02:17:54", "text": "えーと、家に積み上げる。待って、会いに行くよ"}, {"type": "subtitle", "time": 8277.589, "timestamp": "02:17:57", "text": "3つでOK、隣で会いましょう"}]
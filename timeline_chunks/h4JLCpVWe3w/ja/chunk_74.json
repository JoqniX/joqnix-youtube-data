[{"type": "subtitle", "time": 4441.43, "timestamp": "01:14:01", "text": "取引。えっと、アイテムの分割ですね。移動するために"}, {"type": "subtitle", "time": 4443.75, "timestamp": "01:14:03", "text": "消費者の周りで右クリックしてドラッグし、"}, {"type": "subtitle", "time": 4456.47, "timestamp": "01:14:16", "text": "スクロール。アイテムを分割するにはどうすればいいですか？えっと"}, {"type": "subtitle", "time": 4458.63, "timestamp": "01:14:18", "text": "左ボタンを押したまま右ボタンをクリック"}, {"type": "subtitle", "time": 4460.31, "timestamp": "01:14:20", "text": "クリック。アイテムを右クリックします。おお、"}, {"type": "subtitle", "time": 4462.149, "timestamp": "01:14:22", "text": "わかった。右クリック。私はそれが"}, {"type": "subtitle", "time": 4464.95, "timestamp": "01:14:24", "text": "左クリック。えっと、Shiftキーを押しながら右クリック"}, {"type": "subtitle", "time": 4467.75, "timestamp": "01:14:27", "text": "1点につき。"}, {"type": "subtitle", "time": 4472.07, "timestamp": "01:14:32", "text": "わかった。おお。ああ、わかりました。うん、わかるよ。"}, {"type": "subtitle", "time": 4473.75, "timestamp": "01:14:33", "text": "しかし、右クリックを押し続けていると、"}, {"type": "subtitle", "time": 4475.27, "timestamp": "01:14:35", "text": "スクロールホイールを使用して、または"}, {"type": "subtitle", "time": 4478.87, "timestamp": "01:14:38", "text": "量を減らす。ちくしょう。うん。"}, {"type": "subtitle", "time": 4481.91, "timestamp": "01:14:41", "text": "うん。スクロールホイールが動作しません。それで"}, {"type": "subtitle", "time": 4484.709, "timestamp": "01:14:44", "text": "おお。ああ、イマン、お前なんかクソくらえだ。これはすべてあなたの"}, {"type": "subtitle", "time": 4486.55, "timestamp": "01:14:46", "text": "故障。"}, {"type": "subtitle", "time": 4488.229, "timestamp": "01:14:48", "text": "次に、右クリックをShiftキーを押しながら行います。だから私は"}, {"type": "subtitle", "time": 4490.149, "timestamp": "01:14:50", "text": "もう1つ追加する。"}, {"type": "subtitle", "time": 4492.47, "timestamp": "01:14:52", "text": "確認してみます。よし、ジョーを捕まえた。待って、いや、"}, {"type": "subtitle", "time": 4494.35, "timestamp": "01:14:54", "text": "それは"}, {"type": "subtitle", "time": 4496.79, "timestamp": "01:14:56", "text": "アンディ。ああ、わかった。私たちは行かなければならない"}]
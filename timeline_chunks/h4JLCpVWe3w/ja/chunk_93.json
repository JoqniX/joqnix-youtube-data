[{"type": "subtitle", "time": 5580.87, "timestamp": "01:33:00", "text": "赤ちゃん。待って、選んでもいいの？いいえ。ダウンタウン"}, {"type": "subtitle", "time": 5584.41, "timestamp": "01:33:04", "text": "地域がロック解除されている必要があります。ああ、失せろ。"}, {"type": "subtitle", "time": 5591.669, "timestamp": "01:33:11", "text": "どうやら在庫が切れてしまったようです。わかった。メモリ"}, {"type": "subtitle", "time": 5594.629, "timestamp": "01:33:14", "text": "提供する 待って、みんなが"}, {"type": "subtitle", "time": 5599.189, "timestamp": "01:33:19", "text": "これを受け入れますか？いいえ、あなただけです。おお、"}, {"type": "subtitle", "time": 5603.189, "timestamp": "01:33:23", "text": "私もそうせざるを得なかったようだ。"}, {"type": "subtitle", "time": 5606.39, "timestamp": "01:33:26", "text": "隠してあるか、市役所で見つけることができます。"}, {"type": "subtitle", "time": 5611.51, "timestamp": "01:33:31", "text": "ああ、警察だ。警察。警官が死亡する。"}, {"type": "subtitle", "time": 5619.51, "timestamp": "01:33:39", "text": "この男は誰だ？"}, {"type": "subtitle", "time": 5621.11, "timestamp": "01:33:41", "text": "あ、待って。皆さん、私には全く分かりません。私"}, {"type": "subtitle", "time": 5623.43, "timestamp": "01:33:43", "text": "彼女は私たちに加わりたいと思っていると思う。あなたは"}, {"type": "subtitle", "time": 5625.27, "timestamp": "01:33:45", "text": "私たちと一緒に来てください。あなた。私たちには"}, {"type": "subtitle", "time": 5626.87, "timestamp": "01:33:46", "text": "機会。"}, {"type": "subtitle", "time": 5629.59, "timestamp": "01:33:49", "text": "みんな、噴水に行こうよ。お金"}, {"type": "subtitle", "time": 5632.55, "timestamp": "01:33:52", "text": "そこに隠しておく。ネルソン。ネルソンおじさんは"}, {"type": "subtitle", "time": 5635.35, "timestamp": "01:33:55", "text": "自分。では、それはボングですか？"}, {"type": "subtitle", "time": 5638.55, "timestamp": "01:33:58", "text": "そうそう。小さな"}]
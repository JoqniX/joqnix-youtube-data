[{"type": "subtitle", "time": 18063.43, "timestamp": "05:01:03", "text": "塩はどこに置けばいいですか？まさにその通り。 F."}, {"type": "subtitle", "time": 18065.628, "timestamp": "05:01:05", "text": "F. 少し前に進んでください。"}, {"type": "subtitle", "time": 18067.99, "timestamp": "05:01:07", "text": "F. あまり多くは要らない。"}, {"type": "subtitle", "time": 18069.51, "timestamp": "05:01:09", "text": "えっと、"}, {"type": "subtitle", "time": 18070.51, "timestamp": "05:01:10", "text": "わかった。"}, {"type": "subtitle", "time": 18077.19, "timestamp": "05:01:17", "text": "警報か何か。"}, {"type": "subtitle", "time": 18079.91, "timestamp": "05:01:19", "text": "何？どうしたの？アラームが鳴るか"}, {"type": "subtitle", "time": 18081.628, "timestamp": "05:01:21", "text": "何か。何"}, {"type": "subtitle", "time": 18083.948, "timestamp": "05:01:23", "text": "えっ？あった"}, {"type": "subtitle", "time": 18086.788, "timestamp": "05:01:26", "text": "アラーム。どのような？何を読み取っているのですか？"}, {"type": "subtitle", "time": 18089.51, "timestamp": "05:01:29", "text": "三つ。えっと、戻ってください。戻ってください。戻ってください。行く"}, {"type": "subtitle", "time": 18092.47, "timestamp": "05:01:32", "text": "戻る。戻ってください。待って。何？"}, {"type": "subtitle", "time": 18094.55, "timestamp": "05:01:34", "text": "日記帳を取り出してください。"}, {"type": "subtitle", "time": 18104.35, "timestamp": "05:01:44", "text": "うん。ほら、それは"}, {"type": "subtitle", "time": 18115.75, "timestamp": "05:01:55", "text": "MF5。わかった。さあ、カメラを持ってください。"}, {"type": "subtitle", "time": 18118.39, "timestamp": "05:01:58", "text": "だから、「彼らは返信しましたか？」と書くべきですね。した"}]
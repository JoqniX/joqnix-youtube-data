[{"type": "subtitle", "time": 4740.79, "timestamp": "01:19:00", "text": "何てことだ。なんてこった。その後は"}, {"type": "subtitle", "time": 4743.59, "timestamp": "01:19:03", "text": "戻るだけで警察が"}, {"type": "subtitle", "time": 4745.83, "timestamp": "01:19:05", "text": "あなたもスキャンしてください。私は隠さなければならない"}, {"type": "subtitle", "time": 4748.709, "timestamp": "01:19:08", "text": "ドラッグとか、その他いろいろ。何てことだ。私は必要としている"}, {"type": "subtitle", "time": 4751.87, "timestamp": "01:19:11", "text": "麻薬を売るか、スキャンする"}, {"type": "subtitle", "time": 4754.669, "timestamp": "01:19:14", "text": "自分。これは非常にプロフェッショナルな仕事ぶりだ。私は"}, {"type": "subtitle", "time": 4758.229, "timestamp": "01:19:18", "text": "訓練済み。わかった、わかった、わかった、私は彼に戻る。"}, {"type": "subtitle", "time": 4768.32, "timestamp": "01:19:28", "text": "ジョー"}, {"type": "subtitle", "time": 4769.87, "timestamp": "01:19:29", "text": "[音楽]"}, {"type": "subtitle", "time": 4772.39, "timestamp": "01:19:32", "text": "アンディ。わかった。待って。話題になっている。"}, {"type": "subtitle", "time": 4774.149, "timestamp": "01:19:34", "text": "2倍の量の土を購入する"}, {"type": "subtitle", "time": 4777.189, "timestamp": "01:19:37", "text": "金物店。ああ、わかりました。"}, {"type": "subtitle", "time": 4778.31, "timestamp": "01:19:38", "text": "はい。"}, {"type": "subtitle", "time": 4780.07, "timestamp": "01:19:40", "text": "もしかしたら、外部的な対策を講じる必要があるのか​​もしれない。"}, {"type": "subtitle", "time": 4782.669, "timestamp": "01:19:42", "text": "これは何ですか？ハードウェアはどこにある？"}, {"type": "subtitle", "time": 4786.55, "timestamp": "01:19:46", "text": "店？あれはヘクターのクソ野郎か"}, {"type": "subtitle", "time": 4788.709, "timestamp": "01:19:48", "text": "車椅子？"}, {"type": "subtitle", "time": 4789.63, "timestamp": "01:19:49", "text": "おお"}, {"type": "subtitle", "time": 4798.63, "timestamp": "01:19:58", "text": "ヘクター。このゲームでブガッティを買うことはできますか？"}]
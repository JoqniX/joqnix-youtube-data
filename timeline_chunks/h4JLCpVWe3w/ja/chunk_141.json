[{"type": "subtitle", "time": 8465.83, "timestamp": "02:21:05", "text": "えっと、彼女はいくらだったんですか？三つ。そこにいる"}, {"type": "subtitle", "time": 8469.79, "timestamp": "02:21:09", "text": "行く。はい、どうぞ。そして、そこにあなたが"}, {"type": "subtitle", "time": 8478.11, "timestamp": "02:21:18", "text": "恋人"}, {"type": "subtitle", "time": 8481.99, "timestamp": "02:21:21", "text": "大丈夫です。えっと、どこにいるんですか？"}, {"type": "subtitle", "time": 8484.389, "timestamp": "02:21:24", "text": "取引は順調に進んでいます。はい、"}, {"type": "subtitle", "time": 8506.07, "timestamp": "02:21:46", "text": "実際、これをやるべきですね。"}, {"type": "subtitle", "time": 8510.75, "timestamp": "02:21:50", "text": "私は自分が実際にそれを手に入れたことを知らなかった"}, {"type": "subtitle", "time": 8514.15, "timestamp": "02:21:54", "text": "外国為替詐欺。あなたは、すべての"}]
[{"type": "subtitle", "time": 15301.11, "timestamp": "04:15:01", "text": "カメラ、あのカメラ。そこへ行って、"}, {"type": "subtitle", "time": 15303.51, "timestamp": "04:15:03", "text": "彼女に電話して、それからジョックのことを覚えておいて、来て"}, {"type": "subtitle", "time": 15304.71, "timestamp": "04:15:04", "text": "私と一緒にここにいます。ここに来て。お見せします"}, {"type": "subtitle", "time": 15309.11, "timestamp": "04:15:09", "text": "何か。ああ、わかりました。えっと、もしあなたが聞いたら"}, {"type": "subtitle", "time": 15311.51, "timestamp": "04:15:11", "text": "彼女は狩りを始めるのが好きで、ドアは"}, {"type": "subtitle", "time": 15313.59, "timestamp": "04:15:13", "text": "ロックされます。ドアがロックされているので、"}, {"type": "subtitle", "time": 15315.67, "timestamp": "04:15:15", "text": "もう曲がれない。だから彼女が"}, {"type": "subtitle", "time": 15318.11, "timestamp": "04:15:18", "text": "狩りを始めるには、トーチを使って"}, {"type": "subtitle", "time": 15320.229, "timestamp": "04:15:20", "text": "2階に上がり、部屋に入って鍵をかける"}, {"type": "subtitle", "time": 15322.95, "timestamp": "04:15:22", "text": "あなた自身。彼女が"}, {"type": "subtitle", "time": 15324.79, "timestamp": "04:15:24", "text": "狩猟をやめる。音を立てないでください"}, {"type": "subtitle", "time": 15327.11, "timestamp": "04:15:27", "text": "なぜなら、彼女にはあなたの声が聞こえるからです。右。わかった。"}, {"type": "subtitle", "time": 15330.389, "timestamp": "04:15:30", "text": "わかった。わかった。さあ、トイレの近くへ行きなさい。電話"}, {"type": "subtitle", "time": 15332.87, "timestamp": "04:15:32", "text": "彼女。トイレの電気をつけてください。"}, {"type": "subtitle", "time": 15334.309, "timestamp": "04:15:34", "text": "彼女に電話して。そして彼女が出てくると、"}, {"type": "subtitle", "time": 15336.229, "timestamp": "04:15:36", "text": "写真を撮って上に走って、"}, {"type": "subtitle", "time": 15339.03, "timestamp": "04:15:39", "text": "その活動について教えてください。右。わかった。"}, {"type": "subtitle", "time": 15340.71, "timestamp": "04:15:40", "text": "うん。ちょっと待って。私を"}, {"type": "subtitle", "time": 15344.91, "timestamp": "04:15:44", "text": "トラックが先。わかった。"}, {"type": "subtitle", "time": 15350.11, "timestamp": "04:15:50", "text": "いいえ。わかりました。やってみろ。"}, {"type": "subtitle", "time": 15352.07, "timestamp": "04:15:52", "text": "ルースリー、頼むよ。来て。行かないでください"}, {"type": "subtitle", "time": 15355.269, "timestamp": "04:15:55", "text": "トイレの中。わかった。わかった。ルース、あなた"}]
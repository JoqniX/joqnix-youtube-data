[{"type": "subtitle", "time": 8880.07, "timestamp": "02:28:00", "text": "現金を入れる必要がある"}, {"type": "subtitle", "time": 8882.309, "timestamp": "02:28:02", "text": "銀行に行く必要があると思うので"}, {"type": "subtitle", "time": 8885.87, "timestamp": "02:28:05", "text": "ビニール袋と"}, {"type": "subtitle", "time": 8888.11, "timestamp": "02:28:08", "text": "おそらく別の"}, {"type": "subtitle", "time": 8896.07, "timestamp": "02:28:16", "text": "この男はひどく金欠だ。彼は、彼は"}, {"type": "subtitle", "time": 8901.51, "timestamp": "02:28:21", "text": "彼から盗んでいるのはあなたの方です。あなた"}, {"type": "subtitle", "time": 8907.19, "timestamp": "02:28:27", "text": "私たちは本当に不満を言っているのでしょうか"}, {"type": "subtitle", "time": 8911.91, "timestamp": "02:28:31", "text": "人から1ドルをピックボールで奪う？"}, {"type": "subtitle", "time": 8914.79, "timestamp": "02:28:34", "text": "ここは一体何ですか？ここがその場所ですか？"}, {"type": "subtitle", "time": 8915.79, "timestamp": "02:28:35", "text": "私たちは"}, {"type": "subtitle", "time": 8929.91, "timestamp": "02:28:49", "text": "ああ、こっちに来て。大きな井戸。"}, {"type": "subtitle", "time": 8933.27, "timestamp": "02:28:53", "text": "彼に麻薬を売ってみろ。"}, {"type": "subtitle", "time": 8935.19, "timestamp": "02:28:55", "text": "どこ？どこ？"}, {"type": "subtitle", "time": 8937.91, "timestamp": "02:28:57", "text": "食料品店は、もしかしたら目の前にあるかもしれません"}]
[{"type": "subtitle", "time": 3900.19, "timestamp": "01:05:00", "text": "私たちは社会さえも手に入れる"}, {"type": "subtitle", "time": 3903.99, "timestamp": "01:05:03", "text": "基準。もちろん。もちろん。アダム"}, {"type": "subtitle", "time": 3911.829, "timestamp": "01:05:11", "text": "よし。アダム、"}, {"type": "subtitle", "time": 3913.91, "timestamp": "01:05:13", "text": "あの男性のことは本当に残念です。彼は 彼は"}, {"type": "subtitle", "time": 3915.91, "timestamp": "01:05:15", "text": "ここは初めてです。彼は、えっと、私は彼を知りません。"}, {"type": "subtitle", "time": 3918.47, "timestamp": "01:05:18", "text": "実は。彼はただ、いや、彼はただ、彼はただ"}, {"type": "subtitle", "time": 3921.029, "timestamp": "01:05:21", "text": "入ってきた。彼はまるでランダムな人物だ。ごめんなさい。"}, {"type": "subtitle", "time": 3922.549, "timestamp": "01:05:22", "text": "私"}, {"type": "subtitle", "time": 3924.23, "timestamp": "01:05:24", "text": "彼を追放したいなら、追放できます。"}, {"type": "subtitle", "time": 3933.349, "timestamp": "01:05:33", "text": "久しぶりですね。久しぶりですね。"}, {"type": "subtitle", "time": 3935.43, "timestamp": "01:05:35", "text": "良い、"}, {"type": "subtitle", "time": 3937.67, "timestamp": "01:05:37", "text": "えっと、何日間配信してないかな"}, {"type": "subtitle", "time": 3942.549, "timestamp": "01:05:42", "text": "ずいぶん時間が経っただろうか？ 24年。 24年。私"}, {"type": "subtitle", "time": 3946.71, "timestamp": "01:05:46", "text": "お前の意見なんて聞いてねえよ。"}, {"type": "subtitle", "time": 3949.029, "timestamp": "01:05:49", "text": "皆さん、本当にありがとうございました。ありがとう。おお、"}, {"type": "subtitle", "time": 3952.63, "timestamp": "01:05:52", "text": "私のケツを犯して。なんてこった。"}, {"type": "subtitle", "time": 3954.309, "timestamp": "01:05:54", "text": "ねえ、それは、それは問題です。いいえ、私は"}, {"type": "subtitle", "time": 3957.109, "timestamp": "01:05:57", "text": "わざとじゃなかった。いや、いや、いや、いや。"}]
[{"type": "subtitle", "time": 17767.628, "timestamp": "04:56:07", "text": "何か兆候を見せてください。"}, {"type": "subtitle", "time": 17770.07, "timestamp": "04:56:10", "text": "保留中。あなたはここにいますか？お前はバカか？"}, {"type": "subtitle", "time": 17775.868, "timestamp": "04:56:15", "text": "これはあなたですか？これはあなたの写真ですか？"}, {"type": "subtitle", "time": 17796.23, "timestamp": "04:56:36", "text": "わかった。一つだけやれ。えっと、"}, {"type": "subtitle", "time": 17799.83, "timestamp": "04:56:39", "text": "えーと、トラックみたいなカメラを持ってきて"}, {"type": "subtitle", "time": 17805.91, "timestamp": "04:56:45", "text": "えーと、スピリットボックス。それを使って会話する。わかった。"}, {"type": "subtitle", "time": 17808.15, "timestamp": "04:56:48", "text": "ああ、わかりました。だから、どこで見ても"}, {"type": "subtitle", "time": 17810.55, "timestamp": "04:56:50", "text": "彼女が言うとか彼が言うとか何か、私は"}, {"type": "subtitle", "time": 17812.868, "timestamp": "04:56:52", "text": "それが一体何なのか、さっぱり分からない。えっと、"}, {"type": "subtitle", "time": 17817.03, "timestamp": "04:56:57", "text": "EMFリーダーを使用してEMFをチェックします"}, {"type": "subtitle", "time": 17819.47, "timestamp": "04:56:59", "text": "着陸。"}]
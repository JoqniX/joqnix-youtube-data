[{"type": "subtitle", "time": 6844.629, "timestamp": "01:54:04", "text": "依然として所持金はゼロ。一体どういうことだ？"}, {"type": "subtitle", "time": 6847.51, "timestamp": "01:54:07", "text": "お金のことだと思います。"}, {"type": "subtitle", "time": 6850.47, "timestamp": "01:54:10", "text": "私はまだあのWだった、"}, {"type": "subtitle", "time": 6852.95, "timestamp": "01:54:12", "text": "兄弟。私にとって、彼の頭は彼の体と同じだ"}, {"type": "subtitle", "time": 6856.03, "timestamp": "01:54:16", "text": "完全に分裂した"}, {"type": "subtitle", "time": 6858.87, "timestamp": "01:54:18", "text": "反対側へと伸びていく。"}, {"type": "subtitle", "time": 6871.189, "timestamp": "01:54:31", "text": "何？"}, {"type": "subtitle", "time": 6875.589, "timestamp": "01:54:35", "text": "そうそう。コーラを買って回復しよう。"}, {"type": "subtitle", "time": 6878.669, "timestamp": "01:54:38", "text": "ああ、ああを買うことができます、"}, {"type": "subtitle", "time": 6882.229, "timestamp": "01:54:42", "text": "うん。ああ、あなたはおそらく"}, {"type": "subtitle", "time": 6884.83, "timestamp": "01:54:44", "text": "くそ。ゴミを拾っている人たちのことだよ"}, {"type": "subtitle", "time": 6895.669, "timestamp": "01:54:55", "text": "うん。つまり、土を1つ買ってください。土壌。"}]
[{"type": "subtitle", "time": 8162.47, "timestamp": "02:16:02", "text": "一番上まで飛んでいく。持続する。買わせてください"}, {"type": "subtitle", "time": 8165.91, "timestamp": "02:16:05", "text": "ゴミ袋がいくつか。兄弟、私は買うつもりです"}, {"type": "subtitle", "time": 8167.75, "timestamp": "02:16:07", "text": "4人だ、お前ら汚いから"}, {"type": "subtitle", "time": 8170.629, "timestamp": "02:16:10", "text": "クソ野郎ども。"}, {"type": "subtitle", "time": 8184.69, "timestamp": "02:16:24", "text": "お前は滅びるだろう。"}, {"type": "subtitle", "time": 8186.109, "timestamp": "02:16:26", "text": "[音楽]"}, {"type": "subtitle", "time": 8189.669, "timestamp": "02:16:29", "text": "いや、いや。わかった、戻るよ"}, {"type": "subtitle", "time": 8191.27, "timestamp": "02:16:31", "text": "それ。よし、みんな、引き続き片付けよう。私は"}, {"type": "subtitle", "time": 8205.19, "timestamp": "02:16:45", "text": "行く。私はこれでいくら得たのですか？ 64."}, {"type": "subtitle", "time": 8207.99, "timestamp": "02:16:47", "text": "マジかよ、兄弟。待って、私はただ"}, {"type": "subtitle", "time": 8209.669, "timestamp": "02:16:49", "text": "ゴミ収集員。それは私を"}, {"type": "subtitle", "time": 8212.389, "timestamp": "02:16:52", "text": "お金。何てことだ。おい、お前は俺の"}, {"type": "subtitle", "time": 8214.709, "timestamp": "02:16:54", "text": "クソ金。一体どういうことだ？私は思う"}, {"type": "subtitle", "time": 8217.11, "timestamp": "02:16:57", "text": "仕事について真剣に考えろよ。[ __ ]"}]
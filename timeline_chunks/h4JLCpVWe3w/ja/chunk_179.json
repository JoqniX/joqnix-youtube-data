[{"type": "subtitle", "time": 10742.11, "timestamp": "02:59:02", "text": "左。私も切り替えました。私も行く"}, {"type": "subtitle", "time": 10744.349, "timestamp": "02:59:04", "text": "寝る。ああ、"}, {"type": "subtitle", "time": 10746.87, "timestamp": "02:59:06", "text": "神。私は10時に寝る予定だった。"}, {"type": "subtitle", "time": 10748.63, "timestamp": "02:59:08", "text": "ところで。大丈夫。時刻は1時です。私"}, {"type": "subtitle", "time": 10751.75, "timestamp": "02:59:11", "text": "コラボレーションに参加した。よかった、うまくいった"}, {"type": "subtitle", "time": 10753.03, "timestamp": "02:59:13", "text": "良い。"}, {"type": "subtitle", "time": 10755.269, "timestamp": "02:59:15", "text": "私はひどく眠って酔っていたので心配でした"}, {"type": "subtitle", "time": 10775.349, "timestamp": "02:59:35", "text": "それ。私はただvをアップロードしているだけです、そして私は行く"}]
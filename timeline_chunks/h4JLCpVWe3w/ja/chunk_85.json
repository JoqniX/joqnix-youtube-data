[{"type": "subtitle", "time": 5102.79, "timestamp": "01:25:02", "text": "待って、マリファナは計画的にやったの？"}, {"type": "subtitle", "time": 5106.39, "timestamp": "01:25:06", "text": "ええ、そうしました。おお。私は運転しています"}, {"type": "subtitle", "time": 5109.11, "timestamp": "01:25:09", "text": "離れて。ヘクター。ヘクター。の"}, {"type": "subtitle", "time": 5112.47, "timestamp": "01:25:12", "text": "警察。ヘクター。"}, {"type": "subtitle", "time": 5115.629, "timestamp": "01:25:15", "text": "おお。ああ、やめてくれ。ああ、そうだ。いいえ。ああ、"}, {"type": "subtitle", "time": 5117.87, "timestamp": "01:25:17", "text": "うん。"}, {"type": "subtitle", "time": 5128.709, "timestamp": "01:25:28", "text": "すべてはあなたのおかげです。すべてはあなたのおかげです。"}, {"type": "subtitle", "time": 5131.91, "timestamp": "01:25:31", "text": "あなたのおかげで。え、何？私は何をしたのか"}, {"type": "subtitle", "time": 5135.51, "timestamp": "01:25:35", "text": "する？収集家が亡くなった。収集家が亡くなった"}, {"type": "subtitle", "time": 5140.709, "timestamp": "01:25:40", "text": "だって、君は自分が望んでいたことを知っているから。"}, {"type": "subtitle", "time": 5142.709, "timestamp": "01:25:42", "text": "あなたは、"}, {"type": "subtitle", "time": 5152.39, "timestamp": "01:25:52", "text": "よろしければ。君だけが知っている、君だけが知っている"}, {"type": "subtitle", "time": 5154.39, "timestamp": "01:25:54", "text": "クラッシュを引き起こす方法の一つ。行く時間です"}, {"type": "subtitle", "time": 5159.11, "timestamp": "01:25:59", "text": "仕事。わかった。それでは、新しいファイルを作成します。"}]
[{"type": "subtitle", "time": 5401.11, "timestamp": "01:30:01", "text": "上。ジェシー。えっと、ジェシー、君はハゲてるよ。"}, {"type": "subtitle", "time": 5405.27, "timestamp": "01:30:05", "text": "ジェシー、私はハゲてないよ。"}, {"type": "subtitle", "time": 5409.59, "timestamp": "01:30:09", "text": "ジェシーなんてクソくらえ。それは兆候よ、この[ __ ]。いや、"}, {"type": "subtitle", "time": 5415.51, "timestamp": "01:30:15", "text": "ジェシー。男性型脱毛症です。はい。"}, {"type": "subtitle", "time": 5420.39, "timestamp": "01:30:20", "text": "ああ、くたばれ。くたばれ、父さん。私は私は私は"}, {"type": "subtitle", "time": 5426.95, "timestamp": "01:30:26", "text": "あなたの父親。あらら。いやいや。クソッ"}, {"type": "subtitle", "time": 5429.189, "timestamp": "01:30:29", "text": "本当にがっかりだ。"}, {"type": "subtitle", "time": 5431.709, "timestamp": "01:30:31", "text": "いいえ。"}, {"type": "subtitle", "time": 5434.95, "timestamp": "01:30:34", "text": "ああ、しまった。"}, {"type": "subtitle", "time": 5437.03, "timestamp": "01:30:37", "text": "いいえ、あなたは薄毛です。私を見て。私は持っている"}, {"type": "subtitle", "time": 5439.91, "timestamp": "01:30:39", "text": "艶やかな髪。"}, {"type": "subtitle", "time": 5442.07, "timestamp": "01:30:42", "text": "よし、みんな。君は良いものを手に入れた"}, {"type": "subtitle", "time": 5444.95, "timestamp": "01:30:44", "text": "くそ、[ __ ]。これもまた"}, {"type": "subtitle", "time": 5449.669, "timestamp": "01:30:49", "text": "終わるのか？ああ、わかりました。"}, {"type": "subtitle", "time": 5451.59, "timestamp": "01:30:51", "text": "ええと、もし私たちがお金を手に入れたら、"}, {"type": "subtitle", "time": 5454.47, "timestamp": "01:30:54", "text": "お金を分け合うのは好きですか？えっと、"}, {"type": "subtitle", "time": 5458.39, "timestamp": "01:30:58", "text": "銀行は共有されています。ああ、わかりました。私はああ、"}]
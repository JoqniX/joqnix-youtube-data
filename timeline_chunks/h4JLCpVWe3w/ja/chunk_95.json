[{"type": "subtitle", "time": 5700.07, "timestamp": "01:35:00", "text": "彼は以前にもこれをやったことがある。彼は知っている。"}, {"type": "subtitle", "time": 5704.229, "timestamp": "01:35:04", "text": "よし、みんな。私たちは諦めなければならない。なんてこった。"}, {"type": "subtitle", "time": 5707.189, "timestamp": "01:35:07", "text": "ああ、くそ。なぜジョーは"}, {"type": "subtitle", "time": 5710.91, "timestamp": "01:35:10", "text": "もうない。いや、彼は悪いことをしている。"}, {"type": "subtitle", "time": 5718.39, "timestamp": "01:35:18", "text": "ジョック。よし、これから"}, {"type": "subtitle", "time": 5721.39, "timestamp": "01:35:21", "text": "それは無視してください。失礼します、"}, {"type": "subtitle", "time": 5724.709, "timestamp": "01:35:24", "text": "奥様。こんにちは、ジョイスさん。生きている。あなたはできません"}, {"type": "subtitle", "time": 5727.75, "timestamp": "01:35:27", "text": "誰にでも無料サンプルを配る。これは何ですか？"}, {"type": "subtitle", "time": 5731.83, "timestamp": "01:35:31", "text": "バスターを手に入れた。いいえ。ああ、"}, {"type": "subtitle", "time": 5733.189, "timestamp": "01:35:33", "text": "何かトラブルに巻き込まれていると聞きましたが、"}, {"type": "subtitle", "time": 5735.27, "timestamp": "01:35:35", "text": "これは話し合いでも何でもない。おい、"}, {"type": "subtitle", "time": 5737.79, "timestamp": "01:35:37", "text": "奥様。いいえ、あげてもいいですか。"}, {"type": "subtitle", "time": 5741.59, "timestamp": "01:35:41", "text": "戻る。彼女は今中に入ったところです。戻ってきてください。おお、"}, {"type": "subtitle", "time": 5744.149, "timestamp": "01:35:44", "text": "コインランドリーがあるよ、みんな。"}, {"type": "subtitle", "time": 5752.31, "timestamp": "01:35:52", "text": "待って、これは何？理髪店。おい、"}, {"type": "subtitle", "time": 5754.669, "timestamp": "01:35:54", "text": "理髪師。あなたは"}, {"type": "subtitle", "time": 5757.51, "timestamp": "01:35:57", "text": "理髪師？私は誰にもあげられない"}, {"type": "subtitle", "time": 5759.91, "timestamp": "01:35:59", "text": "サンプル。"}]
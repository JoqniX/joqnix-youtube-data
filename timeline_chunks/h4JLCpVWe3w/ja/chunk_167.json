[{"type": "subtitle", "time": 10020.71, "timestamp": "02:47:00", "text": "薬物。わかりました、他の人たちのところへ行きます。"}, {"type": "subtitle", "time": 10023.59, "timestamp": "02:47:03", "text": "私がその薬を手に入れることはないと思うの？"}, {"type": "subtitle", "time": 10027.71, "timestamp": "02:47:07", "text": "息子よ、お前には絶対に麻薬は手に入らないぞ。"}, {"type": "subtitle", "time": 10032.19, "timestamp": "02:47:12", "text": "ああ、あなたは私のお父さんですね。"}, {"type": "subtitle", "time": 10036.55, "timestamp": "02:47:16", "text": "私は私は"}, {"type": "subtitle", "time": 10040.15, "timestamp": "02:47:20", "text": "このナッツを叩き潰せ。"}, {"type": "subtitle", "time": 10043.59, "timestamp": "02:47:23", "text": "あ、あとヘクターから電話がかかってきてる。"}, {"type": "subtitle", "time": 10055.59, "timestamp": "02:47:35", "text": "うわ、マジかよ。 Xが4つで90だ。そうだね。"}, {"type": "subtitle", "time": 10058.63, "timestamp": "02:47:38", "text": "夜遅くまでね、ベイビーガール。ピーターのファイル。ピーター"}, {"type": "subtitle", "time": 10060.75, "timestamp": "02:47:40", "text": "ファイル。一体どういうことだ？"}, {"type": "subtitle", "time": 10064.11, "timestamp": "02:47:44", "text": "何？素晴らしい。で会いましょう"}, {"type": "subtitle", "time": 10068.309, "timestamp": "02:47:48", "text": "私は何もしていません。手に入れることができなかった"}, {"type": "subtitle", "time": 10070.429, "timestamp": "02:47:50", "text": "彼。さあ"}, {"type": "subtitle", "time": 10072.71, "timestamp": "02:47:52", "text": "話す。そこそこの活動拠点がある"}, {"type": "subtitle", "time": 10074.23, "timestamp": "02:47:54", "text": "そして、顧客基盤の拡大。彼は"}, {"type": "subtitle", "time": 10075.83, "timestamp": "02:47:55", "text": "今はちゃんとしたお金を稼いでいるが、"}, {"type": "subtitle", "time": 10077.87, "timestamp": "02:47:57", "text": "彼はすべての管理を手伝う必要がある"}, {"type": "subtitle", "time": 10079.91, "timestamp": "02:47:59", "text": "顧客。採用について考えてみよう"}]
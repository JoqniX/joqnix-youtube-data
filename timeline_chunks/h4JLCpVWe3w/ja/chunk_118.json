[{"type": "subtitle", "time": 7080.07, "timestamp": "01:58:00", "text": "スケートボードを買いたい。えっと、私は"}, {"type": "subtitle", "time": 7082.629, "timestamp": "01:58:02", "text": "250ドルのやつを買う？いや、いや。ただ貯金すればいいんだ。"}, {"type": "subtitle", "time": 7085.35, "timestamp": "01:58:05", "text": "お金を貯めて、肉を売ろう。売って"}, {"type": "subtitle", "time": 7088.149, "timestamp": "01:58:08", "text": "うん、そうだね。わかった。"}, {"type": "subtitle", "time": 7090.47, "timestamp": "01:58:10", "text": "お金を盗むことはできません"}, {"type": "subtitle", "time": 7092.55, "timestamp": "01:58:12", "text": "彼。私は信じている"}, {"type": "subtitle", "time": 7095.669, "timestamp": "01:58:15", "text": "午後6時までに彼が帰る時に、スリを働け。"}, {"type": "subtitle", "time": 7097.189, "timestamp": "01:58:17", "text": "わかった、"}, {"type": "subtitle", "time": 7099.27, "timestamp": "01:58:19", "text": "我々は彼からスリをして、それから"}, {"type": "subtitle", "time": 7101.99, "timestamp": "01:58:21", "text": "同じ金額。何？私たちは、私たちは"}, {"type": "subtitle", "time": 7105.109, "timestamp": "01:58:25", "text": "ジェシーをリサイクルする。赤ちゃんを青い世界へ連れて行って。"}, {"type": "subtitle", "time": 7107.35, "timestamp": "01:58:27", "text": "ジェシー、"}, {"type": "subtitle", "time": 7110.07, "timestamp": "01:58:30", "text": "こんにちは。モーテルの部屋に戻りなさい。全て"}, {"type": "subtitle", "time": 7112.229, "timestamp": "01:58:32", "text": "右。わかった。ボトルを飾り付けさせてください。"}, {"type": "subtitle", "time": 7113.99, "timestamp": "01:58:33", "text": "あまりにも。わかった。えっと、どうやって配置すればいいですか"}, {"type": "subtitle", "time": 7115.83, "timestamp": "01:58:35", "text": "光っている これは光るテントですか？おお、"}, {"type": "subtitle", "time": 7118.39, "timestamp": "01:58:38", "text": "オンです。うん。"}, {"type": "subtitle", "time": 7124.31, "timestamp": "01:58:44", "text": "よし。ここに土を入れてください。うん。"}, {"type": "subtitle", "time": 7126.55, "timestamp": "01:58:46", "text": "ああ、あなたはできる、あなたはできる、こんにちは、マスター"}, {"type": "subtitle", "time": 7128.87, "timestamp": "01:58:48", "text": "トルーパー・インディア。フォローありがとうございます。"}, {"type": "subtitle", "time": 7131.589, "timestamp": "01:58:51", "text": "はい、どうぞ。始めやすい。うん、君"}, {"type": "subtitle", "time": 7134.95, "timestamp": "01:58:54", "text": "できる。私はゲームをほぼクリアしました。は"}, {"type": "subtitle", "time": 7137.03, "timestamp": "01:58:57", "text": "私は犬と私のすべてのものをロック解除しました"}, {"type": "subtitle", "time": 7139.91, "timestamp": "01:58:59", "text": "安全。えっと、誰か水持ってる？"}]
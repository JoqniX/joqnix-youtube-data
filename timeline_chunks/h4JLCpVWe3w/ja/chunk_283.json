[{"type": "subtitle", "time": 16985.55, "timestamp": "04:43:05", "text": "彼女はここにもいない。彼女は姿を消す"}, {"type": "subtitle", "time": 16988.91, "timestamp": "04:43:08", "text": "まるで行くような後に"}, {"type": "subtitle", "time": 17011.11, "timestamp": "04:43:31", "text": "何てことだ。同じ戦術だ。私の"}, {"type": "subtitle", "time": 17014.868, "timestamp": "04:43:34", "text": "遺体は戻ってきて、そこへ歩いていく。いいえ。"}, {"type": "subtitle", "time": 17017.51, "timestamp": "04:43:37", "text": "私に外出してほしいですか？いいえ。いいえ。"}, {"type": "subtitle", "time": 17020.15, "timestamp": "04:43:40", "text": "いや、いや、いや。もうめちゃくちゃ退屈だよ。"}, {"type": "subtitle", "time": 17023.27, "timestamp": "04:43:43", "text": "今。もし外出できるとしたら？"}, {"type": "subtitle", "time": 17026.39, "timestamp": "04:43:46", "text": "出てこいよ、このクソ野郎。わかった。彼女は"}, {"type": "subtitle", "time": 17028.708, "timestamp": "04:43:48", "text": "消滅しました。つまり、彼女は産むだろう"}, {"type": "subtitle", "time": 17031.27, "timestamp": "04:43:51", "text": "またトイレからだろうな。だから、あなたは"}, {"type": "subtitle", "time": 17034.55, "timestamp": "04:43:54", "text": "私に外出してほしいの？"}, {"type": "subtitle", "time": 17037.51, "timestamp": "04:43:57", "text": "M、めちゃくちゃ退屈だ。動けません"}]
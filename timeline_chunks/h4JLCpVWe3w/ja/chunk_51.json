[{"type": "subtitle", "time": 3061.349, "timestamp": "00:51:01", "text": "[音楽]"}, {"type": "subtitle", "time": 3064.39, "timestamp": "00:51:04", "text": "ストリーマーモードでは、"}, {"type": "subtitle", "time": 3067.109, "timestamp": "00:51:07", "text": "サウンドを無効にするというものです。私はそれをしました。私はそうしました"}, {"type": "subtitle", "time": 3071.91, "timestamp": "00:51:11", "text": "それ。それは私が私の私の"}, {"type": "subtitle", "time": 3075.19, "timestamp": "00:51:15", "text": "ノートパソコンがクラッシュして、その後は"}, {"type": "subtitle", "time": 3078.63, "timestamp": "00:51:18", "text": "Discordの音声はもう提供していません"}, {"type": "subtitle", "time": 3081.03, "timestamp": "00:51:21", "text": "完全に。うん。その他すべては"}, {"type": "subtitle", "time": 3083.43, "timestamp": "00:51:23", "text": "全く問題なく動作しています。じゃあ、たぶん"}, {"type": "subtitle", "time": 3086.79, "timestamp": "00:51:26", "text": "Discordを再インストールする必要があります。"}, {"type": "subtitle", "time": 3094.23, "timestamp": "00:51:34", "text": "私はDiscordを再インストールするのが大好きなんです。"}, {"type": "subtitle", "time": 3095.75, "timestamp": "00:51:35", "text": "やったの？ ああ、君がやったと思ってたんだけど"}, {"type": "subtitle", "time": 3098.549, "timestamp": "00:51:38", "text": "それ。いいえ、最後に何をしたかわかりません"}, {"type": "subtitle", "time": 3100.069, "timestamp": "00:51:40", "text": "時間があったが、私は"}, {"type": "subtitle", "time": 3102.15, "timestamp": "00:51:42", "text": "設定を変更したら直りました。気に入った"}, {"type": "subtitle", "time": 3104.94, "timestamp": "00:51:44", "text": "前回も同じことが起こった。"}, {"type": "subtitle", "time": 3106.75, "timestamp": "00:51:46", "text": "[音楽]"}, {"type": "subtitle", "time": 3109.95, "timestamp": "00:51:49", "text": "ああ、何だったか覚えていない"}]
[{"type": "subtitle", "time": 14342.229, "timestamp": "03:59:02", "text": "はい。あ、待って。私たちは何も買いませんでした。私"}, {"type": "subtitle", "time": 14350.83, "timestamp": "03:59:10", "text": "大丈夫。さっき、すごく大声で叫んだんだ。ああ、"}, {"type": "subtitle", "time": 14382.55, "timestamp": "03:59:42", "text": "うわぁ、何か凍りつきそうな感じ"}, {"type": "subtitle", "time": 14385.03, "timestamp": "03:59:45", "text": "彼の口から出た。わかった。わかった。つまり"}, {"type": "subtitle", "time": 14387.349, "timestamp": "03:59:47", "text": "幽霊が来ることを知っているとき"}, {"type": "subtitle", "time": 14391.59, "timestamp": "03:59:51", "text": "あなたを狩るために。ああ、わかりました。わかった。うん。そして私は"}, {"type": "subtitle", "time": 14393.67, "timestamp": "03:59:53", "text": "そして、あなたがミュートになっていることに今気づきました"}, {"type": "subtitle", "time": 14395.99, "timestamp": "03:59:55", "text": "ストリーム。何てことだ。はい、ミュートを解除しました。"}, {"type": "subtitle", "time": 14398.63, "timestamp": "03:59:58", "text": "ああ、助かった。人々への対応"}]
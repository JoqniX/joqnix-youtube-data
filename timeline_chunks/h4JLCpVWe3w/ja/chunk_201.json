[{"type": "subtitle", "time": 12071.91, "timestamp": "03:21:11", "text": "ソフィー、あなたは税金を納めていますか？"}, {"type": "subtitle", "time": 12086.229, "timestamp": "03:21:26", "text": "ソフィー、女王が亡くなったわ。出てくる。の"}, {"type": "subtitle", "time": 12089.269, "timestamp": "03:21:29", "text": "女王。ソフィー、ここにいるの？"}, {"type": "subtitle", "time": 12101.349, "timestamp": "03:21:41", "text": "ソフィーはここに来ることができた。"}, {"type": "subtitle", "time": 12104.71, "timestamp": "03:21:44", "text": "ああ、PCゲームよ。"}, {"type": "subtitle", "time": 12106.63, "timestamp": "03:21:46", "text": "ソフィー、あなたの家のトイレは本当にひどいね。"}, {"type": "subtitle", "time": 12109.229, "timestamp": "03:21:49", "text": "ミッチ、こっちへ来なさい。このクソみたいな"}, {"type": "subtitle", "time": 12111.11, "timestamp": "03:21:51", "text": "トイレ。ここに来て。ここに来て。見てください"}, {"type": "subtitle", "time": 12112.269, "timestamp": "03:21:52", "text": "このクソ"}, {"type": "subtitle", "time": 12115.83, "timestamp": "03:21:55", "text": "トイレ。ここはひどい。"}]
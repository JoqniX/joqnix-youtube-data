[{"type": "subtitle", "time": 9484.07, "timestamp": "02:38:04", "text": "わかった。ええ、そうですね。えっと、バドのビールはどこ？"}, {"type": "subtitle", "time": 9486.95, "timestamp": "02:38:06", "text": "もの？私はオースティンを標的にする。オースティン、"}, {"type": "subtitle", "time": 9490.309, "timestamp": "02:38:10", "text": "あれはバッズ・バーです。えっと、"}, {"type": "subtitle", "time": 9493.03, "timestamp": "02:38:13", "text": "ああ、この人か。"}, {"type": "subtitle", "time": 9496.23, "timestamp": "02:38:16", "text": "バッズバーが買えるよ。行くよ、手に入れるよ"}, {"type": "subtitle", "time": 9498.389, "timestamp": "02:38:18", "text": "ボストン。正確には、あ、待ってください。いいえ、彼は"}, {"type": "subtitle", "time": 9501.27, "timestamp": "02:38:21", "text": "彼らは薬を服用した。どうでも。は"}, {"type": "subtitle", "time": 9503.75, "timestamp": "02:38:23", "text": "彼はここにいないの？ああ、彼が来る。彼は"}, {"type": "subtitle", "time": 9507.51, "timestamp": "02:38:27", "text": "来るよ。はい、はい。ここ。どこに"}, {"type": "subtitle", "time": 9510.23, "timestamp": "02:38:30", "text": "あ、待って。いいえ、こちらはグレッグです。待って、"}, {"type": "subtitle", "time": 9524.07, "timestamp": "02:38:44", "text": "そろそろその時でしょうか？私は成層圏から抜け出した"}, {"type": "subtitle", "time": 9526.79, "timestamp": "02:38:46", "text": "今すぐ。"}, {"type": "subtitle", "time": 9531.349, "timestamp": "02:38:51", "text": "ニース。わかった、彼はここに来るだろう。"}, {"type": "subtitle", "time": 9533.83, "timestamp": "02:38:53", "text": "えっと、あと2つあります。スケートで1つ"}, {"type": "subtitle", "time": 9536.19, "timestamp": "02:38:56", "text": "公園と1つ"}]
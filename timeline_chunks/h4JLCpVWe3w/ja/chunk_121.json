[{"type": "subtitle", "time": 7262.709, "timestamp": "02:01:02", "text": "わかった。皆さん、どれくらい注文すればいいですか？のように"}, {"type": "subtitle", "time": 7266.39, "timestamp": "02:01:06", "text": "注文はどれくらい必要ですか？いくら"}, {"type": "subtitle", "time": 7268.31, "timestamp": "02:01:08", "text": "私たちにそんな余裕があるだろうか？ 1つ注文します"}, {"type": "subtitle", "time": 7272.149, "timestamp": "02:01:12", "text": "今。ええ、もちろんです。"}, {"type": "subtitle", "time": 7274.55, "timestamp": "02:01:14", "text": "所要時間は約30分です。大丈夫。"}, {"type": "subtitle", "time": 7281.149, "timestamp": "02:01:21", "text": "の"}, {"type": "subtitle", "time": 7283.91, "timestamp": "02:01:23", "text": "みんな、もうすぐポポが少し始まるよ。みんな、"}, {"type": "subtitle", "time": 7285.91, "timestamp": "02:01:25", "text": "モーテルに行かなければならない。よし。"}, {"type": "subtitle", "time": 7294.07, "timestamp": "02:01:34", "text": "おお。おお。私はたくさんの無料"}, {"type": "subtitle", "time": 7296.149, "timestamp": "02:01:36", "text": "サンプルはこちらです。来て。来て。"}, {"type": "subtitle", "time": 7299.669, "timestamp": "02:01:39", "text": "巨額の資金。来て。来て。"}, {"type": "subtitle", "time": 7302.709, "timestamp": "02:01:42", "text": "おお。一体どういうことだ？顧客が拒否する"}, {"type": "subtitle", "time": 7303.99, "timestamp": "02:01:43", "text": "サンプル。ここにあります。ここにあります。その"}, {"type": "subtitle", "time": 7305.75, "timestamp": "02:01:45", "text": "ここ。"}, {"type": "subtitle", "time": 7308.03, "timestamp": "02:01:48", "text": "どこ？どこ？どこ？外に出て"}, {"type": "subtitle", "time": 7311.629, "timestamp": "02:01:51", "text": "駐車場近くの死者"}, {"type": "subtitle", "time": 7314.629, "timestamp": "02:01:54", "text": "ガレージ。こちらです。こちらです。こちらです。"}, {"type": "subtitle", "time": 7317.31, "timestamp": "02:01:57", "text": "えっと、メインドロイド。私を見て"}]
[{"type": "subtitle", "time": 9302.83, "timestamp": "02:35:02", "text": "ここにスケートリンクはないの？"}, {"type": "subtitle", "time": 9311.59, "timestamp": "02:35:11", "text": "それ。よし、今夜は３つあるぞ。我々は持っています"}, {"type": "subtitle", "time": 9314.59, "timestamp": "02:35:14", "text": "赤ちゃんを"}, {"type": "subtitle", "time": 9317.59, "timestamp": "02:35:17", "text": "今夜。黙れ。"}, {"type": "subtitle", "time": 9318.349, "timestamp": "02:35:18", "text": "シャット"}, {"type": "subtitle", "time": 9319.99, "timestamp": "02:35:19", "text": "上。"}, {"type": "subtitle", "time": 9326.91, "timestamp": "02:35:26", "text": "ああ、まだあと2人いる。聖なる"}, {"type": "subtitle", "time": 9328.99, "timestamp": "02:35:28", "text": "くそっ。"}, {"type": "subtitle", "time": 9331.309, "timestamp": "02:35:31", "text": "えっと、"}, {"type": "subtitle", "time": 9334.79, "timestamp": "02:35:34", "text": "取引。私たちは十分な量を確保できるのだろうか？"}, {"type": "subtitle", "time": 9337.11, "timestamp": "02:35:37", "text": "ええと、3つあります。いくら持っていますか？"}, {"type": "subtitle", "time": 9339.27, "timestamp": "02:35:39", "text": "いくつお持ちですか？私は5つ持っています、"}, {"type": "subtitle", "time": 9341.349, "timestamp": "02:35:41", "text": "8、そしてまた8。私たちは"}, {"type": "subtitle", "time": 9343.91, "timestamp": "02:35:43", "text": "十分あります。そうそう。大丈夫です。"}, {"type": "subtitle", "time": 9347.19, "timestamp": "02:35:47", "text": "今夜やろう。よし。私は行きます"}, {"type": "subtitle", "time": 9348.87, "timestamp": "02:35:48", "text": "次の"}, {"type": "subtitle", "time": 9351.91, "timestamp": "02:35:51", "text": "午後にすれば、十分な時間が取れるでしょう。"}, {"type": "subtitle", "time": 9355.03, "timestamp": "02:35:55", "text": "うん。いや、深夜にやってくれ。知っている、"}, {"type": "subtitle", "time": 9357.59, "timestamp": "02:35:57", "text": "しかし、それでは足りなくなるだろう。"}]
[{"type": "subtitle", "time": 16741.39, "timestamp": "04:39:01", "text": "バン。"}, {"type": "subtitle", "time": 16743.51, "timestamp": "04:39:03", "text": "わかった。ところで、もしあなたが死んでいたら、"}, {"type": "subtitle", "time": 16744.789, "timestamp": "04:39:04", "text": "壁を通り抜けることができる。そうしない"}, {"type": "subtitle", "time": 16747.269, "timestamp": "04:39:07", "text": "ドアを開ける必要がある。"}, {"type": "subtitle", "time": 16749.029, "timestamp": "04:39:09", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 16751.109, "timestamp": "04:39:11", "text": "ああ、私は変えられない あなたは変えられない"}, {"type": "subtitle", "time": 16752.39, "timestamp": "04:39:12", "text": "地図。何も触ってはいけません"}, {"type": "subtitle", "time": 16755.83, "timestamp": "04:39:15", "text": "なぜなら、あなたは死ぬからだ。ああ、彼女が私に向かってくる"}, {"type": "subtitle", "time": 16764.07, "timestamp": "04:39:24", "text": "ところで、ここで一つだけ言っておきます。"}, {"type": "subtitle", "time": 16766.23, "timestamp": "04:39:26", "text": "えっと、彼女が投げたプレートのところへ行って"}, {"type": "subtitle", "time": 16770.629, "timestamp": "04:39:30", "text": "皿。 Eキーを押して皿を選んでください。"}, {"type": "subtitle", "time": 16773.75, "timestamp": "04:39:33", "text": "えっと、お皿。彼女はどこに投げたのか"}, {"type": "subtitle", "time": 16775.75, "timestamp": "04:39:35", "text": "皿？"}, {"type": "subtitle", "time": 16778.948, "timestamp": "04:39:38", "text": "ああ、わかりました。食べなさい。ナンバープレートを手に入れました。"}, {"type": "subtitle", "time": 16781.07, "timestamp": "04:39:41", "text": "来て"}, {"type": "subtitle", "time": 16784.708, "timestamp": "04:39:44", "text": "私にそれを足に投げつけて、私が見るように"}, {"type": "subtitle", "time": 16786.47, "timestamp": "04:39:46", "text": "皿。それで、私たちは"}, {"type": "subtitle", "time": 16790.27, "timestamp": "04:39:50", "text": "チェーンソー、ハンマー、そしてスーク。"}, {"type": "subtitle", "time": 16794.27, "timestamp": "04:39:54", "text": "ああ、君たちはそれをやっていたのか？ああ、"}, {"type": "subtitle", "time": 16797.19, "timestamp": "04:39:57", "text": "神。まるで、"}]
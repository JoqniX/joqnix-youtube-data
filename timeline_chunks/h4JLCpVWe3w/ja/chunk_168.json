[{"type": "subtitle", "time": 10083.11, "timestamp": "02:48:03", "text": "ディーラー。ベンジー・コールマンという男がいる。"}, {"type": "subtitle", "time": 10085.91, "timestamp": "02:48:05", "text": "彼の名前はベンジーです。まず最初に"}, {"type": "subtitle", "time": 10087.99, "timestamp": "02:48:07", "text": "一緒に働く。あなたは雇うことができません"}, {"type": "subtitle", "time": 10089.83, "timestamp": "02:48:09", "text": "友人の一人が"}, {"type": "subtitle", "time": 10091.99, "timestamp": "02:48:11", "text": "あなたにおすすめします。ベンジーは友達です"}, {"type": "subtitle", "time": 10094.67, "timestamp": "02:48:14", "text": "ペギー、ベス、そして"}, {"type": "subtitle", "time": 10100.469, "timestamp": "02:48:20", "text": "友好的な関係を築く"}, {"type": "subtitle", "time": 10104.07, "timestamp": "02:48:24", "text": "コール、ルーウィグ、またはベス。はい、私は"}, {"type": "subtitle", "time": 10106.87, "timestamp": "02:48:26", "text": "ここでゲームを終えてもいいと思う、"}, {"type": "subtitle", "time": 10109.429, "timestamp": "02:48:29", "text": "みんな。よし、"}, {"type": "subtitle", "time": 10111.349, "timestamp": "02:48:31", "text": "現金全部をバッグに入れて"}, {"type": "subtitle", "time": 10113.99, "timestamp": "02:48:33", "text": "そして保存する。そうそう。混合が必要です"}, {"type": "subtitle", "time": 10115.75, "timestamp": "02:48:35", "text": "そういうことですよね？"}, {"type": "subtitle", "time": 10118.389, "timestamp": "02:48:38", "text": "うん、待って、"}, {"type": "subtitle", "time": 10120.07, "timestamp": "02:48:40", "text": "十分。ええ、十分ありますよ。私は持っている"}, {"type": "subtitle", "time": 10123.51, "timestamp": "02:48:43", "text": "93. もう少しあると思います。私"}, {"type": "subtitle", "time": 10127.19, "timestamp": "02:48:47", "text": "私は十分な現金を持っています。"}, {"type": "subtitle", "time": 10129.83, "timestamp": "02:48:49", "text": "何？ほら、私はみんなに話さないけど"}, {"type": "subtitle", "time": 10130.83, "timestamp": "02:48:50", "text": "私の"}, {"type": "subtitle", "time": 10135.67, "timestamp": "02:48:55", "text": "現金取引。何？それは正しい。あなた"}, {"type": "subtitle", "time": 10137.83, "timestamp": "02:48:57", "text": "男たちは決して知らないだろう。わかりました、"}, {"type": "subtitle", "time": 10139.63, "timestamp": "02:48:59", "text": "買いに行く"}]
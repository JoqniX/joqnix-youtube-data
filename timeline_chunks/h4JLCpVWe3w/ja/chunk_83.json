[{"type": "subtitle", "time": 4983.11, "timestamp": "01:23:03", "text": "彼と話してください。いや、自分のゲームだと思う。"}, {"type": "subtitle", "time": 4986.39, "timestamp": "01:23:06", "text": "おお。ああ、マリファナを手に入れる必要がある"}, {"type": "subtitle", "time": 4990.629, "timestamp": "01:23:10", "text": "何ですって？右。あなたはそれを手に入れる必要があります"}, {"type": "subtitle", "time": 4995.03, "timestamp": "01:23:15", "text": "土壌。なんてこった。雑草の種。彼は必要としている"}, {"type": "subtitle", "time": 4998.31, "timestamp": "01:23:18", "text": "雑草の種。えっと"}, {"type": "subtitle", "time": 5000.31, "timestamp": "01:23:20", "text": "何てことだ。目的が何か分かりますか？"}, {"type": "subtitle", "time": 5002.629, "timestamp": "01:23:22", "text": "目的は何ですか？"}, {"type": "subtitle", "time": 5004.11, "timestamp": "01:23:24", "text": "おお。"}, {"type": "subtitle", "time": 5007.43, "timestamp": "01:23:27", "text": "あらら。おお。わかった。"}, {"type": "subtitle", "time": 5009.669, "timestamp": "01:23:29", "text": "えっと、"}, {"type": "subtitle", "time": 5012.79, "timestamp": "01:23:32", "text": "待って。どうすればいいの？ ああ、くそ。私はそれを受け取った。おお、"}, {"type": "subtitle", "time": 5017.59, "timestamp": "01:23:37", "text": "いいえ。 E. いいえ。E."}, {"type": "subtitle", "time": 5019.59, "timestamp": "01:23:39", "text": "なんてこった。"}, {"type": "subtitle", "time": 5022.07, "timestamp": "01:23:42", "text": "ああ、そうそう。ああ、私はクソみたいな時間を無駄にした"}, {"type": "subtitle", "time": 5025.03, "timestamp": "01:23:45", "text": "おっと。わかった。私たちができることは、"}, {"type": "subtitle", "time": 5026.629, "timestamp": "01:23:46", "text": "モラが終わるまで待ってください。彼が"}, {"type": "subtitle", "time": 5029.189, "timestamp": "01:23:49", "text": "仕上げとして、新しいロビーを作り、"}, {"type": "subtitle", "time": 5032.149, "timestamp": "01:23:52", "text": "それではプロローグは省略します。"}, {"type": "subtitle", "time": 5035.75, "timestamp": "01:23:55", "text": "わかった。うん。ええ、それでいいと思います。"}, {"type": "subtitle", "time": 5037.83, "timestamp": "01:23:57", "text": "待って。では、雑草の種はどこにあったのでしょうか？"}]
[{"type": "subtitle", "time": 5161.669, "timestamp": "01:26:01", "text": "うん。いや、いや。とにかくプレイし続けてください。さあ"}, {"type": "subtitle", "time": 5164.87, "timestamp": "01:26:04", "text": "見る。えっと、もう一度参加します。ああ、わかりました。"}, {"type": "subtitle", "time": 5169.75, "timestamp": "01:26:09", "text": "わかったよ、兄弟。その場面はどこですか？"}, {"type": "subtitle", "time": 5178.31, "timestamp": "01:26:18", "text": "この場所、めちゃくちゃ大きいな。だからもし私が"}, {"type": "subtitle", "time": 5180.629, "timestamp": "01:26:20", "text": "辞めるとどうなりますか？"}, {"type": "subtitle", "time": 5182.95, "timestamp": "01:26:22", "text": "このゲームが好きなのも良いことです"}, {"type": "subtitle", "time": 5186.629, "timestamp": "01:26:26", "text": "たった6ギガバイトだよ、兄弟。何てことだ。これ"}, {"type": "subtitle", "time": 5189.59, "timestamp": "01:26:29", "text": "ゲーム自体もかなり大規模だ。まるで"}, {"type": "subtitle", "time": 5191.43, "timestamp": "01:26:31", "text": "コンテンツ、量のようなもの"}, {"type": "subtitle", "time": 5195.83, "timestamp": "01:26:35", "text": "私が目にするコンテンツは膨大です。"}, {"type": "subtitle", "time": 5199.35, "timestamp": "01:26:39", "text": "容量はわずか6ギガバイト。"}, {"type": "subtitle", "time": 5204.55, "timestamp": "01:26:44", "text": "ああ、わかった。私は女性、男性、女性、男性です。"}, {"type": "subtitle", "time": 5208.229, "timestamp": "01:26:48", "text": "じゃあ、辞めてまた復帰します。"}, {"type": "subtitle", "time": 5211.669, "timestamp": "01:26:51", "text": "わかった。待って、これが、これがそれなの？はい、私は"}, {"type": "subtitle", "time": 5214.95, "timestamp": "01:26:54", "text": "もう推測する必要はありません。ああ、できるよ。ああ、私は"}, {"type": "subtitle", "time": 5218.229, "timestamp": "01:26:58", "text": "ハゲる？あ、待って。えっと、私に送ってください"}]
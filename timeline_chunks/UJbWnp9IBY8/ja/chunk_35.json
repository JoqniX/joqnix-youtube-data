[{"type": "subtitle", "time": 2108.23, "timestamp": "00:35:08", "text": "でも、"}, {"type": "subtitle", "time": 2110.87, "timestamp": "00:35:10", "text": "眠くなって"}, {"type": "subtitle", "time": 2113.19, "timestamp": "00:35:13", "text": "寝てしまっても構いません。どちらにしても、"}, {"type": "subtitle", "time": 2122.069, "timestamp": "00:35:22", "text": "目を閉じて"}, {"type": "subtitle", "time": 2126.31, "timestamp": "00:35:26", "text": "物事を考えようとし、口を開いて、とにかく"}, {"type": "subtitle", "time": 2132.95, "timestamp": "00:35:32", "text": "口を動かすように最善を尽くします。"}, {"type": "subtitle", "time": 2134.55, "timestamp": "00:35:34", "text": "ええと、"}, {"type": "subtitle", "time": 2143.27, "timestamp": "00:35:43", "text": "もっと聞き取りやすくするように気をつけます。ああ、"}, {"type": "subtitle", "time": 2157.51, "timestamp": "00:35:57", "text": "ストリームが長いから、ある意味、"}]
[{"type": "subtitle", "time": 2880.71, "timestamp": "00:48:00", "text": "私にできるのは、いつか、いつか、自分が望んでいたものを手に入れられることを夢見るだけ"}, {"type": "subtitle", "time": 2888.23, "timestamp": "00:48:08", "text": "。やっとたくさんのことを"}, {"type": "subtitle", "time": 2892.309, "timestamp": "00:48:12", "text": "終えた。がっかりさせていないといいんだけど"}, {"type": "subtitle", "time": 2897.67, "timestamp": "00:48:17", "text": "。さあ、"}, {"type": "subtitle", "time": 2908.95, "timestamp": "00:48:28", "text": "何を言っているのか分からない。まあ、"}, {"type": "subtitle", "time": 2911.829, "timestamp": "00:48:31", "text": "気にしないで。"}, {"type": "subtitle", "time": 2917.19, "timestamp": "00:48:37", "text": "とにかく、ちょっと眠い。"}, {"type": "subtitle", "time": 2919.43, "timestamp": "00:48:39", "text": "たぶん、朝はすごくパニックになるだろうな"}, {"type": "subtitle", "time": 2926.87, "timestamp": "00:48:46", "text": "シングルベッド1台だけを研究した。"}, {"type": "subtitle", "time": 2930.309, "timestamp": "00:48:50", "text": "それは私のせいだ。"}, {"type": "subtitle", "time": 2933.829, "timestamp": "00:48:53", "text": "逃げ出したかった。自分の"}, {"type": "subtitle", "time": 2935.91, "timestamp": "00:48:55", "text": "部屋で"}, {"type": "subtitle", "time": 2939.19, "timestamp": "00:48:59", "text": "眠りたかった、起きたくなかった"}]
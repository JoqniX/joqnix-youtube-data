[{"type": "subtitle", "time": 2280.15, "timestamp": "00:38:00", "text": "。たとえ たとえ私が"}, {"type": "subtitle", "time": 2282.63, "timestamp": "00:38:02", "text": "ジュカソンを続けるか続けないか、"}, {"type": "subtitle", "time": 2289.99, "timestamp": "00:38:09", "text": "モデルになってデビューできなかったとしても、最終的に"}, {"type": "subtitle", "time": 2301.19, "timestamp": "00:38:21", "text": "物事が自分の望むように進まなかったとしても、"}, {"type": "subtitle", "time": 2306.95, "timestamp": "00:38:26", "text": "最終的に"}, {"type": "subtitle", "time": 2309.51, "timestamp": "00:38:29", "text": "正しい答えは何なのか、と考えることができると思います。物事には"}, {"type": "subtitle", "time": 2316.79, "timestamp": "00:38:36", "text": "物事には理由がある。そして"}, {"type": "subtitle", "time": 2319.91, "timestamp": "00:38:39", "text": "、そう、"}, {"type": "subtitle", "time": 2322.23, "timestamp": "00:38:42", "text": "彼らが来て、物事には"}, {"type": "subtitle", "time": 2333.19, "timestamp": "00:38:53", "text": "そして、7月のピックがキャンセルされて"}, {"type": "subtitle", "time": 2336.47, "timestamp": "00:38:56", "text": "4月に変わった。"}, {"type": "subtitle", "time": 2338.069, "timestamp": "00:38:58", "text": "それは"}]
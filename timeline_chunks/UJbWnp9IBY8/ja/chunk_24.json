[{"type": "subtitle", "time": 1441.11, "timestamp": "00:24:01", "text": "主な理由は、"}, {"type": "subtitle", "time": 1450.39, "timestamp": "00:24:10", "text": "ええ、"}, {"type": "subtitle", "time": 1454.23, "timestamp": "00:24:14", "text": "来月のことです。それが"}, {"type": "subtitle", "time": 1458.31, "timestamp": "00:24:18", "text": "私を少しぼんやりさせているんです。"}, {"type": "subtitle", "time": 1467.59, "timestamp": "00:24:27", "text": "私はわがままなんです。ええ、"}, {"type": "subtitle", "time": 1470.39, "timestamp": "00:24:30", "text": "頑固なんです。自分が何をしたいのか分から"}, {"type": "subtitle", "time": 1476.789, "timestamp": "00:24:36", "text": "なくて、"}, {"type": "subtitle", "time": 1479.11, "timestamp": "00:24:39", "text": "この配信とか"}, {"type": "subtitle", "time": 1482.07, "timestamp": "00:24:42", "text": "全部、義務のように感じています。"}, {"type": "subtitle", "time": 1484.07, "timestamp": "00:24:44", "text": "正直に言うと、今日はこんな風に愚痴を言いに来たわけじゃないんです"}, {"type": "subtitle", "time": 1496.95, "timestamp": "00:24:56", "text": "ええ、もちろん何人かの人とは話しました。何人かの人と。"}]
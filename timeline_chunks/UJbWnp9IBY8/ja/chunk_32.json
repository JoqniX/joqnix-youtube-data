[{"type": "subtitle", "time": 1921.83, "timestamp": "00:32:01", "text": "私はいつもそういう風に考えるタイプなんだ"}, {"type": "subtitle", "time": 1923.909, "timestamp": "00:32:03", "text": "。"}, {"type": "subtitle", "time": 1926.31, "timestamp": "00:32:06", "text": "今、"}, {"type": "subtitle", "time": 1930.31, "timestamp": "00:32:10", "text": "ジョアソンとその他諸々に必要なのは、自分の支払いをきちんと済ませるのに"}, {"type": "subtitle", "time": 1933.11, "timestamp": "00:32:13", "text": "十分なお金が必要だ"}, {"type": "subtitle", "time": 1935.509, "timestamp": "00:32:15", "text": "。"}, {"type": "subtitle", "time": 1938.63, "timestamp": "00:32:18", "text": "自分の支払いというのは、"}, {"type": "subtitle", "time": 1946.95, "timestamp": "00:32:26", "text": "そう、来月には普通預金"}, {"type": "subtitle", "time": 1949.11, "timestamp": "00:32:29", "text": "口座を開設する。"}, {"type": "subtitle", "time": 1956.07, "timestamp": "00:32:36", "text": "ジョックなどの事業として正式に登録する。"}, {"type": "subtitle", "time": 1961.909, "timestamp": "00:32:41", "text": "でも、それはまた2つのことを意味する。1"}, {"type": "subtitle", "time": 1964.549, "timestamp": "00:32:44", "text": "つ目は、ジョックニックの銀行口座を開設して、"}, {"type": "subtitle", "time": 1969.029, "timestamp": "00:32:49", "text": "必要なものをすべて貯金できるということ。"}, {"type": "subtitle", "time": 1970.87, "timestamp": "00:32:50", "text": "ストリームや"}, {"type": "subtitle", "time": 1974.71, "timestamp": "00:32:54", "text": "ジョックニックとしての活動から得たものはすべてそこに預ける。"}]
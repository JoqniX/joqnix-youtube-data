[{"type": "subtitle", "time": 2342.87, "timestamp": "00:39:02", "text": "私をとても傷つけました。"}, {"type": "subtitle", "time": 2355.91, "timestamp": "00:39:15", "text": "最悪な気分でした。ええ。"}, {"type": "subtitle", "time": 2366.31, "timestamp": "00:39:26", "text": "そして、それは"}, {"type": "subtitle", "time": 2370.31, "timestamp": "00:39:30", "text": "少しやりすぎだったと思います。"}, {"type": "subtitle", "time": 2377.109, "timestamp": "00:39:37", "text": "[音楽]"}, {"type": "subtitle", "time": 2389.75, "timestamp": "00:39:49", "text": "他の種類の物事に関しては、そうですよね"}, {"type": "subtitle", "time": 2393.589, "timestamp": "00:39:53", "text": "？私が"}, {"type": "subtitle", "time": 2395.99, "timestamp": "00:39:55", "text": "やりたいこと、まだ"}, {"type": "subtitle", "time": 2398.79, "timestamp": "00:39:58", "text": "やりたいことなどすべてです。 これからも色々な"}]
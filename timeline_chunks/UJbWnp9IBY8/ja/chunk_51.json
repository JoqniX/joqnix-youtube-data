[{"type": "subtitle", "time": 3069.91, "timestamp": "00:51:09", "text": "続けられたらいいのにと思う。正直、どれだけ"}, {"type": "subtitle", "time": 3074.95, "timestamp": "00:51:14", "text": "長く、どれだけ長く続けられるか。"}, {"type": "subtitle", "time": 3094.47, "timestamp": "00:51:34", "text": "コミッションを受けるという選択肢も検討したいと思っていました。"}, {"type": "subtitle", "time": 3097.99, "timestamp": "00:51:37", "text": "誰かから依頼が来るかどうかもわかりません。"}]
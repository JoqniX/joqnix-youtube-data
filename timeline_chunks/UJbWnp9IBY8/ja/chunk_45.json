[{"type": "subtitle", "time": 2714.23, "timestamp": "00:45:14", "text": "でも、"}, {"type": "subtitle", "time": 2716.87, "timestamp": "00:45:16", "text": "24時間配信すると言ったのは私なんです。"}, {"type": "subtitle", "time": 2720.15, "timestamp": "00:45:20", "text": "自分の記録を破る。毎日あれこれやる"}, {"type": "subtitle", "time": 2728.15, "timestamp": "00:45:28", "text": "そして、"}, {"type": "subtitle", "time": 2731.43, "timestamp": "00:45:31", "text": "毎日、毎時間、24時間配信して、"}, {"type": "subtitle", "time": 2739.349, "timestamp": "00:45:39", "text": "視聴者がいる状態だと、あまり多くの人が"}, {"type": "subtitle", "time": 2741.19, "timestamp": "00:45:41", "text": "来てくれないだろうと気づきました。なぜなら、たとえ"}, {"type": "subtitle", "time": 2744.069, "timestamp": "00:45:44", "text": "今日や"}, {"type": "subtitle", "time": 2746.069, "timestamp": "00:45:46", "text": "今日できなくても、チョコレートがいつもそこにあるので、次の日にはいつでも戻ってこられるとみんな知っているからです"}, {"type": "subtitle", "time": 2755.43, "timestamp": "00:45:55", "text": "人が来ても、"}]
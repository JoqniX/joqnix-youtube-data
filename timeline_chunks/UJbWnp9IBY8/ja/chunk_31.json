[{"type": "subtitle", "time": 1863.99, "timestamp": "00:31:03", "text": "。"}, {"type": "subtitle", "time": 1868.87, "timestamp": "00:31:08", "text": "だから、何か、"}, {"type": "subtitle", "time": 1878.389, "timestamp": "00:31:18", "text": "商業的に何か騒ぎを起こして、報酬をもらってやってもいいんじゃないかって。"}, {"type": "subtitle", "time": 1881.11, "timestamp": "00:31:21", "text": "つまり、"}, {"type": "subtitle", "time": 1888.47, "timestamp": "00:31:28", "text": "自分のスキルが下手なら、なんで"}, {"type": "subtitle", "time": 1891.909, "timestamp": "00:31:31", "text": "お金をもらってるんだろうってことだよね。 何をやっても上手くいかない"}, {"type": "subtitle", "time": 1902.95, "timestamp": "00:31:42", "text": "私の理想の一つだと思う"}, {"type": "subtitle", "time": 1905.83, "timestamp": "00:31:45", "text": "。だからそういう考え方をするのかもしれない。わからないけど。"}, {"type": "subtitle", "time": 1919.19, "timestamp": "00:31:59", "text": "でも"}]
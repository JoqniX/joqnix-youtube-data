[{"type": "subtitle", "time": 2048.629, "timestamp": "00:34:08", "text": "報酬を得たり、自分が望む場所にたどり着くためには、もっともっともっと頑張らなければならないと思っています"}, {"type": "subtitle", "time": 2055.669, "timestamp": "00:34:15", "text": "今やっていることは十分ではないと思っています。そう思っていたことは一度もありませんし、今もそう思っています"}, {"type": "subtitle", "time": 2065.99, "timestamp": "00:34:25", "text": "。"}, {"type": "subtitle", "time": 2068.149, "timestamp": "00:34:28", "text": "でも"}, {"type": "subtitle", "time": 2069.909, "timestamp": "00:34:29", "text": "、まさにその考え方、つまり"}, {"type": "subtitle", "time": 2085.109, "timestamp": "00:34:45", "text": "誰にも頼らず、自分"}]
[{"type": "subtitle", "time": 2170.87, "timestamp": "00:36:10", "text": "動画にして投稿したいような気がする"}, {"type": "subtitle", "time": 2182.79, "timestamp": "00:36:22", "text": "問題は、まだ何"}, {"type": "subtitle", "time": 2189.19, "timestamp": "00:36:29", "text": "ヶ月も残っていると分かっていると、何かを先延ばしにしてしまうということ。それが私"}, {"type": "subtitle", "time": 2204.63, "timestamp": "00:36:44", "text": "試験があるから、時間がある、今時間がある、と自分に言い聞かせた。私を見て"}, {"type": "subtitle", "time": 2210.55, "timestamp": "00:36:50", "text": "。"}, {"type": "subtitle", "time": 2213.91, "timestamp": "00:36:53", "text": "もっと時間がある。先延ばしにして時間を無駄にして、"}]
[{"type": "subtitle", "time": 1811.99, "timestamp": "00:30:11", "text": "作るとか、"}, {"type": "subtitle", "time": 1817.669, "timestamp": "00:30:17", "text": "誰かの明らかな問題を解決してあげるとか、何でもいい。自分の"}, {"type": "subtitle", "time": 1830.549, "timestamp": "00:30:30", "text": "サービスでできることなら何でも、"}, {"type": "subtitle", "time": 1851.75, "timestamp": "00:30:51", "text": "自分の中にはそういう一面があるんだよね。"}, {"type": "subtitle", "time": 1854.789, "timestamp": "00:30:54", "text": "いつも「ああ、"}, {"type": "subtitle", "time": 1857.51, "timestamp": "00:30:57", "text": "自分の技術は下手だ。もっと技術を磨いて、もっと上手くならないといけない」って言ってる"}]
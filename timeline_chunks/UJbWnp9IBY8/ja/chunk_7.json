[{"type": "subtitle", "time": 422.55, "timestamp": "00:07:02", "text": "えっと、"}, {"type": "subtitle", "time": 426.309, "timestamp": "00:07:06", "text": "問題は、なぜか"}, {"type": "subtitle", "time": 433.67, "timestamp": "00:07:13", "text": "送信が終了したとか"}, {"type": "subtitle", "time": 437.749, "timestamp": "00:07:17", "text": "送信は終了していないとか、実際に積極的に言っていることです。"}, {"type": "subtitle", "time": 442.71, "timestamp": "00:07:22", "text": "正直、理解できません。"}, {"type": "subtitle", "time": 445.749, "timestamp": "00:07:25", "text": "でも、このファンのことは気にしないでください。少し時間を割いて私の話を"}, {"type": "subtitle", "time": 451.67, "timestamp": "00:07:31", "text": "聞いていただければ、とてもありがたいと思います"}, {"type": "subtitle", "time": 456.79, "timestamp": "00:07:36", "text": "。 そう、明日は私の試験です。"}, {"type": "subtitle", "time": 461.029, "timestamp": "00:07:41", "text": "私は勉強していません。 それは私の責任です。 やってみたけど、よくわからない"}, {"type": "subtitle", "time": 468.71, "timestamp": "00:07:48", "text": "。"}, {"type": "subtitle", "time": 471.589, "timestamp": "00:07:51", "text": "実は、いろいろ考えていたんです"}, {"type": "subtitle", "time": 473.749, "timestamp": "00:07:53", "text": "。 えっと、"}, {"type": "subtitle", "time": 477.51, "timestamp": "00:07:57", "text": "最近は"}]
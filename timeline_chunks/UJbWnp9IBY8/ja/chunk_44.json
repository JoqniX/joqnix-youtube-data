[{"type": "subtitle", "time": 2641.03, "timestamp": "00:44:01", "text": "ほぼ50分です。ええ、"}, {"type": "subtitle", "time": 2655.589, "timestamp": "00:44:15", "text": "。そして、聞いていた人、またはこれを見つけた人は、サインをありがとう。"}, {"type": "subtitle", "time": 2675.829, "timestamp": "00:44:35", "text": "私の一部は"}, {"type": "subtitle", "time": 2679.51, "timestamp": "00:44:39", "text": "物事を考えているようなものです。 自分が何をし"}, {"type": "subtitle", "time": 2683.99, "timestamp": "00:44:43", "text": "たいのか、優柔不断すぎるんです。"}, {"type": "subtitle", "time": 2686.069, "timestamp": "00:44:46", "text": "心のどこかで「"}, {"type": "subtitle", "time": 2687.91, "timestamp": "00:44:47", "text": "モバイル配信を終了して、"}, {"type": "subtitle", "time": 2691.91, "timestamp": "00:44:51", "text": "寝て、そのまま再生を続ければいい」と思っている部分もあります。でも"}, {"type": "subtitle", "time": 2694.069, "timestamp": "00:44:54", "text": "、同時にすごく"}]
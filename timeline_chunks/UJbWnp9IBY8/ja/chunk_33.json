[{"type": "subtitle", "time": 1983.43, "timestamp": "00:33:03", "text": "ジョックとその他諸々のための別々の場所のようなものだ。もう1つは、自分がやろうとしていることに"}, {"type": "subtitle", "time": 1991.43, "timestamp": "00:33:11", "text": "もっと努力して、"}, {"type": "subtitle", "time": 1996.47, "timestamp": "00:33:16", "text": "正しくやらなければならないということだ。だから、もっと多くのことをして、もっと"}, {"type": "subtitle", "time": 2005.509, "timestamp": "00:33:25", "text": "一生懸命働いて、"}, {"type": "subtitle", "time": 2008.63, "timestamp": "00:33:28", "text": "もっとうまくやって、"}, {"type": "subtitle", "time": 2013.909, "timestamp": "00:33:33", "text": "ストリームや 内容的には、"}, {"type": "subtitle", "time": 2021.83, "timestamp": "00:33:41", "text": "ええ。でも、ある意味、自分で"}, {"type": "subtitle", "time": 2030.149, "timestamp": "00:33:50", "text": "試してみたいことはたくさんあるのですが、いつも"}, {"type": "subtitle", "time": 2038.789, "timestamp": "00:33:58", "text": "ベストを尽くせていないような気がします。"}]
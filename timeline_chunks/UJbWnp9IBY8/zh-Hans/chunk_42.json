[{"type": "subtitle", "time": 2525.91, "timestamp": "00:42:05", "text": "我真心希望自己能停止担忧"}, {"type": "subtitle", "time": 2529.589, "timestamp": "00:42:09", "text": "，对吧？"}, {"type": "subtitle", "time": 2532.79, "timestamp": "00:42:12", "text": "可惜，我做不到。是"}, {"type": "subtitle", "time": 2536.55, "timestamp": "00:42:16", "text": "的，持续的担忧确实在"}, {"type": "subtitle", "time": 2539.27, "timestamp": "00:42:19", "text": "慢慢地"}, {"type": "subtitle", "time": 2541.75, "timestamp": "00:42:21", "text": "影响着我。"}, {"type": "subtitle", "time": 2544.23, "timestamp": "00:42:24", "text": "这很糟糕。"}, {"type": "subtitle", "time": 2548.71, "timestamp": "00:42:28", "text": "是的。我还没有意识到情况会变得"}, {"type": "subtitle", "time": 2564.069, "timestamp": "00:42:44", "text": "那样。"}, {"type": "subtitle", "time": 2568.71, "timestamp": "00:42:48", "text": "我本来想保持"}, {"type": "subtitle", "time": 2571.03, "timestamp": "00:42:51", "text": "直播状态，"}, {"type": "subtitle", "time": 2575.589, "timestamp": "00:42:55", "text": "至少花两个小时认真"}, {"type": "subtitle", "time": 2577.99, "timestamp": "00:42:57", "text": "学习，"}]
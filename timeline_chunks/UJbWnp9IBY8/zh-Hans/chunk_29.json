[{"type": "subtitle", "time": 1749.269, "timestamp": "00:29:09", "text": "可能会从"}, {"type": "subtitle", "time": 1751.19, "timestamp": "00:29:11", "text": "麦克风里听到。我不知道。但是，是的，我在用"}, {"type": "subtitle", "time": 1760.07, "timestamp": "00:29:20", "text": "嗯，"}, {"type": "subtitle", "time": 1771.43, "timestamp": "00:29:31", "text": "伙计，我感觉很累，做所有这些…… 是啊"}, {"type": "subtitle", "time": 1776.31, "timestamp": "00:29:36", "text": "，"}, {"type": "subtitle", "time": 1778.87, "timestamp": "00:29:38", "text": "我也不知道自己为什么还要做这些，"}, {"type": "subtitle", "time": 1782.95, "timestamp": "00:29:42", "text": "我知道我还有很多事要忙，比如"}, {"type": "subtitle", "time": 1787.269, "timestamp": "00:29:47", "text": "和朋友们聚会什么的。而且我也很想念以前那种"}, {"type": "subtitle", "time": 1790.07, "timestamp": "00:29:50", "text": "正常的"}, {"type": "subtitle", "time": 1799.029, "timestamp": "00:29:59", "text": "你知道吗，今天有人建议我开个"}]
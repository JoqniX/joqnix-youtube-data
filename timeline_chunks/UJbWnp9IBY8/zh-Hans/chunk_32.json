[{"type": "subtitle", "time": 1921.83, "timestamp": "00:32:01", "text": "我就是那种总是"}, {"type": "subtitle", "time": 1923.909, "timestamp": "00:32:03", "text": "这样思考的人。"}, {"type": "subtitle", "time": 1926.31, "timestamp": "00:32:06", "text": "我觉得我现在最需要的，"}, {"type": "subtitle", "time": 1930.31, "timestamp": "00:32:10", "text": "就是有足够的钱来支付Joathon的所有开销"}, {"type": "subtitle", "time": 1935.509, "timestamp": "00:32:15", "text": "。"}, {"type": "subtitle", "time": 1938.63, "timestamp": "00:32:18", "text": "我说的“开销”是指"}, {"type": "subtitle", "time": 1946.95, "timestamp": "00:32:26", "text": "，下个月我就会开一个"}, {"type": "subtitle", "time": 1949.11, "timestamp": "00:32:29", "text": "活期账户。"}, {"type": "subtitle", "time": 1952.149, "timestamp": "00:32:32", "text": "我会正式注册为"}, {"type": "subtitle", "time": 1956.07, "timestamp": "00:32:36", "text": "Jocknik的商业账户"}, {"type": "subtitle", "time": 1958.23, "timestamp": "00:32:38", "text": "等等。"}, {"type": "subtitle", "time": 1961.909, "timestamp": "00:32:41", "text": "但这又意味着两件事。"}, {"type": "subtitle", "time": 1964.549, "timestamp": "00:32:44", "text": "第一，我会为Jocknik开一个银行账户，"}, {"type": "subtitle", "time": 1969.029, "timestamp": "00:32:49", "text": "这样我就可以把所有需要的钱都存起来。"}, {"type": "subtitle", "time": 1970.87, "timestamp": "00:32:50", "text": "无论直播收入还是Jocknik的其他"}, {"type": "subtitle", "time": 1974.71, "timestamp": "00:32:54", "text": "活动收入，都会存到那里，"}, {"type": "subtitle", "time": 1979.029, "timestamp": "00:32:59", "text": "就像一个专门为"}]
[{"type": "subtitle", "time": 2404.59, "timestamp": "00:40:04", "text": "我想我还是会继续做音乐。"}, {"type": "subtitle", "time": 2411.349, "timestamp": "00:40:11", "text": "我不知道希望是什么。"}, {"type": "subtitle", "time": 2413.99, "timestamp": "00:40:13", "text": "我只知道我必须做点什么来"}, {"type": "subtitle", "time": 2416.79, "timestamp": "00:40:16", "text": "创造。 钱足够买"}, {"type": "subtitle", "time": 2422.15, "timestamp": "00:40:22", "text": "但"}, {"type": "subtitle", "time": 2425.03, "timestamp": "00:40:25", "text": "光靠直播，我什么也赚不到"}, {"type": "subtitle", "time": 2427.67, "timestamp": "00:40:27", "text": "。"}, {"type": "subtitle", "time": 2431.99, "timestamp": "00:40:31", "text": "我试过，我努力"}, {"type": "subtitle", "time": 2454.15, "timestamp": "00:40:54", "text": "我后悔自己开始滥用"}, {"type": "subtitle", "time": 2455.99, "timestamp": "00:40:55", "text": "直播，"}, {"type": "subtitle", "time": 2458.47, "timestamp": "00:40:58", "text": "不再直播，而是把直播当成一种"}]
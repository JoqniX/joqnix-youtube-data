[{"type": "subtitle", "time": 2880.71, "timestamp": "00:48:00", "text": "我只能梦想着"}, {"type": "subtitle", "time": 2882.71, "timestamp": "00:48:02", "text": "有"}, {"type": "subtitle", "time": 2888.23, "timestamp": "00:48:08", "text": "一天能够实现我的愿望。"}, {"type": "subtitle", "time": 2892.309, "timestamp": "00:48:12", "text": "我终于完成了好多事情。"}, {"type": "subtitle", "time": 2897.67, "timestamp": "00:48:17", "text": "希望我没有让你们失望。"}, {"type": "subtitle", "time": 2900.069, "timestamp": "00:48:20", "text": "开始吧，"}, {"type": "subtitle", "time": 2908.95, "timestamp": "00:48:28", "text": "我也不知道自己在说什么。嗯，别在意"}, {"type": "subtitle", "time": 2911.829, "timestamp": "00:48:31", "text": "。"}, {"type": "subtitle", "time": 2917.19, "timestamp": "00:48:37", "text": "总之，我有点困了。"}, {"type": "subtitle", "time": 2919.43, "timestamp": "00:48:39", "text": "明天"}, {"type": "subtitle", "time": 2926.87, "timestamp": "00:48:46", "text": "我连一张床都没睡过。"}, {"type": "subtitle", "time": 2930.309, "timestamp": "00:48:50", "text": "这都是我的错。"}, {"type": "subtitle", "time": 2933.829, "timestamp": "00:48:53", "text": "我只想逃避。我待在"}, {"type": "subtitle", "time": 2935.91, "timestamp": "00:48:55", "text": "房间里，"}, {"type": "subtitle", "time": 2939.19, "timestamp": "00:48:59", "text": "只想睡觉，"}]
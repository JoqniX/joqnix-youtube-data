[{"type": "subtitle", "time": 2581.51, "timestamp": "00:43:01", "text": "但最后还是"}, {"type": "subtitle", "time": 2590.069, "timestamp": "00:43:10", "text": "即使我醒着。"}, {"type": "subtitle", "time": 2593.27, "timestamp": "00:43:13", "text": "我又在下午三四点醒了"}, {"type": "subtitle", "time": 2595.109, "timestamp": "00:43:15", "text": "。"}, {"type": "subtitle", "time": 2598.39, "timestamp": "00:43:18", "text": "又熬夜到六点。我不知道自己"}, {"type": "subtitle", "time": 2601.75, "timestamp": "00:43:21", "text": "怎么了。"}, {"type": "subtitle", "time": 2612.39, "timestamp": "00:43:32", "text": "嗯。我"}, {"type": "subtitle", "time": 2619.43, "timestamp": "00:43:39", "text": "想就这个话题聊一个小时，"}, {"type": "subtitle", "time": 2629.829, "timestamp": "00:43:49", "text": "直播了多久？我直播了多久？"}, {"type": "subtitle", "time": 2638.23, "timestamp": "00:43:58", "text": "我想大概43分钟吧。嗯，快"}]
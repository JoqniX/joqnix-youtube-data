[{"type": "subtitle", "time": 3192.87, "timestamp": "00:53:12", "text": "想充满热情和乐趣地去做，"}, {"type": "subtitle", "time": 3200.47, "timestamp": "00:53:20", "text": "感到快乐和自豪。"}, {"type": "subtitle", "time": 3203.03, "timestamp": "00:53:23", "text": "如果是"}, {"type": "subtitle", "time": 3208.63, "timestamp": "00:53:28", "text": "一份赚钱的工作，而是真正让我感到自豪。"}, {"type": "subtitle", "time": 3220.23, "timestamp": "00:53:40", "text": "即使我这么做了，我也不知道结果会怎样"}, {"type": "subtitle", "time": 3223.43, "timestamp": "00:53:43", "text": "。"}, {"type": "subtitle", "time": 3225.51, "timestamp": "00:53:45", "text": "但与其想"}, {"type": "subtitle", "time": 3228.63, "timestamp": "00:53:48", "text": "太多、害怕，我觉得我"}, {"type": "subtitle", "time": 3231.91, "timestamp": "00:53:51", "text": "应该尝试一下，"}, {"type": "subtitle", "time": 3233.829, "timestamp": "00:53:53", "text": "对吧？"}, {"type": "subtitle", "time": 3237.19, "timestamp": "00:53:57", "text": "我们应该试试。"}]
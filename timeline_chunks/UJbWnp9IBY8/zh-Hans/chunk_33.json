[{"type": "subtitle", "time": 1983.43, "timestamp": "00:33:03", "text": "Jocknik和其他所有事情设立的独立账户。第二，这"}, {"type": "subtitle", "time": 1988.95, "timestamp": "00:33:08", "text": "也意味着我"}, {"type": "subtitle", "time": 1991.43, "timestamp": "00:33:11", "text": "必须在我正在做的事情上投入更多精力，"}, {"type": "subtitle", "time": 2005.509, "timestamp": "00:33:25", "text": "做很多事情，更努力地工作，把"}, {"type": "subtitle", "time": 2008.63, "timestamp": "00:33:28", "text": "事情做得更好，"}, {"type": "subtitle", "time": 2011.83, "timestamp": "00:33:31", "text": "提高"}, {"type": "subtitle", "time": 2013.909, "timestamp": "00:33:33", "text": "直播和内容制作的质量等等，"}, {"type": "subtitle", "time": 2021.83, "timestamp": "00:33:41", "text": "。但在某种程度上，我觉得 感觉好像是我自己"}, {"type": "subtitle", "time": 2036.31, "timestamp": "00:33:56", "text": "但我总是觉得自己没有"}, {"type": "subtitle", "time": 2038.789, "timestamp": "00:33:58", "text": "做到最好。"}]
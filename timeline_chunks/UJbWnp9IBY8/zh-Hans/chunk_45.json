[{"type": "subtitle", "time": 2702.95, "timestamp": "00:45:02", "text": "我甚至"}, {"type": "subtitle", "time": 2714.23, "timestamp": "00:45:14", "text": "但我也是那个说过要连续直播"}, {"type": "subtitle", "time": 2716.87, "timestamp": "00:45:16", "text": "24小时的人。我要打破"}, {"type": "subtitle", "time": 2720.15, "timestamp": "00:45:20", "text": "自己的纪录。我要每天都做这做那"}, {"type": "subtitle", "time": 2728.15, "timestamp": "00:45:28", "text": "然后我意识到，如果我"}, {"type": "subtitle", "time": 2731.43, "timestamp": "00:45:31", "text": "每天每时每刻都在直播，持续24小时，"}, {"type": "subtitle", "time": 2739.349, "timestamp": "00:45:39", "text": "观众，那应该不会有很多人愿意"}, {"type": "subtitle", "time": 2741.19, "timestamp": "00:45:41", "text": "来看，对吧？因为他们知道，"}, {"type": "subtitle", "time": 2744.069, "timestamp": "00:45:44", "text": "即使我今天来不了"}, {"type": "subtitle", "time": 2746.069, "timestamp": "00:45:46", "text": "，我明天还可以回来，"}, {"type": "subtitle", "time": 2755.43, "timestamp": "00:45:55", "text": "即使有人来了，他们"}]
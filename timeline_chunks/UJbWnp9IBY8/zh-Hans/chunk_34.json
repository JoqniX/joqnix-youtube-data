[{"type": "subtitle", "time": 2040.95, "timestamp": "00:34:00", "text": "我必须更加努力、更加努力、更加"}, {"type": "subtitle", "time": 2045.669, "timestamp": "00:34:05", "text": "努力才能得到"}, {"type": "subtitle", "time": 2048.629, "timestamp": "00:34:08", "text": "回报，或者达到我想要的目标"}, {"type": "subtitle", "time": 2055.669, "timestamp": "00:34:15", "text": "我现在所做的一切都远远不够。"}, {"type": "subtitle", "time": 2061.109, "timestamp": "00:34:21", "text": "我以前从未这样想过，现在依然这么"}, {"type": "subtitle", "time": 2065.99, "timestamp": "00:34:25", "text": "认为。"}, {"type": "subtitle", "time": 2068.149, "timestamp": "00:34:28", "text": "但是，"}, {"type": "subtitle", "time": 2069.909, "timestamp": "00:34:29", "text": "是的，"}, {"type": "subtitle", "time": 2079.349, "timestamp": "00:34:39", "text": "心态，那种单打独斗的心态，"}, {"type": "subtitle", "time": 2085.109, "timestamp": "00:34:45", "text": "不依赖任何人，只依靠"}, {"type": "subtitle", "time": 2091.43, "timestamp": "00:34:51", "text": "我觉得这样"}]
[{"type": "subtitle", "time": 3069.91, "timestamp": "00:51:09", "text": "我只是希望我能坚持下去。老实说，"}, {"type": "subtitle", "time": 3074.95, "timestamp": "00:51:14", "text": "无论我还能坚持多久，无论我还能"}, {"type": "subtitle", "time": 3091.27, "timestamp": "00:51:31", "text": "我都想考虑一下"}, {"type": "subtitle", "time": 3094.47, "timestamp": "00:51:34", "text": "接委托这个选项。"}, {"type": "subtitle", "time": 3097.99, "timestamp": "00:51:37", "text": "我不知道会不会有人接。"}, {"type": "subtitle", "time": 3108.069, "timestamp": "00:51:48", "text": "某种程度上来说，就像我…… 我非常"}]
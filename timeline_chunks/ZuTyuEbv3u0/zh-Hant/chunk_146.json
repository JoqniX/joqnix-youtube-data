[{"type": "subtitle", "time": 8792.63, "timestamp": "02:26:32", "text": "對了。這裡在下雨。我能做到，我感覺好困。但"}, {"type": "subtitle", "time": 8794.55, "timestamp": "02:26:34", "text": "我會挺過去的"}, {"type": "subtitle", "time": 8796.67, "timestamp": "02:26:36", "text": "。必須盡力而為。嗨。嗯，90。所以，大家好嗎"}, {"type": "subtitle", "time": 8804.23, "timestamp": "02:26:44", "text": "？你們晚上過得怎麼樣"}, {"type": "subtitle", "time": 8807.75, "timestamp": "02:26:47", "text": "？H，一個是為期一周的"}, {"type": "subtitle", "time": 8814.67, "timestamp": "02:26:54", "text": "。不。[音樂]哦，我的"}]
[{"type": "subtitle", "time": 35943.99, "timestamp": "09:59:03", "text": "嗯，好吧，那我们就开始吧。  我不知道“嘿，乔，你想说看到什么了吗？”是的，"}, {"type": "subtitle", "time": 35959.19, "timestamp": "09:59:19", "text": "我正盯着你呢。"}, {"type": "subtitle", "time": 35963.19, "timestamp": "09:59:23", "text": "你想看點什麼嗎？是的。  哦，不錯。"}, {"type": "subtitle", "time": 35966.35, "timestamp": "09:59:26", "text": "我是最后一个。我們走吧。"}, {"type": "subtitle", "time": 35987.266, "timestamp": "09:59:47", "text": "揍他們一頓。砰。你们俩最喜欢的《原神》角色是谁"}]
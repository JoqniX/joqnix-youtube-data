[{"type": "subtitle", "time": 4984.149, "timestamp": "01:23:04", "text": "我想做"}, {"type": "subtitle", "time": 4989.31, "timestamp": "01:23:09", "text": "音樂，想成為"}, {"type": "subtitle", "time": 5008.04, "timestamp": "01:23:28", "text": "YouTuber之類的，建立人脈，讓人們開心等等。我剛才說了，我常常自言自語。"}, {"type": "subtitle", "time": 5037.75, "timestamp": "01:23:57", "text": "我的意思是，我覺得你很誠實，去做你真正、真正、真正、想做的事情。我覺得這真的觸動了她，所以"}]
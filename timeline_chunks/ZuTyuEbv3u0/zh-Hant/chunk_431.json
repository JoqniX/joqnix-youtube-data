[{"type": "subtitle", "time": 25871.03, "timestamp": "07:11:11", "text": "天哪。我們得回去。是的。直接往回走。是的。就像你"}, {"type": "subtitle", "time": 25891.708, "timestamp": "07:11:31", "text": "剛才走的"}, {"type": "subtitle", "time": 25895.15, "timestamp": "07:11:35", "text": "那樣。別擔心我們。有人把我"}, {"type": "subtitle", "time": 25914.19, "timestamp": "07:11:54", "text": "落下了。太遠了。是的。 哦，你們把我丟下了。弄到"}]
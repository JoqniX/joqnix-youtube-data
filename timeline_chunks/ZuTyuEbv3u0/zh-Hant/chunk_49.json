[{"type": "subtitle", "time": 2945.99, "timestamp": "00:49:05", "text": "嗨"}, {"type": "subtitle", "time": 2951.23, "timestamp": "00:49:11", "text": "，我們應該很快就會回來了"}, {"type": "subtitle", "time": 2981.27, "timestamp": "00:49:41", "text": "哦，"}, {"type": "subtitle", "time": 2987.829, "timestamp": "00:49:47", "text": "我覺得我不在那裡，還是我到了？我是不是在"}, {"type": "subtitle", "time": 2989.99, "timestamp": "00:49:49", "text": "做夢？是"}, {"type": "subtitle", "time": 2999.43, "timestamp": "00:49:59", "text": "我會"}]
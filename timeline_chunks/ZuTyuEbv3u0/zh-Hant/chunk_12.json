[{"type": "subtitle", "time": 736.069, "timestamp": "00:12:16", "text": "我必須離開這裡，才能去到你的世界"}, {"type": "subtitle", "time": 776.71, "timestamp": "00:12:56", "text": "我去塔上救人。"}, {"type": "subtitle", "time": 778.55, "timestamp": "00:12:58", "text": "我當然會死。好的。你死了。我不小心從石頭上摔下來了。嘿，我拿到了，是的，我拿到了那個貝殼狀的東西。我的天哪。"}]
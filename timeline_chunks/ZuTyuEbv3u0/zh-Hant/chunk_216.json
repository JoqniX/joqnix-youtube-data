[{"type": "subtitle", "time": 12967.99, "timestamp": "03:36:07", "text": "我在4點左右吃了茶和點心。吃不下晚餐了。是的，這就是"}, {"type": "subtitle", "time": 12980.15, "timestamp": "03:36:20", "text": "我在家時常遇到的情況，就像本地人一樣，你吃晚飯了嗎？哦，我"}, {"type": "subtitle", "time": 12982.63, "timestamp": "03:36:22", "text": "感覺自己好像被禁止節食了，"}, {"type": "subtitle", "time": 12984.309, "timestamp": "03:36:24", "text": "因為上大學已經讓我瘦了很多。所以，聽著，"}, {"type": "subtitle", "time": 13012.55, "timestamp": "03:36:52", "text": "健身前我的體重從47公斤降到了49公斤，但大學畢業後，我基本上…我沒量過體重，但我很確定"}]
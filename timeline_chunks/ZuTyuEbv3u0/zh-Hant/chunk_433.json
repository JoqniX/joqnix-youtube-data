[{"type": "subtitle", "time": 25997.83, "timestamp": "07:13:17", "text": "實際上，這瞄準"}, {"type": "subtitle", "time": 26000.868, "timestamp": "07:13:20", "text": "鏡還不錯。"}, {"type": "subtitle", "time": 26003.99, "timestamp": "07:13:23", "text": "我為什麼"}, {"type": "subtitle", "time": 26007.43, "timestamp": "07:13:27", "text": "要用我的車？我衝進去了。沒什麼大不了的。好的。好。好。那就好。人呢？是啊。現在只剩下三個了，兩隊人，呃，包括我們三個。哦耶。"}, {"type": "subtitle", "time": 26011.07, "timestamp": "07:13:31", "text": "[音樂]"}, {"type": "subtitle", "time": 26013.67, "timestamp": "07:13:33", "text": "嘿，"}, {"type": "subtitle", "time": 26015.43, "timestamp": "07:13:35", "text": "我看到有人了。搞定了。 呃，他什麼也沒做，不過不錯"}]
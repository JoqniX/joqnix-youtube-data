[{"type": "subtitle", "time": 26406.19, "timestamp": "07:20:06", "text": "我沒有選擇。所以我……哦。哦。哦。"}, {"type": "subtitle", "time": 26410.868, "timestamp": "07:20:10", "text": "哦，天哪。哦。冠軍。冷靜。冷靜。冠軍。國王，搞什麼鬼？國王。我的天哪。國王，你需要，"}, {"type": "subtitle", "time": 26415.11, "timestamp": "07:20:15", "text": "你需要，你需要停下來。我的天哪。"}, {"type": "subtitle", "time": 26420.39, "timestamp": "07:20:20", "text": "這些人到底怎麼了？"}, {"type": "subtitle", "time": 26459.39, "timestamp": "07:20:59", "text": "哦，是的。順便說一下，呃……哦，他是……"}]
[{"type": "subtitle", "time": 37563.35, "timestamp": "10:26:03", "text": "？  你就像深陷深渊之中"}, {"type": "subtitle", "time": 37565.03, "timestamp": "10:26:05", "text": "。"}, {"type": "subtitle", "time": 37568.55, "timestamp": "10:26:08", "text": "哦，不。  等等，什麼？不。嗯？等等"}, {"type": "subtitle", "time": 37573.03, "timestamp": "10:26:13", "text": "，我好像就站在你"}, {"type": "subtitle", "time": 37586.51, "timestamp": "10:26:26", "text": "。  哦，是的。你在這裡。"}, {"type": "subtitle", "time": 37594.63, "timestamp": "10:26:34", "text": "不用擔心。哇。  你嚇壞了。你吓坏了，而且陷得很深"}]
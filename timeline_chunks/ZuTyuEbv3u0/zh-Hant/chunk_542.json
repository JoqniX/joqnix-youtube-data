[{"type": "subtitle", "time": 32523.83, "timestamp": "09:02:03", "text": "哪裡？好的，酷。總之"}, {"type": "subtitle", "time": 32526.548, "timestamp": "09:02:06", "text": "，呃，是的。你知道嗎？這是我聽過最棒的事了"}, {"type": "subtitle", "time": 32534.868, "timestamp": "09:02:14", "text": "。"}, {"type": "subtitle", "time": 32536.75, "timestamp": "09:02:16", "text": "所以，我很感激……"}, {"type": "subtitle", "time": 32547.99, "timestamp": "09:02:27", "text": "好吧，我摔倒了。別擔心。我喜歡……我喜歡用兩個聊天，混亂很有趣。是"}, {"type": "subtitle", "time": 32552.07, "timestamp": "09:02:32", "text": "啊。怎麼了？"}]
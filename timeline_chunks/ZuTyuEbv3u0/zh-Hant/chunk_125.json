[{"type": "subtitle", "time": 7501.709, "timestamp": "02:05:01", "text": "？開嗎？不。糟了。糟了。"}, {"type": "subtitle", "time": 7511.95, "timestamp": "02:05:11", "text": "我實際上沒有幫手。情況糟透了。嘿"}, {"type": "subtitle", "time": 7519.189, "timestamp": "02:05:19", "text": "，你會沒事的。現在你贏了。你擁有正義的三根支柱。你現在有……一、二、三、四、五、六個士兵或小兵。它們造成的"}, {"type": "subtitle", "time": 7541.07, "timestamp": "02:05:41", "text": "傷害不大"}, {"type": "subtitle", "time": 7543.93, "timestamp": "02:05:43", "text": "。你會沒事的。我有一個"}]
[{"type": "subtitle", "time": 8881.03, "timestamp": "02:28:01", "text": "。樂]有那麼一秒鐘。"}, {"type": "subtitle", "time": 8890.63, "timestamp": "02:28:10", "text": "嗯，是的，會非常貴。我可以，我感覺到了。看看她，她真可愛。"}, {"type": "subtitle", "time": 8907.75, "timestamp": "02:28:27", "text": "哦，我得"}, {"type": "subtitle", "time": 8917.03, "timestamp": "02:28:37", "text": "咬一口這個。我該買嗎？我不"}, {"type": "subtitle", "time": 8921.429, "timestamp": "02:28:41", "text": "知道。我不應該。別讓我反轉思維對你的健康有益。是"}, {"type": "subtitle", "time": 8925.03, "timestamp": "02:28:45", "text": "啊。對了，算了，"}]
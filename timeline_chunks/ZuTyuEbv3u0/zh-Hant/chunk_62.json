[{"type": "subtitle", "time": 3735.109, "timestamp": "01:02:15", "text": "哦，你現在一個人住？哇。呃，目前還不是，但是，嗯，很快就會了。哦，真好，真好，真好。是啊，其實我挺害怕的。"}, {"type": "subtitle", "time": 3765.71, "timestamp": "01:02:45", "text": "我現在"}, {"type": "subtitle", "time": 3768.39, "timestamp": "01:02:48", "text": "不太喜歡一個人住。等等。呃，"}, {"type": "subtitle", "time": 3775.43, "timestamp": "01:02:55", "text": "你喜歡一個人住，還是比較喜歡跟室友合住？其實我更喜歡……"}]
[{"type": "subtitle", "time": 27425.59, "timestamp": "07:37:05", "text": "哦，我們罩著你，兄弟。快點。我勒個去？我沒有殺任何人，我什麼都沒做，但我們卻因為一些奇怪的原因贏了。我勒個去？"}, {"type": "subtitle", "time": 27433.83, "timestamp": "07:37:13", "text": "我沒有殺"}, {"type": "subtitle", "time": 27452.59, "timestamp": "07:37:32", "text": "任何人，我什麼都沒做，"}, {"type": "subtitle", "time": 27469.75, "timestamp": "07:37:49", "text": "但我們卻因為一些奇怪的原因贏了。"}, {"type": "subtitle", "time": 27473.468, "timestamp": "07:37:53", "text": "嘿，我們酷了。  我的天哪。又是三角形的梗。你"}, {"type": "subtitle", "time": 27478.19, "timestamp": "07:37:58", "text": "還想再試試我的運氣嗎？讓我們來看看。我什麼時候能拿到金幣？"}]
[{"type": "subtitle", "time": 34341.03, "timestamp": "09:32:21", "text": "知道吗，我收到了饼干。这是我第一次真正吃饼干。昨天我表弟来的时候，他们"}, {"type": "subtitle", "time": 34345.99, "timestamp": "09:32:25", "text": "带了一些很漂亮的东西。我当时就想，“这到底有什么好吃的？”  我带来的。  是的"}, {"type": "subtitle", "time": 34366.99, "timestamp": "09:32:46", "text": "。"}, {"type": "subtitle", "time": 34370.71, "timestamp": "09:32:50", "text": "你好。我過得怎麼樣？"}]
[{"type": "subtitle", "time": 12427.75, "timestamp": "03:27:07", "text": "是的。是的。比如說，如果時間跨度是一個月或者一個半月，因為我必須完成學位。不，我不會好好完成大三的學業，因為我現在沒有資格參加"}, {"type": "subtitle", "time": 12451.55, "timestamp": "03:27:31", "text": "大三的補考。"}, {"type": "subtitle", "time": 12455.03, "timestamp": "03:27:35", "text": "兄弟，我應該好好研究一下"}, {"type": "subtitle", "time": 12465.59, "timestamp": "03:27:45", "text": "積壓問題。  [音樂]"}, {"type": "subtitle", "time": 12468.07, "timestamp": "03:27:48", "text": "猜猜"}, {"type": "subtitle", "time": 12470.55, "timestamp": "03:27:50", "text": "我有多少個。多少？  一，不。二、三、五。"}]
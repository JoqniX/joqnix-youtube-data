[{"type": "subtitle", "time": 13087.99, "timestamp": "03:38:07", "text": "富家子弟，他們會像大麻一樣。這"}, {"type": "subtitle", "time": 13104.07, "timestamp": "03:38:24", "text": "我的天哪，外面又下雨"}, {"type": "subtitle", "time": 13106.49, "timestamp": "03:38:26", "text": "又"}, {"type": "subtitle", "time": 13128.469, "timestamp": "03:38:48", "text": "刮風。氾濫了，我當時就想，我的天哪，這一切竟然發生在"}, {"type": "subtitle", "time": 13139.99, "timestamp": "03:38:59", "text": "我去日本之前。 「你是說那個……哦，等等。我"}]
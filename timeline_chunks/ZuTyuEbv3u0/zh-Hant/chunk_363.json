[{"type": "subtitle", "time": 21790.27, "timestamp": "06:03:10", "text": "什麼時候？我"}, {"type": "subtitle", "time": 21793.99, "timestamp": "06:03:13", "text": "忘了時間。我當時專注於自己的事情，努力學習我在三天前直播中談到的內容。哇。給我的安排），我……"}, {"type": "subtitle", "time": 21795.948, "timestamp": "06:03:15", "text": "嗯，我出去了，好吧，我出去"}, {"type": "subtitle", "time": 21799.19, "timestamp": "06:03:19", "text": "散步什麼的，"}, {"type": "subtitle", "time": 21815.03, "timestamp": "06:03:35", "text": "結果今天下起了瓢潑大雨"}, {"type": "subtitle", "time": 21838.708, "timestamp": "06:03:58", "text": "。今天我"}]
[{"type": "subtitle", "time": 13751.189, "timestamp": "03:49:11", "text": "知道，對吧，20萬。"}, {"type": "subtitle", "time": 13755.75, "timestamp": "03:49:15", "text": "有時候"}, {"type": "subtitle", "time": 13768.79, "timestamp": "03:49:28", "text": "我甚至會質疑一些人的想法，比如我班上有些人連筆記本電腦都沒有，卻"}, {"type": "subtitle", "time": 13778.229, "timestamp": "03:49:38", "text": "我就想，我能買iPhone嗎？為什麼不買筆記本電腦？問題是，如果他們問父母，他們就可以買。對他們"}]
[{"type": "subtitle", "time": 35340.15, "timestamp": "09:49:00", "text": "我想起來了。我们俩都有日元，走吧。"}, {"type": "subtitle", "time": 35343.07, "timestamp": "09:49:03", "text": "你好。你好。  你好。我現在在這裡。我们有卡祖亚和约兰。  好的。对了，乌加布加"}, {"type": "subtitle", "time": 35354.15, "timestamp": "09:49:14", "text": "说了"}, {"type": "subtitle", "time": 35355.79, "timestamp": "09:49:15", "text": "些什么。糟糕。我想起來了。在之前的直播中，我问过大家对长发和短发的看法"}, {"type": "subtitle", "time": 35363.11, "timestamp": "09:49:23", "text": "。"}, {"type": "subtitle", "time": 35372.31, "timestamp": "09:49:32", "text": "然后我解释说，因为我剪了头发，所以也许别人会"}, {"type": "subtitle", "time": 35375.67, "timestamp": "09:49:35", "text": "认为我是女性。"}, {"type": "subtitle", "time": 35389.83, "timestamp": "09:49:49", "text": "哦，原來如此。哦，对，也许是这样。是的。是的，"}, {"type": "subtitle", "time": 35392.47, "timestamp": "09:49:52", "text": "你說得對。發生了什麼事？解釋。我"}]
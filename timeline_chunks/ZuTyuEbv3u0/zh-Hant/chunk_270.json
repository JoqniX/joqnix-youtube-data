[{"type": "subtitle", "time": 16222.469, "timestamp": "04:30:22", "text": "我有點想把"}, {"type": "subtitle", "time": 16225.91, "timestamp": "04:30:25", "text": "左輪手槍拿走，但我還是會留著它。 「我在等。就在他移動方向的正中間。我的骨頭。哦，"}, {"type": "subtitle", "time": 16234.229, "timestamp": "04:30:34", "text": "有人在開車。我的天啊。沒有笨蛋。沒有建築物。你忘了"}, {"type": "subtitle", "time": 16251.59, "timestamp": "04:30:51", "text": "騎師。我的天哪，"}]
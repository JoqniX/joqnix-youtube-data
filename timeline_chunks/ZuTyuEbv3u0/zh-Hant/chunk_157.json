[{"type": "subtitle", "time": 9448.389, "timestamp": "02:37:28", "text": "我相信你有一些馬來西亞"}, {"type": "subtitle", "time": 9449.469, "timestamp": "02:37:29", "text": "朋友，對吧？  是的，我記得在 Instagram 上看過你的藝術作品、藝術合作之類的東西。你"}, {"type": "subtitle", "time": 9466.309, "timestamp": "02:37:46", "text": "發帖了。不。是的。是的。那些"}, {"type": "subtitle", "time": 9469.99, "timestamp": "02:37:49", "text": "藝術家好像來自馬來西亞"}]
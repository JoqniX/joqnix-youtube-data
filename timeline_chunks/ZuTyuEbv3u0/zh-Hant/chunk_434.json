[{"type": "subtitle", "time": 26041.31, "timestamp": "07:14:01", "text": "。 …我們"}, {"type": "subtitle", "time": 26049.788, "timestamp": "07:14:09", "text": "抓住他了。我……我離……很遠……嗯，沒關係。橙色的。哦，漂亮的橙色東西。橙色的東西是什麼？哦，我忘了。"}, {"type": "subtitle", "time": 26052.628, "timestamp": "07:14:12", "text": "呃，你可以"}, {"type": "subtitle", "time": 26064.15, "timestamp": "07:14:24", "text": "得到……活動……東西。實際上，"}, {"type": "subtitle", "time": 26069.83, "timestamp": "07:14:29", "text": "我忘了這回事。不，我不在乎。"}, {"type": "subtitle", "time": 26087.948, "timestamp": "07:14:47", "text": "不過我沒收集。"}, {"type": "subtitle", "time": 26090.548, "timestamp": "07:14:50", "text": "不，我懶得管。我猜你是來大殺四方的"}]
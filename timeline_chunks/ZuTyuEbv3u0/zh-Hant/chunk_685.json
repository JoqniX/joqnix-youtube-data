[{"type": "subtitle", "time": 41101.47, "timestamp": "11:25:01", "text": "现在这些人啊。哦，"}, {"type": "subtitle", "time": 41113.426, "timestamp": "11:25:13", "text": "不是這個人。這個大塊頭。"}, {"type": "subtitle", "time": 41125.266, "timestamp": "11:25:25", "text": "哦，谢谢你的批评。  一秒鐘。好了，我回來了。我回來了。我要死了，夥計。  我能做到嗎？"}, {"type": "subtitle", "time": 41137.47, "timestamp": "11:25:37", "text": "我能做到嗎？真的做到了。我做到了。完成了。快點。是"}, {"type": "subtitle", "time": 41159.426, "timestamp": "11:25:59", "text": "我做的嗎"}]
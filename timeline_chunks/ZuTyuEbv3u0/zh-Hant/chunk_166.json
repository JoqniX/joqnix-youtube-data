[{"type": "subtitle", "time": 9967.83, "timestamp": "02:46:07", "text": "以及所有與我建立聯繫的人。你想來參加嗎"}, {"type": "subtitle", "time": 9970.79, "timestamp": "02:46:10", "text": "？她回答說：「是的，"}, {"type": "subtitle", "time": 10007.91, "timestamp": "02:46:47", "text": "我非常樂意。 」以及所有的一切。我就是這樣追到她的。我沒想到，我百分之百確定她處於不活躍狀態。我的意思是，"}, {"type": "subtitle", "time": 10010.55, "timestamp": "02:46:50", "text": "我確實看到過她的 Discord，你知道，她上線了，但就像偶像活動一樣，而不是完全"}]
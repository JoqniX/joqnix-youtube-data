[{"type": "subtitle", "time": 33679.426, "timestamp": "09:21:19", "text": "對不起。  顶点 顶点 顶点。我努力刷了又刷，才刷到金色的那一个。"}, {"type": "subtitle", "time": 33682.51, "timestamp": "09:21:22", "text": "但之后我的运气就变差了，"}, {"type": "subtitle", "time": 33686.95, "timestamp": "09:21:26", "text": "我输掉了每一场比赛，我看到了我的负69分，还有负"}]
[{"type": "subtitle", "time": 38897.99, "timestamp": "10:48:17", "text": "我比较想要的角色之一是那个……"}, {"type": "subtitle", "time": 38909.746, "timestamp": "10:48:29", "text": "呃……那个莱恩，或者她的角色叫什么来着？兽人角色即将登场，她就像一个身材高挑的女人，长着动物的耳朵，力大无穷等等"}, {"type": "subtitle", "time": 38925.35, "timestamp": "10:48:45", "text": "。"}, {"type": "subtitle", "time": 38929.426, "timestamp": "10:48:49", "text": "我其实想要她。"}, {"type": "subtitle", "time": 38937.8, "timestamp": "10:48:57", "text": "德莱恩，她叫"}]
[{"type": "subtitle", "time": 37519.426, "timestamp": "10:25:19", "text": "走吧。  那束光。你可以再和他"}, {"type": "subtitle", "time": 37521.266, "timestamp": "10:25:21", "text": "谈谈。你好。  好的。這不太好。这温度可不是世界上最舒服的。"}, {"type": "subtitle", "time": 37527.47, "timestamp": "10:25:27", "text": "好的。你們那裡下雨了嗎？  沒關係。"}, {"type": "subtitle", "time": 37533.266, "timestamp": "10:25:33", "text": "不要觉得有压力一定要看我的评论。播放评论。玩电子游戏属于活跃行为。评论很多，我完全理解。你想念他們。沒關係。我们喜欢聊天。是的。"}, {"type": "subtitle", "time": 37541.03, "timestamp": "10:25:41", "text": "等等，"}, {"type": "subtitle", "time": 37545.65, "timestamp": "10:25:45", "text": "什麼？是的，她。發生了什麼事"}]
[{"type": "subtitle", "time": 11520.469, "timestamp": "03:12:00", "text": "呃，他們為什麼不去名古屋之類的地方呢？ 名古屋"}, {"type": "subtitle", "time": 11524.55, "timestamp": "03:12:04", "text": "或"}, {"type": "subtitle", "time": 11526.79, "timestamp": "03:12:06", "text": "東京之類的。  我的意思是，像其中兩個，但不是最近相關的。"}, {"type": "subtitle", "time": 11546.309, "timestamp": "03:12:26", "text": "啊，我想看那個。我最近在看那部賽車題材的動畫。我忘了那個"}, {"type": "subtitle", "time": 11552.389, "timestamp": "03:12:32", "text": "首字母"}, {"type": "subtitle", "time": 11560.23, "timestamp": "03:12:40", "text": "啊，《頭文字D》的續集"}, {"type": "subtitle", "time": 11569.58, "timestamp": "03:12:49", "text": "最近剛"}]
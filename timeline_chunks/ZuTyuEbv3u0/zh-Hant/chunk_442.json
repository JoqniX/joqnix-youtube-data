[{"type": "subtitle", "time": 26525.23, "timestamp": "07:22:05", "text": "，"}, {"type": "subtitle", "time": 26527.83, "timestamp": "07:22:07", "text": "但是我的段位太高了"}, {"type": "subtitle", "time": 26530.468, "timestamp": "07:22:10", "text": "。是啊，為什麼？真不友好，是吧？"}, {"type": "subtitle", "time": 26537.51, "timestamp": "07:22:17", "text": "哇。該死，兄弟。"}, {"type": "subtitle", "time": 26540.27, "timestamp": "07:22:20", "text": "我見過白金段位的人。我就想，是啊，待在那兒"}, {"type": "subtitle", "time": 26571.788, "timestamp": "07:22:51", "text": "。是啊。我就想，離我們遠點。看在上帝的份上，"}, {"type": "subtitle", "time": 26575.19, "timestamp": "07:22:55", "text": "走開。別靠近我們。我們這兒就像是鐵幫，然後突然冒出來這麼個人"}]
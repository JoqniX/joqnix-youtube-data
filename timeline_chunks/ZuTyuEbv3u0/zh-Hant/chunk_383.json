[{"type": "subtitle", "time": 22997.51, "timestamp": "06:23:17", "text": "我的天啊，我的Discord卡住了。這種情況經常發生。我認為這是因為現在我的遊戲電腦的負載過重，導致直播電腦的負載過高。我在直播時 Discord 的自動化程序和 Twitter 的自動化程序有時會"}, {"type": "subtitle", "time": 23006.75, "timestamp": "06:23:26", "text": "卡住"}, {"type": "subtitle", "time": 23023.948, "timestamp": "06:23:43", "text": "大家今天過"}, {"type": "subtitle", "time": 23027.75, "timestamp": "06:23:47", "text": "得怎麼樣？告訴我。告訴"}]
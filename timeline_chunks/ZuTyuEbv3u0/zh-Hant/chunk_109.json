[{"type": "subtitle", "time": 6556.79, "timestamp": "01:49:16", "text": "嗯？"}, {"type": "subtitle", "time": 6564.31, "timestamp": "01:49:24", "text": "等等。什麼？剛才發生了什麼事？"}, {"type": "subtitle", "time": 6586.47, "timestamp": "01:49:46", "text": "你做了什麼？我的天啊"}, {"type": "subtitle", "time": 6588.47, "timestamp": "01:49:48", "text": "。你想到了嗎？我什麼也沒"}]
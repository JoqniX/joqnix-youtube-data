[{"type": "subtitle", "time": 13320.87, "timestamp": "03:42:00", "text": "地元の自動車やUber、Olaなど"}, {"type": "subtitle", "time": 13323.349, "timestamp": "03:42:03", "text": "物価がすごく安いとか、そんな感じ。"}, {"type": "subtitle", "time": 13327.67, "timestamp": "03:42:07", "text": "私は、なぜこのような"}, {"type": "subtitle", "time": 13330.229, "timestamp": "03:42:10", "text": "わかった、わかった、あの、ちょっと待って"}, {"type": "subtitle", "time": 13332.55, "timestamp": "03:42:12", "text": "それらの話で、この話をしよう"}, {"type": "subtitle", "time": 13335.83, "timestamp": "03:42:15", "text": "私の州で発生した問題"}, {"type": "subtitle", "time": 13338.71, "timestamp": "03:42:18", "text": "ええと、つまり、私たちは"}, {"type": "subtitle", "time": 13343.03, "timestamp": "03:42:23", "text": "車用の壁とヨーグルトがあります"}, {"type": "subtitle", "time": 13350.229, "timestamp": "03:42:30", "text": "ビカリは、このような自動車の所有者が"}, {"type": "subtitle", "time": 13352.309, "timestamp": "03:42:32", "text": "抗議活動は急速に行われ、"}, {"type": "subtitle", "time": 13354.229, "timestamp": "03:42:34", "text": "すべての顧客を奪い、"}, {"type": "subtitle", "time": 13357.91, "timestamp": "03:42:37", "text": "いろいろなもの、そしてインターネット上の人々"}, {"type": "subtitle", "time": 13359.59, "timestamp": "03:42:39", "text": "彼らの高い"}, {"type": "subtitle", "time": 13364.389, "timestamp": "03:42:44", "text": "わかった、あのね？私に言わせてください"}, {"type": "subtitle", "time": 13366.229, "timestamp": "03:42:46", "text": "あなたはこれに夢中です、オート"}, {"type": "subtitle", "time": 13369.429, "timestamp": "03:42:49", "text": "インターネットで私は"}, {"type": "subtitle", "time": 13371.19, "timestamp": "03:42:51", "text": "昔は、よくわからない"}, {"type": "subtitle", "time": 13373.269, "timestamp": "03:42:53", "text": "えっと、どうすれば大学に行けるかな？"}, {"type": "subtitle", "time": 13375.11, "timestamp": "03:42:55", "text": "正しく言うと、文字通り私は"}, {"type": "subtitle", "time": 13378.63, "timestamp": "03:42:58", "text": "別の都市で。"}]
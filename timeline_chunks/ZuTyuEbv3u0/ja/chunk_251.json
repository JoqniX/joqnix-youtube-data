[{"type": "subtitle", "time": 15061.99, "timestamp": "04:11:01", "text": "それ以外。だから、あなたもIに参加すべきです"}, {"type": "subtitle", "time": 15064.15, "timestamp": "04:11:04", "text": "今週やりたかったのですが、"}, {"type": "subtitle", "time": 15066.71, "timestamp": "04:11:06", "text": "まずそのことを終わらせよう、"}, {"type": "subtitle", "time": 15069.349, "timestamp": "04:11:09", "text": "それなら来週やります。"}, {"type": "subtitle", "time": 15071.99, "timestamp": "04:11:11", "text": "出発する6月。"}, {"type": "subtitle", "time": 15074.59, "timestamp": "04:11:14", "text": "わかった。うん、"}, {"type": "subtitle", "time": 15077.349, "timestamp": "04:11:17", "text": "私にはないようなものだけかどうか見てみます"}, {"type": "subtitle", "time": 15079.11, "timestamp": "04:11:19", "text": "雨の問題は、すでに"}, {"type": "subtitle", "time": 15081.59, "timestamp": "04:11:21", "text": "息子は準備万端だった。"}, {"type": "subtitle", "time": 15085.83, "timestamp": "04:11:25", "text": "ええ、雨は先週の日曜日に降ったので、"}, {"type": "subtitle", "time": 15088.309, "timestamp": "04:11:28", "text": "そしてそれを確認するが、その後雨が"}, {"type": "subtitle", "time": 15090.11, "timestamp": "04:11:30", "text": "止まらなかった。"}, {"type": "subtitle", "time": 15092.55, "timestamp": "04:11:32", "text": "[音楽]"}, {"type": "subtitle", "time": 15096.229, "timestamp": "04:11:36", "text": "ええ、その部分です。"}, {"type": "subtitle", "time": 15105.59, "timestamp": "04:11:45", "text": "はい。はい。そして出発前に、"}, {"type": "subtitle", "time": 15107.59, "timestamp": "04:11:47", "text": "お知らせやその他何かご希望はありますか？"}, {"type": "subtitle", "time": 15110.389, "timestamp": "04:11:50", "text": "作る"}, {"type": "subtitle", "time": 15112.469, "timestamp": "04:11:52", "text": "観客に好意を示すか、"}, {"type": "subtitle", "time": 15114.79, "timestamp": "04:11:54", "text": "あなた？はい、観客の皆さん、そして皆さん全員に。"}, {"type": "subtitle", "time": 15117.59, "timestamp": "04:11:57", "text": "うん、私も。わかった。"}, {"type": "subtitle", "time": 15119.67, "timestamp": "04:11:59", "text": "今後のお知らせ"}]
[{"type": "subtitle", "time": 123.87, "timestamp": "00:02:03", "text": "注意深い。よし、これで私はできる"}, {"type": "subtitle", "time": 126.09, "timestamp": "00:02:06", "text": "これ。私はしません"}, {"type": "subtitle", "time": 153.309, "timestamp": "00:02:33", "text": "荷降ろし"}, {"type": "subtitle", "time": 165.589, "timestamp": "00:02:45", "text": "オンラインにもアクセスできない"}, {"type": "subtitle", "time": 166.50900000000001, "timestamp": "00:02:46", "text": "もの"}, {"type": "subtitle", "time": 169.50900000000001, "timestamp": "00:02:49", "text": "もう。一体どういうことだ？"}, {"type": "subtitle", "time": 171.27, "timestamp": "00:02:51", "text": "はい。"}]
[{"type": "subtitle", "time": 4261.43, "timestamp": "01:11:01", "text": "うん。戻ってこられるよう最善を尽くします"}, {"type": "subtitle", "time": 4263.189, "timestamp": "01:11:03", "text": "日本からのストリーミング配信とか。だから私たちは"}, {"type": "subtitle", "time": 4266.149, "timestamp": "01:11:06", "text": "バックパックに入れて持ち歩くべきです。ええ、もし"}, {"type": "subtitle", "time": 4269.03, "timestamp": "01:11:09", "text": "もしそうしないなら、私は見つけるだろう"}, {"type": "subtitle", "time": 4271.55, "timestamp": "01:11:11", "text": "あなた自身です。"}, {"type": "subtitle", "time": 4275.03, "timestamp": "01:11:15", "text": "ああ、また戻ってきたい。それは"}, {"type": "subtitle", "time": 4276.79, "timestamp": "01:11:16", "text": "脅迫のように聞こえるはずだったが、"}, {"type": "subtitle", "time": 4278.79, "timestamp": "01:11:18", "text": "それから声に出して言ったんだけど、"}, {"type": "subtitle", "time": 4280.07, "timestamp": "01:11:20", "text": "「待って、それは"}, {"type": "subtitle", "time": 4289.35, "timestamp": "01:11:29", "text": "でも、そうですね、お招きいただきありがとうございました。"}, {"type": "subtitle", "time": 4291.27, "timestamp": "01:11:31", "text": "私と、ほら、私は誇りに思っている"}, {"type": "subtitle", "time": 4294.229, "timestamp": "01:11:34", "text": "あなたはそうするし、私はあなたのために本当に嬉しいし、"}, {"type": "subtitle", "time": 4296.47, "timestamp": "01:11:36", "text": "すべてがうまくいくことを願っています"}, {"type": "subtitle", "time": 4300.87, "timestamp": "01:11:40", "text": "ええと、楽しんでくださいね。何よりもまず、"}, {"type": "subtitle", "time": 4305.47, "timestamp": "01:11:45", "text": "安全だと感じて、安全に過ごして、良い旅をしてください。"}, {"type": "subtitle", "time": 4308.47, "timestamp": "01:11:48", "text": "詐欺に遭わないように、"}, {"type": "subtitle", "time": 4313.03, "timestamp": "01:11:53", "text": "美味しいものを食べよう。はい。そして私はあなたを遣わします"}, {"type": "subtitle", "time": 4314.189, "timestamp": "01:11:54", "text": "食べ物"}, {"type": "subtitle", "time": 4317.91, "timestamp": "01:11:57", "text": "写真が私に、彼女が好きになるように言った"}]
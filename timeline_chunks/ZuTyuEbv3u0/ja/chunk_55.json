[{"type": "subtitle", "time": 3302.39, "timestamp": "00:55:02", "text": "たぶん私はまだ学び中です"}, {"type": "subtitle", "time": 3304.309, "timestamp": "00:55:04", "text": "チェックメイト。だから、ご存知のように、私たちは"}, {"type": "subtitle", "time": 3306.87, "timestamp": "00:55:06", "text": "もう少し続く予定です"}, {"type": "subtitle", "time": 3310.549, "timestamp": "00:55:10", "text": "推測。うん。私はあちこち歩き回るつもりです"}, {"type": "subtitle", "time": 3314.829, "timestamp": "00:55:14", "text": "地図全体。だから心配しないでください。"}, {"type": "subtitle", "time": 3320.069, "timestamp": "00:55:20", "text": "本当に回転している。あなたは節約するでしょう"}, {"type": "subtitle", "time": 3323.549, "timestamp": "00:55:23", "text": "最終ラウンドで。それだけですか？"}, {"type": "subtitle", "time": 3326.349, "timestamp": "00:55:26", "text": "うん。こんにちは、"}, {"type": "subtitle", "time": 3331.19, "timestamp": "00:55:31", "text": "彼氏。くそ。えっと、"}, {"type": "subtitle", "time": 3335.43, "timestamp": "00:55:35", "text": "私にはあまりできることはないでしょう？"}, {"type": "subtitle", "time": 3337.39, "timestamp": "00:55:37", "text": "ああ、君の"}, {"type": "subtitle", "time": 3342.309, "timestamp": "00:55:42", "text": "兵士たちが一人ずつ。何てことだ。 1つずつ"}]
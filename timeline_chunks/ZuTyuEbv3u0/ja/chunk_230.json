[{"type": "subtitle", "time": 13800.63, "timestamp": "03:50:00", "text": "31日、私は「えーと」と思ったのですが、その後あなたはこう言いました"}, {"type": "subtitle", "time": 13803.269, "timestamp": "03:50:03", "text": "7月か"}, {"type": "subtitle", "time": 13807.349, "timestamp": "03:50:07", "text": "何か。うん。うん。それで、あなたは送りましたか？"}, {"type": "subtitle", "time": 13810.229, "timestamp": "03:50:10", "text": "7月やこの日のために"}, {"type": "subtitle", "time": 13812.63, "timestamp": "03:50:12", "text": "先週？"}, {"type": "subtitle", "time": 13816.229, "timestamp": "03:50:16", "text": "6月頃だと思います。ああ、6月はいい月だ。うん、"}, {"type": "subtitle", "time": 13817.83, "timestamp": "03:50:17", "text": "6月。"}, {"type": "subtitle", "time": 13820.07, "timestamp": "03:50:20", "text": "ええ、それらの日付はそれらの日付は"}, {"type": "subtitle", "time": 13821.99, "timestamp": "03:50:21", "text": "6月にはそうだったけど、そう、私は"}, {"type": "subtitle", "time": 13826.79, "timestamp": "03:50:26", "text": "今日と明日はちょっと無料です。"}, {"type": "subtitle", "time": 13829.15, "timestamp": "03:50:29", "text": "ええ、手に入れることができてよかったです"}, {"type": "subtitle", "time": 13832.95, "timestamp": "03:50:32", "text": "あなた。私はとても悲しいと思う"}, {"type": "subtitle", "time": 13837.269, "timestamp": "03:50:37", "text": "いや、DSGは手に入らなかったんだ。"}, {"type": "subtitle", "time": 13839.429, "timestamp": "03:50:39", "text": "いいえ、私はむしろあなたが"}, {"type": "subtitle", "time": 13841.87, "timestamp": "03:50:41", "text": "実際、電話がかかってきたんです。"}, {"type": "subtitle", "time": 13845.03, "timestamp": "03:50:45", "text": "そう、だって私は話したかったし、"}, {"type": "subtitle", "time": 13848.389, "timestamp": "03:50:48", "text": "一緒に遊ぶことはあるけど、もうずいぶん長い間ない。"}, {"type": "subtitle", "time": 13852.63, "timestamp": "03:50:52", "text": "最近はよく近況報告をしています。私は嬉しい"}, {"type": "subtitle", "time": 13855.11, "timestamp": "03:50:55", "text": "また雨が降ってきた。"}, {"type": "subtitle", "time": 13856.95, "timestamp": "03:50:56", "text": "つまり、ここはずっと雨が降っていて、"}, {"type": "subtitle", "time": 13858.55, "timestamp": "03:50:58", "text": "兄弟。えっと、今朝私たちは"}]
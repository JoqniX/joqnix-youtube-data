[{"type": "subtitle", "time": 3364.99, "timestamp": "00:56:04", "text": "よし、これで大丈夫だと思う。"}, {"type": "subtitle", "time": 3368.47, "timestamp": "00:56:08", "text": "はい。ああ、サンタさん、近すぎますよ。近すぎる。"}, {"type": "subtitle", "time": 3369.71, "timestamp": "00:56:09", "text": "いいえ、いいえ、"}, {"type": "subtitle", "time": 3372.589, "timestamp": "00:56:12", "text": "いいえ。あのね？持続する。持続する。私"}, {"type": "subtitle", "time": 3379.27, "timestamp": "00:56:19", "text": "これ？待てよ、なんであんなことしたんだろう？何？なぜ"}, {"type": "subtitle", "time": 3380.95, "timestamp": "00:56:20", "text": "私がそんなことしたの？誰か理由を教えてくれませんか"}, {"type": "subtitle", "time": 3384.069, "timestamp": "00:56:24", "text": "私がそんなことしたの？わからない。私は耐えられない"}, {"type": "subtitle", "time": 3385.71, "timestamp": "00:56:25", "text": "あなたのもの"}, {"type": "subtitle", "time": 3387.95, "timestamp": "00:56:27", "text": "下。受け取れない"}, {"type": "subtitle", "time": 3391.349, "timestamp": "00:56:31", "text": "それ。なぜ私はあなたを全滅させることができないのか"}, {"type": "subtitle", "time": 3393.71, "timestamp": "00:56:33", "text": "海？あなた"}, {"type": "subtitle", "time": 3397.67, "timestamp": "00:56:37", "text": "なぜなら、私のルークが見ているから"}, {"type": "subtitle", "time": 3400.23, "timestamp": "00:56:40", "text": "私の騎士よ。だからあなたはできないのです"}, {"type": "subtitle", "time": 3414.109, "timestamp": "00:56:54", "text": "ブーム。これらの人たちは"}, {"type": "subtitle", "time": 3416.95, "timestamp": "00:56:56", "text": "使い物にならない。貯金に戻らなければならない、"}]
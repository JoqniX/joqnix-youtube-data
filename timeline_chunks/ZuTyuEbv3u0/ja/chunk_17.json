[{"type": "subtitle", "time": 1020.03, "timestamp": "00:17:00", "text": "ゾンビ。その"}, {"type": "subtitle", "time": 1023.03, "timestamp": "00:17:03", "text": "大丈夫。よし、キルを確認して戦利品を回収する。"}, {"type": "subtitle", "time": 1025.909, "timestamp": "00:17:05", "text": "キルを確認してから、アイテムを回収する。ともかく、"}, {"type": "subtitle", "time": 1029.789, "timestamp": "00:17:09", "text": "私はどうすればいいのでしょうか？ああ、そうだね。クリック"}, {"type": "subtitle", "time": 1032.309, "timestamp": "00:17:12", "text": "マッチング。ゲームを探す。それは違う"}, {"type": "subtitle", "time": 1036.35, "timestamp": "00:17:16", "text": "右。ちょっと待ってください。わかった。ああ、わかった。"}, {"type": "subtitle", "time": 1040.069, "timestamp": "00:17:20", "text": "ジャック、ジャックを選択、"}, {"type": "subtitle", "time": 1042.47, "timestamp": "00:17:22", "text": "あなたがプレイしようとしているゲーム。わかった。どこかに行って。私"}, {"type": "subtitle", "time": 1044.549, "timestamp": "00:17:24", "text": "彼には加わりたくない。私は彼に"}, {"type": "subtitle", "time": 1047.51, "timestamp": "00:17:27", "text": "私と一緒に来てください。一体何なんだ？ない"}, {"type": "subtitle", "time": 1050.669, "timestamp": "00:17:30", "text": "招待すること。行く。わかった。あのね？"}, {"type": "subtitle", "time": 1052.71, "timestamp": "00:17:32", "text": "マッチング。すぐに参加できます。私はほしくない"}, {"type": "subtitle", "time": 1055.029, "timestamp": "00:17:35", "text": "これ。ゲームを探す。私はこれを望んでいない"}, {"type": "subtitle", "time": 1056.87, "timestamp": "00:17:36", "text": "どちらか。一体何なんだ、この奇形は？待って。する"}, {"type": "subtitle", "time": 1061.029, "timestamp": "00:17:41", "text": "これ。これをやってください。セクションを公開設定にしてください。"}, {"type": "subtitle", "time": 1063.669, "timestamp": "00:17:43", "text": "えっと、でも友達限定なんです。うん。うん。"}, {"type": "subtitle", "time": 1066.31, "timestamp": "00:17:46", "text": "とりあえず公開しておこう。そうすれば私は"}, {"type": "subtitle", "time": 1068.95, "timestamp": "00:17:48", "text": "プライベート設定に戻して、友達のみに公開する。"}, {"type": "subtitle", "time": 1071.59, "timestamp": "00:17:51", "text": "公表してください。探してみます"}, {"type": "subtitle", "time": 1079.43, "timestamp": "00:17:59", "text": "ああ、私はそれを公表した。"}]
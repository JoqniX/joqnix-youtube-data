[{"type": "subtitle", "time": 3423.43, "timestamp": "00:57:03", "text": "よし。わかった。何かをしなくてはならない"}, {"type": "subtitle", "time": 3427.43, "timestamp": "00:57:07", "text": "なぜなら、私には十分な時間がないからです。"}, {"type": "subtitle", "time": 3437.91, "timestamp": "00:57:17", "text": "何？引き分けになった。"}, {"type": "subtitle", "time": 3439.829, "timestamp": "00:57:19", "text": "大丈夫。"}, {"type": "subtitle", "time": 3442.39, "timestamp": "00:57:22", "text": "くそ。ニース。それは良い。それは良い"}, {"type": "subtitle", "time": 3445.789, "timestamp": "00:57:25", "text": "結論。おお。それは素晴らしい"}, {"type": "subtitle", "time": 3448.23, "timestamp": "00:57:28", "text": "結論として、"}, {"type": "subtitle", "time": 3452.15, "timestamp": "00:57:32", "text": "チェックメイトの方法を知っている。それは素晴らしい"}, {"type": "subtitle", "time": 3453.829, "timestamp": "00:57:33", "text": "結論。"}, {"type": "subtitle", "time": 3457.99, "timestamp": "00:57:37", "text": "うん。ああ、なんてことだ。今日の調子はどうですか？おお"}, {"type": "subtitle", "time": 3460.789, "timestamp": "00:57:40", "text": "閣下。こんにちは。"}, {"type": "subtitle", "time": 3462.99, "timestamp": "00:57:42", "text": "あなたはあなたの"}, {"type": "subtitle", "time": 3467.349, "timestamp": "00:57:47", "text": "やっと会えた。こんにちは、Arxarさん。"}, {"type": "subtitle", "time": 3469.349, "timestamp": "00:57:49", "text": "ああ、本当に久しぶりだ。元気ですか"}, {"type": "subtitle", "time": 3476.39, "timestamp": "00:57:56", "text": "アレックスは「ああ、どうぞ」と言っていた。あなた"}, {"type": "subtitle", "time": 3479.51, "timestamp": "00:57:59", "text": "それを言う。何かをクリックして"}]
[{"type": "subtitle", "time": 3122.23, "timestamp": "00:52:02", "text": "私に何ができるか見てみましょう。わかった。"}, {"type": "subtitle", "time": 3127.109, "timestamp": "00:52:07", "text": "よし。わかった。つまり、あなたはそれをやっているのですね"}, {"type": "subtitle", "time": 3133.069, "timestamp": "00:52:13", "text": "我々は出来た"}, {"type": "subtitle", "time": 3144.51, "timestamp": "00:52:24", "text": "私はそこへは行けません。私は行けません"}, {"type": "subtitle", "time": 3155.75, "timestamp": "00:52:35", "text": "くそ。まるで私が夜を救えたかのように、"}]
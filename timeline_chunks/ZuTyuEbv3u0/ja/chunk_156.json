[{"type": "subtitle", "time": 9375.51, "timestamp": "02:36:15", "text": "うん。今はただ自分の"}, {"type": "subtitle", "time": 9383.79, "timestamp": "02:36:23", "text": "1つ。"}, {"type": "subtitle", "time": 9393.23, "timestamp": "02:36:33", "text": "男。ああ、聞きたかったんだけど"}, {"type": "subtitle", "time": 9396.07, "timestamp": "02:36:36", "text": "チューブ遊びを楽しんでいますか？"}, {"type": "subtitle", "time": 9403.51, "timestamp": "02:36:43", "text": "えっと、ずっと聞きたかったんだけど、"}, {"type": "subtitle", "time": 9406.71, "timestamp": "02:36:46", "text": "チューブ遊びとか、いろいろ楽しんでる？"}, {"type": "subtitle", "time": 9408.55, "timestamp": "02:36:48", "text": "うん、今楽しんでるよ"}, {"type": "subtitle", "time": 9410.95, "timestamp": "02:36:50", "text": "私の配信に私のフォロワーが出演しています"}, {"type": "subtitle", "time": 9413.19, "timestamp": "02:36:53", "text": "会話も好きで、私も好きです"}, {"type": "subtitle", "time": 9415.83, "timestamp": "02:36:55", "text": "男たちと会う。私はたくさんの人に会った"}, {"type": "subtitle", "time": 9418.71, "timestamp": "02:36:58", "text": "新しい人は、"}]
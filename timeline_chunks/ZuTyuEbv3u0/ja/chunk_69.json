[{"type": "subtitle", "time": 4142.229, "timestamp": "01:09:02", "text": "うん、えっと、マサラドーシャとか食べたんだけど"}, {"type": "subtitle", "time": 4147.749, "timestamp": "01:09:07", "text": "それは良い。何てことだ。あなたは"}, {"type": "subtitle", "time": 4151.709, "timestamp": "01:09:11", "text": "マサラドーサが食べたくなってきた。"}, {"type": "subtitle", "time": 4156.749, "timestamp": "01:09:16", "text": "今。ああ、あなたの好きな食べ物は何ですか？"}, {"type": "subtitle", "time": 4159.669, "timestamp": "01:09:19", "text": "えっと、今はモモですね。それはある意味"}, {"type": "subtitle", "time": 4163.47, "timestamp": "01:09:23", "text": "以前のような変化が起こらない。"}, {"type": "subtitle", "time": 4176.43, "timestamp": "01:09:36", "text": "ああ、初めて粥を食べた"}, {"type": "subtitle", "time": 4180.309, "timestamp": "01:09:40", "text": "確か去年の今頃だったと思います。それはとても"}, {"type": "subtitle", "time": 4181.59, "timestamp": "01:09:41", "text": "良い。"}, {"type": "subtitle", "time": 4185.829, "timestamp": "01:09:45", "text": "私たちはそうしなければならなかった、それは素晴らしい。素晴らしいですね。うん。"}, {"type": "subtitle", "time": 4188.63, "timestamp": "01:09:48", "text": "ジョークは凝っている。"}, {"type": "subtitle", "time": 4190.789, "timestamp": "01:09:50", "text": "だから、監督の言うことは信じられる。あなたは決して"}, {"type": "subtitle", "time": 4192.789, "timestamp": "01:09:52", "text": "知る。私はおそらく何らかの"}, {"type": "subtitle", "time": 4194.47, "timestamp": "01:09:54", "text": "キャラクター開発、そして今私は"}, {"type": "subtitle", "time": 4197.669, "timestamp": "01:09:57", "text": "信じることを選ぶ。何が起こるかわからない。あなた"}]
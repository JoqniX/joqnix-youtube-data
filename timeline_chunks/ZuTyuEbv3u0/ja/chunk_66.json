[{"type": "subtitle", "time": 3960.23, "timestamp": "01:06:00", "text": "サンタさん、それは私にとってとても大切なことです。はい。そして私は"}, {"type": "subtitle", "time": 3962.95, "timestamp": "01:06:02", "text": "あなたの幸運を祈っています。あなた"}, {"type": "subtitle", "time": 3966.309, "timestamp": "01:06:06", "text": "完全に自分の幸せを見つけることができます。"}, {"type": "subtitle", "time": 3968.47, "timestamp": "01:06:08", "text": "うん。つまり、あなたは"}, {"type": "subtitle", "time": 3971.91, "timestamp": "01:06:11", "text": "みんながシャブシュみたいな​​のを求めて私のところに来た"}, {"type": "subtitle", "time": 3974.069, "timestamp": "01:06:14", "text": "それ以外の場合は適応させる。彼らはすべてを学んだ"}, {"type": "subtitle", "time": 3976.549, "timestamp": "01:06:16", "text": "そして彼らはもう私のことを気にかけなくなった。彼らは"}, {"type": "subtitle", "time": 3979.589, "timestamp": "01:06:19", "text": "私の健康のために行かないでください。だから私はこう思った"}, {"type": "subtitle", "time": 3982.069, "timestamp": "01:06:22", "text": "あなたが私を呼んでくれた時はいつでも喜んでいました。うん。"}, {"type": "subtitle", "time": 3984.63, "timestamp": "01:06:24", "text": "時々私は自分が来たように感じる"}, {"type": "subtitle", "time": 3986.47, "timestamp": "01:06:26", "text": "あなたとただ一緒に過ごせるように"}, {"type": "subtitle", "time": 3989.349, "timestamp": "01:06:29", "text": "若干。まるで私が"}, {"type": "subtitle", "time": 3992.23, "timestamp": "01:06:32", "text": "「やあ、ちょっと邪魔してもいいかな？」"}, {"type": "subtitle", "time": 3996.309, "timestamp": "01:06:36", "text": "ちょっと、ほら、本当にバカバカしいやつ"}, {"type": "subtitle", "time": 3998.95, "timestamp": "01:06:38", "text": "「だって、やってみてもいいじゃない？」だから、うん、やってみたよ。"}, {"type": "subtitle", "time": 4000.95, "timestamp": "01:06:40", "text": "私はこう言うだろう、「サンタさん、"}, {"type": "subtitle", "time": 4002.63, "timestamp": "01:06:42", "text": "「忙しい？」だって私はこんな風だから"}, {"type": "subtitle", "time": 4004.23, "timestamp": "01:06:44", "text": "私のバレリーナットに問題があります。私はこう思う、"}, {"type": "subtitle", "time": 4005.549, "timestamp": "01:06:45", "text": "\"わかった、"}, {"type": "subtitle", "time": 4008.39, "timestamp": "01:06:48", "text": "ヴァレラント、じゃあね。"}, {"type": "subtitle", "time": 4011.75, "timestamp": "01:06:51", "text": "そう、それは私にとってとても意味のあることで、"}, {"type": "subtitle", "time": 4013.67, "timestamp": "01:06:53", "text": "すばらしい。"}, {"type": "subtitle", "time": 4014.91, "timestamp": "01:06:54", "text": "[音楽]"}, {"type": "subtitle", "time": 4016.75, "timestamp": "01:06:56", "text": "うん。"}]
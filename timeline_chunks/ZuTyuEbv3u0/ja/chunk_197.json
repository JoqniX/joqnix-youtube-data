[{"type": "subtitle", "time": 11823.349, "timestamp": "03:17:03", "text": "ああ、それはすごいことだろうね。でもそうですね、"}, {"type": "subtitle", "time": 11825.83, "timestamp": "03:17:05", "text": "うん。だから最初はこう思った"}, {"type": "subtitle", "time": 11828.07, "timestamp": "03:17:08", "text": "私のより高いレベルを続けることができます"}, {"type": "subtitle", "time": 11831.03, "timestamp": "03:17:11", "text": "現在の学業を終えた直後に修士課程に進学します。"}, {"type": "subtitle", "time": 11834.15, "timestamp": "03:17:14", "text": "UG"}, {"type": "subtitle", "time": 11836.389, "timestamp": "03:17:16", "text": "でも、でも、私は確かに必要としている"}, {"type": "subtitle", "time": 11838.15, "timestamp": "03:17:18", "text": "新しい若者の。それで、私は"}, {"type": "subtitle", "time": 11840.469, "timestamp": "03:17:20", "text": "仕事に行くだけです"}, {"type": "subtitle", "time": 11842.389, "timestamp": "03:17:22", "text": "年。"}, {"type": "subtitle", "time": 11844.71, "timestamp": "03:17:24", "text": "ああ、パートタイムで。"}, {"type": "subtitle", "time": 11847.59, "timestamp": "03:17:27", "text": "会社員のようなフルタイム勤務ではありません。おお、いいね"}, {"type": "subtitle", "time": 11849.75, "timestamp": "03:17:29", "text": "いいね、いいね。ええ、勉強しています"}, {"type": "subtitle", "time": 11856.95, "timestamp": "03:17:36", "text": "おお、いいね。"}, {"type": "subtitle", "time": 11858.71, "timestamp": "03:17:38", "text": "うん、たぶん1つか2つくらいの仕事かな"}, {"type": "subtitle", "time": 11860.95, "timestamp": "03:17:40", "text": "2年間で十分なお金を手に入れる"}, {"type": "subtitle", "time": 11863.83, "timestamp": "03:17:43", "text": "新しいノートパソコンを購入し、"}, {"type": "subtitle", "time": 11871.99, "timestamp": "03:17:51", "text": "私の州でやるか、おそらく行く"}, {"type": "subtitle", "time": 11879.91, "timestamp": "03:17:59", "text": "うん、それはいいことだろうね。いいえ、"}]
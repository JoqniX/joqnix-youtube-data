[{"type": "subtitle", "time": 3780.39, "timestamp": "01:03:00", "text": "私はもうそうだと思います。ああ、あなたは大丈夫です。"}, {"type": "subtitle", "time": 3783.99, "timestamp": "01:03:03", "text": "待って、私はできなかった"}, {"type": "subtitle", "time": 3788.069, "timestamp": "01:03:08", "text": "私の誕生日みたいにお祝いして。私"}, {"type": "subtitle", "time": 3790.39, "timestamp": "01:03:10", "text": "4周年を祝うことができなかった"}, {"type": "subtitle", "time": 3792.63, "timestamp": "01:03:12", "text": "周年。"}, {"type": "subtitle", "time": 3796.309, "timestamp": "01:03:16", "text": "待って。うん。うん。それは何ですか？ 5月、6月。"}, {"type": "subtitle", "time": 3798.71, "timestamp": "01:03:18", "text": "ええ、6月ですよね？うん。待って、"}, {"type": "subtitle", "time": 3801.91, "timestamp": "01:03:21", "text": "6月になるのかな？"}, {"type": "subtitle", "time": 3804.309, "timestamp": "01:03:24", "text": "だから、時間があるかどうかわからない"}, {"type": "subtitle", "time": 3808.19, "timestamp": "01:03:28", "text": "その日にそれを行うこと。"}, {"type": "subtitle", "time": 3811.829, "timestamp": "01:03:31", "text": "だから、私は損をしていたし、"}, {"type": "subtitle", "time": 3814.39, "timestamp": "01:03:34", "text": "それら全てからものすごくFOMOを感じています。"}, {"type": "subtitle", "time": 3817.67, "timestamp": "01:03:37", "text": "でも大丈夫。"}, {"type": "subtitle", "time": 3819.99, "timestamp": "01:03:39", "text": "まあ、そうですね。あなたは"}, {"type": "subtitle", "time": 3822.309, "timestamp": "01:03:42", "text": "チューブ遊びとか、全部楽しんでる？どうですか"}, {"type": "subtitle", "time": 3825.029, "timestamp": "01:03:45", "text": "全てが順調に進んでいる？楽しんでいますか"}, {"type": "subtitle", "time": 3826.75, "timestamp": "01:03:46", "text": "これ？"}, {"type": "subtitle", "time": 3832.19, "timestamp": "01:03:52", "text": "そう、チューブみたいなやつ"}, {"type": "subtitle", "time": 3835.91, "timestamp": "01:03:55", "text": "最大の祝福の一つは"}, {"type": "subtitle", "time": 3837.67, "timestamp": "01:03:57", "text": "私の人生。"}]
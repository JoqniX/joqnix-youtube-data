[{"type": "subtitle", "time": 10020.63, "timestamp": "02:47:00", "text": "その瞬間、私はそれが"}, {"type": "subtitle", "time": 10025.269, "timestamp": "02:47:05", "text": "後で連絡した方がいいかな"}, {"type": "subtitle", "time": 10028.87, "timestamp": "02:47:08", "text": "十分な量が揃ったら。私は日本にいます"}, {"type": "subtitle", "time": 10032.389, "timestamp": "02:47:12", "text": "7月から。だから私は一生懸命働いて、それから"}, {"type": "subtitle", "time": 10034.55, "timestamp": "02:47:14", "text": "また戻ってきてください。皆さんが"}, {"type": "subtitle", "time": 10037.99, "timestamp": "02:47:17", "text": "私を受け入れて、再び依頼を受けてください。"}, {"type": "subtitle", "time": 10041.11, "timestamp": "02:47:21", "text": "ええ、つまり"}, {"type": "subtitle", "time": 10045.83, "timestamp": "02:47:25", "text": "ママと"}, {"type": "subtitle", "time": 10047.83, "timestamp": "02:47:27", "text": "パパは「ああ、私は欲しくない」って感じ"}, {"type": "subtitle", "time": 10050.23, "timestamp": "02:47:30", "text": "あなたの手数料を受け取るため。私はしたくない"}, {"type": "subtitle", "time": 10053.349, "timestamp": "02:47:33", "text": "「これに取り組んでください」と言って、彼らは私を見捨てた。"}, {"type": "subtitle", "time": 10056.23, "timestamp": "02:47:36", "text": "それは最悪の悪夢になるだろう。いいえ、"}, {"type": "subtitle", "time": 10059.51, "timestamp": "02:47:39", "text": "そんなことは起こらない。うん。私はそれを望んでいない"}, {"type": "subtitle", "time": 10062.51, "timestamp": "02:47:42", "text": "起こる。"}, {"type": "subtitle", "time": 10065.78, "timestamp": "02:47:45", "text": "うん。確認する必要がある"}, {"type": "subtitle", "time": 10072.87, "timestamp": "02:47:52", "text": "ええ、最初は見せる予定だったんです"}, {"type": "subtitle", "time": 10075.51, "timestamp": "02:47:55", "text": "漏れているような、漏れていないようなデザイン"}, {"type": "subtitle", "time": 10079.269, "timestamp": "02:47:59", "text": "それは、少しずつですが"}]
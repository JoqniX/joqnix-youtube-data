[{"type": "subtitle", "time": 3840.63, "timestamp": "01:04:00", "text": "繋がることができてとても幸せです"}, {"type": "subtitle", "time": 3843.19, "timestamp": "01:04:03", "text": "たくさんの人が"}, {"type": "subtitle", "time": 3846.309, "timestamp": "01:04:06", "text": "人々と話したり、楽しませたりすること"}, {"type": "subtitle", "time": 3848.23, "timestamp": "01:04:08", "text": "人々。それはいつも大きな"}, {"type": "subtitle", "time": 3850.95, "timestamp": "01:04:10", "text": "私の一部だと思う。そして全編を通して"}, {"type": "subtitle", "time": 3852.789, "timestamp": "01:04:12", "text": "この数年間、私は本当に感謝しています。"}, {"type": "subtitle", "time": 3854.549, "timestamp": "01:04:14", "text": "ほら、君がそこにいるときとか"}, {"type": "subtitle", "time": 3856.789, "timestamp": "01:04:16", "text": "そして人々は絶えずチェックしている"}, {"type": "subtitle", "time": 3860.63, "timestamp": "01:04:20", "text": "あなたに近づいてきて、あなたを見るのが大好きです。"}, {"type": "subtitle", "time": 3863.51, "timestamp": "01:04:23", "text": "あなたのコンテンツが好きになりたい"}, {"type": "subtitle", "time": 3866.069, "timestamp": "01:04:26", "text": "好きなことに参加してください"}, {"type": "subtitle", "time": 3868.23, "timestamp": "01:04:28", "text": "あなたのストリーム。彼らは、ほら、"}, {"type": "subtitle", "time": 3872.069, "timestamp": "01:04:32", "text": "私と一緒にバレエをしよう。"}, {"type": "subtitle", "time": 3874.39, "timestamp": "01:04:34", "text": "それは私にとってとても大切なことなんです。"}, {"type": "subtitle", "time": 3877.27, "timestamp": "01:04:37", "text": "のように"}, {"type": "subtitle", "time": 3881.19, "timestamp": "01:04:41", "text": "それは、それは、私はそれが恋しい。とても恋しいです。"}, {"type": "subtitle", "time": 3883.67, "timestamp": "01:04:43", "text": "それだけは言っておきます。そして私はそれが大好きです"}, {"type": "subtitle", "time": 3886.67, "timestamp": "01:04:46", "text": "これ。 VTubingの一員になれて嬉しいです"}, {"type": "subtitle", "time": 3889.51, "timestamp": "01:04:49", "text": "業界。とてもとても幸せです"}, {"type": "subtitle", "time": 3893.43, "timestamp": "01:04:53", "text": "そして、私を特別な気分にさせてくれる。そうですね、私は"}, {"type": "subtitle", "time": 3896.23, "timestamp": "01:04:56", "text": "初めてここに来た時のことを覚えていますか"}, {"type": "subtitle", "time": 3898.19, "timestamp": "01:04:58", "text": "ストリーミングでは、"}]
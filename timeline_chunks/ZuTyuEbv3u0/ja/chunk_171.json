[{"type": "subtitle", "time": 10260.429, "timestamp": "02:51:00", "text": "10年ではなく、5年間"}, {"type": "subtitle", "time": 10263.51, "timestamp": "02:51:03", "text": "少しでも。それはかなり長い時間になるでしょう。今から"}, {"type": "subtitle", "time": 10267.59, "timestamp": "02:51:07", "text": "そうすれば、楽しめるかどうか、楽しめないかどうかがわかる"}, {"type": "subtitle", "time": 10271.99, "timestamp": "02:51:11", "text": "えっと、うまくいくかどうか見てみよう"}, {"type": "subtitle", "time": 10274.71, "timestamp": "02:51:14", "text": "そしてアップグレードするのに十分なもの"}, {"type": "subtitle", "time": 10278.63, "timestamp": "02:51:18", "text": "何か。いいえ、それが狙いでした。"}, {"type": "subtitle", "time": 10281.429, "timestamp": "02:51:21", "text": "私はあのことであなたをからかっただろうか"}, {"type": "subtitle", "time": 10301.83, "timestamp": "02:51:41", "text": "知っている。"}, {"type": "subtitle", "time": 10304.07, "timestamp": "02:51:44", "text": "ああ、そうだね。今あなた"}, {"type": "subtitle", "time": 10305.51, "timestamp": "02:51:45", "text": "そうそう。おそらく"}, {"type": "subtitle", "time": 10308.63, "timestamp": "02:51:48", "text": "範囲。そうそう。大丈夫。そう、だから"}, {"type": "subtitle", "time": 10310.07, "timestamp": "02:51:50", "text": "ええ、私が聞いていたのは、あなたが"}]
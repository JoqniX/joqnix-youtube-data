[{"type": "subtitle", "time": 4320.149, "timestamp": "01:12:00", "text": "彼女は写真を撮るのが好きだと話した"}, {"type": "subtitle", "time": 4322.709, "timestamp": "01:12:02", "text": "彼女は今、食べたりしている。では、私は"}, {"type": "subtitle", "time": 4326.55, "timestamp": "01:12:06", "text": "食べる前に写真を撮って送ってください。"}, {"type": "subtitle", "time": 4334.149, "timestamp": "01:12:14", "text": "こんにちは、ジョヤ。本日はありがとうございました。楽しかった"}, {"type": "subtitle", "time": 4336.709, "timestamp": "01:12:16", "text": "君と一緒に過ごしたい。"}, {"type": "subtitle", "time": 4339.669, "timestamp": "01:12:19", "text": "お忙しいのは承知していますが、ぜひお願いします。"}, {"type": "subtitle", "time": 4343.11, "timestamp": "01:12:23", "text": "体調に気をつけて、ゆっくり休んでください。わかった、"}, {"type": "subtitle", "time": 4346.95, "timestamp": "01:12:26", "text": "もうお疲れでしょう。ええ、実は"}, {"type": "subtitle", "time": 4350.149, "timestamp": "01:12:30", "text": "行かなきゃいけないし、えっと、ほら、えっと"}, {"type": "subtitle", "time": 4352.07, "timestamp": "01:12:32", "text": "今すぐ課題を終わらせてください。私"}, {"type": "subtitle", "time": 4354.87, "timestamp": "01:12:34", "text": "4つの科目がある"}, {"type": "subtitle", "time": 4356.63, "timestamp": "01:12:36", "text": "のみ。"}, {"type": "subtitle", "time": 4360.39, "timestamp": "01:12:40", "text": "4つを完了するために1日あります"}, {"type": "subtitle", "time": 4364.39, "timestamp": "01:12:44", "text": "課題の主題。もうダメだ。"}, {"type": "subtitle", "time": 4367.11, "timestamp": "01:12:47", "text": "私は、私のせいで、私のせいで"}, {"type": "subtitle", "time": 4369.27, "timestamp": "01:12:49", "text": "チャットをやっていた時、私は「注文するだけ」と思った。"}, {"type": "subtitle", "time": 4371.83, "timestamp": "01:12:51", "text": "私は自分の課題をこなしました。誰か"}, {"type": "subtitle", "time": 4375.35, "timestamp": "01:12:55", "text": "他の人が私のために書いてくれたんです。ああ、なんてことだ。あなた"}, {"type": "subtitle", "time": 4376.79, "timestamp": "01:12:56", "text": "わかってる、私にはそんな勇気はないんだ。"}, {"type": "subtitle", "time": 4379.43, "timestamp": "01:12:59", "text": "それに、ほら、私は"}]
[{"type": "subtitle", "time": 241.83, "timestamp": "00:04:01", "text": "何？そうそう。イエス。友達限定。"}, {"type": "subtitle", "time": 244.67, "timestamp": "00:04:04", "text": "うん。わかった。わかった。友達"}, {"type": "subtitle", "time": 248.27, "timestamp": "00:04:08", "text": "のみ。参加する。参加する"}, {"type": "subtitle", "time": 250.149, "timestamp": "00:04:10", "text": "ゲーム。うん。うん。うん。うん。大丈夫です。"}, {"type": "subtitle", "time": 252.789, "timestamp": "00:04:12", "text": "大丈夫です。参加します。先生、私も同行します。"}, {"type": "subtitle", "time": 254.55, "timestamp": "00:04:14", "text": "待って。実際、私は"}, {"type": "subtitle", "time": 257.509, "timestamp": "00:04:17", "text": "アリーナ。さあ、急いで戻らなきゃ。"}, {"type": "subtitle", "time": 261.189, "timestamp": "00:04:21", "text": "ちょっと待てよ。参加する。参加する。参加します。私 私 私"}, {"type": "subtitle", "time": 263.11, "timestamp": "00:04:23", "text": "死んでも構わない"}, {"type": "subtitle", "time": 264.79, "timestamp": "00:04:24", "text": "2番。"}, {"type": "subtitle", "time": 267.99, "timestamp": "00:04:27", "text": "なんてこった。ゲーム中に発作を起こしました。おお"}, {"type": "subtitle", "time": 275.59000000000003, "timestamp": "00:04:35", "text": "本当に死ぬ。待って。ああ、待って、あなたは"}, {"type": "subtitle", "time": 278.79, "timestamp": "00:04:38", "text": "セクション。え、何？"}, {"type": "subtitle", "time": 280.469, "timestamp": "00:04:40", "text": "私は反対側のコインを見たことがある。私"}, {"type": "subtitle", "time": 281.629, "timestamp": "00:04:41", "text": "プレイしていた"}, {"type": "subtitle", "time": 288.07, "timestamp": "00:04:48", "text": "H. よし、電源を入れよう。やらせてください、私は"}, {"type": "subtitle", "time": 290.23, "timestamp": "00:04:50", "text": "私のアップグレード。"}, {"type": "subtitle", "time": 291.749, "timestamp": "00:04:51", "text": "あなたは一人でプレイしています。難しさは"}, {"type": "subtitle", "time": 293.07, "timestamp": "00:04:53", "text": "種類が一致しません"}, {"type": "subtitle", "time": 296.55, "timestamp": "00:04:56", "text": "あなたのメイン。一体何なんだ？はい、できます"}]
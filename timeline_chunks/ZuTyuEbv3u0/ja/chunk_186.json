[{"type": "subtitle", "time": 11160.87, "timestamp": "03:06:00", "text": "それは生き残るために必須であり、"}, {"type": "subtitle", "time": 11162.469, "timestamp": "03:06:02", "text": "食費とかその他諸々の費用を稼ぐんだ。"}, {"type": "subtitle", "time": 11163.469, "timestamp": "03:06:03", "text": "右。"}, {"type": "subtitle", "time": 11167.51, "timestamp": "03:06:07", "text": "えっと、おそらく授業は"}, {"type": "subtitle", "time": 11170.67, "timestamp": "03:06:10", "text": "午前から午後にかけて2時か3時か"}, {"type": "subtitle", "time": 11173.269, "timestamp": "03:06:13", "text": "通常の学校時間のようなもの、または"}, {"type": "subtitle", "time": 11176.95, "timestamp": "03:06:16", "text": "たぶん午後の12時頃までかな"}, {"type": "subtitle", "time": 11179.67, "timestamp": "03:06:19", "text": "あるいは、そんな感じ。"}, {"type": "subtitle", "time": 11181.51, "timestamp": "03:06:21", "text": "ここの学校は学校の時間なので"}, {"type": "subtitle", "time": 11184.63, "timestamp": "03:06:24", "text": "授業は午後5時までです。あるいは6"}, {"type": "subtitle", "time": 11186.95, "timestamp": "03:06:26", "text": "午後あなたは特別授業を受けるべきです。"}, {"type": "subtitle", "time": 11190.63, "timestamp": "03:06:30", "text": "ああ、それもそうだね。はい。はい。えっと、私は"}, {"type": "subtitle", "time": 11193.269, "timestamp": "03:06:33", "text": "授業が終わったら私は"}, {"type": "subtitle", "time": 11197.03, "timestamp": "03:06:37", "text": "今は少し自由か、少なくとも私は"}, {"type": "subtitle", "time": 11198.87, "timestamp": "03:06:38", "text": "そこから私は"}, {"type": "subtitle", "time": 11200.95, "timestamp": "03:06:40", "text": "面接を受けて複数の"}, {"type": "subtitle", "time": 11203.429, "timestamp": "03:06:43", "text": "パートタイムの仕事だけど、たとえ私が"}, {"type": "subtitle", "time": 11206.389, "timestamp": "03:06:46", "text": "複数のパートタイムの仕事、例えば"}, {"type": "subtitle", "time": 11210.71, "timestamp": "03:06:50", "text": "インドではパートタイムはフルタイムみたいなものですよね？"}, {"type": "subtitle", "time": 11211.95, "timestamp": "03:06:51", "text": "つまり、そうではないということだ"}, {"type": "subtitle", "time": 11214.389, "timestamp": "03:06:54", "text": "まさにここでパートタイムの仕事ができるが"}, {"type": "subtitle", "time": 11216.71, "timestamp": "03:06:56", "text": "パートタイムにはないと思います。"}, {"type": "subtitle", "time": 11219.269, "timestamp": "03:06:59", "text": "それで十分なお金が手に入ると思います"}]
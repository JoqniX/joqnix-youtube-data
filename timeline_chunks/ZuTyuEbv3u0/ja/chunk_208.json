[{"type": "subtitle", "time": 12482.07, "timestamp": "03:28:02", "text": "何？名前は何でしたか？何てことだ。"}, {"type": "subtitle", "time": 12484.95, "timestamp": "03:28:04", "text": "アズラ・ラピス。彼女のことを覚えていますか？の"}, {"type": "subtitle", "time": 12487.07, "timestamp": "03:28:07", "text": "青"}, {"type": "subtitle", "time": 12489.75, "timestamp": "03:28:09", "text": "サギ。ええ、わかっています。うん。うん。うん。"}, {"type": "subtitle", "time": 12491.83, "timestamp": "03:28:11", "text": "彼女とはどう話していますか？どうやって"}, {"type": "subtitle", "time": 12494.11, "timestamp": "03:28:14", "text": "彼女はそうなのか？久しぶりな感じ。私はただ"}, {"type": "subtitle", "time": 12497.03, "timestamp": "03:28:17", "text": "突然思い出した。あの青"}, {"type": "subtitle", "time": 12498.71, "timestamp": "03:28:18", "text": "髪。"}, {"type": "subtitle", "time": 12501.309, "timestamp": "03:28:21", "text": "彼女は突然姿を消した。"}, {"type": "subtitle", "time": 12505.03, "timestamp": "03:28:25", "text": "何？彼女は配信をしない。"}, {"type": "subtitle", "time": 12507.469, "timestamp": "03:28:27", "text": "うん。つまり、私はかなり"}, {"type": "subtitle", "time": 12509.67, "timestamp": "03:28:29", "text": "もちろん。うん、彼女は"}, {"type": "subtitle", "time": 12511.99, "timestamp": "03:28:31", "text": "違う。あ、待って。はい、ちょっと確認させてください"}, {"type": "subtitle", "time": 12515.75, "timestamp": "03:28:35", "text": "彼女の不和。ああ、彼女は、えっと、"}, {"type": "subtitle", "time": 12524.71, "timestamp": "03:28:44", "text": "ああ、くそ。彼女は生きているし、ああ、"}, {"type": "subtitle", "time": 12527.469, "timestamp": "03:28:47", "text": "神様、どうして「ああ、なんて」って言ったの？"}, {"type": "subtitle", "time": 12531.11, "timestamp": "03:28:51", "text": "神。ごめんなさい。いいえ、飛びつかないでください"}, {"type": "subtitle", "time": 12532.55, "timestamp": "03:28:52", "text": "全員が死んでしまったという結論"}, {"type": "subtitle", "time": 12534.15, "timestamp": "03:28:54", "text": "そうでないからといって、"}, {"type": "subtitle", "time": 12536.469, "timestamp": "03:28:56", "text": "ストリーミング配信。わかった。うん。うん、それはまずいね。"}, {"type": "subtitle", "time": 12539.349, "timestamp": "03:28:59", "text": "はい。人は皆、人生を持っている。"}]
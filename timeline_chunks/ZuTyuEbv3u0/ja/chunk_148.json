[{"type": "subtitle", "time": 8881.03, "timestamp": "02:28:01", "text": "それ。そして、もしそれが"}, {"type": "subtitle", "time": 8883.91, "timestamp": "02:28:03", "text": "長い、いや、Discordはこれらの古いDMを非表示にする"}, {"type": "subtitle", "time": 8885.83, "timestamp": "02:28:05", "text": "などなど。チャットする人が増えれば増えるほど"}, {"type": "subtitle", "time": 8888.55, "timestamp": "02:28:08", "text": "そして、すべてが、とてもひどい。"}, {"type": "subtitle", "time": 8890.63, "timestamp": "02:28:10", "text": "ええ、わかっています。"}, {"type": "subtitle", "time": 8893.03, "timestamp": "02:28:13", "text": "スクロールダウンするのが難しい"}, {"type": "subtitle", "time": 8895.349, "timestamp": "02:28:15", "text": "私が話した人たちが誰だったのか調べる"}, {"type": "subtitle", "time": 8899.27, "timestamp": "02:28:19", "text": "などなど。それで"}, {"type": "subtitle", "time": 8903.99, "timestamp": "02:28:23", "text": "うん、それはちょっと難しいね。"}, {"type": "subtitle", "time": 8905.59, "timestamp": "02:28:25", "text": "うん。"}, {"type": "subtitle", "time": 8907.75, "timestamp": "02:28:27", "text": "ええ、そうですね、私は"}, {"type": "subtitle", "time": 8910.15, "timestamp": "02:28:30", "text": "最近この"}, {"type": "subtitle", "time": 8912.95, "timestamp": "02:28:32", "text": "ストリーミングとか、えっと、"}, {"type": "subtitle", "time": 8914.389, "timestamp": "02:28:34", "text": "これまでのコミュニティの状況は？だって君を見たから"}, {"type": "subtitle", "time": 8917.03, "timestamp": "02:28:37", "text": "このように多くの人々とコラボレーションする"}, {"type": "subtitle", "time": 8921.429, "timestamp": "02:28:41", "text": "このタゴンが始まって以来。"}, {"type": "subtitle", "time": 8925.03, "timestamp": "02:28:45", "text": "ええ、人々とコラボレーションします"}, {"type": "subtitle", "time": 8928.15, "timestamp": "02:28:48", "text": "INVtubers や屋外で"}, {"type": "subtitle", "time": 8930.19, "timestamp": "02:28:50", "text": "みんな"}, {"type": "subtitle", "time": 8931.71, "timestamp": "02:28:51", "text": "ああ"}, {"type": "subtitle", "time": 8935.11, "timestamp": "02:28:55", "text": "最初は、"}, {"type": "subtitle", "time": 8937.67, "timestamp": "02:28:57", "text": "私が話した人々とすべての"}]
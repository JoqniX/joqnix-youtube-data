[{"type": "subtitle", "time": 1500.31, "timestamp": "00:25:00", "text": "彼らの食べ物を食べたかったのは、"}, {"type": "subtitle", "time": 1503.51, "timestamp": "00:25:03", "text": "とても美味しそう。本当に素晴らしいですね。"}, {"type": "subtitle", "time": 1506.07, "timestamp": "00:25:06", "text": "特にアニメの食べ物みたいに"}, {"type": "subtitle", "time": 1510.31, "timestamp": "00:25:10", "text": "戦争とかそういう類のこと。とても美味しいです。そして私は"}, {"type": "subtitle", "time": 1512.23, "timestamp": "00:25:12", "text": "ずっとずっとそこに行きたかったんです。そして私は"}, {"type": "subtitle", "time": 1515.35, "timestamp": "00:25:15", "text": "もし魔法のようにいつか"}, {"type": "subtitle", "time": 1518.909, "timestamp": "00:25:18", "text": "資金は十分ありますし、"}, {"type": "subtitle", "time": 1521.99, "timestamp": "00:25:21", "text": "時間があれば、絶対に日本を訪れたいです。"}, {"type": "subtitle", "time": 1523.59, "timestamp": "00:25:23", "text": "そこは私が行くような場所ではない"}, {"type": "subtitle", "time": 1526.87, "timestamp": "00:25:26", "text": "住んでみたいけど、えっと、"}, {"type": "subtitle", "time": 1528.87, "timestamp": "00:25:28", "text": "観光客としてぜひ訪れたい"}, {"type": "subtitle", "time": 1531.83, "timestamp": "00:25:31", "text": "複数回。"}, {"type": "subtitle", "time": 1535.029, "timestamp": "00:25:35", "text": "うん、それはいいことだ。多くの人が望んでいない"}, {"type": "subtitle", "time": 1539.59, "timestamp": "00:25:39", "text": "ここに住む、あそこに住む。そう、だって"}, {"type": "subtitle", "time": 1542.47, "timestamp": "00:25:42", "text": "本当に大変だよ。ほら、私の"}, {"type": "subtitle", "time": 1545.99, "timestamp": "00:25:45", "text": "頭 私は完全に理解しています"}, {"type": "subtitle", "time": 1548.47, "timestamp": "00:25:48", "text": "市民として生きることはどのようなものになるだろうか"}, {"type": "subtitle", "time": 1551.75, "timestamp": "00:25:51", "text": "特定の国とそれがどのように"}, {"type": "subtitle", "time": 1554.31, "timestamp": "00:25:54", "text": "特定の場所を訪れるのが好きです"}, {"type": "subtitle", "time": 1557.669, "timestamp": "00:25:57", "text": "観光客として、そしてあらゆる"}, {"type": "subtitle", "time": 1559.909, "timestamp": "00:25:59", "text": "結論として、私は訪問したいと言いたい"}]
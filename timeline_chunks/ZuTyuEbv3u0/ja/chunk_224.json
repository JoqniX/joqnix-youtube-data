[{"type": "subtitle", "time": 13441.349, "timestamp": "03:44:01", "text": "とかそういうの？楽しかったですか？"}, {"type": "subtitle", "time": 13445.429, "timestamp": "03:44:05", "text": "例えば、そんなに深刻なことだったの？"}, {"type": "subtitle", "time": 13447.429, "timestamp": "03:44:07", "text": "絶対に違う。それはむしろ"}, {"type": "subtitle", "time": 13449.87, "timestamp": "03:44:09", "text": "えっと、あなたは恐らく自分のことに集中しているのでしょう"}, {"type": "subtitle", "time": 13453.11, "timestamp": "03:44:13", "text": "ビジネスに限らず、ほとんどがドラマだ"}, {"type": "subtitle", "time": 13454.87, "timestamp": "03:44:14", "text": "この友人グループと"}, {"type": "subtitle", "time": 13458.349, "timestamp": "03:44:18", "text": "あの友人グループ。ああ、"}, {"type": "subtitle", "time": 13461.189, "timestamp": "03:44:21", "text": "神。えっと、あなたは何も経験していない"}, {"type": "subtitle", "time": 13463.83, "timestamp": "03:44:23", "text": "いじめや嫌がらせ、その他"}, {"type": "subtitle", "time": 13465.75, "timestamp": "03:44:25", "text": "右？"}, {"type": "subtitle", "time": 13468.95, "timestamp": "03:44:28", "text": "つまり、私はいじめや嫌がらせをしていたのですが"}, {"type": "subtitle", "time": 13470.63, "timestamp": "03:44:30", "text": "ああ、甘やかされて育った金持ちもいるだろう"}, {"type": "subtitle", "time": 13473.99, "timestamp": "03:44:33", "text": "まるでジョイントのような子供たち。"}, {"type": "subtitle", "time": 13476.309, "timestamp": "03:44:36", "text": "ああ、あなたは人々と言ったのですね。ああ、"}, {"type": "subtitle", "time": 13485.269, "timestamp": "03:44:45", "text": "神。それは本当だ。それは本当です。つまり私は"}, {"type": "subtitle", "time": 13487.03, "timestamp": "03:44:47", "text": "そうはしなかったけど、ただ彼らに電話しただけ"}, {"type": "subtitle", "time": 13495.91, "timestamp": "03:44:55", "text": "うん。甘やかされている。"}, {"type": "subtitle", "time": 13497.51, "timestamp": "03:44:57", "text": "ええ、でも、ほとんどの場合は避けられます"}, {"type": "subtitle", "time": 13499.99, "timestamp": "03:44:59", "text": "とにかく、彼らだ。"}]
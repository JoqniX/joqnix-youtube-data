[{"type": "subtitle", "time": 16142.389, "timestamp": "04:29:02", "text": "モデル。だから私は十分な能力を持ちたい"}, {"type": "subtitle", "time": 16144.87, "timestamp": "04:29:04", "text": "そのモデルを使うのは、そのモデルが"}, {"type": "subtitle", "time": 16147.75, "timestamp": "04:29:07", "text": "期待値が高いのは"}, {"type": "subtitle", "time": 16150.229, "timestamp": "04:29:10", "text": "品質も全てが高いです。それで"}, {"type": "subtitle", "time": 16152.389, "timestamp": "04:29:12", "text": "それは内容的に私が"}, {"type": "subtitle", "time": 16154.87, "timestamp": "04:29:14", "text": "適切な品質のコンテンツを作成するために、"}, {"type": "subtitle", "time": 16157.83, "timestamp": "04:29:17", "text": "プロ意識、多くのこと、多くの"}, {"type": "subtitle", "time": 16160.79, "timestamp": "04:29:20", "text": "物事は順調に進んでいて、"}, {"type": "subtitle", "time": 16163.429, "timestamp": "04:29:23", "text": "まるで私がまだ準備ができていないのに、あなたが"}, {"type": "subtitle", "time": 16165.429, "timestamp": "04:29:25", "text": "スキルを見てみると"}, {"type": "subtitle", "time": 16168.469, "timestamp": "04:29:28", "text": "設定とか何であれ、私はまだ"}, {"type": "subtitle", "time": 16170.71, "timestamp": "04:29:30", "text": "自分の可能性を制限しているから、制限されていると感じている"}, {"type": "subtitle", "time": 16174.149, "timestamp": "04:29:34", "text": "自分のもの"}, {"type": "subtitle", "time": 16177.269, "timestamp": "04:29:37", "text": "理想とか、プロフェッショナルとかそういうのは違う"}, {"type": "subtitle", "time": 16179.75, "timestamp": "04:29:39", "text": "プロフェッショナル プロフェッショナル 何か ねえ、"}, {"type": "subtitle", "time": 16181.91, "timestamp": "04:29:41", "text": "私はその物を持っていて、徐々に"}, {"type": "subtitle", "time": 16184.87, "timestamp": "04:29:44", "text": "その上に。今ならできる、今ならついに"}, {"type": "subtitle", "time": 16186.469, "timestamp": "04:29:46", "text": "このジョックマラソンを通して私はついに"}, {"type": "subtitle", "time": 16189.349, "timestamp": "04:29:49", "text": "短いショートフォームコンテンツをアップロードできます"}, {"type": "subtitle", "time": 16192.87, "timestamp": "04:29:52", "text": "Instagramのリアル、TikTok、そしてえーと"}, {"type": "subtitle", "time": 16195.03, "timestamp": "04:29:55", "text": "YouTubeの動画。私はできるのが嬉しい"}, {"type": "subtitle", "time": 16197.83, "timestamp": "04:29:57", "text": "あれと対峙するために。たとえそれが"}]
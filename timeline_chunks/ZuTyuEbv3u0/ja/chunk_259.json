[{"type": "subtitle", "time": 15542.469, "timestamp": "04:19:02", "text": "うん、私だけだと思う​​けど"}, {"type": "subtitle", "time": 15544.229, "timestamp": "04:19:04", "text": "現在Billy Billyで配信中です。つまり、"}, {"type": "subtitle", "time": 15546.11, "timestamp": "04:19:06", "text": "うん。"}, {"type": "subtitle", "time": 15549.349, "timestamp": "04:19:09", "text": "ああ、誰もビリー・ビリーのところに来ない。"}, {"type": "subtitle", "time": 15553.67, "timestamp": "04:19:13", "text": "女性は「うん」って感じ。中国は恐ろしい。"}, {"type": "subtitle", "time": 15556.63, "timestamp": "04:19:16", "text": "うん。うん。その通り。私はそうは思わない"}, {"type": "subtitle", "time": 15559.11, "timestamp": "04:19:19", "text": "インド人、つまり誰でも"}, {"type": "subtitle", "time": 15561.55, "timestamp": "04:19:21", "text": "インド人を除いてね、兄弟。ああ、"}, {"type": "subtitle", "time": 15565.349, "timestamp": "04:19:25", "text": "神。何てことだ。うん。"}, {"type": "subtitle", "time": 15566.71, "timestamp": "04:19:26", "text": "ありがたいことに、私は何も受けませんでした"}, {"type": "subtitle", "time": 15569.67, "timestamp": "04:19:29", "text": "差別とか、外国人嫌悪とか"}, {"type": "subtitle", "time": 15574.309, "timestamp": "04:19:34", "text": "まるで、"}, {"type": "subtitle", "time": 15576.63, "timestamp": "04:19:36", "text": "失礼とか、そういうこと。今のところ、私は会ったことがない"}, {"type": "subtitle", "time": 15577.79, "timestamp": "04:19:37", "text": "誰でも"}, {"type": "subtitle", "time": 15580.71, "timestamp": "04:19:40", "text": "まだ。ああ、本当にありがたい。つまり、それは"}, {"type": "subtitle", "time": 15584.07, "timestamp": "04:19:44", "text": "良いことだ。うん、みんなこう言ってたよ"}, {"type": "subtitle", "time": 15586.95, "timestamp": "04:19:46", "text": "発言には気をつけなさい。人々は"}, {"type": "subtitle", "time": 15589.51, "timestamp": "04:19:49", "text": "人種差別主義者とか、そういう類のもの全部。私"}, {"type": "subtitle", "time": 15591.429, "timestamp": "04:19:51", "text": "つまり、その部分は本当だということです"}, {"type": "subtitle", "time": 15595.25, "timestamp": "04:19:55", "text": "けれど。ええ、それは本当です。うん。全て"}, {"type": "subtitle", "time": 15596.469, "timestamp": "04:19:56", "text": "[音楽]"}, {"type": "subtitle", "time": 15598.429, "timestamp": "04:19:58", "text": "そう、君をここに留めておくよ"}]
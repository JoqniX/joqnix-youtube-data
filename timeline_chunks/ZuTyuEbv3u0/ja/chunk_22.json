[{"type": "subtitle", "time": 1320.95, "timestamp": "00:22:00", "text": "私はあなたのしていることを尊敬していますし、"}, {"type": "subtitle", "time": 1324.149, "timestamp": "00:22:04", "text": "日々の努力"}, {"type": "subtitle", "time": 1327.83, "timestamp": "00:22:07", "text": "ただ夢を見て、繋がって、楽しむ"}, {"type": "subtitle", "time": 1329.75, "timestamp": "00:22:09", "text": "同じように。でもこれはあなたの夢で"}, {"type": "subtitle", "time": 1332.87, "timestamp": "00:22:12", "text": "それがあなたの得意なことです"}, {"type": "subtitle", "time": 1335.75, "timestamp": "00:22:15", "text": "感謝の気持ちです。"}, {"type": "subtitle", "time": 1340.95, "timestamp": "00:22:20", "text": "だからチューブ遊びはすごく楽しいし、そうだよ"}, {"type": "subtitle", "time": 1345.63, "timestamp": "00:22:25", "text": "とても楽しかった。恋しいけど、まあ恋しい"}, {"type": "subtitle", "time": 1348.87, "timestamp": "00:22:28", "text": "でも、うまくいけばすぐに戻ってきます"}, {"type": "subtitle", "time": 1351.35, "timestamp": "00:22:31", "text": "同じように。ただ、"}, {"type": "subtitle", "time": 1354.39, "timestamp": "00:22:34", "text": "私の側にはたくさんの話があるのですが、"}, {"type": "subtitle", "time": 1357.27, "timestamp": "00:22:37", "text": "私の人々に説明することになると思います"}, {"type": "subtitle", "time": 1362.07, "timestamp": "00:22:42", "text": "もうすぐですが、いつになるかはわかりません"}, {"type": "subtitle", "time": 1364.149, "timestamp": "00:22:44", "text": "それは間もなく起こるだろう。わからない"}, {"type": "subtitle", "time": 1366.63, "timestamp": "00:22:46", "text": "私のチャンネルでそれが起こるか、"}, {"type": "subtitle", "time": 1368.789, "timestamp": "00:22:48", "text": "いつ起こるかわかりません"}, {"type": "subtitle", "time": 1371.029, "timestamp": "00:22:51", "text": "Discordだけど、まるであなたがキャッチしているだけ"}, {"type": "subtitle", "time": 1374.47, "timestamp": "00:22:54", "text": "仲間と一緒にいることは私にとってとても大きな意味があります"}]
[{"type": "subtitle", "time": 12902.389, "timestamp": "03:35:02", "text": "そのライフスタイルに似ている私は"}, {"type": "subtitle", "time": 12905.99, "timestamp": "03:35:05", "text": "手を使うって言うけど、いやいやいや、"}, {"type": "subtitle", "time": 12908.79, "timestamp": "03:35:08", "text": "えっと、お皿にご飯を盛り付けますよね"}, {"type": "subtitle", "time": 12911.59, "timestamp": "03:35:11", "text": "いくらですか"}, {"type": "subtitle", "time": 12914.71, "timestamp": "03:35:14", "text": "このスケールのようにどのように"}, {"type": "subtitle", "time": 12917.91, "timestamp": "03:35:17", "text": "私たちは、ええと、"}, {"type": "subtitle", "time": 12920.95, "timestamp": "03:35:20", "text": "大きなスプーンですね"}, {"type": "subtitle", "time": 12925.59, "timestamp": "03:35:25", "text": "ええ、いくらですか。でも、後ろ盾から。"}, {"type": "subtitle", "time": 12927.429, "timestamp": "03:35:27", "text": "うーん、それは何とも言えないですね。でも私は"}, {"type": "subtitle", "time": 12929.67, "timestamp": "03:35:29", "text": "5と言ってください。"}, {"type": "subtitle", "time": 12933.19, "timestamp": "03:35:33", "text": "五。はぁ？"}, {"type": "subtitle", "time": 12936.389, "timestamp": "03:35:36", "text": "うん。あれは山だ。どのように食事をしますか？"}, {"type": "subtitle", "time": 12940.469, "timestamp": "03:35:40", "text": "そんなに？いいえ。いいえ。私の電話から、"}, {"type": "subtitle", "time": 12944.74, "timestamp": "03:35:44", "text": "もっと少ないかもしれないと思います。"}, {"type": "subtitle", "time": 12946.95, "timestamp": "03:35:46", "text": "[音楽]"}, {"type": "subtitle", "time": 12949.91, "timestamp": "03:35:49", "text": "うん。聞いてください"}, {"type": "subtitle", "time": 12953.03, "timestamp": "03:35:53", "text": "手で食べるスケール"}, {"type": "subtitle", "time": 12955.19, "timestamp": "03:35:55", "text": "12時頃になると思います"}, {"type": "subtitle", "time": 12957.19, "timestamp": "03:35:57", "text": "または15。"}, {"type": "subtitle", "time": 12958.87, "timestamp": "03:35:58", "text": "ああ"}]
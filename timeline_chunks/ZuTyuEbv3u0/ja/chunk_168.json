[{"type": "subtitle", "time": 10081.349, "timestamp": "02:48:01", "text": "影のやつみたいな感じだよね？のように"}, {"type": "subtitle", "time": 10086.23, "timestamp": "02:48:06", "text": "影付きのPNGシルエット画像。うん。しかし"}, {"type": "subtitle", "time": 10089.75, "timestamp": "02:48:09", "text": "私はアートモデルアートが"}, {"type": "subtitle", "time": 10094.07, "timestamp": "02:48:14", "text": "ちょっと、えっと、完全に"}, {"type": "subtitle", "time": 10096.23, "timestamp": "02:48:16", "text": "リニューアルしました。まだ準備ができていないので。"}, {"type": "subtitle", "time": 10100.469, "timestamp": "02:48:20", "text": "2Dウィングモーションの瞬間。芸術はそこにある"}, {"type": "subtitle", "time": 10104.15, "timestamp": "02:48:24", "text": "分離されているが、すべてのように適切に分離されていない"}, {"type": "subtitle", "time": 10107.349, "timestamp": "02:48:27", "text": "今は完全に分離する必要がある"}, {"type": "subtitle", "time": 10111.51, "timestamp": "02:48:31", "text": "あらゆる面において。私の計画は"}, {"type": "subtitle", "time": 10114.15, "timestamp": "02:48:34", "text": "モデルを完全に完璧にして"}, {"type": "subtitle", "time": 10117.349, "timestamp": "02:48:37", "text": "すべて良好、完全版V2モデル。それで"}, {"type": "subtitle", "time": 10119.03, "timestamp": "02:48:39", "text": "リギングに関しては、"}, {"type": "subtitle", "time": 10121.51, "timestamp": "02:48:41", "text": "人生全体をそうやってやる"}, {"type": "subtitle", "time": 10124.63, "timestamp": "02:48:44", "text": "彼らは、その復習用のものを持っている。"}, {"type": "subtitle", "time": 10128.309, "timestamp": "02:48:48", "text": "えーっと、2.0か3.0のブラシアップはどれも知ってるよ。"}, {"type": "subtitle", "time": 10130.71, "timestamp": "02:48:50", "text": "移動速度のアップグレードなど全て追加します。"}, {"type": "subtitle", "time": 10133.349, "timestamp": "02:48:53", "text": "右？より安価に"}, {"type": "subtitle", "time": 10135.91, "timestamp": "02:48:55", "text": "転換点のようなもの、そして"}, {"type": "subtitle", "time": 10139.03, "timestamp": "02:48:59", "text": "手順はご存知ですよね？私はこう思った"}]
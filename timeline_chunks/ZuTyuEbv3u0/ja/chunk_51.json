[{"type": "subtitle", "time": 3060.23, "timestamp": "00:51:00", "text": "さあ、行こう。"}, {"type": "subtitle", "time": 3063.27, "timestamp": "00:51:03", "text": "よし。私はそこへ行くつもりです。ここは私の場所"}, {"type": "subtitle", "time": 3071.91, "timestamp": "00:51:11", "text": "つまり、あなたは女王様なんですね。何を移動できますか？おお"}, {"type": "subtitle", "time": 3078.99, "timestamp": "00:51:18", "text": "神。何ができるだろうか"}, {"type": "subtitle", "time": 3083.19, "timestamp": "00:51:23", "text": "動く？こいつをぶっ潰したい。えっと、でも"}, {"type": "subtitle", "time": 3089.99, "timestamp": "00:51:29", "text": "大丈夫。先輩、あまり考えすぎないでください。"}, {"type": "subtitle", "time": 3092.19, "timestamp": "00:51:32", "text": "ええ、私は戻ります"}, {"type": "subtitle", "time": 3095.27, "timestamp": "00:51:35", "text": "普通。さよなら。"}, {"type": "subtitle", "time": 3098.309, "timestamp": "00:51:38", "text": "ああ、なんてことだ、私を選んでくれたんだね。本当に、"}, {"type": "subtitle", "time": 3101.91, "timestamp": "00:51:41", "text": "本当に、本当に、本当に欲しかったんだよ、"}, {"type": "subtitle", "time": 3105.589, "timestamp": "00:51:45", "text": "それは非常に長い間そうでした。本当に"}, {"type": "subtitle", "time": 3108.15, "timestamp": "00:51:48", "text": "司教をずっと望んでいた。"}]
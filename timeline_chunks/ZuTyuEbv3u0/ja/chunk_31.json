[{"type": "subtitle", "time": 1860.669, "timestamp": "00:31:00", "text": "気を失いそうだ。"}, {"type": "subtitle", "time": 1863.269, "timestamp": "00:31:03", "text": "そうだけど、ほら、"}, {"type": "subtitle", "time": 1865.669, "timestamp": "00:31:05", "text": "買わなければならないものがたくさんある。"}, {"type": "subtitle", "time": 1867.909, "timestamp": "00:31:07", "text": "それを移動させるのは本当に大変です"}, {"type": "subtitle", "time": 1872.87, "timestamp": "00:31:12", "text": "あなた。ああ、今は一人暮らしなんですね？おお。"}, {"type": "subtitle", "time": 1876.87, "timestamp": "00:31:16", "text": "今は違うけど、うん、近いうちに"}, {"type": "subtitle", "time": 1880.63, "timestamp": "00:31:20", "text": "十分。おお、いいね、いいね、いいね。"}, {"type": "subtitle", "time": 1883.83, "timestamp": "00:31:23", "text": "ええ、実はそれが一番嫌なんです。私は"}, {"type": "subtitle", "time": 1887.19, "timestamp": "00:31:27", "text": "今、それがすごく気に入ってるんです。待って。えっと、"}, {"type": "subtitle", "time": 1889.51, "timestamp": "00:31:29", "text": "一人暮らしの時間、またはあなたが好むのは"}, {"type": "subtitle", "time": 1893.59, "timestamp": "00:31:33", "text": "ルームメイトみたいな感じ？問題は私が好むのは"}, {"type": "subtitle", "time": 1895.43, "timestamp": "00:31:35", "text": "えっと、私について言えば、"}, {"type": "chat", "time": 1896.212, "timestamp": "00:31:36", "author": "@calx_nyx", "avatar": "https://yt4.ggpht.com/XFPadkBWV-wDHemIdJAJ0ZlOnQHzuQJq3X3CrTt0JO7prEc9g-uiFft4EJRfG-ZfPUNyuCkI=s64-c-k-c0x00ffffff-no-rj", "message": "yo tsukina and joqq"}, {"type": "subtitle", "time": 1899.269, "timestamp": "00:31:39", "text": "右？私はプライバシーを大切にしたいんです。私は自分の"}, {"type": "subtitle", "time": 1902.75, "timestamp": "00:31:42", "text": "部屋。私は自分の時間を大切にしたい。まるで私が"}, {"type": "subtitle", "time": 1905.909, "timestamp": "00:31:45", "text": "全体的に住みたくない"}, {"type": "subtitle", "time": 1909.19, "timestamp": "00:31:49", "text": "家に一人きり。私は自分の"}, {"type": "subtitle", "time": 1913.75, "timestamp": "00:31:53", "text": "部屋に入って、人に会うんだよ、わかるだろ？そして私は"}, {"type": "subtitle", "time": 1915.59, "timestamp": "00:31:55", "text": "会話はしたいけど、"}, {"type": "subtitle", "time": 1917.909, "timestamp": "00:31:57", "text": "もし私が一人暮らしを始めたら"}, {"type": "subtitle", "time": 1919.509, "timestamp": "00:31:59", "text": "私にとっては難しいだろう"}]
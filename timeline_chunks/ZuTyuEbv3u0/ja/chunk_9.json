[{"type": "subtitle", "time": 541.829, "timestamp": "00:09:01", "text": "封鎖されている。"}, {"type": "subtitle", "time": 544.23, "timestamp": "00:09:04", "text": "救世主と呼ばれるグループが"}, {"type": "subtitle", "time": 546.47, "timestamp": "00:09:06", "text": "人々を密入国させる。彼らには巣穴がある"}, {"type": "subtitle", "time": 549.71, "timestamp": "00:09:09", "text": "ニコのバーで大釜の近く"}, {"type": "subtitle", "time": 552.79, "timestamp": "00:09:12", "text": "高速道路。名前はカバーするのに十分なランナーです"}, {"type": "subtitle", "time": 556.389, "timestamp": "00:09:16", "text": "空中投下。空挺降下は36時間停止した。"}, {"type": "subtitle", "time": 559.269, "timestamp": "00:09:19", "text": "前。もう二度とないだろう。出かけます"}, {"type": "subtitle", "time": 562.55, "timestamp": "00:09:22", "text": "時間。クレーン。くそっ。"}, {"type": "subtitle", "time": 564.87, "timestamp": "00:09:24", "text": "よし。直せるかどうかわからない"}, {"type": "subtitle", "time": 566.389, "timestamp": "00:09:26", "text": "これはそうだけど、絶対にやってみるつもりだ。"}, {"type": "subtitle", "time": 568.87, "timestamp": "00:09:28", "text": "君の立場にいるほとんどの男性が"}, {"type": "subtitle", "time": 571.03, "timestamp": "00:09:31", "text": "穴に潜り込んで隠れるだろう。帽子"}, {"type": "subtitle", "time": 578.31, "timestamp": "00:09:38", "text": "ああ、彼は私たちのラジオを持って行ったんだ。わかった、"}, {"type": "subtitle", "time": 581.11, "timestamp": "00:09:41", "text": "ついに。ウクライナの皆さん、これがあなた方の装備です。最高"}, {"type": "subtitle", "time": 583.509, "timestamp": "00:09:43", "text": "カリームよりご挨拶申し上げます。カリームか。わかった、"}, {"type": "subtitle", "time": 585.269, "timestamp": "00:09:45", "text": "装備が戻ってきました。彼を見かけたら、"}, {"type": "subtitle", "time": 588.55, "timestamp": "00:09:48", "text": "彼に私の代わりに感謝を伝えてください。"}, {"type": "subtitle", "time": 591.99, "timestamp": "00:09:51", "text": "ついに。うん、自分の荷物は手に入れたよ"}, {"type": "subtitle", "time": 594.87, "timestamp": "00:09:54", "text": "戻る。ニース。"}, {"type": "subtitle", "time": 597.07, "timestamp": "00:09:57", "text": "それでは、"}]
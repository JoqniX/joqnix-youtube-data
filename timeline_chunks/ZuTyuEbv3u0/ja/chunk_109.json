[{"type": "subtitle", "time": 6556.79, "timestamp": "01:49:16", "text": "ええ、私はこのPCの電源を切っていません"}, {"type": "subtitle", "time": 6558.87, "timestamp": "01:49:18", "text": "1週間くらい。ところで、私は"}, {"type": "subtitle", "time": 6561.91, "timestamp": "01:49:21", "text": "今日の配信は配信PCから"}, {"type": "subtitle", "time": 6564.31, "timestamp": "01:49:24", "text": "かなり動作が遅い。それ以外では、"}, {"type": "subtitle", "time": 6566.31, "timestamp": "01:49:26", "text": "私はこれを知りませんでした。私は"}, {"type": "subtitle", "time": 6586.47, "timestamp": "01:49:46", "text": "外。 2つ以上ストリーミングすることはありません"}, {"type": "subtitle", "time": 6588.47, "timestamp": "01:49:48", "text": "時間。どういう意味ですか？私はしなければならない"}, {"type": "subtitle", "time": 6590.51, "timestamp": "01:49:50", "text": "イベントを終了"}, {"type": "subtitle", "time": 6594.629, "timestamp": "01:49:54", "text": "今日、そしてヤオヤを手に入れよう。私は彼女を招待します"}]
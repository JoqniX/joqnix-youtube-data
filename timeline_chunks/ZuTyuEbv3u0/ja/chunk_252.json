[{"type": "subtitle", "time": 15121.269, "timestamp": "04:12:01", "text": "側。"}, {"type": "subtitle", "time": 15123.349, "timestamp": "04:12:03", "text": "つまり、今後も続きがあるということです。私はただ"}, {"type": "subtitle", "time": 15125.59, "timestamp": "04:12:05", "text": "ここにいられて本当に嬉しいです"}, {"type": "subtitle", "time": 15127.99, "timestamp": "04:12:07", "text": "Josとのコラボレーションみたい。ありがとう。"}, {"type": "subtitle", "time": 15130.07, "timestamp": "04:12:10", "text": "ご招待ありがとうございます。あなたが"}, {"type": "subtitle", "time": 15133.75, "timestamp": "04:12:13", "text": "将来に向けて良い時間を過ごしましょう。うん。"}, {"type": "subtitle", "time": 15137.11, "timestamp": "04:12:17", "text": "ええ、私も感謝していますし、嬉しいです。"}, {"type": "subtitle", "time": 15139.83, "timestamp": "04:12:19", "text": "私たちはこのように協力することができました。その"}, {"type": "subtitle", "time": 15141.83, "timestamp": "04:12:21", "text": "ソロコラボをするのは久しぶりですね"}, {"type": "subtitle", "time": 15146.229, "timestamp": "04:12:26", "text": "私たち全員が会ってコラボレーションするようなもの"}, {"type": "subtitle", "time": 15149.189, "timestamp": "04:12:29", "text": "以前のグループですよね？それは私たちの"}, {"type": "subtitle", "time": 15151.83, "timestamp": "04:12:31", "text": "初のソロコラボレーション。うん、初めてのソロ"}, {"type": "subtitle", "time": 15154.79, "timestamp": "04:12:34", "text": "コラボレーション。私は幸せです。"}, {"type": "subtitle", "time": 15157.75, "timestamp": "04:12:37", "text": "ええ、ここに来られて嬉しいです。うん。感謝"}, {"type": "subtitle", "time": 15159.63, "timestamp": "04:12:39", "text": "あなた"}, {"type": "subtitle", "time": 15164.309, "timestamp": "04:12:44", "text": "それでは、これで終わりにしましょう。"}, {"type": "subtitle", "time": 15167.15, "timestamp": "04:12:47", "text": "うん。バイバイ。こんにちは。バイバイ。ありがとうございます"}, {"type": "subtitle", "time": 15169.91, "timestamp": "04:12:49", "text": "今日。素敵な夜をお過ごしください。"}, {"type": "subtitle", "time": 15173.79, "timestamp": "04:12:53", "text": "試験頑張ってね！"}, {"type": "subtitle", "time": 15176.63, "timestamp": "04:12:56", "text": "つまり、私はまだ慣れる必要がある"}, {"type": "subtitle", "time": 15178.309, "timestamp": "04:12:58", "text": "名前。"}]
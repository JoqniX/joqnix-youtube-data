[{"type": "subtitle", "time": 6605.91, "timestamp": "01:50:05", "text": "パーティー。私はスピードランに近い感覚でプレイします。私はします"}, {"type": "subtitle", "time": 6609.35, "timestamp": "01:50:09", "text": "自分で読んで、実践してみる。これは"}, {"type": "subtitle", "time": 6611.91, "timestamp": "01:50:11", "text": "ちなみに、その土地の一部は経営されている。病気"}, {"type": "subtitle", "time": 6612.91, "timestamp": "01:50:12", "text": "見せる"}, {"type": "subtitle", "time": 6617.03, "timestamp": "01:50:17", "text": "それ。それは残念だ、だって私はまだ"}, {"type": "subtitle", "time": 6618.43, "timestamp": "01:50:18", "text": "終了した"}, {"type": "subtitle", "time": 6622.47, "timestamp": "01:50:22", "text": "まだ終わらせてないからアップした"}, {"type": "subtitle", "time": 6629.03, "timestamp": "01:50:29", "text": "えっと、何それ？"}, {"type": "subtitle", "time": 6631.59, "timestamp": "01:50:31", "text": "えっと、ストーリークエスト。私にはたくさんの物語があります"}, {"type": "subtitle", "time": 6633.709, "timestamp": "01:50:33", "text": "クエストとして行う"}, {"type": "subtitle", "time": 6637.189, "timestamp": "01:50:37", "text": "YouTubeでシリーズとして公開されています。だから私は"}, {"type": "subtitle", "time": 6638.51, "timestamp": "01:50:38", "text": "終わり"}, {"type": "subtitle", "time": 6647.91, "timestamp": "01:50:47", "text": "皆さん、この車の音聞こえますか？"}, {"type": "subtitle", "time": 6649.06, "timestamp": "01:50:49", "text": "私は"}, {"type": "subtitle", "time": 6650.43, "timestamp": "01:50:50", "text": "[音楽]"}]
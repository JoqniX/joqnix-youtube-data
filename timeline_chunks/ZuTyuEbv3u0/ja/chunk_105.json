[{"type": "subtitle", "time": 6301.9, "timestamp": "01:45:01", "text": "作品。そして私のOBSは"}, {"type": "subtitle", "time": 6313.709, "timestamp": "01:45:13", "text": "クラッシュ。わかった。えーと、"}, {"type": "subtitle", "time": 6322.109, "timestamp": "01:45:22", "text": "この巨大なものはどこにあるのでしょうか"}, {"type": "subtitle", "time": 6325.59, "timestamp": "01:45:25", "text": "このバスに恋に落ちるようなインターレンジ"}, {"type": "subtitle", "time": 6327.229, "timestamp": "01:45:27", "text": "ここ数回"}, {"type": "subtitle", "time": 6329.629, "timestamp": "01:45:29", "text": "ストリーム？"}, {"type": "subtitle", "time": 6331.55, "timestamp": "01:45:31", "text": "はぁ？"}, {"type": "subtitle", "time": 6338.39, "timestamp": "01:45:38", "text": "テラス？忘れた。待って、巨大なって何？"}, {"type": "subtitle", "time": 6340.43, "timestamp": "01:45:40", "text": "再び入り口ですか？何てことだ。"}, {"type": "subtitle", "time": 6343.55, "timestamp": "01:45:43", "text": "待って。非常に広い範囲。"}, {"type": "subtitle", "time": 6347.87, "timestamp": "01:45:47", "text": "テレンテラス。テランスではない。そうではない"}, {"type": "subtitle", "time": 6350.55, "timestamp": "01:45:50", "text": "私はループです。"}, {"type": "subtitle", "time": 6352.83, "timestamp": "01:45:52", "text": "[音楽]"}, {"type": "subtitle", "time": 6355.149, "timestamp": "01:45:55", "text": "待って、ここはどこ？"}, {"type": "subtitle", "time": 6358.32, "timestamp": "01:45:58", "text": "場所？私はこれら全てを忘れていた"}]
[{"type": "subtitle", "time": 5640.47, "timestamp": "01:34:00", "text": "対戦相手のこと、そして私は本当に"}, {"type": "subtitle", "time": 5643.189, "timestamp": "01:34:03", "text": "彼女にとって初めての子供となる。私は本当に願っています"}, {"type": "subtitle", "time": 5647.35, "timestamp": "01:34:07", "text": "一生懸命働いてお金を稼ぐ"}, {"type": "subtitle", "time": 5650.31, "timestamp": "01:34:10", "text": "十分なお金で何らかの形でコミッション"}, {"type": "subtitle", "time": 5652.39, "timestamp": "01:34:12", "text": "モデルではなく、委託しない"}, {"type": "subtitle", "time": 5654.47, "timestamp": "01:34:14", "text": "モデル。彼らは修理作業をやり遂げる。"}, {"type": "subtitle", "time": 5656.79, "timestamp": "01:34:16", "text": "それが残された主な点だ。モデルは"}, {"type": "subtitle", "time": 5658.709, "timestamp": "01:34:18", "text": "完了したよね？修理用品は残されています"}, {"type": "subtitle", "time": 5662.87, "timestamp": "01:34:22", "text": "外。次に、モデルにリギングを施します。"}, {"type": "subtitle", "time": 5665.95, "timestamp": "01:34:25", "text": "そして全てが実際にデビューした、"}, {"type": "subtitle", "time": 5668.55, "timestamp": "01:34:28", "text": "何か。うん。できるだけ早く"}, {"type": "subtitle", "time": 5671.99, "timestamp": "01:34:31", "text": "今年。デビューできたらいいのに"}, {"type": "subtitle", "time": 5674.709, "timestamp": "01:34:34", "text": "実際は私の誕生日ですが、"}, {"type": "subtitle", "time": 5676.83, "timestamp": "01:34:36", "text": "それは"}, {"type": "subtitle", "time": 5678.99, "timestamp": "01:34:38", "text": "可能。"}, {"type": "subtitle", "time": 5681.43, "timestamp": "01:34:41", "text": "えっと、それは不可能だと思うよ。"}, {"type": "subtitle", "time": 5684.83, "timestamp": "01:34:44", "text": "リギングには3ヶ月かかります"}, {"type": "subtitle", "time": 5689.75, "timestamp": "01:34:49", "text": "少しでも。うん。そしてもう5月だ、終わり"}, {"type": "subtitle", "time": 5692.669, "timestamp": "01:34:52", "text": "5月の。だからもし私が"}, {"type": "subtitle", "time": 5696.35, "timestamp": "01:34:56", "text": "お金があれば、"}, {"type": "subtitle", "time": 5699.79, "timestamp": "01:34:59", "text": "私は持っていたかもしれない"}]
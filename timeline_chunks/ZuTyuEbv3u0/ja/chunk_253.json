[{"type": "subtitle", "time": 15180.55, "timestamp": "04:13:00", "text": "つまり、あなただけじゃないよ。"}, {"type": "subtitle", "time": 15182.87, "timestamp": "04:13:02", "text": "待って、私以外に何人いるの"}, {"type": "subtitle", "time": 15193.83, "timestamp": "04:13:13", "text": "そして、神話級のものもあります。"}, {"type": "subtitle", "time": 15196.79, "timestamp": "04:13:16", "text": "たくさんあります。ええ、ほぼ"}, {"type": "subtitle", "time": 15200.189, "timestamp": "04:13:20", "text": "サーバーはVCグループでした。"}, {"type": "subtitle", "time": 15203.11, "timestamp": "04:13:23", "text": "ニース。うん、ニクシーがいるならね？それで"}, {"type": "subtitle", "time": 15206.55, "timestamp": "04:13:26", "text": "とても難しい。次回はカルに連絡してください。"}, {"type": "subtitle", "time": 15209.269, "timestamp": "04:13:29", "text": "何か。うん、ほら、"}, {"type": "subtitle", "time": 15212.309, "timestamp": "04:13:32", "text": "昨日VCで。つまり基本的には"}, {"type": "subtitle", "time": 15214.55, "timestamp": "04:13:34", "text": "人々がそこにいた。ネクシもそこにいた。それで"}, {"type": "subtitle", "time": 15218.309, "timestamp": "04:13:38", "text": "あなたはナズキですよね？"}, {"type": "subtitle", "time": 15224.79, "timestamp": "04:13:44", "text": "彼は次の人みたいで、それから私たちは"}, {"type": "subtitle", "time": 15239.11, "timestamp": "04:13:59", "text": "うん。私ももっと安く立ち寄るべきだし"}]
[{"type": "subtitle", "time": 8826.389, "timestamp": "02:27:06", "text": "成功。はい。"}, {"type": "subtitle", "time": 8828.23, "timestamp": "02:27:08", "text": "そうそう。先生の話ですが、私はまだ"}, {"type": "subtitle", "time": 8832.79, "timestamp": "02:27:12", "text": "あなたがそうであることに驚きました。"}, {"type": "subtitle", "time": 8836.51, "timestamp": "02:27:16", "text": "「まだこれ使ってるの？」って思ったよ"}, {"type": "subtitle", "time": 8840.07, "timestamp": "02:27:20", "text": "アカウントですか？彼女は「はい」と言いました。そして私は"}, {"type": "subtitle", "time": 8843.99, "timestamp": "02:27:23", "text": "「ああ、もし時間があれば"}, {"type": "subtitle", "time": 8846.309, "timestamp": "02:27:26", "text": "私はジョアソンという企画に参加しています。私は"}, {"type": "subtitle", "time": 8849.19, "timestamp": "02:27:29", "text": "出会った人全員を招待して、"}, {"type": "subtitle", "time": 8851.349, "timestamp": "02:27:31", "text": "私の旅を通してずっと。あなたなら"}, {"type": "subtitle", "time": 8853.91, "timestamp": "02:27:33", "text": "「現れたりするのが好きだってこと？」そして彼女は"}, {"type": "subtitle", "time": 8855.67, "timestamp": "02:27:35", "text": "「はい、ぜひそうしたいです。」といった感じ。そして"}, {"type": "subtitle", "time": 8858.15, "timestamp": "02:27:38", "text": "すべて。そして、こうして私は"}, {"type": "subtitle", "time": 8861.19, "timestamp": "02:27:41", "text": "彼女を捕まえろ。 100% だとは思っていませんでした"}, {"type": "subtitle", "time": 8869.429, "timestamp": "02:27:49", "text": "つまり、彼女のディスコードを見たんだよ、"}, {"type": "subtitle", "time": 8871.91, "timestamp": "02:27:51", "text": "オンラインで登場するが、まるでアイドルのよう"}, {"type": "subtitle", "time": 8874.87, "timestamp": "02:27:54", "text": "えーと、完全にではなく、"}, {"type": "subtitle", "time": 8878.11, "timestamp": "02:27:58", "text": "ええ、決して"}]
[{"type": "subtitle", "time": 9241.469, "timestamp": "02:34:01", "text": "彼らは叫ぶのが好きで、周りで"}, {"type": "subtitle", "time": 9245.91, "timestamp": "02:34:05", "text": "うん、ちょっと難しいね。通常、どうやって待つか"}, {"type": "subtitle", "time": 9247.03, "timestamp": "02:34:07", "text": "平均で何人いるか知っていますか"}, {"type": "subtitle", "time": 9248.59, "timestamp": "02:34:08", "text": "ルームメイトが"}, {"type": "subtitle", "time": 9252.63, "timestamp": "02:34:12", "text": "得る？こんにちは、私が知っているのは、"}, {"type": "subtitle", "time": 9256.349, "timestamp": "02:34:16", "text": "私の趣味のためのシェアハウス"}, {"type": "subtitle", "time": 9259.03, "timestamp": "02:34:19", "text": "YouTubeでよく見かけるような"}, {"type": "subtitle", "time": 9261.83, "timestamp": "02:34:21", "text": "まるで完全な家が"}, {"type": "subtitle", "time": 9264.469, "timestamp": "02:34:24", "text": "少しスペースがあり、"}, {"type": "subtitle", "time": 9266.71, "timestamp": "02:34:26", "text": "部屋"}, {"type": "subtitle", "time": 9267.71, "timestamp": "02:34:27", "text": "私はしません"}, {"type": "subtitle", "time": 9277.51, "timestamp": "02:34:37", "text": "実際私が知っているのは、それは"}, {"type": "subtitle", "time": 9280.23, "timestamp": "02:34:40", "text": "狭いスペースですが、主なことは"}, {"type": "subtitle", "time": 9283.83, "timestamp": "02:34:43", "text": "問題は壁が薄いことです。"}, {"type": "subtitle", "time": 9285.349, "timestamp": "02:34:45", "text": "右？"}, {"type": "subtitle", "time": 9297.75, "timestamp": "02:34:57", "text": "[音楽]"}, {"type": "subtitle", "time": 9299.75, "timestamp": "02:34:59", "text": "うん。一方、私はここで生き延びている"}]
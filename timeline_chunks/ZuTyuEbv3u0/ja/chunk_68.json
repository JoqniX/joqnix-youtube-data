[{"type": "subtitle", "time": 4080.23, "timestamp": "01:08:00", "text": "うん。富士山を見るには、実際に行ってみるしかない。"}, {"type": "subtitle", "time": 4083.349, "timestamp": "01:08:03", "text": "はい。うん。私は見たい 私は見たい"}, {"type": "subtitle", "time": 4086.47, "timestamp": "01:08:06", "text": "誰かの実際の映像を知ってるでしょ"}, {"type": "subtitle", "time": 4089.829, "timestamp": "01:08:09", "text": "私が知っている限り、そこに行った人はいる。そうですね、そうなるでしょう"}, {"type": "subtitle", "time": 4092.99, "timestamp": "01:08:12", "text": "とてもとても幸せにしてくれる。"}, {"type": "subtitle", "time": 4096.63, "timestamp": "01:08:16", "text": "うん。ローラ、本当におめでとう！私はとても"}, {"type": "subtitle", "time": 4102.48, "timestamp": "01:08:22", "text": "うん。"}, {"type": "subtitle", "time": 4105.03, "timestamp": "01:08:25", "text": "[音楽]"}, {"type": "subtitle", "time": 4108.309, "timestamp": "01:08:28", "text": "はい。今日は楽しかった。待って、いくつ"}, {"type": "subtitle", "time": 4110.07, "timestamp": "01:08:30", "text": "残り何分？えっと、9時になります。"}, {"type": "subtitle", "time": 4113.749, "timestamp": "01:08:33", "text": "右？ええ、9時です。"}, {"type": "subtitle", "time": 4117.789, "timestamp": "01:08:37", "text": "それで、あなたは食事をしましたか？"}, {"type": "subtitle", "time": 4122.63, "timestamp": "01:08:42", "text": "えっと、私は食べ物を食べました。はい。いいね、いいね、"}, {"type": "subtitle", "time": 4128.55, "timestamp": "01:08:48", "text": "ニース。あなたは食べましたか？私は食べた、えっと、あなたを食べた"}, {"type": "subtitle", "time": 4131.669, "timestamp": "01:08:51", "text": "夕食のおやつだったと言えるけど、"}, {"type": "subtitle", "time": 4134.309, "timestamp": "01:08:54", "text": "昼食ではなく、夕食を食べたい気分だ。"}, {"type": "subtitle", "time": 4137.99, "timestamp": "01:08:57", "text": "私はいつもそれを失敗してしまうんです。えっと"}]
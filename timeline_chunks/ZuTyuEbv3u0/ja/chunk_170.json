[{"type": "subtitle", "time": 10200.42, "timestamp": "02:50:00", "text": "技術的な問題。"}, {"type": "subtitle", "time": 10208.71, "timestamp": "02:50:08", "text": "どうぞ。どうぞ。"}, {"type": "subtitle", "time": 10210.71, "timestamp": "02:50:10", "text": "私はただ、自分も同じ立場だと言っているだけです"}, {"type": "subtitle", "time": 10213.11, "timestamp": "02:50:13", "text": "あなたと同じように。"}, {"type": "subtitle", "time": 10223.51, "timestamp": "02:50:23", "text": "うん。そう、それは私のアイデアだったんだ"}, {"type": "subtitle", "time": 10226.07, "timestamp": "02:50:26", "text": "だって、チューブは今、高価だからね。"}, {"type": "subtitle", "time": 10229.429, "timestamp": "02:50:29", "text": "そして、私は決してやりたくなかった"}, {"type": "subtitle", "time": 10232.63, "timestamp": "02:50:32", "text": "こういうものって、えーっと"}, {"type": "chat", "time": 10234.864, "timestamp": "02:50:34", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "hello"}, {"type": "subtitle", "time": 10237.19, "timestamp": "02:50:37", "text": "このようなセットアップは、私が"}, {"type": "subtitle", "time": 10240.07, "timestamp": "02:50:40", "text": "チャンスだったけどうまくいかなかったし、"}, {"type": "subtitle", "time": 10242.389, "timestamp": "02:50:42", "text": "今それを持っていたらもったいないような気がした"}, {"type": "subtitle", "time": 10244.95, "timestamp": "02:50:44", "text": "これは本当に美味しい料理で、モデルで、"}, {"type": "subtitle", "time": 10247.51, "timestamp": "02:50:47", "text": "使用しない。それで私は「わかった、行くよ」と思った。"}, {"type": "subtitle", "time": 10251.75, "timestamp": "02:50:51", "text": "それを使って、それを実行してください。だから私は考えていた"}, {"type": "subtitle", "time": 10255.03, "timestamp": "02:50:55", "text": "ほぼ完璧にして、使うことができます"}, {"type": "subtitle", "time": 10257.99, "timestamp": "02:50:57", "text": "それら全てを少なくとも10年間は​​維持する。いいえ、"}]
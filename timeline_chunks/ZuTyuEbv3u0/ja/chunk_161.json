[{"type": "subtitle", "time": 9661.99, "timestamp": "02:41:01", "text": "アーカイブみたいなものは、そこにあったような感じだった"}, {"type": "subtitle", "time": 9664.51, "timestamp": "02:41:04", "text": "ずっと昔は"}, {"type": "subtitle", "time": 9669.59, "timestamp": "02:41:09", "text": "えっと、私は他の人がプレイしているのを見ました"}, {"type": "subtitle", "time": 9673.429, "timestamp": "02:41:13", "text": "彼らが「すぐ戻ります」と言うときのクリップが好きです。だから私は"}, {"type": "subtitle", "time": 9674.429, "timestamp": "02:41:14", "text": "まるで"}, {"type": "subtitle", "time": 9678.389, "timestamp": "02:41:18", "text": "ああ、クリップがないんだけど、"}, {"type": "subtitle", "time": 9680.83, "timestamp": "02:41:20", "text": "ランダムなビデオ"}, {"type": "subtitle", "time": 9685.03, "timestamp": "02:41:25", "text": "YouTube。だから私はどうにかして好きになれた"}, {"type": "subtitle", "time": 9687.71, "timestamp": "02:41:27", "text": "すべてを乗り越えて、"}, {"type": "subtitle", "time": 9690.79, "timestamp": "02:41:30", "text": "仕事。それから、ジョックマラソンの時に私は"}, {"type": "subtitle", "time": 9695.349, "timestamp": "02:41:35", "text": "もしかしたら、もっと良くできるかもしれない"}, {"type": "subtitle", "time": 9698.07, "timestamp": "02:41:38", "text": "ランダムなタイムスタンプではなく"}, {"type": "subtitle", "time": 9700.55, "timestamp": "02:41:40", "text": "ランダムなビデオをランダムに再生"}, {"type": "subtitle", "time": 9703.27, "timestamp": "02:41:43", "text": "タイムスタンプ。プレイリスト全体を作成できます"}, {"type": "subtitle", "time": 9706.309, "timestamp": "02:41:46", "text": "ランダム化された動画のようなものです。だからそれは"}, {"type": "subtitle", "time": 9709.51, "timestamp": "02:41:49", "text": "まるで、あなたが想像もしなかったようなあなたみたい"}, {"type": "subtitle", "time": 9712.79, "timestamp": "02:41:52", "text": "どんな動画がポップアップ表示されるか。だから、あなたは"}, {"type": "subtitle", "time": 9716.469, "timestamp": "02:41:56", "text": "懐かしい瞬間を味わおう。うん。だから私は"}, {"type": "subtitle", "time": 9719.03, "timestamp": "02:41:59", "text": "それに従った。唯一の理由は"}]
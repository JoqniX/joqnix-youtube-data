[{"type": "subtitle", "time": 13020.309, "timestamp": "03:37:00", "text": "わかった。しかし"}, {"type": "subtitle", "time": 13024.63, "timestamp": "03:37:04", "text": "私にとっては、例えば700"}, {"type": "subtitle", "time": 13029.59, "timestamp": "03:37:09", "text": "午後私は夕食を食べる。わかった。そして私は"}, {"type": "subtitle", "time": 13032.15, "timestamp": "03:37:12", "text": "5時頃までにお茶と軽食を用意する、といった感じ。"}, {"type": "subtitle", "time": 13034.95, "timestamp": "03:37:14", "text": "それからその間、あるいは例えば私が"}, {"type": "subtitle", "time": 13037.67, "timestamp": "03:37:17", "text": "4時までにお茶と軽食。だから5時と5時の間に、"}, {"type": "subtitle", "time": 13039.99, "timestamp": "03:37:19", "text": "6つですよね？だからその間に、例えば私が"}, {"type": "subtitle", "time": 13042.229, "timestamp": "03:37:22", "text": "ライムジュースか何か、"}, {"type": "subtitle", "time": 13045.11, "timestamp": "03:37:25", "text": "満杯、満杯。理由がわからない。そこから"}, {"type": "subtitle", "time": 13047.51, "timestamp": "03:37:27", "text": "ライムジュース１杯またはソフトドリンク１杯または"}, {"type": "subtitle", "time": 13049.75, "timestamp": "03:37:29", "text": "何か、私は満腹になり、こう思うでしょう"}, {"type": "subtitle", "time": 13052.15, "timestamp": "03:37:32", "text": "夕食を食べることができない。私は"}, {"type": "subtitle", "time": 13055.269, "timestamp": "03:37:35", "text": "スプーン1本は"}, {"type": "subtitle", "time": 13058.309, "timestamp": "03:37:38", "text": "スプーン半分。うん。つまり、あなたは理解しているということですね。"}, {"type": "subtitle", "time": 13060.469, "timestamp": "03:37:40", "text": "ほら、私もそういうのが好きなんです"}, {"type": "subtitle", "time": 13062.309, "timestamp": "03:37:42", "text": "同じ問題です。つまり、私の食事は基本的に"}, {"type": "subtitle", "time": 13064.469, "timestamp": "03:37:44", "text": "家にいるときに自転車に乗るのは不気味だ、"}, {"type": "subtitle", "time": 13066.95, "timestamp": "03:37:46", "text": "知る。私は午前11時に朝食を食べます。"}, {"type": "subtitle", "time": 13070.389, "timestamp": "03:37:50", "text": "午後4時に昼食を食べるなんて、一体どういうことだ。そして私の"}, {"type": "subtitle", "time": 13074.309, "timestamp": "03:37:54", "text": "夕食は午後11時頃。くそ。"}, {"type": "subtitle", "time": 13076.71, "timestamp": "03:37:56", "text": "ええ、これは私が"}, {"type": "subtitle", "time": 13079.67, "timestamp": "03:37:59", "text": "私の家はネイティブの仲間みたいだね、君は"}]
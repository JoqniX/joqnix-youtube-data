[{"type": "subtitle", "time": 14101.99, "timestamp": "03:55:01", "text": "えっと、今気づいたんだけど、2つしかないよ"}, {"type": "subtitle", "time": 14104.79, "timestamp": "03:55:04", "text": "あと何日かあるよね？いいえ、2つではなく3つです"}, {"type": "subtitle", "time": 14108.07, "timestamp": "03:55:08", "text": "3月から5月までの残り日数"}, {"type": "subtitle", "time": 14110.87, "timestamp": "03:55:10", "text": "終わり。うわぁ。さようなら。"}, {"type": "subtitle", "time": 14113.51, "timestamp": "03:55:13", "text": "はい。もうすぐ5月も終わりですね。"}, {"type": "subtitle", "time": 14115.87, "timestamp": "03:55:15", "text": "くそ。あと1ヶ月。"}, {"type": "subtitle", "time": 14117.269, "timestamp": "03:55:17", "text": "[音楽]"}, {"type": "subtitle", "time": 14119.91, "timestamp": "03:55:19", "text": "行きたくない。私はしたくない"}, {"type": "subtitle", "time": 14122.95, "timestamp": "03:55:22", "text": "残しておこう。でも、私はそうしなければならない。人生は続く"}, {"type": "subtitle", "time": 14125.83, "timestamp": "03:55:25", "text": "の上。"}, {"type": "subtitle", "time": 14132.95, "timestamp": "03:55:32", "text": "悲しい。でも、君が"}, {"type": "subtitle", "time": 14134.55, "timestamp": "03:55:34", "text": "ノートパソコンも全部持っています。すべて順調です。"}, {"type": "subtitle", "time": 14137.67, "timestamp": "03:55:37", "text": "いいえ、そちら側からの話です。そして私の終わりは"}, {"type": "subtitle", "time": 14139.59, "timestamp": "03:55:39", "text": "良い。協力してゲームをしよう"}, {"type": "subtitle", "time": 14143.03, "timestamp": "03:55:43", "text": "ああ、今度は私だけじゃない"}, {"type": "subtitle", "time": 14152.79, "timestamp": "03:55:52", "text": "ええ、私もノートパソコンが必要になりそうです。"}, {"type": "subtitle", "time": 14155.59, "timestamp": "03:55:55", "text": "良いものが手に入ることを願うよ。"}, {"type": "subtitle", "time": 14157.51, "timestamp": "03:55:57", "text": "しかし、それは日本の鍵となるでしょう"}, {"type": "subtitle", "time": 14159.189, "timestamp": "03:55:59", "text": "ノートパソコンには"}]
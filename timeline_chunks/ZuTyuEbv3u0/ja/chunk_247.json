[{"type": "subtitle", "time": 14820.229, "timestamp": "04:07:00", "text": "一般的に拾うことはできません"}, {"type": "subtitle", "time": 14822.309, "timestamp": "04:07:02", "text": "観客はもっと私が欲しいような"}, {"type": "subtitle", "time": 14824.389, "timestamp": "04:07:04", "text": "すでにこの分野に興味のある人たち"}, {"type": "subtitle", "time": 14826.63, "timestamp": "04:07:06", "text": "アニメチュービング云々"}, {"type": "subtitle", "time": 14828.99, "timestamp": "04:07:08", "text": "インターネット。"}, {"type": "subtitle", "time": 14832.87, "timestamp": "04:07:12", "text": "うん。そして、移転は難しいかもしれない"}, {"type": "subtitle", "time": 14835.91, "timestamp": "04:07:15", "text": "普通の人がvtubeの視聴者になる"}, {"type": "subtitle", "time": 14841.91, "timestamp": "04:07:21", "text": "いいですか、よく聞いてください。問題は"}, {"type": "subtitle", "time": 14844.15, "timestamp": "04:07:24", "text": "すでに好きな人たち"}, {"type": "subtitle", "time": 14847.349, "timestamp": "04:07:27", "text": "それらは大抵穏やかな"}, {"type": "subtitle", "time": 14848.269, "timestamp": "04:07:28", "text": "のように"}, {"type": "subtitle", "time": 14851.75, "timestamp": "04:07:31", "text": "そのことだけど、でも、"}, {"type": "subtitle", "time": 14853.309, "timestamp": "04:07:33", "text": "一般的なインターネットのように"}, {"type": "subtitle", "time": 14855.67, "timestamp": "04:07:35", "text": "インド人はまるで"}, {"type": "subtitle", "time": 14857.99, "timestamp": "04:07:37", "text": "混沌としている。"}, {"type": "subtitle", "time": 14860.389, "timestamp": "04:07:40", "text": "そうそう。ええ、特に"}, {"type": "subtitle", "time": 14865.99, "timestamp": "04:07:45", "text": "そう、だから怖くてできないんだ"}, {"type": "subtitle", "time": 14868.229, "timestamp": "04:07:48", "text": "ローカルコンテンツを作って"}, {"type": "subtitle", "time": 14870.07, "timestamp": "04:07:50", "text": "もの。"}, {"type": "subtitle", "time": 14873.11, "timestamp": "04:07:53", "text": "ええ、それと、これもあります"}, {"type": "subtitle", "time": 14875.83, "timestamp": "04:07:55", "text": "色の識別、ランダムなものもある"}, {"type": "subtitle", "time": 14878.51, "timestamp": "04:07:58", "text": "インド出身の人も同じように"}]
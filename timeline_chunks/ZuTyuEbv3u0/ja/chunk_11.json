[{"type": "subtitle", "time": 662.71, "timestamp": "00:11:02", "text": "ねえ、ジャンプ大会の招待状が届いたよ。"}, {"type": "subtitle", "time": 665.91, "timestamp": "00:11:05", "text": "いいえ、でも私も一緒に参加したいです。"}, {"type": "subtitle", "time": 668.79, "timestamp": "00:11:08", "text": "待って、ゲームが終了しちゃった。何てことだ、"}, {"type": "subtitle", "time": 671.509, "timestamp": "00:11:11", "text": "ゲームがクラッシュしました。私はあなたを受け入れました"}, {"type": "subtitle", "time": 673.63, "timestamp": "00:11:13", "text": "ゲームへの招待。私"}, {"type": "subtitle", "time": 677.75, "timestamp": "00:11:17", "text": "墜落しました。クソじゃない。大丈夫。私にさせて"}, {"type": "subtitle", "time": 679.99, "timestamp": "00:11:19", "text": "起動してください。"}, {"type": "subtitle", "time": 682.71, "timestamp": "00:11:22", "text": "待って、夕食はもう食べた？"}, {"type": "subtitle", "time": 684.43, "timestamp": "00:11:24", "text": "はい、私は"}, {"type": "subtitle", "time": 688.79, "timestamp": "00:11:28", "text": "殺された。私はしませんでした。"}, {"type": "subtitle", "time": 710.47, "timestamp": "00:11:50", "text": "わかった。何てことだ。あの巨漢が来た。"}, {"type": "subtitle", "time": 712.829, "timestamp": "00:11:52", "text": "私はある意味、"}]
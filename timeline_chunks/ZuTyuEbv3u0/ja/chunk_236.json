[{"type": "subtitle", "time": 14161.67, "timestamp": "03:56:01", "text": "日本語キーボードになりました。"}, {"type": "subtitle", "time": 14165.87, "timestamp": "03:56:05", "text": "ああ、それなら実際に回復できるかもしれない"}, {"type": "subtitle", "time": 14168.83, "timestamp": "03:56:08", "text": "全体。何てことだ。"}, {"type": "subtitle", "time": 14172.55, "timestamp": "03:56:12", "text": "ああ、すべて日本語で、"}, {"type": "subtitle", "time": 14175.189, "timestamp": "03:56:15", "text": "英語の瞬間。 O"}, {"type": "subtitle", "time": 14177.349, "timestamp": "03:56:17", "text": "おそらく、より良い選択肢は"}, {"type": "subtitle", "time": 14179.91, "timestamp": "03:56:19", "text": "誰かが買ってくれると思う"}, {"type": "subtitle", "time": 14182.229, "timestamp": "03:56:22", "text": "ここに置いて、それからおそらく"}, {"type": "subtitle", "time": 14183.67, "timestamp": "03:56:23", "text": "中には、"}, {"type": "subtitle", "time": 14192.389, "timestamp": "03:56:32", "text": "えっと、もしかしたら、もしかしたら、"}, {"type": "subtitle", "time": 14194.309, "timestamp": "03:56:34", "text": "英語キーボードのあるものを見つけてください。"}, {"type": "subtitle", "time": 14197.63, "timestamp": "03:56:37", "text": "日本はおそらく知っているだろう"}, {"type": "subtitle", "time": 14201.11, "timestamp": "03:56:41", "text": "ええ、企業は生産するかもしれません"}, {"type": "subtitle", "time": 14204.229, "timestamp": "03:56:44", "text": "1つ。うん。"}, {"type": "subtitle", "time": 14206.469, "timestamp": "03:56:46", "text": "しかし、ここで私が思うのは、"}, {"type": "subtitle", "time": 14208.15, "timestamp": "03:56:48", "text": "彼らは、そういうことはある意味"}, {"type": "subtitle", "time": 14209.99, "timestamp": "03:56:49", "text": "少し高価だ。"}, {"type": "subtitle", "time": 14217.83, "timestamp": "03:56:57", "text": "日本では誰もが"}]
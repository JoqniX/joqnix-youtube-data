[{"type": "subtitle", "time": 374.87, "timestamp": "00:06:14", "text": "えっと、私は何者？私にさせて"}, {"type": "subtitle", "time": 386.11, "timestamp": "00:06:26", "text": "ここから出て、あなたのところへ行くために"}, {"type": "subtitle", "time": 388.629, "timestamp": "00:06:28", "text": "世界。持続する。塔へ行かせてください"}, {"type": "subtitle", "time": 402.629, "timestamp": "00:06:42", "text": "死ぬ。わかった。あなたは死ぬ。私はただ転んだだけです"}, {"type": "subtitle", "time": 410.55, "timestamp": "00:06:50", "text": "ロック。ねえ、私は手に入れているよ。うん、私は手に入れているよ。"}, {"type": "subtitle", "time": 414.15, "timestamp": "00:06:54", "text": "貝殻みたいなやつ。それで、"}, {"type": "subtitle", "time": 416.87, "timestamp": "00:06:56", "text": "ああ、神様。では、待ってください。もし私が"}, {"type": "subtitle", "time": 418.909, "timestamp": "00:06:58", "text": "こちらの貝殻"}]
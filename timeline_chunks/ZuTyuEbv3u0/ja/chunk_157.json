[{"type": "subtitle", "time": 9420.55, "timestamp": "02:37:00", "text": "こする。"}, {"type": "subtitle", "time": 9422.23, "timestamp": "02:37:02", "text": "それは良い。それは良い。いいね"}, {"type": "subtitle", "time": 9424.309, "timestamp": "02:37:04", "text": "ナズキとディノは私が話しているように"}, {"type": "subtitle", "time": 9426.63, "timestamp": "02:37:06", "text": "最近、こういうのが好きな人がたくさんいる"}, {"type": "subtitle", "time": 9437.03, "timestamp": "02:37:17", "text": "昔は"}, {"type": "subtitle", "time": 9438.19, "timestamp": "02:37:18", "text": "何か。"}, {"type": "subtitle", "time": 9440.95, "timestamp": "02:37:20", "text": "いいえ。"}, {"type": "subtitle", "time": 9445.75, "timestamp": "02:37:25", "text": "IMV2 のこのコミュニティは今ではどうなっているのでしょうか？"}, {"type": "subtitle", "time": 9448.389, "timestamp": "02:37:28", "text": "つまり、新しいものをたくさん見かけるってこと"}, {"type": "subtitle", "time": 9449.469, "timestamp": "02:37:29", "text": "人々が来る"}, {"type": "subtitle", "time": 9453.11, "timestamp": "02:37:33", "text": "エネルギーに満ち溢れていて、そう思う"}, {"type": "subtitle", "time": 9455.349, "timestamp": "02:37:35", "text": "私はただ彼ら全員をサポートする必要があるので"}, {"type": "subtitle", "time": 9456.95, "timestamp": "02:37:36", "text": "彼らはエネルギーを維持し続けるだろう"}, {"type": "subtitle", "time": 9458.37, "timestamp": "02:37:38", "text": "ストリーミング配信。"}, {"type": "subtitle", "time": 9466.309, "timestamp": "02:37:46", "text": "ええ、彼らも話すのが好きなんですよ。"}, {"type": "subtitle", "time": 9467.59, "timestamp": "02:37:47", "text": "ほとんどが"}, {"type": "subtitle", "time": 9469.99, "timestamp": "02:37:49", "text": "ヒンディー語のユーチューバーたちは、まだお金を使って"}, {"type": "subtitle", "time": 9471.59, "timestamp": "02:37:51", "text": "彼らの時間、ほら、"}, {"type": "subtitle", "time": 9473.19, "timestamp": "02:37:53", "text": "コミュニケーションとは、"}, {"type": "subtitle", "time": 9475.67, "timestamp": "02:37:55", "text": "次は私の番だ。それはとても素敵です"}, {"type": "subtitle", "time": 9478.19, "timestamp": "02:37:58", "text": "彼らのうちの。うん。うん。うん。確かに、確かに、"}]
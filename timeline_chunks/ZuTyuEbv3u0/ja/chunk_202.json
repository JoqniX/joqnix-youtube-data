[{"type": "subtitle", "time": 12120.469, "timestamp": "03:22:00", "text": "取引が簡単すぎる、あるいは難しすぎる。しかしそれは"}, {"type": "subtitle", "time": 12122.469, "timestamp": "03:22:02", "text": "扱いやすい、といった感じ。"}, {"type": "subtitle", "time": 12129.83, "timestamp": "03:22:09", "text": "管理可能。でも、もし私が行けたら"}, {"type": "subtitle", "time": 12137.03, "timestamp": "03:22:17", "text": "あ、待って。待って。それができなくなる頃には"}, {"type": "subtitle", "time": 12143.91, "timestamp": "03:22:23", "text": "そうそう。だから、えーと、君は行くつもりだから"}, {"type": "subtitle", "time": 12146.15, "timestamp": "03:22:26", "text": "外出中に戻ってきますか？"}, {"type": "subtitle", "time": 12149.91, "timestamp": "03:22:29", "text": "休暇か何か？私は試してみます"}, {"type": "subtitle", "time": 12153.03, "timestamp": "03:22:33", "text": "戻ってくる。はい。はい。まるでそれが"}, {"type": "subtitle", "time": 12154.95, "timestamp": "03:22:34", "text": "1ヶ月か1ヶ月半くらい"}, {"type": "subtitle", "time": 12157.349, "timestamp": "03:22:37", "text": "1ヶ月間、なぜなら私は"}, {"type": "subtitle", "time": 12159.51, "timestamp": "03:22:39", "text": "学位を取得する。いいえ。私は行きます"}, {"type": "subtitle", "time": 12162.309, "timestamp": "03:22:42", "text": "3年目をきちんとこなさずに"}, {"type": "subtitle", "time": 12164.469, "timestamp": "03:22:44", "text": "なぜなら私は"}, {"type": "subtitle", "time": 12166.19, "timestamp": "03:22:46", "text": "3年目"}, {"type": "subtitle", "time": 12169.51, "timestamp": "03:22:49", "text": "今は書類のことは無視してください。兄弟、私は"}, {"type": "subtitle", "time": 12171.429, "timestamp": "03:22:51", "text": "研究した"}, {"type": "subtitle", "time": 12172.87, "timestamp": "03:22:52", "text": "バックログ。"}, {"type": "subtitle", "time": 12174.15, "timestamp": "03:22:54", "text": "[音楽]"}, {"type": "subtitle", "time": 12177.11, "timestamp": "03:22:57", "text": "私がいくつ持っているか当ててみてください。幾つか？"}]
[{"type": "subtitle", "time": 6180.229, "timestamp": "01:43:00", "text": "ああ、このナッツ。はぁ？待って、今あなたは"}, {"type": "subtitle", "time": 6183.27, "timestamp": "01:43:03", "text": "ああ、まさかそんなことをするなんて。あなた"}, {"type": "subtitle", "time": 6214.149, "timestamp": "01:43:34", "text": "[音楽]"}, {"type": "subtitle", "time": 6215.55, "timestamp": "01:43:35", "text": "私は試みていました"}, {"type": "subtitle", "time": 6219.59, "timestamp": "01:43:39", "text": "まるで、私は"}, {"type": "subtitle", "time": 6227.79, "timestamp": "01:43:47", "text": "遅延はどのくらいありますか"}]
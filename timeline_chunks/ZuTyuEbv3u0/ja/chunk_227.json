[{"type": "subtitle", "time": 13623.269, "timestamp": "03:47:03", "text": "あの忌々しいやつ。はい。そう、それだ。うん。"}, {"type": "subtitle", "time": 13628.389, "timestamp": "03:47:08", "text": "ええ、そうですね。ダムが建設された時。"}, {"type": "subtitle", "time": 13630.229, "timestamp": "03:47:10", "text": "髭を剃っておいて本当に良かった。何もない"}, {"type": "subtitle", "time": 13632.87, "timestamp": "03:47:12", "text": "ここで起きた出来事です。私は楽しんでいるようでした"}, {"type": "subtitle", "time": 13635.71, "timestamp": "03:47:15", "text": "休日だから、ない"}, {"type": "subtitle", "time": 13639.11, "timestamp": "03:47:19", "text": "クラス。でも、そう、でも、ほとんどの"}, {"type": "subtitle", "time": 13641.189, "timestamp": "03:47:21", "text": "友人やクラスメートの家が"}, {"type": "subtitle", "time": 13644.03, "timestamp": "03:47:24", "text": "洪水とか、そういう感じですよね？"}, {"type": "subtitle", "time": 13646.95, "timestamp": "03:47:26", "text": "そして、今はそれが起こらないことをただ願うばかりです"}, {"type": "subtitle", "time": 13649.91, "timestamp": "03:47:29", "text": "私が旅行に行くときとか。あなた"}, {"type": "subtitle", "time": 13652.63, "timestamp": "03:47:32", "text": "クラスメートが家にいるところを想像してみて"}, {"type": "subtitle", "time": 13654.229, "timestamp": "03:47:34", "text": "フラッターのところで、あなたはあちらにいます"}, {"type": "subtitle", "time": 13665.349, "timestamp": "03:47:45", "text": "何てことだ。日本のチキンカレー。私"}, {"type": "subtitle", "time": 13669.03, "timestamp": "03:47:49", "text": "どんな感じなのか気になる。そうはならないと思う"}, {"type": "subtitle", "time": 13672.469, "timestamp": "03:47:52", "text": "インド人が好きだけど、それでも。"}, {"type": "subtitle", "time": 13675.269, "timestamp": "03:47:55", "text": "私はかなり確信していると思います"}, {"type": "subtitle", "time": 13678.63, "timestamp": "03:47:58", "text": "伝説のスパイスみたいになるよ"}]
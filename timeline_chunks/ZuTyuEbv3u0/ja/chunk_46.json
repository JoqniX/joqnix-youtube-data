[{"type": "subtitle", "time": 2763.19, "timestamp": "00:46:03", "text": "だから、食べられる限り、"}, {"type": "subtitle", "time": 2765.67, "timestamp": "00:46:05", "text": "いいものだよ。"}, {"type": "subtitle", "time": 2769.109, "timestamp": "00:46:09", "text": "私は食べるのが嫌いじゃないと思う"}, {"type": "subtitle", "time": 2771.03, "timestamp": "00:46:11", "text": "ビリヤニとか、そういう類のもの全部"}, {"type": "subtitle", "time": 2772.87, "timestamp": "00:46:12", "text": "食品。"}, {"type": "subtitle", "time": 2775.43, "timestamp": "00:46:15", "text": "テキーラ、君はどう思う？"}, {"type": "subtitle", "time": 2783.309, "timestamp": "00:46:23", "text": "私は昔好きだった"}, {"type": "subtitle", "time": 2787.19, "timestamp": "00:46:27", "text": "えっと、あれは何て言うんですか？何何何何"}, {"type": "subtitle", "time": 2790.87, "timestamp": "00:46:30", "text": "その食べ物は何という名前ですか？引き上げてください。うん、引っ張って"}, {"type": "subtitle", "time": 2794.71, "timestamp": "00:46:34", "text": "オフ。でも、そうだけど、今は"}, {"type": "subtitle", "time": 2796.309, "timestamp": "00:46:36", "text": "あまり好きではないと思う。のように"}, {"type": "subtitle", "time": 2801.03, "timestamp": "00:46:41", "text": "今はまだ食事に慣れている最中です。"}, {"type": "subtitle", "time": 2804.63, "timestamp": "00:46:44", "text": "だから、今はモモが好きなんです。モモはとても"}, {"type": "subtitle", "time": 2807.43, "timestamp": "00:46:47", "text": "良い。"}, {"type": "subtitle", "time": 2809.95, "timestamp": "00:46:49", "text": "モモ、とても"}, {"type": "subtitle", "time": 2812.79, "timestamp": "00:46:52", "text": "柔らかく、熱く、"}, {"type": "subtitle", "time": 2817.589, "timestamp": "00:46:57", "text": "ふっくらしていて、ほら、可愛いでしょ。うん。そして私は"}, {"type": "subtitle", "time": 2819.91, "timestamp": "00:46:59", "text": "モモが"}]
[{"type": "subtitle", "time": 13143.19, "timestamp": "03:39:03", "text": "49kg"}, {"type": "subtitle", "time": 13145.269, "timestamp": "03:39:05", "text": "でも大学卒業後はほとんど"}, {"type": "subtitle", "time": 13146.79, "timestamp": "03:39:06", "text": "重さを測るけど、"}, {"type": "subtitle", "time": 13149.51, "timestamp": "03:39:09", "text": "体重が4～5キロくらい減った。"}, {"type": "subtitle", "time": 13153.03, "timestamp": "03:39:13", "text": "45歳、以前は36歳か何かだった。"}, {"type": "subtitle", "time": 13158.87, "timestamp": "03:39:18", "text": "待つというのは、10代の頃か"}, {"type": "subtitle", "time": 13163.429, "timestamp": "03:39:23", "text": "若い成人または昨年の頃"}, {"type": "subtitle", "time": 13166.469, "timestamp": "03:39:26", "text": "去年かその頃"}, {"type": "subtitle", "time": 13170.229, "timestamp": "03:39:30", "text": "私たちが会った時、あるいは2022年頃だったかな"}, {"type": "subtitle", "time": 13175.11, "timestamp": "03:39:35", "text": "2023年当時、気温は約35度だった。"}, {"type": "subtitle", "time": 13181.75, "timestamp": "03:39:41", "text": "私自身も、より良い人生を送ったと感じています"}, {"type": "subtitle", "time": 13187.87, "timestamp": "03:39:47", "text": "私はしません"}, {"type": "subtitle", "time": 13190.389, "timestamp": "03:39:50", "text": "人々がどう反応したのか気になっている"}, {"type": "subtitle", "time": 13193.83, "timestamp": "03:39:53", "text": "ポニーのコミックで会いましょう"}, {"type": "subtitle", "time": 13196.79, "timestamp": "03:39:56", "text": "私はとても"}]
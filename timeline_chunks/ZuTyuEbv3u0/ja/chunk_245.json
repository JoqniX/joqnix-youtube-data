[{"type": "subtitle", "time": 14701.11, "timestamp": "04:05:01", "text": "私は、どうしてこんなにたくさんの人を招待してしまったんだろうと思った。"}, {"type": "subtitle", "time": 14705.269, "timestamp": "04:05:05", "text": "以前に招待イベントに参加した人はいますか？"}, {"type": "subtitle", "time": 14707.99, "timestamp": "04:05:07", "text": "ああ、そうですね、それは理解できます。うん、"}, {"type": "subtitle", "time": 14710.55, "timestamp": "04:05:10", "text": "毎日、あるいは毎日ではないけれど、"}, {"type": "subtitle", "time": 14713.229, "timestamp": "04:05:13", "text": "毎日、私たちが見るたびに、"}, {"type": "subtitle", "time": 14716.469, "timestamp": "04:05:16", "text": "新しいユーチューバーとインドのユーチューバー"}, {"type": "subtitle", "time": 14718.87, "timestamp": "04:05:18", "text": "彼らに言及させようとした"}, {"type": "subtitle", "time": 14722.55, "timestamp": "04:05:22", "text": "地域社会は友人を作ることができる。"}, {"type": "subtitle", "time": 14724.469, "timestamp": "04:05:24", "text": "うん。"}, {"type": "subtitle", "time": 14727.349, "timestamp": "04:05:27", "text": "たくさんのこと。うん。私は思う"}, {"type": "subtitle", "time": 14729.75, "timestamp": "04:05:29", "text": "一方、止めているのは"}, {"type": "subtitle", "time": 14732.07, "timestamp": "04:05:32", "text": "私が連絡を取れないのは言語の壁があるからです"}, {"type": "subtitle", "time": 14734.63, "timestamp": "04:05:34", "text": "そして2つ目は、ただただそうなりたいだけです"}, {"type": "subtitle", "time": 14736.15, "timestamp": "04:05:36", "text": "以前はプロのストリーマーだった"}, {"type": "subtitle", "time": 14739.11, "timestamp": "04:05:39", "text": "人々に近づく。"}, {"type": "subtitle", "time": 14742.55, "timestamp": "04:05:42", "text": "本当に、本当に、言葉も何もかも。右"}, {"type": "subtitle", "time": 14744.55, "timestamp": "04:05:44", "text": "今はOBSをセットアップしたばかりです"}, {"type": "subtitle", "time": 14746.95, "timestamp": "04:05:46", "text": "そして簡単なサムネイルを作成して"}, {"type": "subtitle", "time": 14750.229, "timestamp": "04:05:50", "text": "ストリーミングを開始する"}, {"type": "subtitle", "time": 14753.75, "timestamp": "04:05:53", "text": "ボタン。でも、未来のことだよ"}, {"type": "subtitle", "time": 14756.15, "timestamp": "04:05:56", "text": "適切なオーバーレイがあるのが好きではないし、"}, {"type": "subtitle", "time": 14757.91, "timestamp": "04:05:57", "text": "ロード画面のような適切な"}]
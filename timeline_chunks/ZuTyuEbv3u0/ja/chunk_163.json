[{"type": "subtitle", "time": 9782.95, "timestamp": "02:43:02", "text": "良い。だから私はこう思った、それで私はこう思った"}, {"type": "subtitle", "time": 9786.63, "timestamp": "02:43:06", "text": "私はそれを受け取ります、私はそれを受け取ります、そして"}, {"type": "subtitle", "time": 9790.55, "timestamp": "02:43:10", "text": "自分でやるよ。だから私は順番に"}, {"type": "subtitle", "time": 9793.59, "timestamp": "02:43:13", "text": "そのモデルを使うには、今、支払いをしなければならない"}, {"type": "subtitle", "time": 9796.07, "timestamp": "02:43:16", "text": "それについても。さらに、私は資金を調達しなければなりません"}, {"type": "subtitle", "time": 9798.389, "timestamp": "02:43:18", "text": "索具とか、その他諸々。"}, {"type": "subtitle", "time": 9802.79, "timestamp": "02:43:22", "text": "うん。ええ、うまくいきませんでした。だから私は"}, {"type": "subtitle", "time": 9805.03, "timestamp": "02:43:25", "text": "「ああ、じゃあジャタタンをやろう」って感じだった。"}, {"type": "subtitle", "time": 9807.03, "timestamp": "02:43:27", "text": "それは膨大な量だ。それは不可能だ。"}, {"type": "subtitle", "time": 9809.429, "timestamp": "02:43:29", "text": "たとえうまくいかなくても、私はただ"}, {"type": "subtitle", "time": 9812.389, "timestamp": "02:43:32", "text": "やってください、なぜなら、たくさんの側面があるからです"}, {"type": "subtitle", "time": 9815.67, "timestamp": "02:43:35", "text": "目標。いいえ、YouTube の何ですか、そして"}, {"type": "subtitle", "time": 9819.63, "timestamp": "02:43:39", "text": "それは、それが終わった、それが"}, {"type": "subtitle", "time": 9823.51, "timestamp": "02:43:43", "text": "達成しました、そして私は"}, {"type": "subtitle", "time": 9825.269, "timestamp": "02:43:45", "text": "コラージュを作ってみんなと遊んで"}, {"type": "subtitle", "time": 9827.429, "timestamp": "02:43:47", "text": "それも達成されつつある"}, {"type": "subtitle", "time": 9829.67, "timestamp": "02:43:49", "text": "達成"}, {"type": "subtitle", "time": 9832.71, "timestamp": "02:43:52", "text": "そして、私がストリーミングしなかったから、私は"}, {"type": "subtitle", "time": 9834.87, "timestamp": "02:43:54", "text": "昨年は休止期間が長かった"}, {"type": "subtitle", "time": 9837.349, "timestamp": "02:43:57", "text": "年。もっと配信できて嬉しいです"}]
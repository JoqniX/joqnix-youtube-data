[{"type": "subtitle", "time": 8702.63, "timestamp": "02:25:02", "text": "ビープ音とかそういうの、つまりIRの人たち"}, {"type": "subtitle", "time": 8707.99, "timestamp": "02:25:07", "text": "そして、それから、そこに何度も来てください。ああ"}, {"type": "subtitle", "time": 8709.83, "timestamp": "02:25:09", "text": "あなたは自分自身を切り離したかったのです。わかった。"}, {"type": "subtitle", "time": 8711.67, "timestamp": "02:25:11", "text": "わかった。わかった。うん。それは"}, {"type": "subtitle", "time": 8714.55, "timestamp": "02:25:14", "text": "たくさん話したり、いろいろあったり。その後"}, {"type": "subtitle", "time": 8717.67, "timestamp": "02:25:17", "text": "もう一つは、私がちょうど"}, {"type": "subtitle", "time": 8719.349, "timestamp": "02:25:19", "text": "私の母国語の解説のように"}, {"type": "subtitle", "time": 8721.67, "timestamp": "02:25:21", "text": "YouTuberみたいなやつ。つまり"}, {"type": "subtitle", "time": 8724.07, "timestamp": "02:25:24", "text": "そう、あなたを好きな人たちが"}, {"type": "subtitle", "time": 8726.15, "timestamp": "02:25:26", "text": "向こう側から私を見つけた"}, {"type": "subtitle", "time": 8740.07, "timestamp": "02:25:40", "text": "ええ、私が手に入れた頃には"}, {"type": "subtitle", "time": 8741.51, "timestamp": "02:25:41", "text": "ノートパソコン、いいタイミングだと思った"}, {"type": "subtitle", "time": 8748.469, "timestamp": "02:25:48", "text": "面白いことに、他のみんなは"}, {"type": "subtitle", "time": 8751.429, "timestamp": "02:25:51", "text": "現実世界では、あなたは新しいYouTuberと見なされています"}, {"type": "subtitle", "time": 8754.469, "timestamp": "02:25:54", "text": "あなたは創業当時からここにいますね。"}, {"type": "subtitle", "time": 8757.75, "timestamp": "02:25:57", "text": "つまり、私は、小さな人みんなが"}, {"type": "subtitle", "time": 8758.87, "timestamp": "02:25:58", "text": "ほぼ確信している、ほとんどの人が"}]
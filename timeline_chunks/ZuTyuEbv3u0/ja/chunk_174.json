[{"type": "subtitle", "time": 10442.389, "timestamp": "02:54:02", "text": "そして私はただ仕事を探しに行くだけです"}, {"type": "subtitle", "time": 10448.269, "timestamp": "02:54:08", "text": "つまり"}, {"type": "subtitle", "time": 10466.63, "timestamp": "02:54:26", "text": "うん。"}, {"type": "subtitle", "time": 10468.75, "timestamp": "02:54:28", "text": "えっと、もし私が"}, {"type": "subtitle", "time": 10471.19, "timestamp": "02:54:31", "text": "君はホラーが得意だったことを覚えてる？"}, {"type": "subtitle", "time": 10473.429, "timestamp": "02:54:33", "text": "ゲームですよね？あなたはホラーゲームが好きですか？"}, {"type": "subtitle", "time": 10474.389, "timestamp": "02:54:34", "text": "右？"}, {"type": "subtitle", "time": 10478.349, "timestamp": "02:54:38", "text": "正直、このゲームは好きじゃない。でも私は"}, {"type": "subtitle", "time": 10481.33, "timestamp": "02:54:41", "text": "ラジオのようなマルチプレイヤーが好きです。"}, {"type": "subtitle", "time": 10488.349, "timestamp": "02:54:48", "text": "[音楽]"}, {"type": "subtitle", "time": 10493.51, "timestamp": "02:54:53", "text": "うん。そして、私たちの最初の大きな"}, {"type": "subtitle", "time": 10495.47, "timestamp": "02:54:55", "text": "コラボレーション"}, {"type": "subtitle", "time": 10496.75, "timestamp": "02:54:56", "text": "[音楽]"}]
[{"type": "subtitle", "time": 1981.19, "timestamp": "00:33:01", "text": "もの。でも、ほら、それよりも"}, {"type": "subtitle", "time": 1984.389, "timestamp": "00:33:04", "text": "ルームメイトを2人迎えるなんて"}, {"type": "subtitle", "time": 1986.07, "timestamp": "00:33:06", "text": "1つの部屋に人がいたら、実際に"}, {"type": "subtitle", "time": 1988.71, "timestamp": "00:33:08", "text": "アパートのような共有型"}, {"type": "subtitle", "time": 1991.669, "timestamp": "00:33:11", "text": "代わりに2部屋あるアパートと"}, {"type": "subtitle", "time": 1993.99, "timestamp": "00:33:13", "text": "男たちはお金を入れて支払うことができる、"}, {"type": "subtitle", "time": 1998.789, "timestamp": "00:33:18", "text": "右？それも五分五分の確率ですね。おお、"}, {"type": "subtitle", "time": 2001.19, "timestamp": "00:33:21", "text": "そしてあなたはプライバシーを持ち、"}, {"type": "subtitle", "time": 2002.789, "timestamp": "00:33:22", "text": "人はプライバシーを持ち、"}, {"type": "chat", "time": 2004.474, "timestamp": "00:33:24", "author": "@calx_nyx", "avatar": "https://yt4.ggpht.com/XFPadkBWV-wDHemIdJAJ0ZlOnQHzuQJq3X3CrTt0JO7prEc9g-uiFft4EJRfG-ZfPUNyuCkI=s64-c-k-c0x00ffffff-no-rj", "message": "yeah you gotta check that since I have four roommates and I can't stream in peace-"}, {"type": "subtitle", "time": 2004.63, "timestamp": "00:33:24", "text": "男性はおそらくスペースがあるでしょう"}, {"type": "subtitle", "time": 2008.509, "timestamp": "00:33:28", "text": "一緒に何かをする、みたいな。料理して"}, {"type": "subtitle", "time": 2012.07, "timestamp": "00:33:32", "text": "もの。うん。だって今までこんなのなかったんだもん"}, {"type": "subtitle", "time": 2015.99, "timestamp": "00:33:35", "text": "独立した弧。いや、私は「えっと、何？」って感じだった"}, {"type": "subtitle", "time": 2017.31, "timestamp": "00:33:37", "text": "あなたはそれを何と呼びますか？"}, {"type": "subtitle", "time": 2020.549, "timestamp": "00:33:40", "text": "えっと、私は、えっと、それを、えっと、から考えていました"}, {"type": "subtitle", "time": 2022.47, "timestamp": "00:33:42", "text": "アニメとかで知った限りでは、"}, {"type": "subtitle", "time": 2024.909, "timestamp": "00:33:44", "text": "ほら、あなたのために夕食を作る"}, {"type": "subtitle", "time": 2028.47, "timestamp": "00:33:48", "text": "ルームメイトとか、そういう類のこと全部。そうすれば、もしかしたら"}, {"type": "subtitle", "time": 2030.23, "timestamp": "00:33:50", "text": "君たちは良い友達だから、引っ張って"}, {"type": "subtitle", "time": 2033.59, "timestamp": "00:33:53", "text": "夜は枕投げとかして遊ぶ。"}, {"type": "subtitle", "time": 2035.669, "timestamp": "00:33:55", "text": "君ならきっとうまくいくよ。ただ、"}, {"type": "subtitle", "time": 2038.389, "timestamp": "00:33:58", "text": "知ってるよ、君が本当に良いものを手に入れることを願ってるよ"}]
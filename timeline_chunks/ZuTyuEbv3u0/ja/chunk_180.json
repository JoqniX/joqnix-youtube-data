[{"type": "subtitle", "time": 10802.469, "timestamp": "03:00:02", "text": "うん。あなたは彼と話しますか？"}, {"type": "subtitle", "time": 10804.95, "timestamp": "03:00:04", "text": "えっと、つまり、話そうとしたわけじゃなくて、"}, {"type": "subtitle", "time": 10806.95, "timestamp": "03:00:06", "text": "数秒で送ってくれる"}, {"type": "subtitle", "time": 10809.269, "timestamp": "03:00:09", "text": "インスタグラム。"}, {"type": "subtitle", "time": 10818.59, "timestamp": "03:00:18", "text": "[音楽]"}, {"type": "subtitle", "time": 10828.71, "timestamp": "03:00:28", "text": "私たちを止めた人はたくさんいます"}, {"type": "subtitle", "time": 10832.309, "timestamp": "03:00:32", "text": "チューブは、"}, {"type": "subtitle", "time": 10835.83, "timestamp": "03:00:35", "text": "ええ、止まっていません"}, {"type": "subtitle", "time": 10838.389, "timestamp": "03:00:38", "text": "こんなにたくさんの人がいるなんて悲しい"}, {"type": "subtitle", "time": 10840.83, "timestamp": "03:00:40", "text": "彼らはそこにいた。私はまだ"}, {"type": "subtitle", "time": 10843.469, "timestamp": "03:00:43", "text": "ミスマン。それはとても"}, {"type": "subtitle", "time": 10845.07, "timestamp": "03:00:45", "text": "面白い。"}, {"type": "subtitle", "time": 10849.429, "timestamp": "03:00:49", "text": "Our kto kami。"}, {"type": "subtitle", "time": 10852.71, "timestamp": "03:00:52", "text": "つまり、旅行に行くかもしれないので、それを送るつもりです"}]
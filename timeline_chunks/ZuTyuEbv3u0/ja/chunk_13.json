[{"type": "subtitle", "time": 780.15, "timestamp": "00:13:00", "text": "スマッシュ野郎どもはただ殺すのが好きなんだ"}, {"type": "subtitle", "time": 798.31, "timestamp": "00:13:18", "text": "私はまるで、まるで、すごく"}, {"type": "subtitle", "time": 804.71, "timestamp": "00:13:24", "text": "ああ。ああ、まるで泡立てているみたい。私はしません"}, {"type": "subtitle", "time": 807.79, "timestamp": "00:13:27", "text": "やり方は知っているけれど。"}, {"type": "subtitle", "time": 812.03, "timestamp": "00:13:32", "text": "それで、どうやって私と一緒に参加できたのですか？"}, {"type": "subtitle", "time": 814.11, "timestamp": "00:13:34", "text": "また？"}, {"type": "subtitle", "time": 822.55, "timestamp": "00:13:42", "text": "現在のクエストの継続は"}, {"type": "subtitle", "time": 823.629, "timestamp": "00:13:43", "text": "救われる。"}, {"type": "subtitle", "time": 826.87, "timestamp": "00:13:46", "text": "わかった。わかった。通常通り保存されます。は"}, {"type": "subtitle", "time": 828.389, "timestamp": "00:13:48", "text": "本当に他のプレイヤーと一緒にプレイしたいですか？"}, {"type": "subtitle", "time": 830.43, "timestamp": "00:13:50", "text": "ゲームセッション？"}, {"type": "subtitle", "time": 838.15, "timestamp": "00:13:58", "text": "誰が無事なの？待って。何かが起こっている。"}]
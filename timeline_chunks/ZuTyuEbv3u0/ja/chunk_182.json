[{"type": "subtitle", "time": 10921.269, "timestamp": "03:02:01", "text": "うん。"}, {"type": "subtitle", "time": 10923.23, "timestamp": "03:02:03", "text": "いつ"}, {"type": "subtitle", "time": 10925.469, "timestamp": "03:02:05", "text": "えっと、いつ、いつ"}, {"type": "subtitle", "time": 10930.23, "timestamp": "03:02:10", "text": "えーと、スミはデビューしたよね、覚えてる？"}, {"type": "subtitle", "time": 10932.79, "timestamp": "03:02:12", "text": "みんなが「うん、手に入れたよ」って言ってたのを覚えてる"}, {"type": "subtitle", "time": 10939.83, "timestamp": "03:02:19", "text": "つまり、両方ともあなただということです"}, {"type": "subtitle", "time": 10946.469, "timestamp": "03:02:26", "text": "いや、つまり両方とも"}, {"type": "subtitle", "time": 10961.91, "timestamp": "03:02:41", "text": "ええ、そうですね。えっと、あ、待って。私は"}]
[{"type": "subtitle", "time": 12061.11, "timestamp": "03:21:01", "text": "そして、Java パート 1 は大きくてとても大きくて"}, {"type": "subtitle", "time": 12066.309, "timestamp": "03:21:06", "text": "私はその大きなパート1のようなものでした"}, {"type": "subtitle", "time": 12067.269, "timestamp": "03:21:07", "text": "あなたが知っている"}, {"type": "subtitle", "time": 12070.87, "timestamp": "03:21:10", "text": "とんでもない話をしましょう。わかった。"}, {"type": "subtitle", "time": 12072.87, "timestamp": "03:21:12", "text": "たとえあなたが勉強するのが好きだとしても"}, {"type": "subtitle", "time": 12075.349, "timestamp": "03:21:15", "text": "本書の理論は、"}, {"type": "subtitle", "time": 12076.95, "timestamp": "03:21:16", "text": "それはあなたの役には立たないでしょう。あなたはただ"}, {"type": "subtitle", "time": 12079.83, "timestamp": "03:21:19", "text": "自分でもっと学ぶようにして"}, {"type": "subtitle", "time": 12082.07, "timestamp": "03:21:22", "text": "練習しましょう。"}, {"type": "subtitle", "time": 12085.269, "timestamp": "03:21:25", "text": "くそ。基本的には"}, {"type": "subtitle", "time": 12087.429, "timestamp": "03:21:27", "text": "では、例を挙げてみましょう。わかった。その"}, {"type": "subtitle", "time": 12090.71, "timestamp": "03:21:30", "text": "基本的にはアルファベットを学ぶようなものだ。"}, {"type": "subtitle", "time": 12093.75, "timestamp": "03:21:33", "text": "ああ、でも、でも、文法とアクセント"}, {"type": "subtitle", "time": 12095.83, "timestamp": "03:21:35", "text": "そして文を作ることは、"}, {"type": "subtitle", "time": 12099.03, "timestamp": "03:21:39", "text": "すべて自分でやらなければならない。"}, {"type": "subtitle", "time": 12100.95, "timestamp": "03:21:40", "text": "そうそう。本は次のような本を考慮に入れます"}, {"type": "subtitle", "time": 12108.87, "timestamp": "03:21:48", "text": "ええ、つまり、ええ、私は"}, {"type": "subtitle", "time": 12110.309, "timestamp": "03:21:50", "text": "あまりにも"}, {"type": "subtitle", "time": 12112.309, "timestamp": "03:21:52", "text": "難しいけど、えっと、もし"}, {"type": "subtitle", "time": 12114.07, "timestamp": "03:21:54", "text": "興味があるなら、"}, {"type": "subtitle", "time": 12116.95, "timestamp": "03:21:56", "text": "まあまあだ。"}, {"type": "subtitle", "time": 12118.55, "timestamp": "03:21:58", "text": "少なくとも、対処可能と言えるでしょう。しないだろう"}]
[{"type": "subtitle", "time": 3182.71, "timestamp": "00:53:02", "text": "下。そして、私がこれに耐えられるって分かってるよね？"}, {"type": "subtitle", "time": 3184.47, "timestamp": "00:53:04", "text": "男が出て行った。"}, {"type": "subtitle", "time": 3187.03, "timestamp": "00:53:07", "text": "うん。そして、私が"}, {"type": "subtitle", "time": 3189.91, "timestamp": "00:53:09", "text": "戻ってきたね。いいえ。そうですね。"}, {"type": "subtitle", "time": 3192.829, "timestamp": "00:53:12", "text": "何てことだ。"}, {"type": "subtitle", "time": 3198.39, "timestamp": "00:53:18", "text": "いいえ。いいえ。やったー。見つけた。あなたのコインを受け取りました。"}, {"type": "subtitle", "time": 3202.39, "timestamp": "00:53:22", "text": "あなたのコインは私です。何てことだ。"}, {"type": "subtitle", "time": 3205.589, "timestamp": "00:53:25", "text": "何てことだ。こんにちは。こんにちは。こんにちは。調子はどうですか？"}, {"type": "subtitle", "time": 3209.109, "timestamp": "00:53:29", "text": "今日は何をする予定ですか？ああ、なんてことだ。私はできません"}, {"type": "subtitle", "time": 3212.23, "timestamp": "00:53:32", "text": "これを信じてください。お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 3218.87, "timestamp": "00:53:38", "text": "これはまずい。ええ、そうですね。うん。えっと"}, {"type": "subtitle", "time": 3223.03, "timestamp": "00:53:43", "text": "君の女王を捕まえたよ。君は私の罠に引っかかったんだね。"}, {"type": "subtitle", "time": 3225.03, "timestamp": "00:53:45", "text": "ところで、どんなチョコレートが好きですか？"}, {"type": "subtitle", "time": 3226.67, "timestamp": "00:53:46", "text": "のように？"}, {"type": "subtitle", "time": 3229.15, "timestamp": "00:53:49", "text": "チョコレートは"}, {"type": "subtitle", "time": 3232.27, "timestamp": "00:53:52", "text": "何が"}, {"type": "subtitle", "time": 3238.27, "timestamp": "00:53:58", "text": "そうだな、何か起こるだろうと思ったよ。"}]
[{"type": "subtitle", "time": 11641.11, "timestamp": "03:14:01", "text": "新しいノートパソコンを買わないといけないってこと？"}, {"type": "subtitle", "time": 11643.11, "timestamp": "03:14:03", "text": "ノートパソコンを買いに行くつもりですか？"}, {"type": "subtitle", "time": 11646.55, "timestamp": "03:14:06", "text": "現在のPCに追いつくことができる、または"}, {"type": "subtitle", "time": 11649.75, "timestamp": "03:14:09", "text": "緊急事態が発生しそう"}, {"type": "subtitle", "time": 11651.99, "timestamp": "03:14:11", "text": "えーっと、一番安いゲーム機って感じかな"}, {"type": "subtitle", "time": 11655.03, "timestamp": "03:14:15", "text": "ノートパソコンをお持ちいただけます。私はちょっとそうしたい"}, {"type": "subtitle", "time": 11658.309, "timestamp": "03:14:18", "text": "最新のものを選ぶか何か"}, {"type": "subtitle", "time": 11661.349, "timestamp": "03:14:21", "text": "なぜなら、今はノートパソコンだからです。もしそれが"}, {"type": "subtitle", "time": 11663.67, "timestamp": "03:14:23", "text": "PCなら、いつでもアップグレードできる。しかし、もしそれが"}, {"type": "subtitle", "time": 11667.91, "timestamp": "03:14:27", "text": "ノートパソコン、たとえ"}, {"type": "subtitle", "time": 11669.99, "timestamp": "03:14:29", "text": "安いし、悪くない。少なくとも私は"}, {"type": "subtitle", "time": 11673.429, "timestamp": "03:14:33", "text": "私が好きなものをすべてストリーミングしたい"}, {"type": "subtitle", "time": 11675.83, "timestamp": "03:14:35", "text": "マルチリーミングのように、"}, {"type": "subtitle", "time": 11679.269, "timestamp": "03:14:39", "text": "ええと、VTモデルです。ああ、新しいモーターのことだよ"}, {"type": "subtitle", "time": 11683.19, "timestamp": "03:14:43", "text": "PCに負荷がかかりすぎることがありますが、"}, {"type": "subtitle", "time": 11685.11, "timestamp": "03:14:45", "text": "それが必要だ。うん。うん。うん。うん。私"}, {"type": "subtitle", "time": 11687.75, "timestamp": "03:14:47", "text": "手に入れることができますか？"}, {"type": "subtitle", "time": 11689.83, "timestamp": "03:14:49", "text": "追跡機能のことですね。ええと、"}, {"type": "subtitle", "time": 11693.269, "timestamp": "03:14:53", "text": "iPhone がなくても、私はまだ"}, {"type": "subtitle", "time": 11696.429, "timestamp": "03:14:56", "text": "えっと、ウェブカメラを今すぐ。だから私は"}, {"type": "subtitle", "time": 11699.229, "timestamp": "03:14:59", "text": "考え"}]
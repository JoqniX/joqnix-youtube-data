[{"type": "subtitle", "time": 2041.59, "timestamp": "00:34:01", "text": "ルームメイトだけど、私が今まで出会った中で最高のルームメイト"}, {"type": "subtitle", "time": 2044.47, "timestamp": "00:34:04", "text": "私からすればルームメイトだと言うだろう"}, {"type": "subtitle", "time": 2048.909, "timestamp": "00:34:08", "text": "ほとんどの場合、自分のことに専念している人"}, {"type": "subtitle", "time": 2051.99, "timestamp": "00:34:11", "text": "日。つまり、あなたにはプライバシーがあり、彼らは"}, {"type": "subtitle", "time": 2054.31, "timestamp": "00:34:14", "text": "彼らにはプライバシーがある。君たちは知ることになる"}, {"type": "subtitle", "time": 2058.23, "timestamp": "00:34:18", "text": "お互いにゆっくりと、でも、君たちは"}, {"type": "subtitle", "time": 2060.869, "timestamp": "00:34:20", "text": "しばらく経ってから閉じる。そういうやつ"}, {"type": "subtitle", "time": 2063.909, "timestamp": "00:34:23", "text": "ルームメイトの性格は、とても重要だ。"}, {"type": "subtitle", "time": 2065.51, "timestamp": "00:34:25", "text": "うん。"}, {"type": "subtitle", "time": 2071.99, "timestamp": "00:34:31", "text": "私はよく考えすぎてしまうんです。だから私は"}, {"type": "subtitle", "time": 2074.629, "timestamp": "00:34:34", "text": "それについて考えてみたところ、シナリオはこうだ。"}, {"type": "subtitle", "time": 2078.149, "timestamp": "00:34:38", "text": "まるで私が彼らと同じようになるかのように"}, {"type": "subtitle", "time": 2079.99, "timestamp": "00:34:39", "text": "パートタイムで働いているか、あるいは彼らは"}, {"type": "subtitle", "time": 2082.19, "timestamp": "00:34:42", "text": "今は部屋にいる。私はストリーミング配信します"}, {"type": "subtitle", "time": 2084.95, "timestamp": "00:34:44", "text": "その地域は騒がしくなるでしょう。彼らは"}, {"type": "subtitle", "time": 2087.109, "timestamp": "00:34:47", "text": "例えば、スマホをいじっていたり、勉強していたり​​する時など。それは"}, {"type": "subtitle", "time": 2090.23, "timestamp": "00:34:50", "text": "迷惑で不快な存在となる。右。それで"}, {"type": "subtitle", "time": 2092.71, "timestamp": "00:34:52", "text": "私はそんな出来事は望んでいない"}, {"type": "subtitle", "time": 2095.589, "timestamp": "00:34:55", "text": "話すことは私にとって良いことだと思います"}, {"type": "subtitle", "time": 2097.589, "timestamp": "00:34:57", "text": "誰かに、そして私が病気になったら"}, {"type": "subtitle", "time": 2099.67, "timestamp": "00:34:59", "text": "誰かの世話をしたり、何か"}]
[{"type": "subtitle", "time": 11100.64, "timestamp": "03:05:00", "text": "多くの人々とコラボレーションする。"}, {"type": "subtitle", "time": 11107.75, "timestamp": "03:05:07", "text": "うん。でも、みんな親切にしてくれたよ。"}, {"type": "subtitle", "time": 11110.55, "timestamp": "03:05:10", "text": "考える。うん。いくつかあるにもかかわらず"}, {"type": "subtitle", "time": 11112.71, "timestamp": "03:05:12", "text": "あちこちで衝突があったり、ドラマがあったり"}, {"type": "subtitle", "time": 11114.95, "timestamp": "03:05:14", "text": "そして、人々は"}, {"type": "subtitle", "time": 11127.03, "timestamp": "03:05:27", "text": "うん。何てことだ。好きでここにいるよ、"}, {"type": "subtitle", "time": 11128.95, "timestamp": "03:05:28", "text": "知ってる、落ち着いて、ほら、試してる"}, {"type": "subtitle", "time": 11132.15, "timestamp": "03:05:32", "text": "古き良き時代を楽しむ。"}, {"type": "subtitle", "time": 11139.19, "timestamp": "03:05:39", "text": "うん。"}, {"type": "subtitle", "time": 11143.429, "timestamp": "03:05:43", "text": "では、ええ、どうぞ。いいえ、私はただ"}, {"type": "subtitle", "time": 11145.269, "timestamp": "03:05:45", "text": "聞いてみようとして、もしそれが"}, {"type": "subtitle", "time": 11147.67, "timestamp": "03:05:47", "text": "そこにあるものは全てあなたにとって快適です。それで"}, {"type": "subtitle", "time": 11149.269, "timestamp": "03:05:49", "text": "管理についてどう考えていますか？"}, {"type": "subtitle", "time": 11153.269, "timestamp": "03:05:53", "text": "VPingのことと、スタッドそのもののこと、ご存知ですか？"}, {"type": "subtitle", "time": 11155.75, "timestamp": "03:05:55", "text": "それは良い質問ですね。私は思う"}, {"type": "subtitle", "time": 11157.99, "timestamp": "03:05:57", "text": "私は今、そこでパートタイムで働かなければならないのですか？"}]
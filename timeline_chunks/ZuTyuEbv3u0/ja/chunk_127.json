[{"type": "subtitle", "time": 7628.5, "timestamp": "02:07:08", "text": "[音楽]"}, {"type": "subtitle", "time": 7629.1, "timestamp": "02:07:09", "text": "[拍手]"}, {"type": "subtitle", "time": 7631.75, "timestamp": "02:07:11", "text": "[音楽]"}, {"type": "subtitle", "time": 7634.31, "timestamp": "02:07:14", "text": "原人って本当に楽しいゲームだよね。私はただ嫌い"}, {"type": "subtitle", "time": 7636.669, "timestamp": "02:07:16", "text": "それが事実である"}, {"type": "subtitle", "time": 7639.109, "timestamp": "02:07:19", "text": "面倒くさい。それ以外は楽しいよ。その"}, {"type": "subtitle", "time": 7646.589, "timestamp": "02:07:26", "text": "[音楽]"}, {"type": "subtitle", "time": 7648.91, "timestamp": "02:07:28", "text": "意欲的。見逃した"}, {"type": "subtitle", "time": 7652.43, "timestamp": "02:07:32", "text": "あなた。こんにちは。私たちは土地を耕しています"}]
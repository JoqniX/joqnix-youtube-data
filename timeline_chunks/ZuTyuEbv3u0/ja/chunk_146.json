[{"type": "subtitle", "time": 8764.15, "timestamp": "02:26:04", "text": "アイアンマンなら私を知っているだろう。はい。はい。"}, {"type": "subtitle", "time": 8766.79, "timestamp": "02:26:06", "text": "うん。"}, {"type": "subtitle", "time": 8769.91, "timestamp": "02:26:09", "text": "あなたの周りに立って、"}, {"type": "subtitle", "time": 8771.389, "timestamp": "02:26:11", "text": "鍵。"}, {"type": "subtitle", "time": 8774.309, "timestamp": "02:26:14", "text": "うん。他の皆はそうは思わない"}, {"type": "subtitle", "time": 8776.83, "timestamp": "02:26:16", "text": "ストリーミング配信。私は見ていた、私は考えていた"}, {"type": "subtitle", "time": 8780.23, "timestamp": "02:26:20", "text": "他の人に尋ねることについて、私は"}, {"type": "subtitle", "time": 8782.87, "timestamp": "02:26:22", "text": "ネオガミに何が起こったのか知っている。彼は"}, {"type": "subtitle", "time": 8785.67, "timestamp": "02:26:25", "text": "まだこのカードを使っていますか？"}, {"type": "subtitle", "time": 8790.15, "timestamp": "02:26:30", "text": "ええ、確かに彼は時々現れますよ。"}, {"type": "subtitle", "time": 8792.63, "timestamp": "02:26:32", "text": "彼とは連絡を取り合っていますか？うん。"}, {"type": "subtitle", "time": 8794.55, "timestamp": "02:26:34", "text": "うん。うん。ほぼライブ演奏できます"}, {"type": "subtitle", "time": 8796.67, "timestamp": "02:26:36", "text": "少なくとも私のサーバーでは。"}, {"type": "subtitle", "time": 8798.79, "timestamp": "02:26:38", "text": "[音楽]"}, {"type": "subtitle", "time": 8800.59, "timestamp": "02:26:40", "text": "オアミのように"}, {"type": "subtitle", "time": 8804.23, "timestamp": "02:26:44", "text": "それからハニー。ハニーに何があったの？おお"}, {"type": "subtitle", "time": 8807.75, "timestamp": "02:26:47", "text": "我が神よ。どうですか？ 2つ目はハッキングされた。"}, {"type": "subtitle", "time": 8809.79, "timestamp": "02:26:49", "text": "えっと、背景説明をすると、ハニーはこんな感じ"}, {"type": "subtitle", "time": 8814.67, "timestamp": "02:26:54", "text": "私たちが知り合った友人。はい。"}, {"type": "subtitle", "time": 8817.03, "timestamp": "02:26:57", "text": "共通の友人のような、"}]
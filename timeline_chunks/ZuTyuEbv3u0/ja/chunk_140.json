[{"type": "subtitle", "time": 8401.99, "timestamp": "02:20:01", "text": "アメリカは今後物価が高くなるだろう。ええ、それは"}, {"type": "subtitle", "time": 8409.91, "timestamp": "02:20:09", "text": "ええ、今のマレーシア人はきっと良い人でしょう。私"}, {"type": "subtitle", "time": 8411.59, "timestamp": "02:20:11", "text": "マレーシア人の友達がいると信じています。"}, {"type": "chat", "time": 8412.573, "timestamp": "02:20:12", "author": "@milauratwlight9335", "avatar": "https://yt4.ggpht.com/ytc/AIdro_npJoFMdsld4mr5yJH9a0DnQDNdwhJwbLRjQYEr4Jq5_Yo=s64-c-k-c0x00ffffff-no-rj", "message": "YOOOO"}, {"type": "subtitle", "time": 8413.67, "timestamp": "02:20:13", "text": "右？"}, {"type": "subtitle", "time": 8415.27, "timestamp": "02:20:15", "text": "私"}, {"type": "subtitle", "time": 8416.11, "timestamp": "02:20:16", "text": "うん、"}, {"type": "subtitle", "time": 8417.63, "timestamp": "02:20:17", "text": "私"}, {"type": "subtitle", "time": 8421.03, "timestamp": "02:20:21", "text": "見たよ、君のアートを見たのを覚えてるよ"}, {"type": "subtitle", "time": 8423.429, "timestamp": "02:20:23", "text": "あれこれ、アートコラボとか、あなたがやったこと"}, {"type": "subtitle", "time": 8426.389, "timestamp": "02:20:26", "text": "インスタグラム。あなたが投稿しました。いいえ。ええ。うん。"}, {"type": "subtitle", "time": 8429.03, "timestamp": "02:20:29", "text": "あのアーティストたちはマレーシア出身のようだ。"}, {"type": "subtitle", "time": 8431.27, "timestamp": "02:20:31", "text": "[音楽]"}, {"type": "subtitle", "time": 8433.51, "timestamp": "02:20:33", "text": "それはいいですね。"}, {"type": "subtitle", "time": 8434.87, "timestamp": "02:20:34", "text": "ええ、そうですね。つまり、基本的に、もしあなたが"}, {"type": "subtitle", "time": 8436.55, "timestamp": "02:20:36", "text": "新しい国へ出かけることを希望している、特に"}, {"type": "subtitle", "time": 8438.71, "timestamp": "02:20:38", "text": "日本のように、"}, {"type": "subtitle", "time": 8441.83, "timestamp": "02:20:41", "text": "語学試験のことですよね？はい。"}, {"type": "subtitle", "time": 8444.87, "timestamp": "02:20:44", "text": "言語試験。はい。はい。うん。"}, {"type": "subtitle", "time": 8448.15, "timestamp": "02:20:48", "text": "調子はどうですか？ああ、私は"}, {"type": "subtitle", "time": 8453.03, "timestamp": "02:20:53", "text": "最初のLレベルと5つに合格する。だから彼らは"}, {"type": "subtitle", "time": 8456.79, "timestamp": "02:20:56", "text": "ええ、彼らはN5レベルからN1レベルまで5段階上がります。"}, {"type": "subtitle", "time": 8459.99, "timestamp": "02:20:59", "text": "ということで、N5レベルに合格できました。私"}]
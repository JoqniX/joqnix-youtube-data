[{"type": "subtitle", "time": 14521.83, "timestamp": "04:02:01", "text": "それで遊んで、幸運を祈ります"}, {"type": "subtitle", "time": 14529.269, "timestamp": "04:02:09", "text": "うん。私はただ、私はただ、"}, {"type": "subtitle", "time": 14532.229, "timestamp": "04:02:12", "text": "もっとカジュアルで、ほら、リラックスしたストリーミング"}, {"type": "subtitle", "time": 14535.59, "timestamp": "04:02:15", "text": "将来あなたのような人"}, {"type": "subtitle", "time": 14537.349, "timestamp": "04:02:17", "text": "そうすればコミュニケーションが取りやすくなる"}, {"type": "subtitle", "time": 14541.91, "timestamp": "04:02:21", "text": "その周り。うん。はい。はい。真実。"}, {"type": "subtitle", "time": 14544.229, "timestamp": "04:02:24", "text": "今はもう悪い年だと思う"}, {"type": "subtitle", "time": 14546.55, "timestamp": "04:02:26", "text": "新しいユーチューバーを見かけたら"}, {"type": "subtitle", "time": 14550.71, "timestamp": "04:02:30", "text": "あなたが新参者で、ここに来た"}, {"type": "subtitle", "time": 14552.71, "timestamp": "04:02:32", "text": "このコミュニティについて知ったのは"}, {"type": "subtitle", "time": 14556.389, "timestamp": "04:02:36", "text": "今は近づくのが難しいだろう"}, {"type": "subtitle", "time": 14558.71, "timestamp": "04:02:38", "text": "つまり、つまり、発見について話しているということです"}, {"type": "subtitle", "time": 14560.95, "timestamp": "04:02:40", "text": "コミュニティは新しい一方で私は"}, {"type": "subtitle", "time": 14563.269, "timestamp": "04:02:43", "text": "すでにコミュニケーションに問題が生じている"}, {"type": "subtitle", "time": 14566.469, "timestamp": "04:02:46", "text": "兄弟、何年もここにいるよ"}, {"type": "subtitle", "time": 14568.389, "timestamp": "04:02:48", "text": "ああ、君は何年もここにいるね"}, {"type": "subtitle", "time": 14570.11, "timestamp": "04:02:50", "text": "右"}, {"type": "subtitle", "time": 14573.03, "timestamp": "04:02:53", "text": "はい、いいえ、新しい人が好きな男性はいません。いいえ"}, {"type": "subtitle", "time": 14575.67, "timestamp": "04:02:55", "text": "彼らは「ああ、手が届きにくい」と言うだろう"}, {"type": "subtitle", "time": 14579.429, "timestamp": "04:02:59", "text": "どうすればいいですか？"}]
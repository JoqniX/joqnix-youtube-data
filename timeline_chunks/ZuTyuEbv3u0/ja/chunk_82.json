[{"type": "subtitle", "time": 4938.79, "timestamp": "01:22:18", "text": "D. 仕事が順調に進んでいることを願っています。"}, {"type": "subtitle", "time": 4944.59, "timestamp": "01:22:24", "text": "はい、これで終わりです。えっと、ハンハンは"}, {"type": "subtitle", "time": 4956.95, "timestamp": "01:22:36", "text": "えっと、ハンハン。待って、いつハンを"}, {"type": "subtitle", "time": 4961.709, "timestamp": "01:22:41", "text": "また？"}, {"type": "subtitle", "time": 4965.91, "timestamp": "01:22:45", "text": "えっと、待って。えーと、場所を確保したら"}, {"type": "subtitle", "time": 4969.35, "timestamp": "01:22:49", "text": "1週間前に感謝申し上げます。はい、私は"}, {"type": "subtitle", "time": 4971.99, "timestamp": "01:22:51", "text": "ハンにそれを伝えると、"}, {"type": "subtitle", "time": 4976.47, "timestamp": "01:22:56", "text": "前進。わかった。それで、皆さん、えっと、"}, {"type": "subtitle", "time": 4977.709, "timestamp": "01:22:57", "text": "もの"}]
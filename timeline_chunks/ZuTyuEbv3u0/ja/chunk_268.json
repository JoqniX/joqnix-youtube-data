[{"type": "subtitle", "time": 16081.67, "timestamp": "04:28:01", "text": "それを開示し、公に漏洩した場合"}, {"type": "subtitle", "time": 16085.11, "timestamp": "04:28:05", "text": "何らかの理由で、私は"}, {"type": "subtitle", "time": 16087.83, "timestamp": "04:28:07", "text": "正式に免許を失う、つまり私は"}, {"type": "subtitle", "time": 16090.87, "timestamp": "04:28:10", "text": "モデルを失う。私は一生懸命働いています"}, {"type": "subtitle", "time": 16094.149, "timestamp": "04:28:14", "text": "所有権を取り戻し、すべてを手に入れた。"}, {"type": "subtitle", "time": 16097.91, "timestamp": "04:28:17", "text": "ええ、つまり私は全力を尽くしました"}, {"type": "subtitle", "time": 16101.11, "timestamp": "04:28:21", "text": "そのモデルにアーティストたちと協力した"}, {"type": "subtitle", "time": 16103.75, "timestamp": "04:28:23", "text": "私の好みにも合っていて、すべて完璧です。しかし、"}, {"type": "subtitle", "time": 16107.75, "timestamp": "04:28:27", "text": "ええと、アートアート、モデルアートですね"}, {"type": "subtitle", "time": 16109.99, "timestamp": "04:28:29", "text": "少し修正する必要があるので"}, {"type": "subtitle", "time": 16112.469, "timestamp": "04:28:32", "text": "改造可能であること。そうするとお金を使わなければならない"}, {"type": "subtitle", "time": 16115.03, "timestamp": "04:28:35", "text": "索具について。索具の設置には費用がかかる。"}, {"type": "subtitle", "time": 16117.429, "timestamp": "04:28:37", "text": "Vチューブは高価です。確かにそれは"}, {"type": "subtitle", "time": 16118.269, "timestamp": "04:28:38", "text": "そこには"}, {"type": "subtitle", "time": 16121.51, "timestamp": "04:28:41", "text": "それ。私も日本に行く予定です。だから"}, {"type": "subtitle", "time": 16124.55, "timestamp": "04:28:44", "text": "私がJathonをやっている理由は、"}, {"type": "subtitle", "time": 16127.03, "timestamp": "04:28:47", "text": "そのモデルのためのクラウドファンディングについて。その"}, {"type": "subtitle", "time": 16129.83, "timestamp": "04:28:49", "text": "そのモデルについて、"}, {"type": "subtitle", "time": 16132.95, "timestamp": "04:28:52", "text": "未来の自分にとっての未来。だから、もし"}, {"type": "subtitle", "time": 16135.349, "timestamp": "04:28:55", "text": "将来、それが1年か"}, {"type": "subtitle", "time": 16137.51, "timestamp": "04:28:57", "text": "そこからデビューさせるもの"}]
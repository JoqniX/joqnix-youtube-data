[{"type": "subtitle", "time": 13380.63, "timestamp": "03:43:00", "text": "つまり、私はバスに乗り込んだ"}, {"type": "subtitle", "time": 13383.11, "timestamp": "03:43:03", "text": "その後は止めて、以前はよくやっていた"}, {"type": "subtitle", "time": 13385.19, "timestamp": "03:43:05", "text": "オートが、そのオートが、その近くで始まった"}, {"type": "subtitle", "time": 13391.469, "timestamp": "03:43:11", "text": "5キロくらいで200くらいかな。おお、"}, {"type": "subtitle", "time": 13395.59, "timestamp": "03:43:15", "text": "5は6です。 6、7人。わかった。"}, {"type": "subtitle", "time": 13398.87, "timestamp": "03:43:18", "text": "結局そうなった。わかった。では、聞いてください。えっと、私の"}, {"type": "subtitle", "time": 13402.15, "timestamp": "03:43:22", "text": "故郷の出身者、私はこの街に来ます、"}, {"type": "subtitle", "time": 13403.67, "timestamp": "03:43:23", "text": "右？そこからバスに乗らなければならない"}, {"type": "subtitle", "time": 13406.87, "timestamp": "03:43:26", "text": "私の大学のためですよね？"}, {"type": "subtitle", "time": 13408.87, "timestamp": "03:43:28", "text": "あれはたった12ルピーか"}, {"type": "subtitle", "time": 13414.389, "timestamp": "03:43:34", "text": "バスはたった12ルピーで"}, {"type": "subtitle", "time": 13416.87, "timestamp": "03:43:36", "text": "自分。しかし、私が知る前に"}, {"type": "subtitle", "time": 13418.79, "timestamp": "03:43:38", "text": "毎回200ドル払って"}, {"type": "subtitle", "time": 13427.349, "timestamp": "03:43:47", "text": "「ああ、俺はすごくお金を無駄にした」って思ったよ。"}, {"type": "subtitle", "time": 13435.55, "timestamp": "03:43:55", "text": "そうそう。大学生活はどうだったか聞きたかったのですが"}, {"type": "subtitle", "time": 13438.309, "timestamp": "03:43:58", "text": "人生？ヒンディー語映画みたいだった？"}]
[{"type": "subtitle", "time": 14940.55, "timestamp": "04:09:00", "text": "死んでなかったから、プレイできたのに"}, {"type": "subtitle", "time": 14944.229, "timestamp": "04:09:04", "text": "今すぐ。うん。"}, {"type": "subtitle", "time": 14946.87, "timestamp": "04:09:06", "text": "その後は、ええ、おそらく、あの"}, {"type": "subtitle", "time": 14949.59, "timestamp": "04:09:09", "text": "最も有名なハイグラフィック"}, {"type": "subtitle", "time": 14963.269, "timestamp": "04:09:23", "text": "うん。ああ、もう12時間も経った。"}, {"type": "subtitle", "time": 14966.389, "timestamp": "04:09:26", "text": "もう2時間も話してたよね？"}, {"type": "subtitle", "time": 14968.309, "timestamp": "04:09:28", "text": "あ、待って。私は授業をサボった。おお"}, {"type": "subtitle", "time": 14973.429, "timestamp": "04:09:33", "text": "え、授業あるの？"}, {"type": "subtitle", "time": 14975.189, "timestamp": "04:09:35", "text": "いや、決闘する方のほうだ。はい、幸運なことに"}, {"type": "subtitle", "time": 14979.03, "timestamp": "04:09:39", "text": "おそらく、私は無料で凍結できたのでしょう。ちょっと待って。"}, {"type": "subtitle", "time": 14980.95, "timestamp": "04:09:40", "text": "Dualingoで何かやってみて。大丈夫。"}, {"type": "subtitle", "time": 14984.55, "timestamp": "04:09:44", "text": "それは良い。えーと、つまり12時以降"}, {"type": "subtitle", "time": 14987.51, "timestamp": "04:09:47", "text": "とにかく、もうなくなってしまった。いいえ、私はあなたを恋しくさせた"}, {"type": "subtitle", "time": 14989.91, "timestamp": "04:09:49", "text": "あなたの連勝記録。いいえ、"}, {"type": "subtitle", "time": 14991.91, "timestamp": "04:09:51", "text": "いや、いや。私は無料のものを手に入れました。それで、"}, {"type": "subtitle", "time": 14993.99, "timestamp": "04:09:53", "text": "基本的に、えーと、私の連勝記録は"}, {"type": "subtitle", "time": 14995.63, "timestamp": "04:09:55", "text": "休憩ですが、それは"}]
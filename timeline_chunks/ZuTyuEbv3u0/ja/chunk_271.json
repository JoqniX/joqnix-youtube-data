[{"type": "subtitle", "time": 16261.75, "timestamp": "04:31:01", "text": "これらの人々と共に、彼らのコミュニティの中で。"}, {"type": "subtitle", "time": 16264.95, "timestamp": "04:31:04", "text": "でもDJは、カリックスだけが"}, {"type": "subtitle", "time": 16268.07, "timestamp": "04:31:08", "text": "「おや、新しい人だ」という感じだった。そして、"}, {"type": "subtitle", "time": 16270.229, "timestamp": "04:31:10", "text": "彼は私たちに好きになるように言った、私に好きになるように言った、来るように言った"}, {"type": "subtitle", "time": 16272.469, "timestamp": "04:31:12", "text": "そして訪れてください。話したり、一緒に時間を過ごしたりできます。そして"}, {"type": "subtitle", "time": 16275.269, "timestamp": "04:31:15", "text": "彼は積極的に"}, {"type": "subtitle", "time": 16277.99, "timestamp": "04:31:17", "text": "えっと、私はすごく内気だったんです。わかった。私は"}, {"type": "subtitle", "time": 16280.469, "timestamp": "04:31:20", "text": "極度の人見知りで不器用。難しかった"}, {"type": "subtitle", "time": 16282.309, "timestamp": "04:31:22", "text": "人と話したり、"}, {"type": "subtitle", "time": 16284.87, "timestamp": "04:31:24", "text": "その日。私はこんなにおしゃべりではない"}, {"type": "subtitle", "time": 16287.51, "timestamp": "04:31:27", "text": "昔は。でも、私はほとんど"}, {"type": "subtitle", "time": 16290.229, "timestamp": "04:31:30", "text": "英語を話した。英語も難しかった。しかし"}, {"type": "subtitle", "time": 16292.79, "timestamp": "04:31:32", "text": "うん、だって今は積極的に使ってないから"}, {"type": "subtitle", "time": 16296.389, "timestamp": "04:31:36", "text": "学校や、えーと、"}, {"type": "subtitle", "time": 16298.389, "timestamp": "04:31:38", "text": "友達と一緒だったり、教室で何か"}, {"type": "subtitle", "time": 16301.59, "timestamp": "04:31:41", "text": "などなど、そうですよね？というわけで、"}, {"type": "subtitle", "time": 16304.07, "timestamp": "04:31:44", "text": "連絡をくれた人が私を"}, {"type": "subtitle", "time": 16305.99, "timestamp": "04:31:45", "text": "ベンチャーキャピタルとかで話す。そうすれば私は"}, {"type": "subtitle", "time": 16308.309, "timestamp": "04:31:48", "text": "これらのインド人全員を知るために"}, {"type": "subtitle", "time": 16310.229, "timestamp": "04:31:50", "text": "YouTuber。昔は、"}, {"type": "subtitle", "time": 16313.51, "timestamp": "04:31:53", "text": "私たち4、5人だけだった。元祖インディアン"}, {"type": "subtitle", "time": 16315.99, "timestamp": "04:31:55", "text": "YouTuberたちは5人か5人全員"}, {"type": "subtitle", "time": 16319.11, "timestamp": "04:31:59", "text": "5、6、最大でゆっくりと"}]
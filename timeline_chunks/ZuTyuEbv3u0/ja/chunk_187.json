[{"type": "subtitle", "time": 11221.349, "timestamp": "03:07:01", "text": "えっと、追加のものを買うために。もちろん"}, {"type": "subtitle", "time": 11223.91, "timestamp": "03:07:03", "text": "食料を買うことはできますが、私は"}, {"type": "subtitle", "time": 11230.87, "timestamp": "03:07:10", "text": "彼らは十分なお金を得ているが、問題は"}, {"type": "subtitle", "time": 11233.83, "timestamp": "03:07:13", "text": "仮に彼らが300ルピー100ルピーを受け取ったとしましょう"}, {"type": "subtitle", "time": 11236.63, "timestamp": "03:07:16", "text": "バイクのガソリン代みたいなものだろう"}, {"type": "subtitle", "time": 11239.51, "timestamp": "03:07:19", "text": "そして残りの200は私が知っている"}, {"type": "subtitle", "time": 11241.389, "timestamp": "03:07:21", "text": "食べ物。"}, {"type": "subtitle", "time": 11244.71, "timestamp": "03:07:24", "text": "そう、まさにそんな感じになるだろう"}, {"type": "subtitle", "time": 11247.91, "timestamp": "03:07:27", "text": "私もそう思います。だから私は「やってみよう」と思った"}, {"type": "subtitle", "time": 11249.389, "timestamp": "03:07:29", "text": "取る"}, {"type": "subtitle", "time": 11252.87, "timestamp": "03:07:32", "text": "えっと、複数ですね。様子を見てみます。"}, {"type": "subtitle", "time": 11255.91, "timestamp": "03:07:35", "text": "1ヶ月か2ヶ月間、1人ずつ。ストレス"}, {"type": "subtitle", "time": 11258.469, "timestamp": "03:07:38", "text": "やり過ぎてしまうような自分を過信してしまう"}, {"type": "subtitle", "time": 11260.75, "timestamp": "03:07:40", "text": "複数の仕事または"}, {"type": "subtitle", "time": 11264.95, "timestamp": "03:07:44", "text": "何か、だって今、あなたは"}, {"type": "subtitle", "time": 11267.19, "timestamp": "03:07:47", "text": "で有名な国"}, {"type": "subtitle", "time": 11275.51, "timestamp": "03:07:55", "text": "うん。うん。パタン文化はやりすぎだ。"}, {"type": "subtitle", "time": 11279.269, "timestamp": "03:07:59", "text": "実際、それはやりすぎだろう。うん。"}]
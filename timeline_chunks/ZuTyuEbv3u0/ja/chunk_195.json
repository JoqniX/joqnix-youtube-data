[{"type": "subtitle", "time": 11702.63, "timestamp": "03:15:02", "text": "もしかしたら、何とか即興で対応できるかもしれないし"}, {"type": "subtitle", "time": 11705.99, "timestamp": "03:15:05", "text": "そうですね、ラップトップのようなものですね"}, {"type": "subtitle", "time": 11709.349, "timestamp": "03:15:09", "text": "40枚のCDや50枚のCDカードを持っているようなもの、"}, {"type": "subtitle", "time": 11711.83, "timestamp": "03:15:11", "text": "今のところは良いもの"}, {"type": "subtitle", "time": 11714.71, "timestamp": "03:15:14", "text": "どちらが安いか、あるいはもし"}, {"type": "subtitle", "time": 11718.79, "timestamp": "03:15:18", "text": "入手できれば、購入を試みます"}, {"type": "subtitle", "time": 11721.469, "timestamp": "03:15:21", "text": "それを見て、"}, {"type": "subtitle", "time": 11726.469, "timestamp": "03:15:26", "text": "うーん、たぶん聞いてみると思う。"}, {"type": "subtitle", "time": 11727.87, "timestamp": "03:15:27", "text": "多分私は"}, {"type": "subtitle", "time": 11731.229, "timestamp": "03:15:31", "text": "ちょっと待ってください。"}, {"type": "subtitle", "time": 11735.11, "timestamp": "03:15:35", "text": "こんにちは。ええ、ゆっくりで大丈夫ですよ。ああ、私たちは"}, {"type": "subtitle", "time": 11738.63, "timestamp": "03:15:38", "text": "戻る。ええ、ちょうど誰かが来たところです"}, {"type": "subtitle", "time": 11742.469, "timestamp": "03:15:42", "text": "私の様子を確かめるために。こんにちは。"}, {"type": "subtitle", "time": 11746.309, "timestamp": "03:15:46", "text": "そうですね、おそらく購入する前に"}, {"type": "subtitle", "time": 11749.19, "timestamp": "03:15:49", "text": "ノートパソコン、すべてをチェックする必要があります"}, {"type": "subtitle", "time": 11752.63, "timestamp": "03:15:52", "text": "ラップトップがそこにあり、そして最終決定し、"}, {"type": "subtitle", "time": 11756.389, "timestamp": "03:15:56", "text": "地元のものみたいだから、それを払ってください"}, {"type": "subtitle", "time": 11758.469, "timestamp": "03:15:58", "text": "アカデミー関係者。いや、彼らは"}]
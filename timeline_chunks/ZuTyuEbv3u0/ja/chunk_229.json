[{"type": "subtitle", "time": 13740.389, "timestamp": "03:49:00", "text": "いいえ、それは実務的なことのようなものです"}, {"type": "subtitle", "time": 13742.79, "timestamp": "03:49:02", "text": "私たちが研究しているテーマの実験室のことです"}, {"type": "subtitle", "time": 13744.06, "timestamp": "03:49:04", "text": "勉強する。"}, {"type": "subtitle", "time": 13745.51, "timestamp": "03:49:05", "text": "[音楽]"}, {"type": "subtitle", "time": 13747.03, "timestamp": "03:49:07", "text": "つまり、私たちがやっていることは基本的に"}, {"type": "subtitle", "time": 13749.269, "timestamp": "03:49:09", "text": "基本的にテストのようなもの"}, {"type": "subtitle", "time": 13751.189, "timestamp": "03:49:11", "text": "あなたが知っているように、"}, {"type": "subtitle", "time": 13753.99, "timestamp": "03:49:13", "text": "実質的には、対象者に対して行うのと同様です。"}, {"type": "subtitle", "time": 13755.75, "timestamp": "03:49:15", "text": "その後、メインの"}, {"type": "subtitle", "time": 13764.07, "timestamp": "03:49:24", "text": "[音楽]"}, {"type": "subtitle", "time": 13768.79, "timestamp": "03:49:28", "text": "つまり、私はすでに自分の初期のすべてを気に入っています"}, {"type": "subtitle", "time": 13778.229, "timestamp": "03:49:38", "text": "今日予約できてよかったです"}, {"type": "subtitle", "time": 13781.349, "timestamp": "03:49:41", "text": "だって私は「ああ、いやだ」って思ったから。あなたが"}, {"type": "subtitle", "time": 13783.389, "timestamp": "03:49:43", "text": "最初は終わった、私は"}, {"type": "subtitle", "time": 13787.11, "timestamp": "03:49:47", "text": "「えっと、ちょっと待って」みたいな感じ。私は「あ、待って」と思いました。"}, {"type": "subtitle", "time": 13788.349, "timestamp": "03:49:48", "text": "は"}, {"type": "subtitle", "time": 13792.229, "timestamp": "03:49:52", "text": "えっと、ちょっと待って、えーと"}, {"type": "subtitle", "time": 13794.83, "timestamp": "03:49:54", "text": "うん、これは"}]
[{"type": "subtitle", "time": 6964.03, "timestamp": "01:56:04", "text": "いいね。待って、君はよく独り言を言うね、"}, {"type": "subtitle", "time": 6975.83, "timestamp": "01:56:15", "text": "[音楽]"}, {"type": "subtitle", "time": 7006.79, "timestamp": "01:56:46", "text": "外国。あ、待って。私は"}, {"type": "subtitle", "time": 7008.47, "timestamp": "01:56:48", "text": "これをスピードランでクリアしよう。忘れた。それは一部ではない"}, {"type": "subtitle", "time": 7010.79, "timestamp": "01:56:50", "text": "ロンドンのですよね？ロンドンですよね？"}, {"type": "subtitle", "time": 7013.75, "timestamp": "01:56:53", "text": "約1時間かかり、さらに1時間かけて"}, {"type": "subtitle", "time": 7015.35, "timestamp": "01:56:55", "text": "イベント全体を完遂する。ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 7016.57, "timestamp": "01:56:56", "text": "忘れた。"}, {"type": "subtitle", "time": 7019.27, "timestamp": "01:56:59", "text": "[音楽]"}]
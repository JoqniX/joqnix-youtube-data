[{"type": "subtitle", "time": 3481.589, "timestamp": "00:58:01", "text": "別の場所へ行った。文字通り"}, {"type": "subtitle", "time": 3485.109, "timestamp": "00:58:05", "text": "「あなたはマッドサイエンティストですか？」とだけ言っています。"}, {"type": "subtitle", "time": 3488.069, "timestamp": "00:58:08", "text": "そして私は、ほら、手に入れたかったんです"}, {"type": "subtitle", "time": 3490.789, "timestamp": "00:58:10", "text": "それを取り除く。それで、私は、えーと"}, {"type": "subtitle", "time": 3494.95, "timestamp": "00:58:14", "text": "削除ボタンのようなボタンをクリックしてください"}, {"type": "subtitle", "time": 3498.309, "timestamp": "00:58:18", "text": "そして、別のウェブサイトに飛ばされました。"}, {"type": "subtitle", "time": 3501.47, "timestamp": "00:58:21", "text": "なんてこった。信じられない"}, {"type": "subtitle", "time": 3504.63, "timestamp": "00:58:24", "text": "消えた。それはそうではなかった"}, {"type": "subtitle", "time": 3507.71, "timestamp": "00:58:27", "text": "起こるはずだったが、"}, {"type": "subtitle", "time": 3512.39, "timestamp": "00:58:32", "text": "ええ、私はただ、本当に忙しいんです。"}, {"type": "subtitle", "time": 3515.75, "timestamp": "00:58:35", "text": "エリック。でも、ただ、ほら、私は"}, {"type": "subtitle", "time": 3518.309, "timestamp": "00:58:38", "text": "戻ってくるのに十分な時間があるだろう"}, {"type": "subtitle", "time": 3520.75, "timestamp": "00:58:40", "text": "近いうちに、少なくとも週に一度か"}, {"type": "subtitle", "time": 3523.069, "timestamp": "00:58:43", "text": "何か。それで、"}, {"type": "subtitle", "time": 3526.069, "timestamp": "00:58:46", "text": "うん。お元気ですか？どうですか"}, {"type": "subtitle", "time": 3528.789, "timestamp": "00:58:48", "text": "あなたにはどんなことが起こっているのですか？"}, {"type": "subtitle", "time": 3531.589, "timestamp": "00:58:51", "text": "えっと、サイ、話したいの？それとも"}, {"type": "subtitle", "time": 3534.309, "timestamp": "00:58:54", "text": "もう一回プレイしますか？ああ、私は大丈夫です"}, {"type": "subtitle", "time": 3536.47, "timestamp": "00:58:56", "text": "何でも。えっと、何分くらい"}]
[{"type": "subtitle", "time": 14341.429, "timestamp": "03:59:01", "text": "ええ、そう願っています。そうそう。今気づいた"}, {"type": "subtitle", "time": 14344.229, "timestamp": "03:59:04", "text": "例えば、外に出かけるときとか、"}, {"type": "subtitle", "time": 14346.71, "timestamp": "03:59:06", "text": "あなたの中には大使館のような雰囲気があるでしょう"}, {"type": "subtitle", "time": 14350.269, "timestamp": "03:59:10", "text": "あの大使館を通らなければならない。"}, {"type": "subtitle", "time": 14358.71, "timestamp": "03:59:18", "text": "それはすごいことになりそうだ。手に入れられるといいな"}, {"type": "subtitle", "time": 14360.63, "timestamp": "03:59:20", "text": "それを超えて。"}, {"type": "subtitle", "time": 14363.03, "timestamp": "03:59:23", "text": "うん。ただそこで働けばいいだけです。"}, {"type": "subtitle", "time": 14364.71, "timestamp": "03:59:24", "text": "州を適切に評価する必要があります"}, {"type": "subtitle", "time": 14367.75, "timestamp": "03:59:27", "text": "あなたの返品とその他すべて。 M 不思議だ"}, {"type": "subtitle", "time": 14370.79, "timestamp": "03:59:30", "text": "インドか、"}, {"type": "subtitle", "time": 14375.269, "timestamp": "03:59:35", "text": "あちらは日本です。おそらくインドでしょう。"}, {"type": "subtitle", "time": 14381.75, "timestamp": "03:59:41", "text": "うん。彼らはそうすると、あなたに許可します"}, {"type": "subtitle", "time": 14386.03, "timestamp": "03:59:46", "text": "旅行する。真実。真実。うん。ニース。"}, {"type": "subtitle", "time": 14388.71, "timestamp": "03:59:48", "text": "ニース。うん。うまくいくといいですね"}, {"type": "subtitle", "time": 14391.03, "timestamp": "03:59:51", "text": "実は。"}, {"type": "subtitle", "time": 14395.03, "timestamp": "03:59:55", "text": "うん。それを期待している。 M 私はそうすべきです"}, {"type": "subtitle", "time": 14398.15, "timestamp": "03:59:58", "text": "あなたが送る写真"}]
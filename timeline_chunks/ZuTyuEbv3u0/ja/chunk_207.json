[{"type": "subtitle", "time": 12427.75, "timestamp": "03:27:07", "text": "モジュリンゴ。ええ、私は、ええと、誰にもわからないと思います"}, {"type": "subtitle", "time": 12430.71, "timestamp": "03:27:10", "text": "もしかしたら、私も人間性を学ぶかもしれない。"}, {"type": "subtitle", "time": 12432.95, "timestamp": "03:27:12", "text": "おお、"}, {"type": "subtitle", "time": 12434.469, "timestamp": "03:27:14", "text": "わかった。冗談です。わかりました、それは"}, {"type": "subtitle", "time": 12436.07, "timestamp": "03:27:16", "text": "ブレインストーミングが多すぎるようなものだ。私は思う"}, {"type": "subtitle", "time": 12437.99, "timestamp": "03:27:17", "text": "うん、たぶん学ぶこと"}, {"type": "subtitle", "time": 12441.19, "timestamp": "03:27:21", "text": "南インドの言語すべてと彼"}, {"type": "subtitle", "time": 12449.19, "timestamp": "03:27:29", "text": "はい。そうそう。聞きたかったのですが"}, {"type": "subtitle", "time": 12451.55, "timestamp": "03:27:31", "text": "1秒。"}, {"type": "subtitle", "time": 12455.03, "timestamp": "03:27:35", "text": "えっと、共通の友人が一人いて、"}, {"type": "subtitle", "time": 12456.19, "timestamp": "03:27:36", "text": "持っていた、"}, {"type": "subtitle", "time": 12460.63, "timestamp": "03:27:40", "text": "右？えっと、覚えてる？"}, {"type": "subtitle", "time": 12465.59, "timestamp": "03:27:45", "text": "彼女を私たちのMinecraftサーバーに？私"}, {"type": "subtitle", "time": 12468.07, "timestamp": "03:27:48", "text": "あなたのMinecraftサーバーについて考えてみてください。忘れた"}, {"type": "subtitle", "time": 12470.55, "timestamp": "03:27:50", "text": "彼女とはどこで会ったんだっけ？忘れた。それ"}, {"type": "subtitle", "time": 12475.51, "timestamp": "03:27:55", "text": "えっと、名前は何でしたっけ？何"}, {"type": "subtitle", "time": 12477.19, "timestamp": "03:27:57", "text": "名前は？何てことだ。何が"}, {"type": "subtitle", "time": 12479.51, "timestamp": "03:27:59", "text": "名前？"}]
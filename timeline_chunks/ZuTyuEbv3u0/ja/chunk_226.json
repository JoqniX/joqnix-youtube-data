[{"type": "subtitle", "time": 13566.87, "timestamp": "03:46:06", "text": "そちらでの生活はいかがですか？"}, {"type": "subtitle", "time": 13568.71, "timestamp": "03:46:08", "text": "気候はいかがですか？"}, {"type": "subtitle", "time": 13571.349, "timestamp": "03:46:11", "text": "よし、兄弟？"}, {"type": "subtitle", "time": 13575.83, "timestamp": "03:46:15", "text": "ああ、雨が降って風も強くて"}, {"type": "subtitle", "time": 13579.75, "timestamp": "03:46:19", "text": "すべて。そして私は「わあ」と思った。ありますか"}, {"type": "subtitle", "time": 13581.75, "timestamp": "03:46:21", "text": "非常事態宣言か何かが出ているのは知っています"}, {"type": "subtitle", "time": 13584.87, "timestamp": "03:46:24", "text": "何が起こっているのか、それでも私は"}, {"type": "subtitle", "time": 13586.95, "timestamp": "03:46:26", "text": "濡れた。俺も同じだよ、兄弟。俺たちも赤を持ってるよ。"}, {"type": "subtitle", "time": 13590.95, "timestamp": "03:46:30", "text": "警告。うん、雨の量みたいに"}, {"type": "subtitle", "time": 13592.71, "timestamp": "03:46:32", "text": "洪水になりそうな感じで"}, {"type": "subtitle", "time": 13596.15, "timestamp": "03:46:36", "text": "いろいろなものがあって、私は「ああ、なんてことだ、これらすべて」と思いました。"}, {"type": "subtitle", "time": 13599.349, "timestamp": "03:46:39", "text": "私が出発する直前に起こる"}, {"type": "subtitle", "time": 13603.349, "timestamp": "03:46:43", "text": "日本。 「うん、つまり、もし私が"}, {"type": "subtitle", "time": 13605.99, "timestamp": "03:46:45", "text": "前回のように大きな"}, {"type": "subtitle", "time": 13608.55, "timestamp": "03:46:48", "text": "ここは洪水で、それが私に影響を与えるとは知りませんでした"}, {"type": "subtitle", "time": 13611.11, "timestamp": "03:46:51", "text": "私は海に近い街にいるので"}, {"type": "subtitle", "time": 13614.349, "timestamp": "03:46:54", "text": "もしくは何か。「あのやつ」のことですか？"}, {"type": "subtitle", "time": 13616.389, "timestamp": "03:46:56", "text": "ああ、待って。それは言えません。わかった、"}, {"type": "subtitle", "time": 13618.63, "timestamp": "03:46:58", "text": "どうでも。うん。そう、あの忌々しいやつだ。"}]
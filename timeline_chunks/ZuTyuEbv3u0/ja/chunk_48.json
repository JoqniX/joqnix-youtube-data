[{"type": "subtitle", "time": 2882.309, "timestamp": "00:48:02", "text": "ここには、きっと方法があるはずだ。あなたのような"}, {"type": "subtitle", "time": 2884.47, "timestamp": "00:48:04", "text": "分かってる、きっと方法があるはずだ。そこには"}, {"type": "subtitle", "time": 2885.829, "timestamp": "00:48:05", "text": "私ができるはずのことです"}, {"type": "subtitle", "time": 2888.33, "timestamp": "00:48:08", "text": "可能性としてはあり得る。"}, {"type": "subtitle", "time": 2889.51, "timestamp": "00:48:09", "text": "[音楽]"}, {"type": "subtitle", "time": 2893.03, "timestamp": "00:48:13", "text": "代わりにこちらを行ってください。はぁ？待って。何？何"}, {"type": "subtitle", "time": 2894.79, "timestamp": "00:48:14", "text": "ついさっき起こったこと？あなたは何をしましたか？ああ、"}, {"type": "subtitle", "time": 2897.349, "timestamp": "00:48:17", "text": "神。あなたはそれを考えましたか？"}, {"type": "subtitle", "time": 2900.47, "timestamp": "00:48:20", "text": "私は何もしていません。基本的に、えっと、"}, {"type": "subtitle", "time": 2903.67, "timestamp": "00:48:23", "text": "そうですね、移動したと思いますが、"}, {"type": "subtitle", "time": 2906.95, "timestamp": "00:48:26", "text": "ルークとキングを交換した"}, {"type": "subtitle", "time": 2908.99, "timestamp": "00:48:28", "text": "場所"}, {"type": "subtitle", "time": 2911.67, "timestamp": "00:48:31", "text": "高価です。確かそういう名前だったと思います。"}, {"type": "subtitle", "time": 2914.549, "timestamp": "00:48:34", "text": "私はゆっくり学んでいるので、あまり上手ではありません"}, {"type": "subtitle", "time": 2917.63, "timestamp": "00:48:37", "text": "それに取り組む。"}, {"type": "subtitle", "time": 2929.75, "timestamp": "00:48:49", "text": "私はピューピューと撃っています。"}, {"type": "subtitle", "time": 2938.23, "timestamp": "00:48:58", "text": "よし。よし、もう十分だ。何が"}]
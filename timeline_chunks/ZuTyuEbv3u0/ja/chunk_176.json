[{"type": "subtitle", "time": 10560.15, "timestamp": "02:56:00", "text": "あなたは卒業時に何を勉強するつもりですか？"}, {"type": "subtitle", "time": 10564.07, "timestamp": "02:56:04", "text": "今年大学を卒業しますか？ああ、大学ね。"}, {"type": "subtitle", "time": 10578.71, "timestamp": "02:56:18", "text": "こんにちは。こんにちは、ジョー。こんにちは、アレックス。どうやって、どうやって"}, {"type": "subtitle", "time": 10580.71, "timestamp": "02:56:20", "text": "何をしているの？"}, {"type": "subtitle", "time": 10584.23, "timestamp": "02:56:24", "text": "あなたは素晴らしいです。元気かい？どうやって"}, {"type": "subtitle", "time": 10584.91, "timestamp": "02:56:24", "text": "あなた"}, {"type": "subtitle", "time": 10587.51, "timestamp": "02:56:27", "text": "何をしているの？いらっしゃいませ。"}, {"type": "subtitle", "time": 10590.63, "timestamp": "02:56:30", "text": "わかった。さて、私の質問があります。"}, {"type": "subtitle", "time": 10592.79, "timestamp": "02:56:32", "text": "そうそう。まるで日本にいるみたい"}, {"type": "subtitle", "time": 10594.71, "timestamp": "02:56:34", "text": "そして、何か正しいことがあった。それで、"}, {"type": "subtitle", "time": 10596.19, "timestamp": "02:56:36", "text": "あなたが英語で"}, {"type": "subtitle", "time": 10599.91, "timestamp": "02:56:39", "text": "あなたが望むように、"}, {"type": "subtitle", "time": 10601.67, "timestamp": "02:56:41", "text": "日本に行くことを考えている"}, {"type": "subtitle", "time": 10608.309, "timestamp": "02:56:48", "text": "えっと、質問は何ですか？前に"}, {"type": "subtitle", "time": 10611.83, "timestamp": "02:56:51", "text": "日本に行くことを考えて"}, {"type": "subtitle", "time": 10613.59, "timestamp": "02:56:53", "text": "研究。"}, {"type": "subtitle", "time": 10614.95, "timestamp": "02:56:54", "text": "うん。うん。それを考える前に、"}, {"type": "subtitle", "time": 10616.15, "timestamp": "02:56:56", "text": "ほら、君でさえまだ知らない"}, {"type": "subtitle", "time": 10617.75, "timestamp": "02:56:57", "text": "勉強について考えたことはありますか？"}, {"type": "subtitle", "time": 10619.83, "timestamp": "02:56:59", "text": "日本で訪れたい場所、"}]
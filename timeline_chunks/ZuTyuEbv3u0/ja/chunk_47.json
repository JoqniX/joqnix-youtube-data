[{"type": "subtitle", "time": 2825.79, "timestamp": "00:47:05", "text": "いいえ、そうです。いいえ、大丈夫です。全て"}, {"type": "subtitle", "time": 2828.309, "timestamp": "00:47:08", "text": "良い。えっと、"}, {"type": "subtitle", "time": 2831.43, "timestamp": "00:47:11", "text": "チャット、チャット。チャット。わーい。"}, {"type": "subtitle", "time": 2833.99, "timestamp": "00:47:13", "text": "よし。何？今、何が起こったの？"}, {"type": "subtitle", "time": 2836.51, "timestamp": "00:47:16", "text": "今、何が起こったの？わからない。私はただ"}, {"type": "subtitle", "time": 2845.75, "timestamp": "00:47:25", "text": "何？"}, {"type": "subtitle", "time": 2849.27, "timestamp": "00:47:29", "text": "私はあなたの賢者を攻撃します。"}, {"type": "subtitle", "time": 2860.39, "timestamp": "00:47:40", "text": "いいえ。わかりました、わかりました。それはいいです。大丈夫です。"}, {"type": "subtitle", "time": 2863.829, "timestamp": "00:47:43", "text": "君のルークを手に入れたよ。"}, {"type": "subtitle", "time": 2867.069, "timestamp": "00:47:47", "text": "必ず捕まえてやる。女王様を捕まえてあげるよ"}, {"type": "subtitle", "time": 2869.829, "timestamp": "00:47:49", "text": "あまりにも。私はします。"}, {"type": "subtitle", "time": 2879.39, "timestamp": "00:47:59", "text": "よし。だから、もしあなたがそこにいて、私が"}]
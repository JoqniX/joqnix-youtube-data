[{"type": "subtitle", "time": 16511.99, "timestamp": "04:35:11", "text": "1つ？リンクを投稿してください。しかしそれは私を送り出さなかった"}, {"type": "subtitle", "time": 16513.83, "timestamp": "04:35:13", "text": "どこでも。もう一度やらなきゃいけないかも"}, {"type": "subtitle", "time": 16517.59, "timestamp": "04:35:17", "text": "方法。待って、リンクをKに投稿したの？"}, {"type": "subtitle", "time": 16534.429, "timestamp": "04:35:34", "text": "[音楽]"}, {"type": "subtitle", "time": 16544.15, "timestamp": "04:35:44", "text": "特徴。それは"}, {"type": "subtitle", "time": 16545.99, "timestamp": "04:35:45", "text": "待って、子供ポイント機能がある"}, {"type": "subtitle", "time": 16547.629, "timestamp": "04:35:47", "text": "キック。"}, {"type": "subtitle", "time": 16550.47, "timestamp": "04:35:50", "text": "何？待って、待って。有効にします。私"}, {"type": "subtitle", "time": 16552.109, "timestamp": "04:35:52", "text": "したい"}]
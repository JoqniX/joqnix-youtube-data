[{"type": "subtitle", "time": 12544.389, "timestamp": "03:29:04", "text": "人はそれぞれ生活や物事を抱えている。うん。"}, {"type": "subtitle", "time": 12546.71, "timestamp": "03:29:06", "text": "うん。つまり、少なくとも少なくとも"}, {"type": "subtitle", "time": 12548.71, "timestamp": "03:29:08", "text": "私が生きているかどうか確認できます"}, {"type": "subtitle", "time": 12550.469, "timestamp": "03:29:10", "text": "あるいは、私の顔と私の"}, {"type": "subtitle", "time": 12561.11, "timestamp": "03:29:21", "text": "そうそう。昔は君は君だった"}, {"type": "subtitle", "time": 12564.71, "timestamp": "03:29:24", "text": "彼らはそれについて率直だった。つまり、私が最初です"}, {"type": "subtitle", "time": 12566.15, "timestamp": "03:29:26", "text": "グループの中で私の"}, {"type": "subtitle", "time": 12567.55, "timestamp": "03:29:27", "text": "もの。"}, {"type": "subtitle", "time": 12570.71, "timestamp": "03:29:30", "text": "うん、私はこう思ったよ、彼らは本当に"}, {"type": "subtitle", "time": 12574.07, "timestamp": "03:29:34", "text": "勇敢な。私も愛を好きになることを学ぶべきだ"}, {"type": "subtitle", "time": 12576.389, "timestamp": "03:29:36", "text": "私の店で実際に写真を撮る"}, {"type": "subtitle", "time": 12578.55, "timestamp": "03:29:38", "text": "自分のことや物、自撮り写真など"}, {"type": "subtitle", "time": 12580.429, "timestamp": "03:29:40", "text": "もの。それはとても"}, {"type": "subtitle", "time": 12582.03, "timestamp": "03:29:42", "text": "いいね。"}, {"type": "subtitle", "time": 12584.63, "timestamp": "03:29:44", "text": "うん。でも、あなたが最初の人だった"}, {"type": "subtitle", "time": 12587.71, "timestamp": "03:29:47", "text": "グループチャットで。彼女"}, {"type": "subtitle", "time": 12590.469, "timestamp": "03:29:50", "text": "話し合いの後、他の全員が話し始めました"}, {"type": "subtitle", "time": 12593.429, "timestamp": "03:29:53", "text": "フォローする。"}, {"type": "subtitle", "time": 12596.229, "timestamp": "03:29:56", "text": "つまり、そう、私はいくつか欲しい"}]
[{"type": "subtitle", "time": 1261.909, "timestamp": "00:21:01", "text": "配信していた。私は"}, {"type": "subtitle", "time": 1264.35, "timestamp": "00:21:04", "text": "出会った人全員とつながりを持つ"}, {"type": "subtitle", "time": 1269.11, "timestamp": "00:21:09", "text": "ここで話をして、ぶらぶらする"}, {"type": "subtitle", "time": 1271.27, "timestamp": "00:21:11", "text": "彼らと一緒に出かけて、思い出せるように"}, {"type": "subtitle", "time": 1274.789, "timestamp": "00:21:14", "text": "日本から来た人たちが、"}, {"type": "subtitle", "time": 1279.19, "timestamp": "00:21:19", "text": "私は7月に日本に行きます。そうなんです、"}, {"type": "subtitle", "time": 1281.75, "timestamp": "00:21:21", "text": "あなたがそうなって本当に本当に嬉しいです、"}, {"type": "subtitle", "time": 1284.63, "timestamp": "00:21:24", "text": "ほら、自分のやりたいこと、好きなことをするんだよ。"}, {"type": "subtitle", "time": 1288.95, "timestamp": "00:21:28", "text": "あなたにも幸運をお祈りします。"}, {"type": "subtitle", "time": 1292.87, "timestamp": "00:21:32", "text": "そして、配信78日目おめでとうございます。"}, {"type": "subtitle", "time": 1296.549, "timestamp": "00:21:36", "text": "正直言って、あなたは本当に素晴らしい。あなたが知っている"}, {"type": "subtitle", "time": 1301.43, "timestamp": "00:21:41", "text": "それ。ああ、なんてことだ。ああ、わかってるよ。私はただ"}, {"type": "subtitle", "time": 1304.71, "timestamp": "00:21:44", "text": "愛による慰めの中で。"}, {"type": "subtitle", "time": 1307.029, "timestamp": "00:21:47", "text": "本当に、本当に誇りに思っています"}, {"type": "subtitle", "time": 1309.35, "timestamp": "00:21:49", "text": "あなたの。私が言えるのはそれだけです。"}, {"type": "subtitle", "time": 1311.51, "timestamp": "00:21:51", "text": "まるで、あなたがそれを知っているかのように"}, {"type": "subtitle", "time": 1314.71, "timestamp": "00:21:54", "text": "いつも私からやりすぎなくらいだけど、"}, {"type": "subtitle", "time": 1317.029, "timestamp": "00:21:57", "text": "先輩、本当に本当に誇りに思います。のように"}]
[{"type": "subtitle", "time": 8462.23, "timestamp": "02:21:02", "text": "チェンナイで書いた"}, {"type": "subtitle", "time": 8463.79, "timestamp": "02:21:03", "text": "えーと"}, {"type": "subtitle", "time": 8467.51, "timestamp": "02:21:07", "text": "えっと、いつだったかな？えっと、2月か"}, {"type": "subtitle", "time": 8469.309, "timestamp": "02:21:09", "text": "何か。ええ、2月に私は"}, {"type": "subtitle", "time": 8472.389, "timestamp": "02:21:12", "text": "テスト。 2月1月にその試験を受けました"}, {"type": "subtitle", "time": 8475.349, "timestamp": "02:21:15", "text": "そして私はあなたを追い越しました。私は何だったのか"}, {"type": "subtitle", "time": 8478.23, "timestamp": "02:21:18", "text": "実際、その時点での私の状態はそうでした。待って、"}, {"type": "subtitle", "time": 8481.75, "timestamp": "02:21:21", "text": "待って。あなたは、あなたは近かった。"}, {"type": "subtitle", "time": 8483.75, "timestamp": "02:21:23", "text": "つまり、私の母語である中国語から"}, {"type": "subtitle", "time": 8486.15, "timestamp": "02:21:26", "text": "かなり近いですね。"}, {"type": "subtitle", "time": 8492.15, "timestamp": "02:21:32", "text": "えっと、待って。あの、ABK doaiって知ってますか？"}, {"type": "subtitle", "time": 8494.83, "timestamp": "02:21:34", "text": "いえ、申し訳ありません"}, {"type": "subtitle", "time": 8497.83, "timestamp": "02:21:37", "text": "待って、今の状況を教えます"}, {"type": "subtitle", "time": 8501.429, "timestamp": "02:21:41", "text": "位置。あれは試験のことだった。それ"}, {"type": "subtitle", "time": 8503.63, "timestamp": "02:21:43", "text": "えっと、それは"}, {"type": "subtitle", "time": 8512.11, "timestamp": "02:21:52", "text": "私は思う"}, {"type": "subtitle", "time": 8517.19, "timestamp": "02:21:57", "text": "つまり、後でじっくり考えてみます。"}, {"type": "subtitle", "time": 8519.51, "timestamp": "02:21:59", "text": "こんにちは。こんにちは。私は、私は得意ではありません"}]
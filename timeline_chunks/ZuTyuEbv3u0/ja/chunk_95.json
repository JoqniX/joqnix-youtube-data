[{"type": "subtitle", "time": 5702.91, "timestamp": "01:35:02", "text": "文字通り何と呼ぶのか"}, {"type": "subtitle", "time": 5704.83, "timestamp": "01:35:04", "text": "それ？私は"}, {"type": "subtitle", "time": 5707.35, "timestamp": "01:35:07", "text": "もう仕組まれてる？リギングを開始した"}, {"type": "subtitle", "time": 5710.39, "timestamp": "01:35:10", "text": "ここまで処理しました。でも私は仕掛けを仕掛けてきた"}, {"type": "subtitle", "time": 5714.91, "timestamp": "01:35:14", "text": "州もその他すべて。それで"}, {"type": "subtitle", "time": 5717.55, "timestamp": "01:35:17", "text": "ええ、もちろんです。もちろん。しかし"}, {"type": "subtitle", "time": 5721.35, "timestamp": "01:35:21", "text": "はい。うん。でも、心配です。えっと、私は"}, {"type": "subtitle", "time": 5723.75, "timestamp": "01:35:23", "text": "私は彼女のツイートを見た"}, {"type": "subtitle", "time": 5726.149, "timestamp": "01:35:26", "text": "彼女はこれからも服用を続けるだろう"}, {"type": "subtitle", "time": 5729.51, "timestamp": "01:35:29", "text": "個人によるリクエスト"}, {"type": "subtitle", "time": 5731.91, "timestamp": "01:35:31", "text": "そして、今でも彼らを全面的に支持している。"}, {"type": "subtitle", "time": 5734.629, "timestamp": "01:35:34", "text": "でも、彼女はどちらかというと"}, {"type": "subtitle", "time": 5738.27, "timestamp": "01:35:38", "text": "スタジオと一緒に行くようにみんなに伝えています"}, {"type": "subtitle", "time": 5742.07, "timestamp": "01:35:42", "text": "今。ええ、もちろん嬉しいです。"}, {"type": "subtitle", "time": 5745.07, "timestamp": "01:35:45", "text": "ただ、チューブは高価です"}, {"type": "subtitle", "time": 5747.91, "timestamp": "01:35:47", "text": "高価で"}, {"type": "subtitle", "time": 5750.149, "timestamp": "01:35:50", "text": "えーと"}, {"type": "subtitle", "time": 5758.57, "timestamp": "01:35:58", "text": "えっと、私は"}]
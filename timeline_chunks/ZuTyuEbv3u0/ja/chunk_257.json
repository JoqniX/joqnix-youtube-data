[{"type": "subtitle", "time": 15423.469, "timestamp": "04:17:03", "text": "私のものにも使ってください。えっと"}, {"type": "subtitle", "time": 15426.229, "timestamp": "04:17:06", "text": "2000人ちょっと。"}, {"type": "subtitle", "time": 15430.389, "timestamp": "04:17:10", "text": "下に書かないでください"}, {"type": "subtitle", "time": 15433.91, "timestamp": "04:17:13", "text": "ああ、それは昔の話だ"}, {"type": "subtitle", "time": 15437.189, "timestamp": "04:17:17", "text": "2018年。以前は50万人で配信していました。"}, {"type": "subtitle", "time": 15443.269, "timestamp": "04:17:23", "text": "もの。それはとてもとてもとてもえーっと"}, {"type": "subtitle", "time": 15446.149, "timestamp": "04:17:26", "text": "ぼやけた感じのもの。"}, {"type": "subtitle", "time": 15448.07, "timestamp": "04:17:28", "text": "うん。両方試した唯一の機会"}, {"type": "subtitle", "time": 15456.429, "timestamp": "04:17:36", "text": "うん。そして、これはシングルプレイヤーモードの話です。"}, {"type": "subtitle", "time": 15459.59, "timestamp": "04:17:39", "text": "ああ、こんにちは、ディン。ストリームへようこそ"}, {"type": "subtitle", "time": 15462.95, "timestamp": "04:17:42", "text": "キック。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 15473.11, "timestamp": "04:17:53", "text": "ああ、君は合格だ。うん。つまり、4つのプラットフォームということですね。"}, {"type": "subtitle", "time": 15475.59, "timestamp": "04:17:55", "text": "私はビリー・ビリーに出演する予定だったのですが、"}, {"type": "subtitle", "time": 15478.469, "timestamp": "04:17:58", "text": "私が依頼した代理店は私を助けてくれ、"}]
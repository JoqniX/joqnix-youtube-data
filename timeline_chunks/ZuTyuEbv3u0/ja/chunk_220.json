[{"type": "subtitle", "time": 13205.51, "timestamp": "03:40:05", "text": "なんてこった。くそ。でも、私は一緒に暮らしていました"}, {"type": "subtitle", "time": 13208.309, "timestamp": "03:40:08", "text": "私はカトウの家に滞在していました"}, {"type": "subtitle", "time": 13211.19, "timestamp": "03:40:11", "text": "今。だから彼の母親は私にたくさん食べさせてくれた"}, {"type": "subtitle", "time": 13214.389, "timestamp": "03:40:14", "text": "いろいろなことがあって、私は「アンディ、無理だよ」って感じ。私"}, {"type": "subtitle", "time": 13217.51, "timestamp": "03:40:17", "text": "できません。お腹がいっぱいです。"}, {"type": "subtitle", "time": 13221.11, "timestamp": "03:40:21", "text": "彼らは英語を理解しますか？そうそう。えっと"}, {"type": "subtitle", "time": 13225.03, "timestamp": "03:40:25", "text": "彼女の母親はマラヤーラム語を知っているが、"}, {"type": "subtitle", "time": 13228.07, "timestamp": "03:40:28", "text": "彼女は半分マラリだったが、彼女もそれを知っている"}, {"type": "subtitle", "time": 13238.389, "timestamp": "03:40:38", "text": "はい。でも、それは良い経験だった。しかし"}, {"type": "subtitle", "time": 13240.87, "timestamp": "03:40:40", "text": "ポエニ戦争で唯一嫌いなのは"}, {"type": "subtitle", "time": 13243.19, "timestamp": "03:40:43", "text": "その旅行全体は"}, {"type": "subtitle", "time": 13245.91, "timestamp": "03:40:45", "text": "インドの電車みたいなやつ。"}, {"type": "subtitle", "time": 13248.63, "timestamp": "03:40:48", "text": "うん。うん。席が取れなかった"}, {"type": "subtitle", "time": 13251.59, "timestamp": "03:40:51", "text": "帰宅途中に。私は文字通り"}, {"type": "subtitle", "time": 13255.67, "timestamp": "03:40:55", "text": "ジャンプはしない、席を移動しない"}, {"type": "subtitle", "time": 13257.51, "timestamp": "03:40:57", "text": "時間。"}]
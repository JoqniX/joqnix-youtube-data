[{"type": "subtitle", "time": 11040.389, "timestamp": "03:04:00", "text": "配信はミュートされていませんよね？なぜなら"}, {"type": "subtitle", "time": 11042.95, "timestamp": "03:04:02", "text": "私は、あなたが話していたことを望んでいません。あなた"}, {"type": "subtitle", "time": 11045.51, "timestamp": "03:04:05", "text": "話していた。えっと、私は彼らからミュートされていました。"}, {"type": "subtitle", "time": 11049.51, "timestamp": "03:04:09", "text": "うん。心配ない。"}, {"type": "subtitle", "time": 11051.269, "timestamp": "03:04:11", "text": "わかった。"}, {"type": "subtitle", "time": 11054.71, "timestamp": "03:04:14", "text": "うん。たくさんのこと。"}, {"type": "subtitle", "time": 11056.389, "timestamp": "03:04:16", "text": "うん。多くの物事と同じように。うん。私たちは"}, {"type": "subtitle", "time": 11058.389, "timestamp": "03:04:18", "text": "今はちょうど追いついているところです"}, {"type": "subtitle", "time": 11060.23, "timestamp": "03:04:20", "text": "私たちが語り合うために作ったもの。私はしません"}, {"type": "subtitle", "time": 11063.63, "timestamp": "03:04:23", "text": "まだ考えていない。"}, {"type": "subtitle", "time": 11066.87, "timestamp": "03:04:26", "text": "うん。そして、私たちが近況を報告し合えるのが嬉しい。"}, {"type": "subtitle", "time": 11069.349, "timestamp": "03:04:29", "text": "今は時間がなかったと思います"}, {"type": "subtitle", "time": 11071.83, "timestamp": "03:04:31", "text": "追いついたり、いろいろと。あなたはビシーでした"}, {"type": "subtitle", "time": 11073.309, "timestamp": "03:04:33", "text": "そして私は"}, {"type": "subtitle", "time": 11076.87, "timestamp": "03:04:36", "text": "占有されています。うん。うん。私はほぼ"}, {"type": "subtitle", "time": 11078.79, "timestamp": "03:04:38", "text": "夜は空いていて、それから"}, {"type": "subtitle", "time": 11084.429, "timestamp": "03:04:44", "text": "[音楽]"}, {"type": "subtitle", "time": 11087.83, "timestamp": "03:04:47", "text": "うーん"}, {"type": "subtitle", "time": 11089.19, "timestamp": "03:04:49", "text": "ねえ、私、ちょっと欲しいんだけど"}, {"type": "subtitle", "time": 11092.71, "timestamp": "03:04:52", "text": "ノートパソコンは少なくとも1年くらいは"}, {"type": "subtitle", "time": 11094.6, "timestamp": "03:04:54", "text": "以前。"}, {"type": "subtitle", "time": 11096.07, "timestamp": "03:04:56", "text": "[音楽]"}, {"type": "subtitle", "time": 11098.23, "timestamp": "03:04:58", "text": "ええ、私はその機会が好きだからです"}]
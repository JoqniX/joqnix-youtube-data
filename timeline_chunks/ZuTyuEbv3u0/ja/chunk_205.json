[{"type": "subtitle", "time": 12303.55, "timestamp": "03:25:03", "text": "気軽に立ち寄って挨拶してください。感謝"}, {"type": "subtitle", "time": 12307.03, "timestamp": "03:25:07", "text": "あなた。おやすみなさい。うん、いいよ"}, {"type": "subtitle", "time": 12308.95, "timestamp": "03:25:08", "text": "夜。"}, {"type": "subtitle", "time": 12311.91, "timestamp": "03:25:11", "text": "終端部分も確認できます。"}, {"type": "subtitle", "time": 12313.269, "timestamp": "03:25:13", "text": "だから、私がどんなビデオを撮るかはお分かりでしょう"}, {"type": "subtitle", "time": 12322.63, "timestamp": "03:25:22", "text": "うん。誰かが警告した内容は何だったのか"}, {"type": "subtitle", "time": 12325.75, "timestamp": "03:25:25", "text": "Twitchとかでフォローしてよ？"}, {"type": "subtitle", "time": 12328.309, "timestamp": "03:25:28", "text": "うん。"}, {"type": "subtitle", "time": 12332.309, "timestamp": "03:25:32", "text": "だから、気に入ったよ。くそ。どうやってやるんですか？"}, {"type": "subtitle", "time": 12335.75, "timestamp": "03:25:35", "text": "私はみんなが私が"}, {"type": "subtitle", "time": 12338.07, "timestamp": "03:25:38", "text": "私は技術系の仕事をしているので、勉強したり何かしたりしています。"}, {"type": "chat", "time": 12338.279, "timestamp": "03:25:38", "author": "@AerinViolet", "avatar": "https://yt4.ggpht.com/UKawanVvntNiAwz6RWv6wPk_S8YwApvPcCfLApO-du_RbQRIPGtzJ5FTt1DCNmZFJWc_2vxlqw=s64-c-k-c0x00ffffff-no-rj", "message": "good night to you two too 😴"}, {"type": "subtitle", "time": 12340.309, "timestamp": "03:25:40", "text": "支援とか、そういうもの。しかし実際には、"}, {"type": "subtitle", "time": 12346.71, "timestamp": "03:25:46", "text": "うん。つまり、つまり、同じように"}, {"type": "subtitle", "time": 12349.03, "timestamp": "03:25:49", "text": "私のクラスメートは私が得意だと思っている"}, {"type": "subtitle", "time": 12351.67, "timestamp": "03:25:51", "text": "コーディングは、私が読み取れるから"}, {"type": "subtitle", "time": 12353.19, "timestamp": "03:25:53", "text": "エラーは、たとえそれが"}, {"type": "subtitle", "time": 12355.19, "timestamp": "03:25:55", "text": "おそらく最終的にはクリアするだろう"}, {"type": "subtitle", "time": 12358.469, "timestamp": "03:25:58", "text": "陽気さで。"}]
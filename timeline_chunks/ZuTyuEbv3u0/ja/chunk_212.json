[{"type": "subtitle", "time": 12723.429, "timestamp": "03:32:03", "text": "全てが恋しい。カレー料理"}, {"type": "subtitle", "time": 12726.83, "timestamp": "03:32:06", "text": "チキンカレー、サンバル"}, {"type": "subtitle", "time": 12729.51, "timestamp": "03:32:09", "text": "どれも美味しい。そうそう。何ですか"}, {"type": "subtitle", "time": 12732.71, "timestamp": "03:32:12", "text": "あなたの好きな食べ物は？あなたは言いましたか"}, {"type": "subtitle", "time": 12735.03, "timestamp": "03:32:15", "text": "好きな食べ物は？"}, {"type": "subtitle", "time": 12738.87, "timestamp": "03:32:18", "text": "えっと、彼女はどんな食べ物が好きですか？"}, {"type": "subtitle", "time": 12745.269, "timestamp": "03:32:25", "text": "何と一緒に食べるのが好きですか？"}, {"type": "subtitle", "time": 12747.03, "timestamp": "03:32:27", "text": "パラタ？"}, {"type": "subtitle", "time": 12754.71, "timestamp": "03:32:34", "text": "ニース。"}, {"type": "subtitle", "time": 12757.51, "timestamp": "03:32:37", "text": "昔、彼が"}, {"type": "subtitle", "time": 12759.51, "timestamp": "03:32:39", "text": "「うん」って言ってる。"}, {"type": "subtitle", "time": 12762.309, "timestamp": "03:32:42", "text": "サンバルと一緒にご飯を食べるのに飽きたし、"}, {"type": "subtitle", "time": 12765.349, "timestamp": "03:32:45", "text": "もの。何か別のものを食べたいし"}, {"type": "subtitle", "time": 12766.87, "timestamp": "03:32:46", "text": "もの。"}, {"type": "subtitle", "time": 12768.55, "timestamp": "03:32:48", "text": "私はまだご飯を食べていますが、"}, {"type": "subtitle", "time": 12771.269, "timestamp": "03:32:51", "text": "今は、"}, {"type": "subtitle", "time": 12774.79, "timestamp": "03:32:54", "text": "すべて、そして私は「ああ、私は24歳だ」と言います。"}, {"type": "subtitle", "time": 12778.229, "timestamp": "03:32:58", "text": "24回だけど、うん、1日に3回か4回"}]
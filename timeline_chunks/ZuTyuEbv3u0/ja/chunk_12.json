[{"type": "subtitle", "time": 723.19, "timestamp": "00:12:03", "text": "メル、夕食を買ってきて戻ってきて。"}, {"type": "subtitle", "time": 734.15, "timestamp": "00:12:14", "text": "何てことだ。何てことだ。何てことだ。ひっくり返せ。"}, {"type": "subtitle", "time": 736.069, "timestamp": "00:12:16", "text": "私はあなたの世界に参加してみます"}, {"type": "subtitle", "time": 772.31, "timestamp": "00:12:52", "text": "ジェイドは、"}, {"type": "subtitle", "time": 774.15, "timestamp": "00:12:54", "text": "救世主たち。どうやら彼らは人々を手に入れることができるようだ"}, {"type": "subtitle", "time": 776.71, "timestamp": "00:12:56", "text": "セクターゼロへ。私はそれらを見つけなければならず、"}, {"type": "subtitle", "time": 778.55, "timestamp": "00:12:58", "text": "彼女の連絡先を探す。アマンダ、私は"}]
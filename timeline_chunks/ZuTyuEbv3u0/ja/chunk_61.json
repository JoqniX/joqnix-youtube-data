[{"type": "subtitle", "time": 3663.03, "timestamp": "01:01:03", "text": "まるで追いつけなかったみたいで、"}, {"type": "subtitle", "time": 3665.43, "timestamp": "01:01:05", "text": "ふと気づいたんだけど、君にこんなメッセージを送ったと思う。"}, {"type": "subtitle", "time": 3668.15, "timestamp": "01:01:08", "text": "文字通りパニック状態"}, {"type": "subtitle", "time": 3671.589, "timestamp": "01:01:11", "text": "モード。私はこう思った。でも私はここにいる、私は"}, {"type": "subtitle", "time": 3673.91, "timestamp": "01:01:13", "text": "自転車をセットアップした。ごめんなさい。そして私は"}, {"type": "subtitle", "time": 3675.67, "timestamp": "01:01:15", "text": "まあ、いいんじゃない。"}, {"type": "subtitle", "time": 3680.15, "timestamp": "01:01:20", "text": "ええ、時間はちゃんと見つけますよ。今月私は"}, {"type": "subtitle", "time": 3683.589, "timestamp": "01:01:23", "text": "来月あたりに試してみようと思うけど"}, {"type": "subtitle", "time": 3686.95, "timestamp": "01:01:26", "text": "できる限り眠るように努力します。"}, {"type": "subtitle", "time": 3689.829, "timestamp": "01:01:29", "text": "なんで子供が"}, {"type": "subtitle", "time": 3693.27, "timestamp": "01:01:33", "text": "彼女は忘れて、疲れて、眠ってしまった"}, {"type": "subtitle", "time": 3696.309, "timestamp": "01:01:36", "text": "オフとか、何か。好きになることを考えていました"}, {"type": "subtitle", "time": 3698.23, "timestamp": "01:01:38", "text": "あなたのために別の日を手配するか、"}, {"type": "subtitle", "time": 3699.349, "timestamp": "01:01:39", "text": "何か。"}, {"type": "subtitle", "time": 3703.27, "timestamp": "01:01:43", "text": "私にとって、それを維持するのは非常に難しいです"}, {"type": "subtitle", "time": 3709.589, "timestamp": "01:01:49", "text": "どこにでも触れると、ええ、ただ、"}, {"type": "subtitle", "time": 3712.95, "timestamp": "01:01:52", "text": "私にとってオンライン状態を維持するのは本当に難しい"}, {"type": "subtitle", "time": 3715.67, "timestamp": "01:01:55", "text": "実際、私はそうは思わないと思います"}, {"type": "subtitle", "time": 3717.27, "timestamp": "01:01:57", "text": "皆さんもご存知の通り、私は"}]
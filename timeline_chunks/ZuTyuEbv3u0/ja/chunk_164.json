[{"type": "subtitle", "time": 9840.63, "timestamp": "02:44:00", "text": "そして皆と繋がる"}, {"type": "subtitle", "time": 9844.389, "timestamp": "02:44:04", "text": "そして、そう、それはむしろ"}, {"type": "subtitle", "time": 9847.59, "timestamp": "02:44:07", "text": "来月から新たな章が始まります。それで、"}, {"type": "subtitle", "time": 9850.389, "timestamp": "02:44:10", "text": "「うん、やってみよう。"}, {"type": "subtitle", "time": 9853.83, "timestamp": "02:44:13", "text": "ジョーカーの件だけだけど、ただ"}, {"type": "subtitle", "time": 9857.269, "timestamp": "02:44:17", "text": "うん。単に楽しいことのためだけじゃない、"}, {"type": "subtitle", "time": 9860.23, "timestamp": "02:44:20", "text": "モデルのためだが、それでもただそれを行うだけ"}, {"type": "subtitle", "time": 9862.309, "timestamp": "02:44:22", "text": "自分自身を大切にして、楽しむ。それが"}, {"type": "subtitle", "time": 9864.07, "timestamp": "02:44:24", "text": "重要なことだ。"}, {"type": "subtitle", "time": 9865.67, "timestamp": "02:44:25", "text": "うん。だって、いや、私はこう考えているんだ"}, {"type": "subtitle", "time": 9867.429, "timestamp": "02:44:27", "text": "あなたは文字通りすべての人とつながるのが好きです"}, {"type": "subtitle", "time": 9868.95, "timestamp": "02:44:28", "text": "あなたが好きな人、あなたが知っている人が行方不明"}, {"type": "subtitle", "time": 9871.429, "timestamp": "02:44:31", "text": "ずっとチャットしたり、"}, {"type": "subtitle", "time": 9872.99, "timestamp": "02:44:32", "text": "ご存知のように"}, {"type": "subtitle", "time": 9875.269, "timestamp": "02:44:35", "text": "[音楽]"}, {"type": "subtitle", "time": 9876.79, "timestamp": "02:44:36", "text": "うん、新しいものを見るのが好き"}, {"type": "subtitle", "time": 9879.95, "timestamp": "02:44:39", "text": "毎日ゲストが訪れます。"}, {"type": "subtitle", "time": 9883.83, "timestamp": "02:44:43", "text": "ええ、今から、そしてこれから先もずっと"}, {"type": "subtitle", "time": 9885.63, "timestamp": "02:44:45", "text": "えーっと、いくつか"}, {"type": "subtitle", "time": 9889.03, "timestamp": "02:44:49", "text": "みんなが好むのは"}, {"type": "subtitle", "time": 9891.269, "timestamp": "02:44:51", "text": "この時間帯の夜とか"}, {"type": "subtitle", "time": 9894.87, "timestamp": "02:44:54", "text": "6から10、11、12くらいかな。だから難しいんだ"}, {"type": "subtitle", "time": 9896.95, "timestamp": "02:44:56", "text": "全員連れて行く。もし私がそれを"}]
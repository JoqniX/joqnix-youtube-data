[{"type": "subtitle", "time": 5762.83, "timestamp": "01:36:02", "text": "[音楽]"}, {"type": "subtitle", "time": 5772.07, "timestamp": "01:36:12", "text": "2番。うん、最高だよ"}, {"type": "subtitle", "time": 5773.91, "timestamp": "01:36:13", "text": "高い。そこが問題なんです。スタンド"}, {"type": "subtitle", "time": 5776.75, "timestamp": "01:36:16", "text": "品質基準は高くなるだろう"}, {"type": "subtitle", "time": 5779.51, "timestamp": "01:36:19", "text": "十分。それは一つの点だ。でも、ほら、"}, {"type": "subtitle", "time": 5786.81, "timestamp": "01:36:26", "text": "実は。"}, {"type": "subtitle", "time": 5807.75, "timestamp": "01:36:47", "text": "ええ、実際にあくびをしているという事実"}, {"type": "subtitle", "time": 5811.35, "timestamp": "01:36:51", "text": "心配なことがたくさん"}, {"type": "subtitle", "time": 5814.03, "timestamp": "01:36:54", "text": "少し"}, {"type": "subtitle", "time": 5817.03, "timestamp": "01:36:57", "text": "実際にあくびをして眠くなるのは失礼だ"}]
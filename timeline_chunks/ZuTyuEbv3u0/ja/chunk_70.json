[{"type": "subtitle", "time": 4206.47, "timestamp": "01:10:06", "text": "彼女を見つけろ。君にはがっかりしたよ。ジョーク。"}, {"type": "subtitle", "time": 4208.87, "timestamp": "01:10:08", "text": "どういう意味ですか？私はこんな高級なものは食べない"}, {"type": "subtitle", "time": 4211.83, "timestamp": "01:10:11", "text": "私が"}, {"type": "subtitle", "time": 4219.43, "timestamp": "01:10:19", "text": "もの。私は今、それをやっています。でも、そうですね、私は"}, {"type": "subtitle", "time": 4222.709, "timestamp": "01:10:22", "text": "絶対に気づかれないよ。わかった。わかった。あなた"}, {"type": "subtitle", "time": 4224.79, "timestamp": "01:10:24", "text": "何が起こるかわからない。わかった。あなたはそれを知ることはないでしょう。"}, {"type": "subtitle", "time": 4226.669, "timestamp": "01:10:26", "text": "わかった。その"}, {"type": "subtitle", "time": 4230.229, "timestamp": "01:10:30", "text": "モモ。モモ。"}, {"type": "subtitle", "time": 4232.95, "timestamp": "01:10:32", "text": "それはモモではありません。"}, {"type": "subtitle", "time": 4238.27, "timestamp": "01:10:38", "text": "モモ。"}, {"type": "subtitle", "time": 4241.83, "timestamp": "01:10:41", "text": "もちろん。あなたが何を言っても構いません。"}, {"type": "subtitle", "time": 4243.99, "timestamp": "01:10:43", "text": "はい、はい、はい、はい、はい。わかった。"}, {"type": "subtitle", "time": 4251.75, "timestamp": "01:10:51", "text": "本日はお招きいただきありがとうございました。"}, {"type": "subtitle", "time": 4255.189, "timestamp": "01:10:55", "text": "ストリーム。ありがとう。ありがとう。それは、"}, {"type": "subtitle", "time": 4259.51, "timestamp": "01:10:59", "text": "覚えておくべきことや大切にすべきことがたくさんあります"}]
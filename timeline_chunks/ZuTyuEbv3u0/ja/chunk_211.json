[{"type": "subtitle", "time": 12660.79, "timestamp": "03:31:00", "text": "悪い。悪い。だから、私が確実に"}, {"type": "subtitle", "time": 12663.59, "timestamp": "03:31:03", "text": "何とかして何かをする。"}, {"type": "subtitle", "time": 12666.55, "timestamp": "03:31:06", "text": "うん。でも、私には理解できない。 YouTube の方法"}, {"type": "subtitle", "time": 12668.15, "timestamp": "03:31:08", "text": "うまくいく？たとえあなたが"}, {"type": "subtitle", "time": 12671.269, "timestamp": "03:31:11", "text": "ビデオは、えっと、"}, {"type": "subtitle", "time": 12673.59, "timestamp": "03:31:13", "text": "あなたのチャンネルがアクティブであると認識している人や、"}, {"type": "subtitle", "time": 12675.75, "timestamp": "03:31:15", "text": "何か？でも、まだ持っていると思います"}, {"type": "subtitle", "time": 12678.389, "timestamp": "03:31:18", "text": "今すぐアップロードします。問題は、"}, {"type": "subtitle", "time": 12680.79, "timestamp": "03:31:20", "text": "動画は、えーっと、入り込むような感じである必要があります"}, {"type": "subtitle", "time": 12682.309, "timestamp": "03:31:22", "text": "人々が好むアルゴリズム"}, {"type": "subtitle", "time": 12684.63, "timestamp": "03:31:24", "text": "見てみて、あそこで見てみて"}, {"type": "subtitle", "time": 12686.229, "timestamp": "03:31:26", "text": "ホームページ。"}, {"type": "subtitle", "time": 12688.87, "timestamp": "03:31:28", "text": "えっと"}, {"type": "subtitle", "time": 12690.229, "timestamp": "03:31:30", "text": "基本的にこの時点では、"}, {"type": "subtitle", "time": 12693.51, "timestamp": "03:31:33", "text": "より効果的なのはおそらく注射だろう。"}, {"type": "subtitle", "time": 12696.63, "timestamp": "03:31:36", "text": "ああ、ショットね。"}, {"type": "subtitle", "time": 12699.11, "timestamp": "03:31:39", "text": "ああ、そこに時計を入れると"}, {"type": "subtitle", "time": 12700.63, "timestamp": "03:31:40", "text": "簡単かもしれないし、もっと"}, {"type": "subtitle", "time": 12702.81, "timestamp": "03:31:42", "text": "動画よりも連続的。"}, {"type": "subtitle", "time": 12705.79, "timestamp": "03:31:45", "text": "[音楽]"}, {"type": "subtitle", "time": 12712.75, "timestamp": "03:31:52", "text": "そうなんです、そこが問題なんです。"}, {"type": "subtitle", "time": 12716.07, "timestamp": "03:31:56", "text": "うん。それで、私は見逃すつもりです"}, {"type": "subtitle", "time": 12719.03, "timestamp": "03:31:59", "text": "一度そこへ行けば、ここからの食べ物が食べられます。私はします"}]
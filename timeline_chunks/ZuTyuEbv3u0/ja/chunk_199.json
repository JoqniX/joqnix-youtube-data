[{"type": "subtitle", "time": 11940.87, "timestamp": "03:19:00", "text": "少なくとも3ヶ国語に堪能であること。"}, {"type": "subtitle", "time": 11942.269, "timestamp": "03:19:02", "text": "うん。"}, {"type": "subtitle", "time": 11948.71, "timestamp": "03:19:08", "text": "英語とタミル語ですね。"}, {"type": "subtitle", "time": 11950.55, "timestamp": "03:19:10", "text": "またはそれ以上"}, {"type": "subtitle", "time": 11952.63, "timestamp": "03:19:12", "text": "マリリストのようなものすべてと共に、"}, {"type": "subtitle", "time": 11954.389, "timestamp": "03:19:14", "text": "タミル人がいて、カナダには"}, {"type": "subtitle", "time": 11956.07, "timestamp": "03:19:16", "text": "人々、ヒンディー語とテルグ語もあります"}, {"type": "subtitle", "time": 11957.349, "timestamp": "03:19:17", "text": "人々。"}, {"type": "subtitle", "time": 11959.03, "timestamp": "03:19:19", "text": "ああ"}, {"type": "subtitle", "time": 11960.309, "timestamp": "03:19:20", "text": "うん、それは私が聞いた話だけど"}, {"type": "subtitle", "time": 11962.63, "timestamp": "03:19:22", "text": "みんな、まるでミックスが多すぎるみたい"}, {"type": "subtitle", "time": 11964.55, "timestamp": "03:19:24", "text": "聞いてください、現在の都市のように"}, {"type": "subtitle", "time": 11966.71, "timestamp": "03:19:26", "text": "私は大学で勉強していて、"}, {"type": "subtitle", "time": 11969.11, "timestamp": "03:19:29", "text": "私の大学は"}, {"type": "subtitle", "time": 11972.309, "timestamp": "03:19:32", "text": "人里離れた場所で、まるで私たちが"}, {"type": "subtitle", "time": 11974.79, "timestamp": "03:19:34", "text": "あまり有名ではないが、まだミックスされている"}, {"type": "subtitle", "time": 11979.59, "timestamp": "03:19:39", "text": "たくさんの人がいる"}, {"type": "subtitle", "time": 11989.87, "timestamp": "03:19:49", "text": "ああ、アーンドラ・プラデーシュ州。"}, {"type": "subtitle", "time": 11992.349, "timestamp": "03:19:52", "text": "ニース。たくさん"}, {"type": "subtitle", "time": 11994.87, "timestamp": "03:19:54", "text": "人々。そうそう。調子はどうですか？"}, {"type": "subtitle", "time": 11997.67, "timestamp": "03:19:57", "text": "授業とかそういうの？"}]
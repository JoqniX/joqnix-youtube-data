[{"type": "subtitle", "time": 13860.07, "timestamp": "03:51:00", "text": "ああ、待って、"}, {"type": "subtitle", "time": 13861.91, "timestamp": "03:51:01", "text": "日差しが少し。私たちは大学に行けると思う"}, {"type": "subtitle", "time": 13863.51, "timestamp": "03:51:03", "text": "平和。そして私たちが向かっている間に"}, {"type": "subtitle", "time": 13871.91, "timestamp": "03:51:11", "text": "うん。道路状況などはどうですか？それは"}, {"type": "subtitle", "time": 13874.229, "timestamp": "03:51:14", "text": "そんな感じ？"}, {"type": "subtitle", "time": 13876.07, "timestamp": "03:51:16", "text": "実際、大学と"}, {"type": "subtitle", "time": 13877.59, "timestamp": "03:51:17", "text": "私たちが住んでいるアパートは、"}, {"type": "subtitle", "time": 13879.269, "timestamp": "03:51:19", "text": "まるで人里離れた場所のように。だから、私たちは"}, {"type": "subtitle", "time": 13881.83, "timestamp": "03:51:21", "text": "そういった問題を抱えている。"}, {"type": "subtitle", "time": 13884.87, "timestamp": "03:51:24", "text": "ご存知のように、"}, {"type": "subtitle", "time": 13887.59, "timestamp": "03:51:27", "text": "雨の中に入っていくように"}, {"type": "subtitle", "time": 13890.389, "timestamp": "03:51:30", "text": "雨天時の旅行は、これらの問題のみに関係します。"}, {"type": "subtitle", "time": 13895.03, "timestamp": "03:51:35", "text": "[音楽]"}, {"type": "subtitle", "time": 13897.51, "timestamp": "03:51:37", "text": "うん。つまり、基本的にはそうですね。それは私の"}, {"type": "subtitle", "time": 13899.189, "timestamp": "03:51:39", "text": "部屋は冗談を言って、私たちは"}, {"type": "subtitle", "time": 13900.79, "timestamp": "03:51:40", "text": "次のシャワーのためにシャワーを浴びる必要がある"}, {"type": "subtitle", "time": 13906.95, "timestamp": "03:51:46", "text": "そう、それだけの価値があるから"}, {"type": "subtitle", "time": 13908.55, "timestamp": "03:51:48", "text": "雨の中に入るのは"}, {"type": "subtitle", "time": 13910.63, "timestamp": "03:51:50", "text": "自転車で旅行しても、自転車があれば"}, {"type": "subtitle", "time": 13912.389, "timestamp": "03:51:52", "text": "5分くらいかかるでしょう。 5 を想像してみてください"}]
[{"type": "subtitle", "time": 10740.99, "timestamp": "02:59:00", "text": "こんにちは、PGさん。元気かい？こんにちは"}, {"type": "subtitle", "time": 10747.71, "timestamp": "02:59:07", "text": "ランダム"}, {"type": "subtitle", "time": 10750.469, "timestamp": "02:59:10", "text": "日本に関するもの"}, {"type": "subtitle", "time": 10752.309, "timestamp": "02:59:12", "text": "私たちが訪れる前に行きたい場所"}, {"type": "subtitle", "time": 10753.75, "timestamp": "02:59:13", "text": "私たちは挑戦してみます。ああ、確かに話したよ"}, {"type": "subtitle", "time": 10756.469, "timestamp": "02:59:16", "text": "食べ物について。"}, {"type": "subtitle", "time": 10758.309, "timestamp": "02:59:18", "text": "うん。食べてみたい食べ物は何ですか？"}, {"type": "subtitle", "time": 10760.87, "timestamp": "02:59:20", "text": "寿司みたいに。"}, {"type": "subtitle", "time": 10762.429, "timestamp": "02:59:22", "text": "はい、"}, {"type": "subtitle", "time": 10765.67, "timestamp": "02:59:25", "text": "たこ焼きと天ぷら。ああいう派手なもの全部"}, {"type": "subtitle", "time": 10768.07, "timestamp": "02:59:28", "text": "アニメやゲームで見かける食べ物と"}, {"type": "subtitle", "time": 10772.11, "timestamp": "02:59:32", "text": "もの。兄弟、これは私に思い出させる"}, {"type": "subtitle", "time": 10775.59, "timestamp": "02:59:35", "text": "ヤクザの俊敏さ。覚えてる？彼"}, {"type": "subtitle", "time": 10779.91, "timestamp": "02:59:39", "text": "私とミア・カーバックスをそこに入れてください。"}, {"type": "subtitle", "time": 10781.67, "timestamp": "02:59:41", "text": "ほら、ほら、もし私がもっと良いものを手に入れたら"}, {"type": "subtitle", "time": 10784.23, "timestamp": "02:59:44", "text": "Blender を実行するのに十分なノートパソコン、"}, {"type": "subtitle", "time": 10787.59, "timestamp": "02:59:47", "text": "私は入ります。"}, {"type": "subtitle", "time": 10789.429, "timestamp": "02:59:49", "text": "さあ行こう。"}, {"type": "subtitle", "time": 10792.55, "timestamp": "02:59:52", "text": "ええ、そうするべきです。あなたがすべき。"}, {"type": "subtitle", "time": 10795.11, "timestamp": "02:59:55", "text": "私は滞在しようと試みましたが、"}, {"type": "subtitle", "time": 10798.23, "timestamp": "02:59:58", "text": "彼は活動していない。ネット上で彼を見かけることがあります。私"}, {"type": "subtitle", "time": 10799.75, "timestamp": "02:59:59", "text": "できた"}]
[{"type": "subtitle", "time": 9181.349, "timestamp": "02:33:01", "text": "語彙 ええと、"}, {"type": "subtitle", "time": 9184.55, "timestamp": "02:33:04", "text": "そうそう。そう、君が"}, {"type": "subtitle", "time": 9186.15, "timestamp": "02:33:06", "text": "ルームメイトとかの話"}, {"type": "subtitle", "time": 9188.309, "timestamp": "02:33:08", "text": "私が小川を訪れていたとき。おお"}, {"type": "subtitle", "time": 9190.469, "timestamp": "02:33:10", "text": "はい。"}, {"type": "subtitle", "time": 9192.23, "timestamp": "02:33:12", "text": "ルームメイトとの生活はどうでしたか？"}, {"type": "subtitle", "time": 9193.99, "timestamp": "02:33:13", "text": "そして全て？"}, {"type": "subtitle", "time": 9196.79, "timestamp": "02:33:16", "text": "怖かったよ、ほら、もし私が"}, {"type": "subtitle", "time": 9199.11, "timestamp": "02:33:19", "text": "もし私がvtubingの部分を残して"}, {"type": "subtitle", "time": 9200.95, "timestamp": "02:33:20", "text": "ただの普通の男だよ。ええ、楽しかったです"}, {"type": "subtitle", "time": 9202.95, "timestamp": "02:33:22", "text": "ルームメイトとよく一緒にいるし、いつも"}, {"type": "subtitle", "time": 9205.91, "timestamp": "02:33:25", "text": "楽しい。しかし、好きになることに関しては、"}, {"type": "subtitle", "time": 9207.91, "timestamp": "02:33:27", "text": "ストリーミング、そう、あの人たちは"}, {"type": "subtitle", "time": 9211.63, "timestamp": "02:33:31", "text": "かなり面倒くさい。"}, {"type": "subtitle", "time": 9215.429, "timestamp": "02:33:35", "text": "ああ、彼らはあなたにプライバシーを与えてくれない。"}, {"type": "subtitle", "time": 9217.27, "timestamp": "02:33:37", "text": "えっと、彼らはこう言うんです。「ああ、"}, {"type": "subtitle", "time": 9220.309, "timestamp": "02:33:40", "text": "わかった。 「わかったよ、兄弟。」でもその後、えっと何か"}, {"type": "subtitle", "time": 9222.71, "timestamp": "02:33:42", "text": "えっと、あそこに上がってきて、例えば"}, {"type": "subtitle", "time": 9225.75, "timestamp": "02:33:45", "text": "家族の口論か、あるいは恐らく"}, {"type": "subtitle", "time": 9227.79, "timestamp": "02:33:47", "text": "会話を知る"}, {"type": "subtitle", "time": 9230.309, "timestamp": "02:33:50", "text": "突然。うん。"}, {"type": "subtitle", "time": 9232.15, "timestamp": "02:33:52", "text": "そう、その間はコントロールできない"}, {"type": "subtitle", "time": 9233.15, "timestamp": "02:33:53", "text": "それらの"}, {"type": "subtitle", "time": 9236.07, "timestamp": "02:33:56", "text": "回。ああ"}, {"type": "subtitle", "time": 9237.59, "timestamp": "02:33:57", "text": "そう、だから混沌として"}]
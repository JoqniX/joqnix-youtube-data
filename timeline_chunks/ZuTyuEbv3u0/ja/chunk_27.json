[{"type": "subtitle", "time": 1623.669, "timestamp": "00:27:03", "text": "私がそこに定住したいと思っていて、"}, {"type": "subtitle", "time": 1626.23, "timestamp": "00:27:06", "text": "ええと、私はそちらに行きたいです。"}, {"type": "subtitle", "time": 1628.23, "timestamp": "00:27:08", "text": "それは日本ではない。"}, {"type": "subtitle", "time": 1637.75, "timestamp": "00:27:17", "text": "私を見て。本当にあと少しなんです。"}, {"type": "subtitle", "time": 1642.269, "timestamp": "00:27:22", "text": "うん。そして私は"}, {"type": "subtitle", "time": 1647.11, "timestamp": "00:27:27", "text": "いいですか。墜落しないでください。わかった。"}, {"type": "subtitle", "time": 1650.789, "timestamp": "00:27:30", "text": "何も起こらなかった。もうクラッシュは発生しません。おお、"}, {"type": "chat", "time": 1654.746, "timestamp": "00:27:34", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "she big now"}, {"type": "subtitle", "time": 1655.51, "timestamp": "00:27:35", "text": "ああ、助かった。君を大きくしてやったんだ。わーい。わーい。"}, {"type": "subtitle", "time": 1659.99, "timestamp": "00:27:39", "text": "私は今、以前より大きくなった。私は大きくなった？はい。"}, {"type": "subtitle", "time": 1662.269, "timestamp": "00:27:42", "text": "さあ行こう。"}, {"type": "subtitle", "time": 1666.149, "timestamp": "00:27:46", "text": "えっと、作れますか？ああ、なんてことだ。あなた"}, {"type": "subtitle", "time": 1668.549, "timestamp": "00:27:48", "text": "知ってるよ、私も遅延があると思う"}, {"type": "subtitle", "time": 1671.51, "timestamp": "00:27:51", "text": "私の側では、私はゆっくりと自分自身を見ることができます"}, {"type": "subtitle", "time": 1678.47, "timestamp": "00:27:58", "text": "それは正気の沙汰ではない。はい、これでよし。私は"}]
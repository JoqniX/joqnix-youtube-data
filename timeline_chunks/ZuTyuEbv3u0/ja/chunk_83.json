[{"type": "subtitle", "time": 4980.75, "timestamp": "01:23:00", "text": "私はここにいます"}, {"type": "subtitle", "time": 4984.149, "timestamp": "01:23:04", "text": "ちょっと待って、もう一度確認させて。えっと、明日私たちは"}, {"type": "subtitle", "time": 4986.56, "timestamp": "01:23:06", "text": "持っている"}, {"type": "subtitle", "time": 4989.31, "timestamp": "01:23:09", "text": "[音楽]"}, {"type": "subtitle", "time": 4991.99, "timestamp": "01:23:11", "text": "あ、待って。今日は水曜日です。"}, {"type": "subtitle", "time": 4993.83, "timestamp": "01:23:13", "text": "右？わかった。わかった。はい、はい、はい。"}, {"type": "subtitle", "time": 5008.04, "timestamp": "01:23:28", "text": "強盗。それもまた"}, {"type": "subtitle", "time": 5010.669, "timestamp": "01:23:30", "text": "[音楽]"}, {"type": "subtitle", "time": 5015.629, "timestamp": "01:23:35", "text": "終わり。切り絵とチェス。それも"}, {"type": "subtitle", "time": 5019.43, "timestamp": "01:23:39", "text": "終わり。次はDJですよね？えっと、私は"}, {"type": "subtitle", "time": 5037.75, "timestamp": "01:23:57", "text": "カレックス？私は、自分がプレーできると考えていました。"}, {"type": "subtitle", "time": 5039.47, "timestamp": "01:23:59", "text": "待って、"}]
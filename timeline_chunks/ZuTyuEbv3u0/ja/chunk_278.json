[{"type": "subtitle", "time": 16680.59, "timestamp": "04:38:00", "text": "競争相手ですよね？それは競争である"}, {"type": "subtitle", "time": 16683.029, "timestamp": "04:38:03", "text": "トゥイッチ。もちろん、そんなことはありません。彼らはそうしないだろう"}, {"type": "subtitle", "time": 16690.189, "timestamp": "04:38:10", "text": "トゥイッチ。ええ、彼らはTwitchを導入しないでしょう。の"}, {"type": "subtitle", "time": 16694.15, "timestamp": "04:38:14", "text": "コース。ああ、わかりました。待って、じゃあどうなるの？何"}, {"type": "subtitle", "time": 16698.59, "timestamp": "04:38:18", "text": "もし私がTwitchを入れたら、それはおかしいでしょうか？"}, {"type": "subtitle", "time": 16702.949, "timestamp": "04:38:22", "text": "そうすれば、パネルに取り付けることができますよね？私"}, {"type": "subtitle", "time": 16706.109, "timestamp": "04:38:26", "text": "私のパネルに配置できます。"}, {"type": "subtitle", "time": 16708.709, "timestamp": "04:38:28", "text": "右？パネルに載せることもできます。"}, {"type": "subtitle", "time": 16711.83, "timestamp": "04:38:31", "text": "右？私は今気づいたのですが、私は持っていません"}, {"type": "subtitle", "time": 16716.23, "timestamp": "04:38:36", "text": "キックパネル。何てことだ。私のコピーはできますか？"}, {"type": "subtitle", "time": 16720.029, "timestamp": "04:38:40", "text": "Twitchパネルをここに置くだけです"}, {"type": "subtitle", "time": 16723.189, "timestamp": "04:38:43", "text": "素早い？そうして、それから食べて、"}, {"type": "subtitle", "time": 16724.51, "timestamp": "04:38:44", "text": "もの。"}, {"type": "subtitle", "time": 16726.789, "timestamp": "04:38:46", "text": "わかった。あのね？私はただ聞くだけです"}, {"type": "subtitle", "time": 16729.269, "timestamp": "04:38:49", "text": "父のWhatsAppからの音声メッセージと"}, {"type": "subtitle", "time": 16731.189, "timestamp": "04:38:51", "text": "そして1秒。少し時間をください。病気"}]
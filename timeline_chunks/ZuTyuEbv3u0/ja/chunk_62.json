[{"type": "subtitle", "time": 3720.63, "timestamp": "01:02:00", "text": "かなり長い間オンラインになっていませんでした"}, {"type": "subtitle", "time": 3725.71, "timestamp": "01:02:05", "text": "Discordや他のプラットフォームのように"}, {"type": "subtitle", "time": 3729.27, "timestamp": "01:02:09", "text": "なぜならそれは本当にこうだから"}, {"type": "subtitle", "time": 3731.43, "timestamp": "01:02:11", "text": "ストリーム配信をしようかな"}, {"type": "subtitle", "time": 3735.109, "timestamp": "01:02:15", "text": "そして、私は、えっと、何が"}, {"type": "subtitle", "time": 3738.309, "timestamp": "01:02:18", "text": "私の時間のほとんどをそれに費やしているんです。"}, {"type": "subtitle", "time": 3741.589, "timestamp": "01:02:21", "text": "うん。そして、あなたが本当にそうしたいから"}, {"type": "subtitle", "time": 3743.51, "timestamp": "01:02:23", "text": "私が受けたすべての愛を知っている"}, {"type": "subtitle", "time": 3747.03, "timestamp": "01:02:27", "text": "長年にわたり私の人々から"}, {"type": "subtitle", "time": 3749.03, "timestamp": "01:02:29", "text": "私にとってとても大切なことですし、私はいつも"}, {"type": "subtitle", "time": 3751.27, "timestamp": "01:02:31", "text": "何があっても、あるいはなくても、それに感謝します"}, {"type": "subtitle", "time": 3753.67, "timestamp": "01:02:33", "text": "いつであっても構わない。私はこれを次のように言うと思います"}, {"type": "subtitle", "time": 3757.63, "timestamp": "01:02:37", "text": "たくさん、そして私はいつも人々にこう言われてきました"}, {"type": "subtitle", "time": 3761.99, "timestamp": "01:02:41", "text": "うーん、私にとってはタイミングの問題なんです。それは"}, {"type": "subtitle", "time": 3765.71, "timestamp": "01:02:45", "text": "私にとってとても困難な時期です。"}, {"type": "subtitle", "time": 3768.39, "timestamp": "01:02:48", "text": "ほとんど時間がないと思う"}, {"type": "subtitle", "time": 3775.43, "timestamp": "01:02:55", "text": "あなたはもうすぐ4歳になることを覚えておいてください"}, {"type": "subtitle", "time": 3777.51, "timestamp": "01:02:57", "text": "年数ですよね？"}]
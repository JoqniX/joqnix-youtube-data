[{"type": "subtitle", "time": 8943.19, "timestamp": "02:29:03", "text": "ほとんどの場合、私はただ、"}, {"type": "subtitle", "time": 8946.469, "timestamp": "02:29:06", "text": "そう、私はただ回転していただけ"}, {"type": "subtitle", "time": 8948.87, "timestamp": "02:29:08", "text": "しばらく前からINVの塊茎の周りに2つあります"}, {"type": "subtitle", "time": 8950.95, "timestamp": "02:29:10", "text": "何年も話さなかった"}, {"type": "subtitle", "time": 8953.51, "timestamp": "02:29:13", "text": "他の人に触れたり、つながりを感じたり"}, {"type": "subtitle", "time": 8956.55, "timestamp": "02:29:16", "text": "まだ彼らと一緒にいる。だから私はこう感じた"}, {"type": "subtitle", "time": 8958.389, "timestamp": "02:29:18", "text": "機会があれば、"}, {"type": "subtitle", "time": 8960.15, "timestamp": "02:29:20", "text": "コラボレーションしたすべての人とつながりましょう"}, {"type": "subtitle", "time": 8962.55, "timestamp": "02:29:22", "text": "と。グループコラボレーションであっても"}, {"type": "subtitle", "time": 8965.99, "timestamp": "02:29:25", "text": "相互作用のあるものだけを残してください。私は私は"}, {"type": "subtitle", "time": 8968.87, "timestamp": "02:29:28", "text": "まあ、ただ一緒に過ごせばいいと思って"}, {"type": "subtitle", "time": 8971.349, "timestamp": "02:29:31", "text": "ゆっくりとお互いを知っていくように"}, {"type": "subtitle", "time": 8975.11, "timestamp": "02:29:35", "text": "将来的にコラボレーションできるかどうか"}, {"type": "subtitle", "time": 8977.11, "timestamp": "02:29:37", "text": "ただコラボレーションするだけ ただただ一緒に過ごすだけ"}, {"type": "subtitle", "time": 8981.51, "timestamp": "02:29:41", "text": "友達とか、そういう関係。そうじゃない。そして"}, {"type": "subtitle", "time": 8984.63, "timestamp": "02:29:44", "text": "うん、この間ずっと、"}, {"type": "subtitle", "time": 8987.03, "timestamp": "02:29:47", "text": "日本のチームとコラボレーションを開始し、"}, {"type": "subtitle", "time": 8989.59, "timestamp": "02:29:49", "text": "韓国のものと、その他すべて、"}, {"type": "subtitle", "time": 8992.55, "timestamp": "02:29:52", "text": "私は、何人かの人が"}, {"type": "subtitle", "time": 8994.87, "timestamp": "02:29:54", "text": "取引的なコラボレーションとして捉え、"}, {"type": "subtitle", "time": 8996.91, "timestamp": "02:29:56", "text": "プロフェッショナルでなければならない"}, {"type": "subtitle", "time": 8998.95, "timestamp": "02:29:58", "text": "プロフェッショナルな人は、もし彼らが"}]
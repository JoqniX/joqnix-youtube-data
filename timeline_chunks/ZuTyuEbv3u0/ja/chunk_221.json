[{"type": "subtitle", "time": 13260.15, "timestamp": "03:41:00", "text": "つまり、それが私が決して好きではない理由です"}, {"type": "subtitle", "time": 13267.349, "timestamp": "03:41:07", "text": "ああ、それが一番最悪なところだ"}, {"type": "subtitle", "time": 13270.349, "timestamp": "03:41:10", "text": "時々電車に乗る。ええ、そうです"}, {"type": "subtitle", "time": 13272.95, "timestamp": "03:41:12", "text": "痛み。つまり、"}, {"type": "subtitle", "time": 13275.269, "timestamp": "03:41:15", "text": "別の州へ移動する際の経験"}, {"type": "subtitle", "time": 13277.19, "timestamp": "03:41:17", "text": "えっと、わからないけど"}, {"type": "subtitle", "time": 13279.67, "timestamp": "03:41:19", "text": "あの言語とかそういうやつ。うん。例えば"}, {"type": "subtitle", "time": 13282.07, "timestamp": "03:41:22", "text": "試験のためにチェンナイなどに行った"}, {"type": "subtitle", "time": 13284.309, "timestamp": "03:41:24", "text": "父は、私がどうやって行くのか分からないので"}, {"type": "subtitle", "time": 13286.75, "timestamp": "03:41:26", "text": "一人ぼっちで何もかもが今はあまりない"}, {"type": "subtitle", "time": 13289.349, "timestamp": "03:41:29", "text": "体験してみたら、とても違った感じがした"}, {"type": "subtitle", "time": 13292.55, "timestamp": "03:41:32", "text": "チェンナイの道路はとても広くて"}, {"type": "subtitle", "time": 13295.99, "timestamp": "03:41:35", "text": "もの。道路が"}, {"type": "subtitle", "time": 13298.87, "timestamp": "03:41:38", "text": "大きい。いいえ、問題はあなたが選んだということです"}, {"type": "subtitle", "time": 13300.95, "timestamp": "03:41:40", "text": "私の最悪の地区を選びました"}, {"type": "subtitle", "time": 13303.67, "timestamp": "03:41:43", "text": "おそらく旅行するために州は"}, {"type": "subtitle", "time": 13306.63, "timestamp": "03:41:46", "text": "交通量の多い都市。うん、"}, {"type": "subtitle", "time": 13309.99, "timestamp": "03:41:49", "text": "交通量が非常に多く、"}, {"type": "subtitle", "time": 13313.59, "timestamp": "03:41:53", "text": "ペンシルバニア州とチェンナイで私が気づいたことは"}, {"type": "subtitle", "time": 13317.51, "timestamp": "03:41:57", "text": "自動車とフェア料金がとても高い"}]
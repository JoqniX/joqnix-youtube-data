[{"type": "subtitle", "time": 9001.349, "timestamp": "02:30:01", "text": "向こう側からストリーミング配信している。いいえ、だってここに"}, {"type": "subtitle", "time": 9004.55, "timestamp": "02:30:04", "text": "私はのんびりした、リラックスした時間が欲しいんです"}, {"type": "subtitle", "time": 9006.79, "timestamp": "02:30:06", "text": "のんびりした、リラックスした感じ。うん。"}, {"type": "subtitle", "time": 9009.75, "timestamp": "02:30:09", "text": "うん。うん。うん。私も同じです。うん。"}, {"type": "subtitle", "time": 9014.349, "timestamp": "02:30:14", "text": "おお"}, {"type": "subtitle", "time": 9017.83, "timestamp": "02:30:17", "text": "男の子。今は本当にたくさんのことがある。"}, {"type": "subtitle", "time": 9021.23, "timestamp": "02:30:21", "text": "私はまだ名前を覚えていません"}, {"type": "subtitle", "time": 9024.71, "timestamp": "02:30:24", "text": "私が会った人たちは、"}, {"type": "subtitle", "time": 9027.27, "timestamp": "02:30:27", "text": "今では本当にたくさんの人がいます。"}, {"type": "subtitle", "time": 9037.75, "timestamp": "02:30:37", "text": "うん。 4時くらいに聞いたと思う"}, {"type": "subtitle", "time": 9039.27, "timestamp": "02:30:39", "text": "数ヶ月だと思います。"}, {"type": "subtitle", "time": 9041.27, "timestamp": "02:30:41", "text": "うん。ええと、来月が最後になります"}, {"type": "subtitle", "time": 9045.99, "timestamp": "02:30:45", "text": "確か月だったと思います。ああ、わかりました。わかった。えっと、それで"}, {"type": "subtitle", "time": 9050.07, "timestamp": "02:30:50", "text": "試験があります。えっと、3番目をやってます"}, {"type": "subtitle", "time": 9052.389, "timestamp": "02:30:52", "text": "英文学の年。私は"}, {"type": "subtitle", "time": 9057.71, "timestamp": "02:30:57", "text": "それは現在、遠隔学習として表示されています。"}]
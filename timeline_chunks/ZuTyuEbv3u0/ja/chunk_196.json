[{"type": "subtitle", "time": 11761.269, "timestamp": "03:16:01", "text": "手伝ってくれるとか、いろいろと。それは"}, {"type": "subtitle", "time": 11763.51, "timestamp": "03:16:03", "text": "そうですね、彼らは送ることができます"}, {"type": "subtitle", "time": 11767.11, "timestamp": "03:16:07", "text": "後でお金は払わないとか何とか。だから彼らは"}, {"type": "subtitle", "time": 11769.67, "timestamp": "03:16:09", "text": "あるいは、お金を送金する"}, {"type": "subtitle", "time": 11772.309, "timestamp": "03:16:12", "text": "アカデミーの人たちはそれを送ったり"}, {"type": "subtitle", "time": 11775.99, "timestamp": "03:16:15", "text": "えーっと、それを人々に送る、えーっと"}, {"type": "subtitle", "time": 11780.55, "timestamp": "03:16:20", "text": "ええ、日本の地元の人々と、ええ"}, {"type": "subtitle", "time": 11783.91, "timestamp": "03:16:23", "text": "そうすれば円に変換して"}, {"type": "subtitle", "time": 11786.79, "timestamp": "03:16:26", "text": "気に入ったら今すぐ買ってください"}, {"type": "subtitle", "time": 11789.51, "timestamp": "03:16:29", "text": "父が喜ぶような追加のニーズがあります"}, {"type": "subtitle", "time": 11793.19, "timestamp": "03:16:33", "text": "常に地元の"}, {"type": "subtitle", "time": 11796.63, "timestamp": "03:16:36", "text": "アカデミーが今ここにあり、彼らはそれを与えることができます"}, {"type": "subtitle", "time": 11800.229, "timestamp": "03:16:40", "text": "残りの金額を支払う"}, {"type": "subtitle", "time": 11803.349, "timestamp": "03:16:43", "text": "私はそういうことをやっています。ええ、なぜなら"}, {"type": "subtitle", "time": 11806.55, "timestamp": "03:16:46", "text": "通貨は痛みをもたらすだろう。私はこう思う、"}, {"type": "subtitle", "time": 11811.469, "timestamp": "03:16:51", "text": "うん、日本の通貨は下落しているみたいだ。"}, {"type": "subtitle", "time": 11814.16, "timestamp": "03:16:54", "text": "右？ええ、そうですね。"}, {"type": "subtitle", "time": 11816.349, "timestamp": "03:16:56", "text": "[音楽]"}, {"type": "subtitle", "time": 11818.429, "timestamp": "03:16:58", "text": "のように、"}]
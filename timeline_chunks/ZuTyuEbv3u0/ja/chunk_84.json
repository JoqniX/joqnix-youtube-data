[{"type": "subtitle", "time": 5050.29, "timestamp": "01:24:10", "text": "DD？ B型ワクチンは接種しましたか？"}, {"type": "subtitle", "time": 5070.43, "timestamp": "01:24:30", "text": "それ。ああ、でも神試験もね"}, {"type": "subtitle", "time": 5093.11, "timestamp": "01:24:53", "text": "2時間であることを覚えておいてください。わかった。わかった。 DJは"}, {"type": "subtitle", "time": 5095.669, "timestamp": "01:24:55", "text": "そこに2時間滞在した。 10時から11時、11時から"}, {"type": "subtitle", "time": 5099.27, "timestamp": "01:24:59", "text": "12. わかりました。 2時間。うん。 12時まで。いいですね。"}]
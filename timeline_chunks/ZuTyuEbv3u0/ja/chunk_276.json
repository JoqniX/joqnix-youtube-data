[{"type": "subtitle", "time": 16565.07, "timestamp": "04:36:05", "text": "何？私は文字通り"}, {"type": "subtitle", "time": 16586.31, "timestamp": "04:36:26", "text": "そうねぇ。私は使えないと思います。"}, {"type": "subtitle", "time": 16591.029, "timestamp": "04:36:31", "text": "キックでサブスクリプションを取得できます"}, {"type": "subtitle", "time": 16594.15, "timestamp": "04:36:34", "text": "なぜなら、彼らが使うストライプはストライプではないからです"}, {"type": "subtitle", "time": 16596.789, "timestamp": "04:36:36", "text": "右ストライプはインドでは入手できません"}, {"type": "subtitle", "time": 16600.789, "timestamp": "04:36:40", "text": "実際にはアクセスが制限されている"}, {"type": "subtitle", "time": 16603.349, "timestamp": "04:36:43", "text": "特定の企業や大企業"}, {"type": "subtitle", "time": 16605.15, "timestamp": "04:36:45", "text": "企業または"}, {"type": "subtitle", "time": 16607.51, "timestamp": "04:36:47", "text": "何か。だから、私は"}, {"type": "subtitle", "time": 16609.99, "timestamp": "04:36:49", "text": "購読ボタン"}, {"type": "subtitle", "time": 16612.869, "timestamp": "04:36:52", "text": "もしくは、悲しいことに、何かがキックしているような感じ。でも私は"}, {"type": "subtitle", "time": 16615.551, "timestamp": "04:36:55", "text": "日本からでもできるかもしれない"}, {"type": "subtitle", "time": 16617.07, "timestamp": "04:36:57", "text": "けれど"}]
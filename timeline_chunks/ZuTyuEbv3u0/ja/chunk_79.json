[{"type": "subtitle", "time": 4742.669, "timestamp": "01:19:02", "text": "奇妙な。私"}, {"type": "subtitle", "time": 4745.35, "timestamp": "01:19:05", "text": "うん、一緒に過ごすのは本当に楽しかったよ"}, {"type": "subtitle", "time": 4748.709, "timestamp": "01:19:08", "text": "ザキナと一緒です。そして問題は、えっと、私は"}, {"type": "subtitle", "time": 4750.27, "timestamp": "01:19:10", "text": "感じた"}, {"type": "subtitle", "time": 4753.35, "timestamp": "01:19:13", "text": "でも、私は来るのが難しかった"}, {"type": "subtitle", "time": 4756.149, "timestamp": "01:19:16", "text": "話題を盛り上げよう。使い切ってしまったと思う"}, {"type": "subtitle", "time": 4759.75, "timestamp": "01:19:19", "text": "話題が少しあったので、何もなかった"}, {"type": "subtitle", "time": 4762.95, "timestamp": "01:19:22", "text": "話したいことはたくさんあるけど、"}, {"type": "subtitle", "time": 4764.79, "timestamp": "01:19:24", "text": "君たちにとっては楽しかっただろうね。願わくば"}, {"type": "subtitle", "time": 4768.43, "timestamp": "01:19:28", "text": "楽しかったし、確認しないといけない"}, {"type": "subtitle", "time": 4771.669, "timestamp": "01:19:31", "text": "ゲストがいる場合は、"}, {"type": "subtitle", "time": 4776.229, "timestamp": "01:19:36", "text": "ゲームをやっているから、また"}, {"type": "subtitle", "time": 4778.149, "timestamp": "01:19:38", "text": "ゲームを常に手段として使うことはできない"}, {"type": "subtitle", "time": 4780.149, "timestamp": "01:19:40", "text": "気を紛らわせたり、楽しんだりするために"}, {"type": "subtitle", "time": 4782.63, "timestamp": "01:19:42", "text": "そしてゲームをする。主な目標は"}, {"type": "subtitle", "time": 4785.07, "timestamp": "01:19:45", "text": "遊ぶ。一緒に過ごして話をして"}, {"type": "subtitle", "time": 4788.63, "timestamp": "01:19:48", "text": "もの。うん。でも、楽しんでいただけたなら嬉しいです。"}, {"type": "subtitle", "time": 4791.99, "timestamp": "01:19:51", "text": "ゲーム関連のことをもっとやってみたい"}, {"type": "subtitle", "time": 4794.55, "timestamp": "01:19:54", "text": "他の協力者などと。私"}, {"type": "subtitle", "time": 4797.39, "timestamp": "01:19:57", "text": "そうしたい。それで"}]
[{"type": "subtitle", "time": 2222.39, "timestamp": "00:37:02", "text": "ほとんどの場合、異なる国で。"}, {"type": "subtitle", "time": 2225.589, "timestamp": "00:37:05", "text": "はい、そうです。うん。"}, {"type": "subtitle", "time": 2229.43, "timestamp": "00:37:09", "text": "気をつけてね。うん。詐欺に遭わないように。"}, {"type": "subtitle", "time": 2237.15, "timestamp": "00:37:17", "text": "[音楽]"}, {"type": "subtitle", "time": 2240.79, "timestamp": "00:37:20", "text": "まあ、そうですね。えっと、私があなたに言ったのは"}, {"type": "subtitle", "time": 2244.55, "timestamp": "00:37:24", "text": "私が向かう場所はどこですか？行く"}, {"type": "subtitle", "time": 2247.55, "timestamp": "00:37:27", "text": "ああ、GMAに行くんだ。えっと、そこが私が"}, {"type": "subtitle", "time": 2251.63, "timestamp": "00:37:31", "text": "学校の件は解決しました。つまり、"}, {"type": "subtitle", "time": 2254.87, "timestamp": "00:37:34", "text": "暑いことで人気のエリア"}, {"type": "subtitle", "time": 2257.95, "timestamp": "00:37:37", "text": "バネとか、オネンとか。おお"}, {"type": "subtitle", "time": 2261.91, "timestamp": "00:37:41", "text": "私の。つまり、東京にはなくて、"}, {"type": "subtitle", "time": 2264.95, "timestamp": "00:37:44", "text": "山岳地帯だと思います。"}, {"type": "subtitle", "time": 2266.47, "timestamp": "00:37:46", "text": "実は東京だと思っていました。私は"}, {"type": "subtitle", "time": 2268.069, "timestamp": "00:37:48", "text": "ほら、たぶん、ほら、"}, {"type": "subtitle", "time": 2269.589, "timestamp": "00:37:49", "text": "温泉に行くか、"}, {"type": "subtitle", "time": 2273.109, "timestamp": "00:37:53", "text": "休暇や休みのようなものですが、"}, {"type": "subtitle", "time": 2275.67, "timestamp": "00:37:55", "text": "ああ、神様、どこかへ行った方がいいですよ"}, {"type": "subtitle", "time": 2277.67, "timestamp": "00:37:57", "text": "そこには温泉ができる予定だ。"}]
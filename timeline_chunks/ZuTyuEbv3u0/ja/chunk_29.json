[{"type": "subtitle", "time": 1743.19, "timestamp": "00:29:03", "text": "およそ2ヶ月後くらいになると思います。"}, {"type": "subtitle", "time": 1746.31, "timestamp": "00:29:06", "text": "それは私が忙しいからだけど、"}, {"type": "subtitle", "time": 1749.59, "timestamp": "00:29:09", "text": "えっと、プラチナくらいにはなりました。"}, {"type": "subtitle", "time": 1752.63, "timestamp": "00:29:12", "text": "うん。何を黒く塗るんだ？うん、手に入れたよ"}, {"type": "subtitle", "time": 1755.83, "timestamp": "00:29:15", "text": "チェック柄の服を着て、そして私は転んだ。私はひどく恋に落ちた"}, {"type": "subtitle", "time": 1759.269, "timestamp": "00:29:19", "text": "チェック柄を手に入れた後だよ。ああ、"}, {"type": "subtitle", "time": 1761.83, "timestamp": "00:29:21", "text": "神。えっと、実は私はこう思ってたんです"}, {"type": "subtitle", "time": 1765.35, "timestamp": "00:29:25", "text": "ダイヤモンドにかなり近いし"}, {"type": "subtitle", "time": 1767.75, "timestamp": "00:29:27", "text": "これは別のアカウントでの出来事だったんですよ、皆さん。"}, {"type": "subtitle", "time": 1770.31, "timestamp": "00:29:30", "text": "たぶんアカウントにあると思う"}, {"type": "subtitle", "time": 1773.35, "timestamp": "00:29:33", "text": "今まさにプレイしているゲームですが、以前プレイしました。わかった、"}, {"type": "subtitle", "time": 1776.71, "timestamp": "00:29:36", "text": "みんな。嘘じゃないよ。私は最善を尽くしました"}, {"type": "subtitle", "time": 1779.51, "timestamp": "00:29:39", "text": "そして、私にはそれができた。君が"}, {"type": "subtitle", "time": 1780.95, "timestamp": "00:29:40", "text": "バスケットボールをプレイしている間は、"}, {"type": "subtitle", "time": 1784.549, "timestamp": "00:29:44", "text": "エージェントを選ぶように、"}, {"type": "subtitle", "time": 1787.51, "timestamp": "00:29:47", "text": "実際に遊ぶのではなく、遊ぶのが好きです"}, {"type": "subtitle", "time": 1791.029, "timestamp": "00:29:51", "text": "エージェント、あなたがプレイしたいもの、または"}, {"type": "subtitle", "time": 1793.11, "timestamp": "00:29:53", "text": "時々先生を変えること。"}, {"type": "subtitle", "time": 1797.029, "timestamp": "00:29:57", "text": "私はただ、あなたが持っている必要があると思う"}, {"type": "subtitle", "time": 1799.51, "timestamp": "00:29:59", "text": "たった一つの脳細胞でバレエを演奏する。"}]
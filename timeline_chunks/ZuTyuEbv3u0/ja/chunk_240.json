[{"type": "subtitle", "time": 14400.95, "timestamp": "04:00:00", "text": "ああ、わかりました。さあ行こう。写真を送ります"}, {"type": "subtitle", "time": 14405.03, "timestamp": "04:00:05", "text": "などなど。私は大丈夫です。うん、そのまま"}, {"type": "subtitle", "time": 14407.51, "timestamp": "04:00:07", "text": "更新しました。知るか？私も来るかもしれない"}, {"type": "subtitle", "time": 14409.91, "timestamp": "04:00:09", "text": "彼らは旅行でそこへやって来た。はい、"}, {"type": "subtitle", "time": 14411.67, "timestamp": "04:00:11", "text": "さあ行こう。案内してあげるよ"}, {"type": "subtitle", "time": 14412.87, "timestamp": "04:00:12", "text": "もの。その頃には、私はこうなっているだろう"}, {"type": "subtitle", "time": 14415.71, "timestamp": "04:00:15", "text": "職業上の日本人市民または"}, {"type": "subtitle", "time": 14418.71, "timestamp": "04:00:18", "text": "何か。何てことだ。うん、そうなるよ"}, {"type": "subtitle", "time": 14422.07, "timestamp": "04:00:22", "text": "私にはそれに関するガイドが必要だ"}, {"type": "subtitle", "time": 14432.63, "timestamp": "04:00:32", "text": "うん、周りのみんなが"}, {"type": "subtitle", "time": 14436.07, "timestamp": "04:00:36", "text": "彼らも前進しているように"}, {"type": "subtitle", "time": 14439.349, "timestamp": "04:00:39", "text": "自分のもの。人生。"}, {"type": "subtitle", "time": 14443.389, "timestamp": "04:00:43", "text": "ああ、それが人生ってやつさ。"}, {"type": "subtitle", "time": 14447.72, "timestamp": "04:00:47", "text": "ええ、もちろんです。そこには。"}, {"type": "subtitle", "time": 14450.55, "timestamp": "04:00:50", "text": "[音楽]"}, {"type": "subtitle", "time": 14455.07, "timestamp": "04:00:55", "text": "それは何ですか？私が聞きたかったことは？ああ、"}, {"type": "subtitle", "time": 14457.389, "timestamp": "04:00:57", "text": "神。そうそう。"}]
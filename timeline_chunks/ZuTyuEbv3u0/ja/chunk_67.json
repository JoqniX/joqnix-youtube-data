[{"type": "subtitle", "time": 4021.67, "timestamp": "01:07:01", "text": "それで、将来のことについては、"}, {"type": "subtitle", "time": 4024.23, "timestamp": "01:07:04", "text": "日本に滞在する予定です。私はそう思う、うん、私は"}, {"type": "subtitle", "time": 4026.069, "timestamp": "01:07:06", "text": "いつでもお手伝いできます"}, {"type": "subtitle", "time": 4029.309, "timestamp": "01:07:09", "text": "あなたは戻ってくる。もちろん。の"}, {"type": "subtitle", "time": 4032.069, "timestamp": "01:07:12", "text": "コース。私はそうするだろう、私はあなたにそうするだろう、しかし私はそうするだろう"}, {"type": "subtitle", "time": 4035.029, "timestamp": "01:07:15", "text": "常にあなたにメッセージを送ってください、助けてください"}, {"type": "subtitle", "time": 4037.67, "timestamp": "01:07:17", "text": "私を外します。ええ、それは理解しました。ええ、でも"}, {"type": "subtitle", "time": 4040.63, "timestamp": "01:07:20", "text": "問題はタイムゾーンだ。"}, {"type": "subtitle", "time": 4042.63, "timestamp": "01:07:22", "text": "大丈夫だよ、サンタさん。私は"}, {"type": "subtitle", "time": 4044.23, "timestamp": "01:07:24", "text": "とにかく私のシフトなので、あなたは"}, {"type": "subtitle", "time": 4048.87, "timestamp": "01:07:28", "text": "タイムゾーンを気にする必要はない。こんにちは。うん。"}, {"type": "subtitle", "time": 4051.069, "timestamp": "01:07:31", "text": "うん、写真を送るよ"}, {"type": "subtitle", "time": 4054.47, "timestamp": "01:07:34", "text": "お好みでどうぞ。ぜひそうしたいです。"}, {"type": "subtitle", "time": 4058.789, "timestamp": "01:07:38", "text": "食べ物の写真を送ってください。食べ物。"}, {"type": "subtitle", "time": 4061.51, "timestamp": "01:07:41", "text": "食べ物の写真が欲しいです。こんな感じ"}, {"type": "subtitle", "time": 4071.51, "timestamp": "01:07:51", "text": "はい。うん。そして、私も"}, {"type": "subtitle", "time": 4074.71, "timestamp": "01:07:54", "text": "富士山のような景色を見てください。"}, {"type": "subtitle", "time": 4077.67, "timestamp": "01:07:57", "text": "ああ、訪問。"}]
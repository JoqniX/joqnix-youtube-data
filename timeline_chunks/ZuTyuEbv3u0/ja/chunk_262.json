[{"type": "subtitle", "time": 15723.91, "timestamp": "04:22:03", "text": "私の側からすると、統合されたチャット機能のことです。"}, {"type": "subtitle", "time": 15726.229, "timestamp": "04:22:06", "text": "右下のやつ。現在、"}, {"type": "subtitle", "time": 15730.229, "timestamp": "04:22:10", "text": "YouTube Twitch キックとチャットを設定しました。"}, {"type": "subtitle", "time": 15733.67, "timestamp": "04:22:13", "text": "これは水平方向のもので、"}, {"type": "subtitle", "time": 15736.75, "timestamp": "04:22:16", "text": "底。でも、それが"}, {"type": "subtitle", "time": 15739.11, "timestamp": "04:22:19", "text": "目立つ。あのデカい尻を知ってるよ"}, {"type": "subtitle", "time": 15741.349, "timestamp": "04:22:21", "text": "Teonのようなストリーマーが"}, {"type": "subtitle", "time": 15744.63, "timestamp": "04:22:24", "text": "YouTube、Twitchでマルチリームを使用し、"}, {"type": "subtitle", "time": 15747.75, "timestamp": "04:22:27", "text": "彼の配信のチャットを統合した"}, {"type": "subtitle", "time": 15750.07, "timestamp": "04:22:30", "text": "YouTubeとTwitchのチャットは1つでした"}, {"type": "subtitle", "time": 15752.71, "timestamp": "04:22:32", "text": "物事を一緒に知る、このことを知る"}, {"type": "subtitle", "time": 15755.309, "timestamp": "04:22:35", "text": "それぞれに別々のチャットではなく"}, {"type": "subtitle", "time": 15760.309, "timestamp": "04:22:40", "text": "プラットフォーム。ええ、彼は言われたとおりに"}, {"type": "subtitle", "time": 15762.63, "timestamp": "04:22:42", "text": "Twitch関連のもの、そうかもしれないし"}, {"type": "subtitle", "time": 15765.189, "timestamp": "04:22:45", "text": "禁止対象になるものや削除すべきもの"}, {"type": "subtitle", "time": 15771.349, "timestamp": "04:22:51", "text": "もの。えっと、彼らはこうすると思うんだけど"}, {"type": "subtitle", "time": 15773.83, "timestamp": "04:22:53", "text": "大きなものを持っていると、人々は"}, {"type": "subtitle", "time": 15778.67, "timestamp": "04:22:58", "text": "顔面キック 顔面キック"}]
[{"type": "subtitle", "time": 421.749, "timestamp": "00:07:01", "text": "通常、それは私が来たら"}, {"type": "subtitle", "time": 423.749, "timestamp": "00:07:03", "text": "あなたの世界、私はこれからも手に入れ続けるでしょう"}, {"type": "subtitle", "time": 426.23, "timestamp": "00:07:06", "text": "手に入れずに、取らずに"}, {"type": "subtitle", "time": 428.71, "timestamp": "00:07:08", "text": "消臭剤みたいなもの？"}, {"type": "subtitle", "time": 431.589, "timestamp": "00:07:11", "text": "うん。ドッキングステーションに行かなければならない。"}, {"type": "subtitle", "time": 434.55, "timestamp": "00:07:14", "text": "わかった。つまり、私は"}, {"type": "subtitle", "time": 438.23, "timestamp": "00:07:18", "text": "それなら塔まで行かなければならない。"}, {"type": "subtitle", "time": 440.629, "timestamp": "00:07:20", "text": "あ、待って。私はできません"}, {"type": "subtitle", "time": 443.029, "timestamp": "00:07:23", "text": "私は走れない。"}, {"type": "subtitle", "time": 447.35, "timestamp": "00:07:27", "text": "テレポート機能はありません。あなたは？"}, {"type": "subtitle", "time": 450.39, "timestamp": "00:07:30", "text": "残念ながら、テレポート機能はありません。うん。ああ、私は"}, {"type": "subtitle", "time": 454.15, "timestamp": "00:07:34", "text": "その変人のところまでずっと歩いて行かなければならない。"}, {"type": "subtitle", "time": 459.189, "timestamp": "00:07:39", "text": "わかった。私は頻繁にシーシャを吸っています。おお。"}]
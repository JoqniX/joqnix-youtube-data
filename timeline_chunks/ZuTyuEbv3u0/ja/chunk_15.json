[{"type": "subtitle", "time": 902.389, "timestamp": "00:15:02", "text": "わかった。わかった。少し時間をください。わかった。"}, {"type": "subtitle", "time": 906.79, "timestamp": "00:15:06", "text": "見てみましょう。わかった。マッチメイキングと"}, {"type": "subtitle", "time": 910.15, "timestamp": "00:15:10", "text": "できます、できます。わかりました。わかった。ジャック。わかった。"}, {"type": "subtitle", "time": 925.15, "timestamp": "00:15:25", "text": "えっと、エスケープキーを押すと、"}, {"type": "subtitle", "time": 928.87, "timestamp": "00:15:28", "text": "友達と、それから「あー、わかった」って感じ。"}, {"type": "subtitle", "time": 932.15, "timestamp": "00:15:32", "text": "ええと、参加するような機能はありません。うん。うん。"}, {"type": "subtitle", "time": 933.91, "timestamp": "00:15:33", "text": "うん。うん。もしあなたがそうするなら。うん。"}, {"type": "subtitle", "time": 937.23, "timestamp": "00:15:37", "text": "参加する。参加する。 「参加」をクリックします。どこ"}, {"type": "subtitle", "time": 940.069, "timestamp": "00:15:40", "text": "参加する？ゲームへの招待と"}, {"type": "subtitle", "time": 941.23, "timestamp": "00:15:41", "text": "選択して"}, {"type": "subtitle", "time": 947.99, "timestamp": "00:15:47", "text": "戻る。いいえ。文字通りこんな感じです"}, {"type": "subtitle", "time": 953.189, "timestamp": "00:15:53", "text": "例えば、出口に行く場合など。そうそう。えっと"}, {"type": "subtitle", "time": 956.069, "timestamp": "00:15:56", "text": "うん。招待待ち。はい。はい。受け入れる"}, {"type": "subtitle", "time": 959.03, "timestamp": "00:15:59", "text": "それ。私は待つ。だから、招待状を送ってください。"}]
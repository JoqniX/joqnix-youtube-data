[{"type": "subtitle", "time": 11882.15, "timestamp": "03:18:02", "text": "ありがとう。ニース。"}, {"type": "subtitle", "time": 11884.15, "timestamp": "03:18:04", "text": "州。ええ、もしあなたが私になるつもりなら"}, {"type": "subtitle", "time": 11887.95, "timestamp": "03:18:07", "text": "バンガロールか、おそらくケララ州に行くでしょう。"}, {"type": "subtitle", "time": 11890.51, "timestamp": "03:18:10", "text": "ああ、いいね。"}, {"type": "subtitle", "time": 11893.83, "timestamp": "03:18:13", "text": "ニース。バンガロールは、たくさんの"}, {"type": "subtitle", "time": 11896.63, "timestamp": "03:18:16", "text": "人々は今バンガロールにいます。うん、"}, {"type": "subtitle", "time": 11898.15, "timestamp": "03:18:18", "text": "バンガロールはあらゆるものが混ざり合ったような街だ"}, {"type": "subtitle", "time": 11905.51, "timestamp": "03:18:25", "text": "バンガロールは、その名前で知られているか、"}, {"type": "subtitle", "time": 11908.469, "timestamp": "03:18:28", "text": "人々が忘れてしまったようなもの"}, {"type": "subtitle", "time": 11913.469, "timestamp": "03:18:33", "text": "バンガロールをテクノロジーのように呼ぶ"}, {"type": "subtitle", "time": 11916.87, "timestamp": "03:18:36", "text": "都市か何かの地区だったと思うけど、何だったか忘れた"}, {"type": "subtitle", "time": 11919.03, "timestamp": "03:18:39", "text": "彼らはまたバンガロールに電話するの？"}, {"type": "subtitle", "time": 11920.63, "timestamp": "03:18:40", "text": "そこにはたくさんの人がいて、"}, {"type": "subtitle", "time": 11928.15, "timestamp": "03:18:48", "text": "それについてはよくわからないので、聞いてみます。"}, {"type": "subtitle", "time": 11932.63, "timestamp": "03:18:52", "text": "バンガロールの友達のために。うん。"}, {"type": "subtitle", "time": 11935.349, "timestamp": "03:18:55", "text": "うん。ええ、そうですね。あのね？にいること"}, {"type": "subtitle", "time": 11937.75, "timestamp": "03:18:57", "text": "バンガロールはあなたをきっと好きにさせるでしょう"}]
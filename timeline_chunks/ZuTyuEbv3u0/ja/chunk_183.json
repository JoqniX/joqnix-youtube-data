[{"type": "subtitle", "time": 10991.19, "timestamp": "03:03:11", "text": "こんにちは。待って、聞こえないの？ああ、"}, {"type": "subtitle", "time": 10994.07, "timestamp": "03:03:14", "text": "神。いつからミュートになったの？何てことだ。"}, {"type": "subtitle", "time": 10996.469, "timestamp": "03:03:16", "text": "え、ミュートになってるの？私はそう思った、ええと"}, {"type": "subtitle", "time": 10998.15, "timestamp": "03:03:18", "text": "おそらく雨は切断された"}, {"type": "subtitle", "time": 11001.03, "timestamp": "03:03:21", "text": "私のネットワークか何か。いや、待って。どうやって"}, {"type": "subtitle", "time": 11002.95, "timestamp": "03:03:22", "text": "一日中ミュートされていたの？何？いいえ、違います"}, {"type": "subtitle", "time": 11005.67, "timestamp": "03:03:25", "text": "丸一日。いつミュートされたのですか？"}, {"type": "subtitle", "time": 11009.19, "timestamp": "03:03:29", "text": "いいえ、ルミについて話しているときは。ああ。おお"}, {"type": "subtitle", "time": 11010.349, "timestamp": "03:03:30", "text": "私の"}, {"type": "subtitle", "time": 11013.429, "timestamp": "03:03:33", "text": "神。心配しないで。心配しないで。"}, {"type": "subtitle", "time": 11016.389, "timestamp": "03:03:36", "text": "わかった。こんにちは。ここではミュートされているだけですか、それとも"}, {"type": "subtitle", "time": 11018.95, "timestamp": "03:03:38", "text": "ストリームも？何だって？ああ、それは"}, {"type": "subtitle", "time": 11021.429, "timestamp": "03:03:41", "text": "マイクをミュートにしたのは、私が「えー」って感じだったから"}, {"type": "subtitle", "time": 11024.63, "timestamp": "03:03:44", "text": "何かを拾おうとしている。落ちた"}, {"type": "subtitle", "time": 11027.91, "timestamp": "03:03:47", "text": "私のイヤホンからだが、イヤホンではない"}, {"type": "subtitle", "time": 11029.99, "timestamp": "03:03:49", "text": "それが緩んで落ちてしまったんです。"}, {"type": "subtitle", "time": 11033.51, "timestamp": "03:03:53", "text": "だから私は手を伸ばした。マイクミュート"}, {"type": "subtitle", "time": 11037.269, "timestamp": "03:03:57", "text": "ボタンが押されたか何かしたみたい。おお、"}, {"type": "subtitle", "time": 11038.469, "timestamp": "03:03:58", "text": "つまり、少なくとも少なくとも"}]
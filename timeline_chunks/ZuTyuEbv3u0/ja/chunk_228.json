[{"type": "subtitle", "time": 13680.45, "timestamp": "03:48:00", "text": "あるいは、おそらくそれ以上だろう。"}, {"type": "subtitle", "time": 13686.389, "timestamp": "03:48:06", "text": "うん、彼女はスパイスじゃないね。あなたは"}, {"type": "subtitle", "time": 13688.87, "timestamp": "03:48:08", "text": "わさびを試してみませんか？"}, {"type": "subtitle", "time": 13691.75, "timestamp": "03:48:11", "text": "わさびを試してみるべきだ。ええ、私も"}, {"type": "subtitle", "time": 13698.15, "timestamp": "03:48:18", "text": "試してみるべきだ。"}, {"type": "subtitle", "time": 13700.389, "timestamp": "03:48:20", "text": "彼らが普段どのようにわさびを食べるか見てください。"}, {"type": "subtitle", "time": 13703.269, "timestamp": "03:48:23", "text": "えっと、彼らはそれを何と一緒に食べるんですか？寿司。"}, {"type": "subtitle", "time": 13717.87, "timestamp": "03:48:37", "text": "はい。誰か"}, {"type": "subtitle", "time": 13731.389, "timestamp": "03:48:51", "text": "よし。"}, {"type": "subtitle", "time": 13735.99, "timestamp": "03:48:55", "text": "わかった。 H また、私の試験も進行中です"}, {"type": "subtitle", "time": 13737.59, "timestamp": "03:48:57", "text": "右？"}]
[{"type": "subtitle", "time": 8102.229, "timestamp": "02:15:02", "text": "ジョブストリーム上。次はジャズです。いい感じ"}, {"type": "subtitle", "time": 8104.87, "timestamp": "02:15:04", "text": "皆さん、お会いできて嬉しいです。"}, {"type": "subtitle", "time": 8110.83, "timestamp": "02:15:10", "text": "あなたの"}, {"type": "subtitle", "time": 8115.109, "timestamp": "02:15:15", "text": "車。 HD。こんなことを言って本当にごめんなさい"}, {"type": "subtitle", "time": 8118.39, "timestamp": "02:15:18", "text": "名前を変えたとしても、DGSTは課税対象です。"}, {"type": "subtitle", "time": 8119.629, "timestamp": "02:15:19", "text": "つまり、つまり私は"}, {"type": "subtitle", "time": 8122.31, "timestamp": "02:15:22", "text": "つまり、あなたたちにとっては少し時間がかかるということです"}, {"type": "subtitle", "time": 8126.589, "timestamp": "02:15:26", "text": "それに慣れるために。それで"}, {"type": "subtitle", "time": 8130.149, "timestamp": "02:15:30", "text": "うん、元気？ずっと"}, {"type": "subtitle", "time": 8131.669, "timestamp": "02:15:31", "text": "話した。"}, {"type": "subtitle", "time": 8133.35, "timestamp": "02:15:33", "text": "ええ、本当に長い間"}, {"type": "subtitle", "time": 8135.39, "timestamp": "02:15:35", "text": "私たちが話してから。"}, {"type": "subtitle", "time": 8139.91, "timestamp": "02:15:39", "text": "うん。うん。そして私はとても幸せでした"}, {"type": "subtitle", "time": 8142.55, "timestamp": "02:15:42", "text": "私たちは会って話をした"}, {"type": "subtitle", "time": 8145.83, "timestamp": "02:15:45", "text": "ルーン誕生 アストラのルーン誕生"}, {"type": "subtitle", "time": 8149.75, "timestamp": "02:15:49", "text": "イベント。うん、楽しかったよ。"}, {"type": "subtitle", "time": 8151.75, "timestamp": "02:15:51", "text": "うん、すごく楽しかったよ。新しい人に会うのも楽しかった。"}, {"type": "subtitle", "time": 8153.99, "timestamp": "02:15:53", "text": "人々や、ご存知のように、遊んでいる"}, {"type": "subtitle", "time": 8156.99, "timestamp": "02:15:56", "text": "彼らと一緒にマインクラフトをプレイする。はい。"}]
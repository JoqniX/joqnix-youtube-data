[{"type": "subtitle", "time": 10621.349, "timestamp": "02:57:01", "text": "でも今は、うん、できるって感じ"}, {"type": "subtitle", "time": 10623.59, "timestamp": "02:57:03", "text": "ついにそこへ行った。"}, {"type": "subtitle", "time": 10626.55, "timestamp": "02:57:06", "text": "日本以外ですか、それとも日本国内ですか？日本で？"}, {"type": "subtitle", "time": 10628.87, "timestamp": "02:57:08", "text": "日本でお願いします。"}, {"type": "subtitle", "time": 10629.87, "timestamp": "02:57:09", "text": "おお。"}, {"type": "subtitle", "time": 10633.99, "timestamp": "02:57:13", "text": "えっと、なぜ彼らは行かないの？"}, {"type": "subtitle", "time": 10637.07, "timestamp": "02:57:17", "text": "名古屋または"}, {"type": "subtitle", "time": 10640.75, "timestamp": "02:57:20", "text": "何か？名古屋または東京と"}, {"type": "subtitle", "time": 10644.55, "timestamp": "02:57:24", "text": "あれこれ。あのアニメ、アニメ"}, {"type": "subtitle", "time": 10650.87, "timestamp": "02:57:30", "text": "そう、そしてあなたの名前を知っている"}, {"type": "subtitle", "time": 10653.67, "timestamp": "02:57:33", "text": "あの鉄道の映画、"}, {"type": "subtitle", "time": 10657.03, "timestamp": "02:57:37", "text": "階段、階段、うん、行きたい"}, {"type": "subtitle", "time": 10666.92, "timestamp": "02:57:46", "text": "うん、私が考えた唯一の場所は"}, {"type": "subtitle", "time": 10675.429, "timestamp": "02:57:55", "text": "ああ、そういえば、あなたの名前は"}, {"type": "subtitle", "time": 10678.309, "timestamp": "02:57:58", "text": "アニメ見てる？"}]
[{"type": "subtitle", "time": 14881.11, "timestamp": "04:08:01", "text": "白い色を持っているかどうかなどの質問"}, {"type": "subtitle", "time": 14884.229, "timestamp": "04:08:04", "text": "肌の色がもっと白いモデルのような"}, {"type": "subtitle", "time": 14886.51, "timestamp": "04:08:06", "text": "自分がそうではないと思っているもの"}, {"type": "subtitle", "time": 14889.189, "timestamp": "04:08:09", "text": "インド人の肌の色は一致せず、"}, {"type": "subtitle", "time": 14903.67, "timestamp": "04:08:23", "text": "ニース。探しているゲームはありますか？"}, {"type": "subtitle", "time": 14907.03, "timestamp": "04:08:27", "text": "遊ぶとかそういうのが楽しみ？"}, {"type": "subtitle", "time": 14910.309, "timestamp": "04:08:30", "text": "えっと、今すぐのことですか？それとも一般的なことですか？えーと"}, {"type": "subtitle", "time": 14912.389, "timestamp": "04:08:32", "text": "現在および将来における一般的な権利"}, {"type": "subtitle", "time": 14915.83, "timestamp": "04:08:35", "text": "あなたが楽しみにしているのは"}, {"type": "subtitle", "time": 14917.83, "timestamp": "04:08:37", "text": "つまり、私は言うでしょう、私は言うでしょう"}, {"type": "subtitle", "time": 14919.75, "timestamp": "04:08:39", "text": "現在のすべての情報を入手したいのですが"}, {"type": "subtitle", "time": 14921.11, "timestamp": "04:08:41", "text": "流行のマルチプレイヤーゲームで"}, {"type": "subtitle", "time": 14923.91, "timestamp": "04:08:43", "text": "友達と遊ぶ"}, {"type": "subtitle", "time": 14927.269, "timestamp": "04:08:47", "text": "リポジトリみたいだけど、待って、リポジトリ持ってるよね？"}, {"type": "subtitle", "time": 14931.83, "timestamp": "04:08:51", "text": "うん、持ってるよ、それはいいね"}, {"type": "subtitle", "time": 14935.189, "timestamp": "04:08:55", "text": "うん、完全に私のそれらのゲーム全部うん"}, {"type": "subtitle", "time": 14938.229, "timestamp": "04:08:58", "text": "あなたは、私のノートパソコンが完全に完全に"}]
[{"type": "subtitle", "time": 9963.51, "timestamp": "02:46:03", "text": "日本では特にモデル"}, {"type": "subtitle", "time": 9967.83, "timestamp": "02:46:07", "text": "物やその他すべて。それはまるで"}, {"type": "subtitle", "time": 9970.79, "timestamp": "02:46:10", "text": "えっと、どう言えばいいかな？まるで"}, {"type": "subtitle", "time": 9974.87, "timestamp": "02:46:14", "text": "うまくいくかもしれないし、うまくいかないかもしれない瞬間だから"}, {"type": "subtitle", "time": 9978.87, "timestamp": "02:46:18", "text": "えっと、正直に言うと、"}, {"type": "subtitle", "time": 9981.11, "timestamp": "02:46:21", "text": "アーティストとリガーが一緒に作業するのが好きです"}, {"type": "subtitle", "time": 9985.75, "timestamp": "02:46:25", "text": "このモデルはこの時点では"}, {"type": "subtitle", "time": 9988.55, "timestamp": "02:46:28", "text": "お金が足りなかった"}, {"type": "subtitle", "time": 9992.469, "timestamp": "02:46:32", "text": "手。つまり、それらは保留状態にあるということです。"}, {"type": "subtitle", "time": 9995.19, "timestamp": "02:46:35", "text": "だから私は今月が終わったら"}, {"type": "subtitle", "time": 9997.67, "timestamp": "02:46:37", "text": "手を差し伸べようと思っただけ"}, {"type": "subtitle", "time": 10001.429, "timestamp": "02:46:41", "text": "彼らに知らせる、ええ、私は"}, {"type": "subtitle", "time": 10003.429, "timestamp": "02:46:43", "text": "二人に「うん、私は"}, {"type": "subtitle", "time": 10005.75, "timestamp": "02:46:45", "text": "ジョアソン、クラウドファンディングをやってるよ"}, {"type": "subtitle", "time": 10007.91, "timestamp": "02:46:47", "text": "そして、すべて。最善を尽くします。"}, {"type": "subtitle", "time": 10010.55, "timestamp": "02:46:50", "text": "だから、まあ、試してみたって言うだけだよ"}, {"type": "subtitle", "time": 10015.19, "timestamp": "02:46:55", "text": "できる限り最善を尽くす"}, {"type": "subtitle", "time": 10018.55, "timestamp": "02:46:58", "text": "そして私は、"}]
[{"type": "subtitle", "time": 1802.789, "timestamp": "00:30:02", "text": "はい。うん。"}, {"type": "subtitle", "time": 1808.389, "timestamp": "00:30:08", "text": "あなたが言っていた時のことを覚えています"}, {"type": "subtitle", "time": 1810.789, "timestamp": "00:30:10", "text": "ヴァレラントにどっぷりハマったみたいだね"}, {"type": "subtitle", "time": 1814.95, "timestamp": "00:30:14", "text": "それを完全にアンインストールしたいということですね。"}, {"type": "subtitle", "time": 1816.71, "timestamp": "00:30:16", "text": "そういうことは何度も起こっています"}, {"type": "subtitle", "time": 1819.669, "timestamp": "00:30:19", "text": "回。私たちはもうそのことについては話さない。"}, {"type": "subtitle", "time": 1822.47, "timestamp": "00:30:22", "text": "いや、私たちはそんなレベルじゃない。私たちはそうしません"}, {"type": "subtitle", "time": 1824.87, "timestamp": "00:30:24", "text": "実際、私はまだバラーを持っています"}, {"type": "subtitle", "time": 1828.47, "timestamp": "00:30:28", "text": "画面に表示されているけど、私はプレイしない"}, {"type": "subtitle", "time": 1830.71, "timestamp": "00:30:30", "text": "それ。本当に忙しかったんです。私は"}, {"type": "subtitle", "time": 1832.789, "timestamp": "00:30:32", "text": "たくさん触ってきたから、ほら、えーと"}, {"type": "subtitle", "time": 1835.149, "timestamp": "00:30:35", "text": "コンクリート。"}, {"type": "subtitle", "time": 1840.389, "timestamp": "00:30:40", "text": "この辺りには草が生えていない。ただ"}, {"type": "subtitle", "time": 1842.23, "timestamp": "00:30:42", "text": "どこもかしこもコンクリートだらけ。そう、そうですね、"}, {"type": "subtitle", "time": 1843.99, "timestamp": "00:30:43", "text": "私は歩き回っていました"}, {"type": "subtitle", "time": 1846.23, "timestamp": "00:30:46", "text": "多く。実際、昨日私は"}, {"type": "subtitle", "time": 1849.59, "timestamp": "00:30:49", "text": "5時間ぶっ通しで外にいた。のように、"}, {"type": "subtitle", "time": 1851.99, "timestamp": "00:30:51", "text": "とても暑かった"}, {"type": "subtitle", "time": 1855.59, "timestamp": "00:30:55", "text": "そして私たちは外にいて、私はこう思った。"}, {"type": "subtitle", "time": 1858.549, "timestamp": "00:30:58", "text": "「うわ、これは私には暑すぎる。つまり、"}]
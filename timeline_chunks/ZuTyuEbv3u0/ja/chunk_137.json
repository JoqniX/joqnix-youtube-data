[{"type": "subtitle", "time": 8221.11, "timestamp": "02:17:01", "text": "ああ、それだと学校に行けなくなっちゃうよ"}, {"type": "subtitle", "time": 8223.669, "timestamp": "02:17:03", "text": "仕事も全部順調ですよね？"}, {"type": "subtitle", "time": 8226.07, "timestamp": "02:17:06", "text": "つまり、大学の勉強のために、つまり、"}, {"type": "subtitle", "time": 8228.07, "timestamp": "02:17:08", "text": "今月は必要ないと思います。"}, {"type": "subtitle", "time": 8231.509, "timestamp": "02:17:11", "text": "試験だけだって分かってるけど、7月以降はね"}, {"type": "subtitle", "time": 8233.11, "timestamp": "02:17:13", "text": "最終学年で必要になるかもしれない"}, {"type": "chat", "time": 8237.285, "timestamp": "02:17:17", "author": "@disguisedmage52", "avatar": "https://yt4.ggpht.com/GxHs1Pjek4K9rDWLxk7a5vc4UOg92flOcio1PW3zpZhmKvuCb6hZslc52JOgikbv6tnSZJXhyw=s64-c-k-c0x00ffffff-no-rj", "message": "Yoooo "}, {"type": "subtitle", "time": 8240.309, "timestamp": "02:17:20", "text": "えっと、そちらの生活はどうですか？"}, {"type": "subtitle", "time": 8242.95, "timestamp": "02:17:22", "text": "だって、えーと、私はたくさんの"}, {"type": "subtitle", "time": 8246.03, "timestamp": "02:17:26", "text": "そちら側からの情報。"}, {"type": "subtitle", "time": 8248.469, "timestamp": "02:17:28", "text": "ええ、私が知っているのは、あなたがトレーニングしているということだけです"}, {"type": "subtitle", "time": 8249.99, "timestamp": "02:17:29", "text": "日本語で「あなたのために進む」"}, {"type": "subtitle", "time": 8253.99, "timestamp": "02:17:33", "text": "研究。うん、じゃあまた話そうよ"}, {"type": "subtitle", "time": 8257.11, "timestamp": "02:17:37", "text": "ずっとなかったから、うん、私にとっては"}, {"type": "subtitle", "time": 8260.429, "timestamp": "02:17:40", "text": "人生は続いています"}, {"type": "subtitle", "time": 8269.91, "timestamp": "02:17:49", "text": "えっと、私はついに"}, {"type": "subtitle", "time": 8272.709, "timestamp": "02:17:52", "text": "何をしたいか、どこに行きたいかを決めました"}, {"type": "chat", "time": 8274.19, "timestamp": "02:17:54", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ-r4KpS3_9EP-duW6QoUCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ-r4KpS3_9EP-duW6QoUCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ-r4KpS3_9EP-duW6Qo"}, {"type": "subtitle", "time": 8275.349, "timestamp": "02:17:55", "text": "将来の計画をどうするか、といったこと"}, {"type": "subtitle", "time": 8278.549, "timestamp": "02:17:58", "text": "そして親は喜んでいると思う"}]
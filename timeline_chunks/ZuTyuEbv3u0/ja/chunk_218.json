[{"type": "subtitle", "time": 13081.51, "timestamp": "03:38:01", "text": "夕食を食べますか？"}, {"type": "subtitle", "time": 13084.55, "timestamp": "03:38:04", "text": "ええ、そうしました。私はします。おお、いいね。ニース。その"}, {"type": "subtitle", "time": 13086.309, "timestamp": "03:38:06", "text": "アパートで暮らすのがいいですね"}, {"type": "subtitle", "time": 13087.99, "timestamp": "03:38:07", "text": "ルームメイト。いいえ、それを食べなければなりません"}, {"type": "subtitle", "time": 13089.17, "timestamp": "03:38:09", "text": "財産。"}, {"type": "subtitle", "time": 13092.07, "timestamp": "03:38:12", "text": "[音楽]"}, {"type": "subtitle", "time": 13098.99, "timestamp": "03:38:18", "text": "追加する"}, {"type": "subtitle", "time": 13101.59, "timestamp": "03:38:21", "text": "お好みの料理に卵をいくつか"}, {"type": "subtitle", "time": 13104.07, "timestamp": "03:38:24", "text": "朝は1つあります"}, {"type": "subtitle", "time": 13106.49, "timestamp": "03:38:26", "text": "オムレツかゆで卵。"}, {"type": "subtitle", "time": 13107.83, "timestamp": "03:38:27", "text": "[音楽]"}, {"type": "subtitle", "time": 13109.99, "timestamp": "03:38:29", "text": "だから、たとえ私が食べる量を減らしたとしても"}, {"type": "subtitle", "time": 13112.55, "timestamp": "03:38:32", "text": "現在の食べ物、卵はご存知のように"}, {"type": "subtitle", "time": 13119.67, "timestamp": "03:38:39", "text": "ああ、まるで私の"}, {"type": "subtitle", "time": 13122.51, "timestamp": "03:38:42", "text": "ダイエットはこれ以上進まないだろう"}, {"type": "subtitle", "time": 13125.269, "timestamp": "03:38:45", "text": "大学で負けたみたい"}, {"type": "subtitle", "time": 13128.469, "timestamp": "03:38:48", "text": "ものすごい重さだ。"}, {"type": "subtitle", "time": 13131.349, "timestamp": "03:38:51", "text": "ああ、君はジムに通ってるよね？いやいや"}, {"type": "subtitle", "time": 13133.91, "timestamp": "03:38:53", "text": "いやいや、大学のためにやめたんだ"}, {"type": "subtitle", "time": 13136.389, "timestamp": "03:38:56", "text": "2か月後。"}, {"type": "subtitle", "time": 13139.99, "timestamp": "03:38:59", "text": "M、ジムに行く前に聞いてください、私は47から"}]
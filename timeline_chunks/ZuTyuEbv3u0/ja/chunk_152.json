[{"type": "subtitle", "time": 9120.71, "timestamp": "02:32:00", "text": "今は雨が降っています。"}, {"type": "subtitle", "time": 9130.469, "timestamp": "02:32:10", "text": "こんにちは。ようこそ。こんにちは。ようこそ"}, {"type": "subtitle", "time": 9134.469, "timestamp": "02:32:14", "text": "ストリーム。いらっしゃいませ。いらっしゃいませ。"}, {"type": "subtitle", "time": 9136.07, "timestamp": "02:32:16", "text": "わかった。私はまだ、ほら、自分の"}, {"type": "subtitle", "time": 9144.07, "timestamp": "02:32:24", "text": "えっと、何日間か当ててみて、私は"}, {"type": "subtitle", "time": 9147.11, "timestamp": "02:32:27", "text": "現在参加中。"}, {"type": "subtitle", "time": 9153.27, "timestamp": "02:32:33", "text": "日？ 86か何か。 42"}, {"type": "subtitle", "time": 9162.15, "timestamp": "02:32:42", "text": "くそ、つまり、私はまだまだ"}, {"type": "subtitle", "time": 9163.83, "timestamp": "02:32:43", "text": "漢字も覚えていないし、"}, {"type": "subtitle", "time": 9177.67, "timestamp": "02:32:57", "text": "うん、まだ記念してない"}]
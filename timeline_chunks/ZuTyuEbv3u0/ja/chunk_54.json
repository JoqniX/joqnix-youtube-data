[{"type": "subtitle", "time": 3241.91, "timestamp": "00:54:01", "text": "うん。うん。"}, {"type": "subtitle", "time": 3244.15, "timestamp": "00:54:04", "text": "わーい。"}, {"type": "subtitle", "time": 3247.15, "timestamp": "00:54:07", "text": "私はこの曲が大好きです"}, {"type": "subtitle", "time": 3249.51, "timestamp": "00:54:09", "text": "取って、次にすることは"}, {"type": "subtitle", "time": 3252.47, "timestamp": "00:54:12", "text": "ああ、一体何が起こっているんだ？"}, {"type": "subtitle", "time": 3254.47, "timestamp": "00:54:14", "text": "いや、これはまずい。これはまずい。私はしません"}, {"type": "subtitle", "time": 3256.63, "timestamp": "00:54:16", "text": "実際に誰かいる？このやり方は"}, {"type": "subtitle", "time": 3260.63, "timestamp": "00:54:20", "text": "悪い。大丈夫だよ。"}, {"type": "subtitle", "time": 3262.71, "timestamp": "00:54:22", "text": "今、あなたはそれに勝っています。あなたは"}, {"type": "subtitle", "time": 3266.069, "timestamp": "00:54:26", "text": "正義の三つの柱。あなたにはあなたがいます"}, {"type": "subtitle", "time": 3269.27, "timestamp": "00:54:29", "text": "1、2、3、4、5、6 のようなもの"}, {"type": "subtitle", "time": 3271.99, "timestamp": "00:54:31", "text": "兵士、あるいはポッド。"}, {"type": "subtitle", "time": 3281.109, "timestamp": "00:54:41", "text": "大丈夫だよ。私には女王がいる。私はできる"}, {"type": "subtitle", "time": 3299.63, "timestamp": "00:54:59", "text": "私は、えっと"}]
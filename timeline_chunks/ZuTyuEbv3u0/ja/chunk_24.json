[{"type": "subtitle", "time": 1443.51, "timestamp": "00:24:03", "text": "何てことだ。こんにちは。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 1445.51, "timestamp": "00:24:05", "text": "ようこそ"}, {"type": "subtitle", "time": 1458.43, "timestamp": "00:24:18", "text": "えっと、私はこう尋ねます"}, {"type": "subtitle", "time": 1466.71, "timestamp": "00:24:26", "text": "あなた。わかった。つまり、成長していく過程みたいなものですよね？"}, {"type": "subtitle", "time": 1468.23, "timestamp": "00:24:28", "text": "教えてあげましょう。教えてあげましょう。これは"}, {"type": "subtitle", "time": 1470.789, "timestamp": "00:24:30", "text": "ニース。これは良い質問ですね。全て"}, {"type": "subtitle", "time": 1474.549, "timestamp": "00:24:34", "text": "右。だから、私が考えるとき、"}, {"type": "subtitle", "time": 1477.19, "timestamp": "00:24:37", "text": "私が12歳の時だったよね？それが最初だった"}, {"type": "subtitle", "time": 1480.789, "timestamp": "00:24:40", "text": "私がアニメを見始めた頃。わかった。そして"}, {"type": "subtitle", "time": 1483.19, "timestamp": "00:24:43", "text": "アニメを見るという概念は"}, {"type": "subtitle", "time": 1484.95, "timestamp": "00:24:44", "text": "突然現れた。それはただ、"}, {"type": "subtitle", "time": 1487.269, "timestamp": "00:24:47", "text": "当時人気だった。ちょうど"}, {"type": "subtitle", "time": 1489.83, "timestamp": "00:24:49", "text": "私の年齢層でとても人気があります"}, {"type": "subtitle", "time": 1491.909, "timestamp": "00:24:51", "text": "人々、ですよね？そして私は見始めた"}, {"type": "subtitle", "time": 1494.549, "timestamp": "00:24:54", "text": "そして私はいつも、ほら、"}, {"type": "subtitle", "time": 1496.549, "timestamp": "00:24:56", "text": "つまり、私はずっとそこに行きたかったんです。私"}]
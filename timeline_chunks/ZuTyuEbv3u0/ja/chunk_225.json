[{"type": "subtitle", "time": 13503.269, "timestamp": "03:45:03", "text": "それは本当だ。そう、だから私はこう思ったんだ"}, {"type": "subtitle", "time": 13506.309, "timestamp": "03:45:06", "text": "正直に言って、本当に本物のことをしたかった"}, {"type": "subtitle", "time": 13509.99, "timestamp": "03:45:09", "text": "大学とかそういうのだけど、私は"}, {"type": "subtitle", "time": 13512.79, "timestamp": "03:45:12", "text": "えっと、もし私が拾われたらどうなるんだろう"}, {"type": "subtitle", "time": 13515.429, "timestamp": "03:45:15", "text": "あるいは何か、あるいは私は"}, {"type": "subtitle", "time": 13518.71, "timestamp": "03:45:18", "text": "勉強？学校みたいなことはしたくない"}, {"type": "subtitle", "time": 13520.55, "timestamp": "03:45:20", "text": "そういう類のもの。"}, {"type": "subtitle", "time": 13522.63, "timestamp": "03:45:22", "text": "私の理解では、もしも？うん、"}, {"type": "subtitle", "time": 13524.229, "timestamp": "03:45:24", "text": "彼らは主に"}, {"type": "subtitle", "time": 13526.469, "timestamp": "03:45:26", "text": "主に反社会的な子供たち"}, {"type": "subtitle", "time": 13535.51, "timestamp": "03:45:35", "text": "そう、まさにそこなんです。"}, {"type": "subtitle", "time": 13537.91, "timestamp": "03:45:37", "text": "ええ、大学に入学したらすぐに、"}, {"type": "subtitle", "time": 13539.429, "timestamp": "03:45:39", "text": "あなたはグループに留まらなければならない"}, {"type": "subtitle", "time": 13541.51, "timestamp": "03:45:41", "text": "あなたはそれが"}, {"type": "subtitle", "time": 13543.75, "timestamp": "03:45:43", "text": "十分に友好的だ。そうでなければ、それらは"}, {"type": "subtitle", "time": 13546.75, "timestamp": "03:45:46", "text": "いくつかは次のように"}, {"type": "subtitle", "time": 13549.99, "timestamp": "03:45:49", "text": "結局はそうなるだろう。あまり"}, {"type": "subtitle", "time": 13558.87, "timestamp": "03:45:58", "text": "うん。"}]
[{"type": "subtitle", "time": 2710.63, "timestamp": "00:45:10", "text": "私がそうしたら、あなたのお気に入りは何ですか？"}, {"type": "subtitle", "time": 2713.27, "timestamp": "00:45:13", "text": "食べ物ですか、先輩？気を紛らわせて"}, {"type": "subtitle", "time": 2715.19, "timestamp": "00:45:15", "text": "若干。"}, {"type": "subtitle", "time": 2718.67, "timestamp": "00:45:18", "text": "好きな食べ物は？えっと、ちょっと待って。"}, {"type": "subtitle", "time": 2722.349, "timestamp": "00:45:22", "text": "はぁ？いいえ、いいえ、"}, {"type": "subtitle", "time": 2726.63, "timestamp": "00:45:26", "text": "いいえ、敵陣地へ突入するのです。ああ、"}, {"type": "subtitle", "time": 2732.75, "timestamp": "00:45:32", "text": "おお"}, {"type": "subtitle", "time": 2737.75, "timestamp": "00:45:37", "text": "うん。お前の兵士を一人倒した。"}, {"type": "subtitle", "time": 2740.63, "timestamp": "00:45:40", "text": "わかった。良い、"}, {"type": "subtitle", "time": 2744.91, "timestamp": "00:45:44", "text": "これはいい気晴らしになる。何"}, {"type": "subtitle", "time": 2748.79, "timestamp": "00:45:48", "text": "おお。待って、何をしたの？ ああ、わかった。見て"}, {"type": "subtitle", "time": 2752.01, "timestamp": "00:45:52", "text": "兵士を連れ出せ。それはもう私のものだ。"}, {"type": "subtitle", "time": 2759.43, "timestamp": "00:45:59", "text": "私は何でも食べます。私はこだわりが強いタイプではありません。"}]
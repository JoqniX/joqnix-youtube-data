[{"type": "subtitle", "time": 5288.709, "timestamp": "01:28:08", "text": "ストーリーは「一体どういうことだ？」"}, {"type": "subtitle", "time": 5303.59, "timestamp": "01:28:23", "text": "ガイド。こういう時は、"}, {"type": "subtitle", "time": 5306.149, "timestamp": "01:28:26", "text": "私の友人が"}, {"type": "subtitle", "time": 5326.709, "timestamp": "01:28:46", "text": "[音楽]"}, {"type": "subtitle", "time": 5328.75, "timestamp": "01:28:48", "text": "私は愛する"}, {"type": "subtitle", "time": 5331.27, "timestamp": "01:28:51", "text": "ちょっと確認させてください。確認してみます。私にさせて"}]
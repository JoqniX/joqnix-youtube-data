[{"type": "subtitle", "time": 8582.309, "timestamp": "02:23:02", "text": "数時間前、あるいは4時間前。おお、いいね。ニース。"}, {"type": "subtitle", "time": 8585.83, "timestamp": "02:23:05", "text": "ああ、もちろんです。もちろん。"}, {"type": "subtitle", "time": 8592.429, "timestamp": "02:23:12", "text": "行く。"}, {"type": "subtitle", "time": 8595.07, "timestamp": "02:23:15", "text": "M男。"}, {"type": "subtitle", "time": 8599.349, "timestamp": "02:23:19", "text": "ああ、まだ、まだ気分が悪い"}, {"type": "subtitle", "time": 8601.429, "timestamp": "02:23:21", "text": "まるで私が"}, {"type": "subtitle", "time": 8605.349, "timestamp": "02:23:25", "text": "ええと、今でもあなたのことを昔の名前で呼んでいます。ああ、"}, {"type": "subtitle", "time": 8609.429, "timestamp": "02:23:29", "text": "待って。これをTwitterで見かけました。"}, {"type": "subtitle", "time": 8611.429, "timestamp": "02:23:31", "text": "Twitterをやってますか？えっと、ちょうど終わったところです"}, {"type": "subtitle", "time": 8612.87, "timestamp": "02:23:32", "text": "今。私は投稿していないと確信しています"}, {"type": "subtitle", "time": 8614.87, "timestamp": "02:23:34", "text": "Twitterで投稿しました。え、Twitterじゃないの？どこ"}, {"type": "subtitle", "time": 8617.349, "timestamp": "02:23:37", "text": "そうだったのか？これ、どこかで見たような気がするんだけど？"}, {"type": "subtitle", "time": 8619.19, "timestamp": "02:23:39", "text": "つまり、私はそれを投稿したのですが、"}, {"type": "subtitle", "time": 8622.23, "timestamp": "02:23:42", "text": "在庫のほとんど。"}, {"type": "subtitle", "time": 8624.389, "timestamp": "02:23:44", "text": "あ、待って。あなたはそこでそれを実行しました。ああ、違う"}, {"type": "subtitle", "time": 8627.27, "timestamp": "02:23:47", "text": "インスタグラム。ああ、ああ、ああ。私は見たと思う"}, {"type": "subtitle", "time": 8630.19, "timestamp": "02:23:50", "text": "ああ、そうだね。うん。うん。うん。"}]
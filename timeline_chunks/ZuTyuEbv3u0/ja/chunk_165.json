[{"type": "subtitle", "time": 9900.15, "timestamp": "02:45:00", "text": "4月ならもっとたくさん手に入れられたのに"}, {"type": "subtitle", "time": 9903.51, "timestamp": "02:45:03", "text": "まるで私が終わらせることができたかのように"}, {"type": "subtitle", "time": 9907.59, "timestamp": "02:45:07", "text": "2022年、2023年、そして"}, {"type": "subtitle", "time": 9910.71, "timestamp": "02:45:10", "text": "4月と5月に私ができることはすべて"}, {"type": "subtitle", "time": 9914.71, "timestamp": "02:45:14", "text": "最近知り合った人たちとだけ話します。"}, {"type": "subtitle", "time": 9918.07, "timestamp": "02:45:18", "text": "それが当初の構想だった。それから、"}, {"type": "subtitle", "time": 9920.23, "timestamp": "02:45:20", "text": "Minecraftみたいなのがあったよ。それから私は"}, {"type": "subtitle", "time": 9923.67, "timestamp": "02:45:23", "text": "気分が悪くて、"}, {"type": "subtitle", "time": 9925.83, "timestamp": "02:45:25", "text": "ストリーム配信を強制したり、"}, {"type": "subtitle", "time": 9928.389, "timestamp": "02:45:28", "text": "すべては今。だから私は「ああ、私は"}, {"type": "subtitle", "time": 9930.95, "timestamp": "02:45:30", "text": "やりたいけど、やらなきゃいけないのは"}, {"type": "subtitle", "time": 9933.99, "timestamp": "02:45:33", "text": "一瞬。スーパーチャットを手に入れて以来、"}, {"type": "subtitle", "time": 9937.11, "timestamp": "02:45:37", "text": "それらのロックが解除されたので、私はこう思いました"}, {"type": "subtitle", "time": 9940.03, "timestamp": "02:45:40", "text": "続けるべきか迷っている"}, {"type": "subtitle", "time": 9942.87, "timestamp": "02:45:42", "text": "これ？それから私は考えるのをやめた"}, {"type": "subtitle", "time": 9946.07, "timestamp": "02:45:46", "text": "否定的に、とにかくやるしかない"}, {"type": "subtitle", "time": 9949.75, "timestamp": "02:45:49", "text": "来月には出発する予定です。 7月"}, {"type": "subtitle", "time": 9959.91, "timestamp": "02:45:59", "text": "えっと、私が"}]
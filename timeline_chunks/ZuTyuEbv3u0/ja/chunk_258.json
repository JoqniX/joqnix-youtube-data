[{"type": "subtitle", "time": 15481.349, "timestamp": "04:18:01", "text": "会社が手伝ってくれたり、いろいろやってくれたり、"}, {"type": "subtitle", "time": 15484.07, "timestamp": "04:18:04", "text": "解散したとか、そういうこと。だから私は私は"}, {"type": "subtitle", "time": 15488.389, "timestamp": "04:18:08", "text": "放っておいてもいいよ。だから私は"}, {"type": "subtitle", "time": 15490.63, "timestamp": "04:18:10", "text": "えっと、私を助けてくれたのは"}, {"type": "subtitle", "time": 15492.55, "timestamp": "04:18:12", "text": "彼らは私に連絡してきて、そう言った"}, {"type": "subtitle", "time": 15494.87, "timestamp": "04:18:14", "text": "正式にその組織を離れる必要がある。"}, {"type": "subtitle", "time": 15497.429, "timestamp": "04:18:17", "text": "つまり、去るという選択肢があったということだ。彼らは"}, {"type": "subtitle", "time": 15499.99, "timestamp": "04:18:19", "text": "休暇終了契約書を送ってくれ"}, {"type": "subtitle", "time": 15503.349, "timestamp": "04:18:23", "text": "ビリーのサイトからの何か。だから私は"}, {"type": "subtitle", "time": 15506.07, "timestamp": "04:18:26", "text": "「同意する」をクリックすれば、すべて完了です。"}, {"type": "subtitle", "time": 15508.55, "timestamp": "04:18:28", "text": "だから、私は、"}, {"type": "subtitle", "time": 15512.469, "timestamp": "04:18:32", "text": "公式ビリービリー、あのメチューバー、あの"}, {"type": "subtitle", "time": 15514.83, "timestamp": "04:18:34", "text": "QQグループとか、そういうやつ。だから、私は"}, {"type": "subtitle", "time": 15517.59, "timestamp": "04:18:37", "text": "個別に質問します。独立した私として"}, {"type": "subtitle", "time": 15521.51, "timestamp": "04:18:41", "text": "ホワイトリストのようなものを要求することができます。"}, {"type": "subtitle", "time": 15524.07, "timestamp": "04:18:44", "text": "でも、もう5日間も試しているんです。彼らは"}, {"type": "subtitle", "time": 15526.95, "timestamp": "04:18:46", "text": "入れてくれない。兄弟は"}, {"type": "subtitle", "time": 15530.189, "timestamp": "04:18:50", "text": "全員非アクティブ？ 400人が見える"}, {"type": "subtitle", "time": 15532.95, "timestamp": "04:18:52", "text": "そこには。それは完全にユーチューバーのようなものになるでしょう"}, {"type": "subtitle", "time": 15537.03, "timestamp": "04:18:57", "text": "でも、それでも入れてくれよ。"}, {"type": "subtitle", "time": 15539.95, "timestamp": "04:18:59", "text": "あの人を中に入れてください。"}]
[{"type": "subtitle", "time": 1561.99, "timestamp": "00:26:01", "text": "観光客としてその国を訪れる。あなた"}, {"type": "subtitle", "time": 1564.35, "timestamp": "00:26:04", "text": "私はそこには行かないだろう"}, {"type": "subtitle", "time": 1567.59, "timestamp": "00:26:07", "text": "そして、私たちは戻ってきたのでしょうか？私たちは戻ってきたのでしょうか？私たちは"}, {"type": "subtitle", "time": 1569.789, "timestamp": "00:26:09", "text": "戻る？こんにちは、私たちは"}, {"type": "subtitle", "time": 1573.43, "timestamp": "00:26:13", "text": "戻る。サイズ変更をしていました。"}, {"type": "subtitle", "time": 1576.95, "timestamp": "00:26:16", "text": "私はここにいるのか？こんにちは。私はここにいるのか？ああ、私は"}, {"type": "subtitle", "time": 1579.19, "timestamp": "00:26:19", "text": "私がそこにいると思う？それとも、私はそこにいないの？私は"}, {"type": "subtitle", "time": 1581.43, "timestamp": "00:26:21", "text": "妄想？うん。うん。ああ、ポール。"}, {"type": "subtitle", "time": 1585.11, "timestamp": "00:26:25", "text": "私があなたをそこまで連れて行きます。 1秒。"}, {"type": "subtitle", "time": 1588.07, "timestamp": "00:26:28", "text": "グループはどこにいますか？わかった。"}, {"type": "chat", "time": 1588.933, "timestamp": "00:26:28", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "ara?"}, {"type": "subtitle", "time": 1591.11, "timestamp": "00:26:31", "text": "わかった。こんにちは。あなたはここにいるべきだ。ええ、私たちは"}, {"type": "chat", "time": 1593.68, "timestamp": "00:26:33", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "we bac"}, {"type": "subtitle", "time": 1596.95, "timestamp": "00:26:36", "text": "戻ってきた。わーい。さあ行こう。わかった。それで、えーと"}, {"type": "subtitle", "time": 1599.59, "timestamp": "00:26:39", "text": "理由はわかりました。でも、あなたはそう言いますか？"}, {"type": "subtitle", "time": 1601.43, "timestamp": "00:26:41", "text": "ホームシックになるから？私はそうは思わない"}, {"type": "subtitle", "time": 1604.39, "timestamp": "00:26:44", "text": "私はホームシックになるのは、えっと、私は誰かだから"}, {"type": "subtitle", "time": 1608.87, "timestamp": "00:26:48", "text": "引っ越しが多いので、"}, {"type": "subtitle", "time": 1611.35, "timestamp": "00:26:51", "text": "もはや私の一部ではないので好きになれない"}, {"type": "subtitle", "time": 1612.59, "timestamp": "00:26:52", "text": "考えてみてください"}, {"type": "subtitle", "time": 1615.029, "timestamp": "00:26:55", "text": "ああ、そう思うよ。"}, {"type": "subtitle", "time": 1618.39, "timestamp": "00:26:58", "text": "ホームシックだけど、あなたは私が"}, {"type": "subtitle", "time": 1619.909, "timestamp": "00:26:59", "text": "特定の場所を思い浮かべる"}]
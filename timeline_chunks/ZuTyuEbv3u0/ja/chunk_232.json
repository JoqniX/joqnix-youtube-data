[{"type": "subtitle", "time": 13920.87, "timestamp": "03:52:00", "text": "うん、いいことだよ、いいこと"}, {"type": "subtitle", "time": 13922.87, "timestamp": "03:52:02", "text": "洪水は発生していません。または"}, {"type": "subtitle", "time": 13925.189, "timestamp": "03:52:05", "text": "おそらくそうかもしれないが、都市側では"}, {"type": "subtitle", "time": 13931.189, "timestamp": "03:52:11", "text": "もっと重いもの。聞こえますか？"}, {"type": "subtitle", "time": 13934.63, "timestamp": "03:52:14", "text": "私のマイク？ええ、はっきりと聞こえますよ。おお"}, {"type": "subtitle", "time": 13938.389, "timestamp": "03:52:18", "text": "我が神よ。待って、あれは音声ですか？"}, {"type": "subtitle", "time": 13940.229, "timestamp": "03:52:20", "text": "今ではなく、ほんの数秒後"}, {"type": "subtitle", "time": 13947.67, "timestamp": "03:52:27", "text": "でも、あなたは騒音を消しましたか？"}, {"type": "subtitle", "time": 13950.07, "timestamp": "03:52:30", "text": "何か目的のための抑制"}, {"type": "subtitle", "time": 13954.07, "timestamp": "03:52:34", "text": "えっと、私はユニバーサルのものを持っていたのですが"}, {"type": "subtitle", "time": 13956.71, "timestamp": "03:52:36", "text": "使用していない間もDiscordに影響を与える"}, {"type": "subtitle", "time": 13959.67, "timestamp": "03:52:39", "text": "Discordのノイズ抑制機能があれば"}, {"type": "subtitle", "time": 13963.269, "timestamp": "03:52:43", "text": "それを使うと私のPCはラグったり、"}, {"type": "subtitle", "time": 13965.83, "timestamp": "03:52:45", "text": "音声にかなりの遅延が発生します。だから私は"}, {"type": "subtitle", "time": 13968.63, "timestamp": "03:52:48", "text": "明らかにオフにする"}, {"type": "subtitle", "time": 13972.07, "timestamp": "03:52:52", "text": "のみ。ノイズ抑制を"}, {"type": "subtitle", "time": 13974.55, "timestamp": "03:52:54", "text": "えーと、Discordとか。生のままで"}, {"type": "subtitle", "time": 13977.51, "timestamp": "03:52:57", "text": "マイク音声。"}]
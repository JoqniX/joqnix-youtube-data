[{"type": "subtitle", "time": 9601.91, "timestamp": "02:40:01", "text": "おい、俺はゲームをたくさん買ったんだ"}, {"type": "subtitle", "time": 9604.07, "timestamp": "02:40:04", "text": "将来コラボレーションするためだけのチーム"}, {"type": "subtitle", "time": 9607.469, "timestamp": "02:40:07", "text": "それが手に入れるために"}, {"type": "subtitle", "time": 9614.349, "timestamp": "02:40:14", "text": "会社を買収した。ニース。ニース。"}, {"type": "subtitle", "time": 9618.67, "timestamp": "02:40:18", "text": "まるでみんなを知っているかのように変わる"}, {"type": "subtitle", "time": 9622.95, "timestamp": "02:40:22", "text": "ほとんどの人と同じように、彼らは小さな"}, {"type": "subtitle", "time": 9627.51, "timestamp": "02:40:27", "text": "会社やその他多くのこと"}, {"type": "subtitle", "time": 9646.389, "timestamp": "02:40:46", "text": "どうやってこれを思いついたの？"}, {"type": "subtitle", "time": 9648.71, "timestamp": "02:40:48", "text": "設定することでこれを行うというアイデア"}, {"type": "subtitle", "time": 9652.55, "timestamp": "02:40:52", "text": "自動のようにすべてを上げる"}, {"type": "subtitle", "time": 9654.95, "timestamp": "02:40:54", "text": "アーカイブビデオが再生されていて、"}, {"type": "subtitle", "time": 9658.469, "timestamp": "02:40:58", "text": "もの。ああ、あれね。うん。だから、"}]
[{"type": "subtitle", "time": 14582.309, "timestamp": "04:03:02", "text": "つまり、少なくとも以前はそうだった"}, {"type": "subtitle", "time": 14585.189, "timestamp": "04:03:05", "text": "これまで私たちはあなたを建国の父として仰いでいましたが"}, {"type": "subtitle", "time": 14589.59, "timestamp": "04:03:09", "text": "ああ、君もいなくなってしまったんだね、ああ、一度だけ"}, {"type": "subtitle", "time": 14592.309, "timestamp": "04:03:12", "text": "私は日本にいる、インドのようにはならない、いや私は"}, {"type": "subtitle", "time": 14595.349, "timestamp": "04:03:15", "text": "インドになるだろうが、それでも"}, {"type": "subtitle", "time": 14598.07, "timestamp": "04:03:18", "text": "えっと、それは感覚になるか、今私は"}, {"type": "subtitle", "time": 14601.429, "timestamp": "04:03:21", "text": "別の国にいて、私はこう思う"}, {"type": "subtitle", "time": 14605.429, "timestamp": "04:03:25", "text": "なんだか偽善者みたいに感じてしまう。 O"}, {"type": "subtitle", "time": 14607.11, "timestamp": "04:03:27", "text": "おいおい、頼むよ。おいおい、兄弟。たとえ内部であっても"}, {"type": "subtitle", "time": 14609.71, "timestamp": "04:03:29", "text": "インドでは、私たちはほとんど行動しません"}, {"type": "subtitle", "time": 14613.03, "timestamp": "04:03:33", "text": "インド人を除く"}, {"type": "subtitle", "time": 14615.63, "timestamp": "04:03:35", "text": "それは本当だ。"}, {"type": "subtitle", "time": 14618.389, "timestamp": "04:03:38", "text": "真実。それに、私も知らないってことはお互い分かってるよね"}, {"type": "subtitle", "time": 14621.229, "timestamp": "04:03:41", "text": "現在、ヒンディー語が広く使われている。だからそれは"}, {"type": "subtitle", "time": 14623.99, "timestamp": "04:03:43", "text": "痛み。周りのみんなが知っている"}, {"type": "subtitle", "time": 14628.229, "timestamp": "04:03:48", "text": "ヒンディー語とかそういう類。うわぁ、って感じ。"}, {"type": "subtitle", "time": 14629.67, "timestamp": "04:03:49", "text": "うん、わかるよね？"}, {"type": "subtitle", "time": 14632.55, "timestamp": "04:03:52", "text": "それが執着の部分だ。うん。毎"}, {"type": "subtitle", "time": 14634.63, "timestamp": "04:03:54", "text": "インド人ユーチューバー1人がインドについてよく知っている。私は"}, {"type": "subtitle", "time": 14636.269, "timestamp": "04:03:56", "text": "のように"}, {"type": "subtitle", "time": 14639.11, "timestamp": "04:03:59", "text": "何？くそ。"}]
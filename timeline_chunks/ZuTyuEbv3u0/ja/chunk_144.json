[{"type": "subtitle", "time": 8641.85, "timestamp": "02:24:01", "text": "本当に改善しました"}, {"type": "subtitle", "time": 8642.99, "timestamp": "02:24:02", "text": "[音楽]"}, {"type": "subtitle", "time": 8647.469, "timestamp": "02:24:07", "text": "多く。うん。久しぶりですね"}, {"type": "subtitle", "time": 8651.67, "timestamp": "02:24:11", "text": "今。ニース。待って、えっと、あなたはそれを"}, {"type": "subtitle", "time": 8654.71, "timestamp": "02:24:14", "text": "スマホの指で描いた絵のことですよね？"}, {"type": "subtitle", "time": 8657.27, "timestamp": "02:24:17", "text": "はい。タブレットを持っているにもかかわらず、"}, {"type": "subtitle", "time": 8660.63, "timestamp": "02:24:20", "text": "今もスマホと指で絵を描いています。"}, {"type": "subtitle", "time": 8664.19, "timestamp": "02:24:24", "text": "それはすばらしい。それは良い。それは"}, {"type": "subtitle", "time": 8666.429, "timestamp": "02:24:26", "text": "いいぞ、相棒。"}, {"type": "subtitle", "time": 8673.59, "timestamp": "02:24:33", "text": "いいね、君。モデルの作成を開始します。 M はい、見ています"}, {"type": "subtitle", "time": 8676.79, "timestamp": "02:24:36", "text": "PNG を前に進めていますが、それでもまだ"}, {"type": "subtitle", "time": 8679.99, "timestamp": "02:24:39", "text": "モデル的なものではなく、単一のものです"}, {"type": "subtitle", "time": 8681.95, "timestamp": "02:24:41", "text": "PNG"}, {"type": "subtitle", "time": 8685.51, "timestamp": "02:24:45", "text": "ええ、それで、もしよろしければお聞きしたいのですが"}, {"type": "subtitle", "time": 8688.23, "timestamp": "02:24:48", "text": "何がきっかけでブランドを刷新しようと思ったのですか？"}, {"type": "subtitle", "time": 8689.91, "timestamp": "02:24:49", "text": "起こった"}, {"type": "subtitle", "time": 8692.469, "timestamp": "02:24:52", "text": "つまり、リブランディングしたかっただけなんです"}, {"type": "subtitle", "time": 8694.87, "timestamp": "02:24:54", "text": "なぜなら、つまりDHという名前は"}, {"type": "subtitle", "time": 8696.95, "timestamp": "02:24:56", "text": "それは私の周りにあったもの"}, {"type": "subtitle", "time": 8699.11, "timestamp": "02:24:59", "text": "発見する前の学校時代"}]
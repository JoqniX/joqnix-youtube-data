[{"type": "subtitle", "time": 8523.03, "timestamp": "02:22:03", "text": "地理は、たとえ生きているだけでも"}, {"type": "subtitle", "time": 8525.03, "timestamp": "02:22:05", "text": "はい。自分の母国語を知らないはず"}, {"type": "subtitle", "time": 8530.27, "timestamp": "02:22:10", "text": "場所。同じ。私もわかりません。"}, {"type": "subtitle", "time": 8535.99, "timestamp": "02:22:15", "text": "うん。こんにちは。えっと、メルラ・メラ・トワイライト。"}, {"type": "subtitle", "time": 8538.309, "timestamp": "02:22:18", "text": "ストリームへようこそ。いらっしゃいませ。この男は"}, {"type": "subtitle", "time": 8540.309, "timestamp": "02:22:20", "text": "結婚。いらっしゃいませ。ディアブロ。いらっしゃいませ。"}, {"type": "subtitle", "time": 8542.71, "timestamp": "02:22:22", "text": "ハラール。"}, {"type": "subtitle", "time": 8545.11, "timestamp": "02:22:25", "text": "皆さん、お元気ですか？皆さんお元気ですか？"}, {"type": "subtitle", "time": 8547.469, "timestamp": "02:22:27", "text": "何をしているの？この素晴らしい"}, {"type": "subtitle", "time": 8550.95, "timestamp": "02:22:30", "text": "夕方。うん。"}, {"type": "subtitle", "time": 8555.91, "timestamp": "02:22:35", "text": "えっと、アート関係の調子はどうですか？"}, {"type": "subtitle", "time": 8557.15, "timestamp": "02:22:37", "text": "芸術性はどうですか？"}, {"type": "subtitle", "time": 8561.51, "timestamp": "02:22:41", "text": "もの？待って、えっと、あなたは"}, {"type": "subtitle", "time": 8563.27, "timestamp": "02:22:43", "text": "漫画とかをやりたかったんだけど、"}, {"type": "subtitle", "time": 8566.23, "timestamp": "02:22:46", "text": "右？私の理解が正しければ。"}, {"type": "subtitle", "time": 8568.309, "timestamp": "02:22:48", "text": "ああ、そうだけど、今は"}, {"type": "subtitle", "time": 8570.389, "timestamp": "02:22:50", "text": "大学とかそういうものでいっぱい。それで"}, {"type": "subtitle", "time": 8572.15, "timestamp": "02:22:52", "text": "うん、私はただ絵を描いているだけ"}, {"type": "subtitle", "time": 8578.87, "timestamp": "02:22:58", "text": "3時頃にこれを描き終えたところです"}]
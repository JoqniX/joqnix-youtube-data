[{"type": "subtitle", "time": 962.87, "timestamp": "00:16:02", "text": "ええと、参加してみます。いやいやいやいや。"}, {"type": "subtitle", "time": 964.79, "timestamp": "00:16:04", "text": "あなたが招待状を送ってくれたら、私はそれを受け入れなければならない"}, {"type": "subtitle", "time": 967.99, "timestamp": "00:16:07", "text": "それ。その代わりに、私は何も行動を起こさなかった。"}, {"type": "subtitle", "time": 970.55, "timestamp": "00:16:10", "text": "バカ。それはまるであなたが私のゲームに参加するようなものだ。"}, {"type": "subtitle", "time": 973.509, "timestamp": "00:16:13", "text": "右？私もあなたのグループに参加したいです。"}, {"type": "subtitle", "time": 975.11, "timestamp": "00:16:15", "text": "あなたが参加しようとしているセクションは"}, {"type": "subtitle", "time": 976.949, "timestamp": "00:16:16", "text": "難易度：普通。何？"}, {"type": "subtitle", "time": 980.67, "timestamp": "00:16:20", "text": "停止。あなたは私に加わった。どのような？おお、"}, {"type": "subtitle", "time": 982.67, "timestamp": "00:16:22", "text": "待って。"}, {"type": "subtitle", "time": 987.269, "timestamp": "00:16:27", "text": "続く。続く。私にください 私にください"}, {"type": "subtitle", "time": 990.15, "timestamp": "00:16:30", "text": "分。ちょっと待ってください。わかった。私はします"}, {"type": "subtitle", "time": 992.71, "timestamp": "00:16:32", "text": "ご招待します。はい。見てみましょう。見てみましょう。"}, {"type": "subtitle", "time": 994.87, "timestamp": "00:16:34", "text": "見てみましょう。私たちはこれを本当に提供している。どうやって"}, {"type": "subtitle", "time": 997.749, "timestamp": "00:16:37", "text": "ところで、私を招待してくれたの？クリックします"}, {"type": "subtitle", "time": 1001.509, "timestamp": "00:16:41", "text": "メニューを開いてクリックすると"}, {"type": "subtitle", "time": 1004.389, "timestamp": "00:16:44", "text": "あなたの名前を書いて、ボタンを押しました。私は"}, {"type": "subtitle", "time": 1008.13, "timestamp": "00:16:48", "text": "ゾンビの[ __ ]の真っ只中。"}, {"type": "subtitle", "time": 1018.31, "timestamp": "00:16:58", "text": "私はただこれらを蹴り飛ばしているだけです"}]
[{"type": "subtitle", "time": 2.909, "timestamp": "00:00:02", "text": "私はこう思った"}, {"type": "subtitle", "time": 25.59, "timestamp": "00:00:25", "text": "とにかく、彼らは新しいストーリーを持っています"}, {"type": "subtitle", "time": 27.67, "timestamp": "00:00:27", "text": "そうなんです。"}, {"type": "subtitle", "time": 30.71, "timestamp": "00:00:30", "text": "ええ、そうです。ああ、RGBは実際にこう言った"}, {"type": "subtitle", "time": 34.389, "timestamp": "00:00:34", "text": "こんにちは。こんにちは。ごめんなさい。そうそう。私"}, {"type": "subtitle", "time": 36.389, "timestamp": "00:00:36", "text": "あなたがそうだった時にそう言った"}, {"type": "subtitle", "time": 42.31, "timestamp": "00:00:42", "text": "それを解明したかったんです。私はとても"}, {"type": "subtitle", "time": 43.95, "timestamp": "00:00:43", "text": "ごめん。私"}, {"type": "subtitle", "time": 46.19, "timestamp": "00:00:46", "text": "しなかった"}, {"type": "subtitle", "time": 49.43, "timestamp": "00:00:49", "text": "私はここにいるような感じです。大丈夫です。"}, {"type": "subtitle", "time": 57.91, "timestamp": "00:00:57", "text": "彼に電話すればいい。誰からの電話ですか？何が"}]
[{"type": "subtitle", "time": 3903.51, "timestamp": "01:05:03", "text": "物事について知っていることもあれば、知らないこともある。うん、"}, {"type": "subtitle", "time": 3906.71, "timestamp": "01:05:06", "text": "サンタさん、それは始まりだけではありませんでした。"}, {"type": "subtitle", "time": 3909.43, "timestamp": "01:05:09", "text": "あなたは私の問題を次のように処理していました"}, {"type": "subtitle", "time": 3912.069, "timestamp": "01:05:12", "text": "私の作戦で、私の物で、"}, {"type": "subtitle", "time": 3916.23, "timestamp": "01:05:16", "text": "過去3年間、いいですか？毎回のように"}, {"type": "subtitle", "time": 3917.99, "timestamp": "01:05:17", "text": "戻ってきて、ほら、私は"}, {"type": "subtitle", "time": 3920.069, "timestamp": "01:05:20", "text": "何時間もそこにいることを覚えておいてください"}, {"type": "subtitle", "time": 3923.43, "timestamp": "01:05:23", "text": "自分のものを直そうとしているだけです、そして"}, {"type": "subtitle", "time": 3925.51, "timestamp": "01:05:25", "text": "ほら、1つは直されて、それから"}, {"type": "subtitle", "time": 3928.829, "timestamp": "01:05:28", "text": "もう一つの問題は解消されるだろう。私のカメラ"}, {"type": "subtitle", "time": 3931.069, "timestamp": "01:05:31", "text": "消えた"}, {"type": "subtitle", "time": 3935.029, "timestamp": "01:05:35", "text": "やりたいことがたくさんある。まるでそうしなければならなかったかのように"}, {"type": "subtitle", "time": 3936.87, "timestamp": "01:05:36", "text": "たくさん、それから私はこう思った。「ねえ、知ってる？」"}, {"type": "subtitle", "time": 3941.99, "timestamp": "01:05:41", "text": "地図のキャップを見つけました。大丈夫です。"}, {"type": "subtitle", "time": 3944.15, "timestamp": "01:05:44", "text": "それに、ほら、すごく多いんだよ。"}, {"type": "subtitle", "time": 3946.309, "timestamp": "01:05:46", "text": "すごく多いですね。そして、ありがとう、"}, {"type": "subtitle", "time": 3949.029, "timestamp": "01:05:49", "text": "知ってるよ、そこにいて私を助けてくれて"}, {"type": "subtitle", "time": 3952.15, "timestamp": "01:05:52", "text": "私の問題を解決し、そして、"}, {"type": "subtitle", "time": 3956.309, "timestamp": "01:05:56", "text": "私が好きなことを続けられるように。そしてそれは"}]
[{"type": "subtitle", "time": 15242.349, "timestamp": "04:14:02", "text": "他のゲーム。"}, {"type": "subtitle", "time": 15244.429, "timestamp": "04:14:04", "text": "うん。"}, {"type": "subtitle", "time": 15252.389, "timestamp": "04:14:12", "text": "本当に楽しかったよ、君もね。気をつけて。"}, {"type": "subtitle", "time": 15254.63, "timestamp": "04:14:14", "text": "私たちは今後もっと一緒に過ごすことになるでしょう"}, {"type": "subtitle", "time": 15259.149, "timestamp": "04:14:19", "text": "良い。うん。うん。願っています。"}, {"type": "subtitle", "time": 15263.51, "timestamp": "04:14:23", "text": "はい。こんにちは。私もこれで失礼します。"}, {"type": "subtitle", "time": 15265.429, "timestamp": "04:14:25", "text": "おやすみ。"}, {"type": "subtitle", "time": 15271.71, "timestamp": "04:14:31", "text": "まるで3時間しか寝ていないみたい"}, {"type": "subtitle", "time": 15274.71, "timestamp": "04:14:34", "text": "昨日はコラージュを3つ作りました。"}, {"type": "subtitle", "time": 15280.349, "timestamp": "04:14:40", "text": "私は心が死んでいる。そうそう。そうそう。"}, {"type": "subtitle", "time": 15284.309, "timestamp": "04:14:44", "text": "はい。真夜中のやつをやる予定だったんだけど"}, {"type": "subtitle", "time": 15289.03, "timestamp": "04:14:49", "text": "今日。私は「いや、違う」と思いました。私はできません。病気"}, {"type": "subtitle", "time": 15293.269, "timestamp": "04:14:53", "text": "その間に死ぬ。だから、延期します"}, {"type": "subtitle", "time": 15296.07, "timestamp": "04:14:56", "text": "次は、金曜日の真ん中ですね。うん、金曜日"}, {"type": "subtitle", "time": 15299.189, "timestamp": "04:14:59", "text": "午前0時～午前3時"}]
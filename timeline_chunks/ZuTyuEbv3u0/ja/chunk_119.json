[{"type": "subtitle", "time": 7153.589, "timestamp": "01:59:13", "text": "間違っている。なるほど、つまり私たちは"}, {"type": "subtitle", "time": 7155.669, "timestamp": "01:59:15", "text": "ここは私たちだけのものだ。教えてください"}, {"type": "subtitle", "time": 7171.51, "timestamp": "01:59:31", "text": "お待ちください。いいえ、これは違います。"}, {"type": "subtitle", "time": 7172.629, "timestamp": "01:59:32", "text": "待って、待って、待って、待って、待って。どこ"}, {"type": "subtitle", "time": 7174.75, "timestamp": "01:59:34", "text": "偶像"}, {"type": "subtitle", "time": 7177.75, "timestamp": "01:59:37", "text": "また？混乱した私の脳は処理できない"}, {"type": "subtitle", "time": 7183.31, "timestamp": "01:59:43", "text": "どこ"}, {"type": "subtitle", "time": 7185.229, "timestamp": "01:59:45", "text": "[音楽]"}, {"type": "subtitle", "time": 7191.75, "timestamp": "01:59:51", "text": "ああ、これですね。わかった。はい。"}]
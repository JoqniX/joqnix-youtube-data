[{"type": "subtitle", "time": 7329.709, "timestamp": "02:02:09", "text": "[音楽]"}, {"type": "subtitle", "time": 7358.87, "timestamp": "02:02:38", "text": "電話して、今すぐ寝なさい。待って、もう寝る時間だよ"}, {"type": "subtitle", "time": 7361.589, "timestamp": "02:02:41", "text": "すでに。時刻は9時15分です。そうそう。修正しました"}, {"type": "subtitle", "time": 7363.669, "timestamp": "02:02:43", "text": "あなたのスケジュール。忘れた。うん。良い"}, {"type": "subtitle", "time": 7364.88, "timestamp": "02:02:44", "text": "運。"}]
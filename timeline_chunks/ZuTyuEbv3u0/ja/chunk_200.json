[{"type": "subtitle", "time": 12000.99, "timestamp": "03:20:00", "text": "ああ、いい感じになってきたね"}, {"type": "subtitle", "time": 12003.11, "timestamp": "03:20:03", "text": "理論上の？理論とか色々"}, {"type": "subtitle", "time": 12005.75, "timestamp": "03:20:05", "text": "コンピュータサイエンスのために。"}, {"type": "subtitle", "time": 12008.75, "timestamp": "03:20:08", "text": "どちらかというとプログラムに近いと言えるでしょう。"}, {"type": "subtitle", "time": 12010.55, "timestamp": "03:20:10", "text": "プログラミング。"}, {"type": "subtitle", "time": 12012.79, "timestamp": "03:20:12", "text": "私はプログラミングの本を見たことがあります"}, {"type": "subtitle", "time": 12016.07, "timestamp": "03:20:16", "text": "コーディングはとても大きくて複雑だ。私は"}, {"type": "subtitle", "time": 12019.95, "timestamp": "03:20:19", "text": "あなたはこれを学びますか？私は、"}, {"type": "subtitle", "time": 12023.349, "timestamp": "03:20:23", "text": "聖書のように見える大きな"}, {"type": "subtitle", "time": 12025.83, "timestamp": "03:20:25", "text": "むしろ、聖書を2冊1冊にまとめたようなものだ"}, {"type": "subtitle", "time": 12029.83, "timestamp": "03:20:29", "text": "本。それはJavaやC++のようなコーディングです"}, {"type": "subtitle", "time": 12031.51, "timestamp": "03:20:31", "text": "本。"}, {"type": "subtitle", "time": 12033.269, "timestamp": "03:20:33", "text": "それは奇妙だ、それは奇妙だ"}, {"type": "subtitle", "time": 12035.11, "timestamp": "03:20:35", "text": "興味深い比較だが"}, {"type": "chat", "time": 12040.53, "timestamp": "03:20:40", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "4 years into coding ... i dont wanna be alive any longer"}, {"type": "subtitle", "time": 12040.75, "timestamp": "03:20:40", "text": "うん、"}, {"type": "subtitle", "time": 12044.87, "timestamp": "03:20:44", "text": "友達、いや友達じゃない人を見たんだけど"}, {"type": "subtitle", "time": 12048.229, "timestamp": "03:20:48", "text": "いとこの叔父の古い本"}, {"type": "subtitle", "time": 12052.07, "timestamp": "03:20:52", "text": "彼の家を訪ねた私は"}, {"type": "subtitle", "time": 12054.99, "timestamp": "03:20:54", "text": "なんてこった、彼はコンピューターエンジニアリングをやったんだ"}]
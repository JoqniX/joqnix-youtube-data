[{"type": "subtitle", "time": 2160.15, "timestamp": "00:36:00", "text": "はい、そうです。"}, {"type": "subtitle", "time": 2163.75, "timestamp": "00:36:03", "text": "うん。幸運を祈ります。"}, {"type": "subtitle", "time": 2166.069, "timestamp": "00:36:06", "text": "問題は、私はとても子供っぽいということです。"}, {"type": "subtitle", "time": 2168.87, "timestamp": "00:36:08", "text": "命が吹き込まれる。おそらく多くの不足がある"}, {"type": "subtitle", "time": 2171.43, "timestamp": "00:36:11", "text": "豊富な経験。どうやって"}, {"type": "subtitle", "time": 2173.03, "timestamp": "00:36:13", "text": "世界は機能する。これは良い"}, {"type": "subtitle", "time": 2177.03, "timestamp": "00:36:17", "text": "それを直接学ぶ機会。"}, {"type": "subtitle", "time": 2180.31, "timestamp": "00:36:20", "text": "うん。はい、そうするべきでした。でも私は"}, {"type": "subtitle", "time": 2182.15, "timestamp": "00:36:22", "text": "詐欺に遭うことを心配しています"}, {"type": "subtitle", "time": 2187.27, "timestamp": "00:36:27", "text": "私は簡単に手に入るから、そういうものが欲しいんです。いや、いや、いや、"}, {"type": "subtitle", "time": 2190.63, "timestamp": "00:36:30", "text": "いいえ。そうですね、私は、ほとんどの"}, {"type": "subtitle", "time": 2193.19, "timestamp": "00:36:33", "text": "あなたが普段好きなもの"}, {"type": "subtitle", "time": 2195.19, "timestamp": "00:36:35", "text": "リサーチしたり、入手したりするのと同じように"}, {"type": "subtitle", "time": 2198.15, "timestamp": "00:36:38", "text": "オンラインプラットフォームで、"}, {"type": "subtitle", "time": 2200.31, "timestamp": "00:36:40", "text": "お店に行くか、"}, {"type": "subtitle", "time": 2203.75, "timestamp": "00:36:43", "text": "地元の市場だよ、わかるだろ？そうそう。うん。"}, {"type": "subtitle", "time": 2206.47, "timestamp": "00:36:46", "text": "地元の食べ物など、"}, {"type": "subtitle", "time": 2208.79, "timestamp": "00:36:48", "text": "外に出て手に入れなければならない。他に"}, {"type": "subtitle", "time": 2210.87, "timestamp": "00:36:50", "text": "それは、あなたが手に入れることができると言えるでしょう"}, {"type": "subtitle", "time": 2212.95, "timestamp": "00:36:52", "text": "オンラインのもののほとんど"}, {"type": "subtitle", "time": 2215.03, "timestamp": "00:36:55", "text": "代わりに、しばらくの間、"}, {"type": "subtitle", "time": 2216.71, "timestamp": "00:36:56", "text": "物事がどのように機能するか理解しています。なぜなら私は"}, {"type": "subtitle", "time": 2219.829, "timestamp": "00:36:59", "text": "外国人は詐欺に遭う可能性が高い"}]
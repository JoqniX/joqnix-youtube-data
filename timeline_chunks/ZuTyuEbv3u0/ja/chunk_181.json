[{"type": "subtitle", "time": 10863.429, "timestamp": "03:01:03", "text": "ああ、いつかは。彼が戻ってきてくれるといいな。"}, {"type": "subtitle", "time": 10866.87, "timestamp": "03:01:06", "text": "それはとても、今でも覚えているのですが、まるで"}, {"type": "subtitle", "time": 10869.59, "timestamp": "03:01:09", "text": "まるで昨日のことのようだった"}, {"type": "subtitle", "time": 10872.15, "timestamp": "03:01:12", "text": "例えば、私がこのように考えているとき"}, {"type": "subtitle", "time": 10873.99, "timestamp": "03:01:13", "text": "まるで昨日のことのようで、私たちみんなが"}, {"type": "subtitle", "time": 10876.71, "timestamp": "03:01:16", "text": "複数のDMグループで交流し、"}, {"type": "subtitle", "time": 10886.79, "timestamp": "03:01:26", "text": "なあ、今やどれだけ進化したんだ。ああ、"}, {"type": "subtitle", "time": 10889.349, "timestamp": "03:01:29", "text": "神。"}, {"type": "subtitle", "time": 10891.389, "timestamp": "03:01:31", "text": "私は高校生でした。今私は"}, {"type": "subtitle", "time": 10894.55, "timestamp": "03:01:34", "text": "大学に進学したいと思っていて、実際"}, {"type": "subtitle", "time": 10912.07, "timestamp": "03:01:52", "text": "うん。新しいユーチューバーは、とても"}, {"type": "subtitle", "time": 10916.15, "timestamp": "03:01:56", "text": "魅力的で、より一貫性がある。"}, {"type": "subtitle", "time": 10919.11, "timestamp": "03:01:59", "text": "真実。真実。"}]
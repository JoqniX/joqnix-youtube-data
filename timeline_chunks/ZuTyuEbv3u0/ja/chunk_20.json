[{"type": "subtitle", "time": 1200.87, "timestamp": "00:20:00", "text": "分かるよ、それは私にそんな気持ちにさせるんだ"}, {"type": "subtitle", "time": 1203.43, "timestamp": "00:20:03", "text": "私はすぐそこにいるのでとても幸せです"}, {"type": "subtitle", "time": 1206.47, "timestamp": "00:20:06", "text": "古い礼拝、私の最も古い礼拝、"}, {"type": "subtitle", "time": 1209.27, "timestamp": "00:20:09", "text": "知ってるでしょ、私はただのちょっとおかしな子なの"}, {"type": "subtitle", "time": 1211.35, "timestamp": "00:20:11", "text": "画面の端に赤ちゃんがいます。感謝"}, {"type": "subtitle", "time": 1214.23, "timestamp": "00:20:14", "text": "招待していただき、本当にありがとうございました。"}, {"type": "subtitle", "time": 1218.39, "timestamp": "00:20:18", "text": "はい、もちろんです。 D、"}, {"type": "subtitle", "time": 1222.07, "timestamp": "00:20:22", "text": "元気でしたか？生活はどうですか？"}, {"type": "subtitle", "time": 1226.07, "timestamp": "00:20:26", "text": "私は元気でした。"}, {"type": "subtitle", "time": 1228.39, "timestamp": "00:20:28", "text": "つまり、私は大丈夫だったんだけど、"}, {"type": "subtitle", "time": 1232.47, "timestamp": "00:20:32", "text": "すごく忙しいし、あのね、私は"}, {"type": "subtitle", "time": 1235.029, "timestamp": "00:20:35", "text": "自分のための時間は常に確保しましょう。だから私は"}, {"type": "subtitle", "time": 1237.83, "timestamp": "00:20:37", "text": "「やったー、行くぞ、そして私は"}, {"type": "subtitle", "time": 1240.71, "timestamp": "00:20:40", "text": "JosとPieのストリームに行く予定です。さあ"}, {"type": "subtitle", "time": 1244.71, "timestamp": "00:20:44", "text": "「行くよ。」でも、全体的な寿命は、まあ、"}, {"type": "subtitle", "time": 1246.71, "timestamp": "00:20:46", "text": "もっと優しくしてくれるかもしれないけど、でも、"}, {"type": "subtitle", "time": 1248.549, "timestamp": "00:20:48", "text": "知ってるでしょ、本当に一生懸命働かないといけないの"}, {"type": "subtitle", "time": 1250.71, "timestamp": "00:20:50", "text": "特定の出来事が起こるために。そうですね、"}, {"type": "subtitle", "time": 1252.87, "timestamp": "00:20:52", "text": "やってますよ。"}, {"type": "subtitle", "time": 1259.35, "timestamp": "00:20:59", "text": "元気でしたか？私は元気でした。私は"}]
[{"type": "subtitle", "time": 10323.51, "timestamp": "02:52:03", "text": "えっと、誰が見てるかはわからないけど、"}, {"type": "subtitle", "time": 10326.63, "timestamp": "02:52:06", "text": "気をつけなきゃいけない、本当に気をつけなきゃ。"}, {"type": "subtitle", "time": 10331.99, "timestamp": "02:52:11", "text": "私が言うのは、それができるから、できるから"}, {"type": "subtitle", "time": 10334.55, "timestamp": "02:52:14", "text": "法的に認められるようにしてください。"}, {"type": "subtitle", "time": 10337.269, "timestamp": "02:52:17", "text": "ええ、そうですね。えっと、ちょっと待って。"}, {"type": "subtitle", "time": 10341.429, "timestamp": "02:52:21", "text": "ちょっとミュートにして、言わせてください。"}, {"type": "subtitle", "time": 10359.51, "timestamp": "02:52:39", "text": "つまり、つまり、そうしない方がいい"}, {"type": "subtitle", "time": 10361.11, "timestamp": "02:52:41", "text": "なぜなら、私はあなたが"}, {"type": "subtitle", "time": 10367.51, "timestamp": "02:52:47", "text": "トラブル。よし。わかったよ。"}, {"type": "subtitle", "time": 10374.71, "timestamp": "02:52:54", "text": "うん。むしろ、買わなければならないという感じです"}, {"type": "subtitle", "time": 10377.469, "timestamp": "02:52:57", "text": "ライセンスを少しの間。"}]
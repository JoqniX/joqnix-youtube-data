[{"type": "subtitle", "time": 10500.95, "timestamp": "02:55:00", "text": "Among UsのINV機能について"}, {"type": "subtitle", "time": 10503.03, "timestamp": "02:55:03", "text": "日。"}, {"type": "subtitle", "time": 10506.71, "timestamp": "02:55:06", "text": "最後の試合のように"}, {"type": "subtitle", "time": 10508.309, "timestamp": "02:55:08", "text": "そしてそれが私が最初に勝ったもの"}, {"type": "subtitle", "time": 10510.63, "timestamp": "02:55:10", "text": "詐欺師。"}, {"type": "subtitle", "time": 10513.75, "timestamp": "02:55:13", "text": "うん、君はインポスターとして勝ったね。はい、"}, {"type": "subtitle", "time": 10516.83, "timestamp": "02:55:16", "text": "その後、私たちは1試合プレイしたと思います"}, {"type": "subtitle", "time": 10519.99, "timestamp": "02:55:19", "text": "そのバージョンを脚に付けます。"}, {"type": "subtitle", "time": 10522.269, "timestamp": "02:55:22", "text": "はい。はい。"}, {"type": "subtitle", "time": 10530.469, "timestamp": "02:55:30", "text": "その後のスピーカーたちのことはとてもよく覚えている"}, {"type": "subtitle", "time": 10533.51, "timestamp": "02:55:33", "text": "地球上でついにお互いに出会い、"}, {"type": "subtitle", "time": 10535.79, "timestamp": "02:55:35", "text": "さあ、私たちはここにいる。"}, {"type": "subtitle", "time": 10538.58, "timestamp": "02:55:38", "text": "はい。ホタル"}, {"type": "subtitle", "time": 10539.71, "timestamp": "02:55:39", "text": "[音楽]"}, {"type": "subtitle", "time": 10551.91, "timestamp": "02:55:51", "text": "私の"}, {"type": "subtitle", "time": 10556.79, "timestamp": "02:55:56", "text": "来年、大学卒業生は一人もいない。"}]
[{"type": "subtitle", "time": 8281.589, "timestamp": "02:18:01", "text": "ええ、実は私は夢を追いかけているんです"}, {"type": "subtitle", "time": 8284.629, "timestamp": "02:18:04", "text": "従うか、私がしたいことをする。私は"}, {"type": "subtitle", "time": 8287.509, "timestamp": "02:18:07", "text": "そうして、私は彼らにそのアイデアを伝えました"}, {"type": "subtitle", "time": 8290.23, "timestamp": "02:18:10", "text": "私が日本に行きたいと思っていることと"}, {"type": "subtitle", "time": 8293.91, "timestamp": "02:18:13", "text": "彼らが既に知っていることすべて"}, {"type": "subtitle", "time": 8297.99, "timestamp": "02:18:17", "text": "家から聞こえてくるように、私が話しているとき"}, {"type": "subtitle", "time": 8302.95, "timestamp": "02:18:22", "text": "人々は今ストリーミング配信していることを知っています"}, {"type": "subtitle", "time": 8305.99, "timestamp": "02:18:25", "text": "私は中国語を少し話せます"}, {"type": "subtitle", "time": 8308.79, "timestamp": "02:18:28", "text": "あるいは、そんな感じ。"}, {"type": "subtitle", "time": 8310.389, "timestamp": "02:18:30", "text": "わかった。"}, {"type": "subtitle", "time": 8313.83, "timestamp": "02:18:33", "text": "ええ、彼らは、"}, {"type": "subtitle", "time": 8315.83, "timestamp": "02:18:35", "text": "隣人やゲストに伝える"}, {"type": "subtitle", "time": 8318.309, "timestamp": "02:18:38", "text": "さあ、彼らは自慢してこう言うんだ、"}, {"type": "subtitle", "time": 8320.23, "timestamp": "02:18:40", "text": "息子は中国語か何かを知っている。彼"}, {"type": "subtitle", "time": 8323.03, "timestamp": "02:18:43", "text": "オンラインで人と話すと、私は"}, {"type": "subtitle", "time": 8332.23, "timestamp": "02:18:52", "text": "それはまるで人々が今でも誤解しているのと同じだ"}, {"type": "subtitle", "time": 8335.91, "timestamp": "02:18:55", "text": "えっと、イギリス人向けのアメリカ英語です。"}]
[{"type": "subtitle", "time": 14762.229, "timestamp": "04:06:02", "text": "もの。はい。うん。今は私は"}, {"type": "subtitle", "time": 14764.15, "timestamp": "04:06:04", "text": "最近、新しいマイクを購入して修理しました"}, {"type": "subtitle", "time": 14767.03, "timestamp": "04:06:07", "text": "1つ。インターネット接続を直さないといけない。"}, {"type": "subtitle", "time": 14769.349, "timestamp": "04:06:09", "text": "うん。"}, {"type": "subtitle", "time": 14773.83, "timestamp": "04:06:13", "text": "私は、"}, {"type": "subtitle", "time": 14775.51, "timestamp": "04:06:15", "text": "その間。その後、私は切り替えます"}, {"type": "subtitle", "time": 14777.57, "timestamp": "04:06:17", "text": "新しいノートパソコンを買ってみてください。"}, {"type": "subtitle", "time": 14778.91, "timestamp": "04:06:18", "text": "[音楽]"}, {"type": "subtitle", "time": 14782.95, "timestamp": "04:06:22", "text": "うん。ニース。"}, {"type": "subtitle", "time": 14785.67, "timestamp": "04:06:25", "text": "そして私は、私が感じるようにしたい"}, {"type": "subtitle", "time": 14787.99, "timestamp": "04:06:27", "text": "可能性は無限大です"}, {"type": "subtitle", "time": 14790.15, "timestamp": "04:06:30", "text": "地元の聴衆とすべて"}, {"type": "subtitle", "time": 14792.389, "timestamp": "04:06:32", "text": "一般視聴者向けなど"}, {"type": "subtitle", "time": 14794.95, "timestamp": "04:06:34", "text": "人々は今、このような寸劇などをやっている"}, {"type": "subtitle", "time": 14797.51, "timestamp": "04:06:37", "text": "彼ら自身の言語で"}, {"type": "subtitle", "time": 14799.99, "timestamp": "04:06:39", "text": "そして、すべてがとても良いものになるでしょう。"}, {"type": "subtitle", "time": 14802.15, "timestamp": "04:06:42", "text": "たくさんのアイデアがあります"}, {"type": "subtitle", "time": 14803.67, "timestamp": "04:06:43", "text": "チューブ。"}, {"type": "subtitle", "time": 14805.83, "timestamp": "04:06:45", "text": "うん。人々はそれを試みようとしていない。"}, {"type": "subtitle", "time": 14808.229, "timestamp": "04:06:48", "text": "そこが問題なんです。唯一の"}, {"type": "subtitle", "time": 14810.309, "timestamp": "04:06:50", "text": "私がそれをしない理由は"}, {"type": "subtitle", "time": 14812.87, "timestamp": "04:06:52", "text": "たぶん、私は自分の州をあまり望んでいません"}, {"type": "subtitle", "time": 14814.229, "timestamp": "04:06:54", "text": "観客。つまり、私はそれがもっと好きだということです"}, {"type": "subtitle", "time": 14816.349, "timestamp": "04:06:56", "text": "ほら、探しているみたいに"}, {"type": "subtitle", "time": 14818.87, "timestamp": "04:06:58", "text": "理想的な観客。むしろ私は"}]
[{"type": "subtitle", "time": 181.83, "timestamp": "00:03:01", "text": "わかった。私がここから抜け出したら、"}, {"type": "subtitle", "time": 183.309, "timestamp": "00:03:03", "text": "できる"}, {"type": "subtitle", "time": 207.67000000000002, "timestamp": "00:03:27", "text": "やあ、ソウルズ。調子はどう？ああ、一般の人々。"}, {"type": "subtitle", "time": 211.27, "timestamp": "00:03:31", "text": "ジョー、私はそれを公表したわ。さあ行こう。"}, {"type": "subtitle", "time": 215.19, "timestamp": "00:03:35", "text": "しかし、たとえそれを公表したとしても、"}, {"type": "subtitle", "time": 218.47, "timestamp": "00:03:38", "text": "なぜ一緒に参加できないのですか？"}, {"type": "subtitle", "time": 220.47, "timestamp": "00:03:40", "text": "いや、いや、いや、いや、いや。私は作ることができます 私は作ることができます 私は"}, {"type": "subtitle", "time": 222.789, "timestamp": "00:03:42", "text": "マッチメイク。私はマッチングできます。いいえ、それは"}, {"type": "subtitle", "time": 226.309, "timestamp": "00:03:46", "text": "しかし、それは他のプレイヤーとの話だ。"}, {"type": "subtitle", "time": 228.589, "timestamp": "00:03:48", "text": "わかった。わかった。見てみましょう。"}, {"type": "subtitle", "time": 230.99, "timestamp": "00:03:50", "text": "えっと、変人。"}, {"type": "subtitle", "time": 234.91, "timestamp": "00:03:54", "text": "えっと、オンラインオプションはどこにあるんですか？"}]
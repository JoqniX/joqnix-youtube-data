[{"type": "subtitle", "time": 487.99, "timestamp": "00:08:07", "text": "サラ。"}, {"type": "subtitle", "time": 492.469, "timestamp": "00:08:12", "text": "その塔。塔ではない。のように"}, {"type": "subtitle", "time": 494.07, "timestamp": "00:08:14", "text": "出会った場所"}, {"type": "subtitle", "time": 497.189, "timestamp": "00:08:17", "text": "医者。わかった。それが私のやっていることです。"}, {"type": "subtitle", "time": 510.23, "timestamp": "00:08:30", "text": "ここはどこ？それは素晴らしいですね。私たちはそうしません"}, {"type": "subtitle", "time": 511.709, "timestamp": "00:08:31", "text": "タワーが必要なのは"}, {"type": "subtitle", "time": 514.389, "timestamp": "00:08:34", "text": "今。医者に行きなさい。あなたが持っているものは何であれ"}, {"type": "subtitle", "time": 516.23, "timestamp": "00:08:36", "text": "完了、本当に彼らをワープに乗せた"}, {"type": "subtitle", "time": 519.11, "timestamp": "00:08:39", "text": "パス。ジェイドと話さなければならない。サラ、彼"}, {"type": "subtitle", "time": 520.7090000000001, "timestamp": "00:08:40", "text": "彼女に彼の研究成果を渡した。彼女はそれを"}, {"type": "subtitle", "time": 524.149, "timestamp": "00:08:44", "text": "カムデン。まあ、彼女は"}, {"type": "subtitle", "time": 526.23, "timestamp": "00:08:46", "text": "カムデンは、リアスの手下たちが"}, {"type": "subtitle", "time": 528.55, "timestamp": "00:08:48", "text": "彼の研究室を見つけた。そこで彼はそれを水浸しにした"}, {"type": "subtitle", "time": 530.31, "timestamp": "00:08:50", "text": "噛みつき、バリケードで"}, {"type": "subtitle", "time": 532.389, "timestamp": "00:08:52", "text": "真ん中。彼は今、身動きが取れない状態だ。それから"}, {"type": "subtitle", "time": 533.91, "timestamp": "00:08:53", "text": "接続に失敗しました。私たちはできなかった"}, {"type": "subtitle", "time": 537.19, "timestamp": "00:08:57", "text": "それ以来、彼を育ててきた。私は彼女を追いかける。"}, {"type": "subtitle", "time": 539.19, "timestamp": "00:08:59", "text": "彼女はどうやって入るつもりなの？町のあの辺り"}]
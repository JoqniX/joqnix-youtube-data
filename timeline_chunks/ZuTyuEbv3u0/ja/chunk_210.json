[{"type": "subtitle", "time": 12612.95, "timestamp": "03:30:12", "text": "ええ、そうですね。うん。"}, {"type": "subtitle", "time": 12615.99, "timestamp": "03:30:15", "text": "わかった。わかった。私は今、行き詰まっています。私はまさに"}, {"type": "subtitle", "time": 12618.71, "timestamp": "03:30:18", "text": "何か質問してください。大丈夫。持って行ってください"}, {"type": "subtitle", "time": 12621.03, "timestamp": "03:30:21", "text": "時間。"}, {"type": "subtitle", "time": 12623.83, "timestamp": "03:30:23", "text": "そうそう。うん。つまり、えっと、"}, {"type": "subtitle", "time": 12626.229, "timestamp": "03:30:26", "text": "日本に来た後は"}, {"type": "subtitle", "time": 12630.229, "timestamp": "03:30:30", "text": "まるで大々的な宣伝期間のようだ。私は思う"}, {"type": "subtitle", "time": 12632.55, "timestamp": "03:30:32", "text": "活動休止はしたくない。私はただ"}, {"type": "subtitle", "time": 12635.269, "timestamp": "03:30:35", "text": "戻りたい"}, {"type": "subtitle", "time": 12638.15, "timestamp": "03:30:38", "text": "すぐにストリーミング配信するか、Vlogをアップロードするだけ。"}, {"type": "subtitle", "time": 12639.99, "timestamp": "03:30:39", "text": "もしくは何かしてチャンネルを存続させる"}, {"type": "subtitle", "time": 12643.429, "timestamp": "03:30:43", "text": "今はマルチセッションだからね"}, {"type": "subtitle", "time": 12645.51, "timestamp": "03:30:45", "text": "そして私は、それが"}, {"type": "subtitle", "time": 12649.67, "timestamp": "03:30:49", "text": "サクラの時もそうだったよね？うん。彼女"}, {"type": "subtitle", "time": 12651.83, "timestamp": "03:30:51", "text": "文字通り、全体を挽回しなければならない"}, {"type": "subtitle", "time": 12653.91, "timestamp": "03:30:53", "text": "また戻ってきました。"}, {"type": "subtitle", "time": 12657.03, "timestamp": "03:30:57", "text": "ええ、それは残念ですね。ええ、それは"}]
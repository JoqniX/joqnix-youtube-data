[{"type": "subtitle", "time": 12360.309, "timestamp": "03:26:00", "text": "唯一の違いは、私は自分が"}, {"type": "subtitle", "time": 12362.55, "timestamp": "03:26:02", "text": "より良い英語で検索する"}, {"type": "subtitle", "time": 12371.95, "timestamp": "03:26:11", "text": "はい。あなたもおやすみなさい。"}, {"type": "subtitle", "time": 12374.87, "timestamp": "03:26:14", "text": "こんにちは。おやすみ、ティア。"}, {"type": "subtitle", "time": 12378.469, "timestamp": "03:26:18", "text": "ああ、ティア。よし、ティアは寝る時間だ。"}, {"type": "subtitle", "time": 12381.11, "timestamp": "03:26:21", "text": "おやすみ。ドロップしてくれてありがとう"}, {"type": "subtitle", "time": 12383.99, "timestamp": "03:26:23", "text": "お立ち寄りいただきありがとうございます。"}, {"type": "subtitle", "time": 12385.67, "timestamp": "03:26:25", "text": "うん、そうだね。私は感じます 私は感じます"}, {"type": "subtitle", "time": 12387.67, "timestamp": "03:26:27", "text": "最終試験を終える頃にはおそらく"}, {"type": "subtitle", "time": 12390.469, "timestamp": "03:26:30", "text": "私はマララム語を話せるかもしれません。おお、"}, {"type": "subtitle", "time": 12391.309, "timestamp": "03:26:31", "text": "さあ"}, {"type": "subtitle", "time": 12394.309, "timestamp": "03:26:34", "text": "行く。ええ、だって私の周りの人たちは"}, {"type": "subtitle", "time": 12395.91, "timestamp": "03:26:35", "text": "マララムで満たされた国のような"}, {"type": "subtitle", "time": 12402.95, "timestamp": "03:26:42", "text": "ああ、それはいいですね。今でも私は好きです"}, {"type": "subtitle", "time": 12405.8, "timestamp": "03:26:45", "text": "結局、その男性と会うことになった。"}, {"type": "subtitle", "time": 12412.15, "timestamp": "03:26:52", "text": "ニース。ニース。"}, {"type": "subtitle", "time": 12414.87, "timestamp": "03:26:54", "text": "ええ、そう思います。つまり、私ではなく"}, {"type": "subtitle", "time": 12416.15, "timestamp": "03:26:56", "text": "複数のことを学ぶのが好きで構わない"}]
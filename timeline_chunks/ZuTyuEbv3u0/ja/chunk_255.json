[{"type": "subtitle", "time": 15303.429, "timestamp": "04:15:03", "text": "JCというタミル語圏のVtuberを知っていますか？"}, {"type": "subtitle", "time": 15306.63, "timestamp": "04:15:06", "text": "よし。うーん、わからない。"}, {"type": "subtitle", "time": 15309.429, "timestamp": "04:15:09", "text": "えっと、彼はVTuberではなく、PNGのTuberです。彼は"}, {"type": "subtitle", "time": 15313.349, "timestamp": "04:15:13", "text": "タミル・ナードゥ州出身で、彼と会ったと思う"}, {"type": "subtitle", "time": 15316.389, "timestamp": "04:15:16", "text": "彼がPNGチューブか何かをしていた時のこと。"}, {"type": "subtitle", "time": 15318.79, "timestamp": "04:15:18", "text": "彼をVTuberリストに追加したのを覚えている"}, {"type": "subtitle", "time": 15321.269, "timestamp": "04:15:21", "text": "そして、ずっと昔のこと。"}, {"type": "subtitle", "time": 15323.67, "timestamp": "04:15:23", "text": "それで、連絡してみようと思ったんです"}, {"type": "subtitle", "time": 15326.07, "timestamp": "04:15:26", "text": "そして私たちは話したりした。そこで私はこう思った。"}, {"type": "subtitle", "time": 15328.469, "timestamp": "04:15:28", "text": "ええ、彼を連れて行きます。"}, {"type": "subtitle", "time": 15330.229, "timestamp": "04:15:30", "text": "どうやら彼はカナダかどこかにいるらしい"}, {"type": "subtitle", "time": 15332.95, "timestamp": "04:15:32", "text": "そしてそれは動き出すだろう。だから私は"}, {"type": "subtitle", "time": 15335.429, "timestamp": "04:15:35", "text": "だから私はこう思った、そう、あなたが"}, {"type": "subtitle", "time": 15337.59, "timestamp": "04:15:37", "text": "忙しい前に移動してください、PC を手に入れます"}, {"type": "subtitle", "time": 15339.51, "timestamp": "04:15:39", "text": "ストリームで君と遊んで、"}, {"type": "subtitle", "time": 15342.71, "timestamp": "04:15:42", "text": "私たちはこうやって一緒に時間を過ごして近況を報告し合っています"}, {"type": "subtitle", "time": 15351.51, "timestamp": "04:15:51", "text": "こんにちは、DSTさん、今日はありがとうございました。持っている"}, {"type": "subtitle", "time": 15353.269, "timestamp": "04:15:53", "text": "楽しい。"}, {"type": "subtitle", "time": 15357.11, "timestamp": "04:15:57", "text": "わかった。こんにちは。みなさん、こんにちは。さよならを"}, {"type": "subtitle", "time": 15359.349, "timestamp": "04:15:59", "text": "DGSTG。そして、忘れないでください"}]
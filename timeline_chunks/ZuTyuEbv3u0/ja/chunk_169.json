[{"type": "subtitle", "time": 10141.99, "timestamp": "02:49:01", "text": "動きに関しては制限できます"}, {"type": "subtitle", "time": 10144.23, "timestamp": "02:49:04", "text": "そして時間が経つにつれて、十分な量と"}, {"type": "subtitle", "time": 10146.469, "timestamp": "02:49:06", "text": "そうすれば同じリガーのところへ行ける"}, {"type": "subtitle", "time": 10149.269, "timestamp": "02:49:09", "text": "そして、動きをアップグレードして、"}, {"type": "subtitle", "time": 10151.11, "timestamp": "02:49:11", "text": "すべてまたはアニメーションを追加するまたは"}, {"type": "subtitle", "time": 10153.91, "timestamp": "02:49:13", "text": "何か。私は気づきました。"}, {"type": "subtitle", "time": 10156.79, "timestamp": "02:49:16", "text": "どうぞ。どうぞ。流体流動性"}, {"type": "subtitle", "time": 10161.269, "timestamp": "02:49:21", "text": "既存のものですよね？"}, {"type": "subtitle", "time": 10163.75, "timestamp": "02:49:23", "text": "これです。これはテスト用のものです。"}, {"type": "subtitle", "time": 10166.469, "timestamp": "02:49:26", "text": "さて、新しいものは、"}, {"type": "subtitle", "time": 10167.71, "timestamp": "02:49:27", "text": "正式"}, {"type": "subtitle", "time": 10170.95, "timestamp": "02:49:30", "text": "1つ。私はデビューしたことがない。信じられますか？"}, {"type": "subtitle", "time": 10173.75, "timestamp": "02:49:33", "text": "それ？彼らはただ私がストリーミングしているだけです"}, {"type": "subtitle", "time": 10177.349, "timestamp": "02:49:37", "text": "デビューせずに。ミアもそれを初披露した。"}, {"type": "subtitle", "time": 10180.63, "timestamp": "02:49:40", "text": "さくらもそれを初披露した。聞いて、私は愛してる"}, {"type": "subtitle", "time": 10182.469, "timestamp": "02:49:42", "text": "あなた。わかった。"}, {"type": "subtitle", "time": 10184.309, "timestamp": "02:49:44", "text": "え、デビューしたの？待って、君は"}, {"type": "subtitle", "time": 10187.51, "timestamp": "02:49:47", "text": "デビューですよね？いや、違う。私はただ"}, {"type": "subtitle", "time": 10189.03, "timestamp": "02:49:49", "text": "突然ストリーミングが停止しました"}, {"type": "subtitle", "time": 10194.269, "timestamp": "02:49:54", "text": "さあ行こう。いいえ"}, {"type": "subtitle", "time": 10196.87, "timestamp": "02:49:56", "text": "一つは古いもののほとんどで、"}, {"type": "subtitle", "time": 10198.87, "timestamp": "02:49:58", "text": "アーカイブに保存したのは、"}]
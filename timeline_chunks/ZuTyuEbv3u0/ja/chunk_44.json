[{"type": "subtitle", "time": 2644.71, "timestamp": "00:44:04", "text": "私はいつも眠い。なぜ私は眠いのだろう"}, {"type": "subtitle", "time": 2650.87, "timestamp": "00:44:10", "text": "よし、行こう。忘れた。私はします"}, {"type": "subtitle", "time": 2653.109, "timestamp": "00:44:13", "text": "このゲームをまるでヴァラーのようにプレイしよう"}, {"type": "subtitle", "time": 2656.15, "timestamp": "00:44:16", "text": "今。わかった。こんにちは。"}, {"type": "subtitle", "time": 2659.51, "timestamp": "00:44:19", "text": "それはあなたの、あなたが言ったことです。それは"}, {"type": "subtitle", "time": 2660.43, "timestamp": "00:44:20", "text": "あなた"}, {"type": "subtitle", "time": 2663.99, "timestamp": "00:44:23", "text": "欲しい。わかった。"}, {"type": "subtitle", "time": 2678.15, "timestamp": "00:44:38", "text": "わからない。どの作品ですか？彼らはどこにいるのか"}, {"type": "subtitle", "time": 2679.99, "timestamp": "00:44:39", "text": "行く？"}, {"type": "subtitle", "time": 2682.15, "timestamp": "00:44:42", "text": "まさにその通りです。私はただランダムに作っているだけです"}, {"type": "subtitle", "time": 2686.79, "timestamp": "00:44:46", "text": "動く。大丈夫。大丈夫です。"}, {"type": "subtitle", "time": 2688.829, "timestamp": "00:44:48", "text": "私たちは皆学びます、あなたも"}, {"type": "subtitle", "time": 2694.15, "timestamp": "00:44:54", "text": "ゆっくりとではあるが、私たちは知っている。私たちは学ぶ。"}]
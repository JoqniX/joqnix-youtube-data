[{"type": "subtitle", "time": 2940.549, "timestamp": "00:49:00", "text": "今はそうなの？"}, {"type": "subtitle", "time": 2942.829, "timestamp": "00:49:02", "text": "そろそろ行かなきゃ"}, {"type": "subtitle", "time": 2945.99, "timestamp": "00:49:05", "text": "ここ。でも、もし私がそこに行ったら、"}, {"type": "subtitle", "time": 2948.71, "timestamp": "00:49:08", "text": "あなたは私を殺すつもりですか。"}, {"type": "subtitle", "time": 2951.23, "timestamp": "00:49:11", "text": "そろそろ行かなきゃ。"}, {"type": "subtitle", "time": 2967.549, "timestamp": "00:49:27", "text": "私は犠牲にすることができる"}, {"type": "subtitle", "time": 2972.069, "timestamp": "00:49:32", "text": "これ。しかし、これは大きな賭けだ。"}, {"type": "subtitle", "time": 2974.069, "timestamp": "00:49:34", "text": "ああ、何か考えていることがあるんですね。待って、"}, {"type": "subtitle", "time": 2976.829, "timestamp": "00:49:36", "text": "何か計画してるの？"}, {"type": "subtitle", "time": 2981.27, "timestamp": "00:49:41", "text": "ええ、私は頑張っています。"}, {"type": "subtitle", "time": 2985.43, "timestamp": "00:49:45", "text": "今後の計画はどうなっていますか？"}, {"type": "subtitle", "time": 2987.829, "timestamp": "00:49:47", "text": "それは私にはできないんです。私はしません"}, {"type": "subtitle", "time": 2989.99, "timestamp": "00:49:49", "text": "高校に関するあらゆることについてチャットしましょう。 「ああ、"}, {"type": "subtitle", "time": 2993.19, "timestamp": "00:49:53", "text": "ああ、あれを見てください。私は耐えられる。"}, {"type": "subtitle", "time": 2999.43, "timestamp": "00:49:59", "text": "「あ、見て。光ってる。私は行く」って感じが好きです。"}]
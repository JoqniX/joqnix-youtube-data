[{"type": "subtitle", "time": 2582.47, "timestamp": "00:43:02", "text": "大丈夫。ちょっと待ってください。"}, {"type": "subtitle", "time": 2584.829, "timestamp": "00:43:04", "text": "私は"}, {"type": "subtitle", "time": 2588.91, "timestamp": "00:43:08", "text": "同じ？見ることができるように、そうさせてください"}, {"type": "subtitle", "time": 2592.87, "timestamp": "00:43:12", "text": "チャット機能も気に入っています。"}, {"type": "subtitle", "time": 2598.39, "timestamp": "00:43:18", "text": "ここ。宝箱が何度も出現する。それは"}, {"type": "subtitle", "time": 2607.829, "timestamp": "00:43:27", "text": "悪い。はい、戻ってきました。つまり、私は"}, {"type": "subtitle", "time": 2610.95, "timestamp": "00:43:30", "text": "ごめん。私はただスキナの調整をしていただけです"}, {"type": "subtitle", "time": 2629.829, "timestamp": "00:43:49", "text": "ああ、私たちは本当にひどい。さあ行こう。"}]
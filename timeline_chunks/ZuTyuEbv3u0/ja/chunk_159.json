[{"type": "subtitle", "time": 9542.23, "timestamp": "02:39:02", "text": "はい。そして君は、私たちが"}, {"type": "subtitle", "time": 9545.429, "timestamp": "02:39:05", "text": "私とあなた、そして私とマックスは"}, {"type": "subtitle", "time": 9547.11, "timestamp": "02:39:07", "text": "座って話している"}, {"type": "subtitle", "time": 9549.03, "timestamp": "02:39:09", "text": "いろいろなものがあって、私たちは"}, {"type": "subtitle", "time": 9556.95, "timestamp": "02:39:16", "text": "ああ、本当に古き良き時代だった。古き良き時代。"}, {"type": "subtitle", "time": 9558.71, "timestamp": "02:39:18", "text": "うん。"}, {"type": "subtitle", "time": 9562.95, "timestamp": "02:39:22", "text": "私たち自身のものに集中する一部の人々"}, {"type": "subtitle", "time": 9566.87, "timestamp": "02:39:26", "text": "学業に進む者もいれば、就職する者もいる。 Mでもあなたは"}, {"type": "subtitle", "time": 9569.27, "timestamp": "02:39:29", "text": "良いことって知ってる？"}, {"type": "subtitle", "time": 9571.27, "timestamp": "02:39:31", "text": "人々はまだ自由のように自由のように"}, {"type": "subtitle", "time": 9573.429, "timestamp": "02:39:33", "text": "十分、またはまだオンラインで来るのが好きです"}, {"type": "subtitle", "time": 9581.75, "timestamp": "02:39:41", "text": "ご存知のように"}, {"type": "subtitle", "time": 9584.63, "timestamp": "02:39:44", "text": "ミアは今自分のことをやっている"}, {"type": "subtitle", "time": 9587.99, "timestamp": "02:39:47", "text": "執筆とか色々やってるの？"}, {"type": "subtitle", "time": 9589.95, "timestamp": "02:39:49", "text": "と話している"}, {"type": "subtitle", "time": 9593.83, "timestamp": "02:39:53", "text": "いいですね。"}, {"type": "subtitle", "time": 9596.309, "timestamp": "02:39:56", "text": "今は本当にいい感じだ。みんなが"}, {"type": "subtitle", "time": 9599.75, "timestamp": "02:39:59", "text": "自分のもの。ニース。"}]
[{"type": "subtitle", "time": 12783.11, "timestamp": "03:33:03", "text": "時々、ご飯だけだと思う"}, {"type": "subtitle", "time": 12787.269, "timestamp": "03:33:07", "text": "今日RXRを服用したんだけど、RXRって知ってるよね？"}, {"type": "subtitle", "time": 12790.15, "timestamp": "03:33:10", "text": "ええ、わかっています。知っている。彼はそこに行ったことがある"}, {"type": "subtitle", "time": 12792.95, "timestamp": "03:33:12", "text": "昔みたいだよね？"}, {"type": "subtitle", "time": 12795.51, "timestamp": "03:33:15", "text": "うん。それで、RXelはそれについて言っていた"}, {"type": "subtitle", "time": 12798.55, "timestamp": "03:33:18", "text": "例えば、私たちはとても慣れているので"}, {"type": "subtitle", "time": 12800.95, "timestamp": "03:33:20", "text": "ご飯を食べてるよね？だから、もし私たちが食べるなら"}, {"type": "subtitle", "time": 12803.59, "timestamp": "03:33:23", "text": "何か別のもの、それは"}, {"type": "subtitle", "time": 12806.469, "timestamp": "03:33:26", "text": "食事全体。そう、君"}, {"type": "subtitle", "time": 12809.99, "timestamp": "03:33:29", "text": "きちんと食事を摂らなかった。お米が必要です"}, {"type": "subtitle", "time": 12811.83, "timestamp": "03:33:31", "text": "お腹いっぱいにするか、何か"}, {"type": "subtitle", "time": 12814.95, "timestamp": "03:33:34", "text": "そうですよね？私たちにもその問題がありますか？"}, {"type": "subtitle", "time": 12821.429, "timestamp": "03:33:41", "text": "えっと、ご飯だけがお腹を満たしてくれるような感じ。"}, {"type": "subtitle", "time": 12823.91, "timestamp": "03:33:43", "text": "そう、米だけがあれば"}, {"type": "subtitle", "time": 12826.389, "timestamp": "03:33:46", "text": "満腹感を感じさせてくれる。"}, {"type": "subtitle", "time": 12828.309, "timestamp": "03:33:48", "text": "あなたはよく食べたか何かしたんですね。"}, {"type": "subtitle", "time": 12830.309, "timestamp": "03:33:50", "text": "わかった。まあ、それはある意味"}, {"type": "subtitle", "time": 12833.51, "timestamp": "03:33:53", "text": "バーやチャパティを食べるのは正しいです"}, {"type": "subtitle", "time": 12835.429, "timestamp": "03:33:55", "text": "満腹感があるような感じ"}, {"type": "subtitle", "time": 12839.75, "timestamp": "03:33:59", "text": "おそらく2時間くらいでしょう。うん。"}]
[{"type": "subtitle", "time": 3600.75, "timestamp": "01:00:00", "text": "そしてそして"}, {"type": "subtitle", "time": 3603.67, "timestamp": "01:00:03", "text": "えっと、また戻ってくる予定はありますか？"}, {"type": "subtitle", "time": 3606.309, "timestamp": "01:00:06", "text": "ストリーミング配信？いつ戻ってきますか？もし"}, {"type": "subtitle", "time": 3607.99, "timestamp": "01:00:07", "text": "何かお知らせやお知らせはありますか？"}, {"type": "subtitle", "time": 3611.109, "timestamp": "01:00:11", "text": "あなたが作りたいものは、"}, {"type": "subtitle", "time": 3618.51, "timestamp": "01:00:18", "text": "ということで、計画は"}, {"type": "subtitle", "time": 3621.51, "timestamp": "01:00:21", "text": "戻ってストリーミングする。"}, {"type": "subtitle", "time": 3624.39, "timestamp": "01:00:24", "text": "Discordにメッセージを投稿しました"}, {"type": "subtitle", "time": 3627.109, "timestamp": "01:00:27", "text": "私はストリーミング配信するつもりだと言った"}, {"type": "subtitle", "time": 3631.63, "timestamp": "01:00:31", "text": "ええと、もうすぐです。それは1ヶ月前のことだ。"}, {"type": "subtitle", "time": 3635.349, "timestamp": "01:00:35", "text": "だから、私はただ、"}, {"type": "subtitle", "time": 3639.109, "timestamp": "01:00:39", "text": "戻ってきてくれれば時間を見つけられるだろう"}, {"type": "subtitle", "time": 3642.95, "timestamp": "01:00:42", "text": "ストリーミングを開始する。やりたいのですが、"}, {"type": "subtitle", "time": 3643.789, "timestamp": "01:00:43", "text": "その"}, {"type": "subtitle", "time": 3647.71, "timestamp": "01:00:47", "text": "私にとっては本当に本当に本当に大変でした。のように"}, {"type": "subtitle", "time": 3651.109, "timestamp": "01:00:51", "text": "今日はうっかり忘れてしまう"}, {"type": "subtitle", "time": 3653.829, "timestamp": "01:00:53", "text": "君も知っているだろうけど、私は君と一緒にここにいなければならなかったんだ"}, {"type": "subtitle", "time": 3656.789, "timestamp": "01:00:56", "text": "2日間が過ぎたが、"}, {"type": "subtitle", "time": 3659.589, "timestamp": "01:00:59", "text": "まるで私の携帯電話に2つの異なるリマインダーが表示されているかのようだ"}]
[{"type": "subtitle", "time": 7983.589, "timestamp": "02:13:03", "text": "ジョーのように働き者だ。いいえ、私はハードではありません"}, {"type": "subtitle", "time": 7985.95, "timestamp": "02:13:05", "text": "ワーカー。私は怠け者です"}, {"type": "subtitle", "time": 7988.83, "timestamp": "02:13:08", "text": "バックアー。ほとんど仕事がない。あなたが"}, {"type": "subtitle", "time": 7992.109, "timestamp": "02:13:12", "text": "平均？みんなと話しましょう。ああ、そうしよう"}, {"type": "subtitle", "time": 7995.229, "timestamp": "02:13:15", "text": "短時間で行く"}, {"type": "subtitle", "time": 8016.069, "timestamp": "02:13:36", "text": "はい、到着しました。戻ってきました。戻ってきました。"}, {"type": "subtitle", "time": 8019.79, "timestamp": "02:13:39", "text": "休暇で戻ってきました。ちょっと休憩。"}, {"type": "subtitle", "time": 8025.709, "timestamp": "02:13:45", "text": "えーと、1つ"}]
[{"type": "subtitle", "time": 9302.79, "timestamp": "02:35:02", "text": "ルームメイト4人と暮らしています。"}, {"type": "subtitle", "time": 9306.23, "timestamp": "02:35:06", "text": "ああ、つまり、バンカーみたいなものですね"}, {"type": "subtitle", "time": 9309.75, "timestamp": "02:35:09", "text": "ベッドとか、そういうもの。ふむ。完全に似ているわけではない"}, {"type": "subtitle", "time": 9312.71, "timestamp": "02:35:12", "text": "二段ベッド。ああ、まるで違う違う"}, {"type": "subtitle", "time": 9315.03, "timestamp": "02:35:15", "text": "部屋。いや、いや、いや。それはまるで"}, {"type": "subtitle", "time": 9317.51, "timestamp": "02:35:17", "text": "キッチン、1つは、あー、キッチンと呼ぶことすらできない"}, {"type": "subtitle", "time": 9319.67, "timestamp": "02:35:19", "text": "ホールはとても小さいので"}, {"type": "subtitle", "time": 9322.79, "timestamp": "02:35:22", "text": "くそっ。そして、それから寝室。"}, {"type": "subtitle", "time": 9324.87, "timestamp": "02:35:24", "text": "おお、"}, {"type": "subtitle", "time": 9326.95, "timestamp": "02:35:26", "text": "そう、文字通り4つくらいだよ。"}, {"type": "subtitle", "time": 9330.15, "timestamp": "02:35:30", "text": "部屋に閉じ込められた5人。"}, {"type": "subtitle", "time": 9333.11, "timestamp": "02:35:33", "text": "えっと"}, {"type": "subtitle", "time": 9334.429, "timestamp": "02:35:34", "text": "うん、君"}, {"type": "subtitle", "time": 9341.03, "timestamp": "02:35:41", "text": "ほら、ルーン中に実際にやったんだよ"}, {"type": "subtitle", "time": 9343.67, "timestamp": "02:35:43", "text": "出生時刻。"}, {"type": "subtitle", "time": 9347.27, "timestamp": "02:35:47", "text": "ああ、あの時の君だよ。ああ、あの時のことね。"}, {"type": "subtitle", "time": 9349.429, "timestamp": "02:35:49", "text": "ああ、そこ"}, {"type": "subtitle", "time": 9351.75, "timestamp": "02:35:51", "text": "私は文字通り故郷へ行った。私"}, {"type": "subtitle", "time": 9353.91, "timestamp": "02:35:53", "text": "文字通り大学を休学した"}, {"type": "subtitle", "time": 9355.91, "timestamp": "02:35:55", "text": "自分の休暇は、"}, {"type": "subtitle", "time": 9357.67, "timestamp": "02:35:57", "text": "コラボレーション。"}, {"type": "subtitle", "time": 9359.87, "timestamp": "02:35:59", "text": "何てことだ。"}]
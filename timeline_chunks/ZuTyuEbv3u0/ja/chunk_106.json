[{"type": "subtitle", "time": 6367.629, "timestamp": "01:46:07", "text": "[音楽]"}, {"type": "subtitle", "time": 6370.07, "timestamp": "01:46:10", "text": "もの。私は彼を混乱させているだけだ。私は"}, {"type": "subtitle", "time": 6372.99, "timestamp": "01:46:12", "text": "ひどい。え、何？あなたではない"}, {"type": "subtitle", "time": 6374.32, "timestamp": "01:46:14", "text": "ひどい。"}, {"type": "subtitle", "time": 6375.629, "timestamp": "01:46:15", "text": "[音楽]"}, {"type": "subtitle", "time": 6383.96, "timestamp": "01:46:23", "text": "ああ、翻訳は"}, {"type": "subtitle", "time": 6394.43, "timestamp": "01:46:34", "text": "行く"}, {"type": "subtitle", "time": 6399.83, "timestamp": "01:46:39", "text": "あぁ、えーと、えーとは何ですか？"}, {"type": "subtitle", "time": 6405.55, "timestamp": "01:46:45", "text": "どこで"}, {"type": "subtitle", "time": 6412.4, "timestamp": "01:46:52", "text": "音楽は本当に"}, {"type": "subtitle", "time": 6419.83, "timestamp": "01:46:59", "text": "良い。何てことだ。私は何が"}]
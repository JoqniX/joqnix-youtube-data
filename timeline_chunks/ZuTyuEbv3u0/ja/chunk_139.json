[{"type": "subtitle", "time": 8341.19, "timestamp": "02:19:01", "text": "うん、本当だよ、本当だよ、本当だよ。うん、君も"}, {"type": "subtitle", "time": 8343.83, "timestamp": "02:19:03", "text": "両親は喜んでいます、彼らは準備ができています"}, {"type": "subtitle", "time": 8347.83, "timestamp": "02:19:07", "text": "私を好きな場所に送ってください。えっと、でも"}, {"type": "subtitle", "time": 8349.75, "timestamp": "02:19:09", "text": "一番大切なのは、私は何も望んでいないということです"}, {"type": "subtitle", "time": 8352.469, "timestamp": "02:19:12", "text": "彼らは送るためにどんな努力をしても"}, {"type": "subtitle", "time": 8354.87, "timestamp": "02:19:14", "text": "私にとってそれは大金なので知らない"}, {"type": "subtitle", "time": 8357.91, "timestamp": "02:19:17", "text": "お子さんを別の場所に送ってください"}, {"type": "subtitle", "time": 8359.509, "timestamp": "02:19:19", "text": "国とその他多くのこと"}, {"type": "subtitle", "time": 8363.91, "timestamp": "02:19:23", "text": "そう、それに私は一人っ子だからね。おお"}, {"type": "subtitle", "time": 8367.83, "timestamp": "02:19:27", "text": "ああ、俺はここにいるよ。"}, {"type": "subtitle", "time": 8377.75, "timestamp": "02:19:37", "text": "主君のために国を出る。"}, {"type": "subtitle", "time": 8382.309, "timestamp": "02:19:42", "text": "あなたがすべき。良いでしょう。"}, {"type": "subtitle", "time": 8386.03, "timestamp": "02:19:46", "text": "どの国に行きたいですか？"}, {"type": "subtitle", "time": 8389.67, "timestamp": "02:19:49", "text": "あなたが一番行きたい国はどこですか？"}, {"type": "subtitle", "time": 8392.469, "timestamp": "02:19:52", "text": "おそらくオーストラリアか"}, {"type": "subtitle", "time": 8393.87, "timestamp": "02:19:53", "text": "シンガポールまたは"}, {"type": "subtitle", "time": 8396.87, "timestamp": "02:19:56", "text": "マレーシア。そして最後の選択肢は"}, {"type": "subtitle", "time": 8399.11, "timestamp": "02:19:59", "text": "私たち。"}]
[{"type": "subtitle", "time": 10680.87, "timestamp": "02:58:00", "text": "えっと、最後に見たアニメはデビルメイクライです"}, {"type": "subtitle", "time": 10688.95, "timestamp": "02:58:08", "text": "デビルメイクライのアニメがある。"}, {"type": "subtitle", "time": 10691.309, "timestamp": "02:58:11", "text": "つまり、2つくらい"}, {"type": "subtitle", "time": 10702.95, "timestamp": "02:58:22", "text": "ああ、それ見てみたい。私は"}, {"type": "subtitle", "time": 10705.03, "timestamp": "02:58:25", "text": "あのレースアニメを見てるよ。忘れた"}, {"type": "subtitle", "time": 10712.23, "timestamp": "02:58:32", "text": "イニシャル。ああ、イニシャルDの続編か。"}, {"type": "subtitle", "time": 10715.75, "timestamp": "02:58:35", "text": "最近発売されたものです。忘れた。"}, {"type": "subtitle", "time": 10722.89, "timestamp": "02:58:42", "text": "声とかそういうもの。"}, {"type": "chat", "time": 10724.907, "timestamp": "02:58:44", "author": "@RPGfanatic-i3z", "avatar": "https://yt4.ggpht.com/F9kA73IKR7TCeh1WUg7fNOkjcUJ6lPk8I6j69xenF_vJcjZ4GCnCIeYo88hJF8jUU3OAOsYG=s64-c-k-c0x00ffffff-no-rj", "message": "what's up Calx and Joq"}, {"type": "subtitle", "time": 10725.11, "timestamp": "02:58:45", "text": "[音楽]"}, {"type": "subtitle", "time": 10727.91, "timestamp": "02:58:47", "text": "うん、それは楽しいね。それは素敵なアニメです"}, {"type": "subtitle", "time": 10730.349, "timestamp": "02:58:50", "text": "そして英雄的な行為があり、"}, {"type": "subtitle", "time": 10737.19, "timestamp": "02:58:57", "text": "すべて。たくさんのゲーム敵。うん。"}]
[{"type": "subtitle", "time": 5702.91, "timestamp": "01:35:02", "text": "字面上，你称之为什么？"}, {"type": "subtitle", "time": 5704.83, "timestamp": "01:35:04", "text": "它？我是否曾是"}, {"type": "subtitle", "time": 5707.35, "timestamp": "01:35:07", "text": "现在已经被操纵了吗？开始索具安装"}, {"type": "subtitle", "time": 5710.39, "timestamp": "01:35:10", "text": "现在正在处理中。但我一直在作弊"}, {"type": "subtitle", "time": 5714.91, "timestamp": "01:35:14", "text": "国家和一切。所以，"}, {"type": "subtitle", "time": 5717.55, "timestamp": "01:35:17", "text": "好的，当然可以。当然。但"}, {"type": "subtitle", "time": 5721.35, "timestamp": "01:35:21", "text": "是的。是的。不过我还是很担心。呃，我"}, {"type": "subtitle", "time": 5723.75, "timestamp": "01:35:23", "text": "我看到了她提到的那条推文。"}, {"type": "subtitle", "time": 5726.149, "timestamp": "01:35:26", "text": "她仍将继续服用"}, {"type": "subtitle", "time": 5729.51, "timestamp": "01:35:29", "text": "个人独立呃个人请求"}, {"type": "subtitle", "time": 5731.91, "timestamp": "01:35:31", "text": "仍然会支持他们等等。"}, {"type": "subtitle", "time": 5734.629, "timestamp": "01:35:34", "text": "但是，是的，她似乎更喜欢……"}, {"type": "subtitle", "time": 5738.27, "timestamp": "01:35:38", "text": "告诉大家跟工作室走。"}, {"type": "subtitle", "time": 5742.07, "timestamp": "01:35:42", "text": "现在。嗯，我当然为此感到高兴。"}, {"type": "subtitle", "time": 5745.07, "timestamp": "01:35:45", "text": "只是我们的管材很贵。"}, {"type": "subtitle", "time": 5747.91, "timestamp": "01:35:47", "text": "昂贵且"}, {"type": "subtitle", "time": 5750.149, "timestamp": "01:35:50", "text": "呃"}, {"type": "subtitle", "time": 5758.57, "timestamp": "01:35:58", "text": "嗯，我"}]
[{"type": "subtitle", "time": 374.87, "timestamp": "00:06:14", "text": "所以，呃，我到底是什么？让我"}, {"type": "subtitle", "time": 386.11, "timestamp": "00:06:26", "text": "我得离开这里，这样我才能到你那里去。"}, {"type": "subtitle", "time": 388.629, "timestamp": "00:06:28", "text": "世界。坚持，稍等。让我去塔楼。"}, {"type": "subtitle", "time": 402.629, "timestamp": "00:06:42", "text": "死。好的。你死了。我摔倒了"}, {"type": "subtitle", "time": 410.55, "timestamp": "00:06:50", "text": "岩石。嘿，我明白了，是的，我明白了"}, {"type": "subtitle", "time": 414.15, "timestamp": "00:06:54", "text": "那个贝壳状的东西。所以，"}, {"type": "subtitle", "time": 416.87, "timestamp": "00:06:56", "text": "我的天哪。所以，等等。如果我得到"}, {"type": "subtitle", "time": 418.909, "timestamp": "00:06:58", "text": "这边是贝壳"}]
[{"type": "subtitle", "time": 12303.55, "timestamp": "03:25:03", "text": "过来打个招呼就好。感谢"}, {"type": "subtitle", "time": 12307.03, "timestamp": "03:25:07", "text": "你。祝你晚安。是的，很好"}, {"type": "subtitle", "time": 12308.95, "timestamp": "03:25:08", "text": "夜晚。"}, {"type": "subtitle", "time": 12311.91, "timestamp": "03:25:11", "text": "你也可以看到终止点。"}, {"type": "subtitle", "time": 12313.269, "timestamp": "03:25:13", "text": "所以，你知道我会如何制作视频。"}, {"type": "subtitle", "time": 12322.63, "timestamp": "03:25:22", "text": "是的。那条警报是什么？有人发出的警报是什么？"}, {"type": "subtitle", "time": 12325.75, "timestamp": "03:25:25", "text": "在Twitch或其他平台上关注我？"}, {"type": "subtitle", "time": 12328.309, "timestamp": "03:25:28", "text": "是的。"}, {"type": "subtitle", "time": 12332.309, "timestamp": "03:25:32", "text": "所以，我喜欢它。该死。你是怎么做到的？"}, {"type": "subtitle", "time": 12335.75, "timestamp": "03:25:35", "text": "大家都以为我是个什么样的人"}, {"type": "subtitle", "time": 12338.07, "timestamp": "03:25:38", "text": "我正在研究这方面的东西，因为我是做科技的。"}, {"type": "chat", "time": 12338.279, "timestamp": "03:25:38", "author": "@AerinViolet", "avatar": "https://yt4.ggpht.com/UKawanVvntNiAwz6RWv6wPk_S8YwApvPcCfLApO-du_RbQRIPGtzJ5FTt1DCNmZFJWc_2vxlqw=s64-c-k-c0x00ffffff-no-rj", "message": "good night to you two too 😴"}, {"type": "subtitle", "time": 12340.309, "timestamp": "03:25:40", "text": "提供支持之类的。但实际上，"}, {"type": "subtitle", "time": 12346.71, "timestamp": "03:25:46", "text": "是的。我的意思是，我的意思是，和……一样"}, {"type": "subtitle", "time": 12349.03, "timestamp": "03:25:49", "text": "我的同学们都觉得我擅长"}, {"type": "subtitle", "time": 12351.67, "timestamp": "03:25:51", "text": "编写代码仅仅是因为我能读懂什么"}, {"type": "subtitle", "time": 12353.19, "timestamp": "03:25:53", "text": "错误信息显示，即使即使它是"}, {"type": "subtitle", "time": 12355.19, "timestamp": "03:25:55", "text": "我很有可能最终会把它清除掉。"}, {"type": "subtitle", "time": 12358.469, "timestamp": "03:25:58", "text": "带着轻佻的语气。"}]
[{"type": "subtitle", "time": 1802.789, "timestamp": "00:30:02", "text": "是的。是的。"}, {"type": "subtitle", "time": 1808.389, "timestamp": "00:30:08", "text": "我记得你当时说过"}, {"type": "subtitle", "time": 1810.789, "timestamp": "00:30:10", "text": "就像你对《Valerant》超级上瘾一样"}, {"type": "subtitle", "time": 1814.95, "timestamp": "00:30:14", "text": "你想彻底卸载它。"}, {"type": "subtitle", "time": 1816.71, "timestamp": "00:30:16", "text": "你知道这种情况发生过很多次了。"}, {"type": "subtitle", "time": 1819.669, "timestamp": "00:30:19", "text": "次数。我们不再谈论这件事了。"}, {"type": "subtitle", "time": 1822.47, "timestamp": "00:30:22", "text": "好吧，我们应该做得更好。我们不"}, {"type": "subtitle", "time": 1824.87, "timestamp": "00:30:24", "text": "说真的，我还是球星。"}, {"type": "subtitle", "time": 1828.47, "timestamp": "00:30:28", "text": "屏幕上显示着，但我就是不玩。"}, {"type": "subtitle", "time": 1830.71, "timestamp": "00:30:30", "text": "它。我一直都很忙。我已经"}, {"type": "subtitle", "time": 1832.789, "timestamp": "00:30:32", "text": "经历了很多，你知道，呃"}, {"type": "subtitle", "time": 1835.149, "timestamp": "00:30:35", "text": "具体的。"}, {"type": "subtitle", "time": 1840.389, "timestamp": "00:30:40", "text": "这附近没有草。只是"}, {"type": "subtitle", "time": 1842.23, "timestamp": "00:30:42", "text": "到处都是混凝土。所以，嗯，是的。"}, {"type": "subtitle", "time": 1843.99, "timestamp": "00:30:43", "text": "我一直在四处走动"}, {"type": "subtitle", "time": 1846.23, "timestamp": "00:30:46", "text": "很多。比如，事实上，昨天我"}, {"type": "subtitle", "time": 1849.59, "timestamp": "00:30:49", "text": "在户外连续待了大约5个小时。喜欢，"}, {"type": "subtitle", "time": 1851.99, "timestamp": "00:30:51", "text": "天气太热了"}, {"type": "subtitle", "time": 1855.59, "timestamp": "00:30:55", "text": "我们当时在外面，我就说，"}, {"type": "subtitle", "time": 1858.549, "timestamp": "00:30:58", "text": "“好吧，这对我来说太热了。就像，"}]
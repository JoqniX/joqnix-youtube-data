[{"type": "subtitle", "time": 13081.51, "timestamp": "03:38:01", "text": "吃晚饭了吗？"}, {"type": "subtitle", "time": 13084.55, "timestamp": "03:38:04", "text": "是的，我做了。我愿意。哦，不错。好的。它是"}, {"type": "subtitle", "time": 13086.309, "timestamp": "03:38:06", "text": "和我的家人一起住在公寓里感觉很好"}, {"type": "subtitle", "time": 13087.99, "timestamp": "03:38:07", "text": "室友。不，我得像吃东西一样把它吃掉。"}, {"type": "subtitle", "time": 13089.17, "timestamp": "03:38:09", "text": "财产。"}, {"type": "subtitle", "time": 13092.07, "timestamp": "03:38:12", "text": "[音乐]"}, {"type": "subtitle", "time": 13098.99, "timestamp": "03:38:18", "text": "现在喜欢添加"}, {"type": "subtitle", "time": 13101.59, "timestamp": "03:38:21", "text": "在你的菜肴里加些鸡蛋，比如……"}, {"type": "subtitle", "time": 13104.07, "timestamp": "03:38:24", "text": "就像早上我有一个一样"}, {"type": "subtitle", "time": 13106.49, "timestamp": "03:38:26", "text": "煎蛋卷或水煮蛋。"}, {"type": "subtitle", "time": 13107.83, "timestamp": "03:38:27", "text": "[音乐]"}, {"type": "subtitle", "time": 13109.99, "timestamp": "03:38:29", "text": "所以即使我喜欢少吃一些"}, {"type": "subtitle", "time": 13112.55, "timestamp": "03:38:32", "text": "目前的食物，比如鸡蛋，就像你知道的那样。"}, {"type": "subtitle", "time": 13119.67, "timestamp": "03:38:39", "text": "哦，感觉就像我被禁止进入我的……"}, {"type": "subtitle", "time": 13122.51, "timestamp": "03:38:42", "text": "节食不会再有太大进展了，因为"}, {"type": "subtitle", "time": 13125.269, "timestamp": "03:38:45", "text": "就像大学已经让我输了一样"}, {"type": "subtitle", "time": 13128.469, "timestamp": "03:38:48", "text": "好重啊。"}, {"type": "subtitle", "time": 13131.349, "timestamp": "03:38:51", "text": "哦，对啊，你在健身吧？不不"}, {"type": "subtitle", "time": 13133.91, "timestamp": "03:38:53", "text": "不不，因为上大学，我就停止了。"}, {"type": "subtitle", "time": 13136.389, "timestamp": "03:38:56", "text": "两个月后。"}, {"type": "subtitle", "time": 13139.99, "timestamp": "03:38:59", "text": "M，所以听我说，在去健身房之前，我从47岁变成了"}]
[{"type": "subtitle", "time": 8102.229, "timestamp": "02:15:02", "text": "正在处理工作。接下来是爵士乐。很高兴"}, {"type": "subtitle", "time": 8104.87, "timestamp": "02:15:04", "text": "大家好。"}, {"type": "subtitle", "time": 8110.83, "timestamp": "02:15:10", "text": "你的"}, {"type": "subtitle", "time": 8115.109, "timestamp": "02:15:15", "text": "车。高清。我很抱歉这样称呼它。"}, {"type": "subtitle", "time": 8118.39, "timestamp": "02:15:18", "text": "即使你改了名字，也需要缴纳DGST。"}, {"type": "subtitle", "time": 8119.629, "timestamp": "02:15:19", "text": "我的意思是，我的意思是，我"}, {"type": "subtitle", "time": 8122.31, "timestamp": "02:15:22", "text": "这意味着你们需要一些时间。"}, {"type": "subtitle", "time": 8126.589, "timestamp": "02:15:26", "text": "习惯它。所以"}, {"type": "subtitle", "time": 8130.149, "timestamp": "02:15:30", "text": "你好吗？已经很久很久了"}, {"type": "subtitle", "time": 8131.669, "timestamp": "02:15:31", "text": "谈过了。"}, {"type": "subtitle", "time": 8133.35, "timestamp": "02:15:33", "text": "是的，已经很久了。"}, {"type": "subtitle", "time": 8135.39, "timestamp": "02:15:35", "text": "自从我们上次谈话之后。"}, {"type": "subtitle", "time": 8139.91, "timestamp": "02:15:39", "text": "是的。是的。我当时真的很高兴"}, {"type": "subtitle", "time": 8142.55, "timestamp": "02:15:42", "text": "我们见面了，也聊了聊。"}, {"type": "subtitle", "time": 8145.83, "timestamp": "02:15:45", "text": "在符文诞生中，阿斯特拉的符文诞生"}, {"type": "subtitle", "time": 8149.75, "timestamp": "02:15:49", "text": "事件。是啊，挺好玩的。"}, {"type": "subtitle", "time": 8151.75, "timestamp": "02:15:51", "text": "是啊，太有趣了，就像认识新朋友一样。"}, {"type": "subtitle", "time": 8153.99, "timestamp": "02:15:53", "text": "人们就像你知道的那样玩耍"}, {"type": "subtitle", "time": 8156.99, "timestamp": "02:15:56", "text": "和他们一起玩我的世界。是的。"}]
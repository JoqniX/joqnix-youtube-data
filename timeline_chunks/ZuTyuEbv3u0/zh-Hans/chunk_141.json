[{"type": "subtitle", "time": 8462.23, "timestamp": "02:21:02", "text": "我在钦奈写的。"}, {"type": "subtitle", "time": 8463.79, "timestamp": "02:21:03", "text": "呃"}, {"type": "subtitle", "time": 8469.309, "timestamp": "02:21:09", "text": "某物。是的，二月份我写了"}, {"type": "subtitle", "time": 8472.389, "timestamp": "02:21:12", "text": "考试。二月和一月我参加了那次考试"}, {"type": "subtitle", "time": 8475.349, "timestamp": "02:21:15", "text": "我超过了你。我当时到底在想什么？"}, {"type": "subtitle", "time": 8478.23, "timestamp": "02:21:18", "text": "实际上，我当时的状态就是这样。等待，"}, {"type": "subtitle", "time": 8481.75, "timestamp": "02:21:21", "text": "等待。你当时离得很近。"}, {"type": "subtitle", "time": 8483.75, "timestamp": "02:21:23", "text": "我的意思是，我的意思是，如果用我的母语中文来说……"}, {"type": "subtitle", "time": 8486.15, "timestamp": "02:21:26", "text": "差不多。"}, {"type": "subtitle", "time": 8492.15, "timestamp": "02:21:32", "text": "等等。呃，请问您知道ABK doai吗？"}, {"type": "subtitle", "time": 8494.83, "timestamp": "02:21:34", "text": "呃，不，抱歉"}, {"type": "subtitle", "time": 8497.83, "timestamp": "02:21:37", "text": "稍等，我这就告诉你目前的情况。"}, {"type": "subtitle", "time": 8501.429, "timestamp": "02:21:41", "text": "地点。那是考试的事儿。它"}, {"type": "subtitle", "time": 8503.63, "timestamp": "02:21:43", "text": "呃，是"}, {"type": "subtitle", "time": 8512.11, "timestamp": "02:21:52", "text": "我觉得我"}, {"type": "subtitle", "time": 8517.19, "timestamp": "02:21:57", "text": "我的意思是，我之后会仔细考虑这件事。"}, {"type": "subtitle", "time": 8519.51, "timestamp": "02:21:59", "text": "你好。你好。我不擅长"}]
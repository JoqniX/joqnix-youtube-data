[{"type": "subtitle", "time": 9542.23, "timestamp": "02:39:02", "text": "是的。你还记得我们在一起的时光吗？"}, {"type": "subtitle", "time": 9545.429, "timestamp": "02:39:05", "text": "三个我，你，还有我和Max就像"}, {"type": "subtitle", "time": 9547.11, "timestamp": "02:39:07", "text": "我们坐下来，开始谈论……"}, {"type": "subtitle", "time": 9549.03, "timestamp": "02:39:09", "text": "东西，然后你就说我们要去"}, {"type": "subtitle", "time": 9556.95, "timestamp": "02:39:16", "text": "是啊，真是美好的旧时光。美好的旧时光。"}, {"type": "subtitle", "time": 9558.71, "timestamp": "02:39:18", "text": "是的。"}, {"type": "subtitle", "time": 9562.95, "timestamp": "02:39:22", "text": "像某些人一样，我们把自己的事情也变成自己的事"}, {"type": "subtitle", "time": 9566.87, "timestamp": "02:39:26", "text": "一部分人继续深造，一部分人则进入工作岗位。 M，但是你"}, {"type": "subtitle", "time": 9569.27, "timestamp": "02:39:29", "text": "我知道一件好事，就像大多数……"}, {"type": "subtitle", "time": 9571.27, "timestamp": "02:39:31", "text": "人们仍然喜欢自由，就像自由一样。"}, {"type": "subtitle", "time": 9573.429, "timestamp": "02:39:33", "text": "足够喜欢或仍然喜欢上网"}, {"type": "subtitle", "time": 9581.75, "timestamp": "02:39:41", "text": "就像你知道的那样"}, {"type": "subtitle", "time": 9584.63, "timestamp": "02:39:44", "text": "米娅现在做他自己的事了，他一直"}, {"type": "subtitle", "time": 9587.99, "timestamp": "02:39:47", "text": "你最近有在写东西什么的吗？"}, {"type": "subtitle", "time": 9589.95, "timestamp": "02:39:49", "text": "与……交谈"}, {"type": "subtitle", "time": 9593.83, "timestamp": "02:39:53", "text": "他们真好。"}, {"type": "subtitle", "time": 9596.309, "timestamp": "02:39:56", "text": "现在真是太好了。每个人都在做他们自己的事"}, {"type": "subtitle", "time": 9599.75, "timestamp": "02:39:59", "text": "自己的东西。好的。"}]
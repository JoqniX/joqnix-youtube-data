[{"type": "subtitle", "time": 2882.309, "timestamp": "00:48:02", "text": "这里应该有办法。比如，你"}, {"type": "subtitle", "time": 2884.47, "timestamp": "00:48:04", "text": "我知道，应该有办法的。那里"}, {"type": "subtitle", "time": 2885.829, "timestamp": "00:48:05", "text": "应该是我能做到的事。"}, {"type": "subtitle", "time": 2888.33, "timestamp": "00:48:08", "text": "有可能。"}, {"type": "subtitle", "time": 2889.51, "timestamp": "00:48:09", "text": "[音乐]"}, {"type": "subtitle", "time": 2893.03, "timestamp": "00:48:13", "text": "改用这种方法。嗯？等待。什么？什么"}, {"type": "subtitle", "time": 2894.79, "timestamp": "00:48:14", "text": "就这么发生的？你做了什么？哦，我的"}, {"type": "subtitle", "time": 2897.349, "timestamp": "00:48:17", "text": "上帝。你想过吗？"}, {"type": "subtitle", "time": 2900.47, "timestamp": "00:48:20", "text": "我什么都没做。我基本上就是……呃……你"}, {"type": "subtitle", "time": 2903.67, "timestamp": "00:48:23", "text": "我想是的，我把它搬走了，我只是"}, {"type": "subtitle", "time": 2906.95, "timestamp": "00:48:26", "text": "我把我的车和我的王交换了。"}, {"type": "subtitle", "time": 2908.99, "timestamp": "00:48:28", "text": "地方"}, {"type": "subtitle", "time": 2911.67, "timestamp": "00:48:31", "text": "昂贵。我想它就叫这个名字。"}, {"type": "subtitle", "time": 2914.549, "timestamp": "00:48:34", "text": "我学得比较慢，所以不太擅长。"}, {"type": "subtitle", "time": 2917.63, "timestamp": "00:48:37", "text": "就这么办。"}, {"type": "subtitle", "time": 2929.75, "timestamp": "00:48:49", "text": "我在砰砰地开枪。"}, {"type": "subtitle", "time": 2938.23, "timestamp": "00:48:58", "text": "好的。好了，够了。什么"}]
[{"type": "subtitle", "time": 487.99, "timestamp": "00:08:07", "text": "莎拉。"}, {"type": "subtitle", "time": 492.469, "timestamp": "00:08:12", "text": "塔。不是那座塔。就像"}, {"type": "subtitle", "time": 494.07, "timestamp": "00:08:14", "text": "你们相遇的地方"}, {"type": "subtitle", "time": 497.189, "timestamp": "00:08:17", "text": "医生。好的。我就是这么做的。"}, {"type": "subtitle", "time": 510.23, "timestamp": "00:08:30", "text": "这是哪里？太棒了。我们不"}, {"type": "subtitle", "time": 511.709, "timestamp": "00:08:31", "text": "需要这座塔"}, {"type": "subtitle", "time": 514.389, "timestamp": "00:08:34", "text": "现在。去看医生。无论你拥有什么"}, {"type": "subtitle", "time": 516.23, "timestamp": "00:08:36", "text": "搞定了，这真的让他们进入了正轨。"}, {"type": "subtitle", "time": 519.11, "timestamp": "00:08:39", "text": "小路。我得和杰德谈谈。莎拉，他"}, {"type": "subtitle", "time": 520.7090000000001, "timestamp": "00:08:40", "text": "他把自己的研究成果给了她。她把它带走了"}, {"type": "subtitle", "time": 524.149, "timestamp": "00:08:44", "text": "卡姆登。她试着"}, {"type": "subtitle", "time": 526.23, "timestamp": "00:08:46", "text": "卡姆登通过无线电报告说，里亚斯的爪牙已经……"}, {"type": "subtitle", "time": 528.55, "timestamp": "00:08:48", "text": "找到了他的实验室。所以，他把它淹没了"}, {"type": "subtitle", "time": 530.31, "timestamp": "00:08:50", "text": "咬人者，他把自己反锁在里面。"}, {"type": "subtitle", "time": 532.389, "timestamp": "00:08:52", "text": "中间。他现在被困住了。然后是"}, {"type": "subtitle", "time": 533.91, "timestamp": "00:08:53", "text": "连接失败。我们一直无法"}, {"type": "subtitle", "time": 537.19, "timestamp": "00:08:57", "text": "从此开始抚养他。我要去找她。"}, {"type": "subtitle", "time": 539.19, "timestamp": "00:08:59", "text": "她是怎么进去的？镇上的那个区域"}]
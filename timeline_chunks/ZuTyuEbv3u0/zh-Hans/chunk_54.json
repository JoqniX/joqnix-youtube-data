[{"type": "subtitle", "time": 3241.91, "timestamp": "00:54:01", "text": "是的。是的。"}, {"type": "subtitle", "time": 3244.15, "timestamp": "00:54:04", "text": "耶。"}, {"type": "subtitle", "time": 3247.15, "timestamp": "00:54:07", "text": "我没有“我爱这首歌”"}, {"type": "subtitle", "time": 3249.51, "timestamp": "00:54:09", "text": "服用后，接下来的事情就像"}, {"type": "subtitle", "time": 3252.47, "timestamp": "00:54:12", "text": "我的天啊，发生什么事了？"}, {"type": "subtitle", "time": 3254.47, "timestamp": "00:54:14", "text": "不，这很糟糕。这很糟糕。我不"}, {"type": "subtitle", "time": 3256.63, "timestamp": "00:54:16", "text": "真的有人有吗？事情就是这样"}, {"type": "subtitle", "time": 3260.63, "timestamp": "00:54:20", "text": "坏的。嘿，你会没事的。"}, {"type": "subtitle", "time": 3262.71, "timestamp": "00:54:22", "text": "现在你赢了。你得到了"}, {"type": "subtitle", "time": 3266.069, "timestamp": "00:54:26", "text": "正义的三大支柱。你有你"}, {"type": "subtitle", "time": 3269.27, "timestamp": "00:54:29", "text": "像一二三四五六"}, {"type": "subtitle", "time": 3271.99, "timestamp": "00:54:31", "text": "士兵或小队。"}, {"type": "subtitle", "time": 3281.109, "timestamp": "00:54:41", "text": "你会没事的。我有一只女王。我可以"}, {"type": "subtitle", "time": 3299.63, "timestamp": "00:54:59", "text": "我可以呃"}]
[{"type": "subtitle", "time": 421.749, "timestamp": "00:07:01", "text": "通常情况下，这是否意味着如果我来到"}, {"type": "subtitle", "time": 423.749, "timestamp": "00:07:03", "text": "你的世界，我依然会继续去了解。"}, {"type": "subtitle", "time": 426.23, "timestamp": "00:07:06", "text": "不拿就没事"}, {"type": "subtitle", "time": 428.71, "timestamp": "00:07:08", "text": "防臭剂？"}, {"type": "subtitle", "time": 431.589, "timestamp": "00:07:11", "text": "是的。我必须到达码头。"}, {"type": "subtitle", "time": 434.55, "timestamp": "00:07:14", "text": "好的。所以，这意味着我必须得到我"}, {"type": "subtitle", "time": 438.23, "timestamp": "00:07:18", "text": "然后就得去塔楼了。"}, {"type": "subtitle", "time": 440.629, "timestamp": "00:07:20", "text": "哦，等等。我不能"}, {"type": "subtitle", "time": 443.029, "timestamp": "00:07:23", "text": "我跑不动了。"}, {"type": "subtitle", "time": 447.35, "timestamp": "00:07:27", "text": "没有瞬间移动。你？"}, {"type": "subtitle", "time": 450.39, "timestamp": "00:07:30", "text": "可惜，没有传送功能。是的。哦，我"}, {"type": "subtitle", "time": 454.15, "timestamp": "00:07:34", "text": "得一路走到那个怪胎跟前。"}, {"type": "subtitle", "time": 459.189, "timestamp": "00:07:39", "text": "好的。我经常抽水烟。哦。"}]
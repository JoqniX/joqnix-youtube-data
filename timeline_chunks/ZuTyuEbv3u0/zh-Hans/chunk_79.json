[{"type": "subtitle", "time": 4742.669, "timestamp": "01:19:02", "text": "诡异的。我"}, {"type": "subtitle", "time": 4745.35, "timestamp": "01:19:05", "text": "嗯，是啊，一起出去玩真的很有趣。"}, {"type": "subtitle", "time": 4748.709, "timestamp": "01:19:08", "text": "与扎基娜一起。而现在的问题是……"}, {"type": "subtitle", "time": 4750.27, "timestamp": "01:19:10", "text": "感觉"}, {"type": "subtitle", "time": 4753.35, "timestamp": "01:19:13", "text": "因为我很难开口"}, {"type": "subtitle", "time": 4756.149, "timestamp": "01:19:16", "text": "提出话题。我觉得我没钱了"}, {"type": "subtitle", "time": 4759.75, "timestamp": "01:19:19", "text": "话题有点少，因为没什么可聊的。"}, {"type": "subtitle", "time": 4762.95, "timestamp": "01:19:22", "text": "有很多话要说，但我希望"}, {"type": "subtitle", "time": 4764.79, "timestamp": "01:19:24", "text": "你们玩得很开心吧？希望你"}, {"type": "subtitle", "time": 4768.43, "timestamp": "01:19:28", "text": "我很喜欢，而且我得确保"}, {"type": "subtitle", "time": 4771.669, "timestamp": "01:19:31", "text": "如果有客人的话，呃，那不会"}, {"type": "subtitle", "time": 4776.229, "timestamp": "01:19:36", "text": "我又在玩游戏了，因为我又来了。"}, {"type": "subtitle", "time": 4778.149, "timestamp": "01:19:38", "text": "我不能总是把游戏当作一种方式"}, {"type": "subtitle", "time": 4780.149, "timestamp": "01:19:40", "text": "比如分散注意力，找点乐子"}, {"type": "subtitle", "time": 4782.63, "timestamp": "01:19:42", "text": "然后玩游戏。主要目标就像……"}, {"type": "subtitle", "time": 4785.07, "timestamp": "01:19:45", "text": "挂出。出去玩，我们聊天"}, {"type": "subtitle", "time": 4788.63, "timestamp": "01:19:48", "text": "东西。是的。但我也希望你们玩得开心。"}, {"type": "subtitle", "time": 4791.99, "timestamp": "01:19:51", "text": "我挺想多做些游戏方面的事情。"}, {"type": "subtitle", "time": 4794.55, "timestamp": "01:19:54", "text": "和其他合作者等等。我"}, {"type": "subtitle", "time": 4797.39, "timestamp": "01:19:57", "text": "我希望这样做。所以"}]
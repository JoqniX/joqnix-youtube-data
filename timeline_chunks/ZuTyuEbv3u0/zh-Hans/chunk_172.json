[{"type": "subtitle", "time": 10323.51, "timestamp": "02:52:03", "text": "呃，我不知道谁在看，但是"}, {"type": "subtitle", "time": 10326.63, "timestamp": "02:52:06", "text": "必须小心，真的要小心。"}, {"type": "subtitle", "time": 10331.99, "timestamp": "02:52:11", "text": "我说这些是因为，呃，因为它能，它能"}, {"type": "subtitle", "time": 10334.55, "timestamp": "02:52:14", "text": "呃，走法律途径。"}, {"type": "subtitle", "time": 10337.269, "timestamp": "02:52:17", "text": "是的。呃，等等，等等，等一下。"}, {"type": "subtitle", "time": 10341.429, "timestamp": "02:52:21", "text": "让我把麦克风静音，然后说出来。"}, {"type": "subtitle", "time": 10359.51, "timestamp": "02:52:39", "text": "我的意思是，我的意思是，我的意思是，最好不要"}, {"type": "subtitle", "time": 10361.11, "timestamp": "02:52:41", "text": "因为我不想看到你得到"}, {"type": "subtitle", "time": 10367.51, "timestamp": "02:52:47", "text": "麻烦。好的。抓到你了。"}, {"type": "subtitle", "time": 10374.71, "timestamp": "02:52:54", "text": "是的。更像是我必须买"}, {"type": "subtitle", "time": 10377.469, "timestamp": "02:52:57", "text": "暂时获得许可证。"}]
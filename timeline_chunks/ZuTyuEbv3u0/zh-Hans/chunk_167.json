[{"type": "subtitle", "time": 10020.63, "timestamp": "02:47:00", "text": "那一刻，我觉得会是"}, {"type": "subtitle", "time": 10025.269, "timestamp": "02:47:05", "text": "最好我晚点再联系你。"}, {"type": "subtitle", "time": 10028.87, "timestamp": "02:47:08", "text": "等我攒够了。我会在日本"}, {"type": "subtitle", "time": 10032.389, "timestamp": "02:47:12", "text": "自七月起。所以我会努力工作，然后"}, {"type": "subtitle", "time": 10034.55, "timestamp": "02:47:14", "text": "欢迎你们再来，希望你们喜欢"}, {"type": "subtitle", "time": 10037.99, "timestamp": "02:47:17", "text": "接受我，再次接受委托。"}, {"type": "subtitle", "time": 10041.11, "timestamp": "02:47:21", "text": "是啊，我的意思是"}, {"type": "subtitle", "time": 10045.83, "timestamp": "02:47:25", "text": "我害怕，如果妈妈和……"}, {"type": "subtitle", "time": 10047.83, "timestamp": "02:47:27", "text": "爸爸可能会说：“是啊，我不想……”"}, {"type": "subtitle", "time": 10050.23, "timestamp": "02:47:30", "text": "收取你的佣金。我不想"}, {"type": "subtitle", "time": 10053.349, "timestamp": "02:47:33", "text": "“去做这件事。”然后他们就抛弃了我。"}, {"type": "subtitle", "time": 10056.23, "timestamp": "02:47:36", "text": "那将是史上最可怕的噩梦。不，"}, {"type": "subtitle", "time": 10059.51, "timestamp": "02:47:39", "text": "别发生。是的。我不想那样"}, {"type": "subtitle", "time": 10062.51, "timestamp": "02:47:42", "text": "将会发生。"}, {"type": "subtitle", "time": 10065.78, "timestamp": "02:47:45", "text": "是的。需要确认"}, {"type": "subtitle", "time": 10072.87, "timestamp": "02:47:52", "text": "是的，最初我应该展示"}, {"type": "subtitle", "time": 10075.51, "timestamp": "02:47:55", "text": "这种设计就像漏水一样，又不像没漏水一样。"}, {"type": "subtitle", "time": 10079.269, "timestamp": "02:47:59", "text": "嗯，这些，一点一点地，但是"}]
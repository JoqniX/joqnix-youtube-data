[{"type": "subtitle", "time": 10560.15, "timestamp": "02:56:00", "text": "你打算毕业时拿到什么？"}, {"type": "subtitle", "time": 10564.07, "timestamp": "02:56:04", "text": "今年从大学毕业吗？啊，大学，是的。"}, {"type": "subtitle", "time": 10578.71, "timestamp": "02:56:18", "text": "你好。嗨，乔。嗨，Alex。你好吗？"}, {"type": "subtitle", "time": 10580.71, "timestamp": "02:56:20", "text": "正在做？"}, {"type": "subtitle", "time": 10584.23, "timestamp": "02:56:24", "text": "你做得很好。你好吗？如何"}, {"type": "subtitle", "time": 10584.91, "timestamp": "02:56:24", "text": "你"}, {"type": "subtitle", "time": 10587.51, "timestamp": "02:56:27", "text": "正在做？欢迎。"}, {"type": "subtitle", "time": 10590.63, "timestamp": "02:56:30", "text": "好的。现在，我有一个问题。"}, {"type": "subtitle", "time": 10592.79, "timestamp": "02:56:32", "text": "哦，是的。就像你在日本一样"}, {"type": "subtitle", "time": 10594.71, "timestamp": "02:56:34", "text": "还有些正确之处。所以你有类似的东西吗？"}, {"type": "subtitle", "time": 10596.19, "timestamp": "02:56:36", "text": "你的英语"}, {"type": "subtitle", "time": 10599.91, "timestamp": "02:56:39", "text": "就像你希望在你之前喜欢的那样"}, {"type": "subtitle", "time": 10601.67, "timestamp": "02:56:41", "text": "比如想想去日本的事"}, {"type": "subtitle", "time": 10608.309, "timestamp": "02:56:48", "text": "等等，问题是什么？在你之前"}, {"type": "subtitle", "time": 10611.83, "timestamp": "02:56:51", "text": "可以考虑去日本。"}, {"type": "subtitle", "time": 10613.59, "timestamp": "02:56:53", "text": "研究。"}, {"type": "subtitle", "time": 10614.95, "timestamp": "02:56:54", "text": "是的。是的。在考虑这个问题之前，"}, {"type": "subtitle", "time": 10616.15, "timestamp": "02:56:56", "text": "你知道，甚至在你还没……之前"}, {"type": "subtitle", "time": 10617.75, "timestamp": "02:56:57", "text": "考虑过学习吗？你有什么学习经历吗？"}, {"type": "subtitle", "time": 10619.83, "timestamp": "02:56:59", "text": "你想在日本游览的地方，"}]
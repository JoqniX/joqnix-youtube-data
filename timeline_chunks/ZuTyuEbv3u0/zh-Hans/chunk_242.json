[{"type": "subtitle", "time": 14521.83, "timestamp": "04:02:01", "text": "玩玩看，祝你好运！"}, {"type": "subtitle", "time": 14529.269, "timestamp": "04:02:09", "text": "是的。我只是，我只是，我试着像"}, {"type": "subtitle", "time": 14532.229, "timestamp": "04:02:12", "text": "更随意一点，你知道，轻松的直播"}, {"type": "subtitle", "time": 14535.59, "timestamp": "04:02:15", "text": "未来会有像你这样的人"}, {"type": "subtitle", "time": 14537.349, "timestamp": "04:02:17", "text": "这样我沟通起来就容易多了。"}, {"type": "subtitle", "time": 14541.91, "timestamp": "04:02:21", "text": "大约。是的。是的。是的。真的。"}, {"type": "subtitle", "time": 14544.229, "timestamp": "04:02:24", "text": "我觉得现在就是糟糕的一年。"}, {"type": "subtitle", "time": 14546.55, "timestamp": "04:02:26", "text": "当你看到一些新的 YouTuber 时，比如"}, {"type": "subtitle", "time": 14550.71, "timestamp": "04:02:30", "text": "你是新来的，然后你来到这里"}, {"type": "subtitle", "time": 14552.71, "timestamp": "04:02:32", "text": "它逐渐了解到这个社区的情况。"}, {"type": "subtitle", "time": 14556.389, "timestamp": "04:02:36", "text": "现在很难接近它。"}, {"type": "subtitle", "time": 14558.71, "timestamp": "04:02:38", "text": "我的意思是，你是在谈论发现"}, {"type": "subtitle", "time": 14560.95, "timestamp": "04:02:40", "text": "社区对我来说是全新的，与此同时，我"}, {"type": "subtitle", "time": 14563.269, "timestamp": "04:02:43", "text": "沟通方面已经存在问题。"}, {"type": "subtitle", "time": 14566.469, "timestamp": "04:02:46", "text": "兄弟，就算在这儿待了这么多年也是。"}, {"type": "subtitle", "time": 14568.389, "timestamp": "04:02:48", "text": "是的，你在这里待了好几年了。"}, {"type": "subtitle", "time": 14570.11, "timestamp": "04:02:50", "text": "正确的"}, {"type": "subtitle", "time": 14573.03, "timestamp": "04:02:53", "text": "是的，没有男人喜欢新人，没有"}, {"type": "subtitle", "time": 14575.67, "timestamp": "04:02:55", "text": "他们会说，哦，很难够到"}, {"type": "subtitle", "time": 14579.429, "timestamp": "04:02:59", "text": "我该怎么办？"}]
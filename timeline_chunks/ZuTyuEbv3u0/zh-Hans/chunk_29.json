[{"type": "subtitle", "time": 1743.19, "timestamp": "00:29:03", "text": "大概还需要两个月左右。"}, {"type": "subtitle", "time": 1746.31, "timestamp": "00:29:06", "text": "那是因为我很忙，但是……"}, {"type": "subtitle", "time": 1749.59, "timestamp": "00:29:09", "text": "嗯，我确实达到了白金级别。"}, {"type": "subtitle", "time": 1752.63, "timestamp": "00:29:12", "text": "是的。涂黑什么？是的，我明白了。"}, {"type": "subtitle", "time": 1755.83, "timestamp": "00:29:15", "text": "格子图案，然后我就摔倒了。我坠入了深渊。"}, {"type": "subtitle", "time": 1759.269, "timestamp": "00:29:19", "text": "你知道，在我拿到格子衬衫之后。哦，我的"}, {"type": "subtitle", "time": 1761.83, "timestamp": "00:29:21", "text": "上帝。你知道吗，我当时其实是这样的……"}, {"type": "subtitle", "time": 1765.35, "timestamp": "00:29:25", "text": "离钻石级别很近了，"}, {"type": "subtitle", "time": 1767.75, "timestamp": "00:29:27", "text": "那是用另一个账号发的，伙计们。"}, {"type": "subtitle", "time": 1770.31, "timestamp": "00:29:30", "text": "就像我，也许它在账户上"}, {"type": "subtitle", "time": 1773.35, "timestamp": "00:29:33", "text": "我现在正在玩这个游戏，但我确实玩过。好的，"}, {"type": "subtitle", "time": 1776.71, "timestamp": "00:29:36", "text": "你们。我没撒谎。我尽力了"}, {"type": "subtitle", "time": 1779.51, "timestamp": "00:29:39", "text": "我可以做到。我觉得你"}, {"type": "subtitle", "time": 1780.95, "timestamp": "00:29:40", "text": "你知道，打篮球的时候，你只需要……"}, {"type": "subtitle", "time": 1784.549, "timestamp": "00:29:44", "text": "比如挑选一个你可以……的代理人"}, {"type": "subtitle", "time": 1787.51, "timestamp": "00:29:47", "text": "实际上喜欢玩而不是玩耍"}, {"type": "subtitle", "time": 1791.029, "timestamp": "00:29:51", "text": "经纪人，你想玩什么都行，或者嗯"}, {"type": "subtitle", "time": 1793.11, "timestamp": "00:29:53", "text": "时不时地更换你的老师。"}, {"type": "subtitle", "time": 1797.029, "timestamp": "00:29:57", "text": "我只是觉得你必须拥有你拥有"}, {"type": "subtitle", "time": 1799.51, "timestamp": "00:29:59", "text": "用单个脑细胞来演奏芭蕾舞。"}]
[{"type": "subtitle", "time": 8221.11, "timestamp": "02:17:01", "text": "啊，那你就没法上学了。"}, {"type": "subtitle", "time": 8223.669, "timestamp": "02:17:03", "text": "工作一切正常，对吗？"}, {"type": "subtitle", "time": 8226.07, "timestamp": "02:17:06", "text": "我的意思是大学作业，我的意思是……"}, {"type": "subtitle", "time": 8228.07, "timestamp": "02:17:08", "text": "一个月后我就不需要它了，因为你"}, {"type": "subtitle", "time": 8231.509, "timestamp": "02:17:11", "text": "我知道只是考试，但七月之后就没事了。"}, {"type": "subtitle", "time": 8233.11, "timestamp": "02:17:13", "text": "我最后一年可能需要它。"}, {"type": "chat", "time": 8237.285, "timestamp": "02:17:17", "author": "@disguisedmage52", "avatar": "https://yt4.ggpht.com/GxHs1Pjek4K9rDWLxk7a5vc4UOg92flOcio1PW3zpZhmKvuCb6hZslc52JOgikbv6tnSZJXhyw=s64-c-k-c0x00ffffff-no-rj", "message": "Yoooo "}, {"type": "subtitle", "time": 8240.309, "timestamp": "02:17:20", "text": "好的，那么，你那边的生活怎么样？"}, {"type": "subtitle", "time": 8242.95, "timestamp": "02:17:22", "text": "因为我真的很想念很多……"}, {"type": "subtitle", "time": 8246.03, "timestamp": "02:17:26", "text": "请提供您方的信息。"}, {"type": "subtitle", "time": 8248.469, "timestamp": "02:17:28", "text": "是的，我只知道你正在训练。"}, {"type": "subtitle", "time": 8249.99, "timestamp": "02:17:29", "text": "日本人喜欢继续前进"}, {"type": "subtitle", "time": 8253.99, "timestamp": "02:17:33", "text": "研究。嗯，我们还是找时间聊聊吧。"}, {"type": "subtitle", "time": 8257.11, "timestamp": "02:17:37", "text": "已经很久没有过了，所以对我来说是的。"}, {"type": "subtitle", "time": 8260.429, "timestamp": "02:17:40", "text": "嗯，生活一直如此。"}, {"type": "subtitle", "time": 8269.91, "timestamp": "02:17:49", "text": "我想我终于……嗯，我很高兴我终于……"}, {"type": "subtitle", "time": 8272.709, "timestamp": "02:17:52", "text": "决定了我想做什么或喜欢去哪里"}, {"type": "chat", "time": 8274.19, "timestamp": "02:17:54", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ-r4KpS3_9EP-duW6QoUCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ-r4KpS3_9EP-duW6QoUCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ-r4KpS3_9EP-duW6Qo"}, {"type": "subtitle", "time": 8275.349, "timestamp": "02:17:55", "text": "比如，我该如何处理我的未来计划？"}, {"type": "subtitle", "time": 8278.549, "timestamp": "02:17:58", "text": "我觉得父母们应该会很高兴。"}]
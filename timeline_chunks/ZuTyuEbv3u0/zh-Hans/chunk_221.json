[{"type": "subtitle", "time": 13260.15, "timestamp": "03:41:00", "text": "我的意思是，这就是为什么我从来不喜欢它的原因。"}, {"type": "subtitle", "time": 13267.349, "timestamp": "03:41:07", "text": "是啊，这就是最糟糕的部分。"}, {"type": "subtitle", "time": 13270.349, "timestamp": "03:41:10", "text": "有时坐火车。是的，的确如此。"}, {"type": "subtitle", "time": 13272.95, "timestamp": "03:41:12", "text": "疼痛。所以，基本上情况如何？"}, {"type": "subtitle", "time": 13275.269, "timestamp": "03:41:15", "text": "去另一个州的经历"}, {"type": "subtitle", "time": 13277.19, "timestamp": "03:41:17", "text": "就像你知道你不知道那样"}, {"type": "subtitle", "time": 13279.67, "timestamp": "03:41:19", "text": "那种语言之类的东西。是的。比如当"}, {"type": "subtitle", "time": 13282.07, "timestamp": "03:41:22", "text": "我去钦奈参加了考试"}, {"type": "subtitle", "time": 13284.309, "timestamp": "03:41:24", "text": "因为我不知道该怎么走，所以我爸爸就走了。"}, {"type": "subtitle", "time": 13286.75, "timestamp": "03:41:26", "text": "孤身一人，如今已无所事事。"}, {"type": "subtitle", "time": 13289.349, "timestamp": "03:41:29", "text": "亲身经历之后，感觉完全不一样了。"}, {"type": "subtitle", "time": 13292.55, "timestamp": "03:41:32", "text": "钦奈的道路非常宽阔，"}, {"type": "subtitle", "time": 13295.99, "timestamp": "03:41:35", "text": "东西。我当时就想，哇，这些路真好！"}, {"type": "subtitle", "time": 13298.87, "timestamp": "03:41:38", "text": "大的。不，关键在于你选择了你"}, {"type": "subtitle", "time": 13300.95, "timestamp": "03:41:40", "text": "我选择了我所在地区最糟糕的一个区。"}, {"type": "subtitle", "time": 13303.67, "timestamp": "03:41:43", "text": "州政府可能要去旅行，因为那是"}, {"type": "subtitle", "time": 13306.63, "timestamp": "03:41:46", "text": "一座交通拥堵的城市。是的，"}, {"type": "subtitle", "time": 13309.99, "timestamp": "03:41:49", "text": "交通非常拥堵，"}, {"type": "subtitle", "time": 13313.59, "timestamp": "03:41:53", "text": "我在宾夕法尼亚州和钦奈注意到的一件事是"}, {"type": "subtitle", "time": 13317.51, "timestamp": "03:41:57", "text": "汽车和公平费用太高了"}]
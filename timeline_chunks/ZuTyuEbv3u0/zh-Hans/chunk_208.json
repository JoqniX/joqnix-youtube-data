[{"type": "subtitle", "time": 12482.07, "timestamp": "03:28:02", "text": "什么？它叫什么名字？我的天啊。"}, {"type": "subtitle", "time": 12484.95, "timestamp": "03:28:04", "text": "阿祖拉·拉皮斯。你还记得她吗？这"}, {"type": "subtitle", "time": 12487.07, "timestamp": "03:28:07", "text": "蓝色的"}, {"type": "subtitle", "time": 12489.75, "timestamp": "03:28:09", "text": "苍鹭。是的，我知道。是的。是的。是的。"}, {"type": "subtitle", "time": 12491.83, "timestamp": "03:28:11", "text": "你和她最近聊得怎么样？如何"}, {"type": "subtitle", "time": 12494.11, "timestamp": "03:28:14", "text": "是吗？感觉好像过了很久。我只是"}, {"type": "subtitle", "time": 12497.03, "timestamp": "03:28:17", "text": "突然想起来了。那片蓝色"}, {"type": "subtitle", "time": 12498.71, "timestamp": "03:28:18", "text": "头发。"}, {"type": "subtitle", "time": 12501.309, "timestamp": "03:28:21", "text": "她突然消失了。"}, {"type": "subtitle", "time": 12505.03, "timestamp": "03:28:25", "text": "什么？她不直播。"}, {"type": "subtitle", "time": 12507.469, "timestamp": "03:28:27", "text": "是的。我的意思是，我相当"}, {"type": "subtitle", "time": 12509.67, "timestamp": "03:28:29", "text": "当然。是的，我很确定她是。"}, {"type": "subtitle", "time": 12511.99, "timestamp": "03:28:31", "text": "不同的。哦，等等。好的，呃，检查一下。"}, {"type": "subtitle", "time": 12515.75, "timestamp": "03:28:35", "text": "她的不和谐。哦，她确实像……那样聊天。"}, {"type": "subtitle", "time": 12524.71, "timestamp": "03:28:44", "text": "啊，真糟糕。所以，她还活着，哦，我的天哪"}, {"type": "subtitle", "time": 12527.469, "timestamp": "03:28:47", "text": "天哪，你为什么那样说，哦，我的天"}, {"type": "subtitle", "time": 12531.11, "timestamp": "03:28:51", "text": "上帝。对不起。不，别急着跳到"}, {"type": "subtitle", "time": 12532.55, "timestamp": "03:28:52", "text": "结论是所有人都死了"}, {"type": "subtitle", "time": 12534.15, "timestamp": "03:28:54", "text": "仅仅因为他们不这样做，他们就不是"}, {"type": "subtitle", "time": 12536.469, "timestamp": "03:28:56", "text": "流媒体。好的。是的。是啊，那很糟糕。"}, {"type": "subtitle", "time": 12539.349, "timestamp": "03:28:59", "text": "是的。每个人都有自己的生活。"}]
[{"type": "subtitle", "time": 3060.23, "timestamp": "00:51:00", "text": "呃，我们走吧。"}, {"type": "subtitle", "time": 3063.27, "timestamp": "00:51:03", "text": "好的。我要去那里。这是我的地方"}, {"type": "subtitle", "time": 3071.91, "timestamp": "00:51:11", "text": "所以你是女王。我可以搬动什么？哦"}, {"type": "subtitle", "time": 3078.99, "timestamp": "00:51:18", "text": "上帝。我可以做什么"}, {"type": "subtitle", "time": 3083.19, "timestamp": "00:51:23", "text": "移动？我想毁了这家伙。呃，但是"}, {"type": "subtitle", "time": 3089.99, "timestamp": "00:51:29", "text": "没关系。前辈，别想太多。"}, {"type": "subtitle", "time": 3092.19, "timestamp": "00:51:32", "text": "是的，我要回去了。"}, {"type": "subtitle", "time": 3095.27, "timestamp": "00:51:35", "text": "普通的。再见。"}, {"type": "subtitle", "time": 3098.309, "timestamp": "00:51:38", "text": "我的天哪，你竟然选了我。我真的，"}, {"type": "subtitle", "time": 3101.91, "timestamp": "00:51:41", "text": "真的，真的，真的想要，你知道的"}, {"type": "subtitle", "time": 3105.589, "timestamp": "00:51:45", "text": "那个人持续了很长时间。我真的"}, {"type": "subtitle", "time": 3108.15, "timestamp": "00:51:48", "text": "我很久以来都想见到这位主教。"}]
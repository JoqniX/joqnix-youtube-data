[{"type": "subtitle", "time": 14881.11, "timestamp": "04:08:01", "text": "诸如“你是否有白色”之类的问题"}, {"type": "subtitle", "time": 14884.229, "timestamp": "04:08:04", "text": "更喜欢肤色较浅的模特"}, {"type": "subtitle", "time": 14886.51, "timestamp": "04:08:06", "text": "你感觉自己不像你。"}, {"type": "subtitle", "time": 14889.189, "timestamp": "04:08:09", "text": "印度人的肤色与此不符，而且"}, {"type": "subtitle", "time": 14903.67, "timestamp": "04:08:23", "text": "好的。你在找什么游戏？"}, {"type": "subtitle", "time": 14907.03, "timestamp": "04:08:27", "text": "向前推进去玩之类的？"}, {"type": "subtitle", "time": 14910.309, "timestamp": "04:08:30", "text": "呃，比如现在这种情况，还是泛指这种情况？呃，在"}, {"type": "subtitle", "time": 14912.389, "timestamp": "04:08:32", "text": "普遍权利，就像现在和未来一样。"}, {"type": "subtitle", "time": 14915.83, "timestamp": "04:08:35", "text": "你期待着"}, {"type": "subtitle", "time": 14917.83, "timestamp": "04:08:37", "text": "我的意思是，我会说我会，我会说我"}, {"type": "subtitle", "time": 14919.75, "timestamp": "04:08:39", "text": "想了解所有当前的呃"}, {"type": "subtitle", "time": 14921.11, "timestamp": "04:08:41", "text": "你可以玩的热门多人游戏"}, {"type": "subtitle", "time": 14923.91, "timestamp": "04:08:43", "text": "和你的朋友一起玩"}, {"type": "subtitle", "time": 14927.269, "timestamp": "04:08:47", "text": "就像仓库一样，但是等等，你已经有仓库了吧？"}, {"type": "subtitle", "time": 14931.83, "timestamp": "04:08:51", "text": "是的，我有，那很酷。"}, {"type": "subtitle", "time": 14935.189, "timestamp": "04:08:55", "text": "是的，我所有的那些游戏都是真的。"}, {"type": "subtitle", "time": 14938.229, "timestamp": "04:08:58", "text": "你是说，是的，完全，我的笔记本电脑"}]
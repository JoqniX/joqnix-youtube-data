[{"type": "subtitle", "time": 13020.309, "timestamp": "03:37:00", "text": "好的。但"}, {"type": "subtitle", "time": 13024.63, "timestamp": "03:37:04", "text": "对我来说，就好像我喜欢说，呃，700"}, {"type": "subtitle", "time": 13029.59, "timestamp": "03:37:09", "text": "下午我吃晚饭。好的。我当时……"}, {"type": "subtitle", "time": 13032.15, "timestamp": "03:37:12", "text": "比如五点左右提供茶点之类的。"}, {"type": "subtitle", "time": 13034.95, "timestamp": "03:37:14", "text": "然后，在中间或者比如说，我曾经有过"}, {"type": "subtitle", "time": 13037.67, "timestamp": "03:37:17", "text": "下午4点提供茶点。所以在5点之间，"}, {"type": "subtitle", "time": 13039.99, "timestamp": "03:37:19", "text": "六个，对吧？所以，就像我曾经那样，中间有"}, {"type": "subtitle", "time": 13042.229, "timestamp": "03:37:22", "text": "一杯青柠汁之类的，我会的"}, {"type": "subtitle", "time": 13045.11, "timestamp": "03:37:25", "text": "满。我不知道为什么。那个"}, {"type": "subtitle", "time": 13047.51, "timestamp": "03:37:27", "text": "一杯青柠汁或一杯软饮料"}, {"type": "subtitle", "time": 13049.75, "timestamp": "03:37:29", "text": "吃点东西，我会很满足，然后我会像这样"}, {"type": "subtitle", "time": 13052.15, "timestamp": "03:37:32", "text": "我无法享受晚餐的时光。我会"}, {"type": "subtitle", "time": 13055.269, "timestamp": "03:37:35", "text": "就像一把勺子等于"}, {"type": "subtitle", "time": 13058.309, "timestamp": "03:37:38", "text": "半勺。是的。所以你明白了"}, {"type": "subtitle", "time": 13060.469, "timestamp": "03:37:40", "text": "你知道，我也有点喜欢拥有"}, {"type": "subtitle", "time": 13062.309, "timestamp": "03:37:42", "text": "同样的问题。所以基本上我的饮食"}, {"type": "subtitle", "time": 13064.469, "timestamp": "03:37:44", "text": "我在家的时候骑自行车感觉很诡异，你"}, {"type": "subtitle", "time": 13066.95, "timestamp": "03:37:46", "text": "知道。我上午11点吃早餐。"}, {"type": "subtitle", "time": 13070.389, "timestamp": "03:37:50", "text": "我下午四点才吃午饭。以及我的"}, {"type": "subtitle", "time": 13074.309, "timestamp": "03:37:54", "text": "晚餐大概晚上11点。该死。"}, {"type": "subtitle", "time": 13076.71, "timestamp": "03:37:56", "text": "是的，这就是我所处的周期。"}, {"type": "subtitle", "time": 13079.67, "timestamp": "03:37:59", "text": "我的家就像本地的伴侣，你呢？"}]
[{"type": "subtitle", "time": 3780.39, "timestamp": "01:03:00", "text": "我觉得我已经是了。哦，你没事吧？"}, {"type": "subtitle", "time": 3783.99, "timestamp": "01:03:03", "text": "等等，我不能……我不能"}, {"type": "subtitle", "time": 3788.069, "timestamp": "01:03:08", "text": "庆祝一下，比如我的生日。我"}, {"type": "subtitle", "time": 3790.39, "timestamp": "01:03:10", "text": "没能庆祝我的四周年"}, {"type": "subtitle", "time": 3792.63, "timestamp": "01:03:12", "text": "周年纪念日。"}, {"type": "subtitle", "time": 3796.309, "timestamp": "01:03:16", "text": "等待。是的。是的。那是什么？五月 六月。"}, {"type": "subtitle", "time": 3798.71, "timestamp": "01:03:18", "text": "是啊，现在是六月，对吧？是的。等等，是"}, {"type": "subtitle", "time": 3801.91, "timestamp": "01:03:21", "text": "到六月了吗？"}, {"type": "subtitle", "time": 3804.309, "timestamp": "01:03:24", "text": "所以，我不知道我有没有时间"}, {"type": "subtitle", "time": 3808.19, "timestamp": "01:03:28", "text": "当天就完成。"}, {"type": "subtitle", "time": 3811.829, "timestamp": "01:03:31", "text": "所以，我一直错过了很多，而且我"}, {"type": "subtitle", "time": 3814.39, "timestamp": "01:03:34", "text": "这一切都让我感到非常害怕错过什么，"}, {"type": "subtitle", "time": 3817.67, "timestamp": "01:03:37", "text": "但没关系。"}, {"type": "subtitle", "time": 3819.99, "timestamp": "01:03:39", "text": "是的。你一直都在吗？你一直都在吗？"}, {"type": "subtitle", "time": 3822.309, "timestamp": "01:03:42", "text": "享受漂流和其他一切乐趣吗？怎么样？"}, {"type": "subtitle", "time": 3825.029, "timestamp": "01:03:45", "text": "你一切顺利吗？你喜欢吗？"}, {"type": "subtitle", "time": 3826.75, "timestamp": "01:03:46", "text": "这？"}, {"type": "subtitle", "time": 3832.19, "timestamp": "01:03:52", "text": "是的，就像管子一样"}, {"type": "subtitle", "time": 3835.91, "timestamp": "01:03:55", "text": "一直是最大的福气之一"}, {"type": "subtitle", "time": 3837.67, "timestamp": "01:03:57", "text": "我的人生。"}]
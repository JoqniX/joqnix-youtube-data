[{"type": "subtitle", "time": 4206.47, "timestamp": "01:10:06", "text": "找到她。我对你很失望。开玩笑。"}, {"type": "subtitle", "time": 4208.87, "timestamp": "01:10:08", "text": "你是什​​么意思？我不吃这种花哨的东西。"}, {"type": "subtitle", "time": 4211.83, "timestamp": "01:10:11", "text": "你觉得我能从我身上得到的东西"}, {"type": "subtitle", "time": 4219.43, "timestamp": "01:10:19", "text": "东西。我现在就这么做。是的，我"}, {"type": "subtitle", "time": 4222.709, "timestamp": "01:10:22", "text": "我发誓你永远不会知道。好的。好的。你"}, {"type": "subtitle", "time": 4224.79, "timestamp": "01:10:24", "text": "谁也说不准。好的。你不会知道的。"}, {"type": "subtitle", "time": 4226.669, "timestamp": "01:10:26", "text": "好的。它是"}, {"type": "subtitle", "time": 4230.229, "timestamp": "01:10:30", "text": "桃桃。桃桃。"}, {"type": "subtitle", "time": 4232.95, "timestamp": "01:10:32", "text": "这不是馍馍。"}, {"type": "subtitle", "time": 4238.27, "timestamp": "01:10:38", "text": "桃桃。"}, {"type": "subtitle", "time": 4241.83, "timestamp": "01:10:41", "text": "当然。你说什么都行。"}, {"type": "subtitle", "time": 4243.99, "timestamp": "01:10:43", "text": "当然，当然，当然，当然，当然。好的。"}, {"type": "subtitle", "time": 4251.75, "timestamp": "01:10:51", "text": "感谢你们今天邀请我参加你们的节目。"}, {"type": "subtitle", "time": 4255.189, "timestamp": "01:10:55", "text": "溪流。谢谢。谢谢。这意味着"}, {"type": "subtitle", "time": 4259.51, "timestamp": "01:10:59", "text": "有很多值得记住和珍惜的东西"}]
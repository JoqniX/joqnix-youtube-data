[{"type": "subtitle", "time": 11940.87, "timestamp": "03:19:00", "text": "至少精通三种语言。"}, {"type": "subtitle", "time": 11942.269, "timestamp": "03:19:02", "text": "是的。"}, {"type": "subtitle", "time": 11948.71, "timestamp": "03:19:08", "text": "比如，还有英语，然后是泰米尔语，对吧？"}, {"type": "subtitle", "time": 11950.55, "timestamp": "03:19:10", "text": "或更多"}, {"type": "subtitle", "time": 11952.63, "timestamp": "03:19:12", "text": "就像所有马利斯特人一样，"}, {"type": "subtitle", "time": 11954.389, "timestamp": "03:19:14", "text": "有泰米尔人，也有加拿大人"}, {"type": "subtitle", "time": 11956.07, "timestamp": "03:19:16", "text": "各位，这里甚至还有印地语和泰卢固语。"}, {"type": "subtitle", "time": 11957.349, "timestamp": "03:19:17", "text": "人们。"}, {"type": "subtitle", "time": 11959.03, "timestamp": "03:19:19", "text": "啊"}, {"type": "subtitle", "time": 11960.309, "timestamp": "03:19:20", "text": "是的，我就是这么听说的。"}, {"type": "subtitle", "time": 11962.63, "timestamp": "03:19:22", "text": "每个人都觉得它像是各种混合体，甚至"}, {"type": "subtitle", "time": 11964.55, "timestamp": "03:19:24", "text": "听听，就像现在的呃城市一样"}, {"type": "subtitle", "time": 11966.71, "timestamp": "03:19:26", "text": "我正在大学学习，甚至"}, {"type": "subtitle", "time": 11969.11, "timestamp": "03:19:29", "text": "即使我的大学就像在……"}, {"type": "subtitle", "time": 11972.309, "timestamp": "03:19:32", "text": "这里很偏僻，感觉就像我们一样。"}, {"type": "subtitle", "time": 11974.79, "timestamp": "03:19:34", "text": "虽然不太出名，但它仍然是一种混合体。"}, {"type": "subtitle", "time": 11979.59, "timestamp": "03:19:39", "text": "就像有很多人一样"}, {"type": "subtitle", "time": 11989.87, "timestamp": "03:19:49", "text": "哦，安得拉邦。"}, {"type": "subtitle", "time": 11992.349, "timestamp": "03:19:52", "text": "好的。太多了"}, {"type": "subtitle", "time": 11994.87, "timestamp": "03:19:54", "text": "人们。哦，是的。怎么样？"}, {"type": "subtitle", "time": 11997.67, "timestamp": "03:19:57", "text": "课程之类的？"}]
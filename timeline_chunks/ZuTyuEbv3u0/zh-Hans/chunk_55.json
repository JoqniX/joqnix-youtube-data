[{"type": "subtitle", "time": 3302.39, "timestamp": "00:55:02", "text": "也许我不会，我还在学习如何……"}, {"type": "subtitle", "time": 3304.309, "timestamp": "00:55:04", "text": "将死。所以你知道，我们……"}, {"type": "subtitle", "time": 3306.87, "timestamp": "00:55:06", "text": "我还要再说一会儿。"}, {"type": "subtitle", "time": 3310.549, "timestamp": "00:55:10", "text": "猜测。是的。我打算四处走走。"}, {"type": "subtitle", "time": 3314.829, "timestamp": "00:55:14", "text": "整张地图。所以别担心。"}, {"type": "subtitle", "time": 3320.069, "timestamp": "00:55:20", "text": "真的在旋转。你会省钱"}, {"type": "subtitle", "time": 3323.549, "timestamp": "00:55:23", "text": "在上一轮。就这些吗？"}, {"type": "subtitle", "time": 3326.349, "timestamp": "00:55:26", "text": "是的。你好，"}, {"type": "subtitle", "time": 3331.19, "timestamp": "00:55:31", "text": "男朋友。该死。嗯，"}, {"type": "subtitle", "time": 3335.43, "timestamp": "00:55:35", "text": "我做不了什么，对吧？"}, {"type": "subtitle", "time": 3337.39, "timestamp": "00:55:37", "text": "是的，我得把你的东西处理掉。"}, {"type": "subtitle", "time": 3342.309, "timestamp": "00:55:42", "text": "士兵们一个接一个地走。我的天啊。一个接一个"}]
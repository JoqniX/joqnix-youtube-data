[{"type": "subtitle", "time": 723.19, "timestamp": "00:12:03", "text": "梅尔，你去给我买晚饭，然后回来。"}, {"type": "subtitle", "time": 734.15, "timestamp": "00:12:14", "text": "我的天啊。我的天啊。我的天啊。翻动。"}, {"type": "subtitle", "time": 736.069, "timestamp": "00:12:16", "text": "我会在加入你的世界之前先尝试一下"}, {"type": "subtitle", "time": 772.31, "timestamp": "00:12:52", "text": "杰德加入了一个叫做……的团体"}, {"type": "subtitle", "time": 774.15, "timestamp": "00:12:54", "text": "救世主。显然，他们可以抓到人"}, {"type": "subtitle", "time": 776.71, "timestamp": "00:12:56", "text": "至零区。我得找到他们，"}, {"type": "subtitle", "time": 778.55, "timestamp": "00:12:58", "text": "找到她的联系方式。阿曼达，我喜欢你"}]
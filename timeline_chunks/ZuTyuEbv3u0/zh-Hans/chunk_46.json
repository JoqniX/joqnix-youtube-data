[{"type": "subtitle", "time": 2763.19, "timestamp": "00:46:03", "text": "所以，只要它是可食用的，而且"}, {"type": "subtitle", "time": 2765.67, "timestamp": "00:46:05", "text": "东西不错。"}, {"type": "subtitle", "time": 2769.109, "timestamp": "00:46:09", "text": "我觉得我不介意吃"}, {"type": "subtitle", "time": 2771.03, "timestamp": "00:46:11", "text": "香饭之类的，所有那些东西。"}, {"type": "subtitle", "time": 2772.87, "timestamp": "00:46:12", "text": "食物。"}, {"type": "subtitle", "time": 2775.43, "timestamp": "00:46:15", "text": "龙舌兰，你呢？"}, {"type": "subtitle", "time": 2783.309, "timestamp": "00:46:23", "text": "我以前喜欢"}, {"type": "subtitle", "time": 2787.19, "timestamp": "00:46:27", "text": "嗯……那叫什么？什么？什么？"}, {"type": "subtitle", "time": 2790.87, "timestamp": "00:46:30", "text": "那是一种叫什么食物？拉起来。对，拉"}, {"type": "subtitle", "time": 2794.71, "timestamp": "00:46:34", "text": "离开。但是，是的，不过现在我"}, {"type": "subtitle", "time": 2796.309, "timestamp": "00:46:36", "text": "我不太喜欢它。喜欢"}, {"type": "subtitle", "time": 2801.03, "timestamp": "00:46:41", "text": "我现在还在适应饮食。"}, {"type": "subtitle", "time": 2804.63, "timestamp": "00:46:44", "text": "我现在很喜欢吃饺子。馍馍非常"}, {"type": "subtitle", "time": 2807.43, "timestamp": "00:46:47", "text": "好的。"}, {"type": "subtitle", "time": 2809.95, "timestamp": "00:46:49", "text": "Momos，非常"}, {"type": "subtitle", "time": 2812.79, "timestamp": "00:46:52", "text": "柔软、温暖、"}, {"type": "subtitle", "time": 2817.589, "timestamp": "00:46:57", "text": "丰满的，你知道，可爱的。是的。而我是"}, {"type": "subtitle", "time": 2819.91, "timestamp": "00:46:59", "text": "解释馍馍如何浪费时间"}]
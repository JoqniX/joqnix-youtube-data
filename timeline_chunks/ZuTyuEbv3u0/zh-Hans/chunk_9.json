[{"type": "subtitle", "time": 541.829, "timestamp": "00:09:01", "text": "已封闭。"}, {"type": "subtitle", "time": 544.23, "timestamp": "00:09:04", "text": "有一个叫做救世主的组织，"}, {"type": "subtitle", "time": 546.47, "timestamp": "00:09:06", "text": "偷渡人口。他们有个巢穴"}, {"type": "subtitle", "time": 549.71, "timestamp": "00:09:09", "text": "在尼科酒吧，就在坩埚附近"}, {"type": "subtitle", "time": 552.79, "timestamp": "00:09:12", "text": "公路。名字足以覆盖所有参赛者"}, {"type": "subtitle", "time": 556.389, "timestamp": "00:09:16", "text": "空投。空降停止了36小时"}, {"type": "subtitle", "time": 559.269, "timestamp": "00:09:19", "text": "前。不会再有了。我们出局了"}, {"type": "subtitle", "time": 562.55, "timestamp": "00:09:22", "text": "时间。起重机。拉屎。"}, {"type": "subtitle", "time": 564.87, "timestamp": "00:09:24", "text": "好的。我不知道我能不能修好。"}, {"type": "subtitle", "time": 566.389, "timestamp": "00:09:26", "text": "没错，但我一定会尝试的。"}, {"type": "subtitle", "time": 568.87, "timestamp": "00:09:28", "text": "你知道大多数和你处境相同的男人会怎么做。"}, {"type": "subtitle", "time": 571.03, "timestamp": "00:09:31", "text": "会钻进洞里躲起来。帽子"}, {"type": "subtitle", "time": 578.31, "timestamp": "00:09:38", "text": "哦，他把我们的收音机也拿走了。好的，"}, {"type": "subtitle", "time": 581.11, "timestamp": "00:09:41", "text": "最后。乌克兰，这是你们的装备。最好的"}, {"type": "subtitle", "time": 583.509, "timestamp": "00:09:43", "text": "卡里姆问候。卡里姆？好的，"}, {"type": "subtitle", "time": 585.269, "timestamp": "00:09:45", "text": "我的装备找回来了。如果你看到他，"}, {"type": "subtitle", "time": 588.55, "timestamp": "00:09:48", "text": "替我谢谢他。"}, {"type": "subtitle", "time": 591.99, "timestamp": "00:09:51", "text": "最后。是的，我的东西都拿到了。"}, {"type": "subtitle", "time": 594.87, "timestamp": "00:09:54", "text": "后退。好的。"}, {"type": "subtitle", "time": 597.07, "timestamp": "00:09:57", "text": "那么，让我来说说……"}]
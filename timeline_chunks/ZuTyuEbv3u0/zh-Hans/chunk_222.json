[{"type": "subtitle", "time": 13320.87, "timestamp": "03:42:00", "text": "比如本地汽车之类的，还有 Uber、Ola 等等"}, {"type": "subtitle", "time": 13323.349, "timestamp": "03:42:03", "text": "东西好像便宜了很多。"}, {"type": "subtitle", "time": 13327.67, "timestamp": "03:42:07", "text": "我心想，为什么会这样呢？"}, {"type": "subtitle", "time": 13330.229, "timestamp": "03:42:10", "text": "好吧好吧，你知道吗，让我……让我……呃"}, {"type": "subtitle", "time": 13332.55, "timestamp": "03:42:12", "text": "说到那些，让我讲讲这个吧。"}, {"type": "subtitle", "time": 13335.83, "timestamp": "03:42:15", "text": "我所在州发生的问题"}, {"type": "subtitle", "time": 13338.71, "timestamp": "03:42:18", "text": "我知道，所以基本上，呃，我们"}, {"type": "subtitle", "time": 13343.03, "timestamp": "03:42:23", "text": "车里有墙和酸奶，对吧？"}, {"type": "subtitle", "time": 13350.229, "timestamp": "03:42:30", "text": "像这些汽车车主一样，他们有"}, {"type": "subtitle", "time": 13352.309, "timestamp": "03:42:32", "text": "就像这样迅速地进行抗议一样"}, {"type": "subtitle", "time": 13354.229, "timestamp": "03:42:34", "text": "东西把所有顾客都赶走了"}, {"type": "subtitle", "time": 13357.91, "timestamp": "03:42:37", "text": "互联网上的东西和人们"}, {"type": "subtitle", "time": 13359.59, "timestamp": "03:42:39", "text": "因为他们的高……而嘲讽他们"}, {"type": "subtitle", "time": 13364.389, "timestamp": "03:42:44", "text": "好吧，你知道吗？让我来告诉你"}, {"type": "subtitle", "time": 13366.229, "timestamp": "03:42:46", "text": "你对这辆车简直着迷了"}, {"type": "subtitle", "time": 13369.429, "timestamp": "03:42:49", "text": "我有互联网"}, {"type": "subtitle", "time": 13371.19, "timestamp": "03:42:51", "text": "以前，在那些日子里，我不知道"}, {"type": "subtitle", "time": 13373.269, "timestamp": "03:42:53", "text": "呃，我该怎么去我的大学呢？"}, {"type": "subtitle", "time": 13375.11, "timestamp": "03:42:55", "text": "正确地，因为这就像我真的……"}, {"type": "subtitle", "time": 13378.63, "timestamp": "03:42:58", "text": "在另一个城市。"}]
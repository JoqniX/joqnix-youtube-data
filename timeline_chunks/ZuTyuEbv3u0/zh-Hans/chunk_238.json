[{"type": "subtitle", "time": 14281.269, "timestamp": "03:58:01", "text": "邪恶8"}, {"type": "subtitle", "time": 14283.59, "timestamp": "03:58:03", "text": "我觉得那一个人比另一个人要喜欢得多。"}, {"type": "subtitle", "time": 14295.79, "timestamp": "03:58:15", "text": "太疯狂了，我的天哪，我知道，对吧？"}, {"type": "subtitle", "time": 14297.71, "timestamp": "03:58:17", "text": "是的。"}, {"type": "subtitle", "time": 14303.269, "timestamp": "03:58:23", "text": "有些人的想法，就像我一样。"}, {"type": "subtitle", "time": 14304.95, "timestamp": "03:58:24", "text": "我班上有些人真的不"}, {"type": "subtitle", "time": 14307.269, "timestamp": "03:58:27", "text": "他们有一台笔记本电脑，但他们会买"}, {"type": "subtitle", "time": 14312.189, "timestamp": "03:58:32", "text": "我是什么"}, {"type": "subtitle", "time": 14315.75, "timestamp": "03:58:35", "text": "我可以买一部iPhone吗？为什么不买一个"}, {"type": "subtitle", "time": 14318.469, "timestamp": "03:58:38", "text": "笔记本电脑？什么"}, {"type": "subtitle", "time": 14319.99, "timestamp": "03:58:39", "text": "问题是，如果他们愿意，他们可以买。"}, {"type": "subtitle", "time": 14321.51, "timestamp": "03:58:41", "text": "问问他们的父母，他们会从哪里买。"}, {"type": "subtitle", "time": 14323.67, "timestamp": "03:58:43", "text": "对他们来说。但你知道，就像你知道的那样"}, {"type": "subtitle", "time": 14325.269, "timestamp": "03:58:45", "text": "你不能一直用笔记本电脑炫耀"}, {"type": "subtitle", "time": 14327.11, "timestamp": "03:58:47", "text": "时间到了吗？"}, {"type": "subtitle", "time": 14329.51, "timestamp": "03:58:49", "text": "是的。"}, {"type": "subtitle", "time": 14331.189, "timestamp": "03:58:51", "text": "但是你可以炫耀一下你的手机。所以"}, {"type": "subtitle", "time": 14334.71, "timestamp": "03:58:54", "text": "是啊，因为他们肯定会这么做。"}]
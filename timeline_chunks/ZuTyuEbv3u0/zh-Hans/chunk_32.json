[{"type": "subtitle", "time": 1922.23, "timestamp": "00:32:02", "text": "与人面对面交谈"}, {"type": "subtitle", "time": 1925.43, "timestamp": "00:32:05", "text": "每天都是如此。我将无法"}, {"type": "subtitle", "time": 1927.909, "timestamp": "00:32:07", "text": "拥抱我的朋友或家人，这意味着"}, {"type": "subtitle", "time": 1930.23, "timestamp": "00:32:10", "text": "对我来说意义重大。"}, {"type": "subtitle", "time": 1934.87, "timestamp": "00:32:14", "text": "是的。是的。我的天啊。你好。你好。"}, {"type": "subtitle", "time": 1938.07, "timestamp": "00:32:18", "text": "你好 KX。我们的下一位客人已经到了"}, {"type": "subtitle", "time": 1940.07, "timestamp": "00:32:20", "text": "这里。你好。"}, {"type": "subtitle", "time": 1943.909, "timestamp": "00:32:23", "text": "我的天哪。耶。你好。"}, {"type": "subtitle", "time": 1948.549, "timestamp": "00:32:28", "text": "你好。你有没有看到？你好吗？"}, {"type": "subtitle", "time": 1951.669, "timestamp": "00:32:31", "text": "对我来说，嗯，该怎么称呼它呢？我是"}, {"type": "chat", "time": 1952.608, "timestamp": "00:32:32", "author": "@calx_nyx", "avatar": "https://yt4.ggpht.com/XFPadkBWV-wDHemIdJAJ0ZlOnQHzuQJq3X3CrTt0JO7prEc9g-uiFft4EJRfG-ZfPUNyuCkI=s64-c-k-c0x00ffffff-no-rj", "message": "I was just drawing"}, {"type": "subtitle", "time": 1954.389, "timestamp": "00:32:34", "text": "我仍然想要一间单人房，但是"}, {"type": "subtitle", "time": 1958.63, "timestamp": "00:32:38", "text": "你知道，对于度规来说，但是双倍"}, {"type": "subtitle", "time": 1960.71, "timestamp": "00:32:40", "text": "房间也不错。比如不是双人间。"}, {"type": "subtitle", "time": 1963.83, "timestamp": "00:32:43", "text": "呃，呃，双人房，两人一间"}, {"type": "subtitle", "time": 1967.909, "timestamp": "00:32:47", "text": "房间也不错。但是呃呃但是"}, {"type": "subtitle", "time": 1970.71, "timestamp": "00:32:50", "text": "现在的问题是，如果是室友的话……"}, {"type": "subtitle", "time": 1973.029, "timestamp": "00:32:53", "text": "外国人，我必须确保他们是"}, {"type": "subtitle", "time": 1976.389, "timestamp": "00:32:56", "text": "我不介意直播和发出声音。"}, {"type": "subtitle", "time": 1978.63, "timestamp": "00:32:58", "text": "所有这些事。就是这样。"}]
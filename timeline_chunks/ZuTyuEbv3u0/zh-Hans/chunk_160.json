[{"type": "subtitle", "time": 9601.91, "timestamp": "02:40:01", "text": "兄弟，我买了好多游戏啊"}, {"type": "subtitle", "time": 9604.07, "timestamp": "02:40:04", "text": "团队只是为了未来进行合作而已"}, {"type": "subtitle", "time": 9607.469, "timestamp": "02:40:07", "text": "为了让它得到"}, {"type": "subtitle", "time": 9614.349, "timestamp": "02:40:14", "text": "收购公司。好的。好的。"}, {"type": "subtitle", "time": 9618.67, "timestamp": "02:40:18", "text": "改变得好像你了解一切一样"}, {"type": "subtitle", "time": 9622.95, "timestamp": "02:40:22", "text": "像大多数人一样，他们做些小事。"}, {"type": "subtitle", "time": 9627.51, "timestamp": "02:40:27", "text": "公司和很多时候的一切"}, {"type": "subtitle", "time": 9646.389, "timestamp": "02:40:46", "text": "你是怎么想到这个的？"}, {"type": "subtitle", "time": 9648.71, "timestamp": "02:40:48", "text": "这样做的想法就像是通过设置来实现的。"}, {"type": "subtitle", "time": 9652.55, "timestamp": "02:40:52", "text": "把所有东西都像自动的一样……"}, {"type": "subtitle", "time": 9654.95, "timestamp": "02:40:54", "text": "你知道那些正在播放的存档视频吗？"}, {"type": "subtitle", "time": 9658.469, "timestamp": "02:40:58", "text": "东西。哦，是那个啊。是的。所以，就是这样。"}]
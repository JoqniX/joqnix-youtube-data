[{"type": "subtitle", "time": 6301.9, "timestamp": "01:45:01", "text": "作品。我的 OBS 没有"}, {"type": "subtitle", "time": 6313.709, "timestamp": "01:45:13", "text": "碰撞。好的。呃，前往"}, {"type": "subtitle", "time": 6322.109, "timestamp": "01:45:22", "text": "这个巨大的东西在哪儿？"}, {"type": "subtitle", "time": 6325.59, "timestamp": "01:45:25", "text": "让你爱上这辆巴士"}, {"type": "subtitle", "time": 6327.229, "timestamp": "01:45:27", "text": "在过去的几周里"}, {"type": "subtitle", "time": 6329.629, "timestamp": "01:45:29", "text": "流？"}, {"type": "subtitle", "time": 6331.55, "timestamp": "01:45:31", "text": "嗯？"}, {"type": "subtitle", "time": 6338.39, "timestamp": "01:45:38", "text": "阳台？我忘了。等等，什么是巨大的"}, {"type": "subtitle", "time": 6340.43, "timestamp": "01:45:40", "text": "再次进入？我的天啊。"}, {"type": "subtitle", "time": 6343.55, "timestamp": "01:45:43", "text": "等待。巨大的区间。"}, {"type": "subtitle", "time": 6347.87, "timestamp": "01:45:47", "text": "特伦露台。不是特伦斯。并非如此"}, {"type": "subtitle", "time": 6350.55, "timestamp": "01:45:50", "text": "我陷入了循环。"}, {"type": "subtitle", "time": 6352.83, "timestamp": "01:45:52", "text": "[音乐]"}, {"type": "subtitle", "time": 6355.149, "timestamp": "01:45:55", "text": "等等，这在哪儿？"}, {"type": "subtitle", "time": 6358.32, "timestamp": "01:45:58", "text": "地方？我把这一切都忘了。"}]
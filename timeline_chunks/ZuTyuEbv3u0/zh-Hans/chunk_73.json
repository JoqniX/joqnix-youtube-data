[{"type": "subtitle", "time": 4381.35, "timestamp": "01:13:01", "text": "我就是那种会……的人"}, {"type": "subtitle", "time": 4383.83, "timestamp": "01:13:03", "text": "害怕的。如果有人注意到某种……"}, {"type": "subtitle", "time": 4387.35, "timestamp": "01:13:07", "text": "东西？所以，我都是自己一个人做事。"}, {"type": "subtitle", "time": 4390.47, "timestamp": "01:13:10", "text": "所以，我大概有"}, {"type": "subtitle", "time": 4393.669, "timestamp": "01:13:13", "text": "我还有30个小时完成作业。哦"}, {"type": "subtitle", "time": 4395.91, "timestamp": "01:13:15", "text": "我的上帝。睡觉、吃饭，一切照常进行。"}, {"type": "subtitle", "time": 4399.99, "timestamp": "01:13:19", "text": "好的。中间要好好休息。是的。当然。"}, {"type": "subtitle", "time": 4402.07, "timestamp": "01:13:22", "text": "是的。是的。"}, {"type": "subtitle", "time": 4404.59, "timestamp": "01:13:24", "text": "但是，总的来说，今天真是太棒了！"}, {"type": "subtitle", "time": 4407.91, "timestamp": "01:13:27", "text": "超级好玩。谢谢你，赛。一直以来"}, {"type": "subtitle", "time": 4411.35, "timestamp": "01:13:31", "text": "虽然我很紧张，但你让我"}, {"type": "subtitle", "time": 4413.75, "timestamp": "01:13:33", "text": "感觉就像在家里一样自在。谢谢"}, {"type": "subtitle", "time": 4415.91, "timestamp": "01:13:35", "text": "为此。我很高兴我能够做到"}, {"type": "subtitle", "time": 4419.83, "timestamp": "01:13:39", "text": "你感觉到了。是的。你好。你好。谢谢"}, {"type": "subtitle", "time": 4422.27, "timestamp": "01:13:42", "text": "谢谢你收留我。你好。谢谢光临"}, {"type": "subtitle", "time": 4426.63, "timestamp": "01:13:46", "text": "再见，祝你有个美好的夜晚，也祝你一切顺利。"}, {"type": "subtitle", "time": 4428.95, "timestamp": "01:13:48", "text": "尽你所能完成作业。"}, {"type": "subtitle", "time": 4437.189, "timestamp": "01:13:57", "text": "再见。保重。好的。"}, {"type": "subtitle", "time": 4439.39, "timestamp": "01:13:59", "text": "你也是。感谢"}]
[{"type": "subtitle", "time": 10802.469, "timestamp": "03:00:02", "text": "是的。你和他交谈过吗？"}, {"type": "subtitle", "time": 10804.95, "timestamp": "03:00:04", "text": "呃，我的意思是，不是我试着跟他说话，而是……"}, {"type": "subtitle", "time": 10806.95, "timestamp": "03:00:06", "text": "就像几秒钟后你会给我发一些东西"}, {"type": "subtitle", "time": 10809.269, "timestamp": "03:00:09", "text": "Instagram。"}, {"type": "subtitle", "time": 10818.59, "timestamp": "03:00:18", "text": "[音乐]"}, {"type": "subtitle", "time": 10828.71, "timestamp": "03:00:28", "text": "很多人都停下来了。"}, {"type": "subtitle", "time": 10832.309, "timestamp": "03:00:32", "text": "你知道，自从……"}, {"type": "subtitle", "time": 10835.83, "timestamp": "03:00:35", "text": "是的，并没有停止。"}, {"type": "subtitle", "time": 10838.389, "timestamp": "03:00:38", "text": "令人难过的是，有那么多人"}, {"type": "subtitle", "time": 10840.83, "timestamp": "03:00:40", "text": "我们当时就在那里。我仍然"}, {"type": "subtitle", "time": 10843.469, "timestamp": "03:00:43", "text": "想念男人。真是太……"}, {"type": "subtitle", "time": 10845.07, "timestamp": "03:00:45", "text": "有趣的。"}, {"type": "subtitle", "time": 10849.429, "timestamp": "03:00:49", "text": "我们的 kto kami。"}, {"type": "subtitle", "time": 10852.71, "timestamp": "03:00:52", "text": "我的意思是，我知道也许旅行我会把它寄出去。"}]
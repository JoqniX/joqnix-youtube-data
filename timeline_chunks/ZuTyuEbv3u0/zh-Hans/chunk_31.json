[{"type": "subtitle", "time": 1860.669, "timestamp": "00:31:00", "text": "我要晕倒了。"}, {"type": "subtitle", "time": 1863.269, "timestamp": "00:31:03", "text": "所以，是的，但是你知道，那里还有……"}, {"type": "subtitle", "time": 1865.669, "timestamp": "00:31:05", "text": "我有很多东西要买。"}, {"type": "subtitle", "time": 1867.909, "timestamp": "00:31:07", "text": "搬家确实需要花费很多钱"}, {"type": "subtitle", "time": 1872.87, "timestamp": "00:31:12", "text": "你。哦，你现在一个人住吗？哇。"}, {"type": "subtitle", "time": 1876.87, "timestamp": "00:31:16", "text": "呃，目前还没有，但是，嗯，很快了。"}, {"type": "subtitle", "time": 1880.63, "timestamp": "00:31:20", "text": "足够的。哦，真好，真好，真好。"}, {"type": "subtitle", "time": 1883.83, "timestamp": "00:31:23", "text": "是啊，我其实很害怕。我不是"}, {"type": "subtitle", "time": 1887.19, "timestamp": "00:31:27", "text": "我现在非常喜欢这个。等待。呃，"}, {"type": "subtitle", "time": 1889.51, "timestamp": "00:31:29", "text": "独处的时间，或者你更喜欢独处？"}, {"type": "subtitle", "time": 1893.59, "timestamp": "00:31:33", "text": "像室友那样？问题是我更喜欢"}, {"type": "subtitle", "time": 1895.43, "timestamp": "00:31:35", "text": "好吧，关于我，是这样的："}, {"type": "chat", "time": 1896.212, "timestamp": "00:31:36", "author": "@calx_nyx", "avatar": "https://yt4.ggpht.com/XFPadkBWV-wDHemIdJAJ0ZlOnQHzuQJq3X3CrTt0JO7prEc9g-uiFft4EJRfG-ZfPUNyuCkI=s64-c-k-c0x00ffffff-no-rj", "message": "yo tsukina and joqq"}, {"type": "subtitle", "time": 1899.269, "timestamp": "00:31:39", "text": "正确的？我喜欢我的隐私。我喜欢我的"}, {"type": "subtitle", "time": 1902.75, "timestamp": "00:31:42", "text": "房间。我喜欢独处的时间。就像我"}, {"type": "subtitle", "time": 1905.909, "timestamp": "00:31:45", "text": "只是不想住在整个"}, {"type": "subtitle", "time": 1909.19, "timestamp": "00:31:49", "text": "独自一人在家。就像我想走出我的"}, {"type": "subtitle", "time": 1913.75, "timestamp": "00:31:53", "text": "房间里还能见到人，你知道吗？而我"}, {"type": "subtitle", "time": 1915.59, "timestamp": "00:31:55", "text": "确实想聊天，但就像……"}, {"type": "subtitle", "time": 1917.909, "timestamp": "00:31:57", "text": "如果我开始独居，那就会……"}, {"type": "subtitle", "time": 1919.509, "timestamp": "00:31:59", "text": "对我来说，拥有它将很困难。"}]
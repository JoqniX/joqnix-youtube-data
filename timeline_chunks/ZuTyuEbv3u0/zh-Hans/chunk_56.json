[{"type": "subtitle", "time": 3364.99, "timestamp": "00:56:04", "text": "好的，我想这样应该可以了。"}, {"type": "subtitle", "time": 3368.47, "timestamp": "00:56:08", "text": "是的。哦，圣诞老人，你靠得太近了。太近了。"}, {"type": "subtitle", "time": 3369.71, "timestamp": "00:56:09", "text": "不，不"}, {"type": "subtitle", "time": 3372.589, "timestamp": "00:56:12", "text": "不。你知道吗？坚持，稍等。坚持，稍等。我"}, {"type": "subtitle", "time": 3379.27, "timestamp": "00:56:19", "text": "这？等等，我为什么要这么做？什么？为什么"}, {"type": "subtitle", "time": 3380.95, "timestamp": "00:56:20", "text": "是我做的吗？谁能告诉我为什么？"}, {"type": "subtitle", "time": 3384.069, "timestamp": "00:56:24", "text": "我做了那件事？我不知道。我无法接受"}, {"type": "subtitle", "time": 3385.71, "timestamp": "00:56:25", "text": "你的东西"}, {"type": "subtitle", "time": 3387.95, "timestamp": "00:56:27", "text": "向下。不能接受"}, {"type": "subtitle", "time": 3391.349, "timestamp": "00:56:31", "text": "它。为什么我不能彻底击败你"}, {"type": "subtitle", "time": 3393.71, "timestamp": "00:56:33", "text": "海？你"}, {"type": "subtitle", "time": 3397.67, "timestamp": "00:56:37", "text": "因为就像我的车正在看着"}, {"type": "subtitle", "time": 3400.23, "timestamp": "00:56:40", "text": "我的骑士。这就是你无法做到的原因。"}, {"type": "subtitle", "time": 3414.109, "timestamp": "00:56:54", "text": "繁荣。这些人是"}, {"type": "subtitle", "time": 3416.95, "timestamp": "00:56:56", "text": "无用。我得重新开始存钱了。"}]
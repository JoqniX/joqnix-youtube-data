[{"type": "subtitle", "time": 2710.63, "timestamp": "00:45:10", "text": "如果我那样做，你最喜欢什么？"}, {"type": "subtitle", "time": 2713.27, "timestamp": "00:45:13", "text": "前辈，有吃的吗？让我来分散你的注意力。"}, {"type": "subtitle", "time": 2715.19, "timestamp": "00:45:15", "text": "一点。"}, {"type": "subtitle", "time": 2718.67, "timestamp": "00:45:18", "text": "最喜欢的食物？嗯，等等。"}, {"type": "subtitle", "time": 2722.349, "timestamp": "00:45:22", "text": "嗯？不，不"}, {"type": "subtitle", "time": 2726.63, "timestamp": "00:45:26", "text": "不，你会进入敌方区域。哦，我的"}, {"type": "subtitle", "time": 2732.75, "timestamp": "00:45:32", "text": "哦"}, {"type": "subtitle", "time": 2737.75, "timestamp": "00:45:37", "text": "是的。我干掉了你们一个士兵。"}, {"type": "subtitle", "time": 2740.63, "timestamp": "00:45:40", "text": "好的。出色地，"}, {"type": "subtitle", "time": 2744.91, "timestamp": "00:45:44", "text": "真是个不错的消遣。什么？"}, {"type": "subtitle", "time": 2748.79, "timestamp": "00:45:48", "text": "哇。等等，你说什么？哦，好吧。看"}, {"type": "subtitle", "time": 2752.01, "timestamp": "00:45:52", "text": "派出你的士兵。现在它是我的了。"}, {"type": "subtitle", "time": 2759.43, "timestamp": "00:45:59", "text": "我什么都吃。我不是那种挑剔的人。"}]
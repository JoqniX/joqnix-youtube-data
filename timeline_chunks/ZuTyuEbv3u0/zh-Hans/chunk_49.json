[{"type": "subtitle", "time": 2940.549, "timestamp": "00:49:00", "text": "我现在知道了吗？"}, {"type": "subtitle", "time": 2942.829, "timestamp": "00:49:02", "text": "我大概应该走了"}, {"type": "subtitle", "time": 2945.99, "timestamp": "00:49:05", "text": "这里。但如果我去那里，那么"}, {"type": "subtitle", "time": 2948.71, "timestamp": "00:49:08", "text": "你会杀了我的。"}, {"type": "subtitle", "time": 2951.23, "timestamp": "00:49:11", "text": "嗯，我大概该走了。"}, {"type": "subtitle", "time": 2967.549, "timestamp": "00:49:27", "text": "我可以牺牲"}, {"type": "subtitle", "time": 2972.069, "timestamp": "00:49:32", "text": "这。但这可是一场豪赌。"}, {"type": "subtitle", "time": 2974.069, "timestamp": "00:49:34", "text": "哦，你心里有数了。等待，"}, {"type": "subtitle", "time": 2976.829, "timestamp": "00:49:36", "text": "你在计划什么吗？"}, {"type": "subtitle", "time": 2981.27, "timestamp": "00:49:41", "text": "是的，我正在努力。"}, {"type": "subtitle", "time": 2985.43, "timestamp": "00:49:45", "text": "你们打算怎么做？"}, {"type": "subtitle", "time": 2987.829, "timestamp": "00:49:47", "text": "你知道，我做不到那样。我不"}, {"type": "subtitle", "time": 2989.99, "timestamp": "00:49:49", "text": "畅聊高中相关话题。我当时就想，“哦，我的天哪！”"}, {"type": "subtitle", "time": 2993.19, "timestamp": "00:49:53", "text": "我的天，看看那个。我可以，我可以接受。"}, {"type": "subtitle", "time": 2999.43, "timestamp": "00:49:59", "text": "我喜欢，“哦，看，它闪闪发光。我要走了。”"}]
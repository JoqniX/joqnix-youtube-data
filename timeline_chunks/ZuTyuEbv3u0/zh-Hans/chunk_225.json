[{"type": "subtitle", "time": 13503.269, "timestamp": "03:45:03", "text": "这是真的。是啊，所以我当时才那样想"}, {"type": "subtitle", "time": 13506.309, "timestamp": "03:45:06", "text": "我真心想做真正有意义的事。"}, {"type": "subtitle", "time": 13509.99, "timestamp": "03:45:09", "text": "大学之类的，但我"}, {"type": "subtitle", "time": 13512.79, "timestamp": "03:45:12", "text": "我当时想，如果我被抓住了怎么办？"}, {"type": "subtitle", "time": 13515.429, "timestamp": "03:45:15", "text": "或者别的什么，或者我甚至能做到吗？"}, {"type": "subtitle", "time": 13518.71, "timestamp": "03:45:18", "text": "学习？我不想像在学校那样生活。"}, {"type": "subtitle", "time": 13520.55, "timestamp": "03:45:20", "text": "就是那种事。"}, {"type": "subtitle", "time": 13522.63, "timestamp": "03:45:22", "text": "如果按照我的理解呢？是的，"}, {"type": "subtitle", "time": 13524.229, "timestamp": "03:45:24", "text": "他们会，他们大多会注意到"}, {"type": "subtitle", "time": 13526.469, "timestamp": "03:45:26", "text": "那些大多不善交际的孩子"}, {"type": "subtitle", "time": 13535.51, "timestamp": "03:45:35", "text": "对，就是这个问题。"}, {"type": "subtitle", "time": 13537.91, "timestamp": "03:45:37", "text": "是的，一旦你上了大学，"}, {"type": "subtitle", "time": 13539.429, "timestamp": "03:45:39", "text": "你得待在一个群体里，"}, {"type": "subtitle", "time": 13541.51, "timestamp": "03:45:41", "text": "你就像可以肯定它是"}, {"type": "subtitle", "time": 13543.75, "timestamp": "03:45:43", "text": "还算友好。否则，他们就是"}, {"type": "subtitle", "time": 13546.75, "timestamp": "03:45:46", "text": "有些人喜欢"}, {"type": "subtitle", "time": 13549.99, "timestamp": "03:45:49", "text": "最终肯定会是这样。不太像太"}, {"type": "subtitle", "time": 13558.87, "timestamp": "03:45:58", "text": "是的。"}]
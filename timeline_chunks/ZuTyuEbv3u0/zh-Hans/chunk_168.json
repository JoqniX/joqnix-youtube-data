[{"type": "subtitle", "time": 10081.349, "timestamp": "02:48:01", "text": "就像影子一样，对吧？就像"}, {"type": "subtitle", "time": 10086.23, "timestamp": "02:48:06", "text": "阴影PNG轮廓图。是的。但"}, {"type": "subtitle", "time": 10089.75, "timestamp": "02:48:09", "text": "我意识到，由于艺术模型艺术是一种"}, {"type": "subtitle", "time": 10094.07, "timestamp": "02:48:14", "text": "嗯，呃，需要我们完全地"}, {"type": "subtitle", "time": 10096.23, "timestamp": "02:48:16", "text": "改版是因为它还没准备好。"}, {"type": "subtitle", "time": 10100.469, "timestamp": "02:48:20", "text": "2D 翼动瞬间。艺术品就在那里。"}, {"type": "subtitle", "time": 10104.15, "timestamp": "02:48:24", "text": "分开了，但并不像每件事那样妥善。"}, {"type": "subtitle", "time": 10107.349, "timestamp": "02:48:27", "text": "现在这件事必须完全分开了。"}, {"type": "subtitle", "time": 10111.51, "timestamp": "02:48:31", "text": "各个方面。所以我的计划是这样的"}, {"type": "subtitle", "time": 10114.15, "timestamp": "02:48:34", "text": "使模型完全完美"}, {"type": "subtitle", "time": 10117.349, "timestamp": "02:48:37", "text": "一切正常，V2 版本完整版。所以"}, {"type": "subtitle", "time": 10119.03, "timestamp": "02:48:39", "text": "至于索具方面，我可以"}, {"type": "subtitle", "time": 10121.51, "timestamp": "02:48:41", "text": "就像对待整个人生那样，"}, {"type": "subtitle", "time": 10124.63, "timestamp": "02:48:44", "text": "他们有那种复习资料，对吧？"}, {"type": "subtitle", "time": 10128.309, "timestamp": "02:48:48", "text": "呃，每次升级到 2.0 或 3.0 版本，我都知道他们"}, {"type": "subtitle", "time": 10130.71, "timestamp": "02:48:50", "text": "加上移动升级等等，"}, {"type": "subtitle", "time": 10133.349, "timestamp": "02:48:53", "text": "正确的？所以更便宜"}, {"type": "subtitle", "time": 10135.91, "timestamp": "02:48:55", "text": "就像转折点一样，就像"}, {"type": "subtitle", "time": 10139.03, "timestamp": "02:48:59", "text": "你知道该怎么做，对吧？我当时想的是"}]
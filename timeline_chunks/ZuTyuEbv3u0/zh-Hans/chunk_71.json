[{"type": "subtitle", "time": 4261.43, "timestamp": "01:11:01", "text": "是的。我会尽力回来。"}, {"type": "subtitle", "time": 4263.189, "timestamp": "01:11:03", "text": "来自日本的直播之类的。所以，我们"}, {"type": "subtitle", "time": 4266.149, "timestamp": "01:11:06", "text": "应该放在你的背包里。是的，如果"}, {"type": "subtitle", "time": 4269.03, "timestamp": "01:11:09", "text": "如果你不这么做，你知道，我会找到你的。"}, {"type": "subtitle", "time": 4271.55, "timestamp": "01:11:11", "text": "你自己。"}, {"type": "subtitle", "time": 4275.03, "timestamp": "01:11:15", "text": "是的，我喜欢回来。那是"}, {"type": "subtitle", "time": 4276.79, "timestamp": "01:11:16", "text": "听起来像是在威胁，但是"}, {"type": "subtitle", "time": 4278.79, "timestamp": "01:11:18", "text": "然后就像我大声说出来的那样，我当时"}, {"type": "subtitle", "time": 4280.07, "timestamp": "01:11:20", "text": "比如，“等等，这听起来不像……”"}, {"type": "subtitle", "time": 4289.35, "timestamp": "01:11:29", "text": "不过，谢谢你。"}, {"type": "subtitle", "time": 4291.27, "timestamp": "01:11:31", "text": "我，你知道，我为我感到骄傲。"}, {"type": "subtitle", "time": 4294.229, "timestamp": "01:11:34", "text": "确实如此，我真为你高兴。"}, {"type": "subtitle", "time": 4296.47, "timestamp": "01:11:36", "text": "我希望，你知道，一切顺利。"}, {"type": "subtitle", "time": 4300.87, "timestamp": "01:11:40", "text": "嗯，祝你玩得开心。最重要的是，"}, {"type": "subtitle", "time": 4305.47, "timestamp": "01:11:45", "text": "感到安全，注意安全，祝您旅途愉快。"}, {"type": "subtitle", "time": 4308.47, "timestamp": "01:11:48", "text": "谨防诈骗。"}, {"type": "subtitle", "time": 4313.03, "timestamp": "01:11:53", "text": "吃好吃的食物。是的。我将派你去"}, {"type": "subtitle", "time": 4314.189, "timestamp": "01:11:54", "text": "食物"}, {"type": "subtitle", "time": 4317.91, "timestamp": "01:11:57", "text": "照片告诉我，要像她一样。"}]
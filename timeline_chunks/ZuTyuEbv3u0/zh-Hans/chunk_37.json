[{"type": "subtitle", "time": 2222.39, "timestamp": "00:37:02", "text": "大多数情况下，在不同的国家。"}, {"type": "subtitle", "time": 2225.589, "timestamp": "00:37:05", "text": "是的。是的。"}, {"type": "subtitle", "time": 2229.43, "timestamp": "00:37:09", "text": "保重。是的。谨防诈骗。"}, {"type": "subtitle", "time": 2237.15, "timestamp": "00:37:17", "text": "[音乐]"}, {"type": "subtitle", "time": 2240.79, "timestamp": "00:37:20", "text": "是的。呃，我有没有告诉过你哪个"}, {"type": "subtitle", "time": 2244.55, "timestamp": "00:37:24", "text": "我要去的地方？前往"}, {"type": "subtitle", "time": 2247.55, "timestamp": "00:37:27", "text": "哦，我要去参加《早安美国》节目。呃，那就是我所在的地方"}, {"type": "subtitle", "time": 2251.63, "timestamp": "00:37:31", "text": "收到学校的通知了。所以，这就是一个"}, {"type": "subtitle", "time": 2254.87, "timestamp": "00:37:34", "text": "该地区因其炎热的天气而闻名。"}, {"type": "subtitle", "time": 2257.95, "timestamp": "00:37:37", "text": "弹簧之类的东西，onen 之类的东西。哦"}, {"type": "subtitle", "time": 2261.91, "timestamp": "00:37:41", "text": "我的。所以这就好比它不在东京，"}, {"type": "subtitle", "time": 2264.95, "timestamp": "00:37:44", "text": "我认为那是山区。"}, {"type": "subtitle", "time": 2266.47, "timestamp": "00:37:46", "text": "我当时还以为那是东京呢。我当时"}, {"type": "subtitle", "time": 2268.069, "timestamp": "00:37:48", "text": "就像你知道的，也许你知道你"}, {"type": "subtitle", "time": 2269.589, "timestamp": "00:37:49", "text": "会去泡温泉或者"}, {"type": "subtitle", "time": 2273.109, "timestamp": "00:37:53", "text": "比如你的假期或休息时间，但是"}, {"type": "subtitle", "time": 2275.67, "timestamp": "00:37:55", "text": "我的天哪，你最好去某个地方。"}, {"type": "subtitle", "time": 2277.67, "timestamp": "00:37:57", "text": "那里会有温泉。"}]
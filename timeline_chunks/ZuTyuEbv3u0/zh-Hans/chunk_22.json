[{"type": "subtitle", "time": 1320.95, "timestamp": "00:22:00", "text": "我钦佩你所做的一切，我钦佩……"}, {"type": "subtitle", "time": 1324.149, "timestamp": "00:22:04", "text": "你每天付出的努力"}, {"type": "subtitle", "time": 1327.83, "timestamp": "00:22:07", "text": "尽情做梦，与人交流，享受乐趣吧！"}, {"type": "subtitle", "time": 1329.75, "timestamp": "00:22:09", "text": "也一样。但这是你的梦想，"}, {"type": "subtitle", "time": 1332.87, "timestamp": "00:22:12", "text": "那是你最擅长的。"}, {"type": "subtitle", "time": 1335.75, "timestamp": "00:22:15", "text": "谢谢。"}, {"type": "subtitle", "time": 1340.95, "timestamp": "00:22:20", "text": "所以我觉得玩水上滑板真的很有趣，没错。"}, {"type": "subtitle", "time": 1345.63, "timestamp": "00:22:25", "text": "真有趣。我想念，好吧，我想念"}, {"type": "subtitle", "time": 1348.87, "timestamp": "00:22:28", "text": "是的，希望我很快就能回来。"}, {"type": "subtitle", "time": 1351.35, "timestamp": "00:22:31", "text": "也一样。你知道，那里有……"}, {"type": "subtitle", "time": 1354.39, "timestamp": "00:22:34", "text": "我这边有很多故事，呃，我"}, {"type": "subtitle", "time": 1357.27, "timestamp": "00:22:37", "text": "我认为应该向我的族人解释。"}, {"type": "subtitle", "time": 1362.07, "timestamp": "00:22:42", "text": "很快了，呃，但我不知道具体时间。"}, {"type": "subtitle", "time": 1364.149, "timestamp": "00:22:44", "text": "这很快就会发生。我不知道"}, {"type": "subtitle", "time": 1366.63, "timestamp": "00:22:46", "text": "如果这件事要在我的频道上发生，或者"}, {"type": "subtitle", "time": 1368.789, "timestamp": "00:22:48", "text": "我不知道这件事会不会发生。"}, {"type": "subtitle", "time": 1371.029, "timestamp": "00:22:51", "text": "Discord，但就像只有你一个人在捕捉"}, {"type": "subtitle", "time": 1374.47, "timestamp": "00:22:54", "text": "和我的族人在一起对我来说意义重大。"}]
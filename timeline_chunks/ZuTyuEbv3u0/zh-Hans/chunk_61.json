[{"type": "subtitle", "time": 3663.03, "timestamp": "01:01:03", "text": "感觉我根本跟不上，而且当"}, {"type": "subtitle", "time": 3665.43, "timestamp": "01:01:05", "text": "我突然意识到，我好像给你发过短信。"}, {"type": "subtitle", "time": 3668.15, "timestamp": "01:01:08", "text": "像字面意义上的平底锅恐慌那样惊慌失措"}, {"type": "subtitle", "time": 3671.589, "timestamp": "01:01:11", "text": "模式。我当时想，但我现在在这里，我还没有"}, {"type": "subtitle", "time": 3673.91, "timestamp": "01:01:13", "text": "组装好我的自行车。我很抱歉。而我当时"}, {"type": "subtitle", "time": 3675.67, "timestamp": "01:01:15", "text": "好的。"}, {"type": "subtitle", "time": 3680.15, "timestamp": "01:01:20", "text": "是的，我确实会抽出时间。这个月我"}, {"type": "subtitle", "time": 3683.589, "timestamp": "01:01:23", "text": "我想我会试试，但大概下个月吧"}, {"type": "subtitle", "time": 3686.95, "timestamp": "01:01:26", "text": "我会尽力睡着。"}, {"type": "subtitle", "time": 3689.829, "timestamp": "01:01:29", "text": "你知道吗，我当时就想，为什么这孩子会这样？"}, {"type": "subtitle", "time": 3693.27, "timestamp": "01:01:33", "text": "她忘了，而且她很累，所以就睡着了。"}, {"type": "subtitle", "time": 3696.309, "timestamp": "01:01:36", "text": "关闭或类似情况。我当时想的是喜欢"}, {"type": "subtitle", "time": 3698.23, "timestamp": "01:01:38", "text": "为您安排另一天或"}, {"type": "subtitle", "time": 3699.349, "timestamp": "01:01:39", "text": "某物。"}, {"type": "subtitle", "time": 3703.27, "timestamp": "01:01:43", "text": "我很难……保持沉默"}, {"type": "subtitle", "time": 3709.589, "timestamp": "01:01:49", "text": "触摸任何地方都行，嗯，是的，就是……"}, {"type": "subtitle", "time": 3712.95, "timestamp": "01:01:52", "text": "我真的很难保持在线状态。"}, {"type": "subtitle", "time": 3715.67, "timestamp": "01:01:55", "text": "其实我觉得我并不这么认为"}, {"type": "subtitle", "time": 3717.27, "timestamp": "01:01:57", "text": "就像你们大多数人都知道的那样，我"}]
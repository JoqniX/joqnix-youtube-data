[{"type": "subtitle", "time": 10141.99, "timestamp": "02:49:01", "text": "呃，就动作而言，我可以限制它。"}, {"type": "subtitle", "time": 10144.23, "timestamp": "02:49:04", "text": "然后随着时间的推移，当我积累了足够的财富之后"}, {"type": "subtitle", "time": 10146.469, "timestamp": "02:49:06", "text": "然后我就可以去找同一个索具工了。"}, {"type": "subtitle", "time": 10149.269, "timestamp": "02:49:09", "text": "然后就像，是的，升级我的动作，"}, {"type": "subtitle", "time": 10151.11, "timestamp": "02:49:11", "text": "全部添加或添加动画"}, {"type": "subtitle", "time": 10153.91, "timestamp": "02:49:13", "text": "某物。我注意到了。"}, {"type": "subtitle", "time": 10156.79, "timestamp": "02:49:16", "text": "前进。前进。流体流动性"}, {"type": "subtitle", "time": 10161.269, "timestamp": "02:49:21", "text": "是现有的那个，对吧？"}, {"type": "subtitle", "time": 10163.75, "timestamp": "02:49:23", "text": "这个。这是测试版。"}, {"type": "subtitle", "time": 10166.469, "timestamp": "02:49:26", "text": "现在，新的那个更像是"}, {"type": "subtitle", "time": 10167.71, "timestamp": "02:49:27", "text": "官方的"}, {"type": "subtitle", "time": 10170.95, "timestamp": "02:49:30", "text": "一。我从未正式出道。你敢相信吗？"}, {"type": "subtitle", "time": 10173.75, "timestamp": "02:49:33", "text": "它？我一直在直播"}, {"type": "subtitle", "time": 10177.349, "timestamp": "02:49:37", "text": "尚未出道。连米娅都首次使用了它。"}, {"type": "subtitle", "time": 10180.63, "timestamp": "02:49:40", "text": "就连小樱也首次使用了这招。听着，我爱"}, {"type": "subtitle", "time": 10182.469, "timestamp": "02:49:42", "text": "你。好的。"}, {"type": "subtitle", "time": 10184.309, "timestamp": "02:49:44", "text": "等等，你已经出道了吗？等等，你真的这么做了？"}, {"type": "subtitle", "time": 10187.51, "timestamp": "02:49:47", "text": "首次亮相，对吧？我的意思是，不。我只是"}, {"type": "subtitle", "time": 10189.03, "timestamp": "02:49:49", "text": "突然停止播放了"}, {"type": "subtitle", "time": 10194.269, "timestamp": "02:49:54", "text": "我们走吧。不"}, {"type": "subtitle", "time": 10196.87, "timestamp": "02:49:56", "text": "其中之一是大多数旧东西，比如"}, {"type": "subtitle", "time": 10198.87, "timestamp": "02:49:58", "text": "我把它存档是因为它有"}]
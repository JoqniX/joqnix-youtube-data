[{"type": "subtitle", "time": 1083.43, "timestamp": "00:18:03", "text": "你如何参加会议？"}, {"type": "subtitle", "time": 1086.39, "timestamp": "00:18:06", "text": "我必须找到公众。"}, {"type": "subtitle", "time": 1089.15, "timestamp": "00:18:09", "text": "好的。我需要找到"}, {"type": "subtitle", "time": 1091.99, "timestamp": "00:18:11", "text": "打手。你的故事，你的价值几何？"}, {"type": "subtitle", "time": 1095.11, "timestamp": "00:18:15", "text": "剧情发展？ 0%，对吧？零。"}, {"type": "subtitle", "time": 1096.63, "timestamp": "00:18:16", "text": "是的。"}, {"type": "subtitle", "time": 1099.19, "timestamp": "00:18:19", "text": "所以，你应该在这里，但你却不在。"}, {"type": "subtitle", "time": 1101.669, "timestamp": "00:18:21", "text": "不在这里。"}, {"type": "subtitle", "time": 1109.19, "timestamp": "00:18:29", "text": "是啊，我没看到你们。刷新。"}, {"type": "subtitle", "time": 1125.11, "timestamp": "00:18:45", "text": "那里。什么？这是节目。这是节目"}, {"type": "subtitle", "time": 1127.11, "timestamp": "00:18:47", "text": "疼痛。"}, {"type": "subtitle", "time": 1136.23, "timestamp": "00:18:56", "text": "选择。"}]
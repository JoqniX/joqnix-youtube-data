[{"type": "subtitle", "time": 1020.03, "timestamp": "00:17:00", "text": "僵尸。它是"}, {"type": "subtitle", "time": 1023.03, "timestamp": "00:17:03", "text": "美好的。好的，我确认击杀并拾取了战利品。"}, {"type": "subtitle", "time": 1025.909, "timestamp": "00:17:05", "text": "我确认击杀后再拾取战利品。反正，"}, {"type": "subtitle", "time": 1029.789, "timestamp": "00:17:09", "text": "我该怎么办？哦是的。点击"}, {"type": "subtitle", "time": 1032.309, "timestamp": "00:17:12", "text": "配对。寻找游戏。那不是"}, {"type": "subtitle", "time": 1036.35, "timestamp": "00:17:16", "text": "正确的。稍等片刻。好的。呃，好的。"}, {"type": "subtitle", "time": 1040.069, "timestamp": "00:17:20", "text": "雅克，选择雅克，"}, {"type": "subtitle", "time": 1042.47, "timestamp": "00:17:22", "text": "你正在尝试的游戏。好的。离开。我"}, {"type": "subtitle", "time": 1044.549, "timestamp": "00:17:24", "text": "不想加入他。我希望他"}, {"type": "subtitle", "time": 1047.51, "timestamp": "00:17:27", "text": "加入我。这到底是什么怪事？没有"}, {"type": "subtitle", "time": 1050.669, "timestamp": "00:17:30", "text": "邀请函。去。好的。你知道吗？"}, {"type": "subtitle", "time": 1052.71, "timestamp": "00:17:32", "text": "婚介服务。快速加入。我不想"}, {"type": "subtitle", "time": 1055.029, "timestamp": "00:17:35", "text": "这。寻找游戏。我不想这样"}, {"type": "subtitle", "time": 1056.87, "timestamp": "00:17:36", "text": "任何一个。这怪胎是什么？等待。做"}, {"type": "subtitle", "time": 1061.029, "timestamp": "00:17:41", "text": "这。这样做。将您的部分设为公开。"}, {"type": "subtitle", "time": 1063.669, "timestamp": "00:17:43", "text": "呃，但仅限朋友之间。是的。是的。"}, {"type": "subtitle", "time": 1066.31, "timestamp": "00:17:46", "text": "暂时公开即可。然后我将"}, {"type": "subtitle", "time": 1068.95, "timestamp": "00:17:48", "text": "改回仅限好友可见的私密模式。"}, {"type": "subtitle", "time": 1071.59, "timestamp": "00:17:51", "text": "公开。我会试着找找看。"}, {"type": "subtitle", "time": 1079.43, "timestamp": "00:17:59", "text": "哦，我把它公开了。"}]
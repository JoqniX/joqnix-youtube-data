[{"type": "subtitle", "time": 1261.909, "timestamp": "00:21:01", "text": "一直在直播。我一直在努力"}, {"type": "subtitle", "time": 1264.35, "timestamp": "00:21:04", "text": "把我认识和联系过的所有人联系起来"}, {"type": "subtitle", "time": 1269.11, "timestamp": "00:21:09", "text": "跟大家一起在这儿聊聊天，待一会儿。"}, {"type": "subtitle", "time": 1271.27, "timestamp": "00:21:11", "text": "和他们一起出去玩，这样我才能记得"}, {"type": "subtitle", "time": 1274.789, "timestamp": "00:21:14", "text": "人们如果喜欢来自日本的东西，那自"}, {"type": "subtitle", "time": 1279.19, "timestamp": "00:21:19", "text": "我七月份要去日本。是的，"}, {"type": "subtitle", "time": 1281.75, "timestamp": "00:21:21", "text": "我真的真的真的为你感到高兴，你……"}, {"type": "subtitle", "time": 1284.63, "timestamp": "00:21:24", "text": "你知道，就是做自己想做和喜欢的事。"}, {"type": "subtitle", "time": 1288.95, "timestamp": "00:21:28", "text": "也祝你一切顺利。"}, {"type": "subtitle", "time": 1292.87, "timestamp": "00:21:32", "text": "恭喜你直播到第78天！"}, {"type": "subtitle", "time": 1296.549, "timestamp": "00:21:36", "text": "说真的，你太棒了。你知道"}, {"type": "subtitle", "time": 1301.43, "timestamp": "00:21:41", "text": "那。我的天哪。嘿，我知道。我只是"}, {"type": "subtitle", "time": 1304.71, "timestamp": "00:21:44", "text": "在爱的慰藉中。"}, {"type": "subtitle", "time": 1307.029, "timestamp": "00:21:47", "text": "你知道，我真的非常非常自豪。"}, {"type": "subtitle", "time": 1309.35, "timestamp": "00:21:49", "text": "你的。我只能说这些了。"}, {"type": "subtitle", "time": 1311.51, "timestamp": "00:21:51", "text": "我觉得你好像也知道这一点。"}, {"type": "subtitle", "time": 1314.71, "timestamp": "00:21:54", "text": "我总是喜欢太多，但是呃"}, {"type": "subtitle", "time": 1317.029, "timestamp": "00:21:57", "text": "前辈，我为你感到非常非常骄傲。喜欢"}]
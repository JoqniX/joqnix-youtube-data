[{"type": "subtitle", "time": 3423.43, "timestamp": "00:57:03", "text": "好的。好的。我得做点什么。"}, {"type": "subtitle", "time": 3427.43, "timestamp": "00:57:07", "text": "因为我没有足够的时间。"}, {"type": "subtitle", "time": 3437.91, "timestamp": "00:57:17", "text": "什么？比赛最终以平局告终。"}, {"type": "subtitle", "time": 3439.829, "timestamp": "00:57:19", "text": "没关系。"}, {"type": "subtitle", "time": 3442.39, "timestamp": "00:57:22", "text": "该死。好的。那挺好的。那很好"}, {"type": "subtitle", "time": 3445.789, "timestamp": "00:57:25", "text": "结论。哇。那真是太棒了"}, {"type": "subtitle", "time": 3448.23, "timestamp": "00:57:28", "text": "结论对于一个不了解的人来说"}, {"type": "subtitle", "time": 3452.15, "timestamp": "00:57:32", "text": "知道如何将死对手。那真是太棒了"}, {"type": "subtitle", "time": 3453.829, "timestamp": "00:57:33", "text": "结论。"}, {"type": "subtitle", "time": 3457.99, "timestamp": "00:57:37", "text": "是的。我的天哪。你今天怎么样？哦"}, {"type": "subtitle", "time": 3460.789, "timestamp": "00:57:40", "text": "我的大人。你好。"}, {"type": "subtitle", "time": 3462.99, "timestamp": "00:57:42", "text": "你可以说你的"}, {"type": "subtitle", "time": 3467.349, "timestamp": "00:57:47", "text": "终于见到你了。你好，Arxar。"}, {"type": "subtitle", "time": 3469.349, "timestamp": "00:57:49", "text": "哎呀，好久不见了。你好吗"}, {"type": "subtitle", "time": 3476.39, "timestamp": "00:57:56", "text": "Alex 说：“嗯，好的，继续。”你"}, {"type": "subtitle", "time": 3479.51, "timestamp": "00:57:59", "text": "说出来。我点击了某个东西，然后"}]
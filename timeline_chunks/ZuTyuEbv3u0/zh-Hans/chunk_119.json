[{"type": "subtitle", "time": 7153.589, "timestamp": "01:59:13", "text": "错误的。好的，这意味着我们可以拥有"}, {"type": "subtitle", "time": 7155.669, "timestamp": "01:59:15", "text": "这里只属于我们。请告诉我"}, {"type": "subtitle", "time": 7171.51, "timestamp": "01:59:31", "text": "请稍等。不，不是这个。"}, {"type": "subtitle", "time": 7172.629, "timestamp": "01:59:32", "text": "等等，等等，等等，等等，等等。在哪里？"}, {"type": "subtitle", "time": 7174.75, "timestamp": "01:59:34", "text": "甚至鬼魂"}, {"type": "subtitle", "time": 7177.75, "timestamp": "01:59:37", "text": "再次？我混乱的大脑无法处理"}, {"type": "subtitle", "time": 7183.31, "timestamp": "01:59:43", "text": "在哪里"}, {"type": "subtitle", "time": 7185.229, "timestamp": "01:59:45", "text": "[音乐]"}, {"type": "subtitle", "time": 7191.75, "timestamp": "01:59:51", "text": "哦，是这个。知道了。是的。"}]
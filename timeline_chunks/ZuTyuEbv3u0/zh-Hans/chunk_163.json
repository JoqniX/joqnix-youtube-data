[{"type": "subtitle", "time": 9782.95, "timestamp": "02:43:02", "text": "出色地。所以我就想，好吧"}, {"type": "subtitle", "time": 9786.63, "timestamp": "02:43:06", "text": "我会收下，我会收下，而且"}, {"type": "subtitle", "time": 9790.55, "timestamp": "02:43:10", "text": "现在我自己来做。所以我就按顺序来"}, {"type": "subtitle", "time": 9793.59, "timestamp": "02:43:13", "text": "要使用那个模型，我现在得付费。"}, {"type": "subtitle", "time": 9796.07, "timestamp": "02:43:16", "text": "也是为了它。此外，我还要资助……"}, {"type": "subtitle", "time": 9798.389, "timestamp": "02:43:18", "text": "索具等等。"}, {"type": "subtitle", "time": 9802.79, "timestamp": "02:43:22", "text": "嗯。是的，那件事没成功。所以，我"}, {"type": "subtitle", "time": 9805.03, "timestamp": "02:43:25", "text": "当时我就想，好吧，我就做jatathan吧。"}, {"type": "subtitle", "time": 9807.03, "timestamp": "02:43:27", "text": "这是一笔巨款。这不可能。"}, {"type": "subtitle", "time": 9809.429, "timestamp": "02:43:29", "text": "即使行不通，我也会这么做。"}, {"type": "subtitle", "time": 9812.389, "timestamp": "02:43:32", "text": "这么做是因为有很多其他选择。"}, {"type": "subtitle", "time": 9815.67, "timestamp": "02:43:35", "text": "目标。不，是YouTube那个玩意儿。"}, {"type": "subtitle", "time": 9819.63, "timestamp": "02:43:39", "text": "那变成了呃，那结束了，得到了"}, {"type": "subtitle", "time": 9823.51, "timestamp": "02:43:43", "text": "完成了，而且我能够做到"}, {"type": "subtitle", "time": 9825.269, "timestamp": "02:43:45", "text": "拼贴画，和大家一起玩，"}, {"type": "subtitle", "time": 9827.429, "timestamp": "02:43:47", "text": "这一点也正在实现。"}, {"type": "subtitle", "time": 9829.67, "timestamp": "02:43:49", "text": "完成"}, {"type": "subtitle", "time": 9832.71, "timestamp": "02:43:52", "text": "都是因为我没直播，而且"}, {"type": "subtitle", "time": 9834.87, "timestamp": "02:43:54", "text": "上周休息了很长时间"}, {"type": "subtitle", "time": 9837.349, "timestamp": "02:43:57", "text": "年。我很高兴我的直播量增加了。"}]
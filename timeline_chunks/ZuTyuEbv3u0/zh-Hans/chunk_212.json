[{"type": "subtitle", "time": 12723.429, "timestamp": "03:32:03", "text": "想念一切。咖喱食物"}, {"type": "subtitle", "time": 12726.83, "timestamp": "03:32:06", "text": "鸡肉咖喱，还有桑巴酱"}, {"type": "subtitle", "time": 12729.51, "timestamp": "03:32:09", "text": "一切都很美味。哦，是的。是什么"}, {"type": "subtitle", "time": 12732.71, "timestamp": "03:32:12", "text": "你最喜欢的食物是什么？你刚才说"}, {"type": "subtitle", "time": 12735.03, "timestamp": "03:32:15", "text": "最喜欢的食物？"}, {"type": "subtitle", "time": 12738.87, "timestamp": "03:32:18", "text": "嗯，她喜欢吃什么？"}, {"type": "subtitle", "time": 12745.269, "timestamp": "03:32:25", "text": "你喜欢和什么一起吃"}, {"type": "subtitle", "time": 12747.03, "timestamp": "03:32:27", "text": "印度薄饼？"}, {"type": "subtitle", "time": 12754.71, "timestamp": "03:32:34", "text": "好的。"}, {"type": "subtitle", "time": 12757.51, "timestamp": "03:32:37", "text": "我记得很久以前，他……"}, {"type": "subtitle", "time": 12759.51, "timestamp": "03:32:39", "text": "说“是啊”。"}, {"type": "subtitle", "time": 12762.309, "timestamp": "03:32:42", "text": "我已经吃腻了米饭配桑巴酱。"}, {"type": "subtitle", "time": 12765.349, "timestamp": "03:32:45", "text": "东西。我想吃点别的。"}, {"type": "subtitle", "time": 12766.87, "timestamp": "03:32:46", "text": "东西。"}, {"type": "subtitle", "time": 12768.55, "timestamp": "03:32:48", "text": "我还在吃米饭，只是配着"}, {"type": "subtitle", "time": 12771.269, "timestamp": "03:32:51", "text": "现在有很多不同的事情，比如"}, {"type": "subtitle", "time": 12774.79, "timestamp": "03:32:54", "text": "一切都结束了，我就想，是啊，我24岁了，不。"}, {"type": "subtitle", "time": 12778.229, "timestamp": "03:32:58", "text": "24x，但一天三四次也行。"}]
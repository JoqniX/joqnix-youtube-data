[{"type": "subtitle", "time": 9241.469, "timestamp": "02:34:01", "text": "他们喜欢大喊大叫，到处乱跑。"}, {"type": "subtitle", "time": 9245.91, "timestamp": "02:34:05", "text": "是啊，通常很难等。"}, {"type": "subtitle", "time": 9247.03, "timestamp": "02:34:07", "text": "平均而言，你知道有多少"}, {"type": "subtitle", "time": 9248.59, "timestamp": "02:34:08", "text": "室友你可能会"}, {"type": "subtitle", "time": 9252.63, "timestamp": "02:34:12", "text": "得到？嗨，我想我所知道的就只有这些了，就像……"}, {"type": "subtitle", "time": 9256.349, "timestamp": "02:34:16", "text": "我的东西要租个合租房"}, {"type": "subtitle", "time": 9259.03, "timestamp": "02:34:19", "text": "就像我在YouTube上看到的那样，比如"}, {"type": "subtitle", "time": 9261.83, "timestamp": "02:34:21", "text": "就像一栋完整的房子会有……"}, {"type": "subtitle", "time": 9264.469, "timestamp": "02:34:24", "text": "还有一些空间，你也会有"}, {"type": "subtitle", "time": 9266.71, "timestamp": "02:34:26", "text": "房间"}, {"type": "subtitle", "time": 9267.71, "timestamp": "02:34:27", "text": "我不"}, {"type": "subtitle", "time": 9277.51, "timestamp": "02:34:37", "text": "实际上我只知道，它就像……"}, {"type": "subtitle", "time": 9280.23, "timestamp": "02:34:40", "text": "空间虽小，但关键在于"}, {"type": "subtitle", "time": 9283.83, "timestamp": "02:34:43", "text": "问题在于墙壁很薄。"}, {"type": "subtitle", "time": 9285.349, "timestamp": "02:34:45", "text": "正确的？"}, {"type": "subtitle", "time": 9297.75, "timestamp": "02:34:57", "text": "[音乐]"}, {"type": "subtitle", "time": 9299.75, "timestamp": "02:34:59", "text": "是的。与此同时，我还在外面挣扎求生。"}]
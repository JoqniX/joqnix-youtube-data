[{"type": "subtitle", "time": 181.83, "timestamp": "00:03:01", "text": "好的。一旦我摆脱困境，我们就会"}, {"type": "subtitle", "time": 183.309, "timestamp": "00:03:03", "text": "能够"}, {"type": "subtitle", "time": 207.67000000000002, "timestamp": "00:03:27", "text": "嘿，灵魂们。怎么样了？哦，公众。"}, {"type": "subtitle", "time": 211.27, "timestamp": "00:03:31", "text": "乔，我已经公开了。我们走吧。"}, {"type": "subtitle", "time": 215.19, "timestamp": "00:03:35", "text": "但即使你把它公开了，"}, {"type": "subtitle", "time": 218.47, "timestamp": "00:03:38", "text": "你为什么不能和我一起去？"}, {"type": "subtitle", "time": 220.47, "timestamp": "00:03:40", "text": "不，不，不，不，不。我可以做到"}, {"type": "subtitle", "time": 222.789, "timestamp": "00:03:42", "text": "促成交易。我可以牵线搭桥。不，那是"}, {"type": "subtitle", "time": 226.309, "timestamp": "00:03:46", "text": "但那是和其他玩家一起玩的时候。"}, {"type": "subtitle", "time": 228.589, "timestamp": "00:03:48", "text": "好的。好的。让我们来看看。"}, {"type": "subtitle", "time": 230.99, "timestamp": "00:03:50", "text": "呃，怪胎。"}, {"type": "subtitle", "time": 234.91, "timestamp": "00:03:54", "text": "呃，线上选项在哪里？"}]
[{"type": "subtitle", "time": 14101.99, "timestamp": "03:55:01", "text": "哦，我刚刚意识到只有两个。"}, {"type": "subtitle", "time": 14104.79, "timestamp": "03:55:04", "text": "还剩几天了，对吧？不，不是两个，是三个"}, {"type": "subtitle", "time": 14108.07, "timestamp": "03:55:08", "text": "三月还剩多少天？不，三月，五月"}, {"type": "subtitle", "time": 14110.87, "timestamp": "03:55:10", "text": "结尾。钱币。再见。"}, {"type": "subtitle", "time": 14113.51, "timestamp": "03:55:13", "text": "是的。五月即将结束。"}, {"type": "subtitle", "time": 14115.87, "timestamp": "03:55:15", "text": "该死。还有一个月。"}, {"type": "subtitle", "time": 14117.269, "timestamp": "03:55:17", "text": "[音乐]"}, {"type": "subtitle", "time": 14119.91, "timestamp": "03:55:19", "text": "我不想去。我不想"}, {"type": "subtitle", "time": 14122.95, "timestamp": "03:55:22", "text": "离开但是 O。我必须这样做。生活节奏"}, {"type": "subtitle", "time": 14125.83, "timestamp": "03:55:25", "text": "在。"}, {"type": "subtitle", "time": 14132.95, "timestamp": "03:55:32", "text": "伤心。但是，一旦你……，我们应该合作。"}, {"type": "subtitle", "time": 14134.55, "timestamp": "03:55:34", "text": "笔记本电脑什么的都有。一切都好。"}, {"type": "subtitle", "time": 14137.67, "timestamp": "03:55:37", "text": "不，从你那边来说。而我的结局也是"}, {"type": "subtitle", "time": 14139.59, "timestamp": "03:55:39", "text": "出色地。我们应该合作玩游戏"}, {"type": "subtitle", "time": 14143.03, "timestamp": "03:55:43", "text": "哦，现在不只是我一个人没有了。"}, {"type": "subtitle", "time": 14152.79, "timestamp": "03:55:52", "text": "是的，我也需要一台笔记本电脑。"}, {"type": "subtitle", "time": 14155.59, "timestamp": "03:55:55", "text": "我希望能买到好的。"}, {"type": "subtitle", "time": 14157.51, "timestamp": "03:55:57", "text": "但关键在于日语密钥"}, {"type": "subtitle", "time": 14159.189, "timestamp": "03:55:59", "text": "笔记本电脑将会是，它们将会拥有"}]
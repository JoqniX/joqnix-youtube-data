[{"type": "subtitle", "time": 9302.79, "timestamp": "02:35:02", "text": "和四个室友合住。"}, {"type": "subtitle", "time": 9306.23, "timestamp": "02:35:06", "text": "哦，就像，呃，你有个地堡"}, {"type": "subtitle", "time": 9309.75, "timestamp": "02:35:09", "text": "床和东西。嗯。不完全像"}, {"type": "subtitle", "time": 9312.71, "timestamp": "02:35:12", "text": "假寐。哦，就像不同的不同"}, {"type": "subtitle", "time": 9315.03, "timestamp": "02:35:15", "text": "房间。不，不，不。它就像一个"}, {"type": "subtitle", "time": 9317.51, "timestamp": "02:35:17", "text": "厨房，呃，我甚至都不能称之为厨房"}, {"type": "subtitle", "time": 9319.67, "timestamp": "02:35:19", "text": "大厅，因为它就像一个很小的m"}, {"type": "subtitle", "time": 9322.79, "timestamp": "02:35:22", "text": "拉屎。然后，然后是一间卧室。"}, {"type": "subtitle", "time": 9324.87, "timestamp": "02:35:24", "text": "哦，"}, {"type": "subtitle", "time": 9326.95, "timestamp": "02:35:26", "text": "所以，是的，实际上就像四，"}, {"type": "subtitle", "time": 9330.15, "timestamp": "02:35:30", "text": "五个人被困在一个房间里。"}, {"type": "subtitle", "time": 9333.11, "timestamp": "02:35:33", "text": "嗯"}, {"type": "subtitle", "time": 9334.429, "timestamp": "02:35:34", "text": "是的，你"}, {"type": "subtitle", "time": 9341.03, "timestamp": "02:35:41", "text": "你看，我确实在符文期间这么做了。"}, {"type": "subtitle", "time": 9343.67, "timestamp": "02:35:43", "text": "出生时间。"}, {"type": "subtitle", "time": 9347.27, "timestamp": "02:35:47", "text": "哦，对，就是你那次。哦，那段时光。"}, {"type": "subtitle", "time": 9349.429, "timestamp": "02:35:49", "text": "哦，那里"}, {"type": "subtitle", "time": 9351.75, "timestamp": "02:35:51", "text": "我真的回了趟家乡。我"}, {"type": "subtitle", "time": 9353.91, "timestamp": "02:35:53", "text": "真的从大学休学了"}, {"type": "subtitle", "time": 9355.91, "timestamp": "02:35:55", "text": "我请假只是为了享受……"}, {"type": "subtitle", "time": 9357.67, "timestamp": "02:35:57", "text": "合作。"}, {"type": "subtitle", "time": 9359.87, "timestamp": "02:35:59", "text": "我的天啊。"}]
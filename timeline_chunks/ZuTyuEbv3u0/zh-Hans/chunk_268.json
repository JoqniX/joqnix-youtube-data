[{"type": "subtitle", "time": 16081.67, "timestamp": "04:28:01", "text": "公开披露，如果被公开泄露……"}, {"type": "subtitle", "time": 16085.11, "timestamp": "04:28:05", "text": "无论如何，我都会"}, {"type": "subtitle", "time": 16087.83, "timestamp": "04:28:07", "text": "正式失去驾照，也就是我将"}, {"type": "subtitle", "time": 16090.87, "timestamp": "04:28:10", "text": "丢失模型。我正在努力工作"}, {"type": "subtitle", "time": 16094.149, "timestamp": "04:28:14", "text": "把我的所有权和一切都还给我。"}, {"type": "subtitle", "time": 16097.91, "timestamp": "04:28:17", "text": "是的，我的意思是，我尽了全力"}, {"type": "subtitle", "time": 16101.11, "timestamp": "04:28:21", "text": "融入到这个模式中，与艺术家们合作"}, {"type": "subtitle", "time": 16103.75, "timestamp": "04:28:23", "text": "正合我意。但是事情"}, {"type": "subtitle", "time": 16107.75, "timestamp": "04:28:27", "text": "是，嗯，是艺术，艺术，呃，模型艺术"}, {"type": "subtitle", "time": 16109.99, "timestamp": "04:28:29", "text": "需要稍微修改一下，以便……"}, {"type": "subtitle", "time": 16112.469, "timestamp": "04:28:32", "text": "可操纵。然后我就得花钱了。"}, {"type": "subtitle", "time": 16115.03, "timestamp": "04:28:35", "text": "关于索具。索具成本很高。"}, {"type": "subtitle", "time": 16117.429, "timestamp": "04:28:37", "text": "虚拟管家技术很昂贵。当然是这样。"}, {"type": "subtitle", "time": 16118.269, "timestamp": "04:28:38", "text": "有"}, {"type": "subtitle", "time": 16121.51, "timestamp": "04:28:41", "text": "那。我也要去日本。所以"}, {"type": "subtitle", "time": 16124.55, "timestamp": "04:28:44", "text": "我做 Jathon 的原因不仅仅是"}, {"type": "subtitle", "time": 16127.03, "timestamp": "04:28:47", "text": "关于该模型的众筹。它是"}, {"type": "subtitle", "time": 16129.83, "timestamp": "04:28:49", "text": "关于这个模型，意义重大。"}, {"type": "subtitle", "time": 16132.95, "timestamp": "04:28:52", "text": "为未来的我而设的未来。所以如果在"}, {"type": "subtitle", "time": 16135.349, "timestamp": "04:28:55", "text": "未来无论需要一年还是一年"}, {"type": "subtitle", "time": 16137.51, "timestamp": "04:28:57", "text": "我将从那里首次亮相。"}]
[{"type": "subtitle", "time": 10621.349, "timestamp": "02:57:01", "text": "但现在你感觉，是的，我可以"}, {"type": "subtitle", "time": 10623.59, "timestamp": "02:57:03", "text": "终于要去那里了。"}, {"type": "subtitle", "time": 10626.55, "timestamp": "02:57:06", "text": "除了日本以外，还是在日本境内？在日本？"}, {"type": "subtitle", "time": 10628.87, "timestamp": "02:57:08", "text": "请在日本。"}, {"type": "subtitle", "time": 10629.87, "timestamp": "02:57:09", "text": "哦。"}, {"type": "subtitle", "time": 10633.99, "timestamp": "02:57:13", "text": "呃，他们为什么不去"}, {"type": "subtitle", "time": 10637.07, "timestamp": "02:57:17", "text": "呃，名古屋或"}, {"type": "subtitle", "time": 10640.75, "timestamp": "02:57:20", "text": "某物？名古屋或东京"}, {"type": "subtitle", "time": 10644.55, "timestamp": "02:57:24", "text": "杂七杂八的东西。那些动漫呃动漫"}, {"type": "subtitle", "time": 10650.87, "timestamp": "02:57:30", "text": "对，而且你知道你的名字"}, {"type": "subtitle", "time": 10653.67, "timestamp": "02:57:33", "text": "电影里那个铁路装置对吧"}, {"type": "subtitle", "time": 10657.03, "timestamp": "02:57:37", "text": "楼梯 楼梯 是的，我想去"}, {"type": "subtitle", "time": 10666.92, "timestamp": "02:57:46", "text": "是的，我唯一能想到的地方。"}, {"type": "subtitle", "time": 10675.429, "timestamp": "02:57:55", "text": "哦，对了，说到你的名字，有"}, {"type": "subtitle", "time": 10678.309, "timestamp": "02:57:58", "text": "你最近在看什么动漫吗？"}]
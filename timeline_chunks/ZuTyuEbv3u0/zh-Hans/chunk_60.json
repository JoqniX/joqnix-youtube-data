[{"type": "subtitle", "time": 3600.75, "timestamp": "01:00:00", "text": "和"}, {"type": "subtitle", "time": 3603.67, "timestamp": "01:00:03", "text": "嗯，你还有回来的计划吗？"}, {"type": "subtitle", "time": 3606.309, "timestamp": "01:00:06", "text": "流媒体？你什么时候回来？如果"}, {"type": "subtitle", "time": 3607.99, "timestamp": "01:00:07", "text": "你有什么要宣布的吗？"}, {"type": "subtitle", "time": 3611.109, "timestamp": "01:00:11", "text": "你想制作的，你可以"}, {"type": "subtitle", "time": 3618.51, "timestamp": "01:00:18", "text": "所以，接下来的计划"}, {"type": "subtitle", "time": 3621.51, "timestamp": "01:00:21", "text": "返回并流式传输。"}, {"type": "subtitle", "time": 3624.39, "timestamp": "01:00:24", "text": "我确实在我的 Discord 服务器上发布了一条消息。"}, {"type": "subtitle", "time": 3627.109, "timestamp": "01:00:27", "text": "我说我打算直播非常"}, {"type": "subtitle", "time": 3631.63, "timestamp": "01:00:31", "text": "嗯，很快。那是一个月前的事了。"}, {"type": "subtitle", "time": 3635.349, "timestamp": "01:00:35", "text": "所以，我只是希望，你知道，我会"}, {"type": "subtitle", "time": 3639.109, "timestamp": "01:00:39", "text": "回来之后我就能抽出时间了。"}, {"type": "subtitle", "time": 3642.95, "timestamp": "01:00:42", "text": "开始直播。我很想，但是"}, {"type": "subtitle", "time": 3643.789, "timestamp": "01:00:43", "text": "它是"}, {"type": "subtitle", "time": 3647.71, "timestamp": "01:00:47", "text": "对我来说真的超级超级超级难。喜欢"}, {"type": "subtitle", "time": 3651.109, "timestamp": "01:00:51", "text": "今天我差点就忘了这件事。"}, {"type": "subtitle", "time": 3653.829, "timestamp": "01:00:53", "text": "你知道我必须陪在你身边。"}, {"type": "subtitle", "time": 3656.789, "timestamp": "01:00:56", "text": "两天时间就这样过去了，尽管……"}, {"type": "subtitle", "time": 3659.589, "timestamp": "01:00:59", "text": "就像我手机上的两个不同的提醒事项一样"}]
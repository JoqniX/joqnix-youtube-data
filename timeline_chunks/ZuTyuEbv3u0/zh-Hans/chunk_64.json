[{"type": "subtitle", "time": 3840.63, "timestamp": "01:04:00", "text": "能联系上让我非常开心"}, {"type": "subtitle", "time": 3843.19, "timestamp": "01:04:03", "text": "这么多人"}, {"type": "subtitle", "time": 3846.309, "timestamp": "01:04:06", "text": "与人交谈并娱乐"}, {"type": "subtitle", "time": 3848.23, "timestamp": "01:04:08", "text": "人们。它一直就像一个大"}, {"type": "subtitle", "time": 3850.95, "timestamp": "01:04:10", "text": "我想，这大概是我的一部分吧。并且始终"}, {"type": "subtitle", "time": 3852.789, "timestamp": "01:04:12", "text": "这些年，我真的非常感激。"}, {"type": "subtitle", "time": 3854.549, "timestamp": "01:04:14", "text": "你知道，就像你在那里的时候"}, {"type": "subtitle", "time": 3856.789, "timestamp": "01:04:16", "text": "人们一直在不断地查看"}, {"type": "subtitle", "time": 3860.63, "timestamp": "01:04:20", "text": "他们盯着你看，而且很喜欢看你。"}, {"type": "subtitle", "time": 3863.51, "timestamp": "01:04:23", "text": "你的内容，他们想点赞"}, {"type": "subtitle", "time": 3866.069, "timestamp": "01:04:26", "text": "参与你喜欢做的任何事"}, {"type": "subtitle", "time": 3868.23, "timestamp": "01:04:28", "text": "你的直播。他们喜欢，你知道，想要"}, {"type": "subtitle", "time": 3872.069, "timestamp": "01:04:32", "text": "和我一起打篮球。"}, {"type": "subtitle", "time": 3874.39, "timestamp": "01:04:34", "text": "你知道，这对我意义重大。"}, {"type": "subtitle", "time": 3877.27, "timestamp": "01:04:37", "text": "喜欢"}, {"type": "subtitle", "time": 3881.19, "timestamp": "01:04:41", "text": "我好想念它。我非常想念它。"}, {"type": "subtitle", "time": 3883.67, "timestamp": "01:04:43", "text": "我就说这么多吧。而且我喜欢这样做"}, {"type": "subtitle", "time": 3886.67, "timestamp": "01:04:46", "text": "这。我热爱成为虚拟直播的一份子。"}, {"type": "subtitle", "time": 3889.51, "timestamp": "01:04:49", "text": "行业。这让我非常非常开心"}, {"type": "subtitle", "time": 3893.43, "timestamp": "01:04:53", "text": "这让我感觉自己很特别。是的，我"}, {"type": "subtitle", "time": 3896.23, "timestamp": "01:04:56", "text": "还记得你第一次来的时候吗？"}, {"type": "subtitle", "time": 3898.19, "timestamp": "01:04:58", "text": "直播的时候，你有很多"}]
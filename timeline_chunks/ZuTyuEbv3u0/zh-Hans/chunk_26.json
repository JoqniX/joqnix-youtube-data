[{"type": "subtitle", "time": 1561.99, "timestamp": "00:26:01", "text": "相反，我以游客的身份游览了这个国家。你"}, {"type": "subtitle", "time": 1564.35, "timestamp": "00:26:04", "text": "我知道我不会去那里。"}, {"type": "subtitle", "time": 1567.59, "timestamp": "00:26:07", "text": "我们回来了吗？我们回来了吗？我们"}, {"type": "subtitle", "time": 1569.789, "timestamp": "00:26:09", "text": "后退？嗨，我们应该是"}, {"type": "subtitle", "time": 1573.43, "timestamp": "00:26:13", "text": "后退。我当时正在调整大小。"}, {"type": "subtitle", "time": 1576.95, "timestamp": "00:26:16", "text": "我在这里吗？你好。我在这里吗？哦，我没有"}, {"type": "subtitle", "time": 1579.19, "timestamp": "00:26:19", "text": "我感觉自己到了吗？还是我真的到了？我是谁？"}, {"type": "subtitle", "time": 1581.43, "timestamp": "00:26:21", "text": "妄想？是的。是的。哦，亲爱的保罗。"}, {"type": "subtitle", "time": 1585.11, "timestamp": "00:26:25", "text": "我会送你上去。一秒钟。"}, {"type": "subtitle", "time": 1588.07, "timestamp": "00:26:28", "text": "小组在哪里？知道了。"}, {"type": "chat", "time": 1588.933, "timestamp": "00:26:28", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "ara?"}, {"type": "subtitle", "time": 1591.11, "timestamp": "00:26:31", "text": "好的。你好。你应该在这里。是的，我们"}, {"type": "chat", "time": 1593.68, "timestamp": "00:26:33", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "we bac"}, {"type": "subtitle", "time": 1596.95, "timestamp": "00:26:36", "text": "回来了。耶。我们走吧。好的。所以，呃"}, {"type": "subtitle", "time": 1599.59, "timestamp": "00:26:39", "text": "原因：好的。但你会这么说吗？"}, {"type": "subtitle", "time": 1601.43, "timestamp": "00:26:41", "text": "因为你想家了？我不认为"}, {"type": "subtitle", "time": 1604.39, "timestamp": "00:26:44", "text": "我会想家，因为……我是个人物。"}, {"type": "subtitle", "time": 1608.87, "timestamp": "00:26:48", "text": "他搬过很多次家，我觉得那是因为"}, {"type": "subtitle", "time": 1611.35, "timestamp": "00:26:51", "text": "它已经不再是我的一部分了，所以我不会喜欢它。"}, {"type": "subtitle", "time": 1612.59, "timestamp": "00:26:52", "text": "想想"}, {"type": "subtitle", "time": 1615.029, "timestamp": "00:26:55", "text": "嗯，是的，我不认为我能得到。"}, {"type": "subtitle", "time": 1618.39, "timestamp": "00:26:58", "text": "虽然想家，但我认为你知道我"}, {"type": "subtitle", "time": 1619.909, "timestamp": "00:26:59", "text": "心中有一个特别的地方"}]
[{"type": "subtitle", "time": 8943.19, "timestamp": "02:29:03", "text": "我大部分时间都只是围绕着……转悠。"}, {"type": "subtitle", "time": 8946.469, "timestamp": "02:29:06", "text": "是啊，我当时只是在原地打转。"}, {"type": "subtitle", "time": 8948.87, "timestamp": "02:29:08", "text": "围绕 INV 块茎已经有一段时间了 2"}, {"type": "subtitle", "time": 8950.95, "timestamp": "02:29:10", "text": "好几年都没跟人说过话了"}, {"type": "subtitle", "time": 8953.51, "timestamp": "02:29:13", "text": "与他人接触或喜欢联系"}, {"type": "subtitle", "time": 8956.55, "timestamp": "02:29:16", "text": "还没和他们在一起。所以我觉得，嗯，就是这样"}, {"type": "subtitle", "time": 8958.389, "timestamp": "02:29:18", "text": "我会抓住机会喜欢"}, {"type": "subtitle", "time": 8960.15, "timestamp": "02:29:20", "text": "与我合作过的所有人联系"}, {"type": "subtitle", "time": 8962.55, "timestamp": "02:29:22", "text": "和。即使是团队合作，我们也会"}, {"type": "subtitle", "time": 8965.99, "timestamp": "02:29:25", "text": "把那些互动过的留着吧。我 我会 我"}, {"type": "subtitle", "time": 8968.87, "timestamp": "02:29:28", "text": "想着我们可以一起出去玩玩，"}, {"type": "subtitle", "time": 8971.349, "timestamp": "02:29:31", "text": "就像慢慢了解彼此一样，所以我们"}, {"type": "subtitle", "time": 8975.11, "timestamp": "02:29:35", "text": "未来是否有可能合作，或者是否可能？"}, {"type": "subtitle", "time": 8977.11, "timestamp": "02:29:37", "text": "就是合作，就是一起闲逛"}, {"type": "subtitle", "time": 8981.51, "timestamp": "02:29:41", "text": "朋友之类的。不是那样。和"}, {"type": "subtitle", "time": 8984.63, "timestamp": "02:29:44", "text": "是的，在这一切过程中，呃，就像当我"}, {"type": "subtitle", "time": 8987.03, "timestamp": "02:29:47", "text": "开始与日本那位合作，"}, {"type": "subtitle", "time": 8989.59, "timestamp": "02:29:49", "text": "韩国的那个，还有所有的一切，都在那里。"}, {"type": "subtitle", "time": 8992.55, "timestamp": "02:29:52", "text": "我注意到有些人确实"}, {"type": "subtitle", "time": 8994.87, "timestamp": "02:29:54", "text": "把它看作是一次交易性的合作。"}, {"type": "subtitle", "time": 8996.91, "timestamp": "02:29:56", "text": "好像必须很专业似的。"}, {"type": "subtitle", "time": 8998.95, "timestamp": "02:29:58", "text": "如果他们是专业人士，那么他们都是。"}]
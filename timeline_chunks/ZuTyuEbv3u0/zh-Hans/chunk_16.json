[{"type": "subtitle", "time": 962.87, "timestamp": "00:16:02", "text": "我会尽量参加。不不不不。"}, {"type": "subtitle", "time": 964.79, "timestamp": "00:16:04", "text": "你给我发了邀请，我必须接受"}, {"type": "subtitle", "time": 967.99, "timestamp": "00:16:07", "text": "它。但我什么也没做。"}, {"type": "subtitle", "time": 970.55, "timestamp": "00:16:10", "text": "愚蠢的。那就像你加入我的游戏一样。"}, {"type": "subtitle", "time": 973.509, "timestamp": "00:16:13", "text": "正确的？我想加入你们的团队。"}, {"type": "subtitle", "time": 975.11, "timestamp": "00:16:15", "text": "您尝试加入的版块是"}, {"type": "subtitle", "time": 976.949, "timestamp": "00:16:16", "text": "普通难度。什么？"}, {"type": "subtitle", "time": 980.67, "timestamp": "00:16:20", "text": "停止。你加入了我。比如什么？哦，"}, {"type": "subtitle", "time": 982.67, "timestamp": "00:16:22", "text": "等待。"}, {"type": "subtitle", "time": 987.269, "timestamp": "00:16:27", "text": "继续。继续。给我，给我一个"}, {"type": "subtitle", "time": 990.15, "timestamp": "00:16:30", "text": "分钟。稍等片刻。好的。我会"}, {"type": "subtitle", "time": 992.71, "timestamp": "00:16:32", "text": "邀请您。是的。让我们来看看。让我们来看看。"}, {"type": "subtitle", "time": 994.87, "timestamp": "00:16:34", "text": "让我们来看看。我们绝对会这么做。如何"}, {"type": "subtitle", "time": 997.749, "timestamp": "00:16:37", "text": "对了，你邀请我了吗？我点击"}, {"type": "subtitle", "time": 1001.509, "timestamp": "00:16:41", "text": "当我打开菜单并点击时"}, {"type": "subtitle", "time": 1004.389, "timestamp": "00:16:44", "text": "您的姓名和付款按钮。我就像"}, {"type": "subtitle", "time": 1008.13, "timestamp": "00:16:48", "text": "在僵尸横行的混乱之中。"}, {"type": "subtitle", "time": 1018.31, "timestamp": "00:16:58", "text": "我简直要把这些家伙踢飞了。"}]
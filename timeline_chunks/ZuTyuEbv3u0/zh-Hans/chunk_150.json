[{"type": "subtitle", "time": 9001.349, "timestamp": "02:30:01", "text": "从他们那边直播。不，因为这里"}, {"type": "subtitle", "time": 9004.55, "timestamp": "02:30:04", "text": "我只想放松一下，悠闲自在。"}, {"type": "subtitle", "time": 9006.79, "timestamp": "02:30:06", "text": "现在轻松自在，呃，冷静点。是的。"}, {"type": "subtitle", "time": 9009.75, "timestamp": "02:30:09", "text": "是的。是的。是的。我这边也是一样。是的。"}, {"type": "subtitle", "time": 9014.349, "timestamp": "02:30:14", "text": "哦"}, {"type": "subtitle", "time": 9017.83, "timestamp": "02:30:17", "text": "男生。现在发生了很多事。"}, {"type": "subtitle", "time": 9021.23, "timestamp": "02:30:21", "text": "我仍然记不起他们的名字"}, {"type": "subtitle", "time": 9024.71, "timestamp": "02:30:24", "text": "我遇到的人，呃，有"}, {"type": "subtitle", "time": 9027.27, "timestamp": "02:30:27", "text": "现在人真多。"}, {"type": "subtitle", "time": 9037.75, "timestamp": "02:30:37", "text": "是的。我觉得我好像听到了四声"}, {"type": "subtitle", "time": 9039.27, "timestamp": "02:30:39", "text": "我想大概是几个月吧。"}, {"type": "subtitle", "time": 9041.27, "timestamp": "02:30:41", "text": "是的。呃，下个月将是最后一个月"}, {"type": "subtitle", "time": 9045.99, "timestamp": "02:30:45", "text": "应该是这个月吧。哦好的。好的。呃，所以"}, {"type": "subtitle", "time": 9050.07, "timestamp": "02:30:50", "text": "我要考试。呃，我在做第三个。"}, {"type": "subtitle", "time": 9052.389, "timestamp": "02:30:52", "text": "英国文学年。我正在做"}, {"type": "subtitle", "time": 9057.71, "timestamp": "02:30:57", "text": "现在它以远程学习的形式呈现。"}]
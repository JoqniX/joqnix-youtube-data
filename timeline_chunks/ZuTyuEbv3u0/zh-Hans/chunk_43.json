[{"type": "subtitle", "time": 2582.47, "timestamp": "00:43:02", "text": "美好的。稍等片刻。"}, {"type": "subtitle", "time": 2584.829, "timestamp": "00:43:04", "text": "我感觉到了吗？"}, {"type": "subtitle", "time": 2588.91, "timestamp": "00:43:08", "text": "相同的？让我这样做，这样我就可以看到了。"}, {"type": "subtitle", "time": 2592.87, "timestamp": "00:43:12", "text": "我也喜欢聊天。"}, {"type": "subtitle", "time": 2598.39, "timestamp": "00:43:18", "text": "这里。胸部不断弹出。那是"}, {"type": "subtitle", "time": 2607.829, "timestamp": "00:43:27", "text": "坏的。是的，我们回来了。我的意思是，我是"}, {"type": "subtitle", "time": 2610.95, "timestamp": "00:43:30", "text": "对不起。我刚才在调整苏琪娜的"}, {"type": "subtitle", "time": 2629.829, "timestamp": "00:43:49", "text": "是啊，我们太糟糕了。我们走吧。"}]
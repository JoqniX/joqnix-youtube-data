[{"type": "subtitle", "time": 1500.31, "timestamp": "00:25:00", "text": "想吃他们的食物，因为……"}, {"type": "subtitle", "time": 1503.51, "timestamp": "00:25:03", "text": "看起来真不错。看起来太棒了。"}, {"type": "subtitle", "time": 1506.07, "timestamp": "00:25:06", "text": "尤其喜欢动漫里的食物。"}, {"type": "subtitle", "time": 1510.31, "timestamp": "00:25:10", "text": "战争之类的。太棒了。我"}, {"type": "subtitle", "time": 1512.23, "timestamp": "00:25:12", "text": "一直一直都想去那里。我"}, {"type": "subtitle", "time": 1515.35, "timestamp": "00:25:15", "text": "感觉就像如果如果如果如果神奇地有一天"}, {"type": "subtitle", "time": 1518.909, "timestamp": "00:25:18", "text": "我资金充足，而且我有足够的"}, {"type": "subtitle", "time": 1521.99, "timestamp": "00:25:21", "text": "如果时间允许，我一定会去日本。"}, {"type": "subtitle", "time": 1523.59, "timestamp": "00:25:23", "text": "那不是我会去的地方"}, {"type": "subtitle", "time": 1526.87, "timestamp": "00:25:26", "text": "可能想住在这里，但是呃，我"}, {"type": "subtitle", "time": 1528.87, "timestamp": "00:25:28", "text": "肯定会以游客身份去参观。"}, {"type": "subtitle", "time": 1531.83, "timestamp": "00:25:31", "text": "多次。"}, {"type": "subtitle", "time": 1535.029, "timestamp": "00:25:35", "text": "是的，那很好。没多少人想要"}, {"type": "subtitle", "time": 1539.59, "timestamp": "00:25:39", "text": "住在这里，住在那里。是啊，因为……"}, {"type": "subtitle", "time": 1542.47, "timestamp": "00:25:42", "text": "太难了，你知道吗？你知道，就像在我的"}, {"type": "subtitle", "time": 1545.99, "timestamp": "00:25:45", "text": "头部我完全了解"}, {"type": "subtitle", "time": 1548.47, "timestamp": "00:25:48", "text": "成为公民会是什么感觉？"}, {"type": "subtitle", "time": 1551.75, "timestamp": "00:25:51", "text": "一个特定的国家以及它将如何……"}, {"type": "subtitle", "time": 1554.31, "timestamp": "00:25:54", "text": "喜欢去参观那个特定的地方"}, {"type": "subtitle", "time": 1557.669, "timestamp": "00:25:57", "text": "作为游客，我以游客的身份游览了这个国家，而且每"}, {"type": "subtitle", "time": 1559.909, "timestamp": "00:25:59", "text": "总之，我会说我会再次访问。"}]
[{"type": "subtitle", "time": 12360.309, "timestamp": "03:26:00", "text": "唯一的区别是我知道我拥有"}, {"type": "subtitle", "time": 12362.55, "timestamp": "03:26:02", "text": "比如用更好的英语进行搜索"}, {"type": "subtitle", "time": 12371.95, "timestamp": "03:26:11", "text": "是的。晚安。"}, {"type": "subtitle", "time": 12374.87, "timestamp": "03:26:14", "text": "你好。晚安，蒂娅。"}, {"type": "subtitle", "time": 12378.469, "timestamp": "03:26:18", "text": "哦，蒂娅。好了，蒂娅要睡觉了。"}, {"type": "subtitle", "time": 12381.11, "timestamp": "03:26:21", "text": "晚安。谢谢你的分享！"}, {"type": "subtitle", "time": 12383.99, "timestamp": "03:26:23", "text": "谢谢光临。"}, {"type": "subtitle", "time": 12385.67, "timestamp": "03:26:25", "text": "是啊，你知道吗？我感觉我感觉"}, {"type": "subtitle", "time": 12387.67, "timestamp": "03:26:27", "text": "等我完成期末考试的时候，可能"}, {"type": "subtitle", "time": 12390.469, "timestamp": "03:26:30", "text": "我或许会说马拉拉姆语。哦，"}, {"type": "subtitle", "time": 12391.309, "timestamp": "03:26:31", "text": "我们来吧"}, {"type": "subtitle", "time": 12394.309, "timestamp": "03:26:34", "text": "去。是的，因为呃，就像我的圈子是"}, {"type": "subtitle", "time": 12395.91, "timestamp": "03:26:35", "text": "像马拉拉姆一样的国家"}, {"type": "subtitle", "time": 12402.95, "timestamp": "03:26:42", "text": "啊，那真不错。即使现在我也喜欢"}, {"type": "subtitle", "time": 12405.8, "timestamp": "03:26:45", "text": "最后遇到了那个人。"}, {"type": "subtitle", "time": 12412.15, "timestamp": "03:26:52", "text": "好的。好的。"}, {"type": "subtitle", "time": 12414.87, "timestamp": "03:26:54", "text": "是的，我想，我的意思是，不是我"}, {"type": "subtitle", "time": 12416.15, "timestamp": "03:26:56", "text": "不介意学习多种"}]
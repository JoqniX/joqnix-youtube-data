[{"type": "subtitle", "time": 4865.59, "timestamp": "01:21:05", "text": "[音乐]"}, {"type": "subtitle", "time": 4867.95, "timestamp": "01:21:07", "text": "嗯，是的。"}, {"type": "subtitle", "time": 4872.91, "timestamp": "01:21:12", "text": "我会一直待到中午。"}, {"type": "subtitle", "time": 4876.189, "timestamp": "01:21:16", "text": "六月。六月。"}, {"type": "subtitle", "time": 4879.39, "timestamp": "01:21:19", "text": "嗯，你得到了"}, {"type": "subtitle", "time": 4883.07, "timestamp": "01:21:23", "text": "时间充裕，而且免费。请让我"}, {"type": "subtitle", "time": 4891.709, "timestamp": "01:21:31", "text": "呃，它不像……"}, {"type": "subtitle", "time": 4896.95, "timestamp": "01:21:36", "text": "专业合作或其他任何事宜"}, {"type": "subtitle", "time": 4901.39, "timestamp": "01:21:41", "text": "呃，任何事。更像是挂着"}, {"type": "subtitle", "time": 4903.79, "timestamp": "01:21:43", "text": "在我们的外面"}, {"type": "subtitle", "time": 4905.87, "timestamp": "01:21:45", "text": "更多案例"}, {"type": "subtitle", "time": 4908.91, "timestamp": "01:21:48", "text": "就像捕捉"}, {"type": "subtitle", "time": 4911.47, "timestamp": "01:21:51", "text": "向上。捕捉"}]
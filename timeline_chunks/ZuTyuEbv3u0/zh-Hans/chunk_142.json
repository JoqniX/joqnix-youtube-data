[{"type": "subtitle", "time": 8523.03, "timestamp": "02:22:03", "text": "地理，因为即使是生活"}, {"type": "subtitle", "time": 8525.03, "timestamp": "02:22:05", "text": "是的。我不该不知道自己的母语"}, {"type": "subtitle", "time": 8530.27, "timestamp": "02:22:10", "text": "地方。相同的。我也不知道。"}, {"type": "subtitle", "time": 8535.99, "timestamp": "02:22:15", "text": "是的。你好。呃，梅鲁拉·梅拉·暮光。"}, {"type": "subtitle", "time": 8538.309, "timestamp": "02:22:18", "text": "欢迎来到直播间。欢迎。这个人是"}, {"type": "subtitle", "time": 8540.309, "timestamp": "02:22:20", "text": "婚姻。欢迎。暗黑破坏神。欢迎。"}, {"type": "subtitle", "time": 8542.71, "timestamp": "02:22:22", "text": "清真食品。"}, {"type": "subtitle", "time": 8545.11, "timestamp": "02:22:25", "text": "大家最近怎么样？大家好吗？"}, {"type": "subtitle", "time": 8547.469, "timestamp": "02:22:27", "text": "正在做？这件精美的"}, {"type": "subtitle", "time": 8550.95, "timestamp": "02:22:30", "text": "晚上。是的。"}, {"type": "subtitle", "time": 8555.91, "timestamp": "02:22:35", "text": "嗯，艺术方面进展如何？"}, {"type": "subtitle", "time": 8557.15, "timestamp": "02:22:37", "text": "艺术怎么样？"}, {"type": "subtitle", "time": 8561.51, "timestamp": "02:22:41", "text": "东西？你当时在等什么？呃，你是……"}, {"type": "subtitle", "time": 8563.27, "timestamp": "02:22:43", "text": "我们当时想画漫画之类的东西，"}, {"type": "subtitle", "time": 8566.23, "timestamp": "02:22:46", "text": "正确的？如果我没记错的话。"}, {"type": "subtitle", "time": 8568.309, "timestamp": "02:22:48", "text": "嗯，是啊，我的意思是，但现在就像……"}, {"type": "subtitle", "time": 8570.389, "timestamp": "02:22:50", "text": "里面全是大学之类的东西。所以"}, {"type": "subtitle", "time": 8572.15, "timestamp": "02:22:52", "text": "是啊，我只要有时间就会画画。"}, {"type": "subtitle", "time": 8578.87, "timestamp": "02:22:58", "text": "我刚画完这幅画，大概画了3遍吧。"}]
[{"type": "subtitle", "time": 10740.99, "timestamp": "02:59:00", "text": "你好，PG。你好吗？你好"}, {"type": "subtitle", "time": 10747.71, "timestamp": "02:59:07", "text": "随机的"}, {"type": "subtitle", "time": 10750.469, "timestamp": "02:59:10", "text": "我们有一些关于日本的东西，比如"}, {"type": "subtitle", "time": 10752.309, "timestamp": "02:59:12", "text": "我们想在去之前去哪些地方？"}, {"type": "subtitle", "time": 10753.75, "timestamp": "02:59:13", "text": "我们打算试试。哦，对，我们确实聊过。"}, {"type": "subtitle", "time": 10756.469, "timestamp": "02:59:16", "text": "关于食物。"}, {"type": "subtitle", "time": 10758.309, "timestamp": "02:59:18", "text": "是的。你想尝试什么食物？"}, {"type": "subtitle", "time": 10760.87, "timestamp": "02:59:20", "text": "就像寿司一样。"}, {"type": "subtitle", "time": 10762.429, "timestamp": "02:59:22", "text": "是的，"}, {"type": "subtitle", "time": 10765.67, "timestamp": "02:59:25", "text": "章鱼烧天妇罗。所有那些花里胡哨的东西"}, {"type": "subtitle", "time": 10768.07, "timestamp": "02:59:28", "text": "我们在动漫和游戏中看到的食物"}, {"type": "subtitle", "time": 10772.11, "timestamp": "02:59:32", "text": "东西。兄弟，这让我想起了……"}, {"type": "subtitle", "time": 10775.59, "timestamp": "02:59:35", "text": "《黑道家族》你还记得这件事吗？他"}, {"type": "subtitle", "time": 10779.91, "timestamp": "02:59:39", "text": "把我还有米娅·卡巴克斯也放进去。"}, {"type": "subtitle", "time": 10781.67, "timestamp": "02:59:41", "text": "你知道，你知道，如果我能得到更好的"}, {"type": "subtitle", "time": 10784.23, "timestamp": "02:59:44", "text": "我的笔记本电脑容量足够运行Blender。"}, {"type": "subtitle", "time": 10787.59, "timestamp": "02:59:47", "text": "我将进入。"}, {"type": "subtitle", "time": 10789.429, "timestamp": "02:59:49", "text": "我们走吧。"}, {"type": "subtitle", "time": 10792.55, "timestamp": "02:59:52", "text": "是的，你应该这么做。你应该这么做。"}, {"type": "subtitle", "time": 10795.11, "timestamp": "02:59:55", "text": "我确实尝试过留下来，但我认为"}, {"type": "subtitle", "time": 10798.23, "timestamp": "02:59:58", "text": "他处于非活跃状态。我确实在网上看到过他。我"}, {"type": "subtitle", "time": 10799.75, "timestamp": "02:59:59", "text": "可以"}]
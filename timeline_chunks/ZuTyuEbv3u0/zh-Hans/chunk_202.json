[{"type": "subtitle", "time": 12120.469, "timestamp": "03:22:00", "text": "交易太容易或太难。但它是"}, {"type": "subtitle", "time": 12122.469, "timestamp": "03:22:02", "text": "易于管理。"}, {"type": "subtitle", "time": 12129.83, "timestamp": "03:22:09", "text": "可控。但如果我有机会去呢？"}, {"type": "subtitle", "time": 12137.03, "timestamp": "03:22:17", "text": "哦，等等。等待。到那时就不复存在了"}, {"type": "subtitle", "time": 12143.91, "timestamp": "03:22:23", "text": "哦，是的。所以，既然你要去"}, {"type": "subtitle", "time": 12146.15, "timestamp": "03:22:26", "text": "出去，你会回来吗？呃……"}, {"type": "subtitle", "time": 12149.91, "timestamp": "03:22:29", "text": "假期之类的？我会尝试"}, {"type": "subtitle", "time": 12153.03, "timestamp": "03:22:33", "text": "回来。是的。是的。就像如果是的话"}, {"type": "subtitle", "time": 12154.95, "timestamp": "03:22:34", "text": "比如一个月或一个半月。"}, {"type": "subtitle", "time": 12157.349, "timestamp": "03:22:37", "text": "一个月的时间跨度，因为问题是我必须"}, {"type": "subtitle", "time": 12159.51, "timestamp": "03:22:39", "text": "完成学位。不，我要走了。"}, {"type": "subtitle", "time": 12162.309, "timestamp": "03:22:42", "text": "没有认真完成第三年的学业。"}, {"type": "subtitle", "time": 12164.469, "timestamp": "03:22:44", "text": "因为我没有资格写这篇文章"}, {"type": "subtitle", "time": 12166.19, "timestamp": "03:22:46", "text": "第三年"}, {"type": "subtitle", "time": 12169.51, "timestamp": "03:22:49", "text": "现在别管那些文件了。兄弟，我应该"}, {"type": "subtitle", "time": 12171.429, "timestamp": "03:22:51", "text": "研究"}, {"type": "subtitle", "time": 12172.87, "timestamp": "03:22:52", "text": "积压工作。"}, {"type": "subtitle", "time": 12174.15, "timestamp": "03:22:54", "text": "[音乐]"}, {"type": "subtitle", "time": 12177.11, "timestamp": "03:22:57", "text": "猜猜我有多少个。多少？"}]
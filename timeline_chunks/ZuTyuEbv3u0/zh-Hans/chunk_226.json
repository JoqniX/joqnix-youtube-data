[{"type": "subtitle", "time": 13566.87, "timestamp": "03:46:06", "text": "你在那边过得怎么样？"}, {"type": "subtitle", "time": 13568.71, "timestamp": "03:46:08", "text": "你觉得你们那里的气候怎么样？"}, {"type": "subtitle", "time": 13571.349, "timestamp": "03:46:11", "text": "兄弟，你在吗？"}, {"type": "subtitle", "time": 13575.83, "timestamp": "03:46:15", "text": "我的天哪，下雨刮风了！"}, {"type": "subtitle", "time": 13579.75, "timestamp": "03:46:19", "text": "一切。我当时就想，哇。有没有"}, {"type": "subtitle", "time": 13581.75, "timestamp": "03:46:21", "text": "我知道现在有红色警报之类的。"}, {"type": "subtitle", "time": 13584.87, "timestamp": "03:46:24", "text": "事情还在继续，但我还是想知道接下来会发生什么。"}, {"type": "subtitle", "time": 13586.95, "timestamp": "03:46:26", "text": "湿的。兄弟，我也是，我们也有红色。"}, {"type": "subtitle", "time": 13590.95, "timestamp": "03:46:30", "text": "警报。是啊，就像降雨量一样。"}, {"type": "subtitle", "time": 13592.71, "timestamp": "03:46:32", "text": "就像快要发生洪水一样，"}, {"type": "subtitle", "time": 13596.15, "timestamp": "03:46:36", "text": "东西，然后我就想，我的天哪，所有这一切"}, {"type": "subtitle", "time": 13599.349, "timestamp": "03:46:39", "text": "就在我离开之前发生的事情"}, {"type": "subtitle", "time": 13603.349, "timestamp": "03:46:43", "text": "日本。我心想，“是啊，我的意思是，如果我"}, {"type": "subtitle", "time": 13605.99, "timestamp": "03:46:45", "text": "就像上次那样，当时发生了一场大……"}, {"type": "subtitle", "time": 13608.55, "timestamp": "03:46:48", "text": "这里发生洪水了，我不知道它会影响到我。"}, {"type": "subtitle", "time": 13611.11, "timestamp": "03:46:51", "text": "因为我住在靠近海边的城市"}, {"type": "subtitle", "time": 13614.349, "timestamp": "03:46:54", "text": "或者别的什么。”你是说那个人"}, {"type": "subtitle", "time": 13616.389, "timestamp": "03:46:56", "text": "哦，等等。我不能这么说。好的，"}, {"type": "subtitle", "time": 13618.63, "timestamp": "03:46:58", "text": "没关系。是的。对，就是那该死的那一个。"}]
[{"type": "subtitle", "time": 15180.55, "timestamp": "04:13:00", "text": "我的意思是，你不是唯一一个。"}, {"type": "subtitle", "time": 15182.87, "timestamp": "04:13:02", "text": "等等，除了我之外还有多少人？"}, {"type": "subtitle", "time": 15193.83, "timestamp": "04:13:13", "text": "我们拥有神话般的。"}, {"type": "subtitle", "time": 15196.79, "timestamp": "04:13:16", "text": "太多了。是的，差不多就是这样。"}, {"type": "subtitle", "time": 15200.189, "timestamp": "04:13:20", "text": "服务器是 VC 组。"}, {"type": "subtitle", "time": 15203.11, "timestamp": "04:13:23", "text": "好的。是啊，如果Nixie在的话，对吧？所以"}, {"type": "subtitle", "time": 15206.55, "timestamp": "04:13:26", "text": "太难了。下次再来吧"}, {"type": "subtitle", "time": 15209.269, "timestamp": "04:13:29", "text": "某物。是啊，你知道，就像在"}, {"type": "subtitle", "time": 15212.309, "timestamp": "04:13:32", "text": "昨天在视频会议中。所以基本上就像"}, {"type": "subtitle", "time": 15214.55, "timestamp": "04:13:34", "text": "当时有人在场。 Nexi也在那里。所以"}, {"type": "subtitle", "time": 15218.309, "timestamp": "04:13:38", "text": "你是纳兹基，对吧？"}, {"type": "subtitle", "time": 15224.79, "timestamp": "04:13:44", "text": "他就像是下一个，然后我们"}, {"type": "subtitle", "time": 15239.11, "timestamp": "04:13:59", "text": "是的。我也应该顺道去看看，价格会便宜一些。"}]
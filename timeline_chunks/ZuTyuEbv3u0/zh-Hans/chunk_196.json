[{"type": "subtitle", "time": 11761.269, "timestamp": "03:16:01", "text": "会帮帮我之类的。事情就是这样。"}, {"type": "subtitle", "time": 11763.51, "timestamp": "03:16:03", "text": "是的，他们可以把东西寄给他们。"}, {"type": "subtitle", "time": 11767.11, "timestamp": "03:16:07", "text": "以后不会再有钱了，或者别的什么。所以他们可以"}, {"type": "subtitle", "time": 11769.67, "timestamp": "03:16:09", "text": "或者即使那样把钱寄出去"}, {"type": "subtitle", "time": 11772.309, "timestamp": "03:16:12", "text": "学院的人，他们可以把它寄出去，或者"}, {"type": "subtitle", "time": 11775.99, "timestamp": "03:16:15", "text": "就像……呃，把它发给人们，就像……呃"}, {"type": "subtitle", "time": 11780.55, "timestamp": "03:16:20", "text": "是的，日本当地人，嗯，是的"}, {"type": "subtitle", "time": 11783.91, "timestamp": "03:16:23", "text": "然后他们可以把它兑换成日元。"}, {"type": "subtitle", "time": 11786.79, "timestamp": "03:16:26", "text": "如果喜欢，那就现在买给我吧。"}, {"type": "subtitle", "time": 11789.51, "timestamp": "03:16:29", "text": "我爸爸需要额外的东西，他喜欢"}, {"type": "subtitle", "time": 11793.19, "timestamp": "03:16:33", "text": "始终将其发送到本地"}, {"type": "subtitle", "time": 11796.63, "timestamp": "03:16:36", "text": "呃，学院现在就在这里，他们可以提供。"}, {"type": "subtitle", "time": 11800.229, "timestamp": "03:16:40", "text": "偿还剩余款项"}, {"type": "subtitle", "time": 11803.349, "timestamp": "03:16:43", "text": "我正在做这些事。是的，因为"}, {"type": "subtitle", "time": 11806.55, "timestamp": "03:16:46", "text": "货币贬值会带来痛苦。我当时就想，"}, {"type": "subtitle", "time": 11811.469, "timestamp": "03:16:51", "text": "是的，日元汇率好像在走低。"}, {"type": "subtitle", "time": 11814.16, "timestamp": "03:16:54", "text": "正确的？是的。"}, {"type": "subtitle", "time": 11816.349, "timestamp": "03:16:56", "text": "[音乐]"}, {"type": "subtitle", "time": 11818.429, "timestamp": "03:16:58", "text": "喜欢，"}]
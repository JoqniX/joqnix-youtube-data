[{"type": "subtitle", "time": 14341.429, "timestamp": "03:59:01", "text": "嗯，我希望如此。哦，是的。我刚刚意识到"}, {"type": "subtitle", "time": 14344.229, "timestamp": "03:59:04", "text": "比如你要出门之类的，"}, {"type": "subtitle", "time": 14346.71, "timestamp": "03:59:06", "text": "你身上会有那种大使馆人的气质。"}, {"type": "subtitle", "time": 14350.269, "timestamp": "03:59:10", "text": "必须经过那个大使馆。"}, {"type": "subtitle", "time": 14358.71, "timestamp": "03:59:18", "text": "那可真是件了不起的事。我希望我能得到"}, {"type": "subtitle", "time": 14360.63, "timestamp": "03:59:20", "text": "除此之外。"}, {"type": "subtitle", "time": 14363.03, "timestamp": "03:59:23", "text": "是的。你只需要在那里工作就行了。"}, {"type": "subtitle", "time": 14364.71, "timestamp": "03:59:24", "text": "你只需要好好喜欢这个州就行了。"}, {"type": "subtitle", "time": 14367.75, "timestamp": "03:59:27", "text": "你的收益等等。我想知道"}, {"type": "subtitle", "time": 14370.79, "timestamp": "03:59:30", "text": "如果是在印度或者像在……"}, {"type": "subtitle", "time": 14375.269, "timestamp": "03:59:35", "text": "那边是日本。呃，很可能是印度。"}, {"type": "subtitle", "time": 14381.75, "timestamp": "03:59:41", "text": "是的。然后他们会允许你"}, {"type": "subtitle", "time": 14386.03, "timestamp": "03:59:46", "text": "旅行。真的。真的。是的。好的。"}, {"type": "subtitle", "time": 14388.71, "timestamp": "03:59:48", "text": "好的。是的。希望一切顺利"}, {"type": "subtitle", "time": 14391.03, "timestamp": "03:59:51", "text": "实际上。"}, {"type": "subtitle", "time": 14395.03, "timestamp": "03:59:55", "text": "是的。就像希望那样。我应该"}, {"type": "subtitle", "time": 14398.15, "timestamp": "03:59:58", "text": "我会发送你提供的照片。"}]
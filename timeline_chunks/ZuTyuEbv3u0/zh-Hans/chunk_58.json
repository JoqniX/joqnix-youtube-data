[{"type": "subtitle", "time": 3481.589, "timestamp": "00:58:01", "text": "去了别的地方。就像字面意义上的"}, {"type": "subtitle", "time": 3485.109, "timestamp": "00:58:05", "text": "上面只写着：你是疯狂科学家吗？"}, {"type": "subtitle", "time": 3488.069, "timestamp": "00:58:08", "text": "而我，我想，你知道，得到"}, {"type": "subtitle", "time": 3490.789, "timestamp": "00:58:10", "text": "扔掉它。所以，我当时想的是……"}, {"type": "subtitle", "time": 3494.95, "timestamp": "00:58:14", "text": "点击类似“移除”的按钮"}, {"type": "subtitle", "time": 3498.309, "timestamp": "00:58:18", "text": "它把我带到了另一个网站。"}, {"type": "subtitle", "time": 3501.47, "timestamp": "00:58:21", "text": "哦，不。真不敢相信你竟然就这么"}, {"type": "subtitle", "time": 3504.63, "timestamp": "00:58:24", "text": "消失了。事实并非如此。"}, {"type": "subtitle", "time": 3507.71, "timestamp": "00:58:27", "text": "本来应该发生的，但是"}, {"type": "subtitle", "time": 3512.39, "timestamp": "00:58:32", "text": "嗯，是的，我真的很忙。"}, {"type": "subtitle", "time": 3515.75, "timestamp": "00:58:35", "text": "埃里克。但我只是希望，你知道，我"}, {"type": "subtitle", "time": 3518.309, "timestamp": "00:58:38", "text": "会有足够的时间回来"}, {"type": "subtitle", "time": 3520.75, "timestamp": "00:58:40", "text": "很快，至少像每周一次或"}, {"type": "subtitle", "time": 3523.069, "timestamp": "00:58:43", "text": "某物。所以，"}, {"type": "subtitle", "time": 3526.069, "timestamp": "00:58:46", "text": "是的。你好吗？怎么样？"}, {"type": "subtitle", "time": 3528.789, "timestamp": "00:58:48", "text": "你那边最近怎么样？"}, {"type": "subtitle", "time": 3531.589, "timestamp": "00:58:51", "text": "嗯，赛，你想说话还是……"}, {"type": "subtitle", "time": 3534.309, "timestamp": "00:58:54", "text": "还想再玩一局吗？哦，我没问题"}, {"type": "subtitle", "time": 3536.47, "timestamp": "00:58:56", "text": "任何事物。呃，我们有多少分钟？"}]
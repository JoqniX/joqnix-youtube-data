[{"type": "subtitle", "time": 12544.389, "timestamp": "03:29:04", "text": "人都有生活和各种事情。是的。"}, {"type": "subtitle", "time": 12546.71, "timestamp": "03:29:06", "text": "是的。我的意思是，至少，至少"}, {"type": "subtitle", "time": 12548.71, "timestamp": "03:29:08", "text": "你可以确认我是否还活着。"}, {"type": "subtitle", "time": 12550.469, "timestamp": "03:29:10", "text": "或者不是，因为你认识我的脸和我的"}, {"type": "subtitle", "time": 12561.11, "timestamp": "03:29:21", "text": "哦，是的。想当年你还是你的时候"}, {"type": "subtitle", "time": 12564.71, "timestamp": "03:29:24", "text": "我们对此毫不隐瞒。我的意思是，我是第一个"}, {"type": "subtitle", "time": 12566.15, "timestamp": "03:29:26", "text": "整个小组里只有一个人跟我说话"}, {"type": "subtitle", "time": 12567.55, "timestamp": "03:29:27", "text": "事物。"}, {"type": "subtitle", "time": 12570.71, "timestamp": "03:29:30", "text": "是啊，我当时就想，天哪，他们真是太……"}, {"type": "subtitle", "time": 12574.07, "timestamp": "03:29:34", "text": "勇敢的。我也应该学会喜欢爱情。"}, {"type": "subtitle", "time": 12576.389, "timestamp": "03:29:36", "text": "我的店，然后真的拍张照片"}, {"type": "subtitle", "time": 12578.55, "timestamp": "03:29:38", "text": "我自己、一些东西、自拍等等"}, {"type": "subtitle", "time": 12580.429, "timestamp": "03:29:40", "text": "东西。真是这样"}, {"type": "subtitle", "time": 12582.03, "timestamp": "03:29:42", "text": "凉爽的。"}, {"type": "subtitle", "time": 12584.63, "timestamp": "03:29:44", "text": "是的。没错，你是第一个。"}, {"type": "subtitle", "time": 12587.71, "timestamp": "03:29:47", "text": "在群聊中。她"}, {"type": "subtitle", "time": 12590.469, "timestamp": "03:29:50", "text": "谈话结束后，其他人也开始……"}, {"type": "subtitle", "time": 12593.429, "timestamp": "03:29:53", "text": "跟随。"}, {"type": "subtitle", "time": 12596.229, "timestamp": "03:29:56", "text": "我的意思是，是啊，你知道，我想要一些"}]
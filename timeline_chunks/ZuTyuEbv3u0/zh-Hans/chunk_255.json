[{"type": "subtitle", "time": 15303.429, "timestamp": "04:15:03", "text": "你认识这位名叫JC的泰米尔语虚拟主播吗？"}, {"type": "subtitle", "time": 15306.63, "timestamp": "04:15:06", "text": "好的。呃，我不知道。"}, {"type": "subtitle", "time": 15309.429, "timestamp": "04:15:09", "text": "呃，他不是虚拟主播，而是PNG主播。他是"}, {"type": "subtitle", "time": 15313.349, "timestamp": "04:15:13", "text": "他来自泰米尔纳德邦，嗯，我想我见过他。"}, {"type": "subtitle", "time": 15316.389, "timestamp": "04:15:16", "text": "他当时在做PNG管道之类的工作。"}, {"type": "subtitle", "time": 15318.79, "timestamp": "04:15:18", "text": "我记得我把他添加到VTuber名单里了。"}, {"type": "subtitle", "time": 15321.269, "timestamp": "04:15:21", "text": "还有很久以前的事情。"}, {"type": "subtitle", "time": 15323.67, "timestamp": "04:15:23", "text": "所以，是的，我想我还是联系一下吧。"}, {"type": "subtitle", "time": 15326.07, "timestamp": "04:15:26", "text": "我们聊了会儿天。于是我想，"}, {"type": "subtitle", "time": 15328.469, "timestamp": "04:15:28", "text": "是的，我们会有的，我会让他来的。"}, {"type": "subtitle", "time": 15330.229, "timestamp": "04:15:30", "text": "他好像在加拿大之类的。"}, {"type": "subtitle", "time": 15332.95, "timestamp": "04:15:32", "text": "它即将移动。所以当时"}, {"type": "subtitle", "time": 15335.429, "timestamp": "04:15:35", "text": "所以我就想，是啊，在你之前"}, {"type": "subtitle", "time": 15337.59, "timestamp": "04:15:37", "text": "趁你忙着电脑的时候赶紧行动，我会去拿的。"}, {"type": "subtitle", "time": 15339.51, "timestamp": "04:15:39", "text": "你在直播间，我们一起玩，就像这样"}, {"type": "subtitle", "time": 15342.71, "timestamp": "04:15:42", "text": "这就是我们聚会聊天的方式。"}, {"type": "subtitle", "time": 15351.51, "timestamp": "04:15:51", "text": "大家好，谢谢大家今天设置了DST。有"}, {"type": "subtitle", "time": 15353.269, "timestamp": "04:15:53", "text": "乐趣。"}, {"type": "subtitle", "time": 15357.11, "timestamp": "04:15:57", "text": "好的。你好。大家好。向……告别"}, {"type": "subtitle", "time": 15359.349, "timestamp": "04:15:59", "text": "DGSTG。还有，别忘了……"}]
[{"type": "subtitle", "time": 2102.47, "timestamp": "00:35:02", "text": "随着时间的推移，我们现在是很好的朋友，就像……"}, {"type": "subtitle", "time": 2105.75, "timestamp": "00:35:05", "text": "你说，但是，嗯，太阳能房也是"}, {"type": "subtitle", "time": 2107.91, "timestamp": "00:35:07", "text": "很好，因为你现在就能接受培训。"}, {"type": "subtitle", "time": 2110.95, "timestamp": "00:35:10", "text": "因为最终在两年后的9年"}, {"type": "subtitle", "time": 2113.589, "timestamp": "00:35:13", "text": "几个月的语言学习课程 I"}, {"type": "subtitle", "time": 2116.15, "timestamp": "00:35:16", "text": "我得自己找公寓，或者"}, {"type": "subtitle", "time": 2119.349, "timestamp": "00:35:19", "text": "如果我想待在这里，现在有什么地方可以住？"}, {"type": "subtitle", "time": 2122.87, "timestamp": "00:35:22", "text": "在日本更是如此。是的，就是这样。"}, {"type": "subtitle", "time": 2126.23, "timestamp": "00:35:26", "text": "这就像是单人模式的免费试用版。"}, {"type": "subtitle", "time": 2128.63, "timestamp": "00:35:28", "text": "等级。不像 Yeah 那样的免费试用。审判"}, {"type": "subtitle", "time": 2131.27, "timestamp": "00:35:31", "text": "体验独居生活。"}, {"type": "subtitle", "time": 2132.95, "timestamp": "00:35:32", "text": "是的。"}, {"type": "subtitle", "time": 2139.75, "timestamp": "00:35:39", "text": "懒散地玩就像"}, {"type": "subtitle", "time": 2142.23, "timestamp": "00:35:42", "text": "我非常清楚。好的。我知道……"}, {"type": "subtitle", "time": 2144.39, "timestamp": "00:35:44", "text": "事实上，这将非常困难"}, {"type": "subtitle", "time": 2146.31, "timestamp": "00:35:46", "text": "开始适应很多事情"}, {"type": "subtitle", "time": 2149.109, "timestamp": "00:35:49", "text": "你已经知道的事情。嗯，但是"}, {"type": "subtitle", "time": 2151.109, "timestamp": "00:35:51", "text": "慢慢地，就像你……"}, {"type": "subtitle", "time": 2153.19, "timestamp": "00:35:53", "text": "你真的真的真的想做这件事"}, {"type": "subtitle", "time": 2155.99, "timestamp": "00:35:55", "text": "我会喜欢的。即使是糟糕的时期，你也会"}, {"type": "subtitle", "time": 2157.99, "timestamp": "00:35:57", "text": "依然很喜欢。"}]
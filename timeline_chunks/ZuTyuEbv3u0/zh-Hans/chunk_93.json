[{"type": "subtitle", "time": 5598.47, "timestamp": "01:33:18", "text": "总能放松一下。"}, {"type": "subtitle", "time": 5601.43, "timestamp": "01:33:21", "text": "所以，现在最重要的是……"}, {"type": "subtitle", "time": 5604.669, "timestamp": "01:33:24", "text": "显然我的艺术家"}, {"type": "subtitle", "time": 5607.669, "timestamp": "01:33:27", "text": "妈妈，我为我的艺术家妈妈感到高兴。"}, {"type": "subtitle", "time": 5611.27, "timestamp": "01:33:31", "text": "她加入了一个团体，比如艺术团体之类的。"}, {"type": "subtitle", "time": 5613.11, "timestamp": "01:33:33", "text": "某物。一个大型艺术团体实际上是"}, {"type": "subtitle", "time": 5617.03, "timestamp": "01:33:37", "text": "非常非常大的。我很高兴她……"}, {"type": "subtitle", "time": 5621.149, "timestamp": "01:33:41", "text": "攀登更高峰。她值得拥有"}, {"type": "subtitle", "time": 5625.03, "timestamp": "01:33:45", "text": "它。她非常值得。"}, {"type": "subtitle", "time": 5629.11, "timestamp": "01:33:49", "text": "嗯，我很高兴她能进入更大的领域。"}, {"type": "subtitle", "time": 5632.47, "timestamp": "01:33:52", "text": "现在，大型 YouTuber 的工作地点更大了。"}, {"type": "subtitle", "time": 5636.31, "timestamp": "01:33:56", "text": "以及所有的一切。她值得拥有很多。"}]
[{"type": "subtitle", "time": 10991.19, "timestamp": "03:03:11", "text": "你好。等等，你没听到我说话吗？哦，我的"}, {"type": "subtitle", "time": 10994.07, "timestamp": "03:03:14", "text": "上帝。我什么时候被禁言的？我的天啊。"}, {"type": "subtitle", "time": 10996.469, "timestamp": "03:03:16", "text": "等等，你静音了吗？我以为我以为呃"}, {"type": "subtitle", "time": 10998.15, "timestamp": "03:03:18", "text": "可能是雨水像断了线一样"}, {"type": "subtitle", "time": 11001.03, "timestamp": "03:03:21", "text": "我的网络或其他什么原因。不，等等。我如何"}, {"type": "subtitle", "time": 11002.95, "timestamp": "03:03:22", "text": "一整天都被静音了吗？什么？不，不是"}, {"type": "subtitle", "time": 11005.67, "timestamp": "03:03:25", "text": "一整天。我什么时候被静音的？"}, {"type": "subtitle", "time": 11009.19, "timestamp": "03:03:29", "text": "不，我说的是 Lumi。啊。哦"}, {"type": "subtitle", "time": 11010.349, "timestamp": "03:03:30", "text": "我的"}, {"type": "subtitle", "time": 11013.429, "timestamp": "03:03:33", "text": "上帝。不用担心。不用担心。"}, {"type": "subtitle", "time": 11016.389, "timestamp": "03:03:36", "text": "好的。你好。只有这里静音吗？还是只有其他地方静音？"}, {"type": "subtitle", "time": 11018.95, "timestamp": "03:03:38", "text": "溪流也一样吗？什么？哦，原来是……"}, {"type": "subtitle", "time": 11021.429, "timestamp": "03:03:41", "text": "我把麦克风静音了，因为我当时就想：呃……"}, {"type": "subtitle", "time": 11024.63, "timestamp": "03:03:44", "text": "想捡起什么东西。它倒了"}, {"type": "subtitle", "time": 11027.91, "timestamp": "03:03:47", "text": "我的耳机不是耳塞式耳机。"}, {"type": "subtitle", "time": 11029.99, "timestamp": "03:03:49", "text": "那东西松动了，然后就掉下来了。"}, {"type": "subtitle", "time": 11033.51, "timestamp": "03:03:53", "text": "于是我向下伸手去拿。所以麦克风静音了。"}, {"type": "subtitle", "time": 11037.269, "timestamp": "03:03:57", "text": "按钮好像被按了一下。哦，"}, {"type": "subtitle", "time": 11038.469, "timestamp": "03:03:58", "text": "我的意思是，至少，至少"}]
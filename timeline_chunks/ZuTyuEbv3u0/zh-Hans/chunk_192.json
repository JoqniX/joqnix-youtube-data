[{"type": "subtitle", "time": 11520.469, "timestamp": "03:12:00", "text": "溪流。啊"}, {"type": "subtitle", "time": 11522.309, "timestamp": "03:12:02", "text": "但是，问题是，不知何故，我"}, {"type": "subtitle", "time": 11524.55, "timestamp": "03:12:04", "text": "不知道这是普遍问题还是我的"}, {"type": "subtitle", "time": 11526.79, "timestamp": "03:12:06", "text": "手机有问题，但有时我的网络"}, {"type": "subtitle", "time": 11528.95, "timestamp": "03:12:08", "text": "就像断开连接再重新连接一样"}, {"type": "subtitle", "time": 11530.99, "timestamp": "03:12:10", "text": "再次"}, {"type": "subtitle", "time": 11538.469, "timestamp": "03:12:18", "text": "我遇到的问题就是促使我这么做的原因。"}, {"type": "subtitle", "time": 11546.309, "timestamp": "03:12:26", "text": "呃，你知道吗，我没养狗"}, {"type": "subtitle", "time": 11549.99, "timestamp": "03:12:29", "text": "还有一些其他的东西。我当时想，我要去买一个"}, {"type": "subtitle", "time": 11552.389, "timestamp": "03:12:32", "text": "VTuber编号之类的。我做了一个新的"}, {"type": "subtitle", "time": 11560.23, "timestamp": "03:12:40", "text": "我的意思是，即使是同样的事情，因为呃"}, {"type": "subtitle", "time": 11563.269, "timestamp": "03:12:43", "text": "对于人，我只喜欢把一切都给他们。"}, {"type": "subtitle", "time": 11565.11, "timestamp": "03:12:45", "text": "就像同一个数字一样。至于其他方面"}, {"type": "subtitle", "time": 11567.03, "timestamp": "03:12:47", "text": "数字，就像我的父母和我一样"}, {"type": "subtitle", "time": 11569.58, "timestamp": "03:12:49", "text": "现在的室友知道这件事。"}, {"type": "subtitle", "time": 11570.71, "timestamp": "03:12:50", "text": "[音乐]"}, {"type": "subtitle", "time": 11572.55, "timestamp": "03:12:52", "text": "但问题是，现在你必须为此付费。"}, {"type": "subtitle", "time": 11574.469, "timestamp": "03:12:54", "text": "这两个数字，记得保留它们"}, {"type": "subtitle", "time": 11576.309, "timestamp": "03:12:56", "text": "已更新。就是这样。否则"}, {"type": "subtitle", "time": 11578.469, "timestamp": "03:12:58", "text": "会被人袭击，或者其他人会使用"}]
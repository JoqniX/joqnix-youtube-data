[{"type": "subtitle", "time": 3720.63, "timestamp": "01:02:00", "text": "好久没上网了"}, {"type": "subtitle", "time": 3725.71, "timestamp": "01:02:05", "text": "例如在 Discord 或任何其他平台上"}, {"type": "subtitle", "time": 3729.27, "timestamp": "01:02:09", "text": "因为事情就是这样，就像……"}, {"type": "subtitle", "time": 3731.43, "timestamp": "01:02:11", "text": "我会直播吗？"}, {"type": "subtitle", "time": 3735.109, "timestamp": "01:02:15", "text": "我接下来要解释一下……"}, {"type": "subtitle", "time": 3738.309, "timestamp": "01:02:18", "text": "你知道，这件事占用了我大部分时间。"}, {"type": "subtitle", "time": 3741.589, "timestamp": "01:02:21", "text": "是的。我真的很想，因为你"}, {"type": "subtitle", "time": 3743.51, "timestamp": "01:02:23", "text": "我知道我收到了多少爱。"}, {"type": "subtitle", "time": 3747.03, "timestamp": "01:02:27", "text": "多年来，我的族人一直支持着我。"}, {"type": "subtitle", "time": 3749.03, "timestamp": "01:02:29", "text": "对我意义重大，我将永远如此"}, {"type": "subtitle", "time": 3751.27, "timestamp": "01:02:31", "text": "无论如何，我都心存感激。"}, {"type": "subtitle", "time": 3753.67, "timestamp": "01:02:33", "text": "何时重要。我觉得我这么说就像……"}, {"type": "subtitle", "time": 3757.63, "timestamp": "01:02:37", "text": "很多人，我一直都听人这么说。"}, {"type": "subtitle", "time": 3761.99, "timestamp": "01:02:41", "text": "嗯，对我来说只是时机不对。这是一个"}, {"type": "subtitle", "time": 3765.71, "timestamp": "01:02:45", "text": "这段时间对我来说非常艰难，我"}, {"type": "subtitle", "time": 3768.39, "timestamp": "01:02:48", "text": "我几乎觉得我都没时间了。"}, {"type": "subtitle", "time": 3775.43, "timestamp": "01:02:55", "text": "记住，你即将四岁。"}, {"type": "subtitle", "time": 3777.51, "timestamp": "01:02:57", "text": "对吧？好几年了？"}]
[{"type": "subtitle", "time": 14701.11, "timestamp": "04:05:01", "text": "我当时就想，我怎么会邀请了那么多人呢？"}, {"type": "subtitle", "time": 14705.269, "timestamp": "04:05:05", "text": "之前有人参加过邀请吗？"}, {"type": "subtitle", "time": 14707.99, "timestamp": "04:05:07", "text": "啊，是的，我能理解。是的，"}, {"type": "subtitle", "time": 14710.55, "timestamp": "04:05:10", "text": "就像我们每天都这样，或者不是每天都这样"}, {"type": "subtitle", "time": 14713.229, "timestamp": "04:05:13", "text": "就像我们每天寻找的时候一样"}, {"type": "subtitle", "time": 14716.469, "timestamp": "04:05:16", "text": "新晋 YouTuber 和印度 YouTuber"}, {"type": "subtitle", "time": 14718.87, "timestamp": "04:05:18", "text": "试图让他们提到这一点，是的。"}, {"type": "subtitle", "time": 14722.55, "timestamp": "04:05:22", "text": "社区成员可以结交朋友。"}, {"type": "subtitle", "time": 14724.469, "timestamp": "04:05:24", "text": "嗯。"}, {"type": "subtitle", "time": 14727.349, "timestamp": "04:05:27", "text": "太多事情了。是的。我认为"}, {"type": "subtitle", "time": 14729.75, "timestamp": "04:05:29", "text": "与此同时，唯一能阻止这一切的只有……"}, {"type": "subtitle", "time": 14732.07, "timestamp": "04:05:32", "text": "语言障碍让我无法联系到我。"}, {"type": "subtitle", "time": 14734.63, "timestamp": "04:05:34", "text": "其次，我只想……"}, {"type": "subtitle", "time": 14736.15, "timestamp": "04:05:36", "text": "以前更像是一位职业主播"}, {"type": "subtitle", "time": 14739.11, "timestamp": "04:05:39", "text": "接近他人。"}, {"type": "subtitle", "time": 14742.55, "timestamp": "04:05:42", "text": "真正的语言，一切的一切。正确的"}, {"type": "subtitle", "time": 14744.55, "timestamp": "04:05:44", "text": "现在我就像你知道的那样，设置好了我的 OBS。"}, {"type": "subtitle", "time": 14746.95, "timestamp": "04:05:46", "text": "然后快速制作一些缩略图，就这么简单。"}, {"type": "subtitle", "time": 14750.229, "timestamp": "04:05:50", "text": "你知道开始直播"}, {"type": "subtitle", "time": 14753.75, "timestamp": "04:05:53", "text": "按钮。但你知道，就像在未来"}, {"type": "subtitle", "time": 14756.15, "timestamp": "04:05:56", "text": "我不喜欢有合适的覆盖层，"}, {"type": "subtitle", "time": 14757.91, "timestamp": "04:05:57", "text": "就像你知道的加载界面那样。"}]
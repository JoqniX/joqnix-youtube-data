[{"type": "subtitle", "time": 1443.51, "timestamp": "00:24:03", "text": "我的天啊。你好。你好。你好。"}, {"type": "subtitle", "time": 1445.51, "timestamp": "00:24:05", "text": "欢迎光临"}, {"type": "subtitle", "time": 1458.43, "timestamp": "00:24:18", "text": "嗯，我会问类似这样的问题"}, {"type": "subtitle", "time": 1466.71, "timestamp": "00:24:26", "text": "你。好的。所以，就像长大成人一样，对吧？"}, {"type": "subtitle", "time": 1468.23, "timestamp": "00:24:28", "text": "我告诉你。我告诉你。这是"}, {"type": "subtitle", "time": 1470.789, "timestamp": "00:24:30", "text": "好的。这是个好问题。全部"}, {"type": "subtitle", "time": 1474.549, "timestamp": "00:24:34", "text": "正确的。所以，就像当我思考的时候，比如在……"}, {"type": "subtitle", "time": 1477.19, "timestamp": "00:24:37", "text": "我12岁的时候，对吧？那是第一个"}, {"type": "subtitle", "time": 1480.789, "timestamp": "00:24:40", "text": "我开始看动漫的时候。好的。和"}, {"type": "subtitle", "time": 1483.19, "timestamp": "00:24:43", "text": "观看动漫的概念就像"}, {"type": "subtitle", "time": 1484.95, "timestamp": "00:24:44", "text": "毫无预兆。感觉就像……"}, {"type": "subtitle", "time": 1487.269, "timestamp": "00:24:47", "text": "当时很受欢迎。我觉得它刚刚开始"}, {"type": "subtitle", "time": 1489.83, "timestamp": "00:24:49", "text": "非常受欢迎，就像在我这个年龄段一样。"}, {"type": "subtitle", "time": 1491.909, "timestamp": "00:24:51", "text": "是人，对吧？然后我就开始看了"}, {"type": "subtitle", "time": 1494.549, "timestamp": "00:24:54", "text": "我一直都想，你知道，你看"}, {"type": "subtitle", "time": 1496.549, "timestamp": "00:24:56", "text": "意思是说，我一直都想去那里。我"}]
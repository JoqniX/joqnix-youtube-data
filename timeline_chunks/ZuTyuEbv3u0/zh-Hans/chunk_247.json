[{"type": "subtitle", "time": 14820.229, "timestamp": "04:07:00", "text": "不能随便拿起"}, {"type": "subtitle", "time": 14822.309, "timestamp": "04:07:02", "text": "观众更像是我想要的那种感觉"}, {"type": "subtitle", "time": 14824.389, "timestamp": "04:07:04", "text": "那些已经对这些东西感兴趣的人"}, {"type": "subtitle", "time": 14826.63, "timestamp": "04:07:06", "text": "动漫频道等等等等，就像……"}, {"type": "subtitle", "time": 14828.99, "timestamp": "04:07:08", "text": "互联网。"}, {"type": "subtitle", "time": 14832.87, "timestamp": "04:07:12", "text": "是的。而且转移可能很困难。"}, {"type": "subtitle", "time": 14835.91, "timestamp": "04:07:15", "text": "普通人喜欢虚拟主播的观众"}, {"type": "subtitle", "time": 14841.91, "timestamp": "04:07:21", "text": "好了，听着，听着。问题是"}, {"type": "subtitle", "time": 14844.15, "timestamp": "04:07:24", "text": "那些已经喜欢上呃的人"}, {"type": "subtitle", "time": 14847.349, "timestamp": "04:07:27", "text": "它们大多像平静一样。"}, {"type": "subtitle", "time": 14848.269, "timestamp": "04:07:28", "text": "喜欢"}, {"type": "subtitle", "time": 14851.75, "timestamp": "04:07:31", "text": "但是，当谈到……"}, {"type": "subtitle", "time": 14853.309, "timestamp": "04:07:33", "text": "就像一般的互联网"}, {"type": "subtitle", "time": 14855.67, "timestamp": "04:07:35", "text": "印度人也一样。"}, {"type": "subtitle", "time": 14857.99, "timestamp": "04:07:37", "text": "混乱。"}, {"type": "subtitle", "time": 14860.389, "timestamp": "04:07:40", "text": "哦，是的。是的，尤其是在……"}, {"type": "subtitle", "time": 14865.99, "timestamp": "04:07:45", "text": "是啊，所以我才那么害怕。"}, {"type": "subtitle", "time": 14868.229, "timestamp": "04:07:48", "text": "比如做本地内容之类的，你知道的。"}, {"type": "subtitle", "time": 14870.07, "timestamp": "04:07:50", "text": "东西。"}, {"type": "subtitle", "time": 14873.11, "timestamp": "04:07:53", "text": "是的，还有这个"}, {"type": "subtitle", "time": 14875.83, "timestamp": "04:07:55", "text": "颜色歧视，一些随机的"}, {"type": "subtitle", "time": 14878.51, "timestamp": "04:07:58", "text": "来自印度的也喜欢"}]
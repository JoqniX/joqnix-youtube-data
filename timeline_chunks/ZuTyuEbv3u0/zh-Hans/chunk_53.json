[{"type": "subtitle", "time": 3182.71, "timestamp": "00:53:02", "text": "向下。你也知道我可以承受这一切。"}, {"type": "subtitle", "time": 3184.47, "timestamp": "00:53:04", "text": "人走了。"}, {"type": "subtitle", "time": 3187.03, "timestamp": "00:53:07", "text": "是的。你也意识到我可以接受"}, {"type": "subtitle", "time": 3189.91, "timestamp": "00:53:09", "text": "你回来了。不。对。"}, {"type": "subtitle", "time": 3192.829, "timestamp": "00:53:12", "text": "我的天啊。"}, {"type": "subtitle", "time": 3198.39, "timestamp": "00:53:18", "text": "不，不，耶！我接到你了。我收到你的硬币了。"}, {"type": "subtitle", "time": 3202.39, "timestamp": "00:53:22", "text": "你的硬币就是我。我的天啊。"}, {"type": "subtitle", "time": 3205.589, "timestamp": "00:53:25", "text": "我的天啊。你好。你好。你好。怎样"}, {"type": "subtitle", "time": 3209.109, "timestamp": "00:53:29", "text": "你今天有什么安排？我的天哪。我不能"}, {"type": "subtitle", "time": 3212.23, "timestamp": "00:53:32", "text": "相信我。希望你一切都好。"}, {"type": "subtitle", "time": 3218.87, "timestamp": "00:53:38", "text": "这很糟糕。嗯，是的。是的。你嗯"}, {"type": "subtitle", "time": 3223.03, "timestamp": "00:53:43", "text": "我抓到你的女王了。你中了我的圈套。"}, {"type": "subtitle", "time": 3225.03, "timestamp": "00:53:45", "text": "总之，你喜欢哪种巧克力？"}, {"type": "subtitle", "time": 3226.67, "timestamp": "00:53:46", "text": "喜欢？"}, {"type": "subtitle", "time": 3229.15, "timestamp": "00:53:49", "text": "巧克力"}, {"type": "subtitle", "time": 3232.27, "timestamp": "00:53:52", "text": "成为什么"}, {"type": "subtitle", "time": 3238.27, "timestamp": "00:53:58", "text": "不，我就知道会发生什么事。"}]
[{"type": "subtitle", "time": 662.71, "timestamp": "00:11:02", "text": "嘿，我收到跳台滑雪的邀请了。"}, {"type": "subtitle", "time": 665.91, "timestamp": "00:11:05", "text": "不，但我很想加入你们。"}, {"type": "subtitle", "time": 668.79, "timestamp": "00:11:08", "text": "等等，我的游戏好像崩溃了。我的天啊，"}, {"type": "subtitle", "time": 671.509, "timestamp": "00:11:11", "text": "我的游戏刚刚崩溃了。我接受了你的"}, {"type": "subtitle", "time": 673.63, "timestamp": "00:11:13", "text": "游戏邀请。我"}, {"type": "subtitle", "time": 677.75, "timestamp": "00:11:17", "text": "崩溃了。没什么。没关系。让我"}, {"type": "subtitle", "time": 679.99, "timestamp": "00:11:19", "text": "启动它。"}, {"type": "subtitle", "time": 682.71, "timestamp": "00:11:22", "text": "等等，你吃过晚饭了吗？"}, {"type": "subtitle", "time": 684.43, "timestamp": "00:11:24", "text": "是的，我"}, {"type": "subtitle", "time": 688.79, "timestamp": "00:11:28", "text": "我被杀了。我没有。"}, {"type": "subtitle", "time": 710.47, "timestamp": "00:11:50", "text": "好的。我的天啊。大块头来了。"}, {"type": "subtitle", "time": 712.829, "timestamp": "00:11:52", "text": "我算是启动了"}]
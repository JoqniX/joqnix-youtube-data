[{"type": "subtitle", "time": 2041.59, "timestamp": "00:34:01", "text": "室友，但却是我遇到过的最好的室友。"}, {"type": "subtitle", "time": 2044.47, "timestamp": "00:34:04", "text": "依我看来，室友应该算是室友吧。"}, {"type": "subtitle", "time": 2048.909, "timestamp": "00:34:08", "text": "大多数情况下，他们都管好自己的事。"}, {"type": "subtitle", "time": 2051.99, "timestamp": "00:34:11", "text": "天。所以，你有你的隐私，他们"}, {"type": "subtitle", "time": 2054.31, "timestamp": "00:34:14", "text": "他们有自己的隐私。你们会了解的"}, {"type": "subtitle", "time": 2058.23, "timestamp": "00:34:18", "text": "慢慢地，但是，呃，你们是"}, {"type": "subtitle", "time": 2060.869, "timestamp": "00:34:20", "text": "过了一段时间后才关上。那样"}, {"type": "subtitle", "time": 2063.909, "timestamp": "00:34:23", "text": "室友的素质非常重要。"}, {"type": "subtitle", "time": 2065.51, "timestamp": "00:34:25", "text": "是的。"}, {"type": "subtitle", "time": 2071.99, "timestamp": "00:34:31", "text": "我确实经常想太多。所以，我"}, {"type": "subtitle", "time": 2074.629, "timestamp": "00:34:34", "text": "仔细考虑了一下，情况是这样的："}, {"type": "subtitle", "time": 2078.149, "timestamp": "00:34:38", "text": "就像我会像他们会一样"}, {"type": "subtitle", "time": 2079.99, "timestamp": "00:34:39", "text": "做兼职或者像他们会在"}, {"type": "subtitle", "time": 2082.19, "timestamp": "00:34:42", "text": "现在房间。我将在我的直播间里直播"}, {"type": "subtitle", "time": 2084.95, "timestamp": "00:34:44", "text": "该地区比较嘈杂。他们会是"}, {"type": "subtitle", "time": 2087.109, "timestamp": "00:34:47", "text": "比如在玩手机或者学习。它将"}, {"type": "subtitle", "time": 2090.23, "timestamp": "00:34:50", "text": "令人厌烦和不安。正确的。所以"}, {"type": "subtitle", "time": 2092.71, "timestamp": "00:34:52", "text": "我不想发生那种事。"}, {"type": "subtitle", "time": 2095.589, "timestamp": "00:34:55", "text": "那样的话，跟我说话对我有好处。"}, {"type": "subtitle", "time": 2097.589, "timestamp": "00:34:57", "text": "对某人来说，如果我生病了，就会有"}, {"type": "subtitle", "time": 2099.67, "timestamp": "00:34:59", "text": "如果我们需要有人照顾或做些什么的话"}]
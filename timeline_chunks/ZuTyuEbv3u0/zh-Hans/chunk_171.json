[{"type": "subtitle", "time": 10260.429, "timestamp": "02:51:00", "text": "不是10年。5年"}, {"type": "subtitle", "time": 10263.51, "timestamp": "02:51:03", "text": "至少。那将持续很长时间。现在通过"}, {"type": "subtitle", "time": 10267.59, "timestamp": "02:51:07", "text": "然后我可以看看我是否能享受或不享受。"}, {"type": "subtitle", "time": 10271.99, "timestamp": "02:51:11", "text": "比如，看看情况是否顺利等等。"}, {"type": "subtitle", "time": 10274.71, "timestamp": "02:51:14", "text": "然后有足够的钱进行升级或"}, {"type": "subtitle", "time": 10278.63, "timestamp": "02:51:18", "text": "某物。不，我的想法就是这样。"}, {"type": "subtitle", "time": 10281.429, "timestamp": "02:51:21", "text": "我有没有用那玩意儿逗弄过你？"}, {"type": "subtitle", "time": 10301.83, "timestamp": "02:51:41", "text": "我知道。"}, {"type": "subtitle", "time": 10304.07, "timestamp": "02:51:44", "text": "是的。现在轮到你"}, {"type": "subtitle", "time": 10305.51, "timestamp": "02:51:45", "text": "哦，是的。我觉得可能是"}, {"type": "subtitle", "time": 10308.63, "timestamp": "02:51:48", "text": "范围。哦，是的。没关系。是的，所以"}, {"type": "subtitle", "time": 10310.07, "timestamp": "02:51:50", "text": "是的，我问的是你什么事。"}]
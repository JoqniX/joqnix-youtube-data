[{"type": "subtitle", "time": 10500.95, "timestamp": "02:55:00", "text": "《Among Us》里那个带INV功能的玩法又回来了。"}, {"type": "subtitle", "time": 10503.03, "timestamp": "02:55:03", "text": "天。"}, {"type": "subtitle", "time": 10506.71, "timestamp": "02:55:06", "text": "就像最后一场比赛一样"}, {"type": "subtitle", "time": 10508.309, "timestamp": "02:55:08", "text": "那是我赢得的第一项荣誉。"}, {"type": "subtitle", "time": 10510.63, "timestamp": "02:55:10", "text": "冒名顶替者。"}, {"type": "subtitle", "time": 10513.75, "timestamp": "02:55:13", "text": "是的，你作为冒名顶替者赢了。是的，"}, {"type": "subtitle", "time": 10516.83, "timestamp": "02:55:16", "text": "我想在那之后我们玩了一局。"}, {"type": "subtitle", "time": 10519.99, "timestamp": "02:55:19", "text": "腿部版本。"}, {"type": "subtitle", "time": 10522.269, "timestamp": "02:55:22", "text": "是的。是的。"}, {"type": "subtitle", "time": 10530.469, "timestamp": "02:55:30", "text": "之后我对那些演讲者印象非常深刻。"}, {"type": "subtitle", "time": 10533.51, "timestamp": "02:55:33", "text": "我们最终在地球上相遇了"}, {"type": "subtitle", "time": 10535.79, "timestamp": "02:55:35", "text": "现在我们到了。"}, {"type": "subtitle", "time": 10538.58, "timestamp": "02:55:38", "text": "是的。萤火虫"}, {"type": "subtitle", "time": 10539.71, "timestamp": "02:55:39", "text": "[音乐]"}, {"type": "subtitle", "time": 10551.91, "timestamp": "02:55:51", "text": "就像完成我的"}, {"type": "subtitle", "time": 10556.79, "timestamp": "02:55:56", "text": "明年没有大学毕业生。"}]
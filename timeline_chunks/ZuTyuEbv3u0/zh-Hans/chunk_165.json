[{"type": "subtitle", "time": 9900.15, "timestamp": "02:45:00", "text": "四月，那样我就能得到很多东西了。"}, {"type": "subtitle", "time": 9903.51, "timestamp": "02:45:03", "text": "就像我本来可以完成的一样"}, {"type": "subtitle", "time": 9907.59, "timestamp": "02:45:07", "text": "2022年、2023年和2024年的所有的人"}, {"type": "subtitle", "time": 9910.71, "timestamp": "02:45:10", "text": "四月和五月我能做的一切"}, {"type": "subtitle", "time": 9914.71, "timestamp": "02:45:14", "text": "只是和我最近认识的新朋友一起。"}, {"type": "subtitle", "time": 9918.07, "timestamp": "02:45:18", "text": "那是最初的想法。然后呃"}, {"type": "subtitle", "time": 9920.23, "timestamp": "02:45:20", "text": "我的世界游戏就在那里。然后我"}, {"type": "subtitle", "time": 9923.67, "timestamp": "02:45:23", "text": "感觉很不舒服，就像我"}, {"type": "subtitle", "time": 9925.83, "timestamp": "02:45:25", "text": "比如强迫自己上线直播"}, {"type": "subtitle", "time": 9928.389, "timestamp": "02:45:28", "text": "现在一切都结束了。所以我就想，啊，我没有"}, {"type": "subtitle", "time": 9930.95, "timestamp": "02:45:30", "text": "我想做，但我必须像个……一样去做。"}, {"type": "subtitle", "time": 9933.99, "timestamp": "02:45:33", "text": "片刻。自从我开通了超级留言功能后，我就一直很开心。"}, {"type": "subtitle", "time": 9937.11, "timestamp": "02:45:37", "text": "那些东西解锁了，我当时就想："}, {"type": "subtitle", "time": 9940.03, "timestamp": "02:45:40", "text": "犹豫不决，我应该继续吗？"}, {"type": "subtitle", "time": 9942.87, "timestamp": "02:45:42", "text": "这？然后我就想，别想了。"}, {"type": "subtitle", "time": 9946.07, "timestamp": "02:45:46", "text": "别想太多，反正你都要这么做。"}, {"type": "subtitle", "time": 9949.75, "timestamp": "02:45:49", "text": "下个月就要离开了。呃，七月"}, {"type": "subtitle", "time": 9959.91, "timestamp": "02:45:59", "text": "我希望在我逗留期间一切顺利。"}]
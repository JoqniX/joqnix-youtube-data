[{"type": "subtitle", "time": 780.15, "timestamp": "00:13:00", "text": "那些喜欢砸东西的家伙就喜欢杀人。"}, {"type": "subtitle", "time": 798.31, "timestamp": "00:13:18", "text": "我简直要疯了"}, {"type": "subtitle", "time": 804.71, "timestamp": "00:13:24", "text": "啊。哦，我感觉就像在搅拌一样。我不"}, {"type": "subtitle", "time": 807.79, "timestamp": "00:13:27", "text": "但我知道该怎么做。"}, {"type": "subtitle", "time": 812.03, "timestamp": "00:13:32", "text": "那么，你是如何加入我的呢？"}, {"type": "subtitle", "time": 814.11, "timestamp": "00:13:34", "text": "再次？"}, {"type": "subtitle", "time": 822.55, "timestamp": "00:13:42", "text": "你当前任务的继续将"}, {"type": "subtitle", "time": 823.629, "timestamp": "00:13:43", "text": "得救。"}, {"type": "subtitle", "time": 826.87, "timestamp": "00:13:46", "text": "好的。好的。将正常保存。是"}, {"type": "subtitle", "time": 828.389, "timestamp": "00:13:48", "text": "你确定要加入其他玩家的行列吗？"}, {"type": "subtitle", "time": 830.43, "timestamp": "00:13:50", "text": "游戏环节？"}, {"type": "subtitle", "time": 838.15, "timestamp": "00:13:58", "text": "谁没事？等待。出事了。"}]
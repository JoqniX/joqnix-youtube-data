[{"type": "subtitle", "time": 2160.15, "timestamp": "00:36:00", "text": "是的。"}, {"type": "subtitle", "time": 2166.069, "timestamp": "00:36:06", "text": "问题是，我在这方面就像个小孩子一样。"}, {"type": "subtitle", "time": 2168.87, "timestamp": "00:36:08", "text": "活了过来。我想很多方面都缺乏"}, {"type": "subtitle", "time": 2171.43, "timestamp": "00:36:11", "text": "经验丰富。不知道如何"}, {"type": "subtitle", "time": 2173.03, "timestamp": "00:36:13", "text": "世界运转。所以这将是件好事"}, {"type": "subtitle", "time": 2177.03, "timestamp": "00:36:17", "text": "有机会亲身学习。"}, {"type": "subtitle", "time": 2180.31, "timestamp": "00:36:20", "text": "是的。是的，你应该这么做。但我"}, {"type": "subtitle", "time": 2182.15, "timestamp": "00:36:22", "text": "我担心被骗。"}, {"type": "subtitle", "time": 2187.27, "timestamp": "00:36:27", "text": "因为我很容易搞到手，所以就随便买东西。不，不，不"}, {"type": "subtitle", "time": 2190.63, "timestamp": "00:36:30", "text": "不。你知道，我会说大多数"}, {"type": "subtitle", "time": 2193.19, "timestamp": "00:36:33", "text": "你通常会喜欢的东西"}, {"type": "subtitle", "time": 2195.19, "timestamp": "00:36:35", "text": "就像你做研究或者弄明白一样"}, {"type": "subtitle", "time": 2198.15, "timestamp": "00:36:38", "text": "在网络平台上而不是亲自前往"}, {"type": "subtitle", "time": 2200.31, "timestamp": "00:36:40", "text": "去商店购买，或者像从……购买"}, {"type": "subtitle", "time": 2203.75, "timestamp": "00:36:43", "text": "你知道，就是当地市场吗？哦，是的。是的。"}, {"type": "subtitle", "time": 2206.47, "timestamp": "00:36:46", "text": "除此之外，我想说的还有当地美食。"}, {"type": "subtitle", "time": 2208.79, "timestamp": "00:36:48", "text": "你得出去买。以外"}, {"type": "subtitle", "time": 2210.87, "timestamp": "00:36:50", "text": "我想说，你可以得到"}, {"type": "subtitle", "time": 2212.95, "timestamp": "00:36:52", "text": "大多数东西都来自网上。"}, {"type": "subtitle", "time": 2215.03, "timestamp": "00:36:55", "text": "相反，要过很长一段时间，直到你"}, {"type": "subtitle", "time": 2216.71, "timestamp": "00:36:56", "text": "我明白事情是如何运作的，因为我"}, {"type": "subtitle", "time": 2219.829, "timestamp": "00:36:59", "text": "我相当肯定外国人会被骗。"}]
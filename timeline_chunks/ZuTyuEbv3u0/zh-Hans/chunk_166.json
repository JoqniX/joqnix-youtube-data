[{"type": "subtitle", "time": 9963.51, "timestamp": "02:46:03", "text": "在日本，尤其是在这种模式下"}, {"type": "subtitle", "time": 9967.83, "timestamp": "02:46:07", "text": "东西什么的。它就像……"}, {"type": "subtitle", "time": 9970.79, "timestamp": "02:46:10", "text": "呃，我是说，我该怎么说呢？就像"}, {"type": "subtitle", "time": 9974.87, "timestamp": "02:46:14", "text": "可能有效，也可能无效，因为……"}, {"type": "subtitle", "time": 9978.87, "timestamp": "02:46:18", "text": "嗯，我本来应该得到……"}, {"type": "subtitle", "time": 9981.11, "timestamp": "02:46:21", "text": "艺术家和索具工喜欢一起工作"}, {"type": "subtitle", "time": 9985.75, "timestamp": "02:46:25", "text": "这时的模型已经成型了，但我有点……"}, {"type": "subtitle", "time": 9988.55, "timestamp": "02:46:28", "text": "我当时怎么也没有足够的钱。"}, {"type": "subtitle", "time": 9992.469, "timestamp": "02:46:32", "text": "手。所以它们目前处于待定状态。"}, {"type": "subtitle", "time": 9995.19, "timestamp": "02:46:35", "text": "所以，这个月之后我就得……"}, {"type": "subtitle", "time": 9997.67, "timestamp": "02:46:37", "text": "我当时就想，或许可以联系他们。"}, {"type": "subtitle", "time": 10001.429, "timestamp": "02:46:41", "text": "让他们知道，嗯，我没有"}, {"type": "subtitle", "time": 10003.429, "timestamp": "02:46:43", "text": "跟他们俩都提一下，就像“是啊，我是……”"}, {"type": "subtitle", "time": 10005.75, "timestamp": "02:46:45", "text": "乔森正在搞这个众筹项目"}, {"type": "subtitle", "time": 10007.91, "timestamp": "02:46:47", "text": "以及所有的一切。我会尽我所能。"}, {"type": "subtitle", "time": 10010.55, "timestamp": "02:46:50", "text": "所以我就简单提一下，嗯，我试过了。"}, {"type": "subtitle", "time": 10015.19, "timestamp": "02:46:55", "text": "尽我所能做到最好"}, {"type": "subtitle", "time": 10018.55, "timestamp": "02:46:58", "text": "我觉得我在这方面做得还不够。"}]
[{"type": "subtitle", "time": 844.99, "timestamp": "00:14:04", "text": "我怎么可能？"}, {"type": "subtitle", "time": 848.87, "timestamp": "00:14:08", "text": "呃，等等。这是其他人。"}, {"type": "subtitle", "time": 855.87, "timestamp": "00:14:15", "text": "什么？为什么我会出现在别人的……"}, {"type": "subtitle", "time": 859.03, "timestamp": "00:14:19", "text": "等待。呃，我想我犯了个错误。"}, {"type": "subtitle", "time": 861.99, "timestamp": "00:14:21", "text": "等等，贝克，你是怎么加入的？我该怎么做？"}, {"type": "subtitle", "time": 868.79, "timestamp": "00:14:28", "text": "好的。呃，好的。我有个疑问。约翰，"}, {"type": "subtitle", "time": 870.79, "timestamp": "00:14:30", "text": "你真的能用这种方式杀死这个人吗？"}, {"type": "subtitle", "time": 872.949, "timestamp": "00:14:32", "text": "大锤？"}, {"type": "subtitle", "time": 877.11, "timestamp": "00:14:37", "text": "嗯，可以。你只需要处理很多事情。"}, {"type": "subtitle", "time": 879.35, "timestamp": "00:14:39", "text": "损害。"}, {"type": "subtitle", "time": 882.069, "timestamp": "00:14:42", "text": "哦，等等。用飞刀攻击"}, {"type": "subtitle", "time": 884.47, "timestamp": "00:14:44", "text": "头。"}, {"type": "subtitle", "time": 886.23, "timestamp": "00:14:46", "text": "我没有那些东西。你如何"}, {"type": "subtitle", "time": 889.629, "timestamp": "00:14:49", "text": "做它们？哦，你可以制作"}]
[{"type": "subtitle", "time": 14400.95, "timestamp": "04:00:00", "text": "哦好的。我们走吧。我会发照片。"}, {"type": "subtitle", "time": 14405.03, "timestamp": "04:00:05", "text": "还有一些其他的东西。我会没事的。是的，继续"}, {"type": "subtitle", "time": 14407.51, "timestamp": "04:00:07", "text": "已通知我。谁知道呢？甚至我也可能来"}, {"type": "subtitle", "time": 14409.91, "timestamp": "04:00:09", "text": "他们过来旅行。是的，"}, {"type": "subtitle", "time": 14411.67, "timestamp": "04:00:11", "text": "我们走吧。我带你四处看看。"}, {"type": "subtitle", "time": 14412.87, "timestamp": "04:00:12", "text": "东西。到那时，我就会像"}, {"type": "subtitle", "time": 14415.71, "timestamp": "04:00:15", "text": "专业日本公民或"}, {"type": "subtitle", "time": 14418.71, "timestamp": "04:00:18", "text": "某物。我的天啊。是的，我会的"}, {"type": "subtitle", "time": 14422.07, "timestamp": "04:00:22", "text": "我需要一份指南才能喜欢它。"}, {"type": "subtitle", "time": 14432.63, "timestamp": "04:00:32", "text": "是啊，我们周围的每个人都有很多事情。"}, {"type": "subtitle", "time": 14436.07, "timestamp": "04:00:36", "text": "他们就像也在向前迈进，做着他们的事情。"}, {"type": "subtitle", "time": 14439.349, "timestamp": "04:00:39", "text": "自己的东西。生活。"}, {"type": "subtitle", "time": 14443.389, "timestamp": "04:00:43", "text": "是啊，这就是人生。"}, {"type": "subtitle", "time": 14447.72, "timestamp": "04:00:47", "text": "当然可以。那里。"}, {"type": "subtitle", "time": 14450.55, "timestamp": "04:00:50", "text": "[音乐]"}, {"type": "subtitle", "time": 14455.07, "timestamp": "04:00:55", "text": "那是什么？我想问什么？哦，我的"}, {"type": "subtitle", "time": 14457.389, "timestamp": "04:00:57", "text": "上帝。哦，是的。"}]
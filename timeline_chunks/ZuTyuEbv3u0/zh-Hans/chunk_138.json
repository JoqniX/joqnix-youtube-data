[{"type": "subtitle", "time": 8281.589, "timestamp": "02:18:01", "text": "是的，我其实正在追逐我的梦想。"}, {"type": "subtitle", "time": 8284.629, "timestamp": "02:18:04", "text": "跟随我或者做任何我想做的事情。我是"}, {"type": "subtitle", "time": 8287.509, "timestamp": "02:18:07", "text": "我照做了，然后把这个想法告诉了他们。"}, {"type": "subtitle", "time": 8290.23, "timestamp": "02:18:10", "text": "关于我想去日本的事"}, {"type": "subtitle", "time": 8293.91, "timestamp": "02:18:13", "text": "他们已经知道的一切，就像他们"}, {"type": "subtitle", "time": 8297.99, "timestamp": "02:18:17", "text": "我能听到家里传来的声音，就像我跟他们说话时一样"}, {"type": "subtitle", "time": 8302.95, "timestamp": "02:18:22", "text": "现在有人直播吗？嗯，他们确实知道。"}, {"type": "subtitle", "time": 8305.99, "timestamp": "02:18:25", "text": "我会说一些中文"}, {"type": "subtitle", "time": 8308.79, "timestamp": "02:18:28", "text": "或者别的什么。"}, {"type": "subtitle", "time": 8310.389, "timestamp": "02:18:30", "text": "好的。"}, {"type": "subtitle", "time": 8313.83, "timestamp": "02:18:33", "text": "是的，他们说，呃，每当他们"}, {"type": "subtitle", "time": 8315.83, "timestamp": "02:18:35", "text": "告诉他们的邻居或一些客人"}, {"type": "subtitle", "time": 8318.309, "timestamp": "02:18:38", "text": "来吧，他们吹嘘说，是的，"}, {"type": "subtitle", "time": 8320.23, "timestamp": "02:18:40", "text": "我儿子懂中文之类的。他"}, {"type": "subtitle", "time": 8323.03, "timestamp": "02:18:43", "text": "和网上的人聊天，我就……"}, {"type": "subtitle", "time": 8332.23, "timestamp": "02:18:52", "text": "就像人们仍然会犯的错误一样"}, {"type": "subtitle", "time": 8335.91, "timestamp": "02:18:55", "text": "呃，这里指的是英国人说的美式英语。"}]
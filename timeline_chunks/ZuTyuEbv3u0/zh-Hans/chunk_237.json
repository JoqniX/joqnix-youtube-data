[{"type": "subtitle", "time": 14220.07, "timestamp": "03:57:00", "text": "现在就用iPhone吧。这些外国中有些"}, {"type": "subtitle", "time": 14222.67, "timestamp": "03:57:02", "text": "人人都用iPhone之类的手机。我就像"}, {"type": "subtitle", "time": 14226.15, "timestamp": "03:57:06", "text": "哇。购买方便吗？或者喜欢吗？"}, {"type": "subtitle", "time": 14231.429, "timestamp": "03:57:11", "text": "这取决于他们使用的是哪款iPhone。"}, {"type": "subtitle", "time": 14233.51, "timestamp": "03:57:13", "text": "他们几乎都在等待。他们有吗？"}, {"type": "subtitle", "time": 14236.389, "timestamp": "03:57:16", "text": "像最新版本那样？我也这么认为。这"}, {"type": "subtitle", "time": 14238.59, "timestamp": "03:57:18", "text": "最新版本。"}, {"type": "subtitle", "time": 14242.269, "timestamp": "03:57:22", "text": "呃，我的意思是，我的意思是"}, {"type": "subtitle", "time": 14247.349, "timestamp": "03:57:27", "text": "比如，iPhone 的价格是 99 美元，还是三个 9？"}, {"type": "subtitle", "time": 14249.67, "timestamp": "03:57:29", "text": "美元或其他什么"}, {"type": "subtitle", "time": 14251.63, "timestamp": "03:57:31", "text": "然而？"}, {"type": "subtitle", "time": 14255.11, "timestamp": "03:57:35", "text": "是的。该死。价格一样吗？"}, {"type": "subtitle", "time": 14257.75, "timestamp": "03:57:37", "text": "一切？"}, {"type": "subtitle", "time": 14261.11, "timestamp": "03:57:41", "text": "像每个国家一样吗？不，价格一样。"}, {"type": "subtitle", "time": 14263.79, "timestamp": "03:57:43", "text": "适用于所有型号。新的"}, {"type": "subtitle", "time": 14267.349, "timestamp": "03:57:47", "text": "模型。我不这么认为，因为……"}, {"type": "subtitle", "time": 14271.309, "timestamp": "03:57:51", "text": "我觉得最后一个是15。"}, {"type": "subtitle", "time": 14274.07, "timestamp": "03:57:54", "text": "我想是14岁，我不知道，不确定，但是"}, {"type": "subtitle", "time": 14276.03, "timestamp": "03:57:56", "text": "但那一个字面意义上的"}, {"type": "subtitle", "time": 14278.15, "timestamp": "03:57:58", "text": "广告宣传你是否可以玩《居民》"}]
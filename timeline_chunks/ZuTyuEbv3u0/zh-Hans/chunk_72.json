[{"type": "subtitle", "time": 4320.149, "timestamp": "01:12:00", "text": "她说她喜欢拍照"}, {"type": "subtitle", "time": 4322.709, "timestamp": "01:12:02", "text": "她现在吃很多东西。所以我会尽量"}, {"type": "subtitle", "time": 4326.55, "timestamp": "01:12:06", "text": "饭前拍照并发送。"}, {"type": "subtitle", "time": 4334.149, "timestamp": "01:12:14", "text": "你好，Joya。谢谢你今天抽出时间。真有趣"}, {"type": "subtitle", "time": 4336.709, "timestamp": "01:12:16", "text": "想和你一起玩。"}, {"type": "subtitle", "time": 4339.669, "timestamp": "01:12:19", "text": "我知道你很忙，但是，好的，请你一定要这样做。"}, {"type": "subtitle", "time": 4343.11, "timestamp": "01:12:23", "text": "照顾好自己，好好休息。好的，"}, {"type": "subtitle", "time": 4346.95, "timestamp": "01:12:26", "text": "你现在一定很累了吧。是的，我其实"}, {"type": "subtitle", "time": 4350.149, "timestamp": "01:12:30", "text": "我得走了，你知道，就像……"}, {"type": "subtitle", "time": 4352.07, "timestamp": "01:12:32", "text": "现在立刻帮我完成作业。我"}, {"type": "subtitle", "time": 4354.87, "timestamp": "01:12:34", "text": "有四个科目"}, {"type": "subtitle", "time": 4356.63, "timestamp": "01:12:36", "text": "仅有的。"}, {"type": "subtitle", "time": 4360.39, "timestamp": "01:12:40", "text": "我只有一天时间来完成四项任务。"}, {"type": "subtitle", "time": 4364.39, "timestamp": "01:12:44", "text": "作业主题。我完蛋了。"}, {"type": "subtitle", "time": 4367.11, "timestamp": "01:12:47", "text": "我 我 我 因为我 因为我"}, {"type": "subtitle", "time": 4369.27, "timestamp": "01:12:49", "text": "做Chath那件事的时候，我就想，我还是点餐吧。"}, {"type": "subtitle", "time": 4371.83, "timestamp": "01:12:51", "text": "我完成了我的作业。某人"}, {"type": "subtitle", "time": 4375.35, "timestamp": "01:12:55", "text": "其他人帮我写的。我的天哪。你"}, {"type": "subtitle", "time": 4376.79, "timestamp": "01:12:56", "text": "我知道，我没有那个胆量。"}, {"type": "subtitle", "time": 4379.43, "timestamp": "01:12:59", "text": "而且，我觉得，你知道，我"}]
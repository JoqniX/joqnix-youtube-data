[{"type": "subtitle", "time": 14460.87, "timestamp": "04:01:00", "text": "呃，你觉得我加入怎么样？"}, {"type": "subtitle", "time": 14463.63, "timestamp": "04:01:03", "text": "以及其中的一切"}, {"type": "subtitle", "time": 14466.189, "timestamp": "04:01:06", "text": "自此以后，未来将永远如此"}, {"type": "subtitle", "time": 14469.75, "timestamp": "04:01:09", "text": "就像现在你谈到的……"}, {"type": "subtitle", "time": 14471.99, "timestamp": "04:01:11", "text": "你觉得现在的这个怎么样？呃"}, {"type": "subtitle", "time": 14473.91, "timestamp": "04:01:13", "text": "你会如何看待它？"}, {"type": "subtitle", "time": 14478.16, "timestamp": "04:01:18", "text": "未来之类的？是的。是的。"}, {"type": "subtitle", "time": 14479.91, "timestamp": "04:01:19", "text": "[音乐]"}, {"type": "subtitle", "time": 14482.309, "timestamp": "04:01:22", "text": "我的意思是，我认为在未来"}, {"type": "subtitle", "time": 14484.67, "timestamp": "04:01:24", "text": "你知道，一旦它流行起来，它就会变得很受欢迎。"}, {"type": "subtitle", "time": 14487.349, "timestamp": "04:01:27", "text": "新来者开始做"}, {"type": "subtitle", "time": 14490.15, "timestamp": "04:01:30", "text": "根据你知道的内容"}, {"type": "subtitle", "time": 14492.309, "timestamp": "04:01:32", "text": "本地观众。"}, {"type": "subtitle", "time": 14495.59, "timestamp": "04:01:35", "text": "啊，对，因为现在，就是现在"}, {"type": "subtitle", "time": 14497.349, "timestamp": "04:01:37", "text": "现有的那些，它们都像这样"}, {"type": "subtitle", "time": 14498.91, "timestamp": "04:01:38", "text": "围绕"}, {"type": "subtitle", "time": 14502.63, "timestamp": "04:01:42", "text": "不太喜欢 YouTuber 的东西"}, {"type": "subtitle", "time": 14504.389, "timestamp": "04:01:44", "text": "感觉他们好像只瞄准了……"}, {"type": "subtitle", "time": 14505.99, "timestamp": "04:01:45", "text": "动漫观众，或者像那些人一样"}, {"type": "subtitle", "time": 14509.67, "timestamp": "04:01:49", "text": "已经认识一些油管博主之类的。是的。"}, {"type": "subtitle", "time": 14511.51, "timestamp": "04:01:51", "text": "但如果有人选择普通版的话……"}, {"type": "subtitle", "time": 14514.469, "timestamp": "04:01:54", "text": "是的。或许他们可能拥有美好的未来"}, {"type": "subtitle", "time": 14517.83, "timestamp": "04:01:57", "text": "职业。嗯。"}, {"type": "subtitle", "time": 14519.99, "timestamp": "04:01:59", "text": "我的意思是，就像有些人那样"}]
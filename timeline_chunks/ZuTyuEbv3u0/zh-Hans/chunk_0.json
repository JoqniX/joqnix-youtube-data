[{"type": "subtitle", "time": 2.909, "timestamp": "00:00:02", "text": "我当时就想"}, {"type": "subtitle", "time": 25.59, "timestamp": "00:00:25", "text": "总之，他们又有了新的故事。"}, {"type": "subtitle", "time": 27.67, "timestamp": "00:00:27", "text": "确实如此。"}, {"type": "subtitle", "time": 30.71, "timestamp": "00:00:30", "text": "是的，他们有。哦，RGB 实际上说过"}, {"type": "subtitle", "time": 34.389, "timestamp": "00:00:34", "text": "你好。你好。我很抱歉。哦，是的。我"}, {"type": "subtitle", "time": 36.389, "timestamp": "00:00:36", "text": "在你那么……的时候，我曾这样跟你说过。"}, {"type": "subtitle", "time": 42.31, "timestamp": "00:00:42", "text": "我想弄清楚这一点。我太"}, {"type": "subtitle", "time": 43.95, "timestamp": "00:00:43", "text": "对不起。我"}, {"type": "subtitle", "time": 46.19, "timestamp": "00:00:46", "text": "没有"}, {"type": "subtitle", "time": 49.43, "timestamp": "00:00:49", "text": "我感觉就像我在这里一样。没关系。"}, {"type": "subtitle", "time": 57.91, "timestamp": "00:00:57", "text": "直接给他打电话就行了。谁打来的？什么是"}]
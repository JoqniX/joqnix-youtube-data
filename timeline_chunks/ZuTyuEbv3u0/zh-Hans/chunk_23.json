[{"type": "subtitle", "time": 1382.549, "timestamp": "00:23:02", "text": "你已经很久没有直播了，"}, {"type": "subtitle", "time": 1387.669, "timestamp": "00:23:07", "text": "正确的？我很想念你的直播。"}, {"type": "subtitle", "time": 1390.47, "timestamp": "00:23:10", "text": "别让我哭。我刚收到你的"}, {"type": "subtitle", "time": 1398.23, "timestamp": "00:23:18", "text": "是啊，已经两个月了，我很想念。"}, {"type": "subtitle", "time": 1402.789, "timestamp": "00:23:22", "text": "我的家人，是的，我爱你们所有人。"}, {"type": "subtitle", "time": 1405.07, "timestamp": "00:23:25", "text": "是的。"}, {"type": "subtitle", "time": 1412.149, "timestamp": "00:23:32", "text": "呃，Arexar今天早些时候说……"}, {"type": "subtitle", "time": 1416.27, "timestamp": "00:23:36", "text": "你好。哦，好的。好的。"}, {"type": "subtitle", "time": 1420.23, "timestamp": "00:23:40", "text": "你好。我的天啊。 Arexar太棒了。我"}, {"type": "subtitle", "time": 1422.99, "timestamp": "00:23:42", "text": "我觉得阿里斯是我认识的人之一。"}, {"type": "chat", "time": 1424.029, "timestamp": "00:23:44", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "I also say hi"}, {"type": "subtitle", "time": 1427.029, "timestamp": "00:23:47", "text": "几乎从一开始就为人所知。是的，他是"}, {"type": "subtitle", "time": 1428.789, "timestamp": "00:23:48", "text": "从一开始就在那里。他一直"}, {"type": "subtitle", "time": 1432.23, "timestamp": "00:23:52", "text": "他就像刚去过那里一样。"}, {"type": "subtitle", "time": 1434.71, "timestamp": "00:23:54", "text": "是的，我也很棒。"}, {"type": "subtitle", "time": 1436.39, "timestamp": "00:23:56", "text": "每个人都很棒。我感觉自己好像错过了什么"}, {"type": "subtitle", "time": 1439.11, "timestamp": "00:23:59", "text": "和一群很棒的人一起工作。"}, {"type": "chat", "time": 1439.716, "timestamp": "00:23:59", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "Bread 🍞🤌"}]
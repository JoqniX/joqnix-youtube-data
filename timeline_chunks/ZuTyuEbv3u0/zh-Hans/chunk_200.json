[{"type": "subtitle", "time": 12000.99, "timestamp": "03:20:00", "text": "嗯，情况进展顺利，是吗？"}, {"type": "subtitle", "time": 12003.11, "timestamp": "03:20:03", "text": "理论上的？好多理论之类的东西"}, {"type": "subtitle", "time": 12005.75, "timestamp": "03:20:05", "text": "计算机科学专业。"}, {"type": "subtitle", "time": 12008.75, "timestamp": "03:20:08", "text": "我觉得更像是程序。"}, {"type": "subtitle", "time": 12010.55, "timestamp": "03:20:10", "text": "编程。"}, {"type": "subtitle", "time": 12012.79, "timestamp": "03:20:12", "text": "我看过一些编程书籍，"}, {"type": "subtitle", "time": 12016.07, "timestamp": "03:20:16", "text": "代码真是太庞大、太复杂了。我喜欢这样"}, {"type": "subtitle", "time": 12019.95, "timestamp": "03:20:19", "text": "你学到这个了吗？如果我看到一个"}, {"type": "subtitle", "time": 12023.349, "timestamp": "03:20:23", "text": "很大，像一本圣经，但"}, {"type": "subtitle", "time": 12025.83, "timestamp": "03:20:25", "text": "更像是把两本圣经放在一起了。"}, {"type": "subtitle", "time": 12029.83, "timestamp": "03:20:29", "text": "书。那是用 Java 或 C++ 之类的编程语言编写的。"}, {"type": "subtitle", "time": 12031.51, "timestamp": "03:20:31", "text": "书。"}, {"type": "subtitle", "time": 12033.269, "timestamp": "03:20:33", "text": "那真是奇怪，那真是奇怪"}, {"type": "subtitle", "time": 12035.11, "timestamp": "03:20:35", "text": "这是一个有趣的比较，但"}, {"type": "chat", "time": 12040.53, "timestamp": "03:20:40", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "4 years into coding ... i dont wanna be alive any longer"}, {"type": "subtitle", "time": 12040.75, "timestamp": "03:20:40", "text": "是的，"}, {"type": "subtitle", "time": 12044.87, "timestamp": "03:20:44", "text": "就像我看到一个朋友，不，不是朋友"}, {"type": "subtitle", "time": 12048.229, "timestamp": "03:20:48", "text": "当我翻阅一位表叔的旧书时"}, {"type": "subtitle", "time": 12052.07, "timestamp": "03:20:52", "text": "我去拜访了他，我当时就像……"}, {"type": "subtitle", "time": 12054.99, "timestamp": "03:20:54", "text": "我的天啊，他居然从事计算机工程！"}]
[{"type": "subtitle", "time": 7983.589, "timestamp": "02:13:03", "text": "像乔一样勤奋。不，我不是个顽固分子。"}, {"type": "subtitle", "time": 7985.95, "timestamp": "02:13:05", "text": "工人。我是一个懒人"}, {"type": "subtitle", "time": 7988.83, "timestamp": "02:13:08", "text": "斗牛士。勉强能用。你"}, {"type": "subtitle", "time": 7992.109, "timestamp": "02:13:12", "text": "意思是？和每个人都聊聊。哦，我们开始吧"}, {"type": "subtitle", "time": 7995.229, "timestamp": "02:13:15", "text": "短途旅行"}, {"type": "subtitle", "time": 8016.069, "timestamp": "02:13:36", "text": "好了，我们到了。我回来了。我回来了。"}, {"type": "subtitle", "time": 8019.79, "timestamp": "02:13:39", "text": "我回来休息了。稍作休息。"}, {"type": "subtitle", "time": 8025.709, "timestamp": "02:13:45", "text": "呃，一个"}]
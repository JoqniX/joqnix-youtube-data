[{"type": "subtitle", "time": 8341.19, "timestamp": "02:19:01", "text": "是的，没错，没错，没错，没错。是的，你"}, {"type": "subtitle", "time": 8343.83, "timestamp": "02:19:03", "text": "父母们很高兴他们已经准备好了"}, {"type": "subtitle", "time": 8347.83, "timestamp": "02:19:07", "text": "我想去哪儿就去哪儿。嗯，但是"}, {"type": "subtitle", "time": 8349.75, "timestamp": "02:19:09", "text": "最重要的是，我什么都不想要。"}, {"type": "subtitle", "time": 8352.469, "timestamp": "02:19:12", "text": "无论他们付出多少努力，他们都会发送"}, {"type": "subtitle", "time": 8354.87, "timestamp": "02:19:14", "text": "对我来说，因为那是一大笔钱，我不知道。"}, {"type": "subtitle", "time": 8357.91, "timestamp": "02:19:17", "text": "把你的孩子送到不同的地方"}, {"type": "subtitle", "time": 8359.509, "timestamp": "02:19:19", "text": "国家和一切很多事情"}, {"type": "subtitle", "time": 8363.91, "timestamp": "02:19:23", "text": "对，我是独生子，所以……是的。哦"}, {"type": "subtitle", "time": 8367.83, "timestamp": "02:19:27", "text": "是的，兄弟，我在这儿呢。"}, {"type": "subtitle", "time": 8377.75, "timestamp": "02:19:37", "text": "去一个国家读硕士。"}, {"type": "subtitle", "time": 8382.309, "timestamp": "02:19:42", "text": "你应该这么做。这会是好事。"}, {"type": "subtitle", "time": 8386.03, "timestamp": "02:19:46", "text": "你想去哪个国家？"}, {"type": "subtitle", "time": 8389.67, "timestamp": "02:19:49", "text": "你最喜欢去哪个国家？"}, {"type": "subtitle", "time": 8392.469, "timestamp": "02:19:52", "text": "呃，可能是澳大利亚，或者"}, {"type": "subtitle", "time": 8393.87, "timestamp": "02:19:53", "text": "新加坡或"}, {"type": "subtitle", "time": 8396.87, "timestamp": "02:19:56", "text": "马来西亚。最后一个选项是"}, {"type": "subtitle", "time": 8399.11, "timestamp": "02:19:59", "text": "我们。"}]
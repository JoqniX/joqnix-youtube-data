[{"type": "subtitle", "time": 8881.03, "timestamp": "02:28:01", "text": "那。而且，就好像已经这样了一样"}, {"type": "subtitle", "time": 8883.91, "timestamp": "02:28:03", "text": "很久以前，Discord 会隐藏这些旧私信。"}, {"type": "subtitle", "time": 8885.83, "timestamp": "02:28:05", "text": "还有一些其他的东西。你聊天的人越多"}, {"type": "subtitle", "time": 8888.55, "timestamp": "02:28:08", "text": "一切都糟透了。"}, {"type": "subtitle", "time": 8890.63, "timestamp": "02:28:10", "text": "是的，我知道。"}, {"type": "subtitle", "time": 8893.03, "timestamp": "02:28:13", "text": "很难像向下滚动那样操作。"}, {"type": "subtitle", "time": 8895.349, "timestamp": "02:28:15", "text": "找到我交谈过的人。"}, {"type": "subtitle", "time": 8899.27, "timestamp": "02:28:19", "text": "还有一些其他的东西。所以"}, {"type": "subtitle", "time": 8903.99, "timestamp": "02:28:23", "text": "是啊，这有点难。"}, {"type": "subtitle", "time": 8905.59, "timestamp": "02:28:25", "text": "是的。"}, {"type": "subtitle", "time": 8907.75, "timestamp": "02:28:27", "text": "嗯，是的，因为自从……以来，我就一直……"}, {"type": "subtitle", "time": 8910.15, "timestamp": "02:28:30", "text": "最近又回到了这个状态"}, {"type": "subtitle", "time": 8912.95, "timestamp": "02:28:32", "text": "流媒体之类的，怎么样？"}, {"type": "subtitle", "time": 8914.389, "timestamp": "02:28:34", "text": "目前为止，社区的情况如何？因为我看见你了"}, {"type": "subtitle", "time": 8917.03, "timestamp": "02:28:37", "text": "与许多人合作，例如"}, {"type": "subtitle", "time": 8921.429, "timestamp": "02:28:41", "text": "自从这个呃，你知道的标签开始以来。"}, {"type": "subtitle", "time": 8925.03, "timestamp": "02:28:45", "text": "嗯，是的，和别人合作。"}, {"type": "subtitle", "time": 8928.15, "timestamp": "02:28:48", "text": "INVtubers 或类似外部人士"}, {"type": "subtitle", "time": 8930.19, "timestamp": "02:28:50", "text": "大家都喜欢"}, {"type": "subtitle", "time": 8931.71, "timestamp": "02:28:51", "text": "啊"}, {"type": "subtitle", "time": 8935.11, "timestamp": "02:28:55", "text": "因为我最初只想得到……"}, {"type": "subtitle", "time": 8937.67, "timestamp": "02:28:57", "text": "我跟那些人交谈过，以及所有的一切。"}]
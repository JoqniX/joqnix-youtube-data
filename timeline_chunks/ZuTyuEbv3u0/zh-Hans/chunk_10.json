[{"type": "subtitle", "time": 600.03, "timestamp": "00:10:00", "text": "你。但"}, {"type": "subtitle", "time": 605.55, "timestamp": "00:10:05", "text": "呃，我会拿这把枪，还有"}, {"type": "subtitle", "time": 632.829, "timestamp": "00:10:32", "text": "嗯，我的所有物品都在OK里。"}, {"type": "subtitle", "time": 635.91, "timestamp": "00:10:35", "text": "总之，你知道吗？我这就拿"}, {"type": "subtitle", "time": 640.63, "timestamp": "00:10:40", "text": "医护人员和其他人来了"}, {"type": "subtitle", "time": 642.67, "timestamp": "00:10:42", "text": "呃"}, {"type": "subtitle", "time": 649.99, "timestamp": "00:10:49", "text": "锁。好的。"}, {"type": "subtitle", "time": 653.87, "timestamp": "00:10:53", "text": "呃，逃跑。去"}, {"type": "subtitle", "time": 658.71, "timestamp": "00:10:58", "text": "后退。等等，我该如何加入你们的游戏？"}]
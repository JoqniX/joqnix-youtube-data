[{"type": "subtitle", "time": 13143.19, "timestamp": "03:39:03", "text": "49公斤"}, {"type": "subtitle", "time": 13145.269, "timestamp": "03:39:05", "text": "但大学毕业后，我就基本没再工作了。"}, {"type": "subtitle", "time": 13146.79, "timestamp": "03:39:06", "text": "称一下重量，但我很确定我"}, {"type": "subtitle", "time": 13149.51, "timestamp": "03:39:09", "text": "减重了大约四五公斤"}, {"type": "subtitle", "time": 13153.03, "timestamp": "03:39:13", "text": "45岁，我以前好像是36岁左右。"}, {"type": "subtitle", "time": 13158.87, "timestamp": "03:39:18", "text": "等待就像你十几岁的时候一样"}, {"type": "subtitle", "time": 13163.429, "timestamp": "03:39:23", "text": "年轻人或类似最后"}, {"type": "subtitle", "time": 13166.469, "timestamp": "03:39:26", "text": "去年或类似的时候"}, {"type": "subtitle", "time": 13170.229, "timestamp": "03:39:30", "text": "我们相遇的时间，或者类似2022年左右。"}, {"type": "subtitle", "time": 13175.11, "timestamp": "03:39:35", "text": "2023年的时候，大约是35岁左右。"}, {"type": "subtitle", "time": 13181.75, "timestamp": "03:39:41", "text": "甚至我自己都觉得我过得更好了。"}, {"type": "subtitle", "time": 13187.87, "timestamp": "03:39:47", "text": "我不"}, {"type": "subtitle", "time": 13190.389, "timestamp": "03:39:50", "text": "想知道人们的反应。"}, {"type": "subtitle", "time": 13193.83, "timestamp": "03:39:53", "text": "在小马漫画中见到你"}, {"type": "subtitle", "time": 13196.79, "timestamp": "03:39:56", "text": "我当时就……然后他们每个人都像……"}]
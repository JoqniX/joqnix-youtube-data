[{"type": "subtitle", "time": 15061.99, "timestamp": "04:11:01", "text": "别的。所以你也应该加入我"}, {"type": "subtitle", "time": 15064.15, "timestamp": "04:11:04", "text": "本来想这周做，但是我觉得"}, {"type": "subtitle", "time": 15066.71, "timestamp": "04:11:06", "text": "比如我会先把那件事做完。"}, {"type": "subtitle", "time": 15069.349, "timestamp": "04:11:09", "text": "那我下周就做，就像……"}, {"type": "subtitle", "time": 15071.99, "timestamp": "04:11:11", "text": "六月我走之前。"}, {"type": "subtitle", "time": 15074.59, "timestamp": "04:11:14", "text": "好的。是的，"}, {"type": "subtitle", "time": 15077.349, "timestamp": "04:11:17", "text": "我看看是不是只有我没有"}, {"type": "subtitle", "time": 15079.11, "timestamp": "04:11:19", "text": "关于下雨的问题，我本来已经知道了。"}, {"type": "subtitle", "time": 15081.59, "timestamp": "04:11:21", "text": "我儿子准备好了。"}, {"type": "subtitle", "time": 15085.83, "timestamp": "04:11:25", "text": "是的，上周日下了雨。"}, {"type": "subtitle", "time": 15088.309, "timestamp": "04:11:28", "text": "然后检查一下，但随后下雨了"}, {"type": "subtitle", "time": 15090.11, "timestamp": "04:11:30", "text": "并没有停止。"}, {"type": "subtitle", "time": 15092.55, "timestamp": "04:11:32", "text": "[音乐]"}, {"type": "subtitle", "time": 15096.229, "timestamp": "04:11:36", "text": "对，就是那部分。"}, {"type": "subtitle", "time": 15105.59, "timestamp": "04:11:45", "text": "是的。是的。在你离开之前，任何"}, {"type": "subtitle", "time": 15107.59, "timestamp": "04:11:47", "text": "公告或其他任何你想说的"}, {"type": "subtitle", "time": 15110.389, "timestamp": "04:11:50", "text": "制作"}, {"type": "subtitle", "time": 15112.469, "timestamp": "04:11:52", "text": "就像喜欢观众一样，或者喜欢"}, {"type": "subtitle", "time": 15114.79, "timestamp": "04:11:54", "text": "你？是的，对现场观众和所有人。"}, {"type": "subtitle", "time": 15117.59, "timestamp": "04:11:57", "text": "是啊，我也是。好的。"}, {"type": "subtitle", "time": 15119.67, "timestamp": "04:11:59", "text": "即将发布的公告"}]
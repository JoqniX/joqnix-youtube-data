[{"type": "subtitle", "time": 14161.67, "timestamp": "03:56:01", "text": "现在可以使用日语键盘了。"}, {"type": "subtitle", "time": 14165.87, "timestamp": "03:56:05", "text": "哦，对，那样我或许真的能康复。"}, {"type": "subtitle", "time": 14168.83, "timestamp": "03:56:08", "text": "所有的。我的天啊。"}, {"type": "subtitle", "time": 14172.55, "timestamp": "03:56:12", "text": "哦，所有内容都将是日语，而且没有"}, {"type": "subtitle", "time": 14175.189, "timestamp": "03:56:15", "text": "英式时刻。哦"}, {"type": "subtitle", "time": 14177.349, "timestamp": "03:56:17", "text": "我想，更好的选择应该是"}, {"type": "subtitle", "time": 14179.91, "timestamp": "03:56:19", "text": "大概会说，呃，可能有人在买东西吧。"}, {"type": "subtitle", "time": 14182.229, "timestamp": "03:56:22", "text": "它在这里，然后可能就像……"}, {"type": "subtitle", "time": 14183.67, "timestamp": "03:56:23", "text": "有些人为此支付了巨额费用。"}, {"type": "subtitle", "time": 14192.389, "timestamp": "03:56:32", "text": "嗯，我的意思是，或许你或许能够"}, {"type": "subtitle", "time": 14194.309, "timestamp": "03:56:34", "text": "找一个带英文键盘的，因为你"}, {"type": "subtitle", "time": 14197.63, "timestamp": "03:56:37", "text": "知道日本可能"}, {"type": "subtitle", "time": 14201.11, "timestamp": "03:56:41", "text": "是的，有些公司可能会生产"}, {"type": "subtitle", "time": 14204.229, "timestamp": "03:56:44", "text": "一。是的。"}, {"type": "subtitle", "time": 14206.469, "timestamp": "03:56:46", "text": "但我觉得关键就在这里，因为"}, {"type": "subtitle", "time": 14208.15, "timestamp": "03:56:48", "text": "他们知道那些事情会有点……"}, {"type": "subtitle", "time": 14209.99, "timestamp": "03:56:49", "text": "有点贵。"}, {"type": "subtitle", "time": 14217.83, "timestamp": "03:56:57", "text": "我觉得在日本，每个人都有"}]
[{"type": "subtitle", "time": 11040.389, "timestamp": "03:04:00", "text": "直播流没有被静音吧？因为"}, {"type": "subtitle", "time": 11042.95, "timestamp": "03:04:02", "text": "我不想让你说话。你"}, {"type": "subtitle", "time": 11045.51, "timestamp": "03:04:05", "text": "我们在交谈。嗯，我被他们屏蔽了。"}, {"type": "subtitle", "time": 11049.51, "timestamp": "03:04:09", "text": "是的。不用担心。"}, {"type": "subtitle", "time": 11051.269, "timestamp": "03:04:11", "text": "好的。"}, {"type": "subtitle", "time": 11054.71, "timestamp": "03:04:14", "text": "是的。太多事情了。"}, {"type": "subtitle", "time": 11056.389, "timestamp": "03:04:16", "text": "是的。就像很多事情一样。是的。我们是"}, {"type": "subtitle", "time": 11058.389, "timestamp": "03:04:18", "text": "就像现在这样，正在赶进度"}, {"type": "subtitle", "time": 11060.23, "timestamp": "03:04:20", "text": "我们为了谈话而编造的东西。我不"}, {"type": "subtitle", "time": 11063.63, "timestamp": "03:04:23", "text": "再想想。"}, {"type": "subtitle", "time": 11066.87, "timestamp": "03:04:26", "text": "是的。我很高兴我们能叙叙旧，因为"}, {"type": "subtitle", "time": 11069.349, "timestamp": "03:04:29", "text": "我相信我们现在没有时间……"}, {"type": "subtitle", "time": 11071.83, "timestamp": "03:04:31", "text": "把所有事情都补上。你很爱撒娇。"}, {"type": "subtitle", "time": 11073.309, "timestamp": "03:04:33", "text": "我当时"}, {"type": "subtitle", "time": 11076.87, "timestamp": "03:04:36", "text": "占领。是的。是的。我差不多就是这样"}, {"type": "subtitle", "time": 11078.79, "timestamp": "03:04:38", "text": "晚上有空，然后就没事了。"}, {"type": "subtitle", "time": 11084.429, "timestamp": "03:04:44", "text": "[音乐]"}, {"type": "subtitle", "time": 11087.83, "timestamp": "03:04:47", "text": "嗯"}, {"type": "subtitle", "time": 11089.19, "timestamp": "03:04:49", "text": "你知道吗，我有点希望我能得到我的"}, {"type": "subtitle", "time": 11092.71, "timestamp": "03:04:52", "text": "笔记本电脑至少一年一次吧"}, {"type": "subtitle", "time": 11094.6, "timestamp": "03:04:54", "text": "更早。"}, {"type": "subtitle", "time": 11096.07, "timestamp": "03:04:56", "text": "[音乐]"}, {"type": "subtitle", "time": 11098.23, "timestamp": "03:04:58", "text": "是的，因为我喜欢这样的机会。"}]
[{"type": "subtitle", "time": 22380.708, "timestamp": "06:13:00", "text": "椅子、さあ行こう、なんて呼ぶんだっけ"}, {"type": "subtitle", "time": 22383.868, "timestamp": "06:13:03", "text": "おい、もっと大きな椅子が必要だ。"}, {"type": "subtitle", "time": 22385.468, "timestamp": "06:13:05", "text": "このハロウィーンで何をするか、私はしない"}, {"type": "subtitle", "time": 22388.708, "timestamp": "06:13:08", "text": "実際、何も知らない"}, {"type": "subtitle", "time": 22391.07, "timestamp": "06:13:11", "text": "実際そうする、それは良いことだ"}, {"type": "subtitle", "time": 22393.83, "timestamp": "06:13:13", "text": "でも質問なんだけど、ああ、やりたかったんだ"}, {"type": "subtitle", "time": 22398.27, "timestamp": "06:13:18", "text": "ホラー配信だけど、私の"}, {"type": "subtitle", "time": 22401.59, "timestamp": "06:13:21", "text": "状況的に私はほとんど何もできません"}, {"type": "subtitle", "time": 22405.03, "timestamp": "06:13:25", "text": "今年は特にそうだと思います。"}, {"type": "subtitle", "time": 22407.948, "timestamp": "06:13:27", "text": "何か質問があれば遠慮なく聞いてください"}, {"type": "subtitle", "time": 22411.67, "timestamp": "06:13:31", "text": "私はホラー作品をあまり作ったことがない"}, {"type": "subtitle", "time": 22416.51, "timestamp": "06:13:36", "text": "まだだ、まだだ、待つことに足がない"}, {"type": "subtitle", "time": 22418.39, "timestamp": "06:13:38", "text": "このモデルでさらに色々なことをやってみようと思っています"}, {"type": "subtitle", "time": 22422.35, "timestamp": "06:13:42", "text": "だから、これは1.0モデルです。"}, {"type": "subtitle", "time": 22425.99, "timestamp": "06:13:45", "text": "だから私は足のないギャングに行くんだ、私は"}, {"type": "subtitle", "time": 22428.31, "timestamp": "06:13:48", "text": "このモデルにめちゃくちゃ詰め込むつもり"}, {"type": "subtitle", "time": 22432.31, "timestamp": "06:13:52", "text": "ああ、神様、もっとあげよう"}, {"type": "subtitle", "time": 22435.83, "timestamp": "06:13:55", "text": "ジャックみたいに足がない、そう、足のないギャングよ、さあ行こう"}, {"type": "subtitle", "time": 22439.11, "timestamp": "06:13:59", "text": "脚を伸ばそう、なんてこった、とジャックは言った。"}]
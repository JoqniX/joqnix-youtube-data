[{"type": "subtitle", "time": 11401.51, "timestamp": "03:10:01", "text": "最後に配信したのは8月13日だったと思う。"}, {"type": "subtitle", "time": 11405.469, "timestamp": "03:10:05", "text": "または14番地、それで、それ以来私は"}, {"type": "subtitle", "time": 11407.59, "timestamp": "03:10:07", "text": "自分に「うん」と言い続けた"}, {"type": "subtitle", "time": 11412.229, "timestamp": "03:10:12", "text": "休止を発表します"}, {"type": "subtitle", "time": 11416.229, "timestamp": "03:10:16", "text": "戻ってきて、私には時間が必要なの"}, {"type": "subtitle", "time": 11418.389, "timestamp": "03:10:18", "text": "多くの"}, {"type": "subtitle", "time": 11424.83, "timestamp": "03:10:24", "text": "えっと、そう、大変だったんだ"}, {"type": "subtitle", "time": 11427.75, "timestamp": "03:10:27", "text": "どうしても戻ってきたかったのは、"}, {"type": "subtitle", "time": 11436.71, "timestamp": "03:10:36", "text": "情熱的に"}, {"type": "subtitle", "time": 11439.59, "timestamp": "03:10:39", "text": "そして私はそれを"}, {"type": "subtitle", "time": 11442.429, "timestamp": "03:10:42", "text": "感傷的なこと、私は決して意図していなかった"}, {"type": "subtitle", "time": 11446.15, "timestamp": "03:10:46", "text": "この配信が感情的になるには、でも私は"}, {"type": "subtitle", "time": 11447.99, "timestamp": "03:10:47", "text": "制御できなかった"}, {"type": "subtitle", "time": 11449.269, "timestamp": "03:10:49", "text": "私の感情"}, {"type": "subtitle", "time": 11453.15, "timestamp": "03:10:53", "text": "今日は、広告に関してはいろいろと忙しいので"}, {"type": "subtitle", "time": 11456.19, "timestamp": "03:10:56", "text": "試験が近づいています"}, {"type": "subtitle", "time": 11458.87, "timestamp": "03:10:58", "text": "12月は責任がたくさんあるので"}]
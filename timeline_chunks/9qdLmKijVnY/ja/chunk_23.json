[{"type": "subtitle", "time": 1386.909, "timestamp": "00:23:06", "text": "さようなら、最高にしよう"}, {"type": "subtitle", "time": 1390.149, "timestamp": "00:23:10", "text": "正直言って、私は改善する必要がある。"}, {"type": "subtitle", "time": 1393.789, "timestamp": "00:23:13", "text": "最初のものには多くの問題がある"}, {"type": "subtitle", "time": 1396.47, "timestamp": "00:23:16", "text": "1ヶ月なんて、1ヶ月じゃないって分かってるよ"}, {"type": "subtitle", "time": 1399.549, "timestamp": "00:23:19", "text": "それでも、私はそれを1つとして数える"}, {"type": "subtitle", "time": 1401.07, "timestamp": "00:23:21", "text": "月"}, {"type": "subtitle", "time": 1404.47, "timestamp": "00:23:24", "text": "なぜなら彼らは月々のように月々のように"}, {"type": "subtitle", "time": 1407.149, "timestamp": "00:23:27", "text": "日付的には月末になります"}, {"type": "subtitle", "time": 1410.149, "timestamp": "00:23:30", "text": "今月の"}, {"type": "subtitle", "time": 1412.31, "timestamp": "00:23:32", "text": "1ヶ月間は"}, {"type": "subtitle", "time": 1413.23, "timestamp": "00:23:33", "text": "4月"}, {"type": "subtitle", "time": 1421.23, "timestamp": "00:23:41", "text": "うん、とにかく、歯を磨くよ"}, {"type": "subtitle", "time": 1424.23, "timestamp": "00:23:44", "text": "歯も何もかも手に入れようとして"}, {"type": "subtitle", "time": 1427.11, "timestamp": "00:23:47", "text": "朝食に何か食べるよ。また来るね。"}]
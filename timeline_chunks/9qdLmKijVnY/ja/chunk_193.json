[{"type": "subtitle", "time": 11580.67, "timestamp": "03:13:00", "text": "保持する"}, {"type": "subtitle", "time": 11584.59, "timestamp": "03:13:04", "text": "今後私は"}, {"type": "subtitle", "time": 11586.55, "timestamp": "03:13:06", "text": "全力を尽くす、無理強いはしたくない"}, {"type": "subtitle", "time": 11590.349, "timestamp": "03:13:10", "text": "私自身はもうストリーミングしたくない"}, {"type": "subtitle", "time": 11594.229, "timestamp": "03:13:14", "text": "幸せな時だけストリーミングします。私はやり方を知っています。"}, {"type": "subtitle", "time": 11598.229, "timestamp": "03:13:18", "text": "皆さんは幸せなJが好きですか？"}, {"type": "subtitle", "time": 11600.75, "timestamp": "03:13:20", "text": "楽しいジョークは、あなたが"}, {"type": "subtitle", "time": 11603.99, "timestamp": "03:13:23", "text": "笑って、あなたたちのうちの一人がそう言った"}, {"type": "subtitle", "time": 11606.99, "timestamp": "03:13:26", "text": "昔々、そしてその言葉は"}, {"type": "subtitle", "time": 11611.91, "timestamp": "03:13:31", "text": "何日もずっと私の心の中で"}, {"type": "subtitle", "time": 11615.71, "timestamp": "03:13:35", "text": "hias でも今は"}, {"type": "subtitle", "time": 11617.229, "timestamp": "03:13:37", "text": "取っている"}, {"type": "subtitle", "time": 11620.99, "timestamp": "03:13:40", "text": "癒しのステップを踏み、最善を尽くして"}, {"type": "subtitle", "time": 11623.389, "timestamp": "03:13:43", "text": "戻ると"}, {"type": "subtitle", "time": 11629.03, "timestamp": "03:13:49", "text": "時間があるけど、できる限り来ます"}, {"type": "subtitle", "time": 11634.55, "timestamp": "03:13:54", "text": "ポジティブな話題に戻ります、はい、こんにちは"}, {"type": "subtitle", "time": 11638.389, "timestamp": "03:13:58", "text": "えっと、ほとんどのことは伝えられたと思います"}]
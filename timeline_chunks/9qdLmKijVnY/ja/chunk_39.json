[{"type": "subtitle", "time": 2340.069, "timestamp": "00:39:00", "text": "ああ、神様、私はとても"}, {"type": "subtitle", "time": 2342.829, "timestamp": "00:39:02", "text": "これは興奮している"}, {"type": "subtitle", "time": 2347.27, "timestamp": "00:39:07", "text": "楽しいので、ここにはいくつかの変更があります"}, {"type": "subtitle", "time": 2354.79, "timestamp": "00:39:14", "text": "外"}, {"type": "subtitle", "time": 2358.15, "timestamp": "00:39:18", "text": "ああ、なんてことだ、新しい銃は"}, {"type": "subtitle", "time": 2360.67, "timestamp": "00:39:20", "text": "知らない人のために銃を手に入れた"}, {"type": "subtitle", "time": 2363.19, "timestamp": "00:39:23", "text": "シーズン中、私たちは挑戦し、すべてが"}, {"type": "subtitle", "time": 2367.39, "timestamp": "00:39:27", "text": "これが私たちが手に入れた銃で、"}, {"type": "subtitle", "time": 2370.03, "timestamp": "00:39:30", "text": "永遠に、でも私は実際に全部やった"}, {"type": "subtitle", "time": 2373.55, "timestamp": "00:39:33", "text": "課題やその他すべて"}, {"type": "subtitle", "time": 2376.589, "timestamp": "00:39:36", "text": "ついに手に入れた"}, {"type": "subtitle", "time": 2378.309, "timestamp": "00:39:38", "text": "わーい"}, {"type": "subtitle", "time": 2381.99, "timestamp": "00:39:41", "text": "はい、ではウルタの能力は？"}, {"type": "subtitle", "time": 2389.91, "timestamp": "00:39:49", "text": "これを解明する F2 F1 いいえ F3 はどうすればいいですか?"}, {"type": "subtitle", "time": 2393.27, "timestamp": "00:39:53", "text": "ああ、私は何をしたんだ"}, {"type": "subtitle", "time": 2399.109, "timestamp": "00:39:59", "text": "待って、私何をしたの？ああ、まずい"}]
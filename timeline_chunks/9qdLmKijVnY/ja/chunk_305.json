[{"type": "subtitle", "time": 18310.39, "timestamp": "05:05:10", "text": "4時、私はまた眠り、6時までに目を覚ました"}, {"type": "subtitle", "time": 18313.788, "timestamp": "05:05:13", "text": "いや、6じゃない、6じゃない、実際は30だ"}, {"type": "subtitle", "time": 18317.07, "timestamp": "05:05:17", "text": "30分後、私は眠りました"}, {"type": "subtitle", "time": 18320.39, "timestamp": "05:05:20", "text": "また目が覚めた、眠っていなかった"}, {"type": "subtitle", "time": 18324.19, "timestamp": "05:05:24", "text": "また、それはしばらくそのように進んでいました"}, {"type": "subtitle", "time": 18328.15, "timestamp": "05:05:28", "text": "30分後に目が覚めると、私は眠っている。"}, {"type": "subtitle", "time": 18331.43, "timestamp": "05:05:31", "text": "また同じようなことがあったら、私は"}, {"type": "subtitle", "time": 18335.19, "timestamp": "05:05:35", "text": "6時半から10時まで起きて、それから寝た"}, {"type": "subtitle", "time": 18344.23, "timestamp": "05:05:44", "text": "目が覚めたら、そう、そんな感じだったんだけど"}, {"type": "subtitle", "time": 18346.83, "timestamp": "05:05:46", "text": "昨日は正直に言うと、今は"}, {"type": "subtitle", "time": 18348.948, "timestamp": "05:05:48", "text": "眠ることさえできなかった"}, {"type": "subtitle", "time": 18352.628, "timestamp": "05:05:52", "text": "一体何が悪かったんだろう"}, {"type": "subtitle", "time": 18356.35, "timestamp": "05:05:56", "text": "その間に何が起こったのか、私の"}, {"type": "subtitle", "time": 18358.07, "timestamp": "05:05:58", "text": "睡眠スケジュールはすべて順調だった"}]
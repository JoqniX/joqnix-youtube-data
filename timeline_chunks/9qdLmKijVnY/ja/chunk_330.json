[{"type": "subtitle", "time": 19801.75, "timestamp": "05:30:01", "text": "ヘスを見る"}, {"type": "subtitle", "time": 19809.868, "timestamp": "05:30:09", "text": "重要だった、プレイして楽しかった、楽しかった"}, {"type": "subtitle", "time": 19812.83, "timestamp": "05:30:12", "text": "あなたと一緒に遊ぶために"}, {"type": "subtitle", "time": 19815.39, "timestamp": "05:30:15", "text": "参加します。VCにいますので、参加してください。"}, {"type": "subtitle", "time": 19818.15, "timestamp": "05:30:18", "text": "ストリーミングが終わったら、彼は何も"}, {"type": "subtitle", "time": 19820.868, "timestamp": "05:30:20", "text": "私のプレイ"}, {"type": "subtitle", "time": 19823.47, "timestamp": "05:30:23", "text": "ジョークを一つ練習しようかな"}, {"type": "subtitle", "time": 19826.43, "timestamp": "05:30:26", "text": "私のaとちょうど"}, {"type": "subtitle", "time": 19830.39, "timestamp": "05:30:30", "text": "えっと、他に何か見逃したかな？キャッチしたよ"}, {"type": "subtitle", "time": 19831.708, "timestamp": "05:30:31", "text": "立ち上がる"}, {"type": "subtitle", "time": 19838.31, "timestamp": "05:30:38", "text": "チャットですが、これも学習です"}, {"type": "subtitle", "time": 19841.628, "timestamp": "05:30:41", "text": "これもまた学びとなる経験です"}, {"type": "subtitle", "time": 19844.548, "timestamp": "05:30:44", "text": "特にそれが"}, {"type": "subtitle", "time": 19847.868, "timestamp": "05:30:47", "text": "ゲームストリームゲームには、"}, {"type": "subtitle", "time": 19850.548, "timestamp": "05:30:50", "text": "焦点が定まらない時がある"}, {"type": "subtitle", "time": 19858.15, "timestamp": "05:30:58", "text": "チャットは読まなければならなかったけど"}]
[{"type": "subtitle", "time": 2880.069, "timestamp": "00:48:00", "text": "店とそこにあるすべてのものはまるで"}, {"type": "subtitle", "time": 2882.069, "timestamp": "00:48:02", "text": "進行状況とかその他諸々"}, {"type": "subtitle", "time": 2884.23, "timestamp": "00:48:04", "text": "新しい"}, {"type": "subtitle", "time": 2886.71, "timestamp": "00:48:06", "text": "通貨とか色々、彼らは完全に"}, {"type": "subtitle", "time": 2889.27, "timestamp": "00:48:09", "text": "ガチャモード、なぜ彼らはコピーしているのでしょうか"}, {"type": "subtitle", "time": 2892.23, "timestamp": "00:48:12", "text": "彼らは下忍みたいなことをやってるのか？"}, {"type": "subtitle", "time": 2894.99, "timestamp": "00:48:14", "text": "なぜ、なぜ、なぜ彼らは"}, {"type": "subtitle", "time": 2899.95, "timestamp": "00:48:19", "text": "これと新しいエキゾチック"}, {"type": "subtitle", "time": 2903.23, "timestamp": "00:48:23", "text": "エキゾチックなショットでオーバーヒートして"}, {"type": "subtitle", "time": 2906.829, "timestamp": "00:48:26", "text": "ミスティック、あぁ、待って、これすごくクール"}, {"type": "subtitle", "time": 2911.349, "timestamp": "00:48:31", "text": "ちょっと待って、このスキンが欲しいんだけど"}, {"type": "subtitle", "time": 2914.829, "timestamp": "00:48:34", "text": "これがとてもかわいい虹色です"}, {"type": "subtitle", "time": 2917.87, "timestamp": "00:48:37", "text": "紫もいいですね、それが私の好みのスタイルです"}, {"type": "subtitle", "time": 2922.19, "timestamp": "00:48:42", "text": "こんにちは、ロッコさん、こんにちは、お元気ですか？"}, {"type": "subtitle", "time": 2926.069, "timestamp": "00:48:46", "text": "ディオン、お金を使うと"}]
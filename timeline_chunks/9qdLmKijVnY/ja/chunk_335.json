[{"type": "subtitle", "time": 20100.868, "timestamp": "05:35:00", "text": "ああ、バカになって台無しにする"}, {"type": "subtitle", "time": 20104.19, "timestamp": "05:35:04", "text": "人のSM、そしてそれは"}, {"type": "subtitle", "time": 20106.548, "timestamp": "05:35:06", "text": "他の人たちやチャットでも"}, {"type": "subtitle", "time": 20109.67, "timestamp": "05:35:09", "text": "みんなが快適に感じて、"}, {"type": "subtitle", "time": 20112.15, "timestamp": "05:35:12", "text": "そういう人は"}, {"type": "subtitle", "time": 20116.43, "timestamp": "05:35:16", "text": "普通にすればいいし、そう、"}, {"type": "subtitle", "time": 20118.548, "timestamp": "05:35:18", "text": "いつでも配信を終了できます"}, {"type": "subtitle", "time": 20121.03, "timestamp": "05:35:21", "text": "見たいものが見つからなければ、"}, {"type": "subtitle", "time": 20124.23, "timestamp": "05:35:24", "text": "何かのフォローを解除する"}, {"type": "subtitle", "time": 20129.11, "timestamp": "05:35:29", "text": "そう、台無しにしないで、"}, {"type": "subtitle", "time": 20129.99, "timestamp": "05:35:29", "text": "えーと"}, {"type": "subtitle", "time": 20132.59, "timestamp": "05:35:32", "text": "不快なコメントとか、そういう類のこと"}, {"type": "subtitle", "time": 20135.47, "timestamp": "05:35:35", "text": "頻繁に起こっていることと"}, {"type": "subtitle", "time": 20140.51, "timestamp": "05:35:40", "text": "昨日も私の古い"}, {"type": "subtitle", "time": 20143.03, "timestamp": "05:35:43", "text": "アカウントなので"}, {"type": "subtitle", "time": 20145.15, "timestamp": "05:35:45", "text": "うん"}, {"type": "subtitle", "time": 20150.548, "timestamp": "05:35:50", "text": "だから、でも、それでも、すべての人々が"}, {"type": "subtitle", "time": 20155.15, "timestamp": "05:35:55", "text": "私とチャットしましょう K LOVE も愛の一部です"}]
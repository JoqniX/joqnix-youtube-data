[{"type": "subtitle", "time": 11640.469, "timestamp": "03:14:00", "text": "うん"}, {"type": "subtitle", "time": 11647.03, "timestamp": "03:14:07", "text": "えっと、この配信はすごく短いものになります"}, {"type": "subtitle", "time": 11650.55, "timestamp": "03:14:10", "text": "30分くらいの動画を作ってるよ"}, {"type": "subtitle", "time": 11655.03, "timestamp": "03:14:15", "text": "なぜならそれは、"}, {"type": "subtitle", "time": 11657.59, "timestamp": "03:14:17", "text": "多くの"}, {"type": "subtitle", "time": 11659.99, "timestamp": "03:14:19", "text": "ええと、そうですね、それが私がしたかったことです"}, {"type": "subtitle", "time": 11663.71, "timestamp": "03:14:23", "text": "えっと、私は"}, {"type": "subtitle", "time": 11669.07, "timestamp": "03:14:29", "text": "戻ってきて、新たなスタートを切る"}, {"type": "subtitle", "time": 11672.429, "timestamp": "03:14:32", "text": "ある意味、それは新たな始まりのようなものだ。"}, {"type": "subtitle", "time": 11676.91, "timestamp": "03:14:36", "text": "だって、数ヶ月の間に"}, {"type": "subtitle", "time": 11680.19, "timestamp": "03:14:40", "text": "私の状態からお気づきかもしれませんが"}, {"type": "subtitle", "time": 11684.51, "timestamp": "03:14:44", "text": "私は自分がしていることを楽しんでいない"}, {"type": "subtitle", "time": 11687.67, "timestamp": "03:14:47", "text": "ゲームであろうと"}, {"type": "subtitle", "time": 11691.309, "timestamp": "03:14:51", "text": "多様な流れ"}, {"type": "subtitle", "time": 11695.51, "timestamp": "03:14:55", "text": "私の環境は多くのものだったので、何でも"}, {"type": "subtitle", "time": 11699.389, "timestamp": "03:14:59", "text": "多すぎたし、私自身も"}]
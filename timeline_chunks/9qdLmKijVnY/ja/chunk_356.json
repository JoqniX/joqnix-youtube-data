[{"type": "subtitle", "time": 21361.708, "timestamp": "05:56:01", "text": "あなたたち全員は戦争に値する"}, {"type": "subtitle", "time": 21363.99, "timestamp": "05:56:03", "text": "頭突き、お疲れ様でした。"}, {"type": "subtitle", "time": 21367.548, "timestamp": "05:56:07", "text": "そして今日あなたがしたことすべて"}, {"type": "subtitle", "time": 21372.31, "timestamp": "05:56:12", "text": "M、気をつけて、いや、みんなが気をつけるわけじゃない"}, {"type": "subtitle", "time": 21375.03, "timestamp": "05:56:15", "text": "とはいえ、それは冗談だし、見てみよう"}, {"type": "subtitle", "time": 21380.75, "timestamp": "05:56:20", "text": "土曜日と"}, {"type": "subtitle", "time": 21386.868, "timestamp": "05:56:26", "text": "バイバイ"}]
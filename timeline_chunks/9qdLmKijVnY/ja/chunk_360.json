[{"type": "subtitle", "time": 21602.91, "timestamp": "06:00:02", "text": "ストリームを開始しますが、皆さんに"}, {"type": "subtitle", "time": 21604.35, "timestamp": "06:00:04", "text": "取る"}, {"type": "subtitle", "time": 21607.11, "timestamp": "06:00:07", "text": "ちょっと皆さんに少し時間を取ってほしい"}, {"type": "subtitle", "time": 21615.99, "timestamp": "06:00:15", "text": "ミックスデビューストリーム2Dライブライブ2Dを見る"}, {"type": "subtitle", "time": 21619.788, "timestamp": "06:00:19", "text": "モデルデビュー配信を今見た"}, {"type": "subtitle", "time": 21622.67, "timestamp": "06:00:22", "text": "やろうとしていたのは、"}, {"type": "subtitle", "time": 21625.51, "timestamp": "06:00:25", "text": "ウォッチする"}, {"type": "subtitle", "time": 21630.39, "timestamp": "06:00:30", "text": "一緒に、でも彼はすでに始めていたから、私は"}, {"type": "subtitle", "time": 21635.35, "timestamp": "06:00:35", "text": "君たちが応援に行くのは当然だ"}, {"type": "subtitle", "time": 21640.99, "timestamp": "06:00:40", "text": "はい、どうぞ、これがリンクです"}, {"type": "subtitle", "time": 21644.35, "timestamp": "06:00:44", "text": "シア・ザ・ウィッキーのために"}, {"type": "subtitle", "time": 21646.11, "timestamp": "06:00:46", "text": "男の子"}, {"type": "subtitle", "time": 21658.11, "timestamp": "06:00:58", "text": "ああ、なんてことだ、私だけ、ちょっと具合が悪い"}]
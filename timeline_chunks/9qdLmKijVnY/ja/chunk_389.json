[{"type": "subtitle", "time": 23341.67, "timestamp": "06:29:01", "text": "彼らはうまくやっている"}, {"type": "subtitle", "time": 23345.548, "timestamp": "06:29:05", "text": "実際そうなんです"}, {"type": "subtitle", "time": 23348.628, "timestamp": "06:29:08", "text": "とても良い返信をしました"}, {"type": "subtitle", "time": 23352.35, "timestamp": "06:29:12", "text": "悪い 私は全く準備ができていない"}, {"type": "subtitle", "time": 23354.91, "timestamp": "06:29:14", "text": "会話が良くない"}, {"type": "subtitle", "time": 23357.948, "timestamp": "06:29:17", "text": "ああ、私たちはずっと前から見ていたんですね"}, {"type": "subtitle", "time": 23360.83, "timestamp": "06:29:20", "text": "えーっと、配信開始30分"}, {"type": "subtitle", "time": 23362.59, "timestamp": "06:29:22", "text": "そう、だからどれくらい続くかわからない"}, {"type": "subtitle", "time": 23363.31, "timestamp": "06:29:23", "text": "なれ"}, {"type": "subtitle", "time": 23367.91, "timestamp": "06:29:27", "text": "ストリーミングですが、えっと、私の"}, {"type": "subtitle", "time": 23371.548, "timestamp": "06:29:31", "text": "ストリームをもっと良くします、最善を尽くします"}, {"type": "subtitle", "time": 23374.868, "timestamp": "06:29:34", "text": "えっと、すごく気分が悪いんです"}, {"type": "subtitle", "time": 23378.67, "timestamp": "06:29:38", "text": "熱があるから、きっと熱があると思う"}, {"type": "subtitle", "time": 23380.91, "timestamp": "06:29:40", "text": "ひどく脱水症状を感じた"}, {"type": "subtitle", "time": 23385.468, "timestamp": "06:29:45", "text": "今日、とにかくこの広告を釣ります、ああ"}, {"type": "subtitle", "time": 23388.15, "timestamp": "06:29:48", "text": "Twitchで視聴している人たちは"}, {"type": "subtitle", "time": 23391.23, "timestamp": "06:29:51", "text": "広告が出るだろう"}, {"type": "subtitle", "time": 23394.468, "timestamp": "06:29:54", "text": "すみません、"}, {"type": "subtitle", "time": 23397.51, "timestamp": "06:29:57", "text": "痛みはありますが、いつでも覚えておいてください"}]
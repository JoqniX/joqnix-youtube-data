[{"type": "subtitle", "time": 13740.75, "timestamp": "03:49:00", "text": "一緒に、えっと、３年間かけて"}, {"type": "subtitle", "time": 13744.83, "timestamp": "03:49:04", "text": "次の番だと思う、私たちが"}, {"type": "subtitle", "time": 13747.149, "timestamp": "03:49:07", "text": "プレイできる"}, {"type": "subtitle", "time": 13750.55, "timestamp": "03:49:10", "text": "えーっと、遊ぶ方法があるんだけど"}, {"type": "subtitle", "time": 13752.75, "timestamp": "03:49:12", "text": "この物"}, {"type": "subtitle", "time": 13755.269, "timestamp": "03:49:15", "text": "残念ながらデュオ"}, {"type": "subtitle", "time": 13756.71, "timestamp": "03:49:16", "text": "あなたはそこにいる"}, {"type": "subtitle", "time": 13760.07, "timestamp": "03:49:20", "text": "それは"}, {"type": "subtitle", "time": 13765.269, "timestamp": "03:49:25", "text": "いいよ、バックミュージックを少し残しておくよ"}, {"type": "subtitle", "time": 13774.79, "timestamp": "03:49:34", "text": "もう、あ、待って、Z、名前を変えたよ"}, {"type": "subtitle", "time": 13780.79, "timestamp": "03:49:40", "text": "三角形 みなさんこんにちは ch ええこんにちは"}]
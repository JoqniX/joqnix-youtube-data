[{"type": "subtitle", "time": 21181.83, "timestamp": "05:53:01", "text": "了解しました。ああ、私は"}, {"type": "subtitle", "time": 21183.788, "timestamp": "05:53:03", "text": "待って"}, {"type": "subtitle", "time": 21187.948, "timestamp": "05:53:07", "text": "神様、どうしてこんなことを忘れてしまったんだろう"}, {"type": "subtitle", "time": 21190.59, "timestamp": "05:53:10", "text": "どうやら私が"}, {"type": "subtitle", "time": 21192.788, "timestamp": "05:53:12", "text": "プレイしていた時はそうするべきだった"}, {"type": "subtitle", "time": 21195.75, "timestamp": "05:53:15", "text": "このダイナミック照明に切り替える"}, {"type": "subtitle", "time": 21197.948, "timestamp": "05:53:17", "text": "物"}, {"type": "subtitle", "time": 21203.11, "timestamp": "05:53:23", "text": "忘れてた、実際にやることを忘れてた"}, {"type": "subtitle", "time": 21206.31, "timestamp": "05:53:26", "text": "これは本当は変更するはずだった"}, {"type": "subtitle", "time": 21209.67, "timestamp": "05:53:29", "text": "このダイナミックライティング"}, {"type": "subtitle", "time": 21213.19, "timestamp": "05:53:33", "text": "何かを開くとき、"}, {"type": "subtitle", "time": 21216.03, "timestamp": "05:53:36", "text": "ゲームで私が発砲するとき、またはすべてのシーンを見る"}, {"type": "subtitle", "time": 21217.83, "timestamp": "05:53:37", "text": "色CH、これが私の背景です"}, {"type": "subtitle", "time": 21220.788, "timestamp": "05:53:40", "text": "実際は青い背景"}, {"type": "subtitle", "time": 21223.35, "timestamp": "05:53:43", "text": "星座 忘れた 次のストリーム"}, {"type": "subtitle", "time": 21225.11, "timestamp": "05:53:45", "text": "忘れない"}, {"type": "subtitle", "time": 21227.43, "timestamp": "05:53:47", "text": "わかった"}, {"type": "subtitle", "time": 21230.23, "timestamp": "05:53:50", "text": "イェーイ、新しい照明フィルター"}, {"type": "subtitle", "time": 21232.07, "timestamp": "05:53:52", "text": "あれですね"}, {"type": "subtitle", "time": 21235.948, "timestamp": "05:53:55", "text": "そう、そういう感じで実験していくんだ"}, {"type": "subtitle", "time": 21239.23, "timestamp": "05:53:59", "text": "そして自分たちだけのユニークなものを作る"}]
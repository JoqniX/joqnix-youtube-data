[{"type": "subtitle", "time": 4384.709, "timestamp": "01:13:04", "text": "私の中に円があるのは良いことだ"}, {"type": "subtitle", "time": 4386.99, "timestamp": "01:13:06", "text": "だから私は"}, {"type": "subtitle", "time": 4390.149, "timestamp": "01:13:10", "text": "人が入ってくるかもしれないのが怖い"}, {"type": "subtitle", "time": 4392.55, "timestamp": "01:13:12", "text": "戦いが必要になるかもしれないが、すでに"}, {"type": "subtitle", "time": 4398.31, "timestamp": "01:13:18", "text": "中は、誰かがここを通ったんだ"}, {"type": "subtitle", "time": 4406.189, "timestamp": "01:13:26", "text": "[拍手]"}, {"type": "subtitle", "time": 4427.59, "timestamp": "01:13:47", "text": "男の子たち、ああ神様、彼を騙す"}]
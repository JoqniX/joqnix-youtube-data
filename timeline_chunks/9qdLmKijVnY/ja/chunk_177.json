[{"type": "subtitle", "time": 10620.71, "timestamp": "02:57:00", "text": "10,000回目で、最初の試みが1回目です。"}, {"type": "subtitle", "time": 10622.71, "timestamp": "02:57:02", "text": "あなたが選ぶ場所"}, {"type": "subtitle", "time": 10625.67, "timestamp": "02:57:05", "text": "異なる方法で、あなたが現れる場所"}, {"type": "subtitle", "time": 10628.75, "timestamp": "02:57:08", "text": "あなた自身が"}, {"type": "subtitle", "time": 10633.349, "timestamp": "02:57:13", "text": "問題は、私たちの過ちが鎖ではないということです。"}, {"type": "subtitle", "time": 10637.67, "timestamp": "02:57:17", "text": "教訓は永続的な州ではないが"}, {"type": "subtitle", "time": 10639.19, "timestamp": "02:57:19", "text": "一時的"}, {"type": "subtitle", "time": 10642.5, "timestamp": "02:57:22", "text": "私たちが通り過ぎる風景"}, {"type": "subtitle", "time": 10644.229, "timestamp": "02:57:24", "text": "[音楽]"}, {"type": "subtitle", "time": 10647.79, "timestamp": "02:57:27", "text": "これまで感じたことのあるすべての人へ"}, {"type": "subtitle", "time": 10649.19, "timestamp": "02:57:29", "text": "彼らです"}, {"type": "subtitle", "time": 10652.63, "timestamp": "02:57:32", "text": "あなたの光は落ちた"}, {"type": "subtitle", "time": 10655.99, "timestamp": "02:57:35", "text": "あなたの道は狭まりません"}, {"type": "subtitle", "time": 10666.19, "timestamp": "02:57:46", "text": "あなたの星の各断片が"}, {"type": "subtitle", "time": 10668.91, "timestamp": "02:57:48", "text": "潜在的"}, {"type": "subtitle", "time": 10673.07, "timestamp": "02:57:53", "text": "それぞれの破片は"}, {"type": "subtitle", "time": 10678.389, "timestamp": "02:57:58", "text": "光は、あらゆる瞬間にチャンスを与えてくれます"}]
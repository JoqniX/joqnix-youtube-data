[{"type": "subtitle", "time": 13021.75, "timestamp": "03:37:01", "text": "何を許して、私はあなたの"}, {"type": "subtitle", "time": 13024.71, "timestamp": "03:37:04", "text": "ヘッド ヘッドしてあげるか、これを受け取って"}, {"type": "subtitle", "time": 13032.189, "timestamp": "03:37:12", "text": "あまりにも"}, {"type": "subtitle", "time": 13036.349, "timestamp": "03:37:16", "text": "ばかばかしい、チャンスは一度だけだった"}, {"type": "subtitle", "time": 13038.83, "timestamp": "03:37:18", "text": "君が持っているってどういう意味？"}, {"type": "subtitle", "time": 13046.11, "timestamp": "03:37:26", "text": "つまり、私は"}, {"type": "subtitle", "time": 13048.67, "timestamp": "03:37:28", "text": "[音楽]"}, {"type": "subtitle", "time": 13051.75, "timestamp": "03:37:31", "text": "三角形、えっと、あなたは、えっと、あなたは"}, {"type": "subtitle", "time": 13055.03, "timestamp": "03:37:35", "text": "耐久ウォッチャー"}, {"type": "subtitle", "time": 13057.71, "timestamp": "03:37:37", "text": "改造するけど、自分のことはちゃんと気をつけてね"}, {"type": "subtitle", "time": 13059.63, "timestamp": "03:37:39", "text": "できない、耐えられない、私を見て、あなた"}, {"type": "subtitle", "time": 13062.309, "timestamp": "03:37:42", "text": "長時間視聴する必要がないので、"}, {"type": "subtitle", "time": 13066.03, "timestamp": "03:37:46", "text": "実際、そういうのをよく見かけるよ"}, {"type": "subtitle", "time": 13068.71, "timestamp": "03:37:48", "text": "よく見かける"}, {"type": "subtitle", "time": 13072.229, "timestamp": "03:37:52", "text": "実際、私はそれを見たことがあります"}, {"type": "subtitle", "time": 13075.429, "timestamp": "03:37:55", "text": "たくさん自分の面倒を見て"}, {"type": "subtitle", "time": 13077.51, "timestamp": "03:37:57", "text": "あなた自身は私をあまり見ないで"}]
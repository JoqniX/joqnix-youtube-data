[{"type": "subtitle", "time": 11281.55, "timestamp": "03:08:01", "text": "それ"}, {"type": "subtitle", "time": 11285.79, "timestamp": "03:08:05", "text": "talkxは"}, {"type": "subtitle", "time": 11289.11, "timestamp": "03:08:09", "text": "気に入った"}, {"type": "subtitle", "time": 11292.19, "timestamp": "03:08:12", "text": "それは私の夢の多くで構成されています"}, {"type": "subtitle", "time": 11296.03, "timestamp": "03:08:16", "text": "私はそれを諦めて、成功したかった"}, {"type": "subtitle", "time": 11298.03, "timestamp": "03:08:18", "text": "この旅を通してそれはとても大きな意味を持つ"}, {"type": "subtitle", "time": 11300.389, "timestamp": "03:08:20", "text": "それは単なるVペルソナではなく、"}, {"type": "subtitle", "time": 11305.79, "timestamp": "03:08:25", "text": "CHX のないストリーマーのものははるかに"}, {"type": "subtitle", "time": 11316.95, "timestamp": "03:08:36", "text": "少なくとも2024年のどこかの時点で私は"}, {"type": "subtitle", "time": 11323.15, "timestamp": "03:08:43", "text": "希望を失った、あるいは方向性が"}, {"type": "subtitle", "time": 11325.15, "timestamp": "03:08:45", "text": "そして私が望んだように"}, {"type": "subtitle", "time": 11329.429, "timestamp": "03:08:49", "text": "ジョーと共に前進する"}, {"type": "subtitle", "time": 11333.309, "timestamp": "03:08:53", "text": "だって、自分がやっていることに満足していなかったから"}, {"type": "subtitle", "time": 11334.91, "timestamp": "03:08:54", "text": "私"}, {"type": "subtitle", "time": 11338.67, "timestamp": "03:08:58", "text": "軽率な決断を繰り返し、"}]
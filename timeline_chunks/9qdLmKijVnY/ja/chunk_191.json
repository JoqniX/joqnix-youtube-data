[{"type": "subtitle", "time": 11460.87, "timestamp": "03:11:00", "text": "やらなければならないことがたくさんある"}, {"type": "subtitle", "time": 11463.469, "timestamp": "03:11:03", "text": "うん、そうだね"}, {"type": "subtitle", "time": 11466.83, "timestamp": "03:11:06", "text": "だから今日やるべきかどうか迷っていた"}, {"type": "subtitle", "time": 11469.11, "timestamp": "03:11:09", "text": "12月の初めまたは"}, {"type": "subtitle", "time": 11472.309, "timestamp": "03:11:12", "text": "1月にやるべきかな"}, {"type": "subtitle", "time": 11476.15, "timestamp": "03:11:16", "text": "でも正直、このまま続けていたら"}, {"type": "subtitle", "time": 11478.19, "timestamp": "03:11:18", "text": "計画と計画は決してうまくいかない"}, {"type": "subtitle", "time": 11481.11, "timestamp": "03:11:21", "text": "そうですね、だから私は行動を起こさなければなりません"}, {"type": "subtitle", "time": 11484.15, "timestamp": "03:11:24", "text": "私がそのINDで伝えたかったことは"}, {"type": "subtitle", "time": 11488.75, "timestamp": "03:11:28", "text": "ディレクトリメッセージは一歩踏み出す"}, {"type": "subtitle", "time": 11492.87, "timestamp": "03:11:32", "text": "前へ、そしてこれが私の前進の一歩です"}, {"type": "subtitle", "time": 11496.55, "timestamp": "03:11:36", "text": "私はここで"}, {"type": "subtitle", "time": 11499.91, "timestamp": "03:11:39", "text": "私は戻ってくることを決意しました"}, {"type": "subtitle", "time": 11508.19, "timestamp": "03:11:48", "text": "辞めるなんて、いや、辞められない"}, {"type": "subtitle", "time": 11510.79, "timestamp": "03:11:50", "text": "知っている人は知っている、彼らは知っている"}, {"type": "subtitle", "time": 11514.91, "timestamp": "03:11:54", "text": "この夢、この話はどれくらい"}, {"type": "subtitle", "time": 11516.67, "timestamp": "03:11:56", "text": "重要な"}]
[{"type": "subtitle", "time": 11820.67, "timestamp": "03:17:00", "text": "音楽、そう、メロディーが頭の中で鳴り響く中、"}, {"type": "subtitle", "time": 11825.11, "timestamp": "03:17:05", "text": "脚本を書くようなものを作っていた"}, {"type": "subtitle", "time": 11828.229, "timestamp": "03:17:08", "text": "比喩的な"}, {"type": "subtitle", "time": 11831.55, "timestamp": "03:17:11", "text": "皆さんが繋がれるように言葉を送ります"}, {"type": "subtitle", "time": 11834.229, "timestamp": "03:17:14", "text": "あなたもこのメロディーを聴いていました"}, {"type": "subtitle", "time": 11838.189, "timestamp": "03:17:18", "text": "頭のてっぺんに、それは、えーと、"}, {"type": "subtitle", "time": 11842.75, "timestamp": "03:17:22", "text": "Uメロディーの5、6回の反復だが"}, {"type": "subtitle", "time": 11846.95, "timestamp": "03:17:26", "text": "私はUのように関連付けられるものを選びました"}, {"type": "subtitle", "time": 11850.189, "timestamp": "03:17:30", "text": "私の心に最も深く結びついているので、"}, {"type": "subtitle", "time": 11853.229, "timestamp": "03:17:33", "text": "私のベストはそれほど良くはないけれど、"}, {"type": "subtitle", "time": 11856.91, "timestamp": "03:17:36", "text": "実際に口笛を吹いて録音した"}, {"type": "subtitle", "time": 11860.189, "timestamp": "03:17:40", "text": "考えながら"}, {"type": "subtitle", "time": 11862.79, "timestamp": "03:17:42", "text": "このことを伝えることについて"}, {"type": "subtitle", "time": 11867.87, "timestamp": "03:17:47", "text": "皆さんにきちんとメッセージを送るために"}, {"type": "subtitle", "time": 11869.389, "timestamp": "03:17:49", "text": "到達する"}, {"type": "subtitle", "time": 11874.55, "timestamp": "03:17:54", "text": "外に出て、あなたに触れる"}]
[{"type": "subtitle", "time": 18909.23, "timestamp": "05:15:09", "text": "GG、私のゲームはラグってたよ、あぁ、かなり"}, {"type": "subtitle", "time": 18910.948, "timestamp": "05:15:10", "text": "もっとプレイしますか？"}, {"type": "subtitle", "time": 18913.868, "timestamp": "05:15:13", "text": "ええと、ほとんど"}, {"type": "subtitle", "time": 18917.07, "timestamp": "05:15:17", "text": "おそらくカップルは1、2試合待つことになるだろう"}, {"type": "subtitle", "time": 18924.67, "timestamp": "05:15:24", "text": "おそらく1人か2人を知っている"}, {"type": "subtitle", "time": 18929.47, "timestamp": "05:15:29", "text": "ゲームは知らない、ああこの人は"}, {"type": "subtitle", "time": 18938.59, "timestamp": "05:15:38", "text": "もうすぐ終わるから、"}, {"type": "subtitle", "time": 18943.03, "timestamp": "05:15:43", "text": "ヘッドバンドの作業について"}, {"type": "subtitle", "time": 18946.03, "timestamp": "05:15:46", "text": "後々のためにヘッドバックではないかもしれない"}, {"type": "subtitle", "time": 18949.788, "timestamp": "05:15:49", "text": "それは後で忘れるべきだ"}, {"type": "subtitle", "time": 18953.91, "timestamp": "05:15:53", "text": "頭を突っ込むべきじゃない、頭を突っ込むべきじゃない"}, {"type": "subtitle", "time": 18959.15, "timestamp": "05:15:59", "text": "やりたいことに取り掛かるが、代わりに"}]
[{"type": "subtitle", "time": 22561.03, "timestamp": "06:16:01", "text": "ドスは大丈夫？猫で行くよ"}, {"type": "subtitle", "time": 22563.708, "timestamp": "06:16:03", "text": "実際、何が起こっているのか"}, {"type": "subtitle", "time": 22565.868, "timestamp": "06:16:05", "text": "インターネットああ"}, {"type": "subtitle", "time": 22567.708, "timestamp": "06:16:07", "text": "いいえ、ああ"}, {"type": "subtitle", "time": 22571.03, "timestamp": "06:16:11", "text": "いや、いいよ、うん、いいよ、いいね、"}, {"type": "subtitle", "time": 22574.51, "timestamp": "06:16:14", "text": "行く、もう少し擦り傷をつけなければならない、私に"}, {"type": "subtitle", "time": 22586.83, "timestamp": "06:16:26", "text": "青に戻るけど、黒も好き"}, {"type": "subtitle", "time": 22591.23, "timestamp": "06:16:31", "text": "どういうこと？ああ、また起こっているのか、ああ、わかった"}, {"type": "subtitle", "time": 22606.43, "timestamp": "06:16:46", "text": "怖がらせるのをやめないで、私はただ"}, {"type": "subtitle", "time": 22615.11, "timestamp": "06:16:55", "text": "自分の、ああ"}]
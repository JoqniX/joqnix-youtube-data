[{"type": "subtitle", "time": 14764.63, "timestamp": "04:06:04", "text": "Octan で遊ぶのが好きです"}, {"type": "subtitle", "time": 14766.95, "timestamp": "04:06:06", "text": "オカタンは楽しい"}, {"type": "subtitle", "time": 14775.03, "timestamp": "04:06:15", "text": "うん、もし手に入れたら本当に楽しいだろうな"}, {"type": "subtitle", "time": 14780.59, "timestamp": "04:06:20", "text": "ヘレム、私はOCT Octan umを選びます"}, {"type": "subtitle", "time": 14785.349, "timestamp": "04:06:25", "text": "ヘレム、それはナイフの針のようだ"}, {"type": "subtitle", "time": 14789.429, "timestamp": "04:06:29", "text": "他に好きなレジェンドはどれですか？"}, {"type": "subtitle", "time": 14798.79, "timestamp": "04:06:38", "text": "そうなるだろう"}, {"type": "subtitle", "time": 14804.389, "timestamp": "04:06:44", "text": "ああ、そう、このやつは待って"}, {"type": "subtitle", "time": 14807.87, "timestamp": "04:06:47", "text": "どうやって見せるかって、えっと、彼女の名前はなんだっけ"}, {"type": "subtitle", "time": 14813.429, "timestamp": "04:06:53", "text": "また、この女の子は科学者です。"}]
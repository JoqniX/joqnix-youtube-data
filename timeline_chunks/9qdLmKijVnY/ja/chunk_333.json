[{"type": "subtitle", "time": 19981.31, "timestamp": "05:33:01", "text": "ポジティブ"}, {"type": "subtitle", "time": 19982.83, "timestamp": "05:33:02", "text": "空間"}, {"type": "subtitle", "time": 19986.548, "timestamp": "05:33:06", "text": "ああ、だから私はいつもオーラルセックスをするんだ"}, {"type": "subtitle", "time": 19988.948, "timestamp": "05:33:08", "text": "皆さん一人ひとりに拍手を送り、話しましょう"}, {"type": "subtitle", "time": 19992.51, "timestamp": "05:33:12", "text": "あなたと全てと、うん、そうだね"}, {"type": "subtitle", "time": 20000.07, "timestamp": "05:33:20", "text": "快適で、2つ目は、優しくしてください"}, {"type": "subtitle", "time": 20004.19, "timestamp": "05:33:24", "text": "私たちは皆を"}, {"type": "subtitle", "time": 20011.15, "timestamp": "05:33:31", "text": "皆さん一人ひとりが"}, {"type": "subtitle", "time": 20014.31, "timestamp": "05:33:34", "text": "そして皆さんは待って待って待って待って"}, {"type": "subtitle", "time": 20016.24, "timestamp": "05:33:36", "text": "待って、接続が切れた"}, {"type": "subtitle", "time": 20018.628, "timestamp": "05:33:38", "text": "[音楽]"}, {"type": "subtitle", "time": 20025.75, "timestamp": "05:33:45", "text": "生きている私は生きている私は手に入れた"}, {"type": "subtitle", "time": 20027.948, "timestamp": "05:33:47", "text": "切断されたと明らかに"}, {"type": "subtitle", "time": 20029.67, "timestamp": "05:33:49", "text": "接続中"}, {"type": "subtitle", "time": 20031.31, "timestamp": "05:33:51", "text": "いいえ"}, {"type": "subtitle", "time": 20036.788, "timestamp": "05:33:56", "text": "えー、ライブ配信中だよ、大丈夫だよ、行くよ、"}, {"type": "subtitle", "time": 20039.15, "timestamp": "05:33:59", "text": "よく生きよう 私も陰性です"}]
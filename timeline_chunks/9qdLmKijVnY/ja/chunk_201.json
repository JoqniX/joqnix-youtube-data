[{"type": "subtitle", "time": 12064.389, "timestamp": "03:21:04", "text": "はい、そうは言っても、えーと、"}, {"type": "subtitle", "time": 12068.349, "timestamp": "03:21:08", "text": "ほぼ30分経ったよね？30分経ったかな？"}, {"type": "subtitle", "time": 12070.269, "timestamp": "03:21:10", "text": "分で大丈夫です"}, {"type": "subtitle", "time": 12074.469, "timestamp": "03:21:14", "text": "28 よし、あと1分だ。"}, {"type": "subtitle", "time": 12077.99, "timestamp": "03:21:17", "text": "ええ、30分間の配信をすると言いました。"}, {"type": "subtitle", "time": 12081.71, "timestamp": "03:21:21", "text": "30分以内に終わらせます"}, {"type": "subtitle", "time": 12086.63, "timestamp": "03:21:26", "text": "マーク、そう、でも、私は戻ってきたよ"}, {"type": "subtitle", "time": 12089.229, "timestamp": "03:21:29", "text": "そして私は自分の"}, {"type": "subtitle", "time": 12093.91, "timestamp": "03:21:33", "text": "最良のえーと、コンテンツの変更があるかもしれません。"}, {"type": "subtitle", "time": 12097.269, "timestamp": "03:21:37", "text": "私がこれから行ういくつかの新しい変更と"}, {"type": "subtitle", "time": 12101.469, "timestamp": "03:21:41", "text": "制限する、私が以前は"}, {"type": "subtitle", "time": 12105.15, "timestamp": "03:21:45", "text": "ええと、でも皆さんが私の"}, {"type": "subtitle", "time": 12108.389, "timestamp": "03:21:48", "text": "決断を下し、最善を尽くしたいと思っています"}, {"type": "subtitle", "time": 12112.75, "timestamp": "03:21:52", "text": "私は特にジョー・ソと一緒にいると幸せを感じます"}, {"type": "subtitle", "time": 12114.469, "timestamp": "03:21:54", "text": "はい、ありがとう"}, {"type": "subtitle", "time": 12118.03, "timestamp": "03:21:58", "text": "こんにちは、それは"}]
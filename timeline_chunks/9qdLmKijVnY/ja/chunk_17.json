[{"type": "subtitle", "time": 1025.949, "timestamp": "00:17:05", "text": "それで"}, {"type": "subtitle", "time": 1031.11, "timestamp": "00:17:11", "text": "これまでどれくらい、えっと、待って、これはどのように"}, {"type": "subtitle", "time": 1039.15, "timestamp": "00:17:19", "text": "そのため、YouTube側では"}, {"type": "subtitle", "time": 1040.429, "timestamp": "00:17:20", "text": "作った"}, {"type": "subtitle", "time": 1043.429, "timestamp": "00:17:23", "text": "3月頃かな、えっと"}, {"type": "subtitle", "time": 1047.27, "timestamp": "00:17:27", "text": "前回と同じように、いつ会員になったのか教えてください。"}, {"type": "subtitle", "time": 1052.31, "timestamp": "00:17:32", "text": "再び 28 28 29 30"}, {"type": "subtitle", "time": 1057.35, "timestamp": "00:17:37", "text": "31 うん、ここ4日間でやり遂げたよ"}, {"type": "subtitle", "time": 1059.51, "timestamp": "00:17:39", "text": "えーと"}, {"type": "subtitle", "time": 1062.59, "timestamp": "00:17:42", "text": "1,633ルピーですが、それは削減されます"}, {"type": "subtitle", "time": 1065.83, "timestamp": "00:17:45", "text": "YouTubeのせいで簡素化された"}, {"type": "subtitle", "time": 1074.83, "timestamp": "00:17:54", "text": "ではいくらですか"}]
[{"type": "subtitle", "time": 2062.069, "timestamp": "00:34:22", "text": "[音楽]"}, {"type": "subtitle", "time": 2065.75, "timestamp": "00:34:25", "text": "みなさんこんにちは、ついに戻ってきました"}, {"type": "subtitle", "time": 2068.069, "timestamp": "00:34:28", "text": "ああ、本当にごめんなさい、私たちは"}, {"type": "subtitle", "time": 2072.909, "timestamp": "00:34:32", "text": "[音楽]"}, {"type": "subtitle", "time": 2076.19, "timestamp": "00:34:36", "text": "え、何？えっと、そう、電力があるよ"}, {"type": "subtitle", "time": 2084.109, "timestamp": "00:34:44", "text": "やっと戻ってきました、ごめんなさい"}, {"type": "subtitle", "time": 2087.869, "timestamp": "00:34:47", "text": "いやー、大変だったよ。停電があって"}, {"type": "subtitle", "time": 2091.109, "timestamp": "00:34:51", "text": "えっと、停電があったんだけど、"}, {"type": "subtitle", "time": 2093.109, "timestamp": "00:34:53", "text": "3時間"}, {"type": "subtitle", "time": 2095.589, "timestamp": "00:34:55", "text": "推測"}, {"type": "subtitle", "time": 2099.03, "timestamp": "00:34:59", "text": "そうだね"}]
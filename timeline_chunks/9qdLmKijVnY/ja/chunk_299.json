[{"type": "subtitle", "time": 17945.11, "timestamp": "04:59:05", "text": "ゲーム わからない 変な V こんにちは 楽しんでください"}, {"type": "subtitle", "time": 17948.39, "timestamp": "04:59:08", "text": "幸運を楽しんで、滞在することを忘れないでください"}, {"type": "subtitle", "time": 17975.07, "timestamp": "04:59:35", "text": "水分補給、ああ、うん、ああ"}, {"type": "subtitle", "time": 17979.23, "timestamp": "04:59:39", "text": "待って、配信の終わりにするよ、わかった。"}, {"type": "subtitle", "time": 17982.628, "timestamp": "04:59:42", "text": "ストリームの終わりにそれを伝えるので、ええと"}, {"type": "subtitle", "time": 17985.11, "timestamp": "04:59:45", "text": "明日は配信はありません"}, {"type": "subtitle", "time": 17988.91, "timestamp": "04:59:48", "text": "Twitch 明日は私が持っている"}, {"type": "subtitle", "time": 17990.708, "timestamp": "04:59:50", "text": "に"}, {"type": "subtitle", "time": 17992.22, "timestamp": "04:59:52", "text": "記録"}, {"type": "subtitle", "time": 17993.51, "timestamp": "04:59:53", "text": "[音楽]"}, {"type": "subtitle", "time": 17999.27, "timestamp": "04:59:59", "text": "何"}]
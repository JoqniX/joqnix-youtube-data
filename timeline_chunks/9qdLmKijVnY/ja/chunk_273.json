[{"type": "subtitle", "time": 16381.389, "timestamp": "04:33:01", "text": "「あー、待って待って」と言う代わりに"}, {"type": "subtitle", "time": 16401.869, "timestamp": "04:33:21", "text": "ああ、これだったと思う"}, {"type": "subtitle", "time": 16409.83, "timestamp": "04:33:29", "text": "おはあ、私が昔使っていたアルハみたいなもの"}, {"type": "subtitle", "time": 16411.83, "timestamp": "04:33:31", "text": "何かを作る"}, {"type": "subtitle", "time": 16415.15, "timestamp": "04:33:35", "text": "そう、それが私が"}, {"type": "subtitle", "time": 16420.39, "timestamp": "04:33:40", "text": "うん"}, {"type": "subtitle", "time": 16425.07, "timestamp": "04:33:45", "text": "ああ、実は私は"}, {"type": "subtitle", "time": 16428.59, "timestamp": "04:33:48", "text": "次に、その終わりですが、問題は"}, {"type": "subtitle", "time": 16431.59, "timestamp": "04:33:51", "text": "すでにたくさんあります"}, {"type": "subtitle", "time": 16433.869, "timestamp": "04:33:53", "text": "ミース・ウ・イン"}, {"type": "subtitle", "time": 16437.07, "timestamp": "04:33:57", "text": "えっと、なんて言うんだっけ"}]
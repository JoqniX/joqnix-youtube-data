[{"type": "subtitle", "time": 2465.589, "timestamp": "00:41:05", "text": "オーケー、今日はテストします"}, {"type": "subtitle", "time": 2466.71, "timestamp": "00:41:06", "text": "の"}, {"type": "subtitle", "time": 2472.19, "timestamp": "00:41:12", "text": "伝説、つまりQの能力は"}, {"type": "subtitle", "time": 2474.87, "timestamp": "00:41:14", "text": "Qアビリティは何と呼ぶのか"}, {"type": "subtitle", "time": 2478.63, "timestamp": "00:41:18", "text": "これは一体何ですか？"}, {"type": "subtitle", "time": 2483.829, "timestamp": "00:41:23", "text": "ポータルは壁の内側に入るか、"}, {"type": "subtitle", "time": 2486.63, "timestamp": "00:41:26", "text": "建物なので、どうやら、"}, {"type": "subtitle", "time": 2490.15, "timestamp": "00:41:30", "text": "もう一度充電すると、23 度くらいかかります。"}, {"type": "subtitle", "time": 2493.63, "timestamp": "00:41:33", "text": "24秒。数えてないよ。"}, {"type": "subtitle", "time": 2500.63, "timestamp": "00:41:40", "text": "ああ、照準器を取り出さないといけないんだ、待って"}, {"type": "subtitle", "time": 2502.829, "timestamp": "00:41:42", "text": "彼らがこう作ったのか、それとも元々こうだったのか"}, {"type": "subtitle", "time": 2505.47, "timestamp": "00:41:45", "text": "このシールドのように"}, {"type": "subtitle", "time": 2509.829, "timestamp": "00:41:49", "text": "コアHなので、ソロゲームモードでは"}, {"type": "subtitle", "time": 2514.23, "timestamp": "00:41:54", "text": "えーと、大金持ちの悪人、現金、現金、"}, {"type": "subtitle", "time": 2519.39, "timestamp": "00:41:59", "text": "あと、えーと、青いエボも"}]
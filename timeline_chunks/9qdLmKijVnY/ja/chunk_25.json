[{"type": "subtitle", "time": 1502.149, "timestamp": "00:25:02", "text": "えっと、それはチキンホンダか"}, {"type": "subtitle", "time": 1505.269, "timestamp": "00:25:05", "text": "忘れてたな、ああ、そうだ、"}, {"type": "subtitle", "time": 1507.07, "timestamp": "00:25:07", "text": "昨日私たちがプレイしたゲームは"}, {"type": "subtitle", "time": 1509.389, "timestamp": "00:25:09", "text": "数学的な部分を除いて楽しい"}, {"type": "subtitle", "time": 1511.63, "timestamp": "00:25:11", "text": "それは"}, {"type": "subtitle", "time": 1516.35, "timestamp": "00:25:16", "text": "痛い、マットは下手だけど、Mは嫌いだけど、でも"}, {"type": "subtitle", "time": 1520.19, "timestamp": "00:25:20", "text": "うん、昨日は楽しかったよ。うん。"}, {"type": "subtitle", "time": 1522.63, "timestamp": "00:25:22", "text": "チキン 義務 はい、ありがとうございます はい、チキン"}, {"type": "subtitle", "time": 1525.909, "timestamp": "00:25:25", "text": "義務、それは楽しいゲームですが、マット"}, {"type": "subtitle", "time": 1529.31, "timestamp": "00:25:29", "text": "マットマットは難しいです私はできません"}, {"type": "subtitle", "time": 1531.83, "timestamp": "00:25:31", "text": "私は電卓をとてもよく使っていたので"}, {"type": "subtitle", "time": 1533.029, "timestamp": "00:25:33", "text": "の"}, {"type": "subtitle", "time": 1536.029, "timestamp": "00:25:36", "text": "ああ、でもそうだった"}, {"type": "subtitle", "time": 1538.789, "timestamp": "00:25:38", "text": "楽しかった、どうだった？良かったよ、私は"}, {"type": "subtitle", "time": 1540.59, "timestamp": "00:25:40", "text": "20分以内に終わらせられると思った"}, {"type": "subtitle", "time": 1545.149, "timestamp": "00:25:45", "text": "数分で済むはずだったのに、3時間もかかってしまった。"}, {"type": "subtitle", "time": 1548.71, "timestamp": "00:25:48", "text": "Mマットマットみたいなもの"}, {"type": "subtitle", "time": 1551.269, "timestamp": "00:25:51", "text": "H"}, {"type": "subtitle", "time": 1554.95, "timestamp": "00:25:54", "text": "痛かったけど、楽しかったよ"}, {"type": "subtitle", "time": 1559.269, "timestamp": "00:25:59", "text": "見るのが本当にいい、見ないのがいい"}]
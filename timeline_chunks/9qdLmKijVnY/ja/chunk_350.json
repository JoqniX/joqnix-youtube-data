[{"type": "subtitle", "time": 21000.75, "timestamp": "05:50:00", "text": "あなたの携帯電話にはTwitchがインストールされています"}, {"type": "subtitle", "time": 21002.35, "timestamp": "05:50:02", "text": "押す必要がある"}, {"type": "subtitle", "time": 21005.59, "timestamp": "05:50:05", "text": "通知または、"}, {"type": "subtitle", "time": 21009.67, "timestamp": "05:50:09", "text": "通知、またはブラウザで「いいね」"}, {"type": "subtitle", "time": 21013.91, "timestamp": "05:50:13", "text": "Twitch については、そこから入手できます"}, {"type": "subtitle", "time": 21018.39, "timestamp": "05:50:18", "text": "はい、では私の場合はこうやってやります"}, {"type": "subtitle", "time": 21021.07, "timestamp": "05:50:21", "text": "Twitchのスケジュールのように、"}, {"type": "subtitle", "time": 21024.03, "timestamp": "05:50:24", "text": "スケジュールは私の"}, {"type": "subtitle", "time": 21026.788, "timestamp": "05:50:26", "text": "Twitchでは、3つのスケジュールストリームが表示されます"}, {"type": "subtitle", "time": 21029.83, "timestamp": "05:50:29", "text": "スケジュールされたストリームとTwitchでは"}, {"type": "subtitle", "time": 21033.43, "timestamp": "05:50:33", "text": "スケジュールに関するリマインダーのようなもの"}, {"type": "subtitle", "time": 21037.468, "timestamp": "05:50:37", "text": "なるほど、そういうやり方なんですね。"}, {"type": "subtitle", "time": 21039.628, "timestamp": "05:50:39", "text": "この配信を見逃した場合は"}, {"type": "subtitle", "time": 21041.67, "timestamp": "05:50:41", "text": "ここをクリックしてストリームを視聴してください"}, {"type": "subtitle", "time": 21042.868, "timestamp": "05:50:42", "text": "ウォッチパス"}, {"type": "subtitle", "time": 21047.51, "timestamp": "05:50:47", "text": "放送、そうやってやるんだよ"}, {"type": "subtitle", "time": 21050.11, "timestamp": "05:50:50", "text": "Twitch とオキシンに戻って"}, {"type": "subtitle", "time": 21054.35, "timestamp": "05:50:54", "text": "チャットの痛みをもたらす音楽は"}, {"type": "subtitle", "time": 21057.19, "timestamp": "05:50:57", "text": "よく聞いてください、あ、待って、ミュートしていました"}]
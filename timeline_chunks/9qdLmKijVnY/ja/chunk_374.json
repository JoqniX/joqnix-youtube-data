[{"type": "subtitle", "time": 22443.51, "timestamp": "06:14:03", "text": "足のギャングは行かない、本当に足のギャングは行かない"}, {"type": "subtitle", "time": 22445.15, "timestamp": "06:14:05", "text": "うん"}, {"type": "subtitle", "time": 22447.03, "timestamp": "06:14:07", "text": "今のところは"}, {"type": "subtitle", "time": 22450.548, "timestamp": "06:14:10", "text": "つまり、私には足もないので"}, {"type": "subtitle", "time": 22453.51, "timestamp": "06:14:13", "text": "ええ、本当に持っていませんでした"}, {"type": "subtitle", "time": 22457.708, "timestamp": "06:14:17", "text": "時間Hは長くて忙しい、ああ神様"}, {"type": "subtitle", "time": 22460.23, "timestamp": "06:14:20", "text": "冒涜"}, {"type": "subtitle", "time": 22466.19, "timestamp": "06:14:26", "text": "ギャングのように「ノー」と言う男は暗い"}, {"type": "subtitle", "time": 22470.39, "timestamp": "06:14:30", "text": "神様、今日私はとても病気です。"}, {"type": "subtitle", "time": 22473.788, "timestamp": "06:14:33", "text": "ノールックモデルはすごくクールに見える、うん、そうだね"}, {"type": "subtitle", "time": 22476.708, "timestamp": "06:14:36", "text": "とにかくかっこいいよね"}, {"type": "subtitle", "time": 22480.468, "timestamp": "06:14:40", "text": "ええ、ストリーム全体はどうですか、えー、ホーホー"}, {"type": "subtitle", "time": 22483.11, "timestamp": "06:14:43", "text": "そして、一緒に観戦したいです。"}, {"type": "subtitle", "time": 22486.788, "timestamp": "06:14:46", "text": "それはそうだけど、私にはできるかどうかわからない"}, {"type": "subtitle", "time": 22489.15, "timestamp": "06:14:49", "text": "実際にそう"}, {"type": "subtitle", "time": 22492.948, "timestamp": "06:14:52", "text": "ジャックスを知らなくても大丈夫です"}, {"type": "subtitle", "time": 22494.83, "timestamp": "06:14:54", "text": "彼らと一緒に下忍としてプレイするつもりです"}, {"type": "subtitle", "time": 22498.43, "timestamp": "06:14:58", "text": "少し前に、そう、それについて神様"}]
[{"type": "subtitle", "time": 17002.99, "timestamp": "04:43:22", "text": "うん、いいゲームだね、ナイストライ、ナイス"}, {"type": "subtitle", "time": 17005.39, "timestamp": "04:43:25", "text": "試してみたけど、できなかった"}, {"type": "subtitle", "time": 17009.11, "timestamp": "04:43:29", "text": "たくさんプレイしたけど、えっと、何だったっけ？"}, {"type": "subtitle", "time": 17012.948, "timestamp": "04:43:32", "text": "オーケーって言ってるやつ、えっと、待って、うん、名前"}, {"type": "subtitle", "time": 17015.03, "timestamp": "04:43:35", "text": "偶数"}, {"type": "subtitle", "time": 17018.23, "timestamp": "04:43:38", "text": "まさにその通りです。"}, {"type": "subtitle", "time": 17021.23, "timestamp": "04:43:41", "text": "仮想オンライン名またはあなたができないもの"}, {"type": "subtitle", "time": 17025.07, "timestamp": "04:43:45", "text": "ユニークな名前を選ぶ"}, {"type": "subtitle", "time": 17027.75, "timestamp": "04:43:47", "text": "異なるが、それは一般的ではない。"}, {"type": "subtitle", "time": 17029.91, "timestamp": "04:43:49", "text": "ファーストネームはコンマです。大丈夫ですが、"}, {"type": "subtitle", "time": 17032.868, "timestamp": "04:43:52", "text": "この姓も変更可能です"}, {"type": "subtitle", "time": 17034.83, "timestamp": "04:43:54", "text": "私には名字も姓もありません"}, {"type": "subtitle", "time": 17039.11, "timestamp": "04:43:59", "text": "名前は、名前が1つだけですよね？"}]
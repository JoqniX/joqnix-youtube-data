[{"type": "subtitle", "time": 19441.43, "timestamp": "05:24:01", "text": "そして土曜日の配信、あぁ、忘れてた"}, {"type": "subtitle", "time": 19443.51, "timestamp": "05:24:03", "text": "これをみんなに伝えて、えーと、"}, {"type": "subtitle", "time": 19446.51, "timestamp": "05:24:06", "text": "私が参加したいと思っていたことを知らない人たち"}, {"type": "subtitle", "time": 19451.03, "timestamp": "05:24:11", "text": "genin um ストリーマーイベントで私は"}, {"type": "subtitle", "time": 19454.548, "timestamp": "05:24:14", "text": "昨日8日にメールを受け取りました"}, {"type": "subtitle", "time": 19458.31, "timestamp": "05:24:18", "text": "9月ですが、私は2日に応募しました。"}, {"type": "subtitle", "time": 19460.91, "timestamp": "05:24:20", "text": "イベントが行われた9月"}, {"type": "subtitle", "time": 19464.51, "timestamp": "05:24:24", "text": "発表されたのでメールを受け取ったので、"}, {"type": "subtitle", "time": 19465.628, "timestamp": "05:24:25", "text": "に関しては"}, {"type": "subtitle", "time": 19469.39, "timestamp": "05:24:29", "text": "メール、えっと、私もそうするべきだと思う"}, {"type": "subtitle", "time": 19470.75, "timestamp": "05:24:30", "text": "ストリーミング"}, {"type": "subtitle", "time": 19475.35, "timestamp": "05:24:35", "text": "ゲニンは9月8日から待って"}, {"type": "subtitle", "time": 19479.15, "timestamp": "05:24:39", "text": "9月2日から8日まで"}, {"type": "subtitle", "time": 19481.15, "timestamp": "05:24:41", "text": "えーと"}, {"type": "subtitle", "time": 19483.39, "timestamp": "05:24:43", "text": "20"}, {"type": "subtitle", "time": 19487.51, "timestamp": "05:24:47", "text": "21日 20日 ちょっと待って、もう一度確認させてください"}, {"type": "subtitle", "time": 19497.548, "timestamp": "05:24:57", "text": "また待って待って待って待っていつ"}]
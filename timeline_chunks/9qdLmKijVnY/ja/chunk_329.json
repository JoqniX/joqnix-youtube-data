[{"type": "subtitle", "time": 19740.27, "timestamp": "05:29:00", "text": "持久力はあるが、少なくとも君が知っているように"}, {"type": "subtitle", "time": 19743.47, "timestamp": "05:29:03", "text": "こんな感じのxavみたいな"}, {"type": "subtitle", "time": 19747.47, "timestamp": "05:29:07", "text": "わからないので、えーと始めます"}, {"type": "subtitle", "time": 19749.67, "timestamp": "05:29:09", "text": "午後3時30分"}, {"type": "subtitle", "time": 19754.23, "timestamp": "05:29:14", "text": "ISD ええと、それは夕方か午後です"}, {"type": "subtitle", "time": 19756.75, "timestamp": "05:29:16", "text": "午後になります"}, {"type": "subtitle", "time": 19761.11, "timestamp": "05:29:21", "text": "ストリーム えーと、私はやったことを知っています"}, {"type": "subtitle", "time": 19763.548, "timestamp": "05:29:23", "text": "先週のような以前のストリームは"}, {"type": "subtitle", "time": 19767.03, "timestamp": "05:29:27", "text": "13時間も配信する持久力は分かっていますし、"}, {"type": "subtitle", "time": 19770.31, "timestamp": "05:29:30", "text": "その日は3時半に配信を開始しました"}, {"type": "subtitle", "time": 19773.948, "timestamp": "05:29:33", "text": "私もそう思うけど、私も行かないよ"}, {"type": "subtitle", "time": 19777.03, "timestamp": "05:29:37", "text": "たくさん、そしてすべて、すべて"}, {"type": "subtitle", "time": 19782.51, "timestamp": "05:29:42", "text": "人々は、忍耐力を持つでしょう"}, {"type": "subtitle", "time": 19785.07, "timestamp": "05:29:45", "text": "見ているだけでは耐えられない、殺すぞ"}, {"type": "subtitle", "time": 19787.31, "timestamp": "05:29:47", "text": "お前を見つけて、ぶん殴って頭を"}, {"type": "subtitle", "time": 19789.788, "timestamp": "05:29:49", "text": "君を撫でて鼻をBRする"}, {"type": "subtitle", "time": 19793.548, "timestamp": "05:29:53", "text": "わかった、モデレーターにも送るよ、バカ。"}, {"type": "subtitle", "time": 19794.548, "timestamp": "05:29:54", "text": "そして"}, {"type": "subtitle", "time": 19798.11, "timestamp": "05:29:58", "text": "バキ、君は持久力がないのか"}]
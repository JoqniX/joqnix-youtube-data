[{"type": "subtitle", "time": 22141.99, "timestamp": "06:09:01", "text": "切断する 切断する フリーが何をするか"}, {"type": "subtitle", "time": 22145.51, "timestamp": "06:09:05", "text": "ああ、ハッシュを再装着します本当に"}, {"type": "subtitle", "time": 22148.27, "timestamp": "06:09:08", "text": "その瞬間を逃す、ああ彼は"}, {"type": "subtitle", "time": 22149.708, "timestamp": "06:09:09", "text": "彼は考えを変えるだろう"}, {"type": "subtitle", "time": 22152.23, "timestamp": "06:09:12", "text": "待ちます 待ちます 待ちます 待ちます 待ちます 待ちます 待ちます"}, {"type": "subtitle", "time": 22154.788, "timestamp": "06:09:14", "text": "待って待って、本当に私は下忍Cにいるべきなの？"}, {"type": "subtitle", "time": 22156.99, "timestamp": "06:09:16", "text": "の上"}, {"type": "subtitle", "time": 22160.708, "timestamp": "06:09:20", "text": "Twitch ならできると思う"}, {"type": "subtitle", "time": 22163.67, "timestamp": "06:09:23", "text": "えーと"}, {"type": "subtitle", "time": 22167.31, "timestamp": "06:09:27", "text": "こんにちは、ようこそ、ようこそ、あなたは何をしていますか"}, {"type": "subtitle", "time": 22172.03, "timestamp": "06:09:32", "text": "まあ、心肺蘇生は必要ないよ、私はオン"}, {"type": "subtitle", "time": 22175.548, "timestamp": "06:09:35", "text": "いいえ、忍者を切断しないでください、彼女は"}, {"type": "subtitle", "time": 22179.59, "timestamp": "06:09:39", "text": "彼女は良い魂の持ち主だ、彼女は良い魂の持ち主だ、そうだ"}, {"type": "subtitle", "time": 22183.99, "timestamp": "06:09:43", "text": "はい、切断します。切断とは何ですか？待って、どのように"}, {"type": "subtitle", "time": 22185.788, "timestamp": "06:09:45", "text": "今日はみんなが何をしているの？"}, {"type": "subtitle", "time": 22188.15, "timestamp": "06:09:48", "text": "モデルについて話すと、調子はどうですか"}, {"type": "subtitle", "time": 22189.99, "timestamp": "06:09:49", "text": "男たちが"}, {"type": "subtitle", "time": 22194.708, "timestamp": "06:09:54", "text": "今日、クローズはガラスを食べている。ああ、いや、ああそうだ。"}, {"type": "subtitle", "time": 22198.15, "timestamp": "06:09:58", "text": "繰り返しになりますが、私が言ったように、彼をサポートしてください。"}]
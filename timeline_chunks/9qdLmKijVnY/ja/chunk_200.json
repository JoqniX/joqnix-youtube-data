[{"type": "subtitle", "time": 12004.389, "timestamp": "03:20:04", "text": "だから表現しても大丈夫だから、私は表現した"}, {"type": "subtitle", "time": 12012.15, "timestamp": "03:20:12", "text": "umon のために"}, {"type": "subtitle", "time": 12015.11, "timestamp": "03:20:15", "text": "聞いてくれてありがとう"}, {"type": "subtitle", "time": 12018.83, "timestamp": "03:20:18", "text": "聞いていると、ええ、もしあなたが尋ねたら"}, {"type": "subtitle", "time": 12021.51, "timestamp": "03:20:21", "text": "いつ配信するの？"}, {"type": "subtitle", "time": 12026.469, "timestamp": "03:20:26", "text": "毎日配信中。今のところ私の答えはうーん"}, {"type": "subtitle", "time": 12028.79, "timestamp": "03:20:28", "text": "私は"}, {"type": "subtitle", "time": 12032.75, "timestamp": "03:20:32", "text": "えーっと、私が配信する目標リストみたいなものです"}, {"type": "subtitle", "time": 12037.349, "timestamp": "03:20:37", "text": "週に一度配信できるかどうかはわかりません"}, {"type": "subtitle", "time": 12039.83, "timestamp": "03:20:39", "text": "以前のように何時間も配信することはできない"}, {"type": "subtitle", "time": 12043.07, "timestamp": "03:20:43", "text": "そして、私が昔そうだったように何時間も"}, {"type": "subtitle", "time": 12047.03, "timestamp": "03:20:47", "text": "もう無理だけど、ベストを尽くします"}, {"type": "subtitle", "time": 12050.55, "timestamp": "03:20:50", "text": "はい、そして私は"}, {"type": "subtitle", "time": 12052.63, "timestamp": "03:20:52", "text": "試験と"}, {"type": "subtitle", "time": 12057.229, "timestamp": "03:20:57", "text": "うん、ベストを尽くすよ。君たちもね。"}]
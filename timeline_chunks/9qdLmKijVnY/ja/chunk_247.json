[{"type": "subtitle", "time": 14827.87, "timestamp": "04:07:07", "text": "B ああ、そうだな、俺はランガンプレイヤーだと思う"}, {"type": "subtitle", "time": 14830.59, "timestamp": "04:07:10", "text": "時々隠れたりするのが好きだ"}, {"type": "subtitle", "time": 14833.71, "timestamp": "04:07:13", "text": "レンジプレイヤーみたいな感じだから、結構好き。"}, {"type": "subtitle", "time": 14837.71, "timestamp": "04:07:17", "text": "前に進んで何度も死ぬ、それが"}, {"type": "subtitle", "time": 14842.59, "timestamp": "04:07:22", "text": "だからこそ、私はオアンが好きなのかもしれない。彼は走るから。"}]
[{"type": "subtitle", "time": 20522.868, "timestamp": "05:42:02", "text": "よく使っていたコマンド"}, {"type": "subtitle", "time": 20525.03, "timestamp": "05:42:05", "text": "そして仕事に来ない、またはあなたは"}, {"type": "subtitle", "time": 20527.83, "timestamp": "05:42:07", "text": "私の声を正しく聞いているか、私が"}, {"type": "subtitle", "time": 20530.468, "timestamp": "05:42:10", "text": "えーと、コラボ配信をする場合は"}, {"type": "subtitle", "time": 20534.35, "timestamp": "05:42:14", "text": "コラボを聞いていない"}, {"type": "subtitle", "time": 20539.19, "timestamp": "05:42:19", "text": "ゲストの声は適切ですか、教えてください"}, {"type": "subtitle", "time": 20542.67, "timestamp": "05:42:22", "text": "はい、そして私も必ず"}, {"type": "subtitle", "time": 20547.23, "timestamp": "05:42:27", "text": "英語だけでチャットします。うんうん、私は"}, {"type": "subtitle", "time": 20549.91, "timestamp": "05:42:29", "text": "日本語 なぜなら、ほとんどの場合"}, {"type": "subtitle", "time": 20553.07, "timestamp": "05:42:33", "text": "私はただおしゃべりしているだけです"}, {"type": "subtitle", "time": 20557.19, "timestamp": "05:42:37", "text": "すぐにコピーして、それを"}, {"type": "subtitle", "time": 20561.948, "timestamp": "05:42:41", "text": "Google翻訳と返信"}, {"type": "subtitle", "time": 20566.59, "timestamp": "05:42:46", "text": "手間は増えるけど、それでも問題ない"}, {"type": "subtitle", "time": 20569.51, "timestamp": "05:42:49", "text": "えっと、でも"}, {"type": "subtitle", "time": 20574.15, "timestamp": "05:42:54", "text": "うん、でも、でも、できるだけ抑えるようにする"}, {"type": "subtitle", "time": 20575.11, "timestamp": "05:42:55", "text": "英語"}, {"type": "subtitle", "time": 20579.03, "timestamp": "05:42:59", "text": "あるいは、私だけでなく他の人も"}]
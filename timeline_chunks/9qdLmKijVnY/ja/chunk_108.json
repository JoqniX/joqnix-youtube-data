[{"type": "subtitle", "time": 6484.47, "timestamp": "01:48:04", "text": "願いよ、坊や"}, {"type": "subtitle", "time": 6488.99, "timestamp": "01:48:08", "text": "では、課題とは何でしょうか？"}, {"type": "subtitle", "time": 6491.07, "timestamp": "01:48:11", "text": "物のようなもの"}, {"type": "subtitle", "time": 6494.589, "timestamp": "01:48:14", "text": "課題　ああ、お茶をもらう　ああ、いいね"}, {"type": "subtitle", "time": 6497.31, "timestamp": "01:48:17", "text": "ウルティマで敵10人を輸送する"}, {"type": "subtitle", "time": 6500.589, "timestamp": "01:48:20", "text": "チームメイト、ああ、自分で使うと"}, {"type": "subtitle", "time": 6503.95, "timestamp": "01:48:23", "text": "それでいいよ、アップローノックを作成する"}, {"type": "subtitle", "time": 6508.51, "timestamp": "01:48:28", "text": "下へ降りて、ポータルに戻る前に"}, {"type": "subtitle", "time": 6516.629, "timestamp": "01:48:36", "text": "これを作成して入力する"}, {"type": "subtitle", "time": 6520.51, "timestamp": "01:48:40", "text": "ポータル ああ、それで"}, {"type": "subtitle", "time": 6525.95, "timestamp": "01:48:45", "text": "ああ、なんてこった、彼らは難しい課題を出してくる"}, {"type": "subtitle", "time": 6528.589, "timestamp": "01:48:48", "text": "はぁ"}, {"type": "subtitle", "time": 6537.55, "timestamp": "01:48:57", "text": "レプリケーターを10個作成する"}]
[{"type": "subtitle", "time": 20160.67, "timestamp": "05:36:00", "text": "家族 はい、私は治ることが大好きです はい、あなた"}, {"type": "subtitle", "time": 20161.91, "timestamp": "05:36:01", "text": "は"}, {"type": "subtitle", "time": 20166.548, "timestamp": "05:36:06", "text": "治癒したあなたは呪いあなたは呪いあなたは"}, {"type": "subtitle", "time": 20172.548, "timestamp": "05:36:12", "text": "ダカ、あなたのTwitchアカウントの誰ですか？"}, {"type": "subtitle", "time": 20175.788, "timestamp": "05:36:15", "text": "はい、次のアカウントで、はい、そうです"}, {"type": "subtitle", "time": 20179.47, "timestamp": "05:36:19", "text": "昨日起こったこと 私は即座に禁止されました"}, {"type": "subtitle", "time": 20182.67, "timestamp": "05:36:22", "text": "彼らに反応を示す前に"}, {"type": "subtitle", "time": 20185.788, "timestamp": "05:36:25", "text": "そんな感じのことは何もないけど、それでも、あの"}, {"type": "subtitle", "time": 20189.03, "timestamp": "05:36:29", "text": "それは旅の一部です"}, {"type": "subtitle", "time": 20194.788, "timestamp": "05:36:34", "text": "このような障害物、このような障害物"}, {"type": "subtitle", "time": 20198.07, "timestamp": "05:36:38", "text": "ああ、このような障害は"}, {"type": "subtitle", "time": 20200.43, "timestamp": "05:36:40", "text": "あなたの旅では、"}, {"type": "subtitle", "time": 20202.548, "timestamp": "05:36:42", "text": "インターネットやその他何でも"}, {"type": "subtitle", "time": 20205.23, "timestamp": "05:36:45", "text": "憎む人がいるだろうが、親切に歩く人もいるだろう"}, {"type": "subtitle", "time": 20208.708, "timestamp": "05:36:48", "text": "あなたに「あなたのそばにいたい」と言う"}, {"type": "subtitle", "time": 20211.51, "timestamp": "05:36:51", "text": "そして、あなたを守りたいし、"}, {"type": "subtitle", "time": 20213.91, "timestamp": "05:36:53", "text": "すべてには、"}, {"type": "subtitle", "time": 20218.51, "timestamp": "05:36:58", "text": "君が嫌いだ、君を破壊したい、そして"}]
[{"type": "subtitle", "time": 12720.75, "timestamp": "03:32:00", "text": "えっと、許可を求めます"}, {"type": "subtitle", "time": 12723.389, "timestamp": "03:32:03", "text": "あなたの許可があれば、"}, {"type": "subtitle", "time": 12727.03, "timestamp": "03:32:07", "text": "Twitterに投稿します"}, {"type": "subtitle", "time": 12729.469, "timestamp": "03:32:09", "text": "私のアカウントで、または私が使用する"}, {"type": "subtitle", "time": 12737.99, "timestamp": "03:32:17", "text": "Twitterと、そうそう"}, {"type": "subtitle", "time": 12740.95, "timestamp": "03:32:20", "text": "そう、特に"}, {"type": "subtitle", "time": 12743.91, "timestamp": "03:32:23", "text": "美術関係の人たちは混乱していたよね"}, {"type": "subtitle", "time": 12746.95, "timestamp": "03:32:26", "text": "プロフィールにハッシュタグは付けていません"}, {"type": "subtitle", "time": 12748.229, "timestamp": "03:32:28", "text": "またはどこでも"}, {"type": "subtitle", "time": 12752.59, "timestamp": "03:32:32", "text": "そうでなければ、人々は混乱したので、代わりに"}, {"type": "subtitle", "time": 12755.59, "timestamp": "03:32:35", "text": "ハッシュタグをやっている皆さんの多くは"}, {"type": "subtitle", "time": 12759.87, "timestamp": "03:32:39", "text": "私をタグ付けした、私のツイートをタグ付けした"}, {"type": "subtitle", "time": 12763.03, "timestamp": "03:32:43", "text": "アカウントを作成して、その操作を行ったので、"}, {"type": "subtitle", "time": 12767.349, "timestamp": "03:32:47", "text": "さあさあ、ついにハッシュができました"}, {"type": "subtitle", "time": 12770.75, "timestamp": "03:32:50", "text": "えっと"}, {"type": "subtitle", "time": 12774.07, "timestamp": "03:32:54", "text": "昨日、私は古い"}, {"type": "subtitle", "time": 12777.55, "timestamp": "03:32:57", "text": "Xにある別アカウント"}]
[{"type": "subtitle", "time": 23220.708, "timestamp": "06:27:00", "text": "背景音楽がすごく壮大で"}, {"type": "subtitle", "time": 23225.31, "timestamp": "06:27:05", "text": "それは本当に素敵です、まるで"}, {"type": "subtitle", "time": 23227.51, "timestamp": "06:27:07", "text": "クールだね。どう表現すればいいかわからないけど"}, {"type": "subtitle", "time": 23230.27, "timestamp": "06:27:10", "text": "すごくかっこいいですね。ケープがお好きですか？"}, {"type": "subtitle", "time": 23234.07, "timestamp": "06:27:14", "text": "岬、ああ岬は本当に素晴らしい、君を知っている"}, {"type": "subtitle", "time": 23236.868, "timestamp": "06:27:16", "text": "ケープを見たいですか"}, {"type": "subtitle", "time": 23239.23, "timestamp": "06:27:19", "text": "ケープIのモデルを見てください。私の"}, {"type": "subtitle", "time": 23242.91, "timestamp": "06:27:22", "text": "ケープ、ちょっと待って"}, {"type": "subtitle", "time": 23244.868, "timestamp": "06:27:24", "text": "それをする"}, {"type": "subtitle", "time": 23249.23, "timestamp": "06:27:29", "text": "君と僕、モ、特にその髪型が好き"}, {"type": "subtitle", "time": 23252.39, "timestamp": "06:27:32", "text": "ありがとう、ありがとう、全部好きです"}, {"type": "subtitle", "time": 23264.708, "timestamp": "06:27:44", "text": "素敵なものすべて"}, {"type": "subtitle", "time": 23267.39, "timestamp": "06:27:47", "text": "本当に本当に感謝しています。"}, {"type": "subtitle", "time": 23270.75, "timestamp": "06:27:50", "text": "とてもかわいい ハローニンジャ"}]
[{"type": "subtitle", "time": 19320.51, "timestamp": "05:22:00", "text": "チャットに参加している皆さんへ"}, {"type": "subtitle", "time": 19323.59, "timestamp": "05:22:03", "text": "それから、えっと、なんて言うんだっけ"}, {"type": "subtitle", "time": 19325.91, "timestamp": "05:22:05", "text": "試合配信が終わったら、"}, {"type": "subtitle", "time": 19328.99, "timestamp": "05:22:08", "text": "シーンに戻って、私たちは"}, {"type": "subtitle", "time": 19331.47, "timestamp": "05:22:11", "text": "少し探してから言う"}, {"type": "subtitle", "time": 19334.39, "timestamp": "05:22:14", "text": "皆さんさようなら、そして私は"}, {"type": "subtitle", "time": 19337.31, "timestamp": "05:22:17", "text": "あなたとのつながりがもっと深まるかもしれない"}, {"type": "subtitle", "time": 19340.03, "timestamp": "05:22:20", "text": "チャットに参加している全員と"}, {"type": "subtitle", "time": 19344.23, "timestamp": "05:22:24", "text": "うわー、Gは本当に速い"}, {"type": "subtitle", "time": 19348.03, "timestamp": "05:22:28", "text": "ああ、彼らはすでに大きな銃を持っていた。"}, {"type": "subtitle", "time": 19350.868, "timestamp": "05:22:30", "text": "ピストルピストルのチャントは私を救ってくれなかったが"}, {"type": "subtitle", "time": 19352.548, "timestamp": "05:22:32", "text": "その"}, {"type": "subtitle", "time": 19356.19, "timestamp": "05:22:36", "text": "わかった、えっと、音楽が流れてるから待って"}, {"type": "subtitle", "time": 19359.03, "timestamp": "05:22:39", "text": "ミュートしました、はい、実行中です"}, {"type": "subtitle", "time": 19374.23, "timestamp": "05:22:54", "text": "スケジュールは待機中です"}]
[{"type": "subtitle", "time": 16202.95, "timestamp": "04:30:02", "text": "ジョーク待って"}, {"type": "subtitle", "time": 16207.75, "timestamp": "04:30:07", "text": "ノタキ、えっと、挨拶って何でしたっけ？"}, {"type": "subtitle", "time": 16208.87, "timestamp": "04:30:08", "text": "私は"}, {"type": "subtitle", "time": 16212.87, "timestamp": "04:30:12", "text": "ゴダックは読書中"}, {"type": "subtitle", "time": 16214.87, "timestamp": "04:30:14", "text": "ああ、緑のことについて話しているんだけど"}, {"type": "subtitle", "time": 16217.309, "timestamp": "04:30:17", "text": "自分自身にも挨拶をするべきだ"}, {"type": "subtitle", "time": 16221.71, "timestamp": "04:30:21", "text": "私の配信にはいつも「Halo」と言っています"}, {"type": "subtitle", "time": 16223.67, "timestamp": "04:30:23", "text": "そう、だから私たちは"}, {"type": "subtitle", "time": 16230.469, "timestamp": "04:30:30", "text": "もしそれがOHAのような朝であれば"}, {"type": "subtitle", "time": 16233.149, "timestamp": "04:30:33", "text": "JoとかOHAみたいなもの"}, {"type": "subtitle", "time": 16237.269, "timestamp": "04:30:37", "text": "ジョーはツイッターで言ってるけど、私はそうじゃない"}, {"type": "subtitle", "time": 16239.91, "timestamp": "04:30:39", "text": "知る"}, {"type": "subtitle", "time": 16246.229, "timestamp": "04:30:46", "text": "あるいは「私はそうしない」といった感じ"}, {"type": "subtitle", "time": 16250.189, "timestamp": "04:30:50", "text": "うん、あなたの挨拶は文字通りどうですか"}, {"type": "subtitle", "time": 16256.109, "timestamp": "04:30:56", "text": "うん、私はいつも「うん、こんにちは」って言うよ。"}, {"type": "subtitle", "time": 16259.83, "timestamp": "04:30:59", "text": "私はいつも「うん、こんにちは」とたくさん言ってから"}]
[{"type": "subtitle", "time": 23100.43, "timestamp": "06:25:00", "text": "その"}, {"type": "subtitle", "time": 23103.07, "timestamp": "06:25:03", "text": "質問があれば教えてください"}, {"type": "subtitle", "time": 23104.868, "timestamp": "06:25:04", "text": "チャットで質問してください。私が答えます。"}, {"type": "subtitle", "time": 23107.548, "timestamp": "06:25:07", "text": "ああ、なんて美味しそうなんだろう"}, {"type": "subtitle", "time": 23115.67, "timestamp": "06:25:15", "text": "すべてがそのような"}, {"type": "subtitle", "time": 23119.788, "timestamp": "06:25:19", "text": "かわいい、えっと、知りたい、知りたい"}, {"type": "subtitle", "time": 23122.948, "timestamp": "06:25:22", "text": "モデルの背後には誰がいたのか、はい、誰でも"}, {"type": "subtitle", "time": 23125.99, "timestamp": "06:25:25", "text": "I I のモデルに取り組んだのは誰かという質問"}, {"type": "subtitle", "time": 23128.43, "timestamp": "06:25:28", "text": "かもしれないと思う"}, {"type": "subtitle", "time": 23131.11, "timestamp": "06:25:31", "text": "私 私 OB"}, {"type": "subtitle", "time": 23138.628, "timestamp": "06:25:38", "text": "私が"}, {"type": "subtitle", "time": 23139.59, "timestamp": "06:25:39", "text": "非常に"}, {"type": "subtitle", "time": 23157.43, "timestamp": "06:25:57", "text": "[音楽]"}]
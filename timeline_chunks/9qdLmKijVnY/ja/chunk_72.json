[{"type": "subtitle", "time": 4324.31, "timestamp": "01:12:04", "text": "ああ、私は回復は必要ない、"}, {"type": "subtitle", "time": 4330.709, "timestamp": "01:12:10", "text": "[音楽]"}, {"type": "subtitle", "time": 4339.91, "timestamp": "01:12:19", "text": "ベイビー、これは何？待って、彼らは"}, {"type": "subtitle", "time": 4342.31, "timestamp": "01:12:22", "text": "この木箱の中に"}, {"type": "subtitle", "time": 4345.99, "timestamp": "01:12:25", "text": "このレベルデザインには何があるのか"}, {"type": "subtitle", "time": 4348.99, "timestamp": "01:12:28", "text": "デザインは、まるで2つの要素が融合したかのようだ。"}, {"type": "subtitle", "time": 4365.83, "timestamp": "01:12:45", "text": "私が持っていけるもの"}]
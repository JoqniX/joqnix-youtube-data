[{"type": "subtitle", "time": 4639.35, "timestamp": "01:17:19", "text": "向こうの男が怖い"}, {"type": "subtitle", "time": 4642.59, "timestamp": "01:17:22", "text": "ここで私はその男を怖がっています"}, {"type": "subtitle", "time": 4644.51, "timestamp": "01:17:24", "text": "ソロが好きなんですね、つまりシールドの"}, {"type": "subtitle", "time": 4646.629, "timestamp": "01:17:26", "text": "違いは時にとても重要になる"}, {"type": "subtitle", "time": 4659.149, "timestamp": "01:17:39", "text": "メッセージソロは楽しいです。"}, {"type": "subtitle", "time": 4662.47, "timestamp": "01:17:42", "text": "私のようにただ遊びたい人"}]
[{"type": "subtitle", "time": 21300.468, "timestamp": "05:55:00", "text": "最後に、水分補給を忘れずに。HF"}, {"type": "subtitle", "time": 21304.03, "timestamp": "05:55:04", "text": "健康でいてね"}, {"type": "subtitle", "time": 21307.19, "timestamp": "05:55:07", "text": "また、もしあなたが望むなら、もしあなたが望むなら"}, {"type": "subtitle", "time": 21310.15, "timestamp": "05:55:10", "text": "他の配信者を応援するならどうぞ"}, {"type": "subtitle", "time": 21312.39, "timestamp": "05:55:12", "text": "彼らを先導し、支援し、彼らに与える"}, {"type": "subtitle", "time": 21316.83, "timestamp": "05:55:16", "text": "頭と温かいチャットのために"}, {"type": "subtitle", "time": 21320.91, "timestamp": "05:55:20", "text": "温かいメッセージとかわいい素敵なメッセージ"}, {"type": "subtitle", "time": 21323.868, "timestamp": "05:55:23", "text": "彼らにはかわいい良いものもある"}, {"type": "subtitle", "time": 21326.15, "timestamp": "05:55:26", "text": "時間"}, {"type": "subtitle", "time": 21331.868, "timestamp": "05:55:31", "text": "旅の幸運を祈っています"}, {"type": "subtitle", "time": 21335.708, "timestamp": "05:55:35", "text": "残りの一日の旅の先"}, {"type": "subtitle", "time": 21338.868, "timestamp": "05:55:38", "text": "夜、夕方、朝、何でもあなたにとって"}, {"type": "subtitle", "time": 21341.99, "timestamp": "05:55:41", "text": "そうですね、誰かが"}, {"type": "subtitle", "time": 21344.93, "timestamp": "05:55:44", "text": "切り替えることを知ってください"}, {"type": "subtitle", "time": 21346.59, "timestamp": "05:55:46", "text": "[音楽]"}, {"type": "subtitle", "time": 21348.83, "timestamp": "05:55:48", "text": "エンディング"}, {"type": "subtitle", "time": 21354.03, "timestamp": "05:55:54", "text": "だから、君への最後の温かい頭の脂肪"}, {"type": "subtitle", "time": 21358.07, "timestamp": "05:55:58", "text": "みんな、Mは一人一人を全員にすることはできない"}]
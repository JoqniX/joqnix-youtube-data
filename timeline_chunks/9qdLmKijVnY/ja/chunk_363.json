[{"type": "subtitle", "time": 21791.43, "timestamp": "06:03:11", "text": "これを再読み込みする必要があります。"}, {"type": "subtitle", "time": 21794.948, "timestamp": "06:03:14", "text": "戻って、後ろを見てみましょう。これは"}, {"type": "subtitle", "time": 21796.43, "timestamp": "06:03:16", "text": "あなたがこう言ったら私がする顔"}, {"type": "subtitle", "time": 21801.23, "timestamp": "06:03:21", "text": "チャットで何かBが、ああ、なんてかわいいんだ"}, {"type": "subtitle", "time": 21804.83, "timestamp": "06:03:24", "text": "とにかく可愛い。ごめんなさい。"}, {"type": "subtitle", "time": 21806.72, "timestamp": "06:03:26", "text": "だから、"}, {"type": "subtitle", "time": 21808.628, "timestamp": "06:03:28", "text": "[音楽]"}, {"type": "subtitle", "time": 21811.67, "timestamp": "06:03:31", "text": "コメント大好きです、見た目も大好きです"}, {"type": "subtitle", "time": 21816.27, "timestamp": "06:03:36", "text": "だから彼の成長ぶりは本当にすごい。"}, {"type": "subtitle", "time": 21818.948, "timestamp": "06:03:38", "text": "とてもかわいいです、大好きです"}, {"type": "subtitle", "time": 21822.27, "timestamp": "06:03:42", "text": "これ大好き"}, {"type": "subtitle", "time": 21826.708, "timestamp": "06:03:46", "text": "とにかく、うんうん、もちろん、あなたは"}, {"type": "subtitle", "time": 21829.07, "timestamp": "06:03:49", "text": "みんな、VIって何？って聞くかもしれないよ"}, {"type": "subtitle", "time": 21831.548, "timestamp": "06:03:51", "text": "配信が終わったら何をするつもり？"}, {"type": "subtitle", "time": 21833.43, "timestamp": "06:03:53", "text": "終わらせたいけど、それから、わからない"}, {"type": "subtitle", "time": 21837.15, "timestamp": "06:03:57", "text": "5分くらいだよ、20分だよ、おい"}]
[{"type": "subtitle", "time": 14106.95, "timestamp": "03:55:06", "text": "それは、どこへ行くのかという質問が多いということです"}, {"type": "subtitle", "time": 14114.67, "timestamp": "03:55:14", "text": "[音楽]"}, {"type": "subtitle", "time": 14116.87, "timestamp": "03:55:16", "text": "くそ"}, {"type": "subtitle", "time": 14127.389, "timestamp": "03:55:27", "text": "光学機器が必要な理由"}, {"type": "subtitle", "time": 14138.51, "timestamp": "03:55:38", "text": "実際にどう考えるか"}, {"type": "subtitle", "time": 14142.79, "timestamp": "03:55:42", "text": "私はこれとこれを受け取ります。"}, {"type": "subtitle", "time": 14146.03, "timestamp": "03:55:46", "text": "私はこれを使える媒体を持っています"}]
[{"type": "subtitle", "time": 14523.11, "timestamp": "04:02:03", "text": "間違いだったけど、それは良かった"}, {"type": "subtitle", "time": 14526.55, "timestamp": "04:02:06", "text": "試合が終わったのに気づかなかった"}, {"type": "subtitle", "time": 14529.429, "timestamp": "04:02:09", "text": "ああ、そうだった"}, {"type": "subtitle", "time": 14531.79, "timestamp": "04:02:11", "text": "近いですね、そしてそれは"}, {"type": "subtitle", "time": 14535.67, "timestamp": "04:02:15", "text": "楽しい、そしておかえりなさいマガジン"}, {"type": "subtitle", "time": 14545.429, "timestamp": "04:02:25", "text": "上"}, {"type": "subtitle", "time": 14548.87, "timestamp": "04:02:28", "text": "皆さん、ちょっと待ってください。始める前に、"}, {"type": "subtitle", "time": 14552.87, "timestamp": "04:02:32", "text": "私のポイントを確認してください"}, {"type": "subtitle", "time": 14555.83, "timestamp": "04:02:35", "text": "何を話せばいいか、"}, {"type": "subtitle", "time": 14559.469, "timestamp": "04:02:39", "text": "チームメイトとか、なんで"}, {"type": "subtitle", "time": 14563.59, "timestamp": "04:02:43", "text": "そうですね、ロニック、私はあなたを何に使うつもりですか？"}, {"type": "subtitle", "time": 14565.79, "timestamp": "04:02:45", "text": "いいえ、私はプロではありません。"}]
[{"type": "subtitle", "time": 12780.55, "timestamp": "03:33:00", "text": "アカウントは良かった、本当に楽しかった"}, {"type": "subtitle", "time": 12782.309, "timestamp": "03:33:02", "text": "私の時間"}, {"type": "subtitle", "time": 12784.67, "timestamp": "03:33:04", "text": "ああ、そうだった"}, {"type": "subtitle", "time": 12787.11, "timestamp": "03:33:07", "text": "楽しかったよ、本当に"}, {"type": "subtitle", "time": 12790.229, "timestamp": "03:33:10", "text": "楽しいし、何が起きてるの？"}, {"type": "subtitle", "time": 12794.91, "timestamp": "03:33:14", "text": "ここで彼は、えーと、何について話していますか"}, {"type": "subtitle", "time": 12797.67, "timestamp": "03:33:17", "text": "それをいくつかのものと呼んで、"}, {"type": "subtitle", "time": 12802.99, "timestamp": "03:33:22", "text": "えーと、私たちはついさっき芸術について話していたところだったんです"}, {"type": "subtitle", "time": 12809.07, "timestamp": "03:33:29", "text": "うんうん、私が最初に投稿したよ"}, {"type": "subtitle", "time": 12813.429, "timestamp": "03:33:33", "text": "合計リスト、待って、今ツイートしたの？"}, {"type": "subtitle", "time": 12817.11, "timestamp": "03:33:37", "text": "死んでるの？"}, {"type": "subtitle", "time": 12819.83, "timestamp": "03:33:39", "text": "TR それはとても"}, {"type": "subtitle", "time": 12823.189, "timestamp": "03:33:43", "text": "かわいいですね"}, {"type": "subtitle", "time": 12827.229, "timestamp": "03:33:47", "text": "カワイイ、私もリツイートするよ"}, {"type": "subtitle", "time": 12834.229, "timestamp": "03:33:54", "text": "こんにちは、それで、私はこれをやろうと思ったんです"}, {"type": "subtitle", "time": 12837.59, "timestamp": "03:33:57", "text": "チャット えーと、実は私の"}]
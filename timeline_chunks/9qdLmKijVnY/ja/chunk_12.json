[{"type": "subtitle", "time": 742.43, "timestamp": "00:12:22", "text": "最後なし"}, {"type": "subtitle", "time": 746.71, "timestamp": "00:12:26", "text": "3月12日更新　えっと、私のものは"}, {"type": "subtitle", "time": 749.15, "timestamp": "00:12:29", "text": "更新されていません。Twitchの支払いが反映されていません。"}, {"type": "subtitle", "time": 752.59, "timestamp": "00:12:32", "text": "更新済みですが、4月に更新されます"}, {"type": "subtitle", "time": 756.43, "timestamp": "00:12:36", "text": "12日なので、それは月として正しい"}, {"type": "subtitle", "time": 759.99, "timestamp": "00:12:39", "text": "ストリーミングは大丈夫、実際"}, {"type": "subtitle", "time": 766.03, "timestamp": "00:12:46", "text": "私たちには1ヶ月の、ええ、それは実際に"}, {"type": "subtitle", "time": 767.389, "timestamp": "00:12:47", "text": "1つとしてマークする"}, {"type": "subtitle", "time": 769.509, "timestamp": "00:12:49", "text": "月"}, {"type": "subtitle", "time": 771.23, "timestamp": "00:12:51", "text": "ジョアサン"}, {"type": "subtitle", "time": 774.87, "timestamp": "00:12:54", "text": "えっと、4月12日だけ"}, {"type": "subtitle", "time": 777.949, "timestamp": "00:12:57", "text": "私が"}, {"type": "subtitle", "time": 779.19, "timestamp": "00:12:59", "text": "推定値"}]
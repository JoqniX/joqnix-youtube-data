[{"type": "subtitle", "time": 20822.788, "timestamp": "05:47:02", "text": "誰か、ソン・アダタが来ると言った"}, {"type": "subtitle", "time": 20824.59, "timestamp": "05:47:04", "text": "今日、あなたが"}, {"type": "subtitle", "time": 20835.27, "timestamp": "05:47:15", "text": "誰か見落としたかな？"}, {"type": "subtitle", "time": 20837.39, "timestamp": "05:47:17", "text": "いいえ、そして"}, {"type": "subtitle", "time": 20840.23, "timestamp": "05:47:20", "text": "今後の予定"}, {"type": "subtitle", "time": 20844.548, "timestamp": "05:47:24", "text": "今日、うん、私もハニーも、どうやって"}, {"type": "subtitle", "time": 20846.99, "timestamp": "05:47:26", "text": "忘れることができるだろうか"}, {"type": "subtitle", "time": 20851.31, "timestamp": "05:47:31", "text": "もし私が電話するのを忘れたとしても"}, {"type": "subtitle", "time": 20855.35, "timestamp": "05:47:35", "text": "今日話した人の名前は"}, {"type": "subtitle", "time": 20858.468, "timestamp": "05:47:38", "text": "チャット本当に本当に感謝しています"}, {"type": "subtitle", "time": 20866.35, "timestamp": "05:47:46", "text": "ストリーム"}, {"type": "subtitle", "time": 20870.07, "timestamp": "05:47:50", "text": "そして、バカカさん、お元気で。"}, {"type": "subtitle", "time": 20877.59, "timestamp": "05:47:57", "text": "ケア、次の配信は"}]
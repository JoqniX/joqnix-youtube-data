[{"type": "subtitle", "time": 5825.709, "timestamp": "01:37:05", "text": "何が私を再び生き返らせたのか、これは痛みだ"}, {"type": "subtitle", "time": 5828.95, "timestamp": "01:37:08", "text": "えっと、インスタグラムをやめたいんだけど"}, {"type": "subtitle", "time": 5863.99, "timestamp": "01:37:43", "text": "もっと"}, {"type": "subtitle", "time": 5868.87, "timestamp": "01:37:48", "text": "よし、こっちを試してみたよ。"}, {"type": "subtitle", "time": 5871.75, "timestamp": "01:37:51", "text": "これが私の最後の人生だ"}]
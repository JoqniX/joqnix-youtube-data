[{"type": "subtitle", "time": 12362.79, "timestamp": "03:26:02", "text": "あと、えっと、それを何て言うんだっけ、"}, {"type": "subtitle", "time": 12365.309, "timestamp": "03:26:05", "text": "時々ちょっとした頭痛がする"}, {"type": "subtitle", "time": 12367.349, "timestamp": "03:26:07", "text": "しかし"}, {"type": "subtitle", "time": 12371.75, "timestamp": "03:26:11", "text": "うん、でもまあ大丈夫だよ、元気？"}, {"type": "subtitle", "time": 12373.99, "timestamp": "03:26:13", "text": "口が動かないときに話す"}, {"type": "subtitle", "time": 12376.75, "timestamp": "03:26:16", "text": "開ける、えっと、私は"}, {"type": "subtitle", "time": 12380.469, "timestamp": "03:26:20", "text": "話すのは、"}, {"type": "subtitle", "time": 12383.51, "timestamp": "03:26:23", "text": "画像と私が話せることは、あなたが見ることができます"}, {"type": "subtitle", "time": 12384.91, "timestamp": "03:26:24", "text": "私の口"}, {"type": "subtitle", "time": 12389.429, "timestamp": "03:26:29", "text": "ビジュアライザーを使用して開く"}, {"type": "subtitle", "time": 12391.469, "timestamp": "03:26:31", "text": "右"}, {"type": "subtitle", "time": 12398.229, "timestamp": "03:26:38", "text": "行くけど、いつか作りたい"}, {"type": "subtitle", "time": 12400.51, "timestamp": "03:26:40", "text": "私が"}, {"type": "subtitle", "time": 12403.75, "timestamp": "03:26:43", "text": "話すと、口が開いたりするんだけど、"}, {"type": "subtitle", "time": 12406.51, "timestamp": "03:26:46", "text": "持っていない"}, {"type": "subtitle", "time": 12411.07, "timestamp": "03:26:51", "text": "えーと他の表現"}, {"type": "subtitle", "time": 12416.87, "timestamp": "03:26:56", "text": "これは私のものですが、私の母はまだ持っていません。"}, {"type": "subtitle", "time": 12419.469, "timestamp": "03:26:59", "text": "最近忙しかったので、"}]
[{"type": "subtitle", "time": 22264.35, "timestamp": "06:11:04", "text": "私は彼の近くにいるが、私はどう見えるだろうか"}, {"type": "subtitle", "time": 22265.99, "timestamp": "06:11:05", "text": "気が散ってしまった"}, {"type": "subtitle", "time": 22268.19, "timestamp": "06:11:08", "text": "だって、すごく滑らかだからね"}, {"type": "subtitle", "time": 22270.35, "timestamp": "06:11:10", "text": "すべてがとてもスムーズで"}, {"type": "subtitle", "time": 22273.83, "timestamp": "06:11:13", "text": "すごく素敵で、とても良さそうなので、"}, {"type": "subtitle", "time": 22276.708, "timestamp": "06:11:16", "text": "このモデルをずっと見ながら"}, {"type": "subtitle", "time": 22278.75, "timestamp": "06:11:18", "text": "1時間かけてすべてのものを見ています"}, {"type": "subtitle", "time": 22281.708, "timestamp": "06:11:21", "text": "モデルを作成してこれを行い、それから私は"}, {"type": "subtitle", "time": 22283.83, "timestamp": "06:11:23", "text": "ずっと揺れながら進んでいた"}, {"type": "subtitle", "time": 22286.91, "timestamp": "06:11:26", "text": "クソみたいな1時間"}, {"type": "subtitle", "time": 22291.15, "timestamp": "06:11:31", "text": "揺れるのを知って気を散らす"}, {"type": "subtitle", "time": 22294.83, "timestamp": "06:11:34", "text": "行くよ、何、何行くの？"}, {"type": "subtitle", "time": 22297.39, "timestamp": "06:11:37", "text": "ジョー、ウィックの配信を見るつもり？"}, {"type": "subtitle", "time": 22300.11, "timestamp": "06:11:40", "text": "ウィックは今デブイで、ウィックは"}, {"type": "subtitle", "time": 22303.43, "timestamp": "06:11:43", "text": "まもなくgenin Maに参加します"}, {"type": "subtitle", "time": 22305.03, "timestamp": "06:11:45", "text": "協力して"}, {"type": "subtitle", "time": 22307.59, "timestamp": "06:11:47", "text": "今日は時計をしています"}, {"type": "subtitle", "time": 22309.83, "timestamp": "06:11:49", "text": "に沿って"}, {"type": "subtitle", "time": 22312.948, "timestamp": "06:11:52", "text": "瞬間か何かがセール中"}]
[{"type": "subtitle", "time": 5415.109, "timestamp": "01:30:15", "text": "よし、あの混乱を乗り越えなきゃ。"}, {"type": "subtitle", "time": 5417.83, "timestamp": "01:30:17", "text": "Havoc はとても良いです、彼らは変更します"}, {"type": "subtitle", "time": 5420.59, "timestamp": "01:30:20", "text": "献身は今や、彼らはそれをより緊密にした"}, {"type": "subtitle", "time": 5422.87, "timestamp": "01:30:22", "text": "さあ、それを持つと"}, {"type": "subtitle", "time": 5425.91, "timestamp": "01:30:25", "text": "レティクルはこのように広がり、"}, {"type": "subtitle", "time": 5427.83, "timestamp": "01:30:27", "text": "本当に"}]
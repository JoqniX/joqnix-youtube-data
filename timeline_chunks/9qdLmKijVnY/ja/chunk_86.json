[{"type": "subtitle", "time": 5164.03, "timestamp": "01:26:04", "text": "ああ、これは難しいゲームだ"}, {"type": "subtitle", "time": 5177.47, "timestamp": "01:26:17", "text": "アル、元気？エドワードは元気？"}, {"type": "subtitle", "time": 5180.79, "timestamp": "01:26:20", "text": "うまくいっていると本当に汗だくで、"}, {"type": "subtitle", "time": 5183.31, "timestamp": "01:26:23", "text": "20爆弾バッジはもらえるのかな？"}, {"type": "subtitle", "time": 5190.109, "timestamp": "01:26:30", "text": "私はただソロで勝利したいだけです"}, {"type": "subtitle", "time": 5199.149, "timestamp": "01:26:39", "text": "試してみます。私ができる最善のことは、"}, {"type": "subtitle", "time": 5202.59, "timestamp": "01:26:42", "text": "ソロプレイでのゲーム感覚は、かなり難しい。"}, {"type": "subtitle", "time": 5206.31, "timestamp": "01:26:46", "text": "もちろん、私たちは遊ぶことができます。"}, {"type": "subtitle", "time": 5209.27, "timestamp": "01:26:49", "text": "ゆっくりやると、ある程度効果があります"}]
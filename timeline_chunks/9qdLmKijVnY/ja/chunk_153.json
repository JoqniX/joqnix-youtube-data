[{"type": "subtitle", "time": 9183.23, "timestamp": "02:33:03", "text": "一生懸命に泣いたよ、ああ"}, {"type": "subtitle", "time": 9193.23, "timestamp": "02:33:13", "text": "D 私は去ったので"}, {"type": "subtitle", "time": 9197.11, "timestamp": "02:33:17", "text": "絶対に行かないから"}, {"type": "subtitle", "time": 9201.11, "timestamp": "02:33:21", "text": "難しい なぜこのゲームはこんなに難しいのか"}, {"type": "subtitle", "time": 9203.99, "timestamp": "02:33:23", "text": "そして、私はどれくらい前からストリーミング配信をしていますか？"}, {"type": "subtitle", "time": 9210.91, "timestamp": "02:33:30", "text": "[音楽]"}]
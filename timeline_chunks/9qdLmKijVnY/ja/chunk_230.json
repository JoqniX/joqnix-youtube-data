[{"type": "subtitle", "time": 13811.67, "timestamp": "03:50:11", "text": "わあ、ワクワクするわ、これは私の"}, {"type": "subtitle", "time": 13817.229, "timestamp": "03:50:17", "text": "最初のゲームは、私がどこにいるか、えっと、私は"}, {"type": "subtitle", "time": 13820.55, "timestamp": "03:50:20", "text": "カスタマイズして遊ぶ"}, {"type": "subtitle", "time": 13823.67, "timestamp": "03:50:23", "text": "ああ、そうだね"}, {"type": "subtitle", "time": 13845.349, "timestamp": "03:50:45", "text": "ジャスティス、ヘイ"}, {"type": "subtitle", "time": 13856.349, "timestamp": "03:50:56", "text": "集中する"}, {"type": "subtitle", "time": 13858.79, "timestamp": "03:50:58", "text": "フォーカス フォーカス"}]
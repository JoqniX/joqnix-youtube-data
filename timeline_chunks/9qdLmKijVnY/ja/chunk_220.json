[{"type": "subtitle", "time": 13207.83, "timestamp": "03:40:07", "text": "スカ、えっと、ゲームは何？"}, {"type": "subtitle", "time": 13211.55, "timestamp": "03:40:11", "text": "シーン、あ、待って、手動で"}, {"type": "subtitle", "time": 13214.4, "timestamp": "03:40:14", "text": "これを切り替える"}, {"type": "subtitle", "time": 13216.83, "timestamp": "03:40:16", "text": "[音楽]"}, {"type": "subtitle", "time": 13221.15, "timestamp": "03:40:21", "text": "こんにちは、あ、待って、チャットを非表示にした方がいいかな。"}, {"type": "subtitle", "time": 13234.309, "timestamp": "03:40:34", "text": "でも始める前に、えーと、"}, {"type": "subtitle", "time": 13237.79, "timestamp": "03:40:37", "text": "これをやろうと思ったんだけど、"}, {"type": "subtitle", "time": 13241.189, "timestamp": "03:40:41", "text": "最近、これをやってみようと思った"}, {"type": "subtitle", "time": 13243.59, "timestamp": "03:40:43", "text": "最近は、"}, {"type": "subtitle", "time": 13248.309, "timestamp": "03:40:48", "text": "実際、私は地図を隠します"}, {"type": "subtitle", "time": 13251.83, "timestamp": "03:40:51", "text": "私は地図を隠しているだろう"}, {"type": "subtitle", "time": 13253.75, "timestamp": "03:40:53", "text": "最近考えている"}, {"type": "subtitle", "time": 13255.79, "timestamp": "03:40:55", "text": "について"}, {"type": "subtitle", "time": 13258.75, "timestamp": "03:40:58", "text": "それは"}]
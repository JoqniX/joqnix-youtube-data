[{"type": "subtitle", "time": 11342.309, "timestamp": "03:09:02", "text": "衝動的なことをして、自分のものをより"}, {"type": "subtitle", "time": 11345.349, "timestamp": "03:09:05", "text": "毎回複雑になるのは、"}, {"type": "subtitle", "time": 11353.71, "timestamp": "03:09:13", "text": "願望と、私はすべてを"}, {"type": "subtitle", "time": 11356.87, "timestamp": "03:09:16", "text": "すべてを自分自身に背負わせるように"}, {"type": "subtitle", "time": 11360.51, "timestamp": "03:09:20", "text": "誰の助けも求めずに"}, {"type": "subtitle", "time": 11364.99, "timestamp": "03:09:24", "text": "手伝ってもらって、自分でやって、"}, {"type": "subtitle", "time": 11367.19, "timestamp": "03:09:27", "text": "どれだけ"}, {"type": "subtitle", "time": 11370.07, "timestamp": "03:09:30", "text": "あなたに影響を与える可能性があります"}, {"type": "subtitle", "time": 11381.15, "timestamp": "03:09:41", "text": "時間、そして、そう、それは私に、その間"}, {"type": "subtitle", "time": 11383.59, "timestamp": "03:09:43", "text": "休止中、私はたくさんのことを考えていました"}, {"type": "subtitle", "time": 11386.469, "timestamp": "03:09:46", "text": "正直に言って来たかったこと"}, {"type": "subtitle", "time": 11390.429, "timestamp": "03:09:50", "text": "1月に戻るのは、"}, {"type": "subtitle", "time": 11395.349, "timestamp": "03:09:55", "text": "年だけど、もし私が"}, {"type": "subtitle", "time": 11397.87, "timestamp": "03:09:57", "text": "えっと、私は、その間ずっとそう言い続ける"}]
[{"type": "subtitle", "time": 22688.67, "timestamp": "06:18:08", "text": "ジョー、元気？ うん、こんにちは。元気だよ。"}, {"type": "subtitle", "time": 22691.59, "timestamp": "06:18:11", "text": "私は元気です、元気です、あなたはどうですか"}, {"type": "subtitle", "time": 22708.91, "timestamp": "06:18:28", "text": "楽しい。デビュー作にはちょっと満足している。"}, {"type": "subtitle", "time": 22711.91, "timestamp": "06:18:31", "text": "実際、私はこうなると思っていました"}, {"type": "subtitle", "time": 22714.07, "timestamp": "06:18:34", "text": "来ると思ったのは、"}, {"type": "subtitle", "time": 22716.91, "timestamp": "06:18:36", "text": "あまりにも突然だったけど、すべてが"}, {"type": "subtitle", "time": 22720.15, "timestamp": "06:18:40", "text": "突然ですが、ズームアップできますか？"}, {"type": "subtitle", "time": 22724.03, "timestamp": "06:18:44", "text": "傷跡は確かに、ああ、ある"}, {"type": "subtitle", "time": 22726.59, "timestamp": "06:18:46", "text": "傷跡"}, {"type": "subtitle", "time": 22729.19, "timestamp": "06:18:49", "text": "だから全てが「ああ、彼は"}, {"type": "subtitle", "time": 22731.468, "timestamp": "06:18:51", "text": "右目の傷跡がすごく可愛い"}, {"type": "subtitle", "time": 22735.23, "timestamp": "06:18:55", "text": "ズームインするととてもかわいいので、"}, {"type": "subtitle", "time": 22737.83, "timestamp": "06:18:57", "text": "何も灰になっていない、ああ神様"}, {"type": "subtitle", "time": 22739.948, "timestamp": "06:18:59", "text": "待って、ハイライトが見える？"}]
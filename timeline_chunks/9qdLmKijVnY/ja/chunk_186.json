[{"type": "subtitle", "time": 11165.269, "timestamp": "03:06:05", "text": "ダウン症候群、私はたくさん飲んだと思う"}, {"type": "subtitle", "time": 11168.79, "timestamp": "03:06:08", "text": "hiuses はこれを壊すのが好きです"}, {"type": "subtitle", "time": 11173.309, "timestamp": "03:06:13", "text": "年、そしてそれはその期間中に放送されました"}, {"type": "subtitle", "time": 11175.269, "timestamp": "03:06:15", "text": "前日"}, {"type": "subtitle", "time": 11179.59, "timestamp": "03:06:19", "text": "私が発表した記念日"}, {"type": "subtitle", "time": 11181.71, "timestamp": "03:06:21", "text": "私は"}, {"type": "subtitle", "time": 11184.67, "timestamp": "03:06:24", "text": "個人的な理由による記念日"}, {"type": "subtitle", "time": 11187.87, "timestamp": "03:06:27", "text": "ええ、あの時は色々と大変でした"}, {"type": "subtitle", "time": 11198.99, "timestamp": "03:06:38", "text": "すべて、そしてええ、私は"}, {"type": "subtitle", "time": 11201.71, "timestamp": "03:06:41", "text": "何らかのものを作る"}, {"type": "subtitle", "time": 11205.87, "timestamp": "03:06:45", "text": "内容ですが、えっと"}, {"type": "subtitle", "time": 11216.429, "timestamp": "03:06:56", "text": "待って、わかった、私は"}, {"type": "subtitle", "time": 11219.59, "timestamp": "03:06:59", "text": "ええ、私は配りたかったんです"}]
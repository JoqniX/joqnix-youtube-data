[{"type": "subtitle", "time": 4262.91, "timestamp": "01:11:02", "text": "画家たちは、"}, {"type": "subtitle", "time": 4265.43, "timestamp": "01:11:05", "text": "プライマーとかいうやつC"}, {"type": "subtitle", "time": 4267.669, "timestamp": "01:11:07", "text": "プライマーか何かコーティング剤"}, {"type": "subtitle", "time": 4270.35, "timestamp": "01:11:10", "text": "塗料を加える前に加えると"}, {"type": "subtitle", "time": 4272.229, "timestamp": "01:11:12", "text": "彼らがそうしていたので、私はただ彼らを見ていました"}, {"type": "subtitle", "time": 4273.59, "timestamp": "01:11:13", "text": "する"}, {"type": "subtitle", "time": 4300.43, "timestamp": "01:11:40", "text": "いや、待って、私は"}, {"type": "subtitle", "time": 4307.03, "timestamp": "01:11:47", "text": "神様、大丈夫です、私は注意を払っていませんでした"}]
[{"type": "subtitle", "time": 421.309, "timestamp": "00:07:01", "text": "私の4月は、私が"}, {"type": "subtitle", "time": 424.79, "timestamp": "00:07:04", "text": "委託作品"}, {"type": "subtitle", "time": 427.79, "timestamp": "00:07:07", "text": "モデル関連のものから始まります"}, {"type": "subtitle", "time": 431.67, "timestamp": "00:07:11", "text": "芸術的な意味では、そう、芸術的な側面は"}, {"type": "subtitle", "time": 434.15, "timestamp": "00:07:14", "text": "修正が必要で、修正が必要な"}, {"type": "subtitle", "time": 436.16, "timestamp": "00:07:16", "text": "そして何かを詰め込む"}, {"type": "subtitle", "time": 438.51, "timestamp": "00:07:18", "text": "[音楽]"}, {"type": "subtitle", "time": 445.309, "timestamp": "00:07:25", "text": "心配だけど、うまくいくといいな"}, {"type": "subtitle", "time": 449.71, "timestamp": "00:07:29", "text": "実際だけど、まあ、何でもいいよ"}, {"type": "subtitle", "time": 453.30899999999997, "timestamp": "00:07:33", "text": "待って、ああ、それはそれだ"}, {"type": "subtitle", "time": 456.35, "timestamp": "00:07:36", "text": "もう一つ気になるのは、Twitchが使えるかどうかです。"}, {"type": "subtitle", "time": 473.67, "timestamp": "00:07:53", "text": "それは良いことだと思います。"}, {"type": "subtitle", "time": 474.79, "timestamp": "00:07:54", "text": "私たち"}, {"type": "subtitle", "time": 478.189, "timestamp": "00:07:58", "text": "つまり、私たちはただ、私は"}]
[{"type": "subtitle", "time": 12121.189, "timestamp": "03:22:01", "text": "私と皆さんに"}, {"type": "subtitle", "time": 12125.15, "timestamp": "03:22:05", "text": "ハッピーサンデー、そして良い一日を"}, {"type": "subtitle", "time": 12129.309, "timestamp": "03:22:09", "text": "月の何日目かは、まあ、ベストを尽くすしかないね"}, {"type": "subtitle", "time": 12132.429, "timestamp": "03:22:12", "text": "よし、今日は失敗しないで、生産的に過ごそう。"}, {"type": "subtitle", "time": 12137.269, "timestamp": "03:22:17", "text": "君はこれを手に入れた、こんにちは、さようなら"}]
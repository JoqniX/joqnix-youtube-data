[{"type": "subtitle", "time": 4743.51, "timestamp": "01:19:03", "text": "待って、私は信じられない言い訳を生きていないの？"}, {"type": "subtitle", "time": 4745.149, "timestamp": "01:19:05", "text": "自分"}, {"type": "subtitle", "time": 4748.709, "timestamp": "01:19:08", "text": "待って、それは「すみません、放送が」と表示されます"}, {"type": "subtitle", "time": 4757.11, "timestamp": "01:19:17", "text": "私は何に生きているのか"}, {"type": "subtitle", "time": 4759.07, "timestamp": "01:19:19", "text": "ライブ"}, {"type": "subtitle", "time": 4761.79, "timestamp": "01:19:21", "text": "おお"}, {"type": "subtitle", "time": 4764.75, "timestamp": "01:19:24", "text": "どうして？リストに載ってないんだけど"}, {"type": "subtitle", "time": 4768.189, "timestamp": "01:19:28", "text": "それから私はライブ配信を始めました"}, {"type": "subtitle", "time": 4781.83, "timestamp": "01:19:41", "text": "でもこの試合が終わったら考えてみるよ"}, {"type": "subtitle", "time": 4796.03, "timestamp": "01:19:56", "text": "あちらには土地があって、"}]
[{"type": "subtitle", "time": 2282.829, "timestamp": "00:38:02", "text": "時々ですが、それはそういうものであり、"}, {"type": "subtitle", "time": 2285.71, "timestamp": "00:38:05", "text": "はい、それでは画面を1つ吹き飛ばします"}, {"type": "subtitle", "time": 2289.589, "timestamp": "00:38:09", "text": "2番目、えっと、最後のビリービリーストリーム"}, {"type": "subtitle", "time": 2292.95, "timestamp": "00:38:12", "text": "チャットのものが手に入らなかった"}, {"type": "subtitle", "time": 2295.47, "timestamp": "00:38:15", "text": "通常は、えっと、なんて言うんだっけ"}, {"type": "subtitle", "time": 2298.95, "timestamp": "00:38:18", "text": "チャットのスクリーンショットとか、えっと、"}, {"type": "subtitle", "time": 2302.15, "timestamp": "00:38:22", "text": "チェックしたり、いろいろできます"}, {"type": "subtitle", "time": 2303.67, "timestamp": "00:38:23", "text": "考える"}, {"type": "subtitle", "time": 2308.349, "timestamp": "00:38:28", "text": "でも最後の配信は忘れてた"}, {"type": "subtitle", "time": 2310.95, "timestamp": "00:38:30", "text": "保存し忘れたので、"}, {"type": "subtitle", "time": 2312.589, "timestamp": "00:38:32", "text": "起こったよ、じゃあ"}, {"type": "subtitle", "time": 2316.109, "timestamp": "00:38:36", "text": "さあ行こう、射撃場に入ろう"}, {"type": "subtitle", "time": 2319.95, "timestamp": "00:38:39", "text": "音声が良好であることを願っています。"}, {"type": "subtitle", "time": 2324.27, "timestamp": "00:38:44", "text": "ええと、うまく機能しています。良いですね。ロックを解除しました。"}, {"type": "subtitle", "time": 2327.15, "timestamp": "00:38:47", "text": "ウルタ、そしてさらに、それは"}, {"type": "subtitle", "time": 2332.23, "timestamp": "00:38:52", "text": "よし、行こう。それでは、"}, {"type": "subtitle", "time": 2335.91, "timestamp": "00:38:55", "text": "オルターワンをプレイしよう"}]
[{"type": "subtitle", "time": 16330.55, "timestamp": "04:32:10", "text": "怖いけど"}, {"type": "subtitle", "time": 16335.189, "timestamp": "04:32:15", "text": "怖かったけど、ジャンプスケアはなかった"}, {"type": "subtitle", "time": 16340.79, "timestamp": "04:32:20", "text": "y を統合します、はい、1、はい、次、ああ、はい、私は"}, {"type": "subtitle", "time": 16348.469, "timestamp": "04:32:28", "text": "忘れた、待って、待って、待って、待って、何だったか"}, {"type": "subtitle", "time": 16351.67, "timestamp": "04:32:31", "text": "私が以前使っていた言葉"}, {"type": "subtitle", "time": 16355.71, "timestamp": "04:32:35", "text": "Discordってどんな感じだったんだろう、組み合わせてみたんだけど"}, {"type": "subtitle", "time": 16357.469, "timestamp": "04:32:37", "text": "ああ、そうだね"}, {"type": "subtitle", "time": 16359.87, "timestamp": "04:32:39", "text": "こんにちは、すみません、集中していたら"}, {"type": "subtitle", "time": 16362.469, "timestamp": "04:32:42", "text": "誰かと話すのは大丈夫です"}, {"type": "subtitle", "time": 16365.349, "timestamp": "04:32:45", "text": "その"}, {"type": "subtitle", "time": 16374.269, "timestamp": "04:32:54", "text": "えっと、あれは何だったっけ？えっと、名前は？"}, {"type": "subtitle", "time": 16377.309, "timestamp": "04:32:57", "text": "昔使ってた言葉、えーと、昔は、"}]
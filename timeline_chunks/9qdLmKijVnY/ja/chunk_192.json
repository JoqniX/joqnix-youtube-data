[{"type": "subtitle", "time": 11525.07, "timestamp": "03:12:05", "text": "まるで焦りの決断だったけど、私はやった"}, {"type": "subtitle", "time": 11529.309, "timestamp": "03:12:09", "text": "そして私はここにいる、私は知りたくない"}, {"type": "subtitle", "time": 11531.469, "timestamp": "03:12:11", "text": "そうなるかもしれないと考える人もいた"}, {"type": "subtitle", "time": 11535.19, "timestamp": "03:12:15", "text": "卒業式など、私がやっていたように"}, {"type": "subtitle", "time": 11538.99, "timestamp": "03:12:18", "text": "特にストリーム向けのもの"}, {"type": "subtitle", "time": 11542.03, "timestamp": "03:12:22", "text": "しかし、私は伝えたい"}, {"type": "subtitle", "time": 11545.389, "timestamp": "03:12:25", "text": "はい、私からあなたへ、私は"}, {"type": "subtitle", "time": 11552.79, "timestamp": "03:12:32", "text": "心は時々、自分の"}, {"type": "subtitle", "time": 11556.389, "timestamp": "03:12:36", "text": "涙もろい性格"}, {"type": "subtitle", "time": 11565.91, "timestamp": "03:12:45", "text": "うん、難しいけど、言いたいのは"}, {"type": "subtitle", "time": 11568.349, "timestamp": "03:12:48", "text": "私は"}, {"type": "subtitle", "time": 11573.03, "timestamp": "03:12:53", "text": "あまりできなくて申し訳ないです。"}, {"type": "subtitle", "time": 11576.389, "timestamp": "03:12:56", "text": "記念日の配信を祝う"}, {"type": "subtitle", "time": 11578.55, "timestamp": "03:12:58", "text": "未来がどこにあるか、どのように知る"}]
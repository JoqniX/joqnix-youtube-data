[{"type": "subtitle", "time": 184.149, "timestamp": "00:03:04", "text": "なぜもっと睡眠が必要だと感じるのか"}, {"type": "subtitle", "time": 186.67, "timestamp": "00:03:06", "text": "私が寝た"}, {"type": "subtitle", "time": 191.75, "timestamp": "00:03:11", "text": "面白いことに、私は7時半に寝ました。"}, {"type": "subtitle", "time": 193.99, "timestamp": "00:03:13", "text": "昨日、配信をした後、"}, {"type": "subtitle", "time": 195.99, "timestamp": "00:03:15", "text": "Bと話をしてから寝た"}, {"type": "subtitle", "time": 199.82999999999998, "timestamp": "00:03:19", "text": "そうだけど、8 8とか、そうだよね。だから"}, {"type": "subtitle", "time": 204.309, "timestamp": "00:03:24", "text": "8時から10時か9時頃、私は寝ていた。目が覚めた。"}, {"type": "subtitle", "time": 207.789, "timestamp": "00:03:27", "text": "犬の魅力のおかげで"}, {"type": "subtitle", "time": 213.82999999999998, "timestamp": "00:03:33", "text": "熱いものをください"}, {"type": "subtitle", "time": 216.82999999999998, "timestamp": "00:03:36", "text": "水"}, {"type": "subtitle", "time": 222.71, "timestamp": "00:03:42", "text": "そして私は夕食を食べに行きました"}, {"type": "subtitle", "time": 228.82999999999998, "timestamp": "00:03:48", "text": "朝じゃなくて、夜、10時か11時くらいかな"}, {"type": "subtitle", "time": 230.91, "timestamp": "00:03:50", "text": "ええ、持っていました"}]
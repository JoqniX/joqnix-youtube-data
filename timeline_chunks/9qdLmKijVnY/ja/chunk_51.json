[{"type": "subtitle", "time": 3071.19, "timestamp": "00:51:11", "text": "えっ、なんてことだ、怖かったよ、あ、待って、"}, {"type": "subtitle", "time": 3073.15, "timestamp": "00:51:13", "text": "リスポーンを忘れた、忘れた"}, {"type": "subtitle", "time": 3074.87, "timestamp": "00:51:14", "text": "復讐のために戻ってくるよ"}, {"type": "subtitle", "time": 3078.15, "timestamp": "00:51:18", "text": "こんにちは、JPさん"}, {"type": "subtitle", "time": 3080.87, "timestamp": "00:51:20", "text": "ようこそ、私は死者を迎えに来た"}, {"type": "subtitle", "time": 3084.549, "timestamp": "00:51:24", "text": "パーティオ、私が来る"}, {"type": "subtitle", "time": 3094.549, "timestamp": "00:51:34", "text": "えー、私には無理だと思う。"}, {"type": "subtitle", "time": 3096.51, "timestamp": "00:51:36", "text": "冗談でしょ？冗談じゃないよね？"}, {"type": "subtitle", "time": 3097.87, "timestamp": "00:51:37", "text": "そうですね"}, {"type": "subtitle", "time": 3110.829, "timestamp": "00:51:50", "text": "俺だよ、あ、待てよ、俺も武器を手に入れるんだ、何だって？"}]
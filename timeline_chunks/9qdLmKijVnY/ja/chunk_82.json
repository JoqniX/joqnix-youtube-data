[{"type": "subtitle", "time": 4931.669, "timestamp": "01:22:11", "text": "愚かなことは話さない"}, {"type": "subtitle", "time": 4933.75, "timestamp": "01:22:13", "text": "それ"}, {"type": "subtitle", "time": 4938.47, "timestamp": "01:22:18", "text": "私たちはそのことについては話さない、ああ神様"}, {"type": "subtitle", "time": 4948.55, "timestamp": "01:22:28", "text": "すべてにわずかに外れたところが気に入っています"}, {"type": "subtitle", "time": 4976.55, "timestamp": "01:22:56", "text": "大丈夫、一時的な不平等放送と書いてある"}, {"type": "subtitle", "time": 4978.229, "timestamp": "01:22:58", "text": "ストリーミング配信は試すべきじゃないと思うんだけど"}]
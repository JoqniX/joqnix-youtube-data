[{"type": "subtitle", "time": 20051.21, "timestamp": "05:34:11", "text": "バカカ"}, {"type": "subtitle", "time": 20052.708, "timestamp": "05:34:12", "text": "[音楽]"}, {"type": "subtitle", "time": 20056.91, "timestamp": "05:34:16", "text": "やか、いやいや、そういう意味じゃなかったんだよ、えっと、"}, {"type": "subtitle", "time": 20059.31, "timestamp": "05:34:19", "text": "でも、つまり、"}, {"type": "subtitle", "time": 20062.59, "timestamp": "05:34:22", "text": "えっと、えっと、なんて言うんだっけ"}, {"type": "subtitle", "time": 20065.708, "timestamp": "05:34:25", "text": "えっと、どう言うんだっけ、どう言うんだっけ"}, {"type": "subtitle", "time": 20071.67, "timestamp": "05:34:31", "text": "えっと、最近は、えっと、"}, {"type": "subtitle", "time": 20074.27, "timestamp": "05:34:34", "text": "えっと"}, {"type": "subtitle", "time": 20077.868, "timestamp": "05:34:37", "text": "個人的な攻撃がここに来ています"}, {"type": "subtitle", "time": 20079.35, "timestamp": "05:34:39", "text": "左側と"}, {"type": "subtitle", "time": 20082.27, "timestamp": "05:34:42", "text": "そうですね、でも私はまだ与えられていません"}, {"type": "subtitle", "time": 20085.868, "timestamp": "05:34:45", "text": "それほど注目はされていないが、それでも"}, {"type": "subtitle", "time": 20090.11, "timestamp": "05:34:50", "text": "えっと、でも、そういう風にならないで"}, {"type": "subtitle", "time": 20095.548, "timestamp": "05:34:55", "text": "人、または次のような人は"}]
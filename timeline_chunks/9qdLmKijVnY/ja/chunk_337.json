[{"type": "subtitle", "time": 20221.83, "timestamp": "05:37:01", "text": "そして最悪のTを経験させる"}, {"type": "subtitle", "time": 20224.47, "timestamp": "05:37:04", "text": "世界のすべて"}, {"type": "subtitle", "time": 20228.83, "timestamp": "05:37:08", "text": "ええ、なんて言うんでしょう"}, {"type": "subtitle", "time": 20232.67, "timestamp": "05:37:12", "text": "えっと、私のような感受性の強い人間としては"}, {"type": "subtitle", "time": 20235.948, "timestamp": "05:37:15", "text": "昔の私ならこうしていたと思う"}, {"type": "subtitle", "time": 20238.31, "timestamp": "05:37:18", "text": "小さいものなら何でも、それが"}, {"type": "subtitle", "time": 20240.83, "timestamp": "05:37:20", "text": "ずっと昔に私に起こったこと"}, {"type": "subtitle", "time": 20244.708, "timestamp": "05:37:24", "text": "以前私はそれを心に留め、そして"}, {"type": "subtitle", "time": 20247.59, "timestamp": "05:37:27", "text": "内側から私を愛してくれた"}, {"type": "subtitle", "time": 20249.948, "timestamp": "05:37:29", "text": "内面を破壊したと言えるかもしれないが"}, {"type": "subtitle", "time": 20252.43, "timestamp": "05:37:32", "text": "今は違う"}, {"type": "subtitle", "time": 20256.23, "timestamp": "05:37:36", "text": "でも昔の私を見たら、ジョーは"}, {"type": "subtitle", "time": 20261.03, "timestamp": "05:37:41", "text": "Twitchでストリーミング配信中、次はwe2 Jです"}, {"type": "subtitle", "time": 20262.83, "timestamp": "05:37:42", "text": "私は少し変わったと思う"}, {"type": "subtitle", "time": 20264.31, "timestamp": "05:37:44", "text": "より強く、"}, {"type": "subtitle", "time": 20271.07, "timestamp": "05:37:51", "text": "非常に強いですが、それでも私は"}, {"type": "subtitle", "time": 20274.59, "timestamp": "05:37:54", "text": "少し強いですが、とても役に立ちます"}, {"type": "subtitle", "time": 20279.11, "timestamp": "05:37:59", "text": "そう、私は自分らしくいられる"}]
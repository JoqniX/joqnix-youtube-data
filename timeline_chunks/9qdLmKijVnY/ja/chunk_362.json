[{"type": "subtitle", "time": 21724.35, "timestamp": "06:02:04", "text": "今日は喉の調子がすごく悪い"}, {"type": "subtitle", "time": 21741.11, "timestamp": "06:02:21", "text": "文字通りビクターの声"}, {"type": "subtitle", "time": 21744.868, "timestamp": "06:02:24", "text": "見守るだけでいいですか？"}, {"type": "subtitle", "time": 21747.19, "timestamp": "06:02:27", "text": "今はそうではない"}, {"type": "subtitle", "time": 21751.43, "timestamp": "06:02:31", "text": "えっと、待って、やるべきかな、私は"}, {"type": "subtitle", "time": 21753.708, "timestamp": "06:02:33", "text": "そうすべきだ"}, {"type": "subtitle", "time": 21757.788, "timestamp": "06:02:37", "text": "いや、彼を見てみよう"}, {"type": "subtitle", "time": 21761.35, "timestamp": "06:02:41", "text": "うん、見てみよう"}, {"type": "subtitle", "time": 21765.75, "timestamp": "06:02:45", "text": "彼、うん、彼を見よう、うん、見よう"}, {"type": "subtitle", "time": 21776.03, "timestamp": "06:02:56", "text": "待って、じゃあ後ろの３つを見てみよう"}]
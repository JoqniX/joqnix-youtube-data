[{"type": "subtitle", "time": 23160.99, "timestamp": "06:26:00", "text": "wi 私はまた擦り傷を作っていたが、大丈夫だ。"}, {"type": "subtitle", "time": 23163.59, "timestamp": "06:26:03", "text": "ストリームが少しバッファリングしています"}, {"type": "subtitle", "time": 23165.468, "timestamp": "06:26:05", "text": "理由がわからない"}, {"type": "subtitle", "time": 23169.27, "timestamp": "06:26:09", "text": "nightbot 他の人がここにいるのが見えるよ、行こう"}, {"type": "subtitle", "time": 23171.35, "timestamp": "06:26:11", "text": "存在しないとは言えない"}, {"type": "subtitle", "time": 23174.03, "timestamp": "06:26:14", "text": "ショー、私は自分の"}, {"type": "subtitle", "time": 23176.83, "timestamp": "06:26:16", "text": "ナイトボットが私の"}, {"type": "subtitle", "time": 23181.23, "timestamp": "06:26:21", "text": "視聴者の皆さん、くそっ"}, {"type": "subtitle", "time": 23184.39, "timestamp": "06:26:24", "text": "nightbot とにかくおめでとう"}, {"type": "subtitle", "time": 23186.708, "timestamp": "06:26:26", "text": "新しいモデル、本当にありがとうございます"}, {"type": "subtitle", "time": 23189.43, "timestamp": "06:26:29", "text": "感謝します。私はまあまあ元気です。"}, {"type": "subtitle", "time": 23192.39, "timestamp": "06:26:32", "text": "びっくり仰天、本当にびっくり仰天、私は今まで"}, {"type": "subtitle", "time": 23195.788, "timestamp": "06:26:35", "text": "ライブモデルを扱うように"}, {"type": "subtitle", "time": 23199.35, "timestamp": "06:26:39", "text": "ストリームなので、ちょっとたるんでいると思います。"}, {"type": "subtitle", "time": 23201.75, "timestamp": "06:26:41", "text": "また、私も遊んでいます"}, {"type": "subtitle", "time": 23203.59, "timestamp": "06:26:43", "text": "トグルスイッチの操作に慣れてきたと思う"}, {"type": "subtitle", "time": 23205.03, "timestamp": "06:26:45", "text": "その"}, {"type": "subtitle", "time": 23209.35, "timestamp": "06:26:49", "text": "とにかく、彼に会えて嬉しいよ。"}, {"type": "subtitle", "time": 23211.07, "timestamp": "06:26:51", "text": "V2スタジオに慣れて"}, {"type": "subtitle", "time": 23215.468, "timestamp": "06:26:55", "text": "すべてがスムーズで、まるで「えーと」という感じではない"}, {"type": "subtitle", "time": 23217.468, "timestamp": "06:26:57", "text": "聞こえた？みんな聞こえてる？"}]
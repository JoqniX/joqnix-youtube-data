[{"type": "subtitle", "time": 21061.39, "timestamp": "05:51:01", "text": "私の頭の中のオーディオの音楽"}, {"type": "subtitle", "time": 21063.67, "timestamp": "05:51:03", "text": "電話なので"}, {"type": "subtitle", "time": 21067.99, "timestamp": "05:51:07", "text": "ええ、そういうことです"}, {"type": "subtitle", "time": 21073.27, "timestamp": "05:51:13", "text": "Twitchのやつ、えーと次は私の次のえーと"}, {"type": "subtitle", "time": 21075.628, "timestamp": "05:51:15", "text": "スケジュールは、私は考えていました"}, {"type": "subtitle", "time": 21079.75, "timestamp": "05:51:19", "text": "スケジュールをGoogleに追加することについて"}, {"type": "subtitle", "time": 21084.548, "timestamp": "05:51:24", "text": "カレンダーを見て、"}, {"type": "subtitle", "time": 21089.708, "timestamp": "05:51:29", "text": "えっと、彼女の名前は何だっけ？寿司息子、やってみて"}, {"type": "subtitle", "time": 21092.83, "timestamp": "05:51:32", "text": "彼女の"}, {"type": "subtitle", "time": 21102.548, "timestamp": "05:51:42", "text": "いいねを追加して、何と呼ぶか"}, {"type": "subtitle", "time": 21105.35, "timestamp": "05:51:45", "text": "彼女はよくこう付け加えた。「なんて呼ぶの？」"}, {"type": "subtitle", "time": 21107.868, "timestamp": "05:51:47", "text": "それはGoogleカレンダーのようなもので"}, {"type": "subtitle", "time": 21111.868, "timestamp": "05:51:51", "text": "iOS向けの別のものもiOS"}, {"type": "subtitle", "time": 21114.67, "timestamp": "05:51:54", "text": "ユーザーには別のものも用意されるだ​​ろう"}, {"type": "subtitle", "time": 21118.548, "timestamp": "05:51:58", "text": "なので、それらを私のものに追加します"}]
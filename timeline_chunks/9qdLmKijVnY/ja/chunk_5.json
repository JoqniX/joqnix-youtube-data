[{"type": "subtitle", "time": 300.11, "timestamp": "00:05:00", "text": "睡眠リズムをリセットしたかったので早めに"}, {"type": "subtitle", "time": 302.629, "timestamp": "00:05:02", "text": "そしてそれは間違っている、悪いと感じた"}, {"type": "subtitle", "time": 304.99, "timestamp": "00:05:04", "text": "私、えっと"}, {"type": "subtitle", "time": 309.43, "timestamp": "00:05:09", "text": "5時に寝るのが私にとって良くない"}, {"type": "subtitle", "time": 312.749, "timestamp": "00:05:12", "text": "午前中 いいえ、それは"}, {"type": "subtitle", "time": 316.07, "timestamp": "00:05:16", "text": "悪い、脱出スケジュールを修正する必要がある"}, {"type": "subtitle", "time": 320.51, "timestamp": "00:05:20", "text": "明日、私はそれを直しました。"}, {"type": "subtitle", "time": 323.67, "timestamp": "00:05:23", "text": "今夜も楽しみにしています。"}, {"type": "subtitle", "time": 328.35, "timestamp": "00:05:28", "text": "早く寝て、12時前に寝るよ"}, {"type": "subtitle", "time": 334.11, "timestamp": "00:05:34", "text": "良い時間を過ごせたことを願っています。こんにちはベーコン"}, {"type": "subtitle", "time": 336.629, "timestamp": "00:05:36", "text": "ストリームへようこそ、もう1ヶ月経ちました"}, {"type": "chat", "time": 337.364, "timestamp": "00:05:37", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "why do i feel like everything is so quick day by day, but during the day, its just so slow"}, {"type": "subtitle", "time": 339.59000000000003, "timestamp": "00:05:39", "text": "うん、もう1ヶ月経ったね"}, {"type": "subtitle", "time": 343.43, "timestamp": "00:05:43", "text": "すでに、そして来月は月になります"}, {"type": "subtitle", "time": 348.629, "timestamp": "00:05:48", "text": "3月、なぜすべてが"}, {"type": "subtitle", "time": 351.43, "timestamp": "00:05:51", "text": "日々とても速く、しかしその間"}, {"type": "subtitle", "time": 353.469, "timestamp": "00:05:53", "text": "日が遅い"}, {"type": "subtitle", "time": 357.30899999999997, "timestamp": "00:05:57", "text": "うん、それは本当だよ、そうだね"}]
[{"type": "subtitle", "time": 12602.469, "timestamp": "03:30:02", "text": "人々は、すべての人々が"}, {"type": "subtitle", "time": 12605.99, "timestamp": "03:30:05", "text": "私がやることを見て、彼らはこれを理解しない"}, {"type": "subtitle", "time": 12609.63, "timestamp": "03:30:09", "text": "じろじろ見られすぎているという感覚"}, {"type": "subtitle", "time": 12617.37, "timestamp": "03:30:17", "text": "うん、あれは良かった"}, {"type": "subtitle", "time": 12619.269, "timestamp": "03:30:19", "text": "[音楽]"}, {"type": "subtitle", "time": 12622.83, "timestamp": "03:30:22", "text": "ジョー、ハッシュタグアートって何？えっと、何のために？"}, {"type": "subtitle", "time": 12624.349, "timestamp": "03:30:24", "text": "そうしない人たち"}, {"type": "subtitle", "time": 12629.189, "timestamp": "03:30:29", "text": "わかった、私は、まあ、決めるんだ"}, {"type": "subtitle", "time": 12635.63, "timestamp": "03:30:35", "text": "ARタグに決めたんだけど、"}, {"type": "subtitle", "time": 12640.59, "timestamp": "03:30:40", "text": "Twitterのプロフィールを更新しました。ジョーです。"}, {"type": "subtitle", "time": 12650.55, "timestamp": "03:30:50", "text": "これがアートになる"}, {"type": "subtitle", "time": 12653.389, "timestamp": "03:30:53", "text": "タグトーク"}, {"type": "subtitle", "time": 12656.87, "timestamp": "03:30:56", "text": "リストであり、このタグは誰にも使用されていません"}]
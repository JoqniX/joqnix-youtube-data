[{"type": "subtitle", "time": 2704.75, "timestamp": "00:45:04", "text": "ウムモバイル"}, {"type": "subtitle", "time": 2707.27, "timestamp": "00:45:07", "text": "何が起こっているのか"}, {"type": "subtitle", "time": 2709.75, "timestamp": "00:45:09", "text": "これについて"}, {"type": "subtitle", "time": 2713.51, "timestamp": "00:45:13", "text": "私はすべてのプラットフォームでライブ配信しています"}, {"type": "subtitle", "time": 2723.63, "timestamp": "00:45:23", "text": "ええ、垂直ストリームは"}, {"type": "subtitle", "time": 2726.589, "timestamp": "00:45:26", "text": "UIに一生懸命取り組んだ方法"}, {"type": "subtitle", "time": 2728.63, "timestamp": "00:45:28", "text": "良いのかどうかわからないと思う"}, {"type": "subtitle", "time": 2731.95, "timestamp": "00:45:31", "text": "でも最善を尽くしたよ、と考えたんだ"}, {"type": "subtitle", "time": 2735.15, "timestamp": "00:45:35", "text": "umを増やす、高さを増やす"}, {"type": "subtitle", "time": 2738.589, "timestamp": "00:45:38", "text": "そのうちだが"}, {"type": "subtitle", "time": 2741.79, "timestamp": "00:45:41", "text": "ええ、昨日はあなたの妻でした"}, {"type": "subtitle", "time": 2743.47, "timestamp": "00:45:43", "text": "名前"}, {"type": "subtitle", "time": 2747.349, "timestamp": "00:45:47", "text": "ああ、それは誰ですか、翻訳ですか"}]
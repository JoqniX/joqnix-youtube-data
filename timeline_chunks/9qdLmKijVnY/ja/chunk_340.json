[{"type": "subtitle", "time": 20400.628, "timestamp": "05:40:00", "text": "コラボ配信やゲームではなくゲームが好き"}, {"type": "subtitle", "time": 20402.91, "timestamp": "05:40:02", "text": "配信だけど、負けた時のコラボ配信"}, {"type": "subtitle", "time": 20407.35, "timestamp": "05:40:07", "text": "チャットの焦点は、私が対応できるときです"}, {"type": "subtitle", "time": 20409.788, "timestamp": "05:40:09", "text": "彼女はできた"}, {"type": "subtitle", "time": 20414.23, "timestamp": "05:40:14", "text": "ああ、そうだね、でもそれ以外は"}, {"type": "subtitle", "time": 20416.91, "timestamp": "05:40:16", "text": "えっと、あなたが妊娠していなくても大丈夫です"}, {"type": "subtitle", "time": 20420.548, "timestamp": "05:40:20", "text": "十分だよ、心配しないで、私は"}, {"type": "subtitle", "time": 20430.708, "timestamp": "05:40:30", "text": "彼らに今、いくつかのスピーチと"}, {"type": "subtitle", "time": 20433.948, "timestamp": "05:40:33", "text": "その他、そのようなものは許可します"}, {"type": "subtitle", "time": 20437.548, "timestamp": "05:40:37", "text": "チャットすると、ああ、そうそう、これが主なこと"}, {"type": "subtitle", "time": 20441.15, "timestamp": "05:40:41", "text": "ええ、創造主や"}, {"type": "subtitle", "time": 20444.75, "timestamp": "05:40:44", "text": "ストリーマー、私が名前を挙げない限り"}, {"type": "subtitle", "time": 20447.83, "timestamp": "05:40:47", "text": "ああ、これだよ、これ全部と"}, {"type": "subtitle", "time": 20450.67, "timestamp": "05:40:50", "text": "あと、自己宣伝もしすぎないでください"}, {"type": "subtitle", "time": 20453.548, "timestamp": "05:40:53", "text": "えっと、ストリームとかやってるなら"}, {"type": "subtitle", "time": 20456.07, "timestamp": "05:40:56", "text": "えっと、もしあなたのことを知ったら"}, {"type": "subtitle", "time": 20458.31, "timestamp": "05:40:58", "text": "ストリーマー、特にあなたに声をかけてあげます"}]
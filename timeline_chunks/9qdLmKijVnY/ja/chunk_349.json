[{"type": "subtitle", "time": 20946.83, "timestamp": "05:49:06", "text": "でも、えっと、私のページに行って、待って、これ"}, {"type": "subtitle", "time": 20950.43, "timestamp": "05:49:10", "text": "最後の配信、そう、短いTVJに行くよ"}, {"type": "subtitle", "time": 20954.23, "timestamp": "05:49:14", "text": "次にこれを見ることになるので、"}, {"type": "subtitle", "time": 20956.628, "timestamp": "05:49:16", "text": "このスケジュール表を見る必要がある"}, {"type": "subtitle", "time": 20959.708, "timestamp": "05:49:19", "text": "こちらをクリックするか、私の"}, {"type": "subtitle", "time": 20962.35, "timestamp": "05:49:22", "text": "私の最後の配信の名前は再生されますが"}, {"type": "subtitle", "time": 20966.708, "timestamp": "05:49:26", "text": "はい、一時停止してからスケジュールオーバーに進んでください。"}, {"type": "subtitle", "time": 20969.23, "timestamp": "05:49:29", "text": "ここには次の配信は金曜日だと書いてある"}, {"type": "subtitle", "time": 20971.868, "timestamp": "05:49:31", "text": "実際に編集するには、クリックしてください"}, {"type": "subtitle", "time": 20974.468, "timestamp": "05:49:34", "text": "金曜日のスケジュールはこうです"}, {"type": "subtitle", "time": 20977.19, "timestamp": "05:49:37", "text": "「リマインダー」というオプションがあります"}, {"type": "subtitle", "time": 20980.948, "timestamp": "05:49:40", "text": "それをクリックすると、"}, {"type": "subtitle", "time": 20984.07, "timestamp": "05:49:44", "text": "時間があれば、えーっと、やらなくてもいいよ。"}, {"type": "subtitle", "time": 20987.03, "timestamp": "05:49:47", "text": "タイムゾーンやその他を変換する"}, {"type": "subtitle", "time": 20990.708, "timestamp": "05:49:50", "text": "現地時間で表示されます。"}, {"type": "subtitle", "time": 20994.19, "timestamp": "05:49:54", "text": "ブラウザのcckをオンにすると、"}, {"type": "subtitle", "time": 20998.39, "timestamp": "05:49:58", "text": "Twitchで通知を受け取るには、携帯電話を使用してください。"}]
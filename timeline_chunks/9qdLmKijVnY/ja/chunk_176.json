[{"type": "subtitle", "time": 10560.07, "timestamp": "02:56:00", "text": "暗闇だが、それぞれの断片の中には"}, {"type": "subtitle", "time": 10566.11, "timestamp": "02:56:06", "text": "小さな持続的な火花がある"}, {"type": "subtitle", "time": 10569.83, "timestamp": "02:56:09", "text": "フェニックスの可能性を考えてみてください"}, {"type": "subtitle", "time": 10573.71, "timestamp": "02:56:13", "text": "自分の体から飛び立つ神話上の鳥"}, {"type": "subtitle", "time": 10577.29, "timestamp": "02:56:17", "text": "灰から生まれ変わった再会"}, {"type": "subtitle", "time": 10580.229, "timestamp": "02:56:20", "text": "[音楽]"}, {"type": "subtitle", "time": 10584.03, "timestamp": "02:56:24", "text": "更新された私たちの星は、"}, {"type": "subtitle", "time": 10586.269, "timestamp": "02:56:26", "text": "壊れる可能性がある"}, {"type": "subtitle", "time": 10590.87, "timestamp": "02:56:30", "text": "散らばって迷子になったように見えるが、"}, {"type": "subtitle", "time": 10593.389, "timestamp": "02:56:33", "text": "一緒に過ごす時間"}, {"type": "subtitle", "time": 10595.309, "timestamp": "02:56:35", "text": "忍耐強く"}, {"type": "subtitle", "time": 10597.87, "timestamp": "02:56:37", "text": "思いやり、特に"}, {"type": "subtitle", "time": 10601.91, "timestamp": "02:56:41", "text": "私たち自身は"}, {"type": "subtitle", "time": 10606.11, "timestamp": "02:56:46", "text": "スターを再建するには時間が必要です"}, {"type": "subtitle", "time": 10610.51, "timestamp": "02:56:50", "text": "星座を再調整する必要がある"}, {"type": "subtitle", "time": 10616.51, "timestamp": "02:56:56", "text": "10,000回描き直しても、それはあなたを定義するものではありません"}]
[{"type": "subtitle", "time": 18360.788, "timestamp": "05:06:00", "text": "スムーズに"}, {"type": "subtitle", "time": 18368.83, "timestamp": "05:06:08", "text": "私は眠れなくなった"}, {"type": "subtitle", "time": 18372.948, "timestamp": "05:06:12", "text": "これを持ってるけど、今は眠気は全くない"}, {"type": "subtitle", "time": 18375.31, "timestamp": "05:06:15", "text": "あるいは次のような"}, {"type": "subtitle", "time": 18378.14, "timestamp": "05:06:18", "text": "それはとても悪いことだ"}, {"type": "subtitle", "time": 18379.31, "timestamp": "05:06:19", "text": "[音楽]"}, {"type": "subtitle", "time": 18396.23, "timestamp": "05:06:36", "text": "まあまあ、夜眠くないなら"}]
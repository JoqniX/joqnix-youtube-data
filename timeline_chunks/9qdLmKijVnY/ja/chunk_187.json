[{"type": "subtitle", "time": 11222.83, "timestamp": "03:07:02", "text": "ショットやビデオのような形式の何か"}, {"type": "subtitle", "time": 11227.51, "timestamp": "03:07:07", "text": "何かを世に出すためなら何でもするが"}, {"type": "subtitle", "time": 11233.429, "timestamp": "03:07:13", "text": "どうしてもやる気になれなかった"}, {"type": "subtitle", "time": 11236.11, "timestamp": "03:07:16", "text": "のように"}, {"type": "subtitle", "time": 11242.229, "timestamp": "03:07:22", "text": "次回またお話しして戻ってきます"}, {"type": "subtitle", "time": 11244.03, "timestamp": "03:07:24", "text": "それ"}, {"type": "subtitle", "time": 11251.79, "timestamp": "03:07:31", "text": "決定、ええ、それは本当に"}, {"type": "subtitle", "time": 11254.75, "timestamp": "03:07:34", "text": "難しい決断だ"}, {"type": "subtitle", "time": 11258.349, "timestamp": "03:07:38", "text": "だって、言いたくないんだけど、"}, {"type": "subtitle", "time": 11261.229, "timestamp": "03:07:41", "text": "ある時点で私は考えた"}, {"type": "subtitle", "time": 11263.95, "timestamp": "03:07:43", "text": "活動を停止するのと同様"}, {"type": "subtitle", "time": 11271.55, "timestamp": "03:07:51", "text": "うん、そうだね"}, {"type": "subtitle", "time": 11276.389, "timestamp": "03:07:56", "text": "しかし、私は自分の人生でこれを何度も言ってきた"}, {"type": "subtitle", "time": 11278.71, "timestamp": "03:07:58", "text": "長年にわたり、私は"}, {"type": "subtitle", "time": 11279.91, "timestamp": "03:07:59", "text": "今まで"}]
[{"type": "subtitle", "time": 21963.27, "timestamp": "06:06:03", "text": "喉に何か入っているのが好きでなければならない、ああ、私の喉"}, {"type": "subtitle", "time": 21964.39, "timestamp": "06:06:04", "text": "吸血鬼"}, {"type": "subtitle", "time": 21967.91, "timestamp": "06:06:07", "text": "プレント 何を Aon 何を"}, {"type": "subtitle", "time": 21971.19, "timestamp": "06:06:11", "text": "何が起こったのか"}, {"type": "subtitle", "time": 21974.43, "timestamp": "06:06:14", "text": "スロープに歯が生えた"}, {"type": "subtitle", "time": 21981.11, "timestamp": "06:06:21", "text": "吸血鬼、えーと、レのファンが何なのかわからない"}, {"type": "subtitle", "time": 21986.15, "timestamp": "06:06:26", "text": "名前 ハロー ニンジャ 叫ばないで、"}, {"type": "subtitle", "time": 21990.27, "timestamp": "06:06:30", "text": "かすかな忍者が描いた"}, {"type": "subtitle", "time": 21997.15, "timestamp": "06:06:37", "text": "ああ、とにかく、きっとあなたはこう思うでしょう。「何？」"}, {"type": "subtitle", "time": 22002.788, "timestamp": "06:06:42", "text": "[音楽]"}, {"type": "subtitle", "time": 22006.43, "timestamp": "06:06:46", "text": "ストリーミング配信中なので、ここでゆっくりします"}, {"type": "subtitle", "time": 22010.91, "timestamp": "06:06:50", "text": "えーっと、ジェニオンの準備はできていますか？"}, {"type": "subtitle", "time": 22014.27, "timestamp": "06:06:54", "text": "俺は下忍を準備させるつもりだ"}, {"type": "subtitle", "time": 22016.51, "timestamp": "06:06:56", "text": "実際私は"}]
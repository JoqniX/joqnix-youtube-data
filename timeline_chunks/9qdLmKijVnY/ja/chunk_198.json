[{"type": "subtitle", "time": 11880.79, "timestamp": "03:18:00", "text": "はい、それでは、聞いてくれてありがとう"}, {"type": "subtitle", "time": 11883.67, "timestamp": "03:18:03", "text": "楽しんでいただけたら嬉しいです。"}, {"type": "subtitle", "time": 11885.349, "timestamp": "03:18:05", "text": "五"}, {"type": "subtitle", "time": 11888.11, "timestamp": "03:18:08", "text": "1分で、私も初めてでした"}, {"type": "subtitle", "time": 11891.75, "timestamp": "03:18:11", "text": "物語のような語り口で"}, {"type": "subtitle", "time": 11893.229, "timestamp": "03:18:13", "text": "終わったとか何かわからないけど、私は一度も"}, {"type": "subtitle", "time": 11897.95, "timestamp": "03:18:17", "text": "うん"}, {"type": "subtitle", "time": 11900.99, "timestamp": "03:18:20", "text": "ええと、楽しんでいます"}, {"type": "subtitle", "time": 11902.87, "timestamp": "03:18:22", "text": "それ"}, {"type": "subtitle", "time": 11906.59, "timestamp": "03:18:26", "text": "そして、そのメッセージは主に"}, {"type": "subtitle", "time": 11909.99, "timestamp": "03:18:29", "text": "苦労している人たちをたくさん知っています"}, {"type": "subtitle", "time": 11915.03, "timestamp": "03:18:35", "text": "多くの人々が苦しんでいる。"}, {"type": "subtitle", "time": 11919.83, "timestamp": "03:18:39", "text": "そう、諦めずにベストを尽くして"}, {"type": "subtitle", "time": 11924.71, "timestamp": "03:18:44", "text": "はい、そして一歩踏み出すことを恐れないでください"}, {"type": "subtitle", "time": 11926.83, "timestamp": "03:18:46", "text": "たとえあなたが"}, {"type": "subtitle", "time": 11928.99, "timestamp": "03:18:48", "text": "考えすぎと、考えすぎと、"}, {"type": "subtitle", "time": 11931.189, "timestamp": "03:18:51", "text": "考えすぎて"}, {"type": "subtitle", "time": 11933.189, "timestamp": "03:18:53", "text": "寝る"}, {"type": "subtitle", "time": 11939.269, "timestamp": "03:18:59", "text": "夜になると心がどんどんさまよう"}]
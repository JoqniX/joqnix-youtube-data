[{"type": "subtitle", "time": 13320.149, "timestamp": "03:42:00", "text": "左に、なぜか分からない、M が終わった後"}, {"type": "subtitle", "time": 13323.79, "timestamp": "03:42:03", "text": "作った後、とても"}, {"type": "subtitle", "time": 13327.11, "timestamp": "03:42:07", "text": "いいよ、待って、もし私がアーマーシールドを手に入れたら"}, {"type": "subtitle", "time": 13330.11, "timestamp": "03:42:10", "text": "それがとても"}, {"type": "subtitle", "time": 13332.83, "timestamp": "03:42:12", "text": "蔡、君はそれを見る"}, {"type": "subtitle", "time": 13337.03, "timestamp": "03:42:17", "text": "ああ、まさにその通り。あなたはまるでプロみたいですね。"}, {"type": "subtitle", "time": 13340.51, "timestamp": "03:42:20", "text": "まさにその通り、私も同じように感じた、私も同じ"}, {"type": "subtitle", "time": 13342.83, "timestamp": "03:42:22", "text": "昨日の配信で私が"}, {"type": "subtitle", "time": 13346.75, "timestamp": "03:42:26", "text": "試してみたところ、感じたことはすべて"}, {"type": "subtitle", "time": 13348.75, "timestamp": "03:42:28", "text": "それで"}, {"type": "subtitle", "time": 13352.51, "timestamp": "03:42:32", "text": "幸せ、まるで"}, {"type": "subtitle", "time": 13354.51, "timestamp": "03:42:34", "text": "えーっと"}, {"type": "subtitle", "time": 13357.59, "timestamp": "03:42:37", "text": "ストリーマー、ユーチューバー、ストリーマー、"}, {"type": "subtitle", "time": 13362.79, "timestamp": "03:42:42", "text": "彼ら自身の、えーと、彼ら自身の"}, {"type": "subtitle", "time": 13371.71, "timestamp": "03:42:51", "text": "すべて"}, {"type": "subtitle", "time": 13375.309, "timestamp": "03:42:55", "text": "ああ、それはまさにハワイだ"}, {"type": "subtitle", "time": 13377.269, "timestamp": "03:42:57", "text": "それはとても"}, {"type": "subtitle", "time": 13379.91, "timestamp": "03:42:59", "text": "ハワイ、ああ、そうそう"}]
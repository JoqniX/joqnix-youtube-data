[{"type": "subtitle", "time": 4021.269, "timestamp": "01:07:01", "text": "汗だくのように、またはノーのようにプレイしないでください"}, {"type": "subtitle", "time": 4024.269, "timestamp": "01:07:04", "text": "さりげなく、きちんと、わかるでしょ、そしてそれは"}, {"type": "subtitle", "time": 4028.39, "timestamp": "01:07:08", "text": "なぜ、なぜ、私はまだ"}, {"type": "subtitle", "time": 4030.63, "timestamp": "01:07:10", "text": "慣れていない"}, {"type": "subtitle", "time": 4035.99, "timestamp": "01:07:15", "text": "ゲームなので、タオルを置きます"}]
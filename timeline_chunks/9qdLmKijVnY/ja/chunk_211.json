[{"type": "subtitle", "time": 12661.75, "timestamp": "03:31:01", "text": "そうでなければ、ファン広告を作成したり、"}, {"type": "subtitle", "time": 12664.99, "timestamp": "03:31:04", "text": "何か、えーとF、何か、えーとあなたが"}, {"type": "subtitle", "time": 12667.83, "timestamp": "03:31:07", "text": "何かを作ることは"}, {"type": "subtitle", "time": 12672.91, "timestamp": "03:31:12", "text": "アニメーションはイラストまたは"}, {"type": "subtitle", "time": 12677.189, "timestamp": "03:31:17", "text": "私と私の性格に基づいたものなら何でも"}, {"type": "subtitle", "time": 12681.229, "timestamp": "03:31:21", "text": "わかりました、では、それを作る場合は、"}, {"type": "subtitle", "time": 12684.189, "timestamp": "03:31:24", "text": "Twitter でこのハッシュタグを使用し、"}, {"type": "subtitle", "time": 12687.79, "timestamp": "03:31:27", "text": "視聴者の皆さんへ"}, {"type": "subtitle", "time": 12689.59, "timestamp": "03:31:29", "text": "えっと、私の"}, {"type": "subtitle", "time": 12694.189, "timestamp": "03:31:34", "text": "Discord えーと、私は、えーと、"}, {"type": "subtitle", "time": 12698.51, "timestamp": "03:31:38", "text": "アートやその他諸々を紹介する"}, {"type": "subtitle", "time": 12699.83, "timestamp": "03:31:39", "text": "君たち"}, {"type": "subtitle", "time": 12706.429, "timestamp": "03:31:46", "text": "Discordにいる間に、"}, {"type": "subtitle", "time": 12709.15, "timestamp": "03:31:49", "text": "このハッシュタグを付けてTwitterにアップロードしてください"}, {"type": "subtitle", "time": 12712.71, "timestamp": "03:31:52", "text": "だから私はDMで質問します"}, {"type": "subtitle", "time": 12715.469, "timestamp": "03:31:55", "text": "許可は、"}, {"type": "subtitle", "time": 12719.03, "timestamp": "03:31:59", "text": "私への素敵な贈り物"}]
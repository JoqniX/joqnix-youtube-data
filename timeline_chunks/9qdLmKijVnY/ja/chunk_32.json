[{"type": "subtitle", "time": 1920.59, "timestamp": "00:32:00", "text": "アニメーション作品はありますか"}, {"type": "subtitle", "time": 1923.59, "timestamp": "00:32:03", "text": "このような見た目"}, {"type": "subtitle", "time": 1927.99, "timestamp": "00:32:07", "text": "いいぞ、これは実際に合う、なぜなら尻尾が"}, {"type": "subtitle", "time": 1931.43, "timestamp": "00:32:11", "text": "いいえ、私は"}, {"type": "subtitle", "time": 1935.11, "timestamp": "00:32:15", "text": "このバッジはあまり持っていないよ、ああ、うん。"}, {"type": "subtitle", "time": 1938.149, "timestamp": "00:32:18", "text": "これらは新しいUMソロモードバッジです"}, {"type": "subtitle", "time": 1939.909, "timestamp": "00:32:19", "text": "私たちはそのために努力します"}, {"type": "subtitle", "time": 1942.269, "timestamp": "00:32:22", "text": "今日はゲームが下手だけど"}, {"type": "subtitle", "time": 1945.35, "timestamp": "00:32:25", "text": "最善を尽くします、これは何ですか"}, {"type": "subtitle", "time": 1951.99, "timestamp": "00:32:31", "text": "わあ、なんてことだ"}, {"type": "subtitle", "time": 1955.59, "timestamp": "00:32:35", "text": "神様、ダイナミックなエクスセント、ああ、彼女はそれを使う"}, {"type": "subtitle", "time": 1959.909, "timestamp": "00:32:39", "text": "ポータルはいいえ、ええ、これは待つことができます"}, {"type": "subtitle", "time": 1964.629, "timestamp": "00:32:44", "text": "私は拳をカスタマイズします、ああこれは"}]
[{"type": "subtitle", "time": 16020.469, "timestamp": "04:27:00", "text": "ああ、そう、それから私は"}, {"type": "subtitle", "time": 16025.349, "timestamp": "04:27:05", "text": "えーとフォローし始めた えーとすべての"}, {"type": "subtitle", "time": 16028.71, "timestamp": "04:27:08", "text": "そのストリームパッケージセナイの友達"}, {"type": "subtitle", "time": 16031.67, "timestamp": "04:27:11", "text": "日本のストリーマーも"}, {"type": "subtitle", "time": 16032.91, "timestamp": "04:27:12", "text": "モンソン"}, {"type": "subtitle", "time": 16034.67, "timestamp": "04:27:14", "text": "えーと"}, {"type": "subtitle", "time": 16040.429, "timestamp": "04:27:20", "text": "uan と、その他大勢の人たちも"}, {"type": "subtitle", "time": 16044.51, "timestamp": "04:27:24", "text": "それは本当に良い、本当に良い"}]
[{"type": "subtitle", "time": 3181.71, "timestamp": "00:53:01", "text": "私はその興味深いものから来ています"}, {"type": "subtitle", "time": 3185.109, "timestamp": "00:53:05", "text": "ああ、なんて翻訳なんだ"}, {"type": "subtitle", "time": 3188.549, "timestamp": "00:53:08", "text": "ああ、そこには"}, {"type": "subtitle", "time": 3213.589, "timestamp": "00:53:33", "text": "聞くところによると"}, {"type": "subtitle", "time": 3215.91, "timestamp": "00:53:35", "text": "人々は私が聞く"}, {"type": "subtitle", "time": 3222.51, "timestamp": "00:53:42", "text": "よし、一つ。"}, {"type": "subtitle", "time": 3225.47, "timestamp": "00:53:45", "text": "2番目、私のマウスは"}, {"type": "subtitle", "time": 3227.51, "timestamp": "00:53:47", "text": "立ち往生"}, {"type": "subtitle", "time": 3229.67, "timestamp": "00:53:49", "text": "いいえ"}, {"type": "subtitle", "time": 3232.309, "timestamp": "00:53:52", "text": "ちょっと待って、私の"}]
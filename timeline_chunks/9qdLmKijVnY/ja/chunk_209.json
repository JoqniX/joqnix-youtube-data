[{"type": "subtitle", "time": 12542.83, "timestamp": "03:29:02", "text": "今まさにそれを見ることができて本当に素晴らしい"}, {"type": "subtitle", "time": 12544.229, "timestamp": "03:29:04", "text": "私は考える"}, {"type": "subtitle", "time": 12547.07, "timestamp": "03:29:07", "text": "君たちが見ているときはいつも"}, {"type": "subtitle", "time": 12549.55, "timestamp": "03:29:09", "text": "私の配信、まるであなたがじっと見つめているみたい"}, {"type": "subtitle", "time": 12553.03, "timestamp": "03:29:13", "text": "静止している画像で"}, {"type": "subtitle", "time": 12558.63, "timestamp": "03:29:18", "text": "まるで魂を覗き込むように"}, {"type": "subtitle", "time": 12562.269, "timestamp": "03:29:22", "text": "私は、まるで、じっと見つめているような私です。"}, {"type": "subtitle", "time": 12565.11, "timestamp": "03:29:25", "text": "君の魂はそんな感じ"}, {"type": "subtitle", "time": 12571.91, "timestamp": "03:29:31", "text": "M なので"}, {"type": "subtitle", "time": 12574.83, "timestamp": "03:29:34", "text": "うん、PEで実験を始めたんだ"}, {"type": "subtitle", "time": 12579.55, "timestamp": "03:29:39", "text": "またピクピクする、うん、それは本当に良い"}, {"type": "subtitle", "time": 12582.99, "timestamp": "03:29:42", "text": "ああ、こんにちはエリクソン、元気だった？"}, {"type": "subtitle", "time": 12587.15, "timestamp": "03:29:47", "text": "まさに私が言っている通りです。"}, {"type": "subtitle", "time": 12589.87, "timestamp": "03:29:49", "text": "私もそれに気づいてたんだけど、例えば"}, {"type": "subtitle", "time": 12593.99, "timestamp": "03:29:53", "text": "私は言葉に気をつけている、なぜ私は"}, {"type": "subtitle", "time": 12598.59, "timestamp": "03:29:58", "text": "こんな風に私の魂を見つめて、私の"}]
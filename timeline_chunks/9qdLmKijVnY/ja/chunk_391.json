[{"type": "subtitle", "time": 23464.548, "timestamp": "06:31:04", "text": "下忍がうまくやってくれるといいんだけど、とにかく腹が立つ。"}, {"type": "subtitle", "time": 23466.51, "timestamp": "06:31:06", "text": "えーと"}, {"type": "subtitle", "time": 23471.31, "timestamp": "06:31:11", "text": "PUBGをプレイしますか？私はPUBGをプレイします。"}, {"type": "subtitle", "time": 23475.35, "timestamp": "06:31:15", "text": "2キルしたと思う。1回プレイした。"}, {"type": "subtitle", "time": 23478.23, "timestamp": "06:31:18", "text": "でもできない。私はPUBGを定期的にプレイしていない。"}, {"type": "subtitle", "time": 23480.35, "timestamp": "06:31:20", "text": "普段は彼をプレイするけど、"}, {"type": "subtitle", "time": 23481.628, "timestamp": "06:31:21", "text": "ストリームまたは"}, {"type": "subtitle", "time": 23484.59, "timestamp": "06:31:24", "text": "何か、そう、それは待って、VIがプレイした"}, {"type": "subtitle", "time": 23487.67, "timestamp": "06:31:27", "text": "ふぅ、ああ、待って、できるかどうか見てみよう"}, {"type": "subtitle", "time": 23491.91, "timestamp": "06:31:31", "text": "飛ぶこと、もし私が飛ぶことができたら"}, {"type": "subtitle", "time": 23494.51, "timestamp": "06:31:34", "text": "ところで、私のアイコンはどうですか？"}, {"type": "subtitle", "time": 23497.19, "timestamp": "06:31:37", "text": "良いですか、良いですか、私はそうは思いません"}, {"type": "subtitle", "time": 23499.868, "timestamp": "06:31:39", "text": "良いのか悪いのか分からない"}, {"type": "subtitle", "time": 23502.51, "timestamp": "06:31:42", "text": "いいことだとわかっているけど、彼は知らない"}, {"type": "subtitle", "time": 23505.51, "timestamp": "06:31:45", "text": "下忍に切り替えよう、よし、行こう、行こう、行こう"}, {"type": "subtitle", "time": 23508.15, "timestamp": "06:31:48", "text": "見て、私はおそらくこうするつもりです"}, {"type": "subtitle", "time": 23511.23, "timestamp": "06:31:51", "text": "FLで動作するなら、"}]
[{"type": "subtitle", "time": 7807.91, "timestamp": "02:10:07", "text": "好きなだけ戦う"}, {"type": "subtitle", "time": 7819.069, "timestamp": "02:10:19", "text": "このオクタン価がそうでないことを願うべきではないでしょうか"}, {"type": "subtitle", "time": 7822.629, "timestamp": "02:10:22", "text": "私を見つけてください、あなたが私なら彼を殺せます、もしあなたが"}, {"type": "subtitle", "time": 7825.87, "timestamp": "02:10:25", "text": "あなたに知ってほしかったけど、私は受け取らない方がいい"}, {"type": "subtitle", "time": 7848.229, "timestamp": "02:10:48", "text": "ライフラインは、"}, {"type": "subtitle", "time": 7852.189, "timestamp": "02:10:52", "text": "私にとってこれは命綱だ"}, {"type": "subtitle", "time": 7855.35, "timestamp": "02:10:55", "text": "それは私と同じで、男は最善を尽くして"}]
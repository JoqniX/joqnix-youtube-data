[{"type": "subtitle", "time": 19083.03, "timestamp": "05:18:03", "text": "やってください、それは、もしあなたが見逃した場合のために"}, {"type": "subtitle", "time": 19086.27, "timestamp": "05:18:06", "text": "夜11時40分に、騒音が止まります。私は持っている"}, {"type": "subtitle", "time": 19089.15, "timestamp": "05:18:09", "text": "午前9時に学校に行くので、Bのために食事をしています。"}, {"type": "subtitle", "time": 19091.548, "timestamp": "05:18:11", "text": "余分なものからはできません"}, {"type": "subtitle", "time": 19094.39, "timestamp": "05:18:14", "text": "エネルギー、そして、こんにちは"}, {"type": "subtitle", "time": 19096.51, "timestamp": "05:18:16", "text": "ミク、どうですか"}, {"type": "subtitle", "time": 19098.19, "timestamp": "05:18:18", "text": "[音楽]"}, {"type": "subtitle", "time": 19114.628, "timestamp": "05:18:34", "text": "うん、やってるよ"}, {"type": "subtitle", "time": 19119.23, "timestamp": "05:18:39", "text": "えっと、待って、なんでrerがここにお金があるの？"}, {"type": "subtitle", "time": 19127.67, "timestamp": "05:18:47", "text": "えーと、フレーム外から参加するかもしれないけど、"}, {"type": "subtitle", "time": 19130.708, "timestamp": "05:18:50", "text": "知っている 知らない"}, {"type": "subtitle", "time": 19133.15, "timestamp": "05:18:53", "text": "多分"}, {"type": "subtitle", "time": 19137.11, "timestamp": "05:18:57", "text": "たぶん私は少し頭がおかしいので"}, {"type": "subtitle", "time": 19139.43, "timestamp": "05:18:59", "text": "[音楽]"}]
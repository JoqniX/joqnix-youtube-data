[{"type": "subtitle", "time": 4201.07, "timestamp": "01:10:01", "text": "カットした感じがまるで始めたばかりみたいだから、うん"}, {"type": "subtitle", "time": 4223.35, "timestamp": "01:10:23", "text": "[音楽]"}, {"type": "subtitle", "time": 4226.83, "timestamp": "01:10:26", "text": "m 3時間電​​源、今は違う、えっと"}, {"type": "subtitle", "time": 4230.39, "timestamp": "01:10:30", "text": "暑さのせいでここはすごく大変だ"}, {"type": "subtitle", "time": 4234.39, "timestamp": "01:10:34", "text": "今流行っている波に乗って、私はこう思った"}, {"type": "subtitle", "time": 4237.55, "timestamp": "01:10:37", "text": "文字通りたくさん汗をかいているので、"}, {"type": "subtitle", "time": 4239.95, "timestamp": "01:10:39", "text": "停電以来の工事"}, {"type": "subtitle", "time": 4243.149, "timestamp": "01:10:43", "text": "そこにいた、えっと、私たちは送り出さなければならなかった"}, {"type": "subtitle", "time": 4244.27, "timestamp": "01:10:44", "text": "の"}, {"type": "subtitle", "time": 4247.51, "timestamp": "01:10:47", "text": "労働者たち、えっと、私が思うに、"}, {"type": "subtitle", "time": 4249.07, "timestamp": "01:10:49", "text": "溶接作業か何か、よくわからない"}, {"type": "subtitle", "time": 4250.99, "timestamp": "01:10:50", "text": "いくつか違うものがある"}, {"type": "subtitle", "time": 4253.43, "timestamp": "01:10:53", "text": "パーティーが行き来する"}, {"type": "subtitle", "time": 4255.91, "timestamp": "01:10:55", "text": "建設資材"}, {"type": "subtitle", "time": 4259.35, "timestamp": "01:10:59", "text": "ええ、ええ、私は見ていました"}]
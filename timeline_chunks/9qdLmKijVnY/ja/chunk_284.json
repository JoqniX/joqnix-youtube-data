[{"type": "subtitle", "time": 17042.23, "timestamp": "04:44:02", "text": "次は"}, {"type": "subtitle", "time": 17047.31, "timestamp": "04:44:07", "text": "えっと、カリオプ・モリ、カリオプ・モリとしましょう"}, {"type": "subtitle", "time": 17049.948, "timestamp": "04:44:09", "text": "缶は一般的な名前になるだろう"}, {"type": "subtitle", "time": 17053.07, "timestamp": "04:44:13", "text": "人々はモリーの権利を持っているが、"}, {"type": "subtitle", "time": 17057.47, "timestamp": "04:44:17", "text": "モル・カロップには権利はありません。"}, {"type": "subtitle", "time": 17060.47, "timestamp": "04:44:20", "text": "モル・カロップに電話する、それは単なるリマインダーです"}, {"type": "subtitle", "time": 17069.83, "timestamp": "04:44:29", "text": "それを使うことは良いことだ"}, {"type": "subtitle", "time": 17072.788, "timestamp": "04:44:32", "text": "名前と"}, {"type": "subtitle", "time": 17076.55, "timestamp": "04:44:36", "text": "あと、えっと、なんて呼ぶんですか？"}, {"type": "subtitle", "time": 17080.27, "timestamp": "04:44:40", "text": "旅では、"}, {"type": "subtitle", "time": 17083.43, "timestamp": "04:44:43", "text": "えーっと、それで、"}, {"type": "subtitle", "time": 17086.868, "timestamp": "04:44:46", "text": "えっと、それを何て呼ぶんだっけ？"}, {"type": "subtitle", "time": 17090.55, "timestamp": "04:44:50", "text": "誰かがあなたのことを尋ねたら、彼らは"}, {"type": "subtitle", "time": 17094.788, "timestamp": "04:44:54", "text": "すぐにアイデアを思いつかなければならない"}, {"type": "subtitle", "time": 17096.55, "timestamp": "04:44:56", "text": "彼らはこれについて話しています"}, {"type": "subtitle", "time": 17098.83, "timestamp": "04:44:58", "text": "これについて話す"}]
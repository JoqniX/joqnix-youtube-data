[{"type": "subtitle", "time": 10863.87, "timestamp": "03:01:03", "text": "考えてみてください、ええ、少なくとも私は"}, {"type": "subtitle", "time": 10867.71, "timestamp": "03:01:07", "text": "それほどではないことを保証してください"}, {"type": "subtitle", "time": 10878.87, "timestamp": "03:01:18", "text": "みんな、でも私はあまりそうならないようにするよ"}, {"type": "subtitle", "time": 10881.55, "timestamp": "03:01:21", "text": "今日は感情的だ"}, {"type": "subtitle", "time": 10885.91, "timestamp": "03:01:25", "text": "でも、えっと、神様、えっと、私の声がそれを"}, {"type": "subtitle", "time": 10900.229, "timestamp": "03:01:40", "text": "待って、わかった、私は"}, {"type": "subtitle", "time": 10902.309, "timestamp": "03:01:42", "text": "後ろに戻って"}, {"type": "subtitle", "time": 10906.349, "timestamp": "03:01:46", "text": "えっと、少し書いたけど、まだ完全には完成していない"}, {"type": "subtitle", "time": 10908.59, "timestamp": "03:01:48", "text": "それをする"}, {"type": "subtitle", "time": 10910.469, "timestamp": "03:01:50", "text": "えっと"}, {"type": "subtitle", "time": 10914.79, "timestamp": "03:01:54", "text": "ええ、では読み上げますね。えっと、こんにちは。"}]
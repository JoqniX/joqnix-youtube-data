[{"type": "subtitle", "time": 11041.63, "timestamp": "03:04:01", "text": "待って、えっと、それで私は"}, {"type": "subtitle", "time": 11046.67, "timestamp": "03:04:06", "text": "まず、"}, {"type": "subtitle", "time": 11049.19, "timestamp": "03:04:09", "text": "謝罪"}, {"type": "subtitle", "time": 11052.99, "timestamp": "03:04:12", "text": "星座とのコミュニケーションがうまくいっていない"}, {"type": "subtitle", "time": 11055.309, "timestamp": "03:04:15", "text": "コンチネンタルプレート"}, {"type": "subtitle", "time": 11058.269, "timestamp": "03:04:18", "text": "コミュニティで私が"}, {"type": "subtitle", "time": 11068.11, "timestamp": "03:04:28", "text": "嫌いな人は、"}, {"type": "subtitle", "time": 11072.99, "timestamp": "03:04:32", "text": "曖昧なメッセージで、えーっと"}, {"type": "subtitle", "time": 11079.99, "timestamp": "03:04:39", "text": "多く"}]
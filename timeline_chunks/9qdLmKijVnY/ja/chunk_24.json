[{"type": "subtitle", "time": 1465.789, "timestamp": "00:24:25", "text": "行く なぜそれはなぜいつもから始まるのか"}, {"type": "subtitle", "time": 1468.22, "timestamp": "00:24:28", "text": "新しい"}, {"type": "subtitle", "time": 1470.909, "timestamp": "00:24:30", "text": "[音楽]"}, {"type": "subtitle", "time": 1473.63, "timestamp": "00:24:33", "text": "私は楽しんでいます、戻ってきます、私が何をしているか"}, {"type": "subtitle", "time": 1477.11, "timestamp": "00:24:37", "text": "息子が挨拶をしている"}, {"type": "subtitle", "time": 1481.63, "timestamp": "00:24:41", "text": "ようこそ、えっと、すぐ戻ります、えっと、何"}, {"type": "subtitle", "time": 1483.029, "timestamp": "00:24:43", "text": "チャネル"}, {"type": "subtitle", "time": 1485.789, "timestamp": "00:24:45", "text": "何が正しくて何も間違っていないといいな"}, {"type": "subtitle", "time": 1487.389, "timestamp": "00:24:47", "text": "その"}, {"type": "subtitle", "time": 1491.95, "timestamp": "00:24:51", "text": "まあ、とにかく、昨日はみんなどうだった？"}, {"type": "subtitle", "time": 1495.75, "timestamp": "00:24:55", "text": "私たちは、えっと、何をプレイしたか忘れちゃったんだけど"}, {"type": "subtitle", "time": 1497.63, "timestamp": "00:24:57", "text": "私がプレイしたゲームの名前は"}, {"type": "subtitle", "time": 1499.909, "timestamp": "00:24:59", "text": "昨日"}]
[{"type": "subtitle", "time": 3964.349, "timestamp": "01:06:04", "text": "B 私は今作っています"}, {"type": "subtitle", "time": 3968.789, "timestamp": "01:06:08", "text": "言い訳だけど、ある意味、私は"}, {"type": "subtitle", "time": 3971.75, "timestamp": "01:06:11", "text": "キーボードを修理するか、新しいのを買ってください。"}, {"type": "subtitle", "time": 3982.99, "timestamp": "01:06:22", "text": "じゃあ、そう、私は何かをします"}, {"type": "subtitle", "time": 3996.269, "timestamp": "01:06:36", "text": "次に"}, {"type": "subtitle", "time": 4000.069, "timestamp": "01:06:40", "text": "ゲームプレイは楽しいですが、"}, {"type": "subtitle", "time": 4001.269, "timestamp": "01:06:41", "text": "慣れる"}, {"type": "subtitle", "time": 4004.47, "timestamp": "01:06:44", "text": "そして私は長い間Apexをプレイしていません"}, {"type": "subtitle", "time": 4008.43, "timestamp": "01:06:48", "text": "そう、私はApexをプレイしたけど、それは"}, {"type": "subtitle", "time": 4010.75, "timestamp": "01:06:50", "text": "むしろ隠れて頂点を目指すようなものだ"}, {"type": "subtitle", "time": 4013.589, "timestamp": "01:06:53", "text": "10位、最下位、または上位3位のような順位"}, {"type": "subtitle", "time": 4016.23, "timestamp": "01:06:56", "text": "あるいは何か、そしてこれが死ぬか何か"}, {"type": "subtitle", "time": 4018.99, "timestamp": "01:06:58", "text": "チャレンジを終わらせるだけですが、"}]
[{"type": "subtitle", "time": 369.55, "timestamp": "00:06:09", "text": "もう1ヶ月経ったよね。"}, {"type": "subtitle", "time": 373.11, "timestamp": "00:06:13", "text": "これは、米国が今日でちょうど20日を迎えることを意味します"}, {"type": "subtitle", "time": 376.99, "timestamp": "00:06:16", "text": "20日目になります"}, {"type": "subtitle", "time": 379.07, "timestamp": "00:06:19", "text": "おお"}, {"type": "subtitle", "time": 383.029, "timestamp": "00:06:23", "text": "明日は"}, {"type": "subtitle", "time": 388.07, "timestamp": "00:06:28", "text": "4月1日、4月1日"}, {"type": "subtitle", "time": 390.39, "timestamp": "00:06:30", "text": "4月"}, {"type": "subtitle", "time": 392.35, "timestamp": "00:06:32", "text": "これも"}, {"type": "subtitle", "time": 394.79, "timestamp": "00:06:34", "text": "21日"}, {"type": "subtitle", "time": 399.07, "timestamp": "00:06:39", "text": "[ __ ]、ジャトンの初期段階は"}, {"type": "subtitle", "time": 401.589, "timestamp": "00:06:41", "text": "おそらく"}, {"type": "subtitle", "time": 405.55, "timestamp": "00:06:45", "text": "結論が出た、ああ神様4月"}, {"type": "subtitle", "time": 409.30899999999997, "timestamp": "00:06:49", "text": "前進するために、私たちは変える必要があります"}, {"type": "subtitle", "time": 411.79, "timestamp": "00:06:51", "text": "目標が達成されていないため、戦術は"}, {"type": "subtitle", "time": 414.189, "timestamp": "00:06:54", "text": "到達した"}, {"type": "subtitle", "time": 416.189, "timestamp": "00:06:56", "text": "そして月"}]
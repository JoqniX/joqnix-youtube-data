[{"type": "subtitle", "time": 9964.71, "timestamp": "02:46:04", "text": "それで私が理解したことは"}, {"type": "subtitle", "time": 9969.15, "timestamp": "02:46:09", "text": "完全に殺す方法を学ぶ必要がある"}, {"type": "subtitle", "time": 9979.07, "timestamp": "02:46:19", "text": "敵を完全に倒す方法を学ぶ必要がある"}, {"type": "subtitle", "time": 9984.63, "timestamp": "02:46:24", "text": "私は殺すことができないから"}, {"type": "subtitle", "time": 9987.72, "timestamp": "02:46:27", "text": "時々、実際に誰かがこれを略奪した"}, {"type": "subtitle", "time": 10008.07, "timestamp": "02:46:48", "text": "オーケー、私のインスタグラムライブは"}]
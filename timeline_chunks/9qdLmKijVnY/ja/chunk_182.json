[{"type": "subtitle", "time": 10923.87, "timestamp": "03:02:03", "text": "うん"}, {"type": "subtitle", "time": 10927.07, "timestamp": "03:02:07", "text": "彼も水分補給を忘れないでください"}, {"type": "subtitle", "time": 10935.79, "timestamp": "03:02:15", "text": "うん、なんで読み上げるのがこんなに難しいんだろう"}, {"type": "subtitle", "time": 10940.91, "timestamp": "03:02:20", "text": "ああ、でも皆さんが楽しんでくれたことを願っています。"}, {"type": "subtitle", "time": 10945.15, "timestamp": "03:02:25", "text": "IND ディレクトリ メッセージ 私は"}, {"type": "subtitle", "time": 10951.63, "timestamp": "03:02:31", "text": "伝える、ええ、それは主に"}, {"type": "subtitle", "time": 10956.59, "timestamp": "03:02:36", "text": "言いたかったことは全部言ったので、ええ、ええ"}, {"type": "subtitle", "time": 10959.349, "timestamp": "03:02:39", "text": "なので、それをビデオとして投稿します"}, {"type": "subtitle", "time": 10961.87, "timestamp": "03:02:41", "text": "初めての動画みたいになる"}, {"type": "subtitle", "time": 10967.469, "timestamp": "03:02:47", "text": "私のチャンネルに投稿します。それで、そうします。"}, {"type": "subtitle", "time": 10969.95, "timestamp": "03:02:49", "text": "その言葉は"}, {"type": "subtitle", "time": 10971.51, "timestamp": "03:02:51", "text": "それ"}]
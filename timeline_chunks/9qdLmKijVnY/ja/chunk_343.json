[{"type": "subtitle", "time": 20581.43, "timestamp": "05:43:01", "text": "チャットも理解できます"}, {"type": "subtitle", "time": 20585.868, "timestamp": "05:43:05", "text": "しかし、あるいは人々は"}, {"type": "subtitle", "time": 20587.788, "timestamp": "05:43:07", "text": "理解する"}, {"type": "subtitle", "time": 20591.39, "timestamp": "05:43:11", "text": "ええ、人々はもし彼らが"}, {"type": "subtitle", "time": 20595.67, "timestamp": "05:43:15", "text": "理解できない"}, {"type": "subtitle", "time": 20598.83, "timestamp": "05:43:18", "text": "言語は、H のようになるでしょう"}, {"type": "subtitle", "time": 20601.23, "timestamp": "05:43:21", "text": "彼は何を言っているのか、何が"}, {"type": "subtitle", "time": 20603.99, "timestamp": "05:43:23", "text": "彼らは、このCループのようになるだろうと言っています。"}, {"type": "subtitle", "time": 20605.708, "timestamp": "05:43:25", "text": "の"}, {"type": "subtitle", "time": 20609.19, "timestamp": "05:43:29", "text": "好奇心から、Googleで検索しない限り"}, {"type": "subtitle", "time": 20614.03, "timestamp": "05:43:34", "text": "翻訳して、自分自身を翻訳する"}, {"type": "subtitle", "time": 20617.59, "timestamp": "05:43:37", "text": "そういう感じなので、それを維持しようとします"}, {"type": "subtitle", "time": 20621.11, "timestamp": "05:43:41", "text": "英語と最も重要なものの1つ"}, {"type": "subtitle", "time": 20623.83, "timestamp": "05:43:43", "text": "私が最後に保持した役割"}, {"type": "subtitle", "time": 20629.23, "timestamp": "05:43:49", "text": "1つ目は、カワイイことを忘れないで、"}]
[{"type": "subtitle", "time": 19265.3, "timestamp": "05:21:05", "text": "ここでは、与えたくないものはありません。"}, {"type": "subtitle", "time": 19281.628, "timestamp": "05:21:21", "text": "スイッチトーク"}, {"type": "subtitle", "time": 19290.628, "timestamp": "05:21:30", "text": "それでは最後に少しお話しましょう"}, {"type": "subtitle", "time": 19293.07, "timestamp": "05:21:33", "text": "通常私が"}, {"type": "subtitle", "time": 19296.27, "timestamp": "05:21:36", "text": "えっと、私はこの新しいパターンに従いたいのですが"}, {"type": "subtitle", "time": 19300.23, "timestamp": "05:21:40", "text": "私のストリームは新しいパターンのようですが、"}, {"type": "subtitle", "time": 19303.83, "timestamp": "05:21:43", "text": "えーと、これは影響しないということですか？"}, {"type": "subtitle", "time": 19307.67, "timestamp": "05:21:47", "text": "これはコラボレーションには影響しません"}, {"type": "subtitle", "time": 19312.19, "timestamp": "05:21:52", "text": "ストリームですが、新しいパターンは、えっと"}, {"type": "subtitle", "time": 19314.59, "timestamp": "05:21:54", "text": "ゲーム配信を始める前に"}, {"type": "subtitle", "time": 19317.708, "timestamp": "05:21:57", "text": "少し話して、こんにちはとか言う"}]
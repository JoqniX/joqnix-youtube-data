[{"type": "subtitle", "time": 22920.43, "timestamp": "06:22:00", "text": "旅で出会う人々"}, {"type": "subtitle", "time": 22923.11, "timestamp": "06:22:03", "text": "私たちがプレイするゲームには3種類あります。彼は"}, {"type": "subtitle", "time": 22925.31, "timestamp": "06:22:05", "text": "いい感じのホット"}, {"type": "subtitle", "time": 22928.948, "timestamp": "06:22:08", "text": "FP うんうん、私たちが話したあの日"}, {"type": "subtitle", "time": 22932.19, "timestamp": "06:22:12", "text": "初めてRPGゲームのようなインプI"}, {"type": "subtitle", "time": 22935.43, "timestamp": "06:22:15", "text": "彼には大きな敬意を抱いていました"}, {"type": "subtitle", "time": 22938.59, "timestamp": "06:22:18", "text": "私は今でもとても尊敬しています"}, {"type": "subtitle", "time": 22942.07, "timestamp": "06:22:22", "text": "とてもクールなDで、話すのがとても楽しかったです"}, {"type": "subtitle", "time": 22945.07, "timestamp": "06:22:25", "text": "私たちが話すときはいつでも"}, {"type": "subtitle", "time": 22947.59, "timestamp": "06:22:27", "text": "私たちは何時間も話して"}, {"type": "subtitle", "time": 22950.43, "timestamp": "06:22:30", "text": "実際、私はとても緊張していたので、"}, {"type": "subtitle", "time": 22952.39, "timestamp": "06:22:32", "text": "会議に出席する予定だった"}, {"type": "subtitle", "time": 22955.03, "timestamp": "06:22:35", "text": "コラボレーションには1時間30分かかりますが"}, {"type": "subtitle", "time": 22957.948, "timestamp": "06:22:37", "text": "私たちは3時間か2時間話し続けた"}, {"type": "subtitle", "time": 22962.03, "timestamp": "06:22:42", "text": "時間、うん、とても楽しい人"}, {"type": "subtitle", "time": 22962.91, "timestamp": "06:22:42", "text": "下がる"}, {"type": "subtitle", "time": 22965.43, "timestamp": "06:22:45", "text": "外"}, {"type": "subtitle", "time": 22968.03, "timestamp": "06:22:48", "text": "遅くまで、とても楽しい"}, {"type": "subtitle", "time": 22971.788, "timestamp": "06:22:51", "text": "今週、男がHゲームをプレイする"}, {"type": "subtitle", "time": 22974.628, "timestamp": "06:22:54", "text": "金曜日、そう、金曜日から水曜日、そう"}, {"type": "subtitle", "time": 22975.99, "timestamp": "06:22:55", "text": "金曜日は"}, {"type": "subtitle", "time": 22979.27, "timestamp": "06:22:59", "text": "えーっと、VIをやっているのは、Hゲームをしているところです。"}]
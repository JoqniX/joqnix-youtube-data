[{"type": "subtitle", "time": 5940.629, "timestamp": "01:39:00", "text": "選択肢はあったが、パンチすることができた"}, {"type": "subtitle", "time": 5943.79, "timestamp": "01:39:03", "text": "彼が私を殺す前に彼を蹴飛ばす"}, {"type": "subtitle", "time": 5945.43, "timestamp": "01:39:05", "text": "それは"}, {"type": "subtitle", "time": 5950.109, "timestamp": "01:39:10", "text": "よかった、少なくとも私は小さなshをあげた"}, {"type": "subtitle", "time": 5951.95, "timestamp": "01:39:11", "text": "ボングまたは"}, {"type": "subtitle", "time": 5954.589, "timestamp": "01:39:14", "text": "少しパンチ"}, {"type": "subtitle", "time": 5958.91, "timestamp": "01:39:18", "text": "ちょっとやって、そうだねバカベッド君"}, {"type": "subtitle", "time": 5960.83, "timestamp": "01:39:20", "text": "あなたは私を殺そうとした、人を殺そうとした"}, {"type": "subtitle", "time": 5979.83, "timestamp": "01:39:39", "text": "うん、インスタグラムがまだ使えるといいな"}, {"type": "subtitle", "time": 5983.03, "timestamp": "01:39:43", "text": "今度はまた接続が切れないことを願います"}]
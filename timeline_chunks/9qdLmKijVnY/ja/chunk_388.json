[{"type": "subtitle", "time": 23283.59, "timestamp": "06:28:03", "text": "かわいいからとても難しいです"}, {"type": "subtitle", "time": 23285.99, "timestamp": "06:28:05", "text": "かわいいのはいいこと、いいこと、電話しないで"}, {"type": "subtitle", "time": 23290.07, "timestamp": "06:28:10", "text": "暑いと、私はこのようなアレルギーを発症します"}, {"type": "subtitle", "time": 23291.83, "timestamp": "06:28:11", "text": "こんなアレルギーがあるなら、"}, {"type": "subtitle", "time": 23293.31, "timestamp": "06:28:13", "text": "言わないで"}, {"type": "subtitle", "time": 23296.628, "timestamp": "06:28:16", "text": "だから彼女は私にこの手紙をくれたのです"}, {"type": "subtitle", "time": 23307.07, "timestamp": "06:28:27", "text": "私はその場所を知っています、はい、それは"}, {"type": "subtitle", "time": 23311.03, "timestamp": "06:28:31", "text": "myar はい、私は自分が何者なのかを知っています。"}, {"type": "subtitle", "time": 23312.27, "timestamp": "06:28:32", "text": "彼らの言語を話すなんて考えたこともなかった"}, {"type": "subtitle", "time": 23317.43, "timestamp": "06:28:37", "text": "私は"}, {"type": "subtitle", "time": 23324.91, "timestamp": "06:28:44", "text": "若い、ああそれはそれは"}, {"type": "subtitle", "time": 23329.708, "timestamp": "06:28:49", "text": "国、わかった、わかった、私は幸せ"}, {"type": "subtitle", "time": 23334.19, "timestamp": "06:28:54", "text": "なぜなら私の画面は難しいからです"}, {"type": "subtitle", "time": 23339.31, "timestamp": "06:28:59", "text": "燃えるハイハイ行く"}]
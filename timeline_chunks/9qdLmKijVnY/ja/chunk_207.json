[{"type": "subtitle", "time": 12424.229, "timestamp": "03:27:04", "text": "彼女から表情を引き出すには、しかし"}, {"type": "subtitle", "time": 12428.229, "timestamp": "03:27:08", "text": "遅かれ早かれそうなるだろう"}, {"type": "subtitle", "time": 12434.99, "timestamp": "03:27:14", "text": "えっと、いつ始めるかはわかりません"}, {"type": "subtitle", "time": 12437.71, "timestamp": "03:27:17", "text": "プロのように描く必要はありません"}, {"type": "subtitle", "time": 12440.95, "timestamp": "03:27:20", "text": "プロのように絵を描き始めよう"}, {"type": "subtitle", "time": 12443.67, "timestamp": "03:27:23", "text": "実験実験と"}, {"type": "subtitle", "time": 12447.309, "timestamp": "03:27:27", "text": "実験すれば、正しいことが学べる"}, {"type": "subtitle", "time": 12448.87, "timestamp": "03:27:28", "text": "そういうことなんです"}, {"type": "subtitle", "time": 12451.75, "timestamp": "03:27:31", "text": "学習を始めたらすぐに"}, {"type": "subtitle", "time": 12455.87, "timestamp": "03:27:35", "text": "ソフトウェアプログラムには時間がかかります"}, {"type": "subtitle", "time": 12457.67, "timestamp": "03:27:37", "text": "取ります"}, {"type": "subtitle", "time": 12461.03, "timestamp": "03:27:41", "text": "急いでも時間も"}, {"type": "subtitle", "time": 12465.229, "timestamp": "03:27:45", "text": "あまり進めないだろう"}, {"type": "subtitle", "time": 12468.59, "timestamp": "03:27:48", "text": "さらに、それは私に起こったことです"}, {"type": "subtitle", "time": 12470.63, "timestamp": "03:27:50", "text": "Rも急いでいる"}, {"type": "subtitle", "time": 12474.429, "timestamp": "03:27:54", "text": "私にはできなかった"}, {"type": "subtitle", "time": 12477.309, "timestamp": "03:27:57", "text": "えーっと、うん、"}]
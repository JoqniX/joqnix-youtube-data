[{"type": "subtitle", "time": 22982.15, "timestamp": "06:23:02", "text": "やるために、そして私は彼を見守るつもりです"}, {"type": "subtitle", "time": 22985.75, "timestamp": "06:23:05", "text": "みんな、Fe f というゲームを知ってるよね"}, {"type": "subtitle", "time": 22987.99, "timestamp": "06:23:07", "text": "それは、こういう人に会ってみたいという気持ちに近い。"}, {"type": "subtitle", "time": 22991.03, "timestamp": "06:23:11", "text": "私の未来の人々、そうそう、あなた"}, {"type": "subtitle", "time": 22995.75, "timestamp": "06:23:15", "text": "誰に会うことになるか分からない"}, {"type": "subtitle", "time": 22998.51, "timestamp": "06:23:18", "text": "いつもあなたが元気でいることを願っています。"}, {"type": "subtitle", "time": 23001.35, "timestamp": "06:23:21", "text": "いつも最善を尽くしてください、私にとっては良いことです"}, {"type": "subtitle", "time": 23003.67, "timestamp": "06:23:23", "text": "人々 新しい人々 人々 あなたたちは本当に"}, {"type": "subtitle", "time": 23005.868, "timestamp": "06:23:25", "text": "幽霊ゲームに、あ、ごめん、君たちは"}, {"type": "subtitle", "time": 23007.468, "timestamp": "06:23:27", "text": "ホラーゲームにすごく興味があるんだけど"}, {"type": "subtitle", "time": 23009.468, "timestamp": "06:23:29", "text": "何か提案があれば教えてください"}, {"type": "subtitle", "time": 23012.07, "timestamp": "06:23:32", "text": "コメントで教えてください。"}, {"type": "subtitle", "time": 23014.628, "timestamp": "06:23:34", "text": "チャット 私は絶対にプレイします"}, {"type": "subtitle", "time": 23017.67, "timestamp": "06:23:37", "text": "買って、彼を遊ばせて、待って、私は遅れているの？"}, {"type": "subtitle", "time": 23021.75, "timestamp": "06:23:41", "text": "ええ、ここにはたくさんの新しい人がいます"}, {"type": "subtitle", "time": 23023.83, "timestamp": "06:23:43", "text": "戻ってきて、私はとても"}, {"type": "subtitle", "time": 23027.15, "timestamp": "06:23:47", "text": "幸せだし、これから良くなるよ"}, {"type": "subtitle", "time": 23029.75, "timestamp": "06:23:49", "text": "彼にとっても良いことだ。なぜなら彼は今良いものを持っているからだ。"}, {"type": "subtitle", "time": 23032.83, "timestamp": "06:23:52", "text": "より優れたモデルとより高品質なストリーム"}, {"type": "subtitle", "time": 23035.948, "timestamp": "06:23:55", "text": "資産やその他"}]
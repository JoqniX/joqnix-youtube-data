[{"type": "subtitle", "time": 19561.548, "timestamp": "05:26:01", "text": "それで、その配信のスクリーンショットを撮りました。"}, {"type": "subtitle", "time": 19565.35, "timestamp": "05:26:05", "text": "分析とそうですね、イベントに関しては"}, {"type": "subtitle", "time": 19569.31, "timestamp": "05:26:09", "text": "えーっと、もし私が、えーっと、もし私が、何を"}, {"type": "subtitle", "time": 19570.19, "timestamp": "05:26:10", "text": "あなたが電話する"}, {"type": "subtitle", "time": 19573.628, "timestamp": "05:26:13", "text": "もし私がフォロワー100人を獲得したら、"}, {"type": "subtitle", "time": 19576.35, "timestamp": "05:26:16", "text": "そんな感じでプライム会員になるよ"}, {"type": "subtitle", "time": 19580.708, "timestamp": "05:26:20", "text": "もっと宝石が欲しいのですが、いくらだったでしょうか？"}, {"type": "subtitle", "time": 19582.868, "timestamp": "05:26:22", "text": "また"}, {"type": "subtitle", "time": 19587.23, "timestamp": "05:26:27", "text": "500人、そう、新しいフォロワーが100人増えるだろう"}, {"type": "subtitle", "time": 19589.868, "timestamp": "05:26:29", "text": "プリモジェム500個と新規フォロワー300人"}, {"type": "subtitle", "time": 19592.15, "timestamp": "05:26:32", "text": "000個のPrimoジェムと"}, {"type": "subtitle", "time": 19596.27, "timestamp": "05:26:36", "text": "600は1,500になるので、"}, {"type": "subtitle", "time": 19600.27, "timestamp": "05:26:40", "text": "私が配信する各下忍配信のスクリーンショット"}, {"type": "subtitle", "time": 19604.11, "timestamp": "05:26:44", "text": "それから、えーと、最後に、えーと、最後に"}, {"type": "subtitle", "time": 19608.75, "timestamp": "05:26:48", "text": "9月に開催されるイベントのようなもの"}, {"type": "subtitle", "time": 19611.59, "timestamp": "05:26:51", "text": "21日、参加者全員が"}, {"type": "subtitle", "time": 19615.628, "timestamp": "05:26:55", "text": "Googleフォームへのリンクが与えられ、"}, {"type": "subtitle", "time": 19619.15, "timestamp": "05:26:59", "text": "ゲンジンを一つ一つアップロードしなければならない"}]
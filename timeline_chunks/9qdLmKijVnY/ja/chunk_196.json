[{"type": "subtitle", "time": 11763.75, "timestamp": "03:16:03", "text": "えーと、そう、私はそれを"}, {"type": "subtitle", "time": 11765.63, "timestamp": "03:16:05", "text": "感傷的なこと"}, {"type": "subtitle", "time": 11771.03, "timestamp": "03:16:11", "text": "えっと、うん、このスタイルをリハーサルしたよ"}, {"type": "subtitle", "time": 11774.309, "timestamp": "03:16:14", "text": "何度もリハーサルしたんだけど、"}, {"type": "subtitle", "time": 11780.189, "timestamp": "03:16:20", "text": "失敗した"}, {"type": "subtitle", "time": 11793.349, "timestamp": "03:16:33", "text": "はい、こんにちは"}, {"type": "subtitle", "time": 11798.67, "timestamp": "03:16:38", "text": "えっと、こんにちは、最後に"}, {"type": "subtitle", "time": 11801.71, "timestamp": "03:16:41", "text": "最後にポジティブな言葉で締めくくりたいと思います"}, {"type": "subtitle", "time": 11806.99, "timestamp": "03:16:46", "text": "はい、そのビデオを投稿します。"}, {"type": "subtitle", "time": 11809.229, "timestamp": "03:16:49", "text": "聞いてみて、もし知ってるなら"}, {"type": "subtitle", "time": 11811.55, "timestamp": "03:16:51", "text": "気付いたかどうかわかりませんが、あれは私でした"}, {"type": "subtitle", "time": 11814.189, "timestamp": "03:16:54", "text": "背景の口笛は、ほら、"}, {"type": "subtitle", "time": 11816.11, "timestamp": "03:16:56", "text": "どれだけ好きか"}]
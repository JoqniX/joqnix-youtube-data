[{"type": "subtitle", "time": 22323.628, "timestamp": "06:12:03", "text": "ありがとう、だから少し"}, {"type": "subtitle", "time": 22325.31, "timestamp": "06:12:05", "text": "ほろ酔い"}, {"type": "subtitle", "time": 22328.15, "timestamp": "06:12:08", "text": "えっと、なんて言うんだっけ？えっと、下忍じゃないよ"}, {"type": "subtitle", "time": 22331.788, "timestamp": "06:12:11", "text": "ゲニンはすぐに大きくなる"}, {"type": "subtitle", "time": 22334.11, "timestamp": "06:12:14", "text": "終わる 私は彼を待っているようなものだ"}, {"type": "subtitle", "time": 22336.548, "timestamp": "06:12:16", "text": "準備作業をしなかったため、このためにこれを行った。"}, {"type": "subtitle", "time": 22337.548, "timestamp": "06:12:17", "text": "のために"}, {"type": "subtitle", "time": 22339.51, "timestamp": "06:12:19", "text": "ストリーム 私はしたくない 私はしたくなかった"}, {"type": "subtitle", "time": 22341.51, "timestamp": "06:12:21", "text": "邪魔をして彼を外に出させる"}, {"type": "subtitle", "time": 22344.39, "timestamp": "06:12:24", "text": "彼のWストリームから今あなたは"}, {"type": "subtitle", "time": 22347.07, "timestamp": "06:12:27", "text": "私も吸血鬼です。私も吸血鬼ですよね。"}, {"type": "subtitle", "time": 22352.23, "timestamp": "06:12:32", "text": "彼抜きで遺伝子操作を始めたら失礼だ"}, {"type": "subtitle", "time": 22355.948, "timestamp": "06:12:35", "text": "だから私は"}, {"type": "subtitle", "time": 22360.03, "timestamp": "06:12:40", "text": "見て、見て、うん、そうだね"}, {"type": "subtitle", "time": 22363.628, "timestamp": "06:12:43", "text": "それが私です。私は決して始められません。はい、希望"}, {"type": "subtitle", "time": 22366.708, "timestamp": "06:12:46", "text": "あなたは彼を待っていたのを見たが、私は"}, {"type": "subtitle", "time": 22369.15, "timestamp": "06:12:49", "text": "そんなことは失礼だ、ちょっと待ってくれ"}, {"type": "subtitle", "time": 22372.43, "timestamp": "06:12:52", "text": "みんなスカッフ・ネイション、ああ神様、それは"}, {"type": "subtitle", "time": 22375.83, "timestamp": "06:12:55", "text": "私たちが"}, {"type": "subtitle", "time": 22378.99, "timestamp": "06:12:58", "text": "だから私たちは、私はより大きい"}]
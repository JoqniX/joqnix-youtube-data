[{"type": "subtitle", "time": 18121.948, "timestamp": "05:02:01", "text": "バグを見つけて悪用したりとか"}, {"type": "subtitle", "time": 18157.91, "timestamp": "05:02:37", "text": "声が大きすぎる場合は教えてください。"}, {"type": "subtitle", "time": 18161.67, "timestamp": "05:02:41", "text": "何か、なぜなら私は私も私の"}, {"type": "subtitle", "time": 18165.99, "timestamp": "05:02:45", "text": "マイクは音声が良くないと思う"}, {"type": "subtitle", "time": 18167.99, "timestamp": "05:02:47", "text": "良いことだが"}, {"type": "subtitle", "time": 18170.43, "timestamp": "05:02:50", "text": "マイクは良いマイクだけど、私は下手だ"}, {"type": "subtitle", "time": 18172.708, "timestamp": "05:02:52", "text": "マイクを後処理する際に"}, {"type": "subtitle", "time": 18174.39, "timestamp": "05:02:54", "text": "そして"}]
[{"type": "subtitle", "time": 2163.63, "timestamp": "00:36:03", "text": "ちょっと待って、Apexを起動させて"}, {"type": "subtitle", "time": 2165.27, "timestamp": "00:36:05", "text": "伝説"}, {"type": "subtitle", "time": 2173.99, "timestamp": "00:36:13", "text": "[音楽]"}, {"type": "subtitle", "time": 2176.79, "timestamp": "00:36:16", "text": "アップアオッチ"}, {"type": "subtitle", "time": 2180.55, "timestamp": "00:36:20", "text": "えっと、みんな元気ですか？"}, {"type": "subtitle", "time": 2183.51, "timestamp": "00:36:23", "text": "留守中だったけど、元気だった？"}, {"type": "subtitle", "time": 2191.39, "timestamp": "00:36:31", "text": "これを調整する必要がある"}, {"type": "subtitle", "time": 2195.589, "timestamp": "00:36:35", "text": "えーと、それでいいはずです。"}, {"type": "subtitle", "time": 2198.51, "timestamp": "00:36:38", "text": "丸いものが良さそうだと思う"}, {"type": "subtitle", "time": 2201.95, "timestamp": "00:36:41", "text": "まあ、悪くないね"}, {"type": "subtitle", "time": 2203.75, "timestamp": "00:36:43", "text": "右"}, {"type": "subtitle", "time": 2209.51, "timestamp": "00:36:49", "text": "こんにちは、ビリービリーがいるのを忘れていました。"}, {"type": "subtitle", "time": 2218.63, "timestamp": "00:36:58", "text": "行くm"}]
[{"type": "subtitle", "time": 10800.71, "timestamp": "03:00:00", "text": "今日の配信のリハーサルをいくつか"}, {"type": "subtitle", "time": 10803.03, "timestamp": "03:00:03", "text": "タイムズ"}, {"type": "subtitle", "time": 10806.95, "timestamp": "03:00:06", "text": "えっと、私の心の中では、そしてあなたの声のように"}, {"type": "subtitle", "time": 10829.63, "timestamp": "03:00:29", "text": "はい、ええ、私は"}, {"type": "subtitle", "time": 10834.429, "timestamp": "03:00:34", "text": "戻って、えっと、私は書きました"}, {"type": "subtitle", "time": 10839.19, "timestamp": "03:00:39", "text": "たくさんの、えーと、声明とか何か"}, {"type": "subtitle", "time": 10841.269, "timestamp": "03:00:41", "text": "私はしません"}, {"type": "subtitle", "time": 10848.55, "timestamp": "03:00:48", "text": "知ってるよ、だって、私はできる、できない、私は"}, {"type": "subtitle", "time": 10851.269, "timestamp": "03:00:51", "text": "声に出して言えないのは、"}, {"type": "subtitle", "time": 10853.469, "timestamp": "03:00:53", "text": "たくさんの感情を感じる"}, {"type": "subtitle", "time": 10857.229, "timestamp": "03:00:57", "text": "今日は、でも心配しないで、"}, {"type": "subtitle", "time": 10859.59, "timestamp": "03:00:59", "text": "卒業式とか何であれ、"}]
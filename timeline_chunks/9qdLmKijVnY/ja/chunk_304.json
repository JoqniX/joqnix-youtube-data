[{"type": "subtitle", "time": 18242.47, "timestamp": "05:04:02", "text": "本日9時までに終了"}, {"type": "subtitle", "time": 18263.948, "timestamp": "05:04:23", "text": "今日は、6時半に起きて、"}, {"type": "subtitle", "time": 18266.43, "timestamp": "05:04:26", "text": "PCを開いてからスリープ状態にする"}, {"type": "subtitle", "time": 18269.548, "timestamp": "05:04:29", "text": "また、ああ、そうそう、ズク、君は聞かなければならなかった"}, {"type": "subtitle", "time": 18272.23, "timestamp": "05:04:32", "text": "先ほど、えっと、調子はどうですか？"}, {"type": "subtitle", "time": 18276.11, "timestamp": "05:04:36", "text": "今日の私の睡眠は、えっと、わからない"}, {"type": "subtitle", "time": 18277.948, "timestamp": "05:04:37", "text": "最近私は"}, {"type": "subtitle", "time": 18285.708, "timestamp": "05:04:45", "text": "今日も昨日と同じように"}, {"type": "subtitle", "time": 18289.31, "timestamp": "05:04:49", "text": "えっと、私のPCを、えっと、私の携帯電話を"}, {"type": "subtitle", "time": 18290.49, "timestamp": "05:04:50", "text": "別の部屋と"}, {"type": "subtitle", "time": 18291.788, "timestamp": "05:04:51", "text": "[音楽]"}, {"type": "subtitle", "time": 18293.548, "timestamp": "05:04:53", "text": "私"}, {"type": "subtitle", "time": 18298.67, "timestamp": "05:04:58", "text": "えっと、午前2時半頃に寝たと思います。"}]
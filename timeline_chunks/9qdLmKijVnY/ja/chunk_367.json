[{"type": "subtitle", "time": 22020.23, "timestamp": "06:07:00", "text": "下忍の準備をして、ありがとう忍者"}, {"type": "subtitle", "time": 22024.11, "timestamp": "06:07:04", "text": "本当に感謝しています、本当に感謝しています。"}, {"type": "subtitle", "time": 22026.35, "timestamp": "06:07:06", "text": "では、今"}, {"type": "subtitle", "time": 22030.27, "timestamp": "06:07:10", "text": "もちろんCPRはCPRです。誰かにFをしてください。"}, {"type": "subtitle", "time": 22033.51, "timestamp": "06:07:13", "text": "CPRは良いことだ、彼らはあなたがそう言える"}, {"type": "subtitle", "time": 22034.628, "timestamp": "06:07:14", "text": "保存"}, {"type": "subtitle", "time": 22038.11, "timestamp": "06:07:18", "text": "人生は肋骨を1、2本折ることもあるけど、"}, {"type": "subtitle", "time": 22039.99, "timestamp": "06:07:19", "text": "肋骨を2本折るよりは、人生の方がましだ"}, {"type": "subtitle", "time": 22041.39, "timestamp": "06:07:21", "text": "あなた"}, {"type": "subtitle", "time": 22050.03, "timestamp": "06:07:30", "text": "ともかく"}, {"type": "subtitle", "time": 22053.39, "timestamp": "06:07:33", "text": "とにかく、私が2Dライブを持っているから"}, {"type": "subtitle", "time": 22069.708, "timestamp": "06:07:49", "text": "waはgeninが開いてる、私はgeninをミュートします"}, {"type": "subtitle", "time": 22074.35, "timestamp": "06:07:54", "text": "音声で皆さんが聞き返せるように、なぜ"}, {"type": "subtitle", "time": 22079.708, "timestamp": "06:07:59", "text": "なぜ、なぜ気絶するんだ、気絶するんだ、私はCPを与える"}]
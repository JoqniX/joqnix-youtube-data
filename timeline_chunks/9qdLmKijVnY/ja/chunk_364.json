[{"type": "subtitle", "time": 21840.43, "timestamp": "06:04:00", "text": "全部終わらせただけ"}, {"type": "subtitle", "time": 21844.11, "timestamp": "06:04:04", "text": "ああ、神様、わからない、わからない、私は"}, {"type": "subtitle", "time": 21846.35, "timestamp": "06:04:06", "text": "プレイしたい"}, {"type": "subtitle", "time": 21848.19, "timestamp": "06:04:08", "text": "私はストリームを変更しませんので"}, {"type": "subtitle", "time": 21849.23, "timestamp": "06:04:09", "text": "男たちは"}, {"type": "subtitle", "time": 21854.03, "timestamp": "06:04:14", "text": "何か、うんうん、たぶんそうするよ"}, {"type": "subtitle", "time": 21856.868, "timestamp": "06:04:16", "text": "おそらく配信を一時停止します"}, {"type": "subtitle", "time": 21858.39, "timestamp": "06:04:18", "text": "おそらくストリームを停止して、それから"}, {"type": "subtitle", "time": 21861.91, "timestamp": "06:04:21", "text": "下忍のために全て準備して、そう、彼は"}, {"type": "subtitle", "time": 21864.628, "timestamp": "06:04:24", "text": "彼は今から寝る"}, {"type": "subtitle", "time": 21868.43, "timestamp": "06:04:28", "text": "en エターナル b f ああ、なんてことだ"}, {"type": "subtitle", "time": 21871.27, "timestamp": "06:04:31", "text": "彼は今寝ようとしている エターナルバック"}, {"type": "subtitle", "time": 21873.27, "timestamp": "06:04:33", "text": "痛み、ああ彼は永遠のものを手に入れるだろう"}, {"type": "subtitle", "time": 21876.07, "timestamp": "06:04:36", "text": "眠り、私の名前はまだ永遠のPに戻る"}, {"type": "subtitle", "time": 21877.468, "timestamp": "06:04:37", "text": "しかし、なぜなら"}, {"type": "subtitle", "time": 21880.628, "timestamp": "06:04:40", "text": "そう、私は自分の"}, {"type": "subtitle", "time": 21882.468, "timestamp": "06:04:42", "text": "Discordの画像だと思うけど、他の"}, {"type": "subtitle", "time": 21884.548, "timestamp": "06:04:44", "text": "それより何もない"}, {"type": "subtitle", "time": 21887.468, "timestamp": "06:04:47", "text": "ヴィックが実際に変えたって知ってるでしょ"}, {"type": "subtitle", "time": 21895.19, "timestamp": "06:04:55", "text": "ビクター、私は発音の仕方がわからない"}, {"type": "subtitle", "time": 21898.708, "timestamp": "06:04:58", "text": "言葉だけど、そう、サポートして、"}]
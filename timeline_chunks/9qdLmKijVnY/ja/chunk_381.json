[{"type": "subtitle", "time": 22863.51, "timestamp": "06:21:03", "text": "彼も仲間外れにされることはないと思う"}, {"type": "subtitle", "time": 22865.99, "timestamp": "06:21:05", "text": "私に追いついたような感じ"}, {"type": "subtitle", "time": 22868.51, "timestamp": "06:21:08", "text": "彼がライブダットモデルを持っているような場所で"}, {"type": "subtitle", "time": 22871.948, "timestamp": "06:21:11", "text": "私も同じようなライブモデルを持っています"}, {"type": "subtitle", "time": 22875.708, "timestamp": "06:21:15", "text": "また将来的には、"}, {"type": "subtitle", "time": 22877.948, "timestamp": "06:21:17", "text": "両方のモデルが参加しているコラボレーション"}, {"type": "subtitle", "time": 22880.628, "timestamp": "06:21:20", "text": "画面と移動は"}, {"type": "subtitle", "time": 22883.43, "timestamp": "06:21:23", "text": "素晴らしいので、たくさんの楽しいことができます"}, {"type": "subtitle", "time": 22886.708, "timestamp": "06:21:26", "text": "お互いのやり取りがとっても可愛い"}, {"type": "subtitle", "time": 22889.708, "timestamp": "06:21:29", "text": "定期的にプレイすることは"}, {"type": "subtitle", "time": 22892.35, "timestamp": "06:21:32", "text": "えっと、彼はあなたが友達である"}, {"type": "subtitle", "time": 22894.27, "timestamp": "06:21:34", "text": "いつでもあなたをサポートしてくれる人、そうですね。"}, {"type": "subtitle", "time": 22896.11, "timestamp": "06:21:36", "text": "まるで私が"}, {"type": "subtitle", "time": 22899.948, "timestamp": "06:21:39", "text": "ええ、正直言ってとても驚いています"}, {"type": "subtitle", "time": 22902.19, "timestamp": "06:21:42", "text": "そんなことは絶対にないと思っていた"}, {"type": "subtitle", "time": 22904.91, "timestamp": "06:21:44", "text": "誰とコラボレーションすればいいか"}, {"type": "subtitle", "time": 22908.23, "timestamp": "06:21:48", "text": "たくさんだけど、たくさん話すよ、うん、遊ぶ"}, {"type": "subtitle", "time": 22910.67, "timestamp": "06:21:50", "text": "ゲームをして、楽しんで、リラックスして、楽しんでください。"}, {"type": "subtitle", "time": 22912.27, "timestamp": "06:21:52", "text": "FPS"}, {"type": "subtitle", "time": 22915.03, "timestamp": "06:21:55", "text": "中世のゲーム"}, {"type": "subtitle", "time": 22917.83, "timestamp": "06:21:57", "text": "中世のことは分からないけど、私は彼らが大好きだ"}]
[{"type": "subtitle", "time": 5783.87, "timestamp": "01:36:23", "text": "え、待って、私はインスタグラムでライブ配信してないよ、待って"}, {"type": "subtitle", "time": 5785.27, "timestamp": "01:36:25", "text": "元"}, {"type": "subtitle", "time": 5787.39, "timestamp": "01:36:27", "text": "え、何？"}, {"type": "subtitle", "time": 5790.31, "timestamp": "01:36:30", "text": "何が起こったのか待って私のインスタグラムは"}, {"type": "subtitle", "time": 5791.99, "timestamp": "01:36:31", "text": "鉄"}, {"type": "subtitle", "time": 5813.99, "timestamp": "01:36:53", "text": "ああ神様、接続が切れてしまいました"}]
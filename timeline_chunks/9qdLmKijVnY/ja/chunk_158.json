[{"type": "subtitle", "time": 9485.79, "timestamp": "02:38:05", "text": "そんなにたくさん手に入れるのは難しいだろうね"}, {"type": "subtitle", "time": 9488.59, "timestamp": "02:38:08", "text": "殺すので、私が見ているのは、"}, {"type": "subtitle", "time": 9491.67, "timestamp": "02:38:11", "text": "少なくとも2キルは必要だ"}, {"type": "subtitle", "time": 9494.71, "timestamp": "02:38:14", "text": "遊んで、慣れる"}, {"type": "subtitle", "time": 9497.429, "timestamp": "02:38:17", "text": "メカニズムと"}, {"type": "subtitle", "time": 9528.23, "timestamp": "02:38:48", "text": "彼は私をうまく騙した、彼は本当に私を騙した"}]
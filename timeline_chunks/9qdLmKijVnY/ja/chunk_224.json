[{"type": "subtitle", "time": 13444.75, "timestamp": "03:44:04", "text": "それで、えーと、それで、それで、えーと、音声は"}, {"type": "subtitle", "time": 13447.79, "timestamp": "03:44:07", "text": "わかりました、音声が"}, {"type": "subtitle", "time": 13451.229, "timestamp": "03:44:11", "text": "はい、遅延や音声が聞こえますか"}, {"type": "subtitle", "time": 13455.63, "timestamp": "03:44:15", "text": "何かあれば教えてくださいね。"}, {"type": "subtitle", "time": 13460.99, "timestamp": "03:44:20", "text": "あ、待って、えっと、私は"}, {"type": "subtitle", "time": 13463.55, "timestamp": "03:44:23", "text": "音楽、君たちは持っているかい？"}, {"type": "subtitle", "time": 13465.75, "timestamp": "03:44:25", "text": "音楽を聴くのが好きです"}, {"type": "subtitle", "time": 13467.63, "timestamp": "03:44:27", "text": "えーと"}, {"type": "subtitle", "time": 13471.71, "timestamp": "03:44:31", "text": "えっと、えっと、いや、待って、全く音がしない、待って、何？"}, {"type": "subtitle", "time": 13473.11, "timestamp": "03:44:33", "text": "いいえという意味ですか？"}, {"type": "subtitle", "time": 13475.63, "timestamp": "03:44:35", "text": "音 待って待って待って待って待って待って待って待って"}, {"type": "subtitle", "time": 13480.07, "timestamp": "03:44:40", "text": "待って待って、冗談でしょ？待って"}, {"type": "subtitle", "time": 13483.389, "timestamp": "03:44:43", "text": "いいえ、違います"}, {"type": "subtitle", "time": 13491.59, "timestamp": "03:44:51", "text": "再びn"}, {"type": "subtitle", "time": 13493.87, "timestamp": "03:44:53", "text": "それ"}, {"type": "subtitle", "time": 13495.51, "timestamp": "03:44:55", "text": "いいえ"}, {"type": "subtitle", "time": 13497.349, "timestamp": "03:44:57", "text": "なぜ"}]
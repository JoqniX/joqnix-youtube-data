[{"type": "subtitle", "time": 15844.229, "timestamp": "04:24:04", "text": "まるで私が"}, {"type": "subtitle", "time": 15847.51, "timestamp": "04:24:07", "text": "見つけたものはとてもユニークでした。"}, {"type": "subtitle", "time": 15851.229, "timestamp": "04:24:11", "text": "3Dモデルが何なのか分からなかったvroidモデル"}, {"type": "subtitle", "time": 15854.99, "timestamp": "04:24:14", "text": "3Dモデルが話したりできるとか"}, {"type": "subtitle", "time": 15859.349, "timestamp": "04:24:19", "text": "ええ、私は何も知りませんでした"}, {"type": "subtitle", "time": 15860.99, "timestamp": "04:24:20", "text": "それ"}, {"type": "subtitle", "time": 15868.63, "timestamp": "04:24:28", "text": "彼らとゲームをした後、"}, {"type": "subtitle", "time": 15871.349, "timestamp": "04:24:31", "text": "また、彼らはブログやその他使用していたものも持っていた。"}, {"type": "subtitle", "time": 15874.149, "timestamp": "04:24:34", "text": "日本語で書くこともできますが、"}, {"type": "subtitle", "time": 15877.07, "timestamp": "04:24:37", "text": "ページを翻訳する"}, {"type": "subtitle", "time": 15880.79, "timestamp": "04:24:40", "text": "実際に手に入れて、彼らが何を知っているかを知る"}, {"type": "subtitle", "time": 15883.389, "timestamp": "04:24:43", "text": "彼らが書いたので、彼らは"}, {"type": "subtitle", "time": 15884.75, "timestamp": "04:24:44", "text": "旅として"}, {"type": "subtitle", "time": 15887.99, "timestamp": "04:24:47", "text": "ストリーマーとその他すべて、そして"}, {"type": "subtitle", "time": 15891.309, "timestamp": "04:24:51", "text": "彼らがvroidをどのように使用しているかについての記事"}, {"type": "subtitle", "time": 15894.95, "timestamp": "04:24:54", "text": "それで、彼らはこのことを"}]
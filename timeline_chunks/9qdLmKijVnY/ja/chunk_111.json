[{"type": "subtitle", "time": 6668.87, "timestamp": "01:51:08", "text": "はい、私は"}, {"type": "subtitle", "time": 6672.83, "timestamp": "01:51:12", "text": "戻ってきました、すみません、戻ってきました、えっと、どこに"}, {"type": "subtitle", "time": 6682.91, "timestamp": "01:51:22", "text": "どうやら、それは一種の"}, {"type": "subtitle", "time": 6689.629, "timestamp": "01:51:29", "text": "私の場所で起こっていることなので、私はこう思います"}, {"type": "subtitle", "time": 6706.79, "timestamp": "01:51:46", "text": "[音楽]"}]
[{"type": "subtitle", "time": 11945.67, "timestamp": "03:19:05", "text": "アクション"}, {"type": "subtitle", "time": 11948.63, "timestamp": "03:19:08", "text": "うん、そうだね"}, {"type": "subtitle", "time": 11950.79, "timestamp": "03:19:10", "text": "うん"}, {"type": "subtitle", "time": 11954.99, "timestamp": "03:19:14", "text": "こんにちは、私は本当に泣きたくなかったんです"}, {"type": "subtitle", "time": 11957.91, "timestamp": "03:19:17", "text": "今日私は自分に言い聞かせ続けた"}, {"type": "subtitle", "time": 11962.15, "timestamp": "03:19:22", "text": "ジョッキー、泣かないで、泣かないで、泣かないで"}, {"type": "subtitle", "time": 11965.389, "timestamp": "03:19:25", "text": "うまくいった"}, {"type": "subtitle", "time": 11969.91, "timestamp": "03:19:29", "text": "感情的に最善を尽くす"}, {"type": "subtitle", "time": 11973.79, "timestamp": "03:19:33", "text": "「私はしたくない」と言う"}, {"type": "subtitle", "time": 11975.309, "timestamp": "03:19:35", "text": "誰でも"}, {"type": "subtitle", "time": 11979.429, "timestamp": "03:19:39", "text": "えーっと、諦めるって感じ"}, {"type": "subtitle", "time": 11982.229, "timestamp": "03:19:42", "text": "ええ、正直に言うと、私は"}, {"type": "subtitle", "time": 11983.07, "timestamp": "03:19:43", "text": "1"}, {"type": "subtitle", "time": 11986.99, "timestamp": "03:19:46", "text": "ハッピーカムバックして、"}, {"type": "subtitle", "time": 11988.71, "timestamp": "03:19:48", "text": "すべてが曖昧"}, {"type": "subtitle", "time": 11992.03, "timestamp": "03:19:52", "text": "そして、何もなかったふりをする"}, {"type": "subtitle", "time": 11996.95, "timestamp": "03:19:56", "text": "起こったんだけど、えーと、私のこと知ってるでしょ、えーと、私は"}, {"type": "subtitle", "time": 11998.83, "timestamp": "03:19:58", "text": "これ"}]
[{"type": "subtitle", "time": 5882.4, "timestamp": "01:38:02", "text": "え、冗談でしょ？"}, {"type": "subtitle", "time": 5883.75, "timestamp": "01:38:03", "text": "[音楽]"}, {"type": "subtitle", "time": 5912.229, "timestamp": "01:38:32", "text": "私は持っていなかった"}, {"type": "subtitle", "time": 5915.27, "timestamp": "01:38:35", "text": "私には選択肢がなかった"}, {"type": "subtitle", "time": 5920.149, "timestamp": "01:38:40", "text": "選択肢はなかった。"}, {"type": "subtitle", "time": 5924.35, "timestamp": "01:38:44", "text": "男だけど、彼は「ああ、俺は手に入れる」って感じだった"}, {"type": "subtitle", "time": 5927.79, "timestamp": "01:38:47", "text": "敵を変えろ、お前を捕まえて"}, {"type": "subtitle", "time": 5929.99, "timestamp": "01:38:49", "text": "できなかった、銃さえ持っていなかった"}, {"type": "subtitle", "time": 5932.35, "timestamp": "01:38:52", "text": "柱のようなものを登ってみるか、"}, {"type": "subtitle", "time": 5934.189, "timestamp": "01:38:54", "text": "何か大きなp"}, {"type": "subtitle", "time": 5937.47, "timestamp": "01:38:57", "text": "パニックから私は他に何もできなかった"}]
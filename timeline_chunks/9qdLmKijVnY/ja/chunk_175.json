[{"type": "subtitle", "time": 10503.07, "timestamp": "02:55:03", "text": "星座は、他の星座は単独である。"}, {"type": "subtitle", "time": 10508.07, "timestamp": "02:55:08", "text": "強烈な光の点 私たちの星々は"}, {"type": "subtitle", "time": 10510.87, "timestamp": "02:55:10", "text": "私たちの感情"}, {"type": "subtitle", "time": 10513.309, "timestamp": "02:55:13", "text": "私たちの"}, {"type": "subtitle", "time": 10516.87, "timestamp": "02:55:16", "text": "本質的な瞬間には、"}, {"type": "subtitle", "time": 10519.55, "timestamp": "02:55:19", "text": "地に足をつけている"}, {"type": "subtitle", "time": 10522.95, "timestamp": "02:55:22", "text": "かつて追い求めていた光がただ"}, {"type": "subtitle", "time": 10524.79, "timestamp": "02:55:24", "text": "から"}, {"type": "subtitle", "time": 10528.75, "timestamp": "02:55:28", "text": "自分自身の強度が重さに達するとき"}, {"type": "subtitle", "time": 10534.429, "timestamp": "02:55:34", "text": "私たちの感情が私たち自身の限界を超えていく"}, {"type": "subtitle", "time": 10536.349, "timestamp": "02:55:36", "text": "軌道"}, {"type": "subtitle", "time": 10540.51, "timestamp": "02:55:40", "text": "しかし、スターと"}, {"type": "subtitle", "time": 10545.349, "timestamp": "02:55:45", "text": "私たちについて言えば、私たちは決して完全に消滅することはない"}, {"type": "subtitle", "time": 10548.87, "timestamp": "02:55:48", "text": "星々は、私たち自身の旅路に似ている"}, {"type": "subtitle", "time": 10552.59, "timestamp": "02:55:52", "text": "直線的ではなく、粉々に砕ける可能性がある"}, {"type": "subtitle", "time": 10556.11, "timestamp": "02:55:56", "text": "薄暗くなり、ぎりぎりのところまで押しやられた"}]
[{"type": "subtitle", "time": 22202.51, "timestamp": "06:10:02", "text": "彼のライブ配信はダーティモデルデウトです"}, {"type": "subtitle", "time": 22203.91, "timestamp": "06:10:03", "text": "彼を見てください"}, {"type": "subtitle", "time": 22207.23, "timestamp": "06:10:07", "text": "後で遊ぶよ"}, {"type": "subtitle", "time": 22212.31, "timestamp": "06:10:12", "text": "世代への影響は大きいですね"}, {"type": "subtitle", "time": 22215.868, "timestamp": "06:10:15", "text": "彼が好きになりたかったのは"}, {"type": "subtitle", "time": 22219.43, "timestamp": "06:10:19", "text": "終わったけど、彼は言ったけど、私は"}, {"type": "subtitle", "time": 22223.15, "timestamp": "06:10:23", "text": "うん、じゃあちょっと見てみようかな"}, {"type": "subtitle", "time": 22225.03, "timestamp": "06:10:25", "text": "サロン 私は"}, {"type": "subtitle", "time": 22228.11, "timestamp": "06:10:28", "text": "すみません、でも大丈夫です。私も初めてなので。"}, {"type": "subtitle", "time": 22230.27, "timestamp": "06:10:30", "text": "時計サロンのような時間"}, {"type": "subtitle", "time": 22233.27, "timestamp": "06:10:33", "text": "これは生放送なので、それは"}, {"type": "subtitle", "time": 22235.75, "timestamp": "06:10:35", "text": "経験ですね、えっと"}, {"type": "subtitle", "time": 22239.11, "timestamp": "06:10:39", "text": "うん、これ大好きだよ、みんな"}, {"type": "subtitle", "time": 22241.43, "timestamp": "06:10:41", "text": "まったく分からないよ、君たちも見たよね"}, {"type": "subtitle", "time": 22242.99, "timestamp": "06:10:42", "text": "変な感じ"}, {"type": "subtitle", "time": 22246.03, "timestamp": "06:10:46", "text": "役立たずのトレーラーのようにぐちゃぐちゃ"}, {"type": "subtitle", "time": 22248.868, "timestamp": "06:10:48", "text": "そうだよみんな、私は映像を作っていたんだ"}, {"type": "subtitle", "time": 22251.59, "timestamp": "06:10:51", "text": "君たちは私がどれだけ"}, {"type": "subtitle", "time": 22254.35, "timestamp": "06:10:54", "text": "気が散って、たとえ"}, {"type": "subtitle", "time": 22256.43, "timestamp": "06:10:56", "text": "映像全体は、よくわからないという感じだった"}, {"type": "subtitle", "time": 22259.628, "timestamp": "06:10:59", "text": "マックスみたいに1分待って、私は"}]
[{"type": "subtitle", "time": 10981.55, "timestamp": "03:03:01", "text": "話したので、その言葉が気に入ってもらえたらいいなと思います"}, {"type": "subtitle", "time": 10984.15, "timestamp": "03:03:04", "text": "少しだけ心に触れて、諦めないで"}, {"type": "subtitle", "time": 10988.87, "timestamp": "03:03:08", "text": "はい、引き続きベストを尽くしてください"}, {"type": "subtitle", "time": 10992.11, "timestamp": "03:03:12", "text": "これは新たな旅路であることを忘れないで"}, {"type": "subtitle", "time": 10996.59, "timestamp": "03:03:16", "text": "こんにちは、では私が書いたものを読み上げます。"}, {"type": "subtitle", "time": 10999.55, "timestamp": "03:03:19", "text": "完成してはいないけど、まあ、やらなきゃいけない"}, {"type": "subtitle", "time": 11025.87, "timestamp": "03:03:45", "text": "泣く"}]
[{"type": "subtitle", "time": 23041.27, "timestamp": "06:24:01", "text": "ドイツ語のストリームを続けている彼に、"}, {"type": "subtitle", "time": 23045.15, "timestamp": "06:24:05", "text": "彼の旅の中で最高です。とても幸せです。"}, {"type": "subtitle", "time": 23048.03, "timestamp": "06:24:08", "text": "なかなかいいですよ、と聞かれたら"}, {"type": "subtitle", "time": 23051.83, "timestamp": "06:24:11", "text": "ええ、私は神様が好きです。とても"}, {"type": "subtitle", "time": 23053.948, "timestamp": "06:24:13", "text": "わからないし、この後私は行く"}, {"type": "subtitle", "time": 23056.19, "timestamp": "06:24:16", "text": "ストリームを一時停止するには、"}, {"type": "subtitle", "time": 23058.67, "timestamp": "06:24:18", "text": "瞬間、そして私は戻ってきます"}, {"type": "subtitle", "time": 23061.628, "timestamp": "06:24:21", "text": "君たちは発電機を持っていて、私たちは"}, {"type": "subtitle", "time": 23064.75, "timestamp": "06:24:24", "text": "ギニンアクションが起こっていると思う"}, {"type": "subtitle", "time": 23066.468, "timestamp": "06:24:26", "text": "私はまだ古いページを使用するつもりです"}, {"type": "subtitle", "time": 23068.11, "timestamp": "06:24:28", "text": "なぜなら、それはある意味簡単だから"}, {"type": "subtitle", "time": 23070.19, "timestamp": "06:24:30", "text": "私はやらなければならなかった、私はいじくり回さなければならなかった"}, {"type": "subtitle", "time": 23072.27, "timestamp": "06:24:32", "text": "その後しばらくはフジテックで"}, {"type": "subtitle", "time": 23074.43, "timestamp": "06:24:34", "text": "待ってみます、彼はまだそれをしていません"}, {"type": "subtitle", "time": 23077.43, "timestamp": "06:24:37", "text": "30分前に彼にそうするように言ったのに、ああ"}, {"type": "subtitle", "time": 23082.59, "timestamp": "06:24:42", "text": "神様、大きなVをください、Vが欲しいですか"}, {"type": "subtitle", "time": 23092.788, "timestamp": "06:24:52", "text": "君たちは最高だ"}]
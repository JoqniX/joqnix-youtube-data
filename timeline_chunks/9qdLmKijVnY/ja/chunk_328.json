[{"type": "subtitle", "time": 19681.19, "timestamp": "05:28:01", "text": "えっと、彼らはストリーミング配信したことがないみたいですね"}, {"type": "subtitle", "time": 19684.03, "timestamp": "05:28:04", "text": "彼らの人生の中で、彼らはストリーミング配信するだろう"}, {"type": "subtitle", "time": 19685.31, "timestamp": "05:28:05", "text": "このため"}, {"type": "subtitle", "time": 19688.628, "timestamp": "05:28:08", "text": "イベントだけど、もし彼らが"}, {"type": "subtitle", "time": 19691.35, "timestamp": "05:28:11", "text": "ストリーミングのように、彼らは留まるか、"}, {"type": "subtitle", "time": 19693.31, "timestamp": "05:28:13", "text": "彼らはただプリムのためにそこにいるだけです"}, {"type": "subtitle", "time": 19694.91, "timestamp": "05:28:14", "text": "ジャンプとかそういうのだけど、"}, {"type": "subtitle", "time": 19697.83, "timestamp": "05:28:17", "text": "たくさんの新しい人たちを見るのは楽しい"}, {"type": "subtitle", "time": 19699.67, "timestamp": "05:28:19", "text": "ストリーミングに興味がある理由は"}, {"type": "subtitle", "time": 19703.708, "timestamp": "05:28:23", "text": "このイベントだけでなく、プライムジャムのイベントも"}, {"type": "subtitle", "time": 19707.51, "timestamp": "05:28:27", "text": "15と比べると、ちょっと低いですね。"}, {"type": "subtitle", "time": 19710.35, "timestamp": "05:28:30", "text": "時間とか全部そうだね、それは"}, {"type": "subtitle", "time": 19712.91, "timestamp": "05:28:32", "text": "あなたは多くの時間を費やしています"}, {"type": "subtitle", "time": 19715.51, "timestamp": "05:28:35", "text": "時間と労力を費やす"}, {"type": "subtitle", "time": 19719.868, "timestamp": "05:28:39", "text": "ストリーミングとプリムジェム報酬は"}, {"type": "subtitle", "time": 19722.628, "timestamp": "05:28:42", "text": "低すぎると思う、そうは思わない"}, {"type": "subtitle", "time": 19726.868, "timestamp": "05:28:46", "text": "わかってるけど、そう、戻ってきたら、"}, {"type": "subtitle", "time": 19730.548, "timestamp": "05:28:50", "text": "ジェニンイレストリームを持っています"}, {"type": "subtitle", "time": 19733.868, "timestamp": "05:28:53", "text": "土曜日で、6時半ではありません。"}, {"type": "subtitle", "time": 19736.788, "timestamp": "05:28:56", "text": "持久力レースをしようと思っているので、"}]
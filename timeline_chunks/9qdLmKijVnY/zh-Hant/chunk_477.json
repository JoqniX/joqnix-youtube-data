[{"type": "subtitle", "time": 28634.708, "timestamp": "07:57:14", "text": "所以這就是目前的積分系統，"}, {"type": "subtitle", "time": 28638.308, "timestamp": "07:57:18", "text": "如果我沒記錯的話，"}, {"type": "subtitle", "time": 28652.948, "timestamp": "07:57:32", "text": "我不會給每個追蹤者加分，我賺取所有積分。我覺得，關鍵是，我"}, {"type": "subtitle", "time": 28675.868, "timestamp": "07:57:55", "text": "覺得我們可以這樣做，我們也可以把關注也算進去，我不介意，我們可以最後根據我們目前為止做的所有計算來決定。好的，我想和你們一起做這件事，因為我必須做，而且我覺得，我"}, {"type": "subtitle", "time": 28677.75, "timestamp": "07:57:57", "text": "知道我不用在直播裡做，"}, {"type": "subtitle", "time": 28679.15, "timestamp": "07:57:59", "text": "但我沒有，我沒有可以幫我"}]
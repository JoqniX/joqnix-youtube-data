[{"type": "subtitle", "time": 26221.19, "timestamp": "07:17:01", "text": "不過，啊，該死，"}, {"type": "subtitle", "time": 26225.628, "timestamp": "07:17:05", "text": "我打不開這個。我想，"}, {"type": "subtitle", "time": 26227.628, "timestamp": "07:17:07", "text": "為什麼？我為什麼要這麼折磨自己？總之，"}, {"type": "subtitle", "time": 26231.03, "timestamp": "07:17:11", "text": "這裡有個寶箱，"}, {"type": "subtitle", "time": 26234.788, "timestamp": "07:17:14", "text": "你在哪裡？看看地圖，我在"}, {"type": "subtitle", "time": 26238.708, "timestamp": "07:17:18", "text": "蛇窟附近。好的，需要蛇來對付鹿嗎？"}, {"type": "subtitle", "time": 26242.11, "timestamp": "07:17:22", "text": "我不這麼認為。"}, {"type": "subtitle", "time": 26245.07, "timestamp": "07:17:25", "text": "你真的需要那條蛇嗎？"}, {"type": "subtitle", "time": 26248.15, "timestamp": "07:17:28", "text": "是的，你是說"}, {"type": "subtitle", "time": 26250.27, "timestamp": "07:17:30", "text": "我們需要的鳥嗎？是的，鳥，不是……是的，"}, {"type": "subtitle", "time": 26253.99, "timestamp": "07:17:33", "text": "抱歉，不是蛇。我在"}, {"type": "subtitle", "time": 26256.548, "timestamp": "07:17:36", "text": "幹什麼？呃，我想我不需要"}, {"type": "subtitle", "time": 26259.868, "timestamp": "07:17:39", "text": "鳥的任何東西。我想是的。總之，過來，"}, {"type": "subtitle", "time": 26263.628, "timestamp": "07:17:43", "text": "拿起"}, {"type": "subtitle", "time": 26265.708, "timestamp": "07:17:45", "text": "思考"}, {"type": "subtitle", "time": 26269.15, "timestamp": "07:17:49", "text": "寶箱。好的，我們必須離開"}, {"type": "subtitle", "time": 26271.15, "timestamp": "07:17:51", "text": "這裡嗎？"}, {"type": "subtitle", "time": 26279.07, "timestamp": "07:17:59", "text": "上帝啊，我看見祢被困在"}]
[{"type": "subtitle", "time": 14523.11, "timestamp": "04:02:03", "text": "錯誤，但那是一場不錯的"}, {"type": "subtitle", "time": 14526.55, "timestamp": "04:02:06", "text": "比賽，我沒看到他們在"}, {"type": "subtitle", "time": 14529.429, "timestamp": "04:02:09", "text": "那裡，哦，是的，好險，"}, {"type": "subtitle", "time": 14531.79, "timestamp": "04:02:11", "text": "那很"}, {"type": "subtitle", "time": 14535.67, "timestamp": "04:02:15", "text": "有趣，歡迎回來，mag，"}, {"type": "subtitle", "time": 14548.87, "timestamp": "04:02:28", "text": "在我們開始之前，讓我"}, {"type": "subtitle", "time": 14552.87, "timestamp": "04:02:32", "text": "看看我的… …… CED 不，我不是職業選手，心裡"}, {"type": "subtitle", "time": 14565.79, "timestamp": "04:02:45", "text": "不是職業選手，回來吧。 [音樂] 你是職業選手，不，我不是職業選手，你他媽的什麼？"}]
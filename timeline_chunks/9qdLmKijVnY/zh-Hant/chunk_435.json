[{"type": "subtitle", "time": 26103.868, "timestamp": "07:15:03", "text": "你不介意吧？嗨嗨嗨嗨。"}, {"type": "subtitle", "time": 26106.468, "timestamp": "07:15:06", "text": "等等，給我一秒鐘，一秒鐘，讓"}, {"type": "subtitle", "time": 26109.548, "timestamp": "07:15:09", "text": "我吹一下。好的，有個像"}, {"type": "subtitle", "time": 26115.75, "timestamp": "07:15:15", "text": "東西。"}, {"type": "subtitle", "time": 26117.35, "timestamp": "07:15:17", "text": "總之，你"}, {"type": "subtitle", "time": 26120.23, "timestamp": "07:15:20", "text": "看，哦，它就在這裡。不過我不想"}, {"type": "subtitle", "time": 26123.59, "timestamp": "07:15:23", "text": "待在這裡，所以我"}, {"type": "subtitle", "time": 26127.59, "timestamp": "07:15:27", "text": "要走了，我要走了，去檢查一些"}, {"type": "subtitle", "time": 26129.548, "timestamp": "07:15:29", "text": "東西。好的，它能用了。好的，你知道嗎？"}, {"type": "subtitle", "time": 26132.23, "timestamp": "07:15:32", "text": "走開。我不想，我想"}, {"type": "subtitle", "time": 26140.51, "timestamp": "07:15:40", "text": "[音樂]"}, {"type": "subtitle", "time": 26144.83, "timestamp": "07:15:44", "text": "等等，為什麼不能用？等等，看，"}, {"type": "subtitle", "time": 26147.12, "timestamp": "07:15:47", "text": "我"}, {"type": "subtitle", "time": 26148.948, "timestamp": "07:15:48", "text": "[音樂]"}, {"type": "subtitle", "time": 26152.468, "timestamp": "07:15:52", "text": "你們看到"}]
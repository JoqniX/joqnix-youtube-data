[{"type": "subtitle", "time": 24200.75, "timestamp": "06:43:20", "text": "我要死了！好吧，[音樂] 不是…"}, {"type": "subtitle", "time": 24206.31, "timestamp": "06:43:26", "text": "你最喜歡的下忍角色是誰？我的是堅定不移，除非這裡有人選。我一直都是打野，他真的很厲害，他是我第一個專門培養的角色。"}, {"type": "subtitle", "time": 24217.59, "timestamp": "06:43:37", "text": "我還記得你幫我在祖瑪那裡"}, {"type": "subtitle", "time": 24239.468, "timestamp": "06:43:59", "text": "太高了？我想要所有設定都調到最低，對，最低，"}]
[{"type": "subtitle", "time": 184.149, "timestamp": "00:03:04", "text": "為什麼我覺得我需要更多睡眠？"}, {"type": "subtitle", "time": 186.67, "timestamp": "00:03:06", "text": "什麼？我睡了"}, {"type": "subtitle", "time": 191.75, "timestamp": "00:03:11", "text": "很多。有趣的是，我昨天7:30就睡了，"}, {"type": "subtitle", "time": 193.99, "timestamp": "00:03:13", "text": "直播結束後，我和"}, {"type": "subtitle", "time": 195.99, "timestamp": "00:03:15", "text": "B聊了一會兒，然後就睡了。"}, {"type": "subtitle", "time": 199.82999999999998, "timestamp": "00:03:19", "text": "但大概8點8點左右吧，所以從"}, {"type": "subtitle", "time": 204.309, "timestamp": "00:03:24", "text": "8點到10點或9點我一直在睡覺，"}, {"type": "subtitle", "time": 207.789, "timestamp": "00:03:27", "text": "被狗狗的叫聲吵醒了，然後"}, {"type": "subtitle", "time": 213.82999999999998, "timestamp": "00:03:33", "text": "我去倒了熱水，之後"}, {"type": "subtitle", "time": 222.71, "timestamp": "00:03:42", "text": "我……嗯，晚上"}, {"type": "subtitle", "time": 228.82999999999998, "timestamp": "00:03:48", "text": "10點11點左右吃了晚飯，不是早上，是晚上。"}, {"type": "subtitle", "time": 230.91, "timestamp": "00:03:50", "text": "吃完"}]
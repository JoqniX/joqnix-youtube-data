[{"type": "subtitle", "time": 14827.87, "timestamp": "04:07:07", "text": "B……哦，對了，我覺得我是個跑轟玩家，"}, {"type": "subtitle", "time": 14830.59, "timestamp": "04:07:10", "text": "有時候我喜歡躲起來什麼的，我有點像個"}, {"type": "subtitle", "time": 14833.71, "timestamp": "04:07:13", "text": "遠程玩家，所以我喜歡"}, {"type": "subtitle", "time": 14837.71, "timestamp": "04:07:17", "text": "衝鋒陷陣然後死很多次。我想這"}, {"type": "subtitle", "time": 14842.59, "timestamp": "04:07:22", "text": "可能是我喜歡Oan的原因，因為他跑得"}]
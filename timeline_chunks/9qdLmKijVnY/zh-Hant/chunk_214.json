[{"type": "subtitle", "time": 12847.87, "timestamp": "03:34:07", "text": "所以我會私訊徵求"}, {"type": "subtitle", "time": 12851.469, "timestamp": "03:34:11", "text": "你們的同意。對於那些為我創作作品的朋友們，你們送給我的精美"}, {"type": "subtitle", "time": 12860.67, "timestamp": "03:34:20", "text": "禮物，我會徵求你們的同意。如果"}, {"type": "subtitle", "time": 12863.67, "timestamp": "03:34:23", "text": "你沒有推特帳號，我會用我的帳號發布，或是用另一個推特帳號發布。是的，因為"}, {"type": "subtitle", "time": 12881.63, "timestamp": "03:34:41", "text": "尤其是在藝術作品方面，大家可能會感到困惑，因為我的個人簡介或其他任何地方都沒有這個標籤，所以大家會感到困惑。所以，"}, {"type": "subtitle", "time": 12884.11, "timestamp": "03:34:44", "text": "你們中的很多人沒有使用標籤，而是直接@我。推特帳號然後…"}, {"type": "subtitle", "time": 12891.309, "timestamp": "03:34:51", "text": "呃，做了那件事，所以，是的，現在我們終於有"}]
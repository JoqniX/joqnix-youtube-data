[{"type": "subtitle", "time": 300.11, "timestamp": "00:05:00", "text": "很早，因為我想調整一下我的睡眠，SK，"}, {"type": "subtitle", "time": 302.629, "timestamp": "00:05:02", "text": "我覺得這樣不對，對"}, {"type": "subtitle", "time": 304.99, "timestamp": "00:05:04", "text": "我不好，嗯，"}, {"type": "subtitle", "time": 312.749, "timestamp": "00:05:12", "text": "早上5點睡覺對我不好，不，這"}, {"type": "subtitle", "time": 316.07, "timestamp": "00:05:16", "text": "不好，我需要…調整好我的Escape日程，"}, {"type": "subtitle", "time": 320.51, "timestamp": "00:05:20", "text": "我已經調整好了，明天也一樣。我也很"}, {"type": "subtitle", "time": 323.67, "timestamp": "00:05:23", "text": "期待今晚，嗯，"}, {"type": "subtitle", "time": 328.35, "timestamp": "00:05:28", "text": "早點睡，嗯，12點前我就"}, {"type": "subtitle", "time": 334.11, "timestamp": "00:05:34", "text": "希望你過得愉快。你好，培根，"}, {"type": "subtitle", "time": 336.629, "timestamp": "00:05:36", "text": "歡迎來到直播間。已經一個月了，是的，已經"}, {"type": "chat", "time": 337.364, "timestamp": "00:05:37", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "why do i feel like everything is so quick day by day, but during the day, its just so slow"}, {"type": "subtitle", "time": 339.59000000000003, "timestamp": "00:05:39", "text": "一個月了，"}, {"type": "subtitle", "time": 343.43, "timestamp": "00:05:43", "text": "下明天就是"}, {"type": "subtitle", "time": 348.629, "timestamp": "00:05:48", "text": "三月了。為什麼我覺得一切都過得這麼"}, {"type": "subtitle", "time": 351.43, "timestamp": "00:05:51", "text": "快，一天比一天快，但"}, {"type": "subtitle", "time": 353.469, "timestamp": "00:05:53", "text": "白天卻很慢？是的，確實如此，確實如此。"}]
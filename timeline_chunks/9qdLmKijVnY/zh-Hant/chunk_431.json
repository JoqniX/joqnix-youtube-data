[{"type": "subtitle", "time": 25872.11, "timestamp": "07:11:12", "text": "我以為我只是在"}, {"type": "subtitle", "time": 25884.43, "timestamp": "07:11:24", "text": "你的單位嗎？哦，我的天啊，為什麼我想評判你？給我一秒鐘，你為什麼要評斷？"}, {"type": "subtitle", "time": 25891.548, "timestamp": "07:11:31", "text": "這只是個遊戲，我會嚴厲地評判你的，上帝啊，如果我嚴厲的話，哦，我的天啊，"}, {"type": "subtitle", "time": 25902.35, "timestamp": "07:11:42", "text": "總之，哦，我的天啊，NE耶穌基督60級"}, {"type": "subtitle", "time": 25905.83, "timestamp": "07:11:45", "text": "[音樂]嗯，給我"}, {"type": "subtitle", "time": 25913.31, "timestamp": "07:11:53", "text": "秒鐘，嗯，好的，"}, {"type": "subtitle", "time": 25917.11, "timestamp": "07:11:57", "text": "給我一秒鐘，我會"}, {"type": "subtitle", "time": 25919.27, "timestamp": "07:11:59", "text": "去看看日誌，我會回复你，看看幽靈"}]
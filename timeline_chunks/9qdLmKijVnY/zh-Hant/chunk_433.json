[{"type": "subtitle", "time": 25981.948, "timestamp": "07:13:01", "text": "天賦細節。"}, {"type": "subtitle", "time": 25986.23, "timestamp": "07:13:06", "text": "好的，這還不錯。這是"}, {"type": "subtitle", "time": 25990.51, "timestamp": "07:13:10", "text": "第一部分還是第二部？好的，酷，"}, {"type": "subtitle", "time": 25994.51, "timestamp": "07:13:14", "text": "有意思。嗯哼，嗯哼。好的，好的，酷。"}, {"type": "subtitle", "time": 25999.788, "timestamp": "07:13:19", "text": "她會根據"}, {"type": "subtitle", "time": 26005.11, "timestamp": "07:13:25", "text": "HP等級調整屬性。好的，不錯，開始得好。"}, {"type": "subtitle", "time": 26007.31, "timestamp": "07:13:27", "text": "你的問題是你在"}, {"type": "subtitle", "time": 26009.03, "timestamp": "07:13:29", "text": "用紫色裝備。我不知道你為什麼"}, {"type": "subtitle", "time": 26012.11, "timestamp": "07:13:32", "text": "要用紫色，但是，雖然"}, {"type": "subtitle", "time": 26015.868, "timestamp": "07:13:35", "text": "很酷，但對你的KN等級來說不好。橙色才是傳奇，"}, {"type": "subtitle", "time": 26024.11, "timestamp": "07:13:44", "text": "就像所有遊戲概念一樣，"}, {"type": "subtitle", "time": 26026.99, "timestamp": "07:13:46", "text": "橙色是傳奇。是的，"}, {"type": "subtitle", "time": 26030.03, "timestamp": "07:13:50", "text": "所以你的每個裝備槽都需要橘色。"}]
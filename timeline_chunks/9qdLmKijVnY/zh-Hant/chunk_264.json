[{"type": "subtitle", "time": 15844.229, "timestamp": "04:24:04", "text": "我發現其中一個主播"}, {"type": "subtitle", "time": 15847.51, "timestamp": "04:24:07", "text": "非常獨特，因為他有一個"}, {"type": "subtitle", "time": 15851.229, "timestamp": "04:24:11", "text": "Vroid模型。我以前不知道3D模型是什麼，也不知道3D模型還能"}, {"type": "subtitle", "time": 15854.99, "timestamp": "04:24:14", "text": "說話什麼的。"}, {"type": "subtitle", "time": 15859.349, "timestamp": "04:24:19", "text": "所以，是的，我對這些一無所知。"}, {"type": "subtitle", "time": 15868.63, "timestamp": "04:24:28", "text": "後來我發現了Vroid，就跟他聊天，一起玩遊戲。之後，"}, {"type": "subtitle", "time": 15871.349, "timestamp": "04:24:31", "text": "他還開了一個博客，用"}, {"type": "subtitle", "time": 15874.149, "timestamp": "04:24:34", "text": "日語寫東西，不過你可以"}, {"type": "subtitle", "time": 15877.07, "timestamp": "04:24:37", "text": "翻譯一下，"}, {"type": "subtitle", "time": 15880.79, "timestamp": "04:24:40", "text": "看看他寫了些什麼。"}]
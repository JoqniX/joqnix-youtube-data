[{"type": "subtitle", "time": 16207.75, "timestamp": "04:30:07", "text": "什麼來著，"}, {"type": "subtitle", "time": 16208.87, "timestamp": "04:30:08", "text": "我是"}, {"type": "subtitle", "time": 16212.87, "timestamp": "04:30:12", "text": "Godak，正在讀，在我的直播裡，我總是說“"}, {"type": "subtitle", "time": 16221.71, "timestamp": "04:30:21", "text": "Y Halo”，對吧？"}, {"type": "subtitle", "time": 16223.67, "timestamp": "04:30:23", "text": "所以我們也應該做一個，如果是早上，比如“OHA”，那就用“Jo”之類的，"}, {"type": "subtitle", "time": 16233.149, "timestamp": "04:30:33", "text": "我"}, {"type": "subtitle", "time": 16237.269, "timestamp": "04:30:37", "text": "在推特上用“OHA Jo”，但我不知道，呃，類似"}, {"type": "subtitle", "time": 16246.229, "timestamp": "04:30:46", "text": "我不知道。是啊，"}, {"type": "subtitle", "time": 16250.189, "timestamp": "04:30:50", "text": "你的問候語是什麼？是啊，"}, {"type": "subtitle", "time": 16256.109, "timestamp": "04:30:56", "text": "我總是說“Yeah Hello”，呃，經常"}, {"type": "subtitle", "time": 16259.83, "timestamp": "04:30:59", "text": "說“Yeah Hello”，然後我突然"}]
[{"type": "subtitle", "time": 1760.43, "timestamp": "00:29:20", "text": "咱們開始吧！嗯，我終於完成了挑戰，嗯，是的，我拿到了皮膚和各種東西，哇，這裡好多東西啊！免費級、預售級、高級級……哦，這個真酷！不錯！哦，他們這賽季有個什麼皮膚？"}, {"type": "subtitle", "time": 1764.389, "timestamp": "00:29:24", "text": "牆面皮膚！"}, {"type": "subtitle", "time": 1769.47, "timestamp": "00:29:29", "text": "不錯！哇，好多東西！哇！哦，"}, {"type": "subtitle", "time": 1772.269, "timestamp": "00:29:32", "text": "這個看起來不錯！嗯，我的畫質"}, {"type": "subtitle", "time": 1774.669, "timestamp": "00:29:34", "text": "調低了，所以你可能"}, {"type": "subtitle", "time": 1778.35, "timestamp": "00:29:38", "text": "看不清楚，不過你"}, {"type": "subtitle", "time": 1779.789, "timestamp": "00:29:39", "text": "懂的。嗯，這"}, {"type": "subtitle", "time": 1783.59, "timestamp": "00:29:43", "text": "是什麼？哦，這個"}, {"type": "subtitle", "time": 1788.59, "timestamp": "00:29:48", "text": "很酷！砰！這讓我想起了W的框架，有點像那種"}]
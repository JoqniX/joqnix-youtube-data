[{"type": "subtitle", "time": 26283.11, "timestamp": "07:18:03", "text": "樹上了。不不，我只是在找出去的路。"}, {"type": "subtitle", "time": 26286.91, "timestamp": "07:18:06", "text": "哦，我想就像跳下去什麼的，"}, {"type": "subtitle", "time": 26289.35, "timestamp": "07:18:09", "text": "等等，"}, {"type": "subtitle", "time": 26295.15, "timestamp": "07:18:15", "text": "哦，你是從樹幹上跳下來的，對，就是這樣，算了，哦等等，那是"}, {"type": "subtitle", "time": 26309.948, "timestamp": "07:18:29", "text": "蘑菇嗎？給我一分鐘，我需要"}, {"type": "subtitle", "time": 26312.708, "timestamp": "07:18:32", "text": "那些蘑菇，給我一"}, {"type": "subtitle", "time": 26327.468, "timestamp": "07:18:47", "text": "英國人，呃，在"}, {"type": "subtitle", "time": 26331.03, "timestamp": "07:18:51", "text": "喝茶嗎？是的，不，我沒看到任何"}, {"type": "subtitle", "time": 26334.91, "timestamp": "07:18:54", "text": "茶，你能看見嗎？我看到了，我看到了，我看到了，是的，就是它，就是這樣，"}]
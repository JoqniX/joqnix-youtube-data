[{"type": "subtitle", "time": 11342.309, "timestamp": "03:09:02", "text": "冲动之下，我做了些事，让我的东西变得更……"}, {"type": "subtitle", "time": 11345.349, "timestamp": "03:09:05", "text": "每次都很复杂，因为我"}, {"type": "subtitle", "time": 11353.71, "timestamp": "03:09:13", "text": "我怀揣着抱负，并且全力以赴。"}, {"type": "subtitle", "time": 11356.87, "timestamp": "03:09:16", "text": "就像独自一人扛下所有这一切"}, {"type": "subtitle", "time": 11360.51, "timestamp": "03:09:20", "text": "不寻求任何人的"}, {"type": "subtitle", "time": 11364.99, "timestamp": "03:09:24", "text": "帮忙还是我自己来做，我"}, {"type": "subtitle", "time": 11367.19, "timestamp": "03:09:27", "text": "我付出了惨痛的代价才明白它有多么重要。"}, {"type": "subtitle", "time": 11370.07, "timestamp": "03:09:30", "text": "可能会影响你"}, {"type": "subtitle", "time": 11381.15, "timestamp": "03:09:41", "text": "时间，是的，这让我感觉就像在……期间"}, {"type": "subtitle", "time": 11383.59, "timestamp": "03:09:43", "text": "休假期间我一直在思考很多事情"}, {"type": "subtitle", "time": 11386.469, "timestamp": "03:09:46", "text": "诸如此类的事情，我真的想来"}, {"type": "subtitle", "time": 11390.429, "timestamp": "03:09:50", "text": "一月份回来，因为那是开始……"}, {"type": "subtitle", "time": 11395.349, "timestamp": "03:09:55", "text": "今年，但是嗯，我觉得如果我"}, {"type": "subtitle", "time": 11397.87, "timestamp": "03:09:57", "text": "一直说就像在……期间，嗯……我"}]
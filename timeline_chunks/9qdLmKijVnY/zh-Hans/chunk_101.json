[{"type": "subtitle", "time": 6071.55, "timestamp": "01:41:11", "text": "着陆啊"}, {"type": "subtitle", "time": 6096.149, "timestamp": "01:41:36", "text": "好的，我需要做一些挑战。"}, {"type": "subtitle", "time": 6099.43, "timestamp": "01:41:39", "text": "现在我想买B通行证了。"}, {"type": "subtitle", "time": 6103.31, "timestamp": "01:41:43", "text": "有一天，但不是现在，我想总有一天吧。"}, {"type": "subtitle", "time": 6107.35, "timestamp": "01:41:47", "text": "我本来想去，但后来又觉得我不想去。"}, {"type": "subtitle", "time": 6110.55, "timestamp": "01:41:50", "text": "现在也挺好的，但我想要"}, {"type": "subtitle", "time": 6112.39, "timestamp": "01:41:52", "text": "为了存钱，你知道你永远不知道会发生什么"}]
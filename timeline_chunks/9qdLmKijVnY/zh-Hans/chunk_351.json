[{"type": "subtitle", "time": 21061.39, "timestamp": "05:51:01", "text": "我脑海中的音乐"}, {"type": "subtitle", "time": 21063.67, "timestamp": "05:51:03", "text": "手机"}, {"type": "subtitle", "time": 21067.99, "timestamp": "05:51:07", "text": "是的，就是这样……"}, {"type": "subtitle", "time": 21073.27, "timestamp": "05:51:13", "text": "Twitch 的东西，还有，呃，下一个，我的下一个，呃，呃"}, {"type": "subtitle", "time": 21075.628, "timestamp": "05:51:15", "text": "我一直在思考我的日程安排。"}, {"type": "subtitle", "time": 21079.75, "timestamp": "05:51:19", "text": "关于将日程表添加到谷歌"}, {"type": "subtitle", "time": 21084.548, "timestamp": "05:51:24", "text": "日历，所以我看到了，嗯，我看到了"}, {"type": "subtitle", "time": 21089.708, "timestamp": "05:51:29", "text": "嗯，她叫什么来着？寿司儿子，做吧。"}, {"type": "subtitle", "time": 21092.83, "timestamp": "05:51:32", "text": "她"}, {"type": "subtitle", "time": 21102.548, "timestamp": "05:51:42", "text": "加上“喜欢”和“你叫什么”"}, {"type": "subtitle", "time": 21105.35, "timestamp": "05:51:45", "text": "她过去常常补充说，比如，你管它叫什么？"}, {"type": "subtitle", "time": 21107.868, "timestamp": "05:51:47", "text": "它就像谷歌日历一样。"}, {"type": "subtitle", "time": 21111.868, "timestamp": "05:51:51", "text": "iOS 也还有其他一些功能。"}, {"type": "subtitle", "time": 21114.67, "timestamp": "05:51:54", "text": "用户们，他们还会有另一件事，是的。"}, {"type": "subtitle", "time": 21118.548, "timestamp": "05:51:58", "text": "所以我会把它们添加到我的清单里。"}]
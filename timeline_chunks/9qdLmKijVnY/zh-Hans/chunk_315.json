[{"type": "subtitle", "time": 18909.23, "timestamp": "05:15:09", "text": "GG，我的游戏卡顿得他们很厉害，哦，太多了。"}, {"type": "subtitle", "time": 18910.948, "timestamp": "05:15:10", "text": "你还会继续玩吗？"}, {"type": "subtitle", "time": 18913.868, "timestamp": "05:15:13", "text": "呃，大多数"}, {"type": "subtitle", "time": 18917.07, "timestamp": "05:15:17", "text": "可能有一对夫妇要等一两场比赛。"}, {"type": "subtitle", "time": 18924.67, "timestamp": "05:15:24", "text": "认识的人很可能有一两个"}, {"type": "subtitle", "time": 18929.47, "timestamp": "05:15:29", "text": "我不知道的游戏，哦，这家伙是"}, {"type": "subtitle", "time": 18938.59, "timestamp": "05:15:38", "text": "我想，我很快就要结束了。"}, {"type": "subtitle", "time": 18943.03, "timestamp": "05:15:43", "text": "正在研究那个头显的东西，对吧？"}, {"type": "subtitle", "time": 18946.03, "timestamp": "05:15:46", "text": "或许不是稍后才会用到的那种头枕。"}, {"type": "subtitle", "time": 18949.788, "timestamp": "05:15:49", "text": "那是以后的事，我忘了，我不应该……"}, {"type": "subtitle", "time": 18953.91, "timestamp": "05:15:53", "text": "把头伸进去……我不应该……把头伸进去"}, {"type": "subtitle", "time": 18959.15, "timestamp": "05:15:59", "text": "去做我想做的事情，结果却……"}]
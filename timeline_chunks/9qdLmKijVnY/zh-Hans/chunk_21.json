[{"type": "subtitle", "time": 1260.43, "timestamp": "00:21:00", "text": "[音乐]"}, {"type": "subtitle", "time": 1262.789, "timestamp": "00:21:02", "text": "有趣的"}, {"type": "subtitle", "time": 1264.13, "timestamp": "00:21:04", "text": "我哦"}, {"type": "subtitle", "time": 1265.99, "timestamp": "00:21:05", "text": "[音乐]"}, {"type": "subtitle", "time": 1269.029, "timestamp": "00:21:09", "text": "不，没关系。"}, {"type": "subtitle", "time": 1274.669, "timestamp": "00:21:14", "text": "嗯，是的，我们会担心的。"}, {"type": "subtitle", "time": 1277.63, "timestamp": "00:21:17", "text": "之后我得担心……"}, {"type": "subtitle", "time": 1280.39, "timestamp": "00:21:20", "text": "四月"}, {"type": "subtitle", "time": 1284.789, "timestamp": "00:21:24", "text": "因为呃，我，我，我最初想要的"}, {"type": "subtitle", "time": 1288.669, "timestamp": "00:21:28", "text": "呃，修复OD相关问题"}, {"type": "subtitle", "time": 1290.269, "timestamp": "00:21:30", "text": "呃"}, {"type": "subtitle", "time": 1300.19, "timestamp": "00:21:40", "text": "是啊，我们看看要多少钱吧。"}, {"type": "subtitle", "time": 1309.39, "timestamp": "00:21:49", "text": "真心希望一切顺利"}, {"type": "subtitle", "time": 1314.07, "timestamp": "00:21:54", "text": "男人缺钱，什么都缺。"}, {"type": "subtitle", "time": 1317.71, "timestamp": "00:21:57", "text": "可能为了活着，我会认为我会"}]
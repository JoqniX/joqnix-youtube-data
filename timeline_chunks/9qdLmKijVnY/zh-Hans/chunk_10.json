[{"type": "subtitle", "time": 600.15, "timestamp": "00:10:00", "text": "我手里有很多东西，而且这个月也有很多。"}, {"type": "subtitle", "time": 605.79, "timestamp": "00:10:05", "text": "四月份的m，这样我就可以做我的"}, {"type": "subtitle", "time": 609.71, "timestamp": "00:10:09", "text": "继续进行委员会工作"}, {"type": "subtitle", "time": 611.79, "timestamp": "00:10:11", "text": "东西"}, {"type": "subtitle", "time": 615.35, "timestamp": "00:10:15", "text": "是的，我们以为我们已经拥有了它。"}, {"type": "subtitle", "time": 617.47, "timestamp": "00:10:17", "text": "差远了"}, {"type": "subtitle", "time": 622.43, "timestamp": "00:10:22", "text": "我们对索具的目标是……呃，但是……"}, {"type": "subtitle", "time": 625.31, "timestamp": "00:10:25", "text": "好的，我们还有三个。"}, {"type": "subtitle", "time": 632.87, "timestamp": "00:10:32", "text": "我们会仔细审查我们拥有的一切。"}, {"type": "subtitle", "time": 636.35, "timestamp": "00:10:36", "text": "目前为止已经完成了"}, {"type": "subtitle", "time": 639.389, "timestamp": "00:10:39", "text": "Jaton，是的，我们会进行评论。"}, {"type": "subtitle", "time": 642.31, "timestamp": "00:10:42", "text": "我们所做的大部分事情"}, {"type": "subtitle", "time": 650.269, "timestamp": "00:10:50", "text": "就像一个接一个地做，需要做什么"}, {"type": "subtitle", "time": 652.389, "timestamp": "00:10:52", "text": "做你需要的"}, {"type": "subtitle", "time": 656.069, "timestamp": "00:10:56", "text": "我需要修复的东西，我需要的东西"}, {"type": "subtitle", "time": 659.79, "timestamp": "00:10:59", "text": "变化和一切"}]
[{"type": "subtitle", "time": 22982.15, "timestamp": "06:23:02", "text": "我会看着他，你"}, {"type": "subtitle", "time": 22985.75, "timestamp": "06:23:05", "text": "伙计们，你们知道一个叫 Fe f 的游戏吗？"}, {"type": "subtitle", "time": 22987.99, "timestamp": "06:23:07", "text": "那就像我希望遇到这样的人一样。"}, {"type": "subtitle", "time": 22991.03, "timestamp": "06:23:11", "text": "我未来会遇到的人，对，对，你"}, {"type": "subtitle", "time": 22995.75, "timestamp": "06:23:15", "text": "你永远不知道你会遇到谁，你是？"}, {"type": "subtitle", "time": 22998.51, "timestamp": "06:23:18", "text": "希望你一切顺利"}, {"type": "subtitle", "time": 23001.35, "timestamp": "06:23:21", "text": "永远尽力而为，好吗？"}, {"type": "subtitle", "time": 23003.67, "timestamp": "06:23:23", "text": "新人，你们这些人真的"}, {"type": "subtitle", "time": 23005.868, "timestamp": "06:23:25", "text": "进入幽灵游戏哦，抱歉，你们是"}, {"type": "subtitle", "time": 23007.468, "timestamp": "06:23:27", "text": "我真的很喜欢恐怖游戏，让我"}, {"type": "subtitle", "time": 23009.468, "timestamp": "06:23:29", "text": "你们有什么建议吗？"}, {"type": "subtitle", "time": 23012.07, "timestamp": "06:23:32", "text": "也请在评论区告诉我。"}, {"type": "subtitle", "time": 23014.628, "timestamp": "06:23:34", "text": "聊天的时候我肯定会玩的，我会"}, {"type": "subtitle", "time": 23017.67, "timestamp": "06:23:37", "text": "买下他们，让他玩，等等，我迟到了吗？哦"}, {"type": "subtitle", "time": 23021.75, "timestamp": "06:23:41", "text": "是的，这里有很多新来的人。"}, {"type": "subtitle", "time": 23023.83, "timestamp": "06:23:43", "text": "找回自我，我真是太……"}, {"type": "subtitle", "time": 23027.15, "timestamp": "06:23:47", "text": "很高兴，现在一切都会好起来的。"}, {"type": "subtitle", "time": 23029.75, "timestamp": "06:23:49", "text": "对他来说也是，因为他现在有了一个好机会"}, {"type": "subtitle", "time": 23032.83, "timestamp": "06:23:52", "text": "更好的模型和更高质量的流媒体"}, {"type": "subtitle", "time": 23035.948, "timestamp": "06:23:55", "text": "以及资产之类的东西"}]
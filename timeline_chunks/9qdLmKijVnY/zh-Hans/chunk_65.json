[{"type": "subtitle", "time": 3917.97, "timestamp": "01:05:17", "text": "挑战哦，一把战斗枪，不错"}, {"type": "subtitle", "time": 3948.829, "timestamp": "01:05:48", "text": "我当时是什么？"}, {"type": "subtitle", "time": 3951.269, "timestamp": "01:05:51", "text": "我当时在做什么？"}, {"type": "subtitle", "time": 3954.109, "timestamp": "01:05:54", "text": "他什么时候做的"}, {"type": "subtitle", "time": 3958.19, "timestamp": "01:05:58", "text": "这些人真不错，我真希望我也有我的"}]
[{"type": "subtitle", "time": 23160.99, "timestamp": "06:26:00", "text": "我又在做打磨了，没关系哦"}, {"type": "subtitle", "time": 23163.59, "timestamp": "06:26:03", "text": "我的流媒体播放有点卡顿。"}, {"type": "subtitle", "time": 23165.468, "timestamp": "06:26:05", "text": "我不知道为什么"}, {"type": "subtitle", "time": 23169.27, "timestamp": "06:26:09", "text": "夜行机器人，我看到这边还有其他人，我们走吧"}, {"type": "subtitle", "time": 23171.35, "timestamp": "06:26:11", "text": "不能说它不存在之类的。"}, {"type": "subtitle", "time": 23174.03, "timestamp": "06:26:14", "text": "我需要逃课"}, {"type": "subtitle", "time": 23176.83, "timestamp": "06:26:16", "text": "夜间机器人吓跑了我"}, {"type": "subtitle", "time": 23181.23, "timestamp": "06:26:21", "text": "该死的观众们"}, {"type": "subtitle", "time": 23184.39, "timestamp": "06:26:24", "text": "总之，nightbot，恭喜恭喜！"}, {"type": "subtitle", "time": 23186.708, "timestamp": "06:26:26", "text": "非常感谢您的新模型。"}, {"type": "subtitle", "time": 23189.43, "timestamp": "06:26:29", "text": "谢谢你，我过得还不错。"}, {"type": "subtitle", "time": 23192.39, "timestamp": "06:26:32", "text": "真是目瞪口呆，我从未如此惊讶过。"}, {"type": "subtitle", "time": 23195.788, "timestamp": "06:26:35", "text": "就像处理生活模型一样"}, {"type": "subtitle", "time": 23199.35, "timestamp": "06:26:39", "text": "所以有点赘肉，我想，而且我是"}, {"type": "subtitle", "time": 23201.75, "timestamp": "06:26:41", "text": "我也像是在玩……"}, {"type": "subtitle", "time": 23203.59, "timestamp": "06:26:43", "text": "切换操作，我觉得我快掌握要领了。"}, {"type": "subtitle", "time": 23205.03, "timestamp": "06:26:45", "text": "它"}, {"type": "subtitle", "time": 23209.35, "timestamp": "06:26:49", "text": "总之，我很高兴见到他。"}, {"type": "subtitle", "time": 23211.07, "timestamp": "06:26:51", "text": "逐渐熟悉V2工作室"}, {"type": "subtitle", "time": 23215.468, "timestamp": "06:26:55", "text": "一切都很顺利，不像……呃……"}, {"type": "subtitle", "time": 23217.468, "timestamp": "06:26:57", "text": "你们听到了吗？你们听到了吗？"}]
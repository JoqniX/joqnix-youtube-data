[{"type": "subtitle", "time": 10560.07, "timestamp": "02:56:00", "text": "每个碎片内部都笼罩着黑暗"}, {"type": "subtitle", "time": 10566.11, "timestamp": "02:56:06", "text": "有一点火花，微弱而持久的"}, {"type": "subtitle", "time": 10569.83, "timestamp": "02:56:09", "text": "想想凤凰涅槃的可能性"}, {"type": "subtitle", "time": 10573.71, "timestamp": "02:56:13", "text": "一只从自身升起的神话之鸟"}, {"type": "subtitle", "time": 10577.29, "timestamp": "02:56:17", "text": "灰烬重生重聚"}, {"type": "subtitle", "time": 10580.229, "timestamp": "02:56:20", "text": "[音乐]"}, {"type": "subtitle", "time": 10584.03, "timestamp": "02:56:24", "text": "焕然一新的我们的明星们也并无不同。"}, {"type": "subtitle", "time": 10586.269, "timestamp": "02:56:26", "text": "可以打破"}, {"type": "subtitle", "time": 10590.87, "timestamp": "02:56:30", "text": "散落各处，看似迷失，但却"}, {"type": "subtitle", "time": 10593.389, "timestamp": "02:56:33", "text": "与……共度时光"}, {"type": "subtitle", "time": 10595.309, "timestamp": "02:56:35", "text": "耐心"}, {"type": "subtitle", "time": 10597.87, "timestamp": "02:56:37", "text": "同情心，尤其是对……的同情心"}, {"type": "subtitle", "time": 10601.91, "timestamp": "02:56:41", "text": "我们自己可以"}, {"type": "subtitle", "time": 10606.11, "timestamp": "02:56:46", "text": "重建一些明星需要时间"}, {"type": "subtitle", "time": 10610.51, "timestamp": "02:56:50", "text": "需要重新调整一些星座"}, {"type": "subtitle", "time": 10616.51, "timestamp": "02:56:56", "text": "重绘一万次尝试也无法定义你"}]
[{"type": "subtitle", "time": 17349.75, "timestamp": "04:49:09", "text": "嗯……等等，我忘了我为什么会提到……"}, {"type": "subtitle", "time": 17353.51, "timestamp": "04:49:13", "text": "哦，天哪，我的身份证有时候真是蠢到家了。"}, {"type": "subtitle", "time": 17361.83, "timestamp": "04:49:21", "text": "我知道这就是我说话的方式。"}, {"type": "subtitle", "time": 17363.788, "timestamp": "04:49:23", "text": "关于直播中的某些事情，我立刻"}, {"type": "subtitle", "time": 17366.628, "timestamp": "04:49:26", "text": "我忘了我刚才在说什么了"}, {"type": "subtitle", "time": 17386.15, "timestamp": "04:49:46", "text": "命名"}, {"type": "subtitle", "time": 17388.948, "timestamp": "04:49:48", "text": "但我为什么要谈论命名这件事呢？"}]
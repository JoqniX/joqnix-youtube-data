[{"type": "subtitle", "time": 11401.51, "timestamp": "03:10:01", "text": "我记得我上次直播是在8月13日。"}, {"type": "subtitle", "time": 11405.469, "timestamp": "03:10:05", "text": "或者说第14条，所以，嗯，从那时起我就"}, {"type": "subtitle", "time": 11407.59, "timestamp": "03:10:07", "text": "我一直对自己说“是啊”。"}, {"type": "subtitle", "time": 11412.229, "timestamp": "03:10:12", "text": "我会宣布暂停活动，然后我会"}, {"type": "subtitle", "time": 11416.229, "timestamp": "03:10:16", "text": "回来吧，因为我需要一些时间。"}, {"type": "subtitle", "time": 11418.389, "timestamp": "03:10:18", "text": "处理很多"}, {"type": "subtitle", "time": 11424.83, "timestamp": "03:10:24", "text": "事情嘛，嗯，是啊，就像，嗯，这很难。"}, {"type": "subtitle", "time": 11427.75, "timestamp": "03:10:27", "text": "我真的非常非常想回来，因为我"}, {"type": "subtitle", "time": 11436.71, "timestamp": "03:10:36", "text": "热情地"}, {"type": "subtitle", "time": 11439.59, "timestamp": "03:10:39", "text": "我不想把它变成……"}, {"type": "subtitle", "time": 11442.429, "timestamp": "03:10:42", "text": "那些矫揉造作的情感，我从未想过要这么做。"}, {"type": "subtitle", "time": 11446.15, "timestamp": "03:10:46", "text": "这场直播有点情绪化，呃，但是"}, {"type": "subtitle", "time": 11447.99, "timestamp": "03:10:47", "text": "无法控制"}, {"type": "subtitle", "time": 11449.269, "timestamp": "03:10:49", "text": "我的情绪"}, {"type": "subtitle", "time": 11453.15, "timestamp": "03:10:53", "text": "今天嗯，因为我有很多事要做。"}, {"type": "subtitle", "time": 11456.19, "timestamp": "03:10:56", "text": "考试即将到来"}, {"type": "subtitle", "time": 11458.87, "timestamp": "03:10:58", "text": "十二月有很多责任，所以"}]
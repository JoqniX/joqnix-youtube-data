[{"type": "subtitle", "time": 8589.67, "timestamp": "02:23:09", "text": "好吧，我把它弄丢了"}, {"type": "subtitle", "time": 8594.469, "timestamp": "02:23:14", "text": "哦等等，啊，最好的枪在这里。"}, {"type": "subtitle", "time": 8602.55, "timestamp": "02:23:22", "text": "这里蕴含着相当多的能量"}, {"type": "subtitle", "time": 8605.67, "timestamp": "02:23:25", "text": "我没带弹药，所以我会尽量带走。"}, {"type": "subtitle", "time": 8610.95, "timestamp": "02:23:30", "text": "这边肯定有赃物，所以"}, {"type": "subtitle", "time": 8622.95, "timestamp": "02:23:42", "text": "这边没什么特别的。"}, {"type": "subtitle", "time": 8625.309, "timestamp": "02:23:45", "text": "哦，两个"}, {"type": "subtitle", "time": 8629.23, "timestamp": "02:23:49", "text": "胸前任何东西"}, {"type": "subtitle", "time": 8638.99, "timestamp": "02:23:58", "text": "黄金啊，那不是我想要的。"}]
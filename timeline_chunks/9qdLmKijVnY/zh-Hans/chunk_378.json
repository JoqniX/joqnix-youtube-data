[{"type": "subtitle", "time": 22688.67, "timestamp": "06:18:08", "text": "你好吗，乔？嗯，你好，我很好。"}, {"type": "subtitle", "time": 22691.59, "timestamp": "06:18:11", "text": "我很好，我很好，你好吗？"}, {"type": "subtitle", "time": 22708.91, "timestamp": "06:18:28", "text": "挺有意思的，我对这次首秀还挺满意的。"}, {"type": "subtitle", "time": 22711.91, "timestamp": "06:18:31", "text": "实际上，我以为它会……"}, {"type": "subtitle", "time": 22714.07, "timestamp": "06:18:34", "text": "我觉得它会来的，因为它是"}, {"type": "subtitle", "time": 22716.91, "timestamp": "06:18:36", "text": "一切都发生得太突然了，但整件事……"}, {"type": "subtitle", "time": 22720.15, "timestamp": "06:18:40", "text": "突然之间，我能放大看看吗？"}, {"type": "subtitle", "time": 22724.03, "timestamp": "06:18:44", "text": "疤痕，当然，哦，有。"}, {"type": "subtitle", "time": 22726.59, "timestamp": "06:18:46", "text": "瘢痕"}, {"type": "subtitle", "time": 22729.19, "timestamp": "06:18:49", "text": "所以一切都像是“我的天哪，他有……”"}, {"type": "subtitle", "time": 22731.468, "timestamp": "06:18:51", "text": "他右眼上的疤痕好可爱啊！"}, {"type": "subtitle", "time": 22735.23, "timestamp": "06:18:55", "text": "我会放大看，它太可爱了，我希望"}, {"type": "subtitle", "time": 22737.83, "timestamp": "06:18:57", "text": "我的天啊，什么都没有化为灰烬。"}, {"type": "subtitle", "time": 22739.948, "timestamp": "06:18:59", "text": "等等，你看到高光了吗？等等。"}]
[{"type": "subtitle", "time": 18310.39, "timestamp": "05:05:10", "text": "四点钟我又睡着了，六点钟醒了。"}, {"type": "subtitle", "time": 18313.788, "timestamp": "05:05:13", "text": "不，不是六，不是六，实际上是……呃，三十"}, {"type": "subtitle", "time": 18317.07, "timestamp": "05:05:17", "text": "30分钟后我睡着了。"}, {"type": "subtitle", "time": 18320.39, "timestamp": "05:05:20", "text": "我又醒了，还是没睡着。"}, {"type": "subtitle", "time": 18324.19, "timestamp": "05:05:24", "text": "事情又这样持续了一段时间。"}, {"type": "subtitle", "time": 18328.15, "timestamp": "05:05:28", "text": "我睡了30分钟后醒来。"}, {"type": "subtitle", "time": 18331.43, "timestamp": "05:05:31", "text": "然后我又遇到了类似的事情。"}, {"type": "subtitle", "time": 18335.19, "timestamp": "05:05:35", "text": "早上6:30到10:00醒着，然后睡着了。"}, {"type": "subtitle", "time": 18344.23, "timestamp": "05:05:44", "text": "我醒来的时候，大概就是这样。"}, {"type": "subtitle", "time": 18346.83, "timestamp": "05:05:46", "text": "说实话，昨天我"}, {"type": "subtitle", "time": 18348.948, "timestamp": "05:05:48", "text": "根本睡不着"}, {"type": "subtitle", "time": 18352.628, "timestamp": "05:05:52", "text": "我真想知道到底出了什么问题。"}, {"type": "subtitle", "time": 18356.35, "timestamp": "05:05:56", "text": "中间发生了什么事，比如我的近况"}, {"type": "subtitle", "time": 18358.07, "timestamp": "05:05:58", "text": "睡眠安排一切正常"}]
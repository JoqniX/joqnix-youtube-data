[{"type": "subtitle", "time": 4201.07, "timestamp": "01:10:01", "text": "感觉就像我才刚开始一样，所以是的"}, {"type": "subtitle", "time": 4223.35, "timestamp": "01:10:23", "text": "[音乐]"}, {"type": "subtitle", "time": 4226.83, "timestamp": "01:10:26", "text": "3小时电力供应，现在不行了，就像……"}, {"type": "subtitle", "time": 4230.39, "timestamp": "01:10:30", "text": "这里因为天气太热，所以特别难熬。"}, {"type": "subtitle", "time": 4234.39, "timestamp": "01:10:34", "text": "现在正值浪潮时期，所以我就想"}, {"type": "subtitle", "time": 4237.55, "timestamp": "01:10:37", "text": "我真的汗流浃背，所以自从"}, {"type": "subtitle", "time": 4239.95, "timestamp": "01:10:39", "text": "自停电以来的施工"}, {"type": "subtitle", "time": 4243.149, "timestamp": "01:10:43", "text": "当时我们不得不把……送走"}, {"type": "subtitle", "time": 4244.27, "timestamp": "01:10:44", "text": "这"}, {"type": "subtitle", "time": 4247.51, "timestamp": "01:10:47", "text": "工人们，呃，我想那里有……"}, {"type": "subtitle", "time": 4249.07, "timestamp": "01:10:49", "text": "焊接工作之类的，我也不知道。"}, {"type": "subtitle", "time": 4250.99, "timestamp": "01:10:50", "text": "有些地方不一样"}, {"type": "subtitle", "time": 4253.43, "timestamp": "01:10:53", "text": "进出的人"}, {"type": "subtitle", "time": 4255.91, "timestamp": "01:10:55", "text": "建筑材料"}, {"type": "subtitle", "time": 4259.35, "timestamp": "01:10:59", "text": "所以，嗯，我当时就在看。"}]
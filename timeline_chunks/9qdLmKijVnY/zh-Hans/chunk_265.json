[{"type": "subtitle", "time": 15900.349, "timestamp": "04:25:00", "text": "你管它叫什么？他们当时在玩VR。"}, {"type": "subtitle", "time": 15903.07, "timestamp": "04:25:03", "text": "追踪以及所有追踪器"}, {"type": "subtitle", "time": 15905.83, "timestamp": "04:25:05", "text": "以及他们模型中的所有内容"}, {"type": "subtitle", "time": 15909.75, "timestamp": "04:25:09", "text": "所以他们写了很多东西，就像一个巨大的……"}, {"type": "subtitle", "time": 15912.83, "timestamp": "04:25:12", "text": "写篇博客，说说他们是怎么做到的"}, {"type": "subtitle", "time": 15917.03, "timestamp": "04:25:17", "text": "嗯，还有所有，他们也用了……"}, {"type": "subtitle", "time": 15921.109, "timestamp": "04:25:21", "text": "vkatsu 不是 vkatsu 呃，他叫什么名字"}, {"type": "subtitle", "time": 15923.87, "timestamp": "04:25:23", "text": "软件名称是什么来着？"}, {"type": "subtitle", "time": 15926.87, "timestamp": "04:25:26", "text": "这是一款你不需要时才会使用的软件"}, {"type": "subtitle", "time": 15928.79, "timestamp": "04:25:28", "text": "如果你是那种人，想知道哪里可以找到"}, {"type": "subtitle", "time": 15932.109, "timestamp": "04:25:32", "text": "不想透露你的"}, {"type": "subtitle", "time": 15933.75, "timestamp": "04:25:33", "text": "嗓音"}, {"type": "subtitle", "time": 15938.349, "timestamp": "04:25:38", "text": "嗯，你可以使用Tex um Vocaloid语音"}, {"type": "subtitle", "time": 15944.429, "timestamp": "04:25:44", "text": "就像初音未来的声音，或者任何其他胶体"}, {"type": "subtitle", "time": 15946.63, "timestamp": "04:25:46", "text": "在……中发出声音"}, {"type": "subtitle", "time": 15949.95, "timestamp": "04:25:49", "text": "CER 并像这样做"}, {"type": "subtitle", "time": 15951.99, "timestamp": "04:25:51", "text": "那"}, {"type": "subtitle", "time": 15954.91, "timestamp": "04:25:54", "text": "对对，我以前是他们的粉丝。"}, {"type": "subtitle", "time": 15957.91, "timestamp": "04:25:57", "text": "她现在被称为等等，别这样。"}]
[{"type": "subtitle", "time": 4639.35, "timestamp": "01:17:19", "text": "我害怕那边那个人。"}, {"type": "subtitle", "time": 4642.59, "timestamp": "01:17:22", "text": "我在这里害怕那个人，因为他怎么会这样"}, {"type": "subtitle", "time": 4644.51, "timestamp": "01:17:24", "text": "你喜欢独奏吗？我是说，呃，盾牌"}, {"type": "subtitle", "time": 4646.629, "timestamp": "01:17:26", "text": "差异有时真的非常重要哦"}, {"type": "subtitle", "time": 4659.149, "timestamp": "01:17:39", "text": "单人消息很有趣，它是专门为此而设计的"}, {"type": "subtitle", "time": 4662.47, "timestamp": "01:17:42", "text": "像我这样只想玩游戏的人"}]
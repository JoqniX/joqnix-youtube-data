[{"type": "subtitle", "time": 12720.75, "timestamp": "03:32:00", "text": "嗯，我会先征求您的同意。"}, {"type": "subtitle", "time": 12723.389, "timestamp": "03:32:03", "text": "如果你没有你的许可的话……"}, {"type": "subtitle", "time": 12727.03, "timestamp": "03:32:07", "text": "我会在推特上发布它"}, {"type": "subtitle", "time": 12729.469, "timestamp": "03:32:09", "text": "要么通过我的账户，要么我将使用"}, {"type": "subtitle", "time": 12737.99, "timestamp": "03:32:17", "text": "推特，嗯，就是这样。"}, {"type": "subtitle", "time": 12740.95, "timestamp": "03:32:20", "text": "是的，因为尤其是在涉及到……的时候"}, {"type": "subtitle", "time": 12743.91, "timestamp": "03:32:23", "text": "艺术方面的人都感到困惑，对吧？"}, {"type": "subtitle", "time": 12746.95, "timestamp": "03:32:26", "text": "我的个人简介里没有话题标签。"}, {"type": "subtitle", "time": 12748.229, "timestamp": "03:32:28", "text": "或任何地方"}, {"type": "subtitle", "time": 12752.59, "timestamp": "03:32:32", "text": "否则，呃，人们会感到困惑，所以……"}, {"type": "subtitle", "time": 12755.59, "timestamp": "03:32:35", "text": "很多人都在用这个话题标签"}, {"type": "subtitle", "time": 12759.87, "timestamp": "03:32:39", "text": "标记了我，标记了我的推特"}, {"type": "subtitle", "time": 12763.03, "timestamp": "03:32:43", "text": "然后账户就做了那件事，所以是的。"}, {"type": "subtitle", "time": 12767.349, "timestamp": "03:32:47", "text": "现在我们终于有了哈希值"}, {"type": "subtitle", "time": 12770.75, "timestamp": "03:32:50", "text": "我所以呃"}, {"type": "subtitle", "time": 12774.07, "timestamp": "03:32:54", "text": "昨天我在我以前的设备上直播了"}, {"type": "subtitle", "time": 12777.55, "timestamp": "03:32:57", "text": "在 X 上的小号"}]
[{"type": "subtitle", "time": 10442.55, "timestamp": "02:54:02", "text": "宇宙浩瀚黑暗中的天空"}, {"type": "subtitle", "time": 10445.71, "timestamp": "02:54:05", "text": "星星数不胜数，每一颗都是如此。"}, {"type": "subtitle", "time": 10449.55, "timestamp": "02:54:09", "text": "独一无二，每个都讲述着一个故事，想象一下"}, {"type": "subtitle", "time": 10452.59, "timestamp": "02:54:12", "text": "每个人都怀揣着一个瞬间"}, {"type": "subtitle", "time": 10456.469, "timestamp": "02:54:16", "text": "它们之中蕴藏着一颗星，而不仅仅是比喻。"}, {"type": "subtitle", "time": 10459.55, "timestamp": "02:54:19", "text": "轻盈却充满活力"}, {"type": "subtitle", "time": 10462.91, "timestamp": "02:54:22", "text": "呼吸片段"}, {"type": "subtitle", "time": 10466.389, "timestamp": "02:54:26", "text": "宇宙中一些星星闪耀着光芒。"}, {"type": "subtitle", "time": 10470.83, "timestamp": "02:54:30", "text": "一些闪烁的不确定感非常精彩，"}, {"type": "subtitle", "time": 10475.79, "timestamp": "02:54:35", "text": "有些似乎失去了光泽"}, {"type": "subtitle", "time": 10480.19, "timestamp": "02:54:40", "text": "每颗星星都是完全的"}, {"type": "subtitle", "time": 10482.79, "timestamp": "02:54:42", "text": "就像指纹一样不同"}, {"type": "subtitle", "time": 10486.51, "timestamp": "02:54:46", "text": "宇宙中没有两颗恒星是完全对称的。"}, {"type": "subtitle", "time": 10489.229, "timestamp": "02:54:49", "text": "有些人像以前一样"}, {"type": "subtitle", "time": 10493.63, "timestamp": "02:54:53", "text": "有些燃烧得很亮，但有些很小。"}, {"type": "subtitle", "time": 10495.51, "timestamp": "02:54:55", "text": "悄悄"}, {"type": "subtitle", "time": 10499.67, "timestamp": "02:54:59", "text": "有些恒星结构复杂，经久不衰。"}]
[{"type": "subtitle", "time": 11165.269, "timestamp": "03:06:05", "text": "下坡路，呃，我想我已经吃了很多。"}, {"type": "subtitle", "time": 11168.79, "timestamp": "03:06:08", "text": "房屋像休息一样"}, {"type": "subtitle", "time": 11173.309, "timestamp": "03:06:13", "text": "是的，那一年，它确实在期间播出。"}, {"type": "subtitle", "time": 11175.269, "timestamp": "03:06:15", "text": "前一天"}, {"type": "subtitle", "time": 11179.59, "timestamp": "03:06:19", "text": "我宣布的周年纪念日"}, {"type": "subtitle", "time": 11181.71, "timestamp": "03:06:21", "text": "我不会做"}, {"type": "subtitle", "time": 11184.67, "timestamp": "03:06:24", "text": "周年纪念日，因个人原因"}, {"type": "subtitle", "time": 11187.87, "timestamp": "03:06:27", "text": "嗯，是啊，当时事情太多了。"}, {"type": "subtitle", "time": 11198.99, "timestamp": "03:06:38", "text": "一切，嗯，是的，我想"}, {"type": "subtitle", "time": 11201.71, "timestamp": "03:06:41", "text": "做某种"}, {"type": "subtitle", "time": 11205.87, "timestamp": "03:06:45", "text": "内容，但是嗯"}, {"type": "subtitle", "time": 11216.429, "timestamp": "03:06:56", "text": "等等，好的，我是"}, {"type": "subtitle", "time": 11219.59, "timestamp": "03:06:59", "text": "嗯，是的，我想说的是……"}]
[{"type": "subtitle", "time": 2880.069, "timestamp": "00:48:00", "text": "商店里的一切就像……"}, {"type": "subtitle", "time": 2882.069, "timestamp": "00:48:02", "text": "进度之类的东西等等"}, {"type": "subtitle", "time": 2884.23, "timestamp": "00:48:04", "text": "就像有一个新的嗯"}, {"type": "subtitle", "time": 2886.71, "timestamp": "00:48:06", "text": "货币之类的东西，他们正在全力以赴"}, {"type": "subtitle", "time": 2889.27, "timestamp": "00:48:09", "text": "扭蛋模式，他们为什么要抄袭？为什么？"}, {"type": "subtitle", "time": 2892.23, "timestamp": "00:48:12", "text": "他们这是在搞下忍那种事吗？"}, {"type": "subtitle", "time": 2894.99, "timestamp": "00:48:14", "text": "为什么？他们为什么要这样做？"}, {"type": "subtitle", "time": 2899.95, "timestamp": "00:48:19", "text": "再加上新的呃呃异国风情"}, {"type": "subtitle", "time": 2903.23, "timestamp": "00:48:23", "text": "异国情调的呃，射击会导致过热，而且"}, {"type": "subtitle", "time": 2906.829, "timestamp": "00:48:26", "text": "神秘的哦哦等等，这太酷了"}, {"type": "subtitle", "time": 2911.349, "timestamp": "00:48:31", "text": "等等，不好意思，我想要这款皮肤，看看……"}, {"type": "subtitle", "time": 2914.829, "timestamp": "00:48:34", "text": "这就是它，它好可爱，它是彩虹色的"}, {"type": "subtitle", "time": 2917.87, "timestamp": "00:48:37", "text": "紫色也是我的菜，没错。"}, {"type": "subtitle", "time": 2922.19, "timestamp": "00:48:42", "text": "你好，罗科，你好吗？"}, {"type": "subtitle", "time": 2926.069, "timestamp": "00:48:46", "text": "迪翁，你花钱了"}]
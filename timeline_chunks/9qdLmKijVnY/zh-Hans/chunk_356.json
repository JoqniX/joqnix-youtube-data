[{"type": "subtitle", "time": 21361.708, "timestamp": "05:56:01", "text": "你们所有人都应该遭受战争的蹂躏"}, {"type": "subtitle", "time": 21363.99, "timestamp": "05:56:03", "text": "头槌，谢谢你的辛勤工作"}, {"type": "subtitle", "time": 21367.548, "timestamp": "05:56:07", "text": "还有你今天做的所有事"}, {"type": "subtitle", "time": 21372.31, "timestamp": "05:56:12", "text": "所以要小心，不是每个人都要小心。"}, {"type": "subtitle", "time": 21375.03, "timestamp": "05:56:15", "text": "话虽如此，这只是个玩笑，我拭目以待。"}, {"type": "subtitle", "time": 21380.75, "timestamp": "05:56:20", "text": "星期六和"}, {"type": "subtitle", "time": 21386.868, "timestamp": "05:56:26", "text": "再见"}]
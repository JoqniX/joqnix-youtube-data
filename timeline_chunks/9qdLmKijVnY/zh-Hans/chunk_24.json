[{"type": "subtitle", "time": 1465.789, "timestamp": "00:24:25", "text": "为什么总是从这里开始？"}, {"type": "subtitle", "time": 1468.22, "timestamp": "00:24:28", "text": "一个新的"}, {"type": "subtitle", "time": 1470.909, "timestamp": "00:24:30", "text": "[音乐]"}, {"type": "subtitle", "time": 1473.63, "timestamp": "00:24:33", "text": "我很喜欢，我会回来的，我会怎么做？"}, {"type": "subtitle", "time": 1477.11, "timestamp": "00:24:37", "text": "儿子在打招呼"}, {"type": "subtitle", "time": 1481.63, "timestamp": "00:24:41", "text": "欢迎，嗯，我不会太久的，呃，什么"}, {"type": "subtitle", "time": 1483.029, "timestamp": "00:24:43", "text": "渠道"}, {"type": "subtitle", "time": 1485.789, "timestamp": "00:24:45", "text": "什么是对的，没有错，对吧？我希望如此。"}, {"type": "subtitle", "time": 1487.389, "timestamp": "00:24:47", "text": "它是"}, {"type": "subtitle", "time": 1491.95, "timestamp": "00:24:51", "text": "好吧，总之，大家昨天过得怎么样？"}, {"type": "subtitle", "time": 1495.75, "timestamp": "00:24:55", "text": "我们玩了……嗯……我老是忘了是什么游戏。"}, {"type": "subtitle", "time": 1497.63, "timestamp": "00:24:57", "text": "那是我玩的游戏的名字。"}, {"type": "subtitle", "time": 1499.909, "timestamp": "00:24:59", "text": "昨天"}]
[{"type": "subtitle", "time": 300.11, "timestamp": "00:05:00", "text": "早起是因为我想调整睡眠。"}, {"type": "subtitle", "time": 302.629, "timestamp": "00:05:02", "text": "我觉得这样做不对，这样不好。"}, {"type": "subtitle", "time": 304.99, "timestamp": "00:05:04", "text": "我呃"}, {"type": "subtitle", "time": 309.43, "timestamp": "00:05:09", "text": "对我来说，五点睡觉不好。"}, {"type": "subtitle", "time": 312.749, "timestamp": "00:05:12", "text": "早上，不，是"}, {"type": "subtitle", "time": 316.07, "timestamp": "00:05:16", "text": "糟糕，我需要调整一下我的Escape行程安排。"}, {"type": "subtitle", "time": 320.51, "timestamp": "00:05:20", "text": "是的，我明天会把它修好的。"}, {"type": "subtitle", "time": 323.67, "timestamp": "00:05:23", "text": "也很期待今晚。"}, {"type": "subtitle", "time": 328.35, "timestamp": "00:05:28", "text": "早睡，嗯，12点之前我会睡。"}, {"type": "subtitle", "time": 334.11, "timestamp": "00:05:34", "text": "希望你吃得开心，耶！你好，培根！"}, {"type": "subtitle", "time": 336.629, "timestamp": "00:05:36", "text": "欢迎来到直播间，已经一个月了。"}, {"type": "chat", "time": 337.364, "timestamp": "00:05:37", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "why do i feel like everything is so quick day by day, but during the day, its just so slow"}, {"type": "subtitle", "time": 339.59000000000003, "timestamp": "00:05:39", "text": "是的，已经一个月了。"}, {"type": "subtitle", "time": 343.43, "timestamp": "00:05:43", "text": "已经过去一个月了，明天就满一个月了。"}, {"type": "subtitle", "time": 348.629, "timestamp": "00:05:48", "text": "三月，为什么我觉得一切都……"}, {"type": "subtitle", "time": 351.43, "timestamp": "00:05:51", "text": "时间过得真快，一天比一天快，但在这段时间里"}, {"type": "subtitle", "time": 353.469, "timestamp": "00:05:53", "text": "一天好慢啊"}, {"type": "subtitle", "time": 357.30899999999997, "timestamp": "00:05:57", "text": "是的，确实如此。"}]
[{"type": "subtitle", "time": 22623.468, "timestamp": "06:17:03", "text": "缓解疼痛，没关系，嗯，让"}, {"type": "subtitle", "time": 22629.868, "timestamp": "06:17:09", "text": "进入游戏，你想玩吗？"}, {"type": "subtitle", "time": 22634.468, "timestamp": "06:17:14", "text": "现在我准备好了，当你……"}, {"type": "subtitle", "time": 22638.67, "timestamp": "06:17:18", "text": "准备好了，我可能想做个啊，上帝，哦，上帝"}, {"type": "subtitle", "time": 22642.91, "timestamp": "06:17:22", "text": "手表手表手表监控，我做了一个"}, {"type": "subtitle", "time": 22645.15, "timestamp": "06:17:25", "text": "一点点缓冲，我就会"}, {"type": "subtitle", "time": 22648.468, "timestamp": "06:17:28", "text": "我不会回来，我不会离开，我保证"}, {"type": "subtitle", "time": 22649.868, "timestamp": "06:17:29", "text": "好的，就是这样。"}, {"type": "subtitle", "time": 22652.27, "timestamp": "06:17:32", "text": "好的，你也在YouTube上直播吗？"}, {"type": "subtitle", "time": 22655.23, "timestamp": "06:17:35", "text": "当然，每个 YouTube 直播都是"}, {"type": "subtitle", "time": 22657.548, "timestamp": "06:17:37", "text": "即将上线"}, {"type": "subtitle", "time": 22660.948, "timestamp": "06:17:40", "text": "Twitch 和"}, {"type": "subtitle", "time": 22662.83, "timestamp": "06:17:42", "text": "只有和"}, {"type": "subtitle", "time": 22669.23, "timestamp": "06:17:49", "text": "只有，只有，只有嗯，只做嗯，是的"}, {"type": "subtitle", "time": 22671.91, "timestamp": "06:17:51", "text": "Twitch上的工作直播不会是呃"}, {"type": "subtitle", "time": 22675.11, "timestamp": "06:17:55", "text": "与 YouTube 相关的"}, {"type": "subtitle", "time": 22678.15, "timestamp": "06:17:58", "text": "以我本可以做到的方式，但我没有。"}]
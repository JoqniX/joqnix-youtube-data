[{"type": "subtitle", "time": 14523.11, "timestamp": "04:02:03", "text": "犯了个错，但那也算不错。"}, {"type": "subtitle", "time": 14526.55, "timestamp": "04:02:06", "text": "比赛我没看到他们结束了"}, {"type": "subtitle", "time": 14529.429, "timestamp": "04:02:09", "text": "哦，对，那就是"}, {"type": "subtitle", "time": 14531.79, "timestamp": "04:02:11", "text": "很近，就是这样。"}, {"type": "subtitle", "time": 14535.67, "timestamp": "04:02:15", "text": "有趣且欢迎回归的杂志"}, {"type": "subtitle", "time": 14545.429, "timestamp": "04:02:25", "text": "向上"}, {"type": "subtitle", "time": 14548.87, "timestamp": "04:02:28", "text": "等等，在我们开始之前，让我先说一下"}, {"type": "subtitle", "time": 14552.87, "timestamp": "04:02:32", "text": "请检查我的观点是什么。"}, {"type": "subtitle", "time": 14555.83, "timestamp": "04:02:35", "text": "我该和谁说话，才能和谁说话？"}, {"type": "subtitle", "time": 14559.469, "timestamp": "04:02:39", "text": "队友之类的，为什么"}, {"type": "subtitle", "time": 14563.59, "timestamp": "04:02:43", "text": "没错，我该用你做什么呢，罗尼克？"}, {"type": "subtitle", "time": 14565.79, "timestamp": "04:02:45", "text": "不，我不是职业选手，我曾经是。"}]
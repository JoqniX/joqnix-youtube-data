[{"type": "subtitle", "time": 16202.95, "timestamp": "04:30:02", "text": "乔克等"}, {"type": "subtitle", "time": 16207.75, "timestamp": "04:30:07", "text": "notaki 呃，刚才的问候语是什么来着？"}, {"type": "subtitle", "time": 16208.87, "timestamp": "04:30:08", "text": "我为"}, {"type": "subtitle", "time": 16212.87, "timestamp": "04:30:12", "text": "godak 正在阅读"}, {"type": "subtitle", "time": 16214.87, "timestamp": "04:30:14", "text": "哦，对，我们说到绿色环保的事儿了。"}, {"type": "subtitle", "time": 16217.309, "timestamp": "04:30:17", "text": "我们也应该向自己问好。"}, {"type": "subtitle", "time": 16221.71, "timestamp": "04:30:21", "text": "在我的直播中，我总是说“y Halo”。"}, {"type": "subtitle", "time": 16223.67, "timestamp": "04:30:23", "text": "对，所以我们应该"}, {"type": "subtitle", "time": 16230.469, "timestamp": "04:30:30", "text": "如果像 OHA 那样是早上的话"}, {"type": "subtitle", "time": 16233.149, "timestamp": "04:30:33", "text": "类似 Jo 或者我用的 OHA 之类的"}, {"type": "subtitle", "time": 16237.269, "timestamp": "04:30:37", "text": "Jo在推特上，但我没有"}, {"type": "subtitle", "time": 16239.91, "timestamp": "04:30:39", "text": "知道"}, {"type": "subtitle", "time": 16246.229, "timestamp": "04:30:46", "text": "或者类似“我不”之类的话"}, {"type": "subtitle", "time": 16250.189, "timestamp": "04:30:50", "text": "是的，你的问候方式是怎样的？"}, {"type": "subtitle", "time": 16256.109, "timestamp": "04:30:56", "text": "是的，我总是说“你好”，呃，很多次。"}, {"type": "subtitle", "time": 16259.83, "timestamp": "04:30:59", "text": "我总是会说“你好”，然后我"}]
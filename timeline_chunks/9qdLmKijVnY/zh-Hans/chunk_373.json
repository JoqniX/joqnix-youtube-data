[{"type": "subtitle", "time": 22380.708, "timestamp": "06:13:00", "text": "椅子，我们走吧，你管它叫什么？"}, {"type": "subtitle", "time": 22383.868, "timestamp": "06:13:03", "text": "天哪，我现在需要一把更大的椅子了，怎么办？"}, {"type": "subtitle", "time": 22385.468, "timestamp": "06:13:05", "text": "你打算怎么过万圣节？我没打算。"}, {"type": "subtitle", "time": 22388.708, "timestamp": "06:13:08", "text": "其实我对此一无所知。"}, {"type": "subtitle", "time": 22391.07, "timestamp": "06:13:11", "text": "这样做确实不错。"}, {"type": "subtitle", "time": 22393.83, "timestamp": "06:13:13", "text": "不过有个问题，哦，天哪，我真想这么做。"}, {"type": "subtitle", "time": 22398.27, "timestamp": "06:13:18", "text": "恐怖直播，但是呃，因为我的"}, {"type": "subtitle", "time": 22401.59, "timestamp": "06:13:21", "text": "在这种情况下，我大多时候都无能为力。"}, {"type": "subtitle", "time": 22405.03, "timestamp": "06:13:25", "text": "我相信今年尤其如此，哦，对了"}, {"type": "subtitle", "time": 22407.948, "timestamp": "06:13:27", "text": "如果你们有任何问题，请尽管问。"}, {"type": "subtitle", "time": 22411.67, "timestamp": "06:13:31", "text": "我还没怎么拍过恐怖片呢。"}, {"type": "subtitle", "time": 22416.51, "timestamp": "06:13:36", "text": "还没 还没 等等 没有腿"}, {"type": "subtitle", "time": 22418.39, "timestamp": "06:13:38", "text": "我打算在这个模型上做更多的事情。"}, {"type": "subtitle", "time": 22422.35, "timestamp": "06:13:42", "text": "所以，这只是1.0版本，可以吗？"}, {"type": "subtitle", "time": 22425.99, "timestamp": "06:13:45", "text": "所以我要加入无腿帮，我是"}, {"type": "subtitle", "time": 22428.31, "timestamp": "06:13:48", "text": "我要把这个模型打包带走"}, {"type": "subtitle", "time": 22432.31, "timestamp": "06:13:52", "text": "我的天哪，我要再给它更多！"}, {"type": "subtitle", "time": 22435.83, "timestamp": "06:13:55", "text": "像杰克一样没腿，没错，没腿帮，我们走吧"}, {"type": "subtitle", "time": 22439.11, "timestamp": "06:13:59", "text": "加油，腿帮！我的天啊，杰克说"}]
[{"type": "subtitle", "time": 23041.27, "timestamp": "06:24:01", "text": "继续做德语直播，我祝他一切顺利"}, {"type": "subtitle", "time": 23045.15, "timestamp": "06:24:05", "text": "在他人生旅程中最棒的一段，我真高兴。"}, {"type": "subtitle", "time": 23048.03, "timestamp": "06:24:08", "text": "你问得真好。"}, {"type": "subtitle", "time": 23051.83, "timestamp": "06:24:11", "text": "是的，我喜欢上帝，我提交了很多文件。"}, {"type": "subtitle", "time": 23053.948, "timestamp": "06:24:13", "text": "不知道，之后我就……"}, {"type": "subtitle", "time": 23056.19, "timestamp": "06:24:16", "text": "暂停直播一小会儿"}, {"type": "subtitle", "time": 23058.67, "timestamp": "06:24:18", "text": "稍等片刻，我稍后回来。"}, {"type": "subtitle", "time": 23061.628, "timestamp": "06:24:21", "text": "你们几个带着一些基因，我们打算……"}, {"type": "subtitle", "time": 23064.75, "timestamp": "06:24:24", "text": "我觉得好像有什么吉宁动作正在进行。"}, {"type": "subtitle", "time": 23066.468, "timestamp": "06:24:26", "text": "我仍然会继续使用我以前的PGS和"}, {"type": "subtitle", "time": 23068.11, "timestamp": "06:24:28", "text": "因为你知道这很容易。"}, {"type": "subtitle", "time": 23070.19, "timestamp": "06:24:30", "text": "我必须做，我不得不摆弄一下"}, {"type": "subtitle", "time": 23072.27, "timestamp": "06:24:32", "text": "在那之后的一段时间里，我一直在富士科技工作。"}, {"type": "subtitle", "time": 23074.43, "timestamp": "06:24:34", "text": "我打算等等，看他还没做。"}, {"type": "subtitle", "time": 23077.43, "timestamp": "06:24:37", "text": "30分钟前就让他做了，我的天哪"}, {"type": "subtitle", "time": 23082.59, "timestamp": "06:24:42", "text": "上帝，请给我一个大大的V，好吗？你想要一个V吗？"}, {"type": "subtitle", "time": 23092.788, "timestamp": "06:24:52", "text": "你们是最棒的！"}]
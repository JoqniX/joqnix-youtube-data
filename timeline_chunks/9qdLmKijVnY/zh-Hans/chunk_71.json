[{"type": "subtitle", "time": 4262.91, "timestamp": "01:11:02", "text": "画家们所做的就是……有"}, {"type": "subtitle", "time": 4265.43, "timestamp": "01:11:05", "text": "某种叫做引物或C的东西"}, {"type": "subtitle", "time": 4267.669, "timestamp": "01:11:07", "text": "底漆或者其他什么东西，就是涂层"}, {"type": "subtitle", "time": 4270.35, "timestamp": "01:11:10", "text": "在添加颜料之前先添加，这样它们"}, {"type": "subtitle", "time": 4272.229, "timestamp": "01:11:12", "text": "他们当时正在做这件事，所以我就看着他们。"}, {"type": "subtitle", "time": 4273.59, "timestamp": "01:11:13", "text": "做"}, {"type": "subtitle", "time": 4300.43, "timestamp": "01:11:40", "text": "不，哦等等，我要被困住了"}, {"type": "subtitle", "time": 4307.03, "timestamp": "01:11:47", "text": "上帝啊，没关系，我没注意"}]
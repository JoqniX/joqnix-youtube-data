[{"type": "subtitle", "time": 18242.47, "timestamp": "05:04:02", "text": "今天以9点9分结束"}, {"type": "subtitle", "time": 18263.948, "timestamp": "05:04:23", "text": "今天，我早上6:30就醒了。"}, {"type": "subtitle", "time": 18266.43, "timestamp": "05:04:26", "text": "打开电脑然后睡觉"}, {"type": "subtitle", "time": 18269.548, "timestamp": "05:04:29", "text": "哦，对啊，祖克，你还得问？"}, {"type": "subtitle", "time": 18272.23, "timestamp": "05:04:32", "text": "刚才对吧，呃，我做得怎么样？"}, {"type": "subtitle", "time": 18276.11, "timestamp": "05:04:36", "text": "我今天睡得怎么样？呃，我不知道。"}, {"type": "subtitle", "time": 18277.948, "timestamp": "05:04:37", "text": "最近我一直有这种情况"}, {"type": "subtitle", "time": 18285.708, "timestamp": "05:04:45", "text": "今天就像昨天一样"}, {"type": "subtitle", "time": 18289.31, "timestamp": "05:04:49", "text": "嗯，我的电脑，嗯，我的手机也放在里面"}, {"type": "subtitle", "time": 18290.49, "timestamp": "05:04:50", "text": "另一个房间和"}, {"type": "subtitle", "time": 18291.788, "timestamp": "05:04:51", "text": "[音乐]"}, {"type": "subtitle", "time": 18293.548, "timestamp": "05:04:53", "text": "我"}, {"type": "subtitle", "time": 18298.67, "timestamp": "05:04:58", "text": "嗯，我想我凌晨2点半就睡着了。"}]
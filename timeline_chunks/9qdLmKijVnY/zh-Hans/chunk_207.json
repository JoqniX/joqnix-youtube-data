[{"type": "subtitle", "time": 12424.229, "timestamp": "03:27:04", "text": "还没能从她那里得到表情，但是"}, {"type": "subtitle", "time": 12428.229, "timestamp": "03:27:08", "text": "我们迟早会遇到这种情况。"}, {"type": "subtitle", "time": 12434.99, "timestamp": "03:27:14", "text": "他……我不知道什么时候开始。"}, {"type": "subtitle", "time": 12437.71, "timestamp": "03:27:17", "text": "像专业人士一样画画，你不需要"}, {"type": "subtitle", "time": 12440.95, "timestamp": "03:27:20", "text": "你只需开始像专业人士一样绘画即可"}, {"type": "subtitle", "time": 12443.67, "timestamp": "03:27:23", "text": "实验实验和"}, {"type": "subtitle", "time": 12447.309, "timestamp": "03:27:27", "text": "做些实验，你就会明白的。"}, {"type": "subtitle", "time": 12448.87, "timestamp": "03:27:28", "text": "就是这样。"}, {"type": "subtitle", "time": 12451.75, "timestamp": "03:27:31", "text": "当你开始学习的时候"}, {"type": "subtitle", "time": 12455.87, "timestamp": "03:27:35", "text": "软件程序需要时间才能正确运行。"}, {"type": "subtitle", "time": 12457.67, "timestamp": "03:27:37", "text": "将采取"}, {"type": "subtitle", "time": 12461.03, "timestamp": "03:27:41", "text": "如果你赶时间，那就太赶了。"}, {"type": "subtitle", "time": 12465.229, "timestamp": "03:27:45", "text": "很多情况下，你将无法继续进行。"}, {"type": "subtitle", "time": 12468.59, "timestamp": "03:27:48", "text": "此外，这就是我目前的情况。"}, {"type": "subtitle", "time": 12470.63, "timestamp": "03:27:50", "text": "R 也太匆忙了"}, {"type": "subtitle", "time": 12474.429, "timestamp": "03:27:54", "text": "很多事情我都做不到。"}, {"type": "subtitle", "time": 12477.309, "timestamp": "03:27:57", "text": "嗯嗯，是的，我"}]
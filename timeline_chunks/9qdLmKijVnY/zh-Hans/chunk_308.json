[{"type": "subtitle", "time": 18480.07, "timestamp": "05:08:00", "text": "东西能带来很多成就，比如学习"}, {"type": "subtitle", "time": 18482.868, "timestamp": "05:08:02", "text": "虚幻引擎等等"}, {"type": "subtitle", "time": 18491.35, "timestamp": "05:08:11", "text": "不是说我不知道​​它是不是关闭了。"}, {"type": "subtitle", "time": 18494.15, "timestamp": "05:08:14", "text": "以前我有点懈怠，但现在不是了。"}, {"type": "subtitle", "time": 18497.948, "timestamp": "05:08:17", "text": "操之过急就像我拿走一样"}, {"type": "subtitle", "time": 18505.548, "timestamp": "05:08:25", "text": "时间，还有那种高中生活"}, {"type": "subtitle", "time": 18508.948, "timestamp": "05:08:28", "text": "晚上或者类似的时候，啊"}, {"type": "subtitle", "time": 18510.99, "timestamp": "05:08:30", "text": "我做不到，我做不到"}, {"type": "subtitle", "time": 18514.628, "timestamp": "05:08:34", "text": "哦，我今天还有这项工作要做。"}, {"type": "subtitle", "time": 18517.43, "timestamp": "05:08:37", "text": "现在还有未完成的事情要做"}, {"type": "subtitle", "time": 18520.11, "timestamp": "05:08:40", "text": "一切"}, {"type": "subtitle", "time": 18522.628, "timestamp": "05:08:42", "text": "所有这些"}, {"type": "subtitle", "time": 18532.67, "timestamp": "05:08:52", "text": "对，差不多就是这样。"}, {"type": "subtitle", "time": 18539.628, "timestamp": "05:08:59", "text": "当我"}]
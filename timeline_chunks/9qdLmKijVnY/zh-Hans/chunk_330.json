[{"type": "subtitle", "time": 19801.75, "timestamp": "05:30:01", "text": "观看 Heth 是"}, {"type": "subtitle", "time": 19809.868, "timestamp": "05:30:09", "text": "重要的是，玩起来很有趣。"}, {"type": "subtitle", "time": 19812.83, "timestamp": "05:30:12", "text": "也和你一起玩"}, {"type": "subtitle", "time": 19815.39, "timestamp": "05:30:15", "text": "我会加入，呃，我会在视频会议里，所以请加入。"}, {"type": "subtitle", "time": 19818.15, "timestamp": "05:30:18", "text": "当你结束直播后，他没有"}, {"type": "subtitle", "time": 19820.868, "timestamp": "05:30:20", "text": "我的呃游戏"}, {"type": "subtitle", "time": 19823.47, "timestamp": "05:30:23", "text": "你知道我接下来要讲的那个笑话，我会去练习。"}, {"type": "subtitle", "time": 19826.43, "timestamp": "05:30:26", "text": "我的a和只是"}, {"type": "subtitle", "time": 19830.39, "timestamp": "05:30:30", "text": "呃，我还错过了什么？我抓到你了。"}, {"type": "subtitle", "time": 19831.708, "timestamp": "05:30:31", "text": "向上"}, {"type": "subtitle", "time": 19838.31, "timestamp": "05:30:38", "text": "聊天，但这也是学习"}, {"type": "subtitle", "time": 19841.628, "timestamp": "05:30:41", "text": "现在的体验也是一种学习"}, {"type": "subtitle", "time": 19844.548, "timestamp": "05:30:44", "text": "体验到那种感觉，尤其是在它"}, {"type": "subtitle", "time": 19847.868, "timestamp": "05:30:47", "text": "来到游戏直播需要的游戏"}, {"type": "subtitle", "time": 19850.548, "timestamp": "05:30:50", "text": "你有时太专注，以至于难以阅读。"}, {"type": "subtitle", "time": 19858.15, "timestamp": "05:30:58", "text": "聊天记录……呃，虽然我得看看聊天记录，但是"}]
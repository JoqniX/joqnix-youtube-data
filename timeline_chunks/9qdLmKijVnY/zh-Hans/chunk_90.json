[{"type": "subtitle", "time": 5415.109, "timestamp": "01:30:15", "text": "好吧，我得先度过那段艰难时期。"}, {"type": "subtitle", "time": 5417.83, "timestamp": "01:30:17", "text": "Havoc真的很好，是的，他们改变了"}, {"type": "subtitle", "time": 5420.59, "timestamp": "01:30:20", "text": "现在他们更加虔诚了，他们把事情做得更紧密了。"}, {"type": "subtitle", "time": 5422.87, "timestamp": "01:30:22", "text": "现在当你拿着它的时候，它就变成了"}, {"type": "subtitle", "time": 5425.91, "timestamp": "01:30:25", "text": "十字线会从这样的扩散状态变为"}, {"type": "subtitle", "time": 5427.83, "timestamp": "01:30:27", "text": "真的"}, {"type": "subtitle", "time": 5430.149, "timestamp": "01:30:30", "text": "那真是一记漂亮的射击"}]
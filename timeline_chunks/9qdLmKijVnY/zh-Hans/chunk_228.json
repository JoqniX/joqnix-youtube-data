[{"type": "subtitle", "time": 13681.149, "timestamp": "03:48:01", "text": "他们战争温暖"}, {"type": "subtitle", "time": 13687.189, "timestamp": "03:48:07", "text": "等等，哦，发错聊天记录了。"}, {"type": "subtitle", "time": 13690.71, "timestamp": "03:48:10", "text": "等等，头垫？嗯，我是新来的，所以"}, {"type": "subtitle", "time": 13711.309, "timestamp": "03:48:31", "text": "聊天"}, {"type": "subtitle", "time": 13716.03, "timestamp": "03:48:36", "text": "呃，背景音乐是​​可以听见的，好像有个s。"}, {"type": "subtitle", "time": 13724.309, "timestamp": "03:48:44", "text": "东西，嗯，我不会保留沙子我们"}, {"type": "subtitle", "time": 13730.309, "timestamp": "03:48:50", "text": "[音乐]"}, {"type": "subtitle", "time": 13732.87, "timestamp": "03:48:52", "text": "我这就邀请你"}, {"type": "subtitle", "time": 13738.11, "timestamp": "03:48:58", "text": "他们呃，我们去上体育课吧。"}]
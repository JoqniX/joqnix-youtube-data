[{"type": "subtitle", "time": 10620.71, "timestamp": "02:57:00", "text": "这是第10000次尝试，也是第一次尝试。"}, {"type": "subtitle", "time": 10622.71, "timestamp": "02:57:02", "text": "您可以选择"}, {"type": "subtitle", "time": 10625.67, "timestamp": "02:57:05", "text": "你出现的方式各不相同。"}, {"type": "subtitle", "time": 10628.75, "timestamp": "02:57:08", "text": "你自己"}, {"type": "subtitle", "time": 10633.349, "timestamp": "02:57:13", "text": "我们的错误并非枷锁，它们"}, {"type": "subtitle", "time": 10637.67, "timestamp": "02:57:17", "text": "教训是，它们不是永久状态，但"}, {"type": "subtitle", "time": 10639.19, "timestamp": "02:57:19", "text": "暂时的"}, {"type": "subtitle", "time": 10642.5, "timestamp": "02:57:22", "text": "我们经过的L风景"}, {"type": "subtitle", "time": 10644.229, "timestamp": "02:57:24", "text": "[音乐]"}, {"type": "subtitle", "time": 10647.79, "timestamp": "02:57:27", "text": "致所有曾经有过这种感觉的人"}, {"type": "subtitle", "time": 10649.19, "timestamp": "02:57:29", "text": "他们是"}, {"type": "subtitle", "time": 10652.63, "timestamp": "02:57:32", "text": "你的光芒已然陨落"}, {"type": "subtitle", "time": 10655.99, "timestamp": "02:57:35", "text": "你的道路并非一帆风顺"}, {"type": "subtitle", "time": 10666.19, "timestamp": "02:57:46", "text": "你星星的每一片碎片都写满了它们"}, {"type": "subtitle", "time": 10668.91, "timestamp": "02:57:48", "text": "潜在的"}, {"type": "subtitle", "time": 10673.07, "timestamp": "02:57:53", "text": "每一块破碎的碎片都能反映出什么。"}, {"type": "subtitle", "time": 10678.389, "timestamp": "02:57:58", "text": "每一刻都是一次机会"}]
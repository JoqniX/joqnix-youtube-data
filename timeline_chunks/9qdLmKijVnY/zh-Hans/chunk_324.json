[{"type": "subtitle", "time": 19441.43, "timestamp": "05:24:01", "text": "还有周六的直播，哦哦，我忘了……"}, {"type": "subtitle", "time": 19443.51, "timestamp": "05:24:03", "text": "把这个告诉所有人，所以，呃，对于那些"}, {"type": "subtitle", "time": 19446.51, "timestamp": "05:24:06", "text": "不知道的人，我想参与其中"}, {"type": "subtitle", "time": 19451.03, "timestamp": "05:24:11", "text": "在 genin um 主播活动中，所以我"}, {"type": "subtitle", "time": 19454.548, "timestamp": "05:24:14", "text": "昨天（8号）收到一封邮件"}, {"type": "subtitle", "time": 19458.31, "timestamp": "05:24:18", "text": "虽然我是9月2日申请的，但实际上是9月2日。"}, {"type": "subtitle", "time": 19460.91, "timestamp": "05:24:20", "text": "九月份，也就是事件发生的时候"}, {"type": "subtitle", "time": 19464.51, "timestamp": "05:24:24", "text": "宣布之后，我收到了邮件，所以……"}, {"type": "subtitle", "time": 19465.628, "timestamp": "05:24:25", "text": "就目前而言"}, {"type": "subtitle", "time": 19469.39, "timestamp": "05:24:29", "text": "电子邮件呃，甚至像我应该是"}, {"type": "subtitle", "time": 19470.75, "timestamp": "05:24:30", "text": "流媒体"}, {"type": "subtitle", "time": 19475.35, "timestamp": "05:24:35", "text": "genin uh 从 uh 9 月 8 日开始 等 uh"}, {"type": "subtitle", "time": 19479.15, "timestamp": "05:24:39", "text": "从9月2日至8日"}, {"type": "subtitle", "time": 19481.15, "timestamp": "05:24:41", "text": "直到呃"}, {"type": "subtitle", "time": 19483.39, "timestamp": "05:24:43", "text": "20"}, {"type": "subtitle", "time": 19487.51, "timestamp": "05:24:47", "text": "21号 20号 等等，让我再确认一下"}, {"type": "subtitle", "time": 19497.548, "timestamp": "05:24:57", "text": "等等等等等等，什么时候？"}]
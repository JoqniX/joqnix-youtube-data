[{"type": "subtitle", "time": 9485.79, "timestamp": "02:38:05", "text": "看来要弄到这么多东西很难。"}, {"type": "subtitle", "time": 9488.59, "timestamp": "02:38:08", "text": "杀戮，所以我看到的是我可以……"}, {"type": "subtitle", "time": 9491.67, "timestamp": "02:38:11", "text": "至少要拿到两个人头我才行"}, {"type": "subtitle", "time": 9494.71, "timestamp": "02:38:14", "text": "玩玩或者做点别的，习惯一下。"}, {"type": "subtitle", "time": 9497.429, "timestamp": "02:38:17", "text": "机械和"}, {"type": "subtitle", "time": 9528.23, "timestamp": "02:38:48", "text": "我的天，他把我耍得团团转，他真的耍了我。"}]
[{"type": "subtitle", "time": 13021.75, "timestamp": "03:37:01", "text": "请原谅我，我会保留你的"}, {"type": "subtitle", "time": 13024.71, "timestamp": "03:37:04", "text": "我给你口交，不然你就拿走这个"}, {"type": "subtitle", "time": 13032.189, "timestamp": "03:37:12", "text": "也"}, {"type": "subtitle", "time": 13036.349, "timestamp": "03:37:16", "text": "巴克巴克，你只有一次机会。"}, {"type": "subtitle", "time": 13038.83, "timestamp": "03:37:18", "text": "你说你有一个是什么意思？"}, {"type": "subtitle", "time": 13046.11, "timestamp": "03:37:26", "text": "意思是我想成为一名"}, {"type": "subtitle", "time": 13048.67, "timestamp": "03:37:28", "text": "[音乐]"}, {"type": "subtitle", "time": 13051.75, "timestamp": "03:37:31", "text": "三角形，呃，你有，呃，你有"}, {"type": "subtitle", "time": 13055.03, "timestamp": "03:37:35", "text": "耐力观察者"}, {"type": "subtitle", "time": 13057.71, "timestamp": "03:37:37", "text": "虽然要用模组，但还是要照顾好自己。"}, {"type": "subtitle", "time": 13059.63, "timestamp": "03:37:39", "text": "不能忍受看着我你"}, {"type": "subtitle", "time": 13062.309, "timestamp": "03:37:42", "text": "我不需要耐力手表，所以我……"}, {"type": "subtitle", "time": 13066.03, "timestamp": "03:37:46", "text": "实际上，我看到了很多这样的例子。"}, {"type": "subtitle", "time": 13068.71, "timestamp": "03:37:48", "text": "我见过很多次这种情况。"}, {"type": "subtitle", "time": 13072.229, "timestamp": "03:37:52", "text": "是的，我见过那个。"}, {"type": "subtitle", "time": 13075.429, "timestamp": "03:37:55", "text": "很多人要照顾好自己。"}, {"type": "subtitle", "time": 13077.51, "timestamp": "03:37:57", "text": "你自己别老盯着我看。"}]
[{"type": "subtitle", "time": 22863.51, "timestamp": "06:21:03", "text": "我知道我不会被排除在外，他​​也是。"}, {"type": "subtitle", "time": 22865.99, "timestamp": "06:21:05", "text": "有点跟上我了"}, {"type": "subtitle", "time": 22868.51, "timestamp": "06:21:08", "text": "他就像一个现场模特一样，"}, {"type": "subtitle", "time": 22871.948, "timestamp": "06:21:11", "text": "另外，我也有一个类似的真人模特。"}, {"type": "subtitle", "time": 22875.708, "timestamp": "06:21:15", "text": "未来我们也希望拥有"}, {"type": "subtitle", "time": 22877.948, "timestamp": "06:21:17", "text": "我们双方的模型都在的合作项目中"}, {"type": "subtitle", "time": 22880.628, "timestamp": "06:21:20", "text": "屏幕和移动将会如此"}, {"type": "subtitle", "time": 22883.43, "timestamp": "06:21:23", "text": "太棒了，我们可以做很多很酷很有趣的事情。"}, {"type": "subtitle", "time": 22886.708, "timestamp": "06:21:26", "text": "他们之间的互动真是太可爱了"}, {"type": "subtitle", "time": 22889.708, "timestamp": "06:21:29", "text": "经常玩"}, {"type": "subtitle", "time": 22892.35, "timestamp": "06:21:32", "text": "呃，他是那种朋友，你"}, {"type": "subtitle", "time": 22894.27, "timestamp": "06:21:34", "text": "谁随时支持你？嗯，算是吧。"}, {"type": "subtitle", "time": 22896.11, "timestamp": "06:21:36", "text": "就像我"}, {"type": "subtitle", "time": 22899.948, "timestamp": "06:21:39", "text": "说实话，我真的很惊讶。"}, {"type": "subtitle", "time": 22902.19, "timestamp": "06:21:42", "text": "我从没想过会有这样的事情发生。"}, {"type": "subtitle", "time": 22904.91, "timestamp": "06:21:44", "text": "有人会和我合作吗？"}, {"type": "subtitle", "time": 22908.23, "timestamp": "06:21:48", "text": "很多，但和很多人聊天，是的，玩"}, {"type": "subtitle", "time": 22910.67, "timestamp": "06:21:50", "text": "玩游戏，放松一下，尽情享受吧！"}, {"type": "subtitle", "time": 22912.27, "timestamp": "06:21:52", "text": "第一人称射击游戏"}, {"type": "subtitle", "time": 22915.03, "timestamp": "06:21:55", "text": "中世纪游戏"}, {"type": "subtitle", "time": 22917.83, "timestamp": "06:21:57", "text": "中世纪风格，你永远不知道我有多喜欢它们"}]
[{"type": "subtitle", "time": 21181.83, "timestamp": "05:53:01", "text": "明白了，我会换成哦"}, {"type": "subtitle", "time": 21183.788, "timestamp": "05:53:03", "text": "等等，我"}, {"type": "subtitle", "time": 21187.948, "timestamp": "05:53:07", "text": "天哪，我怎么能忘记这件事呢？"}, {"type": "subtitle", "time": 21190.59, "timestamp": "05:53:10", "text": "显然，当我还是……的时候"}, {"type": "subtitle", "time": 21192.788, "timestamp": "05:53:12", "text": "我当时玩游戏的时候应该……"}, {"type": "subtitle", "time": 21195.75, "timestamp": "05:53:15", "text": "切换到这种动态照明"}, {"type": "subtitle", "time": 21197.948, "timestamp": "05:53:17", "text": "我那玩意儿"}, {"type": "subtitle", "time": 21203.11, "timestamp": "05:53:23", "text": "我忘了，我真的忘了做"}, {"type": "subtitle", "time": 21206.31, "timestamp": "05:53:26", "text": "我本来应该改的。"}, {"type": "subtitle", "time": 21209.67, "timestamp": "05:53:29", "text": "动态照明"}, {"type": "subtitle", "time": 21213.19, "timestamp": "05:53:33", "text": "就像我打开任何东西时，如果……"}, {"type": "subtitle", "time": 21216.03, "timestamp": "05:53:36", "text": "游戏中，当我开火或看到所有场景时"}, {"type": "subtitle", "time": 21217.83, "timestamp": "05:53:37", "text": "颜色 CH 这是我的背景"}, {"type": "subtitle", "time": 21220.788, "timestamp": "05:53:40", "text": "实际上，蓝色背景"}, {"type": "subtitle", "time": 21223.35, "timestamp": "05:53:43", "text": "我忘了星座，下一个直播我"}, {"type": "subtitle", "time": 21225.11, "timestamp": "05:53:45", "text": "不会忘记"}, {"type": "subtitle", "time": 21227.43, "timestamp": "05:53:47", "text": "好的"}, {"type": "subtitle", "time": 21230.23, "timestamp": "05:53:50", "text": "耶耶，新的照明滤镜"}, {"type": "subtitle", "time": 21232.07, "timestamp": "05:53:52", "text": "嗯，那玩意儿。"}, {"type": "subtitle", "time": 21235.948, "timestamp": "05:53:55", "text": "对，我们会像这样进行一些实验。"}, {"type": "subtitle", "time": 21239.23, "timestamp": "05:53:59", "text": "并创造出属于我们自己的独特事物"}]
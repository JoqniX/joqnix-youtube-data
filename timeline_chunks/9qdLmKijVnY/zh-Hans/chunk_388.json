[{"type": "subtitle", "time": 23283.59, "timestamp": "06:28:03", "text": "你太可爱了，我好难过，我好难过，我好难过"}, {"type": "subtitle", "time": 23285.99, "timestamp": "06:28:05", "text": "可爱就好，别叫我"}, {"type": "subtitle", "time": 23290.07, "timestamp": "06:28:10", "text": "天气热，我会像这样过敏。"}, {"type": "subtitle", "time": 23291.83, "timestamp": "06:28:11", "text": "有这种过敏症？好吧，不要"}, {"type": "subtitle", "time": 23293.31, "timestamp": "06:28:13", "text": "别说"}, {"type": "subtitle", "time": 23296.628, "timestamp": "06:28:16", "text": "这就是她给我这个的原因。"}, {"type": "subtitle", "time": 23307.07, "timestamp": "06:28:27", "text": "我知道这个地方，是的，那是什么？"}, {"type": "subtitle", "time": 23311.03, "timestamp": "06:28:31", "text": "是的，我知道我自己，为什么我是什么？"}, {"type": "subtitle", "time": 23312.27, "timestamp": "06:28:32", "text": "我从没想过要说他们的语言。"}, {"type": "subtitle", "time": 23317.43, "timestamp": "06:28:37", "text": "我在……中看到了"}, {"type": "subtitle", "time": 23324.91, "timestamp": "06:28:44", "text": "年轻的哦，这是一个，这是"}, {"type": "subtitle", "time": 23329.708, "timestamp": "06:28:49", "text": "一个国家，好吧好吧，我很高兴"}, {"type": "subtitle", "time": 23334.19, "timestamp": "06:28:54", "text": "因为我的屏幕太硬了"}, {"type": "subtitle", "time": 23339.31, "timestamp": "06:28:59", "text": "燃烧的嗨嗨去"}]
[{"type": "subtitle", "time": 11281.55, "timestamp": "03:08:01", "text": "那"}, {"type": "subtitle", "time": 11285.79, "timestamp": "03:08:05", "text": "因为 talkx 对很多人来说意义重大"}, {"type": "subtitle", "time": 11289.11, "timestamp": "03:08:09", "text": "我喜欢它"}, {"type": "subtitle", "time": 11292.19, "timestamp": "03:08:12", "text": "它包含了我的许多梦境"}, {"type": "subtitle", "time": 11296.03, "timestamp": "03:08:16", "text": "我放弃了，但我渴望成功。"}, {"type": "subtitle", "time": 11298.03, "timestamp": "03:08:18", "text": "这段旅程意义非凡。"}, {"type": "subtitle", "time": 11300.389, "timestamp": "03:08:20", "text": "这不仅仅是一个虚拟角色，这不仅仅是"}, {"type": "subtitle", "time": 11305.79, "timestamp": "03:08:25", "text": "一个主播之类的东西，没有CHX，这要复杂得多。"}, {"type": "subtitle", "time": 11316.95, "timestamp": "03:08:36", "text": "至少在2024年的某个时候，我"}, {"type": "subtitle", "time": 11323.15, "timestamp": "03:08:43", "text": "失去希望，或者像迷失方向一样"}, {"type": "subtitle", "time": 11325.15, "timestamp": "03:08:45", "text": "以及我多么希望"}, {"type": "subtitle", "time": 11329.429, "timestamp": "03:08:49", "text": "与乔继续前进"}, {"type": "subtitle", "time": 11333.309, "timestamp": "03:08:53", "text": "因为我对自己当时的工作不满意。"}, {"type": "subtitle", "time": 11334.91, "timestamp": "03:08:54", "text": "我"}, {"type": "subtitle", "time": 11338.67, "timestamp": "03:08:58", "text": "总是做出一些轻率的决定，"}]
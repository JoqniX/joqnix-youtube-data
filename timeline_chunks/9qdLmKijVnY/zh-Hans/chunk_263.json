[{"type": "subtitle", "time": 15783.55, "timestamp": "04:23:03", "text": "动漫，嗯，等等"}, {"type": "subtitle", "time": 15792.83, "timestamp": "04:23:12", "text": "是的，我以前先看动漫。"}, {"type": "subtitle", "time": 15795.07, "timestamp": "04:23:15", "text": "发现并了解了动漫"}, {"type": "subtitle", "time": 15797.83, "timestamp": "04:23:17", "text": "我以前经常在YouTube上看动漫。"}, {"type": "subtitle", "time": 15800.79, "timestamp": "04:23:20", "text": "我以前经常看他们的视频"}, {"type": "subtitle", "time": 15803.229, "timestamp": "04:23:23", "text": "我之前不知道的视频"}, {"type": "subtitle", "time": 15805.83, "timestamp": "04:23:25", "text": "以前是动漫，但现在我"}, {"type": "subtitle", "time": 15809.95, "timestamp": "04:23:29", "text": "后来有一天，我开始知道"}, {"type": "subtitle", "time": 15814.55, "timestamp": "04:23:34", "text": "我也看Twitch主播，所以有一天晚上"}, {"type": "subtitle", "time": 15817.389, "timestamp": "04:23:37", "text": "实际上那是午夜。"}, {"type": "subtitle", "time": 15822.79, "timestamp": "04:23:42", "text": "实际上，我该怎么称呼它呢？"}, {"type": "subtitle", "time": 15826.429, "timestamp": "04:23:46", "text": "开始在 Twitch 上搜索“呃”"}, {"type": "subtitle", "time": 15830.189, "timestamp": "04:23:50", "text": "嗯，订阅并观看了很多。"}, {"type": "subtitle", "time": 15833.99, "timestamp": "04:23:53", "text": "Twitch上的日本主播就是"}, {"type": "subtitle", "time": 15838.63, "timestamp": "04:23:58", "text": "我是如何认识他，又是如何了解到这件事的"}, {"type": "subtitle", "time": 15839.91, "timestamp": "04:23:59", "text": "事物"}]
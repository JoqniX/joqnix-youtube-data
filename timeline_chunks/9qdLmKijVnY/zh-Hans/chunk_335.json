[{"type": "subtitle", "time": 20100.868, "timestamp": "05:35:00", "text": "呃呃，真是个笨蛋，毁了呃一个"}, {"type": "subtitle", "time": 20104.19, "timestamp": "05:35:04", "text": "个人的社交媒体，以及这可能会产生的影响"}, {"type": "subtitle", "time": 20106.548, "timestamp": "05:35:06", "text": "其他人，还有聊天室里的人，"}, {"type": "subtitle", "time": 20109.67, "timestamp": "05:35:09", "text": "大家都感觉很舒服等等。"}, {"type": "subtitle", "time": 20112.15, "timestamp": "05:35:12", "text": "东西可能跟某个人有关。"}, {"type": "subtitle", "time": 20116.43, "timestamp": "05:35:16", "text": "就正常点，嗯，还有。"}, {"type": "subtitle", "time": 20118.548, "timestamp": "05:35:18", "text": "始终可以选择离开直播流。"}, {"type": "subtitle", "time": 20121.03, "timestamp": "05:35:21", "text": "如果你不喜欢你看到的东西，那就对了。"}, {"type": "subtitle", "time": 20124.23, "timestamp": "05:35:24", "text": "取消关注任何类似“取消关注任何事物”之类的东西"}, {"type": "subtitle", "time": 20129.11, "timestamp": "05:35:29", "text": "嗯，别再……别毁了他们。"}, {"type": "subtitle", "time": 20129.99, "timestamp": "05:35:29", "text": "呃"}, {"type": "subtitle", "time": 20132.59, "timestamp": "05:35:32", "text": "令人不舒服的呃评论等等"}, {"type": "subtitle", "time": 20135.47, "timestamp": "05:35:35", "text": "最近发生了很多事情，"}, {"type": "subtitle", "time": 20140.51, "timestamp": "05:35:40", "text": "昨天也发生了，呃，在我以前住的地方。"}, {"type": "subtitle", "time": 20143.03, "timestamp": "05:35:43", "text": "账户"}, {"type": "subtitle", "time": 20145.15, "timestamp": "05:35:45", "text": "是的"}, {"type": "subtitle", "time": 20150.548, "timestamp": "05:35:50", "text": "所以，哦，但是，嗯，所有那些人"}, {"type": "subtitle", "time": 20155.15, "timestamp": "05:35:55", "text": "和我聊天吧，K LOVE 也喜欢它"}]
[{"type": "subtitle", "time": 5164.03, "timestamp": "01:26:04", "text": "哎呀，这游戏真难啊。"}, {"type": "subtitle", "time": 5177.47, "timestamp": "01:26:17", "text": "嗨，艾尔，爱德华怎么样了？希望你一切都好。"}, {"type": "subtitle", "time": 5180.79, "timestamp": "01:26:20", "text": "做得好真的会出很多汗，而且如何"}, {"type": "subtitle", "time": 5183.31, "timestamp": "01:26:23", "text": "我能拿到那20颗炸弹的徽章吗？"}, {"type": "subtitle", "time": 5190.109, "timestamp": "01:26:30", "text": "我只想赢得单人比赛"}, {"type": "subtitle", "time": 5199.149, "timestamp": "01:26:39", "text": "尽力而为，我能做的最好的就是得到一个"}, {"type": "subtitle", "time": 5202.59, "timestamp": "01:26:42", "text": "单人游戏体验，难度较高"}, {"type": "subtitle", "time": 5206.31, "timestamp": "01:26:46", "text": "当然，我们可以玩，所以呃"}, {"type": "subtitle", "time": 5209.27, "timestamp": "01:26:49", "text": "慢点说，这方法还挺管用。"}]
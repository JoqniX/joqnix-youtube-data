[{"type": "subtitle", "time": 11222.83, "timestamp": "03:07:02", "text": "类似镜头或视频之类的东西"}, {"type": "subtitle", "time": 11227.51, "timestamp": "03:07:07", "text": "为了把东西发出去，什么都行，但是"}, {"type": "subtitle", "time": 11233.429, "timestamp": "03:07:13", "text": "我实在下不了决心去做这件事。"}, {"type": "subtitle", "time": 11236.11, "timestamp": "03:07:16", "text": "喜欢"}, {"type": "subtitle", "time": 11242.229, "timestamp": "03:07:22", "text": "接下来还要再谈一次，然后回来"}, {"type": "subtitle", "time": 11244.03, "timestamp": "03:07:24", "text": "它"}, {"type": "subtitle", "time": 11248.269, "timestamp": "03:07:28", "text": "真的很难吗？"}, {"type": "subtitle", "time": 11251.79, "timestamp": "03:07:31", "text": "决定，嗯，是的，那确实是一个"}, {"type": "subtitle", "time": 11254.75, "timestamp": "03:07:34", "text": "艰难的决定"}, {"type": "subtitle", "time": 11258.349, "timestamp": "03:07:38", "text": "因为呃，我不想说，但是……"}, {"type": "subtitle", "time": 11261.229, "timestamp": "03:07:41", "text": "我确实思考过某个时刻"}, {"type": "subtitle", "time": 11263.95, "timestamp": "03:07:43", "text": "它就像停止活动一样"}, {"type": "subtitle", "time": 11271.55, "timestamp": "03:07:51", "text": "嗯，是的"}, {"type": "subtitle", "time": 11276.389, "timestamp": "03:07:56", "text": "但我曾在很多场合说过这句话"}, {"type": "subtitle", "time": 11278.71, "timestamp": "03:07:58", "text": "多年来我一直都这样，我不会"}, {"type": "subtitle", "time": 11279.91, "timestamp": "03:07:59", "text": "曾经这样做过"}]
[{"type": "subtitle", "time": 18121.948, "timestamp": "05:02:01", "text": "呃，找到漏洞并利用它之类的。"}, {"type": "subtitle", "time": 18157.91, "timestamp": "05:02:37", "text": "如果我声音太大，请告诉我。"}, {"type": "subtitle", "time": 18161.67, "timestamp": "05:02:41", "text": "因为我既不是我的"}, {"type": "subtitle", "time": 18165.99, "timestamp": "05:02:45", "text": "麦克风的音质似乎不太好。"}, {"type": "subtitle", "time": 18167.99, "timestamp": "05:02:47", "text": "虽然它很好"}, {"type": "subtitle", "time": 18170.43, "timestamp": "05:02:50", "text": "麦克风虽然不错，但我技术很差。"}, {"type": "subtitle", "time": 18172.708, "timestamp": "05:02:52", "text": "在处理麦克风时，呃，后期处理麦克风"}, {"type": "subtitle", "time": 18174.39, "timestamp": "05:02:54", "text": "和"}]
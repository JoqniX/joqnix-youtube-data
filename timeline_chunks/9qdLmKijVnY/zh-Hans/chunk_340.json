[{"type": "subtitle", "time": 20400.628, "timestamp": "05:40:00", "text": "合作直播或喜欢游戏而不是游戏"}, {"type": "subtitle", "time": 20402.91, "timestamp": "05:40:02", "text": "直播，但当我输掉直播时，合作直播也会进行。"}, {"type": "subtitle", "time": 20407.35, "timestamp": "05:40:07", "text": "聊天的重点就是我能够……的时候"}, {"type": "subtitle", "time": 20409.788, "timestamp": "05:40:09", "text": "她可以"}, {"type": "subtitle", "time": 20414.23, "timestamp": "05:40:14", "text": "哦，是的，但除此之外，我认为"}, {"type": "subtitle", "time": 20416.91, "timestamp": "05:40:16", "text": "呃，如果你不打电话也没关系。"}, {"type": "subtitle", "time": 20420.548, "timestamp": "05:40:20", "text": "够了，别担心，我"}, {"type": "subtitle", "time": 20430.708, "timestamp": "05:40:30", "text": "所以现在有些哈演讲和任何"}, {"type": "subtitle", "time": 20433.948, "timestamp": "05:40:33", "text": "其他类似的东西我都允许。"}, {"type": "subtitle", "time": 20437.548, "timestamp": "05:40:37", "text": "聊天，然后哦哦，对，这个主要的事情"}, {"type": "subtitle", "time": 20441.15, "timestamp": "05:40:41", "text": "是的，别谈论任何创作者或"}, {"type": "subtitle", "time": 20444.75, "timestamp": "05:40:44", "text": "除非我主动提起名字，否则主播不会出现。"}, {"type": "subtitle", "time": 20447.83, "timestamp": "05:40:47", "text": "哦，对，就是这个，对，就是这一切。"}, {"type": "subtitle", "time": 20450.67, "timestamp": "05:40:50", "text": "还有，呃，也不要自我推销。"}, {"type": "subtitle", "time": 20453.548, "timestamp": "05:40:53", "text": "呃，比如如果你有直播之类的，因为"}, {"type": "subtitle", "time": 20456.07, "timestamp": "05:40:56", "text": "呃，如果我知道你的话，我会很喜欢你的。"}, {"type": "subtitle", "time": 20458.31, "timestamp": "05:40:58", "text": "主播，我会特别感谢你的。"}]
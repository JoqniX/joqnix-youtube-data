[{"type": "subtitle", "time": 10503.07, "timestamp": "02:55:03", "text": "星座，而其他星座则是单个的。"}, {"type": "subtitle", "time": 10508.07, "timestamp": "02:55:08", "text": "我们的恒星携带着耀眼的光芒。"}, {"type": "subtitle", "time": 10510.87, "timestamp": "02:55:10", "text": "我们的情绪"}, {"type": "subtitle", "time": 10513.309, "timestamp": "02:55:13", "text": "经历我们非常"}, {"type": "subtitle", "time": 10516.87, "timestamp": "02:55:16", "text": "本质上，有些时刻我们会发现"}, {"type": "subtitle", "time": 10519.55, "timestamp": "02:55:19", "text": "我们自己脚踏实地"}, {"type": "subtitle", "time": 10522.95, "timestamp": "02:55:22", "text": "当我们曾经追逐的光芒似乎只是"}, {"type": "subtitle", "time": 10524.79, "timestamp": "02:55:24", "text": "出局"}, {"type": "subtitle", "time": 10528.75, "timestamp": "02:55:28", "text": "当我们的强度达到重量时，就会达到目标。"}, {"type": "subtitle", "time": 10534.429, "timestamp": "02:55:34", "text": "我们的情感会将我们推向超越自身极限的境界。"}, {"type": "subtitle", "time": 10536.349, "timestamp": "02:55:36", "text": "轨道"}, {"type": "subtitle", "time": 10540.51, "timestamp": "02:55:40", "text": "但关于星星的真相是这样的："}, {"type": "subtitle", "time": 10545.349, "timestamp": "02:55:45", "text": "关于我们，我们永远不会真正消亡。"}, {"type": "subtitle", "time": 10548.87, "timestamp": "02:55:48", "text": "星星就像我们自己的旅程"}, {"type": "subtitle", "time": 10552.59, "timestamp": "02:55:52", "text": "它们并非线性结构，它们可以被打破。"}, {"type": "subtitle", "time": 10556.11, "timestamp": "02:55:56", "text": "昏暗地被推到了边缘"}]
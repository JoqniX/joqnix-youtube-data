[{"type": "subtitle", "time": 4384.709, "timestamp": "01:13:04", "text": "我心中有一个美好的圆圈。"}, {"type": "subtitle", "time": 4386.99, "timestamp": "01:13:06", "text": "所以我是"}, {"type": "subtitle", "time": 4390.149, "timestamp": "01:13:10", "text": "我害怕会有人进来。"}, {"type": "subtitle", "time": 4392.55, "timestamp": "01:13:12", "text": "可能需要打一场仗，那场仗已经打起来了。"}, {"type": "subtitle", "time": 4398.31, "timestamp": "01:13:18", "text": "是的，有人从这里进来过。"}, {"type": "subtitle", "time": 4406.189, "timestamp": "01:13:26", "text": "[掌声]"}, {"type": "subtitle", "time": 4427.59, "timestamp": "01:13:47", "text": "我的天啊，骗他！"}]
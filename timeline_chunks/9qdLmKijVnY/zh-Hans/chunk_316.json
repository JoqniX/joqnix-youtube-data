[{"type": "subtitle", "time": 18963.07, "timestamp": "05:16:03", "text": "我还是嗯嗯嗯，算了，我还是直接结束吧。"}, {"type": "subtitle", "time": 18967.39, "timestamp": "05:16:07", "text": "我需要整理一些东西。"}, {"type": "subtitle", "time": 18975.708, "timestamp": "05:16:15", "text": "所以，那是什么？"}, {"type": "subtitle", "time": 18986.948, "timestamp": "05:16:26", "text": "胸罩，我现在要走了，我得完成它了。"}, {"type": "subtitle", "time": 18989.99, "timestamp": "05:16:29", "text": "我把妈妈的晚餐（早上做的）也吃了。"}, {"type": "subtitle", "time": 18992.31, "timestamp": "05:16:32", "text": "等等，妈妈的晚饭，我不去，我不去"}, {"type": "subtitle", "time": 18993.708, "timestamp": "05:16:33", "text": "能够"}, {"type": "subtitle", "time": 18996.47, "timestamp": "05:16:36", "text": "睡觉"}, {"type": "subtitle", "time": 18999.49, "timestamp": "05:16:39", "text": "嗨，我做了"}, {"type": "subtitle", "time": 19005.75, "timestamp": "05:16:45", "text": "我们享用了一顿丰盛的晚餐，好好享受剩下的时光吧。"}, {"type": "subtitle", "time": 19016.35, "timestamp": "05:16:56", "text": "我应该把声音带回来"}]
[{"type": "subtitle", "time": 6840.589, "timestamp": "01:54:00", "text": "现在喝汤，然后做"}, {"type": "subtitle", "time": 6843.109, "timestamp": "01:54:03", "text": "我忘了说，我忘了说要用那种袋装汤。"}, {"type": "subtitle", "time": 6844.91, "timestamp": "01:54:04", "text": "哪个牌子是"}, {"type": "subtitle", "time": 6848.99, "timestamp": "01:54:08", "text": "我竟然忘了是哪个牌子了"}, {"type": "subtitle", "time": 6851.99, "timestamp": "01:54:11", "text": "呃，是"}, {"type": "subtitle", "time": 6866.83, "timestamp": "01:54:26", "text": "啊，哦，你在这儿啊！我还在想你在哪儿呢。"}, {"type": "subtitle", "time": 6893.109, "timestamp": "01:54:53", "text": "嗯，人太多了。"}]
[{"type": "subtitle", "time": 11880.79, "timestamp": "03:18:00", "text": "是的，谢谢你们的聆听。"}, {"type": "subtitle", "time": 11883.67, "timestamp": "03:18:03", "text": "希望你喜欢，嗯，差不多吧"}, {"type": "subtitle", "time": 11885.349, "timestamp": "03:18:05", "text": "五"}, {"type": "subtitle", "time": 11888.11, "timestamp": "03:18:08", "text": "一分钟，而且这也是我第一次。"}, {"type": "subtitle", "time": 11891.75, "timestamp": "03:18:11", "text": "就像叙述者那样说话"}, {"type": "subtitle", "time": 11893.229, "timestamp": "03:18:13", "text": "结束了还是什么我不知道，我从来没有"}, {"type": "subtitle", "time": 11897.95, "timestamp": "03:18:17", "text": "是的"}, {"type": "subtitle", "time": 11900.99, "timestamp": "03:18:20", "text": "嗯，我很享受"}, {"type": "subtitle", "time": 11902.87, "timestamp": "03:18:22", "text": "那"}, {"type": "subtitle", "time": 11906.59, "timestamp": "03:18:26", "text": "是的，这条信息主要是为了"}, {"type": "subtitle", "time": 11909.99, "timestamp": "03:18:29", "text": "我认识很多生活困难的人。"}, {"type": "subtitle", "time": 11915.03, "timestamp": "03:18:35", "text": "很多人都在苦苦挣扎，嗯……"}, {"type": "subtitle", "time": 11919.83, "timestamp": "03:18:39", "text": "是的，别放弃，尽力就好。"}, {"type": "subtitle", "time": 11924.71, "timestamp": "03:18:44", "text": "好的，不要害怕迈出一步。"}, {"type": "subtitle", "time": 11926.83, "timestamp": "03:18:46", "text": "即使你已经向前迈进，"}, {"type": "subtitle", "time": 11928.99, "timestamp": "03:18:48", "text": "过度思考，过度思考，"}, {"type": "subtitle", "time": 11931.189, "timestamp": "03:18:51", "text": "想得太多以至于无法……"}, {"type": "subtitle", "time": 11933.189, "timestamp": "03:18:53", "text": "睡觉"}, {"type": "subtitle", "time": 11939.269, "timestamp": "03:18:59", "text": "夜晚，思绪万千，只是"}]
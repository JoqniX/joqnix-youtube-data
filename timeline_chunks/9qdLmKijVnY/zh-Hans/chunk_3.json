[{"type": "subtitle", "time": 184.149, "timestamp": "00:03:04", "text": "为什么我觉得自己需要更多睡眠"}, {"type": "subtitle", "time": 186.67, "timestamp": "00:03:06", "text": "我睡着了"}, {"type": "subtitle", "time": 191.75, "timestamp": "00:03:11", "text": "最搞笑的是，我7点半就睡着了。"}, {"type": "subtitle", "time": 193.99, "timestamp": "00:03:13", "text": "昨天直播结束后，我"}, {"type": "subtitle", "time": 195.99, "timestamp": "00:03:15", "text": "跟B聊了一会儿，然后就睡觉了。"}, {"type": "subtitle", "time": 199.82999999999998, "timestamp": "00:03:19", "text": "对，但是8、8或者别的什么，对，所以从"}, {"type": "subtitle", "time": 204.309, "timestamp": "00:03:24", "text": "晚上八点到十点或九点，我正在睡觉，然后醒了。"}, {"type": "subtitle", "time": 207.789, "timestamp": "00:03:27", "text": "因为狗狗的魅力"}, {"type": "subtitle", "time": 213.82999999999998, "timestamp": "00:03:33", "text": "让我热起来"}, {"type": "subtitle", "time": 216.82999999999998, "timestamp": "00:03:36", "text": "水"}, {"type": "subtitle", "time": 222.71, "timestamp": "00:03:42", "text": "然后我，嗯，去吃晚饭了。"}, {"type": "subtitle", "time": 228.82999999999998, "timestamp": "00:03:48", "text": "早上不是早晨，呃，晚上像10点11分"}, {"type": "subtitle", "time": 230.91, "timestamp": "00:03:50", "text": "是的，我曾经有过"}]
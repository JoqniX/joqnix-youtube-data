[{"type": "subtitle", "time": 5882.4, "timestamp": "01:38:02", "text": "我的天哪，你是在开玩笑吗？"}, {"type": "subtitle", "time": 5883.75, "timestamp": "01:38:03", "text": "[音乐]"}, {"type": "subtitle", "time": 5912.229, "timestamp": "01:38:32", "text": "我没有"}, {"type": "subtitle", "time": 5915.27, "timestamp": "01:38:35", "text": "我别无选择"}, {"type": "subtitle", "time": 5924.35, "timestamp": "01:38:44", "text": "伙计，不过他当时就说，是啊，我要去。"}, {"type": "subtitle", "time": 5927.79, "timestamp": "01:38:47", "text": "你改变了敌人，我就要抓住你。"}, {"type": "subtitle", "time": 5929.99, "timestamp": "01:38:49", "text": "我做不到，我连枪都没有。"}, {"type": "subtitle", "time": 5932.35, "timestamp": "01:38:52", "text": "试着爬上像柱子一样的东西"}, {"type": "subtitle", "time": 5934.189, "timestamp": "01:38:54", "text": "大 p 的某些东西"}, {"type": "subtitle", "time": 5937.47, "timestamp": "01:38:57", "text": "出于恐慌，我感觉自己别无选择"}]
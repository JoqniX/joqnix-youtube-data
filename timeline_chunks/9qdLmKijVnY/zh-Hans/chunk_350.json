[{"type": "subtitle", "time": 21000.75, "timestamp": "05:50:00", "text": "你的手机上安装了Twitch。"}, {"type": "subtitle", "time": 21002.35, "timestamp": "05:50:02", "text": "你会得到一股推动力"}, {"type": "subtitle", "time": 21005.59, "timestamp": "05:50:05", "text": "通知，或者如果你喜欢"}, {"type": "subtitle", "time": 21009.67, "timestamp": "05:50:09", "text": "通知，或者像浏览器中的通知一样"}, {"type": "subtitle", "time": 21013.91, "timestamp": "05:50:13", "text": "如果你在 Twitch 上，你就能从那里得到它。"}, {"type": "subtitle", "time": 21018.39, "timestamp": "05:50:18", "text": "好的，这就是我的做法……"}, {"type": "subtitle", "time": 21021.07, "timestamp": "05:50:21", "text": "就像 Twitch 直播时间表一样"}, {"type": "subtitle", "time": 21024.03, "timestamp": "05:50:24", "text": "我会在我的日程安排中更新。"}, {"type": "subtitle", "time": 21026.788, "timestamp": "05:50:26", "text": "在 Twitch 上，你会看到三个直播日程安排。"}, {"type": "subtitle", "time": 21029.83, "timestamp": "05:50:29", "text": "安排直播，在 Twitch 上会是"}, {"type": "subtitle", "time": 21033.43, "timestamp": "05:50:33", "text": "比如像这样的日程提醒"}, {"type": "subtitle", "time": 21037.468, "timestamp": "05:50:37", "text": "好的，原来是这样操作的，嗯。"}, {"type": "subtitle", "time": 21039.628, "timestamp": "05:50:39", "text": "如果你错过了这场直播，你可以"}, {"type": "subtitle", "time": 21041.67, "timestamp": "05:50:41", "text": "点击这里观看直播"}, {"type": "subtitle", "time": 21042.868, "timestamp": "05:50:42", "text": "观看通行证"}, {"type": "subtitle", "time": 21047.51, "timestamp": "05:50:47", "text": "对，广播里就是这么做的。"}, {"type": "subtitle", "time": 21050.11, "timestamp": "05:50:50", "text": "Twitch，我们又回到了 Oxine 时代。"}, {"type": "subtitle", "time": 21054.35, "timestamp": "05:50:54", "text": "音乐带来的聊天痛苦是"}, {"type": "subtitle", "time": 21057.19, "timestamp": "05:50:57", "text": "很高兴你听着，哦等等，我把麦克风静音了。"}]
[{"type": "subtitle", "time": 482.27, "timestamp": "00:08:02", "text": "对，这就像一个门槛，对吧？"}, {"type": "subtitle", "time": 485.189, "timestamp": "00:08:05", "text": "支付门槛"}, {"type": "subtitle", "time": 491.27, "timestamp": "00:08:11", "text": "YouTube 的运作方式真有趣，而且与传统 YouTube 截然不同。"}, {"type": "subtitle", "time": 494.589, "timestamp": "00:08:14", "text": "但有点像 Twitch，当你"}, {"type": "subtitle", "time": 496.23, "timestamp": "00:08:16", "text": "区域"}, {"type": "subtitle", "time": 498.39, "timestamp": "00:08:18", "text": "当你是伴侣时，伴侣"}, {"type": "subtitle", "time": 499.95, "timestamp": "00:08:19", "text": "程序"}, {"type": "subtitle", "time": 501.26, "timestamp": "00:08:21", "text": "有趣的"}, {"type": "subtitle", "time": 502.79, "timestamp": "00:08:22", "text": "[音乐]"}, {"type": "subtitle", "time": 505.189, "timestamp": "00:08:25", "text": "嗯，昨天我们唱的那首歌是……"}, {"type": "subtitle", "time": 507.469, "timestamp": "00:08:27", "text": "试图重现那首歌的尝试被认领了"}, {"type": "subtitle", "time": 511.469, "timestamp": "00:08:31", "text": "顺便说一句，所以我们不会是你和我。"}, {"type": "subtitle", "time": 515.63, "timestamp": "00:08:35", "text": "我以为会是这样，它是一个，它是一个甘多姆"}, {"type": "subtitle", "time": 520.35, "timestamp": "00:08:40", "text": "像动漫一样，罗布制作了一部像动漫一样的动画"}, {"type": "subtitle", "time": 523.11, "timestamp": "00:08:43", "text": "嗯，音乐"}, {"type": "subtitle", "time": 526.07, "timestamp": "00:08:46", "text": "对啊，没有柠檬"}, {"type": "subtitle", "time": 532.43, "timestamp": "00:08:52", "text": "不，呃，不，甜瓜，不，不，甜瓜，不，柠檬"}, {"type": "subtitle", "time": 536.43, "timestamp": "00:08:56", "text": "是的，那首歌是他们的歌。"}, {"type": "subtitle", "time": 539.47, "timestamp": "00:08:59", "text": "是啊，那首歌真的很好听，而且"}]
[{"type": "subtitle", "time": 11525.07, "timestamp": "03:12:05", "text": "虽然是个艰难的决定，但我还是做了。"}, {"type": "subtitle", "time": 11529.309, "timestamp": "03:12:09", "text": "我在这里，我不想知道"}, {"type": "subtitle", "time": 11531.469, "timestamp": "03:12:11", "text": "有些人认为这可能会"}, {"type": "subtitle", "time": 11535.19, "timestamp": "03:12:15", "text": "毕业典礼等等，就像我当时那样。"}, {"type": "subtitle", "time": 11538.99, "timestamp": "03:12:18", "text": "特别是对于流媒体而言。"}, {"type": "subtitle", "time": 11542.03, "timestamp": "03:12:22", "text": "但我想要表达的是"}, {"type": "subtitle", "time": 11545.389, "timestamp": "03:12:25", "text": "好吧，我真心想对你说……"}, {"type": "subtitle", "time": 11552.79, "timestamp": "03:12:32", "text": "内心深处，有时候我无法安住于我的内心。"}, {"type": "subtitle", "time": 11556.389, "timestamp": "03:12:36", "text": "角色 泪流满面"}, {"type": "subtitle", "time": 11565.91, "timestamp": "03:12:45", "text": "是的，这很难，但我还是想说……"}, {"type": "subtitle", "time": 11568.349, "timestamp": "03:12:48", "text": "坦白地说，我是"}, {"type": "subtitle", "time": 11573.03, "timestamp": "03:12:53", "text": "很抱歉我没能帮上什么忙，甚至"}, {"type": "subtitle", "time": 11576.389, "timestamp": "03:12:56", "text": "我不庆祝周年纪念直播"}, {"type": "subtitle", "time": 11578.55, "timestamp": "03:12:58", "text": "了解如何以及未来在哪里"}]
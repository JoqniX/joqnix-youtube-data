[{"type": "subtitle", "time": 2340.069, "timestamp": "00:39:00", "text": "我的天哪，我太……"}, {"type": "subtitle", "time": 2342.829, "timestamp": "00:39:02", "text": "很兴奋"}, {"type": "subtitle", "time": 2347.27, "timestamp": "00:39:07", "text": "有趣的是，这里也发生了一些变化。"}, {"type": "subtitle", "time": 2354.79, "timestamp": "00:39:14", "text": "出去"}, {"type": "subtitle", "time": 2358.15, "timestamp": "00:39:18", "text": "哦我的天啊，这把新枪，所以这就是……"}, {"type": "subtitle", "time": 2360.67, "timestamp": "00:39:20", "text": "我给那些不知道最后情况的人准备的枪"}, {"type": "subtitle", "time": 2363.19, "timestamp": "00:39:23", "text": "这个赛季我们遇到了挑战，一切都很艰难。"}, {"type": "subtitle", "time": 2367.39, "timestamp": "00:39:27", "text": "这就是我们得到的枪，嗯，它花了我……"}, {"type": "subtitle", "time": 2370.03, "timestamp": "00:39:30", "text": "永远，但我实际上都做到了。"}, {"type": "subtitle", "time": 2373.55, "timestamp": "00:39:33", "text": "挑战以及一切"}, {"type": "subtitle", "time": 2376.589, "timestamp": "00:39:36", "text": "我们终于搞定了"}, {"type": "subtitle", "time": 2378.309, "timestamp": "00:39:38", "text": "耶"}, {"type": "subtitle", "time": 2381.99, "timestamp": "00:39:41", "text": "对，那么乌尔塔的能力是什么呢？我们来谈谈。"}, {"type": "subtitle", "time": 2389.91, "timestamp": "00:39:49", "text": "搞清楚，嗯，我该怎么按F2、F1，而不是F3？"}, {"type": "subtitle", "time": 2393.27, "timestamp": "00:39:53", "text": "哦哦，我做了什么？"}, {"type": "subtitle", "time": 2399.109, "timestamp": "00:39:59", "text": "等等，我做了什么？哦不"}]
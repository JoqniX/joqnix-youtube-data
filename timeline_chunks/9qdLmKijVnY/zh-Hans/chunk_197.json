[{"type": "subtitle", "time": 11820.67, "timestamp": "03:17:00", "text": "音乐，还有旋律，在我脑海里萦绕。"}, {"type": "subtitle", "time": 11825.11, "timestamp": "03:17:05", "text": "就像写剧本一样，在创作剧本。"}, {"type": "subtitle", "time": 11828.229, "timestamp": "03:17:08", "text": "那些呃，比喻性的"}, {"type": "subtitle", "time": 11831.55, "timestamp": "03:17:11", "text": "给你们说几句话，这样就能联系起来了。"}, {"type": "subtitle", "time": 11834.229, "timestamp": "03:17:14", "text": "和你在一起的时候，我也一直哼着这首歌。"}, {"type": "subtitle", "time": 11838.189, "timestamp": "03:17:18", "text": "我脑海里立刻浮现出这样的想法：呃……"}, {"type": "subtitle", "time": 11842.75, "timestamp": "03:17:22", "text": "U Melodies 的五六次迭代，但"}, {"type": "subtitle", "time": 11846.95, "timestamp": "03:17:26", "text": "我选择了那个可以像你一样与之相关的词。"}, {"type": "subtitle", "time": 11850.189, "timestamp": "03:17:30", "text": "这是我最珍视的东西，所以我这么做了。"}, {"type": "subtitle", "time": 11853.229, "timestamp": "03:17:33", "text": "我尽力了，但其实也没那么好，但我"}, {"type": "subtitle", "time": 11856.91, "timestamp": "03:17:36", "text": "现实生活中真的吹口哨并录了下来"}, {"type": "subtitle", "time": 11860.189, "timestamp": "03:17:40", "text": "一边思考一边"}, {"type": "subtitle", "time": 11862.79, "timestamp": "03:17:42", "text": "关于传达这一点"}, {"type": "subtitle", "time": 11867.87, "timestamp": "03:17:47", "text": "我会好好跟你们说的，但是"}, {"type": "subtitle", "time": 11869.389, "timestamp": "03:17:49", "text": "它到达"}, {"type": "subtitle", "time": 11874.55, "timestamp": "03:17:54", "text": "出去，它触动你，就像"}]
[{"type": "subtitle", "time": 19860.51, "timestamp": "05:31:00", "text": "我应该学学怎么看聊天记录。"}, {"type": "subtitle", "time": 19864.11, "timestamp": "05:31:04", "text": "虽然我只需要移动一下眼睛"}, {"type": "subtitle", "time": 19867.47, "timestamp": "05:31:07", "text": "眼睛看向左侧或右侧"}, {"type": "subtitle", "time": 19870.67, "timestamp": "05:31:10", "text": "想看看其他两个人的聊天记录"}, {"type": "subtitle", "time": 19873.31, "timestamp": "05:31:13", "text": "监控器"}, {"type": "subtitle", "time": 19876.99, "timestamp": "05:31:16", "text": "是的，我喜欢耐力如何应用于……"}, {"type": "subtitle", "time": 19879.948, "timestamp": "05:31:19", "text": "好的，对，我也是这么想的。"}, {"type": "subtitle", "time": 19890.868, "timestamp": "05:31:30", "text": "他们不需要进行耐力训练"}, {"type": "subtitle", "time": 19893.11, "timestamp": "05:31:33", "text": "尽管"}, {"type": "subtitle", "time": 19896.628, "timestamp": "05:31:36", "text": "我敢打赌祖基正在看着呢。"}, {"type": "subtitle", "time": 19899.51, "timestamp": "05:31:39", "text": "是的"}, {"type": "subtitle", "time": 19907.27, "timestamp": "05:31:47", "text": "再见，我知道她在看，我想她正在看。"}]
[{"type": "subtitle", "time": 240.789, "timestamp": "00:04:00", "text": "躺在床上，就像我只是"}, {"type": "subtitle", "time": 243.67, "timestamp": "00:04:03", "text": "我刚才试着睡觉，但是睡不着。"}, {"type": "subtitle", "time": 253.71, "timestamp": "00:04:13", "text": "稍微做了一些计算。"}, {"type": "subtitle", "time": 258.469, "timestamp": "00:04:18", "text": "有点，嗯，我想"}, {"type": "subtitle", "time": 262.23, "timestamp": "00:04:22", "text": "看完之后我就没再继续了。"}, {"type": "subtitle", "time": 264.67, "timestamp": "00:04:24", "text": "我觉得是动漫"}, {"type": "subtitle", "time": 275.95, "timestamp": "00:04:35", "text": "G，但我还是觉得我睡着了"}, {"type": "chat", "time": 276.662, "timestamp": "00:04:36", "author": "@Kenn_D_Bush", "avatar": "https://yt4.ggpht.com/_Komo_VEKSz-e7kb-dTpjPDPdwLBWdimZXGs-iY-B0gcs1aY-MXI_lQXH90AN623vf5ag2FRRA=s64-c-k-c0x00ffffff-no-rj", "message": "hello there joq"}, {"type": "subtitle", "time": 280.31, "timestamp": "00:04:40", "text": "嗯，我一开始并没有感到那么疲倦。"}, {"type": "chat", "time": 282.389, "timestamp": "00:04:42", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "a month already"}, {"type": "chat", "time": 283.49, "timestamp": "00:04:43", "author": "@Kenn_D_Bush", "avatar": "https://yt4.ggpht.com/_Komo_VEKSz-e7kb-dTpjPDPdwLBWdimZXGs-iY-B0gcs1aY-MXI_lQXH90AN623vf5ag2FRRA=s64-c-k-c0x00ffffff-no-rj", "message": "hope you had a good night rest there "}, {"type": "subtitle", "time": 284.43, "timestamp": "00:04:44", "text": "早上就是这样。"}, {"type": "subtitle", "time": 289.67, "timestamp": "00:04:49", "text": "你好，早上好"}, {"type": "subtitle", "time": 293.43, "timestamp": "00:04:53", "text": "肯，是的，我睡得很好。"}, {"type": "subtitle", "time": 296.71, "timestamp": "00:04:56", "text": "昨晚睡得很好，我睡着了。"}]
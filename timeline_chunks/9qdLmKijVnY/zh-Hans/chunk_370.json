[{"type": "subtitle", "time": 22202.51, "timestamp": "06:10:02", "text": "直播他的现场肮脏模特 deut so"}, {"type": "subtitle", "time": 22203.91, "timestamp": "06:10:03", "text": "一定要注意他"}, {"type": "subtitle", "time": 22207.23, "timestamp": "06:10:07", "text": "好的，待会儿会和……一起玩。"}, {"type": "subtitle", "time": 22212.31, "timestamp": "06:10:12", "text": "基因影响，所以，是的，这很重要。"}, {"type": "subtitle", "time": 22215.868, "timestamp": "06:10:15", "text": "我想等到他……"}, {"type": "subtitle", "time": 22219.43, "timestamp": "06:10:19", "text": "就这样结束了，但是他说，但是我"}, {"type": "subtitle", "time": 22223.15, "timestamp": "06:10:23", "text": "感觉就像，嗯，我就看看吧。"}, {"type": "subtitle", "time": 22225.03, "timestamp": "06:10:25", "text": "沙龙我是"}, {"type": "subtitle", "time": 22228.11, "timestamp": "06:10:28", "text": "不好意思，没关系，这也是我的第一次"}, {"type": "subtitle", "time": 22230.27, "timestamp": "06:10:30", "text": "时间像在沙龙里一样做手表"}, {"type": "subtitle", "time": 22233.27, "timestamp": "06:10:33", "text": "这是现场直播，所以这是一个，这是一个"}, {"type": "subtitle", "time": 22235.75, "timestamp": "06:10:35", "text": "我想这就是经验吧"}, {"type": "subtitle", "time": 22239.11, "timestamp": "06:10:39", "text": "是的，我喜欢你们。"}, {"type": "subtitle", "time": 22241.43, "timestamp": "06:10:41", "text": "完全不知道，哦，就像你们都看到了一样。"}, {"type": "subtitle", "time": 22242.99, "timestamp": "06:10:42", "text": "奇怪的"}, {"type": "subtitle", "time": 22246.03, "timestamp": "06:10:46", "text": "像一堆废铁一样的拖车"}, {"type": "subtitle", "time": 22248.868, "timestamp": "06:10:48", "text": "没错，各位，我当时正在录制视频。"}, {"type": "subtitle", "time": 22251.59, "timestamp": "06:10:51", "text": "你们根本不知道我有多喜欢它。"}, {"type": "subtitle", "time": 22254.35, "timestamp": "06:10:54", "text": "分心了，而且，即使"}, {"type": "subtitle", "time": 22256.43, "timestamp": "06:10:56", "text": "整个视频看起来就像……我不知道。"}, {"type": "subtitle", "time": 22259.628, "timestamp": "06:10:59", "text": "等一下，Max，我想放"}]
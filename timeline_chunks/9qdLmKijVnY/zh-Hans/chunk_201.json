[{"type": "subtitle", "time": 12064.389, "timestamp": "03:21:04", "text": "好的，那么，呃，就是呃……"}, {"type": "subtitle", "time": 12068.349, "timestamp": "03:21:08", "text": "差不多30分钟了，对吧？已经30分钟了吗？"}, {"type": "subtitle", "time": 12070.269, "timestamp": "03:21:10", "text": "分钟可以"}, {"type": "subtitle", "time": 12074.469, "timestamp": "03:21:14", "text": "28 好的，还剩一分钟，好的"}, {"type": "subtitle", "time": 12077.99, "timestamp": "03:21:17", "text": "嗯，我说过我会直播30分钟。"}, {"type": "subtitle", "time": 12081.71, "timestamp": "03:21:21", "text": "所以我会在30分钟内结束它。"}, {"type": "subtitle", "time": 12086.63, "timestamp": "03:21:26", "text": "马克，嗯，不过话说回来，我回来了。"}, {"type": "subtitle", "time": 12089.229, "timestamp": "03:21:29", "text": "我将尽我所能"}, {"type": "subtitle", "time": 12093.91, "timestamp": "03:21:33", "text": "最好是内容可能会有所变化，"}, {"type": "subtitle", "time": 12097.269, "timestamp": "03:21:37", "text": "我将做出一些新的改变，"}, {"type": "subtitle", "time": 12101.469, "timestamp": "03:21:41", "text": "限制一些我过去常做的事情"}, {"type": "subtitle", "time": 12105.15, "timestamp": "03:21:45", "text": "嗯，但我希望你们都尊重我的"}, {"type": "subtitle", "time": 12108.389, "timestamp": "03:21:48", "text": "我做出决定，并希望尽我所能做到最好。"}, {"type": "subtitle", "time": 12112.75, "timestamp": "03:21:52", "text": "我感到很开心，尤其是和赵素在一起的时候。"}, {"type": "subtitle", "time": 12114.469, "timestamp": "03:21:54", "text": "嗯，谢谢"}, {"type": "subtitle", "time": 12118.03, "timestamp": "03:21:58", "text": "你好，就是这样。"}]
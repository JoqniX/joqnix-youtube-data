[{"type": "subtitle", "time": 20522.868, "timestamp": "05:42:02", "text": "你以前经常使用的那些命令。"}, {"type": "subtitle", "time": 20525.03, "timestamp": "05:42:05", "text": "不来上班，或者你不上班"}, {"type": "subtitle", "time": 20527.83, "timestamp": "05:42:07", "text": "听清楚了吗？或者如果我……"}, {"type": "subtitle", "time": 20530.468, "timestamp": "05:42:10", "text": "呃，如果你可以合作直播的话"}, {"type": "subtitle", "time": 20534.35, "timestamp": "05:42:14", "text": "没听到合作的消息"}, {"type": "subtitle", "time": 20539.19, "timestamp": "05:42:19", "text": "请正确告知我客串配音的情况。"}, {"type": "subtitle", "time": 20542.67, "timestamp": "05:42:22", "text": "好的，还有，我一定要确保保留……"}, {"type": "subtitle", "time": 20547.23, "timestamp": "05:42:27", "text": "只用英语聊天，是的，我是。"}, {"type": "subtitle", "time": 20549.91, "timestamp": "05:42:29", "text": "日语，因为大多数时候如果"}, {"type": "subtitle", "time": 20553.07, "timestamp": "05:42:33", "text": "我只是在闲聊，我可以"}, {"type": "subtitle", "time": 20557.19, "timestamp": "05:42:37", "text": "立即复制并把它放上去"}, {"type": "subtitle", "time": 20561.948, "timestamp": "05:42:41", "text": "谷歌翻译，然后回复"}, {"type": "subtitle", "time": 20566.59, "timestamp": "05:42:46", "text": "虽然是额外的工作，但还是可以的。"}, {"type": "subtitle", "time": 20569.51, "timestamp": "05:42:49", "text": "嗯，但是"}, {"type": "subtitle", "time": 20574.15, "timestamp": "05:42:54", "text": "是啊，但是，尽量把它留在心里。"}, {"type": "subtitle", "time": 20575.11, "timestamp": "05:42:55", "text": "英语"}, {"type": "subtitle", "time": 20579.03, "timestamp": "05:42:59", "text": "或者说，这样不仅我，还有其他人也能明白。"}]
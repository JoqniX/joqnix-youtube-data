[{"type": "subtitle", "time": 17002.99, "timestamp": "04:43:22", "text": "对，这游戏不错，干得漂亮！"}, {"type": "subtitle", "time": 17005.39, "timestamp": "04:43:25", "text": "试试？哦等等，我做不到。"}, {"type": "subtitle", "time": 17009.11, "timestamp": "04:43:29", "text": "玩得太多，呃，等等，那是什么来着？"}, {"type": "subtitle", "time": 17012.948, "timestamp": "04:43:32", "text": "说好的，呃，等等，是的，名字"}, {"type": "subtitle", "time": 17015.03, "timestamp": "04:43:35", "text": "有偶数"}, {"type": "subtitle", "time": 17018.23, "timestamp": "04:43:38", "text": "没错，所以，呃，说到你的"}, {"type": "subtitle", "time": 17021.23, "timestamp": "04:43:41", "text": "虚拟的在线名称或你不能拥有的东西"}, {"type": "subtitle", "time": 17025.07, "timestamp": "04:43:45", "text": "选择一个独一无二的名字。"}, {"type": "subtitle", "time": 17027.75, "timestamp": "04:43:47", "text": "如果情况不同，这并不常见，如果"}, {"type": "subtitle", "time": 17029.91, "timestamp": "04:43:49", "text": "名字中间有个逗号，没关系，但是你"}, {"type": "subtitle", "time": 17032.868, "timestamp": "04:43:52", "text": "这个姓氏也可以改变。"}, {"type": "subtitle", "time": 17034.83, "timestamp": "04:43:54", "text": "我没有名字，也没有姓氏"}, {"type": "subtitle", "time": 17039.11, "timestamp": "04:43:59", "text": "名字，就一个名字，对吧？"}]
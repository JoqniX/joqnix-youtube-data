[{"type": "subtitle", "time": 3851.19, "timestamp": "01:04:11", "text": "不，他比我技高一筹，他的枪更好。"}, {"type": "subtitle", "time": 3853.87, "timestamp": "01:04:13", "text": "或者别的什么"}, {"type": "subtitle", "time": 3858.549, "timestamp": "01:04:18", "text": "[音乐]"}, {"type": "subtitle", "time": 3860.87, "timestamp": "01:04:20", "text": "我来自哪里"}, {"type": "subtitle", "time": 3864.349, "timestamp": "01:04:24", "text": "现在我要狙击这家伙，这绿家伙。"}, {"type": "subtitle", "time": 3866.309, "timestamp": "01:04:26", "text": "兄弟"}]
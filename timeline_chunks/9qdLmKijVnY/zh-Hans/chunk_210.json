[{"type": "subtitle", "time": 12602.469, "timestamp": "03:30:02", "text": "人们会做所有那些呃……人们"}, {"type": "subtitle", "time": 12605.99, "timestamp": "03:30:05", "text": "看着我做，他们不会明白的。"}, {"type": "subtitle", "time": 12609.63, "timestamp": "03:30:09", "text": "感觉被盯着看太多了"}, {"type": "subtitle", "time": 12617.37, "timestamp": "03:30:17", "text": "对，那很好"}, {"type": "subtitle", "time": 12619.269, "timestamp": "03:30:19", "text": "[音乐]"}, {"type": "subtitle", "time": 12622.83, "timestamp": "03:30:22", "text": "Jo，什么是#art标签？哦，嗯……"}, {"type": "subtitle", "time": 12624.349, "timestamp": "03:30:24", "text": "那些不这样做的人"}, {"type": "subtitle", "time": 12629.189, "timestamp": "03:30:29", "text": "我知道我嗯决定有点"}, {"type": "subtitle", "time": 12635.63, "timestamp": "03:30:35", "text": "决定用AR标签，那就是我"}, {"type": "subtitle", "time": 12640.59, "timestamp": "03:30:40", "text": "我的推特简介里已经更新了，是Jo"}, {"type": "subtitle", "time": 12650.55, "timestamp": "03:30:50", "text": "这将是艺术"}, {"type": "subtitle", "time": 12653.389, "timestamp": "03:30:53", "text": "标签谈话"}, {"type": "subtitle", "time": 12656.87, "timestamp": "03:30:56", "text": "列表，且此标签尚未被任何人占用"}]
[{"type": "subtitle", "time": 11945.67, "timestamp": "03:19:05", "text": "行动"}, {"type": "subtitle", "time": 11948.63, "timestamp": "03:19:08", "text": "是的，所以"}, {"type": "subtitle", "time": 11950.79, "timestamp": "03:19:10", "text": "是的"}, {"type": "subtitle", "time": 11954.99, "timestamp": "03:19:14", "text": "嗨，我真的不想哭。"}, {"type": "subtitle", "time": 11957.91, "timestamp": "03:19:17", "text": "今天我一直在对自己说……"}, {"type": "subtitle", "time": 11962.15, "timestamp": "03:19:22", "text": "乔基，别哭，别哭，别哭"}, {"type": "subtitle", "time": 11965.389, "timestamp": "03:19:25", "text": "结果还不错。"}, {"type": "subtitle", "time": 11969.91, "timestamp": "03:19:29", "text": "呃，尽你所能地表达你的情绪"}, {"type": "subtitle", "time": 11973.79, "timestamp": "03:19:33", "text": "我说我不想"}, {"type": "subtitle", "time": 11975.309, "timestamp": "03:19:35", "text": "任何人"}, {"type": "subtitle", "time": 11979.429, "timestamp": "03:19:39", "text": "嗯嗯，就像放弃一样。"}, {"type": "subtitle", "time": 11982.229, "timestamp": "03:19:42", "text": "嗯，老实说，我想做的是……"}, {"type": "subtitle", "time": 11983.07, "timestamp": "03:19:43", "text": "一个"}, {"type": "subtitle", "time": 11986.99, "timestamp": "03:19:46", "text": "很高兴回来，而且喜欢这样"}, {"type": "subtitle", "time": 11988.71, "timestamp": "03:19:48", "text": "一切都很模糊。"}, {"type": "subtitle", "time": 11992.03, "timestamp": "03:19:52", "text": "然后假装什么都没发生"}, {"type": "subtitle", "time": 11996.95, "timestamp": "03:19:56", "text": "事情发生了，但是你知道我，我就像……"}, {"type": "subtitle", "time": 11998.83, "timestamp": "03:19:58", "text": "这"}]
[{"type": "subtitle", "time": 11763.75, "timestamp": "03:16:03", "text": "哇，所以，嗯，我不想把它变成……"}, {"type": "subtitle", "time": 11765.63, "timestamp": "03:16:05", "text": "矫情的东西"}, {"type": "subtitle", "time": 11771.03, "timestamp": "03:16:11", "text": "嗯，是的，我确实排练过这种风格。"}, {"type": "subtitle", "time": 11774.309, "timestamp": "03:16:14", "text": "我排练了那么多遍，该怎么办呢？"}, {"type": "subtitle", "time": 11780.189, "timestamp": "03:16:20", "text": "我搞砸了"}, {"type": "subtitle", "time": 11793.349, "timestamp": "03:16:33", "text": "好的，你好"}, {"type": "subtitle", "time": 11798.67, "timestamp": "03:16:38", "text": "嗯，嗨，我会尽量以……结尾。"}, {"type": "subtitle", "time": 11801.71, "timestamp": "03:16:41", "text": "我会尽量以积极的方式结尾。"}, {"type": "subtitle", "time": 11806.99, "timestamp": "03:16:46", "text": "好的，我会把视频发上来。"}, {"type": "subtitle", "time": 11809.229, "timestamp": "03:16:49", "text": "听听看，如果你知道的话"}, {"type": "subtitle", "time": 11811.55, "timestamp": "03:16:51", "text": "不知道你有没有注意到那是我。"}, {"type": "subtitle", "time": 11814.189, "timestamp": "03:16:54", "text": "背景里传来口哨声，因为你知道"}, {"type": "subtitle", "time": 11816.11, "timestamp": "03:16:56", "text": "我有多喜欢"}]
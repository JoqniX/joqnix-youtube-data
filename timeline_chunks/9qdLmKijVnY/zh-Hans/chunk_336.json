[{"type": "subtitle", "time": 20160.67, "timestamp": "05:36:00", "text": "家人，是的，我喜欢被治愈，是的，你"}, {"type": "subtitle", "time": 20161.91, "timestamp": "05:36:01", "text": "是"}, {"type": "subtitle", "time": 20166.548, "timestamp": "05:36:06", "text": "治愈了，你是 Cur，你是 Cur，你是"}, {"type": "subtitle", "time": 20172.548, "timestamp": "05:36:12", "text": "Daka，呃，你所有 Twitch 账号上的那个人是谁？"}, {"type": "subtitle", "time": 20175.788, "timestamp": "05:36:15", "text": "是的，下次吧，没错。"}, {"type": "subtitle", "time": 20179.47, "timestamp": "05:36:19", "text": "昨天发生的事，我瞬间就被封号了。"}, {"type": "subtitle", "time": 20182.67, "timestamp": "05:36:22", "text": "在我给他们……反应之前，或者"}, {"type": "subtitle", "time": 20185.788, "timestamp": "05:36:25", "text": "诸如此类的事情，但你还是知道……呃"}, {"type": "subtitle", "time": 20189.03, "timestamp": "05:36:29", "text": "这是旅程的一部分，对吧？"}, {"type": "subtitle", "time": 20194.788, "timestamp": "05:36:34", "text": "像这样的障碍，呃呃，像这样的障碍"}, {"type": "subtitle", "time": 20198.07, "timestamp": "05:36:38", "text": "呃，像这样的障碍……"}, {"type": "subtitle", "time": 20200.43, "timestamp": "05:36:40", "text": "在你的旅程中，你正处于……"}, {"type": "subtitle", "time": 20202.548, "timestamp": "05:36:42", "text": "互联网或类似的东西都会在那里"}, {"type": "subtitle", "time": 20205.23, "timestamp": "05:36:45", "text": "总会有人心怀恶意，也会有人友善待人。"}, {"type": "subtitle", "time": 20208.708, "timestamp": "05:36:48", "text": "我对你说，我想和你亲近。"}, {"type": "subtitle", "time": 20211.51, "timestamp": "05:36:51", "text": "呃，我想保护你。"}, {"type": "subtitle", "time": 20213.91, "timestamp": "05:36:53", "text": "那里的一切也都会有形形色色的人，"}, {"type": "subtitle", "time": 20218.51, "timestamp": "05:36:58", "text": "不喜欢你，想毁了你，而且"}]
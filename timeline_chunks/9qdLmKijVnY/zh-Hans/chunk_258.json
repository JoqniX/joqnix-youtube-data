[{"type": "subtitle", "time": 15485.59, "timestamp": "04:18:05", "text": "玩游戏的时候，我滑进了这个水滑梯……"}, {"type": "subtitle", "time": 15487.92, "timestamp": "04:18:07", "text": "想知道"}, {"type": "subtitle", "time": 15506.71, "timestamp": "04:18:26", "text": "来吧来吧，无论你在哪里"}, {"type": "subtitle", "time": 15509.83, "timestamp": "04:18:29", "text": "跟我来，三角形，我会叫你"}, {"type": "subtitle", "time": 15533.79, "timestamp": "04:18:53", "text": "日本人，我有点沮丧，有点高。"}, {"type": "subtitle", "time": 15536.87, "timestamp": "04:18:56", "text": "我感觉有点像"}, {"type": "subtitle", "time": 15539.91, "timestamp": "04:18:59", "text": "啊，B在哪儿？但他"}]
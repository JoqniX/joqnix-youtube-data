[{"type": "subtitle", "time": 241.27, "timestamp": "00:04:01", "text": "積極的に参加しているときだけ配信します。"}, {"type": "subtitle", "time": 244.149, "timestamp": "00:04:04", "text": "通常の"}, {"type": "subtitle", "time": 247.429, "timestamp": "00:04:07", "text": "ストリームと同じように、みんながやっているように、それに似ています。それが"}, {"type": "subtitle", "time": 250.149, "timestamp": "00:04:10", "text": "良い方法だと思います。"}, {"type": "subtitle", "time": 253.03, "timestamp": "00:04:13", "text": "それで、今日の目標は"}, {"type": "subtitle", "time": 255.99, "timestamp": "00:04:15", "text": "タイトルの通り、情報ページ"}, {"type": "subtitle", "time": 259.59, "timestamp": "00:04:19", "text": "と概要ページをきちんと作成することです。"}, {"type": "subtitle", "time": 263.35, "timestamp": "00:04:23", "text": "概要ページを少し変更します。"}, {"type": "subtitle", "time": 265.99, "timestamp": "00:04:25", "text": "ジョック、なぜ私に聞く必要があったのかというと、"}, {"type": "subtitle", "time": 268.469, "timestamp": "00:04:28", "text": "今になって、"}, {"type": "subtitle", "time": 271.67, "timestamp": "00:04:31", "text": "すべてのページを同じような形式、つまり"}, {"type": "subtitle", "time": 276.31, "timestamp": "00:04:36", "text": "同じ形式にする必要があることに気づいたからです。 では、そうしましょう"}, {"type": "subtitle", "time": 281.189, "timestamp": "00:04:41", "text": "。 昨日、ガイドラインの抜け穴などをすべて修正したと思います"}, {"type": "subtitle", "time": 289.59000000000003, "timestamp": "00:04:49", "text": "付け加えるべきことがあれば、"}, {"type": "subtitle", "time": 292.629, "timestamp": "00:04:52", "text": "追記します。 ええ、ガイドラインは、ある"}, {"type": "subtitle", "time": 296.31, "timestamp": "00:04:56", "text": "意味で正式に完成したと言えるでしょう。"}, {"type": "subtitle", "time": 299.749, "timestamp": "00:04:59", "text": "えっと、"}]
[{"type": "subtitle", "time": 14763.67, "timestamp": "04:06:03", "text": "後でこうやってやるよ。   背景を"}, {"type": "subtitle", "time": 14766.309, "timestamp": "04:06:06", "text": "依頼するか、無地の"}, {"type": "subtitle", "time": 14768.71, "timestamp": "04:06:08", "text": "背景を使う必要がある。"}, {"type": "subtitle", "time": 14771.349, "timestamp": "04:06:11", "text": "ええ、メインの"}, {"type": "subtitle", "time": 14775.59, "timestamp": "04:06:15", "text": "ランディングページはまだ完成していません。 大丈夫。"}, {"type": "subtitle", "time": 14785.51, "timestamp": "04:06:25", "text": "、ちょっと待って。 ちょっと待って。   ちょっと"}, {"type": "subtitle", "time": 14790.389, "timestamp": "04:06:30", "text": "待って。  1秒。"}, {"type": "subtitle", "time": 14793.91, "timestamp": "04:06:33", "text": "自分のファンウィキのエントリーを確認させてください。"}, {"type": "subtitle", "time": 14796.55, "timestamp": "04:06:36", "text": "そう、すべての"}, {"type": "subtitle", "time": 14799.429, "timestamp": "04:06:39", "text": "ユーチューバーには血液型があるんだよ。"}, {"type": "subtitle", "time": 14802.87, "timestamp": "04:06:42", "text": "あ、待って。 彼女はそれを持っていない。"}, {"type": "subtitle", "time": 14806.71, "timestamp": "04:06:46", "text": "ドゥービーはどうですか？ ドゥービーはどこにいる？"}, {"type": "subtitle", "time": 14808.71, "timestamp": "04:06:48", "text": "どこ？"}]
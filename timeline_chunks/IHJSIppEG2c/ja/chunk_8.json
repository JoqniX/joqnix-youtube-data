[{"type": "subtitle", "time": 484.469, "timestamp": "00:08:04", "text": "。 えっと、ウェブサイト関連の作業をずっと続けていました"}, {"type": "subtitle", "time": 487.67, "timestamp": "00:08:07", "text": "。 今日で終わらせよう。 わかった。"}, {"type": "subtitle", "time": 490.23, "timestamp": "00:08:10", "text": "あと、"}, {"type": "subtitle", "time": 492.55, "timestamp": "00:08:12", "text": "今日の配信についてツイートするのを忘れてないよ。 えっと、ちょっとだけやってみましょう"}, {"type": "subtitle", "time": 494.869, "timestamp": "00:08:14", "text": "。"}, {"type": "subtitle", "time": 496.79, "timestamp": "00:08:16", "text": "えっと、"}, {"type": "subtitle", "time": 511.589, "timestamp": "00:08:31", "text": "Twitterのテンプレートを自動化する必要があることに気づきました。"}, {"type": "subtitle", "time": 516.18, "timestamp": "00:08:36", "text": "私はそのことを何度も忘れていました。 オフ。"}, {"type": "subtitle", "time": 531.75, "timestamp": "00:08:51", "text": "正直に言うと、"}, {"type": "subtitle", "time": 534.389, "timestamp": "00:08:54", "text": "歌い始めたり何かを始めたりしたときに気づいたんです。"}, {"type": "subtitle", "time": 536.389, "timestamp": "00:08:56", "text": "歌は下手だけど、一度"}, {"type": "subtitle", "time": 539.75, "timestamp": "00:08:59", "text": "歌おうとしたりすると、夢中になってしまうんです"}]
[{"type": "subtitle", "time": 14340.07, "timestamp": "03:59:00", "text": "。 あなたはまさに今、それを実行しました。 私はそれを見るつもりだった"}, {"type": "subtitle", "time": 14350.07, "timestamp": "03:59:10", "text": "私は少し立ち止まったのです。"}, {"type": "subtitle", "time": 14353.03, "timestamp": "03:59:13", "text": "ようこそ、Dさん。お元気ですか？ 生活はどうでしたか"}, {"type": "subtitle", "time": 14354.79, "timestamp": "03:59:14", "text": "？"}, {"type": "subtitle", "time": 14375.83, "timestamp": "03:59:35", "text": "[音楽]"}, {"type": "subtitle", "time": 14377.75, "timestamp": "03:59:37", "text": "こんにちは、ジャスミン。"}, {"type": "subtitle", "time": 14380.79, "timestamp": "03:59:40", "text": "ああ、どうぞ入って。"}, {"type": "subtitle", "time": 14383.75, "timestamp": "03:59:43", "text": "くだらない"}, {"type": "subtitle", "time": 14385.99, "timestamp": "03:59:45", "text": "動画だってことを忘れずに言ってね。"}, {"type": "subtitle", "time": 14392.95, "timestamp": "03:59:52", "text": "サイトの作業をしています。"}, {"type": "subtitle", "time": 14397.51, "timestamp": "03:59:57", "text": "私は自分の情報ページを作成中です。"}]
[{"type": "subtitle", "time": 14400.389, "timestamp": "04:00:00", "text": "人生は素晴らしい。 あなたはどうですか？ 私の人生？"}, {"type": "subtitle", "time": 14404.15, "timestamp": "04:00:04", "text": "ええ、私は元気でしたよ。 インド・パキスタン戦争の影響で、私の入学時期は"}, {"type": "subtitle", "time": 14406.87, "timestamp": "04:00:06", "text": "来年4月に延期されました"}, {"type": "subtitle", "time": 14410.15, "timestamp": "04:00:10", "text": "。"}, {"type": "subtitle", "time": 14415.59, "timestamp": "04:00:15", "text": "ええと、ある意味、私はここに9ヶ月間滞在する予定です。"}, {"type": "subtitle", "time": 14418.71, "timestamp": "04:00:18", "text": "それで、"}, {"type": "subtitle", "time": 14422.15, "timestamp": "04:00:22", "text": "両親が"}, {"type": "subtitle", "time": 14426.229, "timestamp": "04:00:26", "text": "私に"}, {"type": "subtitle", "time": 14428.71, "timestamp": "04:00:28", "text": "個人事業主としてビジネスをすることを許可してくれたので、"}, {"type": "subtitle", "time": 14432.71, "timestamp": "04:00:32", "text": "支払いを使い切っても自分の個人情報が晒されないように、"}, {"type": "subtitle", "time": 14434.87, "timestamp": "04:00:34", "text": "あなたの会社Starscapeがやっているのと似たような仕組みになっています。QR"}, {"type": "subtitle", "time": 14438.79, "timestamp": "04:00:38", "text": "コード決済のように、"}, {"type": "subtitle", "time": 14442.15, "timestamp": "04:00:42", "text": "誰かが"}, {"type": "subtitle", "time": 14445.51, "timestamp": "04:00:45", "text": "QRコード決済で寄付しても、あなたの"}, {"type": "subtitle", "time": 14447.67, "timestamp": "04:00:47", "text": "本名などは表示されませんよね？"}, {"type": "subtitle", "time": 14450.95, "timestamp": "04:00:50", "text": "会社名だけが表示されているんですよね？"}, {"type": "subtitle", "time": 14453.75, "timestamp": "04:00:53", "text": "お金を送金して"}, {"type": "subtitle", "time": 14455.91, "timestamp": "04:00:55", "text": "取引を行うときですよね？ うん。 うん。 同じ"}, {"type": "subtitle", "time": 14459.03, "timestamp": "04:00:59", "text": "ことだ。 私は、本名の"}]
[{"type": "subtitle", "time": 17586.868, "timestamp": "04:53:06", "text": "彼らは小麦を栽培したかったし、ほとんどの人が"}, {"type": "subtitle", "time": 17590.788, "timestamp": "04:53:10", "text": "小麦を愛していて、会議に出席した人たちもいました"}, {"type": "subtitle", "time": 17593.43, "timestamp": "04:53:13", "text": "。 彼らは小さな友人を失い、しばらくして仕事を辞めた"}, {"type": "subtitle", "time": 17596.628, "timestamp": "04:53:16", "text": "。"}, {"type": "subtitle", "time": 17598.788, "timestamp": "04:53:18", "text": "彼らは9人全員を8人まで一気に倒した"}, {"type": "subtitle", "time": 17601.03, "timestamp": "04:53:21", "text": "。 何？"}, {"type": "subtitle", "time": 17603.59, "timestamp": "04:53:23", "text": "エモとは何ですか？ 待って、エミューって何だか知らないんだけど"}, {"type": "subtitle", "time": 17614.628, "timestamp": "04:53:34", "text": "、あれは鳥だ。 大きな鳥。"}, {"type": "subtitle", "time": 17617.59, "timestamp": "04:53:37", "text": "え、私が何を考えたって？ ちょっと待って。 これは"}, {"type": "subtitle", "time": 17620.39, "timestamp": "04:53:40", "text": "本当に、ああ、顔が"}, {"type": "subtitle", "time": 17624.15, "timestamp": "04:53:44", "text": "ヤバい。 とても不気味だ。"}, {"type": "subtitle", "time": 17627.67, "timestamp": "04:53:47", "text": "悪とは何かはわからないが、それはまるで、"}]
[{"type": "subtitle", "time": 4561.669, "timestamp": "01:16:01", "text": "正しく行う必要があります。 うん。 それに、"}, {"type": "subtitle", "time": 4567.43, "timestamp": "01:16:07", "text": "Onexia関連のこととか、そういう野望もあるんだよ。 それらは"}, {"type": "subtitle", "time": 4570.07, "timestamp": "01:16:10", "text": "長期的な、"}, {"type": "subtitle", "time": 4573.669, "timestamp": "01:16:13", "text": "非常に大きな目標ですよね？ えーと、私が本当にやりたい夢は、"}, {"type": "subtitle", "time": 4581.03, "timestamp": "01:16:21", "text": "クリエイティブなレーベルのことで、"}, {"type": "subtitle", "time": 4590.149, "timestamp": "01:16:30", "text": "Jockn と完全に安定した後に Onexia を LLC として設立することです。"}, {"type": "subtitle", "time": 4592.39, "timestamp": "01:16:32", "text": "私は十分な収入を得ており、"}, {"type": "subtitle", "time": 4594.87, "timestamp": "01:16:34", "text": "Jocknik からすべてを得ています。 私はすべての"}, {"type": "subtitle", "time": 4597.189, "timestamp": "01:16:37", "text": "収益と投資を"}, {"type": "subtitle", "time": 4602.07, "timestamp": "01:16:42", "text": "Onexiaに投入し、"}, {"type": "subtitle", "time": 4608.229, "timestamp": "01:16:48", "text": "Onexiaでやりたい他のプロジェクトのためにそれを適切な組織として成長させることができます。"}, {"type": "subtitle", "time": 4611.03, "timestamp": "01:16:51", "text": "これにはラベルを付け、あれこれとたくさんのことをします。これは"}, {"type": "subtitle", "time": 4614.229, "timestamp": "01:16:54", "text": "大きな夢であり、大きな"}, {"type": "subtitle", "time": 4616.95, "timestamp": "01:16:56", "text": "コミットメントです。だから、ウェブサイトを持っている理由でもあります。つまり、"}]
[{"type": "subtitle", "time": 856.069, "timestamp": "00:14:16", "text": "それでは、ここを情報"}, {"type": "subtitle", "time": 858.79, "timestamp": "00:14:18", "text": "ページとします。 ところで、先生、もし気になっていたとしたら、自己"}, {"type": "subtitle", "time": 861.35, "timestamp": "00:14:21", "text": "紹介ページはどうなっているのでしょうか？ これは依然として"}, {"type": "subtitle", "time": 863.91, "timestamp": "00:14:23", "text": "ウィキ形式です。"}, {"type": "subtitle", "time": 880.23, "timestamp": "00:14:40", "text": "このことについて心配しないでください。"}, {"type": "subtitle", "time": 882.71, "timestamp": "00:14:42", "text": "こういう私のやっていることなどの簡単なスナップショットを撮ろうと思ったんです。"}, {"type": "subtitle", "time": 888.17, "timestamp": "00:14:48", "text": "背景"}]
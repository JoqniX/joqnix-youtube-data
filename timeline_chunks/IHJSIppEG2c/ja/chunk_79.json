[{"type": "subtitle", "time": 4740.149, "timestamp": "01:19:00", "text": "正式な看板をデザインしていません。近いうちにきちんとデザインしなければなりません。"}, {"type": "subtitle", "time": 4744.79, "timestamp": "01:19:04", "text": "とりあえず、プロ仕様の、一時的な"}, {"type": "subtitle", "time": 4747.27, "timestamp": "01:19:07", "text": "フレックスボードを作りました。 ちゃんとした"}, {"type": "subtitle", "time": 4750.47, "timestamp": "01:19:10", "text": "アイロン台とか、そういうものを作らないといけないな。"}, {"type": "subtitle", "time": 4755.11, "timestamp": "01:19:15", "text": "ドアではなく、壁か何かに穴を開けてください。"}, {"type": "subtitle", "time": 4757.43, "timestamp": "01:19:17", "text": "私が何をしているのか、私は何者なのか、そしてそういったことすべてについて"}, {"type": "subtitle", "time": 4760.31, "timestamp": "01:19:20", "text": "？"}, {"type": "subtitle", "time": 4762.95, "timestamp": "01:19:22", "text": "モデルが完成するか、"}, {"type": "subtitle", "time": 4766.07, "timestamp": "01:19:26", "text": "将来的にそうなるのを待っています。 新しいモデルに"}, {"type": "subtitle", "time": 4768.229, "timestamp": "01:19:28", "text": "ブランドイメージか何かを載せたいんです。 わからない"}, {"type": "subtitle", "time": 4770.07, "timestamp": "01:19:30", "text": "。 でも、このロゴはそのまま残るか、あるいは"}, {"type": "subtitle", "time": 4772.07, "timestamp": "01:19:32", "text": "変更するかもしれません。 わからない"}, {"type": "subtitle", "time": 4774.07, "timestamp": "01:19:34", "text": "。"}, {"type": "chat", "time": 4775.414, "timestamp": "01:19:35", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "hmm like resume type stuff or a catalog"}, {"type": "subtitle", "time": 4776.55, "timestamp": "01:19:36", "text": "GST（物品サービス税）を登録してください。 はい、GST登録は"}, {"type": "subtitle", "time": 4778.709, "timestamp": "01:19:38", "text": "完了しました。 銀行口座を連携させるだけでいいんです"}, {"type": "subtitle", "time": 4781.59, "timestamp": "01:19:41", "text": "。 次に、"}, {"type": "subtitle", "time": 4785.189, "timestamp": "01:19:45", "text": "Incandex のオフィスの人たちと"}, {"type": "subtitle", "time": 4788.149, "timestamp": "01:19:48", "text": "銀行口座の人たち
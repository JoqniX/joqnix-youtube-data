[{"type": "subtitle", "time": 1764.23, "timestamp": "00:29:24", "text": "メインの「概要」ページには収まらない背景の詳細​​、プロジェクト履歴、出演情報、住所データなどのアーカイブ。"}, {"type": "subtitle", "time": 1766.149, "timestamp": "00:29:26", "text": "そこには、"}, {"type": "subtitle", "time": 1768.07, "timestamp": "00:29:28", "text": "簡単な"}, {"type": "subtitle", "time": 1769.669, "timestamp": "00:29:29", "text": "背景説明、初期の開発ログ、"}, {"type": "subtitle", "time": 1771.83, "timestamp": "00:29:31", "text": "Alexaを含む現在および過去の情報、"}, {"type": "subtitle", "time": 1775.51, "timestamp": "00:29:35", "text": "削除されたソースへのリンクが含まれています。"}, {"type": "subtitle", "time": 1779.029, "timestamp": "00:29:39", "text": "うん、いい感じだね。 ニース。 ニース。 よし、"}]
[{"type": "subtitle", "time": 4680.95, "timestamp": "01:18:00", "text": "口座だけだ。"}, {"type": "subtitle", "time": 4685.99, "timestamp": "01:18:05", "text": "当局の人たちが来て、"}, {"type": "subtitle", "time": 4688.95, "timestamp": "01:18:08", "text": "事業を検証したり、"}, {"type": "subtitle", "time": 4691.83, "timestamp": "01:18:11", "text": "直接訪問して、"}, {"type": "subtitle", "time": 4694.47, "timestamp": "01:18:14", "text": "これが何なのか、書類は何なのか、次に、ドアの前の"}, {"type": "chat", "time": 4696.088, "timestamp": "01:18:16", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "wait ya registered gstUCdZBnUb7m8Pd_wUTDNqUu3Q/5rHmZ4e5CJS3_9EP6970eAUCdZBnUb7m8Pd_wUTDNqUu3Q/5rHmZ4e5CJS3_9EP6970eA"}, {"type": "subtitle", "time": 4697.43, "timestamp": "01:18:17", "text": "看板に正しい GST 番号を記載したかどうかなどを確認する前に、ウェブサイトを完成させたかったんです。"}, {"type": "subtitle", "time": 4701.35, "timestamp": "01:18:21", "text": "ここは"}, {"type": "subtitle", "time": 4703.75, "timestamp": "01:18:23", "text": "今はオフィスなので、ストリーム ルームは"}, {"type": "subtitle", "time": 4706.47, "timestamp": "01:18:26", "text": "今はオフィスのようなものです。だから、"}, {"type": "subtitle", "time": 4714.55, "timestamp": "01:18:34", "text": "弁護士に会いに来る人が増えます。 そして隣のドア、"}, {"type": "subtitle", "time": 4716.55, "timestamp": "01:18:36", "text": "ここの隣のドアは弁護士"}, {"type": "subtitle", "time": 4719.189, "timestamp": "01:18:39", "text": "事務所みたいな感じなんです。 ここには弁護士が4人くらいいるよ"}, {"type": "subtitle", "time": 4721.59, "timestamp": "01:18:41", "text": "。 だから、お客さんが来るでしょう。"}, {"type": "subtitle", "time": 4724.07, "timestamp": "01:18:44", "text": "彼らは私の看板を見るはずですよね？"}, {"type": "subtitle", "time": 4727.35, "timestamp": "01:18:47", "text": "ジョック、住所とか"}, {"type": "subtitle", "time": 4730.47, "timestamp": "01:18:50", "text": "電話番号とか、全部。 だから、彼らは"}, {"type": "subtitle", "time": 4732.39, "timestamp": "01:18:52", "text": "ジョックって何者なのかとか、いろいろと疑問に思うだろう。"}, {"type": "subtitle", "time": 4735.669, "timestamp": "01:18:55", "text": "いいえ。なので、まだ"}]
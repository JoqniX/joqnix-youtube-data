[{"type": "subtitle", "time": 6672.55, "timestamp": "01:51:12", "text": "音楽シーンやボーカロイド"}, {"type": "subtitle", "time": 6677.109, "timestamp": "01:51:17", "text": "音楽シーンの大きなクリエイターのためにたくさんの仕事をしているのを見て、とても嬉しいです。"}, {"type": "subtitle", "time": 6680.709, "timestamp": "01:51:20", "text": "でも、私はただ、ただ、母の"}, {"type": "subtitle", "time": 6682.79, "timestamp": "01:51:22", "text": "最初のユーチューバーの子供になりたいだけなんです。それが私の願いです。ただ、"}, {"type": "subtitle", "time": 6693.75, "timestamp": "01:51:33", "text": "誇りに思えるような存在になりたいんです。「これが"}, {"type": "subtitle", "time": 6696.55, "timestamp": "01:51:36", "text": "私の母だ」って。"}, {"type": "subtitle", "time": 6698.709, "timestamp": "01:51:38", "text": "こちらは私の母です。"}, {"type": "subtitle", "time": 6701.189, "timestamp": "01:51:41", "text": "この人が"}, {"type": "subtitle", "time": 6704.229, "timestamp": "01:51:44", "text": "私のデザイン、モデル、その他すべてを作り上げてくれた人です"}, {"type": "subtitle", "time": 6705.99, "timestamp": "01:51:45", "text": "。 この人が"}, {"type": "subtitle", "time": 6709.669, "timestamp": "01:51:49", "text": "魔法をかけて、こんなに美しく仕上げてくれたんです。"}, {"type": "chat", "time": 6712.355, "timestamp": "01:51:52", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "you are still the one trust man ... patience is the key"}]
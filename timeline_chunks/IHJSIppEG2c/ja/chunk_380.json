[{"type": "chat", "time": 22803.499, "timestamp": "06:20:03", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "and?"}, {"type": "subtitle", "time": 22803.83, "timestamp": "06:20:03", "text": "ダサンと歌の練習をしていました。"}, {"type": "subtitle", "time": 22811.03, "timestamp": "06:20:11", "text": "みんなと一緒に招待に参加して、"}, {"type": "subtitle", "time": 22814.788, "timestamp": "06:20:14", "text": "夕食後にエビを食べ始めました。それだけです"}, {"type": "subtitle", "time": 22817.91, "timestamp": "06:20:17", "text": "。午後6時か7時頃です。わかりました。6時半に起きました。7"}, {"type": "subtitle", "time": 22822.31, "timestamp": "06:20:22", "text": "時半に、えーと、"}, {"type": "subtitle", "time": 22825.51, "timestamp": "06:20:25", "text": "VCNに行って、VCに座って、"}, {"type": "subtitle", "time": 22829.75, "timestamp": "06:20:29", "text": "1時間音楽を練習して、"}, {"type": "subtitle", "time": 22833.11, "timestamp": "06:20:33", "text": "配信を始めました。"}, {"type": "subtitle", "time": 22837.35, "timestamp": "06:20:37", "text": "これを終えたら新しい配信を始めます。"}, {"type": "subtitle", "time": 22839.43, "timestamp": "06:20:39", "text": "そして"}, {"type": "subtitle", "time": 22841.11, "timestamp": "06:20:41", "text": "、これを終えたら、"}, {"type": "chat", "time": 22843.209, "timestamp": "06:20:43", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "Didn't you feel exhausted?"}, {"type": "subtitle", "time": 22844.868, "timestamp": "06:20:44", "text": "新しい配信を始めます。ピークソロランをします。"}, {"type": "subtitle", "time": 22846.788, "timestamp": "06:20:46", "text": "スピードランをします。"}, {"type": "subtitle", "time": 22853.98, "timestamp": "06:20:53", "text": "でも、完全に目が覚めています。"}, {"type": "subtitle", "time": 22856.708, "timestamp": "06:20:56", "text": "[笑い]"}, {"type": "subtitle", "time": 22859.11, "timestamp": "06:20:59", "text": "わかりません。"}]
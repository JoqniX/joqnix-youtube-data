[{"type": "subtitle", "time": 363.909, "timestamp": "00:06:03", "text": "8時から9時まででした。 えっと、ダサン"}, {"type": "subtitle", "time": 366.95, "timestamp": "00:06:06", "text": "と私は、えっと、"}, {"type": "subtitle", "time": 370.15, "timestamp": "00:06:10", "text": "今日その曲の練習に参加したんだけど、"}, {"type": "subtitle", "time": 372.55, "timestamp": "00:06:12", "text": "えっと、"}, {"type": "subtitle", "time": 375.59, "timestamp": "00:06:15", "text": "美しいジョンの曲をやったんだけど、よかった"}, {"type": "subtitle", "time": 378.07, "timestamp": "00:06:18", "text": "。"}, {"type": "subtitle", "time": 381.99, "timestamp": "00:06:21", "text": "今日はどんな一日でしたか？ えっと、私はずっと"}, {"type": "subtitle", "time": 384.309, "timestamp": "00:06:24", "text": "寝ていました。"}, {"type": "subtitle", "time": 387.749, "timestamp": "00:06:27", "text": "睡眠習慣を本当に改善する必要がある。"}, {"type": "subtitle", "time": 390.55, "timestamp": "00:06:30", "text": "問題は、今、12時間"}, {"type": "subtitle", "time": 394.469, "timestamp": "00:06:34", "text": "か、何て言うか分からないけど10時間以上の"}, {"type": "subtitle", "time": 397.909, "timestamp": "00:06:37", "text": "ストリームをソロPEでソロランして、"}, {"type": "subtitle", "time": 401.59000000000003, "timestamp": "00:06:41", "text": "登山ゲームのピークを登りたいということ。 私もそうし"}, {"type": "subtitle", "time": 404.79, "timestamp": "00:06:44", "text": "たいです。 私はやりたいことが"}, {"type": "subtitle", "time": 413.11, "timestamp": "00:06:53", "text": "。"}, {"type": "subtitle", "time": 415.67, "timestamp": "00:06:55", "text": "私が考えているのは、あの"}, {"type": "subtitle", "time": 419.589, "timestamp": "00:06:59", "text": "ゲームをプレイしたいということだけです。 私は自分がやるべきことをやりたくない"}]
[{"type": "subtitle", "time": 2041.11, "timestamp": "00:34:01", "text": "？"}, {"type": "subtitle", "time": 2043.43, "timestamp": "00:34:03", "text": "日本語で文字通り「虚栄心」という意味です。 ええ、もちろんです。   私ならできます。"}, {"type": "subtitle", "time": 2057.19, "timestamp": "00:34:17", "text": "何？ 待って、練習では何をすればいいの？"}, {"type": "subtitle", "time": 2067.99, "timestamp": "00:34:27", "text": "待って、新しいチャージアカウントを作った方がいいかな？"}, {"type": "subtitle", "time": 2070.95, "timestamp": "00:34:30", "text": "そうすれば、残高がなくなっても困らないし"}, {"type": "subtitle", "time": 2079.349, "timestamp": "00:34:39", "text": "待てよ、ドイツなら使えるぞ。"}, {"type": "subtitle", "time": 2081.99, "timestamp": "00:34:41", "text": "ドイツ。"}]
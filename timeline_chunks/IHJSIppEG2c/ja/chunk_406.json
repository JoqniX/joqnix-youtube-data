[{"type": "subtitle", "time": 24381.99, "timestamp": "06:46:21", "text": "だから、その家にはチキンカレーがあるんです"}, {"type": "subtitle", "time": 24385.03, "timestamp": "06:46:25", "text": "。 お米はあります。"}, {"type": "subtitle", "time": 24389.51, "timestamp": "06:46:29", "text": "6時前に"}, {"type": "subtitle", "time": 24392.948, "timestamp": "06:46:32", "text": "朝食を食べに行くべきでしょうか？ 午前6時。夜事だ。"}, {"type": "subtitle", "time": 24396.868, "timestamp": "06:46:36", "text": "わかった、温めて食べて、"}, {"type": "subtitle", "time": 24400.628, "timestamp": "06:46:40", "text": "チャイかお茶を飲んで戻ってくるよ"}, {"type": "subtitle", "time": 24403.91, "timestamp": "06:46:43", "text": "。  2つ目のストリームを開始します。"}, {"type": "subtitle", "time": 24407.27, "timestamp": "06:46:47", "text": "サムネイルを作らなきゃ。"}, {"type": "subtitle", "time": 24410.23, "timestamp": "06:46:50", "text": "神に誓って、もし眠気を感じたり、"}, {"type": "subtitle", "time": 24411.99, "timestamp": "06:46:51", "text": "これを諦めたりしたら、"}, {"type": "subtitle", "time": 24413.99, "timestamp": "06:46:53", "text": "寝るつもりだ。   やらなければならない"}]
[{"type": "subtitle", "time": 6120.95, "timestamp": "01:42:00", "text": "ええ、それが一番重要な点です。"}, {"type": "subtitle", "time": 6122.79, "timestamp": "01:42:02", "text": "一体何を隠しているんだ"}, {"type": "subtitle", "time": 6124.47, "timestamp": "01:42:04", "text": "？ 彼らは何を隠しているんだろう"}, {"type": "subtitle", "time": 6126.709, "timestamp": "01:42:06", "text": "、みたいな感じですよね？ だから、"}, {"type": "subtitle", "time": 6128.149, "timestamp": "01:42:08", "text": "全員に強制的に適用されたのです。 でも"}, {"type": "subtitle", "time": 6130.47, "timestamp": "01:42:10", "text": "最近は、以前よりずっとリラックスした雰囲気になっているように感じます。"}, {"type": "subtitle", "time": 6133.91, "timestamp": "01:42:13", "text": "人々はたくさん得ていると思います"}, {"type": "chat", "time": 6136.057, "timestamp": "01:42:16", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ8_8KpS3_9EP-duW6QoUCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ8_8KpS3_9EP-duW6QoUCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ8_8KpS3_9EP-duW6Qo"}, {"type": "subtitle", "time": 6137.669, "timestamp": "01:42:17", "text": "。 一体どういうことだ？"}, {"type": "subtitle", "time": 6139.51, "timestamp": "01:42:19", "text": "ありがとうございます。"}, {"type": "subtitle", "time": 6140.79, "timestamp": "01:42:20", "text": "どうやらこれはもう在庫が少なくなってきているようだ"}, {"type": "subtitle", "time": 6142.07, "timestamp": "01:42:22", "text": "。"}, {"type": "subtitle", "time": 6143.03, "timestamp": "01:42:23", "text": "うまく出てこないような感じだ。"}, {"type": "subtitle", "time": 6143.669, "timestamp": "01:42:23", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 6152.47, "timestamp": "01:42:32", "text": "彼の字はすごくかっこいい。"}, {"type": "subtitle", "time": 6156.39, "timestamp": "01:42:36", "text": "彼はまるで木を書くようにVの字を書く。"}, {"type": "subtitle", "time": 6167.59, "timestamp": "01:42:47", "text": "うん、いい映像だったね。 これは"}, {"type": "subtitle", "time": 6170.95, "timestamp": "01:42:50", "text": "最近私の推薦リストに表示されました。 私は"}, {"type": "subtitle", "time": 6174.229, "timestamp": "01:42:54", "text": "「ああ」という感じでした。 だから、私の言ったことは正しかったんです。ずっと前に"}]
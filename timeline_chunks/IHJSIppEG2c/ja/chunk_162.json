[{"type": "subtitle", "time": 9720.95, "timestamp": "02:42:00", "text": "どうやって部屋を掃除してるの"}, {"type": "subtitle", "time": 9723.91, "timestamp": "02:42:03", "text": "？ こんな私で、日本で一人でどうやって"}, {"type": "subtitle", "time": 9727.03, "timestamp": "02:42:07", "text": "生きていけるだろうか"}, {"type": "subtitle", "time": 9729.51, "timestamp": "02:42:09", "text": "？ こんな風に怠けていると、"}, {"type": "subtitle", "time": 9732.79, "timestamp": "02:42:12", "text": "毎日部屋を全部掃除しなくちゃいけない。"}, {"type": "subtitle", "time": 9735.83, "timestamp": "02:42:15", "text": "ゴールドレベルほどではない。 私たちはそんなに"}, {"type": "subtitle", "time": 9738.309, "timestamp": "02:42:18", "text": "汚いわけじゃない。"}, {"type": "subtitle", "time": 9741.03, "timestamp": "02:42:21", "text": "ええ、そうですね。   まるで"}, {"type": "subtitle", "time": 9754.55, "timestamp": "02:42:34", "text": "うん。"}, {"type": "subtitle", "time": 9758.18, "timestamp": "02:42:38", "text": "ジョークはルーム"}, {"type": "subtitle", "time": 9760.309, "timestamp": "02:42:40", "text": "ミュージック"}]
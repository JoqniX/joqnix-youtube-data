[{"type": "subtitle", "time": 1454.87, "timestamp": "00:24:14", "text": "正確には、"}, {"type": "subtitle", "time": 1457.029, "timestamp": "00:24:17", "text": "私はそれをしていません。 その機能を追加する必要があります"}, {"type": "subtitle", "time": 1459.99, "timestamp": "00:24:19", "text": "。"}, {"type": "chat", "time": 1470.984, "timestamp": "00:24:30", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "RP as in \"British RP\" ?"}, {"type": "subtitle", "time": 1471.59, "timestamp": "00:24:31", "text": "問題は、"}, {"type": "subtitle", "time": 1474.63, "timestamp": "00:24:34", "text": "情報ページと概要"}, {"type": "subtitle", "time": 1482.23, "timestamp": "00:24:42", "text": "RPNはイギリス英語のRP（容認発音）と同じ。"}, {"type": "chat", "time": 1487.616, "timestamp": "00:24:47", "author": "@AFroznThorn", "avatar": "https://yt4.ggpht.com/UOd53-ssefezO2JWGQi-gSpM4zglLHS2XVfc2UQu3E-TdNk2KGnAZtWYAYqQBudbEouoIqf3=s64-c-k-c0x00ffffff-no-rj", "message": "sometimes even just saying \"I want to\" updates it's memory to doing"}, {"type": "subtitle", "time": 1495.83, "timestamp": "00:24:55", "text": "ああ、来週の7月24日にブループロトコルの"}]
[{"type": "subtitle", "time": 12207.75, "timestamp": "03:23:27", "text": "あなたはどう思ってる？そして私はあなたについてどう思ってる"}, {"type": "subtitle", "time": 12226.87, "timestamp": "03:23:46", "text": "問題は、ここでそれを"}, {"type": "subtitle", "time": 12229.269, "timestamp": "03:23:49", "text": "やっているのが私だから"}, {"type": "subtitle", "time": 12231.67, "timestamp": "03:23:51", "text": "変な感じがするんだけど、誰かが"}, {"type": "subtitle", "time": 12235.67, "timestamp": "03:23:55", "text": "私のためにやってくれたらもっと"}, {"type": "subtitle", "time": 12238.71, "timestamp": "03:23:58", "text": "いいのにってこと。それは私が"}]
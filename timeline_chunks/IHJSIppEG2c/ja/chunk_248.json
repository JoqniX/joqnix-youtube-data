[{"type": "subtitle", "time": 14885.269, "timestamp": "04:08:05", "text": "一般的なものを選びなさい。 ああ、"}, {"type": "subtitle", "time": 14905.67, "timestamp": "04:08:25", "text": "さあ、私が戻ってきたところを想像してみてください。 私は"}, {"type": "subtitle", "time": 14908.71, "timestamp": "04:08:28", "text": "今やラスボスのような存在だ。 私は誰かと戦っている。 私たちは二人とも"}, {"type": "subtitle", "time": 14913.429, "timestamp": "04:08:33", "text": "戦っている。 刺されたり、"}, {"type": "subtitle", "time": 14919.99, "timestamp": "04:08:39", "text": "刃物か剣か何かで引っかき傷を負ったりする。 それは、"}, {"type": "subtitle", "time": 14930.71, "timestamp": "04:08:50", "text": "血液型で性格を判断するトランスジェンダーによる傷跡か何かのようなものだ"}, {"type": "subtitle", "time": 14939.75, "timestamp": "04:08:59", "text": "実は、それについては考えていませんでした。"}]
[{"type": "subtitle", "time": 9989.67, "timestamp": "02:46:29", "text": "なぜ話さなかったのですか？ 私はずっと"}, {"type": "subtitle", "time": 9992.309, "timestamp": "02:46:32", "text": "配信を一時停止していました。"}, {"type": "subtitle", "time": 9995.21, "timestamp": "02:46:35", "text": "大丈夫。 心配ない。"}, {"type": "subtitle", "time": 9998.55, "timestamp": "02:46:38", "text": "[音楽]"}, {"type": "subtitle", "time": 10002.15, "timestamp": "02:46:42", "text": "明日は"}, {"type": "subtitle", "time": 10004.95, "timestamp": "02:46:44", "text": "今山に登っているゲームのピークに挑戦する予定です。 そうするつもりです"}, {"type": "subtitle", "time": 10007.269, "timestamp": "02:46:47", "text": "。"}, {"type": "subtitle", "time": 10009.429, "timestamp": "02:46:49", "text": "実はそのためには早起きしないといけないんです。"}]
[{"type": "subtitle", "time": 23824.07, "timestamp": "06:37:04", "text": "新旧の星座と共鳴できるんです。つまり、"}, {"type": "subtitle", "time": 23826.23, "timestamp": "06:37:06", "text": "既存の古い星座と、新しい"}, {"type": "subtitle", "time": 23829.75, "timestamp": "06:37:09", "text": "星座も作れるんです。もう1つも"}, {"type": "subtitle", "time": 23832.39, "timestamp": "06:37:12", "text": "ない星座も。"}, {"type": "subtitle", "time": 23834.948, "timestamp": "06:37:14", "text": "獅子座と他の何かを融合させるように、"}, {"type": "subtitle", "time": 23840.15, "timestamp": "06:37:20", "text": "新しい星座のタイプができて、その"}, {"type": "subtitle", "time": 23842.948, "timestamp": "06:37:22", "text": "星座と共鳴できるんです。自分"}, {"type": "subtitle", "time": 23845.83, "timestamp": "06:37:25", "text": "自身と共鳴することで、"}, {"type": "subtitle", "time": 23848.07, "timestamp": "06:37:28", "text": "ユニークな武器、つまり"}, {"type": "subtitle", "time": 23850.39, "timestamp": "06:37:30", "text": "成長武器が手に入るんです。"}, {"type": "subtitle", "time": 23853.03, "timestamp": "06:37:33", "text": "私が今いるフェーズに関係なく、私と一緒に成長します"}, {"type": "subtitle", "time": 23856.468, "timestamp": "06:37:36", "text": "。そうだよね？だから、デビューしたら"}, {"type": "subtitle", "time": 23862.708, "timestamp": "06:37:42", "text": "フェーズ1になります。つまり、次の星座のフェーズ1には"}, {"type": "subtitle", "time": 23866.948, "timestamp": "06:37:46", "text": "特定のものがあって、それから"}, {"type": "subtitle", "time": 23870.31, "timestamp": "06:37:50", "text": "未来のアセンションでは、フェーズ"}, {"type": "subtitle", "time": 23874.31, "timestamp": "06:37:54", "text": "2、3、4、5、6などになって、より"}, {"type": "subtitle", "time": 23876.708, "timestamp": "06:37:56", "text": "暗いバージョン、"}, {"type": "subtitle", "time": 23879.99, "timestamp": "06:37:59", "text": "邪悪なバージョンが見られるでしょう。さまざまなテーマのバージョンも見られるでしょう。"}]
[{"type": "subtitle", "time": 24068.15, "timestamp": "06:41:08", "text": "黒髪とか全部のダークバージョンのコンセプトはあった。うん"}, {"type": "subtitle", "time": 24071.35, "timestamp": "06:41:11", "text": "、今は白髪だから、"}, {"type": "subtitle", "time": 24078.39, "timestamp": "06:41:18", "text": "でも、"}, {"type": "subtitle", "time": 24081.75, "timestamp": "06:41:21", "text": "今の新しいモデルの品質を考えると、お"}, {"type": "subtitle", "time": 24086.07, "timestamp": "06:41:26", "text": "金持ちにならないといけないと思う。 新しいバージョンのために1000ドルくらいのアートを買う余裕があるくらいお金持ちにならないと、"}, {"type": "subtitle", "time": 24092.868, "timestamp": "06:41:32", "text": "今は高くつくから。うん。"}, {"type": "subtitle", "time": 24095.67, "timestamp": "06:41:35", "text": "アーティストを変えることもできるけど、私はこだわりが強すぎる"}, {"type": "subtitle", "time": 24097.51, "timestamp": "06:41:37", "text": "。"}, {"type": "subtitle", "time": 24100.708, "timestamp": "06:41:40", "text": "オリジナルのアーティストのママにお願いしたい。だから、"}, {"type": "subtitle", "time": 24104.468, "timestamp": "06:41:44", "text": "うん。だから、今は他の別バージョンは期待しないで"}, {"type": "subtitle", "time": 24107.03, "timestamp": "06:41:47", "text": "。それは"}, {"type": "subtitle", "time": 24109.99, "timestamp": "06:41:49", "text": "3、4年後、"}]
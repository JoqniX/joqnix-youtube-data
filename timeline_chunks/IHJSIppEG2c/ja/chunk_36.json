[{"type": "subtitle", "time": 2163.27, "timestamp": "00:36:03", "text": "電話を切るにはどうすればいいですか？"}, {"type": "subtitle", "time": 2180.95, "timestamp": "00:36:20", "text": "[音楽]"}, {"type": "subtitle", "time": 2195.109, "timestamp": "00:36:35", "text": "私はしたくない。"}, {"type": "subtitle", "time": 2202.71, "timestamp": "00:36:42", "text": "音声モードを使いたいのですが、その方が適しています"}]
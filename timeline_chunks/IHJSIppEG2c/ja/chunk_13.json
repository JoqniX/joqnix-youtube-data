[{"type": "subtitle", "time": 780.389, "timestamp": "00:13:00", "text": "できると思う。"}, {"type": "subtitle", "time": 784.31, "timestamp": "00:13:04", "text": "デザインと、"}, {"type": "subtitle", "time": 786.949, "timestamp": "00:13:06", "text": "一時的な時代の"}, {"type": "subtitle", "time": 797.99, "timestamp": "00:13:17", "text": "ジョアソン、未来の時代のストリーミングの目標"}, {"type": "subtitle", "time": 804.87, "timestamp": "00:13:24", "text": "必要なのは、なぜこう書いてあるのか、兄弟？ ドキュメント"}, {"type": "subtitle", "time": 806.79, "timestamp": "00:13:26", "text": "アプリマネージャー。 それが何かわからない場合は"}, {"type": "subtitle", "time": 811.67, "timestamp": "00:13:31", "text": "、プロンプトに「"}, {"type": "subtitle", "time": 817.509, "timestamp": "00:13:37", "text": "カスタムアプリランチャー"}, {"type": "subtitle", "time": 820.629, "timestamp": "00:13:40", "text": "、つまりスタートアップランチャーのようなものを作りたい」と入力しました。"}, {"type": "subtitle", "time": 823.19, "timestamp": "00:13:43", "text": "つまり、アプリランチャーっていうのはそういうことなんですね"}, {"type": "subtitle", "time": 839.67, "timestamp": "00:13:59", "text": "待っていてください。 待っていてください。 待っていてください。   そして、これだ。   わかった"}]
[{"type": "subtitle", "time": 4620.149, "timestamp": "01:17:00", "text": "ほとんどの人がウェブサイトを持っています。ウェブサイトを持つことは"}, {"type": "subtitle", "time": 4624.63, "timestamp": "01:17:04", "text": "問題ありません。"}, {"type": "subtitle", "time": 4628.55, "timestamp": "01:17:08", "text": "今は普通のウェブサイトを持っていて、時間をかけて拡張していきます。"}, {"type": "subtitle", "time": 4630.79, "timestamp": "01:17:10", "text": "私も以前はcard.co icalの"}, {"type": "subtitle", "time": 4639.03, "timestamp": "01:17:19", "text": "シンプルなウェブサイトを持っていて、そこに"}, {"type": "subtitle", "time": 4645.51, "timestamp": "01:17:25", "text": "うん。 そして、時間が経つにつれて、たくさんの"}, {"type": "subtitle", "time": 4660.709, "timestamp": "01:17:40", "text": "時間を無駄にしないでほしい。"}, {"type": "subtitle", "time": 4662.87, "timestamp": "01:17:42", "text": "コンテンツ制作、それも適切なコンテンツ制作に集中する"}, {"type": "subtitle", "time": 4664.709, "timestamp": "01:17:44", "text": "。 地域社会とあらゆることに焦点を当てる"}, {"type": "chat", "time": 4668.398, "timestamp": "01:17:48", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "hmm like growing of a tree branches keep expanding"}, {"type": "subtitle", "time": 4668.79, "timestamp": "01:17:48", "text": "。 私はあまりうまくできなかったと感じていて、もう"}, {"type": "subtitle", "time": 4676.95, "timestamp": "01:17:56", "text": "登録は済ませたと思っています。 えっと、GSTの件も"}, {"type": "subtitle", "time": 4678.63, "timestamp": "01:17:58", "text": "全部終わりました。 そこにあるのは銀行"}]
[{"type": "subtitle", "time": 422.95, "timestamp": "00:07:02", "text": "。"}, {"type": "subtitle", "time": 425.43, "timestamp": "00:07:05", "text": "私はたくさんの人が走っているのを見ていて、えーっと、ほら、もっといるよ"}, {"type": "subtitle", "time": 432.629, "timestamp": "00:07:12", "text": "。  20人追加して、"}, {"type": "subtitle", "time": 435.51, "timestamp": "00:07:15", "text": "登山のように楽しむこともできます。 それで、"}, {"type": "subtitle", "time": 437.189, "timestamp": "00:07:17", "text": "今朝それらのビデオを見て、"}, {"type": "subtitle", "time": 442.469, "timestamp": "00:07:22", "text": "それを見た後で寝てしまい、それからいくつかのゴールドのビデオを見て、"}, {"type": "subtitle", "time": 450.629, "timestamp": "00:07:30", "text": "Twitchなどのことについて話されていました。"}, {"type": "subtitle", "time": 459.189, "timestamp": "00:07:39", "text": "今、眠いです。"}, {"type": "subtitle", "time": 461.909, "timestamp": "00:07:41", "text": "はい、眠気を感じます。"}, {"type": "subtitle", "time": 464.07, "timestamp": "00:07:44", "text": "えっと、目を閉じると今すぐ"}, {"type": "subtitle", "time": 465.99, "timestamp": "00:07:45", "text": "眠ってしまいそうな感じがするけど、眠っちゃいけないんだよね"}, {"type": "subtitle", "time": 470.23, "timestamp": "00:07:50", "text": "。 今、配信を始めたところです。"}]
[{"type": "subtitle", "time": 12900.63, "timestamp": "03:35:00", "text": "。 あるいは、試運転のための何か。   だって、"}, {"type": "subtitle", "time": 12904.63, "timestamp": "03:35:04", "text": "今はちゃんとしたマーチャンダイジング"}, {"type": "subtitle", "time": 12909.349, "timestamp": "03:35:09", "text": "会社とか、"}, {"type": "subtitle", "time": 12915.11, "timestamp": "03:35:15", "text": "発送とか配送"}, {"type": "subtitle", "time": 12917.429, "timestamp": "03:35:17", "text": "とかそういうことを手伝ってくれる会社が必要なんだよ。   だから、どうしたらいいのか分からなくて困っています"}, {"type": "subtitle", "time": 12920.95, "timestamp": "03:35:20", "text": "。   やりたいです"}, {"type": "subtitle", "time": 12924.55, "timestamp": "03:35:24", "text": "。"}, {"type": "subtitle", "time": 12927.75, "timestamp": "03:35:27", "text": "うん。 私自身も、"}, {"type": "subtitle", "time": 12929.99, "timestamp": "03:35:29", "text": "自分のグッズや"}]
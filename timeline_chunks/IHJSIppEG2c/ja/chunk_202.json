[{"type": "subtitle", "time": 12127.51, "timestamp": "03:22:07", "text": "。 いいえ。Onexiaは"}, {"type": "subtitle", "time": 12133.11, "timestamp": "03:22:13", "text": "私の情熱を注いだプロジェクトです。   何てことだ"}, {"type": "subtitle", "time": 12138.229, "timestamp": "03:22:18", "text": "。 私の"}, {"type": "subtitle", "time": 12141.03, "timestamp": "03:22:21", "text": "ダークンコミュニティでのコミュニティ名（ファンネーム）は、"}, {"type": "subtitle", "time": 12149.83, "timestamp": "03:22:29", "text": "coners slash"}, {"type": "subtitle", "time": 12151.51, "timestamp": "03:22:31", "text": "concert"}, {"type": "subtitle", "time": 12154.07, "timestamp": "03:22:34", "text": "plates です。"}, {"type": "subtitle", "time": 12158.309, "timestamp": "03:22:38", "text": "ファンウィキからいくつか情報を引用させてください"}, {"type": "subtitle", "time": 12160.309, "timestamp": "03:22:40", "text": "。"}, {"type": "subtitle", "time": 12161.99, "timestamp": "03:22:41", "text": "うん、"}, {"type": "subtitle", "time": 12166.389, "timestamp": "03:22:46", "text": "ファントム・ヴィックから情報をいくつか削除する必要があるかもしれないと思う。   ええ"}]
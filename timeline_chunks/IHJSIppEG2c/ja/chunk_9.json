[{"type": "subtitle", "time": 547.11, "timestamp": "00:09:07", "text": "今、君が覚えているように、僕も12"}, {"type": "subtitle", "time": 556.55, "timestamp": "00:09:16", "text": "私はそれにすっかり夢中になっていた。"}, {"type": "subtitle", "time": 559.19, "timestamp": "00:09:19", "text": "声が出なくなっても、私は気にしなかった。  「よし、"}, {"type": "subtitle", "time": 562.15, "timestamp": "00:09:22", "text": "これはうまくいくぞ」って思った。   やってみます"}, {"type": "subtitle", "time": 571.269, "timestamp": "00:09:31", "text": "あの配信が懐かしい。 私は"}, {"type": "subtitle", "time": 574.79, "timestamp": "00:09:34", "text": "それらの配信を行うべきだ。 最近。 でも、ダサンは、"}, {"type": "subtitle", "time": 581.67, "timestamp": "00:09:41", "text": "一度に1曲ずつ集中して学ぶべきで、"}, {"type": "subtitle", "time": 583.91, "timestamp": "00:09:43", "text": "複数の"}, {"type": "subtitle", "time": 587.829, "timestamp": "00:09:47", "text": "曲に飛びついて学ぶのは悪い"}]
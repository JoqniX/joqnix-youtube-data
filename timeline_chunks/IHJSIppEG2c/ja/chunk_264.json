[{"type": "subtitle", "time": 15845.51, "timestamp": "04:24:05", "text": "カジュアルなカレンダーなど。"}, {"type": "subtitle", "time": 15848.149, "timestamp": "04:24:08", "text": "オーディオは、オーディエンス主導ですか、それとも"}, {"type": "subtitle", "time": 15851.11, "timestamp": "04:24:11", "text": "クリエイター主導ですか？ チャドが決定を下すか、"}, {"type": "subtitle", "time": 15854.309, "timestamp": "04:24:14", "text": "あなたが体験を主導するか。"}, {"type": "subtitle", "time": 15860.389, "timestamp": "04:24:20", "text": "意欲型についてですが、私は"}, {"type": "subtitle", "time": 15863.51, "timestamp": "04:24:23", "text": "クリエイター志向だと思います。   場合によると思います"}, {"type": "subtitle", "time": 15868.95, "timestamp": "04:24:28", "text": "。 考えてる、考えてる、"}, {"type": "subtitle", "time": 15872.469, "timestamp": "04:24:32", "text": "待って、私は観客主導型なのか？ どちらもリーダーシップ"}, {"type": "subtitle", "time": 15882.55, "timestamp": "04:24:42", "text": "ええと、ある意味では両方だと思います。"}, {"type": "subtitle", "time": 15898.149, "timestamp": "04:24:58", "text": "ストリーミングスタイルではただ"}]
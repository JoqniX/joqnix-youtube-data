[{"type": "subtitle", "time": 4200.55, "timestamp": "01:10:00", "text": "始まりや、何が"}, {"type": "chat", "time": 4201.243, "timestamp": "01:10:01", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "yeah yeah"}, {"type": "subtitle", "time": 4204.31, "timestamp": "01:10:04", "text": "私にジョイクスをやるきっかけになったのかなど、あらゆることを共有しようとしています。"}, {"type": "subtitle", "time": 4206.95, "timestamp": "01:10:06", "text": "今では、誰かに"}, {"type": "subtitle", "time": 4209.669, "timestamp": "01:10:09", "text": "聞かれたらいつもそう答えています。 右？ だから、"}, {"type": "subtitle", "time": 4211.43, "timestamp": "01:10:11", "text": "これらの"}, {"type": "subtitle", "time": 4213.43, "timestamp": "01:10:13", "text": "よくある質問を"}, {"type": "subtitle", "time": 4216.31, "timestamp": "01:10:16", "text": "詳細な形式でウェブサイトに掲載しようと思ったんです。そうすれば、"}, {"type": "subtitle", "time": 4223.43, "timestamp": "01:10:23", "text": "来月とか、3"}, {"type": "subtitle", "time": 4226.149, "timestamp": "01:10:26", "text": "週間後とか2週間後に、誰かが"}, {"type": "subtitle", "time": 4228.31, "timestamp": "01:10:28", "text": "新しい視聴者で、私のことやその他すべてについて知りたいと思ったときに、「"}, {"type": "subtitle", "time": 4236.95, "timestamp": "01:10:36", "text": "私の始まりやその他すべてについて知りたいなら、ウェブサイトを見てください」と答えることができます。また、"}, {"type": "subtitle", "time": 4244.31, "timestamp": "01:10:44", "text": "ストリームでどのように始めたかなども説明できます。そして、"}, {"type": "subtitle", "time": 4246.47, "timestamp": "01:10:46", "text": "その人はウェブ"}, {"type": "subtitle", "time": 4252.709, "timestamp": "01:10:52", "text": "サイトに行って理論的で"}, {"type": "subtitle", "time": 4256.149, "timestamp": "01:10:56", "text": "非常に詳細なものを見ることで、私が口頭で言った主張を検証することもできます。そう、それが"}, {"type": "subtitle", "time": 4259.51, "timestamp": "01:10:59", "text": "私が"}]
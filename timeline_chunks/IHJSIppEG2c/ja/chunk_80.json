[{"type": "subtitle", "time": 4802.55, "timestamp": "01:20:02", "text": "eコマースのウェブサイト"}, {"type": "subtitle", "time": 4805.03, "timestamp": "01:20:05", "text": "や商品などのために、どのような法的文書を準備すればいいのか、どうやって調べればいいのかを聞かなければなりません。それから、商品などを生産するのを手伝ってくれる"}, {"type": "subtitle", "time": 4807.189, "timestamp": "01:20:07", "text": "人を探さなければなりません。"}, {"type": "subtitle", "time": 4815.669, "timestamp": "01:20:15", "text": "誰も手伝ってくれなければ、自分でストリームで作ります。"}, {"type": "subtitle", "time": 4822.95, "timestamp": "01:20:22", "text": "編み物や、おもちゃなどを作る方法を学ぼうと思っています。"}, {"type": "subtitle", "time": 4828.07, "timestamp": "01:20:28", "text": "自分でやってみようと思って、1つか"}, {"type": "subtitle", "time": 4830.709, "timestamp": "01:20:30", "text": "2つ、"}, {"type": "subtitle", "time": 4834.39, "timestamp": "01:20:34", "text": "1つか3つか4つくらい自分で作って、"}, {"type": "chat", "time": 4836.405, "timestamp": "01:20:36", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "why not start with mugs or something"}, {"type": "subtitle", "time": 4837.189, "timestamp": "01:20:37", "text": "サンプルを売ったり、"}, {"type": "subtitle", "time": 4840.07, "timestamp": "01:20:40", "text": "サンプルを無料で提供したりしようと思っています。 それから、"}, {"type": "subtitle", "time": 4842.87, "timestamp": "01:20:42", "text": "人々がそれを使って、"}, {"type": "subtitle", "time": 4845.27, "timestamp": "01:20:45", "text": "1、2か月後に壊れていなければ、すべてがうまくいけば"}, {"type": "chat", "time": 4845.951, "timestamp": "01:20:45", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "those guys are easy to work with"}, {"type": "subtitle", "time": 4851.27, "timestamp": "01:20:51", "text": "、私は、"}, {"type": "subtitle", "time": 4859.43, "timestamp": "01:20:59", "text": "マグカップなどをきちんと自分で作ります。 しかし、"}]
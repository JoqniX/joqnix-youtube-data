[{"type": "chat", "time": 6180.211, "timestamp": "01:43:00", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "I have a email handwriting"}, {"type": "subtitle", "time": 6183.27, "timestamp": "01:43:03", "text": "Twitchで、ある視聴者が「ああ、あなたはインド人だ"}, {"type": "chat", "time": 6183.817, "timestamp": "01:43:03", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/5rHmZ4e5CJS3_9EP6970eAUCdZBnUb7m8Pd_wUTDNqUu3Q/5rHmZ4e5CJS3_9EP6970eAUCdZBnUb7m8Pd_wUTDNqUu3Q/5rHmZ4e5CJS3_9EP6970eA"}, {"type": "subtitle", "time": 6186.47, "timestamp": "01:43:06", "text": "けど、あなたのキャラクターの肌の色は、"}, {"type": "subtitle", "time": 6191.51, "timestamp": "01:43:11", "text": "あなたの実際の肌の色と"}, {"type": "subtitle", "time": 6196.629, "timestamp": "01:43:16", "text": "キャラクターの"}, {"type": "subtitle", "time": 6199.59, "timestamp": "01:43:19", "text": "トーンが合っていないように感じるんだけど」と言ってきたんです。 そして私は"}, {"type": "subtitle", "time": 6201.109, "timestamp": "01:43:21", "text": "「わあ、そんなことはどうでも"}, {"type": "subtitle", "time": 6203.59, "timestamp": "01:43:23", "text": "いい。"}, {"type": "subtitle", "time": 6206.629, "timestamp": "01:43:26", "text": "これは架空のキャラクターなんだから。"}, {"type": "subtitle", "time": 6209.03, "timestamp": "01:43:29", "text": "私はなりたい自分になれるし、どんな肌の"}, {"type": "subtitle", "time": 6211.59, "timestamp": "01:43:31", "text": "色にもなれる」と思ったんです。 それで彼らは"}, {"type": "subtitle", "time": 6214.629, "timestamp": "01:43:34", "text": "「うーん、わからない」という感じだった。 それ"}, {"type": "subtitle", "time": 6217.83, "timestamp": "01:43:37", "text": "以来、彼らは二度とやって来なかった。 でも、そう、私が"}, {"type": "subtitle", "time": 6220.31, "timestamp": "01:43:40", "text": "「ああ、"}, {"type": "subtitle", "time": 6224.39, "timestamp": "01:43:44", "text": "私のモデルは白くて"}, {"type": "subtitle", "time": 6225.91, "timestamp": "01:43:45", "text": "色白だよね"}, {"type": "subtitle", "time": 6227.109, "timestamp": "01:43:47", "text": "？」って思った時からずっと"}, {"type": "subtitle", "time": 6229.03, "timestamp": "01:43:49", "text": "そして私はダンの中にいます。 だから人々は"}, {"type": "subtitle", "time": 6231.35, "timestamp": "01:43:51", "text": "「あなたは茶色っぽい肌の"}, {"type": "subtitle", "time": 6234.229, "timestamp": "01:43:54", "text": "色をしているはずじゃないの？」と言うでしょう。 その問題は必ず存在するだろう。 そして"}, {"type": "subtitle", "time": 6236.79, "timestamp": "01:43:56", "text": "私は「いや、そんなことはどうでもいいよ"}, {"type": "subtitle", "time": 6239.35, "timestamp": "01:43:59", "text": "」って言うんだ。 だから、それ以来ずっと、私は自分のことを"}]
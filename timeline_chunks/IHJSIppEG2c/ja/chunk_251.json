[{"type": "subtitle", "time": 15069.11, "timestamp": "04:11:09", "text": "現在のものは"}, {"type": "subtitle", "time": 15071.51, "timestamp": "04:11:11", "text": "今のところ基本的なものですが、"}, {"type": "subtitle", "time": 15073.67, "timestamp": "04:11:13", "text": "最終的には"}, {"type": "subtitle", "time": 15076.07, "timestamp": "04:11:16", "text": "天気惑星のページのようにします。"}, {"type": "subtitle", "time": 15078.229, "timestamp": "04:11:18", "text": "天気惑星。 つまり、天候によって、"}, {"type": "subtitle", "time": 15080.15, "timestamp": "04:11:20", "text": "朝は白く、夜は"}, {"type": "subtitle", "time": 15082.309, "timestamp": "04:11:22", "text": "暗くなるということです"}, {"type": "subtitle", "time": 15084.87, "timestamp": "04:11:24", "text": "。 もし"}, {"type": "subtitle", "time": 15088.229, "timestamp": "04:11:28", "text": "私のインドで雨が降ったら、雨を"}, {"type": "subtitle", "time": 15089.83, "timestamp": "04:11:29", "text": "テーマにした記事のようなものになるでしょう"}, {"type": "chat", "time": 15094.98, "timestamp": "04:11:34", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "it doesn't have the ui stuff ready yet but rest is really great"}, {"type": "subtitle", "time": 15095.75, "timestamp": "04:11:35", "text": "。 雨が降ったり、晴れたり、風が強くなったりと、めまぐるしく変化する天気です"}, {"type": "subtitle", "time": 15100.79, "timestamp": "04:11:40", "text": "。  UI要素を更新します"}, {"type": "subtitle", "time": 15107.349, "timestamp": "04:11:47", "text": "うん、それはすごくいいアイデアだね。 ええと、それはその"}, {"type": "subtitle", "time": 15113.91, "timestamp": "04:11:53", "text": "機関のウェブサイトの天気計画のコンセプトには合致していますが、私自身も"}, {"type": "subtitle", "time": 15117.67, "timestamp": "04:11:57", "text": "使えると思います。"}, {"type": "subtitle", "time": 15119.99, "timestamp": "04:11:59", "text": "男の睡眠に関する本を読もうと思う。 こんにちは、"}]
[{"type": "subtitle", "time": 12804.71, "timestamp": "03:33:24", "text": "あなたが「"}, {"type": "subtitle", "time": 12808.309, "timestamp": "03:33:28", "text": "一度だけ呼ばれる」と言った時、私はそこにいました。 そこにあなたがいた。   そうだったと"}, {"type": "subtitle", "time": 12819.99, "timestamp": "03:33:39", "text": "。 さあ行こう。 ええ、あれは"}, {"type": "subtitle", "time": 12823.269, "timestamp": "03:33:43", "text": "記念配信でした。"}, {"type": "subtitle", "time": 12825.59, "timestamp": "03:33:45", "text": "それは「そう」だった。 うん。 記念"}, {"type": "subtitle", "time": 12828.469, "timestamp": "03:33:48", "text": "配信。 はい。"}, {"type": "subtitle", "time": 12830.309, "timestamp": "03:33:50", "text": "その日は、私が初めて"}]
[{"type": "subtitle", "time": 601.509, "timestamp": "00:10:01", "text": "【音楽】"}, {"type": "subtitle", "time": 604.23, "timestamp": "00:10:04", "text": "さて、皆さん、今日はどんな一日でしたか？"}, {"type": "subtitle", "time": 606.949, "timestamp": "00:10:06", "text": "木曜日はどうでしたか？   今日は"}, {"type": "subtitle", "time": 609.75, "timestamp": "00:10:09", "text": "木曜日ですよね？ ええ、今日は"}, {"type": "subtitle", "time": 611.67, "timestamp": "00:10:11", "text": "木曜日です。 そうそう。 今日、えっと、"}, {"type": "subtitle", "time": 615.35, "timestamp": "00:10:15", "text": "アニメ「神椿シティ」の第2話が公開されますよ"}, {"type": "subtitle", "time": 621.59, "timestamp": "00:10:21", "text": "ね？ ああ、すごくワクワクする。"}, {"type": "subtitle", "time": 636.389, "timestamp": "00:10:36", "text": "。 今日の目標は、情報"}, {"type": "subtitle", "time": 638.79, "timestamp": "00:10:38", "text": "ページを完成させることです。 メディアキット"}, {"type": "subtitle", "time": 642.15, "timestamp": "00:10:42", "text": "ページの文字数は非常に少なく、"}, {"type": "subtitle", "time": 646.31, "timestamp": "00:10:46", "text": "簡単にできるようなものです。 ええと"}, {"type": "subtitle", "time": 651.269, "timestamp": "00:10:51", "text": "、"}, {"type": "subtitle", "time": 654.87, "timestamp": "00:10:54", "text": "メディアキットのページに集中するか、あるいは"}, {"type": "subtitle", "time": 658.23, "timestamp": "00:10:58", "text": "ページを作成するオプションがあるかもしれません。 わからない。"}]
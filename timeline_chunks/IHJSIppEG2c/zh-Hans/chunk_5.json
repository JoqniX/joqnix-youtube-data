[{"type": "subtitle", "time": 303.51, "timestamp": "00:05:03", "text": "信息页面，对吧？ 是的。"}, {"type": "subtitle", "time": 309.27, "timestamp": "00:05:09", "text": "今天我早上10点醒来，晚上11点睡着。"}, {"type": "subtitle", "time": 313.59, "timestamp": "00:05:13", "text": "今天上午 11 点，"}, {"type": "subtitle", "time": 320.87, "timestamp": "00:05:20", "text": "我大概早上 6 点或 6 点半就醒了。"}, {"type": "subtitle", "time": 323.909, "timestamp": "00:05:23", "text": "我当时想：“我的天哪，已经是"}, {"type": "subtitle", "time": 325.99, "timestamp": "00:05:25", "text": "晚上了。”"}, {"type": "subtitle", "time": 328.71, "timestamp": "00:05:28", "text": "感觉我好像浪费了一整天"}, {"type": "subtitle", "time": 341.83, "timestamp": "00:05:41", "text": "我的呃，"}, {"type": "subtitle", "time": 346.15, "timestamp": "00:05:46", "text": "所以呃，实际上是从7:30"}, {"type": "subtitle", "time": 349.67, "timestamp": "00:05:49", "text": "到9点，"}, {"type": "subtitle", "time": 353.27, "timestamp": "00:05:53", "text": "嗯，是7:30吗？ 是的，我想我是"}, {"type": "subtitle", "time": 355.51, "timestamp": "00:05:55", "text": "在7:30加入BC的。"}, {"type": "subtitle", "time": 359.27, "timestamp": "00:05:59", "text": "8点到9点。是的，我的课程是"}]
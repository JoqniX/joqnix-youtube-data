[{"type": "subtitle", "time": 23820.628, "timestamp": "06:37:00", "text": "可以与"}, {"type": "subtitle", "time": 23824.07, "timestamp": "06:37:04", "text": "新的和旧的星座产生共鸣。我是说旧的，"}, {"type": "subtitle", "time": 23826.23, "timestamp": "06:37:06", "text": "现有的星座，我也可以创造新的"}, {"type": "subtitle", "time": 23829.75, "timestamp": "06:37:09", "text": "星座。"}, {"type": "subtitle", "time": 23832.39, "timestamp": "06:37:12", "text": "没有更多的星座了。我可以这样做，比如把"}, {"type": "subtitle", "time": 23834.948, "timestamp": "06:37:14", "text": "狮子座"}, {"type": "subtitle", "time": 23836.788, "timestamp": "06:37:16", "text": "和某个其他星座融合在一起。 你会获得"}, {"type": "subtitle", "time": 23840.15, "timestamp": "06:37:20", "text": "另一种新的星座类型，这种"}, {"type": "subtitle", "time": 23842.948, "timestamp": "06:37:22", "text": "星座可以与我产生共鸣，我"}, {"type": "subtitle", "time": 23845.83, "timestamp": "06:37:25", "text": "可以与它产生共鸣，这会给"}, {"type": "subtitle", "time": 23848.07, "timestamp": "06:37:28", "text": "我一种独特的武器，"}, {"type": "subtitle", "time": 23850.39, "timestamp": "06:37:30", "text": "同时也是一种成长武器。它会"}, {"type": "subtitle", "time": 23853.03, "timestamp": "06:37:33", "text": "随着我当前所处的阶段而成长"}, {"type": "subtitle", "time": 23856.468, "timestamp": "06:37:36", "text": "。对吧？所以，当我首次亮相时，它将是"}, {"type": "subtitle", "time": 23862.708, "timestamp": "06:37:42", "text": "第一阶段。所以，第一阶段的星座接下来"}, {"type": "subtitle", "time": 23866.948, "timestamp": "06:37:46", "text": "会有一些特定的东西，然后在"}, {"type": "subtitle", "time": 23870.31, "timestamp": "06:37:50", "text": "未来的飞升阶段，"}, {"type": "subtitle", "time": 23874.31, "timestamp": "06:37:54", "text": "比如第二、三、四、五、六阶段等等，"}, {"type": "subtitle", "time": 23876.708, "timestamp": "06:37:56", "text": "你会看到它的黑暗版本，"}, {"type": "subtitle", "time": 23879.99, "timestamp": "06:37:59", "text": "邪恶版本，你还会看到不同主题的"}]
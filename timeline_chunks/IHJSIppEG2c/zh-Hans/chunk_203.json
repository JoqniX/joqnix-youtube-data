[{"type": "subtitle", "time": 12207.75, "timestamp": "03:23:27", "text": "你对你有什么感觉？我很喜欢"}, {"type": "subtitle", "time": 12226.87, "timestamp": "03:23:46", "text": "问题在于，现在做这件事的人是我自己，所以"}, {"type": "subtitle", "time": 12231.67, "timestamp": "03:23:51", "text": "感觉很奇怪。但如果"}, {"type": "subtitle", "time": 12235.67, "timestamp": "03:23:55", "text": "别人替我做，那就"}, {"type": "subtitle", "time": 12238.71, "timestamp": "03:23:58", "text": "更好了。这意味着我给人留下了"}]
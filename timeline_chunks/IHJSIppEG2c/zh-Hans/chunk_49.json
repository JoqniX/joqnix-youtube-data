[{"type": "subtitle", "time": 2940.069, "timestamp": "00:49:00", "text": "挺好的。 现在"}, {"type": "subtitle", "time": 2943.43, "timestamp": "00:49:03", "text": "对我来说，嗯，主要还是等"}, {"type": "subtitle", "time": 2946.47, "timestamp": "00:49:06", "text": "我感觉自在的时候才会说话"}, {"type": "subtitle", "time": 2949.349, "timestamp": "00:49:09", "text": "。 只是我不太擅长知道该"}, {"type": "subtitle", "time": 2952.71, "timestamp": "00:49:12", "text": "用哪个词或短语。"}, {"type": "subtitle", "time": 2955.99, "timestamp": "00:49:15", "text": "嗯，是的，我基本理解了"}, {"type": "subtitle", "time": 2958.39, "timestamp": "00:49:18", "text": "AIM"}, {"type": "subtitle", "time": 2960.95, "timestamp": "00:49:20", "text": "所说的大部分内容。 我们当时在处理一些"}, {"type": "subtitle", "time": 2964.71, "timestamp": "00:49:24", "text": "日常用语之类的东西，"}, {"type": "subtitle", "time": 2968.87, "timestamp": "00:49:28", "text": "然后它建议了一些"}, {"type": "subtitle", "time": 2970.63, "timestamp": "00:49:30", "text": "在"}, {"type": "subtitle", "time": 2972.309, "timestamp": "00:49:32", "text": "餐厅等场合的随意对话用语。 然后我就想，不，"}, {"type": "subtitle", "time": 2974.069, "timestamp": "00:49:34", "text": "我想要更简单、更"}, {"type": "subtitle", "time": 2976.63, "timestamp": "00:49:36", "text": "随意的那种，比如，"}, {"type": "subtitle", "time": 2979.589, "timestamp": "00:49:39", "text": "嗯，你好吗？ 你今天过得怎么样？"}, {"type": "subtitle", "time": 2981.829, "timestamp": "00:49:41", "text": "你最近一直在讨论什么样的句子"}, {"type": "subtitle", "time": 2984.63, "timestamp": "00:49:44", "text": "主题以及如何回应？ 然后"}, {"type": "subtitle", "time": 2988.549, "timestamp": "00:49:48", "text": "它给了我那个东西。"}, {"type": "subtitle", "time": 2991.43, "timestamp": "00:49:51", "text": "妈妈，这和所有的一切。 妈妈说这样那样，"}, {"type": "subtitle", "time": 2994.47, "timestamp": "00:49:54", "text": "我一切都好。 这样下去也还行"}]
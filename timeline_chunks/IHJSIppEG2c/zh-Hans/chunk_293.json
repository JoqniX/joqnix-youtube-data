[{"type": "subtitle", "time": 17586.868, "timestamp": "04:53:06", "text": "他们想种小麦，大多数人都喜欢"}, {"type": "subtitle", "time": 17590.788, "timestamp": "04:53:10", "text": "小麦，还有参加会议的人"}, {"type": "subtitle", "time": 17593.43, "timestamp": "04:53:13", "text": "等等。 他们失去了一些小朋友，"}, {"type": "subtitle", "time": 17596.628, "timestamp": "04:53:16", "text": "过了一段时间就停止了工作。"}, {"type": "subtitle", "time": 17598.788, "timestamp": "04:53:18", "text": "他们像拼命一样，把九个人全部干掉了，最多的时候拿到了"}, {"type": "subtitle", "time": 17601.03, "timestamp": "04:53:21", "text": "八个人头。 什么？ 什么是"}, {"type": "subtitle", "time": 17603.59, "timestamp": "04:53:23", "text": "emo？ 等等，我不知道鸸鹋"}, {"type": "subtitle", "time": 17614.628, "timestamp": "04:53:34", "text": "天哪，那是一只鸟。 一只大鸟。"}, {"type": "subtitle", "time": 17617.59, "timestamp": "04:53:37", "text": "等等，我刚才在想什么？ 好的，等等。"}, {"type": "subtitle", "time": 17620.39, "timestamp": "04:53:40", "text": "我的天哪，这脸简直太"}, {"type": "subtitle", "time": 17624.15, "timestamp": "04:53:44", "text": "可怕了。 它太可怕了。"}, {"type": "subtitle", "time": 17627.67, "timestamp": "04:53:47", "text": "我不知道什么是邪恶，"}, {"type": "subtitle", "time": 17632.55, "timestamp": "04:53:52", "text": "但它就像在看着我，脸上"}, {"type": "subtitle", "time": 17636.788, "timestamp": "04:53:56", "text": "没有任何表情，"}]
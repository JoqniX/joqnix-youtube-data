[{"type": "subtitle", "time": 14823.51, "timestamp": "04:07:03", "text": "呃，等等。 我是天界生物，对吧？"}, {"type": "subtitle", "time": 14827.03, "timestamp": "04:07:07", "text": "我没有人类的血统。"}, {"type": "subtitle", "time": 14828.63, "timestamp": "04:07:08", "text": "等等，"}, {"type": "subtitle", "time": 14834.469, "timestamp": "04:07:14", "text": "等吗？"}, {"type": "subtitle", "time": 14837.59, "timestamp": "04:07:17", "text": "哦，等等。"}, {"type": "subtitle", "time": 14856.309, "timestamp": "04:07:36", "text": "哦，"}, {"type": "subtitle", "time": 14860.63, "timestamp": "04:07:40", "text": "我现在得想个背景故事了，比如"}, {"type": "subtitle", "time": 14863.75, "timestamp": "04:07:43", "text": "我怎么能伪装成人类之"}, {"type": "subtitle", "time": 14865.429, "timestamp": "04:07:45", "text": "类的。"}, {"type": "subtitle", "time": 14872.71, "timestamp": "04:07:52", "text": "我不知道我是否需要那个？"}, {"type": "subtitle", "time": 14876.55, "timestamp": "04:07:56", "text": "不，有血没关系，对吧？"}, {"type": "subtitle", "time": 14879.03, "timestamp": "04:07:59", "text": "想象一下我在打斗中"}]
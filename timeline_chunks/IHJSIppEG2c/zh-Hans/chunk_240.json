[{"type": "subtitle", "time": 14400.389, "timestamp": "04:00:00", "text": "生活真美好。 你呢？ 我的生活？   是的"}, {"type": "subtitle", "time": 14404.15, "timestamp": "04:00:04", "text": "，我一直都很好。 由于印巴战争，我的入学时间被"}, {"type": "subtitle", "time": 14406.87, "timestamp": "04:00:06", "text": "推迟到明年四月了"}, {"type": "subtitle", "time": 14410.15, "timestamp": "04:00:10", "text": "。"}, {"type": "subtitle", "time": 14415.59, "timestamp": "04:00:15", "text": "所以，从某种意义上说，我会在这里待9个月。"}, {"type": "subtitle", "time": 14418.71, "timestamp": "04:00:18", "text": "所以我一直在努力，嗯，"}, {"type": "subtitle", "time": 14422.15, "timestamp": "04:00:22", "text": "我父母允许"}, {"type": "subtitle", "time": 14426.229, "timestamp": "04:00:26", "text": "我做个体户之类的生意，"}, {"type": "subtitle", "time": 14428.71, "timestamp": "04:00:28", "text": "这样我就不会因为"}, {"type": "subtitle", "time": 14432.71, "timestamp": "04:00:32", "text": "使用支付方式而暴露自己，就像"}, {"type": "subtitle", "time": 14434.87, "timestamp": "04:00:34", "text": "你们公司 Starscape 那样，"}, {"type": "subtitle", "time": 14438.79, "timestamp": "04:00:38", "text": "不是那种二维码支付，"}, {"type": "subtitle", "time": 14442.15, "timestamp": "04:00:42", "text": "而是当有人通过"}, {"type": "subtitle", "time": 14445.51, "timestamp": "04:00:45", "text": "二维码支付捐款时，不会显示你的"}, {"type": "subtitle", "time": 14447.67, "timestamp": "04:00:47", "text": "真实姓名或其他任何信息，对吧？ 它只"}, {"type": "subtitle", "time": 14450.95, "timestamp": "04:00:50", "text": "显示公司名称，对吧？ 当"}, {"type": "subtitle", "time": 14453.75, "timestamp": "04:00:53", "text": "你汇款和进行"}, {"type": "subtitle", "time": 14455.91, "timestamp": "04:00:55", "text": "交易时，对吧？ 是的。 是的。 一样"}, {"type": "subtitle", "time": 14459.03, "timestamp": "04:00:59", "text": "。 我希望它"}]
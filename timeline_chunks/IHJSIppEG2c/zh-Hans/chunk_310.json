[{"type": "subtitle", "time": 18608.23, "timestamp": "05:10:08", "text": "我现在是这么想的。等等，"}, {"type": "subtitle", "time": 18610.788, "timestamp": "05:10:10", "text": "明天。我今天有事吗？我今天有什么"}, {"type": "subtitle", "time": 18613.83, "timestamp": "05:10:13", "text": "安排吗？我想没有。好吧。我"}, {"type": "subtitle", "time": 18617.43, "timestamp": "05:10:17", "text": "这么做。对我来说，"}, {"type": "subtitle", "time": 18621.91, "timestamp": "05:10:21", "text": "解决睡眠问题的最好办法就是熬夜到6点，"}, {"type": "subtitle", "time": 18624.39, "timestamp": "05:10:24", "text": "开始新的直播，"}, {"type": "subtitle", "time": 18628.39, "timestamp": "05:10:28", "text": "直播游戏"}, {"type": "subtitle", "time": 18632.07, "timestamp": "05:10:32", "text": "到12点、下午2点或者4点。然后"}, {"type": "subtitle", "time": 18635.35, "timestamp": "05:10:35", "text": "上床睡觉，睡到天荒地老。搞定了。结束了。"}, {"type": "subtitle", "time": 18638.07, "timestamp": "05:10:38", "text": "不，等等。明天我还要"}, {"type": "subtitle", "time": 18644.94, "timestamp": "05:10:44", "text": "我该怎么办？"}, {"type": "subtitle", "time": 18657.27, "timestamp": "05:10:57", "text": "[音乐] 这样是"}]
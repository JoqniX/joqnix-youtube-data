[{"type": "subtitle", "time": 12240.87, "timestamp": "03:24:00", "text": "印象，有人"}, {"type": "subtitle", "time": 12243.59, "timestamp": "03:24:03", "text": "记住了我，我"}, {"type": "subtitle", "time": 12246.309, "timestamp": "03:24:06", "text": "为别人做了些事，等等。"}, {"type": "subtitle", "time": 12249.03, "timestamp": "03:24:09", "text": "但作为一个小创作者，我"}, {"type": "subtitle", "time": 12252.71, "timestamp": "03:24:12", "text": "想，嗯，我不会这么做，那"}, {"type": "subtitle", "time": 12256.309, "timestamp": "03:24:16", "text": "一天到来需要很长时间。所以我"}, {"type": "subtitle", "time": 12258.469, "timestamp": "03:24:18", "text": "想，算了，"}, {"type": "subtitle", "time": 12261.429, "timestamp": "03:24:21", "text": "自己做也没什么丢人的，"}, {"type": "subtitle", "time": 12265.19, "timestamp": "03:24:25", "text": "所以我就做了。就是这样。即使这个"}, {"type": "subtitle", "time": 12268.15, "timestamp": "03:24:28", "text": "网站，我的"}, {"type": "subtitle", "time": 12270.95, "timestamp": "03:24:30", "text": "网站，我只能把它放在我的拇指上，对吧？"}, {"type": "subtitle", "time": 12274.15, "timestamp": "03:24:34", "text": "但社区网站，就是这个，"}, {"type": "subtitle", "time": 12277.19, "timestamp": "03:24:37", "text": "任何人都可以修改，这"}, {"type": "subtitle", "time": 12279.99, "timestamp": "03:24:39", "text": "取决于未来会怎样发展，"}, {"type": "subtitle", "time": 12284.15, "timestamp": "03:24:44", "text": "对吧？"}, {"type": "subtitle", "time": 12292.229, "timestamp": "03:24:52", "text": "只要人们能找到我、"}, {"type": "subtitle", "time": 12295.19, "timestamp": "03:24:55", "text": "了解我、关注我，"}]
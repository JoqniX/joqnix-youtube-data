[{"type": "subtitle", "time": 13800.87, "timestamp": "03:50:00", "text": "好的。 呃，还有，"}, {"type": "subtitle", "time": 13802.469, "timestamp": "03:50:02", "text": "它是怎么知道杰森的？ 哦，是的。"}, {"type": "subtitle", "time": 13805.189, "timestamp": "03:50:05", "text": "我以前经常问"}, {"type": "subtitle", "time": 13807.91, "timestamp": "03:50:07", "text": "IT帮助，比如“我该如何参加这个"}, {"type": "subtitle", "time": 13811.03, "timestamp": "03:50:11", "text": "活动”等等。我想"}, {"type": "subtitle", "time": 13813.11, "timestamp": "03:50:13", "text": "为Joathon做这个做那个。   是的"}, {"type": "subtitle", "time": 13816.15, "timestamp": "03:50:16", "text": "。 这就是它知道原因的原因，我想我告诉过它要"}, {"type": "subtitle", "time": 13819.429, "timestamp": "03:50:19", "text": "记住这一点。   是的"}, {"type": "subtitle", "time": 13827.67, "timestamp": "03:50:27", "text": "我问它七月之后该做什么。"}, {"type": "subtitle", "time": 13831.03, "timestamp": "03:50:31", "text": "不，六月之后。 它给了我一些关于"}, {"type": "subtitle", "time": 13838.15, "timestamp": "03:50:38", "text": "如何设置主题。 缩略图用的是黄色"}, {"type": "subtitle", "time": 13840.309, "timestamp": "03:50:40", "text": "，对吧？ 这就是它的"}, {"type": "subtitle", "time": 13842.63, "timestamp": "03:50:42", "text": "理念。 所以我就想，“哦，我可以用"}, {"type": "subtitle", "time": 13845.83, "timestamp": "03:50:45", "text": "它。” 这个想法对吗？ 八月应该会是"}, {"type": "subtitle", "time": 13853.11, "timestamp": "03:50:53", "text": "。 七月将是黄色的。 我喜欢这个"}, {"type": "subtitle", "time": 13854.71, "timestamp": "03:50:54", "text": "颜色。"}, {"type": "subtitle", "time": 13858.469, "timestamp": "03:50:58", "text": "三月份恢复蓝色。 这就像"}]
[{"type": "subtitle", "time": 20665.99, "timestamp": "05:44:25", "text": "，狗狗。我待会儿要睡觉了。"}, {"type": "subtitle", "time": 20667.43, "timestamp": "05:44:27", "text": "嗨。保重。保重。晚安。"}, {"type": "subtitle", "time": 20670.4, "timestamp": "05:44:30", "text": "晚安。 去睡觉吧。"}, {"type": "subtitle", "time": 20679.27, "timestamp": "05:44:39", "text": "谢谢你陪着我。"}]
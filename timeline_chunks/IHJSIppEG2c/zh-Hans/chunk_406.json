[{"type": "subtitle", "time": 24381.99, "timestamp": "06:46:21", "text": "所以家里就有咖喱鸡之类的菜肴"}, {"type": "subtitle", "time": 24385.03, "timestamp": "06:46:25", "text": "。 米就在那里。"}, {"type": "subtitle", "time": 24389.51, "timestamp": "06:46:29", "text": "我应该在6点之前吃"}, {"type": "subtitle", "time": 24392.948, "timestamp": "06:46:32", "text": "早餐吗？ 早上6点。这是夜间的事情。"}, {"type": "subtitle", "time": 24396.868, "timestamp": "06:46:36", "text": "好的，我把它加热一下，吃掉，"}, {"type": "subtitle", "time": 24400.628, "timestamp": "06:46:40", "text": "喝点奶茶或茶，"}, {"type": "subtitle", "time": 24403.91, "timestamp": "06:46:43", "text": "然后回来。 启动第二个视频流。"}, {"type": "subtitle", "time": 24407.27, "timestamp": "06:46:47", "text": "我现在得赶紧制作缩略图了。"}, {"type": "subtitle", "time": 24410.23, "timestamp": "06:46:50", "text": "我向上帝发誓，如果我感到困倦，如果我"}, {"type": "subtitle", "time": 24411.99, "timestamp": "06:46:51", "text": "放弃做这件事，我就要偷懒不干了"}, {"type": "subtitle", "time": 24413.99, "timestamp": "06:46:53", "text": "。"}]
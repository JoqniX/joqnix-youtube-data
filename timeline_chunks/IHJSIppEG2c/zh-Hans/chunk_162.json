[{"type": "subtitle", "time": 9723.91, "timestamp": "02:42:03", "text": "兄弟，我该怎么打扫房间？ 如果我这样，我怎么才能"}, {"type": "subtitle", "time": 9727.03, "timestamp": "02:42:07", "text": "独自"}, {"type": "subtitle", "time": 9729.51, "timestamp": "02:42:09", "text": "在日本生存下去？"}, {"type": "subtitle", "time": 9732.79, "timestamp": "02:42:12", "text": "如果我这么懒，就得每天把房间彻底打扫一遍。"}, {"type": "subtitle", "time": 9735.83, "timestamp": "02:42:15", "text": "不像黄金级别那么好。 我们并没有"}, {"type": "subtitle", "time": 9738.309, "timestamp": "02:42:18", "text": "那么脏。"}, {"type": "subtitle", "time": 9741.03, "timestamp": "02:42:21", "text": "嗯，是的。   就像"}, {"type": "subtitle", "time": 9743.27, "timestamp": "02:42:23", "text": "我需要把整个"}, {"type": "subtitle", "time": 9754.55, "timestamp": "02:42:34", "text": "。"}, {"type": "subtitle", "time": 9758.18, "timestamp": "02:42:38", "text": "笑话是房间里的"}, {"type": "subtitle", "time": 9760.309, "timestamp": "02:42:40", "text": "音乐"}]
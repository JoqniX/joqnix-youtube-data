[{"type": "subtitle", "time": 25519.35, "timestamp": "07:05:19", "text": "等等，她发布了一张怪兽猫的照片，"}, {"type": "subtitle", "time": 25523.59, "timestamp": "07:05:23", "text": "兄弟。 哇，太酷了！"}, {"type": "subtitle", "time": 25525.67, "timestamp": "07:05:25", "text": "我也想有朝一日骑上怪兽猫"}, {"type": "subtitle", "time": 25534.15, "timestamp": "07:05:34", "text": "一家大型唱片公司。 如果"}, {"type": "subtitle", "time": 25536.628, "timestamp": "07:05:36", "text": "你加入了大唱片公司，你的生命就等于死了。"}, {"type": "subtitle", "time": 25538.628, "timestamp": "07:05:38", "text": "但我这个傻瓜也想创立自己"}]
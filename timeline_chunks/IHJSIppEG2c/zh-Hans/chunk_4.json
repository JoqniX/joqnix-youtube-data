[{"type": "subtitle", "time": 241.27, "timestamp": "00:04:01", "text": "积极参与直播时才进行直播，就像"}, {"type": "subtitle", "time": 244.149, "timestamp": "00:04:04", "text": "我们正常的"}, {"type": "subtitle", "time": 247.429, "timestamp": "00:04:07", "text": "直播一样，对吧？差不多就是这样，"}, {"type": "subtitle", "time": 250.149, "timestamp": "00:04:10", "text": "我觉得这是个好方法。"}, {"type": "subtitle", "time": 253.03, "timestamp": "00:04:13", "text": "所以，今天的目标正如"}, {"type": "subtitle", "time": 255.99, "timestamp": "00:04:15", "text": "标题所示，我们将完善信息页面"}, {"type": "subtitle", "time": 259.59, "timestamp": "00:04:19", "text": "和关于页面，我会"}, {"type": "subtitle", "time": 263.35, "timestamp": "00:04:23", "text": "稍微修改一下关于页面。"}, {"type": "subtitle", "time": 265.99, "timestamp": "00:04:25", "text": "你得问我为什么，因为"}, {"type": "subtitle", "time": 268.469, "timestamp": "00:04:28", "text": "现在我意识到我必须把"}, {"type": "subtitle", "time": 271.67, "timestamp": "00:04:31", "text": "每一页都放在类似的格式里，"}, {"type": "subtitle", "time": 276.31, "timestamp": "00:04:36", "text": "就像相同的格式一样。 所以我们会"}, {"type": "subtitle", "time": 281.189, "timestamp": "00:04:41", "text": "这么做。 昨天我觉得我们已经把那些规则和漏洞都堵上了"}, {"type": "subtitle", "time": 289.59000000000003, "timestamp": "00:04:49", "text": "如果还有其他需要补充的，"}, {"type": "subtitle", "time": 292.629, "timestamp": "00:04:52", "text": "我会再补充。 嗯，是的，某种程度上来说，指导方针已经"}, {"type": "subtitle", "time": 296.31, "timestamp": "00:04:56", "text": "正式制定完毕了。"}, {"type": "subtitle", "time": 299.749, "timestamp": "00:04:59", "text": "呃，我得做一下关于我的"}]
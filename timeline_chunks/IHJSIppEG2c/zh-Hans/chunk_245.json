[{"type": "subtitle", "time": 14700.389, "timestamp": "04:05:00", "text": "意思？ 等等，"}, {"type": "subtitle", "time": 14705.59, "timestamp": "04:05:05", "text": "什么？ 菜单信息。 是的，它会显示"}, {"type": "subtitle", "time": 14707.99, "timestamp": "04:05:07", "text": "信息。 哦，我没有发表"}, {"type": "subtitle", "time": 14709.51, "timestamp": "04:05:09", "text": "它。   是的"}, {"type": "subtitle", "time": 14712.389, "timestamp": "04:05:12", "text": "。 那么，关于作品。 日程安排"}, {"type": "subtitle", "time": 14715.67, "timestamp": "04:05:15", "text": "行不通。 我必须想办法实现这个目标。"}, {"type": "subtitle", "time": 14718.07, "timestamp": "04:05:18", "text": "没有新闻。 这两个人不在。"}, {"type": "subtitle", "time": 14720.229, "timestamp": "04:05:20", "text": "梅尔不在那里。 我们得"}, {"type": "subtitle", "time": 14722.87, "timestamp": "04:05:22", "text": "稍后再做这件事。 现在不要。   嗯"}, {"type": "subtitle", "time": 14726.309, "timestamp": "04:05:26", "text": "，里程碑、信息、"}, {"type": "subtitle", "time": 14730.15, "timestamp": "04:05:30", "text": "指南，这三点以及关于。 我"}, {"type": "subtitle", "time": 14732.55, "timestamp": "04:05:32", "text": "稍后会添加其他页面。 我需要更改"}, {"type": "subtitle", "time": 14735.83, "timestamp": "04:05:35", "text": "这个格式。 我需要修改一下。 我"}, {"type": "subtitle", "time": 14738.63, "timestamp": "04:05:38", "text": "需要把它做得像我想象中的"}, {"type": "subtitle", "time": 14741.429, "timestamp": "04:05:41", "text": "天气网站那样。 现在我"}, {"type": "subtitle", "time": 14743.59, "timestamp": "04:05:43", "text": "必须把它做成这样。 所以它"}, {"type": "subtitle", "time": 14746.55, "timestamp": "04:05:46", "text": "取决于天气和月相。"}, {"type": "subtitle", "time": 14751.91, "timestamp": "04:05:51", "text": "情况会改变的，对吧？ 我想那样做。"}, {"type": "subtitle", "time": 14754.309, "timestamp": "04:05:54", "text": "为什么这个网站的标志没有显示出来"}, {"type": "subtitle", "time": 14756.71, "timestamp": "04:05:56", "text": "？"}]
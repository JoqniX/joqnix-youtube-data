[{"type": "subtitle", "time": 24062.15, "timestamp": "06:41:02", "text": "嗯。我之前想过做个黑发的暗黑"}, {"type": "subtitle", "time": 24064.39, "timestamp": "06:41:04", "text": "版本"}, {"type": "subtitle", "time": 24068.15, "timestamp": "06:41:08", "text": "。"}, {"type": "subtitle", "time": 24071.35, "timestamp": "06:41:11", "text": "呃，既然我现在是白发，我可以做"}, {"type": "subtitle", "time": 24078.39, "timestamp": "06:41:18", "text": "呃，但是因为现在"}, {"type": "subtitle", "time": 24081.75, "timestamp": "06:41:21", "text": "新模型的质量，我觉得我得非常非常"}, {"type": "subtitle", "time": 24086.07, "timestamp": "06:41:26", "text": "有钱才能负担得起"}, {"type": "subtitle", "time": 24088.708, "timestamp": "06:41:28", "text": "新版本1000美元左右的画费，"}, {"type": "subtitle", "time": 24092.868, "timestamp": "06:41:32", "text": "因为现在很贵。是啊。或者我"}, {"type": "subtitle", "time": 24095.67, "timestamp": "06:41:35", "text": "可以换个画师，但我太"}, {"type": "subtitle", "time": 24097.51, "timestamp": "06:41:37", "text": "挑剔了。我想保留我"}, {"type": "subtitle", "time": 24100.708, "timestamp": "06:41:40", "text": "原来的画师。所以，是"}, {"type": "subtitle", "time": 24104.468, "timestamp": "06:41:44", "text": "啊。所以现在别指望会有其他"}, {"type": "subtitle", "time": 24107.03, "timestamp": "06:41:47", "text": "版本。那要等到"}, {"type": "subtitle", "time": 24109.99, "timestamp": "06:41:49", "text": "三四年以后，也许在"}]
[{"type": "subtitle", "time": 2364.71, "timestamp": "00:39:24", "text": "這小傢伙真是個"}, {"type": "subtitle", "time": 2367.51, "timestamp": "00:39:27", "text": "狡猾的傢伙。  犒勞一下自己吧。"}, {"type": "subtitle", "time": 2376.47, "timestamp": "00:39:36", "text": "爸爸，你做什麼？  我從來沒有……周圍有很多人。  我快要斷"}, {"type": "subtitle", "time": 2381.99, "timestamp": "00:39:41", "text": "血了。  嗯，很深刻。  讓我把那傢伙趕走。  敵方和藍隊。"}]
[{"type": "subtitle", "time": 8040.709, "timestamp": "02:14:00", "text": "是的。晚上8:40我當時就想，「是的，"}, {"type": "subtitle", "time": 8043.189, "timestamp": "02:14:03", "text": "我要結束了。」然後我看到了"}, {"type": "subtitle", "time": 8045.75, "timestamp": "02:14:05", "text": "合作主辦單位的消息，好像"}, {"type": "subtitle", "time": 8047.589, "timestamp": "02:14:07", "text": "他們要加入視訊會議什麼的。"}, {"type": "subtitle", "time": 8054.709, "timestamp": "02:14:14", "text": "是的。"}, {"type": "subtitle", "time": 8055.99, "timestamp": "02:14:15", "text": "瘋狂的。"}, {"type": "subtitle", "time": 8058.47, "timestamp": "02:14:18", "text": "哦，至少你們還直播了。"}, {"type": "subtitle", "time": 8060.31, "timestamp": "02:14:20", "text": "你們是什麼時候認識的？"}, {"type": "subtitle", "time": 8062.229, "timestamp": "02:14:22", "text": "H："}, {"type": "subtitle", "time": 8063.589, "timestamp": "02:14:23", "text": "你們在哪裡遇到他們的？"}, {"type": "subtitle", "time": 8065.669, "timestamp": "02:14:25", "text": "嗯，這就像是大型"}, {"type": "subtitle", "time": 8068.31, "timestamp": "02:14:28", "text": "步行合作計畫的第二部分。"}, {"type": "subtitle", "time": 8070.55, "timestamp": "02:14:30", "text": "呃，我的意思是，你在哪裡能找到"}, {"type": "subtitle", "time": 8071.99, "timestamp": "02:14:31", "text": "它們？  是"}, {"type": "subtitle", "time": 8073.75, "timestamp": "02:14:33", "text": "日本的YouTube部落客吧？"}, {"type": "subtitle", "time": 8076.39, "timestamp": "02:14:36", "text": "呃，也有一些英國的YouTube部落客啊"}, {"type": "subtitle", "time": 8089.99, "timestamp": "02:14:49", "text": "[清喉嚨]"}, {"type": "subtitle", "time": 8095.589, "timestamp": "02:14:55", "text": "呃，該怎麼說呢？是的，我是"}, {"type": "subtitle", "time": 8098.47, "timestamp": "02:14:58", "text": "從推特上找到他們的。"}]
[{"type": "subtitle", "time": 7624.709, "timestamp": "02:07:04", "text": "等等，"}, {"type": "subtitle", "time": 7626.55, "timestamp": "02:07:06", "text": "你買馬拉鬆了嗎？你做到了，"}, {"type": "subtitle", "time": 7627.27, "timestamp": "02:07:07", "text": "對吧？"}, {"type": "subtitle", "time": 7629.27, "timestamp": "02:07:09", "text": "是的。  糟糕"}, {"type": "subtitle", "time": 7641.83, "timestamp": "02:07:21", "text": "天哪，我得重新開始，我要參加下"}, {"type": "subtitle", "time": 7644.87, "timestamp": "02:07:24", "text": "一季，第三季的比賽。  我認為，"}, {"type": "subtitle", "time": 7655.03, "timestamp": "02:07:35", "text": "結束了。等等，你是"}, {"type": "subtitle", "time": 7657.189, "timestamp": "02:07:37", "text": "怎麼玩這個遊戲的？不過，這件事應該已經結束了"}, {"type": "subtitle", "time": 7659.589, "timestamp": "02:07:39", "text": "，就像推特一樣。"}, {"type": "subtitle", "time": 7662.31, "timestamp": "02:07:42", "text": "呃，我不知道。"}, {"type": "subtitle", "time": 7663.43, "timestamp": "02:07:43", "text": "我覺得"}, {"type": "subtitle", "time": 7666.55, "timestamp": "02:07:46", "text": "可能是遊戲。是的，還有很多伺服器在"}, {"type": "subtitle", "time": 7669.51, "timestamp": "02:07:49", "text": "這裡。讓我去那個地區"}, {"type": "subtitle", "time": 7671.189, "timestamp": "02:07:51", "text": "看看，"}, {"type": "subtitle", "time": 7675.109, "timestamp": "02:07:55", "text": "呃，亞洲西部。  是的，東亞地區還有"}, {"type": "subtitle", "time": 7678.709, "timestamp": "02:07:58", "text": "很多。  還有一大堆"}]
[{"type": "subtitle", "time": 420.55, "timestamp": "00:07:00", "text": "天賦的代言。我們走吧。"}, {"type": "subtitle", "time": 422.95, "timestamp": "00:07:02", "text": "耶。恭喜。"}, {"type": "subtitle", "time": 427.51, "timestamp": "00:07:07", "text": "我想要沃洛格的金色徽章，所以"}, {"type": "subtitle", "time": 430.79, "timestamp": "00:07:10", "text": "最後把它送給了社區裡的某個人"}, {"type": "subtitle", "time": 432.55, "timestamp": "00:07:12", "text": "。  是的。請"}, {"type": "subtitle", "time": 440.39, "timestamp": "00:07:20", "text": "大家好。"}, {"type": "subtitle", "time": 442.629, "timestamp": "00:07:22", "text": "今天是Warog"}, {"type": "subtitle", "time": 446.15, "timestamp": "00:07:26", "text": "測試版（公開測試版）的最後一天，還有大約"}, {"type": "subtitle", "time": 451.83, "timestamp": "00:07:31", "text": "2個小時就結束了。我"}, {"type": "subtitle", "time": 454.71, "timestamp": "00:07:34", "text": "今天直播開始得有點晚，不過"}, {"type": "subtitle", "time": 462.469, "timestamp": "00:07:42", "text": "我正忙著……吃東西呢"}, {"type": "subtitle", "time": 464.30899999999997, "timestamp": "00:07:44", "text": "。"}, {"type": "subtitle", "time": 468.07, "timestamp": "00:07:48", "text": "所以，還有這方面的原因。你好。讓我們"}, {"type": "subtitle", "time": 470.87, "timestamp": "00:07:50", "text": "今天盡情享受快樂時光吧！"}, {"type": "subtitle", "time": 473.11, "timestamp": "00:07:53", "text": "好的。"}, {"type": "subtitle", "time": 476.71, "timestamp": "00:07:56", "text": "呃，請稍等片刻。"}]
[{"type": "subtitle", "time": 8101.669, "timestamp": "02:15:01", "text": "我覺得真的很難"}, {"type": "subtitle", "time": 8105.83, "timestamp": "02:15:05", "text": "找到願意跟日本人一起直播聊天的人，"}, {"type": "subtitle", "time": 8117.589, "timestamp": "02:15:17", "text": "不是跟日本外國人聊天什麼的。真的"}, {"type": "subtitle", "time": 8119.91, "timestamp": "02:15:19", "text": "很難找到。"}, {"type": "subtitle", "time": 8121.189, "timestamp": "02:15:21", "text": "真的嗎？"}, {"type": "subtitle", "time": 8124.629, "timestamp": "02:15:24", "text": "是的。並非每個人都願意那樣做。我"}, {"type": "subtitle", "time": 8127.35, "timestamp": "02:15:27", "text": "明白這一點。老兄，你"}, {"type": "subtitle", "time": 8133.669, "timestamp": "02:15:33", "text": "之前是不是和一位日本 YouTuber 一起直播過？  是的。是的。"}, {"type": "subtitle", "time": 8135.83, "timestamp": "02:15:35", "text": "致聖女貞德。是的。是的。  是的"}, {"type": "subtitle", "time": 8139.35, "timestamp": "02:15:39", "text": "。我聯繫了一些在"}, {"type": "subtitle", "time": 8143.35, "timestamp": "02:15:43", "text": "謝蘭的人。  是的"}, {"type": "subtitle", "time": 8148.31, "timestamp": "02:15:48", "text": "。最近我又看了 Joon 的另一部作品"}, {"type": "subtitle", "time": 8149.91, "timestamp": "02:15:49", "text": "Joathon"}, {"type": "subtitle", "time": 8154.709, "timestamp": "02:15:54", "text": "。那真是漫長的「是啊」"}]
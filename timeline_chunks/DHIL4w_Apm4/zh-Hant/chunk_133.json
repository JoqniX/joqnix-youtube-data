[{"type": "subtitle", "time": 7980.95, "timestamp": "02:13:00", "text": "結束了嗎？事實上，現在仍然"}, {"type": "subtitle", "time": 7985.03, "timestamp": "02:13:05", "text": "有人在玩他們的遊戲。"}, {"type": "subtitle", "time": 7988.069, "timestamp": "02:13:08", "text": "因為我覺得"}, {"type": "subtitle", "time": 7989.91, "timestamp": "02:13:09", "text": "你玩完"}, {"type": "subtitle", "time": 7992.79, "timestamp": "02:13:12", "text": "遊戲之後，就不能再加入了。"}, {"type": "subtitle", "time": 8003.669, "timestamp": "02:13:23", "text": "無法從伺服器取得遊戲數據"}, {"type": "subtitle", "time": 8011.43, "timestamp": "02:13:31", "text": "讓我……好吧"}, {"type": "subtitle", "time": 8013.109, "timestamp": "02:13:33", "text": "。好的。好的。歐洲"}, {"type": "subtitle", "time": 8014.79, "timestamp": "02:13:34", "text": "正在慢慢關閉。哦，是的。它正在"}, {"type": "subtitle", "time": 8017.35, "timestamp": "02:13:37", "text": "關閉。  啊，一切都結束了。"}, {"type": "subtitle", "time": 8026.149, "timestamp": "02:13:46", "text": "遊戲進行到一半就把我踢出去。"}, {"type": "subtitle", "time": 8031.109, "timestamp": "02:13:51", "text": "啊，這真是個好例子。"}, {"type": "subtitle", "time": 8033.189, "timestamp": "02:13:53", "text": "我簡直不敢相信，就像昨天一樣，我竟然忘了晚上"}, {"type": "subtitle", "time": 8037.03, "timestamp": "02:13:57", "text": "9點有個電話。當時我大概是 8 點"}, {"type": "subtitle", "time": 8037.589, "timestamp": "02:13:57", "text": "40 分。  我的"}, {"type": "subtitle", "time": 8038.95, "timestamp": "02:13:58", "text": "天啊。哦，那裡有嗎？"}]
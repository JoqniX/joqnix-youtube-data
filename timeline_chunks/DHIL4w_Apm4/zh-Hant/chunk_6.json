[{"type": "subtitle", "time": 397.579, "timestamp": "00:06:37", "text": "你好。你好。昏迷。"}, {"type": "subtitle", "time": 403.99, "timestamp": "00:06:43", "text": "別在意我"}, {"type": "subtitle", "time": 405.35, "timestamp": "00:06:45", "text": "剛才做的那個有點搞笑的舉動。 [音樂]"}, {"type": "subtitle", "time": 409.27, "timestamp": "00:06:49", "text": "嗯，我送了一份禮物訂閱給自己。我"}, {"type": "subtitle", "time": 412.55, "timestamp": "00:06:52", "text": "自己向社區中的某人發送了一個節點。我"}, {"type": "subtitle", "time": 416.469, "timestamp": "00:06:56", "text": "認為這位孝順的兒子得到了這份"}]
[{"type": "subtitle", "time": 8289.669, "timestamp": "02:18:09", "text": "不知道，夥計。現在，我"}, {"type": "subtitle", "time": 8293.11, "timestamp": "02:18:13", "text": "對權力已經上癮了。"}, {"type": "subtitle", "time": 8317.11, "timestamp": "02:18:37", "text": "我已經玩了 120 小時的《On Par》或類似《Expedition World》。  是的，權力就是想玩《命運2》。命運。  我玩完了《"}, {"type": "subtitle", "time": 8335.83, "timestamp": "02:18:55", "text": "命運》。"}, {"type": "subtitle", "time": 8339.509, "timestamp": "02:18:59", "text": "你說你結束了是什麼意思？  結束。那就像一場永遠玩不完的遊戲，對吧？有太多事情要做了。  你努力奮鬥。"}]
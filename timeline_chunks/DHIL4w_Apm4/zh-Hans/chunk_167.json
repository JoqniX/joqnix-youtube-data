[{"type": "subtitle", "time": 10043.51, "timestamp": "02:47:23", "text": "九月份跳舞的时候，"}, {"type": "subtitle", "time": 10045.83, "timestamp": "02:47:25", "text": "那个主播的儿子结束了他们的"}, {"type": "subtitle", "time": 10051.75, "timestamp": "02:47:31", "text": "啊，不错。"}, {"type": "subtitle", "time": 10054.63, "timestamp": "02:47:34", "text": "回去。 你没机会参与突袭。"}, {"type": "subtitle", "time": 10056.95, "timestamp": "02:47:36", "text": "不，不，我并不想参与这次突袭"}, {"type": "subtitle", "time": 10059.91, "timestamp": "02:47:39", "text": "。 我当时真的非常惊讶，"}, {"type": "subtitle", "time": 10063.11, "timestamp": "02:47:43", "text": "他们居然打开了我的 Twitch"}, {"type": "subtitle", "time": 10066.309, "timestamp": "02:47:46", "text": "账号进行查看，并且发现"}, {"type": "subtitle", "time": 10069.19, "timestamp": "02:47:49", "text": "我正在直播。 另外，我还意识到"}, {"type": "subtitle", "time": 10071.429, "timestamp": "02:47:51", "text": "我需要"}, {"type": "subtitle", "time": 10073.59, "timestamp": "02:47:53", "text": "更改我"}, {"type": "subtitle", "time": 10076.55, "timestamp": "02:47:56", "text": "在 Twitch 上的“关于我”页面，并将其改为日语，以便"}, {"type": "subtitle", "time": 10079.67, "timestamp": "02:47:59", "text": "那些现在看不懂英语的人也能阅读。"}]
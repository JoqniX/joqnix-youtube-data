[{"type": "subtitle", "time": 8882.389, "timestamp": "02:28:02", "text": "不是加班，而是"}, {"type": "subtitle", "time": 8887.27, "timestamp": "02:28:07", "text": "40小时。"}, {"type": "subtitle", "time": 8889.83, "timestamp": "02:28:09", "text": "还在那家公司工作，"}, {"type": "subtitle", "time": 8891.91, "timestamp": "02:28:11", "text": "不，我找到了一份餐厅的工作，所以我"}, {"type": "subtitle", "time": 8895.59, "timestamp": "02:28:15", "text": "两份工作都在做。 是的。 是的。 我两件事都在做。"}, {"type": "subtitle", "time": 8897.83, "timestamp": "02:28:17", "text": "在老地方待了 15 个小时，是的"}, {"type": "subtitle", "time": 8898.309, "timestamp": "02:28:18", "text": "。"}, {"type": "subtitle", "time": 8901.75, "timestamp": "02:28:21", "text": "休息剩下的时间，我会"}, {"type": "subtitle", "time": 8903.27, "timestamp": "02:28:23", "text": "从新地方取回来。 所以"}, {"type": "subtitle", "time": 8905.429, "timestamp": "02:28:25", "text": "上学期间每天工作 40 小时。"}, {"type": "subtitle", "time": 8915.03, "timestamp": "02:28:35", "text": "一周内上学期间 28 次。"}, {"type": "subtitle", "time": 8917.83, "timestamp": "02:28:37", "text": "嘿。 好的。 好的。   是的"}, {"type": "subtitle", "time": 8919.03, "timestamp": "02:28:39", "text": "。"}, {"type": "subtitle", "time": 8921.67, "timestamp": "02:28:41", "text": "你有很多作业要做。"}, {"type": "subtitle", "time": 8933.27, "timestamp": "02:28:53", "text": "我上学的时候"}, {"type": "subtitle", "time": 8935.91, "timestamp": "02:28:55", "text": "作业实在太多了，我跟"}, {"type": "subtitle", "time": 8939.11, "timestamp": "02:28:59", "text": "老板说只要每周工作 18 小时就行了。"}, {"type": "subtitle", "time": 8939.51, "timestamp": "02:28:59", "text": "嗯。"}]
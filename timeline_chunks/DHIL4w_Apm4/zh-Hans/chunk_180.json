[{"type": "subtitle", "time": 10800.389, "timestamp": "03:00:00", "text": "战场？ 现在还好玩吗"}, {"type": "subtitle", "time": 10802.79, "timestamp": "03:00:02", "text": "？ 我的意思是，"}, {"type": "subtitle", "time": 10804.469, "timestamp": "03:00:04", "text": "你看，玩这款游戏的人也不多"}, {"type": "subtitle", "time": 10808.389, "timestamp": "03:00:08", "text": "。 真是令人难过，"}, {"type": "subtitle", "time": 10812.63, "timestamp": "03:00:12", "text": "对吧？ 以前就是这样，对吧？   等我"}, {"type": "subtitle", "time": 10817.11, "timestamp": "03:00:17", "text": "玩了 60 多个小时，等了一堆废话之后，再来为这款游戏辩护，然后我们再来看评测吧"}, {"type": "subtitle", "time": 10822.63, "timestamp": "03:00:22", "text": "。 哦，"}, {"type": "subtitle", "time": 10824.71, "timestamp": "03:00:24", "text": "好痛。 明显的。 这游戏"}, {"type": "subtitle", "time": 10827.67, "timestamp": "03:00:27", "text": "彻底烂透了，因为它的音乐核心也烂透了。"}, {"type": "subtitle", "time": 10835.349, "timestamp": "03:00:35", "text": "糟糕透顶的设计。 声音和基本抛光都"}, {"type": "subtitle", "time": 10839.19, "timestamp": "03:00:39", "text": "损坏了。 音频简直是个笑话。 用户界面"}, {"type": "subtitle", "time": 10840.95, "timestamp": "03:00:40", "text": "糟糕透顶。"}, {"type": "subtitle", "time": 10849.59, "timestamp": "03:00:49", "text": "但显然他们……他们"}, {"type": "subtitle", "time": 10853.91, "timestamp": "03:00:53", "text": "从游戏中移除了很多游戏模式，而且"}, {"type": "subtitle", "time": 10857.75, "timestamp": "03:00:57", "text": "几乎没有任何理由。"}, {"type": "subtitle", "time": 10859.99, "timestamp": "03:00:59", "text": "这就像《命运》移除了他们的"}]
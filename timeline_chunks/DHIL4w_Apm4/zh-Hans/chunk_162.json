[{"type": "subtitle", "time": 9733.349, "timestamp": "02:42:13", "text": "我的腿受伤了。 我的腿好痛。 什么鬼？"}, {"type": "subtitle", "time": 9735.429, "timestamp": "02:42:15", "text": "我说什么了？ 我的腿受伤了。 我"}, {"type": "subtitle", "time": 9735.99, "timestamp": "02:42:15", "text": "腿疼。"}, {"type": "subtitle", "time": 9742.71, "timestamp": "02:42:22", "text": "是的，我当时在踢足球。 我已经有"}, {"type": "subtitle", "time": 9745.75, "timestamp": "02:42:25", "text": "三年没有进行过高"}, {"type": "subtitle", "time": 9747.99, "timestamp": "02:42:27", "text": "强度运动了。"}, {"type": "subtitle", "time": 9750.469, "timestamp": "02:42:30", "text": "所以，"}, {"type": "subtitle", "time": 9752.79, "timestamp": "02:42:32", "text": "几天前是我"}, {"type": "subtitle", "time": 9756.55, "timestamp": "02:42:36", "text": "恢复剧烈运动的第一天。"}, {"type": "subtitle", "time": 9756.87, "timestamp": "02:42:36", "text": "嗯。"}, {"type": "subtitle", "time": 9759.67, "timestamp": "02:42:39", "text": "所以我按照我"}, {"type": "subtitle", "time": 9761.99, "timestamp": "02:42:41", "text": "以前打球的节奏来打球，就像我以前"}, {"type": "subtitle", "time": 9765.429, "timestamp": "02:42:45", "text": "身体素质还不错的时候那样。"}, {"type": "subtitle", "time": 9768.389, "timestamp": "02:42:48", "text": "我的身体现在真的跟不上节奏了。"}, {"type": "subtitle", "time": 9773.19, "timestamp": "02:42:53", "text": "我现在真的好痛。"}, {"type": "subtitle", "time": 9776.55, "timestamp": "02:42:56", "text": "我全身每一块肌肉都像被"}]
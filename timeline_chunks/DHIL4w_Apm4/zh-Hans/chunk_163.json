[{"type": "subtitle", "time": 9786.469, "timestamp": "02:43:06", "text": "老兄，我连裤子都脱不下来"}, {"type": "subtitle", "time": 9805.59, "timestamp": "02:43:25", "text": "就特别想出去玩，可是我住的地方"}, {"type": "subtitle", "time": 9809.03, "timestamp": "02:43:29", "text": "没什么好玩的。"}, {"type": "subtitle", "time": 9812.309, "timestamp": "02:43:32", "text": "它就像树木一样。"}, {"type": "subtitle", "time": 9826.309, "timestamp": "02:43:46", "text": "有点跛脚的房子？"}, {"type": "subtitle", "time": 9829.83, "timestamp": "02:43:49", "text": "它就像一座城镇。"}, {"type": "subtitle", "time": 9832.63, "timestamp": "02:43:52", "text": "我想回城里去。"}, {"type": "subtitle", "time": 9838.87, "timestamp": "02:43:58", "text": "熙熙攘攘。"}]
[{"type": "subtitle", "time": 10262.87, "timestamp": "02:51:02", "text": "我们喜欢的任何游戏。 我们俩都有，我们一起玩，这样玩得很开心"}, {"type": "subtitle", "time": 10266.23, "timestamp": "02:51:06", "text": "。 如果还有个"}, {"type": "subtitle", "time": 10269.59, "timestamp": "02:51:09", "text": "日本人，那就太好了"}, {"type": "subtitle", "time": 10271.269, "timestamp": "02:51:11", "text": "。"}, {"type": "subtitle", "time": 10275.269, "timestamp": "02:51:15", "text": "好的。 说日语。 他们也在"}, {"type": "subtitle", "time": 10276.79, "timestamp": "02:51:16", "text": "学习英语。"}, {"type": "subtitle", "time": 10278.87, "timestamp": "02:51:18", "text": "总能找到一个。"}, {"type": "subtitle", "time": 10280.23, "timestamp": "02:51:20", "text": "我希望我能找到"}, {"type": "subtitle", "time": 10284.15, "timestamp": "02:51:24", "text": "很多"}, {"type": "subtitle", "time": 10286.884, "timestamp": "02:51:26", "text": "真正想做日本相关事情的日语学习者。"}, {"type": "subtitle", "time": 10289.11, "timestamp": "02:51:29", "text": "[音乐] 我是指英语音乐。 我对此深信不疑"}, {"type": "subtitle", "time": 10290.55, "timestamp": "02:51:30", "text": "。   是的"}, {"type": "subtitle", "time": 10298.389, "timestamp": "02:51:38", "text": "只需要找到它们，只需要挖出来就行了"}, {"type": "subtitle", "time": 10299.269, "timestamp": "02:51:39", "text": "。   是的"}, {"type": "subtitle", "time": 10299.83, "timestamp": "02:51:39", "text": "。"}, {"type": "subtitle", "time": 10302.603, "timestamp": "02:51:42", "text": "你知道日语使用者是什么样的"}, {"type": "subtitle", "time": 10312.309, "timestamp": "02:51:52", "text": "我不是种族主义者。 我并非以偏概全。"}, {"type": "subtitle", "time": 10315.11, "timestamp": "02:51:55", "text": "我只是在讽刺。"}]
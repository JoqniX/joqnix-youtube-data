[{"type": "subtitle", "time": 8821.03, "timestamp": "02:27:01", "text": "学校今天为你安排好了，"}, {"type": "subtitle", "time": 8822.389, "timestamp": "02:27:02", "text": "或者"}, {"type": "subtitle", "time": 8823.83, "timestamp": "02:27:03", "text": "我星期一有课。"}, {"type": "subtitle", "time": 8825.349, "timestamp": "02:27:05", "text": "学校作业都帮你做完了。"}, {"type": "subtitle", "time": 8827.11, "timestamp": "02:27:07", "text": "还没完呢。 我"}, {"type": "subtitle", "time": 8830.389, "timestamp": "02:27:10", "text": "星期一有课。"}, {"type": "subtitle", "time": 8832.63, "timestamp": "02:27:12", "text": "就像你当时在哪儿？你当时在哪儿？你当时在哪儿？呃，"}, {"type": "subtitle", "time": 8834.07, "timestamp": "02:27:14", "text": "该怎么称呼它呢？ 放暑假"}, {"type": "subtitle", "time": 8842.63, "timestamp": "02:27:22", "text": "下一次假期是"}, {"type": "subtitle", "time": 8846.309, "timestamp": "02:27:26", "text": "九月，或者呃，我忘了"}, {"type": "subtitle", "time": 8848.71, "timestamp": "02:27:28", "text": "下一次假期是什么时候了。"}, {"type": "subtitle", "time": 8851.67, "timestamp": "02:27:31", "text": "十月左右。"}, {"type": "subtitle", "time": 8855.59, "timestamp": "02:27:35", "text": "大概一两周后就到了。"}, {"type": "subtitle", "time": 8861.11, "timestamp": "02:27:41", "text": "哦。 哦。 我的腿好痛。 啊。"}, {"type": "subtitle", "time": 8863.83, "timestamp": "02:27:43", "text": "哦。  9月26日至10月5日。 就"}, {"type": "subtitle", "time": 8865.51, "timestamp": "02:27:45", "text": "这样，"}, {"type": "subtitle", "time": 8876.87, "timestamp": "02:27:56", "text": "不错。  [笑声]"}, {"type": "subtitle", "time": 8878.87, "timestamp": "02:27:58", "text": "可能得加班了。"}]
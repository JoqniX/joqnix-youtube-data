[{"type": "subtitle", "time": 5006.79, "timestamp": "01:23:26", "text": "这个回声男是谁？"}, {"type": "subtitle", "time": 5012.31, "timestamp": "01:23:32", "text": "兄弟，他已经赚了 72,000"}, {"type": "subtitle", "time": 5014.79, "timestamp": "01:23:34", "text": "美元，也就是 74,640 美元的"}, {"type": "subtitle", "time": 5017.11, "timestamp": "01:23:37", "text": "利润。"}, {"type": "subtitle", "time": 5019.669, "timestamp": "01:23:39", "text": "啊，真是疯了。"}, {"type": "subtitle", "time": 5021.91, "timestamp": "01:23:41", "text": "这些人是如何获得如此巨额"}]
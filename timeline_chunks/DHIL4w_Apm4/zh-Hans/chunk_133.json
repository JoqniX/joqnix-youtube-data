[{"type": "subtitle", "time": 7980.95, "timestamp": "02:13:00", "text": "结束了吗？ 事实上，现在仍然"}, {"type": "subtitle", "time": 7985.03, "timestamp": "02:13:05", "text": "有人在玩他们的游戏。"}, {"type": "subtitle", "time": 7988.069, "timestamp": "02:13:08", "text": "因为我觉得"}, {"type": "subtitle", "time": 7989.91, "timestamp": "02:13:09", "text": "你玩完"}, {"type": "subtitle", "time": 7992.79, "timestamp": "02:13:12", "text": "游戏之后，就不能再加入了。"}, {"type": "subtitle", "time": 8003.669, "timestamp": "02:13:23", "text": "无法从服务器获取游戏数据"}, {"type": "subtitle", "time": 8011.43, "timestamp": "02:13:31", "text": "让我……"}, {"type": "subtitle", "time": 8013.109, "timestamp": "02:13:33", "text": "好吧。 好的。 好的。 欧洲"}, {"type": "subtitle", "time": 8014.79, "timestamp": "02:13:34", "text": "正在慢慢关闭。哦，是的。 它正在"}, {"type": "subtitle", "time": 8017.35, "timestamp": "02:13:37", "text": "关闭。"}, {"type": "subtitle", "time": 8018.55, "timestamp": "02:13:38", "text": "啊，一切都"}, {"type": "subtitle", "time": 8019.669, "timestamp": "02:13:39", "text": "结束了"}, {"type": "subtitle", "time": 8026.149, "timestamp": "02:13:46", "text": "游戏进行到一半就把我踢出去。"}, {"type": "subtitle", "time": 8031.109, "timestamp": "02:13:51", "text": "啊，这真是个好例子。"}, {"type": "subtitle", "time": 8033.189, "timestamp": "02:13:53", "text": "我简直不敢相信，就像昨天一样，我竟然忘记了晚上"}, {"type": "subtitle", "time": 8037.03, "timestamp": "02:13:57", "text": "9点有个电话。 当时我大概是 8 点"}, {"type": "subtitle", "time": 8037.589, "timestamp": "02:13:57", "text": "40 分。"}, {"type": "subtitle", "time": 8038.95, "timestamp": "02:13:58", "text": "我的天啊。 哦，那里有吗？   是的"}]
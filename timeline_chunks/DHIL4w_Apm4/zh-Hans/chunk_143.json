[{"type": "subtitle", "time": 8580.95, "timestamp": "02:23:00", "text": "你的"}, {"type": "subtitle", "time": 8582.309, "timestamp": "02:23:02", "text": "Minecraft游戏整体水平如何？"}, {"type": "subtitle", "time": 8585.51, "timestamp": "02:23:05", "text": "我的世界。 你没有Minecraft吗？"}, {"type": "subtitle", "time": 8587.11, "timestamp": "02:23:07", "text": "不，我没有。"}, {"type": "subtitle", "time": 8589.349, "timestamp": "02:23:09", "text": "嗯，"}, {"type": "subtitle", "time": 8590.309, "timestamp": "02:23:10", "text": "我明白了。"}, {"type": "subtitle", "time": 8594.07, "timestamp": "02:23:14", "text": "茶壶。 茶饮发射器，使用年限10年。   我"}, {"type": "subtitle", "time": 8595.03, "timestamp": "02:23:15", "text": "的天哪[笑]。"}, {"type": "subtitle", "time": 8597.27, "timestamp": "02:23:17", "text": "你直接买就行了。"}, {"type": "subtitle", "time": 8599.429, "timestamp": "02:23:19", "text": "什么？ 你刚才问的是什么？"}, {"type": "subtitle", "time": 8602.469, "timestamp": "02:23:22", "text": "我当时就想，那是什么？ 我的问题是什么"}, {"type": "subtitle", "time": 8609.83, "timestamp": "02:23:29", "text": "我的天哪，我竟然忘了。 什么？ 是的。"}, {"type": "subtitle", "time": 8614.389, "timestamp": "02:23:34", "text": "你对瓦罗格有什么看法？"}, {"type": "subtitle", "time": 8615.83, "timestamp": "02:23:35", "text": "那游戏真不错。"}, {"type": "subtitle", "time": 8617.349, "timestamp": "02:23:37", "text": "节奏缓慢，"}, {"type": "subtitle", "time": 8619.429, "timestamp": "02:23:39", "text": "但它需要大量的团队合作。"}, {"type": "subtitle", "time": 8621.99, "timestamp": "02:23:41", "text": "如果你喜欢，就好好玩，你知道吗？   是的"}, {"type": "subtitle", "time": 8622.309, "timestamp": "02:23:42", "text": "。"}, {"type": "subtitle", "time": 8624.63, "timestamp": "02:23:44", "text": "如果你只是为了娱乐和"}, {"type": "subtitle", "time": 8626.79, "timestamp": "02:23:46", "text": "放松而玩，那没问题。 但是当你"}, {"type": "subtitle", "time": 8629.27, "timestamp": "02:23:49", "text": "认真玩这款游戏，真正投入其中时"}, {"type": "subtitle", "time": 8630.15, "timestamp": "02:23:50", "text": "，你会感到有点"}, {"type": "subtitle", "time": 8632.95, "timestamp": "02:23:52", "text": "沮丧，因为"}, {"type": "subtitle", "time": 8634.63, "timestamp": "02:23:54", "text": "你是第"}, {"type": "subtitle", "time": 8635.91, "timestamp": "02:23:55", "text": "一次玩。   是的"}, {"type": "subtitle", "time": 8636.23, "timestamp": "02:23:56", "text": "。"}, {"type": "subtitle", "time": 8638.79, "timestamp": "02:23:58", "text": "而且这真的需要大量的"}]
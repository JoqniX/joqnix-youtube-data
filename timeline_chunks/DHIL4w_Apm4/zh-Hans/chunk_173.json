[{"type": "subtitle", "time": 10403.91, "timestamp": "02:53:23", "text": "哦，是的。 我在火车上。"}, {"type": "subtitle", "time": 10406.63, "timestamp": "02:53:26", "text": "我正在接受训练，准备成为一名黑道成员。   那"}, {"type": "subtitle", "time": 10409.429, "timestamp": "02:53:29", "text": "是谁？"}, {"type": "subtitle", "time": 10413.03, "timestamp": "02:53:33", "text": "是的，我很快就会去纹一个全身纹身"}, {"type": "subtitle", "time": 10415.19, "timestamp": "02:53:35", "text": "。"}, {"type": "subtitle", "time": 10418.07, "timestamp": "02:53:38", "text": "好的，那我们稍后再见。 你好。"}, {"type": "subtitle", "time": 10422.469, "timestamp": "02:53:42", "text": "小心。 嘿，保重。"}, {"type": "subtitle", "time": 10425.269, "timestamp": "02:53:45", "text": "谢谢你"}, {"type": "subtitle", "time": 10427.349, "timestamp": "02:53:47", "text": "提到这件事。"}, {"type": "subtitle", "time": 10436.15, "timestamp": "02:53:56", "text": "Elgato。 太棒了。 我的"}, {"type": "subtitle", "time": 10438.79, "timestamp": "02:53:58", "text": "画质，这流媒体画质，简直太棒了。   我的天哪"}]
[{"type": "subtitle", "time": 10200.23, "timestamp": "02:50:00", "text": "因为我的很多朋友都不玩我的"}, {"type": "subtitle", "time": 10202.63, "timestamp": "02:50:02", "text": "游戏。 所以还有这方面的原因"}, {"type": "subtitle", "time": 10205.269, "timestamp": "02:50:05", "text": "。 我也注意到了。"}, {"type": "subtitle", "time": 10213.91, "timestamp": "02:50:13", "text": "。 我要么想办法拉着"}, {"type": "subtitle", "time": 10216.15, "timestamp": "02:50:16", "text": "女朋友一起玩，要么就"}, {"type": "subtitle", "time": 10218.63, "timestamp": "02:50:18", "text": "自己玩。 嗯哼。"}, {"type": "subtitle", "time": 10220.469, "timestamp": "02:50:20", "text": "例如，马拉松。 马拉松。   在"}, {"type": "subtitle", "time": 10223.51, "timestamp": "02:50:23", "text": "我的"}, {"type": "subtitle", "time": 10226.79, "timestamp": "02:50:26", "text": "朋友中，只有你玩这种类型的游戏。"}, {"type": "subtitle", "time": 10228.389, "timestamp": "02:50:28", "text": "除此之外，没人玩这种类型的游戏"}, {"type": "subtitle", "time": 10236.87, "timestamp": "02:50:36", "text": "。 大多数时候都是一个人玩。"}, {"type": "subtitle", "time": 10239.349, "timestamp": "02:50:39", "text": "好的。 视频流已修复。 耶。 现在又变回"}, {"type": "subtitle", "time": 10241.99, "timestamp": "02:50:41", "text": "红色了。 像"}, {"type": "subtitle", "time": 10250.71, "timestamp": "02:50:50", "text": "但是，是的，我"}, {"type": "subtitle", "time": 10254.389, "timestamp": "02:50:54", "text": "希望我能找到会说"}, {"type": "subtitle", "time": 10257.19, "timestamp": "02:50:57", "text": "日语的人，还有我和你一起玩的方式，"}, {"type": "subtitle", "time": 10259.99, "timestamp": "02:50:59", "text": "对吧？ 我们玩游戏、生活，也玩"}]
[{"type": "subtitle", "time": 8942.79, "timestamp": "02:29:02", "text": "但他们呃，"}, {"type": "subtitle", "time": 8947.75, "timestamp": "02:29:07", "text": "允许我呃，24小时。"}, {"type": "subtitle", "time": 8952.95, "timestamp": "02:29:12", "text": "每周投入这么多时间应该足够我生活，或者至少"}, {"type": "subtitle", "time": 8955.91, "timestamp": "02:29:15", "text": "能让我攒够"}, {"type": "subtitle", "time": 8957.75, "timestamp": "02:29:17", "text": "房租"}, {"type": "subtitle", "time": 8965.429, "timestamp": "02:29:25", "text": "哦，等等。 游戏发售日期是……"}, {"type": "subtitle", "time": 8968.389, "timestamp": "02:29:28", "text": "哦，这是新的吗？"}, {"type": "subtitle", "time": 8971.349, "timestamp": "02:29:31", "text": "并非新事物。 它已经在那儿一段"}, {"type": "subtitle", "time": 8973.51, "timestamp": "02:29:33", "text": "时间了。 我觉得它是一家日式"}, {"type": "subtitle", "time": 8976.15, "timestamp": "02:29:36", "text": "海鲜餐厅。"}, {"type": "subtitle", "time": 8979.99, "timestamp": "02:29:39", "text": "我只是把这个东西端上来而已"}, {"type": "subtitle", "time": 8983.349, "timestamp": "02:29:43", "text": "。 是的。   这"}, {"type": "subtitle", "time": 8985.75, "timestamp": "02:29:45", "text": "是哪家餐厅？"}, {"type": "subtitle", "time": 8989.51, "timestamp": "02:29:49", "text": "呃，这名字真滑稽。 它叫"}, {"type": "subtitle", "time": 8991.933, "timestamp": "02:29:51", "text": "比基尼。"}, {"type": "subtitle", "time": 8992.71, "timestamp": "02:29:52", "text": "[笑声]"}, {"type": "subtitle", "time": 8994.07, "timestamp": "02:29:54", "text": "啊？   是的"}, {"type": "subtitle", "time": 8995.27, "timestamp": "02:29:55", "text": "。"}, {"type": "subtitle", "time": 8996.63, "timestamp": "02:29:56", "text": "再说一遍。"}, {"type": "subtitle", "time": 8999.59, "timestamp": "02:29:59", "text": "比基尼。"}]
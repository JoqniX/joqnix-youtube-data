[{"type": "subtitle", "time": 9463.83, "timestamp": "02:37:43", "text": "等等，什么频道？ 哪个频道？"}, {"type": "subtitle", "time": 9466.309, "timestamp": "02:37:46", "text": "等等，什么？ 他们怎么知道的？ 他们是"}, {"type": "subtitle", "time": 9468.71, "timestamp": "02:37:48", "text": "随机检查你的评论，还是你只是"}, {"type": "subtitle", "time": 9471.83, "timestamp": "02:37:51", "text": "发表评论？ 什么？ 搞什么鬼？"}, {"type": "subtitle", "time": 9479.83, "timestamp": "02:37:59", "text": "哦，你跟踪他们了。 所以，他们会"}]
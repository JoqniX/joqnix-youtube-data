[{"type": "subtitle", "time": 8705.429, "timestamp": "02:25:05", "text": "我当时是通过"}, {"type": "subtitle", "time": 8707.51, "timestamp": "02:25:07", "text": "直升机向部队基地空投补给来赚钱的"}, {"type": "subtitle", "time": 8709.11, "timestamp": "02:25:09", "text": "，对吧？"}, {"type": "subtitle", "time": 8711.51, "timestamp": "02:25:11", "text": "我把所有东西都买下来，然后直接放到"}, {"type": "subtitle", "time": 8713.349, "timestamp": "02:25:13", "text": "部队"}, {"type": "subtitle", "time": 8715.59, "timestamp": "02:25:15", "text": "基地里。 我（清了清嗓子）靠这个赚了很多"}, {"type": "subtitle", "time": 8718.23, "timestamp": "02:25:18", "text": "钱。 那音乐真"}, {"type": "subtitle", "time": 8729.03, "timestamp": "02:25:29", "text": "大多数人已经拥有价值百万甚至"}, {"type": "subtitle", "time": 8731.59, "timestamp": "02:25:31", "text": "千万的物品了。"}, {"type": "subtitle", "time": 8741.51, "timestamp": "02:25:41", "text": "我不知道该怎么做。 人们"}, {"type": "subtitle", "time": 8745.11, "timestamp": "02:25:45", "text": "赚了很多钱。   真是"}, {"type": "subtitle", "time": 8747.59, "timestamp": "02:25:47", "text": "太疯狂了。"}, {"type": "subtitle", "time": 8750.23, "timestamp": "02:25:50", "text": "那是出汗的瞳孔。"}, {"type": "subtitle", "time": 8750.63, "timestamp": "02:25:50", "text": "对，"}]
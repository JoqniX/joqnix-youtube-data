[{"type": "subtitle", "time": 8342.309, "timestamp": "02:19:02", "text": "什么？ 结束了。   是的"}, {"type": "subtitle", "time": 8344.629, "timestamp": "02:19:04", "text": "，结束了。   根据"}, {"type": "subtitle", "time": 8351.75, "timestamp": "02:19:11", "text": "2036年6月9日的最终更新，Destin的主要演员开发工作已经结束。"}, {"type": "subtitle", "time": 8352.309, "timestamp": "02:19:12", "text": "什么？"}, {"type": "subtitle", "time": 8355.11, "timestamp": "02:19:15", "text": "两个月前，不，是三个月前。"}, {"type": "subtitle", "time": 8358.15, "timestamp": "02:19:18", "text": "按照原版的方式演奏。"}, {"type": "subtitle", "time": 8360.549, "timestamp": "02:19:20", "text": "什么？"}, {"type": "subtitle", "time": 8362.709, "timestamp": "02:19:22", "text": "结束了。   《"}, {"type": "subtitle", "time": 8366.07, "timestamp": "02:19:26", "text": "命运3》即将到来。  [笑声]"}, {"type": "subtitle", "time": 8367.349, "timestamp": "02:19:27", "text": "不，"}, {"type": "subtitle", "time": 8370.469, "timestamp": "02:19:30", "text": "他们正在倾泻而下。 他们靠着"}, {"type": "subtitle", "time": 8378.629, "timestamp": "02:19:38", "text": "和马拉松现在几乎没有球员了"}, {"type": "subtitle", "time": 8380.79, "timestamp": "02:19:40", "text": "。 所以这有点糟糕。  《"}, {"type": "subtitle", "time": 8382.87, "timestamp": "02:19:42", "text": "马拉松》明明是一款很棒的游戏，但人们却非常"}, {"type": "subtitle", "time": 8384.709, "timestamp": "02:19:44", "text": "讨厌它。   是的"}, {"type": "subtitle", "time": 8387.669, "timestamp": "02:19:47", "text": "。 真是太可惜了。"}, {"type": "subtitle", "time": 8393.83, "timestamp": "02:19:53", "text": "他们大多讨厌它，因为"}, {"type": "subtitle", "time": 8396.469, "timestamp": "02:19:56", "text": "它是蹦极游戏，"}, {"type": "subtitle", "time": 8399.27, "timestamp": "02:19:59", "text": "但这款游戏真的太酷了。"}]
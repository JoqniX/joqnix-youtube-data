[{"type": "subtitle", "time": 12482.71, "timestamp": "03:28:02", "text": "就这些了，"}, {"type": "subtitle", "time": 12485.429, "timestamp": "03:28:05", "text": "事情太多了，兄弟。 我不"}, {"type": "subtitle", "time": 12492.389, "timestamp": "03:28:12", "text": "还有那些潜水的人，谢谢你们的"}, {"type": "subtitle", "time": 12495.269, "timestamp": "03:28:15", "text": "潜水。 这对我意义重大。"}, {"type": "subtitle", "time": 12497.03, "timestamp": "03:28:17", "text": "再次感谢。   嗯"}, {"type": "subtitle", "time": 12503.51, "timestamp": "03:28:23", "text": "，最近我一直在想，我"}, {"type": "subtitle", "time": 12507.429, "timestamp": "03:28:27", "text": "应该处理一下我的"}, {"type": "subtitle", "time": 12510.87, "timestamp": "03:28:30", "text": "24 小时语音频道的事情了。"}, {"type": "subtitle", "time": 12513.19, "timestamp": "03:28:33", "text": "我不知道"}, {"type": "subtitle", "time": 12519.75, "timestamp": "03:28:39", "text": "买个小型服务器，然后想办法在上面"}, {"type": "subtitle", "time": 12524.07, "timestamp": "03:28:44", "text": "播放网站内容是否值得。 它会"}, {"type": "subtitle", "time": 12526.79, "timestamp": "03:28:46", "text": "奏效吗？ 我不知道。"}, {"type": "subtitle", "time": 12529.59, "timestamp": "03:28:49", "text": "嗯，我一直在考虑这个问题"}, {"type": "subtitle", "time": 12532.389, "timestamp": "03:28:52", "text": "。"}, {"type": "subtitle", "time": 12534.229, "timestamp": "03:28:54", "text": "也许会成功，也许不会"}]
[{"type": "subtitle", "time": 8289.669, "timestamp": "02:18:09", "text": "我不知道，伙计。 现在，我"}, {"type": "subtitle", "time": 8293.11, "timestamp": "02:18:13", "text": "对权力已经上瘾了。 我已经玩了"}, {"type": "subtitle", "time": 8294.709, "timestamp": "02:18:14", "text": "120 个小时的《"}, {"type": "subtitle", "time": 8298.95, "timestamp": "02:18:18", "text": "On Par》或类似《Expedition"}, {"type": "subtitle", "time": 8300.309, "timestamp": "02:18:20", "text": "World》。"}, {"type": "subtitle", "time": 8313.75, "timestamp": "02:18:33", "text": "想玩《命运2》。"}, {"type": "subtitle", "time": 8314.23, "timestamp": "02:18:34", "text": "命运。"}, {"type": "subtitle", "time": 8317.11, "timestamp": "02:18:37", "text": "我玩完了《命运》。"}, {"type": "subtitle", "time": 8318.07, "timestamp": "02:18:38", "text": "你说你"}, {"type": "subtitle", "time": 8319.75, "timestamp": "02:18:39", "text": "结束了是什么意思？"}, {"type": "subtitle", "time": 8321.83, "timestamp": "02:18:41", "text": "结束。 那就像一场永远也玩"}, {"type": "subtitle", "time": 8323.75, "timestamp": "02:18:43", "text": "不完的游戏，对吧？ 有"}, {"type": "subtitle", "time": 8325.91, "timestamp": "02:18:45", "text": "太多事情要做了。"}, {"type": "subtitle", "time": 8326.469, "timestamp": "02:18:46", "text": "你努力奋斗。"}, {"type": "subtitle", "time": 8328.23, "timestamp": "02:18:48", "text": "哦，他们完成了。 他们会停下来，对吧？   你"}, {"type": "subtitle", "time": 8331.03, "timestamp": "02:18:51", "text": "还记得"}, {"type": "subtitle", "time": 8333.669, "timestamp": "02:18:53", "text": "这个游戏吗？ 游戏结束了。"}, {"type": "subtitle", "time": 8335.83, "timestamp": "02:18:55", "text": "他们完成了。 玩完了《命运2》。《"}, {"type": "subtitle", "time": 8338.469, "timestamp": "02:18:58", "text": "命运2》。"}, {"type": "subtitle", "time": 8339.509, "timestamp": "02:18:59", "text": "你不知道"}]
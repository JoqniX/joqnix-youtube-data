[{"type": "subtitle", "time": 9856.15, "timestamp": "02:44:16", "text": "他们好像在找人"}, {"type": "subtitle", "time": 9858.55, "timestamp": "02:44:18", "text": "下手，结果发现了我的频道之类的"}, {"type": "subtitle", "time": 9861.19, "timestamp": "02:44:21", "text": "。 他们跟着我。 我感到非常"}, {"type": "subtitle", "time": 9863.03, "timestamp": "02:44:23", "text": "难过。"}, {"type": "subtitle", "time": 9863.99, "timestamp": "02:44:23", "text": "但是你"}, {"type": "subtitle", "time": 9865.99, "timestamp": "02:44:25", "text": "在看什么呢？ 他们正在寻找可以"}, {"type": "subtitle", "time": 9869.11, "timestamp": "02:44:29", "text": "抢劫的目标。 是的，我当时"}, {"type": "subtitle", "time": 9874.79, "timestamp": "02:44:34", "text": "就把他们的直播放在后台，"}, {"type": "subtitle", "time": 9880.79, "timestamp": "02:44:40", "text": "这样我就可以一边吃午饭一边看，"}, {"type": "subtitle", "time": 9889.269, "timestamp": "02:44:49", "text": "比如我当时在看一些玩W-Dog的"}, {"type": "subtitle", "time": 9893.91, "timestamp": "02:44:53", "text": "日本主播，这样我就能知道"}, {"type": "subtitle", "time": 9897.59, "timestamp": "02:44:57", "text": "他们要加入哪个服务器了。"}]
[{"type": "subtitle", "time": 2364.71, "timestamp": "00:39:24", "text": "好了，各位。 我回来了。 好的。 呃，那"}, {"type": "subtitle", "time": 2367.51, "timestamp": "00:39:27", "text": "真是尴尬。"}, {"type": "subtitle", "time": 2376.47, "timestamp": "00:39:36", "text": "兄弟，刚才到底发生了什么？ 我想不带任何装备，然后"}, {"type": "subtitle", "time": 2381.99, "timestamp": "00:39:41", "text": "从敌人那里获取装备。 结果"}, {"type": "subtitle", "time": 2385.03, "timestamp": "00:39:45", "text": "不是我，而是"}, {"type": "subtitle", "time": 2387.27, "timestamp": "00:39:47", "text": "我不小心杀死了"}]
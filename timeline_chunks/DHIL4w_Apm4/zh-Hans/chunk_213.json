[{"type": "subtitle", "time": 12781.83, "timestamp": "03:33:01", "text": "承诺，因为我的时间"}, {"type": "subtitle", "time": 12785.91, "timestamp": "03:33:05", "text": "有限，所以我只能做当时"}, {"type": "subtitle", "time": 12790.63, "timestamp": "03:33:10", "text": "力所能及的事情。 嗯，总之，"}, {"type": "subtitle", "time": 12803.83, "timestamp": "03:33:23", "text": "谢谢你今天的时间。 祝你一切顺利"}, {"type": "subtitle", "time": 12807.03, "timestamp": "03:33:27", "text": "。 谢谢培根"}, {"type": "subtitle", "time": 12809.429, "timestamp": "03:33:29", "text": "今天能来和我一起聊天，我们玩得很开心"}]
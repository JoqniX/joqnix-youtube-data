[{"type": "subtitle", "time": 11700.229, "timestamp": "03:15:00", "text": "War Dog 的直播游戏，一直玩到"}, {"type": "subtitle", "time": 11704.07, "timestamp": "03:15:04", "text": "最后，或者做些其他"}, {"type": "subtitle", "time": 11706.07, "timestamp": "03:15:06", "text": "有趣的事情。"}, {"type": "subtitle", "time": 11715.03, "timestamp": "03:15:15", "text": "我真希望我能把我的模特男友搬走。 我"}, {"type": "subtitle", "time": 11718.55, "timestamp": "03:15:18", "text": "可以像玩游戏时那样，表达我的表情等等"}, {"type": "subtitle", "time": 11720.79, "timestamp": "03:15:20", "text": "。 现在我"}, {"type": "subtitle", "time": 11723.315, "timestamp": "03:15:23", "text": "赚了很多钱，以至于我"}, {"type": "subtitle", "time": 11724.79, "timestamp": "03:15:24", "text": "（笑）"}, {"type": "subtitle", "time": 11726.71, "timestamp": "03:15:26", "text": "总是忘记这一点。 是的，我"}, {"type": "subtitle", "time": 11729.67, "timestamp": "03:15:29", "text": "没有实时2D显示器。 我当时做了一些"}, {"type": "subtitle", "time": 11731.51, "timestamp": "03:15:31", "text": "表情之类的。 我当时就想，"}, {"type": "subtitle", "time": 11734.309, "timestamp": "03:15:34", "text": "“嘿，"}, {"type": "subtitle", "time": 11735.99, "timestamp": "03:15:35", "text": "不是今天的直播，是昨天的直播"}, {"type": "subtitle", "time": 11737.83, "timestamp": "03:15:37", "text": "。”"}]
[{"type": "subtitle", "time": 12363.11, "timestamp": "03:26:03", "text": "那样包起来。 大概就是聊些事情吧"}, {"type": "subtitle", "time": 12366.79, "timestamp": "03:26:06", "text": "。 所以，剩下的事情我要做"}, {"type": "subtitle", "time": 12369.83, "timestamp": "03:26:09", "text": "。 其中一个是网站。"}, {"type": "subtitle", "time": 12375.03, "timestamp": "03:26:15", "text": "必须做两件事。哦，对了，我的聊天结束了。"}, {"type": "subtitle", "time": 12377.11, "timestamp": "03:26:17", "text": "因为我当时在印度，所以现在有一年的免费订阅，"}, {"type": "subtitle", "time": 12380.87, "timestamp": "03:26:20", "text": "嗯，就是那种"}, {"type": "subtitle", "time": 12383.99, "timestamp": "03:26:23", "text": "订阅服务之类的，对吧？ 哦，对，"}, {"type": "subtitle", "time": 12387.75, "timestamp": "03:26:27", "text": "我忘了这事了。"}, {"type": "subtitle", "time": 12397.83, "timestamp": "03:26:37", "text": "该死。 我把你忘了。"}, {"type": "subtitle", "time": 12407.11, "timestamp": "03:26:47", "text": "等等。"}, {"type": "subtitle", "time": 12410.87, "timestamp": "03:26:50", "text": "今天是11月5日。 不，"}, {"type": "subtitle", "time": 12415.75, "timestamp": "03:26:55", "text": "那我有时间。 我的天啊。"}]
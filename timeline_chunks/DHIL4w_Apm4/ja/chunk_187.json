[{"type": "subtitle", "time": 11223.349, "timestamp": "03:07:03", "text": "試合だけでもできたらよかったんですけどね。"}, {"type": "subtitle", "time": 11226.71, "timestamp": "03:07:06", "text": "ああ、タイミングが悪かったんでしょうね。"}, {"type": "subtitle", "time": 11227.03, "timestamp": "03:07:07", "text": "うん。   よし"}, {"type": "subtitle", "time": 11228.309, "timestamp": "03:07:08", "text": "。 また会おう、ジャック。"}, {"type": "subtitle", "time": 11229.99, "timestamp": "03:07:09", "text": "こんにちは。 またね。 どうしたの？   教えてください"}, {"type": "subtitle", "time": 11231.269, "timestamp": "03:07:11", "text": "。"}, {"type": "subtitle", "time": 11232.71, "timestamp": "03:07:12", "text": "うん。 何か一緒に遊びたいことがあったらメッセージを送ってね"}, {"type": "subtitle", "time": 11234.23, "timestamp": "03:07:14", "text": "。"}, {"type": "subtitle", "time": 11237.51, "timestamp": "03:07:17", "text": "きっと。 きっと。 はい。   よし"}, {"type": "subtitle", "time": 11238.63, "timestamp": "03:07:18", "text": "。 またね。"}, {"type": "subtitle", "time": 11246.95, "timestamp": "03:07:26", "text": "待って、あれはパンだったよ、みんな。 こんにちは。"}, {"type": "subtitle", "time": 11249.429, "timestamp": "03:07:29", "text": "こんにちは。 えっと"}, {"type": "subtitle", "time": 11252.63, "timestamp": "03:07:32", "text": "、なんで「こんにちは」って言ったんだろう？"}, {"type": "subtitle", "time": 11260.07, "timestamp": "03:07:40", "text": "いいえ。えっと、"}, {"type": "subtitle", "time": 11263.349, "timestamp": "03:07:43", "text": "どうすればいいですか？"}, {"type": "subtitle", "time": 11266.309, "timestamp": "03:07:46", "text": "いえ、"}, {"type": "subtitle", "time": 11269.67, "timestamp": "03:07:49", "text": "いいえ。 えーと、"}, {"type": "subtitle", "time": 11272.95, "timestamp": "03:07:52", "text": "「ドクター、"}, {"type": "subtitle", "time": 11277.19, "timestamp": "03:07:57", "text": "9月10日に発売されるこのゲームをプレイしますか"}]
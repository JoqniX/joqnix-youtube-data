[{"type": "subtitle", "time": 11401.19, "timestamp": "03:10:01", "text": "Twitchのカテゴリーを変更します。"}, {"type": "subtitle", "time": 11405.59, "timestamp": "03:10:05", "text": "雑談に切り替えましょう。 わかった。"}, {"type": "subtitle", "time": 11409.429, "timestamp": "03:10:09", "text": "えっと、ここで配信を終了したくはないんです。"}, {"type": "subtitle", "time": 11413.03, "timestamp": "03:10:13", "text": "冒頭部分から始めましょう。 わかった。"}, {"type": "subtitle", "time": 11415.75, "timestamp": "03:10:15", "text": "えっと、もう3時間もライブ配信してるってことは分かってるんだけど。"}, {"type": "subtitle", "time": 11419.269, "timestamp": "03:10:19", "text": "できるのは分かってるけど、まあね。"}, {"type": "subtitle", "time": 11422.95, "timestamp": "03:10:22", "text": "または、"}, {"type": "subtitle", "time": 11425.99, "timestamp": "03:10:25", "text": "別のストリームまたはチャット"}, {"type": "subtitle", "time": 11429.67, "timestamp": "03:10:29", "text": "セグメントを開始して、何について話すか、えっと、"}, {"type": "subtitle", "time": 11434.309, "timestamp": "03:10:34", "text": "何ですか?  VTuberのコンサートのこと、"}, {"type": "subtitle", "time": 11439.03, "timestamp": "03:10:39", "text": "他にもやりたいことがあって、YouTuberの"}, {"type": "subtitle", "time": 11440.469, "timestamp": "03:10:40", "text": "コンサートのこと"}, {"type": "subtitle", "time": 11443.51, "timestamp": "03:10:43", "text": "について話したり、写真を見せたりしたいんだけど、"}, {"type": "subtitle", "time": 11447.19, "timestamp": "03:10:47", "text": "今日やるべきか、"}, {"type": "subtitle", "time": 11450.95, "timestamp": "03:10:50", "text": "次回やるべきか分からないな"}]
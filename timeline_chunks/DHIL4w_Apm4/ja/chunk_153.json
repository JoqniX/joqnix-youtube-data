[{"type": "subtitle", "time": 9194.95, "timestamp": "02:33:14", "text": "我が神よ。 すべて、すべて日本的なものです。"}, {"type": "subtitle", "time": 9202.23, "timestamp": "02:33:22", "text": "でもご覧の通り、食べ物とかその他"}, {"type": "subtitle", "time": 9204.55, "timestamp": "02:33:24", "text": "すべて気に入っています。 セットで付属しています。 つまり、"}, {"type": "subtitle", "time": 9207.59, "timestamp": "02:33:27", "text": "これらの食べ物の名前を挙げると、"}, {"type": "subtitle", "time": 9210.63, "timestamp": "02:33:30", "text": "レストランは"}, {"type": "subtitle", "time": 9214.23, "timestamp": "02:33:34", "text": "大きなテーブルと"}, {"type": "subtitle", "time": 9218.15, "timestamp": "02:33:38", "text": "クッションのようなものがいくつかある閉鎖された空間のようなもので、そこに座るのです。"}, {"type": "subtitle", "time": 9238.96, "timestamp": "02:33:58", "text": "。 我が神よ。"}]
[{"type": "subtitle", "time": 11582.469, "timestamp": "03:13:02", "text": "ストリーミング"}, {"type": "subtitle", "time": 11585.429, "timestamp": "03:13:05", "text": "配信ばかりしているのは分かっています。 私はこれ以上何かをしたいとは思わない"}, {"type": "subtitle", "time": 11587.91, "timestamp": "03:13:07", "text": "。 ただ、以前のように自分の好きな"}, {"type": "subtitle", "time": 11591.59, "timestamp": "03:13:11", "text": "時間をあまり持てなくなってしまったんです"}, {"type": "subtitle", "time": 11594.07, "timestamp": "03:13:14", "text": "。"}, {"type": "subtitle", "time": 11604.469, "timestamp": "03:13:24", "text": "私のインターネット接続がうまくいかないということですね。"}, {"type": "subtitle", "time": 11608.87, "timestamp": "03:13:28", "text": "理由は？ 理由は？"}, {"type": "subtitle", "time": 11613.429, "timestamp": "03:13:33", "text": "3,000ビットレートでは"}, {"type": "subtitle", "time": 11617.51, "timestamp": "03:13:37", "text": "それを維持することができません。 何？"}]
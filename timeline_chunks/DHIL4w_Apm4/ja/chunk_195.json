[{"type": "subtitle", "time": 11700.229, "timestamp": "03:15:00", "text": "War Dogの配信で1ゲームプレイして、最後までプレイするなど、何か"}, {"type": "subtitle", "time": 11706.07, "timestamp": "03:15:06", "text": "面白いことをすると期待していいよ。   でも、そうですね、私の"}, {"type": "subtitle", "time": 11715.03, "timestamp": "03:15:15", "text": "モデルを動かせたらいいのにと思います。"}, {"type": "subtitle", "time": 11720.79, "timestamp": "03:15:20", "text": "ゲームをしている時みたいに、自分の表情とかを見せることができたんです。 今は"}, {"type": "subtitle", "time": 11723.315, "timestamp": "03:15:23", "text": "すごく稼いでいて、"}, {"type": "subtitle", "time": 11724.79, "timestamp": "03:15:24", "text": "[笑い]"}, {"type": "subtitle", "time": 11726.71, "timestamp": "03:15:26", "text": "それを忘れてしまうんです。 ええ、私は"}, {"type": "subtitle", "time": 11729.67, "timestamp": "03:15:29", "text": "ライブ2Dを持っていません。 私は、えーっと、"}, {"type": "subtitle", "time": 11731.51, "timestamp": "03:15:31", "text": "表情とか色々作ってたんです。 私は"}, {"type": "subtitle", "time": 11734.309, "timestamp": "03:15:34", "text": "「ねえ、"}, {"type": "subtitle", "time": 11735.99, "timestamp": "03:15:35", "text": "今日の配信じゃないよ。実は昨日の配信なんだ"}, {"type": "subtitle", "time": 11737.83, "timestamp": "03:15:37", "text": "」って言ったんです。"}]
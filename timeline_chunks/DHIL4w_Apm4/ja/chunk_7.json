[{"type": "subtitle", "time": 420.55, "timestamp": "00:07:00", "text": "才能あるサブに選ばれたのだと思います。 さあ行こう。   わーい"}, {"type": "subtitle", "time": 422.95, "timestamp": "00:07:02", "text": "。 おめでとう。"}, {"type": "subtitle", "time": 427.51, "timestamp": "00:07:07", "text": "私はワログの金のバッジが欲しかったので、"}, {"type": "subtitle", "time": 430.79, "timestamp": "00:07:10", "text": "結局コミュニティの誰かにプレゼントしました"}, {"type": "subtitle", "time": 432.55, "timestamp": "00:07:12", "text": "。"}, {"type": "subtitle", "time": 440.39, "timestamp": "00:07:20", "text": "こんにちは、みんな。"}, {"type": "subtitle", "time": 442.629, "timestamp": "00:07:22", "text": "今日はWarogの"}, {"type": "subtitle", "time": 446.15, "timestamp": "00:07:26", "text": "ベータ版、オープンベータの最終日です。"}, {"type": "subtitle", "time": 451.83, "timestamp": "00:07:31", "text": "あと2時間で終了します。"}, {"type": "subtitle", "time": 454.71, "timestamp": "00:07:34", "text": "今日は配信開始が少し遅れてしまいましたが、"}, {"type": "subtitle", "time": 462.469, "timestamp": "00:07:42", "text": "そして私も今、食事の真っ最中です"}, {"type": "subtitle", "time": 464.30899999999997, "timestamp": "00:07:44", "text": "。   そういう側面もあるんですね"}, {"type": "subtitle", "time": 468.07, "timestamp": "00:07:48", "text": "。 こんにちは。"}, {"type": "subtitle", "time": 470.87, "timestamp": "00:07:50", "text": "今日は楽しく過ごそう。   よし"}, {"type": "subtitle", "time": 473.11, "timestamp": "00:07:53", "text": "。   ちょっと待ってください"}, {"type": "subtitle", "time": 476.71, "timestamp": "00:07:56", "text": "。   少し時間をください"}]
[{"type": "subtitle", "time": 12485.429, "timestamp": "03:28:05", "text": "ことがあるんだよ、兄弟。 わからない"}, {"type": "subtitle", "time": 12492.389, "timestamp": "03:28:12", "text": "そして、こっそり見ている人たち、見てくれてありがとう"}, {"type": "subtitle", "time": 12495.269, "timestamp": "03:28:15", "text": "。 それは私にとってかけがえのないものです。"}, {"type": "subtitle", "time": 12497.03, "timestamp": "03:28:17", "text": "改めてありがとうございました。   ええ"}, {"type": "subtitle", "time": 12503.51, "timestamp": "03:28:23", "text": "、最近、24時間"}, {"type": "subtitle", "time": 12510.87, "timestamp": "03:28:30", "text": "365日対応の音声チャンネルについて何か対策を講じるべきだと考えているんです。"}, {"type": "subtitle", "time": 12515.59, "timestamp": "03:28:35", "text": "例えば、"}, {"type": "subtitle", "time": 12519.75, "timestamp": "03:28:39", "text": "小型サーバーを購入して、"}, {"type": "subtitle", "time": 12524.07, "timestamp": "03:28:44", "text": "ウェブサイトのコンテンツをストリーミング配信するようなことをする価値があるのか​​どうか、私には分かりません。 うまくいくだろうか"}, {"type": "subtitle", "time": 12526.79, "timestamp": "03:28:46", "text": "？ わからない。"}, {"type": "subtitle", "time": 12529.59, "timestamp": "03:28:49", "text": "ええと、それについて考えていたんです"}, {"type": "subtitle", "time": 12532.389, "timestamp": "03:28:52", "text": "。"}, {"type": "subtitle", "time": 12534.229, "timestamp": "03:28:54", "text": "うまくいくかもしれないし、うまくいかないかもしれない"}]
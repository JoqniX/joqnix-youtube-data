[{"type": "subtitle", "time": 8468.63, "timestamp": "02:21:08", "text": "最高の選手に何が起こったのかを見て、"}, {"type": "subtitle", "time": 8471.51, "timestamp": "02:21:11", "text": "私は「うわあ」と思いました。"}, {"type": "subtitle", "time": 8475.349, "timestamp": "02:21:15", "text": "あ、こんにちは。 しかし、"}, {"type": "subtitle", "time": 8479.19, "timestamp": "02:21:19", "text": "エクストラクションシューターのようなジャンルの代表としては、"}, {"type": "subtitle", "time": 8483.11, "timestamp": "02:21:23", "text": "現在3万人のプレイヤーがいます。いや、"}, {"type": "subtitle", "time": 8486.55, "timestamp": "02:21:26", "text": "待てよ、今は1万6千人だ。"}, {"type": "subtitle", "time": 8490.07, "timestamp": "02:21:30", "text": "エクストラクションシューターゲームとしては、それでも良い数字です。エクストラクション"}, {"type": "subtitle", "time": 8497.349, "timestamp": "02:21:37", "text": "シューターゲームは、せいぜい"}, {"type": "subtitle", "time": 8499.27, "timestamp": "02:21:39", "text": "1万人程度、"}, {"type": "subtitle", "time": 8501.75, "timestamp": "02:21:41", "text": "1万人以下、せいぜい数"}, {"type": "subtitle", "time": 8504.07, "timestamp": "02:21:44", "text": "千人です"}, {"type": "subtitle", "time": 8515.75, "timestamp": "02:21:55", "text": "あと、待ってください、カスタムサーバーを作成することもできます。"}, {"type": "subtitle", "time": 8519.67, "timestamp": "02:21:59", "text": "何のために？"}]
[{"type": "subtitle", "time": 11658.71, "timestamp": "03:14:18", "text": "Twitchについて何かコメントはありますか？"}, {"type": "subtitle", "time": 11662.07, "timestamp": "03:14:22", "text": "Twitterはやめておこう。 わかった。 わかった。 ストリームが"}, {"type": "subtitle", "time": 11664.55, "timestamp": "03:14:24", "text": "実行中です。 わかった。 多少の遅延はありますか"}, {"type": "subtitle", "time": 11673.51, "timestamp": "03:14:33", "text": "あなたはそれを信じなかった。 まるでワログの事件が"}, {"type": "subtitle", "time": 11676.469, "timestamp": "03:14:36", "text": "起こらなかったかのように。 いや、私は「そうそう、"}, {"type": "subtitle", "time": 11678.389, "timestamp": "03:14:38", "text": "コールオブデューティの"}, {"type": "subtitle", "time": 11681.03, "timestamp": "03:14:41", "text": "シーズンに続いて今度はワログのシーズンだし、"}, {"type": "subtitle", "time": 11682.55, "timestamp": "03:14:42", "text": "実際にゲームも買ったんだ。だから、"}, {"type": "subtitle", "time": 11689.429, "timestamp": "03:14:49", "text": "FPSゲームとかがもっと長く続くシーズンになりそうだ」って感じだったよ。  [音楽]"}, {"type": "subtitle", "time": 11693.269, "timestamp": "03:14:53", "text": "そして、1試合には何時間もかかる。 だから、"}, {"type": "subtitle", "time": 11695.67, "timestamp": "03:14:55", "text": "私が"}]
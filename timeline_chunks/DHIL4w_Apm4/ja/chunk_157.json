[{"type": "subtitle", "time": 9463.83, "timestamp": "02:37:43", "text": "えっと、どのチャンネルですか？ どのチャンネルですか？"}, {"type": "subtitle", "time": 9466.309, "timestamp": "02:37:46", "text": "え、何？ 彼らはどうやって知ったのか？ 彼らは"}, {"type": "subtitle", "time": 9468.71, "timestamp": "02:37:48", "text": "ランダムにあなたをチェックしているのですか、それともあなたが"}, {"type": "subtitle", "time": 9471.83, "timestamp": "02:37:51", "text": "コメントしているだけですか？ 何？ 一体どういうことだ？"}, {"type": "subtitle", "time": 9479.83, "timestamp": "02:37:59", "text": "ああ、あなたは彼らを追いかけたんですね。 つまり、彼らは"}]
[{"type": "subtitle", "time": 8705.429, "timestamp": "02:25:05", "text": "私は、基地"}, {"type": "subtitle", "time": 8707.51, "timestamp": "02:25:07", "text": "に投下されるヘリコプターの物資などからお金を稼いでいたんですよね"}, {"type": "subtitle", "time": 8709.11, "timestamp": "02:25:09", "text": "？"}, {"type": "subtitle", "time": 8711.51, "timestamp": "02:25:11", "text": "私はただ全てを購入して、それを"}, {"type": "subtitle", "time": 8713.349, "timestamp": "02:25:13", "text": "部隊"}, {"type": "subtitle", "time": 8715.59, "timestamp": "02:25:15", "text": "基地に配置するだけです。 私は（咳払い）それでたくさん"}, {"type": "subtitle", "time": 8718.23, "timestamp": "02:25:18", "text": "お金を稼ぎました。 あれは"}, {"type": "subtitle", "time": 8729.03, "timestamp": "02:25:29", "text": "ほとんどの人は既に100万個か1000"}, {"type": "subtitle", "time": 8731.59, "timestamp": "02:25:31", "text": "万個の物を持っている。"}, {"type": "subtitle", "time": 8741.51, "timestamp": "02:25:41", "text": "。 人々は"}, {"type": "subtitle", "time": 8745.11, "timestamp": "02:25:45", "text": "とても多くのお金を稼いでいる。   本当に信じられない"}, {"type": "subtitle", "time": 8747.59, "timestamp": "02:25:47", "text": "。"}, {"type": "subtitle", "time": 8750.23, "timestamp": "02:25:50", "text": "汗ばんだ瞳孔だ。"}, {"type": "subtitle", "time": 8750.63, "timestamp": "02:25:50", "text": "そう、"}]
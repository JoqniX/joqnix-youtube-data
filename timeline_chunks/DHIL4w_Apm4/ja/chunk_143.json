[{"type": "subtitle", "time": 8580.95, "timestamp": "02:23:00", "text": "あなたのMinecraftの総合評価は"}, {"type": "subtitle", "time": 8582.309, "timestamp": "02:23:02", "text": "？"}, {"type": "subtitle", "time": 8585.51, "timestamp": "02:23:05", "text": "マインクラフト。 マインクラフトを持っていないの？"}, {"type": "subtitle", "time": 8587.11, "timestamp": "02:23:07", "text": "いいえ、違います。"}, {"type": "subtitle", "time": 8589.349, "timestamp": "02:23:09", "text": "ええと、わかりました"}, {"type": "subtitle", "time": 8590.309, "timestamp": "02:23:10", "text": "。"}, {"type": "subtitle", "time": 8594.07, "timestamp": "02:23:14", "text": "お茶発射装置。  10年間、紅茶の販売促進に携わってきました。"}, {"type": "subtitle", "time": 8595.03, "timestamp": "02:23:15", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 8597.27, "timestamp": "02:23:17", "text": "買えばいいんです。"}, {"type": "subtitle", "time": 8599.429, "timestamp": "02:23:19", "text": "何？ ご質問は何でしたか？"}, {"type": "subtitle", "time": 8602.469, "timestamp": "02:23:22", "text": "私は「あれは何だったんだろう？」と思いました。 私の"}, {"type": "subtitle", "time": 8609.83, "timestamp": "02:23:29", "text": "、すっかり忘れてた。 何？ うん。"}, {"type": "subtitle", "time": 8614.389, "timestamp": "02:23:34", "text": "ワログについてどう思いますか？"}, {"type": "subtitle", "time": 8615.83, "timestamp": "02:23:35", "text": "それは面白いゲームですね。"}, {"type": "subtitle", "time": 8617.349, "timestamp": "02:23:37", "text": "ペースは遅い"}, {"type": "subtitle", "time": 8619.429, "timestamp": "02:23:39", "text": "が、チームワークが非常に重要だ。   ちゃんと"}, {"type": "subtitle", "time": 8621.99, "timestamp": "02:23:41", "text": "プレイしたいならね？"}, {"type": "subtitle", "time": 8622.309, "timestamp": "02:23:42", "text": "うん。"}, {"type": "subtitle", "time": 8624.63, "timestamp": "02:23:44", "text": "もし単に楽しむため、"}, {"type": "subtitle", "time": 8626.79, "timestamp": "02:23:46", "text": "リラックスするためにプレイするだけなら、それで構いません。 でも、"}, {"type": "subtitle", "time": 8629.27, "timestamp": "02:23:49", "text": "真剣に、本当に"}, {"type": "subtitle", "time": 8630.15, "timestamp": "02:23:50", "text": "ゲームにのめり込んでプレイすると、"}, {"type": "subtitle", "time": 8635.91, "timestamp": "02:23:55", "text": "デビュー戦だからちょっとイライラするんだよね。"}, {"type": "subtitle", "time": 8636.23, "timestamp": "02:23:56", "text": "うん。"}, {"type": "subtitle", "time": 8638.79, "timestamp": "02:23:58", "text": "そして、それには本当に多くの"}]
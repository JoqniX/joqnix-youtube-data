[{"type": "subtitle", "time": 8821.03, "timestamp": "02:27:01", "text": "学校はとりあえずあなたのために終わらせてあげます。"}, {"type": "subtitle", "time": 8822.389, "timestamp": "02:27:02", "text": "もしくは、"}, {"type": "subtitle", "time": 8823.83, "timestamp": "02:27:03", "text": "月曜日に授業があります。"}, {"type": "subtitle", "time": 8825.349, "timestamp": "02:27:05", "text": "学校の勉強はあなたが済ませる。   まだ終わっていません"}, {"type": "subtitle", "time": 8827.11, "timestamp": "02:27:07", "text": "。"}, {"type": "subtitle", "time": 8830.389, "timestamp": "02:27:10", "text": "月曜日に授業があります。   えっと、"}, {"type": "subtitle", "time": 8834.07, "timestamp": "02:27:14", "text": "何て言うんだっけ？ 夏休みか"}, {"type": "subtitle", "time": 8842.63, "timestamp": "02:27:22", "text": "次の休暇は"}, {"type": "subtitle", "time": 8846.309, "timestamp": "02:27:26", "text": "9月か、えっと、"}, {"type": "subtitle", "time": 8848.71, "timestamp": "02:27:28", "text": "次の休暇がいつだったか忘れちゃった。"}, {"type": "subtitle", "time": 8851.67, "timestamp": "02:27:31", "text": "10月頃だったかな。"}, {"type": "subtitle", "time": 8855.59, "timestamp": "02:27:35", "text": "1週間か2週間後には来るよ。"}, {"type": "subtitle", "time": 8861.11, "timestamp": "02:27:41", "text": "ああ、私の足が。 ああ。"}, {"type": "subtitle", "time": 8863.83, "timestamp": "02:27:43", "text": "おお。  9月26日から10月5日まで。 そして"}, {"type": "subtitle", "time": 8865.51, "timestamp": "02:27:45", "text": "あれこれと、"}, {"type": "subtitle", "time": 8876.87, "timestamp": "02:27:56", "text": "悪くない。  [笑い] 多分"}, {"type": "subtitle", "time": 8878.87, "timestamp": "02:27:58", "text": "残業しないといけないだろうね。"}]
[{"type": "subtitle", "time": 10800.389, "timestamp": "03:00:00", "text": "バトルフィールドにするべきか迷っています。 もう楽しくなくなったり、そういうことってあるの"}, {"type": "subtitle", "time": 10802.79, "timestamp": "03:00:02", "text": "？ つまり、よく考えてみると"}, {"type": "subtitle", "time": 10804.469, "timestamp": "03:00:04", "text": "、プレイしている人もそれほど多くないということだ"}, {"type": "subtitle", "time": 10808.389, "timestamp": "03:00:08", "text": "。 本当に悲しいですよね"}, {"type": "subtitle", "time": 10812.63, "timestamp": "03:00:12", "text": "？ 昔はそうだったよね？"}, {"type": "subtitle", "time": 10820.389, "timestamp": "03:00:20", "text": "60時間以上プレイして、あれこれ待った後、このゲームを擁護し終えたら、レビューを読んでください"}, {"type": "subtitle", "time": 10822.63, "timestamp": "03:00:22", "text": "。 ああ、"}, {"type": "subtitle", "time": 10824.71, "timestamp": "03:00:24", "text": "痛いよ。 明らか。 ゲームは"}, {"type": "subtitle", "time": 10827.67, "timestamp": "03:00:27", "text": "完全に腐っている。"}, {"type": "subtitle", "time": 10835.349, "timestamp": "03:00:35", "text": "デザインですね。 音質と基本的な仕上げが"}, {"type": "subtitle", "time": 10839.19, "timestamp": "03:00:39", "text": "損なわれている。 音声がひどい。 ユーザー"}, {"type": "subtitle", "time": 10840.95, "timestamp": "03:00:40", "text": "インターフェースがひどい。   あまり"}, {"type": "subtitle", "time": 10849.59, "timestamp": "03:00:49", "text": "しかし、どうやら彼らは、特に理由もなく、"}, {"type": "subtitle", "time": 10853.91, "timestamp": "03:00:53", "text": "ゲームから多くのゲームモードを削除したようです"}, {"type": "subtitle", "time": 10857.75, "timestamp": "03:00:57", "text": "。"}, {"type": "subtitle", "time": 10859.99, "timestamp": "03:00:59", "text": "それはまるで、DestinyがDLCを削除するようなものだ"}]
[{"type": "subtitle", "time": 8162.629, "timestamp": "02:16:02", "text": "話のように聞こえる。"}, {"type": "subtitle", "time": 8167.109, "timestamp": "02:16:07", "text": "その通り。 はるか昔の話だ。   たった"}, {"type": "subtitle", "time": 8168.95, "timestamp": "02:16:08", "text": "1年しか経っていないのに、ずいぶん昔のことのように感じる"}, {"type": "subtitle", "time": 8170.87, "timestamp": "02:16:10", "text": "。"}, {"type": "subtitle", "time": 8184.709, "timestamp": "02:16:24", "text": "[音楽]、まあいいや"}, {"type": "subtitle", "time": 8189.43, "timestamp": "02:16:29", "text": "。"}, {"type": "subtitle", "time": 8191.43, "timestamp": "02:16:31", "text": "ようこそ、まだ終わっていません。"}, {"type": "subtitle", "time": 8196.309, "timestamp": "02:16:36", "text": "クーンへようこそ。   ああ、"}, {"type": "subtitle", "time": 8198.15, "timestamp": "02:16:38", "text": "あのゲームね。 私が"}, {"type": "subtitle", "time": 8200.79, "timestamp": "02:16:40", "text": "あなたにあげたあのホラーゲーム、覚えてる？"}, {"type": "subtitle", "time": 8202.629, "timestamp": "02:16:42", "text": "うん。  [笑い]"}, {"type": "subtitle", "time": 8205.83, "timestamp": "02:16:45", "text": "ああ、恐ろしいゲーム。"}, {"type": "subtitle", "time": 8207.91, "timestamp": "02:16:47", "text": "君もそのゲームをやるの？"}]
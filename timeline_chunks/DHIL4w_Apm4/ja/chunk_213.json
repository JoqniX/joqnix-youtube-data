[{"type": "subtitle", "time": 12781.83, "timestamp": "03:33:01", "text": "時間が限られているので、約束はできません。できることは限られています。その時々でできることだけです"}, {"type": "subtitle", "time": 12790.63, "timestamp": "03:33:10", "text": "。 ええ、そうですね。そういうわけで、"}, {"type": "subtitle", "time": 12803.83, "timestamp": "03:33:23", "text": "今日はありがとうございました。 良い"}, {"type": "subtitle", "time": 12807.03, "timestamp": "03:33:27", "text": "一日を。 ベーコンさん、"}, {"type": "subtitle", "time": 12809.429, "timestamp": "03:33:29", "text": "今日は一緒に過ごしてくれて、楽しい時間を過ごしてくれて、そして私と話をしてくれてありがとう"}]
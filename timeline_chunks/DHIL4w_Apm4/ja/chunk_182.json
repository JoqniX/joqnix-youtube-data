[{"type": "subtitle", "time": 10931.83, "timestamp": "03:02:11", "text": "明日は何時から勤務すればいいですか？   ちくしょう"}, {"type": "subtitle", "time": 10933.269, "timestamp": "03:02:13", "text": "。   そうそう"}, {"type": "subtitle", "time": 10935.19, "timestamp": "03:02:15", "text": "。 明日も仕事です。 何時？   ごめんなさい"}, {"type": "subtitle", "time": 10935.59, "timestamp": "03:02:15", "text": "。"}, {"type": "subtitle", "time": 10937.99, "timestamp": "03:02:17", "text": "何時？"}, {"type": "subtitle", "time": 10939.51, "timestamp": "03:02:19", "text": "ええと、"}, {"type": "subtitle", "time": 10942.23, "timestamp": "03:02:22", "text": "明日ですね。 明日。 月曜日みたいな？"}, {"type": "subtitle", "time": 10945.11, "timestamp": "03:02:25", "text": "こちらは日曜日の午前4時頃です。 だから、私は"}, {"type": "subtitle", "time": 10946.95, "timestamp": "03:02:26", "text": "一日中音楽に没頭できるので、そうする"}, {"type": "subtitle", "time": 10947.67, "timestamp": "03:02:27", "text": "必要はありません。"}, {"type": "subtitle", "time": 10954.23, "timestamp": "03:02:34", "text": "うん。   わかった"}, {"type": "subtitle", "time": 10957.75, "timestamp": "03:02:37", "text": "。 わかった。 わかった。 ああ、私も"}, {"type": "subtitle", "time": 10967.429, "timestamp": "03:02:47", "text": "来週から新しい仕事が始まります。  [鼻を鳴らす]"}]
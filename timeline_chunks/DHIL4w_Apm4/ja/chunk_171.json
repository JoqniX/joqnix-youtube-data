[{"type": "subtitle", "time": 10262.87, "timestamp": "02:51:02", "text": "好きなゲームを何でもする。 私たち二人ともそうやって遊んで、"}, {"type": "subtitle", "time": 10266.23, "timestamp": "02:51:06", "text": "楽しい時間を過ごしています。"}, {"type": "subtitle", "time": 10269.59, "timestamp": "02:51:09", "text": "日本人男性もいたら、すごく"}, {"type": "subtitle", "time": 10271.269, "timestamp": "02:51:11", "text": "いいのに。   よし"}, {"type": "subtitle", "time": 10275.269, "timestamp": "02:51:15", "text": "。 日本語を話してください。 彼らは英語も"}, {"type": "subtitle", "time": 10276.79, "timestamp": "02:51:16", "text": "学んでいる。"}, {"type": "subtitle", "time": 10278.87, "timestamp": "02:51:18", "text": "いずれは見つかるだろう。"}, {"type": "subtitle", "time": 10286.884, "timestamp": "02:51:26", "text": "日本語を本当にやりたいと思っている日本人がたくさんいるといいな。"}, {"type": "subtitle", "time": 10289.11, "timestamp": "02:51:29", "text": "[音楽] つまり、英語の音楽のことです。 間違いない"}, {"type": "subtitle", "time": 10290.55, "timestamp": "02:51:30", "text": "。"}, {"type": "subtitle", "time": 10298.389, "timestamp": "02:51:38", "text": "見つける必要がある、掘り出す必要があるだけだ"}, {"type": "subtitle", "time": 10299.269, "timestamp": "02:51:39", "text": "。"}, {"type": "subtitle", "time": 10299.83, "timestamp": "02:51:39", "text": "はい。   日本語を話す"}, {"type": "subtitle", "time": 10302.603, "timestamp": "02:51:42", "text": "人たちがどんな人たちか、ご存知でしょう？"}, {"type": "subtitle", "time": 10312.309, "timestamp": "02:51:52", "text": "私は人種差別主義者ではありません。 私は一般化しているわけではありません。   皮肉を言っているだけです"}, {"type": "subtitle", "time": 10315.11, "timestamp": "02:51:55", "text": "。"}]
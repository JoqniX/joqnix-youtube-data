[{"type": "subtitle", "time": 2364.71, "timestamp": "00:39:24", "text": "さあ、皆さん。 戻ってきました。 わかった。 えっと、"}, {"type": "subtitle", "time": 2367.51, "timestamp": "00:39:27", "text": "気まずかったですね。   さっき"}, {"type": "subtitle", "time": 2376.47, "timestamp": "00:39:36", "text": "兄弟？ 装備なしでプレイして、"}, {"type": "subtitle", "time": 2381.99, "timestamp": "00:39:41", "text": "敵から装備を奪い取りたかったんです。 結局、"}, {"type": "subtitle", "time": 2385.03, "timestamp": "00:39:45", "text": "私ではなく、"}, {"type": "subtitle", "time": 2387.27, "timestamp": "00:39:47", "text": "誤ってチーム"}]
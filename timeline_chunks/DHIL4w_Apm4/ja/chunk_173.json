[{"type": "subtitle", "time": 10403.91, "timestamp": "02:53:23", "text": "。 私は電車に乗っています。"}, {"type": "subtitle", "time": 10406.63, "timestamp": "02:53:26", "text": "私はヤクザになるための訓練を受けています。   あれは"}, {"type": "subtitle", "time": 10409.429, "timestamp": "02:53:29", "text": "誰？"}, {"type": "subtitle", "time": 10413.03, "timestamp": "02:53:33", "text": "うん、近いうちに全身タトゥーを入れるつもりだよ"}, {"type": "subtitle", "time": 10415.19, "timestamp": "02:53:35", "text": "。   それでは"}, {"type": "subtitle", "time": 10418.07, "timestamp": "02:53:38", "text": "、また次回。 こんにちは。 気をつけて"}, {"type": "subtitle", "time": 10422.469, "timestamp": "02:53:42", "text": "。 じゃあ、お元気で。   教えてくれて"}, {"type": "subtitle", "time": 10425.269, "timestamp": "02:53:45", "text": "ありがとう"}, {"type": "subtitle", "time": 10427.349, "timestamp": "02:53:47", "text": "。"}, {"type": "subtitle", "time": 10436.15, "timestamp": "02:53:56", "text": "Elgato。 とても美味しいです。 俺の配信"}, {"type": "subtitle", "time": 10438.79, "timestamp": "02:53:58", "text": "品質、ストリーム品質、最高だぜ。   なんてこった"}]
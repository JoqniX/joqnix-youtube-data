[{"type": "subtitle", "time": 9001.75, "timestamp": "02:30:01", "text": "どんなビキニ？"}, {"type": "subtitle", "time": 9019.51, "timestamp": "02:30:19", "text": "ああ、もちろん大文字で。 わかった。"}, {"type": "subtitle", "time": 9030.389, "timestamp": "02:30:30", "text": "あと、"}, {"type": "subtitle", "time": 9032.309, "timestamp": "02:30:32", "text": "シーフードのお店はありますか？"}, {"type": "subtitle", "time": 9034.63, "timestamp": "02:30:34", "text": "奥歯の使い方は理解していますか？ それはどういう"}, {"type": "subtitle", "time": 9037.67, "timestamp": "02:30:37", "text": "仕組みですか？ メーターなどの数値をどのように計算して、"}, {"type": "subtitle", "time": 9040.63, "timestamp": "02:30:40", "text": "正しい値を得るのですか？"}, {"type": "subtitle", "time": 9043.91, "timestamp": "02:30:43", "text": "つまり、垂直方向のものは、"}, {"type": "subtitle", "time": 9047.83, "timestamp": "02:30:47", "text": "移動の"}, {"type": "subtitle", "time": 9048.15, "timestamp": "02:30:48", "text": "長さ、"}, {"type": "subtitle", "time": 9049.99, "timestamp": "02:30:49", "text": "移動距離です。 はぁ？   そう、そう"}, {"type": "subtitle", "time": 9052.389, "timestamp": "02:30:52", "text": "。 距離。 遠い。 うん。"}, {"type": "subtitle", "time": 9056.389, "timestamp": "02:30:56", "text": "ええ、それが知っておくべきことの全てだと思います"}, {"type": "subtitle", "time": 9058.309, "timestamp": "02:30:58", "text": "。"}]
[{"type": "subtitle", "time": 9960.8, "timestamp": "02:46:00", "text": "誰だろう。 インド出身者1名。 うん。   なんと"}, {"type": "subtitle", "time": 9961.12, "timestamp": "02:46:01", "text": "うん。   なんと アメリカから来た二人。"}, {"type": "subtitle", "time": 9964.399, "timestamp": "02:46:04", "text": "アメリカから来た二人。 アメリカ。"}, {"type": "subtitle", "time": 9966.16, "timestamp": "02:46:06", "text": "アメリカ。 アメリカ。"}, {"type": "subtitle", "time": 9968.88, "timestamp": "02:46:08", "text": "アメリカ。 アメリカ出身の2人。   わかった"}, {"type": "subtitle", "time": 9978.63, "timestamp": "02:46:18", "text": "。"}, {"type": "subtitle", "time": 9982.07, "timestamp": "02:46:22", "text": "えっと、私には"}, {"type": "subtitle", "time": 9984.23, "timestamp": "02:46:24", "text": "アメリカ人の視聴者はほとんどいないと思います。   昔はよく"}, {"type": "subtitle", "time": 9988.87, "timestamp": "02:46:28", "text": "人が訪ねてきてくれたものだ。"}, {"type": "subtitle", "time": 9999.67, "timestamp": "02:46:39", "text": "また、プレイしたいですか？待って、いや。 えっと、"}, {"type": "subtitle", "time": 10002.469, "timestamp": "02:46:42", "text": "脱出ゲームをやってみませんか？もう"}, {"type": "subtitle", "time": 10005.349, "timestamp": "02:46:45", "text": "古いゲームだと思いますが、"}, {"type": "subtitle", "time": 10007.75, "timestamp": "02:46:47", "text": "脱出ゲームをやってみたいと思ったことはありますか？ ああ、"}, {"type": "subtitle", "time": 10009.19, "timestamp": "02:46:49", "text": "また"}, {"type": "subtitle", "time": 10014.95, "timestamp": "02:46:54", "text": "。 抽出シューティング"}, {"type": "subtitle", "time": 10017.11, "timestamp": "02:46:57", "text": "ゲームが多すぎる。"}, {"type": "subtitle", "time": 10018.71, "timestamp": "02:46:58", "text": "彼らは既にレイダーではなくマラソンをプレイしている"}]
[{"type": "subtitle", "time": 1154.23, "timestamp": "00:19:14", "text": "ヨーイングや"}, {"type": "subtitle", "time": 1157.59, "timestamp": "00:19:17", "text": "回転をしない場合は、実際にそれを実行できます"}, {"type": "subtitle", "time": 1179.59, "timestamp": "00:19:39", "text": "そして次に私が習得しなければならないのは、"}, {"type": "subtitle", "time": 1185.19, "timestamp": "00:19:45", "text": "高速から正確に一点に着陸することです"}]
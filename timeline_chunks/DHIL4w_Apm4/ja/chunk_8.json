[{"type": "subtitle", "time": 481.27, "timestamp": "00:08:01", "text": "。 ちょっと、少しだけやらせてください"}, {"type": "subtitle", "time": 483.909, "timestamp": "00:08:03", "text": "。   えっと、"}, {"type": "subtitle", "time": 489.27, "timestamp": "00:08:09", "text": "待って。"}, {"type": "subtitle", "time": 492.79, "timestamp": "00:08:12", "text": "よし、これで大丈夫だろう。"}, {"type": "subtitle", "time": 495.11, "timestamp": "00:08:15", "text": "私たちはすべてのプラットフォームでライブ配信中です。 はい、"}, {"type": "subtitle", "time": 498.23, "timestamp": "00:08:18", "text": "生放送中です。 生放送。   ちょっと"}, {"type": "subtitle", "time": 500.869, "timestamp": "00:08:20", "text": "待って、ヘリコプター操縦のパイロット養成講座のやり方に関するチュートリアル動画を見てたんだ"}, {"type": "subtitle", "time": 509.029, "timestamp": "00:08:29", "text": "。"}, {"type": "subtitle", "time": 513.11, "timestamp": "00:08:33", "text": "ええと、そういうことです。   いずれは"}, {"type": "subtitle", "time": 526.389, "timestamp": "00:08:46", "text": "私も今食事中なんです。 じゃあ、それを"}, {"type": "subtitle", "time": 530.63, "timestamp": "00:08:50", "text": "食べます。 えっと、ちょっと待ってください。"}, {"type": "subtitle", "time": 533.35, "timestamp": "00:08:53", "text": "乗り換えるかもしれません。"}, {"type": "subtitle", "time": 536.55, "timestamp": "00:08:56", "text": "待って。 さて、本題に入る前に、"}]
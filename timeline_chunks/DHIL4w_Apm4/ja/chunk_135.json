[{"type": "subtitle", "time": 8114.87, "timestamp": "02:15:14", "text": "日本人とかと配信しながら話したい人を見つけるのは本当に稀だと思う。"}, {"type": "subtitle", "time": 8117.589, "timestamp": "02:15:17", "text": "日本人以外の外国人とかじゃなくて。"}, {"type": "subtitle", "time": 8119.91, "timestamp": "02:15:19", "text": "稀なことだよ。"}, {"type": "subtitle", "time": 8121.189, "timestamp": "02:15:21", "text": "本当に？"}, {"type": "subtitle", "time": 8124.629, "timestamp": "02:15:24", "text": "うん。 誰もがそうしたいわけではない。 それは"}, {"type": "subtitle", "time": 8127.35, "timestamp": "02:15:27", "text": "分かっています。 なあ、前に"}, {"type": "subtitle", "time": 8131.35, "timestamp": "02:15:31", "text": "日本人ユーチューバーが"}, {"type": "subtitle", "time": 8133.669, "timestamp": "02:15:33", "text": "配信したことがあったのを覚えてる？"}, {"type": "subtitle", "time": 8135.83, "timestamp": "02:15:35", "text": "うん。 うん。 ジョーンのために。 うん。 うん。"}, {"type": "subtitle", "time": 8139.35, "timestamp": "02:15:39", "text": "うん。 私はシェランにいた何人かの人に連絡を取った"}, {"type": "subtitle", "time": 8143.35, "timestamp": "02:15:43", "text": "。"}, {"type": "subtitle", "time": 8148.31, "timestamp": "02:15:48", "text": "うん。 そして最近、私は"}, {"type": "subtitle", "time": 8154.709, "timestamp": "02:15:54", "text": "JoonのJoathonという別の人物と出会いました。 それはとても長い時間でした"}]
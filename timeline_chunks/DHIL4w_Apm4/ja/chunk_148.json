[{"type": "subtitle", "time": 8882.389, "timestamp": "02:28:02", "text": "残業ではなく、"}, {"type": "subtitle", "time": 8887.27, "timestamp": "02:28:07", "text": "40時間。"}, {"type": "subtitle", "time": 8889.83, "timestamp": "02:28:09", "text": "まだ働いています。"}, {"type": "subtitle", "time": 8891.91, "timestamp": "02:28:11", "text": "いいえ、レストランの仕事が決まったので、"}, {"type": "subtitle", "time": 8895.59, "timestamp": "02:28:15", "text": "両方やっています。 うん。 うん。 私は両方やっています。"}, {"type": "subtitle", "time": 8897.83, "timestamp": "02:28:17", "text": "古い場所で15時間、そして「"}, {"type": "subtitle", "time": 8898.309, "timestamp": "02:28:18", "text": "うん」。"}, {"type": "subtitle", "time": 8901.75, "timestamp": "02:28:21", "text": "残りの時間を休んで、"}, {"type": "subtitle", "time": 8903.27, "timestamp": "02:28:23", "text": "新しい場所からそれを受け取ります。 つまり、"}, {"type": "subtitle", "time": 8905.429, "timestamp": "02:28:25", "text": "学校のある期間は40時間ということだ。"}, {"type": "subtitle", "time": 8915.03, "timestamp": "02:28:35", "text": "1週間のうち28回は学校に通う。"}, {"type": "subtitle", "time": 8917.83, "timestamp": "02:28:37", "text": "おい。 わかった。 わかった。"}, {"type": "subtitle", "time": 8919.03, "timestamp": "02:28:39", "text": "はい。"}, {"type": "subtitle", "time": 8921.67, "timestamp": "02:28:41", "text": "課題がたくさんあるみたいですね。"}, {"type": "subtitle", "time": 8933.27, "timestamp": "02:28:53", "text": "学生だった頃は、"}, {"type": "subtitle", "time": 8935.91, "timestamp": "02:28:55", "text": "課題が山ほどあって、"}, {"type": "subtitle", "time": 8939.11, "timestamp": "02:28:59", "text": "上司に18時間勤務にしてほしいと頼んだんです。"}, {"type": "subtitle", "time": 8939.51, "timestamp": "02:28:59", "text": "うん。"}]
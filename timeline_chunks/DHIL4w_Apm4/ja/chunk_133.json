[{"type": "subtitle", "time": 7980.95, "timestamp": "02:13:00", "text": "終わったのか？ 実際、今でも"}, {"type": "subtitle", "time": 7985.03, "timestamp": "02:13:05", "text": "ゲームをプレイしている人たちがいる。"}, {"type": "subtitle", "time": 7992.79, "timestamp": "02:13:12", "text": "ゲームを終えた後は、参加できないと思うから。"}, {"type": "subtitle", "time": 8013.109, "timestamp": "02:13:33", "text": "。 よし。 よし。 ヨーロッパは"}, {"type": "subtitle", "time": 8014.79, "timestamp": "02:13:34", "text": "徐々に閉鎖されている。ああ、そうだね。 閉鎖される"}, {"type": "subtitle", "time": 8017.35, "timestamp": "02:13:37", "text": "。"}, {"type": "subtitle", "time": 8018.55, "timestamp": "02:13:38", "text": "ああ、終わったよ"}, {"type": "subtitle", "time": 8026.149, "timestamp": "02:13:46", "text": "試合の途中で私を蹴ってください。"}, {"type": "subtitle", "time": 8031.109, "timestamp": "02:13:51", "text": "ああ、あれは良かった。"}, {"type": "subtitle", "time": 8033.189, "timestamp": "02:13:53", "text": "昨日みたいに、午後9時に電話がかかってきたことを忘れていたなんて信じられない。 時刻は8時"}, {"type": "subtitle", "time": 8037.589, "timestamp": "02:13:57", "text": "40分くらいだった。   何てことだ"}, {"type": "subtitle", "time": 8038.95, "timestamp": "02:13:58", "text": "。 ああ、あれはそこにあるの？"}]
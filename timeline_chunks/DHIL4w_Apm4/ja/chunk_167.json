[{"type": "subtitle", "time": 10045.83, "timestamp": "02:47:25", "text": "その配信者の息子が配信を終了した9月に踊っていた"}, {"type": "subtitle", "time": 10051.75, "timestamp": "02:47:31", "text": "ああ、いいね。   戻ってください"}, {"type": "subtitle", "time": 10054.63, "timestamp": "02:47:34", "text": "。 君には襲撃はないよ。"}, {"type": "subtitle", "time": 10056.95, "timestamp": "02:47:36", "text": "いや、いや、私は襲撃を望んでいなかった"}, {"type": "subtitle", "time": 10059.91, "timestamp": "02:47:39", "text": "。"}, {"type": "subtitle", "time": 10063.11, "timestamp": "02:47:43", "text": "彼らが実際に私のTwitch"}, {"type": "subtitle", "time": 10066.309, "timestamp": "02:47:46", "text": "アカウントを開いて確認し、私が"}, {"type": "subtitle", "time": 10069.19, "timestamp": "02:47:49", "text": "ライブ配信中であることに気づいたことに、本当に驚きました。 それと、"}, {"type": "subtitle", "time": 10076.55, "timestamp": "02:47:56", "text": "Twitchのプロフィールページも変更して、"}, {"type": "subtitle", "time": 10079.67, "timestamp": "02:47:59", "text": "英語が読めない人のために日本語も載せる必要があることに気づきました。"}]
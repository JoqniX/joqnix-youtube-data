[{"type": "subtitle", "time": 7447.589, "timestamp": "02:04:07", "text": "生き残った直後に、チームメイトの男に殺されてしまったんです。"}, {"type": "subtitle", "time": 7474.629, "timestamp": "02:04:34", "text": "ええ、私のローダーは完全に限界に達していました"}, {"type": "subtitle", "time": 7499.27, "timestamp": "02:04:59", "text": "彼は私から略奪している。 読み込み中です。"}]
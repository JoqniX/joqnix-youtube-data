[{"type": "subtitle", "time": 8040.709, "timestamp": "02:14:00", "text": "うん。 午後8時40分 そして私は「よし、そろそろ"}, {"type": "subtitle", "time": 8043.189, "timestamp": "02:14:03", "text": "締めくくろう」と思った。 それから、"}, {"type": "subtitle", "time": 8045.75, "timestamp": "02:14:05", "text": "コラボの主催者から、"}, {"type": "subtitle", "time": 8047.589, "timestamp": "02:14:07", "text": "VCに参加するなどのメッセージが届いた。"}, {"type": "subtitle", "time": 8054.709, "timestamp": "02:14:14", "text": "うん。"}, {"type": "subtitle", "time": 8055.99, "timestamp": "02:14:15", "text": "クレイジー。"}, {"type": "subtitle", "time": 8058.47, "timestamp": "02:14:18", "text": "ああ、少なくとも君たちは配信してくれたね。"}, {"type": "subtitle", "time": 8060.31, "timestamp": "02:14:20", "text": "彼らとはいつ出会ったのですか？"}, {"type": "subtitle", "time": 8062.229, "timestamp": "02:14:22", "text": "H："}, {"type": "subtitle", "time": 8063.589, "timestamp": "02:14:23", "text": "彼らとはどこで出会ったのですか？"}, {"type": "subtitle", "time": 8065.669, "timestamp": "02:14:25", "text": "えっと、それはビッグウォークコラボのパート2みたいな感じだった"}, {"type": "subtitle", "time": 8068.31, "timestamp": "02:14:28", "text": "。   えっと、つまり、"}, {"type": "subtitle", "time": 8071.99, "timestamp": "02:14:31", "text": "それらはどこで見つけるんですか？"}, {"type": "subtitle", "time": 8073.75, "timestamp": "02:14:33", "text": "日本のユーチューバーですよね？"}, {"type": "subtitle", "time": 8076.39, "timestamp": "02:14:36", "text": "えーと、英語圏のユーチューバーもいるんですよ"}, {"type": "subtitle", "time": 8089.99, "timestamp": "02:14:49", "text": "[咳払い]"}, {"type": "subtitle", "time": 8095.589, "timestamp": "02:14:55", "text": "えーと、どう言えばいいかな？ ええ、"}, {"type": "subtitle", "time": 8098.47, "timestamp": "02:14:58", "text": "Twitterで見つけました。"}]
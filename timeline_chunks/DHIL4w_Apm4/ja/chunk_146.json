[{"type": "subtitle", "time": 8772.79, "timestamp": "02:26:12", "text": "。 もうすぐ寝る。   そうそう"}, {"type": "subtitle", "time": 8773.349, "timestamp": "02:26:13", "text": "。"}, {"type": "subtitle", "time": 8774.71, "timestamp": "02:26:14", "text": "君とゲームを1つやってから、"}, {"type": "subtitle", "time": 8778.23, "timestamp": "02:26:18", "text": "君は寝ようと思っているんだ。 寝る。"}, {"type": "subtitle", "time": 8780.95, "timestamp": "02:26:20", "text": "こちらは午前4時です。"}, {"type": "subtitle", "time": 8787.349, "timestamp": "02:26:27", "text": "うん、寝た方がいいよ。 そうそう。"}, {"type": "subtitle", "time": 8791.27, "timestamp": "02:26:31", "text": "明日は月曜日です。 いや、"}, {"type": "subtitle", "time": 8793.429, "timestamp": "02:26:33", "text": "君には仕事があるんだ。"}, {"type": "subtitle", "time": 8795.75, "timestamp": "02:26:35", "text": "眠りたくない。"}, {"type": "subtitle", "time": 8797.99, "timestamp": "02:26:37", "text": "待って、そちらでは今日は"}, {"type": "subtitle", "time": 8800.469, "timestamp": "02:26:40", "text": "日曜日ですか？"}, {"type": "subtitle", "time": 8803.75, "timestamp": "02:26:43", "text": "私にとっては今日は日曜日です。"}]
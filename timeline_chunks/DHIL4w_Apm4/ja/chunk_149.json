[{"type": "subtitle", "time": 8942.79, "timestamp": "02:29:02", "text": "しかし、彼らは"}, {"type": "subtitle", "time": 8947.75, "timestamp": "02:29:07", "text": "私に24時間だけ許可してくれるだろう。"}, {"type": "subtitle", "time": 8952.95, "timestamp": "02:29:12", "text": "毎週これだけの時間働けば、"}, {"type": "subtitle", "time": 8957.75, "timestamp": "02:29:17", "text": "家賃"}, {"type": "subtitle", "time": 8965.429, "timestamp": "02:29:25", "text": "あ、待って。 ゲームは発売されます。"}, {"type": "subtitle", "time": 8968.389, "timestamp": "02:29:28", "text": "ああ、それは新しいですか？"}, {"type": "subtitle", "time": 8971.349, "timestamp": "02:29:31", "text": "目新しいものではない。 それはしばらく前からそこにありました"}, {"type": "subtitle", "time": 8973.51, "timestamp": "02:29:33", "text": "。 海鮮料理の"}, {"type": "subtitle", "time": 8976.15, "timestamp": "02:29:36", "text": "日本料理レストランみたいな感じだと思います。"}, {"type": "subtitle", "time": 8979.99, "timestamp": "02:29:39", "text": "私はただ、この物と"}, {"type": "subtitle", "time": 8983.349, "timestamp": "02:29:43", "text": "その他すべてを配っているだけです。 うん。   それは"}, {"type": "subtitle", "time": 8985.75, "timestamp": "02:29:45", "text": "何、何、どこのレストランですか？"}, {"type": "subtitle", "time": 8989.51, "timestamp": "02:29:49", "text": "えっと、名前が面白いですね。 それはビキニと呼ばれています"}, {"type": "subtitle", "time": 8991.933, "timestamp": "02:29:51", "text": "。"}, {"type": "subtitle", "time": 8992.71, "timestamp": "02:29:52", "text": "[笑い]"}, {"type": "subtitle", "time": 8994.07, "timestamp": "02:29:54", "text": "え？"}, {"type": "subtitle", "time": 8995.27, "timestamp": "02:29:55", "text": "うん。"}, {"type": "subtitle", "time": 8996.63, "timestamp": "02:29:56", "text": "もう一度言ってください。"}, {"type": "subtitle", "time": 8999.59, "timestamp": "02:29:59", "text": "ビキニ。"}]
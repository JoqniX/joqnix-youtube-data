[{"type": "subtitle", "time": 11040.63, "timestamp": "03:04:00", "text": "ああ、"}, {"type": "subtitle", "time": 11045.91, "timestamp": "03:04:05", "text": "新しい従業員が来るんだ。 わかった。 わかった。"}, {"type": "subtitle", "time": 11047.67, "timestamp": "03:04:07", "text": "新入社員。"}, {"type": "subtitle", "time": 11049.51, "timestamp": "03:04:09", "text": "おお。"}, {"type": "subtitle", "time": 11051.99, "timestamp": "03:04:11", "text": "いいえ、新しいインド人従業員のようなものです。 ええ、"}, {"type": "subtitle", "time": 11054.309, "timestamp": "03:04:14", "text": "私の職場にはインド人の従業員が何人かいます"}, {"type": "subtitle", "time": 11055.51, "timestamp": "03:04:15", "text": "。"}, {"type": "subtitle", "time": 11056.469, "timestamp": "03:04:16", "text": "ああ、"}, {"type": "subtitle", "time": 11058.309, "timestamp": "03:04:18", "text": "そのうちの一人だ。 もうすぐだ。 私は"}, {"type": "subtitle", "time": 11079.75, "timestamp": "03:04:39", "text": "ヴァレラントをプレイしていないみたいですね。"}, {"type": "subtitle", "time": 11081.429, "timestamp": "03:04:41", "text": "いいえ。 だって、ここには一緒に"}, {"type": "subtitle", "time": 11083.59, "timestamp": "03:04:43", "text": "遊んでくれる人がいないんだもん。"}, {"type": "subtitle", "time": 11086.15, "timestamp": "03:04:46", "text": "うん、でも"}, {"type": "subtitle", "time": 11087.349, "timestamp": "03:04:47", "text": "ちょっと残念だね。"}, {"type": "subtitle", "time": 11089.429, "timestamp": "03:04:49", "text": "うん、本当だね。"}, {"type": "subtitle", "time": 11094.15, "timestamp": "03:04:54", "text": "待って、私たちがどうやって出会ったか覚えてる？   そうだね、そうやって君と"}, {"type": "subtitle", "time": 11098.389, "timestamp": "03:04:58", "text": "出会ったんだ、そうだね、"}, {"type": "subtitle", "time": 11099.269, "timestamp": "03:04:59", "text": "ほとんど"}]
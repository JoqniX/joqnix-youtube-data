[{"type": "subtitle", "time": 8289.669, "timestamp": "02:18:09", "text": "。 今の権力は、"}, {"type": "subtitle", "time": 8293.11, "timestamp": "02:18:13", "text": "私にあまりにも依存しすぎている。 私は既に「On"}, {"type": "subtitle", "time": 8298.95, "timestamp": "02:18:18", "text": "Par」または「Expedition"}, {"type": "subtitle", "time": 8300.309, "timestamp": "02:18:20", "text": "World」のようなゲームに120時間費やしています。"}, {"type": "subtitle", "time": 8313.75, "timestamp": "02:18:33", "text": "Destiny 2をプレイしたいんだ。Destiny"}, {"type": "subtitle", "time": 8314.23, "timestamp": "02:18:34", "text": "。"}, {"type": "subtitle", "time": 8317.11, "timestamp": "02:18:37", "text": "Destinyをクリアしました。"}, {"type": "subtitle", "time": 8319.75, "timestamp": "02:18:39", "text": "終わったってどういう意味？"}, {"type": "subtitle", "time": 8321.83, "timestamp": "02:18:41", "text": "仕上げる。 それはまるで、"}, {"type": "subtitle", "time": 8323.75, "timestamp": "02:18:43", "text": "クリアできないゲームみたいですよね？"}, {"type": "subtitle", "time": 8325.91, "timestamp": "02:18:45", "text": "やるべきことが山ほどある。"}, {"type": "subtitle", "time": 8326.469, "timestamp": "02:18:46", "text": "あなたは努力する。"}, {"type": "subtitle", "time": 8328.23, "timestamp": "02:18:48", "text": "ああ、終わったんだね。 彼らは止まるんですよね？   あの"}, {"type": "subtitle", "time": 8333.669, "timestamp": "02:18:53", "text": "ゲームを覚えていますか？ ゲームは終了しました。"}, {"type": "subtitle", "time": 8335.83, "timestamp": "02:18:55", "text": "彼らは終わった。  Destiny 2 は終わりました。Destiny"}, {"type": "subtitle", "time": 8338.469, "timestamp": "02:18:58", "text": "2。"}]
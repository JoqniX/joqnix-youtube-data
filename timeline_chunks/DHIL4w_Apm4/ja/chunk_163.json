[{"type": "subtitle", "time": 9786.469, "timestamp": "02:43:06", "text": "おい、俺はまともにズボンを履くことすらできないんだ"}, {"type": "subtitle", "time": 9805.59, "timestamp": "02:43:25", "text": "本当に外出したいと思ったんだけど、私の住んでいる場所にはあまりすることがなくて"}, {"type": "subtitle", "time": 9809.03, "timestamp": "02:43:29", "text": "。"}, {"type": "subtitle", "time": 9812.309, "timestamp": "02:43:32", "text": "それはまるで木と同じだ。"}, {"type": "subtitle", "time": 9826.309, "timestamp": "02:43:46", "text": "ちょっとダサいよね？   まるで"}, {"type": "subtitle", "time": 9829.83, "timestamp": "02:43:49", "text": "町みたいだ。"}, {"type": "subtitle", "time": 9832.63, "timestamp": "02:43:52", "text": "街に戻りたい。"}, {"type": "subtitle", "time": 9838.88, "timestamp": "02:43:58", "text": "。 小型車、車両が至る所にある。"}]
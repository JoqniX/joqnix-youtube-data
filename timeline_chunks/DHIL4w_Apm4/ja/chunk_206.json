[{"type": "subtitle", "time": 12363.11, "timestamp": "03:26:03", "text": "包まないで。 まあ、いろいろ話そうかな"}, {"type": "subtitle", "time": 12366.79, "timestamp": "03:26:06", "text": "。 さて、私がまだやらなければならないことは以下のとおりです"}, {"type": "subtitle", "time": 12369.83, "timestamp": "03:26:09", "text": "。 ええと、一つはウェブサイトです。  2つで"}, {"type": "subtitle", "time": 12375.03, "timestamp": "03:26:15", "text": "十分だ。ああ、チャットGが終わった。"}, {"type": "subtitle", "time": 12380.87, "timestamp": "03:26:20", "text": "インドにいたから1年間無料購読できたんだけど、"}, {"type": "subtitle", "time": 12383.99, "timestamp": "03:26:23", "text": "購読のことだよね？ ああ、そうだった、"}, {"type": "subtitle", "time": 12387.75, "timestamp": "03:26:27", "text": "忘れてた。"}, {"type": "subtitle", "time": 12397.83, "timestamp": "03:26:37", "text": "。 あなたのことを忘れていました。"}, {"type": "subtitle", "time": 12407.11, "timestamp": "03:26:47", "text": "待って。   今日は"}, {"type": "subtitle", "time": 12410.87, "timestamp": "03:26:50", "text": "11月5日です。 いや、"}, {"type": "subtitle", "time": 12415.75, "timestamp": "03:26:55", "text": "それなら時間があるよ。 何てことだ。"}]
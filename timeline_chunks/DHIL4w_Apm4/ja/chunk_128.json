[{"type": "subtitle", "time": 7726.55, "timestamp": "02:08:46", "text": "ああ、"}, {"type": "subtitle", "time": 7728.55, "timestamp": "02:08:48", "text": "チャック、君の声が聞こえないよ。"}, {"type": "subtitle", "time": 7730.709, "timestamp": "02:08:50", "text": "何？"}, {"type": "subtitle", "time": 7733.91, "timestamp": "02:08:53", "text": "待って、待って、待って。"}, {"type": "subtitle", "time": 7736.87, "timestamp": "02:08:56", "text": "私が何に尋ねたか知っていましたか？"}, {"type": "subtitle", "time": 7738.39, "timestamp": "02:08:58", "text": "はい、まだ聞こえますよ。"}, {"type": "subtitle", "time": 7739.43, "timestamp": "02:08:59", "text": "うん。"}]
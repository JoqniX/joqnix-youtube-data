[{"type": "subtitle", "time": 11101.269, "timestamp": "03:05:01", "text": "理論を通して"}, {"type": "subtitle", "time": 11104.79, "timestamp": "03:05:04", "text": "州を通してだと思う、"}, {"type": "subtitle", "time": 11108.15, "timestamp": "03:05:08", "text": "うん、州、"}, {"type": "subtitle", "time": 11110.15, "timestamp": "03:05:10", "text": "うん、理論は"}, {"type": "subtitle", "time": 11116.71, "timestamp": "03:05:16", "text": "うん、今彼らは私のチャンピオンをめちゃくちゃにした、"}, {"type": "subtitle", "time": 11123.75, "timestamp": "03:05:23", "text": "ヨロの変化がわかるかい、わかるかい"}, {"type": "subtitle", "time": 11124.469, "timestamp": "03:05:24", "text": "？"}, {"type": "subtitle", "time": 11129.03, "timestamp": "03:05:29", "text": "いいえ、していません。 だから、私はまだ見ていないんです。"}, {"type": "subtitle", "time": 11132.95, "timestamp": "03:05:32", "text": "例えば、フラッシュが1回しかないとか、すごく"}, {"type": "subtitle", "time": 11151.269, "timestamp": "03:05:51", "text": "あ、待って。 他の人たちは"}, {"type": "subtitle", "time": 11154.07, "timestamp": "03:05:54", "text": "waroxカテゴリーでどんなことをしているんだろう。"}, {"type": "subtitle", "time": 11156.55, "timestamp": "03:05:56", "text": "確認してみます。"}, {"type": "subtitle", "time": 11158.389, "timestamp": "03:05:58", "text": "ああ、あまり人がいないな。 いいえ、"}]
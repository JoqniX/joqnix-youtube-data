[{"type": "subtitle", "time": 12424.15, "timestamp": "03:27:04", "text": "はい、この角地のプランは10月5日に更新されます"}, {"type": "subtitle", "time": 12448.389, "timestamp": "03:27:28", "text": "どうなるか見てみましょう。 いくつか取り組んでいることがあります"}, {"type": "subtitle", "time": 12452.15, "timestamp": "03:27:32", "text": "。"}, {"type": "subtitle", "time": 12455.349, "timestamp": "03:27:35", "text": "それらのことはすぐに片付けます。"}, {"type": "subtitle", "time": 12457.349, "timestamp": "03:27:37", "text": "えっと、"}, {"type": "subtitle", "time": 12460.389, "timestamp": "03:27:40", "text": "今日の出来事のせいで、"}, {"type": "subtitle", "time": 12463.269, "timestamp": "03:27:43", "text": "アバウトパネルとか"}, {"type": "subtitle", "time": 12465.19, "timestamp": "03:27:45", "text": "全部変更しないといけないって気づいたんです。"}, {"type": "subtitle", "time": 12466.87, "timestamp": "03:27:46", "text": "えっと、そうすれば、"}, {"type": "subtitle", "time": 12473.99, "timestamp": "03:27:53", "text": "私が何をしているのかとか、そういうことがみんなに理解しやすくなるんですよね"}]
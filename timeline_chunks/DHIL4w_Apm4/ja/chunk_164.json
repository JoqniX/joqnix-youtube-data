[{"type": "subtitle", "time": 9856.15, "timestamp": "02:44:16", "text": "彼らは襲撃する相手を探していて、たまたま"}, {"type": "subtitle", "time": 9858.55, "timestamp": "02:44:18", "text": "私のチャンネルを見つけたか"}, {"type": "subtitle", "time": 9861.19, "timestamp": "02:44:21", "text": "何かだったようです。 彼らは私を尾行してきた。 とても申し訳"}, {"type": "subtitle", "time": 9863.03, "timestamp": "02:44:23", "text": "ない気持ちになった。"}, {"type": "subtitle", "time": 9863.99, "timestamp": "02:44:23", "text": "でも、"}, {"type": "subtitle", "time": 9865.99, "timestamp": "02:44:25", "text": "何を見ているの？ 彼らは"}, {"type": "subtitle", "time": 9869.11, "timestamp": "02:44:29", "text": "襲撃する相手を探している。 ええ、私はただ、"}, {"type": "subtitle", "time": 9893.91, "timestamp": "02:44:53", "text": "日本のWドッグ配信者を見ていたので、"}, {"type": "subtitle", "time": 9897.59, "timestamp": "02:44:57", "text": "彼らがどのサーバーに参加するのかを知ることができました。"}]
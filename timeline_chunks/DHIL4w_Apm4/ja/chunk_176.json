[{"type": "subtitle", "time": 10562.87, "timestamp": "02:56:02", "text": "ARをインストールしたんですよね？ えっと、"}, {"type": "subtitle", "time": 10564.23, "timestamp": "02:56:04", "text": "マトン。"}, {"type": "subtitle", "time": 10565.269, "timestamp": "02:56:05", "text": "ええ、"}, {"type": "subtitle", "time": 10569.59, "timestamp": "02:56:09", "text": "インストールしないといけないですね。 あ、"}, {"type": "subtitle", "time": 10571.429, "timestamp": "02:56:11", "text": "バトルフィールドをダウンロードしてるんだ。 今の"}, {"type": "subtitle", "time": 10574.07, "timestamp": "02:56:14", "text": "試合の状況を見てみたい。 私は"}, {"type": "subtitle", "time": 10576.71, "timestamp": "02:56:16", "text": "あなたのようにVF6を"}, {"type": "subtitle", "time": 10578.71, "timestamp": "02:56:18", "text": "5ヶ月間プレイしていません。"}, {"type": "subtitle", "time": 10581.83, "timestamp": "02:56:21", "text": "ああ、BF6だ。"}, {"type": "subtitle", "time": 10586.23, "timestamp": "02:56:26", "text": "[笑い] 今のところ"}, {"type": "subtitle", "time": 10589.51, "timestamp": "02:56:29", "text": "評価が賛否両論なので、何とも言えません"}, {"type": "subtitle", "time": 10591.51, "timestamp": "02:56:31", "text": "。"}, {"type": "subtitle", "time": 10593.19, "timestamp": "02:56:33", "text": "発売当初は良かったけど、最近はちょっと勢いが落ちてきたと思う"}, {"type": "subtitle", "time": 10599.67, "timestamp": "02:56:39", "text": "。 転んだ。本当に"}, {"type": "subtitle", "time": 10600.309, "timestamp": "02:56:40", "text": "ひどく転んだ。"}, {"type": "subtitle", "time": 10605.03, "timestamp": "02:56:45", "text": "ええ、落ちてきています。"}, {"type": "subtitle", "time": 10606.95, "timestamp": "02:56:46", "text": "本当に葛藤しているんです。 例えば、"}, {"type": "subtitle", "time": 10609.75, "timestamp": "02:56:49", "text": "ワード・ドッグスが好きになるべきでしょうか？ よし、新しい"}, {"type": "subtitle", "time": 10612.15, "timestamp": "02:56:52", "text": "ゲームだ。 まるで、これまでで"}, {"type": "subtitle", "time": 10614.469, "timestamp": "02:56:54", "text": "最高の試合のように扱っているような気分です。 話題性は確かに存在する。"}, {"type": "subtitle", "time": 10618.63, "timestamp": "02:56:58", "text": "少し遊んでみてください。 様子を見てみよう。"}]
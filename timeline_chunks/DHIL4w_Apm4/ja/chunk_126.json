[{"type": "subtitle", "time": 7560.07, "timestamp": "02:06:00", "text": "おお。 ええと、そこが境界"}, {"type": "subtitle", "time": 7562.95, "timestamp": "02:06:02", "text": "線だと思います。 そうではないかもしれない。   もしかしたら私の"}, {"type": "subtitle", "time": 7564.79, "timestamp": "02:06:04", "text": "勘違いかもしれない。   それは"}, {"type": "subtitle", "time": 7569.589, "timestamp": "02:06:09", "text": "何ですか？ 配信では59です。"}, {"type": "subtitle", "time": 7571.99, "timestamp": "02:06:11", "text": "ええ、そう、それがその線であるべきです。 たぶん"}, {"type": "subtitle", "time": 7580.79, "timestamp": "02:06:20", "text": "彼は"}, {"type": "subtitle", "time": 7582.47, "timestamp": "02:06:22", "text": "「ごめん、ゲームはSkypeファイトなんだ。"}, {"type": "subtitle", "time": 7584.79, "timestamp": "02:06:24", "text": "今日は少しだけプレイしたよ」って感じでした。 しかし重要なのは"}, {"type": "subtitle", "time": 7586.87, "timestamp": "02:06:26", "text": "、あなたのチームが"}, {"type": "subtitle", "time": 7588.149, "timestamp": "02:06:28", "text": "プレーの仕方を理解している必要があるということです。"}, {"type": "subtitle", "time": 7594.069, "timestamp": "02:06:34", "text": "はい。 そして、私はそれを予約注文しました。   実は"}, {"type": "subtitle", "time": 7597.189, "timestamp": "02:06:37", "text": "予約注文したんです。"}, {"type": "subtitle", "time": 7601.109, "timestamp": "02:06:41", "text": "予約注文したなんて、正気じゃないよ。"}, {"type": "subtitle", "time": 7602.229, "timestamp": "02:06:42", "text": "うん。"}, {"type": "subtitle", "time": 7607.35, "timestamp": "02:06:47", "text": "チャック、自分の信用スコアについて考えてみてください。"}, {"type": "subtitle", "time": 7610.522, "timestamp": "02:06:50", "text": "分かってるよ（"}, {"type": "subtitle", "time": 7611.35, "timestamp": "02:06:51", "text": "笑）"}, {"type": "subtitle", "time": 7614.629, "timestamp": "02:06:54", "text": "あの功績は君のものではないよ、"}, {"type": "subtitle", "time": 7615.91, "timestamp": "02:06:55", "text": "チャック。"}, {"type": "subtitle", "time": 7619.83, "timestamp": "02:06:59", "text": "ええ、おっしゃる通りです。   よく考えてみて"}]
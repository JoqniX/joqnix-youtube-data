[{"type": "subtitle", "time": 10200.23, "timestamp": "02:50:00", "text": "友達の多くは私のゲームをプレイしないので、"}, {"type": "subtitle", "time": 10202.63, "timestamp": "02:50:02", "text": "ゲームはしません。 そういう側面もあるんですね"}, {"type": "subtitle", "time": 10205.269, "timestamp": "02:50:05", "text": "。 私もそれに気づきました。   だから、"}, {"type": "subtitle", "time": 10213.91, "timestamp": "02:50:13", "text": "。 何とかして"}, {"type": "subtitle", "time": 10216.15, "timestamp": "02:50:16", "text": "彼女を誘って一緒に遊ぶか、一人で遊ぶかのどちらかだ"}, {"type": "subtitle", "time": 10218.63, "timestamp": "02:50:18", "text": "。 うんうん。"}, {"type": "subtitle", "time": 10220.469, "timestamp": "02:50:20", "text": "例えば、マラソンなど。 マラソン。"}, {"type": "subtitle", "time": 10223.51, "timestamp": "02:50:23", "text": "私の"}, {"type": "subtitle", "time": 10226.79, "timestamp": "02:50:26", "text": "友達の中で、このジャンルのゲームをプレイするのはあなただけです。"}, {"type": "subtitle", "time": 10228.389, "timestamp": "02:50:28", "text": "それ以外では、このジャンルのゲームをプレイする人は誰もいない"}, {"type": "subtitle", "time": 10236.87, "timestamp": "02:50:36", "text": "うん。 ほとんどの場合、一人で遊んでいます。   わかった"}, {"type": "subtitle", "time": 10239.349, "timestamp": "02:50:39", "text": "。 ストリームの問題は解決しました。 わーい。 今度は"}, {"type": "subtitle", "time": 10241.99, "timestamp": "02:50:41", "text": "赤に戻った。 同様の"}, {"type": "subtitle", "time": 10250.71, "timestamp": "02:50:50", "text": "でも、そうですね、"}, {"type": "subtitle", "time": 10257.19, "timestamp": "02:50:57", "text": "日本語を話せる人を見つけられたらいいなと思っています。そして、あなたと一緒に遊んでいるように、そうですよね"}, {"type": "subtitle", "time": 10259.99, "timestamp": "02:50:59", "text": "？ 私たちは遊び、生活し、"}]
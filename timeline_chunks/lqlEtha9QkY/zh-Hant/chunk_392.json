[{"type": "subtitle", "time": 23529.15, "timestamp": "06:32:09", "text": "哦，等等。樓層比我低。"}, {"type": "subtitle", "time": 23538.31, "timestamp": "06:32:18", "text": "好吧，我真笨。  它就在我下面。  好的。嗯，"}, {"type": "subtitle", "time": 23552.15, "timestamp": "06:32:32", "text": "等等。"}, {"type": "subtitle", "time": 23554.31, "timestamp": "06:32:34", "text": "哪三項技能？我應該選羅克西。 Roxy是"}, {"type": "subtitle", "time": 23556.35, "timestamp": "06:32:36", "text": "這門課的正確名稱"}, {"type": "subtitle", "time": 23558.868, "timestamp": "06:32:38", "text": "。我忘了。  他擁有非常酷炫的"}, {"type": "subtitle", "time": 23560.788, "timestamp": "06:32:40", "text": "合成器和"}, {"type": "subtitle", "time": 23563.59, "timestamp": "06:32:43", "text": "熱情周到的幫助。嗯。  我的名字叫莫西"}, {"type": "subtitle", "time": 23567.15, "timestamp": "06:32:47", "text": "。嗨，Moxy。好的。嗨，Mo。收到。"}, {"type": "subtitle", "time": 23571.03, "timestamp": "06:32:51", "text": "我需要自我庇護。哦，Roxy是NPC的名字。"}, {"type": "subtitle", "time": 23577.19, "timestamp": "06:32:57", "text": "什麼？  啊，這部劇是以印度人為主角的。  哦，原來是"}]
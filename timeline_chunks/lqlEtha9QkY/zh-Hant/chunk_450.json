[{"type": "subtitle", "time": 27008.948, "timestamp": "07:30:08", "text": "影片之類的東西，我盡力想睡著，但是，嗯，我聽著音樂，然後就睡著了。"}, {"type": "subtitle", "time": 27023.43, "timestamp": "07:30:23", "text": "我還要"}, {"type": "subtitle", "time": 27025.948, "timestamp": "07:30:25", "text": "上學，所以只會待幾分鐘。嗨。你好。過來一下。嘿。是的。  喬許。所以，嗯，你知道，呃，"}, {"type": "subtitle", "time": 27049.11, "timestamp": "07:30:49", "text": "基本上我最近在做的事情，現在想想，該怎麼稱呼它呢？嗯，它叫什麼來著？我其實"}]
[{"type": "subtitle", "time": 37561.19, "timestamp": "10:26:01", "text": "對不起。"}, {"type": "subtitle", "time": 37564.07, "timestamp": "10:26:04", "text": "你看過那部《星際大戰》嗎？牛在哪裡？是的。是不是就像看不到「哪裡有"}, {"type": "subtitle", "time": 37566.95, "timestamp": "10:26:06", "text": "另一個"}, {"type": "subtitle", "time": 37584.07, "timestamp": "10:26:24", "text": "食指可以瞄準？」？一。哦，就像用我的棍子敲你的頭一樣。看看我的"}, {"type": "subtitle", "time": 37586.31, "timestamp": "10:26:26", "text": "拐杖。我的天啊。你會感受到我的棍子"}, {"type": "subtitle", "time": 37587.83, "timestamp": "10:26:27", "text": "在你身上留下的印記嗎？摸摸我的棍子。我的棍子。聽起來像是在釣魚。"}, {"type": "subtitle", "time": 37601.67, "timestamp": "10:26:41", "text": "我不會說謊。我的棍子比我之前用軟棍子打獵時好多了，我現在在別的地方。我不知道自己身在何處。我感覺自己像身處一座雪山之中。哦親愛的。你已經到了。"}, {"type": "subtitle", "time": 37611.19, "timestamp": "10:26:51", "text": "哦，天哪。別被凍住了。問題在於，我不知為何"}]
[{"type": "subtitle", "time": 34474.39, "timestamp": "09:34:34", "text": "停下那條母狗，因為"}, {"type": "subtitle", "time": 34482.23, "timestamp": "09:34:42", "text": "這是斜坡。我"}, {"type": "subtitle", "time": 34486.31, "timestamp": "09:34:46", "text": "送貨完成了嗎？走吧。還有，"}, {"type": "subtitle", "time": 34491.99, "timestamp": "09:34:51", "text": "夥計們，我被攻擊了。我被襲擊了。我被襲擊了。"}, {"type": "subtitle", "time": 34497.35, "timestamp": "09:34:57", "text": "哦，該死。英國模擬器。模擬器。"}, {"type": "subtitle", "time": 34499.11, "timestamp": "09:34:59", "text": "什麼？我可以模擬誰？那些長得過大的藍色小精靈想殺了我。請幫幫我。你在哪裡？你在哪裡？我在滑索旁邊。滑索。搞什麼鬼"}]
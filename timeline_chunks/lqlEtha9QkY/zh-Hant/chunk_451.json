[{"type": "subtitle", "time": 27079.19, "timestamp": "07:31:19", "text": "如果我早起早睡早起，準時起床，我就能有更多的時間做自己想做的事情。  所以"}, {"type": "subtitle", "time": 27090.708, "timestamp": "07:31:30", "text": "我認為這樣"}, {"type": "subtitle", "time": 27100.628, "timestamp": "07:31:40", "text": "沒問題。然後就像昨天，我突然有很多時間，我第一次好好地看了動漫，我在六個小時內看完了一整季。是的。是的。"}, {"type": "subtitle", "time": 27102.67, "timestamp": "07:31:42", "text": "你好，羅伯特傑克森。  是的。你好"}, {"type": "subtitle", "time": 27113.868, "timestamp": "07:31:53", "text": "，笨蛋。"}, {"type": "subtitle", "time": 27116.868, "timestamp": "07:31:56", "text": "嗨，甜心。"}]
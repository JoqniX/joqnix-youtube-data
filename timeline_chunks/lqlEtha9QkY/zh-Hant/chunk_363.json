[{"type": "subtitle", "time": 21787.91, "timestamp": "06:03:07", "text": "哦，不錯。  太酷了！我為什麼要關心"}, {"type": "subtitle", "time": 21790.548, "timestamp": "06:03:10", "text": "這個？  等等，"}, {"type": "subtitle", "time": 21811.03, "timestamp": "06:03:31", "text": "我覺得他不要我的低階槍。  榮耀歸於雙生神。哦，我升"}, {"type": "subtitle", "time": 21825.03, "timestamp": "06:03:45", "text": "等等，我接受了嗎？  我明白了嗎？我明白了嗎？  不，"}, {"type": "subtitle", "time": 21837.708, "timestamp": "06:03:57", "text": "我沒明白。  奧尼亞。稍等片刻。  我明白了嗎？不，是女王選擇領導你們。兄弟姊妹們，"}]
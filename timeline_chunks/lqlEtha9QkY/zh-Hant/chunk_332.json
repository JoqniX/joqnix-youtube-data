[{"type": "subtitle", "time": 19926.868, "timestamp": "05:32:06", "text": "我會把它"}, {"type": "subtitle", "time": 19930.23, "timestamp": "05:32:10", "text": "賣掉。它賣了個好價錢。 223. 我將出售"}, {"type": "subtitle", "time": 19933.868, "timestamp": "05:32:13", "text": "槍械皮膚。我們走吧。讓我加入。你是什​​麼意思？  等待。回來。我爸爸剛剛打了個電話給我。等待。你"}, {"type": "subtitle", "time": 19937.19, "timestamp": "05:32:17", "text": "想加入，但是當力量等級提升之類的時候呢？好的，那告訴我你"}]
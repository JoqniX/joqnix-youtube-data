[{"type": "subtitle", "time": 21245.27, "timestamp": "05:54:05", "text": "切換到遊戲，我們就可以回去了。嗨，我們走吧。哦，我忘了那個呃……東西。忘了說「等等」。我當時在玩《Rash"}, {"type": "subtitle", "time": 21276.708, "timestamp": "05:54:36", "text": "我身為球員也有我的職責要履行。"}, {"type": "subtitle", "time": 21287.47, "timestamp": "05:54:47", "text": "我玩了一會兒部落衝突，因為"}, {"type": "subtitle", "time": 21290.47, "timestamp": "05:54:50", "text": "這是工作要求。一秒鐘。呃，"}]
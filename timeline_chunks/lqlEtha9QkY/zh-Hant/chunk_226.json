[{"type": "subtitle", "time": 13578.71, "timestamp": "03:46:18", "text": "真正的？謝謝你，勞拉。哦，他/她正在款待所有人。"}, {"type": "subtitle", "time": 13582.309, "timestamp": "03:46:22", "text": "我永遠不會放棄追求它。"}, {"type": "subtitle", "time": 13598.87, "timestamp": "03:46:38", "text": "。讓我們向他們展示一下，一點點咖啡因能為我們的士氣帶來多大的鼓舞。  你好"}]
[{"type": "subtitle", "time": 7163.31, "timestamp": "01:59:23", "text": "是《百合》。然後"}, {"type": "subtitle", "time": 7167.629, "timestamp": "01:59:27", "text": "我迷上了Yoi。所以我以前常常看漫畫，而不是看漫畫書。  百合漫畫。 Vampers就是其中之一。我以前看《吸血鬼》的時候，覺得它太可愛了。"}, {"type": "subtitle", "time": 7170.55, "timestamp": "01:59:30", "text": "所以當我開始看《吸血鬼》漫畫的時候，作者就開始創作那部漫畫了。所以"}, {"type": "subtitle", "time": 7190.55, "timestamp": "01:59:50", "text": "我"}, {"type": "subtitle", "time": 7192.31, "timestamp": "01:59:52", "text": "只讀了兩章。是的，只有兩"}]
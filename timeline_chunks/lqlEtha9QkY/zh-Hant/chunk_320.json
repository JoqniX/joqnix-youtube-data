[{"type": "subtitle", "time": 19202.628, "timestamp": "05:20:02", "text": "你殺了他。  我把這事怪在你頭上。"}, {"type": "subtitle", "time": 19205.43, "timestamp": "05:20:05", "text": "沒有"}, {"type": "subtitle", "time": 19207.51, "timestamp": "05:20:07", "text": "彈藥。  感受一下。疼痛。  不。 [音樂]我知道。  哦，好多武器。  武器皮可以。我們走吧。我"}, {"type": "subtitle", "time": 19213.83, "timestamp": "05:20:13", "text": "接受。我要這個。獵人，帶我們回去。好的。好的。好東西。我們走吧。  [掌聲] 非常感謝。殺戮世界。  好的。山地"}, {"type": "subtitle", "time": 19224.948, "timestamp": "05:20:24", "text": "殺手球充電包。  好的。  哇。"}, {"type": "subtitle", "time": 19230.23, "timestamp": "05:20:30", "text": "哦，我們拿到了157分"}]
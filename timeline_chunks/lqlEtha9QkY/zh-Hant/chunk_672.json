[{"type": "subtitle", "time": 40323.746, "timestamp": "11:12:03", "text": "？我必須……我該把這個放在哪裡？我想我們得回去。好，我們走吧"}, {"type": "subtitle", "time": 40326.87, "timestamp": "11:12:06", "text": "。  好的。好的，"}, {"type": "subtitle", "time": 40333.426, "timestamp": "11:12:13", "text": "我們需要更多骨頭。哦，我想是骨頭。是的，"}, {"type": "subtitle", "time": 40341.426, "timestamp": "11:12:21", "text": "房子裡有骨頭。我們去拿吧。  太棒了，兄弟。好的，"}, {"type": "subtitle", "time": 40343.19, "timestamp": "11:12:23", "text": "我要斷開連線了。就像那樣。  我們沒有綠色的，女孩說：「快上車，loser。我們"}, {"type": "subtitle", "time": 40344.55, "timestamp": "11:12:24", "text": "要去購物。」人們有"}, {"type": "subtitle", "time": 40349.426, "timestamp": "11:12:29", "text": "棍子嗎"}, {"type": "subtitle", "time": 40352.47, "timestamp": "11:12:32", "text": "？夥計們，"}, {"type": "subtitle", "time": 40366.31, "timestamp": "11:12:46", "text": "我需要棍子。  一些樹枝。  我弄到了一些木棍。  拿起你的棍子。我們有棍子。打擾一下。我們已經得到了足夠的。這樣可以。我要斷開連線再重新連線。  好的。好的。如果有人有長袍，請給"}, {"type": "subtitle", "time": 40369.906, "timestamp": "11:12:49", "text": "我一件。  如果"}, {"type": "subtitle", "time": 40373.746, "timestamp": "11:12:53", "text": "你有俱樂部的話，"}]
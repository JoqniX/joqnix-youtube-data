[{"type": "subtitle", "time": 35040.55, "timestamp": "09:44:00", "text": "直接死了。搞什麼鬼？夥計們，我有個油桶。哦，好吧，沒事。我不需要幫助。我是一個強壯、獨立的男人。怎麼了？就是這輛。"}, {"type": "subtitle", "time": 35045.47, "timestamp": "09:44:05", "text": "好的。哦，就是這輛。是啊。"}, {"type": "subtitle", "time": 35056.95, "timestamp": "09:44:16", "text": "呃，好的。好的。好的。好的。"}, {"type": "subtitle", "time": 35059.35, "timestamp": "09:44:19", "text": "我們該怎麼辦？這輛車更像是個能開的交通工具。我們要燒死那個女巫。"}, {"type": "subtitle", "time": 35067.266, "timestamp": "09:44:27", "text": "對。走吧。我"}, {"type": "subtitle", "time": 35070.31, "timestamp": "09:44:30", "text": "不知道他們在幹嘛。嗯，"}, {"type": "subtitle", "time": 35073.11, "timestamp": "09:44:33", "text": "你什麼意思？我也不知道他們在"}, {"type": "subtitle", "time": 35075.19, "timestamp": "09:44:35", "text": "幹嘛。我們是第一個。我的意思是，食人族殺死食人族"}, {"type": "subtitle", "time": 35087.19, "timestamp": "09:44:47", "text": "。我死了。夥計們，聽著。我靠我的兄弟們過來。別介意。別介意。別介意"}]
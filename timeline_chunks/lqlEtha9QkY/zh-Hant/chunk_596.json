[{"type": "subtitle", "time": 35767.266, "timestamp": "09:56:07", "text": "食人族，爬上去。誰有繩子？"}, {"type": "subtitle", "time": 35782.55, "timestamp": "09:56:22", "text": "不，他們不會。我有一條"}, {"type": "subtitle", "time": 35786.71, "timestamp": "09:56:26", "text": "繩子。你想要嗎？是的，我願意。我們該趕緊"}, {"type": "subtitle", "time": 35792.15, "timestamp": "09:56:32", "text": "去睡覺嗎？我認為他們"}, {"type": "subtitle", "time": 35794.71, "timestamp": "09:56:34", "text": "做不到。她離得太遠了。  太遠了。非常。好的。親愛的薩萊。是的。像一些雪山。  親愛的薩爾"}, {"type": "subtitle", "time": 35801.906, "timestamp": "09:56:41", "text": "，"}, {"type": "subtitle", "time": 35803.426, "timestamp": "09:56:43", "text": "你好嗎？  我們做棍子。我們找到了樹枝。呃，棍子、布和繩子。黏布。繩索。知道了。箭矢其實就是羽毛。我需要羽毛。羽毛和樹枝。呃，有人有多餘的羽毛嗎"}, {"type": "subtitle", "time": 35811.746, "timestamp": "09:56:51", "text": "？  誰有羽毛可以給我？我得到了一根羽毛。"}]
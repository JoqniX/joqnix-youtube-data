[{"type": "subtitle", "time": 12496.389, "timestamp": "03:28:16", "text": "商業敲門，"}, {"type": "subtitle", "time": 12498.389, "timestamp": "03:28:18", "text": "與盟友"}, {"type": "subtitle", "time": 12502.95, "timestamp": "03:28:22", "text": "戰鬥。  是的。  好的。  嗯？等等，我把它掉在地上了？哦，不。"}, {"type": "subtitle", "time": 12506.15, "timestamp": "03:28:26", "text": "不，不，不，不，不。畢竟，當地人也需要一些可以下注的東西"}, {"type": "subtitle", "time": 12510.51, "timestamp": "03:28:30", "text": "。  所以，這是142。"}, {"type": "subtitle", "time": 12514.309, "timestamp": "03:28:34", "text": "嗯，"}, {"type": "subtitle", "time": 12518.309, "timestamp": "03:28:38", "text": "如果我想的話，你知道嗎？我會把這個存起來。別這樣了。我不需要這個。實際上，我還是把它放下了，以防"}, {"type": "subtitle", "time": 12520.95, "timestamp": "03:28:40", "text": "萬一。我會好好休養。我們不會造成燙傷。這些"}, {"type": "subtitle", "time": 12531.31, "timestamp": "03:28:51", "text": "我可以賣掉。好的。我可以賣掉我不需要的東西。我升級了"}]
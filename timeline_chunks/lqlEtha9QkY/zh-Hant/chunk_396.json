[{"type": "subtitle", "time": 23773.83, "timestamp": "06:36:13", "text": "結束了。  老闆那邊狀況如何？  什麼？  是的，他（音樂）要來了。讓我們來看看。哦，這些"}, {"type": "subtitle", "time": 23777.67, "timestamp": "06:36:17", "text": "老闆。這張地圖上，boss 到底在哪裡來著"}, {"type": "subtitle", "time": 23780.39, "timestamp": "06:36:20", "text": "？  還是我贏了他？"}, {"type": "subtitle", "time": 23798.57, "timestamp": "06:36:38", "text": "我覺得我還沒打敗他們。  給狗狗們放"}, {"type": "subtitle", "time": 23801.868, "timestamp": "06:36:41", "text": "音樂。好了，我們走吧。有一種方法可以像兔子跳一樣更快地旅行。你滑行，然後做……做某事。"}, {"type": "subtitle", "time": 23810.468, "timestamp": "06:36:50", "text": "我忘了它叫什麼了。我猜他們沒有修復這個問題，是的"}]
[{"type": "subtitle", "time": 33674.39, "timestamp": "09:21:14", "text": "多時間上台。我為你感到非常驕傲。我愛你，"}, {"type": "subtitle", "time": 33681.03, "timestamp": "09:21:21", "text": "貝絲。我也愛你。"}, {"type": "subtitle", "time": 33682.39, "timestamp": "09:21:22", "text": "我可以"}, {"type": "subtitle", "time": 33685.746, "timestamp": "09:21:25", "text": "爬窗進去嗎？我真希望我種過西紅柿"}, {"type": "subtitle", "time": 33687.83, "timestamp": "09:21:27", "text": "。去吧。我希望……我希望其中一個行李箱裡有耳塞，夥計"}, {"type": "subtitle", "time": 33700.63, "timestamp": "09:21:40", "text": "為什麼……在門外偷看？哦不。"}, {"type": "subtitle", "time": 33707.67, "timestamp": "09:21:47", "text": "哦，什麼？什麼？我死了，混蛋。我死了。"}]
[{"type": "subtitle", "time": 41943.35, "timestamp": "11:39:03", "text": "？一根棍子。"}, {"type": "subtitle", "time": 41948.586, "timestamp": "11:39:08", "text": "她需要一堆木棍。只是說說而已。  好了，各位。裡面就像有木頭一樣。"}, {"type": "subtitle", "time": 41956.87, "timestamp": "11:39:16", "text": "好了，卡拉，我們走吧。哦，還有一張"}, {"type": "subtitle", "time": 41958.23, "timestamp": "11:39:18", "text": "幻燈片。來，來，來。我們"}, {"type": "subtitle", "time": 41964.04, "timestamp": "11:39:24", "text": "走吧。我的上帝。我們"}, {"type": "subtitle", "time": 41967.99, "timestamp": "11:39:27", "text": "可以一起去滑雪橇。  是啊，你會想，讓我們更進一步。"}, {"type": "subtitle", "time": 41982.07, "timestamp": "11:39:42", "text": "我會獲取日誌。你會得到木棍。  好的。希望我們能找到那隻鹿。哦，是的。是的。是的。"}, {"type": "subtitle", "time": 41983.586, "timestamp": "11:39:43", "text": "我們走吧。  我們走吧。你還"}, {"type": "subtitle", "time": 41999.106, "timestamp": "11:39:59", "text": "記得這件事嗎？我的意思是，如果那樣的話就沒問題，但不能是獵鹿人。  我遇到了一把弓箭。呃，"}]
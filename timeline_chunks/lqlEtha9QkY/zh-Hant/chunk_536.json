[{"type": "subtitle", "time": 32160.308, "timestamp": "08:56:00", "text": "喜歡番茄醬。是的。 哦真的嗎？把我的誘餌放在我身上。希望我所在城市的北部和南部地區能夠跟上步伐。別擔心。"}, {"type": "subtitle", "time": 32164.43, "timestamp": "08:56:04", "text": "就是你在"}, {"type": "subtitle", "time": 32167.43, "timestamp": "08:56:07", "text": "反應中看到的那個。等待。那真不錯。 ，一個假油管主播，他不投入，你不是一個真正的油管主播，不投入，那就是我，我想"}, {"type": "subtitle", "time": 32196.388, "timestamp": "08:56:36", "text": "很多年了，這太真實了，我的一生，如果你看到右下角的通知說我正在"}, {"type": "subtitle", "time": 32202.43, "timestamp": "08:56:42", "text": "玩《"}, {"type": "subtitle", "time": 32218.628, "timestamp": "08:56:58", "text": "戰爭雷霆》"}]
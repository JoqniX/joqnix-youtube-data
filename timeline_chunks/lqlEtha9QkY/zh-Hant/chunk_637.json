[{"type": "subtitle", "time": 38244.39, "timestamp": "10:37:24", "text": "我覺得我沒那麼多肉"}, {"type": "subtitle", "time": 38247.266, "timestamp": "10:37:27", "text": "。  我應該自己種蘆薈。"}, {"type": "subtitle", "time": 38252.266, "timestamp": "10:37:32", "text": "不，我自己有蘆薈。各位，我們"}, {"type": "subtitle", "time": 38279.11, "timestamp": "10:37:59", "text": "你要去哪裡"}]
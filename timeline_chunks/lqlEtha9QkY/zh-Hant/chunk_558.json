[{"type": "subtitle", "time": 33487.112, "timestamp": "09:18:07", "text": "對不起，女士。我的天哪。好的，沒關係。沒關係。他可以參與表演。讓他表演吧。"}, {"type": "subtitle", "time": 33493.67, "timestamp": "09:18:13", "text": "好的，別這樣別，別傻。你"}, {"type": "subtitle", "time": 33497.67, "timestamp": "09:18:17", "text": "知道，"}, {"type": "subtitle", "time": 33499.99, "timestamp": "09:18:19", "text": "你知道剛才發生了什麼事嗎？我設定了一個訂閱提醒，大約兩週前設定的，這是第一次生效。我太興奮了。等等，有人有鵝卵石嗎"}, {"type": "subtitle", "time": 33502.95, "timestamp": "09:18:22", "text": "？有人有鵝卵石嗎？有。讓"}, {"type": "subtitle", "time": 33512.708, "timestamp": "09:18:32", "text": "開"}, {"type": "subtitle", "time": 33521.908, "timestamp": "09:18:41", "text": "我得洗掉血跡"}, {"type": "subtitle", "time": 33524.708, "timestamp": "09:18:44", "text": "。你能去另一邊嗎？"}, {"type": "subtitle", "time": 33534.95, "timestamp": "09:18:54", "text": "哦，好的。等一下。嗯？好的。以防萬一，我把炸藥拿出來了。好的。兄弟，我要死了。我離死只有一槍之遙。"}]
[{"type": "subtitle", "time": 4411.59, "timestamp": "01:13:31", "text": "就想，「什麼？你怎麼會喜歡那樣的東西？」我喜歡冰牛奶。好的。尤其是在炎熱的季節，冰"}, {"type": "subtitle", "time": 4417.189, "timestamp": "01:13:37", "text": "牛奶更好喝。"}, {"type": "subtitle", "time": 4419.27, "timestamp": "01:13:39", "text": "嗯。寒冷的季節，"}, {"type": "subtitle", "time": 4420.87, "timestamp": "01:13:40", "text": "我會改喝"}, {"type": "subtitle", "time": 4424.07, "timestamp": "01:13:44", "text": "熱水，也會喝"}, {"type": "subtitle", "time": 4437.11, "timestamp": "01:13:57", "text": "我喜歡為自己做冰咖啡。你應該"}, {"type": "subtitle", "time": 4439.35, "timestamp": "01:13:59", "text": "這麼做。如果"}]
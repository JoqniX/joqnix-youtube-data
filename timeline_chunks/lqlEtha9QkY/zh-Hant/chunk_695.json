[{"type": "subtitle", "time": 41700.71, "timestamp": "11:35:00", "text": "有一堆日誌。我正在"}, {"type": "subtitle", "time": 41702.39, "timestamp": "11:35:02", "text": "尋找鹿。所以，"}, {"type": "subtitle", "time": 41705.67, "timestamp": "11:35:05", "text": "我想知道，當我們製作木筏時，我們是否可以添加木頭，"}, {"type": "subtitle", "time": 41709.266, "timestamp": "11:35:09", "text": "就像添加木頭支架一樣，對嗎？嗯。  差不多。"}, {"type": "subtitle", "time": 41715.83, "timestamp": "11:35:15", "text": "我會開始做木筏之類的事情。這樣一來，我們運送貨物就更容易了。  那裡的樹木更多。"}, {"type": "subtitle", "time": 41718.31, "timestamp": "11:35:18", "text": "我的天啊。  這很有趣。我們就像有一艘船。碼頭。"}, {"type": "subtitle", "time": 41721.51, "timestamp": "11:35:21", "text": "我的天哪，我們有船屋了"}, {"type": "subtitle", "time": 41744.55, "timestamp": "11:35:44", "text": "。你能進來一下嗎？我可以嗎？你在哪裡？等等，讓我先把這個"}, {"type": "subtitle", "time": 41747.67, "timestamp": "11:35:47", "text": "丟掉。你們自己做了那個木柴架嗎？  手臂。"}, {"type": "subtitle", "time": 41750.95, "timestamp": "11:35:50", "text": "我在新店門口把它做好了，哦，我可以把它穿在身上"}, {"type": "subtitle", "time": 41753.906, "timestamp": "11:35:53", "text": "。哦好的"}, {"type": "subtitle", "time": 41757.426, "timestamp": "11:35:57", "text": "。我會斷開連線再重新連線"}]
[{"type": "subtitle", "time": 34275.906, "timestamp": "09:31:15", "text": "東西要給你，你可以剁碎。"}, {"type": "subtitle", "time": 34283.79, "timestamp": "09:31:23", "text": "我殺了一條內陸鱷魚，遞給你一個插著吸管的大椰子，走吧。我不知道該怎麼"}, {"type": "subtitle", "time": 34290.47, "timestamp": "09:31:30", "text": "處理它，我想我應該喝椰子水，夥計。顯然，"}, {"type": "subtitle", "time": 34294.55, "timestamp": "09:31:34", "text": "我剛剛殺了一條內陸鱷魚。拿著卡片。為什麼"}, {"type": "subtitle", "time": 34297.23, "timestamp": "09:31:37", "text": "？鱷魚？嗯，你看，在原版歌曲裡，當他們唱到“內飾是鱷魚皮，我開著雪佛蘭電影院”的時候，"}, {"type": "subtitle", "time": 34299.03, "timestamp": "09:31:39", "text": "他們實際上是指他們的車內裝是用鱷魚皮做的。"}, {"type": "subtitle", "time": 34312.15, "timestamp": "09:31:52", "text": "哦，他是在諷刺嗎？這難道也是對人性的批判嗎？因為人們……不，閉嘴，塞拉斯提亞"}]
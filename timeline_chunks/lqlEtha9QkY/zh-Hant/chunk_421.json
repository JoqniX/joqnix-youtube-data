[{"type": "subtitle", "time": 25270.23, "timestamp": "07:01:10", "text": "哦，我們是對的。我會保留那個、這個還有那個。這兩個人。這兩個[音樂]。"}, {"type": "subtitle", "time": 25273.99, "timestamp": "07:01:13", "text": "可以接受這個。  是啊，不過……實話實說。  是啊，小子。我總有一天要試試四輪換擋那玩意兒。  這些"}, {"type": "subtitle", "time": 25282.31, "timestamp": "07:01:22", "text": "我可以賣掉。 9999。"}, {"type": "subtitle", "time": 25286.03, "timestamp": "07:01:26", "text": "哇。好的。"}, {"type": "subtitle", "time": 25293.788, "timestamp": "07:01:33", "text": "回去把它放在這裡。"}, {"type": "subtitle", "time": 25296.548, "timestamp": "07:01:36", "text": "我得把這裡的東西賣掉。  所以"}, {"type": "subtitle", "time": 25307.35, "timestamp": "07:01:47", "text": "，我會把這傢伙賣掉，讓他收留你。  所以我要"}, {"type": "subtitle", "time": 25312.51, "timestamp": "07:01:52", "text": "問的是，我該放什麼（音樂）？其中很多都是好東西"}]
[{"type": "subtitle", "time": 18304.55, "timestamp": "05:05:04", "text": "我的天哪。  我的天哪。  我忘了"}, {"type": "subtitle", "time": 18341.91, "timestamp": "05:05:41", "text": "我們不會游泳。好的，再見。哦，等等。 348. 哦，等等。我的庫存已滿。哦，"}, {"type": "subtitle", "time": 18350.31, "timestamp": "05:05:50", "text": "我需要處理掉一些低級物品，這些物品賣不出好價錢。"}]
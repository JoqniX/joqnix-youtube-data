[{"type": "subtitle", "time": 36081.67, "timestamp": "10:01:21", "text": "我需要更多骨頭。能給我點骨頭嗎？骨頭在哪裡？  篝火上有骨頭。"}, {"type": "subtitle", "time": 36088.95, "timestamp": "10:01:28", "text": "你們需要幫忙嗎？需要幫助嗎？是的，我確實需要幫助。健康程度非常低。  我當時有"}, {"type": "subtitle", "time": 36095.746, "timestamp": "10:01:35", "text": "盔甲。我快要"}, {"type": "subtitle", "time": 36098.39, "timestamp": "10:01:38", "text": "崩潰了。什麼？  戳戳。  順便問一下，你螢幕上看到的我穿的是什麼？"}, {"type": "subtitle", "time": 36115.35, "timestamp": "10:01:55", "text": "有人尋求幫助。是誰？  我。我。"}]
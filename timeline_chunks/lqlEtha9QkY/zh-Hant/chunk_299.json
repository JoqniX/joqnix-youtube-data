[{"type": "subtitle", "time": 17942.868, "timestamp": "04:59:02", "text": "。我把你當成「哦，操」。"}, {"type": "subtitle", "time": 17946.23, "timestamp": "04:59:06", "text": "昨天馬拉萬的幾個縱火犯和十三個強盜都受到了冰凍的祝福。打架和烘焙完全"}, {"type": "subtitle", "time": 17956.31, "timestamp": "04:59:16", "text": "不一樣，這是肯定的。"}, {"type": "subtitle", "time": 17960.788, "timestamp": "04:59:20", "text": "但這是選擇。"}, {"type": "subtitle", "time": 17964.23, "timestamp": "04:59:24", "text": "勞拉伊帶我們去蒐集物資，但我們在路上被"}]
[{"type": "subtitle", "time": 28939.43, "timestamp": "08:02:19", "text": "你知道的。嘿，笨蛋羅伯特·巴卡，你難道沒有課嗎？為什麼起得這麼早？還有，"}, {"type": "subtitle", "time": 28946.35, "timestamp": "08:02:26", "text": "我希望她一切都好。老兄，"}, {"type": "subtitle", "time": 28960.548, "timestamp": "08:02:40", "text": "我也好久沒傳簡訊給"}, {"type": "subtitle", "time": 28964.19, "timestamp": "08:02:44", "text": "伊莎了。  [音樂] [音樂] [音樂] 天哪，我打噴嚏了。哦，不"}]
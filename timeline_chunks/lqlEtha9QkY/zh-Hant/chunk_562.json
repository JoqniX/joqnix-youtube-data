[{"type": "subtitle", "time": 33721.586, "timestamp": "09:22:01", "text": "什麼？我活下來了。我活下來了。我活下來了。我是不是把錯的人"}, {"type": "subtitle", "time": 33731.906, "timestamp": "09:22:11", "text": "釘在十字架上了？是的。就是這傢伙。我要揍他，老兄。來吧。我的天哪。就這樣吧，各位。下次見。所以，你"}, {"type": "subtitle", "time": 33745.586, "timestamp": "09:22:25", "text": "知道嗎？我覺得我們應該要錄下來，然後……嗯。嗯。嗯。好的。"}, {"type": "subtitle", "time": 33748.23, "timestamp": "09:22:28", "text": "我的天哪"}, {"type": "subtitle", "time": 33751.11, "timestamp": "09:22:31", "text": "。你在吃什麼？他現在從另一棟房子裡逃出來了。拜拜，夥計們。他他媽的"}, {"type": "subtitle", "time": 33761.19, "timestamp": "09:22:41", "text": "像《不可能的任務》裡逃出來了，兄弟。好的，早安。我們要去追捕他。哇哦。"}, {"type": "subtitle", "time": 33765.03, "timestamp": "09:22:45", "text": "你說什麼？追捕他？我到底做了什麼？我們要追捕他。我的意思是，我做了很多事……他是個"}, {"type": "subtitle", "time": 33769.906, "timestamp": "09:22:49", "text": "巫師。巫師。是的。把他綁在"}]
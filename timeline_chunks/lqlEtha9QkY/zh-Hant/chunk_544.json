[{"type": "chat", "time": 32642.821, "timestamp": "09:04:02", "author": "@DinyoFoxy", "avatar": "https://yt4.ggpht.com/DGXvUKi0q0ld5Zo5CNG2tmulZfZqg_h6ivQHLtQfKyx-z_EjHr-Bx7limqyg4JtpZ00_XP_BTQ=s64-c-k-c0x00ffffff-no-rj", "message": "good morning"}, {"type": "subtitle", "time": 32643.51, "timestamp": "09:04:03", "text": "。哦，不。你為何會死？呃，當你醒來的時候。是啊，"}, {"type": "subtitle", "time": 32645.35, "timestamp": "09:04:05", "text": "兄弟，你剛醒來的時候根本不會覺得"}, {"type": "subtitle", "time": 32648.468, "timestamp": "09:04:08", "text": "餓。這條鱷魚竟然把我們的"}, {"type": "subtitle", "time": 32653.43, "timestamp": "09:04:13", "text": "食物都弄壞了。  [音樂] 現在是鱷魚。"}, {"type": "subtitle", "time": 32665.99, "timestamp": "09:04:25", "text": "致命食物。  我在剝皮嗎？我正在剝他的皮"}, {"type": "subtitle", "time": 32679.788, "timestamp": "09:04:39", "text": "。它還活著。我的天哪，老兄。我真的從這些岩石上摔下去了。好的。別"}, {"type": "subtitle", "time": 32682.628, "timestamp": "09:04:42", "text": "，別把他們弄傷。  我忘了。好的。等等，等等，等等。在此之前，讓我先調整一下靈敏度，因為這玩意兒太瘋狂了。是的，哨兵"}, {"type": "subtitle", "time": 32692.788, "timestamp": "09:04:52", "text": "系統簡直糟糕透了。  真好。嘿，伙計們。伙計們，伙計們。所以，沒有頭。"}]
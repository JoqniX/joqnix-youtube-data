[{"type": "subtitle", "time": 34321.83, "timestamp": "09:32:01", "text": "。你沒那麼"}, {"type": "subtitle", "time": 34324.95, "timestamp": "09:32:04", "text": "深奧"}, {"type": "subtitle", "time": 34327.19, "timestamp": "09:32:07", "text": "。你知道嗎，"}, {"type": "subtitle", "time": 34335.19, "timestamp": "09:32:15", "text": "首歌進行字面上的分析。來吧。好的。我先來，夥計們。塞拉斯蒂婭，你先來。好的。好的。你先來，夥計。"}, {"type": "subtitle", "time": 34348.23, "timestamp": "09:32:28", "text": "。好的"}, {"type": "subtitle", "time": 34369.83, "timestamp": "09:32:49", "text": "他開著……的原因。一家雪佛蘭電影院。你明白嗎？啊，這東西有點像……這部電影是不是暗示著人類的夢境和記憶，就像他在回憶往事？我不"}, {"type": "subtitle", "time": 34378.95, "timestamp": "09:32:58", "text": "知道，但我想，大概一百年後，人們還是會討論這個話題"}]
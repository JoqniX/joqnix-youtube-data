[{"type": "subtitle", "time": 2963.99, "timestamp": "00:49:23", "text": "視訊聊天。  這就是我想做的事。但這很難。  想法。兩者兼而有之。構思真的很難。"}, {"type": "subtitle", "time": 2975.309, "timestamp": "00:49:35", "text": "我什至不會否認"}, {"type": "subtitle", "time": 2977.829, "timestamp": "00:49:37", "text": "這一點。  是的。而且我覺得持續成長很難，"}, {"type": "subtitle", "time": 2986.39, "timestamp": "00:49:46", "text": "最終訂閱人數並不重要。這取決於你如何娛樂大眾並做到最好。是的。是的。  東西是你的，"}, {"type": "subtitle", "time": 2990.71, "timestamp": "00:49:50", "text": "你自己滿意就好，在我看來"}, {"type": "subtitle", "time": 2992.47, "timestamp": "00:49:52", "text": "這才是最重要的。"}, {"type": "subtitle", "time": 2995.67, "timestamp": "00:49:55", "text": "我真的覺得我應該要做得更好。你呢？我也是。我不喜歡你現在這種玩樂的方式"}]
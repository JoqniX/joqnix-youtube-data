[{"type": "subtitle", "time": 39420.79, "timestamp": "10:57:00", "text": "完成挖掘只差兩層皮了。"}, {"type": "subtitle", "time": 39424.71, "timestamp": "10:57:04", "text": "我很興奮。是的。好了，我們得"}, {"type": "subtitle", "time": 39428.31, "timestamp": "10:57:08", "text": "再買些木棍來做新的盔甲架。  是的"}, {"type": "subtitle", "time": 39430.79, "timestamp": "10:57:10", "text": "，"}, {"type": "subtitle", "time": 39433.266, "timestamp": "10:57:13", "text": "多造些盔甲架。是的，第"}, {"type": "subtitle", "time": 39438.19, "timestamp": "10:57:18", "text": "一個已經滿了。所以我又做了一個。"}, {"type": "subtitle", "time": 39442.39, "timestamp": "10:57:22", "text": "該死，我們竟然像"}, {"type": "subtitle", "time": 39445.19, "timestamp": "10:57:25", "text": "推特上的藝術家一樣進行剝削。等等，順便說一句，有個傢伙"}, {"type": "subtitle", "time": 39453.83, "timestamp": "10:57:33", "text": "在新花園裡倒掛著種植藍莓灌木"}, {"type": "subtitle", "time": 39456.55, "timestamp": "10:57:36", "text": "。哦，對了，"}, {"type": "subtitle", "time": 39459.266, "timestamp": "10:57:39", "text": "只有樹木確實在重新生長。"}, {"type": "subtitle", "time": 39461.19, "timestamp": "10:57:41", "text": "我想我是無意中這麼做的。這些"}, {"type": "subtitle", "time": 39463.51, "timestamp": "10:57:43", "text": "樹是什麼？它們肯定在"}, {"type": "subtitle", "time": 39473.906, "timestamp": "10:57:53", "text": "重新生長。是的，是那些小樹枝在生長。那些是樹。是的。  是的。  是時候像砍伐森林一樣收集證據了。  搞什麼鬼？"}, {"type": "subtitle", "time": 39476.63, "timestamp": "10:57:56", "text": "等等，等等，等等。你還"}, {"type": "subtitle", "time": 39478.47, "timestamp": "10:57:58", "text": "好嗎？  稍等片刻。是的。不用擔心。"}]
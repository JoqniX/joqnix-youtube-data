[{"type": "subtitle", "time": 12540.469, "timestamp": "03:29:00", "text": "出现。你正在参加赢取大奖的比赛"}, {"type": "subtitle", "time": 12543.11, "timestamp": "03:29:03", "text": "奖？ E."}, {"type": "subtitle", "time": 12545.51, "timestamp": "03:29:05", "text": "你明白的。我带来了一位冠军"}, {"type": "subtitle", "time": 12548.229, "timestamp": "03:29:08", "text": "以我的名义战斗。此外，我还想"}, {"type": "subtitle", "time": 12551.269, "timestamp": "03:29:11", "text": "把它画出来。让我的电路充电"}, {"type": "subtitle", "time": 12553.91, "timestamp": "03:29:13", "text": "连接前稍等片刻。"}, {"type": "subtitle", "time": 12556.63, "timestamp": "03:29:16", "text": "哦，我的电线麻麻的。我不是"}, {"type": "subtitle", "time": 12558.79, "timestamp": "03:29:18", "text": "应该有所偏袒，但我感觉"}, {"type": "subtitle", "time": 12562.87, "timestamp": "03:29:22", "text": "空气中含有电流。我们爱你。"}, {"type": "subtitle", "time": 12567.59, "timestamp": "03:29:27", "text": "选我。欢迎来到怪物世界。"}, {"type": "subtitle", "time": 12569.99, "timestamp": "03:29:29", "text": "规则很简单。每位参赛者"}, {"type": "subtitle", "time": 12572.55, "timestamp": "03:29:32", "text": "拥有令牌。谁获得四个代币"}, {"type": "subtitle", "time": 12575.469, "timestamp": "03:29:35", "text": "首先赢得一份你的"}, {"type": "subtitle", "time": 12579.99, "timestamp": "03:29:39", "text": "确实如此。我指的是性方面的事。两轮"}, {"type": "subtitle", "time": 12582.229, "timestamp": "03:29:42", "text": "如果果汁。"}, {"type": "subtitle", "time": 12586.79, "timestamp": "03:29:46", "text": "好了，孩子们。游戏开始。做"}, {"type": "subtitle", "time": 12590.469, "timestamp": "03:29:50", "text": "我需要准备我的传感器吗？"}, {"type": "subtitle", "time": 12592.389, "timestamp": "03:29:52", "text": "当你做你最擅长的事时，我会"}, {"type": "subtitle", "time": 12595.349, "timestamp": "03:29:55", "text": "想办法彻底戒掉。看"}, {"type": "subtitle", "time": 12599.19, "timestamp": "03:29:59", "text": "待会儿在酒吧见到你。嗯？"}]
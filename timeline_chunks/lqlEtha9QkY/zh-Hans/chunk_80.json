[{"type": "subtitle", "time": 4807.99, "timestamp": "01:20:07", "text": "我想是因为我把你的"}, {"type": "subtitle", "time": 4808.65, "timestamp": "01:20:08", "text": "董事会"}, {"type": "subtitle", "time": 4810.51, "timestamp": "01:20:10", "text": "[音乐]"}, {"type": "subtitle", "time": 4815.07, "timestamp": "01:20:15", "text": "渲染和那该死的软件。为什么？"}, {"type": "subtitle", "time": 4829.11, "timestamp": "01:20:29", "text": "啊，至少我的声音能被听到。我对此很满意"}, {"type": "subtitle", "time": 4841.43, "timestamp": "01:20:41", "text": "嗯，是的，整台电脑都卡顿了。不是"}, {"type": "subtitle", "time": 4844.229, "timestamp": "01:20:44", "text": "甚至整个显示器都卡顿了。"}, {"type": "subtitle", "time": 4854.39, "timestamp": "01:20:54", "text": "英寸。塔什经理。不，是Windows时间。"}]
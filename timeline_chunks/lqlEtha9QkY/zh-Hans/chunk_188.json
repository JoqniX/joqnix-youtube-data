[{"type": "subtitle", "time": 11280.55, "timestamp": "03:08:00", "text": "这本身几乎就是一种战争罪行。我"}, {"type": "subtitle", "time": 11283.11, "timestamp": "03:08:03", "text": "就想要那个指挥官的马克杯。哦，我的天"}, {"type": "subtitle", "time": 11285.11, "timestamp": "03:08:05", "text": "上帝。我们要去偷别人的"}, {"type": "subtitle", "time": 11288.07, "timestamp": "03:08:08", "text": "用杯子去买咖啡。我的天啊。什么是"}, {"type": "subtitle", "time": 11293.429, "timestamp": "03:08:13", "text": "抽调一些普通士兵"}, {"type": "subtitle", "time": 11295.51, "timestamp": "03:08:15", "text": "把指挥官引出来。那个杯子是"}, {"type": "subtitle", "time": 11298.79, "timestamp": "03:08:18", "text": "矿。那个杯子是我的。这不是你的。"}, {"type": "subtitle", "time": 11301.03, "timestamp": "03:08:21", "text": "尽管。看来咖啡休息时间到了。"}, {"type": "subtitle", "time": 11327.99, "timestamp": "03:08:47", "text": "去你的，瓦尔特。我只是想"}, {"type": "subtitle", "time": 11329.91, "timestamp": "03:08:49", "text": "得到我的"}, {"type": "subtitle", "time": 11332.55, "timestamp": "03:08:52", "text": "是的。你好。欢迎。哦，谢谢。"}, {"type": "subtitle", "time": 11339.309, "timestamp": "03:08:59", "text": "哦，是的。哦，我们拿到了一件紫色武器。"}]
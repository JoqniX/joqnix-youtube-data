[{"type": "subtitle", "time": 13681.75, "timestamp": "03:48:01", "text": "领导者。杀了他。"}, {"type": "subtitle", "time": 13691.229, "timestamp": "03:48:11", "text": "Moxy的船员们肯定很想要那些"}, {"type": "subtitle", "time": 13695.03, "timestamp": "03:48:15", "text": "代币。简单，volads。有很多"}, {"type": "subtitle", "time": 13698.389, "timestamp": "03:48:18", "text": "电流可以流通。"}, {"type": "subtitle", "time": 13718.63, "timestamp": "03:48:38", "text": "死的。不在乎。拿罐啤酒来吧"}, {"type": "subtitle", "time": 13722.469, "timestamp": "03:48:42", "text": "回到这里。在建筑物上喷涂涂鸦。"}, {"type": "subtitle", "time": 13724.71, "timestamp": "03:48:44", "text": "赶快。我的肺里充满了甲烷。"}, {"type": "subtitle", "time": 13728.469, "timestamp": "03:48:48", "text": "还有老老鼠巫婆。多出来的胡须。等待，"}, {"type": "subtitle", "time": 13730.389, "timestamp": "03:48:50", "text": "这是通往地下的路吗？"}, {"type": "subtitle", "time": 13733.03, "timestamp": "03:48:53", "text": "地方？这是通往地下的道路。"}, {"type": "subtitle", "time": 13735.59, "timestamp": "03:48:55", "text": "地方。等等，如果真是那样的话，我有点……"}, {"type": "subtitle", "time": 13738.309, "timestamp": "03:48:58", "text": "想去。是的，就在附近。这是"}]
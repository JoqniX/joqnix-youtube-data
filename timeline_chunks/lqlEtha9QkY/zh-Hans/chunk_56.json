[{"type": "subtitle", "time": 3362.15, "timestamp": "00:56:02", "text": "当然可以。以及否定句。是的。是的。"}, {"type": "subtitle", "time": 3364.39, "timestamp": "00:56:04", "text": "是的。我没有在其他国家生活过。"}, {"type": "subtitle", "time": 3367.829, "timestamp": "00:56:07", "text": "但我就是记得。好的。我的美国之旅"}, {"type": "subtitle", "time": 3371.51, "timestamp": "00:56:11", "text": "很有趣。好的。"}, {"type": "subtitle", "time": 3374.39, "timestamp": "00:56:14", "text": "我不会否认这一点。等等，你直播了吗？"}, {"type": "subtitle", "time": 3378.47, "timestamp": "00:56:18", "text": "来自美国？不，原本会是……"}, {"type": "subtitle", "time": 3381.15, "timestamp": "00:56:21", "text": "头痛。首先，"}, {"type": "subtitle", "time": 3384.23, "timestamp": "00:56:24", "text": "美国，我当时所在的地方，很多"}, {"type": "subtitle", "time": 3387.43, "timestamp": "00:56:27", "text": "有些地方网络不太好。我"}, {"type": "subtitle", "time": 3389.75, "timestamp": "00:56:29", "text": "当时住在婴儿潮一代的房子里。顶部"}, {"type": "subtitle", "time": 3400.47, "timestamp": "00:56:40", "text": "是的，我不是那个意思，我是说我哥哥。"}, {"type": "subtitle", "time": 3404.549, "timestamp": "00:56:44", "text": "就像修好我的旧台式电脑一样，不是旧笔记本电脑。"}, {"type": "subtitle", "time": 3409.109, "timestamp": "00:56:49", "text": "所以，如果我想的话，现在或许可以直播了。"}, {"type": "subtitle", "time": 3411.43, "timestamp": "00:56:51", "text": "呃，如果"}, {"type": "subtitle", "time": 3414.23, "timestamp": "00:56:54", "text": "如果我正在度假，等等，什么？"}, {"type": "subtitle", "time": 3417.309, "timestamp": "00:56:57", "text": "旧笔记本电脑怎么了？我忘了。"}]
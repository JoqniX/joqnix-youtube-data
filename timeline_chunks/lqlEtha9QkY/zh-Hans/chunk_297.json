[{"type": "subtitle", "time": 17821.67, "timestamp": "04:57:01", "text": "真可惜。消化器里没肉了。"}, {"type": "subtitle", "time": 17823.51, "timestamp": "04:57:03", "text": "样品。"}, {"type": "subtitle", "time": 17826.15, "timestamp": "04:57:06", "text": "王朝汉堡不含肉样。"}, {"type": "subtitle", "time": 17828.15, "timestamp": "04:57:08", "text": "好的。我需要你给我带一份样品"}, {"type": "subtitle", "time": 17835.19, "timestamp": "04:57:15", "text": "什么？相信我兄弟。我知道这听起来"}, {"type": "subtitle", "time": 17837.948, "timestamp": "04:57:17", "text": "虽然恶心，但这让汉堡变得如此美味。"}, {"type": "subtitle", "time": 17842.44, "timestamp": "04:57:22", "text": "多汁。这里有垃圾。去把他抓住。"}, {"type": "subtitle", "time": 17843.67, "timestamp": "04:57:23", "text": "[音乐]"}, {"type": "subtitle", "time": 17848.23, "timestamp": "04:57:28", "text": "拉奇熔岩。嘿，兄弟。好吧，就那样吧。"}, {"type": "subtitle", "time": 17851.19, "timestamp": "04:57:31", "text": "音质很好。那是"}, {"type": "subtitle", "time": 17853.51, "timestamp": "04:57:33", "text": "又一次紧随其后。这"}, {"type": "subtitle", "time": 17856.31, "timestamp": "04:57:36", "text": "体型庞大的狗似乎正在集结起来"}, {"type": "subtitle", "time": 17859.35, "timestamp": "04:57:39", "text": "在普罗米亚击败我们的军队。保持敏锐"}, {"type": "subtitle", "time": 17861.27, "timestamp": "04:57:41", "text": "外面的兄弟姐妹们，"}, {"type": "subtitle", "time": 17864.708, "timestamp": "04:57:44", "text": "让你的斧头更锋利。哦，"}, {"type": "subtitle", "time": 17868.31, "timestamp": "04:57:48", "text": "你不能，我不能替他。哦，不错。"}, {"type": "subtitle", "time": 17870.788, "timestamp": "04:57:50", "text": "太酷了！我为什么要关心这个？"}, {"type": "subtitle", "time": 17872.948, "timestamp": "04:57:52", "text": "等等，我觉得他不是想要我的下半身。"}, {"type": "subtitle", "time": 17875.91, "timestamp": "04:57:55", "text": "水平枪械。"}, {"type": "subtitle", "time": 17879.07, "timestamp": "04:57:59", "text": "荣耀归于双生神。哦，我"}]
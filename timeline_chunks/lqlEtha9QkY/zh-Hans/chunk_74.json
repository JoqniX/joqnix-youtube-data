[{"type": "subtitle", "time": 4441.43, "timestamp": "01:14:01", "text": "你指的是这个吗？嗯？"}, {"type": "subtitle", "time": 4444.95, "timestamp": "01:14:04", "text": "呃，稍等一下。嗯，你的麦克风怎么了？"}, {"type": "subtitle", "time": 4448.47, "timestamp": "01:14:08", "text": "今天剪了这么多东西？我的麦克风是"}, {"type": "subtitle", "time": 4453.35, "timestamp": "01:14:13", "text": "切菜。如何？很多。"}, {"type": "subtitle", "time": 4455.59, "timestamp": "01:14:15", "text": "啊，是Discord的问题。这件事发生在"}, {"type": "subtitle", "time": 4460.55, "timestamp": "01:14:20", "text": "Ve也是。我以前在风险投资行业，感觉就像……"}, {"type": "subtitle", "time": 4462.79, "timestamp": "01:14:22", "text": "我正说着话，突然就断线了。"}, {"type": "subtitle", "time": 4465.669, "timestamp": "01:14:25", "text": "正确的？"}, {"type": "subtitle", "time": 4468.95, "timestamp": "01:14:28", "text": "不，我听不见你说话了。呃，是的"}, {"type": "subtitle", "time": 4473.229, "timestamp": "01:14:33", "text": "每次我说话它都会断线？"}, {"type": "subtitle", "time": 4479.27, "timestamp": "01:14:39", "text": "嗯？等等，我现在就换衣服。"}, {"type": "subtitle", "time": 4482.35, "timestamp": "01:14:42", "text": "好的，切菜的时候告诉我一声。"}, {"type": "subtitle", "time": 4486.87, "timestamp": "01:14:46", "text": "我说话的时候它会关机。这种情况偶尔会发生。"}, {"type": "subtitle", "time": 4488.91, "timestamp": "01:14:48", "text": "这件事发生在昨天。"}, {"type": "subtitle", "time": 4491.91, "timestamp": "01:14:51", "text": "我们和他交谈过。我听不见"}, {"type": "subtitle", "time": 4495.91, "timestamp": "01:14:55", "text": "你不再是了。我听不见你说话了。"}]
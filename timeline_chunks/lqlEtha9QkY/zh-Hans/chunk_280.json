[{"type": "subtitle", "time": 16804.99, "timestamp": "04:40:04", "text": "哦，是在Epic Games。"}, {"type": "subtitle", "time": 16813.83, "timestamp": "04:40:13", "text": "看。嗯，"}, {"type": "subtitle", "time": 16820.23, "timestamp": "04:40:20", "text": "我勒个去？我们找到一条尾巴。一位朋友"}, {"type": "subtitle", "time": 16823.99, "timestamp": "04:40:23", "text": "船上的勺子。主啊，这其实是一个"}, {"type": "subtitle", "time": 16831.35, "timestamp": "04:40:31", "text": "公民，这笔巨款已被非法使用。"}, {"type": "subtitle", "time": 16833.91, "timestamp": "04:40:33", "text": "安装在机动车辆上。请"}, {"type": "subtitle", "time": 16836.948, "timestamp": "04:40:36", "text": "请帮帮我。快点，你们这些混蛋。"}, {"type": "subtitle", "time": 16839.83, "timestamp": "04:40:39", "text": "灾难"}, {"type": "subtitle", "time": 16843.11, "timestamp": "04:40:43", "text": "销毁垃圾。哦，这个人。"}, {"type": "subtitle", "time": 16846.55, "timestamp": "04:40:46", "text": "市民，这辆车已被入侵。"}, {"type": "subtitle", "time": 16849.83, "timestamp": "04:40:49", "text": "你必须对它进行消毒。我会给你消毒。"}, {"type": "subtitle", "time": 16859.51, "timestamp": "04:40:59", "text": "继续前进。"}]
[{"type": "subtitle", "time": 12491.469, "timestamp": "03:28:11", "text": "地方。等等，我在顶部聊天室。"}, {"type": "subtitle", "time": 12493.99, "timestamp": "03:28:13", "text": "等等，我应该在在线聊天室里。我是否"}, {"type": "subtitle", "time": 12496.389, "timestamp": "03:28:16", "text": "漏掉了什么吗？比赛获胜者将获得"}, {"type": "subtitle", "time": 12498.389, "timestamp": "03:28:18", "text": "与他本人同床共枕。"}, {"type": "subtitle", "time": 12500.309, "timestamp": "03:28:20", "text": "现在，有很多理由让一个女人……"}, {"type": "subtitle", "time": 12502.95, "timestamp": "03:28:22", "text": "可能会参加大逃杀游戏。"}, {"type": "subtitle", "time": 12506.15, "timestamp": "03:28:26", "text": "金钱、名誉、一把能融化一个人的枪"}, {"type": "subtitle", "time": 12510.51, "timestamp": "03:28:30", "text": "对峙。但赌基尔特，那可就不是那么回事了。"}, {"type": "subtitle", "time": 12514.309, "timestamp": "03:28:34", "text": "奖。相信我。哦，只是个警告"}, {"type": "subtitle", "time": 12516.63, "timestamp": "03:28:36", "text": "关于Killt。那个人说的每一个字"}, {"type": "subtitle", "time": 12518.309, "timestamp": "03:28:38", "text": "这让我很想扣动扳机，如果"}, {"type": "subtitle", "time": 12520.95, "timestamp": "03:28:40", "text": "你明白我的意思。我们很快就会"}, {"type": "subtitle", "time": 12523.59, "timestamp": "03:28:43", "text": "足够的。"}, {"type": "subtitle", "time": 12531.31, "timestamp": "03:28:51", "text": "我杀了你。"}, {"type": "subtitle", "time": 12537.99, "timestamp": "03:28:57", "text": "追星族。哦，是莫克斯。希望你"}]
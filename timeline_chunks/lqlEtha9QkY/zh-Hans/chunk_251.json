[{"type": "subtitle", "time": 15093.11, "timestamp": "04:11:33", "text": "说。谢谢。"}, {"type": "subtitle", "time": 15095.269, "timestamp": "04:11:35", "text": "莫西的团队要来，我一点也不意外。"}, {"type": "subtitle", "time": 15097.67, "timestamp": "04:11:37", "text": "遥遥领先。那是她最喜欢的"}, {"type": "subtitle", "time": 15100.15, "timestamp": "04:11:40", "text": "位置。"}, {"type": "subtitle", "time": 15102.63, "timestamp": "04:11:42", "text": "不是的，但我告诉他是的。不得不"}, {"type": "subtitle", "time": 15105.11, "timestamp": "04:11:45", "text": "想办法弄到我的那份。他的电路是"}, {"type": "subtitle", "time": 15108.41, "timestamp": "04:11:48", "text": "有点短，你懂我的意思吧。"}]
[{"type": "subtitle", "time": 6001.59, "timestamp": "01:40:01", "text": "谈论你，除了我的"}, {"type": "subtitle", "time": 6003.27, "timestamp": "01:40:03", "text": "表哥。我还没找到……"}, {"type": "subtitle", "time": 6006.35, "timestamp": "01:40:06", "text": "到目前为止，还没有其他值得一提的空白区域。"}, {"type": "subtitle", "time": 6008.91, "timestamp": "01:40:08", "text": "说实话"}, {"type": "subtitle", "time": 6012.79, "timestamp": "01:40:12", "text": "你们，我所有的朋友，还有我爱的那些大象们"}, {"type": "subtitle", "time": 6014.95, "timestamp": "01:40:14", "text": "我之前聊过动漫，他们"}, {"type": "subtitle", "time": 6017.629, "timestamp": "01:40:17", "text": "我们都觉得很奇怪。所以，我当时"}, {"type": "subtitle", "time": 6020.83, "timestamp": "01:40:20", "text": "进入GL"}, {"type": "subtitle", "time": 6025.669, "timestamp": "01:40:25", "text": "东西。但是，但是，呃，还有这个"}, {"type": "subtitle", "time": 6028.79, "timestamp": "01:40:28", "text": "动漫小组呃，伙计们。他们也是"}, {"type": "subtitle", "time": 6031.99, "timestamp": "01:40:31", "text": "比如，“你是不是很厉害？”"}, {"type": "subtitle", "time": 6035.35, "timestamp": "01:40:35", "text": "呃，丹丹之类的。所以我就想，更多"}, {"type": "subtitle", "time": 6038.149, "timestamp": "01:40:38", "text": "我能找到一个可以一起讨论的群体吗？"}, {"type": "subtitle", "time": 6040.95, "timestamp": "01:40:40", "text": "这些东西，我终于找到了一个。他们"}, {"type": "subtitle", "time": 6043.83, "timestamp": "01:40:43", "text": "聊聊BL。所以我还在寻找"}, {"type": "subtitle", "time": 6048.189, "timestamp": "01:40:48", "text": "关于GL相关的内容，但我猜我"}, {"type": "subtitle", "time": 6051.31, "timestamp": "01:40:51", "text": "慢慢地"}, {"type": "subtitle", "time": 6054.55, "timestamp": "01:40:54", "text": "它。但是，是的，我们 Kaiishi 喜欢"}, {"type": "subtitle", "time": 6056.709, "timestamp": "01:40:56", "text": "这样我就可以和别人谈论各种事情了。"}]
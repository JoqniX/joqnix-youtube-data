[{"type": "subtitle", "time": 11760.07, "timestamp": "03:16:00", "text": "所以，我现在就带上这些秘藏猎人。"}, {"type": "subtitle", "time": 11762.63, "timestamp": "03:16:02", "text": "过来领取你应得的奖励吧。"}, {"type": "subtitle", "time": 11764.63, "timestamp": "03:16:04", "text": "你好，"}, {"type": "subtitle", "time": 11774.87, "timestamp": "03:16:14", "text": "好的，"}, {"type": "subtitle", "time": 11776.95, "timestamp": "03:16:16", "text": "我们真的无法用言语表达我们的感激之情。"}, {"type": "subtitle", "time": 11779.349, "timestamp": "03:16:19", "text": "猎人。我知道这看起来微不足道"}, {"type": "subtitle", "time": 11781.99, "timestamp": "03:16:21", "text": "这件事，但即使是这小小的一瞥……"}, {"type": "subtitle", "time": 11784.55, "timestamp": "03:16:24", "text": "我们失去的世界，它支撑着我们继续前行，你"}, {"type": "subtitle", "time": 11787.11, "timestamp": "03:16:27", "text": "知道？至少到明天早上。"}, {"type": "subtitle", "time": 11798.63, "timestamp": "03:16:38", "text": "猎人。"}, {"type": "subtitle", "time": 11799.99, "timestamp": "03:16:39", "text": "真希望我能去参加战斗。"}, {"type": "subtitle", "time": 11801.99, "timestamp": "03:16:41", "text": "坏人。"}, {"type": "subtitle", "time": 11805.11, "timestamp": "03:16:45", "text": "穿着感觉很舒服。是的，确实如此。感觉"}, {"type": "subtitle", "time": 11806.99, "timestamp": "03:16:46", "text": "好的，"}, {"type": "subtitle", "time": 11810.15, "timestamp": "03:16:50", "text": "正确的？这是摇滚踏板的启动。"}, {"type": "subtitle", "time": 11817.349, "timestamp": "03:16:57", "text": "实际上。咱们卖点东西吧。所以，我们"}]
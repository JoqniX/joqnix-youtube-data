[{"type": "subtitle", "time": 5461.39, "timestamp": "01:31:01", "text": "哦，佐佐木茂。是的。"}, {"type": "subtitle", "time": 5464.31, "timestamp": "01:31:04", "text": "是的。它也确实很安全。你呢"}, {"type": "subtitle", "time": 5466.51, "timestamp": "01:31:06", "text": "获取大量知识。"}, {"type": "subtitle", "time": 5470.47, "timestamp": "01:31:10", "text": "是的。 《咲-Saki-》是部新动画，对吧？我"}, {"type": "subtitle", "time": 5474.45, "timestamp": "01:31:14", "text": "[掌声]"}, {"type": "subtitle", "time": 5507.709, "timestamp": "01:31:47", "text": "跑步。"}, {"type": "subtitle", "time": 5511.43, "timestamp": "01:31:51", "text": "再见。看看这群蜂拥而至的军队！"}, {"type": "subtitle", "time": 5514.87, "timestamp": "01:31:54", "text": "小鸡。裸鸡。"}]
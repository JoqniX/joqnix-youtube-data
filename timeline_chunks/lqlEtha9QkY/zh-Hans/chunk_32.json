[{"type": "subtitle", "time": 1922.669, "timestamp": "00:32:02", "text": "就像那些人一样"}, {"type": "subtitle", "time": 1927.909, "timestamp": "00:32:07", "text": "站在最高层"}, {"type": "subtitle", "time": 1932.389, "timestamp": "00:32:12", "text": "嗯，顶级水平，就像巅峰全息投影一样。"}, {"type": "subtitle", "time": 1935.509, "timestamp": "00:32:15", "text": "等级。因为我遇到了一些人"}, {"type": "subtitle", "time": 1937.11, "timestamp": "00:32:17", "text": "站在顶端，我开始……"}, {"type": "subtitle", "time": 1940.509, "timestamp": "00:32:20", "text": "比较一下"}, {"type": "subtitle", "time": 1943.029, "timestamp": "00:32:23", "text": "比较或想要赶上，以及"}, {"type": "subtitle", "time": 1945.19, "timestamp": "00:32:25", "text": "意识到我可能跟不上进度了。我"}, {"type": "subtitle", "time": 1946.19, "timestamp": "00:32:26", "text": "不"}, {"type": "subtitle", "time": 1949.31, "timestamp": "00:32:29", "text": "知道。不知道。啊"}, {"type": "subtitle", "time": 1952.71, "timestamp": "00:32:32", "text": "你好，我可以加入直播吗？哦，当然可以。"}, {"type": "subtitle", "time": 1957.269, "timestamp": "00:32:37", "text": "我们只是在自言自语。等等，怎么会这样"}, {"type": "subtitle", "time": 1958.59, "timestamp": "00:32:38", "text": "做"}, {"type": "subtitle", "time": 1970.11, "timestamp": "00:32:50", "text": "拉紧"}]
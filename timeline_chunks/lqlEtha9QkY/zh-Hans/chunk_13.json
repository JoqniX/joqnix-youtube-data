[{"type": "subtitle", "time": 781.59, "timestamp": "00:13:01", "text": "在这方面写得太多太多了，但是"}, {"type": "subtitle", "time": 783.23, "timestamp": "00:13:03", "text": "我仍然"}, {"type": "subtitle", "time": 786.31, "timestamp": "00:13:06", "text": "我在想，如果我处在你的位置会怎样。如果"}, {"type": "subtitle", "time": 788.11, "timestamp": "00:13:08", "text": "我问过这个问题。"}, {"type": "subtitle", "time": 790.99, "timestamp": "00:13:10", "text": "有人说，是的。就像如果我在你身边一样"}, {"type": "subtitle", "time": 793.99, "timestamp": "00:13:13", "text": "游行队伍中，我当时正在看一个油管博主。"}, {"type": "subtitle", "time": 795.99, "timestamp": "00:13:15", "text": "与虚拟主播建立了良好的关系"}, {"type": "subtitle", "time": 799.03, "timestamp": "00:13:19", "text": "只聊天，从不语音交谈"}, {"type": "subtitle", "time": 802.15, "timestamp": "00:13:22", "text": "任何事物。就呃，就像粘住了一样"}, {"type": "subtitle", "time": 803.91, "timestamp": "00:13:23", "text": "他们就在社区里到处走走什么的，"}, {"type": "subtitle", "time": 806.71, "timestamp": "00:13:26", "text": "支持他们等等。过来观看直播，"}, {"type": "subtitle", "time": 810.91, "timestamp": "00:13:30", "text": "比如等等。所有那些东西都得到了很好的评价。"}, {"type": "subtitle", "time": 814.99, "timestamp": "00:13:34", "text": "嗯，忠诚度什么的等等。"}, {"type": "subtitle", "time": 817.91, "timestamp": "00:13:37", "text": "而且你之前也提到过你是"}, {"type": "subtitle", "time": 821.43, "timestamp": "00:13:41", "text": "有抱负的孩子等等。但是"}, {"type": "subtitle", "time": 823.11, "timestamp": "00:13:43", "text": "你也在尽力避免"}, {"type": "subtitle", "time": 824.949, "timestamp": "00:13:44", "text": "过度自我宣传是因为"}, {"type": "subtitle", "time": 827.509, "timestamp": "00:13:47", "text": "儿童角色在各方面的重要性以及尊重"}, {"type": "subtitle", "time": 830.15, "timestamp": "00:13:50", "text": "主播的边界等等。"}, {"type": "subtitle", "time": 833.629, "timestamp": "00:13:53", "text": "有一天，你就会说"}, {"type": "subtitle", "time": 836.629, "timestamp": "00:13:56", "text": "就像你说的，是的，同样的台词"}, {"type": "subtitle", "time": 839.59, "timestamp": "00:13:59", "text": "他说不，你会喊出来吗？"}]
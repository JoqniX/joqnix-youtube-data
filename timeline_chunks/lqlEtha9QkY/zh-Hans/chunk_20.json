[{"type": "subtitle", "time": 1201.19, "timestamp": "00:20:01", "text": "你对内容创作是认真的，"}, {"type": "subtitle", "time": 1202.789, "timestamp": "00:20:02", "text": "如果你认真对待你的频道，如果"}, {"type": "subtitle", "time": 1204.15, "timestamp": "00:20:04", "text": "你是认真对待 YouTube 的，而且"}, {"type": "subtitle", "time": 1206.909, "timestamp": "00:20:06", "text": "所有事情，你都必须投入很多。"}, {"type": "subtitle", "time": 1209.909, "timestamp": "00:20:09", "text": "工作。双方都需要投入很多精力。"}, {"type": "subtitle", "time": 1213.47, "timestamp": "00:20:13", "text": "要做的工作"}, {"type": "subtitle", "time": 1216.15, "timestamp": "00:20:16", "text": "合作。不，这不仅仅是“是”的问题。"}, {"type": "subtitle", "time": 1218.549, "timestamp": "00:20:18", "text": "制作缩略图等等。呃"}, {"type": "subtitle", "time": 1221.19, "timestamp": "00:20:21", "text": "建立风险投资合作平台必须"}, {"type": "subtitle", "time": 1224.15, "timestamp": "00:20:24", "text": "确保所有合作部分都……"}, {"type": "subtitle", "time": 1227.029, "timestamp": "00:20:27", "text": "合作者们正在交谈，呃，开始"}, {"type": "subtitle", "time": 1229.35, "timestamp": "00:20:29", "text": "振作起来，更加积极主动"}, {"type": "subtitle", "time": 1231.27, "timestamp": "00:20:31", "text": "等等。现在很多事情都和协作主机有关。"}, {"type": "subtitle", "time": 1234.149, "timestamp": "00:20:34", "text": "必须做等等。这不是，它不会结束。"}, {"type": "subtitle", "time": 1237.789, "timestamp": "00:20:37", "text": "那里。合作者也必须制作"}, {"type": "subtitle", "time": 1240.789, "timestamp": "00:20:40", "text": "当然，每个人都玩得很开心，而且"}, {"type": "subtitle", "time": 1242.549, "timestamp": "00:20:42", "text": "确保内容和所有内容都……"}, {"type": "subtitle", "time": 1244.149, "timestamp": "00:20:44", "text": "好的。"}, {"type": "subtitle", "time": 1247.27, "timestamp": "00:20:47", "text": "不仅仅是合作，它就那样发生了。"}, {"type": "subtitle", "time": 1250.39, "timestamp": "00:20:50", "text": "责任人人有责。"}, {"type": "subtitle", "time": 1253.59, "timestamp": "00:20:53", "text": "你知道，我觉得如果你是认真的"}, {"type": "subtitle", "time": 1255.99, "timestamp": "00:20:55", "text": "内容创作和相关的东西，对吧？"}, {"type": "subtitle", "time": 1259.669, "timestamp": "00:20:59", "text": "例如，就拿一家公司来说吧。"}]
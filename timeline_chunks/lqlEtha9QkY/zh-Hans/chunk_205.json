[{"type": "subtitle", "time": 12312.469, "timestamp": "03:25:12", "text": "哦，对，我们说的是教堂。我"}, {"type": "subtitle", "time": 12316.15, "timestamp": "03:25:16", "text": "我睡着了，忘了我错过了。我当时"}, {"type": "subtitle", "time": 12319.63, "timestamp": "03:25:19", "text": "今天本来应该去参加 Holy Mouse 的活动。我"}, {"type": "subtitle", "time": 12324.309, "timestamp": "03:25:24", "text": "忘了。但我忘了，我错过了。"}, {"type": "subtitle", "time": 12326.07, "timestamp": "03:25:26", "text": "但没关系。美好的。就这些了。"}, {"type": "subtitle", "time": 12330.229, "timestamp": "03:25:30", "text": "时间。我，呃，我周五去。它是"}, {"type": "subtitle", "time": 12332.71, "timestamp": "03:25:32", "text": "美好的。"}, {"type": "subtitle", "time": 12342.71, "timestamp": "03:25:42", "text": "与我们最大的敌人作战。楼梯。"}, {"type": "subtitle", "time": 12344.15, "timestamp": "03:25:44", "text": "看起来他是在测试……"}, {"type": "subtitle", "time": 12347.429, "timestamp": "03:25:47", "text": "实验性爬楼梯模块。哦，"}, {"type": "subtitle", "time": 12349.91, "timestamp": "03:25:49", "text": "我明白问题所在了。他没开机。"}, {"type": "subtitle", "time": 12352.469, "timestamp": "03:25:52", "text": "真是个白痴。那个模块可能"}]
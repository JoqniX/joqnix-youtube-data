[{"type": "subtitle", "time": 5700.35, "timestamp": "01:35:00", "text": "我们辞职了"}, {"type": "subtitle", "time": 5702.83, "timestamp": "01:35:02", "text": "然后我们开始"}, {"type": "subtitle", "time": 5706.31, "timestamp": "01:35:06", "text": "再次。我们设定了章节。你看，所以我们"}, {"type": "subtitle", "time": 5707.79, "timestamp": "01:35:07", "text": "全部都拿到了"}, {"type": "subtitle", "time": 5710.189, "timestamp": "01:35:10", "text": "回忆"}, {"type": "subtitle", "time": 5712.03, "timestamp": "01:35:12", "text": "市中心"}, {"type": "subtitle", "time": 5732.31, "timestamp": "01:35:32", "text": "稍微开了点空调。有点儿"}, {"type": "subtitle", "time": 5738.47, "timestamp": "01:35:38", "text": "向上。哦，对了，我说的是最后"}, {"type": "subtitle", "time": 5741.189, "timestamp": "01:35:41", "text": "溪流"}, {"type": "subtitle", "time": 5744.149, "timestamp": "01:35:44", "text": "呃，昨天。我回不去了。所以，"}, {"type": "subtitle", "time": 5745.99, "timestamp": "01:35:45", "text": "显然我把所有事情都做完了。"}, {"type": "subtitle", "time": 5747.95, "timestamp": "01:35:47", "text": "三大巨头"}, {"type": "subtitle", "time": 5755.43, "timestamp": "01:35:55", "text": "是的。等待。呃，我也想进入……"}, {"type": "subtitle", "time": 5757.75, "timestamp": "01:35:57", "text": "因为我表妹说，我看了一些百合系列作品。"}]
[{"type": "subtitle", "time": 19926.868, "timestamp": "05:32:06", "text": "嗯，还有什么？是的，这个我可以。"}, {"type": "subtitle", "time": 19930.23, "timestamp": "05:32:10", "text": "卖。为什么不把它花掉呢？"}, {"type": "subtitle", "time": 19933.868, "timestamp": "05:32:13", "text": "去那里把那件武器拿走。喝"}, {"type": "subtitle", "time": 19937.19, "timestamp": "05:32:17", "text": "它。我们获得了更大的空间。我需要解锁"}, {"type": "subtitle", "time": 19946.15, "timestamp": "05:32:26", "text": "总有一天。我想解锁第四个"}]
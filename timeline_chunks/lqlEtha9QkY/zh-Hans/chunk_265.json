[{"type": "subtitle", "time": 15900.79, "timestamp": "04:25:00", "text": "它。是的，那里还有另一个。"}, {"type": "subtitle", "time": 15903.75, "timestamp": "04:25:03", "text": "是我的直播间里的一位观众。他们的"}, {"type": "subtitle", "time": 15906.389, "timestamp": "04:25:06", "text": "它的名字是乌加布加·瓦坎达。所以，你知道"}, {"type": "subtitle", "time": 15910.269, "timestamp": "04:25:10", "text": "我当时在想什么？我以为是呃"}, {"type": "subtitle", "time": 15913.269, "timestamp": "04:25:13", "text": "你以为是你。呃，你做了"}, {"type": "subtitle", "time": 15920.59, "timestamp": "04:25:20", "text": "某物。哦，等等。为什么？"}, {"type": "subtitle", "time": 15924.229, "timestamp": "04:25:24", "text": "坚持住？"}, {"type": "subtitle", "time": 15925.99, "timestamp": "04:25:25", "text": "是的。我以为你真的做了一个"}, {"type": "subtitle", "time": 15929.429, "timestamp": "04:25:29", "text": "特瓦纳游戏。我当时想，但这却是一个"}, {"type": "subtitle", "time": 15940.07, "timestamp": "04:25:40", "text": "是的，是另一个人。"}, {"type": "subtitle", "time": 15946.149, "timestamp": "04:25:46", "text": "嗯。我当时就想，等等，你们有"}, {"type": "subtitle", "time": 15951.189, "timestamp": "04:25:51", "text": "同名。但是，呃，区别在于……"}, {"type": "subtitle", "time": 15955.429, "timestamp": "04:25:55", "text": "嗯，是的，区别在于……我想"}]
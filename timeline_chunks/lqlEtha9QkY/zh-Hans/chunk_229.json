[{"type": "subtitle", "time": 13741.189, "timestamp": "03:49:01", "text": "附近。我们走吧。我们知道你有一个"}, {"type": "subtitle", "time": 13743.67, "timestamp": "03:49:03", "text": "里面有名人质，我们想切断它的联系。"}, {"type": "subtitle", "time": 13746.389, "timestamp": "03:49:06", "text": "赎金。现在营业。那是他活着的妻子。"}, {"type": "subtitle", "time": 13748.95, "timestamp": "03:49:08", "text": "搞什么鬼？嘿，你，你没拿走"}, {"type": "subtitle", "time": 13752.15, "timestamp": "03:49:12", "text": "我们的分成。"}, {"type": "subtitle", "time": 13754.309, "timestamp": "03:49:14", "text": "谢谢你消灭了那些警察机器人。"}, {"type": "subtitle", "time": 13757.229, "timestamp": "03:49:17", "text": "无论你是谁。您是来这里参加……的"}, {"type": "subtitle", "time": 13762.15, "timestamp": "03:49:22", "text": "交换？过来跟我聊聊。不然呢？"}, {"type": "subtitle", "time": 13769.309, "timestamp": "03:49:29", "text": "守门人，但我会交换"}, {"type": "subtitle", "time": 13773.99, "timestamp": "03:49:33", "text": "她的血液闪耀着光芒。警察抓住她了。我"}, {"type": "subtitle", "time": 13777.83, "timestamp": "03:49:37", "text": "她被关进了某个破监狱。"}, {"type": "subtitle", "time": 13779.64, "timestamp": "03:49:39", "text": "监狱。 好的。去报警。原谅。拧紧"}, {"type": "subtitle", "time": 13782.479, "timestamp": "03:49:42", "text": "好的。去报警。原谅。拧紧 与我一起。你敢惹我，我就杀了你。"}, {"type": "subtitle", "time": 13784.88, "timestamp": "03:49:44", "text": "与我一起。你敢惹我，我就杀了你。 哦，他什么都看在眼里。我的天啊。"}, {"type": "subtitle", "time": 13788.08, "timestamp": "03:49:48", "text": "哦，他什么都看在眼里。我的天啊。 因为我恋爱了，而且疯了。"}, {"type": "subtitle", "time": 13791.76, "timestamp": "03:49:51", "text": "因为我恋爱了，而且疯了。 那秘藏猎人呢？我是士官，"}, {"type": "subtitle", "time": 13795.439, "timestamp": "03:49:55", "text": "那秘藏猎人呢？我是士官， 我是肿瘤头的囚犯，但我不是"}, {"type": "subtitle", "time": 13797.68, "timestamp": "03:49:57", "text": "我是肿瘤头的囚犯，但我不是 阿特拉斯战士就像她想的那样。如果她"}]
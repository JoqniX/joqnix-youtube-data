[{"type": "subtitle", "time": 3242.63, "timestamp": "00:54:02", "text": "现在，我听说你不能做"}, {"type": "subtitle", "time": 3245.99, "timestamp": "00:54:05", "text": "有些人甚至连打个电话都可能成为问题。"}, {"type": "subtitle", "time": 3248.39, "timestamp": "00:54:08", "text": "因为墙很薄。现在"}, {"type": "subtitle", "time": 3251.91, "timestamp": "00:54:11", "text": "你在自己房间里做的任何事情都可以"}, {"type": "subtitle", "time": 3254.549, "timestamp": "00:54:14", "text": "其他房间都能听到。所以我就想，这怎么可能"}, {"type": "subtitle", "time": 3257.829, "timestamp": "00:54:17", "text": "我会直播吗？"}, {"type": "subtitle", "time": 3261.19, "timestamp": "00:54:21", "text": "我不知道。不喜欢日本有"}, {"type": "subtitle", "time": 3264.309, "timestamp": "00:54:24", "text": "比如你可以去的地方"}, {"type": "subtitle", "time": 3265.15, "timestamp": "00:54:25", "text": "一个"}, {"type": "subtitle", "time": 3267.23, "timestamp": "00:54:27", "text": "几个小时"}, {"type": "subtitle", "time": 3271.349, "timestamp": "00:54:31", "text": "并且参与其中。我觉得这有点意思。"}, {"type": "subtitle", "time": 3276.15, "timestamp": "00:54:36", "text": "我需要查一下是否需要看医生。"}, {"type": "subtitle", "time": 3282.069, "timestamp": "00:54:42", "text": "或者你也可以做ASMR直播。"}, {"type": "subtitle", "time": 3283.75, "timestamp": "00:54:43", "text": "不断地。"}, {"type": "subtitle", "time": 3285.91, "timestamp": "00:54:45", "text": "是的。或者你可以像聊天一样"}, {"type": "subtitle", "time": 3289.589, "timestamp": "00:54:49", "text": "和你的圈子里的人交朋友，你就可以"}, {"type": "subtitle", "time": 3292.069, "timestamp": "00:54:52", "text": "就像这样，或者你基本上可以直播"}, {"type": "subtitle", "time": 3294.79, "timestamp": "00:54:54", "text": "那里空无一人。"}, {"type": "subtitle", "time": 3298.069, "timestamp": "00:54:58", "text": "大家都说，出去吧。"}]
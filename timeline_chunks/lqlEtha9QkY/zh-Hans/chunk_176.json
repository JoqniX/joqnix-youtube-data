[{"type": "subtitle", "time": 10566.79, "timestamp": "02:56:06", "text": "pitf 哦，天哪。当然不是。"}, {"type": "subtitle", "time": 10568.71, "timestamp": "02:56:08", "text": "使用那里的按钮拨打第一个电话"}, {"type": "subtitle", "time": 10579.83, "timestamp": "02:56:19", "text": "El Fuego。叫他“火神”吧。银增强"}, {"type": "subtitle", "time": 10582.79, "timestamp": "02:56:22", "text": "凭借大家的点赞。你"}, {"type": "subtitle", "time": 10586.15, "timestamp": "02:56:26", "text": "可以制作表情符号之类的东西。什么？"}, {"type": "subtitle", "time": 10589.91, "timestamp": "02:56:29", "text": "哦，这不应该发生。不，"}, {"type": "subtitle", "time": 10592.95, "timestamp": "02:56:32", "text": "他去世了。肯定是故障了。"}, {"type": "subtitle", "time": 10595.67, "timestamp": "02:56:35", "text": "但没关系。我们还有两台。称呼"}, {"type": "subtitle", "time": 10601.269, "timestamp": "02:56:41", "text": "哦，他们有同样的东西。我会打电话"}, {"type": "subtitle", "time": 10604.469, "timestamp": "02:56:44", "text": "一个笑脸。强大如狂怒"}, {"type": "subtitle", "time": 10613.19, "timestamp": "02:56:53", "text": "我的天哪。哦不，这招行不通。"}, {"type": "subtitle", "time": 10617.83, "timestamp": "02:56:57", "text": "任何一个。不，他们两个都死了。"}]
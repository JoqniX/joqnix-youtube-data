[{"type": "subtitle", "time": 18900.99, "timestamp": "05:15:00", "text": "差不多就是现在。让我，让我，让我"}, {"type": "subtitle", "time": 18904.39, "timestamp": "05:15:04", "text": "呃，14。这是一个进展。好的。我"}, {"type": "subtitle", "time": 18906.27, "timestamp": "05:15:06", "text": "会让你超过"}, {"type": "subtitle", "time": 18923.03, "timestamp": "05:15:23", "text": "哇。多次获得那件武器"}, {"type": "subtitle", "time": 18928.15, "timestamp": "05:15:28", "text": "之后。别死。哇。我的盾牌。这"}, {"type": "subtitle", "time": 18942.31, "timestamp": "05:15:42", "text": "让我……让我……让我……呃……存一个。那"}, {"type": "subtitle", "time": 18943.39, "timestamp": "05:15:43", "text": "东西"}, {"type": "subtitle", "time": 18946.868, "timestamp": "05:15:46", "text": "其实我挺喜欢这些东西的。我该怎么办？"}, {"type": "subtitle", "time": 18949.47, "timestamp": "05:15:49", "text": "你有这个吗？我不"}, {"type": "subtitle", "time": 18951.868, "timestamp": "05:15:51", "text": "知道。这是"}, {"type": "subtitle", "time": 18954.788, "timestamp": "05:15:54", "text": "霰弹枪。我需要狙击手吗？不，我会"}, {"type": "subtitle", "time": 18957.15, "timestamp": "05:15:57", "text": "把它放在这里"}, {"type": "subtitle", "time": 18959.23, "timestamp": "05:15:59", "text": "事物。不需要"}]
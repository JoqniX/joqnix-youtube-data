[{"type": "subtitle", "time": 19081.19, "timestamp": "05:18:01", "text": "大家都知道游戏是给成年人玩的。"}, {"type": "subtitle", "time": 19082.948, "timestamp": "05:18:02", "text": "脑。傻子和智力障碍儿童。"}, {"type": "subtitle", "time": 19085.03, "timestamp": "05:18:05", "text": "她只是说了些什么。这到底是怎么回事"}, {"type": "subtitle", "time": 19088.23, "timestamp": "05:18:08", "text": "它真的上传上去了吗？"}, {"type": "subtitle", "time": 19091.11, "timestamp": "05:18:11", "text": "她就这么做了。"}, {"type": "subtitle", "time": 19099.91, "timestamp": "05:18:19", "text": "嘿，这大概就是你全部的行程了。"}, {"type": "subtitle", "time": 19101.83, "timestamp": "05:18:21", "text": "寻找。请把它们还给我，这样我"}, {"type": "subtitle", "time": 19104.55, "timestamp": "05:18:24", "text": "我可能会继续我的工作。秘藏猎人。"}, {"type": "subtitle", "time": 19107.03, "timestamp": "05:18:27", "text": "说实话，我有时也会想，我为什么要写这些。"}, {"type": "subtitle", "time": 19109.51, "timestamp": "05:18:29", "text": "把这一切都搞清楚了。我想确实如此。"}, {"type": "subtitle", "time": 19111.11, "timestamp": "05:18:31", "text": "给我提供大量……"}, {"type": "subtitle", "time": 19113.11, "timestamp": "05:18:33", "text": "阿里迪安文物和充足的供应"}, {"type": "subtitle", "time": 19116.31, "timestamp": "05:18:36", "text": "测试对象。哦，应该叫他们"}, {"type": "subtitle", "time": 19124.23, "timestamp": "05:18:44", "text": "你好。哦，莫西怎么会在这里？这艘船。我"}, {"type": "subtitle", "time": 19125.75, "timestamp": "05:18:45", "text": "不知道哪件事更令人担忧"}, {"type": "subtitle", "time": 19127.75, "timestamp": "05:18:47", "text": "我一半的水龙头都在流防冻液。"}]
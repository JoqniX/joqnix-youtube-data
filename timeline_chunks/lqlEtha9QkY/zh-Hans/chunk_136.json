[{"type": "subtitle", "time": 8182.069, "timestamp": "02:16:22", "text": "我原以为那样会毁了它，但它"}, {"type": "subtitle", "time": 8199.95, "timestamp": "02:16:39", "text": "[音乐]"}, {"type": "subtitle", "time": 8202.629, "timestamp": "02:16:42", "text": "嗯？所以一定是另一个人。"}, {"type": "subtitle", "time": 8216.03, "timestamp": "02:16:56", "text": "来。没有人想帮助他们。"}]
[{"type": "subtitle", "time": 15132.15, "timestamp": "04:12:12", "text": "你做什么工作？"}, {"type": "subtitle", "time": 15134.07, "timestamp": "04:12:14", "text": "那个混蛋想杀我好多次了。"}, {"type": "subtitle", "time": 15136.389, "timestamp": "04:12:16", "text": "次数。但问题是……如果我当初没有"}, {"type": "subtitle", "time": 15138.55, "timestamp": "04:12:18", "text": "遇到艾伦之后，我永远也不会参军。"}, {"type": "subtitle", "time": 15140.469, "timestamp": "04:12:20", "text": "与 Atlas 一起。如果我没有参军的话"}, {"type": "subtitle", "time": 15142.99, "timestamp": "04:12:22", "text": "有了Atlas，我可能就会"}, {"type": "subtitle", "time": 15146.63, "timestamp": "04:12:26", "text": "简直就是在养殖粪便。"}, {"type": "subtitle", "time": 15148.469, "timestamp": "04:12:28", "text": "你看，想象一下，去年我去了一个"}, {"type": "subtitle", "time": 15149.55, "timestamp": "04:12:29", "text": "地方"}, {"type": "subtitle", "time": 15153.15, "timestamp": "04:12:33", "text": "就像20摄氏度，我的朋友们，又一个"}, {"type": "subtitle", "time": 15157.349, "timestamp": "04:12:37", "text": "市面上有一种打孔卡。哇。该死。嘿，"}, {"type": "subtitle", "time": 15160.389, "timestamp": "04:12:40", "text": "Moxy一行人到底在干什么？"}, {"type": "subtitle", "time": 15163.189, "timestamp": "04:12:43", "text": "让我们回到大逃杀模式。"}, {"type": "subtitle", "time": 15164.67, "timestamp": "04:12:44", "text": "是的。"}, {"type": "subtitle", "time": 15167.63, "timestamp": "04:12:47", "text": "等待。耐心。杀手"}, {"type": "subtitle", "time": 15171.07, "timestamp": "04:12:51", "text": "机器人。杀手沃尔德。"}, {"type": "subtitle", "time": 15175.07, "timestamp": "04:12:55", "text": "我竟然忘了他的名字。好的，我们得到了"}, {"type": "subtitle", "time": 15177.99, "timestamp": "04:12:57", "text": "我们拿到了大部分东西。我们需要"}]
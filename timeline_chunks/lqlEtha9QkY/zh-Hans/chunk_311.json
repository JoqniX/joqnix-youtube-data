[{"type": "subtitle", "time": 18667.03, "timestamp": "05:11:07", "text": "有人有弹药吗？我用完了"}, {"type": "subtitle", "time": 18674.39, "timestamp": "05:11:14", "text": "让我们回到上个世纪。我们走吧。和"}, {"type": "subtitle", "time": 18709.27, "timestamp": "05:11:49", "text": "这东西开着吗？测试，测试。嘿，Vault。"}, {"type": "subtitle", "time": 18711.51, "timestamp": "05:11:51", "text": "我们有个机会适合你。我会保留"}, {"type": "subtitle", "time": 18714.948, "timestamp": "05:11:54", "text": "世界上的一些事情。实际上，"}, {"type": "subtitle", "time": 18718.23, "timestamp": "05:11:58", "text": "我把它保存在保险库里。"}]
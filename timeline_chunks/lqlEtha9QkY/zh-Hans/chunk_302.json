[{"type": "subtitle", "time": 18129.59, "timestamp": "05:02:09", "text": "尸体举起双手奔跑"}, {"type": "subtitle", "time": 18130.43, "timestamp": "05:02:10", "text": "在"}, {"type": "subtitle", "time": 18134.788, "timestamp": "05:02:14", "text": "恐慌？太可爱了。"}, {"type": "subtitle", "time": 18141.628, "timestamp": "05:02:21", "text": "这位B又是谁？"}, {"type": "subtitle", "time": 18146.47, "timestamp": "05:02:26", "text": "射击？哦，等等。这就是交付内容。"}, {"type": "subtitle", "time": 18149.35, "timestamp": "05:02:29", "text": "我可以接受。非常感谢。"}, {"type": "subtitle", "time": 18152.788, "timestamp": "05:02:32", "text": "我马上就下去，小家伙。"}, {"type": "subtitle", "time": 18156.07, "timestamp": "05:02:36", "text": "把那个混蛋弄走。"}, {"type": "subtitle", "time": 18165.99, "timestamp": "05:02:45", "text": "哦，我们需要到达“是的”。是的。"}, {"type": "subtitle", "time": 18168.03, "timestamp": "05:02:48", "text": "等等，等等，等等，等等，等等。我需要"}, {"type": "subtitle", "time": 18170.628, "timestamp": "05:02:50", "text": "起床。我得起床了。我的天哪。哦"}, {"type": "subtitle", "time": 18172.15, "timestamp": "05:02:52", "text": "上帝。我的天哪。我来晚了。我来晚了。我是"}, {"type": "subtitle", "time": 18174.12, "timestamp": "05:02:54", "text": "晚的。"}, {"type": "subtitle", "time": 18177.03, "timestamp": "05:02:57", "text": "[音乐]"}]
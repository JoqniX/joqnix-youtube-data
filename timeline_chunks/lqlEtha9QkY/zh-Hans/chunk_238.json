[{"type": "subtitle", "time": 14282.469, "timestamp": "03:58:02", "text": "看看吧。严重地。头盔？什么东西？"}, {"type": "subtitle", "time": 14286.389, "timestamp": "03:58:06", "text": "等等，什么？我弄到了一把狙击枪。什么是"}, {"type": "subtitle", "time": 14292.429, "timestamp": "03:58:12", "text": "等待。"}, {"type": "subtitle", "time": 14297.91, "timestamp": "03:58:17", "text": "嗯？哦，这是一把手枪。我的天哪。"}, {"type": "subtitle", "time": 14302.59, "timestamp": "03:58:22", "text": "哦，我会开始的。"}, {"type": "subtitle", "time": 14305.75, "timestamp": "03:58:25", "text": "那。打造这种风格。 250。这很不错。"}, {"type": "subtitle", "time": 14310.91, "timestamp": "03:58:30", "text": "霰弹枪。我的天哪。这是最高的。"}, {"type": "subtitle", "time": 14313.99, "timestamp": "03:58:33", "text": "哦。哦，这个也不错。我应该保存"}, {"type": "subtitle", "time": 14321.75, "timestamp": "03:58:41", "text": "钱。哪种选择？哦，等等。"}, {"type": "subtitle", "time": 14323.71, "timestamp": "03:58:43", "text": "什么样的"}, {"type": "subtitle", "time": 14330.189, "timestamp": "03:58:50", "text": "好了，完成了。嗯，我们换了。"}, {"type": "subtitle", "time": 14331.87, "timestamp": "03:58:51", "text": "这"}, {"type": "subtitle", "time": 14335.03, "timestamp": "03:58:55", "text": "就是那种喷涂鸦的玩意儿，对吧？这是"}, {"type": "subtitle", "time": 14336.75, "timestamp": "03:58:56", "text": "另一面"}, {"type": "subtitle", "time": 14339.83, "timestamp": "03:58:59", "text": "探索之旅，一切尽在此处。我们是"}]
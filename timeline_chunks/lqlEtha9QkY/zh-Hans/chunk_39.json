[{"type": "subtitle", "time": 2349.109, "timestamp": "00:39:09", "text": "你知道我在说什么。我 我"}, {"type": "subtitle", "time": 2358.51, "timestamp": "00:39:18", "text": "呃，不过我也想问一下"}, {"type": "subtitle", "time": 2369.75, "timestamp": "00:39:29", "text": "合作，呃，合作就等于制作"}, {"type": "subtitle", "time": 2373.75, "timestamp": "00:39:33", "text": "是朋友还是纯粹的商业伙伴？"}, {"type": "subtitle", "time": 2375.99, "timestamp": "00:39:35", "text": "是的，两者都是。"}, {"type": "subtitle", "time": 2378.31, "timestamp": "00:39:38", "text": "嗯，这对独立游戏开发者来说不是生意。我们"}, {"type": "subtitle", "time": 2381.67, "timestamp": "00:39:41", "text": "独立制片人没钱。我的意思是，在"}, {"type": "subtitle", "time": 2383.51, "timestamp": "00:39:43", "text": "我们大多数时候都感觉不到任何收入"}, {"type": "subtitle", "time": 2391.19, "timestamp": "00:39:51", "text": "我知道你在努力赚钱。"}, {"type": "subtitle", "time": 2393.95, "timestamp": "00:39:53", "text": "你做得很好。"}, {"type": "subtitle", "time": 2397.109, "timestamp": "00:39:57", "text": "好的。这是一个需要达成的远大目标。"}]
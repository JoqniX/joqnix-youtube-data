[{"type": "subtitle", "time": 7202.39, "timestamp": "02:00:02", "text": "将进入比赛。等等，什么？"}, {"type": "subtitle", "time": 7203.83, "timestamp": "02:00:03", "text": "你说你忘了你的"}, {"type": "subtitle", "time": 7210.109, "timestamp": "02:00:10", "text": "角色卡。我们需要帮忙"}, {"type": "subtitle", "time": 7213.629, "timestamp": "02:00:13", "text": "他。角色在哪里？"}, {"type": "subtitle", "time": 7216.91, "timestamp": "02:00:16", "text": "那张纸"}, {"type": "subtitle", "time": 7225.39, "timestamp": "02:00:25", "text": "自鸣得意就是爆炸"}, {"type": "subtitle", "time": 7240.87, "timestamp": "02:00:40", "text": "砰。为什么这是根电线？"}, {"type": "subtitle", "time": 7243.99, "timestamp": "02:00:43", "text": "就像被困在那边一样？"}]
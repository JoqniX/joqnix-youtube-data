[{"type": "subtitle", "time": 14643.429, "timestamp": "04:04:03", "text": "嗯？不知道他去了哪里。我想要那个"}, {"type": "subtitle", "time": 14649.63, "timestamp": "04:04:09", "text": "哦，我得找到乔希。"}, {"type": "subtitle", "time": 14661.15, "timestamp": "04:04:21", "text": "等等，他是吗？"}, {"type": "subtitle", "time": 14675.269, "timestamp": "04:04:35", "text": "看。我希望他是。哦不，他进来了。"}, {"type": "subtitle", "time": 14678.15, "timestamp": "04:04:38", "text": "不同的地方。好的。呃，我们不是"}, {"type": "subtitle", "time": 14679.91, "timestamp": "04:04:39", "text": "就是为此而来的。我们需要完成所有"}, {"type": "subtitle", "time": 14683.63, "timestamp": "04:04:43", "text": "这些东西。我们再回去一次。不"}, {"type": "subtitle", "time": 14687.11, "timestamp": "04:04:47", "text": "更多无用之物。我感觉自己像死了一样"}, {"type": "subtitle", "time": 14689.55, "timestamp": "04:04:49", "text": "跑到一半时的体重"}]
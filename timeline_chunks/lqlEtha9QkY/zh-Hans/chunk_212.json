[{"type": "subtitle", "time": 12721.11, "timestamp": "03:32:01", "text": "莫克西。获胜者，呃，就是最终的赢家。"}, {"type": "subtitle", "time": 12723.75, "timestamp": "03:32:03", "text": "他们必须这样做。是的。你知道的"}, {"type": "subtitle", "time": 12727.11, "timestamp": "03:32:07", "text": "带领。我的天哪。"}, {"type": "subtitle", "time": 12729.269, "timestamp": "03:32:09", "text": "我以为会有什么事发生。"}, {"type": "subtitle", "time": 12732.07, "timestamp": "03:32:12", "text": "CC 在这个地方"}, {"type": "subtitle", "time": 12733.429, "timestamp": "03:32:13", "text": "游戏。"}, {"type": "subtitle", "time": 12736.11, "timestamp": "03:32:16", "text": "我必须小心谨慎。"}, {"type": "subtitle", "time": 12764.07, "timestamp": "03:32:44", "text": "还有一个支线任务。"}, {"type": "subtitle", "time": 12765.429, "timestamp": "03:32:45", "text": "我接受这个支线任务。你可以听到"}, {"type": "subtitle", "time": 12767.429, "timestamp": "03:32:47", "text": "这。我需要你的帮助。我被带走了"}, {"type": "subtitle", "time": 12770.63, "timestamp": "03:32:50", "text": "被囚禁在名为“肿瘤头”的外套下。"}, {"type": "subtitle", "time": 12773.389, "timestamp": "03:32:53", "text": "她想陷害一名囚犯"}, {"type": "subtitle", "time": 12775.429, "timestamp": "03:32:55", "text": "女朋友。她觉得我是阿特拉斯。"}, {"type": "subtitle", "time": 12777.51, "timestamp": "03:32:57", "text": "我不是士兵。如果你帮助我，"}, {"type": "subtitle", "time": 12778.95, "timestamp": "03:32:58", "text": "我会让你觉得物有所值。"}]
[{"type": "subtitle", "time": 3483.91, "timestamp": "00:58:03", "text": "不，我不知道。我应该知道。我"}, {"type": "subtitle", "time": 3486.23, "timestamp": "00:58:06", "text": "我不知道该不该问这个问题。呃，"}, {"type": "subtitle", "time": 3488.63, "timestamp": "00:58:08", "text": "发生了什么？"}, {"type": "subtitle", "time": 3492.71, "timestamp": "00:58:12", "text": "[音乐]"}, {"type": "subtitle", "time": 3495.15, "timestamp": "00:58:15", "text": "你有什么想法？"}, {"type": "subtitle", "time": 3498.549, "timestamp": "00:58:18", "text": "伸手去够东西就像完成一项苦差事吗？如果你如果你"}, {"type": "subtitle", "time": 3501.63, "timestamp": "00:58:21", "text": "把它当成一件苦差事。"}, {"type": "subtitle", "time": 3504.39, "timestamp": "00:58:24", "text": "啊，我不认为这应该是一件苦差事。"}, {"type": "subtitle", "time": 3506.95, "timestamp": "00:58:26", "text": "它应该是一种爱好，而且是……"}, {"type": "subtitle", "time": 3509.67, "timestamp": "00:58:29", "text": "你热衷于。什么是爱好？"}, {"type": "subtitle", "time": 3512.99, "timestamp": "00:58:32", "text": "定义爱好和热情"}, {"type": "subtitle", "time": 3517.91, "timestamp": "00:58:37", "text": "爱好。你是怎么做到的？嗯？如何……"}, {"type": "subtitle", "time": 3521.27, "timestamp": "00:58:41", "text": "你，不，你会怎么做？你会怎么做？"}, {"type": "subtitle", "time": 3522.43, "timestamp": "00:58:42", "text": "做"}, {"type": "subtitle", "time": 3525.109, "timestamp": "00:58:45", "text": "爱好还是热情爱好？你会怎么做？"}, {"type": "subtitle", "time": 3528.51, "timestamp": "00:58:48", "text": "它？是的。"}, {"type": "subtitle", "time": 3531.19, "timestamp": "00:58:51", "text": "爱好。好的，请稍等片刻。让我"}, {"type": "subtitle", "time": 3534.15, "timestamp": "00:58:54", "text": "思考。"}, {"type": "subtitle", "time": 3539.589, "timestamp": "00:58:59", "text": "我把某件事视为我的热情所在。"}]
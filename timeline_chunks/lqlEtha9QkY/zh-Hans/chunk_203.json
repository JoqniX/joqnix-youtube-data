[{"type": "subtitle", "time": 12181.19, "timestamp": "03:23:01", "text": "上帝。不。"}, {"type": "subtitle", "time": 12185.19, "timestamp": "03:23:05", "text": "我希望这件事发生。我想要我的"}, {"type": "subtitle", "time": 12187.469, "timestamp": "03:23:07", "text": "敌人"}, {"type": "subtitle", "time": 12196.87, "timestamp": "03:23:16", "text": "我要死了。"}, {"type": "subtitle", "time": 12204.71, "timestamp": "03:23:24", "text": "是的，这看起来像是赛博朋克风格。"}, {"type": "subtitle", "time": 12207.67, "timestamp": "03:23:27", "text": "某物。有点像，但又不太一样。这"}, {"type": "subtitle", "time": 12209.309, "timestamp": "03:23:29", "text": "这让我想起了网络"}, {"type": "subtitle", "time": 12213.11, "timestamp": "03:23:33", "text": "朋克。没有像“呃”这样的动作"}, {"type": "subtitle", "time": 12216.229, "timestamp": "03:23:36", "text": "像一个高亢的动作，你可以像这样做"}, {"type": "subtitle", "time": 12218.469, "timestamp": "03:23:38", "text": "赛博朋克，对吧？你进行近战。"}, {"type": "subtitle", "time": 12220.59, "timestamp": "03:23:40", "text": "这里没有近战，但你需要……"}, {"type": "subtitle", "time": 12224.71, "timestamp": "03:23:44", "text": "武器广告和双击冲刺。不，"}, {"type": "subtitle", "time": 12226.95, "timestamp": "03:23:46", "text": "双击，就像有个模组一样"}, {"type": "subtitle", "time": 12229.91, "timestamp": "03:23:49", "text": "可以得到减缓时间流逝的东西。你做"}, {"type": "subtitle", "time": 12232.389, "timestamp": "03:23:52", "text": "这样可以获得加速，然后你就可以跳跃了。"}, {"type": "subtitle", "time": 12235.429, "timestamp": "03:23:55", "text": "从这里到那里，再从这里"}, {"type": "subtitle", "time": 12237.91, "timestamp": "03:23:57", "text": "你可以像这样跳过去。我"}]
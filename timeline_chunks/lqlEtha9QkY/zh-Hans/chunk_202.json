[{"type": "subtitle", "time": 12121.91, "timestamp": "03:22:01", "text": "好的，我们照办。我们走吧。而且在"}, {"type": "subtitle", "time": 12124.469, "timestamp": "03:22:04", "text": "个人备注：有个叫马拉万的人，"}, {"type": "subtitle", "time": 12126.469, "timestamp": "03:22:06", "text": "罗船长，他一直没完没了地给我添麻烦。"}, {"type": "subtitle", "time": 12128.469, "timestamp": "03:22:08", "text": "麻烦。我一直无法固定"}, {"type": "subtitle", "time": 12130.229, "timestamp": "03:22:10", "text": "他倒下了，但我听说他情况很严重。"}, {"type": "subtitle", "time": 12132.309, "timestamp": "03:22:12", "text": "是的。你好，诺拉。你好吗？希望"}, {"type": "subtitle", "time": 12133.71, "timestamp": "03:22:13", "text": "你正在做的"}, {"type": "subtitle", "time": 12137.229, "timestamp": "03:22:17", "text": "出色地。你好吗，"}, {"type": "subtitle", "time": 12139.229, "timestamp": "03:22:19", "text": "D？等待，"}, {"type": "subtitle", "time": 12142.95, "timestamp": "03:22:22", "text": "等待。我该如何进去？我可以"}, {"type": "subtitle", "time": 12147.03, "timestamp": "03:22:27", "text": "往这边走。是的。"}, {"type": "subtitle", "time": 12150.71, "timestamp": "03:22:30", "text": "左转，然后继续行驶"}, {"type": "subtitle", "time": 12152.349, "timestamp": "03:22:32", "text": "[音乐]"}, {"type": "subtitle", "time": 12156.07, "timestamp": "03:22:36", "text": "正确的。我可以和……一起上去。"}, {"type": "subtitle", "time": 12163.349, "timestamp": "03:22:43", "text": "相信。不，我不能。"}, {"type": "subtitle", "time": 12178.229, "timestamp": "03:22:58", "text": "我刚才是不是试图自杀？哦，我的天"}]
[{"type": "subtitle", "time": 14106.95, "timestamp": "03:55:06", "text": "比赛的获胜者将获得"}, {"type": "subtitle", "time": 14112.95, "timestamp": "03:55:12", "text": "资格。等等，她应该得到"}, {"type": "subtitle", "time": 14126.63, "timestamp": "03:55:26", "text": "兄弟？我的天，全家都来了。"}, {"type": "subtitle", "time": 14132.95, "timestamp": "03:55:32", "text": "做我喜欢的事。哦。哦，那是"}, {"type": "subtitle", "time": 14137.51, "timestamp": "03:55:37", "text": "昂贵的。好的。吃我一拳。"}, {"type": "subtitle", "time": 14139.55, "timestamp": "03:55:39", "text": "我们会接受"}, {"type": "subtitle", "time": 14142.429, "timestamp": "03:55:42", "text": "那。"}, {"type": "subtitle", "time": 14150.429, "timestamp": "03:55:50", "text": "来吧。快点。给"}, {"type": "subtitle", "time": 14153.79, "timestamp": "03:55:53", "text": "我。好的。感谢"}, {"type": "subtitle", "time": 14157.63, "timestamp": "03:55:57", "text": "你，母亲。那是你妈妈。"}]
[{"type": "subtitle", "time": 7086.55, "timestamp": "01:58:06", "text": "它？我心想，我那玩意儿在哪儿呢？"}, {"type": "subtitle", "time": 7087.23, "timestamp": "01:58:07", "text": "寻找"}, {"type": "subtitle", "time": 7089.87, "timestamp": "01:58:09", "text": "[音乐]"}, {"type": "subtitle", "time": 7093.51, "timestamp": "01:58:13", "text": "为了？好的，我们来看看。呃，回忆。所以，"}, {"type": "subtitle", "time": 7095.83, "timestamp": "01:58:15", "text": "这就是我想要的。这个地方"}, {"type": "subtitle", "time": 7097.83, "timestamp": "01:58:17", "text": "在那边。"}, {"type": "subtitle", "time": 7102.629, "timestamp": "01:58:22", "text": "那里有一个巨大的蓝绿色霓虹灯招牌"}, {"type": "subtitle", "time": 7105.43, "timestamp": "01:58:25", "text": "那里好像还有把吉他之类的东西。"}, {"type": "subtitle", "time": 7108.629, "timestamp": "01:58:28", "text": "那边有张海报。好的。霓虹灯招牌和"}, {"type": "subtitle", "time": 7109.95, "timestamp": "01:58:29", "text": "一个"}, {"type": "subtitle", "time": 7113.47, "timestamp": "01:58:33", "text": "海报。霓虹灯招牌和海报。"}, {"type": "subtitle", "time": 7133.43, "timestamp": "01:58:53", "text": "原本应该是一家霓虹灯闪烁的地方。所以这是"}, {"type": "subtitle", "time": 7134.189, "timestamp": "01:58:54", "text": "不是"}, {"type": "subtitle", "time": 7138.669, "timestamp": "01:58:58", "text": "它。搜索。所以我们需要找个地方"}]
[{"type": "subtitle", "time": 6183.51, "timestamp": "01:43:03", "text": "诚实的。你在那里。就是这里"}, {"type": "subtitle", "time": 6186.47, "timestamp": "01:43:06", "text": "我刚才说的就是这个。就在这里。"}, {"type": "subtitle", "time": 6212.79, "timestamp": "01:43:32", "text": "地方？我们该如何进入这个地方？"}, {"type": "subtitle", "time": 6215.43, "timestamp": "01:43:35", "text": "我去看动漫电影是因为他们"}, {"type": "subtitle", "time": 6218.229, "timestamp": "01:43:38", "text": "情节老套，而且没有视觉效果。它"}, {"type": "subtitle", "time": 6219.91, "timestamp": "01:43:39", "text": "就这么凭空冒出来，他们"}, {"type": "subtitle", "time": 6234.47, "timestamp": "01:43:54", "text": "我记得来过这里，就像……"}, {"type": "subtitle", "time": 6238.27, "timestamp": "01:43:58", "text": "就像问自己该往哪里走一样"}]
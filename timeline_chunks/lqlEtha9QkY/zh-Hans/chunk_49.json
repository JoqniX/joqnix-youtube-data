[{"type": "subtitle", "time": 2941.43, "timestamp": "00:49:01", "text": "是的。好了，完成了。所以，哟，最近怎么样？"}, {"type": "subtitle", "time": 2942.51, "timestamp": "00:49:02", "text": "什么是"}, {"type": "subtitle", "time": 2947.27, "timestamp": "00:49:07", "text": "我当时就想，嗯，你说吧，你走吧。"}, {"type": "subtitle", "time": 2961.43, "timestamp": "00:49:21", "text": "嗯，是的，毕竟"}, {"type": "subtitle", "time": 2963.99, "timestamp": "00:49:23", "text": "今天合作的时候，我就想，呃，就……"}, {"type": "subtitle", "time": 2966.47, "timestamp": "00:49:26", "text": "夜深人静时，胡思乱想着一些事。"}, {"type": "subtitle", "time": 2968.39, "timestamp": "00:49:28", "text": "我的天啊，你到底做了多少次合作？"}, {"type": "subtitle", "time": 2972.549, "timestamp": "00:49:32", "text": "必须这样做吗？呃，其中一个是邀请。"}, {"type": "subtitle", "time": 2975.309, "timestamp": "00:49:35", "text": "我。是的。是的。我仍在计划中"}, {"type": "subtitle", "time": 2977.829, "timestamp": "00:49:37", "text": "虽然这个月就是这样。不，我还是得……"}, {"type": "subtitle", "time": 2979.309, "timestamp": "00:49:39", "text": "用"}, {"type": "subtitle", "time": 2982.71, "timestamp": "00:49:42", "text": "你。我心想，为什么时间这么短？"}, {"type": "subtitle", "time": 2986.39, "timestamp": "00:49:46", "text": "临时计划真的太痛苦了"}, {"type": "subtitle", "time": 2988.47, "timestamp": "00:49:48", "text": "尤其是如果我联系"}, {"type": "subtitle", "time": 2990.71, "timestamp": "00:49:50", "text": "有人会问，你是吗？"}, {"type": "subtitle", "time": 2992.47, "timestamp": "00:49:52", "text": "这个月免费吗？他们说，我是"}, {"type": "subtitle", "time": 2995.67, "timestamp": "00:49:55", "text": "忙碌的。然后我就想，“哦，拜拜。我想要的"}]
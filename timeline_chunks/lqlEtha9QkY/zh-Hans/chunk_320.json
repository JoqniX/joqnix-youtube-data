[{"type": "subtitle", "time": 19202.628, "timestamp": "05:20:02", "text": "本星期。我们以前见过这种情况。你"}, {"type": "subtitle", "time": 19205.43, "timestamp": "05:20:05", "text": "将添加来自尤诺米亚时间黄蜂的卵"}, {"type": "subtitle", "time": 19207.51, "timestamp": "05:20:07", "text": "给击球手。饼干会冒出来"}, {"type": "subtitle", "time": 19211.59, "timestamp": "05:20:11", "text": "刚从窑里拿出来，蓬松柔软，奶香浓郁。哇。"}, {"type": "subtitle", "time": 19213.83, "timestamp": "05:20:13", "text": "谢谢你，莫里斯。你是最棒的。嘿，"}, {"type": "subtitle", "time": 19217.99, "timestamp": "05:20:17", "text": "每个人。莫里斯拯救了拉里的早午餐。"}, {"type": "subtitle", "time": 19221.27, "timestamp": "05:20:21", "text": "不，不，不。这完全不对。莫里斯"}, {"type": "subtitle", "time": 19224.948, "timestamp": "05:20:24", "text": "是一个索里安人，一个冷血杀手。他是"}, {"type": "subtitle", "time": 19228.15, "timestamp": "05:20:28", "text": "他肯定在策划什么。"}, {"type": "subtitle", "time": 19230.23, "timestamp": "05:20:30", "text": "哦，是的。我们可以去杀杀杀。"}, {"type": "subtitle", "time": 19251.67, "timestamp": "05:20:51", "text": "这是什么？这是什么？"}]
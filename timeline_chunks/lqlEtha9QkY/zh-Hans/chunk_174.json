[{"type": "subtitle", "time": 10440.99, "timestamp": "02:54:00", "text": "可以喜欢"}, {"type": "subtitle", "time": 10444.99, "timestamp": "02:54:04", "text": "嗯，近战中把它打碎。我不知道"}, {"type": "subtitle", "time": 10449.349, "timestamp": "02:54:09", "text": "如何。等等，正在缓冲。等等，什么？"}, {"type": "subtitle", "time": 10450.11, "timestamp": "02:54:10", "text": "它是"}, {"type": "subtitle", "time": 10455.79, "timestamp": "02:54:15", "text": "缓冲。哦，不。哦，不。实际上"}, {"type": "subtitle", "time": 10458.469, "timestamp": "02:54:18", "text": "缓冲。不在那里。不，不是这样的。"}, {"type": "subtitle", "time": 10474.03, "timestamp": "02:54:34", "text": "不再是了。如何"}, {"type": "subtitle", "time": 10476.43, "timestamp": "02:54:36", "text": "我去吗？"}, {"type": "subtitle", "time": 10482.11, "timestamp": "02:54:42", "text": "所以我需要采取"}, {"type": "subtitle", "time": 10490.23, "timestamp": "02:54:50", "text": "划船和呼吸以引起注意。采取"}, {"type": "subtitle", "time": 10492.309, "timestamp": "02:54:52", "text": "麦克风不在身边，他们的滑稽表演肯定会被人看到。"}, {"type": "subtitle", "time": 10496.469, "timestamp": "02:54:56", "text": "事情出现了转折，而且不是好事。"}]
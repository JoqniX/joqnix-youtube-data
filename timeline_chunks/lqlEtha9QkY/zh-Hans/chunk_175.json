[{"type": "subtitle", "time": 10506.95, "timestamp": "02:55:06", "text": "[音乐]"}, {"type": "subtitle", "time": 10509.83, "timestamp": "02:55:09", "text": "让我来解释一下狗的习性。你看，"}, {"type": "subtitle", "time": 10511.99, "timestamp": "02:55:11", "text": "他们的头盔投射出增强现实"}, {"type": "subtitle", "time": 10514.71, "timestamp": "02:55:14", "text": "现实游戏凌驾于现实世界之上。所以"}, {"type": "subtitle", "time": 10516.63, "timestamp": "02:55:16", "text": "这些被洗脑的白痴居然真的这么想"}, {"type": "subtitle", "time": 10519.429, "timestamp": "02:55:19", "text": "他们在玩电子游戏。"}, {"type": "subtitle", "time": 10522.23, "timestamp": "02:55:22", "text": "被洗脑的白痴。将他们的盟友展示出来"}, {"type": "subtitle", "time": 10524.15, "timestamp": "02:55:24", "text": "敌人。"}, {"type": "subtitle", "time": 10527.429, "timestamp": "02:55:27", "text": "你正在对受试者进行测试。笨蛋，正常"}, {"type": "subtitle", "time": 10535.75, "timestamp": "02:55:35", "text": "我只需要重新编程NOS系统即可。"}, {"type": "subtitle", "time": 10537.83, "timestamp": "02:55:37", "text": "敌方识别协议，导致"}, {"type": "subtitle", "time": 10540.67, "timestamp": "02:55:40", "text": "他们应该把目标对准马拉湾而不是我们。"}, {"type": "subtitle", "time": 10545.83, "timestamp": "02:55:45", "text": "哦，只是内存系统而已。是时候了"}, {"type": "subtitle", "time": 10554.63, "timestamp": "02:55:54", "text": "黑客袖扣。哦不，他们要来了"}, {"type": "subtitle", "time": 10558.309, "timestamp": "02:55:58", "text": "黑客攻击了这件事。呃，听着。我 我"}]
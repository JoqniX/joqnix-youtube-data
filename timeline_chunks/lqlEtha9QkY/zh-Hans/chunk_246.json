[{"type": "subtitle", "time": 14766.07, "timestamp": "04:06:06", "text": "顶部。我们就这么办。"}, {"type": "subtitle", "time": 14769.269, "timestamp": "04:06:09", "text": "炎热的天气加上高强度的工作，感觉压力很大。"}, {"type": "subtitle", "time": 14772.15, "timestamp": "04:06:12", "text": "像寒冷的冬天一样强烈"}, {"type": "subtitle", "time": 14783.51, "timestamp": "04:06:23", "text": "哦，是的。我没能挺过这一关。"}]
[{"type": "subtitle", "time": 847.189, "timestamp": "00:14:07", "text": "为什么？为什么我觉得如果我……"}, {"type": "subtitle", "time": 850.629, "timestamp": "00:14:10", "text": "是我问别人这个问题的。"}, {"type": "subtitle", "time": 859.509, "timestamp": "00:14:19", "text": "不。因为有好几个"}, {"type": "subtitle", "time": 860.91, "timestamp": "00:14:20", "text": "双方"}, {"type": "subtitle", "time": 864.75, "timestamp": "00:14:24", "text": "这。这件事涉及多个方面。就像"}, {"type": "subtitle", "time": 868.23, "timestamp": "00:14:28", "text": "嗯，你会如何与他人合作？"}, {"type": "subtitle", "time": 870.71, "timestamp": "00:14:30", "text": "是什么让你想要与……合作"}, {"type": "subtitle", "time": 873.99, "timestamp": "00:14:33", "text": "有人吗？第一，你必须检查你的"}, {"type": "subtitle", "time": 876.629, "timestamp": "00:14:36", "text": "需要白色方格。很多事情，"}, {"type": "subtitle", "time": 879.15, "timestamp": "00:14:39", "text": "正确的？你是谁？你会是谁？"}, {"type": "subtitle", "time": 881.75, "timestamp": "00:14:41", "text": "这个人会跟你说话吗？能"}, {"type": "subtitle", "time": 884.31, "timestamp": "00:14:44", "text": "同步了吗？会有能源吗？"}, {"type": "subtitle", "time": 888.59, "timestamp": "00:14:48", "text": "这里有正能量吗？我们能"}, {"type": "subtitle", "time": 891.47, "timestamp": "00:14:51", "text": "嗯……会有吗？"}, {"type": "subtitle", "time": 894.55, "timestamp": "00:14:54", "text": "嗯，会有同步吗？将要"}, {"type": "subtitle", "time": 897.71, "timestamp": "00:14:57", "text": "我们聊天等等等等，就像"}]
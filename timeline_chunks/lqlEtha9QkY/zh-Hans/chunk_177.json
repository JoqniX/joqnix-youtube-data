[{"type": "subtitle", "time": 10621.11, "timestamp": "02:57:01", "text": "这次没有花哨的噱头。好了，现在"}, {"type": "subtitle", "time": 10623.91, "timestamp": "02:57:03", "text": "给最后一个打电话。哦，天哪，你得……"}, {"type": "subtitle", "time": 10627.349, "timestamp": "02:57:07", "text": "把这件事处理好。绿色。"}, {"type": "subtitle", "time": 10632.95, "timestamp": "02:57:12", "text": "我将称他为纳加多尔·马克西马尔。不"}, {"type": "subtitle", "time": 10635.51, "timestamp": "02:57:15", "text": "最大值。我们这次不能再输了。"}, {"type": "subtitle", "time": 10637.83, "timestamp": "02:57:17", "text": "检查系统。"}, {"type": "subtitle", "time": 10640.15, "timestamp": "02:57:20", "text": "[音乐]"}, {"type": "subtitle", "time": 10642.63, "timestamp": "02:57:22", "text": "这次黑客攻击非常成功。"}, {"type": "subtitle", "time": 10651.51, "timestamp": "02:57:31", "text": "真是及时。这就是接近程度。"}, {"type": "subtitle", "time": 10654.55, "timestamp": "02:57:34", "text": "警报。马拉万又来找我了。"}, {"type": "subtitle", "time": 10656.23, "timestamp": "02:57:36", "text": "拖住他们，我去送武器。"}, {"type": "subtitle", "time": 10658.429, "timestamp": "02:57:38", "text": "给劳拉的计划。"}, {"type": "subtitle", "time": 10660.87, "timestamp": "02:57:40", "text": "劳拉，我把摘要发给你了。"}, {"type": "subtitle", "time": 10663.51, "timestamp": "02:57:43", "text": "现在就提供蓝图。他们来了。很好"}, {"type": "subtitle", "time": 10666.55, "timestamp": "02:57:46", "text": "期待您的回复。我看到数据正在传入。"}, {"type": "subtitle", "time": 10667.87, "timestamp": "02:57:47", "text": "我们必须战斗"}]
[{"type": "subtitle", "time": 19320.39, "timestamp": "05:22:00", "text": "签名完好无损。莫里斯，你是"}, {"type": "subtitle", "time": 19322.708, "timestamp": "05:22:02", "text": "我最喜欢的。"}, {"type": "subtitle", "time": 19325.51, "timestamp": "05:22:05", "text": "我简直无法理解。我们开始吧"}, {"type": "subtitle", "time": 19338.31, "timestamp": "05:22:18", "text": "我希望大家都喝够了水。"}, {"type": "subtitle", "time": 19373.91, "timestamp": "05:22:53", "text": "[音乐]"}]
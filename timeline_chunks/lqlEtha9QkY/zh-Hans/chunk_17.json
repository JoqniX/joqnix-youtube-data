[{"type": "subtitle", "time": 1020.069, "timestamp": "00:17:00", "text": "玩一两局什么的，对吧？"}, {"type": "subtitle", "time": 1022.15, "timestamp": "00:17:02", "text": "强迫她带着钱离开去做这件事"}, {"type": "subtitle", "time": 1026.189, "timestamp": "00:17:06", "text": "人们至今仍在谈论这件事。"}, {"type": "subtitle", "time": 1030.15, "timestamp": "00:17:10", "text": "就像嘘，因为那样疏远她，就像你一样"}, {"type": "subtitle", "time": 1033.189, "timestamp": "00:17:13", "text": "仍然是个无名小卒等等，即使得到了"}, {"type": "subtitle", "time": 1035.189, "timestamp": "00:17:15", "text": "几个字幕，但之后你仍然"}, {"type": "subtitle", "time": 1037.909, "timestamp": "00:17:17", "text": "没能长大，但你也没拉。"}, {"type": "subtitle", "time": 1045.429, "timestamp": "00:17:25", "text": "我知道，但是别担心"}, {"type": "subtitle", "time": 1047.669, "timestamp": "00:17:27", "text": "别说对不起，我只是在想事情。"}, {"type": "subtitle", "time": 1049.43, "timestamp": "00:17:29", "text": "声音大点，别担心，没事没事没事。"}, {"type": "subtitle", "time": 1052.31, "timestamp": "00:17:32", "text": "没事，别担心，我只是在想这件事。"}, {"type": "subtitle", "time": 1056.31, "timestamp": "00:17:36", "text": "从你这边来看，就像从我这边来看一样，是什么样的？"}, {"type": "subtitle", "time": 1058.31, "timestamp": "00:17:38", "text": "如果我问别人，就会发生这种情况。"}, {"type": "subtitle", "time": 1063.23, "timestamp": "00:17:43", "text": "其他拥有更多粉丝的人"}, {"type": "subtitle", "time": 1068.11, "timestamp": "00:17:48", "text": "正确的？谁会不喜欢他呢？"}, {"type": "subtitle", "time": 1070.71, "timestamp": "00:17:50", "text": "举个例子，你知道，就像一个 YouTuber 那样，"}, {"type": "subtitle", "time": 1074.71, "timestamp": "00:17:54", "text": "你应该设定界限。不，"}, {"type": "subtitle", "time": 1076.15, "timestamp": "00:17:56", "text": "你知道，凡事都有个界限，不是吗？"}, {"type": "subtitle", "time": 1078.07, "timestamp": "00:17:58", "text": "应该过马路，因为在"}]
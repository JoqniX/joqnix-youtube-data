[{"type": "subtitle", "time": 15254.229, "timestamp": "04:14:14", "text": "最后，我的奖励到了。"}, {"type": "subtitle", "time": 15255.149, "timestamp": "04:14:15", "text": "我的"}, {"type": "subtitle", "time": 15263.349, "timestamp": "04:14:23", "text": "会去。"}, {"type": "subtitle", "time": 15265.51, "timestamp": "04:14:25", "text": "我的遗嘱。"}, {"type": "subtitle", "time": 15267.429, "timestamp": "04:14:27", "text": "不，她不会保护你的。她将"}, {"type": "subtitle", "time": 15271.75, "timestamp": "04:14:31", "text": "杀了你就行了。我把你当作哦，"}, {"type": "subtitle", "time": 15274.389, "timestamp": "04:14:34", "text": "他妈的。"}, {"type": "subtitle", "time": 15289.429, "timestamp": "04:14:49", "text": "昨天冰冻了一些马拉万烟火，还有"}, {"type": "subtitle", "time": 15291.91, "timestamp": "04:14:51", "text": "十三名强盗。打架不是"}, {"type": "subtitle", "time": 15294.63, "timestamp": "04:14:54", "text": "比如烘焙，那肯定是的。但"}, {"type": "subtitle", "time": 15296.55, "timestamp": "04:14:56", "text": "选择。劳拉伊带我们去补给"}, {"type": "subtitle", "time": 15298.149, "timestamp": "04:14:58", "text": "突袭，但我们在路上被困住了"}, {"type": "subtitle", "time": 15299.99, "timestamp": "04:14:59", "text": "强盗们躲进了一处废弃的房屋。"}]
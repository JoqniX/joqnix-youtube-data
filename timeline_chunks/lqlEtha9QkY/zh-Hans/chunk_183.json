[{"type": "subtitle", "time": 10980.55, "timestamp": "03:03:00", "text": "等待。是你吗，凯文？我相信"}, {"type": "subtitle", "time": 10983.07, "timestamp": "03:03:03", "text": "就在这里。哦，等等。不，不"}, {"type": "subtitle", "time": 10994.51, "timestamp": "03:03:14", "text": "它？你看，我们来翻转一下，然后我们"}, {"type": "subtitle", "time": 10997.83, "timestamp": "03:03:17", "text": "去。如何在一个界面中查看所有任务？"}, {"type": "subtitle", "time": 11003.469, "timestamp": "03:03:23", "text": "一个区域？哦，我该如何查看任务呢？"}, {"type": "subtitle", "time": 11012.23, "timestamp": "03:03:32", "text": "它不会出现在……嗯……你……"}, {"type": "subtitle", "time": 11012.91, "timestamp": "03:03:32", "text": "称呼"}, {"type": "subtitle", "time": 11017.469, "timestamp": "03:03:37", "text": "它？这个地方没有显示。"}, {"type": "subtitle", "time": 11019.55, "timestamp": "03:03:39", "text": "嗯"}, {"type": "subtitle", "time": 11022.55, "timestamp": "03:03:42", "text": "哦，好的。这里有个区域划分之类的东西。"}, {"type": "subtitle", "time": 11026.469, "timestamp": "03:03:46", "text": "好的。明白了。杀戮杀手。好的。上升"}, {"type": "subtitle", "time": 11029.51, "timestamp": "03:03:49", "text": "研磨。这是 Meridian Metro。"}, {"type": "subtitle", "time": 11031.79, "timestamp": "03:03:51", "text": "好的。这两个我们都能做到。"}, {"type": "subtitle", "time": 11038.59, "timestamp": "03:03:58", "text": "好的。所以我需要走了"}]
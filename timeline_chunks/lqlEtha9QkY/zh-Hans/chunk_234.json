[{"type": "subtitle", "time": 14046.71, "timestamp": "03:54:06", "text": "惊喜！我希望你成为我的同胞兄弟姐妹。"}, {"type": "subtitle", "time": 14048.269, "timestamp": "03:54:08", "text": "为了"}, {"type": "subtitle", "time": 14051.349, "timestamp": "03:54:11", "text": "生活。你妈妈也和我一起在这里。"}, {"type": "subtitle", "time": 14053.91, "timestamp": "03:54:13", "text": "庆祝。"}, {"type": "subtitle", "time": 14056.309, "timestamp": "03:54:16", "text": "恭喜。"}, {"type": "subtitle", "time": 14059.189, "timestamp": "03:54:19", "text": "她死了。她死了。金库窥视者"}, {"type": "subtitle", "time": 14062.469, "timestamp": "03:54:22", "text": "被杀。杀！杀！勉强奏效了。在"}, {"type": "subtitle", "time": 14064.469, "timestamp": "03:54:24", "text": "至少你进来了。我们之后再谈。"}, {"type": "subtitle", "time": 14067.83, "timestamp": "03:54:27", "text": "血腥屠杀。好的。您的帮助。"}, {"type": "subtitle", "time": 14070.469, "timestamp": "03:54:30", "text": "轰的一声，炸药爆炸了。我们走吧。"}, {"type": "subtitle", "time": 14072.229, "timestamp": "03:54:32", "text": "是的。你好，马索内。你好吗？"}, {"type": "subtitle", "time": 14075.229, "timestamp": "03:54:35", "text": "正确的。这一定是场最终boss战。"}]
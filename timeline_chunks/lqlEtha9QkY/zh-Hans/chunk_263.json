[{"type": "subtitle", "time": 15797.11, "timestamp": "04:23:17", "text": "酒吧。哦，原来是真人。哇。"}, {"type": "subtitle", "time": 15799.349, "timestamp": "04:23:19", "text": "闲暇时，我喜欢自己动手做。"}, {"type": "subtitle", "time": 15802.87, "timestamp": "04:23:22", "text": "玩具。这个是修改版。"}, {"type": "subtitle", "time": 15805.269, "timestamp": "04:23:25", "text": "这是我在卧室里捣鼓出来的。"}, {"type": "subtitle", "time": 15807.59, "timestamp": "04:23:27", "text": "嗯。这个小装置应该能帮到我们"}, {"type": "subtitle", "time": 15809.83, "timestamp": "04:23:29", "text": "当你做什么时，会使Kill的防御失效？"}, {"type": "subtitle", "time": 15811.99, "timestamp": "04:23:31", "text": "你打算怎么做？我认为他会找到"}, {"type": "subtitle", "time": 15814.87, "timestamp": "04:23:34", "text": "其实我刚醒。我非常"}, {"type": "subtitle", "time": 15816.87, "timestamp": "04:23:36", "text": "使困惑。这是怎么回事？没关系。"}, {"type": "subtitle", "time": 15819.75, "timestamp": "04:23:39", "text": "正确的。"}, {"type": "subtitle", "time": 15821.349, "timestamp": "04:23:41", "text": "在其他任何你觉得他如此的地方"}, {"type": "subtitle", "time": 15825.269, "timestamp": "04:23:45", "text": "如果你明白我的意思，那就是他应得的。是的。"}, {"type": "subtitle", "time": 15827.389, "timestamp": "04:23:47", "text": "什么是"}, {"type": "subtitle", "time": 15830.63, "timestamp": "04:23:50", "text": "那个任务物品？好的。那根鸡巴。"}, {"type": "subtitle", "time": 15833.11, "timestamp": "04:23:53", "text": "这就是大致意思。哇。你没有"}, {"type": "subtitle", "time": 15835.95, "timestamp": "04:23:55", "text": "这么说吧，"}]
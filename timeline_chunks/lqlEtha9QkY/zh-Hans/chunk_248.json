[{"type": "subtitle", "time": 14891.189, "timestamp": "04:08:11", "text": "我需要重回巅峰。"}, {"type": "subtitle", "time": 14898.229, "timestamp": "04:08:18", "text": "这不属于游戏规则的一部分。重新进入"}, {"type": "subtitle", "time": 14902.189, "timestamp": "04:08:22", "text": "在那里战斗。特里什，"}, {"type": "subtitle", "time": 14904.95, "timestamp": "04:08:24", "text": "笨蛋。让我去拿一下。科夫是电吉他手"}, {"type": "subtitle", "time": 14907.189, "timestamp": "04:08:27", "text": "轻的。依我看，他不会去的。"}, {"type": "subtitle", "time": 14909.03, "timestamp": "04:08:29", "text": "没有那道电盾的地方"}, {"type": "subtitle", "time": 14912.07, "timestamp": "04:08:32", "text": "他的。"}, {"type": "subtitle", "time": 14914.75, "timestamp": "04:08:34", "text": "好了，接下来是什么？呃，克服"}, {"type": "subtitle", "time": 14917.349, "timestamp": "04:08:37", "text": "那里。所以，我可能得直接走。"}, {"type": "subtitle", "time": 14920.15, "timestamp": "04:08:40", "text": "过来这里。然后是最后一部分"}, {"type": "subtitle", "time": 14922.99, "timestamp": "04:08:42", "text": "会超过这两个人。"}, {"type": "subtitle", "time": 14925.51, "timestamp": "04:08:45", "text": "好的。那么，我们就选最接近的那个吧。"}]
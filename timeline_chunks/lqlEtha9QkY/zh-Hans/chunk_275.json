[{"type": "subtitle", "time": 16505.349, "timestamp": "04:35:05", "text": "你真懂得如何取悦女孩子。"}, {"type": "subtitle", "time": 16507.67, "timestamp": "04:35:07", "text": "传奇人物的前列。那是什么？ 132"}, {"type": "subtitle", "time": 16510.629, "timestamp": "04:35:10", "text": "传奇冠军，随时恭候。"}, {"type": "subtitle", "time": 16512.629, "timestamp": "04:35:12", "text": "你看，这可不是最文明的。"}, {"type": "subtitle", "time": 16515.429, "timestamp": "04:35:15", "text": "星系。我明白了。我不可能射杀每一个人"}, {"type": "subtitle", "time": 16517.189, "timestamp": "04:35:17", "text": "那个胡说八道的混蛋"}, {"type": "subtitle", "time": 16520.709, "timestamp": "04:35:20", "text": "他试图不尊重我。你好。你好。我可以"}, {"type": "subtitle", "time": 16522.789, "timestamp": "04:35:22", "text": "尝试。"}, {"type": "subtitle", "time": 16525.59, "timestamp": "04:35:25", "text": "天哪。"}, {"type": "subtitle", "time": 16528.949, "timestamp": "04:35:28", "text": "好了，完成了。所以，呃，我相信我们"}, {"type": "subtitle", "time": 16533.269, "timestamp": "04:35:33", "text": "我们完成了大部分任务。"}, {"type": "subtitle", "time": 16535.629, "timestamp": "04:35:35", "text": "等待。"}, {"type": "subtitle", "time": 16537.709, "timestamp": "04:35:37", "text": "嗯，放我走吧"}, {"type": "subtitle", "time": 16540.349, "timestamp": "04:35:40", "text": "在这里排序"}, {"type": "subtitle", "time": 16543.67, "timestamp": "04:35:43", "text": "地区。监狱的这一部分"}, {"type": "subtitle", "time": 16548.269, "timestamp": "04:35:48", "text": "郊区，这是最后一个了。"}, {"type": "subtitle", "time": 16550.551, "timestamp": "04:35:50", "text": "相信。我们收到所有信号了吗？"}, {"type": "subtitle", "time": 16554.47, "timestamp": "04:35:54", "text": "任务？呃，这是什么？哦，这是"}, {"type": "subtitle", "time": 16556.949, "timestamp": "04:35:56", "text": "令人闻风丧胆的死信箱。我们可以去这里。我们"}, {"type": "subtitle", "time": 16558.47, "timestamp": "04:35:58", "text": "全部收集完毕。我们可以得到一个"}]
[{"type": "subtitle", "time": 3780.24, "timestamp": "01:03:00", "text": "“什么？你怎么会喜欢那样？”我 我 就像冰牛奶一样。好的。尤其是在类似的情况下"}, {"type": "subtitle", "time": 3784.16, "timestamp": "01:03:04", "text": "就像冰牛奶一样。好的。尤其是在类似的情况下 天气炎热时，冰牛奶更好喝。"}, {"type": "subtitle", "time": 3788.319, "timestamp": "01:03:08", "text": "天气炎热时，冰牛奶更好喝。 嗯。在寒冷的季节，我换成"}, {"type": "subtitle", "time": 3792.64, "timestamp": "01:03:12", "text": "嗯。在寒冷的季节，我换成 喝热饮"}, {"type": "subtitle", "time": 3794.839, "timestamp": "01:03:14", "text": "喝热饮 水和我"}, {"type": "subtitle", "time": 3797.64, "timestamp": "01:03:17", "text": "水和我 还要喝热牛奶。"}, {"type": "subtitle", "time": 3802.16, "timestamp": "01:03:22", "text": "还要喝热牛奶。 喜欢做冰咖啡"}, {"type": "subtitle", "time": 3812.39, "timestamp": "01:03:32", "text": "我。你应该知道，如果我得到了一个"}, {"type": "subtitle", "time": 3813.91, "timestamp": "01:03:33", "text": "有机会的话，我会给你一些。"}, {"type": "subtitle", "time": 3817.19, "timestamp": "01:03:37", "text": "我的冷咖啡。"}, {"type": "subtitle", "time": 3819.91, "timestamp": "01:03:39", "text": "我做的冰咖啡很好喝。好的。我制作"}, {"type": "subtitle", "time": 3822.71, "timestamp": "01:03:42", "text": "好喝的冰咖啡。"}, {"type": "subtitle", "time": 3825.029, "timestamp": "01:03:45", "text": "你会惊讶于我在这方面有多出色"}, {"type": "subtitle", "time": 3828.309, "timestamp": "01:03:48", "text": "制作冰咖啡。"}, {"type": "subtitle", "time": 3830.069, "timestamp": "01:03:50", "text": "是的。"}, {"type": "subtitle", "time": 3834.87, "timestamp": "01:03:54", "text": "你最喜欢哪种类型的饮料？"}, {"type": "subtitle", "time": 3838.95, "timestamp": "01:03:58", "text": "喝。而且我不喜欢咖啡，真的。"}]
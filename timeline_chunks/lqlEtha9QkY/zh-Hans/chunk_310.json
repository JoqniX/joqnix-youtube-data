[{"type": "subtitle", "time": 18602.55, "timestamp": "05:10:02", "text": "哦，我18级的时候就可以用了。"}, {"type": "subtitle", "time": 18609.11, "timestamp": "05:10:09", "text": "我送出的那把枪是最……之一"}, {"type": "subtitle", "time": 18619.99, "timestamp": "05:10:19", "text": "等等，我现在是什么等级？实际上，该如何……"}, {"type": "subtitle", "time": 18623.11, "timestamp": "05:10:23", "text": "我该查看我的液位吗？"}, {"type": "subtitle", "time": 18635.39, "timestamp": "05:10:35", "text": "我？如何查看我的液位？"}, {"type": "subtitle", "time": 18645.59, "timestamp": "05:10:45", "text": "想想某些事物的最大力量。"}, {"type": "subtitle", "time": 18646.51, "timestamp": "05:10:46", "text": "确实如此"}, {"type": "subtitle", "time": 18650.31, "timestamp": "05:10:50", "text": "怜悯。哦，"}, {"type": "subtitle", "time": 18652.47, "timestamp": "05:10:52", "text": "我们走吧。"}, {"type": "subtitle", "time": 18655.83, "timestamp": "05:10:55", "text": "你好，Hunter。"}, {"type": "subtitle", "time": 18657.11, "timestamp": "05:10:57", "text": "信不信由你，这曾经是一个"}, {"type": "subtitle", "time": 18658.23, "timestamp": "05:10:58", "text": "不错 这曾经是个不错的地方"}]
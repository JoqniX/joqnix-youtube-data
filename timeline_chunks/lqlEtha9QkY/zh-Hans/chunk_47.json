[{"type": "subtitle", "time": 2820.95, "timestamp": "00:47:00", "text": "我只是提些建议而已。"}, {"type": "subtitle", "time": 2823.19, "timestamp": "00:47:03", "text": "或许对你有帮助，因为你正在制作"}, {"type": "subtitle", "time": 2825.43, "timestamp": "00:47:05", "text": "我第一次开始拍摄视频就是从……"}, {"type": "subtitle", "time": 2828.069, "timestamp": "00:47:08", "text": "我一直在制作视频。"}, {"type": "subtitle", "time": 2830.069, "timestamp": "00:47:10", "text": "因为我当时真的是个视频爱好者，所以我就开始拍视频了。"}, {"type": "subtitle", "time": 2833.27, "timestamp": "00:47:13", "text": "孩子。好的，"}, {"type": "subtitle", "time": 2835.109, "timestamp": "00:47:15", "text": "我在这件事上可没撒谎。我曾是"}, {"type": "subtitle", "time": 2838.71, "timestamp": "00:47:18", "text": "我开始的时候还是个孩子。"}, {"type": "subtitle", "time": 2842.51, "timestamp": "00:47:22", "text": "不在我的主频道，而是在"}, {"type": "subtitle", "time": 2847.109, "timestamp": "00:47:27", "text": "另一个平台我就不点名了。"}, {"type": "subtitle", "time": 2849.67, "timestamp": "00:47:29", "text": "我会告诉大家我的频道叫什么名字。"}, {"type": "subtitle", "time": 2853.75, "timestamp": "00:47:33", "text": "而且我从来没有在那些场合中使用过我的声音。"}, {"type": "subtitle", "time": 2855.91, "timestamp": "00:47:35", "text": "啊，"}, {"type": "subtitle", "time": 2858.95, "timestamp": "00:47:38", "text": "你做视频多久了？"}, {"type": "subtitle", "time": 2868.309, "timestamp": "00:47:48", "text": "之前我只记得我呃尝试过"}, {"type": "subtitle", "time": 2871.67, "timestamp": "00:47:51", "text": "去做吧，录下一些东西，我说话的内容。"}, {"type": "subtitle", "time": 2875.47, "timestamp": "00:47:55", "text": "或者别的什么，但都没用。"}, {"type": "subtitle", "time": 2878.39, "timestamp": "00:47:58", "text": "出去。我当时非常尴尬，我"}]
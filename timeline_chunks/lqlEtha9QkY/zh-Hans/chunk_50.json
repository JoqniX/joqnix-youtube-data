[{"type": "subtitle", "time": 3000.549, "timestamp": "00:50:00", "text": "希望能与IO有更多合作。"}, {"type": "subtitle", "time": 3004.15, "timestamp": "00:50:04", "text": "就好像我从三月份就开始做了一样"}, {"type": "subtitle", "time": 3005.91, "timestamp": "00:50:05", "text": "如果一切都计划好了，它就会……"}, {"type": "subtitle", "time": 3009.109, "timestamp": "00:50:09", "text": "情况会更好。现在，我可能不是"}, {"type": "subtitle", "time": 3011.99, "timestamp": "00:50:11", "text": "下个月就免费了。"}, {"type": "subtitle", "time": 3015.829, "timestamp": "00:50:15", "text": "所以，所以，所以，哦，对了，说话的时候，什么时候"}, {"type": "subtitle", "time": 3019.03, "timestamp": "00:50:19", "text": "你这个月有空吗？本月"}, {"type": "subtitle", "time": 3021.309, "timestamp": "00:50:21", "text": "完全地。哦，"}, {"type": "subtitle", "time": 3025.75, "timestamp": "00:50:25", "text": "好的。那我们应该做点什么。是的。"}, {"type": "subtitle", "time": 3029.51, "timestamp": "00:50:29", "text": "我们应该怎么做？该怎么办？好的"}, {"type": "subtitle", "time": 3036.79, "timestamp": "00:50:36", "text": "人们，"}, {"type": "subtitle", "time": 3038.87, "timestamp": "00:50:38", "text": "为什么不从你开始呢？好久不见了。"}, {"type": "subtitle", "time": 3040.79, "timestamp": "00:50:40", "text": "不。"}, {"type": "subtitle", "time": 3043.99, "timestamp": "00:50:43", "text": "Stard 是一项长期投入。或许"}, {"type": "subtitle", "time": 3046.829, "timestamp": "00:50:46", "text": "我们能做到。你知道，你总是"}, {"type": "subtitle", "time": 3051.19, "timestamp": "00:50:51", "text": "所以，流媒体播放是合理的。"}, {"type": "subtitle", "time": 3054.87, "timestamp": "00:50:54", "text": "我们能做到。好主意。它不"}, {"type": "subtitle", "time": 3056.95, "timestamp": "00:50:56", "text": "必须始终如此。我们可以回来。"}]
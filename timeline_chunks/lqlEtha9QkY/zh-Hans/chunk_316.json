[{"type": "subtitle", "time": 18962.17, "timestamp": "05:16:02", "text": "那。我也会把这个发给"}, {"type": "subtitle", "time": 18970.31, "timestamp": "05:16:10", "text": "你知道吗？我们会尽量"}, {"type": "subtitle", "time": 18980.55, "timestamp": "05:16:20", "text": "啊，你在这儿啊。"}, {"type": "subtitle", "time": 18984.15, "timestamp": "05:16:24", "text": "好的。所以，我不需要的东西就是这些。"}, {"type": "subtitle", "time": 18986.628, "timestamp": "05:16:26", "text": "我们非常感谢您的惠顾。我"}, {"type": "subtitle", "time": 18998.31, "timestamp": "05:16:38", "text": "我会把钱全部花在同一个地方。除了"}, {"type": "subtitle", "time": 19004.47, "timestamp": "05:16:44", "text": "所以，我们弄到了一把不错的冲锋枪。所以，我可以选择"}, {"type": "subtitle", "time": 19008.03, "timestamp": "05:16:48", "text": "把其他冲锋枪都卖光，我不卖。"}, {"type": "subtitle", "time": 19016.628, "timestamp": "05:16:56", "text": "实际上，这就是答案。点亮你的口袋"}]
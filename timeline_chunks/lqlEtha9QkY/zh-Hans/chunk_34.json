[{"type": "subtitle", "time": 2051.43, "timestamp": "00:34:11", "text": "所以，没错，YouTube 的定义是……"}, {"type": "subtitle", "time": 2060.55, "timestamp": "00:34:20", "text": "我。我不知道为什么会发生这种事。"}, {"type": "subtitle", "time": 2062.669, "timestamp": "00:34:22", "text": "起初这很有趣，"}, {"type": "subtitle", "time": 2064.79, "timestamp": "00:34:24", "text": "游戏。所以我把你派错地方去了。"}, {"type": "subtitle", "time": 2066.389, "timestamp": "00:34:26", "text": "片刻。哦，没关系。没关系。它是"}, {"type": "subtitle", "time": 2068.47, "timestamp": "00:34:28", "text": "美好的。没关系。别担心。别担心。我是"}, {"type": "subtitle", "time": 2071.51, "timestamp": "00:34:31", "text": "只是自言自语而已。我当时只是"}, {"type": "subtitle", "time": 2074.109, "timestamp": "00:34:34", "text": "呃，在思考一些事情。不"}, {"type": "subtitle", "time": 2077.669, "timestamp": "00:34:37", "text": "担心。嗯，是的。是的。是的。我仍然"}, {"type": "subtitle", "time": 2080.23, "timestamp": "00:34:40", "text": "真是愚蠢。如果你愿意，我们可以聊聊。"}, {"type": "subtitle", "time": 2082.71, "timestamp": "00:34:42", "text": "关于某些事情。我们可以继续"}, {"type": "subtitle", "time": 2084.47, "timestamp": "00:34:44", "text": "如果你想参与这场对话的话"}, {"type": "subtitle", "time": 2086.869, "timestamp": "00:34:46", "text": "某物。我不知道。"}, {"type": "subtitle", "time": 2088.109, "timestamp": "00:34:48", "text": "所以"}, {"type": "subtitle", "time": 2090.71, "timestamp": "00:34:50", "text": "你不想哭吗？或者你想……"}, {"type": "subtitle", "time": 2092.589, "timestamp": "00:34:52", "text": "想坠机，我很乐意"}, {"type": "subtitle", "time": 2097.27, "timestamp": "00:34:57", "text": "到。随便你，笨蛋。只是"}]
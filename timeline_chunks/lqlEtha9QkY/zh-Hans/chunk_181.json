[{"type": "subtitle", "time": 10861.19, "timestamp": "03:01:01", "text": "毕竟，这或许是个值得下注的事情。"}, {"type": "subtitle", "time": 10865.269, "timestamp": "03:01:05", "text": "所以，这是142。"}, {"type": "subtitle", "time": 10872.71, "timestamp": "03:01:12", "text": "你知道吗？想要什么？我会保存这个"}, {"type": "subtitle", "time": 10876.11, "timestamp": "03:01:16", "text": "向上。实际上，停下来"}, {"type": "subtitle", "time": 10878.95, "timestamp": "03:01:18", "text": "它。我不需要这个。实际上，我得到了"}, {"type": "subtitle", "time": 10880.19, "timestamp": "03:01:20", "text": "掉落"}, {"type": "subtitle", "time": 10883.269, "timestamp": "03:01:23", "text": "以防万一。我会好好休养。我们不"}, {"type": "subtitle", "time": 10884.83, "timestamp": "03:01:24", "text": "制作一个"}, {"type": "subtitle", "time": 10887.59, "timestamp": "03:01:27", "text": "烫伤。这些我可以卖掉。好的。我可以"}, {"type": "subtitle", "time": 10890.389, "timestamp": "03:01:30", "text": "卖掉我不需要的东西。我确实升级了"}, {"type": "subtitle", "time": 10893.429, "timestamp": "03:01:33", "text": "我的背包。是的，为了战争。患病的"}, {"type": "subtitle", "time": 10895.03, "timestamp": "03:01:35", "text": "留着我，我自己卖掉。好的。请"}, {"type": "subtitle", "time": 10897.51, "timestamp": "03:01:37", "text": "现在就走。"}, {"type": "subtitle", "time": 10902.19, "timestamp": "03:01:42", "text": "并拿走那些武器。"}]
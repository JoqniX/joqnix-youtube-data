[{"type": "subtitle", "time": 6967.27, "timestamp": "01:56:07", "text": "时间。是的。找到这三个呃之后"}, {"type": "subtitle", "time": 6968.91, "timestamp": "01:56:08", "text": "记忆"}, {"type": "subtitle", "time": 6971.43, "timestamp": "01:56:11", "text": "老虎机游戏结束后，我们今天的工作就结束了。"}, {"type": "subtitle", "time": 6973.75, "timestamp": "01:56:13", "text": "好了，我这就结束直播。"}, {"type": "subtitle", "time": 6975.51, "timestamp": "01:56:15", "text": "我们已经直播了大约两个小时了，"}, {"type": "subtitle", "time": 6980.669, "timestamp": "01:56:20", "text": "正确的？我相信我一开始是这样的"}, {"type": "subtitle", "time": 6994.75, "timestamp": "01:56:34", "text": "开始了。哦，"}, {"type": "subtitle", "time": 7004.27, "timestamp": "01:56:44", "text": "那里。"}, {"type": "subtitle", "time": 7011.189, "timestamp": "01:56:51", "text": "不。我喜欢蓬松感和轻盈感之间的良好平衡。"}, {"type": "subtitle", "time": 7014.31, "timestamp": "01:56:54", "text": "不是废话。我的意思是，轻松一点没问题，但是"}, {"type": "subtitle", "time": 7017.589, "timestamp": "01:56:57", "text": "合适的蓬松度，不要真的蓬松"}]
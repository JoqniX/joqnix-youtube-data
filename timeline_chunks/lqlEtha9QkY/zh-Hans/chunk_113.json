[{"type": "subtitle", "time": 6780.03, "timestamp": "01:53:00", "text": "你们都好吗？"}, {"type": "subtitle", "time": 6782.75, "timestamp": "01:53:02", "text": "呃，三，那里有一美元"}, {"type": "subtitle", "time": 6785.21, "timestamp": "01:53:05", "text": "数字。"}, {"type": "subtitle", "time": 6793.75, "timestamp": "01:53:13", "text": "等待。呃，我觉得“fluff”的意思是“温馨的”。"}, {"type": "subtitle", "time": 6797.07, "timestamp": "01:53:17", "text": "充满爱，而不仅仅是冷酷无情。"}, {"type": "subtitle", "time": 6800.07, "timestamp": "01:53:20", "text": "哦，我知道了。我之前不知道这件事。"}, {"type": "subtitle", "time": 6803.07, "timestamp": "01:53:23", "text": "单词。谢谢你教我"}, {"type": "subtitle", "time": 6806.03, "timestamp": "01:53:26", "text": "这意味着"}, {"type": "subtitle", "time": 6812.55, "timestamp": "01:53:32", "text": "在。等等，这是什么地方？我从未"}, {"type": "subtitle", "time": 6814.109, "timestamp": "01:53:34", "text": "到过"}, {"type": "subtitle", "time": 6827.109, "timestamp": "01:53:47", "text": "好的，接下来是帽子。"}, {"type": "subtitle", "time": 6829.629, "timestamp": "01:53:49", "text": "这个人将会是"}, {"type": "subtitle", "time": 6832.27, "timestamp": "01:53:52", "text": "喝醉了"}]
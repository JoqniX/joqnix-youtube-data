[{"type": "subtitle", "time": 12001.55, "timestamp": "03:20:01", "text": "传奇火箭发射器"}, {"type": "subtitle", "time": 12004.71, "timestamp": "03:20:04", "text": "但没关系。没关系。怎么样？"}, {"type": "subtitle", "time": 12011.429, "timestamp": "03:20:11", "text": "你的敌人会这么做。你好。你好。你好。我们将"}, {"type": "subtitle", "time": 12014.55, "timestamp": "03:20:14", "text": "明白了。卖掉它。我们出售这个。是"}, {"type": "subtitle", "time": 12016.15, "timestamp": "03:20:16", "text": "现金。"}, {"type": "subtitle", "time": 12018.11, "timestamp": "03:20:18", "text": "我们正在制作"}, {"type": "subtitle", "time": 12022.03, "timestamp": "03:20:22", "text": "17,000。哇。慢慢地，我们会把它最大化。"}, {"type": "subtitle", "time": 12024.59, "timestamp": "03:20:24", "text": "出去。慢慢地"}, {"type": "subtitle", "time": 12028.07, "timestamp": "03:20:28", "text": "慢慢地。我们不需要这个和那个，"}, {"type": "subtitle", "time": 12030.07, "timestamp": "03:20:30", "text": "这。"}, {"type": "subtitle", "time": 12032.87, "timestamp": "03:20:32", "text": "把它们做得防弹。"}, {"type": "subtitle", "time": 12035.55, "timestamp": "03:20:35", "text": "呃，还有"}, {"type": "subtitle", "time": 12046.75, "timestamp": "03:20:46", "text": "嗯，我有一把更好的枪。"}, {"type": "subtitle", "time": 12051.03, "timestamp": "03:20:51", "text": "162. 我有一支.243口径的突击步枪。所以，"}, {"type": "subtitle", "time": 12054.229, "timestamp": "03:20:54", "text": "我不需要这些。你真是个糟糕的人"}]
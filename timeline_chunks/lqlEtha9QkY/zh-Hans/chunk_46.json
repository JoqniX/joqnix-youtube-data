[{"type": "subtitle", "time": 2761.03, "timestamp": "00:46:01", "text": "这是人们点击的两件事。"}, {"type": "subtitle", "time": 2763.109, "timestamp": "00:46:03", "text": "视频。"}, {"type": "subtitle", "time": 2765.43, "timestamp": "00:46:05", "text": "哦，"}, {"type": "subtitle", "time": 2769.349, "timestamp": "00:46:09", "text": "这就是我的建议。而且也不要"}, {"type": "subtitle", "time": 2770.67, "timestamp": "00:46:10", "text": "让它像这样"}, {"type": "subtitle", "time": 2773.349, "timestamp": "00:46:13", "text": "长的。你可以写得很长，但不要"}, {"type": "subtitle", "time": 2775.09, "timestamp": "00:46:15", "text": "把它写长一点。"}, {"type": "subtitle", "time": 2777.91, "timestamp": "00:46:17", "text": "[音乐]"}, {"type": "subtitle", "time": 2780.39, "timestamp": "00:46:20", "text": "我一直在关注这类创作者。"}, {"type": "subtitle", "time": 2782.95, "timestamp": "00:46:22", "text": "现在，那些直播和点赞的人也会制作视频。"}, {"type": "subtitle", "time": 2785.39, "timestamp": "00:46:25", "text": "在直播中剪辑他们的直播"}, {"type": "subtitle", "time": 2788.15, "timestamp": "00:46:28", "text": "东西。我当时就想，哦，他们还会生产更多。"}, {"type": "subtitle", "time": 2790.109, "timestamp": "00:46:30", "text": "超过10分钟"}, {"type": "subtitle", "time": 2793.19, "timestamp": "00:46:33", "text": "拍摄他们如何操作的视频。他们确实有，但是他们"}, {"type": "subtitle", "time": 2796.309, "timestamp": "00:46:36", "text": "他们需要，他们必须，他们通常会覆盖"}, {"type": "subtitle", "time": 2801.19, "timestamp": "00:46:41", "text": "值得花30分钟做的事情。啊，是的"}, {"type": "subtitle", "time": 2802.99, "timestamp": "00:46:42", "text": "耶耶耶耶耶"}, {"type": "subtitle", "time": 2806.39, "timestamp": "00:46:46", "text": "是的，兄弟，我觉得你能成功。"}, {"type": "subtitle", "time": 2809.589, "timestamp": "00:46:49", "text": "这时你只需要做你需要做的事。"}, {"type": "subtitle", "time": 2813.109, "timestamp": "00:46:53", "text": "要想正确理解这一点，那就是"}, {"type": "subtitle", "time": 2815.67, "timestamp": "00:46:55", "text": "通过实验弄清楚是怎么回事"}, {"type": "subtitle", "time": 2818.87, "timestamp": "00:46:58", "text": "工作什么的，你做得很好，没问题。"}]
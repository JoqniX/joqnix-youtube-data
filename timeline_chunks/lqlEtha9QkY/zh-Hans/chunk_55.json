[{"type": "subtitle", "time": 3300.79, "timestamp": "00:55:00", "text": "好的。是的。是的。你知道死者"}, {"type": "subtitle", "time": 3305.15, "timestamp": "00:55:05", "text": "基本上几个小时内，所有人都不在。"}, {"type": "subtitle", "time": 3308.549, "timestamp": "00:55:08", "text": "是的。这取决于我的兼职时间。"}, {"type": "subtitle", "time": 3311.589, "timestamp": "00:55:11", "text": "如果我现在掌握了时机的话。"}, {"type": "subtitle", "time": 3314.87, "timestamp": "00:55:14", "text": "我也会兼职直播，所以就不直播了。"}, {"type": "subtitle", "time": 3317.91, "timestamp": "00:55:17", "text": "不不，我也不知道，我在想如果"}, {"type": "subtitle", "time": 3321.27, "timestamp": "00:55:21", "text": "兼职的话，我现在只需要几个小时。"}, {"type": "subtitle", "time": 3324.23, "timestamp": "00:55:24", "text": "提前入住或者其他什么合适的工作"}, {"type": "subtitle", "time": 3326.27, "timestamp": "00:55:26", "text": "或者类似的事情，如果真是那样的话，那我……"}, {"type": "subtitle", "time": 3329.03, "timestamp": "00:55:29", "text": "晚上想着人不多。"}, {"type": "subtitle", "time": 3331.03, "timestamp": "00:55:31", "text": "现在晚上会在那里，还有其他人"}, {"type": "subtitle", "time": 3333.19, "timestamp": "00:55:33", "text": "他们就会在他们的房间里，对吧？"}, {"type": "subtitle", "time": 3335.829, "timestamp": "00:55:35", "text": "晚上我可以做"}, {"type": "subtitle", "time": 3338.79, "timestamp": "00:55:38", "text": "然后，然后，然后结束直播。"}, {"type": "subtitle", "time": 3341.03, "timestamp": "00:55:41", "text": "比如去上兼职，回家，"}, {"type": "subtitle", "time": 3344.63, "timestamp": "00:55:44", "text": "睡觉或者做作业然后睡觉"}, {"type": "subtitle", "time": 3347.51, "timestamp": "00:55:47", "text": "重复。这样就说得通了。"}, {"type": "subtitle", "time": 3349.349, "timestamp": "00:55:49", "text": "是的，"}, {"type": "subtitle", "time": 3352.15, "timestamp": "00:55:52", "text": "这很有道理。我可能需要调整一下"}, {"type": "subtitle", "time": 3355.19, "timestamp": "00:55:55", "text": "很多事。天哪，我好担心。去"}, {"type": "subtitle", "time": 3359.27, "timestamp": "00:55:59", "text": "来到一个新的国家总会有它自己的……"}]
[{"type": "subtitle", "time": 11832.429, "timestamp": "03:17:12", "text": "135美元。这是必要的。我先开始"}, {"type": "subtitle", "time": 11834.87, "timestamp": "03:17:14", "text": "它。如果我服用这个，我就不需要"}, {"type": "subtitle", "time": 11839.15, "timestamp": "03:17:19", "text": "这。所以，我会删除"}, {"type": "subtitle", "time": 11857.229, "timestamp": "03:17:37", "text": "事物。还有什么？"}, {"type": "subtitle", "time": 11862.15, "timestamp": "03:17:42", "text": "呃，不。我忘了带鼠标。等等，等等，"}, {"type": "subtitle", "time": 11864.229, "timestamp": "03:17:44", "text": "等等，等等，等等。停止。告诉你的"}, {"type": "subtitle", "time": 11866.389, "timestamp": "03:17:46", "text": "朋友和敌人。我需要一个"}, {"type": "subtitle", "time": 11868.07, "timestamp": "03:17:48", "text": "回购。我卖了什么？我为什么会这样"}, {"type": "subtitle", "time": 11872.03, "timestamp": "03:17:52", "text": "卖？我卖了什么？一，二，"}, {"type": "subtitle", "time": 11875.51, "timestamp": "03:17:55", "text": "三。好的。好吧，我想这样也行。"}, {"type": "subtitle", "time": 11877.59, "timestamp": "03:17:57", "text": "我必须小心谨慎。"}]
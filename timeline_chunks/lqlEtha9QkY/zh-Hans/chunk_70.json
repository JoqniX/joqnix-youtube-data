[{"type": "subtitle", "time": 4205.11, "timestamp": "01:10:05", "text": "我在国外试过，而且"}, {"type": "subtitle", "time": 4208.229, "timestamp": "01:10:08", "text": "一点也不喜欢。"}, {"type": "subtitle", "time": 4210.87, "timestamp": "01:10:10", "text": "啊，我习惯吃鸡肉了。鸡"}, {"type": "subtitle", "time": 4212.59, "timestamp": "01:10:12", "text": "是方式"}, {"type": "subtitle", "time": 4222.229, "timestamp": "01:10:22", "text": "是的，我在美国吃过，而且"}, {"type": "subtitle", "time": 4225.03, "timestamp": "01:10:25", "text": "我当时感觉非常失望。我当时"}, {"type": "subtitle", "time": 4227.189, "timestamp": "01:10:27", "text": "我当时想，这其实就是这样"}, {"type": "subtitle", "time": 4230.229, "timestamp": "01:10:30", "text": "味道不错。鸡肉好吃多了。"}, {"type": "subtitle", "time": 4232.229, "timestamp": "01:10:32", "text": "我当时正在吃烤鸡。"}, {"type": "subtitle", "time": 4234.07, "timestamp": "01:10:34", "text": "边。"}, {"type": "subtitle", "time": 4240.75, "timestamp": "01:10:40", "text": "你并没有错过什么。"}, {"type": "subtitle", "time": 4246.47, "timestamp": "01:10:46", "text": "能吃牛肉但不能吃"}, {"type": "subtitle", "time": 4249.87, "timestamp": "01:10:49", "text": "因为牛肉"}, {"type": "subtitle", "time": 4253.03, "timestamp": "01:10:53", "text": "是的，你并没有错过什么。坚持"}, {"type": "subtitle", "time": 4255.669, "timestamp": "01:10:55", "text": "鸡。"}, {"type": "subtitle", "time": 4258.87, "timestamp": "01:10:58", "text": "我会想念印度咖喱的，唉。"}]
[{"type": "subtitle", "time": 6846.95, "timestamp": "01:54:06", "text": "向上。不，他们没过来。"}, {"type": "subtitle", "time": 6849.149, "timestamp": "01:54:09", "text": "然而。"}, {"type": "subtitle", "time": 6852.47, "timestamp": "01:54:12", "text": "那么，为什么会有一条通道呢？"}, {"type": "subtitle", "time": 6855.51, "timestamp": "01:54:15", "text": "要爬上去吗？"}, {"type": "subtitle", "time": 6869.99, "timestamp": "01:54:29", "text": "可疑的。但是，是的，健康的……会有的"}, {"type": "subtitle", "time": 6873.79, "timestamp": "01:54:33", "text": "对我而言，它更具情感价值。是啊，一样。"}, {"type": "subtitle", "time": 6875.83, "timestamp": "01:54:35", "text": "相同的。说实话，我想要"}, {"type": "subtitle", "time": 6895.589, "timestamp": "01:54:55", "text": "啊，但我说过我知道这些东西。"}]
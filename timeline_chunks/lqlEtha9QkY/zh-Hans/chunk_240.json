[{"type": "subtitle", "time": 14403.51, "timestamp": "04:00:03", "text": "该死的。去你的。"}, {"type": "subtitle", "time": 14405.83, "timestamp": "04:00:05", "text": "他正盯着我看。每一个动作"}, {"type": "subtitle", "time": 14410.95, "timestamp": "04:00:10", "text": "是的，他正看着我。"}, {"type": "subtitle", "time": 14413.349, "timestamp": "04:00:13", "text": "他知道我所做的一切。"}, {"type": "subtitle", "time": 14419.67, "timestamp": "04:00:19", "text": "地方。现在的问题是，我该如何获得"}, {"type": "subtitle", "time": 14432.429, "timestamp": "04:00:32", "text": "尽管。我应该怎么办"}, {"type": "subtitle", "time": 14435.189, "timestamp": "04:00:35", "text": "尽管？我应该去哪里？哦，我得去"}, {"type": "subtitle", "time": 14439.11, "timestamp": "04:00:39", "text": "在上面。好的。我该怎么上去？"}, {"type": "subtitle", "time": 14458.51, "timestamp": "04:00:58", "text": "这。哦，是我们。这是"}]
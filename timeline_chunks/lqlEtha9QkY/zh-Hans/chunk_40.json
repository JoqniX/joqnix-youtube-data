[{"type": "subtitle", "time": 2400.47, "timestamp": "00:40:00", "text": "诚实地。是的，确实如此。你好，阿斯特拉。"}, {"type": "subtitle", "time": 2402.55, "timestamp": "00:40:02", "text": "欢迎。"}, {"type": "subtitle", "time": 2404.71, "timestamp": "00:40:04", "text": "你什么时候完成你的子目标？"}, {"type": "subtitle", "time": 2408.63, "timestamp": "00:40:08", "text": "方式？次要目标。那东西没用。"}, {"type": "subtitle", "time": 2410.23, "timestamp": "00:40:10", "text": "出去。"}, {"type": "subtitle", "time": 2414.87, "timestamp": "00:40:14", "text": "为什么？因为生意只有……是的，我……"}, {"type": "subtitle", "time": 2418.069, "timestamp": "00:40:18", "text": "在这方面我有点搞砸了。"}, {"type": "subtitle", "time": 2420.23, "timestamp": "00:40:20", "text": "观点。我当时想，“好吧，行。我不是。”"}, {"type": "subtitle", "time": 2421.829, "timestamp": "00:40:21", "text": "我以后不会再这么做了。它不是"}, {"type": "subtitle", "time": 2424.71, "timestamp": "00:40:24", "text": "正在工作。”什么？"}, {"type": "subtitle", "time": 2426.39, "timestamp": "00:40:26", "text": "所以你不应该带……"}, {"type": "subtitle", "time": 2430.069, "timestamp": "00:40:30", "text": "2000卢比一。你本来可以这样"}, {"type": "subtitle", "time": 2433.43, "timestamp": "00:40:33", "text": "投资到了更好的东西上。"}, {"type": "subtitle", "time": 2436.15, "timestamp": "00:40:36", "text": "对不起，我不该责骂你。对不起。不"}, {"type": "subtitle", "time": 2438.47, "timestamp": "00:40:38", "text": "担忧。不要害怕。我当时正在说"}, {"type": "subtitle", "time": 2440.71, "timestamp": "00:40:40", "text": "乔，别买这个。别买这个。我"}, {"type": "subtitle", "time": 2444.15, "timestamp": "00:40:44", "text": "我觉得甚至都没必要。还有乔克"}, {"type": "subtitle", "time": 2450.829, "timestamp": "00:40:50", "text": "小子。"}]
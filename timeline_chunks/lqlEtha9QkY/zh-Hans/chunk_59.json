[{"type": "subtitle", "time": 3542.87, "timestamp": "00:59:02", "text": "我全心投入。而且情况并非如此"}, {"type": "subtitle", "time": 3545.549, "timestamp": "00:59:05", "text": "我是被迫这么做的。我不是，我不去"}, {"type": "subtitle", "time": 3550.069, "timestamp": "00:59:10", "text": "我为什么要这么做？"}, {"type": "subtitle", "time": 3551.91, "timestamp": "00:59:11", "text": "有时候你必须强迫自己"}, {"type": "subtitle", "time": 3555.19, "timestamp": "00:59:15", "text": "直播，但这并不意味着你"}, {"type": "subtitle", "time": 3564.99, "timestamp": "00:59:24", "text": "我个人只是"}, {"type": "subtitle", "time": 3568.91, "timestamp": "00:59:28", "text": "你知道，这只是意味着你"}, {"type": "subtitle", "time": 3572.39, "timestamp": "00:59:32", "text": "不要让自己过度疲惫。你"}, {"type": "subtitle", "time": 3575.51, "timestamp": "00:59:35", "text": "不要因为光做这件事而筋疲力尽"}, {"type": "subtitle", "time": 3583.75, "timestamp": "00:59:43", "text": "很难定义。爱好是某种东西"}, {"type": "subtitle", "time": 3587.51, "timestamp": "00:59:47", "text": "你这样做是为了获得内心的平静。"}, {"type": "subtitle", "time": 3590.23, "timestamp": "00:59:50", "text": "这是你充满热情的事情。你"}, {"type": "subtitle", "time": 3592.23, "timestamp": "00:59:52", "text": "缺乏热情。这是你"}, {"type": "subtitle", "time": 3594.87, "timestamp": "00:59:54", "text": "除了主要工作之外，还可以做一些其他事情。"}]
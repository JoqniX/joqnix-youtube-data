[{"type": "subtitle", "time": 3961.51, "timestamp": "01:06:01", "text": "不，我是一名虚拟主播。我知道该怎么做"}, {"type": "subtitle", "time": 3963.71, "timestamp": "01:06:03", "text": "虚拟主播的工作方式"}, {"type": "subtitle", "time": 3968.23, "timestamp": "01:06:08", "text": "你们的抱怨我们置之不理"}, {"type": "subtitle", "time": 3971.589, "timestamp": "01:06:11", "text": "直播时肚子疼。是的，"}, {"type": "subtitle", "time": 3973.43, "timestamp": "01:06:13", "text": "真的。好像你以为我不知道似的"}, {"type": "subtitle", "time": 3983.309, "timestamp": "01:06:23", "text": "你觉得我瞒着我的是什么？"}, {"type": "subtitle", "time": 3985.99, "timestamp": "01:06:25", "text": "观众？嗯？"}, {"type": "subtitle", "time": 3988.39, "timestamp": "01:06:28", "text": "饥饿是关键。饥饿的。饥饿是"}, {"type": "subtitle", "time": 3990.589, "timestamp": "01:06:30", "text": "钥匙。我现在饿了。"}, {"type": "subtitle", "time": 3993.91, "timestamp": "01:06:33", "text": "其实，我想去吃饭，但是……"}, {"type": "subtitle", "time": 3997.23, "timestamp": "01:06:37", "text": "我不喜欢睡前吃东西。"}, {"type": "subtitle", "time": 4000.789, "timestamp": "01:06:40", "text": "要么是因为那样我会更清醒"}, {"type": "subtitle", "time": 4002.39, "timestamp": "01:06:42", "text": "这很有道理。"}, {"type": "subtitle", "time": 4004.069, "timestamp": "01:06:44", "text": "哦，"}, {"type": "subtitle", "time": 4007.75, "timestamp": "01:06:47", "text": "等等，你几点起床？"}, {"type": "subtitle", "time": 4010.23, "timestamp": "01:06:50", "text": "9:00。"}]
[{"type": "subtitle", "time": 11101.11, "timestamp": "03:05:01", "text": "我很好奇为什么我们不能瞬间移动。我做了"}, {"type": "subtitle", "time": 11103.269, "timestamp": "03:05:03", "text": "激活它。我确实参与了排放控制。"}, {"type": "subtitle", "time": 11104.83, "timestamp": "03:05:04", "text": "第二秒"}, {"type": "subtitle", "time": 11118.95, "timestamp": "03:05:18", "text": "嗯。所以，我们现在是在达拉斯-沃斯堡都会区，对吧？它"}, {"type": "subtitle", "time": 11121.99, "timestamp": "03:05:21", "text": "显示一个激活之类的东西。所以我们需要"}, {"type": "subtitle", "time": 11153.269, "timestamp": "03:05:53", "text": "为什么？我本来可以偷他的自行车，"}, {"type": "subtitle", "time": 11154.51, "timestamp": "03:05:54", "text": "喜欢"}, {"type": "subtitle", "time": 11157.429, "timestamp": "03:05:57", "text": "呃，去了任务区域，不过没事。"}, {"type": "subtitle", "time": 11159.15, "timestamp": "03:05:59", "text": "没关系。它是"}]
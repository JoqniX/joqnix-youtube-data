[{"type": "subtitle", "time": 13862.63, "timestamp": "03:51:02", "text": "这里会发生什么事呢？"}, {"type": "subtitle", "time": 13864.67, "timestamp": "03:51:04", "text": "它已开放。"}, {"type": "subtitle", "time": 13867.189, "timestamp": "03:51:07", "text": "好的。想溜进去，但是我们"}, {"type": "subtitle", "time": 13869.59, "timestamp": "03:51:09", "text": "做不到。"}, {"type": "subtitle", "time": 13872.469, "timestamp": "03:51:12", "text": "你们还没把警察全部消灭吗？如果有什么"}, {"type": "subtitle", "time": 13877.269, "timestamp": "03:51:17", "text": "如果血光出现，我就要……"}, {"type": "subtitle", "time": 13883.83, "timestamp": "03:51:23", "text": "因为我恋爱了。"}, {"type": "subtitle", "time": 13901.189, "timestamp": "03:51:41", "text": "我的天啊。我可能会死在这里。哦，我得到一个"}, {"type": "subtitle", "time": 13902.83, "timestamp": "03:51:42", "text": "第二次机会。"}, {"type": "subtitle", "time": 13906.309, "timestamp": "03:51:46", "text": "好的。我会这么做。然后你就死了。你呢"}, {"type": "subtitle", "time": 13916.63, "timestamp": "03:51:56", "text": "宝贝，你有没有力气救我？"}, {"type": "subtitle", "time": 13919.349, "timestamp": "03:51:59", "text": "我在这边。"}]
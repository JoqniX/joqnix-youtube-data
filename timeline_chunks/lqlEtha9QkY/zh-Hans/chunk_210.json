[{"type": "subtitle", "time": 12602.309, "timestamp": "03:30:02", "text": "他说了什么吗？我应该说"}, {"type": "subtitle", "time": 12610.95, "timestamp": "03:30:10", "text": "上帝。我的天哪。我知道这款游戏是18禁的。"}, {"type": "subtitle", "time": 12614.87, "timestamp": "03:30:14", "text": "而且，但我非常非常重视家庭。"}, {"type": "subtitle", "time": 12641.71, "timestamp": "03:30:41", "text": "你可以去"}, {"type": "subtitle", "time": 12644.71, "timestamp": "03:30:44", "text": "后退。开玩笑说要被苏珊上床。"}, {"type": "subtitle", "time": 12646.71, "timestamp": "03:30:46", "text": "是的。"}]
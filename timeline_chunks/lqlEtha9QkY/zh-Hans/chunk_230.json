[{"type": "subtitle", "time": 13800.0, "timestamp": "03:50:00", "text": "阿特拉斯战士就像她想的那样。如果她 如果他发现我的真实身份，我就完蛋了。"}, {"type": "subtitle", "time": 13803.04, "timestamp": "03:50:03", "text": "如果他发现我的真实身份，我就完蛋了。 谢谢你试图救我，但是"}, {"type": "subtitle", "time": 13804.64, "timestamp": "03:50:04", "text": "谢谢你试图救我，但是 看来我们得照她说的做了。"}, {"type": "subtitle", "time": 13805.76, "timestamp": "03:50:05", "text": "看来我们得照她说的做了。 他说，现在先顺着他的意思吧。你好。你好。"}, {"type": "subtitle", "time": 13807.84, "timestamp": "03:50:07", "text": "他说，现在先顺着他的意思吧。你好。你好。 帮我离开这里，我会告诉别人"}, {"type": "subtitle", "time": 13809.199, "timestamp": "03:50:09", "text": "帮我离开这里，我会告诉别人 你的一切。"}, {"type": "subtitle", "time": 13816.51, "timestamp": "03:50:16", "text": "我相信你。接近警用机器人"}, {"type": "subtitle", "time": 13819.91, "timestamp": "03:50:19", "text": "总部现在。想办法进去。"}, {"type": "subtitle", "time": 13822.229, "timestamp": "03:50:22", "text": "砸碎"}, {"type": "subtitle", "time": 13826.469, "timestamp": "03:50:26", "text": "释放我宝贝的鲜血之光。"}, {"type": "subtitle", "time": 13841.11, "timestamp": "03:50:41", "text": "最后一个就是直的"}, {"type": "subtitle", "time": 13848.11, "timestamp": "03:50:48", "text": "这。哦"}, {"type": "subtitle", "time": 13854.469, "timestamp": "03:50:54", "text": "你来这里的目的是什么？站起来"}, {"type": "subtitle", "time": 13857.349, "timestamp": "03:50:57", "text": "商业。"}, {"type": "subtitle", "time": 13859.349, "timestamp": "03:50:59", "text": "是的，我们这里即将发生几起谋杀案。"}]
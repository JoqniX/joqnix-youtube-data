[{"type": "subtitle", "time": 17882.788, "timestamp": "04:58:02", "text": "升不到18级。伟大的异端"}, {"type": "subtitle", "time": 17889.31, "timestamp": "04:58:09", "text": "火力堪比我们神女王的力量"}, {"type": "subtitle", "time": 17892.788, "timestamp": "04:58:12", "text": "生长。好消息接踵而至。"}, {"type": "subtitle", "time": 17896.15, "timestamp": "04:58:16", "text": "神圣的密室。等等，我接受了吗？"}, {"type": "subtitle", "time": 17899.19, "timestamp": "04:58:19", "text": "我明白了吗？我明白了吗？"}, {"type": "subtitle", "time": 17901.15, "timestamp": "04:58:21", "text": "不，我没明白。"}, {"type": "subtitle", "time": 17905.59, "timestamp": "04:58:25", "text": "奥尼亚。稍等片刻。"}, {"type": "subtitle", "time": 17908.948, "timestamp": "04:58:28", "text": "我明白了吗？不，女王选择领导。"}, {"type": "subtitle", "time": 17911.67, "timestamp": "04:58:31", "text": "你。兄弟姐妹们，不要害怕，因为"}, {"type": "subtitle", "time": 17915.11, "timestamp": "04:58:35", "text": "你因那令人沉醉的触碰而蒙福。不，"}, {"type": "subtitle", "time": 17917.03, "timestamp": "04:58:37", "text": "我没有。你的圣死可能"}, {"type": "subtitle", "time": 17919.83, "timestamp": "04:58:39", "text": "希望我没收到。对于骗局"}, {"type": "subtitle", "time": 17921.83, "timestamp": "04:58:41", "text": "女王本人。"}, {"type": "subtitle", "time": 17925.03, "timestamp": "04:58:45", "text": "愿我们都能如此幸运。金库"}, {"type": "subtitle", "time": 17928.15, "timestamp": "04:58:48", "text": "窃贼反对我们，是因为我吗？"}, {"type": "subtitle", "time": 17930.47, "timestamp": "04:58:50", "text": "相信"}, {"type": "subtitle", "time": 17933.99, "timestamp": "04:58:53", "text": "与你结盟。我不能"}, {"type": "subtitle", "time": 17939.31, "timestamp": "04:58:59", "text": "务必向你的兄弟们告诫我。"}]
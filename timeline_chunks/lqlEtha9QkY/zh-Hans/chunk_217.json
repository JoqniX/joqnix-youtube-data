[{"type": "subtitle", "time": 13034.389, "timestamp": "03:37:14", "text": "好的。"}, {"type": "subtitle", "time": 13035.91, "timestamp": "03:37:15", "text": "这个卖多少钱？哦，谢谢"}, {"type": "subtitle", "time": 13037.75, "timestamp": "03:37:17", "text": "你。"}, {"type": "subtitle", "time": 13041.83, "timestamp": "03:37:21", "text": "195. 这太便宜了。"}, {"type": "subtitle", "time": 13045.19, "timestamp": "03:37:25", "text": "这个多少钱？"}, {"type": "subtitle", "time": 13049.429, "timestamp": "03:37:29", "text": "她能坚持到最后吗？"}, {"type": "subtitle", "time": 13052.469, "timestamp": "03:37:32", "text": "是的，她可以。相信我。"}, {"type": "subtitle", "time": 13054.07, "timestamp": "03:37:34", "text": "别太内疚，就带出去吧"}, {"type": "subtitle", "time": 13056.469, "timestamp": "03:37:36", "text": "其他参赛者。任何会"}, {"type": "subtitle", "time": 13058.71, "timestamp": "03:37:38", "text": "争夺和那个男人睡觉的机会，嗯。"}, {"type": "subtitle", "time": 13062.229, "timestamp": "03:37:42", "text": "他们对社会构成威胁。"}, {"type": "subtitle", "time": 13064.309, "timestamp": "03:37:44", "text": "好的，我们来卖掉这些东西吧。"}, {"type": "subtitle", "time": 13065.55, "timestamp": "03:37:45", "text": "不"}, {"type": "subtitle", "time": 13068.349, "timestamp": "03:37:48", "text": "需要。嗯，那将会是"}, {"type": "subtitle", "time": 13077.15, "timestamp": "03:37:57", "text": "哦等等，这两个是一样的。"}]
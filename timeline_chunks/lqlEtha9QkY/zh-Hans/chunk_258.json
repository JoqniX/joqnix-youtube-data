[{"type": "subtitle", "time": 15483.349, "timestamp": "04:18:03", "text": "所以，那不是台风箱。那是"}, {"type": "subtitle", "time": 15489.429, "timestamp": "04:18:09", "text": "莫克西的船员正在寻找其中一人"}, {"type": "subtitle", "time": 15492.07, "timestamp": "04:18:12", "text": "我们的参赛选手。看来我们有……"}, {"type": "subtitle", "time": 15494.59, "timestamp": "04:18:14", "text": "我们面临着一场生死之战。"}, {"type": "subtitle", "time": 15510.51, "timestamp": "04:18:30", "text": "联系"}, {"type": "subtitle", "time": 15513.349, "timestamp": "04:18:33", "text": "潘多拉依然像个精神病患者一样战斗。"}, {"type": "subtitle", "time": 15515.389, "timestamp": "04:18:35", "text": "男孩，"}, {"type": "subtitle", "time": 15524.429, "timestamp": "04:18:44", "text": "名字将会消亡。哦"}, {"type": "subtitle", "time": 15529.11, "timestamp": "04:18:49", "text": "天哪，没有人能活着出来。看起来像"}, {"type": "subtitle", "time": 15530.95, "timestamp": "04:18:50", "text": "有人将无法免费获得煤炭。"}, {"type": "subtitle", "time": 15535.349, "timestamp": "04:18:55", "text": "足部按摩。祝你下次好运，特鲁迪。"}, {"type": "subtitle", "time": 15538.07, "timestamp": "04:18:58", "text": "对不起。好了，我们现在有了一个"}]
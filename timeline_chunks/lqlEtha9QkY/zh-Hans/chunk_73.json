[{"type": "subtitle", "time": 4383.91, "timestamp": "01:13:03", "text": "嗯？我不明白“这是好事吗？”"}, {"type": "subtitle", "time": 4389.31, "timestamp": "01:13:09", "text": "因为它意味着"}, {"type": "subtitle", "time": 4407.95, "timestamp": "01:13:27", "text": "H. 还有，我"}, {"type": "subtitle", "time": 4411.59, "timestamp": "01:13:31", "text": "我想知道你指的是哪个品牌？"}, {"type": "subtitle", "time": 4415.11, "timestamp": "01:13:35", "text": "我从未像那样喝过酒。"}, {"type": "subtitle", "time": 4417.189, "timestamp": "01:13:37", "text": "奶粉。"}, {"type": "subtitle", "time": 4419.27, "timestamp": "01:13:39", "text": "是的，"}, {"type": "subtitle", "time": 4420.87, "timestamp": "01:13:40", "text": "大概。差不多就是这样。你"}, {"type": "subtitle", "time": 4424.07, "timestamp": "01:13:44", "text": "放一些到水里，然后它就变成了"}, {"type": "subtitle", "time": 4427.99, "timestamp": "01:13:47", "text": "实际上，你知道，"}, {"type": "subtitle", "time": 4437.11, "timestamp": "01:13:57", "text": "我正在浏览亚马逊上的产品"}, {"type": "subtitle", "time": 4439.35, "timestamp": "01:13:59", "text": "瓶装牛奶。我为什么会看这个？"}]
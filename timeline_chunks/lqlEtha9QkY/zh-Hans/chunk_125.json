[{"type": "subtitle", "time": 7540.229, "timestamp": "02:05:40", "text": "呃，盐，她太棒了。真的，"}, {"type": "subtitle", "time": 7543.83, "timestamp": "02:05:43", "text": "真的，真的，真的。没错。"}, {"type": "subtitle", "time": 7546.03, "timestamp": "02:05:46", "text": "我喜欢逗他。"}, {"type": "subtitle", "time": 7549.669, "timestamp": "02:05:49", "text": "回去惹他生气，但我害怕……"}, {"type": "subtitle", "time": 7552.55, "timestamp": "02:05:52", "text": "做得太过分了，所以你知道我不想……"}, {"type": "subtitle", "time": 7553.709, "timestamp": "02:05:53", "text": "也去"}, {"type": "subtitle", "time": 7558.55, "timestamp": "02:05:58", "text": "很多。哦，她必须保护。"}]
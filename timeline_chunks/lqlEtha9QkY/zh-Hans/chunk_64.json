[{"type": "subtitle", "time": 3841.109, "timestamp": "01:04:01", "text": "方式。"}, {"type": "subtitle", "time": 3846.789, "timestamp": "01:04:06", "text": "大多数时候，我不喜欢它的味道。"}, {"type": "subtitle", "time": 3851.91, "timestamp": "01:04:11", "text": "而且它还会让我肚子疼。啊，如果"}, {"type": "subtitle", "time": 3855.19, "timestamp": "01:04:15", "text": "我非常喜欢这种方式地喝它。"}, {"type": "subtitle", "time": 3858.23, "timestamp": "01:04:18", "text": "大多数人喝它，它却让我肚子不舒服。"}, {"type": "subtitle", "time": 3862.069, "timestamp": "01:04:22", "text": "伤害。好痛啊。"}, {"type": "subtitle", "time": 3864.27, "timestamp": "01:04:24", "text": "呃，那你打算怎么办？"}, {"type": "subtitle", "time": 3868.47, "timestamp": "01:04:28", "text": "咖啡因？你喝茶吗？我不喝酒"}, {"type": "subtitle", "time": 3870.96, "timestamp": "01:04:30", "text": "经常摄入咖啡因。"}, {"type": "subtitle", "time": 3880.63, "timestamp": "01:04:40", "text": "你最喜欢喝什么？我不"}, {"type": "subtitle", "time": 3884.349, "timestamp": "01:04:44", "text": "知道。我什么都喝，不管是什么"}, {"type": "subtitle", "time": 3886.349, "timestamp": "01:04:46", "text": "食用。"}, {"type": "subtitle", "time": 3888.87, "timestamp": "01:04:48", "text": "饮用。我不知道。你喝过酒吗？"}, {"type": "subtitle", "time": 3892.15, "timestamp": "01:04:52", "text": "之前是甘蔗汁吗？哦是的。那"}, {"type": "subtitle", "time": 3895.109, "timestamp": "01:04:55", "text": "很好。啊，在……期间真是太棒了"}, {"type": "subtitle", "time": 3897.029, "timestamp": "01:04:57", "text": "夏天。"}]
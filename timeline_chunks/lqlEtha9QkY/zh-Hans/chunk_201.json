[{"type": "subtitle", "time": 12069.99, "timestamp": "03:21:09", "text": "不，那个我也要卖掉。霰弹枪。我愿意"}, {"type": "subtitle", "time": 12073.389, "timestamp": "03:21:13", "text": "没有霰弹枪，也没有辐射"}, {"type": "subtitle", "time": 12076.75, "timestamp": "03:21:16", "text": "枪。我会拿到这些，我会保留它们。"}, {"type": "subtitle", "time": 12091.55, "timestamp": "03:21:31", "text": "所以，这项任务是"}, {"type": "subtitle", "time": 12103.19, "timestamp": "03:21:43", "text": "嗯，这里有D王朝的迪娜和"}, {"type": "subtitle", "time": 12105.349, "timestamp": "03:21:45", "text": "这是一个充满杀戮的世界。我们会做"}, {"type": "subtitle", "time": 12106.83, "timestamp": "03:21:46", "text": "杀手"}, {"type": "subtitle", "time": 12114.07, "timestamp": "03:21:54", "text": "男的？杀手世界就是这么残酷"}]
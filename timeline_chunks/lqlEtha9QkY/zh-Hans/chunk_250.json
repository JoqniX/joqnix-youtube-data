[{"type": "subtitle", "time": 15000.63, "timestamp": "04:10:00", "text": "谁扔的？谁扔的？ WHO"}, {"type": "subtitle", "time": 15002.51, "timestamp": "04:10:02", "text": "扔掉那个"}, {"type": "subtitle", "time": 15027.59, "timestamp": "04:10:27", "text": "我错失了机会。我很好。"}, {"type": "subtitle", "time": 15031.03, "timestamp": "04:10:31", "text": "你扔得正合适。并非无敌"}, {"type": "subtitle", "time": 15034.03, "timestamp": "04:10:34", "text": "书。"}, {"type": "subtitle", "time": 15040.95, "timestamp": "04:10:40", "text": "我们的新参赛者体验了一把滑索。"}, {"type": "subtitle", "time": 15044.63, "timestamp": "04:10:44", "text": "直击我的内心。为所有人放弃"}, {"type": "subtitle", "time": 15047.349, "timestamp": "04:10:47", "text": "来自沼泽星球伊甸园的道路。"}, {"type": "subtitle", "time": 15048.87, "timestamp": "04:10:48", "text": "你知道吗？我要发动猛击"}]
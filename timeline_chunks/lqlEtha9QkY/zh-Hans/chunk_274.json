[{"type": "subtitle", "time": 16466.029, "timestamp": "04:34:26", "text": "为什么？我们需要全力以赴"}, {"type": "subtitle", "time": 16474.869, "timestamp": "04:34:34", "text": "呃，咱们出去抽烟吧，好吗？"}, {"type": "subtitle", "time": 16483.99, "timestamp": "04:34:43", "text": "基尔一直都是人类的垃圾。如果你问"}, {"type": "subtitle", "time": 16487.189, "timestamp": "04:34:47", "text": "在我看来，他就应该待在那里。"}, {"type": "subtitle", "time": 16489.59, "timestamp": "04:34:49", "text": "我的天哪。我可能只会用它来……"}, {"type": "subtitle", "time": 16491.59, "timestamp": "04:34:51", "text": "乐趣。"}, {"type": "subtitle", "time": 16494.83, "timestamp": "04:34:54", "text": "谢谢你的帮助，宝贝。我们聊聊吧。"}]
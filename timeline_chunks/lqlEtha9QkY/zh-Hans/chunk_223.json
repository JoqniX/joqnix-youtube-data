[{"type": "subtitle", "time": 13382.75, "timestamp": "03:43:02", "text": "这里。我该如何到达以下位置？"}, {"type": "subtitle", "time": 13385.83, "timestamp": "03:43:05", "text": "地方？我该如何到达这个地方的下方？"}, {"type": "subtitle", "time": 13387.99, "timestamp": "03:43:07", "text": "我该怎么做？"}, {"type": "subtitle", "time": 13389.71, "timestamp": "03:43:09", "text": "我该如何获得"}, {"type": "subtitle", "time": 13391.95, "timestamp": "03:43:11", "text": "以下？"}, {"type": "subtitle", "time": 13395.83, "timestamp": "03:43:15", "text": "嗯，这里有个地下层。这"}, {"type": "subtitle", "time": 13399.67, "timestamp": "03:43:19", "text": "黑暗将我吞噬。哦，那是《How》"}, {"type": "subtitle", "time": 13401.91, "timestamp": "03:43:21", "text": "我……我无法将目光从你身上移开。"}, {"type": "subtitle", "time": 13404.87, "timestamp": "03:43:24", "text": "参赛者。你喜欢动态的诗意。"}, {"type": "subtitle", "time": 13408.67, "timestamp": "03:43:28", "text": "等等，我怎么会死了？我该怎么做？"}, {"type": "subtitle", "time": 13412.469, "timestamp": "03:43:32", "text": "到这个地方下面去？哦，像这样。不，"}, {"type": "subtitle", "time": 13414.75, "timestamp": "03:43:34", "text": "这不是"}, {"type": "subtitle", "time": 13417.83, "timestamp": "03:43:37", "text": "方式。这意味着我又回到了那个地方。"}, {"type": "subtitle", "time": 13424.229, "timestamp": "03:43:44", "text": "来了。不。我该怎么做？我该如何到达这里？"}, {"type": "subtitle", "time": 13426.11, "timestamp": "03:43:46", "text": "这边是哪里？"}, {"type": "subtitle", "time": 13428.11, "timestamp": "03:43:48", "text": "喜欢"}, {"type": "subtitle", "time": 13432.309, "timestamp": "03:43:52", "text": "这是哪里？我该怎么做？"}, {"type": "subtitle", "time": 13435.63, "timestamp": "03:43:55", "text": "进入这个地下"}, {"type": "subtitle", "time": 13438.99, "timestamp": "03:43:58", "text": "部分？所以我是"}]
[{"type": "subtitle", "time": 17176.15, "timestamp": "04:46:16", "text": "嘿。嘿，你。我需要帮助。该死的。"}, {"type": "subtitle", "time": 17178.31, "timestamp": "04:46:18", "text": "劳拉伊派我来的。怎么回事？"}, {"type": "subtitle", "time": 17179.99, "timestamp": "04:46:19", "text": "餐馆？"}, {"type": "subtitle", "time": 17182.47, "timestamp": "04:46:22", "text": "Bo，是我。我这里还有饥饿的人。"}, {"type": "subtitle", "time": 17185.19, "timestamp": "04:46:25", "text": "回到基地。你明白我的意思吗？"}, {"type": "subtitle", "time": 17188.788, "timestamp": "04:46:28", "text": "我明白你的意思，劳拉伊。我太懂你了。好的，"}, {"type": "subtitle", "time": 17191.75, "timestamp": "04:46:31", "text": "所以那些法西斯主子正在利用我"}, {"type": "subtitle", "time": 17195.27, "timestamp": "04:46:35", "text": "恐龙为它们的军队提供补给。阻止他们。"}, {"type": "subtitle", "time": 17198.23, "timestamp": "04:46:38", "text": "继续。他是不是在里面？什么时候"}, {"type": "subtitle", "time": 17200.15, "timestamp": "04:46:40", "text": "马拉万出现了，我把自己锁在了里面。"}, {"type": "subtitle", "time": 17201.83, "timestamp": "04:46:41", "text": "在我的公寓里。我不会出来"}, {"type": "subtitle", "time": 17203.91, "timestamp": "04:46:43", "text": "直到这场战争结束。你听到了吗？但"}, {"type": "subtitle", "time": 17205.67, "timestamp": "04:46:45", "text": "你可以帮我把餐馆开起来。"}, {"type": "subtitle", "time": 17207.35, "timestamp": "04:46:47", "text": "跑步。而且我可以远程运行它"}]
[{"type": "subtitle", "time": 901.069, "timestamp": "00:15:01", "text": "那？嗯，是的"}, {"type": "subtitle", "time": 904.35, "timestamp": "00:15:04", "text": "因为没有"}, {"type": "subtitle", "time": 908.71, "timestamp": "00:15:08", "text": "有时我会感觉像这样"}, {"type": "subtitle", "time": 910.87, "timestamp": "00:15:10", "text": "呃，在YouTube的世界里"}, {"type": "subtitle", "time": 912.79, "timestamp": "00:15:12", "text": "世界本质 YouTube 上的词语"}, {"type": "subtitle", "time": 917.67, "timestamp": "00:15:17", "text": "合作可以从多个角度来看待，并非如此。"}, {"type": "subtitle", "time": 920.949, "timestamp": "00:15:20", "text": "一个是作为朋友聚会或聚会场所"}, {"type": "subtitle", "time": 924.47, "timestamp": "00:15:24", "text": "放松等等是为了交朋友，"}, {"type": "subtitle", "time": 928.47, "timestamp": "00:15:28", "text": "而且你把你们俩合并起来，就像……"}, {"type": "subtitle", "time": 930.71, "timestamp": "00:15:30", "text": "伟大的。更像是合作项目，对吧？喜欢"}, {"type": "subtitle", "time": 933.269, "timestamp": "00:15:33", "text": "合作。所以这两位主播，"}, {"type": "subtitle", "time": 936.31, "timestamp": "00:15:36", "text": "观众们会互相观看。"}, {"type": "subtitle", "time": 938.75, "timestamp": "00:15:38", "text": "可以互相支持等等"}, {"type": "subtitle", "time": 943.67, "timestamp": "00:15:43", "text": "诸如此类。呃，但问题是当"}, {"type": "subtitle", "time": 947.23, "timestamp": "00:15:47", "text": "说到我的感觉"}, {"type": "subtitle", "time": 950.47, "timestamp": "00:15:50", "text": "是不是因为我太沉迷于此了？"}, {"type": "subtitle", "time": 953.47, "timestamp": "00:15:53", "text": "太容易注意到"}, {"type": "subtitle", "time": 955.99, "timestamp": "00:15:55", "text": "其他推特和油管博主之间的纷争"}, {"type": "subtitle", "time": 957.749, "timestamp": "00:15:57", "text": "我脑子里想的都是些什么。"}, {"type": "subtitle", "time": 959.35, "timestamp": "00:15:59", "text": "像这样过度着色。我不知道，但是"}]
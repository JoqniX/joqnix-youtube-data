[{"type": "subtitle", "time": 10201.03, "timestamp": "02:50:01", "text": "我还需要再进行一些测试。"}, {"type": "subtitle", "time": 10204.07, "timestamp": "02:50:04", "text": "我的诺格族人还有 Nog 黑客攻击"}, {"type": "subtitle", "time": 10207.429, "timestamp": "02:50:07", "text": "将受其约束。"}, {"type": "subtitle", "time": 10210.55, "timestamp": "02:50:10", "text": "什么？我的鸡头在哪儿？"}, {"type": "subtitle", "time": 10213.269, "timestamp": "02:50:13", "text": "他们一定是趁着打斗逃脱的。"}, {"type": "subtitle", "time": 10220.07, "timestamp": "02:50:20", "text": "你看着我，外面却下起了武器雨。"}, {"type": "subtitle", "time": 10222.07, "timestamp": "02:50:22", "text": "从早到晚都在流汗。哦"}, {"type": "subtitle", "time": 10224.15, "timestamp": "02:50:24", "text": "不。打造一辆独一无二的车辆"}, {"type": "subtitle", "time": 10227.59, "timestamp": "02:50:27", "text": "附近。是的。呃，这段时间，对吧，七月份。"}, {"type": "subtitle", "time": 10229.75, "timestamp": "02:50:29", "text": "呃，六月七月份这段时间有点……"}, {"type": "subtitle", "time": 10231.79, "timestamp": "02:50:31", "text": "下雨了"}, {"type": "subtitle", "time": 10235.67, "timestamp": "02:50:35", "text": "这里。有时候，呃，如果太多了……"}, {"type": "subtitle", "time": 10244.07, "timestamp": "02:50:44", "text": "变得血淋淋的。"}, {"type": "subtitle", "time": 10246.95, "timestamp": "02:50:46", "text": "是的。你好，阿迪蒂。欢迎。欢迎。"}, {"type": "subtitle", "time": 10249.55, "timestamp": "02:50:49", "text": "希望你过得愉快"}, {"type": "subtitle", "time": 10252.71, "timestamp": "02:50:52", "text": "天。希望你一切都好。我告诉你了。"}, {"type": "subtitle", "time": 10255.19, "timestamp": "02:50:55", "text": "去把车取回来。"}, {"type": "subtitle", "time": 10257.71, "timestamp": "02:50:57", "text": "你好。你好。我会去取。"}]
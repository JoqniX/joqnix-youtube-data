[{"type": "subtitle", "time": 10080.87, "timestamp": "02:48:00", "text": "哦，是的。呃，我……好吧，我得说几句。"}, {"type": "subtitle", "time": 10083.59, "timestamp": "02:48:03", "text": "关于这件事，当他们进来的时候……"}, {"type": "subtitle", "time": 10085.59, "timestamp": "02:48:05", "text": "永远。是的，有一些。"}, {"type": "subtitle", "time": 10088.55, "timestamp": "02:48:08", "text": "我想分享一个小故事。"}, {"type": "subtitle", "time": 10091.11, "timestamp": "02:48:11", "text": "昨天发生的。是的，对于那些"}, {"type": "subtitle", "time": 10094.07, "timestamp": "02:48:14", "text": "不知道，我有点犹豫，我刚才是不是说了什么？"}, {"type": "subtitle", "time": 10096.87, "timestamp": "02:48:16", "text": "像耳朵一样？我确实说过类似的话，对吧？"}, {"type": "subtitle", "time": 10098.389, "timestamp": "02:48:18", "text": "不知怎么的，我的电话号码泄露了。"}, {"type": "subtitle", "time": 10101.99, "timestamp": "02:48:21", "text": "东西。我在W中修复了它。我需要一个I"}, {"type": "subtitle", "time": 10105.269, "timestamp": "02:48:25", "text": "没在推特上发帖说这件事"}, {"type": "subtitle", "time": 10107.349, "timestamp": "02:48:27", "text": "公告。你知道，如果有人想要"}, {"type": "subtitle", "time": 10110.389, "timestamp": "02:48:30", "text": "想看看我的Twitch B Twitch直播，"}, {"type": "subtitle", "time": 10111.71, "timestamp": "02:48:31", "text": "他们会这样说："}, {"type": "subtitle", "time": 10114.55, "timestamp": "02:48:34", "text": "“哦，他昨天直播了。在哪儿？”"}, {"type": "subtitle", "time": 10117.59, "timestamp": "02:48:37", "text": "V？”所以，是的，我忘了发推特说这件事。"}, {"type": "subtitle", "time": 10121.99, "timestamp": "02:48:41", "text": "因为我下午6点15分就醒了。后"}, {"type": "subtitle", "time": 10126.87, "timestamp": "02:48:46", "text": "早上十点睡觉？疼痛。是的，"}, {"type": "subtitle", "time": 10128.51, "timestamp": "02:48:48", "text": "就是这样"}, {"type": "subtitle", "time": 10138.11, "timestamp": "02:48:58", "text": "呃，还有，我忘了发推文告诉你关于"}]
[{"type": "subtitle", "time": 12241.67, "timestamp": "03:24:01", "text": "在赛博朋克游戏中曾经这样做过。呃，我想要"}, {"type": "subtitle", "time": 12244.91, "timestamp": "03:24:04", "text": "在直播中播放。嗯，我们接下来就做这个吧。"}, {"type": "subtitle", "time": 12249.429, "timestamp": "03:24:09", "text": "我相信这周和Ark一起。"}, {"type": "subtitle", "time": 12252.07, "timestamp": "03:24:12", "text": "但我相信他们已经修复了这个问题。他们"}, {"type": "subtitle", "time": 12254.71, "timestamp": "03:24:14", "text": "已修复。所以你不能进入"}, {"type": "subtitle", "time": 12258.389, "timestamp": "03:24:18", "text": "最后还有秘密豪宅之类的东西。"}, {"type": "subtitle", "time": 12260.229, "timestamp": "03:24:20", "text": "游戏。你不能去那个地方"}, {"type": "subtitle", "time": 12264.15, "timestamp": "03:24:24", "text": "不再是了。我没去那个秘密的地方。"}, {"type": "subtitle", "time": 12268.15, "timestamp": "03:24:28", "text": "V的豪宅，还有，呃，得到"}, {"type": "subtitle", "time": 12270.87, "timestamp": "03:24:30", "text": "外套和一些东西。当我直播的时候"}, {"type": "subtitle", "time": 12274.71, "timestamp": "03:24:34", "text": "就像游戏刚发售的时候那样"}, {"type": "subtitle", "time": 12284.87, "timestamp": "03:24:44", "text": "乐趣。呃，我刚刚从西伯利亚迷路回来。"}, {"type": "subtitle", "time": 12286.469, "timestamp": "03:24:46", "text": "教堂从通道点燃蜡烛"}, {"type": "subtitle", "time": 12289.99, "timestamp": "03:24:49", "text": "离开爷爷和呃爷爷"}, {"type": "subtitle", "time": 12292.469, "timestamp": "03:24:52", "text": "他们自己。你好。愿他们安息"}]
[{"type": "subtitle", "time": 18483.91, "timestamp": "05:08:03", "text": "看来我们开局不错。"}, {"type": "subtitle", "time": 18513.67, "timestamp": "05:08:33", "text": "我回来了。我回来了。我回来了。我回来了。"}, {"type": "subtitle", "time": 18517.19, "timestamp": "05:08:37", "text": "去。去。去。去。 H. 我觉得看看就行了"}, {"type": "subtitle", "time": 18520.23, "timestamp": "05:08:40", "text": "那条狗。狗狗反应很慢。所以，来吧"}, {"type": "subtitle", "time": 18520.91, "timestamp": "05:08:40", "text": "在"}, {"type": "subtitle", "time": 18524.628, "timestamp": "05:08:44", "text": "现在。我的天哪。我为什么会在这里？"}, {"type": "subtitle", "time": 18527.35, "timestamp": "05:08:47", "text": "再次？是的。让我把这些东西卖掉吧"}, {"type": "subtitle", "time": 18530.47, "timestamp": "05:08:50", "text": "稍后回来。你好。是的。你好。欢迎，"}, {"type": "subtitle", "time": 18534.47, "timestamp": "05:08:54", "text": "欢迎。记住这一点。你好。你好。呃，让"}, {"type": "subtitle", "time": 18539.19, "timestamp": "05:08:59", "text": "我：嗨。走之前卖掉一些东西。"}]
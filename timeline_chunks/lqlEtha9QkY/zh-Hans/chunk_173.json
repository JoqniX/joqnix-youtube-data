[{"type": "subtitle", "time": 10382.07, "timestamp": "02:53:02", "text": "[音乐]"}, {"type": "subtitle", "time": 10383.59, "timestamp": "02:53:03", "text": "我要弄到这辆车然后偷东西。"}, {"type": "subtitle", "time": 10389.429, "timestamp": "02:53:09", "text": "我需要升级……"}, {"type": "subtitle", "time": 10397.269, "timestamp": "02:53:17", "text": "车辆。哦，现在显示我可以停车了。"}, {"type": "subtitle", "time": 10402.15, "timestamp": "02:53:22", "text": "就像得到它一样。我懂了。"}, {"type": "subtitle", "time": 10405.83, "timestamp": "02:53:25", "text": "偷窃固然不好，但越是偷窃越好。"}, {"type": "subtitle", "time": 10407.99, "timestamp": "02:53:27", "text": "你获得的升级越多，你就越优秀。"}, {"type": "subtitle", "time": 10410.99, "timestamp": "02:53:30", "text": "是吗？车辆"}, {"type": "subtitle", "time": 10413.99, "timestamp": "02:53:33", "text": "明智之举，对吧？我就是这样得到的"}, {"type": "subtitle", "time": 10417.11, "timestamp": "02:53:37", "text": "全息循环，就像有一个"}, {"type": "subtitle", "time": 10418.19, "timestamp": "02:53:38", "text": "炽盛"}, {"type": "subtitle", "time": 10426.429, "timestamp": "02:53:46", "text": "东西。所以，是的，这东西"}, {"type": "subtitle", "time": 10429.349, "timestamp": "02:53:49", "text": "对吧？或者类似的话。我不知道该怎么做"}, {"type": "subtitle", "time": 10431.59, "timestamp": "02:53:51", "text": "打破它。"}, {"type": "subtitle", "time": 10434.71, "timestamp": "02:53:54", "text": "呃，我看过一些视频，呃，比如如果我"}, {"type": "subtitle", "time": 10437.269, "timestamp": "02:53:57", "text": "解锁两个或多个星球，并且"}, {"type": "subtitle", "time": 10439.99, "timestamp": "02:53:59", "text": "游戏进行到后面，我就没辙了。我"}]
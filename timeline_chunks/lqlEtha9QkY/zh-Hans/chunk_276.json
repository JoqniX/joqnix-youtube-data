[{"type": "subtitle", "time": 16562.39, "timestamp": "04:36:02", "text": "高级武器。是的。"}, {"type": "subtitle", "time": 16564.07, "timestamp": "04:36:04", "text": "对不起，乔。我得早点睡觉，因为"}, {"type": "subtitle", "time": 16566.47, "timestamp": "04:36:06", "text": "我病了。我现在感觉不舒服。"}, {"type": "subtitle", "time": 16568.91, "timestamp": "04:36:08", "text": "你好。照顾好"}, {"type": "subtitle", "time": 16570.869, "timestamp": "04:36:10", "text": "你自己。感谢你完成你的工作"}, {"type": "subtitle", "time": 16593.869, "timestamp": "04:36:33", "text": "所以，我需要在上面添加一个服装标记。"}, {"type": "subtitle", "time": 16605.189, "timestamp": "04:36:45", "text": "去找别人吧。敌人很多。我"}, {"type": "subtitle", "time": 16606.709, "timestamp": "04:36:46", "text": "想全部跳过。我不想"}, {"type": "subtitle", "time": 16609.029, "timestamp": "04:36:49", "text": "浪费我的时间"}, {"type": "subtitle", "time": 16611.83, "timestamp": "04:36:51", "text": "与他们战斗。每个人。你，"}, {"type": "subtitle", "time": 16615.99, "timestamp": "04:36:55", "text": "我，战斗到死。不，我跑向"}]
[{"type": "subtitle", "time": 20104.87, "timestamp": "05:35:04", "text": "得到"}, {"type": "subtitle", "time": 20122.27, "timestamp": "05:35:22", "text": "狗狗。好的，我们开始吧"}, {"type": "subtitle", "time": 20126.43, "timestamp": "05:35:26", "text": "去。有一种方法可以旅行"}, {"type": "subtitle", "time": 20129.35, "timestamp": "05:35:29", "text": "速度快得像兔子跳一样。你滑行"}, {"type": "subtitle", "time": 20132.788, "timestamp": "05:35:32", "text": "然后做点什么。我忘了那是什么"}, {"type": "subtitle", "time": 20134.75, "timestamp": "05:35:34", "text": "它"}, {"type": "subtitle", "time": 20137.51, "timestamp": "05:35:37", "text": "打电话。我猜他们没有修复这个问题。"}, {"type": "subtitle", "time": 20153.11, "timestamp": "05:35:53", "text": "哦，你看我死定了。"}]
[{"type": "subtitle", "time": 5760.47, "timestamp": "01:36:00", "text": "他们把它变成了现实。他们真的真的"}, {"type": "subtitle", "time": 5762.47, "timestamp": "01:36:02", "text": "阅读特定书籍时涌现的快乐回忆"}, {"type": "subtitle", "time": 5765.27, "timestamp": "01:36:05", "text": "一个，Yuri看起来真的很可爱。是的，"}, {"type": "subtitle", "time": 5767.39, "timestamp": "01:36:07", "text": "尤里真是太"}, {"type": "subtitle", "time": 5774.189, "timestamp": "01:36:14", "text": "尤里"}, {"type": "subtitle", "time": 5776.55, "timestamp": "01:36:16", "text": "也。如果你问我哪个是你的"}, {"type": "subtitle", "time": 5778.35, "timestamp": "01:36:18", "text": "最喜欢的快乐或"}, {"type": "subtitle", "time": 5783.79, "timestamp": "01:36:23", "text": "哎，真难啊。我两个都喜欢。"}, {"type": "subtitle", "time": 5787.59, "timestamp": "01:36:27", "text": "尽管。但我最初是看《尤里》的。"}, {"type": "subtitle", "time": 5792.149, "timestamp": "01:36:32", "text": "第一的。然后我迷上了Yoi。所以我以前"}, {"type": "subtitle", "time": 5795.83, "timestamp": "01:36:35", "text": "看电视，不看电视，读很多漫画。"}, {"type": "subtitle", "time": 5799.99, "timestamp": "01:36:39", "text": "百合漫画。 Vampers是其中之一。当我"}, {"type": "subtitle", "time": 5803.149, "timestamp": "01:36:43", "text": "很喜欢《吸血鬼》，它太棒了"}, {"type": "subtitle", "time": 5807.189, "timestamp": "01:36:47", "text": "可爱的。所以当我开始读《吸血鬼》系列小说时，"}, {"type": "subtitle", "time": 5810.31, "timestamp": "01:36:50", "text": "作者刚开始写那个……"}, {"type": "subtitle", "time": 5814.99, "timestamp": "01:36:54", "text": "漫画。所以我只读了两本。"}, {"type": "subtitle", "time": 5817.59, "timestamp": "01:36:57", "text": "章节。是的，只有两章。那"}, {"type": "subtitle", "time": 5819.91, "timestamp": "01:36:59", "text": "她和作家在一起的时光"}]
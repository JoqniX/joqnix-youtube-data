[{"type": "subtitle", "time": 11223.99, "timestamp": "03:07:03", "text": "米饭和磨碎。我们继续吧"}, {"type": "subtitle", "time": 11229.429, "timestamp": "03:07:09", "text": "我们和这个人聊了聊。一直想要一个"}, {"type": "subtitle", "time": 11237.75, "timestamp": "03:07:17", "text": "所以，在动力核心内部。"}, {"type": "subtitle", "time": 11239.99, "timestamp": "03:07:19", "text": "祝你今天过得愉快。"}, {"type": "subtitle", "time": 11241.99, "timestamp": "03:07:21", "text": "凉爽的。好的。凉爽的。太棒了。现在，击"}, {"type": "subtitle", "time": 11243.75, "timestamp": "03:07:23", "text": "铃铛。这样应该就能移除这家商店或"}, {"type": "subtitle", "time": 11248.15, "timestamp": "03:07:28", "text": "任何。还有我脸上的红斑。"}, {"type": "subtitle", "time": 11254.79, "timestamp": "03:07:34", "text": "哦，商店已通电。我们能得到那个吗？"}, {"type": "subtitle", "time": 11258.389, "timestamp": "03:07:38", "text": "现在喝咖啡吗，咖啡师机器人？哦，天哪。不能"}, {"type": "subtitle", "time": 11262.15, "timestamp": "03:07:42", "text": "做。做不到。为什么？你知道，所以你会"}, {"type": "subtitle", "time": 11265.51, "timestamp": "03:07:45", "text": "请自备外带杯。 W"}, {"type": "subtitle", "time": 11268.15, "timestamp": "03:07:48", "text": "真是胡扯。"}, {"type": "subtitle", "time": 11270.07, "timestamp": "03:07:50", "text": "等等，等等。我知道。那里有个马拉万"}, {"type": "subtitle", "time": 11271.83, "timestamp": "03:07:51", "text": "总是带着旅行杯的指挥官"}, {"type": "subtitle", "time": 11274.23, "timestamp": "03:07:54", "text": "在他身上。看看能不能找到他。一个"}, {"type": "subtitle", "time": 11276.15, "timestamp": "03:07:56", "text": "旅行杯？说实话，那咖啡因"}, {"type": "subtitle", "time": 11278.309, "timestamp": "03:07:58", "text": "下水道汁马拉旺人称之为咖啡"}]
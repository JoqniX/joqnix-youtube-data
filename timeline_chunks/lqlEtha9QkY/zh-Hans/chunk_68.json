[{"type": "subtitle", "time": 4087.829, "timestamp": "01:08:07", "text": "相同的。是的，我当时还剩下一点钱。"}, {"type": "subtitle", "time": 4091.39, "timestamp": "01:08:11", "text": "你知道，我想省点钱。"}, {"type": "subtitle", "time": 4095.47, "timestamp": "01:08:15", "text": "用于应急资金之类的钱"}, {"type": "subtitle", "time": 4098.63, "timestamp": "01:08:18", "text": "但突发情况发生了。那是我的"}, {"type": "subtitle", "time": 4101.99, "timestamp": "01:08:21", "text": "键盘无法使用。"}, {"type": "subtitle", "time": 4104.519, "timestamp": "01:08:24", "text": "嗯。"}, {"type": "subtitle", "time": 4111.11, "timestamp": "01:08:31", "text": "为什么？你知道我是那种人"}, {"type": "subtitle", "time": 4114.9, "timestamp": "01:08:34", "text": "不喜欢买新东西。"}, {"type": "subtitle", "time": 4116.789, "timestamp": "01:08:36", "text": "[音乐]"}, {"type": "subtitle", "time": 4126.309, "timestamp": "01:08:46", "text": "今天我吃了坦都里烤肉。什么"}, {"type": "subtitle", "time": 4130.309, "timestamp": "01:08:50", "text": "你吃了没？啊，今天吃了坦杜里烤肉。"}, {"type": "subtitle", "time": 4134.07, "timestamp": "01:08:54", "text": "我想，这是问候。"}, {"type": "subtitle", "time": 4138.229, "timestamp": "01:08:58", "text": "是牛肉还是拉米？我不知道。"}]
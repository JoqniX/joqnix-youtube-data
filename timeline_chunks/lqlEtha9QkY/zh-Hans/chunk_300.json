[{"type": "subtitle", "time": 18010.31, "timestamp": "05:00:10", "text": "把肉放在数字扫描仪上，这样我们"}, {"type": "subtitle", "time": 18013.67, "timestamp": "05:00:13", "text": "可以做到这件事。"}, {"type": "subtitle", "time": 18017.67, "timestamp": "05:00:17", "text": "那是老鼠肉吗？哦，哇。"}, {"type": "subtitle", "time": 18021.91, "timestamp": "05:00:21", "text": "是的，一种新的汉堡诞生了。什么？"}, {"type": "subtitle", "time": 18023.91, "timestamp": "05:00:23", "text": "什么？你要用……做汉堡"}, {"type": "subtitle", "time": 18025.83, "timestamp": "05:00:25", "text": "那？这些汉堡献给那些"}, {"type": "subtitle", "time": 18030.75, "timestamp": "05:00:30", "text": "需要它们。按下那个按钮。我的天啊。"}, {"type": "subtitle", "time": 18034.91, "timestamp": "05:00:34", "text": "汉堡。亲爱的，你好吗？"}, {"type": "subtitle", "time": 18037.35, "timestamp": "05:00:37", "text": "消极的。首要任务。指示。"}, {"type": "subtitle", "time": 18039.27, "timestamp": "05:00:39", "text": "向马拉万送汉堡。队长"}, {"type": "subtitle", "time": 18041.43, "timestamp": "05:00:41", "text": "阿彻街。"}, {"type": "subtitle", "time": 18044.55, "timestamp": "05:00:44", "text": "什么？现在去追它。"}, {"type": "subtitle", "time": 18046.31, "timestamp": "05:00:46", "text": "我的汉堡机器人正在尝试配送一个"}, {"type": "subtitle", "time": 18048.07, "timestamp": "05:00:48", "text": "给那个叫罗船长的家伙送餐，你当时"}, {"type": "subtitle", "time": 18051.19, "timestamp": "05:00:51", "text": "谈论。什么？你在开玩笑吧。"}, {"type": "subtitle", "time": 18053.03, "timestamp": "05:00:53", "text": "秘藏猎人，跟随机器人。这是"}, {"type": "subtitle", "time": 18055.19, "timestamp": "05:00:55", "text": "我们终于有机会抓住那个马拉万混蛋了。"}]
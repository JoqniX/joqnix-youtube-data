[{"type": "subtitle", "time": 18186.35, "timestamp": "05:03:06", "text": "未来。我是"}, {"type": "subtitle", "time": 18195.868, "timestamp": "05:03:15", "text": "他是在给我什么吗？"}, {"type": "subtitle", "time": 18203.27, "timestamp": "05:03:23", "text": "干得漂亮，把那笔高价值的东西取出来了。"}, {"type": "subtitle", "time": 18205.75, "timestamp": "05:03:25", "text": "目标是秘藏猎人。天哪，这可真不少。"}, {"type": "subtitle", "time": 18207.19, "timestamp": "05:03:27", "text": "覆盖设置需要一些时间。"}, {"type": "subtitle", "time": 18209.35, "timestamp": "05:03:29", "text": "马拉万控制着我的汉堡机器人。"}, {"type": "subtitle", "time": 18210.948, "timestamp": "05:03:30", "text": "这个项目或许应该取消。"}, {"type": "subtitle", "time": 18214.708, "timestamp": "05:03:34", "text": "好了，汉堡再见。与此同时，Vault"}, {"type": "subtitle", "time": 18217.19, "timestamp": "05:03:37", "text": "亨特，你能给劳拉伊送汉堡吗？"}, {"type": "subtitle", "time": 18221.19, "timestamp": "05:03:41", "text": "我？这边还有一只金毛。"}, {"type": "subtitle", "time": 18224.39, "timestamp": "05:03:44", "text": "它去哪儿了？劳拉，我发给你"}, {"type": "subtitle", "time": 18227.35, "timestamp": "05:03:47", "text": "这是众多为您量身定制的汉堡中的第一款。"}, {"type": "subtitle", "time": 18229.83, "timestamp": "05:03:49", "text": "是时候重新编程我的汉堡机器人了。我会"}, {"type": "subtitle", "time": 18232.07, "timestamp": "05:03:52", "text": "继续吃我的汉堡。你可以把它卖给"}, {"type": "subtitle", "time": 18235.99, "timestamp": "05:03:55", "text": "赚钱。很多应用。请继续发送。"}, {"type": "subtitle", "time": 18239.59, "timestamp": "05:03:59", "text": "这里有很多饿着肚子的人。"}]
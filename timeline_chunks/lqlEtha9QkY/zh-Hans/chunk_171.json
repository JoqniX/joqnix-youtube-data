[{"type": "subtitle", "time": 10262.349, "timestamp": "02:51:02", "text": "它。诺格出局。那是他的"}, {"type": "subtitle", "time": 10264.87, "timestamp": "02:51:04", "text": "姓名。不，有问题。我们走吧。车辆是"}, {"type": "subtitle", "time": 10266.75, "timestamp": "02:51:06", "text": "配备"}, {"type": "subtitle", "time": 10270.07, "timestamp": "02:51:10", "text": "特殊的科学桶，它们将发送"}, {"type": "subtitle", "time": 10273.71, "timestamp": "02:51:13", "text": "我通过毁灭逃离，回归自我。"}, {"type": "subtitle", "time": 10276.23, "timestamp": "02:51:16", "text": "我没有的技术"}, {"type": "subtitle", "time": 10285.75, "timestamp": "02:51:25", "text": "这是其中之一。这是一次测试击倒。一个"}, {"type": "subtitle", "time": 10288.35, "timestamp": "02:51:28", "text": "开局不错。收音机。"}, {"type": "subtitle", "time": 10296.95, "timestamp": "02:51:36", "text": "我很好。你好吗？我，我，哦，天哪，我"}, {"type": "subtitle", "time": 10298.95, "timestamp": "02:51:38", "text": "天哪，我后来就没再提这件事了。"}, {"type": "subtitle", "time": 10301.83, "timestamp": "02:51:41", "text": "很多。"}, {"type": "subtitle", "time": 10304.07, "timestamp": "02:51:44", "text": "我一切都好。我也在做"}, {"type": "subtitle", "time": 10307.23, "timestamp": "02:51:47", "text": "好的。确实不错。我"}, {"type": "subtitle", "time": 10310.75, "timestamp": "02:51:50", "text": "我的天哪，我翻身了"}, {"type": "subtitle", "time": 10313.469, "timestamp": "02:51:53", "text": "车辆。"}, {"type": "subtitle", "time": 10318.51, "timestamp": "02:51:58", "text": "科拉。最后一个。我看见你。"}]
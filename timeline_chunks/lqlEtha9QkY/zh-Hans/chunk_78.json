[{"type": "subtitle", "time": 4691.83, "timestamp": "01:18:11", "text": "兄弟？你知道吗？"}, {"type": "subtitle", "time": 4711.229, "timestamp": "01:18:31", "text": "电话。你好。是的，我听说了。"}, {"type": "subtitle", "time": 4720.709, "timestamp": "01:18:40", "text": "他们能看到你。等待。哦，等等。 Discord"}, {"type": "subtitle", "time": 4722.47, "timestamp": "01:18:42", "text": "回来了。"}, {"type": "subtitle", "time": 4725.59, "timestamp": "01:18:45", "text": "等等，它正在重新启动。他们能听到"}, {"type": "subtitle", "time": 4729.43, "timestamp": "01:18:49", "text": "现在请你离开我的麦克风。"}, {"type": "subtitle", "time": 4734.709, "timestamp": "01:18:54", "text": "你好。"}, {"type": "subtitle", "time": 4737.59, "timestamp": "01:18:57", "text": "感谢您今天的款待。"}]
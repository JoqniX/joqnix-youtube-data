[{"type": "subtitle", "time": 1800.87, "timestamp": "00:30:00", "text": "决定玩什么游戏。我从未"}, {"type": "subtitle", "time": 1803.389, "timestamp": "00:30:03", "text": "我觉得是疼痛。"}, {"type": "subtitle", "time": 1806.389, "timestamp": "00:30:06", "text": "一部分原因是因为这东西是我唯一拥有的东西。"}, {"type": "subtitle", "time": 1809.59, "timestamp": "00:30:09", "text": "他能做的就是玩游戏。我想做冷凝"}, {"type": "subtitle", "time": 1812.47, "timestamp": "00:30:12", "text": "合作类型，但我很困惑，到底是什么？"}, {"type": "subtitle", "time": 1815.59, "timestamp": "00:30:15", "text": "我会以什么形式合作，我会创作什么内容？"}, {"type": "subtitle", "time": 1818.389, "timestamp": "00:30:18", "text": "当我看到其他创作者时，就会产生共鸣。"}, {"type": "subtitle", "time": 1821.389, "timestamp": "00:30:21", "text": "甚至同龄人和朋友"}, {"type": "subtitle", "time": 1825.47, "timestamp": "00:30:25", "text": "制作优质原创作品的人"}, {"type": "subtitle", "time": 1828.95, "timestamp": "00:30:28", "text": "内容方面，直播中会添加新的叠加层等等。我是"}, {"type": "subtitle", "time": 1830.19, "timestamp": "00:30:30", "text": "喜欢，"}, {"type": "subtitle", "time": 1833.99, "timestamp": "00:30:33", "text": "哇。不是嫉妒，更像是我也想要"}, {"type": "subtitle", "time": 1836.83, "timestamp": "00:30:36", "text": "这样做。为什么我如此像"}, {"type": "subtitle", "time": 1840.95, "timestamp": "00:30:40", "text": "不切实际？并非不切实际。嗯，更多"}, {"type": "subtitle", "time": 1842.59, "timestamp": "00:30:42", "text": "喜欢"}, {"type": "subtitle", "time": 1853.99, "timestamp": "00:30:53", "text": "理想主义者，或者缺乏创造力。它"}, {"type": "subtitle", "time": 1855.87, "timestamp": "00:30:55", "text": "可能会影响到你。"}, {"type": "subtitle", "time": 1859.71, "timestamp": "00:30:59", "text": "不，有时候涉及到体重问题。"}]
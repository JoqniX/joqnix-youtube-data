[{"type": "subtitle", "time": 2101.069, "timestamp": "00:35:01", "text": "我想联系人们"}, {"type": "subtitle", "time": 2104.31, "timestamp": "00:35:04", "text": "但并非每个人都很忙。哦，等等，你是"}, {"type": "chat", "time": 2106.01, "timestamp": "00:35:06", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "YO YO"}, {"type": "chat", "time": 2107.781, "timestamp": "00:35:07", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Astra Vt~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 2111.43, "timestamp": "00:35:11", "text": "第二节你好。"}, {"type": "subtitle", "time": 2116.51, "timestamp": "00:35:16", "text": "你好。你好。我吓坏了。我的天啊。你好。"}, {"type": "subtitle", "time": 2124.31, "timestamp": "00:35:24", "text": "你好。我是在开玩笑。我的天啊。你好。什么？"}, {"type": "subtitle", "time": 2126.28, "timestamp": "00:35:26", "text": "你怎么了？"}, {"type": "subtitle", "time": 2127.51, "timestamp": "00:35:27", "text": "[音乐]"}, {"type": "subtitle", "time": 2129.99, "timestamp": "00:35:29", "text": "4小时。"}, {"type": "subtitle", "time": 2133.15, "timestamp": "00:35:33", "text": "也许是因为现在是晚上。"}, {"type": "subtitle", "time": 2136.15, "timestamp": "00:35:36", "text": "午夜。不，不。我刚才在想……"}, {"type": "subtitle", "time": 2139.31, "timestamp": "00:35:39", "text": "我当时想到一个问题。"}, {"type": "subtitle", "time": 2142.39, "timestamp": "00:35:42", "text": "比如说，假设有一位观众……"}, {"type": "subtitle", "time": 2145.349, "timestamp": "00:35:45", "text": "有志成为 YouTuber。他们想要他们"}, {"type": "subtitle", "time": 2148.15, "timestamp": "00:35:48", "text": "明天他们开始带我去玩水上滑板了。"}, {"type": "subtitle", "time": 2151.03, "timestamp": "00:35:51", "text": "或者诸如此类的问题，然后他们会提出疑问。"}, {"type": "subtitle", "time": 2154.15, "timestamp": "00:35:54", "text": "会问你是否愿意合作或喜欢"}, {"type": "subtitle", "time": 2157.51, "timestamp": "00:35:57", "text": "如果他们开始的话，就和他们一起玩。"}, {"type": "subtitle", "time": 2159.79, "timestamp": "00:35:59", "text": "然后我就开始用流媒体这种方式做其他事情了。"}]
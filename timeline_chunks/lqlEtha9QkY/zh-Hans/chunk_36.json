[{"type": "subtitle", "time": 2163.03, "timestamp": "00:36:03", "text": "这明明是个很简单的问题，但我"}, {"type": "subtitle", "time": 2165.349, "timestamp": "00:36:05", "text": "就像那样进行头脑风暴。"}, {"type": "subtitle", "time": 2167.589, "timestamp": "00:36:07", "text": "我好像朝三个方向走了一圈。"}, {"type": "subtitle", "time": 2171.349, "timestamp": "00:36:11", "text": "我会坦白地说，我不会，我不会"}, {"type": "chat", "time": 2172.527, "timestamp": "00:36:12", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "WASSUP"}, {"type": "subtitle", "time": 2174.71, "timestamp": "00:36:14", "text": "直接邀请他们合作"}, {"type": "subtitle", "time": 2177.23, "timestamp": "00:36:17", "text": "我立刻"}, {"type": "subtitle", "time": 2181.589, "timestamp": "00:36:21", "text": "不，抱歉，我需要去……"}, {"type": "subtitle", "time": 2184.23, "timestamp": "00:36:24", "text": "认识你。我需要画个背景。"}, {"type": "subtitle", "time": 2187.51, "timestamp": "00:36:27", "text": "检查一下我们是否真的喜欢这种氛围"}, {"type": "subtitle", "time": 2191.43, "timestamp": "00:36:31", "text": "匹配在一起。是的，"}, {"type": "subtitle", "time": 2193.43, "timestamp": "00:36:33", "text": "它包含很多层面，"}, {"type": "subtitle", "time": 2195.75, "timestamp": "00:36:35", "text": "我通常通过以下方式决定与谁合作："}, {"type": "subtitle", "time": 2197.589, "timestamp": "00:36:37", "text": "氛围。"}, {"type": "subtitle", "time": 2202.71, "timestamp": "00:36:42", "text": "是的。如果我，你知道，就像那样"}, {"type": "subtitle", "time": 2205.51, "timestamp": "00:36:45", "text": "有些人非常健谈。"}, {"type": "subtitle", "time": 2207.67, "timestamp": "00:36:47", "text": "有些人非常"}, {"type": "subtitle", "time": 2211.27, "timestamp": "00:36:51", "text": "低能耗。这取决于你的状态。"}, {"type": "subtitle", "time": 2214.63, "timestamp": "00:36:54", "text": "能够一起完成一项任务。在我的"}, {"type": "subtitle", "time": 2217.49, "timestamp": "00:36:57", "text": "我就是这样判断的。"}, {"type": "subtitle", "time": 2219.829, "timestamp": "00:36:59", "text": "[音乐]"}]
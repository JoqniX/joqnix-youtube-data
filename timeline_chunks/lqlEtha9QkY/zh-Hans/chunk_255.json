[{"type": "subtitle", "time": 15302.469, "timestamp": "04:15:02", "text": "杂货店。我们以为我们是gners。"}, {"type": "subtitle", "time": 15305.75, "timestamp": "04:15:05", "text": "这一球打得好远。劳拉说："}, {"type": "subtitle", "time": 15308.469, "timestamp": "04:15:08", "text": "你觉得你进入炸药行业会怎么样？"}, {"type": "subtitle", "time": 15310.87, "timestamp": "04:15:10", "text": "于是，我做了几个炸弹。有点像"}, {"type": "subtitle", "time": 15314.389, "timestamp": "04:15:14", "text": "烘焙嘛，大概就是更凌乱一点儿吧。所以现在"}, {"type": "subtitle", "time": 15316.87, "timestamp": "04:15:16", "text": "我是一名炸弹制造者。那你就是四个了。"}, {"type": "subtitle", "time": 15346.95, "timestamp": "04:15:46", "text": "顶部还有一个台风箱。需要"}, {"type": "subtitle", "time": 15347.95, "timestamp": "04:15:47", "text": "要得到"}, {"type": "subtitle", "time": 15352.71, "timestamp": "04:15:52", "text": "还有这一点。杀了它们。但"}]
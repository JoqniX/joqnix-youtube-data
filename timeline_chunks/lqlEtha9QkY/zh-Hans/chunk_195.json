[{"type": "subtitle", "time": 11702.79, "timestamp": "03:15:02", "text": "事情掌握在我自己手中。我们开始吧"}, {"type": "subtitle", "time": 11728.0, "timestamp": "03:15:28", "text": "实际上，我确实会下毒。"}, {"type": "subtitle", "time": 11749.11, "timestamp": "03:15:49", "text": "我为什么要射杀自己的士兵？它是"}, {"type": "subtitle", "time": 11751.99, "timestamp": "03:15:51", "text": "这看起来很像啊。哦，一个"}, {"type": "subtitle", "time": 11754.15, "timestamp": "03:15:54", "text": "蓝色的。"}, {"type": "subtitle", "time": 11757.19, "timestamp": "03:15:57", "text": "谢谢。你可以靠这个赚钱。"}]
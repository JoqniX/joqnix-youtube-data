[{"type": "subtitle", "time": 20161.548, "timestamp": "05:36:01", "text": "哦"}, {"type": "subtitle", "time": 20178.548, "timestamp": "05:36:18", "text": "去。他们摧毁了大量的"}, {"type": "subtitle", "time": 20193.59, "timestamp": "05:36:33", "text": "混乱。我接受。非常感谢"}, {"type": "subtitle", "time": 20205.83, "timestamp": "05:36:45", "text": "他死了。我的天哪。那是他的吗？"}]
[{"type": "subtitle", "time": 7264.669, "timestamp": "02:01:04", "text": "[音乐]"}, {"type": "subtitle", "time": 7271.669, "timestamp": "02:01:11", "text": "嗯，确实如此。我懂了。我看到了不完全的"}, {"type": "subtitle", "time": 7282.55, "timestamp": "02:01:22", "text": "你。它在哪里？所以，我需要找到一个"}, {"type": "subtitle", "time": 7284.87, "timestamp": "02:01:24", "text": "角色卡，然后把它交给那个孩子。"}, {"type": "subtitle", "time": 7286.709, "timestamp": "02:01:26", "text": "那边那个被他训斥的人"}, {"type": "subtitle", "time": 7290.87, "timestamp": "02:01:30", "text": "老师或妈妈。那我需要帮忙。"}, {"type": "subtitle", "time": 7293.629, "timestamp": "02:01:33", "text": "呃，还有谁？我"}, {"type": "subtitle", "time": 7296.709, "timestamp": "02:01:36", "text": "忘了。他喝醉了。我们需要"}, {"type": "subtitle", "time": 7312.35, "timestamp": "02:01:52", "text": "是的。是的。你读太多这类文章了。"}, {"type": "subtitle", "time": 7315.99, "timestamp": "02:01:55", "text": "事物。她打电话来了。我不太爱读书。"}]
[{"type": "subtitle", "time": 5115.99, "timestamp": "01:25:15", "text": "离开。哦，快下车。下车。好的。哦，我的天"}, {"type": "subtitle", "time": 5118.03, "timestamp": "01:25:18", "text": "上帝。几乎"}, {"type": "subtitle", "time": 5121.99, "timestamp": "01:25:21", "text": "死了。不要破坏套装。哦，等等。为什么是"}, {"type": "subtitle", "time": 5123.75, "timestamp": "01:25:23", "text": "这部电影呢？我以为它会……"}, {"type": "subtitle", "time": 5126.75, "timestamp": "01:25:26", "text": "与音乐有关。"}, {"type": "subtitle", "time": 5129.43, "timestamp": "01:25:29", "text": "我确实看了我的第一个视频。"}, {"type": "subtitle", "time": 5131.79, "timestamp": "01:25:31", "text": "年。"}, {"type": "subtitle", "time": 5134.75, "timestamp": "01:25:34", "text": "哦，做"}, {"type": "subtitle", "time": 5138.149, "timestamp": "01:25:38", "text": "你是大学生吧？是的。做"}, {"type": "subtitle", "time": 5154.03, "timestamp": "01:25:54", "text": "给定？是否已给出"}, {"type": "subtitle", "time": 5157.07, "timestamp": "01:25:57", "text": "电影？天哪，我哭着想"}]
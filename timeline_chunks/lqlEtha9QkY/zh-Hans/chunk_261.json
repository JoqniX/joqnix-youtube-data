[{"type": "subtitle", "time": 15666.11, "timestamp": "04:21:06", "text": "[音乐]"}, {"type": "subtitle", "time": 15680.149, "timestamp": "04:21:20", "text": "然后我们起床，回去。我的阴暗面"}, {"type": "subtitle", "time": 15682.87, "timestamp": "04:21:22", "text": "那些日子里，我总是饿得前胸贴后背。我恳求道，"}, {"type": "subtitle", "time": 15685.11, "timestamp": "04:21:25", "text": "借了，还偷了，就为了吃点东西。"}, {"type": "subtitle", "time": 15687.59, "timestamp": "04:21:27", "text": "有些夜晚，我饿得醒了过来。"}, {"type": "subtitle", "time": 15689.59, "timestamp": "04:21:29", "text": "我正在吃我的"}, {"type": "subtitle", "time": 15692.389, "timestamp": "04:21:32", "text": "总之，有一次我看到一些脏兮兮的孩子。"}, {"type": "subtitle", "time": 15694.63, "timestamp": "04:21:34", "text": "为了一个酸黄瓜而大打出手。我告诉他们"}, {"type": "subtitle", "time": 15697.11, "timestamp": "04:21:37", "text": "讲了个故事，他们给了我一口。直到"}, {"type": "subtitle", "time": 15699.189, "timestamp": "04:21:39", "text": "我找到了金库，我是这么表达的。"}, {"type": "subtitle", "time": 15701.67, "timestamp": "04:21:41", "text": "桌上摆着牧场沙拉酱。讲述故事"}, {"type": "subtitle", "time": 15703.91, "timestamp": "04:21:43", "text": "我在潘多拉星球上的冒险经历。怎么样？"}]
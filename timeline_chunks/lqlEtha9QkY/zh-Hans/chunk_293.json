[{"type": "subtitle", "time": 17580.788, "timestamp": "04:53:00", "text": "现在。好了。然后切换到游戏"}, {"type": "subtitle", "time": 17585.11, "timestamp": "04:53:05", "text": "我们可以回去。嗨，我们走吧。哦，我"}, {"type": "subtitle", "time": 17586.75, "timestamp": "04:53:06", "text": "忘了呃"}, {"type": "subtitle", "time": 17590.628, "timestamp": "04:53:10", "text": "东西。忘了说“等等”。我当时"}, {"type": "subtitle", "time": 17593.11, "timestamp": "04:53:13", "text": "正在玩 Rash Clash。别担心，我"}, {"type": "subtitle", "time": 17596.628, "timestamp": "04:53:16", "text": "作为一名……，我肩负着职责。"}, {"type": "subtitle", "time": 17599.75, "timestamp": "04:53:19", "text": "呃，玩家。我玩了一会儿部落冲突。"}, {"type": "subtitle", "time": 17603.03, "timestamp": "04:53:23", "text": "因为我不得不这么做。一"}, {"type": "subtitle", "time": 17606.43, "timestamp": "04:53:26", "text": "第二节呃，你在哪里？"}, {"type": "subtitle", "time": 17609.83, "timestamp": "04:53:29", "text": "关闭日出功能。好的，我们应该"}, {"type": "subtitle", "time": 17612.51, "timestamp": "04:53:32", "text": "后退。好的，我们应该"}, {"type": "subtitle", "time": 17616.15, "timestamp": "04:53:36", "text": "后退。大家好，我们回来了。所以，呃，我有一些聊天记录"}, {"type": "subtitle", "time": 17620.15, "timestamp": "04:53:40", "text": "错过了。呃，等等。所以，我错过了"}, {"type": "subtitle", "time": 17624.788, "timestamp": "04:53:44", "text": "来自 Ugabasan 的聊天记录，对吧？所以，所以"}, {"type": "subtitle", "time": 17625.628, "timestamp": "04:53:45", "text": "等待。"}, {"type": "subtitle", "time": 17628.23, "timestamp": "04:53:48", "text": "呃，真可惜，我喜欢Moxy。她的方式"}, {"type": "subtitle", "time": 17630.35, "timestamp": "04:53:50", "text": "谈吐方面，她是我比较喜欢的那种女人。"}, {"type": "subtitle", "time": 17633.948, "timestamp": "04:53:53", "text": "喜欢。但她却说，她带着"}, {"type": "subtitle", "time": 17636.628, "timestamp": "04:53:56", "text": "粉色的。我对此很感兴趣。而且，她"}, {"type": "subtitle", "time": 17639.51, "timestamp": "04:53:59", "text": "Suga说道，我喜欢别人这样称呼我。一个"}]
[{"type": "subtitle", "time": 14947.269, "timestamp": "04:09:07", "text": "好的。"}, {"type": "subtitle", "time": 14950.15, "timestamp": "04:09:10", "text": "回来。抓住她。我会给你"}, {"type": "subtitle", "time": 14961.23, "timestamp": "04:09:21", "text": "凶杀枪击案。"}, {"type": "subtitle", "time": 14966.51, "timestamp": "04:09:26", "text": "看来莫西的船员们"}, {"type": "subtitle", "time": 14969.269, "timestamp": "04:09:29", "text": "如果你赢了，那就是真的。哎呀，这可真难。"}, {"type": "subtitle", "time": 14971.99, "timestamp": "04:09:31", "text": "子弹射中你了。别担心，我有个……"}, {"type": "subtitle", "time": 14975.269, "timestamp": "04:09:35", "text": "一对。"}, {"type": "subtitle", "time": 14979.11, "timestamp": "04:09:39", "text": "为什么要谈论霰弹枪？"}, {"type": "subtitle", "time": 14981.269, "timestamp": "04:09:41", "text": "因为我有一把金色的霰弹枪。他们"}, {"type": "subtitle", "time": 14984.95, "timestamp": "04:09:44", "text": "他是在嘲笑我吗？"}, {"type": "subtitle", "time": 14987.51, "timestamp": "04:09:47", "text": "你竟敢如此？我要用……杀了你"}]
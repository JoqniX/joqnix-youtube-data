[{"type": "subtitle", "time": 13980.15, "timestamp": "03:53:00", "text": "你看，肿瘤头的视力糟透了。"}, {"type": "subtitle", "time": 13981.91, "timestamp": "03:53:01", "text": "我猜是关于肿瘤的描述。"}, {"type": "subtitle", "time": 13983.99, "timestamp": "03:53:03", "text": "或许我们可以骗过她。回头见！"}, {"type": "subtitle", "time": 13986.07, "timestamp": "03:53:06", "text": "藏身之处。"}, {"type": "subtitle", "time": 13988.15, "timestamp": "03:53:08", "text": "好的。嘿，别为此感到难过"}, {"type": "subtitle", "time": 13990.63, "timestamp": "03:53:10", "text": "血光闪耀。这两个人坠入爱河"}, {"type": "subtitle", "time": 13992.67, "timestamp": "03:53:12", "text": "杀害无辜平民。他们是"}, {"type": "subtitle", "time": 13996.309, "timestamp": "03:53:16", "text": "怪物。而且，公开场合亲热很恶心。我是说，"}, {"type": "subtitle", "time": 13998.71, "timestamp": "03:53:18", "text": "说真的，成熟点吧。没人想看"}, {"type": "subtitle", "time": 14000.63, "timestamp": "03:53:20", "text": "那。"}, {"type": "subtitle", "time": 14004.55, "timestamp": "03:53:24", "text": "你好。那么，我们走吧。"}, {"type": "subtitle", "time": 14006.429, "timestamp": "03:53:26", "text": "[音乐]"}, {"type": "subtitle", "time": 14009.51, "timestamp": "03:53:29", "text": "血光闪闪，宝贝。"}, {"type": "subtitle", "time": 14014.309, "timestamp": "03:53:34", "text": "我的天，她真是个变态。是的。再见。"}, {"type": "subtitle", "time": 14015.75, "timestamp": "03:53:35", "text": "请进。"}, {"type": "subtitle", "time": 14017.59, "timestamp": "03:53:37", "text": "好了，现在把血光面具戴在一个"}, {"type": "subtitle", "time": 14019.59, "timestamp": "03:53:39", "text": "门口的尸体。那"}, {"type": "subtitle", "time": 14020.71, "timestamp": "03:53:40", "text": "应该足以骗过他们了"}, {"type": "subtitle", "time": 14023.91, "timestamp": "03:53:43", "text": "让你进来。没什么事。我希望"}, {"type": "subtitle", "time": 14025.99, "timestamp": "03:53:45", "text": "你在床上和你在床上一样放荡不羁"}, {"type": "subtitle", "time": 14032.79, "timestamp": "03:53:52", "text": "你最终会得到他的，只是不是……"}, {"type": "subtitle", "time": 14035.83, "timestamp": "03:53:55", "text": "他的想法。"}]
[{"type": "subtitle", "time": 9482.87, "timestamp": "02:38:02", "text": "我必须妥善完成的一切"}, {"type": "subtitle", "time": 9487.349, "timestamp": "02:38:07", "text": "没错。你必须这样做。"}, {"type": "subtitle", "time": 9489.79, "timestamp": "02:38:09", "text": "我知道我们有很多"}, {"type": "subtitle", "time": 9494.07, "timestamp": "02:38:14", "text": "我们有很多合作项目，而且"}, {"type": "subtitle", "time": 9495.91, "timestamp": "02:38:15", "text": "本月计划推出大量内容"}, {"type": "subtitle", "time": 9497.23, "timestamp": "02:38:17", "text": "但是也"}, {"type": "subtitle", "time": 9500.51, "timestamp": "02:38:20", "text": "是啊，我得接听替补电话。"}, {"type": "subtitle", "time": 9502.67, "timestamp": "02:38:22", "text": "一切。"}, {"type": "subtitle", "time": 9505.83, "timestamp": "02:38:25", "text": "但问题是我们从来没有真正地……"}, {"type": "subtitle", "time": 9509.03, "timestamp": "02:38:29", "text": "完全完成了子通话，我"}, {"type": "subtitle", "time": 9512.11, "timestamp": "02:38:32", "text": "开始这次垃圾马拉松时，我缺乏……"}, {"type": "subtitle", "time": 9515.27, "timestamp": "02:38:35", "text": "因为我发烧了，所以提前准备了一下。"}, {"type": "subtitle", "time": 9518.15, "timestamp": "02:38:38", "text": "这原本就是一个紧急病例。"}, {"type": "subtitle", "time": 9529.309, "timestamp": "02:38:49", "text": "呃，但不管是什么子程序，呃，我这事儿"}, {"type": "subtitle", "time": 9532.95, "timestamp": "02:38:52", "text": "最终确定后，我将采取……采取"}, {"type": "subtitle", "time": 9536.11, "timestamp": "02:38:56", "text": "统计所有捐款人的人数"}]
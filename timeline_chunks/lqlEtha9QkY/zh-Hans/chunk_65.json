[{"type": "subtitle", "time": 3905.349, "timestamp": "01:05:05", "text": "啊，感觉怎么样？我不知道。我睡得很香"}, {"type": "subtitle", "time": 3909.51, "timestamp": "01:05:09", "text": "今天走了很多路，但我仍然很困。"}, {"type": "subtitle", "time": 3913.349, "timestamp": "01:05:13", "text": "我没有。我的铁含量通常如下："}, {"type": "subtitle", "time": 3916.39, "timestamp": "01:05:16", "text": "每个月有几次水位会降得很低，"}, {"type": "subtitle", "time": 3920.069, "timestamp": "01:05:20", "text": "我睡得像熊一样香甜。我告诉了我的医生"}, {"type": "subtitle", "time": 3921.99, "timestamp": "01:05:21", "text": "关于这件事，他们说：“你"}, {"type": "subtitle", "time": 3932.67, "timestamp": "01:05:32", "text": "我能做的最好的事就是喜欢"}, {"type": "subtitle", "time": 3935.109, "timestamp": "01:05:35", "text": "锻炼。”你不锻炼，但是"}, {"type": "subtitle", "time": 3938.63, "timestamp": "01:05:38", "text": "你还是那么瘦。"}, {"type": "subtitle", "time": 3941.19, "timestamp": "01:05:41", "text": "是的，你不吃饭。"}, {"type": "subtitle", "time": 3944.549, "timestamp": "01:05:44", "text": "但我确实会吃饭。我不知道。你吃得真多"}, {"type": "subtitle", "time": 3947.75, "timestamp": "01:05:47", "text": "不过少一些。是的。如果你是"}, {"type": "subtitle", "time": 3949.309, "timestamp": "01:05:49", "text": "流媒体"}, {"type": "subtitle", "time": 3952.47, "timestamp": "01:05:52", "text": "可能你吃得很少。"}, {"type": "subtitle", "time": 3954.549, "timestamp": "01:05:54", "text": "都可以，对吧？"}, {"type": "subtitle", "time": 3957.75, "timestamp": "01:05:57", "text": "就这么明显吗？哦，是的，我很多。"}]
[{"type": "subtitle", "time": 17640.99, "timestamp": "04:54:00", "text": "可爱"}, {"type": "subtitle", "time": 17648.15, "timestamp": "04:54:08", "text": "等等，不对。等等，等等，他真的是"}, {"type": "subtitle", "time": 17649.948, "timestamp": "04:54:09", "text": "游戏中。"}, {"type": "subtitle", "time": 17658.55, "timestamp": "04:54:18", "text": "尽管？零在哪里？等等，是零。"}, {"type": "subtitle", "time": 17660.868, "timestamp": "04:54:20", "text": "我们走吧。他就是那个家伙，这个"}, {"type": "subtitle", "time": 17662.788, "timestamp": "04:54:22", "text": "特点。"}, {"type": "subtitle", "time": 17665.03, "timestamp": "04:54:25", "text": "是的。你好。"}, {"type": "subtitle", "time": 17668.07, "timestamp": "04:54:28", "text": "所以，游戏里没有这个功能。呃，文字"}, {"type": "subtitle", "time": 17670.11, "timestamp": "04:54:30", "text": "悲伤地聊天。那么，让我来解释一下。"}, {"type": "subtitle", "time": 17673.99, "timestamp": "04:54:33", "text": "我的天哪，我希望你们能听到"}, {"type": "subtitle", "time": 17674.75, "timestamp": "04:54:34", "text": "这"}, {"type": "subtitle", "time": 17682.75, "timestamp": "04:54:42", "text": "哦，等等。有文字聊天功能。哦，是的。"}, {"type": "subtitle", "time": 17686.19, "timestamp": "04:54:46", "text": "你好。我不知道这里有文字。"}, {"type": "subtitle", "time": 17688.99, "timestamp": "04:54:48", "text": "聊天。"}, {"type": "subtitle", "time": 17690.83, "timestamp": "04:54:50", "text": "哇。"}, {"type": "subtitle", "time": 17694.23, "timestamp": "04:54:54", "text": "该死。欢迎大家回来。欢迎"}, {"type": "subtitle", "time": 17697.11, "timestamp": "04:54:57", "text": "后退。戴好口罩。欢迎回来。欢迎"}]
[{"type": "subtitle", "time": 13929.91, "timestamp": "03:52:09", "text": "你被金库窃贼抓住了。血光并非"}, {"type": "subtitle", "time": 13932.229, "timestamp": "03:52:12", "text": "不是秘藏猎人爱好者。我要"}, {"type": "subtitle", "time": 13936.39, "timestamp": "03:52:16", "text": "向您提供泰恩河畔的服务。"}, {"type": "subtitle", "time": 13939.83, "timestamp": "03:52:19", "text": "[音乐]"}, {"type": "subtitle", "time": 13948.71, "timestamp": "03:52:28", "text": "等等，她要攻击我了。什么？"}, {"type": "subtitle", "time": 13951.03, "timestamp": "03:52:31", "text": "你找到我婴儿的血迹了吗？光"}, {"type": "subtitle", "time": 13954.51, "timestamp": "03:52:34", "text": "我生命中的一部分。我的眼睛里长了肿瘤。哦，她"}, {"type": "subtitle", "time": 13959.389, "timestamp": "03:52:39", "text": "死了。哦不，她去世了。是的。她的心是"}, {"type": "subtitle", "time": 13964.15, "timestamp": "03:52:44", "text": "都是你的。哦，不。"}, {"type": "subtitle", "time": 13966.469, "timestamp": "03:52:46", "text": "把她带回我家。哦，不。然后"}, {"type": "subtitle", "time": 13969.51, "timestamp": "03:52:49", "text": "我们将交换囚犯。她死了吗？如果"}, {"type": "subtitle", "time": 13970.71, "timestamp": "03:52:50", "text": "肿瘤头发现你杀了人"}, {"type": "subtitle", "time": 13973.429, "timestamp": "03:52:53", "text": "血光啊，我完蛋了。但我有一个"}, {"type": "subtitle", "time": 13977.67, "timestamp": "03:52:57", "text": "主意。抢走她的面具。好的。"}]
[{"type": "subtitle", "time": 14170.469, "timestamp": "03:56:10", "text": "她忙得不可开交。好的"}, {"type": "subtitle", "time": 14172.95, "timestamp": "03:56:12", "text": "武器。好的。"}, {"type": "subtitle", "time": 14180.229, "timestamp": "03:56:20", "text": "婴儿。哦，宝贝。好的。"}, {"type": "subtitle", "time": 14190.63, "timestamp": "03:56:30", "text": "不，等等，让我把它杀掉。"}, {"type": "subtitle", "time": 14201.83, "timestamp": "03:56:41", "text": "我真的把事情搞得一团糟。"}, {"type": "subtitle", "time": 14205.51, "timestamp": "03:56:45", "text": "进去让我看看你的本事。"}, {"type": "subtitle", "time": 14207.99, "timestamp": "03:56:47", "text": "谢谢。现在那个肿瘤头"}, {"type": "subtitle", "time": 14211.429, "timestamp": "03:56:51", "text": "疯子死了，快带我离开这里。"}]
[{"type": "subtitle", "time": 11580.63, "timestamp": "03:13:00", "text": "理解。请冷静下来。是的，你"}, {"type": "subtitle", "time": 11598.79, "timestamp": "03:13:18", "text": "[音乐]"}, {"type": "subtitle", "time": 11602.19, "timestamp": "03:13:22", "text": "你好。是的，只是去喝杯咖啡。全部"}, {"type": "subtitle", "time": 11605.91, "timestamp": "03:13:25", "text": "就为了喝杯咖啡，竟然要执行这么多任务。"}, {"type": "subtitle", "time": 11612.95, "timestamp": "03:13:32", "text": "好了。"}, {"type": "subtitle", "time": 11617.95, "timestamp": "03:13:37", "text": "你是我最爱的人。这真是太"}, {"type": "subtitle", "time": 11621.59, "timestamp": "03:13:41", "text": "必要的。嘿，阿特拉斯的伙计们。崛起"}, {"type": "subtitle", "time": 11623.59, "timestamp": "03:13:43", "text": "Grimes重返商界，"}, {"type": "subtitle", "time": 11627.349, "timestamp": "03:13:47", "text": "咖啡我请客。哦，当然！为了"}, {"type": "subtitle", "time": 11629.83, "timestamp": "03:13:49", "text": "真实的？谢谢你，劳拉。哦，他是她"}, {"type": "subtitle", "time": 11631.309, "timestamp": "03:13:51", "text": "治疗"}, {"type": "subtitle", "time": 11635.67, "timestamp": "03:13:55", "text": "每个人。我永远不会放弃追求它。"}, {"type": "subtitle", "time": 11639.19, "timestamp": "03:13:59", "text": "啊，胡扯。马拉万在这里。快点"}]
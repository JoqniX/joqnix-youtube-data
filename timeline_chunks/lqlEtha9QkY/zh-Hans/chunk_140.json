[{"type": "subtitle", "time": 8400.19, "timestamp": "02:20:00", "text": "呃，我不见了"}, {"type": "subtitle", "time": 8425.83, "timestamp": "02:20:25", "text": "肉看起来像校车司机，而且是"}, {"type": "subtitle", "time": 8445.75, "timestamp": "02:20:45", "text": "或许我需要取得一些进展。你知道吗？"}, {"type": "subtitle", "time": 8447.55, "timestamp": "02:20:47", "text": "我们还会再来这里。"}, {"type": "subtitle", "time": 8451.11, "timestamp": "02:20:51", "text": "又来了，对吧？去俱乐部。"}, {"type": "subtitle", "time": 8453.91, "timestamp": "02:20:53", "text": "你知道吗？那就这么做吧。至少"}, {"type": "subtitle", "time": 8454.83, "timestamp": "02:20:54", "text": "为了"}, {"type": "subtitle", "time": 8458.19, "timestamp": "02:20:58", "text": "现在。寻找"}]
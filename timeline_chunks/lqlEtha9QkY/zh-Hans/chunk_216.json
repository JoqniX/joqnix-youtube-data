[{"type": "subtitle", "time": 12967.75, "timestamp": "03:36:07", "text": "你明白了吗？这个破败不堪的家伙"}, {"type": "subtitle", "time": 12971.11, "timestamp": "03:36:11", "text": "而且孤身一人。我可能正在被击垮，但是"}, {"type": "subtitle", "time": 12972.75, "timestamp": "03:36:12", "text": "至少我是"}, {"type": "subtitle", "time": 12981.429, "timestamp": "03:36:21", "text": "谐振器。现在，我只使用"}, {"type": "subtitle", "time": 12984.389, "timestamp": "03:36:24", "text": "自动手枪，无限枪，就是这样"}, {"type": "subtitle", "time": 12993.51, "timestamp": "03:36:33", "text": "武器。但是这把枪已经结束了。"}, {"type": "subtitle", "time": 12994.99, "timestamp": "03:36:34", "text": "低功率"}, {"type": "subtitle", "time": 12998.309, "timestamp": "03:36:38", "text": "令人遗憾。还我健康。给我"}, {"type": "subtitle", "time": 13004.389, "timestamp": "03:36:44", "text": "[音乐]"}]
[{"type": "subtitle", "time": 1080.23, "timestamp": "00:18:00", "text": "互联网上有社交观众和"}, {"type": "subtitle", "time": 1082.669, "timestamp": "00:18:02", "text": "一切。不，"}, {"type": "subtitle", "time": 1085.35, "timestamp": "00:18:05", "text": "像……是的，不同的人有"}, {"type": "subtitle", "time": 1088.35, "timestamp": "00:18:08", "text": "它们各自不同的东西"}, {"type": "subtitle", "time": 1091.43, "timestamp": "00:18:11", "text": "一切。我不知道。我的意思是，我"}, {"type": "subtitle", "time": 1093.23, "timestamp": "00:18:13", "text": "不"}, {"type": "subtitle", "time": 1096.63, "timestamp": "00:18:16", "text": "头脑。我不介意。只是我"}, {"type": "subtitle", "time": 1098.39, "timestamp": "00:18:18", "text": "我对视频聊天之类的都没什么意见，我"}, {"type": "subtitle", "time": 1101.59, "timestamp": "00:18:21", "text": "美好的。但如果你像这样，呃，"}, {"type": "subtitle", "time": 1103.35, "timestamp": "00:18:23", "text": "是的，我要和Jock合作。"}, {"type": "subtitle", "time": 1106.789, "timestamp": "00:18:26", "text": "影响力之类的，我得……呃……"}, {"type": "subtitle", "time": 1109.27, "timestamp": "00:18:29", "text": "我说对不起，我觉得我没有"}, {"type": "subtitle", "time": 1112.35, "timestamp": "00:18:32", "text": "首先，他根本没有任何影响力。我是一名"}, {"type": "subtitle", "time": 1116.71, "timestamp": "00:18:36", "text": "没有人。所以，是的，如果你希望"}, {"type": "subtitle", "time": 1121.11, "timestamp": "00:18:41", "text": "呃，如果真是那样的话，那就不是了。"}, {"type": "subtitle", "time": 1124.23, "timestamp": "00:18:44", "text": "我不记得是谁说过这句话了。"}, {"type": "subtitle", "time": 1126.95, "timestamp": "00:18:46", "text": "但后来，当我跟……交谈时，我就像……"}, {"type": "subtitle", "time": 1130.15, "timestamp": "00:18:50", "text": "我当时就想，是啊，笨蛋，你觉得呢？"}, {"type": "subtitle", "time": 1137.95, "timestamp": "00:18:57", "text": "地点对我来说无关紧要"}]
[{"type": "subtitle", "time": 13621.75, "timestamp": "03:47:01", "text": "等待。你好。我放你出去。这是垃圾。"}, {"type": "subtitle", "time": 13624.71, "timestamp": "03:47:04", "text": "山。你只需要交换"}, {"type": "subtitle", "time": 13627.51, "timestamp": "03:47:07", "text": "这艘船的尖端在我的蘸酱中，有一个"}, {"type": "subtitle", "time": 13630.229, "timestamp": "03:47:10", "text": "对法律的解释要宽松一些。就像"}, {"type": "subtitle", "time": 13632.95, "timestamp": "03:47:12", "text": "脏拷贝。他们总是骚扰我"}, {"type": "subtitle", "time": 13635.03, "timestamp": "03:47:15", "text": "船员收受贿赂。我的船员会帮助你。"}, {"type": "subtitle", "time": 13637.11, "timestamp": "03:47:17", "text": "放我离开这里。去找他们。去"}, {"type": "subtitle", "time": 13639.83, "timestamp": "03:47:19", "text": "找到他们。好的，明白了。"}, {"type": "subtitle", "time": 13645.99, "timestamp": "03:47:25", "text": "我不付钱。对着垃圾嘴说话"}, {"type": "subtitle", "time": 13674.15, "timestamp": "03:47:54", "text": "好的。哦，这或许就是我的方式"}, {"type": "subtitle", "time": 13676.07, "timestamp": "03:47:56", "text": "你的领导人简直深陷泥潭。告诉我"}, {"type": "subtitle", "time": 13678.429, "timestamp": "03:47:58", "text": "找到你。满嘴脏话可不是……"}]
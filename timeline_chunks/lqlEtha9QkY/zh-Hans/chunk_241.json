[{"type": "subtitle", "time": 14461.03, "timestamp": "04:01:01", "text": "我。这些是其他的保险库。"}, {"type": "subtitle", "time": 14463.51, "timestamp": "04:01:03", "text": "我们可以扮演猎人，也就是可操控角色。"}, {"type": "subtitle", "time": 14475.67, "timestamp": "04:01:15", "text": "破坏。破坏。我假设那是一个"}, {"type": "subtitle", "time": 14479.189, "timestamp": "04:01:19", "text": "用于效果的类。在我的"}, {"type": "subtitle", "time": 14488.429, "timestamp": "04:01:28", "text": "我的天哪。那可是个大问题"}, {"type": "subtitle", "time": 14491.83, "timestamp": "04:01:31", "text": "男生。你知道吗？让我们使用新的"}, {"type": "subtitle", "time": 14492.83, "timestamp": "04:01:32", "text": "枪。"}, {"type": "subtitle", "time": 14495.51, "timestamp": "04:01:35", "text": "其实我想用霰弹枪。出色地"}, {"type": "subtitle", "time": 14499.349, "timestamp": "04:01:39", "text": "换掉那个，我们就用狙击手。"}, {"type": "subtitle", "time": 14502.389, "timestamp": "04:01:42", "text": "如果从这个角度来看，那真的太低了。"}, {"type": "subtitle", "time": 14503.61, "timestamp": "04:01:43", "text": "既然如此，那我就……"}, {"type": "subtitle", "time": 14509.229, "timestamp": "04:01:49", "text": "[音乐]"}]
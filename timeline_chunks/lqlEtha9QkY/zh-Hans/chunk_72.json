[{"type": "subtitle", "time": 4322.87, "timestamp": "01:12:02", "text": "是的，"}, {"type": "subtitle", "time": 4326.87, "timestamp": "01:12:06", "text": "开玩笑。我听不到您的声音。什么？"}, {"type": "subtitle", "time": 4329.03, "timestamp": "01:12:09", "text": "我好一阵子都没听清你说话。"}, {"type": "subtitle", "time": 4331.87, "timestamp": "01:12:11", "text": "片刻。什么？"}, {"type": "subtitle", "time": 4334.709, "timestamp": "01:12:14", "text": "嗯？呃，没有。等等，你能够"}, {"type": "subtitle", "time": 4339.27, "timestamp": "01:12:19", "text": "现在能听到我说话吗？是的。欢迎。好的。"}, {"type": "subtitle", "time": 4342.63, "timestamp": "01:12:22", "text": "你被剪掉了哪一部分？"}, {"type": "subtitle", "time": 4345.63, "timestamp": "01:12:25", "text": "当你谈到你的呃"}, {"type": "subtitle", "time": 4348.229, "timestamp": "01:12:28", "text": "酪乳。啊，是的。所以，你是吗？"}, {"type": "subtitle", "time": 4350.51, "timestamp": "01:12:30", "text": "谈论"}, {"type": "subtitle", "time": 4353.75, "timestamp": "01:12:33", "text": "阿穆尔？我不知道。它只是一个"}, {"type": "subtitle", "time": 4355.83, "timestamp": "01:12:35", "text": "酪乳加一点点"}, {"type": "subtitle", "time": 4357.99, "timestamp": "01:12:37", "text": "香料。"}, {"type": "subtitle", "time": 4360.39, "timestamp": "01:12:40", "text": "我不太喜欢酪乳，除非"}, {"type": "subtitle", "time": 4363.91, "timestamp": "01:12:43", "text": "都是新鲜制作的。"}, {"type": "subtitle", "time": 4367.03, "timestamp": "01:12:47", "text": "是的。黄油味道不错。哦，是的。"}, {"type": "subtitle", "time": 4370.55, "timestamp": "01:12:50", "text": "确实如此。于是，我查了一下。"}, {"type": "subtitle", "time": 4373.03, "timestamp": "01:12:53", "text": "显然，它是像粉末一样加工的。"}, {"type": "subtitle", "time": 4376.149, "timestamp": "01:12:56", "text": "在日本形成。"}]
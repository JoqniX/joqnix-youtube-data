[{"type": "subtitle", "time": 14231.91, "timestamp": "03:57:11", "text": "什么？哦，我不得不拍下来。好的，我"}, {"type": "subtitle", "time": 14234.07, "timestamp": "03:57:14", "text": "出去。是时候告诉你我的全部"}, {"type": "subtitle", "time": 14237.91, "timestamp": "03:57:17", "text": "现在的名字是片川。片川。我的"}, {"type": "subtitle", "time": 14239.59, "timestamp": "03:57:19", "text": "我那混蛋哥哥把我所有兄弟姐妹都搞上了。"}, {"type": "subtitle", "time": 14242.15, "timestamp": "03:57:22", "text": "被泰恩·卡利普索谋杀。我是唯一"}, {"type": "subtitle", "time": 14243.75, "timestamp": "03:57:23", "text": "还剩一个。"}, {"type": "subtitle", "time": 14246.75, "timestamp": "03:57:26", "text": "等等，这样你就知道我不是我自己了。"}, {"type": "subtitle", "time": 14250.389, "timestamp": "03:57:30", "text": "哥哥，但他肯定想要我。"}, {"type": "subtitle", "time": 14252.07, "timestamp": "03:57:32", "text": "我刚意识到我哥哥的所作所为，"}, {"type": "subtitle", "time": 14253.79, "timestamp": "03:57:33", "text": "我当时正在做我试图消失的事情"}, {"type": "subtitle", "time": 14256.15, "timestamp": "03:57:36", "text": "普罗米修斯，一个死去的阿特拉斯士兵，"}, {"type": "subtitle", "time": 14258.389, "timestamp": "03:57:38", "text": "偷了他的装备。然后我就被抓住了"}, {"type": "subtitle", "time": 14260.229, "timestamp": "03:57:40", "text": "一氧化碳。"}, {"type": "subtitle", "time": 14262.389, "timestamp": "03:57:42", "text": "我得消失一段时间。最多"}, {"type": "subtitle", "time": 14263.75, "timestamp": "03:57:43", "text": "这附近的人会杀了我的。"}, {"type": "subtitle", "time": 14266.87, "timestamp": "03:57:46", "text": "我的姓氏。我的天哪。看看我哥哥"}, {"type": "subtitle", "time": 14268.79, "timestamp": "03:57:48", "text": "一枪崩了那个混蛋的脑袋"}, {"type": "subtitle", "time": 14271.83, "timestamp": "03:57:51", "text": "我。我会这么做。而肿瘤头偷走了"}, {"type": "subtitle", "time": 14273.99, "timestamp": "03:57:53", "text": "我的家族传家宝。我不想要它"}, {"type": "subtitle", "time": 14275.429, "timestamp": "03:57:55", "text": "一切都是你的错，所以现在都是你的责任了。"}, {"type": "subtitle", "time": 14277.75, "timestamp": "03:57:57", "text": "猎人。无意冒犯，但我希望我永远不会"}]
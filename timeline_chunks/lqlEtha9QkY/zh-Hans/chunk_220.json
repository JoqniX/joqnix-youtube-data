[{"type": "subtitle", "time": 13202.15, "timestamp": "03:40:02", "text": "我的天啊。他刚才是用高尔夫球杆打的吗？"}, {"type": "subtitle", "time": 13204.429, "timestamp": "03:40:04", "text": "不，那个"}, {"type": "subtitle", "time": 13207.269, "timestamp": "03:40:07", "text": "东西。你就去打高尔夫吧。你是"}, {"type": "subtitle", "time": 13209.349, "timestamp": "03:40:09", "text": "真是全力以赴啊？所有这些"}, {"type": "subtitle", "time": 13211.309, "timestamp": "03:40:11", "text": "参赛者们"}, {"type": "subtitle", "time": 13215.67, "timestamp": "03:40:15", "text": "垂死。我喜欢它。你 他显然"}, {"type": "subtitle", "time": 13217.67, "timestamp": "03:40:17", "text": "弥补某些不足。我知道"}, {"type": "subtitle", "time": 13231.349, "timestamp": "03:40:31", "text": "好的。呃，走隐藏路线。证明"}, {"type": "subtitle", "time": 13232.75, "timestamp": "03:40:32", "text": "妻子。"}, {"type": "subtitle", "time": 13235.75, "timestamp": "03:40:35", "text": "好的。我们会这么做，而且会立即行动。"}, {"type": "subtitle", "time": 13239.75, "timestamp": "03:40:39", "text": "欢迎您再次光临。疼痛。呃，我需要"}]
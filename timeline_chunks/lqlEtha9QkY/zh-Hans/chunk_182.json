[{"type": "subtitle", "time": 10921.269, "timestamp": "03:02:01", "text": "没有什么。他们看起来好可爱。"}, {"type": "subtitle", "time": 10922.91, "timestamp": "03:02:02", "text": "它有"}, {"type": "subtitle", "time": 10936.389, "timestamp": "03:02:16", "text": "玛雅。将电源线插入……"}, {"type": "subtitle", "time": 10937.95, "timestamp": "03:02:17", "text": "在这个地方，"}, {"type": "subtitle", "time": 10943.469, "timestamp": "03:02:23", "text": "正确的？所以，我应该把它插在哪里呢？"}, {"type": "subtitle", "time": 10946.269, "timestamp": "03:02:26", "text": "它？该把他干掉了。"}, {"type": "subtitle", "time": 10949.349, "timestamp": "03:02:29", "text": "是的，这里没有米饭和研磨机。"}, {"type": "subtitle", "time": 10966.389, "timestamp": "03:02:46", "text": "向上。好的，我们继续。呃，哪里"}, {"type": "subtitle", "time": 10968.19, "timestamp": "03:02:48", "text": "是"}, {"type": "subtitle", "time": 10970.67, "timestamp": "03:02:50", "text": "我们？是的。你好，"}, {"type": "subtitle", "time": 10977.59, "timestamp": "03:02:57", "text": "欢迎。希望你一切都好。哦，"}]
[{"type": "subtitle", "time": 12420.15, "timestamp": "03:27:00", "text": "收购要约？说实话，我们已经"}, {"type": "subtitle", "time": 12422.79, "timestamp": "03:27:02", "text": "收到了一些相当激进的报价。"}, {"type": "subtitle", "time": 12424.55, "timestamp": "03:27:04", "text": "来自某些传统武器品牌，但是"}, {"type": "subtitle", "time": 12427.429, "timestamp": "03:27:07", "text": "我不卖。 Atlas 是一个独立的"}, {"type": "subtitle", "time": 12430.469, "timestamp": "03:27:10", "text": "品牌。情况会一直这样下去。"}, {"type": "subtitle", "time": 12432.95, "timestamp": "03:27:12", "text": "只要我还活着。"}, {"type": "subtitle", "time": 12434.63, "timestamp": "03:27:14", "text": "我为什么这么说？你可以把那部分剪掉。"}, {"type": "subtitle", "time": 12437.83, "timestamp": "03:27:17", "text": "正确的。正确的。它还活着。啊，杰瑞，为什么？"}, {"type": "subtitle", "time": 12441.03, "timestamp": "03:27:21", "text": "你总是安排这些吗？"}, {"type": "subtitle", "time": 12466.71, "timestamp": "03:27:46", "text": "他在哪里？"}, {"type": "subtitle", "time": 12475.51, "timestamp": "03:27:55", "text": "不要开启我开启的任务。"}]
[{"type": "subtitle", "time": 14527.51, "timestamp": "04:02:07", "text": "把人工智能接回来，然后把新的人工智能接入到这个系统中。"}, {"type": "subtitle", "time": 14534.229, "timestamp": "04:02:14", "text": "这是正确的。放我出去。是"}, {"type": "subtitle", "time": 14536.07, "timestamp": "04:02:16", "text": "哦，还有个盾牌。那是"}, {"type": "subtitle", "time": 14540.91, "timestamp": "04:02:20", "text": "好的。这是什么？非法"}, {"type": "subtitle", "time": 14543.99, "timestamp": "04:02:23", "text": "火器。公民，你想退出吗？它是"}, {"type": "subtitle", "time": 14546.95, "timestamp": "04:02:26", "text": "成本将会很高。哇。我不会付钱给你"}, {"type": "subtitle", "time": 14549.75, "timestamp": "04:02:29", "text": "糟糕。行动。这就是我给你的全部了。"}, {"type": "subtitle", "time": 14552.55, "timestamp": "04:02:32", "text": "现在。"}, {"type": "subtitle", "time": 14554.15, "timestamp": "04:02:34", "text": "好的。"}, {"type": "subtitle", "time": 14556.429, "timestamp": "04:02:36", "text": "向下"}, {"type": "subtitle", "time": 14564.55, "timestamp": "04:02:44", "text": "真是精彩的演出。 Foxy 的船员们确实很了解情况。"}, {"type": "subtitle", "time": 14567.99, "timestamp": "04:02:47", "text": "如何让男生觉得自己很特别。"}, {"type": "subtitle", "time": 14569.99, "timestamp": "04:02:49", "text": "获胜者可以向我展示他们自己的"}, {"type": "subtitle", "time": 14572.55, "timestamp": "04:02:52", "text": "脸。"}, {"type": "subtitle", "time": 14573.91, "timestamp": "04:02:53", "text": "趁你们打架的时候，我弄到了一台"}, {"type": "subtitle", "time": 14576.07, "timestamp": "04:02:56", "text": "主意。废物管理机器人是"}, {"type": "subtitle", "time": 14578.15, "timestamp": "04:02:58", "text": "在普罗米修斯机器人食物链中处于最底层。"}]
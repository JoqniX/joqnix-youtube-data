[{"type": "subtitle", "time": 18243.15, "timestamp": "05:04:03", "text": "286. 那可是钱啊。"}, {"type": "subtitle", "time": 18246.51, "timestamp": "05:04:06", "text": "等待。所以我应该扔"}, {"type": "subtitle", "time": 18260.07, "timestamp": "05:04:20", "text": "干掉船长，干得漂亮！"}, {"type": "subtitle", "time": 18262.55, "timestamp": "05:04:22", "text": "机器人猎人。那个抢汉堡的混蛋"}, {"type": "subtitle", "time": 18264.868, "timestamp": "05:04:24", "text": "简直是我的眼中钉。但"}, {"type": "subtitle", "time": 18267.83, "timestamp": "05:04:27", "text": "他现在已经死了。做得非常好。"}, {"type": "subtitle", "time": 18269.91, "timestamp": "05:04:29", "text": "先是咖啡，现在又是汉堡。这"}, {"type": "subtitle", "time": 18272.708, "timestamp": "05:04:32", "text": "文明的基石。一块一块"}, {"type": "subtitle", "time": 18274.07, "timestamp": "05:04:34", "text": "这篇文章，我们真的开始认真对待了。"}, {"type": "subtitle", "time": 18275.91, "timestamp": "05:04:35", "text": "城市重新凝聚。谢谢你"}]
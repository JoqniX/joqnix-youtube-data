[{"type": "subtitle", "time": 13505.83, "timestamp": "03:45:05", "text": "地方？而且也没有自行车之类的东西。"}, {"type": "subtitle", "time": 13509.15, "timestamp": "03:45:09", "text": "等等，等等，那里"}, {"type": "subtitle", "time": 13511.309, "timestamp": "03:45:11", "text": "等等，还有"}, {"type": "subtitle", "time": 13518.15, "timestamp": "03:45:18", "text": "等待。我可以买辆自行车吗？"}, {"type": "subtitle", "time": 13521.269, "timestamp": "03:45:21", "text": "你知道，就像那样？不，我不能。哦"}, {"type": "subtitle", "time": 13524.95, "timestamp": "03:45:24", "text": "我的上帝。我必须全程步行。哦"}, {"type": "subtitle", "time": 13527.389, "timestamp": "03:45:27", "text": "上帝，"}, {"type": "subtitle", "time": 13529.91, "timestamp": "03:45:29", "text": "不。哦，又一个支线任务结束了。"}, {"type": "subtitle", "time": 13532.03, "timestamp": "03:45:32", "text": "[音乐]"}, {"type": "subtitle", "time": 13534.87, "timestamp": "03:45:34", "text": "这里。我的天哪。这张地图将是"}, {"type": "subtitle", "time": 13536.389, "timestamp": "03:45:36", "text": "难的。"}, {"type": "subtitle", "time": 13538.309, "timestamp": "03:45:38", "text": "我正在消费。我没办法速通这个关卡。"}, {"type": "subtitle", "time": 13547.71, "timestamp": "03:45:47", "text": "美好的。所以，我们就到这里来。我们努力达到"}, {"type": "subtitle", "time": 13550.469, "timestamp": "03:45:50", "text": "那边的支线任务。我们收集"}]
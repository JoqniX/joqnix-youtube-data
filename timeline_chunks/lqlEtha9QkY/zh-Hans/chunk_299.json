[{"type": "subtitle", "time": 17942.868, "timestamp": "04:59:02", "text": "姐妹。战斗远未结束。"}, {"type": "subtitle", "time": 17946.23, "timestamp": "04:59:06", "text": "现在，先来捏碎一些拉查。这"}, {"type": "subtitle", "time": 17949.11, "timestamp": "04:59:09", "text": "我在这款游戏中需要的一种武器是弓。"}, {"type": "subtitle", "time": 17954.628, "timestamp": "04:59:14", "text": "砰。"}, {"type": "subtitle", "time": 17956.31, "timestamp": "04:59:16", "text": "我不知道这里面有没有弓。"}, {"type": "subtitle", "time": 17960.788, "timestamp": "04:59:20", "text": "游戏虽然有奖，但我会很感激你的鞠躬。"}, {"type": "subtitle", "time": 17964.23, "timestamp": "04:59:24", "text": "再见，新冠病毒宣传。你好，深红"}, {"type": "subtitle", "time": 17967.11, "timestamp": "04:59:27", "text": "宣传。"}, {"type": "subtitle", "time": 17982.788, "timestamp": "04:59:42", "text": "好了。现在抓住那令人作呕的东西"}, {"type": "subtitle", "time": 17985.91, "timestamp": "04:59:45", "text": "美味的肉。"}]
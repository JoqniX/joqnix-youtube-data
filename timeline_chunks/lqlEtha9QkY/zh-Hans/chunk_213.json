[{"type": "subtitle", "time": 12781.269, "timestamp": "03:33:01", "text": "严重地。前往她的藏身之处。"}, {"type": "subtitle", "time": 12807.19, "timestamp": "03:33:27", "text": "蛞蝓之神。所以这是一套女性的……呃……套装"}, {"type": "subtitle", "time": 12817.91, "timestamp": "03:33:37", "text": "他正在监视我们。"}, {"type": "subtitle", "time": 12821.389, "timestamp": "03:33:41", "text": "我的天哪。他绝对是"}, {"type": "subtitle", "time": 12823.99, "timestamp": "03:33:43", "text": "正在观看。我的天哪。所以，等等。是什么？"}, {"type": "subtitle", "time": 12826.71, "timestamp": "03:33:46", "text": "又是支线任务？前往藏身处，"}, {"type": "subtitle", "time": 12829.59, "timestamp": "03:33:49", "text": "肯尼斯。好的，我们去做任务。他"}, {"type": "subtitle", "time": 12831.429, "timestamp": "03:33:51", "text": "开始大量倾倒电池酸液"}, {"type": "subtitle", "time": 12834.269, "timestamp": "03:33:54", "text": "向上。我得想办法抑制他的这种情绪。"}, {"type": "subtitle", "time": 12837.67, "timestamp": "03:33:57", "text": "充电，这给了我一个启发。带来"}]
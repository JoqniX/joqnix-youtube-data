[{"type": "subtitle", "time": 20403.35, "timestamp": "05:40:03", "text": "Athenas. This is Captain again. Uh"}, {"type": "subtitle", "time": 20405.59, "timestamp": "05:40:05", "text": "losing my freaking patience, so I'll"}, {"type": "subtitle", "time": 20409.27, "timestamp": "05:40:09", "text": "take this as politely as I can. Please"}, {"type": "subtitle", "time": 20412.07, "timestamp": "05:40:12", "text": "consider surrendering while we trample"}, {"type": "subtitle", "time": 20414.708, "timestamp": "05:40:14", "text": "your treasured heritage just cuz uh"}, {"type": "subtitle", "time": 20425.35, "timestamp": "05:40:25", "text": "All right, Ava, where is it?"}, {"type": "subtitle", "time": 20427.51, "timestamp": "05:40:27", "text": "Tickling the old ivories. You wouldn't"}, {"type": "subtitle", "time": 20429.91, "timestamp": "05:40:29", "text": "think our clamps are"}, {"type": "subtitle", "time": 20435.83, "timestamp": "05:40:35", "text": "and they aren't that harmonizing module."}, {"type": "subtitle", "time": 20437.75, "timestamp": "05:40:37", "text": "Someone won't have an excuse to misarry"}]
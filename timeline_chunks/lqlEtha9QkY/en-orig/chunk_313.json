[{"type": "subtitle", "time": 18792.628, "timestamp": "05:13:12", "text": "You will do no such thing. You hear me?"}, {"type": "subtitle", "time": 18802.708, "timestamp": "05:13:22", "text": "Appreciate it. Glad to be appreciated."}, {"type": "subtitle", "time": 18806.55, "timestamp": "05:13:26", "text": "Bye. London, I suppose. I don't want to"}, {"type": "subtitle", "time": 18808.788, "timestamp": "05:13:28", "text": "press Q because that I will lose all of"}, {"type": "subtitle", "time": 18812.23, "timestamp": "05:13:32", "text": "my money. How sweet."}, {"type": "subtitle", "time": 18814.788, "timestamp": "05:13:34", "text": "So, I'll do by 100 by 100. Hey, I'll"}, {"type": "subtitle", "time": 18818.35, "timestamp": "05:13:38", "text": "take it. Oh, Moxy, send your"}, {"type": "subtitle", "time": 18829.19, "timestamp": "05:13:49", "text": "mail. How to check mail?"}, {"type": "subtitle", "time": 18835.64, "timestamp": "05:13:55", "text": "forgot. How do I check the mail?"}, {"type": "subtitle", "time": 18838.15, "timestamp": "05:13:58", "text": "[Music]"}]
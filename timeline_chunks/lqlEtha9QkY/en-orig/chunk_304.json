[{"type": "subtitle", "time": 18243.15, "timestamp": "05:04:03", "text": "286. That's money."}, {"type": "subtitle", "time": 18246.51, "timestamp": "05:04:06", "text": "Wait. So I should throw"}, {"type": "subtitle", "time": 18260.07, "timestamp": "05:04:20", "text": "Proper kudos for taking out Captain"}, {"type": "subtitle", "time": 18262.55, "timestamp": "05:04:22", "text": "Robot Hunter. That burger grabbing prick"}, {"type": "subtitle", "time": 18264.868, "timestamp": "05:04:24", "text": "has been a right thorn in my ass. But"}, {"type": "subtitle", "time": 18267.83, "timestamp": "05:04:27", "text": "now he's dead. Well done indeed."}, {"type": "subtitle", "time": 18269.91, "timestamp": "05:04:29", "text": "First coffee, now burgers. The"}, {"type": "subtitle", "time": 18272.708, "timestamp": "05:04:32", "text": "cornerstones of civilization. Piece by"}, {"type": "subtitle", "time": 18274.07, "timestamp": "05:04:34", "text": "piece, we're really starting to put this"}, {"type": "subtitle", "time": 18275.91, "timestamp": "05:04:35", "text": "city back together. Thanks for your"}]
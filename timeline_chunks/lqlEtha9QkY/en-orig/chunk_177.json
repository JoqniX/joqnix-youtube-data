[{"type": "subtitle", "time": 10621.11, "timestamp": "02:57:01", "text": "No fancy gimmicks this time. Okay, now"}, {"type": "subtitle", "time": 10623.91, "timestamp": "02:57:03", "text": "call the last one. Oh boy, you got to"}, {"type": "subtitle", "time": 10627.349, "timestamp": "02:57:07", "text": "make this right. The green."}, {"type": "subtitle", "time": 10632.95, "timestamp": "02:57:12", "text": "I shall call him Nagador Maximal. No"}, {"type": "subtitle", "time": 10635.51, "timestamp": "02:57:15", "text": "maximal. We don't lose this one, too."}, {"type": "subtitle", "time": 10637.83, "timestamp": "02:57:17", "text": "Checking systems."}, {"type": "subtitle", "time": 10640.15, "timestamp": "02:57:20", "text": "[Music]"}, {"type": "subtitle", "time": 10642.63, "timestamp": "02:57:22", "text": "The hacking worked perfectly this time."}, {"type": "subtitle", "time": 10651.51, "timestamp": "02:57:31", "text": "Just in time, too. That's the proximity"}, {"type": "subtitle", "time": 10654.55, "timestamp": "02:57:34", "text": "alarm. Malawan is coming after me again."}, {"type": "subtitle", "time": 10656.23, "timestamp": "02:57:36", "text": "Hold them off while I send the weapon"}, {"type": "subtitle", "time": 10658.429, "timestamp": "02:57:38", "text": "plans to Laura."}, {"type": "subtitle", "time": 10660.87, "timestamp": "02:57:40", "text": "Laura, I'm sending you the digest"}, {"type": "subtitle", "time": 10663.51, "timestamp": "02:57:43", "text": "blueprints now. They're coming. Good to"}, {"type": "subtitle", "time": 10666.55, "timestamp": "02:57:46", "text": "hear from you. I see the data coming in."}, {"type": "subtitle", "time": 10667.87, "timestamp": "02:57:47", "text": "We got to fight"}]
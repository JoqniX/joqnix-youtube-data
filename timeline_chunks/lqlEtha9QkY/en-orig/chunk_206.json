[{"type": "subtitle", "time": 12376.229, "timestamp": "03:26:16", "text": "I'm Shannon Kyrie and this is your"}, {"type": "subtitle", "time": 12378.469, "timestamp": "03:26:18", "text": "morning meridian. We're here this"}, {"type": "subtitle", "time": 12382.87, "timestamp": "03:26:22", "text": "morning with Reese. What is that thing?"}, {"type": "subtitle", "time": 12385.75, "timestamp": "03:26:25", "text": "Is he doing a donut? What the heck? to"}, {"type": "subtitle", "time": 12388.55, "timestamp": "03:26:28", "text": "be here. Shannon, NPC doing a donut."}, {"type": "subtitle", "time": 12390.55, "timestamp": "03:26:30", "text": "Hello. Back into the galactic market."}, {"type": "subtitle", "time": 12392.309, "timestamp": "03:26:32", "text": "You've done something many would have"}, {"type": "subtitle", "time": 12394.95, "timestamp": "03:26:34", "text": "thought impossible only a decade ago."}, {"type": "subtitle", "time": 12397.51, "timestamp": "03:26:37", "text": "What's the secret to your success?"}, {"type": "subtitle", "time": 12399.14, "timestamp": "03:26:39", "text": "Secret alien technology."}, {"type": "subtitle", "time": 12401.79, "timestamp": "03:26:41", "text": "[Laughter]"}, {"type": "subtitle", "time": 12404.63, "timestamp": "03:26:44", "text": "Shanning. Atlas is thriving because"}, {"type": "subtitle", "time": 12406.95, "timestamp": "03:26:46", "text": "we've taken it in a new direction. I"}, {"type": "subtitle", "time": 12408.63, "timestamp": "03:26:48", "text": "believe a company should lift its"}, {"type": "subtitle", "time": 12410.55, "timestamp": "03:26:50", "text": "employees on its shoulders, not the"}, {"type": "subtitle", "time": 12412.83, "timestamp": "03:26:52", "text": "other way around. And what about your"}, {"type": "subtitle", "time": 12415.429, "timestamp": "03:26:55", "text": "competition? Atlas has been attracting a"}, {"type": "subtitle", "time": 12417.59, "timestamp": "03:26:57", "text": "lot of attention. Have you had any"}]
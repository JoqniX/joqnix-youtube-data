[{"type": "subtitle", "time": 18010.31, "timestamp": "05:00:10", "text": "Put the meat on the digit scanner so we"}, {"type": "subtitle", "time": 18013.67, "timestamp": "05:00:13", "text": "can do this thing."}, {"type": "subtitle", "time": 18017.67, "timestamp": "05:00:17", "text": "Is that rat meat? Oh, wow."}, {"type": "subtitle", "time": 18021.91, "timestamp": "05:00:21", "text": "Yes, a new burger is born. What the"}, {"type": "subtitle", "time": 18023.91, "timestamp": "05:00:23", "text": "heck? You going to make burger out of"}, {"type": "subtitle", "time": 18025.83, "timestamp": "05:00:25", "text": "that? These burgers to the people who"}, {"type": "subtitle", "time": 18030.75, "timestamp": "05:00:30", "text": "need them. Hit that button. Oh my god."}, {"type": "subtitle", "time": 18034.91, "timestamp": "05:00:34", "text": "Burger. What up, my dear?"}, {"type": "subtitle", "time": 18037.35, "timestamp": "05:00:37", "text": "Negative. Priority one. Directive."}, {"type": "subtitle", "time": 18039.27, "timestamp": "05:00:39", "text": "Deliver burgers to Malawan. Captain"}, {"type": "subtitle", "time": 18041.43, "timestamp": "05:00:41", "text": "Archer Row."}, {"type": "subtitle", "time": 18044.55, "timestamp": "05:00:44", "text": "What? Now chase after it."}, {"type": "subtitle", "time": 18046.31, "timestamp": "05:00:46", "text": "My burger bot is trying to deliver a"}, {"type": "subtitle", "time": 18048.07, "timestamp": "05:00:48", "text": "meal to that Captain Row guy you were"}, {"type": "subtitle", "time": 18051.19, "timestamp": "05:00:51", "text": "talking about. What? You're joking."}, {"type": "subtitle", "time": 18053.03, "timestamp": "05:00:53", "text": "Vault Hunter, follow the bot. This is"}, {"type": "subtitle", "time": 18055.19, "timestamp": "05:00:55", "text": "our chance to get that Malawan bastard."}]
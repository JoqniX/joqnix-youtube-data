[{"type": "subtitle", "time": 15666.11, "timestamp": "04:21:06", "text": "[Music]"}, {"type": "subtitle", "time": 15680.149, "timestamp": "04:21:20", "text": "And we get up and get back. My dark side"}, {"type": "subtitle", "time": 15682.87, "timestamp": "04:21:22", "text": "days, I was always starving. I begged,"}, {"type": "subtitle", "time": 15685.11, "timestamp": "04:21:25", "text": "borrowed, and stole for a bite to eat."}, {"type": "subtitle", "time": 15687.59, "timestamp": "04:21:27", "text": "Some nights, I was so hungry, I woke up."}, {"type": "subtitle", "time": 15689.59, "timestamp": "04:21:29", "text": "I was eating my"}, {"type": "subtitle", "time": 15692.389, "timestamp": "04:21:32", "text": "Anyway, once I saw some grubby kids"}, {"type": "subtitle", "time": 15694.63, "timestamp": "04:21:34", "text": "fighting over a pickle. I told them a"}, {"type": "subtitle", "time": 15697.11, "timestamp": "04:21:37", "text": "story and they gave me a bite. And until"}, {"type": "subtitle", "time": 15699.189, "timestamp": "04:21:39", "text": "I found the vault, that was how I put"}, {"type": "subtitle", "time": 15701.67, "timestamp": "04:21:41", "text": "ranch on the table. Telling stories of"}, {"type": "subtitle", "time": 15703.91, "timestamp": "04:21:43", "text": "my adventures on Pandora. How about"}]
[{"type": "subtitle", "time": 7540.229, "timestamp": "02:05:40", "text": "ああ、彼女は本当に素晴らしい。真実、"}, {"type": "subtitle", "time": 7543.83, "timestamp": "02:05:43", "text": "本当だ、本当だ、本当だ。それは本当です。"}, {"type": "subtitle", "time": 7546.03, "timestamp": "02:05:46", "text": "私は彼をからかうのが好きだ"}, {"type": "subtitle", "time": 7549.669, "timestamp": "02:05:49", "text": "彼を怒らせるのが怖いけど"}, {"type": "subtitle", "time": 7552.55, "timestamp": "02:05:52", "text": "やりすぎると、私は"}, {"type": "subtitle", "time": 7553.709, "timestamp": "02:05:53", "text": "行く"}, {"type": "subtitle", "time": 7558.55, "timestamp": "02:05:58", "text": "多くの。ああ、彼女は守らなければならない。"}]
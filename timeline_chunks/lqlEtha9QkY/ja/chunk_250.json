[{"type": "subtitle", "time": 15000.63, "timestamp": "04:10:00", "text": "誰が投げたんだ？誰がこれを投げたんだ？誰が"}, {"type": "subtitle", "time": 15002.51, "timestamp": "04:10:02", "text": "それを投げた"}, {"type": "subtitle", "time": 15027.59, "timestamp": "04:10:27", "text": "チャンスを逃してしまった。元気です。"}, {"type": "subtitle", "time": 15031.03, "timestamp": "04:10:31", "text": "いい投げ方だったね。私の"}, {"type": "subtitle", "time": 15034.03, "timestamp": "04:10:34", "text": "本。"}, {"type": "subtitle", "time": 15040.95, "timestamp": "04:10:40", "text": "新しい参加者たちはジップラインに挑戦しました"}, {"type": "subtitle", "time": 15044.63, "timestamp": "04:10:44", "text": "まっすぐに私の心に響いた。みんなに拍手を！"}, {"type": "subtitle", "time": 15047.349, "timestamp": "04:10:47", "text": "沼地の惑星エデンからの道。"}, {"type": "subtitle", "time": 15048.87, "timestamp": "04:10:48", "text": "あのね？スラムアタックを仕掛ける"}]
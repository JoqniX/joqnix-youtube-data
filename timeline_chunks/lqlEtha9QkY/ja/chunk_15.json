[{"type": "subtitle", "time": 901.069, "timestamp": "00:15:01", "text": "それ？うん"}, {"type": "subtitle", "time": 904.35, "timestamp": "00:15:04", "text": "なぜなら、"}, {"type": "subtitle", "time": 908.71, "timestamp": "00:15:08", "text": "時々私はこんな風に感じる"}, {"type": "subtitle", "time": 910.87, "timestamp": "00:15:10", "text": "ええと、YouTubeの世界では"}, {"type": "subtitle", "time": 912.79, "timestamp": "00:15:12", "text": "世界の性質 YouTubeでその言葉"}, {"type": "subtitle", "time": 917.67, "timestamp": "00:15:17", "text": "コラボレーションは、さまざまな方法で見ることができます。"}, {"type": "subtitle", "time": 920.949, "timestamp": "00:15:20", "text": "一つはただのたまり場や友達同士の集まりとして"}, {"type": "subtitle", "time": 924.47, "timestamp": "00:15:24", "text": "リラックスするなどとは、友達を作ることであり、"}, {"type": "subtitle", "time": 928.47, "timestamp": "00:15:28", "text": "また、両方をマージすると、"}, {"type": "subtitle", "time": 930.71, "timestamp": "00:15:30", "text": "素晴らしい。コラボレーションに近いですよね？のように"}, {"type": "subtitle", "time": 933.269, "timestamp": "00:15:33", "text": "コラボレーション。それで、両方のストリーマーは、"}, {"type": "subtitle", "time": 936.31, "timestamp": "00:15:36", "text": "観客は互いを見つめ合うだろう"}, {"type": "subtitle", "time": 938.75, "timestamp": "00:15:38", "text": "お互いを支え合うことができるなど"}, {"type": "subtitle", "time": 943.67, "timestamp": "00:15:43", "text": "などなど。ああ、でも問題は、"}, {"type": "subtitle", "time": 947.23, "timestamp": "00:15:47", "text": "そうなると私は"}, {"type": "subtitle", "time": 950.47, "timestamp": "00:15:50", "text": "私がそれに夢中になりすぎているからでしょうか"}, {"type": "subtitle", "time": 953.47, "timestamp": "00:15:53", "text": "気付きすぎ"}, {"type": "subtitle", "time": 955.99, "timestamp": "00:15:55", "text": "その他のTwitterユーチューバーの騒動と"}, {"type": "subtitle", "time": 957.749, "timestamp": "00:15:57", "text": "私が考えていることすべて"}, {"type": "subtitle", "time": 959.35, "timestamp": "00:15:59", "text": "このようにインクを過剰に使用してください。わからないけど"}]
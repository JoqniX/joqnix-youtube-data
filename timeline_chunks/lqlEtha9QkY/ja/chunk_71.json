[{"type": "subtitle", "time": 4261.189, "timestamp": "01:11:01", "text": "日本で。"}, {"type": "subtitle", "time": 4263.47, "timestamp": "01:11:03", "text": "わかった。いいえ。"}, {"type": "subtitle", "time": 4267.669, "timestamp": "01:11:07", "text": "お母さんとお父さんに手伝ってもらうよう頼んでみて"}, {"type": "subtitle", "time": 4270.39, "timestamp": "01:11:10", "text": "香辛料をいくつか詰めてください。"}, {"type": "subtitle", "time": 4273.75, "timestamp": "01:11:13", "text": "えっと、受け取れるかどうかわからない"}, {"type": "subtitle", "time": 4281.75, "timestamp": "01:11:21", "text": "教材パック。うん。また、私は"}, {"type": "subtitle", "time": 4285.51, "timestamp": "01:11:25", "text": "バターミルクはお好きですか？"}, {"type": "subtitle", "time": 4289.669, "timestamp": "01:11:29", "text": "うん。それほど気に入っているんです。だから私は"}, {"type": "subtitle", "time": 4293.27, "timestamp": "01:11:33", "text": "まるで中毒みたいだね。いや、まあ、そんな感じ。"}, {"type": "subtitle", "time": 4295.59, "timestamp": "01:11:35", "text": "でも、たった10歳だったのも事実"}, {"type": "subtitle", "time": 4297.75, "timestamp": "01:11:37", "text": "ルピー。いや、違うよ。今すぐ購入できます"}, {"type": "subtitle", "time": 4300.79, "timestamp": "01:11:40", "text": "ここ。そして私はこう思った、待って、"}, {"type": "subtitle", "time": 4303.35, "timestamp": "01:11:43", "text": "日本にもこれはありますか？そして私はそれを調べた"}, {"type": "subtitle", "time": 4305.59, "timestamp": "01:11:45", "text": "そしてどうやら彼らはそれを持っていないようです"}, {"type": "subtitle", "time": 4308.79, "timestamp": "01:11:48", "text": "液体状。粉末状です。私は"}, {"type": "subtitle", "time": 4311.07, "timestamp": "01:11:51", "text": "のように、"}]
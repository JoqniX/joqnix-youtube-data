[{"type": "subtitle", "time": 3841.109, "timestamp": "01:04:01", "text": "方法。"}, {"type": "subtitle", "time": 3846.789, "timestamp": "01:04:06", "text": "私はほとんどの場合、その味が好きではありません。"}, {"type": "subtitle", "time": 3851.91, "timestamp": "01:04:11", "text": "しかも、お腹も痛くなるんです。ああ、もし"}, {"type": "subtitle", "time": 3855.19, "timestamp": "01:04:15", "text": "私はそれをとても好きなように飲みます"}, {"type": "subtitle", "time": 3858.23, "timestamp": "01:04:18", "text": "ほとんどの人がそれを飲むと、お腹が痛くなる"}, {"type": "subtitle", "time": 3862.069, "timestamp": "01:04:22", "text": "傷つく。とても痛い。"}, {"type": "subtitle", "time": 3864.27, "timestamp": "01:04:24", "text": "えっと、それでどうするんですか？"}, {"type": "subtitle", "time": 3868.47, "timestamp": "01:04:28", "text": "カフェイン？あなたは紅茶を飲みますか？私はお酒を飲みません"}, {"type": "subtitle", "time": 3870.96, "timestamp": "01:04:30", "text": "カフェインを頻繁に摂取する。"}, {"type": "subtitle", "time": 3880.63, "timestamp": "01:04:40", "text": "あなたの好きな飲​​み物は何ですか？私はしません"}, {"type": "subtitle", "time": 3884.349, "timestamp": "01:04:44", "text": "知る。私は何でも、どんな飲み物でも飲みます"}, {"type": "subtitle", "time": 3886.349, "timestamp": "01:04:46", "text": "食用。"}, {"type": "subtitle", "time": 3888.87, "timestamp": "01:04:48", "text": "飲める。わからない。お酒を飲みましたか？"}, {"type": "subtitle", "time": 3892.15, "timestamp": "01:04:52", "text": "サトウキビジュースを飲んだことがある？ああ、そうだね。それ"}, {"type": "subtitle", "time": 3895.109, "timestamp": "01:04:55", "text": "良かった。ああ、とてもいい"}, {"type": "subtitle", "time": 3897.029, "timestamp": "01:04:57", "text": "夏。"}]
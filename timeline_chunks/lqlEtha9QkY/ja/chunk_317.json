[{"type": "subtitle", "time": 19020.55, "timestamp": "05:17:00", "text": "だからといって、防弾になるわけじゃないんだよ。"}, {"type": "subtitle", "time": 19024.15, "timestamp": "05:17:04", "text": "これで全てです。 62. だから、私は"}, {"type": "subtitle", "time": 19030.39, "timestamp": "05:17:10", "text": "きっとまた同じことを繰り返すことになるでしょう"}, {"type": "subtitle", "time": 19033.35, "timestamp": "05:17:13", "text": "まもなく。そうかもしれない。そして私が望むなら、"}, {"type": "subtitle", "time": 19034.42, "timestamp": "05:17:14", "text": "私はただ"}, {"type": "subtitle", "time": 19037.15, "timestamp": "05:17:17", "text": "[音楽]"}, {"type": "subtitle", "time": 19041.83, "timestamp": "05:17:21", "text": "購入して、私は好きになれる"}, {"type": "subtitle", "time": 19045.03, "timestamp": "05:17:25", "text": "このピストルを売って、これをリロードして"}, {"type": "subtitle", "time": 19048.15, "timestamp": "05:17:28", "text": "これを売る。"}, {"type": "subtitle", "time": 19056.51, "timestamp": "05:17:36", "text": "ちょっとこんな感じの"}, {"type": "subtitle", "time": 19066.868, "timestamp": "05:17:46", "text": "集める。持続する。ああ、素晴らしい。それ"}, {"type": "subtitle", "time": 19069.868, "timestamp": "05:17:49", "text": "一つは境界線を隠すために使われた"}, {"type": "subtitle", "time": 19072.07, "timestamp": "05:17:52", "text": "ポルノ。ピューリタン的な考え方"}, {"type": "subtitle", "time": 19074.39, "timestamp": "05:17:54", "text": "性に関する話題は、もはや時代遅れだ。彼女は"}, {"type": "subtitle", "time": 19076.31, "timestamp": "05:17:56", "text": "単にポルノグラフィーと言えばいいの？注射器を使って"}, {"type": "subtitle", "time": 19079.43, "timestamp": "05:17:59", "text": "ダーツゲームのために。容認できない。その上、"}]
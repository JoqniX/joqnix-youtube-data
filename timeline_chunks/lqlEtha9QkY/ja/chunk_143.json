[{"type": "subtitle", "time": 8580.11, "timestamp": "02:23:00", "text": "えっと、実は食べたんです"}, {"type": "subtitle", "time": 8584.27, "timestamp": "02:23:04", "text": "夕食をもう一度食べたのですが、少し"}, {"type": "subtitle", "time": 8587.67, "timestamp": "02:23:07", "text": "お腹がすいた。それを再び作るのには時間がかかった"}, {"type": "subtitle", "time": 8590.03, "timestamp": "02:23:10", "text": "物を温め直して"}, {"type": "subtitle", "time": 8591.79, "timestamp": "02:23:11", "text": "すべて。"}, {"type": "subtitle", "time": 8594.87, "timestamp": "02:23:14", "text": "それで、それにいくつか返信しなければならなかった"}, {"type": "subtitle", "time": 8596.11, "timestamp": "02:23:16", "text": "DMと"}, {"type": "subtitle", "time": 8599.11, "timestamp": "02:23:19", "text": "すべて。つまり、それはひどい痛みだった。しかし"}, {"type": "subtitle", "time": 8602.63, "timestamp": "02:23:22", "text": "ええ、ちょっと、それから私は"}, {"type": "subtitle", "time": 8605.03, "timestamp": "02:23:25", "text": "祖母の手助けもしたい。うん。だから、"}, {"type": "subtitle", "time": 8607.429, "timestamp": "02:23:27", "text": "そこにはたくさんのものがあった。それでは、コメント"}, {"type": "subtitle", "time": 8609.429, "timestamp": "02:23:29", "text": "今"}, {"type": "subtitle", "time": 8613.11, "timestamp": "02:23:33", "text": "えっと、遅刻してしまいました。でも、そうだね、"}, {"type": "subtitle", "time": 8617.349, "timestamp": "02:23:37", "text": "午前3時頃になると思う。"}, {"type": "subtitle", "time": 8618.99, "timestamp": "02:23:38", "text": "包むべき"}, {"type": "subtitle", "time": 8623.59, "timestamp": "02:23:43", "text": "アップロードして、VAをラップして、行く"}, {"type": "subtitle", "time": 8625.99, "timestamp": "02:23:45", "text": "明日は"}, {"type": "subtitle", "time": 8629.11, "timestamp": "02:23:49", "text": "いくつかコラボレーション企画が進行中です。"}, {"type": "subtitle", "time": 8632.389, "timestamp": "02:23:52", "text": "だから私は"}, {"type": "subtitle", "time": 8636.03, "timestamp": "02:23:56", "text": "ええと、そこに焦点を当ててください。さらに、私たちは"}, {"type": "subtitle", "time": 8639.51, "timestamp": "02:23:59", "text": "えっと、明日の土曜日は、"}]
[{"type": "subtitle", "time": 2521.91, "timestamp": "00:42:01", "text": "追加しました。つまり、これはもっと"}, {"type": "subtitle", "time": 2524.15, "timestamp": "00:42:04", "text": "Twitchのものを手に入れる方が簡単だから"}, {"type": "subtitle", "time": 2527.19, "timestamp": "00:42:07", "text": "私のGoogle Payで簡単に支払えます"}, {"type": "subtitle", "time": 2531.51, "timestamp": "00:42:11", "text": "Twitchで配信中。でもYouTubeのために私のスズキは"}, {"type": "subtitle", "time": 2535.829, "timestamp": "00:42:15", "text": "Zuriアカウントは私の現実世界のGPAとは関係ありません"}, {"type": "subtitle", "time": 2538.069, "timestamp": "00:42:18", "text": "アカウント。だから、支払いができないんです"}, {"type": "subtitle", "time": 2546.71, "timestamp": "00:42:26", "text": "ええ、そういうこともありますよ。何かが外にある"}, {"type": "subtitle", "time": 2555.27, "timestamp": "00:42:35", "text": "f.うん、独り言みたいな感じだった"}, {"type": "subtitle", "time": 2557.67, "timestamp": "00:42:37", "text": "このコラボ企画について。コラボレーションではありません"}, {"type": "subtitle", "time": 2560.63, "timestamp": "00:42:40", "text": "えっと、あのやつみたいな。考えていたように"}, {"type": "subtitle", "time": 2564.03, "timestamp": "00:42:44", "text": "例えば、私が小さなスターターだったらどうなるだろう？"}, {"type": "chat", "time": 2566.579, "timestamp": "00:42:46", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "Have a good night joq! and sleep soon😊"}, {"type": "subtitle", "time": 2567.51, "timestamp": "00:42:47", "text": "初心者で、誰かに聞きに来ました"}, {"type": "subtitle", "time": 2569.67, "timestamp": "00:42:49", "text": "見てたら、まるで私がコラボしたみたいだった"}, {"type": "subtitle", "time": 2571.91, "timestamp": "00:42:51", "text": "あなたが小さかった頃、一緒にいました。ただ"}, {"type": "subtitle", "time": 2574.309, "timestamp": "00:42:54", "text": "冗談だよ。私たちは二人とも同じくらいの大きさだった"}, {"type": "subtitle", "time": 2577.67, "timestamp": "00:42:57", "text": "けれど。うん。うん。"}, {"type": "subtitle", "time": 2579.87, "timestamp": "00:42:59", "text": "ねえ、君が"}]
[{"type": "subtitle", "time": 4322.87, "timestamp": "01:12:02", "text": "うん、"}, {"type": "subtitle", "time": 4326.87, "timestamp": "01:12:06", "text": "ジョーク。聞こえません。何？"}, {"type": "subtitle", "time": 4329.03, "timestamp": "01:12:09", "text": "しばらくあなたの声が聞こえませんでした"}, {"type": "subtitle", "time": 4331.87, "timestamp": "01:12:11", "text": "一瞬。何？"}, {"type": "subtitle", "time": 4334.709, "timestamp": "01:12:14", "text": "はぁ？ええと、そこにはありません。待って、あなたはできる"}, {"type": "subtitle", "time": 4339.27, "timestamp": "01:12:19", "text": "今、私の話を聞いてくれる？うん。いらっしゃいませ。わかった。"}, {"type": "subtitle", "time": 4342.63, "timestamp": "01:12:22", "text": "どの部分が切断されたのですか？"}, {"type": "subtitle", "time": 4345.63, "timestamp": "01:12:25", "text": "あなたが話していたのは、"}, {"type": "subtitle", "time": 4348.229, "timestamp": "01:12:28", "text": "バターミルク。ああ、そうだね。では、あなたは"}, {"type": "subtitle", "time": 4350.51, "timestamp": "01:12:30", "text": "について話す"}, {"type": "subtitle", "time": 4353.75, "timestamp": "01:12:33", "text": "アムル？わからない。それはただ"}, {"type": "subtitle", "time": 4355.83, "timestamp": "01:12:35", "text": "バターミルクに少し"}, {"type": "subtitle", "time": 4357.99, "timestamp": "01:12:37", "text": "スパイス。"}, {"type": "subtitle", "time": 4360.39, "timestamp": "01:12:40", "text": "私はバターミルクがあまり好きではないのですが、"}, {"type": "subtitle", "time": 4363.91, "timestamp": "01:12:43", "text": "作りたてです。"}, {"type": "subtitle", "time": 4367.03, "timestamp": "01:12:47", "text": "ええ、そうですね。バターはおいしい。そうそう、"}, {"type": "subtitle", "time": 4370.55, "timestamp": "01:12:50", "text": "そうだね。それで、調べてみたところ、"}, {"type": "subtitle", "time": 4373.03, "timestamp": "01:12:53", "text": "どうやら粉末状に加工されているらしい"}, {"type": "subtitle", "time": 4376.149, "timestamp": "01:12:56", "text": "日本で形成されます。"}]
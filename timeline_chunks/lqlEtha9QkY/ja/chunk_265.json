[{"type": "subtitle", "time": 15900.79, "timestamp": "04:25:00", "text": "それ。そう、もう一人いたんだ"}, {"type": "subtitle", "time": 15903.75, "timestamp": "04:25:03", "text": "私の配信を形作った視聴者の一人でした。彼らの"}, {"type": "subtitle", "time": 15906.389, "timestamp": "04:25:06", "text": "その名はウガブーガ・ワカンダだった。だから、わかるでしょ"}, {"type": "subtitle", "time": 15910.269, "timestamp": "04:25:10", "text": "私が思ったこと？えっと、"}, {"type": "subtitle", "time": 15913.269, "timestamp": "04:25:13", "text": "あなたはそれが自分だと思った。えっと、そしてあなたは"}, {"type": "subtitle", "time": 15920.59, "timestamp": "04:25:20", "text": "何か。あ、待って。なぜ"}, {"type": "subtitle", "time": 15924.229, "timestamp": "04:25:24", "text": "保持する？"}, {"type": "subtitle", "time": 15925.99, "timestamp": "04:25:25", "text": "ええ、そうですね。実際に作ったと思った"}, {"type": "subtitle", "time": 15929.429, "timestamp": "04:25:29", "text": "トワナのゲーム。私はこう思ったが、それは"}, {"type": "subtitle", "time": 15940.07, "timestamp": "04:25:40", "text": "ええ、別人でした"}, {"type": "subtitle", "time": 15946.149, "timestamp": "04:25:46", "text": "うん。私は「待って、君たちは"}, {"type": "subtitle", "time": 15951.189, "timestamp": "04:25:51", "text": "同名。でも違いは"}, {"type": "subtitle", "time": 15955.429, "timestamp": "04:25:55", "text": "ええ、違いは、えっと、"}]
[{"type": "subtitle", "time": 11342.23, "timestamp": "03:09:02", "text": "ニース。司令官がここにいます。待って、それは"}, {"type": "subtitle", "time": 11344.66, "timestamp": "03:09:04", "text": "今度は重火器だ。"}, {"type": "subtitle", "time": 11367.59, "timestamp": "03:09:27", "text": "待て、その手榴弾は何の効果もない。"}, {"type": "subtitle", "time": 11376.71, "timestamp": "03:09:36", "text": "このコーヒーを"}, {"type": "subtitle", "time": 11391.11, "timestamp": "03:09:51", "text": "ああ、大変だ。どうしてうまくいっていたのですか？"}]
[{"type": "subtitle", "time": 6600.07, "timestamp": "01:50:00", "text": "実際の行為"}, {"type": "subtitle", "time": 6603.59, "timestamp": "01:50:03", "text": "えーと、実際にはエロいものをエッチングするわけじゃない"}, {"type": "subtitle", "time": 6606.629, "timestamp": "01:50:06", "text": "もの。ジョジョとシャと私もそう言える"}, {"type": "subtitle", "time": 6608.91, "timestamp": "01:50:08", "text": "穏やかな"}, {"type": "subtitle", "time": 6612.55, "timestamp": "01:50:12", "text": "あまり穏やかではない安全なタイプですが、それは"}, {"type": "subtitle", "time": 6620.189, "timestamp": "01:50:20", "text": "答え。はい。はい。 BLは安全です"}, {"type": "subtitle", "time": 6622.91, "timestamp": "01:50:22", "text": "言葉。ヨイは"}, {"type": "subtitle", "time": 6624.99, "timestamp": "01:50:24", "text": "国連"}, {"type": "subtitle", "time": 6637.43, "timestamp": "01:50:37", "text": "よし、カメラを破壊して"}, {"type": "subtitle", "time": 6637.7, "timestamp": "01:50:37", "text": "仕上げる"}, {"type": "subtitle", "time": 6655.75, "timestamp": "01:50:55", "text": "これ。そしてもう片方も終わるはずだ"}]
[{"type": "subtitle", "time": 3483.91, "timestamp": "00:58:03", "text": "考えます。いいえ、わかりません。私が知っているはずだ。私"}, {"type": "subtitle", "time": 3486.23, "timestamp": "00:58:06", "text": "これを聞いていいのかどうかわかりません。えっと、"}, {"type": "subtitle", "time": 3488.63, "timestamp": "00:58:08", "text": "どうしたの？"}, {"type": "subtitle", "time": 3492.71, "timestamp": "00:58:12", "text": "[音楽]"}, {"type": "subtitle", "time": 3495.15, "timestamp": "00:58:15", "text": "あなたの考えは？"}, {"type": "subtitle", "time": 3498.549, "timestamp": "00:58:18", "text": "手を伸ばすことが面倒くさいと感じる？もしあなたがもしあなたが"}, {"type": "subtitle", "time": 3501.63, "timestamp": "00:58:21", "text": "それを面倒な作業のように受け止める。"}, {"type": "subtitle", "time": 3504.39, "timestamp": "00:58:24", "text": "ああ、それは面倒なことではないと思うよ。"}, {"type": "subtitle", "time": 3506.95, "timestamp": "00:58:26", "text": "それは趣味であるべきであり、"}, {"type": "subtitle", "time": 3509.67, "timestamp": "00:58:29", "text": "あなたが情熱を注いでいること。趣味とは何ですか？"}, {"type": "subtitle", "time": 3512.99, "timestamp": "00:58:32", "text": "趣味と情熱を定義する"}, {"type": "subtitle", "time": 3517.91, "timestamp": "00:58:37", "text": "趣味。どうやってやるんですか？はぁ？どのように"}, {"type": "subtitle", "time": 3521.27, "timestamp": "00:58:41", "text": "いいえ、どうやって"}, {"type": "subtitle", "time": 3522.43, "timestamp": "00:58:42", "text": "する"}, {"type": "subtitle", "time": 3525.109, "timestamp": "00:58:45", "text": "趣味か、それとも情熱を傾ける趣味か？どう思いますか？"}, {"type": "subtitle", "time": 3528.51, "timestamp": "00:58:48", "text": "それ？そうだよね。"}, {"type": "subtitle", "time": 3531.19, "timestamp": "00:58:51", "text": "趣味。はい、少々お待ちください。私にさせて"}, {"type": "subtitle", "time": 3534.15, "timestamp": "00:58:54", "text": "考える。"}, {"type": "subtitle", "time": 3539.589, "timestamp": "00:58:59", "text": "私は何かを情熱と考えるとき、"}]
[{"type": "subtitle", "time": 1142.19, "timestamp": "00:19:02", "text": "実は私にはちゃんとしたコミュニティがないんです"}, {"type": "subtitle", "time": 1151.27, "timestamp": "00:19:11", "text": "ええ、コラボが何なのかよくわかりません"}, {"type": "subtitle", "time": 1152.549, "timestamp": "00:19:12", "text": "正直に言ってください。私はただこう思っただけです"}, {"type": "subtitle", "time": 1157.27, "timestamp": "00:19:17", "text": "一緒に遊んだりとか。 H それはできる"}, {"type": "subtitle", "time": 1160.63, "timestamp": "00:19:20", "text": "実際には別の意味になる"}, {"type": "subtitle", "time": 1162.75, "timestamp": "00:19:22", "text": "なれ"}, {"type": "subtitle", "time": 1167.99, "timestamp": "00:19:27", "text": "正直。つまり、私とヴィックが"}, {"type": "subtitle", "time": 1170.71, "timestamp": "00:19:30", "text": "えっと、ヴィックが配信してたと思うんだけど"}, {"type": "subtitle", "time": 1174.47, "timestamp": "00:19:34", "text": "Twitchとかでやってるけど、まあ、ほとんどは"}, {"type": "subtitle", "time": 1176.549, "timestamp": "00:19:36", "text": "今のストリーマーのほとんどはこんな感じ"}, {"type": "subtitle", "time": 1179.19, "timestamp": "00:19:39", "text": "バラエティモードにして、ただ行く"}, {"type": "subtitle", "time": 1180.95, "timestamp": "00:19:40", "text": "Twitch流の楽しみ方"}, {"type": "subtitle", "time": 1183.11, "timestamp": "00:19:43", "text": "そして彼らは好きなように行動し、"}, {"type": "subtitle", "time": 1185.59, "timestamp": "00:19:45", "text": "ぶらぶらしてるんだよね？それはそれができる"}, {"type": "subtitle", "time": 1189.63, "timestamp": "00:19:49", "text": "それはたまり場のようなものと言えるでしょう、私は"}, {"type": "subtitle", "time": 1192.63, "timestamp": "00:19:52", "text": "推測。何が"}, {"type": "subtitle", "time": 1196.15, "timestamp": "00:19:56", "text": "それに対する正しい用語。コラボレーション"}, {"type": "subtitle", "time": 1199.43, "timestamp": "00:19:59", "text": "実際には、様々な意味に解釈できる。もし"}]
[{"type": "subtitle", "time": 10142.63, "timestamp": "02:49:02", "text": "それは何て言うんだっけ？えっと、CDは"}, {"type": "subtitle", "time": 10147.469, "timestamp": "02:49:07", "text": "変更。えーと、Twitch CD のように、"}, {"type": "subtitle", "time": 10152.15, "timestamp": "02:49:12", "text": "Twitchでは、えっと、それは"}, {"type": "subtitle", "time": 10155.349, "timestamp": "02:49:15", "text": "ああ、目を覚ませよ、マラワン野郎ども。"}, {"type": "subtitle", "time": 10157.51, "timestamp": "02:49:17", "text": "うん。私は戦争中だ。感じますか？"}, {"type": "subtitle", "time": 10159.51, "timestamp": "02:49:19", "text": "もっと暑い？本当に暑いですね。それ"}, {"type": "subtitle", "time": 10162.309, "timestamp": "02:49:22", "text": "こちらは雨が降っていました。どんな努力？そうだった"}, {"type": "subtitle", "time": 10163.71, "timestamp": "02:49:23", "text": "雨が降る"}, {"type": "subtitle", "time": 10166.95, "timestamp": "02:49:26", "text": "朝からずっと寝ていました。"}, {"type": "subtitle", "time": 10170.79, "timestamp": "02:49:30", "text": "ローラは、私たちが死んでいないと言った。ローラ"}, {"type": "subtitle", "time": 10175.11, "timestamp": "02:49:35", "text": "昼食は、午前3時に目が覚めたような感じでした。"}, {"type": "subtitle", "time": 10179.11, "timestamp": "02:49:39", "text": "また。 3. 私は午前3時に起こされた"}, {"type": "subtitle", "time": 10182.63, "timestamp": "02:49:42", "text": "そして、ローラに素晴らしいことを約束した"}, {"type": "subtitle", "time": 10185.99, "timestamp": "02:49:45", "text": "私だけが使える武器"}, {"type": "subtitle", "time": 10189.75, "timestamp": "02:49:49", "text": "作成する。ノグハッキンググレネード。ノグ"}, {"type": "subtitle", "time": 10192.15, "timestamp": "02:49:52", "text": "ハッキング。だからマラワンは私を狙っているんだ。"}]
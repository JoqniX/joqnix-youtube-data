[{"type": "subtitle", "time": 3181.41, "timestamp": "00:53:01", "text": "ソロコンテンツをもっと作るとうまくいく。"}, {"type": "subtitle", "time": 3183.03, "timestamp": "00:53:03", "text": "[音楽]"}, {"type": "subtitle", "time": 3185.27, "timestamp": "00:53:05", "text": "それと、副業としてコラボレーションもやってるよ。その"}, {"type": "subtitle", "time": 3188.069, "timestamp": "00:53:08", "text": "常にバランスが取れているべきだというわけではない。"}, {"type": "subtitle", "time": 3191.589, "timestamp": "00:53:11", "text": "はい。はい。そして、あなたにとって効果的なものが、あなたには効果がない"}, {"type": "subtitle", "time": 3194.39, "timestamp": "00:53:14", "text": "それはあなたにとって効果があるという意味です。あなた。"}, {"type": "subtitle", "time": 3197.109, "timestamp": "00:53:17", "text": "はい。私にとって効果があるからといって、それが必ずしも"}, {"type": "subtitle", "time": 3200.23, "timestamp": "00:53:20", "text": "あなたのために働きます。はい。"}, {"type": "subtitle", "time": 3203.829, "timestamp": "00:53:23", "text": "分かりますか？うん。"}, {"type": "subtitle", "time": 3206.75, "timestamp": "00:53:26", "text": "うん。はい。"}, {"type": "subtitle", "time": 3209.51, "timestamp": "00:53:29", "text": "うん。他に何か欲しいものはありますか？"}, {"type": "subtitle", "time": 3215.829, "timestamp": "00:53:35", "text": "あなたの誕生日がもうすぐやってきます"}, {"type": "subtitle", "time": 3219.109, "timestamp": "00:53:39", "text": "8月。ああ、8月ね。私はそうはならないでしょう"}, {"type": "subtitle", "time": 3222.309, "timestamp": "00:53:42", "text": "インドで、ですよね？何てことだ。私は"}, {"type": "subtitle", "time": 3225.43, "timestamp": "00:53:45", "text": "誕生日なのに悲しい。いつ"}, {"type": "subtitle", "time": 3229.829, "timestamp": "00:53:49", "text": "インド国外に出るの？うーん、たぶん"}, {"type": "subtitle", "time": 3232.309, "timestamp": "00:53:52", "text": "6月最終週。"}, {"type": "subtitle", "time": 3235.79, "timestamp": "00:53:55", "text": "それはとても悲しいことだ。"}, {"type": "subtitle", "time": 3239.75, "timestamp": "00:53:59", "text": "うん。わからない。私たちはあなたがいなくて寂しいです。うん。"}]
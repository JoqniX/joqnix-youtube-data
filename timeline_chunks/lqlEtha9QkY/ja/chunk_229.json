[{"type": "subtitle", "time": 13741.189, "timestamp": "03:49:01", "text": "近く。さあ行こう。私たちはあなたが"}, {"type": "subtitle", "time": 13743.67, "timestamp": "03:49:03", "text": "人質が中にいて、それを切りたい"}, {"type": "subtitle", "time": 13746.389, "timestamp": "03:49:06", "text": "身代金。営業開始しました。彼女は彼の妻です。"}, {"type": "subtitle", "time": 13748.95, "timestamp": "03:49:08", "text": "一体どういうことだ？おい、お前は受け取らない"}, {"type": "subtitle", "time": 13752.15, "timestamp": "03:49:12", "text": "私たちの取り分。"}, {"type": "subtitle", "time": 13754.309, "timestamp": "03:49:14", "text": "警察ロボットを倒してくれてありがとう。"}, {"type": "subtitle", "time": 13757.229, "timestamp": "03:49:17", "text": "あなたが誰であろうと。あなたは"}, {"type": "subtitle", "time": 13762.15, "timestamp": "03:49:22", "text": "交換？話しかけてください。それとも何？"}, {"type": "subtitle", "time": 13769.309, "timestamp": "03:49:29", "text": "門番ですが、交換します"}, {"type": "subtitle", "time": 13773.99, "timestamp": "03:49:33", "text": "彼女の血は輝いていた。警官が彼女を捕まえた。私"}, {"type": "subtitle", "time": 13777.83, "timestamp": "03:49:37", "text": "彼女をどこかのくだらない刑務所に閉じ込めた。"}, {"type": "subtitle", "time": 13779.63, "timestamp": "03:49:39", "text": "刑務所。"}, {"type": "subtitle", "time": 13782.469, "timestamp": "03:49:42", "text": "わかった。警察に行ってください。言い訳。スクリュー"}, {"type": "subtitle", "time": 13784.87, "timestamp": "03:49:44", "text": "私と一緒に。俺に手を出したら殺すぞ。"}, {"type": "subtitle", "time": 13788.07, "timestamp": "03:49:48", "text": "ああ、彼は全てを監視しているんだ。何てことだ。"}, {"type": "subtitle", "time": 13791.75, "timestamp": "03:49:51", "text": "だって私は恋に落ちて、しかも気が狂ってるんだもの。"}, {"type": "subtitle", "time": 13795.429, "timestamp": "03:49:55", "text": "ヴォルトハンターはどうですか？私は下士官です。"}, {"type": "subtitle", "time": 13797.67, "timestamp": "03:49:57", "text": "腫瘍頭の囚人だが、私は"}, {"type": "subtitle", "time": 13799.99, "timestamp": "03:49:59", "text": "彼女が考えているように、アトラス兵だ。もし彼女が"}]
[{"type": "subtitle", "time": 7445.39, "timestamp": "02:04:05", "text": "おお。"}, {"type": "subtitle", "time": 7449.669, "timestamp": "02:04:09", "text": "ああ。あの音、聞こえますか？あの音"}, {"type": "subtitle", "time": 7453.589, "timestamp": "02:04:13", "text": "つまり私は私は私は私は"}, {"type": "subtitle", "time": 7463.51, "timestamp": "02:04:23", "text": "どこかで。開けて、私たちが来られるように"}, {"type": "subtitle", "time": 7475.43, "timestamp": "02:04:35", "text": "バカ、愚か、効率的な使い方"}, {"type": "subtitle", "time": 7480.31, "timestamp": "02:04:40", "text": "コンドミニアムの中には、"}, {"type": "subtitle", "time": 7482.27, "timestamp": "02:04:42", "text": "クリア"}, {"type": "subtitle", "time": 7484.27, "timestamp": "02:04:44", "text": "地獄"}, {"type": "subtitle", "time": 7488.589, "timestamp": "02:04:48", "text": "えっ、バカールのケツ穴って何？"}, {"type": "subtitle", "time": 7490.75, "timestamp": "02:04:50", "text": "地獄"}, {"type": "subtitle", "time": 7499.91, "timestamp": "02:04:59", "text": "おい。何てことだ。それは知りませんでした。私は"}]
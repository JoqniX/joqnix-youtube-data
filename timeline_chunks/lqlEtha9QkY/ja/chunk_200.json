[{"type": "subtitle", "time": 12001.55, "timestamp": "03:20:01", "text": "伝説のロケットランチャー、"}, {"type": "subtitle", "time": 12004.71, "timestamp": "03:20:04", "text": "でも大丈夫。大丈夫です。調子はどうですか"}, {"type": "subtitle", "time": 12011.429, "timestamp": "03:20:11", "text": "あなたの敵はそうするでしょう。こんにちは。こんにちは。こんにちは。そして私たちは"}, {"type": "subtitle", "time": 12014.55, "timestamp": "03:20:14", "text": "わかった。それを売ってください。私たちはそれを販売しています。なれ"}, {"type": "subtitle", "time": 12016.15, "timestamp": "03:20:16", "text": "現金。"}, {"type": "subtitle", "time": 12018.11, "timestamp": "03:20:18", "text": "私たちは作ります 私たちは作ります 私たちは作ります"}, {"type": "subtitle", "time": 12022.03, "timestamp": "03:20:22", "text": "17,000。おお。ゆっくりと最大限まで上げていきます"}, {"type": "subtitle", "time": 12024.59, "timestamp": "03:20:24", "text": "外。ゆっくり"}, {"type": "subtitle", "time": 12028.07, "timestamp": "03:20:28", "text": "ゆっくり。これやこれや"}, {"type": "subtitle", "time": 12030.07, "timestamp": "03:20:30", "text": "これ。"}, {"type": "subtitle", "time": 12032.87, "timestamp": "03:20:32", "text": "防弾仕様にしてくれよ。"}, {"type": "subtitle", "time": 12035.55, "timestamp": "03:20:35", "text": "えっと、"}, {"type": "subtitle", "time": 12051.03, "timestamp": "03:20:51", "text": "162. 私は243の突撃銃を持っています。それで、"}, {"type": "subtitle", "time": 12054.229, "timestamp": "03:20:54", "text": "これらは必要ありません。あなたはひどい"}]
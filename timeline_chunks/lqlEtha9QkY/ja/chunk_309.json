[{"type": "subtitle", "time": 18541.35, "timestamp": "05:09:01", "text": "これを売ってください。 Vaultさん、ようこそ！"}, {"type": "subtitle", "time": 18543.75, "timestamp": "05:09:03", "text": "ハンター。ええと、ロッカーはそのままにしておきます。"}, {"type": "subtitle", "time": 18556.35, "timestamp": "05:09:16", "text": "えっと、売るべきもの"}, {"type": "subtitle", "time": 18559.43, "timestamp": "05:09:19", "text": "リミッターマガジンとして。よし、これは"}, {"type": "subtitle", "time": 18563.35, "timestamp": "05:09:23", "text": "良い武器だ。これは取っておくべきだ"}, {"type": "subtitle", "time": 18565.83, "timestamp": "05:09:25", "text": "そしてそれを売る。"}, {"type": "subtitle", "time": 18567.39, "timestamp": "05:09:27", "text": "そして"}, {"type": "subtitle", "time": 18570.55, "timestamp": "05:09:30", "text": "これと"}, {"type": "subtitle", "time": 18572.07, "timestamp": "05:09:32", "text": "最悪だ。"}, {"type": "subtitle", "time": 18575.07, "timestamp": "05:09:35", "text": "そしてこれ"}, {"type": "subtitle", "time": 18587.11, "timestamp": "05:09:47", "text": "ええと、これで全部だと思います。"}, {"type": "subtitle", "time": 18589.83, "timestamp": "05:09:49", "text": "信じる。そしてそれを売る。私の"}, {"type": "subtitle", "time": 18593.788, "timestamp": "05:09:53", "text": "注文ですか？私は何者？そして"}, {"type": "subtitle", "time": 18596.788, "timestamp": "05:09:56", "text": "これはゼロが私にくれた銃だ。そうするべきです。"}, {"type": "subtitle", "time": 18598.948, "timestamp": "05:09:58", "text": "ロッカーに保管してください。"}]
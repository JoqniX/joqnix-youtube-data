[{"type": "subtitle", "time": 13442.07, "timestamp": "03:44:02", "text": "ここ。この場所の地図はとても親切です"}, {"type": "subtitle", "time": 13450.67, "timestamp": "03:44:10", "text": "あー、行かなきゃ"}, {"type": "subtitle", "time": 13463.91, "timestamp": "03:44:23", "text": "これ？私には理解できません"}, {"type": "subtitle", "time": 13467.55, "timestamp": "03:44:27", "text": "実は。この下部"}, {"type": "subtitle", "time": 13470.79, "timestamp": "03:44:30", "text": "ほら、そこが我々が行かなければならない場所なんだ。ともかく、"}, {"type": "subtitle", "time": 13472.99, "timestamp": "03:44:32", "text": "終わらせましょう"}, {"type": "subtitle", "time": 13476.79, "timestamp": "03:44:36", "text": "ミッション。恐ろしい壁だ。さあ行こう。私にさせて"}, {"type": "subtitle", "time": 13478.11, "timestamp": "03:44:38", "text": "これを終わらせる"}, {"type": "subtitle", "time": 13489.309, "timestamp": "03:44:49", "text": "私はできません"}, {"type": "subtitle", "time": 13498.79, "timestamp": "03:44:58", "text": "場所？すぐそこです。しかし、どのように"}]
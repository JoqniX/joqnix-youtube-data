[{"type": "subtitle", "time": 12181.19, "timestamp": "03:23:01", "text": "神。いいえ。"}, {"type": "subtitle", "time": 12185.19, "timestamp": "03:23:05", "text": "私はそうなることを望んでいた。私は欲しい"}, {"type": "subtitle", "time": 12187.469, "timestamp": "03:23:07", "text": "敵対する者"}, {"type": "subtitle", "time": 12196.87, "timestamp": "03:23:16", "text": "私は死にかけている。"}, {"type": "subtitle", "time": 12204.71, "timestamp": "03:23:24", "text": "そうですね、これはサイバーパンクのように見えます。"}, {"type": "subtitle", "time": 12207.67, "timestamp": "03:23:27", "text": "何か。似ているようで違う。これ"}, {"type": "subtitle", "time": 12209.309, "timestamp": "03:23:29", "text": "サイバーを思い出させる"}, {"type": "subtitle", "time": 12213.11, "timestamp": "03:23:33", "text": "パンク。他に例えられるような動きはない"}, {"type": "subtitle", "time": 12216.229, "timestamp": "03:23:36", "text": "高い動きのように、"}, {"type": "subtitle", "time": 12218.469, "timestamp": "03:23:38", "text": "サイバーパンクだよね？あなたは近接武器を取ります。"}, {"type": "subtitle", "time": 12220.59, "timestamp": "03:23:40", "text": "ここでは近接戦闘はありませんが、"}, {"type": "subtitle", "time": 12224.71, "timestamp": "03:23:44", "text": "武器の広告を表示し、ダブルタップでダッシュします。いいえ、"}, {"type": "subtitle", "time": 12226.95, "timestamp": "03:23:46", "text": "ダブルタップすると、まるでモッドがあるかのように"}, {"type": "subtitle", "time": 12229.91, "timestamp": "03:23:49", "text": "時間が遅くなるようなものを手に入れることができます。あなたがやる"}, {"type": "subtitle", "time": 12232.389, "timestamp": "03:23:52", "text": "ブーストを得てジャンプすることができます"}, {"type": "subtitle", "time": 12235.429, "timestamp": "03:23:55", "text": "ここからあちらへ、そしてここから"}, {"type": "subtitle", "time": 12237.91, "timestamp": "03:23:57", "text": "そうやって飛び越えればいいんだよ。私"}]
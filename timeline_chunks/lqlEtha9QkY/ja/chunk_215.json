[{"type": "subtitle", "time": 12904.79, "timestamp": "03:35:04", "text": "男。来て。来て。ああ、死にそうだ。"}, {"type": "subtitle", "time": 12908.91, "timestamp": "03:35:08", "text": "ああ、弱い弱い"}, {"type": "subtitle", "time": 12921.51, "timestamp": "03:35:21", "text": "非常に素晴らしい。"}, {"type": "subtitle", "time": 12924.07, "timestamp": "03:35:24", "text": "いくら？おお、それはとてもお手頃価格ですね。"}, {"type": "subtitle", "time": 12926.71, "timestamp": "03:35:26", "text": "わかった、"}, {"type": "subtitle", "time": 12928.79, "timestamp": "03:35:28", "text": "自動販売機を見つけたら、"}, {"type": "subtitle", "time": 12941.99, "timestamp": "03:35:41", "text": "得る"}, {"type": "subtitle", "time": 12946.19, "timestamp": "03:35:46", "text": "なるほど。下の方に何かが見える"}]
[{"type": "subtitle", "time": 15375.91, "timestamp": "04:16:15", "text": "だから、我々はトップに立つ必要がある。どうすれば入手できますか"}, {"type": "subtitle", "time": 15378.07, "timestamp": "04:16:18", "text": "トップに？"}, {"type": "subtitle", "time": 15381.59, "timestamp": "04:16:21", "text": "だから、もし私が潜ったら、死ぬだろう。"}, {"type": "subtitle", "time": 15400.71, "timestamp": "04:16:40", "text": "神。なぜ私はショットガンを多用するのでしょうか？"}]
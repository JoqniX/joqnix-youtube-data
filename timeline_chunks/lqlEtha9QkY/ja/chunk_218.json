[{"type": "subtitle", "time": 13081.03, "timestamp": "03:38:01", "text": "実は。えっと、これを変更して"}, {"type": "subtitle", "time": 13084.03, "timestamp": "03:38:04", "text": "これを売り切れ。弱い"}, {"type": "subtitle", "time": 13093.349, "timestamp": "03:38:13", "text": "138 それらを売ります。まさにその通り。"}, {"type": "subtitle", "time": 13095.51, "timestamp": "03:38:15", "text": "他に何か必要なものはありますか？"}, {"type": "subtitle", "time": 13098.63, "timestamp": "03:38:18", "text": "売るため？いいえ。では、これを"}, {"type": "subtitle", "time": 13103.19, "timestamp": "03:38:23", "text": "実際にはサブマシンガンとして。さあ始めよう"}, {"type": "subtitle", "time": 13107.79, "timestamp": "03:38:27", "text": "これを始めてください。あ、待って。私"}, {"type": "subtitle", "time": 13113.79, "timestamp": "03:38:33", "text": "これで使えるようになった。私たちは昔からの知り合いです。全て"}, {"type": "subtitle", "time": 13116.55, "timestamp": "03:38:36", "text": "右。うん。スブミは今日配信をします。"}, {"type": "subtitle", "time": 13135.19, "timestamp": "03:38:55", "text": "わかった。何か良いものはありますか？"}]
[{"type": "subtitle", "time": 961.749, "timestamp": "00:16:01", "text": "すごく真剣な人たちのように"}, {"type": "subtitle", "time": 963.91, "timestamp": "00:16:03", "text": "YouTubeは単なるビジネスではない"}, {"type": "subtitle", "time": 965.949, "timestamp": "00:16:05", "text": "YouTuber。"}, {"type": "subtitle", "time": 968.35, "timestamp": "00:16:08", "text": "はぁ？彼らはただ"}, {"type": "subtitle", "time": 971.43, "timestamp": "00:16:11", "text": "丁寧に、あるいは失礼にならないように、彼らはただ"}, {"type": "subtitle", "time": 974.11, "timestamp": "00:16:14", "text": "丁寧に断る"}, {"type": "subtitle", "time": 975.949, "timestamp": "00:16:15", "text": "等"}, {"type": "subtitle", "time": 980.35, "timestamp": "00:16:20", "text": "ああ、終わりはないと思う"}, {"type": "subtitle", "time": 984.069, "timestamp": "00:16:24", "text": "そう、もしそれがなければ"}, {"type": "subtitle", "time": 987.67, "timestamp": "00:16:27", "text": "数字や到達値など、"}, {"type": "chat", "time": 989.189, "timestamp": "00:16:29", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "I'm so sorry T~T I had no idea it's that serious"}, {"type": "subtitle", "time": 990.55, "timestamp": "00:16:30", "text": "彼らが文字通り「いいえ」と言うもの"}, {"type": "subtitle", "time": 993.15, "timestamp": "00:16:33", "text": "それで、最近知ったのですが"}, {"type": "subtitle", "time": 996.949, "timestamp": "00:16:36", "text": "コラボレーターのようにコラボレーションには"}, {"type": "subtitle", "time": 1000.55, "timestamp": "00:16:40", "text": "この3面とは異なる面"}, {"type": "subtitle", "time": 1002.87, "timestamp": "00:16:42", "text": "えっと、3つ目の側面はこんな感じです"}, {"type": "subtitle", "time": 1005.509, "timestamp": "00:16:45", "text": "誰かに支払うことができます。"}, {"type": "subtitle", "time": 1007.99, "timestamp": "00:16:47", "text": "YouTuberは鉄のように遊ばなかった、"}, {"type": "subtitle", "time": 1012.23, "timestamp": "00:16:52", "text": "IMOSではなく、ポケモンや、えーと、シュノのような。"}, {"type": "subtitle", "time": 1014.389, "timestamp": "00:16:54", "text": "などなど、そうですよね？彼女はたくさん支払った"},
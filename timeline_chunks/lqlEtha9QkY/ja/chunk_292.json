[{"type": "subtitle", "time": 17525.47, "timestamp": "04:52:05", "text": "戻る。私たちは戻ってきました。"}, {"type": "subtitle", "time": 17529.75, "timestamp": "04:52:09", "text": "戻る。さあ行こう。そして私はこれをしなければならない"}, {"type": "subtitle", "time": 17531.868, "timestamp": "04:52:11", "text": "手短に。 1つ"}, {"type": "subtitle", "time": 17541.708, "timestamp": "04:52:21", "text": "こんにちは、戻ってきました。 1つ"}, {"type": "subtitle", "time": 17544.47, "timestamp": "04:52:24", "text": "秒あ、待って。ゲーム。なんてこった。いいえ、いいえ、"}, {"type": "subtitle", "time": 17545.83, "timestamp": "04:52:25", "text": "いいえ。ゲーム。ゲーム。ゲーム。の"}, {"type": "subtitle", "time": 17546.91, "timestamp": "04:52:26", "text": "ゲーム"}, {"type": "subtitle", "time": 17557.75, "timestamp": "04:52:37", "text": "待って。こんにちは。これで大丈夫だろう。気にしないで"}, {"type": "subtitle", "time": 17559.43, "timestamp": "04:52:39", "text": "自分。私はただ、"}, {"type": "subtitle", "time": 17561.708, "timestamp": "04:52:41", "text": "背景は"}, {"type": "subtitle", "time": 17573.23, "timestamp": "04:52:53", "text": "絵を描くべきだ"}]
[{"type": "subtitle", "time": 1080.23, "timestamp": "00:18:00", "text": "インターネットにはソーシャルビューアーがいて、"}, {"type": "subtitle", "time": 1082.669, "timestamp": "00:18:02", "text": "すべて。いいえ、"}, {"type": "subtitle", "time": 1085.35, "timestamp": "00:18:05", "text": "人々は、そう、さまざまな人が"}, {"type": "subtitle", "time": 1088.35, "timestamp": "00:18:08", "text": "彼らのさまざまなもの"}, {"type": "subtitle", "time": 1091.43, "timestamp": "00:18:11", "text": "すべて。えっと、分かりません。つまり、私は"}, {"type": "subtitle", "time": 1093.23, "timestamp": "00:18:13", "text": "しないで"}, {"type": "subtitle", "time": 1096.63, "timestamp": "00:18:16", "text": "心。私は気にしない。ただ私は"}, {"type": "subtitle", "time": 1098.39, "timestamp": "00:18:18", "text": "ハングアウトとかは大丈夫だよ、"}, {"type": "subtitle", "time": 1101.59, "timestamp": "00:18:21", "text": "大丈夫。でも、もしあなたが、えーと、"}, {"type": "subtitle", "time": 1103.35, "timestamp": "00:18:23", "text": "うん、ジョックとコラボするよ"}, {"type": "subtitle", "time": 1106.789, "timestamp": "00:18:26", "text": "影響力とか何か、そうしないといけないだろうな、えっと、"}, {"type": "subtitle", "time": 1109.27, "timestamp": "00:18:29", "text": "申し訳ないが、私は"}, {"type": "subtitle", "time": 1112.35, "timestamp": "00:18:32", "text": "そもそも何の影響力も持っていない。私は"}, {"type": "subtitle", "time": 1116.71, "timestamp": "00:18:36", "text": "誰でもない。そう、もしあなたがそれを期待しているなら"}, {"type": "subtitle", "time": 1121.11, "timestamp": "00:18:41", "text": "ええと、そういうことなら、いいえ。"}, {"type": "subtitle", "time": 1124.23, "timestamp": "00:18:44", "text": "誰が言ったのかは知らないけど、"}, {"type": "subtitle", "time": 1126.95, "timestamp": "00:18:46", "text": "でも、私が話していたとき"}, {"type": "subtitle", "time": 1130.15, "timestamp": "00:18:50", "text": "彼らに対して私は「そうだよバカ、君はこう思う」"}, {"type": "subtitle", "time": 1137.95, "timestamp": "00:18:57", "text": "私が重要でない場所"}]
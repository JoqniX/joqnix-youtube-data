[{"type": "subtitle", "time": 15254.229, "timestamp": "04:14:14", "text": "最後に、私の報酬は、"}, {"type": "subtitle", "time": 15255.149, "timestamp": "04:14:15", "text": "私の"}, {"type": "subtitle", "time": 15263.349, "timestamp": "04:14:23", "text": "行きます。"}, {"type": "subtitle", "time": 15265.51, "timestamp": "04:14:25", "text": "私の意志。"}, {"type": "subtitle", "time": 15267.429, "timestamp": "04:14:27", "text": "いいえ、彼女はあなたを守ってくれません。彼女は"}, {"type": "subtitle", "time": 15271.75, "timestamp": "04:14:31", "text": "殺してやる。私はあなたをOhとして使います、"}, {"type": "subtitle", "time": 15274.389, "timestamp": "04:14:34", "text": "くそ。"}, {"type": "subtitle", "time": 15289.429, "timestamp": "04:14:49", "text": "昨日マラワンパイロをいくつか凍らせて、"}, {"type": "subtitle", "time": 15291.91, "timestamp": "04:14:51", "text": "13人の山賊。戦うことは"}, {"type": "subtitle", "time": 15294.63, "timestamp": "04:14:54", "text": "お菓子作りみたいに、それは間違いないね。しかし"}, {"type": "subtitle", "time": 15296.55, "timestamp": "04:14:56", "text": "選択。ローライは私たちを物資補給に連れて行ってくれた"}, {"type": "subtitle", "time": 15298.149, "timestamp": "04:14:58", "text": "襲撃だったが、途中で捕まってしまった。"}, {"type": "subtitle", "time": 15299.99, "timestamp": "04:14:59", "text": "山賊に襲われ、廃墟となった"}]
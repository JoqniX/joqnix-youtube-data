[{"type": "subtitle", "time": 11406.95, "timestamp": "03:10:06", "text": "さあ、マグカップを手に取ってください。マグカップ。"}, {"type": "subtitle", "time": 11409.429, "timestamp": "03:10:09", "text": "待って、なんて書いてあるの？世界最高の"}, {"type": "subtitle", "time": 11413.19, "timestamp": "03:10:13", "text": "司令官。それは完全に私のものだ。の"}, {"type": "subtitle", "time": 11415.99, "timestamp": "03:10:15", "text": "コーヒー司令官。何てことだ。この野郎。"}, {"type": "subtitle", "time": 11420.389, "timestamp": "03:10:20", "text": "君のせいでコーヒーが台無しになったよ。大した損失ではない。しかし"}, {"type": "subtitle", "time": 11422.87, "timestamp": "03:10:22", "text": "お前、それを盗んだんだよ。この泥棒野郎"}, {"type": "subtitle", "time": 11426.71, "timestamp": "03:10:26", "text": "今。必ず戻ってきますよ。私がその人です"}, {"type": "subtitle", "time": 11431.269, "timestamp": "03:10:31", "text": "そしてコーヒーだけを注文する。"}, {"type": "subtitle", "time": 11433.51, "timestamp": "03:10:33", "text": "唯一無二の司令官だ。うん。"}, {"type": "subtitle", "time": 11437.03, "timestamp": "03:10:37", "text": "ああ、本当に惜しかった。私はほとんど"}, {"type": "subtitle", "time": 11439.03, "timestamp": "03:10:39", "text": "アークトゥルス・スーパーブラックの味を堪能しよう"}, {"type": "subtitle", "time": 11440.95, "timestamp": "03:10:40", "text": "すでに。急いで店に戻ってください。来る"}, {"type": "subtitle", "time": 11450.309, "timestamp": "03:10:50", "text": "待って。何か見落としたことはありますか？私は"}, {"type": "subtitle", "time": 11458.07, "timestamp": "03:10:58", "text": "大丈夫。私も大丈夫です。うん、やってるよ"}]
[{"type": "subtitle", "time": 10746.11, "timestamp": "02:59:06", "text": "ああ、大変だ。何が"}, {"type": "subtitle", "time": 10748.429, "timestamp": "02:59:08", "text": "これ？はぁ？得る"}, {"type": "subtitle", "time": 10755.44, "timestamp": "02:59:15", "text": "この最後の"}, {"type": "subtitle", "time": 10777.59, "timestamp": "02:59:37", "text": "転送が完了しました。ラウライ、"}, {"type": "subtitle", "time": 10779.51, "timestamp": "02:59:39", "text": "ハッキング機能のない手榴弾の設計図"}, {"type": "subtitle", "time": 10783.349, "timestamp": "02:59:43", "text": "すべてあなたのものです。わかった。ありがとう、クイン。私たちは"}, {"type": "subtitle", "time": 10785.19, "timestamp": "02:59:45", "text": "君には借りがあるよ。"}, {"type": "subtitle", "time": 10787.59, "timestamp": "02:59:47", "text": "はい。待って、彼らは帰るの？あ、待って。"}, {"type": "subtitle", "time": 10790.349, "timestamp": "02:59:50", "text": "あの大男。あなた"}, {"type": "subtitle", "time": 10793.269, "timestamp": "02:59:53", "text": "これらのグレネード改造の1つを私の"}, {"type": "subtitle", "time": 10797.309, "timestamp": "02:59:57", "text": "言い方ですね。ありがとう"}]
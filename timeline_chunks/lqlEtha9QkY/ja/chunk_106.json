[{"type": "subtitle", "time": 6367.51, "timestamp": "01:46:07", "text": "そこには。意味が分からないのは分かっていますが、"}, {"type": "subtitle", "time": 6371.51, "timestamp": "01:46:11", "text": "男。スーパーマンはただ待つことができる"}, {"type": "subtitle", "time": 6374.31, "timestamp": "01:46:14", "text": "かわいいカップルたちを見て、私は"}, {"type": "subtitle", "time": 6376.229, "timestamp": "01:46:16", "text": "なんで君たちは"}, {"type": "subtitle", "time": 6378.95, "timestamp": "01:46:18", "text": "恋愛中？人間は非常に有害であり、"}, {"type": "subtitle", "time": 6380.39, "timestamp": "01:46:20", "text": "恥ずかしいけど女の子たちはまだ笑っていて"}, {"type": "subtitle", "time": 6387.229, "timestamp": "01:46:27", "text": "うん。しかし"}, {"type": "subtitle", "time": 6388.91, "timestamp": "01:46:28", "text": "また、"}]
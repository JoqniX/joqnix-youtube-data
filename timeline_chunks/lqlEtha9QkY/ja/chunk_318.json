[{"type": "subtitle", "time": 19081.19, "timestamp": "05:18:01", "text": "ゲームは大人向けだと誰もが知っている"}, {"type": "subtitle", "time": 19082.948, "timestamp": "05:18:02", "text": "脳。愚か者と、邪魔をする子供たち。"}, {"type": "subtitle", "time": 19085.03, "timestamp": "05:18:05", "text": "彼女はただ何かを言っただけだ。一体どうやって"}, {"type": "subtitle", "time": 19088.23, "timestamp": "05:18:08", "text": "あれ、本当にそこまで届いたの？"}, {"type": "subtitle", "time": 19091.11, "timestamp": "05:18:11", "text": "彼女はまさにそれをやった。"}, {"type": "subtitle", "time": 19099.91, "timestamp": "05:18:19", "text": "ねえ、おそらくそれがあなたが"}, {"type": "subtitle", "time": 19101.83, "timestamp": "05:18:21", "text": "探す。それらを私に返してください。"}, {"type": "subtitle", "time": 19104.55, "timestamp": "05:18:24", "text": "私は仕事を続けるかもしれない。ヴォルトハンター。"}, {"type": "subtitle", "time": 19107.03, "timestamp": "05:18:27", "text": "正直、なぜこれを書いたのか時々疑問に思う"}, {"type": "subtitle", "time": 19109.51, "timestamp": "05:18:29", "text": "これらすべてに関わっている。そうだと思います。"}, {"type": "subtitle", "time": 19111.11, "timestamp": "05:18:31", "text": "私にたくさんのアクセスを提供する"}, {"type": "subtitle", "time": 19113.11, "timestamp": "05:18:33", "text": "アリディアンの遺物と豊富な供給"}, {"type": "subtitle", "time": 19116.31, "timestamp": "05:18:36", "text": "被験者。ああ、彼らに電話するべきだった"}, {"type": "subtitle", "time": 19124.23, "timestamp": "05:18:44", "text": "こんにちは。ああ、なぜモクシーがここにいるの？この船。私"}, {"type": "subtitle", "time": 19125.75, "timestamp": "05:18:45", "text": "何がもっと心配なのかわからない"}, {"type": "subtitle", "time": 19127.75, "timestamp": "05:18:47", "text": "蛇口の半分から不凍液が流れ出ている"}]
[{"type": "subtitle", "time": 13980.15, "timestamp": "03:53:00", "text": "ほら、腫瘍頭の視力はクソだ"}, {"type": "subtitle", "time": 13981.91, "timestamp": "03:53:01", "text": "腫瘍の説明だろう、と私は推測する。"}, {"type": "subtitle", "time": 13983.99, "timestamp": "03:53:03", "text": "彼女を騙せるかもしれない。またお会いしましょう"}, {"type": "subtitle", "time": 13986.07, "timestamp": "03:53:06", "text": "隠れ家。"}, {"type": "subtitle", "time": 13988.15, "timestamp": "03:53:08", "text": "わかった。ねえ、気にしないで"}, {"type": "subtitle", "time": 13990.63, "timestamp": "03:53:10", "text": "ブラッドシャイン。この二人は恋をしている"}, {"type": "subtitle", "time": 13992.67, "timestamp": "03:53:12", "text": "罪のない民間人を殺害する。彼らは"}, {"type": "subtitle", "time": 13996.309, "timestamp": "03:53:16", "text": "モンスター。それに、人前でのイチャイチャは気持ち悪い。つまり、"}, {"type": "subtitle", "time": 13998.71, "timestamp": "03:53:18", "text": "いい加減大人になれよ。誰も見たくない"}, {"type": "subtitle", "time": 14000.63, "timestamp": "03:53:20", "text": "それ。"}, {"type": "subtitle", "time": 14004.55, "timestamp": "03:53:24", "text": "こんにちは。さあ、行こう。"}, {"type": "subtitle", "time": 14006.429, "timestamp": "03:53:26", "text": "[音楽]"}, {"type": "subtitle", "time": 14009.51, "timestamp": "03:53:29", "text": "ブラッドシャイン、ダーリン。"}, {"type": "subtitle", "time": 14014.309, "timestamp": "03:53:34", "text": "ああ、彼女は気味が悪い。うん。さよなら。"}, {"type": "subtitle", "time": 14015.75, "timestamp": "03:53:35", "text": "どうぞお入りください。"}, {"type": "subtitle", "time": 14017.59, "timestamp": "03:53:37", "text": "よし、ブラッドシャインのマスクを1つにつけよう"}, {"type": "subtitle", "time": 14019.59, "timestamp": "03:53:39", "text": "ドアのそばに横たわる死体の。それ"}, {"type": "subtitle", "time": 14020.71, "timestamp": "03:53:40", "text": "彼らを騙すには十分だろう"}, {"type": "subtitle", "time": 14023.91, "timestamp": "03:53:43", "text": "入れてあげるよ。Nothing's クルー。願っています"}, {"type": "subtitle", "time": 14025.99, "timestamp": "03:53:45", "text": "ベッドの中では、あなたは"}, {"type": "subtitle", "time": 14032.79, "timestamp": "03:53:52", "text": "いずれは手に入れるだろうが、"}, {"type": "subtitle", "time": 14035.83, "timestamp": "03:53:55", "text": "彼の考え方。"}]
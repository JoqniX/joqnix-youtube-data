[{"type": "subtitle", "time": 2941.43, "timestamp": "00:49:01", "text": "うん。これで完了です。それで、みんな元気？"}, {"type": "subtitle", "time": 2942.51, "timestamp": "00:49:02", "text": "何が"}, {"type": "subtitle", "time": 2947.27, "timestamp": "00:49:07", "text": "立ち上がって、えっと、どうぞ、言ってください"}, {"type": "subtitle", "time": 2961.43, "timestamp": "00:49:21", "text": "ええ、そうですね、結局"}, {"type": "subtitle", "time": 2963.99, "timestamp": "00:49:23", "text": "今日のコラボは、ただ、えっと、ただ"}, {"type": "subtitle", "time": 2966.47, "timestamp": "00:49:26", "text": "夜にのんびりしながら色々なことを考えている"}, {"type": "subtitle", "time": 2968.39, "timestamp": "00:49:28", "text": "ああ、なんてことだ、あなたは何件のコラボをしたのですか"}, {"type": "subtitle", "time": 2972.549, "timestamp": "00:49:32", "text": "何をしなければならないのですか？ええと、1つは招待で"}, {"type": "subtitle", "time": 2975.309, "timestamp": "00:49:35", "text": "自分。うん。うん。まだ計画中です"}, {"type": "subtitle", "time": 2977.829, "timestamp": "00:49:37", "text": "ただし、今月中に。いいえ、まだ"}, {"type": "subtitle", "time": 2979.309, "timestamp": "00:49:39", "text": "それを"}, {"type": "subtitle", "time": 2982.71, "timestamp": "00:49:42", "text": "あなた。なんでこんなに時間が短いんだろう"}, {"type": "subtitle", "time": 2986.39, "timestamp": "00:49:46", "text": "直前の計画は本当に大変だ"}, {"type": "subtitle", "time": 2988.47, "timestamp": "00:49:48", "text": "特に私が連絡を取ったら"}, {"type": "subtitle", "time": 2990.71, "timestamp": "00:49:50", "text": "誰かが、そして彼らはこう言うだろう、あなたは"}, {"type": "subtitle", "time": 2992.47, "timestamp": "00:49:52", "text": "今月は無料ですか？そして彼らはこう言う、私は"}, {"type": "subtitle", "time": 2995.67, "timestamp": "00:49:55", "text": "忙しい。そして私は「ああ、さようなら。私は"}]
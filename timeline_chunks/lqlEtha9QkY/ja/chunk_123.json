[{"type": "subtitle", "time": 7392.43, "timestamp": "02:03:12", "text": "ああ、私を"}, {"type": "subtitle", "time": 7396.27, "timestamp": "02:03:16", "text": "こぶ。いいえ、私が原因ではありません。"}, {"type": "subtitle", "time": 7399.589, "timestamp": "02:03:19", "text": "はぁ？カシのことですか？私"}, {"type": "subtitle", "time": 7401.07, "timestamp": "02:03:21", "text": "原因ではなかった"}, {"type": "subtitle", "time": 7410.31, "timestamp": "02:03:30", "text": "けれど。あなたはバカヨと言いました。うん。それは"}, {"type": "subtitle", "time": 7414.07, "timestamp": "02:03:34", "text": "呪いではないけれど。"}, {"type": "subtitle", "time": 7416.629, "timestamp": "02:03:36", "text": "しかし、それは呪いではない。バカ、それは"}, {"type": "subtitle", "time": 7419.629, "timestamp": "02:03:39", "text": "呪いではない。"}, {"type": "subtitle", "time": 7422.95, "timestamp": "02:03:42", "text": "バカオ、かっこいい言葉だね。それは"}, {"type": "subtitle", "time": 7430.87, "timestamp": "02:03:50", "text": "バカ。非行の極み。何が"}]
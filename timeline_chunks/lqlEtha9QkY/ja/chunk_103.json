[{"type": "subtitle", "time": 6183.51, "timestamp": "01:43:03", "text": "正直。そこにいたんですね。ここがその場所だ"}, {"type": "subtitle", "time": 6186.47, "timestamp": "01:43:06", "text": "私が話していたのはそれです。それはここにありました。"}, {"type": "subtitle", "time": 6212.79, "timestamp": "01:43:32", "text": "場所？どうすればこの場所に入れるのですか？"}, {"type": "subtitle", "time": 6215.43, "timestamp": "01:43:35", "text": "アニメ映画を見るのは、"}, {"type": "subtitle", "time": 6218.229, "timestamp": "01:43:38", "text": "ありきたりで、視覚的な要素もない。それ"}, {"type": "subtitle", "time": 6219.91, "timestamp": "01:43:39", "text": "どこからともなく現れて、"}, {"type": "subtitle", "time": 6234.47, "timestamp": "01:43:54", "text": "ここに来た時のことを覚えていると言って、"}, {"type": "subtitle", "time": 6238.27, "timestamp": "01:43:58", "text": "どこへ行こうかと自問自答しているような感じ"}]
[{"type": "subtitle", "time": 16142.389, "timestamp": "04:29:02", "text": "ああ、ジェニー。ジェニー。私は大きな期待を抱いていました"}, {"type": "subtitle", "time": 16144.79, "timestamp": "04:29:04", "text": "彼女。"}, {"type": "subtitle", "time": 16148.55, "timestamp": "04:29:08", "text": "ローはかなり美人だった。残念な。残念な。"}, {"type": "subtitle", "time": 16153.59, "timestamp": "04:29:13", "text": "最後に、Moxyのトークンを渡した場合。"}, {"type": "subtitle", "time": 16156.229, "timestamp": "04:29:16", "text": "よし。そして、あなたは死んだ。あなたは行く"}, {"type": "subtitle", "time": 16160.87, "timestamp": "04:29:20", "text": "今すぐ死ぬ。このクソオタクめ。私はただ"}, {"type": "subtitle", "time": 16165.75, "timestamp": "04:29:25", "text": "愛されたかった。彼は去った。"}, {"type": "subtitle", "time": 16177.59, "timestamp": "04:29:37", "text": "これ。私はこのまま死ぬのだろう。もし"}, {"type": "subtitle", "time": 16180.11, "timestamp": "04:29:40", "text": "こんな感じ"}]
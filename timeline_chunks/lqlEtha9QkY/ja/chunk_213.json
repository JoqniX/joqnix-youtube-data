[{"type": "subtitle", "time": 12781.269, "timestamp": "03:33:01", "text": "真剣に。彼女の隠れ家へ向かえ。"}, {"type": "subtitle", "time": 12807.19, "timestamp": "03:33:27", "text": "ナメクジの神。つまり、それは女性用のスーツです"}, {"type": "subtitle", "time": 12817.91, "timestamp": "03:33:37", "text": "彼は私たちを見ている。"}, {"type": "subtitle", "time": 12821.389, "timestamp": "03:33:41", "text": "ああ、大変だ。彼は間違いなく"}, {"type": "subtitle", "time": 12823.99, "timestamp": "03:33:43", "text": "見ている。ああ、大変だ。では、待ってください。何が"}, {"type": "subtitle", "time": 12826.71, "timestamp": "03:33:46", "text": "またサイドクエスト？隠れ家へ行き、"}, {"type": "subtitle", "time": 12829.59, "timestamp": "03:33:49", "text": "ケネス。よし、クエストをやろう。彼"}, {"type": "subtitle", "time": 12831.429, "timestamp": "03:33:51", "text": "大量のバッテリー液を飲み始めた"}, {"type": "subtitle", "time": 12834.269, "timestamp": "03:33:54", "text": "上。彼の"}, {"type": "subtitle", "time": 12837.67, "timestamp": "03:33:57", "text": "料金、それでいいアイデアが浮かんだ。持ってくる"}]
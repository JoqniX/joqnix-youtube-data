[{"type": "subtitle", "time": 16382.99, "timestamp": "04:33:02", "text": "ランチャー。えっと、163番ですよね？"}, {"type": "subtitle", "time": 16386.15, "timestamp": "04:33:06", "text": "163. ふむ。"}, {"type": "subtitle", "time": 16395.269, "timestamp": "04:33:15", "text": "これら。これらを売ります。誰もが"}, {"type": "subtitle", "time": 16397.109, "timestamp": "04:33:17", "text": "彼らの"}, {"type": "subtitle", "time": 16399.07, "timestamp": "04:33:19", "text": "それは"}, {"type": "subtitle", "time": 16402.949, "timestamp": "04:33:22", "text": "肌。その[ __ ]は皮膚だ。おお。なんてことだ"}, {"type": "subtitle", "time": 16405.709, "timestamp": "04:33:25", "text": "名前。あなたはなれます。つまり、それはスキンですね。"}, {"type": "subtitle", "time": 16407.869, "timestamp": "04:33:27", "text": "待って。武器"}, {"type": "subtitle", "time": 16411.75, "timestamp": "04:33:31", "text": "肌。私は何もロックを解除しませんでした"}, {"type": "subtitle", "time": 16415.029, "timestamp": "04:33:35", "text": "武器とかそういう類のもの。待って。"}, {"type": "subtitle", "time": 16418.67, "timestamp": "04:33:38", "text": "検査するにはどうすればいいですか？"}, {"type": "subtitle", "time": 16422.709, "timestamp": "04:33:42", "text": "右。ああ、なんてことだ、これは実はうんちだ。"}, {"type": "subtitle", "time": 16425.67, "timestamp": "04:33:45", "text": "一体何なんだこれは？実はうんちだ"}, {"type": "subtitle", "time": 16429.99, "timestamp": "04:33:49", "text": "肌。何？私は自分の"}, {"type": "subtitle", "time": 16433.32, "timestamp": "04:33:53", "text": "私は自分の デフォルト。私はこれで満足です。"}]
[{"type": "subtitle", "time": 3420.87, "timestamp": "00:57:00", "text": "フレームが壊れた"}, {"type": "subtitle", "time": 3425.349, "timestamp": "00:57:05", "text": "ひどく壊れた。ああ"}, {"type": "subtitle", "time": 3428.39, "timestamp": "00:57:08", "text": "兄がそれをうまく直してくれた"}, {"type": "subtitle", "time": 3431.91, "timestamp": "00:57:11", "text": "兄ですが、彼はそのノートパソコンを使っています。"}, {"type": "subtitle", "time": 3434.39, "timestamp": "00:57:14", "text": "彼のノートパソコンはどうなったの？それはそれはそれは"}, {"type": "subtitle", "time": 3436.39, "timestamp": "00:57:16", "text": "まるでゲームを使いたくないみたいだ"}, {"type": "subtitle", "time": 3439.91, "timestamp": "00:57:19", "text": "ノートパソコンはまるで重要だから"}, {"type": "subtitle", "time": 3445.99, "timestamp": "00:57:25", "text": "今年。おお。くそ。"}, {"type": "subtitle", "time": 3457.03, "timestamp": "00:57:37", "text": "私はただオカムノをスクロールしているだけです。"}, {"type": "subtitle", "time": 3459.67, "timestamp": "00:57:39", "text": "オカムノのこと、知ってるよね？日本人"}, {"type": "subtitle", "time": 3462.67, "timestamp": "00:57:42", "text": "壁紙サイト。彼らは良い"}, {"type": "subtitle", "time": 3467.87, "timestamp": "00:57:47", "text": "壁紙。つまり、良い配信でした"}, {"type": "subtitle", "time": 3469.99, "timestamp": "00:57:49", "text": "背景。スクロールしているだけです"}, {"type": "subtitle", "time": 3478.71, "timestamp": "00:57:58", "text": "なんてこった。"}, {"type": "subtitle", "time": 3479.789, "timestamp": "00:57:59", "text": "あなたは"}]
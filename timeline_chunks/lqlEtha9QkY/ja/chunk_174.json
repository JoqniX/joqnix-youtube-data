[{"type": "subtitle", "time": 10440.99, "timestamp": "02:54:00", "text": "好き"}, {"type": "subtitle", "time": 10444.99, "timestamp": "02:54:04", "text": "えっと、これを近接戦闘で壊す。わからない"}, {"type": "subtitle", "time": 10449.349, "timestamp": "02:54:09", "text": "どうやって。待って、バッファリング中です。え、何？"}, {"type": "subtitle", "time": 10450.11, "timestamp": "02:54:10", "text": "その"}, {"type": "subtitle", "time": 10455.79, "timestamp": "02:54:15", "text": "バッファリング。なんてこった。なんてこった。実際は"}, {"type": "subtitle", "time": 10458.469, "timestamp": "02:54:18", "text": "バッファリング。そこにはない。いいえ、違います"}, {"type": "subtitle", "time": 10474.03, "timestamp": "02:54:34", "text": "もう。どのように"}, {"type": "subtitle", "time": 10476.43, "timestamp": "02:54:36", "text": "私が行く？"}, {"type": "subtitle", "time": 10482.11, "timestamp": "02:54:42", "text": "だから私は"}, {"type": "subtitle", "time": 10490.23, "timestamp": "02:54:50", "text": "ボートに乗って呼吸し、注意を引こう。取"}, {"type": "subtitle", "time": 10492.309, "timestamp": "02:54:52", "text": "マイクを離せば、きっとコントを披露してくれるだろう"}, {"type": "subtitle", "time": 10496.469, "timestamp": "02:54:56", "text": "悪い意味で、事態は急変した。"}]
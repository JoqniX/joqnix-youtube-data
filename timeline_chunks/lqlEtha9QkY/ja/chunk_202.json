[{"type": "subtitle", "time": 12121.91, "timestamp": "03:22:01", "text": "わかりました、そうします。さあ行こう。そして"}, {"type": "subtitle", "time": 12124.469, "timestamp": "03:22:04", "text": "個人的な話ですが、マラワン人の男性がいて、"}, {"type": "subtitle", "time": 12126.469, "timestamp": "03:22:06", "text": "ロウ船長は、私に終わりを与えてくれない"}, {"type": "subtitle", "time": 12128.469, "timestamp": "03:22:08", "text": "トラブルの。ピン留めできていません"}, {"type": "subtitle", "time": 12130.229, "timestamp": "03:22:10", "text": "彼を落ち込ませたが、深刻な"}, {"type": "subtitle", "time": 12132.309, "timestamp": "03:22:12", "text": "うん。こんにちは、ノーラ。元気かい？希望"}, {"type": "subtitle", "time": 12133.71, "timestamp": "03:22:13", "text": "あなたはやっている"}, {"type": "subtitle", "time": 12137.229, "timestamp": "03:22:17", "text": "良い。元気かい、"}, {"type": "subtitle", "time": 12139.229, "timestamp": "03:22:19", "text": "D？待って、"}, {"type": "subtitle", "time": 12142.95, "timestamp": "03:22:22", "text": "待って。どうすれば中に入れるのですか？できました"}, {"type": "subtitle", "time": 12147.03, "timestamp": "03:22:27", "text": "こちらへお進みください。うん。"}, {"type": "subtitle", "time": 12150.71, "timestamp": "03:22:30", "text": "左折して"}, {"type": "subtitle", "time": 12152.349, "timestamp": "03:22:32", "text": "[音楽]"}, {"type": "subtitle", "time": 12156.07, "timestamp": "03:22:36", "text": "右。私はそこへ行くことができます"}, {"type": "subtitle", "time": 12163.349, "timestamp": "03:22:43", "text": "信じる。いいえ、できません。"}, {"type": "subtitle", "time": 12178.229, "timestamp": "03:22:58", "text": "私は今、自殺しようとしたのか？ああ、"}]
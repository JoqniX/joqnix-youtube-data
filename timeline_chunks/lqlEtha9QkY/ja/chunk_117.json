[{"type": "subtitle", "time": 7020.2, "timestamp": "01:57:00", "text": "私の心をくすぐる"}, {"type": "subtitle", "time": 7057.55, "timestamp": "01:57:37", "text": "今すぐ。あなたは誰ですか？あなたは何を"}, {"type": "subtitle", "time": 7060.629, "timestamp": "01:57:40", "text": "欲しい？君は僕のNo.だと思う。どうやって"}, {"type": "subtitle", "time": 7070.669, "timestamp": "01:57:50", "text": "わかった。わかった。えっと、会う前に"}, {"type": "subtitle", "time": 7075.149, "timestamp": "01:57:55", "text": "彼女に、これを持ってくるにはこれをしなければならない"}]
[{"type": "subtitle", "time": 3000.549, "timestamp": "00:50:00", "text": "IOともっとコラボレーションしたい。"}, {"type": "subtitle", "time": 3004.15, "timestamp": "00:50:04", "text": "例えば、3月から始めていたとしたら"}, {"type": "subtitle", "time": 3005.91, "timestamp": "00:50:05", "text": "そして全てを計画したが、"}, {"type": "subtitle", "time": 3009.109, "timestamp": "00:50:09", "text": "もっと良かったはずだ。今、私はおそらく"}, {"type": "subtitle", "time": 3011.99, "timestamp": "00:50:11", "text": "来月から無料になります。"}, {"type": "subtitle", "time": 3015.829, "timestamp": "00:50:15", "text": "それで、それで、それで、ああ、そう、話すとき、いつ"}, {"type": "subtitle", "time": 3019.03, "timestamp": "00:50:19", "text": "今月は時間ありますか？今月"}, {"type": "subtitle", "time": 3021.309, "timestamp": "00:50:21", "text": "完全に。おお、"}, {"type": "subtitle", "time": 3025.75, "timestamp": "00:50:25", "text": "ニース。それなら、何か行動を起こすべきだ。うん。"}, {"type": "subtitle", "time": 3029.51, "timestamp": "00:50:29", "text": "私たちはどうすべきでしょうか？何をするか？良い"}, {"type": "subtitle", "time": 3036.79, "timestamp": "00:50:36", "text": "人々、"}, {"type": "subtitle", "time": 3038.87, "timestamp": "00:50:38", "text": "あなたから始めてみませんか？久しぶりですね。"}, {"type": "subtitle", "time": 3040.79, "timestamp": "00:50:40", "text": "いいえ。"}, {"type": "subtitle", "time": 3043.99, "timestamp": "00:50:43", "text": "Stardは長期的な取り組みです。多分"}, {"type": "subtitle", "time": 3046.829, "timestamp": "00:50:46", "text": "私たちならできる。ほら、君はいつも"}, {"type": "subtitle", "time": 3051.19, "timestamp": "00:50:51", "text": "ストリーミング配信だから、理にかなっている。"}, {"type": "subtitle", "time": 3054.87, "timestamp": "00:50:54", "text": "私たちならできる。良いアイデア。それはそうではない"}, {"type": "subtitle", "time": 3056.95, "timestamp": "00:50:56", "text": "常にそうでなければならない。私たちはただ戻ってくることができます"}]
[{"type": "subtitle", "time": 17223.11, "timestamp": "04:47:03", "text": "スクラブ。"}, {"type": "subtitle", "time": 17232.15, "timestamp": "04:47:12", "text": "車で来る人は誰ですか？何？"}, {"type": "subtitle", "time": 17237.43, "timestamp": "04:47:17", "text": "それ？ああ、"}, {"type": "subtitle", "time": 17240.39, "timestamp": "04:47:20", "text": "おい、周りの全部を取り除かなきゃ"}, {"type": "subtitle", "time": 17268.47, "timestamp": "04:47:48", "text": "私はまだマラワンを見ています。彼を排除しろ。"}, {"type": "subtitle", "time": 17271.83, "timestamp": "04:47:51", "text": "はい。もちろんです。やっと"}]
[{"type": "subtitle", "time": 15483.349, "timestamp": "04:18:03", "text": "つまり、あれは台風の警報ボックスではなかったということだ。それは"}, {"type": "subtitle", "time": 15489.429, "timestamp": "04:18:09", "text": "モクシーのクルーは、"}, {"type": "subtitle", "time": 15492.07, "timestamp": "04:18:12", "text": "私たちの出場者たち。どうやら"}, {"type": "subtitle", "time": 15494.59, "timestamp": "04:18:14", "text": "死闘が繰り広げられることになるだろう。"}, {"type": "subtitle", "time": 15510.51, "timestamp": "04:18:30", "text": "連絡先"}, {"type": "subtitle", "time": 15513.349, "timestamp": "04:18:33", "text": "パンドラは相変わらずサイコパスのように戦う。"}, {"type": "subtitle", "time": 15515.389, "timestamp": "04:18:35", "text": "少年、"}, {"type": "subtitle", "time": 15524.429, "timestamp": "04:18:44", "text": "その名前は消え去るだろう。おお"}, {"type": "subtitle", "time": 15529.11, "timestamp": "04:18:49", "text": "ああ、誰もそこから出られない。どうやら"}, {"type": "subtitle", "time": 15530.95, "timestamp": "04:18:50", "text": "誰かが無料で石炭を手に入れることはないだろう"}, {"type": "subtitle", "time": 15535.349, "timestamp": "04:18:55", "text": "足のマッサージ。次回は頑張ってね、トゥルーディ。"}, {"type": "subtitle", "time": 15538.07, "timestamp": "04:18:58", "text": "ごめん。よし、我々は"}]
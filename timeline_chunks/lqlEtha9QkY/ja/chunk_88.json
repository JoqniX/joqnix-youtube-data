[{"type": "subtitle", "time": 5306.92, "timestamp": "01:28:26", "text": "強すぎるのは、"}, {"type": "subtitle", "time": 5308.11, "timestamp": "01:28:28", "text": "[音楽]"}, {"type": "subtitle", "time": 5313.43, "timestamp": "01:28:33", "text": "タイミング。ああ、リセットされたんだ。おお。"}, {"type": "subtitle", "time": 5315.51, "timestamp": "01:28:35", "text": "私は確かに全員殺したが、"}, {"type": "subtitle", "time": 5330.31, "timestamp": "01:28:50", "text": "サス。つまり、私はこれをする必要はないんです。私"}, {"type": "subtitle", "time": 5339.43, "timestamp": "01:28:59", "text": "時間。無駄にするためにこれをする必要はありません"}]
[{"type": "subtitle", "time": 2163.03, "timestamp": "00:36:03", "text": "とても単純な質問ですが、"}, {"type": "subtitle", "time": 2165.349, "timestamp": "00:36:05", "text": "それでブレインストーミングをしてみた"}, {"type": "subtitle", "time": 2167.589, "timestamp": "00:36:07", "text": "まるで3つの方向に行ったみたい"}, {"type": "subtitle", "time": 2171.349, "timestamp": "00:36:11", "text": "正直に言うと、私はそうしません。"}, {"type": "chat", "time": 2172.527, "timestamp": "00:36:12", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "WASSUP"}, {"type": "subtitle", "time": 2174.71, "timestamp": "00:36:14", "text": "直接コラボレーションに招待する"}, {"type": "subtitle", "time": 2177.23, "timestamp": "00:36:17", "text": "すぐに"}, {"type": "subtitle", "time": 2181.589, "timestamp": "00:36:21", "text": "いや、ごめん、私は行かなきゃいけない"}, {"type": "subtitle", "time": 2184.23, "timestamp": "00:36:24", "text": "君のことを知っているよ。背景を描く必要がある"}, {"type": "subtitle", "time": 2187.51, "timestamp": "00:36:27", "text": "私たちが自分たちの雰囲気を本当に気に入っているかどうか確認する"}, {"type": "subtitle", "time": 2191.43, "timestamp": "00:36:31", "text": "相性が良い。うん、"}, {"type": "subtitle", "time": 2193.43, "timestamp": "00:36:33", "text": "それには多くの層があり、"}, {"type": "subtitle", "time": 2195.75, "timestamp": "00:36:35", "text": "私は通常、誰とコラボレーションするかを次のように決めます"}, {"type": "subtitle", "time": 2197.589, "timestamp": "00:36:37", "text": "雰囲気。"}, {"type": "subtitle", "time": 2202.71, "timestamp": "00:36:42", "text": "うん。もし私がそうしたら、ああ、ほら、そこに"}, {"type": "subtitle", "time": 2205.51, "timestamp": "00:36:45", "text": "とてもおしゃべりな人もいます"}, {"type": "subtitle", "time": 2207.67, "timestamp": "00:36:47", "text": "そして、とても"}, {"type": "subtitle", "time": 2211.27, "timestamp": "00:36:51", "text": "低エネルギー。それはあなたの性格によります"}, {"type": "subtitle", "time": 2214.63, "timestamp": "00:36:54", "text": "一緒に何かを成し遂げることができる。私の"}, {"type": "subtitle", "time": 2217.49, "timestamp": "00:36:57", "text": "それが私の判断基準です。"}, {"type": "subtitle", "time": 2219.829, "timestamp": "00:36:59", "text": "[音楽]"}]
[{"type": "subtitle", "time": 11580.63, "timestamp": "03:13:00", "text": "理解する。落ち着いてください。うん、君"}, {"type": "subtitle", "time": 11598.79, "timestamp": "03:13:18", "text": "[音楽]"}, {"type": "subtitle", "time": 11602.19, "timestamp": "03:13:22", "text": "こんにちは。ええ、ただコーヒーを飲みに行っただけです。全て"}, {"type": "subtitle", "time": 11605.91, "timestamp": "03:13:25", "text": "コーヒー一杯のために、こんなにたくさんの任務をこなさなければならないなんて。"}, {"type": "subtitle", "time": 11612.95, "timestamp": "03:13:32", "text": "はい、どうぞ。"}, {"type": "subtitle", "time": 11617.95, "timestamp": "03:13:37", "text": "あなたは私にとって一番大切な人です。これはとても"}, {"type": "subtitle", "time": 11621.59, "timestamp": "03:13:41", "text": "必要。やあ、アトラスのみんな。上昇中"}, {"type": "subtitle", "time": 11623.59, "timestamp": "03:13:43", "text": "グライムスがビジネスに復帰し、"}, {"type": "subtitle", "time": 11627.349, "timestamp": "03:13:47", "text": "コーヒーは私のおごりです。ああ、もちろんさ。のために"}, {"type": "subtitle", "time": 11629.83, "timestamp": "03:13:49", "text": "本物？ありがとう、ローラ。ああ、彼は彼女は"}, {"type": "subtitle", "time": 11631.309, "timestamp": "03:13:51", "text": "治療"}, {"type": "subtitle", "time": 11635.67, "timestamp": "03:13:55", "text": "みんな。私は決してそれを追求することを諦めない。"}, {"type": "subtitle", "time": 11639.19, "timestamp": "03:13:59", "text": "ああ、くそったれ。マラワンがここにいる。来て"}]
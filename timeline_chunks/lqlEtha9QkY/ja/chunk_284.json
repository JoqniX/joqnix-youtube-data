[{"type": "subtitle", "time": 17042.55, "timestamp": "04:44:02", "text": "あれ。そして、あなたを追加する必要があります"}, {"type": "subtitle", "time": 17044.35, "timestamp": "04:44:04", "text": "ここ。"}, {"type": "subtitle", "time": 17046.11, "timestamp": "04:44:06", "text": "右。"}, {"type": "subtitle", "time": 17060.51, "timestamp": "04:44:20", "text": "えっと、会いました"}, {"type": "subtitle", "time": 17064.07, "timestamp": "04:44:24", "text": "マヤはただの嫌な奴だ。ここはどこですか？その"}, {"type": "subtitle", "time": 17065.708, "timestamp": "04:44:25", "text": "聖域にて。"}, {"type": "subtitle", "time": 17071.47, "timestamp": "04:44:31", "text": "わかった。この王朝の晩餐会は"}, {"type": "subtitle", "time": 17073.39, "timestamp": "04:44:33", "text": "場所"}, {"type": "subtitle", "time": 17084.23, "timestamp": "04:44:44", "text": "わかった。"}, {"type": "subtitle", "time": 17099.07, "timestamp": "04:44:59", "text": "[音楽]"}]
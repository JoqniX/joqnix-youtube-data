[{"type": "subtitle", "time": 6001.59, "timestamp": "01:40:01", "text": "私以外のあなたと私について話している"}, {"type": "subtitle", "time": 6003.27, "timestamp": "01:40:03", "text": "いとこ。私はまだ見つけたと感じていません"}, {"type": "subtitle", "time": 6006.35, "timestamp": "01:40:06", "text": "これまで言及してきた内容にはまだ空白があります。"}, {"type": "subtitle", "time": 6008.91, "timestamp": "01:40:08", "text": "正直に言うと"}, {"type": "subtitle", "time": 6012.79, "timestamp": "01:40:12", "text": "あなた、私の友達全員、私が"}, {"type": "subtitle", "time": 6014.95, "timestamp": "01:40:14", "text": "私はアニメについて話しました、彼らは"}, {"type": "subtitle", "time": 6017.629, "timestamp": "01:40:17", "text": "なんだか変な感じだった。だから私は"}, {"type": "subtitle", "time": 6020.83, "timestamp": "01:40:20", "text": "GLへ"}, {"type": "subtitle", "time": 6025.669, "timestamp": "01:40:25", "text": "もの。でも、でも、そして、これがありました"}, {"type": "subtitle", "time": 6028.79, "timestamp": "01:40:28", "text": "アニメグループの皆さん。彼らはまた"}, {"type": "subtitle", "time": 6031.99, "timestamp": "01:40:31", "text": "「お前は煽ってるの？」"}, {"type": "subtitle", "time": 6035.35, "timestamp": "01:40:35", "text": "えーと、デンデンとか。だから私はもっと"}, {"type": "subtitle", "time": 6038.149, "timestamp": "01:40:38", "text": "いつか話せるグループが見つかるだろうか"}, {"type": "subtitle", "time": 6040.95, "timestamp": "01:40:40", "text": "この件について、ついに一つ見つけました。彼らは"}, {"type": "subtitle", "time": 6043.83, "timestamp": "01:40:43", "text": "BLについて話す。だから私はまだ探している"}, {"type": "subtitle", "time": 6048.189, "timestamp": "01:40:48", "text": "GL関連のことですが、"}, {"type": "subtitle", "time": 6051.31, "timestamp": "01:40:51", "text": "ゆっくりと"}, {"type": "subtitle", "time": 6054.55, "timestamp": "01:40:54", "text": "それ。でも、ええ、私たちはカイイシが大好きです"}, {"type": "subtitle", "time": 6056.709, "timestamp": "01:40:56", "text": "すべてについて話すことができるので、"}]
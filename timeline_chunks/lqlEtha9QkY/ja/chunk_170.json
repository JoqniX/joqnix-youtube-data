[{"type": "subtitle", "time": 10201.03, "timestamp": "02:50:01", "text": "あといくつかテストを実行する必要がある"}, {"type": "subtitle", "time": 10204.07, "timestamp": "02:50:04", "text": "私のノグの被験者たち。そしてノグのハッキング"}, {"type": "subtitle", "time": 10207.429, "timestamp": "02:50:07", "text": "対象とする。"}, {"type": "subtitle", "time": 10210.55, "timestamp": "02:50:10", "text": "何？私のエッグスはどこ？"}, {"type": "subtitle", "time": 10213.269, "timestamp": "02:50:13", "text": "彼らは戦闘中に逃げ出したに違いない。"}, {"type": "subtitle", "time": 10220.07, "timestamp": "02:50:20", "text": "外では武器が降り注いでいるのに、君は私を見ている"}, {"type": "subtitle", "time": 10222.07, "timestamp": "02:50:22", "text": "朝から晩まで汗だく。おお"}, {"type": "subtitle", "time": 10224.15, "timestamp": "02:50:24", "text": "いいえ。ユニークな車両を製作する"}, {"type": "subtitle", "time": 10227.59, "timestamp": "02:50:27", "text": "近く。うん。ええと、この期間、7月ですね"}, {"type": "subtitle", "time": 10229.75, "timestamp": "02:50:29", "text": "えーっと、6月7月この期間は、"}, {"type": "subtitle", "time": 10231.79, "timestamp": "02:50:31", "text": "雨天"}, {"type": "subtitle", "time": 10235.67, "timestamp": "02:50:35", "text": "ここ。時々、もしそれが多すぎると"}, {"type": "subtitle", "time": 10244.07, "timestamp": "02:50:44", "text": "血まみれになる。"}, {"type": "subtitle", "time": 10246.95, "timestamp": "02:50:46", "text": "うん。こんにちは、アディティさん。いらっしゃいませ。いらっしゃいませ。"}, {"type": "subtitle", "time": 10249.55, "timestamp": "02:50:49", "text": "良い一日をお過ごしください"}, {"type": "subtitle", "time": 10252.71, "timestamp": "02:50:52", "text": "日。お元気でお過ごしでしょうか。先ほども言いました。"}, {"type": "subtitle", "time": 10255.19, "timestamp": "02:50:55", "text": "その車を取りに行ってくれ。"}, {"type": "subtitle", "time": 10257.71, "timestamp": "02:50:57", "text": "こんにちは。こんにちは。受け取ります"}]
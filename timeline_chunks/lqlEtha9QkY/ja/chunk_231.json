[{"type": "subtitle", "time": 13862.63, "timestamp": "03:51:02", "text": "ここで何が起こるか。"}, {"type": "subtitle", "time": 13864.67, "timestamp": "03:51:04", "text": "営業中です。"}, {"type": "subtitle", "time": 13867.189, "timestamp": "03:51:07", "text": "わかった。滑り込みたかったけど、"}, {"type": "subtitle", "time": 13869.59, "timestamp": "03:51:09", "text": "できなかった。"}, {"type": "subtitle", "time": 13872.469, "timestamp": "03:51:12", "text": "警官を全滅させたのか。むしろ"}, {"type": "subtitle", "time": 13877.269, "timestamp": "03:51:17", "text": "血の輝きが起こったら、私は"}, {"type": "subtitle", "time": 13883.83, "timestamp": "03:51:23", "text": "だって、私は恋をしているから。"}, {"type": "subtitle", "time": 13901.189, "timestamp": "03:51:41", "text": "何てことだ。私はここで死ぬかもしれない。ああ、私は"}, {"type": "subtitle", "time": 13902.83, "timestamp": "03:51:42", "text": "二度目のチャンス。"}, {"type": "subtitle", "time": 13906.309, "timestamp": "03:51:46", "text": "ニース。そうします。そして、あなたは死ぬ。あなたも"}, {"type": "subtitle", "time": 13916.63, "timestamp": "03:51:56", "text": "ベイビー、私を助けてくれる人手はある？"}, {"type": "subtitle", "time": 13919.349, "timestamp": "03:51:59", "text": "私はここにいます。"}]
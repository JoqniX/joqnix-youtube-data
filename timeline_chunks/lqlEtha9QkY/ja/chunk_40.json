[{"type": "subtitle", "time": 2400.47, "timestamp": "00:40:00", "text": "正直に。ええ、そうです。こんにちは、アストラ。"}, {"type": "subtitle", "time": 2402.55, "timestamp": "00:40:02", "text": "いらっしゃいませ。"}, {"type": "subtitle", "time": 2404.71, "timestamp": "00:40:04", "text": "サブ目標はいつ達成しますか？"}, {"type": "subtitle", "time": 2408.63, "timestamp": "00:40:08", "text": "方法？サブ目標。あれは効果がなかった"}, {"type": "subtitle", "time": 2410.23, "timestamp": "00:40:10", "text": "外。"}, {"type": "subtitle", "time": 2414.87, "timestamp": "00:40:14", "text": "なぜ？だってビジネスだけなんだから、うん、私は"}, {"type": "subtitle", "time": 2418.069, "timestamp": "00:40:18", "text": "ちょっと失敗しちゃった"}, {"type": "subtitle", "time": 2420.23, "timestamp": "00:40:20", "text": "ポイント。私は「わかった、わかった。私は"}, {"type": "subtitle", "time": 2421.829, "timestamp": "00:40:21", "text": "もう二度とやらない。そうではありません"}, {"type": "subtitle", "time": 2424.71, "timestamp": "00:40:24", "text": "仕事中。何だって？"}, {"type": "subtitle", "time": 2426.39, "timestamp": "00:40:26", "text": "だからあなたは持って来るべきではなかった"}, {"type": "subtitle", "time": 2430.069, "timestamp": "00:40:30", "text": "2,000ルピー1つ。代わりに"}, {"type": "subtitle", "time": 2433.43, "timestamp": "00:40:33", "text": "もっと良いものに投資した。"}, {"type": "subtitle", "time": 2436.15, "timestamp": "00:40:36", "text": "叱ってごめんなさい。ごめん。いいえ"}, {"type": "subtitle", "time": 2438.47, "timestamp": "00:40:38", "text": "心配事。恐れる必要はありません。私は言っていた"}, {"type": "subtitle", "time": 2440.71, "timestamp": "00:40:40", "text": "ジョー、これは買わないで。これは買わない方がいい。私"}, {"type": "subtitle", "time": 2444.15, "timestamp": "00:40:44", "text": "そもそも必要だとは思わない。そしてジョック"}, {"type": "subtitle", "time": 2450.829, "timestamp": "00:40:50", "text": "生意気なガキ。"}]
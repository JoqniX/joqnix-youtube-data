[{"type": "subtitle", "time": 18962.17, "timestamp": "05:16:02", "text": "それ。私もこれを送ります"}, {"type": "subtitle", "time": 18970.31, "timestamp": "05:16:10", "text": "あのね？私たちは、"}, {"type": "subtitle", "time": 18980.55, "timestamp": "05:16:20", "text": "ああ、そこにいたんですね。"}, {"type": "subtitle", "time": 18984.15, "timestamp": "05:16:24", "text": "わかった。つまり、私が必要としていないものはこれです。"}, {"type": "subtitle", "time": 18986.628, "timestamp": "05:16:26", "text": "いつもご利用いただきありがとうございます。私"}, {"type": "subtitle", "time": 18998.31, "timestamp": "05:16:38", "text": "全部一箇所で使い切ります。を除外する"}, {"type": "subtitle", "time": 19004.47, "timestamp": "05:16:44", "text": "というわけで、良いサブマシンガンを手に入れました。だから、私は選択できます"}, {"type": "subtitle", "time": 19008.03, "timestamp": "05:16:48", "text": "他のSMGは売り切れです"}, {"type": "subtitle", "time": 19016.628, "timestamp": "05:16:56", "text": "実際、これはこうだ。ポケットを明るくする"}]
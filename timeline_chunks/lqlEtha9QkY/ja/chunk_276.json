[{"type": "subtitle", "time": 16562.39, "timestamp": "04:36:02", "text": "いい、いい、高レベルの武器。うん。"}, {"type": "subtitle", "time": 16564.07, "timestamp": "04:36:04", "text": "ごめんね、ジョー。早く寝ないと"}, {"type": "subtitle", "time": 16566.47, "timestamp": "04:36:06", "text": "私は病気です。今、気分が悪いです。"}, {"type": "subtitle", "time": 16568.91, "timestamp": "04:36:08", "text": "こんにちは。世話をする"}, {"type": "subtitle", "time": 16570.869, "timestamp": "04:36:10", "text": "あなた自身。そして、あなたの"}, {"type": "subtitle", "time": 16593.869, "timestamp": "04:36:33", "text": "だから、コスチュームマークを上に付ける必要がある"}, {"type": "subtitle", "time": 16605.189, "timestamp": "04:36:45", "text": "他の人に頼んでください。敵が多い。私"}, {"type": "subtitle", "time": 16606.709, "timestamp": "04:36:46", "text": "全部スキップしたい。私はほしくない"}, {"type": "subtitle", "time": 16609.029, "timestamp": "04:36:49", "text": "時間を無駄にする"}, {"type": "subtitle", "time": 16611.83, "timestamp": "04:36:51", "text": "彼らと戦う。一人ひとりが。あなた、"}, {"type": "subtitle", "time": 16615.99, "timestamp": "04:36:55", "text": "私は死ぬまで戦う。いいえ、私は"}]
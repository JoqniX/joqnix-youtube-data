[{"type": "subtitle", "time": 19320.39, "timestamp": "05:22:00", "text": "署名はそのまま残っている。モーリス、君は"}, {"type": "subtitle", "time": 19322.708, "timestamp": "05:22:02", "text": "私のお気に入り。"}, {"type": "subtitle", "time": 19325.51, "timestamp": "05:22:05", "text": "私には理解できない。さあ"}, {"type": "subtitle", "time": 19338.31, "timestamp": "05:22:18", "text": "そして、皆さんが水分補給をして"}, {"type": "subtitle", "time": 19373.91, "timestamp": "05:22:53", "text": "[音楽]"}]
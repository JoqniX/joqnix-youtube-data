[{"type": "subtitle", "time": 2702.069, "timestamp": "00:45:02", "text": "魅力的なタイトルですね。わかった。私の"}, {"type": "subtitle", "time": 2704.79, "timestamp": "00:45:04", "text": "モデレーターの方々がこれを提案してくれました。わかった。コピー"}, {"type": "subtitle", "time": 2707.349, "timestamp": "00:45:07", "text": "あなたが見るもの。基本的には、"}, {"type": "subtitle", "time": 2710.63, "timestamp": "00:45:10", "text": "見る。コピーするのは悪いことだと分かっているけど、"}, {"type": "subtitle", "time": 2714.309, "timestamp": "00:45:14", "text": "インスピレーションは悪いものではない。そしてインスピレーション"}, {"type": "subtitle", "time": 2717.069, "timestamp": "00:45:17", "text": "多くのユーチューバーが"}, {"type": "subtitle", "time": 2720.63, "timestamp": "00:45:20", "text": "人気のある。ああ。"}, {"type": "subtitle", "time": 2723.67, "timestamp": "00:45:23", "text": "だから、ビデオを作るなら、"}, {"type": "subtitle", "time": 2726.23, "timestamp": "00:45:26", "text": "タイトルにも、そして必要ありません"}, {"type": "subtitle", "time": 2727.15, "timestamp": "00:45:27", "text": "持っている"}, {"type": "subtitle", "time": 2731.03, "timestamp": "00:45:31", "text": "完璧なサムネイル。わかった。"}, {"type": "subtitle", "time": 2733.109, "timestamp": "00:45:33", "text": "私のサムネイルを見てください。わかった。彼らです"}, {"type": "subtitle", "time": 2736.63, "timestamp": "00:45:36", "text": "完全に脳死状態。"}, {"type": "subtitle", "time": 2739.75, "timestamp": "00:45:39", "text": "なんでこんなに可愛いんだろう？"}, {"type": "subtitle", "time": 2743.91, "timestamp": "00:45:43", "text": "うん。だから、あなたはただ知っているようにするだけです"}, {"type": "subtitle", "time": 2747.349, "timestamp": "00:45:47", "text": "ええと、彼らは何らかの点で際立っています。"}, {"type": "subtitle", "time": 2750.23, "timestamp": "00:45:50", "text": "人々は、目立つものが好きなのを知ってるよね。"}, {"type": "subtitle", "time": 2753.51, "timestamp": "00:45:53", "text": "彼らに伝える。うん。"}, {"type": "subtitle", "time": 2756.15, "timestamp": "00:45:56", "text": "また、魅力的な"}, {"type": "subtitle", "time": 2758.71, "timestamp": "00:45:58", "text": "タイトルはタイトルとサムネイルでもあります"}]
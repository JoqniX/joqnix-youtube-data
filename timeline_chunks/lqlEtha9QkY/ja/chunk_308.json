[{"type": "subtitle", "time": 18483.91, "timestamp": "05:08:03", "text": "幸先の良いスタートを切ったようだ"}, {"type": "subtitle", "time": 18513.67, "timestamp": "05:08:33", "text": "戻ってきました。戻ってきました。戻ってきました。戻ってきました。"}, {"type": "subtitle", "time": 18517.19, "timestamp": "05:08:37", "text": "行く。行く。行く。行く。 H. 私はただ見てみれば"}, {"type": "subtitle", "time": 18520.23, "timestamp": "05:08:40", "text": "犬。犬はかなり遅れていた。さあ、来てください"}, {"type": "subtitle", "time": 18520.91, "timestamp": "05:08:40", "text": "で"}, {"type": "subtitle", "time": 18524.628, "timestamp": "05:08:44", "text": "今。ああ、大変だ。なぜ私はここにいたのか なぜ私はここにいたのか"}, {"type": "subtitle", "time": 18527.35, "timestamp": "05:08:47", "text": "また？うん。これらの商品を売って"}, {"type": "subtitle", "time": 18530.47, "timestamp": "05:08:50", "text": "戻ってきます。こんにちは。ええ、そうです。こんにちは。いらっしゃいませ、"}, {"type": "subtitle", "time": 18534.47, "timestamp": "05:08:54", "text": "いらっしゃいませ。それを覚えておいてください。こんにちは。こんにちは。えっと、"}, {"type": "subtitle", "time": 18539.19, "timestamp": "05:08:59", "text": "私：こんにちは。出発前にいくつか物を売っておきましょう。"}]
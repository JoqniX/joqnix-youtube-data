[{"type": "subtitle", "time": 6501.59, "timestamp": "01:48:21", "text": "よし、そこは私たちが必要としていた場所の一つだ"}, {"type": "subtitle", "time": 6502.83, "timestamp": "01:48:22", "text": "に"}, {"type": "subtitle", "time": 6513.03, "timestamp": "01:48:33", "text": "先ほどあちらにあったもの。私たちも行きます"}, {"type": "subtitle", "time": 6515.07, "timestamp": "01:48:35", "text": "そこに戻ります。つまり、これがもう一つ"}, {"type": "subtitle", "time": 6522.03, "timestamp": "01:48:42", "text": "感じるもの"}, {"type": "subtitle", "time": 6529.35, "timestamp": "01:48:49", "text": "わかった、あのね？やってみよう"}, {"type": "subtitle", "time": 6532.229, "timestamp": "01:48:52", "text": "パズルとかそういうもの。ロックを解除しましょう"}]
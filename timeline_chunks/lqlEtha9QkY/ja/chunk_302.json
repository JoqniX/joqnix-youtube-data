[{"type": "subtitle", "time": 18129.59, "timestamp": "05:02:09", "text": "ボディーは両手を上げて走っているのか"}, {"type": "subtitle", "time": 18130.43, "timestamp": "05:02:10", "text": "で"}, {"type": "subtitle", "time": 18134.788, "timestamp": "05:02:14", "text": "パニック？ああ、それはとてもかわいいですね。"}, {"type": "subtitle", "time": 18141.628, "timestamp": "05:02:21", "text": "そして、このBとは誰なのか？"}, {"type": "subtitle", "time": 18146.47, "timestamp": "05:02:26", "text": "射撃？あ、待って。それが配達です。"}, {"type": "subtitle", "time": 18149.35, "timestamp": "05:02:29", "text": "それなら受けられます。どうもありがとうございます。"}, {"type": "subtitle", "time": 18152.788, "timestamp": "05:02:32", "text": "すぐ行くよ、坊や。"}, {"type": "subtitle", "time": 18156.07, "timestamp": "05:02:36", "text": "さあ、あの野郎を捕まえろ。"}, {"type": "subtitle", "time": 18165.99, "timestamp": "05:02:45", "text": "ああ、私たちは「イェー」に行かなければならない。うん。"}, {"type": "subtitle", "time": 18168.03, "timestamp": "05:02:48", "text": "待って、待って、待って、待って、待って。する必要がある"}, {"type": "subtitle", "time": 18170.628, "timestamp": "05:02:50", "text": "起きる。起き上がらなきゃ。ああ、神様。おお"}, {"type": "subtitle", "time": 18172.15, "timestamp": "05:02:52", "text": "神。ああ、神様。遅刻だ。遅刻だ。私は"}, {"type": "subtitle", "time": 18174.12, "timestamp": "05:02:54", "text": "遅い。"}, {"type": "subtitle", "time": 18177.03, "timestamp": "05:02:57", "text": "[音楽]"}]
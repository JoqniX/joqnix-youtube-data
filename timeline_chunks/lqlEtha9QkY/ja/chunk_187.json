[{"type": "subtitle", "time": 11223.99, "timestamp": "03:07:03", "text": "米を挽く。さあ、これを進めよう"}, {"type": "subtitle", "time": 11229.429, "timestamp": "03:07:09", "text": "私たちはこの男と話をした。ずっと欲しかった"}, {"type": "subtitle", "time": 11237.75, "timestamp": "03:07:17", "text": "つまり、動力炉の内部です。"}, {"type": "subtitle", "time": 11239.99, "timestamp": "03:07:19", "text": "良い一日を。"}, {"type": "subtitle", "time": 11241.99, "timestamp": "03:07:21", "text": "いいね。良い。いいね。すごくかっこいい。さあ、ヒット"}, {"type": "subtitle", "time": 11243.75, "timestamp": "03:07:23", "text": "鐘。これによりショップが削除されるか、"}, {"type": "subtitle", "time": 11248.15, "timestamp": "03:07:28", "text": "何でも。そして私の顔の紅潮。"}, {"type": "subtitle", "time": 11254.79, "timestamp": "03:07:34", "text": "おお、お店の電源が入った。それをもらえますか？"}, {"type": "subtitle", "time": 11258.389, "timestamp": "03:07:38", "text": "バリスタボットさん、コーヒーをください。ああ、もう。缶なし"}, {"type": "subtitle", "time": 11262.15, "timestamp": "03:07:42", "text": "する。それは無理です。なぜ？ほら、だから"}, {"type": "subtitle", "time": 11265.51, "timestamp": "03:07:45", "text": "持ち帰り用のカップはご自身でご用意ください。 W"}, {"type": "subtitle", "time": 11268.15, "timestamp": "03:07:48", "text": "まったく、くだらない。"}, {"type": "subtitle", "time": 11270.07, "timestamp": "03:07:50", "text": "待って、待って。知っている。マラワンがある"}, {"type": "subtitle", "time": 11271.83, "timestamp": "03:07:51", "text": "いつもトラベルマグを持ち歩いている司令官"}, {"type": "subtitle", "time": 11274.23, "timestamp": "03:07:54", "text": "彼について。彼を探し出せるかどうか試してみてください。 A"}, {"type": "subtitle", "time": 11276.15, "timestamp": "03:07:56", "text": "トラベルマグ？正直言って、カフェイン入りの"}, {"type": "subtitle", "time": 11278.309, "timestamp": "03:07:58", "text": "下水ジュースをマラワンではコーヒーと呼ぶ"}]
[{"type": "subtitle", "time": 9961.349, "timestamp": "02:46:01", "text": "完全に無限の銃であり、"}, {"type": "subtitle", "time": 9963.15, "timestamp": "02:46:03", "text": "銃がある"}, {"type": "subtitle", "time": 9968.03, "timestamp": "02:46:08", "text": "えーっと、えーっと、なんて言うんだっけ？"}, {"type": "subtitle", "time": 9971.349, "timestamp": "02:46:11", "text": "ええと、普通の銃があります"}, {"type": "subtitle", "time": 9974.309, "timestamp": "02:46:14", "text": "防具や装備、能力など。そういう人もいる"}, {"type": "subtitle", "time": 9976.99, "timestamp": "02:46:16", "text": "さらなる被害など。これは"}, {"type": "subtitle", "time": 9979.389, "timestamp": "02:46:19", "text": "いいね。それは"}, {"type": "subtitle", "time": 9984.71, "timestamp": "02:46:24", "text": "いいね。私の自転車みたいなやつを持って行こう。"}, {"type": "subtitle", "time": 9987.21, "timestamp": "02:46:27", "text": "未来的な"}, {"type": "subtitle", "time": 9989.15, "timestamp": "02:46:29", "text": "[音楽]"}, {"type": "subtitle", "time": 9997.95, "timestamp": "02:46:37", "text": "それ。私はできません"}, {"type": "subtitle", "time": 10000.95, "timestamp": "02:46:40", "text": "行く。また、このゲームの運転は"}, {"type": "subtitle", "time": 10008.91, "timestamp": "02:46:48", "text": "痛み。"}, {"type": "subtitle", "time": 10012.429, "timestamp": "02:46:52", "text": "[音楽]"}, {"type": "subtitle", "time": 10014.87, "timestamp": "02:46:54", "text": "うん。うん。ええと、ほんの一部ですが"}, {"type": "subtitle", "time": 10018.95, "timestamp": "02:46:58", "text": "ぼやけている。そう、あのぼやけ具合が嫌いなんだ。"}]
[{"type": "subtitle", "time": 7141.99, "timestamp": "01:59:01", "text": "内部。だから、いくつかの家に侵入する必要がある"}, {"type": "subtitle", "time": 7143.07, "timestamp": "01:59:03", "text": "私"}, {"type": "subtitle", "time": 7159.149, "timestamp": "01:59:19", "text": "どこへ行くべきか、しかし待つ"}, {"type": "subtitle", "time": 7163.31, "timestamp": "01:59:23", "text": "上。そこは開けた場所ですか？"}, {"type": "subtitle", "time": 7167.629, "timestamp": "01:59:27", "text": "待って、私ならできるよ。ああ、待って。営業していません。"}, {"type": "subtitle", "time": 7170.55, "timestamp": "01:59:30", "text": "よし、どこかに私が"}, {"type": "subtitle", "time": 7178.39, "timestamp": "01:59:38", "text": "[音楽]"}, {"type": "subtitle", "time": 7190.55, "timestamp": "01:59:50", "text": "そこには。スマートとは何か？ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 7192.31, "timestamp": "01:59:52", "text": "新しい単語を学ぶ。フラッフとは何ですか？待って、"}, {"type": "subtitle", "time": 7193.99, "timestamp": "01:59:53", "text": "私は「フラッフ」が何なのかを知りました。何が"}, {"type": "subtitle", "time": 7199.51, "timestamp": "01:59:59", "text": "ごめんなさい。忘れた。説明します、そして"}]
[{"type": "subtitle", "time": 17400.47, "timestamp": "04:50:00", "text": "戻る。すべて正常に動作しています。"}, {"type": "subtitle", "time": 17401.99, "timestamp": "04:50:01", "text": "こんにちは。すべて順調に進んでいます、"}, {"type": "subtitle", "time": 17413.51, "timestamp": "04:50:13", "text": "メイト。急いでやらなきゃいけないことがある。"}, {"type": "subtitle", "time": 17422.35, "timestamp": "04:50:22", "text": "秒"}, {"type": "subtitle", "time": 17425.51, "timestamp": "04:50:25", "text": "えっと、こんにちは。私たちは戻ってきました。ちょっと待って、ちょっと待って、"}, {"type": "subtitle", "time": 17427.67, "timestamp": "04:50:27", "text": "ちょっと待って、ちょっと待って。これを直させてください"}, {"type": "subtitle", "time": 17436.708, "timestamp": "04:50:36", "text": "ゲーム。右。そして私は自分の"}, {"type": "subtitle", "time": 17439.23, "timestamp": "04:50:39", "text": "考え。待って、これは"}, {"type": "subtitle", "time": 17441.948, "timestamp": "04:50:41", "text": "これ？検出しました"}, {"type": "subtitle", "time": 17445.23, "timestamp": "04:50:45", "text": "クラウド構成。おお"}, {"type": "subtitle", "time": 17447.788, "timestamp": "04:50:47", "text": "いいえ。"}, {"type": "subtitle", "time": 17457.31, "timestamp": "04:50:57", "text": "わかった。私は再び退学処分にするだろう。えっと、"}]
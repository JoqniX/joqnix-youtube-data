[{"type": "subtitle", "time": 15722.389, "timestamp": "04:22:02", "text": "うん。はい、ほとんどのものは揃いました。私たちは"}, {"type": "subtitle", "time": 15725.79, "timestamp": "04:22:05", "text": "商品を売る必要がある。そして"}, {"type": "subtitle", "time": 15728.389, "timestamp": "04:22:08", "text": "うん、サイドクエスト３つ全部クリアしたよ"}, {"type": "subtitle", "time": 15731.389, "timestamp": "04:22:11", "text": "この場所でこの"}, {"type": "subtitle", "time": 15735.03, "timestamp": "04:22:15", "text": "地図。ああ、これは"}, {"type": "subtitle", "time": 15736.87, "timestamp": "04:22:16", "text": "最後の1つ。カニを狩ることは"}, {"type": "subtitle", "time": 15739.11, "timestamp": "04:22:19", "text": "危険な仕事。うん、それが最後だった"}, {"type": "subtitle", "time": 15741.99, "timestamp": "04:22:21", "text": "プラン。おい、あのエリアは立ち入り禁止だぞ。"}, {"type": "subtitle", "time": 15744.149, "timestamp": "04:22:24", "text": "どこに行くの？それはマルクスと"}, {"type": "subtitle", "time": 15748.87, "timestamp": "04:22:28", "text": "ここは愛の巣です。私は誓います。いいえ。"}, {"type": "subtitle", "time": 15750.95, "timestamp": "04:22:30", "text": "私は彼を自分のバーに一度も入れたことがない。のために"}, {"type": "subtitle", "time": 15754.55, "timestamp": "04:22:34", "text": "記録によると、彼は私の欲求を満たしてくれなかった。私"}, {"type": "subtitle", "time": 15757.03, "timestamp": "04:22:37", "text": "よく一人で飲んでいた。"}, {"type": "subtitle", "time": 15774.59, "timestamp": "04:22:54", "text": "複数。どうすればいいの？だから行けない"}]
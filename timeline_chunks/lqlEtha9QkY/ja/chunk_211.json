[{"type": "subtitle", "time": 12665.309, "timestamp": "03:31:05", "text": "反動がかなりひどい。分かりますか"}, {"type": "subtitle", "time": 12668.07, "timestamp": "03:31:08", "text": "これ？時にはまっすぐに当たり、"}, {"type": "subtitle", "time": 12682.55, "timestamp": "03:31:22", "text": "私のチリレシピは、私と共に消え去る。私は死ぬ。あなた"}, {"type": "subtitle", "time": 12685.429, "timestamp": "03:31:25", "text": "あなたがそうであることを知っています。私は超伝導体です"}, {"type": "subtitle", "time": 12692.87, "timestamp": "03:31:32", "text": "任務に集中するだけだ。砂糖。こんにちは。"}, {"type": "subtitle", "time": 12695.349, "timestamp": "03:31:35", "text": "こんにちは。今からお聴きになる方は、"}, {"type": "subtitle", "time": 12697.269, "timestamp": "03:31:37", "text": "誰が"}, {"type": "subtitle", "time": 12706.63, "timestamp": "03:31:46", "text": "素晴らしいラインナップが揃っている。のみ動作します"}, {"type": "subtitle", "time": 12711.269, "timestamp": "03:31:51", "text": "Noxはボットには対応していません。わかった。"}, {"type": "subtitle", "time": 12713.269, "timestamp": "03:31:53", "text": "ミス・モクシー。"}, {"type": "subtitle", "time": 12715.67, "timestamp": "03:31:55", "text": "ああ、それはミスのことです"}, {"type": "subtitle", "time": 12717.75, "timestamp": "03:31:57", "text": "モクシー。わかった。それは彼らが話している"}]
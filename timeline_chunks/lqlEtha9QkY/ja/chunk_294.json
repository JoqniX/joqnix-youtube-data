[{"type": "subtitle", "time": 17640.99, "timestamp": "04:54:00", "text": "かわいい"}, {"type": "subtitle", "time": 17648.15, "timestamp": "04:54:08", "text": "いや、違う。待って、待って、彼は実際には"}, {"type": "subtitle", "time": 17649.948, "timestamp": "04:54:09", "text": "ゲーム内で。"}, {"type": "subtitle", "time": 17658.55, "timestamp": "04:54:18", "text": "けれど？ゼロはどこにあるのか？待て、ゼロだ。"}, {"type": "subtitle", "time": 17660.868, "timestamp": "04:54:20", "text": "さあ行こう。彼は、えーと、この人、この人"}, {"type": "subtitle", "time": 17662.788, "timestamp": "04:54:22", "text": "キャラクター。"}, {"type": "subtitle", "time": 17665.03, "timestamp": "04:54:25", "text": "うん。こんにちは。"}, {"type": "subtitle", "time": 17668.07, "timestamp": "04:54:28", "text": "つまり、ゲーム内にはそういう機能はないということですね。テキスト"}, {"type": "subtitle", "time": 17670.11, "timestamp": "04:54:30", "text": "悲しそうに話す。それでは、"}, {"type": "subtitle", "time": 17673.99, "timestamp": "04:54:33", "text": "私の、そして、皆さんが聞いてくれるといいのですが"}, {"type": "subtitle", "time": 17674.75, "timestamp": "04:54:34", "text": "の"}, {"type": "subtitle", "time": 17682.75, "timestamp": "04:54:42", "text": "あ、待って。テキストチャット機能があります。そうそう。"}, {"type": "subtitle", "time": 17686.19, "timestamp": "04:54:46", "text": "こんにちは。テキストがあることを知りませんでした"}, {"type": "subtitle", "time": 17688.99, "timestamp": "04:54:48", "text": "チャット。"}, {"type": "subtitle", "time": 17690.83, "timestamp": "04:54:50", "text": "おお。"}, {"type": "subtitle", "time": 17694.23, "timestamp": "04:54:54", "text": "くそ。皆さん、おかえりなさい。いらっしゃいませ"}, {"type": "subtitle", "time": 17697.11, "timestamp": "04:54:57", "text": "戻る。マスク着用。おかえり。いらっしゃいませ"}]
[{"type": "subtitle", "time": 4691.83, "timestamp": "01:18:11", "text": "兄弟？あのね？"}, {"type": "subtitle", "time": 4711.229, "timestamp": "01:18:31", "text": "電話。こんにちは。ええ、分かります。"}, {"type": "subtitle", "time": 4720.709, "timestamp": "01:18:40", "text": "彼らはあなたを見ることができます。待って。あ、待って。不和"}, {"type": "subtitle", "time": 4722.47, "timestamp": "01:18:42", "text": "が戻ってきた。"}, {"type": "subtitle", "time": 4725.59, "timestamp": "01:18:45", "text": "待って、今再起動してるよ。彼らは聞くことができる"}, {"type": "subtitle", "time": 4729.43, "timestamp": "01:18:49", "text": "今、私のマイクからあなたの声が聞こえます。"}, {"type": "subtitle", "time": 4734.709, "timestamp": "01:18:54", "text": "こんにちは。"}, {"type": "subtitle", "time": 4737.59, "timestamp": "01:18:57", "text": "本日はホストを務めていただき、ありがとうございました。"}]
[{"type": "subtitle", "time": 17942.868, "timestamp": "04:59:02", "text": "姉妹。戦いはまだ終わっていない。"}, {"type": "subtitle", "time": 17946.23, "timestamp": "04:59:06", "text": "それでは、まずラチャを潰してみましょう。の"}, {"type": "subtitle", "time": 17949.11, "timestamp": "04:59:09", "text": "このゲームで必要な武器の一つは弓だ。"}, {"type": "subtitle", "time": 17954.628, "timestamp": "04:59:14", "text": "バン。"}, {"type": "subtitle", "time": 17956.31, "timestamp": "04:59:16", "text": "これに弓があるかどうかはわかりません"}, {"type": "subtitle", "time": 17960.788, "timestamp": "04:59:20", "text": "ゲームですが、お弓をいただけると嬉しいです。"}, {"type": "subtitle", "time": 17964.23, "timestamp": "04:59:24", "text": "さようなら、コロナウイルスのプロパガンダ。ハロー・クリムゾン"}, {"type": "subtitle", "time": 17967.11, "timestamp": "04:59:27", "text": "宣伝。"}, {"type": "subtitle", "time": 17982.788, "timestamp": "04:59:42", "text": "はい、どうぞ。さあ、あの気持ち悪いものをつかんで"}, {"type": "subtitle", "time": 17985.91, "timestamp": "04:59:45", "text": "美味しいお肉。"}]
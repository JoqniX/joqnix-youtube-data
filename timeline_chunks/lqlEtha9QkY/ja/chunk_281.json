[{"type": "subtitle", "time": 16861.99, "timestamp": "04:41:01", "text": "違法武器を回収せよ。わかりました、でも"}, {"type": "subtitle", "time": 16863.83, "timestamp": "04:41:03", "text": "私も参加した方がいいでしょうか？ええ、もちろんです。えっと、"}, {"type": "subtitle", "time": 16867.91, "timestamp": "04:41:07", "text": "あなたのIDを教えてください。だから私は追加できます"}, {"type": "subtitle", "time": 16874.15, "timestamp": "04:41:14", "text": "待てよ、これ、実は使えるかも。そして"}, {"type": "subtitle", "time": 16876.55, "timestamp": "04:41:16", "text": "ドーンとダイナマイトが爆発する。"}, {"type": "subtitle", "time": 16878.788, "timestamp": "04:41:18", "text": "どうもありがとうございます。"}, {"type": "subtitle", "time": 16901.99, "timestamp": "04:41:41", "text": "でも、でも、覚えておいてください、私は"}, {"type": "subtitle", "time": 16905.31, "timestamp": "04:41:45", "text": "9時30分までに配信を終了しなければなりません。"}, {"type": "subtitle", "time": 16908.628, "timestamp": "04:41:48", "text": "わかった。だから、ほんの少しだけです。は"}, {"type": "subtitle", "time": 16911.31, "timestamp": "04:41:51", "text": "それで大丈夫ですか？それは"}]
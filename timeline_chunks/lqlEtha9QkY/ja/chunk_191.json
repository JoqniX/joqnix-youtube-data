[{"type": "subtitle", "time": 11460.63, "timestamp": "03:11:00", "text": "良いガイドです。実は、今起きたばかりなんです"}, {"type": "subtitle", "time": 11464.71, "timestamp": "03:11:04", "text": "えっと、1時間前か、1時間くらい前"}, {"type": "subtitle", "time": 11467.71, "timestamp": "03:11:07", "text": "配信開始の15分前くらい"}, {"type": "subtitle", "time": 11471.11, "timestamp": "03:11:11", "text": "ストリーム。だから、ちょっと遅れたんだけど"}, {"type": "subtitle", "time": 11473.03, "timestamp": "03:11:13", "text": "今日は、それ以外はすべて"}, {"type": "subtitle", "time": 11475.67, "timestamp": "03:11:15", "text": "良い。私は部隊に命令している"}, {"type": "subtitle", "time": 11478.87, "timestamp": "03:11:18", "text": "何としてもそれを取り戻す。私たちはしない"}, {"type": "subtitle", "time": 11482.07, "timestamp": "03:11:22", "text": "敵の手に残しておこう。"}, {"type": "subtitle", "time": 11484.87, "timestamp": "03:11:24", "text": "マラワンが店を襲撃している。くそ。"}, {"type": "subtitle", "time": 11486.87, "timestamp": "03:11:26", "text": "私に何か良いことを一つ残してくれないの？"}, {"type": "subtitle", "time": 11492.79, "timestamp": "03:11:32", "text": "マラワン？たった一杯のコーヒーを。"}, {"type": "subtitle", "time": 11497.269, "timestamp": "03:11:37", "text": "一言メッセージを送っていただければ、ご注文を承ります。"}, {"type": "subtitle", "time": 11499.79, "timestamp": "03:11:39", "text": "その手榴弾はとても"}, {"type": "subtitle", "time": 11503.83, "timestamp": "03:11:43", "text": "バカ。私は「I」を使うべきではないと思います"}, {"type": "subtitle", "time": 11517.349, "timestamp": "03:11:57", "text": "いいえ、私たちは小さなプレイヤーを殺しました。しかし"}]
[{"type": "subtitle", "time": 2820.95, "timestamp": "00:47:00", "text": "私はただ提案しているだけです"}, {"type": "subtitle", "time": 2823.19, "timestamp": "00:47:03", "text": "あなたが作っているものなら役に立つかもしれません"}, {"type": "subtitle", "time": 2825.43, "timestamp": "00:47:05", "text": "初めて動画を始めました"}, {"type": "subtitle", "time": 2828.069, "timestamp": "00:47:08", "text": "ビデオを作っていて、"}, {"type": "subtitle", "time": 2830.069, "timestamp": "00:47:10", "text": "文字通りのビデオ"}, {"type": "subtitle", "time": 2833.27, "timestamp": "00:47:13", "text": "子供。わかった、"}, {"type": "subtitle", "time": 2835.109, "timestamp": "00:47:15", "text": "それは嘘じゃないよ。私は"}, {"type": "subtitle", "time": 2838.71, "timestamp": "00:47:18", "text": "私が始めた頃は文字通り子供だった"}, {"type": "subtitle", "time": 2842.51, "timestamp": "00:47:22", "text": "私のメインチャンネルではなく、"}, {"type": "subtitle", "time": 2847.109, "timestamp": "00:47:27", "text": "他のプラットフォームの名前は伏せておきます。"}, {"type": "subtitle", "time": 2849.67, "timestamp": "00:47:29", "text": "私のチャンネル名をお伝えします"}, {"type": "subtitle", "time": 2853.75, "timestamp": "00:47:33", "text": "そして、それらの作品では私は一度も自分の声を使わなかった。"}, {"type": "subtitle", "time": 2855.91, "timestamp": "00:47:35", "text": "ああ、"}, {"type": "subtitle", "time": 2858.95, "timestamp": "00:47:38", "text": "動画制作を始めてどれくらいになりますか？"}, {"type": "subtitle", "time": 2868.309, "timestamp": "00:47:48", "text": "それまで私が覚えているのは、私が、えっと、"}, {"type": "subtitle", "time": 2871.67, "timestamp": "00:47:51", "text": "やってみて、いくつか録音して、私が話しているところを録音して"}, {"type": "subtitle", "time": 2875.47, "timestamp": "00:47:55", "text": "あるいは何か別のことをしたが、うまくいかなかった"}, {"type": "subtitle", "time": 2878.39, "timestamp": "00:47:58", "text": "外。私はとても恥ずかしかったし、私は"}]
[{"type": "subtitle", "time": 10980.55, "timestamp": "03:03:00", "text": "待って。ケビン、君かい？私は信じている"}, {"type": "subtitle", "time": 10983.07, "timestamp": "03:03:03", "text": "それはここにあります。あ、待って。いいえ、いいえ、"}, {"type": "subtitle", "time": 10994.51, "timestamp": "03:03:14", "text": "それ？ほら、これをひっくり返して、"}, {"type": "subtitle", "time": 10997.83, "timestamp": "03:03:17", "text": "行く。ミッションを一度に見るにはどうすればいいですか？"}, {"type": "subtitle", "time": 11003.469, "timestamp": "03:03:23", "text": "エリア？ああ、ミッションをどうやって見るか"}, {"type": "subtitle", "time": 11012.23, "timestamp": "03:03:32", "text": "それは、えっと、何に表示されませんか？"}, {"type": "subtitle", "time": 11012.91, "timestamp": "03:03:32", "text": "電話"}, {"type": "subtitle", "time": 11017.469, "timestamp": "03:03:37", "text": "それ？このシステムには表示されません。"}, {"type": "subtitle", "time": 11019.55, "timestamp": "03:03:39", "text": "えっと"}, {"type": "subtitle", "time": 11022.55, "timestamp": "03:03:42", "text": "ああ、わかりました。地域設定みたいなものがあるんです。"}, {"type": "subtitle", "time": 11026.469, "timestamp": "03:03:46", "text": "わかった。ガッチャ。殺人者を殺せ。わかった。上昇"}, {"type": "subtitle", "time": 11029.51, "timestamp": "03:03:49", "text": "そして、努力する。これらはメリディアン・メトロです。"}, {"type": "subtitle", "time": 11031.79, "timestamp": "03:03:51", "text": "わかった。この2つならできる。"}, {"type": "subtitle", "time": 11038.59, "timestamp": "03:03:58", "text": "わかった。だから私は行かなければならない"}]
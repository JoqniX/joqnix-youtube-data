[{"type": "subtitle", "time": 12721.11, "timestamp": "03:32:01", "text": "モクシー。勝者、つまり勝利を手にするのは、"}, {"type": "subtitle", "time": 12723.75, "timestamp": "03:32:03", "text": "彼らはそうしなければならないでしょう。知ってるでしょ"}, {"type": "subtitle", "time": 12727.11, "timestamp": "03:32:07", "text": "鉛。ああ、大変だ。"}, {"type": "subtitle", "time": 12729.269, "timestamp": "03:32:09", "text": "何かあると思った"}, {"type": "subtitle", "time": 12732.07, "timestamp": "03:32:12", "text": "この場所でCCをオーバーイン"}, {"type": "subtitle", "time": 12733.429, "timestamp": "03:32:13", "text": "ゲーム。"}, {"type": "subtitle", "time": 12736.11, "timestamp": "03:32:16", "text": "気をつけなければならない"}, {"type": "subtitle", "time": 12764.07, "timestamp": "03:32:44", "text": "そして、サイドクエストもあります。"}, {"type": "subtitle", "time": 12765.429, "timestamp": "03:32:45", "text": "サイドクエストを引き受けます。聞こえます"}, {"type": "subtitle", "time": 12767.429, "timestamp": "03:32:47", "text": "これ。あなたの助けが必要です。私は連れ去られた"}, {"type": "subtitle", "time": 12770.63, "timestamp": "03:32:50", "text": "コートを着た囚人、その名は「腫瘍頭」。"}, {"type": "subtitle", "time": 12773.389, "timestamp": "03:32:53", "text": "彼女は囚人を陥れたい"}, {"type": "subtitle", "time": 12775.429, "timestamp": "03:32:55", "text": "彼女。彼女は私のことをアトラスだと思っている"}, {"type": "subtitle", "time": 12777.51, "timestamp": "03:32:57", "text": "兵士だと言われているが、私は違う。もしあなたが私を助けてくれるなら、"}, {"type": "subtitle", "time": 12778.95, "timestamp": "03:32:58", "text": "きっと満足していただけるはずです。"}]
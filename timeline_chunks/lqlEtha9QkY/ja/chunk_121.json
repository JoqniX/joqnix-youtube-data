[{"type": "subtitle", "time": 7264.669, "timestamp": "02:01:04", "text": "[音楽]"}, {"type": "subtitle", "time": 7271.669, "timestamp": "02:01:11", "text": "ええ、そうです。ああ、なるほど。私は不自然なものを見る"}, {"type": "subtitle", "time": 7282.55, "timestamp": "02:01:22", "text": "あなた。どこですか？だから、私は見つける必要がある"}, {"type": "subtitle", "time": 7284.87, "timestamp": "02:01:24", "text": "キャラクターシートをその子に渡して"}, {"type": "subtitle", "time": 7286.709, "timestamp": "02:01:26", "text": "あちらで叱られているのは"}, {"type": "subtitle", "time": 7290.87, "timestamp": "02:01:30", "text": "教師か母親か。それなら私が手伝う必要がある"}, {"type": "subtitle", "time": 7293.629, "timestamp": "02:01:33", "text": "えっと、他に誰がいましたっけ？私"}, {"type": "subtitle", "time": 7296.709, "timestamp": "02:01:36", "text": "忘れた。彼はここで酔っ払っている。私たちはする必要があります"}, {"type": "subtitle", "time": 7312.35, "timestamp": "02:01:52", "text": "はい。うん。あなたは読みすぎです"}, {"type": "subtitle", "time": 7315.99, "timestamp": "02:01:55", "text": "もの。彼女から電話がかかってきた。私はあまり読書をしません"}]
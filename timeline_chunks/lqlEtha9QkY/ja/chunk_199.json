[{"type": "subtitle", "time": 11941.389, "timestamp": "03:19:01", "text": "そしてこれは"}, {"type": "subtitle", "time": 11944.389, "timestamp": "03:19:04", "text": "あぁ、こっちの方が実際はいいよ。"}, {"type": "subtitle", "time": 11956.19, "timestamp": "03:19:16", "text": "180. 180"}, {"type": "subtitle", "time": 11959.03, "timestamp": "03:19:19", "text": "実は。ええ、それをいただきます。そして私は"}, {"type": "subtitle", "time": 11961.91, "timestamp": "03:19:21", "text": "他の改造品はここで販売します"}, {"type": "subtitle", "time": 11963.229, "timestamp": "03:19:23", "text": "ではない"}, {"type": "subtitle", "time": 11967.429, "timestamp": "03:19:27", "text": "適格。これは別のクラスのMODです"}, {"type": "subtitle", "time": 11969.469, "timestamp": "03:19:29", "text": "などなど。"}, {"type": "subtitle", "time": 11972.63, "timestamp": "03:19:32", "text": "うん。そしてこの手榴弾は、何もしないわけではない。"}, {"type": "subtitle", "time": 11976.59, "timestamp": "03:19:36", "text": "では、それを交換します"}, {"type": "subtitle", "time": 11979.67, "timestamp": "03:19:39", "text": "実は。少し違いがあります"}, {"type": "subtitle", "time": 11982.79, "timestamp": "03:19:42", "text": "でも大丈夫。そして私はこれを星印にする"}, {"type": "subtitle", "time": 11986.07, "timestamp": "03:19:46", "text": "それは未亡人製造機だ。それは理解しますが"}, {"type": "subtitle", "time": 11988.79, "timestamp": "03:19:48", "text": "それでも、私はそれを保管しておくつもりだ。だから、それを売る"}, {"type": "subtitle", "time": 11992.469, "timestamp": "03:19:52", "text": "そして、私たちはこれを買います。なんてこった。私"}, {"type": "subtitle", "time": 11993.63, "timestamp": "03:19:53", "text": "失った"}, {"type": "subtitle", "time": 11996.51, "timestamp": "03:19:56", "text": "それ。私は買いたかった"}, {"type": "subtitle", "time": 11999.03, "timestamp": "03:19:59", "text": "私は買いたかったのですが"}]
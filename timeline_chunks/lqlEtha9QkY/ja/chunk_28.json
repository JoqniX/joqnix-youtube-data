[{"type": "subtitle", "time": 1680.19, "timestamp": "00:28:00", "text": "あるいはそれが何であれ。"}, {"type": "subtitle", "time": 1683.51, "timestamp": "00:28:03", "text": "えっと、私が突発的な事態について言ったとき、"}, {"type": "subtitle", "time": 1686.83, "timestamp": "00:28:06", "text": "彼女は、まるで私たちが似ているかのように言った。私はこう思った"}, {"type": "subtitle", "time": 1693.71, "timestamp": "00:28:13", "text": "似ている？"}, {"type": "chat", "time": 1696.294, "timestamp": "00:28:16", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "xeno matter?"}, {"type": "subtitle", "time": 1697.11, "timestamp": "00:28:17", "text": "だから、たぶん私は知らないから、ただ"}, {"type": "subtitle", "time": 1709.549, "timestamp": "00:28:29", "text": "私たちはゼノとコラボレーションする予定だった"}, {"type": "subtitle", "time": 1711.31, "timestamp": "00:28:31", "text": "今日。"}, {"type": "subtitle", "time": 1713.71, "timestamp": "00:28:33", "text": "ええと、フォローします"}, {"type": "subtitle", "time": 1735.029, "timestamp": "00:28:55", "text": "あ、すみません、面白かったんです。私たちは"}, {"type": "subtitle", "time": 1738.149, "timestamp": "00:28:58", "text": "今日はZenoとコラボして、L42とコラボして、"}]
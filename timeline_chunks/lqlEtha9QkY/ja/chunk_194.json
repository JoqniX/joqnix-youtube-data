[{"type": "subtitle", "time": 11640.87, "timestamp": "03:14:00", "text": "それから。彼らに少し見せてあげよう"}, {"type": "subtitle", "time": 11644.389, "timestamp": "03:14:04", "text": "カフェインは私たちの士気を高める。"}, {"type": "subtitle", "time": 11646.79, "timestamp": "03:14:06", "text": "こんにちは。待って。"}, {"type": "subtitle", "time": 11649.99, "timestamp": "03:14:09", "text": "ヘルメット用。"}, {"type": "subtitle", "time": 11699.91, "timestamp": "03:14:59", "text": "それらはどうですか？たぶん私は"}]
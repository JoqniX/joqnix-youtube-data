[{"type": "subtitle", "time": 6967.27, "timestamp": "01:56:07", "text": "時間。うん。 ３つを見つけた後"}, {"type": "subtitle", "time": 6968.91, "timestamp": "01:56:08", "text": "メモリ"}, {"type": "subtitle", "time": 6971.43, "timestamp": "01:56:11", "text": "スロットマシンを回したら、今日の仕事は終わりです。"}, {"type": "subtitle", "time": 6973.75, "timestamp": "01:56:13", "text": "これで配信を締めくくります。"}, {"type": "subtitle", "time": 6975.51, "timestamp": "01:56:15", "text": "2時間ほど配信しています。"}, {"type": "subtitle", "time": 6980.669, "timestamp": "01:56:20", "text": "右？私は次のように始めたと思います"}, {"type": "subtitle", "time": 6994.75, "timestamp": "01:56:34", "text": "開始しました。おお、"}, {"type": "subtitle", "time": 7004.27, "timestamp": "01:56:44", "text": "そこには。"}, {"type": "subtitle", "time": 7011.189, "timestamp": "01:56:51", "text": "ナ。私はふわふわ感と"}, {"type": "subtitle", "time": 7014.31, "timestamp": "01:56:54", "text": "中身のない話ではない。つまり、ふわふわしたものはいいんだけど、"}, {"type": "subtitle", "time": 7017.589, "timestamp": "01:56:57", "text": "適切な比率のふわふわ感、本当にふわふわ感を出すな"}]
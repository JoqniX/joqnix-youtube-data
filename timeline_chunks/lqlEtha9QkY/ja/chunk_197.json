[{"type": "subtitle", "time": 11832.429, "timestamp": "03:17:12", "text": "135ドル。これは必要だ。私が始めます"}, {"type": "subtitle", "time": 11834.87, "timestamp": "03:17:14", "text": "それ。これを服用する場合、"}, {"type": "subtitle", "time": 11839.15, "timestamp": "03:17:19", "text": "これ。だから、削除します"}, {"type": "subtitle", "time": 11857.229, "timestamp": "03:17:37", "text": "もの。ほかに何か？"}, {"type": "subtitle", "time": 11862.15, "timestamp": "03:17:42", "text": "いや、違うよ。マウスを忘れてしまった。待って、待って、"}, {"type": "subtitle", "time": 11864.229, "timestamp": "03:17:44", "text": "待って、待って、待って。停止。あなたに伝えてください"}, {"type": "subtitle", "time": 11866.389, "timestamp": "03:17:46", "text": "友人、そして敵。私は"}, {"type": "subtitle", "time": 11868.07, "timestamp": "03:17:48", "text": "買い戻し。私は何を売ったのか？なぜ私は"}, {"type": "subtitle", "time": 11872.03, "timestamp": "03:17:52", "text": "売る？私は何を売ったのか？ １、２、"}, {"type": "subtitle", "time": 11875.51, "timestamp": "03:17:55", "text": "三つ。わかった。まあ、いいでしょう。"}, {"type": "subtitle", "time": 11877.59, "timestamp": "03:17:57", "text": "私は気をつけなければならない"}]
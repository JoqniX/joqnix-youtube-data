[{"type": "subtitle", "time": 17176.15, "timestamp": "04:46:16", "text": "おい。ねえ、あなた。私は助けが必要です。くそ。"}, {"type": "subtitle", "time": 17178.31, "timestamp": "04:46:18", "text": "ローラアイが私を送ってくれた。どうしたの？"}, {"type": "subtitle", "time": 17179.99, "timestamp": "04:46:19", "text": "ダイナー？"}, {"type": "subtitle", "time": 17182.47, "timestamp": "04:46:22", "text": "ボー、私だよ。そして、お腹を空かせた人たちがいる"}, {"type": "subtitle", "time": 17185.19, "timestamp": "04:46:25", "text": "基地に戻った。分かりますか？"}, {"type": "subtitle", "time": 17188.788, "timestamp": "04:46:28", "text": "ローラアイ、あなたの気持ちはよくわかるわ。あなたの気持ち、すごくよく分かります。わかった、"}, {"type": "subtitle", "time": 17191.75, "timestamp": "04:46:31", "text": "だからあのファシストの支配者たちは私の"}, {"type": "subtitle", "time": 17195.27, "timestamp": "04:46:35", "text": "恐竜は部隊に物資を供給する。彼らを止めろ。"}, {"type": "subtitle", "time": 17198.23, "timestamp": "04:46:38", "text": "さあ、始めよう。彼はこの中にいるのか？いつ"}, {"type": "subtitle", "time": 17200.15, "timestamp": "04:46:40", "text": "マラワンが現れたので、私はバリケードを築いた。"}, {"type": "subtitle", "time": 17201.83, "timestamp": "04:46:41", "text": "私のアパートで。そして私は出て行かない"}, {"type": "subtitle", "time": 17203.91, "timestamp": "04:46:43", "text": "この戦争が終わるまで。聞こえますか？しかし"}, {"type": "subtitle", "time": 17205.67, "timestamp": "04:46:45", "text": "ダイナーを立ち上げるのを手伝ってくれて、"}, {"type": "subtitle", "time": 17207.35, "timestamp": "04:46:47", "text": "走っている。そして、私はそれをリモートで実行できます"}]
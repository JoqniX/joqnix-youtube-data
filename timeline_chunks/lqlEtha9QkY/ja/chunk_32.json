[{"type": "subtitle", "time": 1922.669, "timestamp": "00:32:02", "text": "人々のように"}, {"type": "subtitle", "time": 1927.909, "timestamp": "00:32:07", "text": "最上階に立つ"}, {"type": "subtitle", "time": 1932.389, "timestamp": "00:32:12", "text": "えっと、トップレベル、えっと、ピークホロのような"}, {"type": "subtitle", "time": 1935.509, "timestamp": "00:32:15", "text": "レベル。だから私は何人かの人に会ったのですが"}, {"type": "subtitle", "time": 1937.11, "timestamp": "00:32:17", "text": "頂上に立って、私は"}, {"type": "subtitle", "time": 1940.509, "timestamp": "00:32:20", "text": "比較する"}, {"type": "subtitle", "time": 1943.029, "timestamp": "00:32:23", "text": "比較したい、または追いつきたい、また"}, {"type": "subtitle", "time": 1945.19, "timestamp": "00:32:25", "text": "追いつけない、とか何とか気づく。私"}, {"type": "subtitle", "time": 1946.19, "timestamp": "00:32:26", "text": "しないで"}, {"type": "subtitle", "time": 1949.31, "timestamp": "00:32:29", "text": "知る。わからない。ああ"}, {"type": "subtitle", "time": 1952.71, "timestamp": "00:32:32", "text": "こんにちは、配信に参加してもいいですか？ああ、もちろんだよ。"}, {"type": "subtitle", "time": 1957.269, "timestamp": "00:32:37", "text": "私たちはただ声に出して話していただけです。待って、どうやって"}, {"type": "subtitle", "time": 1958.59, "timestamp": "00:32:38", "text": "する"}, {"type": "subtitle", "time": 1970.11, "timestamp": "00:32:50", "text": "ストレッチ"}]
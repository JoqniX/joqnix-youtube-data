[{"type": "subtitle", "time": 16082.429, "timestamp": "04:28:02", "text": "マーカス"}, {"type": "subtitle", "time": 16087.229, "timestamp": "04:28:07", "text": "136と、私は124を持っています"}, {"type": "subtitle", "time": 16094.55, "timestamp": "04:28:14", "text": "大丈夫。これ、実は売れるんです。いいえ"}, {"type": "subtitle", "time": 16098.75, "timestamp": "04:28:18", "text": "質問がされました。在庫30件"}, {"type": "subtitle", "time": 16115.51, "timestamp": "04:28:35", "text": "時間。新規視聴者の皆様、ようこそ。"}, {"type": "subtitle", "time": 16118.189, "timestamp": "04:28:38", "text": "「Who Wants to Bang a」をご覧いただきありがとうございます。"}, {"type": "subtitle", "time": 16121.83, "timestamp": "04:28:41", "text": "Bazillionaireは、私、Killablesが主催しています。"}, {"type": "subtitle", "time": 16125.91, "timestamp": "04:28:45", "text": "私もグランプリ受賞者です。"}, {"type": "subtitle", "time": 16128.95, "timestamp": "04:28:48", "text": "ショータイムだ。 Killableにそのトークンを与える"}, {"type": "subtitle", "time": 16132.309, "timestamp": "04:28:52", "text": "私の愛情の源。"}, {"type": "subtitle", "time": 16136.76, "timestamp": "04:28:56", "text": "かわいそうなトゥルーディ。彼女がいなくなるのは寂しい。"}, {"type": "subtitle", "time": 16138.55, "timestamp": "04:28:58", "text": "[拍手]"}]
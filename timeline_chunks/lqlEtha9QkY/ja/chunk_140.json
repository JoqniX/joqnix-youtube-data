[{"type": "subtitle", "time": 8400.19, "timestamp": "02:20:00", "text": "えっと、私は"}, {"type": "subtitle", "time": 8425.83, "timestamp": "02:20:25", "text": "肉はスクールドライバーのように見え、"}, {"type": "subtitle", "time": 8445.75, "timestamp": "02:20:45", "text": "もしかしたら、私は進歩する必要があるのか​​もしれない。あのね？"}, {"type": "subtitle", "time": 8447.55, "timestamp": "02:20:47", "text": "私たちはこの場所にまた戻ってきます"}, {"type": "subtitle", "time": 8451.11, "timestamp": "02:20:51", "text": "またか、そうだろ？クラブに行くために。"}, {"type": "subtitle", "time": 8453.91, "timestamp": "02:20:53", "text": "あのね？そうしましょう。少なくとも"}, {"type": "subtitle", "time": 8454.83, "timestamp": "02:20:54", "text": "のために"}, {"type": "subtitle", "time": 8458.19, "timestamp": "02:20:58", "text": "今。探す"}]
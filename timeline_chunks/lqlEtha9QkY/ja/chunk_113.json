[{"type": "subtitle", "time": 6780.03, "timestamp": "01:53:00", "text": "皆さん、お元気ですか？"}, {"type": "subtitle", "time": 6782.75, "timestamp": "01:53:02", "text": "えっと、３、１ドルあります"}, {"type": "subtitle", "time": 6785.21, "timestamp": "01:53:05", "text": "番号。"}, {"type": "subtitle", "time": 6793.75, "timestamp": "01:53:13", "text": "待って。えっと、fluff は健全という意味だと思います"}, {"type": "subtitle", "time": 6797.07, "timestamp": "01:53:17", "text": "愛情深く、ただ冷酷なだけではない。"}, {"type": "subtitle", "time": 6800.07, "timestamp": "01:53:20", "text": "ああ、わかってるよ。私はそのことを知りませんでした"}, {"type": "subtitle", "time": 6803.07, "timestamp": "01:53:23", "text": "言葉。教えてくださってありがとうございます"}, {"type": "subtitle", "time": 6806.03, "timestamp": "01:53:26", "text": "それはつまり"}, {"type": "subtitle", "time": 6812.55, "timestamp": "01:53:32", "text": "の上。待って、ここは一体何？私は決して"}, {"type": "subtitle", "time": 6814.109, "timestamp": "01:53:34", "text": "された"}, {"type": "subtitle", "time": 6827.109, "timestamp": "01:53:47", "text": "さて、次は帽子です。"}, {"type": "subtitle", "time": 6829.629, "timestamp": "01:53:49", "text": "その男は"}, {"type": "subtitle", "time": 6832.27, "timestamp": "01:53:52", "text": "酔っ払って"}]
[{"type": "subtitle", "time": 13681.75, "timestamp": "03:48:01", "text": "リーダー。これを殺せ。"}, {"type": "subtitle", "time": 13691.229, "timestamp": "03:48:11", "text": "モクシーのクルーは本当にそれを望んでいるに違いない"}, {"type": "subtitle", "time": 13695.03, "timestamp": "03:48:15", "text": "トークン。簡単だよ、ボラド。たくさんあります"}, {"type": "subtitle", "time": 13698.389, "timestamp": "03:48:18", "text": "電流が全体に行き渡る。"}, {"type": "subtitle", "time": 13718.63, "timestamp": "03:48:38", "text": "死んだ。気にしない。缶を持って来てください"}, {"type": "subtitle", "time": 13722.469, "timestamp": "03:48:42", "text": "ここに戻って。建物にスプレー落書きをする。"}, {"type": "subtitle", "time": 13724.71, "timestamp": "03:48:44", "text": "急いで。私の肺はメタンガスでいっぱいだ"}, {"type": "subtitle", "time": 13728.469, "timestamp": "03:48:48", "text": "そして、老いたネズミの魔女。余分なヒゲ。待って、"}, {"type": "subtitle", "time": 13730.389, "timestamp": "03:48:50", "text": "これが地下鉄への道ですか？"}, {"type": "subtitle", "time": 13733.03, "timestamp": "03:48:53", "text": "場所？それは地下への道です"}, {"type": "subtitle", "time": 13735.59, "timestamp": "03:48:55", "text": "場所。待って、もしそうなら、私はちょっと"}, {"type": "subtitle", "time": 13738.309, "timestamp": "03:48:58", "text": "行きたい。ええ、すぐ近くですよ。それは"}]
[{"type": "subtitle", "time": 12376.229, "timestamp": "03:26:16", "text": "私はシャノン・カイリーです。"}, {"type": "subtitle", "time": 12378.469, "timestamp": "03:26:18", "text": "朝の正午。私たちはここにいます"}, {"type": "subtitle", "time": 12382.87, "timestamp": "03:26:22", "text": "リースと過ごす朝。あれは何だ？"}, {"type": "subtitle", "time": 12385.75, "timestamp": "03:26:25", "text": "彼はドーナツターンをしているの？一体どういうことだ？に"}, {"type": "subtitle", "time": 12388.55, "timestamp": "03:26:28", "text": "ここにいてください。シャノン（NPC）がドーナツターンをしている。"}, {"type": "subtitle", "time": 12390.55, "timestamp": "03:26:30", "text": "こんにちは。銀河市場へ復帰。"}, {"type": "subtitle", "time": 12392.309, "timestamp": "03:26:32", "text": "あなたは多くの人がやろうとしていたことを成し遂げた"}, {"type": "subtitle", "time": 12394.95, "timestamp": "03:26:34", "text": "わずか10年前には不可能と思われていたことだ。"}, {"type": "subtitle", "time": 12397.51, "timestamp": "03:26:37", "text": "あなたの成功の秘訣は何ですか？"}, {"type": "subtitle", "time": 12399.14, "timestamp": "03:26:39", "text": "秘密の異星人技術。"}, {"type": "subtitle", "time": 12401.79, "timestamp": "03:26:41", "text": "[笑い]"}, {"type": "subtitle", "time": 12404.63, "timestamp": "03:26:44", "text": "シャニング。アトラスが繁栄しているのは"}, {"type": "subtitle", "time": 12406.95, "timestamp": "03:26:46", "text": "私たちはそれを新たな方向へと進めました。私"}, {"type": "subtitle", "time": 12408.63, "timestamp": "03:26:48", "text": "企業は、"}, {"type": "subtitle", "time": 12410.55, "timestamp": "03:26:50", "text": "従業員を肩に担わせるのではなく、"}, {"type": "subtitle", "time": 12412.83, "timestamp": "03:26:52", "text": "逆です。そしてあなたの"}, {"type": "subtitle", "time": 12415.429, "timestamp": "03:26:55", "text": "競争？アトラスは"}, {"type": "subtitle", "time": 12417.59, "timestamp": "03:26:57", "text": "多くの注目を集めている。何かありますか？"}]
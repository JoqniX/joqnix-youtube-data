[{"type": "subtitle", "time": 13326.469, "timestamp": "03:42:06", "text": "知る。くそ。あなたに向かってきます。ああ神様、"}, {"type": "subtitle", "time": 13333.91, "timestamp": "03:42:13", "text": "男の子を満たしてあげて。殺す。もしそれが"}, {"type": "subtitle", "time": 13337.83, "timestamp": "03:42:17", "text": "誰もいない場所のような寂れた場所、"}, {"type": "subtitle", "time": 13340.95, "timestamp": "03:42:20", "text": "えっと、それはつまり、私は間違った場所にいるということです"}, {"type": "subtitle", "time": 13343.67, "timestamp": "03:42:23", "text": "私は既にそこを通り過ぎました。それは"}, {"type": "subtitle", "time": 13345.67, "timestamp": "03:42:25", "text": "このような混雑した場所では、"}, {"type": "subtitle", "time": 13356.79, "timestamp": "03:42:36", "text": "ああ、神様。機関銃を使っていますか？"}, {"type": "subtitle", "time": 13358.51, "timestamp": "03:42:38", "text": "複数キル。"}, {"type": "subtitle", "time": 13378.59, "timestamp": "03:42:58", "text": "つまり、以下です"}]
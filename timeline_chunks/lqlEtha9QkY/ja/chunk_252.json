[{"type": "subtitle", "time": 15132.15, "timestamp": "04:12:12", "text": "職業はなんですか？"}, {"type": "subtitle", "time": 15134.07, "timestamp": "04:12:14", "text": "あの野郎は何度も私を殺そうとした"}, {"type": "subtitle", "time": 15136.389, "timestamp": "04:12:16", "text": "回。しかし、問題はここからだ。もし私がそうしていなかったら"}, {"type": "subtitle", "time": 15138.55, "timestamp": "04:12:18", "text": "アランに出会っていなかったら、私は入隊しなかっただろう"}, {"type": "subtitle", "time": 15140.469, "timestamp": "04:12:20", "text": "アトラスと共に。もし私が参加していなかったら"}, {"type": "subtitle", "time": 15142.99, "timestamp": "04:12:22", "text": "アトラスがあれば、おそらく"}, {"type": "subtitle", "time": 15146.63, "timestamp": "04:12:26", "text": "ただ[ __ ]を栽培しているだけだ。"}, {"type": "subtitle", "time": 15148.469, "timestamp": "04:12:28", "text": "ほら、去年私は"}, {"type": "subtitle", "time": 15149.55, "timestamp": "04:12:29", "text": "場所"}, {"type": "subtitle", "time": 15153.15, "timestamp": "04:12:33", "text": "20℃くらいで、友達ももう一人"}, {"type": "subtitle", "time": 15157.349, "timestamp": "04:12:37", "text": "パンチカードがそこにある。おお。くそ。おい、"}, {"type": "subtitle", "time": 15160.389, "timestamp": "04:12:40", "text": "モクシーのクルーは何をやっているんだ？"}, {"type": "subtitle", "time": 15163.189, "timestamp": "04:12:43", "text": "バトルロイヤルに戻りましょう。"}, {"type": "subtitle", "time": 15164.67, "timestamp": "04:12:44", "text": "うん。"}, {"type": "subtitle", "time": 15167.63, "timestamp": "04:12:47", "text": "待って。忍耐。キラー"}, {"type": "subtitle", "time": 15171.07, "timestamp": "04:12:51", "text": "ボット。殺人鬼のウォルド。"}, {"type": "subtitle", "time": 15175.07, "timestamp": "04:12:55", "text": "実は彼の名前を忘れてしまった。はい、"}, {"type": "subtitle", "time": 15177.99, "timestamp": "04:12:57", "text": "ほとんどの物資は手に入れました。私たちはする必要があります"}]
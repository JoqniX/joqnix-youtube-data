[{"type": "subtitle", "time": 3060.549, "timestamp": "00:51:00", "text": "将来的にもそうありたい。大丈夫です。"}, {"type": "subtitle", "time": 3062.23, "timestamp": "00:51:02", "text": "うまくいくと思うよ、だって君は"}, {"type": "subtitle", "time": 3065.52, "timestamp": "00:51:05", "text": "ほぼ一日中ストリーミング配信している。"}, {"type": "subtitle", "time": 3067.829, "timestamp": "00:51:07", "text": "[音楽]"}, {"type": "subtitle", "time": 3069.75, "timestamp": "00:51:09", "text": "しかし、あなたもまた"}, {"type": "subtitle", "time": 3072.87, "timestamp": "00:51:12", "text": "現在配信中。だから、全部配信するわけじゃないよ"}, {"type": "subtitle", "time": 3075.43, "timestamp": "00:51:15", "text": "日。以前と同じようにストリーミング配信します"}, {"type": "subtitle", "time": 3084.549, "timestamp": "00:51:24", "text": "例えば、重要な日とか、そういう感じでしょうか。"}, {"type": "subtitle", "time": 3086.109, "timestamp": "00:51:26", "text": "うん。うん。"}, {"type": "subtitle", "time": 3089.99, "timestamp": "00:51:29", "text": "うん。そうそう。そうそう。あなたは参加しませんでした"}, {"type": "subtitle", "time": 3099.51, "timestamp": "00:51:39", "text": "あまりにも多くのシに参加して、"}, {"type": "subtitle", "time": 3102.069, "timestamp": "00:51:42", "text": "彼女が出演している作品です。"}, {"type": "subtitle", "time": 3105.829, "timestamp": "00:51:45", "text": "はぁ？何？新しいアストラとシリ"}, {"type": "subtitle", "time": 3109.03, "timestamp": "00:51:49", "text": "1つ。いいえ、それらは友達のために作られたものです。私はしません"}, {"type": "subtitle", "time": 3112.39, "timestamp": "00:51:52", "text": "参加したいサーバーが多すぎる。サーバ"}, {"type": "subtitle", "time": 3115.99, "timestamp": "00:51:55", "text": "問題は、一度参加すると"}, {"type": "subtitle", "time": 3118.309, "timestamp": "00:51:58", "text": "彼らの多くはあなたを招待し始め、"}]
[{"type": "subtitle", "time": 18010.31, "timestamp": "05:00:10", "text": "肉をデジタルスキャナーの上に置いて"}, {"type": "subtitle", "time": 18013.67, "timestamp": "05:00:13", "text": "これならできる。"}, {"type": "subtitle", "time": 18017.67, "timestamp": "05:00:17", "text": "それはネズミの肉ですか？わあ、すごい。"}, {"type": "subtitle", "time": 18021.91, "timestamp": "05:00:21", "text": "そう、新しいハンバーガーが誕生したのだ。何"}, {"type": "subtitle", "time": 18023.91, "timestamp": "05:00:23", "text": "えっ？あなたはハンバーガーを作るつもりですか？"}, {"type": "subtitle", "time": 18025.83, "timestamp": "05:00:25", "text": "それ？これらのハンバーガーは、"}, {"type": "subtitle", "time": 18030.75, "timestamp": "05:00:30", "text": "それらが必要だ。そのボタンを押してください。何てことだ。"}, {"type": "subtitle", "time": 18034.91, "timestamp": "05:00:34", "text": "バーガー。どうしたの、ダーリン？"}, {"type": "subtitle", "time": 18037.35, "timestamp": "05:00:37", "text": "ネガティブ。最優先事項。指令。"}, {"type": "subtitle", "time": 18039.27, "timestamp": "05:00:39", "text": "マラワンにハンバーガーを配達してください。キャプテン"}, {"type": "subtitle", "time": 18041.43, "timestamp": "05:00:41", "text": "アーチャー・ロウ。"}, {"type": "subtitle", "time": 18044.55, "timestamp": "05:00:44", "text": "何？さあ、それを追いかけろ。"}, {"type": "subtitle", "time": 18046.31, "timestamp": "05:00:46", "text": "私のハンバーガーボットは配達しようとしています"}, {"type": "subtitle", "time": 18048.07, "timestamp": "05:00:48", "text": "あのキャプテン・ロウという男に食事を与えた君は"}, {"type": "subtitle", "time": 18051.19, "timestamp": "05:00:51", "text": "話している。何？冗談でしょう。"}, {"type": "subtitle", "time": 18053.03, "timestamp": "05:00:53", "text": "ヴォルトハンターの皆さん、ボットについてきてください。これは"}, {"type": "subtitle", "time": 18055.19, "timestamp": "05:00:55", "text": "あのマラワン野郎を捕まえるチャンスだ。"}]
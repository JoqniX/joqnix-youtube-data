[{"type": "subtitle", "time": 1020.069, "timestamp": "00:17:00", "text": "1試合か2試合くらいかな？"}, {"type": "subtitle", "time": 1022.15, "timestamp": "00:17:02", "text": "お金で彼女を無理やり連れ去った"}, {"type": "subtitle", "time": 1026.189, "timestamp": "00:17:06", "text": "そして人々はまだそれについて話したり、"}, {"type": "subtitle", "time": 1030.15, "timestamp": "00:17:10", "text": "まるで、そのことで彼女を避けるように"}, {"type": "subtitle", "time": 1033.189, "timestamp": "00:17:13", "text": "相変わらず何者でもないし、"}, {"type": "subtitle", "time": 1035.189, "timestamp": "00:17:15", "text": "数人のサブスクライバーがその後もまだ"}, {"type": "subtitle", "time": 1037.909, "timestamp": "00:17:17", "text": "成長できなかったけど、まあ、引っ張らなかったからね"}, {"type": "subtitle", "time": 1045.429, "timestamp": "00:17:25", "text": "わかってるよ、でもでも心配しないで"}, {"type": "subtitle", "time": 1047.669, "timestamp": "00:17:27", "text": "謝らないで、ただ考えてるだけ"}, {"type": "subtitle", "time": 1049.43, "timestamp": "00:17:29", "text": "大声で心配しないで、大丈夫、大丈夫、大丈夫"}, {"type": "subtitle", "time": 1052.31, "timestamp": "00:17:32", "text": "大丈夫、心配しないで、ただ考えてるだけ"}, {"type": "subtitle", "time": 1056.31, "timestamp": "00:17:36", "text": "あなたの側から見て、私の側から見て、"}, {"type": "subtitle", "time": 1058.31, "timestamp": "00:17:38", "text": "私が誰かに尋ねたらどうなるだろうか"}, {"type": "subtitle", "time": 1063.23, "timestamp": "00:17:43", "text": "他にもっと多くのフォロワーがいた"}, {"type": "subtitle", "time": 1068.11, "timestamp": "00:17:48", "text": "右？誰が嫌いになれるだろうか"}, {"type": "subtitle", "time": 1070.71, "timestamp": "00:17:50", "text": "例えば、YouTuberとして、"}, {"type": "subtitle", "time": 1074.71, "timestamp": "00:17:54", "text": "境界線を設けるべきだ。いいえ、"}, {"type": "subtitle", "time": 1076.15, "timestamp": "00:17:56", "text": "境界線があるんだよ、ほら、"}, {"type": "subtitle", "time": 1078.07, "timestamp": "00:17:58", "text": "渡るはずだったのは、"}]
[{"type": "subtitle", "time": 17882.788, "timestamp": "04:58:02", "text": "レベル18にはなれません。偉大なる異端者"}, {"type": "subtitle", "time": 17889.31, "timestamp": "04:58:09", "text": "火力は、我らが神女王の力に匹敵する。"}, {"type": "subtitle", "time": 17892.788, "timestamp": "04:58:12", "text": "成長する。そして、良い知らせはまだまだ続く。"}, {"type": "subtitle", "time": 17896.15, "timestamp": "04:58:16", "text": "神聖なる保管庫。待って、私、それを承認したの？"}, {"type": "subtitle", "time": 17899.19, "timestamp": "04:58:19", "text": "そして、私はそれを理解できたのでしょうか？理解できましたか？"}, {"type": "subtitle", "time": 17901.15, "timestamp": "04:58:21", "text": "いいえ、理解できませんでした。"}, {"type": "subtitle", "time": 17905.59, "timestamp": "04:58:25", "text": "ノニア。さあ、早く待って。"}, {"type": "subtitle", "time": 17908.948, "timestamp": "04:58:28", "text": "理解できましたか？いいえ。女王は先導することを選びます"}, {"type": "subtitle", "time": 17911.67, "timestamp": "04:58:31", "text": "あなた。兄弟姉妹よ、恐れるな。"}, {"type": "subtitle", "time": 17915.11, "timestamp": "04:58:35", "text": "あなたは、貪欲な触れ合いによって祝福されています。いいえ、"}, {"type": "subtitle", "time": 17917.03, "timestamp": "04:58:37", "text": "私はしませんでした。あなたの聖なる死は"}, {"type": "subtitle", "time": 17919.83, "timestamp": "04:58:39", "text": "感染していなければいいのですが。コンベンションのために"}, {"type": "subtitle", "time": 17921.83, "timestamp": "04:58:41", "text": "女王陛下ご自身。"}, {"type": "subtitle", "time": 17925.03, "timestamp": "04:58:45", "text": "私たちみんながそんな幸運に恵まれますように。金庫"}, {"type": "subtitle", "time": 17928.15, "timestamp": "04:58:48", "text": "泥棒が私たちの反対に立つのは、私が"}, {"type": "subtitle", "time": 17930.47, "timestamp": "04:58:50", "text": "信頼"}, {"type": "subtitle", "time": 17933.99, "timestamp": "04:58:53", "text": "あなたと同盟を結ぶため。私はできません"}, {"type": "subtitle", "time": 17939.31, "timestamp": "04:58:59", "text": "兄弟たちに私について警戒し、"}]
[{"type": "subtitle", "time": 8041.24, "timestamp": "02:14:01", "text": "私は行方不明です。 Wはそれを手に入れることができません。"}, {"type": "subtitle", "time": 8043.51, "timestamp": "02:14:03", "text": "[音楽]"}, {"type": "subtitle", "time": 8045.83, "timestamp": "02:14:05", "text": "だって、物語を進めすぎちゃったから。"}, {"type": "subtitle", "time": 8061.27, "timestamp": "02:14:21", "text": "えっと、私が見逃しているのは何でしょう？"}, {"type": "subtitle", "time": 8087.35, "timestamp": "02:14:47", "text": "いや、待って。彼女が持っていたあの物は何だったのか"}]
[{"type": "subtitle", "time": 13505.83, "timestamp": "03:45:05", "text": "場所？それに、自転車とかそういうのもない。"}, {"type": "subtitle", "time": 13509.15, "timestamp": "03:45:09", "text": "待って、待って、そこに"}, {"type": "subtitle", "time": 13511.319, "timestamp": "03:45:11", "text": "待って、そこに は"}, {"type": "subtitle", "time": 13518.15, "timestamp": "03:45:18", "text": "待って。自転車やサイクルを手に入れることはできますか？"}, {"type": "subtitle", "time": 13521.269, "timestamp": "03:45:21", "text": "ほら、そんな感じ？いいえ、できません。おお"}, {"type": "subtitle", "time": 13524.95, "timestamp": "03:45:24", "text": "我が神よ。私はずっと歩いて行かなければならない。おお"}, {"type": "subtitle", "time": 13527.389, "timestamp": "03:45:27", "text": "神、"}, {"type": "subtitle", "time": 13529.91, "timestamp": "03:45:29", "text": "いいえ。ああ、また一つサイドクエストが終わった。"}, {"type": "subtitle", "time": 13532.03, "timestamp": "03:45:32", "text": "[音楽]"}, {"type": "subtitle", "time": 13534.87, "timestamp": "03:45:34", "text": "ここ。ああ、大変だ。この地図は"}, {"type": "subtitle", "time": 13536.389, "timestamp": "03:45:36", "text": "難しい。"}, {"type": "subtitle", "time": 13538.309, "timestamp": "03:45:38", "text": "私は消費している。スピードランは無理だ。"}, {"type": "subtitle", "time": 13547.71, "timestamp": "03:45:47", "text": "大丈夫。では、ここへ行きましょう。私たちは"}, {"type": "subtitle", "time": 13550.469, "timestamp": "03:45:50", "text": "あちらのサイドクエスト。私たちは収集します"}]
[{"type": "subtitle", "time": 18186.35, "timestamp": "05:03:06", "text": "近日公開。私は"}, {"type": "subtitle", "time": 18195.868, "timestamp": "05:03:15", "text": "彼は私に"}, {"type": "subtitle", "time": 18203.27, "timestamp": "05:03:23", "text": "高額な価値のものを取り出してくれてありがとう。"}, {"type": "subtitle", "time": 18205.75, "timestamp": "05:03:25", "text": "ターゲットはヴォルトハンター。うわ、すごい量だ。"}, {"type": "subtitle", "time": 18207.19, "timestamp": "05:03:27", "text": "上書きするには少し時間がかかります"}, {"type": "subtitle", "time": 18209.35, "timestamp": "05:03:29", "text": "マラワンが私のハンバーガーボットを支配している。"}, {"type": "subtitle", "time": 18210.948, "timestamp": "05:03:30", "text": "そして、これはもう破棄してもいいかもしれない。"}, {"type": "subtitle", "time": 18214.708, "timestamp": "05:03:34", "text": "じゃあ、ハンバーガーとはお別れね。その間、Vault"}, {"type": "subtitle", "time": 18217.19, "timestamp": "05:03:37", "text": "ハンター、ローラアイにハンバーガーを届けてもらえますか？"}, {"type": "subtitle", "time": 18221.19, "timestamp": "05:03:41", "text": "自分？そして、こちらには金色のものがあった。"}, {"type": "subtitle", "time": 18224.39, "timestamp": "05:03:44", "text": "それはどこへ行ったの？ローラ、私は"}, {"type": "subtitle", "time": 18227.35, "timestamp": "05:03:47", "text": "あなた好みのハンバーガーの第一弾です。"}, {"type": "subtitle", "time": 18229.83, "timestamp": "05:03:49", "text": "ハンバーガーロボットを再プログラムする時が来た。私は"}, {"type": "subtitle", "time": 18232.07, "timestamp": "05:03:52", "text": "ハンバーガーに戻った。売ることができます"}, {"type": "subtitle", "time": 18235.99, "timestamp": "05:03:55", "text": "お金を稼ぐ。多くのアプリ。どんどん送ってきてください。"}, {"type": "subtitle", "time": 18239.59, "timestamp": "05:03:59", "text": "ここにはお腹を空かせた人がたくさんいる。"}]
[{"type": "subtitle", "time": 10921.269, "timestamp": "03:02:01", "text": "何もない。なんて可愛いんでしょう。"}, {"type": "subtitle", "time": 10922.91, "timestamp": "03:02:02", "text": "それは"}, {"type": "subtitle", "time": 10936.389, "timestamp": "03:02:16", "text": "マヤ。電源コードを差し込む"}, {"type": "subtitle", "time": 10937.95, "timestamp": "03:02:17", "text": "この場所で、"}, {"type": "subtitle", "time": 10943.469, "timestamp": "03:02:23", "text": "右？では、どこに挿入すればいいのでしょうか"}, {"type": "subtitle", "time": 10946.269, "timestamp": "03:02:26", "text": "それ？彼を始末する時が来た。"}, {"type": "subtitle", "time": 10949.349, "timestamp": "03:02:29", "text": "ええ、米と挽き肉はここにはありません、私は"}, {"type": "subtitle", "time": 10966.389, "timestamp": "03:02:46", "text": "上。はい、続けます。えっと、どこ"}, {"type": "subtitle", "time": 10968.19, "timestamp": "03:02:48", "text": "だった"}, {"type": "subtitle", "time": 10970.67, "timestamp": "03:02:50", "text": "私たちは？うん。こんにちは、"}, {"type": "subtitle", "time": 10977.59, "timestamp": "03:02:57", "text": "いらっしゃいませ。お元気でお過ごしでしょうか。おお、"}]
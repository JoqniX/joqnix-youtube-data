[{"type": "subtitle", "time": 4205.11, "timestamp": "01:10:05", "text": "外国で試してみたら、"}, {"type": "subtitle", "time": 4208.229, "timestamp": "01:10:08", "text": "全く気に入らなかった。"}, {"type": "subtitle", "time": 4210.87, "timestamp": "01:10:10", "text": "ああ、私は鶏肉を食べることに慣れているんです。チキン"}, {"type": "subtitle", "time": 4212.59, "timestamp": "01:10:12", "text": "方法"}, {"type": "subtitle", "time": 4222.229, "timestamp": "01:10:22", "text": "うん、アメリカで食べたんだけど、"}, {"type": "subtitle", "time": 4225.03, "timestamp": "01:10:25", "text": "とてもがっかりした。私は"}, {"type": "subtitle", "time": 4227.189, "timestamp": "01:10:27", "text": "思った通り、これは実際"}, {"type": "subtitle", "time": 4230.229, "timestamp": "01:10:30", "text": "美味しい。鶏肉の方がずっと美味しい。"}, {"type": "subtitle", "time": 4232.229, "timestamp": "01:10:32", "text": "私はグリルチキンを食べていました"}, {"type": "subtitle", "time": 4234.07, "timestamp": "01:10:34", "text": "側。"}, {"type": "subtitle", "time": 4240.75, "timestamp": "01:10:40", "text": "損はしていません"}, {"type": "subtitle", "time": 4246.47, "timestamp": "01:10:46", "text": "牛肉は食べられるが、"}, {"type": "subtitle", "time": 4249.87, "timestamp": "01:10:49", "text": "牛肉は"}, {"type": "subtitle", "time": 4253.03, "timestamp": "01:10:53", "text": "ええ、何も損はしていませんよ。に固執する"}, {"type": "subtitle", "time": 4255.669, "timestamp": "01:10:55", "text": "チキン。"}, {"type": "subtitle", "time": 4258.87, "timestamp": "01:10:58", "text": "インドカレーが食べられないのは残念だ。"}]
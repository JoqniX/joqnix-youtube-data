[{"type": "subtitle", "time": 18602.55, "timestamp": "05:10:02", "text": "ああ、レベル18になったら使えるようになるんですね。"}, {"type": "subtitle", "time": 18609.11, "timestamp": "05:10:09", "text": "私が渡した銃は最も"}, {"type": "subtitle", "time": 18619.99, "timestamp": "05:10:19", "text": "待って、私のレベルはいくつ？実際、どのように"}, {"type": "subtitle", "time": 18623.11, "timestamp": "05:10:23", "text": "自分のレベルをチェックする？"}, {"type": "subtitle", "time": 18635.39, "timestamp": "05:10:35", "text": "私？自分のレベルを確認するにはどうすればいいですか？"}, {"type": "subtitle", "time": 18645.59, "timestamp": "05:10:45", "text": "いくつかの最も強力なものについて考えてみてください"}, {"type": "subtitle", "time": 18646.51, "timestamp": "05:10:46", "text": "ほぼその通り"}, {"type": "subtitle", "time": 18650.31, "timestamp": "05:10:50", "text": "慈悲。おお、"}, {"type": "subtitle", "time": 18652.47, "timestamp": "05:10:52", "text": "さあ行こう。"}, {"type": "subtitle", "time": 18655.83, "timestamp": "05:10:55", "text": "こんにちは、ハンターさん。"}, {"type": "subtitle", "time": 18657.11, "timestamp": "05:10:57", "text": "信じられないかもしれないが、これはかつて"}, {"type": "subtitle", "time": 18658.23, "timestamp": "05:10:58", "text": "いい感じ これは以前はいい感じだった"}]
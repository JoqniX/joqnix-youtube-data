[{"type": "subtitle", "time": 16466.029, "timestamp": "04:34:26", "text": "なぜ？最後までやり遂げる必要がある"}, {"type": "subtitle", "time": 16474.869, "timestamp": "04:34:34", "text": "えっと、外でタバコ吸おうよ、"}, {"type": "subtitle", "time": 16483.99, "timestamp": "04:34:43", "text": "キルは昔から人間のクズだった。もしあなたが尋ねるなら"}, {"type": "subtitle", "time": 16487.189, "timestamp": "04:34:47", "text": "私にとって、そここそが彼のいるべき場所だ。"}, {"type": "subtitle", "time": 16489.59, "timestamp": "04:34:49", "text": "ああ、大変だ。私はこれを"}, {"type": "subtitle", "time": 16491.59, "timestamp": "04:34:51", "text": "喜び。"}, {"type": "subtitle", "time": 16494.83, "timestamp": "04:34:54", "text": "手伝ってくれてありがとう、ダーリン。お話しましょう。"}]
[{"type": "subtitle", "time": 4740.149, "timestamp": "01:19:00", "text": "私たちはより大きく、より長い"}, {"type": "subtitle", "time": 4741.75, "timestamp": "01:19:01", "text": "会話。"}, {"type": "subtitle", "time": 4747.07, "timestamp": "01:19:07", "text": "はい。そうすれば、あなたの問題は少し解決するでしょう。"}, {"type": "subtitle", "time": 4751.43, "timestamp": "01:19:11", "text": "Mの秘密。わかった。バイバイ。バイバイ。良い"}, {"type": "subtitle", "time": 4755.03, "timestamp": "01:19:15", "text": "おやすみ、ザキ。本日はありがとうございました。"}, {"type": "subtitle", "time": 4757.189, "timestamp": "01:19:17", "text": "こんにちは。私は多くの有意義な経験をしました"}, {"type": "subtitle", "time": 4759.31, "timestamp": "01:19:19", "text": "あなたとの会話、そしてあなたの"}, {"type": "subtitle", "time": 4762.79, "timestamp": "01:19:22", "text": "寄付キャンペーンは成功した。"}, {"type": "subtitle", "time": 4765.189, "timestamp": "01:19:25", "text": "あなたも眠りにつく。"}, {"type": "subtitle", "time": 4767.43, "timestamp": "01:19:27", "text": "うん。寝なさい。"}, {"type": "subtitle", "time": 4773.55, "timestamp": "01:19:33", "text": "バイバイ。"}, {"type": "subtitle", "time": 4781.91, "timestamp": "01:19:41", "text": "愛は捨て去る、このガキめ。なぜ今日なのか？なぜ"}, {"type": "subtitle", "time": 4785.31, "timestamp": "01:19:45", "text": "そうせざるを得なかったの？何もない"}]
[{"type": "subtitle", "time": 5941.109, "timestamp": "01:39:01", "text": "どこ？よし、すべての思い出を集めよう。"}, {"type": "subtitle", "time": 5942.79, "timestamp": "01:39:02", "text": "実際には、それは私たちがすべてを行う必要があることを意味します"}, {"type": "subtitle", "time": 5945.35, "timestamp": "01:39:05", "text": "この場所のクエスト。残念だけど、"}, {"type": "subtitle", "time": 5958.03, "timestamp": "01:39:18", "text": "えっと、行かなきゃ"}, {"type": "subtitle", "time": 5989.27, "timestamp": "01:39:49", "text": "わかった。えっと、場所を見つける必要があるのですが"}, {"type": "subtitle", "time": 5996.43, "timestamp": "01:39:56", "text": "ロボット。の"}, {"type": "subtitle", "time": 5999.43, "timestamp": "01:39:59", "text": "ロボット。ロボット。実際、最初の"}]
[{"type": "subtitle", "time": 16263.269, "timestamp": "04:31:03", "text": "それは知っていた。"}, {"type": "subtitle", "time": 16266.309, "timestamp": "04:31:06", "text": "ああ、武器がたくさんある。"}, {"type": "subtitle", "time": 16268.95, "timestamp": "04:31:08", "text": "武器のスキンは可能です。さあ行こう。私は"}, {"type": "subtitle", "time": 16272.63, "timestamp": "04:31:12", "text": "それ。これを買います。私たちを連れ戻して"}, {"type": "subtitle", "time": 16274.71, "timestamp": "04:31:14", "text": "ハンター。良い。良い。良い商品です。さあ"}, {"type": "subtitle", "time": 16276.59, "timestamp": "04:31:16", "text": "行く。"}, {"type": "subtitle", "time": 16279.59, "timestamp": "04:31:19", "text": "[拍手]"}, {"type": "subtitle", "time": 16281.79, "timestamp": "04:31:21", "text": "どうもありがとうございました"}, {"type": "subtitle", "time": 16290.99, "timestamp": "04:31:30", "text": "わかった。マウンテンキラーボール充電パック。"}, {"type": "subtitle", "time": 16292.99, "timestamp": "04:31:32", "text": "わかった。"}, {"type": "subtitle", "time": 16294.59, "timestamp": "04:31:34", "text": "おお。"}, {"type": "subtitle", "time": 16299.189, "timestamp": "04:31:39", "text": "おお、157点だ。おお、これを受け取ろう。"}, {"type": "subtitle", "time": 16300.59, "timestamp": "04:31:40", "text": "感謝"}, {"type": "subtitle", "time": 16317.99, "timestamp": "04:31:57", "text": "今日。えっと、私はTwitchを持っていませんが、"}, {"type": "subtitle", "time": 16319.429, "timestamp": "04:31:59", "text": "Twitch を取得する予定はありません。"}]
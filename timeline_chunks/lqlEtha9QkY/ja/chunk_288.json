[{"type": "subtitle", "time": 17280.31, "timestamp": "04:48:00", "text": "はぁ？待って。私は戻ってきたのでしょうか？私は戻ってきたのでしょうか？私は"}, {"type": "subtitle", "time": 17281.23, "timestamp": "04:48:01", "text": "戻る？"}, {"type": "subtitle", "time": 17283.83, "timestamp": "04:48:03", "text": "待って。はい、そろそろ戻ります。私たちはすべきです"}, {"type": "subtitle", "time": 17285.83, "timestamp": "04:48:05", "text": "戻ってきます。もうすぐ戻ってきます。私たちはそうすべきです"}, {"type": "subtitle", "time": 17288.43, "timestamp": "04:48:08", "text": "戻る。こんにちは。私たちはそうすべきです"}, {"type": "subtitle", "time": 17292.47, "timestamp": "04:48:12", "text": "戻る。こんにちは。行く。停電が発生しました。それ"}, {"type": "subtitle", "time": 17293.47, "timestamp": "04:48:13", "text": "だった"}, {"type": "subtitle", "time": 17296.708, "timestamp": "04:48:16", "text": "本当に残念だ。予期せぬ"}, {"type": "subtitle", "time": 17298.91, "timestamp": "04:48:18", "text": "残念だ。おお"}, {"type": "subtitle", "time": 17301.55, "timestamp": "04:48:21", "text": "男の子。全て"}, {"type": "subtitle", "time": 17303.948, "timestamp": "04:48:23", "text": "右。所有"}, {"type": "subtitle", "time": 17307.31, "timestamp": "04:48:27", "text": "上。切り替えて"}, {"type": "subtitle", "time": 17310.03, "timestamp": "04:48:30", "text": "これ。これです"}, {"type": "subtitle", "time": 17312.55, "timestamp": "04:48:32", "text": "実は。そして、そこから抜け出せ。わかった。良い。"}, {"type": "subtitle", "time": 17315.11, "timestamp": "04:48:35", "text": "良い。良い。良い。大丈夫です。大丈夫です。私たちは"}, {"type": "subtitle", "time": 17318.07, "timestamp": "04:48:38", "text": "良い。では、画面をお見せしましょう"}, {"type": "subtitle", "time": 17320.03, "timestamp": "04:48:40", "text": "少し。では、"}]
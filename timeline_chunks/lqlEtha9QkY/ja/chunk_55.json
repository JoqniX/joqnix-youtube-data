[{"type": "subtitle", "time": 3300.79, "timestamp": "00:55:00", "text": "わかった。うん。うん。死者を知っている"}, {"type": "subtitle", "time": 3305.15, "timestamp": "00:55:05", "text": "基本的に誰もいない時間帯です。"}, {"type": "subtitle", "time": 3308.549, "timestamp": "00:55:08", "text": "うん。それは私のパートタイムの時間によります"}, {"type": "subtitle", "time": 3311.589, "timestamp": "00:55:11", "text": "もし私が今タイミングを掴んでいるなら"}, {"type": "subtitle", "time": 3314.87, "timestamp": "00:55:14", "text": "私もパートタイムで配信するなら、"}, {"type": "subtitle", "time": 3317.91, "timestamp": "00:55:17", "text": "いやいや、私も考えているんだけど"}, {"type": "subtitle", "time": 3321.27, "timestamp": "00:55:21", "text": "パートタイムで、今は数時間くらいです"}, {"type": "subtitle", "time": 3324.23, "timestamp": "00:55:24", "text": "早めのチェックインか何か正しい仕事"}, {"type": "subtitle", "time": 3326.27, "timestamp": "00:55:26", "text": "もしそうなら私は"}, {"type": "subtitle", "time": 3329.03, "timestamp": "00:55:29", "text": "夕方のことを考えているが、あまり人はいない"}, {"type": "subtitle", "time": 3331.03, "timestamp": "00:55:31", "text": "今夜はそこにいる人たち"}, {"type": "subtitle", "time": 3333.19, "timestamp": "00:55:33", "text": "彼らの部屋には今いるから"}, {"type": "subtitle", "time": 3335.829, "timestamp": "00:55:35", "text": "夕方ならできる"}, {"type": "subtitle", "time": 3338.79, "timestamp": "00:55:38", "text": "それからストリームを終了して"}, {"type": "subtitle", "time": 3341.03, "timestamp": "00:55:41", "text": "例えばパートタイムに行って、家に帰ってきて、"}, {"type": "subtitle", "time": 3344.63, "timestamp": "00:55:44", "text": "寝るか宿題をして寝る"}, {"type": "subtitle", "time": 3347.51, "timestamp": "00:55:47", "text": "繰り返す。そっちの方が理にかなっている。"}, {"type": "subtitle", "time": 3349.349, "timestamp": "00:55:49", "text": "うん、"}, {"type": "subtitle", "time": 3352.15, "timestamp": "00:55:52", "text": "それは理にかなっている。調整する必要があるかもしれない"}, {"type": "subtitle", "time": 3355.19, "timestamp": "00:55:55", "text": "たくさんのこと。ああ、心配だ。行く"}, {"type": "subtitle", "time": 3359.27, "timestamp": "00:55:59", "text": "新しい国に行くと、それなりのことが起こります"}]
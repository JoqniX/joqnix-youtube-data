[{"type": "subtitle", "time": 12312.469, "timestamp": "03:25:12", "text": "ああ、そうそう、教会の話ね。私"}, {"type": "subtitle", "time": 12316.15, "timestamp": "03:25:16", "text": "寝てしまったので、見逃したことを忘れていました。私は"}, {"type": "subtitle", "time": 12319.63, "timestamp": "03:25:19", "text": "今日はホーリーマウスに出席する予定だった。私"}, {"type": "subtitle", "time": 12324.309, "timestamp": "03:25:24", "text": "忘れた。でも忘れてしまったけど、残念だった。"}, {"type": "subtitle", "time": 12326.07, "timestamp": "03:25:26", "text": "でも大丈夫。大丈夫。以上です"}, {"type": "subtitle", "time": 12330.229, "timestamp": "03:25:30", "text": "時間。ええと、金曜日に行きます。その"}, {"type": "subtitle", "time": 12332.71, "timestamp": "03:25:32", "text": "大丈夫。"}, {"type": "subtitle", "time": 12342.71, "timestamp": "03:25:42", "text": "我々の最大の敵と戦う。階段。"}, {"type": "subtitle", "time": 12344.15, "timestamp": "03:25:44", "text": "彼はテストしていたようです"}, {"type": "subtitle", "time": 12347.429, "timestamp": "03:25:47", "text": "実験的な階段昇降モジュール。おお、"}, {"type": "subtitle", "time": 12349.91, "timestamp": "03:25:49", "text": "問題点は理解しました。彼は電源を入れなかった。"}, {"type": "subtitle", "time": 12352.469, "timestamp": "03:25:52", "text": "なんて間抜けな奴だ。そのモジュールは"}]
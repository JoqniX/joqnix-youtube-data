[{"type": "subtitle", "time": 3242.63, "timestamp": "00:54:02", "text": "さあ、さあ、作れないと聞いたよ"}, {"type": "subtitle", "time": 3245.99, "timestamp": "00:54:05", "text": "電話でさえ問題になることがある"}, {"type": "subtitle", "time": 3248.39, "timestamp": "00:54:08", "text": "壁がすごく薄いから。今"}, {"type": "subtitle", "time": 3251.91, "timestamp": "00:54:11", "text": "自分の部屋で何をするにしても"}, {"type": "subtitle", "time": 3254.549, "timestamp": "00:54:14", "text": "他の部屋に聞こえる。だから私は"}, {"type": "subtitle", "time": 3257.829, "timestamp": "00:54:17", "text": "配信しますか？"}, {"type": "subtitle", "time": 3261.19, "timestamp": "00:54:21", "text": "わからない。日本が好きではない"}, {"type": "subtitle", "time": 3264.309, "timestamp": "00:54:24", "text": "行ける場所のような"}, {"type": "subtitle", "time": 3265.15, "timestamp": "00:54:25", "text": "1"}, {"type": "subtitle", "time": 3267.23, "timestamp": "00:54:27", "text": "数時間"}, {"type": "subtitle", "time": 3271.349, "timestamp": "00:54:31", "text": "そして参加する。それは何かだと思う"}, {"type": "subtitle", "time": 3276.15, "timestamp": "00:54:36", "text": "診察が必要かどうか調べなければなりません。"}, {"type": "subtitle", "time": 3282.069, "timestamp": "00:54:42", "text": "もしくはASMR配信をすることもできます"}, {"type": "subtitle", "time": 3283.75, "timestamp": "00:54:43", "text": "常に。"}, {"type": "subtitle", "time": 3285.91, "timestamp": "00:54:45", "text": "うん。または、話したり、"}, {"type": "subtitle", "time": 3289.589, "timestamp": "00:54:49", "text": "ドムの人たちと友達になって、"}, {"type": "subtitle", "time": 3292.069, "timestamp": "00:54:52", "text": "基本的にストリーミングできるのは"}, {"type": "subtitle", "time": 3294.79, "timestamp": "00:54:54", "text": "誰もいない"}, {"type": "subtitle", "time": 3298.069, "timestamp": "00:54:58", "text": "そしてみんなが「さあ、出て行け」と言う。"}]
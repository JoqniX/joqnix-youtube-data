[{"type": "subtitle", "time": 12491.469, "timestamp": "03:28:11", "text": "場所。待って、私トップチャットにいるよ。"}, {"type": "subtitle", "time": 12493.99, "timestamp": "03:28:13", "text": "待って、ライブチャットに参加しているはず。私は"}, {"type": "subtitle", "time": 12496.389, "timestamp": "03:28:16", "text": "何か見逃したことはありますか？コンテストの優勝者は"}, {"type": "subtitle", "time": 12498.389, "timestamp": "03:28:18", "text": "その男本人と寝る。"}, {"type": "subtitle", "time": 12500.309, "timestamp": "03:28:20", "text": "女性が"}, {"type": "subtitle", "time": 12502.95, "timestamp": "03:28:22", "text": "バトルロイヤルに参加するかもしれない。"}, {"type": "subtitle", "time": 12506.15, "timestamp": "03:28:26", "text": "金、名声、男の心を溶かす銃"}, {"type": "subtitle", "time": 12510.51, "timestamp": "03:28:30", "text": "対決する。しかしキルトに賭けるのは、"}, {"type": "subtitle", "time": 12514.309, "timestamp": "03:28:34", "text": "賞。私を信じて。ああ、ただの警告だよ"}, {"type": "subtitle", "time": 12516.63, "timestamp": "03:28:36", "text": "キルトについて。あの男が言う言葉すべて"}, {"type": "subtitle", "time": 12518.309, "timestamp": "03:28:38", "text": "引き金を引きたくなる、もし"}, {"type": "subtitle", "time": 12520.95, "timestamp": "03:28:40", "text": "私の言いたいことはお分かりでしょう。そして私たちはすぐに"}, {"type": "subtitle", "time": 12523.59, "timestamp": "03:28:43", "text": "十分。"}, {"type": "subtitle", "time": 12531.31, "timestamp": "03:28:51", "text": "私はあなたを殺します。"}, {"type": "subtitle", "time": 12537.99, "timestamp": "03:28:57", "text": "ファンガールたち。ああ、モックスだ。あなたが"}]
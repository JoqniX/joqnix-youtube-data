[{"type": "subtitle", "time": 13141.71, "timestamp": "03:39:01", "text": "いつ"}, {"type": "subtitle", "time": 13151.269, "timestamp": "03:39:11", "text": "だから、私がこれらを開いている理由は"}, {"type": "subtitle", "time": 13154.269, "timestamp": "03:39:14", "text": "箱や木箱があるのは、"}, {"type": "subtitle", "time": 13156.389, "timestamp": "03:39:16", "text": "チャレンジ。開けば開けるほど"}, {"type": "subtitle", "time": 13157.55, "timestamp": "03:39:17", "text": "お金"}, {"type": "subtitle", "time": 13161.11, "timestamp": "03:39:21", "text": "手に入れるか何か。ああ、それは大きな"}, {"type": "subtitle", "time": 13187.99, "timestamp": "03:39:47", "text": "BGMをミュートにした方がいいでしょうか？それ"}, {"type": "subtitle", "time": 13189.51, "timestamp": "03:39:49", "text": "ゲームに干渉している可能性がある"}]
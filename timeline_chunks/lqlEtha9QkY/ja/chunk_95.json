[{"type": "subtitle", "time": 5700.35, "timestamp": "01:35:00", "text": "私たちは辞めました"}, {"type": "subtitle", "time": 5702.83, "timestamp": "01:35:02", "text": "それを始めて、"}, {"type": "subtitle", "time": 5706.31, "timestamp": "01:35:06", "text": "また。私たちは章の始まりを告げた。ほら、だから私たちは"}, {"type": "subtitle", "time": 5707.79, "timestamp": "01:35:07", "text": "すべて手に入れた"}, {"type": "subtitle", "time": 5710.189, "timestamp": "01:35:10", "text": "思い出はまさに"}, {"type": "subtitle", "time": 5712.03, "timestamp": "01:35:12", "text": "ミッドタウン、"}, {"type": "subtitle", "time": 5732.31, "timestamp": "01:35:32", "text": "エアコンを少しだけつけます。なんだか"}, {"type": "subtitle", "time": 5738.47, "timestamp": "01:35:38", "text": "上。あ、そういえば、最後に言ったんだけど"}, {"type": "subtitle", "time": 5741.189, "timestamp": "01:35:41", "text": "ストリーム"}, {"type": "subtitle", "time": 5744.149, "timestamp": "01:35:44", "text": "えっと、昨日。私は後戻りできなかった。それで、"}, {"type": "subtitle", "time": 5745.99, "timestamp": "01:35:45", "text": "どうやら私はその中のすべてを終えたようです"}, {"type": "subtitle", "time": 5747.95, "timestamp": "01:35:47", "text": "ビッグスリー"}, {"type": "subtitle", "time": 5755.43, "timestamp": "01:35:55", "text": "うん。待って。えーと、私も"}, {"type": "subtitle", "time": 5757.75, "timestamp": "01:35:57", "text": "いとこが言ったので、いくつかの百合シリーズ"}]
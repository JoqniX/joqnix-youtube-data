[{"type": "subtitle", "time": 16804.99, "timestamp": "04:40:04", "text": "ああ、Epic Gamesでね。"}, {"type": "subtitle", "time": 16813.83, "timestamp": "04:40:13", "text": "見る。えっと、"}, {"type": "subtitle", "time": 16820.23, "timestamp": "04:40:20", "text": "なんてこった？尾行を捕まえた。友人"}, {"type": "subtitle", "time": 16823.99, "timestamp": "04:40:23", "text": "船の柄杓の。主よ、それは実際には"}, {"type": "subtitle", "time": 16831.35, "timestamp": "04:40:31", "text": "市民よ、この大きなものは違法に"}, {"type": "subtitle", "time": 16833.91, "timestamp": "04:40:33", "text": "自動車に取り付けられる。お願いします"}, {"type": "subtitle", "time": 16836.948, "timestamp": "04:40:36", "text": "手伝ってください。急げ、この野郎ども。"}, {"type": "subtitle", "time": 16839.83, "timestamp": "04:40:39", "text": "災害"}, {"type": "subtitle", "time": 16843.11, "timestamp": "04:40:43", "text": "ゴミを処分する。ああ、この人か。"}, {"type": "subtitle", "time": 16846.55, "timestamp": "04:40:46", "text": "市民の皆様、この車両は不正アクセスを受けています。"}, {"type": "subtitle", "time": 16849.83, "timestamp": "04:40:49", "text": "消毒しなければなりません。消毒してあげるよ、"}, {"type": "subtitle", "time": 16859.51, "timestamp": "04:40:59", "text": "続けて。"}]
[{"type": "subtitle", "time": 17781.43, "timestamp": "04:56:21", "text": "あ、待って。私はXマウス操作はしませんでした"}, {"type": "subtitle", "time": 17784.47, "timestamp": "04:56:24", "text": "ボタン。我慢する。"}, {"type": "subtitle", "time": 17787.67, "timestamp": "04:56:27", "text": "ああ、私が勝った。 100です。あ、待ってください。私は勝ちました"}, {"type": "subtitle", "time": 17791.59, "timestamp": "04:56:31", "text": "ええと、戦争。さあ行こう。そしてXOSボタン。あなた"}, {"type": "subtitle", "time": 17794.07, "timestamp": "04:56:34", "text": "オンになっているはずです。"}, {"type": "subtitle", "time": 17797.35, "timestamp": "04:56:37", "text": "さあ、始まったぞ。わかった。良い。良い。"}, {"type": "subtitle", "time": 17800.708, "timestamp": "04:56:40", "text": "ゲームに戻ると、"}, {"type": "subtitle", "time": 17803.59, "timestamp": "04:56:43", "text": "くっつく"}, {"type": "subtitle", "time": 17807.67, "timestamp": "04:56:47", "text": "なぜなら私たちは家族であり、家族だからです。"}, {"type": "subtitle", "time": 17809.99, "timestamp": "04:56:49", "text": "さあ、着きました。新しいものを手に入れよう"}, {"type": "subtitle", "time": 17811.99, "timestamp": "04:56:51", "text": "ハンバーガーが売れています。そのボタンを押して"}, {"type": "subtitle", "time": 17815.15, "timestamp": "04:56:55", "text": "あのデカくて分厚いハンバーガーを破壊しろ。うん。おお"}, {"type": "subtitle", "time": 17819.43, "timestamp": "04:56:59", "text": "神。肉に関するデータが不足しています。"}]
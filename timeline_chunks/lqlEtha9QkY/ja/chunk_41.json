[{"type": "subtitle", "time": 2467.03, "timestamp": "00:41:07", "text": "みんながこう言い始めた"}, {"type": "subtitle", "time": 2470.63, "timestamp": "00:41:10", "text": "はい、私はわがままです。はじめまして。"}, {"type": "subtitle", "time": 2473.27, "timestamp": "00:41:13", "text": "少なくともサブ目標とかは用意しておこう"}, {"type": "subtitle", "time": 2476.55, "timestamp": "00:41:16", "text": "サブ目標は達成しましたか？"}, {"type": "subtitle", "time": 2480.47, "timestamp": "00:41:20", "text": "そして実際はそうではなかった"}, {"type": "chat", "time": 2483.099, "timestamp": "00:41:23", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "lmao"}, {"type": "subtitle", "time": 2483.27, "timestamp": "00:41:23", "text": "いくつか試してみましたが、ポイントも気に入っています"}, {"type": "subtitle", "time": 2485.91, "timestamp": "00:41:25", "text": "知ってるでしょ、それがさらに混乱を招いたんだよ"}, {"type": "subtitle", "time": 2489.67, "timestamp": "00:41:29", "text": "それで私は「どうすればいいんだろう」と思った"}, {"type": "subtitle", "time": 2492.55, "timestamp": "00:41:32", "text": "しかし、あなたは現在175ポイントを獲得しています。それはとても"}, {"type": "subtitle", "time": 2495.47, "timestamp": "00:41:35", "text": "ニース。それはいくらですか"}, {"type": "subtitle", "time": 2498.47, "timestamp": "00:41:38", "text": "寄付？ 17,000。"}, {"type": "subtitle", "time": 2501.71, "timestamp": "00:41:41", "text": "いいえ、それは いいえ、それは"}, {"type": "subtitle", "time": 2506.63, "timestamp": "00:41:46", "text": "いいえ、1ポイントは"}, {"type": "subtitle", "time": 2511.75, "timestamp": "00:41:51", "text": "会員権は1つ。 1つだと思います"}, {"type": "subtitle", "time": 2514.23, "timestamp": "00:41:54", "text": "サブとその他すべては、おそらく一つの点だと思います。"}, {"type": "subtitle", "time": 2516.71, "timestamp": "00:41:56", "text": "ああ、会員権がある"}, {"type": "subtitle", "time": 2519.27, "timestamp": "00:41:59", "text": "今。 YouTubeのやつは知らない。私はしていません"}]
[{"type": "subtitle", "time": 6070.43, "timestamp": "01:41:10", "text": "うんうん、話せるよ"}, {"type": "subtitle", "time": 6073.35, "timestamp": "01:41:13", "text": "お気に入りのアイテムやおすすめアイテム"}, {"type": "subtitle", "time": 6076.39, "timestamp": "01:41:16", "text": "他にも見るべきアニメや作品。そうだった"}, {"type": "subtitle", "time": 6085.669, "timestamp": "01:41:25", "text": "いいね。知らなかったけど、"}, {"type": "subtitle", "time": 6088.47, "timestamp": "01:41:28", "text": "返してもらった。待って、これは"}, {"type": "subtitle", "time": 6091.43, "timestamp": "01:41:31", "text": "もう一度お返しをする？忘れた。それを見た"}, {"type": "subtitle", "time": 6094.35, "timestamp": "01:41:34", "text": "言葉。私は"}, {"type": "subtitle", "time": 6099.55, "timestamp": "01:41:39", "text": "Google を喜んでコピーします"}, {"type": "subtitle", "time": 6102.31, "timestamp": "01:41:42", "text": "互いに与えたり受け取ったりすることを探す"}, {"type": "subtitle", "time": 6104.669, "timestamp": "01:41:44", "text": "交換して、与えられた感情を示す"}]
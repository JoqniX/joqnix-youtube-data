[{"type": "subtitle", "time": 10566.79, "timestamp": "02:56:06", "text": "ピットフ ああ、大変だ。もちろん違います。"}, {"type": "subtitle", "time": 10568.71, "timestamp": "02:56:08", "text": "そこのボタンを使って最初の"}, {"type": "subtitle", "time": 10579.83, "timestamp": "02:56:19", "text": "エル・フエゴ。彼をエル・フエゴと呼ぼう。銀強化"}, {"type": "subtitle", "time": 10582.79, "timestamp": "02:56:22", "text": "みんなの好意の力で。あなた"}, {"type": "subtitle", "time": 10586.15, "timestamp": "02:56:26", "text": "絵文字とか作れるよ。何？"}, {"type": "subtitle", "time": 10589.91, "timestamp": "02:56:29", "text": "ああ、それは起こるはずがない。いいえ、"}, {"type": "subtitle", "time": 10592.95, "timestamp": "02:56:32", "text": "彼は亡くなった。故障したに違いない。"}, {"type": "subtitle", "time": 10595.67, "timestamp": "02:56:35", "text": "でも大丈夫。あと2人いる。電話"}, {"type": "subtitle", "time": 10601.269, "timestamp": "02:56:41", "text": "ああ、それらは同じものを持っている。電話します"}, {"type": "subtitle", "time": 10604.469, "timestamp": "02:56:44", "text": "笑顔の顔文字。激怒した"}, {"type": "subtitle", "time": 10613.19, "timestamp": "02:56:53", "text": "ああ、大変だ。ああ、それはうまくいかなかった"}, {"type": "subtitle", "time": 10617.83, "timestamp": "02:56:57", "text": "どちらか。いいえ、二人とも亡くなりました。"}]
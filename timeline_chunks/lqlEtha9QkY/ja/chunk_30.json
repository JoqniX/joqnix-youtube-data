[{"type": "subtitle", "time": 1800.87, "timestamp": "00:30:00", "text": "どのゲームをプレイするかを決める。私は決して"}, {"type": "subtitle", "time": 1803.389, "timestamp": "00:30:03", "text": "痛みだと思う"}, {"type": "subtitle", "time": 1806.389, "timestamp": "00:30:06", "text": "なぜならそれは私の唯一のものだからです"}, {"type": "subtitle", "time": 1809.59, "timestamp": "00:30:09", "text": "私にできることはゲームだけだ。凝縮したい"}, {"type": "subtitle", "time": 1812.47, "timestamp": "00:30:12", "text": "コラボレーションの種類はわからないけど、"}, {"type": "subtitle", "time": 1815.59, "timestamp": "00:30:15", "text": "どのようなコラボレーションをするか"}, {"type": "subtitle", "time": 1818.389, "timestamp": "00:30:18", "text": "他のクリエイターを見ると、"}, {"type": "subtitle", "time": 1821.389, "timestamp": "00:30:21", "text": "同僚や友人でさえも"}, {"type": "subtitle", "time": 1825.47, "timestamp": "00:30:25", "text": "良質なオリジナル製品を作るのは誰ですか？"}, {"type": "subtitle", "time": 1828.95, "timestamp": "00:30:28", "text": "ストリーム上の新しいオーバーレイなどのコンテンツ。"}, {"type": "subtitle", "time": 1830.19, "timestamp": "00:30:30", "text": "のように、"}, {"type": "subtitle", "time": 1833.99, "timestamp": "00:30:33", "text": "おお。嫉妬しているわけではなく、私も欲しいと思っている。"}, {"type": "subtitle", "time": 1836.83, "timestamp": "00:30:36", "text": "それを行うために。なぜ私はこんなに"}, {"type": "subtitle", "time": 1840.95, "timestamp": "00:30:40", "text": "非現実的？非現実的ではない。えっと、もっと"}, {"type": "subtitle", "time": 1842.59, "timestamp": "00:30:42", "text": "のように"}, {"type": "subtitle", "time": 1853.99, "timestamp": "00:30:53", "text": "理想主義者、あるいは創造性の欠如を好む。それ"}, {"type": "subtitle", "time": 1855.87, "timestamp": "00:30:55", "text": "あなたに影響を与える可能性があります。"}, {"type": "subtitle", "time": 1859.71, "timestamp": "00:30:59", "text": "いいえ、体重に関しては時々"}]
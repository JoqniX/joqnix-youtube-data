[{"type": "subtitle", "time": 2761.03, "timestamp": "00:46:01", "text": "人々がクリックする2つのもの"}, {"type": "subtitle", "time": 2763.109, "timestamp": "00:46:03", "text": "のビデオ。"}, {"type": "subtitle", "time": 2765.43, "timestamp": "00:46:05", "text": "おお、"}, {"type": "subtitle", "time": 2769.349, "timestamp": "00:46:09", "text": "それが私の提案です。また、"}, {"type": "subtitle", "time": 2770.67, "timestamp": "00:46:10", "text": "次のようにする"}, {"type": "subtitle", "time": 2773.349, "timestamp": "00:46:13", "text": "長さ。長くしても構いませんが、"}, {"type": "subtitle", "time": 2775.09, "timestamp": "00:46:15", "text": "長くしてください。"}, {"type": "subtitle", "time": 2777.91, "timestamp": "00:46:17", "text": "[音楽]"}, {"type": "subtitle", "time": 2780.39, "timestamp": "00:46:20", "text": "私はこういうクリエイターたちを見ていました"}, {"type": "subtitle", "time": 2782.95, "timestamp": "00:46:22", "text": "ストリーミング配信や動画制作もする人たち"}, {"type": "subtitle", "time": 2785.39, "timestamp": "00:46:25", "text": "配信中、配信をクリップする"}, {"type": "subtitle", "time": 2788.15, "timestamp": "00:46:28", "text": "あれ。私は「ああ、もっと作るんだ」と思った。"}, {"type": "subtitle", "time": 2790.109, "timestamp": "00:46:30", "text": "10分以上"}, {"type": "subtitle", "time": 2793.19, "timestamp": "00:46:33", "text": "彼らがどのようにやっているかをビデオに撮る。彼らはそうするが、彼らは"}, {"type": "subtitle", "time": 2796.309, "timestamp": "00:46:36", "text": "彼らは通常カバーする必要がある"}, {"type": "subtitle", "time": 2801.19, "timestamp": "00:46:41", "text": "30分かけて取り組む価値のあること。ああ、そうだ"}, {"type": "subtitle", "time": 2802.99, "timestamp": "00:46:42", "text": "うんうんうんうんうんうん"}, {"type": "subtitle", "time": 2806.39, "timestamp": "00:46:46", "text": "うん、君なら成功できると思うよ"}, {"type": "subtitle", "time": 2809.589, "timestamp": "00:46:49", "text": "この段階では、必要なことをするだけでよい"}, {"type": "subtitle", "time": 2813.109, "timestamp": "00:46:53", "text": "それを正しく理解するには"}, {"type": "subtitle", "time": 2815.67, "timestamp": "00:46:55", "text": "実験して何が何だか分かる"}, {"type": "subtitle", "time": 2818.87, "timestamp": "00:46:58", "text": "仕事とかは順調に進んでるよ、大丈夫"}]
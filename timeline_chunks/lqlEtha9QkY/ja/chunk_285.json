[{"type": "subtitle", "time": 17102.23, "timestamp": "04:45:02", "text": "ああ。では、待ってください。私は試したと思います"}, {"type": "subtitle", "time": 17105.708, "timestamp": "04:45:05", "text": "彼らが好きなようにプレイしている"}, {"type": "subtitle", "time": 17109.59, "timestamp": "04:45:09", "text": "コープ。だから、ソロで全てを終わらせることはできない"}, {"type": "subtitle", "time": 17111.91, "timestamp": "04:45:11", "text": "彼らですよね？"}, {"type": "subtitle", "time": 17114.07, "timestamp": "04:45:14", "text": "たとえ、"}, {"type": "subtitle", "time": 17117.43, "timestamp": "04:45:17", "text": "クエストが必要な人は、"}, {"type": "subtitle", "time": 17126.11, "timestamp": "04:45:26", "text": "実は。そして、その状況はどうですか？"}, {"type": "subtitle", "time": 17129.67, "timestamp": "04:45:29", "text": "ズロケン？ああ、そうだ、君は死んでいる。それで"}, {"type": "subtitle", "time": 17131.55, "timestamp": "04:45:31", "text": "させて"}, {"type": "subtitle", "time": 17135.03, "timestamp": "04:45:35", "text": "私にはそれはできません。わかった。だから私は"}, {"type": "subtitle", "time": 17137.03, "timestamp": "04:45:37", "text": "ゲームに参加して、それを実行してください。わかった。手に入れた"}, {"type": "subtitle", "time": 17150.51, "timestamp": "04:45:50", "text": "ソーシャルオンラインはあなたの友達として、"}]
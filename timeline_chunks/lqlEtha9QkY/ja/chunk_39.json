[{"type": "subtitle", "time": 2349.109, "timestamp": "00:39:09", "text": "私が何を言っているのか、お分かりでしょう。私 私"}, {"type": "subtitle", "time": 2358.51, "timestamp": "00:39:18", "text": "えっと、でも、聞きたいこともあったんだけど"}, {"type": "subtitle", "time": 2369.75, "timestamp": "00:39:29", "text": "コラボレーションは、"}, {"type": "subtitle", "time": 2373.75, "timestamp": "00:39:33", "text": "友人関係？それとも単なるビジネス関係？"}, {"type": "subtitle", "time": 2375.99, "timestamp": "00:39:35", "text": "ええ、両方ですね。"}, {"type": "subtitle", "time": 2378.31, "timestamp": "00:39:38", "text": "まあ、インディーズにとってはビジネスにはならないだろうね。私たちは"}, {"type": "subtitle", "time": 2381.67, "timestamp": "00:39:41", "text": "インディーズ映画にはお金がない。つまり"}, {"type": "subtitle", "time": 2383.51, "timestamp": "00:39:43", "text": "ほとんどお金がもらえないという感覚"}, {"type": "subtitle", "time": 2391.19, "timestamp": "00:39:51", "text": "あなたが稼ごうとしているのは分かっています。"}, {"type": "subtitle", "time": 2393.95, "timestamp": "00:39:53", "text": "あなたはよくやっています。"}, {"type": "subtitle", "time": 2397.109, "timestamp": "00:39:57", "text": "わかった。それは達成すべき大きな目標だ"}]
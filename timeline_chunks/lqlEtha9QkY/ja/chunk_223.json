[{"type": "subtitle", "time": 13382.75, "timestamp": "03:43:02", "text": "ここ。下記にアクセスするにはどうすればいいですか？"}, {"type": "subtitle", "time": 13385.83, "timestamp": "03:43:05", "text": "場所？この場所より下に行くにはどうすればいいですか？"}, {"type": "subtitle", "time": 13387.99, "timestamp": "03:43:07", "text": "どうすればいいですか"}, {"type": "subtitle", "time": 13389.71, "timestamp": "03:43:09", "text": "どうすれば入手できますか"}, {"type": "subtitle", "time": 13391.95, "timestamp": "03:43:11", "text": "下に？"}, {"type": "subtitle", "time": 13395.83, "timestamp": "03:43:15", "text": "ええと、地下階があります。の"}, {"type": "subtitle", "time": 13399.67, "timestamp": "03:43:19", "text": "暗闇が私を包み込む。ああ、それは"}, {"type": "subtitle", "time": 13401.91, "timestamp": "03:43:21", "text": "君から目が離せない"}, {"type": "subtitle", "time": 13404.87, "timestamp": "03:43:24", "text": "出場者。あなたは動きのある詩がお好きですね。"}, {"type": "subtitle", "time": 13408.67, "timestamp": "03:43:28", "text": "待って、どうして私は死んでいたの？どうすればいいですか"}, {"type": "subtitle", "time": 13412.469, "timestamp": "03:43:32", "text": "この場所より下に行く？ああ、こんな感じ。いいえ、"}, {"type": "subtitle", "time": 13414.75, "timestamp": "03:43:34", "text": "これは"}, {"type": "subtitle", "time": 13417.83, "timestamp": "03:43:37", "text": "方法。これは私がその場所に戻ってきたことを意味します"}, {"type": "subtitle", "time": 13424.229, "timestamp": "03:43:44", "text": "来た。いいえ。どうすればこれにたどり着けるのでしょうか？"}, {"type": "subtitle", "time": 13426.11, "timestamp": "03:43:46", "text": "こちらの場所ですか？"}, {"type": "subtitle", "time": 13428.11, "timestamp": "03:43:48", "text": "のように"}, {"type": "subtitle", "time": 13432.309, "timestamp": "03:43:52", "text": "ここはどこにあるんですか？どうすればいいか"}, {"type": "subtitle", "time": 13435.63, "timestamp": "03:43:55", "text": "この地下の中に入る"}, {"type": "subtitle", "time": 13438.99, "timestamp": "03:43:58", "text": "セクション？だから私は"}]
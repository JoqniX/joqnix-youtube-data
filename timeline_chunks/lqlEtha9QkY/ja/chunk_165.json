[{"type": "subtitle", "time": 9901.349, "timestamp": "02:45:01", "text": "より明確に、いや、もっと"}, {"type": "subtitle", "time": 9904.63, "timestamp": "02:45:04", "text": "より鮮明に、よりぼやけて、うーん"}, {"type": "subtitle", "time": 9907.269, "timestamp": "02:45:07", "text": "ピクセル化に関するもの。"}, {"type": "subtitle", "time": 9918.95, "timestamp": "02:45:18", "text": "さあ行こう。私は自分のウェブサイトをアップグレードしました"}, {"type": "subtitle", "time": 9921.67, "timestamp": "02:45:21", "text": "ホログラフィックホイールのようなもの。だから、それは一種の"}, {"type": "subtitle", "time": 9923.95, "timestamp": "02:45:23", "text": "高度な技術の。"}, {"type": "subtitle", "time": 9926.75, "timestamp": "02:45:26", "text": "そうだよ、"}, {"type": "subtitle", "time": 9930.91, "timestamp": "02:45:30", "text": "男の子。あのね？それを盗もう"}, {"type": "subtitle", "time": 9940.79, "timestamp": "02:45:40", "text": "いいことって何だと思う？"}, {"type": "subtitle", "time": 9944.07, "timestamp": "02:45:44", "text": "この銃について？これは無限の銃だ。"}, {"type": "subtitle", "time": 9948.71, "timestamp": "02:45:48", "text": "つまり、ええと、弾丸は無限ということですね。"}, {"type": "subtitle", "time": 9952.55, "timestamp": "02:45:52", "text": "銃には、"}, {"type": "subtitle", "time": 9955.51, "timestamp": "02:45:55", "text": "銃の中には、"}, {"type": "subtitle", "time": 9958.71, "timestamp": "02:45:58", "text": "あなたはそれを何と呼びますか？お金には弾薬があり、"}]
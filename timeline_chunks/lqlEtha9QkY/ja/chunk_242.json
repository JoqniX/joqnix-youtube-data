[{"type": "subtitle", "time": 14527.51, "timestamp": "04:02:07", "text": "AI を戻して、その新しい AI をこれに接続します"}, {"type": "subtitle", "time": 14534.229, "timestamp": "04:02:14", "text": "それは正しい。ここから出してくれ。だった"}, {"type": "subtitle", "time": 14536.07, "timestamp": "04:02:16", "text": "ああ、シールドもあるんですね。それは"}, {"type": "subtitle", "time": 14540.91, "timestamp": "04:02:20", "text": "良い。これは一体何だ？違法"}, {"type": "subtitle", "time": 14543.99, "timestamp": "04:02:23", "text": "銃器。市民よ、ここから出て行きたいのか？その"}, {"type": "subtitle", "time": 14546.95, "timestamp": "04:02:26", "text": "費用がかかるだろう。おお。あなたにはお金を払わない"}, {"type": "subtitle", "time": 14549.75, "timestamp": "04:02:29", "text": "最悪だ。アクション。それが私があなたにあげた全てです"}, {"type": "subtitle", "time": 14552.55, "timestamp": "04:02:32", "text": "今すぐ。"}, {"type": "subtitle", "time": 14554.15, "timestamp": "04:02:34", "text": "わかった。"}, {"type": "subtitle", "time": 14556.429, "timestamp": "04:02:36", "text": "下"}, {"type": "subtitle", "time": 14564.55, "timestamp": "04:02:44", "text": "素晴らしいショーだった。フォクシーのクルーは本当に知っている"}, {"type": "subtitle", "time": 14567.99, "timestamp": "04:02:47", "text": "男性に特別な気分を味わわせる方法。"}, {"type": "subtitle", "time": 14569.99, "timestamp": "04:02:49", "text": "勝者は自分の"}, {"type": "subtitle", "time": 14572.55, "timestamp": "04:02:52", "text": "顔。"}, {"type": "subtitle", "time": 14573.91, "timestamp": "04:02:53", "text": "君が戦っている間に、私は"}, {"type": "subtitle", "time": 14576.07, "timestamp": "04:02:56", "text": "アイデア。廃棄物管理ロボットは"}, {"type": "subtitle", "time": 14578.15, "timestamp": "04:02:58", "text": "プロメテイアボットの食物連鎖において最下位に位置する。"}]
[{"type": "subtitle", "time": 8644.71, "timestamp": "02:24:04", "text": "Bthering B の話、そして私たちはやらなければならない"}, {"type": "subtitle", "time": 8648.07, "timestamp": "02:24:08", "text": "えっと、キースが手に入れたシミュレーターゲーム"}, {"type": "subtitle", "time": 8652.469, "timestamp": "02:24:12", "text": "ベータテストの早期アクセスについて。それで"}, {"type": "subtitle", "time": 8654.55, "timestamp": "02:24:14", "text": "だからこそ、私たちはそれをしなければならないのです。あ、待って。私の"}, {"type": "subtitle", "time": 8656.99, "timestamp": "02:24:16", "text": "モデルが追跡していません。いいえ、"}, {"type": "subtitle", "time": 8660.51, "timestamp": "02:24:20", "text": "そこには。では、"}, {"type": "subtitle", "time": 8663.08, "timestamp": "02:24:23", "text": "まとめ"}, {"type": "subtitle", "time": 8664.27, "timestamp": "02:24:24", "text": "[音楽]"}, {"type": "subtitle", "time": 8668.51, "timestamp": "02:24:28", "text": "手短に説明します。私はこれをより多く受け取る"}, {"type": "subtitle", "time": 8671.19, "timestamp": "02:24:31", "text": "移動中。最後にまとめると"}]
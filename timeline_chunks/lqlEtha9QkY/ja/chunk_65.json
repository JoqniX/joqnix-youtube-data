[{"type": "subtitle", "time": 3905.349, "timestamp": "01:05:05", "text": "ああ、どうでしたか？わからない。私はとても眠った"}, {"type": "subtitle", "time": 3909.51, "timestamp": "01:05:09", "text": "今日はたくさん運動したのに、まだ眠い。"}, {"type": "subtitle", "time": 3913.349, "timestamp": "01:05:13", "text": "私の鉄分レベルは通常こんな感じです"}, {"type": "subtitle", "time": 3916.39, "timestamp": "01:05:16", "text": "月に数回、非常に低くなり、"}, {"type": "subtitle", "time": 3920.069, "timestamp": "01:05:20", "text": "私は熊のようにぐっすり眠る。私は医者に言った"}, {"type": "subtitle", "time": 3921.99, "timestamp": "01:05:21", "text": "これについて彼らはこう言った、「"}, {"type": "subtitle", "time": 3932.67, "timestamp": "01:05:32", "text": "私ができる最善のことは、"}, {"type": "subtitle", "time": 3935.109, "timestamp": "01:05:35", "text": "運動する。」運動はしないが、"}, {"type": "subtitle", "time": 3938.63, "timestamp": "01:05:38", "text": "あなたはまだとても痩せていますね。"}, {"type": "subtitle", "time": 3941.19, "timestamp": "01:05:41", "text": "ああ、君は食べないんだね。"}, {"type": "subtitle", "time": 3944.549, "timestamp": "01:05:44", "text": "でも、私はちゃんと食べるよ。わからない。あなたは食べるので"}, {"type": "subtitle", "time": 3947.75, "timestamp": "01:05:47", "text": "しかし、それほどでもない。うん。そして、もしあなたが"}, {"type": "subtitle", "time": 3949.309, "timestamp": "01:05:49", "text": "ストリーミングなので"}, {"type": "subtitle", "time": 3952.47, "timestamp": "01:05:52", "text": "あまり食べていないのでしょうね"}, {"type": "subtitle", "time": 3954.549, "timestamp": "01:05:54", "text": "どちらでもいいですよね？"}, {"type": "subtitle", "time": 3957.75, "timestamp": "01:05:57", "text": "そんなに明白なことでしょうか？ああ、確かに私は色々あるよ。"}]
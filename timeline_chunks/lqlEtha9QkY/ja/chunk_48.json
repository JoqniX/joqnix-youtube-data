[{"type": "subtitle", "time": 2890.23, "timestamp": "00:48:10", "text": "ゾッとする。あなたは何も考えていないと思っていた"}, {"type": "subtitle", "time": 2894.47, "timestamp": "00:48:14", "text": "この世界では恥ずかしいことだった。冗談です。"}, {"type": "subtitle", "time": 2903.67, "timestamp": "00:48:23", "text": "また、インドの人々も安全に過ごしてください。"}, {"type": "subtitle", "time": 2907.75, "timestamp": "00:48:27", "text": "私たちのチャットは、私たち自身もインド人です。なれ"}, {"type": "subtitle", "time": 2910.95, "timestamp": "00:48:30", "text": "安全。ああ、そうだ。あなたはおそらくそうではないと思います"}, {"type": "subtitle", "time": 2914.15, "timestamp": "00:48:34", "text": "ニュースを見ることができたが、私は"}, {"type": "subtitle", "time": 2916.79, "timestamp": "00:48:36", "text": "今日はベッドで寝る。"}, {"type": "subtitle", "time": 2919.03, "timestamp": "00:48:39", "text": "ニュースで報道されていることをすべて信じてはいけません。"}, {"type": "subtitle", "time": 2923.54, "timestamp": "00:48:43", "text": "しかし、せめて少しは注意してほしい。わかった。"}, {"type": "subtitle", "time": 2926.39, "timestamp": "00:48:46", "text": "[音楽]"}, {"type": "subtitle", "time": 2930.15, "timestamp": "00:48:50", "text": "お父さんかお母さんに頼んでみて、"}]
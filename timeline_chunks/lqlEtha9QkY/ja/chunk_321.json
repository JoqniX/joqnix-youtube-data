[{"type": "subtitle", "time": 19260.55, "timestamp": "05:21:00", "text": "あと5つのミッションをこなせば契約は終了です"}, {"type": "subtitle", "time": 19263.19, "timestamp": "05:21:03", "text": "上。それでは、もう行って構いません。あなたが言った"}, {"type": "subtitle", "time": 19266.47, "timestamp": "05:21:06", "text": "それは5ミッション前のことだ。いいえ、私は5と言いました"}, {"type": "subtitle", "time": 19268.47, "timestamp": "05:21:08", "text": "任務。 3つのミッション前と3つ"}, {"type": "subtitle", "time": 19270.628, "timestamp": "05:21:10", "text": "5つ前の任務。それを得る"}, {"type": "subtitle", "time": 19273.11, "timestamp": "05:21:13", "text": "まっすぐ行け、兵士。さらに、数字"}, {"type": "subtitle", "time": 19276.23, "timestamp": "05:21:16", "text": "案件。戦争は重要だ。"}, {"type": "subtitle", "time": 19278.31, "timestamp": "05:21:18", "text": "彼はそう言った。あるいは、どんな音がするのか"}, {"type": "subtitle", "time": 19281.11, "timestamp": "05:21:21", "text": "良い？私はヴヴィアンで2回もターンしません"}, {"type": "subtitle", "time": 19282.788, "timestamp": "05:21:22", "text": "ハムサンドイッチ。あなたにとって良いと思うのは、"}, {"type": "subtitle", "time": 19285.27, "timestamp": "05:21:25", "text": "兵士？あなたは契約書に署名しました。もしあなたが"}, {"type": "subtitle", "time": 19287.19, "timestamp": "05:21:27", "text": "あのアイアンベアユニットを保持したいのですが、"}, {"type": "subtitle", "time": 19289.75, "timestamp": "05:21:29", "text": "あと5つの任務。それに、君が必要なんだ"}, {"type": "subtitle", "time": 19291.83, "timestamp": "05:21:31", "text": "欲張りな連中と一緒に外にいる。あなたは辞めた、"}, {"type": "subtitle", "time": 19295.67, "timestamp": "05:21:35", "text": "彼らは死ぬ。ああ、わかった。もう一つ任務がある。"}, {"type": "subtitle", "time": 19298.948, "timestamp": "05:21:38", "text": "どこですか？ディグビーのサイン入り本"}, {"type": "subtitle", "time": 19302.15, "timestamp": "05:21:42", "text": "ベルモットの最高傑作アルバムは『Sex to Grind』。おお"}, {"type": "subtitle", "time": 19305.27, "timestamp": "05:21:45", "text": "いいえ、なくしたはずはありません。"}, {"type": "subtitle", "time": 19308.15, "timestamp": "05:21:48", "text": "Clap Trapsのクローゼットでこれを見つけました。彼"}, {"type": "subtitle", "time": 19309.67, "timestamp": "05:21:49", "text": "それを売ろうとしていた"}, {"type": "subtitle", "time": 19311.51, "timestamp": "05:21:51", "text": "エチョニート。"}, {"type": "subtitle", "time": 19314.19, "timestamp": "05:21:54", "text": "次回はもっと良くなるでしょう。"}, {"type": "subtitle", "time": 19317.91, "timestamp": "05:21:57", "text": "ああ、あなたがそれを取り戻したなんて信じられない。そして"}]
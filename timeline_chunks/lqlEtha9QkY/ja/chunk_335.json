[{"type": "subtitle", "time": 20104.87, "timestamp": "05:35:04", "text": "得る"}, {"type": "subtitle", "time": 20122.27, "timestamp": "05:35:22", "text": "ワンちゃん。よし、"}, {"type": "subtitle", "time": 20126.43, "timestamp": "05:35:26", "text": "行く。旅行する方法があります"}, {"type": "subtitle", "time": 20129.35, "timestamp": "05:35:29", "text": "うさぎ跳びのように速く。スライドします"}, {"type": "subtitle", "time": 20132.788, "timestamp": "05:35:32", "text": "そして、何か行動を起こしてください。私はそれが何であるか忘れました"}, {"type": "subtitle", "time": 20134.75, "timestamp": "05:35:34", "text": "それ"}, {"type": "subtitle", "time": 20137.51, "timestamp": "05:35:37", "text": "電話がかかってきた。パッチが適用されなかったようですね"}, {"type": "subtitle", "time": 20153.11, "timestamp": "05:35:53", "text": "ああ、もう死んじゃうよ。"}]
[{"type": "subtitle", "time": 9002.71, "timestamp": "02:30:02", "text": "私はタイピングをテストしようとしていました"}, {"type": "subtitle", "time": 9040.83, "timestamp": "02:30:40", "text": "明日私たちは"}, {"type": "subtitle", "time": 9043.23, "timestamp": "02:30:43", "text": "月曜日以外"}, {"type": "subtitle", "time": 9045.75, "timestamp": "02:30:45", "text": "カフェ。私たちは月曜日以外の日にもっとプレーします"}]
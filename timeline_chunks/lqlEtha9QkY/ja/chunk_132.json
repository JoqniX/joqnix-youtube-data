[{"type": "subtitle", "time": 7923.149, "timestamp": "02:12:03", "text": "破壊するかもしれない"}, {"type": "subtitle", "time": 7935.95, "timestamp": "02:12:15", "text": "猫。"}, {"type": "subtitle", "time": 7937.63, "timestamp": "02:12:17", "text": "えっと、私は何をすればいいですか"}, {"type": "subtitle", "time": 7938.91, "timestamp": "02:12:18", "text": "[音楽]"}, {"type": "subtitle", "time": 7950.069, "timestamp": "02:12:30", "text": "ええと、それは無限だと思います。彼は"}, {"type": "subtitle", "time": 7953.51, "timestamp": "02:12:33", "text": "物を引き剥がすことについて。一部の人にとって"}, {"type": "subtitle", "time": 7968.75, "timestamp": "02:12:48", "text": "あまりにも。彼は私たちに靴を履かせようとするだろう"}]
[{"type": "subtitle", "time": 11760.07, "timestamp": "03:16:00", "text": "それでは、これらのヴォルトハンターを取り上げます。"}, {"type": "subtitle", "time": 11762.63, "timestamp": "03:16:02", "text": "さあ、ご褒美をもらいに来てください。"}, {"type": "subtitle", "time": 11764.63, "timestamp": "03:16:04", "text": "こんにちは、"}, {"type": "subtitle", "time": 11774.87, "timestamp": "03:16:14", "text": "よし、"}, {"type": "subtitle", "time": 11776.95, "timestamp": "03:16:16", "text": "本当に感謝してもしきれません。"}, {"type": "subtitle", "time": 11779.349, "timestamp": "03:16:19", "text": "ハンター。これは小さなことのように思えるかもしれませんが"}, {"type": "subtitle", "time": 11781.99, "timestamp": "03:16:21", "text": "物事、しかしこのちょっとした味見でさえ"}, {"type": "subtitle", "time": 11784.55, "timestamp": "03:16:24", "text": "私たちが失った世界、それが私たちを前進させてくれる、"}, {"type": "subtitle", "time": 11787.11, "timestamp": "03:16:27", "text": "知る？少なくとも明日の朝までは。"}, {"type": "subtitle", "time": 11798.63, "timestamp": "03:16:38", "text": "ハンター。"}, {"type": "subtitle", "time": 11799.99, "timestamp": "03:16:39", "text": "戦いに挑みに行けたらいいのに"}, {"type": "subtitle", "time": 11801.99, "timestamp": "03:16:41", "text": "悪者たち。"}, {"type": "subtitle", "time": 11805.11, "timestamp": "03:16:45", "text": "着心地が良い。ええ、そうですね。感じる"}, {"type": "subtitle", "time": 11806.99, "timestamp": "03:16:46", "text": "良い、"}, {"type": "subtitle", "time": 11810.15, "timestamp": "03:16:50", "text": "右？これはロックペダルの発射です。"}, {"type": "subtitle", "time": 11817.349, "timestamp": "03:16:57", "text": "実は。何か売ろうよ。だから私たちは"}]
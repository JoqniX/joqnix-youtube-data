[{"type": "subtitle", "time": 12967.75, "timestamp": "03:36:07", "text": "わかったか？この安っぽい"}, {"type": "subtitle", "time": 12971.11, "timestamp": "03:36:11", "text": "そして、たった一人で。私は夢中になっているかもしれないが、"}, {"type": "subtitle", "time": 12972.75, "timestamp": "03:36:12", "text": "少なくとも私は"}, {"type": "subtitle", "time": 12981.429, "timestamp": "03:36:21", "text": "共振器。今は、"}, {"type": "subtitle", "time": 12984.389, "timestamp": "03:36:24", "text": "自動拳銃、無限銃、だから"}, {"type": "subtitle", "time": 12993.51, "timestamp": "03:36:33", "text": "兵器。しかし、この銃は"}, {"type": "subtitle", "time": 12994.99, "timestamp": "03:36:34", "text": "低電力"}, {"type": "subtitle", "time": 12998.309, "timestamp": "03:36:38", "text": "残念ながら。私に健康を与えてください。ください"}, {"type": "subtitle", "time": 13004.389, "timestamp": "03:36:44", "text": "[音楽]"}]
[{"type": "subtitle", "time": 14582.87, "timestamp": "04:03:02", "text": "全くの言いなりだ。散らかしちゃえ。"}, {"type": "subtitle", "time": 14587.349, "timestamp": "04:03:07", "text": "浄化槽を壊す。わかった。"}, {"type": "subtitle", "time": 14591.75, "timestamp": "04:03:11", "text": "噴水。ああ、素晴らしい日だ。リサイクル"}, {"type": "subtitle", "time": 14600.95, "timestamp": "04:03:20", "text": "殺せ。"}, {"type": "subtitle", "time": 14604.469, "timestamp": "04:03:24", "text": "ああ、何か買ってあげて。殺すべきだろうか？"}, {"type": "subtitle", "time": 14606.229, "timestamp": "04:03:26", "text": "彼らに仕事を終わらせさせるべきか、それとも"}, {"type": "subtitle", "time": 14618.55, "timestamp": "04:03:38", "text": "こんなに汚れたら絶対に掃除できない"}, {"type": "subtitle", "time": 14621.91, "timestamp": "04:03:41", "text": "私自身の。手に負えない状況だ。よお、B、"}, {"type": "subtitle", "time": 14623.11, "timestamp": "04:03:43", "text": "ここから出て行け。それからあなたとあなたの"}, {"type": "subtitle", "time": 14625.03, "timestamp": "04:03:45", "text": "仲間たちはこのガラクタ箱を全部片付けることができる"}, {"type": "subtitle", "time": 14629.269, "timestamp": "04:03:49", "text": "あなたが望むもの。出してくれ。どうしたの？"}, {"type": "subtitle", "time": 14633.91, "timestamp": "04:03:53", "text": "マスターするまで３、２、１。ああ、いや、いや、"}, {"type": "subtitle", "time": 14636.389, "timestamp": "04:03:56", "text": "いや、いや、いや、いや、いや。"}]
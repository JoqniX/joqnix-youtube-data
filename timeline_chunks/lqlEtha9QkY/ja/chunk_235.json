[{"type": "subtitle", "time": 14106.95, "timestamp": "03:55:06", "text": "コンテストで優勝した人は"}, {"type": "subtitle", "time": 14112.95, "timestamp": "03:55:12", "text": "資格。待って、彼女は手に入れるはずなの？"}, {"type": "subtitle", "time": 14126.63, "timestamp": "03:55:26", "text": "兄弟？ああ、家族全員だ。"}, {"type": "subtitle", "time": 14132.95, "timestamp": "03:55:32", "text": "自分の好きなことをしている。おお。ああ、それは"}, {"type": "subtitle", "time": 14137.51, "timestamp": "03:55:37", "text": "高い。わかった。ざまあみろ。"}, {"type": "subtitle", "time": 14139.55, "timestamp": "03:55:39", "text": "私たちは"}, {"type": "subtitle", "time": 14142.429, "timestamp": "03:55:42", "text": "それ。"}, {"type": "subtitle", "time": 14150.429, "timestamp": "03:55:50", "text": "さあ。来て。与える"}, {"type": "subtitle", "time": 14153.79, "timestamp": "03:55:53", "text": "自分。わかった。感謝"}, {"type": "subtitle", "time": 14157.63, "timestamp": "03:55:57", "text": "お母さん、あなたよ。あれは、あなたのお母さんです。"}]
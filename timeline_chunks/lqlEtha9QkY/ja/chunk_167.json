[{"type": "subtitle", "time": 10021.99, "timestamp": "02:47:01", "text": "ズキやニャーを見ているときのように、"}, {"type": "subtitle", "time": 10025.03, "timestamp": "02:47:05", "text": "コードストリームには、このようなぼやけはありません。"}, {"type": "subtitle", "time": 10027.91, "timestamp": "02:47:07", "text": "私は「なんで私だけなの？」って思うんです。なぜなぜ"}, {"type": "subtitle", "time": 10043.91, "timestamp": "02:47:23", "text": "なぜ私は"}, {"type": "subtitle", "time": 10047.349, "timestamp": "02:47:27", "text": "ああ、しまった。ブナーへの連絡は最優先事項です。"}, {"type": "subtitle", "time": 10059.51, "timestamp": "02:47:39", "text": "壁の問題を解くつもりですか？"}, {"type": "subtitle", "time": 10076.79, "timestamp": "02:47:56", "text": "どういう意味ですか？"}]
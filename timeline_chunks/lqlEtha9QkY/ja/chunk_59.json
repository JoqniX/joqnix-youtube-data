[{"type": "subtitle", "time": 3542.87, "timestamp": "00:59:02", "text": "全身全霊を込めて取り組みました。そしてそれは"}, {"type": "subtitle", "time": 3545.549, "timestamp": "00:59:05", "text": "私はそうせざるを得ないのです。私は行かない"}, {"type": "subtitle", "time": 3550.069, "timestamp": "00:59:10", "text": "なんで私がこれをやらなきゃいけないの？"}, {"type": "subtitle", "time": 3551.91, "timestamp": "00:59:11", "text": "時には、自分に無理強いしなければならない"}, {"type": "subtitle", "time": 3555.19, "timestamp": "00:59:15", "text": "ストリームですが、それはあなたが"}, {"type": "subtitle", "time": 3564.99, "timestamp": "00:59:24", "text": "個人的には"}, {"type": "subtitle", "time": 3568.91, "timestamp": "00:59:28", "text": "つまり、それはあなたが"}, {"type": "subtitle", "time": 3572.39, "timestamp": "00:59:32", "text": "無理をして自分を疲れさせないでください。あなた"}, {"type": "subtitle", "time": 3575.51, "timestamp": "00:59:35", "text": "単に"}, {"type": "subtitle", "time": 3583.75, "timestamp": "00:59:43", "text": "定義するのは難しい。趣味とは"}, {"type": "subtitle", "time": 3587.51, "timestamp": "00:59:47", "text": "それは、あなたが心の平安のために行うことです。"}, {"type": "subtitle", "time": 3590.23, "timestamp": "00:59:50", "text": "それはあなたが情熱を注げるものだ。あなた"}, {"type": "subtitle", "time": 3592.23, "timestamp": "00:59:52", "text": "情熱がない。それはあなたが"}, {"type": "subtitle", "time": 3594.87, "timestamp": "00:59:54", "text": "メインの活動とは別にサイドで行うこと"}]
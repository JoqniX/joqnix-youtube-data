[{"type": "subtitle", "time": 12602.309, "timestamp": "03:30:02", "text": "彼は何か言った？言うべきでしょうか"}, {"type": "subtitle", "time": 12610.95, "timestamp": "03:30:10", "text": "神。ああ、神様。このゲームは18歳以上対象だと知っています"}, {"type": "subtitle", "time": 12614.87, "timestamp": "03:30:14", "text": "それに、でも私はとても家族です"}, {"type": "subtitle", "time": 12641.71, "timestamp": "03:30:41", "text": "行ってもいいですよ"}, {"type": "subtitle", "time": 12644.71, "timestamp": "03:30:44", "text": "戻る。スーザンにヤられそうになるジョーク。"}, {"type": "subtitle", "time": 12646.71, "timestamp": "03:30:46", "text": "うん。"}]
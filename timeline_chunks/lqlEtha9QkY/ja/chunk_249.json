[{"type": "subtitle", "time": 14947.269, "timestamp": "04:09:07", "text": "よし。"}, {"type": "subtitle", "time": 14950.15, "timestamp": "04:09:10", "text": "戻ってくる。彼女を捕まえろ。あなたに"}, {"type": "subtitle", "time": 14961.23, "timestamp": "04:09:21", "text": "殺人銃撃。"}, {"type": "subtitle", "time": 14966.51, "timestamp": "04:09:26", "text": "モクシーのクルーは"}, {"type": "subtitle", "time": 14969.269, "timestamp": "04:09:29", "text": "勝てば現実になる。ああ、それは難しい"}, {"type": "subtitle", "time": 14971.99, "timestamp": "04:09:31", "text": "あなたに向けて発砲しました。心配しないで、私には"}, {"type": "subtitle", "time": 14975.269, "timestamp": "04:09:35", "text": "一致するペア。"}, {"type": "subtitle", "time": 14979.11, "timestamp": "04:09:39", "text": "なぜショットガンの話をしているのですか？"}, {"type": "subtitle", "time": 14981.269, "timestamp": "04:09:41", "text": "だって俺は金のショットガンを持ってるんだから。彼らは"}, {"type": "subtitle", "time": 14984.95, "timestamp": "04:09:44", "text": "私をからかっているのか何か。"}, {"type": "subtitle", "time": 14987.51, "timestamp": "04:09:47", "text": "よくもそんなことを！お前を殺してやる"}]
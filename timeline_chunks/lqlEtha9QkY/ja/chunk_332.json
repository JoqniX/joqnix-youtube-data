[{"type": "subtitle", "time": 19926.868, "timestamp": "05:32:06", "text": "えっと、他に何かありますか？うん、これはできる"}, {"type": "subtitle", "time": 19930.23, "timestamp": "05:32:10", "text": "売る。さあ、使ってみようじゃないか？"}, {"type": "subtitle", "time": 19933.868, "timestamp": "05:32:13", "text": "ここへ行って、あの武器を取ってください。飲む"}, {"type": "subtitle", "time": 19937.19, "timestamp": "05:32:17", "text": "それ。スペースが広くなりました。ロックを解除する必要があります"}, {"type": "subtitle", "time": 19946.15, "timestamp": "05:32:26", "text": "いつか。 4番目をアンロックしたい"}]
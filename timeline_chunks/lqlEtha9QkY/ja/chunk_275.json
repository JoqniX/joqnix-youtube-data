[{"type": "subtitle", "time": 16505.349, "timestamp": "04:35:05", "text": "あなたは女の子を喜ばせる方法をよく知っていますね"}, {"type": "subtitle", "time": 16507.67, "timestamp": "04:35:07", "text": "伝説の前面。それは何ですか？ 132"}, {"type": "subtitle", "time": 16510.629, "timestamp": "04:35:10", "text": "伝説のチャンピオンよ、いつでも好きな時に。"}, {"type": "subtitle", "time": 16512.629, "timestamp": "04:35:12", "text": "見てください、これは最も文明的なものではありません"}, {"type": "subtitle", "time": 16515.429, "timestamp": "04:35:15", "text": "銀河。それは分かります。すべてを撮影することはできません"}, {"type": "subtitle", "time": 16517.189, "timestamp": "04:35:17", "text": "口を滑らせる野郎、"}, {"type": "subtitle", "time": 16520.709, "timestamp": "04:35:20", "text": "私を侮辱しようとする。こんにちは。こんにちは。私はできる"}, {"type": "subtitle", "time": 16522.789, "timestamp": "04:35:22", "text": "試す。"}, {"type": "subtitle", "time": 16525.59, "timestamp": "04:35:25", "text": "ああ。"}, {"type": "subtitle", "time": 16528.949, "timestamp": "04:35:28", "text": "はい、完了しました。それで、えっと、私たちは"}, {"type": "subtitle", "time": 16533.269, "timestamp": "04:35:33", "text": "受けたクエストのほとんどをクリアした。"}, {"type": "subtitle", "time": 16535.629, "timestamp": "04:35:35", "text": "待って。"}, {"type": "subtitle", "time": 16537.709, "timestamp": "04:35:37", "text": "あの、離してください"}, {"type": "subtitle", "time": 16540.349, "timestamp": "04:35:40", "text": "ここで並べ替え"}, {"type": "subtitle", "time": 16543.67, "timestamp": "04:35:43", "text": "地域。刑務所のこの部分は"}, {"type": "subtitle", "time": 16548.269, "timestamp": "04:35:48", "text": "郊外、そしてこれが最後です"}, {"type": "subtitle", "time": 16550.551, "timestamp": "04:35:50", "text": "信じる。サインは全て揃ったか"}, {"type": "subtitle", "time": 16554.47, "timestamp": "04:35:54", "text": "任務？えっと、これは何ですか？ああ、これは"}, {"type": "subtitle", "time": 16556.949, "timestamp": "04:35:56", "text": "恐ろしいデッドドロップ。ここへ行けます。私たちは"}, {"type": "subtitle", "time": 16558.47, "timestamp": "04:35:58", "text": "すべて集めました。私たちは"}]
[{"type": "subtitle", "time": 17821.67, "timestamp": "04:57:01", "text": "残念。消化器に肉がなくなりました"}, {"type": "subtitle", "time": 17823.51, "timestamp": "04:57:03", "text": "サンプル。"}, {"type": "subtitle", "time": 17826.15, "timestamp": "04:57:06", "text": "肉のサンプルが入っていないダイナスティバーガー。"}, {"type": "subtitle", "time": 17828.15, "timestamp": "04:57:08", "text": "わかった。サンプルを持ってきてほしい"}, {"type": "subtitle", "time": 17835.19, "timestamp": "04:57:15", "text": "何？俺の仲間を信じろ。聞こえるかもしれないけど"}, {"type": "subtitle", "time": 17837.948, "timestamp": "04:57:17", "text": "ひどいけど、ハンバーガーがすごく美味しくなる"}, {"type": "subtitle", "time": 17842.44, "timestamp": "04:57:22", "text": "ジューシー。ゴミがある。彼を捕まえろ。"}, {"type": "subtitle", "time": 17843.67, "timestamp": "04:57:23", "text": "[音楽]"}, {"type": "subtitle", "time": 17848.23, "timestamp": "04:57:28", "text": "ラッチの溶岩。やあ、兄弟。わかった、それはただ"}, {"type": "subtitle", "time": 17851.19, "timestamp": "04:57:31", "text": "音質が良いですね。それは"}, {"type": "subtitle", "time": 17853.51, "timestamp": "04:57:33", "text": "またしても我々の後を追ってきた。の"}, {"type": "subtitle", "time": 17856.31, "timestamp": "04:57:36", "text": "大型犬は移動しているようだ"}, {"type": "subtitle", "time": 17859.35, "timestamp": "04:57:39", "text": "プロメイアで我々の軍勢を打ち破れ。気を引き締めて"}, {"type": "subtitle", "time": 17861.27, "timestamp": "04:57:41", "text": "兄弟姉妹の皆さん、そして"}, {"type": "subtitle", "time": 17864.708, "timestamp": "04:57:44", "text": "電動のこぎりの刃をさらに鋭く保ちましょう。おお、"}, {"type": "subtitle", "time": 17868.31, "timestamp": "04:57:48", "text": "できないよ、彼のためにできないんだ。おお、いいね。"}, {"type": "subtitle", "time": 17870.788, "timestamp": "04:57:50", "text": "それはすごくクールですね。私が気にするべきことは何ですか？"}, {"type": "subtitle", "time": 17872.948, "timestamp": "04:57:52", "text": "待って、彼は私の下半身を欲しがっているとは思えない"}, {"type": "subtitle", "time": 17875.91, "timestamp": "04:57:55", "text": "銃を水平にする。"}, {"type": "subtitle", "time": 17879.07, "timestamp": "04:57:59", "text": "双子の神にすべての栄光あれ。ああ、私は"}]
[{"type": "subtitle", "time": 15431.55, "timestamp": "04:17:11", "text": "3回"}, {"type": "subtitle", "time": 15433.95, "timestamp": "04:17:13", "text": "再び犬​​が現れ"}, {"type": "subtitle", "time": 15436.03, "timestamp": "04:17:16", "text": "我々の戦力"}, {"type": "subtitle", "time": 15438.63, "timestamp": "04:17:18", "text": "ノニア。気を引き締めて、兄弟たちよ"}, {"type": "subtitle", "time": 15441.91, "timestamp": "04:17:21", "text": "姉妹たちよ、そして斧はそのままにしておいて。どうすれば入手できますか"}, {"type": "subtitle", "time": 15445.59, "timestamp": "04:17:25", "text": "トップに？わからない。"}, {"type": "subtitle", "time": 15451.83, "timestamp": "04:17:31", "text": "待って、ゲームには理由があるはずだ"}, {"type": "subtitle", "time": 15463.91, "timestamp": "04:17:43", "text": "登ってもいいですか？ああ、そこにいて"}, {"type": "subtitle", "time": 15472.229, "timestamp": "04:17:52", "text": "はぁ？"}, {"type": "subtitle", "time": 15475.99, "timestamp": "04:17:55", "text": "台風対策ボックスはどこにあるの？はい、こちらへどうぞ。"}]
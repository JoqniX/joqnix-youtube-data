[{"type": "subtitle", "time": 2281.03, "timestamp": "00:38:01", "text": "ミックス。問題はバランスを取る必要があるということです"}, {"type": "subtitle", "time": 2284.23, "timestamp": "00:38:04", "text": "ストリーミングしていることに気づいて、"}, {"type": "subtitle", "time": 2286.87, "timestamp": "00:38:06", "text": "観客が良いものを得られるようにする"}, {"type": "subtitle", "time": 2289.29, "timestamp": "00:38:09", "text": "経験も。"}, {"type": "subtitle", "time": 2291.109, "timestamp": "00:38:11", "text": "[音楽]"}, {"type": "subtitle", "time": 2293.67, "timestamp": "00:38:13", "text": "一方的な方法ではなく、同時に"}, {"type": "subtitle", "time": 2296.55, "timestamp": "00:38:16", "text": "楽しむことも大切だよ。は"}, {"type": "subtitle", "time": 2298.55, "timestamp": "00:38:18", "text": "観客はあなたがいなくても楽しむ"}, {"type": "subtitle", "time": 2300.55, "timestamp": "00:38:20", "text": "楽しい？いや。"}, {"type": "subtitle", "time": 2303.22, "timestamp": "00:38:23", "text": "ええ、そうですね。"}, {"type": "subtitle", "time": 2305.99, "timestamp": "00:38:25", "text": "[音楽]"}, {"type": "subtitle", "time": 2308.71, "timestamp": "00:38:28", "text": "私はこう思った、もしあなたが積極的に私と同じように"}, {"type": "subtitle", "time": 2310.63, "timestamp": "00:38:30", "text": "覚えておいてください、良い例を挙げてあげましょう。"}, {"type": "subtitle", "time": 2313.51, "timestamp": "00:38:33", "text": "誰のことか分かるだろうけど、"}, {"type": "subtitle", "time": 2315.349, "timestamp": "00:38:35", "text": "いわゆる「協力」をしていた。これ"}, {"type": "subtitle", "time": 2317.349, "timestamp": "00:38:37", "text": "YouTuberは、"}, {"type": "subtitle", "time": 2318.03, "timestamp": "00:38:38", "text": "だった"}, {"type": "subtitle", "time": 2321.27, "timestamp": "00:38:41", "text": "積極的に非常に悪い発言をする"}, {"type": "subtitle", "time": 2324.55, "timestamp": "00:38:44", "text": "チャット参加者に関する情報を配信する。"}, {"type": "subtitle", "time": 2328.31, "timestamp": "00:38:48", "text": "H、ビデオとしてコラボレーションしないのがあなたの仕事です"}, {"type": "subtitle", "time": 2331.51, "timestamp": "00:38:51", "text": "そのような人々と一緒にいて、"}, {"type": "subtitle", "time": 2333.67, "timestamp": "00:38:53", "text": "最終的にコミュニティとは"}, {"type": "subtitle", "time": 2335.349, "timestamp": "00:38:55", "text": "ハッピー。"}, {"type": "subtitle", "time": 2337.589, "timestamp": "00:38:57", "text": "ああ"}, {"type": "subtitle", "time": 2339.99, "timestamp": "00:38:59", "text": "私はコラボレーションすることに非常に反対です"}]
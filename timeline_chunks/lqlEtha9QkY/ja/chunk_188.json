[{"type": "subtitle", "time": 11280.55, "timestamp": "03:08:00", "text": "それ自体が事実上の戦争犯罪である。私"}, {"type": "subtitle", "time": 11283.11, "timestamp": "03:08:03", "text": "あの司令官のマグカップが欲しいだけなんだ。ああ、"}, {"type": "subtitle", "time": 11285.11, "timestamp": "03:08:05", "text": "神。私たちは他人のものを盗むつもりだ"}, {"type": "subtitle", "time": 11288.07, "timestamp": "03:08:08", "text": "マグカップでコーヒーを淹れる。何てことだ。何が"}, {"type": "subtitle", "time": 11293.429, "timestamp": "03:08:13", "text": "一般兵の一部を排除して"}, {"type": "subtitle", "time": 11295.51, "timestamp": "03:08:15", "text": "指揮官をおびき出せ。そのマグカップは"}, {"type": "subtitle", "time": 11298.79, "timestamp": "03:08:18", "text": "私の。そのマグカップは私のものです。それはあなたのものではありません。"}, {"type": "subtitle", "time": 11301.03, "timestamp": "03:08:21", "text": "けれど。コーヒーブレイクのようです"}, {"type": "subtitle", "time": 11327.99, "timestamp": "03:08:47", "text": "くたばれ、ヴァルター。私はただ"}, {"type": "subtitle", "time": 11329.91, "timestamp": "03:08:49", "text": "私の"}, {"type": "subtitle", "time": 11332.55, "timestamp": "03:08:52", "text": "うん。こんにちは。どういたしまして。ああ、ありがとう"}, {"type": "subtitle", "time": 11339.309, "timestamp": "03:08:59", "text": "そうそう。ああ、紫色の武器を手に入れたぞ。"}]
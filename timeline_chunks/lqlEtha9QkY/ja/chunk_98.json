[{"type": "subtitle", "time": 5881.39, "timestamp": "01:38:01", "text": "とにかく、そうだね。さよなら。はぁ。それで、"}, {"type": "subtitle", "time": 5884.669, "timestamp": "01:38:04", "text": "えっと、これは"}, {"type": "subtitle", "time": 5887.39, "timestamp": "01:38:07", "text": "あれ。だから私たちは"}, {"type": "subtitle", "time": 5890.55, "timestamp": "01:38:10", "text": "最初の記憶のものが"}, {"type": "subtitle", "time": 5893.03, "timestamp": "01:38:13", "text": "ここ。"}, {"type": "subtitle", "time": 5906.91, "timestamp": "01:38:26", "text": "三つ。待って"}, {"type": "subtitle", "time": 5910.229, "timestamp": "01:38:30", "text": "分。ちょっと待って。それはあなたに示します"}, {"type": "subtitle", "time": 5917.149, "timestamp": "01:38:37", "text": "は。それはまさに"}, {"type": "subtitle", "time": 5920.03, "timestamp": "01:38:40", "text": "いいね。それは本棚の中にあります"}, {"type": "subtitle", "time": 5922.83, "timestamp": "01:38:42", "text": "あれ。我々はそれを手に入れた"}, {"type": "subtitle", "time": 5925.75, "timestamp": "01:38:45", "text": "実は。これは待機中です。私はそれを知っています"}, {"type": "subtitle", "time": 5927.91, "timestamp": "01:38:47", "text": "場所。私はその場所を知っています。待って、待って、"}, {"type": "subtitle", "time": 5936.95, "timestamp": "01:38:56", "text": "待って、待って、待って、待って、待って、待って。私"}, {"type": "subtitle", "time": 5938.35, "timestamp": "01:38:58", "text": "その場所を知っている。"}]
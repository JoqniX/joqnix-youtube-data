[{"type": "subtitle", "time": 18840.45, "timestamp": "05:14:00", "text": "後で。死ぬな。"}, {"type": "subtitle", "time": 18842.868, "timestamp": "05:14:02", "text": "[音楽]"}, {"type": "subtitle", "time": 18845.17, "timestamp": "05:14:05", "text": "でも、本当に盛り上がったパーティーだったよ。楽しい時間だった。"}, {"type": "subtitle", "time": 18851.39, "timestamp": "05:14:11", "text": "おお、"}, {"type": "subtitle", "time": 18853.23, "timestamp": "05:14:13", "text": "見せる。"}, {"type": "subtitle", "time": 18856.91, "timestamp": "05:14:16", "text": "おお。ああ、武器は手に入れたぞ。さあ行こう。"}, {"type": "subtitle", "time": 18863.708, "timestamp": "05:14:23", "text": "うわー、Hがたくさんある"}, {"type": "subtitle", "time": 18868.15, "timestamp": "05:14:28", "text": "武器関連。一体どういうことだ？大丈夫。"}, {"type": "subtitle", "time": 18871.59, "timestamp": "05:14:31", "text": "いつからこれら全部を手に入れたんだろう？何？いいえ、私は"}, {"type": "subtitle", "time": 18873.89, "timestamp": "05:14:33", "text": "もう言った通り、私はそんなことはしない。"}, {"type": "subtitle", "time": 18875.31, "timestamp": "05:14:35", "text": "[音楽]"}, {"type": "subtitle", "time": 18886.27, "timestamp": "05:14:46", "text": "これ？ 250 AR。"}, {"type": "subtitle", "time": 18890.35, "timestamp": "05:14:50", "text": "おお。おお。たくさんの物。"}, {"type": "subtitle", "time": 18892.948, "timestamp": "05:14:52", "text": "おお。行きます。見に行きましょう"}, {"type": "subtitle", "time": 18895.43, "timestamp": "05:14:55", "text": "少しだけ。"}, {"type": "subtitle", "time": 18897.67, "timestamp": "05:14:57", "text": "はい。スカッグミルクが飲みたいな"}]
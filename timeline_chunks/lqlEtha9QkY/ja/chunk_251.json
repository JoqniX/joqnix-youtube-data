[{"type": "subtitle", "time": 15093.11, "timestamp": "04:11:33", "text": "話している。ありがとう。"}, {"type": "subtitle", "time": 15095.269, "timestamp": "04:11:35", "text": "モクシーのクルーが来るのは驚きじゃない"}, {"type": "subtitle", "time": 15097.67, "timestamp": "04:11:37", "text": "トップに立った。それは彼女のお気に入りです"}, {"type": "subtitle", "time": 15100.15, "timestamp": "04:11:40", "text": "位置。"}, {"type": "subtitle", "time": 15102.63, "timestamp": "04:11:42", "text": "そうじゃないんだけど、私は彼にそう言ったんだ。しなければならなかった"}, {"type": "subtitle", "time": 15105.11, "timestamp": "04:11:45", "text": "何とかして私の分も手に入れろ。彼の回路は"}, {"type": "subtitle", "time": 15108.41, "timestamp": "04:11:48", "text": "ちょっと短い、と言えばお分かりいただけるでしょうか。"}]
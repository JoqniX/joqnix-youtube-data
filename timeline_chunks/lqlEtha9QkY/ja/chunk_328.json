[{"type": "subtitle", "time": 19687.548, "timestamp": "05:28:07", "text": "それ？"}, {"type": "subtitle", "time": 19692.51, "timestamp": "05:28:12", "text": "99ですが、1つは4つ持ちます"}, {"type": "subtitle", "time": 19697.548, "timestamp": "05:28:17", "text": "レベル。ああ、なるほど。つまり、これはパワーです"}, {"type": "subtitle", "time": 19701.67, "timestamp": "05:28:21", "text": "壁。自分の血中濃度はどこで確認できますか？おお、"}, {"type": "subtitle", "time": 19705.27, "timestamp": "05:28:25", "text": "待って。レベルが私のレベルより低い。はい、私はバカです。"}, {"type": "subtitle", "time": 19714.03, "timestamp": "05:28:34", "text": "わかった。えっと、ちょっと待って。どれの"}, {"type": "subtitle", "time": 19716.67, "timestamp": "05:28:36", "text": "スキル３？私"}, {"type": "subtitle", "time": 19720.35, "timestamp": "05:28:40", "text": "行くべき"}, {"type": "subtitle", "time": 19723.31, "timestamp": "05:28:43", "text": "えーと"}, {"type": "subtitle", "time": 19726.23, "timestamp": "05:28:46", "text": "ロキシー。ロキシーは、この名前です"}]
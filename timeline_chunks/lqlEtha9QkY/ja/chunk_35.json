[{"type": "subtitle", "time": 2101.069, "timestamp": "00:35:01", "text": "えっと、私は人々に連絡を取りたいんです"}, {"type": "subtitle", "time": 2104.31, "timestamp": "00:35:04", "text": "しかし、誰もが忙しいわけではない。ああ、待って、あなたは"}, {"type": "chat", "time": 2106.01, "timestamp": "00:35:06", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "YO YO"}, {"type": "chat", "time": 2107.781, "timestamp": "00:35:07", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Astra Vt~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 2111.43, "timestamp": "00:35:11", "text": "秒こんにちは。"}, {"type": "subtitle", "time": 2116.51, "timestamp": "00:35:16", "text": "こんにちは。こんにちは。怖かった。何てことだ。こんにちは。"}, {"type": "subtitle", "time": 2124.31, "timestamp": "00:35:24", "text": "こんにちは。冗談です。何てことだ。こんにちは。何？"}, {"type": "subtitle", "time": 2126.28, "timestamp": "00:35:26", "text": "どうしたの？"}, {"type": "subtitle", "time": 2127.51, "timestamp": "00:35:27", "text": "[音楽]"}, {"type": "subtitle", "time": 2129.99, "timestamp": "00:35:29", "text": "4時間。"}, {"type": "subtitle", "time": 2133.15, "timestamp": "00:35:33", "text": "夜になったからかもしれない"}, {"type": "subtitle", "time": 2136.15, "timestamp": "00:35:36", "text": "夜中。いや、いや。ちょっと考えていたんだけど"}, {"type": "subtitle", "time": 2139.31, "timestamp": "00:35:39", "text": "私に一つの疑問が浮かんだ"}, {"type": "subtitle", "time": 2142.39, "timestamp": "00:35:42", "text": "例えば、ある視聴者が"}, {"type": "subtitle", "time": 2145.349, "timestamp": "00:35:45", "text": "YouTuber志望。彼らは"}, {"type": "subtitle", "time": 2148.15, "timestamp": "00:35:48", "text": "明日からチューブに乗って遊び始めるんだ"}, {"type": "subtitle", "time": 2151.03, "timestamp": "00:35:51", "text": "あるいは何か質問すると彼らは"}, {"type": "subtitle", "time": 2154.15, "timestamp": "00:35:54", "text": "コラボしたいか、それとも好きかと聞かれるだろう"}, {"type": "subtitle", "time": 2157.51, "timestamp": "00:35:57", "text": "彼らが始めたら一緒に過ごす"}, {"type": "subtitle", "time": 2159.79, "timestamp": "00:35:59", "text": "ストリーミングを方法として、それから私は"}]
[{"type": "subtitle", "time": 10861.19, "timestamp": "03:01:01", "text": "結局、賭ける価値のあるものだった。"}, {"type": "subtitle", "time": 10865.269, "timestamp": "03:01:05", "text": "つまり、これは142です。"}, {"type": "subtitle", "time": 10872.71, "timestamp": "03:01:12", "text": "欲しいの、わかる？これを保存しておきます"}, {"type": "subtitle", "time": 10876.11, "timestamp": "03:01:16", "text": "上。実際、止めて"}, {"type": "subtitle", "time": 10878.95, "timestamp": "03:01:18", "text": "それ。これは必要ない。実際、私は"}, {"type": "subtitle", "time": 10880.19, "timestamp": "03:01:20", "text": "落とす"}, {"type": "subtitle", "time": 10883.269, "timestamp": "03:01:23", "text": "念のため。回復します。私たちはそうしません"}, {"type": "subtitle", "time": 10884.83, "timestamp": "03:01:24", "text": "作る"}, {"type": "subtitle", "time": 10887.59, "timestamp": "03:01:27", "text": "やけど。これらなら売れるかもしれない。わかった。できました"}, {"type": "subtitle", "time": 10890.389, "timestamp": "03:01:30", "text": "不要なものを売る。アップグレードしました"}, {"type": "subtitle", "time": 10893.429, "timestamp": "03:01:33", "text": "私のバックパック。ええ、戦争遂行のためです。病気"}, {"type": "subtitle", "time": 10895.03, "timestamp": "03:01:35", "text": "それを保管しておいて、私が売ります。わかった。お願いします"}, {"type": "subtitle", "time": 10897.51, "timestamp": "03:01:37", "text": "今すぐ立ち去れ。"}, {"type": "subtitle", "time": 10902.19, "timestamp": "03:01:42", "text": "そして、以下の武器を取ります"}]
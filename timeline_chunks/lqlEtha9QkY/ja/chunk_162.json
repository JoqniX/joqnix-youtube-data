[{"type": "subtitle", "time": 9749.99, "timestamp": "02:42:29", "text": "ああ、わかりました。えっと、それでは、それを包んでいきます"}, {"type": "subtitle", "time": 9752.95, "timestamp": "02:42:32", "text": "もう遅いから、こっちに来てるよ。私たちは"}, {"type": "subtitle", "time": 9755.07, "timestamp": "02:42:35", "text": "早くから始める"}, {"type": "subtitle", "time": 9764.59, "timestamp": "02:42:44", "text": "ここ。えっと、"}, {"type": "subtitle", "time": 9768.59, "timestamp": "02:42:48", "text": "うん。こんにちは。皆さん、おやすみなさい。申し訳ありません"}]
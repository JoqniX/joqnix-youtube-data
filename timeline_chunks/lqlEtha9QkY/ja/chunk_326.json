[{"type": "subtitle", "time": 19574.3, "timestamp": "05:26:14", "text": "あなたはここに来るべきではなかった。"}, {"type": "subtitle", "time": 19591.0, "timestamp": "05:26:31", "text": "うわー、この銃はすごく強力だ。"}, {"type": "subtitle", "time": 19591.69, "timestamp": "05:26:31", "text": "[拍手]"}, {"type": "subtitle", "time": 19611.67, "timestamp": "05:26:51", "text": "208. 毒の宿敵。それが彼の"}, {"type": "subtitle", "time": 19614.03, "timestamp": "05:26:54", "text": "銃、私は"}]
[{"type": "subtitle", "time": 3725.349, "timestamp": "01:02:05", "text": "少しお腹が空いた。おお、"}, {"type": "subtitle", "time": 3728.23, "timestamp": "01:02:08", "text": "お腹がすいた。おお、"}, {"type": "subtitle", "time": 3730.87, "timestamp": "01:02:10", "text": "ほら、私は減らそうとしているんだ"}, {"type": "subtitle", "time": 3733.349, "timestamp": "01:02:13", "text": "私が食べる不健康なもの。それで、私は始めた"}, {"type": "subtitle", "time": 3735.829, "timestamp": "01:02:15", "text": "果物をもっと食べる"}, {"type": "subtitle", "time": 3737.829, "timestamp": "01:02:17", "text": "そして野菜。"}, {"type": "subtitle", "time": 3739.91, "timestamp": "01:02:19", "text": "ニース。ニース。それは昨日から始まった。"}, {"type": "subtitle", "time": 3742.23, "timestamp": "01:02:22", "text": "けれど。わかった。"}, {"type": "subtitle", "time": 3744.069, "timestamp": "01:02:24", "text": "良い。"}, {"type": "subtitle", "time": 3746.67, "timestamp": "01:02:26", "text": "私は牛乳を飲むのが好きです"}, {"type": "subtitle", "time": 3750.47, "timestamp": "01:02:30", "text": "夜。冷たい牛乳。私の好きな牛乳は"}, {"type": "subtitle", "time": 3754.309, "timestamp": "01:02:34", "text": "冷たい牛乳みたいだ。あなたはどうですか？"}, {"type": "subtitle", "time": 3756.67, "timestamp": "01:02:36", "text": "牛乳にもいろいろな種類があります。わかった。"}, {"type": "subtitle", "time": 3761.069, "timestamp": "01:02:41", "text": "温かい牛乳か冷たい牛乳か。"}, {"type": "subtitle", "time": 3764.549, "timestamp": "01:02:44", "text": "はぁ？つまり、ホットミルクのことです。私はあまり好きではない"}, {"type": "subtitle", "time": 3767.19, "timestamp": "01:02:47", "text": "ホットミルクだよ。うん。暑すぎない。"}, {"type": "subtitle", "time": 3768.95, "timestamp": "01:02:48", "text": "うん。"}, {"type": "subtitle", "time": 3771.589, "timestamp": "01:02:51", "text": "今日父は母にこう言っていた。"}, {"type": "subtitle", "time": 3774.87, "timestamp": "01:02:54", "text": "「舌がヒリヒリするくらい熱い牛乳をください。」"}, {"type": "subtitle", "time": 3776.27, "timestamp": "01:02:56", "text": "そして私はこう思った。"}]
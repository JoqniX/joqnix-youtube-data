[{"type": "subtitle", "time": 18667.03, "timestamp": "05:11:07", "text": "誰か弾薬持ってる？すべて使いました"}, {"type": "subtitle", "time": 18674.39, "timestamp": "05:11:14", "text": "さあ、世紀に戻りましょう。さあ行こう。そして"}, {"type": "subtitle", "time": 18709.27, "timestamp": "05:11:49", "text": "これ、電源入ってる？テスト、テスト。やあ、Vault。"}, {"type": "subtitle", "time": 18711.51, "timestamp": "05:11:51", "text": "あなたにチャンスがあります。私は"}, {"type": "subtitle", "time": 18714.948, "timestamp": "05:11:54", "text": "世の中にはそういうものもある。実は、"}, {"type": "subtitle", "time": 18718.23, "timestamp": "05:11:58", "text": "これは金庫に保管しています。"}]
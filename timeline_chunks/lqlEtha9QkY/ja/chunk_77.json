[{"type": "subtitle", "time": 4628.11, "timestamp": "01:17:08", "text": "捨てるべきでしょうか？スタートすら開けない"}, {"type": "subtitle", "time": 4633.62, "timestamp": "01:17:13", "text": "メニュー。少なくとも私は生きている。私は幸せです。私は"}, {"type": "subtitle", "time": 4638.91, "timestamp": "01:17:18", "text": "ライブ。"}, {"type": "subtitle", "time": 4651.11, "timestamp": "01:17:31", "text": "こんにちは。えっと、まだ読み込み中です。そうではありません"}, {"type": "subtitle", "time": 4655.43, "timestamp": "01:17:35", "text": "読み込み中。この車、私のところに戻ってきてくれ。"}, {"type": "subtitle", "time": 4657.39, "timestamp": "01:17:37", "text": "その"}, {"type": "subtitle", "time": 4660.87, "timestamp": "01:17:40", "text": "わかった。それらを開けて殺すことすらできない"}]
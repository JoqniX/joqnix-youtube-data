[{"type": "subtitle", "time": 9482.87, "timestamp": "02:38:02", "text": "私がきちんとやらなければならないことすべて"}, {"type": "subtitle", "time": 9487.349, "timestamp": "02:38:07", "text": "それは正しい。そうしなければならない。"}, {"type": "subtitle", "time": 9489.79, "timestamp": "02:38:09", "text": "私たちはたくさんの"}, {"type": "subtitle", "time": 9494.07, "timestamp": "02:38:14", "text": "私たちには多くのコラボレーションがあり、"}, {"type": "subtitle", "time": 9495.91, "timestamp": "02:38:15", "text": "今月はたくさんのコンテンツを予定しています"}, {"type": "subtitle", "time": 9497.23, "timestamp": "02:38:17", "text": "だけでなく、"}, {"type": "subtitle", "time": 9500.51, "timestamp": "02:38:20", "text": "そう、私は代役の電話をしなければならないし"}, {"type": "subtitle", "time": 9502.67, "timestamp": "02:38:22", "text": "すべて。"}, {"type": "subtitle", "time": 9505.83, "timestamp": "02:38:25", "text": "ええと、でも問題は、私たちはきちんと"}, {"type": "subtitle", "time": 9509.03, "timestamp": "02:38:29", "text": "サブコールを完全に終えて、"}, {"type": "subtitle", "time": 9512.11, "timestamp": "02:38:32", "text": "このジャンクマラソンは、"}, {"type": "subtitle", "time": 9515.27, "timestamp": "02:38:35", "text": "熱が出て体調が悪かったので、準備しておきました。"}, {"type": "subtitle", "time": 9518.15, "timestamp": "02:38:38", "text": "これは当初は緊急案件だった。"}, {"type": "subtitle", "time": 9529.309, "timestamp": "02:38:49", "text": "えーと、サブが何であれ、私が"}, {"type": "subtitle", "time": 9532.95, "timestamp": "02:38:52", "text": "最終決定します。"}, {"type": "subtitle", "time": 9536.11, "timestamp": "02:38:56", "text": "寄付した人の数を数えると"}]
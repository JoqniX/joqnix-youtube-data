[{"type": "subtitle", "time": 12540.469, "timestamp": "03:29:00", "text": "姿を現す。グランド賞を獲得するために応募"}, {"type": "subtitle", "time": 12543.11, "timestamp": "03:29:03", "text": "賞？ E."}, {"type": "subtitle", "time": 12545.51, "timestamp": "03:29:05", "text": "あなたも知っているでしょう。私はチャンピオンを連れてきました"}, {"type": "subtitle", "time": 12548.229, "timestamp": "03:29:08", "text": "私の名において戦え。さらに、私は"}, {"type": "subtitle", "time": 12551.269, "timestamp": "03:29:11", "text": "それを引き伸ばして。私の回路を充電させて"}, {"type": "subtitle", "time": 12553.91, "timestamp": "03:29:13", "text": "接続する少し前に。"}, {"type": "subtitle", "time": 12556.63, "timestamp": "03:29:16", "text": "ああ、私の神経がピリピリする。私は違います"}, {"type": "subtitle", "time": 12558.79, "timestamp": "03:29:18", "text": "贔屓するべきなんだけど、"}, {"type": "subtitle", "time": 12562.87, "timestamp": "03:29:22", "text": "空気中に電気が走っている。私たちはあなたを愛してます。"}, {"type": "subtitle", "time": 12567.59, "timestamp": "03:29:27", "text": "私を選んでください。 Monsterへようこそ。"}, {"type": "subtitle", "time": 12569.99, "timestamp": "03:29:29", "text": "ルールは簡単だ。各出場者"}, {"type": "subtitle", "time": 12572.55, "timestamp": "03:29:32", "text": "トークンを持っています。トークンを4つ獲得した人は"}, {"type": "subtitle", "time": 12575.469, "timestamp": "03:29:35", "text": "最初にあなたの1食分を獲得"}, {"type": "subtitle", "time": 12579.99, "timestamp": "03:29:39", "text": "本当に。セックスの話だよ。 2ラウンド"}, {"type": "subtitle", "time": 12582.229, "timestamp": "03:29:42", "text": "ジュースの場合。"}, {"type": "subtitle", "time": 12586.79, "timestamp": "03:29:46", "text": "よし、みんな。さあ、ゲーム開始だ。する"}, {"type": "subtitle", "time": 12590.469, "timestamp": "03:29:50", "text": "センサーを準備する必要があるのですが？"}, {"type": "subtitle", "time": 12592.389, "timestamp": "03:29:52", "text": "あなたが得意なことをしている間、私は"}, {"type": "subtitle", "time": 12595.349, "timestamp": "03:29:55", "text": "完全に削減する方法を見つけ出す。見る"}, {"type": "subtitle", "time": 12599.19, "timestamp": "03:29:59", "text": "後でバーで会おう。はぁ？"}]
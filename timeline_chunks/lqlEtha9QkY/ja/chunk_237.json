[{"type": "subtitle", "time": 14231.91, "timestamp": "03:57:11", "text": "何？ああ、撮らざるを得なかった。はい、私"}, {"type": "subtitle", "time": 14234.07, "timestamp": "03:57:14", "text": "外。私の"}, {"type": "subtitle", "time": 14237.91, "timestamp": "03:57:17", "text": "名前は現在、カタガワです。片川。私の"}, {"type": "subtitle", "time": 14239.59, "timestamp": "03:57:19", "text": "クソ野郎の兄は私の兄弟全員を奪った"}, {"type": "subtitle", "time": 14242.15, "timestamp": "03:57:22", "text": "タイネ・カリプソによって殺害された。私は唯一の"}, {"type": "subtitle", "time": 14243.75, "timestamp": "03:57:23", "text": "残り1つ。"}, {"type": "subtitle", "time": 14246.75, "timestamp": "03:57:26", "text": "待って、私が私の"}, {"type": "subtitle", "time": 14250.389, "timestamp": "03:57:30", "text": "兄だけど、彼は間違いなく私を求めている。"}, {"type": "subtitle", "time": 14252.07, "timestamp": "03:57:32", "text": "兄が"}, {"type": "subtitle", "time": 14253.79, "timestamp": "03:57:33", "text": "私は消えようとしていました"}, {"type": "subtitle", "time": 14256.15, "timestamp": "03:57:36", "text": "プロメテウスは死んだアトラス兵士で、"}, {"type": "subtitle", "time": 14258.389, "timestamp": "03:57:38", "text": "彼の装備を盗んだ。そして私は捕らえられた"}, {"type": "subtitle", "time": 14260.229, "timestamp": "03:57:40", "text": "CO。"}, {"type": "subtitle", "time": 14262.389, "timestamp": "03:57:42", "text": "しばらくの間、姿を消すことができた。ほとんど"}, {"type": "subtitle", "time": 14263.75, "timestamp": "03:57:43", "text": "この辺の人たちは私を殺すだろう"}, {"type": "subtitle", "time": 14266.87, "timestamp": "03:57:46", "text": "私の姓のために。ああ、大変だ。私の弟を見てください"}, {"type": "subtitle", "time": 14268.79, "timestamp": "03:57:48", "text": "あのクソ野郎の頭に銃弾を撃ち込んで"}, {"type": "subtitle", "time": 14271.83, "timestamp": "03:57:51", "text": "自分。そうします。そしてTumorheadは盗んだ"}, {"type": "subtitle", "time": 14273.99, "timestamp": "03:57:53", "text": "私の家宝です。私はそれを望んでいません"}, {"type": "subtitle", "time": 14275.429, "timestamp": "03:57:55", "text": "もう、それはすべてあなたの責任です、"}, {"type": "subtitle", "time": 14277.75, "timestamp": "03:57:57", "text": "ハンター。悪気はないけど、私は決して"}]
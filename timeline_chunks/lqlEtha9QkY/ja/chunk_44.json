[{"type": "subtitle", "time": 2640.71, "timestamp": "00:44:00", "text": "結局のところ。どれだけ"}, {"type": "subtitle", "time": 2644.23, "timestamp": "00:44:04", "text": "知ることができる"}, {"type": "subtitle", "time": 2647.51, "timestamp": "00:44:07", "text": "楽しませること、そして最善を尽くすこと。うん。うん。"}, {"type": "subtitle", "time": 2650.39, "timestamp": "00:44:10", "text": "あなたの持ち物は満足のいくものであるべきです"}, {"type": "subtitle", "time": 2652.71, "timestamp": "00:44:12", "text": "自分自身にとってそれが重要なのです"}, {"type": "subtitle", "time": 2654.55, "timestamp": "00:44:14", "text": "私の意見です。"}, {"type": "subtitle", "time": 2657.67, "timestamp": "00:44:17", "text": "私はもっ​​と上達する必要があると思っています。何"}, {"type": "subtitle", "time": 2661.67, "timestamp": "00:44:21", "text": "あなたについて？私も。私はそのやり方が好きではない"}, {"type": "subtitle", "time": 2665.43, "timestamp": "00:44:25", "text": "あなたは楽しんでいると思いますよ。大丈夫。"}, {"type": "subtitle", "time": 2667.03, "timestamp": "00:44:27", "text": "本当に？"}, {"type": "subtitle", "time": 2669.91, "timestamp": "00:44:29", "text": "うん。あなたは順調にやっていると思いますよ。私はしません"}, {"type": "subtitle", "time": 2672.79, "timestamp": "00:44:32", "text": "知る。問題は、私が"}, {"type": "subtitle", "time": 2676.069, "timestamp": "00:44:36", "text": "比較しすぎると、例えば"}, {"type": "subtitle", "time": 2678.87, "timestamp": "00:44:38", "text": "ビデオを作りたいなら、"}, {"type": "subtitle", "time": 2682.63, "timestamp": "00:44:42", "text": "適切なタイトルを付けてください。君は知っているだろう、どうやって"}, {"type": "subtitle", "time": 2685.43, "timestamp": "00:44:45", "text": "人々は動画を作る。"}, {"type": "subtitle", "time": 2688.71, "timestamp": "00:44:48", "text": "私は、私はあまり知らない、私はただ"}, {"type": "subtitle", "time": 2691.829, "timestamp": "00:44:51", "text": "私が教えてあげます。私が教えてあげます。わかった。"}, {"type": "subtitle", "time": 2693.99, "timestamp": "00:44:53", "text": "まず最初に、"}, {"type": "subtitle", "time": 2696.23, "timestamp": "00:44:56", "text": "良いサムネイルですね。わかった。魅力的"}, {"type": "subtitle", "time": 2699.109, "timestamp": "00:44:59", "text": "サムネイル。"}]
[{"type": "subtitle", "time": 7086.55, "timestamp": "01:58:06", "text": "それ？私は、私が持っているものがどこにあるか、という感じです。"}, {"type": "subtitle", "time": 7087.23, "timestamp": "01:58:07", "text": "探しています"}, {"type": "subtitle", "time": 7089.87, "timestamp": "01:58:09", "text": "[音楽]"}, {"type": "subtitle", "time": 7093.51, "timestamp": "01:58:13", "text": "のために？よし、見てみよう。ああ、思い出。それで、"}, {"type": "subtitle", "time": 7095.83, "timestamp": "01:58:15", "text": "これこそ私が探していたものです。この場所"}, {"type": "subtitle", "time": 7097.83, "timestamp": "01:58:17", "text": "そちら側。"}, {"type": "subtitle", "time": 7102.629, "timestamp": "01:58:22", "text": "大きな緑がかった青色のネオンサインがある"}, {"type": "subtitle", "time": 7105.43, "timestamp": "01:58:25", "text": "ギターか何かがある"}, {"type": "subtitle", "time": 7108.629, "timestamp": "01:58:28", "text": "あそこにポスターがあります。わかった。ネオンサインと"}, {"type": "subtitle", "time": 7109.95, "timestamp": "01:58:29", "text": "1"}, {"type": "subtitle", "time": 7113.47, "timestamp": "01:58:33", "text": "ポスター。ネオンサインとポスター。"}, {"type": "subtitle", "time": 7133.43, "timestamp": "01:58:53", "text": "ネオンサインのある場所ならそうあるべきだった。これは"}, {"type": "subtitle", "time": 7134.189, "timestamp": "01:58:54", "text": "ない"}, {"type": "subtitle", "time": 7138.669, "timestamp": "01:58:58", "text": "それ。検索。だから場所を見つける必要がある"}]
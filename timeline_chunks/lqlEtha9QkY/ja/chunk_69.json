[{"type": "subtitle", "time": 4141.91, "timestamp": "01:09:01", "text": "あなたはそれを食べないと言っていましたよね？"}, {"type": "subtitle", "time": 4144.99, "timestamp": "01:09:04", "text": "そこでは決して食事をしない。私はします"}, {"type": "subtitle", "time": 4149.669, "timestamp": "01:09:09", "text": "食べる。何？私は何でも食べる。"}, {"type": "subtitle", "time": 4154.309, "timestamp": "01:09:14", "text": "どうでも。前面を食べるとは言わないで"}, {"type": "subtitle", "time": 4156.47, "timestamp": "01:09:16", "text": "他の人の、"}, {"type": "subtitle", "time": 4159.99, "timestamp": "01:09:19", "text": "特にインドでは。おお。あ、待って。私"}, {"type": "subtitle", "time": 4162.309, "timestamp": "01:09:22", "text": "食べないでください。"}, {"type": "subtitle", "time": 4164.269, "timestamp": "01:09:24", "text": "おお、"}, {"type": "subtitle", "time": 4167.59, "timestamp": "01:09:27", "text": "待って。おお。あ、待って。"}, {"type": "subtitle", "time": 4169.709, "timestamp": "01:09:29", "text": "理由が分かった気がする。おお、"}, {"type": "subtitle", "time": 4182.47, "timestamp": "01:09:42", "text": "ああ、それね。"}, {"type": "subtitle", "time": 4184.11, "timestamp": "01:09:44", "text": "私"}, {"type": "subtitle", "time": 4192.39, "timestamp": "01:09:52", "text": "心。それが"}, {"type": "subtitle", "time": 4196.709, "timestamp": "01:09:56", "text": "もの。うん、"}, {"type": "subtitle", "time": 4199.189, "timestamp": "01:09:59", "text": "私は牛肉を食べないし、好きでもない。"}]
[{"type": "subtitle", "time": 17580.788, "timestamp": "04:53:00", "text": "今。よし、これでいい。そしてゲームに切り替える"}, {"type": "subtitle", "time": 17585.11, "timestamp": "04:53:05", "text": "そして私たちは戻ることができる。こんにちは、行きましょう。ああ、私は"}, {"type": "subtitle", "time": 17586.75, "timestamp": "04:53:06", "text": "えーっと忘れた"}, {"type": "subtitle", "time": 17590.628, "timestamp": "04:53:10", "text": "あれ。ちょっと待って、忘れてた。私は"}, {"type": "subtitle", "time": 17593.11, "timestamp": "04:53:13", "text": "ラッシュクラッシュをプレイ中。心配しないで、私は"}, {"type": "subtitle", "time": 17596.628, "timestamp": "04:53:16", "text": "私は自分の義務を果たす必要がありました"}, {"type": "subtitle", "time": 17599.75, "timestamp": "04:53:19", "text": "えーと、プレイヤー。私は少しクラッシュ・オブ・クランをプレイしていました"}, {"type": "subtitle", "time": 17603.03, "timestamp": "04:53:23", "text": "でも、そうせざるを得なかったから。 1つ"}, {"type": "subtitle", "time": 17606.43, "timestamp": "04:53:26", "text": "秒えっと、どこにいるの？"}, {"type": "subtitle", "time": 17609.83, "timestamp": "04:53:29", "text": "日の出を無効にする。よし、私たちは"}, {"type": "subtitle", "time": 17612.51, "timestamp": "04:53:32", "text": "戻る。よし、私たちは"}, {"type": "subtitle", "time": 17616.15, "timestamp": "04:53:36", "text": "戻る。こんにちは、戻ってきました。それで、私が持っているチャットは"}, {"type": "subtitle", "time": 17620.15, "timestamp": "04:53:40", "text": "見逃した。えっと、待っていました。だから私は"}, {"type": "subtitle", "time": 17624.788, "timestamp": "04:53:44", "text": "ウガバサンからのチャットですよね？それで、それで"}, {"type": "subtitle", "time": 17625.628, "timestamp": "04:53:45", "text": "待って。"}, {"type": "subtitle", "time": 17628.23, "timestamp": "04:53:48", "text": "うーん、モクシー好きだな。彼女のやり方"}, {"type": "subtitle", "time": 17630.35, "timestamp": "04:53:50", "text": "彼女は私が好きなタイプの女性の一人です"}, {"type": "subtitle", "time": 17633.948, "timestamp": "04:53:53", "text": "のように。しかし彼女は、"}, {"type": "subtitle", "time": 17636.628, "timestamp": "04:53:56", "text": "ピンク。興味がありました。そして彼女は"}, {"type": "subtitle", "time": 17639.51, "timestamp": "04:53:59", "text": "私が呼ばれるのが好きな菅氏はそう言った。 A"}]
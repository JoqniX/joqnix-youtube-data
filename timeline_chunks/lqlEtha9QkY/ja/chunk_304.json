[{"type": "subtitle", "time": 18243.15, "timestamp": "05:04:03", "text": "286。それはお金だ。"}, {"type": "subtitle", "time": 18246.51, "timestamp": "05:04:06", "text": "待って。だから私は投げるべきだ"}, {"type": "subtitle", "time": 18260.07, "timestamp": "05:04:20", "text": "キャプテンを倒したことは称賛に値する。"}, {"type": "subtitle", "time": 18262.55, "timestamp": "05:04:22", "text": "ロボットハンター。あのハンバーガーを奪う野郎"}, {"type": "subtitle", "time": 18264.868, "timestamp": "05:04:24", "text": "本当に厄介な存在だった。しかし"}, {"type": "subtitle", "time": 18267.83, "timestamp": "05:04:27", "text": "彼はもう死んでしまった。本当に素晴らしい。"}, {"type": "subtitle", "time": 18269.91, "timestamp": "05:04:29", "text": "最初はコーヒー、今度はハンバーガー。の"}, {"type": "subtitle", "time": 18272.708, "timestamp": "05:04:32", "text": "文明の礎石。ピース"}, {"type": "subtitle", "time": 18274.07, "timestamp": "05:04:34", "text": "この作品、私たちは本当にこれを"}, {"type": "subtitle", "time": 18275.91, "timestamp": "05:04:35", "text": "街が再び一つになった。ありがとうございます"}]
[{"type": "subtitle", "time": 5760.47, "timestamp": "01:36:00", "text": "彼らはそれを現実にした。彼らは本当に本当に"}, {"type": "subtitle", "time": 5762.47, "timestamp": "01:36:02", "text": "特定のものを読んでいるときの楽しい思い出"}, {"type": "subtitle", "time": 5765.27, "timestamp": "01:36:05", "text": "一つは、ユーリがすごく可愛いように見えるということ。うん、"}, {"type": "subtitle", "time": 5767.39, "timestamp": "01:36:07", "text": "ユーリはとても"}, {"type": "subtitle", "time": 5774.189, "timestamp": "01:36:14", "text": "ユーリ"}, {"type": "subtitle", "time": 5776.55, "timestamp": "01:36:16", "text": "あまりにも。私にあなたの"}, {"type": "subtitle", "time": 5778.35, "timestamp": "01:36:18", "text": "お気に入りの喜びまたは"}, {"type": "subtitle", "time": 5783.79, "timestamp": "01:36:23", "text": "おい、大変だよ。どちらも好きです"}, {"type": "subtitle", "time": 5787.59, "timestamp": "01:36:27", "text": "けれど。でも私はユーリ!!! on ICE を観始めたんです"}, {"type": "subtitle", "time": 5792.149, "timestamp": "01:36:32", "text": "初め。それからYOIにハマった。だから私は"}, {"type": "subtitle", "time": 5795.83, "timestamp": "01:36:35", "text": "見るのではなく、マンガをたくさん読む。"}, {"type": "subtitle", "time": 5799.99, "timestamp": "01:36:39", "text": "百合漫画。ヴァンパーズはその一つだ。私が"}, {"type": "subtitle", "time": 5803.149, "timestamp": "01:36:43", "text": "ヴァンパイアは楽しかった、とても"}, {"type": "subtitle", "time": 5807.189, "timestamp": "01:36:47", "text": "かわいい。だから私がヴァンパイアを読み始めたとき、"}, {"type": "subtitle", "time": 5810.31, "timestamp": "01:36:50", "text": "作家はちょうどそれを書き始めたところだった"}, {"type": "subtitle", "time": 5814.99, "timestamp": "01:36:54", "text": "マンガ。だから私は2つしか読んでいません"}, {"type": "subtitle", "time": 5817.59, "timestamp": "01:36:57", "text": "章。ええ、たった2章だけです。それ"}, {"type": "subtitle", "time": 5819.91, "timestamp": "01:36:59", "text": "彼女が作家だった頃"}]
[{"type": "subtitle", "time": 13202.15, "timestamp": "03:40:02", "text": "何てことだ。彼は今、ゴルフクラブでそれをやったのか？"}, {"type": "subtitle", "time": 13204.429, "timestamp": "03:40:04", "text": "いいえ、それは"}, {"type": "subtitle", "time": 13207.269, "timestamp": "03:40:07", "text": "あれ。私としては、ゴルフに行けばいいんです。あなたは"}, {"type": "subtitle", "time": 13209.349, "timestamp": "03:40:09", "text": "本当に本気でやってるんだね？これらすべて"}, {"type": "subtitle", "time": 13211.309, "timestamp": "03:40:11", "text": "出場者はただ"}, {"type": "subtitle", "time": 13215.67, "timestamp": "03:40:15", "text": "死にかけている。大好きです。彼は明らかに"}, {"type": "subtitle", "time": 13217.67, "timestamp": "03:40:17", "text": "何かを補う。そして私は知っている"}, {"type": "subtitle", "time": 13231.349, "timestamp": "03:40:31", "text": "わかった。えっと、隠れるルートに行ってください。証明"}, {"type": "subtitle", "time": 13232.75, "timestamp": "03:40:32", "text": "妻。"}, {"type": "subtitle", "time": 13235.75, "timestamp": "03:40:35", "text": "わかった。そうします、そしてすぐに"}, {"type": "subtitle", "time": 13239.75, "timestamp": "03:40:39", "text": "またここに戻ってきてください。痛み。えっと、私は"}]
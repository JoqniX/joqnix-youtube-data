[{"type": "subtitle", "time": 14461.03, "timestamp": "04:01:01", "text": "自分。そして、これらはもう一つの金庫です"}, {"type": "subtitle", "time": 14463.51, "timestamp": "04:01:03", "text": "ハンターとしてプレイできます"}, {"type": "subtitle", "time": 14475.67, "timestamp": "04:01:15", "text": "破壊行為。破壊行為。それは"}, {"type": "subtitle", "time": 14479.189, "timestamp": "04:01:19", "text": "エフェクト用のクラス。私の現金を手に入れて"}, {"type": "subtitle", "time": 14488.429, "timestamp": "04:01:28", "text": "ああ、大変だ。それは大きな"}, {"type": "subtitle", "time": 14491.83, "timestamp": "04:01:31", "text": "男の子。あのね？新しいものを使ってみよう"}, {"type": "subtitle", "time": 14492.83, "timestamp": "04:01:32", "text": "銃。"}, {"type": "subtitle", "time": 14495.51, "timestamp": "04:01:35", "text": "実際にショットガンを使いたい。良い"}, {"type": "subtitle", "time": 14499.349, "timestamp": "04:01:39", "text": "それを交換して、スナイパーを使うことにしよう。"}, {"type": "subtitle", "time": 14502.389, "timestamp": "04:01:42", "text": "これは本当に低いですね"}, {"type": "subtitle", "time": 14503.61, "timestamp": "04:01:43", "text": "そうです、私はただ"}, {"type": "subtitle", "time": 14509.229, "timestamp": "04:01:49", "text": "[音楽]"}]
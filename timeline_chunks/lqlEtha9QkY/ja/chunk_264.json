[{"type": "subtitle", "time": 15872.229, "timestamp": "04:24:32", "text": "私はそのエリアを片付けた。おお。"}, {"type": "subtitle", "time": 15874.63, "timestamp": "04:24:34", "text": "販売する自動販売機のミッションを見つける必要がある"}, {"type": "subtitle", "time": 15879.62, "timestamp": "04:24:39", "text": "だって私のバックパックは"}, {"type": "subtitle", "time": 15881.469, "timestamp": "04:24:41", "text": "[音楽]"}, {"type": "subtitle", "time": 15884.11, "timestamp": "04:24:44", "text": "満杯。"}, {"type": "subtitle", "time": 15888.469, "timestamp": "04:24:48", "text": "バイバイ。そうそう。それで、昨日私は"}, {"type": "subtitle", "time": 15891.07, "timestamp": "04:24:51", "text": "Twitchで配信中。"}, {"type": "subtitle", "time": 15893.389, "timestamp": "04:24:53", "text": "では、"}, {"type": "subtitle", "time": 15897.389, "timestamp": "04:24:57", "text": "私がこれらを殺して話す"}]
[{"type": "subtitle", "time": 6684.95, "timestamp": "01:51:24", "text": "行く。サイモン・チャン、テープを渡してくれ。感謝"}, {"type": "subtitle", "time": 6697.629, "timestamp": "01:51:37", "text": "1つ。"}, {"type": "subtitle", "time": 6700.629, "timestamp": "01:51:40", "text": "えーと、私がもっと学ぼうとしていることの一つは"}, {"type": "subtitle", "time": 6704.07, "timestamp": "01:51:44", "text": "もし私が、毛羽立ちのない方に向かっているとしたら"}, {"type": "subtitle", "time": 6707.629, "timestamp": "01:51:47", "text": "それを正しく使う。フラッフって何？"}]
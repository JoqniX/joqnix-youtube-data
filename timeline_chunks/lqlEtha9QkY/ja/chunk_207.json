[{"type": "subtitle", "time": 12420.15, "timestamp": "03:27:00", "text": "買収提案？正直に言うと、"}, {"type": "subtitle", "time": 12422.79, "timestamp": "03:27:02", "text": "かなり積極的なオファーをいくつか受けました"}, {"type": "subtitle", "time": 12424.55, "timestamp": "03:27:04", "text": "特定の伝統的な武器ブランドから、"}, {"type": "subtitle", "time": 12427.429, "timestamp": "03:27:07", "text": "私は売っていません。 Atlasはスタンドアロンです"}, {"type": "subtitle", "time": 12430.469, "timestamp": "03:27:10", "text": "ブランド。それはこのまま続くでしょう"}, {"type": "subtitle", "time": 12432.95, "timestamp": "03:27:12", "text": "私が生きている限り。"}, {"type": "subtitle", "time": 12434.63, "timestamp": "03:27:14", "text": "なぜそう言うのか？それはカットしてもいいですよ。"}, {"type": "subtitle", "time": 12437.83, "timestamp": "03:27:17", "text": "右。右。それは生きている。ああ、ジェリー、なぜ"}, {"type": "subtitle", "time": 12441.03, "timestamp": "03:27:21", "text": "あなたはいつもこれらの予定を立てているのですか？"}, {"type": "subtitle", "time": 12466.71, "timestamp": "03:27:46", "text": "彼はどこにいますか？"}, {"type": "subtitle", "time": 12475.51, "timestamp": "03:27:55", "text": "私がオンにしたミッションをオンにしないでください"}]
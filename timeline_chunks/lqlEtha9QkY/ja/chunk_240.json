[{"type": "subtitle", "time": 14403.51, "timestamp": "04:00:03", "text": "くそ。お前なんかどうでもいい。"}, {"type": "subtitle", "time": 14405.83, "timestamp": "04:00:05", "text": "彼は私を見つめている。すべての行動"}, {"type": "subtitle", "time": 14410.95, "timestamp": "04:00:10", "text": "ええ、彼は私を見ています。"}, {"type": "subtitle", "time": 14413.349, "timestamp": "04:00:13", "text": "彼は私が何をしているか全て知っている"}, {"type": "subtitle", "time": 14419.67, "timestamp": "04:00:19", "text": "場所。さて、問題は、どうすれば手に入れられるかということです。"}, {"type": "subtitle", "time": 14432.429, "timestamp": "04:00:32", "text": "けれど。どうすればいいですか"}, {"type": "subtitle", "time": 14435.189, "timestamp": "04:00:35", "text": "けれど？どこに行くべきか、ああ、行かなければならない"}, {"type": "subtitle", "time": 14439.11, "timestamp": "04:00:39", "text": "あそこだ。わかった。どうすればそこへ行けますか？"}, {"type": "subtitle", "time": 14458.51, "timestamp": "04:00:58", "text": "これ。ああ、私たちだよ。これは"}]
[{"type": "subtitle", "time": 10621.11, "timestamp": "02:57:01", "text": "今回は派手な仕掛けは一切なし。よし、それでは"}, {"type": "subtitle", "time": 10623.91, "timestamp": "02:57:03", "text": "最後の番号に電話してください。ああ、君は"}, {"type": "subtitle", "time": 10627.349, "timestamp": "02:57:07", "text": "これを正してください。緑色。"}, {"type": "subtitle", "time": 10632.95, "timestamp": "02:57:12", "text": "私は彼をナガドール・マキシマルと名付けよう。いいえ"}, {"type": "subtitle", "time": 10635.51, "timestamp": "02:57:15", "text": "最大。今回も負けないぞ。"}, {"type": "subtitle", "time": 10637.83, "timestamp": "02:57:17", "text": "システムをチェックしています。"}, {"type": "subtitle", "time": 10640.15, "timestamp": "02:57:20", "text": "[音楽]"}, {"type": "subtitle", "time": 10642.63, "timestamp": "02:57:22", "text": "今回はハッキングが完璧に成功した。"}, {"type": "subtitle", "time": 10651.51, "timestamp": "02:57:31", "text": "まさに間に合った。それが近さです"}, {"type": "subtitle", "time": 10654.55, "timestamp": "02:57:34", "text": "アラーム。マラワンがまた私を追ってきている。"}, {"type": "subtitle", "time": 10656.23, "timestamp": "02:57:36", "text": "武器を送る間、奴らを食い止めてくれ"}, {"type": "subtitle", "time": 10658.429, "timestamp": "02:57:38", "text": "ローラへの計画。"}, {"type": "subtitle", "time": 10660.87, "timestamp": "02:57:40", "text": "ローラ、ダイジェストを送ります"}, {"type": "subtitle", "time": 10663.51, "timestamp": "02:57:43", "text": "設計図が今、手に入った。彼らが来る。良い"}, {"type": "subtitle", "time": 10666.55, "timestamp": "02:57:46", "text": "あなたからの連絡をお待ちしています。データが送られてくるのを確認しました。"}, {"type": "subtitle", "time": 10667.87, "timestamp": "02:57:47", "text": "戦わなければならない"}]
[{"type": "subtitle", "time": 10382.07, "timestamp": "02:53:02", "text": "[音楽]"}, {"type": "subtitle", "time": 10383.59, "timestamp": "02:53:03", "text": "私はこの車を手に入れて盗むつもりだ"}, {"type": "subtitle", "time": 10389.429, "timestamp": "02:53:09", "text": "アップグレードが必要です"}, {"type": "subtitle", "time": 10397.269, "timestamp": "02:53:17", "text": "車両。ああ、これで駐車できると表示され、"}, {"type": "subtitle", "time": 10402.15, "timestamp": "02:53:22", "text": "分かるよ。なるほど。"}, {"type": "subtitle", "time": 10405.83, "timestamp": "02:53:25", "text": "盗みは良くないことだが、それでも"}, {"type": "subtitle", "time": 10407.99, "timestamp": "02:53:27", "text": "アップグレードすればするほど、"}, {"type": "subtitle", "time": 10410.99, "timestamp": "02:53:30", "text": "そうですよね？車両"}, {"type": "subtitle", "time": 10413.99, "timestamp": "02:53:33", "text": "賢明ですよね？そうやって私は"}, {"type": "subtitle", "time": 10417.11, "timestamp": "02:53:37", "text": "ホログラフィックサイクルは、"}, {"type": "subtitle", "time": 10418.19, "timestamp": "02:53:38", "text": "燃えている"}, {"type": "subtitle", "time": 10426.429, "timestamp": "02:53:46", "text": "もの。そう、これ"}, {"type": "subtitle", "time": 10429.349, "timestamp": "02:53:49", "text": "そうだよね、とかそんな感じ。やり方がわからない"}, {"type": "subtitle", "time": 10431.59, "timestamp": "02:53:51", "text": "壊してしまえ。"}, {"type": "subtitle", "time": 10434.71, "timestamp": "02:53:54", "text": "えっと、もし私が"}, {"type": "subtitle", "time": 10437.269, "timestamp": "02:53:57", "text": "2つ以上の惑星をアンロックして"}, {"type": "subtitle", "time": 10439.99, "timestamp": "02:53:59", "text": "ゲームが進むにつれて、私はうまくやれなくなります。私"}]
[{"type": "subtitle", "time": 781.59, "timestamp": "00:13:01", "text": "これについて考えすぎているが、"}, {"type": "subtitle", "time": 783.23, "timestamp": "00:13:03", "text": "私はまだ"}, {"type": "subtitle", "time": 786.31, "timestamp": "00:13:06", "text": "もし自分があなたの立場だったらどう思うだろうかと考えていました。もし"}, {"type": "subtitle", "time": 788.11, "timestamp": "00:13:08", "text": "私はそれを尋ねました"}, {"type": "subtitle", "time": 790.99, "timestamp": "00:13:10", "text": "誰かがそう言った。まるで私があなたの"}, {"type": "subtitle", "time": 793.99, "timestamp": "00:13:13", "text": "行列、私はユーチューバーを見ていました、"}, {"type": "subtitle", "time": 795.99, "timestamp": "00:13:15", "text": "VTuberと良好な関係を築いていた"}, {"type": "subtitle", "time": 799.03, "timestamp": "00:13:19", "text": "チャットのみ、音声通話はしない"}, {"type": "subtitle", "time": 802.15, "timestamp": "00:13:22", "text": "何でも。えっと、くっついた感じ"}, {"type": "subtitle", "time": 803.91, "timestamp": "00:13:23", "text": "彼らのコミュニティやその他で、"}, {"type": "subtitle", "time": 806.71, "timestamp": "00:13:26", "text": "彼らを応援していたなど。配信に来た。"}, {"type": "subtitle", "time": 810.91, "timestamp": "00:13:30", "text": "などなど。それら全ては良いものになった。"}, {"type": "subtitle", "time": 814.99, "timestamp": "00:13:34", "text": "忠誠心とか、その他諸々。"}, {"type": "subtitle", "time": 817.91, "timestamp": "00:13:37", "text": "そしてあなたはすでにあなたが"}, {"type": "subtitle", "time": 821.43, "timestamp": "00:13:41", "text": "将来有望な子供たちとか、そういうものなど。でも"}, {"type": "subtitle", "time": 823.11, "timestamp": "00:13:43", "text": "また、あなたはそうしないように最善を尽くしています"}, {"type": "subtitle", "time": 824.949, "timestamp": "00:13:44", "text": "自己宣伝しすぎるのは"}, {"type": "subtitle", "time": 827.509, "timestamp": "00:13:47", "text": "あらゆることにおける子供の役割と尊重"}, {"type": "subtitle", "time": 830.15, "timestamp": "00:13:50", "text": "配信者の境界線とか、そういうこと全部。"}, {"type": "subtitle", "time": 833.629, "timestamp": "00:13:53", "text": "そしてある日、あなたはただこう言う"}, {"type": "subtitle", "time": 836.629, "timestamp": "00:13:56", "text": "そう言うと、同じセリフだね"}, {"type": "subtitle", "time": 839.59, "timestamp": "00:13:59", "text": "いいえ、あなたはそれを指摘しますか"}]
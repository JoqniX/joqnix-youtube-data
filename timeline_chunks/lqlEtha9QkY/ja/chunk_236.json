[{"type": "subtitle", "time": 14170.469, "timestamp": "03:56:10", "text": "そして彼女はものすごく忙しそうにしている。良い"}, {"type": "subtitle", "time": 14172.95, "timestamp": "03:56:12", "text": "兵器。わかった。"}, {"type": "subtitle", "time": 14180.229, "timestamp": "03:56:20", "text": "赤ちゃん。ああ、ベイビー。わかった。"}, {"type": "subtitle", "time": 14190.63, "timestamp": "03:56:30", "text": "いや。待って、これを消させてくれ。"}, {"type": "subtitle", "time": 14201.83, "timestamp": "03:56:41", "text": "私は本当に散らかすのが得意なんです。"}, {"type": "subtitle", "time": 14205.51, "timestamp": "03:56:45", "text": "さあ、中に入って君を見せてくれ。"}, {"type": "subtitle", "time": 14207.99, "timestamp": "03:56:47", "text": "ありがとう。腫瘍の頭が"}, {"type": "subtitle", "time": 14211.429, "timestamp": "03:56:51", "text": "狂人は死んだ、ここから出してくれ。"}]
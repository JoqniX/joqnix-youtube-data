[{"type": "subtitle", "time": 7354.95, "timestamp": "02:02:34", "text": "内部。はい。中に入ってください。はい、行きました"}, {"type": "subtitle", "time": 7357.31, "timestamp": "02:02:37", "text": "内部。よし、これらだ。行く"}, {"type": "subtitle", "time": 7359.229, "timestamp": "02:02:39", "text": "内部。行く。"}, {"type": "subtitle", "time": 7363.31, "timestamp": "02:02:43", "text": "行く。全部手に入れたらどうなるの？"}, {"type": "subtitle", "time": 7366.55, "timestamp": "02:02:46", "text": "内部？中はすべてなくなってしまった。わかった。"}, {"type": "subtitle", "time": 7368.2, "timestamp": "02:02:48", "text": "何が起こるのですか"}]
[{"type": "subtitle", "time": 1620.63, "timestamp": "00:27:00", "text": "好奇心は、終わりのように感じられます"}, {"type": "subtitle", "time": 1624.07, "timestamp": "00:27:04", "text": "トップと誰もがそうではない"}, {"type": "subtitle", "time": 1626.71, "timestamp": "00:27:06", "text": "考えすぎだ。ええ、だって今ではほとんどの"}, {"type": "subtitle", "time": 1629.07, "timestamp": "00:27:09", "text": "人々はそれをするために"}, {"type": "subtitle", "time": 1631.35, "timestamp": "00:27:11", "text": "楽しいでしょ？"}, {"type": "subtitle", "time": 1634.149, "timestamp": "00:27:14", "text": "例えば、前回のコラボのように、"}, {"type": "subtitle", "time": 1636.47, "timestamp": "00:27:16", "text": "Repoコラボレーション、"}, {"type": "subtitle", "time": 1639.43, "timestamp": "00:27:19", "text": "他の3人のユーチューバーが言ったと思う"}, {"type": "subtitle", "time": 1641.31, "timestamp": "00:27:21", "text": "彼らはそれをするために"}, {"type": "subtitle", "time": 1643.07, "timestamp": "00:27:23", "text": "楽しい。"}, {"type": "subtitle", "time": 1646.63, "timestamp": "00:27:26", "text": "というわけで、私の自己紹介は最悪だった。私は私はしなかった"}, {"type": "subtitle", "time": 1650.39, "timestamp": "00:27:30", "text": "自己紹介も改善する必要があるね。"}, {"type": "subtitle", "time": 1652.47, "timestamp": "00:27:32", "text": "まるで多くのものがかかっているかのようだ"}, {"type": "subtitle", "time": 1654.47, "timestamp": "00:27:34", "text": "えーっと、どうやって"}, {"type": "subtitle", "time": 1656.269, "timestamp": "00:27:36", "text": "プレゼンテーションをお願いします"}, {"type": "subtitle", "time": 1659.59, "timestamp": "00:27:39", "text": "ランダムな人の前で自分自身や物"}, {"type": "subtitle", "time": 1663.669, "timestamp": "00:27:43", "text": "クリエイターやランダムな人々"}, {"type": "subtitle", "time": 1665.909, "timestamp": "00:27:45", "text": "公共空間。ええ、公共の場"}, {"type": "subtitle", "time": 1667.23, "timestamp": "00:27:47", "text": "そして"}, {"type": "subtitle", "time": 1670.19, "timestamp": "00:27:50", "text": "インターネットでは、"}, {"type": "subtitle", "time": 1674.389, "timestamp": "00:27:54", "text": "もの。それで、ゼノンの"}, {"type": "subtitle", "time": 1677.35, "timestamp": "00:27:57", "text": "えっと、話。彼女の伝承について調べる必要がある"}]
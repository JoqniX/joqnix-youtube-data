[{"type": "subtitle", "time": 14643.429, "timestamp": "04:04:03", "text": "はぁ？彼はどこへ行ったんだろう。私はそれが欲しい"}, {"type": "subtitle", "time": 14649.63, "timestamp": "04:04:09", "text": "ああ、ジョシュを探さなきゃ"}, {"type": "subtitle", "time": 14661.15, "timestamp": "04:04:21", "text": "待って、彼は"}, {"type": "subtitle", "time": 14675.269, "timestamp": "04:04:35", "text": "見る。彼がそうであることを願っています。ああ、彼は"}, {"type": "subtitle", "time": 14678.15, "timestamp": "04:04:38", "text": "別の場所。わかった。ええと、私たちは"}, {"type": "subtitle", "time": 14679.91, "timestamp": "04:04:39", "text": "そのためにそこにいる。すべてを完了する必要があります"}, {"type": "subtitle", "time": 14683.63, "timestamp": "04:04:43", "text": "これ。私たちは再びそこへ戻る。いいえ"}, {"type": "subtitle", "time": 14687.11, "timestamp": "04:04:47", "text": "さらなる重荷。死んだような気分だ"}, {"type": "subtitle", "time": 14689.55, "timestamp": "04:04:49", "text": "半分まで進んだ後の重量"}]
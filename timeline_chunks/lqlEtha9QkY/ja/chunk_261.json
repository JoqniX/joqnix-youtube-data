[{"type": "subtitle", "time": 15666.11, "timestamp": "04:21:06", "text": "[音楽]"}, {"type": "subtitle", "time": 15680.149, "timestamp": "04:21:20", "text": "そして私たちは立ち上がり、また戻ってくる。私の暗い側面"}, {"type": "subtitle", "time": 15682.87, "timestamp": "04:21:22", "text": "何日も、私はいつもお腹を空かせていた。私は懇願した、"}, {"type": "subtitle", "time": 15685.11, "timestamp": "04:21:25", "text": "借りたり盗んだりして、なんとか一口食べた。"}, {"type": "subtitle", "time": 15687.59, "timestamp": "04:21:27", "text": "ある夜は、あまりにもお腹が空いて目が覚めた。"}, {"type": "subtitle", "time": 15689.59, "timestamp": "04:21:29", "text": "私は食べていました"}, {"type": "subtitle", "time": 15692.389, "timestamp": "04:21:32", "text": "とにかく、私は汚れた子供たちを見かけました"}, {"type": "subtitle", "time": 15694.63, "timestamp": "04:21:34", "text": "ピクルスをめぐって争う。私は彼らに言った"}, {"type": "subtitle", "time": 15697.11, "timestamp": "04:21:37", "text": "話を聞かせてくれたら、一口くれた。そして"}, {"type": "subtitle", "time": 15699.189, "timestamp": "04:21:39", "text": "金庫を見つけたので、"}, {"type": "subtitle", "time": 15701.67, "timestamp": "04:21:41", "text": "テーブルの上にランチドレッシング。物語を語る"}, {"type": "subtitle", "time": 15703.91, "timestamp": "04:21:43", "text": "パンドラでの私の冒険。どうですか？"}]
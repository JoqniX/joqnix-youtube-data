[{"type": "subtitle", "time": 3780.23, "timestamp": "01:03:00", "text": "「え？どうしてそれが好きなの？」私 私"}, {"type": "subtitle", "time": 3784.15, "timestamp": "01:03:04", "text": "冷たい牛乳みたいだ。わかった。特に"}, {"type": "subtitle", "time": 3788.309, "timestamp": "01:03:08", "text": "暑い季節には、冷たい牛乳の方が良い。"}, {"type": "subtitle", "time": 3792.63, "timestamp": "01:03:12", "text": "うん。寒い季節には、"}, {"type": "subtitle", "time": 3794.829, "timestamp": "01:03:14", "text": "熱い飲み物"}, {"type": "subtitle", "time": 3797.63, "timestamp": "01:03:17", "text": "水と私"}, {"type": "subtitle", "time": 3802.15, "timestamp": "01:03:22", "text": "温かい牛乳も飲んでください。"}, {"type": "subtitle", "time": 3812.39, "timestamp": "01:03:32", "text": "自分自身。もし私が"}, {"type": "subtitle", "time": 3813.91, "timestamp": "01:03:33", "text": "チャンスがあれば、あなたにいくつかあげていたでしょう"}, {"type": "subtitle", "time": 3817.19, "timestamp": "01:03:37", "text": "私の冷たいコーヒー。"}, {"type": "subtitle", "time": 3819.91, "timestamp": "01:03:39", "text": "私は美味しいアイスコーヒーを作ることができます。わかった。私は作ります"}, {"type": "subtitle", "time": 3822.71, "timestamp": "01:03:42", "text": "美味しいアイスコーヒー。"}, {"type": "subtitle", "time": 3825.029, "timestamp": "01:03:45", "text": "あなたは私がどれほど優れているかに驚くでしょう"}, {"type": "subtitle", "time": 3828.309, "timestamp": "01:03:48", "text": "アイスコーヒーを作る。"}, {"type": "subtitle", "time": 3830.069, "timestamp": "01:03:50", "text": "うん。"}, {"type": "subtitle", "time": 3834.87, "timestamp": "01:03:54", "text": "あなたの好きな飲​​み物の種類は何ですか？"}, {"type": "subtitle", "time": 3838.95, "timestamp": "01:03:58", "text": "飲む。そして私はコーヒーが好きではないので、"}]
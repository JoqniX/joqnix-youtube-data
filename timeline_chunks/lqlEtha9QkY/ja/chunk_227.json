[{"type": "subtitle", "time": 13621.75, "timestamp": "03:47:01", "text": "待って。こんにちは。出してあげよう。それはゴミだ"}, {"type": "subtitle", "time": 13624.71, "timestamp": "03:47:04", "text": "山。交換するだけでいい"}, {"type": "subtitle", "time": 13627.51, "timestamp": "03:47:07", "text": "この船は私のディップに1つあります"}, {"type": "subtitle", "time": 13630.229, "timestamp": "03:47:10", "text": "法律の解釈がより緩やかになる。のように"}, {"type": "subtitle", "time": 13632.95, "timestamp": "03:47:12", "text": "不完全なコピー。彼らはいつも私の"}, {"type": "subtitle", "time": 13635.03, "timestamp": "03:47:15", "text": "賄賂を受け取る乗組員。私のクルーがお手伝いします"}, {"type": "subtitle", "time": 13637.11, "timestamp": "03:47:17", "text": "ここから出してくれ。彼らを探しに行きなさい。行く"}, {"type": "subtitle", "time": 13639.83, "timestamp": "03:47:19", "text": "それらを見つけなさい。はい、わかりました。"}, {"type": "subtitle", "time": 13645.99, "timestamp": "03:47:25", "text": "私は払わない。口の悪い奴に話しかけろ"}, {"type": "subtitle", "time": 13674.15, "timestamp": "03:47:54", "text": "わかった。ああ、これは、これが私が"}, {"type": "subtitle", "time": 13676.07, "timestamp": "03:47:56", "text": "君のリーダーは汚物まみれだ。私に言った"}, {"type": "subtitle", "time": 13678.429, "timestamp": "03:47:58", "text": "あなたを見つけるために。口汚いのは"}]
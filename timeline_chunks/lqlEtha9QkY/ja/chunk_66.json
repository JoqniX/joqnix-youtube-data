[{"type": "subtitle", "time": 3961.51, "timestamp": "01:06:01", "text": "いいえ、私はVTuberです。やり方は分かってる"}, {"type": "subtitle", "time": 3963.71, "timestamp": "01:06:03", "text": "VTuberは、"}, {"type": "subtitle", "time": 3968.23, "timestamp": "01:06:08", "text": "私たちはあなたの不満を無視します"}, {"type": "subtitle", "time": 3971.589, "timestamp": "01:06:11", "text": "配信中にお腹が痛くなる。はい、"}, {"type": "subtitle", "time": 3973.43, "timestamp": "01:06:13", "text": "真実。私が知らないとでも思っているの？"}, {"type": "subtitle", "time": 3983.309, "timestamp": "01:06:23", "text": "私が何を隠していると思いますか？"}, {"type": "subtitle", "time": 3985.99, "timestamp": "01:06:25", "text": "視聴者？はぁ？"}, {"type": "subtitle", "time": 3988.39, "timestamp": "01:06:28", "text": "空腹が鍵だ。お腹がすいた。空腹は"}, {"type": "subtitle", "time": 3990.589, "timestamp": "01:06:30", "text": "鍵。今、お腹が空いた。"}, {"type": "subtitle", "time": 3993.91, "timestamp": "01:06:33", "text": "本当は食べに行きたいんだけど、"}, {"type": "subtitle", "time": 3997.23, "timestamp": "01:06:37", "text": "寝る直前に食べるのは好きじゃない"}, {"type": "subtitle", "time": 4000.789, "timestamp": "01:06:40", "text": "そうすればもっと目が覚めるから"}, {"type": "subtitle", "time": 4002.39, "timestamp": "01:06:42", "text": "それは理にかなっている。"}, {"type": "subtitle", "time": 4004.069, "timestamp": "01:06:44", "text": "おお、"}, {"type": "subtitle", "time": 4007.75, "timestamp": "01:06:47", "text": "じゃあ、何時に起きるの？"}, {"type": "subtitle", "time": 4010.23, "timestamp": "01:06:50", "text": "9時"}]
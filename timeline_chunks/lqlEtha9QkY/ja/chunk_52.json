[{"type": "subtitle", "time": 3122.79, "timestamp": "00:52:02", "text": "それについてうるさくなる。ああ、そうだ"}, {"type": "subtitle", "time": 3125.589, "timestamp": "00:52:05", "text": "今はまるで平和な空間にいるみたいだ。私"}, {"type": "subtitle", "time": 3127.829, "timestamp": "00:52:07", "text": "自分のコンテンツを作りたい"}, {"type": "subtitle", "time": 3130.15, "timestamp": "00:52:10", "text": "一瞬。はい。はい。ある意味では"}, {"type": "subtitle", "time": 3135.43, "timestamp": "00:52:15", "text": "コラボはいいけど、またSMPPS"}, {"type": "subtitle", "time": 3139.349, "timestamp": "00:52:19", "text": "長期的な取り組みが必要です。真実。真実。"}, {"type": "subtitle", "time": 3143.109, "timestamp": "00:52:23", "text": "とても疲れるし、そう、"}, {"type": "subtitle", "time": 3146.589, "timestamp": "00:52:26", "text": "視聴者数も少し減ります"}, {"type": "subtitle", "time": 3150.309, "timestamp": "00:52:30", "text": "非常に正直に言うと。ええ、私は"}, {"type": "subtitle", "time": 3152.47, "timestamp": "00:52:32", "text": "視聴者数が減ったのは、私が"}, {"type": "subtitle", "time": 3155.27, "timestamp": "00:52:35", "text": "Twitchで配信中。つまり、これが私たちが"}, {"type": "subtitle", "time": 3158.27, "timestamp": "00:52:38", "text": "そのことを言ってください"}, {"type": "subtitle", "time": 3161.349, "timestamp": "00:52:41", "text": "SMP SMP。待って、それであなたはあなたの"}, {"type": "subtitle", "time": 3165.43, "timestamp": "00:52:45", "text": "視聴者アカウントとかそういうの？いいえ、ただ"}, {"type": "subtitle", "time": 3168.71, "timestamp": "00:52:48", "text": "目立つことだ。"}, {"type": "subtitle", "time": 3171.309, "timestamp": "00:52:51", "text": "ああ、チャットが沈黙しているなら、"}, {"type": "subtitle", "time": 3174.27, "timestamp": "00:52:54", "text": "うん。チャットがもっと"}, {"type": "subtitle", "time": 3177.27, "timestamp": "00:52:57", "text": "静けさ。わからない。私にとってはただ"}]
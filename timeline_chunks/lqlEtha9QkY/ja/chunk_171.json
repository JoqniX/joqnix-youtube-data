[{"type": "subtitle", "time": 10262.349, "timestamp": "02:51:02", "text": "それ。ノグは退場。それは彼のものです"}, {"type": "subtitle", "time": 10264.87, "timestamp": "02:51:04", "text": "名前。いいえ、それは間違いです。さあ行こう。車両は"}, {"type": "subtitle", "time": 10266.75, "timestamp": "02:51:06", "text": "装備"}, {"type": "subtitle", "time": 10270.07, "timestamp": "02:51:10", "text": "特別な科学バレルが送る"}, {"type": "subtitle", "time": 10273.71, "timestamp": "02:51:13", "text": "破壊を通して私への逃避"}, {"type": "subtitle", "time": 10276.23, "timestamp": "02:51:16", "text": "私が持っていないテクノロジー"}, {"type": "subtitle", "time": 10285.75, "timestamp": "02:51:25", "text": "それが一つ目です。これがテストノックの1回分です。 A"}, {"type": "subtitle", "time": 10288.35, "timestamp": "02:51:28", "text": "良いスタートだ。無線。"}, {"type": "subtitle", "time": 10296.95, "timestamp": "02:51:36", "text": "私は大丈夫です。元気ですか？私は、私は、ああ神様、私は"}, {"type": "subtitle", "time": 10298.95, "timestamp": "02:51:38", "text": "ああ神様、私はそのことについて話すのをやめたので"}, {"type": "subtitle", "time": 10301.83, "timestamp": "02:51:41", "text": "多くの。"}, {"type": "subtitle", "time": 10304.07, "timestamp": "02:51:44", "text": "私も元気です。私もやっています"}, {"type": "subtitle", "time": 10307.23, "timestamp": "02:51:47", "text": "良い。実際、とても良かった。そして私は"}, {"type": "subtitle", "time": 10310.75, "timestamp": "02:51:50", "text": "ああ、なんてことだ、私はひっくり返した"}, {"type": "subtitle", "time": 10313.469, "timestamp": "02:51:53", "text": "車両。"}, {"type": "subtitle", "time": 10318.51, "timestamp": "02:51:58", "text": "コーラ。そして最後。あなたが見えてます。"}]
[{"type": "subtitle", "time": 3660.39, "timestamp": "01:01:00", "text": "私はゲームをプレイできません。なんてこった。"}, {"type": "subtitle", "time": 3664.23, "timestamp": "01:01:04", "text": "私はゲーム中に歩くことができません。わかった。"}, {"type": "subtitle", "time": 3667.589, "timestamp": "01:01:07", "text": "なんてこった。できるだけ早く1つ購入する必要があります"}, {"type": "subtitle", "time": 3669.03, "timestamp": "01:01:09", "text": "可能。"}, {"type": "subtitle", "time": 3673.03, "timestamp": "01:01:13", "text": "ああ、今はPCを使っているんですね。そうそう。ええ、私は"}, {"type": "subtitle", "time": 3676.47, "timestamp": "01:01:16", "text": "ノートパソコンを持っていません。"}, {"type": "subtitle", "time": 3679.03, "timestamp": "01:01:19", "text": "新しいPCの使い心地はどうですか？ゲームはどうですか？"}, {"type": "subtitle", "time": 3680.95, "timestamp": "01:01:20", "text": "とかそういうの？"}, {"type": "subtitle", "time": 3681.87, "timestamp": "01:01:21", "text": "私"}, {"type": "subtitle", "time": 3685.75, "timestamp": "01:01:25", "text": "楽しんで、私は、"}, {"type": "subtitle", "time": 3695.589, "timestamp": "01:01:35", "text": "私はいつものようにインフィニティニキをプレイしています"}, {"type": "subtitle", "time": 3698.069, "timestamp": "01:01:38", "text": "私のPC。"}, {"type": "subtitle", "time": 3700.23, "timestamp": "01:01:40", "text": "それはすばらしい。"}, {"type": "subtitle", "time": 3702.71, "timestamp": "01:01:42", "text": "でも、ほとんどの場合、それが私がプレイする唯一のゲームです"}, {"type": "subtitle", "time": 3705.67, "timestamp": "01:01:45", "text": "配信外でプレイする。私がプレイするほとんどのゲームは"}, {"type": "subtitle", "time": 3709.43, "timestamp": "01:01:49", "text": "ストリームは、ほら、どうやって"}, {"type": "subtitle", "time": 3711.549, "timestamp": "01:01:51", "text": "説明"}, {"type": "subtitle", "time": 3715.069, "timestamp": "01:01:55", "text": "ゲーム？配信中はダークみたい"}]
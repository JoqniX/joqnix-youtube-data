[{"type": "subtitle", "time": 16985.55, "timestamp": "04:43:05", "text": "あなた。手に入れた"}, {"type": "subtitle", "time": 16989.15, "timestamp": "04:43:09", "text": "あなた。あなたを追加します"}, {"type": "subtitle", "time": 16992.11, "timestamp": "04:43:12", "text": "それから。それで、どうやってそれを確認するんですか？"}, {"type": "subtitle", "time": 16995.03, "timestamp": "04:43:15", "text": "また？ああ、ゲームを終了して行かなきゃ"}, {"type": "subtitle", "time": 16997.83, "timestamp": "04:43:17", "text": "このような特性に。ああ、それは"}, {"type": "subtitle", "time": 17000.35, "timestamp": "04:43:20", "text": "痛み。所有"}, {"type": "subtitle", "time": 17003.99, "timestamp": "04:43:23", "text": "上へ、待って、待って、待って、待って。"}, {"type": "subtitle", "time": 17012.43, "timestamp": "04:43:32", "text": "外。よし、これは"}, {"type": "subtitle", "time": 17020.67, "timestamp": "04:43:40", "text": "秒えっと"}, {"type": "subtitle", "time": 17024.51, "timestamp": "04:43:44", "text": "プライバシー。えっと、追加"}, {"type": "subtitle", "time": 17028.55, "timestamp": "04:43:48", "text": "友人。はい、友達リクエストを送りました。"}, {"type": "subtitle", "time": 17033.868, "timestamp": "04:43:53", "text": "良い。全て"}, {"type": "subtitle", "time": 17038.35, "timestamp": "04:43:58", "text": "右。ゲームをチェックしてみてください"}]
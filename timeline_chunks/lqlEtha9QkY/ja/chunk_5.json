[{"type": "subtitle", "time": 305.189, "timestamp": "00:05:05", "text": "月曜日から私は"}, {"type": "subtitle", "time": 309.71, "timestamp": "00:05:09", "text": "実際に勉強に時間を費やす"}, {"type": "chat", "time": 310.624, "timestamp": "00:05:10", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "oh god this is a lot of workk"}, {"type": "subtitle", "time": 313.11, "timestamp": "00:05:13", "text": "試験は1時間か2時間で十分です"}, {"type": "subtitle", "time": 327.71, "timestamp": "00:05:27", "text": "そう、60日間"}, {"type": "subtitle", "time": 330.95, "timestamp": "00:05:30", "text": "合格したけど、私は"}, {"type": "subtitle", "time": 332.59000000000003, "timestamp": "00:05:32", "text": "ちゃんとした"}, {"type": "subtitle", "time": 335.71, "timestamp": "00:05:35", "text": "サバソン。何かありましたか？"}, {"type": "subtitle", "time": 340.23, "timestamp": "00:05:40", "text": "誰でも私に支払ってインセンティブ"}, {"type": "subtitle", "time": 342.629, "timestamp": "00:05:42", "text": "私が何かをする？私は何もしていないと思います"}, {"type": "subtitle", "time": 345.07, "timestamp": "00:05:45", "text": "の"}, {"type": "subtitle", "time": 349.07, "timestamp": "00:05:49", "text": "無神経な人たち。それは私の一部"}, {"type": "subtitle", "time": 352.469, "timestamp": "00:05:52", "text": "悲しい気持ちになる。"}, {"type": "subtitle", "time": 355.469, "timestamp": "00:05:55", "text": "私は"}, {"type": "subtitle", "time": 358.87, "timestamp": "00:05:58", "text": "インセンティブはありましたか？私は試してみました"}]
[{"type": "subtitle", "time": 847.189, "timestamp": "00:14:07", "text": "なぜ？もし私が"}, {"type": "subtitle", "time": 850.629, "timestamp": "00:14:10", "text": "私が誰かにその質問をしたのですが、"}, {"type": "subtitle", "time": 859.509, "timestamp": "00:14:19", "text": "いいえ。なぜなら、複数あるからです"}, {"type": "subtitle", "time": 860.91, "timestamp": "00:14:20", "text": "側面から"}, {"type": "subtitle", "time": 864.75, "timestamp": "00:14:24", "text": "これ。これには複数の側面がある。まるで"}, {"type": "subtitle", "time": 868.23, "timestamp": "00:14:28", "text": "えっと、どうやって他の人とコラボレーションするんですか？"}, {"type": "subtitle", "time": 870.71, "timestamp": "00:14:30", "text": "どのような理由でコラボレーションしたいのですか？"}, {"type": "subtitle", "time": 873.99, "timestamp": "00:14:33", "text": "誰か？まず、"}, {"type": "subtitle", "time": 876.629, "timestamp": "00:14:36", "text": "白いチェックマークが必要です。たくさんのこと、"}, {"type": "subtitle", "time": 879.15, "timestamp": "00:14:39", "text": "右？あなたは、あなたは"}, {"type": "subtitle", "time": 881.75, "timestamp": "00:14:41", "text": "その人はあなたと話してくれるだろうか？できる"}, {"type": "subtitle", "time": 884.31, "timestamp": "00:14:44", "text": "同期しますか？エネルギーは供給されるのだろうか？"}, {"type": "subtitle", "time": 888.59, "timestamp": "00:14:48", "text": "良いエネルギーを感じますか？私たちはできますか"}, {"type": "subtitle", "time": 891.47, "timestamp": "00:14:51", "text": "えっと、あるでしょうか"}, {"type": "subtitle", "time": 894.55, "timestamp": "00:14:54", "text": "同期は行われますか？意思"}, {"type": "subtitle", "time": 897.71, "timestamp": "00:14:57", "text": "私たちは話したり、その他いろいろと"}]
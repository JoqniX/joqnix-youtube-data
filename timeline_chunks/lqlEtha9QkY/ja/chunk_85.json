[{"type": "subtitle", "time": 5115.99, "timestamp": "01:25:15", "text": "オフ。ああ、降りてよ。降りる。わかった。ああ、"}, {"type": "subtitle", "time": 5118.03, "timestamp": "01:25:18", "text": "神。ほとんど"}, {"type": "subtitle", "time": 5121.99, "timestamp": "01:25:21", "text": "亡くなった。セットを殺してはいけない。あ、待って。なぜ"}, {"type": "subtitle", "time": 5123.75, "timestamp": "01:25:23", "text": "その映画、私は？そうなると思った"}, {"type": "subtitle", "time": 5126.75, "timestamp": "01:25:26", "text": "音楽に関するものであること。"}, {"type": "subtitle", "time": 5129.43, "timestamp": "01:25:29", "text": "実際に私の最初のビデオを最後に見ましたか?"}, {"type": "subtitle", "time": 5131.79, "timestamp": "01:25:31", "text": "年。"}, {"type": "subtitle", "time": 5134.75, "timestamp": "01:25:34", "text": "ああ、それは"}, {"type": "subtitle", "time": 5138.149, "timestamp": "01:25:38", "text": "大学生ですよね？うん。する"}, {"type": "subtitle", "time": 5154.03, "timestamp": "01:25:54", "text": "与えられた？与えられたものですか"}, {"type": "subtitle", "time": 5157.07, "timestamp": "01:25:57", "text": "映画？ああ、私は泣きました"}]
[{"type": "subtitle", "time": 10321.75, "timestamp": "02:52:01", "text": "[音楽]"}, {"type": "subtitle", "time": 10323.75, "timestamp": "02:52:03", "text": "よし。全員捕まえたよ。全員です。"}, {"type": "subtitle", "time": 10325.83, "timestamp": "02:52:05", "text": "これから彼らのスーツをハッキングして追加します"}, {"type": "subtitle", "time": 10328.63, "timestamp": "02:52:08", "text": "私自身が設計した特別なアップグレード"}, {"type": "subtitle", "time": 10332.23, "timestamp": "02:52:12", "text": "私の戦闘用ナゴールを創造するために。待って、私は"}, {"type": "subtitle", "time": 10334.71, "timestamp": "02:52:14", "text": "この車が欲しい。実際、"}, {"type": "subtitle", "time": 10343.22, "timestamp": "02:52:23", "text": "はぁ？任務用車両は使用できません。"}, {"type": "subtitle", "time": 10345.71, "timestamp": "02:52:25", "text": "[音楽]"}, {"type": "subtitle", "time": 10348.51, "timestamp": "02:52:28", "text": "なぜ？なし"}, {"type": "subtitle", "time": 10350.68, "timestamp": "02:52:30", "text": "そこには。"}, {"type": "subtitle", "time": 10366.11, "timestamp": "02:52:46", "text": "自体。あ、待って。それはホログラムです。"}, {"type": "subtitle", "time": 10368.07, "timestamp": "02:52:48", "text": "待って。待って、待って、待って、待って、待って、"}, {"type": "subtitle", "time": 10370.55, "timestamp": "02:52:50", "text": "待って、待って。"}, {"type": "subtitle", "time": 10373.349, "timestamp": "02:52:53", "text": "ここに来て。ここに来て。ここに来て。欲しい"}]
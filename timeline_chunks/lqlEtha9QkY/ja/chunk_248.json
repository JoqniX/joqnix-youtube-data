[{"type": "subtitle", "time": 14891.189, "timestamp": "04:08:11", "text": "再びトップに返り咲かなければならない。"}, {"type": "subtitle", "time": 14898.229, "timestamp": "04:08:18", "text": "これはゲームの一部ではありません。戻って"}, {"type": "subtitle", "time": 14902.189, "timestamp": "04:08:22", "text": "そこで戦う。トリッシュ、"}, {"type": "subtitle", "time": 14904.95, "timestamp": "04:08:24", "text": "バカ。それを取ってきます。コヴは電気技師"}, {"type": "subtitle", "time": 14907.189, "timestamp": "04:08:27", "text": "軽量。私に言わせれば、彼は行かないだろう"}, {"type": "subtitle", "time": 14909.03, "timestamp": "04:08:29", "text": "電気シールドのない場所ならどこでも"}, {"type": "subtitle", "time": 14912.07, "timestamp": "04:08:32", "text": "彼の。"}, {"type": "subtitle", "time": 14914.75, "timestamp": "04:08:34", "text": "さて、次はどうする？えーと、乗り越える"}, {"type": "subtitle", "time": 14917.349, "timestamp": "04:08:37", "text": "そこには。だから、まっすぐ行かなければならないかもしれない"}, {"type": "subtitle", "time": 14920.15, "timestamp": "04:08:40", "text": "そして、こちらへお越しください。そして最後の部分"}, {"type": "subtitle", "time": 14922.99, "timestamp": "04:08:42", "text": "この2つについてはもう終わりだ。"}, {"type": "subtitle", "time": 14925.51, "timestamp": "04:08:45", "text": "わかった。それでは、一番近いものから始めましょう。"}]
[{"type": "subtitle", "time": 15181.229, "timestamp": "04:13:01", "text": "最後の場所へ行く。それは終わった"}, {"type": "subtitle", "time": 15184.229, "timestamp": "04:13:04", "text": "そこには。そして私たちはここにいます。それは"}, {"type": "subtitle", "time": 15196.71, "timestamp": "04:13:16", "text": "あれがダンボだ。パルクールをしよう"}, {"type": "subtitle", "time": 15197.55, "timestamp": "04:13:17", "text": "方法"}, {"type": "subtitle", "time": 15207.95, "timestamp": "04:13:27", "text": "パルクール。待って、本当にそんなことあり得るの？"}]
[{"type": "subtitle", "time": 11162.429, "timestamp": "03:06:02", "text": "大丈夫。おお、素敵なホイールですね"}, {"type": "subtitle", "time": 11164.59, "timestamp": "03:06:04", "text": "そこには。感謝"}, {"type": "subtitle", "time": 11167.269, "timestamp": "03:06:07", "text": "あなた。これを盗む。どうもありがとうございました"}, {"type": "subtitle", "time": 11172.75, "timestamp": "03:06:12", "text": "あなたも"}, {"type": "subtitle", "time": 11176.95, "timestamp": "03:06:16", "text": "死ぬ。持続する。私はします。これは良い"}, {"type": "subtitle", "time": 11178.87, "timestamp": "03:06:18", "text": "車輪。これはホログラフィックホイールです。"}, {"type": "subtitle", "time": 11186.11, "timestamp": "03:06:26", "text": "待って、その向こうに場所がある"}, {"type": "subtitle", "time": 11190.429, "timestamp": "03:06:30", "text": "ここ。私はそれを受け取り、"}, {"type": "subtitle", "time": 11193.91, "timestamp": "03:06:33", "text": "それ。どうもありがとうございます。新しい部品。"}, {"type": "subtitle", "time": 11201.71, "timestamp": "03:06:41", "text": "得る？これは何？私たちは何を得たのか？何もない"}, {"type": "subtitle", "time": 11205.269, "timestamp": "03:06:45", "text": "ここ。ここには何もない。ここには何もない。おお、"}, {"type": "subtitle", "time": 11210.87, "timestamp": "03:06:50", "text": "これです。オムニホイール。ああ、よかった。良い。"}, {"type": "subtitle", "time": 11211.79, "timestamp": "03:06:51", "text": "おお"}, {"type": "subtitle", "time": 11213.55, "timestamp": "03:06:53", "text": "神。全て"}]
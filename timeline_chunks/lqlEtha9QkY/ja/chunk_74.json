[{"type": "subtitle", "time": 4441.43, "timestamp": "01:14:01", "text": "あなたが言っているのはそういうことですか？はぁ？"}, {"type": "subtitle", "time": 4444.95, "timestamp": "01:14:04", "text": "えっと、ちょっと待ってください。えっと、あなたのマイクはなぜ"}, {"type": "subtitle", "time": 4448.47, "timestamp": "01:14:08", "text": "今日はそんなにたくさん切り刻んでるの？私のマイクは"}, {"type": "subtitle", "time": 4453.35, "timestamp": "01:14:13", "text": "切り刻む。どうやって？たくさん。"}, {"type": "subtitle", "time": 4455.59, "timestamp": "01:14:15", "text": "ああ、これはDiscordの問題ですね。それは、"}, {"type": "subtitle", "time": 4460.55, "timestamp": "01:14:20", "text": "私もです。私はVCにいて、それは"}, {"type": "subtitle", "time": 4462.79, "timestamp": "01:14:22", "text": "私が話している途中で途切れてしまう。"}, {"type": "subtitle", "time": 4465.669, "timestamp": "01:14:25", "text": "右？"}, {"type": "subtitle", "time": 4468.95, "timestamp": "01:14:28", "text": "いいえ、もうあなたの声は聞こえません。えっと、それは"}, {"type": "subtitle", "time": 4473.229, "timestamp": "01:14:33", "text": "私が話すたびに音声が途切れるのですか？"}, {"type": "subtitle", "time": 4479.27, "timestamp": "01:14:39", "text": "はぁ？待って、今すぐ着替えるから。"}, {"type": "subtitle", "time": 4482.35, "timestamp": "01:14:42", "text": "わかりました、カットしたら教えてください"}, {"type": "subtitle", "time": 4486.87, "timestamp": "01:14:46", "text": "私が話すときはオフにする。そういうことは時々ある。"}, {"type": "subtitle", "time": 4488.91, "timestamp": "01:14:48", "text": "それは昨日起こった"}, {"type": "subtitle", "time": 4491.91, "timestamp": "01:14:51", "text": "私たちと一緒に彼と話しました。聞こえません"}, {"type": "subtitle", "time": 4495.91, "timestamp": "01:14:55", "text": "もう君じゃないよ。もうあなたの声が聞こえません。"}]
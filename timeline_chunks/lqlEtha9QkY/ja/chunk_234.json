[{"type": "subtitle", "time": 14046.71, "timestamp": "03:54:06", "text": "驚き！君に僕の兄弟になってほしい"}, {"type": "subtitle", "time": 14048.269, "timestamp": "03:54:08", "text": "のために"}, {"type": "subtitle", "time": 14051.349, "timestamp": "03:54:11", "text": "人生。そして君のお母さんも私と一緒にここにいる"}, {"type": "subtitle", "time": 14053.91, "timestamp": "03:54:13", "text": "祝う。"}, {"type": "subtitle", "time": 14056.309, "timestamp": "03:54:16", "text": "おめでとう。"}, {"type": "subtitle", "time": 14059.189, "timestamp": "03:54:19", "text": "彼女は死んだ。彼女は死んだ。金庫の覗き見"}, {"type": "subtitle", "time": 14062.469, "timestamp": "03:54:22", "text": "殺された。殺せ、殺せ。まあ、ある程度はうまくいった。で"}, {"type": "subtitle", "time": 14064.469, "timestamp": "03:54:24", "text": "少なくとも君は入れた。後で話そう。"}, {"type": "subtitle", "time": 14067.83, "timestamp": "03:54:27", "text": "血みどろの惨劇。わかった。あなたの助け。"}, {"type": "subtitle", "time": 14070.469, "timestamp": "03:54:30", "text": "そして、ダイナマイトが爆発する。さあ行こう。"}, {"type": "subtitle", "time": 14072.229, "timestamp": "03:54:32", "text": "うん。こんにちは、メイソンさん。元気かい？"}, {"type": "subtitle", "time": 14075.229, "timestamp": "03:54:35", "text": "右。これはボス戦に違いない。"}]
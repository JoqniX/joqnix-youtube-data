[{"type": "subtitle", "time": 13034.389, "timestamp": "03:37:14", "text": "わかった。"}, {"type": "subtitle", "time": 13035.91, "timestamp": "03:37:15", "text": "これはいくらで売っていますか？ああ、ありがとう"}, {"type": "subtitle", "time": 13037.75, "timestamp": "03:37:17", "text": "あなた。"}, {"type": "subtitle", "time": 13041.83, "timestamp": "03:37:21", "text": "195。それは安すぎる。"}, {"type": "subtitle", "time": 13045.19, "timestamp": "03:37:25", "text": "これはいくらですか？"}, {"type": "subtitle", "time": 13049.429, "timestamp": "03:37:29", "text": "彼女は最後までやり遂げられるだろうか？"}, {"type": "subtitle", "time": 13052.469, "timestamp": "03:37:32", "text": "はい、彼女ならできます。私を信じて。"}, {"type": "subtitle", "time": 13054.07, "timestamp": "03:37:34", "text": "持ち帰ることについてあまり気にしないでください"}, {"type": "subtitle", "time": 13056.469, "timestamp": "03:37:36", "text": "他の出場者たち。誰でも"}, {"type": "subtitle", "time": 13058.71, "timestamp": "03:37:38", "text": "あの男と寝るために競い合う、まあ、"}, {"type": "subtitle", "time": 13062.229, "timestamp": "03:37:42", "text": "彼らは社会にとって脅威だ。"}, {"type": "subtitle", "time": 13064.309, "timestamp": "03:37:44", "text": "よし、これらの商品を売ろう"}, {"type": "subtitle", "time": 13065.55, "timestamp": "03:37:45", "text": "しないで"}, {"type": "subtitle", "time": 13068.349, "timestamp": "03:37:48", "text": "必要。ええ、それは"}, {"type": "subtitle", "time": 13077.15, "timestamp": "03:37:57", "text": "あれ、待って、この2つは同じだ"}]
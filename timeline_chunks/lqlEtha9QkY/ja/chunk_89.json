[{"type": "subtitle", "time": 5347.149, "timestamp": "01:29:07", "text": "行く。掃除は必要ありません。なぜ？私"}, {"type": "subtitle", "time": 5349.59, "timestamp": "01:29:09", "text": "忘れた。それで、私はそれを観ました。そうだった"}, {"type": "subtitle", "time": 5353.189, "timestamp": "01:29:13", "text": "Jroとアレックスについての映画が作られる予定"}, {"type": "subtitle", "time": 5355.31, "timestamp": "01:29:15", "text": "結果がどうなったかについて不満を言う"}, {"type": "subtitle", "time": 5371.95, "timestamp": "01:29:31", "text": "戻ってきました。"}]
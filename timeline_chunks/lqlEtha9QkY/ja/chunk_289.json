[{"type": "subtitle", "time": 17343.19, "timestamp": "04:49:03", "text": "それ？はい。"}, {"type": "subtitle", "time": 17346.59, "timestamp": "04:49:06", "text": "そして、私たちは大丈夫なはずだ。そして私は切り替えます"}, {"type": "subtitle", "time": 17350.55, "timestamp": "04:49:10", "text": "f.ああ、キャプチャカードが"}, {"type": "subtitle", "time": 17354.83, "timestamp": "04:49:14", "text": "来る。待って、ちょっと待って。神様、私は嫌いです"}, {"type": "subtitle", "time": 17358.35, "timestamp": "04:49:18", "text": "これ。なぜそうしなかったのか"}, {"type": "subtitle", "time": 17362.788, "timestamp": "04:49:22", "text": "あなた？私はこれが嫌いだ。なぜ"}, {"type": "subtitle", "time": 17365.948, "timestamp": "04:49:25", "text": "キャプチャカード？さあ、再起動しなくちゃ。"}, {"type": "subtitle", "time": 17368.55, "timestamp": "04:49:28", "text": "明らか。ちくしょう。新しいアップデート"}, {"type": "subtitle", "time": 17376.31, "timestamp": "04:49:36", "text": "えっと、ちょっと待って。ちょっと待って、チャット。私にさせて"}, {"type": "subtitle", "time": 17378.83, "timestamp": "04:49:38", "text": "最初に辞めた"}, {"type": "subtitle", "time": 17389.59, "timestamp": "04:49:49", "text": "えっと、これはギグチャットでのアイデアです"}, {"type": "subtitle", "time": 17397.07, "timestamp": "04:49:57", "text": "次。こんにちは。ええと、私たちは"}]
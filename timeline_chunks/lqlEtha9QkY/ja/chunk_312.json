[{"type": "subtitle", "time": 18728.39, "timestamp": "05:12:08", "text": "えっと、必要なものはあまりないんだけど"}, {"type": "subtitle", "time": 18731.51, "timestamp": "05:12:11", "text": "保つ。実際、削除するだけでいいんです。"}, {"type": "subtitle", "time": 18733.39, "timestamp": "05:12:13", "text": "待って、あれは何？"}, {"type": "subtitle", "time": 18759.99, "timestamp": "05:12:39", "text": "あと2人。彼女はパイと言った、私は"}, {"type": "subtitle", "time": 18770.788, "timestamp": "05:12:50", "text": "まだ完璧ではない。練習しなくてはならない"}]
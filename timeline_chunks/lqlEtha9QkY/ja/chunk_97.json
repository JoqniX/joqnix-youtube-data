[{"type": "subtitle", "time": 5820.99, "timestamp": "01:37:00", "text": "書き込み"}, {"type": "subtitle", "time": 5823.91, "timestamp": "01:37:03", "text": "それ。そして、それを読まなかった時から、"}, {"type": "subtitle", "time": 5826.47, "timestamp": "01:37:06", "text": "いくつあると思いますか？私にさせて"}, {"type": "subtitle", "time": 5831.07, "timestamp": "01:37:11", "text": "チェック。"}, {"type": "subtitle", "time": 5834.07, "timestamp": "01:37:14", "text": "うん。うん。何章ありますか"}, {"type": "subtitle", "time": 5837.91, "timestamp": "01:37:17", "text": "ヴァンパイアがまた来たの？今では人気が出ている"}, {"type": "subtitle", "time": 5843.229, "timestamp": "01:37:23", "text": "今。ウィキペディアにはヴァンパイアに関する項目がある。"}, {"type": "subtitle", "time": 5846.83, "timestamp": "01:37:26", "text": "何？それは人気を博した。どうやって？"}, {"type": "subtitle", "time": 5851.59, "timestamp": "01:37:31", "text": "いつ？わかった。待って。おお、7つのタップボリューム"}, {"type": "subtitle", "time": 5853.47, "timestamp": "01:37:33", "text": "出てきた。"}]
[{"type": "subtitle", "time": 7202.39, "timestamp": "02:00:02", "text": "試合に出場する。え、何？"}, {"type": "subtitle", "time": 7203.83, "timestamp": "02:00:03", "text": "忘れたってどういう意味ですか"}, {"type": "subtitle", "time": 7210.109, "timestamp": "02:00:10", "text": "キャラクターシート。私たちは助ける必要がある"}, {"type": "subtitle", "time": 7213.629, "timestamp": "02:00:13", "text": "彼。文字はどこにありますか"}, {"type": "subtitle", "time": 7216.91, "timestamp": "02:00:16", "text": "そのシート"}, {"type": "subtitle", "time": 7225.39, "timestamp": "02:00:25", "text": "得意げな得意げなはバン"}, {"type": "subtitle", "time": 7240.87, "timestamp": "02:00:40", "text": "バン。なぜこの怪しい電線は"}, {"type": "subtitle", "time": 7243.99, "timestamp": "02:00:43", "text": "あそこに閉じ込められたような感じ？"}]
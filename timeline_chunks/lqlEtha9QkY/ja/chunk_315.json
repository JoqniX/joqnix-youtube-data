[{"type": "subtitle", "time": 18900.99, "timestamp": "05:15:00", "text": "まさに今頃。私にさせてください、私にさせてください、私にさせてください"}, {"type": "subtitle", "time": 18904.39, "timestamp": "05:15:04", "text": "ええと、14。それは進展です。わかった。私"}, {"type": "subtitle", "time": 18906.27, "timestamp": "05:15:06", "text": "あなたを上回らせる"}, {"type": "subtitle", "time": 18923.03, "timestamp": "05:15:23", "text": "うわぁ。その武器を複数回入手する"}, {"type": "subtitle", "time": 18928.15, "timestamp": "05:15:28", "text": "後で。死ぬな。うわぁ。私の盾。これ"}, {"type": "subtitle", "time": 18942.31, "timestamp": "05:15:42", "text": "えっと、一つ保存させてください。それ"}, {"type": "subtitle", "time": 18943.39, "timestamp": "05:15:43", "text": "もの"}, {"type": "subtitle", "time": 18946.868, "timestamp": "05:15:46", "text": "実際、こういうの好きなんです。何をすればいいですか"}, {"type": "subtitle", "time": 18949.47, "timestamp": "05:15:49", "text": "これ持ってる？私はしません"}, {"type": "subtitle", "time": 18951.868, "timestamp": "05:15:51", "text": "知る。これは"}, {"type": "subtitle", "time": 18954.788, "timestamp": "05:15:54", "text": "ショットガン。狙撃手は必要か？いいえ、私は"}, {"type": "subtitle", "time": 18957.15, "timestamp": "05:15:57", "text": "これをこの中に置いておく"}, {"type": "subtitle", "time": 18959.23, "timestamp": "05:15:59", "text": "もの。必要ない"}]
[{"type": "subtitle", "time": 6846.95, "timestamp": "01:54:06", "text": "上。いいえ、彼らはこちらには来なかったのです"}, {"type": "subtitle", "time": 6849.149, "timestamp": "01:54:09", "text": "まだ。"}, {"type": "subtitle", "time": 6852.47, "timestamp": "01:54:12", "text": "それで、なぜ通路のようなものがあるのか"}, {"type": "subtitle", "time": 6855.51, "timestamp": "01:54:15", "text": "登る？"}, {"type": "subtitle", "time": 6869.99, "timestamp": "01:54:29", "text": "サス。でも、健全な人は"}, {"type": "subtitle", "time": 6873.79, "timestamp": "01:54:33", "text": "私にとっては、より感情的な価値がある。うん、同じ"}, {"type": "subtitle", "time": 6875.83, "timestamp": "01:54:35", "text": "同じ。正直に言うと、私は"}, {"type": "subtitle", "time": 6895.589, "timestamp": "01:54:55", "text": "ああ、でも私はこういうことはよく知っていると言ったでしょう"}]
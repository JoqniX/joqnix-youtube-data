[{"type": "subtitle", "time": 20046.708, "timestamp": "05:34:06", "text": "上司の運勢はどうですか？"}, {"type": "subtitle", "time": 20051.15, "timestamp": "05:34:11", "text": "ええ、彼は"}, {"type": "subtitle", "time": 20053.788, "timestamp": "05:34:13", "text": "[音楽]"}, {"type": "subtitle", "time": 20073.11, "timestamp": "05:34:33", "text": "ボス。ボスはどこにいたんだっけ？"}, {"type": "subtitle", "time": 20074.868, "timestamp": "05:34:34", "text": "地図？"}, {"type": "subtitle", "time": 20078.23, "timestamp": "05:34:38", "text": "それとも、私が彼に勝ったのだろうか？"}]
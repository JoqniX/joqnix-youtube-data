[{"type": "subtitle", "time": 15797.11, "timestamp": "04:23:17", "text": "バー。ああ、あれは本物の人間だ。おお。"}, {"type": "subtitle", "time": 15799.349, "timestamp": "04:23:19", "text": "暇な時間には自分で作るのが好きです"}, {"type": "subtitle", "time": 15802.87, "timestamp": "04:23:22", "text": "おもちゃ。これは、改良版です。"}, {"type": "subtitle", "time": 15805.269, "timestamp": "04:23:25", "text": "寝室で思いついたもの。"}, {"type": "subtitle", "time": 15807.59, "timestamp": "04:23:27", "text": "うん。この小さなデバイスは私たちを助けてくれるはずです"}, {"type": "subtitle", "time": 15809.83, "timestamp": "04:23:29", "text": "キルの防御をショートさせるとき、何"}, {"type": "subtitle", "time": 15811.99, "timestamp": "04:23:31", "text": "あなたは何をするつもりですか？彼は見つけると思う"}, {"type": "subtitle", "time": 15814.87, "timestamp": "04:23:34", "text": "というより、私は今起きたばかりです。私はとても"}, {"type": "subtitle", "time": 15816.87, "timestamp": "04:23:36", "text": "混乱した。どうしたの？大丈夫。"}, {"type": "subtitle", "time": 15819.75, "timestamp": "04:23:39", "text": "右。"}, {"type": "subtitle", "time": 15821.349, "timestamp": "04:23:41", "text": "そして、あなたが彼がとても"}, {"type": "subtitle", "time": 15825.269, "timestamp": "04:23:45", "text": "私の言いたいことがお分かりいただければ、それ相応の理由があるということです。うん。"}, {"type": "subtitle", "time": 15827.389, "timestamp": "04:23:47", "text": "何が"}, {"type": "subtitle", "time": 15830.63, "timestamp": "04:23:50", "text": "その任務アイテム？わかった。ちんこ。"}, {"type": "subtitle", "time": 15833.11, "timestamp": "04:23:53", "text": "要点はそういうことだ。おお。あなたは持っていなかった"}, {"type": "subtitle", "time": 15835.95, "timestamp": "04:23:55", "text": "そう言うと、"}]
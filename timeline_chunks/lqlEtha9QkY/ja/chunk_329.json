[{"type": "subtitle", "time": 19770.27, "timestamp": "05:29:30", "text": "モクシー。こんにちは、モクシー。モー。わかった。こんにちは、モー。"}, {"type": "subtitle", "time": 19791.788, "timestamp": "05:29:51", "text": "ああ、これは"}, {"type": "subtitle", "time": 19793.708, "timestamp": "05:29:53", "text": "インド人。"}, {"type": "subtitle", "time": 19797.868, "timestamp": "05:29:57", "text": "ああ、それでアマラクラスゼロは"}]
[{"type": "subtitle", "time": 4383.91, "timestamp": "01:13:03", "text": "はぁ？私は理解できません。"}, {"type": "subtitle", "time": 4389.31, "timestamp": "01:13:09", "text": "それはつまり"}, {"type": "subtitle", "time": 4407.95, "timestamp": "01:13:27", "text": "H. また、私は"}, {"type": "subtitle", "time": 4411.59, "timestamp": "01:13:31", "text": "どのブランドのことを言っているのか気になります。"}, {"type": "subtitle", "time": 4415.11, "timestamp": "01:13:35", "text": "こんなに飲んだことはない"}, {"type": "subtitle", "time": 4417.189, "timestamp": "01:13:37", "text": "粉乳。"}, {"type": "subtitle", "time": 4419.27, "timestamp": "01:13:39", "text": "はい、"}, {"type": "subtitle", "time": 4420.87, "timestamp": "01:13:40", "text": "おそらく。まあ、そんな感じですね。あなた"}, {"type": "subtitle", "time": 4424.07, "timestamp": "01:13:44", "text": "水に少し入れると、"}, {"type": "subtitle", "time": 4427.99, "timestamp": "01:13:47", "text": "実際、ほら、"}, {"type": "subtitle", "time": 4437.11, "timestamp": "01:13:57", "text": "私はAmazonの商品を見ています"}, {"type": "subtitle", "time": 4439.35, "timestamp": "01:13:59", "text": "哺乳瓶入りの牛乳。なぜ私はこれを見ているのだろう？"}]
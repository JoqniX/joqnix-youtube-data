[{"type": "subtitle", "time": 14832.429, "timestamp": "04:07:12", "text": "完全に愛してる"}, {"type": "subtitle", "time": 14854.83, "timestamp": "04:07:34", "text": "私のものを食べてください"}, {"type": "subtitle", "time": 14861.91, "timestamp": "04:07:41", "text": "私が死んでも構わない。私はただ蘇生しただけだ。病気"}, {"type": "subtitle", "time": 14864.389, "timestamp": "04:07:44", "text": "彼が私を殺すのを待つ。"}, {"type": "subtitle", "time": 14867.429, "timestamp": "04:07:47", "text": "私はこうして蘇る。健康状態は良好です。"}, {"type": "subtitle", "time": 14870.59, "timestamp": "04:07:50", "text": "さあ行こう。"}, {"type": "subtitle", "time": 14874.309, "timestamp": "04:07:54", "text": "205 148。"}]
[{"type": "subtitle", "time": 13803.03, "timestamp": "03:50:03", "text": "俺の正体がバレたら、俺は終わりだ。"}, {"type": "subtitle", "time": 13804.63, "timestamp": "03:50:04", "text": "助けようとしてくれてありがとう、でも"}, {"type": "subtitle", "time": 13805.75, "timestamp": "03:50:05", "text": "彼女が言う通りにしないといけないみたいだ"}, {"type": "subtitle", "time": 13807.83, "timestamp": "03:50:07", "text": "とりあえず、そう言って付き合ってあげよう。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 13809.189, "timestamp": "03:50:09", "text": "ここから出してくれれば、全部話すよ"}, {"type": "subtitle", "time": 13816.51, "timestamp": "03:50:16", "text": "私はあなたを信頼します。コップボットに近づく"}, {"type": "subtitle", "time": 13819.91, "timestamp": "03:50:19", "text": "本社は今ここにあります。中に入る方法を見つけて"}, {"type": "subtitle", "time": 13822.229, "timestamp": "03:50:22", "text": "粉砕する"}, {"type": "subtitle", "time": 13826.469, "timestamp": "03:50:26", "text": "私の赤ちゃんの血の輝きを解放して。"}, {"type": "subtitle", "time": 13841.11, "timestamp": "03:50:41", "text": "そして最後はまっすぐ"}, {"type": "subtitle", "time": 13848.11, "timestamp": "03:50:48", "text": "これ。おお"}, {"type": "subtitle", "time": 13854.469, "timestamp": "03:50:54", "text": "ここで何が欲しいの？立ってください"}, {"type": "subtitle", "time": 13857.349, "timestamp": "03:50:57", "text": "仕事。"}, {"type": "subtitle", "time": 13859.349, "timestamp": "03:50:59", "text": "ああ、殺人事件が起こりそうだ"}]
[{"type": "subtitle", "time": 11040.75, "timestamp": "03:04:00", "text": "XXへ"}, {"type": "subtitle", "time": 11043.15, "timestamp": "03:04:03", "text": "X"}, {"type": "subtitle", "time": 11047.269, "timestamp": "03:04:07", "text": "地下鉄が敷設されており、私たちの目的地はここにあります。それで"}, {"type": "subtitle", "time": 11063.469, "timestamp": "03:04:23", "text": "テレポート？アクティベートできません。待って、"}, {"type": "subtitle", "time": 11081.32, "timestamp": "03:04:41", "text": "何？なぜテレポートできないのですか？"}, {"type": "subtitle", "time": 11090.469, "timestamp": "03:04:50", "text": "待って。よし、続けよう。えっと、私たちは"}]
[{"type": "subtitle", "time": 11523.349, "timestamp": "03:12:03", "text": "私はすでに、"}, {"type": "subtitle", "time": 11528.07, "timestamp": "03:12:08", "text": "小柄な男。小柄な男。うん。バリスタボット、"}, {"type": "subtitle", "time": 11532.07, "timestamp": "03:12:12", "text": "黙ってコーヒーを持ってきてくれ。はい。"}, {"type": "subtitle", "time": 11534.309, "timestamp": "03:12:14", "text": "動脈瘤破裂とか、そういうことは起こさないようにね。ただ"}, {"type": "subtitle", "time": 11536.07, "timestamp": "03:12:16", "text": "その持ち帰り用のカップを見せてください。中身を入れます。"}, {"type": "subtitle", "time": 11538.469, "timestamp": "03:12:18", "text": "あなたのために用意しました。はぁ？"}, {"type": "subtitle", "time": 11540.55, "timestamp": "03:12:20", "text": "幸いなことに、ソーは正義の人だ。さあ、待って"}, {"type": "subtitle", "time": 11549.269, "timestamp": "03:12:29", "text": "なぜこんなに時間がかかっているのですか？まあ、いいよ。"}, {"type": "subtitle", "time": 11552.07, "timestamp": "03:12:32", "text": "完璧を急いで手に入れることはできない。"}, {"type": "subtitle", "time": 11555.03, "timestamp": "03:12:35", "text": "ボットに仕事を任せましょう。それは"}, {"type": "subtitle", "time": 11565.51, "timestamp": "03:12:45", "text": "どういたしまして。素敵な一日をお過ごしください。"}, {"type": "subtitle", "time": 11568.79, "timestamp": "03:12:48", "text": "はるか下。あなたはもういない。これで全て完了です。"}, {"type": "subtitle", "time": 11570.349, "timestamp": "03:12:50", "text": "はい。"}, {"type": "subtitle", "time": 11575.51, "timestamp": "03:12:55", "text": "ついに。コーヒーをこちらに持ってきてください。"}, {"type": "subtitle", "time": 11578.03, "timestamp": "03:12:58", "text": "ローラアイ、あなたの言うことは分かりますし、私もとても"}]
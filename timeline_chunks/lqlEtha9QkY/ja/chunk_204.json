[{"type": "subtitle", "time": 12241.67, "timestamp": "03:24:01", "text": "サイバーパンクではよくやっていたことだ。えっと、私は"}, {"type": "subtitle", "time": 12244.91, "timestamp": "03:24:04", "text": "配信でプレイする。じゃあ次はそれをやろう"}, {"type": "subtitle", "time": 12249.429, "timestamp": "03:24:09", "text": "アークと同時期に発売されたと思います。"}, {"type": "subtitle", "time": 12252.07, "timestamp": "03:24:12", "text": "しかし、彼らはそれを修正したと思います。彼らは"}, {"type": "subtitle", "time": 12254.71, "timestamp": "03:24:14", "text": "修正しました。だから、"}, {"type": "subtitle", "time": 12258.389, "timestamp": "03:24:18", "text": "最後に秘密の邸宅とか色々"}, {"type": "subtitle", "time": 12260.229, "timestamp": "03:24:20", "text": "ゲーム。あなたはそこへ行くことはできません"}, {"type": "subtitle", "time": 12264.15, "timestamp": "03:24:24", "text": "もう。私は秘密の場所には行かなかった"}, {"type": "subtitle", "time": 12268.15, "timestamp": "03:24:28", "text": "えーと、Vのマンションと、えーと、"}, {"type": "subtitle", "time": 12270.87, "timestamp": "03:24:30", "text": "ジャケットとか色々。私がそれをストリーミングしたとき"}, {"type": "subtitle", "time": 12274.71, "timestamp": "03:24:34", "text": "ゲームが発売されたとき"}, {"type": "subtitle", "time": 12284.87, "timestamp": "03:24:44", "text": "楽しい。えっと、私はシベリアで迷子になっていました"}, {"type": "subtitle", "time": 12286.469, "timestamp": "03:24:46", "text": "教会でろうそくに火を灯す"}, {"type": "subtitle", "time": 12289.99, "timestamp": "03:24:49", "text": "おじいちゃんパンツと、おじいちゃんパンツのために"}, {"type": "subtitle", "time": 12292.469, "timestamp": "03:24:52", "text": "彼ら自身。こんにちは。彼らが安らかに眠れますように"}]
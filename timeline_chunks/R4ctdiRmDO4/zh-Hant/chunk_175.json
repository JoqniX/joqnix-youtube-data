[{"type": "subtitle", "time": 10517.51, "timestamp": "02:55:17", "text": "[音樂] 好了各位，設定"}, {"type": "subtitle", "time": 10532.469, "timestamp": "02:55:32", "text": "發送行程安排，為什麼不"}, {"type": "subtitle", "time": 10543.349, "timestamp": "02:55:43", "text": "玩"}, {"type": "subtitle", "time": 10557.269, "timestamp": "02:55:57", "text": "嗯，我會用翻譯器。一秒鐘。呃，我們已經在 YouTube 和 Twitch 上播放過音樂了。就這樣"}, {"type": "subtitle", "time": 10559.91, "timestamp": "02:55:59", "text": "結束了。我當時"}]
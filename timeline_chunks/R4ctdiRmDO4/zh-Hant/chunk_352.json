[{"type": "subtitle", "time": 21124.27, "timestamp": "05:52:04", "text": "網"}, {"type": "subtitle", "time": 21126.51, "timestamp": "05:52:06", "text": "。很好。那"}, {"type": "subtitle", "time": 21132.628, "timestamp": "05:52:12", "text": "我得小心點。音訊路由。你知道嗎？我打算專門做一條短的WhatsApp線，以防"}, {"type": "subtitle", "time": 21138.15, "timestamp": "05:52:18", "text": "萬一，因為"}, {"type": "subtitle", "time": 21140.43, "timestamp": "05:52:20", "text": "我預感到這種情況會發生"}, {"type": "subtitle", "time": 21145.15, "timestamp": "05:52:25", "text": "。好了，我躲在這兒，去開燈"}, {"type": "subtitle", "time": 21161.31, "timestamp": "05:52:41", "text": "什麼的。我有肉。注意！外國的！外國的！"}, {"type": "subtitle", "time": 21166.07, "timestamp": "05:52:46", "text": "大衛在哪裡？哦，天哪。我剛才在幹嘛來著？哦，對了，遊戲。"}]
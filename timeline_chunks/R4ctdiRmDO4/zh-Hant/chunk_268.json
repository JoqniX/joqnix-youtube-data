[{"type": "subtitle", "time": 16097.99, "timestamp": "04:28:17", "text": "但是，升級仍然很難"}, {"type": "subtitle", "time": 16104.07, "timestamp": "04:28:24", "text": "。這裡面牽涉到很多東西。"}, {"type": "subtitle", "time": 16106.149, "timestamp": "04:28:26", "text": "我當時就想，我可能得刪除這個，就因為那個現實生活中的驗證過程。我又不想"}, {"type": "subtitle", "time": 16131.309, "timestamp": "04:28:51", "text": "知道，這就是獨立開發者的痛苦，你可以說我不知道，上面寫了什麼？"}]
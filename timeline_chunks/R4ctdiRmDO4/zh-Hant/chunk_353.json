[{"type": "subtitle", "time": 21182.91, "timestamp": "05:53:02", "text": "為什麼我沒有["}, {"type": "subtitle", "time": 21186.07, "timestamp": "05:53:06", "text": "掌聲]武器？我的天哪，我沒輸。嗨，我穿著這雙鞋回來了。"}, {"type": "subtitle", "time": 21208.39, "timestamp": "05:53:28", "text": "好人。依偎在一起。依偎著。我有個小丑。哦，等等。什麼？我的天哪。"}, {"type": "subtitle", "time": 21211.51, "timestamp": "05:53:31", "text": "我不知道是不是明天"}]
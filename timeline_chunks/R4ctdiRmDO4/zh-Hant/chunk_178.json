[{"type": "subtitle", "time": 10681.75, "timestamp": "02:58:01", "text": "哦，歡迎"}, {"type": "subtitle", "time": 10690.389, "timestamp": "02:58:10", "text": "回來，Jan。你的音樂事業進展如何？希望"}, {"type": "subtitle", "time": 10710.75, "timestamp": "02:58:30", "text": "你也一樣。  [音樂] 我呃，我想…這簡直是一場賭博，兄弟。問題是現在這完全是一場賭博，但看起來石正美感覺到了。她沒事吧？呃，她好像不太好。哦，她最近遇到了一些事情。"}, {"type": "subtitle", "time": 10733.51, "timestamp": "02:58:53", "text": "我希望她今天晚上能"}]
[{"type": "subtitle", "time": 14702.87, "timestamp": "04:05:02", "text": "學生。我將前往日本學習語言。我必須通過"}, {"type": "subtitle", "time": 14717.269, "timestamp": "04:05:17", "text": "。我至少要在兩年內拿到N2證書，這樣我才能申請工作之"}, {"type": "subtitle", "time": 14749.83, "timestamp": "04:05:49", "text": "類的。所以我會嘗試從那裡考上大學之類的院校，接受高等教育。我想在日本待更久。所以"}]
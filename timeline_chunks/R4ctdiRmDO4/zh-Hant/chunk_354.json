[{"type": "subtitle", "time": 21250.7, "timestamp": "05:54:10", "text": "你能行的。記得喝水，也要好好服用"}, {"type": "subtitle", "time": 21261.19, "timestamp": "05:54:21", "text": "興奮劑。是的，是的，是的。我也很暖和，頭巾也很暖和。是的。"}, {"type": "subtitle", "time": 21291.83, "timestamp": "05:54:51", "text": "天哪。我起床就像推著一樣。"}, {"type": "subtitle", "time": 21293.708, "timestamp": "05:54:53", "text": "我沒什麼，沒有，沒有，沒有。 [音樂]其實"}]
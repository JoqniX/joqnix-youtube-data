[{"type": "subtitle", "time": 21424.07, "timestamp": "05:57:04", "text": "不，"}, {"type": "subtitle", "time": 21429.27, "timestamp": "05:57:09", "text": "只是因為我有直播的義務之類的"}, {"type": "subtitle", "time": 21452.708, "timestamp": "05:57:32", "text": "。"}, {"type": "subtitle", "time": 21458.07, "timestamp": "05:57:38", "text": "但是什麼類型的呢？是啊，也許只是我自己的"}, {"type": "subtitle", "time": 21467.11, "timestamp": "05:57:47", "text": "感覺。我不知道。也許只是個梗。有趣的是，我和一個朋友從早到晚爬了一整座山，喝了八杯咖啡。等等，什麼？"}, {"type": "subtitle", "time": 21469.788, "timestamp": "05:57:49", "text": "所以把它當成一種義務吧。是"}]
[{"type": "subtitle", "time": 22149.788, "timestamp": "06:09:09", "text": "但我得確保它不會發出很大的聲音什麼的。可疑。這是其中一件事。我必須確保這一點，而且我還得確保我說的任何話，比如我周圍的人，都不會被"}, {"type": "subtitle", "time": 22162.868, "timestamp": "06:09:22", "text": "誤解，我的意思是，如果我的家人或者家裡的"}, {"type": "subtitle", "time": 22164.948, "timestamp": "06:09:24", "text": "其他人聽到我說的話，他們會說，嗯？"}, {"type": "subtitle", "time": 22176.948, "timestamp": "06:09:36", "text": "這是什麼？這笨蛋在幹嘛"}]
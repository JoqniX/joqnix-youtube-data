[{"type": "subtitle", "time": 5347.87, "timestamp": "01:29:07", "text": "啊，你看我現在還在開笑話"}, {"type": "subtitle", "time": 5352.59, "timestamp": "01:29:12", "text": "派對，因為之前的計畫失敗了。  但"}, {"type": "subtitle", "time": 5357.03, "timestamp": "01:29:17", "text": "我想要和她重新連結"}, {"type": "subtitle", "time": 5359.03, "timestamp": "01:29:19", "text": "。"}, {"type": "subtitle", "time": 5380.95, "timestamp": "01:29:40", "text": "有時候，你想為一些小創作者做點什麼，例如創造機會"}, {"type": "subtitle", "time": 5385.83, "timestamp": "01:29:45", "text": "或做一些能幫助他們未來發展的事情"}]
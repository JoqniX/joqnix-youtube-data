[{"type": "subtitle", "time": 15437.91, "timestamp": "04:17:17", "text": "得很好。  這是什麼牙齒狀的東西"}, {"type": "subtitle", "time": 15447.59, "timestamp": "04:17:27", "text": "？好多很酷的復古車型。  為什麼"}, {"type": "subtitle", "time": 15464.91, "timestamp": "04:17:44", "text": "兩款車型都賣這麼貴？  確切地。我的模型幾乎每款售價都在2000美元左右。這就是為什麼"}, {"type": "subtitle", "time": 15479.91, "timestamp": "04:17:59", "text": "我把它當作我的捐款，因為"}]
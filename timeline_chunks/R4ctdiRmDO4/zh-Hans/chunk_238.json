[{"type": "subtitle", "time": 14280.11, "timestamp": "03:58:00", "text": "知道，一个随机出现的家伙"}, {"type": "subtitle", "time": 14282.469, "timestamp": "03:58:02", "text": "无处可寻你，而你却制造了这一切。"}, {"type": "subtitle", "time": 14285.11, "timestamp": "03:58:05", "text": "认识你或与你交朋友"}, {"type": "subtitle", "time": 14287.349, "timestamp": "03:58:07", "text": "和你聊天，诸如此类的事情"}, {"type": "subtitle", "time": 14290.07, "timestamp": "03:58:10", "text": "有一天，他们问你能给"}, {"type": "subtitle", "time": 14294.15, "timestamp": "03:58:14", "text": "给我你的ADA卡，还有，还有……"}, {"type": "subtitle", "time": 14297.59, "timestamp": "03:58:17", "text": "你拿着ADA汽车的照片"}, {"type": "subtitle", "time": 14300.95, "timestamp": "03:58:20", "text": "把它们拿回来，帮帮我"}, {"type": "subtitle", "time": 14305.189, "timestamp": "03:58:25", "text": "这个那个。你真的会给吗？"}, {"type": "subtitle", "time": 14309.03, "timestamp": "03:58:29", "text": "你只会把钱给那些"}, {"type": "subtitle", "time": 14312.55, "timestamp": "03:58:32", "text": "你知道，这比任何其他事情都更甚。"}, {"type": "subtitle", "time": 14315.95, "timestamp": "03:58:35", "text": "超过三年或两年"}, {"type": "subtitle", "time": 14324.469, "timestamp": "03:58:44", "text": "片刻。是的。那将会很痛苦"}, {"type": "subtitle", "time": 14331.429, "timestamp": "03:58:51", "text": "疼痛。我会说，兄弟，我不会……"}, {"type": "subtitle", "time": 14338.63, "timestamp": "03:58:58", "text": "嗯，对，还有那个。有些人会"}]
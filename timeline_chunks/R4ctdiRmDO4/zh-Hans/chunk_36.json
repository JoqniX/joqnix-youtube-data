[{"type": "subtitle", "time": 2161.069, "timestamp": "00:36:01", "text": "塞拉斯蒂娅？"}, {"type": "subtitle", "time": 2165.71, "timestamp": "00:36:05", "text": "呃，不，等等。难道是须美奈吗？我"}, {"type": "subtitle", "time": 2175.03, "timestamp": "00:36:15", "text": "嗯，是的。嗯，是的，但是阿塔姆斯不能……"}, {"type": "subtitle", "time": 2178.39, "timestamp": "00:36:18", "text": "加入进来，我想，呃，在那段时间里"}, {"type": "subtitle", "time": 2181.91, "timestamp": "00:36:21", "text": "几周后，她迎来了自己的首秀。"}, {"type": "subtitle", "time": 2186.109, "timestamp": "00:36:26", "text": "这套服装一亮相，她就忙起来了。"}, {"type": "subtitle", "time": 2187.79, "timestamp": "00:36:27", "text": "东西"}, {"type": "subtitle", "time": 2190.99, "timestamp": "00:36:30", "text": "是的，她得到了"}, {"type": "subtitle", "time": 2196.03, "timestamp": "00:36:36", "text": "填充"}, {"type": "subtitle", "time": 2218.63, "timestamp": "00:36:58", "text": "在。社交星期六。哦，呃，是 Omegle。"}]
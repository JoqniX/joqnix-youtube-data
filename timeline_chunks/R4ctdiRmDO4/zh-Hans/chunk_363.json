[{"type": "subtitle", "time": 21783.19, "timestamp": "06:03:03", "text": "片刻？如果你需要我，我随时都在。"}, {"type": "subtitle", "time": 21785.39, "timestamp": "06:03:05", "text": "还有一些其他的东西。但"}, {"type": "subtitle", "time": 21788.31, "timestamp": "06:03:08", "text": "再说一遍，我真的在做。是的。我是"}, {"type": "subtitle", "time": 21789.788, "timestamp": "06:03:09", "text": "喜欢"}, {"type": "subtitle", "time": 21795.83, "timestamp": "06:03:15", "text": "嗯，有时候你得不到你想要的。"}, {"type": "subtitle", "time": 21798.23, "timestamp": "06:03:18", "text": "除非你主动要求。是啊，还有那件事。我"}, {"type": "subtitle", "time": 21799.788, "timestamp": "06:03:19", "text": "有点明白"}, {"type": "subtitle", "time": 21803.708, "timestamp": "06:03:23", "text": "那。但这个比利比利"}, {"type": "subtitle", "time": 21807.51, "timestamp": "06:03:27", "text": "那件事，我不得不问别人才能……"}, {"type": "subtitle", "time": 21810.788, "timestamp": "06:03:30", "text": "了解一些事情。"}, {"type": "subtitle", "time": 21812.868, "timestamp": "06:03:32", "text": "有价值、优秀或有效是件好事。"}, {"type": "subtitle", "time": 21819.83, "timestamp": "06:03:39", "text": "自私。是的。但我也不想要"}, {"type": "subtitle", "time": 21829.868, "timestamp": "06:03:49", "text": "感受"}, {"type": "subtitle", "time": 21832.788, "timestamp": "06:03:52", "text": "比如漠不关心之类的，或者类似"}, {"type": "subtitle", "time": 21836.19, "timestamp": "06:03:56", "text": "就像把我当成这家骑师酒吧一样"}, {"type": "subtitle", "time": 21839.59, "timestamp": "06:03:59", "text": "他需要帮助，就像他需要帮助一样。"}]
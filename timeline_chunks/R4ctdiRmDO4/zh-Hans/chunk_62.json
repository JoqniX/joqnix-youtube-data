[{"type": "subtitle", "time": 3730.72, "timestamp": "01:02:10", "text": "哦不，我忘了。我为什么在喝酒"}, {"type": "subtitle", "time": 3731.95, "timestamp": "01:02:11", "text": "[音乐]"}, {"type": "subtitle", "time": 3734.71, "timestamp": "01:02:14", "text": "茶？这会让我睡着"}, {"type": "subtitle", "time": 3745.069, "timestamp": "01:02:25", "text": "为什么？笨蛋，你应该有"}, {"type": "subtitle", "time": 3748.23, "timestamp": "01:02:28", "text": "我忘了。如果我喝茶，我会摔倒"}, {"type": "subtitle", "time": 3750.43, "timestamp": "01:02:30", "text": "几分钟就睡着了，或者像几天那么短的时间。"}, {"type": "subtitle", "time": 3765.99, "timestamp": "01:02:45", "text": "我不应该训练我的身体去制造"}, {"type": "subtitle", "time": 3770.03, "timestamp": "01:02:50", "text": "使之如果我喝红茶"}]
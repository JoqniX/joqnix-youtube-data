[{"type": "subtitle", "time": 16802.31, "timestamp": "04:40:02", "text": "知道。是啊，但我不会那么做。的"}, {"type": "subtitle", "time": 16804.67, "timestamp": "04:40:04", "text": "当然，我不会那么做。所以在"}, {"type": "subtitle", "time": 16810.31, "timestamp": "04:40:10", "text": "感觉就像……呃，因为……呃，就像从我的"}, {"type": "subtitle", "time": 16813.19, "timestamp": "04:40:13", "text": "我的观众可能会说“是啊”。"}, {"type": "subtitle", "time": 16816.15, "timestamp": "04:40:16", "text": "骑师不会说脏话，而且像大多数人一样"}, {"type": "subtitle", "time": 16818.31, "timestamp": "04:40:18", "text": "你们大多数人都会像这样："}, {"type": "subtitle", "time": 16821.35, "timestamp": "04:40:21", "text": "意思是，你可以这样想。"}, {"type": "subtitle", "time": 16823.35, "timestamp": "04:40:23", "text": "但如果主播不分享内容的话……"}, {"type": "subtitle", "time": 16826.15, "timestamp": "04:40:26", "text": "或者做某事"}, {"type": "subtitle", "time": 16829.19, "timestamp": "04:40:29", "text": "做一些你通常不会做的事情"}, {"type": "subtitle", "time": 16831.35, "timestamp": "04:40:31", "text": "等等，别做你正在做的事情。"}, {"type": "subtitle", "time": 16834.39, "timestamp": "04:40:34", "text": "通常会这样做。 H：所以这并不意味着你"}, {"type": "subtitle", "time": 16837.03, "timestamp": "04:40:37", "text": "你还得调整一下你的东西，就因为……"}, {"type": "subtitle", "time": 16839.75, "timestamp": "04:40:39", "text": "呃，你是在主播聊天室里吗？"}, {"type": "subtitle", "time": 16841.43, "timestamp": "04:40:41", "text": "差不多就是这样。你就做个混蛋吧"}, {"type": "subtitle", "time": 16847.31, "timestamp": "04:40:47", "text": "这样挺好。所以我相信，呃，老板"}, {"type": "subtitle", "time": 16850.39, "timestamp": "04:40:50", "text": "乔克考虑了一下。这就是他的原因"}, {"type": "subtitle", "time": 16853.67, "timestamp": "04:40:53", "text": "就好像是其他主播一样"}, {"type": "subtitle", "time": 16856.07, "timestamp": "04:40:56", "text": "或者类似这样：他们会像这样"}, {"type": "subtitle", "time": 16859.03, "timestamp": "04:40:59", "text": "如果我像往常一样去的话"}]
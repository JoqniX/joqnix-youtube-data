[{"type": "subtitle", "time": 18901.03, "timestamp": "05:15:01", "text": "为我。等等，在我这么做之前，我还有……"}, {"type": "subtitle", "time": 18904.07, "timestamp": "05:15:04", "text": "进入Nvidia控制面板进行修复"}, {"type": "subtitle", "time": 18905.39, "timestamp": "05:15:05", "text": "一些"}, {"type": "subtitle", "time": 18908.07, "timestamp": "05:15:08", "text": "东西。我很久没在电脑上玩游戏了。"}, {"type": "subtitle", "time": 18910.67, "timestamp": "05:15:10", "text": "大概六七年吧。"}, {"type": "subtitle", "time": 18914.788, "timestamp": "05:15:14", "text": "哇，好长好长啊。"}, {"type": "subtitle", "time": 18918.07, "timestamp": "05:15:18", "text": "好的。所以，这应该全屏显示。"}, {"type": "subtitle", "time": 18919.31, "timestamp": "05:15:19", "text": "你"}, {"type": "subtitle", "time": 18922.19, "timestamp": "05:15:22", "text": "伙计们。为你"}, {"type": "subtitle", "time": 18926.39, "timestamp": "05:15:26", "text": "各位，它也应该全屏显示。"}, {"type": "subtitle", "time": 18930.15, "timestamp": "05:15:30", "text": "你们。将是AVTGC 537。就是它。"}, {"type": "subtitle", "time": 18931.55, "timestamp": "05:15:31", "text": "俘虏"}, {"type": "subtitle", "time": 18935.39, "timestamp": "05:15:35", "text": "卡片。那是A媒体直播游戏玩家"}, {"type": "subtitle", "time": 18939.11, "timestamp": "05:15:39", "text": "4K玩意儿。哦，是的。这张采集卡"}, {"type": "subtitle", "time": 18943.788, "timestamp": "05:15:43", "text": "可拍摄高达 4K 60fps 的视频。由"}, {"type": "subtitle", "time": 18947.47, "timestamp": "05:15:47", "text": "方式。而1080将是"}, {"type": "subtitle", "time": 18951.67, "timestamp": "05:15:51", "text": "240. 是的。所以我买了它，因为我有一个"}, {"type": "subtitle", "time": 18953.83, "timestamp": "05:15:53", "text": "所以，我的显示器刷新率是"}, {"type": "subtitle", "time": 18957.03, "timestamp": "05:15:57", "text": "24 到 240。所以，我想，好吧，为什么是"}]
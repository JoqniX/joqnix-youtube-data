[{"type": "subtitle", "time": 3181.67, "timestamp": "00:53:01", "text": "我来搬。我会加某人"}, {"type": "subtitle", "time": 3189.79, "timestamp": "00:53:09", "text": "嗯，我可以即兴演奏一个。"}, {"type": "subtitle", "time": 3193.87, "timestamp": "00:53:13", "text": "铃木一号将……"}, {"type": "subtitle", "time": 3197.03, "timestamp": "00:53:17", "text": "11. 是的，我还没决定该怎么办。"}, {"type": "subtitle", "time": 3200.03, "timestamp": "00:53:20", "text": "11号。呃，明天。"}, {"type": "subtitle", "time": 3201.95, "timestamp": "00:53:21", "text": "明天"}, {"type": "subtitle", "time": 3205.79, "timestamp": "00:53:25", "text": "还有 Hoku 和 Fi 的那个在"}, {"type": "subtitle", "time": 3212.99, "timestamp": "00:53:32", "text": "阿斯特拉。接下来"}, {"type": "subtitle", "time": 3216.349, "timestamp": "00:53:36", "text": "本周有这项封锁协议"}, {"type": "subtitle", "time": 3220.109, "timestamp": "00:53:40", "text": "与 Jasima Sumi Natsuki 和"}, {"type": "subtitle", "time": 3225.15, "timestamp": "00:53:45", "text": "Zeno 和呃，在我的第一次日本合作中"}, {"type": "subtitle", "time": 3230.47, "timestamp": "00:53:50", "text": "谢丽莎和我将要玩游戏"}, {"type": "subtitle", "time": 3233.349, "timestamp": "00:53:53", "text": "仓库。所以，是的，我希望你们都来。"}, {"type": "subtitle", "time": 3235.47, "timestamp": "00:53:55", "text": "尤其是这些"}, {"type": "subtitle", "time": 3237.99, "timestamp": "00:53:57", "text": "一。没关系。它似乎没有出现"}]
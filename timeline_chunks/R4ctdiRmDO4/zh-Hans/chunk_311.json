[{"type": "subtitle", "time": 18662.708, "timestamp": "05:11:02", "text": "那东西叫什么来着？"}, {"type": "subtitle", "time": 18665.43, "timestamp": "05:11:05", "text": "你平时在哪里熨衣服之类的？"}, {"type": "subtitle", "time": 18667.948, "timestamp": "05:11:07", "text": "你用来熨烫衣服的那个装置"}, {"type": "subtitle", "time": 18671.43, "timestamp": "05:11:11", "text": "衣服之类的。铁盒。就是这样"}, {"type": "subtitle", "time": 18672.51, "timestamp": "05:11:12", "text": "你打电话，"}, {"type": "subtitle", "time": 18675.35, "timestamp": "05:11:15", "text": "正确的？熨斗。就是这样。"}, {"type": "subtitle", "time": 18677.708, "timestamp": "05:11:17", "text": "他们称之为。好的。"}, {"type": "subtitle", "time": 18679.16, "timestamp": "05:11:19", "text": "漂浮的。"}, {"type": "subtitle", "time": 18698.23, "timestamp": "05:11:38", "text": "是。它叫做铁。笨蛋。不。铁是"}, {"type": "subtitle", "time": 18699.628, "timestamp": "05:11:39", "text": "像铁一样。"}, {"type": "subtitle", "time": 18702.99, "timestamp": "05:11:42", "text": "D. 或者可以是"}, {"type": "subtitle", "time": 18705.99, "timestamp": "05:11:45", "text": "铁？铁就是铁。哦，就叫它“"}, {"type": "subtitle", "time": 18708.31, "timestamp": "05:11:48", "text": "铁。好的，"}, {"type": "subtitle", "time": 18717.708, "timestamp": "05:11:57", "text": "患病的"}]
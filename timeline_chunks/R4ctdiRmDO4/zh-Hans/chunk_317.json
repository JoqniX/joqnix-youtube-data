[{"type": "subtitle", "time": 19025.11, "timestamp": "05:17:05", "text": "移动的。我的天哪，看来我"}, {"type": "subtitle", "time": 19028.15, "timestamp": "05:17:08", "text": "摘录自“让我们看看情况如何”。"}, {"type": "subtitle", "time": 19036.55, "timestamp": "05:17:16", "text": "呃，我稳得像个老古董。我不"}, {"type": "subtitle", "time": 19039.27, "timestamp": "05:17:19", "text": "特别喜欢原神和玛洛的游戏。我"}, {"type": "subtitle", "time": 19041.07, "timestamp": "05:17:21", "text": "例如角色扮演游戏。"}, {"type": "subtitle", "time": 19062.948, "timestamp": "05:17:42", "text": "我以前也玩过。是的，我想要我"}, {"type": "subtitle", "time": 19069.47, "timestamp": "05:17:49", "text": "哦不，它甚至连这个都卡顿。"}, {"type": "subtitle", "time": 19072.19, "timestamp": "05:17:52", "text": "解决。所以，这表明"}, {"type": "subtitle", "time": 19075.75, "timestamp": "05:17:55", "text": "我真庆幸自己通关了《守望先锋》"}]
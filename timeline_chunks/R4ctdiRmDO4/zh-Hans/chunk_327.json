[{"type": "subtitle", "time": 19621.03, "timestamp": "05:27:01", "text": "生活在……中是什么感觉？"}, {"type": "subtitle", "time": 19623.51, "timestamp": "05:27:03", "text": "像南极洲或者像非常寒冷的地方"}, {"type": "subtitle", "time": 19627.55, "timestamp": "05:27:07", "text": "例如负0或负1之类的地方"}, {"type": "subtitle", "time": 19631.59, "timestamp": "05:27:11", "text": "摄氏度之类的地方，对吧？"}, {"type": "subtitle", "time": 19634.35, "timestamp": "05:27:14", "text": "就像我以前那样"}, {"type": "subtitle", "time": 19638.11, "timestamp": "05:27:18", "text": "实验，我的天哪，还有我们"}, {"type": "subtitle", "time": 19640.948, "timestamp": "05:27:20", "text": "觉得穿浅色衣服也太难受了"}, {"type": "subtitle", "time": 19643.83, "timestamp": "05:27:23", "text": "不用穿厚衣服，甚至连毯子也不用。"}, {"type": "subtitle", "time": 19645.548, "timestamp": "05:27:25", "text": "甚至"}, {"type": "subtitle", "time": 19653.19, "timestamp": "05:27:33", "text": "可以用床单盖住自己，或者像其他任何东西一样。"}, {"type": "subtitle", "time": 19655.11, "timestamp": "05:27:35", "text": "就那样躺在床上"}, {"type": "subtitle", "time": 19660.35, "timestamp": "05:27:40", "text": "那。我知道，当我的……时，我忍受了这一切。"}, {"type": "subtitle", "time": 19665.03, "timestamp": "05:27:45", "text": "我当时浑身起了鸡皮疙瘩，就像……哦"}, {"type": "subtitle", "time": 19667.548, "timestamp": "05:27:47", "text": "我的天啊"}, {"type": "subtitle", "time": 19671.91, "timestamp": "05:27:51", "text": "天。哇哇哇。"}]
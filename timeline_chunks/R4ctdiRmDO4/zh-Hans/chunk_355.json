[{"type": "subtitle", "time": 21302.07, "timestamp": "05:55:02", "text": "妮娅？你不一定非得有这种感觉"}, {"type": "subtitle", "time": 21305.03, "timestamp": "05:55:05", "text": "你表演中的声音。是的，"}, {"type": "subtitle", "time": 21307.35, "timestamp": "05:55:07", "text": "纪律方面也要有所约束。而准时性是"}, {"type": "subtitle", "time": 21311.868, "timestamp": "05:55:11", "text": "我真正需要的一件关键的东西。"}, {"type": "subtitle", "time": 21313.99, "timestamp": "05:55:13", "text": "今天准时。不知何故，我"}, {"type": "subtitle", "time": 21315.628, "timestamp": "05:55:15", "text": "用了10分钟"}, {"type": "subtitle", "time": 21318.07, "timestamp": "05:55:18", "text": "早期的。提前10分钟或5分钟到达"}, {"type": "subtitle", "time": 21319.99, "timestamp": "05:55:19", "text": "溪流。那挺好的。"}, {"type": "subtitle", "time": 21321.5, "timestamp": "05:55:21", "text": "这是个加分项"}, {"type": "subtitle", "time": 21324.03, "timestamp": "05:55:24", "text": "[音乐]"}, {"type": "subtitle", "time": 21327.43, "timestamp": "05:55:27", "text": "纪律性。这个计划是什么？"}, {"type": "subtitle", "time": 21328.81, "timestamp": "05:55:28", "text": "再次？"}, {"type": "subtitle", "time": 21333.47, "timestamp": "05:55:33", "text": "[音乐]"}, {"type": "subtitle", "time": 21341.948, "timestamp": "05:55:41", "text": "疼痛。保证充足的休息。对，就是那个。"}, {"type": "subtitle", "time": 21344.948, "timestamp": "05:55:44", "text": "也。我的意思是，我本来就吃得不多。"}, {"type": "subtitle", "time": 21348.07, "timestamp": "05:55:48", "text": "所以这也是一件大事。"}, {"type": "subtitle", "time": 21351.27, "timestamp": "05:55:51", "text": "并安排时间。我的意思是，我也想融入。"}, {"type": "subtitle", "time": 21353.788, "timestamp": "05:55:53", "text": "日程安排"}, {"type": "subtitle", "time": 21357.19, "timestamp": "05:55:57", "text": "但你看，我到底算不算……"}, {"type": "subtitle", "time": 21359.15, "timestamp": "05:55:59", "text": "顺流而下"}]
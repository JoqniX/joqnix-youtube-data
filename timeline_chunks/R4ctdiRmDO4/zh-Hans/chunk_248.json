[{"type": "subtitle", "time": 14880.229, "timestamp": "04:08:00", "text": "战斗。很久很久以前，所有的"}, {"type": "subtitle", "time": 14882.07, "timestamp": "04:08:02", "text": "战士们会一秒钟。一秒钟。一"}, {"type": "subtitle", "time": 14885.03, "timestamp": "04:08:05", "text": "第二节一秒钟。一秒钟。兄弟，胡子确实……"}, {"type": "subtitle", "time": 14888.469, "timestamp": "04:08:08", "text": "科学研究。他们模拟了一个秃头。"}, {"type": "subtitle", "time": 14889.59, "timestamp": "04:08:09", "text": "我的天啊。"}, {"type": "subtitle", "time": 14891.189, "timestamp": "04:08:11", "text": "脸上略带胡茬，"}, {"type": "subtitle", "time": 14893.67, "timestamp": "04:08:13", "text": "一张长着浓密胡须的脸。和"}, {"type": "subtitle", "time": 14895.67, "timestamp": "04:08:15", "text": "他们施加相同的压力进行了测试。"}, {"type": "subtitle", "time": 14897.269, "timestamp": "04:08:17", "text": "一拳能打出的量。他们发现"}, {"type": "subtitle", "time": 14899.51, "timestamp": "04:08:19", "text": "露出那张秃脸，每一个"}, {"type": "subtitle", "time": 14901.429, "timestamp": "04:08:21", "text": "他们模拟出拳的时候，就会"}, {"type": "subtitle", "time": 14903.67, "timestamp": "04:08:23", "text": "打断下巴。使用未刮胡子的"}, {"type": "subtitle", "time": 14905.91, "timestamp": "04:08:25", "text": "一张长着浓密胡须的脸，它只是碎了。"}, {"type": "subtitle", "time": 14908.79, "timestamp": "04:08:28", "text": "45% 的时间。所以理论是，如果你"}, {"type": "subtitle", "time": 14910.79, "timestamp": "04:08:30", "text": "如果你能长胡子，你可能正在"}, {"type": "subtitle", "time": 14912.55, "timestamp": "04:08:32", "text": "祖先。这就是他们的意思。不，"}, {"type": "subtitle", "time": 14914.389, "timestamp": "04:08:34", "text": "我的错。我的错。女性不需要"}, {"type": "subtitle", "time": 14916.309, "timestamp": "04:08:36", "text": "打架是因为历史上通常是"}, {"type": "subtitle", "time": 14917.99, "timestamp": "04:08:37", "text": "那些上战场的男人们。如果你"}, {"type": "subtitle", "time": 14919.59, "timestamp": "04:08:39", "text": "不要留胡子，这可能会暴露你的秘密。"}, {"type": "subtitle", "time": 14922.63, "timestamp": "04:08:42", "text": "让你了解一些关于你祖先的事情。"}, {"type": "subtitle", "time": 14925.51, "timestamp": "04:08:45", "text": "好的，原来他们是这个意思。看看我"}, {"type": "subtitle", "time": 14928.309, "timestamp": "04:08:48", "text": "他说的却是另一回事。对不起。"}, {"type": "subtitle", "time": 14931.03, "timestamp": "04:08:51", "text": "我忘了还有血统这部分。哦，我的"}]
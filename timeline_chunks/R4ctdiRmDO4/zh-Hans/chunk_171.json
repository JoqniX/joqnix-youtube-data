[{"type": "subtitle", "time": 10261.389, "timestamp": "02:51:01", "text": "你知道我有一个"}, {"type": "subtitle", "time": 10264.349, "timestamp": "02:51:04", "text": "车轮。所以，这取决于"}, {"type": "subtitle", "time": 10267.75, "timestamp": "02:51:07", "text": "我转动轮盘，随机做一些事情"}, {"type": "subtitle", "time": 10283.59, "timestamp": "02:51:23", "text": "再次强调，应该有一款游戏，其中主要"}, {"type": "subtitle", "time": 10285.11, "timestamp": "02:51:25", "text": "角色逐渐忘记了重要的事情"}, {"type": "subtitle", "time": 10287.309, "timestamp": "02:51:27", "text": "如果你掌握了太多信息能力，就会失去信息能力。"}, {"type": "subtitle", "time": 10290.469, "timestamp": "02:51:30", "text": "长的。如果你长时间休息"}, {"type": "subtitle", "time": 10299.59, "timestamp": "02:51:39", "text": "好的。轮子上是什么？呃，一个朋友"}, {"type": "subtitle", "time": 10302.19, "timestamp": "02:51:42", "text": "我的父母给了我一份惩罚清单。"}, {"type": "subtitle", "time": 10318.389, "timestamp": "02:51:58", "text": "嗯，坐下，放松，等等，跳过一次。"}]
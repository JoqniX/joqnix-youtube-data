[{"type": "subtitle", "time": 17221.67, "timestamp": "04:47:01", "text": "主。九头蛇，你今天过得怎么样？我是说，"}, {"type": "subtitle", "time": 17224.55, "timestamp": "04:47:04", "text": "等等，我是否应该……"}, {"type": "subtitle", "time": 17228.35, "timestamp": "04:47:08", "text": "你打算继续用你的名字 Hyra 吗？你"}, {"type": "subtitle", "time": 17231.19, "timestamp": "04:47:11", "text": "对了，我有没有说过我为什么要去"}, {"type": "subtitle", "time": 17233.07, "timestamp": "04:47:13", "text": "用你的名字"}, {"type": "subtitle", "time": 17235.47, "timestamp": "04:47:15", "text": "哈齐拉？或者我真的……"}, {"type": "subtitle", "time": 17238.35, "timestamp": "04:47:18", "text": "不是？因为那件事"}, {"type": "subtitle", "time": 17241.51, "timestamp": "04:47:21", "text": "是否还有其他尤沙"}, {"type": "subtitle", "time": 17243.91, "timestamp": "04:47:23", "text": "与他同名的，Rangoku Kojiro。他们"}, {"type": "subtitle", "time": 17246.628, "timestamp": "04:47:26", "text": "也是一个大"}, {"type": "subtitle", "time": 17250.628, "timestamp": "04:47:30", "text": "呃，你知道，我是《鬼灭之刃》的粉丝。所以他们"}, {"type": "subtitle", "time": 17253.868, "timestamp": "04:47:33", "text": "用户名与"}, {"type": "subtitle", "time": 17274.948, "timestamp": "04:47:54", "text": "25日好的。我当时吓坏了。"}, {"type": "subtitle", "time": 17276.83, "timestamp": "04:47:56", "text": "一点。哦，我的"}]
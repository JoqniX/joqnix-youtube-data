[{"type": "subtitle", "time": 4566.83, "timestamp": "01:16:06", "text": "很高兴能找到我所有的朋友"}, {"type": "subtitle", "time": 4576.149, "timestamp": "01:16:16", "text": "和。每个人都走上了自己的道路。"}, {"type": "subtitle", "time": 4578.91, "timestamp": "01:16:18", "text": "猜测他们专注于自己"}, {"type": "subtitle", "time": 4582.149, "timestamp": "01:16:22", "text": "东西。减速。在某个时候，它"}, {"type": "subtitle", "time": 4584.95, "timestamp": "01:16:24", "text": "越来越难追赶，跟不上。"}, {"type": "subtitle", "time": 4606.79, "timestamp": "01:16:46", "text": "呃，我要……哦我的天哪，我要……"}, {"type": "subtitle", "time": 4608.95, "timestamp": "01:16:48", "text": "在此处崩溃。太多了。"}]
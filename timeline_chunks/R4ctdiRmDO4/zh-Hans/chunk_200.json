[{"type": "subtitle", "time": 12008.67, "timestamp": "03:20:08", "text": "响亮。好的。所以，我打算怎么做？"}, {"type": "subtitle", "time": 12021.389, "timestamp": "03:20:21", "text": "离开。我们又回到了60%、52%、50%的粉丝比例。"}, {"type": "subtitle", "time": 12024.19, "timestamp": "03:20:24", "text": "速度。虽然还在转。"}, {"type": "subtitle", "time": 12026.51, "timestamp": "03:20:26", "text": "好的。那很好"}, {"type": "subtitle", "time": 12028.71, "timestamp": "03:20:28", "text": "我认为这是一项成就。但愿如此。我不"}, {"type": "subtitle", "time": 12032.229, "timestamp": "03:20:32", "text": "知道。所以，目前我还是先保留c吧。"}, {"type": "subtitle", "time": 12035.71, "timestamp": "03:20:35", "text": "呃，侧面板"}, {"type": "subtitle", "time": 12039.469, "timestamp": "03:20:39", "text": "在。你看，帧速率已经"}, {"type": "subtitle", "time": 12046.51, "timestamp": "03:20:46", "text": "落后。"}, {"type": "subtitle", "time": 12049.99, "timestamp": "03:20:49", "text": "耶。这就是拥有它的好处"}, {"type": "subtitle", "time": 12056.309, "timestamp": "03:20:56", "text": "花费。即使有框架"}, {"type": "subtitle", "time": 12058.63, "timestamp": "03:20:58", "text": "利率波动没关系。几乎"}]
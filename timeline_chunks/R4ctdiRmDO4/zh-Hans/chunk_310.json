[{"type": "subtitle", "time": 18600.19, "timestamp": "05:10:00", "text": "为什么我的显卡会过热？"}, {"type": "subtitle", "time": 18603.83, "timestamp": "05:10:03", "text": "今天？就像真的，如果我把手伸过来"}, {"type": "subtitle", "time": 18606.55, "timestamp": "05:10:06", "text": "在背板上，它看起来像是"}, {"type": "subtitle", "time": 18609.27, "timestamp": "05:10:09", "text": "你的手像熨斗一样烫。呃，是"}, {"type": "subtitle", "time": 18611.868, "timestamp": "05:10:11", "text": "就像一声“不，不”，"}, {"type": "subtitle", "time": 18614.39, "timestamp": "05:10:14", "text": "不。你怎么认为？你呃……"}, {"type": "subtitle", "time": 18620.868, "timestamp": "05:10:20", "text": "好的。那东西叫什么？"}, {"type": "subtitle", "time": 18623.75, "timestamp": "05:10:23", "text": "再次？呃，你熨衬衫的地方"}, {"type": "subtitle", "time": 18627.23, "timestamp": "05:10:27", "text": "还有像衣服之类的东西。铁盒。"}, {"type": "subtitle", "time": 18631.51, "timestamp": "05:10:31", "text": "等待。熨斗。不。呃"}, {"type": "subtitle", "time": 18639.51, "timestamp": "05:10:39", "text": "再次？是的。所以，如果我把手放在……"}, {"type": "subtitle", "time": 18642.868, "timestamp": "05:10:42", "text": "这里，真的太……"}, {"type": "subtitle", "time": 18647.35, "timestamp": "05:10:47", "text": "天气真热。就像你把"}, {"type": "subtitle", "time": 18649.83, "timestamp": "05:10:49", "text": "就像你把手伸过去触摸一样"}, {"type": "subtitle", "time": 18653.59, "timestamp": "05:10:53", "text": "像烛光一样亮，像火一样，对吧？"}, {"type": "subtitle", "time": 18656.43, "timestamp": "05:10:56", "text": "你感受到的那种痛苦是因为……"}]
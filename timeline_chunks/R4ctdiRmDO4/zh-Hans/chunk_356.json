[{"type": "subtitle", "time": 21362.15, "timestamp": "05:56:02", "text": "日程？不，我几乎总是迟到。"}, {"type": "subtitle", "time": 21365.99, "timestamp": "05:56:05", "text": "所有流。对，也是。和"}, {"type": "subtitle", "time": 21368.75, "timestamp": "05:56:08", "text": "就像我不这样"}, {"type": "subtitle", "time": 21371.51, "timestamp": "05:56:11", "text": "知道。所以像这样的时间管理"}, {"type": "subtitle", "time": 21373.75, "timestamp": "05:56:13", "text": "我开始做一些事情和安排日程。"}, {"type": "subtitle", "time": 21377.19, "timestamp": "05:56:17", "text": "测试并尝试使用流媒体进行实验。"}, {"type": "subtitle", "time": 21378.788, "timestamp": "05:56:18", "text": "然后就没那么奏效了。所以我就想"}, {"type": "subtitle", "time": 21382.07, "timestamp": "05:56:22", "text": "担心它是否真的能像实际那样有效"}, {"type": "subtitle", "time": 21385.708, "timestamp": "05:56:25", "text": "我日常的日程安排"}, {"type": "subtitle", "time": 21389.47, "timestamp": "05:56:29", "text": "把东西塞进去，但不要把所有东西都塞进一个"}, {"type": "subtitle", "time": 21393.75, "timestamp": "05:56:33", "text": "天。嗯，我曾是忘记主要内容的奴隶。"}, {"type": "subtitle", "time": 21403.44, "timestamp": "05:56:43", "text": "是的，那也是徒劳的。"}, {"type": "subtitle", "time": 21407.67, "timestamp": "05:56:47", "text": "[音乐]"}, {"type": "subtitle", "time": 21417.67, "timestamp": "05:56:57", "text": "我。我前后摇晃着，真是的"}, {"type": "subtitle", "time": 21419.59, "timestamp": "05:56:59", "text": "去我这儿。等等，我可没在往后摇晃。"}]
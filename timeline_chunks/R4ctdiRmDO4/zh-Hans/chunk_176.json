[{"type": "subtitle", "time": 10562.87, "timestamp": "02:56:02", "text": "呃，模型需要钱，因为"}, {"type": "subtitle", "time": 10565.51, "timestamp": "02:56:05", "text": "对于较小的单位来说，这太不可能了。"}, {"type": "subtitle", "time": 10569.269, "timestamp": "02:56:09", "text": "像我这样的频道，对吧？我只会……"}, {"type": "subtitle", "time": 10572.87, "timestamp": "02:56:12", "text": "我已经说过不了，我还是……我还是……"}, {"type": "subtitle", "time": 10574.91, "timestamp": "02:56:14", "text": "兼职工作，努力工作。"}, {"type": "subtitle", "time": 10579.75, "timestamp": "02:56:19", "text": "嗯嗯，从七月起在日本努力工作。"}, {"type": "subtitle", "time": 10582.429, "timestamp": "02:56:22", "text": "从我到那里之后。前往"}, {"type": "subtitle", "time": 10584.349, "timestamp": "02:56:24", "text": "日本。但"}, {"type": "subtitle", "time": 10587.67, "timestamp": "02:56:27", "text": "嗯，让我看看。一件随机的事。哦，我的"}, {"type": "subtitle", "time": 10590.07, "timestamp": "02:56:30", "text": "天哪，我好害怕。但愿如此"}, {"type": "subtitle", "time": 10592.95, "timestamp": "02:56:32", "text": "随机的。我希望不会发生不好的事情。但"}, {"type": "subtitle", "time": 10607.309, "timestamp": "02:56:47", "text": "保持平板支撑姿势直到下一次"}, {"type": "subtitle", "time": 10609.63, "timestamp": "02:56:49", "text": "转动。"}, {"type": "subtitle", "time": 10615.75, "timestamp": "02:56:55", "text": "那？等等，是什么支撑着木板？"}, {"type": "subtitle", "time": 10617.389, "timestamp": "02:56:57", "text": "直到下一轮为止"}]
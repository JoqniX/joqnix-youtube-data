[{"type": "subtitle", "time": 10681.75, "timestamp": "02:58:01", "text": "从那里开始。呃，我想留在日本。"}, {"type": "subtitle", "time": 10683.59, "timestamp": "02:58:03", "text": "持续时间更长。所以我必须转换"}, {"type": "subtitle", "time": 10686.469, "timestamp": "02:58:06", "text": "我的签证又一次转给了学生。很多"}, {"type": "subtitle", "time": 10688.63, "timestamp": "02:58:08", "text": "事物。但是，是的，因为我没有"}, {"type": "subtitle", "time": 10690.389, "timestamp": "02:58:10", "text": "了解计划直到你的下一个"}, {"type": "subtitle", "time": 10694.07, "timestamp": "02:58:14", "text": "轮到我了，我会再免费转一次。"}, {"type": "subtitle", "time": 10702.63, "timestamp": "02:58:22", "text": "不是？你……我的天哪。什么"}, {"type": "subtitle", "time": 10706.15, "timestamp": "02:58:26", "text": "这是吗？极其危险的东西。我的天啊。"}, {"type": "subtitle", "time": 10710.75, "timestamp": "02:58:30", "text": "你见过自己吗？就像嗯……"}, {"type": "subtitle", "time": 10712.83, "timestamp": "02:58:32", "text": "在 As"}, {"type": "subtitle", "time": 10716.429, "timestamp": "02:58:36", "text": "这取决于具体问题。就像我有"}, {"type": "subtitle", "time": 10720.429, "timestamp": "02:58:40", "text": "我尿裤子了。问题"}, {"type": "subtitle", "time": 10722.67, "timestamp": "02:58:42", "text": "标记。哦"}, {"type": "subtitle", "time": 10725.87, "timestamp": "02:58:45", "text": "上帝。好的。"}, {"type": "subtitle", "time": 10729.99, "timestamp": "02:58:49", "text": "呃。我的天啊。"}, {"type": "subtitle", "time": 10733.51, "timestamp": "02:58:53", "text": "我的意思是，作为一个孩子，在漫长的岁月里"}]
[{"type": "subtitle", "time": 723.43, "timestamp": "00:12:03", "text": "再次。兄弟，兄弟，这到底是怎么回事？你需要"}, {"type": "subtitle", "time": 726.87, "timestamp": "00:12:06", "text": "5000名粉丝将使用OBS进行直播"}, {"type": "subtitle", "time": 734.389, "timestamp": "00:12:14", "text": "嗯？这段时间每天都在直播"}, {"type": "subtitle", "time": 737.31, "timestamp": "00:12:17", "text": "粉丝数达到100人就是这么回事。"}, {"type": "subtitle", "time": 740.67, "timestamp": "00:12:20", "text": "没有什么。我当时正竭尽全力去……"}, {"type": "subtitle", "time": 749.509, "timestamp": "00:12:29", "text": "我心想，这到底是怎么回事？"}, {"type": "subtitle", "time": 753.67, "timestamp": "00:12:33", "text": "平台，兄弟？兄弟，真的，真的"}, {"type": "subtitle", "time": 755.15, "timestamp": "00:12:35", "text": "什么"}, {"type": "subtitle", "time": 765.31, "timestamp": "00:12:45", "text": "比利·比利和"}, {"type": "subtitle", "time": 766.99, "timestamp": "00:12:46", "text": "他们"}, {"type": "subtitle", "time": 770.31, "timestamp": "00:12:50", "text": "哦，他们提高了要求，兄弟。"}, {"type": "subtitle", "time": 771.17, "timestamp": "00:12:51", "text": "什么？"}, {"type": "subtitle", "time": 773.71, "timestamp": "00:12:53", "text": "[音乐]"}, {"type": "subtitle", "time": 776.03, "timestamp": "00:12:56", "text": "见鬼"}, {"type": "subtitle", "time": 778.79, "timestamp": "00:12:58", "text": "什么？尊敬的先生，谢谢您。"}]
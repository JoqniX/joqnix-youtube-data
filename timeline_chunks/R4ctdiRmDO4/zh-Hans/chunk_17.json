[{"type": "subtitle", "time": 1021.67, "timestamp": "00:17:01", "text": "计时。不知道他们是否会"}, {"type": "subtitle", "time": 1023.309, "timestamp": "00:17:03", "text": "愿意"}, {"type": "subtitle", "time": 1025.63, "timestamp": "00:17:05", "text": "呃，不知道他们是否会……"}, {"type": "subtitle", "time": 1029.27, "timestamp": "00:17:09", "text": "感兴趣的。我很害怕，因为这是我的"}, {"type": "subtitle", "time": 1032.35, "timestamp": "00:17:12", "text": "首次介绍。不是第一个，"}, {"type": "subtitle", "time": 1047.35, "timestamp": "00:17:27", "text": "意思是说，我们其实聊了很多。地狱"}, {"type": "subtitle", "time": 1056.39, "timestamp": "00:17:36", "text": "嗯，我得问问。"}, {"type": "subtitle", "time": 1059.07, "timestamp": "00:17:39", "text": "如果它真的有效的话，兄弟。喜欢，"}, {"type": "subtitle", "time": 1061.75, "timestamp": "00:17:41", "text": "想象。我的天啊。我梦想成为"}, {"type": "subtitle", "time": 1063.909, "timestamp": "00:17:43", "text": "国际骑师确实有效，"}, {"type": "subtitle", "time": 1065.63, "timestamp": "00:17:45", "text": "兄弟。哦，我的"}, {"type": "subtitle", "time": 1069.19, "timestamp": "00:17:49", "text": "上帝。我必须大力宣传。我必须"}, {"type": "subtitle", "time": 1072.51, "timestamp": "00:17:52", "text": "大力宣传。实际上，这是一个很大的"}]
[{"type": "subtitle", "time": 20881.27, "timestamp": "05:48:01", "text": "是的。是的。尤其像今天这样，"}, {"type": "subtitle", "time": 20884.15, "timestamp": "05:48:04", "text": "我说“呃”这件事有多久了"}, {"type": "subtitle", "time": 20887.91, "timestamp": "05:48:07", "text": "修复 hat 命令，添加类似 a"}, {"type": "subtitle", "time": 20891.788, "timestamp": "05:48:11", "text": "拥抱指令之类的？我忘了这件事"}, {"type": "subtitle", "time": 20895.67, "timestamp": "05:48:15", "text": "它。是的，我们不希望那样。健忘"}, {"type": "subtitle", "time": 20903.03, "timestamp": "05:48:23", "text": "骑师。是的。是的。嗯，是的。呃"}, {"type": "subtitle", "time": 20904.948, "timestamp": "05:48:24", "text": "从明天开始，或者像今天这样从今天开始。"}, {"type": "subtitle", "time": 20906.19, "timestamp": "05:48:26", "text": "我会尽力"}, {"type": "subtitle", "time": 20910.67, "timestamp": "05:48:30", "text": "为了提高效率，我会尽我所能"}, {"type": "subtitle", "time": 20913.99, "timestamp": "05:48:33", "text": "好的，你们也"}, {"type": "subtitle", "time": 20917.11, "timestamp": "05:48:37", "text": "呃，谢谢你提醒我。"}, {"type": "subtitle", "time": 20920.788, "timestamp": "05:48:40", "text": "谢谢，那我们再见啦。"}, {"type": "subtitle", "time": 20923.35, "timestamp": "05:48:43", "text": "明天是为了直播还是为了其他原因？"}, {"type": "subtitle", "time": 20925.75, "timestamp": "05:48:45", "text": "如果我在 YouTube 上直播，我会直播 YouTube 流。"}, {"type": "subtitle", "time": 20929.07, "timestamp": "05:48:49", "text": "YouTube很可能就是它。"}, {"type": "subtitle", "time": 20933.07, "timestamp": "05:48:53", "text": "呃，最有可能的是《原钦影响》。"}, {"type": "subtitle", "time": 20936.39, "timestamp": "05:48:56", "text": "嗯？我尽量少看直播。"}, {"type": "subtitle", "time": 20938.548, "timestamp": "05:48:58", "text": "是的，别过度劳累。但"}]
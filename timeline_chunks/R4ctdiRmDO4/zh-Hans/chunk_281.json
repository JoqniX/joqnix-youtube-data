[{"type": "subtitle", "time": 16860.948, "timestamp": "04:41:00", "text": "会是这样吧？如果我……如果我不是"}, {"type": "subtitle", "time": 16863.83, "timestamp": "04:41:03", "text": "一个根本不会发誓的人"}, {"type": "subtitle", "time": 16866.788, "timestamp": "04:41:06", "text": "在我的直播间里，然后从……"}, {"type": "subtitle", "time": 16869.35, "timestamp": "04:41:09", "text": "其他，比如不同人的直播"}, {"type": "subtitle", "time": 16872.15, "timestamp": "04:41:12", "text": "或者就像让别人进入我的世界一样。"}, {"type": "subtitle", "time": 16874.55, "timestamp": "04:41:14", "text": "当然，我会直播，就像……"}, {"type": "subtitle", "time": 16878.23, "timestamp": "04:41:18", "text": "一条严格的规定，禁止说脏话或咒骂。"}, {"type": "subtitle", "time": 16881.19, "timestamp": "04:41:21", "text": "类似某种强烈的咒骂"}, {"type": "subtitle", "time": 16883.67, "timestamp": "04:41:23", "text": "大量脏话，比如太多"}, {"type": "subtitle", "time": 16886.868, "timestamp": "04:41:26", "text": "就是那种骂人的东西，对吧？但在这里我没有。"}, {"type": "subtitle", "time": 16888.628, "timestamp": "04:41:28", "text": "没那么做是因为我想让那个人"}, {"type": "subtitle", "time": 16889.948, "timestamp": "04:41:29", "text": "是"}, {"type": "subtitle", "time": 16893.31, "timestamp": "04:41:33", "text": "就像他们最自在的时候一样"}, {"type": "subtitle", "time": 16896.75, "timestamp": "04:41:36", "text": "舒适状态"}, {"type": "subtitle", "time": 16902.868, "timestamp": "04:41:42", "text": "种类。是的。是的。但在某种程度上，呃，就像"}, {"type": "subtitle", "time": 16904.628, "timestamp": "04:41:44", "text": "呃，他们也会知道什么话不该说。"}, {"type": "subtitle", "time": 16907.83, "timestamp": "04:41:47", "text": "以及你知道的，哪些事情不该做。"}, {"type": "subtitle", "time": 16910.31, "timestamp": "04:41:50", "text": "关于像 YouTube 之类的一切"}, {"type": "subtitle", "time": 16913.59, "timestamp": "04:41:53", "text": "比如某些你不应该说的词语"}, {"type": "subtitle", "time": 16917.03, "timestamp": "04:41:57", "text": "从某种意义上说，这一切都很好，但从某种意义上说……"}, {"type": "subtitle", "time": 16919.51, "timestamp": "04:41:59", "text": "他们会像在自己舒适的环境中一样。"}]
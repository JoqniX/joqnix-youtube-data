[{"type": "subtitle", "time": 16562.51, "timestamp": "04:36:02", "text": "那"}, {"type": "subtitle", "time": 16568.789, "timestamp": "04:36:08", "text": "你知道一些关于这个表情符号的事情，因为"}, {"type": "subtitle", "time": 16571.83, "timestamp": "04:36:11", "text": "不，我的意思是，某种程度上我想避免这种情况。"}, {"type": "subtitle", "time": 16574.39, "timestamp": "04:36:14", "text": "对吧？为了成为超级巨星"}, {"type": "subtitle", "time": 16577.07, "timestamp": "04:36:17", "text": "呃，超级"}, {"type": "subtitle", "time": 16582.23, "timestamp": "04:36:22", "text": "嗯，超级呃，这么说你必须喜欢"}, {"type": "subtitle", "time": 16585.189, "timestamp": "04:36:25", "text": "不会总有人愿意帮忙。"}, {"type": "subtitle", "time": 16588.15, "timestamp": "04:36:28", "text": "告诉你，哦，运动健将，你应该"}, {"type": "subtitle", "time": 16591.67, "timestamp": "04:36:31", "text": "没做对，或者没做对其他什么事，所以……"}, {"type": "subtitle", "time": 16593.551, "timestamp": "04:36:33", "text": "最好"}, {"type": "subtitle", "time": 16596.949, "timestamp": "04:36:36", "text": "务必了解警告或知道采取"}, {"type": "subtitle", "time": 16600.83, "timestamp": "04:36:40", "text": "采取预防措施或者自己了解一下"}, {"type": "subtitle", "time": 16603.349, "timestamp": "04:36:43", "text": "你知道吗？你应该做什么"}]
[{"type": "subtitle", "time": 8820.79, "timestamp": "02:27:00", "text": "用我的电脑。我必须准备"}, {"type": "subtitle", "time": 8823.07, "timestamp": "02:27:03", "text": "所有东西和备份"}, {"type": "subtitle", "time": 8825.309, "timestamp": "02:27:05", "text": "等等，备份"}, {"type": "subtitle", "time": 8827.67, "timestamp": "02:27:07", "text": "一切。我不能把电脑带走，"}, {"type": "subtitle", "time": 8831.71, "timestamp": "02:27:11", "text": "你知道。我必须接受所有这些"}, {"type": "subtitle", "time": 8836.51, "timestamp": "02:27:16", "text": "固态硬盘。收拾行李和东西。去"}, {"type": "subtitle", "time": 8840.83, "timestamp": "02:27:20", "text": "到月底"}, {"type": "subtitle", "time": 8845.469, "timestamp": "02:27:25", "text": "六月飞往……的航班"}, {"type": "subtitle", "time": 8848.389, "timestamp": "02:27:28", "text": "日本，希望我能，我会的，那将会是"}, {"type": "subtitle", "time": 8850.71, "timestamp": "02:27:30", "text": "太难了，这很艰难，我做不到。"}, {"type": "subtitle", "time": 8854.389, "timestamp": "02:27:34", "text": "像我现在这样直播生活"}, {"type": "subtitle", "time": 8857.19, "timestamp": "02:27:37", "text": "正确挑战 生活的挑战"}, {"type": "subtitle", "time": 8858.95, "timestamp": "02:27:38", "text": "一直生活在另一个国家"}, {"type": "subtitle", "time": 8861.67, "timestamp": "02:27:41", "text": "你自己"}, {"type": "subtitle", "time": 8863.99, "timestamp": "02:27:43", "text": "嗯，是的，我上日语课。"}, {"type": "subtitle", "time": 8866.99, "timestamp": "02:27:46", "text": "参加课程，然后是部分"}, {"type": "subtitle", "time": 8869.99, "timestamp": "02:27:49", "text": "时间。天哪，这太难了……"}, {"type": "subtitle", "time": 8872.95, "timestamp": "02:27:52", "text": "平衡我的管子，但我还要工作"}, {"type": "subtitle", "time": 8879.27, "timestamp": "02:27:59", "text": "最难。但是，呃，我停止参加 Jokathon 了。"}]
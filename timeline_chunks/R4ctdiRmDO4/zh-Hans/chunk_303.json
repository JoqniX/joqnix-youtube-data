[{"type": "subtitle", "time": 18181.07, "timestamp": "05:03:01", "text": "它。但"}, {"type": "subtitle", "time": 18184.15, "timestamp": "05:03:04", "text": "嗯，是啊，别惹任何人。对，就是那个。"}, {"type": "subtitle", "time": 18186.47, "timestamp": "05:03:06", "text": "我认为这是我们能遵守的主要规则。"}, {"type": "subtitle", "time": 18190.91, "timestamp": "05:03:10", "text": "做。经过。是的。是的。要幽默，但不要"}, {"type": "subtitle", "time": 18194.23, "timestamp": "05:03:14", "text": "尴尬的。我猜也是。是的。是的。是的。但"}, {"type": "subtitle", "time": 18196.43, "timestamp": "05:03:16", "text": "再说一遍，最重要的是"}, {"type": "subtitle", "time": 18198.52, "timestamp": "05:03:18", "text": "是 无论这里发生什么，它都会留下。"}, {"type": "subtitle", "time": 18202.16, "timestamp": "05:03:22", "text": "无论这里发生什么，它都会留下。 这里。"}, {"type": "subtitle", "time": 18210.708, "timestamp": "05:03:30", "text": "如果你看到同样的呃……就别让它们发生。"}, {"type": "subtitle", "time": 18213.51, "timestamp": "05:03:33", "text": "在 chatau 或此流中的个人"}, {"type": "subtitle", "time": 18216.708, "timestamp": "05:03:36", "text": "或者在我的聊天室里的任何直播，你都能看到"}, {"type": "subtitle", "time": 18220.788, "timestamp": "05:03:40", "text": "在其他主播的直播中看到他们。呃，别这样"}, {"type": "subtitle", "time": 18222.628, "timestamp": "05:03:42", "text": "让同样的事情在那边发生吧。"}, {"type": "subtitle", "time": 18225.67, "timestamp": "05:03:45", "text": "因为大多数其他主播都不会这么做。"}, {"type": "subtitle", "time": 18227.83, "timestamp": "05:03:47", "text": "要像我一样有耐心，也要像他们一样……"}, {"type": "subtitle", "time": 18229.19, "timestamp": "05:03:49", "text": "就像立即封禁你一样"}, {"type": "subtitle", "time": 18231.83, "timestamp": "05:03:51", "text": "某物。所以要小心这一点。"}, {"type": "subtitle", "time": 18233.43, "timestamp": "05:03:53", "text": "而且主要也别让任何人……"}]
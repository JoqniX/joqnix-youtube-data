[{"type": "subtitle", "time": 15902.59, "timestamp": "04:25:02", "text": "我的天哪，是"}, {"type": "subtitle", "time": 15905.83, "timestamp": "04:25:05", "text": "滞后。我不喜欢ASMR，但是哦，"}, {"type": "subtitle", "time": 15909.11, "timestamp": "04:25:09", "text": "角色扮演。等等，角色扮演不一样。"}, {"type": "subtitle", "time": 15910.55, "timestamp": "04:25:10", "text": "情况有所不同。等等，等等，等等。角色"}, {"type": "subtitle", "time": 15913.87, "timestamp": "04:25:13", "text": "播放ASMR。你是说像角色扮演那样吗？"}, {"type": "subtitle", "time": 15916.87, "timestamp": "04:25:16", "text": "你的哈希带之类的？有点儿"}, {"type": "subtitle", "time": 15919.03, "timestamp": "04:25:19", "text": "就像那样，对吧？就像女仆一样"}, {"type": "subtitle", "time": 15921.349, "timestamp": "04:25:21", "text": "差不多就是这样。就像走路一样"}, {"type": "subtitle", "time": 15929.95, "timestamp": "04:25:29", "text": "做那些事吗？"}, {"type": "subtitle", "time": 15947.349, "timestamp": "04:25:47", "text": "一开始我觉得有点好笑，因为他"}, {"type": "subtitle", "time": 15949.349, "timestamp": "04:25:49", "text": "替他们说，因为你知道，然后我"}, {"type": "subtitle", "time": 15950.269, "timestamp": "04:25:50", "text": "听到"}, {"type": "subtitle", "time": 15954.189, "timestamp": "04:25:54", "text": "背景中出现自行车，就像"}, {"type": "subtitle", "time": 15957.91, "timestamp": "04:25:57", "text": "是啊，这也是我为什么会这样想的原因。"}]
[{"type": "subtitle", "time": 19213.27, "timestamp": "05:20:13", "text": "铃声。对更封闭环境的恐惧症"}, {"type": "subtitle", "time": 19229.23, "timestamp": "05:20:29", "text": "这就像……"}, {"type": "subtitle", "time": 19233.11, "timestamp": "05:20:33", "text": "鼠。那是一只老鼠。我的天啊。好的，我会"}, {"type": "subtitle", "time": 19235.35, "timestamp": "05:20:35", "text": "用我的那个吧。"}, {"type": "subtitle", "time": 19238.868, "timestamp": "05:20:38", "text": "我的前视野，我的前视野，右边"}, {"type": "subtitle", "time": 19243.628, "timestamp": "05:20:43", "text": "正在观看。哦，不。顺便一提，"}, {"type": "subtitle", "time": 19248.39, "timestamp": "05:20:48", "text": "呃，我经常这么说，但是……"}, {"type": "subtitle", "time": 19251.11, "timestamp": "05:20:51", "text": "如果有些游戏能让你玩得飞起"}, {"type": "subtitle", "time": 19254.47, "timestamp": "05:20:54", "text": "或者像晕车之类的，我会"}]
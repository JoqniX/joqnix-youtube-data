[{"type": "subtitle", "time": 11641.63, "timestamp": "03:14:01", "text": "好像我不想知道"}, {"type": "subtitle", "time": 11643.55, "timestamp": "03:14:03", "text": "那就是"}, {"type": "subtitle", "time": 11651.55, "timestamp": "03:14:11", "text": "但作为独立开发者，你也能体会到其中的痛苦。"}, {"type": "subtitle", "time": 11654.429, "timestamp": "03:14:14", "text": "我说我不"}, {"type": "subtitle", "time": 11657.269, "timestamp": "03:14:17", "text": "知道上面写的是什么吗？所有党员"}, {"type": "subtitle", "time": 11660.99, "timestamp": "03:14:20", "text": "必须达到20级。"}, {"type": "subtitle", "time": 11664.309, "timestamp": "03:14:24", "text": "嗯？好的。在我们开始游戏之前，"}, {"type": "subtitle", "time": 11671.67, "timestamp": "03:14:31", "text": "不知怎么的。我如何确保我的风扇可以"}, {"type": "subtitle", "time": 11673.55, "timestamp": "03:14:33", "text": "是"}, {"type": "subtitle", "time": 11676.11, "timestamp": "03:14:36", "text": "旋转？我可以吗？"}, {"type": "subtitle", "time": 11686.91, "timestamp": "03:14:46", "text": "我该如何控制这个风扇"}, {"type": "subtitle", "time": 11690.75, "timestamp": "03:14:50", "text": "再次？确认"}, {"type": "subtitle", "time": 11693.91, "timestamp": "03:14:53", "text": "扇子。我的鼠标动不了了。我不"}, {"type": "subtitle", "time": 11697.63, "timestamp": "03:14:57", "text": "需要CPU风扇。我想要显卡"}]
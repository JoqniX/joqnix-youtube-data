[{"type": "subtitle", "time": 14825.63, "timestamp": "04:07:05", "text": "从？我忘了。那是"}, {"type": "subtitle", "time": 14829.189, "timestamp": "04:07:09", "text": "它？我想看演出。好的。这是"}, {"type": "subtitle", "time": 14831.99, "timestamp": "04:07:11", "text": "昨天。我什么时候看的？哦，我的"}, {"type": "subtitle", "time": 14833.79, "timestamp": "04:07:13", "text": "上帝。"}, {"type": "subtitle", "time": 14837.229, "timestamp": "04:07:17", "text": "好的，我觉得是在那个角度之后。"}, {"type": "subtitle", "time": 14839.59, "timestamp": "04:07:19", "text": "东西。哦，明白了。知道了。知道了。得到"}, {"type": "subtitle", "time": 14848.11, "timestamp": "04:07:28", "text": "这。我们应该看吗？"}, {"type": "subtitle", "time": 14852.63, "timestamp": "04:07:32", "text": "直播的时候发还是直接发？"}, {"type": "subtitle", "time": 14854.55, "timestamp": "04:07:34", "text": "链接是什么？"}, {"type": "subtitle", "time": 14856.07, "timestamp": "04:07:36", "text": "你知道吗？我们一起看吧。"}, {"type": "subtitle", "time": 14859.99, "timestamp": "04:07:39", "text": "是的，这是一张照片。这太疯狂了。做"}, {"type": "subtitle", "time": 14862.71, "timestamp": "04:07:42", "text": "你有没有想过为什么人类会长胡子？"}, {"type": "subtitle", "time": 14864.309, "timestamp": "04:07:44", "text": "我们有能力长出胡子，"}, {"type": "subtitle", "time": 14866.469, "timestamp": "04:07:46", "text": "正确的？有些人，他们不会成长"}, {"type": "subtitle", "time": 14868.63, "timestamp": "04:07:48", "text": "留胡须或面部毛发。亚洲人，"}, {"type": "subtitle", "time": 14870.07, "timestamp": "04:07:50", "text": "是的，一些亚洲人和女性"}, {"type": "subtitle", "time": 14871.429, "timestamp": "04:07:51", "text": "具体来说，它们实际上并不生长"}, {"type": "subtitle", "time": 14873.51, "timestamp": "04:07:53", "text": "有胡子，对吧？实际上有一个"}, {"type": "subtitle", "time": 14875.99, "timestamp": "04:07:55", "text": "面部毛发的科学用途"}, {"type": "subtitle", "time": 14877.99, "timestamp": "04:07:57", "text": "胡须，泛指胡须。这是用于近身搏斗"}]
[{"type": "subtitle", "time": 12360.15, "timestamp": "03:26:00", "text": "你打算上班后去买吗？"}, {"type": "subtitle", "time": 12363.469, "timestamp": "03:26:03", "text": "等等，这风扇停了"}, {"type": "subtitle", "time": 12367.63, "timestamp": "03:26:07", "text": "旋转。现在速度慢了。等待，"}, {"type": "subtitle", "time": 12370.309, "timestamp": "03:26:10", "text": "什么？我应该重新开始游戏吗？我认为"}, {"type": "subtitle", "time": 12372.83, "timestamp": "03:26:12", "text": "我会重新启动"}, {"type": "subtitle", "time": 12375.349, "timestamp": "03:26:15", "text": "游戏。别踢得太狠"}, {"type": "subtitle", "time": 12382.19, "timestamp": "03:26:22", "text": "第二。是的，"}, {"type": "subtitle", "time": 12389.429, "timestamp": "03:26:29", "text": "嗯，她刚才说到哪儿了？哦"}, {"type": "subtitle", "time": 12390.349, "timestamp": "03:26:30", "text": "我的"}, {"type": "subtitle", "time": 12393.03, "timestamp": "03:26:33", "text": "上帝。钱的事。我必须小心谨慎。"}, {"type": "subtitle", "time": 12396.19, "timestamp": "03:26:36", "text": "和它一起。我不应该这样花掉它。"}, {"type": "subtitle", "time": 12399.11, "timestamp": "03:26:39", "text": "那。当然，我把钱花在这些地方了"}, {"type": "subtitle", "time": 12401.63, "timestamp": "03:26:41", "text": "天。我主要把钱花在了……"}, {"type": "subtitle", "time": 12404.469, "timestamp": "03:26:44", "text": "比如直播之类的。仅限直播"}, {"type": "subtitle", "time": 12407.349, "timestamp": "03:26:47", "text": "东西，不是游戏相关的东西。"}, {"type": "subtitle", "time": 12409.19, "timestamp": "03:26:49", "text": "仅用于直播之类的东西，那就是"}, {"type": "subtitle", "time": 12410.349, "timestamp": "03:26:50", "text": "比如"}, {"type": "subtitle", "time": 12414.389, "timestamp": "03:26:54", "text": "广告，这不像你，你主要是"}, {"type": "subtitle", "time": 12416.91, "timestamp": "03:26:56", "text": "就像 Patreon 一样"}]
[{"type": "subtitle", "time": 20342.07, "timestamp": "05:39:02", "text": "今天来访。真的真的"}, {"type": "subtitle", "time": 20345.11, "timestamp": "05:39:05", "text": "意义重大。非常非常感谢。"}, {"type": "subtitle", "time": 20346.59, "timestamp": "05:39:06", "text": "真正意味着"}, {"type": "subtitle", "time": 20348.83, "timestamp": "05:39:08", "text": "很多。希望你喜欢"}, {"type": "subtitle", "time": 20351.15, "timestamp": "05:39:11", "text": "今天和"}, {"type": "subtitle", "time": 20354.43, "timestamp": "05:39:14", "text": "来访的哲学"}, {"type": "subtitle", "time": 20359.43, "timestamp": "05:39:19", "text": "嗯，今天考的是G科目考试，对吧？所以，呃"}, {"type": "subtitle", "time": 20361.31, "timestamp": "05:39:21", "text": "你完成了你的"}, {"type": "subtitle", "time": 20365.43, "timestamp": "05:39:25", "text": "最好祈祷它最终会过去。"}, {"type": "subtitle", "time": 20369.19, "timestamp": "05:39:29", "text": "嗯，诸如此类。所以别担心，你做到了。"}, {"type": "subtitle", "time": 20370.83, "timestamp": "05:39:30", "text": "尽你所能。那是"}, {"type": "subtitle", "time": 20373.35, "timestamp": "05:39:33", "text": "足够的。继续脱落和处理"}, {"type": "subtitle", "time": 20376.27, "timestamp": "05:39:36", "text": "接下来，呃，除了和东西"}, {"type": "subtitle", "time": 20379.27, "timestamp": "05:39:39", "text": "来。再次感谢你的付出。"}, {"type": "subtitle", "time": 20381.788, "timestamp": "05:39:41", "text": "尽你所能"}, {"type": "subtitle", "time": 20384.15, "timestamp": "05:39:44", "text": "蝙蝠侠。感谢您今天光临。"}, {"type": "subtitle", "time": 20390.628, "timestamp": "05:39:50", "text": "很多。我竟然忘了邀请你"}, {"type": "subtitle", "time": 20393.59, "timestamp": "05:39:53", "text": "玩Apex。啊，我看到你敞开了心扉"}, {"type": "subtitle", "time": 20396.67, "timestamp": "05:39:56", "text": "有点儿，但现在你也参与其中了。"}, {"type": "subtitle", "time": 20398.99, "timestamp": "05:39:58", "text": "手表。谢谢光临"}]
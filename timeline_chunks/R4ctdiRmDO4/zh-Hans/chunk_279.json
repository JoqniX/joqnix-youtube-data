[{"type": "subtitle", "time": 16740.07, "timestamp": "04:39:00", "text": "她本人并非如此。类似"}, {"type": "subtitle", "time": 16743.269, "timestamp": "04:39:03", "text": "那。但实际上，"}, {"type": "subtitle", "time": 16745.59, "timestamp": "04:39:05", "text": "呃，我想做真正的自己。那是"}, {"type": "subtitle", "time": 16748.51, "timestamp": "04:39:08", "text": "为什么我感觉自己像是在做真正的自己？"}, {"type": "subtitle", "time": 16750.709, "timestamp": "04:39:10", "text": "某物。是啊，因为我不喜欢。"}, {"type": "subtitle", "time": 16753.31, "timestamp": "04:39:13", "text": "所以，我不会那样做。"}, {"type": "subtitle", "time": 16766.709, "timestamp": "04:39:26", "text": "呃，我觉得几乎所有的合作项目都是如此。"}, {"type": "subtitle", "time": 16769.949, "timestamp": "04:39:29", "text": "我们在这个频道上曾出现过，"}, {"type": "subtitle", "time": 16772.47, "timestamp": "04:39:32", "text": "正确的？我们几乎所有的合作"}, {"type": "subtitle", "time": 16774.39, "timestamp": "04:39:34", "text": "有。是的。"}, {"type": "subtitle", "time": 16778.59, "timestamp": "04:39:38", "text": "我相信，每当合作发生的时候……"}, {"type": "subtitle", "time": 16781.51, "timestamp": "04:39:41", "text": "某人、教练或其他什么人，我"}, {"type": "subtitle", "time": 16783.948, "timestamp": "04:39:43", "text": "给予他们这种自由"}, {"type": "subtitle", "time": 16786.67, "timestamp": "04:39:46", "text": "我把这个给他们"}, {"type": "subtitle", "time": 16789.628, "timestamp": "04:39:49", "text": "自由"}, {"type": "subtitle", "time": 16793.27, "timestamp": "04:39:53", "text": "比如，如果他们愿意的话，因为我也想。"}, {"type": "subtitle", "time": 16798.35, "timestamp": "04:39:58", "text": "让他们更自由，你"}]
[{"type": "subtitle", "time": 9121.27, "timestamp": "02:32:01", "text": "有很多粉丝关注我们。这需要一个"}, {"type": "subtitle", "time": 9135.51, "timestamp": "02:32:15", "text": "旅行。但不要失去希望。"}, {"type": "subtitle", "time": 9138.07, "timestamp": "02:32:18", "text": "你这样做是因为你喜欢做这件事。"}, {"type": "subtitle", "time": 9141.429, "timestamp": "02:32:21", "text": "你喜欢做这件事，也想做这件事，对吗？你是"}, {"type": "subtitle", "time": 9143.19, "timestamp": "02:32:23", "text": "不是为了钱或其他什么原因，"}, {"type": "subtitle", "time": 9144.95, "timestamp": "02:32:24", "text": "正确的？你做这件事充满热情"}, {"type": "subtitle", "time": 9146.19, "timestamp": "02:32:26", "text": "事物，"}, {"type": "subtitle", "time": 9150.11, "timestamp": "02:32:30", "text": "正确的？我希望如此。是的，"}, {"type": "subtitle", "time": 9153.23, "timestamp": "02:32:33", "text": "所以，不要让那份热爱的爱好……"}, {"type": "subtitle", "time": 9154.75, "timestamp": "02:32:34", "text": "进入"}, {"type": "subtitle", "time": 9157.23, "timestamp": "02:32:37", "text": "灰尘。继续这样做。"}, {"type": "subtitle", "time": 9160.59, "timestamp": "02:32:40", "text": "总有一天它会能够"}, {"type": "subtitle", "time": 9165.75, "timestamp": "02:32:45", "text": "接触民众，他们就会支持你"}, {"type": "subtitle", "time": 9168.95, "timestamp": "02:32:48", "text": "工作。无论你慢慢地发布什么"}, {"type": "subtitle", "time": 9171.03, "timestamp": "02:32:51", "text": "会有更多人等待。"}, {"type": "subtitle", "time": 9173.91, "timestamp": "02:32:53", "text": "您可以发布内容并与之互动"}]
[{"type": "subtitle", "time": 14642.469, "timestamp": "04:04:02", "text": "然后打一拳或做一些拳击动作"}, {"type": "subtitle", "time": 14645.11, "timestamp": "04:04:05", "text": "某物。好的。就像你打拳一样"}, {"type": "subtitle", "time": 14648.87, "timestamp": "04:04:08", "text": "或者，呃，对一个成年人做点什么"}, {"type": "subtitle", "time": 14658.63, "timestamp": "04:04:18", "text": "嗯，是的，留着浓密胡子的人，呃呃"}, {"type": "subtitle", "time": 14661.429, "timestamp": "04:04:21", "text": "他们不会……不会骨折"}, {"type": "subtitle", "time": 14664.469, "timestamp": "04:04:24", "text": "比如打断下巴之类的，然后……"}, {"type": "subtitle", "time": 14666.99, "timestamp": "04:04:26", "text": "他们不能像这样，感觉影响较小或"}, {"type": "subtitle", "time": 14669.83, "timestamp": "04:04:29", "text": "某物。我不知道。我是从……那里听说的"}, {"type": "subtitle", "time": 14672.63, "timestamp": "04:04:32", "text": "这和我说话的方式不一样。"}, {"type": "subtitle", "time": 14674.55, "timestamp": "04:04:34", "text": "如果我收到视频，我会分享的。"}, {"type": "subtitle", "time": 14676.67, "timestamp": "04:04:36", "text": "把它放在"}, {"type": "subtitle", "time": 14679.03, "timestamp": "04:04:39", "text": "不和谐。是的。不管我说什么，都不要"}, {"type": "subtitle", "time": 14681.79, "timestamp": "04:04:41", "text": "拿着吧。我可能是"}, {"type": "subtitle", "time": 14684.15, "timestamp": "04:04:44", "text": "就像说一些不同的话"}]
[{"type": "subtitle", "time": 21480.708, "timestamp": "05:58:00", "text": "完全摆脱这一切？嗯，"}, {"type": "subtitle", "time": 21482.628, "timestamp": "05:58:02", "text": "当你喜欢的时候，比如度假，或者"}, {"type": "subtitle", "time": 21486.07, "timestamp": "05:58:06", "text": "如果我有个像经理那样的人，比如"}, {"type": "subtitle", "time": 21488.47, "timestamp": "05:58:08", "text": "工作人员或其他什么人来帮我"}, {"type": "subtitle", "time": 21494.15, "timestamp": "05:58:14", "text": "比如看那种动漫之类的，对吧？这"}, {"type": "subtitle", "time": 21498.31, "timestamp": "05:58:18", "text": "第二季，那个黏液不是"}, {"type": "subtitle", "time": 21501.67, "timestamp": "05:58:21", "text": "史莱姆动漫，但是"}, {"type": "subtitle", "time": 21502.51, "timestamp": "05:58:22", "text": "呃"}, {"type": "subtitle", "time": 21506.23, "timestamp": "05:58:26", "text": "就像我的情况，呃，谁得到了一只风筝？"}, {"type": "subtitle", "time": 21509.35, "timestamp": "05:58:29", "text": "他是个工作狂，而且喜欢过度劳累。"}, {"type": "subtitle", "time": 21513.19, "timestamp": "05:58:33", "text": "死了，就像得到了一只风筝，变成了一个小"}, {"type": "subtitle", "time": 21516.47, "timestamp": "05:58:36", "text": "一个小男孩，他是一名召唤师，而且可以"}, {"type": "subtitle", "time": 21521.03, "timestamp": "05:58:41", "text": "并且和很多……熟悉的人相处得很好"}, {"type": "subtitle", "time": 21524.788, "timestamp": "05:58:44", "text": "史莱姆和类似打开的东西"}, {"type": "subtitle", "time": 21528.51, "timestamp": "05:58:48", "text": "清洁店之类的。对，就是那个。"}, {"type": "subtitle", "time": 21531.868, "timestamp": "05:58:51", "text": "动漫神立之类的"}, {"type": "subtitle", "time": 21535.708, "timestamp": "05:58:55", "text": "某物。让我看看那部动画"}, {"type": "subtitle", "time": 21538.07, "timestamp": "05:58:58", "text": "姓名。你认识的人，你"}]
[{"type": "subtitle", "time": 14228.469, "timestamp": "03:57:08", "text": "皮基。不，他们把门毁了。能"}, {"type": "subtitle", "time": 14230.349, "timestamp": "03:57:10", "text": "我们就待在这里。"}, {"type": "subtitle", "time": 14253.59, "timestamp": "03:57:33", "text": "不过，不管怎样，如果我想的话"}, {"type": "subtitle", "time": 14256.51, "timestamp": "03:57:36", "text": "像比利比利那样离开"}, {"type": "subtitle", "time": 14259.03, "timestamp": "03:57:39", "text": "目前我在比利面临的问题"}, {"type": "subtitle", "time": 14261.91, "timestamp": "03:57:41", "text": "比利，"}, {"type": "subtitle", "time": 14263.83, "timestamp": "03:57:43", "text": "我需要一位中国朋友，他/她"}, {"type": "subtitle", "time": 14266.15, "timestamp": "03:57:46", "text": "愿意给我个人信息"}, {"type": "subtitle", "time": 14268.389, "timestamp": "03:57:48", "text": "提供信息以帮助像某人一样的人"}, {"type": "subtitle", "time": 14272.07, "timestamp": "03:57:52", "text": "帮帮我吧。但话说回来，这又是……"}, {"type": "subtitle", "time": 14275.189, "timestamp": "03:57:55", "text": "就像这样想："}, {"type": "subtitle", "time": 14277.83, "timestamp": "03:57:57", "text": "如果你遇到一个你不认识的人，你会怎么做？"}]
[{"type": "subtitle", "time": 10800.469, "timestamp": "03:00:00", "text": "如果我们已经达到了目标，"}, {"type": "subtitle", "time": 10803.429, "timestamp": "03:00:03", "text": "我本来可以发布一些东西的"}, {"type": "subtitle", "time": 10807.83, "timestamp": "03:00:07", "text": "设计问题在于，嗯，有一些"}, {"type": "subtitle", "time": 10811.83, "timestamp": "03:00:11", "text": "模型需要修正。"}, {"type": "subtitle", "time": 10814.55, "timestamp": "03:00:14", "text": "所以我必须完成这项更正。"}, {"type": "subtitle", "time": 10816.469, "timestamp": "03:00:16", "text": "为了完成这项正确的生产，我"}, {"type": "subtitle", "time": 10819.19, "timestamp": "03:00:19", "text": "必须按小时支付作者报酬，"}, {"type": "subtitle", "time": 10821.59, "timestamp": "03:00:21", "text": "东西，我当时没有。"}, {"type": "subtitle", "time": 10825.469, "timestamp": "03:00:25", "text": "片刻。我穷得叮当响，我穷得像个……"}, {"type": "subtitle", "time": 10828.23, "timestamp": "03:00:28", "text": "蜜蜂。是的，就是这样。此外，我"}, {"type": "subtitle", "time": 10829.91, "timestamp": "03:00:29", "text": "得先拿到许可证才行。"}, {"type": "subtitle", "time": 10832.15, "timestamp": "03:00:32", "text": "以及幕后的许多事情"}, {"type": "subtitle", "time": 10835.429, "timestamp": "03:00:35", "text": "场景。所以，这就是它如此令人头疼的原因。"}, {"type": "subtitle", "time": 10837.71, "timestamp": "03:00:37", "text": "否则，我肯定会大肆宣传的，你"}, {"type": "subtitle", "time": 10840.71, "timestamp": "03:00:40", "text": "我知道，其实还大肆宣传过。"}, {"type": "subtitle", "time": 10842.87, "timestamp": "03:00:42", "text": "这次事件。"}, {"type": "subtitle", "time": 10845.23, "timestamp": "03:00:45", "text": "可惜，事情并没有像我预想的那样发展。"}, {"type": "subtitle", "time": 10851.71, "timestamp": "03:00:51", "text": "屏幕。"}, {"type": "subtitle", "time": 10853.95, "timestamp": "03:00:53", "text": "嗯，为什么"}]
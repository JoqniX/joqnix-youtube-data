[{"type": "subtitle", "time": 14530.75, "timestamp": "04:02:10", "text": "展示。我做了什么"}, {"type": "subtitle", "time": 14532.95, "timestamp": "04:02:12", "text": "得到？我会这样想，而不是这样："}, {"type": "subtitle", "time": 14535.03, "timestamp": "04:02:15", "text": "“我们为什么不都从我这儿抢钱呢？”"}, {"type": "subtitle", "time": 14537.269, "timestamp": "04:02:17", "text": "银行账户？五五开。把它分成两半。然后你"}, {"type": "subtitle", "time": 14539.51, "timestamp": "04:02:19", "text": "可以逃跑。我会声称自己被骗了。"}, {"type": "subtitle", "time": 14543.63, "timestamp": "04:02:23", "text": "“给它买保险。”等等，什么是欺诈？"}, {"type": "subtitle", "time": 14546.11, "timestamp": "04:02:26", "text": "保险？等待，"}, {"type": "subtitle", "time": 14548.67, "timestamp": "04:02:28", "text": "什么？来"}, {"type": "subtitle", "time": 14551.59, "timestamp": "04:02:31", "text": "我当时并不知道。我感觉不太对劲"}, {"type": "subtitle", "time": 14553.82, "timestamp": "04:02:33", "text": "对这些方面很了解"}, {"type": "subtitle", "time": 14560.269, "timestamp": "04:02:40", "text": "东西。等等，我也有这种皮肤。"}, {"type": "subtitle", "time": 14562.71, "timestamp": "04:02:42", "text": "等待。哦，我不知道，我不知道。这是"}, {"type": "subtitle", "time": 14567.469, "timestamp": "04:02:47", "text": "另一个。这是"}, {"type": "subtitle", "time": 14570.269, "timestamp": "04:02:50", "text": "C. 海龙"}, {"type": "subtitle", "time": 14574.349, "timestamp": "04:02:54", "text": "东西。我有一个"}, {"type": "subtitle", "time": 14578.03, "timestamp": "04:02:58", "text": "就是这样。不，不是"}]
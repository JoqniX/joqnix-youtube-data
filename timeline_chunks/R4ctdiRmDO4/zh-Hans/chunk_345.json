[{"type": "subtitle", "time": 20702.07, "timestamp": "05:45:02", "text": "今年又来了，但我的GPO"}, {"type": "subtitle", "time": 20705.03, "timestamp": "05:45:05", "text": "这种情况让我有点害怕。"}, {"type": "subtitle", "time": 20707.59, "timestamp": "05:45:07", "text": "所以，是的，还有明天，呃，如果我们是"}, {"type": "subtitle", "time": 20710.948, "timestamp": "05:45:10", "text": "我会通过 Twitch 直播……"}, {"type": "subtitle", "time": 20714.07, "timestamp": "05:45:14", "text": "实际上，我正在直播中制作一个教程。"}, {"type": "subtitle", "time": 20717.19, "timestamp": "05:45:17", "text": "我主要是想知道，我更想知道……"}, {"type": "subtitle", "time": 20720.948, "timestamp": "05:45:20", "text": "学习并练习如何录制"}, {"type": "subtitle", "time": 20724.15, "timestamp": "05:45:24", "text": "你知道，我直播的时候还会上传视频之类的东西。"}, {"type": "subtitle", "time": 20726.39, "timestamp": "05:45:26", "text": "如果就像我录制视频一样，我会"}, {"type": "subtitle", "time": 20728.868, "timestamp": "05:45:28", "text": "就像服用它之后会比服用更多一样"}, {"type": "subtitle", "time": 20731.07, "timestamp": "05:45:31", "text": "50到60刀或"}, {"type": "subtitle", "time": 20734.07, "timestamp": "05:45:34", "text": "重考 我不想重考 我想做"}, {"type": "subtitle", "time": 20736.788, "timestamp": "05:45:36", "text": "这就是我进行直播的方式。他妈的。"}, {"type": "subtitle", "time": 20738.83, "timestamp": "05:45:38", "text": "这些都是未经证实的信息，对吧？毫无准备，"}, {"type": "subtitle", "time": 20742.35, "timestamp": "05:45:42", "text": "没计划，纯粹即兴发挥。"}, {"type": "subtitle", "time": 20745.43, "timestamp": "05:45:45", "text": "东西。我也想要同样的东西。"}, {"type": "subtitle", "time": 20748.15, "timestamp": "05:45:48", "text": "某种程度上，但又比这更好一些"}, {"type": "subtitle", "time": 20750.23, "timestamp": "05:45:50", "text": "无论是否事先编写脚本，但要知道什么"}, {"type": "subtitle", "time": 20751.99, "timestamp": "05:45:51", "text": "诸如此类的话。所以，"}, {"type": "subtitle", "time": 20754.868, "timestamp": "05:45:54", "text": "我们明天会做这件事。加，"}, {"type": "subtitle", "time": 20758.628, "timestamp": "05:45:58", "text": "我们说的任何话都像是添加到……"}]
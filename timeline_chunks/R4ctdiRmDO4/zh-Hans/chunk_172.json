[{"type": "subtitle", "time": 10320.309, "timestamp": "02:52:00", "text": "让别人轮流做，或者问问别人。"}, {"type": "subtitle", "time": 10321.91, "timestamp": "02:52:01", "text": "你选择一个问题。给某人"}, {"type": "subtitle", "time": 10324.15, "timestamp": "02:52:04", "text": "否则就是一个选择的交易。让某人"}, {"type": "subtitle", "time": 10326.63, "timestamp": "02:52:06", "text": "否则就让轮盘代替你转动。做"}, {"type": "subtitle", "time": 10328.469, "timestamp": "02:52:08", "text": "你对左边那个人的看法。"}, {"type": "subtitle", "time": 10330.63, "timestamp": "02:52:10", "text": "再转一次。找到你的明星宝石吧。告诉"}, {"type": "subtitle", "time": 10332.71, "timestamp": "02:52:12", "text": "一个玩笑。讲个谜语。你的"}, {"type": "subtitle", "time": 10334.469, "timestamp": "02:52:14", "text": "最喜欢的玩具？独特的才能是什么？"}, {"type": "subtitle", "time": 10336.71, "timestamp": "02:52:16", "text": "你有吗？你最好的朋友是谁？展示"}, {"type": "subtitle", "time": 10339.349, "timestamp": "02:52:19", "text": "在锁屏界面上。向大家展示你的"}, {"type": "subtitle", "time": 10343.83, "timestamp": "02:52:23", "text": "主屏幕。坐着，坐着，坐着，爱"}, {"type": "subtitle", "time": 10345.99, "timestamp": "02:52:25", "text": "爱你直到你哦，是的。部分"}, {"type": "subtitle", "time": 10349.71, "timestamp": "02:52:29", "text": "我做不到的事。我刚收到这个"}, {"type": "subtitle", "time": 10352.469, "timestamp": "02:52:32", "text": "网上随便找的东西。所以，我想"}, {"type": "subtitle", "time": 10354.79, "timestamp": "02:52:34", "text": "这样做。"}, {"type": "subtitle", "time": 10356.71, "timestamp": "02:52:36", "text": "你有没有暗恋过别人？告诉"}, {"type": "subtitle", "time": 10358.309, "timestamp": "02:52:38", "text": "你左边的人，你的，你的"}, {"type": "subtitle", "time": 10359.389, "timestamp": "02:52:39", "text": "压碎"}, {"type": "subtitle", "time": 10362.469, "timestamp": "02:52:42", "text": "是。接下来的两轮比赛将在小队中进行。"}, {"type": "subtitle", "time": 10370.269, "timestamp": "02:52:50", "text": "等等。天哪，这里面有太多奇怪的东西了。"}, {"type": "subtitle", "time": 10373.83, "timestamp": "02:52:53", "text": "这。我的一个朋友刚刚给了我这个"}]
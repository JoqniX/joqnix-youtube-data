[{"type": "subtitle", "time": 16081.229, "timestamp": "04:28:01", "text": "[音乐]"}, {"type": "subtitle", "time": 16084.11, "timestamp": "04:28:04", "text": "是的。斯托姆"}, {"type": "subtitle", "time": 16095.07, "timestamp": "04:28:15", "text": "是的。哦，是的。 Ro 将是"}, {"type": "subtitle", "time": 16097.99, "timestamp": "04:28:17", "text": "好的。是的。我不知道。但我不得不"}, {"type": "subtitle", "time": 16100.149, "timestamp": "04:28:20", "text": "确保它不会加载或"}, {"type": "subtitle", "time": 16104.07, "timestamp": "04:28:24", "text": "任何事物。可疑的。这是一件事。"}, {"type": "subtitle", "time": 16106.149, "timestamp": "04:28:26", "text": "我必须确保这一点，而且我还有"}, {"type": "subtitle", "time": 16109.51, "timestamp": "04:28:29", "text": "为了确保我说的每句话都像我的"}, {"type": "subtitle", "time": 16112.309, "timestamp": "04:28:32", "text": "周围环境不会被误解"}, {"type": "subtitle", "time": 16115.51, "timestamp": "04:28:35", "text": "意思是如果我的家人或其他人……"}, {"type": "subtitle", "time": 16117.99, "timestamp": "04:28:37", "text": "屋里的人都听到了，不管我是什么"}, {"type": "subtitle", "time": 16120.63, "timestamp": "04:28:40", "text": "你说完，他们会一脸懵逼，什么意思？"}, {"type": "subtitle", "time": 16124.71, "timestamp": "04:28:44", "text": "这是什么？这个笨蛋在干什么？"}, {"type": "subtitle", "time": 16126.71, "timestamp": "04:28:46", "text": "他们也这么说，他们会……"}, {"type": "subtitle", "time": 16128.429, "timestamp": "04:28:48", "text": "哦"}, {"type": "subtitle", "time": 16131.309, "timestamp": "04:28:51", "text": "不，你知道，就像"}, {"type": "subtitle", "time": 16138.75, "timestamp": "04:28:58", "text": "凉爽的。"}]
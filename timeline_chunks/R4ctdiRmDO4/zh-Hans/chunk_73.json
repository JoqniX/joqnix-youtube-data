[{"type": "subtitle", "time": 4380.43, "timestamp": "01:13:00", "text": "他本该回来的"}, {"type": "subtitle", "time": 4382.27, "timestamp": "01:13:02", "text": "流媒体？什么"}, {"type": "subtitle", "time": 4389.709, "timestamp": "01:13:09", "text": "年。已经两年了，"}, {"type": "subtitle", "time": 4393.31, "timestamp": "01:13:13", "text": "兄弟。我的在哪里？"}, {"type": "subtitle", "time": 4402.35, "timestamp": "01:13:22", "text": "年龄。我不介意玩《塔之战》。"}, {"type": "subtitle", "time": 4413.59, "timestamp": "01:13:33", "text": "他可是那些油管博主之一啊"}, {"type": "subtitle", "time": 4416.75, "timestamp": "01:13:36", "text": "积极使用Sammy streamboard和"}, {"type": "subtitle", "time": 4420.07, "timestamp": "01:13:40", "text": "东西。像我这样的人，实际上"}, {"type": "subtitle", "time": 4422.83, "timestamp": "01:13:42", "text": "想略知一二。"}, {"type": "subtitle", "time": 4429.27, "timestamp": "01:13:49", "text": "流媒体。他过去常常自己制作"}, {"type": "subtitle", "time": 4431.83, "timestamp": "01:13:51", "text": "小部件、其他东西、OP动画等等"}, {"type": "subtitle", "time": 4434.55, "timestamp": "01:13:54", "text": "一切。"}, {"type": "subtitle", "time": 4436.149, "timestamp": "01:13:56", "text": "有很多触发按钮，"}, {"type": "subtitle", "time": 4439.91, "timestamp": "01:13:59", "text": "有很多事情要做。我很高兴有人"}]
[{"type": "subtitle", "time": 21601.91, "timestamp": "06:00:01", "text": "喜欢那种感觉，而且不喜欢"}, {"type": "subtitle", "time": 21602.83, "timestamp": "06:00:02", "text": "你"}, {"type": "subtitle", "time": 21605.51, "timestamp": "06:00:05", "text": "我知道这样做是为了完成它。"}, {"type": "subtitle", "time": 21608.11, "timestamp": "06:00:08", "text": "或者别的什么。我不知道。所以，或者"}, {"type": "subtitle", "time": 21612.15, "timestamp": "06:00:12", "text": "某种东西，但我不知道。我当时就想，h"}, {"type": "subtitle", "time": 21614.15, "timestamp": "06:00:14", "text": "是的，最好不要寻求帮助。"}, {"type": "subtitle", "time": 21626.708, "timestamp": "06:00:26", "text": "因为我对比利也有同样的感觉。"}, {"type": "subtitle", "time": 21629.35, "timestamp": "06:00:29", "text": "比利的情况也是如此。"}, {"type": "subtitle", "time": 21630.19, "timestamp": "06:00:30", "text": "喜欢"}, {"type": "subtitle", "time": 21633.19, "timestamp": "06:00:33", "text": "我当时是如何询问和依赖其他人的呢？"}, {"type": "subtitle", "time": 21636.23, "timestamp": "06:00:36", "text": "有人帮助我等等，尽管"}, {"type": "subtitle", "time": 21638.67, "timestamp": "06:00:38", "text": "他们忙于其他事情。"}, {"type": "subtitle", "time": 21641.948, "timestamp": "06:00:41", "text": "一切。我是"}, {"type": "subtitle", "time": 21644.51, "timestamp": "06:00:44", "text": "感觉我就像某人"}, {"type": "subtitle", "time": 21655.868, "timestamp": "06:00:55", "text": "感觉啊，我也感觉到了。"}, {"type": "subtitle", "time": 21659.35, "timestamp": "06:00:59", "text": "我多么希望摆脱这种令人不安的感觉"}]
[{"type": "subtitle", "time": 7800.99, "timestamp": "02:10:00", "text": "她很勤奋"}, {"type": "subtitle", "time": 7804.39, "timestamp": "02:10:04", "text": "人。她在现实生活中也有自己的生活。她正在做"}, {"type": "subtitle", "time": 7808.55, "timestamp": "02:10:08", "text": "她喜欢在YouTube上做视频，纯粹是为了好玩。"}, {"type": "subtitle", "time": 7811.87, "timestamp": "02:10:11", "text": "她做什么。"}, {"type": "subtitle", "time": 7814.95, "timestamp": "02:10:14", "text": "如果人们这样做，比如"}, {"type": "subtitle", "time": 7815.95, "timestamp": "02:10:15", "text": "那"}, {"type": "subtitle", "time": 7819.069, "timestamp": "02:10:19", "text": "等等，就像……"}, {"type": "chat", "time": 7822.073, "timestamp": "02:10:22", "author": "@Anti-SpiritArt", "avatar": "https://yt4.ggpht.com/wYaIbwf481rN5bfgaxWnbUoh-faRynKzhqgZXK5WIvlx9DlMJJl0M6boNmqYwDkmuSY99pM-=s64-c-k-c0x00ffffff-no-rj", "message": "yeah definatlly"}, {"type": "subtitle", "time": 7822.149, "timestamp": "02:10:22", "text": "开玩笑，但不是每个人都能开得起玩笑。不，"}, {"type": "subtitle", "time": 7825.31, "timestamp": "02:10:25", "text": "每个人都是"}, {"type": "subtitle", "time": 7827.589, "timestamp": "02:10:27", "text": "不同的。看着我。我不能"}, {"type": "subtitle", "time": 7832.149, "timestamp": "02:10:32", "text": "能听懂笑话。我很重视这件事。"}, {"type": "subtitle", "time": 7835.99, "timestamp": "02:10:35", "text": "就像《比利恶霸》里的某个人一样"}, {"type": "subtitle", "time": 7839.669, "timestamp": "02:10:39", "text": "呃，之前说过，就像你到底是不是……"}, {"type": "subtitle", "time": 7841.709, "timestamp": "02:10:41", "text": "饮用干净的水"}, {"type": "subtitle", "time": 7845.589, "timestamp": "02:10:45", "text": "印度？你最近怎么样？我"}, {"type": "subtitle", "time": 7848.069, "timestamp": "02:10:48", "text": "兄弟，你认真对待这件事了。我甚至不知道"}, {"type": "subtitle", "time": 7851.27, "timestamp": "02:10:51", "text": "如果这是个玩笑。不过我还是不明白。"}, {"type": "subtitle", "time": 7853.31, "timestamp": "02:10:53", "text": "尽管他说那只是个玩笑。"}, {"type": "subtitle", "time": 7856.39, "timestamp": "02:10:56", "text": "但我当时想，是啊，那里很干净。"}, {"type": "subtitle", "time": 7858.31, "timestamp": "02:10:58", "text": "印度的水资源。我不明白，我不明白"}]
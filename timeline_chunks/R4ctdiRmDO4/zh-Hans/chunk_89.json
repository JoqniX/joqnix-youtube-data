[{"type": "subtitle", "time": 5343.149, "timestamp": "01:29:03", "text": "别担心，笨蛋。不"}, {"type": "subtitle", "time": 5347.87, "timestamp": "01:29:07", "text": "担心。没关系。你看，如果我不是"}, {"type": "subtitle", "time": 5352.59, "timestamp": "01:29:12", "text": "像这样直播的话，我本来会……"}, {"type": "subtitle", "time": 5357.03, "timestamp": "01:29:17", "text": "就像我会私信你之类的。我"}, {"type": "subtitle", "time": 5359.03, "timestamp": "01:29:19", "text": "本来打算私信我的。然后我"}, {"type": "subtitle", "time": 5361.55, "timestamp": "01:29:21", "text": "比如，“是啊，也许她可能有……”"}, {"type": "subtitle", "time": 5380.95, "timestamp": "01:29:40", "text": "嗯，所以，简单来说，就像当你"}, {"type": "subtitle", "time": 5383.229, "timestamp": "01:29:43", "text": "遭遇"}, {"type": "subtitle", "time": 5385.83, "timestamp": "01:29:45", "text": "挑战，或者像某种想法之类的"}, {"type": "subtitle", "time": 5394.59, "timestamp": "01:29:54", "text": "它对我的影响是什么？"}, {"type": "subtitle", "time": 5398.27, "timestamp": "01:29:58", "text": "受影响的和东西"}]
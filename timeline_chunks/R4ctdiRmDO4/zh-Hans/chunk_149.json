[{"type": "subtitle", "time": 8940.51, "timestamp": "02:29:00", "text": "事物。"}, {"type": "subtitle", "time": 8950.309, "timestamp": "02:29:10", "text": "问题是，呃，我这么做的原因是……"}, {"type": "subtitle", "time": 8954.51, "timestamp": "02:29:14", "text": "限制观众参与直播是"}, {"type": "subtitle", "time": 8958.91, "timestamp": "02:29:18", "text": "因为我曾有过一段糟糕的经历，很久以前就经历过了。"}, {"type": "subtitle", "time": 8960.99, "timestamp": "02:29:20", "text": "后退"}, {"type": "subtitle", "time": 8964.71, "timestamp": "02:29:24", "text": "所以，嗯，我同意放手。"}, {"type": "subtitle", "time": 8966.55, "timestamp": "02:29:26", "text": "喜欢和人一起玩的人"}, {"type": "subtitle", "time": 8970.309, "timestamp": "02:29:30", "text": "还有其他一些事，但就是因为那件坏事。"}, {"type": "subtitle", "time": 8972.23, "timestamp": "02:29:32", "text": "过去发生的一些事，我感觉就像……"}, {"type": "subtitle", "time": 8974.349, "timestamp": "02:29:34", "text": "真的"}, {"type": "subtitle", "time": 8978.71, "timestamp": "02:29:38", "text": "谨慎，但我持开放态度"}, {"type": "subtitle", "time": 8981.83, "timestamp": "02:29:41", "text": "嗯，合作之类的。我记得什么"}, {"type": "subtitle", "time": 8983.15, "timestamp": "02:29:43", "text": "你说。"}, {"type": "subtitle", "time": 8986.55, "timestamp": "02:29:46", "text": "是的，我今天还谈到了这件事。嗯"}, {"type": "subtitle", "time": 8991.51, "timestamp": "02:29:51", "text": "有点像，呃，当我的一个朋友呃"}]
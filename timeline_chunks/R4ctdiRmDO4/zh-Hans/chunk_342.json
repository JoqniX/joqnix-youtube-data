[{"type": "subtitle", "time": 20520.67, "timestamp": "05:42:00", "text": "那"}, {"type": "subtitle", "time": 20524.788, "timestamp": "05:42:04", "text": "很多。呃，因为我的优先事项是……"}, {"type": "subtitle", "time": 20529.27, "timestamp": "05:42:09", "text": "一直都在，因为最后你知道的"}, {"type": "subtitle", "time": 20531.43, "timestamp": "05:42:11", "text": "嗯，最后你知道我想要"}, {"type": "subtitle", "time": 20534.39, "timestamp": "05:42:14", "text": "工作、喜欢做这件事、专注于这件事"}, {"type": "subtitle", "time": 20537.83, "timestamp": "05:42:17", "text": "但是，我还有其他事情要做。"}, {"type": "subtitle", "time": 20540.948, "timestamp": "05:42:20", "text": "尤其像现在这样"}, {"type": "subtitle", "time": 20542.788, "timestamp": "05:42:22", "text": "你知道我不能直播"}, {"type": "subtitle", "time": 20546.868, "timestamp": "05:42:26", "text": "昨晚我们，我相信我保留了"}, {"type": "subtitle", "time": 20550.31, "timestamp": "05:42:30", "text": "下午3点开始六七岁"}, {"type": "subtitle", "time": 20555.75, "timestamp": "05:42:35", "text": "最多八个就结束了，这样我就可以……"}, {"type": "subtitle", "time": 20557.51, "timestamp": "05:42:37", "text": "别再像我能结束这一切一样了"}, {"type": "subtitle", "time": 20560.15, "timestamp": "05:42:40", "text": "在我像所有人一样直播之前"}, {"type": "subtitle", "time": 20563.868, "timestamp": "05:42:43", "text": "家人不断打断我的谈话，简直是垃圾邮件。"}, {"type": "subtitle", "time": 20568.43, "timestamp": "05:42:48", "text": "是啊，但我认为我可能不行。"}, {"type": "subtitle", "time": 20572.628, "timestamp": "05:42:52", "text": "坚持更长时间。我有"}, {"type": "subtitle", "time": 20576.708, "timestamp": "05:42:56", "text": "结束直播之类的，但也像如果"}, {"type": "subtitle", "time": 20579.99, "timestamp": "05:42:59", "text": "我被责骂了，或者就像，如果我是呃……"}]
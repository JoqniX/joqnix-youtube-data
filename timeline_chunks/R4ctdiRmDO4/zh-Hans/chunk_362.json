[{"type": "subtitle", "time": 21721.47, "timestamp": "06:02:01", "text": "他们有点像，是的，帮助他们，帮助"}, {"type": "subtitle", "time": 21724.548, "timestamp": "06:02:04", "text": "我和他们真的非常专注于我的事情"}, {"type": "subtitle", "time": 21727.03, "timestamp": "06:02:07", "text": "直到我帮他们做完这些事为止"}, {"type": "subtitle", "time": 21728.75, "timestamp": "06:02:08", "text": "的"}, {"type": "subtitle", "time": 21735.15, "timestamp": "06:02:15", "text": "不。是的。是的。是的。"}, {"type": "subtitle", "time": 21737.99, "timestamp": "06:02:17", "text": "是的。差不多是这样。然后你"}, {"type": "subtitle", "time": 21739.07, "timestamp": "06:02:19", "text": "应该问"}, {"type": "subtitle", "time": 21743.68, "timestamp": "06:02:23", "text": "他们。啊，但我感觉就像"}, {"type": "subtitle", "time": 21750.87, "timestamp": "06:02:30", "text": "担心。我不知道。"}, {"type": "subtitle", "time": 21752.07, "timestamp": "06:02:32", "text": "[音乐]"}, {"type": "subtitle", "time": 21754.788, "timestamp": "06:02:34", "text": "关键在于，他们应该这样做，或者"}, {"type": "subtitle", "time": 21756.708, "timestamp": "06:02:36", "text": "如果他们认为自己可以不寻求你的帮助，他们就不会向你寻求帮助"}, {"type": "subtitle", "time": 21761.27, "timestamp": "06:02:41", "text": "他们正在欺负你。呃，我不知道。我"}, {"type": "subtitle", "time": 21763.31, "timestamp": "06:02:43", "text": "意思是这件事"}, {"type": "subtitle", "time": 21766.47, "timestamp": "06:02:46", "text": "大多数人认为乔很忙。"}, {"type": "subtitle", "time": 21769.43, "timestamp": "06:02:49", "text": "他什么都懂，而且好像他也在谈论这些。"}, {"type": "subtitle", "time": 21772.15, "timestamp": "06:02:52", "text": "忙碌的事情，忙碌的人，以及其他事情"}, {"type": "subtitle", "time": 21775.75, "timestamp": "06:02:55", "text": "他们避而不问，我就纳闷为什么。"}, {"type": "subtitle", "time": 21778.23, "timestamp": "06:02:58", "text": "瓦卡？你为什么不向我寻求帮助？"}, {"type": "subtitle", "time": 21779.788, "timestamp": "06:02:59", "text": "有点儿"}]
[{"type": "subtitle", "time": 12665.99, "timestamp": "03:31:05", "text": "男生。但是，最近到底发生了什么事呢？"}, {"type": "subtitle", "time": 12668.15, "timestamp": "03:31:08", "text": "这种情况到处都在发生？就像我一直都是这样"}, {"type": "subtitle", "time": 12671.55, "timestamp": "03:31:11", "text": "错过了很多"}, {"type": "subtitle", "time": 12693.429, "timestamp": "03:31:33", "text": "但现在也一样，对吧？做"}, {"type": "subtitle", "time": 12695.309, "timestamp": "03:31:35", "text": "你觉得我怎么样？"}, {"type": "subtitle", "time": 12698.229, "timestamp": "03:31:38", "text": "说？我觉得我需要练习一下"}, {"type": "subtitle", "time": 12700.03, "timestamp": "03:31:40", "text": "我的谈话"}, {"type": "subtitle", "time": 12703.19, "timestamp": "03:31:43", "text": "东西。我好像不太擅长说话。"}, {"type": "subtitle", "time": 12705.95, "timestamp": "03:31:45", "text": "溪流。我感觉自己像个沉默的人。那是"}, {"type": "subtitle", "time": 12709.349, "timestamp": "03:31:49", "text": "坏的。我需要想出一个“哦，等等”。"}, {"type": "subtitle", "time": 12719.99, "timestamp": "03:31:59", "text": "正如我刚才所说，我需要上来。我"}]
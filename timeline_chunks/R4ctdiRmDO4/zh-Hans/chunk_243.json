[{"type": "subtitle", "time": 14581.349, "timestamp": "04:03:01", "text": "这。不是这个。这个。哦，看起来"}, {"type": "subtitle", "time": 14583.389, "timestamp": "04:03:03", "text": "相同。好的，是一样的，但是"}, {"type": "subtitle", "time": 14586.15, "timestamp": "04:03:06", "text": "不同的。这是《亚特兰蒂斯守护者》。"}, {"type": "subtitle", "time": 14588.429, "timestamp": "04:03:08", "text": "还有另一个"}, {"type": "subtitle", "time": 14591.349, "timestamp": "04:03:11", "text": "这是什么？火。它看起来像"}, {"type": "subtitle", "time": 14594.15, "timestamp": "04:03:14", "text": "头。头部的部件是一样的。他们"}, {"type": "subtitle", "time": 14596.79, "timestamp": "04:03:16", "text": "用头。同一个头。龙头"}, {"type": "subtitle", "time": 14597.71, "timestamp": "04:03:17", "text": "或者"}, {"type": "subtitle", "time": 14601.79, "timestamp": "04:03:21", "text": "虽然有点相似，但又有所不同。"}, {"type": "subtitle", "time": 14603.75, "timestamp": "04:03:23", "text": "好的。我不知道。必须有"}, {"type": "subtitle", "time": 14607.229, "timestamp": "04:03:27", "text": "保险或物品"}, {"type": "subtitle", "time": 14610.15, "timestamp": "04:03:30", "text": "又是骗局。哦，那个"}, {"type": "subtitle", "time": 14618.07, "timestamp": "04:03:38", "text": "好的。哦，黎恩有胡子。我的天啊。"}, {"type": "subtitle", "time": 14621.469, "timestamp": "04:03:41", "text": "瞧瞧那胡子。"}, {"type": "subtitle", "time": 14625.55, "timestamp": "04:03:45", "text": "哇。哦，是的。我看了些"}, {"type": "subtitle", "time": 14629.389, "timestamp": "04:03:49", "text": "某处有人这么说，你"}, {"type": "subtitle", "time": 14633.349, "timestamp": "04:03:53", "text": "知道，如果你用拳头或棍子打人，"}, {"type": "subtitle", "time": 14636.79, "timestamp": "04:03:56", "text": "比如没有胡子，他们就有机会"}, {"type": "subtitle", "time": 14639.229, "timestamp": "04:03:59", "text": "打断他们的下巴或"}]
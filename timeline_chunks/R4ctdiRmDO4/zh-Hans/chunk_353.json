[{"type": "subtitle", "time": 21182.91, "timestamp": "05:53:02", "text": "片刻。是什么"}, {"type": "subtitle", "time": 21186.07, "timestamp": "05:53:06", "text": "有趣的？我不知道。而且，再一次，"}, {"type": "subtitle", "time": 21200.07, "timestamp": "05:53:20", "text": "马鲁基。很多人都说骑师"}, {"type": "subtitle", "time": 21202.788, "timestamp": "05:53:22", "text": "他们杀了她。连喵喵叫声也一样。很多"}, {"type": "subtitle", "time": 21208.39, "timestamp": "05:53:28", "text": "我和其他人都心不在焉，根本没在听。甚至"}, {"type": "subtitle", "time": 21211.51, "timestamp": "05:53:31", "text": "家人也在听，但我没听。我知道"}, {"type": "subtitle", "time": 21214.27, "timestamp": "05:53:34", "text": "这件事不会结束"}, {"type": "subtitle", "time": 21217.91, "timestamp": "05:53:37", "text": "嗯，我已经体验过了。"}, {"type": "subtitle", "time": 21221.19, "timestamp": "05:53:41", "text": "就像一个场景，以及梦想着它如何发生"}, {"type": "subtitle", "time": 21225.75, "timestamp": "05:53:45", "text": "如果有一天没有……那会是什么样子？"}, {"type": "subtitle", "time": 21229.11, "timestamp": "05:53:49", "text": "能够直播或喜欢起床时刻或"}, {"type": "subtitle", "time": 21230.628, "timestamp": "05:53:50", "text": "某物。我有点害怕。"}, {"type": "subtitle", "time": 21233.91, "timestamp": "05:53:53", "text": "但我现在有的时间，我还是会去做。"}, {"type": "subtitle", "time": 21236.15, "timestamp": "05:53:56", "text": "我想应该充分利用它。我"}, {"type": "subtitle", "time": 21237.15, "timestamp": "05:53:57", "text": "我觉得我不这么认为"}]
[{"type": "subtitle", "time": 16628.15, "timestamp": "04:37:08", "text": "我和约翰，我知道，但这并不意味着我"}, {"type": "subtitle", "time": 16670.629, "timestamp": "04:37:50", "text": "国王。我不是国王。哦，我只是你的"}, {"type": "subtitle", "time": 16671.949, "timestamp": "04:37:51", "text": "普通的"}, {"type": "subtitle", "time": 16674.029, "timestamp": "04:37:54", "text": "喜悦。我不是"}, {"type": "subtitle", "time": 16677.629, "timestamp": "04:37:57", "text": "国王。不，你是国王。"}]
[{"type": "subtitle", "time": 12490.389, "timestamp": "03:28:10", "text": "含义。"}, {"type": "subtitle", "time": 12492.389, "timestamp": "03:28:12", "text": "是的。是的。是的。就像我一样，我也是。"}, {"type": "subtitle", "time": 12494.55, "timestamp": "03:28:14", "text": "我不能谈论这件事，因为我是某人"}, {"type": "subtitle", "time": 12496.469, "timestamp": "03:28:16", "text": "真正花钱玩这款游戏的人"}, {"type": "subtitle", "time": 12499.71, "timestamp": "03:28:19", "text": "我说过我永远不会花钱"}, {"type": "subtitle", "time": 12501.63, "timestamp": "03:28:21", "text": "那是"}, {"type": "subtitle", "time": 12520.349, "timestamp": "03:28:40", "text": "片刻。是的。"}, {"type": "subtitle", "time": 12531.51, "timestamp": "03:28:51", "text": "疼痛。嗯，不过我觉得它挺可爱的。"}]
[{"type": "subtitle", "time": 13502.309, "timestamp": "03:45:02", "text": "或晚上 11 点我玩了几场战斗"}, {"type": "subtitle", "time": 13504.55, "timestamp": "03:45:04", "text": "比赛和喜欢"}, {"type": "subtitle", "time": 13508.11, "timestamp": "03:45:08", "text": "呃，他似乎很满意之类的。"}, {"type": "subtitle", "time": 13511.11, "timestamp": "03:45:11", "text": "试试玩玩看。不，不。尝试"}, {"type": "subtitle", "time": 13513.07, "timestamp": "03:45:13", "text": "睡觉，我"}, {"type": "subtitle", "time": 13516.309, "timestamp": "03:45:16", "text": "睡着了。我看到我看到自己醒来"}, {"type": "subtitle", "time": 13518.469, "timestamp": "03:45:18", "text": "凌晨3点，我睡不着。我当时想，"}, {"type": "subtitle", "time": 13520.55, "timestamp": "03:45:20", "text": "“是啊，我就继续相信，继续看下去吧。”"}, {"type": "subtitle", "time": 13523.429, "timestamp": "03:45:23", "text": "一些视频之类的，帮我升级，"}, {"type": "subtitle", "time": 13526.269, "timestamp": "03:45:26", "text": "研磨物"}, {"type": "subtitle", "time": 13530.75, "timestamp": "03:45:30", "text": "“提升水平。” 所以，我做了那些事，等等。"}, {"type": "subtitle", "time": 13535.469, "timestamp": "03:45:35", "text": "哇，你知道吗，我当时就想，"}, {"type": "subtitle", "time": 13538.309, "timestamp": "03:45:38", "text": "“是啊，你知道吗？我应该就这么走了吗？”"}, {"type": "subtitle", "time": 13541.349, "timestamp": "03:45:41", "text": "在Twitch上直播，做些其他事？"}, {"type": "subtitle", "time": 13543.59, "timestamp": "03:45:43", "text": "某种程度上，我想现场录制下来。"}, {"type": "subtitle", "time": 13545.95, "timestamp": "03:45:45", "text": "该教程的视频"}, {"type": "subtitle", "time": 13549.349, "timestamp": "03:45:49", "text": "那玩意儿，我可能永远都不会带它。"}, {"type": "subtitle", "time": 13553.51, "timestamp": "03:45:53", "text": "把它展示出来，就像把它现场直播一样。这是为了"}, {"type": "subtitle", "time": 13556.309, "timestamp": "03:45:56", "text": "就像几个朋友之类的。我 我"}, {"type": "subtitle", "time": 13558.07, "timestamp": "03:45:58", "text": "考虑保持未公开状态"}]
[{"type": "subtitle", "time": 4860.79, "timestamp": "01:21:00", "text": "可以做到。你可以做到，因为我就是。"}, {"type": "subtitle", "time": 4865.11, "timestamp": "01:21:05", "text": "我把早晨、傍晚和下午作为……"}, {"type": "subtitle", "time": 4867.99, "timestamp": "01:21:07", "text": "本月免费名额。所以，我很友善。"}, {"type": "subtitle", "time": 4871.07, "timestamp": "01:21:11", "text": "试图让人们填写那份表格"}, {"type": "subtitle", "time": 4874.07, "timestamp": "01:21:14", "text": "如果它们可用且免费，那就最好是斑点状的。"}, {"type": "subtitle", "time": 4876.79, "timestamp": "01:21:16", "text": "因为现在大多数人都喜欢晚上睡觉。所以，"}, {"type": "subtitle", "time": 4881.03, "timestamp": "01:21:21", "text": "房间很快就订满了。"}, {"type": "subtitle", "time": 4883.75, "timestamp": "01:21:23", "text": "还有七八个人。"}, {"type": "subtitle", "time": 4887.43, "timestamp": "01:21:27", "text": "仍在待处理名单中的人员"}, {"type": "subtitle", "time": 4890.03, "timestamp": "01:21:30", "text": "尚未证实"}, {"type": "subtitle", "time": 4893.35, "timestamp": "01:21:33", "text": "然而。最搞笑的是，我还在补充"}, {"type": "subtitle", "time": 4896.63, "timestamp": "01:21:36", "text": "很多人在帮助很多人。"}, {"type": "subtitle", "time": 4898.709, "timestamp": "01:21:38", "text": "感觉到现在我都快没日子可过了。"}, {"type": "subtitle", "time": 4900.669, "timestamp": "01:21:40", "text": "合作"}, {"type": "subtitle", "time": 4903.55, "timestamp": "01:21:43", "text": "代表我"}, {"type": "subtitle", "time": 4906.03, "timestamp": "01:21:46", "text": "考试代表英国"}, {"type": "subtitle", "time": 4909.51, "timestamp": "01:21:49", "text": "西方文学所有诗歌"}, {"type": "subtitle", "time": 4911.79, "timestamp": "01:21:51", "text": "东西"}, {"type": "subtitle", "time": 4917.149, "timestamp": "01:21:57", "text": "你要求我做的一切，你到底想让我做什么？"}]
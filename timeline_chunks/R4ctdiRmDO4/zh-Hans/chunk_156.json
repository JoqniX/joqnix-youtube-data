[{"type": "subtitle", "time": 9389.469, "timestamp": "02:36:29", "text": "[音乐]"}, {"type": "subtitle", "time": 9392.79, "timestamp": "02:36:32", "text": "是啊，兄弟。我想念"}, {"type": "subtitle", "time": 9395.91, "timestamp": "02:36:35", "text": "呃，我想念……是的，我是个印度人。"}, {"type": "subtitle", "time": 9404.91, "timestamp": "02:36:44", "text": "乔克尼斯，我的确和瓦顿斯谈过了。"}, {"type": "subtitle", "time": 9407.27, "timestamp": "02:36:47", "text": "一次。我不知道我是否合作过"}]
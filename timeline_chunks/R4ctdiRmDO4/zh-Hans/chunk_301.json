[{"type": "subtitle", "time": 18105.67, "timestamp": "05:01:45", "text": "我的游戏。我的天啊。你看到了。"}, {"type": "subtitle", "time": 18107.47, "timestamp": "05:01:47", "text": "男人。并非如此"}, {"type": "subtitle", "time": 18110.39, "timestamp": "05:01:50", "text": "帮忙。这是否意味着我无法玩游戏"}, {"type": "subtitle", "time": 18116.35, "timestamp": "05:01:56", "text": "还有吗？哦"}, {"type": "subtitle", "time": 18118.948, "timestamp": "05:01:58", "text": "不。我余生，其余的都是"}]
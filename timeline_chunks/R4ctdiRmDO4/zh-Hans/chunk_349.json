[{"type": "subtitle", "time": 20941.75, "timestamp": "05:49:01", "text": "不过，我还是需要一份工作。但是就像"}, {"type": "subtitle", "time": 20945.628, "timestamp": "05:49:05", "text": "24小时不间断流媒体播放不会是"}, {"type": "subtitle", "time": 20949.23, "timestamp": "05:49:09", "text": "足够的。我还有其他事情要做，"}, {"type": "subtitle", "time": 20952.83, "timestamp": "05:49:12", "text": "正确的？我心想，啊，天哪，我希望他们全都"}, {"type": "subtitle", "time": 20956.708, "timestamp": "05:49:16", "text": "比如时间更充裕之类的。这"}, {"type": "subtitle", "time": 20958.868, "timestamp": "05:49:18", "text": "时间就像滴答滴答地流逝。我当时就想，"}, {"type": "subtitle", "time": 20961.67, "timestamp": "05:49:21", "text": "呃，但是，就像这两条溪流一样"}, {"type": "subtitle", "time": 20963.35, "timestamp": "05:49:23", "text": "而且 YouTube 直播不一定非得如此"}, {"type": "subtitle", "time": 20966.23, "timestamp": "05:49:26", "text": "但每天都是如此。我不知道为什么。嗯，"}, {"type": "subtitle", "time": 20970.11, "timestamp": "05:49:30", "text": "我感觉自己像是在一次性完成所有事情。"}, {"type": "subtitle", "time": 20973.59, "timestamp": "05:49:33", "text": "一天，就像一天之内两条溪流汇聚成一瞬。"}, {"type": "subtitle", "time": 20976.15, "timestamp": "05:49:36", "text": "当然，我确信如果比利比利"}, {"type": "subtitle", "time": 20979.51, "timestamp": "05:49:39", "text": "确实如此，比利，但如果我们……"}, {"type": "subtitle", "time": 20981.75, "timestamp": "05:49:41", "text": "能够在 Billy Billy 上播放，右边是"}, {"type": "subtitle", "time": 20983.51, "timestamp": "05:49:43", "text": "当然，我会说，是啊，你知道的。"}, {"type": "subtitle", "time": 20985.83, "timestamp": "05:49:45", "text": "什么？一天三场直播，那就是"}, {"type": "subtitle", "time": 20988.948, "timestamp": "05:49:48", "text": "好的。差不多是这样。"}, {"type": "subtitle", "time": 20991.11, "timestamp": "05:49:51", "text": "我大概知道我会在什么时候。"}, {"type": "subtitle", "time": 20995.19, "timestamp": "05:49:55", "text": "为信徒而设"}, {"type": "subtitle", "time": 20999.99, "timestamp": "05:49:59", "text": "大概是凌晨四五点左右吧。"}]
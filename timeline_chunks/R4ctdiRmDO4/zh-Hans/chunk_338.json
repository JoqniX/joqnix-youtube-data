[{"type": "subtitle", "time": 20280.39, "timestamp": "05:38:00", "text": "很可能是Twitch。如果你正在观看流媒体"}, {"type": "subtitle", "time": 20282.708, "timestamp": "05:38:02", "text": "如果我在 YouTube 上直播，它就会"}, {"type": "subtitle", "time": 20287.59, "timestamp": "05:38:07", "text": "暂时会是普通直播。"}, {"type": "subtitle", "time": 20290.15, "timestamp": "05:38:10", "text": "是的。是的。是的。因为直到这片土地"}, {"type": "subtitle", "time": 20292.708, "timestamp": "05:38:12", "text": "下载完成，我将开始直播。"}, {"type": "subtitle", "time": 20303.11, "timestamp": "05:38:23", "text": "尽管。然后所有路过的人"}, {"type": "subtitle", "time": 20305.15, "timestamp": "05:38:25", "text": "今天"}, {"type": "subtitle", "time": 20309.67, "timestamp": "05:38:29", "text": "即将到来。这对我意义重大。"}, {"type": "subtitle", "time": 20312.39, "timestamp": "05:38:32", "text": "未来。这对我意义重大。"}, {"type": "subtitle", "time": 20315.39, "timestamp": "05:38:35", "text": "希望你一切顺利"}, {"type": "subtitle", "time": 20318.03, "timestamp": "05:38:38", "text": "测试。好的"}, {"type": "subtitle", "time": 20321.948, "timestamp": "05:38:41", "text": "运气。然后明加山也来了。"}, {"type": "subtitle", "time": 20325.19, "timestamp": "05:38:45", "text": "第一的。我总是看到明加山像"}, {"type": "subtitle", "time": 20327.35, "timestamp": "05:38:47", "text": "每当我开始直播时，他们都会……"}, {"type": "subtitle", "time": 20330.31, "timestamp": "05:38:50", "text": "总是在开头打招呼"}, {"type": "subtitle", "time": 20333.75, "timestamp": "05:38:53", "text": "溪流。谢谢你过来。真正意味着"}, {"type": "subtitle", "time": 20336.75, "timestamp": "05:38:56", "text": "很多。希望你今天过得愉快。感谢"}, {"type": "subtitle", "time": 20339.39, "timestamp": "05:38:59", "text": "你。然后哈希来了"}]
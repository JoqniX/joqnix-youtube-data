[{"type": "subtitle", "time": 6240.709, "timestamp": "01:44:00", "text": "呃，那个在Vibilly的人对吧"}, {"type": "subtitle", "time": 6242.43, "timestamp": "01:44:02", "text": "现在居住在"}, {"type": "subtitle", "time": 6245.35, "timestamp": "01:44:05", "text": "他们说，英格兰人，而且他们有能力……"}, {"type": "subtitle", "time": 6248.47, "timestamp": "01:44:08", "text": "我明白了，所以他们正在尝试打字"}, {"type": "subtitle", "time": 6252.03, "timestamp": "01:44:12", "text": "消息"}]
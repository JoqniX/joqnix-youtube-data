[{"type": "subtitle", "time": 15070.07, "timestamp": "04:11:10", "text": "片刻。啊，你听到了。我的天啊。"}, {"type": "subtitle", "time": 15072.91, "timestamp": "04:11:12", "text": "我忘了我把我的Discord虚拟账号包装好了"}, {"type": "subtitle", "time": 15076.15, "timestamp": "04:11:16", "text": "有线电视或WhatsApp。我的天哪，都是我的错。"}, {"type": "subtitle", "time": 15078.99, "timestamp": "04:11:18", "text": "嗯，别介意。那只是"}, {"type": "subtitle", "time": 15084.03, "timestamp": "04:11:24", "text": "某人。我感同身受。我们可以说"}, {"type": "subtitle", "time": 15087.51, "timestamp": "04:11:27", "text": "呃，我现在感觉……别介意"}, {"type": "subtitle", "time": 15090.75, "timestamp": "04:11:30", "text": "它。别在意。忘记你"}, {"type": "subtitle", "time": 15093.83, "timestamp": "04:11:33", "text": "听到。我的错。我当时根本没意识到"}, {"type": "subtitle", "time": 15096.229, "timestamp": "04:11:36", "text": "它。我的天啊。我需要解决这个问题。哦，我的"}, {"type": "subtitle", "time": 15103.269, "timestamp": "04:11:43", "text": "你们大多数人都不理解……"}, {"type": "subtitle", "time": 15104.349, "timestamp": "04:11:44", "text": "干燥"}, {"type": "subtitle", "time": 15112.229, "timestamp": "04:11:52", "text": "小心。音频路由。你知道吗？"}, {"type": "subtitle", "time": 15114.389, "timestamp": "04:11:54", "text": "我其实会专门做一个"}, {"type": "subtitle", "time": 15117.11, "timestamp": "04:11:57", "text": "以防万一，WhatsApp 的短连接线"}, {"type": "subtitle", "time": 15119.95, "timestamp": "04:11:59", "text": "因为我看到了"}]
[{"type": "subtitle", "time": 15301.5, "timestamp": "04:15:01", "text": "一。真甜"}, {"type": "subtitle", "time": 15307.229, "timestamp": "04:15:07", "text": "老兄。"}, {"type": "subtitle", "time": 15328.469, "timestamp": "04:15:28", "text": "我不知道是明天还是明天"}, {"type": "subtitle", "time": 15339.349, "timestamp": "04:15:39", "text": "那不是“是”。是的。是的。那"}, {"type": "subtitle", "time": 15342.11, "timestamp": "04:15:42", "text": "没事。是的。是的。我可以这样说"}, {"type": "subtitle", "time": 15344.87, "timestamp": "04:15:44", "text": "那。拿着吧。记住，要睡觉。是的。"}, {"type": "subtitle", "time": 15351.429, "timestamp": "04:15:51", "text": "睡觉。是的。是的。"}, {"type": "subtitle", "time": 15354.07, "timestamp": "04:15:54", "text": "祝你考试顺利。"}]
[{"type": "subtitle", "time": 21661.83, "timestamp": "06:01:01", "text": "我一直私信他们，问他们关于什么的问题。"}, {"type": "subtitle", "time": 21663.868, "timestamp": "06:01:03", "text": "比利比利的问题"}, {"type": "subtitle", "time": 21667.07, "timestamp": "06:01:07", "text": "还有那种乞求帮助的情形"}, {"type": "subtitle", "time": 21670.43, "timestamp": "06:01:10", "text": "那一刻，哦，天哪，是那个人！"}, {"type": "subtitle", "time": 21675.628, "timestamp": "06:01:15", "text": "再次。哦，不，没有。是的，我不想"}, {"type": "subtitle", "time": 21678.91, "timestamp": "06:01:18", "text": "那。那简直太自我中心了。"}, {"type": "subtitle", "time": 21680.91, "timestamp": "06:01:20", "text": "嗯，你的"}, {"type": "subtitle", "time": 21683.99, "timestamp": "06:01:23", "text": "一些你必须做的自私的事情。我"}, {"type": "subtitle", "time": 21685.788, "timestamp": "06:01:25", "text": "不知道。我"}, {"type": "subtitle", "time": 21696.1, "timestamp": "06:01:36", "text": "呃，还有其他东西吗？"}, {"type": "subtitle", "time": 21697.868, "timestamp": "06:01:37", "text": "[音乐]"}, {"type": "subtitle", "time": 21701.27, "timestamp": "06:01:41", "text": "就像我不知道过度思考会带来怎样的痛苦一样"}, {"type": "subtitle", "time": 21703.51, "timestamp": "06:01:43", "text": "此刻，我不太清楚什么时候会这样。"}, {"type": "subtitle", "time": 21706.11, "timestamp": "06:01:46", "text": "有人私信你问你"}, {"type": "subtitle", "time": 21709.03, "timestamp": "06:01:49", "text": "发生这种情况时，我真的帮不上忙。"}, {"type": "subtitle", "time": 21711.19, "timestamp": "06:01:51", "text": "想想如果我喜欢做某件事的话"}, {"type": "subtitle", "time": 21715.43, "timestamp": "06:01:55", "text": "我只是说，是的，我自由了。"}, {"type": "subtitle", "time": 21717.628, "timestamp": "06:01:57", "text": "以及类似的帮助"}]
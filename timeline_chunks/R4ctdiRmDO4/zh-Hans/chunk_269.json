[{"type": "subtitle", "time": 16141.51, "timestamp": "04:29:01", "text": "是的，说到具体情况的时候，"}, {"type": "subtitle", "time": 16144.71, "timestamp": "04:29:04", "text": "我要把它盖住，因为我有很多"}, {"type": "subtitle", "time": 16146.11, "timestamp": "04:29:06", "text": "的"}, {"type": "subtitle", "time": 16148.63, "timestamp": "04:29:08", "text": "我明白了，我所有的对话都是什么。"}, {"type": "subtitle", "time": 16150.469, "timestamp": "04:29:10", "text": "应该做点什么。但我再次强调，"}, {"type": "subtitle", "time": 16153.11, "timestamp": "04:29:13", "text": "我觉得他们是坏男孩。不知道是什么宠物"}, {"type": "subtitle", "time": 16159.67, "timestamp": "04:29:19", "text": "没有接触。我需要一卷"}, {"type": "subtitle", "time": 16161.269, "timestamp": "04:29:21", "text": "草。"}, {"type": "subtitle", "time": 16163.79, "timestamp": "04:29:23", "text": "别再说“我的天哪”了。"}, {"type": "subtitle", "time": 16166.469, "timestamp": "04:29:26", "text": "草。我的天哪。我们都需要触摸"}, {"type": "subtitle", "time": 16169.49, "timestamp": "04:29:29", "text": "现在长草了。哦"}]
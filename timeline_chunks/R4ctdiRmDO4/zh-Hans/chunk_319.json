[{"type": "subtitle", "time": 19149.83, "timestamp": "05:19:09", "text": "我接受。我确信是因为偷窃"}, {"type": "subtitle", "time": 19157.47, "timestamp": "05:19:17", "text": "东西。我看起来好奇怪，但是"}, {"type": "subtitle", "time": 19178.948, "timestamp": "05:19:38", "text": "美好的。我当时觉得自己简直一团糟。"}, {"type": "subtitle", "time": 19181.59, "timestamp": "05:19:41", "text": "为了玩游戏，但我们现在就身处其中了。簇"}, {"type": "subtitle", "time": 19184.708, "timestamp": "05:19:44", "text": "倒退。集群是做什么用的？太多"}, {"type": "subtitle", "time": 19188.27, "timestamp": "05:19:48", "text": "发生什么事了。问题"}]
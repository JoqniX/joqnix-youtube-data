[{"type": "subtitle", "time": 19080.628, "timestamp": "05:18:00", "text": "Luna新年活动。露娜事件。"}, {"type": "subtitle", "time": 19085.23, "timestamp": "05:18:05", "text": "现在只剩下四个人了，这场比赛也结束了。"}, {"type": "subtitle", "time": 19088.75, "timestamp": "05:18:08", "text": "贱人。之后我就完成了这件事。"}, {"type": "subtitle", "time": 19092.47, "timestamp": "05:18:12", "text": "男人。不过，有一件事我会做，那就是……"}, {"type": "subtitle", "time": 19095.67, "timestamp": "05:18:15", "text": "我暂时不会碰这件事。"}, {"type": "subtitle", "time": 19097.708, "timestamp": "05:18:17", "text": "这些游戏，对吧？因为又是"}, {"type": "subtitle", "time": 19100.35, "timestamp": "05:18:20", "text": "无法播放。我的意思是，它是可以玩的。"}, {"type": "subtitle", "time": 19101.868, "timestamp": "05:18:21", "text": "但"}, {"type": "subtitle", "time": 19105.19, "timestamp": "05:18:25", "text": "痛苦。但没关系。但是再次"}, {"type": "subtitle", "time": 19107.19, "timestamp": "05:18:27", "text": "这种痛苦在某种程度上是"}, {"type": "subtitle", "time": 19109.99, "timestamp": "05:18:29", "text": "也很好，因为又得思考了。"}, {"type": "subtitle", "time": 19112.47, "timestamp": "05:18:32", "text": "关于那些像……的人"}, {"type": "subtitle", "time": 19116.15, "timestamp": "05:18:36", "text": "拥有低级角色，就像低级NPC一样，他们"}, {"type": "subtitle", "time": 19118.55, "timestamp": "05:18:38", "text": "他们也想好好玩游戏，但是他们"}, {"type": "subtitle", "time": 19123.628, "timestamp": "05:18:43", "text": "他们也正遭受着同样的痛苦。所以在"}, {"type": "subtitle", "time": 19127.51, "timestamp": "05:18:47", "text": "当然可以，没问题，而且你应该……"}, {"type": "subtitle", "time": 19129.948, "timestamp": "05:18:49", "text": "对你所拥有的一切感到满足。"}, {"type": "subtitle", "time": 19132.35, "timestamp": "05:18:52", "text": "也。所以"}, {"type": "subtitle", "time": 19138.628, "timestamp": "05:18:58", "text": "影响。我的天哪，看起来好棒！"}]
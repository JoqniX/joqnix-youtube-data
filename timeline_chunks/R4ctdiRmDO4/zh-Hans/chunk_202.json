[{"type": "subtitle", "time": 12120.83, "timestamp": "03:22:00", "text": "[音乐]"}, {"type": "subtitle", "time": 12126.429, "timestamp": "03:22:06", "text": "它。太棒了。比如这个"}, {"type": "subtitle", "time": 12129.429, "timestamp": "03:22:09", "text": "尽管。我想要这个僚机。真是太"}, {"type": "subtitle", "time": 12131.91, "timestamp": "03:22:11", "text": "粉红色的，而且是一条蛇。 D. 等等，你"}, {"type": "subtitle", "time": 12134.469, "timestamp": "03:22:14", "text": "因为太模糊了，看不清楚。"}, {"type": "subtitle", "time": 12137.51, "timestamp": "03:22:17", "text": "等等，我应该……"}, {"type": "subtitle", "time": 12146.71, "timestamp": "03:22:26", "text": "是啊，你看。它太可爱了。我想"}, {"type": "subtitle", "time": 12148.83, "timestamp": "03:22:28", "text": "不仅如此，"}, {"type": "subtitle", "time": 12151.269, "timestamp": "03:22:31", "text": "好像我不想花钱似的。不，"}, {"type": "subtitle", "time": 12154.55, "timestamp": "03:22:34", "text": "不。我正在攒钱。是的，骑师。你"}, {"type": "subtitle", "time": 12160.349, "timestamp": "03:22:40", "text": "钱。是的。可爱的"}, {"type": "subtitle", "time": 12163.59, "timestamp": "03:22:43", "text": "的确。我们走吧。我想开枪。"}, {"type": "subtitle", "time": 12166.19, "timestamp": "03:22:46", "text": "让我们来迎接挑战吧！"}, {"type": "subtitle", "time": 12169.19, "timestamp": "03:22:49", "text": "东西。所以，要同时扮演两名经理。呃"}, {"type": "subtitle", "time": 12173.269, "timestamp": "03:22:53", "text": "所有事件中都会发生同样的事情"}, {"type": "subtitle", "time": 12176.87, "timestamp": "03:22:56", "text": "造成伤害的击杀评估前四名"}, {"type": "subtitle", "time": 12177.71, "timestamp": "03:22:57", "text": "全部"}]
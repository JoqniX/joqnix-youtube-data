[{"type": "subtitle", "time": 4988.79, "timestamp": "01:23:08", "text": "是啊，我想睡觉，但是睡不着。"}, {"type": "subtitle", "time": 4990.47, "timestamp": "01:23:10", "text": "真的。我总是想太多"}, {"type": "subtitle", "time": 4992.11, "timestamp": "01:23:12", "text": "思考一些事情"}, {"type": "subtitle", "time": 4993.34, "timestamp": "01:23:13", "text": "更多的。"}, {"type": "subtitle", "time": 5015.149, "timestamp": "01:23:35", "text": "少量。我会说尽量尝试"}, {"type": "subtitle", "time": 5017.27, "timestamp": "01:23:37", "text": "幽思。闭上眼睛。保留你的"}, {"type": "subtitle", "time": 5026.189, "timestamp": "01:23:46", "text": "思考"}, {"type": "subtitle", "time": 5029.47, "timestamp": "01:23:49", "text": "快乐"}, {"type": "chat", "time": 5030.992, "timestamp": "01:23:50", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "I tried"}, {"type": "subtitle", "time": 5032.229, "timestamp": "01:23:52", "text": "事物。不要说消极的话。清除"}, {"type": "subtitle", "time": 5033.629, "timestamp": "01:23:53", "text": "你的"}, {"type": "subtitle", "time": 5036.75, "timestamp": "01:23:56", "text": "头。展现你的"}, {"type": "subtitle", "time": 5038.91, "timestamp": "01:23:58", "text": "周围环境。我"}]
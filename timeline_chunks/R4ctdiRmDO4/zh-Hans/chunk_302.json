[{"type": "subtitle", "time": 18120.99, "timestamp": "05:02:00", "text": "为你。哦，我的"}, {"type": "subtitle", "time": 18123.31, "timestamp": "05:02:03", "text": "上帝。我不知道那是什么"}, {"type": "subtitle", "time": 18134.19, "timestamp": "05:02:14", "text": "快点。这是在开玩笑吗？是"}, {"type": "subtitle", "time": 18145.59, "timestamp": "05:02:25", "text": "上帝。不要让任何人感到不舒服"}, {"type": "subtitle", "time": 18157.75, "timestamp": "05:02:37", "text": "砰。我玩不了这款游戏。"}, {"type": "subtitle", "time": 18173.19, "timestamp": "05:02:53", "text": "乔，我不知道。我的意思是，这是一辆……"}, {"type": "subtitle", "time": 18175.59, "timestamp": "05:02:55", "text": "跟我作对吧，我想，因为我不会……"}, {"type": "subtitle", "time": 18178.51, "timestamp": "05:02:58", "text": "投入了那么多"}]
[{"type": "subtitle", "time": 6660.75, "timestamp": "01:51:00", "text": "兄弟，最近怎么样？是什么"}, {"type": "subtitle", "time": 6663.709, "timestamp": "01:51:03", "text": "向上？这是怎么回事？"}, {"type": "subtitle", "time": 6666.03, "timestamp": "01:51:06", "text": "叽叽喳喳，"}, {"type": "subtitle", "time": 6675.43, "timestamp": "01:51:15", "text": "向上？好了，真的太晚了。我的大脑是"}, {"type": "subtitle", "time": 6676.27, "timestamp": "01:51:16", "text": "不是"}, {"type": "subtitle", "time": 6700.99, "timestamp": "01:51:40", "text": "早点睡觉。是的。是的。是的。"}]
[{"type": "subtitle", "time": 13982.99, "timestamp": "03:53:02", "text": "我必须关掉我的"}, {"type": "subtitle", "time": 13985.67, "timestamp": "03:53:05", "text": "我一直都像这样的账户：呃，哪个"}, {"type": "subtitle", "time": 13989.15, "timestamp": "03:53:09", "text": "我一直在看很多"}, {"type": "subtitle", "time": 13992.469, "timestamp": "03:53:12", "text": "嗯，中国油管博主们正在尝试制作"}, {"type": "subtitle", "time": 13995.95, "timestamp": "03:53:15", "text": "尝试建立人脉"}, {"type": "subtitle", "time": 14000.87, "timestamp": "03:53:20", "text": "其实我希望有一天我会……"}, {"type": "subtitle", "time": 14004.229, "timestamp": "03:53:24", "text": "能够与他们进行直播和协作"}, {"type": "subtitle", "time": 14006.95, "timestamp": "03:53:26", "text": "或者其他什么我不知道的事情，但就是这样"}, {"type": "subtitle", "time": 14009.63, "timestamp": "03:53:29", "text": "你浪费掉的生命"}, {"type": "subtitle", "time": 14011.87, "timestamp": "03:53:31", "text": "两个都。"}, {"type": "subtitle", "time": 14015.59, "timestamp": "03:53:35", "text": "是啊，还有那件事。总之，我是这样做的"}, {"type": "subtitle", "time": 14018.03, "timestamp": "03:53:38", "text": "对于洪凯来说，"}, {"type": "subtitle", "time": 14020.67, "timestamp": "03:53:40", "text": "正确的？我为洪做了什么"}, {"type": "subtitle", "time": 14024.95, "timestamp": "03:53:44", "text": "孔盖？你们大多数人都知道，嗯，"}, {"type": "subtitle", "time": 14029.07, "timestamp": "03:53:49", "text": "你们大多数人都知道，呃，我的原神"}, {"type": "subtitle", "time": 14032.389, "timestamp": "03:53:52", "text": "帐户。是的。是的，我的原神账号。"}, {"type": "subtitle", "time": 14036.429, "timestamp": "03:53:56", "text": "我经常用到它，对吧？"}, {"type": "subtitle", "time": 14039.51, "timestamp": "03:53:59", "text": "因为我没有参加这个活动。"}]
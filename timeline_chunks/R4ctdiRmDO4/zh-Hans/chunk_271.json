[{"type": "subtitle", "time": 16261.51, "timestamp": "04:31:01", "text": "哦，我想多听听他们的声音。"}, {"type": "subtitle", "time": 16267.03, "timestamp": "04:31:07", "text": "是的。"}, {"type": "subtitle", "time": 16269.429, "timestamp": "04:31:09", "text": "就像你对那个人有这种吸引力一样。"}, {"type": "subtitle", "time": 16272.149, "timestamp": "04:31:12", "text": "某种声音，或者他们是如何做到的，或者"}, {"type": "subtitle", "time": 16275.71, "timestamp": "04:31:15", "text": "某物。就像是同一件事。"}, {"type": "subtitle", "time": 16279.79, "timestamp": "04:31:19", "text": "大多数人是如何被吸引的"}, {"type": "subtitle", "time": 16282.07, "timestamp": "04:31:22", "text": "外表，指他们的外貌或"}, {"type": "subtitle", "time": 16284.469, "timestamp": "04:31:24", "text": "某物。声音也是如此。哦，一样"}, {"type": "subtitle", "time": 16287.149, "timestamp": "04:31:27", "text": "有个性"}, {"type": "subtitle", "time": 16299.55, "timestamp": "04:31:39", "text": "我出演这个角色是因为这个故事。"}, {"type": "subtitle", "time": 16318.59, "timestamp": "04:31:58", "text": "乐趣。你好"}]
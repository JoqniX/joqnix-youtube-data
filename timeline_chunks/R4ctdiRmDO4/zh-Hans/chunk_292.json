[{"type": "subtitle", "time": 17522.99, "timestamp": "04:52:02", "text": "不会像Apex、守望先锋那样进行直播"}, {"type": "subtitle", "time": 17526.99, "timestamp": "04:52:06", "text": "堡垒之夜。我不了解瓦莱林"}, {"type": "subtitle", "time": 17530.55, "timestamp": "04:52:10", "text": "尽管。真糟糕。虽然很痛苦，但是"}, {"type": "subtitle", "time": 17533.708, "timestamp": "04:52:13", "text": "没关系。我想我没有"}, {"type": "subtitle", "time": 17536.31, "timestamp": "04:52:16", "text": "知道。像Honka之类的东西，我能做到。"}, {"type": "subtitle", "time": 17539.708, "timestamp": "04:52:19", "text": "原神，我担心……"}, {"type": "subtitle", "time": 17543.03, "timestamp": "04:52:23", "text": "那。原神能玩吗？因为那是……"}, {"type": "subtitle", "time": 17544.948, "timestamp": "04:52:24", "text": "土地和权利事件。我想做一件事"}, {"type": "subtitle", "time": 17547.39, "timestamp": "04:52:27", "text": "直播此内容"}, {"type": "subtitle", "time": 17550.23, "timestamp": "04:52:30", "text": "星期。是的。哦，我完成了两个"}, {"type": "subtitle", "time": 17554.15, "timestamp": "04:52:34", "text": "挑战。嘿，我完成了一个完整的。是的。"}, {"type": "subtitle", "time": 17574.708, "timestamp": "04:52:54", "text": "问题。不过有点卡顿。"}, {"type": "subtitle", "time": 17576.11, "timestamp": "04:52:56", "text": "那是"}, {"type": "subtitle", "time": 17579.43, "timestamp": "04:52:59", "text": "美好的。我在想，要不要重新开始？"}]
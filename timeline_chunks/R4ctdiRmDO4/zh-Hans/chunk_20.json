[{"type": "subtitle", "time": 1201.31, "timestamp": "00:20:01", "text": "那家伙被封号了。那家伙"}, {"type": "subtitle", "time": 1203.51, "timestamp": "00:20:03", "text": "已禁止。哦，是啊，是啊，是啊。这个人是"}, {"type": "subtitle", "time": 1206.029, "timestamp": "00:20:06", "text": "那个说“你能吸我的……”的人"}, {"type": "subtitle", "time": 1219.83, "timestamp": "00:20:19", "text": "方式。我的天哪。兄弟，我什么时候快乐过？什么"}, {"type": "subtitle", "time": 1222.549, "timestamp": "00:20:22", "text": "是吗？搞什么鬼？我为什么这么高兴？"}]
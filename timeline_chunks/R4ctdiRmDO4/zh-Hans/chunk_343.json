[{"type": "subtitle", "time": 20581.99, "timestamp": "05:43:01", "text": "上层发生着平常的事情"}, {"type": "subtitle", "time": 20583.99, "timestamp": "05:43:03", "text": "家里发生这种事，就像我不在一样。"}, {"type": "subtitle", "time": 20588.31, "timestamp": "05:43:08", "text": "想在直播中表现得像个爱开玩笑的人，或者"}, {"type": "subtitle", "time": 20590.868, "timestamp": "05:43:10", "text": "某物。所以我必须小心谨慎。"}, {"type": "subtitle", "time": 20596.03, "timestamp": "05:43:16", "text": "关于那方面的事情也差不多。是的。"}, {"type": "subtitle", "time": 20599.75, "timestamp": "05:43:19", "text": "任何人。嗯，我会尽量早起。"}, {"type": "subtitle", "time": 20603.15, "timestamp": "05:43:23", "text": "至少有两个直播流"}, {"type": "subtitle", "time": 20607.19, "timestamp": "05:43:27", "text": "现在，而且，嗯，是的，我们仍然会"}, {"type": "subtitle", "time": 20609.75, "timestamp": "05:43:29", "text": "有YouTube直播，所以不用担心。"}, {"type": "subtitle", "time": 20611.07, "timestamp": "05:43:31", "text": "是的。"}, {"type": "subtitle", "time": 20618.07, "timestamp": "05:43:38", "text": "主要是我的日程安排和这周的事情。"}, {"type": "subtitle", "time": 20620.47, "timestamp": "05:43:40", "text": "我们没有正确安排日程。对不起"}, {"type": "subtitle", "time": 20623.75, "timestamp": "05:43:43", "text": "关于那件事。我确实想制定一个日程表。"}, {"type": "subtitle", "time": 20626.11, "timestamp": "05:43:46", "text": "但我"}, {"type": "subtitle", "time": 20628.868, "timestamp": "05:43:48", "text": "没办法，不过没关系，没关系。"}, {"type": "subtitle", "time": 20632.23, "timestamp": "05:43:52", "text": "但是，嗯，还是要知道，即使我"}, {"type": "subtitle", "time": 20636.548, "timestamp": "05:43:56", "text": "我跟他们说我会玩守望先锋，但是我们"}, {"type": "subtitle", "time": 20639.91, "timestamp": "05:43:59", "text": "我真的通关了守望先锋"}]
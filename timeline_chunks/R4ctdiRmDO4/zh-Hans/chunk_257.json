[{"type": "subtitle", "time": 15437.91, "timestamp": "04:17:17", "text": "吸血鬼一定很招人喜欢。是的，你"}, {"type": "subtitle", "time": 15441.189, "timestamp": "04:17:21", "text": "也应该睡觉或匆忙完成P。不要"}, {"type": "subtitle", "time": 15444.11, "timestamp": "04:17:24", "text": "为了你自己而留"}, {"type": "subtitle", "time": 15447.59, "timestamp": "04:17:27", "text": "向上。你为什么喝咖啡？不吃"}, {"type": "subtitle", "time": 15454.349, "timestamp": "04:17:34", "text": "但"}, {"type": "subtitle", "time": 15457.03, "timestamp": "04:17:37", "text": "是啊，你知道，你知道我的感受"}, {"type": "subtitle", "time": 15457.95, "timestamp": "04:17:37", "text": "喜欢"}, {"type": "subtitle", "time": 15461.67, "timestamp": "04:17:41", "text": "正在做？等待。唉，如果我当初就开始就好了。"}, {"type": "subtitle", "time": 15464.91, "timestamp": "04:17:44", "text": "这条新闻是三点钟方向的，对吧？我可以"}, {"type": "subtitle", "time": 15472.51, "timestamp": "04:17:52", "text": "某物。我想提高效率。"}, {"type": "subtitle", "time": 15474.79, "timestamp": "04:17:54", "text": "再次。不，我晚上要睡觉了。"}, {"type": "subtitle", "time": 15477.11, "timestamp": "04:17:57", "text": "一起。好，好，好，好。"}, {"type": "subtitle", "time": 15479.91, "timestamp": "04:17:59", "text": "你知道我想让我们开始一个"}]
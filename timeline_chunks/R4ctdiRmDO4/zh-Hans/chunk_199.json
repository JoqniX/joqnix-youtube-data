[{"type": "subtitle", "time": 11948.349, "timestamp": "03:19:08", "text": "男人。"}, {"type": "subtitle", "time": 11951.55, "timestamp": "03:19:11", "text": "哦，我让它转起来了。我们走吧。我做到了"}, {"type": "subtitle", "time": 11954.15, "timestamp": "03:19:14", "text": "旋转。我让它转起来了。我转了一圈。"}, {"type": "subtitle", "time": 11956.71, "timestamp": "03:19:16", "text": "等等，等等，等等，等等。我转了一圈。"}, {"type": "subtitle", "time": 11959.269, "timestamp": "03:19:19", "text": "等等，你能听到吗？我想让你"}, {"type": "subtitle", "time": 11960.51, "timestamp": "03:19:20", "text": "伙计们，听着"}, {"type": "subtitle", "time": 11962.83, "timestamp": "03:19:22", "text": "这。我们"}, {"type": "subtitle", "time": 11967.63, "timestamp": "03:19:27", "text": "成功使其以 100% 的风扇转速旋转"}, {"type": "subtitle", "time": 11970.95, "timestamp": "03:19:30", "text": "速度与力量并存。所以，事情就是这样。"}, {"type": "subtitle", "time": 11974.15, "timestamp": "03:19:34", "text": "声音。好的。"}, {"type": "subtitle", "time": 11980.63, "timestamp": "03:19:40", "text": "它？那个小小的树瘤状的东西。不"}, {"type": "subtitle", "time": 11981.87, "timestamp": "03:19:41", "text": "注意"}, {"type": "subtitle", "time": 11988.15, "timestamp": "03:19:48", "text": "它？对，就是那个。就是那个声音"}, {"type": "subtitle", "time": 11995.95, "timestamp": "03:19:55", "text": "旋转。"}]
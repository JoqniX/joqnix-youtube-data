[{"type": "subtitle", "time": 4504.95, "timestamp": "01:15:04", "text": "我以前可以发各种各样的推文"}, {"type": "subtitle", "time": 4507.75, "timestamp": "01:15:07", "text": "这里曾经有一些零零碎碎的东西。现在"}, {"type": "subtitle", "time": 4509.51, "timestamp": "01:15:09", "text": "我不知道该怎么做了。"}, {"type": "subtitle", "time": 4532.07, "timestamp": "01:15:32", "text": "但我感觉他好像忙于其他事情。"}, {"type": "subtitle", "time": 4536.189, "timestamp": "01:15:36", "text": "全球奇幻赛事"}, {"type": "subtitle", "time": 4539.41, "timestamp": "01:15:39", "text": "活动，他全身心投入其中"}, {"type": "subtitle", "time": 4541.79, "timestamp": "01:15:41", "text": "[音乐]"}, {"type": "subtitle", "time": 4543.39, "timestamp": "01:15:43", "text": "到"}]
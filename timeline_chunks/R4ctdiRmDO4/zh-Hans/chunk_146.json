[{"type": "subtitle", "time": 8761.07, "timestamp": "02:26:01", "text": "将会有很多"}, {"type": "subtitle", "time": 8763.75, "timestamp": "02:26:03", "text": "合作等等，所以我是"}, {"type": "subtitle", "time": 8766.03, "timestamp": "02:26:06", "text": "已订满"}, {"type": "subtitle", "time": 8769.03, "timestamp": "02:26:09", "text": "伙计，我只是想在去之前……"}, {"type": "subtitle", "time": 8771.11, "timestamp": "02:26:11", "text": "我想和日本所有人合作"}, {"type": "subtitle", "time": 8774.63, "timestamp": "02:26:14", "text": "我这些年来遇到的人们"}, {"type": "subtitle", "time": 8777.11, "timestamp": "02:26:17", "text": "与我联系过，而且也知道"}, {"type": "subtitle", "time": 8779.23, "timestamp": "02:26:19", "text": "我希望的人"}, {"type": "subtitle", "time": 8794.07, "timestamp": "02:26:34", "text": "那。所以我现在很挣扎，因为……"}, {"type": "subtitle", "time": 8797.67, "timestamp": "02:26:37", "text": "最后一刻，只剩几天时间了"}, {"type": "subtitle", "time": 8800.07, "timestamp": "02:26:40", "text": "本月即将结束。我只能一直走到"}, {"type": "subtitle", "time": 8803.91, "timestamp": "02:26:43", "text": "到六月的第一周。然后是第二"}, {"type": "subtitle", "time": 8805.75, "timestamp": "02:26:45", "text": "从下周开始，我必须要么结束要么结束"}, {"type": "subtitle", "time": 8810.07, "timestamp": "02:26:50", "text": "运动马拉松或者暂停一下，直到我表弟有"}, {"type": "subtitle", "time": 8812.389, "timestamp": "02:26:52", "text": "考试之类的。然后"}, {"type": "subtitle", "time": 8814.59, "timestamp": "02:26:54", "text": "第二周或第三周"}, {"type": "subtitle", "time": 8817.67, "timestamp": "02:26:57", "text": "六月将是我拥有的最后一天"}]
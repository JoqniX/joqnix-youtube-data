[{"type": "subtitle", "time": 17101.35, "timestamp": "04:45:01", "text": "动词。顺便说一句，天气超级热。甚至"}, {"type": "subtitle", "time": 17104.23, "timestamp": "04:45:04", "text": "开了空调之后，简直热得要命。我"}, {"type": "subtitle", "time": 17107.03, "timestamp": "04:45:07", "text": "能感觉到热浪袭来。我的天啊。"}, {"type": "subtitle", "time": 17109.99, "timestamp": "04:45:09", "text": "等待。其实是等等。"}, {"type": "subtitle", "time": 17113.07, "timestamp": "04:45:13", "text": "这正常吗？"}, {"type": "subtitle", "time": 17115.07, "timestamp": "04:45:15", "text": "等待。"}, {"type": "subtitle", "time": 17124.23, "timestamp": "04:45:24", "text": "正在做？很高兴看到你回来。我会"}, {"type": "subtitle", "time": 17124.83, "timestamp": "04:45:24", "text": "射击"}, {"type": "subtitle", "time": 17127.75, "timestamp": "04:45:27", "text": "你。宝贝，为什么这么热？"}, {"type": "subtitle", "time": 17137.67, "timestamp": "04:45:37", "text": "全科医生。不，那不是吸烟。"}, {"type": "subtitle", "time": 17139.99, "timestamp": "04:45:39", "text": "实际上，这真的很难。"}, {"type": "subtitle", "time": 17150.948, "timestamp": "04:45:50", "text": "你看，盘子现在多光滑啊。"}]
[{"type": "subtitle", "time": 19861.31, "timestamp": "05:31:01", "text": "不喝酒也能生存"}, {"type": "subtitle", "time": 19863.75, "timestamp": "05:31:03", "text": "只喝水，而且什么都没吃。"}, {"type": "subtitle", "time": 19866.03, "timestamp": "05:31:06", "text": "或者类似这样"}, {"type": "subtitle", "time": 19868.23, "timestamp": "05:31:08", "text": "那。我不知道我还有什么。"}, {"type": "subtitle", "time": 19877.708, "timestamp": "05:31:17", "text": "从某种意义上说，做这一切真的太酷了。"}, {"type": "subtitle", "time": 19880.19, "timestamp": "05:31:20", "text": "这些有趣的"}, {"type": "subtitle", "time": 19882.708, "timestamp": "05:31:22", "text": "实验。但是，你也不应该这样做"}, {"type": "subtitle", "time": 19885.15, "timestamp": "05:31:25", "text": "这是通过"}, {"type": "subtitle", "time": 19913.75, "timestamp": "05:31:53", "text": "[音乐]"}, {"type": "subtitle", "time": 19915.67, "timestamp": "05:31:55", "text": "我会第一个接受“好的，我”。"}, {"type": "subtitle", "time": 19918.11, "timestamp": "05:31:58", "text": "想成为第一个拿到它的人。哦，"}]
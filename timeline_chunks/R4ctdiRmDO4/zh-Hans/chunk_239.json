[{"type": "subtitle", "time": 14342.15, "timestamp": "03:59:02", "text": "就这么想。"}, {"type": "subtitle", "time": 14347.469, "timestamp": "03:59:07", "text": "就像昨天我收到一条这样的私信"}, {"type": "subtitle", "time": 14351.429, "timestamp": "03:59:11", "text": "那家伙跟我说他们就像……"}, {"type": "subtitle", "time": 14354.389, "timestamp": "03:59:14", "text": "甜言蜜语一番，然后就结束了。"}, {"type": "subtitle", "time": 14356.95, "timestamp": "03:59:16", "text": "碰巧是Steam账号"}, {"type": "subtitle", "time": 14361.03, "timestamp": "03:59:21", "text": "比如Steam账号诈骗之类的"}, {"type": "subtitle", "time": 14363.11, "timestamp": "03:59:23", "text": "他们会说，哦不，我做了什么……"}, {"type": "subtitle", "time": 14365.11, "timestamp": "03:59:25", "text": "他们会问你是否拥有Steam帐户"}, {"type": "subtitle", "time": 14367.229, "timestamp": "03:59:27", "text": "这是Steam账号吗？"}, {"type": "subtitle", "time": 14370.51, "timestamp": "03:59:30", "text": "他们问你是否愿意。"}, {"type": "subtitle", "time": 14373.79, "timestamp": "03:59:33", "text": "诸如此类的事情。是的。是的。我当时就想，"}, {"type": "subtitle", "time": 14377.269, "timestamp": "03:59:37", "text": "兄弟，我不是那个意思，我只是这么说的。"}, {"type": "subtitle", "time": 14380.07, "timestamp": "03:59:40", "text": "你这混蛋！我不是，我知道这就像"}, {"type": "subtitle", "time": 14383.269, "timestamp": "03:59:43", "text": "你搞的那个Steam骗局。"}, {"type": "subtitle", "time": 14386.15, "timestamp": "03:59:46", "text": "我当然不会上当。"}, {"type": "subtitle", "time": 14388.95, "timestamp": "03:59:48", "text": "我问：“你有什么动机吗？”"}, {"type": "subtitle", "time": 14391.189, "timestamp": "03:59:51", "text": "这样做吗？”他们沉默了。"}, {"type": "subtitle", "time": 14396.91, "timestamp": "03:59:56", "text": "关于它。他们从未发过私信。我当时就想，"}, {"type": "subtitle", "time": 14399.75, "timestamp": "03:59:59", "text": "“巴卡，阿里斯，告诉我一声。我想要，我想要"}]
[{"type": "subtitle", "time": 13561.59, "timestamp": "03:46:01", "text": "录个视频什么的以防万一，直到我……"}, {"type": "subtitle", "time": 13564.07, "timestamp": "03:46:04", "text": "更擅长直播录制视频"}, {"type": "subtitle", "time": 13566.03, "timestamp": "03:46:06", "text": "溪流"}, {"type": "subtitle", "time": 13568.469, "timestamp": "03:46:08", "text": "东西。是的。是的。是的。所以，我想"}, {"type": "subtitle", "time": 13571.429, "timestamp": "03:46:11", "text": "是的。"}, {"type": "subtitle", "time": 13573.71, "timestamp": "03:46:13", "text": "我会那样做，或者"}, {"type": "subtitle", "time": 13577.309, "timestamp": "03:46:17", "text": "某物。你知道吗？我认为"}, {"type": "subtitle", "time": 13580.189, "timestamp": "03:46:20", "text": "双击"}, {"type": "subtitle", "time": 13583.349, "timestamp": "03:46:23", "text": "应该。是的。哈卡罗伊。是的，我做了。"}, {"type": "subtitle", "time": 13585.51, "timestamp": "03:46:25", "text": "试试哈卡尔·罗伊。很好。它很好，但是"}, {"type": "subtitle", "time": 13587.51, "timestamp": "03:46:27", "text": "因为新年活动"}, {"type": "subtitle", "time": 13590.51, "timestamp": "03:46:30", "text": "确实充满挑战，对吧？更好"}, {"type": "subtitle", "time": 13593.309, "timestamp": "03:46:33", "text": "最好还是战斗。"}, {"type": "subtitle", "time": 13595.229, "timestamp": "03:46:35", "text": "皇家"}, {"type": "subtitle", "time": 13598.71, "timestamp": "03:46:38", "text": "反而。实际上，因为它需要"}, {"type": "subtitle", "time": 13605.309, "timestamp": "03:46:45", "text": "正确的？硬核硬核"}, {"type": "subtitle", "time": 13609.75, "timestamp": "03:46:49", "text": "皇家成员和非NB成员一样，对吧？非战斗"}, {"type": "subtitle", "time": 13611.91, "timestamp": "03:46:51", "text": "皇家。所以，这不算在你的成绩里。"}, {"type": "subtitle", "time": 13614.269, "timestamp": "03:46:54", "text": "挑战。所以，最好还是去"}, {"type": "subtitle", "time": 13616.87, "timestamp": "03:46:56", "text": "带有大逃杀模式。类似大逃杀的游戏"}, {"type": "subtitle", "time": 13618.95, "timestamp": "03:46:58", "text": "正常的幼犬。"}]
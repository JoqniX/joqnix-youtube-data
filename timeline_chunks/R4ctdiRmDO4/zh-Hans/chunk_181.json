[{"type": "subtitle", "time": 10861.03, "timestamp": "03:01:01", "text": "谢天谢地。主屏幕实际上就是"}, {"type": "subtitle", "time": 10862.79, "timestamp": "03:01:02", "text": "就是你现在看到的这个。这是"}, {"type": "subtitle", "time": 10865.23, "timestamp": "03:01:05", "text": "主屏幕。谢天谢地，不是锁的问题。"}, {"type": "subtitle", "time": 10867.83, "timestamp": "03:01:07", "text": "屏幕。是的，主屏幕就是这样。"}, {"type": "subtitle", "time": 10870.79, "timestamp": "03:01:10", "text": "这是我画的一张同人图。"}, {"type": "subtitle", "time": 10874.309, "timestamp": "03:01:14", "text": "呃，是我生日那天一位朋友做的。"}, {"type": "subtitle", "time": 10877.469, "timestamp": "03:01:17", "text": "我有个印度YouTuber朋友，他叫"}, {"type": "subtitle", "time": 10880.11, "timestamp": "03:01:20", "text": "伊苏伊。她画了这幅画"}, {"type": "subtitle", "time": 10883.79, "timestamp": "03:01:23", "text": "我。完整的艺术作品将"}, {"type": "subtitle", "time": 10887.269, "timestamp": "03:01:27", "text": "如果我能找到的话。它将在我的"}, {"type": "subtitle", "time": 10890.96, "timestamp": "03:01:30", "text": "淋浴。让我来拿。"}, {"type": "subtitle", "time": 10893.59, "timestamp": "03:01:33", "text": "[音乐]"}, {"type": "subtitle", "time": 10901.99, "timestamp": "03:01:41", "text": "哦，动漫女孩动漫。哦，这些"}, {"type": "subtitle", "time": 10904.15, "timestamp": "03:01:44", "text": "就像壁纸一样。动漫壁纸。和"}, {"type": "subtitle", "time": 10911.59, "timestamp": "03:01:51", "text": "东西。我安装了很多随机的东西"}, {"type": "subtitle", "time": 10912.83, "timestamp": "03:01:52", "text": "呃"}, {"type": "subtitle", "time": 10915.91, "timestamp": "03:01:55", "text": "言简意赅。真是太奇怪了。我"}, {"type": "subtitle", "time": 10918.59, "timestamp": "03:01:58", "text": "需要清理一下。清理"}]
[{"type": "subtitle", "time": 16021.91, "timestamp": "04:27:01", "text": "我不知道。但尝试一下也很有趣"}, {"type": "subtitle", "time": 16023.389, "timestamp": "04:27:03", "text": "东西"}, {"type": "subtitle", "time": 16035.07, "timestamp": "04:27:15", "text": "乐趣"}, {"type": "subtitle", "time": 16038.389, "timestamp": "04:27:18", "text": "vi 就像秒。这是从第一名到第二名的差距。"}, {"type": "subtitle", "time": 16046.149, "timestamp": "04:27:26", "text": "溪流。我模仿振动器的声音。"}, {"type": "subtitle", "time": 16050.03, "timestamp": "04:27:30", "text": "就是那种振动器，对吧？那"}, {"type": "subtitle", "time": 16052.95, "timestamp": "04:27:32", "text": "事物。是的。是的。是的。事情是这样的"}, {"type": "subtitle", "time": 16054.03, "timestamp": "04:27:34", "text": "真是太"}, {"type": "subtitle", "time": 16055.87, "timestamp": "04:27:35", "text": "令人满意"}, {"type": "subtitle", "time": 16057.99, "timestamp": "04:27:37", "text": "某物。你可以把它放在手里"}, {"type": "subtitle", "time": 16061.55, "timestamp": "04:27:41", "text": "并感受到这种震动"}, {"type": "subtitle", "time": 16063.91, "timestamp": "04:27:43", "text": "东西。是的。是的。是的。或者就像如果你"}, {"type": "subtitle", "time": 16066.55, "timestamp": "04:27:46", "text": "弄个头部按摩器之类的，你"}, {"type": "subtitle", "time": 16069.11, "timestamp": "04:27:49", "text": "能感觉到震动，就像……"}, {"type": "subtitle", "time": 16071.79, "timestamp": "04:27:51", "text": "就像全身颤抖一样"}, {"type": "subtitle", "time": 16075.349, "timestamp": "04:27:55", "text": "片刻。是的。"}, {"type": "subtitle", "time": 16078.23, "timestamp": "04:27:58", "text": "哦，糖果。哦，"}]
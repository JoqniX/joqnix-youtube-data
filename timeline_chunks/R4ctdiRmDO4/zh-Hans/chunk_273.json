[{"type": "subtitle", "time": 16383.11, "timestamp": "04:33:03", "text": "运动健将的头。五月什么？什么是你做什么"}, {"type": "subtitle", "time": 16403.91, "timestamp": "04:33:23", "text": "是的。还有，笨蛋，你不应该……"}, {"type": "subtitle", "time": 16424.91, "timestamp": "04:33:44", "text": "年轻的？我的意思是，这就像我定下的一条规则。"}, {"type": "subtitle", "time": 16429.31, "timestamp": "04:33:49", "text": "好的。这就像我制定的一条规则"}, {"type": "subtitle", "time": 16432.949, "timestamp": "04:33:52", "text": "某种程度上，因为某种程度上我……呃，某种程度上我没有"}, {"type": "subtitle", "time": 16434.109, "timestamp": "04:33:54", "text": "我不想要。"}, {"type": "subtitle", "time": 16436.67, "timestamp": "04:33:56", "text": "想"}]
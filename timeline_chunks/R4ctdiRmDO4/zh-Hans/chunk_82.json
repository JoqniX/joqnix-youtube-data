[{"type": "subtitle", "time": 4920.47, "timestamp": "01:22:00", "text": "嗯，我想我可以单独跟你谈谈。"}, {"type": "subtitle", "time": 4924.55, "timestamp": "01:22:04", "text": "我觉得现在这样好多了，因为……"}, {"type": "subtitle", "time": 4925.79, "timestamp": "01:22:05", "text": "更好的"}, {"type": "subtitle", "time": 4930.55, "timestamp": "01:22:10", "text": "因为现在我必须作为合作主持人这样做。"}, {"type": "subtitle", "time": 4932.95, "timestamp": "01:22:12", "text": "必须确保合作"}, {"type": "subtitle", "time": 4936.95, "timestamp": "01:22:16", "text": "参与者们确实积极投入，"}, {"type": "subtitle", "time": 4939.83, "timestamp": "01:22:19", "text": "现在享受着快乐，但如果……"}, {"type": "subtitle", "time": 4942.79, "timestamp": "01:22:22", "text": "如果是单身人士，那对我来说更好。"}, {"type": "subtitle", "time": 4943.709, "timestamp": "01:22:23", "text": "到"}, {"type": "subtitle", "time": 4946.149, "timestamp": "01:22:26", "text": "比如确保我们玩得开心"}, {"type": "subtitle", "time": 4949.03, "timestamp": "01:22:29", "text": "一起把东西塞进小组"}, {"type": "subtitle", "time": 4953.11, "timestamp": "01:22:33", "text": "我正在做一个合作项目，呃，一个小组。"}, {"type": "subtitle", "time": 4956.91, "timestamp": "01:22:36", "text": "合作项目。我是在最后一周做的。"}, {"type": "subtitle", "time": 4961.75, "timestamp": "01:22:41", "text": "可能。嗯，是的，玩了几局。之中"}, {"type": "subtitle", "time": 4962.83, "timestamp": "01:22:42", "text": "我们或"}, {"type": "subtitle", "time": 4970.83, "timestamp": "01:22:50", "text": "某物。"}, {"type": "subtitle", "time": 4974.79, "timestamp": "01:22:54", "text": "不，我唯一的敌人就是我的精力。"}]
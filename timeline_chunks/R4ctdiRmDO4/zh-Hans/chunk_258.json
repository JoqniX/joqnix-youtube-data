[{"type": "subtitle", "time": 15482.07, "timestamp": "04:18:02", "text": "结束这个之后，我现在就直播，但是"}, {"type": "subtitle", "time": 15483.95, "timestamp": "04:18:03", "text": "还"}, {"type": "subtitle", "time": 15485.55, "timestamp": "04:18:05", "text": "喜欢"}, {"type": "subtitle", "time": 15488.71, "timestamp": "04:18:08", "text": "骑师，你还没醒呢，你需要醒醒。"}, {"type": "subtitle", "time": 15491.63, "timestamp": "04:18:11", "text": "明天去做"}, {"type": "subtitle", "time": 15493.34, "timestamp": "04:18:13", "text": "我是"}, {"type": "subtitle", "time": 15495.469, "timestamp": "04:18:15", "text": "[音乐]"}, {"type": "subtitle", "time": 15499.91, "timestamp": "04:18:19", "text": "我也不知道为什么，但最近我好像总是这样。"}, {"type": "subtitle", "time": 15500.91, "timestamp": "04:18:20", "text": "一种感觉"}, {"type": "subtitle", "time": 15504.07, "timestamp": "04:18:24", "text": "最近我一直在做直播"}, {"type": "subtitle", "time": 15505.67, "timestamp": "04:18:25", "text": "因为我想直播什么的。"}, {"type": "subtitle", "time": 15510.269, "timestamp": "04:18:30", "text": "不，只是因为我有义务直播或者"}, {"type": "subtitle", "time": 15513.149, "timestamp": "04:18:33", "text": "某某事。我不"}, {"type": "subtitle", "time": 15516.229, "timestamp": "04:18:36", "text": "知道。最近，我一直觉得"}, {"type": "subtitle", "time": 15518.55, "timestamp": "04:18:38", "text": "不像那种高效的运动员"}, {"type": "subtitle", "time": 15521.11, "timestamp": "04:18:41", "text": "片刻或类似的事情。我不知道。或许"}, {"type": "subtitle", "time": 15522.51, "timestamp": "04:18:42", "text": "只是"}, {"type": "subtitle", "time": 15526.07, "timestamp": "04:18:46", "text": "我。但是什么类型的呢？"}, {"type": "subtitle", "time": 15528.349, "timestamp": "04:18:48", "text": "是啊，也许只有我这么觉得。我不"}, {"type": "subtitle", "time": 15531.99, "timestamp": "04:18:51", "text": "知道。也许这只是个梗而已。乐趣"}, {"type": "subtitle", "time": 15534.309, "timestamp": "04:18:54", "text": "事实上，我沿着山路爬了一整座山。"}, {"type": "subtitle", "time": 15538.149, "timestamp": "04:18:58", "text": "从早到晚，和朋友在咖啡馆里消磨时光"}]
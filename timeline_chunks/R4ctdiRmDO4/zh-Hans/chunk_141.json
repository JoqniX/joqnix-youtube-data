[{"type": "subtitle", "time": 8462.95, "timestamp": "02:21:02", "text": "生活？好久不见了。是的，一直都是这样。"}, {"type": "subtitle", "time": 8490.71, "timestamp": "02:21:30", "text": "并非所有好人都会带来好结果，但生活并非如此。"}, {"type": "subtitle", "time": 8492.91, "timestamp": "02:21:32", "text": "不要为任何人停滞不前。没错，没错。"}, {"type": "subtitle", "time": 8496.75, "timestamp": "02:21:36", "text": "真的。将会遇到障碍"}, {"type": "subtitle", "time": 8501.11, "timestamp": "02:21:41", "text": "生活。我们都必须正面面对他们，不。"}, {"type": "subtitle", "time": 8503.469, "timestamp": "02:21:43", "text": "无论如何。"}]
[{"type": "subtitle", "time": 6133.87, "timestamp": "01:42:13", "text": "是的。我的上帝。你现在为什么哭了？哦，我的"}, {"type": "subtitle", "time": 6136.669, "timestamp": "01:42:16", "text": "上帝。不，这里其实有干净的水。"}, {"type": "subtitle", "time": 6139.27, "timestamp": "01:42:19", "text": "你在哪里看到的？这是不"}, {"type": "subtitle", "time": 6141.109, "timestamp": "01:42:21", "text": "脏兮兮的，乱七八糟的。你可能"}, {"type": "subtitle", "time": 6144.229, "timestamp": "01:42:24", "text": "看过一些零散的视频片段吧？但"}, {"type": "subtitle", "time": 6155.27, "timestamp": "01:42:35", "text": "兄弟，我不知道该说什么。我不"}, {"type": "subtitle", "time": 6168.43, "timestamp": "01:42:48", "text": "说。直接站起来"}, {"type": "subtitle", "time": 6177.35, "timestamp": "01:42:57", "text": "什么？等待。我的天啊。我得把它打出来。"}]
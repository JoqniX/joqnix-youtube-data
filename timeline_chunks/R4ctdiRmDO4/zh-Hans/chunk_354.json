[{"type": "subtitle", "time": 21245.99, "timestamp": "05:54:05", "text": "知道。但不要走。就像"}, {"type": "subtitle", "time": 21250.7, "timestamp": "05:54:10", "text": "时间。你不觉得吗？"}, {"type": "subtitle", "time": 21257.83, "timestamp": "05:54:17", "text": "那？我不知道。或许只是"}, {"type": "subtitle", "time": 21261.19, "timestamp": "05:54:21", "text": "冒名顶替综合症"}, {"type": "subtitle", "time": 21263.51, "timestamp": "05:54:23", "text": "呃，打我。我不能，我的意思是，我总是"}, {"type": "subtitle", "time": 21266.548, "timestamp": "05:54:26", "text": "我有这种冲动症，但是再次"}, {"type": "subtitle", "time": 21275.868, "timestamp": "05:54:35", "text": "这让我仍然认为我没做过。"}, {"type": "subtitle", "time": 21281.31, "timestamp": "05:54:41", "text": "[音乐]"}, {"type": "subtitle", "time": 21285.27, "timestamp": "05:54:45", "text": "也。那不就是异世界动漫吗？"}, {"type": "subtitle", "time": 21287.948, "timestamp": "05:54:47", "text": "比如"}, {"type": "subtitle", "time": 21291.83, "timestamp": "05:54:51", "text": "那？我忘了那部动画的名字。"}, {"type": "subtitle", "time": 21293.708, "timestamp": "05:54:53", "text": "如果我得到"}, {"type": "subtitle", "time": 21295.628, "timestamp": "05:54:55", "text": "伊萨凯？你相信吗？"}]
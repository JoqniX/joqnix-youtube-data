[{"type": "subtitle", "time": 21061.83, "timestamp": "05:51:01", "text": "是的，我明白了。我得到它。我通常会这样做"}, {"type": "subtitle", "time": 21064.99, "timestamp": "05:51:04", "text": "在 Twitch 上。我醒来时"}, {"type": "subtitle", "time": 21068.35, "timestamp": "05:51:08", "text": "凌晨3点直播"}, {"type": "subtitle", "time": 21071.708, "timestamp": "05:51:11", "text": "溪流。逃学。流媒体"}, {"type": "subtitle", "time": 21076.708, "timestamp": "05:51:16", "text": "溪流。呃，然后睡一两个小时。"}, {"type": "subtitle", "time": 21078.788, "timestamp": "05:51:18", "text": "然后醒来，呃，然后呃，再次醒来"}, {"type": "subtitle", "time": 21081.788, "timestamp": "05:51:21", "text": "3:00。开始直播。溪流"}, {"type": "subtitle", "time": 21085.75, "timestamp": "05:51:25", "text": "溪流。嗯，对，就是这样。逃学"}, {"type": "subtitle", "time": 21088.948, "timestamp": "05:51:28", "text": "或者，如果，呃，如果是，如果是"}, {"type": "subtitle", "time": 21090.47, "timestamp": "05:51:30", "text": "上学需要的东西"}, {"type": "subtitle", "time": 21092.47, "timestamp": "05:51:32", "text": "比如如果我的出勤情况"}, {"type": "subtitle", "time": 21094.628, "timestamp": "05:51:34", "text": "事情进展得不太顺利，那我得……"}, {"type": "subtitle", "time": 21096.15, "timestamp": "05:51:36", "text": "比如，7点结束直播，然后……"}, {"type": "subtitle", "time": 21098.31, "timestamp": "05:51:38", "text": "我用的是后退帧和流帧。"}, {"type": "subtitle", "time": 21101.59, "timestamp": "05:51:41", "text": "以前星期六要做的事情是"}, {"type": "subtitle", "time": 21105.948, "timestamp": "05:51:45", "text": "比如48小时直播"}, {"type": "subtitle", "time": 21108.67, "timestamp": "05:51:48", "text": "抽搐"}, {"type": "subtitle", "time": 21112.19, "timestamp": "05:51:52", "text": "伙计，但如果你去查看我的统计数据的话……"}, {"type": "subtitle", "time": 21116.47, "timestamp": "05:51:56", "text": "对，你可能看不到那40个。"}, {"type": "subtitle", "time": 21118.39, "timestamp": "05:51:58", "text": "以前我经常直播好几个小时之类的。"}]
[{"type": "subtitle", "time": 3423.27, "timestamp": "00:57:03", "text": "因为，是的，我把一个桶拖进了某个地方"}, {"type": "subtitle", "time": 3425.99, "timestamp": "00:57:05", "text": "东西。我不应该……我的意思是，不应该"}, {"type": "subtitle", "time": 3428.27, "timestamp": "00:57:08", "text": "应该如此。"}, {"type": "subtitle", "time": 3434.789, "timestamp": "00:57:14", "text": "是啊，看看我现在在做什么"}, {"type": "subtitle", "time": 3437.829, "timestamp": "00:57:17", "text": "因为玩笑开得不成，所以就取消了。"}, {"type": "subtitle", "time": 3447.27, "timestamp": "00:57:27", "text": "有时候你想做某事"}, {"type": "subtitle", "time": 3450.549, "timestamp": "00:57:30", "text": "对于小型创作者来说，制作一个"}, {"type": "subtitle", "time": 3454.39, "timestamp": "00:57:34", "text": "机会或创造某事"}, {"type": "subtitle", "time": 3456.589, "timestamp": "00:57:36", "text": "帮助他们的未来"}, {"type": "subtitle", "time": 3460.19, "timestamp": "00:57:40", "text": "生长。是啊，谁知道呢。"}, {"type": "subtitle", "time": 3463.549, "timestamp": "00:57:43", "text": "失败后，他们会反过来对你说："}, {"type": "subtitle", "time": 3465.99, "timestamp": "00:57:45", "text": "“是啊，现在这招不管用了。”但"}, {"type": "subtitle", "time": 3467.15, "timestamp": "00:57:47", "text": "真的吗，"}, {"type": "subtitle", "time": 3471.27, "timestamp": "00:57:51", "text": "是啊，你得去做你自己的事。"}, {"type": "subtitle", "time": 3473.15, "timestamp": "00:57:53", "text": "完全靠你自己。"}, {"type": "subtitle", "time": 3474.61, "timestamp": "00:57:54", "text": "片刻。出色地"}]
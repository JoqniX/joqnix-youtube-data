[{"type": "subtitle", "time": 14530.75, "timestamp": "04:02:10", "text": "見せる。私は何をしたのか"}, {"type": "subtitle", "time": 14532.95, "timestamp": "04:02:12", "text": "得る？その代わりに、私はこう言うだろう。"}, {"type": "subtitle", "time": 14535.03, "timestamp": "04:02:15", "text": "「みんなで私の"}, {"type": "subtitle", "time": 14537.269, "timestamp": "04:02:17", "text": "銀行口座？ 50/50。分けて。それからあなた"}, {"type": "subtitle", "time": 14539.51, "timestamp": "04:02:19", "text": "逃げ出すことができる。詐欺だと主張します"}, {"type": "subtitle", "time": 14543.63, "timestamp": "04:02:23", "text": "「保険をかけている」待って、詐欺って何？"}, {"type": "subtitle", "time": 14546.11, "timestamp": "04:02:26", "text": "保険？待って、"}, {"type": "subtitle", "time": 14548.67, "timestamp": "04:02:28", "text": "何？来る"}, {"type": "subtitle", "time": 14551.59, "timestamp": "04:02:31", "text": "私自身がそれを知らなかった。私はそうは思わない"}, {"type": "subtitle", "time": 14553.82, "timestamp": "04:02:33", "text": "これらのことに関して知識が豊富"}, {"type": "subtitle", "time": 14560.269, "timestamp": "04:02:40", "text": "もの。待って、私、このスキン持ってるよ。"}, {"type": "subtitle", "time": 14562.71, "timestamp": "04:02:42", "text": "待って。ああ、そうじゃない、そうじゃない。これは"}, {"type": "subtitle", "time": 14567.469, "timestamp": "04:02:47", "text": "別のもの。これは"}, {"type": "subtitle", "time": 14570.269, "timestamp": "04:02:50", "text": "C. シードラゴン"}, {"type": "subtitle", "time": 14574.349, "timestamp": "04:02:54", "text": "あれ。私が持っているもの"}, {"type": "subtitle", "time": 14578.03, "timestamp": "04:02:58", "text": "これですか。いいえ、違います"}]
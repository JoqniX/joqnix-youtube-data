[{"type": "subtitle", "time": 21480.708, "timestamp": "05:58:00", "text": "これはこれらすべてから完全に解放されるということですか？えっと、"}, {"type": "subtitle", "time": 21482.628, "timestamp": "05:58:02", "text": "休暇を取ったり、"}, {"type": "subtitle", "time": 21486.07, "timestamp": "05:58:06", "text": "もし私にマネージャーがいたら"}, {"type": "subtitle", "time": 21488.47, "timestamp": "05:58:08", "text": "スタッフか何か、誰か私を助けてくれる人"}, {"type": "subtitle", "time": 21494.15, "timestamp": "05:58:14", "text": "アニメを見るようなことですよね？の"}, {"type": "subtitle", "time": 21498.31, "timestamp": "05:58:18", "text": "スライムではないシーズン2"}, {"type": "subtitle", "time": 21501.67, "timestamp": "05:58:21", "text": "スライムアニメですが"}, {"type": "subtitle", "time": 21502.51, "timestamp": "05:58:22", "text": "えーと"}, {"type": "subtitle", "time": 21506.23, "timestamp": "05:58:26", "text": "私のケースのように、凧を持っているのは誰ですか"}, {"type": "subtitle", "time": 21509.35, "timestamp": "05:58:29", "text": "働きすぎで、働きすぎが好きで、"}, {"type": "subtitle", "time": 21513.19, "timestamp": "05:58:33", "text": "死んで、小さな凧を手に入れた"}, {"type": "subtitle", "time": 21516.47, "timestamp": "05:58:36", "text": "召喚者で、"}, {"type": "subtitle", "time": 21521.03, "timestamp": "05:58:41", "text": "そしてたくさんの使い魔を作りました"}, {"type": "subtitle", "time": 21524.788, "timestamp": "05:58:44", "text": "スライムと、開いたように"}, {"type": "subtitle", "time": 21528.51, "timestamp": "05:58:48", "text": "清掃店か何か。うん、それ"}, {"type": "subtitle", "time": 21531.868, "timestamp": "05:58:51", "text": "アニメの神々とか何か"}, {"type": "subtitle", "time": 21535.708, "timestamp": "05:58:55", "text": "何か。そのアニメを買わせてくれ"}, {"type": "subtitle", "time": 21538.07, "timestamp": "05:58:58", "text": "名前。あなたが知っている人、あなたが"}]
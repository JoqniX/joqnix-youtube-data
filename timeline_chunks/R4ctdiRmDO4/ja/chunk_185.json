[{"type": "subtitle", "time": 11100.389, "timestamp": "03:05:00", "text": "1つ。現在制作中のもの。の"}, {"type": "subtitle", "time": 11103.75, "timestamp": "03:05:03", "text": "これはJocknの公式モデルです。これは"}, {"type": "subtitle", "time": 11105.75, "timestamp": "03:05:05", "text": "あくまで概念の話です。初期コンセプト"}, {"type": "subtitle", "time": 11108.59, "timestamp": "03:05:08", "text": "デザインですよね？公式"}, {"type": "subtitle", "time": 11112.269, "timestamp": "03:05:12", "text": "モデル。ええ、公式モデルです。"}, {"type": "subtitle", "time": 11115.349, "timestamp": "03:05:15", "text": "うん。 2000年ではなく、リギングと"}, {"type": "subtitle", "time": 11124.309, "timestamp": "03:05:24", "text": "多くの。これは贈り物です"}, {"type": "subtitle", "time": 11126.19, "timestamp": "03:05:26", "text": "実は。友人"}, {"type": "subtitle", "time": 11131.11, "timestamp": "03:05:31", "text": "私の親友、ミムの息子。"}, {"type": "subtitle", "time": 11135.03, "timestamp": "03:05:35", "text": "Mimu Chama Mimi がそれを描いてリギングしました"}]
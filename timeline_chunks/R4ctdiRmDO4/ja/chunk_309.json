[{"type": "subtitle", "time": 18540.31, "timestamp": "05:09:00", "text": "今。わかった。えっと、コストが少し上がりました"}, {"type": "subtitle", "time": 18544.03, "timestamp": "05:09:04", "text": "オクタン価。料金。わかった。第5部。コスト"}, {"type": "subtitle", "time": 18547.708, "timestamp": "05:09:07", "text": "オクタン価。亡霊の亡霊"}, {"type": "subtitle", "time": 18550.75, "timestamp": "05:09:10", "text": "ヒューズ。わかった。私は亡霊を選びます"}, {"type": "subtitle", "time": 18552.868, "timestamp": "05:09:12", "text": "今。課題は少ない"}, {"type": "subtitle", "time": 18564.15, "timestamp": "05:09:24", "text": "さて皆さん、試合時間は12分でした。"}, {"type": "subtitle", "time": 18572.27, "timestamp": "05:09:32", "text": "どこかで見たことがあるな"}, {"type": "subtitle", "time": 18576.628, "timestamp": "05:09:36", "text": "名前？ 12分。 Twitchで見ますか？いくつかの"}, {"type": "subtitle", "time": 18586.55, "timestamp": "05:09:46", "text": "それ。私はとてもクールなスキンを手に入れました"}]
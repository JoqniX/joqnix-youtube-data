[{"type": "subtitle", "time": 17018.788, "timestamp": "04:43:38", "text": "もっとああいうショットを。よし、一つ必要だ"}, {"type": "subtitle", "time": 17021.27, "timestamp": "04:43:41", "text": "もっと殺せ。好きなことをすればいい"}, {"type": "subtitle", "time": 17023.03, "timestamp": "04:43:43", "text": "快適だし、うん。うん。うん。のように"}, {"type": "subtitle", "time": 17026.63, "timestamp": "04:43:46", "text": "それ。彼もまた死んだ。"}]
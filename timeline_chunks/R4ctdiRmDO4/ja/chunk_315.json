[{"type": "subtitle", "time": 18901.03, "timestamp": "05:15:01", "text": "私にとって。待って、そうする前に、"}, {"type": "subtitle", "time": 18904.07, "timestamp": "05:15:04", "text": "Nvidiaコントロールパネルを開いて修正する"}, {"type": "subtitle", "time": 18905.39, "timestamp": "05:15:05", "text": "いくつかの"}, {"type": "subtitle", "time": 18908.07, "timestamp": "05:15:08", "text": "もの。私はPCでゲームをプレイしていません"}, {"type": "subtitle", "time": 18910.67, "timestamp": "05:15:10", "text": "でも、6～7年くらいかな。"}, {"type": "subtitle", "time": 18914.788, "timestamp": "05:15:14", "text": "うわあ、すごく長いですね。"}, {"type": "subtitle", "time": 18918.07, "timestamp": "05:15:18", "text": "わかった。つまり、これは全画面表示になるはずです"}, {"type": "subtitle", "time": 18919.31, "timestamp": "05:15:19", "text": "あなた"}, {"type": "subtitle", "time": 18922.19, "timestamp": "05:15:22", "text": "みんな。あなたのために"}, {"type": "subtitle", "time": 18926.39, "timestamp": "05:15:26", "text": "みんな、フルスクリーンで表示する必要があるよ"}, {"type": "subtitle", "time": 18930.15, "timestamp": "05:15:30", "text": "君たち。 AVTGC 537になります。"}, {"type": "subtitle", "time": 18931.55, "timestamp": "05:15:31", "text": "捕獲"}, {"type": "subtitle", "time": 18935.39, "timestamp": "05:15:35", "text": "カード。それはAメディアライブゲーマーです"}, {"type": "subtitle", "time": 18939.11, "timestamp": "05:15:39", "text": "4K関連のもの。そうそう。このキャプチャカード"}, {"type": "subtitle", "time": 18943.788, "timestamp": "05:15:43", "text": "最大4K解像度、60fpsでの撮影が可能です。によって"}, {"type": "subtitle", "time": 18947.47, "timestamp": "05:15:47", "text": "方法。そして1080は"}, {"type": "subtitle", "time": 18951.67, "timestamp": "05:15:51", "text": "240。うん。だから、私はそれを買ったのは、"}, {"type": "subtitle", "time": 18953.83, "timestamp": "05:15:53", "text": "モニターのリフレッシュレートは"}, {"type": "subtitle", "time": 18957.03, "timestamp": "05:15:57", "text": "24から240。それで、なぜ"}]
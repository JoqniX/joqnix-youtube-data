[{"type": "subtitle", "time": 62.549, "timestamp": "00:01:02", "text": "多くの。わかった。明日の"}, {"type": "subtitle", "time": 66.91, "timestamp": "00:01:06", "text": "明後日。うん。明日の"}, {"type": "subtitle", "time": 68.67, "timestamp": "00:01:08", "text": "に"}, {"type": "subtitle", "time": 73.91, "timestamp": "00:01:13", "text": "明日。明後日、明日"}, {"type": "subtitle", "time": 76.71000000000001, "timestamp": "00:01:16", "text": "土曜日、日曜日。うん。日曜日は"}, {"type": "subtitle", "time": 78.55, "timestamp": "00:01:18", "text": "アストラ。はい。"}, {"type": "subtitle", "time": 80.03, "timestamp": "00:01:20", "text": "次"}, {"type": "subtitle", "time": 83.749, "timestamp": "00:01:23", "text": "今週、22日にRepoとのコラボレーションが行われます。えっと、それは"}, {"type": "subtitle", "time": 86.51, "timestamp": "00:01:26", "text": "それは、えっと"}, {"type": "subtitle", "time": 88.35, "timestamp": "00:01:28", "text": "木曜日。"}, {"type": "subtitle", "time": 91.95, "timestamp": "00:01:31", "text": "木曜日のJPコラボレーション"}, {"type": "subtitle", "time": 93.63, "timestamp": "00:01:33", "text": "の上"}, {"type": "subtitle", "time": 97.03, "timestamp": "00:01:37", "text": "土曜日。 JBとのコラボレーションは"}, {"type": "subtitle", "time": 99.27000000000001, "timestamp": "00:01:39", "text": "まだ計画されていません。日付は記載されていませんが"}, {"type": "subtitle", "time": 102.469, "timestamp": "00:01:42", "text": "来週です。来週中に"}, {"type": "subtitle", "time": 105.35, "timestamp": "00:01:45", "text": "しかし、それはまだ決定されていません。休む"}, {"type": "subtitle", "time": 107.67, "timestamp": "00:01:47", "text": "それらのうち、まだ決定されていないものはある。 1つ1つ私たちは"}, {"type": "subtitle", "time": 111.83, "timestamp": "00:01:51", "text": "ミアと一緒に、コル・カと一緒に"}, {"type": "subtitle", "time": 113.87, "timestamp": "00:01:53", "text": "コラボレーションは"}, {"type": "subtitle", "time": 117.59, "timestamp": "00:01:57", "text": "おそらく日本語で"}, {"type": "subtitle", "time": 119.35, "timestamp": "00:01:59", "text": "来週にしましょう。今週は予約でいっぱいです。"}]
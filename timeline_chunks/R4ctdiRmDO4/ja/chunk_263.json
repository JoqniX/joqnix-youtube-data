[{"type": "subtitle", "time": 15780.63, "timestamp": "04:23:00", "text": "聖なる主よ、"}, {"type": "subtitle", "time": 15802.87, "timestamp": "04:23:22", "text": "あなたのような人を見るために製粉所へ行きましょう。私"}, {"type": "subtitle", "time": 15806.63, "timestamp": "04:23:26", "text": "ASMRについてもっと深く掘り下げたいジョン"}, {"type": "subtitle", "time": 15809.13, "timestamp": "04:23:29", "text": "正直に言います。しかし"}, {"type": "subtitle", "time": 15810.59, "timestamp": "04:23:30", "text": "[音楽]"}, {"type": "subtitle", "time": 15813.75, "timestamp": "04:23:33", "text": "また、自分のASMRを聴くと、"}, {"type": "subtitle", "time": 15817.55, "timestamp": "04:23:37", "text": "あまり上達した気がしない。"}, {"type": "subtitle", "time": 15820.309, "timestamp": "04:23:40", "text": "しかし、それでも私は"}, {"type": "subtitle", "time": 15822.87, "timestamp": "04:23:42", "text": "向上したい。"}, {"type": "subtitle", "time": 15824.95, "timestamp": "04:23:44", "text": "いろいろ試してみたかったんです。しかし"}, {"type": "subtitle", "time": 15827.03, "timestamp": "04:23:47", "text": "また、"}, {"type": "subtitle", "time": 15831.83, "timestamp": "04:23:51", "text": "えっと、そういうのは持ってなかったよね？"}, {"type": "subtitle", "time": 15833.95, "timestamp": "04:23:53", "text": "もの"}, {"type": "subtitle", "time": 15836.71, "timestamp": "04:23:56", "text": "つまり、良いマイクは持っていないのですが"}]
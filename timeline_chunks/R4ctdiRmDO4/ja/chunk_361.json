[{"type": "subtitle", "time": 21661.83, "timestamp": "06:01:01", "text": "彼らにDMでいつも"}, {"type": "subtitle", "time": 21663.868, "timestamp": "06:01:03", "text": "このビリー・ビリーの質問"}, {"type": "subtitle", "time": 21667.07, "timestamp": "06:01:07", "text": "そして、助けを求めるようなこと"}, {"type": "subtitle", "time": 21670.43, "timestamp": "06:01:10", "text": "ああ神様、あの人だ"}, {"type": "subtitle", "time": 21675.628, "timestamp": "06:01:15", "text": "また。ああ、まずい瞬間だ。うん、私は"}, {"type": "subtitle", "time": 21678.91, "timestamp": "06:01:18", "text": "それ。それは自己中心的だ"}, {"type": "subtitle", "time": 21680.91, "timestamp": "06:01:20", "text": "えっと、あなたの"}, {"type": "subtitle", "time": 21683.99, "timestamp": "06:01:23", "text": "ある意味、やらなければならない利己的なこと。私"}, {"type": "subtitle", "time": 21685.788, "timestamp": "06:01:25", "text": "わからない。私"}, {"type": "subtitle", "time": 21696.1, "timestamp": "06:01:36", "text": "えっと、他のものも？"}, {"type": "subtitle", "time": 21697.868, "timestamp": "06:01:37", "text": "[音楽]"}, {"type": "subtitle", "time": 21701.27, "timestamp": "06:01:41", "text": "痛みが考えすぎでわからない"}, {"type": "subtitle", "time": 21703.51, "timestamp": "06:01:43", "text": "よくわからない瞬間、いつ"}, {"type": "subtitle", "time": 21706.11, "timestamp": "06:01:46", "text": "人々があなたにDMで尋ねています"}, {"type": "subtitle", "time": 21709.03, "timestamp": "06:01:49", "text": "そういう時は助けない"}, {"type": "subtitle", "time": 21711.19, "timestamp": "06:01:51", "text": "もし私が何かをしているのなら、考えてみてください"}, {"type": "subtitle", "time": 21715.43, "timestamp": "06:01:55", "text": "何か言ってみただけだけど、うん、私は自由だよ"}, {"type": "subtitle", "time": 21717.628, "timestamp": "06:01:57", "text": "そして助けになる"}]
[{"type": "subtitle", "time": 18600.19, "timestamp": "05:10:00", "text": "なぜ私のGPUは超高温になるのでしょうか？"}, {"type": "subtitle", "time": 18603.83, "timestamp": "05:10:03", "text": "今日？文字通り、もし私が手を置いたら"}, {"type": "subtitle", "time": 18606.55, "timestamp": "05:10:06", "text": "バックプレートでは、まるで"}, {"type": "subtitle", "time": 18609.27, "timestamp": "05:10:09", "text": "まるで鉄のように熱い。えっと、それは"}, {"type": "subtitle", "time": 18611.868, "timestamp": "05:10:11", "text": "いいえ、いいえ、"}, {"type": "subtitle", "time": 18614.39, "timestamp": "05:10:14", "text": "いいえ。どう思いますか？えっと、何ですか"}, {"type": "subtitle", "time": 18620.868, "timestamp": "05:10:20", "text": "わかった。あれは何て呼ぶの？"}, {"type": "subtitle", "time": 18623.75, "timestamp": "05:10:23", "text": "また？えっと、シャツのアイロンがけはどこでするの？"}, {"type": "subtitle", "time": 18627.23, "timestamp": "05:10:27", "text": "ドレスとかそういうのも好き。鉄製の箱。"}, {"type": "subtitle", "time": 18631.51, "timestamp": "05:10:31", "text": "待って。アイロンプレス機。いいえ。"}, {"type": "subtitle", "time": 18639.51, "timestamp": "05:10:39", "text": "また？うん。だから、手をかざすと"}, {"type": "subtitle", "time": 18642.868, "timestamp": "05:10:42", "text": "ここは本当に"}, {"type": "subtitle", "time": 18647.35, "timestamp": "05:10:47", "text": "本当に暑い。それはまるであなたが"}, {"type": "subtitle", "time": 18649.83, "timestamp": "05:10:49", "text": "まるであなたが手を伸ばして触れているような感じ"}, {"type": "subtitle", "time": 18653.59, "timestamp": "05:10:53", "text": "ろうそくの火のように、炎のように、そうでしょう？"}, {"type": "subtitle", "time": 18656.43, "timestamp": "05:10:56", "text": "あなたが感じるその痛みは"}]
[{"type": "subtitle", "time": 3240.15, "timestamp": "00:54:00", "text": "他の誰か、もしくは何か。もしあなたが"}, {"type": "subtitle", "time": 3242.27, "timestamp": "00:54:02", "text": "忙しいのは構いません。しかし"}, {"type": "subtitle", "time": 3245.43, "timestamp": "00:54:05", "text": "特に、もし私が"}, {"type": "subtitle", "time": 3249.27, "timestamp": "00:54:09", "text": "この特定の少数の人々"}, {"type": "subtitle", "time": 3252.63, "timestamp": "00:54:12", "text": "パキスタンなどの特定の協力関係、"}, {"type": "subtitle", "time": 3255.67, "timestamp": "00:54:15", "text": "日本のもの。私はただそうしたいだけです。"}, {"type": "subtitle", "time": 3257.829, "timestamp": "00:54:17", "text": "日本のもの。私はただもっと多くの人が欲しいだけです"}, {"type": "subtitle", "time": 3261.39, "timestamp": "00:54:21", "text": "実際には"}, {"type": "subtitle", "time": 3265.349, "timestamp": "00:54:25", "text": "だって私たちは持っているから、私は欲しいし、私は欲しくない"}, {"type": "subtitle", "time": 3267.91, "timestamp": "00:54:27", "text": "期待外れになるだろう。わかった。特に"}, {"type": "subtitle", "time": 3270.79, "timestamp": "00:54:30", "text": "パキスタンのもの。わからないけど、"}, {"type": "subtitle", "time": 3273.27, "timestamp": "00:54:33", "text": "今夜5時に返信をもらう"}, {"type": "subtitle", "time": 3274.589, "timestamp": "00:54:34", "text": "[音楽]"}, {"type": "subtitle", "time": 3276.829, "timestamp": "00:54:36", "text": "午前。"}, {"type": "subtitle", "time": 3279.91, "timestamp": "00:54:39", "text": "えっと、特に"}, {"type": "subtitle", "time": 3282.349, "timestamp": "00:54:42", "text": "パキスタンの学校"}, {"type": "subtitle", "time": 3286.95, "timestamp": "00:54:46", "text": "あれ。えっと、うまくいくといいな。"}, {"type": "subtitle", "time": 3291.67, "timestamp": "00:54:51", "text": "ええ、それは大惨事でした"}, {"type": "subtitle", "time": 3293.87, "timestamp": "00:54:53", "text": "コミュニケーションの問題"}, {"type": "subtitle", "time": 3299.79, "timestamp": "00:54:59", "text": "しかし"}]
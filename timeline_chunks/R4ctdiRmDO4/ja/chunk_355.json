[{"type": "subtitle", "time": 21302.07, "timestamp": "05:55:02", "text": "ニア？必ずしも感じる必要はありません"}, {"type": "subtitle", "time": 21305.03, "timestamp": "05:55:05", "text": "あなたのパフォーマンスの声。うん、"}, {"type": "subtitle", "time": 21307.35, "timestamp": "05:55:07", "text": "それもまた規律の問題だ。そして時間厳守は"}, {"type": "subtitle", "time": 21311.868, "timestamp": "05:55:11", "text": "1つ、1つ、1つの重要なこと、私が本当に必要なもの。"}, {"type": "subtitle", "time": 21313.99, "timestamp": "05:55:13", "text": "今日は時間厳守。どういうわけか、私は"}, {"type": "subtitle", "time": 21315.628, "timestamp": "05:55:15", "text": "10分でした"}, {"type": "subtitle", "time": 21318.07, "timestamp": "05:55:18", "text": "早い。 10分または5分前に"}, {"type": "subtitle", "time": 21319.99, "timestamp": "05:55:19", "text": "ストリーム。それは良い。"}, {"type": "subtitle", "time": 21321.5, "timestamp": "05:55:21", "text": "それはプラス点の一つだ"}, {"type": "subtitle", "time": 21324.03, "timestamp": "05:55:24", "text": "[音楽]"}, {"type": "subtitle", "time": 21327.43, "timestamp": "05:55:27", "text": "ポイント規律。この計画は何だったのか？"}, {"type": "subtitle", "time": 21328.81, "timestamp": "05:55:28", "text": "また？"}, {"type": "subtitle", "time": 21333.47, "timestamp": "05:55:33", "text": "[音楽]"}, {"type": "subtitle", "time": 21341.948, "timestamp": "05:55:41", "text": "痛み。十分な休息を取ること。うん、それ"}, {"type": "subtitle", "time": 21344.948, "timestamp": "05:55:44", "text": "あまりにも。つまり、私はそもそもあまり食べないんです。"}, {"type": "subtitle", "time": 21348.07, "timestamp": "05:55:48", "text": "それも重要な点です。"}, {"type": "subtitle", "time": 21351.27, "timestamp": "05:55:51", "text": "そしてスケジュール。つまり、私も合わせたいんです"}, {"type": "subtitle", "time": 21353.788, "timestamp": "05:55:53", "text": "スケジュール"}, {"type": "subtitle", "time": 21357.19, "timestamp": "05:55:57", "text": "でも、これを見て、私は"}, {"type": "subtitle", "time": 21359.15, "timestamp": "05:55:59", "text": "以下のストリーム"}]
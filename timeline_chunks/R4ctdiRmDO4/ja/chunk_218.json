[{"type": "subtitle", "time": 13082.19, "timestamp": "03:38:02", "text": "2人で続けて"}, {"type": "subtitle", "time": 13085.24, "timestamp": "03:38:05", "text": "瞬間。うん。うん。うん。"}, {"type": "subtitle", "time": 13103.63, "timestamp": "03:38:23", "text": "また。それは私が怖くなった瞬間だった"}, {"type": "subtitle", "time": 13105.309, "timestamp": "03:38:25", "text": "ない。"}, {"type": "subtitle", "time": 13108.67, "timestamp": "03:38:28", "text": "おお。これを見て"}, {"type": "subtitle", "time": 13127.63, "timestamp": "03:38:47", "text": "良い。ああ、彼は私の"}, {"type": "subtitle", "time": 13130.87, "timestamp": "03:38:50", "text": "B. アニメを見る。ええ、"}, {"type": "subtitle", "time": 13132.11, "timestamp": "03:38:52", "text": "たくさん見ている"}, {"type": "subtitle", "time": 13133.79, "timestamp": "03:38:53", "text": "アニメ。あなた"}, {"type": "subtitle", "time": 13136.63, "timestamp": "03:38:56", "text": "知ってるよ、もし私が"}]
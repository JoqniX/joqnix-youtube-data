[{"type": "subtitle", "time": 12360.15, "timestamp": "03:26:00", "text": "仕事に着いたら買うつもり？"}, {"type": "subtitle", "time": 12363.469, "timestamp": "03:26:03", "text": "待って、このファンが止まる"}, {"type": "subtitle", "time": 12367.63, "timestamp": "03:26:07", "text": "紡糸。今は以前より遅くなっています。待って、"}, {"type": "subtitle", "time": 12370.309, "timestamp": "03:26:10", "text": "何？ゲームを再開した方がいいでしょうか？私は思う"}, {"type": "subtitle", "time": 12372.83, "timestamp": "03:26:12", "text": "再開します"}, {"type": "subtitle", "time": 12375.349, "timestamp": "03:26:15", "text": "ゲーム。強く蹴られないように"}, {"type": "subtitle", "time": 12382.19, "timestamp": "03:26:22", "text": "2番。うん、"}, {"type": "subtitle", "time": 12389.429, "timestamp": "03:26:29", "text": "えっと、彼女は何の話をしていたんだっけ？おお"}, {"type": "subtitle", "time": 12390.349, "timestamp": "03:26:30", "text": "私の"}, {"type": "subtitle", "time": 12393.03, "timestamp": "03:26:33", "text": "神。お金の話。気をつけなければならない"}, {"type": "subtitle", "time": 12396.19, "timestamp": "03:26:36", "text": "それと共に。私はそれをこのように使うべきではない"}, {"type": "subtitle", "time": 12399.11, "timestamp": "03:26:39", "text": "それ。もちろん、私はこれらをこれらの"}, {"type": "subtitle", "time": 12401.63, "timestamp": "03:26:41", "text": "日。私は主に"}, {"type": "subtitle", "time": 12404.469, "timestamp": "03:26:44", "text": "ストリーミング配信みたいなもの。ストリーム専用"}, {"type": "subtitle", "time": 12407.349, "timestamp": "03:26:47", "text": "ゲーム関連のものではなく、そういうもの。"}, {"type": "subtitle", "time": 12409.19, "timestamp": "03:26:49", "text": "ストリーム関連のものだけ、"}, {"type": "subtitle", "time": 12410.349, "timestamp": "03:26:50", "text": "のように"}, {"type": "subtitle", "time": 12414.389, "timestamp": "03:26:54", "text": "広告は、主に"}, {"type": "subtitle", "time": 12416.91, "timestamp": "03:26:56", "text": "Patreonみたいに"}]
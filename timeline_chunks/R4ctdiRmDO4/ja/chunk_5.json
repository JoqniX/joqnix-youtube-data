[{"type": "subtitle", "time": 300.27, "timestamp": "00:05:00", "text": "赤村。"}, {"type": "subtitle", "time": 304.03, "timestamp": "00:05:04", "text": "ああ、どうすればあいつらを捕まえられるだろうか。"}, {"type": "subtitle", "time": 311.2, "timestamp": "00:05:11", "text": "仲間たちと"}, {"type": "subtitle", "time": 313.31, "timestamp": "00:05:13", "text": "[音楽]"}, {"type": "subtitle", "time": 315.67, "timestamp": "00:05:15", "text": "もの。彼らが森を置いたらどうなるだろうか"}, {"type": "subtitle", "time": 319.59, "timestamp": "00:05:19", "text": "来週コラボする？それじゃあ俺はもう終わりだ、兄弟。"}, {"type": "subtitle", "time": 322.629, "timestamp": "00:05:22", "text": "待って、もし彼らがポーラーとのコラボをそこに置いたら"}, {"type": "subtitle", "time": 325.59, "timestamp": "00:05:25", "text": "来週、私は、ああ、待って。私はそうしない"}, {"type": "subtitle", "time": 327.189, "timestamp": "00:05:27", "text": "日本人のおかげで参加できた"}, {"type": "subtitle", "time": 332.07, "timestamp": "00:05:32", "text": "コラボレーション。ああ、今週も待って、"}, {"type": "subtitle", "time": 343.67, "timestamp": "00:05:43", "text": "えーと、土曜日はホクルと一緒です。あ、待って。"}, {"type": "subtitle", "time": 346.39, "timestamp": "00:05:46", "text": "土曜の夜は富士山と一緒。ああ、ワープ"}, {"type": "subtitle", "time": 349.27, "timestamp": "00:05:49", "text": "雷。あ、あ、待って。入れるのを忘れた"}, {"type": "subtitle", "time": 354.95, "timestamp": "00:05:54", "text": "これは何ですか？こんにちは、RPG。私たちは私は作ります私は"}, {"type": "subtitle", "time": 356.79, "timestamp": "00:05:56", "text": "このコラボレーションのスケジュールを公開します"}, {"type": "subtitle", "time": 359.43, "timestamp": "00:05:59", "text": "今月と来月。私たちは"}]
[{"type": "subtitle", "time": 3601.67, "timestamp": "01:00:01", "text": "えっと、でも正直言って"}, {"type": "subtitle", "time": 3604.87, "timestamp": "01:00:04", "text": "みんな、正直言って"}, {"type": "subtitle", "time": 3607.95, "timestamp": "01:00:07", "text": "たくさんの人とコラボレーションしたい"}, {"type": "subtitle", "time": 3610.63, "timestamp": "01:00:10", "text": "人々。私は自分のイベントのためにやっているわけではありません。"}, {"type": "subtitle", "time": 3613.349, "timestamp": "01:00:13", "text": "そして、私がそうするのは、そうしたいからなんです。私"}, {"type": "subtitle", "time": 3618.23, "timestamp": "01:00:18", "text": "大切な人たちを引きずり回すのが大好きで"}, {"type": "subtitle", "time": 3619.71, "timestamp": "01:00:19", "text": "繋がりたい"}, {"type": "subtitle", "time": 3622.99, "timestamp": "01:00:22", "text": "何かをすること"}, {"type": "subtitle", "time": 3624.67, "timestamp": "01:00:24", "text": "一緒に"}, {"type": "subtitle", "time": 3629.23, "timestamp": "01:00:29", "text": "やりたいことがあったから"}, {"type": "subtitle", "time": 3632.549, "timestamp": "01:00:32", "text": "でも、先月か"}, {"type": "subtitle", "time": 3635.43, "timestamp": "01:00:35", "text": "適切な計画を立てなければ、"}, {"type": "subtitle", "time": 3637.349, "timestamp": "01:00:37", "text": "もっと多くのことができたはずなのに。私は自分のことに集中しました"}, {"type": "subtitle", "time": 3646.43, "timestamp": "01:00:46", "text": "さあ、私を見て"}, {"type": "subtitle", "time": 3655.87, "timestamp": "01:00:55", "text": "コラボレーションですが"}, {"type": "subtitle", "time": 3658.71, "timestamp": "01:00:58", "text": "そう、問題は半分のPEの半分だ"}]
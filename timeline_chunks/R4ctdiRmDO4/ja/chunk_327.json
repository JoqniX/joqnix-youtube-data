[{"type": "subtitle", "time": 19621.03, "timestamp": "05:27:01", "text": "住んでいるとどんな感じか"}, {"type": "subtitle", "time": 19623.51, "timestamp": "05:27:03", "text": "南極大陸のような、あるいはとても寒い"}, {"type": "subtitle", "time": 19627.55, "timestamp": "05:27:07", "text": "マイナス0やマイナス1のような場所"}, {"type": "subtitle", "time": 19631.59, "timestamp": "05:27:11", "text": "摂氏度のような場所ですね"}, {"type": "subtitle", "time": 19634.35, "timestamp": "05:27:14", "text": "まるで昔は"}, {"type": "subtitle", "time": 19638.11, "timestamp": "05:27:18", "text": "実験、ああ、なんてことだ、そしてそれも私たち"}, {"type": "subtitle", "time": 19640.948, "timestamp": "05:27:20", "text": "薄着をしていると、そう思った"}, {"type": "subtitle", "time": 19643.83, "timestamp": "05:27:23", "text": "厚手の服ではなく、毛布さえも"}, {"type": "subtitle", "time": 19645.548, "timestamp": "05:27:25", "text": "いや、"}, {"type": "subtitle", "time": 19650.628, "timestamp": "05:27:30", "text": "ベッドシーツのようなものではなく、"}, {"type": "subtitle", "time": 19653.19, "timestamp": "05:27:33", "text": "自分を覆うためのシート、あるいは何か他のもののようなもの。"}, {"type": "subtitle", "time": 19655.11, "timestamp": "05:27:35", "text": "ベッドに横になった"}, {"type": "subtitle", "time": 19660.35, "timestamp": "05:27:40", "text": "それ。そして、私がそれを耐え忍んだ間、"}, {"type": "subtitle", "time": 19665.03, "timestamp": "05:27:45", "text": "鳥肌が立ったとき、ああ"}, {"type": "subtitle", "time": 19667.548, "timestamp": "05:27:47", "text": "ああ、なんてことだ"}, {"type": "subtitle", "time": 19671.91, "timestamp": "05:27:51", "text": "日。わくわく。"}]
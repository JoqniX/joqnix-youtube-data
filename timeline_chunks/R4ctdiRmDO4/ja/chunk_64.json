[{"type": "subtitle", "time": 3845.19, "timestamp": "01:04:05", "text": "男。なあ、シーモアが恋しいよ。私たちはかつて教会の席に座っていました"}, {"type": "subtitle", "time": 3849.549, "timestamp": "01:04:09", "text": "ピューゲーム。スプリットゲートは昔よく遊んでいた"}, {"type": "subtitle", "time": 3896.87, "timestamp": "01:04:56", "text": "吉野と一緒に何かをしたかったのですが、"}, {"type": "subtitle", "time": 3898.589, "timestamp": "01:04:58", "text": "息子、"}]
[{"type": "subtitle", "time": 18360.15, "timestamp": "05:06:00", "text": "このカードに書いたゲームの提案です。"}, {"type": "subtitle", "time": 18362.39, "timestamp": "05:06:02", "text": "この車に積んでおこう。わかった。手に入れた"}, {"type": "subtitle", "time": 18366.19, "timestamp": "05:06:06", "text": "それ。わかった。はい、このカードに入れてください"}, {"type": "subtitle", "time": 18369.27, "timestamp": "05:06:09", "text": "それから。でも面白いことに"}, {"type": "subtitle", "time": 18373.03, "timestamp": "05:06:13", "text": "この平和維持部隊は、誰もが嫌っている。"}, {"type": "subtitle", "time": 18375.19, "timestamp": "05:06:15", "text": "ほとんどの人がApexをアンインストールする理由は"}, {"type": "subtitle", "time": 18377.07, "timestamp": "05:06:17", "text": "スペース"}, {"type": "subtitle", "time": 18381.55, "timestamp": "05:06:21", "text": "キーパー。 ML MLBB。 MLBBとは何ですか？携帯"}, {"type": "subtitle", "time": 18384.59, "timestamp": "05:06:24", "text": "リーグ・バンバン"}, {"type": "subtitle", "time": 18387.31, "timestamp": "05:06:27", "text": "伝説。モバイルレジェンド"}, {"type": "subtitle", "time": 18389.788, "timestamp": "05:06:29", "text": "バン・ドリーム。"}, {"type": "subtitle", "time": 18392.708, "timestamp": "05:06:32", "text": "待って。何だって？完全な形でもう一度。私"}, {"type": "subtitle", "time": 18396.19, "timestamp": "05:06:36", "text": "忘れた。モバイルレジェンドです。"}, {"type": "subtitle", "time": 18405.59, "timestamp": "05:06:45", "text": "ランクランク。みんながそうしているのを見たよ。の"}, {"type": "subtitle", "time": 18408.41, "timestamp": "05:06:48", "text": "ランク上げ。私は疑問に思う"}, {"type": "subtitle", "time": 18412.35, "timestamp": "05:06:52", "text": "[音楽]"}]
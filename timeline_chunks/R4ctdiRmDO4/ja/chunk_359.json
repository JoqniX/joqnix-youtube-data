[{"type": "subtitle", "time": 21540.15, "timestamp": "05:59:00", "text": "信頼し、そしてあなたを信頼する人。つまり、ある意味では"}, {"type": "subtitle", "time": 21552.39, "timestamp": "05:59:12", "text": "それ。それ、聞いたことがあるような気がする。ああ、私は"}, {"type": "subtitle", "time": 21554.35, "timestamp": "05:59:14", "text": "ない。私"}, {"type": "subtitle", "time": 21557.11, "timestamp": "05:59:17", "text": "ない。これは見なければならない。忘れた"}, {"type": "subtitle", "time": 21558.59, "timestamp": "05:59:18", "text": "これについて。うん。"}, {"type": "subtitle", "time": 21565.75, "timestamp": "05:59:25", "text": "うん。うん。うん。うん。これは良い"}, {"type": "subtitle", "time": 21568.708, "timestamp": "05:59:28", "text": "1つ。そのアニメは良い作品だ。うん。"}, {"type": "subtitle", "time": 21569.868, "timestamp": "05:59:29", "text": "うん。近日公開"}, {"type": "subtitle", "time": 21577.75, "timestamp": "05:59:37", "text": "ええ、そうですね。ええと、私が頼らない理由"}, {"type": "subtitle", "time": 21579.83, "timestamp": "05:59:39", "text": "人々は皆忙しいようです"}, {"type": "subtitle", "time": 21582.27, "timestamp": "05:59:42", "text": "彼ら自身のもの"}, {"type": "subtitle", "time": 21584.948, "timestamp": "05:59:44", "text": "自分のことで忙しい"}, {"type": "subtitle", "time": 21588.31, "timestamp": "05:59:48", "text": "自分のストレスや自分の持ち物の問題"}, {"type": "subtitle", "time": 21591.83, "timestamp": "05:59:51", "text": "やらなきゃいけないと思うんだけど、もし紹介したら"}, {"type": "subtitle", "time": 21594.15, "timestamp": "05:59:54", "text": "ある日、私の物もそこに入り、彼らも感じます"}, {"type": "subtitle", "time": 21597.708, "timestamp": "05:59:57", "text": "ああ、面倒くさい"}]
[{"type": "subtitle", "time": 15960.55, "timestamp": "04:26:00", "text": "もしあなたがそれをやりたいなら、"}, {"type": "subtitle", "time": 15963.269, "timestamp": "04:26:03", "text": "あなたがそれをした方が良い、あなたは生きている"}, {"type": "subtitle", "time": 15967.87, "timestamp": "04:26:07", "text": "単独で、または背景がない場合のように"}, {"type": "subtitle", "time": 15970.83, "timestamp": "04:26:10", "text": "で起こっていること"}, {"type": "subtitle", "time": 15975.03, "timestamp": "04:26:15", "text": "アンテナだけを手に入れた。"}, {"type": "subtitle", "time": 15978.229, "timestamp": "04:26:18", "text": "イエス・キリスト。ベイビー、何か怪しいことでもあるの？"}, {"type": "subtitle", "time": 15980.91, "timestamp": "04:26:20", "text": "ああ、つまり"}, {"type": "subtitle", "time": 15989.189, "timestamp": "04:26:29", "text": "何？ええ、そうですね。最もリクエストの多かった"}, {"type": "subtitle", "time": 15991.59, "timestamp": "04:26:31", "text": "私からのロールプレイはヤンデレです"}, {"type": "subtitle", "time": 15996.469, "timestamp": "04:26:36", "text": "私が実験したジョックのやつ、または"}, {"type": "subtitle", "time": 15998.59, "timestamp": "04:26:38", "text": "練習した"}, {"type": "subtitle", "time": 16000.11, "timestamp": "04:26:40", "text": "誰か"}, {"type": "subtitle", "time": 16003.79, "timestamp": "04:26:43", "text": "でも見せるのが怖い"}, {"type": "subtitle", "time": 16013.75, "timestamp": "04:26:53", "text": "それ。好きです 欲しくない 欲しくない"}, {"type": "subtitle", "time": 16016.07, "timestamp": "04:26:56", "text": "ヤンデレジョークとして知られているか、"}, {"type": "subtitle", "time": 16019.189, "timestamp": "04:26:59", "text": "何か。わからない。怖くなるだろうな。"}]
[{"type": "subtitle", "time": 6195.47, "timestamp": "01:43:15", "text": "翻訳について何を言っているのですか？ああ、それ"}, {"type": "subtitle", "time": 6198.27, "timestamp": "01:43:18", "text": "時間、翻訳をどのように伝えていますか"}, {"type": "subtitle", "time": 6201.91, "timestamp": "01:43:21", "text": "男の子？これは一体どういうことなのか"}, {"type": "subtitle", "time": 6209.83, "timestamp": "01:43:29", "text": "翻訳はしません。だから私はこう思う、彼は"}, {"type": "subtitle", "time": 6211.31, "timestamp": "01:43:31", "text": "入力する"}, {"type": "subtitle", "time": 6213.47, "timestamp": "01:43:33", "text": "英語。だから私は読んでいます"}, {"type": "subtitle", "time": 6217.59, "timestamp": "01:43:37", "text": "それ。では、Googleでやってみます"}, {"type": "subtitle", "time": 6219.87, "timestamp": "01:43:39", "text": "翻訳する。"}, {"type": "subtitle", "time": 6223.55, "timestamp": "01:43:43", "text": "ええ、それらは清潔です"}, {"type": "subtitle", "time": 6229.51, "timestamp": "01:43:49", "text": "インドの水。あなたが"}, {"type": "subtitle", "time": 6237.629, "timestamp": "01:43:57", "text": "えーと声"}]
[{"type": "subtitle", "time": 21783.19, "timestamp": "06:03:03", "text": "一瞬？私が必要な時はいつでもここにいます"}, {"type": "subtitle", "time": 21785.39, "timestamp": "06:03:05", "text": "などなど。しかし"}, {"type": "subtitle", "time": 21788.31, "timestamp": "06:03:08", "text": "また、文字通り、私はそうしています。私は"}, {"type": "subtitle", "time": 21789.788, "timestamp": "06:03:09", "text": "のように"}, {"type": "subtitle", "time": 21795.83, "timestamp": "06:03:15", "text": "ああ、時には欲しいものが手に入らないこともある"}, {"type": "subtitle", "time": 21798.23, "timestamp": "06:03:18", "text": "あなたが頼まない限りは。ああ、それもそうだね。私"}, {"type": "subtitle", "time": 21799.788, "timestamp": "06:03:19", "text": "なんとなく理解できた"}, {"type": "subtitle", "time": 21803.708, "timestamp": "06:03:23", "text": "それ。しかしこのビリービリー"}, {"type": "subtitle", "time": 21807.51, "timestamp": "06:03:27", "text": "何か、私は人々に尋ねなければなりませんでした"}, {"type": "subtitle", "time": 21810.788, "timestamp": "06:03:30", "text": "物事についてよく知っている。"}, {"type": "subtitle", "time": 21812.868, "timestamp": "06:03:32", "text": "val であること、良いこと、または有効であることは良いことです"}, {"type": "subtitle", "time": 21819.83, "timestamp": "06:03:39", "text": "わがまま。うん。でも私は"}, {"type": "subtitle", "time": 21829.868, "timestamp": "06:03:49", "text": "感じる"}, {"type": "subtitle", "time": 21832.788, "timestamp": "06:03:52", "text": "無関心とか、"}, {"type": "subtitle", "time": 21836.19, "timestamp": "06:03:56", "text": "ジョッキーバーは私を"}, {"type": "subtitle", "time": 21839.59, "timestamp": "06:03:59", "text": "彼が助けを必要としているように"}]
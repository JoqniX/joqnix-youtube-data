[{"type": "subtitle", "time": 4988.79, "timestamp": "01:23:08", "text": "うん、寝ようとしてるんだけど、眠れないんだ"}, {"type": "subtitle", "time": 4990.47, "timestamp": "01:23:10", "text": "本当に。私は考えすぎてしまうし"}, {"type": "subtitle", "time": 4992.11, "timestamp": "01:23:12", "text": "いろいろ考えている"}, {"type": "subtitle", "time": 4993.34, "timestamp": "01:23:13", "text": "もっと。"}, {"type": "subtitle", "time": 5015.149, "timestamp": "01:23:35", "text": "少し。試してみて"}, {"type": "subtitle", "time": 5017.27, "timestamp": "01:23:37", "text": "瞑想する。目を閉じてください。保つ"}, {"type": "subtitle", "time": 5026.189, "timestamp": "01:23:46", "text": "考える"}, {"type": "subtitle", "time": 5029.47, "timestamp": "01:23:49", "text": "幸せについて"}, {"type": "chat", "time": 5030.992, "timestamp": "01:23:50", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "I tried"}, {"type": "subtitle", "time": 5032.229, "timestamp": "01:23:52", "text": "もの。ネガティブなことは考えないで。クリア"}, {"type": "subtitle", "time": 5033.629, "timestamp": "01:23:53", "text": "あなたの"}, {"type": "subtitle", "time": 5036.75, "timestamp": "01:23:56", "text": "頭。あなたの"}, {"type": "subtitle", "time": 5038.91, "timestamp": "01:23:58", "text": "周囲。私"}]
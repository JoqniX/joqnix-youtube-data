[{"type": "subtitle", "time": 13930.349, "timestamp": "03:52:10", "text": "最近のクリエイターは一つのことに固執しない"}, {"type": "subtitle", "time": 13933.75, "timestamp": "03:52:13", "text": "プラットフォームは2人のストリーマーのように"}, {"type": "subtitle", "time": 13936.429, "timestamp": "03:52:16", "text": "そのほとんどはYouTubeに、"}, {"type": "subtitle", "time": 13939.429, "timestamp": "03:52:19", "text": "すべて。ほとんどのユーチューバーは"}, {"type": "subtitle", "time": 13942.95, "timestamp": "03:52:22", "text": "ティックトック。しかし、TikTokのものは禁止されている。"}, {"type": "subtitle", "time": 13946.389, "timestamp": "03:52:26", "text": "TikTokでTikTokを使っている人たち"}, {"type": "subtitle", "time": 13948.79, "timestamp": "03:52:28", "text": "トック。彼らはYouTubeにショットを投稿し、"}, {"type": "subtitle", "time": 13953.189, "timestamp": "03:52:33", "text": "Instagramの解像度とFacebookの撮影"}, {"type": "subtitle", "time": 13955.269, "timestamp": "03:52:35", "text": "そういう類のもの。それは何という名前ですか？何"}, {"type": "subtitle", "time": 13958.67, "timestamp": "03:52:38", "text": "再び呼ばれたのですか？ Facebookウォッチ"}, {"type": "subtitle", "time": 13961.309, "timestamp": "03:52:41", "text": "もの。全て"}, {"type": "subtitle", "time": 13965.03, "timestamp": "03:52:45", "text": "かっこいいですね。"}, {"type": "subtitle", "time": 13967.269, "timestamp": "03:52:47", "text": "まあ、もし私のボールにバグがあって負けたら"}, {"type": "subtitle", "time": 13970.309, "timestamp": "03:52:50", "text": "彼女と私は恋に落ち、友達になった。"}, {"type": "subtitle", "time": 13973.229, "timestamp": "03:52:53", "text": "悲しくなるだろう。うん、同じ"}, {"type": "subtitle", "time": 13976.55, "timestamp": "03:52:56", "text": "あまりにも。まさにそういう状況なんです。私は"}, {"type": "subtitle", "time": 13977.96, "timestamp": "03:52:57", "text": "私は 私は今、"}]
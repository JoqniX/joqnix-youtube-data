[{"type": "subtitle", "time": 3423.27, "timestamp": "00:57:03", "text": "だって、バケツをどこかに引きずり込んだんだ"}, {"type": "subtitle", "time": 3425.99, "timestamp": "00:57:05", "text": "もの。私はそうするはずではなかった、つまり"}, {"type": "subtitle", "time": 3428.27, "timestamp": "00:57:08", "text": "そうするはずだった。"}, {"type": "subtitle", "time": 3434.789, "timestamp": "00:57:14", "text": "ええ、そして今、私がやっていることを見て"}, {"type": "subtitle", "time": 3437.829, "timestamp": "00:57:17", "text": "うまくいかなかったから、ジョーク大会になった。"}, {"type": "subtitle", "time": 3447.27, "timestamp": "00:57:27", "text": "何かをしたいとき"}, {"type": "subtitle", "time": 3450.549, "timestamp": "00:57:30", "text": "小規模なクリエイター向けで、"}, {"type": "subtitle", "time": 3454.39, "timestamp": "00:57:34", "text": "機会または何かを作る"}, {"type": "subtitle", "time": 3456.589, "timestamp": "00:57:36", "text": "彼らの将来を助ける"}, {"type": "subtitle", "time": 3460.19, "timestamp": "00:57:40", "text": "成長。ああ、何が起こるかわからないよ"}, {"type": "subtitle", "time": 3463.549, "timestamp": "00:57:43", "text": "失敗して戻ってきてこう言う、"}, {"type": "subtitle", "time": 3465.99, "timestamp": "00:57:45", "text": "「ああ、これはうまくいかないな。」しかし"}, {"type": "subtitle", "time": 3467.15, "timestamp": "00:57:47", "text": "本当に、"}, {"type": "subtitle", "time": 3471.27, "timestamp": "00:57:51", "text": "そうだよ、自分のやりたいことをやらなきゃ。"}, {"type": "subtitle", "time": 3473.15, "timestamp": "00:57:53", "text": "たった一人で。"}, {"type": "subtitle", "time": 3474.61, "timestamp": "00:57:54", "text": "一瞬。良い"}]
[{"type": "subtitle", "time": 180.47, "timestamp": "00:03:00", "text": "ええ、あと7つ入れなきゃ"}, {"type": "subtitle", "time": 182.63, "timestamp": "00:03:02", "text": "来週ここにいる人たち。いいえ、次"}, {"type": "subtitle", "time": 185.03, "timestamp": "00:03:05", "text": "今週と来週。うん。えっと、"}, {"type": "subtitle", "time": 188.43, "timestamp": "00:03:08", "text": "6月1日に3人"}, {"type": "subtitle", "time": 191.27, "timestamp": "00:03:11", "text": "週。現時点では時間がありません"}, {"type": "subtitle", "time": 192.589, "timestamp": "00:03:12", "text": "に"}, {"type": "subtitle", "time": 207.82999999999998, "timestamp": "00:03:27", "text": "勉強。わかった。えっと、ここからクイン"}, {"type": "subtitle", "time": 211.35, "timestamp": "00:03:31", "text": "右に進むには、これを変更する必要がありました。だから私は"}, {"type": "subtitle", "time": 217.71, "timestamp": "00:03:37", "text": "今日、職人へ数分"}, {"type": "subtitle", "time": 221.82999999999998, "timestamp": "00:03:41", "text": "前。うん。えっと、まだ決めてないんだけど"}, {"type": "subtitle", "time": 223.75, "timestamp": "00:03:43", "text": "ゲームだったが、彼女は夜を過ごしたかった"}, {"type": "subtitle", "time": 229.47, "timestamp": "00:03:49", "text": "スロット。ということで、来週の夜の時間帯ですね。"}, {"type": "subtitle", "time": 234.39, "timestamp": "00:03:54", "text": "つまり、4対4対6、あるいは3対6のタイムです。だから私は"}, {"type": "subtitle", "time": 236.71, "timestamp": "00:03:56", "text": "彼女と繋がって、私は"}, {"type": "subtitle", "time": 238.91, "timestamp": "00:03:58", "text": "Jに連絡を取ってください"}]
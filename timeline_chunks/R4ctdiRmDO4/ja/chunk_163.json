[{"type": "subtitle", "time": 9788.87, "timestamp": "02:43:08", "text": "だから私はコラボレーションして一緒に過ごしたかった"}, {"type": "subtitle", "time": 9790.51, "timestamp": "02:43:10", "text": "と"}, {"type": "subtitle", "time": 9794.27, "timestamp": "02:43:14", "text": "友人たちと共に"}, {"type": "subtitle", "time": 9796.349, "timestamp": "02:43:16", "text": "その間"}, {"type": "subtitle", "time": 9799.469, "timestamp": "02:43:19", "text": "私の取得"}, {"type": "subtitle", "time": 9811.55, "timestamp": "02:43:31", "text": "友達として"}, {"type": "subtitle", "time": 9814.27, "timestamp": "02:43:34", "text": "友人"}, {"type": "subtitle", "time": 9816.91, "timestamp": "02:43:36", "text": "それで、えっと、"}, {"type": "subtitle", "time": 9819.23, "timestamp": "02:43:39", "text": "私たちは"}, {"type": "subtitle", "time": 9821.69, "timestamp": "02:43:41", "text": "あまり追跡していない"}, {"type": "subtitle", "time": 9824.75, "timestamp": "02:43:44", "text": "[音楽]"}, {"type": "subtitle", "time": 9827.389, "timestamp": "02:43:47", "text": "フォペド・ウィー"}, {"type": "subtitle", "time": 9832.83, "timestamp": "02:43:52", "text": "私たちは、"}]
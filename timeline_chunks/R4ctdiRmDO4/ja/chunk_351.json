[{"type": "subtitle", "time": 21061.83, "timestamp": "05:51:01", "text": "うん、わかるよ。わかった。私は普段そうする"}, {"type": "subtitle", "time": 21064.99, "timestamp": "05:51:04", "text": "Twitchで配信されているやつです。私は"}, {"type": "subtitle", "time": 21068.35, "timestamp": "05:51:08", "text": "午前3時の配信"}, {"type": "subtitle", "time": 21071.708, "timestamp": "05:51:11", "text": "ストリーム。学校をサボる。ストリーム ストリーム"}, {"type": "subtitle", "time": 21076.708, "timestamp": "05:51:16", "text": "ストリーム。えっと、それから1、2時間寝ます。"}, {"type": "subtitle", "time": 21078.788, "timestamp": "05:51:18", "text": "それから目を覚まして、それからまた目を覚ます"}, {"type": "subtitle", "time": 21081.788, "timestamp": "05:51:21", "text": "3時00分。ストリーミングを開始します。ストリーム"}, {"type": "subtitle", "time": 21085.75, "timestamp": "05:51:25", "text": "ストリーム。ああ、そう、そんな感じ。学校をサボる"}, {"type": "subtitle", "time": 21088.948, "timestamp": "05:51:28", "text": "あるいは、もしそれがもしもしそれが"}, {"type": "subtitle", "time": 21090.47, "timestamp": "05:51:30", "text": "学校に行くために必要なもの、または"}, {"type": "subtitle", "time": 21092.47, "timestamp": "05:51:32", "text": "私の出席や"}, {"type": "subtitle", "time": 21094.628, "timestamp": "05:51:34", "text": "何かが起こっているので、"}, {"type": "subtitle", "time": 21096.15, "timestamp": "05:51:36", "text": "7:00までに配信を終了して、それから来る"}, {"type": "subtitle", "time": 21098.31, "timestamp": "05:51:38", "text": "バックとストリームフレーム、それが私が使ったものです"}, {"type": "subtitle", "time": 21101.59, "timestamp": "05:51:41", "text": "昔の土曜日にやっていたことは"}, {"type": "subtitle", "time": 21105.948, "timestamp": "05:51:45", "text": "48時間ストリーミングのように"}, {"type": "subtitle", "time": 21108.67, "timestamp": "05:51:48", "text": "Twitch"}, {"type": "subtitle", "time": 21112.19, "timestamp": "05:51:52", "text": "でも、もし私の統計情報をチェックしたら"}, {"type": "subtitle", "time": 21116.47, "timestamp": "05:51:56", "text": "そう、40くらいは見えないかもしれないね"}, {"type": "subtitle", "time": 21118.39, "timestamp": "05:51:58", "text": "何時間も配信したりしてたから、昔はやってたんだけど"}]
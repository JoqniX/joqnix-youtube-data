[{"type": "subtitle", "time": 12008.67, "timestamp": "03:20:08", "text": "うるさい。わかった。では、私がどうするか"}, {"type": "subtitle", "time": 12021.389, "timestamp": "03:20:21", "text": "オフ。ファンの割合は60％、52％、50％に戻りました"}, {"type": "subtitle", "time": 12024.19, "timestamp": "03:20:24", "text": "スピード。それでもまだ回転している。"}, {"type": "subtitle", "time": 12026.51, "timestamp": "03:20:26", "text": "良い。それは良い"}, {"type": "subtitle", "time": 12028.71, "timestamp": "03:20:28", "text": "成果だと思う。願っています。私はしません"}, {"type": "subtitle", "time": 12032.229, "timestamp": "03:20:32", "text": "知る。だから、今のところは、c をそのままにしておきます"}, {"type": "subtitle", "time": 12035.71, "timestamp": "03:20:35", "text": "えーと、サイドパネル"}, {"type": "subtitle", "time": 12039.469, "timestamp": "03:20:39", "text": "の上。フレームレートは"}, {"type": "subtitle", "time": 12046.51, "timestamp": "03:20:46", "text": "遅れ。"}, {"type": "subtitle", "time": 12049.99, "timestamp": "03:20:49", "text": "わーい。これは、"}, {"type": "subtitle", "time": 12056.309, "timestamp": "03:20:56", "text": "過ごした。フレームのようなものがあるにもかかわらず"}, {"type": "subtitle", "time": 12058.63, "timestamp": "03:20:58", "text": "レートの変動は、問題ありません。ほとんど"}]
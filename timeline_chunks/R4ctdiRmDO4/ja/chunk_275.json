[{"type": "subtitle", "time": 16500.07, "timestamp": "04:35:00", "text": "えっと、私はそういう風になりたくないし、"}, {"type": "subtitle", "time": 16501.91, "timestamp": "04:35:01", "text": "J Showとかに出演するとか"}, {"type": "subtitle", "time": 16504.99, "timestamp": "04:35:04", "text": "それ。 「ああ、なんてことだ、私のゲーム」も同じです"}, {"type": "subtitle", "time": 16508.949, "timestamp": "04:35:08", "text": "凍りついた。わかった。罵り言葉なども同様です"}, {"type": "subtitle", "time": 16514.67, "timestamp": "04:35:14", "text": "あなたが知っている"}, {"type": "subtitle", "time": 16517.83, "timestamp": "04:35:17", "text": "何？えっと、嘘はつけないけど、"}, {"type": "subtitle", "time": 16520.39, "timestamp": "04:35:20", "text": "今まで一度もなかった、まるで私はそうじゃない、まるで私は"}, {"type": "subtitle", "time": 16522.75, "timestamp": "04:35:22", "text": "まるで純粋な天使か何かみたいだ。"}, {"type": "subtitle", "time": 16525.869, "timestamp": "04:35:25", "text": "ノイ、私は願う、私は願う"}, {"type": "subtitle", "time": 16531.709, "timestamp": "04:35:31", "text": "しかし、ある意味で私は"}, {"type": "subtitle", "time": 16536.23, "timestamp": "04:35:36", "text": "それ。えっと、ずっと前に質問があったのですが"}, {"type": "subtitle", "time": 16540.551, "timestamp": "04:35:40", "text": "やはり、あまり好きではなかった。 Hなので"}, {"type": "subtitle", "time": 16543.869, "timestamp": "04:35:43", "text": "まるでキャラクターのように呼べる"}, {"type": "subtitle", "time": 16547.189, "timestamp": "04:35:47", "text": "開発について知っている"}, {"type": "subtitle", "time": 16550.31, "timestamp": "04:35:50", "text": "何かをするけれど、それをしたくないと感じる"}, {"type": "subtitle", "time": 16553.109, "timestamp": "04:35:53", "text": "拭き取らないものだから"}, {"type": "subtitle", "time": 16555.51, "timestamp": "04:35:55", "text": "何かで、または何かで、それから"}, {"type": "subtitle", "time": 16559.709, "timestamp": "04:35:59", "text": "やめて、こう考えてください"}]
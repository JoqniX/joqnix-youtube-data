[{"type": "subtitle", "time": 10517.51, "timestamp": "02:55:17", "text": "[音楽]"}, {"type": "subtitle", "time": 10521.269, "timestamp": "02:55:21", "text": "サブスクライバーが来ることは稀で、"}, {"type": "subtitle", "time": 10524.55, "timestamp": "02:55:24", "text": "Twitch で何か"}, {"type": "subtitle", "time": 10526.87, "timestamp": "02:55:26", "text": "YouTube のメンバーシップでは、人々は"}, {"type": "subtitle", "time": 10528.63, "timestamp": "02:55:28", "text": "そこでやってる理由は、"}, {"type": "subtitle", "time": 10532.469, "timestamp": "02:55:32", "text": "私の会員ティアが今より安いのは"}, {"type": "subtitle", "time": 10535.75, "timestamp": "02:55:35", "text": "最低価格の30ルピー"}, {"type": "subtitle", "time": 10540.429, "timestamp": "02:55:40", "text": "YouTubeやTwitchで可能、"}, {"type": "subtitle", "time": 10543.349, "timestamp": "02:55:43", "text": "えっと、それは私が回転できるという意味ですか"}, {"type": "subtitle", "time": 10549.67, "timestamp": "02:55:49", "text": "心配事。もちろん、もちろんです。いいえ"}, {"type": "subtitle", "time": 10552.309, "timestamp": "02:55:52", "text": "心配事。つまり、もしあなたが望むなら"}, {"type": "subtitle", "time": 10554.15, "timestamp": "02:55:54", "text": "ルーレットを回して、私に教えてくれてもよかったのに。"}, {"type": "subtitle", "time": 10557.269, "timestamp": "02:55:57", "text": "それ。つまり、つまり、この時点で私は"}, {"type": "subtitle", "time": 10559.91, "timestamp": "02:55:59", "text": "気にしなくなった"}]
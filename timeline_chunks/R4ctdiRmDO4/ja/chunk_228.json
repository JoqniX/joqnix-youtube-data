[{"type": "subtitle", "time": 13680.67, "timestamp": "03:48:00", "text": "それはGPチャマです。何と言えばいいだろうか"}, {"type": "subtitle", "time": 13684.51, "timestamp": "03:48:04", "text": "あなた？何てことだ。かわいいパンです"}, {"type": "subtitle", "time": 13687.59, "timestamp": "03:48:07", "text": "チャマ。彼の様子はどうですか？元気ですか、"}, {"type": "subtitle", "time": 13690.469, "timestamp": "03:48:10", "text": "ブレナ？ああ、ああ、待って。銃"}, {"type": "subtitle", "time": 13691.469, "timestamp": "03:48:11", "text": "見た目は"}, {"type": "subtitle", "time": 13694.63, "timestamp": "03:48:14", "text": "良い。ところで、その銃、すごくかっこいいですね。"}, {"type": "subtitle", "time": 13696.429, "timestamp": "03:48:16", "text": "これはイベントです"}, {"type": "subtitle", "time": 13700.6, "timestamp": "03:48:20", "text": "銃。わあ、これはすごい。"}, {"type": "subtitle", "time": 13722.67, "timestamp": "03:48:42", "text": "有名な"}, {"type": "subtitle", "time": 13725.55, "timestamp": "03:48:45", "text": "自分。私"}, {"type": "subtitle", "time": 13728.15, "timestamp": "03:48:48", "text": "意味、有名とか何であれ、"}, {"type": "subtitle", "time": 13730.349, "timestamp": "03:48:50", "text": "問題"}, {"type": "subtitle", "time": 13734.15, "timestamp": "03:48:54", "text": "終わり。そうそう。私は実際にそう感じました"}, {"type": "subtitle", "time": 13737.11, "timestamp": "03:48:57", "text": "実際、話が出てくると"}, {"type": "subtitle", "time": 13738.91, "timestamp": "03:48:58", "text": "これについて"}]
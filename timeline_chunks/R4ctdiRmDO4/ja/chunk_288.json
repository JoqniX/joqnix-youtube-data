[{"type": "subtitle", "time": 17281.51, "timestamp": "04:48:01", "text": "神。わかった。まあ、気にしないでください。なぜ"}, {"type": "subtitle", "time": 17283.27, "timestamp": "04:48:03", "text": "煙を入れるべきか？投げるべき"}, {"type": "subtitle", "time": 17285.51, "timestamp": "04:48:05", "text": "煙の代わりに手榴弾を使う。ええ、そうしました"}, {"type": "subtitle", "time": 17288.15, "timestamp": "04:48:08", "text": "それ。そうそう。ええ、さっきやりました"}, {"type": "subtitle", "time": 17290.15, "timestamp": "04:48:10", "text": "撃たれたとき、忘れてしまった"}, {"type": "subtitle", "time": 17291.31, "timestamp": "04:48:11", "text": "する"}, {"type": "subtitle", "time": 17294.43, "timestamp": "04:48:14", "text": "それ。私の"}, {"type": "subtitle", "time": 17300.31, "timestamp": "04:48:20", "text": "悪い。動きが鈍いけど、大丈夫だよ。"}, {"type": "subtitle", "time": 17302.55, "timestamp": "04:48:22", "text": "そう、別のユーザーが"}, {"type": "subtitle", "time": 17304.47, "timestamp": "04:48:24", "text": "同名。"}, {"type": "subtitle", "time": 17308.07, "timestamp": "04:48:28", "text": "だから両方を混同したくなかったのは、"}, {"type": "subtitle", "time": 17310.628, "timestamp": "04:48:30", "text": "お二人とも同じ名前ですよね？"}, {"type": "subtitle", "time": 17314.07, "timestamp": "04:48:34", "text": "シャ。だから私はあなたに電話をかけているのです"}, {"type": "subtitle", "time": 17316.31, "timestamp": "04:48:36", "text": "私が何度もあなたに電話しているように。私は願っています"}, {"type": "subtitle", "time": 17322.99, "timestamp": "04:48:42", "text": "うん。うん。"}, {"type": "subtitle", "time": 17332.19, "timestamp": "04:48:52", "text": "だから私は彼らを一度も見たことがない"}, {"type": "subtitle", "time": 17335.03, "timestamp": "04:48:55", "text": "けれど。ジョッキー、私のハグはどこ？あなたは欲しい"}, {"type": "subtitle", "time": 17336.35, "timestamp": "04:48:56", "text": "1"}, {"type": "subtitle", "time": 17339.59, "timestamp": "04:48:59", "text": "ハグ？どのようにハグすればいいですか？"}]
[{"type": "subtitle", "time": 20405.868, "timestamp": "05:40:05", "text": "来ることを意味する"}, {"type": "subtitle", "time": 20412.67, "timestamp": "05:40:12", "text": "今日。楽しんでいただけたでしょうか。"}, {"type": "subtitle", "time": 20415.43, "timestamp": "05:40:15", "text": "今日。お越しいただきありがとうございます。私"}, {"type": "subtitle", "time": 20417.07, "timestamp": "05:40:17", "text": "本当に"}, {"type": "subtitle", "time": 20420.868, "timestamp": "05:40:20", "text": "今日までに来るという意味です。"}, {"type": "subtitle", "time": 20425.788, "timestamp": "05:40:25", "text": "本当にたくさん。あなたも楽しんでくれるといいな"}, {"type": "subtitle", "time": 20434.15, "timestamp": "05:40:34", "text": "今日。あなたも楽しんで、幸運を祈ります。"}, {"type": "subtitle", "time": 20437.628, "timestamp": "05:40:37", "text": "ランク部分モバイル付き"}, {"type": "subtitle", "time": 20441.11, "timestamp": "05:40:41", "text": "伝説。今日伺った方がいいでしょうか？私"}, {"type": "subtitle", "time": 20444.39, "timestamp": "05:40:44", "text": "誰一人見落としていないと信じています。そうそう、"}, {"type": "subtitle", "time": 20446.948, "timestamp": "05:40:46", "text": "忍者も。うん。うん。最後になりましたが、"}, {"type": "subtitle", "time": 20448.51, "timestamp": "05:40:48", "text": "少しでも、"}, {"type": "subtitle", "time": 20451.07, "timestamp": "05:40:51", "text": "ニンジャが来てくれてありがとう"}, {"type": "subtitle", "time": 20453.11, "timestamp": "05:40:53", "text": "今日。うん。うん。うん。わからない"}, {"type": "subtitle", "time": 20455.27, "timestamp": "05:40:55", "text": "なぜ君を最後に残しておいたのか、でも私は"}, {"type": "subtitle", "time": 20458.31, "timestamp": "05:40:58", "text": "忘れていました。そうそう。ありがとうございます"}]
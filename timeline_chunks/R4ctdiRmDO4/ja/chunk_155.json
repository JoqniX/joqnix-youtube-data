[{"type": "subtitle", "time": 9300.91, "timestamp": "02:35:00", "text": "布団。"}, {"type": "subtitle", "time": 9305.11, "timestamp": "02:35:05", "text": "いや、違うよ。私はいくつかのサーバーを残しました"}, {"type": "subtitle", "time": 9308.389, "timestamp": "02:35:08", "text": "Discordのデータを整理していました。あ、待って。私は"}, {"type": "subtitle", "time": 9310.99, "timestamp": "02:35:10", "text": "私の2つ目のアカウントで？"}, {"type": "subtitle", "time": 9314.23, "timestamp": "02:35:14", "text": "待って、私はもうそのコミュニティには所属していない。"}, {"type": "subtitle", "time": 9317.83, "timestamp": "02:35:17", "text": "ああ、私は彼女のこの物の中にいる。彼女はそうなのか？うん。"}, {"type": "subtitle", "time": 9319.15, "timestamp": "02:35:19", "text": "うん。うん、"}, {"type": "subtitle", "time": 9327.87, "timestamp": "02:35:27", "text": "彼女だよ、兄弟？それは"}, {"type": "subtitle", "time": 9329.99, "timestamp": "02:35:29", "text": "その間。上流工程を終える予定ですか？"}, {"type": "subtitle", "time": 9332.469, "timestamp": "02:35:32", "text": "いいえ、配信は継続されます。それは"}, {"type": "subtitle", "time": 9335.51, "timestamp": "02:35:35", "text": "ジョアソンですよね？ 24時間配信。私が行きます"}, {"type": "subtitle", "time": 9352.55, "timestamp": "02:35:52", "text": "その間。君が僕を好きじゃないことを願っていたんだ。私は"}, {"type": "subtitle", "time": 9354.75, "timestamp": "02:35:54", "text": "彼女とは関係ない"}, {"type": "subtitle", "time": 9358.11, "timestamp": "02:35:58", "text": "これまでずっと"}]
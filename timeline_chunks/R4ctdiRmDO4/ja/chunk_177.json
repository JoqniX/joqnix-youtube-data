[{"type": "subtitle", "time": 10623.469, "timestamp": "02:57:03", "text": "はぁ？"}, {"type": "subtitle", "time": 10626.91, "timestamp": "02:57:06", "text": "何？待って、それは何"}, {"type": "subtitle", "time": 10630.07, "timestamp": "02:57:10", "text": "平均？はぁ？"}, {"type": "subtitle", "time": 10635.03, "timestamp": "02:57:15", "text": "木の板のように板を持ちます"}, {"type": "subtitle", "time": 10637.429, "timestamp": "02:57:17", "text": "マインクラフトでは他のゲームでは"}, {"type": "subtitle", "time": 10643.79, "timestamp": "02:57:23", "text": "もの。"}, {"type": "subtitle", "time": 10647.79, "timestamp": "02:57:27", "text": "板。一体何なんだ"}, {"type": "subtitle", "time": 10650.63, "timestamp": "02:57:30", "text": "板？わかった。職業はなんですか？あなたは何を"}, {"type": "subtitle", "time": 10653.349, "timestamp": "02:57:33", "text": "質問を詳しく説明してください。"}, {"type": "subtitle", "time": 10655.309, "timestamp": "02:57:35", "text": "キャプテン"}, {"type": "subtitle", "time": 10659.67, "timestamp": "02:57:39", "text": "見た？あなたに会ったとき、あなたは何をしますか？"}, {"type": "subtitle", "time": 10662.389, "timestamp": "02:57:42", "text": "私は学生です。私は日本に行く予定です"}, {"type": "subtitle", "time": 10663.87, "timestamp": "02:57:43", "text": "言語について"}, {"type": "subtitle", "time": 10666.79, "timestamp": "02:57:46", "text": "研究。合格できません。私は手に入れなければならない"}, {"type": "subtitle", "time": 10671.429, "timestamp": "02:57:51", "text": "少なくとも2年以内にN2を取得して、"}, {"type": "subtitle", "time": 10674.469, "timestamp": "02:57:54", "text": "仕事に応募したり、その他諸々。だから私は"}, {"type": "subtitle", "time": 10676.71, "timestamp": "02:57:56", "text": "大学に入学しようとして"}, {"type": "subtitle", "time": 10678.63, "timestamp": "02:57:58", "text": "あちらの高等教育関連のもの"}]
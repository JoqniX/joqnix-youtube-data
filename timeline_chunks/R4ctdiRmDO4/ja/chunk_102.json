[{"type": "subtitle", "time": 6133.87, "timestamp": "01:42:13", "text": "うん。我が神よ。なぜ今泣いているの？ああ、"}, {"type": "subtitle", "time": 6136.669, "timestamp": "01:42:16", "text": "神。いいえ、実際にはきれいな水があります。"}, {"type": "subtitle", "time": 6139.27, "timestamp": "01:42:19", "text": "それってどこで見たの？それは"}, {"type": "subtitle", "time": 6141.109, "timestamp": "01:42:21", "text": "汚いとか汚いとか色々。あなたはそうするかもしれない"}, {"type": "subtitle", "time": 6144.229, "timestamp": "01:42:24", "text": "いくつかランダムなクリップを見たことがあるでしょう？しかし"}, {"type": "subtitle", "time": 6155.27, "timestamp": "01:42:35", "text": "何て言ったらいいのか分からないよ、兄弟。私はしません"}, {"type": "subtitle", "time": 6168.43, "timestamp": "01:42:48", "text": "言う。まっすぐ立ち上がる"}, {"type": "subtitle", "time": 6177.35, "timestamp": "01:42:57", "text": "何？待って。何てことだ。入力しなければならない"}]
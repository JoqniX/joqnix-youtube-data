[{"type": "subtitle", "time": 21721.47, "timestamp": "06:02:01", "text": "彼らは、そうですね、彼らを助けます"}, {"type": "subtitle", "time": 21724.548, "timestamp": "06:02:04", "text": "彼らと私は自分のことに集中しています"}, {"type": "subtitle", "time": 21727.03, "timestamp": "06:02:07", "text": "えっと、私が彼らの手伝いを終えるまで"}, {"type": "subtitle", "time": 21728.75, "timestamp": "06:02:08", "text": "の"}, {"type": "subtitle", "time": 21735.15, "timestamp": "06:02:15", "text": "いいえ。ええ。うん。うん。"}, {"type": "subtitle", "time": 21737.99, "timestamp": "06:02:17", "text": "うん。そんな感じですね。それからあなた"}, {"type": "subtitle", "time": 21739.07, "timestamp": "06:02:19", "text": "尋ねるべきだ"}, {"type": "subtitle", "time": 21743.68, "timestamp": "06:02:23", "text": "彼ら。ああ、でも私は"}, {"type": "subtitle", "time": 21750.87, "timestamp": "06:02:30", "text": "心配した。わからない。"}, {"type": "subtitle", "time": 21752.07, "timestamp": "06:02:32", "text": "[音楽]"}, {"type": "subtitle", "time": 21754.788, "timestamp": "06:02:34", "text": "問題は、彼らがそうすべきか、"}, {"type": "subtitle", "time": 21756.708, "timestamp": "06:02:36", "text": "助けを求めないのは、"}, {"type": "subtitle", "time": 21761.27, "timestamp": "06:02:41", "text": "あなたをいじめている。うーん、わからない。私"}, {"type": "subtitle", "time": 21763.31, "timestamp": "06:02:43", "text": "その意味"}, {"type": "subtitle", "time": 21766.47, "timestamp": "06:02:46", "text": "ほとんどの人がジョーは忙しいと思っている"}, {"type": "subtitle", "time": 21769.43, "timestamp": "06:02:49", "text": "すべてにおいて、そして彼もまた"}, {"type": "subtitle", "time": 21772.15, "timestamp": "06:02:52", "text": "忙しいこと、忙しい人、そしてその他"}, {"type": "subtitle", "time": 21775.75, "timestamp": "06:02:55", "text": "彼らは私に聞くのを避けているけど、私は「なぜ？」と思う"}, {"type": "subtitle", "time": 21778.23, "timestamp": "06:02:58", "text": "ヴァカ？なぜ私に助けを求めないのですか？"}, {"type": "subtitle", "time": 21779.788, "timestamp": "06:02:59", "text": "種の"}]
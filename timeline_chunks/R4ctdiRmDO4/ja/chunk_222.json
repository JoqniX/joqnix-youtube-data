[{"type": "subtitle", "time": 13321.55, "timestamp": "03:42:01", "text": "おお。ああ、"}, {"type": "subtitle", "time": 13324.309, "timestamp": "03:42:04", "text": "ドラゴン。うん。こんにちは、レイン君。どうやって"}, {"type": "subtitle", "time": 13325.63, "timestamp": "03:42:05", "text": "あなたは何をしていますか"}, {"type": "subtitle", "time": 13328.71, "timestamp": "03:42:08", "text": "今日？お元気でお過ごしでしょうか。うん、君"}, {"type": "subtitle", "time": 13332.07, "timestamp": "03:42:12", "text": "ちなみに、このスキンを入手してください。まるで"}, {"type": "subtitle", "time": 13335.15, "timestamp": "03:42:15", "text": "ハイビスカスや花のように"}, {"type": "subtitle", "time": 13337.83, "timestamp": "03:42:17", "text": "仙草。ええ、それはちょっと違う感じですね"}, {"type": "subtitle", "time": 13344.229, "timestamp": "03:42:24", "text": "ああ、やっとみんなの姿が見えるようになった。"}, {"type": "subtitle", "time": 13346.75, "timestamp": "03:42:26", "text": "他の皆さんは？あなたは何を"}, {"type": "subtitle", "time": 13348.75, "timestamp": "03:42:28", "text": "平均？"}, {"type": "subtitle", "time": 13350.83, "timestamp": "03:42:30", "text": "はぁ？"}, {"type": "subtitle", "time": 13354.59, "timestamp": "03:42:34", "text": "ああ、それであなたは"}, {"type": "subtitle", "time": 13358.84, "timestamp": "03:42:38", "text": "された？お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 13377.59, "timestamp": "03:42:57", "text": "私の側でくだらない不具合が発生したのかもしれません。"}]
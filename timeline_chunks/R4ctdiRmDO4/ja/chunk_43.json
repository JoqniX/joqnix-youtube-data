[{"type": "subtitle", "time": 2581.55, "timestamp": "00:43:01", "text": "私は感じます"}, {"type": "subtitle", "time": 2584.23, "timestamp": "00:43:04", "text": "外国人としては存在しない"}, {"type": "subtitle", "time": 2586.43, "timestamp": "00:43:06", "text": "この環境では成長するのは難しい"}, {"type": "subtitle", "time": 2589.03, "timestamp": "00:43:09", "text": "プラットフォームは、すべて中国語なので。"}, {"type": "subtitle", "time": 2594.15, "timestamp": "00:43:14", "text": "難しい。でも、確かにがっかりしました。"}, {"type": "subtitle", "time": 2595.99, "timestamp": "00:43:15", "text": "信じられない。これを見てください。あなたには"}, {"type": "subtitle", "time": 2599.99, "timestamp": "00:43:19", "text": "OBSを直接使用するにはフォロワーが5,000人必要です。"}, {"type": "subtitle", "time": 2602.069, "timestamp": "00:43:22", "text": "そうでなければ、彼ら自身のライブを使用する必要があります"}, {"type": "subtitle", "time": 2602.99, "timestamp": "00:43:22", "text": "ストリーミング"}, {"type": "subtitle", "time": 2606.069, "timestamp": "00:43:26", "text": "ソフトウェア。おいおい、一体どういうことだよ？"}, {"type": "subtitle", "time": 2608.71, "timestamp": "00:43:28", "text": "一体どういうことだ？これを使わなければならない"}, {"type": "subtitle", "time": 2612.43, "timestamp": "00:43:32", "text": "永久に使えるソフトウェア"}, {"type": "subtitle", "time": 2614.75, "timestamp": "00:43:34", "text": "今。私は"}, {"type": "subtitle", "time": 2618.73, "timestamp": "00:43:38", "text": "マルチリーム。私はこれを使いたくないのですが、"}, {"type": "subtitle", "time": 2621.309, "timestamp": "00:43:41", "text": "[音楽]"}, {"type": "subtitle", "time": 2630.829, "timestamp": "00:43:50", "text": "ちくしょう。これを隠しているのは"}, {"type": "subtitle", "time": 2639.27, "timestamp": "00:43:59", "text": "でも、そう、私はこれらの人たちに連絡を取るつもりです"}]
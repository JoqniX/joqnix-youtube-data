[{"type": "subtitle", "time": 2161.069, "timestamp": "00:36:01", "text": "セレスティア？"}, {"type": "subtitle", "time": 2165.71, "timestamp": "00:36:05", "text": "いや、待って。スキナじゃなかったの？私"}, {"type": "subtitle", "time": 2175.03, "timestamp": "00:36:15", "text": "ええ、そうですね。ええ、でもアタムスはできなかった"}, {"type": "subtitle", "time": 2178.39, "timestamp": "00:36:18", "text": "参加して、その間"}, {"type": "subtitle", "time": 2181.91, "timestamp": "00:36:21", "text": "数週間後、彼女はデビューを果たした。"}, {"type": "subtitle", "time": 2186.109, "timestamp": "00:36:26", "text": "その衣装デビューは彼女が忙しくなり、"}, {"type": "subtitle", "time": 2187.79, "timestamp": "00:36:27", "text": "もの"}, {"type": "subtitle", "time": 2190.99, "timestamp": "00:36:30", "text": "そして彼女は"}, {"type": "subtitle", "time": 2196.03, "timestamp": "00:36:36", "text": "詰め物をした"}, {"type": "subtitle", "time": 2218.63, "timestamp": "00:36:58", "text": "の上。社交的な土曜日。ああ、えーと、オメグル"}]
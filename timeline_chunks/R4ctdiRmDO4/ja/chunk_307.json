[{"type": "subtitle", "time": 18431.43, "timestamp": "05:07:11", "text": "はぁ？うーん、見た目が悪いですね。それが理由です。うん、"}, {"type": "subtitle", "time": 18434.868, "timestamp": "05:07:14", "text": "付け合わせみたいなもの。うん、まあ"}, {"type": "subtitle", "time": 18437.83, "timestamp": "05:07:17", "text": "その理由がわかる。また、それはある意味"}, {"type": "subtitle", "time": 18441.628, "timestamp": "05:07:21", "text": "古いバトルパスのリスキン"}, {"type": "subtitle", "time": 18444.75, "timestamp": "05:07:24", "text": "肌。それはある意味"}, {"type": "subtitle", "time": 18447.83, "timestamp": "05:07:27", "text": "方法。これはそれほど反応的なものではないでしょう。のみ"}, {"type": "subtitle", "time": 18450.15, "timestamp": "05:07:30", "text": "チョークのことですよね？それが唯一の"}, {"type": "subtitle", "time": 18452.27, "timestamp": "05:07:32", "text": "チョークのようなものだけが"}, {"type": "subtitle", "time": 18454.708, "timestamp": "05:07:34", "text": "反応的。だから人々はこう言うのです"}, {"type": "subtitle", "time": 18456.43, "timestamp": "05:07:36", "text": "醜い"}, {"type": "subtitle", "time": 18458.35, "timestamp": "05:07:38", "text": "あれかそれか"}, {"type": "subtitle", "time": 18466.948, "timestamp": "05:07:46", "text": "知る。私はそのゲームのプレイ映像を見た。私は"}, {"type": "subtitle", "time": 18472.948, "timestamp": "05:07:52", "text": "えーと、みんなこれにお金使うの？"}, {"type": "subtitle", "time": 18476.39, "timestamp": "05:07:56", "text": "でも、全体的には、"}, {"type": "subtitle", "time": 18478.948, "timestamp": "05:07:58", "text": "このイベントで私が気に入っている点はこれです"}]
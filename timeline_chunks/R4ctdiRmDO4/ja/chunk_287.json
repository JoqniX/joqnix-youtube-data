[{"type": "subtitle", "time": 17221.67, "timestamp": "04:47:01", "text": "主。ハイドラ、今日はどんな一日だった？つまり、"}, {"type": "subtitle", "time": 17224.55, "timestamp": "04:47:04", "text": "待って、まだ私に"}, {"type": "subtitle", "time": 17228.35, "timestamp": "04:47:08", "text": "ハイラという名前で続けてください。あなた"}, {"type": "subtitle", "time": 17231.19, "timestamp": "04:47:11", "text": "知ってる、私が行く理由を言ったっけ？"}, {"type": "subtitle", "time": 17233.07, "timestamp": "04:47:13", "text": "あなたの名前で、"}, {"type": "subtitle", "time": 17235.47, "timestamp": "04:47:15", "text": "ハジラ？それとも私は"}, {"type": "subtitle", "time": 17238.35, "timestamp": "04:47:18", "text": "ない？なぜなら、"}, {"type": "subtitle", "time": 17241.51, "timestamp": "04:47:21", "text": "他にも勇者さんがいたのでしょうか"}, {"type": "subtitle", "time": 17243.91, "timestamp": "04:47:23", "text": "同名の蘭国小次郎。彼らは"}, {"type": "subtitle", "time": 17246.628, "timestamp": "04:47:26", "text": "また、大きな"}, {"type": "subtitle", "time": 17250.628, "timestamp": "04:47:30", "text": "えっと、ほら、鬼滅の刃のファンです。だから彼らは"}, {"type": "subtitle", "time": 17253.868, "timestamp": "04:47:33", "text": "同じユーザー名を持っていた"}, {"type": "subtitle", "time": 17274.948, "timestamp": "04:47:54", "text": "25日。わかった。私は怖かった"}, {"type": "subtitle", "time": 17276.83, "timestamp": "04:47:56", "text": "若干。ああ、"}]
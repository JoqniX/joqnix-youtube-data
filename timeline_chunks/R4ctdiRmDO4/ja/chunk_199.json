[{"type": "subtitle", "time": 11948.349, "timestamp": "03:19:08", "text": "男。"}, {"type": "subtitle", "time": 11951.55, "timestamp": "03:19:11", "text": "ああ、回転させたよ。さあ行こう。やったよ"}, {"type": "subtitle", "time": 11954.15, "timestamp": "03:19:14", "text": "スピン。私はそれを回転させた。私は回転してみた。"}, {"type": "subtitle", "time": 11956.71, "timestamp": "03:19:16", "text": "待って、待って、待って、待って。私は回転してみた。"}, {"type": "subtitle", "time": 11959.269, "timestamp": "03:19:19", "text": "待って、聞こえる？あなたに"}, {"type": "subtitle", "time": 11960.51, "timestamp": "03:19:20", "text": "みんな聞いて"}, {"type": "subtitle", "time": 11962.83, "timestamp": "03:19:22", "text": "これ。私たちは"}, {"type": "subtitle", "time": 11967.63, "timestamp": "03:19:27", "text": "ファンを100%の回転速度で回転させることに成功しました。"}, {"type": "subtitle", "time": 11970.95, "timestamp": "03:19:30", "text": "力強いスピード。つまり、こうして"}, {"type": "subtitle", "time": 11974.15, "timestamp": "03:19:34", "text": "音。わかった。"}, {"type": "subtitle", "time": 11980.63, "timestamp": "03:19:40", "text": "それ？小さな小さな瘤のようなもの。しないで"}, {"type": "subtitle", "time": 11981.87, "timestamp": "03:19:41", "text": "心に留めて"}, {"type": "subtitle", "time": 11988.15, "timestamp": "03:19:48", "text": "それ？そう、それだ。それがその音だ"}, {"type": "subtitle", "time": 11995.95, "timestamp": "03:19:55", "text": "紡糸。"}]
[{"type": "subtitle", "time": 15542.59, "timestamp": "04:19:02", "text": "コーヒー8杯。待って、"}, {"type": "subtitle", "time": 15545.87, "timestamp": "04:19:05", "text": "何？考えてみてください"}, {"type": "subtitle", "time": 15549.83, "timestamp": "04:19:09", "text": "義務のように。うん。それで、その件は"}, {"type": "subtitle", "time": 15557.189, "timestamp": "04:19:17", "text": "時々私はそれを面倒な仕事だと感じる"}, {"type": "subtitle", "time": 15559.229, "timestamp": "04:19:19", "text": "あれのことですよね？"}, {"type": "subtitle", "time": 15562.71, "timestamp": "04:19:22", "text": "だから、もちろん、たとえ私が"}, {"type": "subtitle", "time": 15565.11, "timestamp": "04:19:25", "text": "まるで私が"}, {"type": "subtitle", "time": 15567.389, "timestamp": "04:19:27", "text": "安定した感じで、すべてが"}, {"type": "subtitle", "time": 15571.429, "timestamp": "04:19:31", "text": "他の皆と同じように、私は主に"}, {"type": "subtitle", "time": 15574.07, "timestamp": "04:19:34", "text": "ストリーミングを優先する"}, {"type": "subtitle", "time": 15576.95, "timestamp": "04:19:36", "text": "もの。うん、配信しなきゃいけないんだ。私はやらなければならなかった"}, {"type": "subtitle", "time": 15580.149, "timestamp": "04:19:40", "text": "それ。何事にも最善を尽くさなければならない。全て"}, {"type": "subtitle", "time": 15581.309, "timestamp": "04:19:41", "text": "それ"}, {"type": "subtitle", "time": 15583.99, "timestamp": "04:19:43", "text": "あれこれと、そういう類のもの。うん、私の"}, {"type": "subtitle", "time": 15586.63, "timestamp": "04:19:46", "text": "優先事項、そして私の最優先事項は"}, {"type": "subtitle", "time": 15589.59, "timestamp": "04:19:49", "text": "ストリーミング配信みたいなもの。なぜだかわからない"}, {"type": "subtitle", "time": 15592.79, "timestamp": "04:19:52", "text": "こうやって火をつけなきゃいけないんだ。まるで私が"}, {"type": "subtitle", "time": 15595.59, "timestamp": "04:19:55", "text": "物も重要です。これはそれです"}, {"type": "subtitle", "time": 15597.83, "timestamp": "04:19:57", "text": "そして、これもあれも重要です。おお、"}]
[{"type": "subtitle", "time": 9674.79, "timestamp": "02:41:14", "text": "わかった。私たちはあまり話していません。それは"}, {"type": "subtitle", "time": 9675.05, "timestamp": "02:41:15", "text": "の"}, {"type": "subtitle", "time": 9676.91, "timestamp": "02:41:16", "text": "[音楽]"}, {"type": "subtitle", "time": 9680.67, "timestamp": "02:41:20", "text": "もの。うん。こんにちは、愛しい人"}, {"type": "subtitle", "time": 9692.99, "timestamp": "02:41:32", "text": "長い間"}, {"type": "subtitle", "time": 9714.83, "timestamp": "02:41:54", "text": "良い。"}]
[{"type": "subtitle", "time": 16383.11, "timestamp": "04:33:03", "text": "ジョックヘッド。何の5月？何が何ですか"}, {"type": "subtitle", "time": 16403.91, "timestamp": "04:33:23", "text": "うん。それに、バカ、君は"}, {"type": "subtitle", "time": 16424.91, "timestamp": "04:33:44", "text": "若い？つまり、それは私が決めたルールみたいなものだ。"}, {"type": "subtitle", "time": 16429.31, "timestamp": "04:33:49", "text": "わかった。それは私が定めたルールのようなもの"}, {"type": "subtitle", "time": 16432.949, "timestamp": "04:33:52", "text": "だってある意味私は、ある意味私は"}, {"type": "subtitle", "time": 16434.109, "timestamp": "04:33:54", "text": "欲しくない"}, {"type": "subtitle", "time": 16436.67, "timestamp": "04:33:56", "text": "欲しい"}]
[{"type": "subtitle", "time": 20822.47, "timestamp": "05:47:02", "text": "最高。私はいつも、"}, {"type": "subtitle", "time": 20824.868, "timestamp": "05:47:04", "text": "時々後退するが、そうではない"}, {"type": "subtitle", "time": 20831.31, "timestamp": "05:47:11", "text": "D. ゴリラ"}, {"type": "subtitle", "time": 20834.868, "timestamp": "05:47:14", "text": "次。はい、ゴリラさん。ええ、今週は"}, {"type": "subtitle", "time": 20836.99, "timestamp": "05:47:16", "text": "ゴリラ作戦を実行する。"}, {"type": "subtitle", "time": 20839.99, "timestamp": "05:47:19", "text": "ゴリラ。でも、さっきも言ったように、私は"}, {"type": "subtitle", "time": 20843.47, "timestamp": "05:47:23", "text": "怠惰なように、とても怠惰なように、"}, {"type": "subtitle", "time": 20845.75, "timestamp": "05:47:25", "text": "ストリームのようなもの、または"}, {"type": "subtitle", "time": 20847.91, "timestamp": "05:47:27", "text": "何かをすること自体が、全く意味をなさない。それ"}, {"type": "subtitle", "time": 20851.75, "timestamp": "05:47:31", "text": "だから私はベストを尽くさなきゃいけないと思うんです"}, {"type": "subtitle", "time": 20852.99, "timestamp": "05:47:32", "text": "もっと"}, {"type": "subtitle", "time": 20858.11, "timestamp": "05:47:38", "text": "十分または良い"}, {"type": "subtitle", "time": 20861.35, "timestamp": "05:47:41", "text": "十分。ああ、私は自分のことを続けるよ"}, {"type": "subtitle", "time": 20862.59, "timestamp": "05:47:42", "text": "私のベスト。"}, {"type": "subtitle", "time": 20865.19, "timestamp": "05:47:45", "text": "ええ、でも私は参加をやめる必要がある"}, {"type": "subtitle", "time": 20867.67, "timestamp": "05:47:47", "text": "他のサーバーにあるようなVCとか何か"}, {"type": "subtitle", "time": 20870.31, "timestamp": "05:47:50", "text": "などなど。自分のことに集中して、"}, {"type": "subtitle", "time": 20872.948, "timestamp": "05:47:52", "text": "物が欲しいと思う、私は"}, {"type": "subtitle", "time": 20874.708, "timestamp": "05:47:54", "text": "そうしてください。うん。うん。うん。さもないと、"}, {"type": "subtitle", "time": 20876.15, "timestamp": "05:47:56", "text": "脇道に逸れて、脇道に逸れて、"}, {"type": "subtitle", "time": 20878.788, "timestamp": "05:47:58", "text": "話が脱線して、何も最後までやり遂げない。"}]
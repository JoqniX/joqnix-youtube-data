[{"type": "subtitle", "time": 17582.51, "timestamp": "04:53:02", "text": "PC？再起動したらどうなりますか？"}, {"type": "subtitle", "time": 17584.99, "timestamp": "04:53:04", "text": "PC？したい"}, {"type": "subtitle", "time": 17587.628, "timestamp": "04:53:07", "text": "知る。リスクを冒すべきだった"}, {"type": "subtitle", "time": 17591.47, "timestamp": "04:53:11", "text": "それ。よし、再起動してみよう"}, {"type": "subtitle", "time": 17595.31, "timestamp": "04:53:15", "text": "それから。うまくいくといいな"}, {"type": "subtitle", "time": 17598.67, "timestamp": "04:53:18", "text": "今。それは"}, {"type": "subtitle", "time": 17601.35, "timestamp": "04:53:21", "text": "改善する？もちろん、ファンは"}, {"type": "subtitle", "time": 17616.47, "timestamp": "04:53:36", "text": "最悪だ。私はたくさん録音することになっている"}, {"type": "subtitle", "time": 17619.07, "timestamp": "04:53:39", "text": "この動画"}, {"type": "subtitle", "time": 17622.55, "timestamp": "04:53:42", "text": "月。録画しないで、ビデオのようにする"}, {"type": "subtitle", "time": 17624.19, "timestamp": "04:53:44", "text": "これを詰め込む"}, {"type": "subtitle", "time": 17626.788, "timestamp": "04:53:46", "text": "月。チュートリアル用の1つは"}, {"type": "subtitle", "time": 17630.708, "timestamp": "04:53:50", "text": "Twitch配信について話しています。"}, {"type": "subtitle", "time": 17634.07, "timestamp": "04:53:54", "text": "えっと、Vになるだろうけど、私はただ"}, {"type": "subtitle", "time": 17636.948, "timestamp": "04:53:56", "text": "録音できるかどうかはわかりませんが、念のため録音してください。"}]
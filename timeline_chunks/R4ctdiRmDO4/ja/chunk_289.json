[{"type": "subtitle", "time": 17341.59, "timestamp": "04:49:01", "text": "頭を撫でられているのに"}, {"type": "subtitle", "time": 17344.59, "timestamp": "04:49:04", "text": "[音楽]"}, {"type": "subtitle", "time": 17353.83, "timestamp": "04:49:13", "text": "ハグ？そうそう。私はそうすべきだと思いますか？"}, {"type": "subtitle", "time": 17357.59, "timestamp": "04:49:17", "text": "ハグのように書く方が良いでしょうか"}, {"type": "subtitle", "time": 17359.47, "timestamp": "04:49:19", "text": "贈り物？ハグ"}, {"type": "subtitle", "time": 17363.43, "timestamp": "04:49:23", "text": "贈り物に替えますか？"}, {"type": "subtitle", "time": 17366.788, "timestamp": "04:49:26", "text": "それは本当に効果があるのだろうか？"}, {"type": "subtitle", "time": 17368.83, "timestamp": "04:49:28", "text": "Discord と"}, {"type": "subtitle", "time": 17372.07, "timestamp": "04:49:32", "text": "もの。ほとんどの人は"}, {"type": "subtitle", "time": 17374.03, "timestamp": "04:49:34", "text": "ボットが行う"}, {"type": "subtitle", "time": 17376.75, "timestamp": "04:49:36", "text": "感嘆または抱擁、そして他の何か"}, {"type": "subtitle", "time": 17382.948, "timestamp": "04:49:42", "text": "ああ、そうそう、昔はハグのコマンドがあったよね。"}, {"type": "subtitle", "time": 17385.75, "timestamp": "04:49:45", "text": "あれはどうなったの？ああ、神様、私は"}, {"type": "subtitle", "time": 17388.75, "timestamp": "04:49:48", "text": "それらを修正するために。うん、うん、うん、"}, {"type": "subtitle", "time": 17392.55, "timestamp": "04:49:52", "text": "うん。それを自分に言い聞かせなければならない。"}, {"type": "subtitle", "time": 17394.03, "timestamp": "04:49:54", "text": "うん、必要だ"}, {"type": "subtitle", "time": 17398.51, "timestamp": "04:49:58", "text": "ハギーコマンドなどを修正する"}]
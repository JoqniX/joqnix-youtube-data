[{"type": "subtitle", "time": 4860.79, "timestamp": "01:21:00", "text": "それは可能です。君ならできるよ、だって僕は"}, {"type": "subtitle", "time": 4865.11, "timestamp": "01:21:05", "text": "私は午前、午後、夕方があります"}, {"type": "subtitle", "time": 4867.99, "timestamp": "01:21:07", "text": "今月は無料枠をご用意しております。だから、私は親切です"}, {"type": "subtitle", "time": 4871.07, "timestamp": "01:21:11", "text": "人々にそれを記入させようとする"}, {"type": "subtitle", "time": 4874.07, "timestamp": "01:21:14", "text": "利用可能で無料であればスポットライト"}, {"type": "subtitle", "time": 4876.79, "timestamp": "01:21:16", "text": "なぜなら、今ではほとんどの人が夜を好むからだ。それで、"}, {"type": "subtitle", "time": 4881.03, "timestamp": "01:21:21", "text": "予約がすぐに埋まってしまうんです。"}, {"type": "subtitle", "time": 4883.75, "timestamp": "01:21:23", "text": "まだ7～8人いる"}, {"type": "subtitle", "time": 4887.43, "timestamp": "01:21:27", "text": "保留リストにまだ登録されていない人"}, {"type": "subtitle", "time": 4890.03, "timestamp": "01:21:30", "text": "それは確認されていません"}, {"type": "subtitle", "time": 4893.35, "timestamp": "01:21:33", "text": "まだ。面白いことに、私は追加しています"}, {"type": "subtitle", "time": 4896.63, "timestamp": "01:21:36", "text": "非常に多くの人々が、非常に多くの人々に手を差し伸べている"}, {"type": "subtitle", "time": 4898.709, "timestamp": "01:21:38", "text": "この時点で、もう日数が足りなくなる"}, {"type": "subtitle", "time": 4900.669, "timestamp": "01:21:40", "text": "協力する"}, {"type": "subtitle", "time": 4903.55, "timestamp": "01:21:43", "text": "評判で"}, {"type": "subtitle", "time": 4906.03, "timestamp": "01:21:46", "text": "試験担当者 イギリス"}, {"type": "subtitle", "time": 4909.51, "timestamp": "01:21:49", "text": "文学 西洋文学 すべての詩"}, {"type": "subtitle", "time": 4911.79, "timestamp": "01:21:51", "text": "あれ"}, {"type": "subtitle", "time": 4917.149, "timestamp": "01:21:57", "text": "ジョイアに何を頼んでいるの？"}]
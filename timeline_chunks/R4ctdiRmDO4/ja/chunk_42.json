[{"type": "subtitle", "time": 2520.15, "timestamp": "00:42:00", "text": "英語のビデオとか全部"}, {"type": "subtitle", "time": 2520.99, "timestamp": "00:42:00", "text": "彼女"}, {"type": "subtitle", "time": 2524.47, "timestamp": "00:42:04", "text": "ストリーム。これを見てください。ディブボーイ"}, {"type": "subtitle", "time": 2526.27, "timestamp": "00:42:06", "text": "モデルはとても"}, {"type": "subtitle", "time": 2529.51, "timestamp": "00:42:09", "text": "良い。雰囲気が全く違う。"}, {"type": "subtitle", "time": 2532.87, "timestamp": "00:42:12", "text": "中国人モデルは中国人ユーチューバー"}, {"type": "subtitle", "time": 2562.03, "timestamp": "00:42:42", "text": "うん。見えますか？"}, {"type": "subtitle", "time": 2564.67, "timestamp": "00:42:44", "text": "これ？うん。わかった。の"}, {"type": "subtitle", "time": 2574.23, "timestamp": "00:42:54", "text": "さて、問題は私がビリーを使わないということです"}, {"type": "subtitle", "time": 2576.55, "timestamp": "00:42:56", "text": "適切にコミュニケーションを取るためにアカウントを使用してください。私はしません"}, {"type": "subtitle", "time": 2579.589, "timestamp": "00:42:59", "text": "ここではTwitterのようにツイートすることもできます。"}]
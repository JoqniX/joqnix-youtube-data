[{"type": "subtitle", "time": 15366.07, "timestamp": "04:16:06", "text": "これ。水と適切な水分補給を忘れずに"}, {"type": "subtitle", "time": 15369.03, "timestamp": "04:16:09", "text": "急いでください。はい、はい、はい。暖かい、暖かい"}, {"type": "subtitle", "time": 15393.63, "timestamp": "04:16:33", "text": "やめてください。何てことだ。私は押し上げられたように立ち上がった"}, {"type": "subtitle", "time": 15396.469, "timestamp": "04:16:36", "text": "上。 H"}, {"type": "subtitle", "time": 15407.59, "timestamp": "04:16:47", "text": "しなかった"}]
[{"type": "subtitle", "time": 16628.15, "timestamp": "04:37:08", "text": "私とジョンは、分かっているけど、だからといって私が"}, {"type": "subtitle", "time": 16670.629, "timestamp": "04:37:50", "text": "王。私は王ではない。ああ、私はただあなたの"}, {"type": "subtitle", "time": 16671.949, "timestamp": "04:37:51", "text": "普通"}, {"type": "subtitle", "time": 16674.029, "timestamp": "04:37:54", "text": "喜び。私は違います"}, {"type": "subtitle", "time": 16677.629, "timestamp": "04:37:57", "text": "王。いいえ。あなたは王様です。"}]
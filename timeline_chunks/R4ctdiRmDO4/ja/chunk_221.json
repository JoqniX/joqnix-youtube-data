[{"type": "subtitle", "time": 13261.309, "timestamp": "03:41:01", "text": "鳴り響く"}, {"type": "subtitle", "time": 13264.51, "timestamp": "03:41:04", "text": "私は遠距離攻撃ができないので。"}, {"type": "subtitle", "time": 13272.429, "timestamp": "03:41:12", "text": "のように"}, {"type": "subtitle", "time": 13275.79, "timestamp": "03:41:15", "text": "ああ、そうだよ。ゲームがラグいので"}, {"type": "subtitle", "time": 13280.19, "timestamp": "03:41:20", "text": "たとえすべてが"}, {"type": "subtitle", "time": 13287.07, "timestamp": "03:41:27", "text": "の"}, {"type": "subtitle", "time": 13289.99, "timestamp": "03:41:29", "text": "金。新しいスキン。ああ、たくさんあるよ"}, {"type": "subtitle", "time": 13297.429, "timestamp": "03:41:37", "text": "アビ、それはまるでクールなウィングマンみたいだ"}, {"type": "subtitle", "time": 13300.63, "timestamp": "03:41:40", "text": "ズチのような肌。それはヘビです、"}, {"type": "subtitle", "time": 13304.19, "timestamp": "03:41:44", "text": "右？そう、ズチみたいなんだけど"}, {"type": "subtitle", "time": 13307.429, "timestamp": "03:41:47", "text": "ピンク。それはピンク色のジグソーパズルみたいだ。考えてみてください"}, {"type": "subtitle", "time": 13311.19, "timestamp": "03:41:51", "text": "そんな感じ。無料の肌。 R99が無料です"}]
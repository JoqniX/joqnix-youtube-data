[{"type": "subtitle", "time": 14280.11, "timestamp": "03:58:00", "text": "知ってるよ、"}, {"type": "subtitle", "time": 14282.469, "timestamp": "03:58:02", "text": "どこにも見つからないし、あなたは"}, {"type": "subtitle", "time": 14285.11, "timestamp": "03:58:05", "text": "知り合い、知り合い、または友達"}, {"type": "subtitle", "time": 14287.349, "timestamp": "03:58:07", "text": "あなたと話したり、そういうのが好きです"}, {"type": "subtitle", "time": 14290.07, "timestamp": "03:58:10", "text": "そしてある日、彼らはこう尋ねます。「あなたは"}, {"type": "subtitle", "time": 14294.15, "timestamp": "03:58:14", "text": "あなたのADAカードと、それから"}, {"type": "subtitle", "time": 14297.59, "timestamp": "03:58:17", "text": "あなたがADAの車を持っている写真"}, {"type": "subtitle", "time": 14300.95, "timestamp": "03:58:20", "text": "それらを返して、私を手伝ってください"}, {"type": "subtitle", "time": 14305.189, "timestamp": "03:58:25", "text": "あれこれ。実際に与えるだろうか"}, {"type": "subtitle", "time": 14309.03, "timestamp": "03:58:29", "text": "あなたは、"}, {"type": "subtitle", "time": 14312.55, "timestamp": "03:58:32", "text": "ご存知のように、他の誰よりも"}, {"type": "subtitle", "time": 14315.95, "timestamp": "03:58:35", "text": "3年または2年以上"}, {"type": "subtitle", "time": 14324.469, "timestamp": "03:58:44", "text": "一瞬。うん。それは痛みとなるだろう"}, {"type": "subtitle", "time": 14331.429, "timestamp": "03:58:51", "text": "痛み。 「おい、俺は"}, {"type": "subtitle", "time": 14338.63, "timestamp": "03:58:58", "text": "ああ、それもそうだね。中には"}]
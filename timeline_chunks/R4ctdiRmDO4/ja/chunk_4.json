[{"type": "chat", "time": 243.725, "timestamp": "00:04:03", "author": "@RPGfanatic-i3z", "avatar": "https://yt4.ggpht.com/F9kA73IKR7TCeh1WUg7fNOkjcUJ6lPk8I6j69xenF_vJcjZ4GCnCIeYo88hJF8jUU3OAOsYG=s64-c-k-c0x00ffffff-no-rj", "message": "What's up Joq?"}, {"type": "subtitle", "time": 248.07, "timestamp": "00:04:08", "text": "ああ、スタースケープ、いや、スタースケープ"}, {"type": "subtitle", "time": 249.55, "timestamp": "00:04:09", "text": "私は自分が"}, {"type": "subtitle", "time": 254.35, "timestamp": "00:04:14", "text": "スタースケープの情報から判断すると、正しいはずです。"}, {"type": "subtitle", "time": 259.11, "timestamp": "00:04:19", "text": "えーと、モーは最後の作業をしているところなので"}, {"type": "subtitle", "time": 260.349, "timestamp": "00:04:20", "text": "彼女は"}, {"type": "subtitle", "time": 264.71, "timestamp": "00:04:24", "text": "忙しいし、ユユも忙しい。わかった。だから私は"}, {"type": "subtitle", "time": 268.39, "timestamp": "00:04:28", "text": "カイラとザヴァナはイエスと言ったと信じています"}, {"type": "subtitle", "time": 271.15, "timestamp": "00:04:31", "text": "私とノヴァ"}, {"type": "subtitle", "time": 274.39, "timestamp": "00:04:34", "text": "彼は最善を尽くすと述べた。私は手に入れたい"}, {"type": "subtitle", "time": 277.67, "timestamp": "00:04:37", "text": "フリン、兄弟。フリンを手に入れたい。我々は持っています"}, {"type": "subtitle", "time": 279.59000000000003, "timestamp": "00:04:39", "text": "フォートナイトの新シーズンをプレイするため。私たちは"}, {"type": "subtitle", "time": 283.02, "timestamp": "00:04:43", "text": "ビクトリーロイヤルを獲得しなければならない"}, {"type": "subtitle", "time": 285.07, "timestamp": "00:04:45", "text": "[音楽]"}, {"type": "subtitle", "time": 289.11, "timestamp": "00:04:49", "text": "一緒に。でも、ああ、待って。"}, {"type": "subtitle", "time": 291.39, "timestamp": "00:04:51", "text": "加藤。"}, {"type": "subtitle", "time": 298.67, "timestamp": "00:04:58", "text": "オヤと"}]
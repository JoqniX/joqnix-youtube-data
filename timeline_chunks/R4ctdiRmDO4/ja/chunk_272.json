[{"type": "subtitle", "time": 16322.95, "timestamp": "04:32:02", "text": "我々が忍者になる、我々によって。"}, {"type": "subtitle", "time": 16334.229, "timestamp": "04:32:14", "text": "ああ、頭の中は授業の課題でいっぱいだ、メタルじゃない"}, {"type": "subtitle", "time": 16337.63, "timestamp": "04:32:17", "text": "空きを埋めるためのページ"}, {"type": "subtitle", "time": 16348.189, "timestamp": "04:32:28", "text": "ジョギング大学"}, {"type": "subtitle", "time": 16352.149, "timestamp": "04:32:32", "text": "ああ、そういえば大学の話だったね。"}, {"type": "subtitle", "time": 16353.55, "timestamp": "04:32:33", "text": "私は信じます"}, {"type": "subtitle", "time": 16357.67, "timestamp": "04:32:37", "text": "電話のメッセージが届いてないんだけど"}, {"type": "subtitle", "time": 16369.87, "timestamp": "04:32:49", "text": "利用可能だが、ああ、なんてことだ"}, {"type": "subtitle", "time": 16375.71, "timestamp": "04:32:55", "text": "ああ、そう、サッシー、サッシー、オクタン、オーマイ"}, {"type": "subtitle", "time": 16379.59, "timestamp": "04:32:59", "text": "神様待って、スージーのためじゃない、だから私も"}]
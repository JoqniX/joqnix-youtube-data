[{"type": "subtitle", "time": 18181.07, "timestamp": "05:03:01", "text": "それ。しかし"}, {"type": "subtitle", "time": 18184.15, "timestamp": "05:03:04", "text": "ああ、そうだな、誰にもちょっかい出すなよ。うん、それ"}, {"type": "subtitle", "time": 18186.47, "timestamp": "05:03:06", "text": "それが私たちが守るべき主なルールだと思う"}, {"type": "subtitle", "time": 18190.91, "timestamp": "05:03:10", "text": "する。通り過ぎる。うん。うん。面白いけど"}, {"type": "subtitle", "time": 18194.23, "timestamp": "05:03:14", "text": "気まずい。私は推測する。うん。うん。うん。しかし"}, {"type": "subtitle", "time": 18196.43, "timestamp": "05:03:16", "text": "繰り返しますが、最も重要なことは"}, {"type": "subtitle", "time": 18198.52, "timestamp": "05:03:18", "text": "は ここで何が起ころうとも、それは残る"}, {"type": "subtitle", "time": 18202.16, "timestamp": "05:03:22", "text": "ここで何が起ころうとも、それは残る ここ。"}, {"type": "subtitle", "time": 18210.708, "timestamp": "05:03:30", "text": "同じものを見たら、"}, {"type": "subtitle", "time": 18213.51, "timestamp": "05:03:33", "text": "チャタウまたはこの流れにいる個人"}, {"type": "subtitle", "time": 18216.708, "timestamp": "05:03:36", "text": "または私のチャットのストリームで、あなたが見る"}, {"type": "subtitle", "time": 18220.788, "timestamp": "05:03:40", "text": "他の配信者の配信で彼らを見かける。いや、やめて"}, {"type": "subtitle", "time": 18222.628, "timestamp": "05:03:42", "text": "あちらでも同じことが起こるように"}, {"type": "subtitle", "time": 18225.67, "timestamp": "05:03:45", "text": "まあ、他のほとんどのストリーマーはそうしないだろうから"}, {"type": "subtitle", "time": 18227.83, "timestamp": "05:03:47", "text": "私と同じように忍耐強く、"}, {"type": "subtitle", "time": 18229.19, "timestamp": "05:03:49", "text": "即座にあなたを追放するか、"}, {"type": "subtitle", "time": 18231.83, "timestamp": "05:03:51", "text": "何か。だからその点には注意して、"}, {"type": "subtitle", "time": 18233.43, "timestamp": "05:03:53", "text": "また、主に誰にも"}]
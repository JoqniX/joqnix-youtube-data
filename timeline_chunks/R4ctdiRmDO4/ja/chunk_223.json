[{"type": "subtitle", "time": 13380.55, "timestamp": "03:43:00", "text": "ああ、わかりました。ほら、不具合があるんだけど"}, {"type": "subtitle", "time": 13382.79, "timestamp": "03:43:02", "text": "YouTubeも同様で、"}, {"type": "subtitle", "time": 13385.75, "timestamp": "03:43:05", "text": "ストリームを上流に進むと、チャットが読み込まれません。その"}, {"type": "subtitle", "time": 13388.63, "timestamp": "03:43:08", "text": "空白のチャット画面みたいな感じ。チャット"}, {"type": "subtitle", "time": 13391.11, "timestamp": "03:43:11", "text": "箱は丸く作られているので"}, {"type": "subtitle", "time": 13394.229, "timestamp": "03:43:14", "text": "あるいは、そんな感じ。新しいオーバーレイとその他"}, {"type": "subtitle", "time": 13409.189, "timestamp": "03:43:29", "text": "でも、まあ、最終的にはそうは思わない"}, {"type": "subtitle", "time": 13412.15, "timestamp": "03:43:32", "text": "Apexをプレイできると思いますか、"}, {"type": "subtitle", "time": 13416.309, "timestamp": "03:43:36", "text": "こういう重いもの"}, {"type": "subtitle", "time": 13417.87, "timestamp": "03:43:37", "text": "重い"}, {"type": "subtitle", "time": 13421.91, "timestamp": "03:43:41", "text": "ゲームは、またファンを回さなければならなかったので、"}, {"type": "subtitle", "time": 13425.91, "timestamp": "03:43:45", "text": "ファン速度を100%に設定すればいいんですよね？"}, {"type": "subtitle", "time": 13428.309, "timestamp": "03:43:48", "text": "自分で扇風機を回して回転させてください。"}, {"type": "subtitle", "time": 13431.349, "timestamp": "03:43:51", "text": "はい、GPUが解決しています。だから、私は思う"}, {"type": "subtitle", "time": 13434.83, "timestamp": "03:43:54", "text": "私は軽いゲームに留まります"}, {"type": "subtitle", "time": 13437.349, "timestamp": "03:43:57", "text": "今。軽いゲームといえば、"}, {"type": "subtitle", "time": 13439.59, "timestamp": "03:43:59", "text": "光さえある。もっと明るい光はないだろうか。"}]
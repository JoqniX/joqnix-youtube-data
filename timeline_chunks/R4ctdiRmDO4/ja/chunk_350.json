[{"type": "subtitle", "time": 21003.35, "timestamp": "05:50:03", "text": "そうですね、午前4時から6時か7時まで。それから"}, {"type": "subtitle", "time": 21006.948, "timestamp": "05:50:06", "text": "8時か9時から10時まで配信します"}, {"type": "subtitle", "time": 21009.83, "timestamp": "05:50:09", "text": "もしくは何か、もしくは12とか何か。それから私は"}, {"type": "subtitle", "time": 21011.868, "timestamp": "05:50:11", "text": "両方アップロード"}, {"type": "subtitle", "time": 21013.548, "timestamp": "05:50:13", "text": "の"}, {"type": "subtitle", "time": 21016.51, "timestamp": "05:50:16", "text": "それ。はい、両方の単語をアップロードしてください"}, {"type": "subtitle", "time": 21019.83, "timestamp": "05:50:19", "text": "YouTube と YouTube ストリーマー 3 をやる"}, {"type": "subtitle", "time": 21025.83, "timestamp": "05:50:25", "text": "神。そしてそれは、それは、それは"}, {"type": "subtitle", "time": 21027.27, "timestamp": "05:50:27", "text": "実際何が起こるかというと、私は"}, {"type": "subtitle", "time": 21029.91, "timestamp": "05:50:29", "text": "もちろん。"}, {"type": "subtitle", "time": 21031.99, "timestamp": "05:50:31", "text": "でも、制限しないといけない"}, {"type": "subtitle", "time": 21034.91, "timestamp": "05:50:34", "text": "1日1回の配信または"}, {"type": "subtitle", "time": 21037.43, "timestamp": "05:50:37", "text": "何か。もし私たちがボンギーに行くなら"}, {"type": "subtitle", "time": 21039.99, "timestamp": "05:50:39", "text": "休む。はい、休憩を取るときはベルを鳴らしてください。"}, {"type": "subtitle", "time": 21042.788, "timestamp": "05:50:42", "text": "はい、だって私は休むのも怠けるのも嫌いだから"}, {"type": "subtitle", "time": 21050.31, "timestamp": "05:50:50", "text": "あれ。私は午前4時に起きて配信します"}, {"type": "subtitle", "time": 21053.27, "timestamp": "05:50:53", "text": "そしてホテルに宿泊する。また、以前は"}, {"type": "subtitle", "time": 21055.948, "timestamp": "05:50:55", "text": "昔はそうしていた"}, {"type": "subtitle", "time": 21059.11, "timestamp": "05:50:59", "text": "トゥイッチ。起きろ。つまり、電話のことです。いいえ。"}]
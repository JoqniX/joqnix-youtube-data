[{"type": "subtitle", "time": 13140.389, "timestamp": "03:39:00", "text": "アニメを毎日、毎週見ていると、"}, {"type": "subtitle", "time": 13142.11, "timestamp": "03:39:02", "text": "ショー"}, {"type": "subtitle", "time": 13145.269, "timestamp": "03:39:05", "text": "ある意味、私は怠け者なのかもしれない。"}, {"type": "subtitle", "time": 13147.03, "timestamp": "03:39:07", "text": "それはかつて私が使っていたものだった"}, {"type": "subtitle", "time": 13148.51, "timestamp": "03:39:08", "text": "に"}, {"type": "subtitle", "time": 13157.83, "timestamp": "03:39:17", "text": "ああ、そうだね。君たちは変えるように言った"}, {"type": "subtitle", "time": 13160.469, "timestamp": "03:39:20", "text": "この笑い声の効果音、ですよね？私は必要としています"}]
[{"type": "subtitle", "time": 8820.79, "timestamp": "02:27:00", "text": "私のPCで。私は準備しなければならない"}, {"type": "subtitle", "time": 8823.07, "timestamp": "02:27:03", "text": "すべてとバックアップ"}, {"type": "subtitle", "time": 8825.309, "timestamp": "02:27:05", "text": "バックアップなど"}, {"type": "subtitle", "time": 8827.67, "timestamp": "02:27:07", "text": "すべて。 PCは持っていけません。"}, {"type": "subtitle", "time": 8831.71, "timestamp": "02:27:11", "text": "あなたが知っている。そして私はすべての"}, {"type": "subtitle", "time": 8836.51, "timestamp": "02:27:16", "text": "SSD。荷物をまとめる。行く"}, {"type": "subtitle", "time": 8840.83, "timestamp": "02:27:20", "text": "月末までに"}, {"type": "subtitle", "time": 8845.469, "timestamp": "02:27:25", "text": "6月のフライトからフライトへ"}, {"type": "subtitle", "time": 8848.389, "timestamp": "02:27:28", "text": "日本と、私ができることを願う、私はそうするだろう"}, {"type": "subtitle", "time": 8850.71, "timestamp": "02:27:30", "text": "大変だろう、大変だろう、私にはできないだろう"}, {"type": "subtitle", "time": 8854.389, "timestamp": "02:27:34", "text": "今私がやっているようにストリーミング配信する人生"}, {"type": "subtitle", "time": 8857.19, "timestamp": "02:27:37", "text": "生きるための正しい挑戦"}, {"type": "subtitle", "time": 8858.95, "timestamp": "02:27:38", "text": "別の国に住んでいて"}, {"type": "subtitle", "time": 8861.67, "timestamp": "02:27:41", "text": "あなた自身"}, {"type": "subtitle", "time": 8863.99, "timestamp": "02:27:43", "text": "ええ、授業は日本語になります"}, {"type": "subtitle", "time": 8866.99, "timestamp": "02:27:46", "text": "出席する授業とその後パート"}, {"type": "subtitle", "time": 8869.99, "timestamp": "02:27:49", "text": "時間。ああ、それはとても難しいだろう"}, {"type": "subtitle", "time": 8872.95, "timestamp": "02:27:52", "text": "チューブのバランスを取るが、作業は"}, {"type": "subtitle", "time": 8879.27, "timestamp": "02:27:59", "text": "最も難しい。でも、ジョカソンは、えっと、やめました"}]
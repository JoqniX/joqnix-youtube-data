[{"type": "subtitle", "time": 18964.628, "timestamp": "05:16:04", "text": "何？うん。そう、いつでも"}, {"type": "subtitle", "time": 18966.628, "timestamp": "05:16:06", "text": "キャプチャカードを購入する際は、"}, {"type": "subtitle", "time": 18969.628, "timestamp": "05:16:09", "text": "あなたの決意により"}, {"type": "subtitle", "time": 18973.948, "timestamp": "05:16:13", "text": "主に監視する。それは私が"}, {"type": "subtitle", "time": 18976.91, "timestamp": "05:16:16", "text": "学んだ。ええ、それは私が"}, {"type": "subtitle", "time": 18980.11, "timestamp": "05:16:20", "text": "学んだ。 GPUを設置しました"}, {"type": "subtitle", "time": 18987.91, "timestamp": "05:16:27", "text": "修理？キャプチャしているようです"}, {"type": "subtitle", "time": 18988.59, "timestamp": "05:16:28", "text": "のために"}, {"type": "subtitle", "time": 18990.868, "timestamp": "05:16:30", "text": "携帯。もちろん、それは"}, {"type": "subtitle", "time": 18993.31, "timestamp": "05:16:33", "text": "それ。ああ、"}, {"type": "subtitle", "time": 18995.868, "timestamp": "05:16:35", "text": "神。おお"}, {"type": "subtitle", "time": 18998.27, "timestamp": "05:16:38", "text": "うん。私"}, {"type": "subtitle", "time": 19005.99, "timestamp": "05:16:45", "text": "よし、これで広くなった。それは、"}, {"type": "subtitle", "time": 19007.708, "timestamp": "05:16:47", "text": "君たちもわかるよ"}, {"type": "subtitle", "time": 19010.75, "timestamp": "05:16:50", "text": "それ。よし、これは"}, {"type": "subtitle", "time": 19015.628, "timestamp": "05:16:55", "text": "楽しい。明るさが強すぎるのは私だけでしょうか？"}, {"type": "subtitle", "time": 19019.19, "timestamp": "05:16:59", "text": "高い？はい、どうぞ。こんにちは。私は私は"}]
[{"type": "subtitle", "time": 17889.15, "timestamp": "04:58:09", "text": "ああ、そういえばDiscordのこと忘れてた。"}, {"type": "subtitle", "time": 17895.91, "timestamp": "04:58:15", "text": "これ？ああ、もうストリームボードになってるよ。"}, {"type": "subtitle", "time": 17898.47, "timestamp": "04:58:18", "text": "はい、結構です。良い。それは良い。どのように"}, {"type": "subtitle", "time": 17900.628, "timestamp": "04:58:20", "text": "私がストリームボードにいることは既に知られています"}, {"type": "subtitle", "time": 17908.788, "timestamp": "04:58:28", "text": "何？うーん、でも、それでも良いことだよ。"}, {"type": "subtitle", "time": 17910.73, "timestamp": "04:58:30", "text": "そうです"}, {"type": "subtitle", "time": 17913.47, "timestamp": "04:58:33", "text": "[音楽]"}, {"type": "subtitle", "time": 17915.628, "timestamp": "04:58:35", "text": "知る"}, {"type": "subtitle", "time": 17925.948, "timestamp": "04:58:45", "text": "[音楽]"}, {"type": "subtitle", "time": 17929.708, "timestamp": "04:58:49", "text": "自分。わかった。まあまあ"}, {"type": "subtitle", "time": 17932.47, "timestamp": "04:58:52", "text": "少し良くなったが、今のところはそれほどでもない。その"}, {"type": "subtitle", "time": 17934.868, "timestamp": "04:58:54", "text": "似たようなものだが、少なくとも今のところは"}, {"type": "subtitle", "time": 17937.07, "timestamp": "04:58:57", "text": "もっと良い。それは"}]
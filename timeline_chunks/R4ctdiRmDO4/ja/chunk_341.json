[{"type": "subtitle", "time": 20460.788, "timestamp": "05:41:00", "text": "本日伺います。そしてあなたの"}, {"type": "subtitle", "time": 20464.51, "timestamp": "05:41:04", "text": "試験とか色々。頑張ってください。"}, {"type": "subtitle", "time": 20467.23, "timestamp": "05:41:07", "text": "うん。楽しんでいただけたなら幸いです。"}, {"type": "subtitle", "time": 20471.51, "timestamp": "05:41:11", "text": "今日。うん、今日は早く寝るよ。"}, {"type": "subtitle", "time": 20472.59, "timestamp": "05:41:12", "text": "寝ます"}, {"type": "subtitle", "time": 20475.35, "timestamp": "05:41:15", "text": "早い。私のことを覚えていてくれてありがとう。の"}, {"type": "subtitle", "time": 20478.07, "timestamp": "05:41:18", "text": "もちろん、私は忘れません。もちろん"}, {"type": "subtitle", "time": 20482.47, "timestamp": "05:41:22", "text": "私は忘れない。あなたを飛ばしてしまいました"}, {"type": "subtitle", "time": 20486.39, "timestamp": "05:41:26", "text": "最後にこれを言うと、"}, {"type": "subtitle", "time": 20489.19, "timestamp": "05:41:29", "text": "うん、最後のところまで合図したよ"}, {"type": "subtitle", "time": 20491.11, "timestamp": "05:41:31", "text": "スキップしました。うん。うん。私は忘れない。"}, {"type": "subtitle", "time": 20493.67, "timestamp": "05:41:33", "text": "どういう意味ですか？たとえ私が"}, {"type": "subtitle", "time": 20495.548, "timestamp": "05:41:35", "text": "名前を読み上げます。"}, {"type": "subtitle", "time": 20497.548, "timestamp": "05:41:37", "text": "チェック。うん。うん。"}, {"type": "subtitle", "time": 20500.07, "timestamp": "05:41:40", "text": "うん。そして、ロッカーを貸してくださった皆様、ありがとうございました。"}, {"type": "subtitle", "time": 20501.83, "timestamp": "05:41:41", "text": "ストリームをロックオンしている人たち。"}, {"type": "subtitle", "time": 20505.59, "timestamp": "05:41:45", "text": "ありがとう。それは本当に大きな意味があります。"}, {"type": "subtitle", "time": 20507.43, "timestamp": "05:41:47", "text": "うん。うん。うん。だから、私は"}, {"type": "subtitle", "time": 20510.548, "timestamp": "05:41:50", "text": "最近ストリーミング配信しています。申し訳ありません"}, {"type": "subtitle", "time": 20513.27, "timestamp": "05:41:53", "text": "それ。私はできないと思う"}, {"type": "subtitle", "time": 20515.91, "timestamp": "05:41:55", "text": "積極的にストリーミング配信することはもうあまりない"}, {"type": "subtitle", "time": 20519.59, "timestamp": "05:41:59", "text": "または4時間、5時間以上の配信"}]
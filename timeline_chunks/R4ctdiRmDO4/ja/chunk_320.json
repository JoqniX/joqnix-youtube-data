[{"type": "subtitle", "time": 19213.27, "timestamp": "05:20:13", "text": "鳴り響く。より狭い場所への恐怖症"}, {"type": "subtitle", "time": 19229.23, "timestamp": "05:20:29", "text": "それはまるで"}, {"type": "subtitle", "time": 19233.11, "timestamp": "05:20:33", "text": "ねずみ。ネズミだ。何てことだ。はい、"}, {"type": "subtitle", "time": 19235.35, "timestamp": "05:20:35", "text": "私の選んだものを選んでください。"}, {"type": "subtitle", "time": 19238.868, "timestamp": "05:20:38", "text": "私の元視野、私の元視野は"}, {"type": "subtitle", "time": 19243.628, "timestamp": "05:20:43", "text": "今、これを見ています。なんてこった。ところで、"}, {"type": "subtitle", "time": 19248.39, "timestamp": "05:20:48", "text": "えっと、私はよくこう言うのですが、"}, {"type": "subtitle", "time": 19251.11, "timestamp": "05:20:51", "text": "あなたを夢中にさせるゲームがあるなら"}, {"type": "subtitle", "time": 19254.47, "timestamp": "05:20:54", "text": "乗り物酔いみたいな感じなら、"}]
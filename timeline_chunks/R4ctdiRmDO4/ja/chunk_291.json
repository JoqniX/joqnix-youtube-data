[{"type": "subtitle", "time": 17461.07, "timestamp": "04:51:01", "text": "キルは取れなかった。"}, {"type": "subtitle", "time": 17464.15, "timestamp": "04:51:04", "text": "いいえ。例えば、"}, {"type": "subtitle", "time": 17467.31, "timestamp": "04:51:07", "text": "例えば、感嘆符を付けると"}, {"type": "subtitle", "time": 17471.83, "timestamp": "04:51:11", "text": "愛と私へのジョークミックスか何か"}, {"type": "subtitle", "time": 17474.31, "timestamp": "04:51:14", "text": "そうすればチャンスがあるだろう"}, {"type": "subtitle", "time": 17477.91, "timestamp": "04:51:17", "text": "50%の確率とか20%とか1%の確率とか"}, {"type": "subtitle", "time": 17481.91, "timestamp": "04:51:21", "text": "1%ならもう一度試してください。"}, {"type": "subtitle", "time": 17484.708, "timestamp": "04:51:24", "text": "後でとか、もっと幸運を祈るとか"}, {"type": "subtitle", "time": 17486.708, "timestamp": "04:51:26", "text": "次回とか、そういう時に。 100%の場合"}, {"type": "subtitle", "time": 17488.99, "timestamp": "04:51:28", "text": "それから"}, {"type": "subtitle", "time": 17491.27, "timestamp": "04:51:31", "text": "おめでとう、とか何とか。ああ、"}, {"type": "subtitle", "time": 17492.75, "timestamp": "04:51:32", "text": "頂点"}, {"type": "subtitle", "time": 17495.03, "timestamp": "04:51:35", "text": "墜落しました。そうそう。私たちはこれを見ていました"}, {"type": "subtitle", "time": 17497.15, "timestamp": "04:51:37", "text": "ビデオについて話していたので"}, {"type": "subtitle", "time": 17500.67, "timestamp": "04:51:40", "text": "もの。うわ、ゲームがクラッシュした"}, {"type": "subtitle", "time": 17504.67, "timestamp": "04:51:44", "text": "自分。ああ、私のPGはうまくいってない"}, {"type": "subtitle", "time": 17506.99, "timestamp": "04:51:46", "text": "今日。これは"}, {"type": "subtitle", "time": 17510.628, "timestamp": "04:51:50", "text": "悪い。ええ、そういうマークもあります"}, {"type": "subtitle", "time": 17515.19, "timestamp": "04:51:55", "text": "私はこのようなゲームを避けたりプレイしたりすべきではない"}, {"type": "subtitle", "time": 17518.47, "timestamp": "04:51:58", "text": "もう。つまり、私は"}]
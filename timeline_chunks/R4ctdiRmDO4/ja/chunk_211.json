[{"type": "subtitle", "time": 12665.99, "timestamp": "03:31:05", "text": "男の子。でも、最近は"}, {"type": "subtitle", "time": 12668.15, "timestamp": "03:31:08", "text": "どこでも起こっていること？まるで私が"}, {"type": "subtitle", "time": 12671.55, "timestamp": "03:31:11", "text": "多くのものを逃している"}, {"type": "subtitle", "time": 12693.429, "timestamp": "03:31:33", "text": "でも、最近は、そうですよね？する"}, {"type": "subtitle", "time": 12695.309, "timestamp": "03:31:35", "text": "あなたは私と同じように考えていますか？"}, {"type": "subtitle", "time": 12698.229, "timestamp": "03:31:38", "text": "話している？練習が必要だと思う"}, {"type": "subtitle", "time": 12700.03, "timestamp": "03:31:40", "text": "私の話"}, {"type": "subtitle", "time": 12703.19, "timestamp": "03:31:43", "text": "もの。私はうまく話せない"}, {"type": "subtitle", "time": 12705.95, "timestamp": "03:31:45", "text": "ストリーム。私は黙っているのが好きです。それは"}, {"type": "subtitle", "time": 12709.349, "timestamp": "03:31:49", "text": "悪い。考え出さなきゃ。あ、待って。"}, {"type": "subtitle", "time": 12719.99, "timestamp": "03:31:59", "text": "先ほども申し上げたように、私は上に上がらなければなりません。私"}]
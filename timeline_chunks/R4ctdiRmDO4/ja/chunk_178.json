[{"type": "subtitle", "time": 10681.75, "timestamp": "02:58:01", "text": "そこから。えっと、私は日本に滞在したいです"}, {"type": "subtitle", "time": 10683.59, "timestamp": "02:58:03", "text": "より長い期間。だから変換する必要がある"}, {"type": "subtitle", "time": 10686.469, "timestamp": "02:58:06", "text": "私のビザは再び学生ビザになりました。たくさんの"}, {"type": "subtitle", "time": 10688.63, "timestamp": "02:58:08", "text": "もの。でも、私は"}, {"type": "subtitle", "time": 10690.389, "timestamp": "02:58:10", "text": "次の"}, {"type": "subtitle", "time": 10694.07, "timestamp": "02:58:14", "text": "次は、無料でもう一度回してあげます。"}, {"type": "subtitle", "time": 10702.63, "timestamp": "02:58:22", "text": "ない？え、何？ ああ、なんてことだ。何"}, {"type": "subtitle", "time": 10706.15, "timestamp": "02:58:26", "text": "これですか？とんでもなく危険なものだ。何てことだ。"}, {"type": "subtitle", "time": 10710.75, "timestamp": "02:58:30", "text": "あなたはこれまでに自分自身に会ったことがありますか？えーと、"}, {"type": "subtitle", "time": 10712.83, "timestamp": "02:58:32", "text": "アスで"}, {"type": "subtitle", "time": 10716.429, "timestamp": "02:58:36", "text": "質問によります。私は持っている"}, {"type": "subtitle", "time": 10720.429, "timestamp": "02:58:40", "text": "ズボンにおしっこ漏らしちゃった。質問"}, {"type": "subtitle", "time": 10722.67, "timestamp": "02:58:42", "text": "マーク。おお"}, {"type": "subtitle", "time": 10725.87, "timestamp": "02:58:45", "text": "神。わかった。"}, {"type": "subtitle", "time": 10729.99, "timestamp": "02:58:49", "text": "えっと。何てことだ。"}, {"type": "subtitle", "time": 10733.51, "timestamp": "02:58:53", "text": "つまり、ずっとずっと昔、子供の頃"}]
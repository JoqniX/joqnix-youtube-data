[{"type": "subtitle", "time": 20520.67, "timestamp": "05:42:00", "text": "それ"}, {"type": "subtitle", "time": 20524.788, "timestamp": "05:42:04", "text": "多くの。えーと、また私の優先順位は"}, {"type": "subtitle", "time": 20529.27, "timestamp": "05:42:09", "text": "ずっと続けてたけど、結局はわかるでしょ"}, {"type": "subtitle", "time": 20531.43, "timestamp": "05:42:11", "text": "えっと、結局私は"}, {"type": "subtitle", "time": 20534.39, "timestamp": "05:42:14", "text": "仕事や好きなことに集中する"}, {"type": "subtitle", "time": 20537.83, "timestamp": "05:42:17", "text": "ただ、また他のこともやらなければならない"}, {"type": "subtitle", "time": 20540.948, "timestamp": "05:42:20", "text": "また、特にこのような時期に"}, {"type": "subtitle", "time": 20542.788, "timestamp": "05:42:22", "text": "ご存知のように、私はストリーミングできません"}, {"type": "subtitle", "time": 20546.868, "timestamp": "05:42:26", "text": "夜はちょうど私たちが、私は私が保っていたと思います"}, {"type": "subtitle", "time": 20550.31, "timestamp": "05:42:30", "text": "午後3時から6、7歳まで"}, {"type": "subtitle", "time": 20555.75, "timestamp": "05:42:35", "text": "最大8つで終了するので、えっと"}, {"type": "subtitle", "time": 20557.51, "timestamp": "05:42:37", "text": "やめてください、"}, {"type": "subtitle", "time": 20560.15, "timestamp": "05:42:40", "text": "ストリームする前に、全部手に入れたい"}, {"type": "subtitle", "time": 20563.868, "timestamp": "05:42:43", "text": "家族による邪魔のスパム。"}, {"type": "subtitle", "time": 20568.43, "timestamp": "05:42:48", "text": "ええ、でも、私にはできないと思います"}, {"type": "subtitle", "time": 20572.628, "timestamp": "05:42:52", "text": "それをさらに長く持ちこたえるために。私は持っている"}, {"type": "subtitle", "time": 20576.708, "timestamp": "05:42:56", "text": "ストリームを終了したり、その他諸々を終了したり、また、"}, {"type": "subtitle", "time": 20579.99, "timestamp": "05:42:59", "text": "叱られたり、私が"}]
[{"type": "subtitle", "time": 19080.628, "timestamp": "05:18:00", "text": "ルナ新年イベント。ルナイベント。"}, {"type": "subtitle", "time": 19085.23, "timestamp": "05:18:05", "text": "残りはあと4人、このゲーム"}, {"type": "subtitle", "time": 19088.75, "timestamp": "05:18:08", "text": "[ __ ]。これで終わりだ"}, {"type": "subtitle", "time": 19092.47, "timestamp": "05:18:12", "text": "男。でも、私がやることは、"}, {"type": "subtitle", "time": 19095.67, "timestamp": "05:18:15", "text": "しばらくはこれに触らないつもりです"}, {"type": "subtitle", "time": 19097.708, "timestamp": "05:18:17", "text": "これらのゲームですよね？なぜなら、それはまた"}, {"type": "subtitle", "time": 19100.35, "timestamp": "05:18:20", "text": "プレイ不可能。つまり、プレイ可能ということだ"}, {"type": "subtitle", "time": 19101.868, "timestamp": "05:18:21", "text": "しかし"}, {"type": "subtitle", "time": 19105.19, "timestamp": "05:18:25", "text": "苦しみ。でも大丈夫。しかしまた"}, {"type": "subtitle", "time": 19107.19, "timestamp": "05:18:27", "text": "このような苦しみは、ある意味で"}, {"type": "subtitle", "time": 19109.99, "timestamp": "05:18:29", "text": "また、考えなければならないので良いことです"}, {"type": "subtitle", "time": 19112.47, "timestamp": "05:18:32", "text": "世の中には次のような人たちがいる"}, {"type": "subtitle", "time": 19116.15, "timestamp": "05:18:36", "text": "低いNPCのような低いものを持っていて、彼らは"}, {"type": "subtitle", "time": 19118.55, "timestamp": "05:18:38", "text": "彼らもゲームを正しくプレイしたいが、"}, {"type": "subtitle", "time": 19123.628, "timestamp": "05:18:43", "text": "彼らもまた、同じように苦しんでいる。だから"}, {"type": "subtitle", "time": 19127.51, "timestamp": "05:18:47", "text": "ええ、それで大丈夫です。"}, {"type": "subtitle", "time": 19129.948, "timestamp": "05:18:49", "text": "あなたが持っているものすべてに満足してください"}, {"type": "subtitle", "time": 19132.35, "timestamp": "05:18:52", "text": "あまりにも。それで"}, {"type": "subtitle", "time": 19138.628, "timestamp": "05:18:58", "text": "影響する。ああ、なんてことだ、とても"}]
[{"type": "subtitle", "time": 21121.91, "timestamp": "05:52:01", "text": "異なる"}, {"type": "subtitle", "time": 21124.27, "timestamp": "05:52:04", "text": "えーとチャンネルまたは"}, {"type": "subtitle", "time": 21126.51, "timestamp": "05:52:06", "text": "何か。うん。うん。うん。"}, {"type": "subtitle", "time": 21129.19, "timestamp": "05:52:09", "text": "うん。だって、あの頃は現実世界でやってたんだもん"}, {"type": "subtitle", "time": 21132.628, "timestamp": "05:52:12", "text": "ストリーミング配信もそうですよね？だから私はこう思った"}, {"type": "subtitle", "time": 21134.59, "timestamp": "05:52:14", "text": "焦点を当てない"}, {"type": "subtitle", "time": 21138.15, "timestamp": "05:52:18", "text": "冗談だよ。だから私は他のことをしていた"}, {"type": "subtitle", "time": 21140.43, "timestamp": "05:52:20", "text": "まあ、私はやめた"}, {"type": "subtitle", "time": 21145.15, "timestamp": "05:52:25", "text": "それ。まあ、そうですね。何てことだ。あれらは"}, {"type": "subtitle", "time": 21147.07, "timestamp": "05:52:27", "text": "日。"}, {"type": "subtitle", "time": 21150.15, "timestamp": "05:52:30", "text": "お互いに最も競い合っている"}, {"type": "subtitle", "time": 21151.31, "timestamp": "05:52:31", "text": "少し"}, {"type": "subtitle", "time": 21155.708, "timestamp": "05:52:35", "text": "寝る。でも、またやらなきゃいけないことがあるんだ"}, {"type": "subtitle", "time": 21158.548, "timestamp": "05:52:38", "text": "最高。うん。うん。うん。それは、それは"}, {"type": "subtitle", "time": 21161.31, "timestamp": "05:52:41", "text": "大切なこと。ストリーミングしすぎると"}, {"type": "subtitle", "time": 21164.15, "timestamp": "05:52:44", "text": "ヘルプ。うん。うん。危険を冒さないでください"}, {"type": "subtitle", "time": 21166.07, "timestamp": "05:52:46", "text": "健康、Ba。うん。うん。それもまた然り。はい。"}, {"type": "subtitle", "time": 21169.51, "timestamp": "05:52:49", "text": "それもまた然り。はい。はい。"}, {"type": "subtitle", "time": 21171.99, "timestamp": "05:52:51", "text": "ある意味、ストリームを切り取りたい"}, {"type": "subtitle", "time": 21174.548, "timestamp": "05:52:54", "text": "動画コンテンツを作るなど"}, {"type": "subtitle", "time": 21177.35, "timestamp": "05:52:57", "text": "すべて、でもまた私はこう思う"}, {"type": "subtitle", "time": 21179.788, "timestamp": "05:52:59", "text": "私の配信の良いところって何なの？"}]
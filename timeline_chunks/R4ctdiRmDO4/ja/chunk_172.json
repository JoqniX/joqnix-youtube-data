[{"type": "subtitle", "time": 10320.309, "timestamp": "02:52:00", "text": "他の人に順番を譲る、誰かに尋ねる"}, {"type": "subtitle", "time": 10321.91, "timestamp": "02:52:01", "text": "あなたが選んだ質問。誰かに与える"}, {"type": "subtitle", "time": 10324.15, "timestamp": "02:52:04", "text": "そうでなければ、選択肢の多くがある。誰かを作る"}, {"type": "subtitle", "time": 10326.63, "timestamp": "02:52:06", "text": "さもなければ、あなたに代わってルーレットを回してください。する"}, {"type": "subtitle", "time": 10328.469, "timestamp": "02:52:08", "text": "あなたの左隣にいる人物の印象。"}, {"type": "subtitle", "time": 10330.63, "timestamp": "02:52:10", "text": "もう一度回してください。あなただけのスタージェムを見つけてください。教えて"}, {"type": "subtitle", "time": 10332.71, "timestamp": "02:52:12", "text": "冗談だよ。なぞなぞを言ってください。あなたの"}, {"type": "subtitle", "time": 10334.469, "timestamp": "02:52:14", "text": "お気に入りのおもちゃは？独自の才能とは何ですか？"}, {"type": "subtitle", "time": 10336.71, "timestamp": "02:52:16", "text": "あなたが持っている？あなたの親友は誰ですか？見せる"}, {"type": "subtitle", "time": 10339.349, "timestamp": "02:52:19", "text": "ロック画面に表示されます。みんなに見せて"}, {"type": "subtitle", "time": 10343.83, "timestamp": "02:52:23", "text": "ホーム画面。座って座って座って愛する"}, {"type": "subtitle", "time": 10345.99, "timestamp": "02:52:25", "text": "あなたの愛があなたに届くまで、ああ、そうだ。いくつか"}, {"type": "subtitle", "time": 10349.71, "timestamp": "02:52:29", "text": "私にはできないこと。ちょうどこれを手に入れました"}, {"type": "subtitle", "time": 10352.469, "timestamp": "02:52:32", "text": "インターネットで見つけたランダムな情報。だから私は考えた"}, {"type": "subtitle", "time": 10354.79, "timestamp": "02:52:34", "text": "これをすること。"}, {"type": "subtitle", "time": 10356.71, "timestamp": "02:52:36", "text": "誰かに片思いをしたことはありますか？伝える"}, {"type": "subtitle", "time": 10358.309, "timestamp": "02:52:38", "text": "あなたの左にいる人は誰ですか？"}, {"type": "subtitle", "time": 10359.389, "timestamp": "02:52:39", "text": "打ち砕く"}, {"type": "subtitle", "time": 10362.469, "timestamp": "02:52:42", "text": "は。次の2回のランニングは少人数チームで行う。"}, {"type": "subtitle", "time": 10370.269, "timestamp": "02:52:50", "text": "など。ああ、奇妙なものがたくさんあります"}, {"type": "subtitle", "time": 10373.83, "timestamp": "02:52:53", "text": "これ。友人がこれをくれた"}]
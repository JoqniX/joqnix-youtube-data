[{"type": "subtitle", "time": 15902.59, "timestamp": "04:25:02", "text": "ああ、それは"}, {"type": "subtitle", "time": 15905.83, "timestamp": "04:25:05", "text": "遅れている。私はASMRが好きではないが、ああ、"}, {"type": "subtitle", "time": 15909.11, "timestamp": "04:25:09", "text": "ロールプレイング。待って、ロールプレイは違う"}, {"type": "subtitle", "time": 15910.55, "timestamp": "04:25:10", "text": "異なる。待って、待って、待って。役割"}, {"type": "subtitle", "time": 15913.87, "timestamp": "04:25:13", "text": "ASMRを再生する。つまり、ロールプレイングのような"}, {"type": "subtitle", "time": 15916.87, "timestamp": "04:25:16", "text": "ハッシュバンドか何か？種の"}, {"type": "subtitle", "time": 15919.03, "timestamp": "04:25:19", "text": "そんな感じですよね？メイドのように、"}, {"type": "subtitle", "time": 15921.349, "timestamp": "04:25:21", "text": "そんな感じ。歩き方のように"}, {"type": "subtitle", "time": 15929.95, "timestamp": "04:25:29", "text": "そういうことをする、"}, {"type": "subtitle", "time": 15947.349, "timestamp": "04:25:47", "text": "最初はちょっと面白いと思ったんだけど、彼は"}, {"type": "subtitle", "time": 15949.349, "timestamp": "04:25:49", "text": "彼らのために言っているのは、あなたが知っているように、私は"}, {"type": "subtitle", "time": 15950.269, "timestamp": "04:25:50", "text": "聞く"}, {"type": "subtitle", "time": 15954.189, "timestamp": "04:25:54", "text": "背景にバイクが写っている"}, {"type": "subtitle", "time": 15957.91, "timestamp": "04:25:57", "text": "そう、それも私がこう思う理由の一つです"}]
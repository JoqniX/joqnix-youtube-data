[{"type": "subtitle", "time": 9389.469, "timestamp": "02:36:29", "text": "[音楽]"}, {"type": "subtitle", "time": 9392.79, "timestamp": "02:36:32", "text": "ああ、そうだよ。恋しい"}, {"type": "subtitle", "time": 9395.91, "timestamp": "02:36:35", "text": "ああ、恋しいよ。ああ、私はインド人だ。"}, {"type": "subtitle", "time": 9404.91, "timestamp": "02:36:44", "text": "ジョックネス、私はヴァトンズと話しました"}, {"type": "subtitle", "time": 9407.27, "timestamp": "02:36:47", "text": "一度。コラボレーションしたかどうかはわかりません"}]
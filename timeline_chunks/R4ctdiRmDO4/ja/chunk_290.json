[{"type": "subtitle", "time": 17402.628, "timestamp": "04:50:02", "text": "もの。抱きしめて、軽くたたいて、鼻をツンとつつく。 3人全員"}, {"type": "subtitle", "time": 17404.59, "timestamp": "04:50:04", "text": "の"}, {"type": "subtitle", "time": 17407.27, "timestamp": "04:50:07", "text": "彼ら。わかった。うん。つまり、チャットみたいなものですね"}, {"type": "subtitle", "time": 17409.19, "timestamp": "04:50:09", "text": "お互いに抱き合うことができるコマンドまたは"}, {"type": "subtitle", "time": 17412.27, "timestamp": "04:50:12", "text": "お互いに軽くぶつかり合う。テキストのみです"}, {"type": "subtitle", "time": 17415.03, "timestamp": "04:50:15", "text": "基礎として、さらに"}, {"type": "subtitle", "time": 17417.59, "timestamp": "04:50:17", "text": "アニメーションポップアップを追加してクールに"}, {"type": "subtitle", "time": 17418.51, "timestamp": "04:50:18", "text": "の上"}, {"type": "subtitle", "time": 17421.59, "timestamp": "04:50:21", "text": "画面に何か映るもの、あなたが知っているように"}, {"type": "subtitle", "time": 17424.708, "timestamp": "04:50:24", "text": "君たちは知っていたかもしれないけど"}, {"type": "subtitle", "time": 17426.11, "timestamp": "04:50:26", "text": "愛情度メーター"}, {"type": "subtitle", "time": 17430.628, "timestamp": "04:50:30", "text": "君にとって、ある意味チャンスがあるようなものだ"}, {"type": "subtitle", "time": 17434.628, "timestamp": "04:50:34", "text": "誰かのパートナーになる、誰かのような人"}, {"type": "subtitle", "time": 17436.868, "timestamp": "04:50:36", "text": "ゲームか何かがある"}, {"type": "subtitle", "time": 17438.948, "timestamp": "04:50:38", "text": "オートモゲームのようにオートモゲームまたは"}, {"type": "subtitle", "time": 17440.628, "timestamp": "04:50:40", "text": "何か。"}, {"type": "subtitle", "time": 17442.67, "timestamp": "04:50:42", "text": "うん。うん。そんな感じですね。"}, {"type": "subtitle", "time": 17445.99, "timestamp": "04:50:45", "text": "だから、感嘆符を付けると、いいえ、そうではありません"}, {"type": "subtitle", "time": 17449.11, "timestamp": "04:50:49", "text": "現在入手可能ですが、あくまでもアイデアです。ただの"}, {"type": "subtitle", "time": 17452.51, "timestamp": "04:50:52", "text": "いいアイデアだけど、まあいいや。あなたがやる"}, {"type": "subtitle", "time": 17455.07, "timestamp": "04:50:55", "text": "感嘆符。あなたがやる"}, {"type": "subtitle", "time": 17457.51, "timestamp": "04:50:57", "text": "感嘆符。ああ、神様。何てことだ。できました"}]
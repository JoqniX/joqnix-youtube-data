[{"type": "subtitle", "time": 13502.309, "timestamp": "03:45:02", "text": "または午後11時私はいくつかのバトルをプレイしました"}, {"type": "subtitle", "time": 13504.55, "timestamp": "03:45:04", "text": "マッチといいね"}, {"type": "subtitle", "time": 13508.11, "timestamp": "03:45:08", "text": "満足したとか何とかで"}, {"type": "subtitle", "time": 13511.11, "timestamp": "03:45:11", "text": "試しにプレイしてみて。いや、いや。試す"}, {"type": "subtitle", "time": 13513.07, "timestamp": "03:45:13", "text": "寝ていて私は"}, {"type": "subtitle", "time": 13516.309, "timestamp": "03:45:16", "text": "眠った。目が覚めたとき、"}, {"type": "subtitle", "time": 13518.469, "timestamp": "03:45:18", "text": "午前3時になっても眠れなかった。私はこう思った。"}, {"type": "subtitle", "time": 13520.55, "timestamp": "03:45:20", "text": "「ああ、私はただ信じて見守るだけだ」"}, {"type": "subtitle", "time": 13523.429, "timestamp": "03:45:23", "text": "いくつか動画とか、レベルアップする、"}, {"type": "subtitle", "time": 13526.269, "timestamp": "03:45:26", "text": "研磨材"}, {"type": "subtitle", "time": 13530.75, "timestamp": "03:45:30", "text": "「レベル上げ」だから、私はそれをやって、"}, {"type": "subtitle", "time": 13535.469, "timestamp": "03:45:35", "text": "うわー、ほら、私はこう思ったんだ、"}, {"type": "subtitle", "time": 13538.309, "timestamp": "03:45:38", "text": "「ああ、そうだな。もう行っちゃおうかな？」"}, {"type": "subtitle", "time": 13541.349, "timestamp": "03:45:41", "text": "Twitchでライブ配信して、そういうことをやってるの？"}, {"type": "subtitle", "time": 13543.59, "timestamp": "03:45:43", "text": "ある意味、私はそれをライブで記録したかったのです"}, {"type": "subtitle", "time": 13545.95, "timestamp": "03:45:45", "text": "そのチュートリアル動画"}, {"type": "subtitle", "time": 13549.349, "timestamp": "03:45:49", "text": "たぶん持って行かないであろう物"}, {"type": "subtitle", "time": 13553.51, "timestamp": "03:45:53", "text": "それを公開する、つまりライブでやる。これは"}, {"type": "subtitle", "time": 13556.309, "timestamp": "03:45:56", "text": "数人の友達とか、そんな感じ。私 私"}, {"type": "subtitle", "time": 13558.07, "timestamp": "03:45:58", "text": "非公開のままにしておくことを考えた"}]
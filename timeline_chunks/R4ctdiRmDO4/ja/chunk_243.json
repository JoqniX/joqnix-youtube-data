[{"type": "subtitle", "time": 14581.349, "timestamp": "04:03:01", "text": "これ。これは違う。これです。ああ、"}, {"type": "subtitle", "time": 14583.389, "timestamp": "04:03:03", "text": "同じ。まあ、同じだけど"}, {"type": "subtitle", "time": 14586.15, "timestamp": "04:03:06", "text": "違う。こちらはガーディアン・オブ・アトランティスです。"}, {"type": "subtitle", "time": 14588.429, "timestamp": "04:03:08", "text": "そしてもう一つは"}, {"type": "subtitle", "time": 14591.349, "timestamp": "04:03:11", "text": "これは何ですか？火。それは"}, {"type": "subtitle", "time": 14594.15, "timestamp": "04:03:14", "text": "頭。頭の部分は同じです。彼らは"}, {"type": "subtitle", "time": 14596.79, "timestamp": "04:03:16", "text": "頭を使う。同じ頭部。ドラゴンの頭"}, {"type": "subtitle", "time": 14597.71, "timestamp": "04:03:17", "text": "または"}, {"type": "subtitle", "time": 14601.79, "timestamp": "04:03:21", "text": "何かはあるけれど、違う。"}, {"type": "subtitle", "time": 14603.75, "timestamp": "04:03:23", "text": "わかった。わからない。必ずあるはずだ"}, {"type": "subtitle", "time": 14607.229, "timestamp": "04:03:27", "text": "保険または物"}, {"type": "subtitle", "time": 14610.15, "timestamp": "04:03:30", "text": "また詐欺の件だ。ああ、それ"}, {"type": "subtitle", "time": 14618.07, "timestamp": "04:03:38", "text": "わかった。ああ、リアンには髭が生えている。何てことだ。"}, {"type": "subtitle", "time": 14621.469, "timestamp": "04:03:41", "text": "あのヒゲを見て。"}, {"type": "subtitle", "time": 14625.55, "timestamp": "04:03:45", "text": "おお。そうそう。私はいくつか見ました"}, {"type": "subtitle", "time": 14629.389, "timestamp": "04:03:49", "text": "どこかでそう言っている、"}, {"type": "subtitle", "time": 14633.349, "timestamp": "04:03:53", "text": "知っておくと、誰かを殴ったりパンチしたりしたら"}, {"type": "subtitle", "time": 14636.79, "timestamp": "04:03:56", "text": "髭が生えていないように、彼らにはチャンスがある"}, {"type": "subtitle", "time": 14639.229, "timestamp": "04:03:59", "text": "顎を折ったり、"}]
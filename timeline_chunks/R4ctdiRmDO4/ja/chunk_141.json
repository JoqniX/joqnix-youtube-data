[{"type": "subtitle", "time": 8462.95, "timestamp": "02:21:02", "text": "人生？久しぶりですね。ええ、"}, {"type": "subtitle", "time": 8490.71, "timestamp": "02:21:30", "text": "すべての善人が善行を行うわけではないが、人生はそうではない"}, {"type": "subtitle", "time": 8492.91, "timestamp": "02:21:32", "text": "誰のためにも立ち止まってはならない。確かに、確かに、"}, {"type": "subtitle", "time": 8496.75, "timestamp": "02:21:36", "text": "真実。障害があるだろう"}, {"type": "subtitle", "time": 8501.11, "timestamp": "02:21:41", "text": "人生。私たちは皆、彼らに正面から立ち向かわなければならない。"}, {"type": "subtitle", "time": 8503.469, "timestamp": "02:21:43", "text": "何があっても。"}]
[{"type": "subtitle", "time": 13561.59, "timestamp": "03:46:01", "text": "念のためビデオか何か"}, {"type": "subtitle", "time": 13564.07, "timestamp": "03:46:04", "text": "ライブビデオの録画に優れている"}, {"type": "subtitle", "time": 13566.03, "timestamp": "03:46:06", "text": "ストリーム"}, {"type": "subtitle", "time": 13568.469, "timestamp": "03:46:08", "text": "あれ。うん。うん。うん。だから私は考えた"}, {"type": "subtitle", "time": 13571.429, "timestamp": "03:46:11", "text": "うん。"}, {"type": "subtitle", "time": 13573.71, "timestamp": "03:46:13", "text": "そうします、もしくは"}, {"type": "subtitle", "time": 13577.309, "timestamp": "03:46:17", "text": "何か。あのね？私は思う"}, {"type": "subtitle", "time": 13580.189, "timestamp": "03:46:20", "text": "このダブルタップ"}, {"type": "subtitle", "time": 13583.349, "timestamp": "03:46:23", "text": "そうするべきだ。うん。ハカロイ。ええ、そうしました。"}, {"type": "subtitle", "time": 13585.51, "timestamp": "03:46:25", "text": "ハカール・ロイを試してみてください。それは良いです。良いのですが、"}, {"type": "subtitle", "time": 13587.51, "timestamp": "03:46:27", "text": "新年のイベントのため"}, {"type": "subtitle", "time": 13590.51, "timestamp": "03:46:30", "text": "課題ですよね？そっちの方がいい"}, {"type": "subtitle", "time": 13593.309, "timestamp": "03:46:33", "text": "戦う方が良い"}, {"type": "subtitle", "time": 13595.229, "timestamp": "03:46:35", "text": "ロイヤル"}, {"type": "subtitle", "time": 13598.71, "timestamp": "03:46:38", "text": "その代わり。実際、それは"}, {"type": "subtitle", "time": 13605.309, "timestamp": "03:46:45", "text": "右？ハードコア ハードコア"}, {"type": "subtitle", "time": 13609.75, "timestamp": "03:46:49", "text": "ロイヤルってノンNBみたいなものだよね？非戦闘"}, {"type": "subtitle", "time": 13611.91, "timestamp": "03:46:51", "text": "ロイヤル。だから、それはあなたの"}, {"type": "subtitle", "time": 13614.269, "timestamp": "03:46:54", "text": "課題。だから、行く方が良い"}, {"type": "subtitle", "time": 13616.87, "timestamp": "03:46:56", "text": "バトルロイヤル形式で。バトルロイヤルのような"}, {"type": "subtitle", "time": 13618.95, "timestamp": "03:46:58", "text": "普通の仔犬たち。"}]
[{"type": "subtitle", "time": 3125.15, "timestamp": "00:52:05", "text": "はい、スケジュールを投稿します"}, {"type": "subtitle", "time": 3127.75, "timestamp": "00:52:07", "text": "実は。私は必要ないと思います"}, {"type": "subtitle", "time": 3130.87, "timestamp": "00:52:10", "text": "なぜなら、それは変化する可能性があるからです。私は私は"}, {"type": "subtitle", "time": 3132.03, "timestamp": "00:52:12", "text": "追加"}, {"type": "subtitle", "time": 3135.349, "timestamp": "00:52:15", "text": "計画外 未決定 計画外のコラボレーションなし"}, {"type": "subtitle", "time": 3137.51, "timestamp": "00:52:17", "text": "日付が"}, {"type": "subtitle", "time": 3139.069, "timestamp": "00:52:19", "text": "確認済み"}, {"type": "subtitle", "time": 3143.549, "timestamp": "00:52:23", "text": "17人用。確認されていません"}, {"type": "subtitle", "time": 3145.39, "timestamp": "00:52:25", "text": "日付。"}, {"type": "subtitle", "time": 3153.15, "timestamp": "00:52:33", "text": "ええ、確認できた人はほんの数人でした"}, {"type": "subtitle", "time": 3157.15, "timestamp": "00:52:37", "text": "日付。確定した日程はこちらです"}, {"type": "subtitle", "time": 3162.23, "timestamp": "00:52:42", "text": "週。ええ、今週です。明日午後6時"}, {"type": "subtitle", "time": 3165.27, "timestamp": "00:52:45", "text": "午後9時明後日、えーと、"}, {"type": "subtitle", "time": 3167.63, "timestamp": "00:52:47", "text": "木曜日、いいえ、"}, {"type": "subtitle", "time": 3169.23, "timestamp": "00:52:49", "text": "金曜日。"}, {"type": "subtitle", "time": 3174.549, "timestamp": "00:52:54", "text": "おそらくストリーミング配信だろう。彼女は"}, {"type": "subtitle", "time": 3175.549, "timestamp": "00:52:55", "text": "1"}, {"type": "subtitle", "time": 3178.47, "timestamp": "00:52:58", "text": "ここで休憩しましょう。でも、もし彼女がそこにいなかったら、"}]
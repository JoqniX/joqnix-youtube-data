[{"type": "subtitle", "time": 5225.83, "timestamp": "01:27:05", "text": "えっと、私は曲を聴いてみましたが、"}, {"type": "subtitle", "time": 5227.39, "timestamp": "01:27:07", "text": "仕事もしています。私は感じる"}, {"type": "subtitle", "time": 5230.149, "timestamp": "01:27:10", "text": "悪い。雨の音を聞いてみたことはありますか？"}, {"type": "subtitle", "time": 5233.75, "timestamp": "01:27:13", "text": "騒音か雨か何かで、"}, {"type": "subtitle", "time": 5244.83, "timestamp": "01:27:24", "text": "ええ、高いですね"}]
[{"type": "subtitle", "time": 14642.469, "timestamp": "04:04:02", "text": "何か、それからパンチ、またはパンチをする"}, {"type": "subtitle", "time": 14645.11, "timestamp": "04:04:05", "text": "何か。わかった。そして、もしあなたがパンチしたら"}, {"type": "subtitle", "time": 14648.87, "timestamp": "04:04:08", "text": "もしくは、完全に成長した人に何かをする"}, {"type": "subtitle", "time": 14658.63, "timestamp": "04:04:18", "text": "ええ、完全に成長した髭の人、ええ"}, {"type": "subtitle", "time": 14661.429, "timestamp": "04:04:21", "text": "彼らは骨折しないだろう"}, {"type": "subtitle", "time": 14664.469, "timestamp": "04:04:24", "text": "顎を折ったりして、"}, {"type": "subtitle", "time": 14666.99, "timestamp": "04:04:26", "text": "彼らは、影響が少ないように思える、"}, {"type": "subtitle", "time": 14669.83, "timestamp": "04:04:29", "text": "何か。わからない。聞いたところによると"}, {"type": "subtitle", "time": 14672.63, "timestamp": "04:04:32", "text": "それは私が言っているのとは違う。"}, {"type": "subtitle", "time": 14674.55, "timestamp": "04:04:34", "text": "もし動画を入手できたら、共有します"}, {"type": "subtitle", "time": 14676.67, "timestamp": "04:04:36", "text": "それは"}, {"type": "subtitle", "time": 14679.03, "timestamp": "04:04:39", "text": "不和。うん。私が何を言おうと、"}, {"type": "subtitle", "time": 14681.79, "timestamp": "04:04:41", "text": "それを受け取って。私はそうかもしれない"}, {"type": "subtitle", "time": 14684.15, "timestamp": "04:04:44", "text": "何か違うことを言うような"}]
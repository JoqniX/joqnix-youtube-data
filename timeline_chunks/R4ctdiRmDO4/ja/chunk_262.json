[{"type": "subtitle", "time": 15724.99, "timestamp": "04:22:04", "text": "私は持っていたと言った"}, {"type": "subtitle", "time": 15728.03, "timestamp": "04:22:08", "text": "面白いジョークの瞬間"}, {"type": "subtitle", "time": 15730.99, "timestamp": "04:22:10", "text": "昨日のスポーツマンの瞬間"}, {"type": "subtitle", "time": 15733.91, "timestamp": "04:22:13", "text": "昨日。待って、面白いジョークの瞬間？"}, {"type": "subtitle", "time": 15736.71, "timestamp": "04:22:16", "text": "それって私のことだよね？え、何？どうして"}, {"type": "subtitle", "time": 15759.75, "timestamp": "04:22:39", "text": "これ？何てことだ。それは、それは、"}, {"type": "subtitle", "time": 15763.07, "timestamp": "04:22:43", "text": "ユーザー名が怪しい。ああ、"}, {"type": "subtitle", "time": 15766.389, "timestamp": "04:22:46", "text": "神。何てことだ。彼らのユーザー名は最高です"}, {"type": "subtitle", "time": 15767.95, "timestamp": "04:22:47", "text": "サス。おお"}, {"type": "subtitle", "time": 15771.51, "timestamp": "04:22:51", "text": "主。ああ、神様。"}]
[{"type": "subtitle", "time": 15482.07, "timestamp": "04:18:02", "text": "この配信を終えたらすぐに配信しますが"}, {"type": "subtitle", "time": 15483.95, "timestamp": "04:18:03", "text": "また"}, {"type": "subtitle", "time": 15485.55, "timestamp": "04:18:05", "text": "のように"}, {"type": "subtitle", "time": 15488.71, "timestamp": "04:18:08", "text": "ジョッキー、目を覚ます必要がある"}, {"type": "subtitle", "time": 15491.63, "timestamp": "04:18:11", "text": "明日、そして"}, {"type": "subtitle", "time": 15493.34, "timestamp": "04:18:13", "text": "私は"}, {"type": "subtitle", "time": 15495.469, "timestamp": "04:18:15", "text": "[音楽]"}, {"type": "subtitle", "time": 15499.91, "timestamp": "04:18:19", "text": "わからないけど、最近は"}, {"type": "subtitle", "time": 15500.91, "timestamp": "04:18:20", "text": "感覚"}, {"type": "subtitle", "time": 15504.07, "timestamp": "04:18:24", "text": "最近は配信をやっているのですが"}, {"type": "subtitle", "time": 15505.67, "timestamp": "04:18:25", "text": "ストリーミング配信とかしたいから。"}, {"type": "subtitle", "time": 15510.269, "timestamp": "04:18:30", "text": "いいえ、ストリーミングする義務があるから、"}, {"type": "subtitle", "time": 15513.149, "timestamp": "04:18:33", "text": "何か何か。私はしません"}, {"type": "subtitle", "time": 15516.229, "timestamp": "04:18:36", "text": "知る。最近、"}, {"type": "subtitle", "time": 15518.55, "timestamp": "04:18:38", "text": "あまり生産的ではない、生産的なスポーツマン"}, {"type": "subtitle", "time": 15521.11, "timestamp": "04:18:41", "text": "瞬間とか、そんな感じ。わからない。多分"}, {"type": "subtitle", "time": 15522.51, "timestamp": "04:18:42", "text": "ただ"}, {"type": "subtitle", "time": 15526.07, "timestamp": "04:18:46", "text": "自分。しかし、どのような種類だろうか？"}, {"type": "subtitle", "time": 15528.349, "timestamp": "04:18:48", "text": "うん、たぶん私だけかもしれないね。私はしません"}, {"type": "subtitle", "time": 15531.99, "timestamp": "04:18:51", "text": "知る。単なるミームかもしれない。楽しい"}, {"type": "subtitle", "time": 15534.309, "timestamp": "04:18:54", "text": "実際、私は山全体をたどって"}, {"type": "subtitle", "time": 15538.149, "timestamp": "04:18:58", "text": "夜明けから夕暮れまで友達とカフェで"}]
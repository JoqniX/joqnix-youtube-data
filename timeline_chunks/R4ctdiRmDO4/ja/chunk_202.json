[{"type": "subtitle", "time": 12120.83, "timestamp": "03:22:00", "text": "[音楽]"}, {"type": "subtitle", "time": 12126.429, "timestamp": "03:22:06", "text": "それ。とても美味しいです。このような"}, {"type": "subtitle", "time": 12129.429, "timestamp": "03:22:09", "text": "けれど。私はこの相棒が欲しい。それはとても"}, {"type": "subtitle", "time": 12131.91, "timestamp": "03:22:11", "text": "ピンク色で、ヘビです。 D. 待って、君"}, {"type": "subtitle", "time": 12134.469, "timestamp": "03:22:14", "text": "よく見えないのは、"}, {"type": "subtitle", "time": 12137.51, "timestamp": "03:22:17", "text": "待って、ちゃんと"}, {"type": "subtitle", "time": 12146.71, "timestamp": "03:22:26", "text": "ああ、見てごらん。とてもかわいい。欲しい"}, {"type": "subtitle", "time": 12148.83, "timestamp": "03:22:28", "text": "これだけでなく"}, {"type": "subtitle", "time": 12151.269, "timestamp": "03:22:31", "text": "お金を使いたくないんです。いいえ、"}, {"type": "subtitle", "time": 12154.55, "timestamp": "03:22:34", "text": "いいえ。貯金中です。そう、騎手だよ。あなた"}, {"type": "subtitle", "time": 12160.349, "timestamp": "03:22:40", "text": "お金。はい。かわいい"}, {"type": "subtitle", "time": 12163.59, "timestamp": "03:22:43", "text": "確かに。さあ行こう。ピューピューと撃ちたい。"}, {"type": "subtitle", "time": 12166.19, "timestamp": "03:22:46", "text": "チャレンジに挑戦して"}, {"type": "subtitle", "time": 12169.19, "timestamp": "03:22:49", "text": "もの。だから、監督を2人起用しよう。えっと、"}, {"type": "subtitle", "time": 12173.269, "timestamp": "03:22:53", "text": "すべてのイベントで起こることと同じ"}, {"type": "subtitle", "time": 12176.87, "timestamp": "03:22:56", "text": "ダメージを与えることでキルを奪う評価トップ4"}, {"type": "subtitle", "time": 12177.71, "timestamp": "03:22:57", "text": "全て"}]
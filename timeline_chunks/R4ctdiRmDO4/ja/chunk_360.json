[{"type": "subtitle", "time": 21601.91, "timestamp": "06:00:01", "text": "そしてその感覚が好きで、そして好きではない"}, {"type": "subtitle", "time": 21602.83, "timestamp": "06:00:02", "text": "あなた"}, {"type": "subtitle", "time": 21605.51, "timestamp": "06:00:05", "text": "終わらせるためだけにやる"}, {"type": "subtitle", "time": 21608.11, "timestamp": "06:00:08", "text": "あるいは、そんな感じ。わからない。だから、あるいは"}, {"type": "subtitle", "time": 21612.15, "timestamp": "06:00:12", "text": "何かあるんだけど、よくわからない。私はこう思う、"}, {"type": "subtitle", "time": 21614.15, "timestamp": "06:00:14", "text": "うん、助けを求めない方がいいよ。"}, {"type": "subtitle", "time": 21626.708, "timestamp": "06:00:26", "text": "ビリーに対しても同じように感じた"}, {"type": "subtitle", "time": 21629.35, "timestamp": "06:00:29", "text": "ビリーの状況もそうだ。"}, {"type": "subtitle", "time": 21630.19, "timestamp": "06:00:30", "text": "のように"}, {"type": "subtitle", "time": 21633.19, "timestamp": "06:00:33", "text": "私がどのように質問し、他の人に頼っていたか"}, {"type": "subtitle", "time": 21636.23, "timestamp": "06:00:36", "text": "私を助けてくれる人たち、でも"}, {"type": "subtitle", "time": 21638.67, "timestamp": "06:00:38", "text": "彼らは他のことで忙しく、"}, {"type": "subtitle", "time": 21641.948, "timestamp": "06:00:41", "text": "すべて。私は"}, {"type": "subtitle", "time": 21644.51, "timestamp": "06:00:44", "text": "まるで私が誰かのよう"}, {"type": "subtitle", "time": 21655.868, "timestamp": "06:00:55", "text": "ああ、私もそう感じた"}, {"type": "subtitle", "time": 21659.35, "timestamp": "06:00:59", "text": "どれほど邪魔をするのが嫌だろうか"}]
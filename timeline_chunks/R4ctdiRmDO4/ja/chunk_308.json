[{"type": "subtitle", "time": 18487.708, "timestamp": "05:08:07", "text": "肌。これは良かった"}, {"type": "subtitle", "time": 18491.51, "timestamp": "05:08:11", "text": "ええと、急速な変化を見てください。低そうに見える"}, {"type": "subtitle", "time": 18493.35, "timestamp": "05:08:13", "text": "私には目標があるので、品質を重視します"}, {"type": "subtitle", "time": 18495.15, "timestamp": "05:08:15", "text": "低いのは"}, {"type": "subtitle", "time": 18504.03, "timestamp": "05:08:24", "text": "大きな"}, {"type": "subtitle", "time": 18506.08, "timestamp": "05:08:26", "text": "男の子。"}, {"type": "subtitle", "time": 18509.628, "timestamp": "05:08:29", "text": "[音楽]"}, {"type": "subtitle", "time": 18511.37, "timestamp": "05:08:31", "text": "おお。"}, {"type": "subtitle", "time": 18512.83, "timestamp": "05:08:32", "text": "[音楽]"}, {"type": "subtitle", "time": 18519.55, "timestamp": "05:08:39", "text": "お金。"}, {"type": "subtitle", "time": 18522.31, "timestamp": "05:08:42", "text": "えっと、どうしたらいいのか分かりません。私はすべきでしょうか"}, {"type": "subtitle", "time": 18525.07, "timestamp": "05:08:45", "text": "続けるべきか、それとも試すべきか"}, {"type": "subtitle", "time": 18527.91, "timestamp": "05:08:47", "text": "最高？最善を尽くしてみます。たとえ"}, {"type": "subtitle", "time": 18532.19, "timestamp": "05:08:52", "text": "動作が遅いけど、問題ないよ。最善を尽くします。"}]
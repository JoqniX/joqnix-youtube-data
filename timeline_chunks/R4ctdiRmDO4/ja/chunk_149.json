[{"type": "subtitle", "time": 8940.51, "timestamp": "02:29:00", "text": "もの。"}, {"type": "subtitle", "time": 8950.309, "timestamp": "02:29:10", "text": "問題は、私が"}, {"type": "subtitle", "time": 8954.51, "timestamp": "02:29:14", "text": "視聴者参加型ストリームを制限することは"}, {"type": "subtitle", "time": 8958.91, "timestamp": "02:29:18", "text": "なぜなら私は長い間悪い経験をしてきたからです"}, {"type": "subtitle", "time": 8960.99, "timestamp": "02:29:20", "text": "戻る"}, {"type": "subtitle", "time": 8964.71, "timestamp": "02:29:24", "text": "だから、私はそれで構わない"}, {"type": "subtitle", "time": 8966.55, "timestamp": "02:29:26", "text": "人と遊ぶのが好きな人、または人と遊ぶのが好きな人"}, {"type": "subtitle", "time": 8970.309, "timestamp": "02:29:30", "text": "などなど、でも、そのせいで悪いんです"}, {"type": "subtitle", "time": 8972.23, "timestamp": "02:29:32", "text": "過去に起こった出来事は、"}, {"type": "subtitle", "time": 8974.349, "timestamp": "02:29:34", "text": "本当に"}, {"type": "subtitle", "time": 8978.71, "timestamp": "02:29:38", "text": "慎重だけど、私は"}, {"type": "subtitle", "time": 8981.83, "timestamp": "02:29:41", "text": "えっと、コラボレーションとか色々。私は覚えている"}, {"type": "subtitle", "time": 8983.15, "timestamp": "02:29:43", "text": "あなたが言った。"}, {"type": "subtitle", "time": 8986.55, "timestamp": "02:29:46", "text": "ええ、今日そのことについて話したんですよ。えっと"}, {"type": "subtitle", "time": 8991.51, "timestamp": "02:29:51", "text": "友達が"}]
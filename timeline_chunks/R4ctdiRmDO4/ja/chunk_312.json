[{"type": "subtitle", "time": 18726.07, "timestamp": "05:12:06", "text": "確かに、それぞれ違うよね？"}, {"type": "subtitle", "time": 18733.23, "timestamp": "05:12:13", "text": "[音楽]"}, {"type": "subtitle", "time": 18741.19, "timestamp": "05:12:21", "text": "でも、このスキンを手に入れてからは一度も使っていません"}, {"type": "subtitle", "time": 18748.19, "timestamp": "05:12:28", "text": "神。ああ、これ"}, {"type": "subtitle", "time": 18751.39, "timestamp": "05:12:31", "text": "ちくしょう。鉄製の箱。ええ、鉄です"}, {"type": "subtitle", "time": 18754.948, "timestamp": "05:12:34", "text": "ブロック。だから私のグラフィックカーは、"}, {"type": "subtitle", "time": 18757.628, "timestamp": "05:12:37", "text": "文字通りアイロンのような感触"}, {"type": "subtitle", "time": 18761.35, "timestamp": "05:12:41", "text": "箱に入れてください。すごく暑いので。エアコンが効いていても"}, {"type": "subtitle", "time": 18764.868, "timestamp": "05:12:44", "text": "もう何時間くらいつけっぱなしなんだろう？"}, {"type": "subtitle", "time": 18765.948, "timestamp": "05:12:45", "text": "私はしません"}, {"type": "subtitle", "time": 18768.39, "timestamp": "05:12:48", "text": "知る。もう何人いるかわからない"}, {"type": "subtitle", "time": 18775.91, "timestamp": "05:12:55", "text": "ちなみにそれは悪いことです"}]
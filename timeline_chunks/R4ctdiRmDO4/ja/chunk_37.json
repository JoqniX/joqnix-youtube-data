[{"type": "subtitle", "time": 2220.99, "timestamp": "00:37:00", "text": "あれ。つまり、VTuberのオメグル"}, {"type": "subtitle", "time": 2223.67, "timestamp": "00:37:03", "text": "あれ。私たちは雑談する。彼らはイベントを開催します"}, {"type": "subtitle", "time": 2233.31, "timestamp": "00:37:13", "text": "えっと、これは誰が主催しているんですか？"}, {"type": "subtitle", "time": 2242.27, "timestamp": "00:37:22", "text": "読み込み中です。ああ、なんてことだ。あ、待って。それは"}, {"type": "subtitle", "time": 2247.23, "timestamp": "00:37:27", "text": "それは私が知っているものですか"}, {"type": "subtitle", "time": 2251.19, "timestamp": "00:37:31", "text": "彼女。私は彼女を知っている。待って、それはオーマイ"}, {"type": "subtitle", "time": 2253.99, "timestamp": "00:37:33", "text": "神。彼女の名前を忘れてしまった。ごめんなさい。私はそうしました"}, {"type": "subtitle", "time": 2256.15, "timestamp": "00:37:36", "text": "Twitterでフォローします。何てことだ。彼女は"}, {"type": "subtitle", "time": 2258.03, "timestamp": "00:37:38", "text": "ホスティング"}, {"type": "subtitle", "time": 2262.589, "timestamp": "00:37:42", "text": "それ。待って、それはそれは"}, {"type": "subtitle", "time": 2265.19, "timestamp": "00:37:45", "text": "えっと、彼女はどこにいるの？"}, {"type": "subtitle", "time": 2268.75, "timestamp": "00:37:48", "text": "タイムラインは常に？私はいつも彼女を私の"}, {"type": "subtitle", "time": 2270.19, "timestamp": "00:37:50", "text": "[音楽]"}, {"type": "chat", "time": 2271.06, "timestamp": "00:37:51", "author": "@AKSHAY-qt8oj", "avatar": "https://yt4.ggpht.com/ZwKRpaq_Ug9LghG0R1lyE02nZuJA8_EGcBDRKCwLPHhmICNVxR-3VtAEjcOtxBq32OfpsfSX=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/egJ1XufTKYfegwOo57ewAg"}]
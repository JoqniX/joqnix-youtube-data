[{"type": "subtitle", "time": 11582.23, "timestamp": "03:13:02", "text": "少なくとも私を助けてくれる人がたくさんいます"}, {"type": "subtitle", "time": 11584.71, "timestamp": "03:13:04", "text": "アカウントの登録が完了するまでお待ちください"}, {"type": "subtitle", "time": 11585.79, "timestamp": "03:13:05", "text": "そして"}, {"type": "subtitle", "time": 11590.67, "timestamp": "03:13:10", "text": "いいね、いいね、私たちのために12個あります"}, {"type": "subtitle", "time": 11594.309, "timestamp": "03:13:14", "text": "ファン。それは私にとっては大きな数字です。 12"}, {"type": "subtitle", "time": 11596.79, "timestamp": "03:13:16", "text": "IOの。それは大きな数字ですね。あなた"}, {"type": "subtitle", "time": 11600.469, "timestamp": "03:13:20", "text": "彼らを取り戻せると思いますか？つまり、私は"}, {"type": "subtitle", "time": 11602.59, "timestamp": "03:13:22", "text": "わからない、"}, {"type": "subtitle", "time": 11605.51, "timestamp": "03:13:25", "text": "でも、私はそうしたくない。そして私は"}, {"type": "subtitle", "time": 11608.309, "timestamp": "03:13:28", "text": "タイの動画をたくさん見て"}, {"type": "subtitle", "time": 11610.55, "timestamp": "03:13:30", "text": "もの。レベル3に上げるだけです。"}, {"type": "subtitle", "time": 11613.349, "timestamp": "03:13:33", "text": "レベル3、だって私がレベル5か"}, {"type": "subtitle", "time": 11615.51, "timestamp": "03:13:35", "text": "6、それから私はみんなと同じように"}, {"type": "subtitle", "time": 11617.11, "timestamp": "03:13:37", "text": "私の制限と制約"}, {"type": "subtitle", "time": 11619.19, "timestamp": "03:13:39", "text": "アカウントは解除されます。だから、私は"}, {"type": "subtitle", "time": 11621.67, "timestamp": "03:13:41", "text": "レベルアップに必死に挑戦するようなものだ。しかし、"}, {"type": "subtitle", "time": 11624.469, "timestamp": "03:13:44", "text": "レベルアップは難しいけどね。のように"}, {"type": "subtitle", "time": 11626.349, "timestamp": "03:13:46", "text": "これには本当にたくさんの要素が詰まっている。そして私は"}, {"type": "subtitle", "time": 11628.79, "timestamp": "03:13:48", "text": "私が行くという事実のように、私はただ"}, {"type": "subtitle", "time": 11632.389, "timestamp": "03:13:52", "text": "これは削除しなければならない"}, {"type": "subtitle", "time": 11635.469, "timestamp": "03:13:55", "text": "現実世界での検証のため"}, {"type": "subtitle", "time": 11637.71, "timestamp": "03:13:57", "text": "プロセスと、私は"}]
[{"type": "subtitle", "time": 11520.67, "timestamp": "03:12:00", "text": "D それはまずい。"}, {"type": "subtitle", "time": 11527.59, "timestamp": "03:12:07", "text": "自分。ああ、扇風機が回らない。いいえ、"}, {"type": "subtitle", "time": 11532.33, "timestamp": "03:12:12", "text": "ゲームがひどくカクカクしていたのも無理はない。"}, {"type": "subtitle", "time": 11533.51, "timestamp": "03:12:13", "text": "[音楽]"}, {"type": "subtitle", "time": 11535.59, "timestamp": "03:12:15", "text": "私には何が好きかわからないので、これを持っています"}, {"type": "subtitle", "time": 11542.51, "timestamp": "03:12:22", "text": "良い。たくさんの"}, {"type": "subtitle", "time": 11545.15, "timestamp": "03:12:25", "text": "もの。どのように"}, {"type": "subtitle", "time": 11555.51, "timestamp": "03:12:35", "text": "すべて？正直に言うと、"}, {"type": "subtitle", "time": 11557.349, "timestamp": "03:12:37", "text": "まあ、でも最終的には、気にしなくていいよ。の"}, {"type": "subtitle", "time": 11560.389, "timestamp": "03:12:40", "text": "もちろん、申し訳なく思うだろう。ご存知ですか？"}, {"type": "subtitle", "time": 11562.55, "timestamp": "03:12:42", "text": "ビリー・ビリーについてたくさん話してきた"}, {"type": "subtitle", "time": 11563.71, "timestamp": "03:12:43", "text": "オーバー"}, {"type": "subtitle", "time": 11566.349, "timestamp": "03:12:46", "text": "過去1年またはそれに近い"}, {"type": "subtitle", "time": 11569.59, "timestamp": "03:12:49", "text": "二？かなりの量ですね。私は話しました"}, {"type": "subtitle", "time": 11570.99, "timestamp": "03:12:50", "text": "それについて"}, {"type": "subtitle", "time": 11573.15, "timestamp": "03:12:53", "text": "多く。手に入れた"}, {"type": "subtitle", "time": 11575.55, "timestamp": "03:12:55", "text": "声。のように"}, {"type": "subtitle", "time": 11579.59, "timestamp": "03:12:59", "text": "私が尋ねなければならなかったという事実を想像してみてください"}]
[{"type": "subtitle", "time": 13028.59, "timestamp": "03:37:08", "text": "あなたが知っている"}, {"type": "subtitle", "time": 13032.309, "timestamp": "03:37:12", "text": "何？ GXを書き終えて戻ってきました。おお"}, {"type": "subtitle", "time": 13036.07, "timestamp": "03:37:16", "text": "ああ、すっかり忘れてた。それ"}, {"type": "subtitle", "time": 13049.07, "timestamp": "03:37:29", "text": "ああ、そうだった"}, {"type": "subtitle", "time": 13051.59, "timestamp": "03:37:31", "text": "遅れている。私はこれに関して何もできません"}, {"type": "subtitle", "time": 13055.269, "timestamp": "03:37:35", "text": "私のGPUでは処理できないので、もうゲームはできません"}, {"type": "subtitle", "time": 13056.19, "timestamp": "03:37:36", "text": "何でも"}, {"type": "subtitle", "time": 13058.91, "timestamp": "03:37:38", "text": "もう私は"}, {"type": "subtitle", "time": 13066.429, "timestamp": "03:37:46", "text": "大丈夫。それは"}, {"type": "subtitle", "time": 13069.11, "timestamp": "03:37:49", "text": "大丈夫。ちょっと立ち止まってみようと思います。私はしません"}, {"type": "subtitle", "time": 13072.19, "timestamp": "03:37:52", "text": "とても悪いと分かっています。そんなこと言わないで。彼は"}]
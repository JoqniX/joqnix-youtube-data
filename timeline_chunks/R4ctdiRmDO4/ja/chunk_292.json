[{"type": "subtitle", "time": 17522.99, "timestamp": "04:52:02", "text": "Apex、Overwatch のようにストリーミングするのではなく、"}, {"type": "subtitle", "time": 17526.99, "timestamp": "04:52:06", "text": "フォートナイト。ヴァレリンについてはよくわからない"}, {"type": "subtitle", "time": 17530.55, "timestamp": "04:52:10", "text": "けれど。最悪だよ。痛みですが、"}, {"type": "subtitle", "time": 17533.708, "timestamp": "04:52:13", "text": "大丈夫です。たぶんそうじゃないと思う"}, {"type": "subtitle", "time": 17536.31, "timestamp": "04:52:16", "text": "知る。ホンカとか、そういうのもできるよ。"}, {"type": "subtitle", "time": 17539.708, "timestamp": "04:52:19", "text": "原神、心配なのは"}, {"type": "subtitle", "time": 17543.03, "timestamp": "04:52:23", "text": "それ。原神はうまくいくでしょうか、なぜならそれは"}, {"type": "subtitle", "time": 17544.948, "timestamp": "04:52:24", "text": "土地と権利に関する出来事。私は"}, {"type": "subtitle", "time": 17547.39, "timestamp": "04:52:27", "text": "これをストリーミングする"}, {"type": "subtitle", "time": 17550.23, "timestamp": "04:52:30", "text": "週。うん。ああ、2つ終わったよ"}, {"type": "subtitle", "time": 17554.15, "timestamp": "04:52:34", "text": "課題。よし、1つ全部終わったぞ。はい。"}, {"type": "subtitle", "time": 17574.708, "timestamp": "04:52:54", "text": "問題。でも、動作が遅いですね。"}, {"type": "subtitle", "time": 17576.11, "timestamp": "04:52:56", "text": "それは"}, {"type": "subtitle", "time": 17579.43, "timestamp": "04:52:59", "text": "大丈夫。再起動すべきか考えている"}]
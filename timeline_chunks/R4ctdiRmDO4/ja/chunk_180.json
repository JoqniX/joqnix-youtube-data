[{"type": "subtitle", "time": 10800.469, "timestamp": "03:00:00", "text": "もし私たちが目標を達成し、"}, {"type": "subtitle", "time": 10803.429, "timestamp": "03:00:03", "text": "私がリリースできたもの"}, {"type": "subtitle", "time": 10807.83, "timestamp": "03:00:07", "text": "デザインの問題は、いくつか"}, {"type": "subtitle", "time": 10811.83, "timestamp": "03:00:11", "text": "モデルアートに修正が必要"}, {"type": "subtitle", "time": 10814.55, "timestamp": "03:00:14", "text": "だから、その修正をしなければならない"}, {"type": "subtitle", "time": 10816.469, "timestamp": "03:00:16", "text": "その生産が行われるためには、"}, {"type": "subtitle", "time": 10819.19, "timestamp": "03:00:19", "text": "著者には時給で支払わなければならず、"}, {"type": "subtitle", "time": 10821.59, "timestamp": "03:00:21", "text": "私が持っていないもの"}, {"type": "subtitle", "time": 10825.469, "timestamp": "03:00:25", "text": "一瞬。私はお金がない、私はお金がない"}, {"type": "subtitle", "time": 10828.23, "timestamp": "03:00:28", "text": "蜂。ええ、そういうことです。さらに、私は"}, {"type": "subtitle", "time": 10829.91, "timestamp": "03:00:29", "text": "ライセンスを取得しなければならない"}, {"type": "subtitle", "time": 10832.15, "timestamp": "03:00:32", "text": "そしてその裏にはたくさんのものがある"}, {"type": "subtitle", "time": 10835.429, "timestamp": "03:00:35", "text": "シーン。だから、本当に面倒なんだよ。"}, {"type": "subtitle", "time": 10837.71, "timestamp": "03:00:37", "text": "そうでなければ、私はそれを大々的に宣伝していたでしょう、"}, {"type": "subtitle", "time": 10840.71, "timestamp": "03:00:40", "text": "知ってるよ、実際、それを大々的に宣伝して"}, {"type": "subtitle", "time": 10842.87, "timestamp": "03:00:42", "text": "このイベント。"}, {"type": "subtitle", "time": 10845.23, "timestamp": "03:00:45", "text": "残念ながら、物事は私の思い通りには進みませんでした。"}, {"type": "subtitle", "time": 10851.71, "timestamp": "03:00:51", "text": "画面。"}, {"type": "subtitle", "time": 10853.95, "timestamp": "03:00:53", "text": "えっと、なぜ"}]
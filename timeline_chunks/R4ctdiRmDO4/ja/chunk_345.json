[{"type": "subtitle", "time": 20702.07, "timestamp": "05:45:02", "text": "今年もまた、私のGPO"}, {"type": "subtitle", "time": 20705.03, "timestamp": "05:45:05", "text": "この状況はちょっと怖い。"}, {"type": "subtitle", "time": 20707.59, "timestamp": "05:45:07", "text": "そうですね、そして明日も、もし私たちが"}, {"type": "subtitle", "time": 20710.948, "timestamp": "05:45:10", "text": "Twitchでストリーミング配信します。"}, {"type": "subtitle", "time": 20714.07, "timestamp": "05:45:14", "text": "実際にストリームでチュートリアルを作成しています"}, {"type": "subtitle", "time": 20717.19, "timestamp": "05:45:17", "text": "主に知りたいのは、えっと"}, {"type": "subtitle", "time": 20720.948, "timestamp": "05:45:20", "text": "録音する方法を学び、練習する"}, {"type": "subtitle", "time": 20724.15, "timestamp": "05:45:24", "text": "ストリーミングしながら動画とか色々やってるよ"}, {"type": "subtitle", "time": 20726.39, "timestamp": "05:45:26", "text": "もしそれが私がビデオを録画するようなものなら"}, {"type": "subtitle", "time": 20728.868, "timestamp": "05:45:28", "text": "それを取り上げると、それ以上のことになるでしょう"}, {"type": "subtitle", "time": 20731.07, "timestamp": "05:45:31", "text": "50～60カットまたは"}, {"type": "subtitle", "time": 20734.07, "timestamp": "05:45:34", "text": "撮り直しはしたくない、やりたいことは"}, {"type": "subtitle", "time": 20736.788, "timestamp": "05:45:36", "text": "これが私のライブ配信のやり方です。くそ。"}, {"type": "subtitle", "time": 20738.83, "timestamp": "05:45:38", "text": "これらは全て生々しいものですよね？準備不足で、"}, {"type": "subtitle", "time": 20742.35, "timestamp": "05:45:42", "text": "計画なし、行き当たりばったりといった感じ"}, {"type": "subtitle", "time": 20745.43, "timestamp": "05:45:45", "text": "あれ。私も同じものが欲しかった"}, {"type": "subtitle", "time": 20748.15, "timestamp": "05:45:48", "text": "何か、でも、もっと良い感じ"}, {"type": "subtitle", "time": 20750.23, "timestamp": "05:45:50", "text": "台本があるかどうかは別として、"}, {"type": "subtitle", "time": 20751.99, "timestamp": "05:45:51", "text": "言うこと、その他諸々。それで、"}, {"type": "subtitle", "time": 20754.868, "timestamp": "05:45:54", "text": "それは明日行います。プラス、"}, {"type": "subtitle", "time": 20758.628, "timestamp": "05:45:58", "text": "私たちが言ったことは何でも追加して"}]
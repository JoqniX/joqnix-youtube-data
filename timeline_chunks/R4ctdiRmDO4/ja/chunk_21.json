[{"type": "subtitle", "time": 1290.149, "timestamp": "00:21:30", "text": "わかった。私はノーランとそれほど親しくなく、"}, {"type": "subtitle", "time": 1294.39, "timestamp": "00:21:34", "text": "ノーランとは連絡が取りづらい。"}, {"type": "subtitle", "time": 1296.71, "timestamp": "00:21:36", "text": "私には知らない友達がいる、私は"}, {"type": "subtitle", "time": 1300.35, "timestamp": "00:21:40", "text": "それに近いですが、インタラクターがあります"}, {"type": "subtitle", "time": 1303.99, "timestamp": "00:21:43", "text": "以前は素敵で、ノーランも"}, {"type": "subtitle", "time": 1306.39, "timestamp": "00:21:46", "text": "実際に"}, {"type": "subtitle", "time": 1309.35, "timestamp": "00:21:49", "text": "ビリー・ビリーに勧められたんだ"}, {"type": "subtitle", "time": 1312.75, "timestamp": "00:21:52", "text": "私はここでこれをストリーミングしています"}]
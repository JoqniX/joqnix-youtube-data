[{"type": "subtitle", "time": 13800.55, "timestamp": "03:50:00", "text": "助けを求めてください。そして私は「わあ」と思った。何てことだ。"}, {"type": "subtitle", "time": 13816.15, "timestamp": "03:50:16", "text": "有名な。あと、私の話は気にしないでください"}, {"type": "subtitle", "time": 13818.55, "timestamp": "03:50:18", "text": "ビリーについて、ビリーは気軽に、あるいは"}, {"type": "subtitle", "time": 13821.269, "timestamp": "03:50:21", "text": "突然どこからともなく現れて、"}, {"type": "subtitle", "time": 13822.51, "timestamp": "03:50:22", "text": "の中へ"}, {"type": "subtitle", "time": 13824.83, "timestamp": "03:50:24", "text": "何て言うんだっけ"}, {"type": "subtitle", "time": 13828.75, "timestamp": "03:50:28", "text": "それ？ペイントパックwbeまたは"}, {"type": "subtitle", "time": 13831.91, "timestamp": "03:50:31", "text": "何か。でも、まあ、気にしないでください。"}, {"type": "subtitle", "time": 13832.67, "timestamp": "03:50:32", "text": "その"}, {"type": "subtitle", "time": 13837.429, "timestamp": "03:50:37", "text": "最近、私の心は、ほら、"}, {"type": "subtitle", "time": 13839.03, "timestamp": "03:50:39", "text": "私は落ち込んでいた"}, {"type": "subtitle", "time": 13848.469, "timestamp": "03:50:48", "text": "痛み。でも、数日後には"}]
[{"type": "subtitle", "time": 18780.39, "timestamp": "05:13:00", "text": "5:30から7:08までは電源を入れてはいけません"}, {"type": "subtitle", "time": 18783.99, "timestamp": "05:13:03", "text": "エアコンとか、何でもいいんだけど。なぜならアルト漏れがあるから"}, {"type": "subtitle", "time": 18829.59, "timestamp": "05:13:49", "text": "聖なる主よ。私は死んでいるのに、どうしてこうなったの？それはとても"}, {"type": "subtitle", "time": 18837.99, "timestamp": "05:13:57", "text": "あなたはもういない。"}]
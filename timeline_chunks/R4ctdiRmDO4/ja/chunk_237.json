[{"type": "subtitle", "time": 14228.469, "timestamp": "03:57:08", "text": "ピキー。いいえ、彼らはドアを破壊しました。できる"}, {"type": "subtitle", "time": 14230.349, "timestamp": "03:57:10", "text": "私たちはここに留まるだけです"}, {"type": "subtitle", "time": 14253.59, "timestamp": "03:57:33", "text": "でも、どちらにしても、私がそうしたいなら"}, {"type": "subtitle", "time": 14256.51, "timestamp": "03:57:36", "text": "ビリービリーから出て"}, {"type": "subtitle", "time": 14259.03, "timestamp": "03:57:39", "text": "現在ビリーで直面している問題"}, {"type": "subtitle", "time": 14261.91, "timestamp": "03:57:41", "text": "ビリー、"}, {"type": "subtitle", "time": 14263.83, "timestamp": "03:57:43", "text": "私は中国人の友達が必要です"}, {"type": "subtitle", "time": 14266.15, "timestamp": "03:57:46", "text": "私に個人的な"}, {"type": "subtitle", "time": 14268.389, "timestamp": "03:57:48", "text": "誰かを助けるような情報"}, {"type": "subtitle", "time": 14272.07, "timestamp": "03:57:52", "text": "手伝ってくれよ。しかし、それは"}, {"type": "subtitle", "time": 14275.189, "timestamp": "03:57:55", "text": "こう考えてみてください。"}, {"type": "subtitle", "time": 14277.83, "timestamp": "03:57:57", "text": "あなたが知らない人が"}]
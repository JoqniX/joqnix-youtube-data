[{"type": "subtitle", "time": 363.07, "timestamp": "00:06:03", "text": "多くのコラボレーションが絶え間なく続く"}, {"type": "subtitle", "time": 366.87, "timestamp": "00:06:06", "text": "クリエイター。えっと、これをリリースします"}, {"type": "subtitle", "time": 370.39, "timestamp": "00:06:10", "text": "明日を今日に。今夜、私は思う"}, {"type": "subtitle", "time": 374.67, "timestamp": "00:06:14", "text": "チャイを手に入れた、いや、紅茶じゃなくて"}, {"type": "subtitle", "time": 377.029, "timestamp": "00:06:17", "text": "チャイ。今夜は徹夜するつもりです。"}, {"type": "subtitle", "time": 380.83, "timestamp": "00:06:20", "text": "いや、一晩中じゃないよ。明日コラボ。"}, {"type": "subtitle", "time": 384.23, "timestamp": "00:06:24", "text": "うん、時間通りに寝ないとね。私は持っている"}, {"type": "subtitle", "time": 385.71, "timestamp": "00:06:25", "text": "もっと"}, {"type": "subtitle", "time": 389.749, "timestamp": "00:06:29", "text": "責任者。混乱して、えーと"}, {"type": "subtitle", "time": 391.99, "timestamp": "00:06:31", "text": "共同作業パートナーに対して失礼な行為。私"}, {"type": "subtitle", "time": 399.11, "timestamp": "00:06:39", "text": "時間。夕食は早めに食べましょう。食事を食べる"}, {"type": "subtitle", "time": 402.629, "timestamp": "00:06:42", "text": "早い。十分な休憩を取ってください。私はしなければならない"}, {"type": "subtitle", "time": 410.99, "timestamp": "00:06:50", "text": "最高。うん。全力を尽くさなければならない。"}, {"type": "subtitle", "time": 413.51, "timestamp": "00:06:53", "text": "うん。悲しいことの一つは、"}, {"type": "subtitle", "time": 415.39, "timestamp": "00:06:55", "text": "中華料理が食べられなかった"}, {"type": "subtitle", "time": 418.99, "timestamp": "00:06:58", "text": "YouTuberコラボ。しかし"}]
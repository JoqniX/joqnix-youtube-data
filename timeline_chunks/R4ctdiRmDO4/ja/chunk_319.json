[{"type": "subtitle", "time": 19149.83, "timestamp": "05:19:09", "text": "それを受け取ります。盗んだのは間違いない"}, {"type": "subtitle", "time": 19157.47, "timestamp": "05:19:17", "text": "もの。私はとても奇妙に見えるが、"}, {"type": "subtitle", "time": 19178.948, "timestamp": "05:19:38", "text": "大丈夫。私は自分がクラスターだと思っていた"}, {"type": "subtitle", "time": 19181.59, "timestamp": "05:19:41", "text": "ゲームのためですが、まあ、こうしてここにいます。クラスタ"}, {"type": "subtitle", "time": 19184.708, "timestamp": "05:19:44", "text": "後退する。クラスターとは何ですか？過度に"}, {"type": "subtitle", "time": 19188.27, "timestamp": "05:19:48", "text": "何かが起こっているとか、そういうこと。質問"}]
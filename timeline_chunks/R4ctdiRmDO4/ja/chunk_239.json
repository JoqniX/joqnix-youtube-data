[{"type": "subtitle", "time": 14342.15, "timestamp": "03:59:02", "text": "そう考えてみてください。"}, {"type": "subtitle", "time": 14347.469, "timestamp": "03:59:07", "text": "例えば昨日、こんなDMをもらったんだけど"}, {"type": "subtitle", "time": 14351.429, "timestamp": "03:59:11", "text": "男が私にこう言った"}, {"type": "subtitle", "time": 14354.389, "timestamp": "03:59:14", "text": "甘い言葉で話して、それから"}, {"type": "subtitle", "time": 14356.95, "timestamp": "03:59:16", "text": "たまたまSteamアカウントだった"}, {"type": "subtitle", "time": 14361.03, "timestamp": "03:59:21", "text": "Steamアカウント詐欺みたいな"}, {"type": "subtitle", "time": 14363.11, "timestamp": "03:59:23", "text": "彼らは「ああ、私は何かした」と言うでしょう"}, {"type": "subtitle", "time": 14365.11, "timestamp": "03:59:25", "text": "Steam アカウントで、"}, {"type": "subtitle", "time": 14367.229, "timestamp": "03:59:27", "text": "これはSteamアカウントですか？"}, {"type": "subtitle", "time": 14370.51, "timestamp": "03:59:30", "text": "あなたかどうか彼らはあなたに尋ねます"}, {"type": "subtitle", "time": 14373.79, "timestamp": "03:59:33", "text": "それとか、そういうこと。うん。うん。私はこう思う、"}, {"type": "subtitle", "time": 14377.269, "timestamp": "03:59:37", "text": "いや、違うよ。ただこう言っただけ。"}, {"type": "subtitle", "time": 14380.07, "timestamp": "03:59:40", "text": "なんでこんなクソ野郎なんだ？私はそうじゃない、それはまるで"}, {"type": "subtitle", "time": 14383.269, "timestamp": "03:59:43", "text": "Steamでやってる詐欺みたいなやつ。"}, {"type": "subtitle", "time": 14386.15, "timestamp": "03:59:46", "text": "もちろん、そんな手には引っかからないよ。"}, {"type": "subtitle", "time": 14388.95, "timestamp": "03:59:48", "text": "そして私は尋ねた、「あなたには何か動機があるのですか」"}, {"type": "subtitle", "time": 14391.189, "timestamp": "03:59:51", "text": "「これやってるの？」と彼らは沈黙した。"}, {"type": "subtitle", "time": 14396.91, "timestamp": "03:59:56", "text": "それについて。そして彼らは一度もDM（ゲームマスター）を使わなかった。私はこう思う、"}, {"type": "subtitle", "time": 14399.75, "timestamp": "03:59:59", "text": "「バカ、アリス、教えて。私は欲しい、私は欲しい"}]
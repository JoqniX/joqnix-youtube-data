[{"type": "subtitle", "time": 6362.75, "timestamp": "01:46:02", "text": "これ？ログイン状態をご確認ください。"}, {"type": "subtitle", "time": 6385.87, "timestamp": "01:46:25", "text": "えっ？はい、接続できました。はい、私は"}, {"type": "subtitle", "time": 6392.95, "timestamp": "01:46:32", "text": "手。ちょっと待って。書いて送らせてください"}, {"type": "subtitle", "time": 6395.99, "timestamp": "01:46:35", "text": "下。待って、何を書けばいいの？できますか？"}, {"type": "subtitle", "time": 6398.07, "timestamp": "01:46:38", "text": "教えて？誰か何をすべきか教えてくれませんか"}]
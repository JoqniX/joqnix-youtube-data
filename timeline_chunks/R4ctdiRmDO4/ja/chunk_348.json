[{"type": "subtitle", "time": 20881.27, "timestamp": "05:48:01", "text": "うん。うん。そして特に今日は、"}, {"type": "subtitle", "time": 20884.15, "timestamp": "05:48:04", "text": "えーと、私が言い始めてからどれくらい経ったかな"}, {"type": "subtitle", "time": 20887.91, "timestamp": "05:48:07", "text": "ハットコマンドを修正し、"}, {"type": "subtitle", "time": 20891.788, "timestamp": "05:48:11", "text": "ハグ命令とかそういうの？忘れていた"}, {"type": "subtitle", "time": 20895.67, "timestamp": "05:48:15", "text": "それ。ええ、それは望んでいません。物忘れがひどい"}, {"type": "subtitle", "time": 20903.03, "timestamp": "05:48:23", "text": "騎手。うん。うん。ええ、そうですね。えーと"}, {"type": "subtitle", "time": 20904.948, "timestamp": "05:48:24", "text": "明日から、あるいは今日から"}, {"type": "subtitle", "time": 20906.19, "timestamp": "05:48:26", "text": "私が試してみます"}, {"type": "subtitle", "time": 20910.67, "timestamp": "05:48:30", "text": "生産性を高めるために最善を尽くします"}, {"type": "subtitle", "time": 20913.99, "timestamp": "05:48:33", "text": "はい、そして皆さんも"}, {"type": "subtitle", "time": 20917.11, "timestamp": "05:48:37", "text": "思い出させてくれてありがとう。"}, {"type": "subtitle", "time": 20920.788, "timestamp": "05:48:40", "text": "ありがとう。じゃあまたね。"}, {"type": "subtitle", "time": 20923.35, "timestamp": "05:48:43", "text": "明日はストリームのため、または"}, {"type": "subtitle", "time": 20925.75, "timestamp": "05:48:45", "text": "YouTube ストリーム配信中"}, {"type": "subtitle", "time": 20929.07, "timestamp": "05:48:49", "text": "YouTube はおそらく"}, {"type": "subtitle", "time": 20933.07, "timestamp": "05:48:53", "text": "えっと、おそらくゲンチンインパクトでしょう"}, {"type": "subtitle", "time": 20936.39, "timestamp": "05:48:56", "text": "はぁ？配信しすぎないように最大限努力します。"}, {"type": "subtitle", "time": 20938.548, "timestamp": "05:48:58", "text": "うん、働きすぎちゃダメだよ。しかし"}]
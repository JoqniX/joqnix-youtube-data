[{"type": "subtitle", "time": 16562.51, "timestamp": "04:36:02", "text": "それ"}, {"type": "subtitle", "time": 16571.83, "timestamp": "04:36:11", "text": "いや、つまり、私が避けたかったのは"}, {"type": "subtitle", "time": 16574.39, "timestamp": "04:36:14", "text": "そうですよね？ウルトラになるには"}, {"type": "subtitle", "time": 16577.07, "timestamp": "04:36:17", "text": "えーとウルトラ"}, {"type": "subtitle", "time": 16582.23, "timestamp": "04:36:22", "text": "えっと、ウルトラ、えっと、だから、あなたはこう言わなければならない"}, {"type": "subtitle", "time": 16585.189, "timestamp": "04:36:25", "text": "いつも助けてくれる人がいるとは限らない"}, {"type": "subtitle", "time": 16588.15, "timestamp": "04:36:28", "text": "あなたに言うには、ああ、スポーツマン、あなたは"}, {"type": "subtitle", "time": 16591.67, "timestamp": "04:36:31", "text": "それをやらないとか、何か正しくやらないとかだから"}, {"type": "subtitle", "time": 16593.551, "timestamp": "04:36:33", "text": "より良い"}, {"type": "subtitle", "time": 16596.949, "timestamp": "04:36:36", "text": "警告を常に把握するか、"}, {"type": "subtitle", "time": 16600.83, "timestamp": "04:36:40", "text": "予防策、あるいは自分で知っておくべき種類の"}, {"type": "subtitle", "time": 16603.349, "timestamp": "04:36:43", "text": "それで、ねえ、知ってる？あなたがすべきこと"}]
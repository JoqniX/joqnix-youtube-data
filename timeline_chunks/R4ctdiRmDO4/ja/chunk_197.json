[{"type": "subtitle", "time": 11822.229, "timestamp": "03:17:02", "text": "する？今の私にできることは何ですか？ 1つ。"}, {"type": "subtitle", "time": 11824.07, "timestamp": "03:17:04", "text": "開けて、うん、わかるよね？私は"}, {"type": "subtitle", "time": 11829.95, "timestamp": "03:17:09", "text": "キャビネット。そっちの方がずっといい"}, {"type": "subtitle", "time": 11833.71, "timestamp": "03:17:13", "text": "キャビネット。うまくいけば"}, {"type": "subtitle", "time": 11836.51, "timestamp": "03:17:16", "text": "願わくば"}, {"type": "subtitle", "time": 11844.309, "timestamp": "03:17:24", "text": "まあ、でも大丈夫だよ。"}, {"type": "subtitle", "time": 11848.429, "timestamp": "03:17:28", "text": "でも、これもまた私に"}, {"type": "subtitle", "time": 11851.99, "timestamp": "03:17:31", "text": "それは、ほら、私はあまり望んでいない"}, {"type": "subtitle", "time": 11855.269, "timestamp": "03:17:35", "text": "常にゲームをストリーミング配信し、"}, {"type": "subtitle", "time": 11857.59, "timestamp": "03:17:37", "text": "他のものもあるが、それもまたある意味で"}, {"type": "subtitle", "time": 11859.83, "timestamp": "03:17:39", "text": "他のことに集中する方法ですが、"}, {"type": "subtitle", "time": 11864.07, "timestamp": "03:17:44", "text": "また、すべてが"}, {"type": "subtitle", "time": 11867.87, "timestamp": "03:17:47", "text": "他のものには良い"}, {"type": "subtitle", "time": 11872.349, "timestamp": "03:17:52", "text": "GPU、そしてある意味、私は支払っているようなものです"}]
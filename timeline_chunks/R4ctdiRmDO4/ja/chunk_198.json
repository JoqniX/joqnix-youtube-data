[{"type": "subtitle", "time": 11893.03, "timestamp": "03:18:13", "text": "もっと。ああ、なんてこった、めちゃくちゃ暑い。私の"}, {"type": "subtitle", "time": 11908.269, "timestamp": "03:18:28", "text": "待って、気のせいかな、それとも本当に"}, {"type": "subtitle", "time": 11910.269, "timestamp": "03:18:30", "text": "のように"}, {"type": "subtitle", "time": 11913.07, "timestamp": "03:18:33", "text": "二？待って、"}, {"type": "subtitle", "time": 11917.83, "timestamp": "03:18:37", "text": "そうするべきか、よし、これを強制する。何"}]
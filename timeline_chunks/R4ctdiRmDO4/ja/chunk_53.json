[{"type": "subtitle", "time": 3181.67, "timestamp": "00:53:01", "text": "私が移動させます。誰か追加します"}, {"type": "subtitle", "time": 3189.79, "timestamp": "00:53:09", "text": "えっと、即興でやれますよ"}, {"type": "subtitle", "time": 3193.87, "timestamp": "00:53:13", "text": "そしてスズキの1つは"}, {"type": "subtitle", "time": 3197.03, "timestamp": "00:53:17", "text": "11. ええ、まだどうするか決めていません。"}, {"type": "subtitle", "time": 3200.03, "timestamp": "00:53:20", "text": "11日に。ええと、明日の"}, {"type": "subtitle", "time": 3201.95, "timestamp": "00:53:21", "text": "明日"}, {"type": "subtitle", "time": 3205.79, "timestamp": "00:53:25", "text": "そしてホクとフィのものは"}, {"type": "subtitle", "time": 3212.99, "timestamp": "00:53:32", "text": "アルストラ。次に"}, {"type": "subtitle", "time": 3216.349, "timestamp": "00:53:36", "text": "今週はロックダウンのプロトコルがあります"}, {"type": "subtitle", "time": 3220.109, "timestamp": "00:53:40", "text": "ジャシマ・スミ・ナツキと"}, {"type": "subtitle", "time": 3225.15, "timestamp": "00:53:45", "text": "ゼノと、えーと、私の最初のJPコラボでは"}, {"type": "subtitle", "time": 3230.47, "timestamp": "00:53:50", "text": "シェリサと私は遊ぶ予定です"}, {"type": "subtitle", "time": 3233.349, "timestamp": "00:53:53", "text": "リポジトリ。そう、だから君たちに来てほしいんだ"}, {"type": "subtitle", "time": 3235.47, "timestamp": "00:53:55", "text": "特にこれら"}, {"type": "subtitle", "time": 3237.99, "timestamp": "00:53:57", "text": "1つ。大丈夫です。表示されません"}]
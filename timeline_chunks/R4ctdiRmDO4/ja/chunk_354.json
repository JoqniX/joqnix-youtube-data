[{"type": "subtitle", "time": 21245.99, "timestamp": "05:54:05", "text": "知る。しかし、歩いてはいけません。まるで"}, {"type": "subtitle", "time": 21250.7, "timestamp": "05:54:10", "text": "時間。感じませんか？"}, {"type": "subtitle", "time": 21257.83, "timestamp": "05:54:17", "text": "それ？わからない。そしてそれはただ"}, {"type": "subtitle", "time": 21261.19, "timestamp": "05:54:21", "text": "インポスター症候群"}, {"type": "subtitle", "time": 21263.51, "timestamp": "05:54:23", "text": "えっと、私を殴ってる。できない、つまり私はいつも"}, {"type": "subtitle", "time": 21266.548, "timestamp": "05:54:26", "text": "この衝動性症候群があるが、また"}, {"type": "subtitle", "time": 21275.868, "timestamp": "05:54:35", "text": "これはまだ私がやっていないと思っている"}, {"type": "subtitle", "time": 21281.31, "timestamp": "05:54:41", "text": "[音楽]"}, {"type": "subtitle", "time": 21285.27, "timestamp": "05:54:45", "text": "あまりにも。それは異世界アニメのようなものじゃないですか"}, {"type": "subtitle", "time": 21287.948, "timestamp": "05:54:47", "text": "例えばこんな感じ"}, {"type": "subtitle", "time": 21291.83, "timestamp": "05:54:51", "text": "それ？アニメの名前を忘れてしまった。"}, {"type": "subtitle", "time": 21293.708, "timestamp": "05:54:53", "text": "もし私が"}, {"type": "subtitle", "time": 21295.628, "timestamp": "05:54:55", "text": "イサカイ？あなたは信じますか"}]
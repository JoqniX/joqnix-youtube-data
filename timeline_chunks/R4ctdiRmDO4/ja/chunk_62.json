[{"type": "subtitle", "time": 3730.72, "timestamp": "01:02:10", "text": "ああ、忘れてた。なぜ私は飲んでいるのか"}, {"type": "subtitle", "time": 3731.95, "timestamp": "01:02:11", "text": "[音楽]"}, {"type": "subtitle", "time": 3734.71, "timestamp": "01:02:14", "text": "お茶？これで眠ってしまう"}, {"type": "subtitle", "time": 3745.069, "timestamp": "01:02:25", "text": "なぜ？バカ、君は"}, {"type": "subtitle", "time": 3748.23, "timestamp": "01:02:28", "text": "ただ忘れていただけです。お茶を飲むと、私は倒れてしまう"}, {"type": "subtitle", "time": 3750.43, "timestamp": "01:02:30", "text": "数分で眠りにつくか、あるいは数分間眠る"}, {"type": "subtitle", "time": 3765.99, "timestamp": "01:02:45", "text": "私は自分の体を鍛えるべきではなかった"}, {"type": "subtitle", "time": 3770.03, "timestamp": "01:02:50", "text": "私が紅茶を飲むと"}]
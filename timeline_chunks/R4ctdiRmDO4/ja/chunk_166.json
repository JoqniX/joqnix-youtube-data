[{"type": "subtitle", "time": 9960.99, "timestamp": "02:46:00", "text": "[音楽]"}, {"type": "subtitle", "time": 9963.349, "timestamp": "02:46:03", "text": "コラボレーション？営業していますか？わかった。は"}, {"type": "subtitle", "time": 9966.07, "timestamp": "02:46:06", "text": "あなたは利用可能/オープンです"}, {"type": "subtitle", "time": 9968.07, "timestamp": "02:46:08", "text": "コラボレーション？あなたに聞きたいのですが"}, {"type": "subtitle", "time": 9970.23, "timestamp": "02:46:10", "text": "一緒にゲームをして遊ぶのが好きですか"}, {"type": "subtitle", "time": 9974.309, "timestamp": "02:46:14", "text": "私の配信。私はコピーできます"}, {"type": "subtitle", "time": 9979.74, "timestamp": "02:46:19", "text": "同じ形式だと思います。えっと、私は"}, {"type": "subtitle", "time": 10007.11, "timestamp": "02:46:47", "text": "パパ、パパ、パパ、パパ。ハルポム"}, {"type": "subtitle", "time": 10012.15, "timestamp": "02:46:52", "text": "太陽もまた、個々の存在として捉えられる。ポンポンポン"}, {"type": "subtitle", "time": 10015.349, "timestamp": "02:46:55", "text": "犬のやつ。忘れた。ザクロ"}, {"type": "subtitle", "time": 10017.75, "timestamp": "02:46:57", "text": "ポングレネード。それはザクロです。の"}]
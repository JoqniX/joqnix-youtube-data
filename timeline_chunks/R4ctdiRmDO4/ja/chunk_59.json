[{"type": "subtitle", "time": 3541.99, "timestamp": "00:59:01", "text": "問題は今何が"}, {"type": "subtitle", "time": 3543.99, "timestamp": "00:59:03", "text": "コラボレーションはすべて"}, {"type": "subtitle", "time": 3546.549, "timestamp": "00:59:06", "text": "夕方のセッションは、まるで四半期のようなものです"}, {"type": "subtitle", "time": 3548.19, "timestamp": "00:59:08", "text": "2と4分の1"}, {"type": "subtitle", "time": 3551.829, "timestamp": "00:59:11", "text": "第3四半期は午後9時からです。 3時まで"}, {"type": "subtitle", "time": 3555.51, "timestamp": "00:59:15", "text": "午前4時4分は午前3時です。"}, {"type": "subtitle", "time": 3559.109, "timestamp": "00:59:19", "text": "午前9時まで。それで、"}, {"type": "subtitle", "time": 3561.75, "timestamp": "00:59:21", "text": "おそらく。うん。ということで、午前中の四半期は"}, {"type": "subtitle", "time": 3564.309, "timestamp": "00:59:24", "text": "午前9時から午後3時までそれは"}, {"type": "subtitle", "time": 3566.63, "timestamp": "00:59:26", "text": "朝の配信ですよね？でも私は眠って、"}, {"type": "subtitle", "time": 3568.75, "timestamp": "00:59:28", "text": "右？"}, {"type": "subtitle", "time": 3573.589, "timestamp": "00:59:33", "text": "私は最初の四半期を丸ごとスキップします"}, {"type": "subtitle", "time": 3576.789, "timestamp": "00:59:36", "text": "何らかの理由で、私の不足により"}, {"type": "chat", "time": 3578.942, "timestamp": "00:59:38", "author": "@Anti-SpiritArt", "avatar": "https://yt4.ggpht.com/wYaIbwf481rN5bfgaxWnbUoh-faRynKzhqgZXK5WIvlx9DlMJJl0M6boNmqYwDkmuSY99pM-=s64-c-k-c0x00ffffff-no-rj", "message": "so you overslept 😅"}, {"type": "subtitle", "time": 3580.23, "timestamp": "00:59:40", "text": "睡眠スケジュールを立て、きちんと睡眠をとる。でも私は"}, {"type": "subtitle", "time": 3581.99, "timestamp": "00:59:41", "text": "実際にこれを修正する必要がある"}, {"type": "subtitle", "time": 3584.95, "timestamp": "00:59:44", "text": "コラボレーション。私はここにいなければならない"}, {"type": "subtitle", "time": 3589.23, "timestamp": "00:59:49", "text": "エネルギー。"}]
[{"type": "subtitle", "time": 15600.07, "timestamp": "04:20:00", "text": "一つの課題を終えました。わかった。えっと"}, {"type": "subtitle", "time": 15602.07, "timestamp": "04:20:02", "text": "これら2つの課題を終えたら、"}, {"type": "subtitle", "time": 15604.349, "timestamp": "04:20:04", "text": "締めくくりは"}, {"type": "subtitle", "time": 15606.79, "timestamp": "04:20:06", "text": "日。わかった。うん。主に私たちは"}, {"type": "subtitle", "time": 15609.99, "timestamp": "04:20:09", "text": "終わらせろ。これは"}, {"type": "subtitle", "time": 15613.75, "timestamp": "04:20:13", "text": "大変だろうけど、大丈夫だよ。"}, {"type": "subtitle", "time": 15616.229, "timestamp": "04:20:16", "text": "一番良かったのは、"}, {"type": "subtitle", "time": 15619.55, "timestamp": "04:20:19", "text": "夕暮れ時の昇る太陽。 A"}, {"type": "subtitle", "time": 15621.99, "timestamp": "04:20:21", "text": "ショック。会えてよかったです"}, {"type": "subtitle", "time": 15625.67, "timestamp": "04:20:25", "text": "夕暮れが訪れる。何かの場所で昇る朝日。"}]
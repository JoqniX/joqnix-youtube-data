[{"type": "subtitle", "time": 12241.87, "timestamp": "03:24:01", "text": "右。"}, {"type": "subtitle", "time": 12244.71, "timestamp": "03:24:04", "text": "ええ、でももちろん違います。私はしない"}, {"type": "subtitle", "time": 12246.71, "timestamp": "03:24:06", "text": "それ。ええ、それはしません。"}, {"type": "subtitle", "time": 12251.59, "timestamp": "03:24:11", "text": "私は終わった。もうそういうのはうんざりだ。"}, {"type": "subtitle", "time": 12266.19, "timestamp": "03:24:26", "text": "男の子。え、私の配信がクラッシュしたの？いいえ。"}, {"type": "subtitle", "time": 12295.11, "timestamp": "03:24:55", "text": "ええ、何かがポップアップしたのを見ました"}, {"type": "subtitle", "time": 12297.63, "timestamp": "03:24:57", "text": "ストリームが言う"}]
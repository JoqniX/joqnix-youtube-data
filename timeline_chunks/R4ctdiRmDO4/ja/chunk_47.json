[{"type": "subtitle", "time": 2820.91, "timestamp": "00:47:00", "text": "歌。彼女がそうかどうかはよくわかりません"}, {"type": "subtitle", "time": 2823.589, "timestamp": "00:47:03", "text": "無料。そこが問題なんです。私はそうするだろう"}, {"type": "subtitle", "time": 2826.55, "timestamp": "00:47:06", "text": "Robloxで遊ぶのも悪くない"}, {"type": "subtitle", "time": 2842.22, "timestamp": "00:47:22", "text": "私はプレイするべきだ"}, {"type": "subtitle", "time": 2849.51, "timestamp": "00:47:29", "text": "フォールアウト。決めなきゃいけないんだよ、兄弟。私は持っている"}, {"type": "subtitle", "time": 2853.069, "timestamp": "00:47:33", "text": "決定する。決めなければならない。手に入れることができません"}, {"type": "subtitle", "time": 2856.39, "timestamp": "00:47:36", "text": "みんな。全員を集めることはできません。そして"}, {"type": "subtitle", "time": 2859.95, "timestamp": "00:47:39", "text": "それは紛れもない事実です。手に入れることができません"}, {"type": "subtitle", "time": 2862.67, "timestamp": "00:47:42", "text": "みんな。私はしなければならない"}, {"type": "subtitle", "time": 2864.95, "timestamp": "00:47:44", "text": "犠牲。これは終わりではない"}, {"type": "subtitle", "time": 2873.6, "timestamp": "00:47:53", "text": "しかし"}]
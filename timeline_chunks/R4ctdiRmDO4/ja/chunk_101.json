[{"type": "subtitle", "time": 6061.75, "timestamp": "01:41:01", "text": "待って。インドについてどう思いますか？私は"}, {"type": "subtitle", "time": 6063.07, "timestamp": "01:41:03", "text": "インドから。"}, {"type": "subtitle", "time": 6066.709, "timestamp": "01:41:06", "text": "私に何を考えてほしいのですか？"}, {"type": "subtitle", "time": 6084.79, "timestamp": "01:41:24", "text": "君がお酒を飲めることを願うよ。がある"}, {"type": "subtitle", "time": 6086.91, "timestamp": "01:41:26", "text": "きれいな水。"}, {"type": "subtitle", "time": 6090.91, "timestamp": "01:41:30", "text": "わかった。きれいな水がたくさんあります"}, {"type": "subtitle", "time": 6093.91, "timestamp": "01:41:33", "text": "インド。水も汚れていない。"}, {"type": "subtitle", "time": 6110.709, "timestamp": "01:41:50", "text": "ええ、何かを見たかもしれません"}, {"type": "subtitle", "time": 6113.35, "timestamp": "01:41:53", "text": "他に、あなたはこう思ったかもしれません"}, {"type": "subtitle", "time": 6116.79, "timestamp": "01:41:56", "text": "インドの水は不潔で"}, {"type": "subtitle", "time": 6118.95, "timestamp": "01:41:58", "text": "そういうこともあるけど、そうじゃない。がある"}]
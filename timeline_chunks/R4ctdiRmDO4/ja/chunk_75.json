[{"type": "subtitle", "time": 4504.95, "timestamp": "01:15:04", "text": "以前はあらゆる種類のツイートができた"}, {"type": "subtitle", "time": 4507.75, "timestamp": "01:15:07", "text": "昔々、ここには色々なものがランダムにありました。今"}, {"type": "subtitle", "time": 4509.51, "timestamp": "01:15:09", "text": "もうどうすればいいのか分からない。"}, {"type": "subtitle", "time": 4532.07, "timestamp": "01:15:32", "text": "でも、彼はとても忙しいと思う"}, {"type": "subtitle", "time": 4536.189, "timestamp": "01:15:36", "text": "ファンタジーイベント、グローバル"}, {"type": "subtitle", "time": 4539.41, "timestamp": "01:15:39", "text": "イベントに身を捧げている"}, {"type": "subtitle", "time": 4541.79, "timestamp": "01:15:41", "text": "[音楽]"}, {"type": "subtitle", "time": 4543.39, "timestamp": "01:15:43", "text": "に"}]
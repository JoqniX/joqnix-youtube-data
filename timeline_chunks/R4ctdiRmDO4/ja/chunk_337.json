[{"type": "subtitle", "time": 20237.03, "timestamp": "05:37:17", "text": "また戻ってきます。えっと、待って。それは何ですか"}, {"type": "subtitle", "time": 20238.788, "timestamp": "05:37:18", "text": "ストリーム損失ってやつ？ああ、向きを変えなきゃ"}, {"type": "subtitle", "time": 20240.03, "timestamp": "05:37:20", "text": "それ"}, {"type": "subtitle", "time": 20244.35, "timestamp": "05:37:24", "text": "オフ。ジョイはしばらく話すことができなかった"}, {"type": "subtitle", "time": 20246.868, "timestamp": "05:37:26", "text": "少し。ちょっと待って。配信をオフにします"}, {"type": "subtitle", "time": 20248.59, "timestamp": "05:37:28", "text": "負荷。"}, {"type": "subtitle", "time": 20252.59, "timestamp": "05:37:32", "text": "わかった。何？というわけで、私たちはその試合に勝ちました。"}, {"type": "subtitle", "time": 20255.67, "timestamp": "05:37:35", "text": "わーい。いいぞ、いいぞ、いいぞ。また、"}, {"type": "subtitle", "time": 20258.35, "timestamp": "05:37:38", "text": "ストリームを終了する"}, {"type": "subtitle", "time": 20260.708, "timestamp": "05:37:40", "text": "今。えっと、ストリーミングはできないと思う"}, {"type": "subtitle", "time": 20263.948, "timestamp": "05:37:43", "text": "今夜はもう"}, {"type": "subtitle", "time": 20266.708, "timestamp": "05:37:46", "text": "残念ながら。うん。うん。うん。うん。では、"}, {"type": "subtitle", "time": 20269.27, "timestamp": "05:37:49", "text": "こっちで仕上げるから、見てみます"}, {"type": "subtitle", "time": 20271.35, "timestamp": "05:37:51", "text": "次の動画で君たちを見てね。わかった。試してみてください"}, {"type": "subtitle", "time": 20273.23, "timestamp": "05:37:53", "text": "ストリーム"}, {"type": "subtitle", "time": 20276.03, "timestamp": "05:37:56", "text": "明日。ストリーミングを試してみます"}, {"type": "subtitle", "time": 20278.11, "timestamp": "05:37:58", "text": "明日"}]
[{"type": "subtitle", "time": 16081.229, "timestamp": "04:28:01", "text": "[音楽]"}, {"type": "subtitle", "time": 16084.11, "timestamp": "04:28:04", "text": "うん。トム"}, {"type": "subtitle", "time": 16095.07, "timestamp": "04:28:15", "text": "はい。そうそう。 Roは"}, {"type": "subtitle", "time": 16097.99, "timestamp": "04:28:17", "text": "ニース。うん。わからない。でも私は"}, {"type": "subtitle", "time": 16100.149, "timestamp": "04:28:20", "text": "負荷がかからないようにしてください"}, {"type": "subtitle", "time": 16104.07, "timestamp": "04:28:24", "text": "何でも。サスサス。それは一つの点だ。"}, {"type": "subtitle", "time": 16106.149, "timestamp": "04:28:26", "text": "私はそれを確認しなければならないし、また私は"}, {"type": "subtitle", "time": 16109.51, "timestamp": "04:28:29", "text": "私が言うことは何でも私の"}, {"type": "subtitle", "time": 16112.309, "timestamp": "04:28:32", "text": "周囲の状況は誤解されないだろう"}, {"type": "subtitle", "time": 16115.51, "timestamp": "04:28:35", "text": "つまり、もし私の家族や誰かが"}, {"type": "subtitle", "time": 16117.99, "timestamp": "04:28:37", "text": "家の中でこれを聞いている私が"}, {"type": "subtitle", "time": 16120.63, "timestamp": "04:28:40", "text": "言うと、彼らは「えっ、何？」って言うだろう"}, {"type": "subtitle", "time": 16124.71, "timestamp": "04:28:44", "text": "これは何だこのバカが何をしているんだ何なんだ"}, {"type": "subtitle", "time": 16126.71, "timestamp": "04:28:46", "text": "彼らはこうも言って、"}, {"type": "subtitle", "time": 16128.429, "timestamp": "04:28:48", "text": "ああ"}, {"type": "subtitle", "time": 16131.309, "timestamp": "04:28:51", "text": "いや、ほら、"}, {"type": "subtitle", "time": 16138.75, "timestamp": "04:28:58", "text": "いいね。"}]
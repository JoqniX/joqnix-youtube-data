[{"type": "subtitle", "time": 17040.07, "timestamp": "04:44:00", "text": "私も、どのようにプレイしているのか疑問に思っています"}, {"type": "subtitle", "time": 17052.51, "timestamp": "04:44:12", "text": "[音楽]"}, {"type": "subtitle", "time": 17057.43, "timestamp": "04:44:17", "text": "遅れ？いいえ。それで、私はゲームを買いました。"}, {"type": "subtitle", "time": 17059.75, "timestamp": "04:44:19", "text": "これはどちらかというとリクエストされたものか、"}, {"type": "subtitle", "time": 17064.11, "timestamp": "04:44:24", "text": "レースゲームみたいなジャンルかな、"}, {"type": "subtitle", "time": 17067.31, "timestamp": "04:44:27", "text": "右？誰が要求したか忘れた。うん、切り替える"}, {"type": "subtitle", "time": 17070.788, "timestamp": "04:44:30", "text": "ロイヤルレース系のジャンルとその他諸々をリクエストしました。"}, {"type": "subtitle", "time": 17074.03, "timestamp": "04:44:34", "text": "だから、私はただ"}, {"type": "subtitle", "time": 17077.628, "timestamp": "04:44:37", "text": "バトルロイヤルから生中継"}, {"type": "subtitle", "time": 17083.55, "timestamp": "04:44:43", "text": "携帯。"}, {"type": "subtitle", "time": 17086.51, "timestamp": "04:44:46", "text": "H 私はそうは思いません"}, {"type": "subtitle", "time": 17089.91, "timestamp": "04:44:49", "text": "知る。うん。うん。うん。それで、私は買いました"}, {"type": "subtitle", "time": 17092.39, "timestamp": "04:44:52", "text": "速度は無限大。"}, {"type": "subtitle", "time": 17095.35, "timestamp": "04:44:55", "text": "では、Apexが"}, {"type": "subtitle", "time": 17099.11, "timestamp": "04:44:59", "text": "私のGPUがこんなにラグいのは"}]
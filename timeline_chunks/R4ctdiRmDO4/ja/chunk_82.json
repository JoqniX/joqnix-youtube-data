[{"type": "subtitle", "time": 4920.47, "timestamp": "01:22:00", "text": "えっと、あなたとは別々にできると思います"}, {"type": "subtitle", "time": 4924.55, "timestamp": "01:22:04", "text": "私は今の方が良くなったと思う、なぜなら"}, {"type": "subtitle", "time": 4925.79, "timestamp": "01:22:05", "text": "より良い"}, {"type": "subtitle", "time": 4930.55, "timestamp": "01:22:10", "text": "コラボホストとして、"}, {"type": "subtitle", "time": 4932.95, "timestamp": "01:22:12", "text": "コラボレーションを確実にする必要がある"}, {"type": "subtitle", "time": 4936.95, "timestamp": "01:22:16", "text": "参加者は実際に参加し、"}, {"type": "subtitle", "time": 4939.83, "timestamp": "01:22:19", "text": "今は楽しんでいるけど、もし"}, {"type": "subtitle", "time": 4942.79, "timestamp": "01:22:22", "text": "ソロ個人の方が私にとっては良い"}, {"type": "subtitle", "time": 4943.709, "timestamp": "01:22:23", "text": "に"}, {"type": "subtitle", "time": 4946.149, "timestamp": "01:22:26", "text": "楽しい時間を過ごせるようにしよう"}, {"type": "subtitle", "time": 4949.03, "timestamp": "01:22:29", "text": "一緒に、そしてグループで"}, {"type": "subtitle", "time": 4953.11, "timestamp": "01:22:33", "text": "コラボ企画をグループでやってるんだ"}, {"type": "subtitle", "time": 4956.91, "timestamp": "01:22:36", "text": "コラボ企画。先週それをやります"}, {"type": "subtitle", "time": 4961.75, "timestamp": "01:22:41", "text": "5月。ええ、数試合です。の間で"}, {"type": "subtitle", "time": 4962.83, "timestamp": "01:22:42", "text": "私たちまたは"}, {"type": "subtitle", "time": 4970.83, "timestamp": "01:22:50", "text": "何か。"}, {"type": "subtitle", "time": 4974.79, "timestamp": "01:22:54", "text": "いいえ、私の唯一の敵は私のエネルギーです"}]
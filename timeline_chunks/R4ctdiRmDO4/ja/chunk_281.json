[{"type": "subtitle", "time": 16860.948, "timestamp": "04:41:00", "text": "こうなるんですよね？もし私がそうでないなら"}, {"type": "subtitle", "time": 16863.83, "timestamp": "04:41:03", "text": "誓いを全くしない人"}, {"type": "subtitle", "time": 16866.788, "timestamp": "04:41:06", "text": "私のストリームで配信してから、"}, {"type": "subtitle", "time": 16869.35, "timestamp": "04:41:09", "text": "他のえーと、他の人の配信みたいな"}, {"type": "subtitle", "time": 16872.15, "timestamp": "04:41:12", "text": "あるいは、私の"}, {"type": "subtitle", "time": 16874.55, "timestamp": "04:41:14", "text": "もちろん、ストリーム配信もします。"}, {"type": "subtitle", "time": 16878.23, "timestamp": "04:41:18", "text": "誓いを立てたり、"}, {"type": "subtitle", "time": 16881.19, "timestamp": "04:41:21", "text": "何か、あるいは激しい罵り言葉のようなもの"}, {"type": "subtitle", "time": 16883.67, "timestamp": "04:41:23", "text": "広範囲にわたる罵り言葉は、あまりにも好きすぎる"}, {"type": "subtitle", "time": 16886.868, "timestamp": "04:41:26", "text": "悪口を言うやつだよね？でもここでは私は"}, {"type": "subtitle", "time": 16888.628, "timestamp": "04:41:28", "text": "私はその人に"}, {"type": "subtitle", "time": 16889.948, "timestamp": "04:41:29", "text": "なれ"}, {"type": "subtitle", "time": 16893.31, "timestamp": "04:41:33", "text": "彼ら自身の最も幸せな状態にあるように"}, {"type": "subtitle", "time": 16896.75, "timestamp": "04:41:36", "text": "快適な状態"}, {"type": "subtitle", "time": 16902.868, "timestamp": "04:41:42", "text": "親切。うん。うん。でも、ある意味では"}, {"type": "subtitle", "time": 16904.628, "timestamp": "04:41:44", "text": "ああ、彼らは何を言ってはいけないかも知っているだろう"}, {"type": "subtitle", "time": 16907.83, "timestamp": "04:41:47", "text": "そして、やってはいけないこと、ご存知のように"}, {"type": "subtitle", "time": 16910.31, "timestamp": "04:41:50", "text": "YouTubeなどに関して"}, {"type": "subtitle", "time": 16913.59, "timestamp": "04:41:53", "text": "例えば、言ってはいけない特定の言葉など"}, {"type": "subtitle", "time": 16917.03, "timestamp": "04:41:57", "text": "それはそれで良いのですが、"}, {"type": "subtitle", "time": 16919.51, "timestamp": "04:41:59", "text": "彼らは快適な場所にいるように感じるだろう"}]
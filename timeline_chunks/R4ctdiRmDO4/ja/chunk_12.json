[{"type": "subtitle", "time": 723.43, "timestamp": "00:12:03", "text": "また。おいおい、一体どういうことだ？あなたには"}, {"type": "subtitle", "time": 726.87, "timestamp": "00:12:06", "text": "フォロワー5,000人でOBSを使って配信する"}, {"type": "subtitle", "time": 734.389, "timestamp": "00:12:14", "text": "はぁ？この間ずっと毎日ストリーミング配信"}, {"type": "subtitle", "time": 737.31, "timestamp": "00:12:17", "text": "フォロワー100人に到達することは"}, {"type": "subtitle", "time": 740.67, "timestamp": "00:12:20", "text": "何もない。私は最善を尽くして"}, {"type": "subtitle", "time": 749.509, "timestamp": "00:12:29", "text": "一体何がおかしいんだ？"}, {"type": "subtitle", "time": 753.67, "timestamp": "00:12:33", "text": "プラットフォームだよ、兄弟？おい、マジでマジで"}, {"type": "subtitle", "time": 755.15, "timestamp": "00:12:35", "text": "何"}, {"type": "subtitle", "time": 763.829, "timestamp": "00:12:43", "text": "えっ？大したことない。私は最善を尽くそうとしました"}, {"type": "subtitle", "time": 765.31, "timestamp": "00:12:45", "text": "ビリー・ビリーと"}, {"type": "subtitle", "time": 766.99, "timestamp": "00:12:46", "text": "彼らは"}, {"type": "subtitle", "time": 770.31, "timestamp": "00:12:50", "text": "ああ、要求条件が上がったんだよ、兄弟。"}, {"type": "subtitle", "time": 771.17, "timestamp": "00:12:51", "text": "何"}, {"type": "subtitle", "time": 773.71, "timestamp": "00:12:53", "text": "[音楽]"}, {"type": "subtitle", "time": 776.03, "timestamp": "00:12:56", "text": "くそっ"}, {"type": "subtitle", "time": 778.79, "timestamp": "00:12:58", "text": "えっ？拝啓、"}]
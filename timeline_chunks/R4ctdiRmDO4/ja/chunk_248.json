[{"type": "subtitle", "time": 14880.229, "timestamp": "04:08:00", "text": "戦闘。ずっと昔、"}, {"type": "subtitle", "time": 14882.07, "timestamp": "04:08:02", "text": "戦士たちは1秒。 1秒。 1つ"}, {"type": "subtitle", "time": 14885.03, "timestamp": "04:08:05", "text": "秒1秒。 1秒。兄弟、ヒゲは"}, {"type": "subtitle", "time": 14888.469, "timestamp": "04:08:08", "text": "科学的研究。彼らはハゲを模倣した。"}, {"type": "subtitle", "time": 14889.59, "timestamp": "04:08:09", "text": "何てことだ。"}, {"type": "subtitle", "time": 14891.189, "timestamp": "04:08:11", "text": "少し無精髭が生えた顔と"}, {"type": "subtitle", "time": 14893.67, "timestamp": "04:08:13", "text": "立派なあごひげを生やした顔。そして"}, {"type": "subtitle", "time": 14895.67, "timestamp": "04:08:15", "text": "同じ圧力をかけてテストした"}, {"type": "subtitle", "time": 14897.269, "timestamp": "04:08:17", "text": "パンチが与えることができる量。彼らは見つけた"}, {"type": "subtitle", "time": 14899.51, "timestamp": "04:08:19", "text": "ハゲ顔の人は、"}, {"type": "subtitle", "time": 14901.429, "timestamp": "04:08:21", "text": "彼らがパンチをシミュレーションしたとき、"}, {"type": "subtitle", "time": 14903.67, "timestamp": "04:08:23", "text": "顎を折る。無精髭を生やした状態で使用する場合"}, {"type": "subtitle", "time": 14905.91, "timestamp": "04:08:25", "text": "ひげを生やした顔、壊れたのは"}, {"type": "subtitle", "time": 14908.79, "timestamp": "04:08:28", "text": "45％の確率で。つまり、理論上は、"}, {"type": "subtitle", "time": 14910.79, "timestamp": "04:08:30", "text": "ひげを生やすことができるなら、おそらく"}, {"type": "subtitle", "time": 14912.55, "timestamp": "04:08:32", "text": "祖先。彼らが言いたかったのはこういうことだった。いいえ、"}, {"type": "subtitle", "time": 14914.389, "timestamp": "04:08:34", "text": "私のミスです。私のミスです。女性は"}, {"type": "subtitle", "time": 14916.309, "timestamp": "04:08:36", "text": "歴史的に見て、通常は戦うことになる"}, {"type": "subtitle", "time": 14917.99, "timestamp": "04:08:37", "text": "戦闘に参加した男たち。もしあなたが"}, {"type": "subtitle", "time": 14919.59, "timestamp": "04:08:39", "text": "顔の毛を生やさないで、それはバレるかもしれないから"}, {"type": "subtitle", "time": 14922.63, "timestamp": "04:08:42", "text": "あなたの祖先について少し教えてください。"}, {"type": "subtitle", "time": 14925.51, "timestamp": "04:08:45", "text": "なるほど、そういう意味だったんですね。私が何を見ているか見てください"}, {"type": "subtitle", "time": 14928.309, "timestamp": "04:08:48", "text": "言ったことは何か違っていた。ごめんなさい。"}, {"type": "subtitle", "time": 14931.03, "timestamp": "04:08:51", "text": "先祖のことを忘れていました。ああ、"}]
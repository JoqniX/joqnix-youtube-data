[{"type": "subtitle", "time": 18120.99, "timestamp": "05:02:00", "text": "あなたのために。ああ、"}, {"type": "subtitle", "time": 18123.31, "timestamp": "05:02:03", "text": "神。何が"}, {"type": "subtitle", "time": 18134.19, "timestamp": "05:02:14", "text": "来て。これは冗談ですか？午前"}, {"type": "subtitle", "time": 18145.59, "timestamp": "05:02:25", "text": "神。誰かを不快にさせないでください"}, {"type": "subtitle", "time": 18157.75, "timestamp": "05:02:37", "text": "ボンク。ええと、私はそのゲームをプレイできません。"}, {"type": "subtitle", "time": 18173.19, "timestamp": "05:02:53", "text": "ジョー、私にはわからないわ。つまり、これは車です"}, {"type": "subtitle", "time": 18175.59, "timestamp": "05:02:55", "text": "私をからかってるんだと思う、だって私は"}, {"type": "subtitle", "time": 18178.51, "timestamp": "05:02:58", "text": "そんなに与えるのは"}]
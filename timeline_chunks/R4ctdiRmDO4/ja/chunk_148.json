[{"type": "subtitle", "time": 8880.75, "timestamp": "02:28:00", "text": "気にかけている"}, {"type": "subtitle", "time": 8885.03, "timestamp": "02:28:05", "text": "デビューモデルに必要な資金。それ"}, {"type": "subtitle", "time": 8887.99, "timestamp": "02:28:07", "text": "遠すぎるように思えるし、私はただ"}, {"type": "subtitle", "time": 8890.55, "timestamp": "02:28:10", "text": "楽しい時間を過ごしましょう。"}, {"type": "subtitle", "time": 8892.389, "timestamp": "02:28:12", "text": "だから、日本から一生懸命働くよ"}, {"type": "subtitle", "time": 8896.59, "timestamp": "02:28:16", "text": "少なくとも新しいモデルを手に入れることができる"}, {"type": "subtitle", "time": 8900.59, "timestamp": "02:28:20", "text": "あれ。うん、でも大丈夫だよ。全て"}, {"type": "subtitle", "time": 8902.95, "timestamp": "02:28:22", "text": "良い。お金のためにやりたいわけじゃない。私"}, {"type": "subtitle", "time": 8921.27, "timestamp": "02:28:41", "text": "時間。うん。"}, {"type": "subtitle", "time": 8923.71, "timestamp": "02:28:43", "text": "あなたとコラボレーションできたらいいのに。あなた"}, {"type": "subtitle", "time": 8927.99, "timestamp": "02:28:47", "text": "できる。後で何か計画を立てましょう。病気"}, {"type": "subtitle", "time": 8932.03, "timestamp": "02:28:52", "text": "いつでもここにいる、つまりいつでも遊べる"}, {"type": "subtitle", "time": 8934.75, "timestamp": "02:28:54", "text": "私が一緒にいるときはいつでも"}]
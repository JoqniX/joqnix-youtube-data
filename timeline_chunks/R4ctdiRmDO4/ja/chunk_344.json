[{"type": "subtitle", "time": 20641.59, "timestamp": "05:44:01", "text": "ストリーム外なので、"}, {"type": "subtitle", "time": 20644.23, "timestamp": "05:44:04", "text": "それ以上でもそれ以下でもないが、Apexは私は"}, {"type": "subtitle", "time": 20646.548, "timestamp": "05:44:06", "text": "それについて知っていますが、最善を尽くします"}, {"type": "subtitle", "time": 20649.708, "timestamp": "05:44:09", "text": "このイベント関連の作業を終わらせる"}, {"type": "subtitle", "time": 20651.91, "timestamp": "05:44:11", "text": "フレームは同じですが"}, {"type": "subtitle", "time": 20653.99, "timestamp": "05:44:13", "text": "ラグいけどベストを尽くします"}, {"type": "subtitle", "time": 20658.07, "timestamp": "05:44:18", "text": "少なくとも、特にTwitchについては知っておくべきでしょう"}, {"type": "subtitle", "time": 20662.23, "timestamp": "05:44:22", "text": "今はそれに集中するつもりです"}, {"type": "subtitle", "time": 20666.788, "timestamp": "05:44:26", "text": "えーと、1つは2つや"}, {"type": "subtitle", "time": 20668.91, "timestamp": "05:44:28", "text": "3つのビデオ録画"}, {"type": "subtitle", "time": 20671.59, "timestamp": "05:44:31", "text": "今週はおそらく"}, {"type": "subtitle", "time": 20673.75, "timestamp": "05:44:33", "text": "邪魔が入るだろう"}, {"type": "subtitle", "time": 20678.15, "timestamp": "05:44:38", "text": "おそらく中断されないでしょう"}, {"type": "subtitle", "time": 20681.99, "timestamp": "05:44:41", "text": "説得されて、説得されたわけではない"}, {"type": "subtitle", "time": 20684.83, "timestamp": "05:44:44", "text": "他のことをするために連れ去られ"}, {"type": "subtitle", "time": 20688.868, "timestamp": "05:44:48", "text": "まあ、私はある特定のことを維持するのを手伝ったから"}, {"type": "subtitle", "time": 20692.548, "timestamp": "05:44:52", "text": "家族の中でバカであって家族ではないが"}, {"type": "subtitle", "time": 20695.19, "timestamp": "05:44:55", "text": "実際にはカスタムのようなもの"}, {"type": "subtitle", "time": 20697.868, "timestamp": "05:44:57", "text": "編集のような目的で。だから私はそれをしなければならない"}]
[{"type": "subtitle", "time": 6723.91, "timestamp": "01:52:03", "text": "ええと、明日。いや、いや、いや、いや。頂点"}, {"type": "subtitle", "time": 6727.87, "timestamp": "01:52:07", "text": "コラボレーションはまだ計画されていません"}, {"type": "subtitle", "time": 6731.109, "timestamp": "01:52:11", "text": "えーと、イスマン。まだ計画されていません。私は持っている"}, {"type": "subtitle", "time": 6735.83, "timestamp": "01:52:15", "text": "対応するために手配しますが、朝に"}, {"type": "subtitle", "time": 6738.07, "timestamp": "01:52:18", "text": "話し合って日時を確認する"}, {"type": "subtitle", "time": 6744.149, "timestamp": "01:52:24", "text": "JSTina。彼女は日本にいる。彼女は住んでいる"}, {"type": "subtitle", "time": 6747.43, "timestamp": "01:52:27", "text": "今の日本。彼女は日本へ移住した。だから私は"}, {"type": "subtitle", "time": 6766.31, "timestamp": "01:52:46", "text": "彼女は私と絵本で遊びたかったのですが、私は"}, {"type": "subtitle", "time": 6770.83, "timestamp": "01:52:50", "text": "最後に音楽を聴いたのは3月だった。"}, {"type": "subtitle", "time": 6773.91, "timestamp": "01:52:53", "text": "だから、その頃は音楽や日本語の授業はなかった。"}]
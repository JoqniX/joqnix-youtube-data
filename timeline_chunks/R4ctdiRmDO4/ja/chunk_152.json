[{"type": "subtitle", "time": 9121.27, "timestamp": "02:32:01", "text": "たくさんの方にフォローしていただいています。それは"}, {"type": "subtitle", "time": 9135.51, "timestamp": "02:32:15", "text": "旅。しかし、希望を失ってはいけません。"}, {"type": "subtitle", "time": 9138.07, "timestamp": "02:32:18", "text": "楽しむためにそうするんだ"}, {"type": "subtitle", "time": 9141.429, "timestamp": "02:32:21", "text": "楽しんでやりたいですよね？あなたは"}, {"type": "subtitle", "time": 9143.19, "timestamp": "02:32:23", "text": "お金とかそういう目的でやってるわけじゃない、"}, {"type": "subtitle", "time": 9144.95, "timestamp": "02:32:24", "text": "右？あなたは情熱を持ってそれをしている"}, {"type": "subtitle", "time": 9146.19, "timestamp": "02:32:26", "text": "もの、"}, {"type": "subtitle", "time": 9150.11, "timestamp": "02:32:30", "text": "右？そうだといい。うん、"}, {"type": "subtitle", "time": 9153.23, "timestamp": "02:32:33", "text": "だから、その情熱的な趣味を"}, {"type": "subtitle", "time": 9154.75, "timestamp": "02:32:34", "text": "の中へ"}, {"type": "subtitle", "time": 9157.23, "timestamp": "02:32:37", "text": "埃。そのまま続けてください。"}, {"type": "subtitle", "time": 9160.59, "timestamp": "02:32:40", "text": "いつかそれは可能になるだろう"}, {"type": "subtitle", "time": 9165.75, "timestamp": "02:32:45", "text": "人々に届ければ、彼らはあなたを応援してくれるでしょう"}, {"type": "subtitle", "time": 9168.95, "timestamp": "02:32:48", "text": "仕事。あなたが投稿したものは何でもゆっくりゆっくり"}, {"type": "subtitle", "time": 9171.03, "timestamp": "02:32:51", "text": "待っている人が増えるでしょう"}, {"type": "subtitle", "time": 9173.91, "timestamp": "02:32:53", "text": "コンテンツを投稿して、それと交流する"}]
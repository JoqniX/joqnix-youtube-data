[{"type": "subtitle", "time": 12180.19, "timestamp": "03:23:00", "text": "中にあるもの"}, {"type": "subtitle", "time": 12182.87, "timestamp": "03:23:02", "text": "BR。ああ、私はこれをプレイすべきではない"}, {"type": "subtitle", "time": 12185.51, "timestamp": "03:23:05", "text": "それから。何てことだ。ブラジルでなければなりません。おお"}, {"type": "subtitle", "time": 12192.15, "timestamp": "03:23:12", "text": "神。やってみて、ジョイ。騎手。あなたは何を"}, {"type": "subtitle", "time": 12194.79, "timestamp": "03:23:14", "text": "平均？つまり、私は費やさなければならないということですか？"}, {"type": "subtitle", "time": 12200.469, "timestamp": "03:23:20", "text": "ルピー？私は2,000ルピーを使わなければならない"}, {"type": "subtitle", "time": 12203.99, "timestamp": "03:23:23", "text": "けれど。既にレンダリングを試みています。"}, {"type": "subtitle", "time": 12206.63, "timestamp": "03:23:26", "text": "私はしようとしています。私はしません。うん。だから、忘れてしまった"}, {"type": "subtitle", "time": 12208.349, "timestamp": "03:23:28", "text": "これについて言及しておきます。"}, {"type": "subtitle", "time": 12212.11, "timestamp": "03:23:32", "text": "だから、聞いて"}, {"type": "subtitle", "time": 12217.87, "timestamp": "03:23:37", "text": "待って。ああ、もしお金があったら"}, {"type": "subtitle", "time": 12220.79, "timestamp": "03:23:40", "text": "私もそうしたかったのですが、どうやら"}, {"type": "subtitle", "time": 12222.79, "timestamp": "03:23:42", "text": "ない。"}, {"type": "subtitle", "time": 12225.03, "timestamp": "03:23:45", "text": "私は自分の状況について考えませんし、"}, {"type": "subtitle", "time": 12228.95, "timestamp": "03:23:48", "text": "深入りすべきではない。なぜこう書いてあるの？"}, {"type": "subtitle", "time": 12231.309, "timestamp": "03:23:51", "text": "接続が切断されましたか？私は"}, {"type": "subtitle", "time": 12233.389, "timestamp": "03:23:53", "text": "接続が切れますか？待って、"}, {"type": "subtitle", "time": 12236.389, "timestamp": "03:23:56", "text": "何？あれ、配信が切断された？"}]
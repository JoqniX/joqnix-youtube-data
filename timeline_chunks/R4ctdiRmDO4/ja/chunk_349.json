[{"type": "subtitle", "time": 20941.75, "timestamp": "05:49:01", "text": "それでも、私には仕事が必要なんです。でも、"}, {"type": "subtitle", "time": 20945.628, "timestamp": "05:49:05", "text": "24時間365日ストリーミング配信は"}, {"type": "subtitle", "time": 20949.23, "timestamp": "05:49:09", "text": "十分。まだやらなければならないことがある、"}, {"type": "subtitle", "time": 20952.83, "timestamp": "05:49:12", "text": "右？私は、ああ神様、みんなが"}, {"type": "subtitle", "time": 20956.708, "timestamp": "05:49:16", "text": "まるで時間があったかのように。の"}, {"type": "subtitle", "time": 20958.868, "timestamp": "05:49:18", "text": "時間はカチカチと刻々と過ぎていく。私はこう思う、"}, {"type": "subtitle", "time": 20961.67, "timestamp": "05:49:21", "text": "ええと、でも、この2つの流れのように"}, {"type": "subtitle", "time": 20963.35, "timestamp": "05:49:23", "text": "YouTube ストリームは必ずしも"}, {"type": "subtitle", "time": 20966.23, "timestamp": "05:49:26", "text": "しかし、毎日だ。理由がわからない。えっと、"}, {"type": "subtitle", "time": 20970.11, "timestamp": "05:49:30", "text": "私はそれを一度に全部やってしまうようなもの"}, {"type": "subtitle", "time": 20973.59, "timestamp": "05:49:33", "text": "一日、まるで一日の中に二つの流れがあるかのようだ。"}, {"type": "subtitle", "time": 20976.15, "timestamp": "05:49:36", "text": "もちろん、ビリー・ビリーが"}, {"type": "subtitle", "time": 20979.51, "timestamp": "05:49:39", "text": "ビリー、そうだったんだけど、もし私たちが"}, {"type": "subtitle", "time": 20981.75, "timestamp": "05:49:41", "text": "ビリー・ビリー（右）のストリーミングが可能"}, {"type": "subtitle", "time": 20983.51, "timestamp": "05:49:43", "text": "もちろん、私は「うん、わかるよ」って言うよ。"}, {"type": "subtitle", "time": 20985.83, "timestamp": "05:49:45", "text": "何？ 1日に3つの流れ、それは"}, {"type": "subtitle", "time": 20988.948, "timestamp": "05:49:48", "text": "良い。そんな感じですね。"}, {"type": "subtitle", "time": 20991.11, "timestamp": "05:49:51", "text": "おそらく私は自分が"}, {"type": "subtitle", "time": 20995.19, "timestamp": "05:49:55", "text": "信者のために投稿する"}, {"type": "subtitle", "time": 20999.99, "timestamp": "05:49:59", "text": "午前5時か4時頃になると思います。"}]
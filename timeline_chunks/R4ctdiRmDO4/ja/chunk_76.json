[{"type": "subtitle", "time": 4566.83, "timestamp": "01:16:06", "text": "私の友達全員を調べるのは良いことです"}, {"type": "subtitle", "time": 4576.149, "timestamp": "01:16:16", "text": "と。みんなそれぞれ自分の道を歩んだ"}, {"type": "subtitle", "time": 4578.91, "timestamp": "01:16:18", "text": "彼ら自身のことに集中していると思われる"}, {"type": "subtitle", "time": 4582.149, "timestamp": "01:16:22", "text": "もの。減速する。ある時点で、それは"}, {"type": "subtitle", "time": 4584.95, "timestamp": "01:16:24", "text": "追いつくのが難しくなり、"}, {"type": "subtitle", "time": 4606.79, "timestamp": "01:16:46", "text": "えっと、私は、ああ、私は"}, {"type": "subtitle", "time": 4608.95, "timestamp": "01:16:48", "text": "この時点で崩壊する。たくさんあります"}]
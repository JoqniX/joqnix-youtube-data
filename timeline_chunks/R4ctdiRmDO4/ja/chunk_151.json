[{"type": "subtitle", "time": 9061.83, "timestamp": "02:31:01", "text": "そう、自分がどんなポーズを取りたいかを見つけるような感じ。"}, {"type": "subtitle", "time": 9064.429, "timestamp": "02:31:04", "text": "何か"}, {"type": "subtitle", "time": 9068.83, "timestamp": "02:31:08", "text": "難しいが、続けるべきではない"}, {"type": "subtitle", "time": 9073.11, "timestamp": "02:31:13", "text": "埃が積もったまま放置することについてですよね？あなた"}, {"type": "subtitle", "time": 9075.23, "timestamp": "02:31:15", "text": "最終的にはそうすべきだ"}, {"type": "subtitle", "time": 9077.99, "timestamp": "02:31:17", "text": "自分のニッチを見つけるまで何かを始めよう、"}, {"type": "subtitle", "time": 9080.15, "timestamp": "02:31:20", "text": "あなたが好きなこと、あなたが"}, {"type": "subtitle", "time": 9082.389, "timestamp": "02:31:22", "text": "あなたが心地よく感じるもの、あなたが投稿するのが好きなもの"}, {"type": "subtitle", "time": 9085.19, "timestamp": "02:31:25", "text": "などなど。時間がかかる。それは"}, {"type": "subtitle", "time": 9117.99, "timestamp": "02:31:57", "text": "時々投稿はするけど、"}]
[{"type": "subtitle", "time": 15070.07, "timestamp": "04:11:10", "text": "一瞬。ああ、あなたはそれを聞いたのですね。何てことだ。"}, {"type": "subtitle", "time": 15072.91, "timestamp": "04:11:12", "text": "Discordの仮想環境をラップしたことを忘れていました"}, {"type": "subtitle", "time": 15076.15, "timestamp": "04:11:16", "text": "ケーブルテレビかWhatsApp。ああ、ごめんなさい。私のミスです。"}, {"type": "subtitle", "time": 15078.99, "timestamp": "04:11:18", "text": "ええ、気にしないでください。それはただ"}, {"type": "subtitle", "time": 15084.03, "timestamp": "04:11:24", "text": "誰か。共感します。次のように言うことができます"}, {"type": "subtitle", "time": 15087.51, "timestamp": "04:11:27", "text": "ああ、今はそんな気分です。気にしないで"}, {"type": "subtitle", "time": 15090.75, "timestamp": "04:11:30", "text": "それ。気にしないでください。あなたが"}, {"type": "subtitle", "time": 15093.83, "timestamp": "04:11:33", "text": "聞いた。私のミスです。私は気づいていませんでした"}, {"type": "subtitle", "time": 15096.229, "timestamp": "04:11:36", "text": "それ。何てことだ。それを直さなければならない。ああ、"}, {"type": "subtitle", "time": 15103.269, "timestamp": "04:11:43", "text": "君たちのほとんどは理解していなかった"}, {"type": "subtitle", "time": 15104.349, "timestamp": "04:11:44", "text": "ドライ"}, {"type": "subtitle", "time": 15112.229, "timestamp": "04:11:52", "text": "注意深い。音声ルーティング。あのね？"}, {"type": "subtitle", "time": 15114.389, "timestamp": "04:11:54", "text": "私は実際に具体的に作ります"}, {"type": "subtitle", "time": 15117.11, "timestamp": "04:11:57", "text": "WhatsApp用の短いケーブル（念のため）"}, {"type": "subtitle", "time": 15119.95, "timestamp": "04:11:59", "text": "だって、私にはそれがわかるから"}]
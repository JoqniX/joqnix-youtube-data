[{"type": "subtitle", "time": 1021.67, "timestamp": "00:17:01", "text": "クロノ。彼らがそうなるかどうかはわかりません"}, {"type": "subtitle", "time": 1023.309, "timestamp": "00:17:03", "text": "喜んで"}, {"type": "subtitle", "time": 1025.63, "timestamp": "00:17:05", "text": "彼らがそうなるかどうかはわかりません"}, {"type": "subtitle", "time": 1029.27, "timestamp": "00:17:09", "text": "興味がある。私は怖いです、それは私の"}, {"type": "subtitle", "time": 1032.35, "timestamp": "00:17:12", "text": "最初の紹介。最初ではなく、"}, {"type": "subtitle", "time": 1047.35, "timestamp": "00:17:27", "text": "実際、私たちはたくさん話しました。地獄"}, {"type": "subtitle", "time": 1056.39, "timestamp": "00:17:36", "text": "えっと、聞いてみないと"}, {"type": "subtitle", "time": 1059.07, "timestamp": "00:17:39", "text": "もし本当にうまくいくならね。のように、"}, {"type": "subtitle", "time": 1061.75, "timestamp": "00:17:41", "text": "想像する。何てことだ。私の夢は"}, {"type": "subtitle", "time": 1063.909, "timestamp": "00:17:43", "text": "国際的な騎手は実際に働いています、"}, {"type": "subtitle", "time": 1065.63, "timestamp": "00:17:45", "text": "兄弟。ああ、"}, {"type": "subtitle", "time": 1069.19, "timestamp": "00:17:49", "text": "神。大々的に宣伝しなければならない。私はしなければならない"}, {"type": "subtitle", "time": 1072.51, "timestamp": "00:17:52", "text": "大々的に宣伝しよう。実際、それは大きな"}]
[{"type": "subtitle", "time": 2880.15, "timestamp": "00:48:00", "text": "うん、まだコラボできるといいな"}, {"type": "subtitle", "time": 2927.27, "timestamp": "00:48:47", "text": "あ、待って。クインは「私たちならできる」と言った。おお、"}, {"type": "subtitle", "time": 2930.63, "timestamp": "00:48:50", "text": "うん。うん。彼女は「ああ、そうね」と言った。えっと、彼女"}, {"type": "subtitle", "time": 2937.75, "timestamp": "00:48:57", "text": "えっと、待って、彼らは何かをしないといけないんじゃないの？"}]
[{"type": "subtitle", "time": 20762.39, "timestamp": "05:46:02", "text": "ボードを調べてください、追加します"}, {"type": "subtitle", "time": 20764.548, "timestamp": "05:46:04", "text": "それも追加しておきます。"}, {"type": "subtitle", "time": 20768.31, "timestamp": "05:46:08", "text": "だから、少しは直せるよ。そう、だから"}, {"type": "subtitle", "time": 20772.39, "timestamp": "05:46:12", "text": "明日、配信で録画する予定です。"}, {"type": "subtitle", "time": 20774.548, "timestamp": "05:46:14", "text": "だから君たちも参加できるよ、"}, {"type": "subtitle", "time": 20776.948, "timestamp": "05:46:16", "text": "ええ、なぜダメなの？そして、私も"}, {"type": "subtitle", "time": 20780.11, "timestamp": "05:46:20", "text": "ストリームでビデオなどを編集しています"}, {"type": "subtitle", "time": 20782.948, "timestamp": "05:46:22", "text": "良い。うん。うん。そして、それが終わったら"}, {"type": "subtitle", "time": 20785.19, "timestamp": "05:46:25", "text": "編集したら、それを保管しておきます"}, {"type": "subtitle", "time": 20787.59, "timestamp": "05:46:27", "text": "レンダリングしたら、あとは"}, {"type": "subtitle", "time": 20790.15, "timestamp": "05:46:30", "text": "ストリーム。うん。うん。だから私は目覚めることができるといいな"}, {"type": "subtitle", "time": 20794.548, "timestamp": "05:46:34", "text": "朝6時に起きて、それをやる。 6か7でやってみて。"}, {"type": "subtitle", "time": 20797.35, "timestamp": "05:46:37", "text": "H 私は 10 時までにストリームを終了して、ああ、"}, {"type": "subtitle", "time": 20799.35, "timestamp": "05:46:39", "text": "待って。そうしたらどうなるか"}, {"type": "subtitle", "time": 20803.19, "timestamp": "05:46:43", "text": "Twitch V 犬？あ、待って。ああ、じゃあ私は"}, {"type": "subtitle", "time": 20805.43, "timestamp": "05:46:45", "text": "それではレンダリングしてください。うん。ええ、しません"}, {"type": "subtitle", "time": 20809.28, "timestamp": "05:46:49", "text": "それではレンダリングしてください。 Twitch 1 をダウンロードして"}, {"type": "subtitle", "time": 20810.75, "timestamp": "05:46:50", "text": "[音楽]"}, {"type": "subtitle", "time": 20813.19, "timestamp": "05:46:53", "text": "良い。そうそう。どうなるか見てみましょう"}, {"type": "subtitle", "time": 20814.75, "timestamp": "05:46:54", "text": "明日。"}, {"type": "subtitle", "time": 20817.91, "timestamp": "05:46:57", "text": "はぁ。というわけで、今日はここまでです。"}, {"type": "subtitle", "time": 20819.75, "timestamp": "05:46:59", "text": "心配しないで、ジョー。あなたはいつもあなたの"}]
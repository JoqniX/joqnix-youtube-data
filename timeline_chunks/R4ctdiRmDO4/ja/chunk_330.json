[{"type": "subtitle", "time": 19803.03, "timestamp": "05:30:03", "text": "お茶のある場所に行った方がいいよ。私はそれを置いた"}, {"type": "subtitle", "time": 19806.11, "timestamp": "05:30:06", "text": "そこに物がある。願わくば"}, {"type": "subtitle", "time": 19814.948, "timestamp": "05:30:14", "text": "スウェイン、君はまさにスウェインだ。"}, {"type": "subtitle", "time": 19833.628, "timestamp": "05:30:33", "text": "見てください"}, {"type": "subtitle", "time": 19854.35, "timestamp": "05:30:54", "text": "そして私が知っているのは、私は飢えようとしているということです"}, {"type": "subtitle", "time": 19858.948, "timestamp": "05:30:58", "text": "私がどれくらい生き延びられるかを見るために何日も"}]
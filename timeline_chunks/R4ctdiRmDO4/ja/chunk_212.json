[{"type": "subtitle", "time": 12723.67, "timestamp": "03:32:03", "text": "全力を尽くさなければならない。我慢する。はい、"}, {"type": "subtitle", "time": 12725.67, "timestamp": "03:32:05", "text": "ファンが回転している。わかった。私は自分のことをしなければならない"}, {"type": "subtitle", "time": 12728.07, "timestamp": "03:32:08", "text": "会話のような内容に最適です。私は行きます"}, {"type": "subtitle", "time": 12729.71, "timestamp": "03:32:09", "text": "悪い"}, {"type": "subtitle", "time": 12734.15, "timestamp": "03:32:14", "text": "それ。もっと話す方法を見つけなければならない"}, {"type": "subtitle", "time": 12736.63, "timestamp": "03:32:16", "text": "どういうわけか配信中に。"}, {"type": "subtitle", "time": 12740.19, "timestamp": "03:32:20", "text": "大丈夫ですか？ああ、そうだね"}, {"type": "subtitle", "time": 12743.03, "timestamp": "03:32:23", "text": "痛み。最近、私の焦点は"}, {"type": "subtitle", "time": 12746.15, "timestamp": "03:32:26", "text": "漂流した。私はいくつか必要だと思う"}, {"type": "subtitle", "time": 12749.349, "timestamp": "03:32:29", "text": "ストリーム数を増やすか、もう少し焦点を絞るか"}, {"type": "subtitle", "time": 12752.11, "timestamp": "03:32:32", "text": "いつもの私に戻るために"}, {"type": "subtitle", "time": 12755.63, "timestamp": "03:32:35", "text": "自己。ええ、そうですね。だから気にしないで"}, {"type": "subtitle", "time": 12763.03, "timestamp": "03:32:43", "text": "騎手。私はそれを支持します。リセットされます。"}, {"type": "subtitle", "time": 12766.03, "timestamp": "03:32:46", "text": "元に戻った後"}]
[{"type": "subtitle", "time": 8761.07, "timestamp": "02:26:01", "text": "たくさんになるだろう"}, {"type": "subtitle", "time": 8763.75, "timestamp": "02:26:03", "text": "コラボレーションとか色々あるから私は"}, {"type": "subtitle", "time": 8766.03, "timestamp": "02:26:06", "text": "満席"}, {"type": "subtitle", "time": 8769.03, "timestamp": "02:26:09", "text": "いや、ただ行く前に"}, {"type": "subtitle", "time": 8771.11, "timestamp": "02:26:11", "text": "日本とコラボレーションしたいと思っていました"}, {"type": "subtitle", "time": 8774.63, "timestamp": "02:26:14", "text": "これまで出会った人々と"}, {"type": "subtitle", "time": 8777.11, "timestamp": "02:26:17", "text": "つながりました、そして知っていました"}, {"type": "subtitle", "time": 8779.23, "timestamp": "02:26:19", "text": "私が望む人々"}, {"type": "subtitle", "time": 8794.07, "timestamp": "02:26:34", "text": "それ。だから私は苦労しているんです"}, {"type": "subtitle", "time": 8797.67, "timestamp": "02:26:37", "text": "最後の瞬間、あと数日で"}, {"type": "subtitle", "time": 8800.07, "timestamp": "02:26:40", "text": "今月末まで。私は上までしか行けません"}, {"type": "subtitle", "time": 8803.91, "timestamp": "02:26:43", "text": "6月の第1週まで。次に2番目"}, {"type": "subtitle", "time": 8805.75, "timestamp": "02:26:45", "text": "週以降はどちらかの方法で終了する必要があります"}, {"type": "subtitle", "time": 8810.07, "timestamp": "02:26:50", "text": "ジョッカソンか、いとこが"}, {"type": "subtitle", "time": 8812.389, "timestamp": "02:26:52", "text": "試験とか色々。それから"}, {"type": "subtitle", "time": 8814.59, "timestamp": "02:26:54", "text": "2週目または3週目"}, {"type": "subtitle", "time": 8817.67, "timestamp": "02:26:57", "text": "6月は私が"}]
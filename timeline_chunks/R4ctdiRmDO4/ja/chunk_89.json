[{"type": "subtitle", "time": 5343.149, "timestamp": "01:29:03", "text": "心配ないよ、バカ。しないで"}, {"type": "subtitle", "time": 5347.87, "timestamp": "01:29:07", "text": "心配。大丈夫。ほら、もし私が"}, {"type": "subtitle", "time": 5352.59, "timestamp": "01:29:12", "text": "こんな風にストリーミングしたら、"}, {"type": "subtitle", "time": 5357.03, "timestamp": "01:29:17", "text": "例えば、私があなたにDMを送ったりとか。私"}, {"type": "subtitle", "time": 5359.03, "timestamp": "01:29:19", "text": "実は私にDMを送ろうとしていたんです。それから私は"}, {"type": "subtitle", "time": 5361.55, "timestamp": "01:29:21", "text": "「ああ、もしかしたら彼女は"}, {"type": "subtitle", "time": 5380.95, "timestamp": "01:29:40", "text": "ええと、簡単に言うと、"}, {"type": "subtitle", "time": 5383.229, "timestamp": "01:29:43", "text": "遭遇する"}, {"type": "subtitle", "time": 5385.83, "timestamp": "01:29:45", "text": "挑戦、あるいは考えや何か"}, {"type": "subtitle", "time": 5394.59, "timestamp": "01:29:54", "text": "どういう風に私"}, {"type": "subtitle", "time": 5398.27, "timestamp": "01:29:58", "text": "影響を受けたものや"}]
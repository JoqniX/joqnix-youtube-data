[{"type": "subtitle", "time": 16680.51, "timestamp": "04:38:00", "text": "それなら、あなたは女王様です。"}, {"type": "subtitle", "time": 16725.75, "timestamp": "04:38:45", "text": "ええ、まさに私が言いたかったのはそれです"}, {"type": "subtitle", "time": 16728.709, "timestamp": "04:38:48", "text": "以前。"}, {"type": "subtitle", "time": 16732.31, "timestamp": "04:38:52", "text": "私が完全に"}, {"type": "subtitle", "time": 16733.23, "timestamp": "04:38:53", "text": "で"}, {"type": "subtitle", "time": 16735.99, "timestamp": "04:38:55", "text": "ジョーのようにコントロールできないと思う"}, {"type": "subtitle", "time": 16737.67, "timestamp": "04:38:57", "text": "ああ、ジョーは役を演じている"}]
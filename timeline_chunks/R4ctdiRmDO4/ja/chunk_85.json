[{"type": "subtitle", "time": 5102.91, "timestamp": "01:25:02", "text": "[音楽]"}, {"type": "chat", "time": 5108.049, "timestamp": "01:25:08", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "I wrote it, that made me cry more"}, {"type": "subtitle", "time": 5109.99, "timestamp": "01:25:09", "text": "もっと早く提案すればよかったのに。"}, {"type": "subtitle", "time": 5119.03, "timestamp": "01:25:19", "text": "8番目は私をさらに泣かせた。ああ、君"}, {"type": "subtitle", "time": 5131.669, "timestamp": "01:25:31", "text": "良い。何か忘れている気がする。えっと、"}, {"type": "subtitle", "time": 5135.83, "timestamp": "01:25:35", "text": "それは私がそこでできることだった"}, {"type": "subtitle", "time": 5139.47, "timestamp": "01:25:39", "text": "それは私ができると言われていたものだった"}, {"type": "subtitle", "time": 5152.149, "timestamp": "01:25:52", "text": "兄弟？いいえ。もし私があなたにもっと書かせたら"}, {"type": "subtitle", "time": 5156.91, "timestamp": "01:25:56", "text": "支払うのはあなたです。"}, {"type": "subtitle", "time": 5159.83, "timestamp": "01:25:59", "text": "ええ、そうですね。あ、待って。あ、待って。私は思う"}]
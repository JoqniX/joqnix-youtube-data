[{"type": "subtitle", "time": 9018.94, "timestamp": "02:30:18", "text": "良い。連絡があった"}, {"type": "subtitle", "time": 9021.23, "timestamp": "02:30:21", "text": "[音楽]"}, {"type": "subtitle", "time": 9042.55, "timestamp": "02:30:42", "text": "D. 実は、私は"}, {"type": "subtitle", "time": 9043.91, "timestamp": "02:30:43", "text": "チャンネルはありますが、どこで一時停止すればいいのかわかりません。"}, {"type": "subtitle", "time": 9045.58, "timestamp": "02:30:45", "text": "だから私はいつも持っているわけではない"}, {"type": "subtitle", "time": 9050.99, "timestamp": "02:30:50", "text": "[音楽]"}, {"type": "subtitle", "time": 9053.63, "timestamp": "02:30:53", "text": "時間。所有"}]
[{"type": "subtitle", "time": 18842.19, "timestamp": "05:14:02", "text": "そもそも、私はプレイマッチを一つでも最後までやり遂げたのだろうか？私"}, {"type": "subtitle", "time": 18844.948, "timestamp": "05:14:04", "text": "ダメージを与えることすらできない"}, {"type": "subtitle", "time": 18846.03, "timestamp": "05:14:06", "text": "これ"}, {"type": "subtitle", "time": 18852.27, "timestamp": "05:14:12", "text": "おお。何をすればいいですか"}, {"type": "subtitle", "time": 18855.43, "timestamp": "05:14:15", "text": "する？低解像度で再生してください。意思"}, {"type": "subtitle", "time": 18857.47, "timestamp": "05:14:17", "text": "それ"}, {"type": "subtitle", "time": 18863.23, "timestamp": "05:14:23", "text": "できますか"}, {"type": "subtitle", "time": 18867.59, "timestamp": "05:14:27", "text": "これを修正するにはどうすればいいですか？私がプレイしても大丈夫ですか？"}, {"type": "subtitle", "time": 18871.23, "timestamp": "05:14:31", "text": "解像度が非常に低い"}, {"type": "subtitle", "time": 18874.47, "timestamp": "05:14:34", "text": "今？あなたにとって負担になりすぎないことを願っています"}, {"type": "subtitle", "time": 18876.51, "timestamp": "05:14:36", "text": "男たち"}, {"type": "subtitle", "time": 18885.39, "timestamp": "05:14:45", "text": "でも、これをやってみよう"}, {"type": "subtitle", "time": 18887.99, "timestamp": "05:14:47", "text": "解決。うん、じゃあ、"}, {"type": "subtitle", "time": 18889.75, "timestamp": "05:14:49", "text": "この決議案？"}, {"type": "subtitle", "time": 18892.868, "timestamp": "05:14:52", "text": "私にとっては小さな箱のようなものですが、"}, {"type": "subtitle", "time": 18893.948, "timestamp": "05:14:53", "text": "大丈夫だよ。"}, {"type": "subtitle", "time": 18896.708, "timestamp": "05:14:56", "text": "右。まるで小さな箱のようだ"}]
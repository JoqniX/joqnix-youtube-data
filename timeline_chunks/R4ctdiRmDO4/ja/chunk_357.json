[{"type": "subtitle", "time": 21424.07, "timestamp": "05:57:04", "text": "ああ、ああ、って感じ。そうそう。私はちょっと"}, {"type": "subtitle", "time": 21427.11, "timestamp": "05:57:07", "text": "ポスターを確認しました。まるでまるで"}, {"type": "subtitle", "time": 21429.27, "timestamp": "05:57:09", "text": "こんな風に猫背になる。座るだけ"}, {"type": "subtitle", "time": 21444.75, "timestamp": "05:57:24", "text": "これらすべてが"}, {"type": "subtitle", "time": 21449.39, "timestamp": "05:57:29", "text": "もし私が依存するなら、もっと簡単になるだろう"}, {"type": "subtitle", "time": 21452.708, "timestamp": "05:57:32", "text": "誰か。私が依存していないからでしょうか"}, {"type": "subtitle", "time": 21455.03, "timestamp": "05:57:35", "text": "誰か？"}, {"type": "subtitle", "time": 21458.07, "timestamp": "05:57:38", "text": "でも、ちょっと嫌な経験もあったんです"}, {"type": "subtitle", "time": 21460.948, "timestamp": "05:57:40", "text": "誰かに頼って、"}, {"type": "subtitle", "time": 21463.27, "timestamp": "05:57:43", "text": "口うるさい、威張り屋の妻。私は"}, {"type": "subtitle", "time": 21464.59, "timestamp": "05:57:44", "text": "あなた"}, {"type": "subtitle", "time": 21467.11, "timestamp": "05:57:47", "text": "良い経験がなかったことは知っています"}, {"type": "subtitle", "time": 21469.788, "timestamp": "05:57:49", "text": "それ。だから私は"}, {"type": "subtitle", "time": 21474.628, "timestamp": "05:57:54", "text": "私は何から自由になるのでしょうか"}]
[{"type": "subtitle", "time": 4380.43, "timestamp": "01:13:00", "text": "彼は戻ってくるはずだった"}, {"type": "subtitle", "time": 4382.27, "timestamp": "01:13:02", "text": "ストリーミング配信？何"}, {"type": "subtitle", "time": 4389.709, "timestamp": "01:13:09", "text": "年。 2年が経ちました。"}, {"type": "subtitle", "time": 4393.31, "timestamp": "01:13:13", "text": "兄弟。私の"}, {"type": "subtitle", "time": 4402.35, "timestamp": "01:13:22", "text": "年齢。タワーオブ"}, {"type": "subtitle", "time": 4413.59, "timestamp": "01:13:33", "text": "彼は、"}, {"type": "subtitle", "time": 4416.75, "timestamp": "01:13:36", "text": "Sammy ストリームボードを積極的に使用し、"}, {"type": "subtitle", "time": 4420.07, "timestamp": "01:13:40", "text": "もの。私のような人は実際に"}, {"type": "subtitle", "time": 4422.83, "timestamp": "01:13:42", "text": "知識を深めたかった"}, {"type": "subtitle", "time": 4429.27, "timestamp": "01:13:49", "text": "ストリーミング配信。彼は自分で作っていた"}, {"type": "subtitle", "time": 4431.83, "timestamp": "01:13:51", "text": "ウィジェットとか色々、OPアニメーションとか"}, {"type": "subtitle", "time": 4434.55, "timestamp": "01:13:54", "text": "すべて。"}, {"type": "subtitle", "time": 4436.149, "timestamp": "01:13:56", "text": "トリガーボタンがたくさんあり、"}, {"type": "subtitle", "time": 4439.91, "timestamp": "01:13:59", "text": "やるべきことがたくさんあります。誰かがとても嬉しかった"}]
[{"type": "subtitle", "time": 7800.99, "timestamp": "02:10:00", "text": "彼女は勤勉な"}, {"type": "subtitle", "time": 7804.39, "timestamp": "02:10:04", "text": "人。彼女には現実の生活がある。彼女は"}, {"type": "subtitle", "time": 7808.55, "timestamp": "02:10:08", "text": "彼女は楽しみのためにYouTubeをやっていて、"}, {"type": "subtitle", "time": 7811.87, "timestamp": "02:10:11", "text": "彼女のすること。"}, {"type": "subtitle", "time": 7814.95, "timestamp": "02:10:14", "text": "そして人々が次のようなことをすると"}, {"type": "subtitle", "time": 7815.95, "timestamp": "02:10:15", "text": "それ"}, {"type": "subtitle", "time": 7819.069, "timestamp": "02:10:19", "text": "などなど"}, {"type": "chat", "time": 7822.073, "timestamp": "02:10:22", "author": "@Anti-SpiritArt", "avatar": "https://yt4.ggpht.com/wYaIbwf481rN5bfgaxWnbUoh-faRynKzhqgZXK5WIvlx9DlMJJl0M6boNmqYwDkmuSY99pM-=s64-c-k-c0x00ffffff-no-rj", "message": "yeah definatlly"}, {"type": "subtitle", "time": 7822.149, "timestamp": "02:10:22", "text": "冗談だ。誰もが冗談を理解できるわけではない。いいえ、"}, {"type": "subtitle", "time": 7825.31, "timestamp": "02:10:25", "text": "みんな"}, {"type": "subtitle", "time": 7827.589, "timestamp": "02:10:27", "text": "違う。私を見て。私はできません"}, {"type": "subtitle", "time": 7832.149, "timestamp": "02:10:32", "text": "ジョークを理解する。私はそれを真剣に受け止めています。"}, {"type": "subtitle", "time": 7835.99, "timestamp": "02:10:35", "text": "文字通りビリー・ブリーの誰か"}, {"type": "subtitle", "time": 7839.669, "timestamp": "02:10:39", "text": "えっと、さっき言ったように、あなたは"}, {"type": "subtitle", "time": 7841.709, "timestamp": "02:10:41", "text": "清潔な水を飲む"}, {"type": "subtitle", "time": 7845.589, "timestamp": "02:10:45", "text": "インド？調子はどうですか？そして私は"}, {"type": "subtitle", "time": 7848.069, "timestamp": "02:10:48", "text": "真剣に受け止めたよ、兄弟。私にはわからない"}, {"type": "subtitle", "time": 7851.27, "timestamp": "02:10:51", "text": "もしそれが冗談だったとしたら。でも私はまだそう思ってない"}, {"type": "subtitle", "time": 7853.31, "timestamp": "02:10:53", "text": "彼は冗談だと言ったが"}, {"type": "subtitle", "time": 7856.39, "timestamp": "02:10:56", "text": "でも私は「うん、きれいだよ」って思った"}, {"type": "subtitle", "time": 7858.31, "timestamp": "02:10:58", "text": "インドの水。わからない、わからない"}]
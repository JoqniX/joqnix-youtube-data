[{"type": "subtitle", "time": 16261.51, "timestamp": "04:31:01", "text": "ああ、もっと彼らの話を聞きたい。"}, {"type": "subtitle", "time": 16267.03, "timestamp": "04:31:07", "text": "うん。"}, {"type": "subtitle", "time": 16269.429, "timestamp": "04:31:09", "text": "まるで、あなたがそれに惹かれているように感じる"}, {"type": "subtitle", "time": 16272.149, "timestamp": "04:31:12", "text": "特定の声、あるいは彼らがどのようにそうしているか、あるいは"}, {"type": "subtitle", "time": 16275.71, "timestamp": "04:31:15", "text": "何か。それは同じようなものです"}, {"type": "subtitle", "time": 16279.79, "timestamp": "04:31:19", "text": "ほとんどの人が惹かれる"}, {"type": "subtitle", "time": 16282.07, "timestamp": "04:31:22", "text": "見た目や外見"}, {"type": "subtitle", "time": 16284.469, "timestamp": "04:31:24", "text": "何か。音声についても同様です。ああ、私も同じ"}, {"type": "subtitle", "time": 16287.149, "timestamp": "04:31:27", "text": "個性的な"}, {"type": "subtitle", "time": 16299.55, "timestamp": "04:31:39", "text": "私がこの役を演じているのは、この物語に魅力を感じているからです。"}, {"type": "subtitle", "time": 16318.59, "timestamp": "04:31:58", "text": "楽しい。 U by hi"}]
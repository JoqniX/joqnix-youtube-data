[{"type": "subtitle", "time": 15301.5, "timestamp": "04:15:01", "text": "1つ。とても甘い"}, {"type": "subtitle", "time": 15307.229, "timestamp": "04:15:07", "text": "お前。"}, {"type": "subtitle", "time": 15328.469, "timestamp": "04:15:28", "text": "明日なのか明日なのか分からない"}, {"type": "subtitle", "time": 15339.349, "timestamp": "04:15:39", "text": "それは「うん」ではなかった。うん。うん。それ"}, {"type": "subtitle", "time": 15342.11, "timestamp": "04:15:42", "text": "問題なかった。うん。うん。次のように言うことができます"}, {"type": "subtitle", "time": 15344.87, "timestamp": "04:15:44", "text": "それ。それを受け取って。忘れずに、睡眠をとりましょう。はい。"}, {"type": "subtitle", "time": 15351.429, "timestamp": "04:15:51", "text": "寝る。うん。うん。"}, {"type": "subtitle", "time": 15354.07, "timestamp": "04:15:54", "text": "試験とか色々頑張ってね。"}]
[{"type": "subtitle", "time": 8538.85, "timestamp": "02:22:18", "text": "何"}, {"type": "subtitle", "time": 8559.99, "timestamp": "02:22:39", "text": "待ち時間？ヒューマンフォールFLのようなゲーム。"}, {"type": "subtitle", "time": 8564.11, "timestamp": "02:22:44", "text": "待って、デュオベースのゲームって何？"}, {"type": "subtitle", "time": 8572.99, "timestamp": "02:22:52", "text": "誰か？こんにちは、オピヴィラさん、ようこそ。"}, {"type": "subtitle", "time": 8575.99, "timestamp": "02:22:55", "text": "そして、私はまだストレスが溜まっています"}, {"type": "subtitle", "time": 8577.83, "timestamp": "02:22:57", "text": "とても若くて、私は空手をたくさんやっています"}]
[{"type": "subtitle", "time": 19861.31, "timestamp": "05:31:01", "text": "飲まなくても生きられる"}, {"type": "subtitle", "time": 19863.75, "timestamp": "05:31:03", "text": "水と何も食べずに"}, {"type": "subtitle", "time": 19866.03, "timestamp": "05:31:06", "text": "あるいは次のような"}, {"type": "subtitle", "time": 19868.23, "timestamp": "05:31:08", "text": "それ。他に何を持っているかわかりません"}, {"type": "subtitle", "time": 19877.708, "timestamp": "05:31:17", "text": "ある意味、すべてをこなすのはとてもクールだ"}, {"type": "subtitle", "time": 19880.19, "timestamp": "05:31:20", "text": "これらの楽しい楽しい"}, {"type": "subtitle", "time": 19882.708, "timestamp": "05:31:22", "text": "実験。しかし、あなたはそうすべきではありません"}, {"type": "subtitle", "time": 19885.15, "timestamp": "05:31:25", "text": "これは"}, {"type": "subtitle", "time": 19913.75, "timestamp": "05:31:53", "text": "[音楽]"}, {"type": "subtitle", "time": 19915.67, "timestamp": "05:31:55", "text": "私が最初に取ります。"}, {"type": "subtitle", "time": 19918.11, "timestamp": "05:31:58", "text": "最初にそれを手に入れたい。おお、"}]
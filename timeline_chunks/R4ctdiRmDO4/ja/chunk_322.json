[{"type": "subtitle", "time": 19323.31, "timestamp": "05:22:03", "text": "あれ。"}, {"type": "subtitle", "time": 19330.708, "timestamp": "05:22:10", "text": "弾薬。 PP"}, {"type": "subtitle", "time": 19332.788, "timestamp": "05:22:12", "text": "ああ、右クリックが壊れてる"}, {"type": "subtitle", "time": 19334.31, "timestamp": "05:22:14", "text": "良い。"}, {"type": "subtitle", "time": 19335.948, "timestamp": "05:22:15", "text": "うん。たくさん"}, {"type": "subtitle", "time": 19341.51, "timestamp": "05:22:21", "text": "時々問題が発生する、つまり壊れた意味"}, {"type": "subtitle", "time": 19344.788, "timestamp": "05:22:24", "text": "えっと、右クリックしてもホールドされません"}, {"type": "subtitle", "time": 19348.708, "timestamp": "05:22:28", "text": "より強く保持するか、この状態のように、"}, {"type": "subtitle", "time": 19351.31, "timestamp": "05:22:31", "text": "さもないと、"}, {"type": "subtitle", "time": 19356.15, "timestamp": "05:22:36", "text": "これは通常です。わかった。"}, {"type": "subtitle", "time": 19359.47, "timestamp": "05:22:39", "text": "たくさんの物。"}, {"type": "subtitle", "time": 19364.35, "timestamp": "05:22:44", "text": "N 人の PC の問題は常に"}, {"type": "subtitle", "time": 19367.99, "timestamp": "05:22:47", "text": "痛み。なぜそうなるのか不思議だ"}, {"type": "subtitle", "time": 19369.23, "timestamp": "05:22:49", "text": "いくつか"}, {"type": "subtitle", "time": 19372.55, "timestamp": "05:22:52", "text": "例えば、新しいPCを買ったとしましょう。"}, {"type": "subtitle", "time": 19374.948, "timestamp": "05:22:54", "text": "そしてあなたは全てを持っている。わかった。何もない"}, {"type": "subtitle", "time": 19377.19, "timestamp": "05:22:57", "text": "こういうことが起こるんです。もちろんそうなるだろう"}]
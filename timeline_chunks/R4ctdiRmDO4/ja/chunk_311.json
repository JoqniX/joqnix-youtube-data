[{"type": "subtitle", "time": 18662.708, "timestamp": "05:11:02", "text": "あれってなんて言うんだっけ？"}, {"type": "subtitle", "time": 18665.43, "timestamp": "05:11:05", "text": "ドレスとかアイロンがけはどこでするの？"}, {"type": "subtitle", "time": 18667.948, "timestamp": "05:11:07", "text": "あなたがアイロンをかけるのに使うあの機器"}, {"type": "subtitle", "time": 18671.43, "timestamp": "05:11:11", "text": "ドレスとかそういうもの。鉄製の箱。それが"}, {"type": "subtitle", "time": 18672.51, "timestamp": "05:11:12", "text": "あなたが電話すると、"}, {"type": "subtitle", "time": 18675.35, "timestamp": "05:11:15", "text": "右？衣類用アイロン。つまり"}, {"type": "subtitle", "time": 18677.708, "timestamp": "05:11:17", "text": "彼らはそれをこう呼ぶ。わかった。"}, {"type": "subtitle", "time": 18679.16, "timestamp": "05:11:19", "text": "フローティング。"}, {"type": "subtitle", "time": 18698.23, "timestamp": "05:11:38", "text": "午前。それは鉄と呼ばれます。バカ。いいえ。鉄は"}, {"type": "subtitle", "time": 18699.628, "timestamp": "05:11:39", "text": "鉄のように。"}, {"type": "subtitle", "time": 18702.99, "timestamp": "05:11:42", "text": "D. あるいはそれは"}, {"type": "subtitle", "time": 18705.99, "timestamp": "05:11:45", "text": "鉄？鉄は鉄だ。ああ、ただこう呼んでください"}, {"type": "subtitle", "time": 18708.31, "timestamp": "05:11:48", "text": "鉄。わかった、"}, {"type": "subtitle", "time": 18717.708, "timestamp": "05:11:57", "text": "病気"}]
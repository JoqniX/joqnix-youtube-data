[{"type": "subtitle", "time": 16802.31, "timestamp": "04:40:02", "text": "知る。ああ、でも私はやらないよ。の"}, {"type": "subtitle", "time": 16804.67, "timestamp": "04:40:04", "text": "もちろん、私はそんなことはしません。だから"}, {"type": "subtitle", "time": 16810.31, "timestamp": "04:40:10", "text": "それは、えーと、私の"}, {"type": "subtitle", "time": 16813.19, "timestamp": "04:40:13", "text": "私の観客はこう言うでしょう"}, {"type": "subtitle", "time": 16816.15, "timestamp": "04:40:16", "text": "ジョッキーは悪態をつかないし、ほとんどの"}, {"type": "subtitle", "time": 16818.31, "timestamp": "04:40:18", "text": "君たちのほとんどはこう思うだろう"}, {"type": "subtitle", "time": 16821.35, "timestamp": "04:40:21", "text": "つまり、こう考えてみてください"}, {"type": "subtitle", "time": 16823.35, "timestamp": "04:40:23", "text": "でも、配信者が共有していない場合は"}, {"type": "subtitle", "time": 16826.15, "timestamp": "04:40:26", "text": "何か、あるいは何かをしている"}, {"type": "subtitle", "time": 16829.19, "timestamp": "04:40:29", "text": "普段はしないことをする"}, {"type": "subtitle", "time": 16831.35, "timestamp": "04:40:31", "text": "待って、あなたが何かをしていない"}, {"type": "subtitle", "time": 16834.39, "timestamp": "04:40:34", "text": "たいていはそうする。 H. それはあなたが"}, {"type": "subtitle", "time": 16837.03, "timestamp": "04:40:37", "text": "自分のものも適応させなければならない"}, {"type": "subtitle", "time": 16839.75, "timestamp": "04:40:39", "text": "えっと、あなたは配信者チャットにいますか、"}, {"type": "subtitle", "time": 16841.43, "timestamp": "04:40:41", "text": "そんな感じ。ただクソ野郎になるだけ"}, {"type": "subtitle", "time": 16847.31, "timestamp": "04:40:47", "text": "それでいいんです。だから私は、ボスが"}, {"type": "subtitle", "time": 16850.39, "timestamp": "04:40:50", "text": "ジョックはそれについて考えた。だから彼は"}, {"type": "subtitle", "time": 16853.67, "timestamp": "04:40:53", "text": "まるで他のストリーマーみたい"}, {"type": "subtitle", "time": 16856.07, "timestamp": "04:40:56", "text": "あるいは、彼らはこう言うでしょう"}, {"type": "subtitle", "time": 16859.03, "timestamp": "04:40:59", "text": "もし私が普通にやっているなら"}]
[{"type": "subtitle", "time": 15437.91, "timestamp": "04:17:17", "text": "ヴァンパイアは伝染性があるに違いない。うん、君"}, {"type": "subtitle", "time": 15441.189, "timestamp": "04:17:21", "text": "睡眠をとるか、Pを急いでください。"}, {"type": "subtitle", "time": 15444.11, "timestamp": "04:17:24", "text": "あなた自身が滞在するために"}, {"type": "subtitle", "time": 15447.59, "timestamp": "04:17:27", "text": "上。なぜコーヒーを飲んでいるのですか？食べない"}, {"type": "subtitle", "time": 15454.349, "timestamp": "04:17:34", "text": "しかし"}, {"type": "subtitle", "time": 15457.03, "timestamp": "04:17:37", "text": "うん、わかるでしょ、私の気持ちわかるでしょ"}, {"type": "subtitle", "time": 15457.95, "timestamp": "04:17:37", "text": "のように"}, {"type": "subtitle", "time": 15461.67, "timestamp": "04:17:41", "text": "何をしているの？待って。ああ、もし私が始めていれば"}, {"type": "subtitle", "time": 15464.91, "timestamp": "04:17:44", "text": "このストリームは3時に流れますよね？できました"}, {"type": "subtitle", "time": 15472.51, "timestamp": "04:17:52", "text": "何か。私は生産的でありたい"}, {"type": "subtitle", "time": 15474.79, "timestamp": "04:17:54", "text": "また。いいえ、私は夜寝ます"}, {"type": "subtitle", "time": 15477.11, "timestamp": "04:17:57", "text": "全員一緒に。いいぞ、いいぞ、いいぞ、いいぞ。"}, {"type": "subtitle", "time": 15479.91, "timestamp": "04:17:59", "text": "ご存知のとおり、私は"}]
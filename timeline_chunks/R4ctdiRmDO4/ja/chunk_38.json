[{"type": "subtitle", "time": 2282.109, "timestamp": "00:38:02", "text": "待って。私は"}, {"type": "subtitle", "time": 2284.99, "timestamp": "00:38:04", "text": "ログをダウンロードしていますか？ああ、ダウンロード中です"}, {"type": "subtitle", "time": 2289.109, "timestamp": "00:38:09", "text": "もうすでにだよ、兄弟。わかった。一瞥は私が"}, {"type": "subtitle", "time": 2298.03, "timestamp": "00:38:18", "text": "トゥイッチ。"}, {"type": "subtitle", "time": 2304.109, "timestamp": "00:38:24", "text": "待って。"}, {"type": "subtitle", "time": 2306.95, "timestamp": "00:38:26", "text": "いや、違うよ。彼らはTwitchで配信していないの？"}, {"type": "subtitle", "time": 2313.91, "timestamp": "00:38:33", "text": "問題は、あまり交流していないということです"}, {"type": "subtitle", "time": 2316.109, "timestamp": "00:38:36", "text": "と"}, {"type": "subtitle", "time": 2318.1, "timestamp": "00:38:38", "text": "氏族。彼らはそうなると思う"}, {"type": "subtitle", "time": 2319.95, "timestamp": "00:38:39", "text": "[音楽]"}, {"type": "subtitle", "time": 2322.95, "timestamp": "00:38:42", "text": "下。しかし、私には何ができるというのか"}, {"type": "subtitle", "time": 2324.75, "timestamp": "00:38:44", "text": "同等のもの"}, {"type": "subtitle", "time": 2327.109, "timestamp": "00:38:47", "text": "今。彼らがダウンするかどうかはわかりません。"}, {"type": "subtitle", "time": 2339.27, "timestamp": "00:38:59", "text": "試す。待って、彼は個人ですよね？"}]
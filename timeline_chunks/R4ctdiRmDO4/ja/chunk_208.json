[{"type": "subtitle", "time": 12490.389, "timestamp": "03:28:10", "text": "意味。"}, {"type": "subtitle", "time": 12492.389, "timestamp": "03:28:12", "text": "うん。うん。うん。そして私は、私は"}, {"type": "subtitle", "time": 12494.55, "timestamp": "03:28:14", "text": "私は誰かだからそれについて話すことはできない"}, {"type": "subtitle", "time": 12496.469, "timestamp": "03:28:16", "text": "実際にゲームにお金を使う人は"}, {"type": "subtitle", "time": 12499.71, "timestamp": "03:28:19", "text": "私は決してお金を使わないと言った"}, {"type": "subtitle", "time": 12501.63, "timestamp": "03:28:21", "text": "それは"}, {"type": "subtitle", "time": 12520.349, "timestamp": "03:28:40", "text": "一瞬。うん。"}, {"type": "subtitle", "time": 12531.51, "timestamp": "03:28:51", "text": "痛み。まあ、可愛いとは思うけどね。"}]
[{"type": "subtitle", "time": 17101.35, "timestamp": "04:45:01", "text": "動詞。ちなみに、すごく暑いですよ。平"}, {"type": "subtitle", "time": 17104.23, "timestamp": "04:45:04", "text": "エアコンをつけると、ものすごく暑い。私"}, {"type": "subtitle", "time": 17107.03, "timestamp": "04:45:07", "text": "熱気が迫ってくるのが感じられる。何てことだ。"}, {"type": "subtitle", "time": 17109.99, "timestamp": "04:45:09", "text": "待って。実際は待ってください。"}, {"type": "subtitle", "time": 17113.07, "timestamp": "04:45:13", "text": "これは普通のことですか？"}, {"type": "subtitle", "time": 17115.07, "timestamp": "04:45:15", "text": "待って。"}, {"type": "subtitle", "time": 17124.23, "timestamp": "04:45:24", "text": "何をしているの？おかえりなさい。私はします"}, {"type": "subtitle", "time": 17124.83, "timestamp": "04:45:24", "text": "シュート"}, {"type": "subtitle", "time": 17127.75, "timestamp": "04:45:27", "text": "あなた。ベイビー、どうしてこんなに暑いの？"}, {"type": "subtitle", "time": 17137.67, "timestamp": "04:45:37", "text": "GP。いいえ、それは喫煙ではありません。"}, {"type": "subtitle", "time": 17139.99, "timestamp": "04:45:39", "text": "実際は、すごく難しいんです。"}, {"type": "subtitle", "time": 17150.948, "timestamp": "04:45:50", "text": "お皿、ほら、こんなに滑らかになったでしょ。"}]
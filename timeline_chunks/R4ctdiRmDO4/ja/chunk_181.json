[{"type": "subtitle", "time": 10861.03, "timestamp": "03:01:01", "text": "ありがたいことに。ホーム画面は文字通り"}, {"type": "subtitle", "time": 10862.79, "timestamp": "03:01:02", "text": "あなたが今見ているのがこれです。これは"}, {"type": "subtitle", "time": 10865.23, "timestamp": "03:01:05", "text": "ホーム画面。鍵じゃなくてよかった"}, {"type": "subtitle", "time": 10867.83, "timestamp": "03:01:07", "text": "画面。ええ、ホーム画面はこれです。"}, {"type": "subtitle", "time": 10870.79, "timestamp": "03:01:10", "text": "これは私が描いたファンアートです"}, {"type": "subtitle", "time": 10874.309, "timestamp": "03:01:14", "text": "えっと、私の誕生日に仲間がやってくれた"}, {"type": "subtitle", "time": 10877.469, "timestamp": "03:01:17", "text": "私のインド人ユーチューバーの友人は"}, {"type": "subtitle", "time": 10880.11, "timestamp": "03:01:20", "text": "いすい。彼女はこれを描いた"}, {"type": "subtitle", "time": 10883.79, "timestamp": "03:01:23", "text": "自分。完全なアートワークは"}, {"type": "subtitle", "time": 10887.269, "timestamp": "03:01:27", "text": "これが見つかればの話ですが。それは私の"}, {"type": "subtitle", "time": 10890.96, "timestamp": "03:01:30", "text": "シャワー。取ってきます。"}, {"type": "subtitle", "time": 10893.59, "timestamp": "03:01:33", "text": "[音楽]"}, {"type": "subtitle", "time": 10901.99, "timestamp": "03:01:41", "text": "ああ、アニメの女の子アニメ。ああ、これらは"}, {"type": "subtitle", "time": 10904.15, "timestamp": "03:01:44", "text": "壁紙のようなものだ。アニメの壁紙。そして"}, {"type": "subtitle", "time": 10911.59, "timestamp": "03:01:51", "text": "あれ。たくさんのランダムな"}, {"type": "subtitle", "time": 10912.83, "timestamp": "03:01:52", "text": "えーと"}, {"type": "subtitle", "time": 10915.91, "timestamp": "03:01:55", "text": "要点を絞って。すごく変だ。私"}, {"type": "subtitle", "time": 10918.59, "timestamp": "03:01:58", "text": "それらを片付ける必要がある。掃除する"}]
[{"type": "subtitle", "time": 9729.429, "timestamp": "02:42:09", "text": "ストリームなどでもっとアクティブに活動しています。"}, {"type": "subtitle", "time": 9734.27, "timestamp": "02:42:14", "text": "えっと、もしあなたが"}, {"type": "subtitle", "time": 9735.95, "timestamp": "02:42:15", "text": "は"}, {"type": "subtitle", "time": 9738.99, "timestamp": "02:42:18", "text": "自由にいいね"}, {"type": "subtitle", "time": 9748.51, "timestamp": "02:42:28", "text": "ゲームには"}, {"type": "subtitle", "time": 9752.09, "timestamp": "02:42:32", "text": "私のおっぱいを一緒に"}, {"type": "subtitle", "time": 9754.27, "timestamp": "02:42:34", "text": "[音楽]"}, {"type": "subtitle", "time": 9762.67, "timestamp": "02:42:42", "text": "された"}, {"type": "subtitle", "time": 9764.33, "timestamp": "02:42:44", "text": "行う"}, {"type": "subtitle", "time": 9765.87, "timestamp": "02:42:45", "text": "[音楽]"}, {"type": "subtitle", "time": 9769.63, "timestamp": "02:42:49", "text": "妨害行為と"}, {"type": "subtitle", "time": 9771.71, "timestamp": "02:42:51", "text": "チョコレート。それで"}, {"type": "subtitle", "time": 9779.93, "timestamp": "02:42:59", "text": "7月までに日本へ到着予定。"}]
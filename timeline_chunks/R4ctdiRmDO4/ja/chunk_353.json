[{"type": "subtitle", "time": 21182.91, "timestamp": "05:53:02", "text": "一瞬。何ですか"}, {"type": "subtitle", "time": 21186.07, "timestamp": "05:53:06", "text": "面白い？わからない。そしてまた、"}, {"type": "subtitle", "time": 21200.07, "timestamp": "05:53:20", "text": "マルキ。多くの人がジョッキーは"}, {"type": "subtitle", "time": 21202.788, "timestamp": "05:53:22", "text": "彼らは彼女を殺した。ニャーとも鳴く。たくさん"}, {"type": "subtitle", "time": 21208.39, "timestamp": "05:53:28", "text": "人々の話を聞いていないような感じ。平"}, {"type": "subtitle", "time": 21211.51, "timestamp": "05:53:31", "text": "家族もそうだけど、私は聞いてない。知っている"}, {"type": "subtitle", "time": 21214.27, "timestamp": "05:53:34", "text": "終わらない"}, {"type": "subtitle", "time": 21217.91, "timestamp": "05:53:37", "text": "ええ、私はすでにそれを経験しました"}, {"type": "subtitle", "time": 21221.19, "timestamp": "05:53:41", "text": "まるでそのシナリオや夢のように、"}, {"type": "subtitle", "time": 21225.75, "timestamp": "05:53:45", "text": "一日がどんなものになるだろうか"}, {"type": "subtitle", "time": 21229.11, "timestamp": "05:53:49", "text": "ストリーミング配信や、起き上がる瞬間などが可能"}, {"type": "subtitle", "time": 21230.628, "timestamp": "05:53:50", "text": "何か。私はそれが怖いんです。"}, {"type": "subtitle", "time": 21233.91, "timestamp": "05:53:53", "text": "でも、今ある時間を使って"}, {"type": "subtitle", "time": 21236.15, "timestamp": "05:53:56", "text": "それを最大限に活用するべきでしょうね。私"}, {"type": "subtitle", "time": 21237.15, "timestamp": "05:53:57", "text": "私はそうは思わない"}]
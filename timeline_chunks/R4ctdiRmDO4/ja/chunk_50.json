[{"type": "subtitle", "time": 3003.15, "timestamp": "00:50:03", "text": "いらっしゃいませ。えっと、ちょっと読んでみますね。"}, {"type": "subtitle", "time": 3011.39, "timestamp": "00:50:11", "text": "だから神様、神様、悪い神様、悪い神様"}, {"type": "subtitle", "time": 3013.79, "timestamp": "00:50:13", "text": "悪い。こんにちは"}, {"type": "subtitle", "time": 3016.04, "timestamp": "00:50:16", "text": "こんにちは da。どんな感じですか？えっと、何かした"}, {"type": "subtitle", "time": 3021.52, "timestamp": "00:50:21", "text": "da。どんな感じですか？えっと、何かした 起こる？疑問符。"}, {"type": "subtitle", "time": 3036.03, "timestamp": "00:50:36", "text": "神。ジョック。ジョック。何してるの"}, {"type": "subtitle", "time": 3042.15, "timestamp": "00:50:42", "text": "何？どういう意味ですか？私は何をしているのだろうか"}, {"type": "subtitle", "time": 3044.27, "timestamp": "00:50:44", "text": "ここ？私はここにいた"}, {"type": "subtitle", "time": 3047.75, "timestamp": "00:50:47", "text": "永遠に。私は空の上にいる。 D. 私を見て。"}, {"type": "subtitle", "time": 3051.51, "timestamp": "00:50:51", "text": "見て。空を見上げてごらん。"}, {"type": "subtitle", "time": 3052.74, "timestamp": "00:50:52", "text": "私は"}]
[{"type": "subtitle", "time": 13742.349, "timestamp": "03:49:02", "text": "正しい、特に信仰に関して"}, {"type": "subtitle", "time": 13746.349, "timestamp": "03:49:06", "text": "状況は、同僚が"}, {"type": "subtitle", "time": 13749.349, "timestamp": "03:49:09", "text": "プレッシャーであって、仲間からのプレッシャーではないけれど、ある種のプレッシャー"}, {"type": "subtitle", "time": 13763.67, "timestamp": "03:49:23", "text": "ええと、人々は助けを求めています。"}, {"type": "subtitle", "time": 13765.63, "timestamp": "03:49:25", "text": "彼らはまるで"}, {"type": "subtitle", "time": 13767.87, "timestamp": "03:49:27", "text": "1Kまたは"}, {"type": "subtitle", "time": 13771.269, "timestamp": "03:49:31", "text": "フォロワー1万3千人とか。そして私は"}, {"type": "subtitle", "time": 13775.389, "timestamp": "03:49:35", "text": "独身男性で、"}, {"type": "subtitle", "time": 13779.75, "timestamp": "03:49:39", "text": "何？それで、私たちは一体何を見たのでしょうか？九、"}, {"type": "subtitle", "time": 13782.95, "timestamp": "03:49:42", "text": "右？ 9か10。いや、実際は12だ。うん、"}, {"type": "subtitle", "time": 13784.349, "timestamp": "03:49:44", "text": "12."}, {"type": "subtitle", "time": 13792.87, "timestamp": "03:49:52", "text": "うん。うん。うん。だから、もっと難しくなるだろう"}, {"type": "subtitle", "time": 13796.91, "timestamp": "03:49:56", "text": "私にとって実際に"}]
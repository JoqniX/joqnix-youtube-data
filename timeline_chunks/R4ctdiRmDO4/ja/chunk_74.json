[{"type": "subtitle", "time": 4443.11, "timestamp": "01:14:03", "text": "他の人も同じことをしている"}, {"type": "subtitle", "time": 4446.35, "timestamp": "01:14:06", "text": "昔もやっていた"}, {"type": "subtitle", "time": 4469.59, "timestamp": "01:14:29", "text": "主催者コミュニティの責任者でさえ"}, {"type": "subtitle", "time": 4479.75, "timestamp": "01:14:39", "text": "彼はタワー・オブ・ファンタジーになったのか？"}, {"type": "subtitle", "time": 4481.63, "timestamp": "01:14:41", "text": "作成者または"}, {"type": "subtitle", "time": 4484.11, "timestamp": "01:14:44", "text": "何か？"}, {"type": "subtitle", "time": 4488.7, "timestamp": "01:14:48", "text": "くそ。ああ、彼が恋しい。"}]
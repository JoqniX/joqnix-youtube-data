[{"type": "subtitle", "time": 10261.389, "timestamp": "02:51:01", "text": "知ってるでしょ、私には"}, {"type": "subtitle", "time": 10264.349, "timestamp": "02:51:04", "text": "車輪。そのため、"}, {"type": "subtitle", "time": 10267.75, "timestamp": "02:51:07", "text": "ルーレットを回してランダムなことをする"}, {"type": "subtitle", "time": 10283.59, "timestamp": "02:51:23", "text": "また、メインのゲームがあるべきだ"}, {"type": "subtitle", "time": 10285.11, "timestamp": "02:51:25", "text": "キャラクターは徐々に重要なことを忘れていく"}, {"type": "subtitle", "time": 10287.309, "timestamp": "02:51:27", "text": "情報能力をあまり取らないと"}, {"type": "subtitle", "time": 10290.469, "timestamp": "02:51:30", "text": "長さ。長期間の休憩を取る場合"}, {"type": "subtitle", "time": 10299.59, "timestamp": "02:51:39", "text": "ニース。ホイールには何が載っていますか？えーと、友達"}, {"type": "subtitle", "time": 10302.19, "timestamp": "02:51:42", "text": "私の"}, {"type": "subtitle", "time": 10318.389, "timestamp": "02:51:58", "text": "えーっと、座って、リラックスして、待って、1回飛ばして、"}]
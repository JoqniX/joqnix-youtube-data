[{"type": "subtitle", "time": 14825.63, "timestamp": "04:07:05", "text": "から？忘れた。それは"}, {"type": "subtitle", "time": 14829.189, "timestamp": "04:07:09", "text": "それ？その番組が見たい。わかった。これは"}, {"type": "subtitle", "time": 14831.99, "timestamp": "04:07:11", "text": "昨日。いつ観たっけ？ああ、"}, {"type": "subtitle", "time": 14833.79, "timestamp": "04:07:13", "text": "神。"}, {"type": "subtitle", "time": 14837.229, "timestamp": "04:07:17", "text": "よし、角度の後だと思う"}, {"type": "subtitle", "time": 14839.59, "timestamp": "04:07:19", "text": "もの。ああ、わかりました。わかった。わかった。手に入れた"}, {"type": "subtitle", "time": 14848.11, "timestamp": "04:07:28", "text": "これ。見るべきか"}, {"type": "subtitle", "time": 14852.63, "timestamp": "04:07:32", "text": "配信で配信するか、それとも単に送信した方がいいでしょうか"}, {"type": "subtitle", "time": 14854.55, "timestamp": "04:07:34", "text": "リンクは？"}, {"type": "subtitle", "time": 14856.07, "timestamp": "04:07:36", "text": "あのね？一緒に見ましょう。"}, {"type": "subtitle", "time": 14859.99, "timestamp": "04:07:39", "text": "うん、これはショットだ。これはおかしい。する"}, {"type": "subtitle", "time": 14862.71, "timestamp": "04:07:42", "text": "人間がひげを生やす理由を不思議に思ったことはありませんか？"}, {"type": "subtitle", "time": 14864.309, "timestamp": "04:07:44", "text": "私たちにはひげを生やす能力があります。"}, {"type": "subtitle", "time": 14866.469, "timestamp": "04:07:46", "text": "右？そして、成長しない人もいる。"}, {"type": "subtitle", "time": 14868.63, "timestamp": "04:07:48", "text": "あごひげや顔の毛は一切なし。アジア人、"}, {"type": "subtitle", "time": 14870.07, "timestamp": "04:07:50", "text": "ええ、アジア人や女性も"}, {"type": "subtitle", "time": 14871.429, "timestamp": "04:07:51", "text": "具体的には、それらは実際には成長しない"}, {"type": "subtitle", "time": 14873.51, "timestamp": "04:07:53", "text": "顔の毛のことですよね？実際には"}, {"type": "subtitle", "time": 14875.99, "timestamp": "04:07:55", "text": "顔の毛の科学的目的と"}, {"type": "subtitle", "time": 14877.99, "timestamp": "04:07:57", "text": "一般的に、ひげについて。これは白兵戦用です"}]
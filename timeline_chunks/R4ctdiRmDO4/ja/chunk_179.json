[{"type": "subtitle", "time": 10740.11, "timestamp": "02:59:00", "text": "ずっと昔、私は子役スターだった頃、"}, {"type": "subtitle", "time": 10753.349, "timestamp": "02:59:13", "text": "うん。ああ、なんてこった。それは"}, {"type": "subtitle", "time": 10755.91, "timestamp": "02:59:15", "text": "恥ずかしい。よし、もう一度回転させて。"}, {"type": "subtitle", "time": 10766.79, "timestamp": "02:59:26", "text": "みんなにあなたのホーム画面を見せてあげましょう。兄弟、"}, {"type": "subtitle", "time": 10769.03, "timestamp": "02:59:29", "text": "ロック画面じゃなくてよかった。"}, {"type": "subtitle", "time": 10771.429, "timestamp": "02:59:31", "text": "ロック画面には私の新しいモデルが表示されています"}, {"type": "subtitle", "time": 10773.389, "timestamp": "02:59:33", "text": "私はそうするべきではない"}, {"type": "subtitle", "time": 10776.87, "timestamp": "02:59:36", "text": "明らかにしなければならないから、私は法的に"}, {"type": "subtitle", "time": 10779.309, "timestamp": "02:59:39", "text": "それを見せる義務がある"}, {"type": "subtitle", "time": 10782.55, "timestamp": "02:59:42", "text": "お金が貯まるまで公共の場で"}, {"type": "subtitle", "time": 10785.75, "timestamp": "02:59:45", "text": "ライセンス。ええと、それで私は秘密保持契約を破ることになります。私"}, {"type": "subtitle", "time": 10788.79, "timestamp": "02:59:48", "text": "そう、法律関係のことがたくさんある"}, {"type": "subtitle", "time": 10793.429, "timestamp": "02:59:53", "text": "起こったことなので、見せてはいけないんです。"}, {"type": "subtitle", "time": 10797.67, "timestamp": "02:59:57", "text": "ええ、もし私たちが目標を達成していたら"}]
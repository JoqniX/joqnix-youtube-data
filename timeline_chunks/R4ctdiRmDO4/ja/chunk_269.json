[{"type": "subtitle", "time": 16141.51, "timestamp": "04:29:01", "text": "ええ、状況的なことに関しては、"}, {"type": "subtitle", "time": 16144.71, "timestamp": "04:29:04", "text": "たくさんあるからカバーするよ"}, {"type": "subtitle", "time": 16146.11, "timestamp": "04:29:06", "text": "の"}, {"type": "subtitle", "time": 16148.63, "timestamp": "04:29:08", "text": "私が考えているすべての会話"}, {"type": "subtitle", "time": 16150.469, "timestamp": "04:29:10", "text": "何かするべきだ。でも、私は"}, {"type": "subtitle", "time": 16153.11, "timestamp": "04:29:13", "text": "悪い子たちだと思う。どんなペットかわかりません"}, {"type": "subtitle", "time": 16159.67, "timestamp": "04:29:19", "text": "触れない。ロールアップが必要です"}, {"type": "subtitle", "time": 16161.269, "timestamp": "04:29:21", "text": "草。"}, {"type": "subtitle", "time": 16163.79, "timestamp": "04:29:23", "text": "「ああ、なんてことだ」はカットしてください。"}, {"type": "subtitle", "time": 16166.469, "timestamp": "04:29:26", "text": "草。ああ、神様。私たちは皆触れ合う必要がある"}, {"type": "subtitle", "time": 16169.49, "timestamp": "04:29:29", "text": "今は草が生えている。おお"}]
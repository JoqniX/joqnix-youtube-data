[{"type": "subtitle", "time": 21362.15, "timestamp": "05:56:02", "text": "スケジュール？いいえ、私はほとんどいつも遅刻しています"}, {"type": "subtitle", "time": 21365.99, "timestamp": "05:56:05", "text": "すべてのストリーム。うん、それもそうだね。そして"}, {"type": "subtitle", "time": 21368.75, "timestamp": "05:56:08", "text": "私はそう思わない"}, {"type": "subtitle", "time": 21371.51, "timestamp": "05:56:11", "text": "知る。つまり、時間管理のようなものですね。"}, {"type": "subtitle", "time": 21373.75, "timestamp": "05:56:13", "text": "あれこれとスケジュールのことを始めました"}, {"type": "subtitle", "time": 21377.19, "timestamp": "05:56:17", "text": "ストリームを使ってテストし、実験してみてください。"}, {"type": "subtitle", "time": 21378.788, "timestamp": "05:56:18", "text": "すると、うまくいかなかった。だから私はこう思う"}, {"type": "subtitle", "time": 21382.07, "timestamp": "05:56:22", "text": "実際に効果があるかどうか心配です"}, {"type": "subtitle", "time": 21385.708, "timestamp": "05:56:25", "text": "私の日々のスケジュール"}, {"type": "subtitle", "time": 21389.47, "timestamp": "05:56:29", "text": "詰め込んで、すべてを詰め込まないでください"}, {"type": "subtitle", "time": 21393.75, "timestamp": "05:56:33", "text": "日。えっと、私はメインを忘れるために奴隷でした"}, {"type": "subtitle", "time": 21403.44, "timestamp": "05:56:43", "text": "ああ、それも無駄なことだ。"}, {"type": "subtitle", "time": 21407.67, "timestamp": "05:56:47", "text": "[音楽]"}, {"type": "subtitle", "time": 21417.67, "timestamp": "05:56:57", "text": "自分。私は前後に揺れている"}, {"type": "subtitle", "time": 21419.59, "timestamp": "05:56:59", "text": "私に行くよ。待って、私は後ろに体を揺らしてないよ。"}]
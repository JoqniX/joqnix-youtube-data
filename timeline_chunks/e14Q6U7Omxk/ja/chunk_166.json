[{"type": "subtitle", "time": 9961.59, "timestamp": "02:46:01", "text": "終わらせるんだよね？一つずつやっていく"}, {"type": "subtitle", "time": 9963.59, "timestamp": "02:46:03", "text": "昔やっていたように"}, {"type": "subtitle", "time": 9966.389, "timestamp": "02:46:06", "text": "1日1人または2人から始め、"}, {"type": "subtitle", "time": 9968.23, "timestamp": "02:46:08", "text": "一日中、あるいは半日を過ごす"}, {"type": "subtitle", "time": 9971.75, "timestamp": "02:46:11", "text": "1日2時間から3時間、1人で。"}, {"type": "subtitle", "time": 9973.99, "timestamp": "02:46:13", "text": "うん。"}, {"type": "subtitle", "time": 9978.63, "timestamp": "02:46:18", "text": "今はこうできるから、もっといい"}, {"type": "subtitle", "time": 9980.71, "timestamp": "02:46:20", "text": "直前にできたつながり"}, {"type": "subtitle", "time": 9982.63, "timestamp": "02:46:22", "text": "速くて素早い、こんにちは、これは"}, {"type": "subtitle", "time": 9984.63, "timestamp": "02:46:24", "text": "これは彼が"}, {"type": "subtitle", "time": 9986.87, "timestamp": "02:46:26", "text": "これが私のやっていることで、"}, {"type": "subtitle", "time": 9988.63, "timestamp": "02:46:28", "text": "調子はどうですか、そして、"}, {"type": "subtitle", "time": 9990.95, "timestamp": "02:46:30", "text": "それで、これであなたは楽しめるでしょう"}, {"type": "subtitle", "time": 9993.51, "timestamp": "02:46:33", "text": "みんなと楽しい時間を過ごせます"}, {"type": "subtitle", "time": 9995.429, "timestamp": "02:46:35", "text": "うん"}, {"type": "subtitle", "time": 9998.15, "timestamp": "02:46:38", "text": "すべてにプラスポイントがある、まあいくつかは"}, {"type": "subtitle", "time": 10000.23, "timestamp": "02:46:40", "text": "それについては、まあ、とにかく、私は"}, {"type": "subtitle", "time": 10002.87, "timestamp": "02:46:42", "text": "君と一緒ならすべてうまくいくよ"}, {"type": "subtitle", "time": 10005.19, "timestamp": "02:46:45", "text": "えっと、スケジュールを見せてくれたとき"}, {"type": "subtitle", "time": 10007.11, "timestamp": "02:46:47", "text": "例えば、夜間の授業スケジュールなど。ああ、"}, {"type": "subtitle", "time": 10011.429, "timestamp": "02:46:51", "text": "神。私も心臓発作を起こしそうになったよ。"}, {"type": "subtitle", "time": 10013.83, "timestamp": "02:46:53", "text": "うん。すべてが紫色で"}, {"type": "subtitle", "time": 10015.269, "timestamp": "02:46:55", "text": "それで私は「くそ、彼は行くんだ」と思った"}, {"type": "subtitle", "time": 10019.269, "timestamp": "02:46:59", "text": "そんなに勉強するなんて。」どれ？えっと、私は"}]
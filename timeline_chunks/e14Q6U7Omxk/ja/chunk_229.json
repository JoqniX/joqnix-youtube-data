[{"type": "subtitle", "time": 13742.469, "timestamp": "03:49:02", "text": "それは日本でとても大きな出来事だった。"}, {"type": "subtitle", "time": 13744.87, "timestamp": "03:49:04", "text": "それは知りませんでした。ああ、そうだ"}, {"type": "subtitle", "time": 13747.03, "timestamp": "03:49:07", "text": "無頓着に。"}, {"type": "subtitle", "time": 13749.83, "timestamp": "03:49:09", "text": "ええ、まあ、そんな感じです。ほとんどがそうです。それ"}, {"type": "subtitle", "time": 13751.83, "timestamp": "03:49:11", "text": "生活が楽になるんだよ。何が"}, {"type": "subtitle", "time": 13754.229, "timestamp": "03:49:14", "text": "無頓着？"}, {"type": "subtitle", "time": 13765.269, "timestamp": "03:49:25", "text": "多分"}, {"type": "subtitle", "time": 13769.75, "timestamp": "03:49:29", "text": "am は、えーっと、えーっと"}, {"type": "subtitle", "time": 13771.91, "timestamp": "03:49:31", "text": "あなたがそこにいても私は気にしません"}, {"type": "subtitle", "time": 13774.79, "timestamp": "03:49:34", "text": "気にしないタイプのこと。うんうんうん"}, {"type": "subtitle", "time": 13776.79, "timestamp": "03:49:36", "text": "通り過ぎても彼らは気にしないし"}, {"type": "subtitle", "time": 13778.63, "timestamp": "03:49:38", "text": "もの。ほとんどのジャンプルは"}, {"type": "subtitle", "time": 13780.469, "timestamp": "03:49:40", "text": "人はそういうものだ。彼らは気にしない。"}, {"type": "subtitle", "time": 13783.11, "timestamp": "03:49:43", "text": "彼らは店を開けたままにしていた"}, {"type": "subtitle", "time": 13787.429, "timestamp": "03:49:47", "text": "まだ誰も入っていないような感じ。私は思う"}, {"type": "subtitle", "time": 13790.63, "timestamp": "03:49:50", "text": "いや、気にしない。学ぶべき良いこと"}, {"type": "subtitle", "time": 13793.189, "timestamp": "03:49:53", "text": "人々"}, {"type": "subtitle", "time": 13794.87, "timestamp": "03:49:54", "text": "彼らはあまり話さない。わからない"}, {"type": "subtitle", "time": 13797.189, "timestamp": "03:49:57", "text": "男。私は彼らとは一切話さない。彼らは話すのか"}]
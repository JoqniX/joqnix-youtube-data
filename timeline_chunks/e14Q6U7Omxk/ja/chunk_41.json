[{"type": "subtitle", "time": 2462.39, "timestamp": "00:41:02", "text": "プリン。そういう仕組みではないんです。あなた"}, {"type": "subtitle", "time": 2464.309, "timestamp": "00:41:04", "text": "は"}, {"type": "subtitle", "time": 2466.23, "timestamp": "00:41:06", "text": "パティオ"}, {"type": "subtitle", "time": 2468.87, "timestamp": "00:41:08", "text": "たくさん。"}, {"type": "subtitle", "time": 2471.349, "timestamp": "00:41:11", "text": "私たちのDiscordサーバーでは、"}, {"type": "subtitle", "time": 2473.829, "timestamp": "00:41:13", "text": "多くの人が"}, {"type": "subtitle", "time": 2476.95, "timestamp": "00:41:16", "text": "ヘッドパッドのギフトとかわいいかわいい"}, {"type": "subtitle", "time": 2480.79, "timestamp": "00:41:20", "text": "プレゼントはまさにその通り、私は"}, {"type": "subtitle", "time": 2483.91, "timestamp": "00:41:23", "text": "君たちの努力に報いるために、みんなにヘッドショットをあげるよ"}, {"type": "subtitle", "time": 2487.43, "timestamp": "00:41:27", "text": "まあ、大変な仕事と、あなたが"}, {"type": "subtitle", "time": 2488.69, "timestamp": "00:41:28", "text": "する。"}, {"type": "subtitle", "time": 2496.309, "timestamp": "00:41:36", "text": "そうですね、"}, {"type": "subtitle", "time": 2499.109, "timestamp": "00:41:39", "text": "えーと、もう一つ、もう一つ"}, {"type": "subtitle", "time": 2502.87, "timestamp": "00:41:42", "text": "もの。えっと、私が言ったことは、私が言ったことです。おお"}, {"type": "subtitle", "time": 2504.79, "timestamp": "00:41:44", "text": "うん。えっと、私は"}, {"type": "subtitle", "time": 2516.23, "timestamp": "00:41:56", "text": "そう、ここにいることと"}]
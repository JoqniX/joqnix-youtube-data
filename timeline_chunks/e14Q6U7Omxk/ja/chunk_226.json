[{"type": "subtitle", "time": 13560.07, "timestamp": "03:46:00", "text": "まあ、そうですね。ええ、地元のアカデミーは"}, {"type": "subtitle", "time": 13563.269, "timestamp": "03:46:03", "text": "彼らは「うん」って感じだった。彼らは彼らは"}, {"type": "subtitle", "time": 13566.229, "timestamp": "03:46:06", "text": "彼らにとっては大変だったようですが、"}, {"type": "subtitle", "time": 13569.59, "timestamp": "03:46:09", "text": "学生が続けられなかったため補償された"}, {"type": "subtitle", "time": 13572.389, "timestamp": "03:46:12", "text": "7月は正しいので、彼らはそれを補うために"}, {"type": "subtitle", "time": 13575.83, "timestamp": "03:46:15", "text": "N4コースは通常無料です"}, {"type": "subtitle", "time": 13578.55, "timestamp": "03:46:18", "text": "コースは高額になるはず"}, {"type": "subtitle", "time": 13581.91, "timestamp": "03:46:21", "text": "すでにN5だったと思うけど、30払わなきゃいけなかったと思う"}, {"type": "subtitle", "time": 13583.91, "timestamp": "03:46:23", "text": "それ"}, {"type": "subtitle", "time": 13587.67, "timestamp": "03:46:27", "text": "そしてN4では、"}, {"type": "subtitle", "time": 13589.99, "timestamp": "03:46:29", "text": "お金は30か40くらい増やすべきだ"}, {"type": "subtitle", "time": 13592.95, "timestamp": "03:46:32", "text": "あるいは何か何か、それに加えて彼らは"}, {"type": "subtitle", "time": 13595.99, "timestamp": "03:46:35", "text": "N3を少しだけお渡しします"}, {"type": "subtitle", "time": 13599.99, "timestamp": "03:46:39", "text": "N3コースの入門レベルのクラスも"}, {"type": "subtitle", "time": 13603.67, "timestamp": "03:46:43", "text": "4月前にN4を終えた後"}, {"type": "subtitle", "time": 13607.269, "timestamp": "03:46:47", "text": "行進。つまり、全体として"}, {"type": "subtitle", "time": 13610.79, "timestamp": "03:46:50", "text": "費用はもっとかかりますが、彼らは"}, {"type": "subtitle", "time": 13613.59, "timestamp": "03:46:53", "text": "無料で提供するのは、"}, {"type": "subtitle", "time": 13617.03, "timestamp": "03:46:57", "text": "7月に行って、みんなを連れて行く予定"}, {"type": "subtitle", "time": 13619.349, "timestamp": "03:46:59", "text": "全て支払いを済ませた。彼らは最善を尽くした"}]
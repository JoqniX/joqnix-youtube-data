[{"type": "subtitle", "time": 3062.39, "timestamp": "00:51:02", "text": "それまで"}, {"type": "subtitle", "time": 3065.27, "timestamp": "00:51:05", "text": "えっと、これはかわいい"}, {"type": "subtitle", "time": 3067.99, "timestamp": "00:51:07", "text": "新しい方法を見つけた人たち"}, {"type": "subtitle", "time": 3072.63, "timestamp": "00:51:12", "text": "チューブをもっと面白くするために"}, {"type": "subtitle", "time": 3075.43, "timestamp": "00:51:15", "text": "クールクール"}, {"type": "subtitle", "time": 3079.67, "timestamp": "00:51:19", "text": "一般公開された。うん。うん。ともかく、"}, {"type": "subtitle", "time": 3083.19, "timestamp": "00:51:23", "text": "配信を長引かせるつもりはありません。私はしないでしょう"}, {"type": "subtitle", "time": 3087.829, "timestamp": "00:51:27", "text": "えーっと、皆さんに時間を盗んだような感じです。"}, {"type": "subtitle", "time": 3092.15, "timestamp": "00:51:32", "text": "では、また皆さんに"}, {"type": "subtitle", "time": 3096.15, "timestamp": "00:51:36", "text": "来て、それから、私の配信の後"}, {"type": "subtitle", "time": 3099.43, "timestamp": "00:51:39", "text": "最後に、水分補給を忘れないでください。"}, {"type": "subtitle", "time": 3104.95, "timestamp": "00:51:44", "text": "食事を摂りなさい。健康に気をつけてください。そしてまた"}, {"type": "subtitle", "time": 3107.51, "timestamp": "00:51:47", "text": "えっと、もしあなたがサポートしたいなら"}, {"type": "subtitle", "time": 3110.39, "timestamp": "00:51:50", "text": "他の配信者もどうぞどうぞ"}, {"type": "subtitle", "time": 3114.309, "timestamp": "00:51:54", "text": "そして彼らを支援し、彼らに頭を与え、"}, {"type": "subtitle", "time": 3117.109, "timestamp": "00:51:57", "text": "または温かい人とのチャットのために"}]
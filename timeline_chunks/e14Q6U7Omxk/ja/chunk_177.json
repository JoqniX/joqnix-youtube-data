[{"type": "subtitle", "time": 10621.67, "timestamp": "02:57:01", "text": "そのアクセント、私はそのアクセントを理解します"}, {"type": "subtitle", "time": 10623.75, "timestamp": "02:57:03", "text": "ヒマチ、それはヒンディー語だけど違う"}, {"type": "subtitle", "time": 10626.15, "timestamp": "02:57:06", "text": "アクセントって、パンジャブ語でさえも"}, {"type": "subtitle", "time": 10636.55, "timestamp": "02:57:16", "text": "[音楽]"}, {"type": "subtitle", "time": 10638.15, "timestamp": "02:57:18", "text": "良いか悪いかはわからないけど、"}, {"type": "subtitle", "time": 10641.03, "timestamp": "02:57:21", "text": "大丈夫です。平均的なことだが、"}, {"type": "subtitle", "time": 10643.429, "timestamp": "02:57:23", "text": "考えてみてください、この時点では、半分の人が"}, {"type": "subtitle", "time": 10644.95, "timestamp": "02:57:24", "text": "我々はいくつかのことをしているが、その半分は"}, {"type": "subtitle", "time": 10647.269, "timestamp": "02:57:27", "text": "他のことをしている。そして何らかの理由で、"}, {"type": "subtitle", "time": 10649.51, "timestamp": "02:57:29", "text": "なぜコミュニティ全体が"}, {"type": "subtitle", "time": 10651.51, "timestamp": "02:57:31", "text": "彼らはヒンディー語で話すのが好きではない"}, {"type": "subtitle", "time": 10654.55, "timestamp": "02:57:34", "text": "人々がチャンネルを好まないのは、"}, {"type": "subtitle", "time": 10657.11, "timestamp": "02:57:37", "text": "時計。ええ、誰も見ていませんよ。もし"}, {"type": "subtitle", "time": 10659.91, "timestamp": "02:57:39", "text": "あなたはヒンディー語で話しているんですよね？ああ、でも"}, {"type": "subtitle", "time": 10663.19, "timestamp": "02:57:43", "text": "ヴァコニの人々はそうするし、そう、もっと"}, {"type": "subtitle", "time": 10665.269, "timestamp": "02:57:45", "text": "ヒンディー語を話す人たちが来るんですよね？ヒンディー語、"}, {"type": "subtitle", "time": 10669.349, "timestamp": "02:57:49", "text": "ヒンディー語を話す人々。はい。うん。そこには"}, {"type": "subtitle", "time": 10672.07, "timestamp": "02:57:52", "text": "3人くらいだと思うけど、"}, {"type": "subtitle", "time": 10674.15, "timestamp": "02:57:54", "text": "そのチャンネル。どれかわからない"}, {"type": "subtitle", "time": 10676.389, "timestamp": "02:57:56", "text": "そうだった。まるで彼ら全員が"}, {"type": "subtitle", "time": 10679.11, "timestamp": "02:57:59", "text": "ヒンディー語を話します。彼らのほとんどが"}]
[{"type": "subtitle", "time": 13382.15, "timestamp": "03:43:02", "text": "えっと、"}, {"type": "subtitle", "time": 13384.55, "timestamp": "03:43:04", "text": "どう言えばいいですか？えっと、私は好きだったと思います"}, {"type": "subtitle", "time": 13387.75, "timestamp": "03:43:07", "text": "私の考えの間英語ですが、"}, {"type": "subtitle", "time": 13390.309, "timestamp": "03:43:10", "text": "社会学の先生は私たちのクラスの先生でした"}, {"type": "subtitle", "time": 13392.309, "timestamp": "03:43:12", "text": "教師なので、社会学が好きです。私は"}, {"type": "subtitle", "time": 13395.59, "timestamp": "03:43:15", "text": "社会学にとても注意を払っているが、私は"}, {"type": "subtitle", "time": 13398.469, "timestamp": "03:43:18", "text": "寝てしまった。"}, {"type": "subtitle", "time": 13401.75, "timestamp": "03:43:21", "text": "だって私は昔は午前5時に寝てたし"}, {"type": "subtitle", "time": 13403.59, "timestamp": "03:43:23", "text": "物、そして私は当時私は"}, {"type": "subtitle", "time": 13407.11, "timestamp": "03:43:27", "text": "薬とか色々あって"}, {"type": "subtitle", "time": 13409.67, "timestamp": "03:43:29", "text": "後遺症。だから私は昼寝をしていた"}, {"type": "subtitle", "time": 13413.11, "timestamp": "03:43:33", "text": "午前から午後までの授業、または"}, {"type": "subtitle", "time": 13415.189, "timestamp": "03:43:35", "text": "何か。"}, {"type": "subtitle", "time": 13418.309, "timestamp": "03:43:38", "text": "それで、先生と生徒たち"}, {"type": "subtitle", "time": 13420.15, "timestamp": "03:43:40", "text": "みんなは私を眠れる森の美女と呼ぶか、"}, {"type": "subtitle", "time": 13423.349, "timestamp": "03:43:43", "text": "何か、だって私は寝ているから"}, {"type": "subtitle", "time": 13426.63, "timestamp": "03:43:46", "text": "クラス。ええ、そうですね。専攻は何ですか？"}, {"type": "subtitle", "time": 13429.59, "timestamp": "03:43:49", "text": "カレッジ？私は英語を勉強しています"}, {"type": "subtitle", "time": 13431.67, "timestamp": "03:43:51", "text": "文学優等学位。私はignoをやっています"}, {"type": "subtitle", "time": 13433.189, "timestamp": "03:43:53", "text": "あれ。"}, {"type": "subtitle", "time": 13435.189, "timestamp": "03:43:55", "text": "ああ、彼はかなり頭がいいんだよ。"}, {"type": "subtitle", "time": 13438.55, "timestamp": "03:43:58", "text": "彼は、私は、いいえ、いいえ、いいえ、いいえ。私にさせて"}]
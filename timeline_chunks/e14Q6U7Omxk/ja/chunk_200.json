[{"type": "subtitle", "time": 12002.07, "timestamp": "03:20:02", "text": "情報？ええ、もちろんです。えっと、こんにちは"}, {"type": "subtitle", "time": 12005.429, "timestamp": "03:20:05", "text": "私のスポーツマンネック。だから私はこれをやっている"}, {"type": "subtitle", "time": 12010.87, "timestamp": "03:20:10", "text": "ジョッカソンをするために、えっと、彼は"}, {"type": "subtitle", "time": 12014.469, "timestamp": "03:20:14", "text": "バングラデシュ人？いいえ、違います。私は持っている"}, {"type": "subtitle", "time": 12017.03, "timestamp": "03:20:17", "text": "バングラデシュの友人たち。彼らはベンガル語を話す。"}, {"type": "subtitle", "time": 12020.389, "timestamp": "03:20:20", "text": "私には理解できない。うん"}, {"type": "subtitle", "time": 12025.349, "timestamp": "03:20:25", "text": "えーと、ジョアソンっていうのは、えーとイベントなんだけど"}, {"type": "subtitle", "time": 12027.429, "timestamp": "03:20:27", "text": "それはむしろチャンネルイベントのようなもので、私はそれをそう呼んでいます"}, {"type": "subtitle", "time": 12029.83, "timestamp": "03:20:29", "text": "私の持ち物のために。それはむしろ"}, {"type": "subtitle", "time": 12032.389, "timestamp": "03:20:32", "text": "サバタソン、寄付、またはマラソン。"}, {"type": "subtitle", "time": 12034.79, "timestamp": "03:20:34", "text": "あなたはこれらの3つの用語を聞いたことがあるかもしれません"}, {"type": "subtitle", "time": 12037.269, "timestamp": "03:20:37", "text": "Twitchで配信を見ている場合、あるいは"}, {"type": "subtitle", "time": 12039.19, "timestamp": "03:20:39", "text": "時々、それが行われているのを見ることができます"}, {"type": "subtitle", "time": 12042.229, "timestamp": "03:20:42", "text": "YouTubeも同様です。同じ３つのもの"}, {"type": "subtitle", "time": 12046.07, "timestamp": "03:20:46", "text": "これらは私のイベント「チャソン」で行われました。私"}, {"type": "subtitle", "time": 12048.229, "timestamp": "03:20:48", "text": "ユニークにしたかっただけなんだ、えっと、私の"}, {"type": "subtitle", "time": 12050.79, "timestamp": "03:20:50", "text": "そこに名前を入れてください。それでジョアトン。"}, {"type": "subtitle", "time": 12053.59, "timestamp": "03:20:53", "text": "だから、それは私が"}, {"type": "subtitle", "time": 12055.349, "timestamp": "03:20:55", "text": "クラウドファンディング"}, {"type": "subtitle", "time": 12057.99, "timestamp": "03:20:57", "text": "私のモデルに関するもの。私はVTuberをして​​います"}]
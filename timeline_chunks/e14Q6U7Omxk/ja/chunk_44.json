[{"type": "subtitle", "time": 2641.03, "timestamp": "00:44:01", "text": "ああ、それから、今日来てくれたオンザンにも感謝します。"}, {"type": "subtitle", "time": 2644.23, "timestamp": "00:44:04", "text": "うん、僕とハニーも来てくれてありがとう。"}, {"type": "subtitle", "time": 2651.589, "timestamp": "00:44:11", "text": "ああ、もし私が何人かを呼ぶのを忘れていたら"}, {"type": "subtitle", "time": 2654.069, "timestamp": "00:44:14", "text": "今日話した人の名前"}, {"type": "subtitle", "time": 2656.15, "timestamp": "00:44:16", "text": "チャット、"}, {"type": "subtitle", "time": 2658.95, "timestamp": "00:44:18", "text": "本当に本当に感謝しています"}, {"type": "subtitle", "time": 2677.589, "timestamp": "00:44:37", "text": "ということで、次の配信は"}, {"type": "subtitle", "time": 2680.309, "timestamp": "00:44:40", "text": "土曜日午後3時30分IST。私は"}, {"type": "subtitle", "time": 2682.79, "timestamp": "00:44:42", "text": "更新中"}, {"type": "subtitle", "time": 2686.79, "timestamp": "00:44:46", "text": "えっと、Twitchのスケジュールのことですよね？"}, {"type": "subtitle", "time": 2690.069, "timestamp": "00:44:50", "text": "Twitchで配信中。後で編集します。えっと"}, {"type": "subtitle", "time": 2692.71, "timestamp": "00:44:52", "text": "うん、もし私のTwitchチャットに行けば"}, {"type": "subtitle", "time": 2695.43, "timestamp": "00:44:55", "text": "Twitch プロフィールには、"}, {"type": "subtitle", "time": 2697.99, "timestamp": "00:44:57", "text": "スケジュールと呼ばれるセクション。"}]
[{"type": "subtitle", "time": 2883.829, "timestamp": "00:48:03", "text": "カレンダー。それに対して。私は見てきました、私は"}, {"type": "subtitle", "time": 2888.95, "timestamp": "00:48:08", "text": "えっと、彼女の名前は何でしたっけ？寿司息子"}, {"type": "subtitle", "time": 2893.75, "timestamp": "00:48:13", "text": "彼女のあそこでやってください"}, {"type": "subtitle", "time": 2899.19, "timestamp": "00:48:19", "text": "彼女のスケジュールに合わせて。彼女はよくこう付け加えた"}, {"type": "subtitle", "time": 2903.51, "timestamp": "00:48:23", "text": "それを何と呼ぶのですか？"}, {"type": "subtitle", "time": 2905.27, "timestamp": "00:48:25", "text": "彼女はよくこう言ってた。「なんて言うの？」"}, {"type": "subtitle", "time": 2907.829, "timestamp": "00:48:27", "text": "それ？ Googleカレンダーと"}, {"type": "subtitle", "time": 2911.829, "timestamp": "00:48:31", "text": "iOS 2 用の別のものも iOS 用"}, {"type": "subtitle", "time": 2914.23, "timestamp": "00:48:34", "text": "ユーザー。彼らはまた何かするだろう。"}, {"type": "subtitle", "time": 2918.15, "timestamp": "00:48:38", "text": "うん。ということで、それらを私の"}, {"type": "subtitle", "time": 2922.549, "timestamp": "00:48:42", "text": "通知を受け取るために、これも"}, {"type": "subtitle", "time": 2926.23, "timestamp": "00:48:46", "text": "そしてリマインダー"}, {"type": "subtitle", "time": 2929.03, "timestamp": "00:48:49", "text": "忘れないように。"}, {"type": "subtitle", "time": 2931.91, "timestamp": "00:48:51", "text": "おい。こんにちは。それでおしまい。それが私の望みだった"}, {"type": "subtitle", "time": 2935.589, "timestamp": "00:48:55", "text": "今日はそれについて話す。そして"}, {"type": "subtitle", "time": 2939.589, "timestamp": "00:48:59", "text": "ここにいて、私の話を聞いてくれてありがとう。"}]
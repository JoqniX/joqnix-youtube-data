[{"type": "subtitle", "time": 14641.59, "timestamp": "04:04:01", "text": "「他の皆と同じように、自分たちで資金を調達する。」そして彼らは"}, {"type": "subtitle", "time": 14644.309, "timestamp": "04:04:04", "text": "えーと、最後にM&Mのように話すと、"}, {"type": "subtitle", "time": 14647.59, "timestamp": "04:04:07", "text": "知る。 M、そう、それはM&Mステップだ"}, {"type": "subtitle", "time": 14649.99, "timestamp": "04:04:09", "text": "これはスキップすることが本当に重要です"}, {"type": "subtitle", "time": 14653.269, "timestamp": "04:04:13", "text": "ほら、そうだね、君みたいな感じ"}, {"type": "subtitle", "time": 14656.07, "timestamp": "04:04:16", "text": "市場リスクにさらされる場合、"}, {"type": "subtitle", "time": 14658.95, "timestamp": "04:04:18", "text": "投資はあなた自身の意思で行うものです"}, {"type": "subtitle", "time": 14661.03, "timestamp": "04:04:21", "text": "ブローカーを通して投資したい場合は"}, {"type": "subtitle", "time": 14663.51, "timestamp": "04:04:23", "text": "それは、"}, {"type": "subtitle", "time": 14665.269, "timestamp": "04:04:25", "text": "あなた自身。だから、ただ学ぶ方が良い"}, {"type": "subtitle", "time": 14667.67, "timestamp": "04:04:27", "text": "そして自分で学ぶように"}, {"type": "subtitle", "time": 14670.469, "timestamp": "04:04:30", "text": "2年くらいで、"}, {"type": "subtitle", "time": 14673.75, "timestamp": "04:04:33", "text": "あなたへの計画のように"}, {"type": "subtitle", "time": 14675.429, "timestamp": "04:04:35", "text": "リスクやその他諸々を測定する"}, {"type": "subtitle", "time": 14677.91, "timestamp": "04:04:37", "text": "ただ退屈なことだよ、なんで私はただ"}, {"type": "subtitle", "time": 14680.87, "timestamp": "04:04:40", "text": "ええ、つまり、簡単に言うと、"}, {"type": "subtitle", "time": 14684.469, "timestamp": "04:04:44", "text": "いくつか比較して、選択する"}, {"type": "subtitle", "time": 14687.51, "timestamp": "04:04:47", "text": "2～3人くらい違う"}, {"type": "subtitle", "time": 14689.83, "timestamp": "04:04:49", "text": "ミッドキャップ、ラージキャップ、スモールキャップなどのキャップ"}, {"type": "subtitle", "time": 14691.91, "timestamp": "04:04:51", "text": "そして、それらに投資する"}, {"type": "subtitle", "time": 14694.309, "timestamp": "04:04:54", "text": "200ルピーまたは500ルピーごとに体系的に"}, {"type": "subtitle", "time": 14697.269, "timestamp": "04:04:57", "text": "1ヶ月間1つの投資信託で、"}, {"type": "subtitle", "time": 14699.67, "timestamp": "04:04:59", "text": "合計で、例えば5,000から始めるとします"}]
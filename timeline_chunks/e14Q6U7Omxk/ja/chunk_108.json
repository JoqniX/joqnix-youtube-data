[{"type": "subtitle", "time": 6498.709, "timestamp": "01:48:18", "text": "えっと、私は今までレンジをプレイしたことがありません"}, {"type": "subtitle", "time": 6500.229, "timestamp": "01:48:20", "text": "以来"}, {"type": "subtitle", "time": 6503.51, "timestamp": "01:48:23", "text": "実際には、射程距離を気にせずに実行した。"}, {"type": "subtitle", "time": 6511.43, "timestamp": "01:48:31", "text": "うん。うん。うん。"}, {"type": "subtitle", "time": 6514.87, "timestamp": "01:48:34", "text": "ああ、このゲーム、すごくラグいよ。"}, {"type": "subtitle", "time": 6519.189, "timestamp": "01:48:39", "text": "たとえ全てを低い金額に賭けたとしても。"}, {"type": "subtitle", "time": 6526.07, "timestamp": "01:48:46", "text": "しかし、コードは"}, {"type": "subtitle", "time": 6528.47, "timestamp": "01:48:48", "text": "新しいスキン。ああ、新しいものがたくさんあるよ"}, {"type": "subtitle", "time": 6532.95, "timestamp": "01:48:52", "text": "スキン。ありえない。"}, {"type": "subtitle", "time": 6536.07, "timestamp": "01:48:56", "text": "それはまるでクールなウィングマンのスキンみたいだ"}, {"type": "subtitle", "time": 6538.709, "timestamp": "01:48:58", "text": "それはズチに似ています。それはヘビです、"}]
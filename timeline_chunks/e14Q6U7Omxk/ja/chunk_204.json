[{"type": "subtitle", "time": 12240.15, "timestamp": "03:24:00", "text": "私のTwitchや"}, {"type": "subtitle", "time": 12242.63, "timestamp": "03:24:02", "text": "YouTube。ええと、YouTubeにはクリップがあります"}, {"type": "subtitle", "time": 12245.03, "timestamp": "03:24:05", "text": "特徴。それで、私はそれらをアップロードしました"}, {"type": "subtitle", "time": 12248.15, "timestamp": "03:24:08", "text": "YouTube のクリップ、実際の映像、"}, {"type": "subtitle", "time": 12251.75, "timestamp": "03:24:11", "text": "すべて、そしてそれが私に"}, {"type": "subtitle", "time": 12254.309, "timestamp": "03:24:14", "text": "「ああ、大丈夫だ」という自信。それは"}, {"type": "subtitle", "time": 12257.349, "timestamp": "03:24:17", "text": "昨年は多くの"}, {"type": "subtitle", "time": 12259.349, "timestamp": "03:24:19", "text": "私の配信に来る人たち"}, {"type": "subtitle", "time": 12261.91, "timestamp": "03:24:21", "text": "友達でさえも、彼らは"}, {"type": "subtitle", "time": 12264.389, "timestamp": "03:24:24", "text": "アスリートが写真をアップロードするみたいで、いい感じ"}, {"type": "subtitle", "time": 12266.469, "timestamp": "03:24:26", "text": "あなたのチャンネルをブーストして"}, {"type": "subtitle", "time": 12268.95, "timestamp": "03:24:28", "text": "すべて、そして私は「いや、私はしたい」"}, {"type": "subtitle", "time": 12270.79, "timestamp": "03:24:30", "text": "私の本来の好みのタイプ。私はほしくない"}, {"type": "subtitle", "time": 12273.91, "timestamp": "03:24:33", "text": "動画クリップなどを投稿するため。それは、私は"}, {"type": "subtitle", "time": 12277.03, "timestamp": "03:24:37", "text": "全然面白くない。私には自己否定があります"}, {"type": "subtitle", "time": 12280.15, "timestamp": "03:24:40", "text": "このインポスター症候群と自己批判"}, {"type": "subtitle", "time": 12282.87, "timestamp": "03:24:42", "text": "自分自身にこだわりすぎている。ええ、気づきました"}, {"type": "subtitle", "time": 12286.15, "timestamp": "03:24:46", "text": "それ。私はずっと前にそれに気づいていました。"}, {"type": "subtitle", "time": 12287.99, "timestamp": "03:24:47", "text": "良い点がたくさんあるにもかかわらず"}, {"type": "subtitle", "time": 12290.07, "timestamp": "03:24:50", "text": "コンテンツ、あなたは楽しむ、あなたはゲームをする、"}, {"type": "subtitle", "time": 12292.95, "timestamp": "03:24:52", "text": "人を運ぶ、与えない"}, {"type": "subtitle", "time": 12295.99, "timestamp": "03:24:55", "text": "あなた自身が十分な信用を持っているように。私は持っています"}, {"type": "subtitle", "time": 12299.03, "timestamp": "03:24:59", "text": "過去にもそれに気づいていた。"}]
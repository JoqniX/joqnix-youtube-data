[{"type": "subtitle", "time": 8941.67, "timestamp": "02:29:01", "text": "そして、私は連絡を取るようにしました"}, {"type": "subtitle", "time": 8946.63, "timestamp": "02:29:06", "text": "今日の先生とか、そういうのが好き。えっと、"}, {"type": "subtitle", "time": 8949.19, "timestamp": "02:29:09", "text": "先生はそう言っていた"}, {"type": "subtitle", "time": 8951.83, "timestamp": "02:29:11", "text": "私たち全員にとって衝撃的な出来事だった。予想外だった"}, {"type": "subtitle", "time": 8954.309, "timestamp": "02:29:14", "text": "拒絶のようにこれが起こる"}, {"type": "subtitle", "time": 8958.07, "timestamp": "02:29:18", "text": "あれ。彼らはその学生に尋ねた"}, {"type": "subtitle", "time": 8961.75, "timestamp": "02:29:21", "text": "えーと、日本に行った同期生"}, {"type": "subtitle", "time": 8965.19, "timestamp": "02:29:25", "text": "昨年4月。彼は「ああ、これは"}, {"type": "subtitle", "time": 8968.469, "timestamp": "02:29:28", "text": "1週間前に知らされ、"}, {"type": "subtitle", "time": 8970.95, "timestamp": "02:29:30", "text": "彼らがなぜ"}, {"type": "subtitle", "time": 8974.389, "timestamp": "02:29:34", "text": "「拒否されたり、そういうこと。」うん、"}, {"type": "subtitle", "time": 8976.23, "timestamp": "02:29:36", "text": "おそらく政治的な問題、"}, {"type": "subtitle", "time": 8979.67, "timestamp": "02:29:39", "text": "まあ、そういうことも起こるんだよ。真実。しかし"}, {"type": "subtitle", "time": 8981.91, "timestamp": "02:29:41", "text": "それは起こってしまった。"}, {"type": "subtitle", "time": 8986.309, "timestamp": "02:29:46", "text": "うん。そして授業のこと、えっと、"}, {"type": "subtitle", "time": 8989.27, "timestamp": "02:29:49", "text": "先生は、それは議論中だと言いました。"}, {"type": "subtitle", "time": 8992.07, "timestamp": "02:29:52", "text": "まだ確認されていません。だから、おそらく私はそうしたのでしょう"}, {"type": "subtitle", "time": 8994.23, "timestamp": "02:29:54", "text": "試験があることも彼に伝えてください。"}, {"type": "subtitle", "time": 8996.309, "timestamp": "02:29:56", "text": "私は授業に出席し、"}, {"type": "subtitle", "time": 8999.429, "timestamp": "02:29:59", "text": "7月から物事が始まるので、集中できます"}]
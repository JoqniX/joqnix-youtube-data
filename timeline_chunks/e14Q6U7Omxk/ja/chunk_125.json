[{"type": "subtitle", "time": 7501.27, "timestamp": "02:05:01", "text": "URL情報を入力してください。私はそうは思わない"}, {"type": "subtitle", "time": 7504.39, "timestamp": "02:05:04", "text": "もちろん。ちょっと待ってください。特性。"}, {"type": "subtitle", "time": 7507.03, "timestamp": "02:05:07", "text": "わかった。えっと、あのやつについて"}, {"type": "subtitle", "time": 7508.87, "timestamp": "02:05:08", "text": "あなたはそれを私に説明しました"}, {"type": "subtitle", "time": 7511.35, "timestamp": "02:05:11", "text": "夜、あのグループのやつ知ってるよね？"}, {"type": "subtitle", "time": 7514.79, "timestamp": "02:05:14", "text": "次にこのリンクを追加し、グループリンクを追加します。"}, {"type": "subtitle", "time": 7519.669, "timestamp": "02:05:19", "text": "うん、それならコントロールがもっと良くなるよ"}, {"type": "subtitle", "time": 7521.99, "timestamp": "02:05:21", "text": "素早く"}, {"type": "subtitle", "time": 7524.95, "timestamp": "02:05:24", "text": "コードを書かないというのは、本当に私に聞いているようなものだ"}, {"type": "subtitle", "time": 7528.629, "timestamp": "02:05:28", "text": "どうしたの？ちょっと待って"}, {"type": "subtitle", "time": 7530.709, "timestamp": "02:05:30", "text": "えーと"}, {"type": "subtitle", "time": 7533.189, "timestamp": "02:05:33", "text": "ああ、まだ男をローテーションさせてるんだけど、どうすればいいかな"}, {"type": "subtitle", "time": 7536.07, "timestamp": "02:05:36", "text": "なぜ私がそうすべきか、あなたは望むのか"}, {"type": "subtitle", "time": 7542.95, "timestamp": "02:05:42", "text": "どうすればいいか教えてください"}, {"type": "subtitle", "time": 7545.109, "timestamp": "02:05:45", "text": "PNGファイルなども作成できますか？私は置くことができます"}, {"type": "subtitle", "time": 7547.189, "timestamp": "02:05:47", "text": "あなたのイメージとか色々だけど、本当に欲しかったのは"}, {"type": "subtitle", "time": 7549.83, "timestamp": "02:05:49", "text": "他の人たちのための他のものだけど、"}, {"type": "subtitle", "time": 7552.39, "timestamp": "02:05:52", "text": "よし。ウェブサイトにアクセスして、"}, {"type": "subtitle", "time": 7555.589, "timestamp": "02:05:55", "text": "Discordアカウントでログインしますか？"}, {"type": "subtitle", "time": 7557.99, "timestamp": "02:05:57", "text": "反応的。私はそうしました"}]
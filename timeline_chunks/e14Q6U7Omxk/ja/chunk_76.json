[{"type": "subtitle", "time": 4560.63, "timestamp": "01:16:00", "text": "知り合って1ヶ月ちょっとの友達"}, {"type": "subtitle", "time": 4564.229, "timestamp": "01:16:04", "text": "あるいは1年以上もの間、1ヶ月ではなく1ヶ月間、"}, {"type": "subtitle", "time": 4566.39, "timestamp": "01:16:06", "text": "もちろん彼らは喜んでやってくれるだろう"}, {"type": "subtitle", "time": 4570.229, "timestamp": "01:16:10", "text": "そして、あなたのために何かをする"}, {"type": "subtitle", "time": 4572.95, "timestamp": "01:16:12", "text": "しかし"}, {"type": "subtitle", "time": 4580.229, "timestamp": "01:16:20", "text": "もし"}, {"type": "subtitle", "time": 4583.27, "timestamp": "01:16:23", "text": "ケースでは"}, {"type": "subtitle", "time": 4585.83, "timestamp": "01:16:25", "text": "そういう場合、それは誰か"}, {"type": "subtitle", "time": 4588.07, "timestamp": "01:16:28", "text": "あなたは知らないし、会ったばかりなのに、"}, {"type": "subtitle", "time": 4589.99, "timestamp": "01:16:29", "text": "あなたを助けようとはしないでしょう"}, {"type": "subtitle", "time": 4608.63, "timestamp": "01:16:48", "text": "ええ、最近はそのことについて考えています"}, {"type": "subtitle", "time": 4611.43, "timestamp": "01:16:51", "text": "ずっと考えていたんです。私は"}]
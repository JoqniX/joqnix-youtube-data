[{"type": "subtitle", "time": 8401.19, "timestamp": "02:20:01", "text": "ごく普通だ。チェックアウト中"}, {"type": "subtitle", "time": 8407.19, "timestamp": "02:20:07", "text": "さて、本物はこちらです。よし。これは"}, {"type": "subtitle", "time": 8412.309, "timestamp": "02:20:12", "text": "ハーバード大学の教授によって検証された。わかった。それで"}, {"type": "subtitle", "time": 8415.429, "timestamp": "02:20:15", "text": "それでは、選択問題です。のために"}, {"type": "subtitle", "time": 8417.99, "timestamp": "02:20:17", "text": "これは、想像するしかない。"}, {"type": "subtitle", "time": 8421.59, "timestamp": "02:20:21", "text": "わかった。あなたは森の中にいます。非常に暗い。私"}, {"type": "subtitle", "time": 8423.51, "timestamp": "02:20:23", "text": "わからない。あなたは森の中にいます。その"}, {"type": "subtitle", "time": 8425.27, "timestamp": "02:20:25", "text": "非常に暗い。あなたは歩いています"}, {"type": "subtitle", "time": 8427.59, "timestamp": "02:20:27", "text": "森の中、背後に何かを感じる"}, {"type": "subtitle", "time": 8430.63, "timestamp": "02:20:30", "text": "あなたの背中。"}, {"type": "subtitle", "time": 8433.99, "timestamp": "02:20:33", "text": "背後に何かを感じて"}, {"type": "subtitle", "time": 8436.309, "timestamp": "02:20:36", "text": "できるだけ速く振り向いてください。"}, {"type": "subtitle", "time": 8438.309, "timestamp": "02:20:38", "text": "よし。できるだけ速く回転してください"}, {"type": "subtitle", "time": 8441.19, "timestamp": "02:20:41", "text": "できる。そして、何が見えますか？"}, {"type": "subtitle", "time": 8447.03, "timestamp": "02:20:47", "text": "異性。 B. 何もなし。 C.A"}, {"type": "subtitle", "time": 8448.469, "timestamp": "02:20:48", "text": "おばけ。"}, {"type": "subtitle", "time": 8453.83, "timestamp": "02:20:53", "text": "Eは野生動物、Eは犬です。"}]
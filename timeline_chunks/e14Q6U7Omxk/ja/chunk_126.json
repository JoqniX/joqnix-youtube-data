[{"type": "subtitle", "time": 7560.31, "timestamp": "02:06:00", "text": "反応的。うん、念のため確認。私にさせて"}, {"type": "subtitle", "time": 7562.229, "timestamp": "02:06:02", "text": "最終決定する前に再確認します"}, {"type": "subtitle", "time": 7565.109, "timestamp": "02:06:05", "text": "ええ、私は"}, {"type": "subtitle", "time": 7570.149, "timestamp": "02:06:10", "text": "えっと、これは私のものなのでコピーします"}, {"type": "subtitle", "time": 7579.669, "timestamp": "02:06:19", "text": "ちょっと待って、私の配信を開いてくれますか？私は"}, {"type": "subtitle", "time": 7582.95, "timestamp": "02:06:22", "text": "配信を見ている。はい。ああ、"}, {"type": "subtitle", "time": 7585.91, "timestamp": "02:06:25", "text": "ちょっと待ってください。ちょっと待ってください。わかった。取る"}, {"type": "subtitle", "time": 7588.629, "timestamp": "02:06:28", "text": "あなたの時間。はい。じゃあ私はこうする"}, {"type": "subtitle", "time": 7591.669, "timestamp": "02:06:31", "text": "ここで何をすればいいですか？"}, {"type": "subtitle", "time": 7593.99, "timestamp": "02:06:33", "text": "遅延が発生しています。あなたは低ノーマルです"}, {"type": "subtitle", "time": 7596.31, "timestamp": "02:06:36", "text": "遅延。ご希望であれば、"}, {"type": "subtitle", "time": 7599.51, "timestamp": "02:06:39", "text": "共有。私がご案内します。心配ない。"}, {"type": "subtitle", "time": 7602.31, "timestamp": "02:06:42", "text": "画面が表示されている間、PC はそれを処理できますか?"}, {"type": "subtitle", "time": 7603.91, "timestamp": "02:06:43", "text": "共有"}, {"type": "subtitle", "time": 7606.95, "timestamp": "02:06:46", "text": "これについて？ああ、できるよ。ああ、そうだ。ああ、そうかもしれない"}, {"type": "subtitle", "time": 7609.43, "timestamp": "02:06:49", "text": "分かりますよ。分かりますよ。うん。えっと、スクロール"}, {"type": "subtitle", "time": 7611.99, "timestamp": "02:06:51", "text": "下。分かりますか"}, {"type": "subtitle", "time": 7614.55, "timestamp": "02:06:54", "text": "明らかな情報源をスクロールダウンします"}, {"type": "subtitle", "time": 7617.75, "timestamp": "02:06:57", "text": "ディスコ反応ウェブサイト、私の"}]
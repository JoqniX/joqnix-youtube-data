[{"type": "subtitle", "time": 3120.87, "timestamp": "00:52:00", "text": "メッセージとかわいい素敵なメッセージ"}, {"type": "subtitle", "time": 3123.829, "timestamp": "00:52:03", "text": "彼らにはかわいい良いものもある"}, {"type": "subtitle", "time": 3127.03, "timestamp": "00:52:07", "text": "時間が経つとわかる"}, {"type": "subtitle", "time": 3131.349, "timestamp": "00:52:11", "text": "じゃあ、旅の幸運を祈ってるよ、ママ"}, {"type": "subtitle", "time": 3132.95, "timestamp": "00:52:12", "text": "先に"}, {"type": "subtitle", "time": 3135.589, "timestamp": "00:52:15", "text": "ええと、残りの一日の旅、"}, {"type": "subtitle", "time": 3138.23, "timestamp": "00:52:18", "text": "夜、夕方、朝、何時でも"}, {"type": "subtitle", "time": 3144.39, "timestamp": "00:52:24", "text": "そしてエンディングに切り替えます"}, {"type": "subtitle", "time": 3150.15, "timestamp": "00:52:30", "text": "それで"}, {"type": "subtitle", "time": 3160.15, "timestamp": "00:52:40", "text": "あなた方一人ひとりがそれに値する"}, {"type": "subtitle", "time": 3162.549, "timestamp": "00:52:42", "text": "温かいヘッドパッド。"}, {"type": "subtitle", "time": 3164.549, "timestamp": "00:52:44", "text": "皆さんの努力とすべての"}, {"type": "subtitle", "time": 3168.39, "timestamp": "00:52:48", "text": "今日やったこと。"}, {"type": "subtitle", "time": 3170.79, "timestamp": "00:52:50", "text": "それでは、お気をつけて。お元気で"}, {"type": "subtitle", "time": 3174.549, "timestamp": "00:52:54", "text": "みんな。とはいえ、これは冗談で、"}]
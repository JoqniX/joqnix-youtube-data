[{"type": "subtitle", "time": 12900.229, "timestamp": "03:35:00", "text": "今頃は。でも、すごく楽しそうですね。"}, {"type": "subtitle", "time": 12902.389, "timestamp": "03:35:02", "text": "うん。きっとショックを受けるでしょう"}, {"type": "subtitle", "time": 12905.11, "timestamp": "03:35:05", "text": "でも、それは本当に楽しそうですね。"}, {"type": "subtitle", "time": 12912.71, "timestamp": "03:35:12", "text": "そういうことなの？"}, {"type": "subtitle", "time": 12916.469, "timestamp": "03:35:16", "text": "実際はもう71歳だよ。違うの？"}, {"type": "subtitle", "time": 12918.07, "timestamp": "03:35:18", "text": "本当に遅刻していないの？"}, {"type": "subtitle", "time": 12921.51, "timestamp": "03:35:21", "text": "もの？えっと、7時30分です。つまり、私たちは"}, {"type": "subtitle", "time": 12924.229, "timestamp": "03:35:24", "text": "えーっと、あと55か10くらい行こう"}, {"type": "subtitle", "time": 12925.99, "timestamp": "03:35:25", "text": "今では数分です。"}, {"type": "subtitle", "time": 12927.91, "timestamp": "03:35:27", "text": "わかった。わかった。確認しているだけです"}, {"type": "subtitle", "time": 12930.63, "timestamp": "03:35:30", "text": "あなたにしたくない、したくない、したくない"}, {"type": "subtitle", "time": 12933.99, "timestamp": "03:35:33", "text": "欲しい。ああ、このステータス。わかった。だから私は"}, {"type": "subtitle", "time": 12936.469, "timestamp": "03:35:36", "text": "遅刻してほしくないんです。うん、それ"}, {"type": "subtitle", "time": 12941.91, "timestamp": "03:35:41", "text": "楽しかった。終日。終日。わかった。"}, {"type": "subtitle", "time": 12943.67, "timestamp": "03:35:43", "text": "ああ、楽しかったよ。だって、君は"}, {"type": "subtitle", "time": 12945.59, "timestamp": "03:35:45", "text": "ストリームで、私は"}, {"type": "subtitle", "time": 12947.83, "timestamp": "03:35:47", "text": "何か。君は俺が好きなものが好きなんだね、君は"}, {"type": "subtitle", "time": 12950.15, "timestamp": "03:35:50", "text": "私が好きなものが好きです。いいね、そしてあなたも"}, {"type": "subtitle", "time": 12952.63, "timestamp": "03:35:52", "text": "自分が好きなものを嫌いになる。そしてそれはただ"}, {"type": "subtitle", "time": 12955.59, "timestamp": "03:35:55", "text": "私は混沌としたタイプで、あなたは"}, {"type": "subtitle", "time": 12958.309, "timestamp": "03:35:58", "text": "いい意味でいいタイプ。"}]
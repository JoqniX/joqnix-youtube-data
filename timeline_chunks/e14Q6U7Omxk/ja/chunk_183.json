[{"type": "subtitle", "time": 10981.429, "timestamp": "03:03:01", "text": "少し話しました"}, {"type": "subtitle", "time": 10984.55, "timestamp": "03:03:04", "text": "日本人のような人と交流するタイプの人"}, {"type": "subtitle", "time": 10988.55, "timestamp": "03:03:08", "text": "人々の側。だから私は「えー、それは"}, {"type": "subtitle", "time": 10991.429, "timestamp": "03:03:11", "text": "それは少し"}, {"type": "subtitle", "time": 10994.15, "timestamp": "03:03:14", "text": "どのように"}, {"type": "subtitle", "time": 10996.55, "timestamp": "03:03:16", "text": "言葉のコラボレーションが見られる"}, {"type": "subtitle", "time": 10998.55, "timestamp": "03:03:18", "text": "人によって異なり、"}, {"type": "subtitle", "time": 11001.91, "timestamp": "03:03:21", "text": "もの。それは私にとって教訓だった。"}, {"type": "subtitle", "time": 11003.67, "timestamp": "03:03:23", "text": "それで私は「うん、それでもやるよ」って思った"}, {"type": "subtitle", "time": 11006.55, "timestamp": "03:03:26", "text": "それ。たとえ拒絶されたり、人々が"}, {"type": "subtitle", "time": 11008.07, "timestamp": "03:03:28", "text": "行けないとしても、私はやるよ。"}, {"type": "subtitle", "time": 11010.23, "timestamp": "03:03:30", "text": "誰でも、誰でも来る準備ができているなら"}, {"type": "subtitle", "time": 11013.349, "timestamp": "03:03:33", "text": "戻ってきて、私の配信に来て、私と話してください。"}, {"type": "subtitle", "time": 11015.75, "timestamp": "03:03:35", "text": "私と一緒にリラックスしたい、または試してみたい"}, {"type": "subtitle", "time": 11018.469, "timestamp": "03:03:38", "text": "私と話して、好きになって"}, {"type": "subtitle", "time": 11020.469, "timestamp": "03:03:40", "text": "たとえそれが彼らにとって初めてのことであっても協力する"}, {"type": "subtitle", "time": 11024.07, "timestamp": "03:03:44", "text": "時間、そうやってどうなるか見てみよう。"}, {"type": "subtitle", "time": 11026.95, "timestamp": "03:03:46", "text": "それで、私はそれをやって、私は予想していなかった"}, {"type": "subtitle", "time": 11030.07, "timestamp": "03:03:50", "text": "1日に複数のコラボレーションを行うような"}, {"type": "subtitle", "time": 11033.91, "timestamp": "03:03:53", "text": "あれの。ええと、最初は1つだけでした"}, {"type": "subtitle", "time": 11036.71, "timestamp": "03:03:56", "text": "1日1人とか、そういうのを"}, {"type": "subtitle", "time": 11039.67, "timestamp": "03:03:59", "text": "少し休みを取って、リラックスしたりしたい"}]
[{"type": "subtitle", "time": 2342.95, "timestamp": "00:39:02", "text": "そして私もチャットを続けるようにします"}, {"type": "subtitle", "time": 2346.55, "timestamp": "00:39:06", "text": "英語のみで"}, {"type": "subtitle", "time": 2349.67, "timestamp": "00:39:09", "text": "日本語では、ほとんどの場合"}, {"type": "subtitle", "time": 2353.03, "timestamp": "00:39:13", "text": "ただおしゃべりしているだけなら、"}, {"type": "subtitle", "time": 2357.03, "timestamp": "00:39:17", "text": "すぐにコピーして、それを"}, {"type": "subtitle", "time": 2360.23, "timestamp": "00:39:20", "text": "Google翻訳で再生して、えっと"}, {"type": "subtitle", "time": 2363.03, "timestamp": "00:39:23", "text": "それに対して返信してください。"}, {"type": "subtitle", "time": 2367.43, "timestamp": "00:39:27", "text": "手間は増えるけど、それでも問題ない。えっと"}, {"type": "subtitle", "time": 2370.39, "timestamp": "00:39:30", "text": "うん"}, {"type": "subtitle", "time": 2374.069, "timestamp": "00:39:34", "text": "でも、でも、できるだけ抑えるようにしてみてください。"}, {"type": "subtitle", "time": 2378.15, "timestamp": "00:39:38", "text": "英語か落ち着いたら、私だけでなくあなたも"}, {"type": "subtitle", "time": 2380.55, "timestamp": "00:39:40", "text": "チャットに参加している他の人も理解できます"}, {"type": "subtitle", "time": 2382.39, "timestamp": "00:39:42", "text": "けれど"}, {"type": "subtitle", "time": 2386.79, "timestamp": "00:39:46", "text": "あるいは、人々は誤解するかもしれない"}, {"type": "subtitle", "time": 2390.55, "timestamp": "00:39:50", "text": "ええ、人々はそれを理解できます"}, {"type": "subtitle", "time": 2393.91, "timestamp": "00:39:53", "text": "もし彼らが理解していないなら"}, {"type": "subtitle", "time": 2396.55, "timestamp": "00:39:56", "text": "言語または"}, {"type": "subtitle", "time": 2399.589, "timestamp": "00:39:59", "text": "彼らは、彼は何者なのかと尋ねるだろう"}]
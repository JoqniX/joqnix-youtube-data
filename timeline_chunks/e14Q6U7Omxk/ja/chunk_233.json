[{"type": "subtitle", "time": 13982.309, "timestamp": "03:53:02", "text": "戦うのが好きなんだよ、男。私はあなたを避けるでしょう"}, {"type": "subtitle", "time": 13984.389, "timestamp": "03:53:04", "text": "可能な限り。そして、もしあなたが"}, {"type": "subtitle", "time": 13986.389, "timestamp": "03:53:06", "text": "戦いよ、私が終わらせる。それはすごいことだ。"}, {"type": "subtitle", "time": 13988.63, "timestamp": "03:53:08", "text": "でも、それは別問題だよ。"}, {"type": "subtitle", "time": 13992.95, "timestamp": "03:53:12", "text": "あなたは優秀です。私たちは元気です。うん。うん。"}, {"type": "subtitle", "time": 13995.99, "timestamp": "03:53:15", "text": "問題は、私はあまりプレイできないということです"}, {"type": "subtitle", "time": 13998.63, "timestamp": "03:53:18", "text": "私のスケジュールと私の"}, {"type": "subtitle", "time": 14001.349, "timestamp": "03:53:21", "text": "兄は普段ノートパソコンで遊んでいる"}, {"type": "subtitle", "time": 14004.87, "timestamp": "03:53:24", "text": "9時過ぎだから、ノートパソコンはもらえない。"}, {"type": "subtitle", "time": 14007.429, "timestamp": "03:53:27", "text": "平。だから今私は準備万端です"}, {"type": "subtitle", "time": 14009.03, "timestamp": "03:53:29", "text": "試験があるので、自由な時間があります。だから私は"}, {"type": "subtitle", "time": 14011.11, "timestamp": "03:53:31", "text": "ストリームとか、そういうものを作るんだよ。"}, {"type": "subtitle", "time": 14013.67, "timestamp": "03:53:33", "text": "だから私は始めたし、"}, {"type": "subtitle", "time": 14017.03, "timestamp": "03:53:37", "text": "動画とか作ってみるよ。ええと、それは"}, {"type": "subtitle", "time": 14019.03, "timestamp": "03:53:39", "text": "待って、"}, {"type": "subtitle", "time": 14022.63, "timestamp": "03:53:42", "text": "こんにちは、私の名前はウェイトです。とんでもない。あなたも"}, {"type": "subtitle", "time": 14025.51, "timestamp": "03:53:45", "text": "スーリヤマン。あれが3人目だ。とんでもない。"}, {"type": "subtitle", "time": 14032.469, "timestamp": "03:53:52", "text": "あなたが3人目だ。ジョクニックスは"}, {"type": "subtitle", "time": 14034.15, "timestamp": "03:53:54", "text": "この人と一緒に配信する予定です。"}, {"type": "subtitle", "time": 14036.309, "timestamp": "03:53:56", "text": "彼の名前はスリャンゲです。私の名前は"}, {"type": "subtitle", "time": 14038.389, "timestamp": "03:53:58", "text": "スーリャンチ。そしてあなたも"}]
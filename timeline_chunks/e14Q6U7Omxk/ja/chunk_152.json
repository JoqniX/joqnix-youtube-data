[{"type": "subtitle", "time": 9121.83, "timestamp": "02:32:01", "text": "なかなか良いゲームだった。退屈だった。 Mと"}, {"type": "subtitle", "time": 9128.79, "timestamp": "02:32:08", "text": "そしてそこから、私は"}, {"type": "subtitle", "time": 9131.83, "timestamp": "02:32:11", "text": "あなたのサーバーか何かでその時に"}, {"type": "subtitle", "time": 9135.83, "timestamp": "02:32:15", "text": "それが私が見た唯一の方法だった"}, {"type": "subtitle", "time": 9137.51, "timestamp": "02:32:17", "text": "自分が話したかどうかはわからない"}, {"type": "subtitle", "time": 9142.15, "timestamp": "02:32:22", "text": "ちゃんとね、でも私はこっそり見てたのよ、ええ、そして"}, {"type": "subtitle", "time": 9144.389, "timestamp": "02:32:24", "text": "そう、私のところにたくさんの人がいた"}, {"type": "subtitle", "time": 9148.07, "timestamp": "02:32:28", "text": "しばらく机に座っていたけど、覚えていない。そうだね。"}, {"type": "subtitle", "time": 9150.469, "timestamp": "02:32:30", "text": "そうそう。私がやったインスタグラムの投稿。"}, {"type": "subtitle", "time": 9153.19, "timestamp": "02:32:33", "text": "ええ、それが理由です。ええ、たくさんの人が"}, {"type": "subtitle", "time": 9155.51, "timestamp": "02:32:35", "text": "何らかの理由で、私がしたことは"}, {"type": "subtitle", "time": 9158.07, "timestamp": "02:32:38", "text": "私はある実験をしてみました。私はこう思った。"}, {"type": "subtitle", "time": 9160.87, "timestamp": "02:32:40", "text": "YouTubeコンテンツだけを取り上げたらどうなるだろう？"}, {"type": "subtitle", "time": 9162.87, "timestamp": "02:32:42", "text": "そして、それを私のインスタグラムではなく、私のインスタグラムに投稿してください。全て"}, {"type": "subtitle", "time": 9165.51, "timestamp": "02:32:45", "text": "右。ちゃんとクレジット表記もしたよ。えっと、私は"}, {"type": "subtitle", "time": 9168.15, "timestamp": "02:32:48", "text": "それを2ヶ月間続けた。 10万ドル手に入れた"}, {"type": "subtitle", "time": 9171.99, "timestamp": "02:32:51", "text": "2ヶ月以内にフォロワーを獲得。そうそう。"}, {"type": "subtitle", "time": 9174.71, "timestamp": "02:32:54", "text": "そしてそれは1週間以内に枯れてしまった。"}, {"type": "subtitle", "time": 9176.79, "timestamp": "02:32:56", "text": "どうやって？"}, {"type": "subtitle", "time": 9178.79, "timestamp": "02:32:58", "text": "さあ、どうだろう。かなり退屈になってきた"}]
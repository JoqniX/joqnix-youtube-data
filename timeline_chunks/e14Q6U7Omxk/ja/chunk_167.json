[{"type": "subtitle", "time": 10021.59, "timestamp": "02:47:01", "text": "知らなかった。ちょうど夜のように"}, {"type": "subtitle", "time": 10024.469, "timestamp": "02:47:04", "text": "スケジュールはこんな感じだった"}, {"type": "subtitle", "time": 10026.71, "timestamp": "02:47:06", "text": "授業のタイミングを示してくれたと思います。"}, {"type": "subtitle", "time": 10029.11, "timestamp": "02:47:09", "text": "毎日。すべてが紫色でした"}, {"type": "subtitle", "time": 10031.83, "timestamp": "02:47:11", "text": "画面を3、4秒ほど表示します"}, {"type": "subtitle", "time": 10035.11, "timestamp": "02:47:15", "text": "秒。授業のタイミングは、"}, {"type": "subtitle", "time": 10037.99, "timestamp": "02:47:17", "text": "病棟だったか、それとも私が"}, {"type": "subtitle", "time": 10040.309, "timestamp": "02:47:20", "text": "そこに？いや、いや、私たちが"}, {"type": "subtitle", "time": 10046.389, "timestamp": "02:47:26", "text": "2か30か何かわからないけど、"}, {"type": "subtitle", "time": 10049.48, "timestamp": "02:47:29", "text": "わからないけど"}, {"type": "subtitle", "time": 10051.269, "timestamp": "02:47:31", "text": "[音楽]"}, {"type": "subtitle", "time": 10053.11, "timestamp": "02:47:33", "text": "今はどんな感じ？物事はどう？"}, {"type": "subtitle", "time": 10055.75, "timestamp": "02:47:35", "text": "今の授業はどんな感じ？"}, {"type": "subtitle", "time": 10057.91, "timestamp": "02:47:37", "text": "これからどうするつもりですか？どうしたの"}, {"type": "subtitle", "time": 10059.91, "timestamp": "02:47:39", "text": "それと共に"}, {"type": "subtitle", "time": 10063.75, "timestamp": "02:47:43", "text": "クラス？彼らはまだ、うーん、うーん"}, {"type": "subtitle", "time": 10065.91, "timestamp": "02:47:45", "text": "N4クラスについての議論、"}, {"type": "subtitle", "time": 10067.75, "timestamp": "02:47:47", "text": "日本語教室。"}, {"type": "subtitle", "time": 10071.11, "timestamp": "02:47:51", "text": "だから、これは新しいレベルのようなものなので、"}, {"type": "subtitle", "time": 10074.389, "timestamp": "02:47:54", "text": "真剣に取り組まなければならないし"}, {"type": "subtitle", "time": 10077.83, "timestamp": "02:47:57", "text": "実際に勉強したり、今から"}]
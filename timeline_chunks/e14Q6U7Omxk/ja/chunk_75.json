[{"type": "subtitle", "time": 4501.75, "timestamp": "01:15:01", "text": "知っている人が数人いるようです"}, {"type": "subtitle", "time": 4508.39, "timestamp": "01:15:08", "text": "それは実際の、実際の米国市民のようなものです"}, {"type": "subtitle", "time": 4511.43, "timestamp": "01:15:11", "text": "あるいは英語を話す人のように"}, {"type": "subtitle", "time": 4513.83, "timestamp": "01:15:13", "text": "あちらで叫んでいる。何人かに会った"}, {"type": "subtitle", "time": 4516.47, "timestamp": "01:15:16", "text": "彼らの"}, {"type": "subtitle", "time": 4519.189, "timestamp": "01:15:19", "text": "彼らと色々一緒に。彼ら全員は"}, {"type": "subtitle", "time": 4520.87, "timestamp": "01:15:20", "text": "誰か"}, {"type": "subtitle", "time": 4523.75, "timestamp": "01:15:23", "text": "中国人の友人。ああ、主に彼らは知っている"}, {"type": "subtitle", "time": 4525.59, "timestamp": "01:15:25", "text": "中国語。"}, {"type": "subtitle", "time": 4528.87, "timestamp": "01:15:28", "text": "彼らはアジア人とかそういう人たちです。"}, {"type": "subtitle", "time": 4538.55, "timestamp": "01:15:38", "text": "それで私は、中国人を手に入れるにはどうすればいいかと思った"}, {"type": "subtitle", "time": 4541.83, "timestamp": "01:15:41", "text": "私を信頼してくれる友人"}, {"type": "subtitle", "time": 4543.99, "timestamp": "01:15:43", "text": "個人情報とかそういう類のこと？"}, {"type": "subtitle", "time": 4549.03, "timestamp": "01:15:49", "text": "どちらの方法も、秘密保持契約書（NDA）を作成する。"}, {"type": "subtitle", "time": 4551.35, "timestamp": "01:15:51", "text": "となることによって"}, {"type": "subtitle", "time": 4554.55, "timestamp": "01:15:54", "text": "えっと、それは、主に"}, {"type": "subtitle", "time": 4558.07, "timestamp": "01:15:58", "text": "もしそれがもしそれがもしもしそれがもし"}]
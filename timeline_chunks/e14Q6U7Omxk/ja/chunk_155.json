[{"type": "subtitle", "time": 9301.99, "timestamp": "02:35:01", "text": "えっと、男の子だったと思います。女の子だった"}, {"type": "subtitle", "time": 9304.469, "timestamp": "02:35:04", "text": "この少年の番号を教えたのは誰ですか"}, {"type": "subtitle", "time": 9306.95, "timestamp": "02:35:06", "text": "ラジオの人が彼に電話をかけて、何が起こったのか"}, {"type": "subtitle", "time": 9311.19, "timestamp": "02:35:11", "text": "えっと、デートの後って感じだったかな"}, {"type": "subtitle", "time": 9312.95, "timestamp": "02:35:12", "text": "彼らは少女の家に行ったのは"}, {"type": "subtitle", "time": 9316.95, "timestamp": "02:35:16", "text": "彼女の猫がいなくなって、その女の子は"}, {"type": "subtitle", "time": 9320.07, "timestamp": "02:35:20", "text": "左は周囲を見回し始めた。少年"}, {"type": "subtitle", "time": 9322.23, "timestamp": "02:35:22", "text": "彼は車を駐車しに行った。少女は考えた"}, {"type": "subtitle", "time": 9324.309, "timestamp": "02:35:24", "text": "彼は去った。よし。彼は自分の車を駐車しに行った"}, {"type": "subtitle", "time": 9326.87, "timestamp": "02:35:26", "text": "猫を探すために車に乗る。彼は"}, {"type": "subtitle", "time": 9329.99, "timestamp": "02:35:29", "text": "車に乗っていて、別の車にぶつかった。"}, {"type": "subtitle", "time": 9331.83, "timestamp": "02:35:31", "text": "トラックを想像してみてください。"}, {"type": "subtitle", "time": 9333.349, "timestamp": "02:35:33", "text": "うん。"}, {"type": "subtitle", "time": 9335.75, "timestamp": "02:35:35", "text": "彼は7日間入院し、"}, {"type": "subtitle", "time": 9337.51, "timestamp": "02:35:37", "text": "女の子は彼が私を無視しているみたいだった"}, {"type": "subtitle", "time": 9340.15, "timestamp": "02:35:40", "text": "7日間。"}, {"type": "subtitle", "time": 9342.15, "timestamp": "02:35:42", "text": "うん。そして何が起こったかというと"}, {"type": "subtitle", "time": 9345.429, "timestamp": "02:35:45", "text": "ライブ配信で申し訳ありません"}, {"type": "subtitle", "time": 9349.11, "timestamp": "02:35:49", "text": "猫はいつも"}, {"type": "subtitle", "time": 9352.79, "timestamp": "02:35:52", "text": "ずっとクローゼットの中にあったんだ。"}, {"type": "subtitle", "time": 9355.19, "timestamp": "02:35:55", "text": "うん、あれは面白かったね。私から"}, {"type": "subtitle", "time": 9356.79, "timestamp": "02:35:56", "text": "それは笑い事ではない。聞こえたらそれは"}, {"type": "subtitle", "time": 9358.469, "timestamp": "02:35:58", "text": "かなり面白い。うん。私は持っていません"}]
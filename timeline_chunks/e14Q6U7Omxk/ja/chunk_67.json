[{"type": "subtitle", "time": 4020.15, "timestamp": "01:07:00", "text": "そう、もし私が"}, {"type": "subtitle", "time": 4022.23, "timestamp": "01:07:02", "text": "ストリーム右、たくさんあります"}, {"type": "subtitle", "time": 4024.71, "timestamp": "01:07:04", "text": "合併症。"}, {"type": "subtitle", "time": 4026.71, "timestamp": "01:07:06", "text": "しかし、"}, {"type": "subtitle", "time": 4031.109, "timestamp": "01:07:11", "text": "えーと、私がしなければならないという事実"}, {"type": "subtitle", "time": 4033.27, "timestamp": "01:07:13", "text": "毎月"}, {"type": "subtitle", "time": 4038.069, "timestamp": "01:07:18", "text": "VPNにお金を払い、VPNに投資するのが好きです。"}, {"type": "subtitle", "time": 4041.19, "timestamp": "01:07:21", "text": "私の"}, {"type": "subtitle", "time": 4043.109, "timestamp": "01:07:23", "text": "これについては過去の配信で話しましたよね？私"}, {"type": "subtitle", "time": 4045.91, "timestamp": "01:07:25", "text": "実際にVPN Selfsharkを購入して"}, {"type": "subtitle", "time": 4048.15, "timestamp": "01:07:28", "text": "私はそれを使えると思っていたのですが、どうやらそうではないようです。"}, {"type": "subtitle", "time": 4050.309, "timestamp": "01:07:30", "text": "私は別のVPNを見つけました。"}, {"type": "subtitle", "time": 4054.63, "timestamp": "01:07:34", "text": "そのため。でも、そうするしかないんです。"}, {"type": "subtitle", "time": 4057.75, "timestamp": "01:07:37", "text": "ええと、その他諸々。まるでお金を払っているようなものだ"}, {"type": "subtitle", "time": 4059.91, "timestamp": "01:07:39", "text": "ちょっとした瞬間をストリーミングする"}, {"type": "subtitle", "time": 4062.71, "timestamp": "01:07:42", "text": "ちょっとした投資とか、そういうこと。"}, {"type": "subtitle", "time": 4065.829, "timestamp": "01:07:45", "text": "少し痛いけど、どうやって"}, {"type": "subtitle", "time": 4069.51, "timestamp": "01:07:49", "text": "フォロワーが多いとか"}, {"type": "subtitle", "time": 4071.99, "timestamp": "01:07:51", "text": "いろいろなもの"}, {"type": "subtitle", "time": 4074.71, "timestamp": "01:07:54", "text": "ホワイトリストに載る、または"}, {"type": "subtitle", "time": 4076.309, "timestamp": "01:07:56", "text": "何か。"}]
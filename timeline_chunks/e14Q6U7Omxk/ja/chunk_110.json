[{"type": "subtitle", "time": 6600.55, "timestamp": "01:50:00", "text": "[音楽]"}, {"type": "subtitle", "time": 6601.76, "timestamp": "01:50:01", "text": "私は"}, {"type": "subtitle", "time": 6605.43, "timestamp": "01:50:05", "text": "[音楽]"}, {"type": "subtitle", "time": 6618.149, "timestamp": "01:50:18", "text": "私の側で不具合が発生しました。ああ、わかりました。あなた"}, {"type": "subtitle", "time": 6620.47, "timestamp": "01:50:20", "text": "YouTubeで不具合が発生しています"}, {"type": "subtitle", "time": 6622.95, "timestamp": "01:50:22", "text": "ストリームを開くと、"}, {"type": "subtitle", "time": 6625.669, "timestamp": "01:50:25", "text": "チャットが読み込まれません。空白のようだ"}, {"type": "subtitle", "time": 6628.31, "timestamp": "01:50:28", "text": "チャットとか何か。チャットボックスは"}, {"type": "subtitle", "time": 6630.55, "timestamp": "01:50:30", "text": "丸くしたり"}, {"type": "subtitle", "time": 6633.59, "timestamp": "01:50:33", "text": "新しいオーバーレイと何か"}, {"type": "subtitle", "time": 6648.47, "timestamp": "01:50:48", "text": "でも、列の後半ではそうは思わない"}, {"type": "subtitle", "time": 6652.629, "timestamp": "01:50:52", "text": "私はこのようなショーを演奏できるようになるでしょう"}, {"type": "subtitle", "time": 6655.51, "timestamp": "01:50:55", "text": "重い"}, {"type": "subtitle", "time": 6658.39, "timestamp": "01:50:58", "text": "ヘビーカズ"}]
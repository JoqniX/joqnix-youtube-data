[{"type": "subtitle", "time": 3420.15, "timestamp": "00:57:00", "text": "最初に"}, {"type": "subtitle", "time": 3425.27, "timestamp": "00:57:05", "text": "挨拶して、えっと、姿を見せてください。そして雪も"}, {"type": "subtitle", "time": 3427.27, "timestamp": "00:57:07", "text": "彼もここにいた。うん。こんにちは、スノーウィー。希望"}, {"type": "subtitle", "time": 3429.829, "timestamp": "00:57:09", "text": "あなたはよくやっています。お元気でいらっしゃることを願っています"}, {"type": "subtitle", "time": 3432.63, "timestamp": "00:57:12", "text": "良い。スノーウィー、来てくれてありがとう。それから"}, {"type": "subtitle", "time": 3438.47, "timestamp": "00:57:18", "text": "あなたもお元気でいらっしゃることを願っています。そしてまた"}, {"type": "subtitle", "time": 3442.47, "timestamp": "00:57:22", "text": "アクションテストの成功をお祈りします。"}, {"type": "subtitle", "time": 3444.95, "timestamp": "00:57:24", "text": "幸運を。幸運を。全力を尽くしてください。希望"}, {"type": "subtitle", "time": 3447.67, "timestamp": "00:57:27", "text": "あなたはよく勉強しましたね。"}, {"type": "subtitle", "time": 3449.51, "timestamp": "00:57:29", "text": "ええ、もちろんそうでしょうね。あなたは"}, {"type": "subtitle", "time": 3457.67, "timestamp": "00:57:37", "text": "頑張ってください。幸運を。"}, {"type": "subtitle", "time": 3464.75, "timestamp": "00:57:44", "text": "君ならできるよ。"}, {"type": "subtitle", "time": 3472.87, "timestamp": "00:57:52", "text": "次のような"}, {"type": "subtitle", "time": 3475.03, "timestamp": "00:57:55", "text": "はい、私のモデルをここに置けます。全て"}]
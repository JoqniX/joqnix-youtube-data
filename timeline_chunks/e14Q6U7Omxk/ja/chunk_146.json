[{"type": "subtitle", "time": 8761.11, "timestamp": "02:26:01", "text": "人々はただじっと見つめるだけだろう"}, {"type": "subtitle", "time": 8763.91, "timestamp": "02:26:03", "text": "手助けをするか、警察に通報するか？あなたが知っている、"}, {"type": "subtitle", "time": 8767.429, "timestamp": "02:26:07", "text": "おいおい、ここはインドだよ。インド。うん。彼らは"}, {"type": "subtitle", "time": 8768.87, "timestamp": "02:26:08", "text": "それらは体の周りを回るだろう"}, {"type": "subtitle", "time": 8772.23, "timestamp": "02:26:12", "text": "平。誰が気にする？とにかく。ええ、それは"}, {"type": "subtitle", "time": 8773.91, "timestamp": "02:26:13", "text": "それ。ありがとうございます"}, {"type": "subtitle", "time": 8775.59, "timestamp": "02:26:15", "text": "ゲーム。ゲームに参加していただきありがとうございます。"}, {"type": "subtitle", "time": 8779.67, "timestamp": "02:26:19", "text": "クイズ。あなた"}, {"type": "subtitle", "time": 8781.59, "timestamp": "02:26:21", "text": "行く。"}, {"type": "subtitle", "time": 8783.75, "timestamp": "02:26:23", "text": "私は自分がサイコパスだと思っていた"}, {"type": "subtitle", "time": 8787.19, "timestamp": "02:26:27", "text": "実際、あなたが始めたとき。"}, {"type": "subtitle", "time": 8789.67, "timestamp": "02:26:29", "text": "どうやらあなたは最も普通のタイプの人らしい"}, {"type": "subtitle", "time": 8793.429, "timestamp": "02:26:33", "text": "がある。それは"}, {"type": "subtitle", "time": 8795.429, "timestamp": "02:26:35", "text": "面白い。あなたは精神病質者ではありません。"}, {"type": "subtitle", "time": 8797.03, "timestamp": "02:26:37", "text": "それは良いことです。あなたは社会病質者かもしれません。"}, {"type": "subtitle", "time": 8798.79, "timestamp": "02:26:38", "text": "しかし、それはまた別の話だ。"}, {"type": "subtitle", "time": 8800.23, "timestamp": "02:26:40", "text": "それについては動画を作ります"}, {"type": "subtitle", "time": 8805.19, "timestamp": "02:26:45", "text": "絶対に。ああ、それで、どうすればいいですか"}, {"type": "subtitle", "time": 8808.15, "timestamp": "02:26:48", "text": "説明しましょうか？のように"}, {"type": "subtitle", "time": 8813.03, "timestamp": "02:26:53", "text": "シャーロック・ホームズタイプの犯罪者。"}, {"type": "subtitle", "time": 8814.469, "timestamp": "02:26:54", "text": "うん。うん。うん。うん。うん。うん。"}, {"type": "subtitle", "time": 8817.429, "timestamp": "02:26:57", "text": "そこが問題なんです。"}, {"type": "subtitle", "time": 8819.51, "timestamp": "02:26:59", "text": "サイコパスは狂人のようなものだ。彼らは"}]
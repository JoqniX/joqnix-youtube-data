[{"type": "subtitle", "time": 7922.47, "timestamp": "02:12:02", "text": "あなたが知っている。そう、それは私が"}, {"type": "subtitle", "time": 7924.229, "timestamp": "02:12:04", "text": "質問するだけで"}, {"type": "subtitle", "time": 7926.39, "timestamp": "02:12:06", "text": "あなたは自分が正しいと思う方法で答えるでしょう"}, {"type": "subtitle", "time": 7929.27, "timestamp": "02:12:09", "text": "あるいは間違っているし、考える必要もない"}, {"type": "subtitle", "time": 7932.149, "timestamp": "02:12:12", "text": "それについてたくさん。よし、答えは"}, {"type": "subtitle", "time": 7936.069, "timestamp": "02:12:16", "text": "ええと、うまくいくものなら何でも、そして正しい"}, {"type": "subtitle", "time": 7938.55, "timestamp": "02:12:18", "text": "答えまたは間違った答え"}, {"type": "subtitle", "time": 7941.189, "timestamp": "02:12:21", "text": "サイコパスの答えは、えっと、私は"}, {"type": "subtitle", "time": 7944.55, "timestamp": "02:12:24", "text": "後で教えるよ。よし。ああ、そうだね。それで"}, {"type": "subtitle", "time": 7947.589, "timestamp": "02:12:27", "text": "まず、裁判では"}, {"type": "subtitle", "time": 7949.75, "timestamp": "02:12:29", "text": "プレゼントをもらう小さな子供"}, {"type": "subtitle", "time": 7952.31, "timestamp": "02:12:32", "text": "サンタクロース。今日はクリスマスです。彼は"}, {"type": "subtitle", "time": 7955.51, "timestamp": "02:12:35", "text": "サッカーボールと自転車を持っていたが、彼は"}, {"type": "subtitle", "time": 7958.55, "timestamp": "02:12:38", "text": "ハッピー。何故ですか？"}, {"type": "subtitle", "time": 7961.75, "timestamp": "02:12:41", "text": "彼はサッカーボールと自転車を手に入れ、"}, {"type": "subtitle", "time": 7963.75, "timestamp": "02:12:43", "text": "彼は幸せではない。"}, {"type": "subtitle", "time": 7967.51, "timestamp": "02:12:47", "text": "はい。彼は別のものを望んでいたからだ。"}, {"type": "subtitle", "time": 7969.189, "timestamp": "02:12:49", "text": "うん。"}, {"type": "subtitle", "time": 7972.55, "timestamp": "02:12:52", "text": "彼はサイクリストになりたくなかった"}, {"type": "subtitle", "time": 7975.189, "timestamp": "02:12:55", "text": "あるいは自転車に乗って自慢したかった"}, {"type": "subtitle", "time": 7977.43, "timestamp": "02:12:57", "text": "友達か、あるいは彼はサッカーが好きではなかったのかもしれない"}, {"type": "subtitle", "time": 7979.589, "timestamp": "02:12:59", "text": "友達にいじめられるから、"}]
[{"type": "subtitle", "time": 13020.229, "timestamp": "03:37:00", "text": "大丈夫です。"}, {"type": "subtitle", "time": 13024.469, "timestamp": "03:37:04", "text": "えーと、私はあまり話さないんだけど"}, {"type": "subtitle", "time": 13027.19, "timestamp": "03:37:07", "text": "英語だよ、ほら、仕事で"}, {"type": "subtitle", "time": 13029.91, "timestamp": "03:37:09", "text": "私がすることに関しては、ヒンディー語のように話さなければならない。"}, {"type": "subtitle", "time": 13031.99, "timestamp": "03:37:11", "text": "だから、私はこれらの人たちと話をする必要がある"}, {"type": "subtitle", "time": 13035.99, "timestamp": "03:37:15", "text": "えーっと、どう言えばいいかな"}, {"type": "subtitle", "time": 13038.95, "timestamp": "03:37:18", "text": "それは政治的に正しいのだろうか？政治的に。"}, {"type": "subtitle", "time": 13040.79, "timestamp": "03:37:20", "text": "なんてこった。"}, {"type": "subtitle", "time": 13042.63, "timestamp": "03:37:22", "text": "えっと、ちょっと考えさせてください。それはまるで"}, {"type": "subtitle", "time": 13044.389, "timestamp": "03:37:24", "text": "カスタマーサポートのようなもの"}, {"type": "subtitle", "time": 13049.19, "timestamp": "03:37:29", "text": "人々は怒っているかもしれないし、中立かもしれないし、"}, {"type": "subtitle", "time": 13051.429, "timestamp": "03:37:31", "text": "まるで私が顧客対応をしているようなものだ"}, {"type": "subtitle", "time": 13054.71, "timestamp": "03:37:34", "text": "直接的にですが、彼らは私が何をすべきかのように使用します"}, {"type": "subtitle", "time": 13058.07, "timestamp": "03:37:38", "text": "言う？ああ、今ならこう言ってもいいよ"}, {"type": "subtitle", "time": 13060.95, "timestamp": "03:37:40", "text": "ウドゥ語を彼らは正しく話します。とても"}, {"type": "subtitle", "time": 13066.309, "timestamp": "03:37:46", "text": "ヒンディー語に近い。だから私がヒンディー語を話したら"}, {"type": "subtitle", "time": 13069.429, "timestamp": "03:37:49", "text": "私が4つの異なる言語で話すのを聞くことになるでしょう"}, {"type": "subtitle", "time": 13071.19, "timestamp": "03:37:51", "text": "アクセント。"}, {"type": "subtitle", "time": 13074.15, "timestamp": "03:37:54", "text": "ああ、わかった。ええ、もちろんです。いくつかについては"}, {"type": "subtitle", "time": 13077.19, "timestamp": "03:37:57", "text": "ウドゥ語で私が話す言葉は"}, {"type": "subtitle", "time": 13079.03, "timestamp": "03:37:59", "text": "私が話すいくつかの言葉は"}]
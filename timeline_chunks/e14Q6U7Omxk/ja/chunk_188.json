[{"type": "subtitle", "time": 11280.87, "timestamp": "03:08:00", "text": "ありがとう。"}, {"type": "subtitle", "time": 11286.07, "timestamp": "03:08:06", "text": "こんにちは。うん。えっと、私が何をしたかというと"}, {"type": "subtitle", "time": 11289.51, "timestamp": "03:08:09", "text": "何について話しているのですか？ああ、そうだね。わかった。だから"}, {"type": "subtitle", "time": 11291.99, "timestamp": "03:08:11", "text": "チャンネルの最初のテーマはクラッシュ・オブ・クランでした。"}, {"type": "subtitle", "time": 11294.15, "timestamp": "03:08:14", "text": "2015年にはかなり有名だったよね？"}, {"type": "subtitle", "time": 11296.469, "timestamp": "03:08:16", "text": "はい。だから、私が子供の頃、"}, {"type": "subtitle", "time": 11299.11, "timestamp": "03:08:19", "text": "背景雑音が多く、"}, {"type": "subtitle", "time": 11303.11, "timestamp": "03:08:23", "text": "悪いことのことですよね？だから私はそれを修正しました。"}, {"type": "subtitle", "time": 11306.63, "timestamp": "03:08:26", "text": "それから私はミュージックビデオを始めました"}, {"type": "subtitle", "time": 11309.03, "timestamp": "03:08:29", "text": "アニメーションミュージックビデオって、"}, {"type": "subtitle", "time": 11312.309, "timestamp": "03:08:32", "text": "歌の漫画がずっと来たとき"}, {"type": "subtitle", "time": 11316.87, "timestamp": "03:08:36", "text": "ご存知の通り、それはずっと続いています"}, {"type": "subtitle", "time": 11318.63, "timestamp": "03:08:38", "text": "そんな感じのものもありますし、"}, {"type": "subtitle", "time": 11321.67, "timestamp": "03:08:41", "text": "伝説は決して死なない。ああ、伝説は決して"}, {"type": "subtitle", "time": 11324.07, "timestamp": "03:08:44", "text": "死ぬ。はい。うん。当時私は"}, {"type": "subtitle", "time": 11326.63, "timestamp": "03:08:46", "text": "チャンネルを始めたんだけど、それが大失敗に終わった"}, {"type": "subtitle", "time": 11330.87, "timestamp": "03:08:50", "text": "上へ、なぜなら私は自分が好きなことを本当に知っているから"}, {"type": "subtitle", "time": 11333.51, "timestamp": "03:08:53", "text": "頭の中に欲しいものがある"}, {"type": "subtitle", "time": 11335.75, "timestamp": "03:08:55", "text": "する。だから私は編集が本当に得意で"}, {"type": "subtitle", "time": 11339.429, "timestamp": "03:08:59", "text": "視点に関する話だよ。うん。"}]
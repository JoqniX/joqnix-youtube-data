[{"type": "subtitle", "time": 7323.43, "timestamp": "02:02:03", "text": "どれ？どうやって？ちょっと待って。えっと、どうやって"}, {"type": "subtitle", "time": 7325.75, "timestamp": "02:02:05", "text": "これは効果がありますか？"}, {"type": "subtitle", "time": 7329.189, "timestamp": "02:02:09", "text": "ちょっと待ってください。はい、どうぞ。はい、私は"}, {"type": "subtitle", "time": 7336.87, "timestamp": "02:02:16", "text": "[音楽]"}, {"type": "subtitle", "time": 7339.03, "timestamp": "02:02:19", "text": "これがどのように配信されるか教えていただけますか？"}, {"type": "subtitle", "time": 7340.95, "timestamp": "02:02:20", "text": "それらは効果がありますか？"}, {"type": "subtitle", "time": 7345.27, "timestamp": "02:02:25", "text": "あらら。えっと、マルチビューのことですよね？うん。"}, {"type": "subtitle", "time": 7348.229, "timestamp": "02:02:28", "text": "視聴者はリンクをクリックして"}, {"type": "subtitle", "time": 7351.43, "timestamp": "02:02:31", "text": "彼らは私たち二人をそれぞれ見守ることができる"}, {"type": "subtitle", "time": 7354.47, "timestamp": "02:02:34", "text": "他の人の視点と、私たち二人のチャット"}, {"type": "subtitle", "time": 7356.31, "timestamp": "02:02:36", "text": "チャットもね。確認する必要がある"}, {"type": "subtitle", "time": 7358.55, "timestamp": "02:02:38", "text": "Googleにログインしています。"}, {"type": "subtitle", "time": 7360.79, "timestamp": "02:02:40", "text": "すべて。わかった。では、それをどこに送ればいいでしょうか？"}, {"type": "subtitle", "time": 7363.91, "timestamp": "02:02:43", "text": "私のチャット？置くことができます、置くことができます"}, {"type": "subtitle", "time": 7366.55, "timestamp": "02:02:46", "text": "固定されたコメントに記載されています。はい。複数の場合"}, {"type": "subtitle", "time": 7368.31, "timestamp": "02:02:48", "text": "見ている。うん。ちょっと待ってください。わかった。"}, {"type": "subtitle", "time": 7369.83, "timestamp": "02:02:49", "text": "彼らは今、あなたが誰なのか尋ねている"}, {"type": "subtitle", "time": 7372.229, "timestamp": "02:02:52", "text": "富士の技術のおかげで、話したり色々したりできる"}, {"type": "subtitle", "time": 7373.91, "timestamp": "02:02:53", "text": "物はまだ回転していて、彼らは"}, {"type": "subtitle", "time": 7376.79, "timestamp": "02:02:56", "text": "PNGファイルなどを確認してください。だから"}]
[{"type": "subtitle", "time": 14762.15, "timestamp": "04:06:02", "text": "例えば、編集を検索する"}, {"type": "subtitle", "time": 14764.71, "timestamp": "04:06:04", "text": "YouTubeのチュートリアルですよね？あなたが持っている"}, {"type": "subtitle", "time": 14766.55, "timestamp": "04:06:06", "text": "何百、何千もの動画のように"}, {"type": "subtitle", "time": 14768.71, "timestamp": "04:06:08", "text": "ラグもあって、どれが"}, {"type": "subtitle", "time": 14770.63, "timestamp": "04:06:10", "text": "1つが一番良い。それはそういう種類の"}, {"type": "subtitle", "time": 14773.59, "timestamp": "04:06:13", "text": "もの。同じ。それは全く同じです。"}, {"type": "subtitle", "time": 14775.349, "timestamp": "04:06:15", "text": "それは同じです。考えなければならない"}, {"type": "subtitle", "time": 14777.03, "timestamp": "04:06:17", "text": "残りのものを確認する"}, {"type": "subtitle", "time": 14778.23, "timestamp": "04:06:18", "text": "あなた自身。"}, {"type": "subtitle", "time": 14780.309, "timestamp": "04:06:20", "text": "[音楽]"}, {"type": "subtitle", "time": 14783.99, "timestamp": "04:06:23", "text": "うん。 7時半を過ぎたので、"}, {"type": "subtitle", "time": 14787.59, "timestamp": "04:06:27", "text": "まとめます。うん。うん。うん。いいえ、"}, {"type": "subtitle", "time": 14789.59, "timestamp": "04:06:29", "text": "構わないよ、相棒。もし"}, {"type": "subtitle", "time": 14790.71, "timestamp": "04:06:30", "text": "そのようなことが実際に起こったことがある。ただ"}, {"type": "subtitle", "time": 14792.87, "timestamp": "04:06:32", "text": "教えてくれよ、相棒。私はここに留まります 私はここに立ち寄ります"}, {"type": "subtitle", "time": 14795.51, "timestamp": "04:06:35", "text": "あの瞬間。心配ない。はい、できます"}, {"type": "subtitle", "time": 14797.429, "timestamp": "04:06:37", "text": "常に配信を続け、いいね"}, {"type": "subtitle", "time": 14801.59, "timestamp": "04:06:41", "text": "仲間とチャットして楽しんでください。"}, {"type": "subtitle", "time": 14803.91, "timestamp": "04:06:43", "text": "わかった。わかった。いいえ、問題ありません。心配ない。"}, {"type": "subtitle", "time": 14805.99, "timestamp": "04:06:45", "text": "たとえ私がただ終わらせたとしても、彼らは理解してくれるだろう"}, {"type": "subtitle", "time": 14814.15, "timestamp": "04:06:54", "text": "うん。今日は本当に楽しかった。私たちは"}, {"type": "subtitle", "time": 14816.469, "timestamp": "04:06:56", "text": "たくさん話したので、話さなければならないと思いました"}, {"type": "subtitle", "time": 14818.87, "timestamp": "04:06:58", "text": "初めてあなたとご一緒します。いいえ、私は"}]
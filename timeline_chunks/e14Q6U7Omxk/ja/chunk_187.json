[{"type": "subtitle", "time": 11220.63, "timestamp": "03:07:00", "text": "わかった、私は思う、私は思う、ああ、待って。はい、私は"}, {"type": "subtitle", "time": 11223.75, "timestamp": "03:07:03", "text": "行かなきゃいけないんだ。うん。何をしたの？"}, {"type": "subtitle", "time": 11227.349, "timestamp": "03:07:07", "text": "言う？アプリケーション音声キャプチャ機能（ベータ版）"}, {"type": "subtitle", "time": 11229.11, "timestamp": "03:07:09", "text": "ああ、彼は聞こえている。私はただ増やしただけです"}, {"type": "subtitle", "time": 11231.349, "timestamp": "03:07:11", "text": "デスクトップオーディオで、なぜかちゃんと動作する。"}, {"type": "subtitle", "time": 11233.83, "timestamp": "03:07:13", "text": "まあ、いいでしょう。"}, {"type": "subtitle", "time": 11236.87, "timestamp": "03:07:16", "text": "はい、ありがとうございます、先輩。まあ、そうですね。"}, {"type": "subtitle", "time": 11240.23, "timestamp": "03:07:20", "text": "えっと、その件について。いいえ、2つだけです"}, {"type": "subtitle", "time": 11242.07, "timestamp": "03:07:22", "text": "私たちの。ありません、2つだけです"}, {"type": "subtitle", "time": 11243.51, "timestamp": "03:07:23", "text": "私たちが話している。 3つの音が聞こえますか？"}, {"type": "subtitle", "time": 11246.389, "timestamp": "03:07:26", "text": "人々？"}, {"type": "subtitle", "time": 11249.11, "timestamp": "03:07:29", "text": "ああ、あなたはストリームを視聴しています"}, {"type": "subtitle", "time": 11251.83, "timestamp": "03:07:31", "text": "ストリームですよね？あるいは、もしかしたらあなたは"}, {"type": "subtitle", "time": 11253.99, "timestamp": "03:07:33", "text": "音声を停止します。つまり、ブラウザの音声は"}, {"type": "subtitle", "time": 11257.03, "timestamp": "03:07:37", "text": "音声を表示しています。"}, {"type": "subtitle", "time": 11261.51, "timestamp": "03:07:41", "text": "えっと、始める前に"}, {"type": "subtitle", "time": 11262.87, "timestamp": "03:07:42", "text": "他の人へのアドバイス、私は考えなければならない"}, {"type": "subtitle", "time": 11266.07, "timestamp": "03:07:46", "text": "私の持ち物から。ええ、大丈夫です。取る"}, {"type": "subtitle", "time": 11269.03, "timestamp": "03:07:49", "text": "あなたの時間。"}, {"type": "subtitle", "time": 11270.87, "timestamp": "03:07:50", "text": "分かりきったことについてはお手伝いしますよ。"}, {"type": "subtitle", "time": 11273.03, "timestamp": "03:07:53", "text": "もし助けが必要な時はいつでも"}, {"type": "subtitle", "time": 11274.55, "timestamp": "03:07:54", "text": "お手伝いします。"}, {"type": "subtitle", "time": 11277.11, "timestamp": "03:07:57", "text": "ありがとう。たとえそうしなくても、"}, {"type": "subtitle", "time": 11278.63, "timestamp": "03:07:58", "text": "そう言ってもらえると、とても助かります。よし。"}]
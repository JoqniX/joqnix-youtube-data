[{"type": "subtitle", "time": 11341.99, "timestamp": "03:09:01", "text": "うまくいったね。 10万ドルくらい手に入れたよ"}, {"type": "subtitle", "time": 11343.99, "timestamp": "03:09:03", "text": "それについての見解。まだ持っています。その"}, {"type": "subtitle", "time": 11346.79, "timestamp": "03:09:06", "text": "著作権侵害の申し立てにより、事業は停止した。"}, {"type": "subtitle", "time": 11349.19, "timestamp": "03:09:09", "text": "私は10本くらいの動画を削除しなければならなかったし"}, {"type": "subtitle", "time": 11352.15, "timestamp": "03:09:12", "text": "そのチャンネルは消滅した。でも本当に誇りに思っています"}, {"type": "subtitle", "time": 11355.429, "timestamp": "03:09:15", "text": "それの。そこから多くのことを学ぶことができました。"}, {"type": "subtitle", "time": 11358.15, "timestamp": "03:09:18", "text": "うん。だから私は多くの"}, {"type": "subtitle", "time": 11360.23, "timestamp": "03:09:20", "text": "サムネイル関連のもの、編集関連のもの、"}, {"type": "subtitle", "time": 11361.99, "timestamp": "03:09:21", "text": "それら全て。それについてアドバイスできますよ"}, {"type": "subtitle", "time": 11364.55, "timestamp": "03:09:24", "text": "そういう類のことだけど、うん、かなり"}, {"type": "subtitle", "time": 11366.95, "timestamp": "03:09:26", "text": "チューブ入りの新製品。つまり、あなたは私の先輩ですね"}, {"type": "subtitle", "time": 11369.99, "timestamp": "03:09:29", "text": "その件に関して。"}, {"type": "subtitle", "time": 11371.59, "timestamp": "03:09:31", "text": "こんにちは。"}, {"type": "subtitle", "time": 11374.389, "timestamp": "03:09:34", "text": "うん。では、あなたの"}, {"type": "subtitle", "time": 11377.91, "timestamp": "03:09:37", "text": "経験。ぜひ知りたいです"}, {"type": "subtitle", "time": 11383.11, "timestamp": "03:09:43", "text": "どのような形で経験するか。"}, {"type": "subtitle", "time": 11386.63, "timestamp": "03:09:46", "text": "例えば、まず最初に私は"}, {"type": "subtitle", "time": 11388.309, "timestamp": "03:09:48", "text": "あなたがどのようにしてこの業界に入ったのか、ぜひ知りたいです。"}, {"type": "subtitle", "time": 11391.269, "timestamp": "03:09:51", "text": "Vチューブとかそういうの知ってるでしょ、だって"}, {"type": "subtitle", "time": 11393.03, "timestamp": "03:09:53", "text": "私はそれを知って本当に興奮しています"}, {"type": "subtitle", "time": 11394.95, "timestamp": "03:09:54", "text": "あなたがこれをやったりあれをしたりして、"}, {"type": "subtitle", "time": 11396.63, "timestamp": "03:09:56", "text": "あなたは一生懸命努力した、それは分かっている"}]
[{"type": "subtitle", "time": 10202.55, "timestamp": "02:50:02", "text": "あなたに起こったことについて"}, {"type": "subtitle", "time": 10204.469, "timestamp": "02:50:04", "text": "私ですよね？私が投稿したとき"}, {"type": "subtitle", "time": 10206.23, "timestamp": "02:50:06", "text": "インド初のユーチューバーのような動画、"}, {"type": "subtitle", "time": 10208.15, "timestamp": "02:50:08", "text": "右？"}, {"type": "subtitle", "time": 10211.19, "timestamp": "02:50:11", "text": "うん。私はその男性と話をする機会がありました"}, {"type": "subtitle", "time": 10214.79, "timestamp": "02:50:14", "text": "実際、そのことは"}, {"type": "subtitle", "time": 10217.91, "timestamp": "02:50:17", "text": "また、私のビデオの後、彼は"}, {"type": "subtitle", "time": 10221.83, "timestamp": "02:50:21", "text": "どうやら変わったようだ。彼は大きく変わった。"}, {"type": "subtitle", "time": 10224.87, "timestamp": "02:50:24", "text": "どこの？ああ、君が"}, {"type": "subtitle", "time": 10227.99, "timestamp": "02:50:27", "text": "君に話した男は"}, {"type": "subtitle", "time": 10229.83, "timestamp": "02:50:29", "text": "たくさんの人がいると教えてくれた"}, {"type": "subtitle", "time": 10232.07, "timestamp": "02:50:32", "text": "ここでは、彼らは"}, {"type": "subtitle", "time": 10233.67, "timestamp": "02:50:33", "text": "すでにやっているので、その物を使うことはできません"}, {"type": "subtitle", "time": 10236.07, "timestamp": "02:50:36", "text": "ビデオの中で、彼は私に始めた"}, {"type": "subtitle", "time": 10237.75, "timestamp": "02:50:37", "text": "証拠とか色々くれて、私はとても"}, {"type": "subtitle", "time": 10241.429, "timestamp": "02:50:41", "text": "イライラする、えっと、自分が作っているのはわかってるんだけど"}, {"type": "subtitle", "time": 10244.309, "timestamp": "02:50:44", "text": "ビデオを見たので、"}, {"type": "subtitle", "time": 10248.63, "timestamp": "02:50:48", "text": "とにかく、彼は言った、そしてそれは"}, {"type": "subtitle", "time": 10251.349, "timestamp": "02:50:51", "text": "別問題だが、彼は今かなり"}, {"type": "subtitle", "time": 10253.75, "timestamp": "02:50:53", "text": "いいよ、彼は丁寧に話すし、"}, {"type": "subtitle", "time": 10256.309, "timestamp": "02:50:56", "text": "すべて順調です。それは良かった。彼"}, {"type": "subtitle", "time": 10258.95, "timestamp": "02:50:58", "text": "少し進展があった。"}]
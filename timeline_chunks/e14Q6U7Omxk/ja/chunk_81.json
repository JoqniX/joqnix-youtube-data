[{"type": "subtitle", "time": 4860.47, "timestamp": "01:21:00", "text": "レベルアップは大変ですが、やはり難しいです"}, {"type": "subtitle", "time": 4863.189, "timestamp": "01:21:03", "text": "レベルアップは必要だけどね。たくさんあります"}, {"type": "subtitle", "time": 4865.99, "timestamp": "01:21:05", "text": "この中にはこんなものが入っている。私は、"}, {"type": "subtitle", "time": 4869.03, "timestamp": "01:21:09", "text": "削除するしかない"}, {"type": "subtitle", "time": 4872.47, "timestamp": "01:21:12", "text": "これは現実の生活のせいだ"}, {"type": "subtitle", "time": 4876.709, "timestamp": "01:21:16", "text": "認証プロセスで私はこう思う"}, {"type": "subtitle", "time": 4880.709, "timestamp": "01:21:20", "text": "私は知りたくない"}, {"type": "subtitle", "time": 4882.55, "timestamp": "01:21:22", "text": "1つ"}, {"type": "subtitle", "time": 4890.63, "timestamp": "01:21:30", "text": "インディーズ的な意味で言えば"}, {"type": "subtitle", "time": 4893.43, "timestamp": "01:21:33", "text": "わからない"}, {"type": "subtitle", "time": 4895.43, "timestamp": "01:21:35", "text": "すべての党員が持っていると書いてありますか"}, {"type": "subtitle", "time": 4897.75, "timestamp": "01:21:37", "text": "レベル20になるには？"}, {"type": "subtitle", "time": 4899.99, "timestamp": "01:21:39", "text": "はぁ？"}, {"type": "subtitle", "time": 4902.55, "timestamp": "01:21:42", "text": "わかった。ゲームを始める前に、"}, {"type": "subtitle", "time": 4904.39, "timestamp": "01:21:44", "text": "扇風機がちゃんと回転しているか確認するため。はぁ？"}, {"type": "subtitle", "time": 4909.99, "timestamp": "01:21:49", "text": "ファンが"}, {"type": "subtitle", "time": 4912.55, "timestamp": "01:21:52", "text": "紡糸？"}, {"type": "subtitle", "time": 4915.11, "timestamp": "01:21:55", "text": "ちょっといいですか"}]
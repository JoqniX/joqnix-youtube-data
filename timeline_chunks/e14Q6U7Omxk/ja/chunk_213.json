[{"type": "subtitle", "time": 12780.239, "timestamp": "03:33:00", "text": "初期段階で彼はすでに起きている 先に。"}, {"type": "subtitle", "time": 12785.11, "timestamp": "03:33:05", "text": "えっと"}, {"type": "subtitle", "time": 12789.59, "timestamp": "03:33:09", "text": "正直よくわからない。えっと"}, {"type": "subtitle", "time": 12791.75, "timestamp": "03:33:11", "text": "待って、あなたはそうしなかった、あなたはそうしなかった"}, {"type": "subtitle", "time": 12794.55, "timestamp": "03:33:14", "text": "男たち、つまり男たちではなく、"}, {"type": "subtitle", "time": 12797.75, "timestamp": "03:33:17", "text": "君は、えっと、私はたくさんの断片を見たよ"}, {"type": "subtitle", "time": 12799.67, "timestamp": "03:33:19", "text": "そして、始める前に知っておくこと"}, {"type": "subtitle", "time": 12802.71, "timestamp": "03:33:22", "text": "すべて、でも私が見たもの"}, {"type": "subtitle", "time": 12805.91, "timestamp": "03:33:25", "text": "それは、あなたがこの目標を持つべきだということです"}, {"type": "subtitle", "time": 12808.07, "timestamp": "03:33:28", "text": "設定しているもの、それが何なのかわからない"}, {"type": "subtitle", "time": 12810.95, "timestamp": "03:33:30", "text": "選択する必要があると呼んでいます"}, {"type": "subtitle", "time": 12813.51, "timestamp": "03:33:33", "text": "特定の3つのストリーマーまたは"}, {"type": "subtitle", "time": 12818.389, "timestamp": "03:33:38", "text": "あなたが好きなユーチューバー、または"}, {"type": "subtitle", "time": 12820.71, "timestamp": "03:33:40", "text": "えっと、そういうことに従うと"}, {"type": "subtitle", "time": 12823.67, "timestamp": "03:33:43", "text": "私はその活動をして、"}, {"type": "subtitle", "time": 12825.59, "timestamp": "03:33:45", "text": "答えを出して、それから私は自分の仕事に取り掛かりました"}, {"type": "subtitle", "time": 12828.71, "timestamp": "03:33:48", "text": "そのため、私は"}, {"type": "subtitle", "time": 12831.19, "timestamp": "03:33:51", "text": "サムネイルなどの言い方"}, {"type": "subtitle", "time": 12833.99, "timestamp": "03:33:53", "text": "そういうことだよ、待って、それが問題なんだ"}, {"type": "subtitle", "time": 12836.389, "timestamp": "03:33:56", "text": "あなたは人々のグループを見つけなければなりません"}, {"type": "subtitle", "time": 12838.15, "timestamp": "03:33:58", "text": "彼らと話して、彼らがどのようにやっているかを学びましょう"}]
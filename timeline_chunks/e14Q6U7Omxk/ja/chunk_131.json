[{"type": "subtitle", "time": 7861.589, "timestamp": "02:11:01", "text": "つまり、昨日は遅くまで寝ていたんです"}, {"type": "subtitle", "time": 7865.189, "timestamp": "02:11:05", "text": "そして午前3時か4時頃に目が覚めた。"}, {"type": "subtitle", "time": 7867.83, "timestamp": "02:11:07", "text": "午後あるいは、そんな感じ。私は長い間良い時間を過ごしました"}, {"type": "subtitle", "time": 7869.83, "timestamp": "02:11:09", "text": "寝る。"}, {"type": "subtitle", "time": 7871.589, "timestamp": "02:11:11", "text": "それは良い。それは良いことだ。その"}, {"type": "subtitle", "time": 7873.75, "timestamp": "02:11:13", "text": "ちょっと体に悪いけど、いい食べ物だよ。"}, {"type": "subtitle", "time": 7876.149, "timestamp": "02:11:16", "text": "それは良いです。心配ない。"}, {"type": "subtitle", "time": 7879.03, "timestamp": "02:11:19", "text": "私たちは、できる限り睡眠をとる必要がある。"}, {"type": "subtitle", "time": 7882.95, "timestamp": "02:11:22", "text": "うん。うん。問題は、私が"}, {"type": "subtitle", "time": 7886.31, "timestamp": "02:11:26", "text": "これはストリーミング配信していたのですが、私は"}, {"type": "subtitle", "time": 7889.109, "timestamp": "02:11:29", "text": "私がダンについて尋ねた理由は"}, {"type": "subtitle", "time": 7892.31, "timestamp": "02:11:32", "text": "計画は、彼らがこの装置を持っていたからだった。"}, {"type": "subtitle", "time": 7894.229, "timestamp": "02:11:34", "text": "えっと、私はそのビデオが本当に好きで、"}, {"type": "subtitle", "time": 7896.79, "timestamp": "02:11:36", "text": "いろいろなものがあって、クイズもある。"}, {"type": "subtitle", "time": 7901.51, "timestamp": "02:11:41", "text": "右？だから、なぜそうしないのかと思ったんです。"}, {"type": "subtitle", "time": 7903.91, "timestamp": "02:11:43", "text": "ええ、私も変換できますよ。とにかく、"}, {"type": "subtitle", "time": 7906.149, "timestamp": "02:11:46", "text": "何か取り出せるかどうか見てみましょう"}, {"type": "subtitle", "time": 7910.149, "timestamp": "02:11:50", "text": "それの。右。まず最初に"}, {"type": "subtitle", "time": 7913.03, "timestamp": "02:11:53", "text": "クイズの名前は「あなたは"}, {"type": "subtitle", "time": 7917.669, "timestamp": "02:11:57", "text": "わかった。"}, {"type": "subtitle", "time": 7919.43, "timestamp": "02:11:59", "text": "ああ、そういうユーモアが好きなんだ。"}]
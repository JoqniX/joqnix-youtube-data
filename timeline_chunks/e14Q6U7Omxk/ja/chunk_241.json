[{"type": "subtitle", "time": 14461.189, "timestamp": "04:01:01", "text": "うん。ゼロがいくつあるのかさえわからない"}, {"type": "subtitle", "time": 14464.95, "timestamp": "04:01:04", "text": "彼らは6、7歳くらいです。"}, {"type": "subtitle", "time": 14468.63, "timestamp": "04:01:08", "text": "わからない。 Cは"}, {"type": "subtitle", "time": 14470.229, "timestamp": "04:01:10", "text": "六"}, {"type": "subtitle", "time": 14473.269, "timestamp": "04:01:13", "text": "おそらく7人。わからない。うん、たぶん"}, {"type": "subtitle", "time": 14476.71, "timestamp": "04:01:16", "text": "六。 6人か7人だと思う。うん。うん。"}, {"type": "subtitle", "time": 14479.269, "timestamp": "04:01:19", "text": "正確に言うと、かなりの金額です。"}, {"type": "subtitle", "time": 14483.429, "timestamp": "04:01:23", "text": "はい。ええ、それはたくさんあります。ええと、それは"}, {"type": "subtitle", "time": 14486.55, "timestamp": "04:01:26", "text": "うん。それから私は始めた、そして私は止めた"}, {"type": "subtitle", "time": 14488.71, "timestamp": "04:01:28", "text": "わかった、私は行かないよ"}, {"type": "subtitle", "time": 14491.59, "timestamp": "04:01:31", "text": "手っ取り早くお金を稼ぐ方法。よし。始めた"}, {"type": "subtitle", "time": 14496.309, "timestamp": "04:01:36", "text": "兄弟。とにかく、ちょっと立ち止まって"}, {"type": "subtitle", "time": 14498.469, "timestamp": "04:01:38", "text": "手っ取り早くお金を稼ぐ方法、例えば私がやめたようなこと。私"}, {"type": "subtitle", "time": 14500.79, "timestamp": "04:01:40", "text": "「いや、これはうまくいかない」という感じだった。私はしなければならない"}, {"type": "subtitle", "time": 14503.51, "timestamp": "04:01:43", "text": "すべてをゼロから学びましょう。"}, {"type": "subtitle", "time": 14505.75, "timestamp": "04:01:45", "text": "そして私は、"}, {"type": "subtitle", "time": 14507.349, "timestamp": "04:01:47", "text": "金銭的なこと。それで私は始めた"}, {"type": "subtitle", "time": 14509.51, "timestamp": "04:01:49", "text": "本を集めて読み始めた"}, {"type": "subtitle", "time": 14512.79, "timestamp": "04:01:52", "text": "たくさんあります、ええ。ああ、ゼロが8つ。ありがとう。"}, {"type": "subtitle", "time": 14515.51, "timestamp": "04:01:55", "text": "傷口にいいねをありがとうございます"}]
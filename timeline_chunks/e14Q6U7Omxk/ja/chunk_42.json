[{"type": "subtitle", "time": 2520.15, "timestamp": "00:42:00", "text": "今日来るよ、それからインドラも一緒だよ"}, {"type": "subtitle", "time": 2524.309, "timestamp": "00:42:04", "text": "そして、すべてのラーも"}, {"type": "subtitle", "time": 2528.71, "timestamp": "00:42:08", "text": "本当に本当に本当に本当に意味があります。"}, {"type": "subtitle", "time": 2542.71, "timestamp": "00:42:22", "text": "あ、待って。"}, {"type": "subtitle", "time": 2559.99, "timestamp": "00:42:39", "text": "とにかく、えっと"}, {"type": "subtitle", "time": 2562.47, "timestamp": "00:42:42", "text": "えーと、今日来てくださった皆さん、"}, {"type": "subtitle", "time": 2571.19, "timestamp": "00:42:51", "text": "来てくれてありがとう、ズキ"}, {"type": "subtitle", "time": 2576.95, "timestamp": "00:42:56", "text": "のために"}, {"type": "subtitle", "time": 2579.67, "timestamp": "00:42:59", "text": "来る"}]
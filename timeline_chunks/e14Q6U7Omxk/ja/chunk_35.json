[{"type": "subtitle", "time": 2134.79, "timestamp": "00:35:34", "text": "YouTube用です。さて、Twitchについては、えっと、私は"}, {"type": "subtitle", "time": 2139.109, "timestamp": "00:35:39", "text": "ブロックしたり、無視したりできると思う。待って、君"}, {"type": "subtitle", "time": 2142.31, "timestamp": "00:35:42", "text": "無視するのが一番だ。"}, {"type": "subtitle", "time": 2147.19, "timestamp": "00:35:47", "text": "はい、ブロックして報告することができます"}, {"type": "subtitle", "time": 2150.79, "timestamp": "00:35:50", "text": "YouTubeをTwitchで配信。"}, {"type": "subtitle", "time": 2152.95, "timestamp": "00:35:52", "text": "モデレーターが何か悪いことを見つけたら"}, {"type": "subtitle", "time": 2156.79, "timestamp": "00:35:56", "text": "私自身が起こっていること、または私自身も削除します"}, {"type": "subtitle", "time": 2159.19, "timestamp": "00:35:59", "text": "そしてそれを削除する。"}]
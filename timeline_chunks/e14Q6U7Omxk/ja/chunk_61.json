[{"type": "subtitle", "time": 3661.349, "timestamp": "01:01:01", "text": "タイトルはそのままにしておきました"}, {"type": "subtitle", "time": 3663.91, "timestamp": "01:01:03", "text": "YouTube。わかった。そして私は本当に"}, {"type": "subtitle", "time": 3666.789, "timestamp": "01:01:06", "text": "混乱した。え、何？"}, {"type": "subtitle", "time": 3669.19, "timestamp": "01:01:09", "text": "そして、どうやらビリー・ビリーでは、"}, {"type": "subtitle", "time": 3670.95, "timestamp": "01:01:10", "text": "確認できます"}, {"type": "subtitle", "time": 3674.309, "timestamp": "01:01:14", "text": "えっと、ビリーのユーザーたちはどこにいるの？"}, {"type": "subtitle", "time": 3676.309, "timestamp": "01:01:16", "text": "ビリーは出身です。モバイル端末をご利用の場合"}, {"type": "subtitle", "time": 3680.39, "timestamp": "01:01:20", "text": "アプリと、IPアドレスも表示されます"}, {"type": "subtitle", "time": 3683.19, "timestamp": "01:01:23", "text": "完全なIPではなく、国が実際に"}, {"type": "subtitle", "time": 3685.43, "timestamp": "01:01:25", "text": "それで二人とも日本に行ったか"}, {"type": "subtitle", "time": 3688.23, "timestamp": "01:01:28", "text": "何かあるけど、理由はわからないし"}, {"type": "subtitle", "time": 3691.19, "timestamp": "01:01:31", "text": "何"}, {"type": "subtitle", "time": 3694.549, "timestamp": "01:01:34", "text": "えっと、ルナを使うべきじゃなかった"}, {"type": "subtitle", "time": 3697.27, "timestamp": "01:01:37", "text": "タイトルとか何かわからないけど、私はこう思う"}, {"type": "subtitle", "time": 3700.069, "timestamp": "01:01:40", "text": "混乱した。私は次のような記事を見た。"}, {"type": "subtitle", "time": 3704.87, "timestamp": "01:01:44", "text": "ルナを使うのは非公式で大丈夫です。"}, {"type": "subtitle", "time": 3707.27, "timestamp": "01:01:47", "text": "それから"}, {"type": "subtitle", "time": 3711.03, "timestamp": "01:01:51", "text": "えっと、中国語を使えばいいんだけど、"}, {"type": "subtitle", "time": 3714.549, "timestamp": "01:01:54", "text": "他の場所と同じように使用してください"}, {"type": "subtitle", "time": 3716.95, "timestamp": "01:01:56", "text": "良くない。だから私は本当に混乱している"}, {"type": "subtitle", "time": 3719.43, "timestamp": "01:01:59", "text": "私がすべきこと。でも、それは"}]
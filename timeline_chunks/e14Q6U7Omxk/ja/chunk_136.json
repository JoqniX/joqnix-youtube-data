[{"type": "subtitle", "time": 8160.709, "timestamp": "02:16:00", "text": "うん。うん。本当に良いです。おお。"}, {"type": "subtitle", "time": 8164.87, "timestamp": "02:16:04", "text": "それでは次に進みましょう。だからあなたはまた"}, {"type": "subtitle", "time": 8167.03, "timestamp": "02:16:07", "text": "アパートに住んでいて、"}, {"type": "subtitle", "time": 8169.99, "timestamp": "02:16:09", "text": "5階。よし。"}, {"type": "subtitle", "time": 8173.109, "timestamp": "02:16:13", "text": "夜にもう一度行くんだ。いくつか"}, {"type": "subtitle", "time": 8176.629, "timestamp": "02:16:16", "text": "キッチンの近くに水があり、"}, {"type": "subtitle", "time": 8179.75, "timestamp": "02:16:19", "text": "今回はそこに窓があった。よし。今"}, {"type": "subtitle", "time": 8182.47, "timestamp": "02:16:22", "text": "あなたはなぜか右の方を見る。私"}, {"type": "subtitle", "time": 8184.55, "timestamp": "02:16:24", "text": "わからない。あなたは男が"}, {"type": "subtitle", "time": 8188.229, "timestamp": "02:16:28", "text": "別の建物で殺害されたんですよね？の"}, {"type": "subtitle", "time": 8191.35, "timestamp": "02:16:31", "text": "男は君を見た、君を見た、指をさした"}, {"type": "subtitle", "time": 8194.709, "timestamp": "02:16:34", "text": "彼はあなたを見て、上下を指差した。"}, {"type": "subtitle", "time": 8198.549, "timestamp": "02:16:38", "text": "2、3回繰り返しただけで、君は逃げ出した。それで、"}, {"type": "subtitle", "time": 8200.95, "timestamp": "02:16:40", "text": "そこで何が起こったのですか？なぜこれが"}, {"type": "subtitle", "time": 8204.389, "timestamp": "02:16:44", "text": "上下を指している？"}, {"type": "subtitle", "time": 8207.349, "timestamp": "02:16:47", "text": "はぁ？上下を指す。目ではない"}, {"type": "subtitle", "time": 8210.309, "timestamp": "02:16:50", "text": "方向は上下だが、指し示す方向は"}, {"type": "subtitle", "time": 8212.79, "timestamp": "02:16:52", "text": "指を上下に動かす。彼"}, {"type": "subtitle", "time": 8216.23, "timestamp": "02:16:56", "text": "彼はあなたを指さし、そして彼は上に上がります"}, {"type": "subtitle", "time": 8218.469, "timestamp": "02:16:58", "text": "下へ下へ下へ、そしてあなたは"}]
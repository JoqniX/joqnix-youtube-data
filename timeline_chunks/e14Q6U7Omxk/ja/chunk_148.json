[{"type": "subtitle", "time": 8880.15, "timestamp": "02:28:00", "text": "うん。彼が"}, {"type": "subtitle", "time": 8881.99, "timestamp": "02:28:01", "text": "私の後ろにいるんですよ。"}, {"type": "subtitle", "time": 8884.79, "timestamp": "02:28:04", "text": "彼はただ自分の一日を過ごすだけで、誰も言うことはできない"}, {"type": "subtitle", "time": 8892.23, "timestamp": "02:28:12", "text": "ええ、それはかなり急速にエスカレートしましたね。"}, {"type": "subtitle", "time": 8900.87, "timestamp": "02:28:20", "text": "えっと、どうしたの？ええ、私は"}, {"type": "subtitle", "time": 8904.79, "timestamp": "02:28:24", "text": "日。今から一日を始めます。私はここにいます。"}, {"type": "subtitle", "time": 8906.87, "timestamp": "02:28:26", "text": "ええ、始めたばかりだって言ってましたよね？"}, {"type": "subtitle", "time": 8910.07, "timestamp": "02:28:30", "text": "あなたは今、私に言ったように始めたばかりです、"}, {"type": "subtitle", "time": 8912.79, "timestamp": "02:28:32", "text": "右？あなたはまだ何もかも始めたばかりだ。"}, {"type": "subtitle", "time": 8918.23, "timestamp": "02:28:38", "text": "すべて順調でしたか？どんな頭痛でも"}, {"type": "subtitle", "time": 8920.309, "timestamp": "02:28:40", "text": "もの？何か食べ物を手に入れましたか、"}, {"type": "subtitle", "time": 8922.23, "timestamp": "02:28:42", "text": "あなたはECに飛びついた瞬間"}, {"type": "subtitle", "time": 8924.15, "timestamp": "02:28:44", "text": "起きろ？"}, {"type": "subtitle", "time": 8929.59, "timestamp": "02:28:49", "text": "昼食を食べ、紅茶を淹れた。そして私は"}, {"type": "subtitle", "time": 8932.87, "timestamp": "02:28:52", "text": "ええ、そうですね。お湯と普通の"}, {"type": "subtitle", "time": 8935.75, "timestamp": "02:28:55", "text": "水を持ってきて、お茶を二階に持って行った。うん。"}, {"type": "subtitle", "time": 8938.71, "timestamp": "02:28:58", "text": "2階で紅茶を飲んでいます。うん。"}]
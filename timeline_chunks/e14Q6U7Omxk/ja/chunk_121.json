[{"type": "subtitle", "time": 7261.91, "timestamp": "02:01:01", "text": "今日はどんな一日でしたか？よくやった。それはとても"}, {"type": "subtitle", "time": 7264.709, "timestamp": "02:01:04", "text": "大変だよ、わかるだろ？あ、そういえば、"}, {"type": "subtitle", "time": 7267.669, "timestamp": "02:01:07", "text": "素晴らしいアビナとロナード。彼らは挨拶します"}, {"type": "subtitle", "time": 7270.95, "timestamp": "02:01:10", "text": "あなた。こんにちは。うん、私の配信でね。わかった。"}, {"type": "subtitle", "time": 7275.589, "timestamp": "02:01:15", "text": "こんにちは、チャットさん。いらっしゃいませ。うん。"}, {"type": "subtitle", "time": 7279.03, "timestamp": "02:01:19", "text": "さて、ジョスに注目してみましょう。"}, {"type": "subtitle", "time": 7281.91, "timestamp": "02:01:21", "text": "右？だからジョス、それはそれはそれはそれはそれは"}, {"type": "subtitle", "time": 7284.149, "timestamp": "02:01:24", "text": "難しい。よし。とても難しいのは、"}, {"type": "subtitle", "time": 7287.43, "timestamp": "02:01:27", "text": "私はノートパソコンを、えっと、"}, {"type": "subtitle", "time": 7289.189, "timestamp": "02:01:29", "text": "メンテナンス関連。だから私はそれを手に入れなければならない"}, {"type": "subtitle", "time": 7291.91, "timestamp": "02:01:31", "text": "2時30分までに。 3分40秒だった。それから私は行かなければならなかった"}, {"type": "subtitle", "time": 7293.99, "timestamp": "02:01:33", "text": "父の持ち物へ。しかし、それは私を"}, {"type": "subtitle", "time": 7296.87, "timestamp": "02:01:36", "text": "ちょうど5時頃に自由になったところだった。"}, {"type": "subtitle", "time": 7298.55, "timestamp": "02:01:38", "text": "ストリームを保持して開く"}, {"type": "subtitle", "time": 7300.709, "timestamp": "02:01:40", "text": "できるだけ早くね。"}, {"type": "subtitle", "time": 7304.229, "timestamp": "02:01:44", "text": "うん。うん。大丈夫。心配ない。した"}, {"type": "subtitle", "time": 7306.709, "timestamp": "02:01:46", "text": "私の写真が表示されますか？更新できます"}, {"type": "subtitle", "time": 7308.79, "timestamp": "02:01:48", "text": "その情報源。"}, {"type": "subtitle", "time": 7311.03, "timestamp": "02:01:51", "text": "なぜそうならなかったのか？そうねぇ。そうねぇ。"}, {"type": "subtitle", "time": 7313.669, "timestamp": "02:01:53", "text": "ちょっと待ってください。ゆっくりしてください。あなた"}, {"type": "subtitle", "time": 7315.109, "timestamp": "02:01:55", "text": "話し方さえも変わってしまった。"}, {"type": "subtitle", "time": 7317.43, "timestamp": "02:01:57", "text": "お前。"}, {"type": "subtitle", "time": 7319.589, "timestamp": "02:01:59", "text": "君のおかげで、僕の話し方が変わったよ。"}]
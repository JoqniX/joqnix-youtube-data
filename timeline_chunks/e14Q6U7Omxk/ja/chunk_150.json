[{"type": "subtitle", "time": 9001.91, "timestamp": "02:30:01", "text": "それとすべての"}, {"type": "subtitle", "time": 9003.75, "timestamp": "02:30:03", "text": "そんな感じ。"}, {"type": "subtitle", "time": 9005.349, "timestamp": "02:30:05", "text": "あなたは私にスケジュールについて教えてくれました。あなたが持っている"}, {"type": "subtitle", "time": 9007.429, "timestamp": "02:30:07", "text": "ハンサムな銀行員。だからそれが"}, {"type": "subtitle", "time": 9009.67, "timestamp": "02:30:09", "text": "まず、だからこそ私は毎回尋ねるのです"}, {"type": "subtitle", "time": 9011.51, "timestamp": "02:30:11", "text": "ストリームに来て、私が尋ねるように"}, {"type": "subtitle", "time": 9013.349, "timestamp": "02:30:13", "text": "睡眠は取れましたか？気に入りましたか？"}, {"type": "subtitle", "time": 9015.349, "timestamp": "02:30:15", "text": "食べ物とかそういうものを食べるんだよ、わかるだろ？"}, {"type": "subtitle", "time": 9017.99, "timestamp": "02:30:17", "text": "あなたはただ集中するタイプの人です"}, {"type": "subtitle", "time": 9020.15, "timestamp": "02:30:20", "text": "レベル上げとか、そういうことだよ。うん。"}, {"type": "subtitle", "time": 9022.15, "timestamp": "02:30:22", "text": "自分の体を大切にしろよ。確かに、確かに、"}, {"type": "subtitle", "time": 9025.11, "timestamp": "02:30:25", "text": "真実。うん、私についてきて。私は"}, {"type": "subtitle", "time": 9027.51, "timestamp": "02:30:27", "text": "眠らせたりとか、そういうことだよ。私"}, {"type": "subtitle", "time": 9029.11, "timestamp": "02:30:29", "text": "悪い癖を君に分け与えるよ。しないで"}, {"type": "subtitle", "time": 9034.95, "timestamp": "02:30:34", "text": "私はそういう意味ではちょっと怠け者なんです。"}, {"type": "subtitle", "time": 9036.45, "timestamp": "02:30:36", "text": "あなたが知っている。"}, {"type": "subtitle", "time": 9037.67, "timestamp": "02:30:37", "text": "[音楽]"}, {"type": "subtitle", "time": 9040.309, "timestamp": "02:30:40", "text": "そういうこともある。全てが困難だ。始めた"}, {"type": "subtitle", "time": 9043.349, "timestamp": "02:30:43", "text": "これってまさにこれ。私は欲しい 私は欲しくない"}, {"type": "subtitle", "time": 9045.349, "timestamp": "02:30:45", "text": "お見せしましょうか？"}, {"type": "subtitle", "time": 9046.87, "timestamp": "02:30:46", "text": "いいえ、"}, {"type": "subtitle", "time": 9049.91, "timestamp": "02:30:49", "text": "私はミュージックビデオの制作に取り組んでいました。"}, {"type": "subtitle", "time": 9051.75, "timestamp": "02:30:51", "text": "実は、音楽を入れたかったんです"}, {"type": "subtitle", "time": 9054.309, "timestamp": "02:30:54", "text": "ストリームのビデオはストリームではない"}, {"type": "subtitle", "time": 9056.389, "timestamp": "02:30:56", "text": "私のチャンネルとかに投稿してね。"}]
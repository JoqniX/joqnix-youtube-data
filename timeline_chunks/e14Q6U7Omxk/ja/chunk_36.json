[{"type": "subtitle", "time": 2163.51, "timestamp": "00:36:03", "text": "だから私は誰かの気分や"}, {"type": "subtitle", "time": 2166.31, "timestamp": "00:36:06", "text": "彼らは私たちを見ているので、もっと悪くなるだろう"}, {"type": "subtitle", "time": 2168.63, "timestamp": "00:36:08", "text": "憎悪命令のようなもの、あるいは"}, {"type": "subtitle", "time": 2170.87, "timestamp": "00:36:10", "text": "チャットや"}, {"type": "subtitle", "time": 2173.589, "timestamp": "00:36:13", "text": "そんな感じのことです。わかった。"}, {"type": "subtitle", "time": 2175.589, "timestamp": "00:36:15", "text": "可愛さを忘れないでね。それは"}, {"type": "subtitle", "time": 2181.589, "timestamp": "00:36:21", "text": "あまり顔を出せなくて申し訳ありません。"}, {"type": "subtitle", "time": 2185.349, "timestamp": "00:36:25", "text": "いいえ、大丈夫です。心配しないで。あなたが知っている、"}, {"type": "subtitle", "time": 2187.349, "timestamp": "00:36:27", "text": "ほら、ほら、私は、ええと、私は"}, {"type": "subtitle", "time": 2190.63, "timestamp": "00:36:30", "text": "ソロで動画を撮影してストリーミング配信をしています"}, {"type": "subtitle", "time": 2194.63, "timestamp": "00:36:34", "text": "何年も。だから、私は動くのが好き"}, {"type": "subtitle", "time": 2196.47, "timestamp": "00:36:36", "text": "自分自身。"}, {"type": "subtitle", "time": 2198.15, "timestamp": "00:36:38", "text": "うん。しかし、時には"}, {"type": "subtitle", "time": 2200.63, "timestamp": "00:36:40", "text": "コラボ配信かゲームみたいなもの、ゲームじゃない"}, {"type": "subtitle", "time": 2202.87, "timestamp": "00:36:42", "text": "ストリーム、でもコラボストリーム、負けた時"}, {"type": "subtitle", "time": 2206.069, "timestamp": "00:36:46", "text": "チャットの焦点は、私が"}, {"type": "subtitle", "time": 2210.71, "timestamp": "00:36:50", "text": "脆弱だと言えるでしょう。"}, {"type": "subtitle", "time": 2214.069, "timestamp": "00:36:54", "text": "でも、それ以外は、"}, {"type": "subtitle", "time": 2216.47, "timestamp": "00:36:56", "text": "えっと、あなたがそこにいなくても大丈夫です"}]
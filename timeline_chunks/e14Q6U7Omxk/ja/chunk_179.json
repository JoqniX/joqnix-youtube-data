[{"type": "subtitle", "time": 10759.349, "timestamp": "02:59:19", "text": "ほら、私はここにいるよ。"}, {"type": "subtitle", "time": 10761.67, "timestamp": "02:59:21", "text": "おかえり。"}, {"type": "subtitle", "time": 10764.389, "timestamp": "02:59:24", "text": "わかった。それで、まず最初に知りたかったのは"}, {"type": "subtitle", "time": 10766.87, "timestamp": "02:59:26", "text": "君はたくさんの勇気を持っているね"}, {"type": "subtitle", "time": 10769.03, "timestamp": "02:59:29", "text": "拒絶されることを覚悟して、こういうことを始める"}, {"type": "subtitle", "time": 10771.19, "timestamp": "02:59:31", "text": "などなど、でもどうやって"}, {"type": "subtitle", "time": 10773.67, "timestamp": "02:59:33", "text": "あなたは、このアイデアをとても大きなものとして理解しました"}, {"type": "subtitle", "time": 10776.23, "timestamp": "02:59:36", "text": "コラボって、どうやって交差したか知ってる？"}, {"type": "subtitle", "time": 10778.07, "timestamp": "02:59:38", "text": "あなたの心は？"}, {"type": "subtitle", "time": 10782.55, "timestamp": "02:59:42", "text": "ああ、私は、ああ、えっと、最初は"}, {"type": "subtitle", "time": 10786.309, "timestamp": "02:59:46", "text": "ジョアソンは私がすることだけを扱って欲しかった"}, {"type": "subtitle", "time": 10789.03, "timestamp": "02:59:49", "text": "物やその他すべて。それから私は思った、"}, {"type": "subtitle", "time": 10792.469, "timestamp": "02:59:52", "text": "えっと、ああ、それからサブマラソンで気づいたんです"}, {"type": "subtitle", "time": 10795.91, "timestamp": "02:59:55", "text": "ゲストなどを開くことができます"}, {"type": "subtitle", "time": 10799.03, "timestamp": "02:59:59", "text": "例えば、私が寝ているとき、"}]
[{"type": "subtitle", "time": 3901.51, "timestamp": "01:05:01", "text": "別の場所、そしてそのウェブサイト。私は"}, {"type": "subtitle", "time": 3903.349, "timestamp": "01:05:03", "text": "まるで、全部失ってしまうかのような気分だ。私は"}, {"type": "subtitle", "time": 3905.75, "timestamp": "01:05:05", "text": "全てを失うことになるだろう、それは悪いことだ"}, {"type": "subtitle", "time": 3908.23, "timestamp": "01:05:08", "text": "悪いし、それは大変だろう"}, {"type": "subtitle", "time": 3910.309, "timestamp": "01:05:10", "text": "私に任せて。それはまるで私の料理を削除するようなものだ"}, {"type": "subtitle", "time": 3912.47, "timestamp": "01:05:12", "text": "YouTubeチャンネルから"}, {"type": "subtitle", "time": 3917.029, "timestamp": "01:05:17", "text": "スクラッチの瞬間。 「ああ、なんてことだ、"}, {"type": "subtitle", "time": 3921.589, "timestamp": "01:05:21", "text": "えっと、痛いでしょうね。とにかく、"}, {"type": "subtitle", "time": 3924.15, "timestamp": "01:05:24", "text": "ゲームに参加する。頑張れよ。私はただ"}, {"type": "subtitle", "time": 3927.589, "timestamp": "01:05:27", "text": "鬱憤を晴らす。だから、私は"}, {"type": "subtitle", "time": 3932.23, "timestamp": "01:05:32", "text": "本当に何日も心配していました"}, {"type": "subtitle", "time": 3935.43, "timestamp": "01:05:35", "text": "ここ数日ほど。新"}, {"type": "subtitle", "time": 3937.91, "timestamp": "01:05:37", "text": "年間ストリーム。"}, {"type": "subtitle", "time": 3939.91, "timestamp": "01:05:39", "text": "うん。うん。"}, {"type": "subtitle", "time": 3941.829, "timestamp": "01:05:41", "text": "一種の痛みだ。でも私は"}, {"type": "subtitle", "time": 3944.23, "timestamp": "01:05:44", "text": "そこへストリーミング配信する"}, {"type": "subtitle", "time": 3947.109, "timestamp": "01:05:47", "text": "もっと。"}, {"type": "subtitle", "time": 3949.75, "timestamp": "01:05:49", "text": "でも、たとえそこで配信できたとしても、"}, {"type": "subtitle", "time": 3951.99, "timestamp": "01:05:51", "text": "複雑な問題がたくさんある。意味"}, {"type": "subtitle", "time": 3955.589, "timestamp": "01:05:55", "text": "YouTubeやTwitchのやり方が気に入らない"}, {"type": "subtitle", "time": 3958.23, "timestamp": "01:05:58", "text": "過去の記録を保存するオプション機能"}]
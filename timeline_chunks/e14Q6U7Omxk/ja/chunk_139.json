[{"type": "subtitle", "time": 8341.27, "timestamp": "02:19:01", "text": "などなど。だから妹は、女の子は"}, {"type": "subtitle", "time": 8345.509, "timestamp": "02:19:05", "text": "妹を殺したことを嘆いていた。それで"}, {"type": "subtitle", "time": 8352.629, "timestamp": "02:19:12", "text": "あなたはまたしても通常の回答に戻っています。私"}, {"type": "subtitle", "time": 8353.99, "timestamp": "02:19:13", "text": "どうやって与え続けているのか分からない"}, {"type": "subtitle", "time": 8355.99, "timestamp": "02:19:15", "text": "通常の回答は、あなたが与えるようなものです"}, {"type": "subtitle", "time": 8358.309, "timestamp": "02:19:18", "text": "毎回的確な回答"}, {"type": "subtitle", "time": 8361.19, "timestamp": "02:19:21", "text": "男。まるであなたが私に普通の答えをくれたように"}, {"type": "subtitle", "time": 8365.03, "timestamp": "02:19:25", "text": "また。サイコパスの答えは"}, {"type": "subtitle", "time": 8369.509, "timestamp": "02:19:29", "text": "彼女は彼を殺した、なぜなら、つまり殺したから"}, {"type": "subtitle", "time": 8373.349, "timestamp": "02:19:33", "text": "彼女はまたその男に会うことになるから"}, {"type": "subtitle", "time": 8376.389, "timestamp": "02:19:36", "text": "次の葬儀で。"}, {"type": "subtitle", "time": 8379.11, "timestamp": "02:19:39", "text": "おお。"}, {"type": "subtitle", "time": 8381.99, "timestamp": "02:19:41", "text": "それはひどい話だよ、おい。うん。"}, {"type": "subtitle", "time": 8383.509, "timestamp": "02:19:43", "text": "だから私は死の計画に関する動画が好きなんです。"}, {"type": "subtitle", "time": 8385.19, "timestamp": "02:19:45", "text": "アニメーションみたいなものもあるんだよ。"}, {"type": "subtitle", "time": 8386.629, "timestamp": "02:19:46", "text": "彼らの映像を使うかもしれない。私は与えなければならない"}, {"type": "subtitle", "time": 8388.309, "timestamp": "02:19:48", "text": "この配信で彼らにクレジットなどが記載されています。"}, {"type": "subtitle", "time": 8391.19, "timestamp": "02:19:51", "text": "まあ、そうしてもいいだろう。でも6くらい"}, {"type": "subtitle", "time": 8398.309, "timestamp": "02:19:58", "text": "これまでのところ、私たちの状況はどうでしょうか？これまでのところ"}, {"type": "subtitle", "time": 8399.75, "timestamp": "02:19:59", "text": "ごく普通だ。私はそう思っていました"}]
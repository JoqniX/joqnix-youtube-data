[{"type": "subtitle", "time": 7801.189, "timestamp": "02:10:01", "text": "元気です。ヘリオン、元気かい？"}, {"type": "subtitle", "time": 7805.35, "timestamp": "02:10:05", "text": "元気です。えっと、本当に"}, {"type": "subtitle", "time": 7808.069, "timestamp": "02:10:08", "text": "ちゃんとした会話をしたかったんだけど"}, {"type": "subtitle", "time": 7811.51, "timestamp": "02:10:11", "text": "夜は君と一緒だけど、私はこう思った、"}, {"type": "subtitle", "time": 7814.47, "timestamp": "02:10:14", "text": "どうすればいいでしょうか？何を詰めたらいいですか？私は好きです"}, {"type": "subtitle", "time": 7815.99, "timestamp": "02:10:15", "text": "かなり遅いですが、心配しないでください"}, {"type": "subtitle", "time": 7818.47, "timestamp": "02:10:18", "text": "その物。よし。そういうこともある。それ"}, {"type": "subtitle", "time": 7822.069, "timestamp": "02:10:22", "text": "起こる。うん。うん。うん。つまり、私たちは"}, {"type": "subtitle", "time": 7824.79, "timestamp": "02:10:24", "text": "将来いつでも一緒に遊べるよ。私は"}, {"type": "subtitle", "time": 7826.709, "timestamp": "02:10:26", "text": "ここに11ヶ月滞在します。それはかなり"}, {"type": "subtitle", "time": 7829.75, "timestamp": "02:10:29", "text": "楽しかったよ、相棒。もしそうだったらかなり楽しいだろう"}, {"type": "subtitle", "time": 7831.669, "timestamp": "02:10:31", "text": "俺に聞くなら、そう言うよ。それは本当に"}, {"type": "subtitle", "time": 7836.629, "timestamp": "02:10:36", "text": "私と一緒に楽しもう。少なくとも私にとってはそうだ。うん。"}, {"type": "subtitle", "time": 7839.109, "timestamp": "02:10:39", "text": "ああ、心配しないでください。ありがとう。ありがとう"}, {"type": "subtitle", "time": 7841.03, "timestamp": "02:10:41", "text": "お願いしてくれてありがとう"}, {"type": "subtitle", "time": 7843.91, "timestamp": "02:10:43", "text": "アドバイスを、姉さん。ジョークを言ってください。私にとって犬は欠かせない存在です。"}, {"type": "subtitle", "time": 7848.31, "timestamp": "02:10:48", "text": "ありがとう。うん。というわけで、私たちはここにいます。どうやって"}, {"type": "subtitle", "time": 7851.03, "timestamp": "02:10:51", "text": "何をしているの？私たちは既に出発しています。"}, {"type": "subtitle", "time": 7854.39, "timestamp": "02:10:54", "text": "まあ、そういうことです。最新情報は？"}, {"type": "subtitle", "time": 7858.629, "timestamp": "02:10:58", "text": "今？私たちは何をしているのでしょうか？私は、えーと、"}]
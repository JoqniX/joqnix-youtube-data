[{"type": "subtitle", "time": 14702.87, "timestamp": "04:05:02", "text": "例えば、5501ドル投資して、次に625ドルを投資する"}, {"type": "subtitle", "time": 14704.79, "timestamp": "04:05:04", "text": "そしてあなたの投資総額は次のようになります"}, {"type": "subtitle", "time": 14707.59, "timestamp": "04:05:07", "text": "月5000ドルとかそういう感じ"}, {"type": "subtitle", "time": 14711.349, "timestamp": "04:05:11", "text": "それが正しいやり方だ。おお"}, {"type": "subtitle", "time": 14714.07, "timestamp": "04:05:14", "text": "うん、私も失敗からそれを学んだよ。私"}, {"type": "subtitle", "time": 14717.349, "timestamp": "04:05:17", "text": "たぶん400ルピーくらい損したと思う。それは"}, {"type": "subtitle", "time": 14720.309, "timestamp": "04:05:20", "text": "小さい。幸いなことに、大きな損失はなかった。"}, {"type": "subtitle", "time": 14722.229, "timestamp": "04:05:22", "text": "でも、私はそれを学んだし、"}, {"type": "subtitle", "time": 14723.91, "timestamp": "04:05:23", "text": "失ったためにそれを忘れることはない"}, {"type": "subtitle", "time": 14725.91, "timestamp": "04:05:25", "text": "お金。"}, {"type": "subtitle", "time": 14727.91, "timestamp": "04:05:27", "text": "ああ、それはあなたが知っている最高のことです"}, {"type": "subtitle", "time": 14730.309, "timestamp": "04:05:30", "text": "間違い、人生における間違い。学ぶ"}, {"type": "subtitle", "time": 14732.15, "timestamp": "04:05:32", "text": "多く。"}, {"type": "subtitle", "time": 14741.83, "timestamp": "04:05:41", "text": "くそ。沈黙はうるさすぎるんだよ、おい。うん。"}, {"type": "subtitle", "time": 14744.389, "timestamp": "04:05:44", "text": "外。私はそれを考えていた。おお、"}, {"type": "subtitle", "time": 14747.99, "timestamp": "04:05:47", "text": "これには本当にたくさんの要素があるんだよ。これ"}, {"type": "subtitle", "time": 14751.67, "timestamp": "04:05:51", "text": "大きすぎるんです。それはやりすぎだ。"}, {"type": "subtitle", "time": 14754.63, "timestamp": "04:05:54", "text": "ええ、正直に言うと、それは"}, {"type": "subtitle", "time": 14757.75, "timestamp": "04:05:57", "text": "誰かに情報が多すぎる"}, {"type": "subtitle", "time": 14759.75, "timestamp": "04:05:59", "text": "同じ地点で。いいね"}]
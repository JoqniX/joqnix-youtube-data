[{"type": "subtitle", "time": 6366.629, "timestamp": "01:46:06", "text": "ああ、彼は私の体を奪った。"}, {"type": "subtitle", "time": 6368.31, "timestamp": "01:46:08", "text": "今期新作アニメは何か見てますか？"}, {"type": "subtitle", "time": 6369.99, "timestamp": "01:46:09", "text": "うん、最近アニメをたくさん見てるよ"}, {"type": "subtitle", "time": 6372.79, "timestamp": "01:46:12", "text": "今シーズン。あなたが知っている、"}, {"type": "subtitle", "time": 6375.27, "timestamp": "01:46:15", "text": "以前は、見ているときは"}, {"type": "subtitle", "time": 6381.109, "timestamp": "01:46:21", "text": "アニメは毎日、毎週、どのように"}, {"type": "subtitle", "time": 6383.51, "timestamp": "01:46:23", "text": "私はある意味、怠け者なんです。それは"}, {"type": "subtitle", "time": 6387.59, "timestamp": "01:46:27", "text": "それはかつて私が言っていたことだった。"}, {"type": "subtitle", "time": 6396.149, "timestamp": "01:46:36", "text": "そうそう。君たちはこれを変えるように言った"}, {"type": "subtitle", "time": 6398.95, "timestamp": "01:46:38", "text": "笑い声ですよね？私は変える必要がある"}]
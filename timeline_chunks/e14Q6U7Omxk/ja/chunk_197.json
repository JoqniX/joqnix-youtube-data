[{"type": "subtitle", "time": 11821.51, "timestamp": "03:17:01", "text": "Illustratorでレイヤーを変更すると、"}, {"type": "subtitle", "time": 11823.59, "timestamp": "03:17:03", "text": "不透明度を変更、ブレンドを変更"}, {"type": "subtitle", "time": 11826.309, "timestamp": "03:17:06", "text": "モードにして、そこから何か新しいものを作り出す"}, {"type": "subtitle", "time": 11829.269, "timestamp": "03:17:09", "text": "えっと、インスピレーションを得て、"}, {"type": "subtitle", "time": 11831.99, "timestamp": "03:17:11", "text": "何か新しいことがあって、"}, {"type": "subtitle", "time": 11835.19, "timestamp": "03:17:15", "text": "自分で描いてみました"}, {"type": "subtitle", "time": 11837.67, "timestamp": "03:17:17", "text": "ペンツールとか全部、そしてそれは"}, {"type": "subtitle", "time": 11840.469, "timestamp": "03:17:20", "text": "どうやってこれらのことを学んだか"}, {"type": "subtitle", "time": 11843.19, "timestamp": "03:17:23", "text": "私のインスタグラム、古い"}, {"type": "subtitle", "time": 11845.51, "timestamp": "03:17:25", "text": "すべてと一つ。私は以前は"}, {"type": "subtitle", "time": 11849.11, "timestamp": "03:17:29", "text": "ロゴも何もかも。だから、私はそうした。私"}, {"type": "subtitle", "time": 11851.349, "timestamp": "03:17:31", "text": "カードとか色々作ったよ。そして私は"}, {"type": "subtitle", "time": 11853.75, "timestamp": "03:17:33", "text": "その頃、私は"}, {"type": "subtitle", "time": 11856.15, "timestamp": "03:17:36", "text": "TwitchでJocnixとして配信中。私"}, {"type": "subtitle", "time": 11860.63, "timestamp": "03:17:40", "text": "uhという名前のストリーマーに偶然出会いました"}, {"type": "subtitle", "time": 11864.55, "timestamp": "03:17:44", "text": "寿司ドラゴン。彼がやっていることは"}, {"type": "subtitle", "time": 11867.269, "timestamp": "03:17:47", "text": "ストリーミングですが、彼は多くの"}, {"type": "subtitle", "time": 11870.07, "timestamp": "03:17:50", "text": "ライブ編集のような技術的なもの"}, {"type": "subtitle", "time": 11872.87, "timestamp": "03:17:52", "text": "彼の配信。まるでビデオみたいじゃない"}, {"type": "subtitle", "time": 11875.11, "timestamp": "03:17:55", "text": "そしてアニメーション音楽のような努力を"}, {"type": "subtitle", "time": 11878.07, "timestamp": "03:17:58", "text": "動画ですよね？ AMVはそうではないが"}]
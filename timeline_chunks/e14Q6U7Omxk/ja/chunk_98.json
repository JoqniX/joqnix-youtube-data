[{"type": "subtitle", "time": 5891.27, "timestamp": "01:38:11", "text": "それはいいです。"}, {"type": "subtitle", "time": 5893.109, "timestamp": "01:38:13", "text": "そうそう。私は地道な努力をしなければならない。えーと"}, {"type": "subtitle", "time": 5896.229, "timestamp": "01:38:16", "text": "すべてのイベントのグラインド"}, {"type": "subtitle", "time": 5903.99, "timestamp": "01:38:23", "text": "でも、最近は何が"}, {"type": "subtitle", "time": 5906.149, "timestamp": "01:38:26", "text": "まるで私が"}, {"type": "subtitle", "time": 5910.55, "timestamp": "01:38:30", "text": "たくさんのものを逃している"}, {"type": "subtitle", "time": 5931.109, "timestamp": "01:38:51", "text": "でも、最近は、そうですよね？私は"}, {"type": "subtitle", "time": 5934.709, "timestamp": "01:38:54", "text": "私が良いことを言っていると思いますか？私"}, {"type": "subtitle", "time": 5937.27, "timestamp": "01:38:57", "text": "話す練習が必要だと思う"}, {"type": "subtitle", "time": 5939.109, "timestamp": "01:38:59", "text": "もの。"}]
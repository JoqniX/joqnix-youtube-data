[{"type": "subtitle", "time": 10380.87, "timestamp": "02:53:00", "text": "もう一つ。私はすでに、"}, {"type": "subtitle", "time": 10382.55, "timestamp": "02:53:02", "text": "光はもう始まっているんだよ"}, {"type": "subtitle", "time": 10390.55, "timestamp": "02:53:10", "text": "うん。うん。"}, {"type": "subtitle", "time": 10392.63, "timestamp": "02:53:12", "text": "自分の分野に精通している。私は「よし、私は"}, {"type": "subtitle", "time": 10397.75, "timestamp": "02:53:17", "text": "あなたは、あなたは、「あなたは行く」"}, {"type": "subtitle", "time": 10399.429, "timestamp": "02:53:19", "text": "「何かをするとか、そういうことをする？」そして私は"}, {"type": "subtitle", "time": 10401.03, "timestamp": "02:53:21", "text": "「うん、"}, {"type": "subtitle", "time": 10403.83, "timestamp": "02:53:23", "text": "彼は努力している。彼は"}, {"type": "subtitle", "time": 10405.67, "timestamp": "02:53:25", "text": "努力。これ、すごく好き。その人柄が大好きです。"}, {"type": "subtitle", "time": 10407.269, "timestamp": "02:53:27", "text": "「すべてを愛する。」だから私はここにいる"}, {"type": "subtitle", "time": 10409.429, "timestamp": "02:53:29", "text": "流れの中でね。ああ、ありがとうございます。"}, {"type": "subtitle", "time": 10412.469, "timestamp": "02:53:32", "text": "他の人も知ってるよ。まるで私が見ているように"}, {"type": "subtitle", "time": 10416.71, "timestamp": "02:53:36", "text": "他のユーチューバーも同様ですが、"}, {"type": "subtitle", "time": 10418.63, "timestamp": "02:53:38", "text": "性格とか、私が好きじゃないもの。"}, {"type": "subtitle", "time": 10420.79, "timestamp": "02:53:40", "text": "大丈夫。すぐにわかるように"}, {"type": "subtitle", "time": 10423.51, "timestamp": "02:53:43", "text": "どちらか一方が嘘をついているのか、それとも本当に嘘をついているのか。うん。平"}, {"type": "subtitle", "time": 10425.75, "timestamp": "02:53:45", "text": "画面に画像が表示されている場合、"}, {"type": "subtitle", "time": 10427.67, "timestamp": "02:53:47", "text": "知ってるよ、君がわかるよ"}, {"type": "subtitle", "time": 10429.67, "timestamp": "02:53:49", "text": "声"}, {"type": "subtitle", "time": 10431.91, "timestamp": "02:53:51", "text": "誰が嘘をついているとか、そういうことだよ。その"}, {"type": "subtitle", "time": 10434.15, "timestamp": "02:53:54", "text": "それほど簡単だ。わからない。待って、どうやって"}, {"type": "subtitle", "time": 10436.55, "timestamp": "02:53:56", "text": "あなたは区別しますか？"}]
[{"type": "subtitle", "time": 13144.55, "timestamp": "03:39:04", "text": "ラジュットがえーと"}, {"type": "subtitle", "time": 13147.349, "timestamp": "03:39:07", "text": "ほら、4つのヴェラ"}, {"type": "subtitle", "time": 13150.55, "timestamp": "03:39:10", "text": "インドのような昔のシステム"}, {"type": "subtitle", "time": 13153.83, "timestamp": "03:39:13", "text": "昔のようなバータイプのもの"}, {"type": "subtitle", "time": 13156.71, "timestamp": "03:39:16", "text": "君はイエスと言ったと思うし、君のことを知っているよ"}, {"type": "subtitle", "time": 13159.59, "timestamp": "03:39:19", "text": "私たちは何度も長い話し合いをした。"}, {"type": "subtitle", "time": 13162.79, "timestamp": "03:39:22", "text": "ええと、問題は、その4人はバラモンだったということです。"}, {"type": "subtitle", "time": 13167.269, "timestamp": "03:39:27", "text": "ああ、チャトリア、ヴァシア、シュンドラ。それで"}, {"type": "subtitle", "time": 13169.51, "timestamp": "03:39:29", "text": "チャトリヤは戦士だった"}, {"type": "subtitle", "time": 13171.67, "timestamp": "03:39:31", "text": "戦闘機クラスは死ぬはずだった"}, {"type": "subtitle", "time": 13173.99, "timestamp": "03:39:33", "text": "戦場とかで、"}, {"type": "subtitle", "time": 13177.67, "timestamp": "03:39:37", "text": "彼らは守護者のような存在だった。だから"}, {"type": "subtitle", "time": 13181.03, "timestamp": "03:39:41", "text": "彼らにはラジュット族がいて、マラタ族がいて、"}, {"type": "subtitle", "time": 13185.83, "timestamp": "03:39:45", "text": "えーと、ラジュッツ、えーと、私はもっと"}, {"type": "subtitle", "time": 13189.11, "timestamp": "03:39:49", "text": "それは私の頭の中で一番上にはないけれど"}, {"type": "subtitle", "time": 13192.309, "timestamp": "03:39:52", "text": "ええ、それはギプスのようなもので、"}, {"type": "subtitle", "time": 13195.51, "timestamp": "03:39:55", "text": "キャストだけど、ギプスみたいな感じじゃないんだ"}, {"type": "subtitle", "time": 13198.71, "timestamp": "03:39:58", "text": "部族的なものみたいな感じだよ。"}]
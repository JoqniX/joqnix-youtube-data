[{"type": "subtitle", "time": 4203.51, "timestamp": "01:10:03", "text": "うん、このゲームが終わったら再開するよ。私"}, {"type": "subtitle", "time": 4205.43, "timestamp": "01:10:05", "text": "信じる"}, {"type": "subtitle", "time": 4218.709, "timestamp": "01:10:18", "text": "ああ、円とかそういうのはないよ。"}, {"type": "subtitle", "time": 4222.47, "timestamp": "01:10:22", "text": "これは良いことだ。このハードコアは良い。いいえ"}, {"type": "subtitle", "time": 4231.59, "timestamp": "01:10:31", "text": "この物に触れると、"}, {"type": "subtitle", "time": 4257.43, "timestamp": "01:10:57", "text": "[音楽]"}]
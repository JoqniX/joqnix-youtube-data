[{"type": "subtitle", "time": 12841.67, "timestamp": "03:34:01", "text": "嫌いなこと 彼らと話す"}, {"type": "subtitle", "time": 12843.269, "timestamp": "03:34:03", "text": "ただ"}, {"type": "subtitle", "time": 12844.95, "timestamp": "03:34:04", "text": "時計"}, {"type": "subtitle", "time": 12848.469, "timestamp": "03:34:08", "text": "ああ、そうだよ、そうだよ。"}, {"type": "subtitle", "time": 12851.11, "timestamp": "03:34:11", "text": "こんにちは、アジンさん。"}, {"type": "subtitle", "time": 12854.309, "timestamp": "03:34:14", "text": "うん、ジョーAZ"}, {"type": "subtitle", "time": 12855.83, "timestamp": "03:34:15", "text": "実際には挨拶もしなかった。彼はここにいる"}, {"type": "subtitle", "time": 12857.99, "timestamp": "03:34:17", "text": "待機する。彼を無視しなさい。彼を無視しなさい。"}, {"type": "subtitle", "time": 12859.429, "timestamp": "03:34:19", "text": "彼を無視しなさい。あなたは言わないだろう"}, {"type": "subtitle", "time": 12861.75, "timestamp": "03:34:21", "text": "彼が挨拶しない限り、何も言わない。"}, {"type": "subtitle", "time": 12864.55, "timestamp": "03:34:24", "text": "それは彼にとってひどいことだ。なんてこった。それは"}, {"type": "subtitle", "time": 12866.63, "timestamp": "03:34:26", "text": "悪い。まず最初に挨拶すべきなのは"}, {"type": "subtitle", "time": 12868.63, "timestamp": "03:34:28", "text": "こちらのお客様です。それは"}, {"type": "subtitle", "time": 12871.91, "timestamp": "03:34:31", "text": "悪い。とにかく"}, {"type": "subtitle", "time": 12875.429, "timestamp": "03:34:35", "text": "戻ってきます。ああ、そういうことなんだよ。"}, {"type": "subtitle", "time": 12879.349, "timestamp": "03:34:39", "text": "M ええ、いつもLに会っています。ああ、そうね。"}, {"type": "subtitle", "time": 12881.11, "timestamp": "03:34:41", "text": "マイケル・リーブスを知ってるよ、彼のことが本当に好きだ"}, {"type": "subtitle", "time": 12884.15, "timestamp": "03:34:44", "text": "接触。本当に信じられない。それはとても"}, {"type": "subtitle", "time": 12887.03, "timestamp": "03:34:47", "text": "狂人だ。どうして彼の"}, {"type": "subtitle", "time": 12890.87, "timestamp": "03:34:50", "text": "人間の心はそういう風に働くんだよ。うん。"}, {"type": "subtitle", "time": 12893.269, "timestamp": "03:34:53", "text": "うん。もし私にそんな友達がいたら"}, {"type": "subtitle", "time": 12895.51, "timestamp": "03:34:55", "text": "骨折している可能性が高いと思う"}]
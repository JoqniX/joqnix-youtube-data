[{"type": "subtitle", "time": 2760.63, "timestamp": "00:46:00", "text": "私の名前です。"}, {"type": "subtitle", "time": 2762.23, "timestamp": "00:46:02", "text": "私の最後の配信は、"}, {"type": "subtitle", "time": 2766.069, "timestamp": "00:46:06", "text": "うん、投稿して。次にスケジュールを実行する"}, {"type": "subtitle", "time": 2767.589, "timestamp": "00:46:07", "text": "ここ。"}, {"type": "subtitle", "time": 2769.43, "timestamp": "00:46:09", "text": "次の配信は金曜日と書いてあります。私は"}, {"type": "subtitle", "time": 2771.99, "timestamp": "00:46:11", "text": "これを実際に編集しています。クリックすると"}, {"type": "subtitle", "time": 2774.39, "timestamp": "00:46:14", "text": "金曜日のスケジュールはこんな感じです。それから"}, {"type": "subtitle", "time": 2777.109, "timestamp": "00:46:17", "text": "「リマインダー」というオプションがあります。"}, {"type": "subtitle", "time": 2780.87, "timestamp": "00:46:20", "text": "それをクリックすると、"}, {"type": "subtitle", "time": 2784.069, "timestamp": "00:46:24", "text": "時間。えーっと、えーっと、好きになる必要はありません"}, {"type": "subtitle", "time": 2787.03, "timestamp": "00:46:27", "text": "タイムゾーンの変換など、何でも構いません。それ"}, {"type": "subtitle", "time": 2790.47, "timestamp": "00:46:30", "text": "現地時間で表示されます。わかった。"}, {"type": "subtitle", "time": 2793.829, "timestamp": "00:46:33", "text": "ブラウザで「リマインダー」をクリックし、"}, {"type": "subtitle", "time": 2797.829, "timestamp": "00:46:37", "text": "Twitchで通知を受け取ることができます。"}, {"type": "subtitle", "time": 2800.069, "timestamp": "00:46:40", "text": "電話。 Twitchがインストールされている場合"}, {"type": "subtitle", "time": 2801.589, "timestamp": "00:46:41", "text": "あなたの携帯電話にはプッシュ通知が届きます"}, {"type": "subtitle", "time": 2803.27, "timestamp": "00:46:43", "text": "通知"}, {"type": "subtitle", "time": 2807.91, "timestamp": "00:46:47", "text": "または通知がある場合、または"}, {"type": "subtitle", "time": 2811.43, "timestamp": "00:46:51", "text": "Twitch のブラウザのように、"}, {"type": "subtitle", "time": 2814.87, "timestamp": "00:46:54", "text": "そこから先は分かりますよ。わかった。"}, {"type": "subtitle", "time": 2818.63, "timestamp": "00:46:58", "text": "では、私の場合はこうやってやるんです。"}]
[{"type": "subtitle", "time": 14400.15, "timestamp": "04:00:00", "text": "起こったことは、ある時点で私は1つ持っていた"}, {"type": "subtitle", "time": 14404.229, "timestamp": "04:00:04", "text": "そのポートフォリオには、Krosの何かが含まれている。"}, {"type": "subtitle", "time": 14406.389, "timestamp": "04:00:06", "text": "うん。そしてその人は「ええと、"}, {"type": "subtitle", "time": 14409.11, "timestamp": "04:00:09", "text": "その人が私への返信をやめた。私は試した"}, {"type": "subtitle", "time": 14414.07, "timestamp": "04:00:14", "text": "お金を引き出す。そうはなりませんでした。そして、"}, {"type": "subtitle", "time": 14418.469, "timestamp": "04:00:18", "text": "えっと、お金は出てきませんでした。えっと、"}, {"type": "subtitle", "time": 14420.55, "timestamp": "04:00:20", "text": "サイトが禁止されました"}, {"type": "subtitle", "time": 14423.189, "timestamp": "04:00:23", "text": "そして、そのDiscordサーバーもBANされた。"}, {"type": "subtitle", "time": 14427.269, "timestamp": "04:00:27", "text": "だから私の1crもすべて浮動状態です"}, {"type": "subtitle", "time": 14430.71, "timestamp": "04:00:30", "text": "あちら側のどこか遠くの方。"}, {"type": "subtitle", "time": 14432.79, "timestamp": "04:00:32", "text": "それは大ヒットだった。でも私はただ"}, {"type": "subtitle", "time": 14436.87, "timestamp": "04:00:36", "text": "説明しました。まあ、たったの100ドルですからね。"}, {"type": "subtitle", "time": 14439.03, "timestamp": "04:00:39", "text": "それだけでもかなりの額だ。ええ、そうですね。"}, {"type": "subtitle", "time": 14441.429, "timestamp": "04:00:41", "text": "それは、それは、それは学習経験です。"}, {"type": "subtitle", "time": 14444.07, "timestamp": "04:00:44", "text": "いや、説明しないで、信用しないで"}, {"type": "subtitle", "time": 14447.429, "timestamp": "04:00:47", "text": "見知らぬ人たち。そこが問題なんです。"}, {"type": "subtitle", "time": 14449.67, "timestamp": "04:00:49", "text": "確かに、確かに、確かに。"}, {"type": "subtitle", "time": 14452.309, "timestamp": "04:00:52", "text": "それは旅だった。私は"}, {"type": "subtitle", "time": 14454.229, "timestamp": "04:00:54", "text": "2日間くらいトラウマだったけど、"}, {"type": "subtitle", "time": 14459.429, "timestamp": "04:00:59", "text": "それは今となっては人生を変えるほどの金額だ。"}]
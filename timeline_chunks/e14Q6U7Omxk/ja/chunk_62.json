[{"type": "subtitle", "time": 3722.069, "timestamp": "01:02:02", "text": "それはビデオ関連のことですね。"}, {"type": "subtitle", "time": 3724.23, "timestamp": "01:02:04", "text": "私が言及していたツイッターは"}, {"type": "subtitle", "time": 3726.95, "timestamp": "01:02:06", "text": "あなたはそれを何と呼びますか？ああ、私が言っているのは"}, {"type": "subtitle", "time": 3728.95, "timestamp": "01:02:08", "text": "再び。"}, {"type": "subtitle", "time": 3731.589, "timestamp": "01:02:11", "text": "ええ、Twitterで私が言及していたのは"}, {"type": "subtitle", "time": 3734.309, "timestamp": "01:02:14", "text": "ストリーミング配信のことですよね？どうやら、"}, {"type": "subtitle", "time": 3738.39, "timestamp": "01:02:18", "text": "ストリーミングする方法は見つけたのですが、残念ながら"}, {"type": "subtitle", "time": 3740.47, "timestamp": "01:02:20", "text": "提出すべきではなかったとは知らなかった"}, {"type": "subtitle", "time": 3744.87, "timestamp": "01:02:24", "text": "私のインドのIDとか本名"}, {"type": "subtitle", "time": 3747.99, "timestamp": "01:02:27", "text": "本物かどうかの検証資料。私"}, {"type": "subtitle", "time": 3751.109, "timestamp": "01:02:31", "text": "知らなかったよ"}, {"type": "subtitle", "time": 3754.549, "timestamp": "01:02:34", "text": "ストリーミング用のメインライン中国ID。で"}, {"type": "subtitle", "time": 3758.15, "timestamp": "01:02:38", "text": "VTuberであってもストリーミングするために、"}, {"type": "subtitle", "time": 3760.15, "timestamp": "01:02:40", "text": "ランゴスまたはヴップス、"}, {"type": "subtitle", "time": 3762.63, "timestamp": "01:02:42", "text": "本名が必要です"}, {"type": "subtitle", "time": 3764.95, "timestamp": "01:02:44", "text": "識別"}, {"type": "subtitle", "time": 3767.67, "timestamp": "01:02:47", "text": "スタッフによって確認されるため"}, {"type": "subtitle", "time": 3770.63, "timestamp": "01:02:50", "text": "それをストリーミング配信する。そして私は痛みのようなものだ。そして"}, {"type": "subtitle", "time": 3773.27, "timestamp": "01:02:53", "text": "私はすでにそれを渡しました、そしてそれはすでに"}, {"type": "subtitle", "time": 3775.829, "timestamp": "01:02:55", "text": "確認済み。彼らが嫌いだったわけではない"}, {"type": "subtitle", "time": 3778.23, "timestamp": "01:02:58", "text": "彼らがそれを受け入れたという事実を拒否した"}]
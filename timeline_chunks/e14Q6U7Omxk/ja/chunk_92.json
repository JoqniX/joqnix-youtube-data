[{"type": "subtitle", "time": 5533.189, "timestamp": "01:32:13", "text": "うん、何かポップアップが出てきたのを見たよ"}, {"type": "subtitle", "time": 5536.629, "timestamp": "01:32:16", "text": "ストリームが切断されたと表示"}, {"type": "subtitle", "time": 5539.11, "timestamp": "01:32:19", "text": "再接続に成功した、あるいは何らかの反応があった。"}, {"type": "subtitle", "time": 5540.55, "timestamp": "01:32:20", "text": "一瞬接続が切れたか何かだった。"}, {"type": "subtitle", "time": 5549.189, "timestamp": "01:32:29", "text": "でも、戻ってきますよ。"}, {"type": "subtitle", "time": 5566.149, "timestamp": "01:32:46", "text": "私がすべきことは、"}, {"type": "subtitle", "time": 5577.35, "timestamp": "01:32:57", "text": "ああ、大変だ、動かない。"}]
[{"type": "subtitle", "time": 7629.75, "timestamp": "02:07:09", "text": "えーと、遅延があります。"}, {"type": "subtitle", "time": 7632.069, "timestamp": "02:07:12", "text": "これは"}, {"type": "subtitle", "time": 7634.55, "timestamp": "02:07:14", "text": "あなたが知っていること全て私はすでに"}, {"type": "subtitle", "time": 7639.43, "timestamp": "02:07:19", "text": "アカウントコールを検出していません"}, {"type": "subtitle", "time": 7643.83, "timestamp": "02:07:23", "text": "うん。えっと、検出されていないと思います"}, {"type": "subtitle", "time": 7647.669, "timestamp": "02:07:27", "text": "えっと、Discord。えっと、再起動してみてください"}, {"type": "subtitle", "time": 7650.069, "timestamp": "02:07:30", "text": "あなたのDiscord。"}, {"type": "subtitle", "time": 7653.75, "timestamp": "02:07:33", "text": "不和。待って。更新すればいいかな？"}, {"type": "subtitle", "time": 7658.31, "timestamp": "02:07:38", "text": "それ？いや、いや。 Discordアプリを開いてください。"}, {"type": "subtitle", "time": 7662.87, "timestamp": "02:07:42", "text": "Discord にアクセスしてコントロール"}, {"type": "subtitle", "time": 7664.79, "timestamp": "02:07:44", "text": "プラスR。"}, {"type": "subtitle", "time": 7667.03, "timestamp": "02:07:47", "text": "はい、Discordに行ってコントロールプラスを実行します"}, {"type": "subtitle", "time": 7674.39, "timestamp": "02:07:54", "text": "今は正常に動作しますか？わからない。ああ、"}, {"type": "subtitle", "time": 7678.069, "timestamp": "02:07:58", "text": "あなたはブラウザを使用しています。それが理由です"}]
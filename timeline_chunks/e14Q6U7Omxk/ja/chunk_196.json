[{"type": "subtitle", "time": 11762.309, "timestamp": "03:16:02", "text": "印刷所に行ったとき"}, {"type": "subtitle", "time": 11764.79, "timestamp": "03:16:04", "text": "Tシャツ屋さん。そして私は彼らに私のロゴを提供しました。"}, {"type": "subtitle", "time": 11766.71, "timestamp": "03:16:06", "text": "印刷してもらえますか？そして私は気づいた"}, {"type": "subtitle", "time": 11769.59, "timestamp": "03:16:09", "text": "私のロゴにカットが入っていたような問題がありました"}, {"type": "subtitle", "time": 11771.91, "timestamp": "03:16:11", "text": "などなど。今、私は自分がしなければならないことに気づいた"}, {"type": "subtitle", "time": 11775.19, "timestamp": "03:16:15", "text": "カットを増やして、ギャップを増やして"}, {"type": "subtitle", "time": 11778.71, "timestamp": "03:16:18", "text": "もの。だから、より簡単に"}, {"type": "subtitle", "time": 11781.429, "timestamp": "03:16:21", "text": "これは理解できる"}, {"type": "subtitle", "time": 11784.55, "timestamp": "03:16:24", "text": "ああ、これは一種のキューみたいなものですね。"}, {"type": "subtitle", "time": 11786.55, "timestamp": "03:16:26", "text": "そしてそれは実験のようなものだった"}, {"type": "subtitle", "time": 11789.269, "timestamp": "03:16:29", "text": "段階。それから、学校でみんな"}, {"type": "subtitle", "time": 11791.91, "timestamp": "03:16:31", "text": "以前はカードを渡していたもの"}, {"type": "subtitle", "time": 11794.15, "timestamp": "03:16:34", "text": "私が医者であることとか、そういうこと全部。私"}, {"type": "subtitle", "time": 11796.71, "timestamp": "03:16:36", "text": "以前はこういうイラストを描くのに使っていました。えっと"}, {"type": "subtitle", "time": 11799.03, "timestamp": "03:16:39", "text": "今はfreepick.comというサイトがあります。"}, {"type": "subtitle", "time": 11801.59, "timestamp": "03:16:41", "text": "何か。私はそこに行って"}, {"type": "subtitle", "time": 11803.99, "timestamp": "03:16:43", "text": "メタなどの背景アセット"}, {"type": "subtitle", "time": 11807.75, "timestamp": "03:16:47", "text": "メタリックな背景、これらすべて"}, {"type": "subtitle", "time": 11809.83, "timestamp": "03:16:49", "text": "もの。これらはベクター形式です"}, {"type": "subtitle", "time": 11811.83, "timestamp": "03:16:51", "text": "右？だから、たくさんの層がある"}, {"type": "subtitle", "time": 11814.229, "timestamp": "03:16:54", "text": "そこには。だから私が昔やっていたことは、"}, {"type": "subtitle", "time": 11816.15, "timestamp": "03:16:56", "text": "ランダムなものから作り出そう"}, {"type": "subtitle", "time": 11818.309, "timestamp": "03:16:58", "text": "何かすべてをAdobeに"}]
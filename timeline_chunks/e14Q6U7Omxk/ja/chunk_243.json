[{"type": "subtitle", "time": 14580.389, "timestamp": "04:03:00", "text": "それを理解する必要はない、考える必要はない"}, {"type": "subtitle", "time": 14582.229, "timestamp": "04:03:02", "text": "あなたも知りたいなら、もう一度それについて"}, {"type": "subtitle", "time": 14583.269, "timestamp": "04:03:03", "text": "教えてください、わかりました、送ります"}, {"type": "subtitle", "time": 14585.67, "timestamp": "04:03:05", "text": "あなたにいくつかのもの"}, {"type": "subtitle", "time": 14588.469, "timestamp": "04:03:08", "text": "私の友人は実際に私に"}, {"type": "subtitle", "time": 14590.469, "timestamp": "04:03:10", "text": "相互投資と投資信託"}, {"type": "subtitle", "time": 14591.99, "timestamp": "04:03:11", "text": "すべて"}, {"type": "subtitle", "time": 14594.87, "timestamp": "04:03:14", "text": "そして彼は、それは君にとって良いことだと言った"}, {"type": "subtitle", "time": 14597.67, "timestamp": "04:03:17", "text": "将来のこととか色々あって、えっと、私は"}, {"type": "subtitle", "time": 14599.83, "timestamp": "04:03:19", "text": "試す"}, {"type": "subtitle", "time": 14604.389, "timestamp": "04:03:24", "text": "でもできなかった、だって、うん、どうぞ"}, {"type": "subtitle", "time": 14606.63, "timestamp": "04:03:26", "text": "私は投資信託は良いものだと言いましたが"}, {"type": "subtitle", "time": 14608.95, "timestamp": "04:03:28", "text": "少し危険ですが、たくさん必要になります"}, {"type": "subtitle", "time": 14611.189, "timestamp": "04:03:31", "text": "正しい情報が必要です"}, {"type": "subtitle", "time": 14614.07, "timestamp": "04:03:34", "text": "情報、そしてそれが機能する、そしてあなたは"}, {"type": "subtitle", "time": 14618.95, "timestamp": "04:03:38", "text": "うんうん、私はやりたかった"}, {"type": "subtitle", "time": 14622.55, "timestamp": "04:03:42", "text": "それだけど、同時に怖かった。"}, {"type": "subtitle", "time": 14624.389, "timestamp": "04:03:44", "text": "うん、それは良いことだね。怖がった。いる"}, {"type": "subtitle", "time": 14626.55, "timestamp": "04:03:46", "text": "怖がるのは良いことだ。それが最高だ"}, {"type": "subtitle", "time": 14628.79, "timestamp": "04:03:48", "text": "起こりうる事態。"}, {"type": "subtitle", "time": 14630.63, "timestamp": "04:03:50", "text": "心配ない。ご心配なく、上院議員。"}, {"type": "subtitle", "time": 14634.79, "timestamp": "04:03:54", "text": "ただの冗談だよ。心配しないで。うん。それで、えーと、"}, {"type": "subtitle", "time": 14636.95, "timestamp": "04:03:56", "text": "投資信託では、ご存知の通り、"}, {"type": "subtitle", "time": 14639.11, "timestamp": "04:03:59", "text": "彼らはこう言った。「この投資信託に投資して"}]
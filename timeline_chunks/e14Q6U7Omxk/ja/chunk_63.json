[{"type": "subtitle", "time": 3780.789, "timestamp": "01:03:00", "text": "それが私が難しい状況にいる理由です"}, {"type": "subtitle", "time": 3785.109, "timestamp": "01:03:05", "text": "ポジション、例えば、次のように考えてみてください"}, {"type": "subtitle", "time": 3789.109, "timestamp": "01:03:09", "text": "私には中国に行くしかない"}, {"type": "subtitle", "time": 3792.63, "timestamp": "01:03:12", "text": "しかし中国は"}, {"type": "subtitle", "time": 3793.829, "timestamp": "01:03:13", "text": "何と呼ぶのか何と呼ぶのか"}, {"type": "subtitle", "time": 3795.829, "timestamp": "01:03:15", "text": "訪問するものや必要なものなど"}, {"type": "subtitle", "time": 3799.75, "timestamp": "01:03:19", "text": "市民IDか何かですよね"}, {"type": "subtitle", "time": 3801.67, "timestamp": "01:03:21", "text": "それは起こらない"}, {"type": "subtitle", "time": 3803.589, "timestamp": "01:03:23", "text": "私にはできないと確信しています"}, {"type": "subtitle", "time": 3806.39, "timestamp": "01:03:26", "text": "他の州を訪れるのも好きです"}, {"type": "subtitle", "time": 3811.19, "timestamp": "01:03:31", "text": "その時の私の国"}, {"type": "subtitle", "time": 3815.029, "timestamp": "01:03:35", "text": "つまり、バシャは持っているけど、"}, {"type": "subtitle", "time": 3816.63, "timestamp": "01:03:36", "text": "のように"}, {"type": "subtitle", "time": 3818.15, "timestamp": "01:03:38", "text": "ペイント"}, {"type": "subtitle", "time": 3820.47, "timestamp": "01:03:40", "text": "でも、そうだけど、またそういう感じ"}, {"type": "chat", "time": 3821.859, "timestamp": "01:03:41", "author": "@indus_exe", "avatar": "https://yt4.ggpht.com/3H8vMblwahIZO8b2GD0A74_Icoy2nYSc-vPhPQaMyxmxROMbYn_u_WQldiMtQTBwAKQsXG-rZw=s64-c-k-c0x00ffffff-no-rj", "message": "Japan, and now China. Wow. "}, {"type": "subtitle", "time": 3823.589, "timestamp": "01:03:43", "text": "不可能な右と別の方法は"}, {"type": "chat", "time": 3824.884, "timestamp": "01:03:44", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Shhh... Wreo_indus EXE, Joq is resting. 🌙 Welcome to the Guild, and enjoy the past joq's memories!"}, {"type": "subtitle", "time": 3826.95, "timestamp": "01:03:46", "text": "私を助けてくれる友達を見つける"}, {"type": "subtitle", "time": 3829.109, "timestamp": "01:03:49", "text": "また、誰もが喜んでそうするわけではないでしょう"}, {"type": "subtitle", "time": 3831.91, "timestamp": "01:03:51", "text": "それはまるで"}, {"type": "subtitle", "time": 3833.51, "timestamp": "01:03:53", "text": "いつものようにプライバシーを侵害しているんですよね？"}, {"type": "subtitle", "time": 3836.15, "timestamp": "01:03:56", "text": "あなたは自分の主要な個人情報を手放している"}, {"type": "subtitle", "time": 3838.39, "timestamp": "01:03:58", "text": "詳細とか色々。それは本当に難しい"}]
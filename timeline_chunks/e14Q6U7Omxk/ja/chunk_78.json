[{"type": "subtitle", "time": 4697.35, "timestamp": "01:18:17", "text": "私は死んだ。動作が遅かった。ゲームは"}, {"type": "subtitle", "time": 4700.47, "timestamp": "01:18:20", "text": "すごく動作が重い。何てことだ。"}, {"type": "subtitle", "time": 4705.08, "timestamp": "01:18:25", "text": "しかし、私たちは実際に何かを成し遂げることができたのです。"}, {"type": "subtitle", "time": 4712.63, "timestamp": "01:18:32", "text": "それは確かに大きなジレンマですね。願っています"}, {"type": "subtitle", "time": 4714.149, "timestamp": "01:18:34", "text": "すべてはあなたにとって良い方向に終わります。"}, {"type": "subtitle", "time": 4717.11, "timestamp": "01:18:37", "text": "ええ、すべてが"}, {"type": "subtitle", "time": 4720.55, "timestamp": "01:18:40", "text": "私が望むのは、すべてがこうなることです"}, {"type": "subtitle", "time": 4728.47, "timestamp": "01:18:48", "text": "そして、最近私はとても"}, {"type": "subtitle", "time": 4731.679, "timestamp": "01:18:51", "text": "私はとても それは何と呼ばれますか？"}, {"type": "subtitle", "time": 4734.56, "timestamp": "01:18:54", "text": "それは何と呼ばれますか？ 最近私はとても"}, {"type": "subtitle", "time": 4738.08, "timestamp": "01:18:58", "text": "最近私はとても あまりにも"}]
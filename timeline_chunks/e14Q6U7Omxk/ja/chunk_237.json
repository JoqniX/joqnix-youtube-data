[{"type": "subtitle", "time": 14220.389, "timestamp": "03:57:00", "text": "うん。はい。彼を見守っている。彼はあの"}, {"type": "subtitle", "time": 14222.229, "timestamp": "03:57:02", "text": "ランプ"}, {"type": "subtitle", "time": 14224.95, "timestamp": "03:57:04", "text": "あれゲーム。彼はそれを演奏していた。私"}, {"type": "subtitle", "time": 14228.389, "timestamp": "03:57:08", "text": "その時点でハマったと思うし"}, {"type": "subtitle", "time": 14230.87, "timestamp": "03:57:10", "text": "彼がきっかけで、私も彼のファンになったんです。私"}, {"type": "subtitle", "time": 14235.189, "timestamp": "03:57:15", "text": "見始めたのですが、やり方がわかりません"}, {"type": "subtitle", "time": 14238.55, "timestamp": "03:57:18", "text": "発音してください。エクシサン"}, {"type": "subtitle", "time": 14241.269, "timestamp": "03:57:21", "text": "ゼラミンだと思います。"}, {"type": "subtitle", "time": 14243.91, "timestamp": "03:57:23", "text": "ああ、そうだ、そうだ、そうだ、そうだ、そうだ、そうだ。"}, {"type": "subtitle", "time": 14246.389, "timestamp": "03:57:26", "text": "彼女を見始めたとき、私は気づいた"}, {"type": "subtitle", "time": 14248.15, "timestamp": "03:57:28", "text": "スミ"}, {"type": "subtitle", "time": 14250.55, "timestamp": "03:57:30", "text": "彼女は昔は登録者数が800人だったんだ。"}, {"type": "subtitle", "time": 14253.429, "timestamp": "03:57:33", "text": "えっと、彼女を見て始めたんだけど"}, {"type": "subtitle", "time": 14255.83, "timestamp": "03:57:35", "text": "彼女のおかげで私は他のものを見始めた"}, {"type": "subtitle", "time": 14257.59, "timestamp": "03:57:37", "text": "人々は、その時点で私はこう思った"}, {"type": "subtitle", "time": 14259.67, "timestamp": "03:57:39", "text": "そうするべきだと考えている。そうするべきです。"}, {"type": "subtitle", "time": 14261.349, "timestamp": "03:57:41", "text": "そして私は音楽を作り始めた"}, {"type": "subtitle", "time": 14264.87, "timestamp": "03:57:44", "text": "ビデオを視聴した後、あなたのメッセージを受け取りました。"}, {"type": "subtitle", "time": 14267.51, "timestamp": "03:57:47", "text": "はい。そして私はまた始めた。"}, {"type": "subtitle", "time": 14269.429, "timestamp": "03:57:49", "text": "まるでジェットコースターのようだ。とても興味深い。"}, {"type": "subtitle", "time": 14272.07, "timestamp": "03:57:52", "text": "それほど悪くはない。"}, {"type": "subtitle", "time": 14273.59, "timestamp": "03:57:53", "text": "うん。"}, {"type": "subtitle", "time": 14276.469, "timestamp": "03:57:56", "text": "私は大きなものを持っていません"}, {"type": "subtitle", "time": 14278.469, "timestamp": "03:57:58", "text": "大きなこと、大きな野望のようなもの。私は"}]
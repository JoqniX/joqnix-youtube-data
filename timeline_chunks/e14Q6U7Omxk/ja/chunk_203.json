[{"type": "subtitle", "time": 12180.389, "timestamp": "03:23:00", "text": "そして全て。すべては始まります"}, {"type": "subtitle", "time": 12183.91, "timestamp": "03:23:03", "text": "いつものように質の悪い動画をアップロードし始めた"}, {"type": "subtitle", "time": 12186.87, "timestamp": "03:23:06", "text": "まるでスマホのカメラで撮影したような画質。"}, {"type": "subtitle", "time": 12189.03, "timestamp": "03:23:09", "text": "そして彼らは高級品へと移行した"}, {"type": "subtitle", "time": 12192.309, "timestamp": "03:23:12", "text": "動画ですよね？だから私は"}, {"type": "subtitle", "time": 12195.11, "timestamp": "03:23:15", "text": "「ああ、私は今ユーチューバーだ」と思った"}, {"type": "subtitle", "time": 12197.11, "timestamp": "03:23:17", "text": "私がモデルを採用すれば、みんな"}, {"type": "subtitle", "time": 12199.67, "timestamp": "03:23:19", "text": "あれこれと予想してください。だから私は怖かった"}, {"type": "subtitle", "time": 12203.03, "timestamp": "03:23:23", "text": "質の低いコンテンツを提供する"}, {"type": "subtitle", "time": 12206.71, "timestamp": "03:23:26", "text": "そして、それも悪いことだと気づいた"}, {"type": "subtitle", "time": 12208.63, "timestamp": "03:23:28", "text": "いつも夢見ていた"}, {"type": "subtitle", "time": 12211.429, "timestamp": "03:23:31", "text": "いろいろあるけど、私は私自身だから制限している"}, {"type": "subtitle", "time": 12214.07, "timestamp": "03:23:34", "text": "自分自身は準備はできているが、"}, {"type": "subtitle", "time": 12216.87, "timestamp": "03:23:36", "text": "ああ、それは良くないですね。だから私は"}, {"type": "subtitle", "time": 12219.51, "timestamp": "03:23:39", "text": "ジョッカソンについて考えました。"}, {"type": "subtitle", "time": 12221.99, "timestamp": "03:23:41", "text": "ショットやビデオなどをアップロードして"}, {"type": "subtitle", "time": 12225.03, "timestamp": "03:23:45", "text": "3月12日から始まるこのジョックマラソンを通して"}, {"type": "subtitle", "time": 12227.91, "timestamp": "03:23:47", "text": "私は3月12日にジョッカソンを始めました。"}, {"type": "subtitle", "time": 12230.07, "timestamp": "03:23:50", "text": "それ以来私は"}, {"type": "subtitle", "time": 12233.99, "timestamp": "03:23:53", "text": "YouTube、TikTok、Instagramにアップロード"}, {"type": "subtitle", "time": 12237.429, "timestamp": "03:23:57", "text": "ストリームからすべてのクリップをリールします"}, {"type": "chat", "time": 12239.461, "timestamp": "03:23:59", "author": "@senpainotfoundd", "avatar": "https://yt4.ggpht.com/MxpRBxfrp903U81_WAr-BZO6QKwdKT1rJjdvDSuF8Nu_JP9JTpQCOA_SSgLjCV10OU4M-cDGhyk=s64-c-k-c0x00ffffff-no-rj", "message": "its never too late, you've got this"}]
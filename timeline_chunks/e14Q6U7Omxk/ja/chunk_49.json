[{"type": "subtitle", "time": 2943.829, "timestamp": "00:49:03", "text": "本当に本当に本当に大きな意味があります。うん。"}, {"type": "subtitle", "time": 2946.47, "timestamp": "00:49:06", "text": "ということで、最後に"}, {"type": "subtitle", "time": 2949.43, "timestamp": "00:49:09", "text": "今日はこれで終わりにします。すべての人々が"}, {"type": "subtitle", "time": 2951.829, "timestamp": "00:49:11", "text": "フォロー"}, {"type": "subtitle", "time": 2955.99, "timestamp": "00:49:15", "text": "待っていたすべての人々"}, {"type": "subtitle", "time": 2964.71, "timestamp": "00:49:24", "text": "時間を割いて、"}, {"type": "subtitle", "time": 2967.349, "timestamp": "00:49:27", "text": "チャットで私のプレイを見ながら"}, {"type": "subtitle", "time": 2974.069, "timestamp": "00:49:34", "text": "[音楽]"}, {"type": "subtitle", "time": 2981.67, "timestamp": "00:49:41", "text": "ええ、私はOhに切り替えるつもりです。"}, {"type": "subtitle", "time": 2984.71, "timestamp": "00:49:44", "text": "待って。忘れた。"}, {"type": "subtitle", "time": 2988.79, "timestamp": "00:49:48", "text": "どうしてこんなことを忘れてしまったのだろう？どうやら"}, {"type": "subtitle", "time": 2991.75, "timestamp": "00:49:51", "text": "私がそうすべきだったとき、私が"}, {"type": "subtitle", "time": 2993.67, "timestamp": "00:49:53", "text": "プレイしていたので、こちらに切り替えるべきですね"}, {"type": "subtitle", "time": 2996.63, "timestamp": "00:49:56", "text": "ダイナミックライティング機能。"}, {"type": "subtitle", "time": 2998.79, "timestamp": "00:49:58", "text": "忘れた。"}]
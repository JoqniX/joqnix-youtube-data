[{"type": "subtitle", "time": 6180.31, "timestamp": "01:43:00", "text": "さあ行こう。それを手に入れろ。"}, {"type": "subtitle", "time": 6185.35, "timestamp": "01:43:05", "text": "ああ、私は野獣になるつもりだ"}, {"type": "subtitle", "time": 6207.03, "timestamp": "01:43:27", "text": "でも、すごくラグいし、"}, {"type": "subtitle", "time": 6209.99, "timestamp": "01:43:29", "text": "なれ。うん。こんにちは、フィル。元気ですか"}, {"type": "subtitle", "time": 6211.83, "timestamp": "01:43:31", "text": "何をしているの？"}, {"type": "subtitle", "time": 6225.43, "timestamp": "01:43:45", "text": "よし、これはいいぞ。"}]
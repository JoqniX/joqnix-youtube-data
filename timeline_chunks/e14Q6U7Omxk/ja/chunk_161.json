[{"type": "subtitle", "time": 9670.87, "timestamp": "02:41:10", "text": "わかりました、ちょっと待ってください"}, {"type": "subtitle", "time": 9674.79, "timestamp": "02:41:14", "text": "複数のことを同時にこなす。"}, {"type": "subtitle", "time": 9676.95, "timestamp": "02:41:16", "text": "コラボ中にどうしてもそうしなければならなかった"}, {"type": "subtitle", "time": 9680.389, "timestamp": "02:41:20", "text": "ストリーム。うん、"}, {"type": "subtitle", "time": 9684.87, "timestamp": "02:41:24", "text": "うちの犬が吠えている。おお、"}, {"type": "subtitle", "time": 9699.19, "timestamp": "02:41:39", "text": "うん、"}, {"type": "subtitle", "time": 9708.309, "timestamp": "02:41:48", "text": "それは何かだった。"}, {"type": "subtitle", "time": 9711.19, "timestamp": "02:41:51", "text": "ええ、ヘリオスが"}, {"type": "subtitle", "time": 9713.99, "timestamp": "02:41:53", "text": "戻る。"}]
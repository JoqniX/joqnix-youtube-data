[{"type": "subtitle", "time": 6962.79, "timestamp": "01:56:02", "text": "私じゃないよ。"}, {"type": "subtitle", "time": 6965.669, "timestamp": "01:56:05", "text": "つまり"}, {"type": "subtitle", "time": 6967.91, "timestamp": "01:56:07", "text": "有名とか何とか。それは問題ではない"}, {"type": "subtitle", "time": 6970.55, "timestamp": "01:56:10", "text": "終わり。"}, {"type": "subtitle", "time": 6973.83, "timestamp": "01:56:13", "text": "そうそう。私は実際にそう感じました"}, {"type": "subtitle", "time": 6976.95, "timestamp": "01:56:16", "text": "このことについて話すとき"}, {"type": "subtitle", "time": 6979.109, "timestamp": "01:56:19", "text": "右"}, {"type": "subtitle", "time": 6981.35, "timestamp": "01:56:21", "text": "特にビリー・ビリーに関しては"}, {"type": "subtitle", "time": 6986.55, "timestamp": "01:56:26", "text": "状況。私は周囲からのプレッシャーを感じた。"}, {"type": "subtitle", "time": 6990.149, "timestamp": "01:56:30", "text": "仲間からのプレッシャーというよりは、ある意味、ある意味"}, {"type": "subtitle", "time": 6997.28, "timestamp": "01:56:37", "text": "意味 えっと"}, {"type": "subtitle", "time": 7002.79, "timestamp": "01:56:42", "text": "人々は助けを求めてきた。"}, {"type": "subtitle", "time": 7005.83, "timestamp": "01:56:45", "text": "彼らは1Kを持っているようなものだ"}, {"type": "subtitle", "time": 7007.99, "timestamp": "01:56:47", "text": "または13K"}, {"type": "subtitle", "time": 7010.87, "timestamp": "01:56:50", "text": "フォローとか色々。そして私は独身"}, {"type": "subtitle", "time": 7015.51, "timestamp": "01:56:55", "text": "男が何を持ってるの？"}, {"type": "subtitle", "time": 7018.47, "timestamp": "01:56:58", "text": "九。私たちが見たもの、それは一体何だったのでしょうか？"}]
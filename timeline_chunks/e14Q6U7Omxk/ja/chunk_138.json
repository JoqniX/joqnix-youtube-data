[{"type": "subtitle", "time": 8282.309, "timestamp": "02:18:02", "text": "大丈夫。大丈夫。"}, {"type": "subtitle", "time": 8285.27, "timestamp": "02:18:05", "text": "くそ。うん、これも正解だったよ"}, {"type": "subtitle", "time": 8287.99, "timestamp": "02:18:07", "text": "何らかの理由で。"}, {"type": "subtitle", "time": 8290.15, "timestamp": "02:18:10", "text": "議論せずに次に進む"}, {"type": "subtitle", "time": 8293.27, "timestamp": "02:18:13", "text": "さらに遠く。うん。えっと、"}, {"type": "subtitle", "time": 8295.349, "timestamp": "02:18:15", "text": "あなたは女の子です。よし。あなたの"}, {"type": "subtitle", "time": 8299.19, "timestamp": "02:18:19", "text": "叔母の葬儀。あなたは悲しみに暮れているのか、それとも"}, {"type": "subtitle", "time": 8302.389, "timestamp": "02:18:22", "text": "どう発音するのか分かりません。"}, {"type": "subtitle", "time": 8305.91, "timestamp": "02:18:25", "text": "とにかく、朝が見えるよね？分かりますか"}, {"type": "subtitle", "time": 8307.99, "timestamp": "02:18:27", "text": "あなたのすぐ隣には、とてもハンサムな男性がいます。"}, {"type": "subtitle", "time": 8311.03, "timestamp": "02:18:31", "text": "あなたは瞬時にその男性に恋に落ちる。"}, {"type": "subtitle", "time": 8313.429, "timestamp": "02:18:33", "text": "彼は黒いスーツを着ていた。彼は黒"}, {"type": "subtitle", "time": 8317.429, "timestamp": "02:18:37", "text": "髪。そして次の晩、あなたは家に帰り、"}, {"type": "subtitle", "time": 8321.589, "timestamp": "02:18:41", "text": "妹を殺せ。何故ですか？"}, {"type": "subtitle", "time": 8323.669, "timestamp": "02:18:43", "text": "ああ、今はかなりひどい状況だ"}, {"type": "subtitle", "time": 8329.19, "timestamp": "02:18:49", "text": "考えてみてください、あの男は"}, {"type": "subtitle", "time": 8333.27, "timestamp": "02:18:53", "text": "彼女は妹と付き合っていたが、"}, {"type": "subtitle", "time": 8336.95, "timestamp": "02:18:56", "text": "彼女が彼を自分のものだと主張したように"}]
[{"type": "subtitle", "time": 8823.75, "timestamp": "02:27:03", "text": "何も感じない、"}, {"type": "subtitle", "time": 8825.67, "timestamp": "02:27:05", "text": "普通の人が感じる感情、"}, {"type": "subtitle", "time": 8827.59, "timestamp": "02:27:07", "text": "右？"}, {"type": "subtitle", "time": 8829.51, "timestamp": "02:27:09", "text": "サイコパスには"}, {"type": "subtitle", "time": 8832.07, "timestamp": "02:27:12", "text": "意識があるか、あるいは爆発するかのどちらか"}, {"type": "subtitle", "time": 8835.83, "timestamp": "02:27:15", "text": "プレッシャーですよね？そして彼らは"}, {"type": "subtitle", "time": 8838.469, "timestamp": "02:27:18", "text": "彼らの人脈を利用するんですよね？彼らです"}, {"type": "subtitle", "time": 8841.91, "timestamp": "02:27:21", "text": "マニピュレーターとかそういう類のもの。"}, {"type": "subtitle", "time": 8843.59, "timestamp": "02:27:23", "text": "それで"}, {"type": "subtitle", "time": 8845.83, "timestamp": "02:27:25", "text": "彼らと社会病質者は、"}, {"type": "subtitle", "time": 8848.389, "timestamp": "02:27:28", "text": "怒りはしばしば、彼らが知っているように、"}, {"type": "subtitle", "time": 8850.469, "timestamp": "02:27:30", "text": "彼らの持ち物。社会病質者は自分の"}, {"type": "subtitle", "time": 8852.55, "timestamp": "02:27:32", "text": "もの。彼らは感情の扱い方を知っている"}, {"type": "subtitle", "time": 8855.03, "timestamp": "02:27:35", "text": "などなど。そのアニメ知ってる？私はしません"}, {"type": "subtitle", "time": 8858.07, "timestamp": "02:27:38", "text": "覚えてる？"}, {"type": "subtitle", "time": 8860.389, "timestamp": "02:27:40", "text": "あの黄色い髪は何？私はそうは思わない"}, {"type": "subtitle", "time": 8863.51, "timestamp": "02:27:43", "text": "アニメを覚えているかい？"}, {"type": "subtitle", "time": 8866.23, "timestamp": "02:27:46", "text": "イオノギみたいな感じですよね？もし私が始めたら"}, {"type": "subtitle", "time": 8873.429, "timestamp": "02:27:53", "text": "私にはわからない、あなたは知っている。"}, {"type": "subtitle", "time": 8875.03, "timestamp": "02:27:55", "text": "うん。うん。それが一番簡単だ"}, {"type": "subtitle", "time": 8877.349, "timestamp": "02:27:57", "text": "説明できます。"}]
[{"type": "subtitle", "time": 4080.63, "timestamp": "01:08:00", "text": "ああ、FPS がファンになってしまいます。"}, {"type": "subtitle", "time": 4085.029, "timestamp": "01:08:05", "text": "ああ、そういえば扇風機が回ってないんです。なんてこった。"}, {"type": "subtitle", "time": 4088.549, "timestamp": "01:08:08", "text": "なんてこった。私はどうすればいいのだろう？"}, {"type": "subtitle", "time": 4091.91, "timestamp": "01:08:11", "text": "これを忘れてた。私のGPUファンの問題"}, {"type": "subtitle", "time": 4093.51, "timestamp": "01:08:13", "text": "は"}, {"type": "subtitle", "time": 4102.309, "timestamp": "01:08:22", "text": "ああ、なんてことだ。めちゃくちゃ動作が遅い。"}, {"type": "subtitle", "time": 4105.349, "timestamp": "01:08:25", "text": "皆さん、ラグが分かりますよね？"}, {"type": "subtitle", "time": 4107.349, "timestamp": "01:08:27", "text": "私だけではないことを願っています"}, {"type": "subtitle", "time": 4110.47, "timestamp": "01:08:30", "text": "これらすべてを見て。まるで30FPSみたいだ"}, {"type": "subtitle", "time": 4114.149, "timestamp": "01:08:34", "text": "または、小刻みに揺れるような"}, {"type": "subtitle", "time": 4116.55, "timestamp": "01:08:36", "text": "そわそわと動き回る。私が立っても大丈夫です"}, {"type": "subtitle", "time": 4118.229, "timestamp": "01:08:38", "text": "まだ。"}, {"type": "subtitle", "time": 4121.189, "timestamp": "01:08:41", "text": "全てが低迷している。すごく低い。"}, {"type": "subtitle", "time": 4123.269, "timestamp": "01:08:43", "text": "そして"}, {"type": "subtitle", "time": 4126.149, "timestamp": "01:08:46", "text": "ああ、"}]
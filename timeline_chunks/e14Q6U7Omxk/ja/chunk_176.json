[{"type": "subtitle", "time": 10562.87, "timestamp": "02:56:02", "text": "パンジャブ語はヒンディー語ほどではないので、"}, {"type": "subtitle", "time": 10564.469, "timestamp": "02:56:04", "text": "怖い言葉を知っている大きな"}, {"type": "subtitle", "time": 10569.67, "timestamp": "02:56:09", "text": "知らないものもあるけど、理解できるよ"}, {"type": "subtitle", "time": 10573.11, "timestamp": "02:56:13", "text": "はらみ、知ってる？ハニ、私だと思う"}, {"type": "subtitle", "time": 10576.07, "timestamp": "02:56:16", "text": "聞いたことあるよ、うんうん"}, {"type": "subtitle", "time": 10578.87, "timestamp": "02:56:18", "text": "私には理解できます。えっと、できません"}, {"type": "subtitle", "time": 10581.99, "timestamp": "02:56:21", "text": "それを話してください。私は理解し、話すことができます"}, {"type": "subtitle", "time": 10584.55, "timestamp": "02:56:24", "text": "ラジャスタン語。"}, {"type": "subtitle", "time": 10586.87, "timestamp": "02:56:26", "text": "ええ、それだけだと思います。考えていた"}, {"type": "subtitle", "time": 10590.23, "timestamp": "02:56:30", "text": "日本語を学ぶことについてですが、"}, {"type": "subtitle", "time": 10593.429, "timestamp": "02:56:33", "text": "シラバスを詰め込んで、私は「いや、"}, {"type": "subtitle", "time": 10595.75, "timestamp": "02:56:35", "text": "私はそんなことはしません。"}, {"type": "subtitle", "time": 10597.59, "timestamp": "02:56:37", "text": "私もその時点でサンスクリット語を学びました"}, {"type": "subtitle", "time": 10607.19, "timestamp": "02:56:47", "text": "楽しかったよ。楽しいのは"}, {"type": "subtitle", "time": 10609.269, "timestamp": "02:56:49", "text": "背景とか、えっと、私は"}, {"type": "subtitle", "time": 10611.19, "timestamp": "02:56:51", "text": "ラジャスタン地方などの背景"}, {"type": "subtitle", "time": 10613.269, "timestamp": "02:56:53", "text": "だから、理解しないといけないんだ"}, {"type": "subtitle", "time": 10614.79, "timestamp": "02:56:54", "text": "そのことと、"}, {"type": "subtitle", "time": 10618.87, "timestamp": "02:56:58", "text": "ハナ、もしくはハナ・ヒマチェルじゃないわ、私は"}]
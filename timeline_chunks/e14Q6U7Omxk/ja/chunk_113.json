[{"type": "subtitle", "time": 6781.03, "timestamp": "01:53:01", "text": "Twitchとかそういうのやってるの？ある意味、"}, {"type": "subtitle", "time": 6783.51, "timestamp": "01:53:03", "text": "私はそのビデオをライブ録画したかった"}, {"type": "subtitle", "time": 6786.07, "timestamp": "01:53:06", "text": "あのチュートリアルみたいなやつ、"}, {"type": "subtitle", "time": 6789.35, "timestamp": "01:53:09", "text": "おそらく二度と持ち出すことはないだろう。"}, {"type": "subtitle", "time": 6793.109, "timestamp": "01:53:13", "text": "生放送でお届けします。それは、"}, {"type": "subtitle", "time": 6795.83, "timestamp": "01:53:15", "text": "数人の友人とか、そんな感じ。私は考えた"}, {"type": "subtitle", "time": 6797.83, "timestamp": "01:53:17", "text": "非公開動画のように保持するか、"}, {"type": "subtitle", "time": 6801.109, "timestamp": "01:53:21", "text": "体調が良くなるまで、念のため何か"}, {"type": "subtitle", "time": 6803.669, "timestamp": "01:53:23", "text": "ライブ配信で動画を録画中"}, {"type": "subtitle", "time": 6806.229, "timestamp": "01:53:26", "text": "あれ。"}, {"type": "subtitle", "time": 6810.55, "timestamp": "01:53:30", "text": "うん。うん。だから、そう思ったんです。"}, {"type": "subtitle", "time": 6813.91, "timestamp": "01:53:33", "text": "それか何かやってみます。"}, {"type": "subtitle", "time": 6817.51, "timestamp": "01:53:37", "text": "あのね？私はこう思う"}, {"type": "subtitle", "time": 6820.31, "timestamp": "01:53:40", "text": "ダブルタップして"}, {"type": "subtitle", "time": 6822.79, "timestamp": "01:53:42", "text": "うん。うん。ハカロイ。ええ、試してみましたよ"}, {"type": "subtitle", "time": 6824.87, "timestamp": "01:53:44", "text": "ハカール・ロイ。それは良いです。いいんだけど、"}, {"type": "subtitle", "time": 6827.27, "timestamp": "01:53:47", "text": "新年のイベントチャレンジ、"}, {"type": "subtitle", "time": 6830.709, "timestamp": "01:53:50", "text": "右？の方が良い"}, {"type": "subtitle", "time": 6835.43, "timestamp": "01:53:55", "text": "バトルロイヤルをする方が良い"}, {"type": "subtitle", "time": 6838.55, "timestamp": "01:53:58", "text": "実際、トップ10が必要だからだ"}]
[{"type": "subtitle", "time": 6062.55, "timestamp": "01:41:02", "text": "Twitch Prime。これで私は"}, {"type": "subtitle", "time": 6067.35, "timestamp": "01:41:07", "text": "冬のプライム、プライム、ゲーム"}, {"type": "subtitle", "time": 6069.43, "timestamp": "01:41:09", "text": "12月に発売された。私は"}, {"type": "subtitle", "time": 6072.95, "timestamp": "01:41:12", "text": "亡霊みたいなもの、だって私はちゃんと確認したから"}, {"type": "subtitle", "time": 6077.43, "timestamp": "01:41:17", "text": "それを主張する。アカウントの設定を元に戻しました。"}, {"type": "subtitle", "time": 6081.51, "timestamp": "01:41:21", "text": "ああ、この男はウサギのオクタンを持っている"}, {"type": "subtitle", "time": 6085.27, "timestamp": "01:41:25", "text": "いや。ああ、なんてことだ。"}, {"type": "subtitle", "time": 6091.91, "timestamp": "01:41:31", "text": "しかし、"}, {"type": "subtitle", "time": 6095.43, "timestamp": "01:41:35", "text": "説得されないでください"}]
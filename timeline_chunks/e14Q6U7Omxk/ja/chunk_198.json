[{"type": "subtitle", "time": 11881.19, "timestamp": "03:18:01", "text": "実際のライブストリームでの編集"}, {"type": "subtitle", "time": 11885.11, "timestamp": "03:18:05", "text": "時間があったからこそ、私は刺激を受けたのです。うわぁ"}, {"type": "subtitle", "time": 11887.59, "timestamp": "03:18:07", "text": "それはすごくクールだけど、私もやりたい"}, {"type": "subtitle", "time": 11890.15, "timestamp": "03:18:10", "text": "それ。私は彼を観察して"}, {"type": "subtitle", "time": 11892.71, "timestamp": "03:18:12", "text": "数ヶ月で私はすべてが理解しました"}, {"type": "subtitle", "time": 11895.99, "timestamp": "03:18:15", "text": "彼が開発したソフトウェア、彼のセットアップの仕組み"}, {"type": "subtitle", "time": 11899.269, "timestamp": "03:18:19", "text": "彼が全体に切り替える前のすべて"}, {"type": "subtitle", "time": 11902.15, "timestamp": "03:18:22", "text": "大きな倉庫には、"}, {"type": "subtitle", "time": 11904.55, "timestamp": "03:18:24", "text": "倉庫みたいなやつ、彼はこの緑のシーンを持っている"}, {"type": "subtitle", "time": 11908.07, "timestamp": "03:18:28", "text": "彼が憧れているものとかそういうもの"}, {"type": "subtitle", "time": 11911.75, "timestamp": "03:18:31", "text": "ビジュアルDJみたいなやつ、やってみたら？"}, {"type": "subtitle", "time": 11915.269, "timestamp": "03:18:35", "text": "DJや彼らのためのものなど"}, {"type": "subtitle", "time": 11917.59, "timestamp": "03:18:37", "text": "彼らがDJコンサートを行っている間、"}, {"type": "subtitle", "time": 11920.229, "timestamp": "03:18:40", "text": "彼は観客に"}, {"type": "subtitle", "time": 11924.469, "timestamp": "03:18:44", "text": "ライブ編集みたいなVDJ系のもの"}, {"type": "subtitle", "time": 11927.51, "timestamp": "03:18:47", "text": "そして彼は、彼の野心を示している"}, {"type": "subtitle", "time": 11930.07, "timestamp": "03:18:50", "text": "そして彼の努力や彼の"}, {"type": "subtitle", "time": 11933.11, "timestamp": "03:18:53", "text": "ストリームで、それが私に大きなインスピレーションを与えてくれました。"}, {"type": "subtitle", "time": 11935.75, "timestamp": "03:18:55", "text": "なぜ私はこれをできないのか"}, {"type": "subtitle", "time": 11939.269, "timestamp": "03:18:59", "text": "YouTuberは2Dでも3Dでも"}]
[{"type": "subtitle", "time": 5102.07, "timestamp": "01:25:02", "text": "また、すべてが"}, {"type": "subtitle", "time": 5106.87, "timestamp": "01:25:06", "text": "他の処理には高性能なGPUが必要です"}, {"type": "subtitle", "time": 5111.51, "timestamp": "01:25:11", "text": "そしてある意味、私は変態に金を払っているようなものだ"}, {"type": "subtitle", "time": 5131.669, "timestamp": "01:25:31", "text": "ああ、なんてこった、めちゃくちゃ暑い。私の手は"}, {"type": "subtitle", "time": 5147.27, "timestamp": "01:25:47", "text": "待って、気のせいかな、それとも本当に"}, {"type": "subtitle", "time": 5149.27, "timestamp": "01:25:49", "text": "二？"}, {"type": "subtitle", "time": 5152.07, "timestamp": "01:25:52", "text": "待って、それは"}, {"type": "subtitle", "time": 5155.83, "timestamp": "01:25:55", "text": "よし、やってみよう。何"}]
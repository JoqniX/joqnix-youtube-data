[{"type": "subtitle", "time": 10500.07, "timestamp": "02:55:00", "text": "うんうん、それに私はそれが苦手で、読めないの"}, {"type": "subtitle", "time": 10505.03, "timestamp": "02:55:05", "text": "理解できるので良いことです"}, {"type": "subtitle", "time": 10506.95, "timestamp": "02:55:06", "text": "大丈夫です。誰が気にするだろうか"}, {"type": "subtitle", "time": 10510.309, "timestamp": "02:55:10", "text": "書き込み？それで、"}, {"type": "subtitle", "time": 10512.95, "timestamp": "02:55:12", "text": "わかった。つまり、現在ではそれは日本語です"}, {"type": "subtitle", "time": 10515.429, "timestamp": "02:55:15", "text": "それはあなたの第三言語になるでしょう。日本語"}, {"type": "subtitle", "time": 10519.51, "timestamp": "02:55:19", "text": "4作目になります。 4番目。わかった。それで、"}, {"type": "subtitle", "time": 10522.15, "timestamp": "02:55:22", "text": "3つ目は何ですか？"}, {"type": "subtitle", "time": 10525.19, "timestamp": "02:55:25", "text": "ヒンディー語はよくわからないけど、それでも"}, {"type": "subtitle", "time": 10528.15, "timestamp": "02:55:28", "text": "それについて勉強したので、少しは理解できます。"}, {"type": "subtitle", "time": 10531.51, "timestamp": "02:55:31", "text": "それから、英語もあります。三番目。"}, {"type": "subtitle", "time": 10533.11, "timestamp": "02:55:33", "text": "ええ、英語はもうそこにあります"}, {"type": "subtitle", "time": 10535.349, "timestamp": "02:55:35", "text": "世代の半分くらい"}, {"type": "subtitle", "time": 10537.19, "timestamp": "02:55:37", "text": "私たちの世代の半分は"}, {"type": "subtitle", "time": 10539.349, "timestamp": "02:55:39", "text": "世代はすでに英語で考えている"}, {"type": "subtitle", "time": 10542.95, "timestamp": "02:55:42", "text": "ご存じの通り、それは働き始めました"}, {"type": "subtitle", "time": 10545.99, "timestamp": "02:55:45", "text": "ある時点では異なっていた。"}, {"type": "subtitle", "time": 10547.83, "timestamp": "02:55:47", "text": "うん。うん。"}, {"type": "subtitle", "time": 10551.51, "timestamp": "02:55:51", "text": "正直に言うと、私にとってはMですね。"}, {"type": "subtitle", "time": 10555.91, "timestamp": "02:55:55", "text": "パンジャブ語とヒンディー語の読み書きができる"}, {"type": "subtitle", "time": 10559.51, "timestamp": "02:55:59", "text": "えーと、英語は流暢で、"}]
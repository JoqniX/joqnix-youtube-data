[{"type": "subtitle", "time": 13802.07, "timestamp": "03:50:02", "text": "犬？いいえ。ええと、日本人は話しません"}, {"type": "subtitle", "time": 13804.71, "timestamp": "03:50:04", "text": "どうやら多すぎるようです。ええ、彼らは"}, {"type": "subtitle", "time": 13807.03, "timestamp": "03:50:07", "text": "彼らが持っていると確信していない限り、そうしないでください"}, {"type": "subtitle", "time": 13809.83, "timestamp": "03:50:09", "text": "友達の境界線とか、そういうもの全部"}, {"type": "subtitle", "time": 13812.95, "timestamp": "03:50:12", "text": "厳格な境界線とかそういうもの。"}, {"type": "subtitle", "time": 13820.07, "timestamp": "03:50:20", "text": "だからとても"}, {"type": "subtitle", "time": 13822.309, "timestamp": "03:50:22", "text": "うん。あなたは好きにならなければならない、なぜならあなたは"}, {"type": "subtitle", "time": 13825.349, "timestamp": "03:50:25", "text": "まるで全く別の世界へ足を踏み入れるような"}, {"type": "subtitle", "time": 13829.11, "timestamp": "03:50:29", "text": "文化的環境。うん。いやいや、"}, {"type": "subtitle", "time": 13831.99, "timestamp": "03:50:31", "text": "既に国家的な問題となっている。いいえ、すでに"}, {"type": "subtitle", "time": 13834.71, "timestamp": "03:50:34", "text": "異国の地だが文化的な圧力"}, {"type": "subtitle", "time": 13837.03, "timestamp": "03:50:37", "text": "場所によっては多すぎるでしょう"}, {"type": "subtitle", "time": 13839.11, "timestamp": "03:50:39", "text": "彼らは他人のものを一切受け入れない"}, {"type": "subtitle", "time": 13842.15, "timestamp": "03:50:42", "text": "あなたが知っている文化。うん、彼らは"}, {"type": "subtitle", "time": 13845.03, "timestamp": "03:50:45", "text": "それは良いことだ"}, {"type": "subtitle", "time": 13847.429, "timestamp": "03:50:47", "text": "まるで彼らが厳密に集中しているかのように"}, {"type": "subtitle", "time": 13850.63, "timestamp": "03:50:50", "text": "彼らの文化ですが、それは本当に悪い"}, {"type": "subtitle", "time": 13859.11, "timestamp": "03:50:59", "text": "たくさんのこと。"}]
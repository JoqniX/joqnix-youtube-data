[{"type": "subtitle", "time": 13321.83, "timestamp": "03:42:01", "text": "一部。ええ、私は宗教的なものが本当に好きなんです"}, {"type": "subtitle", "time": 13323.349, "timestamp": "03:42:03", "text": "そういう類のもの。私は本当に知りたい"}, {"type": "subtitle", "time": 13325.11, "timestamp": "03:42:05", "text": "すべてはそこから始まった、"}, {"type": "subtitle", "time": 13327.91, "timestamp": "03:42:07", "text": "あなたが知っている。うん。"}, {"type": "subtitle", "time": 13330.07, "timestamp": "03:42:10", "text": "あなたはどうですか？あなたの専攻は何ですか？"}, {"type": "subtitle", "time": 13332.07, "timestamp": "03:42:12", "text": "そういうのが本当に目立っていた"}, {"type": "subtitle", "time": 13334.71, "timestamp": "03:42:14", "text": "あなた？私はたまたま社会学を専攻しました"}, {"type": "subtitle", "time": 13336.95, "timestamp": "03:42:16", "text": "そしてそこから大きなことが始まった"}, {"type": "subtitle", "time": 13339.03, "timestamp": "03:42:19", "text": "全てが気に入ったことについて。しかし、"}, {"type": "subtitle", "time": 13341.83, "timestamp": "03:42:21", "text": "あなたについて？サンカイのことは心配しないでください。"}, {"type": "subtitle", "time": 13349.51, "timestamp": "03:42:29", "text": "あなたは私に、あなたは私に、あなたは私に、"}, {"type": "subtitle", "time": 13352.469, "timestamp": "03:42:32", "text": "数学っぽい雰囲気。いいえ、私は"}, {"type": "subtitle", "time": 13356.15, "timestamp": "03:42:36", "text": "社会学。なんてこった。ええと、人文科学ですね。"}, {"type": "subtitle", "time": 13357.99, "timestamp": "03:42:37", "text": "うん。うん。うん。うん。そう思った。私"}, {"type": "subtitle", "time": 13361.11, "timestamp": "03:42:41", "text": "人文科学ってどんな感じだと思う？"}, {"type": "subtitle", "time": 13365.11, "timestamp": "03:42:45", "text": "あなたが一番気に入ったのは、そのメインのものでしたか？メインのもの？えっと、"}, {"type": "subtitle", "time": 13366.87, "timestamp": "03:42:46", "text": "いいえ、私はあなたがここにいないふりをしているわけではありません。"}, {"type": "subtitle", "time": 13369.429, "timestamp": "03:42:49", "text": "先輩。まるで私たちのゲストがここにいるみたいだ、"}, {"type": "subtitle", "time": 13371.349, "timestamp": "03:42:51", "text": "知ってるよ、彼に少し分けてあげて"}, {"type": "subtitle", "time": 13375.349, "timestamp": "03:42:55", "text": "タピオカドリンクのこと、知ってるよね？よし、"}, {"type": "subtitle", "time": 13377.19, "timestamp": "03:42:57", "text": "彼と少し話をする。はい、続けてください。"}, {"type": "subtitle", "time": 13379.51, "timestamp": "03:42:59", "text": "お邪魔して申し訳ありません。"}]
[{"type": "subtitle", "time": 8461.11, "timestamp": "02:21:01", "text": "つまり、そのエンティティは"}, {"type": "subtitle", "time": 8464.23, "timestamp": "02:21:04", "text": "背中を軽く叩いたり、"}, {"type": "subtitle", "time": 8465.83, "timestamp": "02:21:05", "text": "何か。どうやって？何かを送ったように、"}, {"type": "subtitle", "time": 8467.59, "timestamp": "02:21:07", "text": "右？その人が何かを送ってきて"}, {"type": "subtitle", "time": 8478.23, "timestamp": "02:21:18", "text": "もしそれが異性だったら、ええと、"}, {"type": "subtitle", "time": 8481.429, "timestamp": "02:21:21", "text": "えっと、それは見知らぬ人かもしれないし、"}, {"type": "subtitle", "time": 8484.23, "timestamp": "02:21:24", "text": "不気味な人が殺したいと思っている"}, {"type": "subtitle", "time": 8487.67, "timestamp": "02:21:27", "text": "その人、ええと、それが標的になった理由です。"}, {"type": "subtitle", "time": 8489.75, "timestamp": "02:21:29", "text": "あるいは、同僚や友人が"}, {"type": "subtitle", "time": 8492.55, "timestamp": "02:21:32", "text": "その男と一緒にあの山に来たんだ、"}, {"type": "subtitle", "time": 8494.87, "timestamp": "02:21:34", "text": "それから、彼女はただ推進しようとした"}, {"type": "subtitle", "time": 8498.23, "timestamp": "02:21:38", "text": "いたずらを仕掛けるか、あるいはその人を殺してしまうかもしれない。あるいはそれが"}, {"type": "subtitle", "time": 8500.71, "timestamp": "02:21:40", "text": "犬か何かだったなら、"}, {"type": "subtitle", "time": 8504.55, "timestamp": "02:21:44", "text": "足音を立てる。もしそれが幽霊なら、"}, {"type": "subtitle", "time": 8507.11, "timestamp": "02:21:47", "text": "不気味な存在感を感じる"}, {"type": "subtitle", "time": 8510.469, "timestamp": "02:21:50", "text": "チリンチリンという音のような感覚。あなたの手と"}, {"type": "subtitle", "time": 8513.03, "timestamp": "02:21:53", "text": "体に鳥肌が立つような感覚がするだろう。"}, {"type": "subtitle", "time": 8516.79, "timestamp": "02:21:56", "text": "右？そして最後の選択肢は"}, {"type": "subtitle", "time": 8518.87, "timestamp": "02:21:58", "text": "何もない"}]
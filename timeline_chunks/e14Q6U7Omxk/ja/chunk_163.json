[{"type": "subtitle", "time": 9789.03, "timestamp": "02:43:09", "text": "うん。どうしたの？そうそう。実は"}, {"type": "subtitle", "time": 9791.51, "timestamp": "02:43:11", "text": "えっと、母は"}, {"type": "subtitle", "time": 9795.429, "timestamp": "02:43:15", "text": "何か、そして、私に頼んで、"}, {"type": "subtitle", "time": 9799.27, "timestamp": "02:43:19", "text": "彼女に何か物をあげよう。ああ、無料"}, {"type": "subtitle", "time": 9802.55, "timestamp": "02:43:22", "text": "それだけです。わかった。えっと、今何て言ったっけ？"}, {"type": "subtitle", "time": 9806.95, "timestamp": "02:43:26", "text": "する？そうそう。うん。そして、私は思う"}, {"type": "subtitle", "time": 9810.63, "timestamp": "02:43:30", "text": "PCの動作が遅くなった。ああ、ノートパソコンのことですね。さあ"}, {"type": "subtitle", "time": 9812.87, "timestamp": "02:43:32", "text": "どうなるか見てみようぜ。うん。うん、"}, {"type": "subtitle", "time": 9815.27, "timestamp": "02:43:35", "text": "あなたはまだ生きています。はい。"}, {"type": "subtitle", "time": 9818.07, "timestamp": "02:43:38", "text": "うん。"}, {"type": "subtitle", "time": 9820.79, "timestamp": "02:43:40", "text": "わかった。うん。では、何について話しているのでしょうか？"}, {"type": "subtitle", "time": 9823.83, "timestamp": "02:43:43", "text": "について？忘れてしまったと思います。"}, {"type": "subtitle", "time": 9825.75, "timestamp": "02:43:45", "text": "えっと"}, {"type": "subtitle", "time": 9829.11, "timestamp": "02:43:49", "text": "ああ、しまった、忘れてた。"}, {"type": "subtitle", "time": 9831.59, "timestamp": "02:43:51", "text": "ええ、そうですね、だから私は"}, {"type": "subtitle", "time": 9834.23, "timestamp": "02:43:54", "text": "私の携帯電話は、ええ、私は見ていました"}, {"type": "subtitle", "time": 9836.63, "timestamp": "02:43:56", "text": "あなたは大丈夫だと思った。はい、私は"}]
[{"type": "subtitle", "time": 5461.189, "timestamp": "01:31:01", "text": "どうやらそうではないようだ"}, {"type": "subtitle", "time": 5463.27, "timestamp": "01:31:03", "text": "私の状況について考え、"}, {"type": "subtitle", "time": 5466.95, "timestamp": "01:31:06", "text": "深く掘り下げないでおこう。なぜこう書いてあるの？"}, {"type": "subtitle", "time": 5470.39, "timestamp": "01:31:10", "text": "接続が切断されましたか？接続が切れたのでしょうか？"}, {"type": "subtitle", "time": 5472.39, "timestamp": "01:31:12", "text": "え、何？"}, {"type": "subtitle", "time": 5474.79, "timestamp": "01:31:14", "text": "あれ、配信が切断された？いいえ、"}, {"type": "subtitle", "time": 5481.43, "timestamp": "01:31:21", "text": "ええ、私は"}, {"type": "subtitle", "time": 5483.35, "timestamp": "01:31:23", "text": "もちろん違います。それはしません。うん、"}, {"type": "subtitle", "time": 5486.55, "timestamp": "01:31:26", "text": "私はそんなことはしません。私は終わった。私は"}, {"type": "subtitle", "time": 5489.59, "timestamp": "01:31:29", "text": "もうその件は終わった。"}, {"type": "subtitle", "time": 5505.27, "timestamp": "01:31:45", "text": "え、私の配信がクラッシュしたの？いいえ。そうですね。"}]
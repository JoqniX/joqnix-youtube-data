[{"type": "subtitle", "time": 10801.349, "timestamp": "03:00:01", "text": "友人が私の"}, {"type": "subtitle", "time": 10804.23, "timestamp": "03:00:04", "text": "私が配信しながらチャットを楽しませている間"}, {"type": "subtitle", "time": 10807.19, "timestamp": "03:00:07", "text": "睡眠に関すること。私はそれを見た"}, {"type": "subtitle", "time": 10811.03, "timestamp": "03:00:11", "text": "Twitchの他のYouTuberも同じようなことをしている。それで"}, {"type": "subtitle", "time": 10813.03, "timestamp": "03:00:13", "text": "私はそういう環境を持っていませんでした"}, {"type": "subtitle", "time": 10816.55, "timestamp": "03:00:16", "text": "最初は準備していたけど、私を知っている人なら、"}, {"type": "subtitle", "time": 10818.389, "timestamp": "03:00:18", "text": "より高度なものにする傾向があり、"}, {"type": "subtitle", "time": 10820.71, "timestamp": "03:00:20", "text": "複雑。つまり、より自動化されていて、"}, {"type": "subtitle", "time": 10823.19, "timestamp": "03:00:23", "text": "ストリームについては心配する必要はありません"}, {"type": "subtitle", "time": 10826.469, "timestamp": "03:00:26", "text": "私は寝ています。ゲストは"}, {"type": "subtitle", "time": 10829.429, "timestamp": "03:00:29", "text": "OBSの制御とその他すべて"}, {"type": "subtitle", "time": 10832.63, "timestamp": "03:00:32", "text": "チャットコマンドだけでそれら全てが実現"}, {"type": "subtitle", "time": 10836.389, "timestamp": "03:00:36", "text": "そして全て。それで私はそれをやって、"}, {"type": "subtitle", "time": 10839.19, "timestamp": "03:00:39", "text": "出席しなければならなかったので時間がかかりました"}, {"type": "subtitle", "time": 10841.03, "timestamp": "03:00:41", "text": "イベントとか色々。マインクラフトイベント"}, {"type": "subtitle", "time": 10844.389, "timestamp": "03:00:44", "text": "何が起こっていたのか、そして多くの時間が"}, {"type": "subtitle", "time": 10846.63, "timestamp": "03:00:46", "text": "そこにはない。だから私は「ああ、私はただ"}, {"type": "subtitle", "time": 10849.11, "timestamp": "03:00:49", "text": "行き当たりばったりでやってみよう。唯一のものをそのままにしておくか、"}, {"type": "subtitle", "time": 10851.99, "timestamp": "03:00:51", "text": "二人でそれを行う。それでいくつか手に入れました"}, {"type": "subtitle", "time": 10853.51, "timestamp": "03:00:53", "text": "人々はそういうことをするんです。それから私は"}, {"type": "subtitle", "time": 10857.91, "timestamp": "03:00:57", "text": "えっと、その頃には私は"}]
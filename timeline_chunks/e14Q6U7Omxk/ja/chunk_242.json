[{"type": "subtitle", "time": 14522.469, "timestamp": "04:02:02", "text": "ええ、それは確かに意味のあることです。うん、それは、それは"}, {"type": "subtitle", "time": 14524.55, "timestamp": "04:02:04", "text": "学習経験者。私はただ"}, {"type": "subtitle", "time": 14526.63, "timestamp": "04:02:06", "text": "それ。私がそれを説明したとき"}, {"type": "subtitle", "time": 14529.75, "timestamp": "04:02:09", "text": "両親はこう言った。「もしあなたが"}, {"type": "subtitle", "time": 14531.91, "timestamp": "04:02:11", "text": "うまくいった、それは素晴らしい、そしてお金"}, {"type": "subtitle", "time": 14534.55, "timestamp": "04:02:14", "text": "あなたが稼いだものは、あなたのものです。だから、"}, {"type": "subtitle", "time": 14537.99, "timestamp": "04:02:17", "text": "あんなことを二度としないで。それでおしまい。"}, {"type": "subtitle", "time": 14539.59, "timestamp": "04:02:19", "text": "彼らはある時点で幸せだったのは"}, {"type": "subtitle", "time": 14541.11, "timestamp": "04:02:21", "text": "彼らは、あなたはたくさんのお金を持っていると言いました"}, {"type": "subtitle", "time": 14544.55, "timestamp": "04:02:24", "text": "でも、彼らはそれが"}, {"type": "subtitle", "time": 14547.67, "timestamp": "04:02:27", "text": "お金を手に入れたのが早かったから偽物"}, {"type": "subtitle", "time": 14551.03, "timestamp": "04:02:31", "text": "100ドルからどれだけ早く上昇したか"}, {"type": "subtitle", "time": 14555.11, "timestamp": "04:02:35", "text": "ドルから100万ルピーまで、わかるでしょ"}, {"type": "subtitle", "time": 14558.79, "timestamp": "04:02:38", "text": "彼らは「彼はきっと解決するだろう」と思っていた。"}, {"type": "subtitle", "time": 14560.33, "timestamp": "04:02:40", "text": "ああ"}, {"type": "subtitle", "time": 14562.07, "timestamp": "04:02:42", "text": "[音楽]"}, {"type": "subtitle", "time": 14564.55, "timestamp": "04:02:44", "text": "それは学ぶことであり、それは良いことだ。"}, {"type": "subtitle", "time": 14566.95, "timestamp": "04:02:46", "text": "学習経験男、私がなぜ"}, {"type": "subtitle", "time": 14568.469, "timestamp": "04:02:48", "text": "降りていくのはもう終わったことです"}, {"type": "subtitle", "time": 14570.87, "timestamp": "04:02:50", "text": "今考える意味"}, {"type": "subtitle", "time": 14573.189, "timestamp": "04:02:53", "text": "ええ、それで私は"}, {"type": "subtitle", "time": 14575.189, "timestamp": "04:02:55", "text": "退職のことや計画のこと"}, {"type": "subtitle", "time": 14577.189, "timestamp": "04:02:57", "text": "もう早すぎることは分かってる"}, {"type": "subtitle", "time": 14578.87, "timestamp": "04:02:58", "text": "でも私はすでにそれを学んでいるので、"}]
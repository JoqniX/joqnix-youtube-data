[{"type": "subtitle", "time": 13200.469, "timestamp": "03:40:00", "text": "そうそう、部族的なことだよ。うん"}, {"type": "subtitle", "time": 13201.99, "timestamp": "03:40:01", "text": "まさにその通り、まるで部族のようだ"}, {"type": "subtitle", "time": 13204.389, "timestamp": "03:40:04", "text": "あれだよ、わかるだろ。そういうわけで、"}, {"type": "subtitle", "time": 13207.83, "timestamp": "03:40:07", "text": "Jのようなところからすると、それはラジャスタン州にある場所です。"}, {"type": "subtitle", "time": 13210.229, "timestamp": "03:40:10", "text": "わかった。そう、だから私は"}, {"type": "subtitle", "time": 13212.71, "timestamp": "03:40:12", "text": "ラジャスタン語を理解するのと同じように理解する"}, {"type": "subtitle", "time": 13214.389, "timestamp": "03:40:14", "text": "たくさん。"}, {"type": "subtitle", "time": 13219.03, "timestamp": "03:40:19", "text": "それは母親側の血筋のようなものだ。うん。"}, {"type": "subtitle", "time": 13223.83, "timestamp": "03:40:23", "text": "歴史の授業で習ったのを覚えています。"}, {"type": "subtitle", "time": 13226.309, "timestamp": "03:40:26", "text": "うん。うん。私の"}, {"type": "subtitle", "time": 13228.71, "timestamp": "03:40:28", "text": "8年生の歴史の授業のように"}, {"type": "subtitle", "time": 13231.03, "timestamp": "03:40:31", "text": "私の友達のような人たちが来るだろう"}, {"type": "subtitle", "time": 13232.79, "timestamp": "03:40:32", "text": "私次第です、ええ、これはあなたですよね"}, {"type": "subtitle", "time": 13235.83, "timestamp": "03:40:35", "text": "これこれこれ君のそうだね"}, {"type": "subtitle", "time": 13237.75, "timestamp": "03:40:37", "text": "まるですべてのシングルがすべてのシングルのようでした"}, {"type": "subtitle", "time": 13239.75, "timestamp": "03:40:39", "text": "チャスについて勉強していた時、"}, {"type": "subtitle", "time": 13241.75, "timestamp": "03:40:41", "text": "彼らは「これがあなた」と言うけど、私は「違う」と言う"}, {"type": "subtitle", "time": 13243.59, "timestamp": "03:40:43", "text": "それから"}, {"type": "subtitle", "time": 13247.11, "timestamp": "03:40:47", "text": "私は自分が全てではないような気がする"}, {"type": "subtitle", "time": 13249.83, "timestamp": "03:40:49", "text": "それは別物ですが、それはただ"}, {"type": "subtitle", "time": 13252.95, "timestamp": "03:40:52", "text": "ランダムな情報ですね、ええ、そうです"}, {"type": "subtitle", "time": 13256.309, "timestamp": "03:40:56", "text": "すごい、もっと知ることができて、これを学んだ"}, {"type": "subtitle", "time": 13259.269, "timestamp": "03:40:59", "text": "今"}]
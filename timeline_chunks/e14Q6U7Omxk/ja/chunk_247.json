[{"type": "subtitle", "time": 14822.15, "timestamp": "04:07:02", "text": "ハッピー。うん。俺はさらに幸せだよ。私は"}, {"type": "subtitle", "time": 14824.07, "timestamp": "04:07:04", "text": "あなたのような人を見つけることができてさらに嬉しいです"}, {"type": "subtitle", "time": 14825.91, "timestamp": "04:07:05", "text": "正直に言っています。"}, {"type": "subtitle", "time": 14828.79, "timestamp": "04:07:08", "text": "うん、すごく楽しいよ。"}, {"type": "subtitle", "time": 14831.03, "timestamp": "04:07:11", "text": "でも、私はそこがわからないような気がする"}, {"type": "subtitle", "time": 14833.03, "timestamp": "04:07:13", "text": "これからは、私と同じように他の人たちもそうなるでしょう。私"}, {"type": "subtitle", "time": 14835.51, "timestamp": "04:07:15", "text": "わからない。"}, {"type": "subtitle", "time": 14838.229, "timestamp": "04:07:18", "text": "もし見つけたら本当に嬉しいです"}, {"type": "subtitle", "time": 14841.51, "timestamp": "04:07:21", "text": "あなたのような人たち。でも、本当に"}, {"type": "subtitle", "time": 14843.91, "timestamp": "04:07:23", "text": "あなたにお会いできて嬉しいです。我々は持っています"}, {"type": "subtitle", "time": 14846.229, "timestamp": "04:07:26", "text": "楽しいおしゃべりでした。私たちは楽しい時間を過ごしました"}, {"type": "subtitle", "time": 14848.87, "timestamp": "04:07:28", "text": "クイズ。彼は私たちの持ち物について話し、"}, {"type": "subtitle", "time": 14850.95, "timestamp": "04:07:30", "text": "物があって、人がいた。ありがたいことに"}, {"type": "subtitle", "time": 14854.95, "timestamp": "04:07:34", "text": "空っぽのストリームのようなものだと思った"}, {"type": "subtitle", "time": 14857.429, "timestamp": "04:07:37", "text": "しかし幸いなことに、人々は来てくれた。我々は持っています"}, {"type": "subtitle", "time": 14861.269, "timestamp": "04:07:41", "text": "いい話ができたし、すごく楽しかったよ。私は大好きです"}, {"type": "subtitle", "time": 14865.189, "timestamp": "04:07:45", "text": "それ。ジョアソンがうまくいくといいですね。"}, {"type": "subtitle", "time": 14868.309, "timestamp": "04:07:48", "text": "あなたは完了します。ああ、忘れないでください"}, {"type": "subtitle", "time": 14870.79, "timestamp": "04:07:50", "text": "背を右に向けて勉強してください。えーとしないで"}, {"type": "subtitle", "time": 14872.389, "timestamp": "04:07:52", "text": "川は彼らのことを忘れない。全て"}, {"type": "subtitle", "time": 14875.99, "timestamp": "04:07:55", "text": "右。うん。必ずそれらに挑戦してください"}, {"type": "subtitle", "time": 14877.91, "timestamp": "04:07:57", "text": "他の縫い目も確認してみますね。"}]
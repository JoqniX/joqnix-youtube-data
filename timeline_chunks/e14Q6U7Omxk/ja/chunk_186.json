[{"type": "subtitle", "time": 11161.83, "timestamp": "03:06:01", "text": "ごめん。不足なんてないよ。あなたの持ち物"}, {"type": "subtitle", "time": 11164.07, "timestamp": "03:06:04", "text": "すでにかなり良い"}, {"type": "subtitle", "time": 11166.23, "timestamp": "03:06:06", "text": "話し方、説明の仕方"}, {"type": "subtitle", "time": 11168.389, "timestamp": "03:06:08", "text": "物事、フィードが速い、速い"}, {"type": "subtitle", "time": 11171.03, "timestamp": "03:06:11", "text": "返信に関しては、すべて問題ありません。いや、"}, {"type": "subtitle", "time": 11173.67, "timestamp": "03:06:13", "text": "YouTubeについてはよくわからない"}, {"type": "subtitle", "time": 11176.87, "timestamp": "03:06:16", "text": "もの。私はYouTubeを始めました"}, {"type": "subtitle", "time": 11178.469, "timestamp": "03:06:18", "text": "2015年。"}, {"type": "subtitle", "time": 11181.349, "timestamp": "03:06:21", "text": "おお。それが私が持っていたもので、ええ、私は"}, {"type": "subtitle", "time": 11184.469, "timestamp": "03:06:24", "text": "これまで7チャンネルくらいだった。いいえ、違います"}, {"type": "subtitle", "time": 11187.03, "timestamp": "03:06:27", "text": "7つ、つまり5つか6つのチャンネルです。私"}, {"type": "subtitle", "time": 11189.349, "timestamp": "03:06:29", "text": "ほとんど削除したと思うのは"}, {"type": "subtitle", "time": 11191.75, "timestamp": "03:06:31", "text": "私がテストしていたもののいくつか、例えばこのようなもの"}, {"type": "subtitle", "time": 11193.83, "timestamp": "03:06:33", "text": "この商品は効果があるのか​​、それとも効果がないのか"}, {"type": "subtitle", "time": 11195.59, "timestamp": "03:06:35", "text": "この仕事はうまくいくから、私の"}, {"type": "subtitle", "time": 11197.91, "timestamp": "03:06:37", "text": "サムネイルは機能します。クリックする方法はわかっています。"}, {"type": "subtitle", "time": 11200.71, "timestamp": "03:06:40", "text": "すぐに餌を撒くと、ジョニーの声が聞こえる"}, {"type": "subtitle", "time": 11203.67, "timestamp": "03:06:43", "text": "画面に映ってるよ、ああ、待ちきれないよ"}, {"type": "subtitle", "time": 11207.11, "timestamp": "03:06:47", "text": "君たちは彼の声を聞けないよ、待って、どうすればいいの？"}, {"type": "subtitle", "time": 11211.03, "timestamp": "03:06:51", "text": "私はそれを待って、アプリケーションキャプチャします"}]
[{"type": "subtitle", "time": 11100.15, "timestamp": "03:05:00", "text": "あなたにお会いできて嬉しいです。"}, {"type": "subtitle", "time": 11104.15, "timestamp": "03:05:04", "text": "ああ、それはあなたの"}, {"type": "subtitle", "time": 11107.59, "timestamp": "03:05:07", "text": "彼は最年長だ。彼は"}, {"type": "subtitle", "time": 11111.03, "timestamp": "03:05:11", "text": "私の栄枯盛衰の時代。彼は"}, {"type": "subtitle", "time": 11112.71, "timestamp": "03:05:12", "text": "唯一、私の記憶に残ったもの。だから私は"}, {"type": "subtitle", "time": 11116.23, "timestamp": "03:05:16", "text": "彼のことが本当に好きです。まあ、そうですね。それで"}, {"type": "subtitle", "time": 11119.59, "timestamp": "03:05:19", "text": "あなたが話している内容に戻りますが"}, {"type": "subtitle", "time": 11122.15, "timestamp": "03:05:22", "text": "本当に、実際、あなたのやり方"}, {"type": "subtitle", "time": 11126.309, "timestamp": "03:05:26", "text": "話すのが好きで、そのようにして"}, {"type": "subtitle", "time": 11128.55, "timestamp": "03:05:28", "text": "では、ビジネスライクな口調で話しましょう。"}, {"type": "subtitle", "time": 11131.349, "timestamp": "03:05:31", "text": "右。わかった。"}, {"type": "subtitle", "time": 11134.63, "timestamp": "03:05:34", "text": "わかった。ビジネスの話だよ、男。えっと、あなたは"}, {"type": "subtitle", "time": 11137.19, "timestamp": "03:05:37", "text": "編集作業。必要なのは編集者だけだ。"}, {"type": "subtitle", "time": 11139.59, "timestamp": "03:05:39", "text": "ストリームやあなたが共有するもの"}, {"type": "subtitle", "time": 11143.11, "timestamp": "03:05:43", "text": "ストリームやその他たくさんのもの"}, {"type": "subtitle", "time": 11148.309, "timestamp": "03:05:48", "text": "やることは本当に素晴らしい。でも、それは必要だ"}, {"type": "subtitle", "time": 11150.469, "timestamp": "03:05:50", "text": "不要な部分を切り取る。うん。わかった。私の"}, {"type": "subtitle", "time": 11153.19, "timestamp": "03:05:53", "text": "声。いや、いや、いや。いや、いや。私は私の"}, {"type": "subtitle", "time": 11156.389, "timestamp": "03:05:56", "text": "物が不足している。ああ、わかりました。ああ、足りない。"}, {"type": "subtitle", "time": 11158.63, "timestamp": "03:05:58", "text": "何てことだ。遅延が発生していると聞きました。私は"}]
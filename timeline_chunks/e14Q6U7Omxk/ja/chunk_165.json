[{"type": "subtitle", "time": 9902.87, "timestamp": "02:45:02", "text": "[音楽]"}, {"type": "subtitle", "time": 9904.71, "timestamp": "02:45:04", "text": "聞いています。続く。うん。今私は"}, {"type": "subtitle", "time": 9907.67, "timestamp": "02:45:07", "text": "今は心配しないで、楽にできるから"}, {"type": "subtitle", "time": 9909.99, "timestamp": "02:45:09", "text": "今。えーと、もし人々が日程変更を希望したり、"}, {"type": "subtitle", "time": 9912.95, "timestamp": "02:45:12", "text": "もっと時間が必要なので、"}, {"type": "subtitle", "time": 9917.99, "timestamp": "02:45:17", "text": "今は息抜きできる余裕がある。"}, {"type": "subtitle", "time": 9920.309, "timestamp": "02:45:20", "text": "うん。うん。まるでそれが良いことであるかのようにね。"}, {"type": "subtitle", "time": 9923.349, "timestamp": "02:45:23", "text": "少なくとも最初は"}, {"type": "subtitle", "time": 9925.03, "timestamp": "02:45:25", "text": "好きになる前に、好きにならなければならない"}, {"type": "subtitle", "time": 9926.71, "timestamp": "02:45:26", "text": "何とか乗り越える。あなたがしなければならない"}, {"type": "subtitle", "time": 9928.309, "timestamp": "02:45:28", "text": "要点を押さえる、といった感じ。作らなければならない"}, {"type": "subtitle", "time": 9930.15, "timestamp": "02:45:30", "text": "インターネットでいくつか情報を見つけました。オンにする必要があります"}, {"type": "subtitle", "time": 9932.389, "timestamp": "02:45:32", "text": "毎回素早く動け。今あなた"}, {"type": "subtitle", "time": 9934.55, "timestamp": "02:45:34", "text": "時間をかけて、良い時間を過ごしてください"}, {"type": "subtitle", "time": 9936.55, "timestamp": "02:45:36", "text": "みんなと会話するみたいに、"}, {"type": "subtitle", "time": 9938.309, "timestamp": "02:45:38", "text": "みんなと楽しもう、みんなと遊ぼう、"}, {"type": "subtitle", "time": 9941.67, "timestamp": "02:45:41", "text": "あなたが知っている。うん。あるいは、次のようなこともできます。"}, {"type": "subtitle", "time": 9945.75, "timestamp": "02:45:45", "text": "うん。うん。ええと、そうですね、"}, {"type": "subtitle", "time": 9948.87, "timestamp": "02:45:48", "text": "すでにこれらの人たちの予定を入れているので"}, {"type": "subtitle", "time": 9951.91, "timestamp": "02:45:51", "text": "21日までオファーしているので、"}, {"type": "subtitle", "time": 9955.349, "timestamp": "02:45:55", "text": "それを終わらせろ。えっと"}, {"type": "subtitle", "time": 9957.51, "timestamp": "02:45:57", "text": "うん、いつでも、私はいつでも"}]
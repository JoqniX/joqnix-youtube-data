[{"type": "subtitle", "time": 12120.79, "timestamp": "03:22:00", "text": "ストリーミングやその他すべてがひどくて"}, {"type": "subtitle", "time": 12123.03, "timestamp": "03:22:03", "text": "失敗者のように振る舞う。えっと、それは要りません"}, {"type": "subtitle", "time": 12125.59, "timestamp": "03:22:05", "text": "失敗者となる。だから私はそのモデルが欲しかったのです"}, {"type": "subtitle", "time": 12128.229, "timestamp": "03:22:08", "text": "真に輝きを放つために"}, {"type": "subtitle", "time": 12131.349, "timestamp": "03:22:11", "text": "ふさわしい。しかし、"}, {"type": "subtitle", "time": 12134.63, "timestamp": "03:22:14", "text": "モデルを使うなら、私の欠点は"}, {"type": "subtitle", "time": 12138.63, "timestamp": "03:22:18", "text": "その成長を阻害するスキル"}, {"type": "subtitle", "time": 12141.11, "timestamp": "03:22:21", "text": "モデルや輝きが本当に"}, {"type": "subtitle", "time": 12143.91, "timestamp": "03:22:23", "text": "ふさわしい。そのため、私は次のように考えました"}, {"type": "subtitle", "time": 12146.309, "timestamp": "03:22:26", "text": "私が準備ができていることを証明するために"}, {"type": "subtitle", "time": 12149.83, "timestamp": "03:22:29", "text": "そのモデルを使って、私が考えたのは"}, {"type": "subtitle", "time": 12152.55, "timestamp": "03:22:32", "text": "ずっとやりたかったことをする"}, {"type": "subtitle", "time": 12155.67, "timestamp": "03:22:35", "text": "人々とコラボレーションし、また好き"}, {"type": "subtitle", "time": 12159.11, "timestamp": "03:22:39", "text": "動画やその他のコンテンツをアップロードする"}, {"type": "subtitle", "time": 12162.63, "timestamp": "03:22:42", "text": "私はむしろ怖かったし、"}, {"type": "subtitle", "time": 12164.71, "timestamp": "03:22:44", "text": "怖かったというより、私は"}, {"type": "subtitle", "time": 12167.349, "timestamp": "03:22:47", "text": "完璧主義者。もしそうでないなら"}, {"type": "subtitle", "time": 12169.91, "timestamp": "03:22:49", "text": "超高品質、一般的なタイプの"}, {"type": "subtitle", "time": 12172.55, "timestamp": "03:22:52", "text": "品質が良くないので、私のチャンネルには良くありません。"}, {"type": "subtitle", "time": 12174.87, "timestamp": "03:22:54", "text": "私はみんなが始めるよりも"}, {"type": "subtitle", "time": 12176.309, "timestamp": "03:22:56", "text": "どこかに、ですよね？私たちは皆、"}, {"type": "subtitle", "time": 12178.63, "timestamp": "03:22:58", "text": "どこかで。私たちはPewDiePieのようにスタートします"}]
[{"type": "subtitle", "time": 10140.15, "timestamp": "02:49:00", "text": "最高の商品です。うん。"}, {"type": "subtitle", "time": 10142.87, "timestamp": "02:49:02", "text": "私はただ、えーと、私が思うのは"}, {"type": "subtitle", "time": 10144.63, "timestamp": "02:49:04", "text": "朝、私はただ好奇心を持って"}, {"type": "subtitle", "time": 10146.71, "timestamp": "02:49:06", "text": "好きなものをチェックして"}, {"type": "subtitle", "time": 10149.67, "timestamp": "02:49:09", "text": "日本語は、すべてと男についてです"}, {"type": "subtitle", "time": 10152.15, "timestamp": "02:49:12", "text": "あなたはたくさんのものを持っている"}, {"type": "subtitle", "time": 10154.63, "timestamp": "02:49:14", "text": "それはあなたの課題です。"}, {"type": "subtitle", "time": 10157.19, "timestamp": "02:49:17", "text": "ええ、ひらがなとカタカナは"}, {"type": "subtitle", "time": 10161.269, "timestamp": "02:49:21", "text": "別々だけど漢字はh わからないよ"}, {"type": "subtitle", "time": 10165.11, "timestamp": "02:49:25", "text": "あなたはたくさんのことを抱えている"}, {"type": "subtitle", "time": 10168.23, "timestamp": "02:49:28", "text": "漢字が多すぎるので集中しなければならない"}, {"type": "subtitle", "time": 10171.269, "timestamp": "02:49:31", "text": "漢字は実際正直ゆっくりと"}, {"type": "subtitle", "time": 10174.71, "timestamp": "02:49:34", "text": "それを上達させる"}, {"type": "subtitle", "time": 10176.15, "timestamp": "02:49:36", "text": "君は努力家だから、きっとそこにたどり着けるよ。"}, {"type": "subtitle", "time": 10178.15, "timestamp": "02:49:38", "text": "知ってるよ、君はできるよ、引っ張って"}, {"type": "subtitle", "time": 10182.95, "timestamp": "02:49:42", "text": "オフにしてください、心配しないでください"}, {"type": "subtitle", "time": 10184.55, "timestamp": "02:49:44", "text": "H"}, {"type": "subtitle", "time": 10187.67, "timestamp": "02:49:47", "text": "私は、私は、私は、私は知りません。それは贈り物のようだ"}, {"type": "subtitle", "time": 10189.19, "timestamp": "02:49:49", "text": "あるいは、そんな感じ。私は人々のことを理解できます"}, {"type": "subtitle", "time": 10191.67, "timestamp": "02:49:51", "text": "性格は普通の人よりもずっと前から"}, {"type": "subtitle", "time": 10194.71, "timestamp": "02:49:54", "text": "習慣とかそういうもの。ええ、私は知っています"}, {"type": "subtitle", "time": 10196.79, "timestamp": "02:49:56", "text": "誰を避けるべきか、誰と話すべきか、"}, {"type": "subtitle", "time": 10199.269, "timestamp": "02:49:59", "text": "そういうことだよ、わかるだろ？えっと、私は話したと思う"}]
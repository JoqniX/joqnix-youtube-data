[{"type": "subtitle", "time": 7380.149, "timestamp": "02:03:00", "text": "今もまだ回転している。ええ、まだです"}, {"type": "subtitle", "time": 7381.91, "timestamp": "02:03:01", "text": "解決しました。よくわからない。行く"}, {"type": "subtitle", "time": 7383.83, "timestamp": "02:03:03", "text": "ソフトウェア。手伝いますよ。手伝います"}, {"type": "subtitle", "time": 7387.27, "timestamp": "02:03:07", "text": "あなた。このリンクにアクセスしてください。あなたに送ります"}, {"type": "subtitle", "time": 7389.43, "timestamp": "02:03:09", "text": "リンク。これをブラウザのソースとして追加してください。"}, {"type": "subtitle", "time": 7395.91, "timestamp": "02:03:15", "text": "私は富士のテキストファイルを開きました、あなたは"}, {"type": "subtitle", "time": 7397.99, "timestamp": "02:03:17", "text": "できない、どうすればいいのかわからない"}, {"type": "subtitle", "time": 7400.87, "timestamp": "02:03:20", "text": "「ああ、再起動すればいいだけだよ。」"}, {"type": "subtitle", "time": 7404.229, "timestamp": "02:03:24", "text": "再起動する必要があります。心配ない。"}, {"type": "subtitle", "time": 7408.229, "timestamp": "02:03:28", "text": "デバッグツールを開いてください。えっと、追加してください"}, {"type": "subtitle", "time": 7409.99, "timestamp": "02:03:29", "text": "サービス。"}, {"type": "subtitle", "time": 7411.589, "timestamp": "02:03:31", "text": "ちょっと待ってください。ちょっと待って。ただ"}, {"type": "subtitle", "time": 7413.99, "timestamp": "02:03:33", "text": "2番。私の"}, {"type": "subtitle", "time": 7415.91, "timestamp": "02:03:35", "text": "2番"}, {"type": "subtitle", "time": 7418.39, "timestamp": "02:03:38", "text": "えっと、デバッグ用のやつ。"}, {"type": "subtitle", "time": 7424.95, "timestamp": "02:03:44", "text": "この中で、デバッグ関連のものを開きます。何"}, {"type": "subtitle", "time": 7427.99, "timestamp": "02:03:47", "text": "今すぐやるべきでしょうか？えっと、開けましたか？"}, {"type": "subtitle", "time": 7431.109, "timestamp": "02:03:51", "text": "OBSにブラウザソースとして追加するのですか？"}, {"type": "subtitle", "time": 7433.51, "timestamp": "02:03:53", "text": "デバッグテスト。ええ、そのリンクです。"}, {"type": "subtitle", "time": 7437.669, "timestamp": "02:03:57", "text": "はい。開けてください。ソースとして追加してください。えっと"}, {"type": "subtitle", "time": 7439.189, "timestamp": "02:03:59", "text": "配信で見せる必要はありません。"}]
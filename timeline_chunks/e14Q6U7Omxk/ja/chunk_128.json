[{"type": "subtitle", "time": 7680.95, "timestamp": "02:08:00", "text": "ああ、インストールしないといけないんだ。おお、"}, {"type": "subtitle", "time": 7683.91, "timestamp": "02:08:03", "text": "うん。忘れた。"}, {"type": "subtitle", "time": 7685.91, "timestamp": "02:08:05", "text": "ああ、もう。間違いじゃないよ、君。私"}, {"type": "subtitle", "time": 7689.35, "timestamp": "02:08:09", "text": "忘れた。ちょっと待って。忘れた。その"}, {"type": "subtitle", "time": 7691.669, "timestamp": "02:08:11", "text": "わかった。心配ない。あのね？のために"}, {"type": "subtitle", "time": 7694.31, "timestamp": "02:08:14", "text": "その時代のために、彼に"}, {"type": "subtitle", "time": 7696.95, "timestamp": "02:08:16", "text": "左。"}, {"type": "subtitle", "time": 7699.27, "timestamp": "02:08:19", "text": "わかった。ああ、私は、ああ、私は"}, {"type": "subtitle", "time": 7709.35, "timestamp": "02:08:29", "text": "私は誤って退出しました。大丈夫。えっと、私は"}, {"type": "subtitle", "time": 7711.669, "timestamp": "02:08:31", "text": "私のPNGファイルをお渡しします。とりあえず追加しておいても構いません。"}, {"type": "subtitle", "time": 7719.669, "timestamp": "02:08:39", "text": "えっと、わかりました。私はあなたの全てを手に入れたと思う"}, {"type": "subtitle", "time": 7722.629, "timestamp": "02:08:42", "text": "PGの。私はそれを使います。"}, {"type": "subtitle", "time": 7727.189, "timestamp": "02:08:47", "text": "うん。私はPGを送りません。"}, {"type": "subtitle", "time": 7728.709, "timestamp": "02:08:48", "text": "おお、"}]
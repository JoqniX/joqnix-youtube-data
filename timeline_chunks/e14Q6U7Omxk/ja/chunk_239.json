[{"type": "subtitle", "time": 14342.71, "timestamp": "03:59:02", "text": "私はそれをしました。彼が"}, {"type": "subtitle", "time": 14346.309, "timestamp": "03:59:06", "text": "株式市場に参入すると、"}, {"type": "subtitle", "time": 14348.79, "timestamp": "03:59:08", "text": "仮想通貨市場、私は飛び乗って、"}, {"type": "subtitle", "time": 14350.63, "timestamp": "03:59:10", "text": "今すぐ購入、販売"}, {"type": "subtitle", "time": 14353.349, "timestamp": "03:59:13", "text": "今、今買って、今売ろう。そして彼は"}, {"type": "subtitle", "time": 14356.15, "timestamp": "03:59:16", "text": "200人から300人くらいでそれをやってみよう"}, {"type": "subtitle", "time": 14358.229, "timestamp": "03:59:18", "text": "もっと。まるで私たち全員がこれに関わっていたかのように、"}, {"type": "subtitle", "time": 14361.59, "timestamp": "03:59:21", "text": "彼を見ている人は皆、このDiscordチャンネルにいます。"}, {"type": "subtitle", "time": 14364.389, "timestamp": "03:59:24", "text": "そして彼がすることは、"}, {"type": "subtitle", "time": 14367.51, "timestamp": "03:59:27", "text": "売買方法を教えます。だからそれはある意味"}, {"type": "subtitle", "time": 14369.99, "timestamp": "03:59:29", "text": "違法。正直に言うと、"}, {"type": "subtitle", "time": 14373.189, "timestamp": "03:59:33", "text": "価格を上げて、"}, {"type": "subtitle", "time": 14375.83, "timestamp": "03:59:35", "text": "大きな爆発の後、それを売って"}, {"type": "subtitle", "time": 14378.229, "timestamp": "03:59:38", "text": "人々がお金を失うので損失が発生する"}, {"type": "subtitle", "time": 14380.55, "timestamp": "03:59:40", "text": "なぜなら、お金を投入しているとき"}, {"type": "subtitle", "time": 14382.79, "timestamp": "03:59:42", "text": "上昇セクションでは、誰かが"}, {"type": "subtitle", "time": 14384.63, "timestamp": "03:59:44", "text": "服用時に"}, {"type": "subtitle", "time": 14386.07, "timestamp": "03:59:46", "text": "お金の口座とそれが彼らに引き起こす"}, {"type": "subtitle", "time": 14390.389, "timestamp": "03:59:50", "text": "損失ですよね？それはサンタバーバラでは違法です。"}, {"type": "subtitle", "time": 14392.309, "timestamp": "03:59:52", "text": "しかし当時、暗号通貨はすでに"}, {"type": "subtitle", "time": 14393.91, "timestamp": "03:59:53", "text": "違法。それは全く意味が通じない。"}, {"type": "subtitle", "time": 14396.79, "timestamp": "03:59:56", "text": "インドでは普及していなかった。だから何"}]
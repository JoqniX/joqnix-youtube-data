[{"type": "subtitle", "time": 7981.83, "timestamp": "02:13:01", "text": "何か。わからない。おそらく"}, {"type": "subtitle", "time": 7984.39, "timestamp": "02:13:04", "text": "彼が望んでいたのは、"}, {"type": "subtitle", "time": 7986.79, "timestamp": "02:13:06", "text": "彼自身と孤立したゲームまたは"}, {"type": "subtitle", "time": 7990.709, "timestamp": "02:13:10", "text": "何か。ええ、つまり、"}, {"type": "subtitle", "time": 7993.109, "timestamp": "02:13:13", "text": "通常の回答です。サイコパスは"}, {"type": "subtitle", "time": 7996.39, "timestamp": "02:13:16", "text": "まるでその子には足がなかったかのようだった。"}, {"type": "subtitle", "time": 8000.149, "timestamp": "02:13:20", "text": "何てことだ。ああ、なんてことだ。ええ、私は"}, {"type": "subtitle", "time": 8001.83, "timestamp": "02:13:21", "text": "それらの物と一緒に表示すらされていませんでした。のように"}, {"type": "subtitle", "time": 8003.83, "timestamp": "02:13:23", "text": "とても楽しかったのですが、本当に"}, {"type": "subtitle", "time": 8007.43, "timestamp": "02:13:27", "text": "めちゃくちゃで最悪。うん。方法をご覧ください"}, {"type": "subtitle", "time": 8010.229, "timestamp": "02:13:30", "text": "これでいいよ。"}, {"type": "subtitle", "time": 8013.75, "timestamp": "02:13:33", "text": "H. では、次は。ある夜、男が"}, {"type": "subtitle", "time": 8016.229, "timestamp": "02:13:36", "text": "喉が渇いていて、キッチンが必要なので"}, {"type": "subtitle", "time": 8019.589, "timestamp": "02:13:39", "text": "水が少し。飲み終えた後、私は"}, {"type": "subtitle", "time": 8021.35, "timestamp": "02:13:41", "text": "水を飲むという意味で、彼は"}, {"type": "subtitle", "time": 8023.83, "timestamp": "02:13:43", "text": "右。彼は強盗を目撃した。この男は走る"}, {"type": "subtitle", "time": 8026.39, "timestamp": "02:13:46", "text": "離れてクローゼットの中に隠れる。"}, {"type": "subtitle", "time": 8028.79, "timestamp": "02:13:48", "text": "さて、もしあなたが強盗なら、もしあなたが"}, {"type": "subtitle", "time": 8031.83, "timestamp": "02:13:51", "text": "強盗が男とあなたを見た"}, {"type": "subtitle", "time": 8033.99, "timestamp": "02:13:53", "text": "手にナイフを持っていたら、彼は"}, {"type": "subtitle", "time": 8036.47, "timestamp": "02:13:56", "text": "する？"}]
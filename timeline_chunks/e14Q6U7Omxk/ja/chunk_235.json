[{"type": "subtitle", "time": 14101.03, "timestamp": "03:55:01", "text": "インドのように、虹三次のように、彼らは"}, {"type": "subtitle", "time": 14103.75, "timestamp": "03:55:03", "text": "すでに彼らは"}, {"type": "subtitle", "time": 14106.71, "timestamp": "03:55:06", "text": "終わったら、その時私は始めた"}, {"type": "subtitle", "time": 14110.15, "timestamp": "03:55:10", "text": "それから、えっと、3～4時間くらいかかりました"}, {"type": "subtitle", "time": 14113.83, "timestamp": "03:55:13", "text": "何時間もかけて、自分で作ったもの、えっと、これ"}, {"type": "subtitle", "time": 14116.55, "timestamp": "03:55:16", "text": "モデル ボイド 古いもの、ご存知のもの"}, {"type": "subtitle", "time": 14119.429, "timestamp": "03:55:19", "text": "ファンキーはエモ系の少年のような男の子です。うん。うん。"}, {"type": "subtitle", "time": 14122.55, "timestamp": "03:55:22", "text": "私もあれを作ったよ。それでその後私は"}, {"type": "subtitle", "time": 14125.03, "timestamp": "03:55:25", "text": "昔好きだったから作った"}, {"type": "subtitle", "time": 14127.99, "timestamp": "03:55:27", "text": "本当に色々なことを試している。私は"}, {"type": "subtitle", "time": 14131.11, "timestamp": "03:55:31", "text": "暗号通貨についてたくさん学んでいるので"}, {"type": "subtitle", "time": 14133.99, "timestamp": "03:55:33", "text": "将来のために、金銭面などについて考えておく必要がある。それで"}, {"type": "subtitle", "time": 14136.07, "timestamp": "03:55:36", "text": "えっと、チェックアウトを始めました"}, {"type": "subtitle", "time": 14139.11, "timestamp": "03:55:39", "text": "YouTuber。私はアニメが本当に得意だった"}, {"type": "subtitle", "time": 14141.51, "timestamp": "03:55:41", "text": "などなど。私は見ています"}, {"type": "subtitle", "time": 14145.03, "timestamp": "03:55:45", "text": "確かethかninthだったと思う。そうですね、"}, {"type": "subtitle", "time": 14148.71, "timestamp": "03:55:48", "text": "手稿とかそういうものにも興味があった。それは"}, {"type": "subtitle", "time": 14150.87, "timestamp": "03:55:50", "text": "かなり良い。私も美術担当だったよ、"}, {"type": "subtitle", "time": 14153.67, "timestamp": "03:55:53", "text": "知る。あなたが好き、私も好き"}, {"type": "subtitle", "time": 14156.15, "timestamp": "03:55:56", "text": "えっと、絵を描いたりとか。私は、えーと"}, {"type": "subtitle", "time": 14158.95, "timestamp": "03:55:58", "text": "私の壁に飾られた絵画。私は絵を描いた。送ります"}]
[{"type": "subtitle", "time": 3602.71, "timestamp": "01:00:02", "text": "どうやら今日、2件のコメントをもらったようだ。"}, {"type": "subtitle", "time": 3604.71, "timestamp": "01:00:04", "text": "それは昨日のことだったと思う、あるいは"}, {"type": "subtitle", "time": 3607.67, "timestamp": "01:00:07", "text": "例えば朝のように。えっと、私、やらかしちゃったと思う"}, {"type": "subtitle", "time": 3612.069, "timestamp": "01:00:12", "text": "まるで何か特別なものがあるかのように持ち上げる。ええ、私は"}, {"type": "subtitle", "time": 3615.03, "timestamp": "01:00:15", "text": "きちんと調査しました"}, {"type": "subtitle", "time": 3618.39, "timestamp": "01:00:18", "text": "正しい言い回しですね、私は少し知っていますから"}, {"type": "subtitle", "time": 3621.43, "timestamp": "01:00:21", "text": "間違いはあなたをみんなと同じように行かせることができます"}, {"type": "subtitle", "time": 3625.43, "timestamp": "01:00:25", "text": "きっとすごく怒るだろう。そして、そして、そして、"}, {"type": "subtitle", "time": 3627.99, "timestamp": "01:00:27", "text": "その上に、まるで私は"}, {"type": "subtitle", "time": 3631.75, "timestamp": "01:00:31", "text": "そして私はそんな中ではまるでよそ者のような存在だ"}, {"type": "subtitle", "time": 3633.829, "timestamp": "01:00:33", "text": "未知の場所"}, {"type": "subtitle", "time": 3636.309, "timestamp": "01:00:36", "text": "税関についてはよく知らないし、"}, {"type": "subtitle", "time": 3638.63, "timestamp": "01:00:38", "text": "すべてがどのように、または何か、またはすべての"}, {"type": "subtitle", "time": 3640.47, "timestamp": "01:00:40", "text": "言語。つまり、ある種の痛みですよね？"}, {"type": "subtitle", "time": 3642.95, "timestamp": "01:00:42", "text": "ええ、どうやらコメントが2件あったようです"}, {"type": "subtitle", "time": 3646.549, "timestamp": "01:00:46", "text": "Lunaを使うべきではなかったと言っている"}, {"type": "subtitle", "time": 3650.15, "timestamp": "01:00:50", "text": "新年か何か。わからない。私は"}, {"type": "subtitle", "time": 3652.309, "timestamp": "01:00:52", "text": "混乱しているような感じ。サムネイルのように、"}, {"type": "subtitle", "time": 3653.91, "timestamp": "01:00:53", "text": "サムネイルは中国語で、"}, {"type": "subtitle", "time": 3656.63, "timestamp": "01:00:56", "text": "2023年の旧正月おめでとうございます。"}, {"type": "subtitle", "time": 3659.19, "timestamp": "01:00:59", "text": "卯年ですよね？そして私は"}]
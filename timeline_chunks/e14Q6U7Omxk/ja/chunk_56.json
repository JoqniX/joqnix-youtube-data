[{"type": "subtitle", "time": 3363.67, "timestamp": "00:56:03", "text": "何？ちょっと待って。これを忘れてた。"}, {"type": "subtitle", "time": 3365.349, "timestamp": "00:56:05", "text": "うん。あ、待って、待って、待って。なぜ私は"}, {"type": "subtitle", "time": 3367.67, "timestamp": "00:56:07", "text": "まだこの症状が続いてるの？ああ、"}, {"type": "subtitle", "time": 3371.99, "timestamp": "00:56:11", "text": "神。削除するのを忘れていました"}, {"type": "subtitle", "time": 3375.19, "timestamp": "00:56:15", "text": "これ。私のミスです。私のミスです。私のミスです。髭を剃る。おお、"}, {"type": "subtitle", "time": 3377.109, "timestamp": "00:56:17", "text": "待って。待って、待って、待って、待って。どうすればいいですか"}, {"type": "subtitle", "time": 3379.7, "timestamp": "00:56:19", "text": "これをもう一度削除しますか？"}, {"type": "subtitle", "time": 3382.39, "timestamp": "00:56:22", "text": "[音楽]"}, {"type": "subtitle", "time": 3384.45, "timestamp": "00:56:24", "text": "えっと、待って。どうすればいいですか"}, {"type": "subtitle", "time": 3385.99, "timestamp": "00:56:25", "text": "[音楽]"}, {"type": "subtitle", "time": 3396.47, "timestamp": "00:56:36", "text": "えっと、これをどうやって削除すればいいですか？何てことだ。"}, {"type": "subtitle", "time": 3399.43, "timestamp": "00:56:39", "text": "えっと、荷降ろし。はい、どうぞ。うん。"}, {"type": "subtitle", "time": 3401.99, "timestamp": "00:56:41", "text": "こんにちは。"}, {"type": "subtitle", "time": 3404.71, "timestamp": "00:56:44", "text": "うん。こんにちは、みんな。みなさん、お元気ですか？"}, {"type": "subtitle", "time": 3408.15, "timestamp": "00:56:48", "text": "今日は何をしますか？あなたに会いたかった。それは"}, {"type": "subtitle", "time": 3411.03, "timestamp": "00:56:51", "text": "そうですよね？あまり活動的ではなかった"}, {"type": "subtitle", "time": 3414.87, "timestamp": "00:56:54", "text": "今週か先週。うん。そしてまた"}, {"type": "subtitle", "time": 3418.23, "timestamp": "00:56:58", "text": "えーとミンギア、こんにちは、ようこそ、ようこそ。"}]
[{"type": "subtitle", "time": 8042.709, "timestamp": "02:14:02", "text": "待って。男は外にいる彼を見た"}, {"type": "subtitle", "time": 8045.27, "timestamp": "02:14:05", "text": "家の外にある窓。いや、いや、いや、"}, {"type": "subtitle", "time": 8048.229, "timestamp": "02:14:08", "text": "いや、いや。ちょっと色々混ぜちゃったね。彼"}, {"type": "subtitle", "time": 8050.39, "timestamp": "02:14:10", "text": "彼はキッチンに行こうとしていたんですよね？"}, {"type": "subtitle", "time": 8052.31, "timestamp": "02:14:12", "text": "彼は水が欲しかった。まるで夜遅い時間のように"}, {"type": "subtitle", "time": 8054.31, "timestamp": "02:14:14", "text": "夜中の2時か3時頃。それで彼は"}, {"type": "subtitle", "time": 8056.229, "timestamp": "02:14:16", "text": "水が少し。彼は台所へ行った。彼"}, {"type": "subtitle", "time": 8059.189, "timestamp": "02:14:19", "text": "水を飲んでいると、"}, {"type": "subtitle", "time": 8061.27, "timestamp": "02:14:21", "text": "廊下の内側で彼の右隣にいる男性"}, {"type": "subtitle", "time": 8065.27, "timestamp": "02:14:25", "text": "彼のアパート。右。そして、そして"}, {"type": "subtitle", "time": 8068.069, "timestamp": "02:14:28", "text": "強盗は男が隠れているのも見た。"}, {"type": "subtitle", "time": 8070.229, "timestamp": "02:14:30", "text": "クローゼット。そして、もしあなたが強盗なら、"}, {"type": "subtitle", "time": 8077.589, "timestamp": "02:14:37", "text": "何か答えはありますか？"}, {"type": "subtitle", "time": 8079.27, "timestamp": "02:14:39", "text": "H"}, {"type": "subtitle", "time": 8083.43, "timestamp": "02:14:43", "text": "つまり、もし強盗が心優しい人なら、"}, {"type": "subtitle", "time": 8086.31, "timestamp": "02:14:46", "text": "彼はこう言うだろう。「あの、ちょっと飲んでもいいですか？」"}, {"type": "subtitle", "time": 8089.35, "timestamp": "02:14:49", "text": "水とか何か？それとも、えっと、"}, {"type": "subtitle", "time": 8091.83, "timestamp": "02:14:51", "text": "男を人質に取って"}, {"type": "subtitle", "time": 8095.35, "timestamp": "02:14:55", "text": "何か。もし私が、もし私が、もしその男が"}, {"type": "subtitle", "time": 8097.75, "timestamp": "02:14:57", "text": "命を奪うことを気にしない彼はこう言うだろう"}]
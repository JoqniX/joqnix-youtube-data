[{"type": "subtitle", "time": 8100.069, "timestamp": "02:15:00", "text": "隠れ家に入る、その場所"}, {"type": "subtitle", "time": 8101.99, "timestamp": "02:15:01", "text": "男が隠れていた場所と殺す"}, {"type": "subtitle", "time": 8104.069, "timestamp": "02:15:04", "text": "その場で彼を呼び出した。"}, {"type": "subtitle", "time": 8106.709, "timestamp": "02:15:06", "text": "うん。これら３つの答えはすべて"}, {"type": "subtitle", "time": 8108.55, "timestamp": "02:15:08", "text": "実際に私と一緒に書いたもので、それらは"}, {"type": "subtitle", "time": 8111.03, "timestamp": "02:15:11", "text": "通常の回答。何？実際に"}, {"type": "subtitle", "time": 8113.35, "timestamp": "02:15:13", "text": "それらは書かれた。うん。サイコパス"}, {"type": "subtitle", "time": 8116.87, "timestamp": "02:15:16", "text": "答えは、強盗は"}, {"type": "subtitle", "time": 8119.75, "timestamp": "02:15:19", "text": "ドア、ドアを開ける、ドアを閉める"}, {"type": "subtitle", "time": 8122.55, "timestamp": "02:15:22", "text": "正面玄関のように、それから静かに"}, {"type": "subtitle", "time": 8124.79, "timestamp": "02:15:24", "text": "クローゼットの近くで男が来るのを待つ"}, {"type": "subtitle", "time": 8134.31, "timestamp": "02:15:34", "text": "ああ、それは賢い動きですね"}, {"type": "subtitle", "time": 8136.709, "timestamp": "02:15:36", "text": "男は「ああ、強盗は去ったが、"}, {"type": "subtitle", "time": 8139.589, "timestamp": "02:15:39", "text": "彼は出てきて捕まるだろう。"}, {"type": "subtitle", "time": 8141.35, "timestamp": "02:15:41", "text": "ああ、あのめちゃくちゃなやつ。私はこれを手に入れた"}, {"type": "subtitle", "time": 8146.069, "timestamp": "02:15:46", "text": "要点を突いた話。うん。うん。その"}, {"type": "subtitle", "time": 8148.229, "timestamp": "02:15:48", "text": "奇妙な。うん。さあ、どうだろうね。私は"}, {"type": "subtitle", "time": 8149.99, "timestamp": "02:15:49", "text": "すごく興奮して、それで始めた"}, {"type": "subtitle", "time": 8151.669, "timestamp": "02:15:51", "text": "いろいろ見て、クイズもいくつか受けた"}, {"type": "subtitle", "time": 8153.75, "timestamp": "02:15:53", "text": "まあ、そういうことだよ。どちらかといえば、"}, {"type": "subtitle", "time": 8155.589, "timestamp": "02:15:55", "text": "そこからいくつかクリップを撮れるよ。"}]
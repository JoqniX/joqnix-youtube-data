[{"type": "subtitle", "time": 8220.95, "timestamp": "02:17:00", "text": "逃げ出した。なぜ彼は"}, {"type": "subtitle", "time": 8223.509, "timestamp": "02:17:03", "text": "そうするときに、あなたを指差しているのですか？ 1つ"}, {"type": "subtitle", "time": 8225.99, "timestamp": "02:17:05", "text": "窓を閉めて口を閉じて"}, {"type": "subtitle", "time": 8230.15, "timestamp": "02:17:10", "text": "そして、自分の荷物は自分で持ち込んでください。二"}, {"type": "subtitle", "time": 8233.19, "timestamp": "02:17:13", "text": "はい、ありがとうございます。それで彼は検査していたのです。"}, {"type": "subtitle", "time": 8236.309, "timestamp": "02:17:16", "text": "あなたは安全ではないということを"}, {"type": "subtitle", "time": 8238.15, "timestamp": "02:17:18", "text": "君の全身は僕のものになるような感じ"}, {"type": "subtitle", "time": 8241.91, "timestamp": "02:17:21", "text": "頭からつま先まで何か。私は殺す"}, {"type": "subtitle", "time": 8244.309, "timestamp": "02:17:24", "text": "次回のお楽しみとか、何か。警告です。"}, {"type": "subtitle", "time": 8248.87, "timestamp": "02:17:28", "text": "うん。うん。うん。問題は、彼は"}, {"type": "subtitle", "time": 8250.79, "timestamp": "02:17:30", "text": "ええと、通常の答えは正解です。あなたは"}, {"type": "subtitle", "time": 8253.11, "timestamp": "02:17:33", "text": "右。通常の答えは脅迫的である"}, {"type": "subtitle", "time": 8257.99, "timestamp": "02:17:37", "text": "あなた。しかし、サイコパスの答えは、ええと、彼"}, {"type": "subtitle", "time": 8261.589, "timestamp": "02:17:41", "text": "階数を数えていた。"}, {"type": "subtitle", "time": 8263.19, "timestamp": "02:17:43", "text": "おお"}, {"type": "subtitle", "time": 8265.429, "timestamp": "02:17:45", "text": "うん。彼はどれくらい上まで数えていた"}, {"type": "subtitle", "time": 8268.79, "timestamp": "02:17:48", "text": "あなたは基地出身ですね。ああ、そう思ったよ"}, {"type": "subtitle", "time": 8271.429, "timestamp": "02:17:51", "text": "隣に住んでいた。隣の部屋。いや、いや、いや、"}, {"type": "subtitle", "time": 8273.75, "timestamp": "02:17:53", "text": "いいえ。君は出て行け。それは別の建物だった。彼"}, {"type": "subtitle", "time": 8275.27, "timestamp": "02:17:55", "text": "まるで写真を見せてくれるような感じで、"}, {"type": "subtitle", "time": 8277.03, "timestamp": "02:17:57", "text": "別の建物。ええと、だから私は"}, {"type": "subtitle", "time": 8279.75, "timestamp": "02:17:59", "text": "私はあまり話が上手ではないのかもしれません。おお、"}]
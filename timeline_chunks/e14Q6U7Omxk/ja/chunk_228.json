[{"type": "subtitle", "time": 13681.03, "timestamp": "03:48:01", "text": "環境。まあ、そうですね。そしてもうひとつ"}, {"type": "subtitle", "time": 13684.63, "timestamp": "03:48:04", "text": "このことの良いところは通常、"}, {"type": "subtitle", "time": 13687.51, "timestamp": "03:48:07", "text": "私が行った調査では、"}, {"type": "subtitle", "time": 13690.79, "timestamp": "03:48:10", "text": "日本人はそうではない、彼らは望んでいない"}, {"type": "subtitle", "time": 13693.67, "timestamp": "03:48:13", "text": "外国人がそこにいるのは普通のことだ"}, {"type": "subtitle", "time": 13697.03, "timestamp": "03:48:17", "text": "あなたが知っている人たちだから本当に必要なのは"}, {"type": "subtitle", "time": 13699.75, "timestamp": "03:48:19", "text": "好きな場所を見つけてください"}, {"type": "subtitle", "time": 13702.389, "timestamp": "03:48:22", "text": "大学に入学する場合、寮に入ると"}, {"type": "subtitle", "time": 13704.469, "timestamp": "03:48:24", "text": "大学ではそれは問題ではない"}, {"type": "subtitle", "time": 13706.63, "timestamp": "03:48:26", "text": "でも、もしそこに住みたいなら"}, {"type": "subtitle", "time": 13709.03, "timestamp": "03:48:29", "text": "本当に見つける必要がある人によって"}, {"type": "subtitle", "time": 13710.79, "timestamp": "03:48:30", "text": "他のインド人がいる場所"}, {"type": "subtitle", "time": 13715.67, "timestamp": "03:48:35", "text": "人々。ああ、そうだね。うん。"}, {"type": "subtitle", "time": 13717.91, "timestamp": "03:48:37", "text": "外国人嫌いの人もいるし、"}, {"type": "subtitle", "time": 13721.51, "timestamp": "03:48:41", "text": "彼らは人種差別主義者や外国人嫌いになるかもしれないし、"}, {"type": "subtitle", "time": 13723.83, "timestamp": "03:48:43", "text": "それら。私はそう思っていなかった"}, {"type": "subtitle", "time": 13726.469, "timestamp": "03:48:46", "text": "わあ、日本はとても良い、日本は素晴らしい"}, {"type": "subtitle", "time": 13728.63, "timestamp": "03:48:48", "text": "アニメとかで知ってるよ。でも私が"}, {"type": "subtitle", "time": 13730.71, "timestamp": "03:48:50", "text": "ライブストリームのようなものを開き始めました。"}, {"type": "subtitle", "time": 13733.99, "timestamp": "03:48:53", "text": "ほら、あのIRLストリーム、"}, {"type": "subtitle", "time": 13736.87, "timestamp": "03:48:56", "text": "そういう人たちが言うことだよ、なあ、俺は"}, {"type": "subtitle", "time": 13739.03, "timestamp": "03:48:59", "text": "人種差別主義者が"}]
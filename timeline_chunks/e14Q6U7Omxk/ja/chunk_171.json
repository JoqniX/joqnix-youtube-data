[{"type": "subtitle", "time": 10261.59, "timestamp": "02:51:01", "text": "私が知ったのは"}, {"type": "subtitle", "time": 10264.07, "timestamp": "02:51:04", "text": "どうやら彼は会社を立ち上げたらしい"}, {"type": "subtitle", "time": 10267.83, "timestamp": "02:51:07", "text": "BTuberという会社か何か。彼は与えた"}, {"type": "subtitle", "time": 10271.59, "timestamp": "02:51:11", "text": "2人のキャラクターと2人の人物のように"}, {"type": "subtitle", "time": 10273.91, "timestamp": "02:51:13", "text": "両者とも失敗した。その時だと思う"}, {"type": "subtitle", "time": 10277.91, "timestamp": "02:51:17", "text": "彼は鏡を見なければならなかった、"}, {"type": "subtitle", "time": 10281.51, "timestamp": "02:51:21", "text": "知る。なるほど。うん。うん。それは"}, {"type": "subtitle", "time": 10287.91, "timestamp": "02:51:27", "text": "それは良い賭けだ。それは、それは"}, {"type": "subtitle", "time": 10291.269, "timestamp": "02:51:31", "text": "良い。私は思う"}, {"type": "subtitle", "time": 10293.83, "timestamp": "02:51:33", "text": "そういうこともある。みんな"}, {"type": "subtitle", "time": 10296.71, "timestamp": "02:51:36", "text": "今は彼ら独自の活動がある。人々は前に進む"}, {"type": "subtitle", "time": 10299.67, "timestamp": "02:51:39", "text": "そして彼らは変わる。彼らは理解している"}, {"type": "subtitle", "time": 10306.63, "timestamp": "02:51:46", "text": "ええ、そうですね。"}, {"type": "subtitle", "time": 10309.91, "timestamp": "02:51:49", "text": "うん。たくさんのこと。"}, {"type": "subtitle", "time": 10312.07, "timestamp": "02:51:52", "text": "うん。例えば、あの"}, {"type": "subtitle", "time": 10314.87, "timestamp": "02:51:54", "text": "あなたが野心家に言ったこと、"}, {"type": "subtitle", "time": 10316.389, "timestamp": "02:51:56", "text": "あなたがとても野心的で"}]
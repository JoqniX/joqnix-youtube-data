[{"type": "subtitle", "time": 5349.189, "timestamp": "01:29:09", "text": "ああ、このイベントのスキンを見たよ。"}, {"type": "subtitle", "time": 5352.95, "timestamp": "01:29:12", "text": "さて、これは新年の天体イベントです。"}, {"type": "subtitle", "time": 5355.94, "timestamp": "01:29:15", "text": "とても良かったので、欲しくなりました。"}, {"type": "subtitle", "time": 5359.91, "timestamp": "01:29:19", "text": "[音楽]"}, {"type": "subtitle", "time": 5362.149, "timestamp": "01:29:22", "text": "とても美味しいです。"}, {"type": "subtitle", "time": 5365.43, "timestamp": "01:29:25", "text": "でも、これはいいな。"}, {"type": "subtitle", "time": 5367.99, "timestamp": "01:29:27", "text": "私はこの相棒が欲しい。とてもピンクで"}, {"type": "subtitle", "time": 5370.629, "timestamp": "01:29:30", "text": "それはヘビです。 D. 待って、見えないよ"}, {"type": "subtitle", "time": 5373.43, "timestamp": "01:29:33", "text": "正しくは、それは「待って」みたいなものです。私はすべきでしょうか"}, {"type": "subtitle", "time": 5375.51, "timestamp": "01:29:35", "text": "おそらく"}, {"type": "subtitle", "time": 5384.709, "timestamp": "01:29:44", "text": "うん。見てごらん。とてもかわいい。欲しい"}, {"type": "subtitle", "time": 5387.83, "timestamp": "01:29:47", "text": "これ。でも、"}, {"type": "subtitle", "time": 5389.75, "timestamp": "01:29:49", "text": "お金を使いたくない。いいえ。いいえ。私は"}, {"type": "subtitle", "time": 5393.43, "timestamp": "01:29:53", "text": "貯金する。そう、騎手だよ。あなたはすべきではない"}, {"type": "subtitle", "time": 5399.35, "timestamp": "01:29:59", "text": "はい。確かに可愛いですね。"}]
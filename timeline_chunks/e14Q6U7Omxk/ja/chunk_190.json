[{"type": "subtitle", "time": 11401.19, "timestamp": "03:10:01", "text": "でも最初のやり取りはどんな感じだった？"}, {"type": "subtitle", "time": 11404.79, "timestamp": "03:10:04", "text": "あなたはこれの何がそんなに興味深いと思ったのですか？"}, {"type": "subtitle", "time": 11409.429, "timestamp": "03:10:09", "text": "ああ、最初は興味深いと思った"}, {"type": "subtitle", "time": 11411.91, "timestamp": "03:10:11", "text": "私はYouTubeを発見しました"}, {"type": "subtitle", "time": 11414.469, "timestamp": "03:10:14", "text": "ボーカルロイドにハマるような感じ"}, {"type": "subtitle", "time": 11417.91, "timestamp": "03:10:17", "text": "などなど。それから、私がもっと深く掘り下げていくにつれて"}, {"type": "subtitle", "time": 11420.15, "timestamp": "03:10:20", "text": "それを見て、YouTuberがいることに気付きました。"}, {"type": "subtitle", "time": 11422.15, "timestamp": "03:10:22", "text": "予想していなかった、自分が"}, {"type": "subtitle", "time": 11424.63, "timestamp": "03:10:24", "text": "Hol LifeのYouTuberを見ながら"}, {"type": "subtitle", "time": 11427.83, "timestamp": "03:10:27", "text": "カジナなどを見ていた"}, {"type": "subtitle", "time": 11431.11, "timestamp": "03:10:31", "text": "日。でも、私の経歴が始まってから"}, {"type": "subtitle", "time": 11434.15, "timestamp": "03:10:34", "text": "音楽関係の仕事、DJをやりたいという気持ちから"}, {"type": "subtitle", "time": 11437.11, "timestamp": "03:10:37", "text": "音楽家であることや、"}, {"type": "subtitle", "time": 11439.51, "timestamp": "03:10:39", "text": "DJやプロデューサーみたいな感じでもある"}, {"type": "subtitle", "time": 11444.07, "timestamp": "03:10:44", "text": "音楽作曲家タイプ。えっと、そして私は"}, {"type": "subtitle", "time": 11447.67, "timestamp": "03:10:47", "text": "いつも、ああ、ジョーという名前は私が作ったと思って"}, {"type": "subtitle", "time": 11449.83, "timestamp": "03:10:49", "text": "すべてですが、主なことは"}, {"type": "subtitle", "time": 11452.87, "timestamp": "03:10:52", "text": "音楽、そして私だけができること"}, {"type": "subtitle", "time": 11455.349, "timestamp": "03:10:55", "text": "それを楽曲の配信と呼ぶのですか？"}, {"type": "subtitle", "time": 11457.51, "timestamp": "03:10:57", "text": "あらゆる商品を販売しています。では、順番に"}, {"type": "subtitle", "time": 11459.75, "timestamp": "03:10:59", "text": "それら全てを行うために、私は学び始めました"}]
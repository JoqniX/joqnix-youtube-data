[{"type": "subtitle", "time": 13621.03, "timestamp": "03:47:01", "text": "全てを支払う。彼らがしなければならなかったことは"}, {"type": "subtitle", "time": 13623.99, "timestamp": "03:47:03", "text": "学費を払うと"}, {"type": "subtitle", "time": 13627.67, "timestamp": "03:47:07", "text": "寮費。 COEが来た後"}, {"type": "subtitle", "time": 13631.51, "timestamp": "03:47:11", "text": "インドだが、司令官はここには来なかった"}, {"type": "subtitle", "time": 13634.55, "timestamp": "03:47:14", "text": "そして結局誰も"}, {"type": "subtitle", "time": 13636.309, "timestamp": "03:47:16", "text": "お金を返金するための取引"}, {"type": "subtitle", "time": 13639.429, "timestamp": "03:47:19", "text": "日本の学校、そしてそのため"}, {"type": "subtitle", "time": 13641.83, "timestamp": "03:47:21", "text": "政治的なこととか、その他いろいろ"}, {"type": "subtitle", "time": 13645.429, "timestamp": "03:47:25", "text": "移民局の人たちは"}, {"type": "subtitle", "time": 13649.59, "timestamp": "03:47:29", "text": "COEをここに送らないで、"}, {"type": "subtitle", "time": 13650.79, "timestamp": "03:47:30", "text": "何が起こったのか全くわからない"}, {"type": "subtitle", "time": 13652.63, "timestamp": "03:47:32", "text": "でも、そういうことが起こったんです"}, {"type": "subtitle", "time": 13656.07, "timestamp": "03:47:36", "text": "最悪だね"}, {"type": "subtitle", "time": 13659.349, "timestamp": "03:47:39", "text": "ええ、痛かったですよ。しかし実際は"}, {"type": "subtitle", "time": 13662.309, "timestamp": "03:47:42", "text": "正直言ってかなり最悪だ"}, {"type": "subtitle", "time": 13664.389, "timestamp": "03:47:44", "text": "あなたと。でも、あなたにはメリットがあった。あなたは"}, {"type": "subtitle", "time": 13666.79, "timestamp": "03:47:46", "text": "無料講座。それは良いことだ。それは"}, {"type": "subtitle", "time": 13668.229, "timestamp": "03:47:48", "text": "良いことだ。あなたにも時間があります"}, {"type": "subtitle", "time": 13670.389, "timestamp": "03:47:50", "text": "新しい人たちと。それはまた良いことだ"}, {"type": "subtitle", "time": 13672.63, "timestamp": "03:47:52", "text": "もの。うん。さらに時間も増えました"}, {"type": "subtitle", "time": 13674.63, "timestamp": "03:47:54", "text": "あなたの家族。それもまた良いことだ"}, {"type": "subtitle", "time": 13676.95, "timestamp": "03:47:56", "text": "超アクティブな仕事に取りかかる前に"}]
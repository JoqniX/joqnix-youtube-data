[{"type": "subtitle", "time": 5941.75, "timestamp": "01:39:01", "text": "私は配信中にうまく話せないんです。私は"}, {"type": "subtitle", "time": 5944.95, "timestamp": "01:39:04", "text": "沈黙することのように。それはまずい。"}, {"type": "subtitle", "time": 5947.669, "timestamp": "01:39:07", "text": "考え出さなきゃ。あ、待って。それ"}, {"type": "subtitle", "time": 5957.99, "timestamp": "01:39:17", "text": "先ほども申し上げたように、私は上に上がらなければなりません。私"}, {"type": "subtitle", "time": 5961.669, "timestamp": "01:39:21", "text": "全力を尽くさなければならない。我慢する。はい、"}, {"type": "subtitle", "time": 5963.75, "timestamp": "01:39:23", "text": "ファンが回転している。よし、私は自分のことをしなければならない"}, {"type": "subtitle", "time": 5966.07, "timestamp": "01:39:26", "text": "会話のような内容に最適です。私は行きます"}, {"type": "subtitle", "time": 5968.79, "timestamp": "01:39:28", "text": "それは良くないですね。"}, {"type": "subtitle", "time": 5972.55, "timestamp": "01:39:32", "text": "もっと話す方法を見つけなければならない"}, {"type": "subtitle", "time": 5974.629, "timestamp": "01:39:34", "text": "何とかしてストリーミング配信する。"}, {"type": "subtitle", "time": 5979.189, "timestamp": "01:39:39", "text": "大丈夫ですか？そうそう。それは痛みだ"}, {"type": "subtitle", "time": 5981.669, "timestamp": "01:39:41", "text": "最近。私の集中力は散漫になっていた。"}, {"type": "subtitle", "time": 5984.629, "timestamp": "01:39:44", "text": "私はもう少し必要だと思う"}, {"type": "subtitle", "time": 5987.91, "timestamp": "01:39:47", "text": "ストリーム、もしくはもう少しフォーカスを当てるようなもの"}, {"type": "subtitle", "time": 5991.35, "timestamp": "01:39:51", "text": "ただいつもの自分に戻りたいだけ。それで"}, {"type": "subtitle", "time": 5994.709, "timestamp": "01:39:54", "text": "うん。だからこの騎手のことは気にしないで"}]
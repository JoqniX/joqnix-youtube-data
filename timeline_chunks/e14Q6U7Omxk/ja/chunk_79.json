[{"type": "subtitle", "time": 4745.27, "timestamp": "01:19:05", "text": "何がそんなに好きすぎるのか、いやいや、"}, {"type": "subtitle", "time": 4748.149, "timestamp": "01:19:08", "text": "利己的に人々に手を差し伸べる"}, {"type": "subtitle", "time": 4750.229, "timestamp": "01:19:10", "text": "助けを求め、助けを求め、助けを求め、助けを求めます"}, {"type": "subtitle", "time": 4754.79, "timestamp": "01:19:14", "text": "そして、それは、ああ、"}, {"type": "subtitle", "time": 4756.95, "timestamp": "01:19:16", "text": "私じゃない"}, {"type": "subtitle", "time": 4759.669, "timestamp": "01:19:19", "text": "それはまずい"}, {"type": "subtitle", "time": 4765.99, "timestamp": "01:19:25", "text": "ああ、私の扇風機が回らなくなってしまった。いいえ"}, {"type": "subtitle", "time": 4773.35, "timestamp": "01:19:33", "text": "痛み。私にはどんな感じなのかわからない"}, {"type": "subtitle", "time": 4781.51, "timestamp": "01:19:41", "text": "たくさんの物。"}, {"type": "subtitle", "time": 4784.149, "timestamp": "01:19:44", "text": "人々はどのように"}, {"type": "subtitle", "time": 4788.39, "timestamp": "01:19:48", "text": "人々はどうやって全てをやりくりしているのだろうか？"}, {"type": "subtitle", "time": 4791.11, "timestamp": "01:19:51", "text": "私はちょっと"}, {"type": "subtitle", "time": 4794.31, "timestamp": "01:19:54", "text": "正直に言うと、でも"}, {"type": "subtitle", "time": 4795.91, "timestamp": "01:19:55", "text": "終わり。私は悪いとは思わない。もちろん"}, {"type": "subtitle", "time": 4799.11, "timestamp": "01:19:59", "text": "気分が悪い。私がどれだけ"}]
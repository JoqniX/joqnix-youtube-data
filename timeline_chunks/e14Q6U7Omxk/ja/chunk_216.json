[{"type": "subtitle", "time": 12961.349, "timestamp": "03:36:01", "text": "ただ、そういうことなんです。うん。待って、"}, {"type": "subtitle", "time": 12963.269, "timestamp": "03:36:03", "text": "私が嫌いだけど、あなたが好きなものって何？"}, {"type": "subtitle", "time": 12966.95, "timestamp": "03:36:06", "text": "待って、いや、いや、いや。私は好きではありません"}, {"type": "subtitle", "time": 12968.71, "timestamp": "03:36:08", "text": "いくつかあるけど、それも好きじゃない"}, {"type": "subtitle", "time": 12971.429, "timestamp": "03:36:11", "text": "そういうもの、つまり、恥ずかしいもの、"}, {"type": "subtitle", "time": 12973.19, "timestamp": "03:36:13", "text": "こんにちは皆さん、ようこそ"}, {"type": "subtitle", "time": 12976.229, "timestamp": "03:36:16", "text": "動画関連のもの。いや、いや、いや。私は恥ずかしいのが嫌いです"}, {"type": "subtitle", "time": 12978.309, "timestamp": "03:36:18", "text": "それはすごく恥ずかしい。ちょうど手に入れた"}, {"type": "subtitle", "time": 12981.349, "timestamp": "03:36:21", "text": "背筋がゾクゾクした。"}, {"type": "subtitle", "time": 12985.59, "timestamp": "03:36:25", "text": "とにかく、うん、うん、それを見たし、"}, {"type": "subtitle", "time": 12987.11, "timestamp": "03:36:27", "text": "そうしたらすごく楽しそうだなと思った。"}, {"type": "subtitle", "time": 12990.389, "timestamp": "03:36:30", "text": "だから私は本当に本当に得意だった"}, {"type": "subtitle", "time": 12993.349, "timestamp": "03:36:33", "text": "私は本当に幸せでした"}, {"type": "subtitle", "time": 12994.87, "timestamp": "03:36:34", "text": "コラボがうまくいくのを待ってるよ、だって私は"}, {"type": "subtitle", "time": 12997.83, "timestamp": "03:36:37", "text": "楽しい時間を過ごせるだろうと分かっていた。"}, {"type": "subtitle", "time": 12999.51, "timestamp": "03:36:39", "text": "あなたがただ"}, {"type": "subtitle", "time": 13001.51, "timestamp": "03:36:41", "text": "偽っている。わからない。私には言えません"}, {"type": "subtitle", "time": 13011.19, "timestamp": "03:36:51", "text": "いいえ。わかった。では、わかりました。それが"}, {"type": "subtitle", "time": 13012.79, "timestamp": "03:36:52", "text": "する。よし。私はどもってしまった。だから何？全て"}, {"type": "subtitle", "time": 13014.95, "timestamp": "03:36:54", "text": "右。誰もが同時にそれが起こる"}, {"type": "subtitle", "time": 13018.15, "timestamp": "03:36:58", "text": "その間。うん。私は彼女をよく黙らせない。"}]
[{"type": "subtitle", "time": 8523.27, "timestamp": "02:22:03", "text": "えーと、わからないけど、たぶん何かの存在が"}, {"type": "subtitle", "time": 8526.87, "timestamp": "02:22:06", "text": "えっと、これがあなたの後ろに来たのを見せました"}, {"type": "subtitle", "time": 8528.87, "timestamp": "02:22:08", "text": "そして、瞬時に消え去った。だからそれは"}, {"type": "subtitle", "time": 8533.11, "timestamp": "02:22:13", "text": "幽霊であるはずがない。幽霊かもしれない。"}, {"type": "subtitle", "time": 8534.79, "timestamp": "02:22:14", "text": "はぁ？わかった。あなたの最終的な答えは何ですか？全て"}, {"type": "subtitle", "time": 8537.11, "timestamp": "02:22:17", "text": "右。ああ、私は選ばなければならない、私はあなたに"}, {"type": "subtitle", "time": 8539.59, "timestamp": "02:22:19", "text": "1つ。自分で選択しなければなりません。"}, {"type": "subtitle", "time": 8540.63, "timestamp": "02:22:20", "text": "よし。あなたは選択しなければなりません"}, {"type": "subtitle", "time": 8542.23, "timestamp": "02:22:22", "text": "脈。あなたはそこにいる。よし。私は違います"}, {"type": "subtitle", "time": 8544.55, "timestamp": "02:22:24", "text": "そこには。わかった。私はただ探しているだけです"}, {"type": "subtitle", "time": 8550.87, "timestamp": "02:22:30", "text": "空から。その時、"}, {"type": "subtitle", "time": 8552.63, "timestamp": "02:22:32", "text": "えーと"}, {"type": "subtitle", "time": 8557.11, "timestamp": "02:22:37", "text": "私は「行く」を選びます。いいえ、幽霊は"}, {"type": "subtitle", "time": 8559.75, "timestamp": "02:22:39", "text": "現実ではない。待って、これはファンタジーか何か"}, {"type": "subtitle", "time": 8562.71, "timestamp": "02:22:42", "text": "現実の生活？わかった。わかった。私はI’llを選びます"}, {"type": "subtitle", "time": 8565.19, "timestamp": "02:22:45", "text": "幽霊と一緒に行こう。大丈夫。"}, {"type": "subtitle", "time": 8568.07, "timestamp": "02:22:48", "text": "うん。これらは一般的な回答です。全て"}, {"type": "subtitle", "time": 8570.71, "timestamp": "02:22:50", "text": "右。全ての回答は正常です。の"}, {"type": "subtitle", "time": 8573.19, "timestamp": "02:22:53", "text": "異性については普通だった。何もなかった"}, {"type": "subtitle", "time": 8575.349, "timestamp": "02:22:55", "text": "普通。ゴーストは普通だった。野生動物"}, {"type": "subtitle", "time": 8579.11, "timestamp": "02:22:59", "text": "正常だった。ああ、それはただの"}]
[{"type": "subtitle", "time": 10440.79, "timestamp": "02:54:00", "text": "おお。私は、他の人が"}, {"type": "subtitle", "time": 10443.67, "timestamp": "02:54:03", "text": "ストリーミングユーチューバーやみんな"}, {"type": "subtitle", "time": 10445.91, "timestamp": "02:54:05", "text": "一部の人はこれを持っています。えっと、あなたは"}, {"type": "subtitle", "time": 10447.83, "timestamp": "02:54:07", "text": "それって何？それぞれ異なる性格"}, {"type": "subtitle", "time": 10449.91, "timestamp": "02:54:09", "text": "友達と話すとか、"}, {"type": "subtitle", "time": 10451.51, "timestamp": "02:54:11", "text": "家族には、"}, {"type": "subtitle", "time": 10454.79, "timestamp": "02:54:14", "text": "配信で話している彼らは、とても親切に話していますが"}, {"type": "subtitle", "time": 10457.11, "timestamp": "02:54:17", "text": "現実世界では彼らは皆違う話し方をする"}, {"type": "subtitle", "time": 10459.91, "timestamp": "02:54:19", "text": "理解できなかったことすべて"}, {"type": "subtitle", "time": 10463.19, "timestamp": "02:54:23", "text": "実際、私はそれを持っているかと思う"}, {"type": "subtitle", "time": 10466.63, "timestamp": "02:54:26", "text": "知らないけど、私はこういう人間だ"}, {"type": "subtitle", "time": 10470.07, "timestamp": "02:54:30", "text": "家族と一緒にいるときは、"}, {"type": "subtitle", "time": 10474.07, "timestamp": "02:54:34", "text": "私の母国語で話すと、"}, {"type": "subtitle", "time": 10477.67, "timestamp": "02:54:37", "text": "少しずれている、あるいは棘のようなもの"}, {"type": "subtitle", "time": 10479.429, "timestamp": "02:54:39", "text": "スピーチか何かですが、"}, {"type": "subtitle", "time": 10482.63, "timestamp": "02:54:42", "text": "英語とかそういうの、私は同じことを言う"}, {"type": "subtitle", "time": 10485.59, "timestamp": "02:54:45", "text": "どこでも言ってるよ、うん、何、何"}, {"type": "subtitle", "time": 10487.59, "timestamp": "02:54:47", "text": "私はあなたの母語を知る機会がなかった"}, {"type": "subtitle", "time": 10492.389, "timestamp": "02:54:52", "text": "その母語は、"}]
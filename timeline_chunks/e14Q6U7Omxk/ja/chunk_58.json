[{"type": "subtitle", "time": 3480.71, "timestamp": "00:58:00", "text": "良い。良い。良い。良い。"}, {"type": "subtitle", "time": 3483.03, "timestamp": "00:58:03", "text": "私は最善を尽くします。はい。はい。やってください"}, {"type": "subtitle", "time": 3485.55, "timestamp": "00:58:05", "text": "最高。えっと、あなたは"}, {"type": "subtitle", "time": 3489.99, "timestamp": "00:58:09", "text": "[音楽]"}, {"type": "subtitle", "time": 3493.349, "timestamp": "00:58:13", "text": "ええと、久しぶりですね。"}, {"type": "subtitle", "time": 3496.47, "timestamp": "00:58:16", "text": "実はかなり久しぶりですね。"}, {"type": "subtitle", "time": 3499.75, "timestamp": "00:58:19", "text": "えっと、何と言ったらいいのか分かりません。なぜなら"}, {"type": "subtitle", "time": 3503.27, "timestamp": "00:58:23", "text": "ストリーミング配信したいと思っていた"}, {"type": "subtitle", "time": 3505.75, "timestamp": "00:58:25", "text": "最近は"}, {"type": "subtitle", "time": 3508.95, "timestamp": "00:58:28", "text": "えっと、正直に言うと、私は棚の中にいました"}, {"type": "subtitle", "time": 3511.75, "timestamp": "00:58:31", "text": "推測するが、私の心は別のところにあった"}, {"type": "subtitle", "time": 3513.829, "timestamp": "00:58:33", "text": "他にもやらなければならないことがあったので"}, {"type": "subtitle", "time": 3517.91, "timestamp": "00:58:37", "text": "それで、えっと、通り抜けていくので、私はああ"}, {"type": "subtitle", "time": 3520.069, "timestamp": "00:58:40", "text": "男の子"}, {"type": "subtitle", "time": 3522.63, "timestamp": "00:58:42", "text": "それは痛みを伴う"}, {"type": "subtitle", "time": 3534.87, "timestamp": "00:58:54", "text": "話すべきかどうかわからない"}, {"type": "subtitle", "time": 3537.67, "timestamp": "00:58:57", "text": "あるいは、それについて話すべきではないのかもしれない。私"}]
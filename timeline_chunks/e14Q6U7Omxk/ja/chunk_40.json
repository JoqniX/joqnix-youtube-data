[{"type": "subtitle", "time": 2401.91, "timestamp": "00:40:01", "text": "何について話していたのか、彼らは何と言ったのか"}, {"type": "subtitle", "time": 2404.15, "timestamp": "00:40:04", "text": "彼らはこのループの中にいるでしょう"}, {"type": "subtitle", "time": 2406.63, "timestamp": "00:40:06", "text": "好奇心"}, {"type": "subtitle", "time": 2409.109, "timestamp": "00:40:09", "text": "Googleにアクセスしない限り"}, {"type": "subtitle", "time": 2412.23, "timestamp": "00:40:12", "text": "翻訳して自分で翻訳する"}, {"type": "subtitle", "time": 2414.87, "timestamp": "00:40:14", "text": "それ"}, {"type": "subtitle", "time": 2417.43, "timestamp": "00:40:17", "text": "そういうことなので、できるだけ英語で話すようにしてください。"}, {"type": "subtitle", "time": 2421.589, "timestamp": "00:40:21", "text": "わかった。そして最も重要な役割の一つは"}, {"type": "subtitle", "time": 2424.71, "timestamp": "00:40:24", "text": "前回に残しておいた"}, {"type": "subtitle", "time": 2428.37, "timestamp": "00:40:28", "text": "可愛さを忘れずに、自分らしくいてください。"}, {"type": "subtitle", "time": 2430.069, "timestamp": "00:40:30", "text": "[音楽]"}, {"type": "subtitle", "time": 2435.27, "timestamp": "00:40:35", "text": "はい。自分らしく、そして可愛く。わかった。"}, {"type": "subtitle", "time": 2437.03, "timestamp": "00:40:37", "text": "うん。"}, {"type": "subtitle", "time": 2443.589, "timestamp": "00:40:43", "text": "そして、いつものように皆さんにはヘッドパッドがふさわしいです。"}, {"type": "subtitle", "time": 2446.79, "timestamp": "00:40:46", "text": "ああ、"}, {"type": "subtitle", "time": 2449.67, "timestamp": "00:40:49", "text": "右。これがルールの部分です。それで"}, {"type": "subtitle", "time": 2451.75, "timestamp": "00:40:51", "text": "うん、"}, {"type": "subtitle", "time": 2455.03, "timestamp": "00:40:55", "text": "あなたはかわいい。私は醜い。いや、いや、いや、いや、"}, {"type": "subtitle", "time": 2457.75, "timestamp": "00:40:57", "text": "いいえ。そういう仕組みではないんです。バカ"}, {"type": "subtitle", "time": 2459.99, "timestamp": "00:40:59", "text": "報告"}]
[{"type": "subtitle", "time": 13080.79, "timestamp": "03:38:00", "text": "ヒンディー語は普通で、私の声が聞こえるでしょう"}, {"type": "subtitle", "time": 13083.67, "timestamp": "03:38:03", "text": "時々ハナビ語で話したり、ごめんなさいと言ったりします"}, {"type": "subtitle", "time": 13086.07, "timestamp": "03:38:06", "text": "ヒマ、またはあなたは私が話しているのを聞くでしょう"}, {"type": "subtitle", "time": 13090.07, "timestamp": "03:38:10", "text": "パンジャブ語。あなたはいくつの言語を知っていますか？"}, {"type": "subtitle", "time": 13092.87, "timestamp": "03:38:12", "text": "何てことだ。おお。私は彼らを知りません。私"}, {"type": "subtitle", "time": 13095.349, "timestamp": "03:38:15", "text": "彼らのことを理解しているんだね。うん。その"}, {"type": "subtitle", "time": 13099.91, "timestamp": "03:38:19", "text": "えっと、それは、それは、それは、それは、"}, {"type": "subtitle", "time": 13102.79, "timestamp": "03:38:22", "text": "私には文化的なこだわりがあるんだけど、"}, {"type": "subtitle", "time": 13105.91, "timestamp": "03:38:25", "text": "家族の事情とかで。だから彼らの"}, {"type": "subtitle", "time": 13108.87, "timestamp": "03:38:28", "text": "背景と彼らの背景"}, {"type": "subtitle", "time": 13112.309, "timestamp": "03:38:32", "text": "背景。だから、それがそうなった"}, {"type": "subtitle", "time": 13115.67, "timestamp": "03:38:35", "text": "まるで狂気のマルチバースのような"}, {"type": "subtitle", "time": 13118.469, "timestamp": "03:38:38", "text": "私が話したこともないようなこと"}, {"type": "subtitle", "time": 13120.71, "timestamp": "03:38:40", "text": "ラジャスタンの物なら、私は"}, {"type": "subtitle", "time": 13122.79, "timestamp": "03:38:42", "text": "ラジャスタン語を理解する"}, {"type": "subtitle", "time": 13125.51, "timestamp": "03:38:45", "text": "そういうものがあったから簡単に"}, {"type": "subtitle", "time": 13127.99, "timestamp": "03:38:47", "text": "私の祖先にもいる。"}, {"type": "subtitle", "time": 13131.67, "timestamp": "03:38:51", "text": "ああ、そうだ、僕はラジュットだよ。"}, {"type": "subtitle", "time": 13135.91, "timestamp": "03:38:55", "text": "ラジュートは都市国家だと理解してください"}, {"type": "subtitle", "time": 13139.67, "timestamp": "03:38:59", "text": "いや、インドにあるよ。わかった、わかった、待って、いやいやいや"}]
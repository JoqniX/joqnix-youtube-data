[{"type": "subtitle", "time": 4382.229, "timestamp": "01:13:02", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 4393.189, "timestamp": "01:13:13", "text": "えっと"}, {"type": "subtitle", "time": 4395.43, "timestamp": "01:13:15", "text": "私がまだ考えているという事実"}, {"type": "subtitle", "time": 4411.43, "timestamp": "01:13:31", "text": "しかし、私たちは諦めずに挑戦し続けます。それは"}, {"type": "subtitle", "time": 4413.59, "timestamp": "01:13:33", "text": "私がお伝えできるのは以上です。私はそれでも"}, {"type": "subtitle", "time": 4421.75, "timestamp": "01:13:41", "text": "状況。ああ、私は窮地に立たされている"}, {"type": "subtitle", "time": 4425.189, "timestamp": "01:13:45", "text": "現在の状況。私が話していたのは"}, {"type": "subtitle", "time": 4427.99, "timestamp": "01:13:47", "text": "それより前に。"}, {"type": "subtitle", "time": 4431.35, "timestamp": "01:13:51", "text": "どちらかを削除する必要があります"}, {"type": "subtitle", "time": 4433.43, "timestamp": "01:13:53", "text": "アカウント。それは削除するようなものです"}]
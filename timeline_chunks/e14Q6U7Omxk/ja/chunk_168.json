[{"type": "subtitle", "time": 10080.07, "timestamp": "02:48:00", "text": "私はジャカタをやっています、それは私を助けてくれます"}, {"type": "subtitle", "time": 10082.87, "timestamp": "02:48:02", "text": "ストリームでやると、"}, {"type": "subtitle", "time": 10085.269, "timestamp": "02:48:05", "text": "今の私には何もできない。退屈なんだろうな。"}, {"type": "subtitle", "time": 10088.79, "timestamp": "02:48:08", "text": "わからない。えっと、勉強します"}, {"type": "subtitle", "time": 10091.19, "timestamp": "02:48:11", "text": "ストリーム。つまり、視覚的な証拠があるということですよね？"}, {"type": "subtitle", "time": 10096.95, "timestamp": "02:48:16", "text": "そして、私は以前はそれをやっていました。"}, {"type": "subtitle", "time": 10100.07, "timestamp": "02:48:20", "text": "えっと、授業が行われている間に何が起こっていたかというと"}, {"type": "subtitle", "time": 10102.469, "timestamp": "02:48:22", "text": "ヨアトンより前。以前はこの時間を過ごしていました"}, {"type": "subtitle", "time": 10105.67, "timestamp": "02:48:25", "text": "時間に合わせて。えっと、劇場も言ったんだけど"}, {"type": "subtitle", "time": 10107.99, "timestamp": "02:48:27", "text": "チューブのこととか全部彼に話して"}, {"type": "subtitle", "time": 10110.15, "timestamp": "02:48:30", "text": "彼はまた私を追いかけ、私を監視しています"}, {"type": "subtitle", "time": 10112.87, "timestamp": "02:48:32", "text": "トゥイッチ。だから彼は私が"}, {"type": "subtitle", "time": 10116.15, "timestamp": "02:48:36", "text": "ストリームで宿題をする時間"}, {"type": "subtitle", "time": 10118.309, "timestamp": "02:48:38", "text": "そういうことばかり。それは予算に計上されています。"}, {"type": "subtitle", "time": 10122.71, "timestamp": "02:48:42", "text": "うん。うん。それで、ええと、彼は今知ったんです。"}, {"type": "subtitle", "time": 10125.03, "timestamp": "02:48:45", "text": "うん。つまり、そういうことですか？"}, {"type": "subtitle", "time": 10127.269, "timestamp": "02:48:47", "text": "うん。うん。いいねをチェックするのを想像してみて"}, {"type": "subtitle", "time": 10129.349, "timestamp": "02:48:49", "text": "教師として生徒をチェックする"}, {"type": "subtitle", "time": 10131.269, "timestamp": "02:48:51", "text": "勉強と仕事を同時に行う"}, {"type": "subtitle", "time": 10133.83, "timestamp": "02:48:53", "text": "そんな時間は最高だ"}, {"type": "subtitle", "time": 10136.87, "timestamp": "02:48:56", "text": "あなたの生徒はそうします。いいえ。"}]
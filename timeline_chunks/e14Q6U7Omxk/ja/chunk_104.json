[{"type": "subtitle", "time": 6270.95, "timestamp": "01:44:30", "text": "GXを書き終えて戻ってきました。何てことだ。"}, {"type": "subtitle", "time": 6274.39, "timestamp": "01:44:34", "text": "すっかり忘れてた。そうだった"}, {"type": "subtitle", "time": 6288.07, "timestamp": "01:44:48", "text": "ああ、それはラグっていた。"}, {"type": "subtitle", "time": 6290.39, "timestamp": "01:44:50", "text": "このゲームではもう何もできない"}, {"type": "subtitle", "time": 6293.669, "timestamp": "01:44:53", "text": "私のGPUは何も処理できないから"}, {"type": "subtitle", "time": 6295.27, "timestamp": "01:44:55", "text": "もう。"}, {"type": "subtitle", "time": 6297.91, "timestamp": "01:44:57", "text": "そして私はこう思った。"}]
[{"type": "subtitle", "time": 4983.669, "timestamp": "01:23:03", "text": "そうそう。私はネオスピードを購入しました。えっと、"}, {"type": "subtitle", "time": 4987.669, "timestamp": "01:23:07", "text": "私が話していたゲーム、"}, {"type": "subtitle", "time": 4993.669, "timestamp": "01:23:13", "text": "ああ、動作が遅い。"}, {"type": "subtitle", "time": 4996.07, "timestamp": "01:23:16", "text": "ラグを感じない。"}, {"type": "subtitle", "time": 5007.99, "timestamp": "01:23:27", "text": "再起動しますか？"}, {"type": "subtitle", "time": 5010.55, "timestamp": "01:23:30", "text": "わからない。再起動。胎児。うん、"}, {"type": "subtitle", "time": 5013.91, "timestamp": "01:23:33", "text": "胎児。ええ、私はそれを買ったので"}, {"type": "subtitle", "time": 5016.31, "timestamp": "01:23:36", "text": "ストリーミング配信で視聴する。心配です。バカ"}, {"type": "subtitle", "time": 5019.75, "timestamp": "01:23:39", "text": "ジョッキー、なぜゲームを買ったのですか"}, {"type": "subtitle", "time": 5022.87, "timestamp": "01:23:42", "text": "GPUはこの状況にあるのですか？"}, {"type": "subtitle", "time": 5026.95, "timestamp": "01:23:46", "text": "そして私はこう言った、モー、"}, {"type": "subtitle", "time": 5029.27, "timestamp": "01:23:49", "text": "きっと大丈夫でしょう。願っています。"}, {"type": "subtitle", "time": 5032.07, "timestamp": "01:23:52", "text": "わからない。"}]
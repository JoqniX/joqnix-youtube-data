[{"type": "subtitle", "time": 5592.95, "timestamp": "01:33:12", "text": "私が到着したら何を買うつもりか"}, {"type": "subtitle", "time": 5595.59, "timestamp": "01:33:15", "text": "働く。何を買うつもりですか"}, {"type": "subtitle", "time": 5598.229, "timestamp": "01:33:18", "text": "仕事に取り掛かるのですか？"}, {"type": "subtitle", "time": 5602.55, "timestamp": "01:33:22", "text": "待って、この扇風機、回転が止まった。"}, {"type": "subtitle", "time": 5606.629, "timestamp": "01:33:26", "text": "今は以前より遅くなっています。え、何？"}, {"type": "subtitle", "time": 5608.55, "timestamp": "01:33:28", "text": "ゲームを再開した方がいいでしょうか？私はそう思う"}, {"type": "subtitle", "time": 5611.83, "timestamp": "01:33:31", "text": "ゲームを再起動してください。"}, {"type": "subtitle", "time": 5613.669, "timestamp": "01:33:33", "text": "ゲームでそんなに強く蹴られないで"}, {"type": "subtitle", "time": 5621.189, "timestamp": "01:33:41", "text": "でも、そうですね、"}, {"type": "subtitle", "time": 5627.669, "timestamp": "01:33:47", "text": "彼女は一体何を話していたんだっけ？ああ、"}, {"type": "subtitle", "time": 5629.35, "timestamp": "01:33:49", "text": "神。"}, {"type": "subtitle", "time": 5631.27, "timestamp": "01:33:51", "text": "お金の話。私は気をつけなければならない"}, {"type": "subtitle", "time": 5634.07, "timestamp": "01:33:54", "text": "それ。私はそれをこのように使うべきではない"}, {"type": "subtitle", "time": 5637.11, "timestamp": "01:33:57", "text": "それ？もちろん私はこれらをこれらのことに使っています"}, {"type": "subtitle", "time": 5639.35, "timestamp": "01:33:59", "text": "日。私は主に"}]
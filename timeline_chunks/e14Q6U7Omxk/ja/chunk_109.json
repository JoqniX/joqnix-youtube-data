[{"type": "subtitle", "time": 6542.149, "timestamp": "01:49:02", "text": "右？そう、ズチみたいなんだけど"}, {"type": "subtitle", "time": 6545.109, "timestamp": "01:49:05", "text": "ピンク。それはピンという音のようなものだ。だから彼女はこう思う"}, {"type": "subtitle", "time": 6547.99, "timestamp": "01:49:07", "text": "そんな感じですね。無料の肌。そこには"}, {"type": "subtitle", "time": 6561.43, "timestamp": "01:49:21", "text": "おお、ドラゴンだ。"}, {"type": "subtitle", "time": 6563.91, "timestamp": "01:49:23", "text": "うん。こんにちは、雨の息子よ。お元気ですか"}, {"type": "subtitle", "time": 6565.51, "timestamp": "01:49:25", "text": "今日？"}, {"type": "subtitle", "time": 6567.83, "timestamp": "01:49:27", "text": "お元気でお過ごしでしょうか。うん、わかるよ"}, {"type": "subtitle", "time": 6571.51, "timestamp": "01:49:31", "text": "ちなみに、このスキンです。まるで"}, {"type": "subtitle", "time": 6574.95, "timestamp": "01:49:34", "text": "ハイビスカスまたは花のサクロパル。"}, {"type": "subtitle", "time": 6583.109, "timestamp": "01:49:43", "text": "ああ、やっとみんなの姿が見えるようになった。"}, {"type": "subtitle", "time": 6586.629, "timestamp": "01:49:46", "text": "他の皆さんは？どういう意味ですか？"}, {"type": "subtitle", "time": 6588.55, "timestamp": "01:49:48", "text": "はぁ？"}, {"type": "subtitle", "time": 6590.709, "timestamp": "01:49:50", "text": "おお、"}, {"type": "subtitle", "time": 6594.47, "timestamp": "01:49:54", "text": "お元気でしたか？"}, {"type": "subtitle", "time": 6597.71, "timestamp": "01:49:57", "text": "お元気でお過ごしでしょうか。"}]
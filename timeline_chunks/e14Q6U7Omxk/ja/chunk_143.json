[{"type": "subtitle", "time": 8583.11, "timestamp": "02:23:03", "text": "サイコパス的な答えは犬だった。"}, {"type": "subtitle", "time": 8587.349, "timestamp": "02:23:07", "text": "犬。なぜ？うん。どうやら"}, {"type": "subtitle", "time": 8591.67, "timestamp": "02:23:11", "text": "サイコパスは恐怖を感じない。"}, {"type": "subtitle", "time": 8593.59, "timestamp": "02:23:13", "text": "H それらは同じではない"}, {"type": "subtitle", "time": 8596.71, "timestamp": "02:23:16", "text": "波長とかそういう類。よし。だから"}, {"type": "subtitle", "time": 8599.429, "timestamp": "02:23:19", "text": "えーっと、怖い時とか、"}, {"type": "subtitle", "time": 8601.349, "timestamp": "02:23:21", "text": "なぜここに犬がいると思うのですか？"}, {"type": "subtitle", "time": 8604.309, "timestamp": "02:23:24", "text": "私はそれに失敗した"}, {"type": "subtitle", "time": 8607.27, "timestamp": "02:23:27", "text": "ありがたいことに、どうやら全体的に"}, {"type": "subtitle", "time": 8609.83, "timestamp": "02:23:29", "text": "えっと、クイズは確認できる唯一のものです"}, {"type": "subtitle", "time": 8612.389, "timestamp": "02:23:32", "text": "あなたはサイコパスですか、それとも違いますか。よかった"}, {"type": "subtitle", "time": 8616.07, "timestamp": "02:23:36", "text": "私にとってもあなたにとっても大切なこと。とにかく、"}, {"type": "subtitle", "time": 8619.03, "timestamp": "02:23:39", "text": "どうなるか見てみよう。ええ、最後の質問です。"}, {"type": "subtitle", "time": 8620.71, "timestamp": "02:23:40", "text": "それからチャットを続けましょう"}, {"type": "subtitle", "time": 8623.67, "timestamp": "02:23:43", "text": "セクション。よし。うん。わかった。それで、"}, {"type": "subtitle", "time": 8626.07, "timestamp": "02:23:46", "text": "よく聞いてください。これを正しく理解すれば、"}, {"type": "subtitle", "time": 8629.75, "timestamp": "02:23:49", "text": "えっと、私たちは友達にはなれないね。わかった。だからこれは"}, {"type": "subtitle", "time": 8633.11, "timestamp": "02:23:53", "text": "殺人犯は別の男を刺すことを決意し、"}, {"type": "subtitle", "time": 8636.309, "timestamp": "02:23:56", "text": "彼は彼を5回刺し、その後"}, {"type": "subtitle", "time": 8638.389, "timestamp": "02:23:58", "text": "彼はショッピングモールにいるんだよね？彼はショッピングモールにいる。"}]
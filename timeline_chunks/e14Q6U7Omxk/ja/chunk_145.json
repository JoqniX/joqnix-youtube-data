[{"type": "subtitle", "time": 8701.19, "timestamp": "02:25:01", "text": "ドアの近くに立って彼を見つめていた"}, {"type": "subtitle", "time": 8704.71, "timestamp": "02:25:04", "text": "ガラス越しに、なぜそうするのか"}, {"type": "subtitle", "time": 8707.27, "timestamp": "02:25:07", "text": "彼が生きているとは思えないし、彼は"}, {"type": "subtitle", "time": 8711.03, "timestamp": "02:25:11", "text": "呼吸したり、その後も偽ったりしないので、"}, {"type": "subtitle", "time": 8713.99, "timestamp": "02:25:13", "text": "えっと、もしその後だったら、なんて言うんだっけ？"}, {"type": "subtitle", "time": 8716.469, "timestamp": "02:25:16", "text": "刺し傷が5倍の人が"}, {"type": "subtitle", "time": 8719.27, "timestamp": "02:25:19", "text": "その人物はまだ生きている。いいえ、そうすれば"}, {"type": "subtitle", "time": 8721.67, "timestamp": "02:25:21", "text": "報告する、またはこれを説明してください"}, {"type": "subtitle", "time": 8724.389, "timestamp": "02:25:24", "text": "私を刺した人物は、などなど"}, {"type": "subtitle", "time": 8726.23, "timestamp": "02:25:26", "text": "もの。そう、彼は確認したかったのです"}, {"type": "subtitle", "time": 8730.95, "timestamp": "02:25:30", "text": "彼はあの人ですか、それとも死んだ人ですか。"}, {"type": "subtitle", "time": 8733.27, "timestamp": "02:25:33", "text": "これもまた、ごく普通の答えです。神に感謝"}, {"type": "subtitle", "time": 8736.87, "timestamp": "02:25:36", "text": "友達になれる。わかった、様子を見よう。そして"}, {"type": "subtitle", "time": 8739.99, "timestamp": "02:25:39", "text": "ええ、どうやら彼は立ち去らなかったようです"}, {"type": "subtitle", "time": 8742.23, "timestamp": "02:25:42", "text": "だって、誰にでもわかるでしょ？"}, {"type": "subtitle", "time": 8744.63, "timestamp": "02:25:44", "text": "真ん中に死んでいる男がいる"}, {"type": "subtitle", "time": 8747.03, "timestamp": "02:25:47", "text": "モールですよね？しかし、彼が"}, {"type": "subtitle", "time": 8749.429, "timestamp": "02:25:49", "text": "体、誰もが考える、なぜ"}, {"type": "subtitle", "time": 8751.59, "timestamp": "02:25:51", "text": "なぜ彼は去るのか、そして彼は影響を受けていないのか"}, {"type": "subtitle", "time": 8753.67, "timestamp": "02:25:53", "text": "それによって？"}]
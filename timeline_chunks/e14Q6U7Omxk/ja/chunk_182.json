[{"type": "subtitle", "time": 10922.79, "timestamp": "03:02:02", "text": "私が知っているクリエイターは、私が会ったことのある人全員と知り合いです。"}, {"type": "subtitle", "time": 10924.95, "timestamp": "03:02:04", "text": "私はそれらをすべて取り入れようとしましたが、"}, {"type": "subtitle", "time": 10927.19, "timestamp": "03:02:07", "text": "話をするよ、だって私は話せなかったから"}, {"type": "subtitle", "time": 10929.429, "timestamp": "03:02:09", "text": "以前にも彼らに会ったことがある。だから私はそう思った"}, {"type": "subtitle", "time": 10931.91, "timestamp": "03:02:11", "text": "配信でやってみようと思った。最初は"}, {"type": "subtitle", "time": 10934.389, "timestamp": "03:02:14", "text": "いつでもストリーミング配信をすればいいと思った"}, {"type": "subtitle", "time": 10936.95, "timestamp": "03:02:16", "text": "VODを見て、彼らと話したりします。"}, {"type": "subtitle", "time": 10938.71, "timestamp": "03:02:18", "text": "配信に出たくない人たち。"}, {"type": "subtitle", "time": 10942.469, "timestamp": "03:02:22", "text": "いいえ、私もその考えには賛成でした。それから"}, {"type": "subtitle", "time": 10945.11, "timestamp": "03:02:25", "text": "私は、私が"}, {"type": "subtitle", "time": 10948.23, "timestamp": "03:02:28", "text": "連絡を取ったが、超えておらず、"}, {"type": "subtitle", "time": 10950.79, "timestamp": "03:02:30", "text": "彼らにメッセージを送った方法は"}, {"type": "subtitle", "time": 10953.11, "timestamp": "03:02:33", "text": "コラボレーションや交流会のような感じ"}, {"type": "subtitle", "time": 10955.269, "timestamp": "03:02:35", "text": "あれ。だから彼らはそれが"}, {"type": "subtitle", "time": 10957.51, "timestamp": "03:02:37", "text": "ゲストとして私の配信に出演する"}, {"type": "subtitle", "time": 10961.11, "timestamp": "03:02:41", "text": "右。だから、やってみようと思った"}, {"type": "subtitle", "time": 10963.75, "timestamp": "03:02:43", "text": "どうなるか見てみよう。"}, {"type": "subtitle", "time": 10966.63, "timestamp": "03:02:46", "text": "それから、見る人たちがいました"}, {"type": "subtitle", "time": 10969.349, "timestamp": "03:02:49", "text": "これを取引的なものと捉えた"}, {"type": "subtitle", "time": 10971.67, "timestamp": "03:02:51", "text": "彼らは私の"}, {"type": "subtitle", "time": 10973.75, "timestamp": "03:02:53", "text": "チャネル？景色はどうですか？"}, {"type": "subtitle", "time": 10976.07, "timestamp": "03:02:56", "text": "そういったものすべて"}, {"type": "subtitle", "time": 10978.87, "timestamp": "03:02:58", "text": "数字が多い人たちと"}]
[{"type": "subtitle", "time": 7740.47, "timestamp": "02:09:00", "text": "着けてください。"}, {"type": "subtitle", "time": 7744.47, "timestamp": "02:09:04", "text": "あなたはたくさんのものを目にするかもしれません。"}, {"type": "subtitle", "time": 7751.43, "timestamp": "02:09:11", "text": "私にとっては新しいことですよね？私"}, {"type": "subtitle", "time": 7754.79, "timestamp": "02:09:14", "text": "こんなことは今までしたことがなかった。"}, {"type": "subtitle", "time": 7759.27, "timestamp": "02:09:19", "text": "大丈夫。心配ない。"}, {"type": "subtitle", "time": 7761.75, "timestamp": "02:09:21", "text": "基本的なこと"}, {"type": "subtitle", "time": 7770.55, "timestamp": "02:09:30", "text": "OBSが実行されていない場合"}, {"type": "subtitle", "time": 7772.629, "timestamp": "02:09:32", "text": "管理者は、ドラッグアンドドロップできます"}, {"type": "subtitle", "time": 7777.91, "timestamp": "02:09:37", "text": "とりあえず、今はこれで進めます。多分"}, {"type": "subtitle", "time": 7784.709, "timestamp": "02:09:44", "text": "少なくとも私たちは"}, {"type": "subtitle", "time": 7786.39, "timestamp": "02:09:46", "text": "そういうことだよ。"}, {"type": "subtitle", "time": 7788.39, "timestamp": "02:09:48", "text": "ええ、まだ始まってもいないのに"}, {"type": "subtitle", "time": 7791.109, "timestamp": "02:09:51", "text": "もう遅い。長期四半期はすでに"}, {"type": "subtitle", "time": 7793.91, "timestamp": "02:09:53", "text": "かなり怒ってる感じ。"}, {"type": "subtitle", "time": 7797.27, "timestamp": "02:09:57", "text": "よし、私たちはここにいる。お元気ですか？"}]
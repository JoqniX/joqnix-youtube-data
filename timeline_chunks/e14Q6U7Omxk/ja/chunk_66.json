[{"type": "subtitle", "time": 3960.39, "timestamp": "01:06:00", "text": "放送ですよね？"}, {"type": "subtitle", "time": 3963.67, "timestamp": "01:06:03", "text": "そんな感じ。えっと"}, {"type": "subtitle", "time": 3966.39, "timestamp": "01:06:06", "text": "それはビリーでは不可能でしょう"}, {"type": "subtitle", "time": 3969.19, "timestamp": "01:06:09", "text": "ビリー。私は一定のレベルに到達しなければならない"}, {"type": "subtitle", "time": 3971.67, "timestamp": "01:06:11", "text": "あるいは、そうするために何か"}, {"type": "subtitle", "time": 3975.51, "timestamp": "01:06:15", "text": "知ってるし、もっと"}, {"type": "subtitle", "time": 3977.75, "timestamp": "01:06:17", "text": "痛み"}, {"type": "subtitle", "time": 3983.91, "timestamp": "01:06:23", "text": "うん"}, {"type": "subtitle", "time": 3986.39, "timestamp": "01:06:26", "text": "それは確かに痛みだ。今日は"}, {"type": "subtitle", "time": 3988.87, "timestamp": "01:06:28", "text": "Apex Legendsをプレイしよう。えっと、新しい"}, {"type": "subtitle", "time": 3990.87, "timestamp": "01:06:30", "text": "天体の日の出のイベントが進行中"}, {"type": "subtitle", "time": 3993.27, "timestamp": "01:06:33", "text": "タイトルを見ればわかりますよね。彼らは努力するだろう"}, {"type": "subtitle", "time": 3995.109, "timestamp": "01:06:35", "text": "イベントもあるし、"}, {"type": "subtitle", "time": 3999.27, "timestamp": "01:06:39", "text": "ハードコアロイヤル新LTMは、"}, {"type": "subtitle", "time": 4001.349, "timestamp": "01:06:41", "text": "鎧があるように装甲があるが、ない"}, {"type": "subtitle", "time": 4006.47, "timestamp": "01:06:46", "text": "すると嵐は満ち溢れるでしょう"}, {"type": "subtitle", "time": 4008.789, "timestamp": "01:06:48", "text": "最大ダメージとは、嵐に当たった場合"}, {"type": "subtitle", "time": 4011.75, "timestamp": "01:06:51", "text": "俺は死んだ、まるでハードコアみたいだ"}, {"type": "subtitle", "time": 4014.789, "timestamp": "01:06:54", "text": "ハードコア。でも、最善を尽くしましょう"}, {"type": "subtitle", "time": 4017.27, "timestamp": "01:06:57", "text": "シャファン。"}]
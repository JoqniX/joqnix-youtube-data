[{"type": "subtitle", "time": 10861.11, "timestamp": "03:01:01", "text": "すでにいくつかのコラボレーションを計画していました。"}, {"type": "subtitle", "time": 10864.63, "timestamp": "03:01:04", "text": "1か月前に計画したとおり、"}, {"type": "subtitle", "time": 10867.11, "timestamp": "03:01:07", "text": "日本のコラボや韓国のコラボのように"}, {"type": "subtitle", "time": 10869.99, "timestamp": "03:01:09", "text": "コラボや中国とのコラボなど。全て"}, {"type": "subtitle", "time": 10872.309, "timestamp": "03:01:12", "text": "これらはまるで既にそこにあったかのようだった。それから"}, {"type": "subtitle", "time": 10874.55, "timestamp": "03:01:14", "text": "私は「ああ、この３つを手に入れよう」と思った"}, {"type": "subtitle", "time": 10876.71, "timestamp": "03:01:16", "text": "そこに新しく来た人たち。彼らは行く"}, {"type": "subtitle", "time": 10879.51, "timestamp": "03:01:19", "text": "新しいコラボレーション、最初のコラボレーション"}, {"type": "subtitle", "time": 10882.79, "timestamp": "03:01:22", "text": "右？だから、なぜと思ったのか"}, {"type": "subtitle", "time": 10885.11, "timestamp": "03:01:25", "text": "まるで最後の瞬間みたいだ。それで"}, {"type": "subtitle", "time": 10889.03, "timestamp": "03:01:29", "text": "YouTuberや他の人たちが"}, {"type": "subtitle", "time": 10891.349, "timestamp": "03:01:31", "text": "私がコラボレーションしたYouTuberたち。私"}, {"type": "subtitle", "time": 10893.67, "timestamp": "03:01:33", "text": "長い間コラボレーションしておらず、"}, {"type": "subtitle", "time": 10896.469, "timestamp": "03:01:36", "text": "私は何もせずに旅に出ている"}, {"type": "subtitle", "time": 10901.19, "timestamp": "03:01:41", "text": "コラボレーションは多くなく、ソロ活動が中心です"}, {"type": "subtitle", "time": 10903.59, "timestamp": "03:01:43", "text": "コンテンツタイプ。だから私はこう思った"}, {"type": "subtitle", "time": 10906.55, "timestamp": "03:01:46", "text": "えっと"}, {"type": "subtitle", "time": 10908.95, "timestamp": "03:01:48", "text": "自信を持って、ただ人に聞いてみればいいんです"}, {"type": "subtitle", "time": 10911.269, "timestamp": "03:01:51", "text": "などなど、もし彼らが落ち込んでいるなら"}, {"type": "subtitle", "time": 10913.11, "timestamp": "03:01:53", "text": "私がコラボレーションした人たちは"}, {"type": "subtitle", "time": 10916.309, "timestamp": "03:01:56", "text": "私を助けてくれた友人たち"}, {"type": "subtitle", "time": 10918.87, "timestamp": "03:01:58", "text": "YouTuber非クリエイター"}]
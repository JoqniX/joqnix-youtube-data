[{"type": "subtitle", "time": 14280.95, "timestamp": "03:58:00", "text": "「よし、あの学校をなんとか生き延びてるぞ」みたいな感じ。"}, {"type": "subtitle", "time": 14283.83, "timestamp": "03:58:03", "text": "私はその食べ物を食べました。私はプレイすることができました"}, {"type": "subtitle", "time": 14287.51, "timestamp": "03:58:07", "text": "あの学校ね。うん。"}, {"type": "subtitle", "time": 14289.51, "timestamp": "03:58:09", "text": "だから私は試してテストするのが好きなんです、"}, {"type": "subtitle", "time": 14291.59, "timestamp": "03:58:11", "text": "知ってるよ、3つくらいのことをやってみるよ"}, {"type": "subtitle", "time": 14293.189, "timestamp": "03:58:13", "text": "数ヶ月。これがうまくいかなければ、次に進みます"}, {"type": "subtitle", "time": 14295.11, "timestamp": "03:58:15", "text": "次のページへ。だから暗号通貨では"}, {"type": "subtitle", "time": 14298.63, "timestamp": "03:58:18", "text": "私が300ドル稼いだもの"}, {"type": "subtitle", "time": 14300.71, "timestamp": "03:58:20", "text": "あのゲーム。"}, {"type": "subtitle", "time": 14305.189, "timestamp": "03:58:25", "text": "うん。それで私は200ドル投資して、"}, {"type": "subtitle", "time": 14308.309, "timestamp": "03:58:28", "text": "残りの100人は詐欺に遭った。"}, {"type": "subtitle", "time": 14311.269, "timestamp": "03:58:31", "text": "私は理性を失った。うん。実際には私は"}, {"type": "subtitle", "time": 14314.07, "timestamp": "03:58:34", "text": "道が一本分途切れた。"}, {"type": "subtitle", "time": 14316.71, "timestamp": "03:58:36", "text": "何てことだ。どうやら。しかしそれは"}, {"type": "subtitle", "time": 14320.63, "timestamp": "03:58:40", "text": "架空のものだったのは、それが"}, {"type": "subtitle", "time": 14323.99, "timestamp": "03:58:43", "text": "ある人が私を招待してくれました"}, {"type": "subtitle", "time": 14327.189, "timestamp": "03:58:47", "text": "Discordサーバー。彼は言った、もし私について来れば"}, {"type": "subtitle", "time": 14329.349, "timestamp": "03:58:49", "text": "私のトレード方法"}, {"type": "subtitle", "time": 14331.75, "timestamp": "03:58:51", "text": "私についてきてくれればそれでうまくいくよ"}, {"type": "subtitle", "time": 14333.75, "timestamp": "03:58:53", "text": "全てがうまくいくでしょう。それで私は始めた"}, {"type": "subtitle", "time": 14336.71, "timestamp": "03:58:56", "text": "彼が何を言おうと、私はそれを始めた。えっと、彼は"}, {"type": "subtitle", "time": 14339.91, "timestamp": "03:58:59", "text": "彼は私にこのサイトに100ドル入金するように言った。"}]
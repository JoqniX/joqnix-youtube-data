[{"type": "subtitle", "time": 2282.47, "timestamp": "00:38:02", "text": "大丈夫だけど、"}, {"type": "subtitle", "time": 2285.51, "timestamp": "00:38:05", "text": "これは、"}, {"type": "subtitle", "time": 2288.47, "timestamp": "00:38:08", "text": "すべての重要な役割"}, {"type": "subtitle", "time": 2290.069, "timestamp": "00:38:10", "text": "YouTuber"}, {"type": "subtitle", "time": 2297.829, "timestamp": "00:38:17", "text": "建設的な批判には耳を傾けます。"}, {"type": "subtitle", "time": 2300.47, "timestamp": "00:38:20", "text": "うん。つまり、もしあなたが次のようなものを見たら"}, {"type": "subtitle", "time": 2303.589, "timestamp": "00:38:23", "text": "もしよろしければ、今日は音声に問題がありました"}, {"type": "subtitle", "time": 2306.55, "timestamp": "00:38:26", "text": "そんな風にゲームをすると、"}, {"type": "subtitle", "time": 2308.63, "timestamp": "00:38:28", "text": "そのような問題やバグを見かけましたか？"}, {"type": "subtitle", "time": 2312.47, "timestamp": "00:38:32", "text": "えっと、もしそれがTwitchにあるなら、私のボードは"}, {"type": "subtitle", "time": 2314.95, "timestamp": "00:38:34", "text": "チャンネルポイントのいずれかが機能しない場合"}, {"type": "subtitle", "time": 2317.349, "timestamp": "00:38:37", "text": "動作していないか、YouTube で動作している場合"}, {"type": "subtitle", "time": 2320.069, "timestamp": "00:38:40", "text": "コマンドが機能しないため、"}, {"type": "subtitle", "time": 2323.27, "timestamp": "00:38:43", "text": "以前はよく使っていたコマンドは"}, {"type": "subtitle", "time": 2325.589, "timestamp": "00:38:45", "text": "仕事に来ないと私の言うことを聞いてないよ"}, {"type": "subtitle", "time": 2329.91, "timestamp": "00:38:49", "text": "適切に、または私がコラボで"}, {"type": "subtitle", "time": 2333.109, "timestamp": "00:38:53", "text": "ストリームが聞こえない場合は、"}, {"type": "subtitle", "time": 2336.87, "timestamp": "00:38:56", "text": "ゲストの声を適切にコラボレーションさせてください"}]
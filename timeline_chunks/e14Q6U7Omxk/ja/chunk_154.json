[{"type": "subtitle", "time": 9241.429, "timestamp": "02:34:01", "text": "壊れた祝祭。もうご覧になりましたか？どれの"}, {"type": "subtitle", "time": 9244.79, "timestamp": "02:34:04", "text": "1つ？えーと、2回目のデート、えーと、2回目のデート"}, {"type": "subtitle", "time": 9247.27, "timestamp": "02:34:07", "text": "broken jubil によるアップデート。それはラジオだった"}, {"type": "subtitle", "time": 9249.91, "timestamp": "02:34:09", "text": "ショー、そして今では多くのものが構築されています"}, {"type": "subtitle", "time": 9253.59, "timestamp": "02:34:13", "text": "インスタグラム。ああ、それは見ないんです。私"}, {"type": "subtitle", "time": 9257.349, "timestamp": "02:34:17", "text": "わからない。えっと、彼らは何をすると思いますか？"}, {"type": "subtitle", "time": 9260.15, "timestamp": "02:34:20", "text": "2回目のデートに行くなら、"}, {"type": "subtitle", "time": 9263.51, "timestamp": "02:34:23", "text": "デートとデート相手があなたを無視する"}, {"type": "subtitle", "time": 9267.51, "timestamp": "02:34:27", "text": "ラジオ番組に電話するように頼むことができます"}, {"type": "subtitle", "time": 9269.59, "timestamp": "02:34:29", "text": "相手がなぜあなたを無視したのかを知り、その理由を知る"}, {"type": "subtitle", "time": 9272.23, "timestamp": "02:34:32", "text": "そういうことや、"}, {"type": "subtitle", "time": 9274.389, "timestamp": "02:34:34", "text": "あなたがそう思う理由は様々です"}, {"type": "subtitle", "time": 9277.11, "timestamp": "02:34:37", "text": "聴くには、"}, {"type": "subtitle", "time": 9278.63, "timestamp": "02:34:38", "text": "見て理解すればわかるよ、それは"}, {"type": "subtitle", "time": 9280.55, "timestamp": "02:34:40", "text": "面白い"}, {"type": "subtitle", "time": 9282.469, "timestamp": "02:34:42", "text": "それは対立のようなものだ"}, {"type": "subtitle", "time": 9284.63, "timestamp": "02:34:44", "text": "音信不通になったの？理由は何？"}, {"type": "subtitle", "time": 9287.11, "timestamp": "02:34:47", "text": "うん。うん。そしてその理由もね。おお"}, {"type": "subtitle", "time": 9289.349, "timestamp": "02:34:49", "text": "我が神よ。面白い、なんて面白いんだ"}, {"type": "subtitle", "time": 9293.349, "timestamp": "02:34:53", "text": "そうかもしれない。そして奇妙なものがどれほど"}, {"type": "subtitle", "time": 9295.91, "timestamp": "02:34:55", "text": "えっと、じゃあ、"}, {"type": "subtitle", "time": 9299.19, "timestamp": "02:34:59", "text": "話。何が起こったかというと、その人は"}]
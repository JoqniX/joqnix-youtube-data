[{"type": "subtitle", "time": 5401.99, "timestamp": "01:30:01", "text": "さあ行こう。ピューピューと撃ちたい。やろう"}, {"type": "subtitle", "time": 5405.189, "timestamp": "01:30:05", "text": "課題とか色々。"}, {"type": "subtitle", "time": 5408.07, "timestamp": "01:30:08", "text": "だから、監督の意向に合わせてプレーしろ。同じことだ"}, {"type": "subtitle", "time": 5411.91, "timestamp": "01:30:11", "text": "これは、すべてのイベントで発生する"}, {"type": "subtitle", "time": 5416.709, "timestamp": "01:30:16", "text": "ダメージ、キル、アシスト上位4位、すべて"}, {"type": "subtitle", "time": 5419.189, "timestamp": "01:30:19", "text": "これはBRにあります。"}, {"type": "subtitle", "time": 5421.51, "timestamp": "01:30:21", "text": "ああ、それでもこれはプレイすべきではない。おお"}, {"type": "subtitle", "time": 5430.79, "timestamp": "01:30:30", "text": "やってみて、ジョイ。騎手。どういう意味ですか？私"}, {"type": "subtitle", "time": 5433.43, "timestamp": "01:30:33", "text": "つまり、2,000ドル使わないといけないってこと？"}, {"type": "subtitle", "time": 5439.669, "timestamp": "01:30:39", "text": "でも、2000ルピーは使わないといけないんです。私は"}, {"type": "subtitle", "time": 5443.03, "timestamp": "01:30:43", "text": "既にレンダリングを試みています。私はしようとしています。私"}, {"type": "subtitle", "time": 5445.189, "timestamp": "01:30:45", "text": "やめてください。うん。言い忘れていましたが"}, {"type": "subtitle", "time": 5447.35, "timestamp": "01:30:47", "text": "これ。それで"}, {"type": "subtitle", "time": 5455.35, "timestamp": "01:30:55", "text": "ああ、もしお金があったら"}, {"type": "subtitle", "time": 5458.229, "timestamp": "01:30:58", "text": "無駄にすることもできたし、そうしたかったけど"}]
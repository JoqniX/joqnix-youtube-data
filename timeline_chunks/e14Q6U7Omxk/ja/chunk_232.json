[{"type": "subtitle", "time": 13922.87, "timestamp": "03:52:02", "text": "ああ、問題ないよ、友よ。とにかく、"}, {"type": "subtitle", "time": 13926.07, "timestamp": "03:52:06", "text": "うん、それは本当に良いね。私たちには"}, {"type": "subtitle", "time": 13928.469, "timestamp": "03:52:08", "text": "会話が上手い。私たちは"}, {"type": "subtitle", "time": 13931.51, "timestamp": "03:52:11", "text": "お互いにとても親しい関係です。私はそうしなかった、私は"}, {"type": "subtitle", "time": 13933.11, "timestamp": "03:52:13", "text": "出身地は聞かないよ"}, {"type": "subtitle", "time": 13935.59, "timestamp": "03:52:15", "text": "あるいは犬だからそういうこと"}, {"type": "subtitle", "time": 13938.63, "timestamp": "03:52:18", "text": "ヘビって星座の名前ですよね？うん、"}, {"type": "subtitle", "time": 13940.389, "timestamp": "03:52:20", "text": "私は宇宙から来た。"}, {"type": "subtitle", "time": 13943.03, "timestamp": "03:52:23", "text": "ええ、そうです。彼女は星座で、"}, {"type": "subtitle", "time": 13945.83, "timestamp": "03:52:25", "text": "彼は空にいる。私はスーリヤです。私はサンです。"}, {"type": "subtitle", "time": 13948.469, "timestamp": "03:52:28", "text": "彼は夜空の支配者だ。参加します"}, {"type": "subtitle", "time": 13950.229, "timestamp": "03:52:30", "text": "朝。よし。それは"}, {"type": "subtitle", "time": 13956.87, "timestamp": "03:52:36", "text": "それはまるで、あの七つの大罪のようなものです"}, {"type": "subtitle", "time": 13959.75, "timestamp": "03:52:39", "text": "物事、ですよね？あなたはそういう人ですね"}, {"type": "subtitle", "time": 13965.59, "timestamp": "03:52:45", "text": "プライドの男、太陽の男。エス"}, {"type": "subtitle", "time": 13967.11, "timestamp": "03:52:47", "text": "うん。"}, {"type": "subtitle", "time": 13972.469, "timestamp": "03:52:52", "text": "大丈夫です。私はそんなに優秀ではない。彼は"}, {"type": "subtitle", "time": 13974.95, "timestamp": "03:52:54", "text": "彼があなたの頭を真っ二つに折るなら"}, {"type": "subtitle", "time": 13977.91, "timestamp": "03:52:57", "text": "彼はそうしたいと思っている。"}, {"type": "subtitle", "time": 13979.83, "timestamp": "03:52:59", "text": "私はそういうタイプの人間じゃない。私はほしくない"}]
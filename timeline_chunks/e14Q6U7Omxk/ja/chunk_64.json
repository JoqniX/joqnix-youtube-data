[{"type": "subtitle", "time": 3841.91, "timestamp": "01:04:01", "text": "そして悪い。しかし、私はこうも思った。"}, {"type": "subtitle", "time": 3843.829, "timestamp": "01:04:03", "text": "もし誰かを捕まえることができたら、"}, {"type": "subtitle", "time": 3846.63, "timestamp": "01:04:06", "text": "秘密保持契約書か何かを作成して"}, {"type": "subtitle", "time": 3848.87, "timestamp": "01:04:08", "text": "何か対策を講じるべきだ。しかし"}, {"type": "subtitle", "time": 3850.95, "timestamp": "01:04:10", "text": "どうやら私はサポートに連絡して"}, {"type": "subtitle", "time": 3853.589, "timestamp": "01:04:13", "text": "詰め物や洗う塗料、しかし使い切る"}, {"type": "subtitle", "time": 3856.069, "timestamp": "01:04:16", "text": "翻訳者とかそういう類。でもどうやら私の"}, {"type": "subtitle", "time": 3858.63, "timestamp": "01:04:18", "text": "唯一の選択肢は"}, {"type": "subtitle", "time": 3861.349, "timestamp": "01:04:21", "text": "願わくば、少なくとも"}, {"type": "subtitle", "time": 3864.15, "timestamp": "01:04:24", "text": "削除するか、別のものに変更する"}, {"type": "subtitle", "time": 3866.63, "timestamp": "01:04:26", "text": "もし私が実際に中国のIDを持っているなら"}, {"type": "subtitle", "time": 3868.87, "timestamp": "01:04:28", "text": "誰か、何か、または私が削除しなければならない"}, {"type": "subtitle", "time": 3871.51, "timestamp": "01:04:31", "text": "私のアカウントは、私が負けることを意味します"}, {"type": "subtitle", "time": 3875.19, "timestamp": "01:04:35", "text": "私のフォロワー全員、またはいいえ"}, {"type": "subtitle", "time": 3877.829, "timestamp": "01:04:37", "text": "フォロワーはファンのようなものだと信じています。"}, {"type": "subtitle", "time": 3880.069, "timestamp": "01:04:40", "text": "右？うん。うん。フォロワーはあなたの"}, {"type": "subtitle", "time": 3882.23, "timestamp": "01:04:42", "text": "サブスクリプション。うん。うん。他の"}, {"type": "subtitle", "time": 3884.309, "timestamp": "01:04:44", "text": "チャンネル。うん。だから私はすべてを失うことになる"}, {"type": "subtitle", "time": 3888.39, "timestamp": "01:04:48", "text": "それと、私が"}, {"type": "subtitle", "time": 3891.91, "timestamp": "01:04:51", "text": "試してみて、あちらにアップロードしました。平"}, {"type": "subtitle", "time": 3893.91, "timestamp": "01:04:53", "text": "それは私の好みにはあまり関係ない"}, {"type": "subtitle", "time": 3896.87, "timestamp": "01:04:56", "text": "チャンネルですが、それでも私は私が書いたのが好きです"}, {"type": "subtitle", "time": 3899.109, "timestamp": "01:04:59", "text": "法律関係など全てを詳しく説明してください"}]
[{"type": "subtitle", "time": 6845.99, "timestamp": "01:54:05", "text": "ハードコア ハードコア ロイヤルは、"}, {"type": "subtitle", "time": 6849.83, "timestamp": "01:54:09", "text": "ノンNBですよね？バトルロイヤルではない。だから、"}, {"type": "subtitle", "time": 6851.669, "timestamp": "01:54:11", "text": "それはあなたのチャレンジにはカウントされません。それで、"}, {"type": "subtitle", "time": 6854.39, "timestamp": "01:54:14", "text": "行く方が良い"}, {"type": "subtitle", "time": 6856.55, "timestamp": "01:54:16", "text": "バトルロイヤル。通常のように"}, {"type": "subtitle", "time": 6860.39, "timestamp": "01:54:20", "text": "子犬を仕上げる"}, {"type": "subtitle", "time": 6870.79, "timestamp": "01:54:30", "text": "でも、35 FPSで動作している状態は気に入っています。"}, {"type": "subtitle", "time": 6881.27, "timestamp": "01:54:41", "text": "35で止まってる。待って、私たちはあなたを助ける"}, {"type": "subtitle", "time": 6893.35, "timestamp": "01:54:53", "text": "それならアダプティブモードにしてください。"}, {"type": "subtitle", "time": 6895.91, "timestamp": "01:54:55", "text": "だから、私はこんな服を着てきました"}, {"type": "subtitle", "time": 6898.79, "timestamp": "01:54:58", "text": "午後9時からずっと私の袖に付いています。私"}]
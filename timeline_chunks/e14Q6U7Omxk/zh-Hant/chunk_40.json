[{"type": "subtitle", "time": 2401.91, "timestamp": "00:40:01", "text": "說什麼？他們說了什麼？"}, {"type": "subtitle", "time": 2404.15, "timestamp": "00:40:04", "text": "他們會陷入這種"}, {"type": "subtitle", "time": 2406.63, "timestamp": "00:40:06", "text": "好奇的循環，"}, {"type": "subtitle", "time": 2409.109, "timestamp": "00:40:09", "text": "除非你用谷歌"}, {"type": "subtitle", "time": 2412.23, "timestamp": "00:40:12", "text": "翻譯自己翻譯一下，就像那樣。"}, {"type": "subtitle", "time": 2417.43, "timestamp": "00:40:17", "text": "所以盡量用英語溝通。"}, {"type": "subtitle", "time": 2421.589, "timestamp": "00:40:21", "text": "好的。而我在上一部作品中始終堅持的最重要的原則之一"}, {"type": "subtitle", "time": 2428.37, "timestamp": "00:40:28", "text": "就是：不要忘記保持可愛，做你自己。"}, {"type": "subtitle", "time": 2430.069, "timestamp": "00:40:30", "text": "[音樂]"}, {"type": "subtitle", "time": 2435.27, "timestamp": "00:40:35", "text": "是的。做你自己，展現你的可愛。好的。"}, {"type": "subtitle", "time": 2437.03, "timestamp": "00:40:37", "text": "嗯。"}, {"type": "subtitle", "time": 2443.589, "timestamp": "00:40:43", "text": "你們都應該像往常一樣戴上頭墊。"}, {"type": "subtitle", "time": 2446.79, "timestamp": "00:40:46", "text": "哦，對了"}, {"type": "subtitle", "time": 2449.67, "timestamp": "00:40:49", "text": "。以上就是規則部分。所以"}, {"type": "subtitle", "time": 2451.75, "timestamp": "00:40:51", "text": "，"}, {"type": "subtitle", "time": 2455.03, "timestamp": "00:40:55", "text": "你很可愛。我長得醜。不，不，不，不，"}, {"type": "subtitle", "time": 2457.75, "timestamp": "00:40:57", "text": "不。事情並非如此。巴卡"}, {"type": "subtitle", "time": 2459.99, "timestamp": "00:40:59", "text": "報告"}]
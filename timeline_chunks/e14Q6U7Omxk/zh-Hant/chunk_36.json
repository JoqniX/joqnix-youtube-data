[{"type": "subtitle", "time": 2163.51, "timestamp": "00:36:03", "text": "所以我不想讓任何人的心情"}, {"type": "subtitle", "time": 2166.31, "timestamp": "00:36:06", "text": "變差，或是因為他們看到我們，或是"}, {"type": "subtitle", "time": 2170.87, "timestamp": "00:36:10", "text": "在聊天中看到仇恨指令之類的東西，或是任何"}, {"type": "subtitle", "time": 2173.589, "timestamp": "00:36:13", "text": "類似的事情。好的。"}, {"type": "subtitle", "time": 2175.589, "timestamp": "00:36:15", "text": "別忘了保持可愛。這是"}, {"type": "subtitle", "time": 2181.589, "timestamp": "00:36:21", "text": "抱歉我沒能多陪陪她。"}, {"type": "subtitle", "time": 2185.349, "timestamp": "00:36:25", "text": "不，沒關係。不用擔心。你知道，"}, {"type": "subtitle", "time": 2187.349, "timestamp": "00:36:27", "text": "你知道，你知道，我一直…我一直…一直"}, {"type": "subtitle", "time": 2190.63, "timestamp": "00:36:30", "text": "獨自直播和製作影片已經"}, {"type": "subtitle", "time": 2194.63, "timestamp": "00:36:34", "text": "好幾年了。所以，我習慣了"}, {"type": "subtitle", "time": 2196.47, "timestamp": "00:36:36", "text": "自己在移動。"}, {"type": "subtitle", "time": 2198.15, "timestamp": "00:36:38", "text": "是的。但有時候，在"}, {"type": "subtitle", "time": 2200.63, "timestamp": "00:36:40", "text": "合作直播或像遊戲直播（不是遊戲"}, {"type": "subtitle", "time": 2202.87, "timestamp": "00:36:42", "text": "直播，而是合作直播）的時候，當我"}, {"type": "subtitle", "time": 2206.069, "timestamp": "00:36:46", "text": "注意力從聊天中轉移開來時，"}, {"type": "subtitle", "time": 2210.71, "timestamp": "00:36:50", "text": "可以說我比較脆弱。"}, {"type": "subtitle", "time": 2214.069, "timestamp": "00:36:54", "text": "但是，除此之外，我的想法是，"}, {"type": "subtitle", "time": 2216.47, "timestamp": "00:36:56", "text": "如果你不夠投入也沒關係"}]
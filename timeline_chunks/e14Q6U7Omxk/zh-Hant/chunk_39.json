[{"type": "subtitle", "time": 2342.95, "timestamp": "00:39:02", "text": "另外，請確保聊天"}, {"type": "subtitle", "time": 2346.55, "timestamp": "00:39:06", "text": "只使用英語，不要用"}, {"type": "subtitle", "time": 2349.67, "timestamp": "00:39:09", "text": "日語，因為大多數時候，"}, {"type": "subtitle", "time": 2353.03, "timestamp": "00:39:13", "text": "如果我只是聊天，我可以"}, {"type": "subtitle", "time": 2357.03, "timestamp": "00:39:17", "text": "立即複製內容，然後放到"}, {"type": "subtitle", "time": 2360.23, "timestamp": "00:39:20", "text": "谷歌翻譯裡，再"}, {"type": "subtitle", "time": 2363.03, "timestamp": "00:39:23", "text": "回复。  雖然增加了一些"}, {"type": "subtitle", "time": 2367.43, "timestamp": "00:39:27", "text": "工作量，但還是可以的。嗯，是的，是的，"}, {"type": "subtitle", "time": 2374.069, "timestamp": "00:39:34", "text": "但是盡量用"}, {"type": "subtitle", "time": 2378.15, "timestamp": "00:39:38", "text": "英語交流，或者保持冷靜，這樣不僅你我，"}, {"type": "subtitle", "time": 2380.55, "timestamp": "00:39:40", "text": "聊天室裡的其他人也能理解，"}, {"type": "subtitle", "time": 2386.79, "timestamp": "00:39:46", "text": "否則別人可能會誤解。"}, {"type": "subtitle", "time": 2390.55, "timestamp": "00:39:50", "text": "嗯，是的，"}, {"type": "subtitle", "time": 2393.91, "timestamp": "00:39:53", "text": "如果他們不懂你的"}, {"type": "subtitle", "time": 2396.55, "timestamp": "00:39:56", "text": "語言，他們就會想，"}, {"type": "subtitle", "time": 2399.589, "timestamp": "00:39:59", "text": "他到底在"}]
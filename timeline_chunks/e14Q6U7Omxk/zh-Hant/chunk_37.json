[{"type": "subtitle", "time": 2221.43, "timestamp": "00:37:01", "text": "。別擔心，我很強壯。"}, {"type": "subtitle", "time": 2225.52, "timestamp": "00:37:05", "text": "如果有人做了壞事，我會懲罰他們。"}, {"type": "subtitle", "time": 2227.51, "timestamp": "00:37:07", "text": "[音樂]"}, {"type": "subtitle", "time": 2231.19, "timestamp": "00:37:11", "text": "所以現在聊天室裡不允許仇恨言論和其他"}, {"type": "subtitle", "time": 2233.27, "timestamp": "00:37:13", "text": "類似的東西，"}, {"type": "subtitle", "time": 2237.27, "timestamp": "00:37:17", "text": "哦，對了，最重要的是，不要"}, {"type": "subtitle", "time": 2239.75, "timestamp": "00:37:19", "text": "談論任何創作者或"}, {"type": "subtitle", "time": 2241.91, "timestamp": "00:37:21", "text": "主播，"}, {"type": "subtitle", "time": 2245.109, "timestamp": "00:37:25", "text": "除非你提到他們的名字。哦，對，就是"}, {"type": "subtitle", "time": 2248.39, "timestamp": "00:37:28", "text": "這個東西。是的，就是這樣。還有，呃，也"}, {"type": "subtitle", "time": 2250.63, "timestamp": "00:37:30", "text": "不要自我推銷。呃，"}, {"type": "subtitle", "time": 2253.27, "timestamp": "00:37:33", "text": "像是如果你是主播之類的，因為"}, {"type": "subtitle", "time": 2255.99, "timestamp": "00:37:35", "text": "如果我知道你是"}, {"type": "subtitle", "time": 2257.75, "timestamp": "00:37:37", "text": "主播，我會為你宣傳的。"}, {"type": "subtitle", "time": 2259.349, "timestamp": "00:37:39", "text": "尤其是在Twitch上，我會大聲為"}, {"type": "subtitle", "time": 2262.069, "timestamp": "00:37:42", "text": "你宣傳。但是YouTube也是一樣，我想對你們大喊，但"}, {"type": "subtitle", "time": 2267.03, "timestamp": "00:37:47", "text": "我做不到。但也不要談論"}, {"type": "subtitle", "time": 2269.03, "timestamp": "00:37:49", "text": "其他任何流派。"}, {"type": "subtitle", "time": 2272.95, "timestamp": "00:37:52", "text": "我的意思是，如果你想談論一些"}, {"type": "subtitle", "time": 2276.069, "timestamp": "00:37:56", "text": "話題，或者像你觀看這個影片然後必須"}, {"type": "subtitle", "time": 2278.15, "timestamp": "00:37:58", "text": "檢查這個之類的，那沒問題，"}]
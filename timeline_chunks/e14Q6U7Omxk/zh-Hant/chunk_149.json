[{"type": "subtitle", "time": 8941.67, "timestamp": "02:29:01", "text": "肯定會為此製作一個影片"}, {"type": "subtitle", "time": 8946.63, "timestamp": "02:29:06", "text": "。啊，那我該怎麼跟你"}, {"type": "subtitle", "time": 8949.19, "timestamp": "02:29:09", "text": "解釋呢？就像夏洛克·"}, {"type": "subtitle", "time": 8961.75, "timestamp": "02:29:21", "text": "福爾摩斯那種類型的罪犯。  是的。是的。是的。是的。是的。是的。  就是這樣。"}, {"type": "subtitle", "time": 8976.23, "timestamp": "02:29:36", "text": "精神病患者就像瘋子一樣。他們感覺不到任何東西，就像他們"}, {"type": "subtitle", "time": 8979.67, "timestamp": "02:29:39", "text": "感覺不到正常人會有的那些情感一樣，對吧？  就像精神病患者沒有良知，或者在壓力下會爆發一樣，對"}]
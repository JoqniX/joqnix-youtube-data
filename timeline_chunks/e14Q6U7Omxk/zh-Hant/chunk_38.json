[{"type": "subtitle", "time": 2282.47, "timestamp": "00:38:02", "text": "但你知道，"}, {"type": "subtitle", "time": 2285.51, "timestamp": "00:38:05", "text": "我認為這是所有"}, {"type": "subtitle", "time": 2290.069, "timestamp": "00:38:10", "text": "YouTuber 最重要的角色之一"}, {"type": "subtitle", "time": 2297.829, "timestamp": "00:38:17", "text": "我樂於接受建設性批評。"}, {"type": "subtitle", "time": 2300.47, "timestamp": "00:38:20", "text": "是的。所以，這意味著，如果你看到，比如"}, {"type": "subtitle", "time": 2303.589, "timestamp": "00:38:23", "text": "今天我們遇到了遊戲音頻問題，或者其他"}, {"type": "subtitle", "time": 2308.63, "timestamp": "00:38:28", "text": "類似的問題或漏洞，比如"}, {"type": "subtitle", "time": 2312.47, "timestamp": "00:38:32", "text": "在 Twitch 上，如果我的控制面板"}, {"type": "subtitle", "time": 2317.349, "timestamp": "00:38:37", "text": "無法正常工作，或者任何頻道積分無法使用；或者在 YouTube 上，如果"}, {"type": "subtitle", "time": 2320.069, "timestamp": "00:38:40", "text": "命令無法使用（"}, {"type": "subtitle", "time": 2323.27, "timestamp": "00:38:43", "text": "你以前經常使用的命令現在都無法"}, {"type": "subtitle", "time": 2325.589, "timestamp": "00:38:45", "text": "使用），或者你聽不清楚我的聲音；或者"}, {"type": "subtitle", "time": 2329.91, "timestamp": "00:38:49", "text": "在我的合作"}, {"type": "subtitle", "time": 2333.109, "timestamp": "00:38:53", "text": "直播中，如果你聽不清楚"}, {"type": "subtitle", "time": 2336.87, "timestamp": "00:38:56", "text": "合作嘉賓的聲音，請告訴"}]
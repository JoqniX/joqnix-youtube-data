[{"type": "subtitle", "time": 13144.55, "timestamp": "03:39:04", "text": "你没让我告诉你拉朱特是呃"}, {"type": "subtitle", "time": 13147.349, "timestamp": "03:39:07", "text": "你知道，呃，你知道那四个维拉"}, {"type": "subtitle", "time": 13150.55, "timestamp": "03:39:10", "text": "就像印度那样的系统"}, {"type": "subtitle", "time": 13153.83, "timestamp": "03:39:13", "text": "以前那种酒吧之类的东西，我"}, {"type": "subtitle", "time": 13156.71, "timestamp": "03:39:16", "text": "我想你答应了，我知道我知道你"}, {"type": "subtitle", "time": 13159.59, "timestamp": "03:39:19", "text": "我们进行了很多次长时间的谈话。"}, {"type": "subtitle", "time": 13162.79, "timestamp": "03:39:22", "text": "呃，问题是这四个人都是婆罗门。"}, {"type": "subtitle", "time": 13167.269, "timestamp": "03:39:27", "text": "呃查特里亚、瓦希亚和顺德拉。所以"}, {"type": "subtitle", "time": 13169.51, "timestamp": "03:39:29", "text": "恰特里亚人是战士，对吧？"}, {"type": "subtitle", "time": 13171.67, "timestamp": "03:39:31", "text": "战斗机飞行员，他们本该阵亡"}, {"type": "subtitle", "time": 13173.99, "timestamp": "03:39:33", "text": "在战场上之类的，你知道的，他们"}, {"type": "subtitle", "time": 13177.67, "timestamp": "03:39:37", "text": "我们是那种保护者之类的角色。所以在"}, {"type": "subtitle", "time": 13181.03, "timestamp": "03:39:41", "text": "他们当中有拉贾特人，有马拉塔人，"}, {"type": "subtitle", "time": 13185.83, "timestamp": "03:39:45", "text": "呃，拉贾茨，还有，还有更多，我是"}, {"type": "subtitle", "time": 13189.11, "timestamp": "03:39:49", "text": "我当时并没有特别想到这件事，但是"}, {"type": "subtitle", "time": 13192.309, "timestamp": "03:39:52", "text": "是的，它就像一个石膏，你可以称之为……"}, {"type": "subtitle", "time": 13195.51, "timestamp": "03:39:55", "text": "演员阵容，但是呃，它不像演员阵容，它是"}, {"type": "subtitle", "time": 13198.71, "timestamp": "03:39:58", "text": "就像部落那种东西，你知道的。"}]
[{"type": "subtitle", "time": 12484.309, "timestamp": "03:28:04", "text": "现在有个叫凯文·朗的节目"}, {"type": "subtitle", "time": 12486.15, "timestamp": "03:28:06", "text": "我认为"}, {"type": "subtitle", "time": 12488.389, "timestamp": "03:28:08", "text": "呃，我觉得他得到了很多"}, {"type": "subtitle", "time": 12491.67, "timestamp": "03:28:11", "text": "他的人气就像……呃，他做了一个节目"}, {"type": "subtitle", "time": 12494.71, "timestamp": "03:28:14", "text": "关于这个，呃，猜猜看，黑人猜猜看"}, {"type": "subtitle", "time": 12497.03, "timestamp": "03:28:17", "text": "白人猜猜谁是红头发的人"}, {"type": "subtitle", "time": 12500.63, "timestamp": "03:28:20", "text": "猜猜那个男孩是那种类型，嗯，是的。"}, {"type": "subtitle", "time": 12502.95, "timestamp": "03:28:22", "text": "某种程度上有点种族歧视，但他们还是这么做了。"}, {"type": "subtitle", "time": 12505.59, "timestamp": "03:28:25", "text": "因为她们是黑人，所以很有趣，你知道吗？"}, {"type": "subtitle", "time": 12506.87, "timestamp": "03:28:26", "text": "别以为我不会是"}, {"type": "subtitle", "time": 12512.79, "timestamp": "03:28:32", "text": "事情就是这样，没什么大不了的。"}, {"type": "subtitle", "time": 12514.71, "timestamp": "03:28:34", "text": "反正都要被剪掉。前辈的"}, {"type": "subtitle", "time": 12519.59, "timestamp": "03:28:39", "text": "前辈能保守一两个秘密。是的。"}, {"type": "subtitle", "time": 12521.59, "timestamp": "03:28:41", "text": "嗯。"}, {"type": "subtitle", "time": 12525.19, "timestamp": "03:28:45", "text": "关于我也喜欢我听说的关于我也喜欢的东西"}, {"type": "subtitle", "time": 12528.55, "timestamp": "03:28:48", "text": "关于你梦到的新事物"}, {"type": "subtitle", "time": 12531.51, "timestamp": "03:28:51", "text": "公司之类的，还有你唱歌的事。"}, {"type": "subtitle", "time": 12534.469, "timestamp": "03:28:54", "text": "它让我喜欢它，它让我"}, {"type": "subtitle", "time": 12536.469, "timestamp": "03:28:56", "text": "有动机"}, {"type": "subtitle", "time": 12538.309, "timestamp": "03:28:58", "text": "我很积极，但我也不积极。"}, {"type": "subtitle", "time": 12539.83, "timestamp": "03:28:59", "text": "知道该如何利用这种动力"}]
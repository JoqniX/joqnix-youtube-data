[{"type": "subtitle", "time": 6180.31, "timestamp": "01:43:00", "text": "我们走吧。明白了。"}, {"type": "subtitle", "time": 6185.35, "timestamp": "01:43:05", "text": "哦，我要去当个野兽"}, {"type": "subtitle", "time": 6207.03, "timestamp": "01:43:27", "text": "但是，是啊，它太卡顿了，而且……"}, {"type": "subtitle", "time": 6209.99, "timestamp": "01:43:29", "text": "是。是的。你好，菲尔。你好吗"}, {"type": "subtitle", "time": 6211.83, "timestamp": "01:43:31", "text": "正在做？"}, {"type": "subtitle", "time": 6225.43, "timestamp": "01:43:45", "text": "好的，这很酷。"}]
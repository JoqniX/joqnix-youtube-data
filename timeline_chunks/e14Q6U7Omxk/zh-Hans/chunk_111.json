[{"type": "subtitle", "time": 6661.35, "timestamp": "01:51:01", "text": "我又得转动风扇，然后把它放好。"}, {"type": "subtitle", "time": 6665.109, "timestamp": "01:51:05", "text": "风扇转速达到100%了吗？"}, {"type": "subtitle", "time": 6667.43, "timestamp": "01:51:07", "text": "我自己转动风扇，让它转起来。"}, {"type": "subtitle", "time": 6670.55, "timestamp": "01:51:10", "text": "是啊，显卡真是太让人头疼了。所以，我认为"}, {"type": "subtitle", "time": 6674.95, "timestamp": "01:51:14", "text": "我暂时还是玩一些轻松的游戏吧。"}, {"type": "subtitle", "time": 6676.709, "timestamp": "01:51:16", "text": "说到比较轻松的游戏，有没有呢？"}, {"type": "subtitle", "time": 6685.189, "timestamp": "01:51:25", "text": "嗯，是的。空夜跳跃王是"}, {"type": "subtitle", "time": 6689.669, "timestamp": "01:51:29", "text": "克服这件事。还有什么？"}, {"type": "subtitle", "time": 6691.51, "timestamp": "01:51:31", "text": "仔细想想，我一直在玩"}, {"type": "subtitle", "time": 6695.669, "timestamp": "01:51:35", "text": "一直以来，这些游戏都非常消耗CPU资源"}, {"type": "subtitle", "time": 6699.03, "timestamp": "01:51:39", "text": "比如 Apex Rand。顺便说一句，它很轻。"}, {"type": "subtitle", "time": 6701.03, "timestamp": "01:51:41", "text": "但是，再说一遍，"}, {"type": "subtitle", "time": 6703.589, "timestamp": "01:51:43", "text": "它缺少很多东西。"}, {"type": "subtitle", "time": 6718.79, "timestamp": "01:51:58", "text": "打火机也变得超级……"}]
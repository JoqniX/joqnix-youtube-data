[{"type": "subtitle", "time": 4860.47, "timestamp": "01:21:00", "text": "升级很难，但话说回来，这很难……"}, {"type": "subtitle", "time": 4863.189, "timestamp": "01:21:03", "text": "不过，还是要升级。就像有很多个一样"}, {"type": "subtitle", "time": 4865.99, "timestamp": "01:21:05", "text": "这里面的东西。我喜欢这个事实"}, {"type": "subtitle", "time": 4869.03, "timestamp": "01:21:09", "text": "我要走了，我得删掉它。"}, {"type": "subtitle", "time": 4872.47, "timestamp": "01:21:12", "text": "这完全是因为现实生活"}, {"type": "subtitle", "time": 4876.709, "timestamp": "01:21:16", "text": "验证过程，我当时就想："}, {"type": "subtitle", "time": 4880.709, "timestamp": "01:21:20", "text": "我不想知道那是什么。"}, {"type": "subtitle", "time": 4882.55, "timestamp": "01:21:22", "text": "一"}, {"type": "subtitle", "time": 4890.63, "timestamp": "01:21:30", "text": "可以说，有点像独立音乐人。"}, {"type": "subtitle", "time": 4893.43, "timestamp": "01:21:33", "text": "我不知道"}, {"type": "subtitle", "time": 4895.43, "timestamp": "01:21:35", "text": "它说所有党员都拥有什么？"}, {"type": "subtitle", "time": 4897.75, "timestamp": "01:21:37", "text": "达到20级？"}, {"type": "subtitle", "time": 4899.99, "timestamp": "01:21:39", "text": "嗯？"}, {"type": "subtitle", "time": 4902.55, "timestamp": "01:21:42", "text": "好的。在我们开始游戏之前，我需要"}, {"type": "subtitle", "time": 4904.39, "timestamp": "01:21:44", "text": "确保我的风扇在转动。嗯？"}, {"type": "subtitle", "time": 4909.99, "timestamp": "01:21:49", "text": "我如何确保我的风扇可以……"}, {"type": "subtitle", "time": 4912.55, "timestamp": "01:21:52", "text": "旋转？"}, {"type": "subtitle", "time": 4915.11, "timestamp": "01:21:55", "text": "我可以吗？"}]
[{"type": "subtitle", "time": 8401.19, "timestamp": "02:20:01", "text": "很正常。我当时正在退房。"}, {"type": "subtitle", "time": 8407.19, "timestamp": "02:20:07", "text": "现在才是真正的。好的。这是"}, {"type": "subtitle", "time": 8412.309, "timestamp": "02:20:12", "text": "经哈佛教授测试。好的。所以"}, {"type": "subtitle", "time": 8415.429, "timestamp": "02:20:15", "text": "现在是一道选择题。为了"}, {"type": "subtitle", "time": 8417.99, "timestamp": "02:20:17", "text": "这个，你得自己想象。"}, {"type": "subtitle", "time": 8421.59, "timestamp": "02:20:21", "text": "好的。你身处森林之中。非常黑。我"}, {"type": "subtitle", "time": 8423.51, "timestamp": "02:20:23", "text": "我不知道。你身处森林之中。它是"}, {"type": "subtitle", "time": 8425.27, "timestamp": "02:20:25", "text": "非常黑。你正在穿过"}, {"type": "subtitle", "time": 8427.59, "timestamp": "02:20:27", "text": "森林深处，你感觉有什么东西在后面。"}, {"type": "subtitle", "time": 8430.63, "timestamp": "02:20:30", "text": "你的背部。"}, {"type": "subtitle", "time": 8433.99, "timestamp": "02:20:33", "text": "你感觉背后有什么东西在动，"}, {"type": "subtitle", "time": 8436.309, "timestamp": "02:20:36", "text": "你以最快的速度转身。"}, {"type": "subtitle", "time": 8438.309, "timestamp": "02:20:38", "text": "好的。你只需以最快的速度转弯即可"}, {"type": "subtitle", "time": 8441.19, "timestamp": "02:20:41", "text": "能。你看到了什么？"}, {"type": "subtitle", "time": 8447.03, "timestamp": "02:20:47", "text": "异性。 B. 无。 C. A"}, {"type": "subtitle", "time": 8448.469, "timestamp": "02:20:48", "text": "鬼。"}, {"type": "subtitle", "time": 8453.83, "timestamp": "02:20:53", "text": "E 是野生动物，E 是狗。"}]
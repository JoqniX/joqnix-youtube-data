[{"type": "subtitle", "time": 11341.99, "timestamp": "03:09:01", "text": "事情就这样解决了。我大概有10万块"}, {"type": "subtitle", "time": 11343.99, "timestamp": "03:09:03", "text": "对此的看法。我还有它。它是"}, {"type": "subtitle", "time": 11346.79, "timestamp": "03:09:06", "text": "因版权侵权而死亡。"}, {"type": "subtitle", "time": 11349.19, "timestamp": "03:09:09", "text": "我不得不删掉大约10个视频，"}, {"type": "subtitle", "time": 11352.15, "timestamp": "03:09:12", "text": "频道停播了。但我真的非常自豪"}, {"type": "subtitle", "time": 11355.429, "timestamp": "03:09:15", "text": "它的。我从中学到了很多东西。"}, {"type": "subtitle", "time": 11358.15, "timestamp": "03:09:18", "text": "嗯。这就是为什么我知道很多"}, {"type": "subtitle", "time": 11360.23, "timestamp": "03:09:20", "text": "比如缩略图制作、编辑等等"}, {"type": "subtitle", "time": 11361.99, "timestamp": "03:09:21", "text": "所有这些。我可以就此给你一些建议。"}, {"type": "subtitle", "time": 11364.55, "timestamp": "03:09:24", "text": "诸如此类的事情，不过，嗯，是的，我挺……"}, {"type": "subtitle", "time": 11366.95, "timestamp": "03:09:26", "text": "新的管材。所以，你是我的前辈。"}, {"type": "subtitle", "time": 11369.99, "timestamp": "03:09:29", "text": "关于那方面。"}, {"type": "subtitle", "time": 11371.59, "timestamp": "03:09:31", "text": "你好。"}, {"type": "subtitle", "time": 11374.389, "timestamp": "03:09:34", "text": "是的。那么，跟我说说你的情况吧。"}, {"type": "subtitle", "time": 11377.91, "timestamp": "03:09:37", "text": "经历。我真的很想知道"}, {"type": "subtitle", "time": 11383.11, "timestamp": "03:09:43", "text": "经历中形成。"}, {"type": "subtitle", "time": 11386.63, "timestamp": "03:09:46", "text": "所以，首先，我会……"}, {"type": "subtitle", "time": 11388.309, "timestamp": "03:09:48", "text": "我很想知道你是如何进入这个行业的。"}, {"type": "subtitle", "time": 11391.269, "timestamp": "03:09:51", "text": "虚拟主播之类的东西，你知道的，因为"}, {"type": "subtitle", "time": 11393.03, "timestamp": "03:09:53", "text": "我很高兴知道我知道这一点。"}, {"type": "subtitle", "time": 11394.95, "timestamp": "03:09:54", "text": "比如你做这个做那个之类的事情"}, {"type": "subtitle", "time": 11396.63, "timestamp": "03:09:56", "text": "我知道你付出了很多努力。"}]
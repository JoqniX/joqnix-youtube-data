[{"type": "subtitle", "time": 10562.87, "timestamp": "02:56:02", "text": "旁遮普语在印地语中并不那么常见，因为你"}, {"type": "subtitle", "time": 10564.469, "timestamp": "02:56:04", "text": "知道那些词，那些可怕的词，那些大的词。"}, {"type": "subtitle", "time": 10569.67, "timestamp": "02:56:09", "text": "我不认识的，嗯，我明白"}, {"type": "subtitle", "time": 10573.11, "timestamp": "02:56:13", "text": "哈拉米，你知道哈尼吗？我想我"}, {"type": "subtitle", "time": 10576.07, "timestamp": "02:56:16", "text": "听说过，是啊，是啊"}, {"type": "subtitle", "time": 10578.87, "timestamp": "02:56:18", "text": "我能理解。呃，我不能"}, {"type": "subtitle", "time": 10581.99, "timestamp": "02:56:21", "text": "说出来。我听得懂，也能说。"}, {"type": "subtitle", "time": 10584.55, "timestamp": "02:56:24", "text": "拉贾斯坦邦的。"}, {"type": "subtitle", "time": 10586.87, "timestamp": "02:56:26", "text": "嗯，大概就这些了。我在想"}, {"type": "subtitle", "time": 10590.23, "timestamp": "02:56:30", "text": "学习日语，但我看到了"}, {"type": "subtitle", "time": 10593.429, "timestamp": "02:56:33", "text": "把你的课程大纲塞到一边，我当时就想：算了。"}, {"type": "subtitle", "time": 10595.75, "timestamp": "02:56:35", "text": "我不会那样做。"}, {"type": "subtitle", "time": 10597.59, "timestamp": "02:56:37", "text": "我那时也顺便学了梵语。"}, {"type": "subtitle", "time": 10607.19, "timestamp": "02:56:47", "text": "真好玩啊。这很有趣，就像成为……"}, {"type": "subtitle", "time": 10609.269, "timestamp": "02:56:49", "text": "背景之类的，比如我有"}, {"type": "subtitle", "time": 10611.19, "timestamp": "02:56:51", "text": "背景大概来自拉贾斯坦邦之类的"}, {"type": "subtitle", "time": 10613.269, "timestamp": "02:56:53", "text": "你知道，所以我得理解"}, {"type": "subtitle", "time": 10614.79, "timestamp": "02:56:54", "text": "那些东西，还有背景"}, {"type": "subtitle", "time": 10618.87, "timestamp": "02:56:58", "text": "Hana，或者抱歉，不是 Hana Himachel，我明白了。"}]
[{"type": "subtitle", "time": 12240.15, "timestamp": "03:24:00", "text": "人们可以从我的 Twitch 或其他地方剪辑视频"}, {"type": "subtitle", "time": 12242.63, "timestamp": "03:24:02", "text": "YouTube。呃，现在YouTube上有一段剪辑视频。"}, {"type": "subtitle", "time": 12245.03, "timestamp": "03:24:05", "text": "特征。所以我就从那里上传了那些东西。"}, {"type": "subtitle", "time": 12248.15, "timestamp": "03:24:08", "text": "剪辑到 YouTube 镜头、真实和"}, {"type": "subtitle", "time": 12251.75, "timestamp": "03:24:11", "text": "一切，还有那给了我什么"}, {"type": "subtitle", "time": 12254.309, "timestamp": "03:24:14", "text": "我很有信心，觉得没问题。这是一个"}, {"type": "subtitle", "time": 12257.349, "timestamp": "03:24:17", "text": "这很难做到，因为去年有很多"}, {"type": "subtitle", "time": 12259.349, "timestamp": "03:24:19", "text": "多年来，一直有人来我的小溪边看我直播"}, {"type": "subtitle", "time": 12261.91, "timestamp": "03:24:21", "text": "甚至朋友，嗯，他们就像……"}, {"type": "subtitle", "time": 12264.389, "timestamp": "03:24:24", "text": "就像运动员上传照片一样，这很好。"}, {"type": "subtitle", "time": 12266.469, "timestamp": "03:24:26", "text": "让你的频道获得推广和"}, {"type": "subtitle", "time": 12268.95, "timestamp": "03:24:28", "text": "所有的一切，而我却想，不，我想做"}, {"type": "subtitle", "time": 12270.79, "timestamp": "03:24:30", "text": "我原本就喜欢这种风格。我不想"}, {"type": "subtitle", "time": 12273.91, "timestamp": "03:24:33", "text": "发布视频片段之类的东西。那也是我"}, {"type": "subtitle", "time": 12277.03, "timestamp": "03:24:37", "text": "一点都不好笑。我有这种自我强势"}, {"type": "subtitle", "time": 12280.15, "timestamp": "03:24:40", "text": "这种冒名顶替综合症和自我批评"}, {"type": "subtitle", "time": 12282.87, "timestamp": "03:24:42", "text": "我也太爱自己了。是的，我注意到了"}, {"type": "subtitle", "time": 12286.15, "timestamp": "03:24:46", "text": "那。我很久以前就注意到这一点了。"}, {"type": "subtitle", "time": 12287.99, "timestamp": "03:24:47", "text": "即使你有很多好东西"}, {"type": "subtitle", "time": 12290.07, "timestamp": "03:24:50", "text": "内容丰富，让你玩得开心，玩游戏，"}, {"type": "subtitle", "time": 12292.95, "timestamp": "03:24:52", "text": "你背负着人，你不付出"}, {"type": "subtitle", "time": 12295.99, "timestamp": "03:24:55", "text": "足够自律，就像信用一样。我有"}, {"type": "subtitle", "time": 12299.03, "timestamp": "03:24:59", "text": "我以前就注意到过这种情况。"}]
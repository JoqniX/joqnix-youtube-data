[{"type": "subtitle", "time": 12002.07, "timestamp": "03:20:02", "text": "信息？嗯，当然可以。呃，你好"}, {"type": "subtitle", "time": 12005.429, "timestamp": "03:20:05", "text": "我的运动护颈。所以我正在做这件事"}, {"type": "subtitle", "time": 12010.87, "timestamp": "03:20:10", "text": "为了参加运动马拉松，他……嗯……是他"}, {"type": "subtitle", "time": 12014.469, "timestamp": "03:20:14", "text": "孟加拉人？不，我不是。我有"}, {"type": "subtitle", "time": 12017.03, "timestamp": "03:20:17", "text": "孟加拉国的朋友们。他们说孟加拉语。"}, {"type": "subtitle", "time": 12020.389, "timestamp": "03:20:20", "text": "我不明白这是什么。是的"}, {"type": "subtitle", "time": 12025.349, "timestamp": "03:20:25", "text": "嗯，Joathon 活动是……"}, {"type": "subtitle", "time": 12027.429, "timestamp": "03:20:27", "text": "更像是一个频道活动，我称之为"}, {"type": "subtitle", "time": 12029.83, "timestamp": "03:20:29", "text": "为了我的东西。它更像是一个"}, {"type": "subtitle", "time": 12032.389, "timestamp": "03:20:32", "text": "安息日马拉松、捐赠活动或马拉松。"}, {"type": "subtitle", "time": 12034.79, "timestamp": "03:20:34", "text": "你可能听说过这三个术语。"}, {"type": "subtitle", "time": 12037.269, "timestamp": "03:20:37", "text": "如果你在 Twitch 上看直播，或者也许"}, {"type": "subtitle", "time": 12039.19, "timestamp": "03:20:39", "text": "有时你可以看到这种做法"}, {"type": "subtitle", "time": 12042.229, "timestamp": "03:20:42", "text": "YouTube也是如此。所以还是那三样东西。"}, {"type": "subtitle", "time": 12046.07, "timestamp": "03:20:46", "text": "它们都在我的活动 Chathon 中完成。我"}, {"type": "subtitle", "time": 12048.229, "timestamp": "03:20:48", "text": "只是想让它独一无二，呃，就像我的"}, {"type": "subtitle", "time": 12050.79, "timestamp": "03:20:50", "text": "把名字加进去。所以乔森。"}, {"type": "subtitle", "time": 12053.59, "timestamp": "03:20:53", "text": "所以这是一个我参加的活动……"}, {"type": "subtitle", "time": 12055.349, "timestamp": "03:20:55", "text": "众筹"}, {"type": "subtitle", "time": 12057.99, "timestamp": "03:20:57", "text": "呃，这是我模型里的东西。我有一个虚拟主播（VTuber）。"}]
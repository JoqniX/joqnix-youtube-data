[{"type": "subtitle", "time": 8523.27, "timestamp": "02:22:03", "text": "呃，我不知道，也许是某个实体……呃"}, {"type": "subtitle", "time": 8526.87, "timestamp": "02:22:06", "text": "看起来像这样，呃，这是从你身后传来的吗？"}, {"type": "subtitle", "time": 8528.87, "timestamp": "02:22:08", "text": "然后瞬间消失了。所以它"}, {"type": "subtitle", "time": 8533.11, "timestamp": "02:22:13", "text": "不可能是鬼魂。可能是鬼魂。"}, {"type": "subtitle", "time": 8534.79, "timestamp": "02:22:14", "text": "嗯？好的。你的最终答案是什么？全部"}, {"type": "subtitle", "time": 8537.11, "timestamp": "02:22:17", "text": "正确的。哦，我得选一个给你"}, {"type": "subtitle", "time": 8539.59, "timestamp": "02:22:19", "text": "一。你必须自己做出选择。"}, {"type": "subtitle", "time": 8540.63, "timestamp": "02:22:20", "text": "好的。你必须选择你的"}, {"type": "subtitle", "time": 8542.23, "timestamp": "02:22:22", "text": "脉冲。你已身处其中。好的。我不是"}, {"type": "subtitle", "time": 8544.55, "timestamp": "02:22:24", "text": "那里。好的。我就像在寻找……"}, {"type": "subtitle", "time": 8550.87, "timestamp": "02:22:30", "text": "从天而降。我看到了，嗯。"}, {"type": "subtitle", "time": 8552.63, "timestamp": "02:22:32", "text": "呃"}, {"type": "subtitle", "time": 8557.11, "timestamp": "02:22:37", "text": "我想我还是选“走”吧。不，鬼魂是"}, {"type": "subtitle", "time": 8559.75, "timestamp": "02:22:39", "text": "不是真的。等等，这是幻想还是现实？"}, {"type": "subtitle", "time": 8562.71, "timestamp": "02:22:42", "text": "现实生活？好的。好的。我会选择“我会”。"}, {"type": "subtitle", "time": 8565.19, "timestamp": "02:22:45", "text": "和鬼魂一起走。美好的。"}, {"type": "subtitle", "time": 8568.07, "timestamp": "02:22:48", "text": "是的。这些都是正常答案。全部"}, {"type": "subtitle", "time": 8570.71, "timestamp": "02:22:50", "text": "正确的。所有答案都正常。这"}, {"type": "subtitle", "time": 8573.19, "timestamp": "02:22:53", "text": "异性行为正常。什么也没有"}, {"type": "subtitle", "time": 8575.349, "timestamp": "02:22:55", "text": "普通的。鬼魂很正常。野兽"}, {"type": "subtitle", "time": 8579.11, "timestamp": "02:22:59", "text": "一切正常。啊，它只是……唯一的"}]
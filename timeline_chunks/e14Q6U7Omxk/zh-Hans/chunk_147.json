[{"type": "subtitle", "time": 8823.75, "timestamp": "02:27:03", "text": "不要像他们感觉不到那样的感觉，呃"}, {"type": "subtitle", "time": 8825.67, "timestamp": "02:27:05", "text": "正常人所感受到的情感"}, {"type": "subtitle", "time": 8827.59, "timestamp": "02:27:07", "text": "正确的？"}, {"type": "subtitle", "time": 8829.51, "timestamp": "02:27:09", "text": "就像精神病患者没​​有……"}, {"type": "subtitle", "time": 8832.07, "timestamp": "02:27:12", "text": "有意识地，或者像他们在暗中爆炸一样"}, {"type": "subtitle", "time": 8835.83, "timestamp": "02:27:15", "text": "压力很大，对吧？就像他们一样，他们会"}, {"type": "subtitle", "time": 8838.469, "timestamp": "02:27:18", "text": "利用人脉关系，对吧？他们是"}, {"type": "subtitle", "time": 8841.91, "timestamp": "02:27:21", "text": "比如操纵者之类的。"}, {"type": "subtitle", "time": 8843.59, "timestamp": "02:27:23", "text": "所以"}, {"type": "subtitle", "time": 8845.83, "timestamp": "02:27:25", "text": "他们和反社会人格者都很快"}, {"type": "subtitle", "time": 8848.389, "timestamp": "02:27:28", "text": "愤怒往往就像他们知道的那样"}, {"type": "subtitle", "time": 8850.469, "timestamp": "02:27:30", "text": "他们的东西。反社会人格者知道他们的"}, {"type": "subtitle", "time": 8852.55, "timestamp": "02:27:32", "text": "东西。他们懂得如何处理情绪"}, {"type": "subtitle", "time": 8855.03, "timestamp": "02:27:35", "text": "还有其他一些东西。你知道那部动漫吗？我不"}, {"type": "subtitle", "time": 8858.07, "timestamp": "02:27:38", "text": "还记得那一个吗？"}, {"type": "subtitle", "time": 8860.389, "timestamp": "02:27:40", "text": "那是什么黄头发？我不"}, {"type": "subtitle", "time": 8863.51, "timestamp": "02:27:43", "text": "还记得那部动画片吗？"}, {"type": "subtitle", "time": 8866.23, "timestamp": "02:27:46", "text": "就像离子炮一样，对吧？如果我开始"}, {"type": "subtitle", "time": 8873.429, "timestamp": "02:27:53", "text": "我不知道你是否了解。"}, {"type": "subtitle", "time": 8875.03, "timestamp": "02:27:55", "text": "是的。是的。这是最简单的"}, {"type": "subtitle", "time": 8877.349, "timestamp": "02:27:57", "text": "我可以给出的解释。"}]
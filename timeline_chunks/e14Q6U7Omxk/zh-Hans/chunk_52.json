[{"type": "subtitle", "time": 3120.87, "timestamp": "00:52:00", "text": "信息和可爱温馨的信息"}, {"type": "subtitle", "time": 3123.829, "timestamp": "00:52:03", "text": "他们也会有一个可爱的好东西"}, {"type": "subtitle", "time": 3127.03, "timestamp": "00:52:07", "text": "你知道的时间"}, {"type": "subtitle", "time": 3131.349, "timestamp": "00:52:11", "text": "嘿，祝你旅途一切顺利！"}, {"type": "subtitle", "time": 3132.95, "timestamp": "00:52:12", "text": "前方"}, {"type": "subtitle", "time": 3135.589, "timestamp": "00:52:15", "text": "呃，接下来的时间里，你的旅程……"}, {"type": "subtitle", "time": 3138.23, "timestamp": "00:52:18", "text": "夜晚、傍晚、清晨，无论是什么时间"}, {"type": "subtitle", "time": 3144.39, "timestamp": "00:52:24", "text": "接下来我们将进入结尾部分。"}, {"type": "subtitle", "time": 3150.15, "timestamp": "00:52:30", "text": "所以"}, {"type": "subtitle", "time": 3160.15, "timestamp": "00:52:40", "text": "你们每个人都值得拥有这一切。"}, {"type": "subtitle", "time": 3162.549, "timestamp": "00:52:42", "text": "温暖的头垫。"}, {"type": "subtitle", "time": 3164.549, "timestamp": "00:52:44", "text": "感谢你的辛勤工作和所有付出。"}, {"type": "subtitle", "time": 3168.39, "timestamp": "00:52:48", "text": "我们今天做的事情。"}, {"type": "subtitle", "time": 3170.79, "timestamp": "00:52:50", "text": "所以，保重。现在要保重"}, {"type": "subtitle", "time": 3174.549, "timestamp": "00:52:54", "text": "每个人。话虽如此，这只是个玩笑。"}]
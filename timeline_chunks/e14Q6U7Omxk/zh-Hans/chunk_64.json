[{"type": "subtitle", "time": 3841.91, "timestamp": "01:04:01", "text": "而且很糟糕。但是，我也觉得"}, {"type": "subtitle", "time": 3843.829, "timestamp": "01:04:03", "text": "如果我能找到人，我可能会喜欢"}, {"type": "subtitle", "time": 3846.63, "timestamp": "01:04:06", "text": "签订保密协议之类的东西"}, {"type": "subtitle", "time": 3848.87, "timestamp": "01:04:08", "text": "比如采取一些行动。但"}, {"type": "subtitle", "time": 3850.95, "timestamp": "01:04:10", "text": "我显然联系了客服，"}, {"type": "subtitle", "time": 3853.589, "timestamp": "01:04:13", "text": "涂抹或清洗颜料，但要用完"}, {"type": "subtitle", "time": 3856.069, "timestamp": "01:04:16", "text": "翻译之类的。但显然我的"}, {"type": "subtitle", "time": 3858.63, "timestamp": "01:04:18", "text": "唯一的选择是"}, {"type": "subtitle", "time": 3861.349, "timestamp": "01:04:21", "text": "希望他们至少能够做到。"}, {"type": "subtitle", "time": 3864.15, "timestamp": "01:04:24", "text": "删除它或将其更改为其他内容"}, {"type": "subtitle", "time": 3866.63, "timestamp": "01:04:26", "text": "如果我持有有效的中国身份证"}, {"type": "subtitle", "time": 3868.87, "timestamp": "01:04:28", "text": "我必须删除某人或某事。"}, {"type": "subtitle", "time": 3871.51, "timestamp": "01:04:31", "text": "我的账户将被注销，这意味着我会损失"}, {"type": "subtitle", "time": 3875.19, "timestamp": "01:04:35", "text": "我所有的呃，喜欢呃，粉丝或者喜欢没有"}, {"type": "subtitle", "time": 3877.829, "timestamp": "01:04:37", "text": "关注者并认为这就像粉丝一样，"}, {"type": "subtitle", "time": 3880.069, "timestamp": "01:04:40", "text": "正确的？是的。是的。关注者是你的"}, {"type": "subtitle", "time": 3882.23, "timestamp": "01:04:42", "text": "订阅。是的。是的。致其他"}, {"type": "subtitle", "time": 3884.309, "timestamp": "01:04:44", "text": "频道。是的。所以我会失去一切"}, {"type": "subtitle", "time": 3888.39, "timestamp": "01:04:48", "text": "还有所有关于我的视频"}, {"type": "subtitle", "time": 3891.91, "timestamp": "01:04:51", "text": "已尝试并上传到那边。甚至"}, {"type": "subtitle", "time": 3893.91, "timestamp": "01:04:53", "text": "虽然这对我来说并不算什么。"}, {"type": "subtitle", "time": 3896.87, "timestamp": "01:04:56", "text": "频道，但我仍然喜欢我写的东西"}, {"type": "subtitle", "time": 3899.109, "timestamp": "01:04:59", "text": "详细说明法律方面的内容等等。"}]
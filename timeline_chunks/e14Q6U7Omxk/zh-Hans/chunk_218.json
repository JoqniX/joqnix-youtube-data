[{"type": "subtitle", "time": 13080.79, "timestamp": "03:38:00", "text": "印地语很正常，你会听到我说话。"}, {"type": "subtitle", "time": 13083.67, "timestamp": "03:38:03", "text": "有时用花火语或抱歉语说话"}, {"type": "subtitle", "time": 13086.07, "timestamp": "03:38:06", "text": "希玛，或者你会听到我说话"}, {"type": "subtitle", "time": 13090.07, "timestamp": "03:38:10", "text": "旁遮普语。你会说几种语言？"}, {"type": "subtitle", "time": 13092.87, "timestamp": "03:38:12", "text": "我的天啊。哇。我不认识他们。我"}, {"type": "subtitle", "time": 13095.349, "timestamp": "03:38:15", "text": "你明白他们的意思。是的。它是"}, {"type": "subtitle", "time": 13099.91, "timestamp": "03:38:19", "text": "就是，呃，它，它，它就像"}, {"type": "subtitle", "time": 13102.79, "timestamp": "03:38:22", "text": "我有点文化偏见，因为……"}, {"type": "subtitle", "time": 13105.91, "timestamp": "03:38:25", "text": "因为我的家庭等等原因。所以他们的"}, {"type": "subtitle", "time": 13108.87, "timestamp": "03:38:28", "text": "背景加上他们的背景"}, {"type": "subtitle", "time": 13112.309, "timestamp": "03:38:32", "text": "背景。所以就像它变成了它一样。"}, {"type": "subtitle", "time": 13115.67, "timestamp": "03:38:35", "text": "就像这种疯狂的多元宇宙一样"}, {"type": "subtitle", "time": 13118.469, "timestamp": "03:38:38", "text": "你知道，有些事我甚至都没提过。"}, {"type": "subtitle", "time": 13120.71, "timestamp": "03:38:40", "text": "拉贾斯坦邦的东西，我可以……"}, {"type": "subtitle", "time": 13122.79, "timestamp": "03:38:42", "text": "了解拉贾斯坦邦"}, {"type": "subtitle", "time": 13125.51, "timestamp": "03:38:45", "text": "很容易，因为就像那些东西一样。"}, {"type": "subtitle", "time": 13127.99, "timestamp": "03:38:47", "text": "我的祖先中也有这样的人。"}, {"type": "subtitle", "time": 13131.67, "timestamp": "03:38:51", "text": "啊，是的，我是拉朱特，我想你会"}, {"type": "subtitle", "time": 13135.91, "timestamp": "03:38:55", "text": "明白了吗？拉贾特是一个城市国家"}, {"type": "subtitle", "time": 13139.67, "timestamp": "03:38:59", "text": "不，它在印度，好吧好吧，等等，不不不"}]
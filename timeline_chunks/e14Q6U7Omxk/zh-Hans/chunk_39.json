[{"type": "subtitle", "time": 2342.95, "timestamp": "00:39:02", "text": "还有，我也会确保聊天继续进行。"}, {"type": "subtitle", "time": 2346.55, "timestamp": "00:39:06", "text": "仅限英语"}, {"type": "subtitle", "time": 2349.67, "timestamp": "00:39:09", "text": "用日语是因为……大多数时候"}, {"type": "subtitle", "time": 2353.03, "timestamp": "00:39:13", "text": "如果我只是闲聊，我可以"}, {"type": "subtitle", "time": 2357.03, "timestamp": "00:39:17", "text": "立即复制并把它放上去"}, {"type": "subtitle", "time": 2360.23, "timestamp": "00:39:20", "text": "谷歌翻译播放，然后我就……呃"}, {"type": "subtitle", "time": 2363.03, "timestamp": "00:39:23", "text": "回复它。"}, {"type": "subtitle", "time": 2367.43, "timestamp": "00:39:27", "text": "虽然增加了一些工作量，但还是可以的。嗯"}, {"type": "subtitle", "time": 2370.39, "timestamp": "00:39:30", "text": "是的"}, {"type": "subtitle", "time": 2374.069, "timestamp": "00:39:34", "text": "但是，尽量不要说出来。"}, {"type": "subtitle", "time": 2378.15, "timestamp": "00:39:38", "text": "英语或冷静，这样不仅我，你"}, {"type": "subtitle", "time": 2380.55, "timestamp": "00:39:40", "text": "聊天中的其他人也能理解"}, {"type": "subtitle", "time": 2382.39, "timestamp": "00:39:42", "text": "尽管"}, {"type": "subtitle", "time": 2386.79, "timestamp": "00:39:46", "text": "或者，呃，人们可能会误解"}, {"type": "subtitle", "time": 2390.55, "timestamp": "00:39:50", "text": "嗯，是的，人们可以理解他们"}, {"type": "subtitle", "time": 2393.91, "timestamp": "00:39:53", "text": "如果他们不理解呃"}, {"type": "subtitle", "time": 2396.55, "timestamp": "00:39:56", "text": "语言或"}, {"type": "subtitle", "time": 2399.589, "timestamp": "00:39:59", "text": "他们喜欢他们会说“他是什么？”"}]
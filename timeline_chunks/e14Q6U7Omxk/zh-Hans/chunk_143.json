[{"type": "subtitle", "time": 8583.11, "timestamp": "02:23:03", "text": "精神病患者的答案是狗。"}, {"type": "subtitle", "time": 8587.349, "timestamp": "02:23:07", "text": "狗。为什么？是的。显然呃"}, {"type": "subtitle", "time": 8591.67, "timestamp": "02:23:11", "text": "精神病患者感受不到恐惧。"}, {"type": "subtitle", "time": 8593.59, "timestamp": "02:23:13", "text": "H 就像他们一样，他们并不相同"}, {"type": "subtitle", "time": 8596.71, "timestamp": "02:23:16", "text": "波长之类的东西。好的。所以"}, {"type": "subtitle", "time": 8599.429, "timestamp": "02:23:19", "text": "呃，就像你害怕的时候之类的，"}, {"type": "subtitle", "time": 8601.349, "timestamp": "02:23:21", "text": "你为什么会认为这里有条狗？"}, {"type": "subtitle", "time": 8604.309, "timestamp": "02:23:24", "text": "我那次失败了。"}, {"type": "subtitle", "time": 8607.27, "timestamp": "02:23:27", "text": "谢天谢地，因为显然在整个"}, {"type": "subtitle", "time": 8609.83, "timestamp": "02:23:29", "text": "呃，只有测验才能证实这一点。"}, {"type": "subtitle", "time": 8612.389, "timestamp": "02:23:32", "text": "你是精神病患者还是不是？嗯，不错"}, {"type": "subtitle", "time": 8616.07, "timestamp": "02:23:36", "text": "这是我们俩的事。总之，"}, {"type": "subtitle", "time": 8619.03, "timestamp": "02:23:39", "text": "我们拭目以待。嗯，最后一个问题。"}, {"type": "subtitle", "time": 8620.71, "timestamp": "02:23:40", "text": "然后我们就可以继续聊天了。"}, {"type": "subtitle", "time": 8623.67, "timestamp": "02:23:43", "text": "部分。好的。是的。好的。所以，"}, {"type": "subtitle", "time": 8626.07, "timestamp": "02:23:46", "text": "仔细听。如果你答对了，"}, {"type": "subtitle", "time": 8629.75, "timestamp": "02:23:49", "text": "呃，我们不能做朋友。好的。所以这"}, {"type": "subtitle", "time": 8633.11, "timestamp": "02:23:53", "text": "凶手决定刺伤另一名男子，"}, {"type": "subtitle", "time": 8636.309, "timestamp": "02:23:56", "text": "他捅了他五刀，然后就像"}, {"type": "subtitle", "time": 8638.389, "timestamp": "02:23:58", "text": "他是在商场里，对吧？他在一家购物中心。"}]
[{"type": "subtitle", "time": 4501.75, "timestamp": "01:15:01", "text": "发现像少数几个了解情况的人"}, {"type": "subtitle", "time": 4508.39, "timestamp": "01:15:08", "text": "它就像真正的美国公民"}, {"type": "subtitle", "time": 4511.43, "timestamp": "01:15:11", "text": "或者像那些说英语的人一样"}, {"type": "subtitle", "time": 4513.83, "timestamp": "01:15:13", "text": "那边有人在尖叫。算是见过几个"}, {"type": "subtitle", "time": 4516.47, "timestamp": "01:15:16", "text": "他们"}, {"type": "subtitle", "time": 4519.189, "timestamp": "01:15:19", "text": "和他们一起之类的。他们都有"}, {"type": "subtitle", "time": 4520.87, "timestamp": "01:15:20", "text": "某人"}, {"type": "subtitle", "time": 4523.75, "timestamp": "01:15:23", "text": "一位中国朋友。哦，主要是他们知道"}, {"type": "subtitle", "time": 4525.59, "timestamp": "01:15:25", "text": "中国人。"}, {"type": "subtitle", "time": 4528.87, "timestamp": "01:15:28", "text": "他们是亚洲人什么的。"}, {"type": "subtitle", "time": 4538.55, "timestamp": "01:15:38", "text": "我当时就想，我该怎么才能找到一个中国人呢？"}, {"type": "subtitle", "time": 4541.83, "timestamp": "01:15:41", "text": "一个可以信任我的朋友，可以把这件事告诉我"}, {"type": "subtitle", "time": 4543.99, "timestamp": "01:15:43", "text": "比如个人信息之类的？"}, {"type": "subtitle", "time": 4549.03, "timestamp": "01:15:49", "text": "无论哪种方式，都需要拟定一份保密协议。"}, {"type": "subtitle", "time": 4551.35, "timestamp": "01:15:51", "text": "以便"}, {"type": "subtitle", "time": 4554.55, "timestamp": "01:15:54", "text": "我呃，所以它就像一个或者主要是"}, {"type": "subtitle", "time": 4558.07, "timestamp": "01:15:58", "text": "就像按下按钮一样，如果它是……如果它是……"}]
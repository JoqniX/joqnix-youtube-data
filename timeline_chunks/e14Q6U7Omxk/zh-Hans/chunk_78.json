[{"type": "subtitle", "time": 4697.35, "timestamp": "01:18:17", "text": "我死了。它运行缓慢。比赛是"}, {"type": "subtitle", "time": 4700.47, "timestamp": "01:18:20", "text": "超级卡顿。我的天啊。"}, {"type": "subtitle", "time": 4705.08, "timestamp": "01:18:25", "text": "但我们确实取得了一些成果。"}, {"type": "subtitle", "time": 4712.63, "timestamp": "01:18:32", "text": "嗯，这确实是个大难题。我希望"}, {"type": "subtitle", "time": 4714.149, "timestamp": "01:18:34", "text": "一切最终都会对你有利。"}, {"type": "subtitle", "time": 4717.11, "timestamp": "01:18:37", "text": "是的，我希望一切顺利。"}, {"type": "subtitle", "time": 4720.55, "timestamp": "01:18:40", "text": "我希望一切都能像……一样发展。"}, {"type": "subtitle", "time": 4728.47, "timestamp": "01:18:48", "text": "而事实上，我最近一直……"}, {"type": "subtitle", "time": 4731.669, "timestamp": "01:18:51", "text": "我真是太……"}, {"type": "subtitle", "time": 4734.55, "timestamp": "01:18:54", "text": "它叫什么？"}, {"type": "subtitle", "time": 4738.07, "timestamp": "01:18:58", "text": "最近我一直都……"}]
[{"type": "subtitle", "time": 9181.349, "timestamp": "02:33:01", "text": "那曾是一种潮流。你知道那些呃"}, {"type": "subtitle", "time": 9184.79, "timestamp": "02:33:04", "text": "视频里，呃，它会给你带来类似这样的感觉"}, {"type": "subtitle", "time": 9187.83, "timestamp": "02:33:07", "text": "关于瑞恩·高斯林的奇闻轶事，我觉得"}, {"type": "subtitle", "time": 9190.79, "timestamp": "02:33:10", "text": "他的名字是马文。我会说像"}, {"type": "subtitle", "time": 9194.389, "timestamp": "02:33:14", "text": "呃，如果你是由……组成的，比如如果你吃"}, {"type": "subtitle", "time": 9196.79, "timestamp": "02:33:16", "text": "比如，如果你体重99磅，你吃了……"}, {"type": "subtitle", "time": 9200.389, "timestamp": "02:33:20", "text": "一磅玉米片，你是1%的玉米片爱好者吗？"}, {"type": "subtitle", "time": 9202.55, "timestamp": "02:33:22", "text": "知道这类事情。人们喜欢它"}, {"type": "subtitle", "time": 9206.389, "timestamp": "02:33:26", "text": "原因不明。我不知道为什么。"}, {"type": "subtitle", "time": 9210.469, "timestamp": "02:33:30", "text": "他喜欢那种东西。"}, {"type": "subtitle", "time": 9212.63, "timestamp": "02:33:32", "text": "Instagram 上的用户喜欢所有这些表情包"}, {"type": "subtitle", "time": 9214.95, "timestamp": "02:33:34", "text": "东西什么的。真的真的"}, {"type": "subtitle", "time": 9217.59, "timestamp": "02:33:37", "text": "好的。是的，我想那是因为"}, {"type": "subtitle", "time": 9220.63, "timestamp": "02:33:40", "text": "他们好像想要那种钩子之类的东西。它"}, {"type": "subtitle", "time": 9222.469, "timestamp": "02:33:42", "text": "我已经有了钩子之类的东西，因为它"}, {"type": "subtitle", "time": 9224.71, "timestamp": "02:33:44", "text": "给你一个类似的东西，扔给你一个奇怪的事实"}, {"type": "subtitle", "time": 9227.83, "timestamp": "02:33:47", "text": "你高潮时脸上的表情。呃，我"}, {"type": "subtitle", "time": 9229.91, "timestamp": "02:33:49", "text": "我觉得这就是事情变得非常非常严重的原因。"}, {"type": "subtitle", "time": 9232.389, "timestamp": "02:33:52", "text": "曾经很出名，然后就销声匿迹了。"}, {"type": "subtitle", "time": 9235.349, "timestamp": "02:33:55", "text": "那一刻。呃，你知道现在呃，我"}, {"type": "subtitle", "time": 9238.55, "timestamp": "02:33:58", "text": "真的要密切关注第二次约会更新，比如"}]
[{"type": "subtitle", "time": 9121.83, "timestamp": "02:32:01", "text": "相当不错的游戏。我感到无聊了。 M 和"}, {"type": "subtitle", "time": 9128.79, "timestamp": "02:32:08", "text": "由此，嗯，我想，我想我当时"}, {"type": "subtitle", "time": 9131.83, "timestamp": "02:32:11", "text": "在你的服务器或其他什么地方"}, {"type": "subtitle", "time": 9135.83, "timestamp": "02:32:15", "text": "那是我唯一看到的说话方式。"}, {"type": "subtitle", "time": 9137.51, "timestamp": "02:32:17", "text": "我猜我不知道我有没有说过话。"}, {"type": "subtitle", "time": 9142.15, "timestamp": "02:32:22", "text": "没错，但我一直在潜水，嗯……"}, {"type": "subtitle", "time": 9144.389, "timestamp": "02:32:24", "text": "是啊，就像我当时有很多朋友"}, {"type": "subtitle", "time": 9148.07, "timestamp": "02:32:28", "text": "我在那张桌子上待了一段时间，我不记得具体时间了。对。"}, {"type": "subtitle", "time": 9150.469, "timestamp": "02:32:30", "text": "哦，是的。我在Instagram上做的那件事。"}, {"type": "subtitle", "time": 9153.19, "timestamp": "02:32:33", "text": "对，就是这个原因。是的，很多人"}, {"type": "subtitle", "time": 9155.51, "timestamp": "02:32:35", "text": "不知何故，我所做的就是"}, {"type": "subtitle", "time": 9158.07, "timestamp": "02:32:38", "text": "我做了一些实验。我当时想，"}, {"type": "subtitle", "time": 9160.87, "timestamp": "02:32:40", "text": "如果我只是随便看看 YouTube 内容呢？"}, {"type": "subtitle", "time": 9162.87, "timestamp": "02:32:42", "text": "发到我的Instagram账号上，而不是我的账号。全部"}, {"type": "subtitle", "time": 9165.51, "timestamp": "02:32:45", "text": "正确的。我把功劳都给了。呃，我"}, {"type": "subtitle", "time": 9168.15, "timestamp": "02:32:48", "text": "这样做了两个月。我得到了10万"}, {"type": "subtitle", "time": 9171.99, "timestamp": "02:32:51", "text": "两个月内获得粉丝。哦，是的。"}, {"type": "subtitle", "time": 9174.71, "timestamp": "02:32:54", "text": "它不到一周就死了。"}, {"type": "subtitle", "time": 9176.79, "timestamp": "02:32:56", "text": "如何？"}, {"type": "subtitle", "time": 9178.79, "timestamp": "02:32:58", "text": "我不知道。变得相当无聊"}]
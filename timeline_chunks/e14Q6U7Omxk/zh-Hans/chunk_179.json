[{"type": "subtitle", "time": 10759.349, "timestamp": "02:59:19", "text": "你看，我在这里。"}, {"type": "subtitle", "time": 10761.67, "timestamp": "02:59:21", "text": "欢迎回来。"}, {"type": "subtitle", "time": 10764.389, "timestamp": "02:59:24", "text": "好的。所以，呃，我首先想知道。"}, {"type": "subtitle", "time": 10766.87, "timestamp": "02:59:26", "text": "首先，你胆子真大。"}, {"type": "subtitle", "time": 10769.03, "timestamp": "02:59:29", "text": "开始做这些事就像面对拒绝一样"}, {"type": "subtitle", "time": 10771.19, "timestamp": "02:59:31", "text": "诸如此类，但我更想知道的是，如何"}, {"type": "subtitle", "time": 10773.67, "timestamp": "02:59:33", "text": "你把这个想法理解得如此透彻……"}, {"type": "subtitle", "time": 10776.23, "timestamp": "02:59:36", "text": "你知道，合作就像它是如何进行的。"}, {"type": "subtitle", "time": 10778.07, "timestamp": "02:59:38", "text": "你的想法？"}, {"type": "subtitle", "time": 10782.55, "timestamp": "02:59:42", "text": "哦，我当时就想，哦，嗯，我一开始"}, {"type": "subtitle", "time": 10786.309, "timestamp": "02:59:46", "text": "我希望Joathon只是关于我做的事情"}, {"type": "subtitle", "time": 10789.03, "timestamp": "02:59:49", "text": "东西什么的。然后我想，"}, {"type": "subtitle", "time": 10792.469, "timestamp": "02:59:52", "text": "嗯，哦，然后我意识到在一次短跑比赛中"}, {"type": "subtitle", "time": 10795.91, "timestamp": "02:59:55", "text": "你可以像在……一样开放访客功能。"}, {"type": "subtitle", "time": 10799.03, "timestamp": "02:59:59", "text": "比如说，如果我在睡觉，我可以允许"}]
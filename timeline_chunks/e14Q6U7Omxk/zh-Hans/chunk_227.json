[{"type": "subtitle", "time": 13621.03, "timestamp": "03:47:01", "text": "付清所有款项。他们所要做的"}, {"type": "subtitle", "time": 13623.99, "timestamp": "03:47:03", "text": "支付学费和"}, {"type": "subtitle", "time": 13627.67, "timestamp": "03:47:07", "text": "宿舍费。在 COE 之后"}, {"type": "subtitle", "time": 13631.51, "timestamp": "03:47:11", "text": "印度，但指挥官并没有直接来这里。"}, {"type": "subtitle", "time": 13634.55, "timestamp": "03:47:14", "text": "最后，嗯，没有人这么做。"}, {"type": "subtitle", "time": 13636.309, "timestamp": "03:47:16", "text": "将款项退回的交易"}, {"type": "subtitle", "time": 13639.429, "timestamp": "03:47:19", "text": "日本学校，也正因如此"}, {"type": "subtitle", "time": 13641.83, "timestamp": "03:47:21", "text": "呃呃，政治方面的事情等等"}, {"type": "subtitle", "time": 13645.429, "timestamp": "03:47:25", "text": "他们说，呃，移民人员"}, {"type": "subtitle", "time": 13649.59, "timestamp": "03:47:29", "text": "比如，不要把拥车证寄到这里。"}, {"type": "subtitle", "time": 13650.79, "timestamp": "03:47:30", "text": "我不知道发生了什么。"}, {"type": "subtitle", "time": 13652.63, "timestamp": "03:47:32", "text": "是的，确实发生过类似的事情。"}, {"type": "subtitle", "time": 13656.07, "timestamp": "03:47:36", "text": "真是糟透了。"}, {"type": "subtitle", "time": 13659.349, "timestamp": "03:47:39", "text": "是的，确实很疼。但实际上，它是"}, {"type": "subtitle", "time": 13662.309, "timestamp": "03:47:42", "text": "说实话，简直糟透了。"}, {"type": "subtitle", "time": 13664.389, "timestamp": "03:47:44", "text": "与你。但你从中获得了好处。你得到了"}, {"type": "subtitle", "time": 13666.79, "timestamp": "03:47:46", "text": "免费课程。这是件好事。那是"}, {"type": "subtitle", "time": 13668.229, "timestamp": "03:47:48", "text": "这是件好事。你还有一些时间"}, {"type": "subtitle", "time": 13670.389, "timestamp": "03:47:50", "text": "与新朋友一起。那也是个好消息。"}, {"type": "subtitle", "time": 13672.63, "timestamp": "03:47:52", "text": "事物。是的。你也获得了更多的时间。"}, {"type": "subtitle", "time": 13674.63, "timestamp": "03:47:54", "text": "你的家人。那也是件好事。"}, {"type": "subtitle", "time": 13676.95, "timestamp": "03:47:56", "text": "在你投入到一项非常活跃的工作之前"}]
[{"type": "subtitle", "time": 10681.67, "timestamp": "02:58:01", "text": "上传视频，其中一些已经开始"}, {"type": "subtitle", "time": 10685.19, "timestamp": "02:58:05", "text": "流媒体服务等等。"}, {"type": "subtitle", "time": 10687.91, "timestamp": "02:58:07", "text": "他们大多数人都会这样做。它就像……一样有趣"}, {"type": "subtitle", "time": 10690.55, "timestamp": "02:58:10", "text": "更像是吸收和给予。"}, {"type": "subtitle", "time": 10692.63, "timestamp": "02:58:12", "text": "向右后方，因为就像如果你拿走"}, {"type": "subtitle", "time": 10694.79, "timestamp": "02:58:14", "text": "你也在制作英文内容"}, {"type": "subtitle", "time": 10697.59, "timestamp": "02:58:17", "text": "也用英文写出来，因为你期望……"}, {"type": "subtitle", "time": 10700.309, "timestamp": "02:58:20", "text": "印度人观看你的直播时会知道这一点"}, {"type": "subtitle", "time": 10703.19, "timestamp": "02:58:23", "text": "动漫相关的东西，还有YouTube上的东西，然后"}, {"type": "subtitle", "time": 10706.23, "timestamp": "02:58:26", "text": "就像你会得到回报一样，我觉得。"}, {"type": "subtitle", "time": 10708.95, "timestamp": "02:58:28", "text": "我觉得那就是“给予”这个词。"}, {"type": "subtitle", "time": 10711.75, "timestamp": "02:58:31", "text": "然后拿走。是的。是的。我接到一个电话"}, {"type": "subtitle", "time": 10713.19, "timestamp": "02:58:33", "text": "我的母亲。稍等片刻。给我一个"}, {"type": "subtitle", "time": 10716.15, "timestamp": "02:58:36", "text": "第二节是的。是的。慢慢来。"}]
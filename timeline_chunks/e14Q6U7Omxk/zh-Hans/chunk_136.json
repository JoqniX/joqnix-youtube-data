[{"type": "subtitle", "time": 8160.709, "timestamp": "02:16:00", "text": "是的。是的。真的很好。哇。"}, {"type": "subtitle", "time": 8164.87, "timestamp": "02:16:04", "text": "继续前进。所以你又来了"}, {"type": "subtitle", "time": 8167.03, "timestamp": "02:16:07", "text": "你住在公寓里，你正在……"}, {"type": "subtitle", "time": 8169.99, "timestamp": "02:16:09", "text": "五楼。好的。"}, {"type": "subtitle", "time": 8173.109, "timestamp": "02:16:13", "text": "你晚上再去一次。你去一些"}, {"type": "subtitle", "time": 8176.629, "timestamp": "02:16:16", "text": "厨房附近有水，还有一个"}, {"type": "subtitle", "time": 8179.75, "timestamp": "02:16:19", "text": "这次是从那里的窗户看的。好的。现在"}, {"type": "subtitle", "time": 8182.47, "timestamp": "02:16:22", "text": "你不知何故看向右边。我"}, {"type": "subtitle", "time": 8184.55, "timestamp": "02:16:24", "text": "我不知道。你目睹一个男人"}, {"type": "subtitle", "time": 8188.229, "timestamp": "02:16:28", "text": "是在另一栋楼里被谋杀的，对吗？这"}, {"type": "subtitle", "time": 8191.35, "timestamp": "02:16:31", "text": "那人看见你了，看见你了，指着你"}, {"type": "subtitle", "time": 8194.709, "timestamp": "02:16:34", "text": "他指着你，又指着上下方。"}, {"type": "subtitle", "time": 8198.549, "timestamp": "02:16:38", "text": "几次之后，你都逃跑了。所以，"}, {"type": "subtitle", "time": 8200.95, "timestamp": "02:16:40", "text": "那里发生了什么事？为什么会这样？"}, {"type": "subtitle", "time": 8204.389, "timestamp": "02:16:44", "text": "向上和向下指？"}, {"type": "subtitle", "time": 8207.349, "timestamp": "02:16:47", "text": "嗯？向上和向下指。不是眼睛"}, {"type": "subtitle", "time": 8210.309, "timestamp": "02:16:50", "text": "方向上下，但指向"}, {"type": "subtitle", "time": 8212.79, "timestamp": "02:16:52", "text": "用手指上下点动。他"}, {"type": "subtitle", "time": 8216.23, "timestamp": "02:16:56", "text": "他指着你，然后他走了上去"}, {"type": "subtitle", "time": 8218.469, "timestamp": "02:16:58", "text": "向下 向上 向上 向下，然后你"}]
[{"type": "subtitle", "time": 5187.35, "timestamp": "01:26:27", "text": "哦，"}, {"type": "subtitle", "time": 5189.51, "timestamp": "01:26:29", "text": "我让它转起来了。我们走吧。我做到了"}, {"type": "subtitle", "time": 5192.149, "timestamp": "01:26:32", "text": "旋转。我让它转起来了。我让它转起来了。"}, {"type": "subtitle", "time": 5194.95, "timestamp": "01:26:34", "text": "等等，等等，等等，等等。我让它转起来了。"}, {"type": "subtitle", "time": 5197.43, "timestamp": "01:26:37", "text": "你能听到吗？我想让你们知道"}, {"type": "subtitle", "time": 5199.59, "timestamp": "01:26:39", "text": "听着。"}, {"type": "subtitle", "time": 5201.83, "timestamp": "01:26:41", "text": "我们成功了。"}, {"type": "subtitle", "time": 5206.95, "timestamp": "01:26:46", "text": "使其以 100% 的风扇速度旋转"}, {"type": "subtitle", "time": 5219.03, "timestamp": "01:26:59", "text": "那个小东西。别在意"}]
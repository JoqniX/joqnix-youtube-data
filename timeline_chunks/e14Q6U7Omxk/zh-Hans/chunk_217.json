[{"type": "subtitle", "time": 13020.229, "timestamp": "03:37:00", "text": "没关系。"}, {"type": "subtitle", "time": 13024.469, "timestamp": "03:37:04", "text": "呃，伙计，我平时不太说话。"}, {"type": "subtitle", "time": 13027.19, "timestamp": "03:37:07", "text": "英语，你知道，因为就像在工作中一样"}, {"type": "subtitle", "time": 13029.91, "timestamp": "03:37:09", "text": "我做的事情，我得用印地语说话。"}, {"type": "subtitle", "time": 13031.99, "timestamp": "03:37:11", "text": "所以，我得跟这些人谈谈。"}, {"type": "subtitle", "time": 13035.99, "timestamp": "03:37:15", "text": "有些人会说：“呃，我该怎么说呢？”"}, {"type": "subtitle", "time": 13038.95, "timestamp": "03:37:18", "text": "这样政治上正确吗？政治上。"}, {"type": "subtitle", "time": 13040.79, "timestamp": "03:37:20", "text": "哦，不。"}, {"type": "subtitle", "time": 13042.63, "timestamp": "03:37:22", "text": "让我想想。是这样的吗？"}, {"type": "subtitle", "time": 13044.389, "timestamp": "03:37:24", "text": "客户支持之类的东西"}, {"type": "subtitle", "time": 13049.19, "timestamp": "03:37:29", "text": "人们可能会生气，也可能保持中立，或者"}, {"type": "subtitle", "time": 13051.429, "timestamp": "03:37:31", "text": "就像我负责接待顾客一样"}, {"type": "subtitle", "time": 13054.71, "timestamp": "03:37:34", "text": "直接，但他们用什么方式，我应该怎么做？"}, {"type": "subtitle", "time": 13058.07, "timestamp": "03:37:38", "text": "说？哦，是的，我现在就可以这么说了。"}, {"type": "subtitle", "time": 13060.95, "timestamp": "03:37:40", "text": "他们说乌杜语很地道，而且很好听。"}, {"type": "subtitle", "time": 13066.309, "timestamp": "03:37:46", "text": "与印地语接近。所以如果我说印地语，你"}, {"type": "subtitle", "time": 13069.429, "timestamp": "03:37:49", "text": "你会听到我用四种不同的语言说话。"}, {"type": "subtitle", "time": 13071.19, "timestamp": "03:37:51", "text": "口音。"}, {"type": "subtitle", "time": 13074.15, "timestamp": "03:37:54", "text": "好的。当然。在某些方面"}, {"type": "subtitle", "time": 13077.19, "timestamp": "03:37:57", "text": "我用乌都语说的话就像是在说"}, {"type": "subtitle", "time": 13079.03, "timestamp": "03:37:59", "text": "我将用一些词语来表达，比如"}]
[{"type": "subtitle", "time": 9001.91, "timestamp": "02:30:01", "text": "上面以及所有的一切"}, {"type": "subtitle", "time": 9003.75, "timestamp": "02:30:03", "text": "就是这样。"}, {"type": "subtitle", "time": 9005.349, "timestamp": "02:30:05", "text": "你跟我说过日程安排。你有"}, {"type": "subtitle", "time": 9007.429, "timestamp": "02:30:07", "text": "长相不错的银行职员。这就是为什么……"}, {"type": "subtitle", "time": 9009.67, "timestamp": "02:30:09", "text": "首先，这就是我每次都会问的原因。"}, {"type": "subtitle", "time": 9011.51, "timestamp": "02:30:11", "text": "来直播间，我会像以前那样问。"}, {"type": "subtitle", "time": 9013.349, "timestamp": "02:30:13", "text": "你睡着了吗？你喜欢吗？"}, {"type": "subtitle", "time": 9015.349, "timestamp": "02:30:15", "text": "吃点东西之类的，你知道吗？"}, {"type": "subtitle", "time": 9017.99, "timestamp": "02:30:17", "text": "你就是那种只专注于一件事的人。"}, {"type": "subtitle", "time": 9020.15, "timestamp": "02:30:20", "text": "你知道，就是那种磨练技艺之类的。是的。"}, {"type": "subtitle", "time": 9022.15, "timestamp": "02:30:22", "text": "兄弟，保重。没错，没错。"}, {"type": "subtitle", "time": 9025.11, "timestamp": "02:30:25", "text": "真的。好的，跟着我走就行了。我会"}, {"type": "subtitle", "time": 9027.51, "timestamp": "02:30:27", "text": "让你入睡之类的，你知道的。我"}, {"type": "subtitle", "time": 9029.11, "timestamp": "02:30:29", "text": "我会告诉你那些坏习惯。不"}, {"type": "subtitle", "time": 9034.95, "timestamp": "02:30:34", "text": "我在这方面有点懒。"}, {"type": "subtitle", "time": 9036.45, "timestamp": "02:30:36", "text": "你知道。"}, {"type": "subtitle", "time": 9037.67, "timestamp": "02:30:37", "text": "[音乐]"}, {"type": "subtitle", "time": 9040.309, "timestamp": "02:30:40", "text": "这种事时有发生。一切都很艰难。我已开始"}, {"type": "subtitle", "time": 9043.349, "timestamp": "02:30:43", "text": "确实如此。我想要 我 我不想要"}, {"type": "subtitle", "time": 9045.349, "timestamp": "02:30:45", "text": "要我给你看看吗？"}, {"type": "subtitle", "time": 9046.87, "timestamp": "02:30:46", "text": "不，"}, {"type": "subtitle", "time": 9049.91, "timestamp": "02:30:49", "text": "我当时正在制作一个音乐视频。"}, {"type": "subtitle", "time": 9051.75, "timestamp": "02:30:51", "text": "实际上，我想把音乐放进去。"}, {"type": "subtitle", "time": 9054.309, "timestamp": "02:30:54", "text": "视频直播画面不像直播画面那样。"}, {"type": "subtitle", "time": 9056.389, "timestamp": "02:30:56", "text": "比如在我的频道上发帖之类的。"}]
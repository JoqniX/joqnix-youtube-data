[{"type": "subtitle", "time": 5401.99, "timestamp": "01:30:01", "text": "我们走吧。我想开枪。我们开始吧"}, {"type": "subtitle", "time": 5405.189, "timestamp": "01:30:05", "text": "各种挑战等等。"}, {"type": "subtitle", "time": 5408.07, "timestamp": "01:30:08", "text": "所以，要讨好经理人。呃，是一样的。"}, {"type": "subtitle", "time": 5411.91, "timestamp": "01:30:11", "text": "这种情况在所有涉及交易的事件中都会发生。"}, {"type": "subtitle", "time": 5416.709, "timestamp": "01:30:16", "text": "伤害、击杀、助攻前四名，所有这些"}, {"type": "subtitle", "time": 5419.189, "timestamp": "01:30:19", "text": "位于巴西。"}, {"type": "subtitle", "time": 5421.51, "timestamp": "01:30:21", "text": "哦，即便如此我也不应该玩这个游戏。哦"}, {"type": "subtitle", "time": 5430.79, "timestamp": "01:30:30", "text": "去做吧，乔伊。骑师。你是什​​么意思？我"}, {"type": "subtitle", "time": 5433.43, "timestamp": "01:30:33", "text": "你的意思是，我得花2000美元？"}, {"type": "subtitle", "time": 5439.669, "timestamp": "01:30:39", "text": "不过我得花2000卢比。我是"}, {"type": "subtitle", "time": 5443.03, "timestamp": "01:30:43", "text": "正在尝试渲染。我想。我"}, {"type": "subtitle", "time": 5445.189, "timestamp": "01:30:45", "text": "不。是的。所以，我忘了提……"}, {"type": "subtitle", "time": 5447.35, "timestamp": "01:30:47", "text": "这。所以"}, {"type": "subtitle", "time": 5455.35, "timestamp": "01:30:55", "text": "呃，如果我有钱的话……"}, {"type": "subtitle", "time": 5458.229, "timestamp": "01:30:58", "text": "浪费，我本来可以那样做的，但是"}]
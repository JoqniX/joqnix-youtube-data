[{"type": "subtitle", "time": 6781.03, "timestamp": "01:53:01", "text": "Twitch之类的直播平台，还有做那些事？某种程度上来说，"}, {"type": "subtitle", "time": 6783.51, "timestamp": "01:53:03", "text": "我想用……进行现场录制。"}, {"type": "subtitle", "time": 6786.07, "timestamp": "01:53:06", "text": "那个教程之类的东西，"}, {"type": "subtitle", "time": 6789.35, "timestamp": "01:53:09", "text": "我可能永远都不会把它拿出来。"}, {"type": "subtitle", "time": 6793.109, "timestamp": "01:53:13", "text": "我想把它现场直播。它就像一个"}, {"type": "subtitle", "time": 6795.83, "timestamp": "01:53:15", "text": "朋友不多之类的。我想到了"}, {"type": "subtitle", "time": 6797.83, "timestamp": "01:53:17", "text": "就像把视频设为非公开一样"}, {"type": "subtitle", "time": 6801.109, "timestamp": "01:53:21", "text": "以防万一，等我康复了再说。"}, {"type": "subtitle", "time": 6803.669, "timestamp": "01:53:23", "text": "在直播中录制视频"}, {"type": "subtitle", "time": 6806.229, "timestamp": "01:53:26", "text": "东西。"}, {"type": "subtitle", "time": 6810.55, "timestamp": "01:53:30", "text": "是的。是的。所以，我想，是的。"}, {"type": "subtitle", "time": 6813.91, "timestamp": "01:53:33", "text": "我会做那件事或者别的什么。"}, {"type": "subtitle", "time": 6817.51, "timestamp": "01:53:37", "text": "你知道吗？我认为这一点"}, {"type": "subtitle", "time": 6820.31, "timestamp": "01:53:40", "text": "双击"}, {"type": "subtitle", "time": 6822.79, "timestamp": "01:53:42", "text": "是的。是的。哈卡罗伊。是的，我试过了。"}, {"type": "subtitle", "time": 6824.87, "timestamp": "01:53:44", "text": "哈卡尔·罗伊。很好。它很好，但是因为"}, {"type": "subtitle", "time": 6827.27, "timestamp": "01:53:47", "text": "新年伊始的活动挑战，"}, {"type": "subtitle", "time": 6830.709, "timestamp": "01:53:50", "text": "正确的？最好"}, {"type": "subtitle", "time": 6835.43, "timestamp": "01:53:55", "text": "最好还是玩大逃杀模式"}, {"type": "subtitle", "time": 6838.55, "timestamp": "01:53:58", "text": "实际上，是因为它需要前十名。"}]
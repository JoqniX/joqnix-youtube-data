[{"type": "subtitle", "time": 11821.51, "timestamp": "03:17:01", "text": "Illustrator 呃，然后呃，更改图层，"}, {"type": "subtitle", "time": 11823.59, "timestamp": "03:17:03", "text": "改变不透明度，改变混合模式"}, {"type": "subtitle", "time": 11826.309, "timestamp": "03:17:06", "text": "模式并从中创造出新的东西"}, {"type": "subtitle", "time": 11829.269, "timestamp": "03:17:09", "text": "就像，嗯，获得灵感并创作"}, {"type": "subtitle", "time": 11831.99, "timestamp": "03:17:11", "text": "一些新的东西，有时我"}, {"type": "subtitle", "time": 11835.19, "timestamp": "03:17:15", "text": "试着自己画，就像用……"}, {"type": "subtitle", "time": 11837.67, "timestamp": "03:17:17", "text": "钢笔工具等等，就这些了。"}, {"type": "subtitle", "time": 11840.469, "timestamp": "03:17:20", "text": "我是如何学会做这些事情的，以及"}, {"type": "subtitle", "time": 11843.19, "timestamp": "03:17:23", "text": "我想应该是我的Instagram，以前的那个。"}, {"type": "subtitle", "time": 11845.51, "timestamp": "03:17:25", "text": "一切的一切。我以前做过"}, {"type": "subtitle", "time": 11849.11, "timestamp": "03:17:29", "text": "包括标志等等。于是，我照做了。我"}, {"type": "subtitle", "time": 11851.349, "timestamp": "03:17:31", "text": "做了些卡片之类的东西。然后我"}, {"type": "subtitle", "time": 11853.75, "timestamp": "03:17:33", "text": "大约在那个时候，我偶然发现了空调。"}, {"type": "subtitle", "time": 11856.15, "timestamp": "03:17:36", "text": "在 Twitch 上以 Jocnix 的用户名进行直播。我"}, {"type": "subtitle", "time": 11860.63, "timestamp": "03:17:40", "text": "偶然发现了一个叫呃的主播"}, {"type": "subtitle", "time": 11864.55, "timestamp": "03:17:44", "text": "寿司龙。他所做的一切都是现实生活中的。"}, {"type": "subtitle", "time": 11867.269, "timestamp": "03:17:47", "text": "流媒体，但他使用了很多"}, {"type": "subtitle", "time": 11870.07, "timestamp": "03:17:50", "text": "技术方面的东西，比如实时编辑"}, {"type": "subtitle", "time": 11872.87, "timestamp": "03:17:52", "text": "他的溪流。感觉不像视频"}, {"type": "subtitle", "time": 11875.11, "timestamp": "03:17:55", "text": "你投入了诸如动画音乐之类的努力"}, {"type": "subtitle", "time": 11878.07, "timestamp": "03:17:58", "text": "视频，对吧？ AMV并非如此，"}]
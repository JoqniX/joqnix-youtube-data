[{"type": "subtitle", "time": 3363.67, "timestamp": "00:56:03", "text": "什么？好的，等等。我忘了这件事。"}, {"type": "subtitle", "time": 3365.349, "timestamp": "00:56:05", "text": "是的。哦，等等，等等，等等。为什么是我"}, {"type": "subtitle", "time": 3367.67, "timestamp": "00:56:07", "text": "你又有这个呃……东西了吗？哦，我的"}, {"type": "subtitle", "time": 3371.99, "timestamp": "00:56:11", "text": "上帝。我忘了，呃，忘了移除"}, {"type": "subtitle", "time": 3375.19, "timestamp": "00:56:15", "text": "这。我的错。我的错。我的错。刮胡子。哦，"}, {"type": "subtitle", "time": 3377.109, "timestamp": "00:56:17", "text": "等待。等等，等等，等等，等等。我该怎么做？"}, {"type": "subtitle", "time": 3379.7, "timestamp": "00:56:19", "text": "再删除一次？"}, {"type": "subtitle", "time": 3382.39, "timestamp": "00:56:22", "text": "[音乐]"}, {"type": "subtitle", "time": 3384.45, "timestamp": "00:56:24", "text": "呃，等等。我该怎么做？"}, {"type": "subtitle", "time": 3385.99, "timestamp": "00:56:25", "text": "[音乐]"}, {"type": "subtitle", "time": 3396.47, "timestamp": "00:56:36", "text": "呃，我该如何删除它？我的天啊。"}, {"type": "subtitle", "time": 3399.43, "timestamp": "00:56:39", "text": "呃，卸货。好了，就是这样。是的。"}, {"type": "subtitle", "time": 3401.99, "timestamp": "00:56:41", "text": "你好。"}, {"type": "subtitle", "time": 3404.71, "timestamp": "00:56:44", "text": "是的。大家好。你们好吗？"}, {"type": "subtitle", "time": 3408.15, "timestamp": "00:56:48", "text": "今天做什么？我很想念你。一直以来"}, {"type": "subtitle", "time": 3411.03, "timestamp": "00:56:51", "text": "是吗？最近不太活跃"}, {"type": "subtitle", "time": 3414.87, "timestamp": "00:56:54", "text": "本周或上周。是的。而且"}, {"type": "subtitle", "time": 3418.23, "timestamp": "00:56:58", "text": "呃呃，明吉亚，你好，欢迎，欢迎。"}]
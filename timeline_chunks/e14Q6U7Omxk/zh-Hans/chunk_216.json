[{"type": "subtitle", "time": 12961.349, "timestamp": "03:36:01", "text": "就是这样，你知道的。是的。等待，"}, {"type": "subtitle", "time": 12963.269, "timestamp": "03:36:03", "text": "我不喜欢但你喜欢的东西有哪些？"}, {"type": "subtitle", "time": 12966.95, "timestamp": "03:36:06", "text": "等等，不，不，不。我不喜欢"}, {"type": "subtitle", "time": 12968.71, "timestamp": "03:36:08", "text": "有些东西你也不喜欢。"}, {"type": "subtitle", "time": 12971.429, "timestamp": "03:36:11", "text": "你知道，那些让人尴尬的事儿，那些"}, {"type": "subtitle", "time": 12973.19, "timestamp": "03:36:13", "text": "就像“大家好，欢迎来到……”"}, {"type": "subtitle", "time": 12976.229, "timestamp": "03:36:16", "text": "视频相关内容。不，不，不。我讨厌尴尬"}, {"type": "subtitle", "time": 12978.309, "timestamp": "03:36:18", "text": "这也太尴尬了吧。我刚收到"}, {"type": "subtitle", "time": 12981.349, "timestamp": "03:36:21", "text": "一股寒意顺着脊背蔓延开来。"}, {"type": "subtitle", "time": 12985.59, "timestamp": "03:36:25", "text": "总之，是的，我看到了，而且我"}, {"type": "subtitle", "time": 12987.11, "timestamp": "03:36:27", "text": "当时就觉得那样会很有趣。"}, {"type": "subtitle", "time": 12990.389, "timestamp": "03:36:30", "text": "这就是为什么我真的很擅长"}, {"type": "subtitle", "time": 12993.349, "timestamp": "03:36:33", "text": "我当时真的很高兴。"}, {"type": "subtitle", "time": 12994.87, "timestamp": "03:36:34", "text": "还在等合作成功，因为我"}, {"type": "subtitle", "time": 12997.83, "timestamp": "03:36:37", "text": "我知道我们会玩得很开心。"}, {"type": "subtitle", "time": 12999.51, "timestamp": "03:36:39", "text": "我不知道你是否只是"}, {"type": "subtitle", "time": 13001.51, "timestamp": "03:36:41", "text": "装模作样。我不知道。我无法判断"}, {"type": "subtitle", "time": 13011.19, "timestamp": "03:36:51", "text": "不。好的。好的。这就是你"}, {"type": "subtitle", "time": 13012.79, "timestamp": "03:36:52", "text": "做。好的。我结巴了。所以呢？全部"}, {"type": "subtitle", "time": 13014.95, "timestamp": "03:36:54", "text": "正确的。这件事同时发生在每个人身上"}, {"type": "subtitle", "time": 13018.15, "timestamp": "03:36:58", "text": "尽管。是的。我不是经常让她闭嘴吗？"}]
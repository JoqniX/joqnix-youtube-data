[{"type": "subtitle", "time": 11881.19, "timestamp": "03:18:01", "text": "实时直播中的编辑"}, {"type": "subtitle", "time": 11885.11, "timestamp": "03:18:05", "text": "时间给了我灵感。我当时就想：哇！"}, {"type": "subtitle", "time": 11887.59, "timestamp": "03:18:07", "text": "那太酷了，但我还想做"}, {"type": "subtitle", "time": 11890.15, "timestamp": "03:18:10", "text": "那。我逐渐观察他，就像……"}, {"type": "subtitle", "time": 11892.71, "timestamp": "03:18:12", "text": "几个月后我才明白这一切是怎么回事"}, {"type": "subtitle", "time": 11895.99, "timestamp": "03:18:15", "text": "他使用的软件以及他的设置是如何运作的"}, {"type": "subtitle", "time": 11899.269, "timestamp": "03:18:19", "text": "在他转而全面发展之前的一切"}, {"type": "subtitle", "time": 11902.15, "timestamp": "03:18:22", "text": "大型仓库，里面装满了东西"}, {"type": "subtitle", "time": 11904.55, "timestamp": "03:18:24", "text": "他有个仓库，里面有个绿色的场景。"}, {"type": "subtitle", "time": 11908.07, "timestamp": "03:18:28", "text": "他渴望的那点东西和类似的东西"}, {"type": "subtitle", "time": 11911.75, "timestamp": "03:18:31", "text": "你喜欢那种视觉DJ的东西吗？"}, {"type": "subtitle", "time": 11915.269, "timestamp": "03:18:35", "text": "给DJ们以及和他们相关的东西，比如"}, {"type": "subtitle", "time": 11917.59, "timestamp": "03:18:37", "text": "在他们进行DJ演唱会的时候，"}, {"type": "subtitle", "time": 11920.229, "timestamp": "03:18:40", "text": "他可以像对待观众一样对待他们。"}, {"type": "subtitle", "time": 11924.469, "timestamp": "03:18:44", "text": "现场编辑之类的VDJ玩意儿"}, {"type": "subtitle", "time": 11927.51, "timestamp": "03:18:47", "text": "他展现出了他的雄心壮志。"}, {"type": "subtitle", "time": 11930.07, "timestamp": "03:18:50", "text": "以及他在这方面的努力等等"}, {"type": "subtitle", "time": 11933.11, "timestamp": "03:18:53", "text": "直播给了我很多启发，我"}, {"type": "subtitle", "time": 11935.75, "timestamp": "03:18:55", "text": "我当时想，为什么我不能以……的身份这样做？"}, {"type": "subtitle", "time": 11939.269, "timestamp": "03:18:59", "text": "YouTuber无论是2D还是3D形式都有。"}]
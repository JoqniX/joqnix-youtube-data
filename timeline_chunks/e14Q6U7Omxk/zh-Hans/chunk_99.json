[{"type": "subtitle", "time": 5941.75, "timestamp": "01:39:01", "text": "我好像不太擅长在直播中说话。我是"}, {"type": "subtitle", "time": 5944.95, "timestamp": "01:39:04", "text": "比如保持沉默。那很糟糕。"}, {"type": "subtitle", "time": 5947.669, "timestamp": "01:39:07", "text": "我需要想出一个“哦，等等”。那"}, {"type": "subtitle", "time": 5957.99, "timestamp": "01:39:17", "text": "正如我刚才所说，我需要上来。我"}, {"type": "subtitle", "time": 5961.669, "timestamp": "01:39:21", "text": "我必须尽力而为。耽误。好的，"}, {"type": "subtitle", "time": 5963.75, "timestamp": "01:39:23", "text": "风扇在转动。好的，我需要做我的"}, {"type": "subtitle", "time": 5966.07, "timestamp": "01:39:26", "text": "最适合用来谈论这类事情。我要去"}, {"type": "subtitle", "time": 5968.79, "timestamp": "01:39:28", "text": "那方面做得不好。"}, {"type": "subtitle", "time": 5972.55, "timestamp": "01:39:32", "text": "我需要找到一种方法来更多地谈论……"}, {"type": "subtitle", "time": 5974.629, "timestamp": "01:39:34", "text": "以某种方式播放。"}, {"type": "subtitle", "time": 5979.189, "timestamp": "01:39:39", "text": "你还好吗？哦，是的。那是痛苦"}, {"type": "subtitle", "time": 5981.669, "timestamp": "01:39:41", "text": "最近。我的注意力一直分散着。"}, {"type": "subtitle", "time": 5984.629, "timestamp": "01:39:44", "text": "我觉得我还需要一些"}, {"type": "subtitle", "time": 5987.91, "timestamp": "01:39:47", "text": "流或者像一些更专注的东西"}, {"type": "subtitle", "time": 5991.35, "timestamp": "01:39:51", "text": "只是想恢复到我原本的样子。所以"}, {"type": "subtitle", "time": 5994.709, "timestamp": "01:39:54", "text": "是的。所以别理会这位骑师"}]
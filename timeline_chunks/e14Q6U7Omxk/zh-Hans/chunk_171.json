[{"type": "subtitle", "time": 10261.59, "timestamp": "02:51:01", "text": "我了解到的是……"}, {"type": "subtitle", "time": 10264.07, "timestamp": "02:51:04", "text": "他好像创办了一家公司。"}, {"type": "subtitle", "time": 10267.83, "timestamp": "02:51:07", "text": "BTuber公司之类的。他给予"}, {"type": "subtitle", "time": 10271.59, "timestamp": "02:51:11", "text": "就像两个角色对应两个人一样"}, {"type": "subtitle", "time": 10273.91, "timestamp": "02:51:13", "text": "他们俩都失败了。我认为那就是那时候"}, {"type": "subtitle", "time": 10277.91, "timestamp": "02:51:17", "text": "他得照照镜子，你"}, {"type": "subtitle", "time": 10281.51, "timestamp": "02:51:21", "text": "知道。我懂了。是的。是的。那是一个"}, {"type": "subtitle", "time": 10287.91, "timestamp": "02:51:27", "text": "那是个不错的选择。就是这样。"}, {"type": "subtitle", "time": 10291.269, "timestamp": "02:51:31", "text": "好的。我认为"}, {"type": "subtitle", "time": 10293.83, "timestamp": "02:51:33", "text": "这种事时有发生。每个人"}, {"type": "subtitle", "time": 10296.71, "timestamp": "02:51:36", "text": "他们现在有了自己的事业。人们继续前行。"}, {"type": "subtitle", "time": 10299.67, "timestamp": "02:51:39", "text": "他们会改变。他们明白如何"}, {"type": "subtitle", "time": 10306.63, "timestamp": "02:51:46", "text": "是的。"}, {"type": "subtitle", "time": 10314.87, "timestamp": "02:51:54", "text": "你告诉那个有野心的人，"}, {"type": "subtitle", "time": 10316.389, "timestamp": "02:51:56", "text": "你很有野心，这一点值得肯定。"}]
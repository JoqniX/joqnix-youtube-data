[{"type": "subtitle", "time": 12120.79, "timestamp": "03:22:00", "text": "流媒体等等一切都糟透了，它会"}, {"type": "subtitle", "time": 12123.03, "timestamp": "03:22:03", "text": "像个失败者一样。呃，我不想那样。"}, {"type": "subtitle", "time": 12125.59, "timestamp": "03:22:05", "text": "成为一个失败者。所以我想要那个型号"}, {"type": "subtitle", "time": 12128.229, "timestamp": "03:22:08", "text": "真正地闪耀光芒"}, {"type": "subtitle", "time": 12131.349, "timestamp": "03:22:11", "text": "值得。但作为一个人，他会"}, {"type": "subtitle", "time": 12134.63, "timestamp": "03:22:14", "text": "使用该模型，我不想我的不足之处。"}, {"type": "subtitle", "time": 12138.63, "timestamp": "03:22:18", "text": "技能可能会阻碍那方面的发展。"}, {"type": "subtitle", "time": 12141.11, "timestamp": "03:22:21", "text": "模型或者像它一样闪耀"}, {"type": "subtitle", "time": 12143.91, "timestamp": "03:22:23", "text": "值得。所以，我当时就想，为了……"}, {"type": "subtitle", "time": 12146.309, "timestamp": "03:22:26", "text": "为了证明我已经准备好了"}, {"type": "subtitle", "time": 12149.83, "timestamp": "03:22:29", "text": "用我想到的那种模型，你知道的"}, {"type": "subtitle", "time": 12152.55, "timestamp": "03:22:32", "text": "做我一直想做的事"}, {"type": "subtitle", "time": 12155.67, "timestamp": "03:22:35", "text": "与人合作，也喜欢"}, {"type": "subtitle", "time": 12159.11, "timestamp": "03:22:39", "text": "上传视频和其他类型的内容"}, {"type": "subtitle", "time": 12162.63, "timestamp": "03:22:42", "text": "我当时更害怕的是什么，或者说，我更像什么？"}, {"type": "subtitle", "time": 12164.71, "timestamp": "03:22:44", "text": "与其说是害怕，不如说我当时就像……"}, {"type": "subtitle", "time": 12167.349, "timestamp": "03:22:47", "text": "完美主义者。我心想，如果不是的话"}, {"type": "subtitle", "time": 12169.91, "timestamp": "03:22:49", "text": "超高品质，通用型呃"}, {"type": "subtitle", "time": 12172.55, "timestamp": "03:22:52", "text": "质量不好，对我的频道不利。"}, {"type": "subtitle", "time": 12174.87, "timestamp": "03:22:54", "text": "我觉得与其让每个人都开始，不如……"}, {"type": "subtitle", "time": 12176.309, "timestamp": "03:22:56", "text": "应该在某个地方吧？我们都开始了"}, {"type": "subtitle", "time": 12178.63, "timestamp": "03:22:58", "text": "某处。我们像 PewDiePie 一样开始。"}]
[{"type": "subtitle", "time": 13742.469, "timestamp": "03:49:02", "text": "这件事在日本引起了很大的轰动。"}, {"type": "subtitle", "time": 13744.87, "timestamp": "03:49:04", "text": "我不知道这件事。哦，他们是"}, {"type": "subtitle", "time": 13747.03, "timestamp": "03:49:07", "text": "漫不经心。"}, {"type": "subtitle", "time": 13749.83, "timestamp": "03:49:09", "text": "嗯，算是吧。他们大多数都是。那"}, {"type": "subtitle", "time": 13751.83, "timestamp": "03:49:11", "text": "这样能让你的生活更轻松。什么是"}, {"type": "subtitle", "time": 13754.229, "timestamp": "03:49:14", "text": "漫不经心？"}, {"type": "subtitle", "time": 13765.269, "timestamp": "03:49:25", "text": "或许"}, {"type": "subtitle", "time": 13769.75, "timestamp": "03:49:29", "text": "嗯，就像呃，就像呃"}, {"type": "subtitle", "time": 13771.91, "timestamp": "03:49:31", "text": "我不在乎你是否在场，我不在场。"}, {"type": "subtitle", "time": 13774.79, "timestamp": "03:49:34", "text": "那种不在乎的态度。对对对对"}, {"type": "subtitle", "time": 13776.79, "timestamp": "03:49:36", "text": "比如你路过他们根本不在乎"}, {"type": "subtitle", "time": 13778.63, "timestamp": "03:49:38", "text": "东西。我认为大多数japples"}, {"type": "subtitle", "time": 13780.469, "timestamp": "03:49:40", "text": "人就是这样。他们不在乎。"}, {"type": "subtitle", "time": 13783.11, "timestamp": "03:49:43", "text": "他们甚至还让店铺开着门。"}, {"type": "subtitle", "time": 13787.429, "timestamp": "03:49:47", "text": "就像里面还没有人一样。我认为"}, {"type": "subtitle", "time": 13790.63, "timestamp": "03:49:50", "text": "呃，我不在乎。值得学习"}, {"type": "subtitle", "time": 13793.189, "timestamp": "03:49:53", "text": "人们"}, {"type": "subtitle", "time": 13794.87, "timestamp": "03:49:54", "text": "他们话不多。我不知道"}, {"type": "subtitle", "time": 13797.189, "timestamp": "03:49:57", "text": "男人。我从不跟他们说话。他们会交谈吗？"}]
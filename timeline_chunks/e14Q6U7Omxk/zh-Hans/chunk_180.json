[{"type": "subtitle", "time": 10801.349, "timestamp": "03:00:01", "text": "朋友可以接管我的"}, {"type": "subtitle", "time": 10804.23, "timestamp": "03:00:04", "text": "直播的同时，我还要和聊天室互动。"}, {"type": "subtitle", "time": 10807.19, "timestamp": "03:00:07", "text": "睡觉之类的。我看到了"}, {"type": "subtitle", "time": 10811.03, "timestamp": "03:00:11", "text": "由其他 YouTuber 在 Twitch 上进行。所以"}, {"type": "subtitle", "time": 10813.03, "timestamp": "03:00:13", "text": "我没有那种配置。"}, {"type": "subtitle", "time": 10816.55, "timestamp": "03:00:16", "text": "一开始是有准备的，但了解我的人都知道，呃……"}, {"type": "subtitle", "time": 10818.389, "timestamp": "03:00:18", "text": "往往会使其更加先进，"}, {"type": "subtitle", "time": 10820.71, "timestamp": "03:00:20", "text": "复杂的。所以它更加自动化，而且"}, {"type": "subtitle", "time": 10823.19, "timestamp": "03:00:23", "text": "我不用担心直播的问题"}, {"type": "subtitle", "time": 10826.469, "timestamp": "03:00:26", "text": "我在睡觉。客人可以带"}, {"type": "subtitle", "time": 10829.429, "timestamp": "03:00:29", "text": "完全控制我的 OBS 和所有的一切"}, {"type": "subtitle", "time": 10832.63, "timestamp": "03:00:32", "text": "所有这些操作只需一条聊天命令即可完成"}, {"type": "subtitle", "time": 10836.389, "timestamp": "03:00:36", "text": "以及所有的一切。所以我照做了，然后……"}, {"type": "subtitle", "time": 10839.19, "timestamp": "03:00:39", "text": "花了一段时间，因为我得参加一些活动。"}, {"type": "subtitle", "time": 10841.03, "timestamp": "03:00:41", "text": "活动等等。我的世界活动"}, {"type": "subtitle", "time": 10844.389, "timestamp": "03:00:44", "text": "事情一直在进行，而且很多时间都是这样。"}, {"type": "subtitle", "time": 10846.63, "timestamp": "03:00:46", "text": "不在那里。所以我就想，啊，我就……"}, {"type": "subtitle", "time": 10849.11, "timestamp": "03:00:49", "text": "即兴发挥。我只会让那一个或"}, {"type": "subtitle", "time": 10851.99, "timestamp": "03:00:51", "text": "两个人就能做到。所以我弄到了一些"}, {"type": "subtitle", "time": 10853.51, "timestamp": "03:00:53", "text": "人们会做那种事之类的。然后我"}, {"type": "subtitle", "time": 10857.91, "timestamp": "03:00:57", "text": "比如，嗯，到那时我应该……"}]
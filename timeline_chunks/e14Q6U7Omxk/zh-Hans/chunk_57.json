[{"type": "subtitle", "time": 3420.15, "timestamp": "00:57:00", "text": "感谢你成为第一个……的人"}, {"type": "subtitle", "time": 3425.27, "timestamp": "00:57:05", "text": "打个招呼，然后露个面。还有 Snowy"}, {"type": "subtitle", "time": 3427.27, "timestamp": "00:57:07", "text": "我也曾在这里。是的。你好，Snowy。希望"}, {"type": "subtitle", "time": 3429.829, "timestamp": "00:57:09", "text": "你做得很好。我希望你一切都好"}, {"type": "subtitle", "time": 3432.63, "timestamp": "00:57:12", "text": "出色地。 Snowy，谢谢你来。然后"}, {"type": "subtitle", "time": 3438.47, "timestamp": "00:57:18", "text": "希望你一切都好。而且"}, {"type": "subtitle", "time": 3442.47, "timestamp": "00:57:22", "text": "祝您测试顺利。"}, {"type": "subtitle", "time": 3444.95, "timestamp": "00:57:24", "text": "祝你好运。祝你好运。尽你所能。希望"}, {"type": "subtitle", "time": 3447.67, "timestamp": "00:57:27", "text": "你学习很努力。"}, {"type": "subtitle", "time": 3449.51, "timestamp": "00:57:29", "text": "当然，你肯定会这么做。你会"}, {"type": "subtitle", "time": 3457.67, "timestamp": "00:57:37", "text": "祝你好运。祝你好运。"}, {"type": "subtitle", "time": 3464.75, "timestamp": "00:57:44", "text": "你一定可以的。"}, {"type": "subtitle", "time": 3472.87, "timestamp": "00:57:52", "text": "类似"}, {"type": "subtitle", "time": 3475.03, "timestamp": "00:57:55", "text": "好的，我可以把我的模型放在这里。全部"}]
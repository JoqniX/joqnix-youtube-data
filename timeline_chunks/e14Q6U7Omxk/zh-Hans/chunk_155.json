[{"type": "subtitle", "time": 9301.99, "timestamp": "02:35:01", "text": "嗯，我觉得是个男孩。那是个女孩"}, {"type": "subtitle", "time": 9304.469, "timestamp": "02:35:04", "text": "是谁提供了这个男孩的电话号码？"}, {"type": "subtitle", "time": 9306.95, "timestamp": "02:35:06", "text": "电台主持人给他打了个电话，然后发生了什么事？"}, {"type": "subtitle", "time": 9311.19, "timestamp": "02:35:11", "text": "呃，是在他们约会之后吗？"}, {"type": "subtitle", "time": 9312.95, "timestamp": "02:35:12", "text": "他们去了女孩家，因为"}, {"type": "subtitle", "time": 9316.95, "timestamp": "02:35:16", "text": "她的猫不见了，呃，还有那个女孩"}, {"type": "subtitle", "time": 9320.07, "timestamp": "02:35:20", "text": "左边的人开始四处张望。男孩"}, {"type": "subtitle", "time": 9322.23, "timestamp": "02:35:22", "text": "他去停车了。女孩心想"}, {"type": "subtitle", "time": 9324.309, "timestamp": "02:35:24", "text": "他离开了。好的。他去停车了"}, {"type": "subtitle", "time": 9326.87, "timestamp": "02:35:26", "text": "开车去找猫。他出来了"}, {"type": "subtitle", "time": 9329.99, "timestamp": "02:35:29", "text": "那辆车，然后他被另一辆车撞了，呃，我"}, {"type": "subtitle", "time": 9331.83, "timestamp": "02:35:31", "text": "想象一下卡车。"}, {"type": "subtitle", "time": 9333.349, "timestamp": "02:35:33", "text": "嗯。"}, {"type": "subtitle", "time": 9335.75, "timestamp": "02:35:35", "text": "他在医院住了7天。"}, {"type": "subtitle", "time": 9337.51, "timestamp": "02:35:37", "text": "女孩说他好像在故意冷落我。"}, {"type": "subtitle", "time": 9340.15, "timestamp": "02:35:40", "text": "7天。"}, {"type": "subtitle", "time": 9342.15, "timestamp": "02:35:42", "text": "是的。事情的经过是这样的："}, {"type": "subtitle", "time": 9345.429, "timestamp": "02:35:45", "text": "直播过程中出现错误，抱歉。"}, {"type": "subtitle", "time": 9349.11, "timestamp": "02:35:49", "text": "有人告诉他们，那只猫总是待在……"}, {"type": "subtitle", "time": 9352.79, "timestamp": "02:35:52", "text": "一直都是衣橱。"}, {"type": "subtitle", "time": 9355.19, "timestamp": "02:35:55", "text": "是啊，那确实挺搞笑的。来自我"}, {"type": "subtitle", "time": 9356.79, "timestamp": "02:35:56", "text": "一点也不好笑。如果你听到了，那就是"}, {"type": "subtitle", "time": 9358.469, "timestamp": "02:35:58", "text": "挺搞笑的。是的。我没有"}]
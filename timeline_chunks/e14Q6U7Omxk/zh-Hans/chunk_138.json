[{"type": "subtitle", "time": 8282.309, "timestamp": "02:18:02", "text": "没关系。没关系。"}, {"type": "subtitle", "time": 8285.27, "timestamp": "02:18:05", "text": "该死。是的，我也答对了。"}, {"type": "subtitle", "time": 8287.99, "timestamp": "02:18:07", "text": "不知何故。"}, {"type": "subtitle", "time": 8290.15, "timestamp": "02:18:10", "text": "不再赘述。"}, {"type": "subtitle", "time": 8293.27, "timestamp": "02:18:13", "text": "更远。是的。嗯，"}, {"type": "subtitle", "time": 8295.349, "timestamp": "02:18:15", "text": "你是女孩。好的。你的"}, {"type": "subtitle", "time": 8299.19, "timestamp": "02:18:19", "text": "姑姑的葬礼。你在哀悼吗？"}, {"type": "subtitle", "time": 8302.389, "timestamp": "02:18:22", "text": "我不知道这个词怎么发音。"}, {"type": "subtitle", "time": 8305.91, "timestamp": "02:18:25", "text": "总之，你早上看到了吧？你看"}, {"type": "subtitle", "time": 8307.99, "timestamp": "02:18:27", "text": "你旁边就站着一位非常英俊的男人。"}, {"type": "subtitle", "time": 8311.03, "timestamp": "02:18:31", "text": "你立刻爱上了这个男人。"}, {"type": "subtitle", "time": 8313.429, "timestamp": "02:18:33", "text": "他身穿黑色西装。他穿着黑色衣服"}, {"type": "subtitle", "time": 8317.429, "timestamp": "02:18:37", "text": "头发。第二天晚上你回家，"}, {"type": "subtitle", "time": 8321.589, "timestamp": "02:18:41", "text": "杀了你妹妹。这是为什么？"}, {"type": "subtitle", "time": 8323.669, "timestamp": "02:18:43", "text": "哦，现在情况糟透了，因为我"}, {"type": "subtitle", "time": 8329.19, "timestamp": "02:18:49", "text": "想想看，因为那家伙"}, {"type": "subtitle", "time": 8333.27, "timestamp": "02:18:53", "text": "他当时正和她姐姐约会，而她姐姐并没有。"}, {"type": "subtitle", "time": 8336.95, "timestamp": "02:18:56", "text": "就像她那样，呃，她声称他属于她。"}]
[{"type": "subtitle", "time": 11401.19, "timestamp": "03:10:01", "text": "但第一次互动感觉如何呢？"}, {"type": "subtitle", "time": 11404.79, "timestamp": "03:10:04", "text": "你觉得这件事最吸引你的地方是什么？"}, {"type": "subtitle", "time": 11409.429, "timestamp": "03:10:09", "text": "哦，最初真是太有趣了。"}, {"type": "subtitle", "time": 11411.91, "timestamp": "03:10:11", "text": "我发现了 YouTube"}, {"type": "subtitle", "time": 11414.469, "timestamp": "03:10:14", "text": "从进入 Vocal Loid 之类的"}, {"type": "subtitle", "time": 11417.91, "timestamp": "03:10:17", "text": "还有其他一些东西。然后，呃，我越深入了解"}, {"type": "subtitle", "time": 11420.15, "timestamp": "03:10:20", "text": "我意识到原来还有YouTube博主，而我"}, {"type": "subtitle", "time": 11422.15, "timestamp": "03:10:22", "text": "没想到，我甚至不知道自己是"}, {"type": "subtitle", "time": 11424.63, "timestamp": "03:10:24", "text": "一边看 Hol Life YouTuber 一边"}, {"type": "subtitle", "time": 11427.83, "timestamp": "03:10:27", "text": "回头看看卡齐娜她们的事。"}, {"type": "subtitle", "time": 11431.11, "timestamp": "03:10:31", "text": "天。但是，呃，自从我的背景开始"}, {"type": "subtitle", "time": 11434.15, "timestamp": "03:10:34", "text": "比如想做音乐相关的事情，DJ"}, {"type": "subtitle", "time": 11437.11, "timestamp": "03:10:37", "text": "诸如成为音乐家之类的东西"}, {"type": "subtitle", "time": 11439.51, "timestamp": "03:10:39", "text": "也算是个DJ和制作人吧"}, {"type": "subtitle", "time": 11444.07, "timestamp": "03:10:44", "text": "音乐作曲家之类的。嗯，还有我"}, {"type": "subtitle", "time": 11447.67, "timestamp": "03:10:47", "text": "我一直以为，哦，我给Jo取了这个名字，"}, {"type": "subtitle", "time": 11449.83, "timestamp": "03:10:49", "text": "一切都好，但最重要的事是"}, {"type": "subtitle", "time": 11452.87, "timestamp": "03:10:52", "text": "音乐，然后只有我能做到什么"}, {"type": "subtitle", "time": 11455.349, "timestamp": "03:10:55", "text": "你称之为歌曲分发吗？"}, {"type": "subtitle", "time": 11457.51, "timestamp": "03:10:57", "text": "所有商品。所以，呃，为了"}, {"type": "subtitle", "time": 11459.75, "timestamp": "03:10:59", "text": "为了做到这一切，我开始学习"}]
[{"type": "subtitle", "time": 10440.79, "timestamp": "02:54:00", "text": "哇。我不知道 pe 另一个"}, {"type": "subtitle", "time": 10443.67, "timestamp": "02:54:03", "text": "直播 YouTuber 和所有人，呃，他们"}, {"type": "subtitle", "time": 10445.91, "timestamp": "02:54:05", "text": "有些人有这种……嗯，你觉得呢？"}, {"type": "subtitle", "time": 10447.83, "timestamp": "02:54:07", "text": "叫它什么？每个都有不同的性格"}, {"type": "subtitle", "time": 10449.91, "timestamp": "02:54:09", "text": "比如和朋友聊天之类的，"}, {"type": "subtitle", "time": 10451.51, "timestamp": "02:54:11", "text": "家庭，他们有不同的方式"}, {"type": "subtitle", "time": 10454.79, "timestamp": "02:54:14", "text": "直播中他们说话很客气，但是"}, {"type": "subtitle", "time": 10457.11, "timestamp": "02:54:17", "text": "现实生活中，他们说话的方式都不一样。"}, {"type": "subtitle", "time": 10459.91, "timestamp": "02:54:19", "text": "那些我一直没搞懂的东西"}, {"type": "subtitle", "time": 10463.19, "timestamp": "02:54:23", "text": "其实我就是想，我有那个吗？"}, {"type": "subtitle", "time": 10466.63, "timestamp": "02:54:26", "text": "我不知道我所知道的一切，但我知道我就是这样。"}, {"type": "subtitle", "time": 10470.07, "timestamp": "02:54:30", "text": "嗯，有时候和家人在一起的时候"}, {"type": "subtitle", "time": 10474.07, "timestamp": "02:54:34", "text": "用我的母语说，嗯，听起来"}, {"type": "subtitle", "time": 10477.67, "timestamp": "02:54:37", "text": "有点不对劲，或者说，刺痛"}, {"type": "subtitle", "time": 10479.429, "timestamp": "02:54:39", "text": "演讲或者类似的东西，就是这样，但在"}, {"type": "subtitle", "time": 10482.63, "timestamp": "02:54:42", "text": "英语之类的东西，我说的也是同样的话。"}, {"type": "subtitle", "time": 10485.59, "timestamp": "02:54:45", "text": "到处都说，是啊，什么？呃，什么？"}, {"type": "subtitle", "time": 10487.59, "timestamp": "02:54:47", "text": "你的母语我从未听过。"}, {"type": "subtitle", "time": 10492.389, "timestamp": "02:54:52", "text": "母语应该是其中之一。"}]
[{"type": "subtitle", "time": 7922.47, "timestamp": "02:12:02", "text": "你知道。所以，是的，是关于我会我会"}, {"type": "subtitle", "time": 7924.229, "timestamp": "02:12:04", "text": "只要问你一个问题，你就会"}, {"type": "subtitle", "time": 7926.39, "timestamp": "02:12:06", "text": "你可以用你认为正确的任何方式回答。"}, {"type": "subtitle", "time": 7929.27, "timestamp": "02:12:09", "text": "或者错了，呃，你不用思考"}, {"type": "subtitle", "time": 7932.149, "timestamp": "02:12:12", "text": "关于这方面有很多信息。好的，答案是"}, {"type": "subtitle", "time": 7936.069, "timestamp": "02:12:16", "text": "呃，任何有效且正确的方法。"}, {"type": "subtitle", "time": 7938.55, "timestamp": "02:12:18", "text": "答案或错误答案"}, {"type": "subtitle", "time": 7941.189, "timestamp": "02:12:21", "text": "精神病患者的回答会是：呃，我会"}, {"type": "subtitle", "time": 7944.55, "timestamp": "02:12:24", "text": "以后再告诉你。好的。是的。所以"}, {"type": "subtitle", "time": 7947.589, "timestamp": "02:12:27", "text": "首先，呃，关于审判，呃，有一个"}, {"type": "subtitle", "time": 7949.75, "timestamp": "02:12:29", "text": "收到礼物的小男孩"}, {"type": "subtitle", "time": 7952.31, "timestamp": "02:12:32", "text": "圣诞老人。今天是圣诞节。他得到了一个"}, {"type": "subtitle", "time": 7955.51, "timestamp": "02:12:35", "text": "他有一个足球和一辆自行车，但他没有"}, {"type": "subtitle", "time": 7958.55, "timestamp": "02:12:38", "text": "快乐的。这是为什么？"}, {"type": "subtitle", "time": 7961.75, "timestamp": "02:12:41", "text": "他得到了一个足球和一辆自行车，"}, {"type": "subtitle", "time": 7963.75, "timestamp": "02:12:43", "text": "他很不高兴。"}, {"type": "subtitle", "time": 7967.51, "timestamp": "02:12:47", "text": "是的。因为他想要别的东西。"}, {"type": "subtitle", "time": 7969.189, "timestamp": "02:12:49", "text": "是的。"}, {"type": "subtitle", "time": 7972.55, "timestamp": "02:12:52", "text": "他不是，他本来就不想当自行车手。"}, {"type": "subtitle", "time": 7975.189, "timestamp": "02:12:55", "text": "或者他想骑自行车炫耀一下。"}, {"type": "subtitle", "time": 7977.43, "timestamp": "02:12:57", "text": "或许是朋友的缘故，或许他根本不喜欢足球。"}, {"type": "subtitle", "time": 7979.589, "timestamp": "02:12:59", "text": "因为他被朋友欺负了，或者"}]
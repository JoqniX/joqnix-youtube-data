[{"type": "subtitle", "time": 9060.23, "timestamp": "02:31:00", "text": "问题是，上面印着我的脸。啊，"}, {"type": "subtitle", "time": 9062.15, "timestamp": "02:31:02", "text": "不太好。情况不太好"}, {"type": "subtitle", "time": 9064.71, "timestamp": "02:31:04", "text": "坏的。就像我感受到音乐一样"}, {"type": "subtitle", "time": 9066.389, "timestamp": "02:31:06", "text": "诸如此类的事情，你知道的。不是的，我只是"}, {"type": "subtitle", "time": 9068.95, "timestamp": "02:31:08", "text": "编辑之类的。我当时正在练习。我"}, {"type": "subtitle", "time": 9071.03, "timestamp": "02:31:11", "text": "想把它发出来，但我当时正在……"}, {"type": "subtitle", "time": 9073.59, "timestamp": "02:31:13", "text": "持续了大概两周、三周。我"}, {"type": "subtitle", "time": 9075.75, "timestamp": "02:31:15", "text": "一直在等下雨。嗯，是的。"}, {"type": "subtitle", "time": 9077.27, "timestamp": "02:31:17", "text": "你看了就明白了。"}, {"type": "subtitle", "time": 9080.469, "timestamp": "02:31:20", "text": "总之，我收到了你的信息。"}, {"type": "subtitle", "time": 9082.469, "timestamp": "02:31:22", "text": "这让我很想回来。"}, {"type": "subtitle", "time": 9085.429, "timestamp": "02:31:25", "text": "诸如此类的事情，你知道的。哦，我真的"}, {"type": "subtitle", "time": 9088.55, "timestamp": "02:31:28", "text": "很高兴收到您的留言。谢谢"}, {"type": "subtitle", "time": 9093.11, "timestamp": "02:31:33", "text": "诚实。啊，我很高兴。"}, {"type": "subtitle", "time": 9095.03, "timestamp": "02:31:35", "text": "等待。哦，是的。我联系过你。"}, {"type": "subtitle", "time": 9098.95, "timestamp": "02:31:38", "text": "现在。是的。是的。是的。所以，嗯，我"}, {"type": "subtitle", "time": 9101.83, "timestamp": "02:31:41", "text": "还记得你。我觉得我，我觉得我"}, {"type": "subtitle", "time": 9106.15, "timestamp": "02:31:46", "text": "第一次见到你是在2021年。"}, {"type": "subtitle", "time": 9110.15, "timestamp": "02:31:50", "text": "或者别的什么。我觉得就像……"}, {"type": "subtitle", "time": 9112.87, "timestamp": "02:31:52", "text": "我想，他们是天空之流的孩子们。"}, {"type": "subtitle", "time": 9116.55, "timestamp": "02:31:56", "text": "是的。是的。是的。是的。是的。是的。一个"}]
[{"type": "subtitle", "time": 11520.07, "timestamp": "03:12:00", "text": "我做不到。然后，嗯，是的，那个"}, {"type": "subtitle", "time": 11522.79, "timestamp": "03:12:02", "text": "那是我小时候喜欢的那种小阶段"}, {"type": "subtitle", "time": 11527.03, "timestamp": "03:12:07", "text": "拿起我的手机录下来，试着……呃……说"}, {"type": "subtitle", "time": 11529.03, "timestamp": "03:12:09", "text": "某物上的东西。然后我意识到，"}, {"type": "subtitle", "time": 11533.03, "timestamp": "03:12:13", "text": "哦，我正在尝试一些东西。我能……"}, {"type": "subtitle", "time": 11536.15, "timestamp": "03:12:16", "text": "如果我认真对待这件事的话"}, {"type": "subtitle", "time": 11538.23, "timestamp": "03:12:18", "text": "我对它充满热情，所以我能够投入"}, {"type": "subtitle", "time": 11540.87, "timestamp": "03:12:20", "text": "现在就推进这项工作。所以我想"}, {"type": "subtitle", "time": 11543.59, "timestamp": "03:12:23", "text": "或许我会尝试直播。所以我没做"}, {"type": "subtitle", "time": 11546.63, "timestamp": "03:12:26", "text": "当时我没有麦克风，但是"}, {"type": "subtitle", "time": 11548.55, "timestamp": "03:12:28", "text": "确实喜欢游戏直播之类的。我"}, {"type": "subtitle", "time": 11550.87, "timestamp": "03:12:30", "text": "被静音了。我以前经常在聊天室里打字。"}, {"type": "subtitle", "time": 11554.15, "timestamp": "03:12:34", "text": "每当有人路过时。即使在"}, {"type": "subtitle", "time": 11557.429, "timestamp": "03:12:37", "text": "我以前玩一款游戏时会暂停，然后打字……"}, {"type": "subtitle", "time": 11560.95, "timestamp": "03:12:40", "text": "如果有人在说话，就接话。那是在"}, {"type": "subtitle", "time": 11562.71, "timestamp": "03:12:42", "text": "抽搐。我开始在Twitch上直播。"}, {"type": "subtitle", "time": 11565.83, "timestamp": "03:12:45", "text": "首先，那时候我只有一个"}, {"type": "subtitle", "time": 11569.429, "timestamp": "03:12:49", "text": "或者两个人过来什么的。"}, {"type": "subtitle", "time": 11573.429, "timestamp": "03:12:53", "text": "嗯，是的，然后我真的拿到了麦克风，"}, {"type": "subtitle", "time": 11575.91, "timestamp": "03:12:55", "text": "我当时就想，是啊，我应该逼自己一把。"}, {"type": "subtitle", "time": 11578.469, "timestamp": "03:12:58", "text": "直播里聊了所有的事情，我"}]
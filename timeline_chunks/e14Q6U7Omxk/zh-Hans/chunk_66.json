[{"type": "subtitle", "time": 3960.39, "timestamp": "01:06:00", "text": "是广播，对吧？"}, {"type": "subtitle", "time": 3963.67, "timestamp": "01:06:03", "text": "就是这样。呃"}, {"type": "subtitle", "time": 3966.39, "timestamp": "01:06:06", "text": "和比利在一起，那是不可能的。"}, {"type": "subtitle", "time": 3969.19, "timestamp": "01:06:09", "text": "比利。我必须达到一定的水平"}, {"type": "subtitle", "time": 3971.67, "timestamp": "01:06:11", "text": "或者为了做到这一点，你"}, {"type": "subtitle", "time": 3975.51, "timestamp": "01:06:15", "text": "我知道一些事情，我更喜欢这样。"}, {"type": "subtitle", "time": 3977.75, "timestamp": "01:06:17", "text": "疼痛"}, {"type": "subtitle", "time": 3983.91, "timestamp": "01:06:23", "text": "是的"}, {"type": "subtitle", "time": 3986.39, "timestamp": "01:06:26", "text": "确实很痛。所以今天我们要……"}, {"type": "subtitle", "time": 3988.87, "timestamp": "01:06:28", "text": "玩《Apex英雄》。呃，有一个新的"}, {"type": "subtitle", "time": 3990.87, "timestamp": "01:06:30", "text": "事件发生在天体日出之时"}, {"type": "subtitle", "time": 3993.27, "timestamp": "01:06:33", "text": "你看到了标题。他们会努力奋斗"}, {"type": "subtitle", "time": 3995.109, "timestamp": "01:06:35", "text": "不过，这项活动也……"}, {"type": "subtitle", "time": 3999.27, "timestamp": "01:06:39", "text": "硬核皇家新限时模式，就像没有"}, {"type": "subtitle", "time": 4001.349, "timestamp": "01:06:41", "text": "盔甲，就像会有盔甲一样，但没有。"}, {"type": "subtitle", "time": 4006.47, "timestamp": "01:06:46", "text": "进化，然后风暴就会充满"}, {"type": "subtitle", "time": 4008.789, "timestamp": "01:06:48", "text": "最大伤害是指如果我击中风暴"}, {"type": "subtitle", "time": 4011.75, "timestamp": "01:06:51", "text": "我死了，就像硬核游戏一样"}, {"type": "subtitle", "time": 4014.789, "timestamp": "01:06:54", "text": "硬核。但让我们尽力而为吧"}, {"type": "subtitle", "time": 4017.27, "timestamp": "01:06:57", "text": "沙凡。"}]
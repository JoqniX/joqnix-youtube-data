[{"type": "subtitle", "time": 2401.91, "timestamp": "00:40:01", "text": "谈论他们说了什么"}, {"type": "subtitle", "time": 2404.15, "timestamp": "00:40:04", "text": "它们会像这样陷入这个循环中"}, {"type": "subtitle", "time": 2406.63, "timestamp": "00:40:06", "text": "好奇心"}, {"type": "subtitle", "time": 2409.109, "timestamp": "00:40:09", "text": "除非你去谷歌搜索。"}, {"type": "subtitle", "time": 2412.23, "timestamp": "00:40:12", "text": "自己翻译一下，就像这样"}, {"type": "subtitle", "time": 2414.87, "timestamp": "00:40:14", "text": "那"}, {"type": "subtitle", "time": 2417.43, "timestamp": "00:40:17", "text": "所以尽量用英语表达。"}, {"type": "subtitle", "time": 2421.589, "timestamp": "00:40:21", "text": "好的。而其中最重要的角色之一"}, {"type": "subtitle", "time": 2424.71, "timestamp": "00:40:24", "text": "我把最后一个留了下来"}, {"type": "subtitle", "time": 2428.37, "timestamp": "00:40:28", "text": "别忘了展现你的可爱一面，做你自己。"}, {"type": "subtitle", "time": 2430.069, "timestamp": "00:40:30", "text": "[音乐]"}, {"type": "subtitle", "time": 2435.27, "timestamp": "00:40:35", "text": "是的。做你自己，展现你的可爱。好的。"}, {"type": "subtitle", "time": 2437.03, "timestamp": "00:40:37", "text": "嗯。"}, {"type": "subtitle", "time": 2443.589, "timestamp": "00:40:43", "text": "你们都一如既往地值得拥有护头垫。"}, {"type": "subtitle", "time": 2446.79, "timestamp": "00:40:46", "text": "哦，"}, {"type": "subtitle", "time": 2449.67, "timestamp": "00:40:49", "text": "正确的。以上就是规则部分。所以"}, {"type": "subtitle", "time": 2451.75, "timestamp": "00:40:51", "text": "是的，"}, {"type": "subtitle", "time": 2455.03, "timestamp": "00:40:55", "text": "你好可爱。我长得丑。不，不，不，不"}, {"type": "subtitle", "time": 2457.75, "timestamp": "00:40:57", "text": "不。事情并非如此。巴卡"}, {"type": "subtitle", "time": 2459.99, "timestamp": "00:40:59", "text": "报道"}]
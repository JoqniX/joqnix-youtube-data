[{"type": "subtitle", "time": 6270.95, "timestamp": "01:44:30", "text": "写完GX之后我回来了。我的天啊。"}, {"type": "subtitle", "time": 6274.39, "timestamp": "01:44:34", "text": "我完全忘了这件事。那是"}, {"type": "subtitle", "time": 6288.07, "timestamp": "01:44:48", "text": "啊，原来是它卡顿了。"}, {"type": "subtitle", "time": 6290.39, "timestamp": "01:44:50", "text": "我在这游戏里什么都做不了了。"}, {"type": "subtitle", "time": 6293.669, "timestamp": "01:44:53", "text": "因为我的显卡根本带不动任何东西"}, {"type": "subtitle", "time": 6295.27, "timestamp": "01:44:55", "text": "不再是了。"}, {"type": "subtitle", "time": 6297.91, "timestamp": "01:44:57", "text": "我当时就想，"}]
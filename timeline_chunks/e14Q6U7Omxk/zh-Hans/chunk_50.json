[{"type": "subtitle", "time": 3003.99, "timestamp": "00:50:03", "text": "我竟然忘了做这件事。"}, {"type": "subtitle", "time": 3006.549, "timestamp": "00:50:06", "text": "我其实应该改成"}, {"type": "subtitle", "time": 3010.47, "timestamp": "00:50:10", "text": "这个动态照明装置"}, {"type": "subtitle", "time": 3013.43, "timestamp": "00:50:13", "text": "比如我在游戏里打开任何东西的时候"}, {"type": "subtitle", "time": 3016.39, "timestamp": "00:50:16", "text": "当我拍摄所有场景时，可以看到颜色"}, {"type": "subtitle", "time": 3017.99, "timestamp": "00:50:17", "text": "把这个改成我的背景"}, {"type": "subtitle", "time": 3021.67, "timestamp": "00:50:21", "text": "像蓝色背景星座"}, {"type": "subtitle", "time": 3025.91, "timestamp": "00:50:25", "text": "我忘了，我不会忘记"}, {"type": "subtitle", "time": 3028.63, "timestamp": "00:50:28", "text": "是的"}, {"type": "subtitle", "time": 3032.87, "timestamp": "00:50:32", "text": "新的灯光滤镜功能，嗯。"}, {"type": "subtitle", "time": 3036.15, "timestamp": "00:50:36", "text": "我们会像这样进行试验，"}, {"type": "subtitle", "time": 3040.15, "timestamp": "00:50:40", "text": "我们也要创造一些属于我们自己的独特作品。"}, {"type": "subtitle", "time": 3042.39, "timestamp": "00:50:42", "text": "如果很好，我们也会……"}, {"type": "subtitle", "time": 3044.63, "timestamp": "00:50:44", "text": "想着把它分享到推特上，这样"}, {"type": "subtitle", "time": 3047.19, "timestamp": "00:50:47", "text": "其他人，任何需要尝试的人"}, {"type": "subtitle", "time": 3049.51, "timestamp": "00:50:49", "text": "他们也可以尝试一下。是的。"}, {"type": "subtitle", "time": 3051.2, "timestamp": "00:50:51", "text": "是的。 我早就知道这件事，但我从来没有过。"}, {"type": "subtitle", "time": 3054.319, "timestamp": "00:50:54", "text": "我早就知道这件事，但我从来没有过。 这个聪明人想试试把它结合起来。"}, {"type": "subtitle", "time": 3057.44, "timestamp": "00:50:57", "text": "这个聪明人想试试把它结合起来。 一起"}]
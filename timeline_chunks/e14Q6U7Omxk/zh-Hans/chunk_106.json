[{"type": "subtitle", "time": 6366.629, "timestamp": "01:46:06", "text": "哦，他夺走了我的身体。"}, {"type": "subtitle", "time": 6368.31, "timestamp": "01:46:08", "text": "本季有什么新番动画在追吗？"}, {"type": "subtitle", "time": 6369.99, "timestamp": "01:46:09", "text": "是的，我最近看了很多动漫。"}, {"type": "subtitle", "time": 6372.79, "timestamp": "01:46:12", "text": "本赛季。你知道，"}, {"type": "subtitle", "time": 6375.27, "timestamp": "01:46:15", "text": "我以前常说，如果我在看"}, {"type": "subtitle", "time": 6381.109, "timestamp": "01:46:21", "text": "任何一天、任何一周的动漫都展现了这一点"}, {"type": "subtitle", "time": 6383.51, "timestamp": "01:46:23", "text": "我某种程度上来说有点懒。那是"}, {"type": "subtitle", "time": 6387.59, "timestamp": "01:46:27", "text": "那正是我以前常说的话。"}, {"type": "subtitle", "time": 6396.149, "timestamp": "01:46:36", "text": "哦，是的。你们说要改这个"}, {"type": "subtitle", "time": 6398.95, "timestamp": "01:46:38", "text": "是笑声吗？我需要改变"}]
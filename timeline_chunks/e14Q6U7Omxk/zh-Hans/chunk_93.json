[{"type": "subtitle", "time": 5592.95, "timestamp": "01:33:12", "text": "我到家后要用我的钱买什么"}, {"type": "subtitle", "time": 5595.59, "timestamp": "01:33:15", "text": "在职的。你打算买什么"}, {"type": "subtitle", "time": 5598.229, "timestamp": "01:33:18", "text": "你开始工作了吗？"}, {"type": "subtitle", "time": 5602.55, "timestamp": "01:33:22", "text": "等等，这风扇停转了。"}, {"type": "subtitle", "time": 5606.629, "timestamp": "01:33:26", "text": "现在速度慢了。等等，什么？"}, {"type": "subtitle", "time": 5608.55, "timestamp": "01:33:28", "text": "我应该重新开始游戏吗？我想我会"}, {"type": "subtitle", "time": 5611.83, "timestamp": "01:33:31", "text": "重新启动游戏。"}, {"type": "subtitle", "time": 5613.669, "timestamp": "01:33:33", "text": "别在游戏中被踢得太狠"}, {"type": "subtitle", "time": 5621.189, "timestamp": "01:33:41", "text": "是啊，就像"}, {"type": "subtitle", "time": 5627.669, "timestamp": "01:33:47", "text": "她刚才在说什么来着？哦，我的"}, {"type": "subtitle", "time": 5629.35, "timestamp": "01:33:49", "text": "上帝。"}, {"type": "subtitle", "time": 5631.27, "timestamp": "01:33:51", "text": "钱的事。我必须小心谨慎"}, {"type": "subtitle", "time": 5634.07, "timestamp": "01:33:54", "text": "它。我不应该这样花掉它。"}, {"type": "subtitle", "time": 5637.11, "timestamp": "01:33:57", "text": "那？当然，我把钱花在这些地方了。"}, {"type": "subtitle", "time": 5639.35, "timestamp": "01:33:59", "text": "天。我主要把钱花在了……"}]
[{"type": "subtitle", "time": 7261.91, "timestamp": "02:01:01", "text": "今天过得怎么样？好样的，兄弟。真是太……"}, {"type": "subtitle", "time": 7264.709, "timestamp": "02:01:04", "text": "你知道，日子很忙。哦，对了，它是"}, {"type": "subtitle", "time": 7267.669, "timestamp": "02:01:07", "text": "超级阿比娜和朗纳德。他们向……打招呼"}, {"type": "subtitle", "time": 7270.95, "timestamp": "02:01:10", "text": "你。你好。对，在我的直播里。好的。"}, {"type": "subtitle", "time": 7275.589, "timestamp": "02:01:15", "text": "你好聊天。欢迎。是的。"}, {"type": "subtitle", "time": 7279.03, "timestamp": "02:01:19", "text": "现在我明白了，我们还是把注意力集中在乔斯身上吧。"}, {"type": "subtitle", "time": 7281.91, "timestamp": "02:01:21", "text": "正确的？所以乔斯，就是这样，就是这样，就是这样"}, {"type": "subtitle", "time": 7284.149, "timestamp": "02:01:24", "text": "难的。好的。这太难了，因为我有"}, {"type": "subtitle", "time": 7287.43, "timestamp": "02:01:27", "text": "我的笔记本电脑用了大概……"}, {"type": "subtitle", "time": 7289.189, "timestamp": "02:01:29", "text": "维护用品。所以我必须得到它"}, {"type": "subtitle", "time": 7291.91, "timestamp": "02:01:31", "text": "2点30分。时间是3分40秒。然后我就得走了"}, {"type": "subtitle", "time": 7293.99, "timestamp": "02:01:33", "text": "去我父亲的东西。但这花了我"}, {"type": "subtitle", "time": 7296.87, "timestamp": "02:01:36", "text": "我好像五点才刚放假。就像我"}, {"type": "subtitle", "time": 7298.55, "timestamp": "02:01:38", "text": "仅保留并打开流"}, {"type": "subtitle", "time": 7300.709, "timestamp": "02:01:40", "text": "你知道，越快越好。"}, {"type": "subtitle", "time": 7304.229, "timestamp": "02:01:44", "text": "是的。是的。没关系。不用担心。做过"}, {"type": "subtitle", "time": 7306.709, "timestamp": "02:01:46", "text": "我的照片显示出来了？呃，你可以刷新"}, {"type": "subtitle", "time": 7308.79, "timestamp": "02:01:48", "text": "那个来源。"}, {"type": "subtitle", "time": 7311.03, "timestamp": "02:01:51", "text": "为什么还没有？让我看看。让我看看。"}, {"type": "subtitle", "time": 7313.669, "timestamp": "02:01:53", "text": "稍等片刻。慢慢来。你"}, {"type": "subtitle", "time": 7315.109, "timestamp": "02:01:55", "text": "甚至连我说话的方式都改变了，"}, {"type": "subtitle", "time": 7317.43, "timestamp": "02:01:57", "text": "老兄。"}, {"type": "subtitle", "time": 7319.589, "timestamp": "02:01:59", "text": "老兄，你改变了我的说话方式。"}]
[{"type": "subtitle", "time": 12841.67, "timestamp": "03:34:01", "text": "我不喜欢和他们谈论的事情"}, {"type": "subtitle", "time": 12843.269, "timestamp": "03:34:03", "text": "只是"}, {"type": "subtitle", "time": 12844.95, "timestamp": "03:34:04", "text": "手表"}, {"type": "subtitle", "time": 12848.469, "timestamp": "03:34:08", "text": "还有你知道的那些事儿。嗯，是啊是啊是啊。"}, {"type": "subtitle", "time": 12851.11, "timestamp": "03:34:11", "text": "你好，Azin。"}, {"type": "subtitle", "time": 12854.309, "timestamp": "03:34:14", "text": "是的，乔·亚利桑那州"}, {"type": "subtitle", "time": 12855.83, "timestamp": "03:34:15", "text": "其实我没跟他打招呼。他刚到这里。"}, {"type": "subtitle", "time": 12857.99, "timestamp": "03:34:17", "text": "待命。别理他。别理他。"}, {"type": "subtitle", "time": 12859.429, "timestamp": "03:34:19", "text": "别理他。你不会说"}, {"type": "subtitle", "time": 12861.75, "timestamp": "03:34:21", "text": "除非他跟你打招呼，否则什么都不跟他打。"}, {"type": "subtitle", "time": 12864.55, "timestamp": "03:34:24", "text": "那样做对他太不公平了。哦，不。那是"}, {"type": "subtitle", "time": 12866.63, "timestamp": "03:34:26", "text": "坏的。你知道你应该先打个招呼"}, {"type": "subtitle", "time": 12868.63, "timestamp": "03:34:28", "text": "这位客人。你知道那是"}, {"type": "subtitle", "time": 12871.91, "timestamp": "03:34:31", "text": "坏的。总之"}, {"type": "subtitle", "time": 12875.429, "timestamp": "03:34:35", "text": "回来了。是啊，事情就是这样。"}, {"type": "subtitle", "time": 12879.349, "timestamp": "03:34:39", "text": "M，你知道我总是看到L。哦，对，你"}, {"type": "subtitle", "time": 12881.11, "timestamp": "03:34:41", "text": "我认识迈克尔·里夫斯，我真的很喜欢他。"}, {"type": "subtitle", "time": 12884.15, "timestamp": "03:34:44", "text": "接触。真是太疯狂了。真是太"}, {"type": "subtitle", "time": 12887.03, "timestamp": "03:34:47", "text": "疯子。我不知道他怎么样"}, {"type": "subtitle", "time": 12890.87, "timestamp": "03:34:50", "text": "你知道，人的思维就是这样运作的。是的。"}, {"type": "subtitle", "time": 12893.269, "timestamp": "03:34:53", "text": "是的。如果我有个那样的朋友，我会……"}, {"type": "subtitle", "time": 12895.51, "timestamp": "03:34:55", "text": "我几乎可以肯定我骨折了"}]
[{"type": "subtitle", "time": 14220.389, "timestamp": "03:57:00", "text": "是的。是的。看着他。他有那种……"}, {"type": "subtitle", "time": 14222.229, "timestamp": "03:57:02", "text": "灯"}, {"type": "subtitle", "time": 14224.95, "timestamp": "03:57:04", "text": "某种小游戏。他当时正在玩那个游戏。我"}, {"type": "subtitle", "time": 14228.389, "timestamp": "03:57:08", "text": "我想我就是从那时起迷上了它。"}, {"type": "subtitle", "time": 14230.87, "timestamp": "03:57:10", "text": "因为他，我开始关注他。我"}, {"type": "subtitle", "time": 14235.189, "timestamp": "03:57:15", "text": "开始看我不知道怎么做"}, {"type": "subtitle", "time": 14238.55, "timestamp": "03:57:18", "text": "读出来。艾克西森"}, {"type": "subtitle", "time": 14241.269, "timestamp": "03:57:21", "text": "我认为是泽拉明。"}, {"type": "subtitle", "time": 14243.91, "timestamp": "03:57:23", "text": "嗯，是啊是啊是啊是啊。"}, {"type": "subtitle", "time": 14246.389, "timestamp": "03:57:26", "text": "我开始观察她，然后我就想通了。"}, {"type": "subtitle", "time": 14248.15, "timestamp": "03:57:28", "text": "苏米"}, {"type": "subtitle", "time": 14250.55, "timestamp": "03:57:30", "text": "呃，她以前有800个订阅者。"}, {"type": "subtitle", "time": 14253.429, "timestamp": "03:57:33", "text": "呃，我开始观察她，"}, {"type": "subtitle", "time": 14255.83, "timestamp": "03:57:35", "text": "因为她，我开始看其他节目。"}, {"type": "subtitle", "time": 14257.59, "timestamp": "03:57:37", "text": "人们，当时我就想："}, {"type": "subtitle", "time": 14259.67, "timestamp": "03:57:39", "text": "我心想我应该这么做。我应该"}, {"type": "subtitle", "time": 14261.349, "timestamp": "03:57:41", "text": "然后我就开始创作音乐。"}, {"type": "subtitle", "time": 14264.87, "timestamp": "03:57:44", "text": "先是看了视频，然后我收到了你的信息。"}, {"type": "subtitle", "time": 14267.51, "timestamp": "03:57:47", "text": "是的。然后我又重新开始了。"}, {"type": "subtitle", "time": 14269.429, "timestamp": "03:57:49", "text": "就像坐过山车一样。真有趣。"}, {"type": "subtitle", "time": 14272.07, "timestamp": "03:57:52", "text": "还不错。"}, {"type": "subtitle", "time": 14273.59, "timestamp": "03:57:53", "text": "是的。"}, {"type": "subtitle", "time": 14276.469, "timestamp": "03:57:56", "text": "我没有那种感觉，我没有大的"}, {"type": "subtitle", "time": 14278.469, "timestamp": "03:57:58", "text": "比如远大的目标和宏伟的抱负。我是"}]
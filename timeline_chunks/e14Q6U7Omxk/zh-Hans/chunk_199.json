[{"type": "subtitle", "time": 11941.67, "timestamp": "03:19:01", "text": "后来我才知道，这种可能性是存在的。"}, {"type": "subtitle", "time": 11944.469, "timestamp": "03:19:04", "text": "代码，嗯，代码，Miko之类的，我当时"}, {"type": "subtitle", "time": 11947.349, "timestamp": "03:19:07", "text": "是的，这是有可能的，然后我就开始了。"}, {"type": "subtitle", "time": 11949.67, "timestamp": "03:19:09", "text": "我研究了一下，然后就想，“是啊，我"}, {"type": "subtitle", "time": 11951.51, "timestamp": "03:19:11", "text": "总有一天可以做到。这将是我的"}, {"type": "subtitle", "time": 11954.389, "timestamp": "03:19:14", "text": "未来的长期目标。我可以试试"}, {"type": "subtitle", "time": 11956.95, "timestamp": "03:19:16", "text": "为了达到那个目的。打破"}, {"type": "subtitle", "time": 11959.83, "timestamp": "03:19:19", "text": "虚拟角色的局限性"}, {"type": "subtitle", "time": 11963.03, "timestamp": "03:19:23", "text": "还有现实等等。我可以打破它"}, {"type": "subtitle", "time": 11966.469, "timestamp": "03:19:26", "text": "不知何故，随着科技进步，我"}, {"type": "subtitle", "time": 11969.19, "timestamp": "03:19:29", "text": "仍然可以做到这一点。举办一场音乐会"}, {"type": "subtitle", "time": 11971.59, "timestamp": "03:19:31", "text": "发布我自己的音乐，播放我自己的音乐"}, {"type": "subtitle", "time": 11974.55, "timestamp": "03:19:34", "text": "并可免费在线观看音乐会。我"}, {"type": "subtitle", "time": 11976.229, "timestamp": "03:19:36", "text": "无需前往其他国家"}, {"type": "subtitle", "time": 11978.71, "timestamp": "03:19:38", "text": "或者用于演唱会之类的。我能做到"}, {"type": "subtitle", "time": 11981.83, "timestamp": "03:19:41", "text": "在 YouTube 和其他所有平台上免费观看"}, {"type": "subtitle", "time": 11983.429, "timestamp": "03:19:43", "text": "是的"}, {"type": "subtitle", "time": 11986.389, "timestamp": "03:19:46", "text": "这就是最初的事情。"}, {"type": "subtitle", "time": 11989.59, "timestamp": "03:19:49", "text": "首先，很抱歉打断你。"}, {"type": "subtitle", "time": 11992.15, "timestamp": "03:19:52", "text": "Surf Singh想了解你，"}, {"type": "subtitle", "time": 11994.55, "timestamp": "03:19:54", "text": "你显然在做什么？"}, {"type": "subtitle", "time": 11997.59, "timestamp": "03:19:57", "text": "joathon 的东西。你能给他一些吗？"}]
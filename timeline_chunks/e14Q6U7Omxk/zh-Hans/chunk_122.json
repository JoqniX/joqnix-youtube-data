[{"type": "subtitle", "time": 7323.43, "timestamp": "02:02:03", "text": "哪一个？如何？稍等片刻。呃，如何"}, {"type": "subtitle", "time": 7325.75, "timestamp": "02:02:05", "text": "这样行得通吗？"}, {"type": "subtitle", "time": 7329.189, "timestamp": "02:02:09", "text": "稍等片刻。好了。好的，我"}, {"type": "subtitle", "time": 7336.87, "timestamp": "02:02:16", "text": "[音乐]"}, {"type": "subtitle", "time": 7339.03, "timestamp": "02:02:19", "text": "你能告诉我这会如何直播吗？"}, {"type": "subtitle", "time": 7340.95, "timestamp": "02:02:20", "text": "东西好用吗？"}, {"type": "subtitle", "time": 7345.27, "timestamp": "02:02:25", "text": "糟糕。呃，是多视图吧？是的。"}, {"type": "subtitle", "time": 7348.229, "timestamp": "02:02:28", "text": "所以观众可以点击链接，"}, {"type": "subtitle", "time": 7351.43, "timestamp": "02:02:31", "text": "他们可以监视我们俩，观察我们各自的行为。"}, {"type": "subtitle", "time": 7354.47, "timestamp": "02:02:34", "text": "对方的视角，以及我们俩的聊天"}, {"type": "subtitle", "time": 7356.31, "timestamp": "02:02:36", "text": "呃，还有聊天。只需确认一下"}, {"type": "subtitle", "time": 7358.55, "timestamp": "02:02:38", "text": "您已登录 Google，"}, {"type": "subtitle", "time": 7360.79, "timestamp": "02:02:40", "text": "一切。好的。那我应该把它发给"}, {"type": "subtitle", "time": 7363.91, "timestamp": "02:02:43", "text": "我的聊天记录？你可以把它放进去"}, {"type": "subtitle", "time": 7366.55, "timestamp": "02:02:46", "text": "在置顶评论中。是的。对于多种"}, {"type": "subtitle", "time": 7368.31, "timestamp": "02:02:48", "text": "正在观看。是的。稍等片刻。好的。"}, {"type": "subtitle", "time": 7369.83, "timestamp": "02:02:49", "text": "他们现在问是因为你是谁。"}, {"type": "subtitle", "time": 7372.229, "timestamp": "02:02:52", "text": "跟富士技术人员聊聊什么的"}, {"type": "subtitle", "time": 7373.91, "timestamp": "02:02:53", "text": "东西还在旋转，他们不能"}, {"type": "subtitle", "time": 7376.79, "timestamp": "02:02:56", "text": "看看你的PNG文件之类的。所以这就是原因"}]
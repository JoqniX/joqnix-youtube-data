[{"type": "subtitle", "time": 5461.189, "timestamp": "01:31:01", "text": "显然没有"}, {"type": "subtitle", "time": 5463.27, "timestamp": "01:31:03", "text": "想想我的处境，我应该"}, {"type": "subtitle", "time": 5466.95, "timestamp": "01:31:06", "text": "不要贸然行动。为什么会这样说"}, {"type": "subtitle", "time": 5470.39, "timestamp": "01:31:10", "text": "断开连接了吗？我断线了吗？"}, {"type": "subtitle", "time": 5472.39, "timestamp": "01:31:12", "text": "等等，什么？"}, {"type": "subtitle", "time": 5474.79, "timestamp": "01:31:14", "text": "等等，我的直播是不是断线了？不，"}, {"type": "subtitle", "time": 5481.43, "timestamp": "01:31:21", "text": "是的，我"}, {"type": "subtitle", "time": 5483.35, "timestamp": "01:31:23", "text": "当然不是。我不会那样做。是的，"}, {"type": "subtitle", "time": 5486.55, "timestamp": "01:31:26", "text": "我不会那样做。我受够了。我是"}, {"type": "subtitle", "time": 5489.59, "timestamp": "01:31:29", "text": "那些事都处理完了。"}, {"type": "subtitle", "time": 5505.27, "timestamp": "01:31:45", "text": "等等，我的直播是不是崩溃了？不。对。"}]
[{"type": "subtitle", "time": 11581.83, "timestamp": "03:13:01", "text": "我挑战了自己，然后我就能……"}, {"type": "subtitle", "time": 11583.75, "timestamp": "03:13:03", "text": "做直播等等。然后我"}, {"type": "subtitle", "time": 11588.07, "timestamp": "03:13:08", "text": "自从我开始接触这个以来，呃，就是那时候"}, {"type": "subtitle", "time": 11591.429, "timestamp": "03:13:11", "text": "168年那会儿我迷上了动漫和唐吉"}, {"type": "subtitle", "time": 11594.87, "timestamp": "03:13:14", "text": "那段时间，我发现，所以我是"}, {"type": "subtitle", "time": 11596.71, "timestamp": "03:13:16", "text": "我也应该努力成为一名"}, {"type": "subtitle", "time": 11599.75, "timestamp": "03:13:19", "text": "YouTuber。然后我再次检查了是否有"}, {"type": "subtitle", "time": 11601.59, "timestamp": "03:13:21", "text": "任何印度YouTube博主。然后我意识到"}, {"type": "subtitle", "time": 11604.71, "timestamp": "03:13:24", "text": "有个叫nisanji India的东西，还有"}, {"type": "subtitle", "time": 11608.229, "timestamp": "03:13:28", "text": "我错过了试镜，就像……"}, {"type": "subtitle", "time": 11612.15, "timestamp": "03:13:32", "text": "那天就像第二天一样，呃……"}, {"type": "subtitle", "time": 11614.469, "timestamp": "03:13:34", "text": "你怎么形容试镜时的情景呢？"}, {"type": "subtitle", "time": 11616.79, "timestamp": "03:13:36", "text": "昨天我查了一下，发现"}, {"type": "subtitle", "time": 11619.83, "timestamp": "03:13:39", "text": "确实存在过这种事。"}, {"type": "subtitle", "time": 11623.59, "timestamp": "03:13:43", "text": "是的，我，我，我错过了一天。"}, {"type": "subtitle", "time": 11625.51, "timestamp": "03:13:45", "text": "我之前不知道，当时觉得特别有意思。"}, {"type": "subtitle", "time": 11627.83, "timestamp": "03:13:47", "text": "尼桑吉要来印度了，哇！"}, {"type": "subtitle", "time": 11630.55, "timestamp": "03:13:50", "text": "我以前每天都看它们，而且我"}, {"type": "subtitle", "time": 11632.15, "timestamp": "03:13:52", "text": "不知道他们像印第安人一样被对待"}, {"type": "subtitle", "time": 11634.95, "timestamp": "03:13:54", "text": "品牌之类的东西真是太棒了。"}, {"type": "subtitle", "time": 11636.79, "timestamp": "03:13:56", "text": "开始看他们的视频后，我意识到"}, {"type": "subtitle", "time": 11639.91, "timestamp": "03:13:59", "text": "没有印度裔的YouTube博主，"}]
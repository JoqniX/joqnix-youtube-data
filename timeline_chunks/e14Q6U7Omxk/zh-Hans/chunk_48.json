[{"type": "subtitle", "time": 2883.829, "timestamp": "00:48:03", "text": "日历。正是如此。我见过，呃，我见过"}, {"type": "subtitle", "time": 2888.95, "timestamp": "00:48:08", "text": "看到了，嗯，她叫什么名字来着？寿司儿子"}, {"type": "subtitle", "time": 2893.75, "timestamp": "00:48:13", "text": "在她的小玩意儿上做"}, {"type": "subtitle", "time": 2899.19, "timestamp": "00:48:19", "text": "嗯，在她的日程安排上。她过去常常补充说喜欢"}, {"type": "subtitle", "time": 2903.51, "timestamp": "00:48:23", "text": "那它叫什么呢？"}, {"type": "subtitle", "time": 2905.27, "timestamp": "00:48:25", "text": "她过去常常补充说，比如，你叫什么来着？"}, {"type": "subtitle", "time": 2907.829, "timestamp": "00:48:27", "text": "它？它就像谷歌日历一样。"}, {"type": "subtitle", "time": 2911.829, "timestamp": "00:48:31", "text": "还有一些适用于 iOS 2 的其他 iOS 设备"}, {"type": "subtitle", "time": 2914.23, "timestamp": "00:48:34", "text": "用户。他们还会有别的什么东西。"}, {"type": "subtitle", "time": 2918.15, "timestamp": "00:48:38", "text": "是的。所以，我会把它们添加到我的"}, {"type": "subtitle", "time": 2922.549, "timestamp": "00:48:42", "text": "这样你就能收到通知了。"}, {"type": "subtitle", "time": 2926.23, "timestamp": "00:48:46", "text": "并设置提醒"}, {"type": "subtitle", "time": 2929.03, "timestamp": "00:48:49", "text": "以免你忘记。"}, {"type": "subtitle", "time": 2931.91, "timestamp": "00:48:51", "text": "嘿。你好。就是这样。这就是我想要的全部。"}, {"type": "subtitle", "time": 2935.589, "timestamp": "00:48:55", "text": "今天要谈的话题。和"}, {"type": "subtitle", "time": 2939.589, "timestamp": "00:48:59", "text": "感谢你在这里听我说话。"}]
[{"type": "subtitle", "time": 4745.27, "timestamp": "01:19:05", "text": "太过分了，不，不，就像"}, {"type": "subtitle", "time": 4748.149, "timestamp": "01:19:08", "text": "自私地接近这类人"}, {"type": "subtitle", "time": 4750.229, "timestamp": "01:19:10", "text": "寻求帮助，并帮助，帮助"}, {"type": "subtitle", "time": 4754.79, "timestamp": "01:19:14", "text": "感觉有点像，嗯，就是这样。"}, {"type": "subtitle", "time": 4756.95, "timestamp": "01:19:16", "text": "不是我"}, {"type": "subtitle", "time": 4759.669, "timestamp": "01:19:19", "text": "那很糟糕。"}, {"type": "subtitle", "time": 4765.99, "timestamp": "01:19:25", "text": "哎呀，我的风扇不转了。不"}, {"type": "subtitle", "time": 4773.35, "timestamp": "01:19:33", "text": "疼痛。我不知道我当时喜欢什么。"}, {"type": "subtitle", "time": 4781.51, "timestamp": "01:19:41", "text": "很多东西。"}, {"type": "subtitle", "time": 4784.149, "timestamp": "01:19:44", "text": "人们如何"}, {"type": "subtitle", "time": 4788.39, "timestamp": "01:19:48", "text": "人们是如何管理所有事情的？"}, {"type": "subtitle", "time": 4791.11, "timestamp": "01:19:51", "text": "我有点"}, {"type": "subtitle", "time": 4794.31, "timestamp": "01:19:54", "text": "说实话，但是……"}, {"type": "subtitle", "time": 4795.91, "timestamp": "01:19:55", "text": "最后我并不觉得难过。当然我会"}, {"type": "subtitle", "time": 4799.11, "timestamp": "01:19:59", "text": "感觉很糟糕。你知道我有多么……"}]
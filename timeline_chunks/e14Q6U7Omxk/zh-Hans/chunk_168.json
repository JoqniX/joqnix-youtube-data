[{"type": "subtitle", "time": 10080.07, "timestamp": "02:48:00", "text": "我正在练习Jakata，这对我很有帮助。"}, {"type": "subtitle", "time": 10082.87, "timestamp": "02:48:02", "text": "比如在直播的时候做，因为那样的话……"}, {"type": "subtitle", "time": 10085.269, "timestamp": "02:48:05", "text": "我现在什么也做不了。我大概是无聊吧。"}, {"type": "subtitle", "time": 10088.79, "timestamp": "02:48:08", "text": "我不知道。嗯，那我继续学习。"}, {"type": "subtitle", "time": 10091.19, "timestamp": "02:48:11", "text": "溪流。所以有视觉证据，对吧？"}, {"type": "subtitle", "time": 10096.95, "timestamp": "02:48:16", "text": "嗯，我以前经常那样做，同时……"}, {"type": "subtitle", "time": 10100.07, "timestamp": "02:48:20", "text": "嗯，就在我上课的时候……"}, {"type": "subtitle", "time": 10102.469, "timestamp": "02:48:22", "text": "在约顿之前。我以前也这样做过"}, {"type": "subtitle", "time": 10105.67, "timestamp": "02:48:25", "text": "到时候。嗯，还有剧院，我也告诉过。"}, {"type": "subtitle", "time": 10107.99, "timestamp": "02:48:27", "text": "他跟我谈了我的管子等等所有事情"}, {"type": "subtitle", "time": 10110.15, "timestamp": "02:48:30", "text": "他也跟着我，从某个地方监视我。"}, {"type": "subtitle", "time": 10112.87, "timestamp": "02:48:32", "text": "抽搐。所以他也看到了我正在投入"}, {"type": "subtitle", "time": 10116.15, "timestamp": "02:48:36", "text": "在直播中做作业的时间"}, {"type": "subtitle", "time": 10118.309, "timestamp": "02:48:38", "text": "诸如此类的事情。这笔费用已列入预算。"}, {"type": "subtitle", "time": 10122.71, "timestamp": "02:48:42", "text": "是的。是的。所以，呃，现在他知道了。"}, {"type": "subtitle", "time": 10125.03, "timestamp": "02:48:45", "text": "嗯。你的意思是？"}, {"type": "subtitle", "time": 10127.269, "timestamp": "02:48:47", "text": "是的。是的。想象一下检查你的点赞数"}, {"type": "subtitle", "time": 10129.349, "timestamp": "02:48:49", "text": "作为一名教师，检查你的学生就像"}, {"type": "subtitle", "time": 10131.269, "timestamp": "02:48:51", "text": "学习就像工作一样"}, {"type": "subtitle", "time": 10133.83, "timestamp": "02:48:53", "text": "那样的时光是最好的。"}, {"type": "subtitle", "time": 10136.87, "timestamp": "02:48:56", "text": "你的学生这样做。不。"}]
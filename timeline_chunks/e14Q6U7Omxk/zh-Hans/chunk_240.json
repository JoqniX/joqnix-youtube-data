[{"type": "subtitle", "time": 14400.15, "timestamp": "04:00:00", "text": "事情是这样的，有一次我只有1个"}, {"type": "subtitle", "time": 14404.229, "timestamp": "04:00:04", "text": "该投资组合中包含一些 Kros。"}, {"type": "subtitle", "time": 14406.389, "timestamp": "04:00:06", "text": "是的。那个人说，呃，然后"}, {"type": "subtitle", "time": 14409.11, "timestamp": "04:00:09", "text": "对方不再回复我了。我试过"}, {"type": "subtitle", "time": 14414.07, "timestamp": "04:00:14", "text": "提取我的钱。没有。呃"}, {"type": "subtitle", "time": 14418.469, "timestamp": "04:00:18", "text": "呃，钱没到账。呃，那个"}, {"type": "subtitle", "time": 14420.55, "timestamp": "04:00:20", "text": "网站被禁"}, {"type": "subtitle", "time": 14423.189, "timestamp": "04:00:23", "text": "Discord 服务器也被封禁了。"}, {"type": "subtitle", "time": 14427.269, "timestamp": "04:00:27", "text": "所以我的1cr也全都只是漂浮着而已。"}, {"type": "subtitle", "time": 14430.71, "timestamp": "04:00:30", "text": "在那边的某个地方。"}, {"type": "subtitle", "time": 14432.79, "timestamp": "04:00:32", "text": "那首歌非常受欢迎。但我只是"}, {"type": "subtitle", "time": 14436.87, "timestamp": "04:00:36", "text": "我已经解释过了。其实才100美元。"}, {"type": "subtitle", "time": 14439.03, "timestamp": "04:00:39", "text": "即使是这笔钱也是一大笔钱。但是，嗯，是的。"}, {"type": "subtitle", "time": 14441.429, "timestamp": "04:00:41", "text": "这是一次学习经历。"}, {"type": "subtitle", "time": 14444.07, "timestamp": "04:00:44", "text": "不，别解释，呃，别相信"}, {"type": "subtitle", "time": 14447.429, "timestamp": "04:00:47", "text": "陌生人。就是这样。"}, {"type": "subtitle", "time": 14449.67, "timestamp": "04:00:49", "text": "没错，没错，没错。"}, {"type": "subtitle", "time": 14452.309, "timestamp": "04:00:52", "text": "这是一段旅程。我当时就像……"}, {"type": "subtitle", "time": 14454.229, "timestamp": "04:00:54", "text": "大概两天都受到了创伤，但仅此而已。"}, {"type": "subtitle", "time": 14459.429, "timestamp": "04:00:59", "text": "这笔钱现在简直可以改变人生了。"}]
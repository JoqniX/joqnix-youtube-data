[{"type": "subtitle", "time": 14822.15, "timestamp": "04:07:02", "text": "快乐的。是的。我更开心了，伙计。我是"}, {"type": "subtitle", "time": 14824.07, "timestamp": "04:07:04", "text": "如果能找到像你这样的人，我会更加高兴。"}, {"type": "subtitle", "time": 14825.91, "timestamp": "04:07:05", "text": "我说的是实话。"}, {"type": "subtitle", "time": 14828.79, "timestamp": "04:07:08", "text": "是啊，真的很好玩。"}, {"type": "subtitle", "time": 14831.03, "timestamp": "04:07:11", "text": "但我感觉我不太了解那里。"}, {"type": "subtitle", "time": 14833.03, "timestamp": "04:07:13", "text": "现在也会有像我一样的人了。我"}, {"type": "subtitle", "time": 14835.51, "timestamp": "04:07:15", "text": "不知道。"}, {"type": "subtitle", "time": 14838.229, "timestamp": "04:07:18", "text": "如果我能找到，我会非常高兴的。"}, {"type": "subtitle", "time": 14841.51, "timestamp": "04:07:21", "text": "像你这样的人。是的，我真的"}, {"type": "subtitle", "time": 14843.91, "timestamp": "04:07:23", "text": "很高兴能见到你。我们有"}, {"type": "subtitle", "time": 14846.229, "timestamp": "04:07:26", "text": "一次愉快的聊天。我们玩得很开心，比如"}, {"type": "subtitle", "time": 14848.87, "timestamp": "04:07:28", "text": "测验。他分享了我们的东西，"}, {"type": "subtitle", "time": 14850.95, "timestamp": "04:07:30", "text": "东西很多，也有人。谢天谢地"}, {"type": "subtitle", "time": 14854.95, "timestamp": "04:07:34", "text": "我以为我可能会像一条空溪流一样。"}, {"type": "subtitle", "time": 14857.429, "timestamp": "04:07:37", "text": "但幸好人们来了。我们有"}, {"type": "subtitle", "time": 14861.269, "timestamp": "04:07:41", "text": "聊得很开心，我喜欢这次聊天。我爱"}, {"type": "subtitle", "time": 14865.189, "timestamp": "04:07:45", "text": "它。希望你的跑步比赛一切顺利。"}, {"type": "subtitle", "time": 14868.309, "timestamp": "04:07:48", "text": "你会完成你的哦，对了，记得"}, {"type": "subtitle", "time": 14870.79, "timestamp": "04:07:50", "text": "学习时要保持背部挺直。别呃"}, {"type": "subtitle", "time": 14872.389, "timestamp": "04:07:52", "text": "流媒体不会忘记它们。全部"}, {"type": "subtitle", "time": 14875.99, "timestamp": "04:07:55", "text": "正确的。是的。一定要争取！"}, {"type": "subtitle", "time": 14877.91, "timestamp": "04:07:57", "text": "我也会检查一下你其他的接缝。"}]
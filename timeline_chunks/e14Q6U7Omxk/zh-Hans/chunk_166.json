[{"type": "subtitle", "time": 9961.59, "timestamp": "02:46:01", "text": "把它完成，对吧？一个接一个地做"}, {"type": "subtitle", "time": 9963.59, "timestamp": "02:46:03", "text": "就像我以前那样"}, {"type": "subtitle", "time": 9966.389, "timestamp": "02:46:06", "text": "一开始，一个人一天或两天，或者"}, {"type": "subtitle", "time": 9968.23, "timestamp": "02:46:08", "text": "比如花一整天或者半天时间"}, {"type": "subtitle", "time": 9971.75, "timestamp": "02:46:11", "text": "每天和一个人待2到3个小时。"}, {"type": "subtitle", "time": 9973.99, "timestamp": "02:46:13", "text": "是的。"}, {"type": "subtitle", "time": 9978.63, "timestamp": "02:46:18", "text": "更好，因为现在你可以拥有"}, {"type": "subtitle", "time": 9980.71, "timestamp": "02:46:20", "text": "那些在之前建立的联系，比如"}, {"type": "subtitle", "time": 9982.63, "timestamp": "02:46:22", "text": "就像快速的“嗨，你好，这是……”"}, {"type": "subtitle", "time": 9984.63, "timestamp": "02:46:24", "text": "我就是这样，这就是他。"}, {"type": "subtitle", "time": 9986.87, "timestamp": "02:46:26", "text": "我正在做这件事，而且我喜欢这样做。"}, {"type": "subtitle", "time": 9988.63, "timestamp": "02:46:28", "text": "你最近怎么样？还有其他一些类似的事情。"}, {"type": "subtitle", "time": 9990.95, "timestamp": "02:46:30", "text": "这样你现在就可以尽情享受了。"}, {"type": "subtitle", "time": 9993.51, "timestamp": "02:46:33", "text": "可以和大家一起享受美好时光"}, {"type": "subtitle", "time": 9995.429, "timestamp": "02:46:35", "text": "是的"}, {"type": "subtitle", "time": 9998.15, "timestamp": "02:46:38", "text": "一切都有优点，或者说，有些优点。"}, {"type": "subtitle", "time": 10000.23, "timestamp": "02:46:40", "text": "不过，总之我希望如此。"}, {"type": "subtitle", "time": 10002.87, "timestamp": "02:46:42", "text": "你一切都很顺利，因为"}, {"type": "subtitle", "time": 10005.19, "timestamp": "02:46:45", "text": "呃，当你展示你的点赞日程表时"}, {"type": "subtitle", "time": 10007.11, "timestamp": "02:46:47", "text": "比如晚上的课程安排。哦，我的"}, {"type": "subtitle", "time": 10011.429, "timestamp": "02:46:51", "text": "上帝。我差点也心脏病发作了。"}, {"type": "subtitle", "time": 10013.83, "timestamp": "02:46:53", "text": "是的。一切都是紫色的，"}, {"type": "subtitle", "time": 10015.269, "timestamp": "02:46:55", "text": "我当时就想，“糟了，他要走了。”"}, {"type": "subtitle", "time": 10019.269, "timestamp": "02:46:59", "text": "要学那么多东西。”哪个？呃，我……"}]
[{"type": "subtitle", "time": 13382.15, "timestamp": "03:43:02", "text": "嗯，"}, {"type": "subtitle", "time": 13384.55, "timestamp": "03:43:04", "text": "我该怎么说呢？嗯，我想我喜欢"}, {"type": "subtitle", "time": 13387.75, "timestamp": "03:43:07", "text": "我在思考的时候用了英语，但是"}, {"type": "subtitle", "time": 13390.309, "timestamp": "03:43:10", "text": "社会学老师是我们班的老师"}, {"type": "subtitle", "time": 13392.309, "timestamp": "03:43:12", "text": "我是一名教师，所以我喜欢社会学。我当时"}, {"type": "subtitle", "time": 13395.59, "timestamp": "03:43:15", "text": "我对社会学非常感兴趣，但是我"}, {"type": "subtitle", "time": 13398.469, "timestamp": "03:43:18", "text": "睡着了。"}, {"type": "subtitle", "time": 13401.75, "timestamp": "03:43:21", "text": "因为我以前凌晨五点才睡觉。"}, {"type": "subtitle", "time": 13403.59, "timestamp": "03:43:23", "text": "东西，我以前经常吃。"}, {"type": "subtitle", "time": 13407.11, "timestamp": "03:43:27", "text": "一些药品之类的东西，里面有……"}, {"type": "subtitle", "time": 13409.67, "timestamp": "03:43:29", "text": "后效。所以当时我正在午睡"}, {"type": "subtitle", "time": 13413.11, "timestamp": "03:43:33", "text": "从上午到下午都有课"}, {"type": "subtitle", "time": 13415.189, "timestamp": "03:43:35", "text": "某物。"}, {"type": "subtitle", "time": 13418.309, "timestamp": "03:43:38", "text": "所以，嗯，老师和学生们"}, {"type": "subtitle", "time": 13420.15, "timestamp": "03:43:40", "text": "大家都叫我睡美人"}, {"type": "subtitle", "time": 13423.349, "timestamp": "03:43:43", "text": "因为我睡懒觉，所以……"}, {"type": "subtitle", "time": 13426.63, "timestamp": "03:43:46", "text": "班级。是的。你的专业是什么？"}, {"type": "subtitle", "time": 13429.59, "timestamp": "03:43:49", "text": "大学？我正在学英语。"}, {"type": "subtitle", "time": 13431.67, "timestamp": "03:43:51", "text": "文学荣誉。我正在做忽略"}, {"type": "subtitle", "time": 13433.189, "timestamp": "03:43:53", "text": "东西。"}, {"type": "subtitle", "time": 13435.189, "timestamp": "03:43:55", "text": "是的，他很聪明，你知道的。"}, {"type": "subtitle", "time": 13438.55, "timestamp": "03:43:58", "text": "他……我甚至……不，不，不，不。让我"}]
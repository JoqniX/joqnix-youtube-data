[{"type": "subtitle", "time": 11462.309, "timestamp": "03:11:02", "text": "其他技能，比如画画，我自己"}, {"type": "subtitle", "time": 11465.19, "timestamp": "03:11:05", "text": "如何用 Illustrator 制作 logo。"}, {"type": "subtitle", "time": 11467.67, "timestamp": "03:11:07", "text": "然后，呃，因为我想自己做一个。"}, {"type": "subtitle", "time": 11470.55, "timestamp": "03:11:10", "text": "我试图浏览的商品"}, {"type": "subtitle", "time": 11472.469, "timestamp": "03:11:12", "text": "YouTube上的时装设计教程"}, {"type": "subtitle", "time": 11475.19, "timestamp": "03:11:15", "text": "以及诸如此类的事情。然后我"}, {"type": "subtitle", "time": 11477.19, "timestamp": "03:11:17", "text": "意识到我在以下方面有所欠缺"}, {"type": "subtitle", "time": 11480.309, "timestamp": "03:11:20", "text": "音乐方面的东西，因为我不知道怎么做。"}, {"type": "subtitle", "time": 11482.469, "timestamp": "03:11:22", "text": "事情就是这样。看了好多教程"}, {"type": "subtitle", "time": 11486.389, "timestamp": "03:11:26", "text": "FL Studio 用得我筋疲力尽。所以我得到了"}, {"type": "subtitle", "time": 11488.309, "timestamp": "03:11:28", "text": "那些人遇到了音乐创作瓶颈，而我"}, {"type": "subtitle", "time": 11490.63, "timestamp": "03:11:30", "text": "无法继续进行下去。于是我迈步"}, {"type": "subtitle", "time": 11493.75, "timestamp": "03:11:33", "text": "转而关注其他创意活动"}, {"type": "subtitle", "time": 11497.83, "timestamp": "03:11:37", "text": "呃，细分市场。然后我就想，也许我可以"}, {"type": "subtitle", "time": 11499.99, "timestamp": "03:11:39", "text": "试着成为一名 YouTuber 之类的。"}, {"type": "subtitle", "time": 11502.23, "timestamp": "03:11:42", "text": "但后来我意识到，我太害羞了，不敢示人。"}, {"type": "subtitle", "time": 11505.349, "timestamp": "03:11:45", "text": "我的脸。但我仍然尝试模仿他的做法"}, {"type": "subtitle", "time": 11508.87, "timestamp": "03:11:48", "text": "人们过去常常会做那种“呃”之类的动作，你知道的"}, {"type": "subtitle", "time": 11511.51, "timestamp": "03:11:51", "text": "就像Logan Paul那样，他们也做vlog的开头。"}, {"type": "subtitle", "time": 11513.91, "timestamp": "03:11:53", "text": "嘿，大家好吗？那就是我"}, {"type": "subtitle", "time": 11516.23, "timestamp": "03:11:56", "text": "我试过了。真是太尴尬了。我"}]
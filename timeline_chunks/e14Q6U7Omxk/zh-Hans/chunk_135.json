[{"type": "subtitle", "time": 8100.069, "timestamp": "02:15:00", "text": "进入藏身处，呃，那个地方"}, {"type": "subtitle", "time": 8101.99, "timestamp": "02:15:01", "text": "那家伙藏在哪里，然后就杀了他"}, {"type": "subtitle", "time": 8104.069, "timestamp": "02:15:04", "text": "当场抓住他。"}, {"type": "subtitle", "time": 8106.709, "timestamp": "02:15:06", "text": "是的。这三个答案都是"}, {"type": "subtitle", "time": 8108.55, "timestamp": "02:15:08", "text": "实际上，这些是和我一起写的。"}, {"type": "subtitle", "time": 8111.03, "timestamp": "02:15:11", "text": "正常答案。什么？我其实有"}, {"type": "subtitle", "time": 8113.35, "timestamp": "02:15:13", "text": "写下它们。是的。精神病患者"}, {"type": "subtitle", "time": 8116.87, "timestamp": "02:15:16", "text": "答案是，劫匪会去……"}, {"type": "subtitle", "time": 8119.75, "timestamp": "02:15:19", "text": "门，开门，关门"}, {"type": "subtitle", "time": 8122.55, "timestamp": "02:15:22", "text": "像大门一样，然后默默地走开"}, {"type": "subtitle", "time": 8124.79, "timestamp": "02:15:24", "text": "在衣橱附近等着那个人"}, {"type": "subtitle", "time": 8134.31, "timestamp": "02:15:34", "text": "哦，这真是个聪明的举动。"}, {"type": "subtitle", "time": 8136.709, "timestamp": "02:15:36", "text": "那人会想，哦，劫匪走了，但是"}, {"type": "subtitle", "time": 8139.589, "timestamp": "02:15:39", "text": "他会出来然后被抓。"}, {"type": "subtitle", "time": 8141.35, "timestamp": "02:15:41", "text": "是啊，那件糟透了的事。我得到了这个"}, {"type": "subtitle", "time": 8146.069, "timestamp": "02:15:46", "text": "直奔主题。是的。是的。它是"}, {"type": "subtitle", "time": 8148.229, "timestamp": "02:15:48", "text": "诡异的。是的。我不知道，伙计。我当时"}, {"type": "subtitle", "time": 8149.99, "timestamp": "02:15:49", "text": "我真的非常兴奋，所以我就开始了。"}, {"type": "subtitle", "time": 8151.669, "timestamp": "02:15:51", "text": "看东西的时候，我做了一些测试。"}, {"type": "subtitle", "time": 8153.75, "timestamp": "02:15:53", "text": "诸如此类的事情，你知道的。如果说有什么的话，那就是我们"}, {"type": "subtitle", "time": 8155.589, "timestamp": "02:15:55", "text": "你知道，可以从中剪辑出一些片段。"}]
[{"type": "subtitle", "time": 13321.83, "timestamp": "03:42:01", "text": "部分。是的，我真的很喜欢宗教。"}, {"type": "subtitle", "time": 13323.349, "timestamp": "03:42:03", "text": "诸如此类的事情。我真的很想知道如何"}, {"type": "subtitle", "time": 13325.11, "timestamp": "03:42:05", "text": "一切都由此开始，诸如此类。"}, {"type": "subtitle", "time": 13327.91, "timestamp": "03:42:07", "text": "你知道。嗯。"}, {"type": "subtitle", "time": 13330.07, "timestamp": "03:42:10", "text": "你呢？你的专业是什么？"}, {"type": "subtitle", "time": 13332.07, "timestamp": "03:42:12", "text": "就是这件事让我印象特别深刻。"}, {"type": "subtitle", "time": 13334.71, "timestamp": "03:42:14", "text": "你？我纯属偶然地选修了社会学。"}, {"type": "subtitle", "time": 13336.95, "timestamp": "03:42:16", "text": "从那时起，一件大事就此展开。"}, {"type": "subtitle", "time": 13339.03, "timestamp": "03:42:19", "text": "我说我喜欢一切。但是什么"}, {"type": "subtitle", "time": 13341.83, "timestamp": "03:42:21", "text": "你呢？别担心山海。"}, {"type": "subtitle", "time": 13349.51, "timestamp": "03:42:29", "text": "你给我的就像你没给我的就像"}, {"type": "subtitle", "time": 13352.469, "timestamp": "03:42:32", "text": "有点数学的感觉。不，我拿走了"}, {"type": "subtitle", "time": 13356.15, "timestamp": "03:42:36", "text": "社会学。哦，不。呃，人文学科。"}, {"type": "subtitle", "time": 13357.99, "timestamp": "03:42:37", "text": "是的。是的。是的。是的。我是这么想的。我"}, {"type": "subtitle", "time": 13361.11, "timestamp": "03:42:41", "text": "想想人文科学领域，比如什么？"}, {"type": "subtitle", "time": 13365.11, "timestamp": "03:42:45", "text": "那是你最喜欢的吗？主要的那个？嗯，"}, {"type": "subtitle", "time": 13366.87, "timestamp": "03:42:46", "text": "我并没有假装你不在这里，"}, {"type": "subtitle", "time": 13369.429, "timestamp": "03:42:49", "text": "前辈。就像我们的客人在这里一样，你"}, {"type": "subtitle", "time": 13371.349, "timestamp": "03:42:51", "text": "知道，就像给他一些一样。"}, {"type": "subtitle", "time": 13375.349, "timestamp": "03:42:55", "text": "你知道，珍珠奶茶？好的，我们开始吧。"}, {"type": "subtitle", "time": 13377.19, "timestamp": "03:42:57", "text": "和他聊了一会儿。好的，继续。"}, {"type": "subtitle", "time": 13379.51, "timestamp": "03:42:59", "text": "打扰您了，不好意思。"}]
[{"type": "subtitle", "time": 14342.71, "timestamp": "03:59:02", "text": "我做了。我开始的时候，呃，每当他"}, {"type": "subtitle", "time": 14346.309, "timestamp": "03:59:06", "text": "他说要进入股市，"}, {"type": "subtitle", "time": 14348.79, "timestamp": "03:59:08", "text": "加密货币市场，我会参与其中，然后他"}, {"type": "subtitle", "time": 14350.63, "timestamp": "03:59:10", "text": "会向我解释，比如现在买入、卖出"}, {"type": "subtitle", "time": 14353.349, "timestamp": "03:59:13", "text": "现在买，现在卖。而且他会"}, {"type": "subtitle", "time": 14356.15, "timestamp": "03:59:16", "text": "用两到三百人做这件事"}, {"type": "subtitle", "time": 14358.229, "timestamp": "03:59:18", "text": "更多的。就像我们都参与其中一样，我们"}, {"type": "subtitle", "time": 14361.59, "timestamp": "03:59:21", "text": "所有人都通过这个Discord频道看到他。"}, {"type": "subtitle", "time": 14364.389, "timestamp": "03:59:24", "text": "他会做的就是他会"}, {"type": "subtitle", "time": 14367.51, "timestamp": "03:59:27", "text": "告诉你如何买卖。所以这有点像"}, {"type": "subtitle", "time": 14369.99, "timestamp": "03:59:29", "text": "非法的。说实话，是"}, {"type": "subtitle", "time": 14373.189, "timestamp": "03:59:33", "text": "提高价格是违法的，然后"}, {"type": "subtitle", "time": 14375.83, "timestamp": "03:59:35", "text": "像那样在大繁荣之后卖掉它"}, {"type": "subtitle", "time": 14378.229, "timestamp": "03:59:38", "text": "损失是因为人们现在赔钱了"}, {"type": "subtitle", "time": 14380.55, "timestamp": "03:59:40", "text": "因为如果你投入资金的时候"}, {"type": "subtitle", "time": 14382.79, "timestamp": "03:59:42", "text": "在上升部分，也有人"}, {"type": "subtitle", "time": 14384.63, "timestamp": "03:59:44", "text": "当你服用药物时，请放入"}, {"type": "subtitle", "time": 14386.07, "timestamp": "03:59:46", "text": "资金账户及其造成的后果"}, {"type": "subtitle", "time": 14390.389, "timestamp": "03:59:50", "text": "亏损，对吧？所以这在圣巴巴拉是违法的。"}, {"type": "subtitle", "time": 14392.309, "timestamp": "03:59:52", "text": "但当时加密货币已经"}, {"type": "subtitle", "time": 14393.91, "timestamp": "03:59:53", "text": "非法的。这完全说不通。"}, {"type": "subtitle", "time": 14396.79, "timestamp": "03:59:56", "text": "这种现象在印度并不普遍。所以呢"}]
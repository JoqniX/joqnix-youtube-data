[{"type": "subtitle", "time": 2163.51, "timestamp": "00:36:03", "text": "所以我不想……呃，任何人的情绪或者……"}, {"type": "subtitle", "time": 2166.31, "timestamp": "00:36:06", "text": "他们情况会变得更糟，因为他们看到了我们，或者"}, {"type": "subtitle", "time": 2168.63, "timestamp": "00:36:08", "text": "类似仇恨指令之类的东西"}, {"type": "subtitle", "time": 2170.87, "timestamp": "00:36:10", "text": "聊天记录中或类似内容的任何内容"}, {"type": "subtitle", "time": 2173.589, "timestamp": "00:36:13", "text": "诸如此类的事情。好的。"}, {"type": "subtitle", "time": 2175.589, "timestamp": "00:36:15", "text": "别忘了保持可爱哦。那就是"}, {"type": "subtitle", "time": 2181.589, "timestamp": "00:36:21", "text": "很抱歉我没能多陪陪她。"}, {"type": "subtitle", "time": 2185.349, "timestamp": "00:36:25", "text": "不，没关系。不用担心。你知道，"}, {"type": "subtitle", "time": 2187.349, "timestamp": "00:36:27", "text": "你知道，你知道，我一直……"}, {"type": "subtitle", "time": 2190.63, "timestamp": "00:36:30", "text": "一直在独自一人移动和直播"}, {"type": "subtitle", "time": 2194.63, "timestamp": "00:36:34", "text": "就像几年一样。所以，我习惯了喜欢moing"}, {"type": "subtitle", "time": 2196.47, "timestamp": "00:36:36", "text": "我。"}, {"type": "subtitle", "time": 2198.15, "timestamp": "00:36:38", "text": "是的。但有时当涉及到"}, {"type": "subtitle", "time": 2200.63, "timestamp": "00:36:40", "text": "合作直播或者类似游戏，而不是游戏"}, {"type": "subtitle", "time": 2202.87, "timestamp": "00:36:42", "text": "直播，但合作直播，当我输掉的时候"}, {"type": "subtitle", "time": 2206.069, "timestamp": "00:36:46", "text": "聊天的重点，就是我……"}, {"type": "subtitle", "time": 2210.71, "timestamp": "00:36:50", "text": "可以说，他很脆弱。"}, {"type": "subtitle", "time": 2214.069, "timestamp": "00:36:54", "text": "不过，除此之外，我一直……"}, {"type": "subtitle", "time": 2216.47, "timestamp": "00:36:56", "text": "呃，如果你不在场也没关系。"}]
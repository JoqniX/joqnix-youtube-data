[{"type": "subtitle", "time": 3602.71, "timestamp": "01:00:02", "text": "今天我收到了两条评论。"}, {"type": "subtitle", "time": 3604.71, "timestamp": "01:00:04", "text": "那感觉就像昨天发生的一样，或者说，"}, {"type": "subtitle", "time": 3607.67, "timestamp": "01:00:07", "text": "就像早上那样。呃，我觉得我搞砸了。"}, {"type": "subtitle", "time": 3612.069, "timestamp": "01:00:12", "text": "把它举起来，就像有什么东西在运作一样。呃，我做了。"}, {"type": "subtitle", "time": 3615.03, "timestamp": "01:00:15", "text": "务必做好充分的研究。"}, {"type": "subtitle", "time": 3618.39, "timestamp": "01:00:18", "text": "措辞正确，因为我略知一二。"}, {"type": "subtitle", "time": 3621.43, "timestamp": "01:00:21", "text": "错误可能会让你像所有人一样失败"}, {"type": "subtitle", "time": 3625.43, "timestamp": "01:00:25", "text": "他会为此非常生气。并且继续"}, {"type": "subtitle", "time": 3627.99, "timestamp": "01:00:27", "text": "最重要的是，我感觉自己就像……"}, {"type": "subtitle", "time": 3631.75, "timestamp": "01:00:31", "text": "我感觉自己像个陌生人。"}, {"type": "subtitle", "time": 3633.829, "timestamp": "01:00:33", "text": "未知地点"}, {"type": "subtitle", "time": 3636.309, "timestamp": "01:00:36", "text": "我不了解海关或"}, {"type": "subtitle", "time": 3638.63, "timestamp": "01:00:38", "text": "一切事物或任何事物或所有的一切是如何存在的"}, {"type": "subtitle", "time": 3640.47, "timestamp": "01:00:40", "text": "语言。所以这有点痛苦，对吧？"}, {"type": "subtitle", "time": 3642.95, "timestamp": "01:00:42", "text": "是的，我好像收到了两条评论。"}, {"type": "subtitle", "time": 3646.549, "timestamp": "01:00:46", "text": "说我不应该使用 Luna"}, {"type": "subtitle", "time": 3650.15, "timestamp": "01:00:50", "text": "新年之类的。我不知道。我是"}, {"type": "subtitle", "time": 3652.309, "timestamp": "01:00:52", "text": "一脸困惑。就像缩略图一样，你"}, {"type": "subtitle", "time": 3653.91, "timestamp": "01:00:53", "text": "我知道缩略图的内容，上面写着中文。"}, {"type": "subtitle", "time": 3656.63, "timestamp": "01:00:56", "text": "祝您2023年中国新年快乐！"}, {"type": "subtitle", "time": 3659.19, "timestamp": "01:00:59", "text": "今年是兔年，对吧？而我当时"}]
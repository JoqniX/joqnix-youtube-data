[{"type": "subtitle", "time": 12721.349, "timestamp": "03:32:01", "text": "我当时就想：等等，这是怎么回事？和"}, {"type": "subtitle", "time": 12723.67, "timestamp": "03:32:03", "text": "我刚才看到，呃，我好像有你的"}, {"type": "subtitle", "time": 12725.67, "timestamp": "03:32:05", "text": "旁边也敞开着。所以，我"}, {"type": "subtitle", "time": 12728.15, "timestamp": "03:32:08", "text": "我当时就想，呃，查一下，结果是……"}, {"type": "subtitle", "time": 12730.07, "timestamp": "03:32:10", "text": "正在加载，但我的却可以正常使用。所以当时"}, {"type": "subtitle", "time": 12733.83, "timestamp": "03:32:13", "text": "比如什么？所以我问了你。"}, {"type": "subtitle", "time": 12736.63, "timestamp": "03:32:16", "text": "呃，总之。是的。你明白我的意思了。我"}, {"type": "subtitle", "time": 12739.03, "timestamp": "03:32:19", "text": "明白了。就是这样。如果我是"}, {"type": "subtitle", "time": 12742.469, "timestamp": "03:32:22", "text": "说实话，我认为有"}, {"type": "subtitle", "time": 12745.11, "timestamp": "03:32:25", "text": "只喜欢两个人​​。如果我喜欢的话"}, {"type": "subtitle", "time": 12747.91, "timestamp": "03:32:27", "text": "我一直独自一人，我真的很想……"}, {"type": "subtitle", "time": 12751.67, "timestamp": "03:32:31", "text": "就像这个人烤面包一样，你知道的。啊，"}, {"type": "subtitle", "time": 12754.63, "timestamp": "03:32:34", "text": "是的。是的。我喜欢他的工作，你知道的。"}, {"type": "subtitle", "time": 12757.91, "timestamp": "03:32:37", "text": "他是个坏人。我的意思是，他是个疯子。"}, {"type": "subtitle", "time": 12761.19, "timestamp": "03:32:41", "text": "那种人，精神变态，你知道的，但是"}, {"type": "subtitle", "time": 12762.87, "timestamp": "03:32:42", "text": "你知道，我真的很喜欢他的作品。他是"}, {"type": "subtitle", "time": 12765.83, "timestamp": "03:32:45", "text": "他外表看起来很坚强，但内心却很冷漠。"}, {"type": "subtitle", "time": 12767.91, "timestamp": "03:32:47", "text": "内心柔软的人。我喜欢"}, {"type": "subtitle", "time": 12770.15, "timestamp": "03:32:50", "text": "他。"}, {"type": "subtitle", "time": 12772.15, "timestamp": "03:32:52", "text": "你喜欢这种心态吗？"}, {"type": "subtitle", "time": 12774.95, "timestamp": "03:32:54", "text": "你想成为像他那样的人吗？就像你一样"}, {"type": "subtitle", "time": 12778.469, "timestamp": "03:32:58", "text": "看看你自己，呃，像他一样，就像在里面一样，但在里面"}]
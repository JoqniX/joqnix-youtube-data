[{"type": "subtitle", "time": 7981.83, "timestamp": "02:13:01", "text": "某物。我不知道。或许是因为"}, {"type": "subtitle", "time": 7984.39, "timestamp": "02:13:04", "text": "他希望那件事能成为某种东西。"}, {"type": "subtitle", "time": 7986.79, "timestamp": "02:13:06", "text": "他自己，并成为孤立的游戏或"}, {"type": "subtitle", "time": 7990.709, "timestamp": "02:13:10", "text": "某物。是的，我的意思是……"}, {"type": "subtitle", "time": 7993.109, "timestamp": "02:13:13", "text": "正常答案。精神病患者会是"}, {"type": "subtitle", "time": 7996.39, "timestamp": "02:13:16", "text": "就像那孩子没有腿一样。"}, {"type": "subtitle", "time": 8000.149, "timestamp": "02:13:20", "text": "我的天啊。我的天哪。是的，我甚至都不是……"}, {"type": "subtitle", "time": 8001.83, "timestamp": "02:13:21", "text": "那些东西根本没派上用场。喜欢"}, {"type": "subtitle", "time": 8003.83, "timestamp": "02:13:23", "text": "我真的很喜欢它，但它真的"}, {"type": "subtitle", "time": 8007.43, "timestamp": "02:13:27", "text": "糟透了，一团糟。是的。看看如何"}, {"type": "subtitle", "time": 8010.229, "timestamp": "02:13:30", "text": "就这样。"}, {"type": "subtitle", "time": 8013.75, "timestamp": "02:13:33", "text": "H. 下一个。一天晚上，一个男人去了"}, {"type": "subtitle", "time": 8016.229, "timestamp": "02:13:36", "text": "因为他口渴，需要厨房。"}, {"type": "subtitle", "time": 8019.589, "timestamp": "02:13:39", "text": "一些水。喝完酒后，我"}, {"type": "subtitle", "time": 8021.35, "timestamp": "02:13:41", "text": "意思是喝水，他看着"}, {"type": "subtitle", "time": 8023.83, "timestamp": "02:13:43", "text": "正确的。他看到了一个强盗。所以这个人跑了"}, {"type": "subtitle", "time": 8026.39, "timestamp": "02:13:46", "text": "躲起来，藏在壁橱里。"}, {"type": "subtitle", "time": 8028.79, "timestamp": "02:13:48", "text": "现在，如果你是一名强盗，如果你是……"}, {"type": "subtitle", "time": 8031.83, "timestamp": "02:13:51", "text": "那个看到那个人和你的劫匪"}, {"type": "subtitle", "time": 8033.99, "timestamp": "02:13:53", "text": "手里拿着刀，他会怎么做？"}, {"type": "subtitle", "time": 8036.48, "timestamp": "02:13:56", "text": "做？ 呃，"}]
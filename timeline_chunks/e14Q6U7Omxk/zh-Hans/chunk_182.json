[{"type": "subtitle", "time": 10922.79, "timestamp": "03:02:02", "text": "我认识的每个人都认识我，也都创作过。"}, {"type": "subtitle", "time": 10924.95, "timestamp": "03:02:04", "text": "我试着把它们全都带进来，而且喜欢"}, {"type": "subtitle", "time": 10927.19, "timestamp": "03:02:07", "text": "跟他/她谈谈，因为我没法跟他/她说话。"}, {"type": "subtitle", "time": 10929.429, "timestamp": "03:02:09", "text": "他们以前就是他们。所以我想也是。"}, {"type": "subtitle", "time": 10931.91, "timestamp": "03:02:11", "text": "我想我会在直播中完成。最初"}, {"type": "subtitle", "time": 10934.389, "timestamp": "03:02:14", "text": "我以为我可以随时打开直播。"}, {"type": "subtitle", "time": 10936.95, "timestamp": "03:02:16", "text": "VOD，然后跟他们聊聊什么的"}, {"type": "subtitle", "time": 10938.71, "timestamp": "03:02:18", "text": "不想上直播的人。"}, {"type": "subtitle", "time": 10942.469, "timestamp": "03:02:22", "text": "不，我当时也对这个想法持开放态度。然后"}, {"type": "subtitle", "time": 10945.11, "timestamp": "03:02:25", "text": "我当时就想，呃，我遇到的人数……"}, {"type": "subtitle", "time": 10948.23, "timestamp": "03:02:28", "text": "已联系的人数尚未超过，而且所有"}, {"type": "subtitle", "time": 10950.79, "timestamp": "03:02:30", "text": "我给他们发信息的方式是"}, {"type": "subtitle", "time": 10953.11, "timestamp": "03:02:33", "text": "类似合作或聚会之类的"}, {"type": "subtitle", "time": 10955.269, "timestamp": "03:02:35", "text": "东西。所以他们明白了这是为了"}, {"type": "subtitle", "time": 10957.51, "timestamp": "03:02:37", "text": "以嘉宾身份参与我的直播"}, {"type": "subtitle", "time": 10961.11, "timestamp": "03:02:41", "text": "正确的。所以我想，好吧，我会试试的。"}, {"type": "subtitle", "time": 10963.75, "timestamp": "03:02:43", "text": "看看情况如何发展等等。"}, {"type": "subtitle", "time": 10966.63, "timestamp": "03:02:46", "text": "然后就出现了一些……呃……看到"}, {"type": "subtitle", "time": 10969.349, "timestamp": "03:02:49", "text": "将其视为类似交易的事情"}, {"type": "subtitle", "time": 10971.67, "timestamp": "03:02:51", "text": "他们从出现在我的页面上能得到什么好处？"}, {"type": "subtitle", "time": 10973.75, "timestamp": "03:02:53", "text": "渠道？观点如何？"}, {"type": "subtitle", "time": 10976.07, "timestamp": "03:02:56", "text": "所有那些东西"}, {"type": "subtitle", "time": 10978.87, "timestamp": "03:02:58", "text": "数字较高的人，以及我们"}]
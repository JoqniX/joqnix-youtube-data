[{"type": "subtitle", "time": 9789.03, "timestamp": "02:43:09", "text": "是的。发生了什么？哦，是的。实际上"}, {"type": "subtitle", "time": 9791.51, "timestamp": "02:43:11", "text": "呃，我妈妈想离开去"}, {"type": "subtitle", "time": 9795.429, "timestamp": "02:43:15", "text": "有什么东西，嗯，他让我去拿。"}, {"type": "subtitle", "time": 9799.27, "timestamp": "02:43:19", "text": "给她一些东西。哦，我刚刚免费获得一个"}, {"type": "subtitle", "time": 9802.55, "timestamp": "02:43:22", "text": "就这样。好的。呃，我刚才到底说了什么？"}, {"type": "subtitle", "time": 9806.95, "timestamp": "02:43:26", "text": "做？哦，是的。嗯。嗯，我想我"}, {"type": "subtitle", "time": 9810.63, "timestamp": "02:43:30", "text": "我的电脑卡顿了。哦，我是说笔记本电脑。我们开始吧"}, {"type": "subtitle", "time": 9812.87, "timestamp": "02:43:32", "text": "看看情况如何吧。是的。是的，"}, {"type": "subtitle", "time": 9815.27, "timestamp": "02:43:35", "text": "你还活着。是的。"}, {"type": "subtitle", "time": 9818.07, "timestamp": "02:43:38", "text": "嗯。"}, {"type": "subtitle", "time": 9820.79, "timestamp": "02:43:40", "text": "好的。是的。所以，我们到底在聊什么？"}, {"type": "subtitle", "time": 9823.83, "timestamp": "02:43:43", "text": "关于？我想我……我想我忘了。"}, {"type": "subtitle", "time": 9825.75, "timestamp": "02:43:45", "text": "呃"}, {"type": "subtitle", "time": 9829.11, "timestamp": "02:43:49", "text": "我的天哪，我忘了。"}, {"type": "subtitle", "time": 9831.59, "timestamp": "02:43:51", "text": "是的，我想，嗯，这就是我接受的原因。"}, {"type": "subtitle", "time": 9834.23, "timestamp": "02:43:54", "text": "我手机在身边，因为，是的，我当时正在看"}, {"type": "subtitle", "time": 9836.63, "timestamp": "02:43:56", "text": "你当时的反应就像是“好吧”。好的，我"}]
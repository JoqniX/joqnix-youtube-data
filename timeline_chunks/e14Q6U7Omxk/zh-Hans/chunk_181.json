[{"type": "subtitle", "time": 10861.11, "timestamp": "03:01:01", "text": "已经计划了一些合作项目，例如……"}, {"type": "subtitle", "time": 10864.63, "timestamp": "03:01:04", "text": "就像我一个月前计划的那样"}, {"type": "subtitle", "time": 10867.11, "timestamp": "03:01:07", "text": "例如日本的合作以及韩国的合作"}, {"type": "subtitle", "time": 10869.99, "timestamp": "03:01:09", "text": "合作、中国合作等等。全部"}, {"type": "subtitle", "time": 10872.309, "timestamp": "03:01:12", "text": "这些东西好像本来就在那里。然后"}, {"type": "subtitle", "time": 10874.55, "timestamp": "03:01:14", "text": "我当时就想，哦，我要买这三个。"}, {"type": "subtitle", "time": 10876.71, "timestamp": "03:01:16", "text": "刚到那里的人。他们要走了"}, {"type": "subtitle", "time": 10879.51, "timestamp": "03:01:19", "text": "成为新的首次合作"}, {"type": "subtitle", "time": 10882.79, "timestamp": "03:01:22", "text": "正确的？所以，我不仅思考了为什么"}, {"type": "subtitle", "time": 10885.11, "timestamp": "03:01:25", "text": "感觉就像是最后一刻。所以"}, {"type": "subtitle", "time": 10889.03, "timestamp": "03:01:29", "text": "有人邀请 YouTuber 和其他"}, {"type": "subtitle", "time": 10891.349, "timestamp": "03:01:31", "text": "我曾合作过的YouTube博主。我"}, {"type": "subtitle", "time": 10893.67, "timestamp": "03:01:33", "text": "我们已经很久没有合作了，"}, {"type": "subtitle", "time": 10896.469, "timestamp": "03:01:36", "text": "我一直像没事人一样离开。"}, {"type": "subtitle", "time": 10901.19, "timestamp": "03:01:41", "text": "合作较多，也更倾向于单打独斗。"}, {"type": "subtitle", "time": 10903.59, "timestamp": "03:01:43", "text": "内容类型。所以我就想，也许我会"}, {"type": "subtitle", "time": 10906.55, "timestamp": "03:01:46", "text": "嗯……"}, {"type": "subtitle", "time": 10908.95, "timestamp": "03:01:48", "text": "要有自信，直接问别人。"}, {"type": "subtitle", "time": 10911.269, "timestamp": "03:01:51", "text": "等等，如果他们情绪低落的话"}, {"type": "subtitle", "time": 10913.11, "timestamp": "03:01:53", "text": "我曾与以下人士合作过："}, {"type": "subtitle", "time": 10916.309, "timestamp": "03:01:56", "text": "朋友，那些帮助过我的人，非"}, {"type": "subtitle", "time": 10918.87, "timestamp": "03:01:58", "text": "YouTuber 非创作者"}]
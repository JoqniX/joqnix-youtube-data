[{"type": "subtitle", "time": 10981.429, "timestamp": "03:03:01", "text": "聊了一会儿"}, {"type": "subtitle", "time": 10984.55, "timestamp": "03:03:04", "text": "喜欢与人互动的人，比如日本人"}, {"type": "subtitle", "time": 10988.55, "timestamp": "03:03:08", "text": "人性的一面。所以我就想，呃，那是……"}, {"type": "subtitle", "time": 10991.429, "timestamp": "03:03:11", "text": "那可能有点……那就是我"}, {"type": "subtitle", "time": 10994.15, "timestamp": "03:03:14", "text": "略微了解了一下……"}, {"type": "subtitle", "time": 10996.55, "timestamp": "03:03:16", "text": "文字协作可见"}, {"type": "subtitle", "time": 10998.55, "timestamp": "03:03:18", "text": "不同的人有不同的看法"}, {"type": "subtitle", "time": 11001.91, "timestamp": "03:03:21", "text": "事物。这对我来说是一个教训。"}, {"type": "subtitle", "time": 11003.67, "timestamp": "03:03:23", "text": "然后我就想，“是啊，我还是会这么做。”"}, {"type": "subtitle", "time": 11006.55, "timestamp": "03:03:26", "text": "它。即使我被拒绝，或者人们"}, {"type": "subtitle", "time": 11008.07, "timestamp": "03:03:28", "text": "如果去不了，我还是会做的。"}, {"type": "subtitle", "time": 11010.23, "timestamp": "03:03:30", "text": "随便谁，只要准备好了就行。"}, {"type": "subtitle", "time": 11013.349, "timestamp": "03:03:33", "text": "回复，来我的直播间或者和我聊天，"}, {"type": "subtitle", "time": 11015.75, "timestamp": "03:03:35", "text": "想和我一起放松一下，或者愿意尝试一下"}, {"type": "subtitle", "time": 11018.469, "timestamp": "03:03:38", "text": "跟我聊天，跟我聊天，就像"}, {"type": "subtitle", "time": 11020.469, "timestamp": "03:03:40", "text": "即使是第一次合作，也是他们的第一次"}, {"type": "subtitle", "time": 11024.07, "timestamp": "03:03:44", "text": "时间，看看情况会如何发展。"}, {"type": "subtitle", "time": 11026.95, "timestamp": "03:03:46", "text": "所以，我做了，而且我没想到……"}, {"type": "subtitle", "time": 11030.07, "timestamp": "03:03:50", "text": "一天之内会进行多次合作"}, {"type": "subtitle", "time": 11033.91, "timestamp": "03:03:53", "text": "那个东西。呃，最初只有一个。"}, {"type": "subtitle", "time": 11036.71, "timestamp": "03:03:56", "text": "一天一个人或者类似的情况，这样我就可以……"}, {"type": "subtitle", "time": 11039.67, "timestamp": "03:03:59", "text": "休息一段时间，放松放松什么的"}]
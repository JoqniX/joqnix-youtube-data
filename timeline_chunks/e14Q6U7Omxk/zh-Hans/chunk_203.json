[{"type": "subtitle", "time": 12180.389, "timestamp": "03:23:00", "text": "以及所有的一切。他们都开始了"}, {"type": "subtitle", "time": 12183.91, "timestamp": "03:23:03", "text": "开始像往常一样上传劣质视频"}, {"type": "subtitle", "time": 12186.87, "timestamp": "03:23:06", "text": "视频质量堪比手机摄像头拍摄的视频。"}, {"type": "subtitle", "time": 12189.03, "timestamp": "03:23:09", "text": "然后他们开始追求高端品质。"}, {"type": "subtitle", "time": 12192.309, "timestamp": "03:23:12", "text": "视频，对吧？所以我不想我"}, {"type": "subtitle", "time": 12195.11, "timestamp": "03:23:15", "text": "当时想，对啊，我现在是个油管博主了。"}, {"type": "subtitle", "time": 12197.11, "timestamp": "03:23:17", "text": "如果我采用这种模式，所有人都会"}, {"type": "subtitle", "time": 12199.67, "timestamp": "03:23:19", "text": "预料到这种情况。所以我很害怕"}, {"type": "subtitle", "time": 12203.03, "timestamp": "03:23:23", "text": "提供低质量内容"}, {"type": "subtitle", "time": 12206.71, "timestamp": "03:23:26", "text": "我意识到，那对我来说也是一种伤害。"}, {"type": "subtitle", "time": 12208.63, "timestamp": "03:23:28", "text": "总是梦想着去做某事"}, {"type": "subtitle", "time": 12211.429, "timestamp": "03:23:31", "text": "东西，但我自己也在限制自己"}, {"type": "subtitle", "time": 12214.07, "timestamp": "03:23:34", "text": "我自己没问题，我已经准备好了，但我"}, {"type": "subtitle", "time": 12216.87, "timestamp": "03:23:36", "text": "啊，这样不好。所以，我"}, {"type": "subtitle", "time": 12219.51, "timestamp": "03:23:39", "text": "仔细考虑了一下，我决定开始。"}, {"type": "subtitle", "time": 12221.99, "timestamp": "03:23:41", "text": "上传照片、视频等等"}, {"type": "subtitle", "time": 12225.03, "timestamp": "03:23:45", "text": "从3月12日起，通过这场运动马拉松"}, {"type": "subtitle", "time": 12227.91, "timestamp": "03:23:47", "text": "我于3月12日开始参加Jockathon比赛。"}, {"type": "subtitle", "time": 12230.07, "timestamp": "03:23:50", "text": "从那时起，我就开始"}, {"type": "subtitle", "time": 12233.99, "timestamp": "03:23:53", "text": "上传到 YouTube、TikTok 和 Instagram"}, {"type": "subtitle", "time": 12237.429, "timestamp": "03:23:57", "text": "汇总了直播中的所有片段"}, {"type": "chat", "time": 12239.461, "timestamp": "03:23:59", "author": "@senpainotfoundd", "avatar": "https://yt4.ggpht.com/MxpRBxfrp903U81_WAr-BZO6QKwdKT1rJjdvDSuF8Nu_JP9JTpQCOA_SSgLjCV10OU4M-cDGhyk=s64-c-k-c0x00ffffff-no-rj", "message": "its never too late, you've got this"}]
[{"type": "subtitle", "time": 8220.95, "timestamp": "02:17:00", "text": "开始逃跑。他为什么会这样？"}, {"type": "subtitle", "time": 8223.509, "timestamp": "02:17:03", "text": "做这个动作的时候是不是在指着你？一"}, {"type": "subtitle", "time": 8225.99, "timestamp": "02:17:05", "text": "关上窗户，闭紧嘴巴"}, {"type": "subtitle", "time": 8230.15, "timestamp": "02:17:10", "text": "东西要自己带。二"}, {"type": "subtitle", "time": 8233.19, "timestamp": "02:17:13", "text": "是的，谢谢。他当时只是在检查。"}, {"type": "subtitle", "time": 8236.309, "timestamp": "02:17:16", "text": "你觉得这件事不安全"}, {"type": "subtitle", "time": 8238.15, "timestamp": "02:17:18", "text": "你的整个身体都将属于我。"}, {"type": "subtitle", "time": 8241.91, "timestamp": "02:17:21", "text": "从头到脚都是东西。我会谋杀"}, {"type": "subtitle", "time": 8244.309, "timestamp": "02:17:24", "text": "下次吧。警告。"}, {"type": "subtitle", "time": 8248.87, "timestamp": "02:17:28", "text": "是的。是的。是的。问题是，呃，他曾经是"}, {"type": "subtitle", "time": 8250.79, "timestamp": "02:17:30", "text": "嗯，通常的答案是正确的。你是"}, {"type": "subtitle", "time": 8253.11, "timestamp": "02:17:33", "text": "正确的。通常的回答是威胁性的。"}, {"type": "subtitle", "time": 8257.99, "timestamp": "02:17:37", "text": "你。但精神病患者的回答是……呃……他"}, {"type": "subtitle", "time": 8261.589, "timestamp": "02:17:41", "text": "当时正在数楼层。"}, {"type": "subtitle", "time": 8263.19, "timestamp": "02:17:43", "text": "哦"}, {"type": "subtitle", "time": 8265.429, "timestamp": "02:17:45", "text": "是的。他数着数到多高了。"}, {"type": "subtitle", "time": 8268.79, "timestamp": "02:17:48", "text": "你来自基地。哦，我以为是这样。"}, {"type": "subtitle", "time": 8271.429, "timestamp": "02:17:51", "text": "就在隔壁。隔壁房间。不，不，不"}, {"type": "subtitle", "time": 8273.75, "timestamp": "02:17:53", "text": "不。你出局了。那是另一栋建筑。他"}, {"type": "subtitle", "time": 8275.27, "timestamp": "02:17:55", "text": "就像给我照片一样，而且当时就在……"}, {"type": "subtitle", "time": 8277.03, "timestamp": "02:17:57", "text": "另一栋楼。呃，这就是我得到的原因"}, {"type": "subtitle", "time": 8279.75, "timestamp": "02:17:59", "text": "我大概不太擅长讲故事吧。哦，"}]
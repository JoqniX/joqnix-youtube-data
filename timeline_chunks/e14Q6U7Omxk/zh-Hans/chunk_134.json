[{"type": "subtitle", "time": 8042.709, "timestamp": "02:14:02", "text": "等待。那家伙看见他在外面"}, {"type": "subtitle", "time": 8045.27, "timestamp": "02:14:05", "text": "房子外面的窗户。不，不，不"}, {"type": "subtitle", "time": 8048.229, "timestamp": "02:14:08", "text": "不，不。你把一些东西混在一起了。他"}, {"type": "subtitle", "time": 8050.39, "timestamp": "02:14:10", "text": "他当时是要去厨房吗？"}, {"type": "subtitle", "time": 8052.31, "timestamp": "02:14:12", "text": "他想喝点水。仿佛已经太晚了"}, {"type": "subtitle", "time": 8054.31, "timestamp": "02:14:14", "text": "晚上，比如两三点。所以，他想要"}, {"type": "subtitle", "time": 8056.229, "timestamp": "02:14:16", "text": "一些水。他去了厨房。他"}, {"type": "subtitle", "time": 8059.189, "timestamp": "02:14:19", "text": "他正在喝水，这时他看到……"}, {"type": "subtitle", "time": 8061.27, "timestamp": "02:14:21", "text": "走廊里，他右边的人"}, {"type": "subtitle", "time": 8065.27, "timestamp": "02:14:25", "text": "他的公寓。正确的。以及"}, {"type": "subtitle", "time": 8068.069, "timestamp": "02:14:28", "text": "劫匪还看到了躲藏在里面的男子。"}, {"type": "subtitle", "time": 8070.229, "timestamp": "02:14:30", "text": "壁橱。如果你是劫匪，你会怎么做？"}, {"type": "subtitle", "time": 8077.589, "timestamp": "02:14:37", "text": "有答案吗？"}, {"type": "subtitle", "time": 8079.27, "timestamp": "02:14:39", "text": "H"}, {"type": "subtitle", "time": 8083.43, "timestamp": "02:14:43", "text": "我的意思是，如果劫匪心地善良的话，"}, {"type": "subtitle", "time": 8086.31, "timestamp": "02:14:46", "text": "他会说：“呃，我可以喝点什么吗？”"}, {"type": "subtitle", "time": 8089.35, "timestamp": "02:14:49", "text": "水之类的？”或者像呃，或者"}, {"type": "subtitle", "time": 8091.83, "timestamp": "02:14:51", "text": "或许可以把那家伙挟为人质"}, {"type": "subtitle", "time": 8095.35, "timestamp": "02:14:55", "text": "某物。如果我 如果如果我 如果那家伙没有"}, {"type": "subtitle", "time": 8097.75, "timestamp": "02:14:57", "text": "他不在乎夺走一条生命，他会像这样"}]
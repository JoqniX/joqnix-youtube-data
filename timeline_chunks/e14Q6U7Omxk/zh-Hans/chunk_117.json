[{"type": "subtitle", "time": 7021.91, "timestamp": "01:57:01", "text": "九，对吧？ 9或10。不，实际上是12。"}, {"type": "subtitle", "time": 7024.55, "timestamp": "01:57:04", "text": "是的。 12. 12."}, {"type": "subtitle", "time": 7032.07, "timestamp": "01:57:12", "text": "是的。是的。是的。所以，这会更难。"}, {"type": "subtitle", "time": 7037.03, "timestamp": "01:57:17", "text": "对我来说，真正得到"}, {"type": "subtitle", "time": 7039.99, "timestamp": "01:57:19", "text": "帮助。我当时就想，哇。我的天哪，他"}, {"type": "subtitle", "time": 7055.669, "timestamp": "01:57:35", "text": "还有，别介意我谈论……"}, {"type": "subtitle", "time": 7058.47, "timestamp": "01:57:38", "text": "比利随意地或像随机地"}, {"type": "subtitle", "time": 7062.709, "timestamp": "01:57:42", "text": "毫无征兆地，就像进入了一个"}, {"type": "subtitle", "time": 7064.95, "timestamp": "01:57:44", "text": "它叫什么？"}, {"type": "subtitle", "time": 7068.95, "timestamp": "01:57:48", "text": "有点像油漆球的那种感觉。收音机。"}, {"type": "subtitle", "time": 7072.87, "timestamp": "01:57:52", "text": "不过，别在意。只是"}, {"type": "subtitle", "time": 7076.229, "timestamp": "01:57:56", "text": "最近我的思绪一直很混乱，"}, {"type": "subtitle", "time": 7077.83, "timestamp": "01:57:57", "text": "你知道，让我去那里吧"}]
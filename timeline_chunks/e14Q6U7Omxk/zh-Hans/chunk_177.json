[{"type": "subtitle", "time": 10621.67, "timestamp": "02:57:01", "text": "我能听懂这种口音。"}, {"type": "subtitle", "time": 10623.75, "timestamp": "02:57:03", "text": "Himachi，它其实是印地语，只是表达方式不同。"}, {"type": "subtitle", "time": 10626.15, "timestamp": "02:57:06", "text": "你知道，就连旁遮普语的口音都像"}, {"type": "subtitle", "time": 10636.55, "timestamp": "02:57:16", "text": "[音乐]"}, {"type": "subtitle", "time": 10638.15, "timestamp": "02:57:18", "text": "我不知道它好不好，但是"}, {"type": "subtitle", "time": 10641.03, "timestamp": "02:57:21", "text": "没关系。就像平均水平一样，我"}, {"type": "subtitle", "time": 10643.429, "timestamp": "02:57:23", "text": "想想看，在这一点上，因为一半的人"}, {"type": "subtitle", "time": 10644.95, "timestamp": "02:57:24", "text": "我们正在做一些事情，其中​​一半是我们"}, {"type": "subtitle", "time": 10647.269, "timestamp": "02:57:27", "text": "做其他事。不知何故，"}, {"type": "subtitle", "time": 10649.51, "timestamp": "02:57:29", "text": "我不知道为什么整个社区都这样。"}, {"type": "subtitle", "time": 10651.51, "timestamp": "02:57:31", "text": "他们不喜欢在他们那里说印地语。"}, {"type": "subtitle", "time": 10654.55, "timestamp": "02:57:34", "text": "喜欢频道是因为人们不喜欢"}, {"type": "subtitle", "time": 10657.11, "timestamp": "02:57:37", "text": "手表。是啊，没人看。如果"}, {"type": "subtitle", "time": 10659.91, "timestamp": "02:57:39", "text": "你是在说印地语，对吗？哦，但是"}, {"type": "subtitle", "time": 10663.19, "timestamp": "02:57:43", "text": "瓦科尼人确实会这样做，而且还有更多。"}, {"type": "subtitle", "time": 10665.269, "timestamp": "02:57:45", "text": "印度人要来了，对吧？印地语，"}, {"type": "subtitle", "time": 10669.349, "timestamp": "02:57:49", "text": "说印地语的人。是的。嗯。那里"}, {"type": "subtitle", "time": 10672.07, "timestamp": "02:57:52", "text": "我想大概有三个人也加入了"}, {"type": "subtitle", "time": 10674.15, "timestamp": "02:57:54", "text": "那个频道。我不知道是哪一个"}, {"type": "subtitle", "time": 10676.389, "timestamp": "02:57:56", "text": "确实如此。就好像他们所有人都是"}, {"type": "subtitle", "time": 10679.11, "timestamp": "02:57:59", "text": "会说印地语。他们中的大多数人"}]
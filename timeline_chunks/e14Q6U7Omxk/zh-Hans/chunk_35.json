[{"type": "subtitle", "time": 2134.79, "timestamp": "00:35:34", "text": "适用于 YouTube。好的，关于Twitch，呃，我"}, {"type": "subtitle", "time": 2139.109, "timestamp": "00:35:39", "text": "你以为你可以屏蔽、忽略吗？等等，你"}, {"type": "subtitle", "time": 2142.31, "timestamp": "00:35:42", "text": "忽略或许是最好的选择。"}, {"type": "subtitle", "time": 2144.47, "timestamp": "00:35:44", "text": "无视是最好的。我认为你可以。"}, {"type": "subtitle", "time": 2147.19, "timestamp": "00:35:47", "text": "是的，你可以屏蔽和举报。"}, {"type": "subtitle", "time": 2150.79, "timestamp": "00:35:50", "text": "YouTube，但直播平台是Twitch。"}, {"type": "subtitle", "time": 2152.95, "timestamp": "00:35:52", "text": "如果版主发现任何不良内容"}, {"type": "subtitle", "time": 2156.79, "timestamp": "00:35:56", "text": "如果发生什么事，或者我自己，我也会移除"}, {"type": "subtitle", "time": 2159.19, "timestamp": "00:35:59", "text": "然后删除它。"}]
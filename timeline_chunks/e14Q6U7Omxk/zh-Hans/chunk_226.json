[{"type": "subtitle", "time": 13560.07, "timestamp": "03:46:00", "text": "是的。是的，当地的学院"}, {"type": "subtitle", "time": 13563.269, "timestamp": "03:46:03", "text": "他们说：“是啊。”他们是，他们是"}, {"type": "subtitle", "time": 13566.229, "timestamp": "03:46:06", "text": "好像这对他们来说很难，但他们也"}, {"type": "subtitle", "time": 13569.59, "timestamp": "03:46:09", "text": "给予补偿，因为学生们无法继续学习。"}, {"type": "subtitle", "time": 13572.389, "timestamp": "03:46:12", "text": "7月份，他们通过补偿来弥补。"}, {"type": "subtitle", "time": 13575.83, "timestamp": "03:46:15", "text": "N4课程通常是免费的。"}, {"type": "subtitle", "time": 13578.55, "timestamp": "03:46:18", "text": "这门课程应该很贵。"}, {"type": "subtitle", "time": 13581.91, "timestamp": "03:46:21", "text": "我已经付了30块钱了，应该是N5。"}, {"type": "subtitle", "time": 13583.91, "timestamp": "03:46:23", "text": "那"}, {"type": "subtitle", "time": 13587.67, "timestamp": "03:46:27", "text": "N4 的增加幅度会更大。"}, {"type": "subtitle", "time": 13589.99, "timestamp": "03:46:29", "text": "金额应该增加30或40。"}, {"type": "subtitle", "time": 13592.95, "timestamp": "03:46:32", "text": "或者诸如此类，此外他们也是"}, {"type": "subtitle", "time": 13595.99, "timestamp": "03:46:35", "text": "给你一点N3"}, {"type": "subtitle", "time": 13599.99, "timestamp": "03:46:39", "text": "N3课程的起始级别也"}, {"type": "subtitle", "time": 13603.67, "timestamp": "03:46:43", "text": "在四月之前完成N4课程"}, {"type": "subtitle", "time": 13607.269, "timestamp": "03:46:47", "text": "行进。所以总的来说应该"}, {"type": "subtitle", "time": 13610.79, "timestamp": "03:46:50", "text": "成本似乎更高，但他们正在这样做"}, {"type": "subtitle", "time": 13613.59, "timestamp": "03:46:53", "text": "免费，因为所有的人"}, {"type": "subtitle", "time": 13617.03, "timestamp": "03:46:57", "text": "本来应该七月份去，然后把他们都带走。"}, {"type": "subtitle", "time": 13619.349, "timestamp": "03:46:59", "text": "已付清所有款项。他们尽力了。"}]
[{"type": "subtitle", "time": 7801.189, "timestamp": "02:10:01", "text": "我一切都很好。海利昂，你好吗？"}, {"type": "subtitle", "time": 7805.35, "timestamp": "02:10:05", "text": "我一切都很好。我只是……我真的"}, {"type": "subtitle", "time": 7808.069, "timestamp": "02:10:08", "text": "想好好聊聊，就像……"}, {"type": "subtitle", "time": 7811.51, "timestamp": "02:10:11", "text": "晚上和你在一起，但我当时想，这是什么？"}, {"type": "subtitle", "time": 7814.47, "timestamp": "02:10:14", "text": "我该怎么做？我应该放些什么？我喜欢"}, {"type": "subtitle", "time": 7815.99, "timestamp": "02:10:15", "text": "虽然有点晚了，但别担心。"}, {"type": "subtitle", "time": 7818.47, "timestamp": "02:10:18", "text": "那些东西。好的。这种事时有发生。它"}, {"type": "subtitle", "time": 7822.069, "timestamp": "02:10:22", "text": "事情发生了。是的。是的。是的。我的意思是，我们"}, {"type": "subtitle", "time": 7824.79, "timestamp": "02:10:24", "text": "以后总有机会再聚。我是"}, {"type": "subtitle", "time": 7826.709, "timestamp": "02:10:26", "text": "在这里待了11个月。那会相当不错"}, {"type": "subtitle", "time": 7829.75, "timestamp": "02:10:29", "text": "真有趣，老兄。如果那样的话，那肯定很有趣。"}, {"type": "subtitle", "time": 7831.669, "timestamp": "02:10:31", "text": "你问我，伙计。那真是太好了"}, {"type": "subtitle", "time": 7836.629, "timestamp": "02:10:36", "text": "和我一起玩。至少对我来说是这样。是的。"}, {"type": "subtitle", "time": 7839.109, "timestamp": "02:10:39", "text": "哦，别担心。谢谢。谢谢"}, {"type": "subtitle", "time": 7841.03, "timestamp": "02:10:41", "text": "感谢您的点赞和给予"}, {"type": "subtitle", "time": 7843.91, "timestamp": "02:10:43", "text": "给姐姐一些建议。讲笑话。我喜欢狗。"}, {"type": "subtitle", "time": 7848.31, "timestamp": "02:10:48", "text": "谢谢。是的。所以，我们到了。如何"}, {"type": "subtitle", "time": 7851.03, "timestamp": "02:10:51", "text": "你在做什么？我们已经在路上了。"}, {"type": "subtitle", "time": 7854.39, "timestamp": "02:10:54", "text": "总之，就是这样。那么，最新进展是什么？"}, {"type": "subtitle", "time": 7858.629, "timestamp": "02:10:58", "text": "现在？我们在做什么？我一直……呃……"}]
[{"type": "subtitle", "time": 12780.229, "timestamp": "03:33:00", "text": "在他已经起床的早期阶段"}, {"type": "subtitle", "time": 12785.11, "timestamp": "03:33:05", "text": "呃"}, {"type": "subtitle", "time": 12789.59, "timestamp": "03:33:09", "text": "不太确定。嗯"}, {"type": "subtitle", "time": 12791.75, "timestamp": "03:33:11", "text": "等等，你好像没像你那样，对吧？"}, {"type": "subtitle", "time": 12794.55, "timestamp": "03:33:14", "text": "像我这样的人，我的意思是，不是像那样的人，他们没有"}, {"type": "subtitle", "time": 12797.75, "timestamp": "03:33:17", "text": "你喜欢，呃，就像我看到了很多片段一样"}, {"type": "subtitle", "time": 12799.67, "timestamp": "03:33:19", "text": "还有一些你之前就知道的事情，比如开始"}, {"type": "subtitle", "time": 12802.71, "timestamp": "03:33:22", "text": "除了我看到的那件事以外，其他的一切都很好。"}, {"type": "subtitle", "time": 12805.91, "timestamp": "03:33:25", "text": "你应该有这个目标"}, {"type": "subtitle", "time": 12808.07, "timestamp": "03:33:28", "text": "设置一些东西，我不知道那是什么。"}, {"type": "subtitle", "time": 12810.95, "timestamp": "03:33:30", "text": "之所以称之为“你必须喜欢选择”，是因为……"}, {"type": "subtitle", "time": 12813.51, "timestamp": "03:33:33", "text": "某些人，比如三个呃主播或"}, {"type": "subtitle", "time": 12818.389, "timestamp": "03:33:38", "text": "你喜欢的 YouTuber，呃，像他们一样，或者"}, {"type": "subtitle", "time": 12820.71, "timestamp": "03:33:40", "text": "呃，你遵循类似的事情"}, {"type": "subtitle", "time": 12823.67, "timestamp": "03:33:43", "text": "我知道我做了那项活动，而且我找到了我的"}, {"type": "subtitle", "time": 12825.59, "timestamp": "03:33:45", "text": "回答之后，我开始着手解决我的问题。"}, {"type": "subtitle", "time": 12828.71, "timestamp": "03:33:48", "text": "这就是我改变方向的原因"}, {"type": "subtitle", "time": 12831.19, "timestamp": "03:33:51", "text": "用这种方式来描述缩略图之类的东西"}, {"type": "subtitle", "time": 12833.99, "timestamp": "03:33:53", "text": "就像那样，你知道吗？等等，就是那个。"}, {"type": "subtitle", "time": 12836.389, "timestamp": "03:33:56", "text": "你必须找到一群人"}, {"type": "subtitle", "time": 12838.15, "timestamp": "03:33:58", "text": "和他们交谈，了解他们是如何做的。"}]
[{"type": "subtitle", "time": 8701.19, "timestamp": "02:25:01", "text": "他站在门口附近，盯着他看。"}, {"type": "subtitle", "time": 8704.71, "timestamp": "02:25:04", "text": "透过玻璃，为什么会这样？"}, {"type": "subtitle", "time": 8707.27, "timestamp": "02:25:07", "text": "我确信他已经不在人世了，他肯定不是。"}, {"type": "subtitle", "time": 8711.03, "timestamp": "02:25:11", "text": "即使之后还在呼吸或假装呼吸，所以没有"}, {"type": "subtitle", "time": 8713.99, "timestamp": "02:25:13", "text": "比如，如果……如果之后……该怎么称呼它呢？"}, {"type": "subtitle", "time": 8716.469, "timestamp": "02:25:16", "text": "如果一个人被刺五次，"}, {"type": "subtitle", "time": 8719.27, "timestamp": "02:25:19", "text": "此人仍然活着。不，那么他们可以"}, {"type": "subtitle", "time": 8721.67, "timestamp": "02:25:21", "text": "报告报告你或类似描述这个"}, {"type": "subtitle", "time": 8724.389, "timestamp": "02:25:24", "text": "就是那个刺伤我的人，等等。"}, {"type": "subtitle", "time": 8726.23, "timestamp": "02:25:26", "text": "东西。所以，是的，他想确保"}, {"type": "subtitle", "time": 8730.95, "timestamp": "02:25:30", "text": "他就是那个已经死了的人。"}, {"type": "subtitle", "time": 8733.27, "timestamp": "02:25:33", "text": "又是老一套的回答。感谢上帝"}, {"type": "subtitle", "time": 8736.87, "timestamp": "02:25:36", "text": "可以成为朋友。好的，我们拭目以待。和"}, {"type": "subtitle", "time": 8739.99, "timestamp": "02:25:39", "text": "是啊，呃，显然他没有走开。"}, {"type": "subtitle", "time": 8742.23, "timestamp": "02:25:42", "text": "因为大家都看得出来，对吧？"}, {"type": "subtitle", "time": 8744.63, "timestamp": "02:25:44", "text": "一个人死在了……"}, {"type": "subtitle", "time": 8747.03, "timestamp": "02:25:47", "text": "是商场吧？但如果他搬离"}, {"type": "subtitle", "time": 8749.429, "timestamp": "02:25:49", "text": "身体，每个人都会想，为什么会"}, {"type": "subtitle", "time": 8751.59, "timestamp": "02:25:51", "text": "他为什么要离开？他似乎并没有受到影响。"}, {"type": "subtitle", "time": 8753.67, "timestamp": "02:25:53", "text": "那样做？"}]
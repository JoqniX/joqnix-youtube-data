[{"type": "subtitle", "time": 7629.75, "timestamp": "02:07:09", "text": "呃，有点延误，我先说明一下。"}, {"type": "subtitle", "time": 7632.069, "timestamp": "02:07:12", "text": "这可能对……不利"}, {"type": "subtitle", "time": 7634.55, "timestamp": "02:07:14", "text": "你所知道的我都已经知道了"}, {"type": "subtitle", "time": 7639.43, "timestamp": "02:07:19", "text": "它没有检测到您的帐户调用"}, {"type": "subtitle", "time": 7643.83, "timestamp": "02:07:23", "text": "是的。呃，我觉得它好像没检测到。"}, {"type": "subtitle", "time": 7647.669, "timestamp": "02:07:27", "text": "嗯，就是 Discord。呃，试试重新启动"}, {"type": "subtitle", "time": 7650.069, "timestamp": "02:07:30", "text": "你的Discord。"}, {"type": "subtitle", "time": 7653.75, "timestamp": "02:07:33", "text": "Discord。等待。我应该刷新一下吗？"}, {"type": "subtitle", "time": 7658.31, "timestamp": "02:07:38", "text": "它？不，不。直接打开Discord应用即可。"}, {"type": "subtitle", "time": 7662.87, "timestamp": "02:07:42", "text": "前往 Discord 并进行控制"}, {"type": "subtitle", "time": 7664.79, "timestamp": "02:07:44", "text": "加上 R。"}, {"type": "subtitle", "time": 7667.03, "timestamp": "02:07:47", "text": "是的，你打开 Discord，然后点击“+”按钮。"}, {"type": "subtitle", "time": 7674.39, "timestamp": "02:07:54", "text": "现在可以了吗？我不知道。啊，"}, {"type": "subtitle", "time": 7678.069, "timestamp": "02:07:58", "text": "你正在使用浏览器。这就是原因"}]
[{"type": "subtitle", "time": 14162.55, "timestamp": "03:56:02", "text": "你喜欢私信吗？稍后私信我，或者我可能会发给你。"}, {"type": "subtitle", "time": 14165.269, "timestamp": "03:56:05", "text": "如果你想的话，现在可以给你。总之，"}, {"type": "subtitle", "time": 14167.67, "timestamp": "03:56:07", "text": "发生的事情是……呃……"}, {"type": "subtitle", "time": 14170.63, "timestamp": "03:56:10", "text": "事情就像是私人家庭琐事。"}, {"type": "subtitle", "time": 14172.79, "timestamp": "03:56:12", "text": "然后发生了很多糟糕的事情。所以，我"}, {"type": "subtitle", "time": 14174.71, "timestamp": "03:56:14", "text": "之后就没法制作很多视频了。"}, {"type": "subtitle", "time": 14176.87, "timestamp": "03:56:16", "text": "我为……制作的那些加密货币视频"}, {"type": "subtitle", "time": 14179.429, "timestamp": "03:56:19", "text": "虚拟主播相关内容。所以我停止制作"}, {"type": "subtitle", "time": 14181.189, "timestamp": "03:56:21", "text": "视频。我向社区解释了事情的来龙去脉。"}, {"type": "subtitle", "time": 14183.91, "timestamp": "03:56:23", "text": "以及所有那些事。我开始做这件事。"}, {"type": "subtitle", "time": 14186.87, "timestamp": "03:56:26", "text": "然后，我就开始创作这些画作。"}, {"type": "subtitle", "time": 14189.269, "timestamp": "03:56:29", "text": "有一次，我的整面墙"}, {"type": "subtitle", "time": 14191.429, "timestamp": "03:56:31", "text": "里面摆满了画作等等"}, {"type": "subtitle", "time": 14194.229, "timestamp": "03:56:34", "text": "绘画是逃避现实的类型，你"}, {"type": "subtitle", "time": 14198.07, "timestamp": "03:56:38", "text": "了解一种负面类型。还有我的母亲"}, {"type": "subtitle", "time": 14199.83, "timestamp": "03:56:39", "text": "有一天她走进来，然后就问：“什么？”"}, {"type": "subtitle", "time": 14202.229, "timestamp": "03:56:42", "text": "你脑子里到底在想些什么？和"}, {"type": "subtitle", "time": 14204.55, "timestamp": "03:56:44", "text": "她带我出去散步了。"}, {"type": "subtitle", "time": 14206.469, "timestamp": "03:56:46", "text": "跟我解释说一切都很好之类的。"}, {"type": "subtitle", "time": 14209.67, "timestamp": "03:56:49", "text": "之后我又开始做YouTube了。"}, {"type": "subtitle", "time": 14214.15, "timestamp": "03:56:54", "text": "只是作为一种爱好。嗯，我开始看了"}, {"type": "subtitle", "time": 14216.309, "timestamp": "03:56:56", "text": "爱宽。你知道你认识他，对吧？"}]
[{"type": "subtitle", "time": 9670.87, "timestamp": "02:41:10", "text": "好的，请给我一分钟时间，等我"}, {"type": "subtitle", "time": 9674.79, "timestamp": "02:41:14", "text": "同时处理几件事。"}, {"type": "subtitle", "time": 9676.95, "timestamp": "02:41:16", "text": "我当时在合作过程中不得不这么做。"}, {"type": "subtitle", "time": 9680.389, "timestamp": "02:41:20", "text": "溪流。是的，"}, {"type": "subtitle", "time": 9684.87, "timestamp": "02:41:24", "text": "我的狗狗在叫。哦，"}, {"type": "subtitle", "time": 9699.19, "timestamp": "02:41:39", "text": "是的，"}, {"type": "subtitle", "time": 9708.309, "timestamp": "02:41:48", "text": "那件事。"}, {"type": "subtitle", "time": 9711.19, "timestamp": "02:41:51", "text": "是的，等赫利俄斯……的时候我会提到这件事。"}, {"type": "subtitle", "time": 9713.99, "timestamp": "02:41:53", "text": "后退。"}]
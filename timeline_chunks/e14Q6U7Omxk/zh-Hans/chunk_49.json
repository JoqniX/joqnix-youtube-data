[{"type": "subtitle", "time": 2943.829, "timestamp": "00:49:03", "text": "“真的真的真的”对我来说意义重大。嗯。"}, {"type": "subtitle", "time": 2946.47, "timestamp": "00:49:06", "text": "所以说完这些，我要结束了。"}, {"type": "subtitle", "time": 2949.43, "timestamp": "00:49:09", "text": "今天就到这里吧。所有那些"}, {"type": "subtitle", "time": 2951.829, "timestamp": "00:49:11", "text": "随后"}, {"type": "subtitle", "time": 2955.99, "timestamp": "00:49:15", "text": "等待所有来的人"}, {"type": "subtitle", "time": 2964.71, "timestamp": "00:49:24", "text": "感谢大家抽出时间……"}, {"type": "subtitle", "time": 2967.349, "timestamp": "00:49:27", "text": "这里在聊天室里看着我玩游戏"}, {"type": "subtitle", "time": 2974.069, "timestamp": "00:49:34", "text": "[音乐]"}, {"type": "subtitle", "time": 2981.67, "timestamp": "00:49:41", "text": "是的，我会改用Oh，"}, {"type": "subtitle", "time": 2984.71, "timestamp": "00:49:44", "text": "等待。我忘了。"}, {"type": "subtitle", "time": 2988.79, "timestamp": "00:49:48", "text": "我怎么会忘记这件事呢？所以显然"}, {"type": "subtitle", "time": 2991.75, "timestamp": "00:49:51", "text": "当我应该在的时候，当我应该在的时候"}, {"type": "subtitle", "time": 2993.67, "timestamp": "00:49:53", "text": "正在播放，我应该切换到这个"}, {"type": "subtitle", "time": 2996.63, "timestamp": "00:49:56", "text": "动态光照效果。"}, {"type": "subtitle", "time": 2998.79, "timestamp": "00:49:58", "text": "我忘了。"}]
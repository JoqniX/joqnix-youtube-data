[{"type": "subtitle", "time": 14522.469, "timestamp": "04:02:02", "text": "是啊，确实有点儿。是的，就是这样。"}, {"type": "subtitle", "time": 14524.55, "timestamp": "04:02:04", "text": "学习经验之人。我就是这么想的"}, {"type": "subtitle", "time": 14526.63, "timestamp": "04:02:06", "text": "它。即使我向我的家人解释过，我还是……"}, {"type": "subtitle", "time": 14529.75, "timestamp": "04:02:09", "text": "父母会说，听着，如果你有"}, {"type": "subtitle", "time": 14531.91, "timestamp": "04:02:11", "text": "成功脱身了，太好了，钱也到账了。"}, {"type": "subtitle", "time": 14534.55, "timestamp": "04:02:14", "text": "你挣的钱本来就是你的。所以记住不要"}, {"type": "subtitle", "time": 14537.99, "timestamp": "04:02:17", "text": "再做类似的事情。就是这样。"}, {"type": "subtitle", "time": 14539.59, "timestamp": "04:02:19", "text": "他们一度很开心，因为"}, {"type": "subtitle", "time": 14541.11, "timestamp": "04:02:21", "text": "他们说，你有很多钱。"}, {"type": "subtitle", "time": 14544.55, "timestamp": "04:02:24", "text": "但是，呃，我觉得他们知道那是"}, {"type": "subtitle", "time": 14547.67, "timestamp": "04:02:27", "text": "假的，因为我这么早就拿到钱了。"}, {"type": "subtitle", "time": 14551.03, "timestamp": "04:02:31", "text": "比如它从100美元上涨到"}, {"type": "subtitle", "time": 14555.11, "timestamp": "04:02:35", "text": "你知道，一美元兑一千万卢比。"}, {"type": "subtitle", "time": 14558.79, "timestamp": "04:02:38", "text": "他们觉得他肯定会想办法的。"}, {"type": "subtitle", "time": 14560.33, "timestamp": "04:02:40", "text": "啊"}, {"type": "subtitle", "time": 14562.07, "timestamp": "04:02:42", "text": "[音乐]"}, {"type": "subtitle", "time": 14564.55, "timestamp": "04:02:44", "text": "学会学习是件好事，伙计，这是真的。"}, {"type": "subtitle", "time": 14566.95, "timestamp": "04:02:46", "text": "学习经历让我明白了我为什么会这样"}, {"type": "subtitle", "time": 14568.469, "timestamp": "04:02:48", "text": "搞定了，已经完成了，那是什么？"}, {"type": "subtitle", "time": 14570.87, "timestamp": "04:02:50", "text": "现在思考这个问题的意义何在？"}, {"type": "subtitle", "time": 14573.189, "timestamp": "04:02:53", "text": "是的，我已经开始学习了。"}, {"type": "subtitle", "time": 14575.189, "timestamp": "04:02:55", "text": "退休规划之类的东西。"}, {"type": "subtitle", "time": 14577.189, "timestamp": "04:02:57", "text": "我知道这为时过早。"}, {"type": "subtitle", "time": 14578.87, "timestamp": "04:02:58", "text": "但我已经开始学习了，所以一旦我"}]
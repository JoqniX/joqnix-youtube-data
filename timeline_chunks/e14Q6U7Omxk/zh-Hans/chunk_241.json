[{"type": "subtitle", "time": 14461.189, "timestamp": "04:01:01", "text": "是的。我甚至不知道有多少个零"}, {"type": "subtitle", "time": 14464.95, "timestamp": "04:01:04", "text": "他们大概有六七岁。"}, {"type": "subtitle", "time": 14468.63, "timestamp": "04:01:08", "text": "我不知道。 C 就像"}, {"type": "subtitle", "time": 14470.229, "timestamp": "04:01:10", "text": "六"}, {"type": "subtitle", "time": 14473.269, "timestamp": "04:01:13", "text": "或许七个。我不知道。嗯，也许吧。"}, {"type": "subtitle", "time": 14476.71, "timestamp": "04:01:16", "text": "六。我想应该是六七个吧。是的。是的。"}, {"type": "subtitle", "time": 14479.269, "timestamp": "04:01:19", "text": "确切地说，这是一大笔钱。"}, {"type": "subtitle", "time": 14483.429, "timestamp": "04:01:23", "text": "是的。是的，这很多。呃，那就是"}, {"type": "subtitle", "time": 14486.55, "timestamp": "04:01:26", "text": "是的。然后我开始，然后我又停下来，就像我"}, {"type": "subtitle", "time": 14488.71, "timestamp": "04:01:28", "text": "当时我就想，好吧，我不会那样去的。"}, {"type": "subtitle", "time": 14491.59, "timestamp": "04:01:31", "text": "快速赚钱的方法。好的。我已开始"}, {"type": "subtitle", "time": 14496.309, "timestamp": "04:01:36", "text": "兄弟。总之，呃，我赶紧停下来了。"}, {"type": "subtitle", "time": 14498.469, "timestamp": "04:01:38", "text": "像我之前那样快速赚钱的方法已经停止了。我"}, {"type": "subtitle", "time": 14500.79, "timestamp": "04:01:40", "text": "当时我就想：不行，这行不通。我必须"}, {"type": "subtitle", "time": 14503.51, "timestamp": "04:01:43", "text": "从零开始学习。"}, {"type": "subtitle", "time": 14505.75, "timestamp": "04:01:45", "text": "然后我开始学习……"}, {"type": "subtitle", "time": 14507.349, "timestamp": "04:01:47", "text": "财务方面的事情。于是我开始了。"}, {"type": "subtitle", "time": 14509.51, "timestamp": "04:01:49", "text": "收集书籍并开始阅读"}, {"type": "subtitle", "time": 14512.79, "timestamp": "04:01:52", "text": "很多，是的。哦，八个零。谢谢。"}, {"type": "subtitle", "time": 14515.51, "timestamp": "04:01:55", "text": "谢谢你点赞伤口。"}]
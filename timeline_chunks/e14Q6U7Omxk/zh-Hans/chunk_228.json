[{"type": "subtitle", "time": 13681.03, "timestamp": "03:48:01", "text": "环境。总之，是的。还有一个"}, {"type": "subtitle", "time": 13684.63, "timestamp": "03:48:04", "text": "通常来说，这件事的好处是……"}, {"type": "subtitle", "time": 13687.51, "timestamp": "03:48:07", "text": "我所做的研究，呃，我注意到"}, {"type": "subtitle", "time": 13690.79, "timestamp": "03:48:10", "text": "日本人不是，他们不想这样。"}, {"type": "subtitle", "time": 13693.67, "timestamp": "03:48:13", "text": "外国人像往常一样在那里"}, {"type": "subtitle", "time": 13697.03, "timestamp": "03:48:17", "text": "你认识的人，所以你真的需要"}, {"type": "subtitle", "time": 13699.75, "timestamp": "03:48:19", "text": "如果你喜欢，就找个地方住吧。"}, {"type": "subtitle", "time": 13702.389, "timestamp": "03:48:22", "text": "如果你要住宿舍，现在就去大学看看。"}, {"type": "subtitle", "time": 13704.469, "timestamp": "03:48:24", "text": "在大学里，这不是问题。"}, {"type": "subtitle", "time": 13706.63, "timestamp": "03:48:26", "text": "但如果你想住在那里，有人告诉我"}, {"type": "subtitle", "time": 13709.03, "timestamp": "03:48:29", "text": "找一个你真正需要找到的人"}, {"type": "subtitle", "time": 13710.79, "timestamp": "03:48:30", "text": "一个有其他印度人的地方"}, {"type": "subtitle", "time": 13715.67, "timestamp": "03:48:35", "text": "人们。啊，是的。是的。"}, {"type": "subtitle", "time": 13717.91, "timestamp": "03:48:37", "text": "有些人憎恨外国人。"}, {"type": "subtitle", "time": 13721.51, "timestamp": "03:48:41", "text": "他们可能会变得种族主义、仇外，或者兼而有之。"}, {"type": "subtitle", "time": 13723.83, "timestamp": "03:48:43", "text": "那些东西。我当时甚至都没意识到自己像个傻瓜。"}, {"type": "subtitle", "time": 13726.469, "timestamp": "03:48:46", "text": "哇，日本真好，日本真棒！"}, {"type": "subtitle", "time": 13728.63, "timestamp": "03:48:48", "text": "了解动漫之类的东西。但是当我"}, {"type": "subtitle", "time": 13730.71, "timestamp": "03:48:50", "text": "开始像直播一样开放这些页面，"}, {"type": "subtitle", "time": 13733.99, "timestamp": "03:48:53", "text": "你知道，那些线下直播，伙计，"}, {"type": "subtitle", "time": 13736.87, "timestamp": "03:48:56", "text": "老兄，那些人说的就是这种话。"}, {"type": "subtitle", "time": 13739.03, "timestamp": "03:48:59", "text": "甚至不知道那个种族主义者"}]
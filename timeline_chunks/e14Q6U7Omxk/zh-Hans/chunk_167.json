[{"type": "subtitle", "time": 10021.59, "timestamp": "02:47:01", "text": "不知道。就像在夜里你"}, {"type": "subtitle", "time": 10024.469, "timestamp": "02:47:04", "text": "我们当时好像有个这样的日程安排。"}, {"type": "subtitle", "time": 10026.71, "timestamp": "02:47:06", "text": "我想，你已经展示了你的课程时间安排。"}, {"type": "subtitle", "time": 10029.11, "timestamp": "02:47:09", "text": "每天都是如此。所以一切都是紫色的。"}, {"type": "subtitle", "time": 10031.83, "timestamp": "02:47:11", "text": "屏幕停留一秒钟，大概3到4秒。"}, {"type": "subtitle", "time": 10035.11, "timestamp": "02:47:15", "text": "秒。课程时间安排，呃，就像"}, {"type": "subtitle", "time": 10037.99, "timestamp": "02:47:17", "text": "是在病房里，还是像……呃，当我……的时候"}, {"type": "subtitle", "time": 10040.309, "timestamp": "02:47:20", "text": "那里？不，不，就像我们以前那样"}, {"type": "subtitle", "time": 10046.389, "timestamp": "02:47:26", "text": "2、30 还是别的什么，我不知道是多少。"}, {"type": "subtitle", "time": 10049.48, "timestamp": "02:47:29", "text": "但它，但我不知道"}, {"type": "subtitle", "time": 10051.269, "timestamp": "02:47:31", "text": "[音乐]"}, {"type": "subtitle", "time": 10053.11, "timestamp": "02:47:33", "text": "现在情况怎么样？事情进展如何？"}, {"type": "subtitle", "time": 10055.75, "timestamp": "02:47:35", "text": "现在这些课程就像……"}, {"type": "subtitle", "time": 10057.91, "timestamp": "02:47:37", "text": "你现在打算怎么办？这是怎么回事"}, {"type": "subtitle", "time": 10059.91, "timestamp": "02:47:39", "text": "就这样"}, {"type": "subtitle", "time": 10063.75, "timestamp": "02:47:43", "text": "班级？他们仍然处于呃呃状态"}, {"type": "subtitle", "time": 10065.91, "timestamp": "02:47:45", "text": "关于N4课程的讨论，"}, {"type": "subtitle", "time": 10067.75, "timestamp": "02:47:47", "text": "日语课程。"}, {"type": "subtitle", "time": 10071.11, "timestamp": "02:47:51", "text": "既然这就像进入了一个新的阶段，我就有"}, {"type": "subtitle", "time": 10074.389, "timestamp": "02:47:54", "text": "我必须认真努力，"}, {"type": "subtitle", "time": 10077.83, "timestamp": "02:47:57", "text": "实际上，从现在开始，我一直在学习和做其他事情。"}]
[{"type": "subtitle", "time": 2115.109, "timestamp": "00:35:15", "text": "我透過"}, {"type": "subtitle", "time": 2118.31, "timestamp": "00:35:18", "text": "按下右側破碎機"}, {"type": "subtitle", "time": 2124.15, "timestamp": "00:35:24", "text": "釋放按鈕來完成的。好的，明白了。"}, {"type": "subtitle", "time": 2127.109, "timestamp": "00:35:27", "text": "斷開標記，然後是藍色"}, {"type": "subtitle", "time": 2129.589, "timestamp": "00:35:29", "text": "斜線。知道了。"}, {"type": "subtitle", "time": 2133.109, "timestamp": "00:35:33", "text": "這就是《艾爾登法環》的精髓所在"}, {"type": "subtitle", "time": 2137.589, "timestamp": "00:35:37", "text": "。  我的天哪，是艾倫林。"}, {"type": "subtitle", "time": 2147.03, "timestamp": "00:35:47", "text": "確實讓人聯想到"}]
[{"type": "subtitle", "time": 13509.83, "timestamp": "03:45:09", "text": "我得結束了。我得結束了"}, {"type": "subtitle", "time": 13511.429, "timestamp": "03:45:11", "text": "。"}, {"type": "subtitle", "time": 13516.63, "timestamp": "03:45:16", "text": "呃，謝謝。是的，我"}, {"type": "subtitle", "time": 13519.75, "timestamp": "03:45:19", "text": "前天公佈了設計圖"}, {"type": "subtitle", "time": 13524.469, "timestamp": "03:45:24", "text": "。我在這裡只是為了完成它。嗨，"}, {"type": "subtitle", "time": 13531.429, "timestamp": "03:45:31", "text": "既然新機型已經上市，"}, {"type": "subtitle", "time": 13535.83, "timestamp": "03:45:35", "text": "一切都步入正軌，我也慢慢需要開始"}, {"type": "subtitle", "time": 13539.67, "timestamp": "03:45:39", "text": "做一些事情了。我用的是Canva。我的拇指"}, {"type": "subtitle", "time": 13544.309, "timestamp": "03:45:44", "text": "看起來不錯。 Canva。是的，Canva 挺不錯的。  是的"}, {"type": "subtitle", "time": 13545.59, "timestamp": "03:45:45", "text": "，我本來不想用"}, {"type": "subtitle", "time": 13547.51, "timestamp": "03:45:47", "text": "Photoshop，但我們最終選擇了"}, {"type": "subtitle", "time": 13552.55, "timestamp": "03:45:52", "text": "Affinity，因為它被 Canva 收購了，"}, {"type": "subtitle", "time": 13555.429, "timestamp": "03:45:55", "text": "對吧？我想透過"}, {"type": "subtitle", "time": 13557.91, "timestamp": "03:45:57", "text": "名為 Calvary 的工具來使用它，它是"}]
[{"type": "subtitle", "time": 12540.87, "timestamp": "03:29:00", "text": "當我的室友不在我的房間裡，無論是在"}, {"type": "subtitle", "time": 12544.87, "timestamp": "03:29:04", "text": "宿舍或公寓裡，我才能自由地說話。"}, {"type": "subtitle", "time": 12546.79, "timestamp": "03:29:06", "text": "因為當他在的時候，我必須"}, {"type": "subtitle", "time": 12549.03, "timestamp": "03:29:09", "text": "注意音頻，我"}, {"type": "subtitle", "time": 12551.91, "timestamp": "03:29:11", "text": "必須確保他的聲音能"}, {"type": "subtitle", "time": 12557.51, "timestamp": "03:29:17", "text": "透過我的麥克風被聽到，等等等等，真是"}, {"type": "subtitle", "time": 12559.91, "timestamp": "03:29:19", "text": "太煩人了。你的疼痛感是否與"}, {"type": "subtitle", "time": 12567.91, "timestamp": "03:29:27", "text": "我的良好降噪效果有關？我"}, {"type": "subtitle", "time": 12570.309, "timestamp": "03:29:30", "text": "只是希望，我覺得我需要"}, {"type": "subtitle", "time": 12573.429, "timestamp": "03:29:33", "text": "一個"}, {"type": "subtitle", "time": 12576.229, "timestamp": "03:29:36", "text": "基於人工智慧的訂閱者抑制之類的東西，它"}, {"type": "subtitle", "time": 12579.75, "timestamp": "03:29:39", "text": "只能在我（Jocknix）說話時發出聲音，"}, {"type": "subtitle", "time": 12586.55, "timestamp": "03:29:46", "text": "它可以檢測並理解誰是誰，還有誰在"}, {"type": "subtitle", "time": 12590.15, "timestamp": "03:29:50", "text": "說話，就像這樣。哦，"}, {"type": "subtitle", "time": 12593.269, "timestamp": "03:29:53", "text": "等等。死。"}]
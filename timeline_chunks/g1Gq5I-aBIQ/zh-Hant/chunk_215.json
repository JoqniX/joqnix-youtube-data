[{"type": "subtitle", "time": 12901.91, "timestamp": "03:35:01", "text": "危機爆發和失業之前升級電腦是件好事。哦，不，那挺好"}, {"type": "subtitle", "time": 12905.83, "timestamp": "03:35:05", "text": "的。你在危機爆發前升級了記憶體"}, {"type": "subtitle", "time": 12908.87, "timestamp": "03:35:08", "text": "。我去店裡看過"}, {"type": "subtitle", "time": 12913.83, "timestamp": "03:35:13", "text": "。大概是76000日元。"}, {"type": "subtitle", "time": 12916.309, "timestamp": "03:35:16", "text": "那相當於什麼？"}, {"type": "subtitle", "time": 12917.99, "timestamp": "03:35:17", "text": "5萬到"}, {"type": "subtitle", "time": 12932.229, "timestamp": "03:35:32", "text": "我不知道。"}, {"type": "subtitle", "time": 12933.83, "timestamp": "03:35:33", "text": "請告訴我我不用從頭開始玩"}, {"type": "subtitle", "time": 12935.99, "timestamp": "03:35:35", "text": "遊戲。請告訴我我不用"}, {"type": "subtitle", "time": 12937.51, "timestamp": "03:35:37", "text": "從頭開始玩遊戲"}, {"type": "subtitle", "time": 12939.59, "timestamp": "03:35:39", "text": "。"}, {"type": "subtitle", "time": 12955.384, "timestamp": "03:35:55", "text": "不。"}, {"type": "subtitle", "time": 12956.63, "timestamp": "03:35:56", "text": "（倒吸一口涼氣）"}, {"type": "subtitle", "time": 12959.19, "timestamp": "03:35:59", "text": "不。"}]
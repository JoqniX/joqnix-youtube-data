[{"type": "subtitle", "time": 2523.43, "timestamp": "00:42:03", "text": "我確實感覺很像那種網路氛圍。  那是什麼？我當時想，等等，他"}, {"type": "subtitle", "time": 2526.63, "timestamp": "00:42:06", "text": "要殺了我們嗎？某物。"}, {"type": "subtitle", "time": 2539.349, "timestamp": "00:42:19", "text": "我總覺得他會背叛我"}, {"type": "subtitle", "time": 2541.349, "timestamp": "00:42:21", "text": "之類的？"}, {"type": "subtitle", "time": 2543.67, "timestamp": "00:42:23", "text": "是因為"}, {"type": "subtitle", "time": 2546.95, "timestamp": "00:42:26", "text": "我們沒有……我才無法改變我的"}, {"type": "subtitle", "time": 2574.79, "timestamp": "00:42:54", "text": "哦好的。好的。你會玩到「好的」。"}]
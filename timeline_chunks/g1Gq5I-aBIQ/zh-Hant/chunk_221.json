[{"type": "subtitle", "time": 13260.07, "timestamp": "03:41:00", "text": "。  是這樣的。"}, {"type": "subtitle", "time": 13264.229, "timestamp": "03:41:04", "text": "讓我截個圖。"}, {"type": "subtitle", "time": 13272.389, "timestamp": "03:41:12", "text": "等等。你能"}, {"type": "subtitle", "time": 13290.469, "timestamp": "03:41:30", "text": "等等，有直播嗎"}, {"type": "subtitle", "time": 13293.59, "timestamp": "03:41:33", "text": "？呃，等等，為什麼你看不見"}, {"type": "subtitle", "time": 13313.51, "timestamp": "03:41:53", "text": "存在反訴訟條款。什麼？"}, {"type": "subtitle", "time": 13315.19, "timestamp": "03:41:55", "text": "我的天啊。別在意。不用在意"}, {"type": "subtitle", "time": 13319.429, "timestamp": "03:41:59", "text": "這些。嗯，稍等一下。"}]
[{"type": "subtitle", "time": 1380.549, "timestamp": "00:23:00", "text": "？"}, {"type": "subtitle", "time": 1382.549, "timestamp": "00:23:02", "text": "還有那邊。那裡什麼也沒有。我"}, {"type": "subtitle", "time": 1387.19, "timestamp": "00:23:07", "text": "現在就感覺到了手把的操控感。"}, {"type": "subtitle", "time": 1416.95, "timestamp": "00:23:36", "text": "所以，我們就能看到桿臂了。"}, {"type": "subtitle", "time": 1424.95, "timestamp": "00:23:44", "text": "容易躲避，因為會有"}]
[{"type": "subtitle", "time": 12961.349, "timestamp": "03:36:01", "text": "我為什麼要買東西給朋友？我想"}, {"type": "subtitle", "time": 12973.67, "timestamp": "03:36:13", "text": "我很樂意。只是我不"}, {"type": "subtitle", "time": 12976.07, "timestamp": "03:36:16", "text": "知道我能否做出多大貢獻，因為現在是晚上"}, {"type": "subtitle", "time": 12982.55, "timestamp": "03:36:22", "text": "8 點的時區。在印度，現在就像"}, {"type": "subtitle", "time": 12987.91, "timestamp": "03:36:27", "text": "晚上11點一樣。為我。呃，我"}, {"type": "subtitle", "time": 12991.99, "timestamp": "03:36:31", "text": "至少要在下午2點前睡覺。或是凌晨"}, {"type": "subtitle", "time": 12994.309, "timestamp": "03:36:34", "text": "2 點，因為我早上"}, {"type": "subtitle", "time": 12998.15, "timestamp": "03:36:38", "text": "6 點要起床上班，"}, {"type": "subtitle", "time": 13003.429, "timestamp": "03:36:43", "text": "中午去學校上課，回來後，隔天"}, {"type": "subtitle", "time": 13007.51, "timestamp": "03:36:47", "text": "重複這個過程。所以，我只有……嗯……"}, {"type": "subtitle", "time": 13013.269, "timestamp": "03:36:53", "text": "所以，這就是問題所在。我們最終會在可以的時候崩潰。所以，我們可以這樣做。所以"}]
[{"type": "subtitle", "time": 2115.109, "timestamp": "00:35:15", "text": "我"}, {"type": "subtitle", "time": 2118.31, "timestamp": "00:35:18", "text": "通过按下右侧破碎机"}, {"type": "subtitle", "time": 2124.15, "timestamp": "00:35:24", "text": "释放按钮来完成的。 好的，明白了。"}, {"type": "subtitle", "time": 2127.109, "timestamp": "00:35:27", "text": "断开标记，然后是蓝色斜杠"}, {"type": "subtitle", "time": 2129.589, "timestamp": "00:35:29", "text": "。 知道了。"}, {"type": "subtitle", "time": 2133.109, "timestamp": "00:35:33", "text": "这就是《艾尔登法环》的精髓所在。"}, {"type": "subtitle", "time": 2137.589, "timestamp": "00:35:37", "text": "我的天哪，是艾伦·林。"}, {"type": "subtitle", "time": 2147.03, "timestamp": "00:35:47", "text": "机制确实让人"}]
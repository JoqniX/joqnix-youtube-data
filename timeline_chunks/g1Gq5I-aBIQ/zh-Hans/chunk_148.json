[{"type": "subtitle", "time": 8912.63, "timestamp": "02:28:32", "text": "钢剑。 哦，"}, {"type": "subtitle", "time": 8915.11, "timestamp": "02:28:35", "text": "这太值得了。 米娜，我千里迢迢来到"}, {"type": "subtitle", "time": 8917.51, "timestamp": "02:28:37", "text": "这里真是值了。 所以，我们要做的"}, {"type": "subtitle", "time": 8919.67, "timestamp": "02:28:39", "text": "就是瞬间移动。"}, {"type": "subtitle", "time": 8927.67, "timestamp": "02:28:47", "text": "女士，"}, {"type": "subtitle", "time": 8930.55, "timestamp": "02:28:50", "text": "我们一路走过去。"}, {"type": "subtitle", "time": 8934.23, "timestamp": "02:28:54", "text": "我们必须在那之前走。"}, {"type": "subtitle", "time": 8936.71, "timestamp": "02:28:56", "text": "我们在"}]
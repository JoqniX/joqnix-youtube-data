[{"type": "subtitle", "time": 14340.95, "timestamp": "03:59:00", "text": "看了一会儿，感觉很"}, {"type": "subtitle", "time": 14345.11, "timestamp": "03:59:05", "text": "不错。 我当时就想，“好吧，我是刀剑神域的粉丝。"}, {"type": "subtitle", "time": 14350.79, "timestamp": "03:59:10", "text": "我看过刀剑神域的轻小说之类的，所以"}, {"type": "subtitle", "time": 14355.59, "timestamp": "03:59:15", "text": "我想玩这款游戏。”"}, {"type": "subtitle", "time": 14358.79, "timestamp": "03:59:18", "text": "说实话，我本来想"}, {"type": "subtitle", "time": 14361.11, "timestamp": "03:59:21", "text": "在 Alicization"}, {"type": "subtitle", "time": 14363.75, "timestamp": "03:59:23", "text": "发售的时候或者"}, {"type": "subtitle", "time": 14367.11, "timestamp": "03:59:27", "text": "几年后在网上购买 Sodat。 是的，"}, {"type": "subtitle", "time": 14369.429, "timestamp": "03:59:29", "text": "我看过《爱丽丝幻爱丽丝化》的轻小说"}, {"type": "subtitle", "time": 14371.429, "timestamp": "03:59:31", "text": "。"}, {"type": "subtitle", "time": 14374.63, "timestamp": "03:59:34", "text": "还有另一个，我忘了它在哪儿了"}, {"type": "subtitle", "time": 14377.67, "timestamp": "03:59:37", "text": "。 所以我不得不"}, {"type": "subtitle", "time": 14380.79, "timestamp": "03:59:40", "text": "从第一季第一卷的第一章开始，一直读到动画化后的第一卷。[笑]"}, {"type": "subtitle", "time": 14390.55, "timestamp": "03:59:50", "text": "我的天哪，那相当于我要补读十多本人生小说了"}, {"type": "subtitle", "time": 14395.349, "timestamp": "03:59:55", "text": "。 坏的。 这大概是"}]
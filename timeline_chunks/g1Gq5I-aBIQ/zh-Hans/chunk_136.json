[{"type": "subtitle", "time": 8162.47, "timestamp": "02:16:02", "text": "我感到很抱歉。 你不是我的沙袋。 去。"}, {"type": "subtitle", "time": 8164.47, "timestamp": "02:16:04", "text": "呃，我不应该说我叫你我的"}, {"type": "subtitle", "time": 8166.95, "timestamp": "02:16:06", "text": "沙袋。  [笑声]"}, {"type": "subtitle", "time": 8168.95, "timestamp": "02:16:08", "text": "哦，等等。 说到沙袋。 这难道不是"}, {"type": "subtitle", "time": 8175.03, "timestamp": "02:16:15", "text": "某种"}, {"type": "subtitle", "time": 8203.27, "timestamp": "02:16:43", "text": "选紫色。 我觉得这个区域也一样"}, {"type": "subtitle", "time": 8205.03, "timestamp": "02:16:45", "text": "，会有一个"}, {"type": "subtitle", "time": 8207.75, "timestamp": "02:16:47", "text": "你拿不到的宝箱。 它肯定出"}]
[{"type": "subtitle", "time": 14401.51, "timestamp": "04:00:01", "text": "六年前的事了。 大概是6年前，"}, {"type": "subtitle", "time": 14405.269, "timestamp": "04:00:05", "text": "或者2018年"}, {"type": "subtitle", "time": 14407.429, "timestamp": "04:00:07", "text": "17月左右吧"}, {"type": "subtitle", "time": 14410.71, "timestamp": "04:00:10", "text": "。 谁知道呢？"}, {"type": "subtitle", "time": 14413.83, "timestamp": "04:00:13", "text": "嗯，后来动画就出来了。 那真"}, {"type": "subtitle", "time": 14437.51, "timestamp": "04:00:37", "text": "我真的很想做一些"}, {"type": "subtitle", "time": 14441.349, "timestamp": "04:00:41", "text": "疯狂的动画，或者做"}, {"type": "subtitle", "time": 14446.309, "timestamp": "04:00:46", "text": "一些疯狂的事情，但是我又觉得"}, {"type": "subtitle", "time": 14448.229, "timestamp": "04:00:48", "text": "我不想把我的精力"}, {"type": "subtitle", "time": 14452.63, "timestamp": "04:00:52", "text": "和时间浪费在这些我"}, {"type": "subtitle", "time": 14457.03, "timestamp": "04:00:57", "text": "以前做过的、不必要的事情上，因为我的"}, {"type": "subtitle", "time": 14459.91, "timestamp": "04:00:59", "text": "时间现在有限，所以我必须把"}]
[{"type": "subtitle", "time": 14701.189, "timestamp": "04:05:01", "text": "好吧，我昨天睡得很晚，"}, {"type": "subtitle", "time": 14704.15, "timestamp": "04:05:04", "text": "大概凌晨四点，结果"}, {"type": "subtitle", "time": 14706.15, "timestamp": "04:05:06", "text": "整个人都垮了。"}, {"type": "subtitle", "time": 14709.429, "timestamp": "04:05:09", "text": "我睡过头去上班了。"}, {"type": "subtitle", "time": 14712.469, "timestamp": "04:05:12", "text": "我早上10点醒来，突然意识到，糟了"}, {"type": "subtitle", "time": 14715.389, "timestamp": "04:05:15", "text": "。"}, {"type": "subtitle", "time": 14716.63, "timestamp": "04:05:16", "text": "[笑声]"}, {"type": "subtitle", "time": 14718.95, "timestamp": "04:05:18", "text": "但是，是的，我不应该，我应该……"}, {"type": "subtitle", "time": 14720.87, "timestamp": "04:05:20", "text": "沟通。 这很糟糕。 我可能要被"}, {"type": "subtitle", "time": 14723.67, "timestamp": "04:05:23", "text": "解雇了。 谁知道呢？ 嗯，但愿一切"}, {"type": "subtitle", "time": 14726.79, "timestamp": "04:05:26", "text": "顺利。 我会尽我所能，"}, {"type": "subtitle", "time": 14728.63, "timestamp": "04:05:28", "text": "希望你们以后能来我的直播间看看，"}, {"type": "subtitle", "time": 14732.229, "timestamp": "04:05:32", "text": "也希望你们喜欢"}, {"type": "subtitle", "time": 14735.59, "timestamp": "04:05:35", "text": "今天的直播。 嗨，我"}, {"type": "subtitle", "time": 14738.95, "timestamp": "04:05:38", "text": "下次直播会玩《Iron Cry》的关卡，为此"}, {"type": "subtitle", "time": 14743.429, "timestamp": "04:05:43", "text": "我安排了时间，等等，在"}, {"type": "subtitle", "time": 14748.229, "timestamp": "04:05:48", "text": "我说出具体时间之前，嗯，"}, {"type": "subtitle", "time": 14755.189, "timestamp": "04:05:55", "text": "哦等等，"}, {"type": "subtitle", "time": 14757.83, "timestamp": "04:05:57", "text": "星期六我要去东京，所以"}]
[{"type": "subtitle", "time": 9727.19, "timestamp": "02:42:07", "text": "什么？ 等等，你为什么要带我"}, {"type": "subtitle", "time": 9729.19, "timestamp": "02:42:09", "text": "回镇上？ 等等，为什么会出现"}, {"type": "subtitle", "time": 9732.469, "timestamp": "02:42:12", "text": "城镇加载画面？"}, {"type": "subtitle", "time": 9734.71, "timestamp": "02:42:14", "text": "我不想回家。   我"}, {"type": "subtitle", "time": 9736.71, "timestamp": "02:42:16", "text": "只想收集"}, {"type": "subtitle", "time": 9739.429, "timestamp": "02:42:19", "text": "那个区域的宝箱，把那个区域的宝箱全部收集完，"}, {"type": "subtitle", "time": 9743.83, "timestamp": "02:42:23", "text": "然后就离开。 这就是我"}]
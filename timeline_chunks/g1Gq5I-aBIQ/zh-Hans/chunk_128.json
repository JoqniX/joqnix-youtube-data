[{"type": "subtitle", "time": 7685.35, "timestamp": "02:08:05", "text": "地图尽头有一个宝箱"}, {"type": "subtitle", "time": 7702.069, "timestamp": "02:08:22", "text": "兄弟，他们知道该把这些箱子藏在哪儿，"}, {"type": "subtitle", "time": 7704.629, "timestamp": "02:08:24", "text": "因为他们会想：“没错，玩家们"}, {"type": "subtitle", "time": 7708.87, "timestamp": "02:08:28", "text": "出不去，也拿不到。我们"}, {"type": "subtitle", "time": 7713.669, "timestamp": "02:08:33", "text": "不会让你们拿到宝贝。"}, {"type": "subtitle", "time": 7723.99, "timestamp": "02:08:43", "text": "其他办法，对吧？"}, {"type": "subtitle", "time": 7726.87, "timestamp": "02:08:46", "text": "我可以从"}]
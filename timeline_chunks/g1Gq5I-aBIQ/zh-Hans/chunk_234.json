[{"type": "subtitle", "time": 14042.07, "timestamp": "03:54:02", "text": "你从你那里毕业了。 你说过你曾"}, {"type": "subtitle", "time": 14044.469, "timestamp": "03:54:04", "text": "和黑田道别过一次。"}, {"type": "subtitle", "time": 14046.87, "timestamp": "03:54:06", "text": "似乎它在房间里留下了什么东西"}, {"type": "subtitle", "time": 14049.59, "timestamp": "03:54:09", "text": "。"}, {"type": "subtitle", "time": 14053.189, "timestamp": "03:54:13", "text": "哦不，他离开了我。"}, {"type": "subtitle", "time": 14056.07, "timestamp": "03:54:16", "text": "哇。"}, {"type": "subtitle", "time": 14058.469, "timestamp": "03:54:18", "text": "但那确实是个不错的"}, {"type": "subtitle", "time": 14061.03, "timestamp": "03:54:21", "text": "道具。 哦，宠物。 好的。 所以，就像"}, {"type": "subtitle", "time": 14063.59, "timestamp": "03:54:23", "text": "你看到的这样。 然后"}, {"type": "subtitle", "time": 14066.87, "timestamp": "03:54:26", "text": "我们就可以设置一些"}, {"type": "subtitle", "time": 14070.07, "timestamp": "03:54:30", "text": "计时器之类的东西了。 呃，我想，"}, {"type": "subtitle", "time": 14072.55, "timestamp": "03:54:32", "text": "我想，它在哪儿？ 我的天啊。"}, {"type": "subtitle", "time": 14080.229, "timestamp": "03:54:40", "text": "，例行公事。 这样我就可以制定计划了。 我"}, {"type": "subtitle", "time": 14083.269, "timestamp": "03:54:43", "text": "可以设置定时器。 我需要多少时间，"}, {"type": "subtitle", "time": 14085.11, "timestamp": "03:54:45", "text": "我需要多少专注时间，"}, {"type": "subtitle", "time": 14087.67, "timestamp": "03:54:47", "text": "我需要多少休息时间，长"}, {"type": "subtitle", "time": 14089.83, "timestamp": "03:54:49", "text": "休息需要多长时间"}, {"type": "subtitle", "time": 14092.71, "timestamp": "03:54:52", "text": "等等。 所以我们会一起做类似的事情，"}, {"type": "subtitle", "time": 14096.15, "timestamp": "03:54:56", "text": "共同努力。"}, {"type": "subtitle", "time": 14099.83, "timestamp": "03:54:59", "text": "嗯，这就是我对即将到来的直播的想法"}]
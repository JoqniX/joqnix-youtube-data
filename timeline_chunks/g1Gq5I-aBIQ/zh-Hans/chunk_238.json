[{"type": "subtitle", "time": 14282.15, "timestamp": "03:58:02", "text": "如果我早上 6 点开始直播，"}, {"type": "subtitle", "time": 14284.389, "timestamp": "03:58:04", "text": "那在印度就是凌晨 2 点 30 分……"}, {"type": "subtitle", "time": 14288.55, "timestamp": "03:58:08", "text": "所以……好吧……凌晨 12 点"}, {"type": "subtitle", "time": 14294.15, "timestamp": "03:58:14", "text": "12 分对我来说就是凌晨 4 点到 3 点 30 分。"}, {"type": "subtitle", "time": 14297.189, "timestamp": "03:58:17", "text": "哦，原来是这样。"}, {"type": "subtitle", "time": 14300.15, "timestamp": "03:58:20", "text": "夜晚。 还是不太习惯时区这"}, {"type": "subtitle", "time": 14302.55, "timestamp": "03:58:22", "text": "回事，不过，是啊"}, {"type": "subtitle", "time": 14312.07, "timestamp": "03:58:32", "text": "但今天过得很开心。 我喜欢这款游戏，"}, {"type": "subtitle", "time": 14314.71, "timestamp": "03:58:34", "text": "因为它很精彩。"}, {"type": "subtitle", "time": 14317.429, "timestamp": "03:58:37", "text": "是的，我一直想玩"}, {"type": "subtitle", "time": 14320.71, "timestamp": "03:58:40", "text": "这款游戏，而且我好像还看过 Yuki"}, {"type": "subtitle", "time": 14324.55, "timestamp": "03:58:44", "text": "Sakuna 的直播，她是一位"}, {"type": "subtitle", "time": 14326.87, "timestamp": "03:58:46", "text": "非常受欢迎的日本"}, {"type": "subtitle", "time": 14328.63, "timestamp": "03:58:48", "text": "YouTuber。"}, {"type": "subtitle", "time": 14333.11, "timestamp": "03:58:53", "text": "我当时就想：等等，这游戏已经出了？什么？"}, {"type": "subtitle", "time": 14335.99, "timestamp": "03:58:55", "text": "我看了会儿。 我"}, {"type": "subtitle", "time": 14338.15, "timestamp": "03:58:58", "text": "不想宠坏自己。 我"}]
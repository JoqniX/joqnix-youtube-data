[{"type": "subtitle", "time": 12540.87, "timestamp": "03:29:00", "text": "当我的室友不在我的房间里，无论是在"}, {"type": "subtitle", "time": 12544.87, "timestamp": "03:29:04", "text": "宿舍还是公寓里，我才能自由地说话。"}, {"type": "subtitle", "time": 12546.79, "timestamp": "03:29:06", "text": "因为当他在的时候，我必须"}, {"type": "subtitle", "time": 12549.03, "timestamp": "03:29:09", "text": "注意音频，我"}, {"type": "subtitle", "time": 12551.91, "timestamp": "03:29:11", "text": "必须确保他的声音能通过"}, {"type": "subtitle", "time": 12557.51, "timestamp": "03:29:17", "text": "我的麦克风被听到，等等等等，真是"}, {"type": "subtitle", "time": 12559.91, "timestamp": "03:29:19", "text": "太烦人了。 你的疼痛感是否与"}, {"type": "subtitle", "time": 12567.91, "timestamp": "03:29:27", "text": "我的良好降噪效果有关？"}, {"type": "subtitle", "time": 12570.309, "timestamp": "03:29:30", "text": "我只是希望，我觉得我需要"}, {"type": "subtitle", "time": 12573.429, "timestamp": "03:29:33", "text": "一个"}, {"type": "subtitle", "time": 12576.229, "timestamp": "03:29:36", "text": "基于人工智能的订阅者抑制之类的东西，"}, {"type": "subtitle", "time": 12579.75, "timestamp": "03:29:39", "text": "它只能在"}, {"type": "subtitle", "time": 12583.11, "timestamp": "03:29:43", "text": "我（Jocknix）说话时发出声音，"}, {"type": "subtitle", "time": 12586.55, "timestamp": "03:29:46", "text": "它可以检测并理解谁是谁，还有"}, {"type": "subtitle", "time": 12590.15, "timestamp": "03:29:50", "text": "谁在说话，就像这样。 哦，"}, {"type": "subtitle", "time": 12593.269, "timestamp": "03:29:53", "text": "等等。 死。"}]
[{"type": "subtitle", "time": 14223.349, "timestamp": "03:57:03", "text": "周六、每月一次的"}, {"type": "subtitle", "time": 14227.99, "timestamp": "03:57:07", "text": "周六或者周日周末，才有可能进行 4 小时的直播。"}, {"type": "subtitle", "time": 14229.91, "timestamp": "03:57:09", "text": "好的。"}, {"type": "subtitle", "time": 14232.389, "timestamp": "03:57:12", "text": "因为要么我得早起，呃，比如"}, {"type": "subtitle", "time": 14236.309, "timestamp": "03:57:16", "text": "日本时间早上6点，也就是美国东部时间早上"}, {"type": "subtitle", "time": 14240.389, "timestamp": "03:57:20", "text": "5点左右？ 这就像什么？"}, {"type": "subtitle", "time": 14244.79, "timestamp": "03:57:24", "text": "凌晨 3 点或 2 点。印度的凌晨 2 点。"}, {"type": "subtitle", "time": 14250.79, "timestamp": "03:57:30", "text": "等等，不，等等。 不，等等。  2 3 米。"}, {"type": "subtitle", "time": 14254.15, "timestamp": "03:57:34", "text": "那相当于什么？"}, {"type": "subtitle", "time": 14262.469, "timestamp": "03:57:42", "text": "12点就像凌晨12点，那凌晨12点就像什么？ 凌晨 3 点到"}, {"type": "subtitle", "time": 14264.15, "timestamp": "03:57:44", "text": "3 点"}, {"type": "subtitle", "time": 14267.429, "timestamp": "03:57:47", "text": "12 分在印度就像……"}, {"type": "subtitle", "time": 14271.83, "timestamp": "03:57:51", "text": "等等，我忘了几点了……等等，"}, {"type": "subtitle", "time": 14275.51, "timestamp": "03:57:55", "text": "这时区真奇怪……"}, {"type": "subtitle", "time": 14278.389, "timestamp": "03:57:58", "text": "让我想想……让我想想……"}]
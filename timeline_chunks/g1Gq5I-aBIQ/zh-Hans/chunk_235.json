[{"type": "subtitle", "time": 14103.51, "timestamp": "03:55:03", "text": "。"}, {"type": "subtitle", "time": 14105.83, "timestamp": "03:55:05", "text": "呃，我得周一到"}, {"type": "subtitle", "time": 14107.51, "timestamp": "03:55:07", "text": "周五上班。 是啊，不是星期一。 今天是"}, {"type": "subtitle", "time": 14111.429, "timestamp": "03:55:11", "text": "星期一，星期二到星期五。 我"}, {"type": "subtitle", "time": 14113.91, "timestamp": "03:55:13", "text": "想做那些学习直播，顺便补补"}, {"type": "subtitle", "time": 14117.67, "timestamp": "03:55:17", "text": "我喜欢的东西。"}, {"type": "subtitle", "time": 14120.389, "timestamp": "03:55:20", "text": "我本来很想做些"}, {"type": "subtitle", "time": 14123.83, "timestamp": "03:55:23", "text": "类似日语学习之类的事情，"}, {"type": "subtitle", "time": 14125.99, "timestamp": "03:55:25", "text": "因为它不是日语。 我正在学习"}, {"type": "subtitle", "time": 14129.83, "timestamp": "03:55:29", "text": "一些呃，呃，外加课程之类的东西。 所以我"}, {"type": "subtitle", "time": 14132.07, "timestamp": "03:55:32", "text": "想利用直播的时间"}, {"type": "subtitle", "time": 14137.59, "timestamp": "03:55:37", "text": "和你们一起学习（音乐）或者一起工作，"}, {"type": "subtitle", "time": 14141.67, "timestamp": "03:55:41", "text": "如果你们那时有空，欢迎过来，"}, {"type": "subtitle", "time": 14143.51, "timestamp": "03:55:43", "text": "我们可以一起学习或工作。还有，"}, {"type": "subtitle", "time": 14149.11, "timestamp": "03:55:49", "text": "休息时间我也可以和"}, {"type": "subtitle", "time": 14152.95, "timestamp": "03:55:52", "text": "你们聊天什么的。 所以这就是"}, {"type": "subtitle", "time": 14157.03, "timestamp": "03:55:57", "text": "周一（呃，不，是周二）直播时的想法。"}]
[{"type": "subtitle", "time": 14640.63, "timestamp": "04:04:00", "text": "Suda，谢谢你的到来。 萨扬，谢谢"}, {"type": "subtitle", "time": 14642.71, "timestamp": "04:04:02", "text": "你的到来。"}, {"type": "subtitle", "time": 14645.67, "timestamp": "04:04:05", "text": "还有那个"}, {"type": "subtitle", "time": 14648.71, "timestamp": "04:04:08", "text": "愚蠢的老爸。 谢谢你们的光临。"}, {"type": "subtitle", "time": 14654.15, "timestamp": "04:04:14", "text": "嗯，肯扎，我觉得是音乐。 是的。"}, {"type": "subtitle", "time": 14657.269, "timestamp": "04:04:17", "text": "糟糕，我的键盘在"}, {"type": "subtitle", "time": 14659.99, "timestamp": "04:04:19", "text": "聊天的时候好像快要罢工了。 祝你今天余下的时间过得愉快"}, {"type": "subtitle", "time": 14662.71, "timestamp": "04:04:22", "text": "。 你好。 谢谢。   是的"}, {"type": "subtitle", "time": 14665.429, "timestamp": "04:04:25", "text": "。 是的。 我要去……现在是7点……应该是7点"}, {"type": "subtitle", "time": 14667.83, "timestamp": "04:04:27", "text": "40分，对吧？ 我打算"}, {"type": "subtitle", "time": 14672.469, "timestamp": "04:04:32", "text": "洗个脸什么的，吃点东西，"}, {"type": "subtitle", "time": 14682.389, "timestamp": "04:04:42", "text": "然后学习，凌晨一点前早点睡觉，"}, {"type": "subtitle", "time": 14689.59, "timestamp": "04:04:49", "text": "明天还要上班上学。 是的，我今天其实翘"}, {"type": "subtitle", "time": 14693.349, "timestamp": "04:04:53", "text": "班了，因为我不应该"}, {"type": "subtitle", "time": 14696.71, "timestamp": "04:04:56", "text": "翘班。 我 我 我 我 打电话 我 试了 我 睡着了。"}]
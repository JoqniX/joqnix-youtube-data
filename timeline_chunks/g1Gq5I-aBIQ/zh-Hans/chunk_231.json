[{"type": "subtitle", "time": 13861.51, "timestamp": "03:51:01", "text": "嗯，我觉得我电脑里自带的那个应该是笔记本"}, {"type": "subtitle", "time": 13863.11, "timestamp": "03:51:03", "text": "电脑自带的。 我没有对"}, {"type": "subtitle", "time": 13865.51, "timestamp": "03:51:05", "text": "内存部分进行任何改动。 我只对"}, {"type": "subtitle", "time": 13868.55, "timestamp": "03:51:08", "text": "内存进行了定制。 不是内存。 呃，"}, {"type": "subtitle", "time": 13872.95, "timestamp": "03:51:12", "text": "存储。 我没有选择一块 500 GB 的"}, {"type": "subtitle", "time": 13878.95, "timestamp": "03:51:18", "text": "固态硬盘，而是选择了一块 2TB 的固态硬盘（专门用来存放音乐）。"}, {"type": "subtitle", "time": 13882.79, "timestamp": "03:51:22", "text": "呃，我需要储物空间，但是，唉，我真"}, {"type": "subtitle", "time": 13886.79, "timestamp": "03:51:26", "text": "希望我能定制储物空间。 我把"}, {"type": "subtitle", "time": 13889.429, "timestamp": "03:51:29", "text": "16 GB 写成了 32 GB，我应该写的是 32 GB。"}, {"type": "subtitle", "time": 13893.349, "timestamp": "03:51:33", "text": "不应该这样，否则我不会遇到问题，"}, {"type": "subtitle", "time": 13896.309, "timestamp": "03:51:36", "text": "或者可能是 Windows 系统"}, {"type": "subtitle", "time": 13899.349, "timestamp": "03:51:39", "text": "卡住了，你知道，微软的"}, {"type": "subtitle", "time": 13905.83, "timestamp": "03:51:45", "text": "我觉得，我觉得我喜欢这个，4MB 看起来"}, {"type": "subtitle", "time": 13909.349, "timestamp": "03:51:49", "text": "很小，4MB，400MB 扩展后就差不多有 4000MB 了。"}, {"type": "subtitle", "time": 13914.87, "timestamp": "03:51:54", "text": "所以，检查一下你使用的软件和硬件，以及"}, {"type": "subtitle", "time": 13918.55, "timestamp": "03:51:58", "text": "你不使用的软件和硬件，然后禁用它们。等等，嗯"}]
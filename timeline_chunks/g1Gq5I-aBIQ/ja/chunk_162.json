[{"type": "subtitle", "time": 9727.19, "timestamp": "02:42:07", "text": "何だって？ 待って、どうして私を"}, {"type": "subtitle", "time": 9729.19, "timestamp": "02:42:09", "text": "町に連れ戻すの？ 待って、なぜ"}, {"type": "subtitle", "time": 9732.469, "timestamp": "02:42:12", "text": "街の読み込み画面があるの？"}, {"type": "subtitle", "time": 9734.71, "timestamp": "02:42:14", "text": "家に帰りたくない。"}, {"type": "subtitle", "time": 9739.429, "timestamp": "02:42:19", "text": "そのエリアにある宝箱を全部集めて、そのエリアの敵を100%倒したら、そこを"}, {"type": "subtitle", "time": 9743.83, "timestamp": "02:42:23", "text": "離れたいだけです。 それが私のやりたいことです"}]
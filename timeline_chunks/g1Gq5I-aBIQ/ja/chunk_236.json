[{"type": "subtitle", "time": 14166.95, "timestamp": "03:56:06", "text": "、そろそろ締めくくりたいと思います。 えっと、"}, {"type": "subtitle", "time": 14182.87, "timestamp": "03:56:22", "text": "。 ああ、そろそろ切り上げなきゃいけないかもしれない。"}, {"type": "subtitle", "time": 14187.189, "timestamp": "03:56:27", "text": "7時30分。 はい、7時30分です。 わかった。 ちょっと待って、"}, {"type": "subtitle", "time": 14189.51, "timestamp": "03:56:29", "text": "4時間にして、それから締めくくってもいいですか？   あと"}, {"type": "subtitle", "time": 14192.63, "timestamp": "03:56:32", "text": "10分だけ。"}, {"type": "subtitle", "time": 14195.349, "timestamp": "03:56:35", "text": "いや、えっと、あと7分。 ええ、"}, {"type": "subtitle", "time": 14200.07, "timestamp": "03:56:40", "text": "4時間かけて、それから締めくくりましょう。"}, {"type": "subtitle", "time": 14206.15, "timestamp": "03:56:46", "text": "ということで、"}, {"type": "subtitle", "time": 14213.03, "timestamp": "03:56:53", "text": "そして、4 時間の配信は、"}, {"type": "subtitle", "time": 14218.71, "timestamp": "03:56:58", "text": "それが"}]
[{"type": "subtitle", "time": 13740.07, "timestamp": "03:49:00", "text": "その配信を見ていたのですが、彼も最初は"}, {"type": "subtitle", "time": 13743.59, "timestamp": "03:49:03", "text": "エフェクトなどのためにOBSプラグインを使っていたと言っていました。"}, {"type": "subtitle", "time": 13746.87, "timestamp": "03:49:06", "text": "私の場合は、"}, {"type": "subtitle", "time": 13751.349, "timestamp": "03:49:11", "text": "OBS関連のライブエフェクトや音楽を作るのが大好きだったのですが、毎回毎回クラッシュしてしまうので、どうやら"}, {"type": "subtitle", "time": 13760.63, "timestamp": "03:49:20", "text": "彼を通して"}, {"type": "subtitle", "time": 13765.429, "timestamp": "03:49:25", "text": "ChatainなどのソフトウェアやVDJ関連の"}, {"type": "subtitle", "time": 13768.95, "timestamp": "03:49:28", "text": "ビジュアルソフトについて学びました。どうやら彼は"}, {"type": "subtitle", "time": 13771.99, "timestamp": "03:49:31", "text": "その配信でも、OBSは"}, {"type": "subtitle", "time": 13773.91, "timestamp": "03:49:33", "text": "エフェクトや音楽などには向いていないと言っていました。"}, {"type": "subtitle", "time": 13776.389, "timestamp": "03:49:36", "text": "私もOBSに関して似たような経験があり、以前はたくさんの"}, {"type": "subtitle", "time": 13783.03, "timestamp": "03:49:43", "text": "プラグインをインストールしていて、"}, {"type": "subtitle", "time": 13788.15, "timestamp": "03:49:48", "text": "OBSが詰まってしまい、何"}, {"type": "subtitle", "time": 13791.51, "timestamp": "03:49:51", "text": "千ものシーンやソース、"}, {"type": "subtitle", "time": 13795.99, "timestamp": "03:49:55", "text": "シーンがあって、それを制限してドライにしていました"}, {"type": "subtitle", "time": 13799.688, "timestamp": "03:49:59", "text": "。 私は制限して乾燥させていました。"}]
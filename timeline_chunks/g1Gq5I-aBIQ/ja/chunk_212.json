[{"type": "subtitle", "time": 12722.87, "timestamp": "03:32:02", "text": "今はログアウトする時ではありません。 何？"}, {"type": "subtitle", "time": 12725.99, "timestamp": "03:32:05", "text": "待って、ログアウトしたい。"}, {"type": "subtitle", "time": 12727.99, "timestamp": "03:32:07", "text": "いや、"}, {"type": "subtitle", "time": 12731.99, "timestamp": "03:32:11", "text": "待ってください、ログアウトはできません。"}, {"type": "subtitle", "time": 12735.59, "timestamp": "03:32:15", "text": "なあ、俺は辞めたいんだ。   何てことだ"}, {"type": "subtitle", "time": 12760.469, "timestamp": "03:32:40", "text": "待てよ。  F4キーを押すとどうなりますか？ 私は"}, {"type": "subtitle", "time": 12762.79, "timestamp": "03:32:42", "text": "ゲームをやめた。   わかった"}, {"type": "subtitle", "time": 12765.75, "timestamp": "03:32:45", "text": "、ゲームをやめるよ。 何？"}, {"type": "subtitle", "time": 12769.349, "timestamp": "03:32:49", "text": "もう一度開けてみます。 もし私が辞めたらどうなりますか？ やめろ"}, {"type": "subtitle", "time": 12771.59, "timestamp": "03:32:51", "text": "。  [笑い] うまくいくかな"}, {"type": "subtitle", "time": 12774.469, "timestamp": "03:32:54", "text": "？ 見てみましょう。   えっと、"}]
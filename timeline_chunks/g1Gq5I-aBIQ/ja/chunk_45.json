[{"type": "subtitle", "time": 2707.67, "timestamp": "00:45:07", "text": "安全区域。 どうして知っていますか？ 安全地帯では"}, {"type": "subtitle", "time": 2709.589, "timestamp": "00:45:09", "text": "HPが回復し、回復アイテムが補充されます"}, {"type": "subtitle", "time": 2712.15, "timestamp": "00:45:12", "text": "。 その安全なエリアは休憩場所であると同時に、"}, {"type": "subtitle", "time": 2713.589, "timestamp": "00:45:13", "text": "検問所としても機能します。"}, {"type": "subtitle", "time": 2715.27, "timestamp": "00:45:15", "text": "戦闘で部隊が全滅した場合、"}, {"type": "subtitle", "time": 2717.51, "timestamp": "00:45:17", "text": "彼らはこの場所に駆けつけます。"}, {"type": "subtitle", "time": 2719.19, "timestamp": "00:45:19", "text": "休息すると敵が"}, {"type": "subtitle", "time": 2723.19, "timestamp": "00:45:23", "text": "反応することに注意してください。ただし、fa は例外です。 わかった。"}, {"type": "subtitle", "time": 2741.75, "timestamp": "00:45:41", "text": "と私は別のエリアも解放した。"}, {"type": "subtitle", "time": 2744.63, "timestamp": "00:45:44", "text": "私はどこにいても同じように眠ることができます"}]
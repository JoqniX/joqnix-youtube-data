[{"type": "subtitle", "time": 2948.47, "timestamp": "00:49:08", "text": "嫌な予感がする。"}, {"type": "subtitle", "time": 2950.798, "timestamp": "00:49:10", "text": "彼女は演技をしているのでしょうか？"}, {"type": "subtitle", "time": 2961.43, "timestamp": "00:49:21", "text": "ない。 どうして"}, {"type": "subtitle", "time": 2966.71, "timestamp": "00:49:26", "text": "私はこんなに可愛いんだろう？ なぜ私はこんな風なんだろう？"}, {"type": "subtitle", "time": 2969.19, "timestamp": "00:49:29", "text": "ええ、私の言う通りです。 私が正しい。 右。 私は自分の考えが"}, {"type": "subtitle", "time": 2971.349, "timestamp": "00:49:31", "text": "正しいような気がする。 私は自分の考えが"}, {"type": "subtitle", "time": 2974.23, "timestamp": "00:49:34", "text": "正しいような気がする。 彼女はなぜそんなことをしたのか？"}, {"type": "subtitle", "time": 2976.95, "timestamp": "00:49:36", "text": "おい、今の見たか？ 皆さん、ミナ、今の"}, {"type": "subtitle", "time": 2979.589, "timestamp": "00:49:39", "text": "見ましたか？"}, {"type": "subtitle", "time": 2981.91, "timestamp": "00:49:41", "text": "彼女って怪しいと思いませんか？"}, {"type": "subtitle", "time": 2985.51, "timestamp": "00:49:45", "text": "彼女、怪しいよね？"}, {"type": "subtitle", "time": 2987.99, "timestamp": "00:49:47", "text": "彼女は怪しかった。"}, {"type": "subtitle", "time": 2991.829, "timestamp": "00:49:51", "text": "疑わしい。 本当に？"}, {"type": "chat", "time": 2992.4, "timestamp": "00:49:52", "author": "@MikazukiYure", "avatar": "https://yt4.ggpht.com/uuFSD7qVrZy0JUWrBRfSfEKIQpib7_2xP24Yiu1ND1Mq6uhaYIHDnA5EiGz_o33FUhHYvbCT9g=s64-c-k-c0x00ffffff-no-rj", "message": "sus"}]
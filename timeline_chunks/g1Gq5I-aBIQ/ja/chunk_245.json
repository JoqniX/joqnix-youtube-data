[{"type": "subtitle", "time": 14701.189, "timestamp": "04:05:01", "text": "えっと、昨日すごく遅くまで寝て、"}, {"type": "subtitle", "time": 14704.15, "timestamp": "04:05:04", "text": "午前4時くらいまで寝てたんだけど、それで"}, {"type": "subtitle", "time": 14706.15, "timestamp": "04:05:06", "text": "全身調子が悪くなったんだ。"}, {"type": "subtitle", "time": 14709.429, "timestamp": "04:05:09", "text": "そして私は仕事に遅刻した。   午前"}, {"type": "subtitle", "time": 14712.469, "timestamp": "04:05:12", "text": "10時に目が覚めて、ああ、やばいと気づいた"}, {"type": "subtitle", "time": 14715.389, "timestamp": "04:05:15", "text": "。"}, {"type": "subtitle", "time": 14716.63, "timestamp": "04:05:16", "text": "[笑い] でも、"}, {"type": "subtitle", "time": 14718.95, "timestamp": "04:05:18", "text": "そうですね、私は"}, {"type": "subtitle", "time": 14720.87, "timestamp": "04:05:20", "text": "コミュニケーションを取るべきではないと思います。 これはまずい。"}, {"type": "subtitle", "time": 14723.67, "timestamp": "04:05:23", "text": "クビになるかもしれない。 知るか？ ええと、でもうまくいくといいですね"}, {"type": "subtitle", "time": 14726.79, "timestamp": "04:05:26", "text": "。 ベストを尽くしますので、"}, {"type": "subtitle", "time": 14728.63, "timestamp": "04:05:28", "text": "今後の配信にもぜひお越しください。"}, {"type": "subtitle", "time": 14735.59, "timestamp": "04:05:35", "text": "今日の配信も楽しんでいただけたら嬉しいです。 こんにちは、"}, {"type": "subtitle", "time": 14738.95, "timestamp": "04:05:38", "text": "次の配信でアイアンクライのコースをプレイします。そのために"}, {"type": "subtitle", "time": 14743.429, "timestamp": "04:05:43", "text": "割り当てているのですが、それは何曜日か、"}, {"type": "subtitle", "time": 14748.229, "timestamp": "04:05:48", "text": "言う前に、えーと、"}, {"type": "subtitle", "time": 14757.83, "timestamp": "04:05:57", "text": "土曜日に東京に行くので、"}]
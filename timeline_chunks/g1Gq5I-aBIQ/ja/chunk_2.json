arer too i think"}, {"type": "subtitle", "time": 171.50900000000001, "timestamp": "00:02:51", "text": "ああ、神様。 ああ、相棒、相棒、相棒。"}, {"type": "chat", "time": 172.048, "timestamp": "00:02:52", "author": "@Kenn_D_Bush", "avatar": "https://yt4.ggpht.com/_Komo_VEKSz-e7kb-dTpjPDPdwLBWdimZXGs-iY-B0gcs1aY-MXI_lQXH90AN623vf5ag2FRRA=s64-c-k-c0x00ffffff-no-rj", "message": "you forgot yesterday?"}, {"type": "subtitle", "time": 174.07, "timestamp": "00:02:54", "text": "ああ、くそ。 なんてこった。  【音楽】はっきりと聞こえます"}, {"type": "subtitle", "time": 177.03, "timestamp": "00:02:57", "text": "。 えっと、ちょっと待ってください"}]
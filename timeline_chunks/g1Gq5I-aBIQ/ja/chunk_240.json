[{"type": "subtitle", "time": 14401.51, "timestamp": "04:00:01", "text": "6年くらい前の話です。  H 6年"}, {"type": "subtitle", "time": 14405.269, "timestamp": "04:00:05", "text": "前か、2018年か2017"}, {"type": "subtitle", "time": 14407.429, "timestamp": "04:00:07", "text": "年頃だったと思います"}, {"type": "subtitle", "time": 14410.71, "timestamp": "04:00:10", "text": "。 知るか？   ああ"}, {"type": "subtitle", "time": 14413.83, "timestamp": "04:00:13", "text": "、それからアニメが出たんだ。 それは"}, {"type": "subtitle", "time": 14441.349, "timestamp": "04:00:41", "text": "アニメーションとか、クレイジーな"}, {"type": "subtitle", "time": 14446.309, "timestamp": "04:00:46", "text": "人生みたいなことを本当にやってみたいんだけど、でも、"}, {"type": "subtitle", "time": 14448.229, "timestamp": "04:00:48", "text": "音楽にエネルギー"}, {"type": "subtitle", "time": 14452.63, "timestamp": "04:00:52", "text": "と時間を無駄にしたくないんだ。昔はそういう"}, {"type": "subtitle", "time": 14457.03, "timestamp": "04:00:57", "text": "不必要なことをやっていたし、"}, {"type": "subtitle", "time": 14459.91, "timestamp": "04:00:59", "text": "今は時間が限られているから、"}]
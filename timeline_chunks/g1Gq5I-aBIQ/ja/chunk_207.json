[{"type": "subtitle", "time": 12420.07, "timestamp": "03:27:00", "text": "。 それでは、"}, {"type": "subtitle", "time": 12426.309, "timestamp": "03:27:06", "text": "クエストを進めて、"}, {"type": "subtitle", "time": 12429.59, "timestamp": "03:27:09", "text": "今日の締めくくりに少し取り掛かりましょう。 わかった。"}, {"type": "subtitle", "time": 12433.75, "timestamp": "03:27:13", "text": "次回は最善を尽くします。えっと、"}, {"type": "subtitle", "time": 12435.75, "timestamp": "03:27:15", "text": "このゲームはいつ次にプレイできますか？"}, {"type": "subtitle", "time": 12438.87, "timestamp": "03:27:18", "text": "来週の土曜日か日曜日にこのゲームをプレイできると思います"}, {"type": "subtitle", "time": 12445.83, "timestamp": "03:27:25", "text": "良い。"}, {"type": "subtitle", "time": 12448.55, "timestamp": "03:27:28", "text": "では、"}, {"type": "subtitle", "time": 12450.63, "timestamp": "03:27:30", "text": "現在このゲームはいくらで販売されているのですか？"}, {"type": "subtitle", "time": 12455.269, "timestamp": "03:27:35", "text": "えっと、"}, {"type": "subtitle", "time": 12458.15, "timestamp": "03:27:38", "text": "8000円くらいかかりました。"}, {"type": "subtitle", "time": 12459.75, "timestamp": "03:27:39", "text": "それは、えっと、いくらですか"}, {"type": "subtitle", "time": 12462.63, "timestamp": "03:27:42", "text": "？ えっと"}, {"type": "subtitle", "time": 12465.11, "timestamp": "03:27:45", "text": "、いくらですか？  1秒。"}, {"type": "subtitle", "time": 12469.59, "timestamp": "03:27:49", "text": "ブラウザが開けません。 動作が遅くなるでしょう。   なんてこった。   たぶん、"}]
[{"type": "subtitle", "time": 14471.59, "timestamp": "04:01:11", "text": "コントロールできないことじゃなくて、本当に大切なことに時間を使う必要があるんだ"}, {"type": "subtitle", "time": 14475.83, "timestamp": "04:01:15", "text": "。 だから私は「よし、今すぐ"}, {"type": "subtitle", "time": 14479.51, "timestamp": "04:01:19", "text": "何とかしないといけない」と思ったんです"}, {"type": "subtitle", "time": 14488.15, "timestamp": "04:01:28", "text": "はい、どうぞ。"}, {"type": "subtitle", "time": 14502.469, "timestamp": "04:01:42", "text": "コントロールセンターですね。   そうそう"}]
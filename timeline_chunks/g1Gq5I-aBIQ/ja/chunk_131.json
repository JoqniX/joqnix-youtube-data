[{"type": "subtitle", "time": 7862.47, "timestamp": "02:11:02", "text": "ここにいるのか？ 槍を持った男。"}, {"type": "subtitle", "time": 7899.91, "timestamp": "02:11:39", "text": "ああ、斧を手に入れたよ。 さあ行こう。 粗末な鉄製の"}, {"type": "subtitle", "time": 7913.43, "timestamp": "02:11:53", "text": "それに、私の体調は本当に悪いんです。"}, {"type": "subtitle", "time": 7916.229, "timestamp": "02:11:56", "text": "顎。"}, {"type": "subtitle", "time": 7918.79, "timestamp": "02:11:58", "text": "次の安全な"}]
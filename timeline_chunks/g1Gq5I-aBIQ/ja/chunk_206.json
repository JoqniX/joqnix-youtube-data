[{"type": "subtitle", "time": 12363.99, "timestamp": "03:26:03", "text": "すごくお腹が空いたので、今すぐコンビニに行きたいです"}, {"type": "subtitle", "time": 12392.71, "timestamp": "03:26:32", "text": "待って。 ああ、どうやら、まあ、大丈夫みたいですね。 えっと、"}, {"type": "subtitle", "time": 12394.95, "timestamp": "03:26:34", "text": "最初はセブンイレブンに行って"}, {"type": "subtitle", "time": 12399.75, "timestamp": "03:26:39", "text": "、IRLストリームに切り替えて、"}, {"type": "subtitle", "time": 12403.03, "timestamp": "03:26:43", "text": "一緒に食べる食料品を買って、"}, {"type": "subtitle", "time": 12405.99, "timestamp": "03:26:45", "text": "デスクトップストリームに戻ろうと思っていました。 しかし、"}, {"type": "subtitle", "time": 12410.63, "timestamp": "03:26:50", "text": "ルームメイトは"}, {"type": "subtitle", "time": 12412.229, "timestamp": "03:26:52", "text": "家に帰ったようだ。   まだ。"}, {"type": "subtitle", "time": 12416.55, "timestamp": "03:26:56", "text": "彼が来る。 だから、私にはほんの数分しか時間がないんです"}]
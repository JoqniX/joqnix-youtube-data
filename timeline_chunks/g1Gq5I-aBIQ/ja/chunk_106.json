[{"type": "subtitle", "time": 6361.669, "timestamp": "01:46:01", "text": "武器のレベルにおける熟練度は、"}, {"type": "subtitle", "time": 6364.229, "timestamp": "01:46:04", "text": "長期間の使用によって向上します。 各"}, {"type": "subtitle", "time": 6366.629, "timestamp": "01:46:06", "text": "武器種にはそれぞれ熟練度レベルがあり、"}, {"type": "subtitle", "time": 6371.03, "timestamp": "01:46:11", "text": "敵を倒して獲得した武器経験値が"}, {"type": "subtitle", "time": 6372.39, "timestamp": "01:46:12", "text": "一定の閾値に達すると、熟練度レベルが上昇します。 武器の"}, {"type": "subtitle", "time": 6377.669, "timestamp": "01:46:17", "text": "熟練度が上がると、"}, {"type": "subtitle", "time": 6379.83, "timestamp": "01:46:19", "text": "新しい剣やスキルを習得したり、"}, {"type": "subtitle", "time": 6381.91, "timestamp": "01:46:21", "text": "既に持っているスキルをレベルアップさせたりすることができます"}, {"type": "subtitle", "time": 6383.669, "timestamp": "01:46:23", "text": "。 設定は"}, {"type": "subtitle", "time": 6395.83, "timestamp": "01:46:35", "text": "それは提灯です。 わかった。   さあ行こう"}]
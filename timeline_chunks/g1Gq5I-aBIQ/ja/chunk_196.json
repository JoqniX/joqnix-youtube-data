[{"type": "subtitle", "time": 11767.91, "timestamp": "03:16:07", "text": "ゲームの出来はどうですか？ 本当に"}, {"type": "subtitle", "time": 11770.79, "timestamp": "03:16:10", "text": "楽しいです。 私はずっとああいう"}, {"type": "subtitle", "time": 11773.67, "timestamp": "03:16:13", "text": "オンラインゲームをプレイしたかったのですが、"}, {"type": "subtitle", "time": 11776.469, "timestamp": "03:16:16", "text": "ついにプレイできるようになりました。 夜を告げよ。"}, {"type": "subtitle", "time": 11781.67, "timestamp": "03:16:21", "text": "おお。"}]
[{"type": "subtitle", "time": 3389.109, "timestamp": "00:56:29", "text": "ええと、私たちのチームメイトは実は"}, {"type": "subtitle", "time": 3390.789, "timestamp": "00:56:30", "text": "いい人なんです。"}, {"type": "subtitle", "time": 3394.39, "timestamp": "00:56:34", "text": "ちなみに、あなたを疑ってしまってごめんなさい。"}, {"type": "subtitle", "time": 3398.15, "timestamp": "00:56:38", "text": "以前、あなたを疑っていた人がたくさんいた。"}, {"type": "subtitle", "time": 3400.789, "timestamp": "00:56:40", "text": "あなたは本当に良い人ですね。 私たちは"}]
[{"type": "subtitle", "time": 5942.31, "timestamp": "01:39:02", "text": "1"}, {"type": "subtitle", "time": 5945.109, "timestamp": "01:39:05", "text": "時間40分経過しています。"}, {"type": "subtitle", "time": 5946.629, "timestamp": "01:39:06", "text": "もうすぐ40分経とうとしている"}, {"type": "subtitle", "time": 5949.35, "timestamp": "01:39:09", "text": "。"}, {"type": "subtitle", "time": 5952.87, "timestamp": "01:39:12", "text": "ルームメイトが戻ってくるまで、仕事を片付けなければならないかもしれない"}, {"type": "subtitle", "time": 5955.83, "timestamp": "01:39:15", "text": "。"}, {"type": "subtitle", "time": 5958.229, "timestamp": "01:39:18", "text": "授業とか、いろいろ遅れを取り戻さないといけないんだ"}, {"type": "subtitle", "time": 5965.43, "timestamp": "01:39:25", "text": "はい、今日は祝日なので授業はありません。"}, {"type": "subtitle", "time": 5980.229, "timestamp": "01:39:40", "text": "ここでは消耗品を購入したり、"}, {"type": "subtitle", "time": 5982.709, "timestamp": "01:39:42", "text": "不要なアイテムを売却したりできます。 商品は"}, {"type": "subtitle", "time": 5986.39, "timestamp": "01:39:46", "text": "ポーチに入れて保管することも、購入後すぐに保管することもできます。"}, {"type": "subtitle", "time": 5988.629, "timestamp": "01:39:48", "text": "アイテムの呼び出しリストは、"}, {"type": "subtitle", "time": 5991.83, "timestamp": "01:39:51", "text": "カーディナルランクのリザーブが上がるにつれて増加し、"}, {"type": "subtitle", "time": 5995.669, "timestamp": "01:39:55", "text": "消耗品アイテムを増やすことができます。"}]
[{"type": "subtitle", "time": 4020.549, "timestamp": "01:07:00", "text": "。"}, {"type": "subtitle", "time": 4023.75, "timestamp": "01:07:03", "text": "鉄や薬草など、いろいろなものを集めるような作業はできますか"}, {"type": "subtitle", "time": 4025.829, "timestamp": "01:07:05", "text": "？"}, {"type": "subtitle", "time": 4031.75, "timestamp": "01:07:11", "text": "モンスターの素材を集めたりして、"}, {"type": "subtitle", "time": 4035.029, "timestamp": "01:07:15", "text": "防具をアップグレードしたり、その他諸々のことをやらなきゃいけないような気がする"}]
[{"type": "subtitle", "time": 7702.069, "timestamp": "02:08:22", "text": "おい、奴らは宝箱をどこに隠しておくべきか知ってるんだよ。"}, {"type": "subtitle", "time": 7704.629, "timestamp": "02:08:24", "text": "「ああ、プレイヤーはそこから出られないし、そこにも行けない"}, {"type": "subtitle", "time": 7708.87, "timestamp": "02:08:28", "text": "。"}, {"type": "subtitle", "time": 7713.669, "timestamp": "02:08:33", "text": "ハチミツは渡さない。俺の"}, {"type": "subtitle", "time": 7723.99, "timestamp": "02:08:43", "text": "別の方法があるはずだよね？"}]
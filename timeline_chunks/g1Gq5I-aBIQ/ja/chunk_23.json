[{"type": "subtitle", "time": 1380.549, "timestamp": "00:23:00", "text": "何か？"}, {"type": "subtitle", "time": 1382.549, "timestamp": "00:23:02", "text": "そしてあちら側。 そこには何もない。 今、"}, {"type": "subtitle", "time": 1387.19, "timestamp": "00:23:07", "text": "コントローラーを握っているような感覚を覚える。"}, {"type": "subtitle", "time": 1416.95, "timestamp": "00:23:36", "text": "、ポールアームを見ることができるでしょう。"}]
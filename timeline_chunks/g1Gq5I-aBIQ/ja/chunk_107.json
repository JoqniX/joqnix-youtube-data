[{"type": "subtitle", "time": 6450.55, "timestamp": "01:47:30", "text": "青い光の柱。"}, {"type": "subtitle", "time": 6461.189, "timestamp": "01:47:41", "text": "待って、もし彼がわざわざ"}, {"type": "subtitle", "time": 6464.07, "timestamp": "01:47:44", "text": "私のためにモンスターと戦ってくれたら、"}, {"type": "subtitle", "time": 6478.95, "timestamp": "01:47:58", "text": "ああ、お金のために彼を殴る必要はないよ"}]
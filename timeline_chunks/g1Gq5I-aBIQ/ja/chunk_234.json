[{"type": "subtitle", "time": 14042.07, "timestamp": "03:54:02", "text": "あなたはあなたから卒業しました。 あなたは"}, {"type": "subtitle", "time": 14044.469, "timestamp": "03:54:04", "text": "黒田さんに一度別れを告げたと言いましたね。"}, {"type": "subtitle", "time": 14049.59, "timestamp": "03:54:09", "text": "部屋に何かを残していったようだ。   ああ"}, {"type": "subtitle", "time": 14053.189, "timestamp": "03:54:13", "text": "、彼は私を置いて行ってしまった。"}, {"type": "subtitle", "time": 14056.07, "timestamp": "03:54:16", "text": "おお。"}, {"type": "subtitle", "time": 14058.469, "timestamp": "03:54:18", "text": "でも、あれは良い"}, {"type": "subtitle", "time": 14061.03, "timestamp": "03:54:21", "text": "小道具だった。 ああ、でもペットはね。 わかった。"}, {"type": "subtitle", "time": 14063.59, "timestamp": "03:54:23", "text": "ご覧のとおり、こんな感じです。 そうすれば、"}, {"type": "subtitle", "time": 14070.07, "timestamp": "03:54:30", "text": "タイマーのようなものが使えるようになります。 えっと、それはどこにあると思いますか"}, {"type": "subtitle", "time": 14072.55, "timestamp": "03:54:32", "text": "？ 何てことだ。"}, {"type": "subtitle", "time": 14080.229, "timestamp": "03:54:40", "text": "、いつものことさ。 だから、ルーティンを組むことができる。"}, {"type": "subtitle", "time": 14083.269, "timestamp": "03:54:43", "text": "タイマーを設定できます。 どれくらいの時間が必要か、"}, {"type": "subtitle", "time": 14085.11, "timestamp": "03:54:45", "text": "集中するのにどれくらいの時間が必要か、休憩にどれくらいの"}, {"type": "subtitle", "time": 14087.67, "timestamp": "03:54:47", "text": "時間が必要か、どれくらいの"}, {"type": "subtitle", "time": 14089.83, "timestamp": "03:54:49", "text": "時間が長い休憩になるか、"}, {"type": "subtitle", "time": 14092.71, "timestamp": "03:54:52", "text": "など。 だから、私たちはこういうことを"}, {"type": "subtitle", "time": 14096.15, "timestamp": "03:54:56", "text": "一緒にやっていきたいと思っています。"}, {"type": "subtitle", "time": 14099.83, "timestamp": "03:54:59", "text": "ええと、これが、これから配信するストリームに関する私のアイデアです"}]
[{"type": "subtitle", "time": 11906.229, "timestamp": "03:18:26", "text": "ありがとう。 仲間たち。"}, {"type": "subtitle", "time": 11908.55, "timestamp": "03:18:28", "text": "良い配信を。 こんにちは。"}, {"type": "subtitle", "time": 11914.55, "timestamp": "03:18:34", "text": "お腹が空いたから、買い物に出かける予定だったんだ。"}, {"type": "subtitle", "time": 11939.349, "timestamp": "03:18:59", "text": "よし、ボタンで何ができるか見てみよう"}]
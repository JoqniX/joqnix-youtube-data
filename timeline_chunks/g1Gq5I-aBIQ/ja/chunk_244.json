[{"type": "subtitle", "time": 14640.63, "timestamp": "04:04:00", "text": "須田さん、来てくれてありがとう。 サヤン、"}, {"type": "subtitle", "time": 14642.71, "timestamp": "04:04:02", "text": "来てくれてありがとう。"}, {"type": "subtitle", "time": 14645.67, "timestamp": "04:04:05", "text": "そして、"}, {"type": "subtitle", "time": 14648.71, "timestamp": "04:04:08", "text": "バカな父親。 お越しいただきありがとうございます。   えっと、"}, {"type": "subtitle", "time": 14654.15, "timestamp": "04:04:14", "text": "ケンザ、私は（音楽）だと思う。 うん。"}, {"type": "subtitle", "time": 14657.269, "timestamp": "04:04:17", "text": "ああ、チャット中にキーボードが壊れそうだ"}, {"type": "subtitle", "time": 14659.99, "timestamp": "04:04:19", "text": "。 残りの一日を"}, {"type": "subtitle", "time": 14662.71, "timestamp": "04:04:22", "text": "そちらで良い一日をお過ごしください。 こんにちは。 ありがとう。"}, {"type": "subtitle", "time": 14665.429, "timestamp": "04:04:25", "text": "うん。 うん。  7時になるよ。7時"}, {"type": "subtitle", "time": 14667.83, "timestamp": "04:04:27", "text": "40分になるよね？ えっと、"}, {"type": "subtitle", "time": 14672.469, "timestamp": "04:04:32", "text": "顔を洗ったりして、"}, {"type": "subtitle", "time": 14676.309, "timestamp": "04:04:36", "text": "何か食べて、"}, {"type": "subtitle", "time": 14682.389, "timestamp": "04:04:42", "text": "勉強して、午前1時前には早く寝ます。"}, {"type": "subtitle", "time": 14689.59, "timestamp": "04:04:49", "text": "明日は仕事と学校があります。 そう、実は"}, {"type": "subtitle", "time": 14693.349, "timestamp": "04:04:53", "text": "今日、仕事を休んだんです"}, {"type": "subtitle", "time": 14696.71, "timestamp": "04:04:56", "text": "。休んではいけないのに。 私は電話をかけ、試み、そして眠ってしまいました。"}]
[{"type": "subtitle", "time": 14103.51, "timestamp": "03:55:03", "text": "。"}, {"type": "subtitle", "time": 14105.83, "timestamp": "03:55:05", "text": "えっと、月曜日から"}, {"type": "subtitle", "time": 14107.51, "timestamp": "03:55:07", "text": "金曜日まで勤務しなければならないんです。 うん、月曜日はダメだね。 今日は"}, {"type": "subtitle", "time": 14111.429, "timestamp": "03:55:11", "text": "月曜日、火曜日から金曜日まで。 私は、"}, {"type": "subtitle", "time": 14113.91, "timestamp": "03:55:13", "text": "勉強配信をしたり、自分の好きなことを追いかけたりしたかったんです"}, {"type": "subtitle", "time": 14117.67, "timestamp": "03:55:17", "text": "。"}, {"type": "subtitle", "time": 14125.99, "timestamp": "03:55:25", "text": "日本語ではないので、日本語の勉強みたいなことをしたかったですね。 私は、えーと、"}, {"type": "subtitle", "time": 14129.83, "timestamp": "03:55:29", "text": "副業みたいなものを勉強しています。 だから、"}, {"type": "subtitle", "time": 14134.79, "timestamp": "03:55:34", "text": "配信中に皆さんと一緒に音楽を勉強したり、"}, {"type": "subtitle", "time": 14137.59, "timestamp": "03:55:37", "text": "一緒に作業したりするために時間を使いたいと思ったんです。"}, {"type": "subtitle", "time": 14141.67, "timestamp": "03:55:41", "text": "もしその"}, {"type": "subtitle", "time": 14143.51, "timestamp": "03:55:43", "text": "時間に都合がよければ、気軽に来て一緒に作業したり勉強したりできますし、"}, {"type": "subtitle", "time": 14149.11, "timestamp": "03:55:49", "text": "休憩時間にはいつでも"}, {"type": "subtitle", "time": 14152.95, "timestamp": "03:55:52", "text": "皆さんと話したりできます。 それが"}, {"type": "subtitle", "time": 14157.03, "timestamp": "03:55:57", "text": "月曜日、いや火曜日の配信のアイデアです。   わかった"}]
[{"type": "subtitle", "time": 12540.87, "timestamp": "03:29:00", "text": "ルームメイトが私の部屋にいない時だけ、寮やアパートで自由に話せる時間があるんです。ルームメイトがいる時は、"}, {"type": "subtitle", "time": 12549.03, "timestamp": "03:29:09", "text": "音声に気を遣わないといけないし、"}, {"type": "subtitle", "time": 12557.51, "timestamp": "03:29:17", "text": "マイクを通して彼の声が聞こえるかどうかとか、そういうことが色々あって、"}, {"type": "subtitle", "time": 12559.91, "timestamp": "03:29:19", "text": "すごく面倒なんです。 あなたの"}, {"type": "subtitle", "time": 12567.91, "timestamp": "03:29:27", "text": "私が優れたノイズ抑制を持っていることです。"}, {"type": "subtitle", "time": 12570.309, "timestamp": "03:29:30", "text": "ただ、"}, {"type": "subtitle", "time": 12573.429, "timestamp": "03:29:33", "text": "AI"}, {"type": "subtitle", "time": 12576.229, "timestamp": "03:29:36", "text": "ベースの優れた購読者抑制機能か"}, {"type": "subtitle", "time": 12579.75, "timestamp": "03:29:39", "text": "何かが必要だと思うんです。私、Jocknixが話している時だけ音声を発信し、誰が誰を"}, {"type": "subtitle", "time": 12590.15, "timestamp": "03:29:50", "text": "話しているのかを検出して理解できるような機能です。 あ、"}, {"type": "subtitle", "time": 12593.269, "timestamp": "03:29:53", "text": "待って。 死ぬ。   そんな感じですね"}]
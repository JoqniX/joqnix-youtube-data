[{"type": "subtitle", "time": 2118.31, "timestamp": "00:35:18", "text": "右のクラッシャーのトン"}, {"type": "subtitle", "time": 2124.15, "timestamp": "00:35:24", "text": "リリースを押してやりました。 はい、わかりました。"}, {"type": "subtitle", "time": 2127.109, "timestamp": "00:35:27", "text": "マーカーを壊してから、青いスラッシュ"}, {"type": "subtitle", "time": 2129.589, "timestamp": "00:35:29", "text": "マークを消してください。 わかった。"}, {"type": "subtitle", "time": 2133.109, "timestamp": "00:35:33", "text": "これがエルデンリングの本質だ。"}, {"type": "subtitle", "time": 2137.589, "timestamp": "00:35:37", "text": "ああ、なんてことだ、エレン・リングだ。"}, {"type": "subtitle", "time": 2147.03, "timestamp": "00:35:47", "text": "とメカニズムは、ある意味で"}]
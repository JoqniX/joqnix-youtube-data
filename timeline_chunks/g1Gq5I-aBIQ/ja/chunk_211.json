[{"type": "subtitle", "time": 12663.51, "timestamp": "03:31:03", "text": "メーターと"}, {"type": "subtitle", "time": 12666.07, "timestamp": "03:31:06", "text": "ボイスメーター、そして"}, {"type": "subtitle", "time": 12669.349, "timestamp": "03:31:09", "text": "スーパーオン波長を使用しています。 いや、いや、いや。 何？"}, {"type": "subtitle", "time": 12673.03, "timestamp": "03:31:13", "text": "波打つわけでもなく、スーパーウェーブでもない。 私は何を"}, {"type": "subtitle", "time": 12675.67, "timestamp": "03:31:15", "text": "言っているんだ？   いい天気ではあるん"}, {"type": "subtitle", "time": 12680.229, "timestamp": "03:31:20", "text": "だけど、"}, {"type": "subtitle", "time": 12684.309, "timestamp": "03:31:24", "text": "時々雨が多すぎるんだよね。   あと、"}, {"type": "subtitle", "time": 12687.91, "timestamp": "03:31:27", "text": "安全地帯はここです。 やっと"}, {"type": "subtitle", "time": 12690.469, "timestamp": "03:31:30", "text": "保存してまとめられる。   わーい"}, {"type": "subtitle", "time": 12698.79, "timestamp": "03:31:38", "text": "。 えっと、テレポートはしません。"}, {"type": "subtitle", "time": 12700.63, "timestamp": "03:31:40", "text": "少なくとも、圧力鍋とミキサーの音は止まった"}, {"type": "subtitle", "time": 12703.67, "timestamp": "03:31:43", "text": "。 うん。 うん。 うん。"}, {"type": "subtitle", "time": 12705.269, "timestamp": "03:31:45", "text": "私の場合、インドにいた頃、"}, {"type": "subtitle", "time": 12708.15, "timestamp": "03:31:48", "text": "家の外で工事をしていた時に、"}, {"type": "subtitle", "time": 12711.51, "timestamp": "03:31:51", "text": "Super Clear が、あの"}, {"type": "subtitle", "time": 12713.83, "timestamp": "03:31:53", "text": "物を取り除いてくれて、とても"}, {"type": "subtitle", "time": 12716.79, "timestamp": "03:31:56", "text": "良かったんです。 抑制効果が素晴らしかったので、とても満足しました"}, {"type": "subtitle", "time": 12718.95, "timestamp": "03:31:58", "text": "。"}]
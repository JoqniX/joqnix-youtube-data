[{"type": "subtitle", "time": 8404.71, "timestamp": "02:20:04", "text": "起き上がってもいいですか？お願いです。 ただ"}, {"type": "subtitle", "time": 8432.23, "timestamp": "02:20:32", "text": "古代の召喚塔。"}, {"type": "subtitle", "time": 8434.309, "timestamp": "02:20:34", "text": "よし、戦おう。"}, {"type": "subtitle", "time": 8445.429, "timestamp": "02:20:45", "text": "それはオーク材です。"}, {"type": "subtitle", "time": 8447.83, "timestamp": "02:20:47", "text": "ああ、気にしないで。 それは巨大な翼を持つ"}]
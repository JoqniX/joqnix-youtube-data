[{"type": "subtitle", "time": 12250.469, "timestamp": "03:24:10", "text": "FXAですよね？   それでいいと思います"}, {"type": "subtitle", "time": 12278.15, "timestamp": "03:24:38", "text": "私は今、すべてのタブを明らかにできないのか"}, {"type": "subtitle", "time": 12281.349, "timestamp": "03:24:41", "text": "。 明らかに苦戦している。"}, {"type": "subtitle", "time": 12287.349, "timestamp": "03:24:47", "text": "えっと、それは私が16GBのRAMを搭載しているからでしょうか？"}, {"type": "subtitle", "time": 12290.229, "timestamp": "03:24:50", "text": "ああ、"}, {"type": "subtitle", "time": 12294.15, "timestamp": "03:24:54", "text": "このノートパソコンと一緒に32GBのRAMも買っておけばよかったな。   ああ"}, {"type": "subtitle", "time": 12297.11, "timestamp": "03:24:57", "text": "、RAMの価格が"}, {"type": "subtitle", "time": 12299.91, "timestamp": "03:24:59", "text": "すごく上がってしまって、"}]
[{"type": "subtitle", "time": 13982.309, "timestamp": "03:53:02", "text": "その配色とこの"}, {"type": "subtitle", "time": 13985.67, "timestamp": "03:53:05", "text": "ゲーム内の音楽すべてを使って新しいジョックを作りました。   ちょっと"}, {"type": "subtitle", "time": 13988.309, "timestamp": "03:53:08", "text": "待って、少しだけ見てみたい"}, {"type": "subtitle", "time": 13991.189, "timestamp": "03:53:11", "text": "？ 少しの間なら開けてもいいと思う"}, {"type": "subtitle", "time": 13994.469, "timestamp": "03:53:14", "text": "。 何だって？そんなに"}, {"type": "subtitle", "time": 13997.59, "timestamp": "03:53:17", "text": "重くないよ。 だから、少しの間だけ開けておける"}, {"type": "subtitle", "time": 14000.63, "timestamp": "03:53:20", "text": "。 うん。 うん。"}, {"type": "subtitle", "time": 14003.67, "timestamp": "03:53:23", "text": "うん。 えーと、このアプリを使うと、"}, {"type": "subtitle", "time": 14008.469, "timestamp": "03:53:28", "text": "80% 連続、20%"}, {"type": "subtitle", "time": 14011.189, "timestamp": "03:53:31", "text": "10% 休憩などのタイマーを設定できるんです [笑い]"}, {"type": "subtitle", "time": 14015.83, "timestamp": "03:53:35", "text": "本当にすごくいい、いいものですね。"}, {"type": "subtitle", "time": 14019.269, "timestamp": "03:53:39", "text": "これは、えっと、1秒です。 ああ、そうだね"}, {"type": "subtitle", "time": 14021.51, "timestamp": "03:53:41", "text": "。 ゲーム"}, {"type": "subtitle", "time": 14032.79, "timestamp": "03:53:52", "text": "ああ、この人、近いね。 それは私です。 えっと、"}]
[{"type": "subtitle", "time": 5045.75, "timestamp": "01:24:05", "text": "美しさ。 うん、彼はじっとしていられないんだと"}, {"type": "subtitle", "time": 5047.91, "timestamp": "01:24:07", "text": "思う。"}, {"type": "subtitle", "time": 5051.669, "timestamp": "01:24:11", "text": "ええ、彼はじっとしていません。"}, {"type": "subtitle", "time": 5083.03, "timestamp": "01:24:43", "text": "パンザー。 この青銅のレイピア、鋼鉄のナイフ、"}, {"type": "subtitle", "time": 5087.11, "timestamp": "01:24:47", "text": "青銅の棒、大剣、"}, {"type": "subtitle", "time": 5095.03, "timestamp": "01:24:55", "text": "鋼鉄の斧、棒、鋼鉄のナイフ、より"}]
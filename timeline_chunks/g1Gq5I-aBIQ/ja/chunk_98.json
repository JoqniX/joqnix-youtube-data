[{"type": "subtitle", "time": 5908.79, "timestamp": "01:38:28", "text": "六。 あ、気にしないでください。   どうでも。   どうでも。"}, {"type": "subtitle", "time": 5916.39, "timestamp": "01:38:36", "text": "アイテムこそが文字通りゲームの全てだ"}, {"type": "subtitle", "time": 5918.39, "timestamp": "01:38:38", "text": "。   この"}, {"type": "subtitle", "time": 5921.35, "timestamp": "01:38:41", "text": "服は手元に置いておいてもいいと思う。 そして、とりあえず今は"}, {"type": "subtitle", "time": 5924.149, "timestamp": "01:38:44", "text": "青銅の剣を買ったところです"}, {"type": "subtitle", "time": 5939.75, "timestamp": "01:38:59", "text": "あなたは長い間配信を続けていますね。 えーっと、今のところ"}]
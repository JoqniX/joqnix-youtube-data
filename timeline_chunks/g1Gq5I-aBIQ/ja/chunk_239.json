[{"type": "subtitle", "time": 14340.95, "timestamp": "03:59:00", "text": "少し見てみましたが、とても"}, {"type": "subtitle", "time": 14345.11, "timestamp": "03:59:05", "text": "良かったです。  「よし、私はSEAOのファンだ。SAOの"}, {"type": "subtitle", "time": 14350.79, "timestamp": "03:59:10", "text": "ライトノベルとか読んでるから、"}, {"type": "subtitle", "time": 14355.59, "timestamp": "03:59:15", "text": "プレイしたい」って思ったんです。"}, {"type": "subtitle", "time": 14358.79, "timestamp": "03:59:18", "text": "正直に言うと、アリシ"}, {"type": "subtitle", "time": 14361.11, "timestamp": "03:59:21", "text": "ゼーションが"}, {"type": "subtitle", "time": 14363.75, "timestamp": "03:59:23", "text": "発売された時か、"}, {"type": "subtitle", "time": 14367.11, "timestamp": "03:59:27", "text": "数年後に、オンラインでソーダットを買いたかったんです。 ええ、"}, {"type": "subtitle", "time": 14369.429, "timestamp": "03:59:29", "text": "アリシズ・アリシゼーションのライトノベルは読みましたよ"}, {"type": "subtitle", "time": 14371.429, "timestamp": "03:59:31", "text": "。   もう"}, {"type": "subtitle", "time": 14374.63, "timestamp": "03:59:34", "text": "一つはどこだったか忘れちゃった"}, {"type": "subtitle", "time": 14377.67, "timestamp": "03:59:37", "text": "。 だから私はライトノベルの第1章、第1シーズンの第1巻"}, {"type": "subtitle", "time": 14380.79, "timestamp": "03:59:40", "text": "から"}, {"type": "subtitle", "time": 14387.429, "timestamp": "03:59:47", "text": "アニメ版まで読まなければなりませんでした。 ああ、なんてことだ、"}, {"type": "subtitle", "time": 14390.55, "timestamp": "03:59:50", "text": "10冊以上の人生小説を読み終えなければならなかった"}, {"type": "subtitle", "time": 14395.349, "timestamp": "03:59:55", "text": "。 悪い。 これは、"}]
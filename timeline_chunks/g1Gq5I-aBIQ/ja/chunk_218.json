[{"type": "subtitle", "time": 13081.91, "timestamp": "03:38:01", "text": "ああ、もう夜だ。 待って、"}, {"type": "subtitle", "time": 13085.349, "timestamp": "03:38:05", "text": "太陽は沈んだの？ いいえ。ああ、そうですね。 できると思う。"}, {"type": "subtitle", "time": 13089.91, "timestamp": "03:38:09", "text": "大丈夫。"}, {"type": "subtitle", "time": 13093.75, "timestamp": "03:38:13", "text": "ええ、夜ですね。  7です。13です。では"}, {"type": "subtitle", "time": 13095.59, "timestamp": "03:38:15", "text": "、ここで終わりにしましょう。  3"}, {"type": "subtitle", "time": 13097.75, "timestamp": "03:38:17", "text": "時間33分です。 これで終わりにします。"}, {"type": "subtitle", "time": 13101.03, "timestamp": "03:38:21", "text": "よし、とりあえず、"}, {"type": "subtitle", "time": 13103.19, "timestamp": "03:38:23", "text": "次回このゲームを配信するときは、前回中断したところ"}, {"type": "subtitle", "time": 13105.75, "timestamp": "03:38:25", "text": "から再開するようにするよ"}, {"type": "subtitle", "time": 13108.229, "timestamp": "03:38:28", "text": "。"}, {"type": "subtitle", "time": 13111.59, "timestamp": "03:38:31", "text": "つまり、2番目の"}, {"type": "subtitle", "time": 13113.83, "timestamp": "03:38:33", "text": "テレポートポイントまでプレイして"}, {"type": "subtitle", "time": 13116.87, "timestamp": "03:38:36", "text": "、[音楽] ええ、そこから"}, {"type": "subtitle", "time": 13118.95, "timestamp": "03:38:38", "text": "ストリームを開始します。"}, {"type": "subtitle", "time": 13121.59, "timestamp": "03:38:41", "text": "ああ、ちょっと配信外でプレイしないといけないな"}, {"type": "subtitle", "time": 13124.469, "timestamp": "03:38:44", "text": "。 そうそう。 でも、うん、今日は"}, {"type": "subtitle", "time": 13127.429, "timestamp": "03:38:47", "text": "楽しかったよ。"}, {"type": "subtitle", "time": 13130.71, "timestamp": "03:38:50", "text": "Echos of Fine Cryをプレイするのは本当に楽しかったです。"}, {"type": "subtitle", "time": 13134.79, "timestamp": "03:38:54", "text": "とても楽しかったです。 つまり、"}, {"type": "subtitle", "time": 13138.63, "timestamp": "03:38:58", "text": "今日来てくれた人は誰ですか？これは私の最初の配信、"}]
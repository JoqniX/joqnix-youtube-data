[{"type": "subtitle", "time": 8912.63, "timestamp": "02:28:32", "text": "鋼鉄の剣。 ああ、それだけの"}, {"type": "subtitle", "time": 8915.11, "timestamp": "02:28:35", "text": "価値はあったよ。 ミナ、ここまで来た"}, {"type": "subtitle", "time": 8917.51, "timestamp": "02:28:37", "text": "甲斐があったよ。 では、"}, {"type": "subtitle", "time": 8919.67, "timestamp": "02:28:39", "text": "テレポートしましょう。"}, {"type": "subtitle", "time": 8927.67, "timestamp": "02:28:47", "text": "奥様、"}, {"type": "subtitle", "time": 8930.55, "timestamp": "02:28:50", "text": "私たちはそこまでずっと歩いて行きます。"}, {"type": "subtitle", "time": 8934.23, "timestamp": "02:28:54", "text": "私たちはその前に行かなければならない。   そこで"}, {"type": "subtitle", "time": 8936.71, "timestamp": "02:28:56", "text": "私たちは休息をとった"}]
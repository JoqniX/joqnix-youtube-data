[{"type": "subtitle", "time": 2523.43, "timestamp": "00:42:03", "text": "何だって？ 私は「待って、彼は"}, {"type": "subtitle", "time": 2526.63, "timestamp": "00:42:06", "text": "私たちを殺すつもりなの？」と思いました。 何か。"}, {"type": "subtitle", "time": 2539.349, "timestamp": "00:42:19", "text": "彼が私を裏切るんじゃないかとか、そういうことを考えてしまうんだろう"}, {"type": "subtitle", "time": 2541.349, "timestamp": "00:42:21", "text": "？   私が"}, {"type": "subtitle", "time": 2546.95, "timestamp": "00:42:26", "text": "自分の"}, {"type": "subtitle", "time": 2574.79, "timestamp": "00:42:54", "text": "ああ、わかりました。 わかった。 あなたは「"}, {"type": "subtitle", "time": 2576.71, "timestamp": "00:42:56", "text": "オーケー」をプレイします。 わかった。 つまり、最初は"}, {"type": "subtitle", "time": 2578.15, "timestamp": "00:42:58", "text": "デフォルトのキャラクターでプレイして、"}]
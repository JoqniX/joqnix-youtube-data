[{"type": "subtitle", "time": 7561.189, "timestamp": "02:06:01", "text": "レベルアップする。 レベルアップする。"}, {"type": "subtitle", "time": 7564.149, "timestamp": "02:06:04", "text": "笑顔は努力して勝ち取るものだ。 レベルアップ中。"}, {"type": "subtitle", "time": 7566.229, "timestamp": "02:06:06", "text": "町にある宝箱を使ってそれらを割り当て、"}, {"type": "subtitle", "time": 7569.189, "timestamp": "02:06:09", "text": "スキルポイントを増やしましょう。 なるほど、それらは"}, {"type": "subtitle", "time": 7572.31, "timestamp": "02:06:12", "text": "スキルポイント、成長ポイントですね。 ええと、"}, {"type": "subtitle", "time": 7574.55, "timestamp": "02:06:14", "text": "ある程度まではあなたの値に合わせてスケールアップします。"}, {"type": "subtitle", "time": 7576.149, "timestamp": "02:06:16", "text": "それを上げるには、"}, {"type": "subtitle", "time": 7579.27, "timestamp": "02:06:19", "text": "枢機卿ランクを上げる必要があります。"}, {"type": "chat", "time": 7580.28, "timestamp": "02:06:20", "author": "@A_Shalin75_yt", "avatar": "https://yt4.ggpht.com/UB5SEWSIlFT0dZi2oHEHIh9z7buGwmxDBM6kZOpj7KMfa1FeVdaT2agyABK9Mr_KWZbquSjinw=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/jPgfY5j2IIud29sP3ZeA4AgUCkszU2WH9gy1mb0dV-11UJg/jPgfY5j2IIud29sP3ZeA4Ag"}, {"type": "subtitle", "time": 7581.75, "timestamp": "02:06:21", "text": "カードのランクを上げたり、貴重な"}, {"type": "subtitle", "time": 7583.589, "timestamp": "02:06:23", "text": "報酬を提供したりする特定のクエスト。 敵は"}, {"type": "subtitle", "time": 7586.79, "timestamp": "02:06:26", "text": "あなたのレベルに合わせて強化されるわけではありません。 ええと、戻ります。 はい、わかりました。"}, {"type": "subtitle", "time": 7590.069, "timestamp": "02:06:30", "text": "つまり、ゲンジニマ・"}, {"type": "subtitle", "time": 7592.629, "timestamp": "02:06:32", "text": "インパスの冒険依頼と似ているということですね。   それか、"}, {"type": "subtitle", "time": 7596.31, "timestamp": "02:06:36", "text": "あの、冒険ランキングクエストみたいなやつ"}, {"type": "subtitle", "time": 7603.27, "timestamp": "02:06:43", "text": "。   とりあえず、宝"}]
[{"type": "subtitle", "time": 962.87, "timestamp": "00:16:02", "text": "哦，等等。這是一款射擊遊戲，玩家透過"}, {"type": "subtitle", "time": 967.43, "timestamp": "00:16:07", "text": "射擊獲得獎勵。"}, {"type": "subtitle", "time": 970.629, "timestamp": "00:16:10", "text": "我喜歡看到別人這樣做。有人"}, {"type": "subtitle", "time": 973.59, "timestamp": "00:16:13", "text": "想這麼做。"}, {"type": "subtitle", "time": 975.99, "timestamp": "00:16:15", "text": "有人想這麼做。那孩子正在"}, {"type": "subtitle", "time": 1004.55, "timestamp": "00:16:44", "text": "音樂卻不會消失"}, {"type": "subtitle", "time": 1009.59, "timestamp": "00:16:49", "text": "。我一小時後回來。你好。"}, {"type": "subtitle", "time": 1019.829, "timestamp": "00:16:59", "text": "好了，路到盡頭了，"}]
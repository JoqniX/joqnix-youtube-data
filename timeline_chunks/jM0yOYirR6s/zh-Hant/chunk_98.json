[{"type": "subtitle", "time": 5892.87, "timestamp": "01:38:12", "text": "哦，小雕像來了。  哦，對了，有人看到戴著面具的孩子們發現了可可。"}, {"type": "subtitle", "time": 5930.55, "timestamp": "01:38:50", "text": "我不知道。"}, {"type": "subtitle", "time": 5933.75, "timestamp": "01:38:53", "text": "我那樣做太失禮了。  我和某人肩並肩。  我必須小心。  手。  是我"}]
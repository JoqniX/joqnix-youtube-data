[{"type": "subtitle", "time": 120.389, "timestamp": "00:02:00", "text": "參加祭典。這是"}, {"type": "subtitle", "time": 125.03, "timestamp": "00:02:05", "text": "塔納瓦塔節，也就是"}, {"type": "subtitle", "time": 128.15, "timestamp": "00:02:08", "text": "星願節。"}, {"type": "subtitle", "time": 130.22899999999998, "timestamp": "00:02:10", "text": "這裡正在舉辦當地的節慶活動。所以"}, {"type": "subtitle", "time": 133.83, "timestamp": "00:02:13", "text": "我來這裡就是為了做這件事。呃，稍等一下。"}, {"type": "subtitle", "time": 136.309, "timestamp": "00:02:16", "text": "聊天記錄"}, {"type": "subtitle", "time": 144.55, "timestamp": "00:02:24", "text": "，等等。我得修復線上聊天功能。"}, {"type": "subtitle", "time": 147.82999999999998, "timestamp": "00:02:27", "text": "哦。我的天哪。哦。  哦"}, {"type": "subtitle", "time": 151.589, "timestamp": "00:02:31", "text": "，等等。呃，等等，等等，等等，等等。我……我……"}, {"type": "subtitle", "time": 155.43, "timestamp": "00:02:35", "text": "我找不到Viso的聊天控制"}, {"type": "subtitle", "time": 160.07, "timestamp": "00:02:40", "text": "。我的天哪，沒了。"}, {"type": "subtitle", "time": 162.15, "timestamp": "00:02:42", "text": "好的，記下來。好的。你好。我"}, {"type": "subtitle", "time": 164.47, "timestamp": "00:02:44", "text": "要切換攝影機了，讓我們"}, {"type": "subtitle", "time": 168.39, "timestamp": "00:02:48", "text": "開始吧。好的。三、二、一。"}, {"type": "subtitle", "time": 172.63, "timestamp": "00:02:52", "text": "你好。你可以看到真實的日本。 D. 我"}, {"type": "subtitle", "time": 176.949, "timestamp": "00:02:56", "text": "看起來像個真正的影片部落客嗎？嗨。"}, {"type": "subtitle", "time": 179.91, "timestamp": "00:02:59", "text": "這就是祭典。"}]
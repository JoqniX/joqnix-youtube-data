[{"type": "subtitle", "time": 3936.549, "timestamp": "01:05:36", "text": "棋盤遊戲。每張票50元。  走吧。  等等，這是集會嗎"}, {"type": "subtitle", "time": 3938.87, "timestamp": "01:05:38", "text": "？"}, {"type": "subtitle", "time": 3941.51, "timestamp": "01:05:41", "text": "我不知道哪裡買集郵冊。"}, {"type": "subtitle", "time": 3947.99, "timestamp": "01:05:47", "text": "我"}, {"type": "subtitle", "time": 3950.95, "timestamp": "01:05:50", "text": "想參加集郵活動。  夠好了。  每個人都在裝飾自己的物品。"}]
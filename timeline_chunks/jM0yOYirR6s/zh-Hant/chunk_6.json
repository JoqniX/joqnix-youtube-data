[{"type": "subtitle", "time": 360.469, "timestamp": "00:06:00", "text": "它"}, {"type": "subtitle", "time": 364.15, "timestamp": "00:06:04", "text": "作為工件添加到流中，因為"}, {"type": "subtitle", "time": 373.11, "timestamp": "00:06:13", "text": "我是日本人。我學習英語。嗯，如果"}, {"type": "subtitle", "time": 377.11, "timestamp": "00:06:17", "text": "你想的話。哦，是的。是的。是的。我的"}, {"type": "subtitle", "time": 381.029, "timestamp": "00:06:21", "text": "漢字還是不太好。我的日語還是很差"}, {"type": "subtitle", "time": 389.35, "timestamp": "00:06:29", "text": "瑜珈大師，"}, {"type": "subtitle", "time": 392.07, "timestamp": "00:06:32", "text": "謝謝你。你好。這是你的朋友第一次跟"}, {"type": "subtitle", "time": 398.87, "timestamp": "00:06:38", "text": "呃，你現在必須從Viso更新了。我們"}, {"type": "subtitle", "time": 400.39, "timestamp": "00:06:40", "text": "支持。  哦，謝謝。謝謝。謝謝。  謝謝。"}, {"type": "subtitle", "time": 404.23, "timestamp": "00:06:44", "text": "謝謝。我直接導入就行了"}, {"type": "subtitle", "time": 405.909, "timestamp": "00:06:45", "text": "。"}]
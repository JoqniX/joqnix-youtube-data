[{"type": "subtitle", "time": 1502.549, "timestamp": "00:25:02", "text": "Hello Kitty，呃，那是"}, {"type": "subtitle", "time": 1505.99, "timestamp": "00:25:05", "text": "什麼來著？嗯，很漂亮。我忘了"}, {"type": "subtitle", "time": 1509.11, "timestamp": "00:25:09", "text": "這東西叫什麼了。"}, {"type": "subtitle", "time": 1513.59, "timestamp": "00:25:13", "text": "呃，庫洛米來了。我媽媽的東西。"}, {"type": "subtitle", "time": 1516.149, "timestamp": "00:25:16", "text": "三麗鷗角色都在這裡。這就是墨西哥"}, {"type": "subtitle", "time": 1517.75, "timestamp": "00:25:17", "text": "捲餅。"}, {"type": "subtitle", "time": 1521.99, "timestamp": "00:25:21", "text": "正宗的章魚燒和章魚製品。"}, {"type": "subtitle", "time": 1541.59, "timestamp": "00:25:41", "text": "哦，是的。如果你"}, {"type": "subtitle", "time": 1545.19, "timestamp": "00:25:45", "text": "喜歡小玩具之類的東西，這裡還有更多配件。這個壽司"}]
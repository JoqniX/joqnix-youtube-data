[{"type": "subtitle", "time": 3480.39, "timestamp": "00:58:00", "text": "我觉得那是牛排。 呃，烤牛排"}, {"type": "subtitle", "time": 3498.069, "timestamp": "00:58:18", "text": "还有我们之前遇到的那个卖土豆的人，他还在"}, {"type": "subtitle", "time": 3511.91, "timestamp": "00:58:31", "text": "，"}, {"type": "subtitle", "time": 3516.63, "timestamp": "00:58:36", "text": "这就像《罗密欧与朱丽叶》"}, {"type": "subtitle", "time": 3519.75, "timestamp": "00:58:39", "text": "一样。 就像他们俩"}, {"type": "subtitle", "time": 3524.39, "timestamp": "00:58:44", "text": "十年一次或一年一次地见面一样，"}, {"type": "subtitle", "time": 3527.99, "timestamp": "00:58:47", "text": "7月7日，"}, {"type": "subtitle", "time": 3530.39, "timestamp": "00:58:50", "text": "旅游业"}, {"type": "subtitle", "time": 3533.43, "timestamp": "00:58:53", "text": "和我们正在努力让他们的愿望"}, {"type": "subtitle", "time": 3535.829, "timestamp": "00:58:55", "text": "在那一天实现。 他们会写信什么的"}, {"type": "subtitle", "time": 3538.39, "timestamp": "00:58:58", "text": "。"}]
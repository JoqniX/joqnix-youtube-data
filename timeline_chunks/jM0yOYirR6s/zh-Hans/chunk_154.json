[{"type": "subtitle", "time": 9240.87, "timestamp": "02:34:00", "text": "在节日之类的场合，"}, {"type": "subtitle", "time": 9243.349, "timestamp": "02:34:03", "text": "你必须给现金。 不，"}, {"type": "subtitle", "time": 9246.71, "timestamp": "02:34:06", "text": "没有数字支付，没有在线支付，也没有"}, {"type": "subtitle", "time": 9250.389, "timestamp": "02:34:10", "text": "条形码扫描，没有乐天支付，"}, {"type": "subtitle", "time": 9256.389, "timestamp": "02:34:16", "text": "也没有 Ety 之类的支付方式，什么都没有。"}, {"type": "subtitle", "time": 9260.15, "timestamp": "02:34:20", "text": "嗯，希望你今天过得愉快。 这是"}, {"type": "subtitle", "time": 9262.87, "timestamp": "02:34:22", "text": "我第一次使用"}, {"type": "subtitle", "time": 9264.87, "timestamp": "02:34:24", "text": "全屏摄像头，就像真正的"}, {"type": "subtitle", "time": 9268.23, "timestamp": "02:34:28", "text": "IRL 直播那样，我的"}, {"type": "subtitle", "time": 9270.95, "timestamp": "02:34:30", "text": "角色画面显示在旁边等等。"}, {"type": "subtitle", "time": 9275.429, "timestamp": "02:34:35", "text": "是的，我真的很希望能够"}, {"type": "subtitle", "time": 9279.03, "timestamp": "02:34:39", "text": "和一些日本人聊聊天，你知道，"}, {"type": "subtitle", "time": 9281.27, "timestamp": "02:34:41", "text": "也许可以采访他们什么的，但"}, {"type": "subtitle", "time": 9284.23, "timestamp": "02:34:44", "text": "我不是一个外向的人。 我太害羞了，"}, {"type": "subtitle", "time": 9287.27, "timestamp": "02:34:47", "text": "做不到。 是的"}, {"type": "subtitle", "time": 9288.79, "timestamp": "02:34:48", "text": "，"}, {"type": "subtitle", "time": 9291.349, "timestamp": "02:34:51", "text": "我今天过得很愉快。 希望你也喜欢"}]
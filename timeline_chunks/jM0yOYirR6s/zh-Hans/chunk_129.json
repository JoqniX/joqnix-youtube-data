[{"type": "subtitle", "time": 7749.589, "timestamp": "02:09:09", "text": "等等，到底发生了什么？ 等等，"}, {"type": "subtitle", "time": 7768.39, "timestamp": "02:09:28", "text": "呃，我不想亮出底牌，但"}, {"type": "subtitle", "time": 7775.83, "timestamp": "02:09:35", "text": "钥匙链吧。 我知道头不见了。 它"}, {"type": "subtitle", "time": 7779.27, "timestamp": "02:09:39", "text": "坏了。 我把它送给了别人，结果他把它"}, {"type": "subtitle", "time": 7781.109, "timestamp": "02:09:41", "text": "全弄坏了。 这是"}, {"type": "subtitle", "time": 7784.229, "timestamp": "02:09:44", "text": "柔术凯旋。 呃，我忘了她叫什么名字。"}, {"type": "subtitle", "time": 7787.75, "timestamp": "02:09:47", "text": "她的小玩意儿。 她弄坏了，呃，他弄坏了"}]
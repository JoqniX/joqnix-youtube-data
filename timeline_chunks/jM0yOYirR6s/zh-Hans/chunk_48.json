[{"type": "subtitle", "time": 2880.39, "timestamp": "00:48:00", "text": "我真的可以上去。 这将"}, {"type": "subtitle", "time": 2883.109, "timestamp": "00:48:03", "text": "带你去向何方？"}, {"type": "subtitle", "time": 2885.03, "timestamp": "00:48:05", "text": "哦，等等。 你看，"}, {"type": "subtitle", "time": 2888.23, "timestamp": "00:48:08", "text": "它死了。 这个东西里面会"}, {"type": "subtitle", "time": 2890.87, "timestamp": "00:48:10", "text": "充满水，然后水会流下去"}, {"type": "subtitle", "time": 2894.39, "timestamp": "00:48:14", "text": "。 我的天啊。"}, {"type": "subtitle", "time": 2896.15, "timestamp": "00:48:16", "text": "所以你可以在这里坐下来"}, {"type": "subtitle", "time": 2899.589, "timestamp": "00:48:19", "text": "放松一下，吃点东西。 几乎每个"}, {"type": "subtitle", "time": 2903.03, "timestamp": "00:48:23", "text": "日本人家里都有一台小型"}, {"type": "subtitle", "time": 2905.349, "timestamp": "00:48:25", "text": "便携式风扇。 我刚才注意到了这一点"}, {"type": "subtitle", "time": 2928.63, "timestamp": "00:48:48", "text": "那是辆车吗？ 我刚刚才意识到那是一辆"}, {"type": "subtitle", "time": 2930.15, "timestamp": "00:48:50", "text": "车。"}]
[{"type": "subtitle", "time": 3020.15, "timestamp": "00:50:20", "text": "。 让我走吧。"}, {"type": "subtitle", "time": 3022.95, "timestamp": "00:50:22", "text": "我注意到他们安装的洒水器。 你"}, {"type": "subtitle", "time": 3024.95, "timestamp": "00:50:24", "text": "看到洒水器了吗？"}, {"type": "subtitle", "time": 3028.069, "timestamp": "00:50:28", "text": "他们会给你水。"}, {"type": "subtitle", "time": 3030.549, "timestamp": "00:50:30", "text": "所以他们会给你水。"}, {"type": "subtitle", "time": 3038.71, "timestamp": "00:50:38", "text": "我发现人们在炎热的天气里喜欢被"}, {"type": "subtitle", "time": 3041.349, "timestamp": "00:50:41", "text": "水泼一身"}, {"type": "subtitle", "time": 3051.589, "timestamp": "00:50:51", "text": "我应该弄条加热毛巾，比如"}]
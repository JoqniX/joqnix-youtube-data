[{"type": "subtitle", "time": 5588.149, "timestamp": "01:33:08", "text": "我意识到这里一千日元的"}, {"type": "subtitle", "time": 5592.07, "timestamp": "01:33:12", "text": "东西都很便宜。"}, {"type": "subtitle", "time": 5596.55, "timestamp": "01:33:16", "text": "嗯。 我还是不太习惯现在的"}, {"type": "subtitle", "time": 5598.709, "timestamp": "01:33:18", "text": "货币价格、汇率"}, {"type": "subtitle", "time": 5601.03, "timestamp": "01:33:21", "text": "等等。 我还是觉得一千"}, {"type": "subtitle", "time": 5609.35, "timestamp": "01:33:29", "text": "这个怎么样？"}, {"type": "subtitle", "time": 5626.709, "timestamp": "01:33:46", "text": "，"}, {"type": "subtitle", "time": 5629.669, "timestamp": "01:33:49", "text": "我得找到我的生理周期了。"}]
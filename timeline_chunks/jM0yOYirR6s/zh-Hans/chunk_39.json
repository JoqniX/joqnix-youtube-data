[{"type": "subtitle", "time": 2341.829, "timestamp": "00:39:01", "text": "你以前是不是教英语之类的"}, {"type": "subtitle", "time": 2344.71, "timestamp": "00:39:04", "text": "？ 你到底有没有……"}, {"type": "subtitle", "time": 2347.829, "timestamp": "00:39:07", "text": "呃，其实没有？ 我是一名语言专业的学生。"}, {"type": "subtitle", "time": 2356.15, "timestamp": "00:39:16", "text": "嗯，两到四年后，我就可以决定去哪家"}, {"type": "subtitle", "time": 2366.79, "timestamp": "00:39:26", "text": "哦，等等。 没关系。 这就是"}, {"type": "subtitle", "time": 2368.39, "timestamp": "00:39:28", "text": "结局。"}, {"type": "subtitle", "time": 2371.51, "timestamp": "00:39:31", "text": "这就是结局。 哦好的。 所以，我们反其道而行之"}, {"type": "subtitle", "time": 2376.71, "timestamp": "00:39:36", "text": "。 所以，我们反其道而行之。"}, {"type": "subtitle", "time": 2379.91, "timestamp": "00:39:39", "text": "所以，它跟其他类型的商店差不多。"}, {"type": "subtitle", "time": 2383.03, "timestamp": "00:39:43", "text": "它只是被拉得很长而已。 就像我们"}, {"type": "subtitle", "time": 2386.87, "timestamp": "00:39:46", "text": "看到的，嗯，类似的是一家"}, {"type": "chat", "time": 2388.652, "timestamp": "00:39:48", "author": "@KosmikZethar", "avatar": "https://yt4.ggpht.com/b_m56i87DkQCWoSLK8J6eGPlt0w4dJQYTlT9PaGPCOWZzEZaUiSe6Q-t3xsz9BESFJqhLP1oHg=s64-c-k-c0x00ffffff-no-rj", "message": "Ohh!"}, {"type": "subtitle", "time": 2390.31, "timestamp": "00:39:50", "text": "商店，而这家是一家啤酒商店。 你"}, {"type": "subtitle", "time": 2393.67, "timestamp": "00:39:53", "text": "可以喝杯新鲜的啤酒，还有……呃……东西。"}, {"type": "subtitle", "time": 2398.23, "timestamp": "00:39:58", "text": "土豆玩意儿。 桑德拉角色商店。"}]
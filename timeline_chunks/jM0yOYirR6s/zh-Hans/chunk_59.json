[{"type": "subtitle", "time": 3547.43, "timestamp": "00:59:07", "text": "，那是一个阶段。 我们去"}, {"type": "subtitle", "time": 3549.589, "timestamp": "00:59:09", "text": "舞台区吧。 我还没来过这里，对吧"}, {"type": "subtitle", "time": 3564.15, "timestamp": "00:59:24", "text": "我觉得直播的后半段就像是在向"}, {"type": "subtitle", "time": 3567.27, "timestamp": "00:59:27", "text": "你们展示"}, {"type": "subtitle", "time": 3570.39, "timestamp": "00:59:30", "text": "这里有多拥挤，因为我已经来到这里，"}, {"type": "subtitle", "time": 3573.349, "timestamp": "00:59:33", "text": "然后从这里向左转，"}, {"type": "subtitle", "time": 3575.99, "timestamp": "00:59:35", "text": "最后肯定又从右边回来了"}, {"type": "subtitle", "time": 3578.069, "timestamp": "00:59:38", "text": "。 我们还没有走上正轨"}, {"type": "subtitle", "time": 3579.589, "timestamp": "00:59:39", "text": "。"}, {"type": "subtitle", "time": 3582.47, "timestamp": "00:59:42", "text": "所以这次我们要直接走"}, {"type": "subtitle", "time": 3599.19, "timestamp": "00:59:59", "text": "是啊，那里"}]
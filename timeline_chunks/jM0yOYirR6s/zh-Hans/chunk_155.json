[{"type": "subtitle", "time": 9303.83, "timestamp": "02:35:03", "text": "但我今天过得很开心。 挺好的。"}, {"type": "subtitle", "time": 9305.99, "timestamp": "02:35:05", "text": "下次我会尽量带上我的麦克风，"}, {"type": "subtitle", "time": 9309.83, "timestamp": "02:35:09", "text": "这样我就能用麦克风讲话了，你知道，这样我就可以"}, {"type": "subtitle", "time": 9314.309, "timestamp": "02:35:14", "text": "用我的麦克风了，效果会好得多。 我"}, {"type": "subtitle", "time": 9316.71, "timestamp": "02:35:16", "text": "觉得麦克风会比我手机的"}, {"type": "subtitle", "time": 9319.83, "timestamp": "02:35:19", "text": "扬声器好。 所以"}, {"type": "subtitle", "time": 9322.95, "timestamp": "02:35:22", "text": "，今天真的很有趣。 希望你"}, {"type": "subtitle", "time": 9326.87, "timestamp": "02:35:26", "text": "喜欢。 我将在此告辞。 现在是晚上"}, {"type": "subtitle", "time": 9329.59, "timestamp": "02:35:29", "text": "8点。 我迟到了，肯定要"}, {"type": "subtitle", "time": 9332.63, "timestamp": "02:35:32", "text": "挨骂了。 我原本应该"}, {"type": "subtitle", "time": 9335.91, "timestamp": "02:35:35", "text": "6点到家，结果稍微"}, {"type": "subtitle", "time": 9339.349, "timestamp": "02:35:39", "text": "晚了一点，最后晚了2个小时。   是的"}, {"type": "subtitle", "time": 9341.91, "timestamp": "02:35:41", "text": "。 再见。"}]
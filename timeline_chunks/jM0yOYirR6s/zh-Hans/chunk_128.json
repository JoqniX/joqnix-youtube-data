[{"type": "subtitle", "time": 7680.79, "timestamp": "02:08:00", "text": "解决了。 现在放大。 抱歉，"}, {"type": "subtitle", "time": 7683.03, "timestamp": "02:08:03", "text": "我仍然遇到一些小问题，"}, {"type": "subtitle", "time": 7685.99, "timestamp": "02:08:05", "text": "比如我无法切换到其他应用程序，或者说，"}, {"type": "subtitle", "time": 7688.55, "timestamp": "02:08:08", "text": "我"}, {"type": "subtitle", "time": 7691.51, "timestamp": "02:08:11", "text": "无法切换到其他应用程序。 它"}, {"type": "subtitle", "time": 7695.109, "timestamp": "02:08:15", "text": "稍微中断了传输。"}, {"type": "subtitle", "time": 7708.39, "timestamp": "02:08:28", "text": "你把它锁起来了吗？ 日本，但有些人会"}, {"type": "subtitle", "time": 7711.51, "timestamp": "02:08:31", "text": "抢劫。 是的。 是的，我锁上了。 我已经"}, {"type": "subtitle", "time": 7713.589, "timestamp": "02:08:33", "text": "锁上了。"}, {"type": "subtitle", "time": 7716.709, "timestamp": "02:08:36", "text": "我现在想把裤子露出来，但我"}, {"type": "subtitle", "time": 7719.109, "timestamp": "02:08:39", "text": "不能，我不应该。 我直接公开我的"}, {"type": "subtitle", "time": 7722.629, "timestamp": "02:08:42", "text": "身体信息。 让我来解锁。 是的，我的月经周期到了"}, {"type": "subtitle", "time": 7724.87, "timestamp": "02:08:44", "text": "。 我把它放在了一些"}, {"type": "subtitle", "time": 7727.91, "timestamp": "02:08:47", "text": "公寓的自行车棚里。"}, {"type": "subtitle", "time": 7730.229, "timestamp": "02:08:50", "text": "如果有人看到，我可能会惹上"}]
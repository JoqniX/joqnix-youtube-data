[{"type": "subtitle", "time": 5765.27, "timestamp": "01:36:05", "text": "十分。 でも、ピンクの扇子なら手に入るよ。"}, {"type": "subtitle", "time": 5767.51, "timestamp": "01:36:07", "text": "面白いファンですね。"}, {"type": "subtitle", "time": 5776.149, "timestamp": "01:36:16", "text": "あ、待って。 ぬいぐるみもありますよ。"}, {"type": "subtitle", "time": 5779.27, "timestamp": "01:36:19", "text": "それは、ええと、ラムです。 あれはラムじゃないか？"}, {"type": "subtitle", "time": 5782.229, "timestamp": "01:36:22", "text": "あれはリムだ。"}, {"type": "subtitle", "time": 5783.91, "timestamp": "01:36:23", "text": "それは『"}, {"type": "subtitle", "time": 5790.629, "timestamp": "01:36:30", "text": "シャ・リゼロ』からの引用です。 リゼロ。 リムはそこにある。"}]
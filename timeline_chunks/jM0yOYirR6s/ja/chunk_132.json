[{"type": "subtitle", "time": 7921.669, "timestamp": "02:12:01", "text": "家に帰る様子はご覧いただけます。"}, {"type": "subtitle", "time": 7924.629, "timestamp": "02:12:04", "text": "そして、私は家に帰る道を知っているだろうか？ 分かりません"}, {"type": "subtitle", "time": 7953.109, "timestamp": "02:12:33", "text": "それで、えっと、どうやってここに来たのかって？ 私は生まれながらにしてこの姿だったのだと思う"}, {"type": "subtitle", "time": 7955.51, "timestamp": "02:12:35", "text": "。"}, {"type": "subtitle", "time": 7969.43, "timestamp": "02:12:49", "text": "ああ、なんてことだ。   こういうことをするのは"}, {"type": "subtitle", "time": 7971.35, "timestamp": "02:12:51", "text": "初めてです"}, {"type": "subtitle", "time": 7973.589, "timestamp": "02:12:53", "text": "。"}]
[{"type": "subtitle", "time": 4983.83, "timestamp": "01:23:03", "text": "王子様とお姫様を見せたかったものなんだ。"}, {"type": "subtitle", "time": 4987.11, "timestamp": "01:23:07", "text": "ついに会うことができました。"}, {"type": "subtitle", "time": 5010.229, "timestamp": "01:23:30", "text": "ああ、それはマラシュの公式マスコットです"}, {"type": "subtitle", "time": 5021.27, "timestamp": "01:23:41", "text": "うん。 うん。 これを見てください。 すごく可愛いですよね"}, {"type": "subtitle", "time": 5024.07, "timestamp": "01:23:44", "text": "？ これ、すごく可愛いですよね？ ぬいぐるみ"}, {"type": "subtitle", "time": 5037.669, "timestamp": "01:23:57", "text": "タペストリー。 いいえ、それはただの、それはただの、"}]
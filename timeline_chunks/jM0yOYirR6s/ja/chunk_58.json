[{"type": "subtitle", "time": 3480.39, "timestamp": "00:58:00", "text": "ステーキだと思う。 えっと、焼きステーキ"}, {"type": "subtitle", "time": 3498.069, "timestamp": "00:58:18", "text": "そして、先ほど来たジャガイモの男はまだここにいます"}, {"type": "subtitle", "time": 3511.91, "timestamp": "00:58:31", "text": "そう、"}, {"type": "subtitle", "time": 3516.63, "timestamp": "00:58:36", "text": "ロミオとジュリエットはそれに似ているようなものだ"}, {"type": "subtitle", "time": 3519.75, "timestamp": "00:58:39", "text": "。"}, {"type": "subtitle", "time": 3524.39, "timestamp": "00:58:44", "text": "10年に一度、あるいは年に一度、"}, {"type": "subtitle", "time": 3527.99, "timestamp": "00:58:47", "text": "7月7日に二人が会えるように、"}, {"type": "subtitle", "time": 3530.39, "timestamp": "00:58:50", "text": "観光業を通して、"}, {"type": "subtitle", "time": 3535.829, "timestamp": "00:58:55", "text": "その日に彼らの願いを叶えようとしているのです。 彼らは手紙も書くし、何でもする"}, {"type": "subtitle", "time": 3538.39, "timestamp": "00:58:58", "text": "。   ごめん"}]
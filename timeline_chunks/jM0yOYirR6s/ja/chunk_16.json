[{"type": "subtitle", "time": 962.87, "timestamp": "00:16:02", "text": "あ、待って。 これは銃を"}, {"type": "subtitle", "time": 967.43, "timestamp": "00:16:07", "text": "撃って、賞品を獲得するゲームです。   私は"}, {"type": "subtitle", "time": 970.629, "timestamp": "00:16:10", "text": "誰かがそれをやるのを見るのが好きです。 誰かがそれをやろうとしている"}, {"type": "subtitle", "time": 973.59, "timestamp": "00:16:13", "text": "。"}, {"type": "subtitle", "time": 975.99, "timestamp": "00:16:15", "text": "誰かがそれをやろうとしている。 あの子はそれをやろうとしているんだ"}, {"type": "subtitle", "time": 1009.59, "timestamp": "00:16:49", "text": "。  1時間後に戻ります。 こんにちは。   気をつけて"}, {"type": "subtitle", "time": 1019.829, "timestamp": "00:16:59", "text": "はい、道の突き当たりです。"}]
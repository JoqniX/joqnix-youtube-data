[{"type": "subtitle", "time": 9240.87, "timestamp": "02:34:00", "text": "お祭りとかの時は、現金を渡さないといけないんです"}, {"type": "subtitle", "time": 9243.349, "timestamp": "02:34:03", "text": "。 いいえ、"}, {"type": "subtitle", "time": 9246.71, "timestamp": "02:34:06", "text": "デジタル決済やオンライン決済、"}, {"type": "subtitle", "time": 9250.389, "timestamp": "02:34:10", "text": "バーコードスキャン、楽天ペイ、その他一切の決済方法はありません"}, {"type": "subtitle", "time": 9256.389, "timestamp": "02:34:16", "text": "。"}, {"type": "subtitle", "time": 9260.15, "timestamp": "02:34:20", "text": "ええ、でも今日は楽しんでいただけたでしょうか。"}, {"type": "subtitle", "time": 9262.87, "timestamp": "02:34:22", "text": "カメラ機能を使って、"}, {"type": "subtitle", "time": 9268.23, "timestamp": "02:34:28", "text": "自分の"}, {"type": "subtitle", "time": 9270.95, "timestamp": "02:34:30", "text": "キャラクターを横に表示させたりして、まるで実際のIRLストリーマーみたいにフルスクリーンで配信するのは初めてだった。"}, {"type": "subtitle", "time": 9275.429, "timestamp": "02:34:35", "text": "ええ、本当は"}, {"type": "subtitle", "time": 9279.03, "timestamp": "02:34:39", "text": "日本人の方々と話したり、"}, {"type": "subtitle", "time": 9281.27, "timestamp": "02:34:41", "text": "インタビューしたりできたらいいなと思っていたんですが、"}, {"type": "subtitle", "time": 9284.23, "timestamp": "02:34:44", "text": "私は外向的な性格ではないんです。 私は恥ずかしがり屋なので、それはできません"}, {"type": "subtitle", "time": 9287.27, "timestamp": "02:34:47", "text": "。 うん"}, {"type": "subtitle", "time": 9288.79, "timestamp": "02:34:48", "text": "、"}, {"type": "subtitle", "time": 9291.349, "timestamp": "02:34:51", "text": "今日は楽しかったよ。 あなたも楽しんでいただけたなら幸いです"}]
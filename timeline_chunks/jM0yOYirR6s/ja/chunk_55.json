[{"type": "subtitle", "time": 3300.069, "timestamp": "00:55:00", "text": "ええと、パナヴァタが何かは"}, {"type": "subtitle", "time": 3308.549, "timestamp": "00:55:08", "text": "私の通っていた語学学校では、"}, {"type": "subtitle", "time": 3325.67, "timestamp": "00:55:25", "text": "ものがあるんだよ"}, {"type": "subtitle", "time": 3340.069, "timestamp": "00:55:40", "text": "ええ、ヤコバはフェスティバルに出演しています。"}, {"type": "subtitle", "time": 3349.19, "timestamp": "00:55:49", "text": "見て、あれはカレーだよ。"}]
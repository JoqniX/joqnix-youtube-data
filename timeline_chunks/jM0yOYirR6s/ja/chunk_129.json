[{"type": "subtitle", "time": 7749.589, "timestamp": "02:09:09", "text": "起こったんですか？ 待って、"}, {"type": "subtitle", "time": 7768.39, "timestamp": "02:09:28", "text": "えっと、手の内は明かしたくないのですが、"}, {"type": "subtitle", "time": 7775.83, "timestamp": "02:09:35", "text": "キーホルダーだけお見せしますね。 首がなくなったことは分かっています。"}, {"type": "subtitle", "time": 7779.27, "timestamp": "02:09:39", "text": "壊れています。 人にあげたら、その人に"}, {"type": "subtitle", "time": 7781.109, "timestamp": "02:09:41", "text": "全部壊されちゃった。"}, {"type": "subtitle", "time": 7784.229, "timestamp": "02:09:44", "text": "柔術廻戦でした。 えっと、彼女の名前を忘れちゃった。"}, {"type": "subtitle", "time": 7787.75, "timestamp": "02:09:47", "text": "彼女のあれ。 彼女が壊した、彼が"}]
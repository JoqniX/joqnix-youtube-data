[{"type": "subtitle", "time": 6579.91, "timestamp": "01:49:39", "text": "ええ、私の後ろにいた子供たちが、"}, {"type": "subtitle", "time": 6583.75, "timestamp": "01:49:43", "text": "私が配信していることに気づいてました。 彼らは"}, {"type": "subtitle", "time": 6586.709, "timestamp": "01:49:46", "text": "私と話したがっていた。 彼らは"}, {"type": "subtitle", "time": 6589.27, "timestamp": "01:49:49", "text": "試してみてもわからない。"}, {"type": "subtitle", "time": 6597.91, "timestamp": "01:49:57", "text": "友達を作ろうと努力することもできたはずだ。   私自身も自分の"}]
[{"type": "subtitle", "time": 8468.63, "timestamp": "02:21:08", "text": "意味では、この配信の方が"}, {"type": "subtitle", "time": 8471.349, "timestamp": "02:21:11", "text": "より没入感があったように感じました。   わからない"}, {"type": "subtitle", "time": 8481.11, "timestamp": "02:21:21", "text": "次回はマイクを持って行きます。 ちなみに、"}, {"type": "subtitle", "time": 8484.15, "timestamp": "02:21:24", "text": "私はこのように電話のスピーカーを使うつもりはありません"}, {"type": "subtitle", "time": 8487.11, "timestamp": "02:21:27", "text": "。 だから、私の声ももっと聞き取りやすくなるでしょう"}]
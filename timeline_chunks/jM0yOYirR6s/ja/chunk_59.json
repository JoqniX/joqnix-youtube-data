[{"type": "subtitle", "time": 3547.43, "timestamp": "00:59:07", "text": "ああ、それは一つの段階だ。"}, {"type": "subtitle", "time": 3549.589, "timestamp": "00:59:09", "text": "ステージエリアに行きましょう。 私はまだここに来たことがないんですよね"}, {"type": "subtitle", "time": 3564.15, "timestamp": "00:59:24", "text": "この配信の半分は、私が"}, {"type": "subtitle", "time": 3567.27, "timestamp": "00:59:27", "text": "皆さんにどれだけ"}, {"type": "subtitle", "time": 3570.39, "timestamp": "00:59:30", "text": "混雑しているかを見せているような気がします。なぜなら、私はすでにここまで来て、"}, {"type": "subtitle", "time": 3573.349, "timestamp": "00:59:33", "text": "ここから左に曲がり、そして"}, {"type": "subtitle", "time": 3578.069, "timestamp": "00:59:38", "text": "間違いなく右に戻ってきました。 私たちはまだ正しい道を進んでいない"}, {"type": "subtitle", "time": 3579.589, "timestamp": "00:59:39", "text": "。"}, {"type": "subtitle", "time": 3599.19, "timestamp": "00:59:59", "text": "うん、すごく混雑してるね"}]
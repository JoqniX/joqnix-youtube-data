[{"type": "subtitle", "time": 4740.149, "timestamp": "01:19:00", "text": "星の集まりか"}, {"type": "subtitle", "time": 4741.669, "timestamp": "01:19:01", "text": "何かがある。"}, {"type": "subtitle", "time": 4748.709, "timestamp": "01:19:08", "text": "あ、待って。 星はありますが、あれは"}, {"type": "subtitle", "time": 4750.709, "timestamp": "01:19:10", "text": "イヤリングです。"}, {"type": "subtitle", "time": 4754.07, "timestamp": "01:19:14", "text": "星。 そうそう。 星がある。   わかった"}, {"type": "subtitle", "time": 4784.95, "timestamp": "01:19:44", "text": "、ここが寺院だ。   入っても"}, {"type": "subtitle", "time": 4789.11, "timestamp": "01:19:49", "text": "大丈夫かどうかわかりません"}, {"type": "subtitle", "time": 4798.31, "timestamp": "01:19:58", "text": "わかりました。 ええ、入れますよ。"}]
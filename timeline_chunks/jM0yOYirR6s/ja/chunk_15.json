[{"type": "subtitle", "time": 947.75, "timestamp": "00:15:47", "text": "そして、これがポテトフライです。 フライド"}, {"type": "subtitle", "time": 953.43, "timestamp": "00:15:53", "text": "ポテト。 ああ、それはフライドポテトだ。 全部食べてください。"}, {"type": "subtitle", "time": 956.79, "timestamp": "00:15:56", "text": "そして、このデザインも。"}, {"type": "subtitle", "time": 957.99, "timestamp": "00:15:57", "text": "フライドチキンとか、何でも揃っているよ"}, {"type": "subtitle", "time": 959.99, "timestamp": "00:15:59", "text": "。"}]
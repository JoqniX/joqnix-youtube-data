[{"type": "subtitle", "time": 2400.39, "timestamp": "00:40:00", "text": "そこは"}, {"type": "subtitle", "time": 2402.55, "timestamp": "00:40:02", "text": "ジュース屋さん、"}, {"type": "subtitle", "time": 2406.95, "timestamp": "00:40:06", "text": "焼き肉屋さん、"}, {"type": "subtitle", "time": 2409.67, "timestamp": "00:40:09", "text": "ラム肉屋さんでもあります。 それは、"}, {"type": "subtitle", "time": 2412.23, "timestamp": "00:40:12", "text": "ここで見たものと同じことになるだろう。   同じような"}, {"type": "subtitle", "time": 2414.069, "timestamp": "00:40:14", "text": "店が、"}, {"type": "subtitle", "time": 2435.19, "timestamp": "00:40:35", "text": "ステージ"}, {"type": "subtitle", "time": 2446.87, "timestamp": "00:40:46", "text": "私の携帯電話は充電中です。"}, {"type": "subtitle", "time": 2454.069, "timestamp": "00:40:54", "text": "えっと、私のスマホは"}, {"type": "subtitle", "time": 2459.67, "timestamp": "00:40:59", "text": "充電してからずっと46%くらいで止まってます。"}]
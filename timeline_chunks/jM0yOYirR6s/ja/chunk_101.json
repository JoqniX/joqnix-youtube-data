[{"type": "subtitle", "time": 6071.51, "timestamp": "01:41:11", "text": "手が痛い。 電話を手に持っている。   それは"}, {"type": "subtitle", "time": 6073.91, "timestamp": "01:41:13", "text": "バーだと思う。"}, {"type": "subtitle", "time": 6109.03, "timestamp": "01:41:49", "text": "待って、みんなは私の配信を見てる？"}, {"type": "subtitle", "time": 6112.47, "timestamp": "01:41:52", "text": "それとももう見えなくなってる？"}, {"type": "subtitle", "time": 6114.709, "timestamp": "01:41:54", "text": "問題は、どういうわけかマルチタスクができないことだ。"}]
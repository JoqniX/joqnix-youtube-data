[{"type": "subtitle", "time": 3850.549, "timestamp": "01:04:10", "text": "俺はこの場所が大好きなんだ。"}, {"type": "subtitle", "time": 3852.87, "timestamp": "01:04:12", "text": "東京とかに行くよりはマシだよ。東京は"}, {"type": "subtitle", "time": 3856.069, "timestamp": "01:04:16", "text": "すごく混雑するだろうし。 多すぎる。"}, {"type": "subtitle", "time": 3860.15, "timestamp": "01:04:20", "text": "ボードゲームも置いてありますよ。 チケット1枚50ドル。"}, {"type": "subtitle", "time": 3871.67, "timestamp": "01:04:31", "text": "切手"}, {"type": "subtitle", "time": 3874.39, "timestamp": "01:04:34", "text": "収集会のグッズがどこで手に入るのか分からない。"}, {"type": "subtitle", "time": 3887.27, "timestamp": "01:04:47", "text": "みんなそれぞれ自分の"}]
[{"type": "subtitle", "time": 1502.549, "timestamp": "00:25:02", "text": "えっと、"}, {"type": "subtitle", "time": 1505.99, "timestamp": "00:25:05", "text": "何だっけ？ うーん、きれい。 この物の名前を忘れてしまった"}, {"type": "subtitle", "time": 1509.11, "timestamp": "00:25:09", "text": "。"}, {"type": "subtitle", "time": 1513.59, "timestamp": "00:25:13", "text": "えっと、クロミがここにいます。 私の母に関するもの。"}, {"type": "subtitle", "time": 1516.149, "timestamp": "00:25:16", "text": "サンリオのキャラクターたちがここにいます。 そしてこれが"}, {"type": "subtitle", "time": 1517.75, "timestamp": "00:25:17", "text": "タコスです。   本物の"}, {"type": "subtitle", "time": 1521.99, "timestamp": "00:25:21", "text": "たこ焼きとタコ料理。"}, {"type": "subtitle", "time": 1541.59, "timestamp": "00:25:41", "text": "そうそう。 小さなおもちゃなどが好きなら、もっとアクセサリー類もありますよ"}, {"type": "subtitle", "time": 1545.19, "timestamp": "00:25:45", "text": "。 この寿司の"}, {"type": "subtitle", "time": 1549.19, "timestamp": "00:25:49", "text": "ぬいぐるみ。 そうそう。 えっと、これ。   あれって"}, {"type": "subtitle", "time": 1550.63, "timestamp": "00:25:50", "text": "何ていう名前だったっけ？ 何かあったんですよね"}, {"type": "subtitle", "time": 1554.47, "timestamp": "00:25:54", "text": "？ えっと、なんていう名前ですか？"}, {"type": "subtitle", "time": 1556.789, "timestamp": "00:25:56", "text": "これは何と呼ばれますか？"}, {"type": "subtitle", "time": 1559.83, "timestamp": "00:25:59", "text": "ああ、これはあなたが"}]
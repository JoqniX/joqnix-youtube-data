[{"type": "subtitle", "time": 5824.55, "timestamp": "01:37:04", "text": "ああ、誰かがココアを見つけた時にマスクをした子供たち"}, {"type": "subtitle", "time": 5829.51, "timestamp": "01:37:09", "text": "。"}, {"type": "subtitle", "time": 5831.99, "timestamp": "01:37:11", "text": "ココアがあります。"}, {"type": "subtitle", "time": 5834.229, "timestamp": "01:37:14", "text": "コカ・コーラ1本500円です。"}, {"type": "subtitle", "time": 5844.149, "timestamp": "01:37:24", "text": "誰かを殴るだけです。 ああ、神様。 私には言えません"}, {"type": "subtitle", "time": 5847.35, "timestamp": "01:37:27", "text": "。"}, {"type": "subtitle", "time": 5849.75, "timestamp": "01:37:29", "text": "それは私の失礼な態度でした。   私は"}, {"type": "subtitle", "time": 5854.39, "timestamp": "01:37:34", "text": "誰かと肩を並べる。   気をつけなければならない"}, {"type": "subtitle", "time": 5879.109, "timestamp": "01:37:59", "text": "私が行くべき場所が間違っているのか？ とても"}]
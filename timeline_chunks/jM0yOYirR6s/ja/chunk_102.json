[{"type": "subtitle", "time": 6120.79, "timestamp": "01:42:00", "text": "これは奇妙だ。 そうあるべきではない。"}, {"type": "subtitle", "time": 6127.189, "timestamp": "01:42:07", "text": "少なくともマルチウィンドウ表示ができるようにしてほしいのですが"}, {"type": "subtitle", "time": 6148.95, "timestamp": "01:42:28", "text": "待って、ここはどこ？"}, {"type": "subtitle", "time": 6150.87, "timestamp": "01:42:30", "text": "コノ・"}, {"type": "subtitle", "time": 6153.59, "timestamp": "01:42:33", "text": "チェンナイ。   何てことだ"}, {"type": "subtitle", "time": 6161.59, "timestamp": "01:42:41", "text": "私はどこまで到達したのだろうか？   ミンダ、私、道に迷っちゃった"}, {"type": "subtitle", "time": 6166.709, "timestamp": "01:42:46", "text": "。 実は道に迷ってしまったんです。"}]
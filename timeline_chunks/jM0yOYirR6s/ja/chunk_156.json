[{"type": "subtitle", "time": 9394.15, "timestamp": "02:36:34", "text": "こんにちは。それでは、さようなら。 良い一日を。"}, {"type": "subtitle", "time": 9401.51, "timestamp": "02:36:41", "text": "そして、私のデビューは"}, {"type": "subtitle", "time": 9405.11, "timestamp": "02:36:45", "text": "7月18日だということを忘れないでください。 来週の土曜日。 来週の"}, {"type": "subtitle", "time": 9408.63, "timestamp": "02:36:48", "text": "土曜日。 来週の土曜日。 今回は、"}, {"type": "subtitle", "time": 9411.03, "timestamp": "02:36:51", "text": "文字通り今から10分後に"}, {"type": "subtitle", "time": 9412.87, "timestamp": "02:36:52", "text": "ライブ配信をして、"}, {"type": "subtitle", "time": 9415.27, "timestamp": "02:36:55", "text": "新しいモデルなどを紹介します。"}]
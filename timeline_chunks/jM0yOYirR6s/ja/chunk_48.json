[{"type": "subtitle", "time": 2880.39, "timestamp": "00:48:00", "text": "私は文字通り上に登ることができます。 これは"}, {"type": "subtitle", "time": 2883.109, "timestamp": "00:48:03", "text": "あなたをどこへ導くのでしょうか？   あ"}, {"type": "subtitle", "time": 2885.03, "timestamp": "00:48:05", "text": "、待って。 見て、"}, {"type": "subtitle", "time": 2888.23, "timestamp": "00:48:08", "text": "死んでるよ。 これは"}, {"type": "subtitle", "time": 2890.87, "timestamp": "00:48:10", "text": "水が溜まって、そして下がっていくような仕組みです"}, {"type": "subtitle", "time": 2894.39, "timestamp": "00:48:14", "text": "。 何てことだ。"}, {"type": "subtitle", "time": 2896.15, "timestamp": "00:48:16", "text": "このエリアでは、座って"}, {"type": "subtitle", "time": 2899.589, "timestamp": "00:48:19", "text": "リラックスしながら食事を楽しむことができます。"}, {"type": "subtitle", "time": 2903.03, "timestamp": "00:48:23", "text": "日本人は皆、小型の"}, {"type": "subtitle", "time": 2905.349, "timestamp": "00:48:25", "text": "携帯扇風機を持っている。 今、それに気づきました。 もう"}, {"type": "subtitle", "time": 2928.63, "timestamp": "00:48:48", "text": "あれは車ですか？ 今気づいたんだけど、あれって"}, {"type": "subtitle", "time": 2930.15, "timestamp": "00:48:50", "text": "車だったんだね。   何てことだ"}]
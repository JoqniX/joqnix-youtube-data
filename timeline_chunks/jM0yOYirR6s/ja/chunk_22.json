[{"type": "subtitle", "time": 1331.99, "timestamp": "00:22:11", "text": "それと、600人分もある大きなチーズボールみたいなのもあるんだよ"}, {"type": "subtitle", "time": 1336.95, "timestamp": "00:22:16", "text": "。"}, {"type": "subtitle", "time": 1339.27, "timestamp": "00:22:19", "text": "そして、ほら、それはまるで、ここにあるすべてのようなものです"}, {"type": "subtitle", "time": 1344.31, "timestamp": "00:22:24", "text": "。"}, {"type": "subtitle", "time": 1347.27, "timestamp": "00:22:27", "text": "これが何なのか分かりません。"}, {"type": "subtitle", "time": 1349.43, "timestamp": "00:22:29", "text": "そこから何を得るのですか？"}, {"type": "subtitle", "time": 1353.029, "timestamp": "00:22:33", "text": "あ、待って。 射撃装置がここにあります。"}, {"type": "subtitle", "time": 1360.63, "timestamp": "00:22:40", "text": "誰かが撃とうとしているので、見てみようと思います。"}, {"type": "subtitle", "time": 1365.83, "timestamp": "00:22:45", "text": "こんにちは。"}, {"type": "subtitle", "time": 1367.83, "timestamp": "00:22:47", "text": "今回は生配信です。 はい、"}, {"type": "subtitle", "time": 1371.669, "timestamp": "00:22:51", "text": "今日はここで本物のライブVlogをお届けします。"}, {"type": "subtitle", "time": 1374.549, "timestamp": "00:22:54", "text": "つまり、"}, {"type": "subtitle", "time": 1377.11, "timestamp": "00:22:57", "text": "背面カメラだけです。 だから、私はまるで"}]
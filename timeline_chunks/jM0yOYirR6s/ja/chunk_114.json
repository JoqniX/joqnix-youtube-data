[{"type": "subtitle", "time": 6840.629, "timestamp": "01:54:00", "text": "私がこれをやっているのを見た人たちが何人かいて、"}, {"type": "subtitle", "time": 6846.629, "timestamp": "01:54:06", "text": "こんにちは」って感じでした。"}, {"type": "subtitle", "time": 6848.95, "timestamp": "01:54:08", "text": "そして彼らは挨拶しようとした。 しかし、私は振り返らなかった"}, {"type": "subtitle", "time": 6850.95, "timestamp": "01:54:10", "text": "。 私はとても内気だった。  「"}, {"type": "subtitle", "time": 6862.39, "timestamp": "01:54:22", "text": "犬でも飼おうかな」って思ったんです。"}, {"type": "subtitle", "time": 6867.99, "timestamp": "01:54:27", "text": "「ああ、すごく怖くて恥ずかしかった」って感じだった。   ええ"}, {"type": "subtitle", "time": 6870.629, "timestamp": "01:54:30", "text": "、またあの通りに戻ってきました"}, {"type": "subtitle", "time": 6874.07, "timestamp": "01:54:34", "text": "。 それで、このマットシティは8時には閉まります。確か"}, {"type": "subtitle", "time": 6880.149, "timestamp": "01:54:40", "text": "8時には閉まると思います。ええ。 本当は"}, {"type": "subtitle", "time": 6882.55, "timestamp": "01:54:42", "text": "1時間早く出発する予定だったんだ"}, {"type": "subtitle", "time": 6887.03, "timestamp": "01:54:47", "text": "けど、道に迷っちゃってまだここにいるんだ"}, {"type": "subtitle", "time": 6889.189, "timestamp": "01:54:49", "text": "。 もう"}]
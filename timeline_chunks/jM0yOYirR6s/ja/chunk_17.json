[{"type": "subtitle", "time": 1029.829, "timestamp": "00:17:09", "text": "それらのほとんどは400"}, {"type": "subtitle", "time": 1032.15, "timestamp": "00:17:12", "text": "キロメートルです。 ああ、じゃあ向こう"}, {"type": "subtitle", "time": 1034.949, "timestamp": "00:17:14", "text": "側へ行こう。 ちょっと"}, {"type": "subtitle", "time": 1038.309, "timestamp": "00:17:18", "text": "待って。 この地域についてはあまり"}, {"type": "subtitle", "time": 1040.549, "timestamp": "00:17:20", "text": "詳しくありません。 うん。 うん、"}, {"type": "subtitle", "time": 1042.63, "timestamp": "00:17:22", "text": "7までなら大丈夫だと思うよ。   それ以上は無理です。"}, {"type": "subtitle", "time": 1048.789, "timestamp": "00:17:28", "text": "授業に追いつくために家に帰らなければならないので。"}, {"type": "subtitle", "time": 1052.47, "timestamp": "00:17:32", "text": "うん、後で配信してみるよ。   ああ"}, {"type": "subtitle", "time": 1056.31, "timestamp": "00:17:36", "text": "、明日だ。 だから私はここに来るんです。"}, {"type": "subtitle", "time": 1058.23, "timestamp": "00:17:38", "text": "うん、明日の夜にここに来ようと思う"}, {"type": "subtitle", "time": 1061.909, "timestamp": "00:17:41", "text": "。 えーと、フェスティバルは明日午後8時に終了します。"}, {"type": "subtitle", "time": 1072.71, "timestamp": "00:17:52", "text": "名前でしたっけ？ 名前を忘れてしまった"}, {"type": "subtitle", "time": 1074.95, "timestamp": "00:17:54", "text": "。   えっと、あれ"}, {"type": "subtitle", "time": 1078.23, "timestamp": "00:17:58", "text": "。"}]
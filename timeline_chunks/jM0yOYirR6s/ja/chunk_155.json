[{"type": "subtitle", "time": 9303.83, "timestamp": "02:35:03", "text": "でも、今日は楽しかった。 良かったよ。"}, {"type": "subtitle", "time": 9305.99, "timestamp": "02:35:05", "text": "次回はマイクを持って行って、マイクをオンにして"}, {"type": "subtitle", "time": 9309.83, "timestamp": "02:35:09", "text": "、"}, {"type": "subtitle", "time": 9314.309, "timestamp": "02:35:14", "text": "マイクを使えるようにします。そうすれば、マイクを使う方がずっといいですからね。"}, {"type": "subtitle", "time": 9316.71, "timestamp": "02:35:16", "text": "マイクの性能は、私のスマホのスピーカーよりも優れていると思います"}, {"type": "subtitle", "time": 9319.83, "timestamp": "02:35:19", "text": "。 まあ"}, {"type": "subtitle", "time": 9322.95, "timestamp": "02:35:22", "text": "、今日は楽しかったよ。 楽しんでいただけたなら幸いです"}, {"type": "subtitle", "time": 9326.87, "timestamp": "02:35:26", "text": "。 これで失礼いたします。 午後"}, {"type": "subtitle", "time": 9329.59, "timestamp": "02:35:29", "text": "8時になります。 そして、"}, {"type": "subtitle", "time": 9332.63, "timestamp": "02:35:32", "text": "遅刻したことで叱られるだろう。"}, {"type": "subtitle", "time": 9335.91, "timestamp": "02:35:35", "text": "6時までに家に帰る予定だったのですが、"}, {"type": "subtitle", "time": 9339.349, "timestamp": "02:35:39", "text": "少し遅れたせいで2時間も遅れてしまいました。"}, {"type": "subtitle", "time": 9341.91, "timestamp": "02:35:41", "text": "うん。 さよなら。"}]
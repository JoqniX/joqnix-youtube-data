[{"type": "subtitle", "time": 2287.91, "timestamp": "00:38:07", "text": "。   しかし、それだけではない"}, {"type": "subtitle", "time": 2290.55, "timestamp": "00:38:10", "text": "。   何てことだ"}, {"type": "subtitle", "time": 2294.63, "timestamp": "00:38:14", "text": "。 もっと。"}, {"type": "subtitle", "time": 2298.23, "timestamp": "00:38:18", "text": "待って、こっちに行くよ。"}, {"type": "chat", "time": 2301.62, "timestamp": "00:38:21", "author": "@KosmikZethar", "avatar": "https://yt4.ggpht.com/b_m56i87DkQCWoSLK8J6eGPlt0w4dJQYTlT9PaGPCOWZzEZaUiSe6Q-t3xsz9BESFJqhLP1oHg=s64-c-k-c0x00ffffff-no-rj", "message": "Didnt u want to teach english or something there?"}, {"type": "subtitle", "time": 2302.87, "timestamp": "00:38:22", "text": "じゃあ、こっちに行って、それから"}, {"type": "subtitle", "time": 2307.03, "timestamp": "00:38:27", "text": "反対方向に行くよ。 わかった。"}, {"type": "subtitle", "time": 2310.39, "timestamp": "00:38:30", "text": "ジュースがたくさんあるし、"}, {"type": "subtitle", "time": 2314.47, "timestamp": "00:38:34", "text": "ああ、すごく混んでる。"}, {"type": "subtitle", "time": 2317.67, "timestamp": "00:38:37", "text": "銃があって、バンがあって、刀があって、"}, {"type": "subtitle", "time": 2320.23, "timestamp": "00:38:40", "text": "刀っぽいものがあって、"}, {"type": "subtitle", "time": 2323.43, "timestamp": "00:38:43", "text": "そしてこれは肉だ。"}, {"type": "subtitle", "time": 2336.31, "timestamp": "00:38:56", "text": "えっと、ジャガイモ。"}, {"type": "subtitle", "time": 2339.03, "timestamp": "00:38:59", "text": "ああ、風が強い。 ニース。"}]
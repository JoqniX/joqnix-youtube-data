[{"type": "subtitle", "time": 7623.51, "timestamp": "02:07:03", "text": "ええと、どちらかというと田舎っぽい都市で、あまり"}, {"type": "subtitle", "time": 7650.47, "timestamp": "02:07:30", "text": "これらのエリアを公開しても本当に大丈夫でしょうか"}, {"type": "subtitle", "time": 7653.83, "timestamp": "02:07:33", "text": "？ もし私が他の都市や場所などに旅行していたら、もっと良かっただろう"}, {"type": "subtitle", "time": 7661.589, "timestamp": "02:07:41", "text": "。 でも、私はここにいる。 ああ、そうそう、"}, {"type": "subtitle", "time": 7663.51, "timestamp": "02:07:43", "text": "配信が始まる前は、まさに"}, {"type": "subtitle", "time": 7666.79, "timestamp": "02:07:46", "text": "ここで"}, {"type": "subtitle", "time": 7670.47, "timestamp": "02:07:50", "text": "ウアンがアップデートを終えて、今"}, {"type": "subtitle", "time": 7673.27, "timestamp": "02:07:53", "text": "私が配信に使っているこのアプリのアップデートをプッシュするのを待っていたんだ"}, {"type": "subtitle", "time": 7677.51, "timestamp": "02:07:57", "text": "。 カメラのアップデートで全てが"}]
[{"type": "subtitle", "time": 3971.27, "timestamp": "01:06:11", "text": "うーん、あまり良い考えだとは思わないけど、"}, {"type": "subtitle", "time": 3974.63, "timestamp": "01:06:14", "text": "何とかして行きたいんです。"}, {"type": "subtitle", "time": 3977.19, "timestamp": "01:06:17", "text": "彼らも"}, {"type": "subtitle", "time": 3999.43, "timestamp": "01:06:39", "text": "私は人見知りすぎるんです。 私には無理です。"}, {"type": "subtitle", "time": 4006.87, "timestamp": "01:06:46", "text": "すごく緊張する。 挨拶に行きたい"}]
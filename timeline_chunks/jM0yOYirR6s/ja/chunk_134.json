[{"type": "subtitle", "time": 8048.39, "timestamp": "02:14:08", "text": "でも正直なところ、こういう夜間のサイクリングは"}, {"type": "subtitle", "time": 8051.51, "timestamp": "02:14:11", "text": "本当に気持ちいい。"}, {"type": "subtitle", "time": 8056.629, "timestamp": "02:14:16", "text": "夜には、私はこんな風にサイクリングに行くんですよ。"}, {"type": "subtitle", "time": 8060.149, "timestamp": "02:14:20", "text": "えっと、夜遅くとかに"}, {"type": "subtitle", "time": 8086.87, "timestamp": "02:14:46", "text": "ねえ、ここは教会だよ。"}]
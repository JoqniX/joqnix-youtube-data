[{"type": "subtitle", "time": 7440.709, "timestamp": "02:04:00", "text": "3時間、水を飲んだり携帯電話を使ったりすることを許されませんでした。"}, {"type": "subtitle", "time": 7445.83, "timestamp": "02:04:05", "text": "それから少し日光に当たって、"}, {"type": "subtitle", "time": 7449.669, "timestamp": "02:04:09", "text": "ジュースのボトルを買って乾かしました。"}, {"type": "subtitle", "time": 7453.109, "timestamp": "02:04:13", "text": "それはもう3時間前の話だけどね。"}, {"type": "subtitle", "time": 7456.39, "timestamp": "02:04:16", "text": "今は7時20分です。   ああ、そう"}, {"type": "subtitle", "time": 7478.709, "timestamp": "02:04:38", "text": "人が来てるし、くつろいでる"}, {"type": "subtitle", "time": 7481.43, "timestamp": "02:04:41", "text": "人もいるんだよ"}, {"type": "subtitle", "time": 7483.589, "timestamp": "02:04:43", "text": "。   そうそう"}, {"type": "subtitle", "time": 7485.27, "timestamp": "02:04:45", "text": "。 ここは"}, {"type": "subtitle", "time": 7493.109, "timestamp": "02:04:53", "text": "待って、100円。"}, {"type": "subtitle", "time": 7495.35, "timestamp": "02:04:55", "text": "えっと、イカゲームみたいなやつ用です"}]
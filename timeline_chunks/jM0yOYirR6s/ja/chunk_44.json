[{"type": "subtitle", "time": 2642.95, "timestamp": "00:44:02", "text": "好きなものをどう位置づけたらいいのか分からない。 それももう"}, {"type": "subtitle", "time": 2657.67, "timestamp": "00:44:17", "text": "あ、待って。 モスクはここにあります。"}, {"type": "subtitle", "time": 2660.71, "timestamp": "00:44:20", "text": "キツナマスクがここにありますし、あの"}, {"type": "subtitle", "time": 2662.71, "timestamp": "00:44:22", "text": "一般的なライダーマスクもそこにあります"}, {"type": "subtitle", "time": 2681.51, "timestamp": "00:44:41", "text": "あ、モモがあるよ。"}, {"type": "subtitle", "time": 2691.19, "timestamp": "00:44:51", "text": "これを至る所で見かける。"}, {"type": "subtitle", "time": 2693.349, "timestamp": "00:44:53", "text": "それは、"}, {"type": "subtitle", "time": 2696.87, "timestamp": "00:44:56", "text": "ああ、味だと思います。 美味しそうですね。 そして"}]
[{"type": "subtitle", "time": 1443.43, "timestamp": "00:24:03", "text": "見てごらん。 すごくかっこいい。"}, {"type": "subtitle", "time": 1454.87, "timestamp": "00:24:14", "text": "キャンディアップルが届きました。 そして、実に多くのこと。   あれは"}, {"type": "subtitle", "time": 1469.669, "timestamp": "00:24:29", "text": "装飾品などを見てください。 それらは"}, {"type": "subtitle", "time": 1471.909, "timestamp": "00:24:31", "text": "すべて、"}, {"type": "subtitle", "time": 1474.63, "timestamp": "00:24:34", "text": "人間が書いた悪意に満ちた文章です。"}, {"type": "subtitle", "time": 1490.149, "timestamp": "00:24:50", "text": "タコスです。 アディティはどこにいますか？ アディティは、"}, {"type": "subtitle", "time": 1493.029, "timestamp": "00:24:53", "text": "これは何に使うのかと尋ねた。 それは"}, {"type": "subtitle", "time": 1496.71, "timestamp": "00:24:56", "text": "タコスみたいなものですね。   これもその一つです"}, {"type": "subtitle", "time": 1499.11, "timestamp": "00:24:59", "text": "。 ハローキティを忘れちゃったんだけど、"}]
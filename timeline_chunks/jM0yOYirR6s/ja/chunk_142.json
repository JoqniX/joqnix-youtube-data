[{"type": "subtitle", "time": 8523.27, "timestamp": "02:22:03", "text": "ゴリラ男のために。 ゴリラ、ゴリラ"}, {"type": "subtitle", "time": 8524.87, "timestamp": "02:22:04", "text": "ストア。"}, {"type": "subtitle", "time": 8527.19, "timestamp": "02:22:07", "text": "その配信をご存知かどうか分かりませんが。 雨天時にあの"}, {"type": "subtitle", "time": 8530.15, "timestamp": "02:22:10", "text": "音声配信をご覧になったなら"}, {"type": "subtitle", "time": 8532.87, "timestamp": "02:22:12", "text": "、ええ、以前お見せしたゴリラのやつです"}, {"type": "subtitle", "time": 8550.469, "timestamp": "02:22:30", "text": "8時です。えっと、"}, {"type": "subtitle", "time": 8556.55, "timestamp": "02:22:36", "text": "今日はルームメイトに叱られると思います。 えっと、私の部屋は"}, {"type": "subtitle", "time": 8560.95, "timestamp": "02:22:40", "text": "いつも私を呼んでいるんです。"}, {"type": "subtitle", "time": 8564.23, "timestamp": "02:22:44", "text": "買いたいものがあるんです。"}]
[{"type": "subtitle", "time": 8342.87, "timestamp": "02:19:02", "text": "よし、これは良さそうだ。"}, {"type": "subtitle", "time": 8345.03, "timestamp": "02:19:05", "text": "心配しないで、私の住んでいる場所にはドックはないよ"}, {"type": "subtitle", "time": 8346.629, "timestamp": "02:19:06", "text": "。   目的地に着く前に"}, {"type": "subtitle", "time": 8349.27, "timestamp": "02:19:09", "text": "配信を止めます"}, {"type": "subtitle", "time": 8352.646, "timestamp": "02:19:12", "text": "。"}, {"type": "subtitle", "time": 8354.309, "timestamp": "02:19:14", "text": "[笑い]"}, {"type": "subtitle", "time": 8358.07, "timestamp": "02:19:18", "text": "ええ、間違いなく切り捨てます。 切り落としなさい"}, {"type": "subtitle", "time": 8366.15, "timestamp": "02:19:26", "text": "配信後、"}, {"type": "subtitle", "time": 8374.07, "timestamp": "02:19:34", "text": "背面カメラを使ったこのライブ配信についてのご感想をぜひお聞かせください。   教えてくれるよね"}, {"type": "subtitle", "time": 8376.309, "timestamp": "02:19:36", "text": "？"}, {"type": "subtitle", "time": 8379.75, "timestamp": "02:19:39", "text": "スマホの性能が許す限り、もっとこういうことをやっていきたいと思っています"}, {"type": "subtitle", "time": 8381.83, "timestamp": "02:19:41", "text": "。"}]
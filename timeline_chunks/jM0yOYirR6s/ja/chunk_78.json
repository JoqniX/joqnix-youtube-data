[{"type": "subtitle", "time": 4691.11, "timestamp": "01:18:11", "text": "遊戯王には神々が何人いるのか？"}, {"type": "subtitle", "time": 4730.709, "timestamp": "01:18:50", "text": "こちらにはアクセサリーがたくさんありますね。"}, {"type": "subtitle", "time": 4734.149, "timestamp": "01:18:54", "text": "チェーンとかそういう類。 何てことだ。"}, {"type": "subtitle", "time": 4736.87, "timestamp": "01:18:56", "text": "あれは星の連鎖ですか？"}]
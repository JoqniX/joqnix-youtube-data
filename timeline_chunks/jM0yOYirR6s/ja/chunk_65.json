[{"type": "subtitle", "time": 3913.109, "timestamp": "01:05:13", "text": "私は、これらはそうだと感じます。"}, {"type": "subtitle", "time": 3933.589, "timestamp": "01:05:33", "text": "知り合いに挨拶しに行くべきだと思いますか？ えーと、"}, {"type": "subtitle", "time": 3936.549, "timestamp": "01:05:36", "text": "オレンジ色のTシャツを着た男。"}, {"type": "subtitle", "time": 3938.87, "timestamp": "01:05:38", "text": "彼に挨拶しに行くべきでしょうか？"}, {"type": "subtitle", "time": 3941.51, "timestamp": "01:05:41", "text": "その人のことは知っているけど、ちょっと"}, {"type": "subtitle", "time": 3944.15, "timestamp": "01:05:44", "text": "気まずいだろうな。 多分ミュートにするよ"}, {"type": "subtitle", "time": 3947.99, "timestamp": "01:05:47", "text": "。 ミュートにします。"}, {"type": "subtitle", "time": 3950.95, "timestamp": "01:05:50", "text": "リスクは冒したくない。"}]
[{"type": "subtitle", "time": 5283.99, "timestamp": "01:28:03", "text": "アニメとかで"}, {"type": "subtitle", "time": 5286.629, "timestamp": "01:28:06", "text": "ココハクとか聞くでしょ？ それは"}, {"type": "subtitle", "time": 5289.03, "timestamp": "01:28:09", "text": "七夕に起こることだと思います。"}, {"type": "subtitle", "time": 5291.35, "timestamp": "01:28:11", "text": "七夕ではない。"}, {"type": "subtitle", "time": 5296.87, "timestamp": "01:28:16", "text": "花火大会って、そういうことが起こるような気がするんだよね。"}, {"type": "subtitle", "time": 5301.03, "timestamp": "01:28:21", "text": "うん。 おお。"}, {"type": "subtitle", "time": 5303.03, "timestamp": "01:28:23", "text": "花火大会を見に行きたい。"}, {"type": "subtitle", "time": 5307.03, "timestamp": "01:28:27", "text": "日時など全て知りたいので、"}, {"type": "subtitle", "time": 5329.59, "timestamp": "01:28:49", "text": "皆さんは人混みに戻りたいですか？"}, {"type": "subtitle", "time": 5337.83, "timestamp": "01:28:57", "text": "買いませんでした"}]
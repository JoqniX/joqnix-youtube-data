[{"type": "subtitle", "time": 6783.43, "timestamp": "01:53:03", "text": "日本。 武士。 日本。 タペストリー。 あ、"}, {"type": "subtitle", "time": 6786.87, "timestamp": "01:53:06", "text": "待って。 これらは紙で作られていると思います"}, {"type": "subtitle", "time": 6806.149, "timestamp": "01:53:26", "text": "。 わかったよ、"}, {"type": "subtitle", "time": 6809.75, "timestamp": "01:53:29", "text": "兄弟。 道に迷ってしまった。"}, {"type": "subtitle", "time": 6812.07, "timestamp": "01:53:32", "text": "芸術作品を見てください。"}, {"type": "subtitle", "time": 6814.07, "timestamp": "01:53:34", "text": "はい、"}, {"type": "subtitle", "time": 6818.79, "timestamp": "01:53:38", "text": "レッドがここにいます。 うーん、わからない"}, {"type": "subtitle", "time": 6820.87, "timestamp": "01:53:40", "text": "。"}, {"type": "subtitle", "time": 6824.31, "timestamp": "01:53:44", "text": "名前を言うべきかどうかわからないけど、まあ、あなたならわかると思う"}, {"type": "subtitle", "time": 6834.39, "timestamp": "01:53:54", "text": "道に迷ってしまったんです。"}, {"type": "subtitle", "time": 6837.589, "timestamp": "01:53:57", "text": "もっとそう。 そして、"}]
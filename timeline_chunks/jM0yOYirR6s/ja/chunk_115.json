[{"type": "subtitle", "time": 6900.709, "timestamp": "01:55:00", "text": "誰かが何かを勝ち取ったんだと思いますよね？ わからない"}, {"type": "subtitle", "time": 6920.55, "timestamp": "01:55:20", "text": "ノノノテナニを着る人もいます"}, {"type": "subtitle", "time": 6942.47, "timestamp": "01:55:42", "text": "またステージに立つ。"}, {"type": "subtitle", "time": 6945.35, "timestamp": "01:55:45", "text": "すごく喉が渇いた。 何か買いたいんだ"}, {"type": "subtitle", "time": 6948.79, "timestamp": "01:55:48", "text": "けど、マット"}, {"type": "subtitle", "time": 6951.109, "timestamp": "01:55:51", "text": "シティとかでは、支払いとかはできないんだよ"}, {"type": "subtitle", "time": 6954.47, "timestamp": "01:55:54", "text": "ね？"}]
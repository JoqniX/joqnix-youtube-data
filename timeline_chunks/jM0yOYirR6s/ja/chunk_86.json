[{"type": "subtitle", "time": 5164.629, "timestamp": "01:26:04", "text": "サイクルがあるんです。 もし私が"}, {"type": "subtitle", "time": 5167.43, "timestamp": "01:26:07", "text": "歩いていたら、私たちはただ"}, {"type": "subtitle", "time": 5176.87, "timestamp": "01:26:16", "text": "祭りは楽しかったですか？ 私はたくさんの"}, {"type": "subtitle", "time": 5188.47, "timestamp": "01:26:28", "text": "表紙を見たい。   わかった"}, {"type": "subtitle", "time": 5207.03, "timestamp": "01:26:47", "text": "これを見てください。"}, {"type": "subtitle", "time": 5209.59, "timestamp": "01:26:49", "text": "非現実的ですよね？   私は"}, {"type": "subtitle", "time": 5211.43, "timestamp": "01:26:51", "text": "この場所を初めて発見しました"}, {"type": "subtitle", "time": 5215.27, "timestamp": "01:26:55", "text": "。 水はこのように滑り落ちて、あちらに流れ込んできます"}]
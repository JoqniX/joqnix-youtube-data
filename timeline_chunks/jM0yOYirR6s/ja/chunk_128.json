[{"type": "subtitle", "time": 7680.79, "timestamp": "02:08:00", "text": "修正されました。 ズームイン。 申し訳ありませんが、まだいくつか"}, {"type": "subtitle", "time": 7683.03, "timestamp": "02:08:03", "text": "バグが発生しています。"}, {"type": "subtitle", "time": 7685.99, "timestamp": "02:08:05", "text": "例えば、"}, {"type": "subtitle", "time": 7688.55, "timestamp": "02:08:08", "text": "マルチウィンドができなかったり、マルチウィンドができなかったり、"}, {"type": "subtitle", "time": 7691.51, "timestamp": "02:08:11", "text": "別のアプリに切り替えることができなかったりしました。"}, {"type": "subtitle", "time": 7695.109, "timestamp": "02:08:15", "text": "ストリームが少し途切れてしまいました。"}, {"type": "subtitle", "time": 7708.39, "timestamp": "02:08:28", "text": "鍵はかけていますか？ 日本だが、一部の人々は"}, {"type": "subtitle", "time": 7711.51, "timestamp": "02:08:31", "text": "強盗をする。 うん。 ええ、ちゃんと鍵をかけましたよ。 ちゃんと"}, {"type": "subtitle", "time": 7713.589, "timestamp": "02:08:33", "text": "鍵をかけましたよ。   今すぐ"}, {"type": "subtitle", "time": 7716.709, "timestamp": "02:08:36", "text": "ズボンを見せたいけど、できないし、するべきじゃ"}, {"type": "subtitle", "time": 7719.109, "timestamp": "02:08:39", "text": "ない。 自分の"}, {"type": "subtitle", "time": 7722.629, "timestamp": "02:08:42", "text": "身体の個人情報を公開します。 ちょっとロックを解除させてください。 ええ、私の生理周期はそこにあります"}, {"type": "subtitle", "time": 7724.87, "timestamp": "02:08:44", "text": "。 私はそれをいくつかの"}, {"type": "subtitle", "time": 7727.91, "timestamp": "02:08:47", "text": "アパートの自転車置き場に置いておきました。"}, {"type": "subtitle", "time": 7730.229, "timestamp": "02:08:50", "text": "もし誰かがそれを見たら、私はトラブルに巻き込まれるかもしれない"}]
[{"type": "subtitle", "time": 1141.11, "timestamp": "00:19:01", "text": "前唱歌會緊張。我不知道我是怎麼在直播中做到的。是的，今天，不，今天我在YouTube上看了Kamisubaki頻道。  他們展示了他們去年舉辦的單人現場演出，"}, {"type": "subtitle", "time": 1143.75, "timestamp": "00:19:03", "text": "今天可以在 YouTube 上免費觀看首映。於是，我一邊看著，一邊"}, {"type": "subtitle", "time": 1149.19, "timestamp": "00:19:09", "text": "思考。"}, {"type": "subtitle", "time": 1151.909, "timestamp": "00:19:11", "text": "老兄，我也想做一場 YouTuber"}, {"type": "subtitle", "time": 1156.87, "timestamp": "00:19:16", "text": "演唱會直播。不。嗯，"}, {"type": "subtitle", "time": 1166.47, "timestamp": "00:19:26", "text": "所以我查了一下。呃，不過我好像可以跟吳一起做。嗯，我很好奇想"}, {"type": "subtitle", "time": 1170.63, "timestamp": "00:19:30", "text": "嘗試看看。  是的，"}, {"type": "subtitle", "time": 1172.63, "timestamp": "00:19:32", "text": "我有點好奇該怎麼做，也想知道"}, {"type": "subtitle", "time": 1175.43, "timestamp": "00:19:35", "text": "我是否能做到，以及所有的一切，"}, {"type": "subtitle", "time": 1179.909, "timestamp": "00:19:39", "text": "例如攝影機切換和所有這些"}, {"type": "subtitle", "time": 1182.549, "timestamp": "00:19:42", "text": "現在[笑]"}]
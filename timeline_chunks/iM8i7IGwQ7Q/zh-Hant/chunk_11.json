[{"type": "subtitle", "time": 661.91, "timestamp": "00:11:01", "text": "觀看。這件事我之後再想辦法。是的，"}, {"type": "subtitle", "time": 664.23, "timestamp": "00:11:04", "text": "我的計劃是先在本地運行，然後如果"}, {"type": "subtitle", "time": 671.67, "timestamp": "00:11:11", "text": "大家都喜歡用，或者隨著"}, {"type": "subtitle", "time": 674.47, "timestamp": "00:11:14", "text": "時間的推移，性能"}, {"type": "subtitle", "time": 677.11, "timestamp": "00:11:17", "text": "表現也令人滿意，我就會投資"}, {"type": "subtitle", "time": 684.87, "timestamp": "00:11:24", "text": "雲端伺服器之類的東西，這樣它就能一直存在了"}, {"type": "subtitle", "time": 687.75, "timestamp": "00:11:27", "text": "。不。是的，我知道"}, {"type": "subtitle", "time": 689.75, "timestamp": "00:11:29", "text": "對於像我這樣的小創作者來說，現在做"}, {"type": "subtitle", "time": 692.79, "timestamp": "00:11:32", "text": "這件事還為時過早。只是明年，也就是"}, {"type": "subtitle", "time": 694.949, "timestamp": "00:11:34", "text": "我現在在日本的時候，我就沒辦法"}, {"type": "subtitle", "time": 697.59, "timestamp": "00:11:37", "text": "直播什麼的了。不，我會很難"}, {"type": "subtitle", "time": 715.99, "timestamp": "00:11:55", "text": "過的。所以我想，好吧，我可以從日本遠端控制我的電腦，也可以從印度遠端控制我的電腦。不，我可以"}, {"type": "subtitle", "time": 718.47, "timestamp": "00:11:58", "text": "用手機控制它。如果我從我的電腦上24小時不間斷地發送視訊串流呢？ [笑聲] 因為我不想我的電腦在我不用的時候就壞掉，你知道的。我想"}]
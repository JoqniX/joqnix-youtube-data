[{"type": "subtitle", "time": 1981.99, "timestamp": "00:33:01", "text": "娛樂技巧、你的聲音，"}, {"type": "subtitle", "time": 1984.95, "timestamp": "00:33:04", "text": "以及如何吸引觀眾等等"}, {"type": "subtitle", "time": 1989.11, "timestamp": "00:33:09", "text": "這些"}, {"type": "chat", "time": 1995.706, "timestamp": "00:33:15", "author": "@miko_chann.1", "avatar": "https://yt4.ggpht.com/pA1qKxvA6gJkJo5iacL6MoaaocqRqPaKMbOHlznwOHpCJPPZbIU3_GNZ4faHtUzgYCNGbiZs1w=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2Ak"}, {"type": "subtitle", "time": 2008.95, "timestamp": "00:33:28", "text": "核心技能。是的，我看到那個帖子後就想，某種程度上，我有一個很想投資、測試併購買的模特，但我現在因為缺錢而無法做到。我現在應該專注於提升我作為"}, {"type": "subtitle", "time": 2011.99, "timestamp": "00:33:31", "text": "內容創作者或主播的核心技能，例如"}, {"type": "subtitle", "time": 2016.47, "timestamp": "00:33:36", "text": "互動、說話等等。所以"}, {"type": "subtitle", "time": 2019.99, "timestamp": "00:33:39", "text": "基本上，我現在看起來就像個"}, {"type": "subtitle", "time": 2026.789, "timestamp": "00:33:46", "text": "所以我一直在思考這個問題，是啊，這"}]
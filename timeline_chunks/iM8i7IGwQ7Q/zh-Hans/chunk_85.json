[{"type": "subtitle", "time": 5117.11, "timestamp": "01:25:17", "text": "我真的很想知道……"}, {"type": "subtitle", "time": 5119.91, "timestamp": "01:25:19", "text": "哦，是的。 说到"}, {"type": "subtitle", "time": 5122.87, "timestamp": "01:25:22", "text": "我们最近在"}, {"type": "subtitle", "time": 5125.189, "timestamp": "01:25:25", "text": "YouTube 和 Twitch 上推出的 24 小时频道，没错。 我的意思是，YouTube 上的那个频道"}, {"type": "subtitle", "time": 5128.043, "timestamp": "01:25:28", "text": "是 V 频道。 我正在重新利用它"}, {"type": "subtitle", "time": 5129.35, "timestamp": "01:25:29", "text": "[嗤笑]，"}, {"type": "subtitle", "time": 5132.39, "timestamp": "01:25:32", "text": "就像，嗯，就我而言，对吧？ 它更像是"}, {"type": "subtitle", "time": 5135.11, "timestamp": "01:25:35", "text": "一个"}, {"type": "subtitle", "time": 5136.629, "timestamp": "01:25:36", "text": "自动生成的"}, {"type": "subtitle", "time": 5139.669, "timestamp": "01:25:39", "text": "随机播放列表，对吧？"}, {"type": "subtitle", "time": 5143.99, "timestamp": "01:25:43", "text": "所以，这与其他全天候频道不同，"}, {"type": "subtitle", "time": 5146.47, "timestamp": "01:25:46", "text": "它们24小时不间断地播放"}, {"type": "subtitle", "time": 5149.43, "timestamp": "01:25:49", "text": "浓缩节目等等，供"}, {"type": "subtitle", "time": 5153.669, "timestamp": "01:25:53", "text": "人们观看。 嗯，这不像把"}, {"type": "subtitle", "time": 5156.79, "timestamp": "01:25:56", "text": "录音上传到服务器，然后"}, {"type": "subtitle", "time": 5158.87, "timestamp": "01:25:58", "text": "播放录音之类的。"}]
[{"type": "subtitle", "time": 3543.589, "timestamp": "00:59:03", "text": "他们每天会进行三场直播。 所以，从早上6点"}, {"type": "subtitle", "time": 3546.39, "timestamp": "00:59:06", "text": "到下午6点。"}, {"type": "subtitle", "time": 3549.67, "timestamp": "00:59:09", "text": "这是其中一条线索。 下午6:00 至"}, {"type": "subtitle", "time": 3552.63, "timestamp": "00:59:12", "text": "次日早上6点。 第二条溪流，类似"}, {"type": "subtitle", "time": 3555.109, "timestamp": "00:59:15", "text": "夜间溪流。 好的。 我也做了同样的事"}, {"type": "subtitle", "time": 3557.67, "timestamp": "00:59:17", "text": "，对吧？"}, {"type": "subtitle", "time": 3560.23, "timestamp": "00:59:20", "text": "我这么做也是因为 YouTube 有"}, {"type": "subtitle", "time": 3562.87, "timestamp": "00:59:22", "text": "11 小时 45 分钟的"}, {"type": "subtitle", "time": 3567.19, "timestamp": "00:59:27", "text": "限制，对吧？ 不能再往后退了吧"}, {"type": "subtitle", "time": 3569.03, "timestamp": "00:59:29", "text": "？"}, {"type": "subtitle", "time": 3573.67, "timestamp": "00:59:33", "text": "从下午 6 点开始，他们的睡眠流。   从"}, {"type": "subtitle", "time": 3577.589, "timestamp": "00:59:37", "text": "下午6点开始。  GST，他们跟退伍军人事务部合作，"}, {"type": "subtitle", "time": 3583.349, "timestamp": "00:59:43", "text": "对吧？ 那么，我当时是怎么做的呢？ 在"}, {"type": "subtitle", "time": 3585.67, "timestamp": "00:59:45", "text": "Joathon 直播期间，我就会想：“对，"}, {"type": "subtitle", "time": 3588.71, "timestamp": "00:59:48", "text": "Joathon 直播。我会直播任何内容。一切都很"}, {"type": "subtitle", "time": 3591.829, "timestamp": "00:59:51", "text": "随意。我没有准备。” 所以它"}, {"type": "subtitle", "time": 3596.309, "timestamp": "00:59:56", "text": "没有被分类，对吧？  [嗤笑]"}, {"type": "subtitle", "time": 3599.67, "timestamp": "00:59:59", "text": "但就这位虚拟主播而言，她的分类已经完全"}]
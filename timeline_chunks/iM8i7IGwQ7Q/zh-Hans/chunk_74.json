[{"type": "subtitle", "time": 4444.39, "timestamp": "01:14:04", "text": "他也有点预感，结果证明他是对的。"}, {"type": "subtitle", "time": 4447.99, "timestamp": "01:14:07", "text": "你玩瓦勒兰德吗？我以前玩过，但我已经很久没"}, {"type": "subtitle", "time": 4450.149, "timestamp": "01:14:10", "text": "玩了，"}, {"type": "subtitle", "time": 4452.39, "timestamp": "01:14:12", "text": "每天玩40分钟。 是啊，我的"}, {"type": "subtitle", "time": 4454.87, "timestamp": "01:14:14", "text": "意思是，因为他们也根本"}, {"type": "subtitle", "time": 4457.35, "timestamp": "01:14:17", "text": "不在乎其他任何事情。"}, {"type": "subtitle", "time": 4463.59, "timestamp": "01:14:23", "text": "每天至少抽出30分钟，专门学习日语。"}, {"type": "subtitle", "time": 4465.91, "timestamp": "01:14:25", "text": "不需要像"}, {"type": "subtitle", "time": 4469.11, "timestamp": "01:14:29", "text": "你平时那样过度劳累、逼迫自己，比如"}, {"type": "subtitle", "time": 4472.381, "timestamp": "01:14:32", "text": "学习12个小时、18个小时什么的。"}, {"type": "subtitle", "time": 4474.95, "timestamp": "01:14:34", "text": "[嗤笑] 是啊。 所以我开始按照"}, {"type": "subtitle", "time": 4477.43, "timestamp": "01:14:37", "text": "他的建议至少坚持了30分钟。"}, {"type": "subtitle", "time": 4483.43, "timestamp": "01:14:43", "text": "现在用 Anki 和 Genki 2 教材。 所以我开始阅读那本书，"}, {"type": "subtitle", "time": 4486.149, "timestamp": "01:14:46", "text": "现在也在用 Anki 复习。"}, {"type": "subtitle", "time": 4490.229, "timestamp": "01:14:50", "text": "所以这现在多少有点帮助。"}, {"type": "subtitle", "time": 4493.91, "timestamp": "01:14:53", "text": "所以我开始不再过度"}]
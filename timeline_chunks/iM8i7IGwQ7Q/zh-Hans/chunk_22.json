[{"type": "subtitle", "time": 1320.47, "timestamp": "00:22:00", "text": "我就强迫自己直播。 我给自己定了个目标，每次"}, {"type": "subtitle", "time": 1323.43, "timestamp": "00:22:03", "text": "直播都要一点一点地用英语说点什么"}, {"type": "subtitle", "time": 1327.27, "timestamp": "00:22:07", "text": "。 现在我已经能完全"}, {"type": "subtitle", "time": 1330.63, "timestamp": "00:22:10", "text": "用英语交流了。 不。是的。"}, {"type": "subtitle", "time": 1333.43, "timestamp": "00:22:13", "text": "即使我的英语不好，"}, {"type": "subtitle", "time": 1336.71, "timestamp": "00:22:16", "text": "即使我的日语不好，我也会"}, {"type": "subtitle", "time": 1340.549, "timestamp": "00:22:20", "text": "继续练习、不断练习。"}, {"type": "subtitle", "time": 1342.47, "timestamp": "00:22:22", "text": "转述我的想法和正在"}, {"type": "subtitle", "time": 1344.549, "timestamp": "00:22:24", "text": "发生的事情。"}, {"type": "subtitle", "time": 1347.51, "timestamp": "00:22:27", "text": "是的，我应该多这样做。   这"}, {"type": "subtitle", "time": 1350.07, "timestamp": "00:22:30", "text": "也是练习日语的一种方法，"}, {"type": "subtitle", "time": 1353.909, "timestamp": "00:22:33", "text": "不只是练习对话之类的"}, {"type": "subtitle", "time": 1355.43, "timestamp": "00:22:35", "text": "。"}, {"type": "subtitle", "time": 1359.13, "timestamp": "00:22:39", "text": "我当时想把那件事做好。"}, {"type": "subtitle", "time": 1360.23, "timestamp": "00:22:40", "text": "[笑声]"}, {"type": "subtitle", "time": 1363.19, "timestamp": "00:22:43", "text": "所以，"}, {"type": "subtitle", "time": 1365.75, "timestamp": "00:22:45", "text": "所以D。"}, {"type": "subtitle", "time": 1367.59, "timestamp": "00:22:47", "text": "嗯，我今天心情很好。 我不知道"}, {"type": "subtitle", "time": 1374.149, "timestamp": "00:22:54", "text": "我当时怎么会"}, {"type": "subtitle", "time": 1376.23, "timestamp": "00:22:56", "text": "莫名其妙地感冒呢？"}, {"type": "subtitle", "time": 1379.669, "timestamp": "00:22:59", "text": "我碰巧感冒了。   这"}]
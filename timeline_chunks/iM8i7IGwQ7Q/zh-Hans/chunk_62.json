[{"type": "subtitle", "time": 3721.75, "timestamp": "01:02:01", "text": "我也曾有过那样的时光，那时我只属于"}, {"type": "subtitle", "time": 3725.109, "timestamp": "01:02:05", "text": "琼。 我当时正在看《时空之城》里的 Sou，"}, {"type": "subtitle", "time": 3729.349, "timestamp": "01:02:09", "text": "还有另一个叫"}, {"type": "subtitle", "time": 3731.349, "timestamp": "01:02:11", "text": "Nemo"}, {"type": "subtitle", "time": 3738.87, "timestamp": "01:02:18", "text": "一个油管博主。 是的，我当时只关注"}, {"type": "subtitle", "time": 3741.27, "timestamp": "01:02:21", "text": "那两个人，因为他们在参加"}, {"type": "subtitle", "time": 3744.15, "timestamp": "01:02:24", "text": "马拉松比赛。 不，先解除一下子降级的限制"}, {"type": "subtitle", "time": 3746.63, "timestamp": "01:02:26", "text": "。"}, {"type": "subtitle", "time": 3748.63, "timestamp": "01:02:28", "text": "我应该事先了解一下如何进行"}, {"type": "subtitle", "time": 3750.95, "timestamp": "01:02:30", "text": "耐力直播。"}, {"type": "subtitle", "time": 3753.91, "timestamp": "01:02:33", "text": "我本来可以找到"}, {"type": "subtitle", "time": 3756.63, "timestamp": "01:02:36", "text": "很多已经做过类似"}, {"type": "subtitle", "time": 3758.23, "timestamp": "01:02:38", "text": "事情的频道。"}, {"type": "subtitle", "time": 3761.99, "timestamp": "01:02:41", "text": "我不喜欢最终结果。 是的，"}, {"type": "subtitle", "time": 3765.109, "timestamp": "01:02:45", "text": "对我来说，我会这么做，因为我"}, {"type": "subtitle", "time": 3768.15, "timestamp": "01:02:48", "text": "觉得这样更方便。 不，我只会在"}, {"type": "subtitle", "time": 3771.03, "timestamp": "01:02:51", "text": "一切都完美之后才做。 所以我不用"}, {"type": "subtitle", "time": 3772.95, "timestamp": "01:02:52", "text": "担心。 我可以专注"}, {"type": "subtitle", "time": 3775.75, "timestamp": "01:02:55", "text": "于自己的事情。"}, {"type": "subtitle", "time": 3777.589, "timestamp": "01:02:57", "text": "好的。"}]
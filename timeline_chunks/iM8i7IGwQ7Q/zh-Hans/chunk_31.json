[{"type": "subtitle", "time": 1862.07, "timestamp": "00:31:02", "text": "去日本之前，我想做点什么。 所以我一直在"}, {"type": "subtitle", "time": 1863.99, "timestamp": "00:31:03", "text": "想，"}, {"type": "subtitle", "time": 1878.789, "timestamp": "00:31:18", "text": "。 所以这就是"}, {"type": "subtitle", "time": 1881.11, "timestamp": "00:31:21", "text": "这场战争的唯一逻辑。   是的"}, {"type": "subtitle", "time": 1885.83, "timestamp": "00:31:25", "text": "。 是的。 我知道这种 24 小时"}, {"type": "subtitle", "time": 1889.029, "timestamp": "00:31:29", "text": "全天候频道只适合像我这样的"}, {"type": "subtitle", "time": 1892.389, "timestamp": "00:31:32", "text": "大"}, {"type": "subtitle", "time": 1893.99, "timestamp": "00:31:33", "text": "创作者，"}, {"type": "subtitle", "time": 1896.87, "timestamp": "00:31:36", "text": "而不适合像我这样的小创作者"}, {"type": "subtitle", "time": 1898.87, "timestamp": "00:31:38", "text": "。 我只是想做个实验。 我"}, {"type": "subtitle", "time": 1901.35, "timestamp": "00:31:41", "text": "知道现在还为时过早，但我只是想先把它"}, {"type": "subtitle", "time": 1904.63, "timestamp": "00:31:44", "text": "做出来，这样"}, {"type": "subtitle", "time": 1907.509, "timestamp": "00:31:47", "text": "在遥远的未来，当"}, {"type": "subtitle", "time": 1910.646, "timestamp": "00:31:50", "text": "有人使用它的时候，我才能对其进行修改或升级。"}, {"type": "subtitle", "time": 1911.43, "timestamp": "00:31:51", "text": "[笑声和喘息声]"}, {"type": "subtitle", "time": 1913.909, "timestamp": "00:31:53", "text": "我觉得我现在有个坏习惯，就是"}, {"type": "subtitle", "time": 1915.83, "timestamp": "00:31:55", "text": "有时候，"}, {"type": "subtitle", "time": 1917.59, "timestamp": "00:31:57", "text": "嗯，"}]
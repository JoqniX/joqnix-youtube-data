[{"type": "subtitle", "time": 1141.11, "timestamp": "00:19:01", "text": "他们去年举办的单人现场演出，"}, {"type": "subtitle", "time": 1143.75, "timestamp": "00:19:03", "text": "今天可以在 YouTube 上免费观看"}, {"type": "subtitle", "time": 1146.31, "timestamp": "00:19:06", "text": "首映。 于是，我一边看着，一边"}, {"type": "subtitle", "time": 1149.19, "timestamp": "00:19:09", "text": "思考。"}, {"type": "subtitle", "time": 1151.909, "timestamp": "00:19:11", "text": "老兄，我也想做一场 YouTuber"}, {"type": "subtitle", "time": 1156.87, "timestamp": "00:19:16", "text": "演唱会直播。 不。嗯，所以我查了一下"}, {"type": "subtitle", "time": 1161.029, "timestamp": "00:19:21", "text": "。 呃，不过我好像可以和"}, {"type": "subtitle", "time": 1166.47, "timestamp": "00:19:26", "text": "吴一起做。 嗯，我很好奇想"}, {"type": "subtitle", "time": 1170.63, "timestamp": "00:19:30", "text": "尝试一下。"}, {"type": "subtitle", "time": 1172.63, "timestamp": "00:19:32", "text": "是的，我有点好奇该怎么做，也想知道"}, {"type": "subtitle", "time": 1175.43, "timestamp": "00:19:35", "text": "我是否能做到，以及所有的一切，"}, {"type": "subtitle", "time": 1179.909, "timestamp": "00:19:39", "text": "比如摄像机切换和所有"}, {"type": "subtitle", "time": 1182.549, "timestamp": "00:19:42", "text": "这些现在[笑]"}, {"type": "subtitle", "time": 1185.59, "timestamp": "00:19:45", "text": "舞台等等。 如果我能"}, {"type": "subtitle", "time": 1187.75, "timestamp": "00:19:47", "text": "尝试投入其中，尝试做点什么，"}, {"type": "subtitle", "time": 1191.51, "timestamp": "00:19:51", "text": "我想我有"}, {"type": "subtitle", "time": 1194.789, "timestamp": "00:19:54", "text": "一天就会有信心真正准备一整套作品了。"}, {"type": "subtitle", "time": 1197.27, "timestamp": "00:19:57", "text": "合适的配置。 不"}, {"type": "subtitle", "time": 1199.99, "timestamp": "00:19:59", "text": "，我需要稍微学习一下虚幻引擎"}]
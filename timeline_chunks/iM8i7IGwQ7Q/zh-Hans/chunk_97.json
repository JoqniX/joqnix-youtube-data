[{"type": "subtitle", "time": 5825.91, "timestamp": "01:37:05", "text": "他们看了。 现在我一直"}, {"type": "subtitle", "time": 5829.109, "timestamp": "01:37:09", "text": "想买《Arc Raiders》，但最近我"}, {"type": "subtitle", "time": 5831.189, "timestamp": "01:37:11", "text": "看到每个主播都很"}, {"type": "subtitle", "time": 5844.149, "timestamp": "01:37:24", "text": "游戏发布以来，他们每天都投入超过 100 个小时，现在游戏要重置了，"}, {"type": "subtitle", "time": 5846.31, "timestamp": "01:37:26", "text": "他们不得不重新开始"}, {"type": "subtitle", "time": 5849.83, "timestamp": "01:37:29", "text": "。 所有那些东西，对吧？"}, {"type": "subtitle", "time": 5852.39, "timestamp": "01:37:32", "text": "如果你有朋友和队友"}, {"type": "subtitle", "time": 5856.31, "timestamp": "01:37:36", "text": "一起去打副本什么的，那会很有趣；但"}, {"type": "subtitle", "time": 5858.229, "timestamp": "01:37:38", "text": "如果你一个人"}, {"type": "subtitle", "time": 5860.709, "timestamp": "01:37:40", "text": "去打，那就没什么意思了。"}, {"type": "subtitle", "time": 5864.149, "timestamp": "01:37:44", "text": "我注意到的就是这一点。"}, {"type": "subtitle", "time": 5866.709, "timestamp": "01:37:46", "text": "无论是"}, {"type": "subtitle", "time": 5868.87, "timestamp": "01:37:48", "text": "其他游戏，多人射击"}, {"type": "subtitle", "time": 5871.109, "timestamp": "01:37:51", "text": "游戏等等，特别是像"}, {"type": "subtitle", "time": 5872.79, "timestamp": "01:37:52", "text": "Valler、"}, {"type": "subtitle", "time": 5875.109, "timestamp": "01:37:55", "text": "Fortnite之类的FPS游戏，"}, {"type": "subtitle", "time": 5877.35, "timestamp": "01:37:57", "text": "你都需要"}]
[{"type": "subtitle", "time": 780.71, "timestamp": "00:13:00", "text": "。 现在我无法用手机"}, {"type": "subtitle", "time": 783.11, "timestamp": "00:13:03", "text": "开机了。  VCON 区域无法正常"}, {"type": "subtitle", "time": 786.15, "timestamp": "00:13:06", "text": "工作。"}, {"type": "subtitle", "time": 789.35, "timestamp": "00:13:09", "text": "如果Wi-Fi路由器关机了，"}, {"type": "subtitle", "time": 792.47, "timestamp": "00:13:12", "text": "对吧？ 然后重新启动。 所以我必须"}, {"type": "subtitle", "time": 795.75, "timestamp": "00:13:15", "text": "手动上前去把它打开。"}, {"type": "subtitle", "time": 800.47, "timestamp": "00:13:20", "text": "所以，是的"}, {"type": "subtitle", "time": 803.75, "timestamp": "00:13:23", "text": "。 所以，之前我们的"}, {"type": "subtitle", "time": 806.79, "timestamp": "00:13:26", "text": "直播出现了很大的延迟，是因为我现在用的是"}, {"type": "subtitle", "time": 809.509, "timestamp": "00:13:29", "text": "另一个 OBS 版本。 不，我"}, {"type": "subtitle", "time": 811.35, "timestamp": "00:13:31", "text": "用的是 Mel 作为主流语言。 是的，我当时是"}, {"type": "subtitle", "time": 818.31, "timestamp": "00:13:38", "text": "用 OBS 进行 24 小时直播的。"}, {"type": "subtitle", "time": 822.31, "timestamp": "00:13:42", "text": "所以，是的，现在我的网络资源"}, {"type": "subtitle", "time": 826.609, "timestamp": "00:13:46", "text": "不足以流畅播放这个视频。 哦，"}, {"type": "subtitle", "time": 828.15, "timestamp": "00:13:48", "text": "（笑）没关系。 我会想办法的"}, {"type": "subtitle", "time": 829.99, "timestamp": "00:13:49", "text": "。"}, {"type": "subtitle", "time": 832.15, "timestamp": "00:13:52", "text": "是的，有人"}, {"type": "subtitle", "time": 833.59, "timestamp": "00:13:53", "text": "提到你"}]
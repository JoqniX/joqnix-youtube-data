[{"type": "subtitle", "time": 3183.03, "timestamp": "00:53:03", "text": "视频。 嗯，是的，阿斯敏"}, {"type": "subtitle", "time": 3185.43, "timestamp": "00:53:05", "text": "经常这样做。 不，昨天他在"}, {"type": "subtitle", "time": 3188.95, "timestamp": "00:53:08", "text": "直播里说他"}, {"type": "subtitle", "time": 3192.79, "timestamp": "00:53:12", "text": "不想开摄像头直播某些游戏之类的"}, {"type": "subtitle", "time": 3195.27, "timestamp": "00:53:15", "text": "。 他"}, {"type": "subtitle", "time": 3197.589, "timestamp": "00:53:17", "text": "喜欢关掉摄像头，"}, {"type": "subtitle", "time": 3202.069, "timestamp": "00:53:22", "text": "玩游戏什么的，即使是在"}, {"type": "subtitle", "time": 3204.63, "timestamp": "00:53:24", "text": "直播的时候也一样。"}, {"type": "subtitle", "time": 3207.829, "timestamp": "00:53:27", "text": "我当时在想，他可以"}, {"type": "subtitle", "time": 3211.03, "timestamp": "00:53:31", "text": "写歌词，然后就那样写。"}, {"type": "subtitle", "time": 3214.15, "timestamp": "00:53:34", "text": "我要求提供更多能够"}, {"type": "subtitle", "time": 3220.309, "timestamp": "00:53:40", "text": "展示这个内容的 React 素材。"}, {"type": "subtitle", "time": 3223.829, "timestamp": "00:53:43", "text": "我不知道我刚才"}, {"type": "subtitle", "time": 3226.069, "timestamp": "00:53:46", "text": "说的关于Asan Gold的事情是不是真的，就像他"}, {"type": "subtitle", "time": 3232.549, "timestamp": "00:53:52", "text": "玩游戏时喜欢不露脸、不开摄像头直播一样。 我不知道"}, {"type": "subtitle", "time": 3235.109, "timestamp": "00:53:55", "text": "那段视频或片段会不会"}, {"type": "subtitle", "time": 3238.71, "timestamp": "00:53:58", "text": "像他的剪辑师制作的那样发布到他的社交媒体上"}]
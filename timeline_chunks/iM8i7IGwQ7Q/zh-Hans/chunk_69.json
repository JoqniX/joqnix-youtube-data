[{"type": "subtitle", "time": 4143.91, "timestamp": "01:09:03", "text": "逗人开心什么的，那会很难，对吧？"}, {"type": "subtitle", "time": 4148.789, "timestamp": "01:09:08", "text": "这也是我的担忧。 因为就"}, {"type": "subtitle", "time": 4151.43, "timestamp": "01:09:11", "text": "我的"}, {"type": "subtitle", "time": 4152.95, "timestamp": "01:09:12", "text": "情况而言，"}, {"type": "subtitle", "time": 4156.07, "timestamp": "01:09:16", "text": "我估计总共要花2000美元"}, {"type": "subtitle", "time": 4166.229, "timestamp": "01:09:26", "text": "等我能够做到的时候，我不想……我"}, {"type": "subtitle", "time": 4171.99, "timestamp": "01:09:31", "text": "希望我能……嗯……"}, {"type": "subtitle", "time": 4175.43, "timestamp": "01:09:35", "text": "我可以……是的。"}, {"type": "subtitle", "time": 4177.59, "timestamp": "01:09:37", "text": "即使我推出了新款车型，不，我"}, {"type": "subtitle", "time": 4179.11, "timestamp": "01:09:39", "text": "也不希望它失败。 这只是"}, {"type": "subtitle", "time": 4182.229, "timestamp": "01:09:42", "text": "一次性的事情。 是的。 你好，笨蛋"}, {"type": "subtitle", "time": 4183.749, "timestamp": "01:09:43", "text": "老爸。 欢迎光临。希望你一切都好"}, {"type": "subtitle", "time": 4186.229, "timestamp": "01:09:46", "text": "。 好久不见了。 谢谢你再次"}, {"type": "subtitle", "time": 4194.229, "timestamp": "01:09:54", "text": "就是我最担心的事。 比如说，"}, {"type": "subtitle", "time": 4197.35, "timestamp": "01:09:57", "text": "我刚刚首次公开展示了我的新狗。 不，我"}, {"type": "subtitle", "time": 4199.51, "timestamp": "01:09:59", "text": "不想"}]
[{"type": "subtitle", "time": 4380.47, "timestamp": "01:13:00", "text": "我当时超级焦虑，各种事情都乱了套，"}, {"type": "subtitle", "time": 4386.07, "timestamp": "01:13:06", "text": "然后"}, {"type": "subtitle", "time": 4389.27, "timestamp": "01:13:09", "text": "我的大脑就像被核弹炸了一样，我感到"}, {"type": "subtitle", "time": 4392.47, "timestamp": "01:13:12", "text": "压力巨大，还偏头痛，所有这些事情都"}, {"type": "subtitle", "time": 4395.35, "timestamp": "01:13:15", "text": "发生了，以至于我"}, {"type": "subtitle", "time": 4398.365, "timestamp": "01:13:18", "text": "什么都忘了。 我回到了原点。"}, {"type": "subtitle", "time": 4399.75, "timestamp": "01:13:19", "text": "[笑声]"}, {"type": "subtitle", "time": 4406.31, "timestamp": "01:13:26", "text": "顺便说一下，我当时每天在直播之外学习 18 个小时，阅读各种资料，尽"}, {"type": "subtitle", "time": 4409.99, "timestamp": "01:13:29", "text": "我所能，"}, {"type": "subtitle", "time": 4412.55, "timestamp": "01:13:32", "text": "然后突然就犯了偏头痛"}, {"type": "subtitle", "time": 4415.75, "timestamp": "01:13:35", "text": "。 我卧床不起。"}, {"type": "subtitle", "time": 4419.83, "timestamp": "01:13:39", "text": "我卧床一周。"}, {"type": "subtitle", "time": 4424.95, "timestamp": "01:13:44", "text": "我卧床不起的时候也去上过课，有那么一会儿，"}, {"type": "subtitle", "time": 4428.709, "timestamp": "01:13:48", "text": "我突然意识到，等等，我"}, {"type": "subtitle", "time": 4431.91, "timestamp": "01:13:51", "text": "不是学过这些吗？我怎么会"}, {"type": "subtitle", "time": 4435.27, "timestamp": "01:13:55", "text": "忘了呢？诸如此类的事情发生了。而且，我"}, {"type": "subtitle", "time": 4438.709, "timestamp": "01:13:58", "text": "感觉"}]
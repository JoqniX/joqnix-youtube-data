[{"type": "subtitle", "time": 3602.23, "timestamp": "01:00:02", "text": "确定了，"}, {"type": "subtitle", "time": 3603.91, "timestamp": "01:00:03", "text": "对吧？"}, {"type": "subtitle", "time": 3605.75, "timestamp": "01:00:05", "text": "也就是说，他们会在《尼尔："}, {"type": "subtitle", "time": 3608.87, "timestamp": "01:00:08", "text": "机械纪元》、《尼尔：塔尔科》或其他类似游戏附近进行游戏，"}, {"type": "subtitle", "time": 3611.589, "timestamp": "01:00:11", "text": "对吧？ 针对该特定流。 所以"}, {"type": "subtitle", "time": 3615.43, "timestamp": "01:00:15", "text": "他们做的就是把"}, {"type": "subtitle", "time": 3619.109, "timestamp": "01:00:19", "text": "他们要"}, {"type": "subtitle", "time": 3620.87, "timestamp": "01:00:20", "text": "直播的特定游戏内容的V字标志放上去，然后他们就去"}, {"type": "subtitle", "time": 3623.43, "timestamp": "01:00:23", "text": "睡觉了，对吧？ 所以人们可以监督"}, {"type": "subtitle", "time": 3626.87, "timestamp": "01:00:26", "text": "老年人的投票，对吧？ 而且由于"}, {"type": "subtitle", "time": 3630.696, "timestamp": "01:00:30", "text": "YouTube 嵌入方式和 API 的变化，"}, {"type": "subtitle", "time": 3632.95, "timestamp": "01:00:32", "text": "[嗤笑] 嗯，我认为他们可能"}, {"type": "subtitle", "time": 3635.349, "timestamp": "01:00:35", "text": "没有实现自动化或嵌入。 他们"}, {"type": "subtitle", "time": 3636.87, "timestamp": "01:00:36", "text": "只是"}, {"type": "subtitle", "time": 3639.03, "timestamp": "01:00:39", "text": "截取了浏览器窗口，"}, {"type": "subtitle", "time": 3641.109, "timestamp": "01:00:41", "text": "播放了他们频道里的 YouTube 视频，"}, {"type": "subtitle", "time": 3643.589, "timestamp": "01:00:43", "text": "然后把视频放到直播画面上，"}, {"type": "subtitle", "time": 3647.91, "timestamp": "01:00:47", "text": "对吧？ 是的。 就我而言，我现在已经实现了"}, {"type": "subtitle", "time": 3649.692, "timestamp": "01:00:49", "text": "自动化，不是吗？"}, {"type": "subtitle", "time": 3650.069, "timestamp": "01:00:50", "text": "[笑声]"}, {"type": "subtitle", "time": 3652.549, "timestamp": "01:00:52", "text": "就像是随机播放的视频之类的"}, {"type": "subtitle", "time": 3654.47, "timestamp": "01:00:54", "text": "。"}, {"type": "subtitle", "time": 3657.829, "timestamp": "01:00:57", "text": "之后，在运动健将比赛结束后，当"}]
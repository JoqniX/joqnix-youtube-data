[{"type": "subtitle", "time": 5880.47, "timestamp": "01:38:00", "text": "一个好的小队，一个可以和你建立"}, {"type": "subtitle", "time": 5883.669, "timestamp": "01:38:03", "text": "良好关系和默契的人，"}, {"type": "subtitle", "time": 5887.35, "timestamp": "01:38:07", "text": "对吧？ 真不错。"}, {"type": "subtitle", "time": 5890.149, "timestamp": "01:38:10", "text": "然后我心里又想，好吧，我可以"}, {"type": "subtitle", "time": 5893.109, "timestamp": "01:38:13", "text": "尝试一些"}, {"type": "subtitle", "time": 5896.229, "timestamp": "01:38:16", "text": "实验，比如玩玩像《"}, {"type": "subtitle", "time": 5899.51, "timestamp": "01:38:19", "text": "辐射》"}, {"type": "subtitle", "time": 5904.39, "timestamp": "01:38:24", "text": "系列或者《生化危机》这样的单人游戏，听起来很"}, {"type": "subtitle", "time": 5906.149, "timestamp": "01:38:26", "text": "有趣，"}, {"type": "subtitle", "time": 5908.629, "timestamp": "01:38:28", "text": "但是太恐怖太吓人了，所以我可能就不玩了。"}, {"type": "subtitle", "time": 5912.709, "timestamp": "01:38:32", "text": "我不知道。 嗯，哦"}, {"type": "subtitle", "time": 5914.95, "timestamp": "01:38:34", "text": "，是的。 是的。 我一直对"}, {"type": "subtitle", "time": 5918.709, "timestamp": "01:38:38", "text": "这款游戏很好奇，比如剑术"}, {"type": "subtitle", "time": 5923.03, "timestamp": "01:38:43", "text": "游戏，还有那个白头男人的游戏。 嗯，《"}, {"type": "subtitle", "time": 5925.99, "timestamp": "01:38:45", "text": "鬼泣》。 对，是《鬼泣》。 我一直"}, {"type": "subtitle", "time": 5927.99, "timestamp": "01:38:47", "text": "对那款游戏很感兴趣"}, {"type": "subtitle", "time": 5937.189, "timestamp": "01:38:57", "text": "那游戏看起来很有趣。 我可以，我"}]
[{"type": "subtitle", "time": 1981.99, "timestamp": "00:33:01", "text": "娱乐技巧、你的声音，以及如何"}, {"type": "subtitle", "time": 1984.95, "timestamp": "00:33:04", "text": "吸引观众等等"}, {"type": "subtitle", "time": 1989.11, "timestamp": "00:33:09", "text": "这些核心技能。是的，我看到那个"}, {"type": "subtitle", "time": 1993.029, "timestamp": "00:33:13", "text": "帖子后就想，"}, {"type": "chat", "time": 1995.706, "timestamp": "00:33:15", "author": "@miko_chann.1", "avatar": "https://yt4.ggpht.com/pA1qKxvA6gJkJo5iacL6MoaaocqRqPaKMbOHlznwOHpCJPPZbIU3_GNZ4faHtUzgYCNGbiZs1w=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2Ak"}, {"type": "subtitle", "time": 1996.789, "timestamp": "00:33:16", "text": "某种程度上，我有一个"}, {"type": "subtitle", "time": 2001.35, "timestamp": "00:33:21", "text": "很想投资、测试并购买的模特，但"}, {"type": "subtitle", "time": 2003.669, "timestamp": "00:33:23", "text": "我现在因为"}, {"type": "subtitle", "time": 2005.909, "timestamp": "00:33:25", "text": "缺钱而无法做到。我现在应该"}, {"type": "subtitle", "time": 2008.95, "timestamp": "00:33:28", "text": "专注于提升我作为"}, {"type": "subtitle", "time": 2011.99, "timestamp": "00:33:31", "text": "内容创作者或主播的核心技能，比如"}, {"type": "subtitle", "time": 2016.47, "timestamp": "00:33:36", "text": "互动、说话等等。所以"}, {"type": "subtitle", "time": 2019.99, "timestamp": "00:33:39", "text": "基本上，我现在看起来就像个"}, {"type": "subtitle", "time": 2026.789, "timestamp": "00:33:46", "text": "所以我一直在思考这个问题，是啊，这就是"}, {"type": "subtitle", "time": 2031.823, "timestamp": "00:33:51", "text": "局限性吧。"}, {"type": "subtitle", "time": 2036.23, "timestamp": "00:33:56", "text": "[笑声和倒吸一口凉气] 所以，嗯，"}]
[{"type": "subtitle", "time": 3901.99, "timestamp": "01:05:01", "text": "我打喷嚏很厉害，"}, {"type": "subtitle", "time": 3905.19, "timestamp": "01:05:05", "text": "而且现在在印度之类的国家，"}, {"type": "subtitle", "time": 3909.43, "timestamp": "01:05:09", "text": "有Vix吸入器之类的东西，对吧？"}, {"type": "subtitle", "time": 3920.069, "timestamp": "01:05:20", "text": "我在日本的话，会不会有类似的东西。"}, {"type": "subtitle", "time": 3923.349, "timestamp": "01:05:23", "text": "老兄，我对Vix吸入器上瘾太严重了。"}, {"type": "subtitle", "time": 3934.71, "timestamp": "01:05:34", "text": "因为我只是想"}, {"type": "subtitle", "time": 3935.99, "timestamp": "01:05:35", "text": "和人聊聊天而已。 我当时并没有觉得自己在"}, {"type": "subtitle", "time": 3938.95, "timestamp": "01:05:38", "text": "表演什么的。"}, {"type": "subtitle", "time": 3944.39, "timestamp": "01:05:44", "text": "对我来说，表演这件事也是最近才发生的。 我开始那样想了"}, {"type": "subtitle", "time": 3948.63, "timestamp": "01:05:48", "text": "。 嗯，"}, {"type": "subtitle", "time": 3956.069, "timestamp": "01:05:56", "text": "我来说，我"}, {"type": "subtitle", "time": 3959.029, "timestamp": "01:05:59", "text": "现在必须认真对待这件事了。 我刚才就想了一下"}]
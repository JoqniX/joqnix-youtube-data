[{"type": "subtitle", "time": 661.91, "timestamp": "00:11:01", "text": "。 是的，"}, {"type": "subtitle", "time": 664.23, "timestamp": "00:11:04", "text": "我的计划是先在本地运行，然后"}, {"type": "subtitle", "time": 668.15, "timestamp": "00:11:08", "text": "如果"}, {"type": "subtitle", "time": 671.67, "timestamp": "00:11:11", "text": "大家都喜欢用，或者"}, {"type": "subtitle", "time": 674.47, "timestamp": "00:11:14", "text": "随着时间的推移，性能表现也令人满意，"}, {"type": "subtitle", "time": 677.11, "timestamp": "00:11:17", "text": "我就会投资"}, {"type": "subtitle", "time": 681.11, "timestamp": "00:11:21", "text": "云服务器之类的东西，"}, {"type": "subtitle", "time": 684.87, "timestamp": "00:11:24", "text": "这样它就能一直存在了"}, {"type": "subtitle", "time": 687.75, "timestamp": "00:11:27", "text": "。 不。是的，我知道"}, {"type": "subtitle", "time": 689.75, "timestamp": "00:11:29", "text": "对于像我这样的小创作者来说，现在做"}, {"type": "subtitle", "time": 692.79, "timestamp": "00:11:32", "text": "这件事还为时过早。 只是明年，也就是"}, {"type": "subtitle", "time": 694.949, "timestamp": "00:11:34", "text": "我现在在日本的时候，我就没法"}, {"type": "subtitle", "time": 697.59, "timestamp": "00:11:37", "text": "直播什么的了。 不，我会很难过的"}, {"type": "subtitle", "time": 700.949, "timestamp": "00:11:40", "text": "。 所以我想，好吧，我可以"}, {"type": "subtitle", "time": 705.03, "timestamp": "00:11:45", "text": "从日本远程控制我的电脑，也可以从印度远程控制我的电脑"}, {"type": "subtitle", "time": 707.43, "timestamp": "00:11:47", "text": "。 不，我可以用手机控制"}, {"type": "subtitle", "time": 710.79, "timestamp": "00:11:50", "text": "它。 如果我从我的电脑上24小时不间断地发送视频"}, {"type": "subtitle", "time": 712.79, "timestamp": "00:11:52", "text": "流呢？  [笑声]"}, {"type": "subtitle", "time": 715.99, "timestamp": "00:11:55", "text": "因为我不想我的电脑在我不用的时候就坏掉，"}, {"type": "subtitle", "time": 718.47, "timestamp": "00:11:58", "text": "你知道的。 我想"}]
[{"type": "subtitle", "time": 2460.87, "timestamp": "00:41:00", "text": "左边或右边"}, {"type": "subtitle", "time": 2463.27, "timestamp": "00:41:03", "text": "[笑]，这样在竖幅镜头中"}, {"type": "subtitle", "time": 2469.43, "timestamp": "00:41:09", "text": "人们才能看到我之类的。 哦，"}, {"type": "subtitle", "time": 2472.55, "timestamp": "00:41:12", "text": "那有点麻烦。 但没关系。 我们可以，我会"}, {"type": "subtitle", "time": 2476.79, "timestamp": "00:41:16", "text": "调整。 我们可以稍微调整一下"}, {"type": "subtitle", "time": 2478.95, "timestamp": "00:41:18", "text": "。"}, {"type": "subtitle", "time": 2487.67, "timestamp": "00:41:27", "text": "我最担心的是"}, {"type": "subtitle", "time": 2490.87, "timestamp": "00:41:30", "text": "资源问题。"}, {"type": "subtitle", "time": 2494.47, "timestamp": "00:41:34", "text": "我的直播间资源非常紧张，简直让人喘不过气来"}, {"type": "subtitle", "time": 2497.99, "timestamp": "00:41:37", "text": "。"}, {"type": "subtitle", "time": 2500.15, "timestamp": "00:41:40", "text": "所以我必须平衡一切，限制"}, {"type": "subtitle", "time": 2503.109, "timestamp": "00:41:43", "text": "一切，用这个那个来剔除一些东西"}, {"type": "subtitle", "time": 2505.589, "timestamp": "00:41:45", "text": "。   真是太让人"}, {"type": "subtitle", "time": 2508.069, "timestamp": "00:41:48", "text": "头疼了。 大家都在"}, {"type": "subtitle", "time": 2515.03, "timestamp": "00:41:55", "text": "麻烦了，"}]
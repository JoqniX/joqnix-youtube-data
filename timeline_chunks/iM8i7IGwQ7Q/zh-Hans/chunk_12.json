[{"type": "subtitle", "time": 721.19, "timestamp": "00:12:01", "text": "教我爸爸怎么"}, {"type": "subtitle", "time": 724.55, "timestamp": "00:12:04", "text": "开电脑，我打电话给他的时候他该怎么做，"}, {"type": "subtitle", "time": 727.59, "timestamp": "00:12:07", "text": "还有怎么清理"}, {"type": "subtitle", "time": 730.15, "timestamp": "00:12:10", "text": "电脑机箱之类的东西"}, {"type": "subtitle", "time": 732.15, "timestamp": "00:12:12", "text": "。 所以，关键是要"}, {"type": "subtitle", "time": 734.629, "timestamp": "00:12:14", "text": "维护得当。   是的"}, {"type": "subtitle", "time": 736.15, "timestamp": "00:12:16", "text": "。 是的。  [笑声]"}, {"type": "subtitle", "time": 740.23, "timestamp": "00:12:20", "text": "直到我用上了云服务器。 是的。"}, {"type": "subtitle", "time": 742.31, "timestamp": "00:12:22", "text": "所以，"}, {"type": "subtitle", "time": 745.91, "timestamp": "00:12:25", "text": "我试图在24小时内完成谈话。 啊，"}, {"type": "subtitle", "time": 747.91, "timestamp": "00:12:27", "text": "没关系。 这种事时有发生。 没关系。"}, {"type": "subtitle", "time": 756.31, "timestamp": "00:12:36", "text": "PC"}, {"type": "subtitle", "time": 760.79, "timestamp": "00:12:40", "text": "只能在"}, {"type": "subtitle", "time": 764.629, "timestamp": "00:12:44", "text": "印度境内使用，比如在我的"}, {"type": "subtitle", "time": 767.829, "timestamp": "00:12:47", "text": "房间里。 我会一直戴着它。 它一直开着。"}, {"type": "subtitle", "time": 769.91, "timestamp": "00:12:49", "text": "所以我就想，好吧，我就把它用在其他地方吧"}, {"type": "subtitle", "time": 777.35, "timestamp": "00:12:57", "text": "所以问题只出现在停电的时候"}]
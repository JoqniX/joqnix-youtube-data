[{"type": "subtitle", "time": 3002.87, "timestamp": "00:50:02", "text": "转发视频的人来说会是个好消息"}, {"type": "subtitle", "time": 3004.47, "timestamp": "00:50:04", "text": "。 现在你可以像调整"}, {"type": "subtitle", "time": 3011.91, "timestamp": "00:50:11", "text": "我韩国公寓里的竖框一样调整画面了。 它按照当时的建造方式建造，所以"}, {"type": "subtitle", "time": 3013.75, "timestamp": "00:50:13", "text": "在日本也应该类似"}, {"type": "subtitle", "time": 3029.51, "timestamp": "00:50:29", "text": "但说实话，我一直很"}, {"type": "subtitle", "time": 3032.71, "timestamp": "00:50:32", "text": "困惑该制作什么类型的视频，"}, {"type": "subtitle", "time": 3038.39, "timestamp": "00:50:38", "text": "我想做一些"}, {"type": "subtitle", "time": 3041.109, "timestamp": "00:50:41", "text": "真正的内容之类的，但我"}, {"type": "subtitle", "time": 3044.309, "timestamp": "00:50:44", "text": "觉得我不太擅长制作摩洛哥传统庭院住宅（riad）相关的内容。 会"}, {"type": "subtitle", "time": 3048.23, "timestamp": "00:50:48", "text": "有人看Riad的内容吗？"}, {"type": "subtitle", "time": 3056.87, "timestamp": "00:50:56", "text": "不妙。 我想我可能已经修好了"}, {"type": "subtitle", "time": 3058.549, "timestamp": "00:50:58", "text": "。"}]
[{"type": "subtitle", "time": 5825.91, "timestamp": "01:37:05", "text": "彼らに見せるには、あまりにも多くのことがありすぎる。 そして今、私は"}, {"type": "subtitle", "time": 5829.109, "timestamp": "01:37:09", "text": "Arc Raidersを購入したいと思っているのですが、最近は"}, {"type": "subtitle", "time": 5831.189, "timestamp": "01:37:11", "text": "どの配信者もイライラしているのを目にします。"}, {"type": "subtitle", "time": 5839.35, "timestamp": "01:37:19", "text": "彼らは"}, {"type": "subtitle", "time": 5844.149, "timestamp": "01:37:24", "text": "ゲームがリリースされてから毎日100時間以上プレイしているのに、"}, {"type": "subtitle", "time": 5846.31, "timestamp": "01:37:26", "text": "ワイプが行われてまた最初からやり直さなければならないからです"}, {"type": "subtitle", "time": 5849.83, "timestamp": "01:37:29", "text": "。 そういうこと全部ですよね？"}, {"type": "subtitle", "time": 5852.39, "timestamp": "01:37:32", "text": "友達や仲間とレイドに行ったりするのは楽しい"}, {"type": "subtitle", "time": 5856.31, "timestamp": "01:37:36", "text": "けど、一人でやるとなるとあまり"}, {"type": "subtitle", "time": 5858.229, "timestamp": "01:37:38", "text": "楽しくない"}, {"type": "subtitle", "time": 5860.709, "timestamp": "01:37:40", "text": "。"}, {"type": "subtitle", "time": 5864.149, "timestamp": "01:37:44", "text": "それが私が気づいた点です。"}, {"type": "subtitle", "time": 5868.87, "timestamp": "01:37:48", "text": "他のゲームでも、マルチプレイヤーシューティング"}, {"type": "subtitle", "time": 5871.109, "timestamp": "01:37:51", "text": "ゲームでも、特に"}, {"type": "subtitle", "time": 5872.79, "timestamp": "01:37:52", "text": "Valerや"}, {"type": "subtitle", "time": 5875.109, "timestamp": "01:37:55", "text": "FortniteのようなFPSゲームでも、"}]
[{"type": "subtitle", "time": 1320.47, "timestamp": "00:22:00", "text": "無理強いした。 私は、"}, {"type": "subtitle", "time": 1323.43, "timestamp": "00:22:03", "text": "配信のたびに少しずつ英語で何かを話すという目標を立てました"}, {"type": "subtitle", "time": 1327.27, "timestamp": "00:22:07", "text": "。 そして今では、完全に"}, {"type": "subtitle", "time": 1330.63, "timestamp": "00:22:10", "text": "英語で会話できるようになりました。 いいえ。ええ。 たとえ"}, {"type": "subtitle", "time": 1333.43, "timestamp": "00:22:13", "text": "私の英語が下手でも、たとえ"}, {"type": "subtitle", "time": 1336.71, "timestamp": "00:22:16", "text": "私の日本語が下手でも、私は"}, {"type": "subtitle", "time": 1340.549, "timestamp": "00:22:20", "text": "練習し続けるべきだ。"}, {"type": "subtitle", "time": 1342.47, "timestamp": "00:22:22", "text": "私の考えや現状を伝えています"}, {"type": "subtitle", "time": 1344.549, "timestamp": "00:22:24", "text": "。"}, {"type": "subtitle", "time": 1347.51, "timestamp": "00:22:27", "text": "うん、もっとそうするべきだね。   それも"}, {"type": "subtitle", "time": 1350.07, "timestamp": "00:22:30", "text": "また、会話などではなく、日本語を練習する一つの方法です"}, {"type": "subtitle", "time": 1355.43, "timestamp": "00:22:35", "text": "。"}, {"type": "subtitle", "time": 1359.13, "timestamp": "00:22:39", "text": "私はそれをうまくやろうと思った。"}, {"type": "subtitle", "time": 1360.23, "timestamp": "00:22:40", "text": "[笑い]"}, {"type": "subtitle", "time": 1363.19, "timestamp": "00:22:43", "text": "そうそう、"}, {"type": "subtitle", "time": 1365.75, "timestamp": "00:22:45", "text": "D。"}, {"type": "subtitle", "time": 1367.59, "timestamp": "00:22:47", "text": "今日は気分がいいよ。"}, {"type": "subtitle", "time": 1374.149, "timestamp": "00:22:54", "text": "自分が突然風邪を引いたなんて、知ってた"}, {"type": "subtitle", "time": 1376.23, "timestamp": "00:22:56", "text": "？   たまたま"}, {"type": "subtitle", "time": 1379.669, "timestamp": "00:22:59", "text": "風邪を引いてしまった。   それは"}]
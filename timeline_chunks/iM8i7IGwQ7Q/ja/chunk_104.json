[{"type": "subtitle", "time": 6245.91, "timestamp": "01:44:05", "text": "タレントショーのために、クロスオーバーのカバーみたいなものを録音することでしょう。 では、"}, {"type": "subtitle", "time": 6248.149, "timestamp": "01:44:08", "text": "なぜ彼らは"}, {"type": "subtitle", "time": 6253.669, "timestamp": "01:44:13", "text": "2Dで生活するために3Dモデルをあまり使用せず、Vドールで遊んだり"}, {"type": "subtitle", "time": 6260.31, "timestamp": "01:44:20", "text": "表示したりしないのでしょうか。 ステージを作ったり、"}, {"type": "subtitle", "time": 6262.79, "timestamp": "01:44:22", "text": "既製のステージを使ったりして、"}, {"type": "subtitle", "time": 6265.51, "timestamp": "01:44:25", "text": "カメラの照明とかカメラの部分とか"}, {"type": "subtitle", "time": 6268.229, "timestamp": "01:44:28", "text": "（鼻で笑う）とかエフェクトとか、そういうことを全部やるつもりだよ"}, {"type": "subtitle", "time": 6284.709, "timestamp": "01:44:44", "text": "うん、実際うまくいくはずだよ。 でも、"}, {"type": "subtitle", "time": 6288.149, "timestamp": "01:44:48", "text": "おそらく2D"}, {"type": "subtitle", "time": 6291.669, "timestamp": "01:44:51", "text": "画像をモデルとして使うことになるでしょうね。 それは"}, {"type": "subtitle", "time": 6295.75, "timestamp": "01:44:55", "text": "ちょっと難しいですね。 もしそれが"}]
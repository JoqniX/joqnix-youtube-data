[{"type": "subtitle", "time": 2880.309, "timestamp": "00:48:00", "text": "冬を感じないみたいだ。"}, {"type": "subtitle", "time": 2883.589, "timestamp": "00:48:03", "text": "時々、ここで汗をかく。 いつになったら"}, {"type": "subtitle", "time": 2893.91, "timestamp": "00:48:13", "text": "風が吹くことがあります"}, {"type": "subtitle", "time": 2897.088, "timestamp": "00:48:17", "text": "。"}, {"type": "subtitle", "time": 2904.23, "timestamp": "00:48:24", "text": "それなら、もっと温かい食べ物を食べる人とかを探さないといけないな"}, {"type": "subtitle", "time": 2915.43, "timestamp": "00:48:35", "text": "でも、正直言って、暖房のこととなるとすごく"}, {"type": "subtitle", "time": 2919.75, "timestamp": "00:48:39", "text": "ストレスが溜まるだろうなと思っています"}, {"type": "subtitle", "time": 2922.23, "timestamp": "00:48:42", "text": "。 ああ、それは"}]
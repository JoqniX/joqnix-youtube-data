[{"type": "subtitle", "time": 841.99, "timestamp": "00:14:01", "text": "PCのことではなく、特にスペックは"}, {"type": "subtitle", "time": 846.629, "timestamp": "00:14:06", "text": "かなり効率的な構成です。 ああ、そうですね、"}, {"type": "subtitle", "time": 852.629, "timestamp": "00:14:12", "text": "ブラウザで確認すれば"}, {"type": "subtitle", "time": 855.189, "timestamp": "00:14:15", "text": "動作します。"}, {"type": "subtitle", "time": 857.67, "timestamp": "00:14:17", "text": "この雪の結晶のアニメーションのせいで、"}, {"type": "subtitle", "time": 862.629, "timestamp": "00:14:22", "text": "私のPCは勝手にシャットダウンしてしまうようです。 あ、待って。"}, {"type": "subtitle", "time": 869.509, "timestamp": "00:14:29", "text": "長老たちの空は、それと比べて"}, {"type": "subtitle", "time": 872.55, "timestamp": "00:14:32", "text": "空高く舞い上がっているのだろうか？ ああ、わかりました。   わかった"}, {"type": "subtitle", "time": 875.91, "timestamp": "00:14:35", "text": "。 わかった。 それで、私の家では、以前は"}, {"type": "subtitle", "time": 894.47, "timestamp": "00:14:54", "text": "家賃が1万ドルから2万ドルくらいだったんです。というのも、私たちはまだ1戸建ての、何ていうか、電気都市みたいなところに住んでいたからです。それで、まず改装が終わってから、"}, {"type": "subtitle", "time": 897.59, "timestamp": "00:14:57", "text": "賃貸に出したんです。今は、片方の廊下には"}]
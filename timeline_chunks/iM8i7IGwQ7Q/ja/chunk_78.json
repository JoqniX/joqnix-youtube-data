[{"type": "subtitle", "time": 4680.07, "timestamp": "01:18:00", "text": "もうその人に連絡を取ることはできません。なぜなら、"}, {"type": "subtitle", "time": 4687.35, "timestamp": "01:18:07", "text": "私たちは関係を断ったからです。それで、許可という点で、それを使用しても大丈夫でしょうか。それは"}, {"type": "subtitle", "time": 4690.95, "timestamp": "01:18:10", "text": "贈り物だったのですが、それが報酬を"}, {"type": "subtitle", "time": 4696.709, "timestamp": "01:18:16", "text": "支払ったものであれば、所有権は私が持っています。私は"}, {"type": "subtitle", "time": 4700.95, "timestamp": "01:18:20", "text": "彼らに支払いを済ませましたし、すべて完了しています。"}, {"type": "subtitle", "time": 4711.75, "timestamp": "01:18:31", "text": "それで、最近Twitterで"}, {"type": "subtitle", "time": 4715.83, "timestamp": "01:18:35", "text": "Holiveみたいな"}, {"type": "subtitle", "time": 4721.189, "timestamp": "01:18:41", "text": "アーティストのドラマみたいなのを見たんだけど、"}, {"type": "subtitle", "time": 4727.189, "timestamp": "01:18:47", "text": "アーティストによっては"}, {"type": "subtitle", "time": 4731.99, "timestamp": "01:18:51", "text": "自分のアートや"}, {"type": "subtitle", "time": 4734.63, "timestamp": "01:18:54", "text": "描いたキャラクターがどう"}, {"type": "subtitle", "time": 4739.03, "timestamp": "01:18:59", "text": "振る舞うべきかについて特定の解釈を持っているみたいで、ちょっと変な感じだった。 だから、あの"}]
[{"type": "subtitle", "time": 6006.39, "timestamp": "01:40:06", "text": "ゲームアワードみたいなリアクション動画を作れるかもしれない"}, {"type": "subtitle", "time": 6012.55, "timestamp": "01:40:12", "text": "けど、ライセンスの問題が心配なんだ"}, {"type": "subtitle", "time": 6015.27, "timestamp": "01:40:15", "text": "。 例えば、著作権は取得できるのでしょうか？"}, {"type": "subtitle", "time": 6018.95, "timestamp": "01:40:18", "text": "一緒に見ても大丈夫ですか？ 正しいやり方とか、そういうことを気にしないのは悪いことでしょうか"}, {"type": "subtitle", "time": 6029.27, "timestamp": "01:40:29", "text": "ええ、その点については心配しています"}, {"type": "subtitle", "time": 6056.07, "timestamp": "01:40:56", "text": "ああ、なんてことだ、私の携帯電話が外れてしまった。"}]
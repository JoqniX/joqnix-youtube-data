[{"type": "subtitle", "time": 1445.029, "timestamp": "00:24:05", "text": "インセンティブ、ストリームなど、いろいろ設定したかったんです。"}, {"type": "subtitle", "time": 1447.556, "timestamp": "00:24:07", "text": "でも、あー"}, {"type": "subtitle", "time": 1448.31, "timestamp": "00:24:08", "text": "[笑い]"}, {"type": "subtitle", "time": 1451.11, "timestamp": "00:24:11", "text": "疲れてないよ。"}, {"type": "subtitle", "time": 1454.71, "timestamp": "00:24:14", "text": "正直なところ、最近は"}, {"type": "subtitle", "time": 1462.87, "timestamp": "00:24:22", "text": "クリエイターとして何をすべきか、とても迷っています。 わからない。 私の中にはすごく混乱している部分があって、"}, {"type": "subtitle", "time": 1471.59, "timestamp": "00:24:31", "text": "以前はゲーム配信とかやってたけど、"}, {"type": "subtitle", "time": 1473.83, "timestamp": "00:24:33", "text": "クリエイティブなこともするのが好きなんです。"}, {"type": "subtitle", "time": 1476.47, "timestamp": "00:24:36", "text": "両方をバランスよく両立させ、"}, {"type": "subtitle", "time": 1478.95, "timestamp": "00:24:38", "text": "より興味深いものにするにはどうすれば良いでしょうか？"}, {"type": "subtitle", "time": 1491.51, "timestamp": "00:24:51", "text": "断続的で、どう"}, {"type": "subtitle", "time": 1494.549, "timestamp": "00:24:54", "text": "言えばいいのかよくわからない。"}, {"type": "subtitle", "time": 1497.43, "timestamp": "00:24:57", "text": "もっと色々なことをしたいのですが、"}]
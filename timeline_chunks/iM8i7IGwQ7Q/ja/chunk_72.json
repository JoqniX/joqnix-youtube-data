[{"type": "subtitle", "time": 4332.31, "timestamp": "01:12:12", "text": "最近はすごく燃え尽きていたんです。というのも、"}, {"type": "subtitle", "time": 4340.39, "timestamp": "01:12:20", "text": "日本の勉強に集中しすぎて準備が間に合わなかったり、いろいろとストレスが溜まって、しばらく配信できなかったからです"}, {"type": "subtitle", "time": 4346.149, "timestamp": "01:12:26", "text": "。 だから、"}, {"type": "subtitle", "time": 4369.03, "timestamp": "01:12:49", "text": "ストレスが生じた。"}, {"type": "subtitle", "time": 4371.75, "timestamp": "01:12:51", "text": "ストレスはその後に起こった。"}, {"type": "subtitle", "time": 4376.149, "timestamp": "01:12:56", "text": "うん、ストレスが起こった。"}, {"type": "subtitle", "time": 4378.149, "timestamp": "01:12:58", "text": "私の場合もそうでした。"}]
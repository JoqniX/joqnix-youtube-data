[{"type": "subtitle", "time": 3661.589, "timestamp": "01:01:01", "text": "ストリーミングに戻ってきたとき、えーと、その時に"}, {"type": "subtitle", "time": 3665.829, "timestamp": "01:01:05", "text": "カテゴリー別の"}, {"type": "subtitle", "time": 3669.51, "timestamp": "01:01:09", "text": "賞を作ったんだよね？ 分類された"}, {"type": "subtitle", "time": 3673.589, "timestamp": "01:01:13", "text": "Wタイプのものですよね？ うん。"}, {"type": "subtitle", "time": 3675.91, "timestamp": "01:01:15", "text": "そして、私がオフラインのときは、あの"}, {"type": "subtitle", "time": 3680.47, "timestamp": "01:01:20", "text": "ランダムな曲が再生されます。 それはまさに"}, {"type": "subtitle", "time": 3682.47, "timestamp": "01:01:22", "text": "私がやりそうなことだ。  [笑い]"}, {"type": "subtitle", "time": 3685.109, "timestamp": "01:01:25", "text": "ええ。 つまり、あの時は知らなかったんです。"}, {"type": "subtitle", "time": 3688.39, "timestamp": "01:01:28", "text": "いや、"}, {"type": "subtitle", "time": 3695.67, "timestamp": "01:01:35", "text": "僕がジョックマラソンをやっていた時は、参考にできる資料はあまりなかったよね？ もし"}, {"type": "subtitle", "time": 3697.829, "timestamp": "01:01:37", "text": "参考になるもの、"}, {"type": "subtitle", "time": 3700.15, "timestamp": "01:01:40", "text": "他のチャンネルが何をしているかを参考にできるものがあれば、"}, {"type": "subtitle", "time": 3701.67, "timestamp": "01:01:41", "text": "もちろん、"}, {"type": "subtitle", "time": 3704.47, "timestamp": "01:01:44", "text": "すべてを事前にスケジュールしていたでしょう。"}, {"type": "subtitle", "time": 3716.87, "timestamp": "01:01:56", "text": "私の尻なら、"}, {"type": "subtitle", "time": 3719.19, "timestamp": "01:01:59", "text": "私がやることの一つだ。"}]
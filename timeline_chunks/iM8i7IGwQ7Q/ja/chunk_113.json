[{"type": "subtitle", "time": 6783.03, "timestamp": "01:53:03", "text": "Web Studio に追加されました。Web"}, {"type": "subtitle", "time": 6789.99, "timestamp": "01:53:09", "text": "Studio のアップデートでたくさんの新しいことが起こります。私は本当に嬉しくて興奮しています"}, {"type": "subtitle", "time": 6792.39, "timestamp": "01:53:12", "text": "[鼻を鳴らす]。私も少し"}, {"type": "subtitle", "time": 6798.55, "timestamp": "01:53:18", "text": "コーディングを学んで、Web"}, {"type": "subtitle", "time": 6800.149, "timestamp": "01:53:20", "text": "サイト関連のことをすべてできるようにしたいと思っています"}, {"type": "subtitle", "time": 6802.79, "timestamp": "01:53:22", "text": "。 ただ、"}, {"type": "subtitle", "time": 6804.95, "timestamp": "01:53:24", "text": "最近はこういう創作活動をするとすごく"}, {"type": "subtitle", "time": 6807.109, "timestamp": "01:53:27", "text": "時間がかかってしまうんです（鼻を鳴らす）。"}, {"type": "subtitle", "time": 6820.95, "timestamp": "01:53:40", "text": "こんにちは。 とにかく、もうすぐ時間だ。"}, {"type": "subtitle", "time": 6823.858, "timestamp": "01:53:43", "text": "どれくらい続くか見てみましょう"}, {"type": "subtitle", "time": 6825.109, "timestamp": "01:53:45", "text": "（鼻を鳴らす）。"}, {"type": "subtitle", "time": 6829.27, "timestamp": "01:53:49", "text": "そして、実際に終わりにします。 わかった。"}, {"type": "subtitle", "time": 6832.95, "timestamp": "01:53:52", "text": "今日はとても楽しい一日でした。"}, {"type": "subtitle", "time": 6835.03, "timestamp": "01:53:55", "text": "H 1時間58分以上。 よし、あと2"}, {"type": "subtitle", "time": 6837.189, "timestamp": "01:53:57", "text": "分だ。"}]
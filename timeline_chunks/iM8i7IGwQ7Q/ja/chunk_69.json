[{"type": "subtitle", "time": 4143.91, "timestamp": "01:09:03", "text": "楽しませることができないと、それは難しいでしょうね？   私も同じことを"}, {"type": "subtitle", "time": 4148.789, "timestamp": "01:09:08", "text": "恐れています。"}, {"type": "subtitle", "time": 4151.43, "timestamp": "01:09:11", "text": "私の"}, {"type": "subtitle", "time": 4152.95, "timestamp": "01:09:12", "text": "場合は、"}, {"type": "subtitle", "time": 4166.229, "timestamp": "01:09:26", "text": "そして、それができる日が来たら、私は、ええと、私が"}, {"type": "subtitle", "time": 4175.43, "timestamp": "01:09:35", "text": "それを「うん」という方法で与えることができるような場所にそれを置きたいとは思いません。"}, {"type": "subtitle", "time": 4177.59, "timestamp": "01:09:37", "text": "たとえ新型モデルを発表したとしても、"}, {"type": "subtitle", "time": 4179.11, "timestamp": "01:09:39", "text": "失敗は絶対に避けたい。 これは"}, {"type": "subtitle", "time": 4182.229, "timestamp": "01:09:42", "text": "一度限りのことです。 うん。 こんにちは、バカな"}, {"type": "subtitle", "time": 4183.749, "timestamp": "01:09:43", "text": "パパ。 ようこそ。お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 4186.229, "timestamp": "01:09:46", "text": "。 久しぶりですね。 またお越しいただきありがとうございます"}, {"type": "subtitle", "time": 4194.229, "timestamp": "01:09:54", "text": "私の最大の恐怖です。 例えば、"}, {"type": "subtitle", "time": 4197.35, "timestamp": "01:09:57", "text": "私が新しい犬をデビューさせたとしましょう。 いや、"}]
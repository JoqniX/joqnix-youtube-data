[{"type": "subtitle", "time": 2283.67, "timestamp": "00:38:03", "text": "仮想ロボットのことは知らなかった。 それがいつ起こったのかを知ったのは、"}, {"type": "subtitle", "time": 2288.79, "timestamp": "00:38:08", "text": "YouTubeなどで何人かの人がそのことについて話しているのを見た時だけでした"}, {"type": "subtitle", "time": 2292.47, "timestamp": "00:38:12", "text": "。 うん。"}, {"type": "subtitle", "time": 2294.71, "timestamp": "00:38:14", "text": "私が知っているのは、"}, {"type": "subtitle", "time": 2298.39, "timestamp": "00:38:18", "text": "このゲームの賞とか、"}, {"type": "subtitle", "time": 2301.75, "timestamp": "00:38:21", "text": "Twitchのストリーマー賞みたいなものだけです。"}, {"type": "subtitle", "time": 2305.03, "timestamp": "00:38:25", "text": "Twitchの配信者表彰式みたいな番組"}, {"type": "subtitle", "time": 2307.27, "timestamp": "00:38:27", "text": "。"}, {"type": "subtitle", "time": 2309.43, "timestamp": "00:38:29", "text": "水を飲ませてください。 皆さん、"}, {"type": "subtitle", "time": 2313.43, "timestamp": "00:38:33", "text": "水分補給をお願いします。 水分補給をしていません。"}, {"type": "subtitle", "time": 2327.91, "timestamp": "00:38:47", "text": "ああ、60%の人が"}, {"type": "subtitle", "time": 2330.47, "timestamp": "00:38:50", "text": "私の配信を写真を通して知ったと投票してくれた。 え、本当に？"}, {"type": "subtitle", "time": 2333.349, "timestamp": "00:38:53", "text": "表示されるの？ 何？"}, {"type": "subtitle", "time": 2335.829, "timestamp": "00:38:55", "text": "待って、実際に私の配信が"}, {"type": "subtitle", "time": 2339.589, "timestamp": "00:38:59", "text": "映像に表示されるの？ え、何だって？"}]
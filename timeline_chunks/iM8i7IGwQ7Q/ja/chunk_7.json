[{"type": "subtitle", "time": 422.95, "timestamp": "00:07:02", "text": "YouTubeの新しいデュアルストリーム機能をテストしているので、 えっと、"}, {"type": "subtitle", "time": 425.909, "timestamp": "00:07:05", "text": "私の"}, {"type": "subtitle", "time": 428.95, "timestamp": "00:07:08", "text": "YouTubeストリームをショート動画で見たことがある方は、"}, {"type": "subtitle", "time": 431.909, "timestamp": "00:07:11", "text": "YouTubeのアンケートに投票してください。"}, {"type": "subtitle", "time": 435.35, "timestamp": "00:07:15", "text": "ああ、わかりました。今、その機能を手に入れました。"}, {"type": "subtitle", "time": 439.11, "timestamp": "00:07:19", "text": "ツイートしてよかったと思ったんだけど、どうなったと思う？"}, {"type": "subtitle", "time": 441.749, "timestamp": "00:07:21", "text": "ダッシュボードを開いたのですが、"}, {"type": "subtitle", "time": 445.43, "timestamp": "00:07:25", "text": "画像が表示されなくなりました。 私は「なぜ？」と思った。 そして、"}, {"type": "chat", "time": 445.523, "timestamp": "00:07:25", "author": "@kurunekodream", "avatar": "https://yt4.ggpht.com/RLzqgZjl8ILhIIU27ghgxtcyxaMDaQ4nJQ8GzPmDKVVI7HHPJUZsDQV_Itc49vlXGx8THQhiP90=s64-c-k-c0x00ffffff-no-rj", "message": "did potata left"}, {"type": "subtitle", "time": 447.909, "timestamp": "00:07:27", "text": "画像が元に戻りました。"}, {"type": "subtitle", "time": 450.629, "timestamp": "00:07:30", "text": "「よし、配信しよう」と思ったんです。"}, {"type": "chat", "time": 453.974, "timestamp": "00:07:33", "author": "@kurunekodream", "avatar": "https://yt4.ggpht.com/RLzqgZjl8ILhIIU27ghgxtcyxaMDaQ4nJQ8GzPmDKVVI7HHPJUZsDQV_Itc49vlXGx8THQhiP90=s64-c-k-c0x00ffffff-no-rj", "message": "come back potata"}, {"type": "subtitle", "time": 454.15, "timestamp": "00:07:34", "text": "そして、私は配信を始めた。"}, {"type": "subtitle", "time": 455.99, "timestamp": "00:07:35", "text": "こんにちは。"}, {"type": "subtitle", "time": 458.95, "timestamp": "00:07:38", "text": "えっと、もしあなたが、なぜ"}, {"type": "subtitle", "time": 461.749, "timestamp": "00:07:41", "text": "最近私が配信していないのか疑問に思っていたとしたら？ いいえ、それは"}, {"type": "subtitle", "time": 465.35, "timestamp": "00:07:45", "text": "、えっと、すごくストレスが溜まっていたからです。 たぶん、"}, {"type": "subtitle", "time": 469.43, "timestamp": "00:07:49", "text": "私は、えっと、後退しないように最善を尽くしていたんだと思います"}, {"type": "subtitle", "time": 473.029, "timestamp": "00:07:53", "text": "。 だから、"}, {"type": "subtitle", "time": 479.51, "timestamp": "00:07:59", "text": "配信外で日本語の練習などを色々やってみたんです。 配信中にやりたかったのですが、"}]
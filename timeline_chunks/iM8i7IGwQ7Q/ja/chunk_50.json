[{"type": "subtitle", "time": 3002.87, "timestamp": "00:50:02", "text": "リチューブなどをしている人にとっては良いことになりそうです"}, {"type": "subtitle", "time": 3004.47, "timestamp": "00:50:04", "text": "。 これで、"}, {"type": "subtitle", "time": 3011.91, "timestamp": "00:50:11", "text": "私の韓国のアパートの垂直フレームを調整できるようになりました。 それは日本でも同様の方法で建設されたはずだ"}, {"type": "subtitle", "time": 3029.51, "timestamp": "00:50:29", "text": "、正直言って、"}, {"type": "subtitle", "time": 3032.71, "timestamp": "00:50:32", "text": "どんな動画を作ればいいのか分からなくて困っているんです。"}, {"type": "subtitle", "time": 3041.109, "timestamp": "00:50:41", "text": "リアルなコンテンツとか作りたいとは思うんですけど、"}, {"type": "subtitle", "time": 3044.309, "timestamp": "00:50:44", "text": "リアドのコンテンツは得意じゃないと思うんです。"}, {"type": "subtitle", "time": 3048.23, "timestamp": "00:50:48", "text": "人々はそもそもリアドのコンテンツを見るのだろうか？   ああ"}, {"type": "subtitle", "time": 3056.87, "timestamp": "00:50:56", "text": "。 直せたかもしれないと思う"}, {"type": "subtitle", "time": 3058.549, "timestamp": "00:50:58", "text": "。"}]
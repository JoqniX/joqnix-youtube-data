[{"type": "subtitle", "time": 4742.709, "timestamp": "01:19:02", "text": "ホロウデバイスRAが、"}, {"type": "subtitle", "time": 4748.07, "timestamp": "01:19:08", "text": "アーティストの"}, {"type": "subtitle", "time": 4752.07, "timestamp": "01:19:12", "text": "考えや意見に合わないことを言ったりしたりして、アーティストが"}, {"type": "subtitle", "time": 4754.79, "timestamp": "01:19:14", "text": "モデルを使わないようにとか、"}, {"type": "subtitle", "time": 4757.03, "timestamp": "01:19:17", "text": "変更するようにとか、カバーするようにとか、"}, {"type": "subtitle", "time": 4759.59, "timestamp": "01:19:19", "text": "法的問題が起きているようなことをした時、私は"}, {"type": "subtitle", "time": 4762.07, "timestamp": "01:19:22", "text": "ホロウライフとアーティストの両方からの発表を見て、これは"}, {"type": "subtitle", "time": 4767.03, "timestamp": "01:19:27", "text": "何だ？[息を呑む] これは何だ？"}, {"type": "subtitle", "time": 4769.75, "timestamp": "01:19:29", "text": "ルルの件はどうなっているんだ？"}, {"type": "subtitle", "time": 4774.87, "timestamp": "01:19:34", "text": "コミッションの料金を支払ったから、"}, {"type": "subtitle", "time": 4778.47, "timestamp": "01:19:38", "text": "権利はホロウライフかコミッション担当者に渡るんだろ？それとも"}, {"type": "subtitle", "time": 4790.47, "timestamp": "01:19:50", "text": "大丈夫、これで十分だと"}, {"type": "subtitle", "time": 4795.11, "timestamp": "01:19:55", "text": "思う。"}, {"type": "subtitle", "time": 4797.35, "timestamp": "01:19:57", "text": "新しいモデルは必要なかったから、今あるものを使うことにするよ。"}]
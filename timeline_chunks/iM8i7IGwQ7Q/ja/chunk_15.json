[{"type": "subtitle", "time": 901.189, "timestamp": "00:15:01", "text": "法律事務所があって、もう片方の廊下には、"}, {"type": "subtitle", "time": 907.03, "timestamp": "00:15:07", "text": "カーペットや段ボールの縫製"}, {"type": "subtitle", "time": 908.55, "timestamp": "00:15:08", "text": "工場みたいな人が住んでいます。"}, {"type": "subtitle", "time": 911.35, "timestamp": "00:15:11", "text": "つまり、今は3段階になっているということですね。 だから、今は権力の"}, {"type": "subtitle", "time": 916.15, "timestamp": "00:15:16", "text": "バランスが取れているんです（笑）。"}, {"type": "subtitle", "time": 922.71, "timestamp": "00:15:22", "text": "こんにちは、1つください。 美味しい飲み物をどうぞ。"}, {"type": "subtitle", "time": 931.829, "timestamp": "00:15:31", "text": "こんにちは。 明日も早く寝ないと"}, {"type": "subtitle", "time": 936.389, "timestamp": "00:15:36", "text": "。 どこかへ行かなければならない。"}, {"type": "subtitle", "time": 939.03, "timestamp": "00:15:39", "text": "つまり、"}, {"type": "subtitle", "time": 942.949, "timestamp": "00:15:42", "text": "1万ドルから4万ドルを引いたような感じですね。 聖なる。"}, {"type": "subtitle", "time": 945.269, "timestamp": "00:15:45", "text": "それはまるで工場を経営しているようなものだ"}, {"type": "subtitle", "time": 947.509, "timestamp": "00:15:47", "text": "。 いいえ。ええ。"}]
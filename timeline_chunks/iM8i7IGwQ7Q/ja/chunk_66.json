[{"type": "subtitle", "time": 3961.75, "timestamp": "01:06:01", "text": "。 わかった。"}, {"type": "subtitle", "time": 3963.91, "timestamp": "01:06:03", "text": "私が見ているYouTuberたちは、ただ"}, {"type": "subtitle", "time": 3965.91, "timestamp": "01:06:05", "text": "気軽に話しているだけなのか、それとも実際に"}, {"type": "subtitle", "time": 3968.63, "timestamp": "01:06:08", "text": "パフォーマンスをしているのだろうか？ 私が分析した人の中には"}, {"type": "subtitle", "time": 3973.51, "timestamp": "01:06:13", "text": "、"}, {"type": "subtitle", "time": 3976.789, "timestamp": "01:06:16", "text": "提供するコンテンツや、どのように"}, {"type": "subtitle", "time": 3981.91, "timestamp": "01:06:21", "text": "反応したり行動したりするかなど、本当に賢い人がいて、それによって"}, {"type": "subtitle", "time": 3985.67, "timestamp": "01:06:25", "text": "クリップや"}, {"type": "subtitle", "time": 3988.069, "timestamp": "01:06:28", "text": "視聴者などを獲得できるんです。"}, {"type": "subtitle", "time": 3990.15, "timestamp": "01:06:30", "text": "彼らは実際にパフォーマンスをしているのでしょうか、それともただ"}, {"type": "subtitle", "time": 4001.91, "timestamp": "01:06:41", "text": "ええと、それで"}, {"type": "subtitle", "time": 4004.23, "timestamp": "01:06:44", "text": "確認して見せたら、"}, {"type": "subtitle", "time": 4010.789, "timestamp": "01:06:50", "text": "ああ、そういう観点から彼を受け入れるべきだと気づいたんです"}]
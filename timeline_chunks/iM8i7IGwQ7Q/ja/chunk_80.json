[{"type": "subtitle", "time": 4800.229, "timestamp": "01:20:00", "text": "ええ、実際には、"}, {"type": "subtitle", "time": 4804.149, "timestamp": "01:20:04", "text": "新しいものを作る必要はなかったんです。 しかし、状況が"}, {"type": "subtitle", "time": 4808.63, "timestamp": "01:20:08", "text": "私をその立場に追い込んだのです。 いや、例えば、私が"}, {"type": "subtitle", "time": 4812.47, "timestamp": "01:20:12", "text": "エージェンシーに招待されたりして、"}, {"type": "subtitle", "time": 4815.35, "timestamp": "01:20:15", "text": "すべてがうまくいくことを願っていたんだけど、うまくいかなかったんだ"}, {"type": "subtitle", "time": 4818.95, "timestamp": "01:20:18", "text": "。 ああ（笑）"}, {"type": "subtitle", "time": 4821.91, "timestamp": "01:20:21", "text": "それが唯一の理由です。そうでなければ、私は自分が持っているものに"}, {"type": "subtitle", "time": 4824.149, "timestamp": "01:20:24", "text": "満足していたでしょう。 私は、何か"}, {"type": "subtitle", "time": 4830.39, "timestamp": "01:20:30", "text": "素晴らしいものを手に入れたいとか、そういうタイプの人間ではありません。 私は"}, {"type": "subtitle", "time": 4834.709, "timestamp": "01:20:34", "text": "ただ楽しむためにここに来ました。"}, {"type": "subtitle", "time": 4837.11, "timestamp": "01:20:37", "text": "素晴らしいものを見せてください。 その他のことは、"}, {"type": "subtitle", "time": 4839.43, "timestamp": "01:20:39", "text": "時間が経てば自然と身につく。"}, {"type": "subtitle", "time": 4841.43, "timestamp": "01:20:41", "text": "まあ、そういうものなんだけどね"}, {"type": "subtitle", "time": 4844.149, "timestamp": "01:20:44", "text": "。  [笑い]"}, {"type": "subtitle", "time": 4845.83, "timestamp": "01:20:45", "text": "それは、"}, {"type": "subtitle", "time": 4848.87, "timestamp": "01:20:48", "text": "誰かが一生懸命努力したんだな、と思った唯一の点でした。 だから私は「それこそまさにその理由だ」と思って、「"}, {"type": "subtitle", "time": 4856.215, "timestamp": "01:20:56", "text": "よし、これは大丈夫だ」と思ったんです。"}, {"type": "subtitle", "time": 4856.871, "timestamp": "01:20:56", "text": "[笑い]"}, {"type": "subtitle", "time": 4857.51, "timestamp": "01:20:57", "text": "[息を呑む]"}]
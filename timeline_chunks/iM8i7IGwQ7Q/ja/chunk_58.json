[{"type": "subtitle", "time": 3482.95, "timestamp": "00:58:02", "text": "YouTubeで"}, {"type": "subtitle", "time": 3486.47, "timestamp": "00:58:06", "text": "1000人になるまでいいねを押す耐久ストリームをYouTubeでやっています。 購読者。"}, {"type": "subtitle", "time": 3490.23, "timestamp": "00:58:10", "text": "それで、"}, {"type": "subtitle", "time": 3492.87, "timestamp": "00:58:12", "text": "チャンネルの内容を分析していたのですが、彼らは"}, {"type": "subtitle", "time": 3497.829, "timestamp": "00:58:17", "text": "24時間耐久"}, {"type": "subtitle", "time": 3499.91, "timestamp": "00:58:19", "text": "配信のようなものをやっているんですね。サバソンみたいなものですが、"}, {"type": "subtitle", "time": 3502.15, "timestamp": "00:58:22", "text": "サバソンではなく耐久"}, {"type": "subtitle", "time": 3504.87, "timestamp": "00:58:24", "text": "配信で、ライブ配信を続け、"}, {"type": "subtitle", "time": 3507.51, "timestamp": "00:58:27", "text": "ストリーミングを続けています。"}, {"type": "subtitle", "time": 3510.39, "timestamp": "00:58:30", "text": "そして、彼らは実際に私がやったのと同じことを、"}, {"type": "subtitle", "time": 3515.109, "timestamp": "00:58:35", "text": "より体系的にやっていました。"}, {"type": "subtitle", "time": 3519.19, "timestamp": "00:58:39", "text": "彼らは"}, {"type": "subtitle", "time": 3521.43, "timestamp": "00:58:41", "text": "他の"}, {"type": "subtitle", "time": 3523.589, "timestamp": "00:58:43", "text": "YouTuber、"}, {"type": "subtitle", "time": 3526.63, "timestamp": "00:58:46", "text": "他の日本のYouTuberとのコラボ配信でない限り、Twitchで配信はしません。"}, {"type": "subtitle", "time": 3529.75, "timestamp": "00:58:49", "text": "Twitchにもいる人たちです。 だから彼らは"}, {"type": "subtitle", "time": 3536.47, "timestamp": "00:58:56", "text": "YouTubeで配信するすべての配信を事前にスケジュールしていたんだ。例えば1か月分の配信、"}, {"type": "subtitle", "time": 3539.43, "timestamp": "00:58:59", "text": "30回分くらいとか。 そして、"}]
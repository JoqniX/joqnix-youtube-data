[{"type": "subtitle", "time": 5281.03, "timestamp": "01:28:01", "text": "それは"}, {"type": "subtitle", "time": 5283.59, "timestamp": "01:28:03", "text": "特にYouTube側にとって、とんでもない大失敗だった。"}, {"type": "subtitle", "time": 5289.83, "timestamp": "01:28:09", "text": "ジョックアソンみたいなことをする結果について、もっとちゃんと考えておくべきだった。"}, {"type": "subtitle", "time": 5293.59, "timestamp": "01:28:13", "text": "今ならもっとよくわかるから。"}, {"type": "subtitle", "time": 5299.669, "timestamp": "01:28:19", "text": "うん。 そうですね、ジョアソンの配信を除いて、"}, {"type": "subtitle", "time": 5301.75, "timestamp": "01:28:21", "text": "残りのすべては"}, {"type": "subtitle", "time": 5304.95, "timestamp": "01:28:24", "text": "YouTubeによって分類されています。"}, {"type": "subtitle", "time": 5310.95, "timestamp": "01:28:30", "text": "チャット配信とクリエイティブ配信のkok配信を除いて、"}, {"type": "subtitle", "time": 5315.99, "timestamp": "01:28:35", "text": "私の他のすべての"}, {"type": "subtitle", "time": 5317.91, "timestamp": "01:28:37", "text": "ゲームなどの配信コンテンツは、プレイリストなどに分類されています"}, {"type": "subtitle", "time": 5321.43, "timestamp": "01:28:41", "text": "。   姿を現す"}, {"type": "subtitle", "time": 5323.27, "timestamp": "01:28:43", "text": "。"}, {"type": "subtitle", "time": 5327.27, "timestamp": "01:28:47", "text": "だから問題は、えっと、どう"}, {"type": "subtitle", "time": 5333.59, "timestamp": "01:28:53", "text": "言えばいいかな、"}, {"type": "subtitle", "time": 5336.55, "timestamp": "01:28:56", "text": "クリスマスが近づいているとしましょう。"}]
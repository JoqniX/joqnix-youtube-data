[{"type": "subtitle", "time": 1981.99, "timestamp": "00:33:01", "text": "エンターテイニングスキルや声、どうやって"}, {"type": "subtitle", "time": 1984.95, "timestamp": "00:33:04", "text": "視聴者を獲得するかといったコアスキルに取り組む必要がある、という"}, {"type": "subtitle", "time": 1993.029, "timestamp": "00:33:13", "text": "投稿を見たんだ。うん、その投稿を見て、ある意味、"}, {"type": "chat", "time": 1995.706, "timestamp": "00:33:15", "author": "@miko_chann.1", "avatar": "https://yt4.ggpht.com/pA1qKxvA6gJkJo5iacL6MoaaocqRqPaKMbOHlznwOHpCJPPZbIU3_GNZ4faHtUzgYCNGbiZs1w=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2Ak"}, {"type": "subtitle", "time": 2001.35, "timestamp": "00:33:21", "text": "投資してテストして買いたいモデルがあるんだけど、お金が"}, {"type": "subtitle", "time": 2003.669, "timestamp": "00:33:23", "text": "ないので今はできない。"}, {"type": "subtitle", "time": 2005.909, "timestamp": "00:33:25", "text": "でも今は、"}, {"type": "subtitle", "time": 2016.47, "timestamp": "00:33:36", "text": "インタラクティブ性や話し方など、コンテンツクリエイターやストリーマーとしてのコアスキルを向上させることに集中すべきなんだ。だから、今の"}, {"type": "subtitle", "time": 2019.99, "timestamp": "00:33:39", "text": "僕は基本的に"}, {"type": "subtitle", "time": 2026.789, "timestamp": "00:33:46", "text": "だから、"}, {"type": "subtitle", "time": 2031.823, "timestamp": "00:33:51", "text": "限界とかそういうことを考えていたんだ。"}, {"type": "subtitle", "time": 2036.23, "timestamp": "00:33:56", "text": "[笑い声とため息] ええ、"}]
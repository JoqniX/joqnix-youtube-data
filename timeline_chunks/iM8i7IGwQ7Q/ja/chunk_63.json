[{"type": "subtitle", "time": 3781.75, "timestamp": "01:03:01", "text": "こう考えてみてください。 えっと、私はエージェンシー所属の"}, {"type": "subtitle", "time": 3784.23, "timestamp": "01:03:04", "text": "ストリーマーです。 私は企業専属の配信者です。"}, {"type": "subtitle", "time": 3787.03, "timestamp": "01:03:07", "text": "私の役割は何ですか？ エンターテイナーとして、"}, {"type": "subtitle", "time": 3789.829, "timestamp": "01:03:09", "text": "自分のエンターテイメント活動をすること、ですよね？ だから、私のために"}, {"type": "subtitle", "time": 3792.069, "timestamp": "01:03:12", "text": "技術"}, {"type": "subtitle", "time": 3794.549, "timestamp": "01:03:14", "text": "サポートをしてくれたり、あらゆる設定をしてくれたり、あらゆることの使い方を"}, {"type": "subtitle", "time": 3796.15, "timestamp": "01:03:16", "text": "教えてくれるチームを編成するつもりです"}, {"type": "subtitle", "time": 3800.39, "timestamp": "01:03:20", "text": "。 ええ、同じようなシステムです。"}, {"type": "subtitle", "time": 3802.23, "timestamp": "01:03:22", "text": "しかし、違いは私には何も持っていないということだ"}, {"type": "subtitle", "time": 3806.39, "timestamp": "01:03:26", "text": "。 だから私は全て自分でやって、"}, {"type": "subtitle", "time": 3809.829, "timestamp": "01:03:29", "text": "全て自動化しているんです。 だから、僕は自分の"}, {"type": "subtitle", "time": 3812.39, "timestamp": "01:03:32", "text": "主な仕事、つまりパフォーマンスみたいなことをするだけなんだ。"}, {"type": "subtitle", "time": 3815.829, "timestamp": "01:03:35", "text": "同じ。 私も似たような考え方を使っています"}, {"type": "subtitle", "time": 3817.67, "timestamp": "01:03:37", "text": "。 だから私は「"}, {"type": "subtitle", "time": 3822.309, "timestamp": "01:03:42", "text": "よし、あれもこれも自動化してみよう」と思ったんです。"}, {"type": "subtitle", "time": 3824.87, "timestamp": "01:03:44", "text": "だから、"}, {"type": "subtitle", "time": 3829.829, "timestamp": "01:03:49", "text": "技術的な問題について心配しなくて済むような状況に身を置くように心がけています。"}, {"type": "subtitle", "time": 3833.51, "timestamp": "01:03:53", "text": "私はただ自分のやりたいことをやるだけです。 もし私が"}, {"type": "subtitle", "time": 3836.63, "timestamp": "01:03:56", "text": "そのような状況や環境に置かれたら、"}, {"type": "subtitle", "time": 3839.75, "timestamp": "01:03:59", "text": "どうすればもっとうまく物事をこなせるだろうか、あるいは、うまく物事をこなせ"}]
[{"type": "subtitle", "time": 3901.99, "timestamp": "01:05:01", "text": "私はくしゃみがすごく出るんです。"}, {"type": "subtitle", "time": 3905.19, "timestamp": "01:05:05", "text": "インドとかでは今、"}, {"type": "subtitle", "time": 3909.43, "timestamp": "01:05:09", "text": "Vix吸入器とかがあるんですよね？"}, {"type": "subtitle", "time": 3920.069, "timestamp": "01:05:20", "text": "もし私が日本にいたら、そのようなものが利用できるかどうかはわかりません。"}, {"type": "subtitle", "time": 3923.349, "timestamp": "01:05:23", "text": "俺はVix吸入器にハマりすぎてるんだよ。"}, {"type": "subtitle", "time": 3934.71, "timestamp": "01:05:34", "text": "なぜなら、私はただ人々と話すのが好きだったからです"}, {"type": "subtitle", "time": 3935.99, "timestamp": "01:05:35", "text": "。 自分が"}, {"type": "subtitle", "time": 3938.95, "timestamp": "01:05:38", "text": "パフォーマンスをしているとか、そういう風には全く思っていませんでした。"}, {"type": "subtitle", "time": 3941.99, "timestamp": "01:05:41", "text": "パフォーマンスをするということは、"}, {"type": "subtitle", "time": 3944.39, "timestamp": "01:05:44", "text": "私にとってはつい最近のことなんです。 私はそう考えるようになったのだと思います"}, {"type": "subtitle", "time": 3948.63, "timestamp": "01:05:48", "text": "。 えっと、私にとっては、"}, {"type": "subtitle", "time": 3956.069, "timestamp": "01:05:56", "text": "これはもう"}, {"type": "subtitle", "time": 3959.029, "timestamp": "01:05:59", "text": "真剣に受け止めなければならないことなんです。 だから、ちょっと考えてみたんです"}]
[{"type": "subtitle", "time": 963.91, "timestamp": "00:16:03", "text": "、"}, {"type": "subtitle", "time": 966.71, "timestamp": "00:16:06", "text": "自分のストリームを見つけられるかどうか見てみましょう。"}, {"type": "subtitle", "time": 971.269, "timestamp": "00:16:11", "text": "ショート動画をスクロールしていくと、自分自身を見つけられると思いますか？"}, {"type": "subtitle", "time": 973.749, "timestamp": "00:16:13", "text": "YouTube Studio が、"}, {"type": "subtitle", "time": 977.749, "timestamp": "00:16:17", "text": "私のストリームが現在"}, {"type": "subtitle", "time": 979.67, "timestamp": "00:16:19", "text": "ショートモードになっていると言っているのと同じように。"}, {"type": "subtitle", "time": 981.99, "timestamp": "00:16:21", "text": "すばらしい。"}, {"type": "subtitle", "time": 984.79, "timestamp": "00:16:24", "text": "日本人や韓国人の"}, {"type": "subtitle", "time": 988.23, "timestamp": "00:16:28", "text": "配信者をたくさん見かけます。 メイオはどこにいますか？"}, {"type": "subtitle", "time": 992.79, "timestamp": "00:16:32", "text": "私の仮想通貨マイニング。 おい。 さあ、行きなさい。   わかった"}, {"type": "subtitle", "time": 995.829, "timestamp": "00:16:35", "text": "。 自分の配信が見つかりません。"}, {"type": "subtitle", "time": 1005.189, "timestamp": "00:16:45", "text": "うん。 さよなら。"}, {"type": "subtitle", "time": 1008.71, "timestamp": "00:16:48", "text": "YouTubeは私に嘘をつくことはできなかった。"}, {"type": "subtitle", "time": 1010.47, "timestamp": "00:16:50", "text": "そうそう。 今日はただ"}, {"type": "subtitle", "time": 1015.03, "timestamp": "00:16:55", "text": "おしゃべりしてのんびりしたかったんです。何も心配せずに、ただおしゃべりしたかった"}, {"type": "subtitle", "time": 1017.35, "timestamp": "00:16:57", "text": "。"}]
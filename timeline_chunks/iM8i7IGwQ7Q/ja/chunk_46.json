[{"type": "subtitle", "time": 2760.069, "timestamp": "00:46:00", "text": "いいえ、ええ、試したことはありません。"}, {"type": "subtitle", "time": 2763.43, "timestamp": "00:46:03", "text": "このFacebookマーケットプレイスを今すぐ「いいね！」してください。 私はあれ"}, {"type": "subtitle", "time": 2766.63, "timestamp": "00:46:06", "text": "から物を買えるんです"}, {"type": "subtitle", "time": 2768.15, "timestamp": "00:46:08", "text": "。"}, {"type": "subtitle", "time": 2770.55, "timestamp": "00:46:10", "text": "人々はFacebookマーケットプレイスを利用していますか？ 私はそう"}, {"type": "subtitle", "time": 2772.55, "timestamp": "00:46:12", "text": "思います。"}, {"type": "subtitle", "time": 2776.069, "timestamp": "00:46:16", "text": "ノートパソコンとか、その他機器類を売っていたんですよ"}, {"type": "subtitle", "time": 2791.829, "timestamp": "00:46:31", "text": "そうそう。 えっと、"}, {"type": "subtitle", "time": 2797.589, "timestamp": "00:46:37", "text": "友達に自分のスロープを見せたような気がします。 ああ、なるほど。 それは"}, {"type": "subtitle", "time": 2803.19, "timestamp": "00:46:43", "text": "先ほども私のセンサーが"}, {"type": "subtitle", "time": 2805.19, "timestamp": "00:46:45", "text": "Twitchのチャットにいて、「いや、日本で"}, {"type": "subtitle", "time": 2808.95, "timestamp": "00:46:48", "text": "PCを24時間365日オンにすることなんて考えもしないよ」と言っていました"}, {"type": "subtitle", "time": 2812.069, "timestamp": "00:46:52", "text": "。 あそこの警報料金ってすごく高いですよね"}]
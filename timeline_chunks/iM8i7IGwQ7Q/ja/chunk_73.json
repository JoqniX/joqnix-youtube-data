[{"type": "subtitle", "time": 4380.47, "timestamp": "01:13:00", "text": "私はすごく不安で、"}, {"type": "subtitle", "time": 4386.07, "timestamp": "01:13:06", "text": "ああ、脳内で大きな核爆弾が落ちたような感じで、"}, {"type": "subtitle", "time": 4389.27, "timestamp": "01:13:09", "text": "すごく"}, {"type": "subtitle", "time": 4392.47, "timestamp": "01:13:12", "text": "ストレスを感じて偏頭痛もして、そういうことが全部"}, {"type": "subtitle", "time": 4395.35, "timestamp": "01:13:15", "text": "起こって、"}, {"type": "subtitle", "time": 4398.365, "timestamp": "01:13:18", "text": "何もかも忘れてしまったんです。 私は振り出しに戻ってしまった。"}, {"type": "subtitle", "time": 4399.75, "timestamp": "01:13:19", "text": "[笑い] ちなみに、"}, {"type": "subtitle", "time": 4402.79, "timestamp": "01:13:22", "text": "私は配信外で1日18時間勉強して"}, {"type": "subtitle", "time": 4406.31, "timestamp": "01:13:26", "text": "、あれこれ読んで、全力を尽くしていたのですが、突然"}, {"type": "subtitle", "time": 4412.55, "timestamp": "01:13:32", "text": "偏頭痛が"}, {"type": "subtitle", "time": 4415.75, "timestamp": "01:13:35", "text": "起こりました。 私は寝たきりだった。"}, {"type": "subtitle", "time": 4419.83, "timestamp": "01:13:39", "text": "私は1週間寝たきりだった。"}, {"type": "subtitle", "time": 4424.95, "timestamp": "01:13:44", "text": "私は寝たきりの状態で授業に出席し、ある時点で「"}, {"type": "subtitle", "time": 4431.91, "timestamp": "01:13:51", "text": "ちょっと待って、これ全部勉強したはずなのに、どうして"}, {"type": "subtitle", "time": 4435.27, "timestamp": "01:13:55", "text": "忘れたんだろう」というようなことが起こり、"}, {"type": "subtitle", "time": 4438.709, "timestamp": "01:13:58", "text": "また、彼には直感があり、それが正しかったことにも気づきました。あなたはヴァレランドを"}]
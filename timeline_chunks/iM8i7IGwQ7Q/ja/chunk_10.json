[{"type": "subtitle", "time": 605.99, "timestamp": "00:10:05", "text": "Vチャンネルを24時間365日稼働するようなものに用途変更するという発表をしました。"}, {"type": "subtitle", "time": 610.71, "timestamp": "00:10:10", "text": "というのも、そのチャンネルをあまり使っていないからです"}, {"type": "subtitle", "time": 613.59, "timestamp": "00:10:13", "text": "。 だから私はこう思った。「よし、じゃあ"}, {"type": "subtitle", "time": 616.069, "timestamp": "00:10:16", "text": "こうしよう」 少なくとも私はこのように使います"}, {"type": "subtitle", "time": 619.75, "timestamp": "00:10:19", "text": "。 だから、もしあなたが"}, {"type": "subtitle", "time": 621.829, "timestamp": "00:10:21", "text": "私をとても恋しく思ったなら、もしあなたが望むなら、24時間"}, {"type": "chat", "time": 624.323, "timestamp": "00:10:24", "author": "@kurunekodream", "avatar": "https://yt4.ggpht.com/RLzqgZjl8ILhIIU27ghgxtcyxaMDaQ4nJQ8GzPmDKVVI7HHPJUZsDQV_Itc49vlXGx8THQhiP90=s64-c-k-c0x00ffffff-no-rj", "message": "what is a 24/7 channel? educate me"}, {"type": "subtitle", "time": 625.03, "timestamp": "00:10:25", "text": "365日放送のチャンネルを見ることができます。 それはそこにあるでしょう"}, {"type": "subtitle", "time": 628.47, "timestamp": "00:10:28", "text": "。 私のVSはすべて"}, {"type": "subtitle", "time": 631.11, "timestamp": "00:10:31", "text": "ランダムにプレイされます。 もし"}, {"type": "subtitle", "time": 635.03, "timestamp": "00:10:35", "text": "あなたが"}, {"type": "subtitle", "time": 639.509, "timestamp": "00:10:39", "text": "YouTubeやTwitchにアクセスできない国や地域にお住まいであれば、"}, {"type": "subtitle", "time": 643.03, "timestamp": "00:10:43", "text": "私のウェブサイトから直接視聴することもできます"}, {"type": "subtitle", "time": 644.87, "timestamp": "00:10:44", "text": "。   ええ、でも、"}, {"type": "subtitle", "time": 647.91, "timestamp": "00:10:47", "text": "ビリービリー"}, {"type": "subtitle", "time": 651.75, "timestamp": "00:10:51", "text": "や中国の人たちは、残念ながらYouTubeの地域制限のために私のウェブサイトから見ることができません"}, {"type": "subtitle", "time": 658.23, "timestamp": "00:10:58", "text": "。 それについては後で"}]
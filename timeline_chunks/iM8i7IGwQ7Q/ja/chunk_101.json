[{"type": "subtitle", "time": 6060.229, "timestamp": "01:41:00", "text": "何かが起こった。何が"}, {"type": "subtitle", "time": 6063.03, "timestamp": "01:41:03", "text": "起こったのだろうか？ はい、直しました。 はい、"}, {"type": "subtitle", "time": 6065.189, "timestamp": "01:41:05", "text": "直しました。 はい、直しました。 直しました。   ああ"}, {"type": "subtitle", "time": 6068.31, "timestamp": "01:41:08", "text": "、直った！ なぜ"}, {"type": "subtitle", "time": 6072.31, "timestamp": "01:41:12", "text": "おかしな動作をするのでしょうか？  1秒。 くそっ。 くそっ。 まるで"}, {"type": "subtitle", "time": 6074.709, "timestamp": "01:41:14", "text": "伸縮性のあるホルダーのようだ。"}, {"type": "subtitle", "time": 6077.27, "timestamp": "01:41:17", "text": "ガチョウの首のように。"}, {"type": "subtitle", "time": 6079.99, "timestamp": "01:41:19", "text": "グースネック電話とは何か調べてみてください。 ええ、私も"}, {"type": "subtitle", "time": 6082.95, "timestamp": "01:41:22", "text": "同じです。"}, {"type": "subtitle", "time": 6090.39, "timestamp": "01:41:30", "text": "実はこのイケてるやつを日本に持って行って、ベッドで映画やドラマを見たり、"}, {"type": "subtitle", "time": 6095.51, "timestamp": "01:41:35", "text": "マイクを使ってストリーミングしたり、何かに使おうと思ってるんだ。"}, {"type": "subtitle", "time": 6102.79, "timestamp": "01:41:42", "text": "少し値段が高いですね。"}, {"type": "subtitle", "time": 6104.629, "timestamp": "01:41:44", "text": "うーん、"}, {"type": "subtitle", "time": 6107.43, "timestamp": "01:41:47", "text": "ちょっと値段が高いですね。"}, {"type": "subtitle", "time": 6111.99, "timestamp": "01:41:51", "text": "えっと、高いですね。"}]
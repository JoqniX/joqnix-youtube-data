[{"type": "subtitle", "time": 3721.75, "timestamp": "01:02:01", "text": "私も、あの時は"}, {"type": "subtitle", "time": 3725.109, "timestamp": "01:02:05", "text": "ジョーンのためだけにそうしていたと思う。 私はクロノシティのSouと、"}, {"type": "subtitle", "time": 3731.349, "timestamp": "01:02:11", "text": "Nemo"}, {"type": "subtitle", "time": 3738.87, "timestamp": "01:02:18", "text": "ユーチューバーだ。 ええ、"}, {"type": "subtitle", "time": 3741.27, "timestamp": "01:02:21", "text": "あの二人がサブ"}, {"type": "subtitle", "time": 3744.15, "timestamp": "01:02:24", "text": "マラソンをやっていたので、注目していただけです。 いや、ちょっとサブアトンの上限を解除するような感じで"}, {"type": "subtitle", "time": 3746.63, "timestamp": "01:02:26", "text": "。"}, {"type": "subtitle", "time": 3750.95, "timestamp": "01:02:30", "text": "長時間配信のやり方を調べておくべきだった。"}, {"type": "subtitle", "time": 3756.63, "timestamp": "01:02:36", "text": "すでに"}, {"type": "subtitle", "time": 3758.23, "timestamp": "01:02:38", "text": "これをやっているチャンネルはたくさんあったはずだ。"}, {"type": "subtitle", "time": 3761.99, "timestamp": "01:02:41", "text": "私は究極のものが好きではない。 ええ、"}, {"type": "subtitle", "time": 3765.109, "timestamp": "01:02:45", "text": "私にとってはそうします。その方が"}, {"type": "subtitle", "time": 3768.15, "timestamp": "01:02:48", "text": "便利だと思うからです。 いいえ、"}, {"type": "subtitle", "time": 3771.03, "timestamp": "01:02:51", "text": "すべてが完璧になってから行います。 だから、私は"}, {"type": "subtitle", "time": 3772.95, "timestamp": "01:02:52", "text": "それについて心配する必要はない。 私は"}, {"type": "subtitle", "time": 3775.75, "timestamp": "01:02:55", "text": "自分のことに集中できる。   よし"}, {"type": "subtitle", "time": 3777.589, "timestamp": "01:02:57", "text": "。"}]
[{"type": "subtitle", "time": 1264.71, "timestamp": "00:21:04", "text": "日本語を教えている人や"}, {"type": "subtitle", "time": 1267.59, "timestamp": "00:21:07", "text": "日本語で話している人、英語を練習している人と話したり、そういう人と"}, {"type": "subtitle", "time": 1271.029, "timestamp": "00:21:11", "text": "話すのは"}, {"type": "subtitle", "time": 1275.029, "timestamp": "00:21:15", "text": "いい練習になると思うし、それで、何かが頭に浮かんだんだ。「これを試してみようかな」「これを試してみようかな」って。"}, {"type": "subtitle", "time": 1292.23, "timestamp": "00:21:32", "text": "えっと、私の告知メッセージが"}, {"type": "subtitle", "time": 1294.71, "timestamp": "00:21:34", "text": "どうやら2回も3回も送信されたみたい。"}, {"type": "subtitle", "time": 1301.19, "timestamp": "00:21:41", "text": "このカードで2回くらいpingが鳴ったなら申し訳ないけど、まあそういうことだ。"}, {"type": "subtitle", "time": 1306.71, "timestamp": "00:21:46", "text": "こんにちは。 だから、そうですね、"}, {"type": "subtitle", "time": 1309.99, "timestamp": "00:21:49", "text": "これからは配信で日本語をもっと話すようにしようかな、と考えていました"}, {"type": "subtitle", "time": 1312.87, "timestamp": "00:21:52", "text": "。 だって、私が英語を学んだのもそういう方法だったんじゃない"}, {"type": "subtitle", "time": 1316.39, "timestamp": "00:21:56", "text": "？ ストリーミング初日、私は自分に"}]
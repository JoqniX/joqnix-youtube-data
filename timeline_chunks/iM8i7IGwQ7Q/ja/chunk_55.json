[{"type": "subtitle", "time": 3303.67, "timestamp": "00:55:03", "text": "主催したり、今やっているのをたくさん見かけます。 だから、もし"}, {"type": "subtitle", "time": 3305.589, "timestamp": "00:55:05", "text": "誰かが"}, {"type": "subtitle", "time": 3310.309, "timestamp": "00:55:10", "text": "私のような平均的なスキルを持つ外国人を受け入れてくれるなら、"}, {"type": "subtitle", "time": 3314.15, "timestamp": "00:55:14", "text": "良い"}, {"type": "subtitle", "time": 3318.79, "timestamp": "00:55:18", "text": "周辺機器、良いPC、良いスペック、良い"}, {"type": "subtitle", "time": 3322.47, "timestamp": "00:55:22", "text": "モニター、良いゲーム環境さえあれば、私はうまく狙いを定めることができ、"}, {"type": "subtitle", "time": 3329.03, "timestamp": "00:55:29", "text": "必要に応じてパフォーマンスを発揮できます。 でも、そうですね、"}, {"type": "subtitle", "time": 3339.03, "timestamp": "00:55:39", "text": "実際に"}, {"type": "subtitle", "time": 3341.67, "timestamp": "00:55:41", "text": "参加してみたいとは思うのですが、"}, {"type": "subtitle", "time": 3344.309, "timestamp": "00:55:44", "text": "私はチームプレーヤータイプではないんです。 それも"}, {"type": "subtitle", "time": 3347.03, "timestamp": "00:55:47", "text": "私が心配していることの一つです。"}, {"type": "subtitle", "time": 3351.589, "timestamp": "00:55:51", "text": "私は突っ込んで、急いで、攻撃的に、"}, {"type": "subtitle", "time": 3353.43, "timestamp": "00:55:53", "text": "そしてまるで"}, {"type": "subtitle", "time": 3356.71, "timestamp": "00:55:56", "text": "パラディンか"}]
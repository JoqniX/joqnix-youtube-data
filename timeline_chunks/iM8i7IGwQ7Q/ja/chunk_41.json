[{"type": "subtitle", "time": 2460.87, "timestamp": "00:41:00", "text": "左や右に置くのではなく、中央に置かなければならない場合でも、"}, {"type": "subtitle", "time": 2463.27, "timestamp": "00:41:03", "text": "縦位置のショットでは、"}, {"type": "subtitle", "time": 2469.43, "timestamp": "00:41:09", "text": "人々が私などを見ることができるようにしなければなりません（笑）。 ああ、"}, {"type": "subtitle", "time": 2472.55, "timestamp": "00:41:12", "text": "それはちょっと痛いですね。 でも大丈夫。 私たちは"}, {"type": "subtitle", "time": 2476.79, "timestamp": "00:41:16", "text": "調整できます。 少し調整することは可能です"}, {"type": "subtitle", "time": 2478.95, "timestamp": "00:41:18", "text": "。   様子を"}, {"type": "subtitle", "time": 2487.67, "timestamp": "00:41:27", "text": "私が一番心配しているのは、"}, {"type": "subtitle", "time": 2490.87, "timestamp": "00:41:30", "text": "資源のことです。"}, {"type": "subtitle", "time": 2494.47, "timestamp": "00:41:34", "text": "私の配信が多忙なせいで、リソースが本当に不足しています"}, {"type": "subtitle", "time": 2497.99, "timestamp": "00:41:37", "text": "。"}, {"type": "subtitle", "time": 2500.15, "timestamp": "00:41:40", "text": "だから、私はあらゆることのバランスを取り、"}, {"type": "subtitle", "time": 2503.109, "timestamp": "00:41:43", "text": "あらゆることを制限し、あれこれと不要なものを取り除かなければならないのです"}, {"type": "subtitle", "time": 2505.589, "timestamp": "00:41:45", "text": "。   本当に"}, {"type": "subtitle", "time": 2508.069, "timestamp": "00:41:48", "text": "頭痛の種だ。 みんなシュ"}, {"type": "subtitle", "time": 2515.03, "timestamp": "00:41:55", "text": "面倒くさい"}]
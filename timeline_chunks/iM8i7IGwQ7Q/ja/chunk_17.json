[{"type": "subtitle", "time": 1032.39, "timestamp": "00:17:12", "text": "[笑い] わからない。 だから今日、それを"}, {"type": "subtitle", "time": 1033.99, "timestamp": "00:17:13", "text": "共有しても良いのかどうかわかりません"}, {"type": "subtitle", "time": 1037.11, "timestamp": "00:17:17", "text": "。 誰だったかは言いません。"}, {"type": "subtitle", "time": 1041.59, "timestamp": "00:17:21", "text": "それで、私はタレントショーへの参加に招待されました"}, {"type": "subtitle", "time": 1044.39, "timestamp": "00:17:24", "text": "。  [笑い]"}, {"type": "subtitle", "time": 1049.75, "timestamp": "00:17:29", "text": "だから私は、本当にあなたが"}, {"type": "subtitle", "time": 1053.99, "timestamp": "00:17:33", "text": "私に何を望んでいるのか、そういうタイプの男だったんです。 そして私は「えっと、"}, {"type": "subtitle", "time": 1061.75, "timestamp": "00:17:41", "text": "自分の魅力ポイントがわからない」と思った。 いや、"}, {"type": "subtitle", "time": 1064.71, "timestamp": "00:17:44", "text": "私のchポイントって一体何なの？ よくわからない"}, {"type": "subtitle", "time": 1067.19, "timestamp": "00:17:47", "text": "けど、今は"}, {"type": "subtitle", "time": 1069.27, "timestamp": "00:17:49", "text": "日本語の勉強だけをしている。 だから、"}, {"type": "subtitle", "time": 1071.99, "timestamp": "00:17:51", "text": "日本語形式で何かやってみようと思ったんです。"}, {"type": "subtitle", "time": 1075.11, "timestamp": "00:17:55", "text": "それで歌おうと思ったんだけど、12月24日だし"}, {"type": "subtitle", "time": 1079.59, "timestamp": "00:17:59", "text": "、"}]
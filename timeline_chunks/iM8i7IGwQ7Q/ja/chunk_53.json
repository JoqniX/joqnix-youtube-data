[{"type": "subtitle", "time": 3183.03, "timestamp": "00:53:03", "text": "Asmaのような、もっとクリエイティブな配信ベースの動画を作りたいと思ったんです。 ああ、アスミンは"}, {"type": "subtitle", "time": 3185.43, "timestamp": "00:53:05", "text": "よくやるよ。 いや、昨日の"}, {"type": "subtitle", "time": 3188.95, "timestamp": "00:53:08", "text": "配信で彼は、"}, {"type": "subtitle", "time": 3195.27, "timestamp": "00:53:15", "text": "顔出しカメラをオンにしてゲーム配信したくないとか、そういう話をしていたよ。 彼は"}, {"type": "subtitle", "time": 3204.63, "timestamp": "00:53:24", "text": "配信中であっても、自分の顔を映さないカメラでゲームなどをするのが好きだ。"}, {"type": "subtitle", "time": 3207.829, "timestamp": "00:53:27", "text": "歌詞のことを考えていたんだけど、彼はただ"}, {"type": "subtitle", "time": 3211.03, "timestamp": "00:53:31", "text": "歌詞のことをすればいいんだ。"}, {"type": "subtitle", "time": 3214.15, "timestamp": "00:53:34", "text": "私は、これを示すような、もっとリアクションコンテンツのようなものをリクエストしました"}, {"type": "subtitle", "time": 3220.309, "timestamp": "00:53:40", "text": "。   先ほど"}, {"type": "subtitle", "time": 3223.829, "timestamp": "00:53:43", "text": "私が"}, {"type": "subtitle", "time": 3226.069, "timestamp": "00:53:46", "text": "言ったアサン・ゴールドの件、つまり彼が"}, {"type": "subtitle", "time": 3232.549, "timestamp": "00:53:52", "text": "ゲームをしている時に顔出しなし、カメラなしの配信を好むという件について、よくわかりません。"}, {"type": "subtitle", "time": 3235.109, "timestamp": "00:53:55", "text": "その動画やその一部が、"}, {"type": "subtitle", "time": 3238.71, "timestamp": "00:53:58", "text": "彼の編集者が作ったものとかで、彼のSNSにアップされるかどうかは分かりません"}]
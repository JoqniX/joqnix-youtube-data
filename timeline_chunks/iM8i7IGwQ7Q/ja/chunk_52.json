[{"type": "subtitle", "time": 3124.549, "timestamp": "00:52:04", "text": "反応物というのは、ビデオに反応して、"}, {"type": "subtitle", "time": 3129.109, "timestamp": "00:52:09", "text": "自分のえっと、何て言うんだっけ"}, {"type": "subtitle", "time": 3131.581, "timestamp": "00:52:11", "text": "？"}, {"type": "subtitle", "time": 3132.87, "timestamp": "00:52:12", "text": "[笑い]"}, {"type": "subtitle", "time": 3136.23, "timestamp": "00:52:16", "text": "えーっと、過剰反応とか、大げさな表情とか"}, {"type": "subtitle", "time": 3138.63, "timestamp": "00:52:18", "text": "。 いいえ。ああ、ただ"}, {"type": "subtitle", "time": 3141.589, "timestamp": "00:52:21", "text": "あなたの率直な感想を述べていただければ結構です。 それが一番"}, {"type": "subtitle", "time": 3150.95, "timestamp": "00:52:30", "text": "えーと、YouTubeとかコンテンツのある場所でできるコンテンツの種類って、"}, {"type": "subtitle", "time": 3157.67, "timestamp": "00:52:37", "text": "すごくシンプルだよね。どんな意見や"}, {"type": "subtitle", "time": 3159.75, "timestamp": "00:52:39", "text": "考えを"}, {"type": "subtitle", "time": 3162.87, "timestamp": "00:52:42", "text": "共有するかも重要だし、"}, {"type": "subtitle", "time": 3168.63, "timestamp": "00:52:48", "text": "私はもっと音楽"}, {"type": "subtitle", "time": 3172.23, "timestamp": "00:52:52", "text": "ストリームをやろうと思ってるんだけど、今の私の考えは"}, {"type": "subtitle", "time": 3174.63, "timestamp": "00:52:54", "text": "イデオロギーみたいなものなんだ。"}]
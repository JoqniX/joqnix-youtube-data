[{"type": "subtitle", "time": 780.71, "timestamp": "00:13:00", "text": "発生した場合だけだ。 今はスマホを使ってパソコンの電源を入れることができません"}, {"type": "subtitle", "time": 783.11, "timestamp": "00:13:03", "text": "。  VCONランドが"}, {"type": "subtitle", "time": 786.15, "timestamp": "00:13:06", "text": "機能しません。 えっと、"}, {"type": "subtitle", "time": 789.35, "timestamp": "00:13:09", "text": "Wi-Fiルーターの電源が切れたら、"}, {"type": "subtitle", "time": 792.47, "timestamp": "00:13:12", "text": "ですよね？ そして再起動した。 だから、"}, {"type": "subtitle", "time": 795.75, "timestamp": "00:13:15", "text": "手動で上がって電源を入れなきゃいけないんです。"}, {"type": "subtitle", "time": 803.75, "timestamp": "00:13:23", "text": "。 それで、先ほど"}, {"type": "subtitle", "time": 806.79, "timestamp": "00:13:26", "text": "ストリームに大きな遅延が発生したのは、今は"}, {"type": "subtitle", "time": 809.509, "timestamp": "00:13:29", "text": "別のOBSを使用しているためです。 いいえ、私は"}, {"type": "subtitle", "time": 811.35, "timestamp": "00:13:31", "text": "主流メディアにはメルを使っています。 ええ、24時間"}, {"type": "subtitle", "time": 818.31, "timestamp": "00:13:38", "text": "365日の配信にはOBSを使っていました。   そう"}, {"type": "subtitle", "time": 822.31, "timestamp": "00:13:42", "text": "、今の私のインターネットでは"}, {"type": "subtitle", "time": 826.609, "timestamp": "00:13:46", "text": "ストリーミングに必要なリソースが足りなかったんです。 ああ、"}, {"type": "subtitle", "time": 828.15, "timestamp": "00:13:48", "text": "（笑い）大丈夫です。"}, {"type": "subtitle", "time": 829.99, "timestamp": "00:13:49", "text": "何とか解決策を見つけるよ。"}, {"type": "subtitle", "time": 832.15, "timestamp": "00:13:52", "text": "ええ、"}]
[{"type": "subtitle", "time": 2821.75, "timestamp": "00:47:01", "text": "日本で耐久レースや配信を行うことはできないということだ。  [笑い]"}, {"type": "subtitle", "time": 2827.43, "timestamp": "00:47:07", "text": "、待って。 ノートパソコンを使っているのですが、それでも"}, {"type": "subtitle", "time": 2832.15, "timestamp": "00:47:12", "text": "待って、それはカウントされるの？ そうそう。"}, {"type": "subtitle", "time": 2834.47, "timestamp": "00:47:14", "text": "周辺機器。 モニターを接続しなければならない。"}, {"type": "subtitle", "time": 2850.15, "timestamp": "00:47:30", "text": "インドではそうではない。 人々はめったにそれを使わない。 ああ、"}, {"type": "subtitle", "time": 2853.51, "timestamp": "00:47:33", "text": "外に出てくるのはみんな君の友達だよ。"}, {"type": "subtitle", "time": 2863.682, "timestamp": "00:47:43", "text": "つまり、あそこにはエアコンは必要ないってこと。"}, {"type": "subtitle", "time": 2868.47, "timestamp": "00:47:48", "text": "ええ。"}, {"type": "subtitle", "time": 2871.99, "timestamp": "00:47:51", "text": "そしてそこは、寒すぎたり暑すぎたりするんです。"}, {"type": "subtitle", "time": 2874.23, "timestamp": "00:47:54", "text": "インドのあらゆる天候は、どれも"}]
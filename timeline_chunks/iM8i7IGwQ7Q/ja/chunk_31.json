[{"type": "subtitle", "time": 1862.07, "timestamp": "00:31:02", "text": "日本に行く前に何かしておきたかっただけなんです。 だから、自分がどんな"}, {"type": "subtitle", "time": 1878.789, "timestamp": "00:31:18", "text": "。 つまり、それが"}, {"type": "subtitle", "time": 1881.11, "timestamp": "00:31:21", "text": "この戦争というものに対する唯一の思考プロセスだということだ。"}, {"type": "subtitle", "time": 1885.83, "timestamp": "00:31:25", "text": "うん。 うん。  24時間365日稼働している"}, {"type": "subtitle", "time": 1889.029, "timestamp": "00:31:29", "text": "チャンネルは、より"}, {"type": "subtitle", "time": 1892.389, "timestamp": "00:31:32", "text": "大きな"}, {"type": "subtitle", "time": 1893.99, "timestamp": "00:31:33", "text": "クリエイターにしか機能せず、"}, {"type": "subtitle", "time": 1898.87, "timestamp": "00:31:38", "text": "私のような小さなクリエイターには機能しないことは分かっています。 ただ実験してみたかっただけです。 まだ時期尚早なのは"}, {"type": "subtitle", "time": 1901.35, "timestamp": "00:31:41", "text": "承知していますが、まずは"}, {"type": "subtitle", "time": 1904.63, "timestamp": "00:31:44", "text": "存在させておきたかったのです。そうすれば、将来的に利用者が増えた時に、変更したりアップグレードしたりできるからです"}, {"type": "subtitle", "time": 1910.646, "timestamp": "00:31:50", "text": "。"}, {"type": "subtitle", "time": 1911.43, "timestamp": "00:31:51", "text": "[笑い声とため息]"}, {"type": "subtitle", "time": 1913.909, "timestamp": "00:31:53", "text": "今は悪い癖だと思うんだけど、"}]
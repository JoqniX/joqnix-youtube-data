[{"type": "subtitle", "time": 1921.669, "timestamp": "00:32:01", "text": "時々、もっと"}, {"type": "chat", "time": 1923.466, "timestamp": "00:32:03", "author": "@miko_chann.1", "avatar": "https://yt4.ggpht.com/pA1qKxvA6gJkJo5iacL6MoaaocqRqPaKMbOHlznwOHpCJPPZbIU3_GNZ4faHtUzgYCNGbiZs1w=s64-c-k-c0x00ffffff-no-rj", "message": "I stopped streaming after something happened to me TvT now starting again with my another model the bunny one ^^"}, {"type": "subtitle", "time": 1926.549, "timestamp": "00:32:06", "text": "大きな"}, {"type": "subtitle", "time": 1931.19, "timestamp": "00:32:11", "text": "クリエイターがやっていることを試してみたりする傾向があるんだ。 そう、"}, {"type": "subtitle", "time": 1933.11, "timestamp": "00:32:13", "text": "パートナーはミュートになっていて、私はまるで独り言を"}, {"type": "subtitle", "time": 1935.19, "timestamp": "00:32:15", "text": "言っている変人みたいに見えたでしょう。 何てことだ"}, {"type": "subtitle", "time": 1942.31, "timestamp": "00:32:22", "text": "ええ。 もっと注意深く作業するか、"}, {"type": "subtitle", "time": 1945.19, "timestamp": "00:32:25", "text": "私のように自動化することもできます。 私がやりますし、"}, {"type": "subtitle", "time": 1947.19, "timestamp": "00:32:27", "text": "あなたは全く触る必要はありません。"}, {"type": "subtitle", "time": 1950.87, "timestamp": "00:32:30", "text": "すべてが自動化されるだろう。"}, {"type": "subtitle", "time": 1952.31, "timestamp": "00:32:32", "text": "以前、"}, {"type": "subtitle", "time": 1955.43, "timestamp": "00:32:35", "text": "別の"}, {"type": "subtitle", "time": 1959.029, "timestamp": "00:32:39", "text": "モデル（お金儲けモデル）で何か問題が起きて配信を止めたのですが、今度はまた同じことが起こりました。"}, {"type": "subtitle", "time": 1962.23, "timestamp": "00:32:42", "text": "ナオミ・コーさん、おめでとうございます。再開されたことを嬉しく思います"}, {"type": "subtitle", "time": 1964.47, "timestamp": "00:32:44", "text": "。"}, {"type": "subtitle", "time": 1967.59, "timestamp": "00:32:47", "text": "とても良いショーでした。"}, {"type": "subtitle", "time": 1972.549, "timestamp": "00:32:52", "text": "今日Twitterで、"}, {"type": "subtitle", "time": 1974.87, "timestamp": "00:32:54", "text": "完璧なモデルや"}, {"type": "subtitle", "time": 1977.11, "timestamp": "00:32:57", "text": "高いモデルは必要ない、モデルにそんなにお金をかける必要はない、"}, {"type": "subtitle", "time": 1979.35, "timestamp": "00:32:59", "text": "まずは自分の"}]
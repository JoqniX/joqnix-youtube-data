[{"type": "subtitle", "time": 5880.47, "timestamp": "01:38:00", "text": "良い仲間、つまり気が合って仲良くなれる人が必要ですよ"}, {"type": "subtitle", "time": 5887.35, "timestamp": "01:38:07", "text": "ね？ 本当に素晴らしいです。"}, {"type": "subtitle", "time": 5890.149, "timestamp": "01:38:10", "text": "すると、私の中には「よし、"}, {"type": "subtitle", "time": 5896.229, "timestamp": "01:38:16", "text": "実験的にやってみてもいいかも。例えば、"}, {"type": "subtitle", "time": 5899.51, "timestamp": "01:38:19", "text": "フォールアウトシリーズとかバイオハザードみたいなシングルプレイヤーゲームをプレイしてみるのもいいかも。面白そうだけど、"}, {"type": "subtitle", "time": 5908.629, "timestamp": "01:38:28", "text": "怖くて恐ろしいから、やめておこうかな」という気持ちが湧いてくる。   わからない"}, {"type": "subtitle", "time": 5912.709, "timestamp": "01:38:32", "text": "。 ああ"}, {"type": "subtitle", "time": 5914.95, "timestamp": "01:38:34", "text": "、そうだね。 うん。 私は"}, {"type": "subtitle", "time": 5918.709, "timestamp": "01:38:38", "text": "剣の"}, {"type": "subtitle", "time": 5923.03, "timestamp": "01:38:43", "text": "ゲームや白髪の男のゲームなど、この特定のゲームに興味を持っていました。 えっと、デビル"}, {"type": "subtitle", "time": 5925.99, "timestamp": "01:38:45", "text": "メイクライ。 そう、デビルメイクライ。 私は"}, {"type": "subtitle", "time": 5927.99, "timestamp": "01:38:47", "text": "そのゲームにしばらく前から興味を持っていました"}, {"type": "subtitle", "time": 5937.189, "timestamp": "01:38:57", "text": "そのゲーム、面白そうだね。 ぜひ"}]
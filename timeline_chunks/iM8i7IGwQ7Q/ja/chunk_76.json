[{"type": "subtitle", "time": 4574.709, "timestamp": "01:16:14", "text": "えっと、それを何日も毎日やらないといけないんです"}, {"type": "subtitle", "time": 4577.03, "timestamp": "01:16:17", "text": "。"}, {"type": "subtitle", "time": 4579.83, "timestamp": "01:16:19", "text": "こんにちは。 うん。 うん。 私の間違いは、"}, {"type": "subtitle", "time": 4583.91, "timestamp": "01:16:23", "text": "すべてを一度に追いつこうとしたことでした。 それが実際に"}, {"type": "subtitle", "time": 4587.43, "timestamp": "01:16:27", "text": "起こったことだ。 私はいつもの悪い癖で、"}, {"type": "subtitle", "time": 4593.558, "timestamp": "01:16:33", "text": "一つずつ順番にこなすのではなく、すべてを同時にやってしまった。"}, {"type": "subtitle", "time": 4595.75, "timestamp": "01:16:35", "text": "[鼻を鳴らす] ああ。   彼ら"}, {"type": "subtitle", "time": 4598.63, "timestamp": "01:16:38", "text": "も戻ってくる。 あー、そうそう、"}, {"type": "subtitle", "time": 4601.27, "timestamp": "01:16:41", "text": "最近考えていたんだけど、"}, {"type": "subtitle", "time": 4603.83, "timestamp": "01:16:43", "text": "何が"}, {"type": "subtitle", "time": 4606.63, "timestamp": "01:16:46", "text": "起こるかわからないんだけど、もし私が"}, {"type": "subtitle", "time": 4608.48, "timestamp": "01:16:48", "text": "もし私が 以前のモデルを再び使ったら、皆さんは興味がありますか？"}, {"type": "subtitle", "time": 4613.12, "timestamp": "01:16:53", "text": "以前のモデルを再び使ったら、皆さんは興味がありますか？ 暗闇の中で次のモデル、えっと、わからないけど、"}]
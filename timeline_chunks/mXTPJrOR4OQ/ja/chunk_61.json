[{"type": "subtitle", "time": 3661.43, "timestamp": "01:01:01", "text": "。 複数のゲームキャプチャ関連のものが表示されている場合は、"}, {"type": "subtitle", "time": 3665.51, "timestamp": "01:01:05", "text": "不要なものをすべて削除してください。それらが"}, {"type": "subtitle", "time": 3670.71, "timestamp": "01:01:10", "text": "クラッシュの原因になっている可能性があります"}, {"type": "subtitle", "time": 3674.549, "timestamp": "01:01:14", "text": "。プラグイン関連のものもすべて再確認してください。"}, {"type": "subtitle", "time": 3678.15, "timestamp": "01:01:18", "text": "ええと、主にこのログ分析を確認してください"}, {"type": "subtitle", "time": 3681.43, "timestamp": "01:01:21", "text": "。 その後、ブラウザ自体のログを確認してください。"}, {"type": "subtitle", "time": 3687.43, "timestamp": "01:01:27", "text": "ここのログには、"}, {"type": "subtitle", "time": 3690.47, "timestamp": "01:01:30", "text": "OBS の設定がすべて表示されます"}, {"type": "subtitle", "time": 3694.39, "timestamp": "01:01:34", "text": "。 トラブルシューティングのために、"}, {"type": "subtitle", "time": 3700.63, "timestamp": "01:01:40", "text": "ゲームDVRがオフになっていることを確認してください"}, {"type": "subtitle", "time": 3702.47, "timestamp": "01:01:42", "text": "。"}, {"type": "subtitle", "time": 3705.19, "timestamp": "01:01:45", "text": "管理者権限で実行していることを確認してください。 わからないのか？   わかった"}, {"type": "subtitle", "time": 3706.71, "timestamp": "01:01:46", "text": "。 管理者権限で実行していることを確認してください"}, {"type": "subtitle", "time": 3709.43, "timestamp": "01:01:49", "text": "。 それが一番重要な点です。"}, {"type": "subtitle", "time": 3714.71, "timestamp": "01:01:54", "text": "それから、ええと、他に何かありますか？ えっと、"}, {"type": "subtitle", "time": 3717.67, "timestamp": "01:01:57", "text": "ビデオ設定ももう一度確認してください。"}]
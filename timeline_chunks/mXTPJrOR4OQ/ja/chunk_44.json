[{"type": "subtitle", "time": 2641.67, "timestamp": "00:44:01", "text": "このボタンには"}, {"type": "subtitle", "time": 2643.91, "timestamp": "00:44:03", "text": "繰り返し間隔がありません。"}, {"type": "subtitle", "time": 2646.23, "timestamp": "00:44:06", "text": "ストリームの状態だけが変更されています。 それは文字通り、"}, {"type": "subtitle", "time": 2649.03, "timestamp": "00:44:09", "text": "ストリーム録画を開始したとき、"}, {"type": "subtitle", "time": 2651.109, "timestamp": "00:44:11", "text": "ストリームを開始し、ストリーム"}, {"type": "subtitle", "time": 2652.95, "timestamp": "00:44:12", "text": "録画を停止し、"}, {"type": "subtitle", "time": 2655.109, "timestamp": "00:44:15", "text": "仮想カメラをオンにしてオフにしたときに、"}, {"type": "subtitle", "time": 2659.03, "timestamp": "00:44:19", "text": "ストリームの状態が変わったということです。つまり、ここでは"}, {"type": "subtitle", "time": 2662.309, "timestamp": "00:44:22", "text": "ボタンが再トリガーされません。"}, {"type": "subtitle", "time": 2665.51, "timestamp": "00:44:25", "text": "ご覧のように、ボタンIDと表示されています。これは、"}, {"type": "subtitle", "time": 2667.829, "timestamp": "00:44:27", "text": "この"}, {"type": "subtitle", "time": 2673.67, "timestamp": "00:44:33", "text": "ボタンID 4 432を再トリガーしています。この"}, {"type": "subtitle", "time": 2676.069, "timestamp": "00:44:36", "text": "コマンドはタイムアウトを待ちます。タイムアウトとは、"}, {"type": "subtitle", "time": 2679.43, "timestamp": "00:44:39", "text": "遅延を追加することです。"}, {"type": "subtitle", "time": 2684.15, "timestamp": "00:44:44", "text": "一定時間（ミリ秒単位）待機した後、"}, {"type": "subtitle", "time": 2692.069, "timestamp": "00:44:52", "text": "以下のアクションを実行します。 ええ、"}, {"type": "subtitle", "time": 2698.79, "timestamp": "00:44:58", "text": "好きなもの、"}]
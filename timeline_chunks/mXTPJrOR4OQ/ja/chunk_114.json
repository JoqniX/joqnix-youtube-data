[{"type": "subtitle", "time": 6841.43, "timestamp": "01:54:01", "text": "Sammyで認証したり、メッセージを送信したい"}, {"type": "subtitle", "time": 6844.47, "timestamp": "01:54:04", "text": "TwitchストリーマーアカウントとB"}, {"type": "subtitle", "time": 6846.39, "timestamp": "01:54:06", "text": "アカウントの両方を追加したりできます"}, {"type": "subtitle", "time": 6848.95, "timestamp": "01:54:08", "text": "。  B"}, {"type": "subtitle", "time": 6851.35, "timestamp": "01:54:11", "text": "アカウントを選択して、Bアカウントを使用して私にTwitchコマンドを送信できます"}, {"type": "subtitle", "time": 6853.51, "timestamp": "01:54:13", "text": "。 そうすることもできますし、ここに"}, {"type": "subtitle", "time": 6858.149, "timestamp": "01:54:18", "text": "OBSを接続することもできます。 複数のOBSをお持ちの場合は、それらの"}, {"type": "subtitle", "time": 6860.39, "timestamp": "01:54:20", "text": "OBSを接続することも可能です"}, {"type": "subtitle", "time": 6863.27, "timestamp": "01:54:23", "text": "。 ええ、彼らは"}, {"type": "subtitle", "time": 6866.55, "timestamp": "01:54:26", "text": "まだメル用の統合された機能を持っていません。 現在、"}, {"type": "subtitle", "time": 6870.31, "timestamp": "01:54:30", "text": "MEL拡張機能のベータテストを行っています。 つまり、"}, {"type": "subtitle", "time": 6873.91, "timestamp": "01:54:33", "text": "ローカルホストなので、"}, {"type": "subtitle", "time": 6876.709, "timestamp": "01:54:36", "text": "拡張機能はグローバルで実行されます"}, {"type": "subtitle", "time": 6882.149, "timestamp": "01:54:42", "text": "。ご覧のとおり、既に接続されています。 だから「"}, {"type": "subtitle", "time": 6884.95, "timestamp": "01:54:44", "text": "接続済み」は「1」と表記されているのです。 これは、"}, {"type": "subtitle", "time": 6886.87, "timestamp": "01:54:46", "text": "現在のシーン、ゲームのメイン、前のシーンなどを表示します"}, {"type": "subtitle", "time": 6889.51, "timestamp": "01:54:49", "text": "。 録画中かどうかを確認します"}, {"type": "subtitle", "time": 6891.669, "timestamp": "01:54:51", "text": "。 録画ではなく、"}, {"type": "subtitle", "time": 6894.39, "timestamp": "01:54:54", "text": "ストリーミングです。 つまり、この変数は"}, {"type": "subtitle", "time": 6898.31, "timestamp": "01:54:58", "text": "毎秒更新されているということですね"}]
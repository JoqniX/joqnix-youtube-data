[{"type": "subtitle", "time": 4202.149, "timestamp": "01:10:02", "text": "すべてのソースをフィルターとして"}, {"type": "subtitle", "time": 4204.47, "timestamp": "01:10:04", "text": "3つ以上のフィルターで"}, {"type": "subtitle", "time": 4206.95, "timestamp": "01:10:06", "text": "最低限すべてを処理するなんて、本当にたくさんのことですよね？"}, {"type": "subtitle", "time": 4209.99, "timestamp": "01:10:09", "text": "つまり、"}, {"type": "subtitle", "time": 4211.59, "timestamp": "01:10:11", "text": "この全体のようなシーンコレクションは、あなたのシーン"}, {"type": "subtitle", "time": 4213.51, "timestamp": "01:10:13", "text": "コレクションになり得るということです。 シーンコレクションが"}, {"type": "subtitle", "time": 4215.03, "timestamp": "01:10:15", "text": "破損しています。   できることとしては、"}, {"type": "subtitle", "time": 4222.95, "timestamp": "01:10:22", "text": "OBS にアクセスして、"}, {"type": "subtitle", "time": 4225.189, "timestamp": "01:10:25", "text": "ポータブル"}, {"type": "subtitle", "time": 4227.43, "timestamp": "01:10:27", "text": "モードで実行して特定の"}, {"type": "subtitle", "time": 4229.669, "timestamp": "01:10:29", "text": "ドライブに保存することです。 うん。 つまり、"}, {"type": "subtitle", "time": 4232.55, "timestamp": "01:10:32", "text": "OBS Studio の設定の中に、"}, {"type": "subtitle", "time": 4234.63, "timestamp": "01:10:34", "text": "基本的な"}, {"type": "subtitle", "time": 4236.39, "timestamp": "01:10:36", "text": "シーンプロファイルがあります。 これは"}, {"type": "subtitle", "time": 4238.87, "timestamp": "01:10:38", "text": "あなたのプロフィールです。 例えば、私の場合は"}, {"type": "subtitle", "time": 4240.39, "timestamp": "01:10:40", "text": "こうなります。"}, {"type": "subtitle", "time": 4242.149, "timestamp": "01:10:42", "text": "中にはシーン コレクションがあります。つまり、"}, {"type": "subtitle", "time": 4246.63, "timestamp": "01:10:46", "text": "ここにあるのがシーン"}, {"type": "subtitle", "time": 4247.91, "timestamp": "01:10:47", "text": "コレクション全体です。シーン、ソース、フィルターなどすべてです。"}, {"type": "subtitle", "time": 4254.47, "timestamp": "01:10:54", "text": "シーン コレクションが破損している場合は、実行してみてください。作成してみてください。"}]
[{"type": "subtitle", "time": 5581.27, "timestamp": "01:33:01", "text": "ニース。 ああ、なんて素敵なんでしょう。 ニース。"}, {"type": "subtitle", "time": 5583.51, "timestamp": "01:33:03", "text": "ニース。 ニース。 ニース。"}, {"type": "subtitle", "time": 5591.669, "timestamp": "01:33:11", "text": "だから、このようにコマンドごとにカウンターがあると、"}, {"type": "subtitle", "time": 5600.31, "timestamp": "01:33:20", "text": "実際に私の作業に役立つんです。"}, {"type": "subtitle", "time": 5602.47, "timestamp": "01:33:22", "text": "うん。 だから、ボタンは"}, {"type": "subtitle", "time": 5605.91, "timestamp": "01:33:25", "text": "3 秒ごと、5 秒ごと、何"}, {"type": "subtitle", "time": 5610.79, "timestamp": "01:33:30", "text": "秒かの間隔で実行されます。そして、"}, {"type": "subtitle", "time": 5617.27, "timestamp": "01:33:37", "text": "チャット メッセージにまだ送信されていない場合は、"}, {"type": "subtitle", "time": 5620.55, "timestamp": "01:33:40", "text": "送信されます。すでに送信されている場合は、"}, {"type": "subtitle", "time": 5623.59, "timestamp": "01:33:43", "text": "すでにログに記録されています。ログに記録されています。"}, {"type": "subtitle", "time": 5627.11, "timestamp": "01:33:47", "text": "ここにログがあります。"}, {"type": "subtitle", "time": 5630.39, "timestamp": "01:33:50", "text": "以前に送信されたことがある場合、"}, {"type": "subtitle", "time": 5634.149, "timestamp": "01:33:54", "text": "複数回送信されている場合は、そのように"}, {"type": "subtitle", "time": 5636.95, "timestamp": "01:33:56", "text": "再度送信されません"}, {"type": "subtitle", "time": 5638.47, "timestamp": "01:33:58", "text": "。"}]
[{"type": "subtitle", "time": 240.47, "timestamp": "00:04:00", "text": "ワークストリームを行います。 それは"}, {"type": "subtitle", "time": 242.71, "timestamp": "00:04:02", "text": "私と一緒に仕事をする配信になります。 私は仕事をします。"}, {"type": "subtitle", "time": 245.03, "timestamp": "00:04:05", "text": "皆さんも、"}, {"type": "subtitle", "time": 247.83, "timestamp": "00:04:07", "text": "もしよろしければ、私と一緒に活動したり、参加したりすることもできますよ。"}, {"type": "subtitle", "time": 251.589, "timestamp": "00:04:11", "text": "こんにちは。 こんにちは。 今日は"}, {"type": "subtitle", "time": 256.31, "timestamp": "00:04:16", "text": "サミー関連の作業に取り組みます。 えっと、昨日"}, {"type": "subtitle", "time": 258.39, "timestamp": "00:04:18", "text": "コラボの前にサミーの作業をしていました。 私は"}, {"type": "subtitle", "time": 261.749, "timestamp": "00:04:21", "text": "自分の抱えている問題について、助けが必要なことがあったので、サポートスレッドを2つ作成しました"}, {"type": "subtitle", "time": 263.99, "timestamp": "00:04:23", "text": "。 だから、私は"}, {"type": "subtitle", "time": 266.79, "timestamp": "00:04:26", "text": "それにもっと集中して、"}, {"type": "subtitle", "time": 269.27, "timestamp": "00:04:29", "text": "どうすれば"}, {"type": "subtitle", "time": 271.43, "timestamp": "00:04:31", "text": "物事を整えられるかを考えていこうと思っています。 さらに、"}, {"type": "subtitle", "time": 273.909, "timestamp": "00:04:33", "text": "今日私がサミーの件を終えた後に行う最も重要なことの 1 つは、"}, {"type": "subtitle", "time": 286.07, "timestamp": "00:04:46", "text": "ストリーム上のメルに HTML オーバーレイを元に戻すことです。 えーと、"}, {"type": "subtitle", "time": 289.67, "timestamp": "00:04:49", "text": "SammiのローカルAPIを使って、"}, {"type": "subtitle", "time": 297.59000000000003, "timestamp": "00:04:57", "text": "えーとHTMLオーバーレイを取得できるようにしようと思ったんです。"}]
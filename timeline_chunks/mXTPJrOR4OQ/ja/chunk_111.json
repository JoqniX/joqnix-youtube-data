[{"type": "subtitle", "time": 6661.189, "timestamp": "01:51:01", "text": "ええと、もし見えるなら。"}, {"type": "subtitle", "time": 6664.79, "timestamp": "01:51:04", "text": "ああ、壊してしまった。 私が壊してしまったんです。 わかった。"}, {"type": "subtitle", "time": 6667.109, "timestamp": "01:51:07", "text": "ああ、そこにあるよ。 あなたには"}, {"type": "subtitle", "time": 6672.149, "timestamp": "01:51:12", "text": "見えるかどうか分かりません。 ゲーム。 うん、ゲームだよ。 右。"}, {"type": "subtitle", "time": 6676.149, "timestamp": "01:51:16", "text": "だから、私がゲームシーンにいる場合、"}, {"type": "subtitle", "time": 6679.91, "timestamp": "01:51:19", "text": "このボタンが"}, {"type": "subtitle", "time": 6684.47, "timestamp": "01:51:24", "text": "3秒ごとに実行されると、"}, {"type": "subtitle", "time": 6689.03, "timestamp": "01:51:29", "text": "ボタン実行と呼ばれるカウンターがあり、"}, {"type": "subtitle", "time": 6690.95, "timestamp": "01:51:30", "text": "それはこれです。"}, {"type": "subtitle", "time": 6693.189, "timestamp": "01:51:33", "text": "少しズームインします。 あなたには"}, {"type": "subtitle", "time": 6698.149, "timestamp": "01:51:38", "text": "見えるかどうか分かりません。 私のもの。 ああ、なんてバカなんだ。"}, {"type": "subtitle", "time": 6700.39, "timestamp": "01:51:40", "text": "ああ、そうだ。 ボタンが"}, {"type": "subtitle", "time": 6703.51, "timestamp": "01:51:43", "text": "動くのが見えますか？ 私はそれを7回実行した。"}, {"type": "subtitle", "time": 6707.03, "timestamp": "01:51:47", "text": "つまり、このボタンが"}, {"type": "subtitle", "time": 6709.51, "timestamp": "01:51:49", "text": "押されるたびに、"}, {"type": "subtitle", "time": 6712.149, "timestamp": "01:51:52", "text": "このボタンが押された回数をカウントするカウンターが備わっているということです。"}, {"type": "subtitle", "time": 6714.629, "timestamp": "01:51:54", "text": "1、2、3、そんな感じ。 私が"}, {"type": "subtitle", "time": 6718.31, "timestamp": "01:51:58", "text": "テストしようとしているのは、"}]
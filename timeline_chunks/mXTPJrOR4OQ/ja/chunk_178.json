[{"type": "subtitle", "time": 10680.95, "timestamp": "02:58:00", "text": "Beamstreamというプラットフォームの存在に気付くようになりました。"}, {"type": "subtitle", "time": 10683.59, "timestamp": "02:58:03", "text": "ええと、Kickのようなストリーミングサービスに近いです"}, {"type": "subtitle", "time": 10686.95, "timestamp": "02:58:06", "text": "が、ネイティブの"}, {"type": "subtitle", "time": 10689.75, "timestamp": "02:58:09", "text": "マルチリーミング機能も備えています。 それで、"}, {"type": "subtitle", "time": 10692.07, "timestamp": "02:58:12", "text": "私もKickにフィードを送り始めたんです"}, {"type": "subtitle", "time": 10693.83, "timestamp": "02:58:13", "text": "。 だから、私が"}, {"type": "subtitle", "time": 10699.67, "timestamp": "02:58:19", "text": "キックなどでストリーミングを始めて以来、もし私"}, {"type": "subtitle", "time": 10703.19, "timestamp": "02:58:23", "text": "のBeam Studioをお見せするとしたら、そう、Beamは"}, {"type": "subtitle", "time": 10707.03, "timestamp": "02:58:27", "text": "キックとTwitchフィードをBeamにも送信します"}, {"type": "subtitle", "time": 10708.87, "timestamp": "02:58:28", "text": "。 ええ、"}, {"type": "subtitle", "time": 10711.59, "timestamp": "02:58:31", "text": "もう YouTube には送信されていません。YouTube の 1 つが"}, {"type": "subtitle", "time": 10715.83, "timestamp": "02:58:35", "text": "正常に機能しないからです。つまり、"}, {"type": "subtitle", "time": 10719.91, "timestamp": "02:58:39", "text": "私が Jok をやっているので、"}, {"type": "subtitle", "time": 10722.23, "timestamp": "02:58:42", "text": "毎日ライブ配信をしなければならず、24 時間"}, {"type": "subtitle", "time": 10725.349, "timestamp": "02:58:45", "text": "7 日ライブ配信をしなければなりません。私が気づいたのは、"}, {"type": "subtitle", "time": 10728.71, "timestamp": "02:58:48", "text": "ここに表示されているように、"}, {"type": "subtitle", "time": 10731.269, "timestamp": "02:58:51", "text": "ライブ配信中と表示されていて、YouTube フィードは"}, {"type": "subtitle", "time": 10734.309, "timestamp": "02:58:54", "text": "ライブ配信されているのですが、YouTube の視聴者がストリームを見ることができない場合があり、途切れたりします"}, {"type": "subtitle", "time": 10737.349, "timestamp": "02:58:57", "text": "。"}]
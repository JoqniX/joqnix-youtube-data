[{"type": "subtitle", "time": 19010.07, "timestamp": "05:16:50", "text": "サーバーは良好です。"}, {"type": "subtitle", "time": 19012.47, "timestamp": "05:16:52", "text": "俺が持ってるもの、"}, {"type": "subtitle", "time": 19016.07, "timestamp": "05:16:56", "text": "兄弟、俺は殺したいんだ。 それで、一体俺は何を"}, {"type": "subtitle", "time": 19017.59, "timestamp": "05:16:57", "text": "言ってるんだ、兄弟？ 一体どういうことだ？ 本当に"}, {"type": "subtitle", "time": 19019.99, "timestamp": "05:16:59", "text": "イライラする。 本当にイライラする。 本当に"}]
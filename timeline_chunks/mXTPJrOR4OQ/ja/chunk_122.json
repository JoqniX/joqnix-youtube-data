[{"type": "subtitle", "time": 7329.669, "timestamp": "02:02:09", "text": "ズームインし、Twitch"}, {"type": "subtitle", "time": 7333.03, "timestamp": "02:02:13", "text": "Twitch のチャットも表示します。 これに気づきましたか？"}, {"type": "subtitle", "time": 7336.629, "timestamp": "02:02:16", "text": "話題になっている人たちは皆、"}, {"type": "subtitle", "time": 7341.189, "timestamp": "02:02:21", "text": "チャットユーザーのアバターを引っ張ってここに表示します"}, {"type": "subtitle", "time": 7345.99, "timestamp": "02:02:25", "text": "。 すごくいいね。"}, {"type": "subtitle", "time": 7348.629, "timestamp": "02:02:28", "text": "それは実に革新的な方法ですね。"}, {"type": "subtitle", "time": 7350.87, "timestamp": "02:02:30", "text": "話題性が高まれば高まるほど、より多くの人が"}, {"type": "subtitle", "time": 7352.87, "timestamp": "02:02:32", "text": "情報やサービス、"}, {"type": "chat", "time": 7354.327, "timestamp": "02:02:34", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "ohh"}, {"type": "subtitle", "time": 7355.27, "timestamp": "02:02:35", "text": "購読料などを送ってくるようになる。 彼らの装置は、"}, {"type": "subtitle", "time": 7357.83, "timestamp": "02:02:37", "text": "列車自体の中に何らかの"}, {"type": "subtitle", "time": 7360.709, "timestamp": "02:02:40", "text": "装置として設置されるだろう。"}, {"type": "subtitle", "time": 7362.55, "timestamp": "02:02:42", "text": "うん。 ギフトとしてサブスクリプションを受け取ったりする際には、必ず"}, {"type": "subtitle", "time": 7364.87, "timestamp": "02:02:44", "text": "あなたのアバターが表示されます"}, {"type": "subtitle", "time": 7372.07, "timestamp": "02:02:52", "text": "。 うん。 それから、"}, {"type": "subtitle", "time": 7374.07, "timestamp": "02:02:54", "text": "音声ベースの何かのような"}, {"type": "chat", "time": 7376.551, "timestamp": "02:02:56", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "you can pick other peoples source code as well ?"}, {"type": "subtitle", "time": 7376.629, "timestamp": "02:02:56", "text": "ものを使っている人もいます。"}, {"type": "subtitle", "time": 7379.27, "timestamp": "02:02:59", "text": "他の人のものを選ぶこともできます。"}]
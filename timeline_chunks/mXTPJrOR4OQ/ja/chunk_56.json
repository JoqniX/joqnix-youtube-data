[{"type": "subtitle", "time": 3362.549, "timestamp": "00:56:02", "text": "V2 Studioを開いている時だけですか？"}, {"type": "subtitle", "time": 3366.069, "timestamp": "00:56:06", "text": "API関連の機能をオフにしてみることは試しましたか？"}, {"type": "subtitle", "time": 3369.109, "timestamp": "00:56:09", "text": "APIをオフにする。"}, {"type": "subtitle", "time": 3371.19, "timestamp": "00:56:11", "text": "それで確認してみましたか？"}, {"type": "subtitle", "time": 3373.75, "timestamp": "00:56:13", "text": "もしくは、"}, {"type": "subtitle", "time": 3375.91, "timestamp": "00:56:15", "text": "注ぎ口の捕捉に問題があるかどうか確認しましたか？  Spout を使用して"}, {"type": "subtitle", "time": 3379.349, "timestamp": "00:56:19", "text": "数字をキャプチャしている場合は、"}, {"type": "subtitle", "time": 3385.03, "timestamp": "00:56:25", "text": "OBS のヘルプにあるヘルプに移動して"}, {"type": "subtitle", "time": 3392.15, "timestamp": "00:56:32", "text": "ログを確認し、OBS 内のログ ファイルを表示して一番下まで"}, {"type": "subtitle", "time": 3395.19, "timestamp": "00:56:35", "text": "スクロールすると"}, {"type": "chat", "time": 3396.145, "timestamp": "00:56:36", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "let me check"}, {"type": "subtitle", "time": 3399.109, "timestamp": "00:56:39", "text": "問題がわかります。"}, {"type": "subtitle", "time": 3402.15, "timestamp": "00:56:42", "text": "うん。 クラッシュログなどがあれば教えてください"}, {"type": "subtitle", "time": 3404.47, "timestamp": "00:56:44", "text": "。 いいえ、DMで送ってください。 確認してみます"}, {"type": "subtitle", "time": 3407.109, "timestamp": "00:56:47", "text": "。"}, {"type": "subtitle", "time": 3410.39, "timestamp": "00:56:50", "text": "クラッシュログなどがないか確認してみてください。"}, {"type": "subtitle", "time": 3412.309, "timestamp": "00:56:52", "text": "ええ、"}, {"type": "subtitle", "time": 3416.309, "timestamp": "00:56:56", "text": "YouTube Studio をどのようにキャプチャしているかはわかりませんが、OBS と V"}, {"type": "subtitle", "time": 3419.67, "timestamp": "00:56:59", "text": "シューターは、OB が"}]
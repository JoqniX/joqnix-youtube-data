[{"type": "subtitle", "time": 3423.67, "timestamp": "00:57:03", "text": "YouTube Studio のせいでクラッシュしないようにする必要があります。Spout に"}, {"type": "subtitle", "time": 3434.15, "timestamp": "00:57:14", "text": "関連するものか、"}, {"type": "subtitle", "time": 3442.15, "timestamp": "00:57:22", "text": "OBS と Studio でアクティブに何かを行うものに関連するものでない限り、クラッシュする可能性はありません。"}, {"type": "subtitle", "time": 3446.069, "timestamp": "00:57:26", "text": "ええ、でも"}, {"type": "subtitle", "time": 3448.87, "timestamp": "00:57:28", "text": "クラッシュする理由は特にないですよね。"}, {"type": "subtitle", "time": 3451.75, "timestamp": "00:57:31", "text": "また、V2 Studioでは、"}, {"type": "subtitle", "time": 3455.03, "timestamp": "00:57:35", "text": "BU Studioに"}, {"type": "subtitle", "time": 3458.549, "timestamp": "00:57:38", "text": "GPUの優先度を高く設定しないようにしてください。 一番"}, {"type": "subtitle", "time": 3462.069, "timestamp": "00:57:42", "text": "上の設定項目は「GPU優先度を設定する」です。"}, {"type": "subtitle", "time": 3465.03, "timestamp": "00:57:45", "text": "これが外れていることを願っています。  50枚組CDカードまたは40枚組CDカードをお持ちの場合は"}, {"type": "subtitle", "time": 3467.99, "timestamp": "00:57:47", "text": "、この設定をオンにしたままにしてください。 大丈夫です。"}, {"type": "subtitle", "time": 3471.67, "timestamp": "00:57:51", "text": "VRAM容量がかなり多いですね。"}, {"type": "subtitle", "time": 3473.75, "timestamp": "00:57:53", "text": "高性能なPCなので、問題ないはずです"}]
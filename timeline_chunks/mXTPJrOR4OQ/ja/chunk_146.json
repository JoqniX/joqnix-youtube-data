[{"type": "subtitle", "time": 8761.349, "timestamp": "02:26:01", "text": "ああ、それは私にとっては簡単だ。だって、それは生まれつき備わっているものだから。"}, {"type": "subtitle", "time": 8765.429, "timestamp": "02:26:05", "text": "ええと、プラグキンは必要ありません。 ええ、"}, {"type": "subtitle", "time": 8767.83, "timestamp": "02:26:07", "text": "いろいろ見せてください。 とても素敵だよ、ディオ。 よく考えてみれば"}, {"type": "subtitle", "time": 8769.91, "timestamp": "02:26:09", "text": "、"}, {"type": "subtitle", "time": 8772.55, "timestamp": "02:26:12", "text": "自分が何をしているのか分かっていれば、でも私がやっていることはたいていもっと"}, {"type": "subtitle", "time": 8775.59, "timestamp": "02:26:15", "text": "単純なことで、複雑なことは何もない。でも"}, {"type": "subtitle", "time": 8779.429, "timestamp": "02:26:19", "text": "裏側では、もし私が本当にそうしたければ、"}, {"type": "subtitle", "time": 8782.389, "timestamp": "02:26:22", "text": "Nati のように、"}, {"type": "subtitle", "time": 8785.27, "timestamp": "02:26:25", "text": "Nutty のように自分のことをやっていたんだ。Nuty には、私が"}, {"type": "subtitle", "time": 8792.23, "timestamp": "02:26:32", "text": "友達と呼んでいる、"}, {"type": "subtitle", "time": 8795.03, "timestamp": "02:26:35", "text": "コミュニティのためにたくさんのものがあって、人々は"}, {"type": "subtitle", "time": 8798.63, "timestamp": "02:26:38", "text": "物を引き換えたりできるんだ。え？ しかし、ここにもまた"}, {"type": "subtitle", "time": 8801.67, "timestamp": "02:26:41", "text": "問題がある。"}, {"type": "subtitle", "time": 8803.91, "timestamp": "02:26:43", "text": "Twitchでそれを許可するなら、キックはどうなるだろうか？"}, {"type": "subtitle", "time": 8806.71, "timestamp": "02:26:46", "text": "YouTubeはどうですか？ 信憑性についてはどうでしょうか？"}, {"type": "subtitle", "time": 8808.63, "timestamp": "02:26:48", "text": "あの人たちはどうやって"}, {"type": "subtitle", "time": 8811.11, "timestamp": "02:26:51", "text": "私の配信で何かを起こすつもりなんだろう"}, {"type": "subtitle", "time": 8813.83, "timestamp": "02:26:53", "text": "？ 右？ だから私は「"}, {"type": "subtitle", "time": 8817.51, "timestamp": "02:26:57", "text": "ああ、平等なんてないんだ」と思ったんです。"}, {"type": "subtitle", "time": 8819.91, "timestamp": "02:26:59", "text": "みんなにやってほしい。 視聴しているプラ​​ットフォームが何であれ、どのプラットフォームからでも、皆さんが参加できます"}]
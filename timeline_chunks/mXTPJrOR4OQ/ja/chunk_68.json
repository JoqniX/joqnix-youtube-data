[{"type": "subtitle", "time": 4085.19, "timestamp": "01:08:05", "text": "ああ、神様。 ええ、"}, {"type": "subtitle", "time": 4092.789, "timestamp": "01:08:12", "text": "OBSがリリースしていることは知っています。31.1が"}, {"type": "subtitle", "time": 4096.229, "timestamp": "01:08:16", "text": "最近リリースされました。 それは、もう"}, {"type": "subtitle", "time": 4101.11, "timestamp": "01:08:21", "text": "リリースされています。"}, {"type": "subtitle", "time": 4104.229, "timestamp": "01:08:24", "text": "待って、31 えーと 31.2 は既にリリースされていると"}, {"type": "subtitle", "time": 4106.709, "timestamp": "01:08:26", "text": "思います。現在、私の理解が正しければ、そうですよね。ええ、忘れました。ええ、ええ、"}, {"type": "subtitle", "time": 4112.229, "timestamp": "01:08:32", "text": "将来、候補者に尋ねます。"}, {"type": "subtitle", "time": 4118.07, "timestamp": "01:08:38", "text": "すべてがうまくいっているかどうかを確認するテストも行います。ええと、"}, {"type": "subtitle", "time": 4120.95, "timestamp": "01:08:40", "text": "友人が経験したような問題は私にはありませんでした。ええと、"}, {"type": "subtitle", "time": 4126.95, "timestamp": "01:08:46", "text": "彼らのハードウェア、"}, {"type": "subtitle", "time": 4131.829, "timestamp": "01:08:51", "text": "CPU、GPU などを確認してください。ええ、"}, {"type": "subtitle", "time": 4135.91, "timestamp": "01:08:55", "text": "PC が完全にバルク化されていて、"}]
[{"type": "subtitle", "time": 4746.79, "timestamp": "01:19:06", "text": "ファミリーセール中だ"}, {"type": "subtitle", "time": 4750.229, "timestamp": "01:19:10", "text": "けど、ベータ版の時に29ドルで買ったよ"}, {"type": "subtitle", "time": 4751.75, "timestamp": "01:19:11", "text": "。"}, {"type": "subtitle", "time": 4754.709, "timestamp": "01:19:14", "text": "ベータ版ユーザーは、リリースされたときに特典を受けられました。"}, {"type": "subtitle", "time": 4761.189, "timestamp": "01:19:21", "text": "これはVST3"}, {"type": "subtitle", "time": 4764.07, "timestamp": "01:19:24", "text": "プラグインで、古いVSTの機能も備えています"}, {"type": "subtitle", "time": 4769.99, "timestamp": "01:19:29", "text": "VST3 の良いところは、"}, {"type": "subtitle", "time": 4773.91, "timestamp": "01:19:33", "text": "VST3 3 の良いところは、えっと、"}, {"type": "subtitle", "time": 4777.43, "timestamp": "01:19:37", "text": "これはサイズ変更できません。 ああ、"}, {"type": "subtitle", "time": 4782.31, "timestamp": "01:19:42", "text": "気にしないで。 ええ、通常、VSC3 プラグインでは、"}, {"type": "subtitle", "time": 4785.51, "timestamp": "01:19:45", "text": "ウィンドウのサイズ変更などを行うことができます。"}]
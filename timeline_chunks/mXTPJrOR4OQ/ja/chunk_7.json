[{"type": "subtitle", "time": 430.07, "timestamp": "00:07:10", "text": "神に誓って。"}, {"type": "subtitle", "time": 442.79, "timestamp": "00:07:22", "text": "このアプリはうんざりだ、兄弟。"}, {"type": "subtitle", "time": 444.79, "timestamp": "00:07:24", "text": "このアプリはもう使いません。 この"}, {"type": "subtitle", "time": 447.589, "timestamp": "00:07:27", "text": "アプリはもう完全にうんざりだ。"}, {"type": "subtitle", "time": 451.029, "timestamp": "00:07:31", "text": "このアプリケーションをリセットします。"}, {"type": "subtitle", "time": 470.55, "timestamp": "00:07:50", "text": "ボディ。 来て。 見通し。"}, {"type": "subtitle", "time": 477.67, "timestamp": "00:07:57", "text": "親切にしましょう。 見通し。   今この瞬間に"}]
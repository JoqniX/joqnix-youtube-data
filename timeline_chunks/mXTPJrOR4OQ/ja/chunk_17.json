[{"type": "subtitle", "time": 1020.949, "timestamp": "00:17:00", "text": "これを正しい言葉でどう言えばいいでしょうか"}, {"type": "subtitle", "time": 1021.91, "timestamp": "00:17:01", "text": "？   私がやりたいこと"}, {"type": "subtitle", "time": 1024.309, "timestamp": "00:17:04", "text": "。"}, {"type": "subtitle", "time": 1027.75, "timestamp": "00:17:07", "text": "なぜ英語は時々こんなに難しいのだろう？"}, {"type": "subtitle", "time": 1032.309, "timestamp": "00:17:12", "text": "何か言いたいことがあるんだけど、適切な言葉、"}, {"type": "subtitle", "time": 1037.59, "timestamp": "00:17:17", "text": "適切な表現が"}, {"type": "subtitle", "time": 1041.38, "timestamp": "00:17:21", "text": "頭から出てこないんだ。"}]
[{"type": "subtitle", "time": 8941.11, "timestamp": "02:29:01", "text": "全員の"}, {"type": "subtitle", "time": 8946.71, "timestamp": "02:29:06", "text": "メッセージが同じなら、"}, {"type": "subtitle", "time": 8948.389, "timestamp": "02:29:08", "text": "そのメッセージを使用します。"}, {"type": "subtitle", "time": 8950.23, "timestamp": "02:29:10", "text": "条件付きコマンドがたくさんあるし、彼がやったかもしれないこともたくさんある"}, {"type": "chat", "time": 8950.596, "timestamp": "02:29:10", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "mhm"}, {"type": "subtitle", "time": 8952.389, "timestamp": "02:29:12", "text": "。"}, {"type": "subtitle", "time": 8954.95, "timestamp": "02:29:14", "text": "なあ、"}, {"type": "subtitle", "time": 8958.63, "timestamp": "02:29:18", "text": "今退屈してる時は、何かを再現したくなる気分なんだ。"}, {"type": "subtitle", "time": 8960.469, "timestamp": "02:29:20", "text": "何かを再現したい。 それも一つの"}, {"type": "subtitle", "time": 8963.349, "timestamp": "02:29:23", "text": "学習方法ですよね？"}, {"type": "subtitle", "time": 8965.11, "timestamp": "02:29:25", "text": "それって、確かに学ぶ方法の一つですよね"}, {"type": "subtitle", "time": 8967.99, "timestamp": "02:29:27", "text": "？ 他の人がやっているのを見れば、"}, {"type": "subtitle", "time": 8970.309, "timestamp": "02:29:30", "text": "学ぶことができる。"}, {"type": "subtitle", "time": 8973.19, "timestamp": "02:29:33", "text": "それを再現することで学んでみてください。 それが芸術の作り方だ。"}, {"type": "subtitle", "time": 8975.19, "timestamp": "02:29:35", "text": "音楽ってそういう風に作られるものだよね？"}, {"type": "subtitle", "time": 8977.03, "timestamp": "02:29:37", "text": "彼らはあなたの好きな"}, {"type": "subtitle", "time": 8988.71, "timestamp": "02:29:48", "text": "ストリーム配信で人々が行う革新的なことについても同じことが言えます。 彼は"}, {"type": "subtitle", "time": 8999.03, "timestamp": "02:29:59", "text": "君が何かを作っていると、僕は退屈して"}]
[{"type": "subtitle", "time": 2701.27, "timestamp": "00:45:01", "text": "本当に必要なものだと感じています。   ええと、"}, {"type": "subtitle", "time": 2706.309, "timestamp": "00:45:06", "text": "今日の目標は、"}, {"type": "subtitle", "time": 2714.309, "timestamp": "00:45:14", "text": "バックエンドの"}, {"type": "subtitle", "time": 2717.19, "timestamp": "00:45:17", "text": "テストに進むことができれば、昨日から作業を開始したことです。 はい、これに取り組み始めました。今のところ、"}, {"type": "subtitle", "time": 2723.75, "timestamp": "00:45:23", "text": "グローバル配信をしているかどうかを確認する機能があります。 ええ、"}, {"type": "subtitle", "time": 2725.75, "timestamp": "00:45:25", "text": "グローバルコマンドもすべて変更する必要があります。"}, {"type": "subtitle", "time": 2727.91, "timestamp": "00:45:27", "text": "昨日、私を助けてくれたSammyサポートのモデレーターたちと話した後、それに気づきました"}, {"type": "subtitle", "time": 2732.71, "timestamp": "00:45:32", "text": "。 ヘルパーは、"}, {"type": "subtitle", "time": 2738.87, "timestamp": "00:45:38", "text": "グローバルコマンドの使用は、すでに持っているグローバル変数の"}, {"type": "subtitle", "time": 2746.069, "timestamp": "00:45:46", "text": "1つを使用する拡張機能をインストールした場合など、厄介な場合があると述べていました"}, {"type": "subtitle", "time": 2751.67, "timestamp": "00:45:51", "text": "。 万が一のために、それは入れておきたくない"}, {"type": "subtitle", "time": 2753.91, "timestamp": "00:45:53", "text": "。 そんなことをする"}, {"type": "subtitle", "time": 2755.589, "timestamp": "00:45:55", "text": "人はいないと確信しています。"}, {"type": "subtitle", "time": 2758.23, "timestamp": "00:45:58", "text": "私が入力した名前と同じですが、"}]
[{"type": "subtitle", "time": 8340.549, "timestamp": "02:19:00", "text": "ストリームはどこにあるの？ どこですか？"}, {"type": "subtitle", "time": 8342.389, "timestamp": "02:19:02", "text": "うん。 うん。 私には「"}, {"type": "subtitle", "time": 8345.83, "timestamp": "02:19:05", "text": "緊急パニックボタン」というボタンがありました。 つまり、"}, {"type": "subtitle", "time": 8350.629, "timestamp": "02:19:10", "text": "うっかり見せてはいけないものを露出してしまった時に、スクリーンショットを撮ってくれるということです"}, {"type": "subtitle", "time": 8353.429, "timestamp": "02:19:13", "text": "。 つまり、"}, {"type": "subtitle", "time": 8356.549, "timestamp": "02:19:16", "text": "画面がぼかしモードになるはずの時はいつでも、"}, {"type": "subtitle", "time": 8359.509, "timestamp": "02:19:19", "text": "ぼかしが始まる前に写真を撮ってしまうということです"}, {"type": "subtitle", "time": 8361.19, "timestamp": "02:19:21", "text": "。"}, {"type": "subtitle", "time": 8363.11, "timestamp": "02:19:23", "text": "うん。 うん。 画面。 これは、"}, {"type": "subtitle", "time": 8365.75, "timestamp": "02:19:25", "text": "OBSのスクリーンショットをDiscordに送信するスクリーンショットです"}, {"type": "subtitle", "time": 8369.669, "timestamp": "02:19:29", "text": "。 ええと、文字通り、私は"}, {"type": "subtitle", "time": 8372.389, "timestamp": "02:19:32", "text": "ここでストリーマーボットを使用していません。 ここでは、私が"}, {"type": "subtitle", "time": 8376.549, "timestamp": "02:19:36", "text": "購入したエクステンション付きのSammyを使用しています。 そう、"}, {"type": "subtitle", "time": 8383.91, "timestamp": "02:19:43", "text": "うん。 えーと、アナティはゼルダの伝説 時のオリアナの"}, {"type": "subtitle", "time": 8387.19, "timestamp": "02:19:47", "text": "ビデオを持っています。"}, {"type": "subtitle", "time": 8390.95, "timestamp": "02:19:50", "text": "必要であれば、それを使っても構いません。 本当に素晴らしい。"}, {"type": "subtitle", "time": 8392.95, "timestamp": "02:19:52", "text": "物を見せてください。"}, {"type": "subtitle", "time": 8395.99, "timestamp": "02:19:55", "text": "Streamer Botのチュートリアル動画を見なきゃ"}, {"type": "subtitle", "time": 8398.469, "timestamp": "02:19:58", "text": "。 ストリーマーの"}]
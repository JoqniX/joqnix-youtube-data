[{"type": "subtitle", "time": 2461.75, "timestamp": "00:41:01", "text": "。 右？ それで、"}, {"type": "subtitle", "time": 2465.03, "timestamp": "00:41:05", "text": "これらのウェブボタンの中には、何の"}, {"type": "subtitle", "time": 2466.71, "timestamp": "00:41:06", "text": "トリガーも存在しないのにスパムのように連投し続けるものがあることに気づきました。"}, {"type": "subtitle", "time": 2471.03, "timestamp": "00:41:11", "text": "例えば、"}, {"type": "subtitle", "time": 2478.39, "timestamp": "00:41:18", "text": "OBS ソース（"}, {"type": "subtitle", "time": 2480.71, "timestamp": "00:41:20", "text": "OBS は使っていませんが、技術的には"}, {"type": "subtitle", "time": 2484.15, "timestamp": "00:41:24", "text": "OBS ソース、つまりマイクなど）がミュートされているか、"}, {"type": "subtitle", "time": 2487.109, "timestamp": "00:41:27", "text": "話しているか、何かであるかどうかを 3 秒ごとにチェックするボタンが欲しいとします。ミュートされているか、アクティブか、可視性など、"}, {"type": "subtitle", "time": 2493.19, "timestamp": "00:41:33", "text": "すべてをチェックします。実際に"}, {"type": "subtitle", "time": 2495.829, "timestamp": "00:41:35", "text": "チェックしていて、"}, {"type": "subtitle", "time": 2497.829, "timestamp": "00:41:37", "text": "Twitch や YouTube などのプラットフォーム チャットに「"}, {"type": "subtitle", "time": 2503.109, "timestamp": "00:41:43", "text": "Jo のマイクがミュートされています」と伝えるチャット コマンドがあります。3"}, {"type": "subtitle", "time": 2505.43, "timestamp": "00:41:45", "text": "秒ごとに実行されると、明らかに"}, {"type": "subtitle", "time": 2508.15, "timestamp": "00:41:48", "text": "スパムになります。それは望んでいないので、"}, {"type": "subtitle", "time": 2512.23, "timestamp": "00:41:52", "text": "メッセージを 1 回だけ送信したいのです。1 回送信したら、"}, {"type": "subtitle", "time": 2518.95, "timestamp": "00:41:58", "text": "メッセージは送信されず、何度も何度も"}]
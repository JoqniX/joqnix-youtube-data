[{"type": "subtitle", "time": 8280.15, "timestamp": "02:18:00", "text": "ものです。"}, {"type": "subtitle", "time": 8282.15, "timestamp": "02:18:02", "text": "こちらの方に物体が見えます。"}, {"type": "subtitle", "time": 8284.629, "timestamp": "02:18:04", "text": "あなたには見えるかどうか分かりません。"}, {"type": "subtitle", "time": 8287.19, "timestamp": "02:18:07", "text": "ズームインしすぎだよ、兄弟。"}, {"type": "subtitle", "time": 8289.589, "timestamp": "02:18:09", "text": "はい、これは埋め込みオブジェクトの"}, {"type": "subtitle", "time": 8291.349, "timestamp": "02:18:11", "text": "すべてです。"}, {"type": "subtitle", "time": 8294.469, "timestamp": "02:18:14", "text": "これは私がそれをやっていた時の話です。 昔の話だけど、当時"}, {"type": "subtitle", "time": 8296.87, "timestamp": "02:18:16", "text": "僕のOBSはピンク色だったんだよ。"}, {"type": "subtitle", "time": 8299.99, "timestamp": "02:18:19", "text": "カワイイ版。"}, {"type": "subtitle", "time": 8303.03, "timestamp": "02:18:23", "text": "私はこれを覚えています。 ああ、私の"}, {"type": "subtitle", "time": 8306.629, "timestamp": "02:18:26", "text": "持ち物を見てください。 当時、私がどれだけのオーディオトラックを持っていたか見てください"}, {"type": "subtitle", "time": 8309.429, "timestamp": "02:18:29", "text": "。 いつもと変わらない。 その"}, {"type": "subtitle", "time": 8313.509, "timestamp": "02:18:33", "text": "時は、Twitchにしか集中していませんでした。"}, {"type": "subtitle", "time": 8315.83, "timestamp": "02:18:35", "text": "うん。 オーディオモニターとダウンリンクはこちら。   それでも、"}, {"type": "subtitle", "time": 8319.27, "timestamp": "02:18:39", "text": "私は"}, {"type": "subtitle", "time": 8321.75, "timestamp": "02:18:41", "text": "あのプラグインたちをどうしても受け入れることができません。"}, {"type": "subtitle", "time": 8326.07, "timestamp": "02:18:46", "text": "これは明らかに27.2.4にあったすべてです。"}, {"type": "subtitle", "time": 8328.629, "timestamp": "02:18:48", "text": "それはずいぶん昔の話だ。"}, {"type": "subtitle", "time": 8332.07, "timestamp": "02:18:52", "text": "だから、明らかに27番だったんだ。"}]
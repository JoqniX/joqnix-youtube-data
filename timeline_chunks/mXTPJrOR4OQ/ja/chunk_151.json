[{"type": "subtitle", "time": 9061.59, "timestamp": "02:31:01", "text": "アクティビティ、つまり"}, {"type": "subtitle", "time": 9065.19, "timestamp": "02:31:05", "text": "アクティビティのようなものです。"}, {"type": "subtitle", "time": 9066.71, "timestamp": "02:31:06", "text": "ええ、私は「"}, {"type": "subtitle", "time": 9068.87, "timestamp": "02:31:08", "text": "よし、全力を尽くして、諦める」という感じでした。それが、私が"}, {"type": "chat", "time": 9070.236, "timestamp": "02:31:10", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "listen i can give full focus for like an hour then i give up"}, {"type": "subtitle", "time": 9074.469, "timestamp": "02:31:14", "text": "始めた頃の私です。私は「"}, {"type": "subtitle", "time": 9077.91, "timestamp": "02:31:17", "text": "疲れすぎて、頭が働かない」と思っていました。そして、"}, {"type": "subtitle", "time": 9082.469, "timestamp": "02:31:22", "text": "誰も来てスプーンで食べさせてくれるわけではないと気づきました。"}, {"type": "subtitle", "time": 9087.59, "timestamp": "02:31:27", "text": "誰も"}, {"type": "subtitle", "time": 9090.79, "timestamp": "02:31:30", "text": "私に手取り足取り教えてくれるわけじゃないよね？ つまり、私が"}, {"type": "subtitle", "time": 9094.389, "timestamp": "02:31:34", "text": "理解したことは、もしそれができないなら、もし"}, {"type": "subtitle", "time": 9097.19, "timestamp": "02:31:37", "text": "それをする忍耐力がないなら、"}, {"type": "subtitle", "time": 9099.59, "timestamp": "02:31:39", "text": "自分で考え出して、自分の必要なもののために自分の"}, {"type": "subtitle", "time": 9103.349, "timestamp": "02:31:43", "text": "コマンドボタンなどを構築しよう、ということです"}, {"type": "subtitle", "time": 9106.07, "timestamp": "02:31:46", "text": "。 では、もし私がそれを"}, {"type": "subtitle", "time": 9108.55, "timestamp": "02:31:48", "text": "他の人に依頼する場合、それは"}, {"type": "subtitle", "time": 9110.389, "timestamp": "02:31:50", "text": "手数料になるということですよね？"}, {"type": "subtitle", "time": 9112.71, "timestamp": "02:31:52", "text": "この"}, {"type": "subtitle", "time": 9114.79, "timestamp": "02:31:54", "text": "コマンドやボタンなどを作って、"}, {"type": "subtitle", "time": 9118.469, "timestamp": "02:31:58", "text": "私に送ってもらうように誰かに依頼するんですよね？ それが私が学んだことです。"}]
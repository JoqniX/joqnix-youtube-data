[{"type": "subtitle", "time": 7140.39, "timestamp": "01:59:00", "text": "もし人々が作ったものを見たいなら"}, {"type": "subtitle", "time": 7142.149, "timestamp": "01:59:02", "text": "、"}, {"type": "subtitle", "time": 7146.229, "timestamp": "01:59:06", "text": "えっと、人々はこのポケモン"}, {"type": "subtitle", "time": 7150.95, "timestamp": "01:59:10", "text": "ブースターを作っています。 読み込めたら一緒に見ましょう"}, {"type": "subtitle", "time": 7153.27, "timestamp": "01:59:13", "text": "。"}, {"type": "subtitle", "time": 7156.709, "timestamp": "01:59:16", "text": "これはライブ配信中です。"}, {"type": "subtitle", "time": 7160.31, "timestamp": "01:59:20", "text": "君は何かを持っている。 このカードが表示されます。"}, {"type": "chat", "time": 7162.005, "timestamp": "01:59:22", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "it helps automate the process hmm"}, {"type": "subtitle", "time": 7163.91, "timestamp": "01:59:23", "text": "ええと、それは変化を示しています。 ここへ行き、"}, {"type": "subtitle", "time": 7166.87, "timestamp": "01:59:26", "text": "あそこへ行き、通貨のようなものを表示します。 はい、"}, {"type": "subtitle", "time": 7170.149, "timestamp": "01:59:30", "text": "これはすべてSammyの中にプログラムされていて、"}, {"type": "subtitle", "time": 7172.149, "timestamp": "01:59:32", "text": "明白なことばかりです。"}, {"type": "subtitle", "time": 7176.79, "timestamp": "01:59:36", "text": "うん。 ええ、その人が"}, {"type": "subtitle", "time": 7179.669, "timestamp": "01:59:39", "text": "これらのポケモンカードを個別の画像として追加し"}, {"type": "subtitle", "time": 7182.629, "timestamp": "01:59:42", "text": "、このソースは特定の仕様の特定の"}, {"type": "subtitle", "time": 7188.39, "timestamp": "01:59:48", "text": "位置に移動され、その他すべてが行われています"}, {"type": "subtitle", "time": 7191.75, "timestamp": "01:59:51", "text": "。 えーと、"}, {"type": "subtitle", "time": 7194.87, "timestamp": "01:59:54", "text": "OBSを使っているから、"}, {"type": "subtitle", "time": 7197.83, "timestamp": "01:59:57", "text": "移動トランジションプラグインなど、たくさんのプラグインを追加して"}]
[{"type": "subtitle", "time": 8040.95, "timestamp": "02:14:00", "text": "基づいたカメラのAR効果を顔に表示できます"}, {"type": "subtitle", "time": 8043.109, "timestamp": "02:14:03", "text": "。 ええ、これは文字通り"}, {"type": "subtitle", "time": 8045.99, "timestamp": "02:14:05", "text": "彼の顔の画面キャプチャ、もしくはウィンドウキャプチャみたいなものですよ"}, {"type": "subtitle", "time": 8049.589, "timestamp": "02:14:09", "text": "ね？ あれ、分かりますか？"}, {"type": "subtitle", "time": 8051.99, "timestamp": "02:14:11", "text": "えっと、"}, {"type": "subtitle", "time": 8054.069, "timestamp": "02:14:14", "text": "Among Usってゲームはどこにあるの？"}, {"type": "subtitle", "time": 8061.109, "timestamp": "02:14:21", "text": "ああ、これだ。 誰かが"}, {"type": "subtitle", "time": 8063.35, "timestamp": "02:14:23", "text": "タイムアウトになったり、アカウントを停止されたりすると、そのメッセージが表示されます"}, {"type": "chat", "time": 8064.463, "timestamp": "02:14:24", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "ohh"}, {"type": "subtitle", "time": 8065.109, "timestamp": "02:14:25", "text": "。"}, {"type": "subtitle", "time": 8068.069, "timestamp": "02:14:28", "text": "待って、待って。 彼がそうするのを待ちましょう。"}, {"type": "subtitle", "time": 8071.91, "timestamp": "02:14:31", "text": "ええ、誰かがアカウント停止処分を受けました。"}, {"type": "subtitle", "time": 8075.27, "timestamp": "02:14:35", "text": "ほら、君にもこういうことができるんだよ。 それはとても"}, {"type": "subtitle", "time": 8078.47, "timestamp": "02:14:38", "text": "革新的で、ええ、"}, {"type": "subtitle", "time": 8082.149, "timestamp": "02:14:42", "text": "Insami などでそれができます。 また、ナティは"}, {"type": "subtitle", "time": 8085.669, "timestamp": "02:14:45", "text": "チュートリアル動画もたくさん作っています。"}, {"type": "subtitle", "time": 8087.99, "timestamp": "02:14:47", "text": "Natiはこれらのことに関するチュートリアルをたくさん作成しており、"}, {"type": "subtitle", "time": 8093.51, "timestamp": "02:14:53", "text": "OBSのクリエイターでもあります。"}, {"type": "subtitle", "time": 8095.75, "timestamp": "02:14:55", "text": "チュートリアルとか、すごく"}, {"type": "chat", "time": 8096.755, "timestamp": "02:14:56", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "noice "}]
[{"type": "subtitle", "time": 7380.95, "timestamp": "02:03:00", "text": "つまり、"}, {"type": "subtitle", "time": 7388.229, "timestamp": "02:03:08", "text": "例えばふわふわの羊バサンが作った"}, {"type": "subtitle", "time": 7390.07, "timestamp": "02:03:10", "text": "ボタンや"}, {"type": "subtitle", "time": 7404.95, "timestamp": "02:03:24", "text": "でも、ほとんどの人はそんな風に無料でくれるわけではないので、"}, {"type": "subtitle", "time": 7409.91, "timestamp": "02:03:29", "text": "自分でやり方を学ぶ必要があります。自分で作るように言う人もいるでしょう。"}, {"type": "subtitle", "time": 7415.99, "timestamp": "02:03:35", "text": "だから、支援を求め"}, {"type": "subtitle", "time": 7418.149, "timestamp": "02:03:38", "text": "、"}, {"type": "subtitle", "time": 7423.189, "timestamp": "02:03:43", "text": "それを再現するために何ができるのか、その方法を学ぶ必要があるのです。 そうやって人は学ぶものですよね"}, {"type": "subtitle", "time": 7425.83, "timestamp": "02:03:45", "text": "？ いつでも人に頼むことはできますよね"}, {"type": "subtitle", "time": 7429.35, "timestamp": "02:03:49", "text": "？"}, {"type": "subtitle", "time": 7433.75, "timestamp": "02:03:53", "text": "ウェルカムメッセージもそこにあることを覚えておく必要があります。"}, {"type": "subtitle", "time": 7436.79, "timestamp": "02:03:56", "text": "買うか、作り方を学ぶかのどちらかだ。  「"}, {"type": "subtitle", "time": 7438.47, "timestamp": "02:03:58", "text": "買う」とはどういう意味ですか？"}]
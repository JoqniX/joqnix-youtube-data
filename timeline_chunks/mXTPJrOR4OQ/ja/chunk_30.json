[{"type": "subtitle", "time": 1814.549, "timestamp": "00:30:14", "text": "基本的な状況が出てきます。"}, {"type": "subtitle", "time": 1835.19, "timestamp": "00:30:35", "text": "神々の問題のために、"}, {"type": "subtitle", "time": 1841.269, "timestamp": "00:30:41", "text": "皆さんはバック"}, {"type": "subtitle", "time": 1844.23, "timestamp": "00:30:44", "text": "グラウンドミュージックを聴くことができますか？"}, {"type": "subtitle", "time": 1846.31, "timestamp": "00:30:46", "text": "聞こえるかどうか分かりませんが。"}, {"type": "subtitle", "time": 1848.549, "timestamp": "00:30:48", "text": "音量を少し上げたので、それほど"}, {"type": "subtitle", "time": 1851.51, "timestamp": "00:30:51", "text": "静かではありません。"}, {"type": "subtitle", "time": 1853.51, "timestamp": "00:30:53", "text": "わかりました。それに関しては、"}]
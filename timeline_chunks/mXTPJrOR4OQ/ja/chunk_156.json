[{"type": "subtitle", "time": 9360.87, "timestamp": "02:36:00", "text": "変数などをすべて入力する必要があります。 だから、"}, {"type": "subtitle", "time": 9370.309, "timestamp": "02:36:10", "text": "YouTube、Twitchのウィンドウ、ストリームみたいな画面の特定の部分をクリックすると、"}, {"type": "subtitle", "time": 9378.79, "timestamp": "02:36:18", "text": "画面上のどこでもスポーンして、これを表示して、これを非表示にする、"}, {"type": "subtitle", "time": 9381.99, "timestamp": "02:36:21", "text": "といったことができます。私は"}, {"type": "subtitle", "time": 9385.03, "timestamp": "02:36:25", "text": "Twitchの時代にこれをやっていました。ショーなど、以前はたくさんのことをやっていましたが、"}, {"type": "subtitle", "time": 9398.55, "timestamp": "02:36:38", "text": "そうそう。 フォロワーを獲得する。"}, {"type": "subtitle", "time": 9400.55, "timestamp": "02:36:40", "text": "うん。 うん。"}, {"type": "subtitle", "time": 9402.71, "timestamp": "02:36:42", "text": "フォロワーコマンド。"}, {"type": "subtitle", "time": 9404.95, "timestamp": "02:36:44", "text": "私についてきた人々は一体誰なのか？ これは"}, {"type": "subtitle", "time": 9406.95, "timestamp": "02:36:46", "text": "私のチャンネルをフォローしているフォロワーですか、それとも"}, {"type": "subtitle", "time": 9409.19, "timestamp": "02:36:49", "text": "Twitchでフォローしていないフォロワーですか？"}, {"type": "subtitle", "time": 9412.15, "timestamp": "02:36:52", "text": "ええ、これらはDiscord関連のものです。"}]
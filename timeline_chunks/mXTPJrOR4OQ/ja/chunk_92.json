[{"type": "subtitle", "time": 5522.629, "timestamp": "01:32:02", "text": "紐じゃないんだよ、兄弟。   私は"}, {"type": "subtitle", "time": 5529.43, "timestamp": "01:32:09", "text": "ああ、ここで間違いを犯してしまった。 そう、つまり、私は"}, {"type": "subtitle", "time": 5537.99, "timestamp": "01:32:17", "text": "再インストールして、その手順を実行してください。"}, {"type": "subtitle", "time": 5549.43, "timestamp": "01:32:29", "text": "つまり、"}, {"type": "subtitle", "time": 5552.629, "timestamp": "01:32:32", "text": "ボタンが1回実行されたというTwitchメッセージが送信されるということですよね？ もし"}, {"type": "subtitle", "time": 5555.91, "timestamp": "01:32:35", "text": "私がそれを再度実行したとしても、"}, {"type": "subtitle", "time": 5565.75, "timestamp": "01:32:45", "text": "ボタンが2回実行されました。  Twitchの"}, {"type": "subtitle", "time": 5569.59, "timestamp": "01:32:49", "text": "メッセージはまだ1つです。 良い。 良い。 それは"}, {"type": "subtitle", "time": 5574.229, "timestamp": "01:32:54", "text": "本当に素晴らしいですね。 もう一度実行してみます。"}, {"type": "subtitle", "time": 5576.629, "timestamp": "01:32:56", "text": "また。"}, {"type": "subtitle", "time": 5578.87, "timestamp": "01:32:58", "text": "依然として何も変化なし。"}]
[{"type": "subtitle", "time": 8700.23, "timestamp": "02:25:00", "text": "一つ複製してここに置きました。"}, {"type": "subtitle", "time": 8703.83, "timestamp": "02:25:03", "text": "すると、彼が行うこの線は、"}, {"type": "subtitle", "time": 8706.55, "timestamp": "02:25:06", "text": "この個々のソースが"}, {"type": "subtitle", "time": 8710.07, "timestamp": "02:25:10", "text": "直線上をゆっくりとゆっくりと増加しながら移動するようなものです"}, {"type": "subtitle", "time": 8712.63, "timestamp": "02:25:12", "text": "。 だから、その裏側について考えてみると、"}, {"type": "subtitle", "time": 8716.23, "timestamp": "02:25:16", "text": "彼は"}, {"type": "subtitle", "time": 8719.19, "timestamp": "02:25:19", "text": "変数をカウントアップしたり、"}, {"type": "subtitle", "time": 8722.95, "timestamp": "02:25:22", "text": "ランダム化したりなど、たくさんの処理を行った可能性があります。"}, {"type": "subtitle", "time": 8724.79, "timestamp": "02:25:24", "text": "そして、"}, {"type": "subtitle", "time": 8727.91, "timestamp": "02:25:27", "text": "このシーンでは、これは"}, {"type": "subtitle", "time": 8734.63, "timestamp": "02:25:34", "text": "finite singularity のコンポジット コンポジット ブラー プラグインで、"}, {"type": "subtitle", "time": 8738.71, "timestamp": "02:25:38", "text": "基本的に方向性ズームを行いました。これを"}, {"type": "subtitle", "time": 8741.83, "timestamp": "02:25:41", "text": "私の画面に表示できます。   えーと"}, {"type": "subtitle", "time": 8749.03, "timestamp": "02:25:49", "text": "、この一方向の"}, {"type": "subtitle", "time": 8752.55, "timestamp": "02:25:52", "text": "ぼかし。"}, {"type": "subtitle", "time": 8754.469, "timestamp": "02:25:54", "text": "そう、方向性のぼやけですね。"}, {"type": "subtitle", "time": 8758.389, "timestamp": "02:25:58", "text": "彼はまさにそうしたのだ。 ショーからショーへ。"}]
[{"type": "subtitle", "time": 10638.87, "timestamp": "02:57:18", "text": "最初にローンチした日、Kickがそれを公開した初日にKickアカウントを作成しましたが、きちんと"}, {"type": "subtitle", "time": 10644.79, "timestamp": "02:57:24", "text": "ストリーミングはしませんでした"}, {"type": "subtitle", "time": 10648.79, "timestamp": "02:57:28", "text": "。"}, {"type": "subtitle", "time": 10651.59, "timestamp": "02:57:31", "text": "以前、kick でマルチリーミング テストを行ったことがあります"}, {"type": "subtitle", "time": 10655.429, "timestamp": "02:57:35", "text": "が、あまり重点を置いていませんでした。"}, {"type": "subtitle", "time": 10657.91, "timestamp": "02:57:37", "text": "最近、"}, {"type": "subtitle", "time": 10661.269, "timestamp": "02:57:41", "text": "ジョアソン イベントを始めたときに、kick でストリーミングを開始しました"}, {"type": "subtitle", "time": 10665.91, "timestamp": "02:57:45", "text": "。 ええと、それは3月からになります。 うん。"}, {"type": "subtitle", "time": 10668.95, "timestamp": "02:57:48", "text": "うん。  3月以降、マルチ"}, {"type": "subtitle", "time": 10672.309, "timestamp": "02:57:52", "text": "ストリームフィードをキックにも送信し始めました"}, {"type": "subtitle", "time": 10673.59, "timestamp": "02:57:53", "text": "。"}, {"type": "subtitle", "time": 10676.389, "timestamp": "02:57:56", "text": "Beamstreamに切り替えて以来、"}]
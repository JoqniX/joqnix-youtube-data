[{"type": "subtitle", "time": 2701.27, "timestamp": "00:45:01", "text": "真正需要的。"}, {"type": "subtitle", "time": 2706.309, "timestamp": "00:45:06", "text": "嗯，是的，我们今天的目标是……"}, {"type": "subtitle", "time": 2709.349, "timestamp": "00:45:09", "text": "我昨天就开始做这件事了，"}, {"type": "subtitle", "time": 2714.309, "timestamp": "00:45:14", "text": "如果我可以进入后端"}, {"type": "subtitle", "time": 2717.19, "timestamp": "00:45:17", "text": "测试的话。 是的，我开始着手研究这个了，"}, {"type": "subtitle", "time": 2720.55, "timestamp": "00:45:20", "text": "目前我实现的功能是检查我是否在进行"}, {"type": "subtitle", "time": 2723.75, "timestamp": "00:45:23", "text": "全局流传输。 是的，我还需要"}, {"type": "subtitle", "time": 2725.75, "timestamp": "00:45:25", "text": "修改所有全局命令。"}, {"type": "subtitle", "time": 2727.91, "timestamp": "00:45:27", "text": "昨天我和 Sammy 的客服人员聊过之后才意识到这一点，他们"}, {"type": "subtitle", "time": 2732.71, "timestamp": "00:45:32", "text": "昨天一直在帮助我。 助手们"}, {"type": "subtitle", "time": 2735.109, "timestamp": "00:45:35", "text": "提到，"}, {"type": "subtitle", "time": 2738.87, "timestamp": "00:45:38", "text": "使用全局命令可能会有点"}, {"type": "subtitle", "time": 2743.43, "timestamp": "00:45:43", "text": "麻烦，因为比如说，我"}, {"type": "subtitle", "time": 2746.069, "timestamp": "00:45:46", "text": "安装了一个扩展程序，它使用了"}, {"type": "subtitle", "time": 2749.43, "timestamp": "00:45:49", "text": "我已有的全局变量之一，那么"}, {"type": "subtitle", "time": 2751.67, "timestamp": "00:45:51", "text": "它就会破坏整个程序。 我"}, {"type": "subtitle", "time": 2753.91, "timestamp": "00:45:53", "text": "不想把它放进去，以防万一。 我"}, {"type": "subtitle", "time": 2755.589, "timestamp": "00:45:55", "text": "相信没人会这么做。"}, {"type": "subtitle", "time": 2758.23, "timestamp": "00:45:58", "text": "我填的名字跟我填的一样，但是就像"}]
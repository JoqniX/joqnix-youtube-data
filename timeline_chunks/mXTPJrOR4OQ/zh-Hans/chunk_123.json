[{"type": "subtitle", "time": 7380.95, "timestamp": "02:03:00", "text": "意思是，如果他们愿意分享"}, {"type": "subtitle", "time": 7384.229, "timestamp": "02:03:04", "text": "他们制作的按钮或其他东西，比如像"}, {"type": "subtitle", "time": 7388.229, "timestamp": "02:03:08", "text": "Fluffy Sheep Basan 那样，如果他们"}, {"type": "subtitle", "time": 7390.07, "timestamp": "02:03:10", "text": "愿意把他们制作的按钮或"}, {"type": "subtitle", "time": 7404.95, "timestamp": "02:03:24", "text": "但大多数人不会那样"}, {"type": "subtitle", "time": 7406.95, "timestamp": "02:03:26", "text": "免费赠送，你必须自己学习"}, {"type": "subtitle", "time": 7409.91, "timestamp": "02:03:29", "text": "如何制作。有些人甚至"}, {"type": "subtitle", "time": 7412.47, "timestamp": "02:03:32", "text": "会让你自己动手做之类的"}, {"type": "subtitle", "time": 7415.99, "timestamp": "02:03:35", "text": "。 所以你必须寻求支持，"}, {"type": "subtitle", "time": 7418.149, "timestamp": "02:03:38", "text": "你必须学习如何，你必须"}, {"type": "subtitle", "time": 7420.79, "timestamp": "02:03:40", "text": "理解你可以做些什么来"}, {"type": "subtitle", "time": 7423.189, "timestamp": "02:03:43", "text": "重现它。 这样学习才对，"}, {"type": "subtitle", "time": 7425.83, "timestamp": "02:03:45", "text": "对吧？ 你总可以问别人要那"}, {"type": "subtitle", "time": 7429.35, "timestamp": "02:03:49", "text": "玩意儿，对吧？ 你得学会，"}, {"type": "subtitle", "time": 7433.75, "timestamp": "02:03:53", "text": "对了，欢迎信息也在那里。"}, {"type": "subtitle", "time": 7436.79, "timestamp": "02:03:56", "text": "要么你买，要么你学着做。"}, {"type": "subtitle", "time": 7438.47, "timestamp": "02:03:58", "text": "你说的“买”是什么意思？"}]
[{"type": "subtitle", "time": 1623.75, "timestamp": "00:27:03", "text": "哦，呃呃，"}, {"type": "subtitle", "time": 1627.59, "timestamp": "00:27:07", "text": "那"}, {"type": "subtitle", "time": 1629.99, "timestamp": "00:27:09", "text": "我该怎么说呢？"}, {"type": "subtitle", "time": 1633.19, "timestamp": "00:27:13", "text": "我无法用英语表达我"}, {"type": "subtitle", "time": 1636.63, "timestamp": "00:27:16", "text": "内心的感受。 兄弟，为什么"}, {"type": "subtitle", "time": 1639.99, "timestamp": "00:27:19", "text": "我不能说出我想说的话？"}, {"type": "subtitle", "time": 1643.19, "timestamp": "00:27:23", "text": "现在输入的文字并不是文字。"}, {"type": "subtitle", "time": 1646.789, "timestamp": "00:27:26", "text": "就算你说话，大声说出来，等等。"}, {"type": "subtitle", "time": 1650.549, "timestamp": "00:27:30", "text": "随便吧。 只是我不知道这样表达是否"}, {"type": "subtitle", "time": 1653.11, "timestamp": "00:27:33", "text": "正确。 我"}, {"type": "subtitle", "time": 1655.75, "timestamp": "00:27:35", "text": "希望我的真实感受能够完全传达出来"}, {"type": "subtitle", "time": 1659.11, "timestamp": "00:27:39", "text": "。"}]
[{"type": "subtitle", "time": 8700.23, "timestamp": "02:25:00", "text": "复制了一份，放在这里。"}, {"type": "subtitle", "time": 8703.83, "timestamp": "02:25:03", "text": "然后，他所做的，就像"}, {"type": "subtitle", "time": 8706.55, "timestamp": "02:25:06", "text": "这个单独的源会沿着一条"}, {"type": "subtitle", "time": 8710.07, "timestamp": "02:25:10", "text": "直线缓慢地、逐渐地增加"}, {"type": "subtitle", "time": 8712.63, "timestamp": "02:25:12", "text": "它一样。 所以，如果你想想"}, {"type": "subtitle", "time": 8716.23, "timestamp": "02:25:16", "text": "它的后端，他可能做了很多"}, {"type": "subtitle", "time": 8719.19, "timestamp": "02:25:19", "text": "变量计数和"}, {"type": "subtitle", "time": 8722.95, "timestamp": "02:25:22", "text": "随机化之类的工作等等，"}, {"type": "subtitle", "time": 8727.91, "timestamp": "02:25:27", "text": "就像这里，在这个场景中，这是"}, {"type": "subtitle", "time": 8734.63, "timestamp": "02:25:34", "text": "Finite Singularity 的复合模糊插件，他"}, {"type": "subtitle", "time": 8738.71, "timestamp": "02:25:38", "text": "基本上做了方向缩放，如果"}, {"type": "subtitle", "time": 8741.83, "timestamp": "02:25:41", "text": "我能把它显示在屏幕上的话。"}, {"type": "subtitle", "time": 8749.03, "timestamp": "02:25:49", "text": "呃，这种"}, {"type": "subtitle", "time": 8752.55, "timestamp": "02:25:52", "text": "单向模糊。"}, {"type": "subtitle", "time": 8754.469, "timestamp": "02:25:54", "text": "对，就是方向性模糊。"}, {"type": "subtitle", "time": 8758.389, "timestamp": "02:25:58", "text": "他就是这么做的。 展示出来。"}]
[{"type": "subtitle", "time": 9120.87, "timestamp": "02:32:00", "text": "所以我就想，是啊，我不能，我没钱"}, {"type": "subtitle", "time": 9123.03, "timestamp": "02:32:03", "text": "委托别人做。 我"}, {"type": "subtitle", "time": 9124.71, "timestamp": "02:32:04", "text": "用的是Sammy。 当然，我可以"}, {"type": "subtitle", "time": 9126.63, "timestamp": "02:32:06", "text": "委托别人帮我处理这做"}, {"type": "subtitle", "time": 9129.83, "timestamp": "02:32:09", "text": "那的事情，对吧？ 但我当时"}, {"type": "subtitle", "time": 9131.51, "timestamp": "02:32:11", "text": "想，不，我没钱。 所以我"}, {"type": "chat", "time": 9132.677, "timestamp": "02:32:12", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "yeah "}, {"type": "subtitle", "time": 9135.67, "timestamp": "02:32:15", "text": "不得不坐下来。 就算我这"}, {"type": "subtitle", "time": 9138.23, "timestamp": "02:32:18", "text": "笨脑袋也能应付大部分事情，"}, {"type": "subtitle", "time": 9141.11, "timestamp": "02:32:21", "text": "但我还是会脑超负荷。所以我得"}, {"type": "subtitle", "time": 9145.67, "timestamp": "02:32:25", "text": "坐下来，慢慢来，稳扎稳打，"}, {"type": "subtitle", "time": 9148.309, "timestamp": "02:32:28", "text": "理解它，一步一步来，理解"}, {"type": "subtitle", "time": 9150.23, "timestamp": "02:32:30", "text": "并学习如何使用软件，"}, {"type": "subtitle", "time": 9152.95, "timestamp": "02:32:32", "text": "然后再去做。所以，这"}, {"type": "subtitle", "time": 9157.11, "timestamp": "02:32:37", "text": "就是我的故事，为什么我在做"}, {"type": "subtitle", "time": 9160.55, "timestamp": "02:32:40", "text": "Sammy 之类的项目，以及我为此投入了多少精力。"}, {"type": "subtitle", "time": 9162.95, "timestamp": "02:32:42", "text": "我讨厌那种卡住的时候，"}, {"type": "subtitle", "time": 9165.19, "timestamp": "02:32:45", "text": "就像现在这样，"}, {"type": "subtitle", "time": 9169.03, "timestamp": "02:32:49", "text": "我的大脑无法继续运转。"}, {"type": "subtitle", "time": 9171.11, "timestamp": "02:32:51", "text": "然后我休息一会儿，喘口气，再回过头来"}, {"type": "subtitle", "time": 9172.87, "timestamp": "02:32:52", "text": "思考，就会想，"}, {"type": "subtitle", "time": 9175.03, "timestamp": "02:32:55", "text": "哦，等等，我本来可以"}, {"type": "subtitle", "time": 9179.03, "timestamp": "02:32:59", "text": "这样做的。你会得到一些想法，比如，你还"}]
[{"type": "subtitle", "time": 9785.19, "timestamp": "02:43:05", "text": "我点击关闭。 我把它关上。 我想我"}, {"type": "subtitle", "time": 9788.63, "timestamp": "02:43:08", "text": "只需要重新启动它。 就是这样。"}, {"type": "subtitle", "time": 9792.23, "timestamp": "02:43:12", "text": "我觉得我必须重新启动它。"}, {"type": "subtitle", "time": 9794.469, "timestamp": "02:43:14", "text": "等等，我可以用 Python 写一个，"}, {"type": "subtitle", "time": 9798.15, "timestamp": "02:43:18", "text": "Yuki Natsunov 写的那个程序就"}, {"type": "subtitle", "time": 9800.63, "timestamp": "02:43:20", "text": "用到了那个东西。 我以前的做法是，"}, {"type": "subtitle", "time": 9802.63, "timestamp": "02:43:22", "text": "因为我的三星手机连接到了"}, {"type": "subtitle", "time": 9804.71, "timestamp": "02:43:24", "text": "我的 YouTube 频道。 现在它能检测到"}, {"type": "subtitle", "time": 9806.95, "timestamp": "02:43:26", "text": "我所在的直播流，比如显示聊天记录，"}, {"type": "subtitle", "time": 9810.71, "timestamp": "02:43:30", "text": "我可以像在"}, {"type": "subtitle", "time": 9817.59, "timestamp": "02:43:37", "text": "Sammy上那样获取我的个人资料图片等等。 所以我就想问一下：你们"}, {"type": "subtitle", "time": 9819.03, "timestamp": "02:43:39", "text": "有双屏吗？ 我有三屏"}, {"type": "subtitle", "time": 9821.429, "timestamp": "02:43:41", "text": "显示器。"}, {"type": "chat", "time": 9823.532, "timestamp": "02:43:43", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "do you have double screen?"}]
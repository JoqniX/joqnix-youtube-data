[{"type": "subtitle", "time": 10740.55, "timestamp": "02:59:00", "text": "这是其中一个问题。 原因在于"}, {"type": "subtitle", "time": 10743.51, "timestamp": "02:59:03", "text": "你必须让 YouTube 工作室"}, {"type": "subtitle", "time": 10747.99, "timestamp": "02:59:07", "text": "在浏览器中保持打开状态，这样 YouTube 才能"}, {"type": "subtitle", "time": 10750.309, "timestamp": "02:59:10", "text": "意识到你正在提交"}, {"type": "subtitle", "time": 10752.71, "timestamp": "02:59:12", "text": "视频之类的东西，这真是太"}, {"type": "subtitle", "time": 10757.03, "timestamp": "02:59:17", "text": "麻烦了。 嗯，我注意到这种情况目前仍然"}, {"type": "subtitle", "time": 10758.63, "timestamp": "02:59:18", "text": "存在于"}, {"type": "subtitle", "time": 10760.55, "timestamp": "02:59:20", "text": "Beam 中。 他们正在努力寻找"}, {"type": "subtitle", "time": 10763.19, "timestamp": "02:59:23", "text": "解决这个问题的方法。 但"}, {"type": "subtitle", "time": 10766.07, "timestamp": "02:59:26", "text": "最近我改用梅尔了。"}, {"type": "subtitle", "time": 10768.79, "timestamp": "02:59:28", "text": "Meld就像一个多流媒体服务平台。   和"}, {"type": "subtitle", "time": 10772.309, "timestamp": "02:59:32", "text": "梅尔一样。 嗯，跟Beam差不多，但是是"}, {"type": "subtitle", "time": 10774.55, "timestamp": "02:59:34", "text": "免费的。 他们免费赠送。 所以我在"}, {"type": "subtitle", "time": 10778.87, "timestamp": "02:59:38", "text": "这里添加了一个 YouTube 链接。 所以我一直在进行"}, {"type": "subtitle", "time": 10782.71, "timestamp": "02:59:42", "text": "压力测试。 所以到目前为止，我一直在"}, {"type": "subtitle", "time": 10786.55, "timestamp": "02:59:46", "text": "我的B账户上进行压力测试。 呃，"}, {"type": "subtitle", "time": 10790.79, "timestamp": "02:59:50", "text": "如果我能换成那个的话。 呃，稍等一下。"}, {"type": "subtitle", "time": 10792.71, "timestamp": "02:59:52", "text": "它仍然在线。 所以，它正在将"}, {"type": "subtitle", "time": 10794.95, "timestamp": "02:59:54", "text": "当前的视频流发送到我的 YouTube"}, {"type": "subtitle", "time": 10798.23, "timestamp": "02:59:58", "text": "频道。 嗯，如果我没记错的话。 是的，它还在"}]
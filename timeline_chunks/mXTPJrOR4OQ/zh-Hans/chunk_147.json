[{"type": "subtitle", "time": 8821.349, "timestamp": "02:27:01", "text": "平台，无论你在哪里"}, {"type": "subtitle", "time": 8823.19, "timestamp": "02:27:03", "text": "观看，每个人都可以这样做。 不，我不想让"}, {"type": "subtitle", "time": 8825.349, "timestamp": "02:27:05", "text": "人们到某个特定的平台上"}, {"type": "subtitle", "time": 8827.59, "timestamp": "02:27:07", "text": "去做这件事。 我希望它"}, {"type": "subtitle", "time": 8831.349, "timestamp": "02:27:11", "text": "现在能随处可用。 所以这就是为什么"}, {"type": "subtitle", "time": 8834.23, "timestamp": "02:27:14", "text": "我不会去做那些花里胡哨的事情的原因"}, {"type": "chat", "time": 8839.108, "timestamp": "02:27:19", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "true"}, {"type": "subtitle", "time": 8841.11, "timestamp": "02:27:21", "text": "但是，是啊，所以我才那样想，"}, {"type": "subtitle", "time": 8846.469, "timestamp": "02:27:26", "text": "而且，我的各项能力都已经达到"}, {"type": "subtitle", "time": 8851.19, "timestamp": "02:27:31", "text": "极限了，伙计。  100% CPU占用率"}, {"type": "subtitle", "time": 8853.99, "timestamp": "02:27:33", "text": "等等。我不得不"}, {"type": "subtitle", "time": 8857.27, "timestamp": "02:27:37", "text": "放弃很多"}, {"type": "subtitle", "time": 8860.87, "timestamp": "02:27:40", "text": "我自己的伟大发明。 我为此感到非常自豪。"}, {"type": "subtitle", "time": 8863.91, "timestamp": "02:27:43", "text": "花费了无数个小时，倾注了无数的心血、汗水、"}, {"type": "subtitle", "time": 8868.389, "timestamp": "02:27:48", "text": "泪水和星星，才做出了一个"}, {"type": "subtitle", "time": 8870.79, "timestamp": "02:27:50", "text": "对别人来说很简单，但"}, {"type": "subtitle", "time": 8873.19, "timestamp": "02:27:53", "text": "对我来说却很困难的东西，因为我还要教 Sammy 如何"}, {"type": "subtitle", "time": 8875.91, "timestamp": "02:27:55", "text": "使用它等等，而且我不得不"}, {"type": "subtitle", "time": 8878.469, "timestamp": "02:27:58", "text": "清理很多东西，删除很多"}]
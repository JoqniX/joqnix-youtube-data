[{"type": "subtitle", "time": 11101.349, "timestamp": "03:05:01", "text": "当你现在有了这些疯狂的想法时，"}, {"type": "subtitle", "time": 11104.15, "timestamp": "03:05:04", "text": "你会想立刻把它们写下来"}, {"type": "subtitle", "time": 11107.67, "timestamp": "03:05:07", "text": "。 是的。 所以这就是为什么"}, {"type": "subtitle", "time": 11110.389, "timestamp": "03:05:10", "text": "即使我"}, {"type": "subtitle", "time": 11111.83, "timestamp": "03:05:11", "text": "讨厌编程，我还是会慢慢来的原因。 我不想学习"}, {"type": "subtitle", "time": 11115.51, "timestamp": "03:05:15", "text": "编程，但如果我有编程"}, {"type": "subtitle", "time": 11118.23, "timestamp": "03:05:18", "text": "知识，我可以做很多"}, {"type": "subtitle", "time": 11119.83, "timestamp": "03:05:19", "text": "东西，"}, {"type": "subtitle", "time": 11130.95, "timestamp": "03:05:30", "text": "伙计，我完全跑题了，"}, {"type": "subtitle", "time": 11133.03, "timestamp": "03:05:33", "text": "哦，天哪，等等，我之前在干什么来着？"}, {"type": "subtitle", "time": 11137.51, "timestamp": "03:05:37", "text": "Sammy 在哪里？刚刚得到了支持，"}, {"type": "subtitle", "time": 11141.67, "timestamp": "03:05:41", "text": "好的，来自一个有"}, {"type": "subtitle", "time": 11144.309, "timestamp": "03:05:44", "text": "此用例的。 所以，我能够"}, {"type": "subtitle", "time": 11151.03, "timestamp": "03:05:51", "text": "为每个平台"}]
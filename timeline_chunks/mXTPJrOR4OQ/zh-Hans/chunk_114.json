[{"type": "subtitle", "time": 6841.43, "timestamp": "01:54:01", "text": "使用 Sammy 进行授权，还可以添加"}, {"type": "subtitle", "time": 6844.47, "timestamp": "01:54:04", "text": "您的 Twitch 主播帐户和 B"}, {"type": "subtitle", "time": 6846.39, "timestamp": "01:54:06", "text": "帐户（这两个帐户都是您想要"}, {"type": "subtitle", "time": 6848.95, "timestamp": "01:54:08", "text": "发送消息的帐户）。 您可以选择 B"}, {"type": "subtitle", "time": 6851.35, "timestamp": "01:54:11", "text": "账号，"}, {"type": "subtitle", "time": 6853.51, "timestamp": "01:54:13", "text": "使用您的 B 账号向我发送 Twitch 命令。 你可以这样做，"}, {"type": "subtitle", "time": 6856.07, "timestamp": "01:54:16", "text": "这里也是你"}, {"type": "subtitle", "time": 6858.149, "timestamp": "01:54:18", "text": "连接 OBS 的地方。 如果您有多个"}, {"type": "subtitle", "time": 6860.39, "timestamp": "01:54:20", "text": "OBS 设备，也可以连接多个 OBS 设备"}, {"type": "subtitle", "time": 6863.27, "timestamp": "01:54:23", "text": "。 是的，他们"}, {"type": "subtitle", "time": 6866.55, "timestamp": "01:54:26", "text": "还没有为 Mel 开发集成功能。 所以我现在正在进行"}, {"type": "subtitle", "time": 6870.31, "timestamp": "01:54:30", "text": "MEL 扩展的 beta 测试。 既然"}, {"type": "subtitle", "time": 6873.91, "timestamp": "01:54:33", "text": "它是本地主机，那就"}, {"type": "subtitle", "time": 6876.709, "timestamp": "01:54:36", "text": "意味着扩展程序将在"}, {"type": "subtitle", "time": 6879.109, "timestamp": "01:54:39", "text": "全局上运行，正如你所看到的，它"}, {"type": "subtitle", "time": 6882.149, "timestamp": "01:54:42", "text": "已经连接上了。 所以它才说“"}, {"type": "subtitle", "time": 6884.95, "timestamp": "01:54:44", "text": "连接”等于 1。 它显示了"}, {"type": "subtitle", "time": 6886.87, "timestamp": "01:54:46", "text": "当前场景、游戏主场景以及之前的"}, {"type": "subtitle", "time": 6889.51, "timestamp": "01:54:49", "text": "场景。 它会检查是否正在"}, {"type": "subtitle", "time": 6891.669, "timestamp": "01:54:51", "text": "录制。 它不是在录制，而是在"}, {"type": "subtitle", "time": 6894.39, "timestamp": "01:54:54", "text": "直播。 所以这个变量"}, {"type": "subtitle", "time": 6898.31, "timestamp": "01:54:58", "text": "每秒都会更新一次，"}]
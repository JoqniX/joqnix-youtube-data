[{"type": "subtitle", "time": 2641.67, "timestamp": "00:44:01", "text": "呃，这个按钮没有"}, {"type": "subtitle", "time": 2643.91, "timestamp": "00:44:03", "text": "重复间隔。 它们只是"}, {"type": "subtitle", "time": 2646.23, "timestamp": "00:44:06", "text": "改变了流状态。 这就是"}, {"type": "subtitle", "time": 2649.03, "timestamp": "00:44:09", "text": "你开始直播录制、"}, {"type": "subtitle", "time": 2651.109, "timestamp": "00:44:11", "text": "开始直播、停止直播"}, {"type": "subtitle", "time": 2652.95, "timestamp": "00:44:12", "text": "录制、开始录制、停止录制以及"}, {"type": "subtitle", "time": 2655.109, "timestamp": "00:44:15", "text": "打开/关闭虚拟摄像头的时候，"}, {"type": "subtitle", "time": 2659.03, "timestamp": "00:44:19", "text": "直播状态发生了变化，对吧？所以这里它"}, {"type": "subtitle", "time": 2662.309, "timestamp": "00:44:22", "text": "不会重新触发按钮，正如"}, {"type": "subtitle", "time": 2665.51, "timestamp": "00:44:25", "text": "你所看到的，它显示按钮 ID，它正在"}, {"type": "subtitle", "time": 2667.829, "timestamp": "00:44:27", "text": "重新触发这个按钮，这个"}, {"type": "subtitle", "time": 2673.67, "timestamp": "00:44:33", "text": "按钮的 ID 是 4432，对吧？所以这个"}, {"type": "subtitle", "time": 2676.069, "timestamp": "00:44:36", "text": "命令等待超时，超时是指"}, {"type": "subtitle", "time": 2679.43, "timestamp": "00:44:39", "text": "增加一个延迟。 它会等待"}, {"type": "subtitle", "time": 2684.15, "timestamp": "00:44:44", "text": "一定的秒数或毫秒数，或者"}, {"type": "subtitle", "time": 2687.99, "timestamp": "00:44:47", "text": "一些权重，或者一些特定的时间段，"}, {"type": "subtitle", "time": 2692.069, "timestamp": "00:44:52", "text": "然后执行下面的操作。 是的，"}, {"type": "subtitle", "time": 2698.79, "timestamp": "00:44:58", "text": "我想要的，或者说，我"}]
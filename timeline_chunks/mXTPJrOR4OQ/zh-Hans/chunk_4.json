[{"type": "subtitle", "time": 240.47, "timestamp": "00:04:00", "text": "我们将进行工作流程。 这将是"}, {"type": "subtitle", "time": 242.71, "timestamp": "00:04:02", "text": "一个与我一起工作的直播。 我会去工作。"}, {"type": "subtitle", "time": 245.03, "timestamp": "00:04:05", "text": "你们如果愿意的话，也可以和"}, {"type": "subtitle", "time": 247.83, "timestamp": "00:04:07", "text": "我一起工作，加入我的团队。"}, {"type": "subtitle", "time": 251.589, "timestamp": "00:04:11", "text": "你好。 你好。 所以今天我们要处理"}, {"type": "subtitle", "time": 256.31, "timestamp": "00:04:16", "text": "Sammy 的相关事宜。 嗯，昨天在"}, {"type": "subtitle", "time": 258.39, "timestamp": "00:04:18", "text": "合作之前，我一直在做 Sammy 的东西。 我"}, {"type": "subtitle", "time": 261.749, "timestamp": "00:04:21", "text": "发了两个求助帖，询问一些"}, {"type": "subtitle", "time": 263.99, "timestamp": "00:04:23", "text": "我需要帮助的问题。 所以我"}, {"type": "subtitle", "time": 266.79, "timestamp": "00:04:26", "text": "会把更多精力放在这方面，想办法"}, {"type": "subtitle", "time": 269.27, "timestamp": "00:04:29", "text": "安排好一切"}, {"type": "subtitle", "time": 271.43, "timestamp": "00:04:31", "text": "。 另外，"}, {"type": "subtitle", "time": 273.909, "timestamp": "00:04:33", "text": "今天在我完成 Sammy 的事情之后，我们要做的最重要的事情之一，"}, {"type": "subtitle", "time": 276.629, "timestamp": "00:04:36", "text": "呃，Sammy 的"}, {"type": "subtitle", "time": 278.95, "timestamp": "00:04:38", "text": "事情之一，我需要做的第二件事"}, {"type": "subtitle", "time": 282.71, "timestamp": "00:04:42", "text": "就是让我在"}, {"type": "subtitle", "time": 286.07, "timestamp": "00:04:46", "text": "直播中恢复 Mel 的 HTML 叠加层。 嗯，我想"}, {"type": "subtitle", "time": 289.67, "timestamp": "00:04:49", "text": "使用 Sammi 的本地 API"}, {"type": "subtitle", "time": 294.15, "timestamp": "00:04:54", "text": "来获取"}, {"type": "subtitle", "time": 297.59000000000003, "timestamp": "00:04:57", "text": "我的 HTM HTML 覆盖层。 你可能已经看到了"}]
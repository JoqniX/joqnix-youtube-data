[{"type": "subtitle", "time": 240.47, "timestamp": "00:04:00", "text": "我們將進行工作流程。這將是"}, {"type": "subtitle", "time": 242.71, "timestamp": "00:04:02", "text": "一個與我一起工作的直播。我會去工作。"}, {"type": "subtitle", "time": 245.03, "timestamp": "00:04:05", "text": "你們如果願意的話，也可以和我一起工作，加入我的團隊"}, {"type": "subtitle", "time": 247.83, "timestamp": "00:04:07", "text": "。"}, {"type": "subtitle", "time": 251.589, "timestamp": "00:04:11", "text": "你好。你好。所以今天我們要處理"}, {"type": "subtitle", "time": 256.31, "timestamp": "00:04:16", "text": "Sammy 的相關事宜。嗯，昨天在"}, {"type": "subtitle", "time": 258.39, "timestamp": "00:04:18", "text": "合作之前，我一直在做 Sammy 的東西。我"}, {"type": "subtitle", "time": 261.749, "timestamp": "00:04:21", "text": "發了兩個求助帖，詢問一些"}, {"type": "subtitle", "time": 263.99, "timestamp": "00:04:23", "text": "我需要幫助的問題。所以我"}, {"type": "subtitle", "time": 266.79, "timestamp": "00:04:26", "text": "會把更多精力放在這方面，"}, {"type": "subtitle", "time": 286.07, "timestamp": "00:04:46", "text": "想辦法安排好一切。另外，今天在我完成 Sammy 的事情之後，我們要做的最重要的事情之一，呃，Sammy 的事情之一，我需要做的第二件事就是讓我在直播中恢復 Mel 的 HTML 疊加層。嗯，我想"}, {"type": "subtitle", "time": 289.67, "timestamp": "00:04:49", "text": "使用 Sammi 的本機 API 來"}, {"type": "subtitle", "time": 294.15, "timestamp": "00:04:54", "text": "取得"}, {"type": "subtitle", "time": 297.59000000000003, "timestamp": "00:04:57", "text": "我的 HTM HTML 覆蓋層。你可能已經看到了"}]
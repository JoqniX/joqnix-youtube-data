[{"type": "subtitle", "time": 1020.949, "timestamp": "00:17:00", "text": "我該怎麼用適當的措詞來表達呢"}, {"type": "subtitle", "time": 1021.91, "timestamp": "00:17:01", "text": "？"}, {"type": "subtitle", "time": 1024.309, "timestamp": "00:17:04", "text": "我想做的事。"}, {"type": "subtitle", "time": 1027.75, "timestamp": "00:17:07", "text": "為什麼英文有時候這麼難學？我想說些"}, {"type": "subtitle", "time": 1032.309, "timestamp": "00:17:12", "text": "什麼，但是合適的措辭，"}, {"type": "subtitle", "time": 1037.59, "timestamp": "00:17:17", "text": "合適的措辭，卻怎麼也"}, {"type": "subtitle", "time": 1041.38, "timestamp": "00:17:21", "text": "想不出來。"}]
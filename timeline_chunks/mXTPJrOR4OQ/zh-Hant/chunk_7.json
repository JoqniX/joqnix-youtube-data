[{"type": "subtitle", "time": 430.07, "timestamp": "00:07:10", "text": "我向上帝發誓。"}, {"type": "subtitle", "time": 442.79, "timestamp": "00:07:22", "text": "兄弟，我不用這個應用了。我不用"}, {"type": "subtitle", "time": 444.79, "timestamp": "00:07:24", "text": "這個應用了。我真是受夠這個"}, {"type": "subtitle", "time": 447.589, "timestamp": "00:07:27", "text": "應用程式了。"}, {"type": "subtitle", "time": 451.029, "timestamp": "00:07:31", "text": "讓我重置一下這個應用程式。"}, {"type": "subtitle", "time": 470.55, "timestamp": "00:07:50", "text": "身體。快點。前景。"}, {"type": "subtitle", "time": 477.67, "timestamp": "00:07:57", "text": "要友善。前景。"}, {"type": "subtitle", "time": 479.67, "timestamp": "00:07:59", "text": "我真希望現在就能給你看看"}]
[{"type": "subtitle", "time": 3060.549, "timestamp": "00:51:00", "text": "變量，每次"}, {"type": "subtitle", "time": 3063.829, "timestamp": "00:51:03", "text": "我運行這個特定的按鈕時，"}, {"type": "subtitle", "time": 3080.15, "timestamp": "00:51:20", "text": "它都會有一個變"}, {"type": "subtitle", "time": 3084.39, "timestamp": "00:51:24", "text": "數值。昨天我把它搞複雜了，加了一個按鈕退出檢查，後來我意識到，我思考了一段時間後學到了一些東西，幫助我的人也告訴我，你可以設置默認變量，比如當你"}, {"type": "subtitle", "time": 3087.589, "timestamp": "00:51:27", "text": "沒有按下按鈕時。所以，這個"}, {"type": "subtitle", "time": 3090.23, "timestamp": "00:51:30", "text": "變數應該為零，對吧？如果你"}, {"type": "subtitle", "time": 3092.23, "timestamp": "00:51:32", "text": "按下按鈕，它就會變成 1；"}, {"type": "subtitle", "time": 3094.069, "timestamp": "00:51:34", "text": "如果你再按一次，它就會"}, {"type": "subtitle", "time": 3097.43, "timestamp": "00:51:37", "text": "變成 2，以此類推，它會隨著按下的"}, {"type": "subtitle", "time": 3102.95, "timestamp": "00:51:42", "text": "次數增加而自動遞增，對吧？所以，是的，這個"}, {"type": "subtitle", "time": 3105.67, "timestamp": "00:51:45", "text": "東西，我們在這裡要做的是，"}, {"type": "subtitle", "time": 3108.069, "timestamp": "00:51:48", "text": "我們要添加一個"}, {"type": "subtitle", "time": 3109.91, "timestamp": "00:51:49", "text": "叫做"}, {"type": "subtitle", "time": 3112.79, "timestamp": "00:51:52", "text": "TTV"}, {"type": "subtitle", "time": 3118.47, "timestamp": "00:51:58", "text": "TT 訊息運行、TTU TV DTV"}]
[{"type": "subtitle", "time": 667.19, "timestamp": "00:11:07", "text": "我當時正在嘗試讓它運行起來，"}, {"type": "subtitle", "time": 684.389, "timestamp": "00:11:24", "text": "好的。"}, {"type": "subtitle", "time": 694.55, "timestamp": "00:11:34", "text": "呃，那我先把 YouTube Studio 關掉。  嗯，我好像一直在測試一個"}, {"type": "subtitle", "time": 699.43, "timestamp": "00:11:39", "text": "叫VTS終端機的東西。我其實是在推特上看到的，好像是"}, {"type": "subtitle", "time": 703.829, "timestamp": "00:11:43", "text": "關於"}, {"type": "subtitle", "time": 706.55, "timestamp": "00:11:46", "text": "某個藝術家或是開發者之類的"}, {"type": "subtitle", "time": 711.67, "timestamp": "00:11:51", "text": "。他們做了一個類似 YouTube"}]
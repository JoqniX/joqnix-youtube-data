[{"type": "subtitle", "time": 2461.75, "timestamp": "00:41:01", "text": "等等。正確的？我注意到，"}, {"type": "subtitle", "time": 2465.03, "timestamp": "00:41:05", "text": "如果沒有觸發條件，某些網頁按鈕會一直不停地彈出"}, {"type": "subtitle", "time": 2466.71, "timestamp": "00:41:06", "text": "。"}, {"type": "subtitle", "time": 2471.03, "timestamp": "00:41:11", "text": "例如，假設我想要一個按鈕，"}, {"type": "subtitle", "time": 2478.39, "timestamp": "00:41:18", "text": "每 3 秒檢查一次我的 OBS 來源（"}, {"type": "subtitle", "time": 2480.71, "timestamp": "00:41:20", "text": "我沒用 OBS，但嚴格來說，"}, {"type": "subtitle", "time": 2484.15, "timestamp": "00:41:24", "text": "OBS 來源指的是麥克風之類的裝置）是否靜音、是否正在"}, {"type": "subtitle", "time": 2487.109, "timestamp": "00:41:27", "text": "說話等等，對吧？它會檢查設備的可見性"}, {"type": "subtitle", "time": 2491.43, "timestamp": "00:41:31", "text": "等等。"}, {"type": "subtitle", "time": 2493.19, "timestamp": "00:41:33", "text": "所以它實際上是在進行"}, {"type": "subtitle", "time": 2495.829, "timestamp": "00:41:35", "text": "檢查。我還有一個聊天指令，會向"}, {"type": "subtitle", "time": 2497.829, "timestamp": "00:41:37", "text": "Twitch、YouTube 等平台的聊天室發送訊息，"}, {"type": "subtitle", "time": 2499.99, "timestamp": "00:41:39", "text": "告知"}, {"type": "subtitle", "time": 2503.109, "timestamp": "00:41:43", "text": "Jo 的麥克風已靜音。如果"}, {"type": "subtitle", "time": 2505.43, "timestamp": "00:41:45", "text": "每 3 秒運行一次，顯然會造成垃圾"}, {"type": "subtitle", "time": 2512.23, "timestamp": "00:41:52", "text": "訊息發送，對吧？我不想這樣。我希望它只發送一次訊息，就"}, {"type": "subtitle", "time": 2515.43, "timestamp": "00:41:55", "text": "一次，就一次。如果已經發送過"}, {"type": "subtitle", "time": 2518.95, "timestamp": "00:41:58", "text": "一次，就不會再發送了。這樣就不會"}]
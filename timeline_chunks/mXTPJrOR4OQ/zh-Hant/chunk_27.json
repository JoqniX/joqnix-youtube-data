[{"type": "subtitle", "time": 1623.75, "timestamp": "00:27:03", "text": "哦，"}, {"type": "subtitle", "time": 1627.59, "timestamp": "00:27:07", "text": "呃呃，那"}, {"type": "subtitle", "time": 1629.99, "timestamp": "00:27:09", "text": "我該怎麼說呢？"}, {"type": "subtitle", "time": 1633.19, "timestamp": "00:27:13", "text": "我無法用"}, {"type": "subtitle", "time": 1636.63, "timestamp": "00:27:16", "text": "英語表達我內心的感受。兄弟，為什麼"}, {"type": "subtitle", "time": 1639.99, "timestamp": "00:27:19", "text": "我不能說出我想說的話？"}, {"type": "subtitle", "time": 1643.19, "timestamp": "00:27:23", "text": "現在輸入的文字並不是文字。就算"}, {"type": "subtitle", "time": 1646.789, "timestamp": "00:27:26", "text": "你說話，大聲說出來，等等"}, {"type": "subtitle", "time": 1650.549, "timestamp": "00:27:30", "text": "。隨便吧。只是我不知道"}, {"type": "subtitle", "time": 1653.11, "timestamp": "00:27:33", "text": "這樣表達是否正確。我"}, {"type": "subtitle", "time": 1655.75, "timestamp": "00:27:35", "text": "希望我的真實感受能夠完全傳達出來"}, {"type": "subtitle", "time": 1659.11, "timestamp": "00:27:39", "text": "。"}]
[{"type": "subtitle", "time": 2583.03, "timestamp": "00:43:03", "text": "的麥克風已靜音」、「jock 的行動直播已"}, {"type": "subtitle", "time": 2585.349, "timestamp": "00:43:05", "text": "開啟」、「行動直播已開啟」等等。"}, {"type": "subtitle", "time": 2588.23, "timestamp": "00:43:08", "text": "使用者垃圾資訊不斷湧入。真是令人"}, {"type": "subtitle", "time": 2590.63, "timestamp": "00:43:10", "text": "頭痛不已，對吧？所以，我不想那樣。"}, {"type": "subtitle", "time": 2593.349, "timestamp": "00:43:13", "text": "所以，我最近在想，呃，我建了一個"}, {"type": "subtitle", "time": 2596.23, "timestamp": "00:43:16", "text": "支持帖。如你"}, {"type": "subtitle", "time": 2598.71, "timestamp": "00:43:18", "text": "所見，我製作了一個半支撐。我"}, {"type": "subtitle", "time": 2600.95, "timestamp": "00:43:20", "text": "問了很多問題，也學到了"}, {"type": "subtitle", "time": 2604.39, "timestamp": "00:43:24", "text": "一些東西，像是某個"}, {"type": "subtitle", "time": 2607.51, "timestamp": "00:43:27", "text": "我以前從來沒用過的指令的用法"}, {"type": "subtitle", "time": 2611.589, "timestamp": "00:43:31", "text": "。"}, {"type": "subtitle", "time": 2613.91, "timestamp": "00:43:33", "text": "雖然它在薩米已經存在"}, {"type": "subtitle", "time": 2618.23, "timestamp": "00:43:38", "text": "很久了，但我最近才發現它。我"}, {"type": "subtitle", "time": 2622.23, "timestamp": "00:43:42", "text": "以前從來沒用過它。我以前從來沒想過要用"}, {"type": "subtitle", "time": 2624.23, "timestamp": "00:43:44", "text": "它"}, {"type": "subtitle", "time": 2629.349, "timestamp": "00:43:49", "text": "。例如，Twitch 的廣告，還有"}, {"type": "subtitle", "time": 2635.67, "timestamp": "00:43:55", "text": "一個 Twitch 廣告和回覆按鈕，這是我"}, {"type": "subtitle", "time": 2638.39, "timestamp": "00:43:58", "text": "從 Sammy 支援伺服器上找到的。"}]
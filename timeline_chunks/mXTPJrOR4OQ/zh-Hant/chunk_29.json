[{"type": "subtitle", "time": 1740.789, "timestamp": "00:29:00", "text": "這樣以後我們就不用再跟"}, {"type": "subtitle", "time": 1747.43, "timestamp": "00:29:07", "text": "他打交道了，因為我們已經"}, {"type": "subtitle", "time": 1751.35, "timestamp": "00:29:11", "text": "發布了相關訊息，人們也"}, {"type": "subtitle", "time": 1756.389, "timestamp": "00:29:16", "text": "慢慢適應了等等。"}, {"type": "subtitle", "time": 1768.389, "timestamp": "00:29:28", "text": "即使他們"}]
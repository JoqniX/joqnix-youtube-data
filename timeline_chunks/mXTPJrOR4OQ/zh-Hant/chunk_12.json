[{"type": "subtitle", "time": 730.15, "timestamp": "00:12:10", "text": "工作室終端的東西，顯然，透過這個終端，"}, {"type": "subtitle", "time": 754.79, "timestamp": "00:12:34", "text": "你可以控制你的模型等等，而無需查看 V 工作室，我覺得這真的很酷很棒。所以我就想，嗯，我應該用它之類的。  [音樂] 嗯，我不僅可以改變"}, {"type": "subtitle", "time": 757.43, "timestamp": "00:12:37", "text": "它的位置，"}, {"type": "subtitle", "time": 760.15, "timestamp": "00:12:40", "text": "它還有快捷鍵和特效。"}, {"type": "subtitle", "time": 764.47, "timestamp": "00:12:44", "text": "例如 V uh Vive Studios 的視覺特效。不，"}, {"type": "subtitle", "time": 766.389, "timestamp": "00:12:46", "text": "一切都由我來控制。我不需要"}, {"type": "subtitle", "time": 769.269, "timestamp": "00:12:49", "text": "去擺弄這個 Vive Studios 的"}, {"type": "subtitle", "time": 773.43, "timestamp": "00:12:53", "text": "愚蠢的使用者介面，也不"}, {"type": "subtitle", "time": 775.59, "timestamp": "00:12:55", "text": "需要點擊那麼多按鈕等等。這個那個的。"}]
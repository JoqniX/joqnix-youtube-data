[{"type": "subtitle", "time": 3000.47, "timestamp": "00:50:00", "text": "2020。如果這個變數不存在，那麼再用一個"}, {"type": "subtitle", "time": 3003.829, "timestamp": "00:50:03", "text": "if if 語句檢查它是否"}, {"type": "subtitle", "time": 3006.15, "timestamp": "00:50:06", "text": "大於這個變數指定的"}, {"type": "subtitle", "time": 3009.19, "timestamp": "00:50:09", "text": "秒數。如果大於，則觸發另一個"}, {"type": "subtitle", "time": 3013.27, "timestamp": "00:50:13", "text": "按鈕，並將該變數設為"}, {"type": "subtitle", "time": 3016.39, "timestamp": "00:50:16", "text": "目前的全域變數值。"}, {"type": "subtitle", "time": 3019.67, "timestamp": "00:50:19", "text": "否則，退出程序。如果你只關心"}, {"type": "subtitle", "time": 3021.589, "timestamp": "00:50:21", "text": "它是否為真，你"}, {"type": "subtitle", "time": 3024.47, "timestamp": "00:50:24", "text": "可以使用布林值變量，如果"}, {"type": "subtitle", "time": 3026.63, "timestamp": "00:50:26", "text": "布林值為真則退出。或者，如果你關心"}, {"type": "subtitle", "time": 3028.79, "timestamp": "00:50:28", "text": "它發生了多少次，只需保留一個計數器"}, {"type": "subtitle", "time": 3031.67, "timestamp": "00:50:31", "text": "並加一即可。所以，"}, {"type": "subtitle", "time": 3034.79, "timestamp": "00:50:34", "text": "我會嘗試"}, {"type": "subtitle", "time": 3038.549, "timestamp": "00:50:38", "text": "為每個單獨的命令建立一個類似日曆的系統"}, {"type": "subtitle", "time": 3041.03, "timestamp": "00:50:41", "text": "。例如，"}, {"type": "subtitle", "time": 3043.349, "timestamp": "00:50:43", "text": "這裡這是一個 Twitch 聊天命令，"}, {"type": "subtitle", "time": 3046.63, "timestamp": "00:50:46", "text": "對吧？這是Twitch聊天指令。所以"}, {"type": "subtitle", "time": 3050.87, "timestamp": "00:50:50", "text": "我想為這件事保留一個計數器"}, {"type": "subtitle", "time": 3053.829, "timestamp": "00:50:53", "text": "，對吧？所以正如你所"}, {"type": "subtitle", "time": 3056.39, "timestamp": "00:50:56", "text": "看到的，我有一個按鈕運行，它是一個"}]
[{"type": "subtitle", "time": 3780.15, "timestamp": "01:03:00", "text": "底部。最新數據在"}, {"type": "subtitle", "time": 3788.39, "timestamp": "01:03:08", "text": "。還有，一些基本設定我"}, {"type": "subtitle", "time": 3790.87, "timestamp": "01:03:10", "text": "一直建議大家注意：如果你"}, {"type": "subtitle", "time": 3794.63, "timestamp": "01:03:14", "text": "使用瀏覽器作為資料來源，請務必"}, {"type": "subtitle", "time": 3797.19, "timestamp": "01:03:17", "text": "勾選這兩個選項，"}, {"type": "subtitle", "time": 3799.67, "timestamp": "01:03:19", "text": "除非你"}, {"type": "subtitle", "time": 3802.71, "timestamp": "01:03:22", "text": "使用 StreamLabs 的 Stream Elements 功能，或者"}, {"type": "subtitle", "time": 3807.109, "timestamp": "01:03:27", "text": "在瀏覽器中使用"}, {"type": "subtitle", "time": 3810.069, "timestamp": "01:03:30", "text": "聊天疊加層，請將其關閉。但其他所有功能都請保持"}, {"type": "subtitle", "time": 3816.15, "timestamp": "01:03:36", "text": "勾選狀態。如果你"}, {"type": "subtitle", "time": 3819.43, "timestamp": "01:03:39", "text": "使用圖片作為資料來源，請"}, {"type": "subtitle", "time": 3823.27, "timestamp": "01:03:43", "text": "確保「卸載圖片」選項已啟用。"}, {"type": "subtitle", "time": 3826.39, "timestamp": "01:03:46", "text": "媒體來源尤其如此。"}, {"type": "subtitle", "time": 3828.789, "timestamp": "01:03:48", "text": "請確保這兩個選項都已"}, {"type": "subtitle", "time": 3832.15, "timestamp": "01:03:52", "text": "勾選。當來源檔案變為活動狀態時，重新啟動播放；當來源檔案變為"}]
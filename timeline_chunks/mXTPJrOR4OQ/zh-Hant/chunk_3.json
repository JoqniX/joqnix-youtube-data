[{"type": "subtitle", "time": 180.79, "timestamp": "00:03:00", "text": "大家最近怎麼樣？這是一個"}, {"type": "subtitle", "time": 183.03, "timestamp": "00:03:03", "text": "美好的下午。"}, {"type": "subtitle", "time": 185.99, "timestamp": "00:03:05", "text": "現在是中午。  是的"}, {"type": "subtitle", "time": 188.22899999999998, "timestamp": "00:03:08", "text": "。今天，"}, {"type": "subtitle", "time": 190.47, "timestamp": "00:03:10", "text": "我醒了，我醒得很早。昨天我"}, {"type": "subtitle", "time": 193.99, "timestamp": "00:03:13", "text": "簡直腦子一片空白。是啊，我當時"}, {"type": "subtitle", "time": 196.63, "timestamp": "00:03:16", "text": "腦子一片空白。  我當時腦子一片空白，困得不行，"}, {"type": "subtitle", "time": 207.27, "timestamp": "00:03:27", "text": "直播結束後就睡著了。我在YouTube上看了會兒視頻，"}, {"type": "subtitle", "time": 212.949, "timestamp": "00:03:32", "text": "然後馬上就睡著了，凌晨四五點左右醒了。"}, {"type": "subtitle", "time": 218.309, "timestamp": "00:03:38", "text": "我在手機上做了點事，然後吃了點"}, {"type": "subtitle", "time": 221.50900000000001, "timestamp": "00:03:41", "text": "東西等等。之後我就去BC了。是的，我當時"}, {"type": "subtitle", "time": 223.03, "timestamp": "00:03:43", "text": "正在和我的朋友聊天。我和"}, {"type": "subtitle", "time": 225.82999999999998, "timestamp": "00:03:45", "text": "一位好朋友待了一會兒，一起"}, {"type": "subtitle", "time": 230.55, "timestamp": "00:03:50", "text": "出去玩了玩"}, {"type": "subtitle", "time": 232.789, "timestamp": "00:03:52", "text": "什麼的。稍微工作了一會兒"}, {"type": "subtitle", "time": 235.03, "timestamp": "00:03:55", "text": "。然後我就想，「是啊，我今天"}, {"type": "subtitle", "time": 238.149, "timestamp": "00:03:58", "text": "還得繼續直播。」所以今天"}]
[{"type": "subtitle", "time": 2760.95, "timestamp": "00:46:00", "text": "你看到的，下一個是運動員，對吧？我"}, {"type": "subtitle", "time": 2762.79, "timestamp": "00:46:02", "text": "這裡有一些東西。我不知道你能不能看到"}, {"type": "subtitle", "time": 2764.79, "timestamp": "00:46:04", "text": "，但是，"}, {"type": "subtitle", "time": 2767.43, "timestamp": "00:46:07", "text": "是的，就是這個，對吧？"}, {"type": "subtitle", "time": 2770.069, "timestamp": "00:46:10", "text": "Jo 活動、Jog 文字狀態、行動"}, {"type": "subtitle", "time": 2773.589, "timestamp": "00:46:13", "text": "直播狀態、在 Twitch 和 YouTube 上直播"}, {"type": "subtitle", "time": 2775.829, "timestamp": "00:46:15", "text": "。我已經做過這件事了。所以，"}, {"type": "subtitle", "time": 2778.23, "timestamp": "00:46:18", "text": "現在用命令查看"}, {"type": "subtitle", "time": 2780.63, "timestamp": "00:46:20", "text": "比像這樣操作要容易得多。"}, {"type": "subtitle", "time": 2782.95, "timestamp": "00:46:22", "text": "例如，如果我想給你一個"}, {"type": "subtitle", "time": 2786.95, "timestamp": "00:46:26", "text": "好例子，我會給你演示。嗯，"}, {"type": "subtitle", "time": 2791.27, "timestamp": "00:46:31", "text": "是的，我現在可以看到這個命令，"}, {"type": "subtitle", "time": 2793.99, "timestamp": "00:46:33", "text": "但是當它重置，例如重新運行"}, {"type": "subtitle", "time": 2795.589, "timestamp": "00:46:35", "text": "命令時，我就看不到這些"}, {"type": "subtitle", "time": 2799.109, "timestamp": "00:46:39", "text": "內容了，對吧？這是其中一個問題。呃，我"}, {"type": "subtitle", "time": 2801.27, "timestamp": "00:46:41", "text": "不知道為什麼它不這樣"}, {"type": "subtitle", "time": 2806.309, "timestamp": "00:46:46", "text": "做，但是如果我可以的話，"}, {"type": "subtitle", "time": 2809.75, "timestamp": "00:46:49", "text": "請稍等片刻。如何？"}, {"type": "subtitle", "time": 2812.309, "timestamp": "00:46:52", "text": "耽誤。耽誤。耽誤。耽誤。我"}, {"type": "subtitle", "time": 2818.55, "timestamp": "00:46:58", "text": "覺得我需要一個活躍的"}]
[{"type": "subtitle", "time": 2701.27, "timestamp": "00:45:01", "text": "真正需要的。  嗯，是的，"}, {"type": "subtitle", "time": 2706.309, "timestamp": "00:45:06", "text": "我們今天的目標是……"}, {"type": "subtitle", "time": 2709.349, "timestamp": "00:45:09", "text": "我昨天就開始做這件事了，"}, {"type": "subtitle", "time": 2714.309, "timestamp": "00:45:14", "text": "如果我可以進入後端"}, {"type": "subtitle", "time": 2717.19, "timestamp": "00:45:17", "text": "測試的話。是的，我開始著手研究這個了，"}, {"type": "subtitle", "time": 2720.55, "timestamp": "00:45:20", "text": "目前我實現的功能是檢查我是否正在進行"}, {"type": "subtitle", "time": 2723.75, "timestamp": "00:45:23", "text": "全域串流傳輸。是的，我還需要"}, {"type": "subtitle", "time": 2725.75, "timestamp": "00:45:25", "text": "修改所有全域命令。"}, {"type": "subtitle", "time": 2727.91, "timestamp": "00:45:27", "text": "昨天我和 Sammy 的客服人員聊過之後才意識到這一點，他們"}, {"type": "subtitle", "time": 2732.71, "timestamp": "00:45:32", "text": "昨天一直在幫助我。助手們"}, {"type": "subtitle", "time": 2735.109, "timestamp": "00:45:35", "text": "提到，"}, {"type": "subtitle", "time": 2738.87, "timestamp": "00:45:38", "text": "使用全域命令可能會有點"}, {"type": "subtitle", "time": 2743.43, "timestamp": "00:45:43", "text": "麻煩，因為比如說，我"}, {"type": "subtitle", "time": 2746.069, "timestamp": "00:45:46", "text": "安裝了一個擴展程序，它使用了"}, {"type": "subtitle", "time": 2749.43, "timestamp": "00:45:49", "text": "我已有的全域變數之一，那麼"}, {"type": "subtitle", "time": 2751.67, "timestamp": "00:45:51", "text": "它就會破壞整個程式。我"}, {"type": "subtitle", "time": 2753.91, "timestamp": "00:45:53", "text": "不想把它放進去，以防萬一。我"}, {"type": "subtitle", "time": 2755.589, "timestamp": "00:45:55", "text": "相信沒人會這麼做。"}, {"type": "subtitle", "time": 2758.23, "timestamp": "00:45:58", "text": "我填的名字跟我填的一樣，但就像"}]
[{"type": "subtitle", "time": 9014.269, "timestamp": "02:30:14", "text": "The expectations everyone has of me are"}, {"type": "subtitle", "time": 9018.79, "timestamp": "02:30:18", "text": "so dazzling and warm,"}, {"type": "subtitle", "time": 9021.99, "timestamp": "02:30:21", "text": "but also heavy."}, {"type": "subtitle", "time": 9025.469, "timestamp": "02:30:25", "text": "Before, just imagining myself failing"}, {"type": "subtitle", "time": 9029.07, "timestamp": "02:30:29", "text": "scared me.  I didn't have the courage to see everyone's disappointed faces"}, {"type": "subtitle", "time": 9035.95, "timestamp": "02:30:35", "text": ".  But now I understand.   The"}, {"type": "subtitle", "time": 9039.55, "timestamp": "02:30:39", "text": "moment I decide to do it, the gold will"}, {"type": "subtitle", "time": 9042.309, "timestamp": "02:30:42", "text": "never fall to the ground."}, {"type": "subtitle", "time": 9046.23, "timestamp": "02:30:46", "text": "Yeah.  Because a friend told me to."}, {"type": "subtitle", "time": 9049.63, "timestamp": "02:30:49", "text": "We did our best until the very end, so we have no regrets"}, {"type": "subtitle", "time": 9058.79, "timestamp": "02:30:58", "text": "trying"}]
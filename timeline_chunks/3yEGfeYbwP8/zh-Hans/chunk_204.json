[{"type": "subtitle", "time": 12243.67, "timestamp": "03:24:03", "text": "关于这方面，我有很多故事想讲。喜欢"}, {"type": "subtitle", "time": 12248.469, "timestamp": "03:24:08", "text": "我说很多次"}, {"type": "subtitle", "time": 12258.63, "timestamp": "03:24:18", "text": "哦，说到这个……"}, {"type": "subtitle", "time": 12266.87, "timestamp": "03:24:26", "text": "纱耶太，我没事。"}, {"type": "subtitle", "time": 12271.469, "timestamp": "03:24:31", "text": "我已经做过很多次了，不是吗？"}, {"type": "subtitle", "time": 12273.429, "timestamp": "03:24:33", "text": "今天"}, {"type": "subtitle", "time": 12282.349, "timestamp": "03:24:42", "text": "是的"}, {"type": "subtitle", "time": 12292.349, "timestamp": "03:24:52", "text": "我"}, {"type": "subtitle", "time": 12295.389, "timestamp": "03:24:55", "text": "这样做"}, {"type": "subtitle", "time": 12298.07, "timestamp": "03:24:58", "text": "天堂"}, {"type": "subtitle", "time": 12299.63, "timestamp": "03:24:59", "text": "现在"}]
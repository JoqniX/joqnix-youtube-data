[{"type": "subtitle", "time": 2468.43, "timestamp": "00:41:08", "text": "我从丹雅那里听说，最近"}, {"type": "subtitle", "time": 2472.589, "timestamp": "00:41:12", "text": "这就像解开一个谜团。是的。有趣的"}, {"type": "subtitle", "time": 2475.27, "timestamp": "00:41:15", "text": "尽量从标量点的开头一直做到结尾。"}, {"type": "subtitle", "time": 2478.829, "timestamp": "00:41:18", "text": "我正打算这么做。"}, {"type": "subtitle", "time": 2482.43, "timestamp": "00:41:22", "text": "在解开谜团的过程中，并没有发生任何奇怪的事情。"}, {"type": "subtitle", "time": 2484.44, "timestamp": "00:41:24", "text": "。 全是些怪事。"}, {"type": "subtitle", "time": 2500.43, "timestamp": "00:41:40", "text": "1"}]
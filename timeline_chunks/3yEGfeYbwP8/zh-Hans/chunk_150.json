[{"type": "subtitle", "time": 9014.269, "timestamp": "02:30:14", "text": "每个人都有这样的期望。"}, {"type": "subtitle", "time": 9018.79, "timestamp": "02:30:18", "text": "天气晴朗温暖。"}, {"type": "subtitle", "time": 9021.99, "timestamp": "02:30:21", "text": "但它很重。"}, {"type": "subtitle", "time": 9025.469, "timestamp": "02:30:25", "text": "以前，只要想象自己失败就足够了。"}, {"type": "subtitle", "time": 9029.07, "timestamp": "02:30:29", "text": "太可怕了。看到大家失望的表情"}, {"type": "subtitle", "time": 9035.95, "timestamp": "02:30:35", "text": "我没有勇气。但我现在明白了。"}, {"type": "subtitle", "time": 9039.55, "timestamp": "02:30:39", "text": "我决定这么做的那一刻，黄金就散落在地上了。"}, {"type": "subtitle", "time": 9042.309, "timestamp": "02:30:42", "text": "它不会掉下来。"}, {"type": "subtitle", "time": 9046.23, "timestamp": "02:30:46", "text": "是的。因为朋友让我这么做。"}, {"type": "subtitle", "time": 9049.63, "timestamp": "02:30:49", "text": "我们尽了全力直到最后一刻，毫无遗憾。"}, {"type": "subtitle", "time": 9058.79, "timestamp": "02:30:58", "text": "即使有些事情你无法忍受，也不要勉强自己。"}]
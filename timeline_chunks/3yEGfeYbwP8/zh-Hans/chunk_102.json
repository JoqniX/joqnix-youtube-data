[{"type": "subtitle", "time": 6124.03, "timestamp": "01:42:04", "text": "通过全国海豹考试后，你就可以成年了。"}, {"type": "subtitle", "time": 6126.79, "timestamp": "01:42:06", "text": "对于罗伊族人来说，这是一场非常重要的仪式。"}, {"type": "subtitle", "time": 6129.43, "timestamp": "01:42:09", "text": "这是正确的。"}, {"type": "subtitle", "time": 6133.47, "timestamp": "01:42:13", "text": "是的。我至今仍记得这件事。在收到刻字之前"}, {"type": "subtitle", "time": 6138.91, "timestamp": "01:42:18", "text": "那天我兴奋得彻夜难眠。"}, {"type": "subtitle", "time": 6142.39, "timestamp": "01:42:22", "text": "照片中的女孩很快就要成年了。"}, {"type": "subtitle", "time": 6145.229, "timestamp": "01:42:25", "text": "我不知道他们是不是这么想的。"}]
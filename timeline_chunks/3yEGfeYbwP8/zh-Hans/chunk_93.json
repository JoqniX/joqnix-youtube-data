[{"type": "subtitle", "time": 5617.47, "timestamp": "01:33:37", "text": "所以，你想让我难过还是开心？"}, {"type": "subtitle", "time": 5622.189, "timestamp": "01:33:42", "text": "它们是不同的词，但意思相同。"}, {"type": "subtitle", "time": 5626.27, "timestamp": "01:33:46", "text": "丽宁大姐一边听着自己内心的声音，一边发言。"}, {"type": "subtitle", "time": 5639.03, "timestamp": "01:33:59", "text": "Shiguri-ka 很有趣。"}]
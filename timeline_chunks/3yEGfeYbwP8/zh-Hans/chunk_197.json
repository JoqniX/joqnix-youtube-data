[{"type": "subtitle", "time": 11825.309, "timestamp": "03:17:05", "text": "总有一天，总有一天"}, {"type": "subtitle", "time": 11828.95, "timestamp": "03:17:08", "text": "哦，那是什么来着？"}, {"type": "subtitle", "time": 11833.349, "timestamp": "03:17:13", "text": "妈妈，有个机会，有个机会"}, {"type": "subtitle", "time": 11849.55, "timestamp": "03:17:29", "text": "“机遇”的日语怎么说？机器，没错。"}, {"type": "subtitle", "time": 11853.229, "timestamp": "03:17:33", "text": "。当机器相遇"}, {"type": "subtitle", "time": 11857.07, "timestamp": "03:17:37", "text": "我会做这件事。是的。萨纳尔"}, {"type": "subtitle", "time": 11859.389, "timestamp": "03:17:39", "text": "forcombytoday。"}, {"type": "subtitle", "time": 11863.03, "timestamp": "03:17:43", "text": "得去想想"}, {"type": "subtitle", "time": 11865.99, "timestamp": "03:17:45", "text": "我的意思是，我本来可以……"}, {"type": "subtitle", "time": 11874.99, "timestamp": "03:17:54", "text": "我现在可以"}]
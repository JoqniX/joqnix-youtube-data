[{"type": "subtitle", "time": 11825.309, "timestamp": "03:17:05", "text": "總有一天，總有一天"}, {"type": "subtitle", "time": 11828.95, "timestamp": "03:17:08", "text": "哦，那是什麼來著？"}, {"type": "subtitle", "time": 11833.349, "timestamp": "03:17:13", "text": "媽媽，有機會，有機會"}, {"type": "subtitle", "time": 11849.55, "timestamp": "03:17:29", "text": "「機會」的日文怎麼說？機器，沒錯。"}, {"type": "subtitle", "time": 11853.229, "timestamp": "03:17:33", "text": "。當機器相遇"}, {"type": "subtitle", "time": 11857.07, "timestamp": "03:17:37", "text": "我會做這件事。是的。薩納爾"}, {"type": "subtitle", "time": 11859.389, "timestamp": "03:17:39", "text": "forcombytoday。"}, {"type": "subtitle", "time": 11863.03, "timestamp": "03:17:43", "text": "得去想想"}, {"type": "subtitle", "time": 11865.99, "timestamp": "03:17:45", "text": "我的意思是，我本來可以…"}, {"type": "subtitle", "time": 11874.99, "timestamp": "03:17:54", "text": "我現在可以"}]
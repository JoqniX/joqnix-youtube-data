[{"type": "subtitle", "time": 867.629, "timestamp": "00:14:27", "text": "這就是為什麼研究人員正試圖逐一揭開這座地下學院的秘密。"}, {"type": "subtitle", "time": 871.509, "timestamp": "00:14:31", "text": "它僅限於該範圍內。學生們每年都盼望著這一天的到來"}, {"type": "subtitle", "time": 873.749, "timestamp": "00:14:33", "text": "透過將其變成一款無害的遊戲，"}, {"type": "subtitle", "time": 878.11, "timestamp": "00:14:38", "text": "他們收留了他們。透過解開這個謎團，我終於明白了自己之前的困惑。"}, {"type": "subtitle", "time": 881.55, "timestamp": "00:14:41", "text": "面對。以及在地下學院中累積的情感"}, {"type": "subtitle", "time": 885.15, "timestamp": "00:14:45", "text": "解決並發布。這是一個益智遊戲"}, {"type": "subtitle", "time": 888.43, "timestamp": "00:14:48", "text": "這是開始。"}, {"type": "subtitle", "time": 893.11, "timestamp": "00:14:53", "text": "然而，現在情況已經改變了。龍"}, {"type": "subtitle", "time": 896.59, "timestamp": "00:14:56", "text": "據老師說，學生的心理狀態不太好。"}]
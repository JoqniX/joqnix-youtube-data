[{"type": "subtitle", "time": 12243.67, "timestamp": "03:24:03", "text": "關於這方面，我有很多故事想講。喜歡"}, {"type": "subtitle", "time": 12248.469, "timestamp": "03:24:08", "text": "我說很多次"}, {"type": "subtitle", "time": 12258.63, "timestamp": "03:24:18", "text": "哦，說到這個…"}, {"type": "subtitle", "time": 12266.87, "timestamp": "03:24:26", "text": "紗耶太，我沒事。"}, {"type": "subtitle", "time": 12271.469, "timestamp": "03:24:31", "text": "我已經做過很多次了，不是嗎？"}, {"type": "subtitle", "time": 12273.429, "timestamp": "03:24:33", "text": "今天"}, {"type": "subtitle", "time": 12282.349, "timestamp": "03:24:42", "text": "是的"}, {"type": "subtitle", "time": 12292.349, "timestamp": "03:24:52", "text": "我"}, {"type": "subtitle", "time": 12295.389, "timestamp": "03:24:55", "text": "這樣做"}, {"type": "subtitle", "time": 12298.07, "timestamp": "03:24:58", "text": "天堂"}, {"type": "subtitle", "time": 12299.63, "timestamp": "03:24:59", "text": "現在"}]
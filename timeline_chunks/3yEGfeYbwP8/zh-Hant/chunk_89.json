[{"type": "subtitle", "time": 5349.27, "timestamp": "01:29:09", "text": "發生什麼事？"}, {"type": "subtitle", "time": 5350.43, "timestamp": "01:29:10", "text": "我以為我打破了"}, {"type": "subtitle", "time": 5352.83, "timestamp": "01:29:12", "text": "遊戲才剛開始。"}, {"type": "subtitle", "time": 5354.189, "timestamp": "01:29:14", "text": "我的天啊。我以為我"}, {"type": "subtitle", "time": 5383.709, "timestamp": "01:29:43", "text": "於是，我的前輩來拜訪我了。"}]
[{"type": "subtitle", "time": 11460.15, "timestamp": "03:11:00", "text": "我也很想在晚上做一些戶外直播。"}, {"type": "subtitle", "time": 11464.349, "timestamp": "03:11:04", "text": "但是時間已經不夠了，時間不夠用。"}, {"type": "subtitle", "time": 11469.51, "timestamp": "03:11:09", "text": "沒有。呃，呃，什麼時候上線？"}, {"type": "subtitle", "time": 11474.469, "timestamp": "03:11:14", "text": "我想這肯定不行。我也是，我的"}, {"type": "subtitle", "time": 11479.389, "timestamp": "03:11:19", "text": "工作、兼職、學習等等。"}, {"type": "subtitle", "time": 11483.03, "timestamp": "03:11:23", "text": "因為我需要一些私人時間。"}, {"type": "subtitle", "time": 11489.19, "timestamp": "03:11:29", "text": "我真的不知道。我該怎麼辦？"}, {"type": "subtitle", "time": 11492.99, "timestamp": "03:11:32", "text": "但是玩太多電子遊戲並不好。"}, {"type": "subtitle", "time": 11498.83, "timestamp": "03:11:38", "text": "我現在玩的遊戲，啊，我現在正在玩遊戲"}, {"type": "subtitle", "time": 11505.03, "timestamp": "03:11:45", "text": "即使只是為了直播，"}, {"type": "subtitle", "time": 11509.99, "timestamp": "03:11:49", "text": "實際上，遊戲版本更好。"}, {"type": "subtitle", "time": 11514.429, "timestamp": "03:11:54", "text": "我想多做一些作曲工作。"}, {"type": "subtitle", "time": 11517.229, "timestamp": "03:11:57", "text": "大概"}]
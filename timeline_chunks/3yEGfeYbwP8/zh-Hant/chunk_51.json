[{"type": "subtitle", "time": 3064.47, "timestamp": "00:51:04", "text": "是的。我們走吧。"}, {"type": "subtitle", "time": 3071.51, "timestamp": "00:51:11", "text": "黑板上有一個黑洞。"}, {"type": "subtitle", "time": 3073.789, "timestamp": "00:51:13", "text": "是的。在黑洞之下"}, {"type": "subtitle", "time": 3075.589, "timestamp": "00:51:15", "text": "我知道。這是"}, {"type": "subtitle", "time": 3094.069, "timestamp": "00:51:34", "text": "她是赫利俄里克6號"}]
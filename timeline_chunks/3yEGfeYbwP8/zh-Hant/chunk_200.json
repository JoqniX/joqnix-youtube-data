[{"type": "subtitle", "time": 12006.11, "timestamp": "03:20:06", "text": "今天的日程安排是什麼？"}, {"type": "subtitle", "time": 12010.07, "timestamp": "03:20:10", "text": "啊。那是什麼？那是什麼？"}, {"type": "subtitle", "time": 12015.51, "timestamp": "03:20:15", "text": "正確的？是的。今天我去商業超市了。"}, {"type": "subtitle", "time": 12019.71, "timestamp": "03:20:19", "text": "我去大創買了一些東西。"}, {"type": "subtitle", "time": 12022.75, "timestamp": "03:20:22", "text": "烹調食物，"}, {"type": "subtitle", "time": 12026.469, "timestamp": "03:20:26", "text": "啊，我今天會學一會兒。"}, {"type": "subtitle", "time": 12029.07, "timestamp": "03:20:29", "text": "錄音也"}, {"type": "subtitle", "time": 12033.189, "timestamp": "03:20:33", "text": "啊，我應該去做。是的。這也"}, {"type": "subtitle", "time": 12036.269, "timestamp": "03:20:36", "text": "知道了！"}, {"type": "subtitle", "time": 12054.75, "timestamp": "03:20:54", "text": "我怎麼說的？我不知道。"}, {"type": "subtitle", "time": 12059.389, "timestamp": "03:20:59", "text": "我喜歡這個結論。"}]
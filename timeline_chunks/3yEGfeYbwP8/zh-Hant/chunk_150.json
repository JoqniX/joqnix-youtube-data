[{"type": "subtitle", "time": 9014.269, "timestamp": "02:30:14", "text": "每個人都有這樣的期望。"}, {"type": "subtitle", "time": 9018.79, "timestamp": "02:30:18", "text": "天氣晴朗溫暖。"}, {"type": "subtitle", "time": 9021.99, "timestamp": "02:30:21", "text": "但它很重。"}, {"type": "subtitle", "time": 9025.469, "timestamp": "02:30:25", "text": "以前，只要想像自己失敗就夠了。"}, {"type": "subtitle", "time": 9029.07, "timestamp": "02:30:29", "text": "太可怕了。看到大家失望的表情"}, {"type": "subtitle", "time": 9035.95, "timestamp": "02:30:35", "text": "我沒有勇氣。但我現在明白了。"}, {"type": "subtitle", "time": 9039.55, "timestamp": "02:30:39", "text": "我決定這麼做的那一刻，黃金就散落在地上了。"}, {"type": "subtitle", "time": 9042.309, "timestamp": "02:30:42", "text": "它不會掉下來。"}, {"type": "subtitle", "time": 9046.23, "timestamp": "02:30:46", "text": "是的。因為朋友要我這麼做。"}, {"type": "subtitle", "time": 9049.63, "timestamp": "02:30:49", "text": "我們盡了全力直到最後一刻，毫無遺憾。"}, {"type": "subtitle", "time": 9058.79, "timestamp": "02:30:58", "text": "即使有些事情你無法忍受，也不要勉強自己。"}]
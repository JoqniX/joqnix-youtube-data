[{"type": "subtitle", "time": 5617.47, "timestamp": "01:33:37", "text": "所以，你想讓我難過還是開心？"}, {"type": "subtitle", "time": 5622.189, "timestamp": "01:33:42", "text": "它們是不同的詞，但意思相同。"}, {"type": "subtitle", "time": 5626.27, "timestamp": "01:33:46", "text": "麗寧大姊一邊聽著自己內心的聲音，一邊發言。"}, {"type": "subtitle", "time": 5639.03, "timestamp": "01:33:59", "text": "Shiguri-ka 很有趣。"}]
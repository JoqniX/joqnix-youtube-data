[{"type": "subtitle", "time": 12600.83, "timestamp": "03:30:00", "text": "牙齒"}, {"type": "subtitle", "time": 12605.309, "timestamp": "03:30:05", "text": "哦，大家都在這裡。不，不。"}, {"type": "subtitle", "time": 12607.469, "timestamp": "03:30:07", "text": "是的。感謝所有前來的人"}, {"type": "subtitle", "time": 12609.91, "timestamp": "03:30:09", "text": "今天之前。真的意思是"}, {"type": "subtitle", "time": 12617.229, "timestamp": "03:30:17", "text": "。感謝你的辛勤工作。今天是個好日子。"}, {"type": "subtitle", "time": 12625.91, "timestamp": "03:30:25", "text": "我希望你們能說"}, {"type": "subtitle", "time": 12628.07, "timestamp": "03:30:28", "text": "祝您今天愉快！"}, {"type": "subtitle", "time": 12630.79, "timestamp": "03:30:30", "text": "哦好"}, {"type": "subtitle", "time": 12632.389, "timestamp": "03:30:32", "text": "以及那些"}, {"type": "subtitle", "time": 12633.55, "timestamp": "03:30:33", "text": "去上班"}, {"type": "subtitle", "time": 12636.99, "timestamp": "03:30:36", "text": "盡你所能，永遠如此。"}, {"type": "subtitle", "time": 12639.269, "timestamp": "03:30:39", "text": "某種"}, {"type": "subtitle", "time": 12641.91, "timestamp": "03:30:41", "text": "dotrynottooverwtoo"}, {"type": "subtitle", "time": 12643.189, "timestamp": "03:30:43", "text": "muchokandgethe"}, {"type": "subtitle", "time": 12647.349, "timestamp": "03:30:47", "text": "Stroke and Stuff，繼續加油！"}, {"type": "subtitle", "time": 12653.11, "timestamp": "03:30:53", "text": "放輕鬆，放輕鬆，好好休息。"}, {"type": "subtitle", "time": 12657.229, "timestamp": "03:30:57", "text": "每個人。是的。是的，今天真是"}]
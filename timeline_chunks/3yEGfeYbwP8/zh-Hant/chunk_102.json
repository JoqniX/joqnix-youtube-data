[{"type": "subtitle", "time": 6124.03, "timestamp": "01:42:04", "text": "通過全國海豹考試後，你就可以成年了。"}, {"type": "subtitle", "time": 6126.79, "timestamp": "01:42:06", "text": "對羅伊族人來說，這是一場非常重要的儀式。"}, {"type": "subtitle", "time": 6129.43, "timestamp": "01:42:09", "text": "這是正確的。"}, {"type": "subtitle", "time": 6133.47, "timestamp": "01:42:13", "text": "是的。我至今仍記得這件事。在收到刻字之前"}, {"type": "subtitle", "time": 6138.91, "timestamp": "01:42:18", "text": "那天我興奮得徹夜難眠。"}, {"type": "subtitle", "time": 6142.39, "timestamp": "01:42:22", "text": "照片中的女孩很快就要成年了。"}, {"type": "subtitle", "time": 6145.229, "timestamp": "01:42:25", "text": "我不知道他們是不是這麼想的。"}]
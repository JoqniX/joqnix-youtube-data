[{"type": "subtitle", "time": 2468.43, "timestamp": "00:41:08", "text": "我從丹雅那裡聽說，最近"}, {"type": "subtitle", "time": 2472.589, "timestamp": "00:41:12", "text": "這就像解開一個謎團。是的。有趣的"}, {"type": "subtitle", "time": 2475.27, "timestamp": "00:41:15", "text": "盡量從標量點的開頭一直做到結尾。"}, {"type": "subtitle", "time": 2478.829, "timestamp": "00:41:18", "text": "我正打算這麼做。"}, {"type": "subtitle", "time": 2482.43, "timestamp": "00:41:22", "text": "在解開謎團的過程中，並沒有發生任何奇怪的事情。"}, {"type": "subtitle", "time": 2484.44, "timestamp": "00:41:24", "text": "。 全是些怪事。"}, {"type": "subtitle", "time": 2500.43, "timestamp": "00:41:40", "text": "1"}]
[{"type": "subtitle", "time": 2164.23, "timestamp": "00:36:04", "text": "それに私の友達はこのイベントが好きだっ"}, {"type": "subtitle", "time": 2167.309, "timestamp": "00:36:07", "text": "たの。この前彼女とたくさんの謎を解いた"}, {"type": "subtitle", "time": 2171.51, "timestamp": "00:36:11", "text": "んだ。今どこにいるのかわからないけど"}, {"type": "subtitle", "time": 2174.309, "timestamp": "00:36:14", "text": "戻ってくるまで彼女の分も一緒に頑張ら"}, {"type": "subtitle", "time": 2178.23, "timestamp": "00:36:18", "text": "なくちゃ。いい成績を取ったらきっと喜ん"}, {"type": "subtitle", "time": 2184.55, "timestamp": "00:36:24", "text": "でくれると思うの。見ろしが超えてるぞ。"}, {"type": "subtitle", "time": 2187.51, "timestamp": "00:36:27", "text": "未来のヘリオディック6だもの。私を"}, {"type": "subtitle", "time": 2190.309, "timestamp": "00:36:30", "text": "超えるくらい楽勝でしょうね。"}]
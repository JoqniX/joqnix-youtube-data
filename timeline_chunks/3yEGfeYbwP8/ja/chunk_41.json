[{"type": "subtitle", "time": 2468.43, "timestamp": "00:41:08", "text": "ダニャから聞いたんだけど、最近はずっと"}, {"type": "subtitle", "time": 2472.589, "timestamp": "00:41:12", "text": "謎解きをしてるみたいだね。うん。面白い"}, {"type": "subtitle", "time": 2475.27, "timestamp": "00:41:15", "text": "から縮点が終わるまでにできるだけ挑戦"}, {"type": "subtitle", "time": 2478.829, "timestamp": "00:41:18", "text": "しようと思ったな。"}, {"type": "subtitle", "time": 2482.43, "timestamp": "00:41:22", "text": "謎解きをしてる時何か変なことはなかった"}, {"type": "subtitle", "time": 2484.43, "timestamp": "00:41:24", "text": "。"}, {"type": "subtitle", "time": 2500.43, "timestamp": "00:41:40", "text": "1"}]
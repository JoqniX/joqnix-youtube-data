[{"type": "subtitle", "time": 6124.03, "timestamp": "01:42:04", "text": "から国印試練を通過すれば成人できるわ。"}, {"type": "subtitle", "time": 6126.79, "timestamp": "01:42:06", "text": "ロイ人たちにとってそれくらい大事な儀式"}, {"type": "subtitle", "time": 6129.43, "timestamp": "01:42:09", "text": "なのよ。"}, {"type": "subtitle", "time": 6133.47, "timestamp": "01:42:13", "text": "はい。今も覚えてます。刻印を受ける前の"}, {"type": "subtitle", "time": 6138.91, "timestamp": "01:42:18", "text": "日は興奮しすぎて全然眠れませんでした。"}, {"type": "subtitle", "time": 6142.39, "timestamp": "01:42:22", "text": "もうすぐ成人この絵に書かれた女の子も"}, {"type": "subtitle", "time": 6145.229, "timestamp": "01:42:25", "text": "そんな風に思ってるのかな。"}]
[{"type": "subtitle", "time": 12006.11, "timestamp": "03:20:06", "text": "今日のスケツが何でしょうかな?"}, {"type": "subtitle", "time": 12010.07, "timestamp": "03:20:10", "text": "ああは。なんでしょう?何でしょう?何"}, {"type": "subtitle", "time": 12015.51, "timestamp": "03:20:15", "text": "でしょう?はい。今日ね、業務スーパーと"}, {"type": "subtitle", "time": 12019.71, "timestamp": "03:20:19", "text": "ダイソに行って買い物やって"}, {"type": "subtitle", "time": 12022.75, "timestamp": "03:20:22", "text": "ご飯作ったり、"}, {"type": "subtitle", "time": 12026.469, "timestamp": "03:20:26", "text": "ああ、ちょっと今日勉強"}, {"type": "subtitle", "time": 12029.07, "timestamp": "03:20:29", "text": "のレコーリングも"}, {"type": "subtitle", "time": 12033.189, "timestamp": "03:20:33", "text": "ああ、やった方がいいな。そうね。これも"}, {"type": "subtitle", "time": 12036.269, "timestamp": "03:20:36", "text": "やったり。"}, {"type": "subtitle", "time": 12054.75, "timestamp": "03:20:54", "text": "どうしたら言った?わかんない。"}, {"type": "subtitle", "time": 12059.389, "timestamp": "03:20:59", "text": "Ilovethisfalling"}]
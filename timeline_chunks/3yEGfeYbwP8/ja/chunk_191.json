[{"type": "subtitle", "time": 11460.15, "timestamp": "03:11:00", "text": "あいっぱいあ夜の外配信もやりたいと思っ"}, {"type": "subtitle", "time": 11464.349, "timestamp": "03:11:04", "text": "ているけどもう時間がないよ、時間が足り"}, {"type": "subtitle", "time": 11469.51, "timestamp": "03:11:09", "text": "ない。い、え、いつは、あ、配信するのは"}, {"type": "subtitle", "time": 11474.469, "timestamp": "03:11:14", "text": "ダメでしょうかでしょうね。私も私のあ、"}, {"type": "subtitle", "time": 11479.389, "timestamp": "03:11:19", "text": "仕事とかアルバイトとか勉強とかあ、"}, {"type": "subtitle", "time": 11483.03, "timestamp": "03:11:23", "text": "プライベートの時間とかいるから"}, {"type": "subtitle", "time": 11489.19, "timestamp": "03:11:29", "text": "本当にわからない。どうすればいいって。"}, {"type": "subtitle", "time": 11492.99, "timestamp": "03:11:32", "text": "でもいっぱいゲームしてるのはダメだよ。"}, {"type": "subtitle", "time": 11498.83, "timestamp": "03:11:38", "text": "ゲームは私今、あ、僕は今ゲームやるのは"}, {"type": "subtitle", "time": 11505.03, "timestamp": "03:11:45", "text": "配信に配信のためにだけでもな、"}, {"type": "subtitle", "time": 11509.99, "timestamp": "03:11:49", "text": "実はゲームの方のより"}, {"type": "subtitle", "time": 11514.429, "timestamp": "03:11:54", "text": "作曲ももっとやりたいと思ってるけど、"}, {"type": "subtitle", "time": 11517.229, "timestamp": "03:11:57", "text": "もう多分"}]
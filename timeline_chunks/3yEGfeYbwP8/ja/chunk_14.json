[{"type": "subtitle", "time": 867.629, "timestamp": "00:14:27", "text": "だからこそ研究員は裏学園を1つ1つの謎"}, {"type": "subtitle", "time": 871.509, "timestamp": "00:14:31", "text": "の中に制限した。学生たちが毎年楽しみに"}, {"type": "subtitle", "time": 873.749, "timestamp": "00:14:33", "text": "しているゲームとして無害化することで"}, {"type": "subtitle", "time": 878.11, "timestamp": "00:14:38", "text": "収容したの。謎解きを通して自分の戸惑い"}, {"type": "subtitle", "time": 881.55, "timestamp": "00:14:41", "text": "に直面する。そして裏学園に溜まった感情"}, {"type": "subtitle", "time": 885.15, "timestamp": "00:14:45", "text": "を解消させ解き放つ。これが謎解きゲーム"}, {"type": "subtitle", "time": 888.43, "timestamp": "00:14:48", "text": "の始まりよ。"}, {"type": "subtitle", "time": 893.11, "timestamp": "00:14:53", "text": "ただ今は状況が変わってしまった。龍ク"}, {"type": "subtitle", "time": 896.59, "timestamp": "00:14:56", "text": "先生によると学戦の心理状態がしくない"}]
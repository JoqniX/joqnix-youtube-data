[{"type": "subtitle", "time": 3667.47, "timestamp": "01:01:07", "text": "これで最後だって分かってるよね。自分を"}, {"type": "subtitle", "time": 3670.029, "timestamp": "01:01:10", "text": "証明できる。"}, {"type": "subtitle", "time": 3673.39, "timestamp": "01:01:13", "text": "ロイ人にとって才能とは何なのか。"}, {"type": "subtitle", "time": 3676.069, "timestamp": "01:01:16", "text": "神のわり者とは何なの?"}]
[{"type": "subtitle", "time": 3928.549, "timestamp": "01:05:28", "text": "だから仕方なく別のやり方を探したわ。"}, {"type": "subtitle", "time": 3932.109, "timestamp": "01:05:32", "text": "幸い裏学園に発生した感情までは制限でき"}, {"type": "subtitle", "time": 3934.309, "timestamp": "01:05:34", "text": "ないよね。"}, {"type": "subtitle", "time": 3939.109, "timestamp": "01:05:39", "text": "どんな感情も裏学園に必ず痕跡が残る。"}, {"type": "subtitle", "time": 3941.269, "timestamp": "01:05:41", "text": "この間あなたたちが開いたファンクラブの"}, {"type": "subtitle", "time": 3943.829, "timestamp": "01:05:43", "text": "イベントでたくさんの優しい思い出ができ"}, {"type": "subtitle", "time": 3947.029, "timestamp": "01:05:47", "text": "たからこの歌の力で2人を連れ戻せたのよ"}, {"type": "subtitle", "time": 3949.789, "timestamp": "01:05:49", "text": "。"}, {"type": "subtitle", "time": 3952.99, "timestamp": "01:05:52", "text": "あの化け物はただの残像じゃ。"}]
[{"type": "subtitle", "time": 785.069, "timestamp": "00:13:05", "text": "そこには理想や情熱、焦り、そして悲しみ"}, {"type": "subtitle", "time": 792.71, "timestamp": "00:13:12", "text": "それらの感情は裏学園に吸収されているの"}, {"type": "subtitle", "time": 796.31, "timestamp": "00:13:16", "text": "よ。だからみんなの本当学園の裏側が渦だ"}, {"type": "subtitle", "time": 799.949, "timestamp": "00:13:19", "text": "としたら焦りや悲しみといった感情はその"}, {"type": "subtitle", "time": 805.91, "timestamp": "00:13:25", "text": "渦の中心。疑いを押し合い、膨らみ、"}, {"type": "subtitle", "time": 810.23, "timestamp": "00:13:30", "text": "やがて学生の考えに影響を及ぼし、次第に"}, {"type": "subtitle", "time": 821.43, "timestamp": "00:13:41", "text": "そう、一時期学園はこの問題に悩まされて"}]
[{"type": "subtitle", "time": 9014.269, "timestamp": "02:30:14", "text": "みんなみたいな期待"}, {"type": "subtitle", "time": 9018.79, "timestamp": "02:30:18", "text": "はとても眩しくて温かい"}, {"type": "subtitle", "time": 9021.99, "timestamp": "02:30:21", "text": "けど重いの"}, {"type": "subtitle", "time": 9025.469, "timestamp": "02:30:25", "text": "前は失敗した自分の姿を想像するだけでも"}, {"type": "subtitle", "time": 9029.07, "timestamp": "02:30:29", "text": "怖かった。みんなのがっかりする顔を見る"}, {"type": "subtitle", "time": 9035.95, "timestamp": "02:30:35", "text": "勇気はなかった。でも今なら分かる。"}, {"type": "subtitle", "time": 9039.55, "timestamp": "02:30:39", "text": "私がやるって決めた時点で黄金が地に"}, {"type": "subtitle", "time": 9042.309, "timestamp": "02:30:42", "text": "落ちることはない。"}, {"type": "subtitle", "time": 9046.23, "timestamp": "02:30:46", "text": "うん。友達に言われたから。"}, {"type": "subtitle", "time": 9049.63, "timestamp": "02:30:49", "text": "私たちは後悔せず最後まで頑張ったから"}, {"type": "subtitle", "time": 9058.79, "timestamp": "02:30:58", "text": "たえできないことがあっても挑戦しなく"}]
[{"type": "subtitle", "time": 900.189, "timestamp": "00:15:00", "text": "らしいわ。まるで何かの影響を受けている"}, {"type": "subtitle", "time": 902.67, "timestamp": "00:15:02", "text": "かのような。"}, {"type": "subtitle", "time": 906.749, "timestamp": "00:15:06", "text": "さらに今の裏学園には学園外の周波数が"}, {"type": "subtitle", "time": 911.389, "timestamp": "00:15:11", "text": "存在しているけれど1の特定も解析もでき"}, {"type": "subtitle", "time": 919.069, "timestamp": "00:15:19", "text": "もっと情報が必要なの。ただ組織長の"}, {"type": "subtitle", "time": 922.749, "timestamp": "00:15:22", "text": "スパイを見つけ出すことで私は精一杯。"}, {"type": "subtitle", "time": 925.99, "timestamp": "00:15:25", "text": "控えの祝点が控えている上に学生の心理"}, {"type": "subtitle", "time": 930.069, "timestamp": "00:15:30", "text": "状態は不安定。楽観的な状況とは言えない"}, {"type": "subtitle", "time": 934.23, "timestamp": "00:15:34", "text": "わね。組織長は学園の秩序を満たそうと"}, {"type": "subtitle", "time": 939.189, "timestamp": "00:15:39", "text": "企んでいる。奴の本当の狙いはおそらく"}, {"type": "subtitle", "time": 943.99, "timestamp": "00:15:43", "text": "この混乱の中に潜んでいるはず。"}]
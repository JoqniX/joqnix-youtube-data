[{"type": "subtitle", "time": 13085.269, "timestamp": "03:38:05", "text": "？呃，他們中的一些人在打堡壘"}, {"type": "subtitle", "time": 13097.19, "timestamp": "03:38:17", "text": "可以去那裡。是啊。我的天啊天哪。看到"}, {"type": "subtitle", "time": 13110.95, "timestamp": "03:38:30", "text": "火箭跳躍者和轟炸者了。我們想去那裡。操。操。操。操。操。操。操。操。操。操。操。操。操。操"}, {"type": "subtitle", "time": 13113.349, "timestamp": "03:38:33", "text": "。他們看到我們了。哦，我的天。火箭人來了。我忘了它發射導彈就像丟垃圾一樣"}, {"type": "subtitle", "time": 13134.07, "timestamp": "03:38:54", "text": "我正在射擊它。它怎麼"}]
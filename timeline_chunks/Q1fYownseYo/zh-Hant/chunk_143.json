[{"type": "subtitle", "time": 8580.07, "timestamp": "02:23:00", "text": "我已經拿到設計圖了。快點"}, {"type": "subtitle", "time": 8581.27, "timestamp": "02:23:01", "text": "。"}, {"type": "subtitle", "time": 8584.63, "timestamp": "02:23:04", "text": "我聽說你可以…你知道如何"}, {"type": "subtitle", "time": 8591.349, "timestamp": "02:23:11", "text": "在Arc上建立一個新帳號嗎？我需要買新遊戲嗎？"}, {"type": "subtitle", "time": 8592.389, "timestamp": "02:23:12", "text": "是的。"}, {"type": "subtitle", "time": 8594.55, "timestamp": "02:23:14", "text": "什麼？真的嗎？"}, {"type": "subtitle", "time": 8596.95, "timestamp": "02:23:16", "text": "是的。你想轉移哪些"}, {"type": "subtitle", "time": 8598.309, "timestamp": "02:23:18", "text": "東西？"}, {"type": "subtitle", "time": 8599.67, "timestamp": "02:23:19", "text": "是啊，我就是想幹掉這個"}, {"type": "subtitle", "time": 8607.349, "timestamp": "02:23:27", "text": "哦，想想那該有多好。不。"}, {"type": "subtitle", "time": 8610.15, "timestamp": "02:23:30", "text": "我的天哪。"}, {"type": "subtitle", "time": 8613.59, "timestamp": "02:23:33", "text": "等等，你想要倖存者嗎？"}, {"type": "subtitle", "time": 8616.614, "timestamp": "02:23:36", "text": "不，我知道。我已經有了。"}, {"type": "subtitle", "time": 8624.95, "timestamp": "02:23:44", "text": "好的。還有什麼？"}, {"type": "subtitle", "time": 8629.67, "timestamp": "02:23:49", "text": "商人劫掠者。呃，試驗"}, {"type": "subtitle", "time": 8632.469, "timestamp": "02:23:52", "text": "黃蜂彈出了"}, {"type": "subtitle", "time": 8636.469, "timestamp": "02:23:56", "text": "槓桿馴鹿。好的。"}]
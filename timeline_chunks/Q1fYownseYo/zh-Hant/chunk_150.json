[{"type": "subtitle", "time": 9001.03, "timestamp": "02:30:01", "text": "希望它不是玩家對戰模式（PVP）。"}, {"type": "subtitle", "time": 9001.19, "timestamp": "02:30:01", "text": "這"}, {"type": "subtitle", "time": 9004.07, "timestamp": "02:30:04", "text": "取決於。但是，呃，這種事確實會發生。嗯，這"}, {"type": "subtitle", "time": 9015.11, "timestamp": "02:30:15", "text": "我不想失去鐵砧。"}, {"type": "subtitle", "time": 9018.789, "timestamp": "02:30:18", "text": "我拿到我的長笛了。"}, {"type": "subtitle", "time": 9019.75, "timestamp": "02:30:19", "text": "[笑聲]"}, {"type": "subtitle", "time": 9022.07, "timestamp": "02:30:22", "text": "誰都"}, {"type": "subtitle", "time": 9042.23, "timestamp": "02:30:42", "text": "別想射笛子。  是的。  哦，是的。呃，現在你可以繼續嘗試並打破紀錄了。  嗯，是的。是的。  我看到有人在《"}, {"type": "subtitle", "time": 9048.63, "timestamp": "02:30:48", "text": "瘋狂了。我的天啊。"}, {"type": "subtitle", "time": 9051.19, "timestamp": "02:30:51", "text": "太搞笑了。  是的"}, {"type": "subtitle", "time": 9054.23, "timestamp": "02:30:54", "text": "。不知怎麼的，我居然把"}, {"type": "subtitle", "time": 9057.99, "timestamp": "02:30:57", "text": "火箭兵給震暈了，然後它就翻轉了"}]
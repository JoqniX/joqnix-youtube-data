[{"type": "subtitle", "time": 360.07, "timestamp": "00:06:00", "text": "你好。最新更新。最新更新。我剛剛"}, {"type": "subtitle", "time": 362.95, "timestamp": "00:06:02", "text": "完成了遊戲更新。"}, {"type": "subtitle", "time": 365.189, "timestamp": "00:06:05", "text": "遊戲更新完畢，就在"}, {"type": "subtitle", "time": 372.629, "timestamp": "00:06:12", "text": "呃，"}, {"type": "subtitle", "time": 375.51, "timestamp": "00:06:15", "text": "關掉它。"}, {"type": "subtitle", "time": 378.15, "timestamp": "00:06:18", "text": "給我一分鐘時間。"}, {"type": "subtitle", "time": 381.83, "timestamp": "00:06:21", "text": "需要再次確認一下。"}, {"type": "subtitle", "time": 384.79, "timestamp": "00:06:24", "text": "是的，它正在運行。你好。呃，好的。"}, {"type": "subtitle", "time": 387.83, "timestamp": "00:06:27", "text": "這是什麼？我吃了一頓飯。一千萬"}, {"type": "subtitle", "time": 389.99, "timestamp": "00:06:29", "text": "掠奪者。到目前為止，這真是一段驚心動魄的旅程"}, {"type": "subtitle", "time": 392.15, "timestamp": "00:06:32", "text": "。我們正在慶祝。一個重要的"}, {"type": "subtitle", "time": 394.15, "timestamp": "00:06:34", "text": "里程碑。銹帶地區有1000萬掠奪者"}, {"type": "subtitle", "time": 397.99, "timestamp": "00:06:37", "text": "。哦，這是一把金鎬。"}, {"type": "subtitle", "time": 401.029, "timestamp": "00:06:41", "text": "正確的。感謝各位交易員的愛護。嗯，還有"}, {"type": "subtitle", "time": 403.51, "timestamp": "00:06:43", "text": "更多精彩內容即將"}, {"type": "subtitle", "time": 408.55, "timestamp": "00:06:48", "text": "推出。嗯，所以我們希望你能留下來，見證"}, {"type": "subtitle", "time": 410.39, "timestamp": "00:06:50", "text": "前1000萬的旅程。所以，"}, {"type": "subtitle", "time": 411.83, "timestamp": "00:06:51", "text": "這裡簡單概括一下。是的。"}, {"type": "subtitle", "time": 414.79, "timestamp": "00:06:54", "text": "謝謝。  是的，全新的"}, {"type": "subtitle", "time": 417.59000000000003, "timestamp": "00:06:57", "text": "掠奪者工具。"}]
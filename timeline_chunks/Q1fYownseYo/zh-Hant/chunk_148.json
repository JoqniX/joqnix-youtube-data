[{"type": "subtitle", "time": 8883.83, "timestamp": "02:28:03", "text": "。"}, {"type": "subtitle", "time": 8887.429, "timestamp": "02:28:07", "text": "重新升級醫學實驗室後你會得到什麼"}, {"type": "subtitle", "time": 8890.469, "timestamp": "02:28:10", "text": "？你完成弧形"}, {"type": "subtitle", "time": 8893.67, "timestamp": "02:28:13", "text": "測量員的工作了嗎？"}, {"type": "subtitle", "time": 8895.429, "timestamp": "02:28:15", "text": "醫學方面，"}, {"type": "subtitle", "time": 8898.23, "timestamp": "02:28:18", "text": "你把你的"}, {"type": "subtitle", "time": 8901.19, "timestamp": "02:28:21", "text": "醫學實驗室升級到三級了？"}, {"type": "subtitle", "time": 8904.71, "timestamp": "02:28:24", "text": "嗯，沒什麼。"}, {"type": "subtitle", "time": 8908.79, "timestamp": "02:28:28", "text": "解鎖的東西是紫色的還是藍色的？"}, {"type": "subtitle", "time": 8910.79, "timestamp": "02:28:30", "text": "不，我想應該有Vita專用噴霧，但"}, {"type": "subtitle", "time": 8913.349, "timestamp": "02:28:33", "text": "需要藍圖。"}, {"type": "subtitle", "time": 8914.55, "timestamp": "02:28:34", "text": "啊，"}, {"type": "subtitle", "time": 8917.19, "timestamp": "02:28:37", "text": "我也這麼認為。"}, {"type": "subtitle", "time": 8920.23, "timestamp": "02:28:40", "text": "好的。糟了，我需要盾牌。我忘了"}, {"type": "subtitle", "time": 8922.309, "timestamp": "02:28:42", "text": "這件事了。"}]
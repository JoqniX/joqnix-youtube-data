[{"type": "subtitle", "time": 7571.91, "timestamp": "02:06:11", "text": "？"}, {"type": "subtitle", "time": 7574.149, "timestamp": "02:06:14", "text": "耶穌。  某人被提取出來。  嗯，是的，有個男的。  給他一支艦隊。  我想"}, {"type": "subtitle", "time": 7585.51, "timestamp": "02:06:25", "text": "來說，我們還需要擊落兩架火箭。  所以總共應該是三個吧。  瘋狂的。  我的天哪"}]
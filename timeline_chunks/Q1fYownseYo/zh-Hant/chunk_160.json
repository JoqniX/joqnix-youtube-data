[{"type": "subtitle", "time": 9602.71, "timestamp": "02:40:02", "text": "碎紙機一樣"}, {"type": "subtitle", "time": 9607.75, "timestamp": "02:40:07", "text": "。  想去嗎？"}, {"type": "subtitle", "time": 9614.15, "timestamp": "02:40:14", "text": "哦。哦，是的。當然可以。  就是一堆"}, {"type": "subtitle", "time": 9630.15, "timestamp": "02:40:30", "text": "碎紙機。  嗯，差不多了。  我的天啊。我差點以為自己死了。  別擔心，喬克。  好的。碎紙機來了。碎紙機來了。  點這裡獲取。  正"}, {"type": "subtitle", "time": 9646.71, "timestamp": "02:40:46", "text": "朝那邊走來。  我有膽量。  左，左，左，左，左，左，左，"}, {"type": "subtitle", "time": 9659.75, "timestamp": "02:40:59", "text": "射擊。  啊"}]
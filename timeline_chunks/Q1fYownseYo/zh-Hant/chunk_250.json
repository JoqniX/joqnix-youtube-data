[{"type": "subtitle", "time": 15006.15, "timestamp": "04:10:06", "text": "兄弟？快點。哦，他們殺了我"}, {"type": "subtitle", "time": 15012.63, "timestamp": "04:10:12", "text": "。快點，快點，快點。真的。你能救我嗎？不能。但他們真的殺了你嗎"}, {"type": "subtitle", "time": 15020.07, "timestamp": "04:10:20", "text": "？"}, {"type": "subtitle", "time": 15022.55, "timestamp": "04:10:22", "text": "是啊，他們只是貪圖戰利品。該死。是的，我們拿到了"}]
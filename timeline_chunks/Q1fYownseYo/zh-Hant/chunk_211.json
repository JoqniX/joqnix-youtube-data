[{"type": "subtitle", "time": 12669.83, "timestamp": "03:31:09", "text": "打架嗎？沒有。我臉上突然爬了隻"}, {"type": "subtitle", "time": 12686.87, "timestamp": "03:31:26", "text": "。算了。好吧。操。我"}, {"type": "subtitle", "time": 12703.429, "timestamp": "03:31:43", "text": "有這把槍。近距離打不了。"}, {"type": "subtitle", "time": 12710.15, "timestamp": "03:31:50", "text": "有人叫……呃……開始吧"}, {"type": "subtitle", "time": 12715.99, "timestamp": "03:31:55", "text": "。你知道嗎？"}]
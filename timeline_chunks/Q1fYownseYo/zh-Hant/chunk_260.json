[{"type": "subtitle", "time": 15600.95, "timestamp": "04:20:00", "text": "？好的，是的。嘿，Alexa，一起走"}, {"type": "subtitle", "time": 15619.3, "timestamp": "04:20:19", "text": "。等一下。我要去搜刮這枚火箭。我拿到了火箭兵玩意兒。不錯。我們可以去……呃，艙門"}, {"type": "subtitle", "time": 15630.229, "timestamp": "04:20:30", "text": "鑰匙在哪裡？是"}, {"type": "subtitle", "time": 15632.389, "timestamp": "04:20:32", "text": "啊。以防萬一。你看，至少在這個"}, {"type": "subtitle", "time": 15635.429, "timestamp": "04:20:35", "text": "該死的伺服器裡，人們還會互相交流。是啊。哦"}, {"type": "subtitle", "time": 15640.63, "timestamp": "04:20:40", "text": "，PVP PVP PVP。一隻老鼠。一隻"}, {"type": "subtitle", "time": 15642.229, "timestamp": "04:20:42", "text": "老鼠。好吧。進來。來了。來了。來了。培根。"}, {"type": "subtitle", "time": 15646.71, "timestamp": "04:20:46", "text": "培根。該死的傢伙，我們走吧"}]
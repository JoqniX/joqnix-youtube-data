[{"type": "subtitle", "time": 14350.309, "timestamp": "03:59:10", "text": "，對，那是我的。你的呢？"}, {"type": "subtitle", "time": 14359.51, "timestamp": "03:59:19", "text": "我應該趕緊把它放進保險箱的。你沒有女族長或男族長嗎？嘿，艙門鑰匙。呃"}, {"type": "subtitle", "time": 14390.229, "timestamp": "03:59:50", "text": "倖存者嗎？我不知道。"}, {"type": "subtitle", "time": 14392.15, "timestamp": "03:59:52", "text": "是的，你可以。是什麼阻止你"}]
[{"type": "subtitle", "time": 13994.55, "timestamp": "03:53:14", "text": "有人在搜刮這裡。別太貪心。一定要找到核心"}, {"type": "subtitle", "time": 14009.189, "timestamp": "03:53:29", "text": "。我在地窖鑰匙的地方。啊"}, {"type": "subtitle", "time": 14014.55, "timestamp": "03:53:34", "text": "，"}, {"type": "subtitle", "time": 14022.229, "timestamp": "03:53:42", "text": "地窖門。我喜歡倖存者。哦，"}, {"type": "subtitle", "time": 14030.63, "timestamp": "03:53:50", "text": "看，"}, {"type": "subtitle", "time": 14031.189, "timestamp": "03:53:51", "text": "快跑。"}, {"type": "subtitle", "time": 14035.83, "timestamp": "03:53:55", "text": "看，看。哦，真是個"}, {"type": "subtitle", "time": 14039.429, "timestamp": "03:53:59", "text": "混蛋。哦，我的天。我甚至從來都不相信任何人。我的天，這該死的……你死了嗎？死了。"}]
[{"type": "subtitle", "time": 5649.51, "timestamp": "01:34:09", "text": "等等，我把這個丟哪了？該死！"}, {"type": "subtitle", "time": 5685.43, "timestamp": "01:34:45", "text": "哦，哨兵來了。"}, {"type": "subtitle", "time": 5689.189, "timestamp": "01:34:49", "text": "那東西是哨兵，對吧？  我確實想反抗。  我的天啊。"}, {"type": "subtitle", "time": 5694.39, "timestamp": "01:34:54", "text": "那麼，我"}, {"type": "subtitle", "time": 5697.83, "timestamp": "01:34:57", "text": "今天能拿到多少把鑰匙？  呃，我該反抗嗎？  我確實需要那通充滿溫情的"}]
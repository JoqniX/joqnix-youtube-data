[{"type": "subtitle", "time": 5520.79, "timestamp": "01:32:00", "text": "[倒抽一口氣]"}, {"type": "subtitle", "time": 5523.43, "timestamp": "01:32:03", "text": "哦，這到底是怎麼回事？  我渾身黏糊糊的。  呃，我全身黏黏的"}, {"type": "subtitle", "time": 5543.27, "timestamp": "01:32:23", "text": "，"}, {"type": "subtitle", "time": 5566.39, "timestamp": "01:32:46", "text": "。我應該去哪裡購買萃取物？"}, {"type": "subtitle", "time": 5566.95, "timestamp": "01:32:46", "text": "好的。"}, {"type": "subtitle", "time": 5568.229, "timestamp": "01:32:48", "text": "搭水處理"}, {"type": "subtitle", "time": 5570.07, "timestamp": "01:32:50", "text": "電梯回家。  我感覺被困住了。  一艘弧形軌道飛行器正在飛行"}]
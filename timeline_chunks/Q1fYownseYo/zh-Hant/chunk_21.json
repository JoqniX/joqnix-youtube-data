[{"type": "subtitle", "time": 1261.99, "timestamp": "00:21:01", "text": "顯然，你得……"}, {"type": "subtitle", "time": 1267.59, "timestamp": "00:21:07", "text": "哦，我的天哪。火箭人。"}, {"type": "subtitle", "time": 1269.75, "timestamp": "00:21:09", "text": "顯然，你需要解鎖。"}, {"type": "subtitle", "time": 1271.75, "timestamp": "00:21:11", "text": "掠奪者註意了。北天線已"}, {"type": "subtitle", "time": 1284.71, "timestamp": "00:21:24", "text": "不要開槍。"}, {"type": "subtitle", "time": 1314.39, "timestamp": "00:21:54", "text": "另外，這個公告最後"}, {"type": "subtitle", "time": 1316.789, "timestamp": "00:21:56", "text": "發布了嗎？我的天哪，這要花好多"}]
[{"type": "subtitle", "time": 187.19, "timestamp": "00:03:07", "text": "辦法。到底是什麼問題來著？這是什麼？"}, {"type": "subtitle", "time": 194.149, "timestamp": "00:03:14", "text": "你好，弗蘭科。歡迎來到直播間。"}, {"type": "subtitle", "time": 196.22899999999998, "timestamp": "00:03:16", "text": "你好。你好。"}, {"type": "subtitle", "time": 197.76, "timestamp": "00:03:17", "text": "你好。 問："}, {"type": "subtitle", "time": 200.4, "timestamp": "00:03:20", "text": "問： 我需要解決這個問題。我需要解決這個問題。"}, {"type": "subtitle", "time": 209.75, "timestamp": "00:03:29", "text": "你好，蘭戈。呃，稍等一下。給我一"}, {"type": "subtitle", "time": 212.71, "timestamp": "00:03:32", "text": "分鐘時間。"}, {"type": "subtitle", "time": 232.149, "timestamp": "00:03:52", "text": "等待。哦。哦。哦。我真是太笨了。哦。  哦。  哦。"}, {"type": "subtitle", "time": 235.67000000000002, "timestamp": "00:03:55", "text": "這是錯誤的。好的。好的。好的。我修好了，我修好了。"}, {"type": "subtitle", "time": 237.67000000000002, "timestamp": "00:03:57", "text": "我修好了。好的。"}, {"type": "subtitle", "time": 239.19, "timestamp": "00:03:59", "text": "保存。"}]
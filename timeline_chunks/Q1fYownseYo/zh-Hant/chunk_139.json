[{"type": "subtitle", "time": 8341.359, "timestamp": "02:19:01", "text": "不要開槍。 大家好。"}, {"type": "subtitle", "time": 8349.19, "timestamp": "02:19:09", "text": "呃，帽子上的運動衫。哦，糟糕。好的。  好的"}, {"type": "subtitle", "time": 8351.83, "timestamp": "02:19:11", "text": "。我們就待在那兒吧。我們就"}, {"type": "subtitle", "time": 8353.75, "timestamp": "02:19:13", "text": "待在這裡，"}, {"type": "subtitle", "time": 8356.549, "timestamp": "02:19:16", "text": "試著找黃蜂。那是什麼？"}, {"type": "subtitle", "time": 8377.91, "timestamp": "02:19:37", "text": "好的。我有一群狼。我們應該"}, {"type": "subtitle", "time": 8383.75, "timestamp": "02:19:43", "text": "不，只是為了安全起見。我認為我們不"}, {"type": "subtitle", "time": 8384.549, "timestamp": "02:19:44", "text": "應該這樣做。"}, {"type": "subtitle", "time": 8387.349, "timestamp": "02:19:47", "text": "我會保存下來。是啊，反正就是個跳躍高手。"}, {"type": "subtitle", "time": 8392.389, "timestamp": "02:19:52", "text": "讓我們確保這次飛躍成功。"}, {"type": "subtitle", "time": 8394.389, "timestamp": "02:19:54", "text": "我只要一件真正的西裝外套就能搞定一切。我想放手一搏。"}]
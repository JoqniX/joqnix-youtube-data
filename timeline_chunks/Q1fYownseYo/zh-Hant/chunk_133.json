[{"type": "subtitle", "time": 7981.43, "timestamp": "02:13:01", "text": "又上位了。"}, {"type": "subtitle", "time": 7984.629, "timestamp": "02:13:04", "text": "試著向火箭兵開一槍，"}, {"type": "subtitle", "time": 7993.75, "timestamp": "02:13:13", "text": "好的，稍等一下。它正朝這邊過來。呃，它在"}, {"type": "subtitle", "time": 7995.83, "timestamp": "02:13:15", "text": "哪裡？什麼鬼？"}, {"type": "subtitle", "time": 7999.91, "timestamp": "02:13:19", "text": "等等，這個位置不好。呃，我是在哪個"}, {"type": "subtitle", "time": 8001.99, "timestamp": "02:13:21", "text": "房間拍的？  好吧，"}, {"type": "subtitle", "time": 8012.55, "timestamp": "02:13:32", "text": "這裡沒有屋頂。啊，我的建議是，就"}, {"type": "subtitle", "time": 8014.95, "timestamp": "02:13:34", "text": "站在樓裡就行了。  好的。  好的。"}, {"type": "subtitle", "time": 8017.43, "timestamp": "02:13:37", "text": "開槍。你能把它射下來嗎？它正向"}, {"type": "subtitle", "time": 8017.83, "timestamp": "02:13:37", "text": "我走來。  它在哪裡？它在哪裡？它在"}, {"type": "subtitle", "time": 8019.189, "timestamp": "02:13:39", "text": "哪裡？"}, {"type": "subtitle", "time": 8020.709, "timestamp": "02:13:40", "text": "標記。"}, {"type": "subtitle", "time": 8022.149, "timestamp": "02:13:42", "text": "嗯，我看到了。"}, {"type": "subtitle", "time": 8025.75, "timestamp": "02:13:45", "text": "就像在我頭頂上一樣。你看到了嗎？"}, {"type": "subtitle", "time": 8036.709, "timestamp": "02:13:56", "text": "我死了。我死了。哦，你沒死。"}]
[{"type": "subtitle", "time": 8700.309, "timestamp": "02:25:00", "text": "知道了。他們說他們要對"}, {"type": "subtitle", "time": 8709.75, "timestamp": "02:25:09", "text": "斯特拉希望這次夜襲就在那裡。  我的"}, {"type": "subtitle", "time": 8712.389, "timestamp": "02:25:12", "text": "天哪。那將會成為"}, {"type": "subtitle", "time": 8714.79, "timestamp": "02:25:14", "text": "我們整個戰場。等等，Stella"}, {"type": "subtitle", "time": 8717.91, "timestamp": "02:25:17", "text": "應該比較容易完成那個"}, {"type": "subtitle", "time": 8720.87, "timestamp": "02:25:20", "text": "滾球遊戲吧？  是的"}, {"type": "subtitle", "time": 8722.23, "timestamp": "02:25:22", "text": "。"}, {"type": "subtitle", "time": 8724.63, "timestamp": "02:25:24", "text": "我想去。"}, {"type": "subtitle", "time": 8727.349, "timestamp": "02:25:27", "text": "是的。"}, {"type": "subtitle", "time": 8729.99, "timestamp": "02:25:29", "text": "讓我升級一下我的槍。"}, {"type": "subtitle", "time": 8733.349, "timestamp": "02:25:33", "text": "哦，我得升級一下槍了。我忘了。"}, {"type": "subtitle", "time": 8735.83, "timestamp": "02:25:35", "text": "呃，[嘆氣] 手井。  我的資源"}, {"type": "subtitle", "time": 8743.91, "timestamp": "02:25:43", "text": "我沒有資源。哦，沒事了。"}, {"type": "subtitle", "time": 8751.51, "timestamp": "02:25:51", "text": "如何獲得機械部件？"}, {"type": "subtitle", "time": 8753.51, "timestamp": "02:25:53", "text": "哦。"}]
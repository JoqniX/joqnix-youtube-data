[{"type": "subtitle", "time": 8280.549, "timestamp": "02:18:00", "text": "我只是不想死，不想"}, {"type": "subtitle", "time": 8282.87, "timestamp": "02:18:02", "text": "失去之前的努力。  它是"}, {"type": "subtitle", "time": 8290.15, "timestamp": "02:18:10", "text": "這是跳躍者嗎？我的天哪。  是的。是的"}, {"type": "subtitle", "time": 8301.19, "timestamp": "02:18:21", "text": "不要開槍。"}, {"type": "subtitle", "time": 8308.07, "timestamp": "02:18:28", "text": "永遠不要說「不要開槍」。你就"}, {"type": "subtitle", "time": 8309.99, "timestamp": "02:18:29", "text": "吹笛子就行了。"}, {"type": "subtitle", "time": 8312.79, "timestamp": "02:18:32", "text": "沒有人會殺你。沒人會"}, {"type": "subtitle", "time": 8314.95, "timestamp": "02:18:34", "text": "去殺一個吹笛子的人。"}, {"type": "subtitle", "time": 8317.27, "timestamp": "02:18:37", "text": "你在哪裡？"}, {"type": "subtitle", "time": 8325.349, "timestamp": "02:18:45", "text": "有點想多待一會兒看看那隻大"}, {"type": "subtitle", "time": 8327.91, "timestamp": "02:18:47", "text": "黃蜂。  是"}, {"type": "subtitle", "time": 8329.509, "timestamp": "02:18:49", "text": "啊，是"}, {"type": "subtitle", "time": 8330.87, "timestamp": "02:18:50", "text": "啊，我們可以留下來。"}, {"type": "subtitle", "time": 8336.639, "timestamp": "02:18:56", "text": "。 嘿，別開槍。謝謝。"}, {"type": "subtitle", "time": 8339.84, "timestamp": "02:18:59", "text": "嘿，別開槍。謝謝。 不要開槍。"}]
[{"type": "subtitle", "time": 7800.31, "timestamp": "02:10:00", "text": "有人死了。是的。"}, {"type": "subtitle", "time": 7815.51, "timestamp": "02:10:15", "text": "二、三、四、六架無人機。我的天啊。  我認為我們應該重新開始。  等等，那"}, {"type": "subtitle", "time": 7819.91, "timestamp": "02:10:19", "text": "是什麼？  大黃蜂"}, {"type": "subtitle", "time": 7820.709, "timestamp": "02:10:20", "text": "。"}, {"type": "subtitle", "time": 7826.39, "timestamp": "02:10:26", "text": "它"}, {"type": "subtitle", "time": 7854.87, "timestamp": "02:10:54", "text": "多少錢？好的，我們在另一個出生點有半顆星。  我們的手錶耐用度評分為"}]
[{"type": "subtitle", "time": 480.07, "timestamp": "00:08:00", "text": "如果我沒記錯的話，甚至連"}, {"type": "subtitle", "time": 483.11, "timestamp": "00:08:03", "text": "剩下的都沒有了。審判就在那裡。"}, {"type": "subtitle", "time": 485.83, "timestamp": "00:08:05", "text": "我的庭審進度仍然落後。我得"}, {"type": "subtitle", "time": 489.35, "timestamp": "00:08:09", "text": "把東西收拾好，把事情做完，等等"}, {"type": "subtitle", "time": 491.589, "timestamp": "00:08:11", "text": "等等。  嗯"}, {"type": "subtitle", "time": 493.99, "timestamp": "00:08:13", "text": "，"}, {"type": "subtitle", "time": 495.99, "timestamp": "00:08:15", "text": "隱藏的碉堡。  哦，"}, {"type": "subtitle", "time": 504.55, "timestamp": "00:08:24", "text": "隱藏的地堡。等等，等等，等等。我們需要這個。哦，哦，哦，哦，哦，哦，哦"}, {"type": "subtitle", "time": 507.749, "timestamp": "00:08:27", "text": "，哦。隱藏的"}, {"type": "subtitle", "time": 511.029, "timestamp": "00:08:31", "text": "地堡。好的，好的，好的，好的，好的。哦，我們去隱密的地堡吧。呃，我們有什麼？好的，我"}, {"type": "subtitle", "time": 515.19, "timestamp": "00:08:35", "text": "有一些基本的東西。嗯，你知道嗎？我要去"}]
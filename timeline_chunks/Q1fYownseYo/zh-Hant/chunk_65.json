[{"type": "subtitle", "time": 3939.67, "timestamp": "01:05:39", "text": "帽子是不能撤離的。我忘了它是夜光魚。  有人開槍嗎？  不要開槍。  我總覺得我要遲到了。  到了派對現場，發現已經被"}, {"type": "subtitle", "time": 3941.91, "timestamp": "01:05:41", "text": "洗劫一空了"}, {"type": "subtitle", "time": 3945.349, "timestamp": "01:05:45", "text": "。  哦，等等。它"}]
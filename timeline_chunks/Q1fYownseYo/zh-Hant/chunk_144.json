[{"type": "subtitle", "time": 8650.55, "timestamp": "02:24:10", "text": "我們看不到地圖。  是的"}, {"type": "subtitle", "time": 8653.59, "timestamp": "02:24:13", "text": "，我想只有你才能看到地圖。"}, {"type": "subtitle", "time": 8656.07, "timestamp": "02:24:16", "text": "呃，我當時想："}, {"type": "subtitle", "time": 8657.67, "timestamp": "02:24:17", "text": "嗯。好的，等等。  是"}, {"type": "subtitle", "time": 8662.07, "timestamp": "02:24:22", "text": "啊，只有你喜歡那個……呃……那個"}, {"type": "subtitle", "time": 8665.19, "timestamp": "02:24:25", "text": "叫什麼來著？大堂老闆。"}, {"type": "subtitle", "time": 8679.349, "timestamp": "02:24:39", "text": "？"}, {"type": "subtitle", "time": 8682.309, "timestamp": "02:24:42", "text": "保留那些可以用來製作工藝品的材料，"}, {"type": "subtitle", "time": 8684.87, "timestamp": "02:24:44", "text": "例如碎紙機 JRO。反正現在也"}, {"type": "subtitle", "time": 8687.11, "timestamp": "02:24:47", "text": "沒什麼用了，我可以把它回收"}, {"type": "subtitle", "time": 8690.469, "timestamp": "02:24:50", "text": "。我認為"}, {"type": "subtitle", "time": 8693.99, "timestamp": "02:24:53", "text": "第二次探險需要 Shredder JRO"}, {"type": "subtitle", "time": 8695.03, "timestamp": "02:24:55", "text": "。"}, {"type": "subtitle", "time": 8697.19, "timestamp": "02:24:57", "text": "是的，我們是第一次探險，"}, {"type": "subtitle", "time": 8698.469, "timestamp": "02:24:58", "text": "對吧？"}]
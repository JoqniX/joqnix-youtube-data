[{"type": "subtitle", "time": 14704.469, "timestamp": "04:05:04", "text": "？操。它們在互相戰鬥。"}, {"type": "subtitle", "time": 14727.75, "timestamp": "04:05:27", "text": "女王？哦，我的天，我卡頓到1格了。不。哦，它們在互相"}, {"type": "subtitle", "time": 14731.91, "timestamp": "04:05:31", "text": "戰鬥。"}, {"type": "subtitle", "time": 14741.91, "timestamp": "04:05:41", "text": "走吧。走吧。你以前和女王戰鬥過嗎？沒有。第一次。"}, {"type": "subtitle", "time": 14742.469, "timestamp": "04:05:42", "text": "什麼"}, {"type": "subtitle", "time": 14745.429, "timestamp": "04:05:45", "text": "？所以它們有比……更多的武器，而不僅僅是……你他媽……"}, {"type": "subtitle", "time": 14749.349, "timestamp": "04:05:49", "text": "哦，我的天，只有三顆子彈。"}]
[{"type": "subtitle", "time": 1217.35, "timestamp": "00:20:17", "text": "剩下的就讓他們留著吧。我不要。"}, {"type": "subtitle", "time": 1219.27, "timestamp": "00:20:19", "text": "為什麼你們不做完"}, {"type": "subtitle", "time": 1222.63, "timestamp": "00:20:22", "text": "掩體裡的準備就走了？"}, {"type": "subtitle", "time": 1236.23, "timestamp": "00:20:36", "text": "我沒有鞋跟，對吧？"}, {"type": "subtitle", "time": 1247.99, "timestamp": "00:20:47", "text": "那麼，接下來人們就會問"}, {"type": "subtitle", "time": 1251.19, "timestamp": "00:20:51", "text": "醫生，這裡的計畫是什麼？所以，"}, {"type": "subtitle", "time": 1255.029, "timestamp": "00:20:55", "text": "我的計畫是把天線運到這裡，"}, {"type": "subtitle", "time": 1258.95, "timestamp": "00:20:58", "text": "看看效果如何。"}]
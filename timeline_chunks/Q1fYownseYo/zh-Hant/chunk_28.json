[{"type": "subtitle", "time": 1683.83, "timestamp": "00:28:03", "text": "哦，這傢伙在做"}, {"type": "subtitle", "time": 1707.43, "timestamp": "00:28:27", "text": "我覺得我應該谷歌一下。"}, {"type": "subtitle", "time": 1715.99, "timestamp": "00:28:35", "text": "我們的創造者"}, {"type": "subtitle", "time": 1731.11, "timestamp": "00:28:51", "text": "。愚蠢的。  就在"}, {"type": "subtitle", "time": 1732.07, "timestamp": "00:28:52", "text": "這裡。  我們"}]
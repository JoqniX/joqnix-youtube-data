[{"type": "subtitle", "time": 7883.99, "timestamp": "02:11:23", "text": "不會，只會修理。啊，我"}, {"type": "subtitle", "time": 7887.91, "timestamp": "02:11:27", "text": "升級了，只是升級了"}, {"type": "subtitle", "time": 7889.51, "timestamp": "02:11:29", "text": "槍而已。  你不需要升級槍枝。"}, {"type": "subtitle", "time": 7891.27, "timestamp": "02:11:31", "text": "我知道。"}, {"type": "subtitle", "time": 7893.51, "timestamp": "02:11:33", "text": "為什麼不升級一下槍呢？這"}, {"type": "subtitle", "time": 7895.75, "timestamp": "02:11:35", "text": "差別太大了。"}, {"type": "subtitle", "time": 7897.43, "timestamp": "02:11:37", "text": "好的。  是的"}, {"type": "subtitle", "time": 7900.95, "timestamp": "02:11:40", "text": "，我真的需要做這件事。"}, {"type": "subtitle", "time": 7903.91, "timestamp": "02:11:43", "text": "啊，找到了。  好吧，"}, {"type": "subtitle", "time": 7910.79, "timestamp": "02:11:50", "text": "我只有17個。"}, {"type": "subtitle", "time": 7913.109, "timestamp": "02:11:53", "text": "哦，天哪，那隻鳥。那隻鳥把我身上的"}, {"type": "subtitle", "time": 7916.229, "timestamp": "02:11:56", "text": "糞便都吐出來了。  呃，好的。"}]
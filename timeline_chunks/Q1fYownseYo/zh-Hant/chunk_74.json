[{"type": "subtitle", "time": 4445.99, "timestamp": "01:14:05", "text": "我在那裡。有人真的開槍打中我了。  那不是"}, {"type": "subtitle", "time": 4448.95, "timestamp": "01:14:08", "text": "弧線。那是真人玩家。  等待"}, {"type": "subtitle", "time": 4460.87, "timestamp": "01:14:20", "text": "什麼？一名玩家開槍打中了我。"}, {"type": "subtitle", "time": 4465.35, "timestamp": "01:14:25", "text": "各位，這個人是誰？  兄弟，"}, {"type": "subtitle", "time": 4469.669, "timestamp": "01:14:29", "text": "你幹嘛按嗶嗶聲？"}, {"type": "subtitle", "time": 4474.229, "timestamp": "01:14:34", "text": "我應該在 com"}, {"type": "subtitle", "time": 4493.91, "timestamp": "01:14:53", "text": "謝天謝地，我"}, {"type": "subtitle", "time": 4495.669, "timestamp": "01:14:55", "text": "很容易就提取出來了。"}]
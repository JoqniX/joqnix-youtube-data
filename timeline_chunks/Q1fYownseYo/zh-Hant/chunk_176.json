[{"type": "subtitle", "time": 10594.07, "timestamp": "02:56:34", "text": "我要去搜尋一下Arc Arc的律師。  好了，我們走吧"}, {"type": "subtitle", "time": 10596.469, "timestamp": "02:56:36", "text": "。  我的天啊。霍利還是殺了他。"}, {"type": "subtitle", "time": 10612.07, "timestamp": "02:56:52", "text": "哦，你做得太棒了。  我的天啊，為什麼？為什麼它突然就"}, {"type": "subtitle", "time": 10616.87, "timestamp": "02:56:56", "text": "停住了？耶穌基督。  媽的。嗯"}]
[{"type": "subtitle", "time": 8463.83, "timestamp": "02:21:03", "text": "我看不出有什麼要點。"}, {"type": "subtitle", "time": 8466.07, "timestamp": "02:21:06", "text": "還想再幹掉一個火箭兵嗎？"}, {"type": "subtitle", "time": 8483.11, "timestamp": "02:21:23", "text": "我們周圍。有一個。哦，"}, {"type": "subtitle", "time": 8485.429, "timestamp": "02:21:25", "text": "還有朝聖者峰，那裡有"}, {"type": "subtitle", "time": 8488.23, "timestamp": "02:21:28", "text": "很多火箭刷新點。"}, {"type": "subtitle", "time": 8490.23, "timestamp": "02:21:30", "text": "我得去拍它。 [笑聲]"}, {"type": "subtitle", "time": 8498.79, "timestamp": "02:21:38", "text": "你要開槍嗎？"}, {"type": "subtitle", "time": 8502.23, "timestamp": "02:21:42", "text": "呃，當那個東西打開的時候。是的。  是的。  又"}, {"type": "subtitle", "time": 8505.83, "timestamp": "02:21:45", "text": "一個。好的。你開槍打中了那個。"}, {"type": "subtitle", "time": 8508.309, "timestamp": "02:21:48", "text": "我來射殺我們身後的。"}, {"type": "subtitle", "time": 8511.75, "timestamp": "02:21:51", "text": "好的。好的。好的。三，"}, {"type": "subtitle", "time": 8512.07, "timestamp": "02:21:52", "text": "二。"}, {"type": "subtitle", "time": 8514.389, "timestamp": "02:21:54", "text": "哦，天哪，喬克。嗯，"}]
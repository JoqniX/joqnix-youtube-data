[{"type": "subtitle", "time": 13523.189, "timestamp": "03:45:23", "text": "哦，它死了。哦，不。它沒死。有人設定了最後期限。哦，真的。不，它沒死。"}, {"type": "subtitle", "time": 13526.469, "timestamp": "03:45:26", "text": "哦，該死。我得去對付轟炸機。我要去"}, {"type": "subtitle", "time": 13530.469, "timestamp": "03:45:30", "text": "對付轟炸機。是啊。是啊。是啊。那玩意兒真煩人。"}, {"type": "subtitle", "time": 13535.75, "timestamp": "03:45:35", "text": "等等，我有一種奇怪的感覺。等等，"}, {"type": "subtitle", "time": 13542.229, "timestamp": "03:45:42", "text": "我有一種奇怪的感覺，他們會偷我們的東西"}]
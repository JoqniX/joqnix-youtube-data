[{"type": "subtitle", "time": 303.83, "timestamp": "00:05:03", "text": "問題。不，我花了點時間"}, {"type": "subtitle", "time": 308.71, "timestamp": "00:05:08", "text": "修復所有漏洞，然後"}, {"type": "subtitle", "time": 313.189, "timestamp": "00:05:13", "text": "我睡得很晚。"}, {"type": "subtitle", "time": 316.71, "timestamp": "00:05:16", "text": "所以，這就是為什麼今天這個"}, {"type": "subtitle", "time": 320.07, "timestamp": "00:05:20", "text": "時候，我沒有像往常一樣進行晨間直播，而是在複習"}, {"type": "subtitle", "time": 325.189, "timestamp": "00:05:25", "text": "我的考試，日文"}, {"type": "subtitle", "time": 328.95, "timestamp": "00:05:28", "text": "考試。我早上稍微做了一點，是的"}, {"type": "subtitle", "time": 334.55, "timestamp": "00:05:34", "text": "。你好。總之，我還是切換到"}, {"type": "subtitle", "time": 336.55, "timestamp": "00:05:36", "text": "遊戲模式吧。哦，景色（音樂）變了"}, {"type": "subtitle", "time": 340.31, "timestamp": "00:05:40", "text": "。好的。"}, {"type": "subtitle", "time": 342.55, "timestamp": "00:05:42", "text": "你好。我們創作者的最新更新來了"}, {"type": "subtitle", "time": 344.31, "timestamp": "00:05:44", "text": "。"}, {"type": "subtitle", "time": 348.55, "timestamp": "00:05:48", "text": "呃，你看不到比賽。"}, {"type": "subtitle", "time": 350.87, "timestamp": "00:05:50", "text": "嗯，就是這樣"}, {"type": "subtitle", "time": 354.07, "timestamp": "00:05:54", "text": "。  聽"}, {"type": "subtitle", "time": 356.15, "timestamp": "00:05:56", "text": "得到聲音嗎？好了，現在可以了。"}]
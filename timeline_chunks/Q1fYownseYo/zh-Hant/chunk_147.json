[{"type": "subtitle", "time": 8828.71, "timestamp": "02:27:08", "text": "你拿到Defa藍圖了嗎？"}, {"type": "subtitle", "time": 8830.63, "timestamp": "02:27:10", "text": "是的，我做了。  哇。  好的"}, {"type": "subtitle", "time": 8840.71, "timestamp": "02:27:20", "text": "。某處。"}, {"type": "subtitle", "time": 8844.07, "timestamp": "02:27:24", "text": "拿些繃帶，我還得自己做，"}, {"type": "subtitle", "time": 8847.429, "timestamp": "02:27:27", "text": "你知道，買個"}, {"type": "subtitle", "time": 8848.469, "timestamp": "02:27:28", "text": "盾牌。"}, {"type": "subtitle", "time": 8850.55, "timestamp": "02:27:30", "text": "進來吧，突襲者。好"}, {"type": "subtitle", "time": 8852.469, "timestamp": "02:27:32", "text": "東西我已經準備好了。"}, {"type": "subtitle", "time": 8854.389, "timestamp": "02:27:34", "text": "你讓我看起來很厲害。繼續努力吧"}, {"type": "subtitle", "time": 8855.51, "timestamp": "02:27:35", "text": "。"}, {"type": "subtitle", "time": 8858.23, "timestamp": "02:27:38", "text": "好了，我們走吧。"}, {"type": "subtitle", "time": 8859.99, "timestamp": "02:27:39", "text": "所以，我們要去斯特拉那裡，對吧？"}, {"type": "subtitle", "time": 8862.95, "timestamp": "02:27:42", "text": "斯特拉還是該死。是的，斯特拉。"}, {"type": "subtitle", "time": 8864.87, "timestamp": "02:27:44", "text": "我們來做斯特拉吧。  是的"}, {"type": "subtitle", "time": 8867.99, "timestamp": "02:27:47", "text": "。我們走吧。給我"}]
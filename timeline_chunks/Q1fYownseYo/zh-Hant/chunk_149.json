[{"type": "subtitle", "time": 8940.63, "timestamp": "02:29:00", "text": "我沒有金屬煙彈。我的天哪，我"}, {"type": "subtitle", "time": 8951.19, "timestamp": "02:29:11", "text": "更多繃帶。你只要告訴我你"}, {"type": "subtitle", "time": 8952.79, "timestamp": "02:29:12", "text": "想要什麼就好了。"}, {"type": "subtitle", "time": 8956.389, "timestamp": "02:29:16", "text": "哦，我也沒錢。連"}, {"type": "subtitle", "time": 8969.349, "timestamp": "02:29:29", "text": "走吧。"}, {"type": "subtitle", "time": 8973.75, "timestamp": "02:29:33", "text": "哦，利維坦說不。好的。  是的"}, {"type": "subtitle", "time": 8975.59, "timestamp": "02:29:35", "text": "。"}, {"type": "subtitle", "time": 8977.51, "timestamp": "02:29:37", "text": "忘了瞄準"}, {"type": "subtitle", "time": 8979.99, "timestamp": "02:29:39", "text": "鏡了。"}, {"type": "subtitle", "time": 8993.51, "timestamp": "02:29:53", "text": "我只希望我從未嘗試過斯特拉·蒙特斯的雙人套裝"}, {"type": "subtitle", "time": 8997.429, "timestamp": "02:29:57", "text": "。我們一起嘗試過嗎？我"}]
[{"type": "subtitle", "time": 8402.07, "timestamp": "02:20:02", "text": "[笑聲]"}, {"type": "subtitle", "time": 8404.23, "timestamp": "02:20:04", "text": "等等，不。等等，別，別。"}, {"type": "subtitle", "time": 8406.07, "timestamp": "02:20:06", "text": "當你射擊它"}, {"type": "subtitle", "time": 8406.55, "timestamp": "02:20:06", "text": "或當是的時候，它會跳起來"}, {"type": "subtitle", "time": 8407.99, "timestamp": "02:20:07", "text": "。我想放手一搏。  是的"}, {"type": "subtitle", "time": 8410.87, "timestamp": "02:20:10", "text": "。電視節目真的想做出犧牲。  只剩"}, {"type": "subtitle", "time": 8412.07, "timestamp": "02:20:12", "text": "五分鐘了。"}, {"type": "subtitle", "time": 8414.872, "timestamp": "02:20:14", "text": "你害怕什麼？嗯？你害怕嗎？"}, {"type": "subtitle", "time": 8426.07, "timestamp": "02:20:26", "text": "我的天啊。然後讓運動迷們看到"}, {"type": "subtitle", "time": 8432.55, "timestamp": "02:20:32", "text": "你，然後讓它召喚呃……黃蜂。  劇透警告！"}, {"type": "subtitle", "time": 8438.309, "timestamp": "02:20:38", "text": "它會讓你嚐到苦頭。  是的。"}, {"type": "subtitle", "time": 8444.95, "timestamp": "02:20:44", "text": "不劇透。告密者。我覺得自己像個"}, {"type": "subtitle", "time": 8448.469, "timestamp": "02:20:48", "text": "告密者，對吧？  對"}, {"type": "subtitle", "time": 8451.27, "timestamp": "02:20:51", "text": "，告密者。  就"}, {"type": "subtitle", "time": 8451.75, "timestamp": "02:20:51", "text": "這些嗎？"}, {"type": "subtitle", "time": 8459.91, "timestamp": "02:20:59", "text": "回家吧。"}]
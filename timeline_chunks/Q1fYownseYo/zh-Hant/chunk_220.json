[{"type": "subtitle", "time": 13217.51, "timestamp": "03:40:17", "text": "。什麼鬼？我怎麼沒打中？哦，你在摧毀火箭。"}, {"type": "subtitle", "time": 13226.55, "timestamp": "03:40:26", "text": "好吧，好吧，好吧，好吧。那"}, {"type": "subtitle", "time": 13230.63, "timestamp": "03:40:30", "text": "我……是的，我也需要火箭人"}, {"type": "subtitle", "time": 13242.55, "timestamp": "03:40:42", "text": "來對付這玩意兒。哦，又沒打中。那是什麼？該死的蜱蟲？該死的蜱蟲。我向上帝發誓，我"}, {"type": "subtitle", "time": 13259.99, "timestamp": "03:40:59", "text": "這該死的……它在哪裡？那該死的蜱蟲在哪裡？謝謝。小心。"}]
[{"type": "subtitle", "time": 2707.03, "timestamp": "00:45:07", "text": "，別開槍。"}, {"type": "subtitle", "time": 2709.67, "timestamp": "00:45:09", "text": "所有突襲者，螢幕上都有弧光。"}, {"type": "subtitle", "time": 2711.99, "timestamp": "00:45:11", "text": "還剩5分鐘。想辦法回家。我"}, {"type": "subtitle", "time": 2713.349, "timestamp": "00:45:13", "text": "再說一遍，5分鐘。  是的，我正在想辦法回家。"}, {"type": "subtitle", "time": 2751.03, "timestamp": "00:45:51", "text": "遊戲徹底崩潰了，兄弟。"}, {"type": "subtitle", "time": 2758.63, "timestamp": "00:45:58", "text": "不要開槍。  我的天哪，"}]
[{"type": "subtitle", "time": 15666.95, "timestamp": "04:21:06", "text": "。我的"}, {"type": "subtitle", "time": 15669.03, "timestamp": "04:21:09", "text": "天啊，兄弟。別告訴我。我心想，我們得處理掉那隻老鼠。不許有老鼠。我抓到他了。我抓到他了。我抓到他了。"}, {"type": "subtitle", "time": 15677.595, "timestamp": "04:21:17", "text": "你想搜刮戰利品嗎？想搜刮他們的戰利品嗎？"}, {"type": "subtitle", "time": 15681.189, "timestamp": "04:21:21", "text": "你把所有人都殺了嗎"}, {"type": "subtitle", "time": 15682.87, "timestamp": "04:21:22", "text": "？去一個。解釋一下。那就解釋一下。"}, {"type": "subtitle", "time": 15684.71, "timestamp": "04:21:24", "text": "來吧。他們"}, {"type": "subtitle", "time": 15688.71, "timestamp": "04:21:28", "text": "怎麼威脅的？我沒聽到槍聲。我沒聽到槍聲。他們"}, {"type": "subtitle", "time": 15689.349, "timestamp": "04:21:29", "text": "不知道。"}]
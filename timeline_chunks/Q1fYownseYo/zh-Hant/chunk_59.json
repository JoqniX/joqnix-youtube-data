[{"type": "subtitle", "time": 3543.51, "timestamp": "00:59:03", "text": "不，我現在沒有太多氯胺酮了。  我會想辦法的"}, {"type": "subtitle", "time": 3546.069, "timestamp": "00:59:06", "text": "。"}, {"type": "subtitle", "time": 3549.27, "timestamp": "00:59:09", "text": "所以，中型和重型彈藥。  重的"}, {"type": "subtitle", "time": 3552.789, "timestamp": "00:59:12", "text": "。一疊。中等的。"}, {"type": "subtitle", "time": 3571.99, "timestamp": "00:59:31", "text": "哦，別撒謊。你就是來看"}, {"type": "subtitle", "time": 3573.43, "timestamp": "00:59:33", "text": "我的，對吧？  呃，我要五個。"}, {"type": "subtitle", "time": 3578.309, "timestamp": "00:59:38", "text": "非常感謝"}, {"type": "subtitle", "time": 3580.069, "timestamp": "00:59:40", "text": "。"}, {"type": "subtitle", "time": 3582.069, "timestamp": "00:59:42", "text": "盡量不要那樣做。像這樣。  好的。因為我們沒錢了。我們需要賺錢。  呃，給"}]
[{"type": "subtitle", "time": 8043.83, "timestamp": "02:14:03", "text": "我演示的那樣，我無法移動我的棋子。  是的，"}, {"type": "subtitle", "time": 8047.35, "timestamp": "02:14:07", "text": "找個更好的地方待在外面。讓它"}, {"type": "subtitle", "time": 8065.189, "timestamp": "02:14:25", "text": "來抱抱小狗。  快點。快點。  好吧，就開一槍。別這樣，就"}, {"type": "subtitle", "time": 8073.51, "timestamp": "02:14:33", "text": "讓它盯上你，然後躲起來。"}, {"type": "subtitle", "time": 8096.95, "timestamp": "02:14:56", "text": "機會。哦。哦，拜託。快點。快點。快點。快點。它在哪裡？  哦，"}]
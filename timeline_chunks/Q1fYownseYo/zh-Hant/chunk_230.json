[{"type": "subtitle", "time": 13806.95, "timestamp": "03:50:06", "text": "你什麼都沒有。"}, {"type": "subtitle", "time": 13811.03, "timestamp": "03:50:11", "text": "我有。走後門。哦，它死了。有人死了。它"}, {"type": "subtitle", "time": 13817.59, "timestamp": "03:50:17", "text": "沒死。等等，我沒死。等等，別死。有人死了。什麼？你。我的天哪。"}, {"type": "subtitle", "time": 13848.469, "timestamp": "03:50:48", "text": "你想搜刮？等等，他正在搜刮你什麼的。什麼？不，不，不。我說你想等搜刮"}]
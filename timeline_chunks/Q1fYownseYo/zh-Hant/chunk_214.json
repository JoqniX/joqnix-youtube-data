[{"type": "subtitle", "time": 12847.83, "timestamp": "03:34:07", "text": "哦"}, {"type": "subtitle", "time": 12851.51, "timestamp": "03:34:11", "text": "，那隻大蜘蛛。讓我先找個地方。好地方在下面，對吧"}, {"type": "subtitle", "time": 12855.59, "timestamp": "03:34:15", "text": "？對。對。該死。等等"}, {"type": "subtitle", "time": 12858.15, "timestamp": "03:34:18", "text": "。你有"}, {"type": "subtitle", "time": 12860.63, "timestamp": "03:34:20", "text": "截止日期嗎"}]
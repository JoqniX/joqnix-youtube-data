[{"type": "subtitle", "time": 8763.83, "timestamp": "02:26:03", "text": "えっと、銃の"}, {"type": "subtitle", "time": 8786.23, "timestamp": "02:26:26", "text": "レベル 4 にアップグレードされました。 私が死ぬことを想像してください"}, {"type": "subtitle", "time": 8794.469, "timestamp": "02:26:34", "text": "はい。 えっと、どんな議論をしているんですか？"}, {"type": "subtitle", "time": 8797.11, "timestamp": "02:26:37", "text": "私は"}, {"type": "subtitle", "time": 8799.59, "timestamp": "02:26:39", "text": "サバイバーを服用しています。"}, {"type": "subtitle", "time": 8807.75, "timestamp": "02:26:47", "text": "あのね？ 戦闘を確認しています。"}, {"type": "subtitle", "time": 8815.19, "timestamp": "02:26:55", "text": "私は戦闘1を選びます。"}]
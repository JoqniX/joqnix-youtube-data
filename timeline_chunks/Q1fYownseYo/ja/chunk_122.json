[{"type": "subtitle", "time": 7322.709, "timestamp": "02:02:02", "text": "ちなみに、私は何の防御もしませんでした。   死なないで。 わかった"}, {"type": "subtitle", "time": 7324.709, "timestamp": "02:02:04", "text": "。   何てことだ"}, {"type": "subtitle", "time": 7326.629, "timestamp": "02:02:06", "text": "。 持続する。"}, {"type": "subtitle", "time": 7327.83, "timestamp": "02:02:07", "text": "はい、一つ壊してしまいました。"}, {"type": "subtitle", "time": 7330.31, "timestamp": "02:02:10", "text": "イエス・キリスト。"}, {"type": "subtitle", "time": 7333.189, "timestamp": "02:02:13", "text": "角の翼の片方を損傷してしまいました。"}, {"type": "subtitle", "time": 7335.189, "timestamp": "02:02:15", "text": "ああ、翼。"}, {"type": "subtitle", "time": 7337.75, "timestamp": "02:02:17", "text": "うん。 よかった、よかった、よかった。"}, {"type": "subtitle", "time": 7340.07, "timestamp": "02:02:20", "text": "スコアを共有できるか知っていますか？"}, {"type": "subtitle", "time": 7341.03, "timestamp": "02:02:21", "text": "うん。 うん。"}, {"type": "subtitle", "time": 7343.35, "timestamp": "02:02:23", "text": "D. はい、"}, {"type": "subtitle", "time": 7345.51, "timestamp": "02:02:25", "text": "それはよかったです。 わかりました。"}, {"type": "subtitle", "time": 7359.43, "timestamp": "02:02:39", "text": "翼のところで。 翼のところで。 右。 翼を撃ちます"}, {"type": "subtitle", "time": 7361.589, "timestamp": "02:02:41", "text": "。   わかった"}, {"type": "subtitle", "time": 7367.99, "timestamp": "02:02:47", "text": "立つ。 立つ。 立つ。 立つ。 立つ。"}, {"type": "subtitle", "time": 7370.229, "timestamp": "02:02:50", "text": "立つ。 停止。 ああ、死んでる。"}, {"type": "subtitle", "time": 7370.709, "timestamp": "02:02:50", "text": "どこ？"}, {"type": "subtitle", "time": 7371.83, "timestamp": "02:02:51", "text": "えーっと。"}, {"type": "subtitle", "time": 7372.87, "timestamp": "02:02:52", "text": "何？"}, {"type": "subtitle", "time": 7377.43, "timestamp": "02:02:57", "text": "1つ必要です。   もう"}, {"type": "subtitle", "time": 7379.305, "timestamp": "02:02:59", "text": "ひとつ。 ああ、いい加減にしてくれ。"}]
[{"type": "subtitle", "time": 14105.91, "timestamp": "03:55:05", "text": "行くか？[笑い]"}, {"type": "subtitle", "time": 14107.59, "timestamp": "03:55:07", "text": "たぶんサーバーを切り替える。俺の"}, {"type": "subtitle", "time": 14109.67, "timestamp": "03:55:09", "text": "サーバーに入るべきだ。"}, {"type": "subtitle", "time": 14120.55, "timestamp": "03:55:20", "text": "待って。"}, {"type": "subtitle", "time": 14129.51, "timestamp": "03:55:29", "text": "それとも招待してもいいか？"}, {"type": "subtitle", "time": 14131.99, "timestamp": "03:55:31", "text": "ロビーから出て行って、俺がもう一度招待してもいい。"}, {"type": "subtitle", "time": 14134.309, "timestamp": "03:55:34", "text": "オーケー。"}, {"type": "subtitle", "time": 14137.11, "timestamp": "03:55:37", "text": "この後、俺は片付けて"}, {"type": "subtitle", "time": 14141.189, "timestamp": "03:55:41", "text": "寝る。1時半だ。ああ。"}, {"type": "subtitle", "time": 14143.189, "timestamp": "03:55:43", "text": "クソッ。"}, {"type": "subtitle", "time": 14145.03, "timestamp": "03:55:45", "text": "最後の試合。オーケー。最後の試合。そうだ"}]
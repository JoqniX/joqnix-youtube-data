[{"type": "subtitle", "time": 4445.99, "timestamp": "01:14:05", "text": "私はそこにいた。 誰かが文字通り私を撃った。"}, {"type": "subtitle", "time": 4448.95, "timestamp": "01:14:08", "text": "それは弧ではありません。 それは実際のプレイヤーです。"}, {"type": "subtitle", "time": 4460.87, "timestamp": "01:14:20", "text": "何？ プレイヤーが私を撃った。"}, {"type": "subtitle", "time": 4465.35, "timestamp": "01:14:25", "text": "みなさん、この人は誰ですか？"}, {"type": "subtitle", "time": 4469.669, "timestamp": "01:14:29", "text": "なんでビープ音鳴ってるの？"}, {"type": "subtitle", "time": 4474.229, "timestamp": "01:14:34", "text": "私はcom"}, {"type": "subtitle", "time": 4495.669, "timestamp": "01:14:55", "text": "簡単に取り出すことができました。"}]
[{"type": "subtitle", "time": 15186.469, "timestamp": "04:13:06", "text": "、援軍を呼んだか？"}, {"type": "subtitle", "time": 15187.99, "timestamp": "04:13:07", "text": "いいえ。いいえ、呼んでないと"}, {"type": "subtitle", "time": 15195.75, "timestamp": "04:13:15", "text": "うん。ここから撃ってみよう。なんてこった。ウー"}, {"type": "subtitle", "time": 15202.71, "timestamp": "04:13:22", "text": "。気をつけろ。俺は"}, {"type": "subtitle", "time": 15209.91, "timestamp": "04:13:29", "text": "火を吐いている。"}, {"type": "subtitle", "time": 15234.79, "timestamp": "04:13:54", "text": "、シールドが壊れた。"}]
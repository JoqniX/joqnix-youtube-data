[{"type": "subtitle", "time": 13802.308, "timestamp": "03:50:02", "text": "蘇生を使ってるんだ。"}, {"type": "subtitle", "time": 13806.95, "timestamp": "03:50:06", "text": "まあ、チームメイトを蘇生させるのに敗北は必要ないだろう"}, {"type": "subtitle", "time": 13809.03, "timestamp": "03:50:09", "text": "。"}, {"type": "subtitle", "time": 13811.03, "timestamp": "03:50:11", "text": "誰かがうっかり"}, {"type": "subtitle", "time": 13817.59, "timestamp": "03:50:17", "text": "他のプレイヤーを撃ってしまったような気がする。ありがたいことに"}, {"type": "subtitle", "time": 13845.429, "timestamp": "03:50:45", "text": "誰も撃ってない。ちくしょう、こっちへ来い"}, {"type": "subtitle", "time": 13848.469, "timestamp": "03:50:48", "text": "。こっちへ行け"}, {"type": "subtitle", "time": 13856.15, "timestamp": "03:50:56", "text": "よし、みんな。ハッチの鍵の近くにいる。"}, {"type": "subtitle", "time": 13858.309, "timestamp": "03:50:58", "text": "頼む。今まさにそこにいる。"}, {"type": "subtitle", "time": 13859.269, "timestamp": "03:50:59", "text": "ああ、行け。"}]
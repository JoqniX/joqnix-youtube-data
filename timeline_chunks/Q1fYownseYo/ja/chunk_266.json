[{"type": "subtitle", "time": 15976.87, "timestamp": "04:26:16", "text": "。"}, {"type": "subtitle", "time": 15988.469, "timestamp": "04:26:28", "text": "こんにちは。"}, {"type": "subtitle", "time": 15991.91, "timestamp": "04:26:31", "text": "ああ、午前2時だよ。あー、もう"}, {"type": "subtitle", "time": 15996.309, "timestamp": "04:26:36", "text": "しばらく遊んでたよね？"}, {"type": "subtitle", "time": 15998.55, "timestamp": "04:26:38", "text": "私たちはしばらく遊んでいました。"}, {"type": "subtitle", "time": 16001.11, "timestamp": "04:26:41", "text": "ベーコン、運んでくれてありがとう。 そして"}, {"type": "subtitle", "time": 16003.75, "timestamp": "04:26:43", "text": "ついにリアクターターコイズを手に入れました。 ニース。"}, {"type": "subtitle", "time": 16005.59, "timestamp": "04:26:45", "text": "私は幸せです。   わーい"}, {"type": "subtitle", "time": 16010.71, "timestamp": "04:26:50", "text": "今、遅れているかどうかはわかりませんが、"}, {"type": "subtitle", "time": 16012.95, "timestamp": "04:26:52", "text": "私の配信では、"}]
[{"type": "subtitle", "time": 10921.429, "timestamp": "03:02:01", "text": "。   ねえ"}, {"type": "subtitle", "time": 10928.63, "timestamp": "03:02:08", "text": "。"}, {"type": "subtitle", "time": 10930.309, "timestamp": "03:02:10", "text": "えっと、私たちはただ一箇所に立って"}, {"type": "subtitle", "time": 10936.95, "timestamp": "03:02:16", "text": "スズメバチを撃とうとするだけです。 それはずっと簡単です。"}, {"type": "subtitle", "time": 10944.87, "timestamp": "03:02:24", "text": "地雷もいくつか持ってこようかな。"}, {"type": "subtitle", "time": 10948.309, "timestamp": "03:02:28", "text": "はい、そうしましょう。 えっと、"}, {"type": "subtitle", "time": 10952.309, "timestamp": "03:02:32", "text": "リサイクル。 いや、売っちゃいましょう。"}, {"type": "subtitle", "time": 10957.91, "timestamp": "03:02:37", "text": "お金があればクラフトする必要がなくなる。"}, {"type": "subtitle", "time": 10960.95, "timestamp": "03:02:40", "text": "盾はどこ？"}]
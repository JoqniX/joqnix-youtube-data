[{"type": "subtitle", "time": 7800.31, "timestamp": "02:10:00", "text": "誰かが亡くなりました。"}, {"type": "subtitle", "time": 7801.589, "timestamp": "02:10:01", "text": "誰かが死んだ。 うん。"}, {"type": "subtitle", "time": 7811.51, "timestamp": "02:10:11", "text": "？ 何てことだ。 あそこだよ。"}, {"type": "subtitle", "time": 7815.51, "timestamp": "02:10:15", "text": "ドローンが1、2、3、4、6機。 何てことだ。"}, {"type": "subtitle", "time": 7817.75, "timestamp": "02:10:17", "text": "リセットした方がいいと思います。   ちょっと"}, {"type": "subtitle", "time": 7819.91, "timestamp": "02:10:19", "text": "待って、それは何ですか？"}, {"type": "subtitle", "time": 7820.709, "timestamp": "02:10:20", "text": "スズメバチ。"}, {"type": "subtitle", "time": 7826.39, "timestamp": "02:10:26", "text": "。 プレイヤーを撃たないでください。 きっと、"}, {"type": "subtitle", "time": 7854.87, "timestamp": "02:10:54", "text": "いくらですか？ さて、"}, {"type": "subtitle", "time": 7859.75, "timestamp": "02:10:59", "text": "別のスポーンでは星の半分が残っています。"}]
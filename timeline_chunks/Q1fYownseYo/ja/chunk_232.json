[{"type": "subtitle", "time": 13922.87, "timestamp": "03:52:02", "text": "。はい、はい、はい、はい、はい、はい、はい、はい、はい、はい"}, {"type": "subtitle", "time": 13924.63, "timestamp": "03:52:04", "text": "、はい。よし、"}, {"type": "subtitle", "time": 13928.71, "timestamp": "03:52:08", "text": "大きなコアが1つ手に入った。これで終わりだ"}, {"type": "subtitle", "time": 13932.309, "timestamp": "03:52:12", "text": "、ジャック。逃げろ。"}, {"type": "subtitle", "time": 13933.269, "timestamp": "03:52:13", "text": "誰かがこれを略奪している。"}, {"type": "subtitle", "time": 13938.87, "timestamp": "03:52:18", "text": "コアは常に探せ。"}, {"type": "subtitle", "time": 13951.429, "timestamp": "03:52:31", "text": "ああ、何も手に入らない。ああ、"}, {"type": "subtitle", "time": 13963.75, "timestamp": "03:52:43", "text": "前に出発した方がいいかな あいつらは、あの"}, {"type": "subtitle", "time": 13965.03, "timestamp": "03:52:45", "text": "、"}, {"type": "subtitle", "time": 13966.95, "timestamp": "03:52:46", "text": "画面上の襲撃者をやろうとしてるんだぜ？"}, {"type": "subtitle", "time": 13968.55, "timestamp": "03:52:48", "text": "早く来い。"}]
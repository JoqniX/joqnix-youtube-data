[{"type": "subtitle", "time": 9060.15, "timestamp": "02:31:00", "text": "物が完全に逆さまになっています。"}, {"type": "subtitle", "time": 9062.63, "timestamp": "02:31:02", "text": "ああ、飛ぶぞ。"}, {"type": "subtitle", "time": 9080.63, "timestamp": "02:31:20", "text": "女王と女家長は"}, {"type": "subtitle", "time": 9082.63, "timestamp": "02:31:22", "text": "違うのですか？"}, {"type": "subtitle", "time": 9083.19, "timestamp": "02:31:23", "text": "どのように同じですか?"}, {"type": "subtitle", "time": 9084.71, "timestamp": "02:31:24", "text": "彼らです。"}, {"type": "subtitle", "time": 9087.59, "timestamp": "02:31:27", "text": "それらは違います。 マトリアークはより大きく、"}, {"type": "subtitle", "time": 9090.07, "timestamp": "02:31:30", "text": "移動が少なく、攻撃力も低いです。 そしてそれは"}, {"type": "subtitle", "time": 9093.19, "timestamp": "02:31:33", "text": "主に"}, {"type": "subtitle", "time": 9096.389, "timestamp": "02:31:36", "text": "バスティオンやボンバディアのような他のやつらのように召喚します。"}, {"type": "subtitle", "time": 9101.03, "timestamp": "02:31:41", "text": "女王は"}, {"type": "subtitle", "time": 9103.67, "timestamp": "02:31:43", "text": "レーザービームスタン"}, {"type": "subtitle", "time": 9104.63, "timestamp": "02:31:44", "text": "シールドのようなたくさんのものを持っています。"}, {"type": "subtitle", "time": 9105.99, "timestamp": "02:31:45", "text": "ああ、それは"}, {"type": "subtitle", "time": 9108.95, "timestamp": "02:31:48", "text": "マシンガンです。"}, {"type": "subtitle", "time": 9111.59, "timestamp": "02:31:51", "text": "このシュレッダーを殺したいですか?"}, {"type": "subtitle", "time": 9114.07, "timestamp": "02:31:54", "text": "できます。 殺すのはそんなに難しいことではない。   ああ"}, {"type": "subtitle", "time": 9117.59, "timestamp": "02:31:57", "text": "、私はただそれをやるだけです。"}]
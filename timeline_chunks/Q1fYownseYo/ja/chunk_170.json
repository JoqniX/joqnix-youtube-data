[{"type": "subtitle", "time": 10217.51, "timestamp": "02:50:17", "text": "一つあります。 ああ、シュレッダー。"}, {"type": "subtitle", "time": 10220.469, "timestamp": "02:50:20", "text": "うん。"}, {"type": "subtitle", "time": 10222.23, "timestamp": "02:50:22", "text": "よし、何かを応援しよう。"}, {"type": "subtitle", "time": 10225.83, "timestamp": "02:50:25", "text": "おい、それはフレンドリーファイアだよ。"}, {"type": "subtitle", "time": 10233.349, "timestamp": "02:50:33", "text": "待ってください、見せてくれましたか"}, {"type": "subtitle", "time": 10235.269, "timestamp": "02:50:35", "text": "？"}, {"type": "subtitle", "time": 10236.71, "timestamp": "02:50:36", "text": "はい、そうしました。   わかった"}, {"type": "subtitle", "time": 10237.269, "timestamp": "02:50:37", "text": "。 わかった。"}, {"type": "subtitle", "time": 10239.99, "timestamp": "02:50:39", "text": "ああ、くそ。 見る？ このクソネズミが見える？ ここに来て"}, {"type": "subtitle", "time": 10241.75, "timestamp": "02:50:41", "text": "。 ここに来て。 ここに来て。 ここに来て。"}, {"type": "subtitle", "time": 10242.55, "timestamp": "02:50:42", "text": "待って。 何？"}, {"type": "subtitle", "time": 10245.67, "timestamp": "02:50:45", "text": "このクソネズミが見えますか? 見る？"}, {"type": "subtitle", "time": 10247.19, "timestamp": "02:50:47", "text": "なんというクソネズミだ。   何てことだ"}, {"type": "subtitle", "time": 10247.91, "timestamp": "02:50:47", "text": "。"}, {"type": "subtitle", "time": 10255.67, "timestamp": "02:50:55", "text": "撃たないでください。"}, {"type": "subtitle", "time": 10258.63, "timestamp": "02:50:58", "text": "私はアークを取ります。 つまり、他の人も"}]
[{"type": "subtitle", "time": 13681.349, "timestamp": "03:48:01", "text": "死ぬ。"}, {"type": "subtitle", "time": 13690.229, "timestamp": "03:48:10", "text": "。ゆっくり行け。迂回できる。"}, {"type": "subtitle", "time": 13696.87, "timestamp": "03:48:16", "text": "遠回りもできる。"}, {"type": "subtitle", "time": 13699.03, "timestamp": "03:48:19", "text": "なぜ？くそっ"}, {"type": "subtitle", "time": 13701.03, "timestamp": "03:48:21", "text": "。やめて。死んでるのか"}, {"type": "subtitle", "time": 13704.55, "timestamp": "03:48:24", "text": "？"}, {"type": "subtitle", "time": 13705.269, "timestamp": "03:48:25", "text": "俺が死んだ。"}, {"type": "subtitle", "time": 13708.07, "timestamp": "03:48:28", "text": "ああ、"}, {"type": "subtitle", "time": 13709.59, "timestamp": "03:48:29", "text": "近くの誰も倒せないだろう"}, {"type": "subtitle", "time": 13718.79, "timestamp": "03:48:38", "text": "中型シールドが必要なんだとは思えない。こいつらに"}, {"type": "subtitle", "time": 13727.83, "timestamp": "03:48:47", "text": "本当にちくしょう。ああ、そうだ。なんてこった。"}]
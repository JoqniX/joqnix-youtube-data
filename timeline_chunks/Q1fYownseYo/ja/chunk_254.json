[{"type": "subtitle", "time": 15246.95, "timestamp": "04:14:06", "text": "お前はまだ死んでない。あらまあ。これは"}, {"type": "subtitle", "time": 15249.269, "timestamp": "04:14:09", "text": "シールドリチャージャー"}, {"type": "subtitle", "time": 15276.79, "timestamp": "04:14:36", "text": "目のラグを作らないといけない。"}, {"type": "subtitle", "time": 15279.51, "timestamp": "04:14:39", "text": "よし、ゆっくりやってくれ。ゆっくりやってくれ。"}, {"type": "subtitle", "time": 15281.189, "timestamp": "04:14:41", "text": "配信のラグと"}, {"type": "subtitle", "time": 15282.07, "timestamp": "04:14:42", "text": "ゲームのラグ、どっちがいい？"}, {"type": "subtitle", "time": 15285.189, "timestamp": "04:14:45", "text": "俺のゲームはすごくラグってる。10FPSだ"}]
[{"type": "subtitle", "time": 12484.469, "timestamp": "03:28:04", "text": "ベーコン、今何時？"}, {"type": "subtitle", "time": 12485.59, "timestamp": "03:28:05", "text": "えーと、"}, {"type": "subtitle", "time": 12488.15, "timestamp": "03:28:08", "text": "2時半。午後2時半。"}, {"type": "subtitle", "time": 12491.19, "timestamp": "03:28:11", "text": "あ、ランチは食べた？"}, {"type": "subtitle", "time": 12492.63, "timestamp": "03:28:12", "text": "うん。ブランチ。"}, {"type": "subtitle", "time": 12500.87, "timestamp": "03:28:20", "text": "ああ、もうロードが速いね。私は…"}, {"type": "subtitle", "time": 12503.51, "timestamp": "03:28:23", "text": "待って、何？遅かった。FBSを"}, {"type": "subtitle", "time": 12507.51, "timestamp": "03:28:27", "text": "10回飲んでいる。不思議じゃない。[笑い]"}, {"type": "subtitle", "time": 12510.55, "timestamp": "03:28:30", "text": "OK、FPSだ。OK、近い。もしもし。もしもし。"}, {"type": "subtitle", "time": 12512.87, "timestamp": "03:28:32", "text": "マトリアークはどこ？"}, {"type": "subtitle", "time": 12523.51, "timestamp": "03:28:43", "text": "えーと、始めてくれてもいいよ。"}, {"type": "subtitle", "time": 12525.269, "timestamp": "03:28:45", "text": "まずは発射タワーに行こう。そこで戦利品を。"}, {"type": "subtitle", "time": 12526.95, "timestamp": "03:28:46", "text": "上にはいいものがたくさんあるよ"}, {"type": "subtitle", "time": 12528.07, "timestamp": "03:28:48", "text": "。"}, {"type": "subtitle", "time": 12530.55, "timestamp": "03:28:50", "text": "ああ。"}, {"type": "subtitle", "time": 12530.79, "timestamp": "03:28:50", "text": "クソ。PvP用の"}, {"type": "subtitle", "time": 12533.83, "timestamp": "03:28:53", "text": "銃を持ってない。本当に"}, {"type": "subtitle", "time": 12535.269, "timestamp": "03:28:55", "text": "役に立たない。"}, {"type": "subtitle", "time": 12536.71, "timestamp": "03:28:56", "text": "オスプレイと"}]
[{"type": "subtitle", "time": 10830.55, "timestamp": "03:00:30", "text": "締め切りがあります。 わかった。 これを"}, {"type": "subtitle", "time": 10832.389, "timestamp": "03:00:32", "text": "私の仲間の一人のために取っておきます。 それは必要になるでしょう"}, {"type": "subtitle", "time": 10838.71, "timestamp": "03:00:38", "text": "。 これをリサイクルしてください。"}, {"type": "subtitle", "time": 10841.99, "timestamp": "03:00:41", "text": "これを保管してください。 これをリサイクルしてください。"}, {"type": "subtitle", "time": 10846.15, "timestamp": "03:00:46", "text": "ああ、弾薬。 弾薬。 ああ、あの、あの重い"}, {"type": "subtitle", "time": 10849.349, "timestamp": "03:00:49", "text": "盾。 ああ、そうね。"}, {"type": "subtitle", "time": 10852.07, "timestamp": "03:00:52", "text": "あぁ、お腹いっぱい。 聖なる。   満腹になるわけがない"}, {"type": "subtitle", "time": 10854.23, "timestamp": "03:00:54", "text": "。   すでに"}, {"type": "subtitle", "time": 10856.71, "timestamp": "03:00:56", "text": "多くの人が 3x にいます。"}, {"type": "subtitle", "time": 10859.59, "timestamp": "03:00:59", "text": "彼らはポップ音を鳴らしていると思いますよね"}]
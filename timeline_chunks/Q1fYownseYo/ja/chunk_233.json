[{"type": "subtitle", "time": 13986.389, "timestamp": "03:53:06", "text": "、あそこに走ってる。あいつら、なんて"}, {"type": "subtitle", "time": 13986.95, "timestamp": "03:53:06", "text": "嫌な奴なんだ"}, {"type": "subtitle", "time": 14005.91, "timestamp": "03:53:25", "text": "。なんてこった。俺は今まで誰も信用してなかったのに。なんてこった、この馬鹿野郎は。死んでるのか？死んでる。死んだと思ってる。死んでる。わかった、俺が先に行く。わかった。ああ、待って。待って、待って、待って。俺を待たないで。お前には無理だと"}, {"type": "subtitle", "time": 14010.389, "timestamp": "03:53:30", "text": "思う。あいつは"}, {"type": "subtitle", "time": 14013.349, "timestamp": "03:53:33", "text": "まだPvPしてる。なんて嫌な奴なんだ"}, {"type": "subtitle", "time": 14022.229, "timestamp": "03:53:42", "text": "金庫に入れるのを忘れた。ちくしょう。違うよ。お前も呼んだろ。黙れ"}, {"type": "subtitle", "time": 14031.189, "timestamp": "03:53:51", "text": "。"}, {"type": "subtitle", "time": 14033.83, "timestamp": "03:53:53", "text": "お前も呼んだんだ。"}, {"type": "subtitle", "time": 14035.83, "timestamp": "03:53:55", "text": "待って、俺のはどうなってるんだ。ああ、お前の"}, {"type": "subtitle", "time": 14039.429, "timestamp": "03:53:59", "text": "画面が見えてる。わかった。もうアウト。アウト。俺も呼んだ"}]
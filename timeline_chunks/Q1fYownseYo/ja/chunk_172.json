[{"type": "subtitle", "time": 10322.15, "timestamp": "02:52:02", "text": "ああ、ここが私たちの鍵の部屋ですよね？"}, {"type": "subtitle", "time": 10324.87, "timestamp": "02:52:04", "text": "うん。"}, {"type": "subtitle", "time": 10334.469, "timestamp": "02:52:14", "text": "あるいは、もう少し長く滞在して、もっと何かを手に入れることもできます"}, {"type": "subtitle", "time": 10337.11, "timestamp": "02:52:17", "text": "。 僕たちは今、気が狂いそうだ。"}, {"type": "subtitle", "time": 10338.79, "timestamp": "02:52:18", "text": "前回何が起こったか覚えていますか?"}, {"type": "subtitle", "time": 10340.55, "timestamp": "02:52:20", "text": "はぁ？"}, {"type": "subtitle", "time": 10342.87, "timestamp": "02:52:22", "text": "うん。 どうですか？"}, {"type": "subtitle", "time": 10355.99, "timestamp": "02:52:35", "text": "彼らは外でPvPをしています。   ちょっと"}, {"type": "subtitle", "time": 10356.389, "timestamp": "02:52:36", "text": "待って、誰？"}, {"type": "subtitle", "time": 10358.71, "timestamp": "02:52:38", "text": "積み込み場にて。 外。"}, {"type": "subtitle", "time": 10361.99, "timestamp": "02:52:41", "text": "積み込み場にて。  PvPって聞きました。"}, {"type": "subtitle", "time": 10365.51, "timestamp": "02:52:45", "text": "待って、本当？ ああ、銃。"}, {"type": "subtitle", "time": 10368.55, "timestamp": "02:52:48", "text": "クソ第三者を彼らとしている。"}]
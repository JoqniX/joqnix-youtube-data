[{"type": "subtitle", "time": 14701.51, "timestamp": "04:05:01", "text": "文字通りその上に飛び乗って、あれは"}, {"type": "subtitle", "time": 14704.469, "timestamp": "04:05:04", "text": "何？ここにある。"}, {"type": "subtitle", "time": 14720.71, "timestamp": "04:05:20", "text": "ゲームがラグい。なんてこった"}, {"type": "subtitle", "time": 14722.229, "timestamp": "04:05:22", "text": "。待って。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 14727.75, "timestamp": "04:05:27", "text": "私のゲームのUIがバグっている。なんてこった。"}, {"type": "subtitle", "time": 14728.87, "timestamp": "04:05:28", "text": "これは何？"}, {"type": "subtitle", "time": 14731.91, "timestamp": "04:05:31", "text": "なんてこった。私のストリームを開いてみてください。これは"}, {"type": "subtitle", "time": 14734.79, "timestamp": "04:05:34", "text": "とても面白い。これはとても面白い。"}, {"type": "subtitle", "time": 14736.07, "timestamp": "04:05:36", "text": "誰か"}, {"type": "subtitle", "time": 14739.11, "timestamp": "04:05:39", "text": "私のストリームを開いて確認してください。ちょっと待って"}, {"type": "subtitle", "time": 14741.91, "timestamp": "04:05:41", "text": "。 誰かが死んだ。"}, {"type": "subtitle", "time": 14742.469, "timestamp": "04:05:42", "text": "なんでこんなんだ なんでこんなに"}, {"type": "subtitle", "time": 14745.429, "timestamp": "04:05:45", "text": "近いんだ？"}, {"type": "subtitle", "time": 14749.349, "timestamp": "04:05:49", "text": "あぁ、火事が起きてる時に。"}]
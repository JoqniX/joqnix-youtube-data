[{"type": "subtitle", "time": 7922.47, "timestamp": "02:12:02", "text": "。 同じことです。 あなたをターゲットにしましょう。 ああ。   痛い。"}, {"type": "subtitle", "time": 7926.39, "timestamp": "02:12:06", "text": "どこですか？"}, {"type": "subtitle", "time": 7930.55, "timestamp": "02:12:10", "text": "えっと、西です。"}, {"type": "subtitle", "time": 7932.31, "timestamp": "02:12:12", "text": "ああ、"}, {"type": "subtitle", "time": 7935.669, "timestamp": "02:12:15", "text": "見えますか？ 見えますか？"}, {"type": "subtitle", "time": 7936.79, "timestamp": "02:12:16", "text": "どこですか？ 何だって？"}, {"type": "subtitle", "time": 7943.99, "timestamp": "02:12:23", "text": "一体どこだ？"}, {"type": "subtitle", "time": 7947.83, "timestamp": "02:12:27", "text": "ロケット。 ああ、あそこ。"}, {"type": "subtitle", "time": 7950.95, "timestamp": "02:12:30", "text": "わかった、弾丸は18発くらいしかない。"}, {"type": "subtitle", "time": 7951.83, "timestamp": "02:12:31", "text": "早くやれよ。 そうですね、"}, {"type": "subtitle", "time": 7955.109, "timestamp": "02:12:35", "text": "この建物かもしれません。"}, {"type": "subtitle", "time": 7958.31, "timestamp": "02:12:38", "text": "よし、まずは誘い込んでみる。 ああ、"}, {"type": "subtitle", "time": 7960.709, "timestamp": "02:12:40", "text": "近かった。 えっと、待って、待って、待っ"}, {"type": "subtitle", "time": 7964.229, "timestamp": "02:12:44", "text": "て。 高いところまで行って撃ってもいいですか？"}, {"type": "subtitle", "time": 7965.99, "timestamp": "02:12:45", "text": "まずは屋根の上に登ってみます。"}, {"type": "subtitle", "time": 7967.35, "timestamp": "02:12:47", "text": "屋根に窓とかあるんですか"}, {"type": "subtitle", "time": 7968.47, "timestamp": "02:12:48", "text": "？"}, {"type": "subtitle", "time": 7970.629, "timestamp": "02:12:50", "text": "えっと、この建物です。"}]
[{"type": "subtitle", "time": 9900.15, "timestamp": "02:45:00", "text": "殺すべきでしょうか？"}, {"type": "subtitle", "time": 9902.55, "timestamp": "02:45:02", "text": "えーっと、気をつけてよジョック。"}, {"type": "subtitle", "time": 9910.469, "timestamp": "02:45:10", "text": "今は一緒じゃないよ。 私たちはアジアサーバーにいます。 それが"}, {"type": "subtitle", "time": 9912.389, "timestamp": "02:45:12", "text": "理由です。"}, {"type": "subtitle", "time": 9918.55, "timestamp": "02:45:18", "text": "どうしたの？"}, {"type": "subtitle", "time": 9920.87, "timestamp": "02:45:20", "text": "締め切りまでの青写真ができました。   ちょっと"}, {"type": "subtitle", "time": 9923.11, "timestamp": "02:45:23", "text": "待って、何？ 本当に？ はい。"}, {"type": "subtitle", "time": 9937.269, "timestamp": "02:45:37", "text": "待って、どこ？ ああ、だから払ってるんですか"}, {"type": "subtitle", "time": 9938.87, "timestamp": "02:45:38", "text": "？ わかった。"}, {"type": "subtitle", "time": 9940.79, "timestamp": "02:45:40", "text": "ねえ、アレックスも何かを見つけてロードしてください"}, {"type": "subtitle", "time": 9948.87, "timestamp": "02:45:48", "text": "防御シールドとスモークボムを持っています。"}, {"type": "subtitle", "time": 9951.99, "timestamp": "02:45:51", "text": "はい、"}]
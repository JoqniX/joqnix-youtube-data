[{"type": "subtitle", "time": 10263.429, "timestamp": "02:51:03", "text": "つまり、"}, {"type": "subtitle", "time": 10265.269, "timestamp": "02:51:05", "text": "技術的にはこれで完了です。"}, {"type": "subtitle", "time": 10270.95, "timestamp": "02:51:10", "text": "最大限に得るために継続することができます。"}, {"type": "subtitle", "time": 10272.07, "timestamp": "02:51:12", "text": "シャツが欲しいです。"}, {"type": "subtitle", "time": 10275.19, "timestamp": "02:51:15", "text": "ステラではとても簡単です。"}, {"type": "subtitle", "time": 10280.71, "timestamp": "02:51:20", "text": "ステラって閉鎖的な"}, {"type": "subtitle", "time": 10283.83, "timestamp": "02:51:23", "text": "場所ですよね？ だから"}, {"type": "subtitle", "time": 10287.429, "timestamp": "02:51:27", "text": "屋内みたいな場所なんですね。"}, {"type": "subtitle", "time": 10311.03, "timestamp": "02:51:51", "text": "撃たないでください。"}]
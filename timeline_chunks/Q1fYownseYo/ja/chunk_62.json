[{"type": "subtitle", "time": 3733.109, "timestamp": "01:02:13", "text": "ゲームをロードしている間にオレンジを食べようと思ったんです"}, {"type": "subtitle", "time": 3735.51, "timestamp": "01:02:15", "text": "。"}, {"type": "subtitle", "time": 3739.03, "timestamp": "01:02:19", "text": "夕食は食べましたが、"}, {"type": "subtitle", "time": 3757.349, "timestamp": "01:02:37", "text": "さて、私たちは何かについて生まれました。"}, {"type": "subtitle", "time": 3760.549, "timestamp": "01:02:40", "text": "レイダー、もう目が暗闇に慣れたか？"}, {"type": "subtitle", "time": 3764.71, "timestamp": "01:02:44", "text": "トレドのほとんどの人が眠っている間に、略奪品を拾うのが最適です。"}, {"type": "subtitle", "time": 3768.309, "timestamp": "01:02:48", "text": "日没後は警戒が2倍になるサプライヤーへ行きましょう。"}, {"type": "subtitle", "time": 3770.069, "timestamp": "01:02:50", "text": "ピルグリムズピークに行くこともできます。"}]
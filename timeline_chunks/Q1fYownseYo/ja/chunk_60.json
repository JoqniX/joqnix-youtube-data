[{"type": "subtitle", "time": 3607.67, "timestamp": "01:00:07", "text": "夜襲がある。"}, {"type": "subtitle", "time": 3636.549, "timestamp": "01:00:36", "text": "私の硝酸塩も良いですよ。"}, {"type": "subtitle", "time": 3638.63, "timestamp": "01:00:38", "text": "さて、もしブーイングしたらどうなるでしょうか"}, {"type": "subtitle", "time": 3642.549, "timestamp": "01:00:42", "text": "？ 私たちは文字通り村に行って"}, {"type": "subtitle", "time": 3646.39, "timestamp": "01:00:46", "text": "、すべてを調べ、"}, {"type": "subtitle", "time": 3649.27, "timestamp": "01:00:49", "text": "ハッチの鍵から出る必要があるんですよね？"}, {"type": "subtitle", "time": 3652.95, "timestamp": "01:00:52", "text": "金儲けが目的ですよね？"}, {"type": "subtitle", "time": 3655.67, "timestamp": "01:00:55", "text": "それでああ、そうなら、"}]
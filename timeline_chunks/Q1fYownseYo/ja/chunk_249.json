[{"type": "subtitle", "time": 14944.55, "timestamp": "04:09:04", "text": "エネルギー弾に気づいた。"}, {"type": "subtitle", "time": 14947.269, "timestamp": "04:09:07", "text": "なんてこった、こっちの"}, {"type": "subtitle", "time": 14950.95, "timestamp": "04:09:10", "text": "PCが死にそうだ。なんてこった。"}, {"type": "subtitle", "time": 14951.189, "timestamp": "04:09:11", "text": "よし、伏せろ"}, {"type": "subtitle", "time": 14953.59, "timestamp": "04:09:13", "text": "。伏せ。待て、まだ"}, {"type": "subtitle", "time": 14960.229, "timestamp": "04:09:20", "text": "出るぞ。"}, {"type": "subtitle", "time": 14967.51, "timestamp": "04:09:27", "text": "本当に"}, {"type": "subtitle", "time": 14977.59, "timestamp": "04:09:37", "text": "ハーベスターは怖い。"}, {"type": "subtitle", "time": 14980.309, "timestamp": "04:09:40", "text": "たくさん略奪してる人がいるのは知ってる"}, {"type": "subtitle", "time": 14982.79, "timestamp": "04:09:42", "text": "。だから超強力になるんだ"}, {"type": "subtitle", "time": 14990.87, "timestamp": "04:09:50", "text": "待って、実際誰か死んだのか？"}, {"type": "subtitle", "time": 14992.79, "timestamp": "04:09:52", "text": "安全な場所を見つけて撃ってみよう"}]
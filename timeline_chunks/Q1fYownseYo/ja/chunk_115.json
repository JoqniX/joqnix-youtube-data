[{"type": "subtitle", "time": 6903.91, "timestamp": "01:55:03", "text": "待ってください。"}, {"type": "subtitle", "time": 6904.47, "timestamp": "01:55:04", "text": "持続する。"}, {"type": "subtitle", "time": 6908.31, "timestamp": "01:55:08", "text": "どの地図がどこにあるかを表示する必要がありますか?"}, {"type": "subtitle", "time": 6912.55, "timestamp": "01:55:12", "text": "50秒くらい待てば切り替わります。"}, {"type": "subtitle", "time": 6915.51, "timestamp": "01:55:15", "text": "ブルーゲートだけにしましょう。"}, {"type": "subtitle", "time": 6916.79, "timestamp": "01:55:16", "text": "夜間襲撃のブルーゲート。"}, {"type": "subtitle", "time": 6922.0, "timestamp": "01:55:22", "text": "。 ああ、待って。 キャンセルしました。 ごめん。 ああ、乗って"}, {"type": "subtitle", "time": 6925.36, "timestamp": "01:55:25", "text": "ああ、待って。 キャンセルしました。 ごめん。 ああ、乗って 。乗って。わかった。   手に入るでしょうか"}, {"type": "subtitle", "time": 6935.35, "timestamp": "01:55:35", "text": "？"}, {"type": "subtitle", "time": 6943.189, "timestamp": "01:55:43", "text": "ブルー"}, {"type": "subtitle", "time": 6943.91, "timestamp": "01:55:43", "text": "ナイトレイドが手に入らなかったら、ちょっとスキーじゃないですか？"}, {"type": "subtitle", "time": 6946.709, "timestamp": "01:55:46", "text": "何？ どういう意味ですか?   まるで"}, {"type": "subtitle", "time": 6950.79, "timestamp": "01:55:50", "text": "数秒以内に切り替わるような感じです。"}, {"type": "subtitle", "time": 6953.99, "timestamp": "01:55:53", "text": "うん。 ああ、でもまだ分かるよ。"}]
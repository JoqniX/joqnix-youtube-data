[{"type": "subtitle", "time": 6480.31, "timestamp": "01:48:00", "text": "ああ、待って。 電話します。"}, {"type": "subtitle", "time": 6484.31, "timestamp": "01:48:04", "text": "電話します。 ちょっと待って、Discord を持っているかな?"}, {"type": "subtitle", "time": 6486.39, "timestamp": "01:48:06", "text": "はい、あります。"}, {"type": "subtitle", "time": 6513.109, "timestamp": "01:48:33", "text": "？"}, {"type": "subtitle", "time": 6515.109, "timestamp": "01:48:35", "text": "はい。"}, {"type": "subtitle", "time": 6518.31, "timestamp": "01:48:38", "text": "さあ、ブルー"}, {"type": "subtitle", "time": 6520.629, "timestamp": "01:48:40", "text": "ゲートでロケットを打ち上げましょう。 えっと、"}, {"type": "subtitle", "time": 6523.669, "timestamp": "01:48:43", "text": "あなたがやるべきことは金床を用意して、それを"}, {"type": "subtitle", "time": 6526.709, "timestamp": "01:48:46", "text": "あなたに向けることだけです。あとは私がやります。"}, {"type": "subtitle", "time": 6527.109, "timestamp": "01:48:47", "text": "金床。"}, {"type": "subtitle", "time": 6529.35, "timestamp": "01:48:49", "text": "夢中になってやってみます。"}, {"type": "subtitle", "time": 6531.03, "timestamp": "01:48:51", "text": "とにかく撃ってみてください。"}, {"type": "subtitle", "time": 6532.39, "timestamp": "01:48:52", "text": "あなたをターゲットにしましょう。"}, {"type": "subtitle", "time": 6535.43, "timestamp": "01:48:55", "text": "何の銃を使っていますか？"}]
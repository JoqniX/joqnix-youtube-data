[{"type": "subtitle", "time": 1143.35, "timestamp": "00:19:03", "text": "待ってください、誰かが本当に"}, {"type": "subtitle", "time": 1170.15, "timestamp": "00:19:30", "text": "侵入者全員注意。 西側のアンテナが"}, {"type": "subtitle", "time": 1173.75, "timestamp": "00:19:33", "text": "正常に起動されました。"}, {"type": "subtitle", "time": 1181.83, "timestamp": "00:19:41", "text": "ねえ、すること。"}, {"type": "subtitle", "time": 1183.99, "timestamp": "00:19:43", "text": "こんにちは、レイダーさん。"}, {"type": "subtitle", "time": 1186.63, "timestamp": "00:19:46", "text": "おい、撃たないで。   よし"}, {"type": "subtitle", "time": 1193.83, "timestamp": "00:19:53", "text": "ここから良いものを手に入れましょう。"}]
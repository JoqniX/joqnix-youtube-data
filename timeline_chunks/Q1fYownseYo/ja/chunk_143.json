[{"type": "subtitle", "time": 8580.07, "timestamp": "02:23:00", "text": "すでに設計図は手に入れました。 来て"}, {"type": "subtitle", "time": 8581.27, "timestamp": "02:23:01", "text": "。"}, {"type": "subtitle", "time": 8584.63, "timestamp": "02:23:04", "text": "それで、"}, {"type": "subtitle", "time": 8591.349, "timestamp": "02:23:11", "text": "Arc で新しいアカウントを作成する方法を知っていますか? 新しいゲームを購入する必要がありますか?"}, {"type": "subtitle", "time": 8592.389, "timestamp": "02:23:12", "text": "うん。"}, {"type": "subtitle", "time": 8594.55, "timestamp": "02:23:14", "text": "何？ 本当に？"}, {"type": "subtitle", "time": 8596.95, "timestamp": "02:23:16", "text": "うん。 何を転送したいですか"}, {"type": "subtitle", "time": 8598.309, "timestamp": "02:23:18", "text": "?"}, {"type": "subtitle", "time": 8599.67, "timestamp": "02:23:19", "text": "そうだ、"}, {"type": "subtitle", "time": 8607.349, "timestamp": "02:23:27", "text": "ああ、想像したらとても素敵でしょうね。 いや。"}, {"type": "subtitle", "time": 8610.15, "timestamp": "02:23:30", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 8613.59, "timestamp": "02:23:33", "text": "待ってください、あなたは生存者を望みますか？"}, {"type": "subtitle", "time": 8616.614, "timestamp": "02:23:36", "text": "いいえ、わかっています。 もう持っています。  A"}, {"type": "subtitle", "time": 8624.95, "timestamp": "02:23:44", "text": "わかりました。 ほかに何か？"}, {"type": "subtitle", "time": 8629.67, "timestamp": "02:23:49", "text": "トレーダーレイダー。 ええと、トライアル"}, {"type": "subtitle", "time": 8632.469, "timestamp": "02:23:52", "text": "ホーネットがレバーカリブーをポップします"}, {"type": "subtitle", "time": 8636.469, "timestamp": "02:23:56", "text": "。 わかった。"}]
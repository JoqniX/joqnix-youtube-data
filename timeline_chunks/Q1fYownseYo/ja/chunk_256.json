[{"type": "subtitle", "time": 15362.389, "timestamp": "04:16:02", "text": "クソネズミだ。"}, {"type": "subtitle", "time": 15365.75, "timestamp": "04:16:05", "text": "なんて惨めなんだ、お前。"}, {"type": "subtitle", "time": 15367.11, "timestamp": "04:16:07", "text": "ドラゴンが俺を蘇生させてくれる。"}, {"type": "subtitle", "time": 15370.07, "timestamp": "04:16:10", "text": "撃たないで。"}, {"type": "subtitle", "time": 15372.229, "timestamp": "04:16:12", "text": "いいぞ。奴は屋根の上にいる。奴は"}, {"type": "subtitle", "time": 15374.79, "timestamp": "04:16:14", "text": "屋根の上にいる。うわっ。蘇生させてくれ。俺は"}, {"type": "subtitle", "time": 15377.75, "timestamp": "04:16:17", "text": "お前の目の前にいる。"}, {"type": "subtitle", "time": 15381.189, "timestamp": "04:16:21", "text": "めちゃくちゃ哀れだ。なんてこった"}, {"type": "subtitle", "time": 15389.99, "timestamp": "04:16:29", "text": "あいつは本当に惨めだ。"}, {"type": "subtitle", "time": 15392.07, "timestamp": "04:16:32", "text": "神に誓って。金の"}, {"type": "subtitle", "time": 15406.229, "timestamp": "04:16:46", "text": "作っている。俺はもう行く。"}, {"type": "subtitle", "time": 15413.83, "timestamp": "04:16:53", "text": "どこにいるんだ？"}, {"type": "subtitle", "time": 15416.63, "timestamp": "04:16:56", "text": "奴に唾を吐きかけてやる。"}, {"type": "subtitle", "time": 15418.95, "timestamp": "04:16:58", "text": "待って、奴は死んだの？"}]
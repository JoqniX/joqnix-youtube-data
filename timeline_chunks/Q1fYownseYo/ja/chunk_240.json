[{"type": "subtitle", "time": 14401.11, "timestamp": "04:00:01", "text": "人が早すぎるから中に入ったことはない"}, {"type": "subtitle", "time": 14403.429, "timestamp": "04:00:03", "text": "。"}, {"type": "subtitle", "time": 14416.15, "timestamp": "04:00:16", "text": "狙ってみようか？いや、大丈夫だ。"}, {"type": "subtitle", "time": 14418.95, "timestamp": "04:00:18", "text": "ブルレタとクラッカー丸ごと持ってこい。それは持って"}, {"type": "subtitle", "time": 14421.291, "timestamp": "04:00:21", "text": "ない。"}, {"type": "subtitle", "time": 14428.71, "timestamp": "04:00:28", "text": "待って。金床の設計図は"}, {"type": "subtitle", "time": 14430.71, "timestamp": "04:00:30", "text": "もう持ってるの？"}, {"type": "subtitle", "time": 14432.469, "timestamp": "04:00:32", "text": "ええ、持ってるよ。"}, {"type": "subtitle", "time": 14435.269, "timestamp": "04:00:35", "text": "どうやって手に入れたの？うわあ、わから"}, {"type": "subtitle", "time": 14437.269, "timestamp": "04:00:37", "text": "ない。"}]
[{"type": "subtitle", "time": 7092.709, "timestamp": "01:58:12", "text": "彼らのリアクターは何も機能しないので、リーパーとロケッティアで何かをする必要があります"}, {"type": "subtitle", "time": 7093.109, "timestamp": "01:58:13", "text": "。"}, {"type": "subtitle", "time": 7097.03, "timestamp": "01:58:17", "text": "リーパーは遠征のために回復します。"}, {"type": "subtitle", "time": 7098.87, "timestamp": "01:58:18", "text": "本当に？ ああ、たくさん持ってるよ"}, {"type": "subtitle", "time": 7101.99, "timestamp": "01:58:21", "text": "。 何個必要ですか？"}, {"type": "subtitle", "time": 7104.31, "timestamp": "01:58:24", "text": "えっと、"}, {"type": "subtitle", "time": 7107.03, "timestamp": "01:58:27", "text": "実は忘れてたんです。   たった"}, {"type": "subtitle", "time": 7119.43, "timestamp": "01:58:39", "text": "ええ、4つくらいです。 いくつか いくつか ええ、"}, {"type": "subtitle", "time": 7122.47, "timestamp": "01:58:42", "text": "4つくらいです。 ええ、"}, {"type": "subtitle", "time": 7124.79, "timestamp": "01:58:44", "text": "4つか6つです。 わからない。 待ってください、それは"}, {"type": "subtitle", "time": 7127.35, "timestamp": "01:58:47", "text": "石炭爆発事件でした。"}, {"type": "subtitle", "time": 7130.55, "timestamp": "01:58:50", "text": "それは4つでしたよね？ いや、待って。 いや、いや、"}, {"type": "subtitle", "time": 7132.149, "timestamp": "01:58:52", "text": "いや。 そんなことをする必要はなかった。 ああ、"}, {"type": "subtitle", "time": 7133.27, "timestamp": "01:58:53", "text": "気にしないで。"}, {"type": "subtitle", "time": 7135.51, "timestamp": "01:58:55", "text": "おお。"}, {"type": "subtitle", "time": 7137.83, "timestamp": "01:58:57", "text": "えっと、"}]
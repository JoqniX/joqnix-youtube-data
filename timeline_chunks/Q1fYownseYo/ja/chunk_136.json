[{"type": "subtitle", "time": 8160.39, "timestamp": "02:16:00", "text": "ああそうだ。   とにかく"}, {"type": "subtitle", "time": 8163.91, "timestamp": "02:16:03", "text": "早くやらないと、飛び上がってから落下してしまいます"}, {"type": "subtitle", "time": 8166.629, "timestamp": "02:16:06", "text": "。"}, {"type": "subtitle", "time": 8173.75, "timestamp": "02:16:13", "text": "そこから出るまで10分。"}, {"type": "subtitle", "time": 8175.27, "timestamp": "02:16:15", "text": "今日も繰り返すか、ここから出て行ってください"}, {"type": "subtitle", "time": 8177.109, "timestamp": "02:16:17", "text": "。"}, {"type": "subtitle", "time": 8178.87, "timestamp": "02:16:18", "text": "終わらせろ。 さあ、出発しましょう。"}, {"type": "subtitle", "time": 8181.35, "timestamp": "02:16:21", "text": "実際に出発しましょう。"}, {"type": "subtitle", "time": 8182.55, "timestamp": "02:16:22", "text": "明らかに。   ああ"}, {"type": "subtitle", "time": 8185.669, "timestamp": "02:16:25", "text": "、とても遠いですね。"}, {"type": "subtitle", "time": 8195.11, "timestamp": "02:16:35", "text": "大きく進歩しました。"}, {"type": "subtitle", "time": 8197.349, "timestamp": "02:16:37", "text": "どのくらいポイントがありますか?   もう"}, {"type": "subtitle", "time": 8199.509, "timestamp": "02:16:39", "text": "終わりましたか？"}, {"type": "subtitle", "time": 8205.75, "timestamp": "02:16:45", "text": "1つだけです。 締め切りは1つだけです。"}, {"type": "subtitle", "time": 8208.15, "timestamp": "02:16:48", "text": "先週の Bastion も同じようにして行いました。"}, {"type": "subtitle", "time": 8210.629, "timestamp": "02:16:50", "text": "期限を過ぎたら終わりです。 たった 1 つの"}, {"type": "subtitle", "time": 8213.19, "timestamp": "02:16:53", "text": "締め切りで、申し訳ないですが満点を獲得しました"}, {"type": "subtitle", "time": 8214.95, "timestamp": "02:16:54", "text": "。"}]
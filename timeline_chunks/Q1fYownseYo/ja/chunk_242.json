[{"type": "subtitle", "time": 14522.71, "timestamp": "04:02:02", "text": "ああ、私も。"}, {"type": "subtitle", "time": 14525.429, "timestamp": "04:02:05", "text": "あれがすごく必要なんだ。よし、"}, {"type": "subtitle", "time": 14527.67, "timestamp": "04:02:07", "text": "アップグレードする。"}, {"type": "subtitle", "time": 14530.07, "timestamp": "04:02:10", "text": "スチールスプリングが必要だ。ほら、"}, {"type": "subtitle", "time": 14533.429, "timestamp": "04:02:13", "text": "スプリングが必要なんだ。なんてこった。"}, {"type": "subtitle", "time": 14534.87, "timestamp": "04:02:14", "text": "準備。"}, {"type": "subtitle", "time": 14538.79, "timestamp": "04:02:18", "text": "よし。えーと、ハッシュキーは買ったよね？"}, {"type": "subtitle", "time": 14539.75, "timestamp": "04:02:19", "text": "うん。わかった。よし。"}]
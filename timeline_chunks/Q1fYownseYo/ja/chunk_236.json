[{"type": "subtitle", "time": 14180.07, "timestamp": "03:56:20", "text": "ねずみ講で互いに攻撃し合う。もっと"}, {"type": "subtitle", "time": 14182.79, "timestamp": "03:56:22", "text": "グープを集めて出て行く。"}, {"type": "subtitle", "time": 14193.67, "timestamp": "03:56:33", "text": "でもクロスプレイはオフになっている。それが理由か"}, {"type": "subtitle", "time": 14195.59, "timestamp": "03:56:35", "text": "？"}, {"type": "subtitle", "time": 14198.87, "timestamp": "03:56:38", "text": "いや、プレイヤー同士が減ってはいけない"}, {"type": "subtitle", "time": 14200.63, "timestamp": "03:56:40", "text": "。だって"}, {"type": "subtitle", "time": 14202.309, "timestamp": "03:56:42", "text": "、俺の場合、コンソール版のプレイヤーと"}, {"type": "subtitle", "time": 14205.429, "timestamp": "03:56:45", "text": "プレイすると、もっと毒のあるPVPプレイヤーが増えるんだ"}, {"type": "subtitle", "time": 14208.55, "timestamp": "03:56:48", "text": "。"}, {"type": "subtitle", "time": 14211.67, "timestamp": "03:56:51", "text": "ああ、そうだ、"}]
[{"type": "subtitle", "time": 9660.87, "timestamp": "02:41:00", "text": "挑戦しているだけです。 お願いします。"}, {"type": "subtitle", "time": 9662.71, "timestamp": "02:41:02", "text": "チーム全体が存在します。"}, {"type": "subtitle", "time": 9665.11, "timestamp": "02:41:05", "text": "やめる。 チル。 トライアル中です。 お願いします"}, {"type": "subtitle", "time": 9666.23, "timestamp": "02:41:06", "text": "。 待って。 持続する。   そのままにしておきましょう"}, {"type": "subtitle", "time": 9670.15, "timestamp": "02:41:10", "text": "。 お願いします。 なぜ？"}, {"type": "subtitle", "time": 9672.309, "timestamp": "02:41:12", "text": "チームは2つあります。"}, {"type": "subtitle", "time": 9674.87, "timestamp": "02:41:14", "text": "彼らはチームを組む。 彼らはチームを組むんだ。"}, {"type": "subtitle", "time": 9680.309, "timestamp": "02:41:20", "text": "挑戦なんてクソくらえだ。 ああ、待って。"}, {"type": "subtitle", "time": 9683.59, "timestamp": "02:41:23", "text": "素晴らしいものがたくさんありました。 いいえ。ああ"}, {"type": "subtitle", "time": 9684.63, "timestamp": "02:41:24", "text": "、そうか。"}, {"type": "subtitle", "time": 9693.19, "timestamp": "02:41:33", "text": "。 ステラ・モンティです。"}, {"type": "subtitle", "time": 9696.95, "timestamp": "02:41:36", "text": "ああ、脱出すべきだった。   言ってるんだよ"}, {"type": "subtitle", "time": 9698.95, "timestamp": "02:41:38", "text": "。 これが"}, {"type": "subtitle", "time": 9700.71, "timestamp": "02:41:40", "text": "ステラだということを忘れないでください。"}, {"type": "subtitle", "time": 9702.95, "timestamp": "02:41:42", "text": "彼らもチームを組むんだ。  2つのチームが協力します"}, {"type": "subtitle", "time": 9705.67, "timestamp": "02:41:45", "text": "。 最悪だ。   最悪だ"}, {"type": "subtitle", "time": 9706.55, "timestamp": "02:41:46", "text": "。"}]
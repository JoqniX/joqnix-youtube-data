[{"type": "subtitle", "time": 12251.99, "timestamp": "03:24:11", "text": "。 例えば、さっきは何をしていたんですか"}, {"type": "subtitle", "time": 12254.55, "timestamp": "03:24:14", "text": "？"}, {"type": "subtitle", "time": 12256.63, "timestamp": "03:24:16", "text": "ただ走っているだけです。"}, {"type": "subtitle", "time": 12267.11, "timestamp": "03:24:27", "text": "アレックス、"}, {"type": "subtitle", "time": 12287.19, "timestamp": "03:24:47", "text": "。"}, {"type": "subtitle", "time": 12288.15, "timestamp": "03:24:48", "text": "我が神よ。"}, {"type": "subtitle", "time": 12290.63, "timestamp": "03:24:50", "text": "それはあなたの銃のせいですか？ 彼らは"}, {"type": "subtitle", "time": 12293.19, "timestamp": "03:24:53", "text": "「ああ、欲しい」と言います。"}, {"type": "subtitle", "time": 12295.269, "timestamp": "03:24:55", "text": "遠くからは見えません。"}, {"type": "subtitle", "time": 12298.95, "timestamp": "03:24:58", "text": "彼らはとても遠くまで行くことができます。"}]
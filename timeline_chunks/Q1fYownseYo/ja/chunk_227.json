[{"type": "subtitle", "time": 13620.309, "timestamp": "03:47:00", "text": "よし、生存者はいる。ゆっくり這って"}, {"type": "subtitle", "time": 13623.429, "timestamp": "03:47:03", "text": "。時間をかけて。落ち着いて、こっちまで"}, {"type": "subtitle", "time": 13626.55, "timestamp": "03:47:06", "text": "這って来い。"}, {"type": "subtitle", "time": 13630.389, "timestamp": "03:47:10", "text": "でも、お前はもうすぐ死ぬところだ。クソッ。"}, {"type": "subtitle", "time": 13632.229, "timestamp": "03:47:12", "text": "うわ、私は死んだ。内緒にしてくれ。私は"}, {"type": "subtitle", "time": 13635.59, "timestamp": "03:47:15", "text": "死にかけている。私は死にかけている。死にかけになる前に"}, {"type": "subtitle", "time": 13637.269, "timestamp": "03:47:17", "text": "、"}, {"type": "subtitle", "time": 13640.309, "timestamp": "03:47:20", "text": "一番近いハッチの鍵の場所をpingしてくれるか？"}, {"type": "subtitle", "time": 13642.79, "timestamp": "03:47:22", "text": "死ぬ前に一番近い場所だ。わかった"}, {"type": "subtitle", "time": 13645.83, "timestamp": "03:47:25", "text": "。どこにいる？"}, {"type": "subtitle", "time": 13648.87, "timestamp": "03:47:28", "text": "えーと、ハッチの鍵はここだ。"}, {"type": "subtitle", "time": 13650.55, "timestamp": "03:47:30", "text": "ああ、すぐそこだ。わかった。とても"}, {"type": "subtitle", "time": 13653.269, "timestamp": "03:47:33", "text": "近い。"}, {"type": "subtitle", "time": 13656.229, "timestamp": "03:47:36", "text": "待って、本当に私抜きで脱出するつもりなのか"}, {"type": "subtitle", "time": 13657.83, "timestamp": "03:47:37", "text": "？"}, {"type": "subtitle", "time": 13661.91, "timestamp": "03:47:41", "text": "念のため、そこに行って会おう。"}, {"type": "subtitle", "time": 13664.79, "timestamp": "03:47:44", "text": "ああ。オービターは ルート中。安全窓が"}, {"type": "subtitle", "time": 13667.269, "timestamp": "03:47:47", "text": "閉まりつつある。"}, {"type": "subtitle", "time": 13669.429, "timestamp": "03:47:49", "text": "スパタに戻るのに10分ある。繰り返す、10"}, {"type": "subtitle", "time": 13671.91, "timestamp": "03:47:51", "text": "分後だ。"}, {"type": "subtitle", "time": 13675.91, "timestamp": "03:47:55", "text": "よし、もう原子炉を1つ見つけた。"}, {"type": "subtitle", "time": 13676.309, "timestamp": "03:47:56", "text": "ああ、"}, {"type": "subtitle", "time": 13678.55, "timestamp": "03:47:58", "text": "畜生。もう少しで死にそうだ。2発撃ったら"}]
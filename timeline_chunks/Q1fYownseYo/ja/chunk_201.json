[{"type": "subtitle", "time": 12065.11, "timestamp": "03:21:05", "text": "場所を探します。 そこには"}, {"type": "subtitle", "time": 12067.75, "timestamp": "03:21:07", "text": "人が沢山いるので行きたくないです。"}, {"type": "subtitle", "time": 12069.51, "timestamp": "03:21:09", "text": "発射台にはたくさんの人が集まります。"}, {"type": "subtitle", "time": 12072.15, "timestamp": "03:21:12", "text": "ああ、彼らはガスをやっている。 ああ、待って。 いいえ。"}, {"type": "subtitle", "time": 12074.71, "timestamp": "03:21:14", "text": "マトリックスはガスのことをやりますよね?"}, {"type": "subtitle", "time": 12077.11, "timestamp": "03:21:17", "text": "うん。"}, {"type": "subtitle", "time": 12079.51, "timestamp": "03:21:19", "text": "これを見てください。   痛い。"}, {"type": "subtitle", "time": 12084.469, "timestamp": "03:21:24", "text": "待って。 スキルポイント"}, {"type": "subtitle", "time": 12091.269, "timestamp": "03:21:31", "text": "待って。 どうやって転がるんですか？"}, {"type": "subtitle", "time": 12097.99, "timestamp": "03:21:37", "text": "。 トリックを聞きました。"}, {"type": "subtitle", "time": 12100.229, "timestamp": "03:21:40", "text": "スタミナがなくなって、"}, {"type": "subtitle", "time": 12114.469, "timestamp": "03:21:54", "text": "頭上にスズメバチがいました。"}, {"type": "subtitle", "time": 12116.15, "timestamp": "03:21:56", "text": "スズメバチがいます。   ちくしょう"}]
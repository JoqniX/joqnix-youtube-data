[{"type": "subtitle", "time": 8890.469, "timestamp": "02:28:10", "text": "医療研究室をアップグレードすると何が得られますか? アークサー・ア・"}, {"type": "subtitle", "time": 8893.67, "timestamp": "02:28:13", "text": "サーベイヤーは終了しましたか？"}, {"type": "subtitle", "time": 8895.429, "timestamp": "02:28:15", "text": "医学とは何ですか？"}, {"type": "subtitle", "time": 8901.19, "timestamp": "02:28:21", "text": "医学研究室をレベル 3 にアップグレードしましたか？   ああ"}, {"type": "subtitle", "time": 8904.71, "timestamp": "02:28:24", "text": "、特に何もないよ。   ロックを"}, {"type": "subtitle", "time": 8908.79, "timestamp": "02:28:28", "text": "解除するのは紫色ですか、それとも青色ですか?"}, {"type": "subtitle", "time": 8910.79, "timestamp": "02:28:30", "text": "いいえ、Vita スプレーはあると思いますが、それには"}, {"type": "subtitle", "time": 8913.349, "timestamp": "02:28:33", "text": "設計図が必要です。"}, {"type": "subtitle", "time": 8914.55, "timestamp": "02:28:34", "text": "ああ、そうだと"}, {"type": "subtitle", "time": 8917.19, "timestamp": "02:28:37", "text": "思います。   わかった"}, {"type": "subtitle", "time": 8920.23, "timestamp": "02:28:40", "text": "。 ああ、シールドが必要だ。 それを忘れてた"}, {"type": "subtitle", "time": 8922.309, "timestamp": "02:28:42", "text": "。"}]
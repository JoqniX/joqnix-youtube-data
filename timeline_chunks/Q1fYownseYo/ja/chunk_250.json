[{"type": "subtitle", "time": 15004.07, "timestamp": "04:10:04", "text": "ハーベスターを命がけで守ってるんだ。だから"}, {"type": "subtitle", "time": 15006.15, "timestamp": "04:10:06", "text": "女王様は"}, {"type": "subtitle", "time": 15012.63, "timestamp": "04:10:12", "text": "俺よりずっと厄介なんだ。"}, {"type": "subtitle", "time": 15020.07, "timestamp": "04:10:20", "text": "どうしたんだ？やられた。入って。入って。"}, {"type": "subtitle", "time": 15026.87, "timestamp": "04:10:26", "text": "シールドがない。入って。くそっ"}]
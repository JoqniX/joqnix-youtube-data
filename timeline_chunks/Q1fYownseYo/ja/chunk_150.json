[{"type": "subtitle", "time": 9001.03, "timestamp": "02:30:01", "text": "PVPではないことを祈ります。   場合によります"}, {"type": "subtitle", "time": 9004.07, "timestamp": "02:30:04", "text": "。 でも、それは起こるんです。 はい、状況に"}, {"type": "subtitle", "time": 9015.11, "timestamp": "02:30:15", "text": "金床を失いたくない。"}, {"type": "subtitle", "time": 9018.789, "timestamp": "02:30:18", "text": "私はフルートを手に入れました。"}, {"type": "subtitle", "time": 9019.75, "timestamp": "02:30:19", "text": "[笑い]"}, {"type": "subtitle", "time": 9022.07, "timestamp": "02:30:22", "text": "誰もフルートを吹かないでください。"}, {"type": "subtitle", "time": 9033.27, "timestamp": "02:30:33", "text": "そうそう。 ええと、トライアルでは、引き続き"}, {"type": "subtitle", "time": 9036.71, "timestamp": "02:30:36", "text": "記録を破り続けることができます。"}, {"type": "subtitle", "time": 9038.79, "timestamp": "02:30:38", "text": "ああそうだ。 うん。"}, {"type": "subtitle", "time": 9042.23, "timestamp": "02:30:42", "text": "誰かが"}, {"type": "subtitle", "time": 9048.63, "timestamp": "02:30:48", "text": "クレイジー。 何てことだ。"}, {"type": "subtitle", "time": 9051.19, "timestamp": "02:30:51", "text": "あれは本当に面白かった。"}, {"type": "subtitle", "time": 9054.23, "timestamp": "02:30:54", "text": "うん。 どういうわけか、私はロケット弾発射機を気絶させ、"}, {"type": "subtitle", "time": 9057.99, "timestamp": "02:30:57", "text": "それが反転しました。"}]
[{"type": "subtitle", "time": 9602.71, "timestamp": "02:40:02", "text": "。 シュレッダーが来ます。 シュレッダーが来ます。"}, {"type": "subtitle", "time": 9605.19, "timestamp": "02:40:05", "text": "ここから入手してください。   そちらへ"}, {"type": "subtitle", "time": 9606.469, "timestamp": "02:40:06", "text": "来ます。"}, {"type": "subtitle", "time": 9607.75, "timestamp": "02:40:07", "text": "ボールを手に入れた。"}, {"type": "subtitle", "time": 9609.03, "timestamp": "02:40:09", "text": "左、左、左、左、左、左、"}, {"type": "subtitle", "time": 9611.439, "timestamp": "02:40:11", "text": "左、 ショット。"}, {"type": "subtitle", "time": 9613.28, "timestamp": "02:40:13", "text": "ショット。 ああ。   何てことだ"}, {"type": "subtitle", "time": 9614.16, "timestamp": "02:40:14", "text": "ああ。   何てことだ 。   何てことだ"}, {"type": "subtitle", "time": 9624.95, "timestamp": "02:40:24", "text": "。"}, {"type": "subtitle", "time": 9626.15, "timestamp": "02:40:26", "text": "どうやって死ぬの？"}, {"type": "subtitle", "time": 9627.11, "timestamp": "02:40:27", "text": "私は死にました。"}, {"type": "subtitle", "time": 9630.15, "timestamp": "02:40:30", "text": "ああ、くそ。 ああ、ポップ。"}, {"type": "subtitle", "time": 9644.07, "timestamp": "02:40:44", "text": "こんにちは。 ありがとう。"}, {"type": "subtitle", "time": 9646.71, "timestamp": "02:40:46", "text": "外に誰かいる。"}, {"type": "subtitle", "time": 9656.63, "timestamp": "02:40:56", "text": "こんにちは。 待って。 何だこれ？"}, {"type": "subtitle", "time": 9657.91, "timestamp": "02:40:57", "text": "私の銃。"}, {"type": "subtitle", "time": 9659.75, "timestamp": "02:40:59", "text": "待って。 撃たないで。 私たちはただ"}]
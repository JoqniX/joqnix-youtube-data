[{"type": "subtitle", "time": 13745.99, "timestamp": "03:49:05", "text": "交戦するな。お前には何もない。俺が持っている"}, {"type": "subtitle", "time": 13747.429, "timestamp": "03:49:07", "text": "。"}, {"type": "subtitle", "time": 13760.469, "timestamp": "03:49:20", "text": "誰かが死んでる。そうじゃ"}, {"type": "subtitle", "time": 13764.309, "timestamp": "03:49:24", "text": "ない。待って、死んでない。"}, {"type": "subtitle", "time": 13766.309, "timestamp": "03:49:26", "text": "待って、死なないで。"}, {"type": "subtitle", "time": 13769.11, "timestamp": "03:49:29", "text": "誰かが死んでる。"}, {"type": "subtitle", "time": 13772.87, "timestamp": "03:49:32", "text": "何？お前は、なんてこった。 戦利品？"}, {"type": "subtitle", "time": 13774.309, "timestamp": "03:49:34", "text": "待て、あいつがお前を略奪でもしてるんじゃないか？"}, {"type": "subtitle", "time": 13775.67, "timestamp": "03:49:35", "text": "何だって？いやいやいや"}, {"type": "subtitle", "time": 13777.429, "timestamp": "03:49:37", "text": "。待って"}, {"type": "subtitle", "time": 13787.59, "timestamp": "03:49:47", "text": "よし、俺を蘇生させてみろ。こいつなら"}, {"type": "subtitle", "time": 13790.07, "timestamp": "03:49:50", "text": "一瞬で倒せる。"}, {"type": "subtitle", "time": 13792.55, "timestamp": "03:49:52", "text": "もうすぐ死ぬ。"}, {"type": "subtitle", "time": 13795.03, "timestamp": "03:49:55", "text": "ああ、申し訳ない"}, {"type": "subtitle", "time": 13797.67, "timestamp": "03:49:57", "text": "。あいつはチームメイトだ。ああ、あいつは"}, {"type": "subtitle", "time": 13799.269, "timestamp": "03:49:59", "text": "生きている。俺に"}]
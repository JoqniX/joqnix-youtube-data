[{"type": "subtitle", "time": 8828.71, "timestamp": "02:27:08", "text": "DEFAの設計図は入手しましたか?"}, {"type": "subtitle", "time": 8830.63, "timestamp": "02:27:10", "text": "はい、そうしました。"}, {"type": "subtitle", "time": 8832.389, "timestamp": "02:27:12", "text": "おお。"}, {"type": "subtitle", "time": 8840.71, "timestamp": "02:27:20", "text": "。 どこかに。"}, {"type": "subtitle", "time": 8844.07, "timestamp": "02:27:24", "text": "包帯を買って、"}, {"type": "subtitle", "time": 8848.469, "timestamp": "02:27:28", "text": "盾も作らなきゃ。   さあ"}, {"type": "subtitle", "time": 8850.55, "timestamp": "02:27:30", "text": "、レイダーさん、入って来なさい。 良い"}, {"type": "subtitle", "time": 8852.469, "timestamp": "02:27:32", "text": "ものを用意しました。"}, {"type": "subtitle", "time": 8854.389, "timestamp": "02:27:34", "text": "君はここで私を良く見せているよ。 それを維持する"}, {"type": "subtitle", "time": 8855.51, "timestamp": "02:27:35", "text": "。"}, {"type": "subtitle", "time": 8858.23, "timestamp": "02:27:38", "text": "よし、行こう。"}, {"type": "subtitle", "time": 8859.99, "timestamp": "02:27:39", "text": "それで、私たちはステラに行くんですよね？"}, {"type": "subtitle", "time": 8862.95, "timestamp": "02:27:42", "text": "ステラか畜生。 そうだね、ステラ。"}, {"type": "subtitle", "time": 8864.87, "timestamp": "02:27:44", "text": "ステラをやろう。"}, {"type": "subtitle", "time": 8867.99, "timestamp": "02:27:47", "text": "うん。 さあ行こう。"}]
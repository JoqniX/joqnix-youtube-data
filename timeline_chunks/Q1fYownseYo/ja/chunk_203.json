[{"type": "subtitle", "time": 12181.67, "timestamp": "03:23:01", "text": "いいえ、"}, {"type": "subtitle", "time": 12184.79, "timestamp": "03:23:04", "text": "ハッチはここにありますが、遠いです。"}, {"type": "subtitle", "time": 12188.229, "timestamp": "03:23:08", "text": "ここに行こう。"}, {"type": "subtitle", "time": 12190.309, "timestamp": "03:23:10", "text": "この人たちは一体何が悪いのでしょうか？"}, {"type": "subtitle", "time": 12194.95, "timestamp": "03:23:14", "text": "クソアジアのサーバーで何が問題なんだ？ 我が神よ。"}, {"type": "subtitle", "time": 12201.11, "timestamp": "03:23:21", "text": "最も有毒だと思いました。"}, {"type": "subtitle", "time": 12204.229, "timestamp": "03:23:24", "text": "NAサーバーは正常です。"}, {"type": "subtitle", "time": 12206.95, "timestamp": "03:23:26", "text": "アジアのサーバーは、ものすごく汗をかいている"}, {"type": "subtitle", "time": 12208.55, "timestamp": "03:23:28", "text": "人たちです。"}, {"type": "subtitle", "time": 12216.07, "timestamp": "03:23:36", "text": "リセットしますか、それとも戻りますか?"}, {"type": "subtitle", "time": 12222.63, "timestamp": "03:23:42", "text": "あなた次第。   行けますよ"}, {"type": "subtitle", "time": 12228.469, "timestamp": "03:23:48", "text": "。 行きたいですか？ まだ行きたいです。"}, {"type": "subtitle", "time": 12231.59, "timestamp": "03:23:51", "text": "彼らはまだ戦っている。"}, {"type": "subtitle", "time": 12234.469, "timestamp": "03:23:54", "text": "えっと、見て、左を見て。 はい、ちょっと見守ってください"}]
[{"type": "subtitle", "time": 9300.87, "timestamp": "02:35:00", "text": "ここからですよ。 私は、"}, {"type": "subtitle", "time": 9304.15, "timestamp": "02:35:04", "text": "この"}, {"type": "subtitle", "time": 9315.11, "timestamp": "02:35:15", "text": "顕微鏡が必要ですね。 そうそう。 うん。 私は侵入口を"}, {"type": "subtitle", "time": 9316.95, "timestamp": "02:35:16", "text": "突破して"}, {"type": "subtitle", "time": 9321.27, "timestamp": "02:35:21", "text": "サーバールームを捜索し、文字通り"}, {"type": "subtitle", "time": 9330.63, "timestamp": "02:35:30", "text": "センサーはどのように作成するのでしょうか? 右。"}, {"type": "subtitle", "time": 9332.07, "timestamp": "02:35:32", "text": "センサー。   念のため"}, {"type": "subtitle", "time": 9334.309, "timestamp": "02:35:34", "text": "ハッシュキーです。 ああ、待って。"}, {"type": "subtitle", "time": 9335.51, "timestamp": "02:35:35", "text": "夜襲です。"}, {"type": "subtitle", "time": 9340.309, "timestamp": "02:35:40", "text": "ああ、"}, {"type": "subtitle", "time": 9343.11, "timestamp": "02:35:43", "text": "悲しいかな、ジョー。 悲しいことに"}, {"type": "subtitle", "time": 9344.63, "timestamp": "02:35:44", "text": "、"}, {"type": "subtitle", "time": 9347.03, "timestamp": "02:35:47", "text": "セキュリティ違反が発生しました。 わかりました。探してみます"}, {"type": "subtitle", "time": 9348.15, "timestamp": "02:35:48", "text": "。"}, {"type": "subtitle", "time": 9348.55, "timestamp": "02:35:48", "text": "ああ、"}, {"type": "subtitle", "time": 9351.03, "timestamp": "02:35:51", "text": "セキュリティ違反のようなものを見つけたら、"}, {"type": "subtitle", "time": 9352.389, "timestamp": "02:35:52", "text": "私に電話してください。 お知らせしたいことがあります"}]
[{"type": "subtitle", "time": 13561.349, "timestamp": "03:46:01", "text": "ホーミング付きだ。"}, {"type": "subtitle", "time": 13564.15, "timestamp": "03:46:04", "text": "ホーミングだと思う。"}, {"type": "subtitle", "time": 13567.03, "timestamp": "03:46:07", "text": "ああ、そうだ。ベーコン。ここから撃て。撃つ"}, {"type": "subtitle", "time": 13569.83, "timestamp": "03:46:09", "text": "。君のところから撃て 場所。"}, {"type": "subtitle", "time": 13573.83, "timestamp": "03:46:13", "text": "それから、そろそろ「"}, {"type": "subtitle", "time": 13575.99, "timestamp": "03:46:15", "text": "マットトラックは死んでる？」"}, {"type": "subtitle", "time": 13581.91, "timestamp": "03:46:21", "text": "マへ来い。"}, {"type": "subtitle", "time": 13584.309, "timestamp": "03:46:24", "text": "爆撃機だ。ちょっと待って。"}, {"type": "subtitle", "time": 13611.269, "timestamp": "03:46:51", "text": "なんてこった、"}, {"type": "subtitle", "time": 13613.349, "timestamp": "03:46:53", "text": "死んでる。」[笑い]"}, {"type": "subtitle", "time": 13614.15, "timestamp": "03:46:54", "text": "なぜ？"}, {"type": "subtitle", "time": 13615.67, "timestamp": "03:46:55", "text": "時間がない。"}, {"type": "subtitle", "time": 13617.83, "timestamp": "03:46:57", "text": "生存者はいるだろう？教えてくれ"}, {"type": "subtitle", "time": 13618.229, "timestamp": "03:46:58", "text": "。"}, {"type": "subtitle", "time": 13619.269, "timestamp": "03:46:59", "text": "ああ、私は生存者だ。"}]
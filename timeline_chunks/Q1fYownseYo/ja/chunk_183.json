[{"type": "subtitle", "time": 10985.59, "timestamp": "03:03:05", "text": "うん。"}, {"type": "subtitle", "time": 10986.469, "timestamp": "03:03:06", "text": "ああ、そうなんですか？"}, {"type": "subtitle", "time": 10987.67, "timestamp": "03:03:07", "text": "あなたはしない？"}, {"type": "subtitle", "time": 10991.03, "timestamp": "03:03:11", "text": "いいえ、ただ保管してあるだけです。"}, {"type": "subtitle", "time": 10994.469, "timestamp": "03:03:14", "text": "おい、来いよ。"}, {"type": "subtitle", "time": 10995.83, "timestamp": "03:03:15", "text": "いつかは使わなければなりません。"}, {"type": "subtitle", "time": 11002.55, "timestamp": "03:03:22", "text": "。 誰かが襲ってきた場合に備えて地雷をいくつか持ってこなければなりません"}, {"type": "subtitle", "time": 11004.87, "timestamp": "03:03:24", "text": "。   そうそう"}, {"type": "subtitle", "time": 11016.309, "timestamp": "03:03:36", "text": "フィールドのやつをやってみようと思います。   わかった"}, {"type": "subtitle", "time": 11017.91, "timestamp": "03:03:37", "text": "。"}, {"type": "subtitle", "time": 11019.429, "timestamp": "03:03:39", "text": "フィールドって何？"}, {"type": "subtitle", "time": 11022.15, "timestamp": "03:03:42", "text": "フィールドのもの。 そうだ、野戦補給所だ。 もし何か必要なものがあれば、"}, {"type": "subtitle", "time": 11028.63, "timestamp": "03:03:48", "text": "何が必要ですか？  3つです"}, {"type": "subtitle", "time": 11035.429, "timestamp": "03:03:55", "text": "完了するには 3 つを配達する必要があります"}]
[{"type": "subtitle", "time": 8521.75, "timestamp": "02:22:01", "text": "私が撃ったんです。 撃ちました。 ただ撃っただけ。 走る。"}, {"type": "subtitle", "time": 8524.63, "timestamp": "02:22:04", "text": "もう一度撮影しました。   うーん"}, {"type": "subtitle", "time": 8526.87, "timestamp": "02:22:06", "text": "。"}, {"type": "subtitle", "time": 8528.07, "timestamp": "02:22:08", "text": "待って。 早く、早く。"}, {"type": "subtitle", "time": 8534.87, "timestamp": "02:22:14", "text": "。   ああ"}, {"type": "subtitle", "time": 8559.51, "timestamp": "02:22:39", "text": "私が何を得たか見てください。"}, {"type": "subtitle", "time": 8561.83, "timestamp": "02:22:41", "text": "私も。"}, {"type": "subtitle", "time": 8563.67, "timestamp": "02:22:43", "text": "ブロワーグレネード。"}, {"type": "subtitle", "time": 8566.87, "timestamp": "02:22:46", "text": "シンプルなガンポウを手に入れました。"}, {"type": "subtitle", "time": 8570.469, "timestamp": "02:22:50", "text": "ああ、2つ目の設計図を手に入れました。"}, {"type": "subtitle", "time": 8573.03, "timestamp": "02:22:53", "text": "ああ、いい加減にしてくれ。"}, {"type": "subtitle", "time": 8576.79, "timestamp": "02:22:56", "text": "ああ、行きましょう。 ストックでストックパッドを手に入れました"}, {"type": "subtitle", "time": 8577.99, "timestamp": "02:22:57", "text": "。"}]
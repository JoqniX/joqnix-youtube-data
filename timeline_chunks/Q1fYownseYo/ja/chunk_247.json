[{"type": "subtitle", "time": 14822.389, "timestamp": "04:07:02", "text": "ゲームが死にそうだ。こっちへ来い。こっちへ来い。"}, {"type": "subtitle", "time": 14824.95, "timestamp": "04:07:04", "text": "こっちへ来い。2階を"}, {"type": "subtitle", "time": 14827.429, "timestamp": "04:07:07", "text": "略奪して"}, {"type": "subtitle", "time": 14829.75, "timestamp": "04:07:09", "text": "設計図か何か手に入れたかったんだ。もしあればね。"}, {"type": "subtitle", "time": 14858.63, "timestamp": "04:07:38", "text": "？"}, {"type": "subtitle", "time": 14867.67, "timestamp": "04:07:47", "text": "いや、女家長と女王だ。"}]
[{"type": "subtitle", "time": 10035.59, "timestamp": "02:47:15", "text": "待って、それは流行りか何か？"}, {"type": "subtitle", "time": 10055.429, "timestamp": "02:47:35", "text": "それは長い道のりになるでしょう。"}, {"type": "subtitle", "time": 10057.99, "timestamp": "02:47:37", "text": "そうそう。"}, {"type": "subtitle", "time": 10059.75, "timestamp": "02:47:39", "text": "えっと、上は行き止まりです。"}, {"type": "subtitle", "time": 10061.68, "timestamp": "02:47:41", "text": "上は行き止まりです。 ああ、"}, {"type": "subtitle", "time": 10062.56, "timestamp": "02:47:42", "text": "ああ、 下がるしかない。"}, {"type": "subtitle", "time": 10064.24, "timestamp": "02:47:44", "text": "下がるしかない。 そうだ、降りよう。"}, {"type": "subtitle", "time": 10066.88, "timestamp": "02:47:46", "text": "そうだ、降りよう。 シュレッダー。 シュレッダー。 シュレッダー。 シュレッダーの"}, {"type": "subtitle", "time": 10078.07, "timestamp": "02:47:58", "text": "人々。"}, {"type": "subtitle", "time": 10079.67, "timestamp": "02:47:59", "text": "近くに人がいます。 はい、"}]
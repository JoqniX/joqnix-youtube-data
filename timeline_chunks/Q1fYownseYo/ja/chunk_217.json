[{"type": "subtitle", "time": 13021.67, "timestamp": "03:37:01", "text": "何人かは要塞と戦っている。"}, {"type": "subtitle", "time": 13023.83, "timestamp": "03:37:03", "text": "音のする要塞がある"}, {"type": "subtitle", "time": 13024.229, "timestamp": "03:37:04", "text": "あそこに音がする。じゃあ、あそこに"}, {"type": "subtitle", "time": 13026.95, "timestamp": "03:37:06", "text": "行ける。ああ"}, {"type": "subtitle", "time": 13031.59, "timestamp": "03:37:11", "text": "。なんてこった。ロケッティア・リーパー"}, {"type": "subtitle", "time": 13034.15, "timestamp": "03:37:14", "text": "とボンバディアが見える。"}, {"type": "subtitle", "time": 13035.67, "timestamp": "03:37:15", "text": "あそこに行きたい。"}, {"type": "subtitle", "time": 13037.11, "timestamp": "03:37:17", "text": "クソ。クソ。クソ。クソ。クソ。クソ。クソ。クソ。クソ。クソ。クソ。クソ。クソ。クソ。クソ。クソ。クソ。クソ"}, {"type": "subtitle", "time": 13039.51, "timestamp": "03:37:19", "text": "。奴らに見られた。"}, {"type": "subtitle", "time": 13046.389, "timestamp": "03:37:26", "text": "ロケッティアが来る。"}, {"type": "subtitle", "time": 13048.79, "timestamp": "03:37:28", "text": "ミサイルを無敵のように発射できることを忘れてた"}, {"type": "subtitle", "time": 13058.07, "timestamp": "03:37:38", "text": "ロケットをここに呼んでいるのか？ああ、"}]
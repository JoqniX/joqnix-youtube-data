[{"type": "subtitle", "time": 1261.99, "timestamp": "00:21:01", "text": "どうやら、あなたは、"}, {"type": "subtitle", "time": 1267.59, "timestamp": "00:21:07", "text": "ああ、ああ、主よ、それを手に入れなければならないようです。 ロケット打ち。"}, {"type": "subtitle", "time": 1269.75, "timestamp": "00:21:09", "text": "どうやらロックを解除する必要があるようです。"}, {"type": "subtitle", "time": 1271.75, "timestamp": "00:21:11", "text": "侵入者に注意。 北アンテナが"}, {"type": "subtitle", "time": 1284.71, "timestamp": "00:21:24", "text": "撃たないでください。"}, {"type": "subtitle", "time": 1314.39, "timestamp": "00:21:54", "text": "また、その発表は行われましたか"}, {"type": "subtitle", "time": 1316.789, "timestamp": "00:21:56", "text": "? ああ、とても"}]
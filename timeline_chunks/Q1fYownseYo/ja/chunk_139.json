[{"type": "subtitle", "time": 8341.349, "timestamp": "02:19:01", "text": "撃たないでください。"}, {"type": "subtitle", "time": 8349.19, "timestamp": "02:19:09", "text": "えっと、帽子をジョックしてください。 ああ、くそ。 わかった。   わかった"}, {"type": "subtitle", "time": 8351.83, "timestamp": "02:19:11", "text": "。 そこに居続けましょう。"}, {"type": "subtitle", "time": 8353.75, "timestamp": "02:19:13", "text": "ここに留まって"}, {"type": "subtitle", "time": 8356.549, "timestamp": "02:19:16", "text": "スズメバチを探してみましょう。 それは何ですか？"}, {"type": "subtitle", "time": 8377.91, "timestamp": "02:19:37", "text": "。 私はオオカミの群れを飼っています。"}, {"type": "subtitle", "time": 8383.75, "timestamp": "02:19:43", "text": "いや、念のため。 そうすべきではないと思います"}, {"type": "subtitle", "time": 8384.549, "timestamp": "02:19:44", "text": "。"}, {"type": "subtitle", "time": 8387.349, "timestamp": "02:19:47", "text": "保存しておきます。 ああ、とにかくただの"}, {"type": "subtitle", "time": 8390.469, "timestamp": "02:19:50", "text": "ジャンパーだよ。"}, {"type": "subtitle", "time": 8392.389, "timestamp": "02:19:52", "text": "飛躍を確かめてみましょう。"}, {"type": "subtitle", "time": 8394.389, "timestamp": "02:19:54", "text": "本物のブレザー1着で十分です。 挑戦したいと思っています"}]
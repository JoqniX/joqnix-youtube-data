[{"type": "subtitle", "time": 16681.269, "timestamp": "04:38:01", "text": "ストリームをバックグラウンドで維持したい場合は可能ですが、"}, {"type": "subtitle", "time": 16688.629, "timestamp": "04:38:08", "text": "基本的に"}, {"type": "subtitle", "time": 16692.23, "timestamp": "04:38:12", "text": "それらのストリームを視聴する必要はありません。"}, {"type": "subtitle", "time": 16696.07, "timestamp": "04:38:16", "text": "今年"}, {"type": "subtitle", "time": 16699.349, "timestamp": "04:38:19", "text": "4 月以降、"}, {"type": "subtitle", "time": 16703.029, "timestamp": "04:38:23", "text": "自宅の PC でストリーミングできなくなるため、これをやるだけです。"}, {"type": "subtitle", "time": 16706.15, "timestamp": "04:38:26", "text": "日本にいるときのサーバーとして利用するつもりです。 それで、"}, {"type": "subtitle", "time": 16709.189, "timestamp": "04:38:29", "text": "インドの自宅の PC を使って"}, {"type": "subtitle", "time": 16715.029, "timestamp": "04:38:35", "text": "2477 チャンネルをやろうと思っています。そうすれば、"}, {"type": "subtitle", "time": 16716.789, "timestamp": "04:38:36", "text": "古いコンテンツを視聴したい人はすぐに視聴できます。それが"}, {"type": "subtitle", "time": 16720.789, "timestamp": "04:38:40", "text": "分離した理由であり、"}, {"type": "subtitle", "time": 16722.869, "timestamp": "04:38:42", "text": "そのために新しいキック チャンネルを作成した理由です"}, {"type": "subtitle", "time": 16729.109, "timestamp": "04:38:49", "text": "うん。"}]
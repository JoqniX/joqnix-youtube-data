[{"type": "subtitle", "time": 13443.51, "timestamp": "03:44:03", "text": "いや、死んでない。"}, {"type": "subtitle", "time": 13444.07, "timestamp": "03:44:04", "text": "やばい。"}, {"type": "subtitle", "time": 13445.99, "timestamp": "03:44:05", "text": "爆撃機を始末しに行かなきゃ。"}, {"type": "subtitle", "time": 13447.99, "timestamp": "03:44:07", "text": "爆撃機を始末するんだ。"}, {"type": "subtitle", "time": 13448.79, "timestamp": "03:44:08", "text": "うん。うん。うん。"}, {"type": "subtitle", "time": 13455.429, "timestamp": "03:44:15", "text": "待って、"}, {"type": "subtitle", "time": 13458.309, "timestamp": "03:44:18", "text": "変な予感がする。"}, {"type": "subtitle", "time": 13460.55, "timestamp": "03:44:20", "text": "待って、何？どこ？どうしてそんなに"}, {"type": "subtitle", "time": 13484.15, "timestamp": "03:44:44", "text": "待って、どうしてそんなに遠くにいるの？"}, {"type": "subtitle", "time": 13486.07, "timestamp": "03:44:46", "text": "爆撃機を相手にしているんだ。だから"}, {"type": "subtitle", "time": 13489.83, "timestamp": "03:44:49", "text": "戻らなきゃ。なんてこった"}, {"type": "subtitle", "time": 13492.15, "timestamp": "03:44:52", "text": "。あっちの方にいて、私の責任だ"}]
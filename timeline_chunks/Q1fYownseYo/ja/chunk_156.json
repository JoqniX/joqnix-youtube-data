[{"type": "subtitle", "time": 9378.07, "timestamp": "02:36:18", "text": "はい、それで3つ取れました。 それで、ああ、"}, {"type": "subtitle", "time": 9380.23, "timestamp": "02:36:20", "text": "終わりました。"}, {"type": "subtitle", "time": 9380.87, "timestamp": "02:36:20", "text": "何？   もう"}, {"type": "subtitle", "time": 9381.83, "timestamp": "02:36:21", "text": "終わりました"}, {"type": "subtitle", "time": 9383.19, "timestamp": "02:36:23", "text": "。"}, {"type": "subtitle", "time": 9385.11, "timestamp": "02:36:25", "text": "ああ、家に帰りなさい。  D."}, {"type": "subtitle", "time": 9386.71, "timestamp": "02:36:26", "text": "待って、待って、待って。 いや、いや、いや、いや、いや。   これからも"}, {"type": "subtitle", "time": 9388.87, "timestamp": "02:36:28", "text": "破壊し続けましょう。"}, {"type": "subtitle", "time": 9390.389, "timestamp": "02:36:30", "text": "リーダーボードを取得できます、"}, {"type": "subtitle", "time": 9393.11, "timestamp": "02:36:33", "text": "ジョック。 何でも。 殺される。"}, {"type": "subtitle", "time": 9393.67, "timestamp": "02:36:33", "text": "いや、まだ"}, {"type": "subtitle", "time": 9395.75, "timestamp": "02:36:35", "text": "モンテストが残っている。 忘れてはいけない。"}, {"type": "subtitle", "time": 9398.07, "timestamp": "02:36:38", "text": "ステラ・モンティストです。"}, {"type": "subtitle", "time": 9398.55, "timestamp": "02:36:38", "text": "知っている。"}, {"type": "subtitle", "time": 9416.07, "timestamp": "02:36:56", "text": "みんなどこにいるの？"}, {"type": "subtitle", "time": 9418.389, "timestamp": "02:36:58", "text": "ここには誰もいません。"}, {"type": "subtitle", "time": 9419.75, "timestamp": "02:36:59", "text": "彼らは医療か"}]
[{"type": "subtitle", "time": 303.84, "timestamp": "00:05:03", "text": "問題に直面しました。 いいえ。それで、ちょっと バグを修正するのに時間を費やして、それから"}, {"type": "subtitle", "time": 308.72, "timestamp": "00:05:08", "text": "バグを修正するのに時間を費やして、それから かなり遅く寝ました。   だから"}, {"type": "subtitle", "time": 313.199, "timestamp": "00:05:13", "text": "かなり遅く寝ました。   だから 今日は、"}, {"type": "subtitle", "time": 316.72, "timestamp": "00:05:16", "text": "今日は、 この時間には朝の配信をする代わりに"}, {"type": "subtitle", "time": 325.189, "timestamp": "00:05:25", "text": "、日本語の試験の復習をするつもりなんだ"}, {"type": "subtitle", "time": 328.95, "timestamp": "00:05:28", "text": "。 午前中に"}, {"type": "subtitle", "time": 331.909, "timestamp": "00:05:31", "text": "少しだけやりました"}, {"type": "subtitle", "time": 334.55, "timestamp": "00:05:34", "text": "。 こんにちは。 とにかく、ゲームに切り替えましょう"}, {"type": "subtitle", "time": 336.55, "timestamp": "00:05:36", "text": "。 あ、景色（音楽）が変わったよ"}, {"type": "subtitle", "time": 340.31, "timestamp": "00:05:40", "text": "。 わかった。"}, {"type": "subtitle", "time": 342.55, "timestamp": "00:05:42", "text": "こんにちは。 クリエイターの新しいアップデートが"}, {"type": "subtitle", "time": 344.31, "timestamp": "00:05:44", "text": "ここにあります。"}, {"type": "subtitle", "time": 348.55, "timestamp": "00:05:48", "text": "そして、ゲームは見られません。"}, {"type": "subtitle", "time": 350.87, "timestamp": "00:05:50", "text": "ああ、そこだ"}, {"type": "subtitle", "time": 354.07, "timestamp": "00:05:54", "text": "。"}, {"type": "subtitle", "time": 356.15, "timestamp": "00:05:56", "text": "聞こえますか？ はい、今は動作しています。"}]
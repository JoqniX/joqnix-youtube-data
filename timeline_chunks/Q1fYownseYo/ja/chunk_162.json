[{"type": "subtitle", "time": 9723.03, "timestamp": "02:42:03", "text": "文字通りクラッシュして、"}, {"type": "subtitle", "time": 9725.67, "timestamp": "02:42:05", "text": "「なぜPvPをしているのですか？これは"}, {"type": "subtitle", "time": 9731.27, "timestamp": "02:42:11", "text": "PvEサーバーの試合のはずです。」と言いたかったのです。"}, {"type": "subtitle", "time": 9733.75, "timestamp": "02:42:13", "text": "おい、これがテレオンティズムだ。"}, {"type": "subtitle", "time": 9737.349, "timestamp": "02:42:17", "text": "慈悲など無い。"}, {"type": "subtitle", "time": 9738.07, "timestamp": "02:42:18", "text": "なぜ？"}, {"type": "subtitle", "time": 9741.67, "timestamp": "02:42:21", "text": "はい、状況によります。 実際のところ、状況によります。   たくさんの"}, {"type": "subtitle", "time": 9745.91, "timestamp": "02:42:25", "text": "良いものを失いました。"}, {"type": "subtitle", "time": 9748.55, "timestamp": "02:42:28", "text": "今、あなたは"}, {"type": "subtitle", "time": 9750.55, "timestamp": "02:42:30", "text": "私の金床のように負けました。"}, {"type": "subtitle", "time": 9757.75, "timestamp": "02:42:37", "text": "実は持っています。待って、あなたも"}, {"type": "subtitle", "time": 9761.19, "timestamp": "02:42:41", "text": "レコーダーをなくしたのですか。 液体。"}, {"type": "subtitle", "time": 9763.75, "timestamp": "02:42:43", "text": "いいえ、私のフルートです。"}, {"type": "subtitle", "time": 9765.51, "timestamp": "02:42:45", "text": "いいえ、"}, {"type": "subtitle", "time": 9769.19, "timestamp": "02:42:49", "text": "シェイカーはまだ持っています。 大丈夫ですよ。"}, {"type": "subtitle", "time": 9771.59, "timestamp": "02:42:51", "text": "あのね？ リロードしましょう。"}, {"type": "subtitle", "time": 9774.012, "timestamp": "02:42:54", "text": "そこに入って人々を殺してください。"}, {"type": "subtitle", "time": 9774.389, "timestamp": "02:42:54", "text": "[笑い] そんなことないよ"}, {"type": "subtitle", "time": 9774.79, "timestamp": "02:42:54", "text": "。"}, {"type": "subtitle", "time": 9777.51, "timestamp": "02:42:57", "text": "そしてポップス。   わかった"}]
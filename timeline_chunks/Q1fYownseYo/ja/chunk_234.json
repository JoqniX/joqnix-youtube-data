[{"type": "subtitle", "time": 14047.51, "timestamp": "03:54:07", "text": "ハマッグにノックアウトされた。わかった、こいつらは"}, {"type": "subtitle", "time": 14057.349, "timestamp": "03:54:17", "text": "ああ、あれはインド人プレイヤーだ。オーケー、"}, {"type": "subtitle", "time": 14059.59, "timestamp": "03:54:19", "text": "兄弟。"}, {"type": "subtitle", "time": 14062.469, "timestamp": "03:54:22", "text": "アジアサーバーは本当に退屈だ。本当に"}, {"type": "subtitle", "time": 14065.67, "timestamp": "03:54:25", "text": "退屈だ。えっと、"}, {"type": "subtitle", "time": 14068.229, "timestamp": "03:54:28", "text": "少なくともリモートレイダープレイヤーの"}, {"type": "subtitle", "time": 14069.99, "timestamp": "03:54:29", "text": "設計図は持っている。L"}, {"type": "subtitle", "time": 14074.95, "timestamp": "03:54:34", "text": "俺が俺を"}, {"type": "subtitle", "time": 14076.95, "timestamp": "03:54:36", "text": "フォローするべきだった。"}, {"type": "subtitle", "time": 14077.269, "timestamp": "03:54:37", "text": "そうだ、お前も"}, {"type": "subtitle", "time": 14078.79, "timestamp": "03:54:38", "text": "俺をフォローするべきだった。"}, {"type": "subtitle", "time": 14082.389, "timestamp": "03:54:42", "text": "爆撃機を倒して、もっと戦利品が手に入った。"}, {"type": "subtitle", "time": 14089.429, "timestamp": "03:54:49", "text": "ああ、まあ、そういうことがあったんだ。"}, {"type": "subtitle", "time": 14096.309, "timestamp": "03:54:56", "text": "俺は特に重要なものは失わない。お前はまあまあだ。クレイジー。もう一回"}]
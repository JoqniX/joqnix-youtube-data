[{"type": "subtitle", "time": 7560.55, "timestamp": "02:06:00", "text": "。"}, {"type": "subtitle", "time": 7563.27, "timestamp": "02:06:03", "text": "そうですが、"}, {"type": "subtitle", "time": 7570.79, "timestamp": "02:06:10", "text": "他のドローンのように大きなライトが付いていないので、見つけるのはかなり困難です。"}, {"type": "subtitle", "time": 7571.91, "timestamp": "02:06:11", "text": "これは何ですか？"}, {"type": "subtitle", "time": 7574.149, "timestamp": "02:06:14", "text": "リーパー。 廃墟となった家。"}, {"type": "subtitle", "time": 7576.31, "timestamp": "02:06:16", "text": "リーパー。"}, {"type": "subtitle", "time": 7578.55, "timestamp": "02:06:18", "text": "あなたがここにいるよ"}, {"type": "subtitle", "time": 7585.51, "timestamp": "02:06:25", "text": "ポッターがたくさんいます。 待ってください、別の"}, {"type": "subtitle", "time": 7588.07, "timestamp": "02:06:28", "text": "岩石マターがあります。"}, {"type": "subtitle", "time": 7590.229, "timestamp": "02:06:30", "text": "ああ、なぜ爆弾がこんなにたくさんあるんだ？"}, {"type": "subtitle", "time": 7596.629, "timestamp": "02:06:36", "text": "誰かが抽出された誰かです。   ああ"}, {"type": "subtitle", "time": 7600.39, "timestamp": "02:06:40", "text": "、男の人がいます。"}]
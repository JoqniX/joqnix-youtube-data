[{"type": "subtitle", "time": 13508.07, "timestamp": "03:45:08", "text": "まずはこっちを試してみよう。"}, {"type": "subtitle", "time": 13523.189, "timestamp": "03:45:23", "text": "、また死んだ。"}, {"type": "subtitle", "time": 13526.469, "timestamp": "03:45:26", "text": "ああ、頼むよ。私はこんなに遠くにいる。私は今"}, {"type": "subtitle", "time": 13527.99, "timestamp": "03:45:27", "text": "この瞬間を生き延びているんだ。"}, {"type": "subtitle", "time": 13530.469, "timestamp": "03:45:30", "text": "じっとしていて。生存者はいるよね？"}, {"type": "subtitle", "time": 13532.07, "timestamp": "03:45:32", "text": "いや、いない。しまった"}, {"type": "subtitle", "time": 13532.55, "timestamp": "03:45:32", "text": "。"}, {"type": "subtitle", "time": 13535.189, "timestamp": "03:45:35", "text": "ああ、誰かが本当に私を蘇生させてくれた。"}, {"type": "subtitle", "time": 13535.75, "timestamp": "03:45:35", "text": "ありがとう。"}, {"type": "subtitle", "time": 13542.229, "timestamp": "03:45:42", "text": "ああ、シールドが壊れた。えっと、待って。"}]
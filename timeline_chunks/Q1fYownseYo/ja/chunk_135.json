[{"type": "subtitle", "time": 8105.75, "timestamp": "02:15:05", "text": "ああ、私はそれが私にそのように襲い掛かるとは思っていませんでした。"}, {"type": "subtitle", "time": 8112.55, "timestamp": "02:15:12", "text": "今すぐ植えなさい。 さあ、さあ、さあ。 わかった。 わかった。 わかった"}, {"type": "subtitle", "time": 8114.39, "timestamp": "02:15:14", "text": "。"}, {"type": "subtitle", "time": 8115.83, "timestamp": "02:15:15", "text": "ああ、いいですね。"}, {"type": "subtitle", "time": 8124.87, "timestamp": "02:15:24", "text": "、ジョック。 そしてあなたは私をすぐに生き返らせてくれました"}, {"type": "subtitle", "time": 8128.069, "timestamp": "02:15:28", "text": "。 どこ？ どこ？ どこ？"}, {"type": "subtitle", "time": 8130.069, "timestamp": "02:15:30", "text": "どこにいるの？"}, {"type": "subtitle", "time": 8132.229, "timestamp": "02:15:32", "text": "私はここにいます。 私はここにいます。"}, {"type": "subtitle", "time": 8134.47, "timestamp": "02:15:34", "text": "私は道路の真ん中にいます。   何てことだ"}, {"type": "subtitle", "time": 8135.669, "timestamp": "02:15:35", "text": "。   そうですよ。"}, {"type": "subtitle", "time": 8140.47, "timestamp": "02:15:40", "text": "ああ、どこでやったんですか？"}, {"type": "subtitle", "time": 8142.55, "timestamp": "02:15:42", "text": "実際どうやってやったんですか？"}, {"type": "subtitle", "time": 8146.47, "timestamp": "02:15:46", "text": "ああ、ドローンを気絶させればいい。 そして"}, {"type": "subtitle", "time": 8148.069, "timestamp": "02:15:48", "text": "ロケット打ち上げが終わったら、"}, {"type": "subtitle", "time": 8149.43, "timestamp": "02:15:49", "text": "墜落するんですよね？"}, {"type": "subtitle", "time": 8151.669, "timestamp": "02:15:51", "text": "地面に飛んでいきます。 そして、"}, {"type": "subtitle", "time": 8152.709, "timestamp": "02:15:52", "text": "登って"}, {"type": "subtitle", "time": 8155.83, "timestamp": "02:15:55", "text": "撮影し、デッドラインを設定するだけです。"}, {"type": "subtitle", "time": 8158.709, "timestamp": "02:15:58", "text": "実際に期限を設定します。 うん。"}]
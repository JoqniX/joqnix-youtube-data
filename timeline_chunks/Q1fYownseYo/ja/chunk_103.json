[{"type": "subtitle", "time": 6187.43, "timestamp": "01:43:07", "text": "ハルク"}, {"type": "subtitle", "time": 6189.75, "timestamp": "01:43:09", "text": "クラッカーを買って入手し、ロケッティアにダメージを与えた方が良いのではないですか?"}, {"type": "subtitle", "time": 6208.55, "timestamp": "01:43:28", "text": "はい、もちろん参加できます。 入って。"}, {"type": "subtitle", "time": 6210.55, "timestamp": "01:43:30", "text": "ディオ。"}, {"type": "subtitle", "time": 6213.43, "timestamp": "01:43:33", "text": "うん。 参加してください。参加してください。どれくらいですか? でも、もう終わらせなきゃ"}, {"type": "subtitle", "time": 6217.43, "timestamp": "01:43:37", "text": "。 大丈夫ですよ。"}, {"type": "subtitle", "time": 6219.59, "timestamp": "01:43:39", "text": "大丈夫ですよ。 入って来れますよ。入って来れますよ。まだ"}, {"type": "subtitle", "time": 6222.79, "timestamp": "01:43:42", "text": "遊んでないんです。 うん。   私も"}, {"type": "subtitle", "time": 6229.59, "timestamp": "01:43:49", "text": "ああ、わかりました"}]
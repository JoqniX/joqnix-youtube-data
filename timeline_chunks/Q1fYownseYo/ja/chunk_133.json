[{"type": "subtitle", "time": 7981.43, "timestamp": "02:13:01", "text": "スニッチが再びトップに。"}, {"type": "subtitle", "time": 7984.629, "timestamp": "02:13:04", "text": "ロケット発射者を一度撃って、私のところに来てください"}, {"type": "subtitle", "time": 7993.75, "timestamp": "02:13:13", "text": "、ちょっと待ってください。 こちらへ来ています。 えっと、"}, {"type": "subtitle", "time": 7995.83, "timestamp": "02:13:15", "text": "どこですか？ 何だって？"}, {"type": "subtitle", "time": 7999.91, "timestamp": "02:13:19", "text": "待って、この位置は悪い。 えっと、"}, {"type": "subtitle", "time": 8001.99, "timestamp": "02:13:21", "text": "どの部屋で"}, {"type": "subtitle", "time": 8012.55, "timestamp": "02:13:32", "text": "はい、これには屋根がありません。 ああ、"}, {"type": "subtitle", "time": 8014.95, "timestamp": "02:13:34", "text": "建物の中に立ってればいいと思いますよ。   わかった"}, {"type": "subtitle", "time": 8015.76, "timestamp": "02:13:35", "text": "。   わかった 。 撃って下さい。 撃てますか？ それは"}, {"type": "subtitle", "time": 8017.44, "timestamp": "02:13:37", "text": "。 撃って下さい。 撃てますか？ それは 私に来ています。"}, {"type": "subtitle", "time": 8017.84, "timestamp": "02:13:37", "text": "私に来ています。 どこですか？ どこですか？ どこですか？"}, {"type": "subtitle", "time": 8019.199, "timestamp": "02:13:39", "text": "どこですか？ どこですか？ どこですか？ マーク。"}, {"type": "subtitle", "time": 8020.719, "timestamp": "02:13:40", "text": "マーク。 ああ、見えました。"}, {"type": "subtitle", "time": 8022.159, "timestamp": "02:13:42", "text": "ああ、見えました。 頭の上みたいに。 見えますか？"}, {"type": "subtitle", "time": 8025.76, "timestamp": "02:13:45", "text": "頭の上みたいに。 見えますか？ ああ、いい加減にしてくれ。 スズメバチがいます。"}, {"type": "subtitle", "time": 8036.709, "timestamp": "02:13:56", "text": "私は死んだ。 私は死んだ。 ああ、あなたは死んでいませんよ。"}]
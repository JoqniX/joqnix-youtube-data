[{"type": "subtitle", "time": 2405.589, "timestamp": "00:40:05", "text": "アークオービターが飛行中です。 安全ウィンドウが"}, {"type": "subtitle", "time": 2408.15, "timestamp": "00:40:08", "text": "閉じています。 そこから出るまで10分"}, {"type": "subtitle", "time": 2408.87, "timestamp": "00:40:08", "text": "。"}, {"type": "subtitle", "time": 2417.27, "timestamp": "00:40:17", "text": "ここに行かなきゃいけないんだね？ 東側のエレベーターで家に帰ります"}, {"type": "subtitle", "time": 2433.51, "timestamp": "00:40:33", "text": "場所がわかったので、いつでも"}, {"type": "subtitle", "time": 2454.31, "timestamp": "00:40:54", "text": "1つ必要になると思います。   もう"}]
[{"type": "subtitle", "time": 15489.03, "timestamp": "04:18:09", "text": "やったー。"}, {"type": "subtitle", "time": 15499.189, "timestamp": "04:18:19", "text": "ヘイ、アレクサ、一緒に出発して。"}, {"type": "subtitle", "time": 15500.87, "timestamp": "04:18:20", "text": "ちょっと待って。このロケットを略奪する"}, {"type": "subtitle", "time": 15518.389, "timestamp": "04:18:38", "text": "あの、えーと、"}, {"type": "subtitle", "time": 15520.149, "timestamp": "04:18:40", "text": "ハッチの鍵はどこだ？"}, {"type": "subtitle", "time": 15528.79, "timestamp": "04:18:48", "text": "念のため。"}, {"type": "subtitle", "time": 15530.87, "timestamp": "04:18:50", "text": "ほら、少なくともこのクソサーバーでは、"}, {"type": "subtitle", "time": 15533.99, "timestamp": "04:18:53", "text": "みんなが話してんじゃねえか。ああ"}]
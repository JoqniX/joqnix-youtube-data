[{"type": "subtitle", "time": 9785.429, "timestamp": "02:43:05", "text": "でも、私たちは主にポップスをやります。 うん。"}, {"type": "subtitle", "time": 9787.99, "timestamp": "02:43:07", "text": "しかし、もし人を殺したら、"}, {"type": "subtitle", "time": 9790.63, "timestamp": "02:43:10", "text": "悪いロビーに送り込まれることになるでしょう。 ただし、PVP では私より劣ります"}, {"type": "subtitle", "time": 9792.07, "timestamp": "02:43:12", "text": "。"}, {"type": "subtitle", "time": 9794.972, "timestamp": "02:43:14", "text": "いや、そうでもないよ。 私はいつも人を殺しています。"}, {"type": "subtitle", "time": 9796.309, "timestamp": "02:43:16", "text": "[笑い]"}, {"type": "subtitle", "time": 9799.99, "timestamp": "02:43:19", "text": "それが私ですか？ 我々は殺されつつある。   わから"}, {"type": "subtitle", "time": 9800.71, "timestamp": "02:43:20", "text": "ない。"}, {"type": "subtitle", "time": 9802.389, "timestamp": "02:43:22", "text": "いいえ、いつもではありません"}, {"type": "subtitle", "time": 9804.309, "timestamp": "02:43:24", "text": "。 私は私を撃った人だけを殺す"}, {"type": "subtitle", "time": 9806.71, "timestamp": "02:43:26", "text": "。"}, {"type": "subtitle", "time": 9812.07, "timestamp": "02:43:32", "text": "新しい記事か何かで悪魔がそれについて何か言っていたことを忘れていました。"}, {"type": "subtitle", "time": 9813.429, "timestamp": "02:43:33", "text": "本当に？   どのように"}, {"type": "subtitle", "time": 9825.75, "timestamp": "02:43:45", "text": "他人を撃ったりしない限り、あなたを"}, {"type": "subtitle", "time": 9828.23, "timestamp": "02:43:48", "text": "撃ったりするプレイヤーと一緒になることはありません"}, {"type": "subtitle", "time": 9830.79, "timestamp": "02:43:50", "text": "。 わからない。 運が"}, {"type": "subtitle", "time": 9839.59, "timestamp": "02:43:59", "text": "でも、PvP は好きで、"}]
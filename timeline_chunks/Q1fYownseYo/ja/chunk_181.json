[{"type": "subtitle", "time": 10861.51, "timestamp": "03:01:01", "text": "？"}, {"type": "subtitle", "time": 10861.83, "timestamp": "03:01:01", "text": "うん。"}, {"type": "subtitle", "time": 10876.15, "timestamp": "03:01:16", "text": "だから私の場合、ダメージはスズメバチと"}, {"type": "subtitle", "time": 10879.83, "timestamp": "03:01:19", "text": "キャリアボスに残ります。"}, {"type": "subtitle", "time": 10881.59, "timestamp": "03:01:21", "text": "ニース。   その他すべて"}, {"type": "subtitle", "time": 10884.07, "timestamp": "03:01:24", "text": "必要です。"}, {"type": "subtitle", "time": 10893.11, "timestamp": "03:01:33", "text": "しかし、私はすでに地図を手に入れました。   そうねぇ"}, {"type": "subtitle", "time": 10906.309, "timestamp": "03:01:46", "text": "。 ああ、ちょうど"}, {"type": "subtitle", "time": 10909.83, "timestamp": "03:01:49", "text": "街への夜襲だったんだ。"}, {"type": "subtitle", "time": 10913.99, "timestamp": "03:01:53", "text": "バーシティ。 ああ、わかりました。 しかし、市は大丈夫です。"}, {"type": "subtitle", "time": 10918.309, "timestamp": "03:01:58", "text": "無料でやりたいのか、それともちょっと見せてくれ"}]
[{"type": "subtitle", "time": 3911.91, "timestamp": "01:05:11", "text": "私はここで死にそうです"}, {"type": "subtitle", "time": 3931.67, "timestamp": "01:05:31", "text": "、彼らは振り返っています。"}, {"type": "subtitle", "time": 3939.67, "timestamp": "01:05:39", "text": "もし手榴弾を持っていたら、いや、"}, {"type": "subtitle", "time": 3941.91, "timestamp": "01:05:41", "text": "二人とも殺して、その"}, {"type": "subtitle", "time": 3945.349, "timestamp": "01:05:45", "text": "日はそれで終わりにして撤退できただろう。"}]
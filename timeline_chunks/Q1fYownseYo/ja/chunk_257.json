[{"type": "subtitle", "time": 15421.429, "timestamp": "04:17:01", "text": "ああ。そう？"}, {"type": "subtitle", "time": 15423.99, "timestamp": "04:17:03", "text": "いや、こいつじゃない。こいつはもう"}, {"type": "subtitle", "time": 15426.149, "timestamp": "04:17:06", "text": "略奪されてる。"}, {"type": "subtitle", "time": 15430.55, "timestamp": "04:17:10", "text": "えーと、見てみよう。何かある。いや。"}, {"type": "subtitle", "time": 15433.189, "timestamp": "04:17:13", "text": "ああ、ハッチの鍵がある。"}, {"type": "subtitle", "time": 15453.99, "timestamp": "04:17:33", "text": "ああ、出発しよう。出発しよう。"}, {"type": "subtitle", "time": 15455.269, "timestamp": "04:17:35", "text": "これは違う 奴。この男の言う通りだ。"}, {"type": "subtitle", "time": 15456.71, "timestamp": "04:17:36", "text": "ああ、この男。"}, {"type": "subtitle", "time": 15459.349, "timestamp": "04:17:39", "text": "いや、いや、いや。奴じゃない。奴じゃない。"}, {"type": "subtitle", "time": 15461.75, "timestamp": "04:17:41", "text": "そんなことしないで。なんてこった。"}, {"type": "subtitle", "time": 15464.149, "timestamp": "04:17:44", "text": "奴らは君を殺す。"}, {"type": "subtitle", "time": 15469.59, "timestamp": "04:17:49", "text": "さあ、さあ、さあ。出発しよう。出発しよう"}, {"type": "subtitle", "time": 15471.59, "timestamp": "04:17:51", "text": "。出発しよう。えーと、ロケットがここにある。"}, {"type": "subtitle", "time": 15473.04, "timestamp": "04:17:53", "text": "ロケットがここにある。 ああ、ここ。"}, {"type": "subtitle", "time": 15474.0, "timestamp": "04:17:54", "text": "ああ、ここ。 この人たちを助けよう。"}]
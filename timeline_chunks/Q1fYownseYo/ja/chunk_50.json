[{"type": "subtitle", "time": 3001.51, "timestamp": "00:50:01", "text": "。 ただ試行錯誤して設計図を手に入れただけです"}, {"type": "subtitle", "time": 3006.39, "timestamp": "00:50:06", "text": "。 何？"}, {"type": "subtitle", "time": 3008.79, "timestamp": "00:50:08", "text": "何？   何てことだ"}, {"type": "subtitle", "time": 3012.79, "timestamp": "00:50:12", "text": "。 ニース。 こんにちは、ソーラー。   何てことだ"}, {"type": "subtitle", "time": 3016.63, "timestamp": "00:50:16", "text": "。 アマンを手に入れたぞ、"}, {"type": "subtitle", "time": 3018.47, "timestamp": "00:50:18", "text": "兄弟。"}, {"type": "subtitle", "time": 3041.109, "timestamp": "00:50:41", "text": "、待ってください。 えーと、"}, {"type": "subtitle", "time": 3051.349, "timestamp": "00:50:51", "text": "が、ライトを作ることはできます。 そうだ、行こう"}]
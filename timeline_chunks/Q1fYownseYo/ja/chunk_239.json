[{"type": "subtitle", "time": 14343.189, "timestamp": "03:59:03", "text": "でも、まあ、ゲームってそういうものだよね？"}, {"type": "subtitle", "time": 14350.309, "timestamp": "03:59:10", "text": "よし、盾を持ってこよう。念の"}, {"type": "subtitle", "time": 14359.51, "timestamp": "03:59:19", "text": "防御が外れた時のためだ。"}, {"type": "subtitle", "time": 14384.309, "timestamp": "03:59:44", "text": "家長じゃない。"}, {"type": "subtitle", "time": 14386.63, "timestamp": "03:59:46", "text": "ああ、もう終わったと思う。"}, {"type": "subtitle", "time": 14390.229, "timestamp": "03:59:50", "text": "待って、ハーベスターって一体何をするんだ？"}, {"type": "subtitle", "time": 14392.15, "timestamp": "03:59:52", "text": "女王だ。"}, {"type": "subtitle", "time": 14393.51, "timestamp": "03:59:53", "text": "ああ、"}, {"type": "subtitle", "time": 14396.389, "timestamp": "03:59:56", "text": "女王が守っている広い場所がある"}, {"type": "subtitle", "time": 14398.15, "timestamp": "03:59:58", "text": "。戦利品がたくさんある。"}]
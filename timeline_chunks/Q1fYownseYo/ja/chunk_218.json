[{"type": "subtitle", "time": 13085.269, "timestamp": "03:38:05", "text": "どうしてこんなに頑丈なんだ？たぶん"}, {"type": "subtitle", "time": 13097.19, "timestamp": "03:38:17", "text": "あそこに行きたい。来る"}, {"type": "subtitle", "time": 13103.51, "timestamp": "03:38:23", "text": "何？"}, {"type": "subtitle", "time": 13106.95, "timestamp": "03:38:26", "text": "どこにいるんだ？俺の番だ。一体"}, {"type": "subtitle", "time": 13109.51, "timestamp": "03:38:29", "text": "何なんだ？どうしてミスった？"}, {"type": "subtitle", "time": 13110.95, "timestamp": "03:38:30", "text": "ああ、ロケットを壊してるんだ。わかった、わかった、わかった"}, {"type": "subtitle", "time": 13113.349, "timestamp": "03:38:33", "text": "、わかった。じゃあ、ああ、"}, {"type": "subtitle", "time": 13131.99, "timestamp": "03:38:51", "text": "カチカチ音は？"}, {"type": "subtitle", "time": 13134.07, "timestamp": "03:38:54", "text": "馬鹿なカチカチ音。誓って、 クソみたいなのが嫌いだ"}]
[{"type": "subtitle", "time": 8402.07, "timestamp": "02:20:02", "text": "。  [笑い]"}, {"type": "subtitle", "time": 8404.23, "timestamp": "02:20:04", "text": "待ってください、違います。 待って、やめてよ。"}, {"type": "subtitle", "time": 8406.07, "timestamp": "02:20:06", "text": "ただし、撃ったり、そうしたりするとジャンプします"}, {"type": "subtitle", "time": 8407.99, "timestamp": "02:20:07", "text": "。 挑戦してみたいと思います。"}, {"type": "subtitle", "time": 8410.87, "timestamp": "02:20:10", "text": "うん。 テレビは本当に犠牲になりたい。   たった"}, {"type": "subtitle", "time": 8412.07, "timestamp": "02:20:12", "text": "5分しかありません。"}, {"type": "subtitle", "time": 8414.872, "timestamp": "02:20:14", "text": "何が怖かったの？ はぁ？ 怖いですか？"}, {"type": "subtitle", "time": 8426.07, "timestamp": "02:20:26", "text": "。 そしてスポーツ選手たちに"}, {"type": "subtitle", "time": 8432.55, "timestamp": "02:20:32", "text": "あなたを見せて、それからスズメバチを呼ばせましょう。"}, {"type": "subtitle", "time": 8435.429, "timestamp": "02:20:35", "text": "ネタバレだけ言っておきます"}, {"type": "subtitle", "time": 8438.309, "timestamp": "02:20:38", "text": "。 それはあなたに"}, {"type": "subtitle", "time": 8439.349, "timestamp": "02:20:39", "text": "スズメバチを与えるでしょう。"}, {"type": "subtitle", "time": 8441.67, "timestamp": "02:20:41", "text": "うん。"}, {"type": "subtitle", "time": 8444.95, "timestamp": "02:20:44", "text": "ネタバレではありません。 ああ、密告者。 まるで"}, {"type": "subtitle", "time": 8448.469, "timestamp": "02:20:48", "text": "密告者のような気分ですよね？"}, {"type": "subtitle", "time": 8451.27, "timestamp": "02:20:51", "text": "そうだ、密告者。   それだけですか"}, {"type": "subtitle", "time": 8451.75, "timestamp": "02:20:51", "text": "？"}, {"type": "subtitle", "time": 8459.91, "timestamp": "02:20:59", "text": "家に帰りましょう。"}]
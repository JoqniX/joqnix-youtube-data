[{"type": "subtitle", "time": 12134.07, "timestamp": "03:22:14", "text": "待って、待って。 落ち着け、落ち着け、落ち着け、落ち着け、"}, {"type": "subtitle", "time": 12137.349, "timestamp": "03:22:17", "text": "落ち着け。 私たちはただ女家長的なことをしているだけです。"}, {"type": "subtitle", "time": 12139.75, "timestamp": "03:22:19", "text": "おい、撃たないで。"}, {"type": "subtitle", "time": 12148.309, "timestamp": "03:22:28", "text": "待ってください、彼は本当に人を殺しているんです。"}, {"type": "subtitle", "time": 12149.59, "timestamp": "03:22:29", "text": "そうだ、彼らは殺している。"}, {"type": "subtitle", "time": 12151.349, "timestamp": "03:22:31", "text": "撃たないでください。"}, {"type": "subtitle", "time": 12152.469, "timestamp": "03:22:32", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 12154.229, "timestamp": "03:22:34", "text": "おい、撃たないで。 私たちはただ女"}, {"type": "subtitle", "time": 12165.99, "timestamp": "03:22:45", "text": "べきでしょうか？"}, {"type": "subtitle", "time": 12167.429, "timestamp": "03:22:47", "text": "いいえ、ただ"}, {"type": "subtitle", "time": 12172.229, "timestamp": "03:22:52", "text": "家を出てください。"}, {"type": "subtitle", "time": 12173.75, "timestamp": "03:22:53", "text": "ハッチの鍵を持っています。"}, {"type": "subtitle", "time": 12175.19, "timestamp": "03:22:55", "text": "誰かの近くにあるハッチキーを私に知らせてください。"}]
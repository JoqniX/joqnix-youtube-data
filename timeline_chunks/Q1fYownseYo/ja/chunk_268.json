[{"type": "subtitle", "time": 16093.59, "timestamp": "04:28:13", "text": "とにかく、こんにちは。 えーと、"}, {"type": "subtitle", "time": 16107.99, "timestamp": "04:28:27", "text": "今夜は試合ができて本当によかったです。"}, {"type": "subtitle", "time": 16110.87, "timestamp": "04:28:30", "text": "明日って、あぁもう15日だ。 さて、"}, {"type": "subtitle", "time": 16113.83, "timestamp": "04:28:33", "text": "今日が私にとって最後の日になります。"}, {"type": "subtitle", "time": 16115.59, "timestamp": "04:28:35", "text": "つまり、明日はそこに行きます。"}, {"type": "subtitle", "time": 16119.11, "timestamp": "04:28:39", "text": "実際に配信するかどうかは分かりません。"}, {"type": "subtitle", "time": 16122.79, "timestamp": "04:28:42", "text": "明日の夜は旅行に行きます。 おそらく"}, {"type": "subtitle", "time": 16126.07, "timestamp": "04:28:46", "text": "明日の夜か土曜日には"}, {"type": "subtitle", "time": 16128.149, "timestamp": "04:28:48", "text": "旅行に行きます。"}, {"type": "subtitle", "time": 16136.07, "timestamp": "04:28:56", "text": "、試験とか、"}, {"type": "subtitle", "time": 16138.71, "timestamp": "04:28:58", "text": "復習しなきゃいけないこととか。"}]
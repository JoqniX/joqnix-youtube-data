[{"type": "subtitle", "time": 5649.51, "timestamp": "01:34:09", "text": "待って、どこに落としたっけ"}, {"type": "subtitle", "time": 5685.43, "timestamp": "01:34:45", "text": "ああ、歩哨が来たよ。"}, {"type": "subtitle", "time": 5689.189, "timestamp": "01:34:49", "text": "あれは番兵ですよね？"}, {"type": "subtitle", "time": 5692.55, "timestamp": "01:34:52", "text": "私はそれと戦いたいのです。   何てことだ"}, {"type": "subtitle", "time": 5694.39, "timestamp": "01:34:54", "text": "。 それで、"}, {"type": "subtitle", "time": 5697.83, "timestamp": "01:34:57", "text": "今日は鍵をいくつもらえるんですか?"}]
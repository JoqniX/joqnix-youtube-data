[{"type": "subtitle", "time": 13861.67, "timestamp": "03:51:01", "text": "ああ、頼む。フェンスがあるじゃないか。ちくしょう、"}, {"type": "subtitle", "time": 13865.349, "timestamp": "03:51:05", "text": "あそこまで這って行くのに。"}, {"type": "subtitle", "time": 13870.95, "timestamp": "03:51:10", "text": "みんな知らないんだ。"}, {"type": "subtitle", "time": 13873.349, "timestamp": "03:51:13", "text": "ゲームの遊び方。ちくしょう。"}, {"type": "subtitle", "time": 13881.83, "timestamp": "03:51:21", "text": "よし、来てくれ。俺は…"}, {"type": "subtitle", "time": 13890.229, "timestamp": "03:51:30", "text": "ああ、実は誰かが締め切りを設定したんだ"}, {"type": "subtitle", "time": 13895.75, "timestamp": "03:51:35", "text": "ああ、"}, {"type": "subtitle", "time": 13897.51, "timestamp": "03:51:37", "text": "終わったの？終わってない。終わったんだ。終わった。終わったんだ"}, {"type": "subtitle", "time": 13899.11, "timestamp": "03:51:39", "text": "。"}, {"type": "subtitle", "time": 13901.83, "timestamp": "03:51:41", "text": "実は終わったんだ。略奪。略奪。略奪。略奪。略奪。略奪。行け。略奪"}, {"type": "subtitle", "time": 13913.11, "timestamp": "03:51:53", "text": "、爆弾はまだ生きている"}, {"type": "subtitle", "time": 13914.71, "timestamp": "03:51:54", "text": "。気をつけろ。"}, {"type": "subtitle", "time": 13917.269, "timestamp": "03:51:57", "text": "ここには何もないぞ。よし、手に入れた。はい。はい。はい"}]
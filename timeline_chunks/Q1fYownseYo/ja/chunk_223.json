[{"type": "subtitle", "time": 13381.269, "timestamp": "03:43:01", "text": "。"}, {"type": "subtitle", "time": 13383.349, "timestamp": "03:43:03", "text": "全員。 奴は隠れている。"}, {"type": "subtitle", "time": 13384.07, "timestamp": "03:43:04", "text": "うん。 わかった"}, {"type": "subtitle", "time": 13385.51, "timestamp": "03:43:05", "text": "。 あの"}, {"type": "subtitle", "time": 13389.349, "timestamp": "03:43:09", "text": "忌々しい爆撃機を殺さなきゃ。 どこだ？"}, {"type": "subtitle", "time": 13391.51, "timestamp": "03:43:11", "text": "あれは本当に厄介な奴だ。 わかった"}, {"type": "subtitle", "time": 13393.51, "timestamp": "03:43:13", "text": "、ここ。"}, {"type": "subtitle", "time": 13395.67, "timestamp": "03:43:15", "text": "殺さなきゃ。"}, {"type": "subtitle", "time": 13400.229, "timestamp": "03:43:20", "text": "あぁ、死んだ。 待って、待って。 こっちに来て。"}, {"type": "subtitle", "time": 13402.309, "timestamp": "03:43:22", "text": "死んでる？"}, {"type": "subtitle", "time": 13405.03, "timestamp": "03:43:25", "text": "誰かいる？"}, {"type": "subtitle", "time": 13405.269, "timestamp": "03:43:25", "text": "あぁ、"}, {"type": "subtitle", "time": 13407.03, "timestamp": "03:43:27", "text": "奴は俺からだ。 わかった"}, {"type": "subtitle", "time": 13432.469, "timestamp": "03:43:52", "text": "[叫び声]"}, {"type": "subtitle", "time": 13433.349, "timestamp": "03:43:53", "text": "あぁ、死んでる。"}, {"type": "subtitle", "time": 13434.469, "timestamp": "03:43:54", "text": "あぁ、"}, {"type": "subtitle", "time": 13436.07, "timestamp": "03:43:56", "text": "いや。死んでない。 誰かが"}, {"type": "subtitle", "time": 13437.189, "timestamp": "03:43:57", "text": "期限を設定したんだ。"}]
[{"type": "subtitle", "time": 12847.83, "timestamp": "03:34:07", "text": "あらまあ、"}, {"type": "subtitle", "time": 12851.51, "timestamp": "03:34:11", "text": "ああ、何だ？彼は今よけたの？"}, {"type": "subtitle", "time": 12855.59, "timestamp": "03:34:15", "text": "彼はただ クソが俺のを避けた。何？"}, {"type": "subtitle", "time": 12858.15, "timestamp": "03:34:18", "text": "すごく変だ。他の人が"}, {"type": "subtitle", "time": 12860.63, "timestamp": "03:34:20", "text": "戦っているのが見える、それとも俺たちだけか。あれは俺だと"}, {"type": "subtitle", "time": 12864.15, "timestamp": "03:34:24", "text": "思う。ああ、俺だけ。"}, {"type": "subtitle", "time": 12872.95, "timestamp": "03:34:32", "text": "。見て、引っかかってる。ああ、いいね。"}]
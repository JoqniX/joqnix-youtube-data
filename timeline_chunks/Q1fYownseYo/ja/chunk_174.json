[{"type": "subtitle", "time": 10440.63, "timestamp": "02:54:00", "text": "走れ。   何てことだ"}, {"type": "subtitle", "time": 10443.99, "timestamp": "02:54:03", "text": "。 主よ、私だけを。  [笑い]"}, {"type": "subtitle", "time": 10454.15, "timestamp": "02:54:14", "text": "包帯も何も持っていません。"}, {"type": "subtitle", "time": 10458.15, "timestamp": "02:54:18", "text": "シュレッダーがない限り、それはあなたのところにやって来ます"}, {"type": "subtitle", "time": 10458.71, "timestamp": "02:54:18", "text": "。手放してください。   あの"}, {"type": "subtitle", "time": 10467.011, "timestamp": "02:54:27", "text": "どこですか？ ドアのすぐ後ろにあります。"}, {"type": "subtitle", "time": 10467.19, "timestamp": "02:54:27", "text": "[笑い]"}, {"type": "subtitle", "time": 10469.429, "timestamp": "02:54:29", "text": "そうですね。"}, {"type": "subtitle", "time": 10471.75, "timestamp": "02:54:31", "text": "待って。 えっと、もう行かなきゃいけないんですよね"}, {"type": "subtitle", "time": 10474.55, "timestamp": "02:54:34", "text": "？ えっと、"}, {"type": "subtitle", "time": 10476.55, "timestamp": "02:54:36", "text": "これを持って行った方がいいですか？   ああ、"}, {"type": "subtitle", "time": 10481.11, "timestamp": "02:54:41", "text": "でも、ちょっと待ってください"}, {"type": "subtitle", "time": 10482.71, "timestamp": "02:54:42", "text": "。 はい。"}, {"type": "subtitle", "time": 10485.67, "timestamp": "02:54:45", "text": "シャッターが問題になりそうです。   気をそらすことはでき"}, {"type": "subtitle", "time": 10498.55, "timestamp": "02:54:58", "text": "ああ、どこかへ行ってしまった。"}]
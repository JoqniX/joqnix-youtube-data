[{"type": "subtitle", "time": 8940.63, "timestamp": "02:29:00", "text": "金属ポッドは持っていません。 ああ、お金がない"}, {"type": "subtitle", "time": 8951.19, "timestamp": "02:29:11", "text": "包帯をもっと。 ただあなたが何を"}, {"type": "subtitle", "time": 8952.79, "timestamp": "02:29:12", "text": "望んでいるのか教えてください。"}, {"type": "subtitle", "time": 8956.389, "timestamp": "02:29:16", "text": "ああ、私もお金がないんです。 包帯も作れない"}, {"type": "subtitle", "time": 8969.349, "timestamp": "02:29:29", "text": "。"}, {"type": "subtitle", "time": 8973.75, "timestamp": "02:29:33", "text": "ああ、リヴァイアサンはノーと言ったんだ。 ニース。"}, {"type": "subtitle", "time": 8975.59, "timestamp": "02:29:35", "text": "うん。"}, {"type": "subtitle", "time": 8979.99, "timestamp": "02:29:39", "text": "スコープを忘れました。"}, {"type": "subtitle", "time": 8993.51, "timestamp": "02:29:53", "text": "ステラモンテスの"}, {"type": "subtitle", "time": 8997.429, "timestamp": "02:29:57", "text": "デュオを試したことがなかったらよかったのにと思います。 一緒に試してみたことはありますか？"}]
[{"type": "subtitle", "time": 13300.15, "timestamp": "03:41:40", "text": "クラッカー全部出しちゃった。えーと、"}, {"type": "subtitle", "time": 13301.99, "timestamp": "03:41:41", "text": "誰かが話している。撃つなと言ってくれ。"}, {"type": "subtitle", "time": 13312.71, "timestamp": "03:41:52", "text": "こんにちは。こんにちは。ああ。"}, {"type": "subtitle", "time": 13317.11, "timestamp": "03:41:57", "text": "日本語が聞こえた。"}, {"type": "subtitle", "time": 13317.75, "timestamp": "03:41:57", "text": "ああ、なんてこった。 俺が"}]
[{"type": "subtitle", "time": 16620.551, "timestamp": "04:37:00", "text": "嫌だ。 ストリーマーボット。 どう"}, {"type": "subtitle", "time": 16624.39, "timestamp": "04:37:04", "text": "したの？ ああ、それは"}, {"type": "subtitle", "time": 16641.83, "timestamp": "04:37:21", "text": "再実行シムをやめてください。 ええ、私が"}, {"type": "subtitle", "time": 16645.67, "timestamp": "04:37:25", "text": "24x7 チャンネルをやっているのには理由があります。   ああ、そうだね、"}, {"type": "subtitle", "time": 16651.75, "timestamp": "04:37:31", "text": "ビデオですでに説明したよ"}, {"type": "subtitle", "time": 16653.349, "timestamp": "04:37:33", "text": "。"}, {"type": "subtitle", "time": 16655.67, "timestamp": "04:37:35", "text": "つまり、"}, {"type": "subtitle", "time": 16660.709, "timestamp": "04:37:40", "text": "古いストリームを視聴したい人向けです。"}, {"type": "subtitle", "time": 16663.109, "timestamp": "04:37:43", "text": "えっと、だから別のチャンネルで作られているんです"}, {"type": "subtitle", "time": 16664.629, "timestamp": "04:37:44", "text": "。"}, {"type": "subtitle", "time": 16668.23, "timestamp": "04:37:48", "text": "誰もそれを見る権利も義務も強制もされません"}, {"type": "subtitle", "time": 16670.629, "timestamp": "04:37:50", "text": "。"}, {"type": "subtitle", "time": 16673.429, "timestamp": "04:37:53", "text": "これをバックグラウンドのノイズとして使用し"}, {"type": "subtitle", "time": 16676.47, "timestamp": "04:37:56", "text": "、"}]
[{"type": "subtitle", "time": 10386.87, "timestamp": "02:53:06", "text": "下に誰かいる。 あそこだよ。 あそこだよ"}, {"type": "subtitle", "time": 10388.87, "timestamp": "02:53:08", "text": "。 わからない。"}, {"type": "subtitle", "time": 10392.15, "timestamp": "02:53:12", "text": "一体どこだ？ あれは君なのか？"}, {"type": "subtitle", "time": 10393.91, "timestamp": "02:53:13", "text": "私はあなたの後ろにいます。"}, {"type": "subtitle", "time": 10396.55, "timestamp": "02:53:16", "text": "ああ、あそこ。 あそこだよ。 あそこだよ。   あそこだよ"}, {"type": "subtitle", "time": 10398.55, "timestamp": "02:53:18", "text": "。"}, {"type": "subtitle", "time": 10401.03, "timestamp": "02:53:21", "text": "撃たないでください。"}, {"type": "subtitle", "time": 10418.07, "timestamp": "02:53:38", "text": "足首を骨折しましたか？ そうしなかった。"}, {"type": "subtitle", "time": 10419.99, "timestamp": "02:53:39", "text": "いいえ。"}, {"type": "subtitle", "time": 10422.63, "timestamp": "02:53:42", "text": "あなたが飛び出したとき、ちょうどその時、"}, {"type": "subtitle", "time": 10425.03, "timestamp": "02:53:45", "text": "回避したのです。   「しまった！」の"}, {"type": "subtitle", "time": 10428.95, "timestamp": "02:53:48", "text": "タイミングを計ってみてください。 注意深い。"}, {"type": "subtitle", "time": 10431.67, "timestamp": "02:53:51", "text": "イエス・[ __ ]。"}, {"type": "subtitle", "time": 10434.55, "timestamp": "02:53:54", "text": "あなたの後ろにはストライダーがいますか？"}, {"type": "subtitle", "time": 10435.67, "timestamp": "02:53:55", "text": "私は死にました。 私は死にました。"}, {"type": "subtitle", "time": 10438.389, "timestamp": "02:53:58", "text": "ああ、くそ。 あなたは1HPです。 走れ、走れ、走れ、走れ、"}]
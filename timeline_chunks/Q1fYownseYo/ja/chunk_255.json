[{"type": "subtitle", "time": 15327.83, "timestamp": "04:15:27", "text": "待って、リアクターカーは手に入れたか？"}, {"type": "subtitle", "time": 15329.189, "timestamp": "04:15:29", "text": "ああ、持ってる。"}, {"type": "subtitle", "time": 15345.83, "timestamp": "04:15:45", "text": "。死んだ。"}, {"type": "subtitle", "time": 15348.149, "timestamp": "04:15:48", "text": "設置完了。行け、行け、行け、行け、行け。行くぞ。"}, {"type": "subtitle", "time": 15353.91, "timestamp": "04:15:53", "text": "ああ、誰かが 先にそれをやれ。クソッ。ちくしょう。準備しろよ"}]
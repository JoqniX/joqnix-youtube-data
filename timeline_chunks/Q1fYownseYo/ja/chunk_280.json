[{"type": "subtitle", "time": 16834.47, "timestamp": "04:40:34", "text": "いくら？ 何てことだ。"}, {"type": "subtitle", "time": 16836.55, "timestamp": "04:40:36", "text": "とにかく、これで終わりにします。 やりたくない。"}, {"type": "subtitle", "time": 16842.708, "timestamp": "04:40:42", "text": "問題が多すぎます。 単純な"}, {"type": "subtitle", "time": 16854.708, "timestamp": "04:40:54", "text": "ああ、わかりました。 どのチャンネルがライブですか?"}, {"type": "subtitle", "time": 16856.55, "timestamp": "04:40:56", "text": "ここで終わりにします。 ご来場いただいた皆様ありがとうございました"}, {"type": "subtitle", "time": 16858.948, "timestamp": "04:40:58", "text": "。 本当にたくさん行きました。 よし"}]
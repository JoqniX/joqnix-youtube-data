[{"type": "subtitle", "time": 14763.51, "timestamp": "04:06:03", "text": "あぁ、爆発するの？"}, {"type": "subtitle", "time": 14765.91, "timestamp": "04:06:05", "text": "ここに入るのは初めてなの。 ああ、何だこれ？"}, {"type": "subtitle", "time": 14771.03, "timestamp": "04:06:11", "text": "待って、PvPみたいなのがあるの？"}, {"type": "subtitle", "time": 14780.07, "timestamp": "04:06:20", "text": "発砲か"}, {"type": "subtitle", "time": 14794.95, "timestamp": "04:06:34", "text": "あらまあ。そんなことをしたの"}, {"type": "subtitle", "time": 14798.309, "timestamp": "04:06:38", "text": "。最悪。"}, {"type": "subtitle", "time": 14801.189, "timestamp": "04:06:41", "text": "ゲームがフリーズした。ゲームがフリーズした。 なんてことだ。"}, {"type": "subtitle", "time": 14801.91, "timestamp": "04:06:41", "text": "ゲームがフリーズした。 ああ"}, {"type": "subtitle", "time": 14803.99, "timestamp": "04:06:43", "text": "、安全な場所へ。安全な場所へ。"}, {"type": "subtitle", "time": 14805.75, "timestamp": "04:06:45", "text": "死んだの？ 死んだの？ いや。いや、死んでない。死んでない。"}, {"type": "subtitle", "time": 14813.03, "timestamp": "04:06:53", "text": "シールドを用意するのを忘れた。"}, {"type": "subtitle", "time": 14814.63, "timestamp": "04:06:54", "text": "バカだ。"}, {"type": "subtitle", "time": 14817.11, "timestamp": "04:06:57", "text": "気を付けて。いや。"}, {"type": "subtitle", "time": 14819.51, "timestamp": "04:06:59", "text": "ああ、"}]
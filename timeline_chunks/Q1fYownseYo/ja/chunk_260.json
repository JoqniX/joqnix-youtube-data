[{"type": "subtitle", "time": 15600.95, "timestamp": "04:20:00", "text": "どうやって脅したんだ？銃声は聞こえない。"}, {"type": "subtitle", "time": 15608.63, "timestamp": "04:20:08", "text": "奴らは知らなかった。"}, {"type": "subtitle", "time": 15610.79, "timestamp": "04:20:10", "text": "銃声は一組しか聞こえなかった。奴らを"}, {"type": "subtitle", "time": 15613.91, "timestamp": "04:20:13", "text": "処刑しろ。奴らはひどい奴らだ。"}, {"type": "subtitle", "time": 15619.3, "timestamp": "04:20:19", "text": "皆が協力して働いていた時に、座ってネズミを捕まえるなんて許されない。クソッタレ。"}, {"type": "subtitle", "time": 15630.229, "timestamp": "04:20:30", "text": "奴の体には青い文字がある。"}, {"type": "subtitle", "time": 15632.389, "timestamp": "04:20:32", "text": "クソッタレ。待って、違う。それで、他の二人は「"}, {"type": "subtitle", "time": 15635.429, "timestamp": "04:20:35", "text": "ああ、ただ死んでる」って感じだった。"}, {"type": "subtitle", "time": 15638.87, "timestamp": "04:20:38", "text": "一方向から銃声が一発だけ聞こえた。"}, {"type": "subtitle", "time": 15640.63, "timestamp": "04:20:40", "text": "文字通り、一組の"}, {"type": "subtitle", "time": 15642.229, "timestamp": "04:20:42", "text": "銃声だけだった。"}, {"type": "subtitle", "time": 15643.59, "timestamp": "04:20:43", "text": "もし彼らが戦っていたら、俺たちは"}, {"type": "subtitle", "time": 15644.389, "timestamp": "04:20:44", "text": "気付くだろう。"}, {"type": "subtitle", "time": 15646.71, "timestamp": "04:20:46", "text": "奴らは完全なシールドを持っていた。だから、"}, {"type": "subtitle", "time": 15649.189, "timestamp": "04:20:49", "text": "この二人が"}]
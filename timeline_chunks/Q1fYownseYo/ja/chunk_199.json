[{"type": "subtitle", "time": 11945.67, "timestamp": "03:19:05", "text": "私のテンペストの音の近くに脱穀機がいます。"}, {"type": "subtitle", "time": 11947.429, "timestamp": "03:19:07", "text": "そして常に子供たちから目を離さないでください"}, {"type": "subtitle", "time": 11948.389, "timestamp": "03:19:08", "text": "。   そうそう"}, {"type": "subtitle", "time": 11951.349, "timestamp": "03:19:11", "text": "。 でも、"}, {"type": "subtitle", "time": 11953.83, "timestamp": "03:19:13", "text": "テンペストとクラッカーは連れて行きます。"}, {"type": "subtitle", "time": 11957.59, "timestamp": "03:19:17", "text": "ニース。 言いたくはないですが、"}, {"type": "subtitle", "time": 11961.429, "timestamp": "03:19:21", "text": "武器スキンが追加されると想像してみてください。"}, {"type": "subtitle", "time": 11968.15, "timestamp": "03:19:28", "text": "。 実際には"}, {"type": "subtitle", "time": 11970.07, "timestamp": "03:19:30", "text": "何も影響しません。 そうですね"}, {"type": "subtitle", "time": 11971.03, "timestamp": "03:19:31", "text": "、そうなることを願っています"}, {"type": "subtitle", "time": 11973.19, "timestamp": "03:19:33", "text": "。"}, {"type": "subtitle", "time": 11975.67, "timestamp": "03:19:35", "text": "武器スキンも見ていきます。 私は疑問に思う。   密告者に"}, {"type": "subtitle", "time": 11983.51, "timestamp": "03:19:43", "text": "スズメバチを呼ばせたいですか?"}, {"type": "subtitle", "time": 11986.07, "timestamp": "03:19:46", "text": "いいえ、通常通り行ってもあまりポイントはもらえません"}, {"type": "subtitle", "time": 11999.429, "timestamp": "03:19:59", "text": "。"}]
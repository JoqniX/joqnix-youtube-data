[{"type": "subtitle", "time": 6726.55, "timestamp": "01:52:06", "text": "コラボストリーム。 いいえ、ただ"}, {"type": "subtitle", "time": 6728.95, "timestamp": "01:52:08", "text": "一緒に遊んでいるだけです。 ぶらぶらしてのんびり過ごす、とも言えるでしょう"}, {"type": "subtitle", "time": 6730.87, "timestamp": "01:52:10", "text": "。"}, {"type": "subtitle", "time": 6740.79, "timestamp": "01:52:20", "text": "どうやって75に到達したのですか?"}, {"type": "subtitle", "time": 6741.589, "timestamp": "01:52:21", "text": "何？"}, {"type": "subtitle", "time": 6744.07, "timestamp": "01:52:24", "text": "どうやってレベル75に到達したのですか? どれ"}, {"type": "subtitle", "time": 6746.55, "timestamp": "01:52:26", "text": "くらい挽きましたか？"}, {"type": "subtitle", "time": 6748.87, "timestamp": "01:52:28", "text": "ああ、たくさん。"}, {"type": "subtitle", "time": 6751.189, "timestamp": "01:52:31", "text": "ただひたすら頑張るだけ。 私はたくさんの女家長"}, {"type": "subtitle", "time": 6753.189, "timestamp": "01:52:33", "text": "や女王と戦い、"}, {"type": "subtitle", "time": 6755.43, "timestamp": "01:52:35", "text": "たくさんの人も殺しました。   女"}, {"type": "subtitle", "time": 6758.31, "timestamp": "01:52:38", "text": "家長との試合が 3 回ありましたが、何も得られませんでした"}, {"type": "subtitle", "time": 6760.07, "timestamp": "01:52:40", "text": "。"}, {"type": "subtitle", "time": 6761.589, "timestamp": "01:52:41", "text": "ああ、ネズミの扱いに"}, {"type": "subtitle", "time": 6764.31, "timestamp": "01:52:44", "text": "熟練していなければなりません。"}, {"type": "subtitle", "time": 6768.229, "timestamp": "01:52:48", "text": "えっと、私はすでに何トンもの女家長コアを販売しました"}, {"type": "subtitle", "time": 6770.629, "timestamp": "01:52:50", "text": "。 原子炉。 たくさん売れました"}, {"type": "subtitle", "time": 6772.55, "timestamp": "01:52:52", "text": "。"}]
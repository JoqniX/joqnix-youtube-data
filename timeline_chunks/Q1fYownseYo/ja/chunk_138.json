[{"type": "subtitle", "time": 8280.549, "timestamp": "02:18:00", "text": "死ん"}, {"type": "subtitle", "time": 8282.87, "timestamp": "02:18:02", "text": "で進行状況を失いたくないだけです。"}, {"type": "subtitle", "time": 8290.15, "timestamp": "02:18:10", "text": "これはリーパーですか？ ああ神様。"}, {"type": "subtitle", "time": 8301.19, "timestamp": "02:18:21", "text": "撃たないでください。"}, {"type": "subtitle", "time": 8308.07, "timestamp": "02:18:28", "text": "撃つなとは絶対に言わない。 ただ"}, {"type": "subtitle", "time": 8309.99, "timestamp": "02:18:29", "text": "フルートを演奏するだけです。"}, {"type": "subtitle", "time": 8312.79, "timestamp": "02:18:32", "text": "誰も、誰もあなたを殺すことはできない。"}, {"type": "subtitle", "time": 8314.95, "timestamp": "02:18:34", "text": "フルートで人を殺す人はいないだろう。"}, {"type": "subtitle", "time": 8317.27, "timestamp": "02:18:37", "text": "どこにいるの？"}, {"type": "subtitle", "time": 8327.91, "timestamp": "02:18:47", "text": "スズメバチのために少しだけ滞在したいです。"}, {"type": "subtitle", "time": 8329.509, "timestamp": "02:18:49", "text": "そうだ、"}, {"type": "subtitle", "time": 8336.629, "timestamp": "02:18:56", "text": "こんにちは。"}, {"type": "subtitle", "time": 8339.83, "timestamp": "02:18:59", "text": "おい、撃たないで。 ありがとう。"}]
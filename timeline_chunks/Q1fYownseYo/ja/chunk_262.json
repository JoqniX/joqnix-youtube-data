[{"type": "subtitle", "time": 15725.349, "timestamp": "04:22:05", "text": "クィニングリアクターが2つ、"}, {"type": "subtitle", "time": 15740.389, "timestamp": "04:22:20", "text": "みなさん、GGです。"}, {"type": "subtitle", "time": 15750.302, "timestamp": "04:22:30", "text": "ああ、あのネズミを殺すのは気持ちいいよ。"}, {"type": "subtitle", "time": 15755.189, "timestamp": "04:22:35", "text": "ネズミを殺すのはすごく気持ちいいよ。 よし、"}, {"type": "subtitle", "time": 15757.99, "timestamp": "04:22:37", "text": "彼にどれだけのダメージを与えられるか見てみよう。"}, {"type": "subtitle", "time": 15758.55, "timestamp": "04:22:38", "text": "ニース。"}, {"type": "subtitle", "time": 15760.389, "timestamp": "04:22:40", "text": "ノックアウトされました。 ああ、彼を倒しちゃった。   わかった"}, {"type": "subtitle", "time": 15764.63, "timestamp": "04:22:44", "text": "。 わかった。 バレットタイム。  [笑い] 今のところ"}, {"type": "subtitle", "time": 15768.309, "timestamp": "04:22:48", "text": "このゲームで誰かを撃ったことはありません"}, {"type": "subtitle", "time": 15769.83, "timestamp": "04:22:49", "text": "。"}, {"type": "subtitle", "time": 15772.389, "timestamp": "04:22:52", "text": "えっと、タフにならなきゃ。"}, {"type": "subtitle", "time": 15775.11, "timestamp": "04:22:55", "text": "彼らに自分の立場を示さなければなりません。   そうでなければ、ただ"}, {"type": "subtitle", "time": 15778.79, "timestamp": "04:22:58", "text": "殺されてしまうだけだ。"}]
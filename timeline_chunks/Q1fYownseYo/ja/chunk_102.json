[{"type": "subtitle", "time": 6127.83, "timestamp": "01:42:07", "text": "調査します。 わかった。 センチネルファイアとコア。 あと"}, {"type": "subtitle", "time": 6155.35, "timestamp": "01:42:35", "text": "私は3つのオオカミの群れを飼っています。 よし。"}, {"type": "subtitle", "time": 6159.669, "timestamp": "01:42:39", "text": "ロケット弾発射機1人を倒せると思う。"}, {"type": "subtitle", "time": 6164.149, "timestamp": "01:42:44", "text": "しかし、1つだけでは十分ではありません。 いいえ。"}, {"type": "subtitle", "time": 6179.669, "timestamp": "01:42:59", "text": "4,000"}]
[{"type": "subtitle", "time": 14465.83, "timestamp": "04:01:05", "text": "ウルフパックか何か持って行った方がいいかな？"}, {"type": "subtitle", "time": 14476.229, "timestamp": "04:01:16", "text": "。ああ。"}, {"type": "subtitle", "time": 14478.55, "timestamp": "04:01:18", "text": "待って、女王から何が手に入るの？"}, {"type": "subtitle", "time": 14482.15, "timestamp": "04:01:22", "text": "戦利品は？リアクター。えーと、"}, {"type": "subtitle", "time": 14484.55, "timestamp": "04:01:24", "text": "えーと、女王"}, {"type": "subtitle", "time": 14486.07, "timestamp": "04:01:26", "text": "リアクターと似たような感じだけど。でも女王"}, {"type": "subtitle", "time": 14488.63, "timestamp": "04:01:28", "text": "リアクターは持ってないとダメだよ。"}, {"type": "subtitle", "time": 14490.71, "timestamp": "04:01:30", "text": "私はサバイバーをもらうよ。いや、"}, {"type": "subtitle", "time": 14501.75, "timestamp": "04:01:41", "text": "何？何？どんな議論をしたの？"}, {"type": "subtitle", "time": 14504.87, "timestamp": "04:01:44", "text": "リヴォルをもらうよ。[笑い]"}, {"type": "subtitle", "time": 14508.229, "timestamp": "04:01:48", "text": "わかった、もらうよ。そう願ってるし、"}, {"type": "subtitle", "time": 14509.75, "timestamp": "04:01:49", "text": "誓うよ。"}, {"type": "subtitle", "time": 14510.71, "timestamp": "04:01:50", "text": "死にたくないんだ。"}, {"type": "subtitle", "time": 14514.95, "timestamp": "04:01:54", "text": "足りないのは、えーと、基本的な"}]
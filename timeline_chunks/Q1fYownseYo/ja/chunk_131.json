[{"type": "subtitle", "time": 7879.91, "timestamp": "02:11:19", "text": "リサイクルしますか?"}, {"type": "subtitle", "time": 7883.99, "timestamp": "02:11:23", "text": "いいえ、修理するだけです。 ああ、"}, {"type": "subtitle", "time": 7887.91, "timestamp": "02:11:27", "text": "アップグレードして銃をアップグレードしただけです。"}, {"type": "subtitle", "time": 7889.51, "timestamp": "02:11:29", "text": "銃をアップグレードしません。"}, {"type": "subtitle", "time": 7891.27, "timestamp": "02:11:31", "text": "知っている。"}, {"type": "subtitle", "time": 7893.51, "timestamp": "02:11:33", "text": "銃をアップグレードしてみませんか？ それは"}, {"type": "subtitle", "time": 7895.75, "timestamp": "02:11:35", "text": "大きな違いです。   わかった"}, {"type": "subtitle", "time": 7897.43, "timestamp": "02:11:37", "text": "。"}, {"type": "subtitle", "time": 7900.95, "timestamp": "02:11:40", "text": "ええ、本当にそうする必要があるんです。   あ"}, {"type": "subtitle", "time": 7903.91, "timestamp": "02:11:43", "text": "、ここ。   はい"}, {"type": "subtitle", "time": 7904.55, "timestamp": "02:11:44", "text": "、確かに"}, {"type": "subtitle", "time": 7910.79, "timestamp": "02:11:50", "text": "17 個しかない。ああ"}, {"type": "subtitle", "time": 7913.109, "timestamp": "02:11:53", "text": "、なんて鳥なんだ。 鳥が"}, {"type": "subtitle", "time": 7916.229, "timestamp": "02:11:56", "text": "私から[ __ ]を撒き散らしたんだ。"}, {"type": "subtitle", "time": 7918.79, "timestamp": "02:11:58", "text": "ああ、わかりました"}]
[{"type": "subtitle", "time": 14285.03, "timestamp": "03:58:05", "text": "ああ、青いやつをなくした。"}, {"type": "subtitle", "time": 14288.55, "timestamp": "03:58:08", "text": "青い議論に負けた。ああ、しまった"}, {"type": "subtitle", "time": 14300.15, "timestamp": "03:58:20", "text": "心配するな。ただの青いアマンだ。"}, {"type": "subtitle", "time": 14304.15, "timestamp": "03:58:24", "text": "サバイバーを取るべきか？ わからん。"}, {"type": "subtitle", "time": 14307.67, "timestamp": "03:58:27", "text": "ああ、できるよ。"}, {"type": "subtitle", "time": 14309.349, "timestamp": "03:58:29", "text": "何が邪魔だ？ いずれにせよ、いつかは使わなきゃいけないんだ"}, {"type": "subtitle", "time": 14312.63, "timestamp": "03:58:32", "text": "。"}, {"type": "subtitle", "time": 14325.11, "timestamp": "03:58:45", "text": "3つ作った。"}, {"type": "subtitle", "time": 14325.51, "timestamp": "03:58:45", "text": "ふむ。"}, {"type": "subtitle", "time": 14329.349, "timestamp": "03:58:49", "text": "高度な電子部品は"}, {"type": "subtitle", "time": 14332.15, "timestamp": "03:58:52", "text": "なかなか見つからないんだ、俺は 推測する。いや、"}, {"type": "subtitle", "time": 14335.429, "timestamp": "03:58:55", "text": "難しくはないけど、中に入って"}, {"type": "subtitle", "time": 14339.03, "timestamp": "03:58:59", "text": "探さなきゃ。"}]
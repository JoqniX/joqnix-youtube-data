[{"type": "subtitle", "time": 1217.35, "timestamp": "00:20:17", "text": "Let them have the rest. I don't want it."}, {"type": "subtitle", "time": 1219.27, "timestamp": "00:20:19", "text": ">> Why are you leaving without doing the"}, {"type": "subtitle", "time": 1222.63, "timestamp": "00:20:22", "text": "bunker stuff?"}, {"type": "subtitle", "time": 1236.23, "timestamp": "00:20:36", "text": ">> I do not have any heals, don't I?"}, {"type": "subtitle", "time": 1247.99, "timestamp": "00:20:47", "text": "So, one would ask"}, {"type": "subtitle", "time": 1251.19, "timestamp": "00:20:51", "text": "Doc next, what's the game plan here? So,"}, {"type": "subtitle", "time": 1255.029, "timestamp": "00:20:55", "text": "my plan is to get the antenna here"}, {"type": "subtitle", "time": 1258.95, "timestamp": "00:20:58", "text": "and see how that goes."}]
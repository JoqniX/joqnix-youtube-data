[{"type": "subtitle", "time": 7086.709, "timestamp": "01:58:06", "text": "他们需要对"}, {"type": "subtitle", "time": 7089.27, "timestamp": "01:58:09", "text": "跳跃者和火箭手做些改进，"}, {"type": "subtitle", "time": 7092.709, "timestamp": "01:58:12", "text": "因为他们的反应堆根本不起作用"}, {"type": "subtitle", "time": 7093.109, "timestamp": "01:58:13", "text": "。"}, {"type": "subtitle", "time": 7097.03, "timestamp": "01:58:17", "text": "跳跃者恢复了体力，准备参加探险。"}, {"type": "subtitle", "time": 7098.87, "timestamp": "01:58:18", "text": "真的吗？ 哦，我有很多呢"}, {"type": "subtitle", "time": 7101.99, "timestamp": "01:58:21", "text": "。 你需要多少个？"}, {"type": "subtitle", "time": 7104.31, "timestamp": "01:58:24", "text": "呃，"}, {"type": "subtitle", "time": 7107.03, "timestamp": "01:58:27", "text": "我居然忘了。"}, {"type": "subtitle", "time": 7109.589, "timestamp": "01:58:29", "text": "我们"}, {"type": "subtitle", "time": 7119.43, "timestamp": "01:58:39", "text": "对，大概四个左右。 嗯，大概"}, {"type": "subtitle", "time": 7122.47, "timestamp": "01:58:42", "text": "四个左右吧。 对，"}, {"type": "subtitle", "time": 7124.79, "timestamp": "01:58:44", "text": "四到六个。 没有把握。 等等，那是"}, {"type": "subtitle", "time": 7127.35, "timestamp": "01:58:47", "text": "煤炭崩塌事件。"}, {"type": "subtitle", "time": 7130.55, "timestamp": "01:58:50", "text": "那是四个，对吧？ 不，等等。 不，不，"}, {"type": "subtitle", "time": 7132.149, "timestamp": "01:58:52", "text": "不。 你没必要那样做。 哦，"}, {"type": "subtitle", "time": 7133.27, "timestamp": "01:58:53", "text": "没事了。"}, {"type": "subtitle", "time": 7135.51, "timestamp": "01:58:55", "text": "哦。"}, {"type": "subtitle", "time": 7137.83, "timestamp": "01:58:57", "text": "呃，"}]
[{"type": "subtitle", "time": 11945.67, "timestamp": "03:19:05", "text": "我的暴风雨号附近传来脱粒机的声音。"}, {"type": "subtitle", "time": 11947.429, "timestamp": "03:19:07", "text": "而且要时刻密切关注她的"}, {"type": "subtitle", "time": 11948.389, "timestamp": "03:19:08", "text": "孩子。"}, {"type": "subtitle", "time": 11951.349, "timestamp": "03:19:11", "text": "哦，是的。 但"}, {"type": "subtitle", "time": 11953.83, "timestamp": "03:19:13", "text": "我会带上 Tempest 和 Cracker。"}, {"type": "subtitle", "time": 11957.59, "timestamp": "03:19:17", "text": "好的。 我不想说，但"}, {"type": "subtitle", "time": 11961.429, "timestamp": "03:19:21", "text": "想象一下他们会添加武器皮肤。"}, {"type": "subtitle", "time": 11968.15, "timestamp": "03:19:28", "text": "我的意思是他们可以。 实际上它不会造成"}, {"type": "subtitle", "time": 11970.07, "timestamp": "03:19:30", "text": "任何影响。"}, {"type": "subtitle", "time": 11971.03, "timestamp": "03:19:31", "text": "嗯，"}, {"type": "subtitle", "time": 11973.19, "timestamp": "03:19:33", "text": "但愿如此。"}, {"type": "subtitle", "time": 11975.67, "timestamp": "03:19:35", "text": "我甚至可以看到武器皮肤。 我"}, {"type": "subtitle", "time": 11981.59, "timestamp": "03:19:41", "text": "你想让告密者引来"}, {"type": "subtitle", "time": 11983.51, "timestamp": "03:19:43", "text": "黄蜂吗？"}, {"type": "subtitle", "time": 11986.07, "timestamp": "03:19:46", "text": "不，我们照常行事意义不大"}, {"type": "subtitle", "time": 11999.429, "timestamp": "03:19:59", "text": "我的天啊。"}]
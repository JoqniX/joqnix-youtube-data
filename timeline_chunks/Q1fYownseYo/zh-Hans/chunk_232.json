[{"type": "subtitle", "time": 13920.95, "timestamp": "03:52:00", "text": "兄弟。好了，我明白了。是的。是的。是的"}, {"type": "subtitle", "time": 13922.87, "timestamp": "03:52:02", "text": "，是的，是的，是的，是的，是的，是的，是的，是的"}, {"type": "subtitle", "time": 13924.63, "timestamp": "03:52:04", "text": "，是的。好了，拿到"}, {"type": "subtitle", "time": 13928.71, "timestamp": "03:52:08", "text": "一个主要核心。就是这样"}, {"type": "subtitle", "time": 13932.309, "timestamp": "03:52:12", "text": "，杰克。快跑。"}, {"type": "subtitle", "time": 13933.269, "timestamp": "03:52:13", "text": "有人在搜刮这里。"}, {"type": "subtitle", "time": 13938.87, "timestamp": "03:52:18", "text": "一定要找到核心。"}, {"type": "subtitle", "time": 13951.429, "timestamp": "03:52:31", "text": "啊，我什么也没拿到。哦，我"}, {"type": "subtitle", "time": 13963.75, "timestamp": "03:52:43", "text": "我应该在他们……你"}, {"type": "subtitle", "time": 13965.03, "timestamp": "03:52:45", "text": "知道的，"}, {"type": "subtitle", "time": 13966.95, "timestamp": "03:52:46", "text": "屏幕上的掠夺者……之前离开吗？"}, {"type": "subtitle", "time": 13968.55, "timestamp": "03:52:48", "text": "快来。"}]
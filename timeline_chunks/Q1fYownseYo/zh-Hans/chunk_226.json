[{"type": "subtitle", "time": 13561.349, "timestamp": "03:46:01", "text": "它有追踪功能。"}, {"type": "subtitle", "time": 13564.15, "timestamp": "03:46:04", "text": "我想它是追踪的。"}, {"type": "subtitle", "time": 13567.03, "timestamp": "03:46:07", "text": "哦，对。培根。从这里射击它。"}, {"type": "subtitle", "time": 13569.83, "timestamp": "03:46:09", "text": "射击。从你的位置射击它。"}, {"type": "subtitle", "time": 13573.83, "timestamp": "03:46:13", "text": "还有，我们该去……"}, {"type": "subtitle", "time": 13575.99, "timestamp": "03:46:15", "text": "运输车坏了吗？"}, {"type": "subtitle", "time": 13581.91, "timestamp": "03:46:21", "text": "到那里来。"}, {"type": "subtitle", "time": 13584.309, "timestamp": "03:46:24", "text": "是轰炸机。坚持住。"}, {"type": "subtitle", "time": 13611.269, "timestamp": "03:46:51", "text": "天，"}, {"type": "subtitle", "time": 13613.349, "timestamp": "03:46:53", "text": "我死了。[笑声]"}, {"type": "subtitle", "time": 13614.15, "timestamp": "03:46:54", "text": "为什么？"}, {"type": "subtitle", "time": 13615.67, "timestamp": "03:46:55", "text": "我没时间了。"}, {"type": "subtitle", "time": 13617.83, "timestamp": "03:46:57", "text": "我们有幸存者，对吧？告诉"}, {"type": "subtitle", "time": 13618.229, "timestamp": "03:46:58", "text": "我。"}, {"type": "subtitle", "time": 13619.269, "timestamp": "03:46:59", "text": "是的，我是幸存者。"}]
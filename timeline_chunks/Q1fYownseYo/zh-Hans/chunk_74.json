[{"type": "subtitle", "time": 4445.99, "timestamp": "01:14:05", "text": "我在那里。 有人真的开枪打中了我。"}, {"type": "subtitle", "time": 4448.95, "timestamp": "01:14:08", "text": "那不是弧线。 那是真人玩家。"}, {"type": "subtitle", "time": 4460.87, "timestamp": "01:14:20", "text": "什么？ 一名玩家开枪打中了我。"}, {"type": "subtitle", "time": 4465.35, "timestamp": "01:14:25", "text": "各位，这个人是谁？"}, {"type": "subtitle", "time": 4469.669, "timestamp": "01:14:29", "text": "兄弟，你干嘛按哔哔声？"}, {"type": "subtitle", "time": 4474.229, "timestamp": "01:14:34", "text": "我应该在 com"}, {"type": "subtitle", "time": 4493.91, "timestamp": "01:14:53", "text": "谢天谢地，我很容易就提取出来了"}, {"type": "subtitle", "time": 4495.669, "timestamp": "01:14:55", "text": "。"}]
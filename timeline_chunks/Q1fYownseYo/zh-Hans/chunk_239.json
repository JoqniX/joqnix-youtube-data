[{"type": "subtitle", "time": 14343.189, "timestamp": "03:59:03", "text": "但是，是的，游戏就是这样，对吧？"}, {"type": "subtitle", "time": 14350.309, "timestamp": "03:59:10", "text": "好的，让我拿我的盾牌。"}, {"type": "subtitle", "time": 14357.03, "timestamp": "03:59:17", "text": "以防"}, {"type": "subtitle", "time": 14359.51, "timestamp": "03:59:19", "text": "我没有防御。"}, {"type": "subtitle", "time": 14384.309, "timestamp": "03:59:44", "text": "不是女族长。是的"}, {"type": "subtitle", "time": 14386.63, "timestamp": "03:59:46", "text": "，完成了，我 想想。"}, {"type": "subtitle", "time": 14390.229, "timestamp": "03:59:50", "text": "等等，收割者是干嘛的？"}, {"type": "subtitle", "time": 14392.15, "timestamp": "03:59:52", "text": "是女王。"}, {"type": "subtitle", "time": 14393.51, "timestamp": "03:59:53", "text": "哦，"}, {"type": "subtitle", "time": 14396.389, "timestamp": "03:59:56", "text": "女王守卫着一个很大的地方"}, {"type": "subtitle", "time": 14398.15, "timestamp": "03:59:58", "text": "。那里有很多战利品。我从来"}]
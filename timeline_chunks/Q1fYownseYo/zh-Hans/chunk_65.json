[{"type": "subtitle", "time": 3911.91, "timestamp": "01:05:11", "text": "我感觉自己快要死了"}, {"type": "subtitle", "time": 3931.67, "timestamp": "01:05:31", "text": "天，他们掉头了。"}, {"type": "subtitle", "time": 3939.67, "timestamp": "01:05:39", "text": "如果我有手雷的话，不，我可以直接把"}, {"type": "subtitle", "time": 3941.91, "timestamp": "01:05:41", "text": "他们两个都干掉，然后结束"}, {"type": "subtitle", "time": 3945.349, "timestamp": "01:05:45", "text": "今天的任务撤离。"}]
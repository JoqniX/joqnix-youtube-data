[{"type": "subtitle", "time": 14763.51, "timestamp": "04:06:03", "text": "哦，它要爆炸了吗？"}, {"type": "subtitle", "time": 14765.91, "timestamp": "04:06:05", "text": "我第一次来这里。哦，"}, {"type": "subtitle", "time": 14766.71, "timestamp": "04:06:06", "text": "搞什么鬼？"}, {"type": "subtitle", "time": 14771.03, "timestamp": "04:06:11", "text": "等等，有人吗？他们好像在玩PVP。"}, {"type": "subtitle", "time": 14780.07, "timestamp": "04:06:20", "text": "我还以为它要开火什么的"}, {"type": "subtitle", "time": 14793.03, "timestamp": "04:06:33", "text": "哦。哦，是啊。我的天。"}, {"type": "subtitle", "time": 14798.309, "timestamp": "04:06:38", "text": "他们干的。真他妈的。 糟了。"}, {"type": "subtitle", "time": 14801.189, "timestamp": "04:06:41", "text": "我的游戏卡住了。我的游戏卡住了。我的天啊。"}, {"type": "subtitle", "time": 14801.91, "timestamp": "04:06:41", "text": "我的游戏卡住了。"}, {"type": "subtitle", "time": 14803.99, "timestamp": "04:06:43", "text": "哦，快找个安全点。快找个安全点。"}, {"type": "subtitle", "time": 14805.75, "timestamp": "04:06:45", "text": "我死了吗？我死了吗？"}, {"type": "subtitle", "time": 14813.03, "timestamp": "04:06:53", "text": "我忘了拿护盾。"}, {"type": "subtitle", "time": 14814.63, "timestamp": "04:06:54", "text": "我真是太蠢了。"}, {"type": "subtitle", "time": 14817.11, "timestamp": "04:06:57", "text": "小心点。不。"}, {"type": "subtitle", "time": 14819.51, "timestamp": "04:06:59", "text": "啊，"}]
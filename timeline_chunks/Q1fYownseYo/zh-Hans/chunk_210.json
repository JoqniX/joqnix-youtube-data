[{"type": "subtitle", "time": 12601.349, "timestamp": "03:30:01", "text": "你怕我。所以我就退了。"}, {"type": "subtitle", "time": 12603.99, "timestamp": "03:30:03", "text": "什么意思？吓到你了？"}, {"type": "subtitle", "time": 12605.19, "timestamp": "03:30:05", "text": "那里有[笑声]"}, {"type": "subtitle", "time": 12607.67, "timestamp": "03:30:07", "text": "那玩意儿吗？操。操。操。我当时"}, {"type": "subtitle", "time": 12610.95, "timestamp": "03:30:10", "text": "想，等等，有人在打架吗？"}, {"type": "subtitle", "time": 12613.51, "timestamp": "03:30:13", "text": "没有。我脸上突然爬了只蜱虫，同时"}, {"type": "subtitle", "time": 12615.59, "timestamp": "03:30:15", "text": "一个火球朝我飞过来，然后砰的一声。算了"}, {"type": "subtitle", "time": 12622.309, "timestamp": "03:30:22", "text": "。"}, {"type": "subtitle", "time": 12624.229, "timestamp": "03:30:24", "text": "好吧。操。我有这把枪。"}, {"type": "subtitle", "time": 12626.87, "timestamp": "03:30:26", "text": "近距离打不了。你先上去。"}, {"type": "subtitle", "time": 12629.349, "timestamp": "03:30:29", "text": "那里应该会砰的一声。"}, {"type": "subtitle", "time": 12631.19, "timestamp": "03:30:31", "text": "哦，等等。"}, {"type": "subtitle", "time": 12650.63, "timestamp": "03:30:50", "text": "你知道吗？我要去打。"}, {"type": "subtitle", "time": 12657.11, "timestamp": "03:30:57", "text": "啊，我的游戏卡住了。不。"}]
[{"type": "subtitle", "time": 10622.63, "timestamp": "02:57:02", "text": "稍等片刻"}, {"type": "subtitle", "time": 10627.11, "timestamp": "02:57:07", "text": "哦，糟糕。"}, {"type": "subtitle", "time": 10629.269, "timestamp": "02:57:09", "text": "当它出现在这里时，我会"}, {"type": "subtitle", "time": 10633.51, "timestamp": "02:57:13", "text": "尝试这样做"}, {"type": "subtitle", "time": 10636.309, "timestamp": "02:57:16", "text": "并跑开。 等等，这里有球。 等等，那是"}, {"type": "subtitle", "time": 10638.469, "timestamp": "02:57:18", "text": "控制室。"}, {"type": "subtitle", "time": 10641.91, "timestamp": "02:57:21", "text": "走到门口。"}, {"type": "subtitle", "time": 10642.389, "timestamp": "02:57:22", "text": "我的天哪。"}, {"type": "subtitle", "time": 10644.55, "timestamp": "02:57:24", "text": "等等，不要"}, {"type": "subtitle", "time": 10647.99, "timestamp": "02:57:27", "text": "等它拍完。"}, {"type": "subtitle", "time": 10649.59, "timestamp": "02:57:29", "text": "隐藏。"}, {"type": "subtitle", "time": 10651.03, "timestamp": "02:57:31", "text": "我觉得我的弹药不够"}, {"type": "subtitle", "time": 10653.19, "timestamp": "02:57:33", "text": "。"}, {"type": "subtitle", "time": 10654.469, "timestamp": "02:57:34", "text": "别介意。 等等，等等，等等，等等。"}, {"type": "subtitle", "time": 10656.79, "timestamp": "02:57:36", "text": "躲起来，躲起来，躲起来，躲起来。"}, {"type": "subtitle", "time": 10659.349, "timestamp": "02:57:39", "text": "好的，我去门口。 过来。"}, {"type": "subtitle", "time": 10660.95, "timestamp": "02:57:40", "text": "好的。   是的"}, {"type": "subtitle", "time": 10668.309, "timestamp": "02:57:48", "text": "好的。 过来"}, {"type": "subtitle", "time": 10671.91, "timestamp": "02:57:51", "text": "关上它。 好的。"}, {"type": "subtitle", "time": 10674.469, "timestamp": "02:57:54", "text": "我的天啊。"}, {"type": "subtitle", "time": 10677.429, "timestamp": "02:57:57", "text": "只有八个人还剩八颗子弹。"}, {"type": "subtitle", "time": 10679.03, "timestamp": "02:57:59", "text": "我的天啊。"}]
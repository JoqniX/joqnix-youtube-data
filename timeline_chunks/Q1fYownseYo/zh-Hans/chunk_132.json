[{"type": "subtitle", "time": 7922.47, "timestamp": "02:12:02", "text": "好的。 一样。 让它盯上你。 啊。"}, {"type": "subtitle", "time": 7923.27, "timestamp": "02:12:03", "text": "哦。"}, {"type": "subtitle", "time": 7926.39, "timestamp": "02:12:06", "text": "它在哪里？"}, {"type": "subtitle", "time": 7930.55, "timestamp": "02:12:10", "text": "呃，西部。"}, {"type": "subtitle", "time": 7932.31, "timestamp": "02:12:12", "text": "啊，"}, {"type": "subtitle", "time": 7935.669, "timestamp": "02:12:15", "text": "看到了吗？ 你看到了吗？"}, {"type": "subtitle", "time": 7936.79, "timestamp": "02:12:16", "text": "它在哪里？ 什么鬼？"}, {"type": "subtitle", "time": 7943.99, "timestamp": "02:12:23", "text": "哪儿？"}, {"type": "subtitle", "time": 7947.83, "timestamp": "02:12:27", "text": "火箭。 哦，在那边。"}, {"type": "subtitle", "time": 7950.95, "timestamp": "02:12:30", "text": "好吧，我只有18发子弹了。"}, {"type": "subtitle", "time": 7951.83, "timestamp": "02:12:31", "text": "快点。 好吧，"}, {"type": "subtitle", "time": 7955.109, "timestamp": "02:12:35", "text": "也许是这栋楼。"}, {"type": "subtitle", "time": 7958.31, "timestamp": "02:12:38", "text": "好，我先引诱它。 我的天，好"}, {"type": "subtitle", "time": 7960.709, "timestamp": "02:12:40", "text": "险！ 呃，等等，等等，"}, {"type": "subtitle", "time": 7964.229, "timestamp": "02:12:44", "text": "等等。 我们能飞到高处去拍摄吗？   我打算"}, {"type": "subtitle", "time": 7965.99, "timestamp": "02:12:45", "text": "先上到屋顶上去。"}, {"type": "subtitle", "time": 7967.35, "timestamp": "02:12:47", "text": "屋顶上好像有个窗户之类的"}, {"type": "subtitle", "time": 7968.47, "timestamp": "02:12:48", "text": "？"}, {"type": "subtitle", "time": 7970.629, "timestamp": "02:12:50", "text": "呃，就是这栋楼。"}]
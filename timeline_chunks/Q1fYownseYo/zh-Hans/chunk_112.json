[{"type": "subtitle", "time": 6726.55, "timestamp": "01:52:06", "text": "协作流。 不，我们只是"}, {"type": "subtitle", "time": 6728.95, "timestamp": "01:52:08", "text": "一起玩。 可以称之为闲逛和"}, {"type": "subtitle", "time": 6730.87, "timestamp": "01:52:10", "text": "放松。   是的"}, {"type": "subtitle", "time": 6740.79, "timestamp": "01:52:20", "text": "它怎么会达到75？"}, {"type": "subtitle", "time": 6741.589, "timestamp": "01:52:21", "text": "什么？"}, {"type": "subtitle", "time": 6744.07, "timestamp": "01:52:24", "text": "你是怎么升到75级的？"}, {"type": "subtitle", "time": 6746.55, "timestamp": "01:52:26", "text": "你磨了多少？"}, {"type": "subtitle", "time": 6748.87, "timestamp": "01:52:28", "text": "哦，很多。"}, {"type": "subtitle", "time": 6751.189, "timestamp": "01:52:31", "text": "我只是埋头苦干。 我跟很多女族长"}, {"type": "subtitle", "time": 6753.189, "timestamp": "01:52:33", "text": "和女王战斗过，也"}, {"type": "subtitle", "time": 6755.43, "timestamp": "01:52:35", "text": "杀了不少人。   匹配了"}, {"type": "subtitle", "time": 6758.31, "timestamp": "01:52:38", "text": "三场女族长比赛，结果什么也没得到"}, {"type": "subtitle", "time": 6760.07, "timestamp": "01:52:40", "text": "。"}, {"type": "subtitle", "time": 6761.589, "timestamp": "01:52:41", "text": "哦，你必须……你必须"}, {"type": "subtitle", "time": 6764.31, "timestamp": "01:52:44", "text": "擅长捉老鼠。"}, {"type": "subtitle", "time": 6768.229, "timestamp": "01:52:48", "text": "呃，我已经卖出了好多女族长核心装备"}, {"type": "subtitle", "time": 6770.629, "timestamp": "01:52:50", "text": "。 反应堆。 我卖掉了一大堆"}, {"type": "subtitle", "time": 6772.55, "timestamp": "01:52:52", "text": "。"}, {"type": "subtitle", "time": 6778.229, "timestamp": "01:52:58", "text": "因为我不知道该用它做什么，因为我"}]
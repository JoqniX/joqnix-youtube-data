[{"type": "subtitle", "time": 15789.91, "timestamp": "04:23:09", "text": "你们俩从另一个人那里弄到了种子文件。"}, {"type": "subtitle", "time": 15793.349, "timestamp": "04:23:13", "text": "我从尸体上弄到了两颗子弹"}, {"type": "subtitle", "time": 15796.469, "timestamp": "04:23:16", "text": "。 是的。"}, {"type": "subtitle", "time": 15802.55, "timestamp": "04:23:22", "text": "我的天啊。   那个"}, {"type": "subtitle", "time": 15806.149, "timestamp": "04:23:26", "text": "杀了我的家伙到底是什么东西？（清嗓子）"}, {"type": "subtitle", "time": 15808.55, "timestamp": "04:23:28", "text": "科学。"}, {"type": "subtitle", "time": 15811.59, "timestamp": "04:23:31", "text": "那么，一共有多少只老鼠？ 三。"}, {"type": "subtitle", "time": 15812.309, "timestamp": "04:23:32", "text": "四、"}, {"type": "subtitle", "time": 15814.95, "timestamp": "04:23:34", "text": "三。 三只老鼠。"}, {"type": "subtitle", "time": 15816.55, "timestamp": "04:23:36", "text": "其他人都去哪儿了？"}, {"type": "subtitle", "time": 15818.87, "timestamp": "04:23:38", "text": "人真的好多啊。   是的"}, {"type": "subtitle", "time": 15823.007, "timestamp": "04:23:43", "text": "，我知道。 你看，老鼠真是毫无羞耻心。"}, {"type": "subtitle", "time": 15824.149, "timestamp": "04:23:44", "text": "[笑声]"}, {"type": "subtitle", "time": 15826.389, "timestamp": "04:23:46", "text": "等等，你是搜刮了"}, {"type": "subtitle", "time": 15828.309, "timestamp": "04:23:48", "text": "其他人的尸体，还是他们都互相复活了"}, {"type": "subtitle", "time": 15830.07, "timestamp": "04:23:50", "text": "？"}, {"type": "subtitle", "time": 15832.79, "timestamp": "04:23:52", "text": "呃，什么？ 你是什​​么意思？"}, {"type": "subtitle", "time": 15835.349, "timestamp": "04:23:55", "text": "呃，就像辐射导致三个人死亡那样，"}, {"type": "subtitle", "time": 15837.67, "timestamp": "04:23:57", "text": "对吧？ 他们大概有三四个人"}, {"type": "subtitle", "time": 15838.149, "timestamp": "04:23:58", "text": "。"}, {"type": "subtitle", "time": 15839.429, "timestamp": "04:23:59", "text": "二。 二。 两个人。"}]
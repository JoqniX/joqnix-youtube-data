[{"type": "subtitle", "time": 9785.429, "timestamp": "02:43:05", "text": "但我们主要还是会表演流行歌曲。 是的。"}, {"type": "subtitle", "time": 9787.99, "timestamp": "02:43:07", "text": "但是如果我们杀了人，就会被送到"}, {"type": "subtitle", "time": 9790.63, "timestamp": "02:43:10", "text": "一个很糟糕的大厅。 不过PVP排名在我下面"}, {"type": "subtitle", "time": 9792.07, "timestamp": "02:43:12", "text": "。"}, {"type": "subtitle", "time": 9794.972, "timestamp": "02:43:14", "text": "不，其实不是。 我经常杀人。"}, {"type": "subtitle", "time": 9796.309, "timestamp": "02:43:16", "text": "[笑声]"}, {"type": "subtitle", "time": 9799.99, "timestamp": "02:43:19", "text": "这就是我吗？ 我们正在被杀。"}, {"type": "subtitle", "time": 9800.71, "timestamp": "02:43:20", "text": "没有把握。"}, {"type": "subtitle", "time": 9802.389, "timestamp": "02:43:22", "text": "不，"}, {"type": "subtitle", "time": 9804.309, "timestamp": "02:43:24", "text": "并非总是如此。 我只杀那些开枪"}, {"type": "subtitle", "time": 9806.71, "timestamp": "02:43:26", "text": "打我的人。"}, {"type": "subtitle", "time": 9808.95, "timestamp": "02:43:28", "text": "我忘了魔鬼好像"}, {"type": "subtitle", "time": 9812.07, "timestamp": "02:43:32", "text": "在新文章里说过类似的话。"}, {"type": "subtitle", "time": 9813.429, "timestamp": "02:43:33", "text": "真的吗？   它是"}, {"type": "subtitle", "time": 9821.91, "timestamp": "02:43:41", "text": "只要你不参与"}, {"type": "subtitle", "time": 9825.75, "timestamp": "02:43:45", "text": "射击其他玩家，就不会把"}, {"type": "subtitle", "time": 9828.23, "timestamp": "02:43:48", "text": "你匹配到会射击你的玩家组队"}, {"type": "subtitle", "time": 9830.79, "timestamp": "02:43:50", "text": "。 我不知道。 或许我们运气"}, {"type": "subtitle", "time": 9839.59, "timestamp": "02:43:59", "text": "但我确实想喜欢 PvP，想拿到"}]
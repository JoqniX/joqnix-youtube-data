[{"type": "subtitle", "time": 8940.63, "timestamp": "02:29:00", "text": "我没有金属烟弹。 我的天哪，我"}, {"type": "subtitle", "time": 8951.19, "timestamp": "02:29:11", "text": "更多绷带。 你只要告诉我你"}, {"type": "subtitle", "time": 8952.79, "timestamp": "02:29:12", "text": "想要什么就行了。"}, {"type": "subtitle", "time": 8956.389, "timestamp": "02:29:16", "text": "哦，我也没钱。 连绷带都做不出来"}, {"type": "subtitle", "time": 8969.349, "timestamp": "02:29:29", "text": "走吧。"}, {"type": "subtitle", "time": 8973.75, "timestamp": "02:29:33", "text": "哦，利维坦说不。 好的。   是的"}, {"type": "subtitle", "time": 8975.59, "timestamp": "02:29:35", "text": "。"}, {"type": "subtitle", "time": 8977.51, "timestamp": "02:29:37", "text": "忘了"}, {"type": "subtitle", "time": 8979.99, "timestamp": "02:29:39", "text": "瞄准镜了。"}, {"type": "subtitle", "time": 8993.51, "timestamp": "02:29:53", "text": "我只希望我从未尝试过斯特拉·蒙特斯的"}, {"type": "subtitle", "time": 8997.429, "timestamp": "02:29:57", "text": "双人套装。 我们一起尝试过吗？ 我"}]
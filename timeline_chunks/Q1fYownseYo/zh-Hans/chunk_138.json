[{"type": "subtitle", "time": 8280.549, "timestamp": "02:18:00", "text": "我只是不想死，不想"}, {"type": "subtitle", "time": 8282.87, "timestamp": "02:18:02", "text": "失去之前的努力。"}, {"type": "subtitle", "time": 8290.15, "timestamp": "02:18:10", "text": "这是跳跃者吗？ 我的天哪。   是的"}, {"type": "subtitle", "time": 8301.19, "timestamp": "02:18:21", "text": "不要开枪。"}, {"type": "subtitle", "time": 8308.07, "timestamp": "02:18:28", "text": "永远不要说“不要开枪”。 你就"}, {"type": "subtitle", "time": 8309.99, "timestamp": "02:18:29", "text": "吹笛子就行了。"}, {"type": "subtitle", "time": 8312.79, "timestamp": "02:18:32", "text": "没有人会杀你。 没人"}, {"type": "subtitle", "time": 8314.95, "timestamp": "02:18:34", "text": "会去杀一个吹笛子的人。"}, {"type": "subtitle", "time": 8317.27, "timestamp": "02:18:37", "text": "你在哪里？"}, {"type": "subtitle", "time": 8325.349, "timestamp": "02:18:45", "text": "有点想多待一会儿看看那只大"}, {"type": "subtitle", "time": 8327.91, "timestamp": "02:18:47", "text": "黄蜂。   是"}, {"type": "subtitle", "time": 8329.509, "timestamp": "02:18:49", "text": "啊，是啊"}, {"type": "subtitle", "time": 8330.87, "timestamp": "02:18:50", "text": "，我们可以留下来。"}, {"type": "subtitle", "time": 8336.629, "timestamp": "02:18:56", "text": "你好。"}, {"type": "subtitle", "time": 8339.83, "timestamp": "02:18:59", "text": "嘿，别开枪。 谢谢。"}]
[{"type": "subtitle", "time": 13802.308, "timestamp": "03:50:02", "text": "他们用复活技能救了我。"}, {"type": "subtitle", "time": 13806.95, "timestamp": "03:50:06", "text": "嗯，复活队友不需要失败"}, {"type": "subtitle", "time": 13809.03, "timestamp": "03:50:09", "text": "。"}, {"type": "subtitle", "time": 13811.03, "timestamp": "03:50:11", "text": "我有一种奇怪的感觉，有人不"}, {"type": "subtitle", "time": 13814.389, "timestamp": "03:50:14", "text": "小心误杀了"}, {"type": "subtitle", "time": 13817.59, "timestamp": "03:50:17", "text": "其他玩家。谢天谢地，他们不是在"}, {"type": "subtitle", "time": 13845.429, "timestamp": "03:50:45", "text": "没人开枪。该死。"}, {"type": "subtitle", "time": 13848.469, "timestamp": "03:50:48", "text": "你试着从这边过来。就像从"}, {"type": "subtitle", "time": 13856.15, "timestamp": "03:50:56", "text": "，伙计们。我在地窖钥匙附近。"}, {"type": "subtitle", "time": 13858.309, "timestamp": "03:50:58", "text": "请放置。我现在就在旁边。"}, {"type": "subtitle", "time": 13859.269, "timestamp": "03:50:59", "text": "哦，走吧。"}]
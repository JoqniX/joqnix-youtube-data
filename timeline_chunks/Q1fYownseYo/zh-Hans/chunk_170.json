[{"type": "subtitle", "time": 10217.51, "timestamp": "02:50:17", "text": "下面有一个。 哦，碎纸机。   是的"}, {"type": "subtitle", "time": 10220.469, "timestamp": "02:50:20", "text": "。"}, {"type": "subtitle", "time": 10222.23, "timestamp": "02:50:22", "text": "好吧，让我们一起做点什么吧。"}, {"type": "subtitle", "time": 10225.83, "timestamp": "02:50:25", "text": "嘿，那是友军误伤。"}, {"type": "subtitle", "time": 10233.349, "timestamp": "02:50:33", "text": "等等，"}, {"type": "subtitle", "time": 10235.269, "timestamp": "02:50:35", "text": "你给我看过了吗？   是的"}, {"type": "subtitle", "time": 10236.71, "timestamp": "02:50:36", "text": "，我做了。"}, {"type": "subtitle", "time": 10237.269, "timestamp": "02:50:37", "text": "好的。 好的。   妈的"}, {"type": "subtitle", "time": 10239.99, "timestamp": "02:50:39", "text": "。 看？ 看到这只该死的老鼠了吗？ 过来"}, {"type": "subtitle", "time": 10241.75, "timestamp": "02:50:41", "text": "。 过来。 过来。 过来。"}, {"type": "subtitle", "time": 10242.55, "timestamp": "02:50:42", "text": "等待。 什么？"}, {"type": "subtitle", "time": 10245.67, "timestamp": "02:50:45", "text": "你看到这只该死的老鼠了吗？ 看？"}, {"type": "subtitle", "time": 10247.19, "timestamp": "02:50:47", "text": "真是个卑鄙无耻的家伙。"}, {"type": "subtitle", "time": 10247.91, "timestamp": "02:50:47", "text": "我的天啊。"}, {"type": "subtitle", "time": 10255.67, "timestamp": "02:50:55", "text": "不要开枪。"}, {"type": "subtitle", "time": 10258.63, "timestamp": "02:50:58", "text": "我选弧线。 所以那里还有其他人"}]
[{"type": "subtitle", "time": 12181.67, "timestamp": "03:23:01", "text": "不，我们"}, {"type": "subtitle", "time": 12184.79, "timestamp": "03:23:04", "text": "这里就是那个舱口，但是离得很远。"}, {"type": "subtitle", "time": 12188.229, "timestamp": "03:23:08", "text": "我们就到这儿来吧。"}, {"type": "subtitle", "time": 12190.309, "timestamp": "03:23:10", "text": "这些人到底怎么了？"}, {"type": "subtitle", "time": 12194.95, "timestamp": "03:23:14", "text": "亚洲服务器到底怎么了？ 我的上帝。"}, {"type": "subtitle", "time": 12198.469, "timestamp": "03:23:18", "text": "我当时觉得它"}, {"type": "subtitle", "time": 12201.11, "timestamp": "03:23:21", "text": "是毒性最大的。"}, {"type": "subtitle", "time": 12204.229, "timestamp": "03:23:24", "text": "北美服务器正常。"}, {"type": "subtitle", "time": 12206.95, "timestamp": "03:23:26", "text": "亚洲服务器简直是汗流浃背"}, {"type": "subtitle", "time": 12208.55, "timestamp": "03:23:28", "text": "。"}, {"type": "subtitle", "time": 12216.07, "timestamp": "03:23:36", "text": "你想重置还是返回？"}, {"type": "subtitle", "time": 12222.63, "timestamp": "03:23:42", "text": "你决定。"}, {"type": "subtitle", "time": 12228.469, "timestamp": "03:23:48", "text": "我们可以走了。 想去吗？ 仍然想去。"}, {"type": "subtitle", "time": 12231.59, "timestamp": "03:23:51", "text": "他们仍在战斗。"}, {"type": "subtitle", "time": 12234.469, "timestamp": "03:23:54", "text": "呃，看，看左边。 好的，你"}]
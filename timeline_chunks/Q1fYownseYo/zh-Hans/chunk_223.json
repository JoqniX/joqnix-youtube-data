[{"type": "subtitle", "time": 13381.269, "timestamp": "03:43:01", "text": "。他们都在。"}, {"type": "subtitle", "time": 13383.349, "timestamp": "03:43:03", "text": "他躲起来了。是"}, {"type": "subtitle", "time": 13384.07, "timestamp": "03:43:04", "text": "啊。"}, {"type": "subtitle", "time": 13385.51, "timestamp": "03:43:05", "text": "好吧。我得，我得干掉那个"}, {"type": "subtitle", "time": 13389.349, "timestamp": "03:43:09", "text": "该死的轰炸机。它在哪儿？"}, {"type": "subtitle", "time": 13391.51, "timestamp": "03:43:11", "text": "那玩意儿真是太烦人了。"}, {"type": "subtitle", "time": 13393.51, "timestamp": "03:43:13", "text": "好了，在这儿。我"}, {"type": "subtitle", "time": 13395.67, "timestamp": "03:43:15", "text": "得去干掉它。"}, {"type": "subtitle", "time": 13400.229, "timestamp": "03:43:20", "text": "啊，我死了。等等，等等。试着过来。"}, {"type": "subtitle", "time": 13402.309, "timestamp": "03:43:22", "text": "你死了吗？"}, {"type": "subtitle", "time": 13405.03, "timestamp": "03:43:25", "text": "有人吗？"}, {"type": "subtitle", "time": 13405.269, "timestamp": "03:43:25", "text": "啊，"}, {"type": "subtitle", "time": 13407.03, "timestamp": "03:43:27", "text": "他是我这边的。"}, {"type": "subtitle", "time": 13432.469, "timestamp": "03:43:52", "text": "[尖叫]"}, {"type": "subtitle", "time": 13433.349, "timestamp": "03:43:53", "text": "哦，它死了。"}, {"type": "subtitle", "time": 13434.469, "timestamp": "03:43:54", "text": "哦，"}, {"type": "subtitle", "time": 13436.07, "timestamp": "03:43:56", "text": "不。它没死。有人设定了"}, {"type": "subtitle", "time": 13437.189, "timestamp": "03:43:57", "text": "最后期限。"}]
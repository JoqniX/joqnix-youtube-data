[{"type": "subtitle", "time": 15362.389, "timestamp": "04:16:02", "text": "伙计。你真是个卑鄙小人。"}, {"type": "subtitle", "time": 15365.75, "timestamp": "04:16:05", "text": "你真可怜，伙计。"}, {"type": "subtitle", "time": 15367.11, "timestamp": "04:16:07", "text": "龙复活我。"}, {"type": "subtitle", "time": 15370.07, "timestamp": "04:16:10", "text": "别开枪。"}, {"type": "subtitle", "time": 15372.229, "timestamp": "04:16:12", "text": "好主意。他在屋顶上。他在"}, {"type": "subtitle", "time": 15374.79, "timestamp": "04:16:14", "text": "屋顶上。真恶心。你得复活我。我就在"}, {"type": "subtitle", "time": 15377.75, "timestamp": "04:16:17", "text": "你面前。真是太"}, {"type": "subtitle", "time": 15381.189, "timestamp": "04:16:21", "text": "可怜了。"}, {"type": "subtitle", "time": 15389.99, "timestamp": "04:16:29", "text": "那家伙真是太可怜了。我"}, {"type": "subtitle", "time": 15392.07, "timestamp": "04:16:32", "text": "向上帝发誓。那个拿着金色"}, {"type": "subtitle", "time": 15406.229, "timestamp": "04:16:46", "text": "正在制作一个。 我要走了。"}, {"type": "subtitle", "time": 15413.83, "timestamp": "04:16:53", "text": "他到底在哪儿？我要朝"}, {"type": "subtitle", "time": 15416.63, "timestamp": "04:16:56", "text": "他吐口水。"}, {"type": "subtitle", "time": 15418.95, "timestamp": "04:16:58", "text": "等等，他死了吗？死了。"}]
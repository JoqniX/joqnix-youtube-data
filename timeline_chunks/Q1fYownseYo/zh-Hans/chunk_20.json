[{"type": "subtitle", "time": 1217.35, "timestamp": "00:20:17", "text": "就让他们留着吧。 我不要。"}, {"type": "subtitle", "time": 1219.27, "timestamp": "00:20:19", "text": "为什么你们不做完"}, {"type": "subtitle", "time": 1222.63, "timestamp": "00:20:22", "text": "掩体里的准备工作就走了？"}, {"type": "subtitle", "time": 1236.23, "timestamp": "00:20:36", "text": "我没有鞋跟，对吧？"}, {"type": "subtitle", "time": 1247.99, "timestamp": "00:20:47", "text": "那么，接下来人们就会问"}, {"type": "subtitle", "time": 1251.19, "timestamp": "00:20:51", "text": "医生，这里的计划是什么？ 所以，"}, {"type": "subtitle", "time": 1255.029, "timestamp": "00:20:55", "text": "我的计划是把天线运到这里，"}, {"type": "subtitle", "time": 1258.95, "timestamp": "00:20:58", "text": "看看效果如何。"}]
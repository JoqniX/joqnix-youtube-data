[{"type": "subtitle", "time": 13745.99, "timestamp": "03:49:05", "text": "别交战。你什么都没有。"}, {"type": "subtitle", "time": 13747.429, "timestamp": "03:49:07", "text": "我有。"}, {"type": "subtitle", "time": 13760.469, "timestamp": "03:49:20", "text": "有人死了。"}, {"type": "subtitle", "time": 13764.309, "timestamp": "03:49:24", "text": "它没死。等等，我没死。"}, {"type": "subtitle", "time": 13766.309, "timestamp": "03:49:26", "text": "等等，别死。"}, {"type": "subtitle", "time": 13769.11, "timestamp": "03:49:29", "text": "有人死了。"}, {"type": "subtitle", "time": 13772.87, "timestamp": "03:49:32", "text": "什么？你。我的天哪。你想搜刮？"}, {"type": "subtitle", "time": 13774.309, "timestamp": "03:49:34", "text": "等等，他正在搜刮你什么的。"}, {"type": "subtitle", "time": 13775.67, "timestamp": "03:49:35", "text": "什么？不，"}, {"type": "subtitle", "time": 13777.429, "timestamp": "03:49:37", "text": "不，不。我说你想等着"}, {"type": "subtitle", "time": 13787.59, "timestamp": "03:49:47", "text": "好吧，来试试救我。我可以"}, {"type": "subtitle", "time": 13790.07, "timestamp": "03:49:50", "text": "瞬间干掉这东西。"}, {"type": "subtitle", "time": 13792.55, "timestamp": "03:49:52", "text": "他快要死了 死了。"}, {"type": "subtitle", "time": 13795.03, "timestamp": "03:49:55", "text": "是啊，"}, {"type": "subtitle", "time": 13797.67, "timestamp": "03:49:57", "text": "我感觉很糟糕。那家伙的队友。好吧，"}, {"type": "subtitle", "time": 13799.269, "timestamp": "03:49:59", "text": "他还活着。"}]
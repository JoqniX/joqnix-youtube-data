[{"type": "subtitle", "time": 3543.51, "timestamp": "00:59:03", "text": "氯胺酮。不，我现在没有多少氯胺酮了。"}, {"type": "subtitle", "time": 3546.069, "timestamp": "00:59:06", "text": "我会想办法的。"}, {"type": "subtitle", "time": 3549.27, "timestamp": "00:59:09", "text": "所以，中型和重型弹药。"}, {"type": "subtitle", "time": 3552.789, "timestamp": "00:59:12", "text": "重的。 一叠。 中等的。"}, {"type": "subtitle", "time": 3564.47, "timestamp": "00:59:24", "text": "我会这样走。 是的。 是的。 是的。"}, {"type": "subtitle", "time": 3571.99, "timestamp": "00:59:31", "text": "哦，别撒谎。 你就是来看"}, {"type": "subtitle", "time": 3573.43, "timestamp": "00:59:33", "text": "我的，对吧？"}, {"type": "subtitle", "time": 3575.91, "timestamp": "00:59:35", "text": "呃，"}, {"type": "subtitle", "time": 3578.309, "timestamp": "00:59:38", "text": "我要五个。 非常感谢"}, {"type": "subtitle", "time": 3580.069, "timestamp": "00:59:40", "text": "。"}, {"type": "subtitle", "time": 3582.069, "timestamp": "00:59:42", "text": "尽量不要那样做。 像这样。"}, {"type": "subtitle", "time": 3584.789, "timestamp": "00:59:44", "text": "好的。 因为我们没钱了。 我们需要"}, {"type": "subtitle", "time": 3587.43, "timestamp": "00:59:47", "text": "赚钱。"}]
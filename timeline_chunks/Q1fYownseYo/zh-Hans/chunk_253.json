[{"type": "subtitle", "time": 15186.469, "timestamp": "04:13:06", "text": "，它呼叫支援了吗？"}, {"type": "subtitle", "time": 15187.99, "timestamp": "04:13:07", "text": "没有。没有。"}, {"type": "subtitle", "time": 15195.75, "timestamp": "04:13:15", "text": "。让我试试从这里射击它。"}, {"type": "subtitle", "time": 15202.71, "timestamp": "04:13:22", "text": "哇。小心。"}, {"type": "subtitle", "time": 15209.91, "timestamp": "04:13:29", "text": "它喷火了。"}, {"type": "subtitle", "time": 15234.79, "timestamp": "04:13:54", "text": "破了。我的天啊，我的护盾破了。"}]
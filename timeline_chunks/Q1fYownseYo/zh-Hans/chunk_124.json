[{"type": "subtitle", "time": 7442.47, "timestamp": "02:04:02", "text": "。 工作。 小心。   它"}, {"type": "subtitle", "time": 7445.669, "timestamp": "02:04:05", "text": "正下方有一架轰炸机。"}, {"type": "subtitle", "time": 7452.79, "timestamp": "02:04:12", "text": "嗯……"}, {"type": "subtitle", "time": 7455.43, "timestamp": "02:04:15", "text": "我不知道。 我不知道"}, {"type": "subtitle", "time": 7456.229, "timestamp": "02:04:16", "text": "我的意思在哪里可以。   就这"}, {"type": "subtitle", "time": 7463.75, "timestamp": "02:04:23", "text": "哦，它锁定了某个人。 它"}, {"type": "subtitle", "time": 7465.83, "timestamp": "02:04:25", "text": "针对的就是你。"}, {"type": "subtitle", "time": 7470.149, "timestamp": "02:04:30", "text": "我？ 不，不是我。"}, {"type": "subtitle", "time": 7474.149, "timestamp": "02:04:34", "text": "可能有人会因为网络延迟而耽误时间。"}, {"type": "subtitle", "time": 7476.149, "timestamp": "02:04:36", "text": "我的天啊。"}, {"type": "subtitle", "time": 7481.43, "timestamp": "02:04:41", "text": "尽量多杀死黄蜂。 好了，我们可以结束这件事了。"}, {"type": "subtitle", "time": 7483.669, "timestamp": "02:04:43", "text": "嗯，是的。"}, {"type": "subtitle", "time": 7486.87, "timestamp": "02:04:46", "text": "我试试能不能在这里找到那个火箭人"}, {"type": "subtitle", "time": 7493.27, "timestamp": "02:04:53", "text": "让我看看。"}, {"type": "subtitle", "time": 7496.87, "timestamp": "02:04:56", "text": "我应该多准备些弹药。"}]
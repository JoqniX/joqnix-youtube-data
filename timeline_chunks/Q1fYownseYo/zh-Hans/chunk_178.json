[{"type": "subtitle", "time": 10682.07, "timestamp": "02:58:02", "text": "等等，你想知道是哪种弹药？"}, {"type": "subtitle", "time": 10687.99, "timestamp": "02:58:07", "text": "呃，"}, {"type": "subtitle", "time": 10690.87, "timestamp": "02:58:10", "text": "或者这里有人死了。"}, {"type": "subtitle", "time": 10691.19, "timestamp": "02:58:11", "text": "哦，"}, {"type": "subtitle", "time": 10693.269, "timestamp": "02:58:13", "text": "战利品。 抢劫。"}, {"type": "subtitle", "time": 10695.75, "timestamp": "02:58:15", "text": "什么也没有。"}, {"type": "subtitle", "time": 10698.389, "timestamp": "02:58:18", "text": "这里没有老鼠，对吧？   是的"}, {"type": "subtitle", "time": 10699.91, "timestamp": "02:58:19", "text": "。"}, {"type": "subtitle", "time": 10702.55, "timestamp": "02:58:22", "text": "或许那是一只老鼠。 是的。 或者"}, {"type": "subtitle", "time": 10704.95, "timestamp": "02:58:24", "text": "他被老鼠杀死了。 我不知道。"}, {"type": "subtitle", "time": 10711.269, "timestamp": "02:58:31", "text": "哦，等等。 实际上，我正想要那样。 我"}, {"type": "subtitle", "time": 10712.63, "timestamp": "02:58:32", "text": "想要那个。"}, {"type": "subtitle", "time": 10714.389, "timestamp": "02:58:34", "text": "你需要那个吗？ 好的。"}, {"type": "subtitle", "time": 10717.349, "timestamp": "02:58:37", "text": "呃，这里不行。"}, {"type": "subtitle", "time": 10720.95, "timestamp": "02:58:40", "text": "不，我可以自己做。 好的。"}]
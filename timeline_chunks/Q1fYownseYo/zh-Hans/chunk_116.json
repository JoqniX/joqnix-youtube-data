[{"type": "subtitle", "time": 6994.629, "timestamp": "01:56:34", "text": "没有人。 村子附近应该有一个"}, {"type": "subtitle", "time": 7003.03, "timestamp": "01:56:43", "text": "我有一个避免开枪的秘密武器"}, {"type": "subtitle", "time": 7005.669, "timestamp": "01:56:45", "text": "。"}, {"type": "subtitle", "time": 7007.669, "timestamp": "01:56:47", "text": "我敢肯定，如果你吹笛子，大多数情况下不会有人开枪打你"}, {"type": "subtitle", "time": 7019.27, "timestamp": "01:56:59", "text": "等等，你是谁？ 长笛。   是的"}]
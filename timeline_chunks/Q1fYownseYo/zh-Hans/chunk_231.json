[{"type": "subtitle", "time": 13861.67, "timestamp": "03:51:01", "text": "哦，拜托。那里有该死的栅栏。该死"}, {"type": "subtitle", "time": 13864.389, "timestamp": "03:51:04", "text": "。要爬过去"}, {"type": "subtitle", "time": 13865.349, "timestamp": "03:51:05", "text": "。"}, {"type": "subtitle", "time": 13870.95, "timestamp": "03:51:10", "text": "这些人根本不会玩"}, {"type": "subtitle", "time": 13873.349, "timestamp": "03:51:13", "text": "游戏。该死。"}, {"type": "subtitle", "time": 13881.83, "timestamp": "03:51:21", "text": "好吧，过来吧。我这就……"}, {"type": "subtitle", "time": 13887.75, "timestamp": "03:51:27", "text": "。砰。"}, {"type": "subtitle", "time": 13890.229, "timestamp": "03:51:30", "text": "好吧，有人真的用了最后期限"}, {"type": "subtitle", "time": 13895.75, "timestamp": "03:51:35", "text": "哦，"}, {"type": "subtitle", "time": 13897.51, "timestamp": "03:51:37", "text": "结束了吗？还没结束。结束了。结束了。结束了。"}, {"type": "subtitle", "time": 13901.83, "timestamp": "03:51:41", "text": "真的结束了。搜刮。搜刮。搜刮。搜刮。搜刮。搜刮。搜刮。"}, {"type": "subtitle", "time": 13913.11, "timestamp": "03:51:53", "text": "呃，对了，炸弹还活着"}, {"type": "subtitle", "time": 13914.71, "timestamp": "03:51:54", "text": "。小心点。"}, {"type": "subtitle", "time": 13917.269, "timestamp": "03:51:57", "text": "这里什么都没有，"}]
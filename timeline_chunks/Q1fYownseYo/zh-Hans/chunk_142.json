[{"type": "subtitle", "time": 8521.75, "timestamp": "02:22:01", "text": "我拍的。 我开枪了。 刚拍完。 跑步。"}, {"type": "subtitle", "time": 8524.63, "timestamp": "02:22:04", "text": "我们又拍了一遍。"}, {"type": "subtitle", "time": 8526.87, "timestamp": "02:22:06", "text": "哇。"}, {"type": "subtitle", "time": 8528.07, "timestamp": "02:22:08", "text": "等待。 快点，快点。"}, {"type": "subtitle", "time": 8534.87, "timestamp": "02:22:14", "text": "好的。"}, {"type": "subtitle", "time": 8559.51, "timestamp": "02:22:39", "text": "看看我得到了什么。"}, {"type": "subtitle", "time": 8561.83, "timestamp": "02:22:41", "text": "我也是。"}, {"type": "subtitle", "time": 8563.67, "timestamp": "02:22:43", "text": "爆破手榴弹。 我弄到了一罐"}, {"type": "subtitle", "time": 8566.87, "timestamp": "02:22:46", "text": "普通的火药。"}, {"type": "subtitle", "time": 8570.469, "timestamp": "02:22:50", "text": "哦，我又拿到了一份蓝图。"}, {"type": "subtitle", "time": 8573.03, "timestamp": "02:22:53", "text": "哦，拜托。"}, {"type": "subtitle", "time": 8576.79, "timestamp": "02:22:56", "text": "哦，我们走吧。 我以原价买了一个原装垫子"}, {"type": "subtitle", "time": 8577.99, "timestamp": "02:22:57", "text": "。"}]
[{"type": "subtitle", "time": 12847.83, "timestamp": "03:34:07", "text": "哦，我的天啊。"}, {"type": "subtitle", "time": 12851.51, "timestamp": "03:34:11", "text": "哦，什么鬼？他刚才躲开了？"}, {"type": "subtitle", "time": 12855.59, "timestamp": "03:34:15", "text": "他居然躲开了我的……什么？"}, {"type": "subtitle", "time": 12858.15, "timestamp": "03:34:18", "text": "太奇怪了。我 看到其他人在"}, {"type": "subtitle", "time": 12860.63, "timestamp": "03:34:20", "text": "打架吗？还是只有我们？"}, {"type": "subtitle", "time": 12864.15, "timestamp": "03:34:24", "text": "我想那是我。嗯，只有我。"}, {"type": "subtitle", "time": 12872.95, "timestamp": "03:34:32", "text": "哦，它卡住了。看，它卡住了。哦，"}, {"type": "subtitle", "time": 12896.95, "timestamp": "03:34:56", "text": "。"}]
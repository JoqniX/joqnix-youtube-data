[{"type": "subtitle", "time": 2707.03, "timestamp": "00:45:07", "text": "嘿，别开枪。"}, {"type": "subtitle", "time": 2709.67, "timestamp": "00:45:09", "text": "所有突袭者，屏幕上都有弧光。"}, {"type": "subtitle", "time": 2711.99, "timestamp": "00:45:11", "text": "还剩5分钟。 想办法回家。 我"}, {"type": "subtitle", "time": 2713.349, "timestamp": "00:45:13", "text": "再说一遍，5分钟。"}, {"type": "subtitle", "time": 2751.03, "timestamp": "00:45:51", "text": "游戏彻底崩溃了，"}, {"type": "subtitle", "time": 2758.63, "timestamp": "00:45:58", "text": "不要开枪。   我"}]
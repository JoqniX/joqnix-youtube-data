[{"type": "subtitle", "time": 7265.91, "timestamp": "02:01:05", "text": "坚持，稍等。 让我来消灭这只黄蜂。"}, {"type": "subtitle", "time": 7269.03, "timestamp": "02:01:09", "text": "快点。"}, {"type": "subtitle", "time": 7271.91, "timestamp": "02:01:11", "text": "好的。"}, {"type": "subtitle", "time": 7273.75, "timestamp": "02:01:13", "text": "哦。 快点。 我要开始"}, {"type": "subtitle", "time": 7275.669, "timestamp": "02:01:15", "text": "破坏了。"}, {"type": "subtitle", "time": 7275.91, "timestamp": "02:01:15", "text": "好的。"}, {"type": "subtitle", "time": 7284.47, "timestamp": "02:01:24", "text": "让我试着把它泄露出去。 走到它"}, {"type": "subtitle", "time": 7291.35, "timestamp": "02:01:31", "text": "哦，这里到处都是该死的机器人"}, {"type": "subtitle", "time": 7293.27, "timestamp": "02:01:33", "text": "。 耶稣。 你身上也有告密者"}, {"type": "subtitle", "time": 7302.629, "timestamp": "02:01:42", "text": "真他妈糟透了。"}, {"type": "subtitle", "time": 7311.589, "timestamp": "02:01:51", "text": "哦，它发现你了。"}, {"type": "subtitle", "time": 7316.07, "timestamp": "02:01:56", "text": "哦，沃姆伯就在附近。"}, {"type": "subtitle", "time": 7319.83, "timestamp": "02:01:59", "text": "啊，去他妈的玄学。"}]
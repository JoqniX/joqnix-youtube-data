[{"type": "subtitle", "time": 16681.269, "timestamp": "04:38:01", "text": "在后台播放，你可以这么做，"}, {"type": "subtitle", "time": 16688.629, "timestamp": "04:38:08", "text": "但基本上"}, {"type": "subtitle", "time": 16692.23, "timestamp": "04:38:12", "text": "观看直播并不需要它。"}, {"type": "subtitle", "time": 16696.07, "timestamp": "04:38:16", "text": "我这么做只是因为，嗯，"}, {"type": "subtitle", "time": 16699.349, "timestamp": "04:38:19", "text": "从今年四月开始，我就不能"}, {"type": "subtitle", "time": 16703.029, "timestamp": "04:38:23", "text": "在家里的电脑上进行直播了。"}, {"type": "subtitle", "time": 16706.15, "timestamp": "04:38:26", "text": "我在日本的时候会把它用作服务器。 所以"}, {"type": "subtitle", "time": 16709.189, "timestamp": "04:38:29", "text": "我会用我在印度的家里的电脑来"}, {"type": "subtitle", "time": 16715.029, "timestamp": "04:38:35", "text": "运营 2477 频道，这样那些"}, {"type": "subtitle", "time": 16716.789, "timestamp": "04:38:36", "text": "想看老内容的人就可以看了，对吧？"}, {"type": "subtitle", "time": 16720.789, "timestamp": "04:38:40", "text": "这就是我把它分开，"}, {"type": "subtitle", "time": 16722.869, "timestamp": "04:38:42", "text": "并为此创建了一个新的 Kick 频道的原因"}, {"type": "subtitle", "time": 16729.109, "timestamp": "04:38:49", "text": "。"}]
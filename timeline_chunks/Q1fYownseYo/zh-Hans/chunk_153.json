[{"type": "subtitle", "time": 9185.59, "timestamp": "02:33:05", "text": "那是你吗？"}, {"type": "subtitle", "time": 9192.309, "timestamp": "02:33:12", "text": "等等，"}, {"type": "subtitle", "time": 9196.309, "timestamp": "02:33:16", "text": "他只是得到一个角色吗？"}, {"type": "subtitle", "time": 9197.91, "timestamp": "02:33:17", "text": "这声音到底是从哪儿传来的"}, {"type": "subtitle", "time": 9199.11, "timestamp": "02:33:19", "text": "？"}, {"type": "subtitle", "time": 9205.11, "timestamp": "02:33:25", "text": "啊，真他妈的糟糕。 就在我"}, {"type": "subtitle", "time": 9206.95, "timestamp": "02:33:26", "text": "眼前。"}, {"type": "subtitle", "time": 9211.59, "timestamp": "02:33:31", "text": "哦，不。 你好。 怎么会？"}, {"type": "subtitle", "time": 9213.75, "timestamp": "02:33:33", "text": "哦，拜托。 这些"}, {"type": "subtitle", "time": 9215.946, "timestamp": "02:33:35", "text": "人到底是从哪儿冒出来的？"}, {"type": "subtitle", "time": 9223.91, "timestamp": "02:33:43", "text": "我发誓这东西就像《我的世界》里的苦力怕一样"}, {"type": "subtitle", "time": 9236.71, "timestamp": "02:33:56", "text": "好的。"}]
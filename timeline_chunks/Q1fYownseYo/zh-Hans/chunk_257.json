[{"type": "subtitle", "time": 15421.429, "timestamp": "04:17:01", "text": "是吗？"}, {"type": "subtitle", "time": 15423.99, "timestamp": "04:17:03", "text": "不，不是这家伙。这家伙已经被"}, {"type": "subtitle", "time": 15426.149, "timestamp": "04:17:06", "text": "搜刮过了。"}, {"type": "subtitle", "time": 15430.55, "timestamp": "04:17:10", "text": "呃，让我看看。还有一些东西。没有。"}, {"type": "subtitle", "time": 15433.189, "timestamp": "04:17:13", "text": "哦，我有舱门钥匙。我可以用"}, {"type": "subtitle", "time": 15453.99, "timestamp": "04:17:33", "text": "哦，我们走吧。我们走吧。"}, {"type": "subtitle", "time": 15455.269, "timestamp": "04:17:35", "text": "不是这家伙。这家伙对。"}, {"type": "subtitle", "time": 15456.71, "timestamp": "04:17:36", "text": "哦，是这家伙。"}, {"type": "subtitle", "time": 15459.349, "timestamp": "04:17:39", "text": "不，不，不。不是他。不是他。"}, {"type": "subtitle", "time": 15461.75, "timestamp": "04:17:41", "text": "别那样做。"}, {"type": "subtitle", "time": 15464.149, "timestamp": "04:17:44", "text": "我的天哪。他们会杀了你的。"}, {"type": "subtitle", "time": 15469.59, "timestamp": "04:17:49", "text": "来，来，来。我们走吧。我们走吧。"}, {"type": "subtitle", "time": 15471.59, "timestamp": "04:17:51", "text": "我们走吧。呃，火箭在这儿。"}, {"type": "subtitle", "time": 15473.04, "timestamp": "04:17:53", "text": "火箭在这儿。 哦，在这儿。让我来"}, {"type": "subtitle", "time": 15474.0, "timestamp": "04:17:54", "text": "哦，在这儿。让我来 帮帮这些人。"}]
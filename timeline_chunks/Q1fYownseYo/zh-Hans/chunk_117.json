[{"type": "subtitle", "time": 7041.35, "timestamp": "01:57:21", "text": "没人会用这玩意儿打你。 我"}, {"type": "subtitle", "time": 7043.99, "timestamp": "01:57:23", "text": "发誓。 没人会去杀一个"}, {"type": "subtitle", "time": 7052.55, "timestamp": "01:57:32", "text": "等等，笛子要怎么制作？"}, {"type": "subtitle", "time": 7054.87, "timestamp": "01:57:34", "text": "我不知道。 你不能。 我觉得"}, {"type": "subtitle", "time": 7057.35, "timestamp": "01:57:37", "text": "只有你能找到它。"}]
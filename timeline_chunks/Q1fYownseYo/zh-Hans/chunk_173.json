[{"type": "subtitle", "time": 10386.87, "timestamp": "02:53:06", "text": "下面有人。 上面。 下面"}, {"type": "subtitle", "time": 10388.87, "timestamp": "02:53:08", "text": "。 我不知道。"}, {"type": "subtitle", "time": 10392.15, "timestamp": "02:53:12", "text": "他妈的在哪儿？是你吗？"}, {"type": "subtitle", "time": 10393.91, "timestamp": "02:53:13", "text": "我支持你。"}, {"type": "subtitle", "time": 10396.55, "timestamp": "02:53:16", "text": "哦，下面。 下面。 下面。"}, {"type": "subtitle", "time": 10398.56, "timestamp": "02:53:18", "text": "下面。 不要开枪。"}, {"type": "subtitle", "time": 10401.04, "timestamp": "02:53:21", "text": "不要开枪。 我觉得他们很友善。"}, {"type": "subtitle", "time": 10418.07, "timestamp": "02:53:38", "text": "你扭伤脚踝了吗？ 你没有。"}, {"type": "subtitle", "time": 10419.99, "timestamp": "02:53:39", "text": "不。"}, {"type": "subtitle", "time": 10422.63, "timestamp": "02:53:42", "text": "就在你跳出来的时候，就像是"}, {"type": "subtitle", "time": 10425.03, "timestamp": "02:53:45", "text": "躲闪的时机一样。"}, {"type": "subtitle", "time": 10428.95, "timestamp": "02:53:48", "text": "试着把握时机说“糟糕”。 小心。   我的天啊"}, {"type": "subtitle", "time": 10431.67, "timestamp": "02:53:51", "text": "。 你"}, {"type": "subtitle", "time": 10434.55, "timestamp": "02:53:54", "text": "身后是……斯特莱德吗？"}, {"type": "subtitle", "time": 10435.67, "timestamp": "02:53:55", "text": "我死了。 我死了。"}, {"type": "subtitle", "time": 10438.389, "timestamp": "02:53:58", "text": "哦，该死。 你只有1点HP。 跑跑跑跑跑跑"}]
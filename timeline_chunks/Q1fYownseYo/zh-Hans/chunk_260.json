[{"type": "subtitle", "time": 15600.95, "timestamp": "04:20:00", "text": "他们怎么威胁的？我没听到枪声。"}, {"type": "subtitle", "time": 15608.63, "timestamp": "04:20:08", "text": "他们不知道。"}, {"type": "subtitle", "time": 15610.79, "timestamp": "04:20:10", "text": "我只听到了一组枪声。"}, {"type": "subtitle", "time": 15613.91, "timestamp": "04:20:13", "text": "处决他们。他们是可恶的人。"}, {"type": "subtitle", "time": 15615.91, "timestamp": "04:20:15", "text": "当大家都在合作的时候，你不能坐在那里告密。"}, {"type": "subtitle", "time": 15619.3, "timestamp": "04:20:19", "text": "去你的。"}, {"type": "subtitle", "time": 15630.229, "timestamp": "04:20:30", "text": "里面有一封蓝色的信 他的身体。"}, {"type": "subtitle", "time": 15632.389, "timestamp": "04:20:32", "text": "他他妈的……等等，不对。所以，另外两个人"}, {"type": "subtitle", "time": 15633.429, "timestamp": "04:20:33", "text": "就像……是的"}, {"type": "subtitle", "time": 15635.429, "timestamp": "04:20:35", "text": "，他们就死了。"}, {"type": "subtitle", "time": 15637.51, "timestamp": "04:20:37", "text": "只有一个方向传来一声枪响"}, {"type": "subtitle", "time": 15638.87, "timestamp": "04:20:38", "text": "。"}, {"type": "subtitle", "time": 15640.63, "timestamp": "04:20:40", "text": "是的，真的只有一连串"}, {"type": "subtitle", "time": 15642.229, "timestamp": "04:20:42", "text": "枪声。"}, {"type": "subtitle", "time": 15643.59, "timestamp": "04:20:43", "text": "如果他们互相交战，我们肯定会"}, {"type": "subtitle", "time": 15644.389, "timestamp": "04:20:44", "text": "知道。"}, {"type": "subtitle", "time": 15646.71, "timestamp": "04:20:46", "text": "他们……他们有完整的护盾。所以，"}, {"type": "subtitle", "time": 15649.189, "timestamp": "04:20:49", "text": "这两个人根本不可能"}]
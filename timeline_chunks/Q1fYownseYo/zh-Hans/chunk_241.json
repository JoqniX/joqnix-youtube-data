[{"type": "subtitle", "time": 14465.83, "timestamp": "04:01:05", "text": "我应该带狼群之类的吗？"}, {"type": "subtitle", "time": 14476.229, "timestamp": "04:01:16", "text": "不过我会带老鼠。是的。"}, {"type": "subtitle", "time": 14478.55, "timestamp": "04:01:18", "text": "等等，从女王那里能得到什么？"}, {"type": "subtitle", "time": 14482.15, "timestamp": "04:01:22", "text": "什么战利品？反应堆。有点像……"}, {"type": "subtitle", "time": 14484.55, "timestamp": "04:01:24", "text": "呃，女族长，不过是女王"}, {"type": "subtitle", "time": 14486.07, "timestamp": "04:01:26", "text": "反应堆。但你必须要有女王"}, {"type": "subtitle", "time": 14488.63, "timestamp": "04:01:28", "text": "反应堆。"}, {"type": "subtitle", "time": 14490.71, "timestamp": "04:01:30", "text": "我要带幸存者。不，"}, {"type": "subtitle", "time": 14501.75, "timestamp": "04:01:41", "text": "什么？什么？什么争论 你拿了吗？"}, {"type": "subtitle", "time": 14504.87, "timestamp": "04:01:44", "text": "Revor。[笑声]"}, {"type": "subtitle", "time": 14508.229, "timestamp": "04:01:48", "text": "好吧，我要拿了。我希望，我"}, {"type": "subtitle", "time": 14509.75, "timestamp": "04:01:49", "text": "发誓。"}, {"type": "subtitle", "time": 14510.71, "timestamp": "04:01:50", "text": "我不想死。"}, {"type": "subtitle", "time": 14514.95, "timestamp": "04:01:54", "text": "我只缺一些……基本"}]
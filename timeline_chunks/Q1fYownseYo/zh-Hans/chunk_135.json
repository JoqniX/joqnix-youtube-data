[{"type": "subtitle", "time": 8105.75, "timestamp": "02:15:05", "text": "哦，我没看到它那样击中我。"}, {"type": "subtitle", "time": 8112.55, "timestamp": "02:15:12", "text": "现在就种吧。 好了，好了，好了。 我得到了它。 知道了"}, {"type": "subtitle", "time": 8114.39, "timestamp": "02:15:14", "text": "。 我得到了它。"}, {"type": "subtitle", "time": 8115.83, "timestamp": "02:15:15", "text": "哦，不错。"}, {"type": "subtitle", "time": 8124.87, "timestamp": "02:15:24", "text": "，乔克。 你很快就让我恢复了过来"}, {"type": "subtitle", "time": 8128.069, "timestamp": "02:15:28", "text": "。 在哪里？ 在哪里？ 在哪里？"}, {"type": "subtitle", "time": 8130.069, "timestamp": "02:15:30", "text": "你在哪里？"}, {"type": "subtitle", "time": 8132.229, "timestamp": "02:15:32", "text": "我在这里。 我在这里。"}, {"type": "subtitle", "time": 8134.47, "timestamp": "02:15:34", "text": "我正站在马路中间。"}, {"type": "subtitle", "time": 8135.669, "timestamp": "02:15:35", "text": "我的天啊。   好了"}, {"type": "subtitle", "time": 8137.43, "timestamp": "02:15:37", "text": "。"}, {"type": "subtitle", "time": 8140.47, "timestamp": "02:15:40", "text": "哦，你在哪里做的？ 你是怎么"}, {"type": "subtitle", "time": 8142.55, "timestamp": "02:15:42", "text": "做到的？"}, {"type": "subtitle", "time": 8146.47, "timestamp": "02:15:46", "text": "哦，只要把无人机击晕就行了。 当"}, {"type": "subtitle", "time": 8148.069, "timestamp": "02:15:48", "text": "火箭发射完毕，火箭就会"}, {"type": "subtitle", "time": 8149.43, "timestamp": "02:15:49", "text": "坠落，对吧？ 它会"}, {"type": "subtitle", "time": 8151.669, "timestamp": "02:15:51", "text": "坠落到地面。 然后我就"}, {"type": "subtitle", "time": 8152.709, "timestamp": "02:15:52", "text": "爬上去把它"}, {"type": "subtitle", "time": 8155.83, "timestamp": "02:15:55", "text": "拍下来，并设定一个截止日期。"}, {"type": "subtitle", "time": 8158.709, "timestamp": "02:15:58", "text": "务必设定一个截止日期。 是的。"}]
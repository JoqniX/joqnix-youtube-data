[{"type": "subtitle", "time": 15327.83, "timestamp": "04:15:27", "text": "等等，你拿到反应堆车了吗？"}, {"type": "subtitle", "time": 15329.189, "timestamp": "04:15:29", "text": "嗯，我有一辆。"}, {"type": "subtitle", "time": 15345.83, "timestamp": "04:15:45", "text": "它死了。它死了。准备好了"}, {"type": "subtitle", "time": 15348.149, "timestamp": "04:15:48", "text": "。冲啊，冲啊，冲啊，冲啊，冲啊。我来了。"}, {"type": "subtitle", "time": 15353.91, "timestamp": "04:15:53", "text": "哦，有人抢先一步了。操。该死"}, {"type": "subtitle", "time": 15358.229, "timestamp": "04:15:58", "text": "准备好了，"}]
[{"type": "subtitle", "time": 9060.15, "timestamp": "02:31:00", "text": "这东西完全颠倒了。"}, {"type": "subtitle", "time": 9062.63, "timestamp": "02:31:02", "text": "哦，它要飞起来了。   是的"}, {"type": "subtitle", "time": 9080.63, "timestamp": "02:31:20", "text": "女王和女族长有"}, {"type": "subtitle", "time": 9082.63, "timestamp": "02:31:22", "text": "什么区别？"}, {"type": "subtitle", "time": 9083.19, "timestamp": "02:31:23", "text": "如何做到相同？   没错"}, {"type": "subtitle", "time": 9084.71, "timestamp": "02:31:24", "text": "。"}, {"type": "subtitle", "time": 9087.59, "timestamp": "02:31:27", "text": "它们不一样。 雌性首领体型更大，"}, {"type": "subtitle", "time": 9090.07, "timestamp": "02:31:30", "text": "移动更少，攻击性也更低。 它"}, {"type": "subtitle", "time": 9093.19, "timestamp": "02:31:33", "text": "主要像其他"}, {"type": "subtitle", "time": 9096.389, "timestamp": "02:31:36", "text": "角色一样召唤，比如堡垒和轰炸兵。"}, {"type": "subtitle", "time": 9101.03, "timestamp": "02:31:41", "text": "女王有很多东西，"}, {"type": "subtitle", "time": 9103.67, "timestamp": "02:31:43", "text": "比如她有一个激光束眩晕"}, {"type": "subtitle", "time": 9104.63, "timestamp": "02:31:44", "text": "护盾。"}, {"type": "subtitle", "time": 9105.99, "timestamp": "02:31:45", "text": "哦，那东西是……"}, {"type": "subtitle", "time": 9108.95, "timestamp": "02:31:48", "text": "机枪。"}, {"type": "subtitle", "time": 9111.59, "timestamp": "02:31:51", "text": "你想毁掉这台碎纸机吗？"}, {"type": "subtitle", "time": 9114.07, "timestamp": "02:31:54", "text": "我可以。 它并不难杀死。"}, {"type": "subtitle", "time": 9117.59, "timestamp": "02:31:57", "text": "天哪，我就是这么做的。"}]
[{"type": "subtitle", "time": 2948.95, "timestamp": "00:49:08", "text": "我们往东走回家吧。"}, {"type": "subtitle", "time": 2955.43, "timestamp": "00:49:15", "text": "好了，没事了。 没关系。 我承认，我"}, {"type": "subtitle", "time": 2957.829, "timestamp": "00:49:17", "text": "不能放弃他。 我想送"}, {"type": "subtitle", "time": 2962.549, "timestamp": "00:49:22", "text": "他东西，但他却给了我一块铁砧。 哦，对了"}, {"type": "subtitle", "time": 2970.87, "timestamp": "00:49:30", "text": "千钧一发。 我的天哪。"}, {"type": "subtitle", "time": 2974.069, "timestamp": "00:49:34", "text": "兄弟，他免费送了我一个铁砧。 我要买"}, {"type": "subtitle", "time": 2976.95, "timestamp": "00:49:36", "text": "它。 我要买它。"}, {"type": "subtitle", "time": 2990.71, "timestamp": "00:49:50", "text": "决不。 决不。"}, {"type": "subtitle", "time": 2992.79, "timestamp": "00:49:52", "text": "什么事，"}, {"type": "subtitle", "time": 2999.27, "timestamp": "00:49:59", "text": "决不。 游戏中最佳的论点"}]
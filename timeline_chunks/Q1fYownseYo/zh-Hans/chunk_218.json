[{"type": "subtitle", "time": 13085.269, "timestamp": "03:38:05", "text": "它怎么这么耐打？"}, {"type": "subtitle", "time": 13093.75, "timestamp": "03:38:13", "text": "它来了。它来了。"}, {"type": "subtitle", "time": 13097.19, "timestamp": "03:38:17", "text": "我想去那里。"}, {"type": "subtitle", "time": 13103.51, "timestamp": "03:38:23", "text": "什么？"}, {"type": "subtitle", "time": 13106.95, "timestamp": "03:38:26", "text": "你在哪儿？它在我这儿。"}, {"type": "subtitle", "time": 13109.51, "timestamp": "03:38:29", "text": "什么鬼？我怎么没打中？"}, {"type": "subtitle", "time": 13110.95, "timestamp": "03:38:30", "text": "哦，你在摧毁火箭。好吧，"}, {"type": "subtitle", "time": 13113.349, "timestamp": "03:38:33", "text": "好吧，好吧，好吧。那我……是的，我也"}, {"type": "subtitle", "time": 13131.99, "timestamp": "03:38:51", "text": "该死的蜱虫？"}, {"type": "subtitle", "time": 13134.07, "timestamp": "03:38:54", "text": "该死的蜱虫。我向上帝发誓，我恨死这该死的……它在哪儿"}]
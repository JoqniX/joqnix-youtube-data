[{"type": "subtitle", "time": 14944.55, "timestamp": "04:09:04", "text": "能量弹药了。"}, {"type": "subtitle", "time": 14947.269, "timestamp": "04:09:07", "text": "我的天啊，"}, {"type": "subtitle", "time": 14950.95, "timestamp": "04:09:10", "text": "我的电脑快没电了。我的天啊。"}, {"type": "subtitle", "time": 14951.189, "timestamp": "04:09:11", "text": "好了，"}, {"type": "subtitle", "time": 14953.59, "timestamp": "04:09:13", "text": "趴下。趴下。等等，你"}, {"type": "subtitle", "time": 14960.229, "timestamp": "04:09:20", "text": "我要出来了。是"}, {"type": "subtitle", "time": 14967.51, "timestamp": "04:09:27", "text": "你真的要在这里救我吗"}, {"type": "subtitle", "time": 14974.79, "timestamp": "04:09:34", "text": "离开。"}, {"type": "subtitle", "time": 14977.59, "timestamp": "04:09:37", "text": "收割机太可怕了。"}, {"type": "subtitle", "time": 14980.309, "timestamp": "04:09:40", "text": "我知道很多人都在搜刮"}, {"type": "subtitle", "time": 14982.79, "timestamp": "04:09:42", "text": "它。所以它们才会那么"}, {"type": "subtitle", "time": 14990.87, "timestamp": "04:09:50", "text": "等等，有人死了吗？我们"}, {"type": "subtitle", "time": 14992.79, "timestamp": "04:09:52", "text": "找个安全的地方，然后试试能不能打死"}]
[{"type": "subtitle", "time": 6480.31, "timestamp": "01:48:00", "text": "哦，等等。 我会给"}, {"type": "subtitle", "time": 6484.31, "timestamp": "01:48:04", "text": "你打电话。 等等，我有Discord吗？"}, {"type": "subtitle", "time": 6486.39, "timestamp": "01:48:06", "text": "好的，我有了。"}, {"type": "subtitle", "time": 6496.87, "timestamp": "01:48:16", "text": "呃，"}, {"type": "subtitle", "time": 6513.109, "timestamp": "01:48:33", "text": "你能听到我吗？   是的"}, {"type": "subtitle", "time": 6515.109, "timestamp": "01:48:35", "text": "。"}, {"type": "subtitle", "time": 6518.31, "timestamp": "01:48:38", "text": "好的，让我们在蓝门这里发射火箭吧"}, {"type": "subtitle", "time": 6520.629, "timestamp": "01:48:40", "text": "。 呃，"}, {"type": "subtitle", "time": 6523.669, "timestamp": "01:48:43", "text": "你只需要准备一个铁砧，让它"}, {"type": "subtitle", "time": 6526.709, "timestamp": "01:48:46", "text": "瞄准你，剩下的交给我来做。"}, {"type": "subtitle", "time": 6527.109, "timestamp": "01:48:47", "text": "砧。"}, {"type": "subtitle", "time": 6529.35, "timestamp": "01:48:49", "text": "我试试疯狂一把。"}, {"type": "subtitle", "time": 6531.03, "timestamp": "01:48:51", "text": "试着射击一下。"}, {"type": "subtitle", "time": 6532.39, "timestamp": "01:48:52", "text": "让它盯上你。"}, {"type": "subtitle", "time": 6535.43, "timestamp": "01:48:55", "text": "你用的是什么枪？"}]
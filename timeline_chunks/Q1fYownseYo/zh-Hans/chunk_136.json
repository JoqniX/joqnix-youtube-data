[{"type": "subtitle", "time": 8160.39, "timestamp": "02:16:00", "text": "啊，是的"}, {"type": "subtitle", "time": 8162.31, "timestamp": "02:16:02", "text": "。   动作"}, {"type": "subtitle", "time": 8163.91, "timestamp": "02:16:03", "text": "要快，否则它会飞"}, {"type": "subtitle", "time": 8166.629, "timestamp": "02:16:06", "text": "起来，然后把你摔下来。"}, {"type": "subtitle", "time": 8173.75, "timestamp": "02:16:13", "text": "十分钟之内逃出去。 我今天再说一遍，否则就"}, {"type": "subtitle", "time": 8177.109, "timestamp": "02:16:17", "text": "滚蛋。"}, {"type": "subtitle", "time": 8178.87, "timestamp": "02:16:18", "text": "完成它。 我们走吧。 我们"}, {"type": "subtitle", "time": 8181.35, "timestamp": "02:16:21", "text": "走吧。"}, {"type": "subtitle", "time": 8182.55, "timestamp": "02:16:22", "text": "明显地。"}, {"type": "subtitle", "time": 8185.669, "timestamp": "02:16:25", "text": "我的天哪，好远啊。"}, {"type": "subtitle", "time": 8195.11, "timestamp": "02:16:35", "text": "我们取得了很大进展。"}, {"type": "subtitle", "time": 8197.349, "timestamp": "02:16:37", "text": "我们还有多少积分？"}, {"type": "subtitle", "time": 8199.509, "timestamp": "02:16:39", "text": "我们完成了吗？"}, {"type": "subtitle", "time": 8205.75, "timestamp": "02:16:45", "text": "就一个。 只有一个截止日期。"}, {"type": "subtitle", "time": 8208.15, "timestamp": "02:16:48", "text": "我上周也是用同样的方法攻克了堡垒。 把"}, {"type": "subtitle", "time": 8210.629, "timestamp": "02:16:50", "text": "截止日期抛在脑后就好。 就差一个"}, {"type": "subtitle", "time": 8213.19, "timestamp": "02:16:53", "text": "截止日期，我就拿到了"}, {"type": "subtitle", "time": 8214.95, "timestamp": "02:16:54", "text": "满分。"}]
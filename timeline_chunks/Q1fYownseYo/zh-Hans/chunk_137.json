[{"type": "subtitle", "time": 8233.11, "timestamp": "02:17:13", "text": "咱们回程路上做黄蜂吧"}, {"type": "subtitle", "time": 8234.389, "timestamp": "02:17:14", "text": "。 是的。   是的"}, {"type": "subtitle", "time": 8238.549, "timestamp": "02:17:18", "text": "。  Alex，我们到那儿吧，然后我们……"}, {"type": "subtitle", "time": 8240.309, "timestamp": "02:17:20", "text": "我的意思是，快到了，是吗？快到了吗？"}, {"type": "subtitle", "time": 8245.27, "timestamp": "02:17:25", "text": "哦等等，那是我的信号……抱歉，那是我的信号……"}, {"type": "subtitle", "time": 8247.99, "timestamp": "02:17:27", "text": "那是我的信号……是啊，"}, {"type": "subtitle", "time": 8261.99, "timestamp": "02:17:41", "text": "我的武器在哪儿？哦，三……好吧，我的武器"}, {"type": "subtitle", "time": 8273.349, "timestamp": "02:17:53", "text": "去死吧，乔。"}]
[{"type": "subtitle", "time": 13021.67, "timestamp": "03:37:01", "text": "他们中的一些人在打堡垒。"}, {"type": "subtitle", "time": 13023.83, "timestamp": "03:37:03", "text": "那边有堡垒的声音"}, {"type": "subtitle", "time": 13024.229, "timestamp": "03:37:04", "text": "。"}, {"type": "subtitle", "time": 13026.95, "timestamp": "03:37:06", "text": "那我们可以去那儿。是"}, {"type": "subtitle", "time": 13031.59, "timestamp": "03:37:11", "text": "啊。我的天啊 天哪。看到火箭"}, {"type": "subtitle", "time": 13034.15, "timestamp": "03:37:14", "text": "跳跃者和轰炸者了。"}, {"type": "subtitle", "time": 13035.67, "timestamp": "03:37:15", "text": "我们想去那里。"}, {"type": "subtitle", "time": 13037.11, "timestamp": "03:37:17", "text": "操。操。操。操。操。操。操。操。操。操。操。操。操。"}, {"type": "subtitle", "time": 13039.51, "timestamp": "03:37:19", "text": "操。他们看到我们了。"}, {"type": "subtitle", "time": 13046.389, "timestamp": "03:37:26", "text": "火箭人来了。"}, {"type": "subtitle", "time": 13048.79, "timestamp": "03:37:28", "text": "我忘了它发射导弹就像扔"}, {"type": "subtitle", "time": 13058.07, "timestamp": "03:37:38", "text": "你在召唤火箭吗？是的，"}]
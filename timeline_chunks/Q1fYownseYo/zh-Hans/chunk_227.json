[{"type": "subtitle", "time": 13620.309, "timestamp": "03:47:00", "text": "好的，我有幸存者。"}, {"type": "subtitle", "time": 13623.429, "timestamp": "03:47:03", "text": "慢慢爬。别着急。冷静地"}, {"type": "subtitle", "time": 13626.55, "timestamp": "03:47:06", "text": "爬过来。"}, {"type": "subtitle", "time": 13630.389, "timestamp": "03:47:10", "text": "但你快死了。操。哇"}, {"type": "subtitle", "time": 13632.229, "timestamp": "03:47:12", "text": "。我死了。别告诉别人。我"}, {"type": "subtitle", "time": 13635.59, "timestamp": "03:47:15", "text": "要死了。我死了。在"}, {"type": "subtitle", "time": 13637.269, "timestamp": "03:47:17", "text": "你快死之前，你能标记一下"}, {"type": "subtitle", "time": 13640.309, "timestamp": "03:47:20", "text": "最近的舱门钥匙位置吗？在"}, {"type": "subtitle", "time": 13642.79, "timestamp": "03:47:22", "text": "你死之前最近的。"}, {"type": "subtitle", "time": 13645.83, "timestamp": "03:47:25", "text": "好的。你在哪里来着？"}, {"type": "subtitle", "time": 13648.87, "timestamp": "03:47:28", "text": "呃，舱门钥匙在这里。"}, {"type": "subtitle", "time": 13650.55, "timestamp": "03:47:30", "text": "哦，就在那边。好的。我离得好"}, {"type": "subtitle", "time": 13653.269, "timestamp": "03:47:33", "text": "近。"}, {"type": "subtitle", "time": 13656.229, "timestamp": "03:47:36", "text": "等等，你真的要不等我就"}, {"type": "subtitle", "time": 13657.83, "timestamp": "03:47:37", "text": "撤离了吗？为了"}, {"type": "subtitle", "time": 13661.91, "timestamp": "03:47:41", "text": "安全起见，我去那里和你碰面。是的"}, {"type": "subtitle", "time": 13664.79, "timestamp": "03:47:44", "text": "。轨道飞行器正在路上。安全窗口"}, {"type": "subtitle", "time": 13667.269, "timestamp": "03:47:47", "text": "正在关闭。你有10分钟时间"}, {"type": "subtitle", "time": 13669.429, "timestamp": "03:47:49", "text": "返回斯帕塔。我再说一遍，10"}, {"type": "subtitle", "time": 13671.91, "timestamp": "03:47:51", "text": "分钟。"}, {"type": "subtitle", "time": 13675.91, "timestamp": "03:47:55", "text": "好的，我已经找到一个反应堆了。"}, {"type": "subtitle", "time": 13676.309, "timestamp": "03:47:56", "text": "哦，"}, {"type": "subtitle", "time": 13678.55, "timestamp": "03:47:58", "text": "操。它快死了。两枪就"}]
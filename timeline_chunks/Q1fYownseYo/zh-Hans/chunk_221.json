[{"type": "subtitle", "time": 13300.15, "timestamp": "03:41:40", "text": "好了。我的饼干都用完了……"}, {"type": "subtitle", "time": 13301.99, "timestamp": "03:41:41", "text": "呃，有人在说话。告诉他们"}, {"type": "subtitle", "time": 13303.429, "timestamp": "03:41:43", "text": "不要开枪。"}, {"type": "subtitle", "time": 13312.71, "timestamp": "03:41:52", "text": "喂。喂。是的"}, {"type": "subtitle", "time": 13314.229, "timestamp": "03:41:54", "text": "。"}, {"type": "subtitle", "time": 13317.11, "timestamp": "03:41:57", "text": "我听到了日语。我"}, {"type": "subtitle", "time": 13317.75, "timestamp": "03:41:57", "text": "的天。"}]
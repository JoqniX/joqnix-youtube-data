[{"type": "subtitle", "time": 9001.03, "timestamp": "02:30:01", "text": "希望它不是玩家对战模式（PVP）。"}, {"type": "subtitle", "time": 9001.19, "timestamp": "02:30:01", "text": "这"}, {"type": "subtitle", "time": 9004.07, "timestamp": "02:30:04", "text": "取决于。 但是，呃，这种事确实会发生。 嗯，这"}, {"type": "subtitle", "time": 9015.11, "timestamp": "02:30:15", "text": "我不想失去铁砧。"}, {"type": "subtitle", "time": 9018.789, "timestamp": "02:30:18", "text": "我拿到我的长笛了。"}, {"type": "subtitle", "time": 9019.75, "timestamp": "02:30:19", "text": "[笑声]"}, {"type": "subtitle", "time": 9022.07, "timestamp": "02:30:22", "text": "谁都别想射笛子。   是的"}, {"type": "subtitle", "time": 9033.27, "timestamp": "02:30:33", "text": "哦，是的。 呃，现在你可以继续尝试"}, {"type": "subtitle", "time": 9036.71, "timestamp": "02:30:36", "text": "并打破纪录了。"}, {"type": "subtitle", "time": 9038.79, "timestamp": "02:30:38", "text": "嗯，是的。 是的。"}, {"type": "subtitle", "time": 9042.23, "timestamp": "02:30:42", "text": "我看到有人在《"}, {"type": "subtitle", "time": 9048.63, "timestamp": "02:30:48", "text": "疯狂了。 我的天啊。"}, {"type": "subtitle", "time": 9051.19, "timestamp": "02:30:51", "text": "太搞笑了。   是的"}, {"type": "subtitle", "time": 9054.23, "timestamp": "02:30:54", "text": "。 不知怎么的，我居然把"}, {"type": "subtitle", "time": 9057.99, "timestamp": "02:30:57", "text": "火箭兵给震晕了，然后它就翻转了。"}]
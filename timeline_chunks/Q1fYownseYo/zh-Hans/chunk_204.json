[{"type": "subtitle", "time": 12251.99, "timestamp": "03:24:11", "text": "我不明白为什么。 你"}, {"type": "subtitle", "time": 12254.55, "timestamp": "03:24:14", "text": "之前在做什么？"}, {"type": "subtitle", "time": 12256.63, "timestamp": "03:24:16", "text": "我只是在跑步。"}, {"type": "subtitle", "time": 12267.11, "timestamp": "03:24:27", "text": "亚历克斯，"}, {"type": "subtitle", "time": 12287.19, "timestamp": "03:24:47", "text": "。"}, {"type": "subtitle", "time": 12288.15, "timestamp": "03:24:48", "text": "我的上帝。"}, {"type": "subtitle", "time": 12290.63, "timestamp": "03:24:50", "text": "是因为你的枪吗？ 他们会"}, {"type": "subtitle", "time": 12293.19, "timestamp": "03:24:53", "text": "说：“哦，是的，我想要。”"}, {"type": "subtitle", "time": 12295.269, "timestamp": "03:24:55", "text": "他们无法看清远处的物体。"}, {"type": "subtitle", "time": 12298.95, "timestamp": "03:24:58", "text": "它们可以跑得很远。"}]
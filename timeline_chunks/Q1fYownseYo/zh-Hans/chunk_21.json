[{"type": "subtitle", "time": 1261.99, "timestamp": "00:21:01", "text": "显然，你得……哦，"}, {"type": "subtitle", "time": 1267.59, "timestamp": "00:21:07", "text": "我的天哪。 火箭人。"}, {"type": "subtitle", "time": 1269.75, "timestamp": "00:21:09", "text": "显然，你需要解锁。"}, {"type": "subtitle", "time": 1271.75, "timestamp": "00:21:11", "text": "掠夺者们注意了。 北天线"}, {"type": "subtitle", "time": 1284.71, "timestamp": "00:21:24", "text": "不要开枪。"}, {"type": "subtitle", "time": 1314.39, "timestamp": "00:21:54", "text": "另外，这个公告最终"}, {"type": "subtitle", "time": 1316.789, "timestamp": "00:21:56", "text": "发布了吗？ 我的天哪，这要花好多"}]
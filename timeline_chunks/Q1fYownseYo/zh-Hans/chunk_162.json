[{"type": "subtitle", "time": 9723.03, "timestamp": "02:42:03", "text": "真想直接退出游戏，然后质问对方："}, {"type": "subtitle", "time": 9725.67, "timestamp": "02:42:05", "text": "“你们为什么要打PVP？这"}, {"type": "subtitle", "time": 9731.27, "timestamp": "02:42:11", "text": "明明是PVE服务器啊。”"}, {"type": "subtitle", "time": 9733.75, "timestamp": "02:42:13", "text": "婊子，这是目的论。"}, {"type": "subtitle", "time": 9737.349, "timestamp": "02:42:17", "text": "没有怜悯。"}, {"type": "subtitle", "time": 9738.07, "timestamp": "02:42:18", "text": "为什么？"}, {"type": "subtitle", "time": 9741.67, "timestamp": "02:42:21", "text": "嗯，这要看情况。 实际上，这要看情况。"}, {"type": "subtitle", "time": 9745.91, "timestamp": "02:42:25", "text": "我丢了很多好东西。"}, {"type": "subtitle", "time": 9748.55, "timestamp": "02:42:28", "text": "现在你输得就像"}, {"type": "subtitle", "time": 9750.55, "timestamp": "02:42:30", "text": "我的铁砧一样。"}, {"type": "subtitle", "time": 9757.75, "timestamp": "02:42:37", "text": "我其实有……等等，你是不是也把"}, {"type": "subtitle", "time": 9761.19, "timestamp": "02:42:41", "text": "录音机弄丢了？ 液体。"}, {"type": "subtitle", "time": 9763.75, "timestamp": "02:42:43", "text": "不，是我的笛子。"}, {"type": "subtitle", "time": 9765.51, "timestamp": "02:42:45", "text": "不，"}, {"type": "subtitle", "time": 9769.19, "timestamp": "02:42:49", "text": "我还有一个摇酒器。 没关系。"}, {"type": "subtitle", "time": 9771.59, "timestamp": "02:42:51", "text": "你知道吗？ 我们重新装弹出发。 进去"}, {"type": "subtitle", "time": 9774.012, "timestamp": "02:42:54", "text": "杀人。"}, {"type": "subtitle", "time": 9774.389, "timestamp": "02:42:54", "text": "[笑声]"}, {"type": "subtitle", "time": 9774.79, "timestamp": "02:42:54", "text": "我不。"}, {"type": "subtitle", "time": 9777.51, "timestamp": "02:42:57", "text": "还有流行音乐。"}]
[{"type": "subtitle", "time": 10761.67, "timestamp": "02:59:21", "text": "你受伤了吗？ 不，我朝你扔了火"}, {"type": "subtitle", "time": 10773.99, "timestamp": "02:59:33", "text": "第46关。"}, {"type": "subtitle", "time": 10777.269, "timestamp": "02:59:37", "text": "好的。 我得到了什么？"}, {"type": "subtitle", "time": 10778.64, "timestamp": "02:59:38", "text": "我得到了什么？ 水平握持。 枪口制退器三。"}, {"type": "subtitle", "time": 10783.84, "timestamp": "02:59:43", "text": "水平握持。 枪口制退器三。 蓝图。 该死的照明弹蓝图。"}, {"type": "subtitle", "time": 10786.664, "timestamp": "02:59:46", "text": "蓝图。 该死的照明弹蓝图。 [笑声]"}, {"type": "subtitle", "time": 10787.68, "timestamp": "02:59:47", "text": "[笑声] 他拿到了一份信号弹的设计图。"}]
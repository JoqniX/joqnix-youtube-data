[{"type": "subtitle", "time": 14285.03, "timestamp": "03:58:05", "text": "哦，我把蓝色的弄丢了。"}, {"type": "subtitle", "time": 14288.55, "timestamp": "03:58:08", "text": "我失去了我的蓝色论点。啊，"}, {"type": "subtitle", "time": 14300.15, "timestamp": "03:58:20", "text": "别担心。只是蓝色的阿曼。"}, {"type": "subtitle", "time": 14304.15, "timestamp": "03:58:24", "text": "我应该选择幸存者吗？我不知道。"}, {"type": "subtitle", "time": 14307.67, "timestamp": "03:58:27", "text": "是的，你可以。是"}, {"type": "subtitle", "time": 14309.349, "timestamp": "03:58:29", "text": "什么阻止你？反正你总有一天要用到它"}, {"type": "subtitle", "time": 14312.63, "timestamp": "03:58:32", "text": "。"}, {"type": "subtitle", "time": 14325.11, "timestamp": "03:58:45", "text": "制作了三个。"}, {"type": "subtitle", "time": 14325.51, "timestamp": "03:58:45", "text": "嗯。"}, {"type": "subtitle", "time": 14329.349, "timestamp": "03:58:49", "text": "高级电子元件"}, {"type": "subtitle", "time": 14332.15, "timestamp": "03:58:52", "text": "很难找到，我想。不，它并不"}, {"type": "subtitle", "time": 14335.429, "timestamp": "03:58:55", "text": "难，但我必须"}, {"type": "subtitle", "time": 14339.03, "timestamp": "03:58:59", "text": "进去找到它。"}]
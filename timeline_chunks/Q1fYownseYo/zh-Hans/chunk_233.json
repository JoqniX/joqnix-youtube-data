[{"type": "subtitle", "time": 13986.389, "timestamp": "03:53:06", "text": "哦，看，快跑。看，看。哦，真是个"}, {"type": "subtitle", "time": 13986.95, "timestamp": "03:53:06", "text": "混蛋。"}, {"type": "subtitle", "time": 13994.55, "timestamp": "03:53:14", "text": "相信任何人。我的天，这该死的……"}, {"type": "subtitle", "time": 14003.349, "timestamp": "03:53:23", "text": "以为你死了。死了。​​好了， 我先来"}, {"type": "subtitle", "time": 14005.91, "timestamp": "03:53:25", "text": "。好的。哦，等等。等等，等等，等等。"}, {"type": "subtitle", "time": 14009.189, "timestamp": "03:53:29", "text": "别等我了。"}, {"type": "subtitle", "time": 14010.389, "timestamp": "03:53:30", "text": "我觉得你来不了。"}, {"type": "subtitle", "time": 14013.349, "timestamp": "03:53:33", "text": "他还在PVP呢。我的天"}, {"type": "subtitle", "time": 14014.55, "timestamp": "03:53:34", "text": "，真是个混蛋。"}, {"type": "subtitle", "time": 14022.229, "timestamp": "03:53:42", "text": "我忘了把它放进保险箱里了。真他妈的。"}, {"type": "subtitle", "time": 14026.15, "timestamp": "03:53:46", "text": "不，"}, {"type": "subtitle", "time": 14028.15, "timestamp": "03:53:48", "text": "兄弟。"}, {"type": "subtitle", "time": 14030.63, "timestamp": "03:53:50", "text": "你也猜对了。"}, {"type": "subtitle", "time": 14031.189, "timestamp": "03:53:51", "text": "闭嘴。"}, {"type": "subtitle", "time": 14033.83, "timestamp": "03:53:53", "text": "你也猜对了。"}, {"type": "subtitle", "time": 14035.83, "timestamp": "03:53:55", "text": "等等，我的屏幕怎么了？哦，我"}, {"type": "subtitle", "time": 14039.429, "timestamp": "03:53:59", "text": "看到你的屏幕了。好的。兄弟，我出局了。"}]
[{"type": "subtitle", "time": 7981.43, "timestamp": "02:13:01", "text": "告密者又上位了。"}, {"type": "subtitle", "time": 7984.629, "timestamp": "02:13:04", "text": "试着向火箭兵开一枪，"}, {"type": "subtitle", "time": 7993.75, "timestamp": "02:13:13", "text": "好的，稍等一下。 它正朝这边过来。 呃，它在"}, {"type": "subtitle", "time": 7995.83, "timestamp": "02:13:15", "text": "哪儿？ 什么鬼？"}, {"type": "subtitle", "time": 7999.91, "timestamp": "02:13:19", "text": "等等，这个位置不好。 呃，我是在"}, {"type": "subtitle", "time": 8001.99, "timestamp": "02:13:21", "text": "哪个房间"}, {"type": "subtitle", "time": 8012.55, "timestamp": "02:13:32", "text": "好吧，这里没有屋顶。 啊，"}, {"type": "subtitle", "time": 8014.95, "timestamp": "02:13:34", "text": "我的建议是，就站在楼里就行了。"}, {"type": "subtitle", "time": 8015.75, "timestamp": "02:13:35", "text": "好的。"}, {"type": "subtitle", "time": 8017.83, "timestamp": "02:13:37", "text": "我走来。"}, {"type": "subtitle", "time": 8019.189, "timestamp": "02:13:39", "text": "它在哪里？ 它在哪里？ 它在哪里？"}, {"type": "subtitle", "time": 8020.709, "timestamp": "02:13:40", "text": "标记。"}, {"type": "subtitle", "time": 8022.149, "timestamp": "02:13:42", "text": "嗯，我看到了。"}, {"type": "subtitle", "time": 8025.75, "timestamp": "02:13:45", "text": "就像在我头顶上一样。 你看到了吗？"}, {"type": "subtitle", "time": 8036.709, "timestamp": "02:13:56", "text": "我死了。 我死了。 哦，你没死。"}]
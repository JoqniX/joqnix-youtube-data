[{"type": "subtitle", "time": 7560.55, "timestamp": "02:06:00", "text": "。"}, {"type": "subtitle", "time": 7563.27, "timestamp": "02:06:03", "text": "是的，"}, {"type": "subtitle", "time": 7565.51, "timestamp": "02:06:05", "text": "但是它们很难找到，因为"}, {"type": "subtitle", "time": 7567.43, "timestamp": "02:06:07", "text": "它们不像其他无人机那样有醒目的指示灯"}, {"type": "subtitle", "time": 7570.79, "timestamp": "02:06:10", "text": "。"}, {"type": "subtitle", "time": 7571.91, "timestamp": "02:06:11", "text": "这是什么？"}, {"type": "subtitle", "time": 7574.149, "timestamp": "02:06:14", "text": "跳跃者。 破败的房屋。"}, {"type": "subtitle", "time": 7576.31, "timestamp": "02:06:16", "text": "跳跃者。"}, {"type": "subtitle", "time": 7585.51, "timestamp": "02:06:25", "text": "观察员真多。 等等，还有另一块"}, {"type": "subtitle", "time": 7588.07, "timestamp": "02:06:28", "text": "岩石母体。"}, {"type": "subtitle", "time": 7590.229, "timestamp": "02:06:30", "text": "耶稣啊，为什么会有这么多炸弹？"}, {"type": "subtitle", "time": 7596.629, "timestamp": "02:06:36", "text": "某人被提取出来。"}, {"type": "subtitle", "time": 7600.39, "timestamp": "02:06:40", "text": "嗯，是的，有个男的。"}]
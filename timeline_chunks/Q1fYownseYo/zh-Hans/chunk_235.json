[{"type": "subtitle", "time": 14105.91, "timestamp": "03:55:05", "text": "想再来一局吗？[笑声]"}, {"type": "subtitle", "time": 14107.59, "timestamp": "03:55:07", "text": "可能要换服务器了。你应该"}, {"type": "subtitle", "time": 14109.67, "timestamp": "03:55:09", "text": "去我的服务器。"}, {"type": "subtitle", "time": 14120.55, "timestamp": "03:55:20", "text": "等等。"}, {"type": "subtitle", "time": 14129.51, "timestamp": "03:55:29", "text": "或者我可以邀请你吗？你可以退出"}, {"type": "subtitle", "time": 14131.99, "timestamp": "03:55:31", "text": "大厅，我再邀请你一次。"}, {"type": "subtitle", "time": 14134.309, "timestamp": "03:55:34", "text": "好的。"}, {"type": "subtitle", "time": 14137.11, "timestamp": "03:55:37", "text": "之后，我就去收拾东西"}, {"type": "subtitle", "time": 14141.189, "timestamp": "03:55:41", "text": "睡觉了。现在1点半了。是的。"}, {"type": "subtitle", "time": 14143.189, "timestamp": "03:55:43", "text": "糟糕。"}, {"type": "subtitle", "time": 14145.03, "timestamp": "03:55:45", "text": "最后一局。好的。最后一局。最后一局。"}]
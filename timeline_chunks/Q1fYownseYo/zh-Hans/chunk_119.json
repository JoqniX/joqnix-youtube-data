[{"type": "subtitle", "time": 7140.39, "timestamp": "01:59:00", "text": "有火箭专家吗？"}, {"type": "subtitle", "time": 7142.31, "timestamp": "01:59:02", "text": "肯定有。"}, {"type": "subtitle", "time": 7145.83, "timestamp": "01:59:05", "text": "那里有很多。"}, {"type": "subtitle", "time": 7146.709, "timestamp": "01:59:06", "text": "杀了他。"}, {"type": "subtitle", "time": 7155.669, "timestamp": "01:59:15", "text": "好的。"}, {"type": "subtitle", "time": 7157.03, "timestamp": "01:59:17", "text": "你吸毒了。"}, {"type": "subtitle", "time": 7157.669, "timestamp": "01:59:17", "text": "欢迎。"}, {"type": "subtitle", "time": 7160.229, "timestamp": "01:59:20", "text": "好的。 买套房子。 找个房子"}, {"type": "subtitle", "time": 7162.31, "timestamp": "01:59:22", "text": "躲起来。 这附近还有一架轰炸机"}, {"type": "subtitle", "time": 7164.87, "timestamp": "01:59:24", "text": "。"}, {"type": "subtitle", "time": 7167.669, "timestamp": "01:59:27", "text": "哦，等等。 我们应该在那栋楼里使用这个吗"}, {"type": "subtitle", "time": 7169.27, "timestamp": "01:59:29", "text": "？"}, {"type": "subtitle", "time": 7171.03, "timestamp": "01:59:31", "text": "呃，那边好像有一架轰炸机，"}, {"type": "subtitle", "time": 7181.75, "timestamp": "01:59:41", "text": "你好。 你好。 你好。"}, {"type": "subtitle", "time": 7185.35, "timestamp": "01:59:45", "text": "嘿，别开枪。"}, {"type": "subtitle", "time": 7193.938, "timestamp": "01:59:53", "text": "不要开枪。"}, {"type": "subtitle", "time": 7195.51, "timestamp": "01:59:55", "text": "[笑声]"}]
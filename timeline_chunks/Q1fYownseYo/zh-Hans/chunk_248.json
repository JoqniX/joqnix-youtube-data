[{"type": "subtitle", "time": 14881.51, "timestamp": "04:08:01", "text": "等等，你死了吗，"}, {"type": "subtitle", "time": 14884.71, "timestamp": "04:08:04", "text": "兄弟？快点。"}, {"type": "subtitle", "time": 14889.75, "timestamp": "04:08:09", "text": "哦，他们杀了我。快点，快点，快点。"}, {"type": "subtitle", "time": 14897.99, "timestamp": "04:08:17", "text": "你能救我吗？"}, {"type": "subtitle", "time": 14900.71, "timestamp": "04:08:20", "text": "不能。"}, {"type": "subtitle", "time": 14902.87, "timestamp": "04:08:22", "text": "但他们真的杀了你吗？"}, {"type": "subtitle", "time": 14924.95, "timestamp": "04:08:44", "text": "我把所有东西都搜刮干净了。 我的天啊，它们速度也太快了吧"}]
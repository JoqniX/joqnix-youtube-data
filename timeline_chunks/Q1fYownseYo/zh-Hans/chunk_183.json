[{"type": "subtitle", "time": 10985.59, "timestamp": "03:03:05", "text": "。"}, {"type": "subtitle", "time": 10986.469, "timestamp": "03:03:06", "text": "哦，真的吗？"}, {"type": "subtitle", "time": 10987.67, "timestamp": "03:03:07", "text": "你没有？"}, {"type": "subtitle", "time": 10991.03, "timestamp": "03:03:11", "text": "不，我只是把它藏起来了。"}, {"type": "subtitle", "time": 10994.469, "timestamp": "03:03:14", "text": "兄弟，别这样。 你总得"}, {"type": "subtitle", "time": 10995.83, "timestamp": "03:03:15", "text": "在某个时候用到它。   是的"}, {"type": "subtitle", "time": 11002.55, "timestamp": "03:03:22", "text": "好的。 我应该带些地雷，以防"}, {"type": "subtitle", "time": 11004.87, "timestamp": "03:03:24", "text": "有人袭击我们。"}, {"type": "subtitle", "time": 11016.309, "timestamp": "03:03:36", "text": "实地考察。"}, {"type": "subtitle", "time": 11017.91, "timestamp": "03:03:37", "text": "好的。"}, {"type": "subtitle", "time": 11019.429, "timestamp": "03:03:39", "text": "什么领域？"}, {"type": "subtitle", "time": 11022.15, "timestamp": "03:03:42", "text": "田野里的东西。 对，野战仓库。 如果"}, {"type": "subtitle", "time": 11028.63, "timestamp": "03:03:48", "text": "你需要什么？ 其中三个"}, {"type": "subtitle", "time": 11035.429, "timestamp": "03:03:55", "text": "需要交付三个才能完成"}]
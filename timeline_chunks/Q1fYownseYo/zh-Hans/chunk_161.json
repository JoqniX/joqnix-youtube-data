[{"type": "subtitle", "time": 9660.87, "timestamp": "02:41:00", "text": "挑战。 请。"}, {"type": "subtitle", "time": 9662.71, "timestamp": "02:41:02", "text": "这是一个完整的团队。"}, {"type": "subtitle", "time": 9665.11, "timestamp": "02:41:05", "text": "辞职。 寒意。 我们正在进行试验。 先生，请您帮个忙"}, {"type": "subtitle", "time": 9666.23, "timestamp": "02:41:06", "text": "。 等待。 坚持，稍等。"}, {"type": "subtitle", "time": 9670.15, "timestamp": "02:41:10", "text": "让我们各自散去吧。 请。 为什么？"}, {"type": "subtitle", "time": 9672.309, "timestamp": "02:41:12", "text": "共有两支队伍。"}, {"type": "subtitle", "time": 9674.87, "timestamp": "02:41:14", "text": "他们联手合作。 他们他妈的联手了。 该死的"}, {"type": "subtitle", "time": 9680.309, "timestamp": "02:41:20", "text": "挑战！ 哦，等等。 我有"}, {"type": "subtitle", "time": 9683.59, "timestamp": "02:41:23", "text": "很多很棒的东西。 不。"}, {"type": "subtitle", "time": 9684.63, "timestamp": "02:41:24", "text": "哦，好吧。"}, {"type": "subtitle", "time": 9693.19, "timestamp": "02:41:33", "text": "我告诉你。 这是斯特拉·蒙蒂。"}, {"type": "subtitle", "time": 9696.95, "timestamp": "02:41:36", "text": "唉，我们当时应该撤离的。"}, {"type": "subtitle", "time": 9698.95, "timestamp": "02:41:38", "text": "我告诉你。 别忘了这是"}, {"type": "subtitle", "time": 9700.71, "timestamp": "02:41:40", "text": "斯特拉。"}, {"type": "subtitle", "time": 9702.95, "timestamp": "02:41:42", "text": "他们居然还联手了。 两队"}, {"type": "subtitle", "time": 9705.67, "timestamp": "02:41:45", "text": "联手。 真是见鬼了。"}, {"type": "subtitle", "time": 9706.56, "timestamp": "02:41:46", "text": "真是见鬼了。 我们在PS上有7000元。 我当时"}]
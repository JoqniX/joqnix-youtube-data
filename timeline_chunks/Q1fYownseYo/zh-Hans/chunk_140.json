[{"type": "subtitle", "time": 8402.07, "timestamp": "02:20:02", "text": "。  [笑声]"}, {"type": "subtitle", "time": 8404.23, "timestamp": "02:20:04", "text": "等等，不。 等等，别，别。"}, {"type": "subtitle", "time": 8406.07, "timestamp": "02:20:06", "text": "当你射击它"}, {"type": "subtitle", "time": 8406.55, "timestamp": "02:20:06", "text": "或当是的时候，它会跳起来"}, {"type": "subtitle", "time": 8407.99, "timestamp": "02:20:07", "text": "。 我想放手一搏。   是的"}, {"type": "subtitle", "time": 8410.87, "timestamp": "02:20:10", "text": "。 电视节目真的想做出牺牲。"}, {"type": "subtitle", "time": 8412.07, "timestamp": "02:20:12", "text": "只剩五分钟了。"}, {"type": "subtitle", "time": 8414.872, "timestamp": "02:20:14", "text": "你害怕什么？ 嗯？ 你害怕吗？"}, {"type": "subtitle", "time": 8426.07, "timestamp": "02:20:26", "text": "我的天啊。 然后让体育迷们看到"}, {"type": "subtitle", "time": 8432.55, "timestamp": "02:20:32", "text": "你，然后让它召唤呃……黄蜂。   剧透警告！"}, {"type": "subtitle", "time": 8438.309, "timestamp": "02:20:38", "text": "它会让你尝到"}, {"type": "subtitle", "time": 8439.349, "timestamp": "02:20:39", "text": "苦头。   是的"}, {"type": "subtitle", "time": 8441.67, "timestamp": "02:20:41", "text": "。"}, {"type": "subtitle", "time": 8444.95, "timestamp": "02:20:44", "text": "不剧透。 告密者。 我觉得自己像个"}, {"type": "subtitle", "time": 8448.469, "timestamp": "02:20:48", "text": "告密者，对吧？"}, {"type": "subtitle", "time": 8451.27, "timestamp": "02:20:51", "text": "对，告密者。   就这些吗"}, {"type": "subtitle", "time": 8451.75, "timestamp": "02:20:51", "text": "？"}, {"type": "subtitle", "time": 8459.91, "timestamp": "02:20:59", "text": "我们回家吧。"}]
[{"type": "subtitle", "time": 16949.27, "timestamp": "04:42:29", "text": "很多次事故。 我要去找"}, {"type": "subtitle", "time": 16953.35, "timestamp": "04:42:33", "text": "安雅了，我这就收拾好。 我的天啊。"}, {"type": "subtitle", "time": 16955.67, "timestamp": "04:42:35", "text": "你好。 总有一天，我也可以"}, {"type": "subtitle", "time": 16958.628, "timestamp": "04:42:38", "text": "安心地直播了，伙计们。 你好。 总之，"}, {"type": "subtitle", "time": 16960.628, "timestamp": "04:42:40", "text": "晚安。 祝大家一切顺利。"}, {"type": "subtitle", "time": 16961.91, "timestamp": "04:42:41", "text": "再见。 晚安。 晚安。"}]
[{"type": "subtitle", "time": 14040.64, "timestamp": "03:54:00", "text": "我出局了。 我也猜对了。"}, {"type": "subtitle", "time": 14047.51, "timestamp": "03:54:07", "text": "被哈马格击倒了。好的，这些是"}, {"type": "subtitle", "time": 14057.349, "timestamp": "03:54:17", "text": "哦，那是印度玩家。好的，"}, {"type": "subtitle", "time": 14059.59, "timestamp": "03:54:19", "text": "兄弟。"}, {"type": "subtitle", "time": 14062.469, "timestamp": "03:54:22", "text": "我发誓亚洲服务器太无聊了。"}, {"type": "subtitle", "time": 14065.67, "timestamp": "03:54:25", "text": "它们太他妈无聊了。呃，"}, {"type": "subtitle", "time": 14068.229, "timestamp": "03:54:28", "text": "至少我有远程掠夺者玩家"}, {"type": "subtitle", "time": 14069.99, "timestamp": "03:54:29", "text": "蓝图。"}, {"type": "subtitle", "time": 14074.95, "timestamp": "03:54:34", "text": "我应该选“跟我来”的。"}, {"type": "subtitle", "time": 14077.269, "timestamp": "03:54:37", "text": "是啊，"}, {"type": "subtitle", "time": 14078.79, "timestamp": "03:54:38", "text": "你应该跟着我。我们干掉了"}, {"type": "subtitle", "time": 14082.389, "timestamp": "03:54:42", "text": "轰炸机，拿到了更多战利品。"}, {"type": "subtitle", "time": 14089.429, "timestamp": "03:54:49", "text": "哦，好吧，事情发生了。是"}, {"type": "subtitle", "time": 14096.309, "timestamp": "03:54:56", "text": "我没损失什么太重要的东西。"}, {"type": "subtitle", "time": 14097.83, "timestamp": "03:54:57", "text": "你还行吧。真"}]
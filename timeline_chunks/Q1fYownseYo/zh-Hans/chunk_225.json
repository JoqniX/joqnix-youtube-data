[{"type": "subtitle", "time": 13506.469, "timestamp": "03:45:06", "text": "我们先试试这个"}, {"type": "subtitle", "time": 13508.07, "timestamp": "03:45:08", "text": "。"}, {"type": "subtitle", "time": 13523.189, "timestamp": "03:45:23", "text": "哦，我的天哪，我又死了。"}, {"type": "subtitle", "time": 13526.469, "timestamp": "03:45:26", "text": "哦，拜托。我离这里太远了。我正在"}, {"type": "subtitle", "time": 13527.99, "timestamp": "03:45:27", "text": "处理眼前的事。尽量"}, {"type": "subtitle", "time": 13530.469, "timestamp": "03:45:30", "text": "保持静止。你还有幸存者，对吧？"}, {"type": "subtitle", "time": 13532.07, "timestamp": "03:45:32", "text": "没有，我没有。"}, {"type": "subtitle", "time": 13532.55, "timestamp": "03:45:32", "text": "哦，糟糕。"}, {"type": "subtitle", "time": 13535.189, "timestamp": "03:45:35", "text": "哦，居然有人救了我。"}, {"type": "subtitle", "time": 13535.75, "timestamp": "03:45:35", "text": "谢谢。"}, {"type": "subtitle", "time": 13542.229, "timestamp": "03:45:42", "text": "哦，我的护盾坏了。呃，等等。我还有"}]
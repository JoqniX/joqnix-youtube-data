[{"type": "subtitle", "time": 6844.229, "timestamp": "01:54:04", "text": "我重新设定了一个截止日期。"}, {"type": "subtitle", "time": 6853.589, "timestamp": "01:54:13", "text": "仪表盘的情况如何？"}, {"type": "subtitle", "time": 6856.31, "timestamp": "01:54:16", "text": "嗯，还不错。 我一直在花钱，这样"}, {"type": "subtitle", "time": 6862.07, "timestamp": "01:54:22", "text": "我的库存里就一直有空间，"}, {"type": "subtitle", "time": 6862.79, "timestamp": "01:54:22", "text": "这很好。"}, {"type": "subtitle", "time": 6865.91, "timestamp": "01:54:25", "text": "探险队的情况如何？"}, {"type": "subtitle", "time": 6867.99, "timestamp": "01:54:27", "text": "你走到哪一步了？"}, {"type": "subtitle", "time": 6870.629, "timestamp": "01:54:30", "text": "仅第二页。  [笑声]"}, {"type": "subtitle", "time": 6873.43, "timestamp": "01:54:33", "text": "我没太注意。"}, {"type": "subtitle", "time": 6875.109, "timestamp": "01:54:35", "text": "嗯，"}, {"type": "subtitle", "time": 6887.91, "timestamp": "01:54:47", "text": "远征。"}, {"type": "subtitle", "time": 6891.51, "timestamp": "01:54:51", "text": "需要耐用的材质。 我需要电线。"}, {"type": "subtitle", "time": 6894.709, "timestamp": "01:54:54", "text": "需要散热风扇。"}, {"type": "subtitle", "time": 6898.79, "timestamp": "01:54:58", "text": "好的，没问题。 好了，我们走吧。"}]
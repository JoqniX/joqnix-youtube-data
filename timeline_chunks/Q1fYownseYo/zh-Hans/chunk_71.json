[{"type": "subtitle", "time": 4277.27, "timestamp": "01:11:17", "text": "嘿，他去世了。"}, {"type": "subtitle", "time": 4280.87, "timestamp": "01:11:20", "text": "他什么都没有。"}, {"type": "subtitle", "time": 4287.59, "timestamp": "01:11:27", "text": "他为什么会来这里呢？"}, {"type": "subtitle", "time": 4292.87, "timestamp": "01:11:32", "text": "需要一台阿奎因风扇。 我想要这个。"}, {"type": "subtitle", "time": 4303.03, "timestamp": "01:11:43", "text": "基本上，我们是在竞选"}]
[{"type": "subtitle", "time": 2883.19, "timestamp": "00:48:03", "text": "記録"}, {"type": "subtitle", "time": 2886.47, "timestamp": "00:48:06", "text": "ウェブサイトに書き込むことができます。 わかった。"}, {"type": "subtitle", "time": 2889.43, "timestamp": "00:48:09", "text": "うん。 それで、しばらくの間そのことを考えていました"}, {"type": "subtitle", "time": 2900.39, "timestamp": "00:48:20", "text": "[音楽]"}, {"type": "subtitle", "time": 2911.829, "timestamp": "00:48:31", "text": "それはただ時間と私自身が"}, {"type": "subtitle", "time": 2914.23, "timestamp": "00:48:34", "text": "現実から逃避しているだけです。"}, {"type": "subtitle", "time": 2917.43, "timestamp": "00:48:37", "text": "それで、そうですね。   えっと、"}, {"type": "subtitle", "time": 2923.43, "timestamp": "00:48:43", "text": "正直他に何ができるっていうの？"}, {"type": "subtitle", "time": 2925.829, "timestamp": "00:48:45", "text": "明日、明後日、明日は"}, {"type": "subtitle", "time": 2928.79, "timestamp": "00:48:48", "text": "バトルフィールドをやらなきゃいけない"}, {"type": "subtitle", "time": 2931.349, "timestamp": "00:48:51", "text": "。 えっと、"}, {"type": "subtitle", "time": 2934.87, "timestamp": "00:48:54", "text": "歌の練習はしてないんです。"}, {"type": "subtitle", "time": 2937.67, "timestamp": "00:48:57", "text": "つまり、"}]
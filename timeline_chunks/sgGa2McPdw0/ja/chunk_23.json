[{"type": "subtitle", "time": 1381.909, "timestamp": "00:23:01", "text": "鏡の中の自分をじっと見つめたりするなど、同じようにしてみてください。"}, {"type": "subtitle", "time": 1384.87, "timestamp": "00:23:04", "text": "顔、体、あらゆる部分を見て"}, {"type": "subtitle", "time": 1390.149, "timestamp": "00:23:10", "text": "分析してください。 その印象を"}, {"type": "subtitle", "time": 1392.47, "timestamp": "00:23:12", "text": "心に刻み込んでおいてください。 今度は同じことをしてください。"}, {"type": "subtitle", "time": 1396.31, "timestamp": "00:23:16", "text": "それから外に出て、あるいは"}, {"type": "subtitle", "time": 1398.07, "timestamp": "00:23:18", "text": "家の中で家族と一緒に話しながら、好きなことをしてみてください"}, {"type": "subtitle", "time": 1400.39, "timestamp": "00:23:20", "text": "。"}, {"type": "subtitle", "time": 1406.95, "timestamp": "00:23:26", "text": "話している間、相手にきちんと目を合わせようとしたり、"}, {"type": "subtitle", "time": 1412.789, "timestamp": "00:23:32", "text": "相手に注意を払っていることをアピールしようとしたりしないでください。 いいえ。ええと、それを練習してください。"}, {"type": "subtitle", "time": 1414.71, "timestamp": "00:23:34", "text": "ペットや動物などを使ってできます"}, {"type": "subtitle", "time": 1416.71, "timestamp": "00:23:36", "text": "。 ただ、"}, {"type": "subtitle", "time": 1419.19, "timestamp": "00:23:39", "text": "それらを見てみてください。 相手の目をしっかり見てください。"}, {"type": "subtitle", "time": 1421.27, "timestamp": "00:23:41", "text": "あなたの人生について、何でも、あなたが"}, {"type": "subtitle", "time": 1426.23, "timestamp": "00:23:46", "text": "共有したいことを何でも話してください。 それがどのように機能するかを見て、"}, {"type": "subtitle", "time": 1433.99, "timestamp": "00:23:53", "text": "慣れてきたら、見知らぬ人など、自分の"}, {"type": "subtitle", "time": 1437.909, "timestamp": "00:23:57", "text": "快適な環境から少し離れた場所でそれを試してみてください。アイコンタクトを保ち、相手のボディランゲージなど、"}]
[{"type": "subtitle", "time": 2460.79, "timestamp": "00:41:00", "text": "そして、"}, {"type": "subtitle", "time": 2465.349, "timestamp": "00:41:05", "text": "時々私自身もそれを吐き出してしまうことがあるように感じます。   えーっと、"}, {"type": "subtitle", "time": 2470.79, "timestamp": "00:41:10", "text": "ストリームで迷惑なことを言うと、"}, {"type": "subtitle", "time": 2474.63, "timestamp": "00:41:14", "text": "私の中にはもっと"}, {"type": "chat", "time": 2475.826, "timestamp": "00:41:15", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "escape form the reality"}, {"type": "subtitle", "time": 2476.87, "timestamp": "00:41:16", "text": "悲しくて落ち込んでいる部分もあるんだけど、でも、そうしすぎるべきじゃ"}, {"type": "subtitle", "time": 2482.23, "timestamp": "00:41:22", "text": "ないって気づいたんだ。"}, {"type": "subtitle", "time": 2484.47, "timestamp": "00:41:24", "text": "私は人を幸せにして"}, {"type": "subtitle", "time": 2487.27, "timestamp": "00:41:27", "text": "笑顔にするためにここにいるのであって、悲しませたりするためにいるのではないよね。だから、"}, {"type": "subtitle", "time": 2496.47, "timestamp": "00:41:36", "text": "エンターテイナーとしての自分の立場を理解しなきゃいけないんだ。   ああ"}, {"type": "subtitle", "time": 2499.589, "timestamp": "00:41:39", "text": "、それも確かにあった。"}, {"type": "subtitle", "time": 2505.829, "timestamp": "00:41:45", "text": "私が話していた話題から完全に脱線してしまいましたが"}, {"type": "subtitle", "time": 2509.829, "timestamp": "00:41:49", "text": "、まあいいでしょう。"}, {"type": "subtitle", "time": 2513.43, "timestamp": "00:41:53", "text": "えっと、先ほどの質問ですが、アディ、"}, {"type": "subtitle", "time": 2515.27, "timestamp": "00:41:55", "text": "私の質問はあなたの邪魔になっていますか？"}, {"type": "subtitle", "time": 2517.27, "timestamp": "00:41:57", "text": "実際、大丈夫です。"}, {"type": "subtitle", "time": 2519.99, "timestamp": "00:41:59", "text": "心配しないで。"}]
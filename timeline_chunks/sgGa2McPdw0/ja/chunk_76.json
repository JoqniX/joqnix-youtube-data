[{"type": "subtitle", "time": 4564.39, "timestamp": "01:16:04", "text": "とても小さい。"}, {"type": "subtitle", "time": 4567.38, "timestamp": "01:16:07", "text": "えーと、"}, {"type": "subtitle", "time": 4573.11, "timestamp": "01:16:13", "text": "[音楽]の"}, {"type": "subtitle", "time": 4575.03, "timestamp": "01:16:15", "text": "視聴スケジュール、舞台裏を見る方法"}, {"type": "subtitle", "time": 4586.07, "timestamp": "01:16:26", "text": "。 そこで、"}, {"type": "subtitle", "time": 4589.43, "timestamp": "01:16:29", "text": "グローバルサポータープラットフォームとインドの"}, {"type": "subtitle", "time": 4592.63, "timestamp": "01:16:32", "text": "ローカルUPIプラットフォームストリーミングプラットフォームの"}, {"type": "subtitle", "time": 4594.39, "timestamp": "01:16:34", "text": "サポートという紹介メッセージを用意し、オプションのエクスプローラーを無料でサポートできるようにします"}, {"type": "subtitle", "time": 4603.189, "timestamp": "01:16:43", "text": "あ、待って、今ビリー・ビリーのことを考えなきゃ"}, {"type": "subtitle", "time": 4605.35, "timestamp": "01:16:45", "text": "。"}, {"type": "subtitle", "time": 4618.63, "timestamp": "01:16:58", "text": "ああ、神様。 なんてこった。 なんてこった。 いや、いや、いや、いや、"}]
[{"type": "subtitle", "time": 960.79, "timestamp": "00:16:00", "text": "もし皆さんが聞いてくださるなら。"}, {"type": "subtitle", "time": 963.749, "timestamp": "00:16:03", "text": "それで、物事がうまく機能していないことに気づき、"}, {"type": "subtitle", "time": 976.15, "timestamp": "00:16:16", "text": "私の計画のライブラリが1か月間そこにあり、私は迷子になって戻って"}, {"type": "subtitle", "time": 982.79, "timestamp": "00:16:22", "text": "ストリームします。 こんにちは、マネルの息子さん。   ようこそ"}, {"type": "chat", "time": 991.152, "timestamp": "00:16:31", "author": "@meow_miko", "avatar": "https://yt4.ggpht.com/ASvDvYYIzbsKhRZHUW96TfjrUSWXRG124t_MDqszJYXjA87uEcIZVvjFBsBfRncMogN0tWEt0iI=s64-c-k-c0x00ffffff-no-rj", "message": "ooo what happened"}, {"type": "subtitle", "time": 991.189, "timestamp": "00:16:31", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 994.87, "timestamp": "00:16:34", "text": "こんにちは。 こんにちは。 ようこそ。ようこそ。 いらっしゃいませ。"}, {"type": "subtitle", "time": 1007.269, "timestamp": "00:16:47", "text": "えっと、リディーマーギークにログインして、"}, {"type": "subtitle", "time": 1015.509, "timestamp": "00:16:55", "text": "8月9日をリンクしてください。 待って、彼らは"}, {"type": "subtitle", "time": 1017.67, "timestamp": "00:16:57", "text": "無料のコード"}]
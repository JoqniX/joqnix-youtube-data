[{"type": "subtitle", "time": 3785.03, "timestamp": "01:03:05", "text": "正直言って、"}, {"type": "subtitle", "time": 3787.67, "timestamp": "01:03:07", "text": "本当に全部終わらせなきゃいけないんだ。 もう終わりだ"}, {"type": "subtitle", "time": 3791.03, "timestamp": "01:03:11", "text": "。 正直、もううんざりだ。"}, {"type": "subtitle", "time": 3796.63, "timestamp": "01:03:16", "text": "毎日、無理をしすぎているような気がする。 毎日、無理をしすぎている"}, {"type": "subtitle", "time": 3811.589, "timestamp": "01:03:31", "text": "【音楽】"}, {"type": "subtitle", "time": 3830.71, "timestamp": "01:03:50", "text": "[音楽]"}, {"type": "subtitle", "time": 3833.19, "timestamp": "01:03:53", "text": "ストリームは作業ストリームに移行する可能性があります"}, {"type": "subtitle", "time": 3837.43, "timestamp": "01:03:57", "text": "。 今まさにそれを感じているが、"}]
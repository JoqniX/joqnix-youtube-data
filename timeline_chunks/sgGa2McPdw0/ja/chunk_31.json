[{"type": "subtitle", "time": 1860.87, "timestamp": "00:31:00", "text": "でも、"}, {"type": "subtitle", "time": 1862.549, "timestamp": "00:31:02", "text": "H"}, {"type": "subtitle", "time": 1873.99, "timestamp": "00:31:13", "text": "オンラインでも試せると思いますが、正直に言うと、"}, {"type": "subtitle", "time": 1878.87, "timestamp": "00:31:18", "text": "オンラインで行うことには良い点と悪い点があります。例えば、見知らぬ"}, {"type": "subtitle", "time": 1881.19, "timestamp": "00:31:21", "text": "人に物を売るのはちょっと良くないです。変な人だと思われてしまいます。ドラマチックなドラム"}, {"type": "subtitle", "time": 1887.83, "timestamp": "00:31:27", "text": "ドラムを叩いたりする人に、なぜそんなことをするのでしょうか。それは"}, {"type": "chat", "time": 1895.544, "timestamp": "00:31:35", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "i am alive "}, {"type": "subtitle", "time": 1898.71, "timestamp": "00:31:38", "text": "でも、結局のところ、私たちは皆、誰かを必要としています"}, {"type": "subtitle", "time": 1905.99, "timestamp": "00:31:45", "text": "。 私たちは皆、話し相手を必要としている。"}, {"type": "subtitle", "time": 1911.83, "timestamp": "00:31:51", "text": "自分が確かに存在していることを示してくれる誰かを必要としているのだ。 私たちはそこにいます"}, {"type": "chat", "time": 1915.122, "timestamp": "00:31:55", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "or am i?"}, {"type": "subtitle", "time": 1915.43, "timestamp": "00:31:55", "text": "。 自分の気持ちや、自分が経験していることなどを伝えたいんです"}]
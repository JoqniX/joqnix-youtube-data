[{"type": "subtitle", "time": 3001.99, "timestamp": "00:50:01", "text": "私はビデオ関連のことはまだやってないんですよね？ ここしばらく"}, {"type": "subtitle", "time": 3005.349, "timestamp": "00:50:05", "text": "動画の"}, {"type": "subtitle", "time": 3008.549, "timestamp": "00:50:08", "text": "アップロードすらやってない。 私はそれをやると言ったのですが、他にもいろいろな"}, {"type": "subtitle", "time": 3015.19, "timestamp": "00:50:15", "text": "ことが起こって、結局"}, {"type": "subtitle", "time": 3018.28, "timestamp": "00:50:18", "text": "私はそれをやらなくなりました。"}, {"type": "subtitle", "time": 3020.23, "timestamp": "00:50:20", "text": "[音楽]"}, {"type": "subtitle", "time": 3045.27, "timestamp": "00:50:45", "text": "何ができるか、何ができないかを、ただひたすら考えてみたかったんです。 もっと"}, {"type": "subtitle", "time": 3052.95, "timestamp": "00:50:52", "text": "良い方法はありますか？"}]
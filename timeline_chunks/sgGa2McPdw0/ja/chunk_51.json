[{"type": "subtitle", "time": 3065.67, "timestamp": "00:51:05", "text": "音楽を止めて"}, {"type": "subtitle", "time": 3069.349, "timestamp": "00:51:09", "text": "。 えっと"}, {"type": "subtitle", "time": 3072.069, "timestamp": "00:51:12", "text": "、12日ですよね？ 分かりません。"}, {"type": "subtitle", "time": 3075.43, "timestamp": "00:51:15", "text": "時間がないんです。 えっと、12。"}, {"type": "subtitle", "time": 3078.79, "timestamp": "00:51:18", "text": "少なくともダウンロードして香港"}, {"type": "subtitle", "time": 3096.33, "timestamp": "00:51:36", "text": "本当にスペースが足りないんです。"}, {"type": "subtitle", "time": 3097.51, "timestamp": "00:51:37", "text": "[音楽]"}, {"type": "subtitle", "time": 3101.19, "timestamp": "00:51:41", "text": "私もフォートナイトをプレイしたいです。"}, {"type": "subtitle", "time": 3103.109, "timestamp": "00:51:43", "text": "ああ、やりたいことはたくさんあるのに"}, {"type": "subtitle", "time": 3105.27, "timestamp": "00:51:45", "text": "、なぜできないんだろう"}, {"type": "subtitle", "time": 3114.15, "timestamp": "00:51:54", "text": "でも、文句を言うより"}, {"type": "subtitle", "time": 3117.51, "timestamp": "00:51:57", "text": "、今すぐやった方がいいと思うよ、"}]
[{"type": "subtitle", "time": 662.55, "timestamp": "00:11:02", "text": "ファンタジーっぽいもの。 あなたは設定されたキャラクターとしてロールプレイを行い、"}, {"type": "subtitle", "time": 665.99, "timestamp": "00:11:05", "text": "すべては"}, {"type": "subtitle", "time": 667.75, "timestamp": "00:11:07", "text": "作り話です。 そこにいる者すべてがダンジョン"}, {"type": "subtitle", "time": 669.35, "timestamp": "00:11:09", "text": "マスターだ。"}, {"type": "subtitle", "time": 672.069, "timestamp": "00:11:12", "text": "ええ、チームメイトやパーティーメンバーなど、"}, {"type": "subtitle", "time": 674.31, "timestamp": "00:11:14", "text": "交流しなければならない相手がいます。"}, {"type": "subtitle", "time": 678.949, "timestamp": "00:11:18", "text": "そういうこと全部です。 こんにちは、"}, {"type": "subtitle", "time": 683.59, "timestamp": "00:11:23", "text": "息子が来ます。こんばんは。   ええ、"}, {"type": "subtitle", "time": 686.47, "timestamp": "00:11:26", "text": "明後日がそれなんです"}, {"type": "subtitle", "time": 690.55, "timestamp": "00:11:30", "text": "。 忘れていました。"}, {"type": "subtitle", "time": 692.949, "timestamp": "00:11:32", "text": "それは毎週の行事です。 いいえ、毎週土曜日のことです"}, {"type": "subtitle", "time": 697.19, "timestamp": "00:11:37", "text": "。 いいえ。だから、"}, {"type": "subtitle", "time": 708.63, "timestamp": "00:11:48", "text": "土曜日はやりたくないと言ったり、しばらくして急に立ち去ったりするのは失礼でしょう"}, {"type": "subtitle", "time": 711.03, "timestamp": "00:11:51", "text": "。 それはまずい。 それは"}, {"type": "subtitle", "time": 716.069, "timestamp": "00:11:56", "text": "失礼でしょう。 いや、あの、"}, {"type": "subtitle", "time": 719.43, "timestamp": "00:11:59", "text": "バトルフィールド6は"}]
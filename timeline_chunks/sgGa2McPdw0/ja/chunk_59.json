[{"type": "subtitle", "time": 3543.349, "timestamp": "00:59:03", "text": "ああ、神様。"}, {"type": "subtitle", "time": 3546.39, "timestamp": "00:59:06", "text": "こんにちは、タキサン。 ようこそ。こんばんは。"}, {"type": "subtitle", "time": 3551.75, "timestamp": "00:59:11", "text": "Twitchに広告が表示されている。 もう少し待ってみましょう"}, {"type": "subtitle", "time": 3554.15, "timestamp": "00:59:14", "text": "。"}, {"type": "subtitle", "time": 3564.71, "timestamp": "00:59:24", "text": "私たちは色々なことを話していたんです"}, {"type": "subtitle", "time": 3567.27, "timestamp": "00:59:27", "text": "。 もうすぐ誕生日なので、来週いくつか変更を加えようと思っています"}, {"type": "subtitle", "time": 3579.109, "timestamp": "00:59:39", "text": "作業の流れを続けるべきかどうか迷っています。"}, {"type": "subtitle", "time": 3593.43, "timestamp": "00:59:53", "text": "ええ、全てがどうなるか見てみたかったんです"}]
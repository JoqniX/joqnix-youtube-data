[{"type": "subtitle", "time": 8580.23, "timestamp": "02:23:00", "text": "とか、何て言うのか"}, {"type": "subtitle", "time": 8585.27, "timestamp": "02:23:05", "text": "知らないけど、鼻から出るやつ、何て"}, {"type": "subtitle", "time": 8587.67, "timestamp": "02:23:07", "text": "言うのか知らないけど、"}, {"type": "subtitle", "time": 8590.79, "timestamp": "02:23:10", "text": "言葉がわからない。"}, {"type": "subtitle", "time": 8597.51, "timestamp": "02:23:17", "text": "それで、寄付ページを作ろうと思ったんだ。"}, {"type": "subtitle", "time": 8600.79, "timestamp": "02:23:20", "text": "すべての"}, {"type": "chat", "time": 8604.449, "timestamp": "02:23:24", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "the moose"}, {"type": "subtitle", "time": 8604.63, "timestamp": "02:23:24", "text": "プラットフォームとローカルのUPIがあるページ。"}, {"type": "subtitle", "time": 8607.75, "timestamp": "02:23:27", "text": "モバイルを使っている人は"}, {"type": "subtitle", "time": 8609.91, "timestamp": "02:23:29", "text": "スキャンするか、ボタンをクリックするだけで"}, {"type": "subtitle", "time": 8612.309, "timestamp": "02:23:32", "text": "UPAアプリに行ける。そうすれば、"}, {"type": "subtitle", "time": 8622.469, "timestamp": "02:23:42", "text": "説明文からこの3段落1、2、3、4、そう、3段落を削除できる。"}, {"type": "subtitle", "time": 8624.79, "timestamp": "02:23:44", "text": "今日中に"}, {"type": "subtitle", "time": 8626.87, "timestamp": "02:23:46", "text": "トークアソンのウェブサイトを完全に完成させれば、これらも削除できる。そうやって説明"}, {"type": "subtitle", "time": 8633.99, "timestamp": "02:23:53", "text": "文を短くきれいに保って、ウェブ"}, {"type": "subtitle", "time": 8636.87, "timestamp": "02:23:56", "text": "サイトをここに載せる。 そうだね"}]
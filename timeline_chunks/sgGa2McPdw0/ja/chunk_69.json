[{"type": "subtitle", "time": 4141.51, "timestamp": "01:09:01", "text": "アンカーリンク、あるいは"}, {"type": "subtitle", "time": 4143.51, "timestamp": "01:09:03", "text": "アンカーリンクではない読み取りリンクのようなものがあり、それを提供しているすべての"}, {"type": "subtitle", "time": 4145.51, "timestamp": "01:09:05", "text": "プラットフォームにリンクされます。 だから、自分の"}, {"type": "subtitle", "time": 4147.99, "timestamp": "01:09:07", "text": "個人的なメッセージなどを残しておくこともできるし、"}, {"type": "subtitle", "time": 4149.99, "timestamp": "01:09:09", "text": "バナーとか"}, {"type": "subtitle", "time": 4153.03, "timestamp": "01:09:13", "text": "情報とか、ジョアソンの現在の活動を"}, {"type": "subtitle", "time": 4157.59, "timestamp": "01:09:17", "text": "紹介するような小さなものも残しておくことができる"}, {"type": "subtitle", "time": 4163.91, "timestamp": "01:09:23", "text": "。 それが私の考えです。"}, {"type": "subtitle", "time": 4177.51, "timestamp": "01:09:37", "text": "私の考えです。 そうすれば、"}, {"type": "subtitle", "time": 4180.47, "timestamp": "01:09:40", "text": "目標は YouTube の説明を短くすることになり、"}, {"type": "subtitle", "time": 4186.55, "timestamp": "01:09:46", "text": "誰かが感嘆符の"}, {"type": "subtitle", "time": 4189.11, "timestamp": "01:09:49", "text": "サポートやサポートではないもの、例えば"}, {"type": "subtitle", "time": 4192.07, "timestamp": "01:09:52", "text": "寄付リンクなどをした場合、"}, {"type": "subtitle", "time": 4194.47, "timestamp": "01:09:54", "text": "どれをすればいいのか混乱するでしょう。つまり、すべてが"}]
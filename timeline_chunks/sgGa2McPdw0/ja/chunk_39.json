[{"type": "subtitle", "time": 2340.95, "timestamp": "00:39:00", "text": "楽で幸せな気分になったり、落ち着いたりしますが、"}, {"type": "chat", "time": 2343.511, "timestamp": "00:39:03", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "what if they hate me"}, {"type": "subtitle", "time": 2345.19, "timestamp": "00:39:05", "text": "時々、確かに"}, {"type": "subtitle", "time": 2347.109, "timestamp": "00:39:07", "text": "大変だけど、"}, {"type": "subtitle", "time": 2350.069, "timestamp": "00:39:10", "text": "もし彼らが私を嫌うなら、彼らが誰を嫌おうと好きにさせておけばいい、"}, {"type": "subtitle", "time": 2356.23, "timestamp": "00:39:16", "text": "人間は常に懐疑的で、批判的で、"}, {"type": "subtitle", "time": 2360.79, "timestamp": "00:39:20", "text": "疑わしく、たくさんの"}, {"type": "subtitle", "time": 2366.47, "timestamp": "00:39:26", "text": "ええ、"}, {"type": "subtitle", "time": 2369.43, "timestamp": "00:39:29", "text": "そうです。"}, {"type": "subtitle", "time": 2371.67, "timestamp": "00:39:31", "text": "ええと、"}, {"type": "subtitle", "time": 2376.55, "timestamp": "00:39:36", "text": "主がおっしゃったように、時間がかかります。"}, {"type": "subtitle", "time": 2379.51, "timestamp": "00:39:39", "text": "ええと、少し時間がかかります。"}, {"type": "subtitle", "time": 2381.03, "timestamp": "00:39:41", "text": "友達を作ったり、そういうことをするには、かなりの努力が必要だ"}, {"type": "subtitle", "time": 2383.349, "timestamp": "00:39:43", "text": "。"}, {"type": "subtitle", "time": 2386.31, "timestamp": "00:39:46", "text": "オンラインでもオフラインでも、まずは"}, {"type": "subtitle", "time": 2389.27, "timestamp": "00:39:49", "text": "最初の一歩を踏み出さなければならない、そうでしょう？"}, {"type": "subtitle", "time": 2393.75, "timestamp": "00:39:53", "text": "その輪から抜け出して、自分の"}]
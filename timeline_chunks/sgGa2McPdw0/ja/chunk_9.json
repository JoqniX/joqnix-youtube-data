[{"type": "subtitle", "time": 540.71, "timestamp": "00:09:00", "text": "バトルフィールド6では、"}, {"type": "subtitle", "time": 544.55, "timestamp": "00:09:04", "text": "現在、早期アクセス権を持つ人向けにオープンベータテストを実施しています"}, {"type": "subtitle", "time": 547.43, "timestamp": "00:09:07", "text": "。"}, {"type": "subtitle", "time": 550.949, "timestamp": "00:09:10", "text": "早期アクセス権を持たない人は、"}, {"type": "subtitle", "time": 554.87, "timestamp": "00:09:14", "text": "8月9日まで待たなければなりません。 うん。 つまり、今日は"}, {"type": "subtitle", "time": 557.99, "timestamp": "00:09:17", "text": "7日ということになります。 明日。 これで"}, {"type": "subtitle", "time": 561.11, "timestamp": "00:09:21", "text": "明日までに、ウェブ"}, {"type": "subtitle", "time": 567.43, "timestamp": "00:09:27", "text": "サイトやその他諸々のやらかしたいことを全て終わらせることができる"}, {"type": "subtitle", "time": 572.23, "timestamp": "00:09:32", "text": "。 えーっと、ええ"}, {"type": "subtitle", "time": 576.15, "timestamp": "00:09:36", "text": "、"}, {"type": "subtitle", "time": 579.75, "timestamp": "00:09:39", "text": "今日出発する前に、"}, {"type": "subtitle", "time": 582.15, "timestamp": "00:09:42", "text": "いくつかお話したいことがあって、"}, {"type": "subtitle", "time": 585.75, "timestamp": "00:09:45", "text": "明日までに最終決定したいと思っています。"}, {"type": "subtitle", "time": 589.91, "timestamp": "00:09:49", "text": "明日はたぶん"}, {"type": "subtitle", "time": 592.31, "timestamp": "00:09:52", "text": "早起きして、"}, {"type": "subtitle", "time": 596.79, "timestamp": "00:09:56", "text": "朝に配信をするつもりです。 えっと、そういえば、今日は"}, {"type": "subtitle", "time": 599.99, "timestamp": "00:09:59", "text": "木曜日だった。 いいえ、明日です。"}]
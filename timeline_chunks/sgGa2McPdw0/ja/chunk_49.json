[{"type": "subtitle", "time": 2940.87, "timestamp": "00:49:00", "text": "やりたいことはたくさんあるんですけど、"}, {"type": "subtitle", "time": 2944.47, "timestamp": "00:49:04", "text": "今でもすごく制限されているように感じます。"}, {"type": "subtitle", "time": 2947.51, "timestamp": "00:49:07", "text": "誰もが長い"}, {"type": "subtitle", "time": 2951.19, "timestamp": "00:49:11", "text": "一連の配信、つまりずっと続く配信を全部見ることができるわけではないことは理解していますよね"}, {"type": "subtitle", "time": 2957.75, "timestamp": "00:49:17", "text": "？"}, {"type": "subtitle", "time": 2964.47, "timestamp": "00:49:24", "text": "時間が経つにつれて、退屈になったり、飽きてしまったりする傾向がある。   それは"}, {"type": "subtitle", "time": 2968.23, "timestamp": "00:49:28", "text": "理解しています。"}, {"type": "subtitle", "time": 2972.23, "timestamp": "00:49:32", "text": "でも、"}, {"type": "subtitle", "time": 2986.63, "timestamp": "00:49:46", "text": "各セグメントごとに新しいストリームを作成する必要があるのか​​、あるいは他に何が"}, {"type": "subtitle", "time": 2989.829, "timestamp": "00:49:49", "text": "できるのか、自分の選択肢がどのようなものかを見てみたいという気持ちもあります。"}, {"type": "subtitle", "time": 2993.109, "timestamp": "00:49:53", "text": "それに、私はこのことについてずっと前から話してきたんです"}]
[{"type": "subtitle", "time": 3305.67, "timestamp": "00:55:05", "text": "シムのギャラリーは順調そうだ。"}, {"type": "subtitle", "time": 3307.589, "timestamp": "00:55:07", "text": "私たちは全てを終えました。 というわけで、近いうちに"}, {"type": "subtitle", "time": 3309.99, "timestamp": "00:55:09", "text": "プレイする予定のゲームの一つは、"}, {"type": "subtitle", "time": 3317.349, "timestamp": "00:55:17", "text": "とサンズ・オブ・ザ・フォレストです。"}, {"type": "subtitle", "time": 3323.109, "timestamp": "00:55:23", "text": "全員で協力してグループでゲームをやってみて、早めにプレイせずに様子を見てみます"}, {"type": "subtitle", "time": 3326.79, "timestamp": "00:55:26", "text": "。 もちろん、いつでも"}, {"type": "subtitle", "time": 3345.19, "timestamp": "00:55:45", "text": "でも、グループでの共同作業のように感じます。"}, {"type": "subtitle", "time": 3347.349, "timestamp": "00:55:47", "text": "私たちは森林協力を行わなければならない。"}, {"type": "subtitle", "time": 3349.03, "timestamp": "00:55:49", "text": "いいえ。"}]
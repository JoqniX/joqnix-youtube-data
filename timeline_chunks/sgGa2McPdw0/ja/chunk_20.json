[{"type": "subtitle", "time": 1200.63, "timestamp": "00:20:00", "text": "私が話そうと思っていたことの一つです。 でも、"}, {"type": "subtitle", "time": 1207.83, "timestamp": "00:20:07", "text": "毎月のスクリーニング機能を復活させようかと考えていたんです。 私はいつも、"}, {"type": "subtitle", "time": 1211.35, "timestamp": "00:20:11", "text": "これはサブマラソンみたいなものだから、ジョアソンのためにそうすると言っていたんです"}, {"type": "subtitle", "time": 1213.35, "timestamp": "00:20:13", "text": "。 一"}, {"type": "subtitle", "time": 1215.27, "timestamp": "00:20:15", "text": "日全体の予定を立てる必要がある"}, {"type": "subtitle", "time": 1217.669, "timestamp": "00:20:17", "text": "。 右。 当初は、"}, {"type": "subtitle", "time": 1223.029, "timestamp": "00:20:23", "text": "ジョッカソンの費用だけでウェブサイトを作成し、"}, {"type": "subtitle", "time": 1225.43, "timestamp": "00:20:25", "text": "ジョッカソンのページを作成して、"}, {"type": "subtitle", "time": 1226.95, "timestamp": "00:20:26", "text": "説明文などを自由に使えるようにして、"}, {"type": "subtitle", "time": 1229.11, "timestamp": "00:20:29", "text": "簡単にリンクできるようにする予定でした。"}, {"type": "subtitle", "time": 1232.39, "timestamp": "00:20:32", "text": "でも、話が逸れてしまって、"}, {"type": "subtitle", "time": 1235.75, "timestamp": "00:20:35", "text": "他のことを色々やり始めてしまったんですよね？"}, {"type": "subtitle", "time": 1238.87, "timestamp": "00:20:38", "text": "余計なもの、不必要なもの、その他"}, {"type": "subtitle", "time": 1242.149, "timestamp": "00:20:42", "text": "諸々、ですよね？"}, {"type": "subtitle", "time": 1243.669, "timestamp": "00:20:43", "text": "あ、そういえば、もうすぐあなたの誕生日ですね"}, {"type": "subtitle", "time": 1245.59, "timestamp": "00:20:45", "text": "。 ワクワクしていますか？ うん、ちょっと"}, {"type": "subtitle", "time": 1249.909, "timestamp": "00:20:49", "text": "ワクワクしてるけど、何をするか何も"}, {"type": "subtitle", "time": 1252.63, "timestamp": "00:20:52", "text": "計画してないからちょっと心配でもあるんだ"}, {"type": "subtitle", "time": 1256.47, "timestamp": "00:20:56", "text": "。 だから、えっと、どうしたらいいのかちょっと"}]
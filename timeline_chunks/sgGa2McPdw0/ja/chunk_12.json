[{"type": "subtitle", "time": 721.829, "timestamp": "00:12:01", "text": "8月9日と10日にオープンベータ版が終了して、誰でもプレイできるようになるんですよね"}, {"type": "subtitle", "time": 723.829, "timestamp": "00:12:03", "text": "？ つまり、私には丸一"}, {"type": "subtitle", "time": 726.23, "timestamp": "00:12:06", "text": "日時間があるということだ。  8月10日は丸一日時間があります"}, {"type": "subtitle", "time": 729.67, "timestamp": "00:12:09", "text": "。 でも問題は、私の誕生日が"}, {"type": "subtitle", "time": 731.829, "timestamp": "00:12:11", "text": "8月11日だということなんです。 だから、"}, {"type": "subtitle", "time": 735.829, "timestamp": "00:12:15", "text": "カウントダウン配信をしないといけないんだ。 私はそれをやらなければならない"}, {"type": "subtitle", "time": 740.79, "timestamp": "00:12:20", "text": "。 だから、あまり時間がないんです。 いいえ。えっと、"}, {"type": "subtitle", "time": 743.829, "timestamp": "00:12:23", "text": "犠牲にする"}, {"type": "chat", "time": 757.603, "timestamp": "00:12:37", "author": "@yp_stream", "avatar": "https://yt4.ggpht.com/HXiutz56Epa3pzbWwrdMsb2LejiQy-QjaYyULoh1We3_KP37uiWNGUEBAoHdDooqzXDjXJx-9Q=s64-c-k-c0x00ffffff-no-rj", "message": "August 11 got it ."}, {"type": "subtitle", "time": 761.91, "timestamp": "00:12:41", "text": "午前 8 時 (東部標準時または太平洋標準時) は、午後 1 時 30 分"}, {"type": "subtitle", "time": 764.23, "timestamp": "00:12:44", "text": "または 2 時 30 分、午後"}, {"type": "subtitle", "time": 769.11, "timestamp": "00:12:49", "text": "2 時 30 分になります。  IST は、インド時間で、"}]
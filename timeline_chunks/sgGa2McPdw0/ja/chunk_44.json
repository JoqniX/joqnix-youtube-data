[{"type": "subtitle", "time": 2650.39, "timestamp": "00:44:10", "text": "ゲームから"}, {"type": "subtitle", "time": 2653.67, "timestamp": "00:44:13", "text": "少し距離を置こうとしていて、"}, {"type": "subtitle", "time": 2659.829, "timestamp": "00:44:19", "text": "週に1、2、3回程度に制限して、仕事などに集中しようとしているということです。これは、"}, {"type": "subtitle", "time": 2666.71, "timestamp": "00:44:26", "text": "どうなるかを見るための実験的な試みです"}, {"type": "subtitle", "time": 2671.51, "timestamp": "00:44:31", "text": "。 そして、皆さんも"}, {"type": "subtitle", "time": 2674.55, "timestamp": "00:44:34", "text": "ご存知のように、私は"}, {"type": "subtitle", "time": 2676.47, "timestamp": "00:44:36", "text": "いつも音楽関係のことをやりたいと思っているんです。"}, {"type": "subtitle", "time": 2679.67, "timestamp": "00:44:39", "text": "それは、私のルーツ、つまり"}, {"type": "subtitle", "time": 2684.309, "timestamp": "00:44:44", "text": "ジョックの初期のルーツのようなものですよね？ だから"}, {"type": "subtitle", "time": 2687.75, "timestamp": "00:44:47", "text": "今月はその準備をしたかったんです。"}, {"type": "subtitle", "time": 2692.55, "timestamp": "00:44:52", "text": "来週から音楽関係の活動を始めます。"}, {"type": "subtitle", "time": 2695.589, "timestamp": "00:44:55", "text": "始めている。 少なくとも1時間は"}]
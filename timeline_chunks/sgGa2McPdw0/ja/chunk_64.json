[{"type": "subtitle", "time": 3840.549, "timestamp": "01:04:00", "text": "私はそうはしない。 つまり、もし"}, {"type": "subtitle", "time": 3843.99, "timestamp": "01:04:03", "text": "私に会いたいなら、つまり、"}, {"type": "subtitle", "time": 3853.99, "timestamp": "01:04:13", "text": "今、ちょっと自意識過剰になってきた。"}, {"type": "subtitle", "time": 3857.109, "timestamp": "01:04:17", "text": "私の中には、「うん、見せびらかしたい」という気持ちもある"}, {"type": "subtitle", "time": 3859.19, "timestamp": "01:04:19", "text": "。"}, {"type": "subtitle", "time": 3882.95, "timestamp": "01:04:42", "text": "あの、ねえ、ちょっと手伝ってもいい"}, {"type": "subtitle", "time": 3897.829, "timestamp": "01:04:57", "text": "実験してもいいですか？ はい、気にしないでください。"}]
[{"type": "subtitle", "time": 1682.149, "timestamp": "00:28:02", "text": "私はあなたにアドバイスをした。"}, {"type": "subtitle", "time": 1685.51, "timestamp": "00:28:05", "text": "鏡で自分の姿を見てください。"}, {"type": "subtitle", "time": 1687.99, "timestamp": "00:28:07", "text": "話しながら自分を見つめるか、あるいは"}, {"type": "subtitle", "time": 1692.149, "timestamp": "00:28:12", "text": "10分間ただ自分を見つめてみてください。"}, {"type": "subtitle", "time": 1698.23, "timestamp": "00:28:18", "text": "えーっと、それで、えーっと、ペット"}, {"type": "subtitle", "time": 1700.389, "timestamp": "00:28:20", "text": "とか"}, {"type": "subtitle", "time": 1703.35, "timestamp": "00:28:23", "text": "家の中の物や家族と一緒にそれができるかどうか試してみてください。"}, {"type": "subtitle", "time": 1706.549, "timestamp": "00:28:26", "text": "目を合わせて話すように心がけてください。 いいえ、まずは"}, {"type": "subtitle", "time": 1709.11, "timestamp": "00:28:29", "text": "普通に、さりげなく話しかけてみてください。ただし、必ず相手と"}, {"type": "subtitle", "time": 1713.029, "timestamp": "00:28:33", "text": "目を合わせるようにしてください。"}, {"type": "subtitle", "time": 1715.59, "timestamp": "00:28:35", "text": "それから、それができるようになったら、ゆっくりと、"}, {"type": "subtitle", "time": 1721.11, "timestamp": "00:28:41", "text": "他の見知らぬ人などと一緒にやってみてください。"}, {"type": "subtitle", "time": 1730.23, "timestamp": "00:28:50", "text": "自身も分からない問題です。"}]
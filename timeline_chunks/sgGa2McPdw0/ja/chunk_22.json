[{"type": "subtitle", "time": 1321.029, "timestamp": "00:22:01", "text": "散りやすいタイプなんです。 私の"}, {"type": "subtitle", "time": 1323.51, "timestamp": "00:22:03", "text": "目は部屋の中をあちこちさまようでしょう"}, {"type": "subtitle", "time": 1333.51, "timestamp": "00:22:13", "text": "そういう類のすべて。 うん。"}, {"type": "subtitle", "time": 1336.549, "timestamp": "00:22:16", "text": "つまり、理想的に言えば、"}, {"type": "subtitle", "time": 1345.35, "timestamp": "00:22:25", "text": "アイコンタクトを改善したいなら、家の"}, {"type": "subtitle", "time": 1349.19, "timestamp": "00:22:29", "text": "大きな長い鏡に向かって自分自身に話しかければいいんです"}, {"type": "subtitle", "time": 1352.31, "timestamp": "00:22:32", "text": "。 ほとんどのインドの家庭には"}, {"type": "subtitle", "time": 1354.63, "timestamp": "00:22:34", "text": "それがあるか、小さな金属製の鏡も手に入る"}, {"type": "subtitle", "time": 1357.99, "timestamp": "00:22:37", "text": "鏡です。 ただ自分"}, {"type": "subtitle", "time": 1361.029, "timestamp": "00:22:41", "text": "自身に話しかけてみて。 まっすぐあなたの目を見てください。   独り言を言ってみよう"}, {"type": "subtitle", "time": 1363.029, "timestamp": "00:22:43", "text": "。   まずは"}, {"type": "subtitle", "time": 1365.19, "timestamp": "00:22:45", "text": "自己愛"}, {"type": "subtitle", "time": 1367.909, "timestamp": "00:22:47", "text": "と自己肯定の練習をしましょう。"}, {"type": "subtitle", "time": 1371.029, "timestamp": "00:22:51", "text": "それから、"}, {"type": "subtitle", "time": 1376.47, "timestamp": "00:22:56", "text": "鏡を見ながら目で分析したり、独り言を言ったり、あるいはただ"}]
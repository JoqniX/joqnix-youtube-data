[{"type": "subtitle", "time": 4263.189, "timestamp": "01:11:03", "text": "？  3分前くらい。 ああ、なんてことだ、"}, {"type": "chat", "time": 4263.522, "timestamp": "01:11:03", "author": "@yp_stream", "avatar": "https://yt4.ggpht.com/HXiutz56Epa3pzbWwrdMsb2LejiQy-QjaYyULoh1We3_KP37uiWNGUEBAoHdDooqzXDjXJx-9Q=s64-c-k-c0x00ffffff-no-rj", "message": "I'm back here . I was cleaning house, eating dinner."}, {"type": "subtitle", "time": 4266.229, "timestamp": "01:11:06", "text": "ベージュ色の服を着て、"}, {"type": "subtitle", "time": 4267.99, "timestamp": "01:11:07", "text": "私はここに戻ってきた。 私は家を掃除しながら"}, {"type": "subtitle", "time": 4271.51, "timestamp": "01:11:11", "text": "夕食を食べていました。 配信再開おめでとうございます。"}, {"type": "subtitle", "time": 4279.59, "timestamp": "01:11:19", "text": "歓迎されるのですか？ 何時に寝る予定ですか？"}, {"type": "subtitle", "time": 4282.55, "timestamp": "01:11:22", "text": "あなたはいつ寝ますか？"}, {"type": "subtitle", "time": 4294.79, "timestamp": "01:11:34", "text": "例えば、あなたは夜10時に寝るタイプですか？"}, {"type": "subtitle", "time": 4298.95, "timestamp": "01:11:38", "text": "正しくは"}, {"type": "subtitle", "time": 4311.03, "timestamp": "01:11:51", "text": "10時に寝られたらいいのに。 例えば、"}, {"type": "subtitle", "time": 4314.31, "timestamp": "01:11:54", "text": "今寝たら、午前"}, {"type": "subtitle", "time": 4317.35, "timestamp": "01:11:57", "text": "3時か4時に目が覚めるような気がする。まるで配信を見ているような感じになるだろう"}]
[{"type": "subtitle", "time": 4038.95, "timestamp": "01:07:18", "text": "マスキングをする必要があるかもしれない。   それは"}, {"type": "subtitle", "time": 4042.63, "timestamp": "01:07:22", "text": "後で考えます。 心配ない。   私が何をしているかは、"}, {"type": "subtitle", "time": 4044.39, "timestamp": "01:07:24", "text": "あなたには見せません。"}, {"type": "subtitle", "time": 4046.47, "timestamp": "01:07:26", "text": "うん。"}, {"type": "subtitle", "time": 4051.19, "timestamp": "01:07:31", "text": "それで、ストリーム"}, {"type": "subtitle", "time": 4053.349, "timestamp": "01:07:33", "text": "要素と"}, {"type": "subtitle", "time": 4057.91, "timestamp": "01:07:37", "text": "kaと、これらの支払い関連のすべてを終わらせたいんです。"}, {"type": "subtitle", "time": 4060.95, "timestamp": "01:07:40", "text": "ええ、そうですね。"}, {"type": "subtitle", "time": 4075.829, "timestamp": "01:07:55", "text": "終わらせなきゃ。 では、そうします"}, {"type": "subtitle", "time": 4077.99, "timestamp": "01:07:57", "text": "。"}]
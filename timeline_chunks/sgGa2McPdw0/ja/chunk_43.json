[{"type": "subtitle", "time": 2581.349, "timestamp": "00:43:01", "text": "私にとってどうなるか見てみよう。"}, {"type": "subtitle", "time": 2584.71, "timestamp": "00:43:04", "text": "来週はスケジュール通りに過ごすように心がけます。"}, {"type": "subtitle", "time": 2587.589, "timestamp": "00:43:07", "text": "スケジュールは後ほどアップロードします"}, {"type": "subtitle", "time": 2595.67, "timestamp": "00:43:15", "text": "。 ええ、前もってやっておきます。 そして"}, {"type": "subtitle", "time": 2600.55, "timestamp": "00:43:20", "text": "3つ目は、私のウェブ"}, {"type": "subtitle", "time": 2604.47, "timestamp": "00:43:24", "text": "サイトの仕事の流れは退屈すぎるでしょうか"}, {"type": "subtitle", "time": 2607.99, "timestamp": "00:43:27", "text": "？ 皆さんはそれを楽しんでいますか？"}, {"type": "subtitle", "time": 2611.109, "timestamp": "00:43:31", "text": "それともただ傍観して協力しているだけですか？"}, {"type": "subtitle", "time": 2613.829, "timestamp": "00:43:33", "text": "本当にそれについて聞きたかったんです"}, {"type": "subtitle", "time": 2616.63, "timestamp": "00:43:36", "text": "。 えっと、昨日は"}, {"type": "subtitle", "time": 2619.75, "timestamp": "00:43:39", "text": "ゲーム"}, {"type": "subtitle", "time": 2621.99, "timestamp": "00:43:41", "text": "プレイリスト、ゲームトラッカー、プレイリストを"}, {"type": "subtitle", "time": 2624.069, "timestamp": "00:43:44", "text": "私のウェブサイトでやっていました。これまでプレイしたゲームと"}, {"type": "subtitle", "time": 2629.829, "timestamp": "00:43:49", "text": "今後プレイ予定のゲーム、プレイしたゲーム、"}, {"type": "subtitle", "time": 2631.589, "timestamp": "00:43:51", "text": "ドロップしたゲーム、完了したゲームなど、すべてのゲームプレイリストです。"}, {"type": "subtitle", "time": 2634.47, "timestamp": "00:43:54", "text": "昨日、"}, {"type": "subtitle", "time": 2637.75, "timestamp": "00:43:57", "text": "私のサイトでその問題を修正しました。 それで、私が"}]
[{"type": "subtitle", "time": 3065.67, "timestamp": "00:51:05", "text": "（音乐）"}, {"type": "subtitle", "time": 3069.349, "timestamp": "00:51:09", "text": "。 嗯，是"}, {"type": "subtitle", "time": 3072.069, "timestamp": "00:51:12", "text": "第12名，对吧？ 我不知道，我没有"}, {"type": "subtitle", "time": 3075.43, "timestamp": "00:51:15", "text": "时间。 呃 12. 我想"}, {"type": "subtitle", "time": 3078.79, "timestamp": "00:51:18", "text": "至少能像下载和打开鸿"}, {"type": "subtitle", "time": 3096.33, "timestamp": "00:51:36", "text": "我真的没有足够的空间。"}, {"type": "subtitle", "time": 3097.51, "timestamp": "00:51:37", "text": "[音乐]"}, {"type": "subtitle", "time": 3101.19, "timestamp": "00:51:41", "text": "我也想玩堡垒之夜。"}, {"type": "subtitle", "time": 3103.109, "timestamp": "00:51:43", "text": "唉，我有很多想做的事情"}, {"type": "subtitle", "time": 3105.27, "timestamp": "00:51:45", "text": "，但我为什么做不到？为什么"}, {"type": "subtitle", "time": 3114.15, "timestamp": "00:51:54", "text": "但是，说实话，与其抱怨，不如"}, {"type": "subtitle", "time": 3117.51, "timestamp": "00:51:57", "text": "现在就去做"}]
[{"type": "subtitle", "time": 1381.909, "timestamp": "00:23:01", "text": "镜子里的自己看。"}, {"type": "subtitle", "time": 1384.87, "timestamp": "00:23:04", "text": "仔细观察你脸部、身体的每一部分"}, {"type": "subtitle", "time": 1387.11, "timestamp": "00:23:07", "text": "，"}, {"type": "subtitle", "time": 1390.149, "timestamp": "00:23:10", "text": "分析它们。 把那印象牢记在心"}, {"type": "subtitle", "time": 1392.47, "timestamp": "00:23:12", "text": "。 现在也这样做。"}, {"type": "subtitle", "time": 1396.31, "timestamp": "00:23:16", "text": "然后试着到户外去，或者像"}, {"type": "subtitle", "time": 1398.07, "timestamp": "00:23:18", "text": "在家里一样和家人一起"}, {"type": "subtitle", "time": 1400.39, "timestamp": "00:23:20", "text": "聊天。 不要刻意尝试"}, {"type": "subtitle", "time": 1406.95, "timestamp": "00:23:26", "text": "在说话时保持适当的眼神交流，也不要试图"}, {"type": "subtitle", "time": 1409.029, "timestamp": "00:23:29", "text": "表现出你在关注"}, {"type": "subtitle", "time": 1412.789, "timestamp": "00:23:32", "text": "对方。 不。呃，还要练习一下。"}, {"type": "subtitle", "time": 1414.71, "timestamp": "00:23:34", "text": "你可以用你的宠物"}, {"type": "subtitle", "time": 1416.71, "timestamp": "00:23:36", "text": "、动物之类的东西来做这件事。 看看就知道了"}, {"type": "subtitle", "time": 1419.19, "timestamp": "00:23:39", "text": "。 注视他们的眼睛。 畅所欲言，说说"}, {"type": "subtitle", "time": 1421.27, "timestamp": "00:23:41", "text": "你的生活，任何你"}, {"type": "subtitle", "time": 1426.23, "timestamp": "00:23:46", "text": "想分享的事情。 看看效果如何，"}, {"type": "subtitle", "time": 1429.99, "timestamp": "00:23:49", "text": "慢慢地，等你适应了之后再尝试。"}, {"type": "subtitle", "time": 1433.99, "timestamp": "00:23:53", "text": "我喜欢在不"}, {"type": "subtitle", "time": 1437.909, "timestamp": "00:23:57", "text": "熟悉的环境中，比如和"}, {"type": "subtitle", "time": 1439.99, "timestamp": "00:23:59", "text": "陌生人在一起的时候，保持眼神"}]
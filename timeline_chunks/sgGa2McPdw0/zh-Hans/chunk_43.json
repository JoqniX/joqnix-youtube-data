[{"type": "subtitle", "time": 2581.349, "timestamp": "00:43:01", "text": "。"}, {"type": "subtitle", "time": 2584.71, "timestamp": "00:43:04", "text": "下周我会尽量按计划行事。"}, {"type": "subtitle", "time": 2587.589, "timestamp": "00:43:07", "text": "我会稍后上传日程表"}, {"type": "subtitle", "time": 2595.67, "timestamp": "00:43:15", "text": "。 嗯，好的，我会提前做好。"}, {"type": "subtitle", "time": 2600.55, "timestamp": "00:43:20", "text": "第三，我想问一下，我的"}, {"type": "subtitle", "time": 2604.47, "timestamp": "00:43:24", "text": "网站内容是不是太无聊了"}, {"type": "subtitle", "time": 2607.99, "timestamp": "00:43:27", "text": "？ 你们是能享受其中的乐趣，"}, {"type": "subtitle", "time": 2611.109, "timestamp": "00:43:31", "text": "还是只是潜水观望、一起工作？"}, {"type": "subtitle", "time": 2613.829, "timestamp": "00:43:33", "text": "我真的想问问这个问题"}, {"type": "subtitle", "time": 2616.63, "timestamp": "00:43:36", "text": "。 呃，事情不是昨天，我"}, {"type": "subtitle", "time": 2619.75, "timestamp": "00:43:39", "text": "昨天在我的网站上做了一个游戏"}, {"type": "subtitle", "time": 2621.99, "timestamp": "00:43:41", "text": "播放列表，里面有"}, {"type": "subtitle", "time": 2627.19, "timestamp": "00:43:47", "text": "我玩过的所有游戏、即将玩的游戏、"}, {"type": "subtitle", "time": 2629.829, "timestamp": "00:43:49", "text": "以及我玩过但已经"}, {"type": "subtitle", "time": 2631.589, "timestamp": "00:43:51", "text": "放弃的游戏，还有我已经完成的所有游戏。"}, {"type": "subtitle", "time": 2634.47, "timestamp": "00:43:54", "text": "昨天我已经在我网站上把那件事做对了"}, {"type": "subtitle", "time": 2637.75, "timestamp": "00:43:57", "text": "。 所以我想说的是，"}]
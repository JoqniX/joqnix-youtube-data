[{"type": "subtitle", "time": 662.55, "timestamp": "00:11:02", "text": "奇幻故事。 你扮演的是一个"}, {"type": "subtitle", "time": 665.99, "timestamp": "00:11:05", "text": "设定好的角色，但一切都是"}, {"type": "subtitle", "time": 667.75, "timestamp": "00:11:07", "text": "虚构的。 那里处处都有地下"}, {"type": "subtitle", "time": 669.35, "timestamp": "00:11:09", "text": "城主。"}, {"type": "subtitle", "time": 672.069, "timestamp": "00:11:12", "text": "是的，我们有队友、派对伙伴"}, {"type": "subtitle", "time": 674.31, "timestamp": "00:11:14", "text": "等等，你需要和他们互动"}, {"type": "subtitle", "time": 678.949, "timestamp": "00:11:18", "text": "等等。呃，所有这些东西。"}, {"type": "subtitle", "time": 683.59, "timestamp": "00:11:23", "text": "儿子快进来了。晚上好。"}, {"type": "subtitle", "time": 686.47, "timestamp": "00:11:26", "text": "嗯，是的，我后天还有这件事"}, {"type": "subtitle", "time": 690.55, "timestamp": "00:11:30", "text": "。 我把这件事忘了。"}, {"type": "subtitle", "time": 692.949, "timestamp": "00:11:32", "text": "这是每周一次的事情。 不，是每个星期六都会发生的事"}, {"type": "subtitle", "time": 697.19, "timestamp": "00:11:37", "text": "。 不。所以，如果我想……"}, {"type": "subtitle", "time": 698.71, "timestamp": "00:11:38", "text": "呃，"}, {"type": "subtitle", "time": 701.509, "timestamp": "00:11:41", "text": "如果我想……呃，"}, {"type": "subtitle", "time": 704.87, "timestamp": "00:11:44", "text": "告诉别人我不想"}, {"type": "subtitle", "time": 708.63, "timestamp": "00:11:48", "text": "在周六做这件事，或者过"}, {"type": "subtitle", "time": 711.03, "timestamp": "00:11:51", "text": "一会儿就突然离开，那就太没礼貌了。 那很糟糕。 那样做很"}, {"type": "subtitle", "time": 716.069, "timestamp": "00:11:56", "text": "失礼。 不，问题是，《"}, {"type": "subtitle", "time": 719.43, "timestamp": "00:11:59", "text": "战地6》将"}]
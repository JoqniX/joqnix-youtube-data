[{"type": "subtitle", "time": 540.71, "timestamp": "00:09:00", "text": "战地6》目前正在进行公开"}, {"type": "subtitle", "time": 544.55, "timestamp": "00:09:04", "text": "测试，面向那些"}, {"type": "subtitle", "time": 547.43, "timestamp": "00:09:07", "text": "拥有提前体验资格的人。 对于那些没有"}, {"type": "subtitle", "time": 550.949, "timestamp": "00:09:10", "text": "提前体验资格的人来说，我必须等到"}, {"type": "subtitle", "time": 554.87, "timestamp": "00:09:14", "text": "8月9日。 是的。 所以今天就是"}, {"type": "subtitle", "time": 557.99, "timestamp": "00:09:17", "text": "7号了。 明天。 这让我有时间"}, {"type": "subtitle", "time": 561.11, "timestamp": "00:09:21", "text": "到明天完成所有"}, {"type": "subtitle", "time": 565.43, "timestamp": "00:09:25", "text": "我想做的关于"}, {"type": "subtitle", "time": 567.43, "timestamp": "00:09:27", "text": "网站的事情，以及所有那些"}, {"type": "subtitle", "time": 572.23, "timestamp": "00:09:32", "text": "乱七八糟的事情等等。 嗯，是的"}, {"type": "subtitle", "time": 576.15, "timestamp": "00:09:36", "text": "，在我"}, {"type": "subtitle", "time": 579.75, "timestamp": "00:09:39", "text": "今天离开之前，我"}, {"type": "subtitle", "time": 582.15, "timestamp": "00:09:42", "text": "想和大家谈谈几件事，"}, {"type": "subtitle", "time": 585.75, "timestamp": "00:09:45", "text": "然后明天再最终确定下来。"}, {"type": "subtitle", "time": 589.91, "timestamp": "00:09:49", "text": "明天我可能会"}, {"type": "subtitle", "time": 592.31, "timestamp": "00:09:52", "text": "早起，我们早上会进行直播"}, {"type": "subtitle", "time": 596.79, "timestamp": "00:09:56", "text": "。 呃，对了，今天"}, {"type": "subtitle", "time": 599.99, "timestamp": "00:09:59", "text": "是星期四。 不，是明天的。"}]
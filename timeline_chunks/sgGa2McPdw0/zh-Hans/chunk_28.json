[{"type": "subtitle", "time": 1682.149, "timestamp": "00:28:02", "text": "我给了你建议。 照照"}, {"type": "subtitle", "time": 1685.51, "timestamp": "00:28:05", "text": "镜子。"}, {"type": "subtitle", "time": 1687.99, "timestamp": "00:28:07", "text": "说话时盯着自己看，或者就那样"}, {"type": "subtitle", "time": 1692.149, "timestamp": "00:28:12", "text": "盯着自己看10分钟。"}, {"type": "subtitle", "time": 1698.23, "timestamp": "00:28:18", "text": "嗯，还有，嗯，就像，嗯，试着看看"}, {"type": "subtitle", "time": 1700.389, "timestamp": "00:28:20", "text": "你是否能用家里的宠物或者"}, {"type": "subtitle", "time": 1703.35, "timestamp": "00:28:23", "text": "家人来做这件事。"}, {"type": "subtitle", "time": 1706.549, "timestamp": "00:28:26", "text": "说话时要保持眼神交流。 不，试着用"}, {"type": "subtitle", "time": 1709.11, "timestamp": "00:28:29", "text": "正常、随意的语气和他们交谈，但首先要确保"}, {"type": "subtitle", "time": 1713.029, "timestamp": "00:28:33", "text": "和他们保持眼神交流。"}, {"type": "subtitle", "time": 1715.59, "timestamp": "00:28:35", "text": "然后慢慢地，等你能够"}, {"type": "subtitle", "time": 1717.35, "timestamp": "00:28:37", "text": "做到之后，再慢慢地，"}, {"type": "subtitle", "time": 1721.11, "timestamp": "00:28:41", "text": "嗯，和陌生人一起做之类的。"}, {"type": "subtitle", "time": 1730.23, "timestamp": "00:28:50", "text": "问题我自己也不知道。"}, {"type": "subtitle", "time": 1736.87, "timestamp": "00:28:56", "text": "我也挺喜欢自己这种"}]
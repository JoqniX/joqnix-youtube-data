[{"type": "subtitle", "time": 8101.35, "timestamp": "02:15:01", "text": "而且印度不在这里。"}, {"type": "subtitle", "time": 8103.75, "timestamp": "02:15:03", "text": "对我来说，最好的办法是去日本"}, {"type": "subtitle", "time": 8106.47, "timestamp": "02:15:06", "text": "，开一个日本银行账户，"}, {"type": "subtitle", "time": 8119.03, "timestamp": "02:15:19", "text": "但我不能，"}, {"type": "subtitle", "time": 8123.589, "timestamp": "02:15:23", "text": "我不能，而且很遗憾，我不能从kick那里得到。"}, {"type": "subtitle", "time": 8144.47, "timestamp": "02:15:44", "text": "请务必阅读《"}, {"type": "subtitle", "time": 8155.99, "timestamp": "02:15:55", "text": "等等，等等，等等，等等》。 记得我"}]
[{"type": "subtitle", "time": 1200.63, "timestamp": "00:20:00", "text": "我要谈的话题之一。 但我"}, {"type": "subtitle", "time": 1207.83, "timestamp": "00:20:07", "text": "每月一次的屏幕显示功能。 我一直说"}, {"type": "subtitle", "time": 1211.35, "timestamp": "00:20:11", "text": "我会为 joathon 做这件事，因为这就"}, {"type": "subtitle", "time": 1213.35, "timestamp": "00:20:13", "text": "像是一个亚军活动。 我需要把一"}, {"type": "subtitle", "time": 1215.27, "timestamp": "00:20:15", "text": "整天的事情都计划好"}, {"type": "subtitle", "time": 1217.669, "timestamp": "00:20:17", "text": "。 正确的。 最初我们"}, {"type": "subtitle", "time": 1219.909, "timestamp": "00:20:19", "text": "打算只花"}, {"type": "subtitle", "time": 1223.029, "timestamp": "00:20:23", "text": "运动会的费用做网站，只是为了制作"}, {"type": "subtitle", "time": 1225.43, "timestamp": "00:20:25", "text": "运动会页面，这样我就可以腾出时间来写"}, {"type": "subtitle", "time": 1226.95, "timestamp": "00:20:26", "text": "描述和其他内容，"}, {"type": "subtitle", "time": 1229.11, "timestamp": "00:20:29", "text": "方便链接。"}, {"type": "subtitle", "time": 1232.39, "timestamp": "00:20:32", "text": "但我被其他事情分散了注意力，我们开始"}, {"type": "subtitle", "time": 1235.75, "timestamp": "00:20:35", "text": "做那些其他的事情，对吧？"}, {"type": "subtitle", "time": 1238.87, "timestamp": "00:20:38", "text": "多余的、不必要的东西，嗯，"}, {"type": "subtitle", "time": 1242.149, "timestamp": "00:20:42", "text": "等等，对吧？   对"}, {"type": "subtitle", "time": 1243.669, "timestamp": "00:20:43", "text": "了，你的生日快到了"}, {"type": "subtitle", "time": 1245.59, "timestamp": "00:20:45", "text": "。 你兴奋吗？ 是啊，我有点"}, {"type": "subtitle", "time": 1249.909, "timestamp": "00:20:49", "text": "兴奋，但同时也有点"}, {"type": "subtitle", "time": 1252.63, "timestamp": "00:20:52", "text": "担心，因为我什么计划都没有，不知道"}, {"type": "subtitle", "time": 1256.47, "timestamp": "00:20:56", "text": "该做什么。 所以，我有点"}]
[{"type": "subtitle", "time": 540.71, "timestamp": "00:09:00", "text": "戰地6》目前正在進行公開"}, {"type": "subtitle", "time": 544.55, "timestamp": "00:09:04", "text": "測試，面向那些"}, {"type": "subtitle", "time": 547.43, "timestamp": "00:09:07", "text": "擁有提前體驗資格的人。對於那些沒有"}, {"type": "subtitle", "time": 550.949, "timestamp": "00:09:10", "text": "提前體驗資格的人來說，我必須等到"}, {"type": "subtitle", "time": 554.87, "timestamp": "00:09:14", "text": "8月9日。是的。所以今天"}, {"type": "subtitle", "time": 557.99, "timestamp": "00:09:17", "text": "就是7號了。明天。這讓我有時間"}, {"type": "subtitle", "time": 561.11, "timestamp": "00:09:21", "text": "到明天完成所有"}, {"type": "subtitle", "time": 565.43, "timestamp": "00:09:25", "text": "我想做的關於"}, {"type": "subtitle", "time": 567.43, "timestamp": "00:09:27", "text": "網站的事情，以及所有那些"}, {"type": "subtitle", "time": 572.23, "timestamp": "00:09:32", "text": "亂七八糟的事情等等。嗯，是的，在"}, {"type": "subtitle", "time": 579.75, "timestamp": "00:09:39", "text": "我今天離開之前，我"}, {"type": "subtitle", "time": 582.15, "timestamp": "00:09:42", "text": "想和大家談談幾件事，"}, {"type": "subtitle", "time": 585.75, "timestamp": "00:09:45", "text": "然後明天再最終確定。"}, {"type": "subtitle", "time": 589.91, "timestamp": "00:09:49", "text": "明天我可能會"}, {"type": "subtitle", "time": 592.31, "timestamp": "00:09:52", "text": "早起，我們早上會進行直播"}, {"type": "subtitle", "time": 596.79, "timestamp": "00:09:56", "text": "。呃，對了，今天"}, {"type": "subtitle", "time": 599.99, "timestamp": "00:09:59", "text": "是星期四。不，是明天的。"}]
[{"type": "subtitle", "time": 780.23, "timestamp": "00:13:00", "text": "版開放的時間。"}, {"type": "subtitle", "time": 784.15, "timestamp": "00:13:04", "text": "嗯，"}, {"type": "subtitle", "time": 796.389, "timestamp": "00:13:16", "text": "合作是6:30，所以6:00之前我就得"}, {"type": "subtitle", "time": 799.43, "timestamp": "00:13:19", "text": "結束直播了，"}, {"type": "subtitle", "time": 802.23, "timestamp": "00:13:22", "text": "我會不會累得筋疲力盡？雖然我玩"}, {"type": "subtitle", "time": 805.11, "timestamp": "00:13:25", "text": "DND的時候總是特別累，對吧？"}, {"type": "subtitle", "time": 806.949, "timestamp": "00:13:26", "text": "你可能也注意到了，"}, {"type": "subtitle", "time": 809.59, "timestamp": "00:13:29", "text": "上週二的DND直播我"}, {"type": "subtitle", "time": 812.23, "timestamp": "00:13:32", "text": "表現得不好。我"}, {"type": "subtitle", "time": 814.47, "timestamp": "00:13:34", "text": "說話不太清楚。我在"}, {"type": "subtitle", "time": 817.67, "timestamp": "00:13:37", "text": "DND遊戲中沒有好好參與。"}, {"type": "subtitle", "time": 819.59, "timestamp": "00:13:39", "text": "因為我覺得我不"}, {"type": "subtitle", "time": 822.069, "timestamp": "00:13:42", "text": "擅長角色扮演之"}, {"type": "subtitle", "time": 825.91, "timestamp": "00:13:45", "text": "類的，我覺得自己好像拖了"}, {"type": "subtitle", "time": 829.11, "timestamp": "00:13:49", "text": "大家的後腿。我不知道。"}, {"type": "subtitle", "time": 832.949, "timestamp": "00:13:52", "text": "我也是新人，但我感覺，是"}]
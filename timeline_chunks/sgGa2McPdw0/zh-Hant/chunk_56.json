[{"type": "subtitle", "time": 3370.23, "timestamp": "00:56:10", "text": "獨立合作等等。"}, {"type": "subtitle", "time": 3395.19, "timestamp": "00:56:35", "text": "呃，我今天吃了一點晚餐。"}, {"type": "subtitle", "time": 3399.349, "timestamp": "00:56:39", "text": "例如晚上8點。當時晚餐"}, {"type": "subtitle", "time": 3401.67, "timestamp": "00:56:41", "text": "還沒做好，所以我就隨便吃了點"}, {"type": "subtitle", "time": 3410.47, "timestamp": "00:56:50", "text": "。"}, {"type": "subtitle", "time": 3413.75, "timestamp": "00:56:53", "text": "瑪雅，兄弟，我為什麼覺得好睏？"}]
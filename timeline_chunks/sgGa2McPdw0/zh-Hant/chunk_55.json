[{"type": "subtitle", "time": 3305.67, "timestamp": "00:55:05", "text": "Shim的畫廊看起來不錯。"}, {"type": "subtitle", "time": 3307.589, "timestamp": "00:55:07", "text": "我們把所有事情都做完了。所以，"}, {"type": "subtitle", "time": 3309.99, "timestamp": "00:55:09", "text": "我很快就會玩的遊戲之一是《"}, {"type": "subtitle", "time": 3317.349, "timestamp": "00:55:17", "text": "和《森林之子》。我打算和"}, {"type": "subtitle", "time": 3323.109, "timestamp": "00:55:23", "text": "大家一起合作開發，不事先玩，"}, {"type": "subtitle", "time": 3326.79, "timestamp": "00:55:26", "text": "看看效果如何。當然，我總是有"}, {"type": "subtitle", "time": 3330.39, "timestamp": "00:55:30", "text": "那麼一部分的本能，讓"}, {"type": "subtitle", "time": 3334.069, "timestamp": "00:55:34", "text": "我可以"}, {"type": "subtitle", "time": 3336.15, "timestamp": "00:55:36", "text": "嘗試"}, {"type": "subtitle", "time": 3345.19, "timestamp": "00:55:45", "text": "但我感覺像是團隊合作。"}, {"type": "subtitle", "time": 3347.349, "timestamp": "00:55:47", "text": "我們必須進行森林合作。"}, {"type": "subtitle", "time": 3349.03, "timestamp": "00:55:49", "text": "不，"}]
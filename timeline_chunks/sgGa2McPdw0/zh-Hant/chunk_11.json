[{"type": "subtitle", "time": 662.55, "timestamp": "00:11:02", "text": "奇幻故事。你扮演的是一個"}, {"type": "subtitle", "time": 665.99, "timestamp": "00:11:05", "text": "設定好的角色，但一切都是"}, {"type": "subtitle", "time": 667.75, "timestamp": "00:11:07", "text": "虛構的。那裡處處都有地下"}, {"type": "subtitle", "time": 669.35, "timestamp": "00:11:09", "text": "城主。"}, {"type": "subtitle", "time": 672.069, "timestamp": "00:11:12", "text": "是的，我們有隊友、派對夥伴"}, {"type": "subtitle", "time": 674.31, "timestamp": "00:11:14", "text": "等等，你需要跟他們互動"}, {"type": "subtitle", "time": 678.949, "timestamp": "00:11:18", "text": "等等。呃，所有這些東西。"}, {"type": "subtitle", "time": 683.59, "timestamp": "00:11:23", "text": "兒子快進來了。晚安.  嗯，是的，我後天還有這件事"}, {"type": "subtitle", "time": 690.55, "timestamp": "00:11:30", "text": "。我把這件事忘了。"}, {"type": "subtitle", "time": 692.949, "timestamp": "00:11:32", "text": "這是每週一次的事情。不，是每個星期六都會發生的事。"}, {"type": "subtitle", "time": 697.19, "timestamp": "00:11:37", "text": "不。所以，如果我想……"}, {"type": "subtitle", "time": 698.71, "timestamp": "00:11:38", "text": "呃，"}, {"type": "subtitle", "time": 701.509, "timestamp": "00:11:41", "text": "如果我想……呃，"}, {"type": "subtitle", "time": 704.87, "timestamp": "00:11:44", "text": "告訴別人我不想"}, {"type": "subtitle", "time": 708.63, "timestamp": "00:11:48", "text": "在周六做這件事，或者過一會兒就突然"}, {"type": "subtitle", "time": 711.03, "timestamp": "00:11:51", "text": "離開，那就太沒禮貌了。那很糟糕。那樣做很"}, {"type": "subtitle", "time": 716.069, "timestamp": "00:11:56", "text": "失禮。不，問題是，《"}, {"type": "subtitle", "time": 719.43, "timestamp": "00:11:59", "text": "戰地6》將"}]
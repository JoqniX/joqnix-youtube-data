[{"type": "subtitle", "time": 240.949, "timestamp": "00:04:00", "text": "更新了軟體。"}, {"type": "subtitle", "time": 242.55, "timestamp": "00:04:02", "text": "嗯，"}, {"type": "subtitle", "time": 248.869, "timestamp": "00:04:08", "text": "好的，"}, {"type": "subtitle", "time": 251.03, "timestamp": "00:04:11", "text": "我馬上就要發射了。給我"}, {"type": "subtitle", "time": 254.22899999999998, "timestamp": "00:04:14", "text": "一分鐘時間。"}, {"type": "subtitle", "time": 257.349, "timestamp": "00:04:17", "text": "各位晚上好，"}, {"type": "subtitle", "time": 267.43, "timestamp": "00:04:27", "text": "讓我再確認一下我是否在線上。抽搐"}, {"type": "subtitle", "time": 270.15, "timestamp": "00:04:30", "text": "和踢腿。"}, {"type": "subtitle", "time": 274.31, "timestamp": "00:04:34", "text": "稍等片刻。"}, {"type": "subtitle", "time": 285.35, "timestamp": "00:04:45", "text": "好的。 Twitch一直不錯。"}, {"type": "subtitle", "time": 287.59000000000003, "timestamp": "00:04:47", "text": "Twitch看起來不錯。踢球看起來也不錯。好的。好的。"}, {"type": "subtitle", "time": 295.35, "timestamp": "00:04:55", "text": "你好。大家好。你們都好嗎？"}]
[{"type": "subtitle", "time": 3546.39, "timestamp": "00:59:06", "text": "你好，Takisan。歡迎光臨。晚安."}, {"type": "subtitle", "time": 3551.75, "timestamp": "00:59:11", "text": "Twitch 上有廣告。我們再等"}, {"type": "subtitle", "time": 3554.15, "timestamp": "00:59:14", "text": "一會兒。"}, {"type": "subtitle", "time": 3564.71, "timestamp": "00:59:24", "text": "我們當時就像在聊天一樣，你"}, {"type": "subtitle", "time": 3567.27, "timestamp": "00:59:27", "text": "知道的。我打算下週做一些改變，"}, {"type": "subtitle", "time": 3576.39, "timestamp": "00:59:36", "text": "我不確定是否應該繼續這些"}, {"type": "subtitle", "time": 3579.109, "timestamp": "00:59:39", "text": "工作流程。"}, {"type": "subtitle", "time": 3580.95, "timestamp": "00:59:40", "text": "我想知道是不是大家都覺得太無聊了"}, {"type": "subtitle", "time": 3593.43, "timestamp": "00:59:53", "text": "是的，我想看看事情會如何"}]
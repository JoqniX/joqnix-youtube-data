[{"type": "subtitle", "time": 721.829, "timestamp": "00:12:01", "text": "在8月9日"}, {"type": "subtitle", "time": 723.829, "timestamp": "00:12:03", "text": "和10日結束公開測試，面向所有人推出，對吧？那意味著我有一整天的時間"}, {"type": "subtitle", "time": 726.23, "timestamp": "00:12:06", "text": "。 8月10日，我一整天都有空"}, {"type": "subtitle", "time": 729.67, "timestamp": "00:12:09", "text": "。但問題是我的生日"}, {"type": "subtitle", "time": 731.829, "timestamp": "00:12:11", "text": "是8月11日。所以我必須做"}, {"type": "subtitle", "time": 735.829, "timestamp": "00:12:15", "text": "倒數直播。我得去做那"}, {"type": "subtitle", "time": 740.79, "timestamp": "00:12:20", "text": "件事。所以我時間不多了。不。"}, {"type": "subtitle", "time": 743.829, "timestamp": "00:12:23", "text": "呃，我必須做出犧牲，"}, {"type": "chat", "time": 757.603, "timestamp": "00:12:37", "author": "@yp_stream", "avatar": "https://yt4.ggpht.com/HXiutz56Epa3pzbWwrdMsb2LejiQy-QjaYyULoh1We3_KP37uiWNGUEBAoHdDooqzXDjXJx-9Q=s64-c-k-c0x00ffffff-no-rj", "message": "August 11 got it ."}, {"type": "subtitle", "time": 761.91, "timestamp": "00:12:41", "text": "所以，美國東部時間或太平洋時間早上 8 點，相當於下午 1:30"}, {"type": "subtitle", "time": 764.23, "timestamp": "00:12:44", "text": "或 2:30，也就是"}, {"type": "subtitle", "time": 769.11, "timestamp": "00:12:49", "text": "下午 2:30。印度標準時間（IST）"}, {"type": "subtitle", "time": 771.99, "timestamp": "00:12:51", "text": "是測試"}]
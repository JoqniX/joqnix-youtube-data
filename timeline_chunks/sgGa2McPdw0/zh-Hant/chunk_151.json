[{"type": "subtitle", "time": 9061.03, "timestamp": "02:31:01", "text": "不，"}, {"type": "subtitle", "time": 9064.23, "timestamp": "02:31:04", "text": "我其實不太了解這些印度創作者。  他叫什麼名字？就像他中途砸碎了攝影機一樣。他的攝影機。  兄弟，它叫什麼來著？誰在吹牛？  我的天哪。"}, {"type": "subtitle", "time": 9072.87, "timestamp": "02:31:12", "text": "我的天啊。"}, {"type": "subtitle", "time": 9079.03, "timestamp": "02:31:19", "text": "Twitch主播的東邊。  砸碎相機。  他在哪裡"}, {"type": "chat", "time": 9088.362, "timestamp": "02:31:28", "author": "@sarthaksharma2476", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kmJohYAdmpQzCNN96t58cLSK8spv6Y2ITutBFF9nvi9Z8=s64-c-k-c0x00ffffff-no-rj", "message": "kinda"}]
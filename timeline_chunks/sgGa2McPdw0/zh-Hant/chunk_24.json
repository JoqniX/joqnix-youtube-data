[{"type": "subtitle", "time": 1449.19, "timestamp": "00:24:09", "text": "注視他們的眼睛。暢所欲言，說說你的生活，任何你想分享的事。"}, {"type": "subtitle", "time": 1454.23, "timestamp": "00:24:14", "text": "看看效果如何，慢慢地，等"}, {"type": "subtitle", "time": 1457.11, "timestamp": "00:24:17", "text": "你適應了之後再嘗試。我"}, {"type": "subtitle", "time": 1466.31, "timestamp": "00:24:26", "text": "喜歡在不熟悉的環境中，例如和陌生人在一起的時候，保持眼神交流，分析他們的肢體語言等等，看看他們是否在認真聽你說話"}, {"type": "subtitle", "time": 1468.47, "timestamp": "00:24:28", "text": "，注意"}, {"type": "subtitle", "time": 1471.35, "timestamp": "00:24:31", "text": "觀察這些，看看效果如何。  這就是我能給你的建議"}]
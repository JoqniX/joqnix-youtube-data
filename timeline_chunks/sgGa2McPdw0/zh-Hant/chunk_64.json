[{"type": "subtitle", "time": 3840.549, "timestamp": "01:04:00", "text": "但我不會那麼做。我的意思是，如果你"}, {"type": "subtitle", "time": 3843.99, "timestamp": "01:04:03", "text": "想見我，那"}, {"type": "subtitle", "time": 3853.99, "timestamp": "01:04:13", "text": "我現在有點不自在。"}, {"type": "subtitle", "time": 3857.109, "timestamp": "01:04:17", "text": "我的一部分想法是，是的，我想展示"}, {"type": "subtitle", "time": 3859.19, "timestamp": "01:04:19", "text": "一下。"}, {"type": "subtitle", "time": 3882.95, "timestamp": "01:04:42", "text": "呃，寶貝，我可以"}, {"type": "subtitle", "time": 3895.91, "timestamp": "01:04:55", "text": "我可以嗎？我可以嗎？我可以嗎？我可以嗎？我可以嗎？我想做個實驗。好的"}, {"type": "subtitle", "time": 3897.829, "timestamp": "01:04:57", "text": "，別在意我。"}]
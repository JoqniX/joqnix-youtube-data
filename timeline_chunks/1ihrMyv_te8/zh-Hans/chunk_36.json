[{"type": "subtitle", "time": 2171.51, "timestamp": "00:36:11", "text": "对，她就是那个……我忘了说她的舌头了"}, {"type": "subtitle", "time": 2206.31, "timestamp": "00:36:46", "text": "我们就是你，你在我们的世界里。"}, {"type": "subtitle", "time": 2208.39, "timestamp": "00:36:48", "text": "等等，那个"}, {"type": "subtitle", "time": 2212.605, "timestamp": "00:36:52", "text": "造浪的世界是什么来着？ 忘了。"}, {"type": "subtitle", "time": 2214.39, "timestamp": "00:36:54", "text": "[笑声]"}]
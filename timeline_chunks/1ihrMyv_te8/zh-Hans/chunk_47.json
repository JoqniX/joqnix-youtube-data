[{"type": "subtitle", "time": 2830.39, "timestamp": "00:47:10", "text": "我想起了大卫。"}, {"type": "subtitle", "time": 2832.79, "timestamp": "00:47:12", "text": "我刚刚意识到大卫的穿着打扮，"}, {"type": "subtitle", "time": 2836.55, "timestamp": "00:47:16", "text": "所有东西都完全是赛博朋克标志，"}, {"type": "subtitle", "time": 2838.15, "timestamp": "00:47:18", "text": "色彩鲜艳，品牌标识，"}, {"type": "subtitle", "time": 2841.109, "timestamp": "00:47:21", "text": "一切都是色彩鲜艳的。"}]
[{"type": "subtitle", "time": 905.75, "timestamp": "00:15:05", "text": "我还没看过那玩意儿呢。 我只在"}, {"type": "subtitle", "time": 909.75, "timestamp": "00:15:09", "text": "推特上看到过一些相关的帖子，像是一些片段"}, {"type": "subtitle", "time": 913.59, "timestamp": "00:15:13", "text": "。"}, {"type": "subtitle", "time": 925.269, "timestamp": "00:15:25", "text": "对，是原神。"}, {"type": "subtitle", "time": 928.389, "timestamp": "00:15:28", "text": "哦，不是，呃，不是那种令人窒息的波浪。 抱歉，我"}, {"type": "subtitle", "time": 930.1, "timestamp": "00:15:30", "text": "以为你指的是枯萎。"}, {"type": "subtitle", "time": 931.509, "timestamp": "00:15:31", "text": "[笑声]"}, {"type": "subtitle", "time": 933.03, "timestamp": "00:15:33", "text": "走开。   是的"}, {"type": "subtitle", "time": 934.629, "timestamp": "00:15:34", "text": "，我们正在和他们比赛。 是的，我"}, {"type": "subtitle", "time": 938.615, "timestamp": "00:15:38", "text": "只是想谈谈这件事，就像"}, {"type": "subtitle", "time": 939.43, "timestamp": "00:15:39", "text": "（唱歌）说的，我们"}, {"type": "subtitle", "time": 943.67, "timestamp": "00:15:43", "text": "之前所在的最后一个国家，"}, {"type": "subtitle", "time": 955.269, "timestamp": "00:15:55", "text": "而且已经占据主导地位"}]
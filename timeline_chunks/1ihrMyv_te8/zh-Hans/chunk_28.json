[{"type": "subtitle", "time": 1688.549, "timestamp": "00:28:08", "text": "杀"}, {"type": "subtitle", "time": 1706.23, "timestamp": "00:28:26", "text": "她这话是什么意思？"}, {"type": "subtitle", "time": 1709.029, "timestamp": "00:28:29", "text": "等等，这款游戏里会有死亡场景吗？"}, {"type": "subtitle", "time": 1718.95, "timestamp": "00:28:38", "text": "这是什么火车？ 让我想起了"}, {"type": "subtitle", "time": 1735.59, "timestamp": "00:28:55", "text": "我的天啊。 枪手在这里。 哦，我可以"}, {"type": "subtitle", "time": 1739.19, "timestamp": "00:28:59", "text": "扮演她。 我的天啊。"}]
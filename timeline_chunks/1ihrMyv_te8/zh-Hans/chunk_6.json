[{"type": "subtitle", "time": 361.749, "timestamp": "00:06:01", "text": "另外，我今天会多说几句，因为"}, {"type": "subtitle", "time": 365.43, "timestamp": "00:06:05", "text": "室友没空，所以我可以……呃，他"}, {"type": "subtitle", "time": 369.749, "timestamp": "00:06:09", "text": "出去了，所以我可以……呃，多说几句。"}, {"type": "subtitle", "time": 374.309, "timestamp": "00:06:14", "text": "今天我们有一位嘉宾。"}, {"type": "subtitle", "time": 378.95, "timestamp": "00:06:18", "text": "尤兰，"}, {"type": "subtitle", "time": 381.99, "timestamp": "00:06:21", "text": "他今天会在这里。"}, {"type": "subtitle", "time": 383.99, "timestamp": "00:06:23", "text": "你好。  [笑声]"}]
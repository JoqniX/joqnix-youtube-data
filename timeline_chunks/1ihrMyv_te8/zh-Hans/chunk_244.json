[{"type": "subtitle", "time": 14651.189, "timestamp": "04:04:11", "text": "潺潺的流水。 我"}, {"type": "subtitle", "time": 14655.83, "timestamp": "04:04:15", "text": "是我吗？我有多长？"}, {"type": "subtitle", "time": 14657.67, "timestamp": "04:04:17", "text": "我的天哪，我落后10分钟了。 哦，对了"}, {"type": "subtitle", "time": 14659.189, "timestamp": "04:04:19", "text": "，再见。 没关系。 我想我会让它在"}, {"type": "subtitle", "time": 14661.59, "timestamp": "04:04:21", "text": "结尾场景停留一段时间，"}, {"type": "subtitle", "time": 14674.63, "timestamp": "04:04:34", "text": "观看并聆听到最后。"}, {"type": "subtitle", "time": 14678.07, "timestamp": "04:04:38", "text": "我发现我的网络很差。 情况很"}, {"type": "subtitle", "time": 14681.99, "timestamp": "04:04:41", "text": "糟糕。 我会做一些非直播状态下的测试，比如在"}, {"type": "subtitle", "time": 14687.99, "timestamp": "04:04:47", "text": "Twitch 上等等。 嗯，是的"}, {"type": "subtitle", "time": 14690.309, "timestamp": "04:04:50", "text": "。"}, {"type": "subtitle", "time": 14694.95, "timestamp": "04:04:54", "text": "呃，这个人为什么说一些粗鲁的"}, {"type": "subtitle", "time": 14698.55, "timestamp": "04:04:58", "text": "话？ 搞什么鬼？"}]
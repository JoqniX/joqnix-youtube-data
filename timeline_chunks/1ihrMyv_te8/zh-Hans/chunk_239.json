[{"type": "subtitle", "time": 14347.11, "timestamp": "03:59:07", "text": "好的，我只是在收集这些原始"}, {"type": "subtitle", "time": 14348.63, "timestamp": "03:59:08", "text": "小行星。"}, {"type": "subtitle", "time": 14353.99, "timestamp": "03:59:13", "text": "我的室友应该很快就能回来了。 我"}, {"type": "subtitle", "time": 14357.189, "timestamp": "03:59:17", "text": "想我今天可以结束今天的工作了。 我想"}, {"type": "subtitle", "time": 14374.229, "timestamp": "03:59:34", "text": "直到最后，我都收获了许多成就，这要花"}, {"type": "subtitle", "time": 14376.87, "timestamp": "03:59:36", "text": "多少时间呢？  4小时。 是的。"}, {"type": "subtitle", "time": 14378.95, "timestamp": "03:59:38", "text": "你吃过饭了吗？"}, {"type": "subtitle", "time": 14380.63, "timestamp": "03:59:40", "text": "是的，我刚吃过饭。"}, {"type": "subtitle", "time": 14384.15, "timestamp": "03:59:44", "text": "你休息好了吗？一切都好吗？"}, {"type": "subtitle", "time": 14386.07, "timestamp": "03:59:46", "text": "休息一下（笑声）"}, {"type": "subtitle", "time": 14389.99, "timestamp": "03:59:49", "text": "之后再好好休息。"}, {"type": "subtitle", "time": 14394.309, "timestamp": "03:59:54", "text": "你会陪我到最后。 谢谢。"}, {"type": "subtitle", "time": 14396.15, "timestamp": "03:59:56", "text": "我很高兴。"}, {"type": "subtitle", "time": 14398.309, "timestamp": "03:59:58", "text": "谢谢邀请。"}]
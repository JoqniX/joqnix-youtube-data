[{"type": "subtitle", "time": 1741.51, "timestamp": "00:29:01", "text": "纳尼，"}, {"type": "subtitle", "time": 1749.51, "timestamp": "00:29:09", "text": "我的天啊。"}, {"type": "subtitle", "time": 1752.389, "timestamp": "00:29:12", "text": "她摆了个姿势。"}, {"type": "subtitle", "time": 1754.95, "timestamp": "00:29:14", "text": "她有一把枪。"}, {"type": "subtitle", "time": 1758.31, "timestamp": "00:29:18", "text": "她能像蜘蛛侠一样荡来荡去。"}, {"type": "subtitle", "time": 1761.305, "timestamp": "00:29:21", "text": "你好。"}, {"type": "subtitle", "time": 1763.029, "timestamp": "00:29:23", "text": "[笑声]"}, {"type": "subtitle", "time": 1770.549, "timestamp": "00:29:30", "text": "的天哪，她摆了个姿势。"}, {"type": "subtitle", "time": 1772.63, "timestamp": "00:29:32", "text": "那更酷。 好的，我打算"}, {"type": "subtitle", "time": 1775.51, "timestamp": "00:29:35", "text": "主玩她。"}]
[{"type": "subtitle", "time": 11762.229, "timestamp": "03:16:02", "text": "才能恢复。"}, {"type": "subtitle", "time": 11784.79, "timestamp": "03:16:24", "text": "我的天，"}, {"type": "subtitle", "time": 11792.71, "timestamp": "03:16:32", "text": "我的天。"}, {"type": "subtitle", "time": 11794.95, "timestamp": "03:16:34", "text": "活在过去[笑声]。"}, {"type": "subtitle", "time": 11797.67, "timestamp": "03:16:37", "text": "我们活在过去。"}, {"type": "subtitle", "time": 11801.11, "timestamp": "03:16:41", "text": "等等，我怎么坐下？坐在月球上"}, {"type": "subtitle", "time": 11804.309, "timestamp": "03:16:44", "text": "。好像我也想坐下似的。我该去哪儿"}, {"type": "subtitle", "time": 11811.03, "timestamp": "03:16:51", "text": "我们可以晚点再联系他们[音乐]。"}, {"type": "subtitle", "time": 11812.87, "timestamp": "03:16:52", "text": "我联系不上。那我该去哪儿呢"}, {"type": "subtitle", "time": 11815.59, "timestamp": "03:16:55", "text": "？关卡完成。你想去吗"}, {"type": "subtitle", "time": 11816.07, "timestamp": "03:16:56", "text": "？"}, {"type": "subtitle", "time": 11818.229, "timestamp": "03:16:58", "text": "现在退出。"}]
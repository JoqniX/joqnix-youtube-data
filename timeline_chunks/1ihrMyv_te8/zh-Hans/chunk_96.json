[{"type": "subtitle", "time": 5798.47, "timestamp": "01:36:38", "text": "她怎么样？"}, {"type": "subtitle", "time": 5802.07, "timestamp": "01:36:42", "text": "她为什么要黑？"}, {"type": "subtitle", "time": 5805.83, "timestamp": "01:36:45", "text": "没有。"}, {"type": "subtitle", "time": 5817.669, "timestamp": "01:36:57", "text": "是的，看了《艾德·斯佩勒斯》之后，我"}, {"type": "subtitle", "time": 5819.59, "timestamp": "01:36:59", "text": "同意。她"}]
[{"type": "subtitle", "time": 4327.189, "timestamp": "01:12:07", "text": "但她应该到场。"}, {"type": "subtitle", "time": 4337.669, "timestamp": "01:12:17", "text": "另一种恐惧感是否凌驾于一切之上？"}, {"type": "subtitle", "time": 4341.03, "timestamp": "01:12:21", "text": "我不知道。"}, {"type": "subtitle", "time": 4351.03, "timestamp": "01:12:31", "text": "嗨，丽贝卡。"}, {"type": "subtitle", "time": 4359.83, "timestamp": "01:12:39", "text": "我甚至都无法和他们交谈。"}, {"type": "subtitle", "time": 4363.43, "timestamp": "01:12:43", "text": "是的，它们应该"}]
[{"type": "subtitle", "time": 1446.07, "timestamp": "00:24:06", "text": "电线。   对"}, {"type": "subtitle", "time": 1449.909, "timestamp": "00:24:09", "text": "，就是那根电线。 我记得当时"}, {"type": "subtitle", "time": 1452.63, "timestamp": "00:24:12", "text": "用那根电线进行了一场大屠杀，把所有的箱子都毁了"}, {"type": "subtitle", "time": 1456.07, "timestamp": "00:24:16", "text": "。 嗯，是的，你不能杀害"}, {"type": "subtitle", "time": 1460.39, "timestamp": "00:24:20", "text": "平民，但是……敌人。 现在，我就像"}, {"type": "subtitle", "time": 1463.43, "timestamp": "00:24:23", "text": "要把他们的头和胳膊都扯下"}, {"type": "subtitle", "time": 1493.11, "timestamp": "00:24:53", "text": "我的天哪，她的眼睛。 她的眼睛。"}]
[{"type": "subtitle", "time": 12084.389, "timestamp": "03:21:24", "text": "我的背叛仍然是布布。你是谁？"}, {"type": "subtitle", "time": 12086.389, "timestamp": "03:21:26", "text": "等等，只有我一个人在使用"}, {"type": "subtitle", "time": 12088.389, "timestamp": "03:21:28", "text": "Wi-Fi。等等，让我断开我的"}, {"type": "subtitle", "time": 12091.429, "timestamp": "03:21:31", "text": "手机。也许我能上网。"}, {"type": "subtitle", "time": 12093.59, "timestamp": "03:21:33", "text": "塔布姆。"}, {"type": "subtitle", "time": 12098.79, "timestamp": "03:21:38", "text": "不，让我看看我的 资源管理器。"}, {"type": "subtitle", "time": 12100.389, "timestamp": "03:21:40", "text": "呃，"}, {"type": "subtitle", "time": 12102.55, "timestamp": "03:21:42", "text": "应该没有别的了，"}, {"type": "subtitle", "time": 12105.91, "timestamp": "03:21:45", "text": "等等，Epic Games。让我关掉你。"}, {"type": "subtitle", "time": 12108.71, "timestamp": "03:21:48", "text": "想象一下如果是堡垒之夜之类的游戏。"}, {"type": "subtitle", "time": 12109.83, "timestamp": "03:21:49", "text": "好的。哦。嗯"}, {"type": "subtitle", "time": 12111.349, "timestamp": "03:21:51", "text": "。"}, {"type": "subtitle", "time": 12114.63, "timestamp": "03:21:54", "text": "呃，Steam 后台没有下载任何东西"}, {"type": "subtitle", "time": 12116.95, "timestamp": "03:21:56", "text": "。"}]
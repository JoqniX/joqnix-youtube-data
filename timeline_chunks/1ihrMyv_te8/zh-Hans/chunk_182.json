[{"type": "subtitle", "time": 10930.95, "timestamp": "03:02:10", "text": "丽贝卡，（清嗓子）不。不想出"}, {"type": "subtitle", "time": 10938.55, "timestamp": "03:02:18", "text": "我的天啊，"}, {"type": "subtitle", "time": 10941.67, "timestamp": "03:02:21", "text": "他们坐在月球上。"}, {"type": "subtitle", "time": 10948.95, "timestamp": "03:02:28", "text": "求求你，最后一次，求求你，"}]
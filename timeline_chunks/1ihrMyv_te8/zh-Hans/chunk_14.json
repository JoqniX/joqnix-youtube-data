[{"type": "subtitle", "time": 862.55, "timestamp": "00:14:22", "text": "梦幻般的优势。"}, {"type": "subtitle", "time": 865.909, "timestamp": "00:14:25", "text": "我的天哪，我的背叛简直是重蹈覆辙。"}, {"type": "subtitle", "time": 877.35, "timestamp": "00:14:37", "text": "我把它设置成了 2000 比特率。 好的。"}, {"type": "subtitle", "time": 883.829, "timestamp": "00:14:43", "text": "，仅仅 2,000。 最低级的"}, {"type": "subtitle", "time": 893.189, "timestamp": "00:14:53", "text": "我感到很吃力。"}, {"type": "subtitle", "time": 895.509, "timestamp": "00:14:55", "text": "最新更新。"}]
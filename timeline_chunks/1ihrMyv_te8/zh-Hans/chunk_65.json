[{"type": "subtitle", "time": 3902.309, "timestamp": "01:05:02", "text": "枯萎波还是生成"}, {"type": "subtitle", "time": 3904.23, "timestamp": "01:05:04", "text": "波。"}, {"type": "subtitle", "time": 3906.549, "timestamp": "01:05:06", "text": "原神不会，原神不会"}, {"type": "subtitle", "time": 3909.829, "timestamp": "01:05:09", "text": "像这样联动，他们会推出"}, {"type": "subtitle", "time": 3912.549, "timestamp": "01:05:12", "text": "一款不同的游戏，然后与一款"}, {"type": "subtitle", "time": 3923.75, "timestamp": "01:05:23", "text": "所以他们设定了一个标准，"}, {"type": "subtitle", "time": 3926.069, "timestamp": "01:05:26", "text": "原神必须跟进，"}, {"type": "subtitle", "time": 3930.71, "timestamp": "01:05:30", "text": "所以现在"}, {"type": "subtitle", "time": 3932.87, "timestamp": "01:05:32", "text": "我的意思是，看看星之"}]
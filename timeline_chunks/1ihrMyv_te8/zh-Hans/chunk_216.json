[{"type": "subtitle", "time": 12967.67, "timestamp": "03:36:07", "text": "等等，"}, {"type": "subtitle", "time": 12972.07, "timestamp": "03:36:12", "text": "我已经抽了73次了。我还是没抽到"}, {"type": "subtitle", "time": 12975.03, "timestamp": "03:36:15", "text": "露西。等等。这说不通"}, {"type": "subtitle", "time": 12976.55, "timestamp": "03:36:16", "text": "。"}, {"type": "subtitle", "time": 12980.07, "timestamp": "03:36:20", "text": "我是不是遇到了困难的怜悯机制，"}, {"type": "subtitle", "time": 12993.59, "timestamp": "03:36:33", "text": "我怎么给你覆盆子？"}, {"type": "subtitle", "time": 13009.91, "timestamp": "03:36:49", "text": "我需要它。我需要原石。我是说，"}, {"type": "subtitle", "time": 13012.87, "timestamp": "03:36:52", "text": "星石。"}, {"type": "subtitle", "time": 13014.71, "timestamp": "03:36:54", "text": "呃。"}, {"type": "subtitle", "time": 13016.469, "timestamp": "03:36:56", "text": "哦，我还有一次机会。好的，我可以"}, {"type": "subtitle", "time": 13018.229, "timestamp": "03:36:58", "text": "再抽一次。拜托。​​拜托。抽一个男人。"}]
[{"type": "subtitle", "time": 2419.91, "timestamp": "00:40:19", "text": "为什么艾比不去丽贝卡那里？ 她"}, {"type": "subtitle", "time": 2436.39, "timestamp": "00:40:36", "text": "那个叫佐佐木的家伙"}, {"type": "subtitle", "time": 2438.39, "timestamp": "00:40:38", "text": "忘了叫"}, {"type": "subtitle", "time": 2441.589, "timestamp": "00:40:41", "text": "什么来着，就是控制"}, {"type": "subtitle", "time": 2445.829, "timestamp": "00:40:45", "text": "其他义体之类的家伙，神经什么的，对，"}, {"type": "subtitle", "time": 2455.829, "timestamp": "00:40:55", "text": "侦察兵那种，哦，来自动画，我的"}]
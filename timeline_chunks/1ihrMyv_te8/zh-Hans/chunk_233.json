[{"type": "subtitle", "time": 13983.67, "timestamp": "03:53:03", "text": "抽到一个男人。抽到一个男人。抽到一个男人。哦，等等。"}, {"type": "subtitle", "time": 13988.07, "timestamp": "03:53:08", "text": "它要死了。等等，等等，等等。"}, {"type": "subtitle", "time": 14001.51, "timestamp": "03:53:21", "text": "我抽到了，我的保底没了。"}, {"type": "subtitle", "time": 14003.99, "timestamp": "03:53:23", "text": "兄弟，"}, {"type": "subtitle", "time": 14011.269, "timestamp": "03:53:31", "text": "我以为它应该给我。"}, {"type": "subtitle", "time": 14013.99, "timestamp": "03:53:33", "text": "嗯？"}, {"type": "subtitle", "time": 14022.309, "timestamp": "03:53:42", "text": "什么？"}, {"type": "subtitle", "time": 14028.79, "timestamp": "03:53:48", "text": "等等，"}, {"type": "subtitle", "time": 14032.79, "timestamp": "03:53:52", "text": "我以为我应该得到……"}]
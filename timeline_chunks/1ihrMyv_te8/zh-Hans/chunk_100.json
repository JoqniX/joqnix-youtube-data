[{"type": "subtitle", "time": 6003.109, "timestamp": "01:40:03", "text": "等等，亚当·斯佩勒秃头了吗？他什么时候"}, {"type": "subtitle", "time": 6007.669, "timestamp": "01:40:07", "text": "秃头的？等等，什么？"}, {"type": "subtitle", "time": 6023.35, "timestamp": "01:40:23", "text": "等等，他秃了。没头发了。"}, {"type": "subtitle", "time": 6025.109, "timestamp": "01:40:25", "text": "什么？"}, {"type": "subtitle", "time": 6034.95, "timestamp": "01:40:34", "text": "等等。没事了。"}, {"type": "subtitle", "time": 6036.709, "timestamp": "01:40:36", "text": "你说什么秃头？"}, {"type": "subtitle", "time": 6040.31, "timestamp": "01:40:40", "text": "我没头发，所以抱歉。这"}]
[{"type": "subtitle", "time": 14181.349, "timestamp": "03:56:21", "text": "我超过83了。"}, {"type": "subtitle", "time": 14188.95, "timestamp": "03:56:28", "text": "还是给我露西吧。 我想用我的"}, {"type": "subtitle", "time": 14190.95, "timestamp": "03:56:30", "text": "生日蛋糕来塑造一个好形象"}, {"type": "subtitle", "time": 14195.349, "timestamp": "03:56:35", "text": "。 哦，不。"}, {"type": "subtitle", "time": 14197.11, "timestamp": "03:56:37", "text": "别让我恨不得把生日"}, {"type": "subtitle", "time": 14199.429, "timestamp": "03:56:39", "text": "蛋糕拿来砸这件事。"}, {"type": "subtitle", "time": 14203.59, "timestamp": "03:56:43", "text": "我花的钱比这多得多"}, {"type": "subtitle", "time": 14213.11, "timestamp": "03:56:53", "text": "天，"}, {"type": "subtitle", "time": 14215.11, "timestamp": "03:56:55", "text": "这游戏。"}, {"type": "subtitle", "time": 14219.269, "timestamp": "03:56:59", "text": "等等，我有七个这样的。 等等，什么？"}]
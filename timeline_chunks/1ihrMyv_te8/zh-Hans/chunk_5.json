[{"type": "subtitle", "time": 327.189, "timestamp": "00:05:27", "text": "我希望"}, {"type": "subtitle", "time": 330.23, "timestamp": "00:05:30", "text": "今天我的作品能在三大音乐平台上都能被听到。"}, {"type": "subtitle", "time": 334.39, "timestamp": "00:05:34", "text": "你好。 所以，呃，我一直都想"}, {"type": "subtitle", "time": 336.31, "timestamp": "00:05:36", "text": "，"}, {"type": "subtitle", "time": 339.59000000000003, "timestamp": "00:05:39", "text": "呃，直播赛博朋克合作项目"}, {"type": "subtitle", "time": 342.629, "timestamp": "00:05:42", "text": "。 我们做了多少"}, {"type": "subtitle", "time": 345.67, "timestamp": "00:05:45", "text": "条流？ 几乎有四到五股枯萎的"}, {"type": "subtitle", "time": 348.15, "timestamp": "00:05:48", "text": "波浪涌来，逐渐跟上故事"}, {"type": "subtitle", "time": 351.27, "timestamp": "00:05:51", "text": "和一切。 一切只为体验这短暂而精彩的"}, {"type": "subtitle", "time": 356.15, "timestamp": "00:05:56", "text": "赛博朋克风格合作。   是的"}, {"type": "subtitle", "time": 358.79, "timestamp": "00:05:58", "text": "。 所以，我们终于要这么做了。"}]
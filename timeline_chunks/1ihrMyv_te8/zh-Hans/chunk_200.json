[{"type": "subtitle", "time": 12000.79, "timestamp": "03:20:00", "text": "为什么是卡罗和其他人？"}, {"type": "subtitle", "time": 12002.389, "timestamp": "03:20:02", "text": "好吧，那就邀请丽贝卡吧。"}, {"type": "subtitle", "time": 12004.71, "timestamp": "03:20:04", "text": "我不知道。"}, {"type": "subtitle", "time": 12007.75, "timestamp": "03:20:07", "text": "她为什么一个人？我在哪里？为什么"}, {"type": "subtitle", "time": 12021.269, "timestamp": "03:20:21", "text": "好吧，如果是这样的话，我就"}, {"type": "subtitle", "time": 12025.03, "timestamp": "03:20:25", "text": "和我的海岸守护者酱坐在一起。"}, {"type": "subtitle", "time": 12028.389, "timestamp": "03:20:28", "text": "海岸守护者酱。牵手不行，不能"}]
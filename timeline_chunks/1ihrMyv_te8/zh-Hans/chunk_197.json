[{"type": "subtitle", "time": 11820.95, "timestamp": "03:17:00", "text": "但我退出不了。"}, {"type": "subtitle", "time": 11821.6, "timestamp": "03:17:01", "text": "我退出不了。 什么？不是那个。"}, {"type": "subtitle", "time": 11825.04, "timestamp": "03:17:05", "text": "什么？不是那个。 夜之城。还没完成。"}, {"type": "subtitle", "time": 11829.2, "timestamp": "03:17:09", "text": "夜之城。还没完成。 好吧。"}, {"type": "subtitle", "time": 11830.88, "timestamp": "03:17:10", "text": "好吧。 矩阵。夜之城。"}, {"type": "subtitle", "time": 11833.6, "timestamp": "03:17:13", "text": "矩阵。夜之城。 限时任务。"}, {"type": "subtitle", "time": 11843.19, "timestamp": "03:17:23", "text": "我必须完成这个 现在。"}, {"type": "subtitle", "time": 11846.63, "timestamp": "03:17:26", "text": "把卢西奥·丽贝卡晋升到80级"}, {"type": "subtitle", "time": 11850.309, "timestamp": "03:17:30", "text": "粉碎者。啊，我得杀了他。"}, {"type": "subtitle", "time": 11854.07, "timestamp": "03:17:34", "text": "接下来公鸡会失去丽贝卡。好的。去"}, {"type": "subtitle", "time": 11855.91, "timestamp": "03:17:35", "text": "樱桃那里。完成"}, {"type": "subtitle", "time": 11858.389, "timestamp": "03:17:38", "text": "四次桥梁挑战。去娱乐中心。"}, {"type": "subtitle", "time": 11861.51, "timestamp": "03:17:41", "text": "在AI右侧表演兑换任意物品。"}, {"type": "subtitle", "time": 11864.71, "timestamp": "03:17:44", "text": "去300个台球标签。好的。去"}, {"type": "subtitle", "time": 11867.19, "timestamp": "03:17:47", "text": "中国。用厨师入侵"}, {"type": "subtitle", "time": 11870.309, "timestamp": "03:17:50", "text": "一次自动售货机任务。"}, {"type": "subtitle", "time": 11871.99, "timestamp": "03:17:51", "text": "去幻境，凝视"}]
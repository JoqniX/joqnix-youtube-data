[{"type": "subtitle", "time": 8951.75, "timestamp": "02:29:11", "text": "是的，我终于可以说话了。我的天哪，"}, {"type": "subtitle", "time": 8960.23, "timestamp": "02:29:20", "text": "我的……呃，高年级学生的"}, {"type": "subtitle", "time": 8964.23, "timestamp": "02:29:24", "text": "空闲时间。是的。嗯，高年级学生进来给"}, {"type": "subtitle", "time": 8966.469, "timestamp": "02:29:26", "text": "我送充电宝。我把充电宝给他是"}, {"type": "subtitle", "time": 8969.429, "timestamp": "02:29:29", "text": "因为他们去了……去了……去了……"}, {"type": "subtitle", "time": 8973.83, "timestamp": "02:29:33", "text": "他们昨天到了，"}, {"type": "subtitle", "time": 8980.15, "timestamp": "02:29:40", "text": "呃，他现在实际上去踢"}, {"type": "subtitle", "time": 8983.51, "timestamp": "02:29:43", "text": "足球了。所以，高年级学生"}, {"type": "subtitle", "time": 8985.99, "timestamp": "02:29:45", "text": "奎因也知道什么时候看"}, {"type": "subtitle", "time": 8990.71, "timestamp": "02:29:50", "text": "足球，所以我终于可以安心了。"}, {"type": "subtitle", "time": 8993.429, "timestamp": "02:29:53", "text": "问题是，现在当他们"}, {"type": "subtitle", "time": 8995.429, "timestamp": "02:29:55", "text": "在的时候，我不想说"}, {"type": "subtitle", "time": 8998.23, "timestamp": "02:29:58", "text": "太多话，因为这很尴尬之类的"}]
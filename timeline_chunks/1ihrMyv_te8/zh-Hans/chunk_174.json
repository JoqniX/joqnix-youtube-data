[{"type": "subtitle", "time": 10472.309, "timestamp": "02:54:32", "text": "等等。我的天啊。有一个迷你坦特，"}, {"type": "subtitle", "time": 10476.836, "timestamp": "02:54:36", "text": "我喝的能量饮料，幸存者"}, {"type": "subtitle", "time": 10477.51, "timestamp": "02:54:37", "text": "[尖叫]"}, {"type": "subtitle", "time": 10479.91, "timestamp": "02:54:39", "text": "一个叫幸存者的东西。它是一个粉红色的"}]
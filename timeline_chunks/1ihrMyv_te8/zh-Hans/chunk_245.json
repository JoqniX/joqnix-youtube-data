[{"type": "subtitle", "time": 14701.11, "timestamp": "04:05:01", "text": "踢球，对吧"}, {"type": "subtitle", "time": 14702.15, "timestamp": "04:05:02", "text": "？   是的"}, {"type": "subtitle", "time": 14703.59, "timestamp": "04:05:03", "text": "。 是的。 是的。   用"}, {"type": "subtitle", "time": 14705.349, "timestamp": "04:05:05", "text": "垃圾信息攻击一个喷子账号。"}, {"type": "subtitle", "time": 14707.83, "timestamp": "04:05:07", "text": "钓鱼账号。 我不知道"}, {"type": "subtitle", "time": 14711.91, "timestamp": "04:05:11", "text": "这个人到底怎么了。"}, {"type": "subtitle", "time": 14715.59, "timestamp": "04:05:15", "text": "他觉得自己足够聪明，可以"}, {"type": "subtitle", "time": 14724.63, "timestamp": "04:05:24", "text": "呃，这还用想吗？   终身"}, {"type": "subtitle", "time": 14727.59, "timestamp": "04:05:27", "text": "不死之人。"}, {"type": "subtitle", "time": 14729.8, "timestamp": "04:05:29", "text": "追求一种生活方式。"}, {"type": "subtitle", "time": 14731.03, "timestamp": "04:05:31", "text": "[笑声]"}, {"type": "subtitle", "time": 14733.59, "timestamp": "04:05:33", "text": "我不应该嘲讽别人。 哦，是的。 还有"}, {"type": "subtitle", "time": 14736.07, "timestamp": "04:05:36", "text": "评论。 我的天哪。 呃，那可糟了。 我"}, {"type": "subtitle", "time": 14738.07, "timestamp": "04:05:38", "text": "不得不说，"}, {"type": "subtitle", "time": 14745.51, "timestamp": "04:05:45", "text": "刷新一下。   好了"}, {"type": "subtitle", "time": 14747.51, "timestamp": "04:05:47", "text": "。"}, {"type": "subtitle", "time": 14751.99, "timestamp": "04:05:51", "text": "总之，就让它"}]
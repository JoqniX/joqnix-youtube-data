[{"type": "subtitle", "time": 6065.75, "timestamp": "01:41:05", "text": "他是不是又被大卫救了"}, {"type": "subtitle", "time": 6083.109, "timestamp": "01:41:23", "text": "我刚才看到她的鼻子动了。这"}, {"type": "subtitle", "time": 6084.79, "timestamp": "01:41:24", "text": "正常吗？"}, {"type": "subtitle", "time": 6099.51, "timestamp": "01:41:39", "text": "等一下。有人在"}]
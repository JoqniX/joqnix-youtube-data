[{"type": "subtitle", "time": 14765.11, "timestamp": "04:06:05", "text": "今天我玩得很开心。 我的网络"}, {"type": "subtitle", "time": 14767.75, "timestamp": "04:06:07", "text": "很差，但即便如此。 哇，"}, {"type": "subtitle", "time": 14771.065, "timestamp": "04:06:11", "text": "现在稳定了。 一秒钟。"}, {"type": "subtitle", "time": 14780.79, "timestamp": "04:06:20", "text": "呃，我的室友们回来了。 嗯，"}, {"type": "subtitle", "time": 14782.71, "timestamp": "04:06:22", "text": "再次感谢大家"}, {"type": "subtitle", "time": 14785.51, "timestamp": "04:06:25", "text": "今天过来"}, {"type": "subtitle", "time": 14788.469, "timestamp": "04:06:28", "text": "陪我度过今晚。"}, {"type": "subtitle", "time": 14791.91, "timestamp": "04:06:31", "text": "我真的很喜欢网络探险，"}, {"type": "subtitle", "time": 14793.67, "timestamp": "04:06:33", "text": "明天"}, {"type": "subtitle", "time": 14796.229, "timestamp": "04:06:36", "text": "直播见！ 明天我要和"}, {"type": "subtitle", "time": 14801.03, "timestamp": "04:06:41", "text": "一些我认识的油管主播一起玩《Meta Chameleon》"}, {"type": "subtitle", "time": 14804.309, "timestamp": "04:06:44", "text": "。 我还没跟他们谈过"}, {"type": "subtitle", "time": 14806.389, "timestamp": "04:06:46", "text": "。 他们是新来的。 不过，"}, {"type": "subtitle", "time": 14808.95, "timestamp": "04:06:48", "text": "它们很可能会是英语"}]
[{"type": "subtitle", "time": 10153.91, "timestamp": "02:49:13", "text": "好了，最终决战开始了，"}, {"type": "subtitle", "time": 10156.55, "timestamp": "02:49:16", "text": "各位。"}, {"type": "subtitle", "time": 10158.63, "timestamp": "02:49:18", "text": "最终决战。你好吗？我"}, {"type": "subtitle", "time": 10160.71, "timestamp": "02:49:20", "text": "很好，迪奥。今天"}, {"type": "subtitle", "time": 10163.59, "timestamp": "02:49:23", "text": "自由多了，因为没有室友。他们刚"}, {"type": "subtitle", "time": 10169.19, "timestamp": "02:49:29", "text": "出去。[笑声]我可以说很多话。"}, {"type": "subtitle", "time": 10179.269, "timestamp": "02:49:39", "text": "换个位置。是"}]
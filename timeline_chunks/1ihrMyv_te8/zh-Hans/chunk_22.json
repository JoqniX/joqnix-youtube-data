[{"type": "subtitle", "time": 1320.71, "timestamp": "00:22:00", "text": "用……呃……这是什么？她叫什么名字来"}, {"type": "subtitle", "time": 1322.63, "timestamp": "00:22:02", "text": "着？"}, {"type": "subtitle", "time": 1340.71, "timestamp": "00:22:20", "text": "就像你一样，你可以跳起来，"}, {"type": "subtitle", "time": 1365.83, "timestamp": "00:22:45", "text": "我的天啊。 简直太可怕了！"}, {"type": "subtitle", "time": 1368.39, "timestamp": "00:22:48", "text": "枪已到位。"}, {"type": "subtitle", "time": 1371.19, "timestamp": "00:22:51", "text": "等等，我们这游戏里有枪吗"}, {"type": "subtitle", "time": 1373.27, "timestamp": "00:22:53", "text": "？"}, {"type": "subtitle", "time": 1378.63, "timestamp": "00:22:58", "text": "我们有枪，但没有那种枪。"}]
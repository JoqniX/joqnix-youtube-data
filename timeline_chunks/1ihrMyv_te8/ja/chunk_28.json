[{"type": "subtitle", "time": 1706.23, "timestamp": "00:28:26", "text": "彼女はどういう意味でそう言っているのだろうか？"}, {"type": "subtitle", "time": 1709.029, "timestamp": "00:28:29", "text": "待って、このゲームで死の場面は出てくるの？"}, {"type": "subtitle", "time": 1718.95, "timestamp": "00:28:38", "text": "これは何の列車ですか？"}, {"type": "subtitle", "time": 1735.59, "timestamp": "00:28:55", "text": "。 ガンナーはここにいる。 ああ、私、"}, {"type": "subtitle", "time": 1739.19, "timestamp": "00:28:59", "text": "彼女を演じられるわ。 何てことだ。"}]
[{"type": "subtitle", "time": 1741.51, "timestamp": "00:29:01", "text": "ナニ、"}, {"type": "subtitle", "time": 1749.51, "timestamp": "00:29:09", "text": "。"}, {"type": "subtitle", "time": 1752.389, "timestamp": "00:29:12", "text": "彼女にはポーズがある。"}, {"type": "subtitle", "time": 1754.95, "timestamp": "00:29:14", "text": "彼女は銃を持っている。"}, {"type": "subtitle", "time": 1758.31, "timestamp": "00:29:18", "text": "彼女はスパイダーマンのようにスイングできる。"}, {"type": "subtitle", "time": 1761.305, "timestamp": "00:29:21", "text": "こんにちは。"}, {"type": "subtitle", "time": 1763.029, "timestamp": "00:29:23", "text": "[笑い]"}, {"type": "subtitle", "time": 1770.549, "timestamp": "00:29:30", "text": "ああ、彼女はポーズを決めている。"}, {"type": "subtitle", "time": 1772.63, "timestamp": "00:29:32", "text": "そっちの方がかっこいい。 よし、彼女を"}, {"type": "subtitle", "time": 1775.51, "timestamp": "00:29:35", "text": "メインキャラにしよう。"}]
[{"type": "subtitle", "time": 1446.07, "timestamp": "00:24:06", "text": "ワイヤー。   ああ"}, {"type": "subtitle", "time": 1449.909, "timestamp": "00:24:09", "text": "、あのワイヤーだ。 私はあの"}, {"type": "subtitle", "time": 1452.63, "timestamp": "00:24:12", "text": "ワイヤーを使って虐殺を行い、すべての"}, {"type": "subtitle", "time": 1456.07, "timestamp": "00:24:16", "text": "ボックスを破壊したのを覚えている。 ええ、市民を殺すことはできませんが"}, {"type": "subtitle", "time": 1460.39, "timestamp": "00:24:20", "text": "、敵は殺せます。 今度は、"}, {"type": "subtitle", "time": 1463.43, "timestamp": "00:24:23", "text": "奴らの頭を引きちぎり、腕を引きちぎってやった"}, {"type": "subtitle", "time": 1493.11, "timestamp": "00:24:53", "text": "、彼女の目。 彼女の目。"}]
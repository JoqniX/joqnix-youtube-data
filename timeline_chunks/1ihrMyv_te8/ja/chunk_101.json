[{"type": "subtitle", "time": 6065.75, "timestamp": "01:41:05", "text": "彼はまたデイビッドに助けられるの"}, {"type": "subtitle", "time": 6083.109, "timestamp": "01:41:23", "text": "彼女の鼻が動いたのを見た。それは"}, {"type": "subtitle", "time": 6084.79, "timestamp": "01:41:24", "text": "普通？"}, {"type": "subtitle", "time": 6099.51, "timestamp": "01:41:39", "text": "ちょっと待って。誰かが"}]
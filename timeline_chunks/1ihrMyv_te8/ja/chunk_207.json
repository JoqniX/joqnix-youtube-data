[{"type": "subtitle", "time": 12420.55, "timestamp": "03:27:00", "text": "ここにあるのか？"}, {"type": "subtitle", "time": 12424.15, "timestamp": "03:27:04", "text": "ああ、それはただ そこ。それを手に入れて。"}, {"type": "subtitle", "time": 12433.67, "timestamp": "03:27:13", "text": "だって私は何も受け取らないから。"}, {"type": "subtitle", "time": 12437.99, "timestamp": "03:27:17", "text": "ああ、あなたの配信はちょっと悪いね。"}, {"type": "subtitle", "time": 12439.51, "timestamp": "03:27:19", "text": "追いつくのに。"}, {"type": "subtitle", "time": 12441.429, "timestamp": "03:27:21", "text": "ああ、本当に？"}, {"type": "subtitle", "time": 12443.75, "timestamp": "03:27:23", "text": "うん。今1分遅れてる。"}, {"type": "subtitle", "time": 12445.75, "timestamp": "03:27:25", "text": "ああ、"}, {"type": "subtitle", "time": 12448.55, "timestamp": "03:27:28", "text": "神様。休まなくちゃ。そして、"}, {"type": "subtitle", "time": 12452.469, "timestamp": "03:27:32", "text": "so as as so ha のスペルを間違えたことに今気づいた。元気だといいな"}, {"type": "subtitle", "time": 12469.91, "timestamp": "03:27:49", "text": "待って、ただそれをファームしてるだけ。"}, {"type": "subtitle", "time": 12473.83, "timestamp": "03:27:53", "text": "プルタブをたくさん手に入れてる。"}, {"type": "subtitle", "time": 12475.91, "timestamp": "03:27:55", "text": "ねえ、ずっと続けて"}, {"type": "subtitle", "time": 12477.83, "timestamp": "03:27:57", "text": "ファームできるよ"}]
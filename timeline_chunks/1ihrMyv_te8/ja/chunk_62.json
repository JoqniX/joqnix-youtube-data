[{"type": "subtitle", "time": 3722.789, "timestamp": "01:02:02", "text": "えっと、ボーナスガンは手に入れました。 ファントム・"}, {"type": "subtitle", "time": 3725.67, "timestamp": "01:02:05", "text": "リベルティーナ。"}, {"type": "subtitle", "time": 3732.23, "timestamp": "01:02:12", "text": "スパイ予告編の拡張版。 わかった。 あれは"}, {"type": "subtitle", "time": 3733.99, "timestamp": "01:02:13", "text": "完全に情報"}, {"type": "subtitle", "time": 3735.99, "timestamp": "01:02:15", "text": "交換だったんだよ、レオン。 あ、待って。 彼女はまだ"}, {"type": "subtitle", "time": 3739.19, "timestamp": "01:02:19", "text": "ここにいる。 ああ、こんにちは。 何？ あなたはドアから入ったと思ったのですが"}, {"type": "subtitle", "time": 3741.43, "timestamp": "01:02:21", "text": "、入っていませんでしたね"}, {"type": "subtitle", "time": 3760.95, "timestamp": "01:02:40", "text": "準備できました。"}, {"type": "subtitle", "time": 3767.99, "timestamp": "01:02:47", "text": "二段ベッドでのコラボレーションはどれくらいの期間続いたのですか？  3"}]
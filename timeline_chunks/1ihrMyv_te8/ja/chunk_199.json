[{"type": "subtitle", "time": 11941.03, "timestamp": "03:19:01", "text": "ねえ、"}, {"type": "subtitle", "time": 11947.429, "timestamp": "03:19:07", "text": "イリュージョンに行こう。よし、"}, {"type": "subtitle", "time": 11955.843, "timestamp": "03:19:15", "text": "インターネット。"}, {"type": "subtitle", "time": 11980.71, "timestamp": "03:19:40", "text": "また月にいる。仲間を一人招待して、"}, {"type": "subtitle", "time": 11984.229, "timestamp": "03:19:44", "text": "月の惑星を眺めよう。M。"}, {"type": "subtitle", "time": 11986.71, "timestamp": "03:19:46", "text": "誰を招待すればいいかな？"}, {"type": "subtitle", "time": 11988.469, "timestamp": "03:19:48", "text": "本当にそこにいたい。ああ、"}, {"type": "subtitle", "time": 11992.07, "timestamp": "03:19:52", "text": "レベッカ。待って、本当に"}, {"type": "subtitle", "time": 11995.59, "timestamp": "03:19:55", "text": "黒いシャワーを浴びることができる。"}, {"type": "subtitle", "time": 11997.67, "timestamp": "03:19:57", "text": "誰もいない。よし。他の人たち。待って、"}]
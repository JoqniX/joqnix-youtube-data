[{"type": "subtitle", "time": 14863.75, "timestamp": "04:07:43", "text": "はい、わかりました。もう行かなければなりませんでした。 ええ、そうですね。 えっと、"}, {"type": "subtitle", "time": 14865.83, "timestamp": "04:07:45", "text": "こんにちは。 本日もありがとうございました。"}, {"type": "subtitle", "time": 14868.389, "timestamp": "04:07:48", "text": "次の配信でお会いしましょう。それでは、さようなら。"}, {"type": "subtitle", "time": 14871.349, "timestamp": "04:07:51", "text": "そして、配信がまだ"}, {"type": "subtitle", "time": 14874.79, "timestamp": "04:07:54", "text": "遅れているので、エンディング"}, {"type": "subtitle", "time": 14877.349, "timestamp": "04:07:57", "text": "シーンを少しの間続けてから、話を締めくくりたいと思います"}]
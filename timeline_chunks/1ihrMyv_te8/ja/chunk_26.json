[{"type": "subtitle", "time": 1562.95, "timestamp": "00:26:02", "text": "私は自問した。「彼らはどうやって"}, {"type": "subtitle", "time": 1566.31, "timestamp": "00:26:06", "text": "レベッカを生き返らせたのだろう？」"}, {"type": "subtitle", "time": 1569.51, "timestamp": "00:26:09", "text": "その話には何か重要な意味があると思う。"}, {"type": "subtitle", "time": 1577.19, "timestamp": "00:26:17", "text": "デイビッド、"}, {"type": "subtitle", "time": 1579.75, "timestamp": "00:26:19", "text": "そうですね、質問するのは気をつけないと、"}, {"type": "subtitle", "time": 1582.149, "timestamp": "00:26:22", "text": "[笑い]"}, {"type": "subtitle", "time": 1604.71, "timestamp": "00:26:44", "text": "誰ですか？ こちらはUAです。"}, {"type": "subtitle", "time": 1608.789, "timestamp": "00:26:48", "text": "こんにちは。 うん。 こんにちは。"}, {"type": "subtitle", "time": 1610.149, "timestamp": "00:26:50", "text": "ただのんびり過ごしているだけ。 ただのんびりしているだけです。 気にしないでください"}]
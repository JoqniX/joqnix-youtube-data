[{"type": "subtitle", "time": 14280.229, "timestamp": "03:58:00", "text": "版か何か？"}, {"type": "subtitle", "time": 14288.229, "timestamp": "03:58:08", "text": "注目の"}, {"type": "subtitle", "time": 14290.71, "timestamp": "03:58:10", "text": "バナーは両方とも共有されているのですか？"}, {"type": "subtitle", "time": 14295.429, "timestamp": "03:58:15", "text": "共有されていますか？ 注目の武器。"}, {"type": "subtitle", "time": 14295.75, "timestamp": "03:58:15", "text": "ええ、そう思います"}, {"type": "subtitle", "time": 14296.63, "timestamp": "03:58:16", "text": "。"}, {"type": "subtitle", "time": 14303.51, "timestamp": "03:58:23", "text": "待って、"}, {"type": "subtitle", "time": 14312.389, "timestamp": "03:58:32", "text": "そう思います。"}, {"type": "subtitle", "time": 14314.71, "timestamp": "03:58:34", "text": "伝説を打ち砕く者。 わかりました、そうします"}, {"type": "subtitle", "time": 14317.189, "timestamp": "03:58:37", "text": "。"}, {"type": "subtitle", "time": 14321.99, "timestamp": "03:58:41", "text": "私は彼を打ち負かした。"}, {"type": "subtitle", "time": 14324.469, "timestamp": "03:58:44", "text": "君はまた遅れているよ。 うん。 また遅れをとってしまった"}]
[{"type": "subtitle", "time": 2171.51, "timestamp": "00:36:11", "text": "ええ、彼女はあの、えっと、もう舌を忘れました"}, {"type": "subtitle", "time": 2206.31, "timestamp": "00:36:46", "text": "私たちは、あなたが私たちの世界にいる。"}, {"type": "subtitle", "time": 2208.39, "timestamp": "00:36:48", "text": "待って、"}, {"type": "subtitle", "time": 2212.605, "timestamp": "00:36:52", "text": "えっと、波を作る世界って何だったっけ？ 忘れていた。"}, {"type": "subtitle", "time": 2214.39, "timestamp": "00:36:54", "text": "[笑い]"}]
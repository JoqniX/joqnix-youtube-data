[{"type": "subtitle", "time": 14347.11, "timestamp": "03:59:07", "text": "はい、私はただこれらのプリム"}, {"type": "subtitle", "time": 14348.63, "timestamp": "03:59:08", "text": "小惑星を集めているだけです。"}, {"type": "subtitle", "time": 14351.429, "timestamp": "03:59:11", "text": "この時点からすると、"}, {"type": "subtitle", "time": 14353.99, "timestamp": "03:59:13", "text": "ルームメイトはもうすぐ戻ってくるはずだ。 これで一旦終わりにしたいと"}, {"type": "subtitle", "time": 14357.189, "timestamp": "03:59:17", "text": "思います。 たぶん、"}, {"type": "subtitle", "time": 14374.229, "timestamp": "03:59:34", "text": "何時間くらいかけて達成してきたことが、最後までずっと続いています。"}, {"type": "subtitle", "time": 14376.87, "timestamp": "03:59:36", "text": "4時間。 うん。 あなたによって、"}, {"type": "subtitle", "time": 14378.95, "timestamp": "03:59:38", "text": "あなたは食べましたか？"}, {"type": "subtitle", "time": 14380.63, "timestamp": "03:59:40", "text": "ええ、ちょうど食べたところです。   ちゃんと"}, {"type": "subtitle", "time": 14384.15, "timestamp": "03:59:44", "text": "休めた？"}, {"type": "subtitle", "time": 14386.07, "timestamp": "03:59:46", "text": "休息[笑い]"}, {"type": "subtitle", "time": 14389.99, "timestamp": "03:59:49", "text": "この後はもっと休息。"}, {"type": "subtitle", "time": 14394.309, "timestamp": "03:59:54", "text": "あなたは最後まで私と一緒にいてくれる。 ありがとう。"}, {"type": "subtitle", "time": 14396.15, "timestamp": "03:59:56", "text": "私は幸せです。   お招きいただき"}, {"type": "subtitle", "time": 14398.309, "timestamp": "03:59:58", "text": "ありがとうございます。"}]
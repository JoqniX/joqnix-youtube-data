[{"type": "subtitle", "time": 12544.63, "timestamp": "03:29:04", "text": "ああ、待って。できた。待って。これは何？"}, {"type": "subtitle", "time": 12547.67, "timestamp": "03:29:07", "text": "ああ、違反プロトコル。"}, {"type": "subtitle", "time": 12562.389, "timestamp": "03:29:22", "text": "よし、"}, {"type": "subtitle", "time": 12568.55, "timestamp": "03:29:28", "text": "。うん。ストリームがやっと"}, {"type": "subtitle", "time": 12570.87, "timestamp": "03:29:30", "text": "みんなに追いついた。"}, {"type": "subtitle", "time": 12586.79, "timestamp": "03:29:46", "text": "よし。プロトコル違反がもう1つ。どこにいるの"}, {"type": "subtitle", "time": 12596.309, "timestamp": "03:29:56", "text": "待って、アパートはどこ？ああ、そうだ。もう"}]
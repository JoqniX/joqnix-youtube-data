[{"type": "subtitle", "time": 11523.99, "timestamp": "03:12:03", "text": "君は3時間も遊んでいたんだ。やめてくれ"}, {"type": "subtitle", "time": 11526.79, "timestamp": "03:12:06", "text": "。3時間も遊んでいるのは分かってる"}, {"type": "subtitle", "time": 11530.71, "timestamp": "03:12:10", "text": "。その前に、ルーシーを送り出して。"}, {"type": "subtitle", "time": 11543.59, "timestamp": "03:12:23", "text": "うん。"}, {"type": "subtitle", "time": 11545.83, "timestamp": "03:12:25", "text": "待って、座れるよ 月。でも、無理。わからないと思う"}, {"type": "subtitle", "time": 11547.349, "timestamp": "03:12:27", "text": "。じっと"}, {"type": "subtitle", "time": 11549.51, "timestamp": "03:12:29", "text": "見つめることができる。"}, {"type": "subtitle", "time": 11576.63, "timestamp": "03:12:56", "text": "分。10"}]
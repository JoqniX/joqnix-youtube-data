[{"type": "subtitle", "time": 10472.309, "timestamp": "02:54:32", "text": "待って。ああ、なんてことだ。ミニタントルがある。私が飲んでいるエナジードリンクは"}, {"type": "subtitle", "time": 10476.836, "timestamp": "02:54:36", "text": "サバイバーです"}, {"type": "subtitle", "time": 10477.51, "timestamp": "02:54:37", "text": "[叫び声]"}, {"type": "subtitle", "time": 10479.91, "timestamp": "02:54:39", "text": "サバイバーと呼ばれるものです。ピンク色のええと、何かです"}]
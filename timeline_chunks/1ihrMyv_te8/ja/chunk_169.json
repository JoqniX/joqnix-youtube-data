[{"type": "subtitle", "time": 10153.91, "timestamp": "02:49:13", "text": "よし、最終決戦が始まりました、"}, {"type": "subtitle", "time": 10156.55, "timestamp": "02:49:16", "text": "皆さん。"}, {"type": "subtitle", "time": 10158.63, "timestamp": "02:49:18", "text": "最終決戦。調子はどうですか？"}, {"type": "subtitle", "time": 10160.71, "timestamp": "02:49:20", "text": "絶好調だよ、ディオ。今日は"}, {"type": "subtitle", "time": 10163.59, "timestamp": "02:49:23", "text": "ルームメイトがいないのでとても自由だ。彼らはちょうど出かけたところだ"}, {"type": "subtitle", "time": 10169.19, "timestamp": "02:49:29", "text": "。[笑い]たくさん話せる。"}, {"type": "subtitle", "time": 10179.269, "timestamp": "02:49:39", "text": "場所を交代する。"}]
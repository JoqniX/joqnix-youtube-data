[{"type": "subtitle", "time": 3975.67, "timestamp": "01:06:15", "text": "うん、ルーシーのグラデーションの瞳は本当に素敵だね。   私の"}, {"type": "subtitle", "time": 3989.029, "timestamp": "01:06:29", "text": "だから、もし私がゲームキャラクターになるとしたら、"}, {"type": "subtitle", "time": 3991.67, "timestamp": "01:06:31", "text": "ルーシーの目とかに似た感じになると思う"}, {"type": "subtitle", "time": 3995.67, "timestamp": "01:06:35", "text": "けど、これは反転した感じになる。"}, {"type": "subtitle", "time": 3999.91, "timestamp": "01:06:39", "text": "左側は反転されます。 えっと、ナンカは"}, {"type": "subtitle", "time": 4007.349, "timestamp": "01:06:47", "text": "ゲームキャラクターモデルを作っている人たちにとっては錫ではないでしょう。"}, {"type": "subtitle", "time": 4010.23, "timestamp": "01:06:50", "text": "来る。 うん。 さよなら。 複雑なデザインは"}]
[{"type": "subtitle", "time": 10083.59, "timestamp": "02:48:03", "text": "18 36。ああ、赤です。 いいえ。こんにちは、Shi。"}, {"type": "subtitle", "time": 10087.99, "timestamp": "02:48:07", "text": "あ、待って。どうやって人にメッセージを送るの？"}, {"type": "subtitle", "time": 10096.95, "timestamp": "02:48:16", "text": "集中してシールド。"}, {"type": "subtitle", "time": 10101.429, "timestamp": "02:48:21", "text": "私のストリームは死につつあり、インターネットが悪いため[音楽]が遅れています"}, {"type": "subtitle", "time": 10106.23, "timestamp": "02:48:26", "text": "が、"}, {"type": "chat", "time": 10106.972, "timestamp": "02:48:26", "author": "@Whimsy_Mage", "avatar": "https://yt4.ggpht.com/CPeztjBtGGO6iRvNVdfAPqZIvi6UhXBUSjIurGXKrrFdoTqyRS6ERk5wPKAWGWnWk05hjmbflg=s64-c-k-c0x00ffffff-no-rj", "message": "I noticed that the close the stream caught up the more buffers they had"}, {"type": "subtitle", "time": 10109.429, "timestamp": "02:48:29", "text": "すぐに追いつきます。4分"}, {"type": "subtitle", "time": 10116.15, "timestamp": "02:48:36", "text": "今は1分だと思います。あ、待って。1"}, {"type": "subtitle", "time": 10119.429, "timestamp": "02:48:39", "text": "分です。"}, {"type": "subtitle", "time": 10120.87, "timestamp": "02:48:40", "text": "まだあります。ええ"}, {"type": "subtitle", "time": 10123.429, "timestamp": "02:48:43", "text": "。どこ？いつ月に到達したんだ"}]
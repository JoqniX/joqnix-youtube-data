[{"type": "subtitle", "time": 12000.79, "timestamp": "03:20:00", "text": "なぜカロと他の人たちなの？"}, {"type": "subtitle", "time": 12002.389, "timestamp": "03:20:02", "text": "よし、レベッカを招待しよう。わから"}, {"type": "subtitle", "time": 12004.71, "timestamp": "03:20:04", "text": "ない。"}, {"type": "subtitle", "time": 12007.75, "timestamp": "03:20:07", "text": "なぜ彼女は一人なの？私はどこにいるの？なぜ"}, {"type": "subtitle", "time": 12021.269, "timestamp": "03:20:21", "text": "よし、それなら、えっと、"}, {"type": "subtitle", "time": 12025.03, "timestamp": "03:20:25", "text": "ショアキーパーちゃんと一緒に座ろう。"}, {"type": "subtitle", "time": 12028.389, "timestamp": "03:20:28", "text": "ショアキーパーちゃん。手をつないで、"}]
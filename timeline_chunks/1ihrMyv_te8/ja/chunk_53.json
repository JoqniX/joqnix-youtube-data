[{"type": "subtitle", "time": 3181.99, "timestamp": "00:53:01", "text": "ハッカーとしての能力を持っている。 さあ行こう"}, {"type": "subtitle", "time": 3192.069, "timestamp": "00:53:12", "text": "ああ、演奏できますよ。"}, {"type": "subtitle", "time": 3195.51, "timestamp": "00:53:15", "text": "手軽な裏技の使い方。 いや、まさか"}, {"type": "subtitle", "time": 3198.309, "timestamp": "00:53:18", "text": "。 彼らはクイック"}, {"type": "subtitle", "time": 3199.829, "timestamp": "00:53:19", "text": "ハット"}, {"type": "subtitle", "time": 3215.67, "timestamp": "00:53:35", "text": "。 クレイジー。"}, {"type": "subtitle", "time": 3217.387, "timestamp": "00:53:37", "text": "レベッカ。"}, {"type": "subtitle", "time": 3225.27, "timestamp": "00:53:45", "text": "ああ、彼女がショットガンを使うのを忘れてた。 ちくしょう"}, {"type": "subtitle", "time": 3235.27, "timestamp": "00:53:55", "text": "何？"}]
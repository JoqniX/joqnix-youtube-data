[{"type": "subtitle", "time": 11762.229, "timestamp": "03:16:02", "text": "。"}, {"type": "subtitle", "time": 11784.79, "timestamp": "03:16:24", "text": "ああ、兄弟"}, {"type": "subtitle", "time": 11792.71, "timestamp": "03:16:32", "text": "ああ、神様。"}, {"type": "subtitle", "time": 11794.95, "timestamp": "03:16:34", "text": "過去に生きている。"}, {"type": "subtitle", "time": 11797.67, "timestamp": "03:16:37", "text": "私たちは過去に生きている。"}, {"type": "subtitle", "time": 11801.11, "timestamp": "03:16:41", "text": "待って、どうやって座るの？月に座る"}, {"type": "subtitle", "time": 11804.309, "timestamp": "03:16:44", "text": "。私も座りたい。どこに行けばいいの"}, {"type": "subtitle", "time": 11811.03, "timestamp": "03:16:51", "text": "後で彼らにたどり着ける。でき"}, {"type": "subtitle", "time": 11812.87, "timestamp": "03:16:52", "text": "ない。"}, {"type": "subtitle", "time": 11815.59, "timestamp": "03:16:55", "text": "でも、どこに行けばいいの？ステージ完了。行きたいですか"}, {"type": "subtitle", "time": 11816.07, "timestamp": "03:16:56", "text": "？"}, {"type": "subtitle", "time": 11818.229, "timestamp": "03:16:58", "text": "今すぐ退出。"}]
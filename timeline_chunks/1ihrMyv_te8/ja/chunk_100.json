[{"type": "subtitle", "time": 6003.109, "timestamp": "01:40:03", "text": "待って、アダム・スペラーはハゲになったのか？いつ"}, {"type": "subtitle", "time": 6007.669, "timestamp": "01:40:07", "text": "ハゲになったのか？ え、何？"}, {"type": "subtitle", "time": 6023.35, "timestamp": "01:40:23", "text": "待って、彼はハゲた。髪がない。"}, {"type": "subtitle", "time": 6025.109, "timestamp": "01:40:25", "text": "何だって？"}, {"type": "subtitle", "time": 6034.95, "timestamp": "01:40:34", "text": "待って。気にしないで。"}, {"type": "subtitle", "time": 6036.709, "timestamp": "01:40:36", "text": "ハゲってどういうこと？"}, {"type": "subtitle", "time": 6040.31, "timestamp": "01:40:40", "text": "髪がなかったから、私のミス。この"}]
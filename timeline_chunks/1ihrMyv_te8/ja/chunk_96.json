[{"type": "subtitle", "time": 5798.47, "timestamp": "01:36:38", "text": "バカバカバカバカバカ。彼女はどうだ？"}, {"type": "subtitle", "time": 5802.07, "timestamp": "01:36:42", "text": "どうして彼女はハッキングしているんだ？"}, {"type": "subtitle", "time": 5805.83, "timestamp": "01:36:45", "text": "そこには何もない。"}, {"type": "subtitle", "time": 5817.669, "timestamp": "01:36:57", "text": "ええ、エド・ランナーズを見た後、私も"}, {"type": "subtitle", "time": 5819.59, "timestamp": "01:36:59", "text": "同意します。彼女は"}]
[{"type": "subtitle", "time": 10389.19, "timestamp": "02:53:09", "text": "トレードはええと、表示されています。ああ、わかりました。"}, {"type": "subtitle", "time": 10391.349, "timestamp": "02:53:11", "text": "このエナジードリンクを飲んでいて、"}, {"type": "subtitle", "time": 10393.83, "timestamp": "02:53:13", "text": "ガスを感じています。"}, {"type": "subtitle", "time": 10403.349, "timestamp": "02:53:23", "text": "ああ、あのジャンプ。オーケー、ルーシーは最高です。"}, {"type": "subtitle", "time": 10424.309, "timestamp": "02:53:44", "text": "え？"}, {"type": "subtitle", "time": 10427.67, "timestamp": "02:53:47", "text": "彼はどこにいるの？"}, {"type": "subtitle", "time": 10430.63, "timestamp": "02:53:50", "text": "ああ、詐欺師。どこ？"}, {"type": "subtitle", "time": 10437.83, "timestamp": "02:53:57", "text": "兄弟、彼は"}]
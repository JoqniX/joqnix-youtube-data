[{"type": "subtitle", "time": 13983.67, "timestamp": "03:53:03", "text": "男に。男に。男に。ああ、待って。"}, {"type": "subtitle", "time": 13988.07, "timestamp": "03:53:08", "text": "死ぬぞ。待って、待って、待って。"}, {"type": "subtitle", "time": 14001.51, "timestamp": "03:53:21", "text": "私は同情を失った。"}, {"type": "subtitle", "time": 14003.99, "timestamp": "03:53:23", "text": "おい、"}, {"type": "subtitle", "time": 14011.269, "timestamp": "03:53:31", "text": "。"}, {"type": "subtitle", "time": 14013.99, "timestamp": "03:53:33", "text": "え？んん"}, {"type": "subtitle", "time": 14022.309, "timestamp": "03:53:42", "text": "何？え"}, {"type": "subtitle", "time": 14028.79, "timestamp": "03:53:48", "text": "待って、私は"}]
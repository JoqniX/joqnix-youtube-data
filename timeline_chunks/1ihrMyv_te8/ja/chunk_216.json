[{"type": "subtitle", "time": 12967.67, "timestamp": "03:36:07", "text": "待って、"}, {"type": "subtitle", "time": 12972.07, "timestamp": "03:36:12", "text": "73回やった。まだ"}, {"type": "subtitle", "time": 12975.03, "timestamp": "03:36:15", "text": "ルーシーを手に入れていない。ちょっと待って。"}, {"type": "subtitle", "time": 12976.55, "timestamp": "03:36:16", "text": "意味がわからない。"}, {"type": "subtitle", "time": 12980.07, "timestamp": "03:36:20", "text": "ハードピティ、"}, {"type": "subtitle", "time": 12993.59, "timestamp": "03:36:33", "text": "どうやってラズベリーをあげればいいんだ？"}, {"type": "subtitle", "time": 13009.91, "timestamp": "03:36:49", "text": "必要なんだ。プリモジェムが必要なんだ。つまり、"}, {"type": "subtitle", "time": 13012.87, "timestamp": "03:36:52", "text": "アステライト。"}, {"type": "subtitle", "time": 13014.71, "timestamp": "03:36:54", "text": "えっと。あと"}, {"type": "subtitle", "time": 13016.469, "timestamp": "03:36:56", "text": "1回引ける。よし、あと"}, {"type": "subtitle", "time": 13018.229, "timestamp": "03:36:58", "text": "1回引ける。お願い。お願い。男に。"}]
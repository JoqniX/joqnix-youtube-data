[{"type": "subtitle", "time": 14651.189, "timestamp": "04:04:11", "text": "柔らかな流れをすべて見てください。 私は私です。私は"}, {"type": "subtitle", "time": 14655.83, "timestamp": "04:04:15", "text": "どれくらいの長さですか？"}, {"type": "subtitle", "time": 14657.67, "timestamp": "04:04:17", "text": "ああ、大変だ、10分も遅れている。 ああ"}, {"type": "subtitle", "time": 14659.189, "timestamp": "04:04:19", "text": "、じゃあね。 大丈夫です。"}, {"type": "subtitle", "time": 14661.59, "timestamp": "04:04:21", "text": "最後のシーンをしばらく続けて、それから"}, {"type": "subtitle", "time": 14674.63, "timestamp": "04:04:34", "text": "最後まで見て、聞いてくれてありがとう。"}, {"type": "subtitle", "time": 14678.07, "timestamp": "04:04:38", "text": "私のインターネット接続が非常に悪いことに気づいた。 それは良くない"}, {"type": "subtitle", "time": 14681.99, "timestamp": "04:04:41", "text": "。  Twitchなど、配信外でいくつかテストをしてみるつもりです"}, {"type": "subtitle", "time": 14687.99, "timestamp": "04:04:47", "text": "。 ええ、そうですね"}, {"type": "subtitle", "time": 14690.309, "timestamp": "04:04:50", "text": "。"}, {"type": "subtitle", "time": 14694.95, "timestamp": "04:04:54", "text": "えっと、この男はなぜ下品な"}, {"type": "subtitle", "time": 14698.55, "timestamp": "04:04:58", "text": "言葉を言っているのでしょうか？ 一体どういうことだ？"}]
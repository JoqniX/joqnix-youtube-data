[{"type": "subtitle", "time": 14701.11, "timestamp": "04:05:01", "text": "キックオン、そうだよね"}, {"type": "subtitle", "time": 14702.15, "timestamp": "04:05:02", "text": "？"}, {"type": "subtitle", "time": 14703.59, "timestamp": "04:05:03", "text": "うん。 うん。 うん。"}, {"type": "subtitle", "time": 14705.349, "timestamp": "04:05:05", "text": "荒らしアカウントにスパムを送る。"}, {"type": "subtitle", "time": 14707.83, "timestamp": "04:05:07", "text": "荒らしアカウント。"}, {"type": "subtitle", "time": 14711.91, "timestamp": "04:05:11", "text": "この男に何が問題なのか分からない。"}, {"type": "subtitle", "time": 14715.59, "timestamp": "04:05:15", "text": "彼は自分がそれをやるのに十分賢いと思っている"}, {"type": "subtitle", "time": 14724.63, "timestamp": "04:05:24", "text": "ああ、考えるまでもないね。"}, {"type": "subtitle", "time": 14727.59, "timestamp": "04:05:27", "text": "終身刑ではない。"}, {"type": "subtitle", "time": 14729.8, "timestamp": "04:05:29", "text": "ライフスタイルを手に入れよう。"}, {"type": "subtitle", "time": 14731.03, "timestamp": "04:05:31", "text": "[笑い]"}, {"type": "subtitle", "time": 14733.59, "timestamp": "04:05:33", "text": "人をからかうべきじゃないな。 そうそう。 そして、"}, {"type": "subtitle", "time": 14736.07, "timestamp": "04:05:36", "text": "コメントも。 ああ、神様。 うーん、それはまずいですね。"}, {"type": "subtitle", "time": 14745.51, "timestamp": "04:05:45", "text": "更新してください。   はい、どうぞ"}, {"type": "subtitle", "time": 14747.51, "timestamp": "04:05:47", "text": "。"}, {"type": "subtitle", "time": 14751.99, "timestamp": "04:05:51", "text": "ともかく、それはもう忘れてしまおう"}]
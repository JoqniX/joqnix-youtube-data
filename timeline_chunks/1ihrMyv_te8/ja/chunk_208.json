[{"type": "subtitle", "time": 12480.15, "timestamp": "03:28:00", "text": "。ああ、そう。クイックハックの場合は、"}, {"type": "subtitle", "time": 12484.389, "timestamp": "03:28:04", "text": "クリックして実行して、ただ手に入れるだけ。うん。"}, {"type": "subtitle", "time": 12487.75, "timestamp": "03:28:07", "text": "えっと、なんて言うんだっけ？終了。そうすれば、ただ"}, {"type": "subtitle", "time": 12491.99, "timestamp": "03:28:11", "text": "入るだけ。うん、速くなるよ。"}, {"type": "subtitle", "time": 12494.229, "timestamp": "03:28:14", "text": "ああ、"}, {"type": "subtitle", "time": 12496.229, "timestamp": "03:28:16", "text": "クイックヘッド"}, {"type": "subtitle", "time": 12500.229, "timestamp": "03:28:20", "text": "モードにしなくてもいいよ。ああ、"}, {"type": "subtitle", "time": 12513.349, "timestamp": "03:28:33", "text": "待って、すべての自動販売機ミッションが元に戻ってる。"}, {"type": "subtitle", "time": 12528.389, "timestamp": "03:28:48", "text": "できる最大量なの？"}]
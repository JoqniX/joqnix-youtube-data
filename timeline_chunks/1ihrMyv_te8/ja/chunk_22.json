[{"type": "subtitle", "time": 1320.71, "timestamp": "00:22:00", "text": "これって何だっけ？彼女の名前は何だっけ"}, {"type": "subtitle", "time": 1322.63, "timestamp": "00:22:02", "text": "？"}, {"type": "subtitle", "time": 1340.71, "timestamp": "00:22:20", "text": "あなたも、ジャンプして"}, {"type": "subtitle", "time": 1365.83, "timestamp": "00:22:45", "text": "。 本当に、ああ、なんてことだ。"}, {"type": "subtitle", "time": 1368.39, "timestamp": "00:22:48", "text": "銃が登場。"}, {"type": "subtitle", "time": 1371.19, "timestamp": "00:22:51", "text": "待てよ、この"}, {"type": "subtitle", "time": 1373.27, "timestamp": "00:22:53", "text": "ゲームには銃があったっけ？"}, {"type": "subtitle", "time": 1378.63, "timestamp": "00:22:58", "text": "我々は銃を持っているが、あれは持っていない。"}]
[{"type": "subtitle", "time": 361.749, "timestamp": "00:06:01", "text": "另外，我今天會多說幾句，因為"}, {"type": "subtitle", "time": 365.43, "timestamp": "00:06:05", "text": "室友沒空，所以我可以……呃，他"}, {"type": "subtitle", "time": 369.749, "timestamp": "00:06:09", "text": "出去了，所以我可以……呃，多說幾句。"}, {"type": "subtitle", "time": 374.309, "timestamp": "00:06:14", "text": "今天我們有一位嘉賓。  今天"}, {"type": "subtitle", "time": 377.189, "timestamp": "00:06:17", "text": "我們有一位嘉賓。我們有"}, {"type": "subtitle", "time": 378.95, "timestamp": "00:06:18", "text": "尤蘭，他今天會在這裡"}, {"type": "subtitle", "time": 381.99, "timestamp": "00:06:21", "text": "。"}, {"type": "subtitle", "time": 383.99, "timestamp": "00:06:23", "text": "你好。 [笑聲]"}]
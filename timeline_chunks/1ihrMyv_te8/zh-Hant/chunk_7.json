[{"type": "subtitle", "time": 453.83, "timestamp": "00:07:33", "text": "哦，我竟然忘了啟動遊戲。"}, {"type": "subtitle", "time": 458.15, "timestamp": "00:07:38", "text": "剛才到底發布了什麼玩意兒？"}, {"type": "subtitle", "time": 459.83, "timestamp": "00:07:39", "text": "至少你沒忘記安裝"}, {"type": "subtitle", "time": 461.029, "timestamp": "00:07:41", "text": "它。"}, {"type": "subtitle", "time": 462.15, "timestamp": "00:07:42", "text": "所以，所以，"}, {"type": "subtitle", "time": 465.909, "timestamp": "00:07:45", "text": "因為我已經看過了。"}, {"type": "subtitle", "time": 467.83, "timestamp": "00:07:47", "text": "好吧，算了。我不應該"}, {"type": "subtitle", "time": 469.63, "timestamp": "00:07:49", "text": "那樣咆哮。"}, {"type": "subtitle", "time": 470.469, "timestamp": "00:07:50", "text": "[笑聲]"}, {"type": "subtitle", "time": 472.55, "timestamp": "00:07:52", "text": "那裡。是的，我"}, {"type": "chat", "time": 475.407, "timestamp": "00:07:55", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/ibEsXBiXAsrBWCWbTkgZ0bJd9N5UtKdTJ0xuH90CmHq-Zp-Lnzzyh3Y-5uAHMTNH94HMGGOwgWY=s64-c-k-c0x00ffffff-no-rj", "message": "Hi Joq!"}, {"type": "subtitle", "time": 475.909, "timestamp": "00:07:55", "text": "記得有一次，我很久以前就忘了安裝"}]
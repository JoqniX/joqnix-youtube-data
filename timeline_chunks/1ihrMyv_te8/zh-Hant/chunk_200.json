[{"type": "subtitle", "time": 12000.79, "timestamp": "03:20:00", "text": "？"}, {"type": "subtitle", "time": 12004.71, "timestamp": "03:20:04", "text": "我覺得他們現在來得早。我們可以晚點再聯絡他們[音樂]。我聯絡不上。那我該去"}, {"type": "subtitle", "time": 12007.75, "timestamp": "03:20:07", "text": "哪裡呢？關卡完成。你想去嗎？現在退出。但我退出不了。我退出不了。什麼？不是"}]
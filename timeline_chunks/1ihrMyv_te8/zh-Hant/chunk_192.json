[{"type": "subtitle", "time": 11523.99, "timestamp": "03:12:03", "text": "哦，"}, {"type": "subtitle", "time": 11526.79, "timestamp": "03:12:06", "text": "等等。不，等等。我想他們是笨蛋"}, {"type": "subtitle", "time": 11541.429, "timestamp": "03:12:21", "text": "麗貝卡，不。麗貝卡，不"}, {"type": "subtitle", "time": 11543.59, "timestamp": "03:12:23", "text": "。"}, {"type": "subtitle", "time": 11545.83, "timestamp": "03:12:25", "text": "謝謝你提醒我九頭蛇的事。"}, {"type": "subtitle", "time": 11576.63, "timestamp": "03:12:56", "text": "（清喉嚨）不。不想出故障。我的天啊，他們坐在月球上。"}]
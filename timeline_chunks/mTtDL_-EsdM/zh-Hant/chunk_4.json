[{"type": "subtitle", "time": 240.63, "timestamp": "00:04:00", "text": "我同時要做的事情簡直多得"}, {"type": "subtitle", "time": 242.63, "timestamp": "00:04:02", "text": "不可思議。"}, {"type": "subtitle", "time": 245.27, "timestamp": "00:04:05", "text": "誰也攔不住我。"}, {"type": "subtitle", "time": 252.55, "timestamp": "00:04:12", "text": "現在我感覺自己好像做了很多事。問題是，當新的"}, {"type": "subtitle", "time": 254.869, "timestamp": "00:04:14", "text": "YouTuber 來看我的影片時，他們會"}, {"type": "subtitle", "time": 257.43, "timestamp": "00:04:17", "text": "想，哦，我也得做這個，我得建個"}, {"type": "subtitle", "time": 260.069, "timestamp": "00:04:20", "text": "網站什麼的。"}, {"type": "subtitle", "time": 261.67, "timestamp": "00:04:21", "text": "有人覺得我必須"}, {"type": "subtitle", "time": 264.55, "timestamp": "00:04:24", "text": "直播 12 小時才能完成首"}, {"type": "subtitle", "time": 267.189, "timestamp": "00:04:27", "text": "秀，因為他們看到了我的 YouTube 首秀"}, {"type": "subtitle", "time": 270.15, "timestamp": "00:04:30", "text": "直播。但我其實並沒有正式發布首秀，所以我的"}, {"type": "subtitle", "time": 272.469, "timestamp": "00:04:32", "text": "首秀直播可以被 YouTube 視為首秀"}, {"type": "subtitle", "time": 276.07, "timestamp": "00:04:36", "text": "直播。他們"}, {"type": "subtitle", "time": 281.03, "timestamp": "00:04:41", "text": "看了之後會說，哦，這太棒了！"}, {"type": "subtitle", "time": 284.15, "timestamp": "00:04:44", "text": "然後我就說，不，那隻是我在做我"}, {"type": "subtitle", "time": 287.59000000000003, "timestamp": "00:04:47", "text": "自己的事，別在意。"}, {"type": "subtitle", "time": 290.79, "timestamp": "00:04:50", "text": "說到誰真的做了"}, {"type": "subtitle", "time": 294.95, "timestamp": "00:04:54", "text": "超過 12 小時的首秀直播，"}, {"type": "subtitle", "time": 297.35, "timestamp": "00:04:57", "text": "是 Nisanji 的 Kay，我記得他好像做了"}]
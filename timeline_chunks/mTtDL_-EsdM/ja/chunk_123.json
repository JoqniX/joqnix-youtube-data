[{"type": "subtitle", "time": 7384.79, "timestamp": "02:03:04", "text": "満月、半月、三日月など、月の面に応じて、"}, {"type": "subtitle", "time": 7392.87, "timestamp": "02:03:12", "text": "ヘッダー画像のような特定の壁紙や、UI の変更などを設定できると思います。これは、月の変化に応じて思いついたランダムなアイデアです。"}, {"type": "subtitle", "time": 7407.589, "timestamp": "02:03:27", "text": "インドなどで月の面が変わるかもしれませんが、月の"}, {"type": "subtitle", "time": 7411.109, "timestamp": "02:03:31", "text": "変化は世界中で起こりますよね。ああ、そうですか。"}, {"type": "subtitle", "time": 7416.87, "timestamp": "02:03:36", "text": "待ってください、そうですか。"}, {"type": "subtitle", "time": 7418.95, "timestamp": "02:03:38", "text": "誰もが同じ時間に同じ月の面を見ると思います。ですから、そのようにします"}, {"type": "subtitle", "time": 7429.27, "timestamp": "02:03:49", "text": "。"}, {"type": "subtitle", "time": 7432.55, "timestamp": "02:03:52", "text": "そうですね、ゆっくりと、ゆっくりと"}, {"type": "chat", "time": 7435.864, "timestamp": "02:03:55", "author": "@everestfujich", "avatar": "https://yt4.ggpht.com/cGf4x80kyXWdAQCEpiCAT1VX7LnsLDD0GjZXaK-xsp1-Ky9Av7IrQcFxwWsVy873fVtPRn54UQ=s64-c-k-c0x00ffffff-no-rj", "message": "I see the lunar cycle"}]
[{"type": "subtitle", "time": 5040.79, "timestamp": "01:24:00", "text": "そして、自分の仕事をきちんとこなしている。"}, {"type": "subtitle", "time": 5043.669, "timestamp": "01:24:03", "text": "つまり、朝で、霞がかかっているとか、何であれ、そういう時なんです"}, {"type": "subtitle", "time": 5046.87, "timestamp": "01:24:06", "text": "。"}, {"type": "subtitle", "time": 5049.51, "timestamp": "01:24:09", "text": "えっと、あの看板みたいなのを手に入れなきゃいけないんだよね"}, {"type": "subtitle", "time": 5054.87, "timestamp": "01:24:14", "text": "？ ああ、大変だ。 アイコンのことですよね？"}, {"type": "subtitle", "time": 5056.47, "timestamp": "01:24:16", "text": "えっと、ちょっと"}, {"type": "subtitle", "time": 5075.43, "timestamp": "01:24:35", "text": "彼らは独自のカスタム温度"}, {"type": "subtitle", "time": 5077.189, "timestamp": "01:24:37", "text": "アイコンを持っているんだよ、"}, {"type": "subtitle", "time": 5079.99, "timestamp": "01:24:39", "text": "兄弟。"}, {"type": "subtitle", "time": 5096.07, "timestamp": "01:24:56", "text": "ああ、まあ。"}, {"type": "subtitle", "time": 5099.03, "timestamp": "01:24:59", "text": "だから、もや、"}]
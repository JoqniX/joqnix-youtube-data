[{"type": "subtitle", "time": 727.19, "timestamp": "00:12:07", "text": "ええ、私は"}, {"type": "subtitle", "time": 747.19, "timestamp": "00:12:27", "text": "あなたが使っているもの（音楽）をやっています。 わかった。 では、まずこれを"}, {"type": "subtitle", "time": 749.269, "timestamp": "00:12:29", "text": "修理してから、これをやります"}, {"type": "subtitle", "time": 751.269, "timestamp": "00:12:31", "text": "。 わかった。   つまり、ある"}, {"type": "subtitle", "time": 756.069, "timestamp": "00:12:36", "text": "意味では、私たちはもう終わったようなものです"}, {"type": "subtitle", "time": 759.99, "timestamp": "00:12:39", "text": "。 待って、ソーシャルメディアで私たちは"}, {"type": "subtitle", "time": 763.509, "timestamp": "00:12:43", "text": "今これをやった。 私たちがこれをやったのは、まあ"}, {"type": "subtitle", "time": 766.949, "timestamp": "00:12:46", "text": "いいことだ。 えっと、"}, {"type": "subtitle", "time": 769.43, "timestamp": "00:12:49", "text": "いい感じだし、何も問題ないよ。 えっと、それはえっと、"}, {"type": "subtitle", "time": 776.629, "timestamp": "00:12:56", "text": "待ってください。 そうあるべきじゃないの？"}, {"type": "subtitle", "time": 778.15, "timestamp": "00:12:58", "text": "うん。 うん。 うん。 探していたのは"}, {"type": "subtitle", "time": 779.71, "timestamp": "00:12:59", "text": "それです。 わかった。"}]
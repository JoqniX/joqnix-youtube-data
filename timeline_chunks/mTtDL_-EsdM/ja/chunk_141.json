[{"type": "subtitle", "time": 8462.15, "timestamp": "02:21:02", "text": "星の素材だけですよね？"}, {"type": "subtitle", "time": 8471.59, "timestamp": "02:21:11", "text": "M、あの"}, {"type": "subtitle", "time": 8474.07, "timestamp": "02:21:14", "text": "動くものが"}, {"type": "subtitle", "time": 8483.59, "timestamp": "02:21:23", "text": "それは良い。 背景として良さそうですね"}, {"type": "subtitle", "time": 8492.07, "timestamp": "02:21:32", "text": "かなり落ち込んだ。"}, {"type": "subtitle", "time": 8495.11, "timestamp": "02:21:35", "text": "その効果。 ああ、あの効果ね。 私は"}, {"type": "subtitle", "time": 8497.75, "timestamp": "02:21:37", "text": "そのエフェクトのやり方を学ぶ必要がある。"}, {"type": "subtitle", "time": 8502.15, "timestamp": "02:21:42", "text": "それは規模縮小のことですよね？"}, {"type": "subtitle", "time": 8505.27, "timestamp": "02:21:45", "text": "それは規模縮小効果だと思います。"}, {"type": "subtitle", "time": 8509.11, "timestamp": "02:21:49", "text": "星が入るぞ。ああ、規模を縮小する。"}, {"type": "subtitle", "time": 8513.91, "timestamp": "02:21:53", "text": "これは本当に素晴らしいことだと思います。 私はその方法を学びたい"}, {"type": "subtitle", "time": 8515.91, "timestamp": "02:21:55", "text": "。"}, {"type": "subtitle", "time": 8518.63, "timestamp": "02:21:58", "text": "粒子が下方へ移動していくアニメーション"}]
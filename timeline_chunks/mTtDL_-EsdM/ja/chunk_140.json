[{"type": "subtitle", "time": 8401.19, "timestamp": "02:20:01", "text": "月の顔が欲しいので、夜の天気についてできます"}, {"type": "subtitle", "time": 8404.95, "timestamp": "02:20:04", "text": "。 月の顔、ですよね？"}, {"type": "subtitle", "time": 8413.19, "timestamp": "02:20:13", "text": "月の顔のモチーフを際立たせるものをどれにするか決めなければならない。"}, {"type": "subtitle", "time": 8417.349, "timestamp": "02:20:17", "text": "もしそれについて話すとしたら、私は"}, {"type": "subtitle", "time": 8421.83, "timestamp": "02:20:21", "text": "Soさんのウェブサイトからインスピレーションを受けたと言えるでしょう。"}, {"type": "subtitle", "time": 8425.59, "timestamp": "02:20:25", "text": "これって、小さな動く円みたいなやつだよ"}, {"type": "subtitle", "time": 8429.83, "timestamp": "02:20:29", "text": "ね？ それで、もしかしたら"}, {"type": "subtitle", "time": 8438.389, "timestamp": "02:20:38", "text": "デザインがこんなに良いのはなぜだろうと考えました。 あの、"}, {"type": "subtitle", "time": 8440.95, "timestamp": "02:20:40", "text": "自分でもらってもいいですか？ わからない。 なぜ"}, {"type": "subtitle", "time": 8446.55, "timestamp": "02:20:46", "text": "この星のデザインはこんなに素晴らしいのでしょうか？"}, {"type": "subtitle", "time": 8456.63, "timestamp": "02:20:56", "text": "私は宇宙を"}, {"type": "subtitle", "time": 8459.11, "timestamp": "02:20:59", "text": "テーマにしたようなものなので、それはもう自殺行為です。 私が使えるのは"}]
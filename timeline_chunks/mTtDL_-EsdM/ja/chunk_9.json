[{"type": "subtitle", "time": 553.829, "timestamp": "00:09:13", "text": "ああ、なんてこと、私は自分の彼氏に対してひどい態度をとっているわ。"}, {"type": "subtitle", "time": 556.15, "timestamp": "00:09:16", "text": "彼らはあなたにJPサービスを利用してほしいと思っています。"}, {"type": "subtitle", "time": 558.23, "timestamp": "00:09:18", "text": "今はもっと安い。 日本円"}, {"type": "subtitle", "time": 560.31, "timestamp": "00:09:20", "text": "。 円換算で言えば、今は安い。"}, {"type": "subtitle", "time": 563.829, "timestamp": "00:09:23", "text": "ドルは高すぎる。"}, {"type": "subtitle", "time": 569.75, "timestamp": "00:09:29", "text": "、メアリー・ウェザーのツイートは本当に"}, {"type": "subtitle", "time": 575.99, "timestamp": "00:09:35", "text": "そこにいればいいんです。そして、自分が"}, {"type": "subtitle", "time": 577.99, "timestamp": "00:09:37", "text": "作ったものが好きなら、どんなにニッチなものでも、"}, {"type": "subtitle", "time": 580.63, "timestamp": "00:09:40", "text": "それを気に入ってくれる人は必ずいます。"}, {"type": "subtitle", "time": 583.75, "timestamp": "00:09:43", "text": "でも、もしあなたが"}, {"type": "subtitle", "time": 599.56, "timestamp": "00:09:59", "text": "すべての夜を生き延びて。"}]
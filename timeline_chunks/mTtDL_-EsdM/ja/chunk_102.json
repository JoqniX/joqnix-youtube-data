[{"type": "subtitle", "time": 6126.79, "timestamp": "01:42:06", "text": "私のものにはね。 私はこれではなく、これを作りました。 ああ、"}, {"type": "subtitle", "time": 6130.07, "timestamp": "01:42:10", "text": "そうそう、コラボレーション用のデータベースを作ったんだ。"}, {"type": "subtitle", "time": 6132.709, "timestamp": "01:42:12", "text": "あなたの名前「Fujist」で検索すると、"}, {"type": "subtitle", "time": 6136.39, "timestamp": "01:42:16", "text": "あなたのリンクが表示されます。 つまり、"}, {"type": "subtitle", "time": 6139.43, "timestamp": "01:42:19", "text": "コラボに遅れそうな時とかに、"}, {"type": "subtitle", "time": 6140.87, "timestamp": "01:42:20", "text": "YouTubeの"}, {"type": "subtitle", "time": 6143.109, "timestamp": "01:42:23", "text": "説明欄をすぐにここに書き込めるってことですよね？ もしくは、TwitchやYouTubeの"}, {"type": "subtitle", "time": 6145.51, "timestamp": "01:42:25", "text": "チャットでリンクを貼るのもいいんじゃない？"}, {"type": "chat", "time": 6150.981, "timestamp": "01:42:30", "author": "@everestfujich", "avatar": "https://yt4.ggpht.com/cGf4x80kyXWdAQCEpiCAT1VX7LnsLDD0GjZXaK-xsp1-Ky9Av7IrQcFxwWsVy873fVtPRn54UQ=s64-c-k-c0x00ffffff-no-rj", "message": "WAAAAA .... IM SCARED"}, {"type": "subtitle", "time": 6154.55, "timestamp": "01:42:34", "text": "私は皆のためにやったんです。 私は協力しました。"}, {"type": "subtitle", "time": 6157.75, "timestamp": "01:42:37", "text": "Notionでホストしています。"}, {"type": "subtitle", "time": 6159.59, "timestamp": "01:42:39", "text": "えっと、"}, {"type": "subtitle", "time": 6163.669, "timestamp": "01:42:43", "text": "Notionでホストしました。 だから、もし"}, {"type": "subtitle", "time": 6166.39, "timestamp": "01:42:46", "text": "本当にすぐに必要なら、今すごく痛いんです。"}, {"type": "subtitle", "time": 6168.629, "timestamp": "01:42:48", "text": "彼らのYouTubeチャンネルに行って、"}, {"type": "subtitle", "time": 6171.51, "timestamp": "01:42:51", "text": "リンクをすべて確認して、"}, {"type": "subtitle", "time": 6173.83, "timestamp": "01:42:53", "text": "リンクを入手する必要があります。 一つずつコピーしてください。 時間の"}, {"type": "subtitle", "time": 6177.91, "timestamp": "01:42:57", "text": "無駄が多すぎる。 えっと、こうすることで、全員"}]
[{"type": "subtitle", "time": 13148.55, "timestamp": "03:39:08", "text": "アップデートです。 ブラウザの時間を使用して毎秒更新します"}, {"type": "subtitle", "time": 13151.429, "timestamp": "03:39:11", "text": "。 この装置から天気情報を取得します"}, {"type": "subtitle", "time": 13154.95, "timestamp": "03:39:14", "text": "。 月は、移動フェイス値プレースホルダーライブカレントから1つを選択し、"}, {"type": "subtitle", "time": 13166.389, "timestamp": "03:39:26", "text": "夜に太陽情報とスタイルの遷移を追加します。"}, {"type": "subtitle", "time": 13170.71, "timestamp": "03:39:30", "text": "ええ、太陽"}, {"type": "subtitle", "time": 13193.91, "timestamp": "03:39:53", "text": "日の出のイベントを何かに活用できるかもしれないね"}]
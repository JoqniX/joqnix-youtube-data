[{"type": "subtitle", "time": 16390.709, "timestamp": "04:33:10", "text": "あのね？ 夕食を食べに行って、"}, {"type": "subtitle", "time": 16394.47, "timestamp": "04:33:14", "text": "昼食も全部済ませるよ。"}, {"type": "subtitle", "time": 16397.349, "timestamp": "04:33:17", "text": "ここで一旦終わりにするか、"}, {"type": "subtitle", "time": 16413.51, "timestamp": "04:33:33", "text": "何か食べて寝ます。"}, {"type": "subtitle", "time": 16422.949, "timestamp": "04:33:42", "text": "ええ、そうですね。 というわけで、とりあえず今は"}]
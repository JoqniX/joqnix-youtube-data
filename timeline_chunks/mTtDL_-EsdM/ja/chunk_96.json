[{"type": "subtitle", "time": 5760.47, "timestamp": "01:36:00", "text": "メンバーの1人、青い髪の人が、"}, {"type": "subtitle", "time": 5765.51, "timestamp": "01:36:05", "text": "EXHOLメンバーのクロエです。 そう、つまり、"}, {"type": "chat", "time": 5768.755, "timestamp": "01:36:08", "author": "@everestfujich", "avatar": "https://yt4.ggpht.com/cGf4x80kyXWdAQCEpiCAT1VX7LnsLDD0GjZXaK-xsp1-Ky9Av7IrQcFxwWsVy873fVtPRn54UQ=s64-c-k-c0x00ffffff-no-rj", "message": "oo so pretty!"}, {"type": "subtitle", "time": 5771.669, "timestamp": "01:36:11", "text": "天気とか宇宙とか、そういうテーマなんだよね"}, {"type": "subtitle", "time": 5774.229, "timestamp": "01:36:14", "text": "。 彼らのウェブサイトは"}, {"type": "subtitle", "time": 5777.83, "timestamp": "01:36:17", "text": "すごくクールだ。 つまり、"}, {"type": "subtitle", "time": 5780.229, "timestamp": "01:36:20", "text": "渋谷の天気に基づいて、"}, {"type": "subtitle", "time": 5783.91, "timestamp": "01:36:23", "text": "現在の渋谷の天気は12時で、ウェブ"}, {"type": "chat", "time": 5784.783, "timestamp": "01:36:24", "author": "@everestfujich", "avatar": "https://yt4.ggpht.com/cGf4x80kyXWdAQCEpiCAT1VX7LnsLDD0GjZXaK-xsp1-Ky9Av7IrQcFxwWsVy873fVtPRn54UQ=s64-c-k-c0x00ffffff-no-rj", "message": "also joq no dox!"}, {"type": "subtitle", "time": 5787.189, "timestamp": "01:36:27", "text": "サイト全体が動的に更新されます。"}, {"type": "subtitle", "time": 5789.43, "timestamp": "01:36:29", "text": "今はあちらの方で雨が降っているみたいだ"}, {"type": "subtitle", "time": 5792.87, "timestamp": "01:36:32", "text": "。 雨が降ったんですね。   ああ、すみません"}, {"type": "subtitle", "time": 5796.709, "timestamp": "01:36:36", "text": "。 えっと、それから雨とか"}, {"type": "subtitle", "time": 5799.11, "timestamp": "01:36:39", "text": "朝とか、ですよね？ だから、それは"}, {"type": "subtitle", "time": 5802.149, "timestamp": "01:36:42", "text": "彼らのミュージックビデオに基づいていると思う。 でも、そうだね、"}, {"type": "subtitle", "time": 5804.47, "timestamp": "01:36:44", "text": "夜だったら、だよね？ もし"}, {"type": "chat", "time": 5808.327, "timestamp": "01:36:48", "author": "@everestfujich", "avatar": "https://yt4.ggpht.com/cGf4x80kyXWdAQCEpiCAT1VX7LnsLDD0GjZXaK-xsp1-Ky9Av7IrQ
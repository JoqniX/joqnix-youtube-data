[{"type": "subtitle", "time": 307.029, "timestamp": "00:05:07", "text": "、"}, {"type": "subtitle", "time": 325.45, "timestamp": "00:05:25", "text": "そして配信タイトルをそこに入れた。"}, {"type": "subtitle", "time": 339.35, "timestamp": "00:05:39", "text": "10時までに終わらせなければならないことがたくさんあります。"}, {"type": "subtitle", "time": 343.35, "timestamp": "00:05:43", "text": "午前10時になったら寝て、"}, {"type": "subtitle", "time": 346.55, "timestamp": "00:05:46", "text": "夜中に起きるんだ。"}, {"type": "subtitle", "time": 348.87, "timestamp": "00:05:48", "text": "それが私のやるべきことです。 何があっても"}, {"type": "subtitle", "time": 352.31, "timestamp": "00:05:52", "text": "、ダイナミックな、あの"}, {"type": "subtitle", "time": 355.27, "timestamp": "00:05:55", "text": "ことをやり遂げるよ、そうだろ？ うん。 それでは、実際にその点に"}, {"type": "subtitle", "time": 357.909, "timestamp": "00:05:57", "text": "焦点を当てましょう。 凝縮とかは"}, {"type": "subtitle", "time": 359.909, "timestamp": "00:05:59", "text": "後でやるけど、今は"}]
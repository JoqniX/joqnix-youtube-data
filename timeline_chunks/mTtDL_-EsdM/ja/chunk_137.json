[{"type": "subtitle", "time": 8220.87, "timestamp": "02:17:00", "text": "。"}, {"type": "subtitle", "time": 8222.95, "timestamp": "02:17:02", "text": "少なくとも"}, {"type": "subtitle", "time": 8226.629, "timestamp": "02:17:06", "text": "あの息子からボングをもらえるかもしれないので、歌い始めなければならない。"}, {"type": "subtitle", "time": 8228.79, "timestamp": "02:17:08", "text": "彼女は私と一緒にカバー曲を作ってほしいと言っています"}, {"type": "subtitle", "time": 8230.549, "timestamp": "02:17:10", "text": "。"}, {"type": "subtitle", "time": 8233.27, "timestamp": "02:17:13", "text": "彼女だけでなく、ズキも私に"}, {"type": "subtitle", "time": 8238.23, "timestamp": "02:17:18", "text": "カバー曲を作ってほしいと思っている。 アルスもそうだ。 なあ、俺は"}]
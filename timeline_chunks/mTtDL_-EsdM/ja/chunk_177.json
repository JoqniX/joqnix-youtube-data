[{"type": "subtitle", "time": 10628.87, "timestamp": "02:57:08", "text": "ボックス URL には"}, {"type": "subtitle", "time": 10632.55, "timestamp": "02:57:12", "text": "一致文字列アイコンが必要です。マップ一致"}, {"type": "subtitle", "time": 10634.469, "timestamp": "02:57:14", "text": "のみが必要で、特定の都市の損失が大きいため、レート制限が遅くなります"}, {"type": "subtitle", "time": 10641.03, "timestamp": "02:57:21", "text": "。 失敗することもあるだろう。"}, {"type": "subtitle", "time": 10643.429, "timestamp": "02:57:23", "text": "シンプルな JSON を永久に無料で高速な深度時間で書きたいなら、クイック"}, {"type": "subtitle", "time": 10649.83, "timestamp": "02:57:29", "text": "OK"}, {"type": "subtitle", "time": 10652.87, "timestamp": "02:57:32", "text": "シンボルレート制限を書いても構いません。スケールアップするには、"}, {"type": "subtitle", "time": 10654.63, "timestamp": "02:57:34", "text": "プロフェッショナルな助成金が必要かどうか、"}, {"type": "subtitle", "time": 10669.429, "timestamp": "02:57:49", "text": "無料トライアル、リアルな月の顔 JSON"}, {"type": "subtitle", "time": 10672.23, "timestamp": "02:57:52", "text": "条件が必要です。次の"}, {"type": "subtitle", "time": 10675.59, "timestamp": "02:57:55", "text": "ドキュメント、次の"}, {"type": "subtitle", "time": 10679.91, "timestamp": "02:57:59", "text": "クイック タイプと CSS マッピング、"}]
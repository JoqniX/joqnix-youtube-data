[{"type": "subtitle", "time": 8220.87, "timestamp": "02:17:00", "text": "声乐。 我得开始唱歌，"}, {"type": "subtitle", "time": 8222.95, "timestamp": "02:17:02", "text": "至少有机会的话，"}, {"type": "subtitle", "time": 8226.629, "timestamp": "02:17:06", "text": "我还得从我儿子那里拿到一个水烟筒。"}, {"type": "subtitle", "time": 8228.79, "timestamp": "02:17:08", "text": "她想让我和她一起翻唱一首歌"}, {"type": "subtitle", "time": 8230.549, "timestamp": "02:17:10", "text": "。"}, {"type": "subtitle", "time": 8233.27, "timestamp": "02:17:13", "text": "不仅是她，Zuki 也想让我翻唱一"}, {"type": "subtitle", "time": 8238.23, "timestamp": "02:17:18", "text": "首歌。 阿鲁苏也是。 兄弟，"}]
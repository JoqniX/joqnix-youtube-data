[{"type": "subtitle", "time": 240.63, "timestamp": "00:04:00", "text": "我同时要做的事情简直多得"}, {"type": "subtitle", "time": 242.63, "timestamp": "00:04:02", "text": "不可思议。"}, {"type": "subtitle", "time": 245.27, "timestamp": "00:04:05", "text": "谁也拦不住我。"}, {"type": "subtitle", "time": 252.55, "timestamp": "00:04:12", "text": "现在我感觉自己好像做了很多事。问题是，当新的"}, {"type": "subtitle", "time": 254.869, "timestamp": "00:04:14", "text": "YouTuber 来看我的视频时，他们会"}, {"type": "subtitle", "time": 257.43, "timestamp": "00:04:17", "text": "想，哦，我也得做这个，我得建"}, {"type": "subtitle", "time": 260.069, "timestamp": "00:04:20", "text": "个网站什么的。"}, {"type": "subtitle", "time": 261.67, "timestamp": "00:04:21", "text": "有人觉得我必须"}, {"type": "subtitle", "time": 264.55, "timestamp": "00:04:24", "text": "直播 12 个小时才能完成首"}, {"type": "subtitle", "time": 267.189, "timestamp": "00:04:27", "text": "秀，因为他们看到了我的 YouTube 首秀"}, {"type": "subtitle", "time": 270.15, "timestamp": "00:04:30", "text": "直播。但我其实并没有正式发布首秀，所以我的"}, {"type": "subtitle", "time": 272.469, "timestamp": "00:04:32", "text": "首秀直播可以被 YouTube 视为首秀"}, {"type": "subtitle", "time": 276.07, "timestamp": "00:04:36", "text": "直播。他们"}, {"type": "subtitle", "time": 281.03, "timestamp": "00:04:41", "text": "看了之后会说，哦，这太棒了！"}, {"type": "subtitle", "time": 284.15, "timestamp": "00:04:44", "text": "然后我就说，不，那只是我在做"}, {"type": "subtitle", "time": 287.59000000000003, "timestamp": "00:04:47", "text": "我自己的事，别在意。"}, {"type": "subtitle", "time": 290.79, "timestamp": "00:04:50", "text": "说到谁真的做了超过"}, {"type": "subtitle", "time": 294.95, "timestamp": "00:04:54", "text": "12 个小时的首秀直播，"}, {"type": "subtitle", "time": 297.35, "timestamp": "00:04:57", "text": "是 Nisanji 的 Kay，我记得他好像做了"}]
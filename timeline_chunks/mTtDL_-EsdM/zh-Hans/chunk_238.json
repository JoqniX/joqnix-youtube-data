[{"type": "subtitle", "time": 14280.87, "timestamp": "03:58:00", "text": "你知道，之后我在想，为什么"}, {"type": "subtitle", "time": 14283.75, "timestamp": "03:58:03", "text": "不加入一些占星术之类的东西，比如星座之类的"}, {"type": "subtitle", "time": 14290.55, "timestamp": "03:58:10", "text": "我的天哪，幸好有人阻止了我，"}, {"type": "subtitle", "time": 14294.63, "timestamp": "03:58:14", "text": "不然事情就更复杂了。"}]
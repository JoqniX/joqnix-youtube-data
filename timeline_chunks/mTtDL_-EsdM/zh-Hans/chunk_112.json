[{"type": "subtitle", "time": 6721.189, "timestamp": "01:52:01", "text": "一个月或十个月里做了什么等等。我会持续"}, {"type": "subtitle", "time": 6723.109, "timestamp": "01:52:03", "text": "一年。 所以，我必须确保"}, {"type": "subtitle", "time": 6726.95, "timestamp": "01:52:06", "text": "一切都准备就绪。"}, {"type": "subtitle", "time": 6731.109, "timestamp": "01:52:11", "text": "但我希望我能完成这个网站。"}, {"type": "subtitle", "time": 6734.95, "timestamp": "01:52:14", "text": "我完全不知道自己想要什么。"}, {"type": "subtitle", "time": 6737.189, "timestamp": "01:52:17", "text": "问题是我不能委托别人"}, {"type": "subtitle", "time": 6740.629, "timestamp": "01:52:20", "text": "做网站，因为我可能已经"}, {"type": "subtitle", "time": 6743.51, "timestamp": "01:52:23", "text": "有了一个自己喜欢的版本。如果我和别人一起修改了一些内容，"}, {"type": "subtitle", "time": 6746.629, "timestamp": "01:52:26", "text": "第二天或者"}, {"type": "subtitle", "time": 6749.99, "timestamp": "01:52:29", "text": "深夜，我可能会看到一些东西，受到"}, {"type": "subtitle", "time": 6752.95, "timestamp": "01:52:32", "text": "启发，产生一些随机的想法，然后我"}, {"type": "subtitle", "time": 6755.589, "timestamp": "01:52:35", "text": "就想，哦，我想要这个，想要那个，然后"}, {"type": "subtitle", "time": 6757.669, "timestamp": "01:52:37", "text": "价格就会上涨，然后我又会想，哦，"}, {"type": "subtitle", "time": 6760.31, "timestamp": "01:52:40", "text": "我想要这个，让它变得更"}, {"type": "subtitle", "time": 6761.83, "timestamp": "01:52:41", "text": "复杂"}, {"type": "subtitle", "time": 6765.03, "timestamp": "01:52:45", "text": "等等，然后价格又会上涨，在某种程度上，这样就"}, {"type": "subtitle", "time": 6767.75, "timestamp": "01:52:47", "text": "太贵了。 所以我就想，"}]
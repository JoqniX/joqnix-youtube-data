[{"type": "subtitle", "time": 10331.19, "timestamp": "02:52:11", "text": "感觉像是描述。 中雨，"}, {"type": "subtitle", "time": 10339.19, "timestamp": "02:52:19", "text": "风，雨，雪，"}, {"type": "subtitle", "time": 10341.59, "timestamp": "02:52:21", "text": "底部。"}, {"type": "subtitle", "time": 10352.55, "timestamp": "02:52:32", "text": "呃，"}, {"type": "subtitle", "time": 10356.95, "timestamp": "02:52:36", "text": "雷暴，雪，雾，阵雨，雨，"}, {"type": "subtitle", "time": 10359.11, "timestamp": "02:52:39", "text": "碎云，"}, {"type": "subtitle", "time": 10361.91, "timestamp": "02:52:41", "text": "零星云，几朵云，晴空，雷声，暴风雨，毛毛雨，"}, {"type": "subtitle", "time": 10368.389, "timestamp": "02:52:48", "text": "雨，呃"}, {"type": "subtitle", "time": 10372.07, "timestamp": "02:52:52", "text": "，雪，大气，大气，"}]
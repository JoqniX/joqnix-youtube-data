[{"type": "subtitle", "time": 12481.349, "timestamp": "03:28:01", "text": "做完的时候就睡着。 我先去吃饭，一会儿就回来"}, {"type": "subtitle", "time": 12484.71, "timestamp": "03:28:04", "text": "。 我想"}, {"type": "subtitle", "time": 12489.19, "timestamp": "03:28:09", "text": "如果我去吃饭休息的话，我会把"}, {"type": "subtitle", "time": 12491.91, "timestamp": "03:28:11", "text": "YouTube 直播关掉，"}, {"type": "subtitle", "time": 12494.469, "timestamp": "03:28:14", "text": "就像把它放到发布状态然后离开一样，"}, {"type": "subtitle", "time": 12497.03, "timestamp": "03:28:17", "text": "因为我说过我不会把"}, {"type": "subtitle", "time": 12499.99, "timestamp": "03:28:19", "text": "YouTube 上的内容公开。"}, {"type": "subtitle", "time": 12503.429, "timestamp": "03:28:23", "text": "很抱歉一直没能解决这个问题。"}]
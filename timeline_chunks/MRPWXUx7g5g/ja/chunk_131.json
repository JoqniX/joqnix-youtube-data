[{"type": "subtitle", "time": 7869.83, "timestamp": "02:11:09", "text": "場所だけど、そう、私は自分が好きになれるとは知らなかった"}, {"type": "subtitle", "time": 7872.39, "timestamp": "02:11:12", "text": "文字通り私の声で"}, {"type": "subtitle", "time": 7876.79, "timestamp": "02:11:16", "text": "私のものや物、それから私は"}, {"type": "subtitle", "time": 7880.31, "timestamp": "02:11:20", "text": "ストリームは私が始めたときではなく、"}, {"type": "subtitle", "time": 7884.03, "timestamp": "02:11:24", "text": "時間は、私はそうしないので、私は"}]
[{"type": "subtitle", "time": 19141.15, "timestamp": "05:19:01", "text": "あなたは無視した、待って、何をしたの？"}, {"type": "subtitle", "time": 19145.39, "timestamp": "05:19:05", "text": "ところで、ジョー、こんにちはって言ったよね"}, {"type": "subtitle", "time": 19148.47, "timestamp": "05:19:08", "text": "ええ、こんにちは、それはつまり、それは"}, {"type": "subtitle", "time": 19155.47, "timestamp": "05:19:15", "text": "つまり、あなたは見ていて、そして、そして、"}, {"type": "subtitle", "time": 19158.548, "timestamp": "05:19:18", "text": "そして、そして、あなたは挨拶するのを忘れていました"}, {"type": "subtitle", "time": 19161.75, "timestamp": "05:19:21", "text": "だからあなたは言った"}, {"type": "subtitle", "time": 19172.708, "timestamp": "05:19:32", "text": "ちょっと待って、メッセージ届きましたか？"}, {"type": "subtitle", "time": 19175.868, "timestamp": "05:19:35", "text": "YouTubeによってブロックされました。またYouTubeは"}, {"type": "subtitle", "time": 19179.51, "timestamp": "05:19:39", "text": "私にはそれをコントロールする力がない"}, {"type": "subtitle", "time": 19181.19, "timestamp": "05:19:41", "text": "ああ、そうだったんですね"}, {"type": "subtitle", "time": 19183.19, "timestamp": "05:19:43", "text": "メッセージ待機中"}, {"type": "subtitle", "time": 19186.43, "timestamp": "05:19:46", "text": "確かにそれはひどい言い方だ"}, {"type": "subtitle", "time": 19194.03, "timestamp": "05:19:54", "text": "えっと、YouTube"}, {"type": "subtitle", "time": 19198.43, "timestamp": "05:19:58", "text": "YouTube は、あなたのメッセージを自動的に修正しました。"}]
[{"type": "subtitle", "time": 18540.03, "timestamp": "05:09:00", "text": "まあ、落ち着いて、やっとありがとう"}, {"type": "subtitle", "time": 18543.548, "timestamp": "05:09:03", "text": "次にどこに行きたいですか？"}, {"type": "subtitle", "time": 18545.75, "timestamp": "05:09:05", "text": "見たいもの"}, {"type": "subtitle", "time": 18549.47, "timestamp": "05:09:09", "text": "レオ、いくつか推薦状があります"}, {"type": "subtitle", "time": 18552.51, "timestamp": "05:09:12", "text": "そして、それは私が海から取ったものだったのか？"}, {"type": "subtitle", "time": 18558.708, "timestamp": "05:09:18", "text": "完了しました。最後の一つは"}, {"type": "subtitle", "time": 18565.43, "timestamp": "05:09:25", "text": "そうだと信じているもの、私はそれを"}, {"type": "subtitle", "time": 18568.11, "timestamp": "05:09:28", "text": "そこで私はそれを手に入れました、はい、そこから手に入れました"}, {"type": "subtitle", "time": 18579.548, "timestamp": "05:09:39", "text": "D は Dio さえも、どうすればいいですか"}, {"type": "subtitle", "time": 18584.39, "timestamp": "05:09:44", "text": "イベントをアンロックしていないとき B"}, {"type": "subtitle", "time": 18593.628, "timestamp": "05:09:53", "text": "チャムがそれを受け取る"}, {"type": "subtitle", "time": 18596.47, "timestamp": "05:09:56", "text": "簡単にダメージは悪いです"}]
[{"type": "subtitle", "time": 11700.63, "timestamp": "03:15:00", "text": "プレイと、さらに大きなトレード"}, {"type": "subtitle", "time": 11703.87, "timestamp": "03:15:03", "text": "ストリームは時計を見るだけでいい"}, {"type": "subtitle", "time": 11704.83, "timestamp": "03:15:04", "text": "1"}, {"type": "subtitle", "time": 11724.309, "timestamp": "03:15:24", "text": "ああ、そうだ、私はまだヴァロランのものが好きだ"}, {"type": "subtitle", "time": 11726.79, "timestamp": "03:15:26", "text": "私が来てから今までで一番いい感じに開いた"}, {"type": "subtitle", "time": 11729.55, "timestamp": "03:15:29", "text": "家に帰ると"}, {"type": "subtitle", "time": 11733.83, "timestamp": "03:15:33", "text": "私が毎日乗っていた旅行は"}, {"type": "subtitle", "time": 11736.67, "timestamp": "03:15:36", "text": "バレリンをチェックしたら"}, {"type": "subtitle", "time": 11740.83, "timestamp": "03:15:40", "text": "Bパスまであと何日か残っています"}, {"type": "subtitle", "time": 11748.469, "timestamp": "03:15:48", "text": "神様、私はもっと"}]
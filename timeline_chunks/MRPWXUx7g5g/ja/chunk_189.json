[{"type": "subtitle", "time": 11340.91, "timestamp": "03:09:00", "text": "少し"}, {"type": "subtitle", "time": 11351.269, "timestamp": "03:09:11", "text": "うん、家で食べる量は本当に少ないよ"}, {"type": "subtitle", "time": 11356.11, "timestamp": "03:09:16", "text": "私が旅をしていたとき、私は大量の食べ物を与えられていました"}, {"type": "subtitle", "time": 11358.75, "timestamp": "03:09:18", "text": "食べ物の"}, {"type": "subtitle", "time": 11361.11, "timestamp": "03:09:21", "text": "うわー、本当に"}, {"type": "subtitle", "time": 11364.11, "timestamp": "03:09:24", "text": "わあ、どうやって私はできるの？"}, {"type": "subtitle", "time": 11377.19, "timestamp": "03:09:37", "text": "次はどうなるか、分かってるよね？"}, {"type": "subtitle", "time": 11381.11, "timestamp": "03:09:41", "text": "代わりに、U のように購入するのではなく、"}, {"type": "subtitle", "time": 11383.67, "timestamp": "03:09:43", "text": "ライムジュースとかを買う"}, {"type": "subtitle", "time": 11386.07, "timestamp": "03:09:46", "text": "それは一時的なもので、幸運なことに私は"}, {"type": "subtitle", "time": 11388.95, "timestamp": "03:09:48", "text": "実際にはそのお金で買うべき"}, {"type": "subtitle", "time": 11392.07, "timestamp": "03:09:52", "text": "ソフトドリンクか何かのボトル"}, {"type": "subtitle", "time": 11394.429, "timestamp": "03:09:54", "text": "それは私がそれを持てる理由としてもっと良い"}, {"type": "subtitle", "time": 11396.79, "timestamp": "03:09:56", "text": "ボトルを空にして、"}]
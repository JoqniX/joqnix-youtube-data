[{"type": "subtitle", "time": 6660.87, "timestamp": "01:51:00", "text": "ストリーム"}, {"type": "subtitle", "time": 6669.109, "timestamp": "01:51:09", "text": "[音楽]"}, {"type": "subtitle", "time": 6673.27, "timestamp": "01:51:13", "text": "多分あなたは、私は文字通り3つ持っています"}, {"type": "subtitle", "time": 6675.31, "timestamp": "01:51:15", "text": "何時間も、ああ"}, {"type": "subtitle", "time": 6679.589, "timestamp": "01:51:19", "text": "わあ、だから私は読むことができる"}, {"type": "subtitle", "time": 6683.99, "timestamp": "01:51:23", "text": "チャットはチャットの水を読むことができ、私は"}, {"type": "subtitle", "time": 6687.189, "timestamp": "01:51:27", "text": "私のソフトウェアと私の"}, {"type": "subtitle", "time": 6689.47, "timestamp": "01:51:29", "text": "番組を見る"}, {"type": "subtitle", "time": 6692.27, "timestamp": "01:51:32", "text": "えーと、何が"}, {"type": "subtitle", "time": 6695.75, "timestamp": "01:51:35", "text": "裏切る、なぜならLX放送局が"}, {"type": "subtitle", "time": 6699.79, "timestamp": "01:51:39", "text": "通知の件なので、"}, {"type": "subtitle", "time": 6702.709, "timestamp": "01:51:42", "text": "それは良いことだ、私は文字通り立ち上がることができる"}, {"type": "subtitle", "time": 6706.91, "timestamp": "01:51:46", "text": "洗って、トレイが見えるように"}, {"type": "subtitle", "time": 6709.03, "timestamp": "01:51:49", "text": "この場所は"}, {"type": "subtitle", "time": 6712.83, "timestamp": "01:51:52", "text": "えっと、忙しいって言うのかな、でも今日は"}, {"type": "subtitle", "time": 6714.4, "timestamp": "01:51:54", "text": "は 日曜日だが"}]
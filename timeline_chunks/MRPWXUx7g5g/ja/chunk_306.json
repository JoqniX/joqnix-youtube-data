[{"type": "subtitle", "time": 18361.788, "timestamp": "05:06:01", "text": "クル、宝箱をロックしよう、私がロックを解除するよ"}, {"type": "subtitle", "time": 18363.47, "timestamp": "05:06:03", "text": "それ"}, {"type": "subtitle", "time": 18372.948, "timestamp": "05:06:12", "text": "必要なDIさえアンロックしていません"}, {"type": "subtitle", "time": 18384.548, "timestamp": "05:06:24", "text": "どれくらい待つのか"}, {"type": "subtitle", "time": 18387.788, "timestamp": "05:06:27", "text": "何日間続くの？10日間。ああ、いや、私は"}, {"type": "subtitle", "time": 18406.788, "timestamp": "05:06:46", "text": "壊れたテイク"}, {"type": "subtitle", "time": 18413.23, "timestamp": "05:06:53", "text": "飛行は氷を抱きしめる、こんにちは、気にしないで"}]
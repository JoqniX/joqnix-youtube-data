[{"type": "subtitle", "time": 12540.189, "timestamp": "03:29:00", "text": "実際にあなたに"}, {"type": "subtitle", "time": 12543.59, "timestamp": "03:29:03", "text": "週末までにお金と"}, {"type": "subtitle", "time": 12546.83, "timestamp": "03:29:06", "text": "すべて、そして彼は、いや、彼は"}, {"type": "subtitle", "time": 12550.189, "timestamp": "03:29:10", "text": "彼がそうなったように、それを持っていないように"}, {"type": "subtitle", "time": 12552.71, "timestamp": "03:29:12", "text": "父と私の"}, {"type": "subtitle", "time": 12555.309, "timestamp": "03:29:15", "text": "父は私と同じように彼に腹を立てなければならなかった"}, {"type": "subtitle", "time": 12557.91, "timestamp": "03:29:17", "text": "電話のことはやめて、彼はとても"}, {"type": "subtitle", "time": 12560.51, "timestamp": "03:29:20", "text": "痛み、そして彼は私に言った、そして私の父は私に言った"}, {"type": "subtitle", "time": 12563.309, "timestamp": "03:29:23", "text": "彼らは行かないのが好きで、行かないで"}, {"type": "subtitle", "time": 12566.189, "timestamp": "03:29:26", "text": "それはまるでスーパーこの物みたいで、"}, {"type": "subtitle", "time": 12568.15, "timestamp": "03:29:28", "text": "次の日、私は彼らに会いに行き、彼は"}, {"type": "subtitle", "time": 12570.87, "timestamp": "03:29:30", "text": "文字通り私に怒鳴りつけているようで"}, {"type": "subtitle", "time": 12574.95, "timestamp": "03:29:34", "text": "いろいろあって、私は「いや、君は違う」って言った"}, {"type": "subtitle", "time": 12578.99, "timestamp": "03:29:38", "text": "私にいろいろ教えてくれて、お金も欲しいし"}, {"type": "subtitle", "time": 12581.87, "timestamp": "03:29:41", "text": "あなたが文字通りそうであるように、すべてがあなたです"}, {"type": "subtitle", "time": 12584.03, "timestamp": "03:29:44", "text": "練習するように言って、あなたは下に行きます"}, {"type": "subtitle", "time": 12587.03, "timestamp": "03:29:47", "text": "あなたの場所で何か別のことをして"}, {"type": "subtitle", "time": 12589.389, "timestamp": "03:29:49", "text": "私が何をしているか、もっとよく見てください"}, {"type": "subtitle", "time": 12590.15, "timestamp": "03:29:50", "text": "そして"}, {"type": "subtitle", "time": 12592.269, "timestamp": "03:29:52", "text": "すべて、それは何であり、あなたはそうではない"}, {"type": "subtitle", "time": 12594.87, "timestamp": "03:29:54", "text": "自分が学びたいことを教えることさえも、"}, {"type": "subtitle", "time": 12597.91, "timestamp": "03:29:57", "text": "私は文字通り、"}]
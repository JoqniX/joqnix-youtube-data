[{"type": "subtitle", "time": 18240.91, "timestamp": "05:04:00", "text": "いや、君の言う通りだ。わからない。わからない。"}, {"type": "subtitle", "time": 18243.31, "timestamp": "05:04:03", "text": "あなたが説明を求めていることを知りました"}, {"type": "subtitle", "time": 18246.31, "timestamp": "05:04:06", "text": "あなたに1つあげました。それを見つけるために"}, {"type": "subtitle", "time": 18247.75, "timestamp": "05:04:07", "text": "好き"}, {"type": "subtitle", "time": 18250.91, "timestamp": "05:04:10", "text": "スチュは突然、その深いところをどこに行ったのか"}, {"type": "subtitle", "time": 18253.59, "timestamp": "05:04:13", "text": "ちなみに、私は自分自身が好きではない"}, {"type": "subtitle", "time": 18256.83, "timestamp": "05:04:16", "text": "あなたの名前を知っていますが、私の名前は"}, {"type": "subtitle", "time": 18260.628, "timestamp": "05:04:20", "text": "ジョーとあなたの"}, {"type": "subtitle", "time": 18267.59, "timestamp": "05:04:27", "text": "私は実際に"}, {"type": "subtitle", "time": 18271.07, "timestamp": "05:04:31", "text": "私がここに送ったものは、ここに送られました"}, {"type": "subtitle", "time": 18273.07, "timestamp": "05:04:33", "text": "長い間、私はほとんど何も知りません"}, {"type": "subtitle", "time": 18275.15, "timestamp": "05:04:35", "text": "表面上は何が起こっているのか"}, {"type": "subtitle", "time": 18277.83, "timestamp": "05:04:37", "text": "ニュースは私たちの供給を通じて入手します"}, {"type": "subtitle", "time": 18290.39, "timestamp": "05:04:50", "text": "私の炎に眉をひそめたんじゃないの？"}, {"type": "subtitle", "time": 18293.03, "timestamp": "05:04:53", "text": "水、それはそう思っていなかったからです"}]
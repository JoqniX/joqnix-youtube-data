[{"type": "subtitle", "time": 17959.708, "timestamp": "04:59:19", "text": "私を楽しませてください、あなたは本当にその方法をよく知っています"}, {"type": "subtitle", "time": 17974.07, "timestamp": "04:59:34", "text": "君はここでは悪者だから、なぜ"}, {"type": "subtitle", "time": 17976.708, "timestamp": "04:59:36", "text": "説明しないで"}, {"type": "subtitle", "time": 17980.788, "timestamp": "04:59:40", "text": "まず、私の名前はカトリーナです。"}, {"type": "subtitle", "time": 17982.868, "timestamp": "04:59:42", "text": "スネ"}, {"type": "subtitle", "time": 17996.39, "timestamp": "04:59:56", "text": "発音すべきではない"}]
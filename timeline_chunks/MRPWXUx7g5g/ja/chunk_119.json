[{"type": "subtitle", "time": 7149.229, "timestamp": "01:59:09", "text": "[音楽]"}, {"type": "subtitle", "time": 7151.95, "timestamp": "01:59:11", "text": "急いでいるし、私も"}, {"type": "subtitle", "time": 7156.229, "timestamp": "01:59:16", "text": "こっそりこっそり手に入れる"}, {"type": "subtitle", "time": 7158.629, "timestamp": "01:59:18", "text": "内側は好き"}, {"type": "subtitle", "time": 7162.75, "timestamp": "01:59:22", "text": "私のPは大丈夫だと思います"}, {"type": "subtitle", "time": 7165.99, "timestamp": "01:59:25", "text": "私はこれを成功させることができる"}, {"type": "subtitle", "time": 7170.589, "timestamp": "01:59:30", "text": "だって、えーと、父が私にこれをするように言ったから"}, {"type": "subtitle", "time": 7174.47, "timestamp": "01:59:34", "text": "私の母は、もしかしたら私を"}, {"type": "subtitle", "time": 7175.669, "timestamp": "01:59:35", "text": "で"}, {"type": "subtitle", "time": 7185.55, "timestamp": "01:59:45", "text": "知ってるよ、だから私はいつも"}, {"type": "subtitle", "time": 7189.35, "timestamp": "01:59:49", "text": "夕方にやるので"}, {"type": "subtitle", "time": 7193.709, "timestamp": "01:59:53", "text": "私がすべきことをする"}, {"type": "subtitle", "time": 7195.47, "timestamp": "01:59:55", "text": "朝"}, {"type": "subtitle", "time": 7197.79, "timestamp": "01:59:57", "text": "えっと、やるべきかどうかわからないんだけど"}]
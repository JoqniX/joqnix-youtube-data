[{"type": "subtitle", "time": 13202.95, "timestamp": "03:40:02", "text": "そして、ああ、なんてことだ"}, {"type": "subtitle", "time": 13207.389, "timestamp": "03:40:07", "text": "ああ、そうだ、こんにちはBR、元気かい？"}, {"type": "subtitle", "time": 13210.83, "timestamp": "03:40:10", "text": "2時間歩くのに座らないの？"}, {"type": "subtitle", "time": 13214.469, "timestamp": "03:40:14", "text": "1時間半歩いてから"}, {"type": "subtitle", "time": 13216.55, "timestamp": "03:40:16", "text": "座っていた"}, {"type": "subtitle", "time": 13218.469, "timestamp": "03:40:18", "text": "私たちは少し悲しかった"}, {"type": "subtitle", "time": 13222.87, "timestamp": "03:40:22", "text": "今日は、私が来たときとても"}, {"type": "subtitle", "time": 13223.99, "timestamp": "03:40:23", "text": "のように"}, {"type": "subtitle", "time": 13227.03, "timestamp": "03:40:27", "text": "ああ、神様ありがとう"}, {"type": "subtitle", "time": 13230.91, "timestamp": "03:40:30", "text": "左に行けば痛みを感じるだろう、私は何も望まない"}, {"type": "subtitle", "time": 13234.189, "timestamp": "03:40:34", "text": "3人が私のところにやって来て"}, {"type": "subtitle", "time": 13244.11, "timestamp": "03:40:44", "text": "怖かった、そうだったらよかったのに"}, {"type": "subtitle", "time": 13246.309, "timestamp": "03:40:46", "text": "モは"}, {"type": "subtitle", "time": 13249.389, "timestamp": "03:40:49", "text": "そういうものだ、これを終わらせるべきだろうか"}, {"type": "subtitle", "time": 13252.309, "timestamp": "03:40:52", "text": "ペプシのボトルが少しだけ残っている"}, {"type": "subtitle", "time": 13254.03, "timestamp": "03:40:54", "text": "そして"}, {"type": "subtitle", "time": 13259.15, "timestamp": "03:40:59", "text": "今日夕食を食べているとき、私は丸ごと一杯飲みました"}]
[{"type": "subtitle", "time": 18780.868, "timestamp": "05:13:00", "text": "それに対する後悔と、一度死んだらそれは悪いものだった"}, {"type": "subtitle", "time": 18784.99, "timestamp": "05:13:04", "text": "決断した理由は、えっと、私は手に入れたかったからです。"}, {"type": "subtitle", "time": 18786.11, "timestamp": "05:13:06", "text": "雷電"}, {"type": "subtitle", "time": 18788.83, "timestamp": "05:13:08", "text": "避けるが、お金を使った後でも"}, {"type": "subtitle", "time": 18790.67, "timestamp": "05:13:10", "text": "ターゲットを描く方法は一つだけではありません"}, {"type": "subtitle", "time": 18792.948, "timestamp": "05:13:12", "text": "彼女を捕まえる"}, {"type": "subtitle", "time": 18796.51, "timestamp": "05:13:16", "text": "しかし、不幸なことに、V 一人の不幸な"}, {"type": "subtitle", "time": 18799.548, "timestamp": "05:13:19", "text": "やっと彼女を手に入れられたのに、とても悲しかった"}, {"type": "subtitle", "time": 18803.548, "timestamp": "05:13:23", "text": "私はHだったが、Sであるべきだった"}, {"type": "subtitle", "time": 18809.11, "timestamp": "05:13:29", "text": "幸せだったけど、すごく悲しかった。だって、"}, {"type": "subtitle", "time": 18813.628, "timestamp": "05:13:33", "text": "貯金を全部使って"}, {"type": "subtitle", "time": 18816.91, "timestamp": "05:13:36", "text": "彼女を手に入れたが、私が彼女を手に入れなかったとき"}, {"type": "subtitle", "time": 18821.11, "timestamp": "05:13:41", "text": "欲しかったし、バイオから感じた"}, {"type": "subtitle", "time": 18823.948, "timestamp": "05:13:43", "text": "そこには"}]
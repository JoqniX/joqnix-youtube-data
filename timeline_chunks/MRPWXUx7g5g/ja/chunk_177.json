[{"type": "subtitle", "time": 10622.349, "timestamp": "02:57:02", "text": "でも君はまだモンキーキャブを着ている"}, {"type": "subtitle", "time": 10626.389, "timestamp": "02:57:06", "text": "NOA、いや、それは"}, {"type": "subtitle", "time": 10629.15, "timestamp": "02:57:09", "text": "熱い、熱いという意味ではなく、文字通り硬いという意味です。"}, {"type": "subtitle", "time": 10632.99, "timestamp": "02:57:12", "text": "汗だくで、自分の"}, {"type": "subtitle", "time": 10645.59, "timestamp": "02:57:25", "text": "マネーキャップって何を調べましたか？"}, {"type": "subtitle", "time": 10649.59, "timestamp": "02:57:29", "text": "つまり、男はこれをどう見たか、どうやって"}, {"type": "subtitle", "time": 10652.63, "timestamp": "02:57:32", "text": "どう思う？"}, {"type": "subtitle", "time": 10656.59, "timestamp": "02:57:36", "text": "本物の猿みたいなものだけど、"}, {"type": "subtitle", "time": 10659.87, "timestamp": "02:57:39", "text": "頭と顎の半分が"}, {"type": "subtitle", "time": 10661.51, "timestamp": "02:57:41", "text": "覆われていて、見えるのは"}, {"type": "subtitle", "time": 10668.95, "timestamp": "02:57:48", "text": "ヘルメットですね"}]
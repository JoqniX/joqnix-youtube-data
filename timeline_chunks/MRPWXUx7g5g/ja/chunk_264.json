[{"type": "subtitle", "time": 15841.03, "timestamp": "04:24:01", "text": "久しぶりに下忍インパクトをプレイしました"}, {"type": "subtitle", "time": 15843.59, "timestamp": "04:24:03", "text": "ジェニンインパクトをプレイして以来、"}, {"type": "subtitle", "time": 15847.469, "timestamp": "04:24:07", "text": "下忍になるのが楽しみです"}, {"type": "subtitle", "time": 15850.99, "timestamp": "04:24:10", "text": "しばらくぶりで、えっと、私は知っています"}, {"type": "subtitle", "time": 15853.189, "timestamp": "04:24:13", "text": "タイトルには「宝箱を探検する」と書いてある。"}, {"type": "subtitle", "time": 15856.189, "timestamp": "04:24:16", "text": "チャッサムを探検しました"}, {"type": "subtitle", "time": 15860.109, "timestamp": "04:24:20", "text": "ストリームは1週間前か5日前"}, {"type": "subtitle", "time": 15863.189, "timestamp": "04:24:23", "text": "以前、私は探索してクエストをいくつか行いました"}, {"type": "subtitle", "time": 15866.83, "timestamp": "04:24:26", "text": "スピードランニングみたいな感じだったんだけど、やりたかったのは"}, {"type": "subtitle", "time": 15869.71, "timestamp": "04:24:29", "text": "イベント 私はイベントに参加できなかったので、"}, {"type": "subtitle", "time": 15871.51, "timestamp": "04:24:31", "text": "シャーシをスピードランします"}, {"type": "subtitle", "time": 15874.349, "timestamp": "04:24:34", "text": "今日のもの"}]
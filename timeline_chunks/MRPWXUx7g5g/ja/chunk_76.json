[{"type": "subtitle", "time": 4560.229, "timestamp": "01:16:00", "text": "I5 94 944 F または"}, {"type": "subtitle", "time": 4564.79, "timestamp": "01:16:04", "text": "何かがあって、100℃になるまで使い続けました"}, {"type": "subtitle", "time": 4568.95, "timestamp": "01:16:08", "text": "摂氏温度で、私はまだ"}, {"type": "subtitle", "time": 4572.149, "timestamp": "01:16:12", "text": "面白いことに、それは決して"}, {"type": "subtitle", "time": 4576.43, "timestamp": "01:16:16", "text": "溶けたり何か起こったり"}, {"type": "subtitle", "time": 4579.83, "timestamp": "01:16:19", "text": "えっと、フォートナイトをプレイしていたのを覚えているよ"}, {"type": "subtitle", "time": 4581.79, "timestamp": "01:16:21", "text": "インテル コア"}, {"type": "subtitle", "time": 4585.55, "timestamp": "01:16:25", "text": "Pentium CPU を今、小さなものとして置きます"}, {"type": "subtitle", "time": 4589.07, "timestamp": "01:16:29", "text": "窓はこんな感じですね。窓を設置しました。"}, {"type": "subtitle", "time": 4590.51, "timestamp": "01:16:30", "text": "のような"}, {"type": "subtitle", "time": 4593.43, "timestamp": "01:16:33", "text": "この窓は以前は本当に"}, {"type": "subtitle", "time": 4595.189, "timestamp": "01:16:35", "text": "小さい、これが私の昔の遊び方"}, {"type": "subtitle", "time": 4598.47, "timestamp": "01:16:38", "text": "昔はこんなフォートナイトをプレイしていた"}, {"type": "subtitle", "time": 4601.189, "timestamp": "01:16:41", "text": "フォートナイト 全てが黒"}, {"type": "subtitle", "time": 4603.99, "timestamp": "01:16:43", "text": "画面"}, {"type": "subtitle", "time": 4607.229, "timestamp": "01:16:47", "text": "ああ、彼はきっと素敵な両親を持っているに違いない。"}, {"type": "subtitle", "time": 4609.669, "timestamp": "01:16:49", "text": "お金がなかったので、一生懸命働かなければなりませんでした"}, {"type": "subtitle", "time": 4612.31, "timestamp": "01:16:52", "text": "私の側から"}, {"type": "subtitle", "time": 4616.07, "timestamp": "01:16:56", "text": "どういうわけか奇妙なことをしている"}]
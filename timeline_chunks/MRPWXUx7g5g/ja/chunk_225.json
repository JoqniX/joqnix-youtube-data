[{"type": "subtitle", "time": 13510.55, "timestamp": "03:45:10", "text": "夜はまだ始まったばかりだと言いたい"}, {"type": "subtitle", "time": 13513.07, "timestamp": "03:45:13", "text": "しかしそれは"}, {"type": "subtitle", "time": 13515.67, "timestamp": "03:45:15", "text": "それは私のゲームプランではありません"}, {"type": "subtitle", "time": 13517.79, "timestamp": "03:45:17", "text": "そこで私は行くつもりです"}, {"type": "subtitle", "time": 13522.469, "timestamp": "03:45:22", "text": "ラリィ、こっちに行けばいいよ、でも"}, {"type": "subtitle", "time": 13525.149, "timestamp": "03:45:25", "text": "この道は、ある意味"}, {"type": "subtitle", "time": 13527.429, "timestamp": "03:45:27", "text": "危険な"}, {"type": "subtitle", "time": 13530.389, "timestamp": "03:45:30", "text": "私は文字通り何も祈りません"}, {"type": "subtitle", "time": 13532.75, "timestamp": "03:45:32", "text": "実際に起こる、この道は"}, {"type": "subtitle", "time": 13533.429, "timestamp": "03:45:33", "text": "の"}, {"type": "subtitle", "time": 13537.149, "timestamp": "03:45:37", "text": "危険だ、酔っ払ったみたいになるだろう"}, {"type": "subtitle", "time": 13540.389, "timestamp": "03:45:40", "text": "人々よ"}, {"type": "subtitle", "time": 13543.59, "timestamp": "03:45:43", "text": "アメリカとかで神様みたいな人たちは"}, {"type": "subtitle", "time": 13545.429, "timestamp": "03:45:45", "text": "持ち運べるように"}, {"type": "subtitle", "time": 13550.75, "timestamp": "03:45:50", "text": "唐辛子のショックみたいなやつ"}, {"type": "subtitle", "time": 13553.229, "timestamp": "03:45:53", "text": "誰かが、もしも何が起こるか"}, {"type": "subtitle", "time": 13555.389, "timestamp": "03:45:55", "text": "他の誰かが私のスクリーンショットを盗む"}, {"type": "subtitle", "time": 13556.99, "timestamp": "03:45:56", "text": "私の携帯電話すべて何何何何"}, {"type": "subtitle", "time": 13559.63, "timestamp": "03:45:59", "text": "何が起こったのか、私はどう戦えばいいのかわかりません"}]
[{"type": "subtitle", "time": 9303.59, "timestamp": "02:35:03", "text": "ストリームだけど、もっとえっと、えっと、君たち"}, {"type": "subtitle", "time": 9307.469, "timestamp": "02:35:07", "text": "見て、私はとても痛い痛みピクルスです"}, {"type": "subtitle", "time": 9309.349, "timestamp": "02:35:09", "text": "ピクルスと全部"}, {"type": "subtitle", "time": 9312.91, "timestamp": "02:35:12", "text": "それはとても"}, {"type": "subtitle", "time": 9315.79, "timestamp": "02:35:15", "text": "痛みは私のショーに集中していません"}, {"type": "subtitle", "time": 9325.349, "timestamp": "02:35:25", "text": "ああ、そう、多くの人が"}, {"type": "subtitle", "time": 9328.349, "timestamp": "02:35:28", "text": "ハッシュタグを付けて"}, {"type": "subtitle", "time": 9331.71, "timestamp": "02:35:31", "text": "タイトル よく考えてみると、私は決して"}, {"type": "subtitle", "time": 9334.309, "timestamp": "02:35:34", "text": "始めるべきかどうか、"}, {"type": "subtitle", "time": 9335.91, "timestamp": "02:35:35", "text": "そうすべきではない、私はそうしない"}, {"type": "subtitle", "time": 9339.87, "timestamp": "02:35:39", "text": "昔はよくやっていたんだけど"}, {"type": "subtitle", "time": 9341.91, "timestamp": "02:35:41", "text": "の"}, {"type": "subtitle", "time": 9346.349, "timestamp": "02:35:46", "text": "以前はそうしていたが、今はそうしない"}, {"type": "subtitle", "time": 9358.469, "timestamp": "02:35:58", "text": "クール、彼女はポップアップの私みたいだけど、今は"}]
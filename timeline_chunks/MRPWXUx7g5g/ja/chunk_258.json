[{"type": "subtitle", "time": 15483.75, "timestamp": "04:18:03", "text": "すべてこんにちは、私はそれをします、私は"}, {"type": "subtitle", "time": 15488.99, "timestamp": "04:18:08", "text": "明日までには上がるよ、とにかく"}, {"type": "subtitle", "time": 15491.67, "timestamp": "04:18:11", "text": "皆さん、来てくれてありがとう。"}, {"type": "subtitle", "time": 15493.79, "timestamp": "04:18:13", "text": "また近いうちに会おうね"}, {"type": "subtitle", "time": 15496.63, "timestamp": "04:18:16", "text": "何をして、さようなら"}, {"type": "subtitle", "time": 15501.67, "timestamp": "04:18:21", "text": "さようなら、ゆっくり休んで、夕食をちゃんと食べてね。"}, {"type": "subtitle", "time": 15504.389, "timestamp": "04:18:24", "text": "試してみますが、お腹は空いていませんが、"}, {"type": "subtitle", "time": 15509.149, "timestamp": "04:18:29", "text": "少し食べてみてください。"}, {"type": "subtitle", "time": 15511.59, "timestamp": "04:18:31", "text": "おやすみなさい、またね"}, {"type": "subtitle", "time": 15513.99, "timestamp": "04:18:33", "text": "明日"}, {"type": "subtitle", "time": 15515.99, "timestamp": "04:18:35", "text": "さよなら、何"}, {"type": "subtitle", "time": 15518.71, "timestamp": "04:18:38", "text": "こう締めくくればいい？"}, {"type": "subtitle", "time": 15524.229, "timestamp": "04:18:44", "text": "うん、待って、待って"}, {"type": "subtitle", "time": 15529.149, "timestamp": "04:18:49", "text": "おやすみなさい、忘れずに"}, {"type": "subtitle", "time": 15531.95, "timestamp": "04:18:51", "text": "そして、最高のことをしようと考えたのはどういうことだったのか"}, {"type": "subtitle", "time": 15534.55, "timestamp": "04:18:54", "text": "私たちがどのように"}, {"type": "subtitle", "time": 15537.149, "timestamp": "04:18:57", "text": "y 何ですか"}]
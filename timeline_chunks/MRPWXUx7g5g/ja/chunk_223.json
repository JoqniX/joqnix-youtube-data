[{"type": "subtitle", "time": 13381.07, "timestamp": "03:43:01", "text": "ライトが点灯している"}, {"type": "subtitle", "time": 13389.95, "timestamp": "03:43:09", "text": "えーと、実は、"}, {"type": "subtitle", "time": 13392.91, "timestamp": "03:43:12", "text": "さあ、歩いて他の大きな場所へ行こう"}, {"type": "subtitle", "time": 13395.229, "timestamp": "03:43:15", "text": "ここまでずっと、私は考えない"}, {"type": "subtitle", "time": 13396.87, "timestamp": "03:43:16", "text": "それは良い"}, {"type": "subtitle", "time": 13401.91, "timestamp": "03:43:21", "text": "アイデアをお見せしますが、少し歩きます"}, {"type": "subtitle", "time": 13404.51, "timestamp": "03:43:24", "text": "でも少し歩く"}, {"type": "subtitle", "time": 13411.59, "timestamp": "03:43:31", "text": "もちろん。チャマのパンの調子はどう？"}, {"type": "subtitle", "time": 13425.67, "timestamp": "03:43:45", "text": "寝てるよ、電源オン、ああ、携帯電話を置いたよ"}, {"type": "subtitle", "time": 13428.87, "timestamp": "03:43:48", "text": "寝る時間を思い出させてくれるような感じで"}, {"type": "subtitle", "time": 13431.79, "timestamp": "03:43:51", "text": "そして電話にそう伝える"}, {"type": "subtitle", "time": 13435.07, "timestamp": "03:43:55", "text": "私は午後10時までには寝ています。今度はこれだ"}, {"type": "subtitle", "time": 13436.67, "timestamp": "03:43:56", "text": "今でも好き"}, {"type": "subtitle", "time": 13439.269, "timestamp": "03:43:59", "text": "6番はラリーです"}]
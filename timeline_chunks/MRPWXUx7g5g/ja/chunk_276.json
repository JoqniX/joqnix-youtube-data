[{"type": "subtitle", "time": 16580.029, "timestamp": "04:36:20", "text": "どこにあるか"}, {"type": "subtitle", "time": 16602.75, "timestamp": "04:36:42", "text": "彼、素敵だね、ああ、私は、うーん、飛ぶような感じ"}, {"type": "subtitle", "time": 16604.99, "timestamp": "04:36:44", "text": "閉じ込められて"}, {"type": "subtitle", "time": 16615.789, "timestamp": "04:36:55", "text": "45歳で、私は空気を吸うべきだ"}, {"type": "subtitle", "time": 16619.159, "timestamp": "04:36:59", "text": "53 もし私が昇天したら"}]
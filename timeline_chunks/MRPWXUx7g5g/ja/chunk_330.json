[{"type": "subtitle", "time": 19801.47, "timestamp": "05:30:01", "text": "死んでリスポーンして家に帰る"}, {"type": "subtitle", "time": 19803.548, "timestamp": "05:30:03", "text": "飛行機だと思った"}, {"type": "subtitle", "time": 19806.59, "timestamp": "05:30:06", "text": "私はあなたを完全に捨てたが、彼が来た"}, {"type": "subtitle", "time": 19816.43, "timestamp": "05:30:16", "text": "ターゲットを描画する一つの方法を大切にします"}, {"type": "subtitle", "time": 19819.35, "timestamp": "05:30:19", "text": "それは私の、えーと、私のH自己治癒です"}, {"type": "subtitle", "time": 19826.47, "timestamp": "05:30:26", "text": "ああ、自分自身を持っている"}, {"type": "subtitle", "time": 19831.99, "timestamp": "05:30:31", "text": "治癒 自己治癒 H 私は H を望んでいました"}, {"type": "subtitle", "time": 19835.628, "timestamp": "05:30:35", "text": "私のお気に入りはラーシです。"}, {"type": "subtitle", "time": 19836.59, "timestamp": "05:30:36", "text": "声"}, {"type": "subtitle", "time": 19840.35, "timestamp": "05:30:40", "text": "尊敬する男性に会ったとき、私は"}, {"type": "subtitle", "time": 19845.07, "timestamp": "05:30:45", "text": "日"}, {"type": "subtitle", "time": 19854.43, "timestamp": "05:30:54", "text": "こんにちは、雪に気をつけて、気をつけて"}, {"type": "subtitle", "time": 19856.47, "timestamp": "05:30:56", "text": "ケア"}]
[{"type": "subtitle", "time": 14463.189, "timestamp": "04:01:03", "text": "反対する人を助ける"}, {"type": "subtitle", "time": 14464.63, "timestamp": "04:01:04", "text": "それらすべて"}, {"type": "subtitle", "time": 14474.269, "timestamp": "04:01:14", "text": "人々と主に"}, {"type": "subtitle", "time": 14476.269, "timestamp": "04:01:16", "text": "有害な友情"}, {"type": "subtitle", "time": 14479.429, "timestamp": "04:01:19", "text": "過剰、それは事実であり、常に"}, {"type": "subtitle", "time": 14480.67, "timestamp": "04:01:20", "text": "良いものを選ぶ"}, {"type": "subtitle", "time": 14483.11, "timestamp": "04:01:23", "text": "友達ではなく、悪い人"}, {"type": "subtitle", "time": 14487.59, "timestamp": "04:01:27", "text": "そういうのをすごく苦労して学んだ"}, {"type": "subtitle", "time": 14488.91, "timestamp": "04:01:28", "text": "私が"}, {"type": "subtitle", "time": 14493.189, "timestamp": "04:01:33", "text": "そうだと思う、切り落としたんだ、それは"}, {"type": "subtitle", "time": 14496.149, "timestamp": "04:01:36", "text": "怒って怒って"}, {"type": "subtitle", "time": 14499.55, "timestamp": "04:01:39", "text": "えっと、電話みたいなの、だって私、1つ持ってるから"}, {"type": "subtitle", "time": 14501.87, "timestamp": "04:01:41", "text": "人と、2 人が"}, {"type": "subtitle", "time": 14504.83, "timestamp": "04:01:44", "text": "まるで壁が2つあるみたいだ"}, {"type": "subtitle", "time": 14507.87, "timestamp": "04:01:47", "text": "私の前にはもっと近づくか、"}, {"type": "subtitle", "time": 14510.83, "timestamp": "04:01:50", "text": "去る、うん、そういうの"}, {"type": "subtitle", "time": 14515.07, "timestamp": "04:01:55", "text": "そうだけど、私は泣かなかった"}, {"type": "subtitle", "time": 14518.79, "timestamp": "04:01:58", "text": "その日、私は全く泣かなかった。"}]
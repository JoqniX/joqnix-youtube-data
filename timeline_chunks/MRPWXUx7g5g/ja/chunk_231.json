[{"type": "subtitle", "time": 13863.63, "timestamp": "03:51:03", "text": "次に、確認したいのは"}, {"type": "subtitle", "time": 13871.83, "timestamp": "03:51:11", "text": "えっと、誰のやつ？あ、あ、わかった、わかった、私"}, {"type": "subtitle", "time": 13874.349, "timestamp": "03:51:14", "text": "見なかった、えっと、見た、と読んだ"}, {"type": "subtitle", "time": 13886.87, "timestamp": "03:51:26", "text": "うん、でもそうだよ、いくつかあるよ"}, {"type": "subtitle", "time": 13889.71, "timestamp": "03:51:29", "text": "私が望む状況、私が知っているように、"}, {"type": "subtitle", "time": 13891.149, "timestamp": "03:51:31", "text": "あまりにも"}, {"type": "subtitle", "time": 13894.429, "timestamp": "03:51:34", "text": "時々オープンになるが、またオープンになりすぎると"}, {"type": "subtitle", "time": 13896.269, "timestamp": "03:51:36", "text": "できない"}, {"type": "subtitle", "time": 13900.95, "timestamp": "03:51:40", "text": "よかった、ハードに着地したことは分かっている"}, {"type": "subtitle", "time": 13902.63, "timestamp": "03:51:42", "text": "方法"}, {"type": "subtitle", "time": 13906.79, "timestamp": "03:51:46", "text": "ええ、そういう場合、私は理解できます"}, {"type": "subtitle", "time": 13909.309, "timestamp": "03:51:49", "text": "しかし、たとえ"}, {"type": "subtitle", "time": 13911.91, "timestamp": "03:51:51", "text": "それはストリームの中にある、私が"}, {"type": "subtitle", "time": 13914.71, "timestamp": "03:51:54", "text": "話して、私の心"}, {"type": "subtitle", "time": 13916.229, "timestamp": "03:51:56", "text": "流れ"}]
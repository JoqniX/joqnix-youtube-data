[{"type": "subtitle", "time": 8641.83, "timestamp": "02:24:01", "text": "いろいろあるけど"}, {"type": "subtitle", "time": 8645.67, "timestamp": "02:24:05", "text": "時々、とても痛い"}, {"type": "subtitle", "time": 8648.79, "timestamp": "02:24:08", "text": "えっと、時々できない"}, {"type": "subtitle", "time": 8651.429, "timestamp": "02:24:11", "text": "それらの約束や"}, {"type": "subtitle", "time": 8655.389, "timestamp": "02:24:15", "text": "私はもっ​​と"}, {"type": "subtitle", "time": 8665.99, "timestamp": "02:24:25", "text": "かつて私たちがしていたSSや歌のセッションのように"}, {"type": "subtitle", "time": 8667.95, "timestamp": "02:24:27", "text": "えっと、それは何なのかわかりません"}, {"type": "subtitle", "time": 8670.63, "timestamp": "02:24:30", "text": "私は飢えに苦しんだ"}, {"type": "subtitle", "time": 8674.91, "timestamp": "02:24:34", "text": "しばらくそう言ってなかった"}, {"type": "subtitle", "time": 8679.55, "timestamp": "02:24:39", "text": "決して言いたかったわけではない"}, {"type": "subtitle", "time": 8683.67, "timestamp": "02:24:43", "text": "まるで自分が何を言いたいか分かっているかのように、彼が"}, {"type": "subtitle", "time": 8685.99, "timestamp": "02:24:45", "text": "私の友人"}, {"type": "subtitle", "time": 8688.91, "timestamp": "02:24:48", "text": "デビューのようなものや、彼らが持っているようなことをする"}, {"type": "subtitle", "time": 8692.269, "timestamp": "02:24:52", "text": "彼ら自身の業績について言えば、"}, {"type": "subtitle", "time": 8694.349, "timestamp": "02:24:54", "text": "決して祝われることはなかった"}, {"type": "subtitle", "time": 8698.469, "timestamp": "02:24:58", "text": "私の記念日なので"}]
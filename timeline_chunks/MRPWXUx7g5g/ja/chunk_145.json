[{"type": "subtitle", "time": 8702.79, "timestamp": "02:25:02", "text": "今年は間違いなく"}, {"type": "subtitle", "time": 8704.389, "timestamp": "02:25:04", "text": "私の"}, {"type": "subtitle", "time": 8707.51, "timestamp": "02:25:07", "text": "記念日なので、"}, {"type": "subtitle", "time": 8710.71, "timestamp": "02:25:10", "text": "文字通りあなたたちと一緒にお祝いします"}, {"type": "subtitle", "time": 8713.429, "timestamp": "02:25:13", "text": "特別なことは何もないとしても、"}, {"type": "subtitle", "time": 8716.75, "timestamp": "02:25:16", "text": "私たちはただ、私たちが普段やっていることに戻るだけです"}, {"type": "subtitle", "time": 8719.79, "timestamp": "02:25:19", "text": "私たちの誕生日配信に戻って、"}, {"type": "subtitle", "time": 8721.07, "timestamp": "02:25:21", "text": "そして、"}, {"type": "subtitle", "time": 8725.269, "timestamp": "02:25:25", "text": "去年のすべてを見て、私は思う"}, {"type": "subtitle", "time": 8728.99, "timestamp": "02:25:28", "text": "私の誕生日のために取っておくべきではない"}, {"type": "subtitle", "time": 8731.03, "timestamp": "02:25:31", "text": "誕生日記念日ではなく"}, {"type": "subtitle", "time": 8735.63, "timestamp": "02:25:35", "text": "誕生日なので、私が"}, {"type": "subtitle", "time": 8738.99, "timestamp": "02:25:38", "text": "最初は私が"}, {"type": "subtitle", "time": 8740.95, "timestamp": "02:25:40", "text": "初めて誕生日配信をしました"}, {"type": "subtitle", "time": 8745.07, "timestamp": "02:25:45", "text": "YouTuberとしての時間を祝いました"}, {"type": "subtitle", "time": 8747.429, "timestamp": "02:25:47", "text": "まるで記念日か何か"}, {"type": "subtitle", "time": 8749.95, "timestamp": "02:25:49", "text": "何かと、Jミックスが"}, {"type": "subtitle", "time": 8751.63, "timestamp": "02:25:51", "text": "生まれる"}, {"type": "subtitle", "time": 8755.11, "timestamp": "02:25:55", "text": "そういう類のものすべて"}, {"type": "subtitle", "time": 8757.91, "timestamp": "02:25:57", "text": "でもあなたは私がそれを保管しておくべきだと理解していた"}]
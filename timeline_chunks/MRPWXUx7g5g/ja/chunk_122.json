[{"type": "subtitle", "time": 7321.03, "timestamp": "02:02:01", "text": "これは驚異的だ"}, {"type": "subtitle", "time": 7323.87, "timestamp": "02:02:03", "text": "驚異的なファルのような"}, {"type": "subtitle", "time": 7326.39, "timestamp": "02:02:06", "text": "AST どれを使うべきでしょうか"}, {"type": "subtitle", "time": 7329.47, "timestamp": "02:02:09", "text": "知らないよ"}, {"type": "subtitle", "time": 7337.229, "timestamp": "02:02:17", "text": "いつか良い日が来るなら"}, {"type": "subtitle", "time": 7340.51, "timestamp": "02:02:20", "text": "試験が終わったら、"}, {"type": "subtitle", "time": 7343.83, "timestamp": "02:02:23", "text": "ライブトリティで手に入れるもの"}, {"type": "subtitle", "time": 7347.109, "timestamp": "02:02:27", "text": "そして実際にそれを手に入れるように、"}, {"type": "subtitle", "time": 7349.27, "timestamp": "02:02:29", "text": "続けて、学び続ける"}, {"type": "subtitle", "time": 7352.03, "timestamp": "02:02:32", "text": "人生のすべてを学ぶ"}, {"type": "subtitle", "time": 7355.99, "timestamp": "02:02:35", "text": "うんうん、だから私は自分の"}, {"type": "subtitle", "time": 7359.51, "timestamp": "02:02:39", "text": "スチュ、でもそれは基本的なものになるでしょう"}, {"type": "subtitle", "time": 7365.27, "timestamp": "02:02:45", "text": "セントに行きたいけど、ゆっくりならできると思う"}, {"type": "subtitle", "time": 7369.03, "timestamp": "02:02:49", "text": "ホイールさえあれば"}, {"type": "subtitle", "time": 7370.35, "timestamp": "02:02:50", "text": "する"}, {"type": "subtitle", "time": 7373.31, "timestamp": "02:02:53", "text": "そうですね"}, {"type": "subtitle", "time": 7378.109, "timestamp": "02:02:58", "text": "本当の権利があるから、そう、だから私たちは"}, {"type": "subtitle", "time": 7379.109, "timestamp": "02:02:59", "text": "の"}]
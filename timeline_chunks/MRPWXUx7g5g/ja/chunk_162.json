[{"type": "subtitle", "time": 9721.11, "timestamp": "02:42:01", "text": "いいえ、まだですが、いつか、私が"}, {"type": "subtitle", "time": 9723.309, "timestamp": "02:42:03", "text": "言おうとしている"}, {"type": "subtitle", "time": 9726.429, "timestamp": "02:42:06", "text": "私がどう歌うべきか知ってるでしょ"}, {"type": "subtitle", "time": 9730.349, "timestamp": "02:42:10", "text": "そうですね、一体どうやって"}, {"type": "subtitle", "time": 9734.99, "timestamp": "02:42:14", "text": "私がそれをしている間、私は"}, {"type": "subtitle", "time": 9737.429, "timestamp": "02:42:17", "text": "どうやってやったのか、自分でも不思議に思う"}, {"type": "subtitle", "time": 9739.51, "timestamp": "02:42:19", "text": "私の部屋で"}, {"type": "subtitle", "time": 9743.19, "timestamp": "02:42:23", "text": "文字通りどうやって"}, {"type": "subtitle", "time": 9750.95, "timestamp": "02:42:30", "text": "すごい、わからない、私はそうじゃない"}, {"type": "subtitle", "time": 9753.63, "timestamp": "02:42:33", "text": "私はL sweなので歩いています。ただ"}, {"type": "subtitle", "time": 9757.71, "timestamp": "02:42:37", "text": "行くために、そして私はリラックスしたい、それが"}, {"type": "subtitle", "time": 9760.07, "timestamp": "02:42:40", "text": "主な"}, {"type": "subtitle", "time": 9765.95, "timestamp": "02:42:45", "text": "それについて言えば、"}, {"type": "subtitle", "time": 9768.11, "timestamp": "02:42:48", "text": "あなたは私にそれをするべきで、"}, {"type": "subtitle", "time": 9771.67, "timestamp": "02:42:51", "text": "ズキ、近いうちにそれをやるよ。"}, {"type": "subtitle", "time": 9774.23, "timestamp": "02:42:54", "text": "私の元カレの次に好き"}, {"type": "subtitle", "time": 9778.95, "timestamp": "02:42:58", "text": "おそらく、えっと、それはむしろ、何をするかということです"}, {"type": "subtitle", "time": 9779.83, "timestamp": "02:42:59", "text": "あなたが電話する"}]
[{"type": "subtitle", "time": 11587.67, "timestamp": "03:13:07", "text": "待って、ああ、29日だったんだ。わかった、わかった。"}, {"type": "subtitle", "time": 11590.429, "timestamp": "03:13:10", "text": "待って、彼女はいつ"}, {"type": "subtitle", "time": 11592.79, "timestamp": "03:13:12", "text": "ストリーミングで、文字通り"}, {"type": "subtitle", "time": 11601.55, "timestamp": "03:13:21", "text": "どうやら29日らしい"}, {"type": "subtitle", "time": 11604.71, "timestamp": "03:13:24", "text": "明日6月4日は、"}, {"type": "subtitle", "time": 11607.11, "timestamp": "03:13:27", "text": "文字通り私のacamの1日前、ああ神様"}, {"type": "subtitle", "time": 11608.91, "timestamp": "03:13:28", "text": "これは私が持っているような待機を意味します"}, {"type": "subtitle", "time": 11612.71, "timestamp": "03:13:32", "text": "あと1週間しかないなんて、ああ神様"}, {"type": "subtitle", "time": 11619.83, "timestamp": "03:13:39", "text": "左、ああ神様、ああ神様、蚊だ"}, {"type": "subtitle", "time": 11622.15, "timestamp": "03:13:42", "text": "痛みの種類、ああ、ここはフェイン"}, {"type": "subtitle", "time": 11625.07, "timestamp": "03:13:45", "text": "木とか色々あって"}, {"type": "subtitle", "time": 11628.71, "timestamp": "03:13:48", "text": "蚊のもう1つの場所はブルでした"}, {"type": "subtitle", "time": 11635.83, "timestamp": "03:13:55", "text": "そういえば、私は一度も"}, {"type": "subtitle", "time": 11638.309, "timestamp": "03:13:58", "text": "VCはこれまで"}]
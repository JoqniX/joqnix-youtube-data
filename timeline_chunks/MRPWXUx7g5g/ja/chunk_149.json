[{"type": "subtitle", "time": 8941.79, "timestamp": "02:29:01", "text": "電話が熱くなってきたので、"}, {"type": "subtitle", "time": 8945.75, "timestamp": "02:29:05", "text": "えーっと、自分自身に戻るように切り替えて、"}, {"type": "subtitle", "time": 8947.469, "timestamp": "02:29:07", "text": "ストリーム"}, {"type": "subtitle", "time": 8951.15, "timestamp": "02:29:11", "text": "はい、大丈夫だと言いました。ええ、私は"}, {"type": "subtitle", "time": 8954.55, "timestamp": "02:29:14", "text": "話すのは悪いことなのかどうか疑問に思う"}, {"type": "subtitle", "time": 8957.63, "timestamp": "02:29:17", "text": "聞きたいことなどについて"}, {"type": "subtitle", "time": 8961.429, "timestamp": "02:29:21", "text": "こういうもの"}, {"type": "subtitle", "time": 8964.429, "timestamp": "02:29:24", "text": "それが私が知っていることなんです"}, {"type": "subtitle", "time": 8968.59, "timestamp": "02:29:28", "text": "視聴者は、それは悪い、私の間違いだと言っています"}, {"type": "subtitle", "time": 8972.59, "timestamp": "02:29:32", "text": "えーっと、それは敬意を払わないようなもの"}, {"type": "subtitle", "time": 8974.309, "timestamp": "02:29:34", "text": "の感情"}, {"type": "subtitle", "time": 8978.269, "timestamp": "02:29:38", "text": "ストリーマーとか、CHSとか全部"}, {"type": "subtitle", "time": 8980.63, "timestamp": "02:29:40", "text": "でも、彼女は本当に落ち着いていて"}, {"type": "subtitle", "time": 8983.429, "timestamp": "02:29:43", "text": "集団で物事を体験する"}, {"type": "subtitle", "time": 8986.59, "timestamp": "02:29:46", "text": "はい、以上です"}, {"type": "subtitle", "time": 8991.309, "timestamp": "02:29:51", "text": "よかった、すべてよかった、すべてよかった"}, {"type": "subtitle", "time": 8996.309, "timestamp": "02:29:56", "text": "そして彼女はここまで来た"}, {"type": "subtitle", "time": 8999.15, "timestamp": "02:29:59", "text": "ここまで成長した、言葉は何だ"}]
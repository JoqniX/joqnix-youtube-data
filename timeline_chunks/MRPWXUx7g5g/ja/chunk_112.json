[{"type": "subtitle", "time": 6720.589, "timestamp": "01:52:00", "text": "うん、でも"}, {"type": "subtitle", "time": 6724.149, "timestamp": "01:52:04", "text": "ああ、神様、道を渡ってください、わかりません"}, {"type": "subtitle", "time": 6725.589, "timestamp": "01:52:05", "text": "なぜ私の胃は"}, {"type": "subtitle", "time": 6728.669, "timestamp": "01:52:08", "text": "歩いていたのに痛い"}, {"type": "subtitle", "time": 6738.35, "timestamp": "01:52:18", "text": "座りたい、ああ神様、そうしようと思う"}, {"type": "subtitle", "time": 6739.47, "timestamp": "01:52:19", "text": "座る"}, {"type": "subtitle", "time": 6744.27, "timestamp": "01:52:24", "text": "今日は、ああ、ああ、神様、それはとても多い"}, {"type": "subtitle", "time": 6746.55, "timestamp": "01:52:26", "text": "今日の交通量はああ"}, {"type": "subtitle", "time": 6770.589, "timestamp": "01:52:50", "text": "上へ、私は思う"}, {"type": "subtitle", "time": 6775.069, "timestamp": "01:52:55", "text": "ああ、交通渋滞に巻き込まれて、こんなこと全部起きてるの？"}, {"type": "subtitle", "time": 6777.83, "timestamp": "01:52:57", "text": "はい、まだライブ配信中です。"}]
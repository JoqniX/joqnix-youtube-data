[{"type": "subtitle", "time": 10383.229, "timestamp": "02:53:03", "text": "風が強いので、私は彼が"}, {"type": "subtitle", "time": 10385.83, "timestamp": "02:53:05", "text": "人々は渇望し、人々が話すのが好きです"}, {"type": "subtitle", "time": 10395.79, "timestamp": "02:53:15", "text": "私が疑問に思うこと"}, {"type": "subtitle", "time": 10399.87, "timestamp": "02:53:19", "text": "もし私がこのまま続けるなら"}, {"type": "subtitle", "time": 10402.63, "timestamp": "02:53:22", "text": "オーディオ"}, {"type": "subtitle", "time": 10404.99, "timestamp": "02:53:24", "text": "モノで、私は"}, {"type": "subtitle", "time": 10407.79, "timestamp": "02:53:27", "text": "それを"}, {"type": "subtitle", "time": 10409.99, "timestamp": "02:53:29", "text": "スタジオ わからない わからない"}, {"type": "subtitle", "time": 10423.99, "timestamp": "02:53:43", "text": "私の後ろにいるこれらの魚が"}, {"type": "subtitle", "time": 10425.95, "timestamp": "02:53:45", "text": "のように"}, {"type": "subtitle", "time": 10429.91, "timestamp": "02:53:49", "text": "音"}, {"type": "subtitle", "time": 10433.429, "timestamp": "02:53:53", "text": "そうです、彼女は9歳です"}, {"type": "subtitle", "time": 10436.99, "timestamp": "02:53:56", "text": "どれくらい続くかわかりません"}]
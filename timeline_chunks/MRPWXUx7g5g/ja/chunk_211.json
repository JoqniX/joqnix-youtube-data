[{"type": "subtitle", "time": 12661.83, "timestamp": "03:31:01", "text": "息子はおそらく"}, {"type": "subtitle", "time": 12669.75, "timestamp": "03:31:09", "text": "私たちはあまり話さないけど、うん"}, {"type": "subtitle", "time": 12672.429, "timestamp": "03:31:12", "text": "私たちは私はそうは思わない"}, {"type": "subtitle", "time": 12675.75, "timestamp": "03:31:15", "text": "私は彼らと仲良くしようと努力している"}, {"type": "subtitle", "time": 12678.11, "timestamp": "03:31:18", "text": "でも、そう、そして私が"}, {"type": "subtitle", "time": 12680.71, "timestamp": "03:31:20", "text": "少なくとも私を来させてくれたことに感謝している"}, {"type": "subtitle", "time": 12682.11, "timestamp": "03:31:22", "text": "へ"}, {"type": "subtitle", "time": 12685.79, "timestamp": "03:31:25", "text": "見せて、知って、私はとても幸せでした"}, {"type": "subtitle", "time": 12688.15, "timestamp": "03:31:28", "text": "良い瞬間から"}, {"type": "subtitle", "time": 12691.349, "timestamp": "03:31:31", "text": "その人は私に彼のショーを見せてくれた。"}, {"type": "subtitle", "time": 12694.83, "timestamp": "03:31:34", "text": "彼がステージに立っているのを見てとても嬉しかった"}, {"type": "subtitle", "time": 12697.95, "timestamp": "03:31:37", "text": "そして彼はかなり長い髪をしていたから"}, {"type": "subtitle", "time": 12700.269, "timestamp": "03:31:40", "text": "ヘッドバンギングをするのが好きで、彼の髪は"}, {"type": "subtitle", "time": 12704.229, "timestamp": "03:31:44", "text": "至る所に流れ込み、"}, {"type": "subtitle", "time": 12706.429, "timestamp": "03:31:46", "text": "クールだったものすべてと"}, {"type": "subtitle", "time": 12708.87, "timestamp": "03:31:48", "text": "君が使った音楽とか全部、私はこう思った"}, {"type": "subtitle", "time": 12711.59, "timestamp": "03:31:51", "text": "わあ、私もそこに行かなきゃ。"}, {"type": "subtitle", "time": 12714.03, "timestamp": "03:31:54", "text": "そのステージでの一日と"}, {"type": "subtitle", "time": 12717.55, "timestamp": "03:31:57", "text": "すべてだが、私は期待している"}]
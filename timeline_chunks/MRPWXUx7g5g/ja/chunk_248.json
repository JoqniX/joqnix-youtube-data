[{"type": "subtitle", "time": 14882.59, "timestamp": "04:08:02", "text": "最初から最後まで"}, {"type": "subtitle", "time": 14884.99, "timestamp": "04:08:04", "text": "キクヂシャ"}, {"type": "subtitle", "time": 14888.51, "timestamp": "04:08:08", "text": "始まりから終わりまで、今"}, {"type": "subtitle", "time": 14893.51, "timestamp": "04:08:13", "text": "生まれて、たくさんの写真を見て、"}, {"type": "subtitle", "time": 14897.79, "timestamp": "04:08:17", "text": "ただ親切であり続け、"}, {"type": "subtitle", "time": 14901.83, "timestamp": "04:08:21", "text": "はい、でも少し"}, {"type": "subtitle", "time": 14905.189, "timestamp": "04:08:25", "text": "ti の改善により"}, {"type": "subtitle", "time": 14907.87, "timestamp": "04:08:27", "text": "あなたが知っているような"}, {"type": "subtitle", "time": 14913.229, "timestamp": "04:08:33", "text": "人々は暑くなることがあり、非常に暑くなることがあります"}, {"type": "subtitle", "time": 14914.349, "timestamp": "04:08:34", "text": "そして"}, {"type": "subtitle", "time": 14915.95, "timestamp": "04:08:35", "text": "とても"}, {"type": "subtitle", "time": 14917.91, "timestamp": "04:08:37", "text": "えーと"}, {"type": "subtitle", "time": 14920.109, "timestamp": "04:08:40", "text": "壊れた"}, {"type": "subtitle", "time": 14924.95, "timestamp": "04:08:44", "text": "誰も人の声を聞けないよ"}, {"type": "subtitle", "time": 14928.469, "timestamp": "04:08:48", "text": "だから、彼らは対処するために強くなければならない"}, {"type": "subtitle", "time": 14931.07, "timestamp": "04:08:51", "text": "彼ら自身とすべての正しいと感じる"}, {"type": "subtitle", "time": 14933.87, "timestamp": "04:08:53", "text": "そうね、確かに"}, {"type": "subtitle", "time": 14936.83, "timestamp": "04:08:56", "text": "確かにそう思う"}]
[{"type": "subtitle", "time": 10804.63, "timestamp": "03:00:04", "text": "待って、"}, {"type": "subtitle", "time": 10806.59, "timestamp": "03:00:06", "text": "その場所で私は"}, {"type": "subtitle", "time": 10809.51, "timestamp": "03:00:09", "text": "行ってみれば暗くなるだろう、誰にもわからない"}, {"type": "subtitle", "time": 10811.07, "timestamp": "03:00:11", "text": "誰かが私を押したら何が起こるか"}, {"type": "subtitle", "time": 10814.429, "timestamp": "03:00:14", "text": "水に行きたい、SC 私の電話"}, {"type": "subtitle", "time": 10818.269, "timestamp": "03:00:18", "text": "SC のように"}, {"type": "subtitle", "time": 10820.07, "timestamp": "03:00:20", "text": "ココナッツを少し数分間"}, {"type": "subtitle", "time": 10821.83, "timestamp": "03:00:21", "text": "前"}, {"type": "subtitle", "time": 10830.55, "timestamp": "03:00:30", "text": "私にとっては良いことですが、私はあまり望んでいません"}, {"type": "subtitle", "time": 10844.429, "timestamp": "03:00:44", "text": "男"}, {"type": "subtitle", "time": 10846.71, "timestamp": "03:00:46", "text": "モバイルについてどう思いますか？"}, {"type": "subtitle", "time": 10849.349, "timestamp": "03:00:49", "text": "ストリンガーは今のところ良いですか、私は"}, {"type": "subtitle", "time": 10852.95, "timestamp": "03:00:52", "text": "これをすると何"}, {"type": "subtitle", "time": 10856.309, "timestamp": "03:00:56", "text": "大したことないと思う"}, {"type": "subtitle", "time": 10858.51, "timestamp": "03:00:58", "text": "歩いている人がいるなら、むしろいいね"}]
[{"type": "subtitle", "time": 15180.07, "timestamp": "04:13:00", "text": "これで大丈夫、私は家に帰る途中です"}, {"type": "subtitle", "time": 15182.03, "timestamp": "04:13:02", "text": "これが私が締めくくるべき道です。"}, {"type": "subtitle", "time": 15184.51, "timestamp": "04:13:04", "text": "今日戻ってきた人たちは"}, {"type": "subtitle", "time": 15187.91, "timestamp": "04:13:07", "text": "来たるクリスチャンは来たる3月のために"}, {"type": "subtitle", "time": 15189.429, "timestamp": "04:13:09", "text": "くそったれ"}, {"type": "subtitle", "time": 15197.91, "timestamp": "04:13:17", "text": "では、私が見落とした人は誰だったでしょうか？一人だけいました"}, {"type": "subtitle", "time": 15201.429, "timestamp": "04:13:21", "text": "えっと、スクロールできるか見てみましょう"}, {"type": "subtitle", "time": 15205.389, "timestamp": "04:13:25", "text": "戻る スクロールできたらいいのに"}, {"type": "subtitle", "time": 15209.63, "timestamp": "04:13:29", "text": "戻って、名前を忘れた"}, {"type": "subtitle", "time": 15214.469, "timestamp": "04:13:34", "text": "私は行けない、待って、今がその時だ"}, {"type": "subtitle", "time": 15216.349, "timestamp": "04:13:36", "text": "私はウィッシーでした"}, {"type": "subtitle", "time": 15218.55, "timestamp": "04:13:38", "text": "歩いている"}, {"type": "subtitle", "time": 15220.429, "timestamp": "04:13:40", "text": "痛みが"}, {"type": "subtitle", "time": 15223.79, "timestamp": "04:13:43", "text": "うん、そうだね"}, {"type": "subtitle", "time": 15227.99, "timestamp": "04:13:47", "text": "来てくれてありがとう"}, {"type": "subtitle", "time": 15237.51, "timestamp": "04:13:57", "text": "えっと、私は自宅でラリーです。マリンです。"}]
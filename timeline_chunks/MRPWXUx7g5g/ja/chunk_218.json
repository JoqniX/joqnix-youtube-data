[{"type": "subtitle", "time": 13093.309, "timestamp": "03:38:13", "text": "暑いけど"}, {"type": "subtitle", "time": 13096.67, "timestamp": "03:38:16", "text": "ええ、私たちはこれを知ることができます"}, {"type": "subtitle", "time": 13100.309, "timestamp": "03:38:20", "text": "10になるよ、だから少し"}, {"type": "subtitle", "time": 13103.07, "timestamp": "03:38:23", "text": "愛しているようですが、私は自分が"}, {"type": "subtitle", "time": 13105.79, "timestamp": "03:38:25", "text": "少し歩かせてもらえばいいと言える"}, {"type": "subtitle", "time": 13108.309, "timestamp": "03:38:28", "text": "なぜならそこには"}, {"type": "subtitle", "time": 13110.87, "timestamp": "03:38:30", "text": "2人の酔っ払い"}, {"type": "subtitle", "time": 13113.11, "timestamp": "03:38:33", "text": "おい、酔ってたのか？ わからないよ。"}, {"type": "subtitle", "time": 13116.67, "timestamp": "03:38:36", "text": "2 人は、私は大丈夫に住んでいます"}, {"type": "subtitle", "time": 13118.95, "timestamp": "03:38:38", "text": "まるで二人が歩いてきて"}, {"type": "subtitle", "time": 13120.95, "timestamp": "03:38:40", "text": "ベンチに向かって、文字通り"}, {"type": "subtitle", "time": 13125.07, "timestamp": "03:38:45", "text": "横に座る"}, {"type": "subtitle", "time": 13127.03, "timestamp": "03:38:47", "text": "座る場所も曲がっているような感じ"}, {"type": "subtitle", "time": 13128.83, "timestamp": "03:38:48", "text": "そして、1つは"}, {"type": "subtitle", "time": 13131.99, "timestamp": "03:38:51", "text": "端に座ったり、"}, {"type": "subtitle", "time": 13134.95, "timestamp": "03:38:54", "text": "彼らが好んで吸うものなど"}, {"type": "subtitle", "time": 13138.389, "timestamp": "03:38:58", "text": "そして私は、もし私が"}]
[{"type": "subtitle", "time": 16262.87, "timestamp": "04:31:02", "text": "b ミュート"}, {"type": "subtitle", "time": 16265.59, "timestamp": "04:31:05", "text": "それ"}, {"type": "subtitle", "time": 16269.67, "timestamp": "04:31:09", "text": "えっと、ポンが入ってきます、ポンが入ってきます、これは"}, {"type": "subtitle", "time": 16276.87, "timestamp": "04:31:16", "text": "えっと、あなたのアカを見たいです"}, {"type": "subtitle", "time": 16280.309, "timestamp": "04:31:20", "text": "統計、ああ、もちろん、もちろん、私は"}, {"type": "subtitle", "time": 16282.99, "timestamp": "04:31:22", "text": "下忍の練習をやめたのは、"}, {"type": "subtitle", "time": 16286.149, "timestamp": "04:31:26", "text": "だから私は電話に疲れ果てた"}, {"type": "subtitle", "time": 16290.349, "timestamp": "04:31:30", "text": "研磨作業を中断しなければならなかったので、ええ、ええと、マヤ"}, {"type": "subtitle", "time": 16291.189, "timestamp": "04:31:31", "text": "から"}, {"type": "subtitle", "time": 16293.389, "timestamp": "04:31:33", "text": "情報提供者によると、状況は変わったとのことです。"}, {"type": "subtitle", "time": 16296.67, "timestamp": "04:31:36", "text": "また、刃以外には特に何も付いていない"}, {"type": "subtitle", "time": 16299.229, "timestamp": "04:31:39", "text": "義務を果たす、そう、宝石商として"}, {"type": "subtitle", "time": 16301.55, "timestamp": "04:31:41", "text": "彼らは宝石を大切にする、そう、彼は私の"}, {"type": "subtitle", "time": 16303.51, "timestamp": "04:31:43", "text": "名前"}, {"type": "subtitle", "time": 16305.99, "timestamp": "04:31:45", "text": "日本語に変更するのを忘れていました"}, {"type": "subtitle", "time": 16308.71, "timestamp": "04:31:48", "text": "ダウンロードし忘れた。好きじゃない。"}, {"type": "subtitle", "time": 16311.63, "timestamp": "04:31:51", "text": "英語でプレイしているので、これが統計情報です。"}, {"type": "subtitle", "time": 16315.109, "timestamp": "04:31:55", "text": "良いアーティファクトは持っていませんし"}, {"type": "subtitle", "time": 16318.71, "timestamp": "04:31:58", "text": "いろいろあるけど、月曜日にそれらを栽培する必要がある"}]
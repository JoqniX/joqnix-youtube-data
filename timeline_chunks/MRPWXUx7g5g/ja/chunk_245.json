[{"type": "subtitle", "time": 14701.229, "timestamp": "04:05:01", "text": "私は取引すべきです"}, {"type": "subtitle", "time": 14704.83, "timestamp": "04:05:04", "text": "いくらでも構わない"}, {"type": "subtitle", "time": 14708.11, "timestamp": "04:05:08", "text": "走れ、たとえそれほど良くなくても構わない"}, {"type": "subtitle", "time": 14712.309, "timestamp": "04:05:12", "text": "わからないけど、そう言うよ"}, {"type": "subtitle", "time": 14719.229, "timestamp": "04:05:19", "text": "上へ、もしあるなら、"}, {"type": "subtitle", "time": 14720.469, "timestamp": "04:05:20", "text": "トロール"}, {"type": "subtitle", "time": 14722.99, "timestamp": "04:05:22", "text": "ストリーム ジョー ゴー オーストラリア シャワーに行く"}, {"type": "subtitle", "time": 14725.91, "timestamp": "04:05:25", "text": "そして英語を使い始める、それが"}, {"type": "subtitle", "time": 14729.79, "timestamp": "04:05:29", "text": "いいえ、私はしません"}, {"type": "subtitle", "time": 14733.67, "timestamp": "04:05:33", "text": "いや、普段私がやっていることは"}, {"type": "subtitle", "time": 14736.99, "timestamp": "04:05:36", "text": "私にはできないと分かっているが、"}, {"type": "subtitle", "time": 14739.91, "timestamp": "04:05:39", "text": "弱虫のように聞こえるか、"}, {"type": "subtitle", "time": 14742.389, "timestamp": "04:05:42", "text": "あまり敏感ではない、"}, {"type": "subtitle", "time": 14744.55, "timestamp": "04:05:44", "text": "あれだけど"}, {"type": "subtitle", "time": 14747.67, "timestamp": "04:05:47", "text": "自分のしていることに少し罪悪感を感じる"}, {"type": "subtitle", "time": 14748.95, "timestamp": "04:05:48", "text": "通常は"}, {"type": "subtitle", "time": 14754.07, "timestamp": "04:05:54", "text": "えっと、私はとても悲しいです"}, {"type": "subtitle", "time": 14754.95, "timestamp": "04:05:54", "text": "素晴らしい"}, {"type": "subtitle", "time": 14758.63, "timestamp": "04:05:58", "text": "敏感な人 1つは悲しくなる 2つは試してみる"}]
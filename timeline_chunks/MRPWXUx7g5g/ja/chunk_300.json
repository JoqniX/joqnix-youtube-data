[{"type": "subtitle", "time": 18006.67, "timestamp": "05:00:06", "text": "悪者のためにここにいる、それが我々の"}, {"type": "subtitle", "time": 18009.47, "timestamp": "05:00:09", "text": "質疑応答の時間を設ける"}, {"type": "subtitle", "time": 18020.948, "timestamp": "05:00:20", "text": "[音楽]"}, {"type": "subtitle", "time": 18022.31, "timestamp": "05:00:22", "text": "なぜそうなのか"}, {"type": "subtitle", "time": 18026.39, "timestamp": "05:00:26", "text": "昔は弦を弾いていた"}, {"type": "subtitle", "time": 18030.59, "timestamp": "05:00:30", "text": "エンジンは昔と同じように24時間稼働"}, {"type": "subtitle", "time": 18033.51, "timestamp": "05:00:33", "text": "それは私が"}, {"type": "subtitle", "time": 18036.51, "timestamp": "05:00:36", "text": "研磨を止めた、えっと"}, {"type": "subtitle", "time": 18039.788, "timestamp": "05:00:39", "text": "えっと、なんて言うんだっけ、燃え尽き症候群になった"}, {"type": "subtitle", "time": 18040.43, "timestamp": "05:00:40", "text": "の"}, {"type": "subtitle", "time": 18043.51, "timestamp": "05:00:43", "text": "ゲーム、だって私は、えーと、えーと、やってたから"}, {"type": "subtitle", "time": 18045.948, "timestamp": "05:00:45", "text": "ゲンジン配信イベントで私は"}, {"type": "subtitle", "time": 18048.708, "timestamp": "05:00:48", "text": "15時間くらいストリーミング配信して"}, {"type": "subtitle", "time": 18052.35, "timestamp": "05:00:52", "text": "イベントを配信し、36時間配信しました。"}, {"type": "subtitle", "time": 18057.51, "timestamp": "05:00:57", "text": "あの週のあの時、私を裏切った男"}]
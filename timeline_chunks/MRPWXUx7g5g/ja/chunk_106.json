[{"type": "subtitle", "time": 6360.79, "timestamp": "01:46:00", "text": "外で"}, {"type": "subtitle", "time": 6363.95, "timestamp": "01:46:03", "text": "そして、見るのが好きです"}, {"type": "subtitle", "time": 6366.229, "timestamp": "01:46:06", "text": "もし"}, {"type": "subtitle", "time": 6369.589, "timestamp": "01:46:09", "text": "M Sund のすべては py です"}, {"type": "subtitle", "time": 6372.03, "timestamp": "01:46:12", "text": "あなたに聞こえるかどうかわかりませんが、"}, {"type": "subtitle", "time": 6388.87, "timestamp": "01:46:28", "text": "私は午前8時30分にここで食事をすることができました"}, {"type": "subtitle", "time": 6390.95, "timestamp": "01:46:30", "text": "飛行機は着陸した"}, {"type": "subtitle", "time": 6397.629, "timestamp": "01:46:37", "text": "8時15分か何かで、私は"}, {"type": "subtitle", "time": 6400.51, "timestamp": "01:46:40", "text": "あなたに会うように"}, {"type": "subtitle", "time": 6404.07, "timestamp": "01:46:44", "text": "8時半頃、私が家に帰ると、彼は「こんにちは」と言いました。"}, {"type": "subtitle", "time": 6407.31, "timestamp": "01:46:47", "text": "そして彼は家に帰ってきたが、"}, {"type": "subtitle", "time": 6408.47, "timestamp": "01:46:48", "text": "のように"}, {"type": "subtitle", "time": 6412.229, "timestamp": "01:46:52", "text": "10 うん 10 11秒 うん 10:30 11秒 来たよ"}, {"type": "subtitle", "time": 6417.629, "timestamp": "01:46:57", "text": "だから私は行ける"}, {"type": "subtitle", "time": 6419.709, "timestamp": "01:46:59", "text": "それによって戻る"}]
[{"type": "subtitle", "time": 11537.19, "timestamp": "03:12:17", "text": "明日は散発的な雷雨だ、すごい"}, {"type": "subtitle", "time": 11549.71, "timestamp": "03:12:29", "text": "私はできる"}, {"type": "subtitle", "time": 11553.03, "timestamp": "03:12:33", "text": "ああ神様からチェック"}, {"type": "subtitle", "time": 11563.83, "timestamp": "03:12:43", "text": "オープンからまだライブ配信中、はい"}, {"type": "subtitle", "time": 11577.19, "timestamp": "03:12:57", "text": "明日まで29日"}]
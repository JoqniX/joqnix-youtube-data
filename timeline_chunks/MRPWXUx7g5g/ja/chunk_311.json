[{"type": "subtitle", "time": 18661.628, "timestamp": "05:11:01", "text": "そこに、そしてそれはジャングルの声のラインです。"}, {"type": "subtitle", "time": 18674.39, "timestamp": "05:11:14", "text": "どうすればいいですか？ここです。わかりました。"}, {"type": "subtitle", "time": 18678.59, "timestamp": "05:11:18", "text": "おばあちゃん、大丈夫？スタミナをつけて！"}, {"type": "subtitle", "time": 18698.43, "timestamp": "05:11:38", "text": "痛み、えっと、3つってどういう意味ですか"}, {"type": "subtitle", "time": 18700.99, "timestamp": "05:11:40", "text": "インタラクトオプション いいえ、いいえ、いいえ、ええと、その、その"}, {"type": "subtitle", "time": 18704.628, "timestamp": "05:11:44", "text": "その、その物、ルミン、ルミナル"}, {"type": "subtitle", "time": 18707.51, "timestamp": "05:11:47", "text": "スピアー"}, {"type": "subtitle", "time": 18709.708, "timestamp": "05:11:49", "text": "物"}, {"type": "subtitle", "time": 18713.75, "timestamp": "05:11:53", "text": "やっとリラックスできたよ、わかった、わかった"}, {"type": "subtitle", "time": 18716.47, "timestamp": "05:11:56", "text": "了解、了解、マー・マーク"}, {"type": "subtitle", "time": 18719.868, "timestamp": "05:11:59", "text": "ピン オーケー いいよ いいよ いいよ 全部手に入れたよ"}]
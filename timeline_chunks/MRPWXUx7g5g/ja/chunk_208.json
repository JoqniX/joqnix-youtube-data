[{"type": "subtitle", "time": 12481.91, "timestamp": "03:28:01", "text": "お金のこととなると、本当にしつこい"}, {"type": "subtitle", "time": 12483.87, "timestamp": "03:28:03", "text": "彼は私に私の"}, {"type": "subtitle", "time": 12487.63, "timestamp": "03:28:07", "text": "20,000 いいね、私のお金を 20,000 のようにくれました"}, {"type": "subtitle", "time": 12490.349, "timestamp": "03:28:10", "text": "毎月とかそういうのだよね、そうだったっけ？"}, {"type": "subtitle", "time": 12495.11, "timestamp": "03:28:15", "text": "20 いやいや、でも C 全体が"}, {"type": "subtitle", "time": 12498.63, "timestamp": "03:28:18", "text": "20歳で、父と息子は"}, {"type": "subtitle", "time": 12502.309, "timestamp": "03:28:22", "text": "それを送っているのは、またそれが"}, {"type": "subtitle", "time": 12505.07, "timestamp": "03:28:25", "text": "当時、私たちは同様の問題を抱えていました"}, {"type": "subtitle", "time": 12507.99, "timestamp": "03:28:27", "text": "お金を持って家に帰ると、"}, {"type": "subtitle", "time": 12510.269, "timestamp": "03:28:30", "text": "それでも彼は、どうやってそうなったのかはわかりません"}, {"type": "subtitle", "time": 12514.99, "timestamp": "03:28:34", "text": "お金だけど、そう、彼がやったP PAP"}, {"type": "subtitle", "time": 12518.55, "timestamp": "03:28:38", "text": "彼の息子のために私はこう思った、そしてその男は"}, {"type": "subtitle", "time": 12521.07, "timestamp": "03:28:41", "text": "まさにピストだった"}, {"type": "subtitle", "time": 12523.55, "timestamp": "03:28:43", "text": "お金をくれ、お金をくれ"}, {"type": "subtitle", "time": 12525.79, "timestamp": "03:28:45", "text": "そして、私が欲しいものは、テオネL、あなたが私にくれる"}, {"type": "subtitle", "time": 12529.83, "timestamp": "03:28:49", "text": "お金とか色々あるんだけど、おいおい、来いよ"}, {"type": "subtitle", "time": 12533.75, "timestamp": "03:28:53", "text": "その人が言った私の父が言った"}, {"type": "subtitle", "time": 12538.79, "timestamp": "03:28:58", "text": "彼がお金をくれるなんて、そんなことはないよ"}]
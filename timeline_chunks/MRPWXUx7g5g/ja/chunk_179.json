[{"type": "subtitle", "time": 10748.349, "timestamp": "02:59:08", "text": "私は文字通り働きません"}, {"type": "subtitle", "time": 10767.75, "timestamp": "02:59:27", "text": "もっと"}, {"type": "subtitle", "time": 10771.55, "timestamp": "02:59:31", "text": "SEはもうあまり残っていないと思うよ"}, {"type": "subtitle", "time": 10774.389, "timestamp": "02:59:34", "text": "私が何をするかは、何かを手に入れるだけです"}, {"type": "subtitle", "time": 10778.229, "timestamp": "02:59:38", "text": "飲み物を飲んで、座る場所を探すよ"}, {"type": "subtitle", "time": 10781.19, "timestamp": "02:59:41", "text": "下へ降りて、それから歩いて家に帰るかな"}, {"type": "subtitle", "time": 10784.229, "timestamp": "02:59:44", "text": "その代わりに私たちがやったことは文字通り"}, {"type": "subtitle", "time": 10787.15, "timestamp": "02:59:47", "text": "私たちは何かを死に、まるで私たちが歩いたように"}, {"type": "subtitle", "time": 10793.87, "timestamp": "02:59:53", "text": "それ"}, {"type": "subtitle", "time": 10796.11, "timestamp": "02:59:56", "text": "私は"}]
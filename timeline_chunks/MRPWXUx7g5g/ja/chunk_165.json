[{"type": "subtitle", "time": 9904.51, "timestamp": "02:45:04", "text": "まるで私が早歩きしているかのように速い"}, {"type": "subtitle", "time": 9925.429, "timestamp": "02:45:25", "text": "しかし、私が気づいたことが一つあります"}, {"type": "subtitle", "time": 9928.389, "timestamp": "02:45:28", "text": "多くの人がまさに"}, {"type": "subtitle", "time": 9930.95, "timestamp": "02:45:30", "text": "私はストリームをやっているのが好きです"}, {"type": "subtitle", "time": 9934.309, "timestamp": "02:45:34", "text": "これとか、そう、こういうストリーム"}, {"type": "subtitle", "time": 9936.79, "timestamp": "02:45:36", "text": "一般の人、あるいは私の"}, {"type": "subtitle", "time": 9937.99, "timestamp": "02:45:37", "text": "趣味"}, {"type": "subtitle", "time": 9941.23, "timestamp": "02:45:41", "text": "彼らはこの主要なことを尋ねています"}, {"type": "subtitle", "time": 9944.55, "timestamp": "02:45:44", "text": "質問：全資産のうち、いくら所有していますか？"}, {"type": "subtitle", "time": 9947.75, "timestamp": "02:45:47", "text": "これはとても多くのことをしていて、すべてであり、"}, {"type": "subtitle", "time": 9955.15, "timestamp": "02:45:55", "text": "私は何も知らない"}, {"type": "subtitle", "time": 9956.429, "timestamp": "02:45:56", "text": "それはもっと"}]
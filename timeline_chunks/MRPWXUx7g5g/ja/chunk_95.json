[{"type": "subtitle", "time": 5705.39, "timestamp": "01:35:05", "text": "うん"}, {"type": "subtitle", "time": 5708.51, "timestamp": "01:35:08", "text": "とにかく寝る時間なのに、まだ寝てる"}, {"type": "subtitle", "time": 5737.27, "timestamp": "01:35:37", "text": "そして"}, {"type": "subtitle", "time": 5746.47, "timestamp": "01:35:46", "text": "睡眠不足の騎手を見てください。こんにちは、私はジョーです。"}, {"type": "subtitle", "time": 5748.31, "timestamp": "01:35:48", "text": "私はスポーツマンです"}, {"type": "subtitle", "time": 5754.03, "timestamp": "01:35:54", "text": "次は、ちょっと待って、これをコピーしてください"}]
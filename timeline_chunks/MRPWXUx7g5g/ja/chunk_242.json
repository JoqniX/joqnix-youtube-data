[{"type": "subtitle", "time": 14523.149, "timestamp": "04:02:03", "text": "私は、完全に切り離したときにB"}, {"type": "subtitle", "time": 14526.229, "timestamp": "04:02:06", "text": "なぜなら、ほとんどの場合私は"}, {"type": "subtitle", "time": 14530.67, "timestamp": "04:02:10", "text": "たくさん泣いて、"}, {"type": "subtitle", "time": 14534.389, "timestamp": "04:02:14", "text": "バックハム、私は彼らのところに戻って謝罪します"}, {"type": "subtitle", "time": 14539.229, "timestamp": "04:02:19", "text": "最初はそうだったけど、今回は私がそれを取ったと思う"}, {"type": "subtitle", "time": 14542.149, "timestamp": "04:02:22", "text": "ギャリー、そう、文字通り私が取ったんだ"}, {"type": "subtitle", "time": 14544.79, "timestamp": "04:02:24", "text": "個人的にも"}, {"type": "subtitle", "time": 14547.67, "timestamp": "04:02:27", "text": "私は文字通りそれを受け取った"}, {"type": "subtitle", "time": 14549.63, "timestamp": "04:02:29", "text": "のために"}, {"type": "subtitle", "time": 14553.71, "timestamp": "04:02:33", "text": "悪い気分にはならなかったし、ただ誇りに思った。"}, {"type": "subtitle", "time": 14555.79, "timestamp": "04:02:35", "text": "そこにいた2人でさえ"}, {"type": "subtitle", "time": 14558.429, "timestamp": "04:02:38", "text": "彼らは私にもそう感じたと言った"}, {"type": "subtitle", "time": 14563.309, "timestamp": "04:02:43", "text": "ジョッキー、君が成長したことを誇りに思うよ"}, {"type": "subtitle", "time": 14566.71, "timestamp": "04:02:46", "text": "あなたはとても一歩踏み出しました。"}, {"type": "subtitle", "time": 14570.67, "timestamp": "04:02:50", "text": "あなたはこのようなことをもっと処理し、"}, {"type": "subtitle", "time": 14572.55, "timestamp": "04:02:52", "text": "もっと"}, {"type": "subtitle", "time": 14577.83, "timestamp": "04:02:57", "text": "この間、制約されているようにはならない"}]
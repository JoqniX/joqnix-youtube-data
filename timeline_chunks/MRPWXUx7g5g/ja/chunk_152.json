[{"type": "subtitle", "time": 9127.75, "timestamp": "02:32:07", "text": "しばらく座るべき側"}, {"type": "subtitle", "time": 9136.59, "timestamp": "02:32:16", "text": "うん、Cランクのプレイヤーがたくさんいるよ"}, {"type": "subtitle", "time": 9139.309, "timestamp": "02:32:19", "text": "そしてフットボールやその他すべて"}, {"type": "subtitle", "time": 9140.51, "timestamp": "02:32:20", "text": "人々"}, {"type": "subtitle", "time": 9142.75, "timestamp": "02:32:22", "text": "寒くて、"}, {"type": "subtitle", "time": 9145.07, "timestamp": "02:32:25", "text": "ああ"}, {"type": "subtitle", "time": 9154.79, "timestamp": "02:32:34", "text": "背中が背中を感じる、私の背中は"}, {"type": "subtitle", "time": 9158.11, "timestamp": "02:32:38", "text": "文字通り、私の"}, {"type": "subtitle", "time": 9160.07, "timestamp": "02:32:40", "text": "背中が汗ばんでいる"}, {"type": "subtitle", "time": 9163.469, "timestamp": "02:32:43", "text": "家に帰らなきゃ"}, {"type": "subtitle", "time": 9166.11, "timestamp": "02:32:46", "text": "いくつかありますが、詳細を長く取るべきか、"}, {"type": "subtitle", "time": 9169.349, "timestamp": "02:32:49", "text": "今日は歩かない方がいいかな、みたいな感じ"}, {"type": "subtitle", "time": 9171.389, "timestamp": "02:32:51", "text": "錆びたような、座っているような"}, {"type": "subtitle", "time": 9174.03, "timestamp": "02:32:54", "text": "どこかで"}, {"type": "subtitle", "time": 9177.11, "timestamp": "02:32:57", "text": "散歩する代わりに、リラックスしている気分です"}, {"type": "subtitle", "time": 9179.309, "timestamp": "02:32:59", "text": "当然そうすべきだ"}]
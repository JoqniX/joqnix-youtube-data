[{"type": "subtitle", "time": 14041.91, "timestamp": "03:54:01", "text": "いいよ、元カレが可愛いかどうかはわからないけど"}, {"type": "subtitle", "time": 14056.87, "timestamp": "03:54:16", "text": "もし私が"}, {"type": "subtitle", "time": 14059.07, "timestamp": "03:54:19", "text": "ホームレスになったら、"}, {"type": "subtitle", "time": 14065.269, "timestamp": "03:54:25", "text": "こんな考えが浮かぶなんて"}, {"type": "subtitle", "time": 14066.149, "timestamp": "03:54:26", "text": "神様、私は"}, {"type": "subtitle", "time": 14079.469, "timestamp": "03:54:39", "text": "ええ、でも、あなたの言う通り、私は"}, {"type": "subtitle", "time": 14084.59, "timestamp": "03:54:44", "text": "私の親友2人について話している"}, {"type": "subtitle", "time": 14086.59, "timestamp": "03:54:46", "text": "私たちが来たとき"}, {"type": "subtitle", "time": 14088.87, "timestamp": "03:54:48", "text": "ストリーミング配信は他の2つと同じようなものだった"}, {"type": "subtitle", "time": 14090.99, "timestamp": "03:54:50", "text": "ゲームを使っていた友達も"}, {"type": "subtitle", "time": 14093.309, "timestamp": "03:54:53", "text": "彼らはクラスメートのような存在で、"}, {"type": "subtitle", "time": 14096.469, "timestamp": "03:54:56", "text": "私たちが抜け出したものは、"}, {"type": "subtitle", "time": 14099.75, "timestamp": "03:54:59", "text": "友情だったけど、そうしなかったのは私だった"}]
[{"type": "subtitle", "time": 11465.11, "timestamp": "03:11:05", "text": "海が動いている、買いがある"}, {"type": "subtitle", "time": 11487.55, "timestamp": "03:11:27", "text": "そう、私がフランス語を話すときのように"}, {"type": "subtitle", "time": 11490.309, "timestamp": "03:11:30", "text": "私がフランス語を言うと、私の知り合いはみんな"}, {"type": "subtitle", "time": 11494.229, "timestamp": "03:11:34", "text": "友達の権利には、次のようなものも含まれます。"}, {"type": "subtitle", "time": 11497.229, "timestamp": "03:11:37", "text": "知り合い 知り合い 知らない"}, {"type": "subtitle", "time": 11499.15, "timestamp": "03:11:39", "text": "知り合いと呼ぶ方がより"}, {"type": "subtitle", "time": 11502.11, "timestamp": "03:11:42", "text": "私は彼らを友達と呼ぶ、なぜなら私は"}, {"type": "subtitle", "time": 11507.51, "timestamp": "03:11:47", "text": "知り合いとして見ない"}, {"type": "subtitle", "time": 11509.429, "timestamp": "03:11:49", "text": "友達というよりみんな"}, {"type": "subtitle", "time": 11517.99, "timestamp": "03:11:57", "text": "ストリーム"}, {"type": "subtitle", "time": 11519.27, "timestamp": "03:11:59", "text": "ストリーミング"}]
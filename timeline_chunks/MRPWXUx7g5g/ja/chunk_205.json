[{"type": "subtitle", "time": 12303.59, "timestamp": "03:25:03", "text": "でも、あの、ご存知の通り"}, {"type": "subtitle", "time": 12306.71, "timestamp": "03:25:06", "text": "ああ、それは花火だ。とてもかわいい。"}, {"type": "subtitle", "time": 12308.389, "timestamp": "03:25:08", "text": "それで、起こったことの一つは"}, {"type": "subtitle", "time": 12310.71, "timestamp": "03:25:10", "text": "私たちは、私が自分のことを知っていたので、"}, {"type": "subtitle", "time": 12313.87, "timestamp": "03:25:13", "text": "両親はとても音楽店に行きました"}, {"type": "subtitle", "time": 12318.469, "timestamp": "03:25:18", "text": "W、そしてなんと店主が"}, {"type": "subtitle", "time": 12320.87, "timestamp": "03:25:20", "text": "そしてスタッフや従業員のように"}, {"type": "subtitle", "time": 12323.269, "timestamp": "03:25:23", "text": "そこで彼らは文字通り私を嘲笑したので"}, {"type": "subtitle", "time": 12327.429, "timestamp": "03:25:27", "text": "私は他の場所で好きだったから、とても良かった"}, {"type": "subtitle", "time": 12330.189, "timestamp": "03:25:30", "text": "人々の目はまるで小さな子供のようだった"}, {"type": "subtitle", "time": 12334.189, "timestamp": "03:25:34", "text": "レルが小さくて、"}, {"type": "subtitle", "time": 12336.71, "timestamp": "03:25:36", "text": "いろいろなことがあったが、彼らはそれについて考えなかった"}, {"type": "subtitle", "time": 12339.309, "timestamp": "03:25:39", "text": "彼らはこう言うんだ。「ああ、これはこれだ」"}, {"type": "subtitle", "time": 12341.429, "timestamp": "03:25:41", "text": "プロのスタジオで使用されているもの"}, {"type": "subtitle", "time": 12343.75, "timestamp": "03:25:43", "text": "人々とすべてはこれはそうではない"}, {"type": "subtitle", "time": 12345.95, "timestamp": "03:25:45", "text": "子供たちが遊ぶべきもの、そして彼が店"}, {"type": "subtitle", "time": 12349.189, "timestamp": "03:25:49", "text": "文字通り指さして取り出した"}, {"type": "subtitle", "time": 12353.429, "timestamp": "03:25:53", "text": "カシオのようなおもちゃのようなおもちゃのピアノと"}, {"type": "subtitle", "time": 12355.51, "timestamp": "03:25:55", "text": "私は"}, {"type": "subtitle", "time": 12358.75, "timestamp": "03:25:58", "text": "おい、冗談だろ？ふざけてんのか？"}]
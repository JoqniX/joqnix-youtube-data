[{"type": "subtitle", "time": 5044.75, "timestamp": "01:24:04", "text": "いいね、試してみるよ、やってみるよ"}, {"type": "subtitle", "time": 5047.83, "timestamp": "01:24:07", "text": "後でボイスチェンジャーを使いますか？いいえ"}, {"type": "subtitle", "time": 5050.27, "timestamp": "01:24:10", "text": "それは私の本当の"}, {"type": "subtitle", "time": 5052.95, "timestamp": "01:24:12", "text": "声、それが私の本当の声、唯一の"}, {"type": "subtitle", "time": 5055.91, "timestamp": "01:24:15", "text": "私のオーディオセットアップにあるものは"}, {"type": "subtitle", "time": 5057.39, "timestamp": "01:24:17", "text": "騒音"}, {"type": "subtitle", "time": 5060.149, "timestamp": "01:24:20", "text": "抑圧と"}, {"type": "subtitle", "time": 5062.229, "timestamp": "01:24:22", "text": "コンプレッサーのノイズ動作"}, {"type": "subtitle", "time": 5064.91, "timestamp": "01:24:24", "text": "コンプレッサー、それだけです、明らかなエリートI"}, {"type": "subtitle", "time": 5067.03, "timestamp": "01:24:27", "text": "オーディオを実行する"}, {"type": "subtitle", "time": 5070.87, "timestamp": "01:24:30", "text": "普遍的に、つまり同じことです"}, {"type": "subtitle", "time": 5073.629, "timestamp": "01:24:33", "text": "騒音のように欲しかった"}, {"type": "subtitle", "time": 5075.669, "timestamp": "01:24:35", "text": "Discord に抑圧があり、"}, {"type": "subtitle", "time": 5078.99, "timestamp": "01:24:38", "text": "他のゲームも全部実行します"}, {"type": "subtitle", "time": 5086.109, "timestamp": "01:24:46", "text": "普遍的に、ええ、それは"}, {"type": "subtitle", "time": 5095.75, "timestamp": "01:24:55", "text": "チェンジャー 下げ方すらわからない"}, {"type": "subtitle", "time": 5099.51, "timestamp": "01:24:59", "text": "私の声、低音ボイスの出し方"}]
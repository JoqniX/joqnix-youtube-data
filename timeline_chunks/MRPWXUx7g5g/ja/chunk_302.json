[{"type": "subtitle", "time": 18121.868, "timestamp": "05:02:01", "text": "牛乳ができたので、それを注ぎます"}, {"type": "subtitle", "time": 18124.47, "timestamp": "05:02:04", "text": "後で私の"}, {"type": "subtitle", "time": 18126.868, "timestamp": "05:02:06", "text": "申し訳ありません。水はたくさんあります。"}, {"type": "subtitle", "time": 18130.43, "timestamp": "05:02:10", "text": "炎の暗いトラック J に十分な"}, {"type": "subtitle", "time": 18136.788, "timestamp": "05:02:16", "text": "パーティーで、あなたたちは本当に火事を考えているのですか？"}, {"type": "subtitle", "time": 18139.83, "timestamp": "05:02:19", "text": "水はパーティーの定番になる"}, {"type": "subtitle", "time": 18151.548, "timestamp": "05:02:31", "text": "私は何を共有しようとしているのか、そして"}, {"type": "subtitle", "time": 18154.708, "timestamp": "05:02:34", "text": "沈黙にこの煙が"}, {"type": "subtitle", "time": 18159.948, "timestamp": "05:02:39", "text": "ハンドブックにはそれが終わりだと書いてある。私はただそれをするだけだ"}, {"type": "subtitle", "time": 18166.51, "timestamp": "05:02:46", "text": "上級チームハンドブック"}, {"type": "subtitle", "time": 18168.51, "timestamp": "05:02:48", "text": "見習い"}, {"type": "subtitle", "time": 18172.19, "timestamp": "05:02:52", "text": "44 条 32 食べ物を共有するまで"}, {"type": "subtitle", "time": 18174.59, "timestamp": "05:02:54", "text": "適切なタイミングは静寂につながる"}, {"type": "subtitle", "time": 18177.548, "timestamp": "05:02:57", "text": "好奇心モード"}, {"type": "subtitle", "time": 18179.948, "timestamp": "05:02:59", "text": "ようこそ、誠意って感じですね"}]
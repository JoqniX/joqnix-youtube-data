[{"type": "subtitle", "time": 6901.47, "timestamp": "01:55:01", "text": "水、私の水、それはジョニーみたい"}, {"type": "subtitle", "time": 6904.03, "timestamp": "01:55:04", "text": "手に入れば買える"}, {"type": "subtitle", "time": 6905.149, "timestamp": "01:55:05", "text": "何か"}, {"type": "subtitle", "time": 6907.35, "timestamp": "01:55:07", "text": "もし私が飲んだら"}, {"type": "subtitle", "time": 6910.189, "timestamp": "01:55:10", "text": "私はこう思うだろう、なぜなら私は"}, {"type": "subtitle", "time": 6912.43, "timestamp": "01:55:12", "text": "たくさん話すから、2時間かかるんだよね"}, {"type": "subtitle", "time": 6914.51, "timestamp": "01:55:14", "text": "私は推測する"}, {"type": "subtitle", "time": 6919.43, "timestamp": "01:55:19", "text": "だから、私は彼らを救出するために行くべきでしょうか"}, {"type": "subtitle", "time": 6941.99, "timestamp": "01:55:41", "text": "大丈夫、家に帰るよ"}, {"type": "subtitle", "time": 6943.47, "timestamp": "01:55:43", "text": "すべて入手"}, {"type": "subtitle", "time": 6947.47, "timestamp": "01:55:47", "text": "ああ神様、これは初めてです"}, {"type": "subtitle", "time": 6948.74, "timestamp": "01:55:48", "text": "時間"}, {"type": "subtitle", "time": 6950.51, "timestamp": "01:55:50", "text": "[音楽]"}]
[{"type": "subtitle", "time": 12121.429, "timestamp": "03:22:01", "text": "そして最後に最も重要なこと"}, {"type": "subtitle", "time": 12123.229, "timestamp": "03:22:03", "text": "主なことは、"}, {"type": "subtitle", "time": 12125.189, "timestamp": "03:22:05", "text": "家族"}, {"type": "subtitle", "time": 12128.83, "timestamp": "03:22:08", "text": "少なくとも、えっと"}, {"type": "subtitle", "time": 12132.309, "timestamp": "03:22:12", "text": "うんうん、まるで"}, {"type": "subtitle", "time": 12134.229, "timestamp": "03:22:14", "text": "私の家族が"}, {"type": "subtitle", "time": 12138.71, "timestamp": "03:22:18", "text": "お金とかそういうのだけど、うん"}, {"type": "subtitle", "time": 12141.269, "timestamp": "03:22:21", "text": "どうすればいいのかわからない"}, {"type": "subtitle", "time": 12144.469, "timestamp": "03:22:24", "text": "わがままでいいなら、"}, {"type": "subtitle", "time": 12147.71, "timestamp": "03:22:27", "text": "長年にわたって、私は"}, {"type": "subtitle", "time": 12149.63, "timestamp": "03:22:29", "text": "知らせ"}, {"type": "subtitle", "time": 12152.03, "timestamp": "03:22:32", "text": "そこに、あの時、あそこに"}, {"type": "subtitle", "time": 12154.389, "timestamp": "03:22:34", "text": "少しのお金を受け取ったとき、"}, {"type": "subtitle", "time": 12155.63, "timestamp": "03:22:35", "text": "私が使ったもの"}, {"type": "subtitle", "time": 12159.07, "timestamp": "03:22:39", "text": "自分のために何か手に入れて、"}, {"type": "subtitle", "time": 12163.51, "timestamp": "03:22:43", "text": "以前は半分くらいをシェアしていました"}, {"type": "subtitle", "time": 12164.99, "timestamp": "03:22:44", "text": "私が好きではないもの"}, {"type": "subtitle", "time": 12167.51, "timestamp": "03:22:47", "text": "家族、そう、私が"}, {"type": "subtitle", "time": 12170.75, "timestamp": "03:22:50", "text": "できたかもしれないが、そうすべきではないと理解していた"}, {"type": "subtitle", "time": 12174.11, "timestamp": "03:22:54", "text": "知ってるでしょ、もしあなたが"}, {"type": "subtitle", "time": 12175.91, "timestamp": "03:22:55", "text": "報酬を受け取ったり、実際に受け取るべきもの"}, {"type": "subtitle", "time": 12179.429, "timestamp": "03:22:59", "text": "寛大な権利を与え、それを返します"}]
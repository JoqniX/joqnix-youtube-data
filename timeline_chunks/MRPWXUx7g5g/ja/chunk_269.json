[{"type": "subtitle", "time": 16141.349, "timestamp": "04:29:01", "text": "説明には書いていませんが"}, {"type": "subtitle", "time": 16145.469, "timestamp": "04:29:05", "text": "痛いけど、ギルドギルダを使うなら"}, {"type": "subtitle", "time": 16148.469, "timestamp": "04:29:08", "text": "次回のTCHにぜひご参加ください。ご家族でお越しください。"}, {"type": "subtitle", "time": 16152.71, "timestamp": "04:29:12", "text": "家族はみんな正しいと思うけど、私はえーっと"}, {"type": "subtitle", "time": 16155.429, "timestamp": "04:29:15", "text": "スケジュール上の都合を利用して"}, {"type": "subtitle", "time": 16158.189, "timestamp": "04:29:18", "text": "カレンダーみたいなのもすごくクール"}, {"type": "subtitle", "time": 16166.389, "timestamp": "04:29:26", "text": "こんにちは、とにかく、次に進みましょう"}, {"type": "subtitle", "time": 16168.87, "timestamp": "04:29:28", "text": "ゲーム"}, {"type": "subtitle", "time": 16171.349, "timestamp": "04:29:31", "text": "はい、聞こえたら教えてください"}, {"type": "subtitle", "time": 16174.87, "timestamp": "04:29:34", "text": "ゲームと昨日の配信中に私は"}, {"type": "subtitle", "time": 16177.389, "timestamp": "04:29:37", "text": "あらゆるものを編集してぼかしていた"}, {"type": "subtitle", "time": 16180.79, "timestamp": "04:29:40", "text": "それは私が自分自身にしていることです。そうです、DMSと"}, {"type": "subtitle", "time": 16182.79, "timestamp": "04:29:42", "text": "メール"}, {"type": "subtitle", "time": 16185.189, "timestamp": "04:29:45", "text": "はい、気づきました"}, {"type": "subtitle", "time": 16188.87, "timestamp": "04:29:48", "text": "背景の雑音は"}, {"type": "subtitle", "time": 16192.309, "timestamp": "04:29:52", "text": "VCプレーヤーの音量を低くして、"}, {"type": "subtitle", "time": 16197.55, "timestamp": "04:29:57", "text": "20% ほとんど聞こえなかった"}]
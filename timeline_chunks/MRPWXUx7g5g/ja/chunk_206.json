[{"type": "subtitle", "time": 12361.83, "timestamp": "03:26:01", "text": "今、私は本当に真剣で、"}, {"type": "subtitle", "time": 12364.429, "timestamp": "03:26:04", "text": "わかった、私は良いことをしているわけではない"}, {"type": "subtitle", "time": 12366.91, "timestamp": "03:26:06", "text": "音楽から、"}, {"type": "subtitle", "time": 12369.389, "timestamp": "03:26:09", "text": "スタジオと私が入れたものすべて"}, {"type": "subtitle", "time": 12372.429, "timestamp": "03:26:12", "text": "毎日時間と物があり、"}, {"type": "subtitle", "time": 12376.389, "timestamp": "03:26:16", "text": "K、私はその日すごく泣いたよ"}, {"type": "subtitle", "time": 12379.389, "timestamp": "03:26:19", "text": "そして世界がどのように機能するのかを理解する"}, {"type": "subtitle", "time": 12381.469, "timestamp": "03:26:21", "text": "また、後になって私は"}, {"type": "subtitle", "time": 12383.79, "timestamp": "03:26:23", "text": "私の両親が理解できると思った"}, {"type": "subtitle", "time": 12387.03, "timestamp": "03:26:27", "text": "買えなかったし、物と"}, {"type": "subtitle", "time": 12389.15, "timestamp": "03:26:29", "text": "彼らはそれを"}, {"type": "subtitle", "time": 12392.63, "timestamp": "03:26:32", "text": "悪い買い物か何かみたい"}, {"type": "subtitle", "time": 12394.79, "timestamp": "03:26:34", "text": "良い買い物でなければならないことは分かっている"}, {"type": "subtitle", "time": 12395.51, "timestamp": "03:26:35", "text": "しかし"}, {"type": "subtitle", "time": 12398.469, "timestamp": "03:26:38", "text": "また、多くの失敗買い物もあった。"}, {"type": "subtitle", "time": 12401.87, "timestamp": "03:26:41", "text": "あなたが追いかけるお金から私のお金"}, {"type": "subtitle", "time": 12405.229, "timestamp": "03:26:45", "text": "自分のものに関しては"}, {"type": "subtitle", "time": 12408.95, "timestamp": "03:26:48", "text": "私がDJingを学んだペントファミリー"}, {"type": "subtitle", "time": 12412.15, "timestamp": "03:26:52", "text": "しかし私はそれが古いものになった"}, {"type": "subtitle", "time": 12415.51, "timestamp": "03:26:55", "text": "ビニールタイプのターンテーブルが1台あるのですが、本当に"}, {"type": "subtitle", "time": 12419.51, "timestamp": "03:26:59", "text": "C DJsのようにリア王のようにプレイしたかった"}]
[{"type": "subtitle", "time": 6840.47, "timestamp": "01:54:00", "text": "今日は何もかも忘れてしまった。ああ、"}, {"type": "subtitle", "time": 6844.189, "timestamp": "01:54:04", "text": "ああ、なんてことだ、忘れてた"}, {"type": "subtitle", "time": 6847.87, "timestamp": "01:54:07", "text": "私は戻って取りに行くべきでしょうか、私はすでに"}, {"type": "subtitle", "time": 6850.669, "timestamp": "01:54:10", "text": "遠くから見ると私はそうは思わない"}, {"type": "subtitle", "time": 6852.02, "timestamp": "01:54:12", "text": "すべき"}, {"type": "subtitle", "time": 6858.03, "timestamp": "01:54:18", "text": "ああ"}, {"type": "subtitle", "time": 6877.75, "timestamp": "01:54:37", "text": "はい、表示します"}, {"type": "subtitle", "time": 6880.39, "timestamp": "01:54:40", "text": "オーケー、ただのシ"}, {"type": "subtitle", "time": 6883.99, "timestamp": "01:54:43", "text": "仕事、うん、それはそうだろうね、ちょっと待って、私は"}, {"type": "subtitle", "time": 6886.149, "timestamp": "01:54:46", "text": "したい"}, {"type": "subtitle", "time": 6890.229, "timestamp": "01:54:50", "text": "考えてみると、私は行くべきでしょうか"}, {"type": "subtitle", "time": 6893.95, "timestamp": "01:54:53", "text": "私は自分のものを取りに行くべきです"}]
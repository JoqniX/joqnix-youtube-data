[{"type": "subtitle", "time": 11404.19, "timestamp": "03:10:04", "text": "たくさん飲んで食べるのは良くない"}, {"type": "subtitle", "time": 11407.75, "timestamp": "03:10:07", "text": "いいですね、そうです、それは良いことです"}, {"type": "subtitle", "time": 11410.51, "timestamp": "03:10:10", "text": "確かに、最近は"}, {"type": "subtitle", "time": 11412.429, "timestamp": "03:10:12", "text": "まるで革新的な方法で、私は"}, {"type": "subtitle", "time": 11425.389, "timestamp": "03:10:25", "text": "のように"}, {"type": "subtitle", "time": 11428.269, "timestamp": "03:10:28", "text": "私が飲んでいるのは古いボトルです"}, {"type": "subtitle", "time": 11430.349, "timestamp": "03:10:30", "text": "今夜はああ"}, {"type": "subtitle", "time": 11433.99, "timestamp": "03:10:33", "text": "神様、これは取り消せないと思う"}, {"type": "subtitle", "time": 11437.63, "timestamp": "03:10:37", "text": "家はむしろ"}, {"type": "subtitle", "time": 11441.349, "timestamp": "03:10:41", "text": "えっと、取り消したいんだけど"}, {"type": "subtitle", "time": 11459.95, "timestamp": "03:10:59", "text": "私は文字通りそこに立っています"}]
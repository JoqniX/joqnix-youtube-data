[{"type": "subtitle", "time": 13261.75, "timestamp": "03:41:01", "text": "ボトルは30ルピアだったと思う。"}, {"type": "subtitle", "time": 13264.63, "timestamp": "03:41:04", "text": "私が200ドル渡したのに、彼らは100ドルしかくれなかった。"}, {"type": "subtitle", "time": 13266.349, "timestamp": "03:41:06", "text": "そして何か何か私は知らない、私はしなかった"}, {"type": "subtitle", "time": 13269.469, "timestamp": "03:41:09", "text": "ちょっとだけその物を見て"}, {"type": "subtitle", "time": 13292.429, "timestamp": "03:41:32", "text": "GUもそのことを楽しんでいる"}, {"type": "subtitle", "time": 13295.429, "timestamp": "03:41:35", "text": "なぜみんなが"}, {"type": "subtitle", "time": 13299.75, "timestamp": "03:41:39", "text": "これは、毎回人々が"}, {"type": "subtitle", "time": 13306.469, "timestamp": "03:41:46", "text": "割れるようなことをする"}, {"type": "subtitle", "time": 13310.469, "timestamp": "03:41:50", "text": "大きく見える彼は座ってやっていたが、私は"}]
[{"type": "subtitle", "time": 9661.91, "timestamp": "02:41:01", "text": "それは本当に深刻なことだったが"}, {"type": "subtitle", "time": 9674.83, "timestamp": "02:41:14", "text": "上にはかなりたくさんあります"}, {"type": "subtitle", "time": 9678.15, "timestamp": "02:41:18", "text": "mus でも、こうしてここに出てくるのは"}, {"type": "subtitle", "time": 9679.91, "timestamp": "02:41:19", "text": "楽しい"}, {"type": "subtitle", "time": 9681.65, "timestamp": "02:41:21", "text": "これは"}, {"type": "subtitle", "time": 9683.389, "timestamp": "02:41:23", "text": "[音楽]"}, {"type": "subtitle", "time": 9686.71, "timestamp": "02:41:26", "text": "リラックスして気づいたことが一つあります"}, {"type": "subtitle", "time": 9690.59, "timestamp": "02:41:30", "text": "その場所全体が右に動いている"}, {"type": "subtitle", "time": 9692.15, "timestamp": "02:41:32", "text": "私にはかなり多くのものがあります"}, {"type": "subtitle", "time": 9693.15, "timestamp": "02:41:33", "text": "心配した"}, {"type": "subtitle", "time": 9696.469, "timestamp": "02:41:36", "text": "それはむしろ"}, {"type": "subtitle", "time": 9698.71, "timestamp": "02:41:38", "text": "プライバシーはいいえ、私は自分のプライバシーを得ますが"}, {"type": "subtitle", "time": 9709.429, "timestamp": "02:41:49", "text": "もっともっと、私は決してなりたくなかった"}, {"type": "subtitle", "time": 9712.03, "timestamp": "02:41:52", "text": "一人暮らしで、いろいろと好きだけど、"}, {"type": "subtitle", "time": 9714.429, "timestamp": "02:41:54", "text": "うまく機能しない"}, {"type": "subtitle", "time": 9716.63, "timestamp": "02:41:56", "text": "悲しいことに"}]
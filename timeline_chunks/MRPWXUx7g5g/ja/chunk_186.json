[{"type": "subtitle", "time": 11162.389, "timestamp": "03:06:02", "text": "さようなら、場所を見つけたい"}, {"type": "subtitle", "time": 11169.19, "timestamp": "03:06:09", "text": "男たちは、そこに立っている人が好きです"}, {"type": "subtitle", "time": 11171.59, "timestamp": "03:06:11", "text": "方法だけど、それが"}, {"type": "subtitle", "time": 11173.11, "timestamp": "03:06:13", "text": "安全策をとるか、"}, {"type": "subtitle", "time": 11189.99, "timestamp": "03:06:29", "text": "シャワーを浴びる場所を見つけたいのですが、ほとんどの"}, {"type": "subtitle", "time": 11193.55, "timestamp": "03:06:33", "text": "Hのほとんどは"}, {"type": "subtitle", "time": 11200.389, "timestamp": "03:06:40", "text": "だから私は"}, {"type": "subtitle", "time": 11217.309, "timestamp": "03:06:57", "text": "予約しました、本当に必要です、ああ神様"}, {"type": "subtitle", "time": 11218.71, "timestamp": "03:06:58", "text": "それ"}]
[{"type": "subtitle", "time": 10020.11, "timestamp": "02:47:00", "text": "実際、私のFEゲームに関しては、"}, {"type": "subtitle", "time": 10023.309, "timestamp": "02:47:03", "text": "フォーカスモードとハッピーモードでは"}, {"type": "subtitle", "time": 10026.19, "timestamp": "02:47:06", "text": "ゲームとか全部好きで、私は"}, {"type": "subtitle", "time": 10029.71, "timestamp": "02:47:09", "text": "昨日と同じように歩いているよ"}, {"type": "subtitle", "time": 10034.389, "timestamp": "02:47:14", "text": "えっと、通話のキーは"}, {"type": "subtitle", "time": 10036.63, "timestamp": "02:47:16", "text": "歩いていない川を歩いた後"}, {"type": "subtitle", "time": 10038.15, "timestamp": "02:47:18", "text": "散歩と帰宅後の小川"}, {"type": "subtitle", "time": 10040.95, "timestamp": "02:47:20", "text": "そしてPCに戻る"}, {"type": "subtitle", "time": 10046.07, "timestamp": "02:47:26", "text": "ストリーム 私はちょっと予想外だった"}, {"type": "subtitle", "time": 10051.75, "timestamp": "02:47:31", "text": "ズキは私がどれだけ入れたかみたいに言うだろう"}, {"type": "subtitle", "time": 10054.95, "timestamp": "02:47:34", "text": "このクソみたいな出費に、"}, {"type": "subtitle", "time": 10057.07, "timestamp": "02:47:37", "text": "私はいつも笑顔でした"}, {"type": "subtitle", "time": 10058.429, "timestamp": "02:47:38", "text": "話しているか、"}, {"type": "subtitle", "time": 10063.15, "timestamp": "02:47:43", "text": "私がこれをどうするか"}, {"type": "subtitle", "time": 10066.67, "timestamp": "02:47:46", "text": "もちろん、私は自分が笑っていることに少し気づいています"}, {"type": "subtitle", "time": 10070.71, "timestamp": "02:47:50", "text": "たくさん話す"}]
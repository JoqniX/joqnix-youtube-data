[{"type": "subtitle", "time": 13981.389, "timestamp": "03:53:01", "text": "良い"}, {"type": "subtitle", "time": 13984.95, "timestamp": "03:53:04", "text": "爆撃みたいなもの、良いものにしたい"}, {"type": "subtitle", "time": 13989.59, "timestamp": "03:53:09", "text": "爆撃より、こんにちは、あなたは知っています"}, {"type": "subtitle", "time": 13998.349, "timestamp": "03:53:18", "text": "まるで"}, {"type": "subtitle", "time": 14002.67, "timestamp": "03:53:22", "text": "私が欲しいのは、"}, {"type": "subtitle", "time": 14006.71, "timestamp": "03:53:26", "text": "いい名前だよ、知ってるでしょ、そして"}, {"type": "subtitle", "time": 14009.349, "timestamp": "03:53:29", "text": "えっと、アンケートを取りたいのですが、"}, {"type": "subtitle", "time": 14011.59, "timestamp": "03:53:31", "text": "何か提案のようなもの"}, {"type": "subtitle", "time": 14013.189, "timestamp": "03:53:33", "text": "のような名前"}, {"type": "subtitle", "time": 14016.59, "timestamp": "03:53:36", "text": "コミュニティとかそういうもの"}, {"type": "subtitle", "time": 14020.349, "timestamp": "03:53:40", "text": "なぜなら、私たちが進歩すればするほど"}, {"type": "subtitle", "time": 14023.269, "timestamp": "03:53:43", "text": "家族のような感じがする、ある意味で私はこの家族のような感じがする"}, {"type": "subtitle", "time": 14025.79, "timestamp": "03:53:45", "text": "名前は、何でもできるようなもの"}, {"type": "subtitle", "time": 14028.429, "timestamp": "03:53:48", "text": "みんなとすべてが正しい、私はそれが欲しい"}, {"type": "subtitle", "time": 14030.79, "timestamp": "03:53:50", "text": "もっとユニークになるために"}, {"type": "subtitle", "time": 14032.79, "timestamp": "03:53:52", "text": "たぶんそうじゃないと思う"}, {"type": "subtitle", "time": 14035.91, "timestamp": "03:53:55", "text": "知ってるけど、EXではある意味でもユニーク"}, {"type": "subtitle", "time": 14036.75, "timestamp": "03:53:56", "text": "あなた"}, {"type": "subtitle", "time": 14038.95, "timestamp": "03:53:58", "text": "知ってるからそれは"}]
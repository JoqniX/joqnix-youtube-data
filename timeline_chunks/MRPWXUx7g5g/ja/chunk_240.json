[{"type": "subtitle", "time": 14400.469, "timestamp": "04:00:00", "text": "PCとか、ワイプとか色々やってたんだけど"}, {"type": "subtitle", "time": 14402.67, "timestamp": "04:00:02", "text": "そしてその時に一緒に学んだ私は"}, {"type": "subtitle", "time": 14406.51, "timestamp": "04:00:06", "text": "その時ちょうどそのことについて言っていた"}, {"type": "subtitle", "time": 14408.87, "timestamp": "04:00:08", "text": "その2人は私のモデレーターです"}, {"type": "subtitle", "time": 14414.189, "timestamp": "04:00:14", "text": "M と すべてを表示します"}, {"type": "subtitle", "time": 14424.47, "timestamp": "04:00:24", "text": "周りで話せる"}, {"type": "subtitle", "time": 14426.87, "timestamp": "04:00:26", "text": "[音楽]"}, {"type": "subtitle", "time": 14430.429, "timestamp": "04:00:30", "text": "これらすべては私が望んでいないことです"}, {"type": "subtitle", "time": 14432.389, "timestamp": "04:00:32", "text": "行く"}, {"type": "subtitle", "time": 14447.269, "timestamp": "04:00:47", "text": "しー、私は物を持って、私は学ぶ"}, {"type": "subtitle", "time": 14451.229, "timestamp": "04:00:51", "text": "さまざまなタイプの人々と同じように、"}, {"type": "subtitle", "time": 14453.99, "timestamp": "04:00:53", "text": "あなたの夢や目標を応援してくれる人"}, {"type": "subtitle", "time": 14457.91, "timestamp": "04:00:57", "text": "そして、あなたにはあなたのことを理解し、そして"}]
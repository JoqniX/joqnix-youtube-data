[{"type": "subtitle", "time": 14822.189, "timestamp": "04:07:02", "text": "例えば、誰かが意地悪なことを言ったら"}, {"type": "subtitle", "time": 14824.59, "timestamp": "04:07:04", "text": "私にとって私はそうしなかったし、私は引っ越さない、ただ"}, {"type": "subtitle", "time": 14827.189, "timestamp": "04:07:07", "text": "彼らを無視して黙っている"}, {"type": "subtitle", "time": 14828.51, "timestamp": "04:07:08", "text": "あんな感じ"}, {"type": "subtitle", "time": 14831.87, "timestamp": "04:07:11", "text": "堆肥って、あなたが"}, {"type": "subtitle", "time": 14834.59, "timestamp": "04:07:14", "text": "意味は、"}, {"type": "subtitle", "time": 14837.07, "timestamp": "04:07:17", "text": "反論するのではなく成熟した態度で"}, {"type": "subtitle", "time": 14838.07, "timestamp": "04:07:18", "text": "彼らと"}, {"type": "subtitle", "time": 14840.75, "timestamp": "04:07:20", "text": "それらを所定の位置に置くとか"}, {"type": "subtitle", "time": 14851.87, "timestamp": "04:07:31", "text": "ああ、アル、うんうん、聞かれたよ"}, {"type": "subtitle", "time": 14856.83, "timestamp": "04:07:36", "text": "ジョイはそうしない人になる"}, {"type": "subtitle", "time": 14857.75, "timestamp": "04:07:37", "text": "与える"}, {"type": "subtitle", "time": 14860.149, "timestamp": "04:07:40", "text": "魚を釣る"}, {"type": "subtitle", "time": 14863.51, "timestamp": "04:07:43", "text": "知ってるし好き、私が知らないことは気にしない"}, {"type": "subtitle", "time": 14865.469, "timestamp": "04:07:45", "text": "どうでもいい"}, {"type": "subtitle", "time": 14870.67, "timestamp": "04:07:50", "text": "ほら、もし私がそうしたければ"}, {"type": "subtitle", "time": 14873.389, "timestamp": "04:07:53", "text": "それはできる"}, {"type": "subtitle", "time": 14876.07, "timestamp": "04:07:56", "text": "でも、私もそうしたいけど、"}, {"type": "subtitle", "time": 14879.59, "timestamp": "04:07:59", "text": "戻ってきたら"}]
[{"type": "subtitle", "time": 14102.71, "timestamp": "03:55:02", "text": "たとえ彼らが親切であっても、彼らを置いていきたい"}, {"type": "subtitle", "time": 14105.99, "timestamp": "03:55:05", "text": "私を降ろそうとしていたか何か"}, {"type": "subtitle", "time": 14108.79, "timestamp": "03:55:08", "text": "でも彼らは親切だったけど"}, {"type": "subtitle", "time": 14109.87, "timestamp": "03:55:09", "text": "まだ"}, {"type": "subtitle", "time": 14112.189, "timestamp": "03:55:12", "text": "しかし、一つ疑問がありました。"}, {"type": "subtitle", "time": 14116.269, "timestamp": "03:55:16", "text": "彼らに尋ねられたのは"}, {"type": "subtitle", "time": 14118.67, "timestamp": "03:55:18", "text": "ジョッキーが"}, {"type": "subtitle", "time": 14122.83, "timestamp": "03:55:22", "text": "聴衆との友情と"}, {"type": "subtitle", "time": 14126.63, "timestamp": "03:55:26", "text": "あなたのストリーミングの件ですが、私は"}, {"type": "subtitle", "time": 14129.75, "timestamp": "03:55:29", "text": "そんな風に私を困らせないで"}, {"type": "subtitle", "time": 14132.63, "timestamp": "03:55:32", "text": "バッカ、文字通りそれは難しい"}, {"type": "subtitle", "time": 14136.229, "timestamp": "03:55:36", "text": "文字通り大変で、超大変"}, {"type": "subtitle", "time": 14138.07, "timestamp": "03:55:38", "text": "質問です"}, {"type": "subtitle", "time": 14141.229, "timestamp": "03:55:41", "text": "例えば、あなたが"}, {"type": "subtitle", "time": 14143.469, "timestamp": "03:55:43", "text": "彼女が尋ねるような関係"}, {"type": "subtitle", "time": 14147.229, "timestamp": "03:55:47", "text": "あなたかあなたのパートナーが行くでしょう"}, {"type": "subtitle", "time": 14148.189, "timestamp": "03:55:48", "text": "質問"}, {"type": "subtitle", "time": 14152.269, "timestamp": "03:55:52", "text": "あなたは自分の目標よりも私を優先するのですか？"}, {"type": "subtitle", "time": 14154.63, "timestamp": "03:55:54", "text": "そしてそれは文字通り同じです"}]
[{"type": "subtitle", "time": 18600.27, "timestamp": "05:10:00", "text": "このゲームは長い間プレイしていません"}, {"type": "subtitle", "time": 18604.75, "timestamp": "05:10:04", "text": "私はお金を使うつもりはありません"}, {"type": "subtitle", "time": 18607.15, "timestamp": "05:10:07", "text": "このゲームでの私の時間は、まるで再びレベル上げのようです。"}, {"type": "subtitle", "time": 18609.948, "timestamp": "05:10:09", "text": "去年みたいに、いや、だから私はそれを受け取っている"}, {"type": "subtitle", "time": 18612.31, "timestamp": "05:10:12", "text": "遅いので、悪いか悪いかは関係ありません"}, {"type": "subtitle", "time": 18615.868, "timestamp": "05:10:15", "text": "たとえ悪いものでも、私が手に入れたもの"}, {"type": "subtitle", "time": 18619.51, "timestamp": "05:10:19", "text": "大丈夫、私たちはやり遂げる"}, {"type": "subtitle", "time": 18622.67, "timestamp": "05:10:22", "text": "我々はそれを実現するだろう"}, {"type": "subtitle", "time": 18626.83, "timestamp": "05:10:26", "text": "もしあなたが信じるなら"}, {"type": "subtitle", "time": 18629.99, "timestamp": "05:10:29", "text": "えっと、どこにあるの？このワインは"}, {"type": "subtitle", "time": 18632.548, "timestamp": "05:10:32", "text": "味は私が覚えているマンスと同じです"}, {"type": "subtitle", "time": 18637.07, "timestamp": "05:10:37", "text": "ワインですが、"}, {"type": "subtitle", "time": 18640.11, "timestamp": "05:10:40", "text": "記憶V"}, {"type": "subtitle", "time": 18655.03, "timestamp": "05:10:55", "text": "え、待って、終わったって書いてあるけど、もう終わったの？"}, {"type": "subtitle", "time": 18658.91, "timestamp": "05:10:58", "text": "上のそれは約"}]
[{"type": "subtitle", "time": 12601.87, "timestamp": "03:30:01", "text": "ターンテーブルでYouTubeと"}, {"type": "subtitle", "time": 12605.11, "timestamp": "03:30:05", "text": "すべて、そして私は「わあ」と言い、彼は"}, {"type": "subtitle", "time": 12608.67, "timestamp": "03:30:08", "text": "まあいいけど、問題は彼らが"}, {"type": "subtitle", "time": 12612.59, "timestamp": "03:30:12", "text": "彼の家族は私の家族が私だと知っていた"}, {"type": "subtitle", "time": 12616.11, "timestamp": "03:30:16", "text": "これについて考えてください。私はこれを知りません。"}, {"type": "subtitle", "time": 12618.429, "timestamp": "03:30:18", "text": "新しい君、そうだね、だから彼らは"}, {"type": "subtitle", "time": 12620.15, "timestamp": "03:30:20", "text": "彼らは私にとても親切でした"}, {"type": "subtitle", "time": 12622.55, "timestamp": "03:30:22", "text": "母のように始まり、"}, {"type": "subtitle", "time": 12626.229, "timestamp": "03:30:26", "text": "そのインストラクターとその母親と彼らは"}, {"type": "subtitle", "time": 12629.03, "timestamp": "03:30:29", "text": "シェイクのような良いもののように扱って"}, {"type": "subtitle", "time": 12631.75, "timestamp": "03:30:31", "text": "いろいろなものがあって、おいしい食べ物をくれたり"}, {"type": "subtitle", "time": 12634.389, "timestamp": "03:30:34", "text": "私が来た時のすべて"}, {"type": "subtitle", "time": 12635.63, "timestamp": "03:30:35", "text": "早期に"}, {"type": "subtitle", "time": 12638.87, "timestamp": "03:30:38", "text": "待って、だって私はピアノの授業を受けてたから"}, {"type": "subtitle", "time": 12642.349, "timestamp": "03:30:42", "text": "夕方、私はよくそこに行っていました。"}, {"type": "subtitle", "time": 12646.99, "timestamp": "03:30:46", "text": "午前11時1分過ぎくらいで、そう、だって"}, {"type": "subtitle", "time": 12649.03, "timestamp": "03:30:49", "text": "4時頃にクローゼットにいたか"}, {"type": "subtitle", "time": 12654.67, "timestamp": "03:30:54", "text": "うん"}, {"type": "subtitle", "time": 12658.469, "timestamp": "03:30:58", "text": "そう、それから彼の"}]
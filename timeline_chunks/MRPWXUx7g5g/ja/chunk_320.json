[{"type": "subtitle", "time": 19200.91, "timestamp": "05:20:00", "text": "前のメッセージ申し訳ありません、だから"}, {"type": "subtitle", "time": 19206.548, "timestamp": "05:20:06", "text": "現れる"}, {"type": "subtitle", "time": 19210.548, "timestamp": "05:20:10", "text": "M 誰もが普通のまたは"}, {"type": "subtitle", "time": 19228.75, "timestamp": "05:20:28", "text": "あなた自身のことが心配でした"}, {"type": "subtitle", "time": 19230.948, "timestamp": "05:20:30", "text": "どうか、そんな純粋で粗末な扱いをしないでください"}, {"type": "subtitle", "time": 19234.15, "timestamp": "05:20:34", "text": "自分で、これが私がいつも得ているものです"}, {"type": "subtitle", "time": 19237.15, "timestamp": "05:20:37", "text": "毎回あなたたちのおかげで"}, {"type": "subtitle", "time": 19240.51, "timestamp": "05:20:40", "text": "時々痛み"}, {"type": "subtitle", "time": 19245.59, "timestamp": "05:20:45", "text": "いいえ、私は自分を追い込みすぎると"}, {"type": "subtitle", "time": 19248.99, "timestamp": "05:20:48", "text": "これが喜びだ、だから君はこうやって頑張るんだ"}, {"type": "subtitle", "time": 19252.11, "timestamp": "05:20:52", "text": "バカ、そして、すべての"}, {"type": "subtitle", "time": 19254.43, "timestamp": "05:20:54", "text": "外で罵り、ボンみたいに私と"}, {"type": "subtitle", "time": 19257.15, "timestamp": "05:20:57", "text": "まるで私を平手打ちして、"}]
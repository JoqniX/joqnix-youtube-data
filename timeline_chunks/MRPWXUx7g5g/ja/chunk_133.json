[{"type": "subtitle", "time": 7996.27, "timestamp": "02:13:16", "text": "L 私はこれが先に起こったことを嫌っています"}, {"type": "subtitle", "time": 8020.99, "timestamp": "02:13:40", "text": "たくさんあるので"}, {"type": "subtitle", "time": 8025.109, "timestamp": "02:13:45", "text": "今日、私はそれが歩くのが難しいことを知っています"}, {"type": "subtitle", "time": 8028.95, "timestamp": "02:13:48", "text": "それとも今日はただのんびり過ごすべきだろうか"}, {"type": "subtitle", "time": 8032.27, "timestamp": "02:13:52", "text": "考えてみると"}]
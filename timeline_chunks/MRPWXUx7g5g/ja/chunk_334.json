[{"type": "subtitle", "time": 20041.51, "timestamp": "05:34:01", "text": "何か発見しましたか？"}, {"type": "subtitle", "time": 20052.11, "timestamp": "05:34:12", "text": "ちょっと待って、私？"}, {"type": "subtitle", "time": 20055.83, "timestamp": "05:34:15", "text": "ストーリーミッションには"}, {"type": "subtitle", "time": 20056.91, "timestamp": "05:34:16", "text": "声"}, {"type": "subtitle", "time": 20059.868, "timestamp": "05:34:19", "text": "線はただ"}, {"type": "subtitle", "time": 20068.628, "timestamp": "05:34:28", "text": "線は理解できないが、"}, {"type": "subtitle", "time": 20070.868, "timestamp": "05:34:30", "text": "少し観察すると、怒りが再燃する"}, {"type": "subtitle", "time": 20074.15, "timestamp": "05:34:34", "text": "他の人が"}, {"type": "subtitle", "time": 20075.59, "timestamp": "05:34:35", "text": "浮遊と関係がある"}, {"type": "subtitle", "time": 20085.27, "timestamp": "05:34:45", "text": "混乱しているように見えるので、起動する必要がある"}, {"type": "subtitle", "time": 20086.51, "timestamp": "05:34:46", "text": "その5人"}, {"type": "subtitle", "time": 20089.07, "timestamp": "05:34:49", "text": "誰かがクリスタルを叩く必要があるデバイス"}, {"type": "subtitle", "time": 20091.39, "timestamp": "05:34:51", "text": "もしくは何か、そうすれば黒い斑点が"}, {"type": "subtitle", "time": 20093.39, "timestamp": "05:34:53", "text": "消える"}, {"type": "subtitle", "time": 20095.91, "timestamp": "05:34:55", "text": "ああ、彼らは絵の描き方を忘れてしまったのでしょうね"}]
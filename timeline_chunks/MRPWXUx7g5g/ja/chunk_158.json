[{"type": "subtitle", "time": 9482.92, "timestamp": "02:38:02", "text": "私が行くべき"}, {"type": "subtitle", "time": 9485.51, "timestamp": "02:38:05", "text": "[音楽]"}, {"type": "subtitle", "time": 9488.67, "timestamp": "02:38:08", "text": "私が"}, {"type": "subtitle", "time": 9492.11, "timestamp": "02:38:12", "text": "男は、それはVなのか、人々は何をするのか"}, {"type": "subtitle", "time": 9496.83, "timestamp": "02:38:16", "text": "誰が汗をかくのか、どうすればいいか"}, {"type": "subtitle", "time": 9499.71, "timestamp": "02:38:19", "text": "これを克服するのはとてもクール"}, {"type": "subtitle", "time": 9501.23, "timestamp": "02:38:21", "text": "ジャケットか何か"}, {"type": "subtitle", "time": 9504.71, "timestamp": "02:38:24", "text": "どうすれば克服できるのか私にはわからない"}, {"type": "subtitle", "time": 9509.55, "timestamp": "02:38:29", "text": "この文字通りのバケツのスイング"}, {"type": "subtitle", "time": 9512.469, "timestamp": "02:38:32", "text": "これは何の痛みですか、あそこを見てください"}, {"type": "subtitle", "time": 9514.23, "timestamp": "02:38:34", "text": "1"}, {"type": "subtitle", "time": 9518.429, "timestamp": "02:38:38", "text": "子犬 子犬 シーイングは"}, {"type": "subtitle", "time": 9520.389, "timestamp": "02:38:40", "text": "運搬"}, {"type": "subtitle", "time": 9523.11, "timestamp": "02:38:43", "text": "子犬"}]
[{"type": "subtitle", "time": 12181.99, "timestamp": "03:23:01", "text": "人々やあらゆるもの、そしてそうでない"}, {"type": "subtitle", "time": 12184.79, "timestamp": "03:23:04", "text": "冷酷な人間"}, {"type": "subtitle", "time": 12188.469, "timestamp": "03:23:08", "text": "そう、お金はエメレスのために取っておくんだ"}, {"type": "subtitle", "time": 12192.15, "timestamp": "03:23:12", "text": "それは本当だけど、ある日"}, {"type": "subtitle", "time": 12194.75, "timestamp": "03:23:14", "text": "私が少しお金を与えたとき"}, {"type": "subtitle", "time": 12197.79, "timestamp": "03:23:17", "text": "父は「いや、そのままにしておいて」と言いました"}, {"type": "subtitle", "time": 12199.51, "timestamp": "03:23:19", "text": "あなた自身のために、そして"}, {"type": "subtitle", "time": 12204.349, "timestamp": "03:23:24", "text": "物だけど文字通り"}, {"type": "subtitle", "time": 12207.189, "timestamp": "03:23:27", "text": "最近では、ええと、文字通り私の父は"}, {"type": "subtitle", "time": 12210.15, "timestamp": "03:23:30", "text": "少しのお金をくれる"}, {"type": "subtitle", "time": 12212.51, "timestamp": "03:23:32", "text": "外食したり、外出したり、"}, {"type": "subtitle", "time": 12215.309, "timestamp": "03:23:35", "text": "そういうことって、俺は「俺はそうするべきだ」って思うんだ"}, {"type": "subtitle", "time": 12218.55, "timestamp": "03:23:38", "text": "このお金の使い方には本当に気をつけます。"}, {"type": "subtitle", "time": 12222.11, "timestamp": "03:23:42", "text": "また、それがどういうことなのか私にはわかりません"}, {"type": "subtitle", "time": 12226.189, "timestamp": "03:23:46", "text": "男よ、君はどういうわけかこれらすべてを確実にする"}, {"type": "subtitle", "time": 12227.189, "timestamp": "03:23:47", "text": "のように"}, {"type": "subtitle", "time": 12231.189, "timestamp": "03:23:51", "text": "メインのようなものが実行中"}, {"type": "subtitle", "time": 12234.63, "timestamp": "03:23:54", "text": "家族のことや請求書など、"}, {"type": "subtitle", "time": 12237.07, "timestamp": "03:23:57", "text": "物や深み、そしてあらゆるもの、それはとても"}]
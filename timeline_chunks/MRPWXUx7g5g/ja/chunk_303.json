[{"type": "subtitle", "time": 18181.628, "timestamp": "05:03:01", "text": "の使用"}, {"type": "subtitle", "time": 18185.47, "timestamp": "05:03:05", "text": "しかしそれは何の意味もありません"}, {"type": "subtitle", "time": 18193.59, "timestamp": "05:03:13", "text": "脂肪の原因を理解するために"}, {"type": "subtitle", "time": 18197.43, "timestamp": "05:03:17", "text": "私たちはそうですが、"}, {"type": "subtitle", "time": 18200.948, "timestamp": "05:03:20", "text": "私たちが追求するもの、そして私たちがどちらの側に立つか"}, {"type": "subtitle", "time": 18209.59, "timestamp": "05:03:29", "text": "人々最終決戦最終決戦とは何か"}, {"type": "subtitle", "time": 18211.75, "timestamp": "05:03:31", "text": "バトルみんな"}, {"type": "subtitle", "time": 18220.15, "timestamp": "05:03:40", "text": "この"}, {"type": "subtitle", "time": 18222.43, "timestamp": "05:03:42", "text": "信頼できる"}, {"type": "subtitle", "time": 18225.31, "timestamp": "05:03:45", "text": "人類の血の涙の一滴一滴を捧げたい"}, {"type": "subtitle", "time": 18228.75, "timestamp": "05:03:48", "text": "壁を揺らすショーは、"}, {"type": "subtitle", "time": 18232.47, "timestamp": "05:03:52", "text": "無駄に捨てられる 家がない 私は"}, {"type": "subtitle", "time": 18237.67, "timestamp": "05:03:57", "text": "私自身はこうしています"}]
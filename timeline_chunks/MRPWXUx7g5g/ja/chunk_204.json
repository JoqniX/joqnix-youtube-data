[{"type": "subtitle", "time": 12242.83, "timestamp": "03:24:02", "text": "痛み、そう、痛みです"}, {"type": "subtitle", "time": 12246.429, "timestamp": "03:24:06", "text": "私にとって私はただ母に渡して"}, {"type": "subtitle", "time": 12250.03, "timestamp": "03:24:10", "text": "大切な家の物に使うために"}, {"type": "subtitle", "time": 12253.429, "timestamp": "03:24:13", "text": "昔と同じように私もそうしたい"}, {"type": "subtitle", "time": 12257.11, "timestamp": "03:24:17", "text": "以前はそうしていた"}, {"type": "subtitle", "time": 12258.75, "timestamp": "03:24:18", "text": "しかし"}, {"type": "subtitle", "time": 12261.269, "timestamp": "03:24:21", "text": "そう、私の話は、"}, {"type": "subtitle", "time": 12265.79, "timestamp": "03:24:25", "text": "私はそれを本当に幼い頃に理解しました。"}, {"type": "subtitle", "time": 12268.63, "timestamp": "03:24:28", "text": "ああ、それは私が"}, {"type": "subtitle", "time": 12271.229, "timestamp": "03:24:31", "text": "ジョーを作った、そう作った"}, {"type": "subtitle", "time": 12274.11, "timestamp": "03:24:34", "text": "私が名前を見つけたとき、私は"}, {"type": "subtitle", "time": 12277.389, "timestamp": "03:24:37", "text": "音楽とかをやってたんだけど、いつも"}, {"type": "subtitle", "time": 12279.11, "timestamp": "03:24:39", "text": "ずっとメディ"}, {"type": "subtitle", "time": 12281.79, "timestamp": "03:24:41", "text": "キーボードは毎日使っています"}, {"type": "subtitle", "time": 12286.07, "timestamp": "03:24:46", "text": "祈るために、私に何かを与えてください"}, {"type": "subtitle", "time": 12288.67, "timestamp": "03:24:48", "text": "お金を貯めて買えるようになりたい"}, {"type": "subtitle", "time": 12290.99, "timestamp": "03:24:50", "text": "メディキーボードと"}, {"type": "subtitle", "time": 12294.349, "timestamp": "03:24:54", "text": "すべて理解しました、そして私は尋ねました"}, {"type": "subtitle", "time": 12296.429, "timestamp": "03:24:56", "text": "私の両親はバンガロールでもとても気に入っている"}, {"type": "subtitle", "time": 12299.87, "timestamp": "03:24:59", "text": "バンガロールを訪れた時のことなど"}]
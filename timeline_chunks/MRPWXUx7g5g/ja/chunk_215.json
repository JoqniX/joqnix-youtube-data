[{"type": "subtitle", "time": 12927.83, "timestamp": "03:35:27", "text": "ただあなたを抱きしめる ただあなたを抱きしめる"}, {"type": "subtitle", "time": 12931.95, "timestamp": "03:35:31", "text": "自分自身を恥ずかしい思いをさせている、または"}, {"type": "subtitle", "time": 12934.189, "timestamp": "03:35:34", "text": "恥ずかしい"}, {"type": "subtitle", "time": 12936.99, "timestamp": "03:35:36", "text": "大丈夫、長い目で見れば何でも"}, {"type": "subtitle", "time": 12938.71, "timestamp": "03:35:38", "text": "のために"}, {"type": "subtitle", "time": 12941.15, "timestamp": "03:35:41", "text": "たとえ私が恥ずかしい思いをしても"}, {"type": "subtitle", "time": 12943.87, "timestamp": "03:35:43", "text": "Pは"}, {"type": "subtitle", "time": 12946.83, "timestamp": "03:35:46", "text": "うわ、蚊が多すぎる"}, {"type": "subtitle", "time": 12958.79, "timestamp": "03:35:58", "text": "ここにいますが、ええと、何の話をしていましたっけ？"}]
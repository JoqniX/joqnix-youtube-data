[{"type": "subtitle", "time": 18420.51, "timestamp": "05:07:00", "text": "死なない、死ぬ"}, {"type": "subtitle", "time": 18423.31, "timestamp": "05:07:03", "text": "死ぬ私の"}, {"type": "subtitle", "time": 18433.47, "timestamp": "05:07:13", "text": "ああ、ストーリーの部分をスピードランできます"}, {"type": "subtitle", "time": 18438.03, "timestamp": "05:07:18", "text": "イベントは本当に静かに待っていました。"}, {"type": "subtitle", "time": 18440.07, "timestamp": "05:07:20", "text": "ただ死ぬだけだが"}, {"type": "subtitle", "time": 18454.51, "timestamp": "05:07:34", "text": "何が飛び立つのか、それは雪だった"}, {"type": "subtitle", "time": 18479.11, "timestamp": "05:07:59", "text": "[音楽]"}]
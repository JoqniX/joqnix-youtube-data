[{"type": "subtitle", "time": 11220.71, "timestamp": "03:07:00", "text": "[音楽]"}, {"type": "subtitle", "time": 11224.83, "timestamp": "03:07:04", "text": "文字通り私が見たあの男"}, {"type": "subtitle", "time": 11227.75, "timestamp": "03:07:07", "text": "先ほど彼はまた来て、"}, {"type": "subtitle", "time": 11231.15, "timestamp": "03:07:11", "text": "文字通り踏みつけた、踏みつけたのではなく、もっと踏みつけた"}, {"type": "subtitle", "time": 11233.429, "timestamp": "03:07:13", "text": "ひび割れた物を通して"}, {"type": "subtitle", "time": 11235.75, "timestamp": "03:07:15", "text": "誰かと、"}, {"type": "subtitle", "time": 11238.429, "timestamp": "03:07:18", "text": "座っていると、"}, {"type": "subtitle", "time": 11242.15, "timestamp": "03:07:22", "text": "うわぁ、どうしてこんなことができるの？私はただここに座っているだけ"}, {"type": "subtitle", "time": 11248.19, "timestamp": "03:07:28", "text": "推測"}, {"type": "subtitle", "time": 11250.67, "timestamp": "03:07:30", "text": "ついに場所が"}, {"type": "subtitle", "time": 11254.71, "timestamp": "03:07:34", "text": "こうやって見て、何するの？"}, {"type": "subtitle", "time": 11259.71, "timestamp": "03:07:39", "text": "料理する時間まで"}, {"type": "subtitle", "time": 11263.15, "timestamp": "03:07:43", "text": "料理は大丈夫、私のChar 65ダメージ私のパワー"}, {"type": "subtitle", "time": 11273.07, "timestamp": "03:07:53", "text": "神"}, {"type": "subtitle", "time": 11275.349, "timestamp": "03:07:55", "text": "75"}, {"type": "subtitle", "time": 11278.469, "timestamp": "03:07:58", "text": "なるほど、それは死んでいないということですね"}]
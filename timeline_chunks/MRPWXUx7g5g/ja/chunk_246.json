[{"type": "subtitle", "time": 14761.91, "timestamp": "04:06:01", "text": "その人の視点から考える"}, {"type": "subtitle", "time": 14765.51, "timestamp": "04:06:05", "text": "彼を想像する"}, {"type": "subtitle", "time": 14769.309, "timestamp": "04:06:09", "text": "ああ、彼の靴を履いて、彼らの靴を履いて、"}, {"type": "subtitle", "time": 14772.349, "timestamp": "04:06:12", "text": "実際にストリームに入力して"}, {"type": "subtitle", "time": 14774.349, "timestamp": "04:06:14", "text": "私が感じるであろう"}, {"type": "subtitle", "time": 14776.51, "timestamp": "04:06:16", "text": "それは、"}, {"type": "subtitle", "time": 14778.51, "timestamp": "04:06:18", "text": "シナリオとシナリオと"}, {"type": "subtitle", "time": 14782.07, "timestamp": "04:06:22", "text": "あなたが何と呼ぶにせよ、枝はすべて同じようなものです。"}, {"type": "subtitle", "time": 14784.55, "timestamp": "04:06:24", "text": "選択肢1、選択肢2、あれみたいなやつ"}, {"type": "subtitle", "time": 14787.229, "timestamp": "04:06:27", "text": "まるでそれについて幸せを感じるかのようだ"}, {"type": "subtitle", "time": 14789.83, "timestamp": "04:06:29", "text": "それについて悲しむだろうし、"}, {"type": "subtitle", "time": 14793.229, "timestamp": "04:06:33", "text": "1人がBANされても、全員がBANされるわけではない"}, {"type": "subtitle", "time": 14796.11, "timestamp": "04:06:36", "text": "そういうこと全部だから、今考えてみよう"}, {"type": "subtitle", "time": 14799.87, "timestamp": "04:06:39", "text": "寝ている間に、"}, {"type": "subtitle", "time": 14809.309, "timestamp": "04:06:49", "text": "私はあなたの"}, {"type": "subtitle", "time": 14813.55, "timestamp": "04:06:53", "text": "圧縮はマルスと"}, {"type": "subtitle", "time": 14816.51, "timestamp": "04:06:56", "text": "その証拠は成熟しているということだ"}, {"type": "subtitle", "time": 14818.11, "timestamp": "04:06:58", "text": "コンピューターのように"}]
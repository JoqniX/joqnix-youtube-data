[{"type": "subtitle", "time": 9961.19, "timestamp": "02:46:01", "text": "まるで私が楽しみのためにやっているように、私の"}, {"type": "subtitle", "time": 9986.71, "timestamp": "02:46:26", "text": "どうやって私は"}, {"type": "subtitle", "time": 9989.309, "timestamp": "02:46:29", "text": "ストリーミングはしたくない"}, {"type": "subtitle", "time": 9992.11, "timestamp": "02:46:32", "text": "お金、そう、補償金を受け取る、了解"}, {"type": "subtitle", "time": 9993.75, "timestamp": "02:46:33", "text": "あなたの努力に対しても、それはそれで良いことです"}, {"type": "subtitle", "time": 9996.429, "timestamp": "02:46:36", "text": "でも私も"}, {"type": "subtitle", "time": 10004.15, "timestamp": "02:46:44", "text": "ストリーミング配信中、私はとても幸せです"}, {"type": "subtitle", "time": 10007.23, "timestamp": "02:46:47", "text": "えっと、時々こんな感じ"}, {"type": "subtitle", "time": 10009.349, "timestamp": "02:46:49", "text": "幸福は多くのpHの中にある"}, {"type": "subtitle", "time": 10012.99, "timestamp": "02:46:52", "text": "感情も、状況によります。"}, {"type": "subtitle", "time": 10017.63, "timestamp": "02:46:57", "text": "タイミングは気分次第だと思う"}]
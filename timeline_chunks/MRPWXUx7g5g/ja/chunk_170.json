[{"type": "subtitle", "time": 10204.71, "timestamp": "02:50:04", "text": "彼はグループに行き、彼は文字通り彼から離れた"}, {"type": "subtitle", "time": 10207.71, "timestamp": "02:50:07", "text": "そのまま投げて、それから投げる"}, {"type": "subtitle", "time": 10220.99, "timestamp": "02:50:20", "text": "虐待的な使用法は文字通り"}, {"type": "subtitle", "time": 10224.429, "timestamp": "02:50:24", "text": "それを人々に投げつけた"}, {"type": "subtitle", "time": 10225.19, "timestamp": "02:50:25", "text": "は"}, {"type": "subtitle", "time": 10230.11, "timestamp": "02:50:30", "text": "座って彼らを怖がらせているみたいに私は"}, {"type": "subtitle", "time": 10232.71, "timestamp": "02:50:32", "text": "わあ、それは本当に"}, {"type": "subtitle", "time": 10247.71, "timestamp": "02:50:47", "text": "わあ、それが、それが、あなたが聞いている"}, {"type": "subtitle", "time": 10250.11, "timestamp": "02:50:50", "text": "火花が散る音"}, {"type": "subtitle", "time": 10253.67, "timestamp": "02:50:53", "text": "彼は文字通りそれを投げた、まるで"}, {"type": "subtitle", "time": 10256.389, "timestamp": "02:50:56", "text": "プラスチックの何かか何かが見える"}, {"type": "subtitle", "time": 10258.11, "timestamp": "02:50:58", "text": "1"}]
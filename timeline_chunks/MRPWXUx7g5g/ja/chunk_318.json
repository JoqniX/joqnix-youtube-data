[{"type": "subtitle", "time": 19081.43, "timestamp": "05:18:01", "text": "危険が迫っているなら、私は命を捨てる"}, {"type": "subtitle", "time": 19084.31, "timestamp": "05:18:04", "text": "ここから下へ、そして横になって"}, {"type": "subtitle", "time": 19094.19, "timestamp": "05:18:14", "text": "幸運なごく少数の人たちとは対照的に"}, {"type": "subtitle", "time": 19100.948, "timestamp": "05:18:20", "text": "ビジョン アドベンチャー 探検 チャレンジ"}, {"type": "subtitle", "time": 19102.99, "timestamp": "05:18:22", "text": "これらは、"}, {"type": "subtitle", "time": 19105.51, "timestamp": "05:18:25", "text": "普通の人が実際に体験した"}, {"type": "subtitle", "time": 19108.03, "timestamp": "05:18:28", "text": "だから、結局のところそれは"}, {"type": "subtitle", "time": 19109.35, "timestamp": "05:18:29", "text": "あなたについて"}, {"type": "subtitle", "time": 19112.91, "timestamp": "05:18:32", "text": "え、あなたは少しも考えなかったの？"}, {"type": "subtitle", "time": 19115.51, "timestamp": "05:18:35", "text": "他の人のことは、前に言ったとおり、これは私自身のものです"}, {"type": "subtitle", "time": 19117.27, "timestamp": "05:18:37", "text": "個人的な用事で、何も得られませんでした。"}, {"type": "subtitle", "time": 19119.548, "timestamp": "05:18:39", "text": "他の誰にも申し訳ないと思う"}, {"type": "subtitle", "time": 19122.39, "timestamp": "05:18:42", "text": "この件は良くないけど、あなたは"}, {"type": "subtitle", "time": 19125.11, "timestamp": "05:18:45", "text": "バガにあなたの思い出を残してください"}, {"type": "subtitle", "time": 19133.59, "timestamp": "05:18:53", "text": "おい、よくも待てたな"}, {"type": "subtitle", "time": 19137.47, "timestamp": "05:18:57", "text": "F 何か聞きたいことがあって、"}]
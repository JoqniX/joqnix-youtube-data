[{"type": "subtitle", "time": 17162.35, "timestamp": "04:46:02", "text": "ロール 多分もう一日休みを取る"}, {"type": "subtitle", "time": 17164.27, "timestamp": "04:46:04", "text": "そして残りの仕事を一気に片付ける"}, {"type": "subtitle", "time": 17167.07, "timestamp": "04:46:07", "text": "やる気満々だ、待って、蹴ってみようか"}, {"type": "subtitle", "time": 17174.59, "timestamp": "04:46:14", "text": "こんにちは"}, {"type": "subtitle", "time": 17178.788, "timestamp": "04:46:18", "text": "一時的に待てない"}, {"type": "subtitle", "time": 17180.948, "timestamp": "04:46:20", "text": "そこには"}, {"type": "subtitle", "time": 17204.628, "timestamp": "04:46:44", "text": "そして、"}, {"type": "subtitle", "time": 17208.59, "timestamp": "04:46:48", "text": "H はうまくいった、よし、あとは待つだけだ"}, {"type": "subtitle", "time": 17217.26, "timestamp": "04:46:57", "text": "戻る"}]
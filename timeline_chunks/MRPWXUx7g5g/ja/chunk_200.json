[{"type": "subtitle", "time": 12006.67, "timestamp": "03:20:06", "text": "BB、それで私が言いたいのは"}, {"type": "subtitle", "time": 12009.87, "timestamp": "03:20:09", "text": "えっと、私が手に入れたとき"}, {"type": "subtitle", "time": 12014.83, "timestamp": "03:20:14", "text": "お金が必要だ、優先する、はい"}, {"type": "subtitle", "time": 12017.67, "timestamp": "03:20:17", "text": "必要な機器を優先的に使用"}, {"type": "subtitle", "time": 12021.349, "timestamp": "03:20:21", "text": "ゲームにお金を使うようなものではない、私は、私は、私は"}, {"type": "subtitle", "time": 12023.269, "timestamp": "03:20:23", "text": "あれをしなければよかった、あれは一つだった"}, {"type": "subtitle", "time": 12033.229, "timestamp": "03:20:33", "text": "えっと、私はこれが何なのかわかりません"}, {"type": "subtitle", "time": 12035.189, "timestamp": "03:20:35", "text": "これは、私がVをもっと使い始めるということです"}, {"type": "subtitle", "time": 12037.389, "timestamp": "03:20:37", "text": "人々と話すことを学ぶ"}, {"type": "subtitle", "time": 12039.51, "timestamp": "03:20:39", "text": "それは良いトレーニングです"}, {"type": "subtitle", "time": 12042.55, "timestamp": "03:20:42", "text": "それはコミュニケーションの良い方法であり、"}, {"type": "subtitle", "time": 12044.59, "timestamp": "03:20:44", "text": "良い方法であるものすべて"}, {"type": "subtitle", "time": 12047.07, "timestamp": "03:20:47", "text": "コミュニケーションを取り、あなたがすることすべて"}, {"type": "subtitle", "time": 12050.59, "timestamp": "03:20:50", "text": "つまり、ADI がそれをより頻繁に行っているということです。"}, {"type": "subtitle", "time": 12053.07, "timestamp": "03:20:53", "text": "でも、ほとんどの場合彼女は静かで"}, {"type": "subtitle", "time": 12056.229, "timestamp": "03:20:56", "text": "彼女は静かに、まるで黙っているかのように、あるいは時々話す。"}, {"type": "subtitle", "time": 12057.99, "timestamp": "03:20:57", "text": "あるいは何かだけど、それもまたある意味"}, {"type": "subtitle", "time": 12059.75, "timestamp": "03:20:59", "text": "何か持っていないと気まずい"}]
[{"type": "subtitle", "time": 13925.389, "timestamp": "03:52:05", "text": "痛みには文字通り誰もいないし、"}, {"type": "subtitle", "time": 13927.55, "timestamp": "03:52:07", "text": "通りはただ"}, {"type": "subtitle", "time": 13936.87, "timestamp": "03:52:16", "text": "次のことを実行する"}, {"type": "subtitle", "time": 13940.389, "timestamp": "03:52:20", "text": "私はこう考えていた"}, {"type": "subtitle", "time": 13944.79, "timestamp": "03:52:24", "text": "私はちょっと違うものを作りたい"}, {"type": "subtitle", "time": 13946.349, "timestamp": "03:52:26", "text": "ヤホヤ"}, {"type": "subtitle", "time": 13950.429, "timestamp": "03:52:30", "text": "ヤホのやつはかなり"}, {"type": "subtitle", "time": 13952.55, "timestamp": "03:52:32", "text": "多く"}, {"type": "subtitle", "time": 13964.07, "timestamp": "03:52:44", "text": "アウロ・シーオはクーを持っています。このクーは何ですか？"}, {"type": "subtitle", "time": 13966.269, "timestamp": "03:52:46", "text": "何が起こっているのかわかりません。私の名前はSKです。"}, {"type": "subtitle", "time": 13969.269, "timestamp": "03:52:49", "text": "スペイン、文字通り"}, {"type": "subtitle", "time": 13971.79, "timestamp": "03:52:51", "text": "1"}, {"type": "subtitle", "time": 13977.269, "timestamp": "03:52:57", "text": "君はすごくいいし、かわいいし、カイだけど、私は"}, {"type": "subtitle", "time": 13979.71, "timestamp": "03:52:59", "text": "Jのために何をすればいいのかわからない"}]
[{"type": "subtitle", "time": 19623.19, "timestamp": "05:27:03", "text": "彼女を少しの間連れて行くので、はいはい、こんにちは"}, {"type": "subtitle", "time": 19625.43, "timestamp": "05:27:05", "text": "どうですか？"}, {"type": "subtitle", "time": 19634.628, "timestamp": "05:27:14", "text": "[音楽]"}, {"type": "subtitle", "time": 19639.35, "timestamp": "05:27:19", "text": "先ほど、何か見逃しましたか？"}, {"type": "subtitle", "time": 19641.788, "timestamp": "05:27:21", "text": "ジャングルアクション映画を見て、ジョック"}, {"type": "subtitle", "time": 19642.948, "timestamp": "05:27:22", "text": "は"}, {"type": "subtitle", "time": 19650.67, "timestamp": "05:27:30", "text": "こんにちは、わかりました。では、これを開けて、"}, {"type": "subtitle", "time": 19664.99, "timestamp": "05:27:44", "text": "クリスタルのような見た目"}, {"type": "subtitle", "time": 19669.708, "timestamp": "05:27:49", "text": "お馴染みだが３つのアクションログ第４部"}, {"type": "subtitle", "time": 19672.07, "timestamp": "05:27:52", "text": "h"}, {"type": "subtitle", "time": 19675.75, "timestamp": "05:27:55", "text": "えっと、最初の行を飛ばしてしまいました"}, {"type": "subtitle", "time": 19678.708, "timestamp": "05:27:58", "text": "場所によって、人間か"}]
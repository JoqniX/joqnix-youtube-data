[{"type": "subtitle", "time": 15313.07, "timestamp": "04:15:13", "text": "息切れしちゃったよ、さようなら"}, {"type": "subtitle", "time": 15314.49, "timestamp": "04:15:14", "text": "わかった"}, {"type": "subtitle", "time": 15317.429, "timestamp": "04:15:17", "text": "[音楽]"}, {"type": "subtitle", "time": 15320.229, "timestamp": "04:15:20", "text": "わぁ"}, {"type": "subtitle", "time": 15323.75, "timestamp": "04:15:23", "text": "うんうん、今日は楽しかったよ。みんなも楽しんでくれるといいな。"}, {"type": "subtitle", "time": 15326.189, "timestamp": "04:15:26", "text": "明日は楽しかったけど、"}, {"type": "subtitle", "time": 15330.67, "timestamp": "04:15:30", "text": "経験値稼ぎをするときは配信します"}, {"type": "subtitle", "time": 15333.59, "timestamp": "04:15:33", "text": "ApexかStar Royaleみたいな感じかな、"}, {"type": "subtitle", "time": 15335.83, "timestamp": "04:15:35", "text": "ストリーミングしたくないものだけど"}, {"type": "subtitle", "time": 15338.83, "timestamp": "04:15:38", "text": "ストリーミングを試してみます。わかりませんが、"}, {"type": "subtitle", "time": 15339.79, "timestamp": "04:15:39", "text": "安定した"}, {"type": "subtitle", "time": 15342.389, "timestamp": "04:15:42", "text": "まるで自分が何をしているのか本当に混乱しているみたいだ"}, {"type": "subtitle", "time": 15344.67, "timestamp": "04:15:44", "text": "すべきこと"}, {"type": "subtitle", "time": 15346.55, "timestamp": "04:15:46", "text": "でも私はこれをウォーキングでやるつもりです"}, {"type": "subtitle", "time": 15351.269, "timestamp": "04:15:51", "text": "ちなみに毎日配信しています。"}, {"type": "subtitle", "time": 15353.67, "timestamp": "04:15:53", "text": "何かをする、そしてこれが私の方法の一つです"}, {"type": "subtitle", "time": 15357.309, "timestamp": "04:15:57", "text": "外に出て実際に触れる"}]
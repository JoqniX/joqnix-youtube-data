[{"type": "subtitle", "time": 14341.269, "timestamp": "03:59:01", "text": "いや、私たちはこういうことはしないよ。"}, {"type": "subtitle", "time": 14344.309, "timestamp": "03:59:04", "text": "それはまずい、まずい、なぜなら"}, {"type": "subtitle", "time": 14354.63, "timestamp": "03:59:14", "text": "文句を言う"}, {"type": "subtitle", "time": 14360.11, "timestamp": "03:59:20", "text": "私にお願いします、堀と私が好きなもの"}, {"type": "subtitle", "time": 14363.229, "timestamp": "03:59:23", "text": "行って、何かするから、と尋ねた"}, {"type": "subtitle", "time": 14365.11, "timestamp": "03:59:25", "text": "彼らはうまくやらなかった"}, {"type": "subtitle", "time": 14368.51, "timestamp": "03:59:28", "text": "聞いて、彼らに頼んで、彼らはしなかった"}, {"type": "subtitle", "time": 14373.51, "timestamp": "03:59:33", "text": "聞いて、それから私は好き、私は引き裂いた"}, {"type": "subtitle", "time": 14375.91, "timestamp": "03:59:35", "text": "かなり多くの人、それほど多くはない"}, {"type": "subtitle", "time": 14378.75, "timestamp": "03:59:38", "text": "2人のような人はそうではないけれど"}, {"type": "subtitle", "time": 14380.36, "timestamp": "03:59:40", "text": "私は言いません"}, {"type": "subtitle", "time": 14381.91, "timestamp": "03:59:41", "text": "[音楽]"}, {"type": "subtitle", "time": 14385.63, "timestamp": "03:59:45", "text": "名前だけど待って、二人に言わないで"}, {"type": "subtitle", "time": 14388.11, "timestamp": "03:59:48", "text": "あなたが毎日会う人々"}, {"type": "subtitle", "time": 14391.99, "timestamp": "03:59:51", "text": "側面と、そのうちの1つは"}, {"type": "subtitle", "time": 14395.309, "timestamp": "03:59:55", "text": "確かに彼らに伝えたし、私たちは"}, {"type": "subtitle", "time": 14397.83, "timestamp": "03:59:57", "text": "一緒に授業を受けるように、ダンは座った。"}]
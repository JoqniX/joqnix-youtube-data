[{"type": "subtitle", "time": 13141.75, "timestamp": "03:39:01", "text": "一人で座って、何が起こるかわからない"}, {"type": "subtitle", "time": 13144.83, "timestamp": "03:39:04", "text": "一人ぼっちだから何が起こるかわからない"}, {"type": "subtitle", "time": 13149.469, "timestamp": "03:39:09", "text": "一人ではLのように何でもできる"}, {"type": "subtitle", "time": 13153.67, "timestamp": "03:39:13", "text": "文字通り支払っています、私は行きます、私は去りました、ああ"}, {"type": "subtitle", "time": 13157.07, "timestamp": "03:39:17", "text": "彼らは「こいつは何者だ？」って思うだろう"}, {"type": "subtitle", "time": 13160.83, "timestamp": "03:39:20", "text": "英語をたくさん話したり、"}, {"type": "subtitle", "time": 13163.229, "timestamp": "03:39:23", "text": "彼の"}, {"type": "subtitle", "time": 13166.229, "timestamp": "03:39:26", "text": "pHですが、彼らはこれが"}, {"type": "subtitle", "time": 13167.269, "timestamp": "03:39:27", "text": "は"}, {"type": "subtitle", "time": 13170.15, "timestamp": "03:39:30", "text": "ライブ配信中"}, {"type": "subtitle", "time": 13172.75, "timestamp": "03:39:32", "text": "何が起こるかわからない、私はどこへ行くのか"}, {"type": "subtitle", "time": 13175.229, "timestamp": "03:39:35", "text": "そうですが、私の飼い主のほとんどは知りません"}, {"type": "subtitle", "time": 13177.55, "timestamp": "03:39:37", "text": "私の出身地では、"}, {"type": "subtitle", "time": 13180.79, "timestamp": "03:39:40", "text": "バド、何でもやってみて"}, {"type": "subtitle", "time": 13184.229, "timestamp": "03:39:44", "text": "配達は大丈夫だと思います。"}, {"type": "subtitle", "time": 13186.83, "timestamp": "03:39:46", "text": "そういうことが起こると思うんだけど"}, {"type": "subtitle", "time": 13189.189, "timestamp": "03:39:49", "text": "ライブストリームのようなRedditをやっている場合"}, {"type": "subtitle", "time": 13193.63, "timestamp": "03:39:53", "text": "映画とか、そういうのをたくさん見ることができます"}, {"type": "subtitle", "time": 13196.15, "timestamp": "03:39:56", "text": "そういうことだよ、ほら、"}, {"type": "subtitle", "time": 13199.71, "timestamp": "03:39:59", "text": "不気味な人たちがライブ配信者と話している"}]
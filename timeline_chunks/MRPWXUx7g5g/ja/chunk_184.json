[{"type": "subtitle", "time": 11044.71, "timestamp": "03:04:04", "text": "Jは何て言ってるの？"}, {"type": "subtitle", "time": 11048.389, "timestamp": "03:04:08", "text": "いい感じ、いい感じ、いい感じ、待って、もしこう言ってるなら"}, {"type": "subtitle", "time": 11052.389, "timestamp": "03:04:12", "text": "Jがそれをしているということは、私のえっと、"}, {"type": "subtitle", "time": 11055.87, "timestamp": "03:04:15", "text": "文字通りの意味は、私のPCBの解像度のようなものを意味します"}, {"type": "subtitle", "time": 11059.11, "timestamp": "03:04:19", "text": "そうですね、PCで見ると、文字通り"}, {"type": "subtitle", "time": 11060.19, "timestamp": "03:04:20", "text": "スケートで"}, {"type": "subtitle", "time": 11063.429, "timestamp": "03:04:23", "text": "モード画面は"}, {"type": "subtitle", "time": 11081.19, "timestamp": "03:04:41", "text": "わからない"}, {"type": "subtitle", "time": 11083.91, "timestamp": "03:04:43", "text": "どうすれば作れるかわからない"}, {"type": "subtitle", "time": 11087.79, "timestamp": "03:04:47", "text": "これは私がこれをやっていることを示しています"}, {"type": "subtitle", "time": 11091.67, "timestamp": "03:04:51", "text": "ラリーが私を必要としているかどうかわからない"}, {"type": "subtitle", "time": 11095.55, "timestamp": "03:04:55", "text": "えっと、そのシステムがどういう仕組みなのかよくわからないんです"}, {"type": "subtitle", "time": 11098.469, "timestamp": "03:04:58", "text": "もしそうなら、おそらくそう表示されるべきでしょう"}]
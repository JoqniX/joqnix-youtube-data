[{"type": "subtitle", "time": 11941.429, "timestamp": "03:19:01", "text": "私はゲームをプレイするときにVCを使い始めました"}, {"type": "subtitle", "time": 11951.189, "timestamp": "03:19:11", "text": "買わなきゃいけないものがたくさんある"}, {"type": "subtitle", "time": 11954.55, "timestamp": "03:19:14", "text": "なぜなら、私は何らかの形でプラス"}, {"type": "subtitle", "time": 11959.15, "timestamp": "03:19:19", "text": "一番大切なのは、たとえ私が好きでも、"}, {"type": "subtitle", "time": 11961.59, "timestamp": "03:19:21", "text": "私が手に入れるお金は、たとえ"}, {"type": "subtitle", "time": 11964.55, "timestamp": "03:19:24", "text": "最近はあまり得られないもの"}, {"type": "subtitle", "time": 11967.189, "timestamp": "03:19:27", "text": "ストリーミング配信は受け取っていません"}, {"type": "subtitle", "time": 11969.51, "timestamp": "03:19:29", "text": "何かが、私がそれをしない理由になる"}, {"type": "subtitle", "time": 11971.67, "timestamp": "03:19:31", "text": "このお金だけど、そう、たとえ私が"}, {"type": "subtitle", "time": 11974.75, "timestamp": "03:19:34", "text": "あなたのような他の人がお金を得るのと同じように"}, {"type": "subtitle", "time": 11976.389, "timestamp": "03:19:36", "text": "フリーランスって何て言うんだっけ？"}, {"type": "subtitle", "time": 11979.79, "timestamp": "03:19:39", "text": "契約に縛られているので断ることはできないので"}, {"type": "subtitle", "time": 11982.75, "timestamp": "03:19:42", "text": "私はCRに署名するので、それは「ああ、君が」という感じになります"}, {"type": "subtitle", "time": 11994.15, "timestamp": "03:19:54", "text": "それで"}, {"type": "subtitle", "time": 11997.229, "timestamp": "03:19:57", "text": "だから、私が言いたいことは"}]
[{"type": "subtitle", "time": 8821.469, "timestamp": "02:27:01", "text": "まあいいと思うけど、また私は"}, {"type": "subtitle", "time": 8824.71, "timestamp": "02:27:04", "text": "「ああ神様、なぜまた話してるんだろう」"}, {"type": "subtitle", "time": 8836.19, "timestamp": "02:27:16", "text": "ええ、私は文字通りランダムに話しています"}, {"type": "subtitle", "time": 8849.59, "timestamp": "02:27:29", "text": "うん、明日配信"}, {"type": "subtitle", "time": 8853.07, "timestamp": "02:27:33", "text": "はい、私たちは"}, {"type": "subtitle", "time": 8861.59, "timestamp": "02:27:41", "text": "ホハ、ちょっと遅れちゃった。忘れてた。"}, {"type": "subtitle", "time": 8865.269, "timestamp": "02:27:45", "text": "私の財布は"}, {"type": "subtitle", "time": 8868.63, "timestamp": "02:27:48", "text": "家と、"}, {"type": "subtitle", "time": 8871.23, "timestamp": "02:27:51", "text": "ジャヴァナ えーと衣装リアルフレーム私は"}]
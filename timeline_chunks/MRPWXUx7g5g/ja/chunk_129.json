[{"type": "subtitle", "time": 7741.43, "timestamp": "02:09:01", "text": "私もそのメインエンゲージと"}, {"type": "subtitle", "time": 7743.229, "timestamp": "02:09:03", "text": "物"}, {"type": "subtitle", "time": 7748.669, "timestamp": "02:09:08", "text": "例 コーナーまたは"}, {"type": "subtitle", "time": 7752.39, "timestamp": "02:09:12", "text": "何かと公式コンサート"}, {"type": "subtitle", "time": 7756.549, "timestamp": "02:09:16", "text": "あまりにも"}, {"type": "subtitle", "time": 7775.31, "timestamp": "02:09:35", "text": "シング"}, {"type": "subtitle", "time": 7777.83, "timestamp": "02:09:37", "text": "外"}, {"type": "subtitle", "time": 7786.07, "timestamp": "02:09:46", "text": "次のような人々"}, {"type": "subtitle", "time": 7787.91, "timestamp": "02:09:47", "text": "[音楽]"}, {"type": "subtitle", "time": 7791.669, "timestamp": "02:09:51", "text": "人々は愛している"}, {"type": "subtitle", "time": 7793.669, "timestamp": "02:09:53", "text": "主な"}, {"type": "subtitle", "time": 7796.149, "timestamp": "02:09:56", "text": "ストリーム、ストリーム、そう、なぜなら"}, {"type": "subtitle", "time": 7798.51, "timestamp": "02:09:58", "text": "たくさんの角度から見ることができます"}]
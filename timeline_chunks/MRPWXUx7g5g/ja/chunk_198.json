[{"type": "subtitle", "time": 11889.229, "timestamp": "03:18:09", "text": "うわー、それを磨くべきだと思う？"}, {"type": "subtitle", "time": 11892.229, "timestamp": "03:18:12", "text": "お金を無駄にすべきではないと思う"}, {"type": "subtitle", "time": 11893.95, "timestamp": "03:18:13", "text": "F"}, {"type": "subtitle", "time": 11897.03, "timestamp": "03:18:17", "text": "ああ、もし私がそれを買おうとしているなら"}, {"type": "subtitle", "time": 11899.83, "timestamp": "03:18:19", "text": "は"}, {"type": "subtitle", "time": 11903.67, "timestamp": "03:18:23", "text": "ピストルの皮と、いや、私は"}, {"type": "subtitle", "time": 11905.67, "timestamp": "03:18:25", "text": "しないよ、しないよ、しないと思うよ"}, {"type": "subtitle", "time": 11908.95, "timestamp": "03:18:28", "text": "ファントムの切り替え"}, {"type": "subtitle", "time": 11915.269, "timestamp": "03:18:35", "text": "マキマというニックネーム"}, {"type": "subtitle", "time": 11918.189, "timestamp": "03:18:38", "text": "アイマ、私はそうは思わない"}, {"type": "subtitle", "time": 11927.269, "timestamp": "03:18:47", "text": "たぶん私は好きだと思います。私も考えていました。"}, {"type": "subtitle", "time": 11930.11, "timestamp": "03:18:50", "text": "もし私がピストルスキンを買うとしたら"}, {"type": "subtitle", "time": 11931.07, "timestamp": "03:18:51", "text": "または"}, {"type": "subtitle", "time": 11934.469, "timestamp": "03:18:54", "text": "何か一つ、私は待てないよ、わかるでしょ"}, {"type": "subtitle", "time": 11938.55, "timestamp": "03:18:58", "text": "私が止めようとしているのは"}]
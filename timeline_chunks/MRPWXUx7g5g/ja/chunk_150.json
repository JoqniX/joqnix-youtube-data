[{"type": "subtitle", "time": 9002.03, "timestamp": "02:30:02", "text": "彼女は大きく成長し、改善すべきである"}, {"type": "subtitle", "time": 9004.71, "timestamp": "02:30:04", "text": "たくさん、話すこと、その他すべて"}, {"type": "subtitle", "time": 9011.52, "timestamp": "02:30:11", "text": "すべて そう、ザナ・セレサみたいにね。"}, {"type": "subtitle", "time": 9015.359, "timestamp": "02:30:15", "text": "そう、ザナ・セレサみたいにね。 私が好きな女の子はみんな"}, {"type": "subtitle", "time": 9017.88, "timestamp": "02:30:17", "text": "私が好きな女の子はみんな 長年にわたって改善されてきた"}, {"type": "subtitle", "time": 9021.88, "timestamp": "02:30:21", "text": "長年にわたって改善されてきた 彼女は行く"}, {"type": "subtitle", "time": 9023.56, "timestamp": "02:30:23", "text": "彼女は行く 今"}, {"type": "subtitle", "time": 9033.87, "timestamp": "02:30:33", "text": "だから、でもいつか私は願う"}, {"type": "subtitle", "time": 9038.469, "timestamp": "02:30:38", "text": "ああ、いつか私は自分の"}, {"type": "subtitle", "time": 9040.0, "timestamp": "02:30:40", "text": "自分の 待って、ちなみに私はデビューしたことがない"}, {"type": "subtitle", "time": 9042.64, "timestamp": "02:30:42", "text": "待って、ちなみに私はデビューしたことがない みんな知ってた？私は今まで"}, {"type": "subtitle", "time": 9046.2, "timestamp": "02:30:46", "text": "みんな知ってた？私は今まで ちゃんとしたデビューだから、もしもし、そして、えーと"}, {"type": "subtitle", "time": 9049.6, "timestamp": "02:30:49", "text": "ちゃんとしたデビューだから、もしもし、そして、えーと 例えば、鍵が外れているような場合"}, {"type": "subtitle", "time": 9053.12, "timestamp": "02:30:53", "text": "例えば、鍵が外れているような場合 私には何もない"}, {"type": "subtitle", "time": 9055.399, "timestamp": "02:30:55", "text": "私には何もない 日付"}, {"type": "subtitle", "time": 9057.279, "timestamp": "02:30:57", "text": "日付 だって私はデビューしてないから"}, {"type": "subtitle", "time": 9059.88, "timestamp": "02:30:59", "text": "だって私はデビューしてないから ええ、文字通りデビューはしていません"}]
[{"type": "subtitle", "time": 15121.429, "timestamp": "04:12:01", "text": "そういう類のもの"}, {"type": "subtitle", "time": 15126.229, "timestamp": "04:12:06", "text": "だから、私は話していないから"}, {"type": "subtitle", "time": 15130.07, "timestamp": "04:12:10", "text": "長い間、誰にとっても"}, {"type": "subtitle", "time": 15133.189, "timestamp": "04:12:13", "text": "ああ、なんてことだ、彼らは"}, {"type": "subtitle", "time": 15134.429, "timestamp": "04:12:14", "text": "に"}, {"type": "subtitle", "time": 15139.189, "timestamp": "04:12:19", "text": "犬は飛行機と戦っているのか"}, {"type": "subtitle", "time": 15145.87, "timestamp": "04:12:25", "text": "これはああああああ、彼らは私に気づいてしまった"}, {"type": "subtitle", "time": 15151.91, "timestamp": "04:12:31", "text": "1 2 3 4 5 6 7 8 8匹の犬、ああ神様"}, {"type": "subtitle", "time": 15156.469, "timestamp": "04:12:36", "text": "ああ神様、ああ神様、彼らは立ち去ろうとしている"}, {"type": "subtitle", "time": 15160.59, "timestamp": "04:12:40", "text": "インパ1 2 3は私を見ている 1 2 3 4 5 6"}, {"type": "subtitle", "time": 15163.79, "timestamp": "04:12:43", "text": "楽しみにしています"}, {"type": "subtitle", "time": 15167.75, "timestamp": "04:12:47", "text": "ああ神様、犬がやって来る"}, {"type": "subtitle", "time": 15171.91, "timestamp": "04:12:51", "text": "パップ、二人ともステップを踏んでいる"}, {"type": "subtitle", "time": 15173.95, "timestamp": "04:12:53", "text": "またお尻"}, {"type": "subtitle", "time": 15175.95, "timestamp": "04:12:55", "text": "神よ、何が"}]
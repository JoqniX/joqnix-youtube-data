[{"type": "subtitle", "time": 12720.59, "timestamp": "03:32:00", "text": "こういう人もいるし"}, {"type": "subtitle", "time": 12723.429, "timestamp": "03:32:03", "text": "すべてが壊れてしまった"}, {"type": "subtitle", "time": 12724.59, "timestamp": "03:32:04", "text": "私の"}, {"type": "subtitle", "time": 12729.349, "timestamp": "03:32:09", "text": "夢、そう、もし私が"}, {"type": "subtitle", "time": 12732.11, "timestamp": "03:32:12", "text": "その人は私を騙そうとしている、あるいは"}, {"type": "subtitle", "time": 12734.349, "timestamp": "03:32:14", "text": "お金持ちの人はお金が必要で"}, {"type": "subtitle", "time": 12737.15, "timestamp": "03:32:17", "text": "うん、そうだ、彼はそう言った"}, {"type": "subtitle", "time": 12740.189, "timestamp": "03:32:20", "text": "彼は自分の車の保険をやりたかったし、"}, {"type": "subtitle", "time": 12743.03, "timestamp": "03:32:23", "text": "すごい、彼はこう感じ"}, {"type": "subtitle", "time": 12746.03, "timestamp": "03:32:26", "text": "彼は文字通りDJingに頼っていた"}, {"type": "subtitle", "time": 12749.229, "timestamp": "03:32:29", "text": "彼のキャリアと彼の教師としてのキャリアは"}, {"type": "subtitle", "time": 12752.87, "timestamp": "03:32:32", "text": "DJing というものに、"}, {"type": "subtitle", "time": 12761.469, "timestamp": "03:32:41", "text": "だから彼はすごく"}, {"type": "subtitle", "time": 12764.87, "timestamp": "03:32:44", "text": "お金とかを渡すために、私はこう思う"}, {"type": "subtitle", "time": 12767.51, "timestamp": "03:32:47", "text": "Mペイン"}, {"type": "subtitle", "time": 12769.59, "timestamp": "03:32:49", "text": "でも、それでもそんなことはすべきじゃないよ。"}, {"type": "subtitle", "time": 12772.229, "timestamp": "03:32:52", "text": "君が知ってると思うけど、私が理解したことが一つあるんだ"}, {"type": "subtitle", "time": 12774.55, "timestamp": "03:32:54", "text": "たくさんの人が"}, {"type": "subtitle", "time": 12776.71, "timestamp": "03:32:56", "text": "金融のように"}, {"type": "subtitle", "time": 12778.83, "timestamp": "03:32:58", "text": "たとえあなたの"}]
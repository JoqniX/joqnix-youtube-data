[{"type": "subtitle", "time": 15060.71, "timestamp": "04:11:00", "text": "したい"}, {"type": "subtitle", "time": 15063.63, "timestamp": "04:11:03", "text": "終わりはまるで"}, {"type": "subtitle", "time": 15066.229, "timestamp": "04:11:06", "text": "昨日、私は話し続けたいと思っていました"}, {"type": "subtitle", "time": 15069.55, "timestamp": "04:11:09", "text": "ジと一緒に、一度私たち二人とも"}, {"type": "subtitle", "time": 15072.87, "timestamp": "04:11:12", "text": "チャットは、私たちが続けたいようなものです"}, {"type": "subtitle", "time": 15075.87, "timestamp": "04:11:15", "text": "おしゃべりしたり、振り返ったり、あなたは決して"}, {"type": "subtitle", "time": 15080.269, "timestamp": "04:11:20", "text": "まるで旅に出るように、時間の経過に気づかない"}, {"type": "subtitle", "time": 15082.67, "timestamp": "04:11:22", "text": "でもそれは本当に"}, {"type": "subtitle", "time": 15085.67, "timestamp": "04:11:25", "text": "時々、私が"}, {"type": "subtitle", "time": 15088.59, "timestamp": "04:11:28", "text": "毎日鍵とかと話してる"}, {"type": "subtitle", "time": 15090.83, "timestamp": "04:11:30", "text": "時々そういうことが起こるよ。"}, {"type": "subtitle", "time": 15093.389, "timestamp": "04:11:33", "text": "もっと迷子になる必要がある"}, {"type": "subtitle", "time": 15096.75, "timestamp": "04:11:36", "text": "話すのは"}, {"type": "subtitle", "time": 15100.149, "timestamp": "04:11:40", "text": "えっと、なんて言うんだっけ、えっと、私は"}, {"type": "subtitle", "time": 15102.83, "timestamp": "04:11:42", "text": "富士山についてご存知かどうかわかりませんが、"}, {"type": "subtitle", "time": 15103.75, "timestamp": "04:11:43", "text": "カイン"}, {"type": "subtitle", "time": 15108.469, "timestamp": "04:11:48", "text": "ナンは二人とも多くのことに没頭する"}, {"type": "subtitle", "time": 15113.03, "timestamp": "04:11:53", "text": "話題とか、FESとか、そういうもの"}, {"type": "subtitle", "time": 15116.51, "timestamp": "04:11:56", "text": "そして、彼らはあなたにたくさんの愛を運んでくれるように"}, {"type": "subtitle", "time": 15118.469, "timestamp": "04:11:58", "text": "彼らは相性が良く、"}]
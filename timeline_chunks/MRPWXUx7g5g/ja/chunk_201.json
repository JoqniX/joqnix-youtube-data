[{"type": "subtitle", "time": 12063.83, "timestamp": "03:21:03", "text": "よく話題にしたり話したりしますが、"}, {"type": "subtitle", "time": 12066.87, "timestamp": "03:21:06", "text": "そういうのはちょっと退屈でつまらない"}, {"type": "subtitle", "time": 12078.349, "timestamp": "03:21:18", "text": "また、文字通り"}, {"type": "subtitle", "time": 12081.389, "timestamp": "03:21:21", "text": "何てことだ"}, {"type": "subtitle", "time": 12084.269, "timestamp": "03:21:24", "text": "はい、わかりました、いいですね"}, {"type": "subtitle", "time": 12087.11, "timestamp": "03:21:27", "text": "いいですか、私は多すぎます"}, {"type": "subtitle", "time": 12089.99, "timestamp": "03:21:29", "text": "神様、そう、私が手に入れたときも言っています"}, {"type": "subtitle", "time": 12092.189, "timestamp": "03:21:32", "text": "お金は、少しだけ"}, {"type": "subtitle", "time": 12094.309, "timestamp": "03:21:34", "text": "ストリーム機器"}, {"type": "subtitle", "time": 12097.71, "timestamp": "03:21:37", "text": "いろいろなものを用意して、ストリーミング機器を与えて、"}, {"type": "subtitle", "time": 12100.91, "timestamp": "03:21:40", "text": "PCのメンテナンス"}, {"type": "subtitle", "time": 12105.429, "timestamp": "03:21:45", "text": "それで、2番目の部分は、えーと"}, {"type": "subtitle", "time": 12108.91, "timestamp": "03:21:48", "text": "鶏肉は自分のものですが、今は"}, {"type": "subtitle", "time": 12110.469, "timestamp": "03:21:50", "text": "お金を保管しないことを考えています"}, {"type": "subtitle", "time": 12112.91, "timestamp": "03:21:52", "text": "自分のためなら何でもするよ、だって無駄にしてしまうから"}, {"type": "subtitle", "time": 12116.83, "timestamp": "03:21:56", "text": "自分自身を知っている、いやいや、私は私は"}, {"type": "subtitle", "time": 12119.03, "timestamp": "03:21:59", "text": "自分で取っておくべきだけど、そうまた"}]
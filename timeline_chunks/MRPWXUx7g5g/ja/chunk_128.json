[{"type": "subtitle", "time": 7686.19, "timestamp": "02:08:06", "text": "だった"}, {"type": "subtitle", "time": 7694.229, "timestamp": "02:08:14", "text": "何も起こらない"}, {"type": "subtitle", "time": 7698.03, "timestamp": "02:08:18", "text": "今は、これがほとんどと同じように"}, {"type": "subtitle", "time": 7702.669, "timestamp": "02:08:22", "text": "人々は「えー、ビヨンセはそれについて」という感じ"}, {"type": "subtitle", "time": 7721.95, "timestamp": "02:08:41", "text": "君たちはよくそれを見るよ、ただ見ないだけじゃない"}, {"type": "subtitle", "time": 7725.87, "timestamp": "02:08:45", "text": "リングの中で彼女は、そう、それはもっと"}, {"type": "subtitle", "time": 7728.709, "timestamp": "02:08:48", "text": "それはより明確にわかる"}, {"type": "subtitle", "time": 7729.99, "timestamp": "02:08:49", "text": "指輪"}, {"type": "subtitle", "time": 7733.069, "timestamp": "02:08:53", "text": "シーンだが"}, {"type": "subtitle", "time": 7736.87, "timestamp": "02:08:56", "text": "えっと、それは同じだと思います。"}]
[{"type": "subtitle", "time": 14162.55, "timestamp": "03:56:02", "text": "そう、それは最高になるだろう"}, {"type": "subtitle", "time": 14166.189, "timestamp": "03:56:06", "text": "痛み、それはものすごく痛くなるだろうし"}, {"type": "subtitle", "time": 14167.59, "timestamp": "03:56:07", "text": "素晴らしい"}, {"type": "subtitle", "time": 14172.07, "timestamp": "03:56:12", "text": "難しい質問ですね。"}, {"type": "subtitle", "time": 14175.269, "timestamp": "03:56:15", "text": "そして私は当然のことをした"}, {"type": "subtitle", "time": 14184.91, "timestamp": "03:56:24", "text": "その日、私は目標を達成した。"}, {"type": "subtitle", "time": 14189.269, "timestamp": "03:56:29", "text": "まあ、そんな感じ。ボーを抑えなきゃいけなかったんだ"}, {"type": "subtitle", "time": 14191.389, "timestamp": "03:56:31", "text": "私のから私のから"}, {"type": "subtitle", "time": 14195.309, "timestamp": "03:56:35", "text": "コミュニティ、みんな知ってるでしょ"}, {"type": "subtitle", "time": 14198.51, "timestamp": "03:56:38", "text": "なんとなくわかるんだけど、"}, {"type": "subtitle", "time": 14200.429, "timestamp": "03:56:40", "text": "コミュニティを構築しようとしているのですが、"}, {"type": "subtitle", "time": 14204.03, "timestamp": "03:56:44", "text": "えっと、心地よくて健全な感じ"}, {"type": "subtitle", "time": 14206.469, "timestamp": "03:56:46", "text": "ゲームのほとんどを見るように"}, {"type": "subtitle", "time": 14210.71, "timestamp": "03:56:50", "text": "世の中のコミュニティは本当に"}, {"type": "subtitle", "time": 14214.309, "timestamp": "03:56:54", "text": "トクシーは、まるであなたが"}, {"type": "subtitle", "time": 14216.07, "timestamp": "03:56:56", "text": "人気のシャワー室か何かにいる"}, {"type": "subtitle", "time": 14218.229, "timestamp": "03:56:58", "text": "あのゲームみたいに"}]
[{"type": "subtitle", "time": 11641.269, "timestamp": "03:14:01", "text": "以来"}, {"type": "subtitle", "time": 11651.51, "timestamp": "03:14:11", "text": "vcamは富士とみんなと"}, {"type": "subtitle", "time": 11655.71, "timestamp": "03:14:15", "text": "ヴァレリンの物を見た人みんな"}, {"type": "subtitle", "time": 11660.469, "timestamp": "03:14:20", "text": "より私が好きだったように"}, {"type": "subtitle", "time": 11662.67, "timestamp": "03:14:22", "text": "私が実際に買おうと思っているものを想像してみてください"}, {"type": "subtitle", "time": 11665.469, "timestamp": "03:14:25", "text": "電話用の腕用ブラジャー、そう、それが私の"}, {"type": "subtitle", "time": 11667.389, "timestamp": "03:14:27", "text": "今は最優先事項です"}, {"type": "subtitle", "time": 11670.309, "timestamp": "03:14:30", "text": "この電話用のワイヤレスマイクのようなマイク"}, {"type": "subtitle", "time": 11674.15, "timestamp": "03:14:34", "text": "モバイルストリーミングとモバイルホールド"}, {"type": "subtitle", "time": 11677.469, "timestamp": "03:14:37", "text": "腕ではなく、手首のようなもの"}, {"type": "subtitle", "time": 11679.349, "timestamp": "03:14:39", "text": "だから時計を見ることができる"}, {"type": "subtitle", "time": 11680.349, "timestamp": "03:14:40", "text": "親切"}, {"type": "subtitle", "time": 11685.55, "timestamp": "03:14:45", "text": "だからそれは私の"}, {"type": "subtitle", "time": 11688.429, "timestamp": "03:14:48", "text": "右左右右手は"}, {"type": "subtitle", "time": 11691.91, "timestamp": "03:14:51", "text": "電話を見ると、私の左手は"}, {"type": "subtitle", "time": 11693.83, "timestamp": "03:14:53", "text": "時計で、文字通り何をチェックできるか"}, {"type": "subtitle", "time": 11698.269, "timestamp": "03:14:58", "text": "音楽が流れています。それに、どんな音楽ですか？"}]
[{"type": "subtitle", "time": 7807.109, "timestamp": "02:10:07", "text": "それが私が言いたかったことです"}, {"type": "subtitle", "time": 7811.069, "timestamp": "02:10:11", "text": "そうだ、私たちはまだ"}, {"type": "subtitle", "time": 7814.39, "timestamp": "02:10:14", "text": "そこに生きている"}, {"type": "subtitle", "time": 7829.189, "timestamp": "02:10:29", "text": "私の牽引を知っている"}, {"type": "subtitle", "time": 7831.229, "timestamp": "02:10:31", "text": "手が動いている"}, {"type": "subtitle", "time": 7833.91, "timestamp": "02:10:33", "text": "オンは実際には"}, {"type": "subtitle", "time": 7836.35, "timestamp": "02:10:36", "text": "行く"}, {"type": "subtitle", "time": 7841.669, "timestamp": "02:10:41", "text": "ただの男たち、なぜ確信が持てないのか、セットを見つけるべきだ"}, {"type": "subtitle", "time": 7843.709, "timestamp": "02:10:43", "text": "実は"}]
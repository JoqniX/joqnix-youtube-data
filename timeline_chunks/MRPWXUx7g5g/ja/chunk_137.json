[{"type": "subtitle", "time": 8221.309, "timestamp": "02:17:01", "text": "彼らは私に呼びかけ、"}, {"type": "subtitle", "time": 8227.629, "timestamp": "02:17:07", "text": "まるで私がそうだったように、そして彼らは尋ねた"}, {"type": "subtitle", "time": 8230.11, "timestamp": "02:17:10", "text": "私が何をしていたか、そして"}, {"type": "subtitle", "time": 8233.429, "timestamp": "02:17:13", "text": "すべて、そう、それで私たちは話していた"}, {"type": "subtitle", "time": 8236.629, "timestamp": "02:17:16", "text": "なぜ私は少し希望を失ったのか"}, {"type": "subtitle", "time": 8246.15, "timestamp": "02:17:26", "text": "ええ、そうですね、私が"}, {"type": "subtitle", "time": 8248.15, "timestamp": "02:17:28", "text": "勉強していることをやっている"}, {"type": "subtitle", "time": 8250.27, "timestamp": "02:17:30", "text": "パートナーと会うたびに"}, {"type": "subtitle", "time": 8252.95, "timestamp": "02:17:32", "text": "むしろ、何を尋ねているか"}, {"type": "subtitle", "time": 8254.83, "timestamp": "02:17:34", "text": "あなたは今どこで勉強していますか？"}, {"type": "subtitle", "time": 8256.83, "timestamp": "02:17:36", "text": "今、みんな"}, {"type": "subtitle", "time": 8261.23, "timestamp": "02:17:41", "text": "でも、ある意味では彼の言う通りだ"}, {"type": "subtitle", "time": 8263.07, "timestamp": "02:17:43", "text": "私は"}, {"type": "subtitle", "time": 8266.549, "timestamp": "02:17:46", "text": "えーっと、なんて言うんだっけ？ わかってるよ、えーっと"}, {"type": "subtitle", "time": 8270.389, "timestamp": "02:17:50", "text": "私の母語であるトン語、母語"}, {"type": "subtitle", "time": 8272.23, "timestamp": "02:17:52", "text": "言葉がわからない"}, {"type": "subtitle", "time": 8274.23, "timestamp": "02:17:54", "text": "英語では、それはもっと"}, {"type": "subtitle", "time": 8278.23, "timestamp": "02:17:58", "text": "えっと、もし私がそれを言うとしたら"}]
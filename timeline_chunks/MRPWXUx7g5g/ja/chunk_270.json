[{"type": "subtitle", "time": 16201.07, "timestamp": "04:30:01", "text": "痛みを忘れた、そんなことしてはいけない、なぜなら私は"}, {"type": "subtitle", "time": 16205.55, "timestamp": "04:30:05", "text": "自動音量調整機能がある"}, {"type": "subtitle", "time": 16208.149, "timestamp": "04:30:08", "text": "とにかく正しい"}, {"type": "subtitle", "time": 16209.83, "timestamp": "04:30:09", "text": "えーと"}, {"type": "subtitle", "time": 16216.71, "timestamp": "04:30:16", "text": "なぜ私は"}, {"type": "subtitle", "time": 16220.309, "timestamp": "04:30:20", "text": "自分自身が自分の"}, {"type": "subtitle", "time": 16223.79, "timestamp": "04:30:23", "text": "ストリームハイ"}, {"type": "subtitle", "time": 16238.03, "timestamp": "04:30:38", "text": "ミース、ハイ、戻ってきて、戻ってきて、戻ってきて、何"}, {"type": "subtitle", "time": 16250.83, "timestamp": "04:30:50", "text": "こんにちは、なぜ音声が出ないのですか？"}, {"type": "subtitle", "time": 16255.79, "timestamp": "04:30:55", "text": "音声待機 なぜミュート解除されないのか"}]
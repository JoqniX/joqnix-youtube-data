[{"type": "subtitle", "time": 19260.15, "timestamp": "05:21:00", "text": "何もかも、ああ神様、だって私は聞かないから"}, {"type": "subtitle", "time": 19276.708, "timestamp": "05:21:16", "text": "わかった、もしあなたが戻ってきたら"}, {"type": "subtitle", "time": 19280.67, "timestamp": "05:21:20", "text": "待って、ああ神様、電話がかかってきた、ちょっと待って"}, {"type": "subtitle", "time": 19285.47, "timestamp": "05:21:25", "text": "上へ、これを持って行かないといけないかもしれない、行くよ"}]
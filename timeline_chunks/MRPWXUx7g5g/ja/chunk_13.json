[{"type": "subtitle", "time": 810.79, "timestamp": "00:13:30", "text": "言語を交換するだけで"}, {"type": "subtitle", "time": 813.55, "timestamp": "00:13:33", "text": "私は彼らに連絡を取らなければならないが、"}, {"type": "subtitle", "time": 816.43, "timestamp": "00:13:36", "text": "彼らが"}, {"type": "subtitle", "time": 820.91, "timestamp": "00:13:40", "text": "下へ、そして私はスーパーにならなければならない"}, {"type": "subtitle", "time": 823.829, "timestamp": "00:13:43", "text": "プロフェッショナルとして"}, {"type": "subtitle", "time": 830.47, "timestamp": "00:13:50", "text": "怖いけど、怖いかどうかは問題じゃない"}, {"type": "subtitle", "time": 833.069, "timestamp": "00:13:53", "text": "それは実際に何かをすることだ"}, {"type": "subtitle", "time": 836.59, "timestamp": "00:13:56", "text": "一歩前進して"}, {"type": "subtitle", "time": 839.629, "timestamp": "00:13:59", "text": "つながり"}]
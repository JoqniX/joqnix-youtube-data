[{"type": "subtitle", "time": 12963.03, "timestamp": "03:36:03", "text": "もう一度言うけど、そうだったよね。"}, {"type": "subtitle", "time": 12965.83, "timestamp": "03:36:05", "text": "ああ、もし私が"}, {"type": "subtitle", "time": 12967.67, "timestamp": "03:36:07", "text": "何かを学ぶ私は自分で学ぶか"}, {"type": "subtitle", "time": 12970.55, "timestamp": "03:36:10", "text": "オンラインでやっていることなど"}, {"type": "subtitle", "time": 12974.91, "timestamp": "03:36:14", "text": "でも、私は「うん、文字通り」って感じ"}, {"type": "subtitle", "time": 12977.15, "timestamp": "03:36:17", "text": "ほら、ある日、君に言ったんだ"}, {"type": "subtitle", "time": 12979.59, "timestamp": "03:36:19", "text": "これについて、かなり"}, {"type": "subtitle", "time": 12982.67, "timestamp": "03:36:22", "text": "さまざまなNESでかなりの数の人々が"}, {"type": "subtitle", "time": 12985.189, "timestamp": "03:36:25", "text": "NES の音楽のようなもの"}, {"type": "subtitle", "time": 12988.91, "timestamp": "03:36:28", "text": "アートやストリーミングもそうじゃないと思う"}, {"type": "subtitle", "time": 12991.87, "timestamp": "03:36:31", "text": "ストリーミングではなくストリーミングしない"}, {"type": "subtitle", "time": 12996.03, "timestamp": "03:36:36", "text": "えっと、私が誰かにインスピレーションを与えて"}, {"type": "subtitle", "time": 13000.469, "timestamp": "03:36:40", "text": "私がやっていたことなので、私は"}, {"type": "subtitle", "time": 13002.15, "timestamp": "03:36:42", "text": "私が彼にインスピレーションを与えた友人の一人"}, {"type": "subtitle", "time": 13003.91, "timestamp": "03:36:43", "text": "音楽制作とDJ活動"}, {"type": "subtitle", "time": 13007.03, "timestamp": "03:36:47", "text": "すべてはついに彼"}, {"type": "subtitle", "time": 13011.07, "timestamp": "03:36:51", "text": "どうやら彼はこう言ったらしい"}, {"type": "subtitle", "time": 13014.229, "timestamp": "03:36:54", "text": "音楽制作をしている"}]
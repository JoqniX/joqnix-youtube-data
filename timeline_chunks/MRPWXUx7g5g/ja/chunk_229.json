[{"type": "subtitle", "time": 13740.87, "timestamp": "03:49:00", "text": "彼らはpHで楽しんでいる"}, {"type": "subtitle", "time": 13745.79, "timestamp": "03:49:05", "text": "友達や人々、そして私は「なぜ」"}, {"type": "subtitle", "time": 13748.91, "timestamp": "03:49:08", "text": "私はあなたの友達じゃないの？"}, {"type": "subtitle", "time": 13751.149, "timestamp": "03:49:11", "text": "私は、そして私は"}, {"type": "subtitle", "time": 13758.67, "timestamp": "03:49:18", "text": "あなたは"}, {"type": "subtitle", "time": 13761.429, "timestamp": "03:49:21", "text": "喧嘩、猫の喧嘩、ああ、なんて言える"}, {"type": "subtitle", "time": 13764.469, "timestamp": "03:49:24", "text": "時々、私たちは決して楽しむことができません"}, {"type": "subtitle", "time": 13768.429, "timestamp": "03:49:28", "text": "たとえ少しの間であっても、私たち自身"}, {"type": "subtitle", "time": 13772.87, "timestamp": "03:49:32", "text": "でも私はこの家が好きで、"}, {"type": "subtitle", "time": 13776.55, "timestamp": "03:49:36", "text": "Hみたいに、そう、彼らと遊ぼうよ"}, {"type": "subtitle", "time": 13779.03, "timestamp": "03:49:39", "text": "主もすべてと共に来ます"}, {"type": "subtitle", "time": 13781.07, "timestamp": "03:49:41", "text": "サイクルとすべてが私にもやって来る"}, {"type": "subtitle", "time": 13784.83, "timestamp": "03:49:44", "text": "私のshと物とすべてと一緒に"}, {"type": "subtitle", "time": 13786.349, "timestamp": "03:49:46", "text": "あなたはゲームをプレイし、"}, {"type": "subtitle", "time": 13788.59, "timestamp": "03:49:48", "text": "遊んでいた時間すべて"}, {"type": "subtitle", "time": 13793.03, "timestamp": "03:49:53", "text": "クラッシュ・オブ・クランともう一つ"}, {"type": "subtitle", "time": 13797.55, "timestamp": "03:49:57", "text": "そう、そして二人とも"}]
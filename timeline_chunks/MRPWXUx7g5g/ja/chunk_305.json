[{"type": "subtitle", "time": 18308.47, "timestamp": "05:05:08", "text": "あなたと"}, {"type": "subtitle", "time": 18312.23, "timestamp": "05:05:12", "text": "カトリーナ待って、どこにいるの"}, {"type": "subtitle", "time": 18315.39, "timestamp": "05:05:15", "text": "気楽に"}, {"type": "subtitle", "time": 18318.03, "timestamp": "05:05:18", "text": "足りない。この宝箱を全部手に入れる必要がある。"}, {"type": "subtitle", "time": 18319.83, "timestamp": "05:05:19", "text": "もし"}, {"type": "subtitle", "time": 18324.19, "timestamp": "05:05:24", "text": "彼は私のために何をするの？"}, {"type": "subtitle", "time": 18328.15, "timestamp": "05:05:28", "text": "貴重品でいっぱいの宝箱"}, {"type": "subtitle", "time": 18332.07, "timestamp": "05:05:32", "text": "潜在的な手がかり ジョイ こんにちは"}, {"type": "subtitle", "time": 18344.07, "timestamp": "05:05:44", "text": "えっと、Dはどこにいたの？次は"}, {"type": "subtitle", "time": 18356.15, "timestamp": "05:05:56", "text": "私がこの胸を手に入れて、そしてこれ"}]
[{"type": "subtitle", "time": 17584.51, "timestamp": "04:53:04", "text": "美術"}, {"type": "subtitle", "time": 17587.51, "timestamp": "04:53:07", "text": "でも私は全部集めました"}, {"type": "subtitle", "time": 17601.948, "timestamp": "04:53:21", "text": "[音楽]"}, {"type": "subtitle", "time": 17604.43, "timestamp": "04:53:24", "text": "それからそれから、ええと、それを手に入れたので、私は"}, {"type": "subtitle", "time": 17606.27, "timestamp": "04:53:26", "text": "市場"}, {"type": "subtitle", "time": 17609.31, "timestamp": "04:53:29", "text": "えーと、この市場が必要なんです"}, {"type": "subtitle", "time": 17611.54, "timestamp": "04:53:31", "text": "あれ"}, {"type": "subtitle", "time": 17624.99, "timestamp": "04:53:44", "text": "はい、こんにちは、マック、ようこそ、ようこそ、お元気ですか？"}, {"type": "subtitle", "time": 17629.548, "timestamp": "04:53:49", "text": "今日はどんな一日でしたか？それから、"}, {"type": "subtitle", "time": 17633.548, "timestamp": "04:53:53", "text": "息子の日とDJの日と雪の日"}, {"type": "subtitle", "time": 17635.99, "timestamp": "04:53:55", "text": "あなたに尋ねるのを忘れた日"}]
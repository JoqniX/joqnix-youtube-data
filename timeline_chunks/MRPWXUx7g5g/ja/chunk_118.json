[{"type": "subtitle", "time": 7082.589, "timestamp": "01:58:02", "text": "ええと、私はウォーキングから戻ってきました、そこには57がありました"}, {"type": "subtitle", "time": 7085.629, "timestamp": "01:58:05", "text": "日が経つとたくさんの人が"}, {"type": "subtitle", "time": 7088.87, "timestamp": "01:58:08", "text": "交通渋滞でしたが、私はここまで来ました"}, {"type": "subtitle", "time": 7092.629, "timestamp": "01:58:12", "text": "何かの歩く場所と推測"}, {"type": "subtitle", "time": 7095.709, "timestamp": "01:58:15", "text": "財布を忘れたので、文字通り"}, {"type": "subtitle", "time": 7098.629, "timestamp": "01:58:18", "text": "戻って私の"}, {"type": "subtitle", "time": 7102.189, "timestamp": "01:58:22", "text": "財布とそこに戻るとそれは"}, {"type": "subtitle", "time": 7104.669, "timestamp": "01:58:24", "text": "ほぼ1時間くらい、ほぼ"}, {"type": "subtitle", "time": 7108.39, "timestamp": "01:58:28", "text": "大きな仕事が短い仕事のようだ、ああ"}, {"type": "subtitle", "time": 7135.589, "timestamp": "01:58:55", "text": "たくさんあっていいな"}]
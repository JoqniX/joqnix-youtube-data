[{"type": "subtitle", "time": 19746.47, "timestamp": "05:29:06", "text": "何かが間違っている"}, {"type": "subtitle", "time": 19749.59, "timestamp": "05:29:09", "text": "私にとっては、おそらくそうでしょう。"}, {"type": "subtitle", "time": 19751.19, "timestamp": "05:29:11", "text": "了解"}, {"type": "subtitle", "time": 19753.67, "timestamp": "05:29:13", "text": "あなたと、あなたの"}, {"type": "subtitle", "time": 19769.2, "timestamp": "05:29:29", "text": "安定した商品"}, {"type": "subtitle", "time": 19775.59, "timestamp": "05:29:35", "text": "ズボンは何"}, {"type": "subtitle", "time": 19779.35, "timestamp": "05:29:39", "text": "火事待って、どうやって治癒したの？"}, {"type": "subtitle", "time": 19781.51, "timestamp": "05:29:41", "text": "ああ、どうして私は"}, {"type": "subtitle", "time": 19783.64, "timestamp": "05:29:43", "text": "治癒は治癒しない"}, {"type": "subtitle", "time": 19785.868, "timestamp": "05:29:45", "text": "[音楽]"}, {"type": "subtitle", "time": 19788.628, "timestamp": "05:29:48", "text": "癒す"}, {"type": "subtitle", "time": 19796.868, "timestamp": "05:29:56", "text": "じゃあね、彼は本当に"}]
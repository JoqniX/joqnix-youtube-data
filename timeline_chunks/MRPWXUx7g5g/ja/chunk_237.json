[{"type": "subtitle", "time": 14220.67, "timestamp": "03:57:00", "text": "シャワー、Discordサーバーなど"}, {"type": "subtitle", "time": 14222.99, "timestamp": "03:57:02", "text": "Apexか何か、だって文字通り見て"}, {"type": "subtitle", "time": 14225.59, "timestamp": "03:57:05", "text": "人々は毒舌を吐くのが好きだったり、送るのが好きだったりする"}, {"type": "subtitle", "time": 14228.67, "timestamp": "03:57:08", "text": "いろいろやって、毎回BANされる"}, {"type": "subtitle", "time": 14232.349, "timestamp": "03:57:12", "text": "毎日、ストリームママのようなすべてのもの"}, {"type": "subtitle", "time": 14235.11, "timestamp": "03:57:15", "text": "料理もそうだったので、私は種類を欲しくなかった"}, {"type": "subtitle", "time": 14237.269, "timestamp": "03:57:17", "text": "そんなことはしないだろう"}, {"type": "subtitle", "time": 14240.91, "timestamp": "03:57:20", "text": "誇りに思う、私は満足しないだろう"}, {"type": "subtitle", "time": 14242.71, "timestamp": "03:57:22", "text": "毒のようなものを持っている"}, {"type": "subtitle", "time": 14247.269, "timestamp": "03:57:27", "text": "支配的なコミュニティ"}, {"type": "subtitle", "time": 14249.99, "timestamp": "03:57:29", "text": "コミュニティとかそういうのは、私はしないだろう"}, {"type": "subtitle", "time": 14254.11, "timestamp": "03:57:34", "text": "幸せです、そして私は"}, {"type": "subtitle", "time": 14257.83, "timestamp": "03:57:37", "text": "えっと、彼らの気持ちはわかるよ、だって彼らは"}, {"type": "subtitle", "time": 14260.75, "timestamp": "03:57:40", "text": "Poストリーマーや"}, {"type": "subtitle", "time": 14264.75, "timestamp": "03:57:44", "text": "コミュニティはもう少しクレイジーになることができる"}, {"type": "subtitle", "time": 14268.229, "timestamp": "03:57:48", "text": "そう、主に考えていたのは"}, {"type": "subtitle", "time": 14271.389, "timestamp": "03:57:51", "text": "私がBで感じるであろうことについて"}, {"type": "subtitle", "time": 14275.55, "timestamp": "03:57:55", "text": "私のコミュニティは、まるで下にいるかのようです"}, {"type": "subtitle", "time": 14279.349, "timestamp": "03:57:59", "text": "アンダーではないが、多くの人は"}]
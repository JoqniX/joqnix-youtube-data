[{"type": "subtitle", "time": 18484.708, "timestamp": "05:08:04", "text": "死ぬ 私は円を持っています はい 円 はい 私は円を持っています"}, {"type": "subtitle", "time": 18488.868, "timestamp": "05:08:08", "text": "集める彼女はそこへ行く、あなたはそこへ行く円"}, {"type": "subtitle", "time": 18490.91, "timestamp": "05:08:10", "text": "マネッサ"}, {"type": "subtitle", "time": 18493.19, "timestamp": "05:08:13", "text": "私はします"}, {"type": "subtitle", "time": 18495.75, "timestamp": "05:08:15", "text": "私はとても幸運でした"}, {"type": "subtitle", "time": 18497.39, "timestamp": "05:08:17", "text": "お願いします、これが欲しいです"}, {"type": "subtitle", "time": 18507.51, "timestamp": "05:08:27", "text": "かわいい、そしてついに彼女が来た"}, {"type": "subtitle", "time": 18509.51, "timestamp": "05:08:29", "text": "家"}, {"type": "subtitle", "time": 18512.628, "timestamp": "05:08:32", "text": "やったー、でも、たくさん必要だよ"}, {"type": "subtitle", "time": 18515.43, "timestamp": "05:08:35", "text": "ドメインイベントのCレベル待機なし"}, {"type": "subtitle", "time": 18516.47, "timestamp": "05:08:36", "text": "おお"}, {"type": "subtitle", "time": 18520.19, "timestamp": "05:08:40", "text": "いいえ、ここであなたを待っています。どこにいるの？"}, {"type": "subtitle", "time": 18522.948, "timestamp": "05:08:42", "text": "ああ、なんてことだ、あなたは"}, {"type": "subtitle", "time": 18525.51, "timestamp": "05:08:45", "text": "わあ、来て"}, {"type": "subtitle", "time": 18527.15, "timestamp": "05:08:47", "text": "行く"}, {"type": "subtitle", "time": 18529.56, "timestamp": "05:08:49", "text": "はい"}]
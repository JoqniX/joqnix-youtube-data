[{"type": "subtitle", "time": 9785.269, "timestamp": "02:43:05", "text": "それはむしろ、私たちは"}, {"type": "subtitle", "time": 9788.83, "timestamp": "02:43:08", "text": "歌を歌ったことがない曲は言えません"}, {"type": "subtitle", "time": 9790.309, "timestamp": "02:43:10", "text": "最終決定しました"}, {"type": "subtitle", "time": 9793.91, "timestamp": "02:43:13", "text": "でも、楽しいだろうね。ただ、もっとバラエティ豊かにしたいだけなんだ。"}, {"type": "subtitle", "time": 9795.87, "timestamp": "02:43:15", "text": "私自身について、私は"}, {"type": "subtitle", "time": 9799.67, "timestamp": "02:43:19", "text": "私はほとんど歌えない歌手です"}, {"type": "subtitle", "time": 9801.75, "timestamp": "02:43:21", "text": "うん、歌ってる時はすごく悪い音だけど、私は"}, {"type": "subtitle", "time": 9804.91, "timestamp": "02:43:24", "text": "私の録音を聞いて、"}, {"type": "subtitle", "time": 9808.349, "timestamp": "02:43:28", "text": "ストリーム わからない 来ていない 来る"}, {"type": "subtitle", "time": 9812.07, "timestamp": "02:43:32", "text": "私の声の大きいものを受け入れることは、私たちみんなが"}, {"type": "subtitle", "time": 9817.63, "timestamp": "02:43:37", "text": "私たちの声はFなので、しかしある日それは"}, {"type": "subtitle", "time": 9822.269, "timestamp": "02:43:42", "text": "プロセスが正しければ、時間がかかるほど"}, {"type": "subtitle", "time": 9825.75, "timestamp": "02:43:45", "text": "そのプロセス、あ、待って、これは何ですか"}, {"type": "subtitle", "time": 9826.71, "timestamp": "02:43:46", "text": "電話"}, {"type": "subtitle", "time": 9829.87, "timestamp": "02:43:49", "text": "それは花火の歌だとあなたは知っています"}, {"type": "subtitle", "time": 9833.63, "timestamp": "02:43:53", "text": "火の歌を知ってるよ。Bの歌を忘れた。"}, {"type": "subtitle", "time": 9837.99, "timestamp": "02:43:57", "text": "それは、えっと、"}]
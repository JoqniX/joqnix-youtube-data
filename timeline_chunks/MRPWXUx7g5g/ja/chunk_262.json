[{"type": "subtitle", "time": 15721.229, "timestamp": "04:22:01", "text": "だから私の声は"}, {"type": "subtitle", "time": 15724.269, "timestamp": "04:22:04", "text": "浸すよ、うん、今起きたばかりだから気にしないで"}, {"type": "subtitle", "time": 15733.389, "timestamp": "04:22:13", "text": "脱ぎ捨てた"}, {"type": "subtitle", "time": 15736.189, "timestamp": "04:22:16", "text": "私は起きたばかりです"}, {"type": "subtitle", "time": 15742.91, "timestamp": "04:22:22", "text": "痛み、何が起こっているのか、待って"}, {"type": "subtitle", "time": 15750.429, "timestamp": "04:22:30", "text": "声：みんな元気？うん、こんにちは、マサ"}, {"type": "subtitle", "time": 15753.309, "timestamp": "04:22:33", "text": "立ち寄っていただきありがとうございます"}, {"type": "subtitle", "time": 15755.67, "timestamp": "04:22:35", "text": "待っている間に"}, {"type": "subtitle", "time": 15762.83, "timestamp": "04:22:42", "text": "こんにちは、DJIさん、お元気ですか？"}, {"type": "subtitle", "time": 15765.6, "timestamp": "04:22:45", "text": "チャットをアップするなんて、なんてことだ"}, {"type": "subtitle", "time": 15767.83, "timestamp": "04:22:47", "text": "[音楽]"}, {"type": "subtitle", "time": 15775.07, "timestamp": "04:22:55", "text": "B ああ神様 CH 待って、私の声はとても低いか"}, {"type": "subtitle", "time": 15777.429, "timestamp": "04:22:57", "text": "何かわからない"}]
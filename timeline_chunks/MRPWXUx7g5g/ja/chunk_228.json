[{"type": "subtitle", "time": 13681.51, "timestamp": "03:48:01", "text": "私のこの2人、この2人はまるで人間のようだ"}, {"type": "subtitle", "time": 13684.95, "timestamp": "03:48:04", "text": "隣人や友人のような人"}, {"type": "subtitle", "time": 13688.189, "timestamp": "03:48:08", "text": "あなたが彼を知っていたかもしれない友人"}, {"type": "subtitle", "time": 13690.75, "timestamp": "03:48:10", "text": "昔は公然とこう言っていた"}, {"type": "subtitle", "time": 13693.11, "timestamp": "03:48:13", "text": "私の友達はロイドです。彼の名前は"}, {"type": "subtitle", "time": 13695.91, "timestamp": "03:48:15", "text": "ロイド、そう言えると思うよ"}, {"type": "subtitle", "time": 13698.269, "timestamp": "03:48:18", "text": "ええ、ロイドとジョージはどちらも"}, {"type": "subtitle", "time": 13701.07, "timestamp": "03:48:21", "text": "私の子供たち"}, {"type": "subtitle", "time": 13703.349, "timestamp": "03:48:23", "text": "友達は誰を知っているか、私は"}, {"type": "subtitle", "time": 13705.79, "timestamp": "03:48:25", "text": "彼らとたくさんの思い出を作った"}, {"type": "subtitle", "time": 13707.87, "timestamp": "03:48:27", "text": "しかし、知っている"}, {"type": "subtitle", "time": 13711.07, "timestamp": "03:48:31", "text": "あなたが成長した方法"}, {"type": "subtitle", "time": 13714.07, "timestamp": "03:48:34", "text": "これは決して違う、むしろ私は"}, {"type": "subtitle", "time": 13715.149, "timestamp": "03:48:35", "text": "一人"}, {"type": "subtitle", "time": 13717.429, "timestamp": "03:48:37", "text": "だった"}, {"type": "subtitle", "time": 13720.269, "timestamp": "03:48:40", "text": "ジョージのように遠く離れて、自分の道を歩んだ"}, {"type": "subtitle", "time": 13723.03, "timestamp": "03:48:43", "text": "仲間と共に"}, {"type": "subtitle", "time": 13725.469, "timestamp": "03:48:45", "text": "友達、私は彼らがすべての時間が好きです"}, {"type": "subtitle", "time": 13727.95, "timestamp": "03:48:47", "text": "新しい友達ができたんだけど、"}, {"type": "subtitle", "time": 13731.149, "timestamp": "03:48:51", "text": "すごく嫉妬して、私はよく"}, {"type": "subtitle", "time": 13732.71, "timestamp": "03:48:52", "text": "彼らのPの前で"}, {"type": "subtitle", "time": 13734.91, "timestamp": "03:48:54", "text": "顔 私は"}, {"type": "subtitle", "time": 13738.03, "timestamp": "03:48:58", "text": "そういう風に、私はよく見かけると立ち去る"}]
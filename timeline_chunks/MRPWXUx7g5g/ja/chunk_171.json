[{"type": "subtitle", "time": 10265.469, "timestamp": "02:51:05", "text": "緑色の物みたいなものだと思う"}, {"type": "subtitle", "time": 10267.19, "timestamp": "02:51:07", "text": "これが問題なんです"}, {"type": "subtitle", "time": 10270.07, "timestamp": "02:51:10", "text": "爆竹のように"}, {"type": "subtitle", "time": 10272.79, "timestamp": "02:51:12", "text": "物が包まれていて、それが触れると"}, {"type": "subtitle", "time": 10277.51, "timestamp": "02:51:17", "text": "爆発する"}, {"type": "subtitle", "time": 10280.63, "timestamp": "02:51:20", "text": "ちょっとした取引はありますが"}, {"type": "subtitle", "time": 10283.67, "timestamp": "02:51:23", "text": "私が見ているもの"}, {"type": "subtitle", "time": 10290.15, "timestamp": "02:51:30", "text": "y"}, {"type": "subtitle", "time": 10297.63, "timestamp": "02:51:37", "text": "食べて、確認させて"}, {"type": "subtitle", "time": 10300.469, "timestamp": "02:51:40", "text": "私の担当している何かが少し雨が降っている"}, {"type": "subtitle", "time": 10304.03, "timestamp": "02:51:44", "text": "少しですが、私は1日間持ちこたえることができました"}, {"type": "subtitle", "time": 10305.469, "timestamp": "02:51:45", "text": "時間のような"}]
[{"type": "subtitle", "time": 8761.79, "timestamp": "02:26:01", "text": "別々に計画すればもっと多くのことができる"}, {"type": "subtitle", "time": 8766.11, "timestamp": "02:26:06", "text": "フレンドリーで、あなたが知っているすべて、そう、だから"}, {"type": "subtitle", "time": 8767.429, "timestamp": "02:26:07", "text": "これ"}, {"type": "subtitle", "time": 8774.87, "timestamp": "02:26:14", "text": "無料"}, {"type": "subtitle", "time": 8777.349, "timestamp": "02:26:17", "text": "少なくとも"}, {"type": "subtitle", "time": 8783.23, "timestamp": "02:26:23", "text": "どういうわけか、そして今では私は依存していません"}, {"type": "subtitle", "time": 8786.87, "timestamp": "02:26:26", "text": "人々にそれほど多くはなかったが、徐々に始まった"}, {"type": "subtitle", "time": 8789.429, "timestamp": "02:26:29", "text": "少しだけ"}, {"type": "subtitle", "time": 8792.55, "timestamp": "02:26:32", "text": "えっと、OCCかどうかはわかりません"}, {"type": "subtitle", "time": 8794.75, "timestamp": "02:26:34", "text": "セレブ"}, {"type": "subtitle", "time": 8799.07, "timestamp": "02:26:39", "text": "時々私はいつも尋ねるので"}, {"type": "subtitle", "time": 8802.91, "timestamp": "02:26:42", "text": "私自身は大丈夫ですか、他の人に尋ねても大丈夫ですか"}, {"type": "subtitle", "time": 8804.15, "timestamp": "02:26:44", "text": "人々の"}, {"type": "subtitle", "time": 8809.19, "timestamp": "02:26:49", "text": "助けて、あなたも知っているように、それはそうではない、そうではない"}, {"type": "subtitle", "time": 8811.349, "timestamp": "02:26:51", "text": "それほど悪くはないが、"}, {"type": "subtitle", "time": 8815.309, "timestamp": "02:26:55", "text": "あまり良くない、まるで車ばかりみたいだ"}, {"type": "subtitle", "time": 8818.63, "timestamp": "02:26:58", "text": "それはすべて私のような車なので、それは"}]
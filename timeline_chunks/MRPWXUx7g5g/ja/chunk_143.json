[{"type": "subtitle", "time": 8581.87, "timestamp": "02:23:01", "text": "今までに2、3着の服か何か"}, {"type": "subtitle", "time": 8583.19, "timestamp": "02:23:03", "text": "しかし"}, {"type": "subtitle", "time": 8587.07, "timestamp": "02:23:07", "text": "繰り返しますが、実際にすべてを行う必要はありません"}, {"type": "subtitle", "time": 8588.59, "timestamp": "02:23:08", "text": "あなた自身の努力で実際に"}, {"type": "subtitle", "time": 8590.87, "timestamp": "02:23:10", "text": "手数料は、私の口座にお金がある場合に発生します。"}, {"type": "subtitle", "time": 8591.91, "timestamp": "02:23:11", "text": "ケース 私は"}, {"type": "subtitle", "time": 8593.51, "timestamp": "02:23:13", "text": "壊れた"}, {"type": "subtitle", "time": 8597.07, "timestamp": "02:23:17", "text": "だから少なくとも"}, {"type": "subtitle", "time": 8601.469, "timestamp": "02:23:21", "text": "貯金するか、私の仕事をする。私は行くと思う。"}, {"type": "subtitle", "time": 8604.91, "timestamp": "02:23:24", "text": "自分でやる道だから"}, {"type": "subtitle", "time": 8608.03, "timestamp": "02:23:28", "text": "もう一度、私は願う"}, {"type": "subtitle", "time": 8610.469, "timestamp": "02:23:30", "text": "聖なることをする"}, {"type": "subtitle", "time": 8615.19, "timestamp": "02:23:35", "text": "私自身もそうすることに抵抗を感じない"}, {"type": "subtitle", "time": 8618.51, "timestamp": "02:23:38", "text": "私自身ですが、VPNに戻ると"}, {"type": "subtitle", "time": 8620.91, "timestamp": "02:23:40", "text": "つながっていたから私たちはある意味"}, {"type": "subtitle", "time": 8624.15, "timestamp": "02:23:44", "text": "ラグがあっても大丈夫なので、主に"}, {"type": "subtitle", "time": 8625.87, "timestamp": "02:23:45", "text": "私"}, {"type": "subtitle", "time": 8627.469, "timestamp": "02:23:47", "text": "もの"}, {"type": "subtitle", "time": 8631.269, "timestamp": "02:23:51", "text": "私がしたいことは"}, {"type": "subtitle", "time": 8634.03, "timestamp": "02:23:54", "text": "私はこれについてよく話します"}, {"type": "subtitle", "time": 8637.269, "timestamp": "02:23:57", "text": "やり方ややりたいことがたくさんあって、"}, {"type": "subtitle", "time": 8639.309, "timestamp": "02:23:59", "text": "それらすべて"}]
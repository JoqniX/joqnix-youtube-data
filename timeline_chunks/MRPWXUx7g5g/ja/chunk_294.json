[{"type": "subtitle", "time": 17644.23, "timestamp": "04:54:04", "text": "みんな、ちょっと開けさせてくれ。"}, {"type": "subtitle", "time": 17651.19, "timestamp": "04:54:11", "text": "upap なので、CH を確認して、私たちは"}, {"type": "subtitle", "time": 17653.23, "timestamp": "04:54:13", "text": "これ"}, {"type": "subtitle", "time": 17656.83, "timestamp": "04:54:16", "text": "隅っこで信じないで、私は抑えなければならない"}, {"type": "subtitle", "time": 17658.83, "timestamp": "04:54:18", "text": "あの表情を思い出すたびに笑顔になる"}, {"type": "subtitle", "time": 17660.83, "timestamp": "04:54:20", "text": "私が彼らに知らせたときの家臣たちの顔"}, {"type": "subtitle", "time": 17664.27, "timestamp": "04:54:24", "text": "今日の私の計画は、パニックに陥った新しい"}, {"type": "subtitle", "time": 17666.11, "timestamp": "04:54:26", "text": "できないから、勇気を出して言わなければならない"}, {"type": "subtitle", "time": 17668.788, "timestamp": "04:54:28", "text": "何か変更があったか"}, {"type": "subtitle", "time": 17670.43, "timestamp": "04:54:30", "text": "また"}, {"type": "subtitle", "time": 17682.07, "timestamp": "04:54:42", "text": "1つは、その場所に行く必要がある。Bにしよう。"}, {"type": "subtitle", "time": 17685.03, "timestamp": "04:54:45", "text": "プロフィールにYing Yingを追加してもらえますか、Jo？"}, {"type": "subtitle", "time": 17689.67, "timestamp": "04:54:49", "text": "待って、Yは私のプロフィールにあるよ、見て、私の"}]
[{"type": "subtitle", "time": 1625.51, "timestamp": "00:27:05", "text": "[音楽]"}, {"type": "subtitle", "time": 1626.83, "timestamp": "00:27:06", "text": "待って、私の"}, {"type": "subtitle", "time": 1629.389, "timestamp": "00:27:09", "text": "携帯電話を寝かしつけたら"}, {"type": "subtitle", "time": 1646.83, "timestamp": "00:27:26", "text": "だから私は5時に寝た 5 2 6 6 7 8 9 4"}, {"type": "subtitle", "time": 1649.07, "timestamp": "00:27:29", "text": "何時間も眠っている"}, {"type": "subtitle", "time": 1675.35, "timestamp": "00:27:55", "text": "いいえ、ちょっと待ってください。"}]
[{"type": "subtitle", "time": 19985.15, "timestamp": "05:33:05", "text": "えっと、ここはもう終わりですよね？"}, {"type": "subtitle", "time": 19990.628, "timestamp": "05:33:10", "text": "マーク、そしてこれもマルクス"}, {"type": "subtitle", "time": 19994.27, "timestamp": "05:33:14", "text": "完了しました。"}, {"type": "subtitle", "time": 19998.59, "timestamp": "05:33:18", "text": "そのうち2人はここからだと思います"}, {"type": "subtitle", "time": 20002.03, "timestamp": "05:33:22", "text": "私たちは"}, {"type": "subtitle", "time": 20005.35, "timestamp": "05:33:25", "text": "完了したか確認します"}, {"type": "subtitle", "time": 20010.19, "timestamp": "05:33:30", "text": "後で彼は、ここが最後の場所だと思う"}, {"type": "subtitle", "time": 20013.59, "timestamp": "05:33:33", "text": "まさにその通り、彼ではないが、同じモデルだ。"}, {"type": "subtitle", "time": 20020.67, "timestamp": "05:33:40", "text": "テレポート"}, {"type": "subtitle", "time": 20023.03, "timestamp": "05:33:43", "text": "これは自然なものではないように見える"}, {"type": "subtitle", "time": 20025.15, "timestamp": "05:33:45", "text": "鍵は何か巨大なものを切断したように見える"}, {"type": "subtitle", "time": 20026.708, "timestamp": "05:33:46", "text": "その場所を通して"}, {"type": "subtitle", "time": 20029.47, "timestamp": "05:33:49", "text": "代わりに、実際に突進すれば"}, {"type": "subtitle", "time": 20031.14, "timestamp": "05:33:51", "text": "より"}, {"type": "subtitle", "time": 20032.91, "timestamp": "05:33:52", "text": "[音楽]"}, {"type": "subtitle", "time": 20036.99, "timestamp": "05:33:56", "text": "蓄積する、ああそれはドラゴンの背骨のようなものか"}, {"type": "subtitle", "time": 20038.43, "timestamp": "05:33:58", "text": "[音楽]"}]
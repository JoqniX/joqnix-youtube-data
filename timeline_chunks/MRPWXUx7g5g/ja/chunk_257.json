[{"type": "subtitle", "time": 15422.109, "timestamp": "04:17:02", "text": "文字通り"}, {"type": "subtitle", "time": 15433.87, "timestamp": "04:17:13", "text": "どこでどこで"}, {"type": "subtitle", "time": 15435.91, "timestamp": "04:17:15", "text": "文字通り、最後にそれを見た"}, {"type": "subtitle", "time": 15438.269, "timestamp": "04:17:18", "text": "木がああ"}, {"type": "subtitle", "time": 15441.95, "timestamp": "04:17:21", "text": "神よ、それが目に見えるものだったかどうかはわかりません"}, {"type": "subtitle", "time": 15444.87, "timestamp": "04:17:24", "text": "でも、あなたがそれを見たと言って、もしそれが"}, {"type": "subtitle", "time": 15449.07, "timestamp": "04:17:29", "text": "ピクセルみたいにカチカチ音がしたけど、まあ、とにかく"}, {"type": "subtitle", "time": 15451.309, "timestamp": "04:17:31", "text": "ここで終わりにします。改めてありがとうございました。"}, {"type": "subtitle", "time": 15463.55, "timestamp": "04:17:43", "text": "今日"}, {"type": "subtitle", "time": 15467.269, "timestamp": "04:17:47", "text": "sh アップロードしていません"}, {"type": "subtitle", "time": 15471.83, "timestamp": "04:17:51", "text": "アトミック・ハーツ、最後のボードと"}, {"type": "subtitle", "time": 15474.429, "timestamp": "04:17:54", "text": "2つと、この最後の2つは歩いています"}, {"type": "subtitle", "time": 15479.269, "timestamp": "04:17:59", "text": "ストリームは車にアップロードするだけです"}]
[{"type": "subtitle", "time": 7623.39, "timestamp": "02:07:03", "text": "はい、私はまだ元気です。ラッシュ、ああ、なんてことだ"}, {"type": "subtitle", "time": 7642.93, "timestamp": "02:07:22", "text": "ああ、神様、私はもっとスーパーです"}, {"type": "subtitle", "time": 7665.91, "timestamp": "02:07:45", "text": "えっと、どちらかというと"}, {"type": "subtitle", "time": 7669.47, "timestamp": "02:07:49", "text": "えっと、なんて言うんだっけ？"}, {"type": "subtitle", "time": 7674.549, "timestamp": "02:07:54", "text": "えっと、皆さんもご存知のように、皆さんのほとんどは"}, {"type": "subtitle", "time": 7679.709, "timestamp": "02:07:59", "text": "えーと、メンバーもこんな感じ"}]
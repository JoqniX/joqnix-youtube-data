[{"type": "subtitle", "time": 12423.55, "timestamp": "03:27:03", "text": "新世代の作品みたいだけど、私は"}, {"type": "subtitle", "time": 12426.99, "timestamp": "03:27:06", "text": "大丈夫だよ、文字通り学ぶから。"}, {"type": "subtitle", "time": 12430.95, "timestamp": "03:27:10", "text": "最初は古い方、それから私は"}, {"type": "subtitle", "time": 12433.83, "timestamp": "03:27:13", "text": "新しいものを使うことができたが、私は"}, {"type": "subtitle", "time": 12437.349, "timestamp": "03:27:17", "text": "間違っている、学ぶ必要がある、もし学ぶなら"}, {"type": "subtitle", "time": 12439.95, "timestamp": "03:27:19", "text": "古いものでも、まだ学び直す必要がある"}, {"type": "subtitle", "time": 12443.07, "timestamp": "03:27:23", "text": "新しいもののためのすべて"}, {"type": "subtitle", "time": 12446.91, "timestamp": "03:27:26", "text": "どうやって、それが"}, {"type": "subtitle", "time": 12451.309, "timestamp": "03:27:31", "text": "学んだことや、そういうことについてはこう思う"}, {"type": "subtitle", "time": 12456.55, "timestamp": "03:27:36", "text": "洗濯してもあまり良くなかったのは"}, {"type": "subtitle", "time": 12457.95, "timestamp": "03:27:37", "text": "それはちょっと"}, {"type": "subtitle", "time": 12461.189, "timestamp": "03:27:41", "text": "有毒だ、あまり考えられなかった"}, {"type": "subtitle", "time": 12464.67, "timestamp": "03:27:44", "text": "いろいろ、そして文字通り私はよくやります"}, {"type": "subtitle", "time": 12467.309, "timestamp": "03:27:47", "text": "うまく混ぜ合わせた方がいいし、すべて"}, {"type": "subtitle", "time": 12470.75, "timestamp": "03:27:50", "text": "しかし、インストラクターはそこにいなかった"}, {"type": "subtitle", "time": 12473.349, "timestamp": "03:27:53", "text": "そして彼が来ると私は緊張して"}, {"type": "subtitle", "time": 12475.07, "timestamp": "03:27:55", "text": "台無しにして"}, {"type": "subtitle", "time": 12478.83, "timestamp": "03:27:58", "text": "すべて、そして私は、そしてその男は"}]
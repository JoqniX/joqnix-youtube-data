[{"type": "subtitle", "time": 10451.79, "timestamp": "02:54:11", "text": "ハニーによってそれは"}, {"type": "subtitle", "time": 10476.55, "timestamp": "02:54:36", "text": "私はこれが正しいと思う、人々"}, {"type": "subtitle", "time": 10478.91, "timestamp": "02:54:38", "text": "まるで人々がこの"}, {"type": "subtitle", "time": 10481.55, "timestamp": "02:54:41", "text": "人々はひび割れている"}, {"type": "subtitle", "time": 10483.92, "timestamp": "02:54:43", "text": "いいえ、そして"}, {"type": "subtitle", "time": 10485.269, "timestamp": "02:54:45", "text": "[音楽]"}, {"type": "subtitle", "time": 10487.95, "timestamp": "02:54:47", "text": "これは新しいことだと思う。"}, {"type": "subtitle", "time": 10492.51, "timestamp": "02:54:52", "text": "今までこれを見たことがあるけど、私の新しい新しい"}]
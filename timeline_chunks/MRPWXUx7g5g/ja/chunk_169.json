[{"type": "subtitle", "time": 10144.87, "timestamp": "02:49:04", "text": "ええ、試す必要があるかもしれません"}, {"type": "subtitle", "time": 10154.15, "timestamp": "02:49:14", "text": "[音楽]"}, {"type": "subtitle", "time": 10157.15, "timestamp": "02:49:17", "text": "人々を噛む"}, {"type": "subtitle", "time": 10161.67, "timestamp": "02:49:21", "text": "Cを売ったりするような"}, {"type": "subtitle", "time": 10164.99, "timestamp": "02:49:24", "text": "いいけど、買わないと思う"}, {"type": "subtitle", "time": 10167.349, "timestamp": "02:49:27", "text": "それはそれを投げたい"}, {"type": "subtitle", "time": 10170.15, "timestamp": "02:49:30", "text": "地面とシングのように"}, {"type": "subtitle", "time": 10183.03, "timestamp": "02:49:43", "text": "ええ、私は"}, {"type": "subtitle", "time": 10185.67, "timestamp": "02:49:45", "text": "その男がそれを売らなかったことに驚いた"}]
[{"type": "subtitle", "time": 13802.95, "timestamp": "03:50:02", "text": "同じテント、私のテント、たぶん10年生"}, {"type": "subtitle", "time": 13805.71, "timestamp": "03:50:05", "text": "ジョージは11年生と12年生"}, {"type": "subtitle", "time": 13809.149, "timestamp": "03:50:09", "text": "ロイドは同じ時期に"}, {"type": "subtitle", "time": 13813.309, "timestamp": "03:50:13", "text": "学校で、私は「なんで詐欺学校なの？」と思いました"}, {"type": "subtitle", "time": 13817.67, "timestamp": "03:50:17", "text": "いいえ、でもボー・ジェイとロードですが、科学では"}, {"type": "subtitle", "time": 13819.63, "timestamp": "03:50:19", "text": "その間私は"}, {"type": "subtitle", "time": 13823.149, "timestamp": "03:50:23", "text": "人文科学で私は"}, {"type": "subtitle", "time": 13830.429, "timestamp": "03:50:30", "text": "うん、時々私はもっとこう感じる"}, {"type": "subtitle", "time": 13849.95, "timestamp": "03:50:49", "text": "私を見て、もっと詳しく"}, {"type": "subtitle", "time": 13851.91, "timestamp": "03:50:51", "text": "話せるように"}, {"type": "subtitle", "time": 13859.83, "timestamp": "03:50:59", "text": "ホームストリーミングは"}]
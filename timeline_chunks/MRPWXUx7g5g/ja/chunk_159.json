[{"type": "subtitle", "time": 9547.87, "timestamp": "02:39:07", "text": "ああ、私は話していた"}, {"type": "subtitle", "time": 9550.429, "timestamp": "02:39:10", "text": "たくさんありますが、これらのストリームに関しては"}, {"type": "subtitle", "time": 9553.59, "timestamp": "02:39:13", "text": "話し続けなければならない、それはむしろ"}, {"type": "subtitle", "time": 9557.75, "timestamp": "02:39:17", "text": "運動したり、話すのが好きなこと"}, {"type": "subtitle", "time": 9560.99, "timestamp": "02:39:20", "text": "スピーキングスキルとかその他諸々"}, {"type": "subtitle", "time": 9563.71, "timestamp": "02:39:23", "text": "兄弟、それは私が理解した唯一のことだ"}, {"type": "subtitle", "time": 9564.75, "timestamp": "02:39:24", "text": "から"}, {"type": "subtitle", "time": 9567.95, "timestamp": "02:39:27", "text": "メイン部分をストリーミングするのは、"}, {"type": "subtitle", "time": 9570.429, "timestamp": "02:39:30", "text": "話すこととそれを維持することが好きです"}, {"type": "subtitle", "time": 9572.03, "timestamp": "02:39:32", "text": "面白くないなら"}, {"type": "subtitle", "time": 9573.59, "timestamp": "02:39:33", "text": "面白いから話し続けてください"}, {"type": "subtitle", "time": 9576.83, "timestamp": "02:39:36", "text": "私は知らないと思う、ただBLがたくさんある、いやそれは"}, {"type": "subtitle", "time": 9584.51, "timestamp": "02:39:44", "text": "知る"}, {"type": "subtitle", "time": 9587.269, "timestamp": "02:39:47", "text": "わかりました"}, {"type": "subtitle", "time": 9589.95, "timestamp": "02:39:49", "text": "無料でやるなら、時間もかかるよ"}, {"type": "subtitle", "time": 9592.11, "timestamp": "02:39:52", "text": "私は時間が好きです"}, {"type": "subtitle", "time": 9596.91, "timestamp": "02:39:56", "text": "話すのが好き、なぜ好きか、ストリームなどすべて"}, {"type": "subtitle", "time": 9599.389, "timestamp": "02:39:59", "text": "それは私に、"}]
[{"type": "subtitle", "time": 10204.71, "timestamp": "02:50:04", "text": "他去的那些团体，他逃走了，他真的"}, {"type": "subtitle", "time": 10207.71, "timestamp": "02:50:07", "text": "就这么过去了，然后他就像是扔东西一样"}, {"type": "subtitle", "time": 10220.99, "timestamp": "02:50:20", "text": "滥用，比如字面意义上的滥用"}, {"type": "subtitle", "time": 10224.429, "timestamp": "02:50:24", "text": "直接把它扔给了那些人"}, {"type": "subtitle", "time": 10225.19, "timestamp": "02:50:25", "text": "是"}, {"type": "subtitle", "time": 10230.11, "timestamp": "02:50:30", "text": "我坐着就像在吓唬他们一样"}, {"type": "subtitle", "time": 10232.71, "timestamp": "02:50:32", "text": "哇，那真是太棒了！"}, {"type": "subtitle", "time": 10247.71, "timestamp": "02:50:47", "text": "哇，原来你听到的就是这个。"}, {"type": "subtitle", "time": 10250.11, "timestamp": "02:50:50", "text": "火花声"}, {"type": "subtitle", "time": 10253.67, "timestamp": "02:50:53", "text": "他直接就把它扔了出去，就像……"}, {"type": "subtitle", "time": 10256.389, "timestamp": "02:50:56", "text": "塑料玩意儿之类的东西看起来像"}, {"type": "subtitle", "time": 10258.11, "timestamp": "02:50:58", "text": "一个"}]
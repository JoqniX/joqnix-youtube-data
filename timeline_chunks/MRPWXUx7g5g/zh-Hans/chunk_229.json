[{"type": "subtitle", "time": 13740.87, "timestamp": "03:49:00", "text": "他们玩得很开心，尤其是他们的pH值。"}, {"type": "subtitle", "time": 13745.79, "timestamp": "03:49:05", "text": "朋友们，还有其他人，我当时就想：为什么？"}, {"type": "subtitle", "time": 13748.91, "timestamp": "03:49:08", "text": "我是你的朋友吗？我不是你的朋友吗？"}, {"type": "subtitle", "time": 13751.149, "timestamp": "03:49:11", "text": "我是，我"}, {"type": "subtitle", "time": 13758.67, "timestamp": "03:49:18", "text": "你要去一个充满"}, {"type": "subtitle", "time": 13761.429, "timestamp": "03:49:21", "text": "打架，猫打架，你可以说哦，就像"}, {"type": "subtitle", "time": 13764.469, "timestamp": "03:49:24", "text": "有时我从未让我们享受过"}, {"type": "subtitle", "time": 13768.429, "timestamp": "03:49:28", "text": "我们自己，即使只是一点点。"}, {"type": "subtitle", "time": 13772.87, "timestamp": "03:49:32", "text": "但我还是想带我们去看看这栋房子，然后……"}, {"type": "subtitle", "time": 13776.55, "timestamp": "03:49:36", "text": "就像H说的，我们和他们一起玩吧。"}, {"type": "subtitle", "time": 13779.03, "timestamp": "03:49:39", "text": "主所赐的一切也都与此有关。"}, {"type": "subtitle", "time": 13781.07, "timestamp": "03:49:41", "text": "循环和所有的一切我也来了"}, {"type": "subtitle", "time": 13784.83, "timestamp": "03:49:44", "text": "带着我的那些东西和所有东西"}, {"type": "subtitle", "time": 13786.349, "timestamp": "03:49:46", "text": "你玩游戏，"}, {"type": "subtitle", "time": 13788.59, "timestamp": "03:49:48", "text": "我们玩耍的那段时间的一切"}, {"type": "subtitle", "time": 13793.03, "timestamp": "03:49:53", "text": "部落冲突和其他一些东西"}, {"type": "subtitle", "time": 13797.55, "timestamp": "03:49:57", "text": "是的，而且他们俩都在场。"}]
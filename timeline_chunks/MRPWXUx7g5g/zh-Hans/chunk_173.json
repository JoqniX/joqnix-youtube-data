[{"type": "subtitle", "time": 10383.229, "timestamp": "02:53:03", "text": "刮风，我可以……"}, {"type": "subtitle", "time": 10385.83, "timestamp": "02:53:05", "text": "人们渴望并喜欢人们交谈"}, {"type": "subtitle", "time": 10395.79, "timestamp": "02:53:15", "text": "我想知道的事"}, {"type": "subtitle", "time": 10399.87, "timestamp": "02:53:19", "text": "如果我应该继续这样下去"}, {"type": "subtitle", "time": 10402.63, "timestamp": "02:53:22", "text": "声音的"}, {"type": "subtitle", "time": 10404.99, "timestamp": "02:53:24", "text": "单核细胞增多症，我想知道我是否应该"}, {"type": "subtitle", "time": 10407.79, "timestamp": "02:53:27", "text": "保持这样"}, {"type": "subtitle", "time": 10409.99, "timestamp": "02:53:29", "text": "工作室 我不知道 我不知道我是否"}, {"type": "subtitle", "time": 10423.99, "timestamp": "02:53:43", "text": "是我身后的这些鱼在作祟"}, {"type": "subtitle", "time": 10425.95, "timestamp": "02:53:45", "text": "喜欢"}, {"type": "subtitle", "time": 10429.91, "timestamp": "02:53:49", "text": "声音"}, {"type": "subtitle", "time": 10433.429, "timestamp": "02:53:53", "text": "没错，她9岁了。"}, {"type": "subtitle", "time": 10436.99, "timestamp": "02:53:56", "text": "我不知道会持续多久。"}]
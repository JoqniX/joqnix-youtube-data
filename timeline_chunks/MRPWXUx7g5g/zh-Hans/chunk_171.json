[{"type": "subtitle", "time": 10265.469, "timestamp": "02:51:05", "text": "我说的那个东西，就像一个绿色的东西，我想。"}, {"type": "subtitle", "time": 10267.19, "timestamp": "02:51:07", "text": "这就是事情的本质。"}, {"type": "subtitle", "time": 10270.07, "timestamp": "02:51:10", "text": "像鞭炮一样"}, {"type": "subtitle", "time": 10272.79, "timestamp": "02:51:12", "text": "包裹起来的东西，当它接触时"}, {"type": "subtitle", "time": 10277.51, "timestamp": "02:51:17", "text": "爆炸"}, {"type": "subtitle", "time": 10280.63, "timestamp": "02:51:20", "text": "所以，虽然有点小交易，但还是有的。"}, {"type": "subtitle", "time": 10283.67, "timestamp": "02:51:23", "text": "我观看"}, {"type": "subtitle", "time": 10290.15, "timestamp": "02:51:30", "text": "是"}, {"type": "subtitle", "time": 10297.63, "timestamp": "02:51:37", "text": "吃吧，让我看看"}, {"type": "subtitle", "time": 10300.469, "timestamp": "02:51:40", "text": "我负责的事情有点进展，下点小雨。"}, {"type": "subtitle", "time": 10304.03, "timestamp": "02:51:44", "text": "有点，但我还是坚持了1"}, {"type": "subtitle", "time": 10305.469, "timestamp": "02:51:45", "text": "像小时一样"}]
[{"type": "subtitle", "time": 14041.91, "timestamp": "03:54:01", "text": "好吧，我不知道前任是否可爱，但是"}, {"type": "subtitle", "time": 14056.87, "timestamp": "03:54:16", "text": "如果我"}, {"type": "subtitle", "time": 14059.07, "timestamp": "03:54:19", "text": "我会无家可归吗？我会走在……"}, {"type": "subtitle", "time": 14065.269, "timestamp": "03:54:25", "text": "这种想法突然冒了出来，哦，我的天哪"}, {"type": "subtitle", "time": 14066.149, "timestamp": "03:54:26", "text": "天哪，我是"}, {"type": "subtitle", "time": 14079.469, "timestamp": "03:54:39", "text": "是的，但无论如何，你说的都是对的。"}, {"type": "subtitle", "time": 14084.59, "timestamp": "03:54:44", "text": "谈论我的两个最好的朋友"}, {"type": "subtitle", "time": 14086.59, "timestamp": "03:54:46", "text": "当我们来到"}, {"type": "subtitle", "time": 14088.87, "timestamp": "03:54:48", "text": "那里的直播和其他两个直播一样。"}, {"type": "subtitle", "time": 14090.99, "timestamp": "03:54:50", "text": "我也和朋友们一起玩过这款游戏"}, {"type": "subtitle", "time": 14093.309, "timestamp": "03:54:53", "text": "他们就像同学一样"}, {"type": "subtitle", "time": 14096.469, "timestamp": "03:54:56", "text": "我们从有毒环境中出来的东西"}, {"type": "subtitle", "time": 14099.75, "timestamp": "03:54:59", "text": "友谊，但我却没能做到。"}]
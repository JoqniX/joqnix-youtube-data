[{"type": "subtitle", "time": 11889.229, "timestamp": "03:18:09", "text": "哇，你觉得我应该磨它吗？"}, {"type": "subtitle", "time": 11892.229, "timestamp": "03:18:12", "text": "我觉得我不应该把钱浪费在井上。"}, {"type": "subtitle", "time": 11893.95, "timestamp": "03:18:13", "text": "F"}, {"type": "subtitle", "time": 11897.03, "timestamp": "03:18:17", "text": "哦，就像如果我要买的话……"}, {"type": "subtitle", "time": 11899.83, "timestamp": "03:18:19", "text": "仅供……"}, {"type": "subtitle", "time": 11903.67, "timestamp": "03:18:23", "text": "剥掉手枪皮肤，呃，不，我"}, {"type": "subtitle", "time": 11905.67, "timestamp": "03:18:25", "text": "不，我不会，我想我不会。"}, {"type": "subtitle", "time": 11908.95, "timestamp": "03:18:28", "text": "幻影的切换"}, {"type": "subtitle", "time": 11915.269, "timestamp": "03:18:35", "text": "玛奇玛的昵称"}, {"type": "subtitle", "time": 11918.189, "timestamp": "03:18:38", "text": "艾玛，我想我不会"}, {"type": "subtitle", "time": 11927.269, "timestamp": "03:18:47", "text": "我想我喜欢我当时也在想如果我"}, {"type": "subtitle", "time": 11930.11, "timestamp": "03:18:50", "text": "即使我买了手枪皮肤之类的东西。"}, {"type": "subtitle", "time": 11931.07, "timestamp": "03:18:51", "text": "或者"}, {"type": "subtitle", "time": 11934.469, "timestamp": "03:18:54", "text": "有一件事我没等你，你知道的。"}, {"type": "subtitle", "time": 11938.55, "timestamp": "03:18:58", "text": "我要停止的"}]
[{"type": "subtitle", "time": 14220.67, "timestamp": "03:57:00", "text": "淋浴间、Discord 服务器之类的东西"}, {"type": "subtitle", "time": 14222.99, "timestamp": "03:57:02", "text": "Apex之类的，因为真的看到了"}, {"type": "subtitle", "time": 14225.59, "timestamp": "03:57:05", "text": "有些人喜欢恶语相向，或者喜欢发送信息。"}, {"type": "subtitle", "time": 14228.67, "timestamp": "03:57:08", "text": "运行程序然后被封号"}, {"type": "subtitle", "time": 14232.349, "timestamp": "03:57:12", "text": "白天做所有这些事，比如直播妈妈"}, {"type": "subtitle", "time": 14235.11, "timestamp": "03:57:15", "text": "菜也一样，所以我不想吃那种。"}, {"type": "subtitle", "time": 14237.269, "timestamp": "03:57:17", "text": "如果那样的话，我就不会……"}, {"type": "subtitle", "time": 14240.91, "timestamp": "03:57:20", "text": "骄傲到我都无法满足"}, {"type": "subtitle", "time": 14242.71, "timestamp": "03:57:22", "text": "就像有毒物质一样"}, {"type": "subtitle", "time": 14247.269, "timestamp": "03:57:27", "text": "社区就像一个控制者"}, {"type": "subtitle", "time": 14249.99, "timestamp": "03:57:29", "text": "社区之类的，我不会是"}, {"type": "subtitle", "time": 14254.11, "timestamp": "03:57:34", "text": "我很高兴，我"}, {"type": "subtitle", "time": 14257.83, "timestamp": "03:57:37", "text": "就像，嗯，我理解他们，因为他们"}, {"type": "subtitle", "time": 14260.75, "timestamp": "03:57:40", "text": "像 Po 主播一样观看"}, {"type": "subtitle", "time": 14264.75, "timestamp": "03:57:44", "text": "社区可能会变得更疯狂一些。"}, {"type": "subtitle", "time": 14268.229, "timestamp": "03:57:48", "text": "所以，嗯，我当时主要在想……"}, {"type": "subtitle", "time": 14271.389, "timestamp": "03:57:51", "text": "关于我 B 在里面的感受"}, {"type": "subtitle", "time": 14275.55, "timestamp": "03:57:55", "text": "我的社区就像他们一样"}, {"type": "subtitle", "time": 14279.349, "timestamp": "03:57:59", "text": "就像不是低于标准，但也没多少人会"}]
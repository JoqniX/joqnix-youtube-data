[{"type": "subtitle", "time": 9127.75, "timestamp": "02:32:07", "text": "我应该坐下来休息一会儿了。"}, {"type": "subtitle", "time": 9136.59, "timestamp": "02:32:16", "text": "是的，有很多C级玩家在玩。"}, {"type": "subtitle", "time": 9139.309, "timestamp": "02:32:19", "text": "还有所有关于足球的一切"}, {"type": "subtitle", "time": 9140.51, "timestamp": "02:32:20", "text": "人们"}, {"type": "subtitle", "time": 9142.75, "timestamp": "02:32:22", "text": "令人毛骨悚然"}, {"type": "subtitle", "time": 9145.07, "timestamp": "02:32:25", "text": "哦"}, {"type": "subtitle", "time": 9154.79, "timestamp": "02:32:34", "text": "背部能感觉到我的背部像"}, {"type": "subtitle", "time": 9158.11, "timestamp": "02:32:38", "text": "真的，呃，真的感觉不到我的"}, {"type": "subtitle", "time": 9160.07, "timestamp": "02:32:40", "text": "背部出汗，我需要"}, {"type": "subtitle", "time": 9163.469, "timestamp": "02:32:43", "text": "我得回家了"}, {"type": "subtitle", "time": 9166.11, "timestamp": "02:32:46", "text": "有些，但我应该详细了解一下吗？"}, {"type": "subtitle", "time": 9169.349, "timestamp": "02:32:49", "text": "我今天是不是该不该走路了？这种感觉"}, {"type": "subtitle", "time": 9171.389, "timestamp": "02:32:51", "text": "就像生锈的东西，就像坐着一样"}, {"type": "subtitle", "time": 9174.03, "timestamp": "02:32:54", "text": "某个地方和"}, {"type": "subtitle", "time": 9177.11, "timestamp": "02:32:57", "text": "放松一下，是啊，与其走路，我感觉……"}, {"type": "subtitle", "time": 9179.309, "timestamp": "02:32:59", "text": "就像我应该那样"}]
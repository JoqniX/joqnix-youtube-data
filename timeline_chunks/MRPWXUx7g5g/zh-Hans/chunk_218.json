[{"type": "subtitle", "time": 13093.309, "timestamp": "03:38:13", "text": "炎热但"}, {"type": "subtitle", "time": 13096.67, "timestamp": "03:38:16", "text": "是的，我们知道这一点。"}, {"type": "subtitle", "time": 13100.309, "timestamp": "03:38:20", "text": "应该是10点吧，对吗？"}, {"type": "subtitle", "time": 13103.07, "timestamp": "03:38:23", "text": "爱，但我显然不知道我是否"}, {"type": "subtitle", "time": 13105.79, "timestamp": "03:38:25", "text": "可以说它让我走了一段路。"}, {"type": "subtitle", "time": 13108.309, "timestamp": "03:38:28", "text": "因为那里"}, {"type": "subtitle", "time": 13110.87, "timestamp": "03:38:30", "text": "两杯酒"}, {"type": "subtitle", "time": 13113.11, "timestamp": "03:38:33", "text": "哥们，他是不是喝醉了？我不知道。"}, {"type": "subtitle", "time": 13116.67, "timestamp": "03:38:36", "text": "就像凌晨两点，我住得还不错，那里有"}, {"type": "subtitle", "time": 13118.95, "timestamp": "03:38:38", "text": "就像两个人走过来，然后向上走。"}, {"type": "subtitle", "time": 13120.95, "timestamp": "03:38:40", "text": "对我来说，坐在长椅上，就像字面意义上的"}, {"type": "subtitle", "time": 13125.07, "timestamp": "03:38:45", "text": "坐在旁边，就像……"}, {"type": "subtitle", "time": 13127.03, "timestamp": "03:38:47", "text": "座位也像弯道一样。"}, {"type": "subtitle", "time": 13128.83, "timestamp": "03:38:48", "text": "就像一个人一样"}, {"type": "subtitle", "time": 13131.99, "timestamp": "03:38:51", "text": "你可以坐在边缘的地方，或者"}, {"type": "subtitle", "time": 13134.95, "timestamp": "03:38:54", "text": "他们喜欢抽烟之类的东西"}, {"type": "subtitle", "time": 13138.389, "timestamp": "03:38:58", "text": "就像我当时那样，我有点害怕如果我"}]
[{"type": "subtitle", "time": 11465.11, "timestamp": "03:11:05", "text": "那里的海洋正在移动，那里有买家"}, {"type": "subtitle", "time": 11487.55, "timestamp": "03:11:27", "text": "是的，就像当我听到她用法语说话时一样"}, {"type": "subtitle", "time": 11490.309, "timestamp": "03:11:30", "text": "我认识的人喜欢我说法语。"}, {"type": "subtitle", "time": 11494.229, "timestamp": "03:11:34", "text": "朋友们，这其中也包括像"}, {"type": "subtitle", "time": 11497.229, "timestamp": "03:11:37", "text": "熟人，我不认识的人"}, {"type": "subtitle", "time": 11499.15, "timestamp": "03:11:39", "text": "称他们为熟人更合适。"}, {"type": "subtitle", "time": 11502.11, "timestamp": "03:11:42", "text": "我称他们为我的朋友，因为我"}, {"type": "subtitle", "time": 11507.51, "timestamp": "03:11:47", "text": "不要把他们视为熟人"}, {"type": "subtitle", "time": 11509.429, "timestamp": "03:11:49", "text": "更像是朋友，每个人都是"}, {"type": "subtitle", "time": 11517.99, "timestamp": "03:11:57", "text": "溪流"}, {"type": "subtitle", "time": 11519.27, "timestamp": "03:11:59", "text": "流媒体"}]
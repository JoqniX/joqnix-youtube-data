[{"type": "subtitle", "time": 13381.07, "timestamp": "03:43:01", "text": "指示灯亮着"}, {"type": "subtitle", "time": 13389.95, "timestamp": "03:43:09", "text": "呃，其实我想说的是，对吧"}, {"type": "subtitle", "time": 13392.91, "timestamp": "03:43:12", "text": "现在去另一个像步行一样的大地方。"}, {"type": "subtitle", "time": 13395.229, "timestamp": "03:43:15", "text": "一路走到这里，我都没想过要思考"}, {"type": "subtitle", "time": 13396.87, "timestamp": "03:43:16", "text": "那很好"}, {"type": "subtitle", "time": 13401.91, "timestamp": "03:43:21", "text": "想法给你看看，不过我们先走一小段路。"}, {"type": "subtitle", "time": 13404.51, "timestamp": "03:43:24", "text": "我们走了一小段路"}, {"type": "subtitle", "time": 13411.59, "timestamp": "03:43:31", "text": "当然，查玛的面包做得怎么样了？"}, {"type": "subtitle", "time": 13425.67, "timestamp": "03:43:45", "text": "你睡觉时打开手机，哦耶，我把手机放进去了。"}, {"type": "subtitle", "time": 13428.87, "timestamp": "03:43:48", "text": "进入状态，就像提醒我去睡觉一样"}, {"type": "subtitle", "time": 13431.79, "timestamp": "03:43:51", "text": "就像告诉电话里那样"}, {"type": "subtitle", "time": 13435.07, "timestamp": "03:43:55", "text": "我晚上10点前就会睡觉。这次"}, {"type": "subtitle", "time": 13436.67, "timestamp": "03:43:56", "text": "仍然喜欢"}, {"type": "subtitle", "time": 13439.269, "timestamp": "03:43:59", "text": "6 那是拉莉"}]
[{"type": "subtitle", "time": 6482.47, "timestamp": "01:48:02", "text": "那些充电接口没有"}, {"type": "subtitle", "time": 6485.83, "timestamp": "01:48:05", "text": "工作 工作含义"}, {"type": "subtitle", "time": 6488.55, "timestamp": "01:48:08", "text": "就像工作的意义一样"}, {"type": "subtitle", "time": 6490.39, "timestamp": "01:48:10", "text": "就像他们"}, {"type": "subtitle", "time": 6492.43, "timestamp": "01:48:12", "text": "不喜欢"}, {"type": "subtitle", "time": 6495.189, "timestamp": "01:48:15", "text": "确切地说，该怎么称呼它呢？没有"}, {"type": "subtitle", "time": 6498.91, "timestamp": "01:48:18", "text": "就像字面上的充电一样，它当时正在充电。"}, {"type": "subtitle", "time": 6501.07, "timestamp": "01:48:21", "text": "但是雨一直下个不停，就像……"}, {"type": "subtitle", "time": 6504.87, "timestamp": "01:48:24", "text": "移动电源正在运行，我就像"}, {"type": "subtitle", "time": 6510.27, "timestamp": "01:48:30", "text": "哦，对，已经吃过了，所以现在是……"}, {"type": "subtitle", "time": 6511.83, "timestamp": "01:48:31", "text": "呃"}, {"type": "subtitle", "time": 6522.47, "timestamp": "01:48:42", "text": "我一直在关注直播。"}, {"type": "subtitle", "time": 6528.43, "timestamp": "01:48:48", "text": "能够使用，就像……能够得到……"}, {"type": "subtitle", "time": 6536.629, "timestamp": "01:48:56", "text": "并自定义签名，这样它就不会"}]
[{"type": "subtitle", "time": 10804.63, "timestamp": "03:00:04", "text": "等等，有人说过……"}, {"type": "subtitle", "time": 10806.59, "timestamp": "03:00:06", "text": "我应该去那个地方吗？"}, {"type": "subtitle", "time": 10809.51, "timestamp": "03:00:09", "text": "去吧，天会黑的，你永远不会知道"}, {"type": "subtitle", "time": 10811.07, "timestamp": "03:00:11", "text": "如果有人推我，会发生什么？为什么？"}, {"type": "subtitle", "time": 10814.429, "timestamp": "03:00:14", "text": "我喜欢水，我的手机"}, {"type": "subtitle", "time": 10818.269, "timestamp": "03:00:18", "text": "就像SC一样"}, {"type": "subtitle", "time": 10820.07, "timestamp": "03:00:20", "text": "几分钟后，吃点椰子就好了。"}, {"type": "subtitle", "time": 10821.83, "timestamp": "03:00:21", "text": "前"}, {"type": "subtitle", "time": 10830.55, "timestamp": "03:00:30", "text": "对我来说是好事，我其实不太想要。"}, {"type": "subtitle", "time": 10844.429, "timestamp": "03:00:44", "text": "男人"}, {"type": "subtitle", "time": 10846.71, "timestamp": "03:00:46", "text": "你觉得这款手机怎么样？"}, {"type": "subtitle", "time": 10849.349, "timestamp": "03:00:49", "text": "到目前为止，Stringer 的情况还不错，我"}, {"type": "subtitle", "time": 10852.95, "timestamp": "03:00:52", "text": "这样做你会做什么？"}, {"type": "subtitle", "time": 10856.309, "timestamp": "03:00:56", "text": "我觉得好像没什么大不了的。"}, {"type": "subtitle", "time": 10858.51, "timestamp": "03:00:58", "text": "更像是如果有步行者的话。"}]
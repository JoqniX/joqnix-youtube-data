[{"type": "subtitle", "time": 12361.83, "timestamp": "03:26:01", "text": "我现在是认真的，而且"}, {"type": "subtitle", "time": 12364.429, "timestamp": "03:26:04", "text": "不，我又不是那种能做好事的人。"}, {"type": "subtitle", "time": 12366.91, "timestamp": "03:26:06", "text": "我觉得我尝试用音乐来创作它"}, {"type": "subtitle", "time": 12369.389, "timestamp": "03:26:09", "text": "工作室以及我放进去的所有东西。"}, {"type": "subtitle", "time": 12372.429, "timestamp": "03:26:12", "text": "每天都有时间和各种事情，还有你"}, {"type": "subtitle", "time": 12376.389, "timestamp": "03:26:16", "text": "那天我哭得好厉害。"}, {"type": "subtitle", "time": 12379.389, "timestamp": "03:26:19", "text": "然后了解世界是如何运作的。"}, {"type": "subtitle", "time": 12381.469, "timestamp": "03:26:21", "text": "后来我也明白了这一点。"}, {"type": "subtitle", "time": 12383.79, "timestamp": "03:26:23", "text": "我想我父母能理解这一点"}, {"type": "subtitle", "time": 12387.03, "timestamp": "03:26:27", "text": "买不起，而且"}, {"type": "subtitle", "time": 12389.15, "timestamp": "03:26:29", "text": "他们不想让他们想把它做成那样"}, {"type": "subtitle", "time": 12392.63, "timestamp": "03:26:32", "text": "就像买到了不好的东西一样。"}, {"type": "subtitle", "time": 12394.79, "timestamp": "03:26:34", "text": "你知道这肯定是一笔划算的买卖。"}, {"type": "subtitle", "time": 12395.51, "timestamp": "03:26:35", "text": "但"}, {"type": "subtitle", "time": 12398.469, "timestamp": "03:26:38", "text": "此外，还有很多糟糕的购物经历。"}, {"type": "subtitle", "time": 12401.87, "timestamp": "03:26:41", "text": "你追逐的金钱，从我这里来的钱。"}, {"type": "subtitle", "time": 12405.229, "timestamp": "03:26:45", "text": "说到我自己的事，我就退一步说了。"}, {"type": "subtitle", "time": 12408.95, "timestamp": "03:26:48", "text": "像我一样学习DJing的五角家族"}, {"type": "subtitle", "time": 12412.15, "timestamp": "03:26:52", "text": "但我变成了那样，那就是旧的"}, {"type": "subtitle", "time": 12415.51, "timestamp": "03:26:55", "text": "一台Vyl类型的转盘，但我真的"}, {"type": "subtitle", "time": 12419.51, "timestamp": "03:26:59", "text": "想扮演像李尔王那样的角色，就像C DJs那样"}]
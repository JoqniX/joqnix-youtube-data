[{"type": "subtitle", "time": 8641.83, "timestamp": "02:24:01", "text": "东西，但是"}, {"type": "subtitle", "time": 8645.67, "timestamp": "02:24:05", "text": "有时候真的太痛苦了"}, {"type": "subtitle", "time": 8648.79, "timestamp": "02:24:08", "text": "有时候我不能"}, {"type": "subtitle", "time": 8651.429, "timestamp": "02:24:11", "text": "即使是那些承诺或"}, {"type": "subtitle", "time": 8655.389, "timestamp": "02:24:15", "text": "我更像这样的人"}, {"type": "subtitle", "time": 8665.99, "timestamp": "02:24:25", "text": "就像我们以前那样，一起唱歌聊天。"}, {"type": "subtitle", "time": 8667.95, "timestamp": "02:24:27", "text": "呃，那不是……我不知道是什么"}, {"type": "subtitle", "time": 8670.63, "timestamp": "02:24:30", "text": "我碰巧吃光了所有东西。"}, {"type": "subtitle", "time": 8674.91, "timestamp": "02:24:34", "text": "已经过去一段时间了，有人说过这句话。"}, {"type": "subtitle", "time": 8679.55, "timestamp": "02:24:39", "text": "我绝不是想说这个。"}, {"type": "subtitle", "time": 8683.67, "timestamp": "02:24:43", "text": "就像我知道我想说什么，就像他"}, {"type": "subtitle", "time": 8685.99, "timestamp": "02:24:45", "text": "我的朋友们"}, {"type": "subtitle", "time": 8688.91, "timestamp": "02:24:48", "text": "出道就像这样，做他们喜欢的事情。"}, {"type": "subtitle", "time": 8692.269, "timestamp": "02:24:52", "text": "说到他们自身的成就，我"}, {"type": "subtitle", "time": 8694.349, "timestamp": "02:24:54", "text": "从未庆祝过"}, {"type": "subtitle", "time": 8698.469, "timestamp": "02:24:58", "text": "我的周年纪念日，对吧？"}]
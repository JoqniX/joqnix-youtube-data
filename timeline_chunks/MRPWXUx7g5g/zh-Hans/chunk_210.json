[{"type": "subtitle", "time": 12601.87, "timestamp": "03:30:01", "text": "在唱机上看 YouTube"}, {"type": "subtitle", "time": 12605.11, "timestamp": "03:30:05", "text": "一切都让我惊叹不已，而他当时"}, {"type": "subtitle", "time": 12608.67, "timestamp": "03:30:08", "text": "好吧，没问题，但问题是他们"}, {"type": "subtitle", "time": 12612.59, "timestamp": "03:30:12", "text": "他的家人认识我的家人。"}, {"type": "subtitle", "time": 12616.11, "timestamp": "03:30:16", "text": "我觉得我不知道这个 Rel 喜欢"}, {"type": "subtitle", "time": 12618.429, "timestamp": "03:30:18", "text": "新的你，我想是的，这就是他们"}, {"type": "subtitle", "time": 12620.15, "timestamp": "03:30:20", "text": "他们对我还挺友好的。"}, {"type": "subtitle", "time": 12622.55, "timestamp": "03:30:22", "text": "就像妈妈一样，母亲"}, {"type": "subtitle", "time": 12626.229, "timestamp": "03:30:26", "text": "那位老师，他的母亲，还有他们"}, {"type": "subtitle", "time": 12629.03, "timestamp": "03:30:29", "text": "把我当成奶昔之类的好东西一样对待"}, {"type": "subtitle", "time": 12631.75, "timestamp": "03:30:31", "text": "还有其他东西，比如好吃的食物等等。"}, {"type": "subtitle", "time": 12634.389, "timestamp": "03:30:34", "text": "我以前来的时候，一切都像来一样"}, {"type": "subtitle", "time": 12635.63, "timestamp": "03:30:35", "text": "早期和"}, {"type": "subtitle", "time": 12638.87, "timestamp": "03:30:38", "text": "等等，因为我之前在那儿上过钢琴课。"}, {"type": "subtitle", "time": 12642.349, "timestamp": "03:30:42", "text": "傍晚我以前经常去那里，嗯，很早。"}, {"type": "subtitle", "time": 12646.99, "timestamp": "03:30:46", "text": "大概上午 11 点 1 分之后，嗯，因为"}, {"type": "subtitle", "time": 12649.03, "timestamp": "03:30:49", "text": "我像4岁的时候那样躲在衣柜里：或者"}, {"type": "subtitle", "time": 12654.67, "timestamp": "03:30:54", "text": "是的"}, {"type": "subtitle", "time": 12658.469, "timestamp": "03:30:58", "text": "所以，是的，就像他一样"}]
[{"type": "subtitle", "time": 9062.83, "timestamp": "02:31:02", "text": "是的，它根本就没正式亮相过。"}, {"type": "subtitle", "time": 9067.59, "timestamp": "02:31:07", "text": "但有一天，我希望我能成为它"}, {"type": "subtitle", "time": 9071.349, "timestamp": "02:31:11", "text": "总体来说还不错。"}, {"type": "subtitle", "time": 9074.79, "timestamp": "02:31:14", "text": "我以后会做很多东西。"}, {"type": "subtitle", "time": 9078.55, "timestamp": "02:31:18", "text": "各种各样的事，不过有一件事我明白了。"}, {"type": "subtitle", "time": 9083.03, "timestamp": "02:31:23", "text": "这些事情需要很多人。"}, {"type": "subtitle", "time": 9086.95, "timestamp": "02:31:26", "text": "落后就像你需要一个团队一样"}, {"type": "subtitle", "time": 9089.19, "timestamp": "02:31:29", "text": "人们或你的团队的事情，比如你"}, {"type": "subtitle", "time": 9090.95, "timestamp": "02:31:30", "text": "需要所有东西"}, {"type": "subtitle", "time": 9094.11, "timestamp": "02:31:34", "text": "这一切都很酷，不是很酷，而是更酷"}, {"type": "subtitle", "time": 9095.87, "timestamp": "02:31:35", "text": "喜欢"}, {"type": "subtitle", "time": 9098.79, "timestamp": "02:31:38", "text": "痛苦，我就像一个人"}, {"type": "subtitle", "time": 9100.82, "timestamp": "02:31:40", "text": "更多此类内容"}, {"type": "subtitle", "time": 9102.03, "timestamp": "02:31:42", "text": "[音乐]"}, {"type": "subtitle", "time": 9105.79, "timestamp": "02:31:45", "text": "这样做你发誓"}, {"type": "subtitle", "time": 9108.309, "timestamp": "02:31:48", "text": "swly I"}, {"type": "subtitle", "time": 9114.63, "timestamp": "02:31:54", "text": "我正往右边走，"}]
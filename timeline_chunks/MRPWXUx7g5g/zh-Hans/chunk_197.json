[{"type": "subtitle", "time": 11820.55, "timestamp": "03:17:00", "text": "会有人这么做的。"}, {"type": "subtitle", "time": 11825.63, "timestamp": "03:17:05", "text": "卡拉OK和K喜欢唱B级歌曲，但是"}, {"type": "subtitle", "time": 11828.389, "timestamp": "03:17:08", "text": "闲聊也涉及到这一点。"}, {"type": "subtitle", "time": 11830.349, "timestamp": "03:17:10", "text": "也会有人喜欢"}, {"type": "subtitle", "time": 11832.429, "timestamp": "03:17:12", "text": "字面意义上的刷刷刷，游戏本身却不是刷刷刷。"}, {"type": "subtitle", "time": 11835.15, "timestamp": "03:17:15", "text": "玩同样的游戏或者喜欢玩那个游戏"}, {"type": "subtitle", "time": 11837.91, "timestamp": "03:17:17", "text": "因为他们喜欢玩游戏，所以我经常玩。"}, {"type": "subtitle", "time": 11840.229, "timestamp": "03:17:20", "text": "和"}, {"type": "subtitle", "time": 11841.79, "timestamp": "03:17:21", "text": "是的"}, {"type": "subtitle", "time": 11844.79, "timestamp": "03:17:24", "text": "但确实不是。"}, {"type": "subtitle", "time": 11847.79, "timestamp": "03:17:27", "text": "是啊，我觉得我也会这么做。"}, {"type": "subtitle", "time": 11851.469, "timestamp": "03:17:31", "text": "对，就像……嗯，我注意到……哦"}, {"type": "subtitle", "time": 11854.03, "timestamp": "03:17:34", "text": "她经常播放帕普的歌，这让我想起了帕普。"}, {"type": "subtitle", "time": 11856.95, "timestamp": "03:17:36", "text": "那些日本主播"}, {"type": "subtitle", "time": 11864.95, "timestamp": "03:17:44", "text": "我知道新版本即将发布。"}, {"type": "subtitle", "time": 11868.55, "timestamp": "03:17:48", "text": "6月6日，一名男子坐在这里，蚊子……"}, {"type": "subtitle", "time": 11870.469, "timestamp": "03:17:50", "text": "这件事一直困扰着我"}, {"type": "subtitle", "time": 11873.15, "timestamp": "03:17:53", "text": "我一直以为这个地方很安静，但是"}]
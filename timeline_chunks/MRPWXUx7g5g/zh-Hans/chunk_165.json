[{"type": "subtitle", "time": 9904.51, "timestamp": "02:45:04", "text": "快得像我一样，快步走就像我的"}, {"type": "subtitle", "time": 9925.429, "timestamp": "02:45:25", "text": "但我注意到一件事"}, {"type": "subtitle", "time": 9928.389, "timestamp": "02:45:28", "text": "很多人都会问这个问题"}, {"type": "subtitle", "time": 9930.95, "timestamp": "02:45:30", "text": "我喜欢做直播"}, {"type": "subtitle", "time": 9934.309, "timestamp": "02:45:34", "text": "这种或者像这样的直播"}, {"type": "subtitle", "time": 9936.79, "timestamp": "02:45:36", "text": "普通人或者像任何知道我情况的人一样"}, {"type": "subtitle", "time": 9937.99, "timestamp": "02:45:37", "text": "爱好"}, {"type": "subtitle", "time": 9941.23, "timestamp": "02:45:41", "text": "他们问的就是这个主要问题吗？"}, {"type": "subtitle", "time": 9944.55, "timestamp": "02:45:44", "text": "问题：你总共拥有多少资产？"}, {"type": "subtitle", "time": 9947.75, "timestamp": "02:45:47", "text": "做这么多事，做这么多事，"}, {"type": "subtitle", "time": 9955.15, "timestamp": "02:45:55", "text": "我感觉自己什么都不知道。"}, {"type": "subtitle", "time": 9956.429, "timestamp": "02:45:56", "text": "它更"}]
[{"type": "subtitle", "time": 9002.03, "timestamp": "02:30:02", "text": "应该她已经成长了很多，进步也很大。"}, {"type": "subtitle", "time": 9004.71, "timestamp": "02:30:04", "text": "很多，比如说话和所有的一切"}, {"type": "subtitle", "time": 9011.52, "timestamp": "02:30:11", "text": "一切 是的，就像Zana Celesa一样，我们来看看。"}, {"type": "subtitle", "time": 9015.359, "timestamp": "02:30:15", "text": "是的，就像Zana Celesa一样，我们来看看。 我喜欢的每个人，所有的女孩都有"}, {"type": "subtitle", "time": 9017.88, "timestamp": "02:30:17", "text": "我喜欢的每个人，所有的女孩都有 多年来不断改进"}, {"type": "subtitle", "time": 9021.88, "timestamp": "02:30:21", "text": "多年来不断改进 她要走了"}, {"type": "subtitle", "time": 9023.56, "timestamp": "02:30:23", "text": "她要走了 现在"}, {"type": "subtitle", "time": 9033.87, "timestamp": "02:30:33", "text": "所以，但我希望有一天"}, {"type": "subtitle", "time": 9038.469, "timestamp": "02:30:38", "text": "是啊，我希望有一天能拥有我的"}, {"type": "subtitle", "time": 9039.99, "timestamp": "02:30:39", "text": "自己的"}, {"type": "subtitle", "time": 9042.63, "timestamp": "02:30:42", "text": "等等，我还没正式出道呢。"}, {"type": "subtitle", "time": 9046.19, "timestamp": "02:30:46", "text": "你们知道我从来没有过……吗？"}, {"type": "subtitle", "time": 9049.59, "timestamp": "02:30:49", "text": "正式出道，所以如果……如果……而且喜欢……呃……"}, {"type": "subtitle", "time": 9053.11, "timestamp": "02:30:53", "text": "比如，如果有个钥匙之类的东西……"}, {"type": "subtitle", "time": 9055.389, "timestamp": "02:30:55", "text": "我不会有"}, {"type": "subtitle", "time": 9057.269, "timestamp": "02:30:57", "text": "日期"}, {"type": "subtitle", "time": 9059.87, "timestamp": "02:30:59", "text": "因为我从未出道"}]
[{"type": "subtitle", "time": 18240.91, "timestamp": "05:04:00", "text": "你说得对，我不知道，我真的不知道"}, {"type": "subtitle", "time": 18243.31, "timestamp": "05:04:03", "text": "了解你，你想要一个解释，我"}, {"type": "subtitle", "time": 18246.31, "timestamp": "05:04:06", "text": "如果你能找到它，就给你一个吧"}, {"type": "subtitle", "time": 18247.75, "timestamp": "05:04:07", "text": "喜欢"}, {"type": "subtitle", "time": 18250.91, "timestamp": "05:04:10", "text": "所有这些，斯图，突然都去了哪里？"}, {"type": "subtitle", "time": 18253.59, "timestamp": "05:04:13", "text": "顺便说一句，我本人并不来自 iuce。"}, {"type": "subtitle", "time": 18256.83, "timestamp": "05:04:16", "text": "我知道你的名字，但我的名字是"}, {"type": "subtitle", "time": 18260.628, "timestamp": "05:04:20", "text": "乔和你的"}, {"type": "subtitle", "time": 18267.59, "timestamp": "05:04:27", "text": "我其实"}, {"type": "subtitle", "time": 18271.07, "timestamp": "05:04:31", "text": "我寄到这里的东西，我被送到这里了。"}, {"type": "subtitle", "time": 18273.07, "timestamp": "05:04:33", "text": "很长一段时间以来，我对这方面几乎一无所知。"}, {"type": "subtitle", "time": 18275.15, "timestamp": "05:04:35", "text": "除了表面上发生的事情之外，还有什么呢？"}, {"type": "subtitle", "time": 18277.83, "timestamp": "05:04:37", "text": "我们从供应中获取新闻"}, {"type": "subtitle", "time": 18290.39, "timestamp": "05:04:50", "text": "你刚才不是因为我的火而皱眉吗？"}, {"type": "subtitle", "time": 18293.03, "timestamp": "05:04:53", "text": "那是因为没想到​​是水。"}]
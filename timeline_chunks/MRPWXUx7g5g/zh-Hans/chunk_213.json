[{"type": "subtitle", "time": 12782.189, "timestamp": "03:33:02", "text": "学费之类的东西，人们就回来了"}, {"type": "subtitle", "time": 12786.469, "timestamp": "03:33:06", "text": "友谊，所有那些PCO相关的东西"}, {"type": "subtitle", "time": 12790.67, "timestamp": "03:33:10", "text": "感觉糟透了，对吧？我想延长这段时间。"}, {"type": "subtitle", "time": 12793.59, "timestamp": "03:33:13", "text": "确定付款日期，以便他们可以在何时付款。"}, {"type": "subtitle", "time": 12796.349, "timestamp": "03:33:16", "text": "钱来了，一切都结束了，但那家伙确实……"}, {"type": "subtitle", "time": 12798.99, "timestamp": "03:33:18", "text": "他们不会去想那些事情。"}, {"type": "subtitle", "time": 12799.95, "timestamp": "03:33:19", "text": "他"}, {"type": "subtitle", "time": 12802.59, "timestamp": "03:33:22", "text": "我只是……我不知道"}, {"type": "subtitle", "time": 12805.309, "timestamp": "03:33:25", "text": "自从我理解了一个人之后，就一直知道"}, {"type": "subtitle", "time": 12808.59, "timestamp": "03:33:28", "text": "我永远永远永远永远不会做的事"}, {"type": "subtitle", "time": 12812.87, "timestamp": "03:33:32", "text": "我愿意向任何人学习任何课程"}, {"type": "subtitle", "time": 12815.389, "timestamp": "03:33:35", "text": "如果是像网上那样就没问题。"}, {"type": "subtitle", "time": 12818.429, "timestamp": "03:33:38", "text": "在线上，比如M或者你我或者像技能一样。"}, {"type": "subtitle", "time": 12828.91, "timestamp": "03:33:48", "text": "好吧，我能理解那些古板的人。"}, {"type": "subtitle", "time": 12831.55, "timestamp": "03:33:51", "text": "是的，我遇到了很多困难。"}, {"type": "subtitle", "time": 12838.07, "timestamp": "03:33:58", "text": "蚊子"}]
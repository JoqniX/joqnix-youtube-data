[{"type": "subtitle", "time": 10748.349, "timestamp": "02:59:08", "text": "我真的不那样工作"}, {"type": "subtitle", "time": 10767.75, "timestamp": "02:59:27", "text": "更多我"}, {"type": "subtitle", "time": 10771.55, "timestamp": "02:59:31", "text": "我觉得SE已经所剩无几了，你知道吗？"}, {"type": "subtitle", "time": 10774.389, "timestamp": "02:59:34", "text": "我打算做点什么。"}, {"type": "subtitle", "time": 10778.229, "timestamp": "02:59:38", "text": "我喝点东西，然后找个地方坐下。"}, {"type": "subtitle", "time": 10781.19, "timestamp": "02:59:41", "text": "那我下山后就走回家吧"}, {"type": "subtitle", "time": 10784.229, "timestamp": "02:59:44", "text": "相反，我们实际所做的却是"}, {"type": "subtitle", "time": 10787.15, "timestamp": "02:59:47", "text": "我们濒临死亡，就像我们走过一样。"}, {"type": "subtitle", "time": 10793.87, "timestamp": "02:59:53", "text": "那"}, {"type": "subtitle", "time": 10796.11, "timestamp": "02:59:56", "text": "我"}]
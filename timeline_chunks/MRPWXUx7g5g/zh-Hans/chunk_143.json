[{"type": "subtitle", "time": 8581.87, "timestamp": "02:23:01", "text": "现在应该有两三套衣服了吧。"}, {"type": "subtitle", "time": 8583.19, "timestamp": "02:23:03", "text": "但"}, {"type": "subtitle", "time": 8587.07, "timestamp": "02:23:07", "text": "再次强调，你实际上不需要做所有这些事情。"}, {"type": "subtitle", "time": 8588.59, "timestamp": "02:23:08", "text": "只要付出努力，你就能做到"}, {"type": "subtitle", "time": 8590.87, "timestamp": "02:23:10", "text": "如果你有钱，我就会支付佣金。"}, {"type": "subtitle", "time": 8591.91, "timestamp": "02:23:11", "text": "如果我……"}, {"type": "subtitle", "time": 8593.51, "timestamp": "02:23:13", "text": "打破"}, {"type": "subtitle", "time": 8597.07, "timestamp": "02:23:17", "text": "所以对我来说，至少这样做是非常好的。"}, {"type": "subtitle", "time": 8601.469, "timestamp": "02:23:21", "text": "攒钱还是做我的事，我想我会去"}, {"type": "subtitle", "time": 8604.91, "timestamp": "02:23:24", "text": "因为要走自己动手的路"}, {"type": "subtitle", "time": 8608.03, "timestamp": "02:23:28", "text": "我再次希望"}, {"type": "subtitle", "time": 8610.469, "timestamp": "02:23:30", "text": "做圣"}, {"type": "subtitle", "time": 8615.19, "timestamp": "02:23:35", "text": "我自己做这件事感觉很自在。"}, {"type": "subtitle", "time": 8618.51, "timestamp": "02:23:38", "text": "我自己，但我得回去用我的VPN了。"}, {"type": "subtitle", "time": 8620.91, "timestamp": "02:23:40", "text": "这就是我们彼此联系的原因。"}, {"type": "subtitle", "time": 8624.15, "timestamp": "02:23:44", "text": "延迟应该没问题，所以是的，主要是"}, {"type": "subtitle", "time": 8625.87, "timestamp": "02:23:45", "text": "我"}, {"type": "subtitle", "time": 8627.469, "timestamp": "02:23:47", "text": "事物"}, {"type": "subtitle", "time": 8631.269, "timestamp": "02:23:51", "text": "我想说的是，这件事是……"}, {"type": "subtitle", "time": 8634.03, "timestamp": "02:23:54", "text": "我经常谈到这件事。"}, {"type": "subtitle", "time": 8637.269, "timestamp": "02:23:57", "text": "很多关于如何做以及想怎么做的问题。"}, {"type": "subtitle", "time": 8639.309, "timestamp": "02:23:59", "text": "所有这些"}]
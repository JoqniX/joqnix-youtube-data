[{"type": "subtitle", "time": 6006.47, "timestamp": "01:40:06", "text": "注意，因为它会显示在通知里。"}, {"type": "subtitle", "time": 6011.149, "timestamp": "01:40:11", "text": "区域对面，所以这个东西也显示出来了。"}, {"type": "subtitle", "time": 6012.229, "timestamp": "01:40:12", "text": "好的"}, {"type": "subtitle", "time": 6015.79, "timestamp": "01:40:15", "text": "老兄，我的鼻子都湿透了，鼻涕都流到我身上了。"}, {"type": "subtitle", "time": 6018.03, "timestamp": "01:40:18", "text": "狗"}, {"type": "subtitle", "time": 6023.99, "timestamp": "01:40:23", "text": "可能需要制作第三个"}, {"type": "subtitle", "time": 6026.27, "timestamp": "01:40:26", "text": "步行溪流，我的意思是，它就像一条……"}, {"type": "subtitle", "time": 6029.589, "timestamp": "01:40:29", "text": "第三次傍晚散步，嗯，反正我要走了。"}, {"type": "subtitle", "time": 6032.709, "timestamp": "01:40:32", "text": "关灯可能需要稍微调整一下"}, {"type": "subtitle", "time": 6034.51, "timestamp": "01:40:34", "text": "因为我正在获得"}, {"type": "subtitle", "time": 6042.75, "timestamp": "01:40:42", "text": "偷偷摸摸的，我是个哑巴，嗨，我是个哑巴，有点"}, {"type": "subtitle", "time": 6044.229, "timestamp": "01:40:44", "text": "少量"}]
[{"type": "subtitle", "time": 13981.389, "timestamp": "03:53:01", "text": "好的"}, {"type": "subtitle", "time": 13984.95, "timestamp": "03:53:04", "text": "我把它做成一个好的东西"}, {"type": "subtitle", "time": 13989.59, "timestamp": "03:53:09", "text": "比你更棒的东西，你知道吗？"}, {"type": "subtitle", "time": 13998.349, "timestamp": "03:53:18", "text": "一样"}, {"type": "subtitle", "time": 14002.67, "timestamp": "03:53:22", "text": "我想要的，但我不太擅长得到"}, {"type": "subtitle", "time": 14006.71, "timestamp": "03:53:26", "text": "更好的名字你知道是什么"}, {"type": "subtitle", "time": 14009.349, "timestamp": "03:53:29", "text": "嗯，我有点想发起一个投票或者"}, {"type": "subtitle", "time": 14011.59, "timestamp": "03:53:31", "text": "类似建议之类的东西"}, {"type": "subtitle", "time": 14013.189, "timestamp": "03:53:33", "text": "例如名称"}, {"type": "subtitle", "time": 14016.59, "timestamp": "03:53:36", "text": "社区和一些东西"}, {"type": "subtitle", "time": 14020.349, "timestamp": "03:53:40", "text": "因为我与我们的关系越发展越好"}, {"type": "subtitle", "time": 14023.269, "timestamp": "03:53:43", "text": "某种程度上，我觉得这个家庭就像家人一样"}, {"type": "subtitle", "time": 14025.79, "timestamp": "03:53:45", "text": "名字有点像 t 可以被一切所左右。"}, {"type": "subtitle", "time": 14028.429, "timestamp": "03:53:48", "text": "一切都对了，我想要这样。"}, {"type": "subtitle", "time": 14030.79, "timestamp": "03:53:50", "text": "为了更独特，我"}, {"type": "subtitle", "time": 14032.79, "timestamp": "03:53:52", "text": "我想我并不这么认为。"}, {"type": "subtitle", "time": 14035.91, "timestamp": "03:53:55", "text": "我知道，但在EX上，它也有其独特之处。"}, {"type": "subtitle", "time": 14036.75, "timestamp": "03:53:56", "text": "你"}, {"type": "subtitle", "time": 14038.95, "timestamp": "03:53:58", "text": "我知道了，就是这样。"}]
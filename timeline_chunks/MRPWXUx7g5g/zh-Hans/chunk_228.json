[{"type": "subtitle", "time": 13681.51, "timestamp": "03:48:01", "text": "我的天，这两个人就像人"}, {"type": "subtitle", "time": 13684.95, "timestamp": "03:48:04", "text": "就像我的邻居或朋友一样"}, {"type": "subtitle", "time": 13688.189, "timestamp": "03:48:08", "text": "你可能认识的一位朋友，就像他一样"}, {"type": "subtitle", "time": 13690.75, "timestamp": "03:48:10", "text": "以前我常公开说"}, {"type": "subtitle", "time": 13693.11, "timestamp": "03:48:13", "text": "我的朋友是谁？劳埃德，他的名字是"}, {"type": "subtitle", "time": 13695.91, "timestamp": "03:48:15", "text": "劳埃德，我猜我可以这么说。"}, {"type": "subtitle", "time": 13698.269, "timestamp": "03:48:18", "text": "是的，劳合和乔治，他们俩都是"}, {"type": "subtitle", "time": 13701.07, "timestamp": "03:48:21", "text": "我的孩子们"}, {"type": "subtitle", "time": 13703.349, "timestamp": "03:48:23", "text": "朋友可以认识任何人，你可以这样说，比如我"}, {"type": "subtitle", "time": 13705.79, "timestamp": "03:48:25", "text": "和他们一起留下了很多回忆。"}, {"type": "subtitle", "time": 13707.87, "timestamp": "03:48:27", "text": "但我知道"}, {"type": "subtitle", "time": 13711.07, "timestamp": "03:48:31", "text": "你成长的方式"}, {"type": "subtitle", "time": 13714.07, "timestamp": "03:48:34", "text": "这从来没有过，更像是我曾经是……"}, {"type": "subtitle", "time": 13715.149, "timestamp": "03:48:35", "text": "一个人"}, {"type": "subtitle", "time": 13717.429, "timestamp": "03:48:37", "text": "曾是"}, {"type": "subtitle", "time": 13720.269, "timestamp": "03:48:40", "text": "像乔治一样疏远，他走了自己的路"}, {"type": "subtitle", "time": 13723.03, "timestamp": "03:48:43", "text": "与同伴"}, {"type": "subtitle", "time": 13725.469, "timestamp": "03:48:45", "text": "我喜欢朋友们，他们在一起的每一刻我都喜欢。"}, {"type": "subtitle", "time": 13727.95, "timestamp": "03:48:47", "text": "结交了新朋友，我是那个……"}, {"type": "subtitle", "time": 13731.149, "timestamp": "03:48:51", "text": "超级嫉妒，我以前经常……"}, {"type": "subtitle", "time": 13732.71, "timestamp": "03:48:52", "text": "在他们的P前面"}, {"type": "subtitle", "time": 13734.91, "timestamp": "03:48:54", "text": "我面对的面孔"}, {"type": "subtitle", "time": 13738.03, "timestamp": "03:48:58", "text": "以前我看到这种情况就会走开。"}]
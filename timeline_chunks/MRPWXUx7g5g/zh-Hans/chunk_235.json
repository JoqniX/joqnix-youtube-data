[{"type": "subtitle", "time": 14102.71, "timestamp": "03:55:02", "text": "想离开他们，即使他们很善良"}, {"type": "subtitle", "time": 14105.99, "timestamp": "03:55:05", "text": "他原本打算把我扔下之类的"}, {"type": "subtitle", "time": 14108.79, "timestamp": "03:55:08", "text": "但他们挺乐于助人的，等等。"}, {"type": "subtitle", "time": 14109.87, "timestamp": "03:55:09", "text": "仍然"}, {"type": "subtitle", "time": 14112.189, "timestamp": "03:55:12", "text": "不过有一个问题是："}, {"type": "subtitle", "time": 14116.269, "timestamp": "03:55:16", "text": "他们问的是"}, {"type": "subtitle", "time": 14118.67, "timestamp": "03:55:18", "text": "乔基"}, {"type": "subtitle", "time": 14122.83, "timestamp": "03:55:22", "text": "你与观众之间的友谊以及"}, {"type": "subtitle", "time": 14126.63, "timestamp": "03:55:26", "text": "你的流媒体设备，还有我"}, {"type": "subtitle", "time": 14129.75, "timestamp": "03:55:29", "text": "别这样让我难堪。"}, {"type": "subtitle", "time": 14132.63, "timestamp": "03:55:32", "text": "就像字面上那样，这真是太难了"}, {"type": "subtitle", "time": 14136.229, "timestamp": "03:55:36", "text": "而且真的很难，超级难"}, {"type": "subtitle", "time": 14138.07, "timestamp": "03:55:38", "text": "问题是……"}, {"type": "subtitle", "time": 14141.229, "timestamp": "03:55:41", "text": "比如，如果你有一个，如果你在一个"}, {"type": "subtitle", "time": 14143.469, "timestamp": "03:55:43", "text": "像你女朋友问的那种关系"}, {"type": "subtitle", "time": 14147.229, "timestamp": "03:55:47", "text": "你或者你的另一半，我会的"}, {"type": "subtitle", "time": 14148.189, "timestamp": "03:55:48", "text": "问"}, {"type": "subtitle", "time": 14152.269, "timestamp": "03:55:52", "text": "你真的会把我的利益置于你的目标之上吗？"}, {"type": "subtitle", "time": 14154.63, "timestamp": "03:55:54", "text": "还有其他一些东西，它实际上和……一模一样。"}]
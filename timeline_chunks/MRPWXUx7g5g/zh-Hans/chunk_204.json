[{"type": "subtitle", "time": 12242.83, "timestamp": "03:24:02", "text": "疼痛，是的，确实很痛。"}, {"type": "subtitle", "time": 12246.429, "timestamp": "03:24:06", "text": "对我来说，我只是把它给我妈妈用"}, {"type": "subtitle", "time": 12250.03, "timestamp": "03:24:10", "text": "我用它来处理重要的家居用品。"}, {"type": "subtitle", "time": 12253.429, "timestamp": "03:24:13", "text": "我也想效仿以前的做法。"}, {"type": "subtitle", "time": 12257.11, "timestamp": "03:24:17", "text": "过去常常这样做"}, {"type": "subtitle", "time": 12258.75, "timestamp": "03:24:18", "text": "但"}, {"type": "subtitle", "time": 12261.269, "timestamp": "03:24:21", "text": "是啊，我的故事就像是……你"}, {"type": "subtitle", "time": 12265.79, "timestamp": "03:24:25", "text": "我很小的时候就明白了。"}, {"type": "subtitle", "time": 12268.63, "timestamp": "03:24:28", "text": "是的，我想那应该是我"}, {"type": "subtitle", "time": 12271.229, "timestamp": "03:24:31", "text": "乔做了，是的。"}, {"type": "subtitle", "time": 12274.11, "timestamp": "03:24:34", "text": "就像我发现名字时那样，我"}, {"type": "subtitle", "time": 12277.389, "timestamp": "03:24:37", "text": "我一直在做音乐之类的事情。"}, {"type": "subtitle", "time": 12279.11, "timestamp": "03:24:39", "text": "一直想要一个医疗"}, {"type": "subtitle", "time": 12281.79, "timestamp": "03:24:41", "text": "我一直用的键盘，就像我每天都用的那种。"}, {"type": "subtitle", "time": 12286.07, "timestamp": "03:24:46", "text": "请为我祈祷，给我一个……"}, {"type": "subtitle", "time": 12288.67, "timestamp": "03:24:48", "text": "希望我能攒够钱买东西。"}, {"type": "subtitle", "time": 12290.99, "timestamp": "03:24:50", "text": "一个 Medi 键盘和"}, {"type": "subtitle", "time": 12294.349, "timestamp": "03:24:54", "text": "我明白了，我问的一切都让我很困惑。"}, {"type": "subtitle", "time": 12296.429, "timestamp": "03:24:56", "text": "我的父母即使在班加罗尔也很喜欢这里。"}, {"type": "subtitle", "time": 12299.87, "timestamp": "03:24:59", "text": "以及我去班加罗尔旅游时的一些事情"}]
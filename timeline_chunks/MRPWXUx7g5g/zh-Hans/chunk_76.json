[{"type": "subtitle", "time": 4560.229, "timestamp": "01:16:00", "text": "I5 94 944 F 或"}, {"type": "subtitle", "time": 4564.79, "timestamp": "01:16:04", "text": "我用了某种东西，一直用到100度。"}, {"type": "subtitle", "time": 4568.95, "timestamp": "01:16:08", "text": "温度是摄氏度，我想我仍然"}, {"type": "subtitle", "time": 4572.149, "timestamp": "01:16:12", "text": "有趣的是，它从来没有"}, {"type": "subtitle", "time": 4576.43, "timestamp": "01:16:16", "text": "融化了或者发生了什么事"}, {"type": "subtitle", "time": 4579.83, "timestamp": "01:16:19", "text": "我记得我以前在我的……上玩过堡垒之夜"}, {"type": "subtitle", "time": 4581.79, "timestamp": "01:16:21", "text": "英特尔"}, {"type": "subtitle", "time": 4585.55, "timestamp": "01:16:25", "text": "奔腾CPU，我现在把它放得像个小东西"}, {"type": "subtitle", "time": 4589.07, "timestamp": "01:16:29", "text": "像这样的窗户，我把窗户放在那里。"}, {"type": "subtitle", "time": 4590.51, "timestamp": "01:16:30", "text": "不像"}, {"type": "subtitle", "time": 4593.43, "timestamp": "01:16:33", "text": "这扇窗户以前真的像这样"}, {"type": "subtitle", "time": 4595.189, "timestamp": "01:16:35", "text": "以前我就是这样玩的。"}, {"type": "subtitle", "time": 4598.47, "timestamp": "01:16:38", "text": "我以前玩过这种类型的堡垒之夜"}, {"type": "subtitle", "time": 4601.189, "timestamp": "01:16:41", "text": "堡垒之夜一切都是黑色的"}, {"type": "subtitle", "time": 4603.99, "timestamp": "01:16:43", "text": "屏幕"}, {"type": "subtitle", "time": 4607.229, "timestamp": "01:16:47", "text": "啊，他一定有很好的父母，是我。"}, {"type": "subtitle", "time": 4609.669, "timestamp": "01:16:49", "text": "我没钱，只能努力工作。"}, {"type": "subtitle", "time": 4612.31, "timestamp": "01:16:52", "text": "从我的角度来看"}, {"type": "subtitle", "time": 4616.07, "timestamp": "01:16:56", "text": "不知怎么的，做了些奇怪的事"}]
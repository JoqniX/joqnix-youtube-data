[{"type": "subtitle", "time": 12063.83, "timestamp": "03:21:03", "text": "谈论或谈论但是很常见"}, {"type": "subtitle", "time": 12066.87, "timestamp": "03:21:06", "text": "这些东西真的挺无聊的"}, {"type": "subtitle", "time": 12078.349, "timestamp": "03:21:18", "text": "再次感觉就像真的感觉"}, {"type": "subtitle", "time": 12081.389, "timestamp": "03:21:21", "text": "我的天啊"}, {"type": "subtitle", "time": 12084.269, "timestamp": "03:21:24", "text": "好的，很好"}, {"type": "subtitle", "time": 12087.11, "timestamp": "03:21:27", "text": "我也是，很多哦"}, {"type": "subtitle", "time": 12089.99, "timestamp": "03:21:29", "text": "上帝啊，所以，是的，我也在说，当我得到"}, {"type": "subtitle", "time": 12092.189, "timestamp": "03:21:32", "text": "我喜欢把钱给……"}, {"type": "subtitle", "time": 12094.309, "timestamp": "03:21:34", "text": "流设备"}, {"type": "subtitle", "time": 12097.71, "timestamp": "03:21:37", "text": "把东西放进去，给它配备流媒体设备，"}, {"type": "subtitle", "time": 12100.91, "timestamp": "03:21:40", "text": "电脑设备的维护"}, {"type": "subtitle", "time": 12105.429, "timestamp": "03:21:45", "text": "然后第二部分就像……"}, {"type": "subtitle", "time": 12108.91, "timestamp": "03:21:48", "text": "鸡肉部分原本是留给我自己的，但现在我是"}, {"type": "subtitle", "time": 12110.469, "timestamp": "03:21:50", "text": "考虑不把钱留着"}, {"type": "subtitle", "time": 12112.91, "timestamp": "03:21:52", "text": "一切都是为了我自己，因为我会浪费。"}, {"type": "subtitle", "time": 12116.83, "timestamp": "03:21:56", "text": "我知道自己是对的，不不，我我我"}, {"type": "subtitle", "time": 12119.03, "timestamp": "03:21:59", "text": "应该自己留着，不过，唉。"}]
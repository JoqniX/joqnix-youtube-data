[{"type": "subtitle", "time": 5044.75, "timestamp": "01:24:04", "text": "好啊，我应该试试，我这就去试试。"}, {"type": "subtitle", "time": 5047.83, "timestamp": "01:24:07", "text": "你之后会使用变声器吗？不会。"}, {"type": "subtitle", "time": 5050.27, "timestamp": "01:24:10", "text": "这是我的真实"}, {"type": "subtitle", "time": 5052.95, "timestamp": "01:24:12", "text": "那是我真正的声音，只有这一个声音。"}, {"type": "subtitle", "time": 5055.91, "timestamp": "01:24:15", "text": "我音频设备里有这样一样东西"}, {"type": "subtitle", "time": 5057.39, "timestamp": "01:24:17", "text": "噪音"}, {"type": "subtitle", "time": 5060.149, "timestamp": "01:24:20", "text": "压迫和"}, {"type": "subtitle", "time": 5062.229, "timestamp": "01:24:22", "text": "压缩机噪音运行"}, {"type": "subtitle", "time": 5064.91, "timestamp": "01:24:24", "text": "压缩机，就是它，一个显而易见的精英。"}, {"type": "subtitle", "time": 5067.03, "timestamp": "01:24:27", "text": "运行我的音频"}, {"type": "subtitle", "time": 5070.87, "timestamp": "01:24:30", "text": "普遍来说，嗯，所以都是一样的。"}, {"type": "subtitle", "time": 5073.629, "timestamp": "01:24:33", "text": "我想要的就像我想要的那种噪音"}, {"type": "subtitle", "time": 5075.669, "timestamp": "01:24:35", "text": "在 Discord 中遭受压迫"}, {"type": "subtitle", "time": 5078.99, "timestamp": "01:24:38", "text": "其他游戏等等，所以我运行它"}, {"type": "subtitle", "time": 5086.109, "timestamp": "01:24:46", "text": "普遍而言，嗯，是的。"}, {"type": "subtitle", "time": 5095.75, "timestamp": "01:24:55", "text": "我甚至不知道怎么调低变速器"}, {"type": "subtitle", "time": 5099.51, "timestamp": "01:24:59", "text": "我的声音怎么才能发出低沉的声音"}]
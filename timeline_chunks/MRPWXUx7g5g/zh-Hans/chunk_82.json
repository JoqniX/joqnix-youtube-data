[{"type": "subtitle", "time": 4920.669, "timestamp": "01:22:00", "text": "根据指南，该链接应该仍然有效。"}, {"type": "subtitle", "time": 4923.51, "timestamp": "01:22:03", "text": "虽然"}, {"type": "subtitle", "time": 4926.35, "timestamp": "01:22:06", "text": "dtive GU"}, {"type": "subtitle", "time": 4929.75, "timestamp": "01:22:09", "text": "我需要一些句子，哦，我完成了"}, {"type": "subtitle", "time": 4933.629, "timestamp": "01:22:13", "text": "这样可以，但是，是的，请遵循……"}, {"type": "subtitle", "time": 4936.75, "timestamp": "01:22:16", "text": "基本V指南"}, {"type": "subtitle", "time": 4938.65, "timestamp": "01:22:18", "text": "那么那就会是"}, {"type": "subtitle", "time": 4939.83, "timestamp": "01:22:19", "text": "[音乐]"}, {"type": "subtitle", "time": 4943.27, "timestamp": "01:22:23", "text": "够了，我该怎么处理这笔钱呢？"}, {"type": "subtitle", "time": 4945.149, "timestamp": "01:22:25", "text": "你发给我的测试数量和"}, {"type": "subtitle", "time": 4947.95, "timestamp": "01:22:27", "text": "给我买杯咖啡，我不能把它取回来"}, {"type": "subtitle", "time": 4949.99, "timestamp": "01:22:29", "text": "除非是"}, {"type": "subtitle", "time": 4952.669, "timestamp": "01:22:32", "text": "10美元，而现在的问题是……"}, {"type": "subtitle", "time": 4955.87, "timestamp": "01:22:35", "text": "比如说，我加入了砰砰作响的那部分"}, {"type": "subtitle", "time": 4959.31, "timestamp": "01:22:39", "text": "通过 Stripe Right，它显示一个喜欢它"}, {"type": "subtitle", "time": 4962.07, "timestamp": "01:22:42", "text": "他说我可以在那段时间之后撤回申请。"}, {"type": "subtitle", "time": 4965.229, "timestamp": "01:22:45", "text": "第二天就验证完毕了。"}, {"type": "subtitle", "time": 4967.79, "timestamp": "01:22:47", "text": "我收到一封验证邮件。"}, {"type": "subtitle", "time": 4969.91, "timestamp": "01:22:49", "text": "失败了或者出了什么问题，但仍然显示"}, {"type": "subtitle", "time": 4972.91, "timestamp": "01:22:52", "text": "入职培训，所以每两天一次，每当我"}, {"type": "subtitle", "time": 4977.43, "timestamp": "01:22:57", "text": "试着请我喝杯咖啡，呃，报酬"}]
[{"type": "subtitle", "time": 13202.95, "timestamp": "03:40:02", "text": "还有这一切，哦，我的天哪"}, {"type": "subtitle", "time": 13207.389, "timestamp": "03:40:07", "text": "上帝啊，你好，BR，你好吗？"}, {"type": "subtitle", "time": 13210.83, "timestamp": "03:40:10", "text": "你连续走了两个小时，没坐过吗？"}, {"type": "subtitle", "time": 13214.469, "timestamp": "03:40:14", "text": "我走了大约一个半小时，然后我"}, {"type": "subtitle", "time": 13216.55, "timestamp": "03:40:16", "text": "坐着"}, {"type": "subtitle", "time": 13218.469, "timestamp": "03:40:18", "text": "我们难过了一阵子"}, {"type": "subtitle", "time": 13222.87, "timestamp": "03:40:22", "text": "今天因为我来的时候心情很差，所以我"}, {"type": "subtitle", "time": 13223.99, "timestamp": "03:40:23", "text": "喜欢"}, {"type": "subtitle", "time": 13227.03, "timestamp": "03:40:27", "text": "谢天谢地"}, {"type": "subtitle", "time": 13230.91, "timestamp": "03:40:30", "text": "离开我会很痛苦，我不想要任何痛苦"}, {"type": "subtitle", "time": 13234.189, "timestamp": "03:40:34", "text": "三个人走过来和我说话，"}, {"type": "subtitle", "time": 13244.11, "timestamp": "03:40:44", "text": "害怕，我希望它是"}, {"type": "subtitle", "time": 13246.309, "timestamp": "03:40:46", "text": "莫是"}, {"type": "subtitle", "time": 13249.389, "timestamp": "03:40:49", "text": "事情就是这样，我应该完成这件事吗？"}, {"type": "subtitle", "time": 13252.309, "timestamp": "03:40:52", "text": "百事可乐瓶子只剩一点点了。"}, {"type": "subtitle", "time": 13254.03, "timestamp": "03:40:54", "text": "和"}, {"type": "subtitle", "time": 13259.15, "timestamp": "03:40:59", "text": "我今天吃晚饭的时候喝了一整瓶酒"}]
[{"type": "subtitle", "time": 8761.79, "timestamp": "02:26:01", "text": "分开安排的话，你可以计划更多的事情。"}, {"type": "subtitle", "time": 8766.11, "timestamp": "02:26:06", "text": "友好，还有你知道的一切，是的。"}, {"type": "subtitle", "time": 8767.429, "timestamp": "02:26:07", "text": "这"}, {"type": "subtitle", "time": 8774.87, "timestamp": "02:26:14", "text": "自由"}, {"type": "subtitle", "time": 8777.349, "timestamp": "02:26:17", "text": "至少要做到"}, {"type": "subtitle", "time": 8783.23, "timestamp": "02:26:23", "text": "不知怎么的，现在有一天我不再依赖任何人了。"}, {"type": "subtitle", "time": 8786.87, "timestamp": "02:26:26", "text": "对人们的影响很大，但慢慢地开始了"}, {"type": "subtitle", "time": 8789.429, "timestamp": "02:26:29", "text": "一点点"}, {"type": "subtitle", "time": 8792.55, "timestamp": "02:26:32", "text": "我觉得……我不知道它是否符合OCC的要求。"}, {"type": "subtitle", "time": 8794.75, "timestamp": "02:26:34", "text": "名人"}, {"type": "subtitle", "time": 8799.07, "timestamp": "02:26:39", "text": "有时候我有点儿……因为我总是问……"}, {"type": "subtitle", "time": 8802.91, "timestamp": "02:26:42", "text": "我感觉还好吗？我可以问其他人的问题吗？"}, {"type": "subtitle", "time": 8804.15, "timestamp": "02:26:44", "text": "人们的"}, {"type": "subtitle", "time": 8809.19, "timestamp": "02:26:49", "text": "帮忙，你知道怎么回事，不是这样的，不是这样的"}, {"type": "subtitle", "time": 8811.349, "timestamp": "02:26:51", "text": "没那么糟糕，但事实并非如此"}, {"type": "subtitle", "time": 8815.309, "timestamp": "02:26:55", "text": "不太好，感觉全是车。"}, {"type": "subtitle", "time": 8818.63, "timestamp": "02:26:58", "text": "它就像我的车一样，所以另一个是"}]
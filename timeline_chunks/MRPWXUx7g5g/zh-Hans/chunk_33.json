[{"type": "subtitle", "time": 2014.149, "timestamp": "00:33:34", "text": "还有，我有没有跟你说过我遇到的那个人？"}, {"type": "subtitle", "time": 2016.43, "timestamp": "00:33:36", "text": "我想我在推特上提到过这件事。"}, {"type": "subtitle", "time": 2020.31, "timestamp": "00:33:40", "text": "对，我遇到的那个人，呃，日本人"}, {"type": "subtitle", "time": 2023.23, "timestamp": "00:33:43", "text": "你附近经营乌冬面店的人"}, {"type": "subtitle", "time": 2026.07, "timestamp": "00:33:46", "text": "伙计们，记住，这意味着我曾经说过我"}, {"type": "subtitle", "time": 2028.11, "timestamp": "00:33:48", "text": "想去这家拉面店看看"}, {"type": "subtitle", "time": 2032.11, "timestamp": "00:33:52", "text": "附近有家正宗的乌冬面店。"}, {"type": "subtitle", "time": 2034.629, "timestamp": "00:33:54", "text": "那个日本本土人士"}, {"type": "subtitle", "time": 2038.07, "timestamp": "00:33:58", "text": "田中山经营着那个地方"}]
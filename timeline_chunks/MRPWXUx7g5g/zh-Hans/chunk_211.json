[{"type": "subtitle", "time": 12661.83, "timestamp": "03:31:01", "text": "儿子很可能和大多数人一样"}, {"type": "subtitle", "time": 12669.75, "timestamp": "03:31:09", "text": "我和他交流不多，不过是的。"}, {"type": "subtitle", "time": 12672.429, "timestamp": "03:31:12", "text": "我们，我不"}, {"type": "subtitle", "time": 12675.75, "timestamp": "03:31:15", "text": "我知道我尽量和他们相处融洽。"}, {"type": "subtitle", "time": 12678.11, "timestamp": "03:31:18", "text": "但是，是的，还有一件事，那就是……"}, {"type": "subtitle", "time": 12680.71, "timestamp": "03:31:20", "text": "值得庆幸的是，他至少让我来了。"}, {"type": "subtitle", "time": 12682.11, "timestamp": "03:31:22", "text": "一个"}, {"type": "subtitle", "time": 12685.79, "timestamp": "03:31:25", "text": "展示出来，让大家知道我超级开心"}, {"type": "subtitle", "time": 12688.15, "timestamp": "03:31:28", "text": "所有美好的瞬间都来自"}, {"type": "subtitle", "time": 12691.349, "timestamp": "03:31:31", "text": "那个人让我看了他的演出，我当时"}, {"type": "subtitle", "time": 12694.83, "timestamp": "03:31:34", "text": "看到他在舞台上，我真的太高兴了。"}, {"type": "subtitle", "time": 12697.95, "timestamp": "03:31:37", "text": "而且他留着很长的头发，所以他"}, {"type": "subtitle", "time": 12700.269, "timestamp": "03:31:40", "text": "就像甩头一样，还有他的头发"}, {"type": "subtitle", "time": 12704.229, "timestamp": "03:31:44", "text": "到处流淌，"}, {"type": "subtitle", "time": 12706.429, "timestamp": "03:31:46", "text": "所有那些很酷的东西，以及所有的一切"}, {"type": "subtitle", "time": 12708.87, "timestamp": "03:31:48", "text": "你用的音乐以及我当时的感受就像……"}, {"type": "subtitle", "time": 12711.59, "timestamp": "03:31:51", "text": "哇，我应该去，我也会去的。"}, {"type": "subtitle", "time": 12714.03, "timestamp": "03:31:54", "text": "在那个舞台上的一天"}, {"type": "subtitle", "time": 12717.55, "timestamp": "03:31:57", "text": "一切都好，但我预计"}]
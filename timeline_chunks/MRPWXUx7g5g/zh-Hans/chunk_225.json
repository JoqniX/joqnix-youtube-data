[{"type": "subtitle", "time": 13510.55, "timestamp": "03:45:10", "text": "想说的是，夜还很长。"}, {"type": "subtitle", "time": 13513.07, "timestamp": "03:45:13", "text": "但它是"}, {"type": "subtitle", "time": 13515.67, "timestamp": "03:45:15", "text": "这不是我的比赛计划"}, {"type": "subtitle", "time": 13517.79, "timestamp": "03:45:17", "text": "我要去那里"}, {"type": "subtitle", "time": 13522.469, "timestamp": "03:45:22", "text": "拉莉，你走这边就行，好吧，没问题。"}, {"type": "subtitle", "time": 13525.149, "timestamp": "03:45:25", "text": "这条路有点……"}, {"type": "subtitle", "time": 13527.429, "timestamp": "03:45:27", "text": "冒险的"}, {"type": "subtitle", "time": 13530.389, "timestamp": "03:45:30", "text": "我真的什么都不祈祷"}, {"type": "subtitle", "time": 13532.75, "timestamp": "03:45:32", "text": "是的，确实如此，这条路就是这样。"}, {"type": "subtitle", "time": 13533.429, "timestamp": "03:45:33", "text": "的"}, {"type": "subtitle", "time": 13537.149, "timestamp": "03:45:37", "text": "有风险，他们会像喝醉了一样。"}, {"type": "subtitle", "time": 13540.389, "timestamp": "03:45:40", "text": "人们哦"}, {"type": "subtitle", "time": 13543.59, "timestamp": "03:45:43", "text": "就像美国那样，他们会是上帝之类的。"}, {"type": "subtitle", "time": 13545.429, "timestamp": "03:45:45", "text": "就像你可以携带一样"}, {"type": "subtitle", "time": 13550.75, "timestamp": "03:45:50", "text": "就像胡椒粉之类的东西，这里有……"}, {"type": "subtitle", "time": 13553.229, "timestamp": "03:45:53", "text": "如果有人想知道会发生什么，那就不会了。"}, {"type": "subtitle", "time": 13555.389, "timestamp": "03:45:55", "text": "有人偷了我的截图或其他东西"}, {"type": "subtitle", "time": 13556.99, "timestamp": "03:45:56", "text": "我的手机里所有东西，什么什么什么"}, {"type": "subtitle", "time": 13559.63, "timestamp": "03:45:59", "text": "事情发生了，我不知道该如何反抗"}]
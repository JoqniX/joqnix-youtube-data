[{"type": "subtitle", "time": 20041.51, "timestamp": "05:34:01", "text": "你发现了什么？"}, {"type": "subtitle", "time": 20052.11, "timestamp": "05:34:12", "text": "等等，是我吗？"}, {"type": "subtitle", "time": 20055.83, "timestamp": "05:34:15", "text": "或者说，故事任务没有这些内容。"}, {"type": "subtitle", "time": 20056.91, "timestamp": "05:34:16", "text": "嗓音"}, {"type": "subtitle", "time": 20059.868, "timestamp": "05:34:19", "text": "线条只是"}, {"type": "subtitle", "time": 20068.628, "timestamp": "05:34:28", "text": "线条无法理解，但可以看到"}, {"type": "subtitle", "time": 20070.868, "timestamp": "05:34:30", "text": "几乎没有观察就开始生气了"}, {"type": "subtitle", "time": 20074.15, "timestamp": "05:34:34", "text": "一张地图，就像一道门，通往另一个地方"}, {"type": "subtitle", "time": 20075.59, "timestamp": "05:34:35", "text": "与漂浮物有关。"}, {"type": "subtitle", "time": 20085.27, "timestamp": "05:34:45", "text": "看起来一片混乱，我们需要激活"}, {"type": "subtitle", "time": 20086.51, "timestamp": "05:34:46", "text": "那五个"}, {"type": "subtitle", "time": 20089.07, "timestamp": "05:34:49", "text": "有人需要用设备击中水晶"}, {"type": "subtitle", "time": 20091.39, "timestamp": "05:34:51", "text": "或者，然后黑点就会出现。"}, {"type": "subtitle", "time": 20093.39, "timestamp": "05:34:53", "text": "消失"}, {"type": "subtitle", "time": 20095.91, "timestamp": "05:34:55", "text": "哦，我猜他们只是忘了怎么画画了。"}]
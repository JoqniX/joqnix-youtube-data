[{"type": "subtitle", "time": 19040.43, "timestamp": "05:17:20", "text": "是的，你在这里做什么？我做了什么？"}, {"type": "subtitle", "time": 19042.43, "timestamp": "05:17:22", "text": "在某些方面惹恼你"}, {"type": "subtitle", "time": 19045.47, "timestamp": "05:17:25", "text": "你知道P真的在经历TR吗？"}, {"type": "subtitle", "time": 19048.31, "timestamp": "05:17:28", "text": "说出你们俩之间是谁"}, {"type": "subtitle", "time": 19051.47, "timestamp": "05:17:31", "text": "路途遥远，你需要多休息。"}, {"type": "subtitle", "time": 19055.19, "timestamp": "05:17:35", "text": "是的，你好 Roku，哦我的天，已经很久了"}, {"type": "subtitle", "time": 19058.83, "timestamp": "05:17:38", "text": "永远，你好吗，Roku，想你了，笨蛋"}, {"type": "subtitle", "time": 19061.99, "timestamp": "05:17:41", "text": "生活如何？现在如何？一切都好吗？"}, {"type": "subtitle", "time": 19069.23, "timestamp": "05:17:49", "text": "你我都不想躺在我的床上。"}, {"type": "subtitle", "time": 19072.788, "timestamp": "05:17:52", "text": "D AG 在 L 年龄段内依赖于"}, {"type": "subtitle", "time": 19075.628, "timestamp": "05:17:55", "text": "其他人吃饭，甚至我自己去吃饭。"}, {"type": "subtitle", "time": 19078.83, "timestamp": "05:17:58", "text": "如果厕所有其他选择，我会选择这个。"}]
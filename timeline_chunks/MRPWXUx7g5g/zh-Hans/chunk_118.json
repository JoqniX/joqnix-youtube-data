[{"type": "subtitle", "time": 7082.589, "timestamp": "01:58:02", "text": "我步行回来，那里有57人。"}, {"type": "subtitle", "time": 7085.629, "timestamp": "01:58:05", "text": "日子里，所以有很多人很多"}, {"type": "subtitle", "time": 7088.87, "timestamp": "01:58:08", "text": "交通堵塞，但我一路走到了这里。"}, {"type": "subtitle", "time": 7092.629, "timestamp": "01:58:12", "text": "步行的地方，呃，东西和猜"}, {"type": "subtitle", "time": 7095.709, "timestamp": "01:58:15", "text": "我忘了带钱包，所以我真的"}, {"type": "subtitle", "time": 7098.629, "timestamp": "01:58:18", "text": "回去拿我的"}, {"type": "subtitle", "time": 7102.189, "timestamp": "01:58:22", "text": "钱包，然后回到那里，就是这样。"}, {"type": "subtitle", "time": 7104.669, "timestamp": "01:58:24", "text": "差不多一个小时，呃，差不多"}, {"type": "subtitle", "time": 7108.39, "timestamp": "01:58:28", "text": "大作品就像小作品一样，哦我的天哪"}, {"type": "subtitle", "time": 7135.589, "timestamp": "01:58:55", "text": "我喜欢这里内容如此丰富。"}]
[{"type": "subtitle", "time": 19200.91, "timestamp": "05:20:00", "text": "之前的消息我很抱歉，那就是原因。"}, {"type": "subtitle", "time": 19206.548, "timestamp": "05:20:06", "text": "出现"}, {"type": "subtitle", "time": 19210.548, "timestamp": "05:20:10", "text": "每个人都需要一个普通的或"}, {"type": "subtitle", "time": 19228.75, "timestamp": "05:20:28", "text": "我们都很担心你。"}, {"type": "subtitle", "time": 19230.948, "timestamp": "05:20:30", "text": "请不要如此粗暴地对待"}, {"type": "subtitle", "time": 19234.15, "timestamp": "05:20:34", "text": "你自己吧，伙计，这就是我每次都遇到的情况。"}, {"type": "subtitle", "time": 19237.15, "timestamp": "05:20:37", "text": "每次都是你们"}, {"type": "subtitle", "time": 19240.51, "timestamp": "05:20:40", "text": "有时疼痛"}, {"type": "subtitle", "time": 19245.59, "timestamp": "05:20:45", "text": "不，我喜欢逼自己太紧，结果反而适得其反。"}, {"type": "subtitle", "time": 19248.99, "timestamp": "05:20:48", "text": "这就是你如此努力的乐趣所在"}, {"type": "subtitle", "time": 19252.11, "timestamp": "05:20:52", "text": "你这个笨蛋，还有，呃，就像因为所有的"}, {"type": "subtitle", "time": 19254.43, "timestamp": "05:20:54", "text": "外面有人骂脏话，还有邦和我"}, {"type": "subtitle", "time": 19257.15, "timestamp": "05:20:57", "text": "就像打我耳光一样，打吉斯"}]
[{"type": "subtitle", "time": 15841.03, "timestamp": "04:24:01", "text": "好久没玩Genin Impact了"}, {"type": "subtitle", "time": 15843.59, "timestamp": "04:24:03", "text": "自从我玩了《Genin Impact》之后，我就……"}, {"type": "subtitle", "time": 15847.469, "timestamp": "04:24:07", "text": "很兴奋能进入下忍阶段"}, {"type": "subtitle", "time": 15850.99, "timestamp": "04:24:10", "text": "好久不见了，嗯，我知道"}, {"type": "subtitle", "time": 15853.189, "timestamp": "04:24:13", "text": "标题说探索宝箱，是的，我"}, {"type": "subtitle", "time": 15856.189, "timestamp": "04:24:16", "text": "已经探索过附近的峡谷"}, {"type": "subtitle", "time": 15860.109, "timestamp": "04:24:20", "text": "一周前或五天前直播了五次"}, {"type": "subtitle", "time": 15863.189, "timestamp": "04:24:23", "text": "前段时间我确实探索过，也做了一些任务。"}, {"type": "subtitle", "time": 15866.83, "timestamp": "04:24:26", "text": "就像速通游戏一样，我想做的就是……"}, {"type": "subtitle", "time": 15869.71, "timestamp": "04:24:29", "text": "我无法参加那个活动，所以我们"}, {"type": "subtitle", "time": 15871.51, "timestamp": "04:24:31", "text": "将会对底盘进行一些速度测试"}, {"type": "subtitle", "time": 15874.349, "timestamp": "04:24:34", "text": "今天的内容"}]
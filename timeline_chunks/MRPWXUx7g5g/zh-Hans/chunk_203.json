[{"type": "subtitle", "time": 12181.99, "timestamp": "03:23:01", "text": "人与一切，以及不存在"}, {"type": "subtitle", "time": 12184.79, "timestamp": "03:23:04", "text": "冷酷无情的人"}, {"type": "subtitle", "time": 12188.469, "timestamp": "03:23:08", "text": "是的，把钱留给埃梅雷斯吧。"}, {"type": "subtitle", "time": 12192.15, "timestamp": "03:23:12", "text": "没错，但就像有一天我……"}, {"type": "subtitle", "time": 12194.75, "timestamp": "03:23:14", "text": "当我用的时候，当我给了点钱的时候"}, {"type": "subtitle", "time": 12197.79, "timestamp": "03:23:17", "text": "我爸说，不行，留着，留着。"}, {"type": "subtitle", "time": 12199.51, "timestamp": "03:23:19", "text": "为了你自己"}, {"type": "subtitle", "time": 12204.349, "timestamp": "03:23:24", "text": "东西，但字面意义上的"}, {"type": "subtitle", "time": 12207.189, "timestamp": "03:23:27", "text": "如今，呃，如今，真的就是我爸爸"}, {"type": "subtitle", "time": 12210.15, "timestamp": "03:23:30", "text": "给我一点钱，就为了"}, {"type": "subtitle", "time": 12212.51, "timestamp": "03:23:32", "text": "比如出去吃饭、出去玩等等"}, {"type": "subtitle", "time": 12215.309, "timestamp": "03:23:35", "text": "那些东西，我心想，我应该……"}, {"type": "subtitle", "time": 12218.55, "timestamp": "03:23:38", "text": "我会非常谨慎地支配这笔钱，因为"}, {"type": "subtitle", "time": 12222.11, "timestamp": "03:23:42", "text": "我还是不知道该怎么做。"}, {"type": "subtitle", "time": 12226.189, "timestamp": "03:23:46", "text": "嗯，你总能确保这一切"}, {"type": "subtitle", "time": 12227.189, "timestamp": "03:23:47", "text": "喜欢"}, {"type": "subtitle", "time": 12231.189, "timestamp": "03:23:51", "text": "就像主要运行一样"}, {"type": "subtitle", "time": 12234.63, "timestamp": "03:23:54", "text": "家庭，还有账单之类的。"}, {"type": "subtitle", "time": 12237.07, "timestamp": "03:23:57", "text": "东西、深度以及一切，真是如此。"}]
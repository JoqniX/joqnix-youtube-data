[{"type": "subtitle", "time": 9183.23, "timestamp": "02:33:03", "text": "我应该多一些"}, {"type": "subtitle", "time": 9188.11, "timestamp": "02:33:08", "text": "呃，或许应该更像什么？"}, {"type": "subtitle", "time": 9190.15, "timestamp": "02:33:10", "text": "你打电话"}, {"type": "subtitle", "time": 9193.91, "timestamp": "02:33:13", "text": "它坐了下来，"}, {"type": "subtitle", "time": 9195.79, "timestamp": "02:33:15", "text": "讲话"}, {"type": "subtitle", "time": 9199.389, "timestamp": "02:33:19", "text": "所以，今天我遇到了一个朋友，他一直都在。"}, {"type": "subtitle", "time": 9202.91, "timestamp": "02:33:22", "text": "时间过去了，问题是我们有"}, {"type": "subtitle", "time": 9206.75, "timestamp": "02:33:26", "text": "我们以前经常吵架，我们以前经常……"}, {"type": "subtitle", "time": 9211.469, "timestamp": "02:33:31", "text": "知道一些朋友之间的事情，比如……"}, {"type": "subtitle", "time": 9212.389, "timestamp": "02:33:32", "text": "有点儿"}, {"type": "subtitle", "time": 9215.429, "timestamp": "02:33:35", "text": "停止了，这件事是关于我的。"}, {"type": "subtitle", "time": 9220.87, "timestamp": "02:33:40", "text": "这就像今天发生的事情一样。"}, {"type": "subtitle", "time": 9222.389, "timestamp": "02:33:42", "text": "有时候我只是"}, {"type": "subtitle", "time": 9224.75, "timestamp": "02:33:44", "text": "去电台"}, {"type": "subtitle", "time": 9228.269, "timestamp": "02:33:48", "text": "沉默和一些东西，这使得其他 L"}, {"type": "subtitle", "time": 9231.07, "timestamp": "02:33:51", "text": "人们会阅读更多"}, {"type": "subtitle", "time": 9234.03, "timestamp": "02:33:54", "text": "比如，呃，逃离。"}, {"type": "subtitle", "time": 9236.67, "timestamp": "02:33:56", "text": "是啊是啊是啊，我经常那样做。"}]
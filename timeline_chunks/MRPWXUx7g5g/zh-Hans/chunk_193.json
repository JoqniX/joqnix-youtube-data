[{"type": "subtitle", "time": 11587.67, "timestamp": "03:13:07", "text": "等等，哦，是29号，好的好的"}, {"type": "subtitle", "time": 11590.429, "timestamp": "03:13:10", "text": "等等，她什么时候来？"}, {"type": "subtitle", "time": 11592.79, "timestamp": "03:13:12", "text": "直播的时候我感觉就像真的"}, {"type": "subtitle", "time": 11601.55, "timestamp": "03:13:21", "text": "显然是29号。"}, {"type": "subtitle", "time": 11604.71, "timestamp": "03:13:24", "text": "明天就是6月4日了，那就像"}, {"type": "subtitle", "time": 11607.11, "timestamp": "03:13:27", "text": "就在我参加ACAM的前一天，我的天哪"}, {"type": "subtitle", "time": 11608.91, "timestamp": "03:13:28", "text": "这段等待是否意味着我拥有"}, {"type": "subtitle", "time": 11612.71, "timestamp": "03:13:32", "text": "只剩一周了，我的天哪！"}, {"type": "subtitle", "time": 11619.83, "timestamp": "03:13:39", "text": "左边，我的天哪，我的天哪，蚊子！"}, {"type": "subtitle", "time": 11622.15, "timestamp": "03:13:42", "text": "那种疼痛，哦我的天，这个地方真痛苦"}, {"type": "subtitle", "time": 11625.07, "timestamp": "03:13:45", "text": "因为那里有树之类的东西"}, {"type": "subtitle", "time": 11628.71, "timestamp": "03:13:48", "text": "蚊子在另一个地方是伯尔"}, {"type": "subtitle", "time": 11635.83, "timestamp": "03:13:55", "text": "是啊，仔细想想，我从来没上过。"}, {"type": "subtitle", "time": 11638.309, "timestamp": "03:13:58", "text": "风险投资家"}]
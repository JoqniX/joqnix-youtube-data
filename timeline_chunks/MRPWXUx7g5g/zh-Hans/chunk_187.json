[{"type": "subtitle", "time": 11220.71, "timestamp": "03:07:00", "text": "[音乐]"}, {"type": "subtitle", "time": 11224.83, "timestamp": "03:07:04", "text": "那个人，我真的亲眼见过他。"}, {"type": "subtitle", "time": 11227.75, "timestamp": "03:07:07", "text": "他早些时候又来了，而且像"}, {"type": "subtitle", "time": 11231.15, "timestamp": "03:07:11", "text": "字面上是“踩踏”，而不是“踩踏更多”。"}, {"type": "subtitle", "time": 11233.429, "timestamp": "03:07:13", "text": "就像透过裂缝一样"}, {"type": "subtitle", "time": 11235.75, "timestamp": "03:07:15", "text": "有人，就像那些和他们一样的人"}, {"type": "subtitle", "time": 11238.429, "timestamp": "03:07:18", "text": "坐在上面，我感觉就像"}, {"type": "subtitle", "time": 11242.15, "timestamp": "03:07:22", "text": "哇，你怎么能这样？我就坐在这里吧。"}, {"type": "subtitle", "time": 11248.19, "timestamp": "03:07:28", "text": "猜测"}, {"type": "subtitle", "time": 11250.67, "timestamp": "03:07:30", "text": "终于找到一个地方"}, {"type": "subtitle", "time": 11254.71, "timestamp": "03:07:34", "text": "她是这样看的，你要去哪儿？"}, {"type": "subtitle", "time": 11259.71, "timestamp": "03:07:39", "text": "到我让烹饪的时间，我让"}, {"type": "subtitle", "time": 11263.15, "timestamp": "03:07:43", "text": "烹饪没问题，我的角色65级，伤害我的力量"}, {"type": "subtitle", "time": 11273.07, "timestamp": "03:07:53", "text": "上帝"}, {"type": "subtitle", "time": 11275.349, "timestamp": "03:07:55", "text": "75"}, {"type": "subtitle", "time": 11278.469, "timestamp": "03:07:58", "text": "好的，这意味着它没死。"}]
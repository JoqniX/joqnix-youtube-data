[{"type": "subtitle", "time": 12121.429, "timestamp": "03:22:01", "text": "最后，最重要的事情是首要任务。"}, {"type": "subtitle", "time": 12123.229, "timestamp": "03:22:03", "text": "最重要的是把它交给"}, {"type": "subtitle", "time": 12125.189, "timestamp": "03:22:05", "text": "家人"}, {"type": "subtitle", "time": 12128.83, "timestamp": "03:22:08", "text": "至少因为呃"}, {"type": "subtitle", "time": 12132.309, "timestamp": "03:22:12", "text": "是啊是啊，我感觉就像我身处……"}, {"type": "subtitle", "time": 12134.229, "timestamp": "03:22:14", "text": "我的家庭目前的情况需要"}, {"type": "subtitle", "time": 12138.71, "timestamp": "03:22:18", "text": "金钱、喜欢之类的东西，但是，是的。"}, {"type": "subtitle", "time": 12141.269, "timestamp": "03:22:21", "text": "我不知道该怎么办，我应该像这样吗？我不知道"}, {"type": "subtitle", "time": 12144.469, "timestamp": "03:22:24", "text": "如果自私一点是可以接受的，那么我……"}, {"type": "subtitle", "time": 12147.71, "timestamp": "03:22:27", "text": "注意，这些年来，我"}, {"type": "subtitle", "time": 12149.63, "timestamp": "03:22:29", "text": "注意"}, {"type": "subtitle", "time": 12152.03, "timestamp": "03:22:32", "text": "当时，那边有一个"}, {"type": "subtitle", "time": 12154.389, "timestamp": "03:22:34", "text": "我收到一点钱的时候"}, {"type": "subtitle", "time": 12155.63, "timestamp": "03:22:35", "text": "我用过的东西"}, {"type": "subtitle", "time": 12159.07, "timestamp": "03:22:39", "text": "呃，给自己买点东西，然后……"}, {"type": "subtitle", "time": 12163.51, "timestamp": "03:22:43", "text": "我以前会分给他们一半左右。"}, {"type": "subtitle", "time": 12164.99, "timestamp": "03:22:44", "text": "我不喜欢"}, {"type": "subtitle", "time": 12167.51, "timestamp": "03:22:47", "text": "家人，是的，当我"}, {"type": "subtitle", "time": 12170.75, "timestamp": "03:22:50", "text": "可以，但我明白我不应该这样做。"}, {"type": "subtitle", "time": 12174.11, "timestamp": "03:22:54", "text": "你知道如果你正在获得什么"}, {"type": "subtitle", "time": 12175.91, "timestamp": "03:22:55", "text": "付费的或者你实际上应该做的"}, {"type": "subtitle", "time": 12179.429, "timestamp": "03:22:59", "text": "慷慨的权利，并将其归还给"}]
[{"type": "subtitle", "time": 9661.91, "timestamp": "02:41:01", "text": "那确实是一件很严肃的事情，但是"}, {"type": "subtitle", "time": 9674.83, "timestamp": "02:41:14", "text": "上面有很多"}, {"type": "subtitle", "time": 9678.15, "timestamp": "02:41:18", "text": "只是，但像这样出来就……"}, {"type": "subtitle", "time": 9679.91, "timestamp": "02:41:19", "text": "乐趣"}, {"type": "subtitle", "time": 9681.65, "timestamp": "02:41:21", "text": "这一个"}, {"type": "subtitle", "time": 9683.389, "timestamp": "02:41:23", "text": "[音乐]"}, {"type": "subtitle", "time": 9686.71, "timestamp": "02:41:26", "text": "放松下来，我意识到一件事"}, {"type": "subtitle", "time": 9690.59, "timestamp": "02:41:30", "text": "这个地方一直在向右移动。"}, {"type": "subtitle", "time": 9692.15, "timestamp": "02:41:32", "text": "我有很多东西……"}, {"type": "subtitle", "time": 9693.15, "timestamp": "02:41:33", "text": "担心"}, {"type": "subtitle", "time": 9696.469, "timestamp": "02:41:36", "text": "更像是这样"}, {"type": "subtitle", "time": 9698.71, "timestamp": "02:41:38", "text": "隐私？不，我会得到我的隐私，但是"}, {"type": "subtitle", "time": 9709.429, "timestamp": "02:41:49", "text": "更像是我从未想过要成为"}, {"type": "subtitle", "time": 9712.03, "timestamp": "02:41:52", "text": "一个人生活，喜欢一些东西，但是……"}, {"type": "subtitle", "time": 9714.429, "timestamp": "02:41:54", "text": "效果不佳"}, {"type": "subtitle", "time": 9716.63, "timestamp": "02:41:56", "text": "令人遗憾的是"}]
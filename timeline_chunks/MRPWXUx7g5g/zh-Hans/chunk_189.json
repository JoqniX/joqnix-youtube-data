[{"type": "subtitle", "time": 11340.91, "timestamp": "03:09:00", "text": "一点点"}, {"type": "subtitle", "time": 11351.269, "timestamp": "03:09:11", "text": "是的，我在家确实吃得少很多。"}, {"type": "subtitle", "time": 11356.11, "timestamp": "03:09:16", "text": "旅途中，我吃得像吃了很多东西一样。"}, {"type": "subtitle", "time": 11358.75, "timestamp": "03:09:18", "text": "食物，我就想"}, {"type": "subtitle", "time": 11361.11, "timestamp": "03:09:21", "text": "哇，真的"}, {"type": "subtitle", "time": 11364.11, "timestamp": "03:09:24", "text": "哇，我怎么可能做到？我应该怎么做？"}, {"type": "subtitle", "time": 11377.19, "timestamp": "03:09:37", "text": "你知道下次该怎么做了吧？"}, {"type": "subtitle", "time": 11381.11, "timestamp": "03:09:41", "text": "而不是像你一样购买"}, {"type": "subtitle", "time": 11383.67, "timestamp": "03:09:43", "text": "买点儿像青柠汁之类的东西"}, {"type": "subtitle", "time": 11386.07, "timestamp": "03:09:46", "text": "这只是暂时的，幸运的是，我"}, {"type": "subtitle", "time": 11388.95, "timestamp": "03:09:48", "text": "实际上应该用那笔钱去买一个"}, {"type": "subtitle", "time": 11392.07, "timestamp": "03:09:52", "text": "一瓶软饮料之类的东西"}, {"type": "subtitle", "time": 11394.429, "timestamp": "03:09:54", "text": "这就是我能拥有它的原因，也更好。"}, {"type": "subtitle", "time": 11396.79, "timestamp": "03:09:56", "text": "一瓶，我可以像以前一样把它喝完。"}]
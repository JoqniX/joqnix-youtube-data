[{"type": "subtitle", "time": 10020.11, "timestamp": "02:47:00", "text": "就像我玩Fe游戏那样，我现在……"}, {"type": "subtitle", "time": 10023.309, "timestamp": "02:47:03", "text": "所以，在专注模式和快乐模式下，我"}, {"type": "subtitle", "time": 10026.19, "timestamp": "02:47:06", "text": "我喜欢玩游戏什么的，我"}, {"type": "subtitle", "time": 10029.71, "timestamp": "02:47:09", "text": "你知道，走路就像昨天一样。"}, {"type": "subtitle", "time": 10034.389, "timestamp": "02:47:14", "text": "那么，在通话中，关键是什么呢？"}, {"type": "subtitle", "time": 10036.63, "timestamp": "02:47:16", "text": "步行溪流之后不再行走"}, {"type": "subtitle", "time": 10038.15, "timestamp": "02:47:18", "text": "步行回家后，溪水潺潺。"}, {"type": "subtitle", "time": 10040.95, "timestamp": "02:47:20", "text": "然后切换回PC"}, {"type": "subtitle", "time": 10046.07, "timestamp": "02:47:26", "text": "直播的时候我有点意外。"}, {"type": "subtitle", "time": 10051.75, "timestamp": "02:47:31", "text": "Zuki会说，就像我投入了多少一样。"}, {"type": "subtitle", "time": 10054.95, "timestamp": "02:47:34", "text": "投入到这该死的开支中，而且就像这样"}, {"type": "subtitle", "time": 10057.07, "timestamp": "02:47:37", "text": "我每次都笑得很开心"}, {"type": "subtitle", "time": 10058.429, "timestamp": "02:47:38", "text": "说话或"}, {"type": "subtitle", "time": 10063.15, "timestamp": "02:47:43", "text": "我当时就在想，我该怎么处理这件事呢？"}, {"type": "subtitle", "time": 10066.67, "timestamp": "02:47:46", "text": "当然，我注意到我确实会微笑。"}, {"type": "subtitle", "time": 10070.71, "timestamp": "02:47:50", "text": "很多，而且话很多"}]
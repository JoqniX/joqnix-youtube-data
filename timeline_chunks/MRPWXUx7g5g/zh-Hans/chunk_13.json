[{"type": "subtitle", "time": 810.79, "timestamp": "00:13:30", "text": "事物语言只是交换一个人可以"}, {"type": "subtitle", "time": 813.55, "timestamp": "00:13:33", "text": "我必须主动联系他们，但我并不"}, {"type": "subtitle", "time": 816.43, "timestamp": "00:13:36", "text": "知道他们是否会"}, {"type": "subtitle", "time": 820.91, "timestamp": "00:13:40", "text": "下去，我必须是个超级"}, {"type": "subtitle", "time": 823.829, "timestamp": "00:13:43", "text": "专业人士"}, {"type": "subtitle", "time": 830.47, "timestamp": "00:13:50", "text": "害怕，但这不是害怕的问题。"}, {"type": "subtitle", "time": 833.069, "timestamp": "00:13:53", "text": "关键在于实际行动。"}, {"type": "subtitle", "time": 836.59, "timestamp": "00:13:56", "text": "迈出建设的第一步"}, {"type": "subtitle", "time": 839.629, "timestamp": "00:13:59", "text": "连接"}]
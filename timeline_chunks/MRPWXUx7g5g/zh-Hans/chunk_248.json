[{"type": "subtitle", "time": 14882.59, "timestamp": "04:08:02", "text": "从开始到结束"}, {"type": "subtitle", "time": 14884.99, "timestamp": "04:08:04", "text": "苣荬菜"}, {"type": "subtitle", "time": 14888.51, "timestamp": "04:08:08", "text": "从开始到结束，直到现在。"}, {"type": "subtitle", "time": 14893.51, "timestamp": "04:08:13", "text": "出生后，我看到了很多照片，我只是"}, {"type": "subtitle", "time": 14897.79, "timestamp": "04:08:17", "text": "只想保持善良，继续做我自己。"}, {"type": "subtitle", "time": 14901.83, "timestamp": "04:08:21", "text": "是的，但也有点"}, {"type": "subtitle", "time": 14905.189, "timestamp": "04:08:25", "text": "为了有更多改进，所以"}, {"type": "subtitle", "time": 14907.87, "timestamp": "04:08:27", "text": "你知道那种"}, {"type": "subtitle", "time": 14913.229, "timestamp": "04:08:33", "text": "人会感到热，他们可能会变得非常热。"}, {"type": "subtitle", "time": 14914.349, "timestamp": "04:08:34", "text": "和"}, {"type": "subtitle", "time": 14915.95, "timestamp": "04:08:35", "text": "非常"}, {"type": "subtitle", "time": 14917.91, "timestamp": "04:08:37", "text": "呃"}, {"type": "subtitle", "time": 14920.109, "timestamp": "04:08:40", "text": "破碎的"}, {"type": "subtitle", "time": 14924.95, "timestamp": "04:08:44", "text": "那样的话，呃，就没人能听到你认识的人说话了。"}, {"type": "subtitle", "time": 14928.469, "timestamp": "04:08:48", "text": "所以他们必须足够强壮才能应对。"}, {"type": "subtitle", "time": 14931.07, "timestamp": "04:08:51", "text": "他们自己和一切都感觉很好"}, {"type": "subtitle", "time": 14933.87, "timestamp": "04:08:53", "text": "就像那样，当然"}, {"type": "subtitle", "time": 14936.83, "timestamp": "04:08:56", "text": "当然，我觉得我感觉"}]
[{"type": "subtitle", "time": 8521.19, "timestamp": "02:22:01", "text": "奇怪，但"}, {"type": "subtitle", "time": 8525.83, "timestamp": "02:22:05", "text": "就说更像是你知道的埃尔"}, {"type": "subtitle", "time": 8529.15, "timestamp": "02:22:09", "text": "我想如果我……我就坐在那边吧"}, {"type": "subtitle", "time": 8531.389, "timestamp": "02:22:11", "text": "可能只是想"}, {"type": "subtitle", "time": 8544.59, "timestamp": "02:22:24", "text": "哦，我应该先去散散步，然后再来吗？"}, {"type": "subtitle", "time": 8546.51, "timestamp": "02:22:26", "text": "后退"}, {"type": "subtitle", "time": 8556.75, "timestamp": "02:22:36", "text": "是的，所以更像是这些时候我"}, {"type": "subtitle", "time": 8560.71, "timestamp": "02:22:40", "text": "来自手机的流媒体和来自我的流媒体"}, {"type": "subtitle", "time": 8565.15, "timestamp": "02:22:45", "text": "打电话，做些事情，总是很有趣"}, {"type": "subtitle", "time": 8569.95, "timestamp": "02:22:49", "text": "如果我是一个高效的F TR，那我就是个好人了。"}, {"type": "subtitle", "time": 8573.23, "timestamp": "02:22:53", "text": "大概有30个左右吧"}, {"type": "subtitle", "time": 8576.349, "timestamp": "02:22:56", "text": "乌鸦飞得很远，就像……"}, {"type": "subtitle", "time": 8579.51, "timestamp": "02:22:59", "text": "实际上现在已经首次亮相一套服装了，或者"}]
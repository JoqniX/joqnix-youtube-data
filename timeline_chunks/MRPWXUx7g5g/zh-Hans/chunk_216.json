[{"type": "subtitle", "time": 12963.03, "timestamp": "03:36:03", "text": "对，没错，就是这样。"}, {"type": "subtitle", "time": 12965.83, "timestamp": "03:36:05", "text": "是的，自从我对自己说如果我"}, {"type": "subtitle", "time": 12967.67, "timestamp": "03:36:07", "text": "学习某事，我就是自己学的"}, {"type": "subtitle", "time": 12970.55, "timestamp": "03:36:10", "text": "比如我一直在做的那些线上事情"}, {"type": "subtitle", "time": 12974.91, "timestamp": "03:36:14", "text": "没错，但我感觉就像，真的，我"}, {"type": "subtitle", "time": 12977.15, "timestamp": "03:36:17", "text": "就像你知道的，有一天我跟你说过……"}, {"type": "subtitle", "time": 12979.59, "timestamp": "03:36:19", "text": "关于这件事，那几个家伙相当……"}, {"type": "subtitle", "time": 12982.67, "timestamp": "03:36:22", "text": "不少人在不同的NES游戏机上"}, {"type": "subtitle", "time": 12985.189, "timestamp": "03:36:25", "text": "NES 的东西，比如音乐之类的东西"}, {"type": "subtitle", "time": 12988.91, "timestamp": "03:36:28", "text": "艺术，或者像流媒体之类的，我想应该不是。"}, {"type": "subtitle", "time": 12991.87, "timestamp": "03:36:31", "text": "流媒体播放，而不是更多流媒体播放"}, {"type": "subtitle", "time": 12996.03, "timestamp": "03:36:36", "text": "比如，我启发了某人去做某事。"}, {"type": "subtitle", "time": 13000.469, "timestamp": "03:36:40", "text": "我正在做的事情，所以有一天我"}, {"type": "subtitle", "time": 13002.15, "timestamp": "03:36:42", "text": "我的一个朋友，我启发了他"}, {"type": "subtitle", "time": 13003.91, "timestamp": "03:36:43", "text": "音乐制作和DJing"}, {"type": "subtitle", "time": 13007.03, "timestamp": "03:36:47", "text": "最后一切都是他"}, {"type": "subtitle", "time": 13011.07, "timestamp": "03:36:51", "text": "他当时好像有点……嗯……"}, {"type": "subtitle", "time": 13014.229, "timestamp": "03:36:54", "text": "做音乐制作"}]
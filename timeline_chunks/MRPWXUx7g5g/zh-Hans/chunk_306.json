[{"type": "subtitle", "time": 18361.788, "timestamp": "05:06:01", "text": "克鲁，咱们把箱子锁上，我来开。"}, {"type": "subtitle", "time": 18363.47, "timestamp": "05:06:03", "text": "那"}, {"type": "subtitle", "time": 18369.788, "timestamp": "05:06:09", "text": "也是一样，即使我我我我"}, {"type": "subtitle", "time": 18372.948, "timestamp": "05:06:12", "text": "我连需要的DI都还没解锁。"}, {"type": "subtitle", "time": 18384.548, "timestamp": "05:06:24", "text": "它到底要等多久？"}, {"type": "subtitle", "time": 18387.788, "timestamp": "05:06:27", "text": "持续多少天？10天？哦不，我需要"}, {"type": "subtitle", "time": 18406.788, "timestamp": "05:06:46", "text": "被捕"}, {"type": "subtitle", "time": 18413.23, "timestamp": "05:06:53", "text": "飞行拥抱冰雪，嗨，别介意"}]
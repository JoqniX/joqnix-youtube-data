[{"type": "subtitle", "time": 15121.429, "timestamp": "04:12:01", "text": "诸如此类的事情"}, {"type": "subtitle", "time": 15126.229, "timestamp": "04:12:06", "text": "所以，因为我一直没跟他们说话。"}, {"type": "subtitle", "time": 15130.07, "timestamp": "04:12:10", "text": "任何人，很长一段时间以来"}, {"type": "subtitle", "time": 15133.189, "timestamp": "04:12:13", "text": "因为就像，我的天哪，他们到底在干什么"}, {"type": "subtitle", "time": 15134.429, "timestamp": "04:12:14", "text": "对……"}, {"type": "subtitle", "time": 15139.189, "timestamp": "04:12:19", "text": "狗，它们在和飞机战斗吗？"}, {"type": "subtitle", "time": 15145.87, "timestamp": "04:12:25", "text": "哦哦哦不，他们注意到我了哦"}, {"type": "subtitle", "time": 15151.91, "timestamp": "04:12:31", "text": "1、2、3、4、5、6、7、8、8只狗，哦，上帝"}, {"type": "subtitle", "time": 15156.469, "timestamp": "04:12:36", "text": "哦，天哪，哦，天哪，他们走开了"}, {"type": "subtitle", "time": 15160.59, "timestamp": "04:12:40", "text": "impa 1 2 3 正在看着我 1 2 3 4 5 6"}, {"type": "subtitle", "time": 15163.79, "timestamp": "04:12:43", "text": "期待着"}, {"type": "subtitle", "time": 15167.75, "timestamp": "04:12:47", "text": "哦，天哪，狗来了！"}, {"type": "subtitle", "time": 15171.91, "timestamp": "04:12:51", "text": "他们俩都在迈步"}, {"type": "subtitle", "time": 15173.95, "timestamp": "04:12:53", "text": "又是屁股哦"}, {"type": "subtitle", "time": 15175.95, "timestamp": "04:12:55", "text": "上帝是什么？"}]
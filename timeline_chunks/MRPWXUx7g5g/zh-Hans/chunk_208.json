[{"type": "subtitle", "time": 12481.91, "timestamp": "03:28:01", "text": "在金钱方面，他真是太执着了。"}, {"type": "subtitle", "time": 12483.87, "timestamp": "03:28:03", "text": "他就像在说，把我的"}, {"type": "subtitle", "time": 12487.63, "timestamp": "03:28:07", "text": "20,000 人给了我钱，就像给了我 20,000 人一样。"}, {"type": "subtitle", "time": 12490.349, "timestamp": "03:28:10", "text": "每个月都有，对吧？是吗？"}, {"type": "subtitle", "time": 12495.11, "timestamp": "03:28:15", "text": "20 不不不，但我认为整个 C 是"}, {"type": "subtitle", "time": 12498.63, "timestamp": "03:28:18", "text": "20岁，他和我爸爸把它做得好像会这样。"}, {"type": "subtitle", "time": 12502.309, "timestamp": "03:28:22", "text": "之所以发送，部分原因是……"}, {"type": "subtitle", "time": 12505.07, "timestamp": "03:28:25", "text": "当时我们遇到了类似的问题"}, {"type": "subtitle", "time": 12507.99, "timestamp": "03:28:27", "text": "他带着钱回家了，所以他"}, {"type": "subtitle", "time": 12510.269, "timestamp": "03:28:30", "text": "他还……呃，我不知道他是怎么到这儿的。"}, {"type": "subtitle", "time": 12514.99, "timestamp": "03:28:34", "text": "钱，还有他做的那些事。"}, {"type": "subtitle", "time": 12518.55, "timestamp": "03:28:38", "text": "我当时想，为了他的儿子，还有那个人"}, {"type": "subtitle", "time": 12521.07, "timestamp": "03:28:41", "text": "当时简直就像……"}, {"type": "subtitle", "time": 12523.55, "timestamp": "03:28:43", "text": "把我的钱还给我，把我的钱还给我"}, {"type": "subtitle", "time": 12525.79, "timestamp": "03:28:45", "text": "还有我想要的东西，你给我吧"}, {"type": "subtitle", "time": 12529.83, "timestamp": "03:28:49", "text": "钱什么的，我就像兄弟一样，来吧"}, {"type": "subtitle", "time": 12533.75, "timestamp": "03:28:53", "text": "那个人确实说过，我爸爸确实说过"}, {"type": "subtitle", "time": 12538.79, "timestamp": "03:28:58", "text": "他会给你钱吗？不会的。"}]
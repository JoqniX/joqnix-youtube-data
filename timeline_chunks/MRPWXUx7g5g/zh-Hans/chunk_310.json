[{"type": "subtitle", "time": 18600.27, "timestamp": "05:10:00", "text": "我已经很久没玩过这个游戏了。"}, {"type": "subtitle", "time": 18604.75, "timestamp": "05:10:04", "text": "我甚至不会去……呃，花钱……呃"}, {"type": "subtitle", "time": 18607.15, "timestamp": "05:10:07", "text": "我玩这个游戏的时间感觉又像是在刷刷刷了。"}, {"type": "subtitle", "time": 18609.948, "timestamp": "05:10:09", "text": "就像去年一样，所以我现在就像在接受它"}, {"type": "subtitle", "time": 18612.31, "timestamp": "05:10:12", "text": "速度慢，所以好坏都无所谓了。"}, {"type": "subtitle", "time": 18615.868, "timestamp": "05:10:15", "text": "即使是坏事，我也得到了我的A。"}, {"type": "subtitle", "time": 18619.51, "timestamp": "05:10:19", "text": "没关系，我们一定能做到。"}, {"type": "subtitle", "time": 18622.67, "timestamp": "05:10:22", "text": "我们会成功的"}, {"type": "subtitle", "time": 18626.83, "timestamp": "05:10:26", "text": "如果你相信存在"}, {"type": "subtitle", "time": 18629.99, "timestamp": "05:10:29", "text": "等等，这酒在哪儿？"}, {"type": "subtitle", "time": 18632.548, "timestamp": "05:10:32", "text": "味道和我记忆中的一样。"}, {"type": "subtitle", "time": 18637.07, "timestamp": "05:10:37", "text": "酒，但那些分享的人在哪里？"}, {"type": "subtitle", "time": 18640.11, "timestamp": "05:10:40", "text": "记忆是什么 V"}, {"type": "subtitle", "time": 18655.03, "timestamp": "05:10:55", "text": "咦？等等，上面说结束了，是结束了吗？"}, {"type": "subtitle", "time": 18658.91, "timestamp": "05:10:58", "text": "上面它向上大约在"}]
[{"type": "subtitle", "time": 8702.79, "timestamp": "02:25:02", "text": "我觉得今年我肯定会……"}, {"type": "subtitle", "time": 8704.389, "timestamp": "02:25:04", "text": "庆祝我的"}, {"type": "subtitle", "time": 8707.51, "timestamp": "02:25:07", "text": "周年纪念日，所以我可以喜欢"}, {"type": "subtitle", "time": 8710.71, "timestamp": "02:25:10", "text": "真心实意地和你们一起庆祝！"}, {"type": "subtitle", "time": 8713.429, "timestamp": "02:25:13", "text": "即使没有什么特别的事情发生，也要知道。"}, {"type": "subtitle", "time": 8716.75, "timestamp": "02:25:16", "text": "我们会像往常一样继续做我们平时做的事情。"}, {"type": "subtitle", "time": 8719.79, "timestamp": "02:25:19", "text": "我们的生日直播，然后我们就回去"}, {"type": "subtitle", "time": 8721.07, "timestamp": "02:25:21", "text": "和喜欢"}, {"type": "subtitle", "time": 8725.269, "timestamp": "02:25:25", "text": "回顾去年的一切，我觉得……"}, {"type": "subtitle", "time": 8728.99, "timestamp": "02:25:28", "text": "应该留着给我过生日用，而不是"}, {"type": "subtitle", "time": 8731.03, "timestamp": "02:25:31", "text": "生日纪念日，而不是"}, {"type": "subtitle", "time": 8735.63, "timestamp": "02:25:35", "text": "所以，生日那天，事情是这样的，我在……"}, {"type": "subtitle", "time": 8738.99, "timestamp": "02:25:38", "text": "那一刻我一直觉得就像一开始，当我"}, {"type": "subtitle", "time": 8740.95, "timestamp": "02:25:40", "text": "我第一次直播了我的生日。"}, {"type": "subtitle", "time": 8745.07, "timestamp": "02:25:45", "text": "作为一名 YouTuber，我刚刚庆祝了这一刻。"}, {"type": "subtitle", "time": 8747.429, "timestamp": "02:25:47", "text": "就好像我在庆祝周年纪念日一样"}, {"type": "subtitle", "time": 8749.95, "timestamp": "02:25:49", "text": "某件事，以及J mix的那一天"}, {"type": "subtitle", "time": 8751.63, "timestamp": "02:25:51", "text": "出生"}, {"type": "subtitle", "time": 8755.11, "timestamp": "02:25:55", "text": "诸如此类的事情"}, {"type": "subtitle", "time": 8757.91, "timestamp": "02:25:57", "text": "但你明白我应该保留它。"}]
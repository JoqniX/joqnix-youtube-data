[{"type": "subtitle", "time": 11941.429, "timestamp": "03:19:01", "text": "我玩游戏的时候就开始用VC了。"}, {"type": "subtitle", "time": 11951.189, "timestamp": "03:19:11", "text": "我有很多东西需要买。"}, {"type": "subtitle", "time": 11954.55, "timestamp": "03:19:14", "text": "因为我需要某种类似的东西加上"}, {"type": "subtitle", "time": 11959.15, "timestamp": "03:19:19", "text": "最重要的是，即使我喜欢把它放"}, {"type": "subtitle", "time": 11961.59, "timestamp": "03:19:21", "text": "你知道，我挣的钱虽然"}, {"type": "subtitle", "time": 11964.55, "timestamp": "03:19:24", "text": "如今我从“喜欢”那里得到的并不多。"}, {"type": "subtitle", "time": 11967.189, "timestamp": "03:19:27", "text": "我一直没法看流媒体。"}, {"type": "subtitle", "time": 11969.51, "timestamp": "03:19:29", "text": "任何事我都不愿意做。"}, {"type": "subtitle", "time": 11971.67, "timestamp": "03:19:31", "text": "这笔钱，但是，即使我得到"}, {"type": "subtitle", "time": 11974.75, "timestamp": "03:19:34", "text": "像你一样做其他事赚来的钱"}, {"type": "subtitle", "time": 11976.389, "timestamp": "03:19:36", "text": "你知道自由职业者该怎么称呼吗？"}, {"type": "subtitle", "time": 11979.79, "timestamp": "03:19:39", "text": "我可以说不，但我受合同约束，所以"}, {"type": "subtitle", "time": 11982.75, "timestamp": "03:19:42", "text": "我签署了CR，所以更像是“是的，你”。"}, {"type": "subtitle", "time": 11994.15, "timestamp": "03:19:54", "text": "所以"}, {"type": "subtitle", "time": 11997.229, "timestamp": "03:19:57", "text": "就像我想说的"}]
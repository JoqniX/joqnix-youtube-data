[{"type": "subtitle", "time": 12303.59, "timestamp": "03:25:03", "text": "但是，嗯，还有你知道的那件事。"}, {"type": "subtitle", "time": 12306.71, "timestamp": "03:25:06", "text": "我的天啊，那是烟花！太可爱了！"}, {"type": "subtitle", "time": 12308.389, "timestamp": "03:25:08", "text": "其中一件发生的事情是"}, {"type": "subtitle", "time": 12310.71, "timestamp": "03:25:10", "text": "我们去了，呃，因为我知道我的"}, {"type": "subtitle", "time": 12313.87, "timestamp": "03:25:13", "text": "父母非常热情，所以我们去了一家音乐商店。"}, {"type": "subtitle", "time": 12318.469, "timestamp": "03:25:18", "text": "W，你猜怎么着，就是那个店主？"}, {"type": "subtitle", "time": 12320.87, "timestamp": "03:25:20", "text": "就像员工或雇员一样"}, {"type": "subtitle", "time": 12323.269, "timestamp": "03:25:23", "text": "他们真的嘲笑我。"}, {"type": "subtitle", "time": 12327.429, "timestamp": "03:25:27", "text": "因为我很好，因为我喜欢其他方面"}, {"type": "subtitle", "time": 12330.189, "timestamp": "03:25:30", "text": "人们的眼神就像个孩子"}, {"type": "subtitle", "time": 12334.189, "timestamp": "03:25:34", "text": "有点像 Rel 小，而且像"}, {"type": "subtitle", "time": 12336.71, "timestamp": "03:25:36", "text": "东西，但他们没放在心上。"}, {"type": "subtitle", "time": 12339.309, "timestamp": "03:25:39", "text": "就像他们说的，是啊，就是这样"}, {"type": "subtitle", "time": 12341.429, "timestamp": "03:25:41", "text": "这些物品是专业工作室使用的。"}, {"type": "subtitle", "time": 12343.75, "timestamp": "03:25:43", "text": "人和一切都不是这样。"}, {"type": "subtitle", "time": 12345.95, "timestamp": "03:25:45", "text": "孩子们应该玩什么游戏，以及他所在的商店"}, {"type": "subtitle", "time": 12349.189, "timestamp": "03:25:49", "text": "就这么指着，然后拿出来了"}, {"type": "subtitle", "time": 12353.429, "timestamp": "03:25:53", "text": "卡西欧玩具，就像玩具钢琴一样。"}, {"type": "subtitle", "time": 12355.51, "timestamp": "03:25:55", "text": "我就像"}, {"type": "subtitle", "time": 12358.75, "timestamp": "03:25:58", "text": "兄弟，你在开玩笑吗？你在逗我吗？"}]
[{"type": "subtitle", "time": 17584.51, "timestamp": "04:53:04", "text": "艺术"}, {"type": "subtitle", "time": 17587.51, "timestamp": "04:53:07", "text": "但我把它们全都收集起来了。"}, {"type": "subtitle", "time": 17601.948, "timestamp": "04:53:21", "text": "[音乐]"}, {"type": "subtitle", "time": 17604.43, "timestamp": "04:53:24", "text": "然后，然后，然后，呃，我们明白了，所以我需要"}, {"type": "subtitle", "time": 17606.27, "timestamp": "04:53:26", "text": "市场"}, {"type": "subtitle", "time": 17609.31, "timestamp": "04:53:29", "text": "呃，我需要一个市场。"}, {"type": "subtitle", "time": 17611.54, "timestamp": "04:53:31", "text": "东西"}, {"type": "subtitle", "time": 17624.99, "timestamp": "04:53:44", "text": "嗨，Mac，欢迎，欢迎，你好吗？"}, {"type": "subtitle", "time": 17629.548, "timestamp": "04:53:49", "text": "你今天过得怎么样？还有，呃，你好吗？"}, {"type": "subtitle", "time": 17633.548, "timestamp": "04:53:53", "text": "儿子节、DJ节，还有……雪的"}, {"type": "subtitle", "time": 17635.99, "timestamp": "04:53:55", "text": "那天我忘了问你"}]
[{"type": "subtitle", "time": 19746.47, "timestamp": "05:29:06", "text": "这事儿不对劲儿"}, {"type": "subtitle", "time": 19749.59, "timestamp": "05:29:09", "text": "对我来说，很可能是的，就在下面。"}, {"type": "subtitle", "time": 19751.19, "timestamp": "05:29:11", "text": "好的，明白了"}, {"type": "subtitle", "time": 19753.67, "timestamp": "05:29:13", "text": "你和你怎么样"}, {"type": "subtitle", "time": 19769.2, "timestamp": "05:29:29", "text": "稳定商品"}, {"type": "subtitle", "time": 19775.59, "timestamp": "05:29:35", "text": "穿什么裤子"}, {"type": "subtitle", "time": 19779.35, "timestamp": "05:29:39", "text": "等等，火！我得治疗了！"}, {"type": "subtitle", "time": 19781.51, "timestamp": "05:29:41", "text": "哦，我怎么会变成这样"}, {"type": "subtitle", "time": 19783.64, "timestamp": "05:29:43", "text": "治愈并不"}, {"type": "subtitle", "time": 19785.868, "timestamp": "05:29:45", "text": "[音乐]"}, {"type": "subtitle", "time": 19788.628, "timestamp": "05:29:48", "text": "愈合"}, {"type": "subtitle", "time": 19796.868, "timestamp": "05:29:56", "text": "再见，等等，他真的……"}]
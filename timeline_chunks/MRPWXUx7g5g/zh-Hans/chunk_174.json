[{"type": "subtitle", "time": 10451.79, "timestamp": "02:54:11", "text": "蜂蜜是……"}, {"type": "subtitle", "time": 10476.55, "timestamp": "02:54:36", "text": "我觉得这件事对大家来说……"}, {"type": "subtitle", "time": 10478.91, "timestamp": "02:54:38", "text": "就像这些人是这件事本身一样。"}, {"type": "subtitle", "time": 10481.55, "timestamp": "02:54:41", "text": "人们就像裂缝一样"}, {"type": "subtitle", "time": 10483.92, "timestamp": "02:54:43", "text": "不和"}, {"type": "subtitle", "time": 10485.269, "timestamp": "02:54:45", "text": "[音乐]"}, {"type": "subtitle", "time": 10487.95, "timestamp": "02:54:47", "text": "我觉得这东西是新事物，我从来没有过"}, {"type": "subtitle", "time": 10492.51, "timestamp": "02:54:52", "text": "以前见过，直到现在我的新新"}]
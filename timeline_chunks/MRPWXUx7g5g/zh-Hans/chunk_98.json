[{"type": "subtitle", "time": 5883.83, "timestamp": "01:38:03", "text": "我们重置了 pach 流上的那个流"}, {"type": "subtitle", "time": 5886.629, "timestamp": "01:38:06", "text": "厚脸皮，是啊，那是很久以前的事了，伙计。"}, {"type": "subtitle", "time": 5889.03, "timestamp": "01:38:09", "text": "是啊是啊，我现在就去做这件事。"}, {"type": "subtitle", "time": 5891.709, "timestamp": "01:38:11", "text": "我还在房间里，我要去，我得去"}, {"type": "subtitle", "time": 5893.709, "timestamp": "01:38:13", "text": "赶紧离开，没错，我们要离开。"}, {"type": "subtitle", "time": 5897.109, "timestamp": "01:38:17", "text": "我听说那里也有类似的步行路线。"}, {"type": "subtitle", "time": 5899.43, "timestamp": "01:38:19", "text": "下了点小雨，所以我打算……"}, {"type": "subtitle", "time": 5906.669, "timestamp": "01:38:26", "text": "让我"}, {"type": "subtitle", "time": 5910.07, "timestamp": "01:38:30", "text": "补水 不想补水"}, {"type": "subtitle", "time": 5914.43, "timestamp": "01:38:34", "text": "昨天我好像没用毛巾。"}, {"type": "subtitle", "time": 5918.47, "timestamp": "01:38:38", "text": "我吹干头发什么的，我冷了"}, {"type": "subtitle", "time": 5921.75, "timestamp": "01:38:41", "text": "今天鼻子有点闷，嗯，鼻塞。"}, {"type": "subtitle", "time": 5925.27, "timestamp": "01:38:45", "text": "今天没有，不过，今天过得怎么样？"}, {"type": "subtitle", "time": 5928.03, "timestamp": "01:38:48", "text": "希望你们一切都好"}, {"type": "subtitle", "time": 5931.189, "timestamp": "01:38:51", "text": "我是圣，我正在直播，所以今天我们"}, {"type": "subtitle", "time": 5933.589, "timestamp": "01:38:53", "text": "正在直播"}, {"type": "subtitle", "time": 5938.39, "timestamp": "01:38:58", "text": "呃，下午 6:40 到 4:80是的，这很……"}]
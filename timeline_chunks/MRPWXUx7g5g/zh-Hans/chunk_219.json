[{"type": "subtitle", "time": 13141.75, "timestamp": "03:39:01", "text": "就像独自一人坐着，就像你永远不会知道"}, {"type": "subtitle", "time": 13144.83, "timestamp": "03:39:04", "text": "现在会发生什么呢？因为我一个人。"}, {"type": "subtitle", "time": 13149.469, "timestamp": "03:39:09", "text": "他们独自一人就能像L一样做任何事"}, {"type": "subtitle", "time": 13153.67, "timestamp": "03:39:13", "text": "我真的付了钱，我走了，哦我的天"}, {"type": "subtitle", "time": 13157.07, "timestamp": "03:39:17", "text": "天哪，他们肯定会想：这人是干嘛的？"}, {"type": "subtitle", "time": 13160.83, "timestamp": "03:39:20", "text": "做很多事情，说很多英语，而且喜欢"}, {"type": "subtitle", "time": 13163.229, "timestamp": "03:39:23", "text": "在他"}, {"type": "subtitle", "time": 13166.229, "timestamp": "03:39:26", "text": "pH值，但他们却很少知道这一点。"}, {"type": "subtitle", "time": 13167.269, "timestamp": "03:39:27", "text": "是"}, {"type": "subtitle", "time": 13170.15, "timestamp": "03:39:30", "text": "直播，我正在直播，如果有的话。"}, {"type": "subtitle", "time": 13172.75, "timestamp": "03:39:32", "text": "我不知道接下来该去哪里。"}, {"type": "subtitle", "time": 13175.229, "timestamp": "03:39:35", "text": "确实如此，但我的大多数业主都不知道。"}, {"type": "subtitle", "time": 13177.55, "timestamp": "03:39:37", "text": "在我老家，所以你不可能……"}, {"type": "subtitle", "time": 13180.79, "timestamp": "03:39:40", "text": "从任何百威啤酒"}, {"type": "subtitle", "time": 13184.229, "timestamp": "03:39:44", "text": "送货上门，我没事吧？想象一下"}, {"type": "subtitle", "time": 13186.83, "timestamp": "03:39:46", "text": "我想大概会发生类似的事情吧。"}, {"type": "subtitle", "time": 13189.189, "timestamp": "03:39:49", "text": "如果你像直播一样在Reddit上，那就太好了"}, {"type": "subtitle", "time": 13193.63, "timestamp": "03:39:53", "text": "电影之类的东西，你可以看到很多，呃……"}, {"type": "subtitle", "time": 13196.15, "timestamp": "03:39:56", "text": "诸如此类的事情，你知道的"}, {"type": "subtitle", "time": 13199.71, "timestamp": "03:39:59", "text": "令人毛骨悚然的人在直播中说话"}]
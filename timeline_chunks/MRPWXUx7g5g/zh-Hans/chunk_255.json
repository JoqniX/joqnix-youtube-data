[{"type": "subtitle", "time": 15313.07, "timestamp": "04:15:13", "text": "我喘不过气来了，再见。"}, {"type": "subtitle", "time": 15314.49, "timestamp": "04:15:14", "text": "好的"}, {"type": "subtitle", "time": 15317.429, "timestamp": "04:15:17", "text": "[音乐]"}, {"type": "subtitle", "time": 15320.229, "timestamp": "04:15:20", "text": "哇哦"}, {"type": "subtitle", "time": 15323.75, "timestamp": "04:15:23", "text": "是啊，今天玩得很开心，希望你们也玩得开心。"}, {"type": "subtitle", "time": 15326.189, "timestamp": "04:15:26", "text": "明天过得很开心，我不知道。"}, {"type": "subtitle", "time": 15330.67, "timestamp": "04:15:30", "text": "如果我像个老手一样做实验，我就会直播。"}, {"type": "subtitle", "time": 15333.59, "timestamp": "04:15:33", "text": "Apex 或者像 Star Royale 之类的游戏，我猜是这样。"}, {"type": "subtitle", "time": 15335.83, "timestamp": "04:15:35", "text": "有些东西我不想直播，但是"}, {"type": "subtitle", "time": 15338.83, "timestamp": "04:15:38", "text": "我会尝试直播，我不知道，我有一个"}, {"type": "subtitle", "time": 15339.79, "timestamp": "04:15:39", "text": "稳定的"}, {"type": "subtitle", "time": 15342.389, "timestamp": "04:15:42", "text": "我也一样，我真的搞不清楚自己到底在干什么"}, {"type": "subtitle", "time": 15344.67, "timestamp": "04:15:44", "text": "应该这样做"}, {"type": "subtitle", "time": 15346.55, "timestamp": "04:15:46", "text": "但我会步行完成这些活动。"}, {"type": "subtitle", "time": 15351.269, "timestamp": "04:15:51", "text": "顺便说一下，每天都有直播，是的，我们会的"}, {"type": "subtitle", "time": 15353.67, "timestamp": "04:15:53", "text": "做点什么，这是我唯一的办法"}, {"type": "subtitle", "time": 15357.309, "timestamp": "04:15:57", "text": "走出去，真正地触摸。"}]
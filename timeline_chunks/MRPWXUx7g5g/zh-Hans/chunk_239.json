[{"type": "subtitle", "time": 14341.269, "timestamp": "03:59:01", "text": "不，我们不做这种事，是的。"}, {"type": "subtitle", "time": 14344.309, "timestamp": "03:59:04", "text": "那太糟糕了，因为"}, {"type": "subtitle", "time": 14354.63, "timestamp": "03:59:14", "text": "抱怨"}, {"type": "subtitle", "time": 14360.11, "timestamp": "03:59:20", "text": "请给我你的护城河和我喜欢的东西"}, {"type": "subtitle", "time": 14363.229, "timestamp": "03:59:23", "text": "去吧，我会想办法的，然后我问了"}, {"type": "subtitle", "time": 14365.11, "timestamp": "03:59:25", "text": "他们没有友好地对待他们。"}, {"type": "subtitle", "time": 14368.51, "timestamp": "03:59:28", "text": "听着，问问他们，他们没听。"}, {"type": "subtitle", "time": 14373.51, "timestamp": "03:59:33", "text": "听着，我喜欢我我我倾诉出来"}, {"type": "subtitle", "time": 14375.91, "timestamp": "03:59:35", "text": "不少人，但并非寥寥几人"}, {"type": "subtitle", "time": 14378.75, "timestamp": "03:59:38", "text": "有些人喜欢两个人​​，但你却不喜欢。"}, {"type": "subtitle", "time": 14380.36, "timestamp": "03:59:40", "text": "我不会说"}, {"type": "subtitle", "time": 14381.91, "timestamp": "03:59:41", "text": "[音乐]"}, {"type": "subtitle", "time": 14385.63, "timestamp": "03:59:45", "text": "名字，但等等，不要告诉两个人"}, {"type": "subtitle", "time": 14388.11, "timestamp": "03:59:48", "text": "你看到的每个人，都是其他人。"}, {"type": "subtitle", "time": 14391.99, "timestamp": "03:59:51", "text": "侧面，而且其中一个也是这样"}, {"type": "subtitle", "time": 14395.309, "timestamp": "03:59:55", "text": "当然告诉他们了，他们也知道我们正在做什么。"}, {"type": "subtitle", "time": 14397.83, "timestamp": "03:59:57", "text": "就像一起上课一样，我们丹坐下来"}]
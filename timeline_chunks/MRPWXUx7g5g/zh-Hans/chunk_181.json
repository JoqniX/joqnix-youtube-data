[{"type": "subtitle", "time": 10860.229, "timestamp": "03:01:00", "text": "我们行走的地方或事物，我们边走边谈"}, {"type": "subtitle", "time": 10861.95, "timestamp": "03:01:01", "text": "随机的"}, {"type": "subtitle", "time": 10864.229, "timestamp": "03:01:04", "text": "东西，我们走，就这么说了，就像"}, {"type": "subtitle", "time": 10867.15, "timestamp": "03:01:07", "text": "你真的能听到很多人的声音"}, {"type": "subtitle", "time": 10872.389, "timestamp": "03:01:12", "text": "差不多就是这样，我希望我能点个赞"}, {"type": "subtitle", "time": 10876.309, "timestamp": "03:01:16", "text": "目标或类似散步之类的事情"}, {"type": "subtitle", "time": 10879.03, "timestamp": "03:01:19", "text": "把某些地方和东西放在那里我可以"}, {"type": "subtitle", "time": 10883.51, "timestamp": "03:01:23", "text": "如果我像那样做，我就做不到，如果我喜欢，我就做不到。"}, {"type": "subtitle", "time": 10885.389, "timestamp": "03:01:25", "text": "告诉我我来自哪个州，对吧？"}, {"type": "subtitle", "time": 10886.83, "timestamp": "03:01:26", "text": "那个"}, {"type": "subtitle", "time": 10890.71, "timestamp": "03:01:30", "text": "比如，如果你是日本人，你可以说"}, {"type": "subtitle", "time": 10894.11, "timestamp": "03:01:34", "text": "你来自东京或大阪吗？"}, {"type": "subtitle", "time": 10896.71, "timestamp": "03:01:36", "text": "因为这些东西很受欢迎，而且"}, {"type": "subtitle", "time": 10899.229, "timestamp": "03:01:39", "text": "好吧，可以说有很多"}, {"type": "subtitle", "time": 10902.309, "timestamp": "03:01:42", "text": "那些人会指着你，"}, {"type": "subtitle", "time": 10906.429, "timestamp": "03:01:46", "text": "东西是对的，但我没有"}, {"type": "subtitle", "time": 10910.63, "timestamp": "03:01:50", "text": "我知道这是个好办法，但它就像……"}, {"type": "subtitle", "time": 10913.75, "timestamp": "03:01:53", "text": "听到各种随机噪音等等"}, {"type": "subtitle", "time": 10916.229, "timestamp": "03:01:56", "text": "东西，你做什么"}]
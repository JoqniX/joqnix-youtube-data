[{"type": "subtitle", "time": 9303.59, "timestamp": "02:35:03", "text": "直播，但更像是……呃，就像……你们"}, {"type": "subtitle", "time": 9307.469, "timestamp": "02:35:07", "text": "看到我这么痛苦，泡菜"}, {"type": "subtitle", "time": 9309.349, "timestamp": "02:35:09", "text": "泡菜和所有"}, {"type": "subtitle", "time": 9312.91, "timestamp": "02:35:12", "text": "真是太……"}, {"type": "subtitle", "time": 9315.79, "timestamp": "02:35:15", "text": "疼痛让我无法专注于我的节目。"}, {"type": "subtitle", "time": 9325.349, "timestamp": "02:35:25", "text": "哦，是的，我知道很多人都这样。"}, {"type": "subtitle", "time": 9328.349, "timestamp": "02:35:28", "text": "在标签上"}, {"type": "subtitle", "time": 9331.71, "timestamp": "02:35:31", "text": "标题我想起来了，我从来没有这样做过"}, {"type": "subtitle", "time": 9334.309, "timestamp": "02:35:34", "text": "我需要做什么？我应该开始做吗？"}, {"type": "subtitle", "time": 9335.91, "timestamp": "02:35:35", "text": "我应该不吗？我不想"}, {"type": "subtitle", "time": 9339.87, "timestamp": "02:35:39", "text": "我知道我以前经常这样做。"}, {"type": "subtitle", "time": 9341.91, "timestamp": "02:35:41", "text": "这"}, {"type": "subtitle", "time": 9346.349, "timestamp": "02:35:46", "text": "以前每天都这样，但现在我不这么做了。"}, {"type": "subtitle", "time": 9358.469, "timestamp": "02:35:58", "text": "酷，她看起来像个弹出式广告里的我，但现在"}]
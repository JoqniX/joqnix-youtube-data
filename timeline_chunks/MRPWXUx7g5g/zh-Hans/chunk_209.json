[{"type": "subtitle", "time": 12540.189, "timestamp": "03:29:00", "text": "实际上给你"}, {"type": "subtitle", "time": 12543.59, "timestamp": "03:29:03", "text": "到本周末为止的资金和"}, {"type": "subtitle", "time": 12546.83, "timestamp": "03:29:06", "text": "一切都，他就像，不，他是"}, {"type": "subtitle", "time": 12550.189, "timestamp": "03:29:10", "text": "更像是他不再拥有它，而是变成了"}, {"type": "subtitle", "time": 12552.71, "timestamp": "03:29:12", "text": "生气，生我爸的气，还有我的"}, {"type": "subtitle", "time": 12555.309, "timestamp": "03:29:15", "text": "爸爸肯定像我一样生他的气了。"}, {"type": "subtitle", "time": 12557.91, "timestamp": "03:29:17", "text": "别再打电话了，他就像……"}, {"type": "subtitle", "time": 12560.51, "timestamp": "03:29:20", "text": "痛苦，他告诉我，我爸爸也告诉我"}, {"type": "subtitle", "time": 12563.309, "timestamp": "03:29:23", "text": "他们喜欢不要去不要去"}, {"type": "subtitle", "time": 12566.189, "timestamp": "03:29:26", "text": "它就像超级棒的东西，而且就像"}, {"type": "subtitle", "time": 12568.15, "timestamp": "03:29:28", "text": "第二天我去了那里，他也去了。"}, {"type": "subtitle", "time": 12570.87, "timestamp": "03:29:30", "text": "他简直就像在对我大喊大叫一样。"}, {"type": "subtitle", "time": 12574.95, "timestamp": "03:29:34", "text": "诸如此类的事情，我就说，是啊，你不是。"}, {"type": "subtitle", "time": 12578.99, "timestamp": "03:29:38", "text": "教我东西，然后你想要钱"}, {"type": "subtitle", "time": 12581.87, "timestamp": "03:29:41", "text": "你的一切，真的就像你本人一样。"}, {"type": "subtitle", "time": 12584.03, "timestamp": "03:29:44", "text": "告诉我练习，然后你就下去"}, {"type": "subtitle", "time": 12587.03, "timestamp": "03:29:47", "text": "你的地方就像是去做别的事情一样，"}, {"type": "subtitle", "time": 12589.389, "timestamp": "03:29:49", "text": "你现在更能看清我在做什么了。"}, {"type": "subtitle", "time": 12590.15, "timestamp": "03:29:50", "text": "和"}, {"type": "subtitle", "time": 12592.269, "timestamp": "03:29:52", "text": "一切究竟是什么，而你却不是。"}, {"type": "subtitle", "time": 12594.87, "timestamp": "03:29:54", "text": "甚至教一些我想学的东西"}, {"type": "subtitle", "time": 12597.91, "timestamp": "03:29:57", "text": "我正在实践我从……中学到的东西。"}]
[{"type": "subtitle", "time": 18006.67, "timestamp": "05:00:06", "text": "我们来这里是为了抓坏人，这就是我们的目的。"}, {"type": "subtitle", "time": 18009.47, "timestamp": "05:00:09", "text": "留出时间进行问答环节"}, {"type": "subtitle", "time": 18020.948, "timestamp": "05:00:20", "text": "[音乐]"}, {"type": "subtitle", "time": 18022.31, "timestamp": "05:00:22", "text": "为什么会这样"}, {"type": "subtitle", "time": 18026.39, "timestamp": "05:00:26", "text": "我以前也像那样弹琴。"}, {"type": "subtitle", "time": 18030.59, "timestamp": "05:00:30", "text": "引擎像以前一样24小时运转"}, {"type": "subtitle", "time": 18033.51, "timestamp": "05:00:33", "text": "那是我……之前的日子"}, {"type": "subtitle", "time": 18036.51, "timestamp": "05:00:36", "text": "停止了磨砺，呃，就像"}, {"type": "subtitle", "time": 18039.788, "timestamp": "05:00:39", "text": "我得了……呃，该怎么形容呢，就是精疲力竭。"}, {"type": "subtitle", "time": 18040.43, "timestamp": "05:00:40", "text": "这"}, {"type": "subtitle", "time": 18043.51, "timestamp": "05:00:43", "text": "玩游戏是因为我当时就像在做那个呃……"}, {"type": "subtitle", "time": 18045.948, "timestamp": "05:00:45", "text": "根真主播活动，而我当时"}, {"type": "subtitle", "time": 18048.708, "timestamp": "05:00:48", "text": "连续播放了大约15个小时"}, {"type": "subtitle", "time": 18052.35, "timestamp": "05:00:52", "text": "这次活动我直播了36个小时。"}, {"type": "subtitle", "time": 18057.51, "timestamp": "05:00:57", "text": "那周的某个时候，那个人让我很受伤。"}]
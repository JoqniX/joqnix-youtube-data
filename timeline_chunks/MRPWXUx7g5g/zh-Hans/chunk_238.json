[{"type": "subtitle", "time": 14282.429, "timestamp": "03:58:02", "text": "能够自在地与 GES 一起演出"}, {"type": "subtitle", "time": 14285.309, "timestamp": "03:58:05", "text": "就像D类的东西，或者至少像……"}, {"type": "subtitle", "time": 14288.269, "timestamp": "03:58:08", "text": "握着那东西，就像在做"}, {"type": "subtitle", "time": 14289.95, "timestamp": "03:58:09", "text": "那些运动和事情，就像"}, {"type": "subtitle", "time": 14291.83, "timestamp": "03:58:11", "text": "那种类型的"}, {"type": "subtitle", "time": 14295.75, "timestamp": "03:58:15", "text": "这事儿要具体一点，比如医生会说的那种。"}, {"type": "subtitle", "time": 14300.07, "timestamp": "03:58:20", "text": "不尊重 不尊重的东西 G 鱼 他"}, {"type": "subtitle", "time": 14303.99, "timestamp": "03:58:23", "text": "那个东西会发出一些类似“呃”的声音"}, {"type": "subtitle", "time": 14306.99, "timestamp": "03:58:26", "text": "真够无聊的"}, {"type": "subtitle", "time": 14324.07, "timestamp": "03:58:44", "text": "可能会看到你认识的某个人离开"}, {"type": "subtitle", "time": 14328.03, "timestamp": "03:58:48", "text": "经历艰难的失败，等待一个讨厌的人"}, {"type": "subtitle", "time": 14331.189, "timestamp": "03:58:51", "text": "跌倒在那个等待的人身上"}, {"type": "subtitle", "time": 14334.59, "timestamp": "03:58:54", "text": "你在说什么？是啊，阿兹"}, {"type": "subtitle", "time": 14337.309, "timestamp": "03:58:57", "text": "我当时说的就像他们那样，我是"}]
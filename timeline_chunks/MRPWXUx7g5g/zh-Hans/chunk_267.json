[{"type": "subtitle", "time": 16020.95, "timestamp": "04:27:00", "text": "巴卡，我觉得我需要休假，但是"}, {"type": "subtitle", "time": 16023.67, "timestamp": "04:27:03", "text": "也是我的一部分"}, {"type": "subtitle", "time": 16027.95, "timestamp": "04:27:07", "text": "说“不，骑师，你有很多东西啊……”"}, {"type": "subtitle", "time": 16030.91, "timestamp": "04:27:10", "text": "如果你去度假的话，可以这样做，就像……"}, {"type": "subtitle", "time": 16033.59, "timestamp": "04:27:13", "text": "偷懒哦，我"}, {"type": "subtitle", "time": 16036.91, "timestamp": "04:27:16", "text": "好吧，行，我替你休假。"}, {"type": "subtitle", "time": 16043.229, "timestamp": "04:27:23", "text": "结束了，不过我们都需要假期。"}, {"type": "subtitle", "time": 16045.189, "timestamp": "04:27:25", "text": "不，我不会去"}, {"type": "subtitle", "time": 16058.67, "timestamp": "04:27:38", "text": "累得我都不想再回复了"}, {"type": "subtitle", "time": 16062.91, "timestamp": "04:27:42", "text": "太多了，我现在就醒了。"}, {"type": "subtitle", "time": 16068.75, "timestamp": "04:27:48", "text": "我大概中午12点睡的。醒了"}]
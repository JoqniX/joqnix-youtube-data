[{"type": "subtitle", "time": 14701.229, "timestamp": "04:05:01", "text": "我应该和我交换吗？"}, {"type": "subtitle", "time": 14704.83, "timestamp": "04:05:04", "text": "我不太在意是不是这样。"}, {"type": "subtitle", "time": 14708.11, "timestamp": "04:05:08", "text": "跑吧，我不在乎它好不好。"}, {"type": "subtitle", "time": 14712.309, "timestamp": "04:05:12", "text": "我不知道哪天会怎样，但我会告诉它"}, {"type": "subtitle", "time": 14719.229, "timestamp": "04:05:19", "text": "我想，如果有一个……"}, {"type": "subtitle", "time": 14720.469, "timestamp": "04:05:20", "text": "巨魔"}, {"type": "subtitle", "time": 14722.99, "timestamp": "04:05:22", "text": "乔·戈·澳大利亚去淋浴"}, {"type": "subtitle", "time": 14725.91, "timestamp": "04:05:25", "text": "然后就开始用英语说话了，就是这样。"}, {"type": "subtitle", "time": 14729.79, "timestamp": "04:05:29", "text": "比如，不，我不做"}, {"type": "subtitle", "time": 14733.67, "timestamp": "04:05:33", "text": "不，我通常的做法是……"}, {"type": "subtitle", "time": 14736.99, "timestamp": "04:05:36", "text": "我知道我不能接受以下情况"}, {"type": "subtitle", "time": 14739.91, "timestamp": "04:05:39", "text": "听起来像个弱者，或者像"}, {"type": "subtitle", "time": 14742.389, "timestamp": "04:05:42", "text": "不是那种……呃，太敏感的那种"}, {"type": "subtitle", "time": 14744.55, "timestamp": "04:05:44", "text": "东西，但是"}, {"type": "subtitle", "time": 14747.67, "timestamp": "04:05:47", "text": "我有点为自己做的事感到难过。"}, {"type": "subtitle", "time": 14748.95, "timestamp": "04:05:48", "text": "通常是"}, {"type": "subtitle", "time": 14754.07, "timestamp": "04:05:54", "text": "比如，我会很难过，因为我超级"}, {"type": "subtitle", "time": 14754.95, "timestamp": "04:05:54", "text": "极好的"}, {"type": "subtitle", "time": 14758.63, "timestamp": "04:05:58", "text": "敏感的我会难过，我会尝试"}]
[{"type": "subtitle", "time": 12006.67, "timestamp": "03:20:06", "text": "BB，所以我接下来要说的是……"}, {"type": "subtitle", "time": 12009.87, "timestamp": "03:20:09", "text": "比如，当我得到"}, {"type": "subtitle", "time": 12014.83, "timestamp": "03:20:14", "text": "我需要摆脱的钱，优先考虑是的"}, {"type": "subtitle", "time": 12017.67, "timestamp": "03:20:17", "text": "优先考虑我需要的设备，非常整洁"}, {"type": "subtitle", "time": 12021.349, "timestamp": "03:20:21", "text": "不像我，我不喜欢在游戏上花钱。"}, {"type": "subtitle", "time": 12023.269, "timestamp": "03:20:23", "text": "真希望我没做过那件事，那真是一次难忘的经历。"}, {"type": "subtitle", "time": 12033.229, "timestamp": "03:20:33", "text": "所以我不知道这是什么"}, {"type": "subtitle", "time": 12035.189, "timestamp": "03:20:35", "text": "我以后会更多地使用V。"}, {"type": "subtitle", "time": 12037.389, "timestamp": "03:20:37", "text": "人们要学会和别人说话，是的。"}, {"type": "subtitle", "time": 12039.51, "timestamp": "03:20:39", "text": "那是一个很好的训练"}, {"type": "subtitle", "time": 12042.55, "timestamp": "03:20:42", "text": "那是一种很好的沟通方式，"}, {"type": "subtitle", "time": 12044.59, "timestamp": "03:20:44", "text": "一切有助于"}, {"type": "subtitle", "time": 12047.07, "timestamp": "03:20:47", "text": "沟通以及你将要做的一切"}, {"type": "subtitle", "time": 12050.59, "timestamp": "03:20:50", "text": "我的意思是，ADI更经常这样做。"}, {"type": "subtitle", "time": 12053.07, "timestamp": "03:20:53", "text": "但大多数时候她都很安静，就像……"}, {"type": "subtitle", "time": 12056.229, "timestamp": "03:20:56", "text": "她很安静，像没说话一样，或者有时她会开口说话。"}, {"type": "subtitle", "time": 12057.99, "timestamp": "03:20:57", "text": "或者类似的东西，但也有点……"}, {"type": "subtitle", "time": 12059.75, "timestamp": "03:20:59", "text": "如果你没有东西，那就很尴尬了。"}]
[{"type": "subtitle", "time": 13261.75, "timestamp": "03:41:01", "text": "我觉得这瓶是30卢比。"}, {"type": "subtitle", "time": 13264.63, "timestamp": "03:41:04", "text": "我给了它200，他们却只给了我100。"}, {"type": "subtitle", "time": 13266.349, "timestamp": "03:41:06", "text": "还有一些事，我没有，我没有"}, {"type": "subtitle", "time": 13269.469, "timestamp": "03:41:09", "text": "我只能看到那东西一点点。"}, {"type": "subtitle", "time": 13292.429, "timestamp": "03:41:32", "text": "GU也对那东西感到高兴"}, {"type": "subtitle", "time": 13295.429, "timestamp": "03:41:35", "text": "为什么几乎每个人都在这样做"}, {"type": "subtitle", "time": 13299.75, "timestamp": "03:41:39", "text": "你看，每次都有人"}, {"type": "subtitle", "time": 13306.469, "timestamp": "03:41:46", "text": "就像做破解的事情一样"}, {"type": "subtitle", "time": 13310.469, "timestamp": "03:41:50", "text": "他看起来很大，坐着做着什么，但我"}]
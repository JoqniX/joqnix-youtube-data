[{"type": "subtitle", "time": 8221.309, "timestamp": "02:17:01", "text": "他们朝我喊了一声，然后他们……"}, {"type": "subtitle", "time": 8227.629, "timestamp": "02:17:07", "text": "就像我一直都喜欢呃，他们问"}, {"type": "subtitle", "time": 8230.11, "timestamp": "02:17:10", "text": "我当时在做什么？"}, {"type": "subtitle", "time": 8233.429, "timestamp": "02:17:13", "text": "一切都好，所以我们刚才在聊这个。"}, {"type": "subtitle", "time": 8236.629, "timestamp": "02:17:16", "text": "我为何短暂地失去了希望"}, {"type": "subtitle", "time": 8246.15, "timestamp": "02:17:26", "text": "嗯，我们聊了聊我的情况……"}, {"type": "subtitle", "time": 8248.15, "timestamp": "02:17:28", "text": "是的，就像我正在学习的那样。"}, {"type": "subtitle", "time": 8250.27, "timestamp": "02:17:30", "text": "每当你与你的合作伙伴见面时"}, {"type": "subtitle", "time": 8252.95, "timestamp": "02:17:32", "text": "更像是在问什么"}, {"type": "subtitle", "time": 8254.83, "timestamp": "02:17:34", "text": "你现在在哪里学习？你在哪里？"}, {"type": "subtitle", "time": 8256.83, "timestamp": "02:17:36", "text": "现在全部"}, {"type": "subtitle", "time": 8261.23, "timestamp": "02:17:41", "text": "但从某种意义上说，他的说法也没错。"}, {"type": "subtitle", "time": 8263.07, "timestamp": "02:17:43", "text": "我就像"}, {"type": "subtitle", "time": 8266.549, "timestamp": "02:17:46", "text": "嗯……呃……它叫什么来着？我知道那个……呃……"}, {"type": "subtitle", "time": 8270.389, "timestamp": "02:17:50", "text": "我的母语是东欧语系的母语。"}, {"type": "subtitle", "time": 8272.23, "timestamp": "02:17:52", "text": "我不知道该怎么用这个词来表达"}, {"type": "subtitle", "time": 8274.23, "timestamp": "02:17:54", "text": "英语更……"}, {"type": "subtitle", "time": 8278.23, "timestamp": "02:17:58", "text": "比如，呃，如果我说，如果我要说的话"}]
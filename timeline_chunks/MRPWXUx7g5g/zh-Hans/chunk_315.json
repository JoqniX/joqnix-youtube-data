[{"type": "subtitle", "time": 18901.47, "timestamp": "05:15:01", "text": "我知道我没钱，为什么我需要"}, {"type": "subtitle", "time": 18905.59, "timestamp": "05:15:05", "text": "当我在游戏中扮演这个角色时，我的得分是66。"}, {"type": "subtitle", "time": 18909.31, "timestamp": "05:15:09", "text": "嗯嗯，当我能像SP那样的时候"}, {"type": "subtitle", "time": 18913.83, "timestamp": "05:15:13", "text": "我的服务器托管或其他方面的资金"}, {"type": "subtitle", "time": 18917.51, "timestamp": "05:15:17", "text": "诸如“是啊，我希望如果我真的……”之类的话"}, {"type": "subtitle", "time": 18921.39, "timestamp": "05:15:21", "text": "我不想把钱花在那些我本来可以拥有的游戏上。"}, {"type": "subtitle", "time": 18923.548, "timestamp": "05:15:23", "text": "我好像需要服务器托管服务。"}, {"type": "subtitle", "time": 18925.43, "timestamp": "05:15:25", "text": "现在先别急着主持节目。"}, {"type": "subtitle", "time": 18928.27, "timestamp": "05:15:28", "text": "网站和 Discord 论坛"}, {"type": "subtitle", "time": 18932.23, "timestamp": "05:15:32", "text": "每当我想到这件事的时候，我"}, {"type": "subtitle", "time": 18933.03, "timestamp": "05:15:33", "text": "可以"}, {"type": "subtitle", "time": 18937.43, "timestamp": "05:15:37", "text": "如果我没花钱，我就能省下这笔钱了。"}, {"type": "subtitle", "time": 18941.868, "timestamp": "05:15:41", "text": "在 Fortnite 中，我小时候就玩得很开心。"}, {"type": "subtitle", "time": 18946.628, "timestamp": "05:15:46", "text": "嗯嗯，还有像堡垒之夜和命运的DLC之类的东西。"}, {"type": "subtitle", "time": 18948.708, "timestamp": "05:15:48", "text": "甚至可能还会玩《命运》"}, {"type": "subtitle", "time": 18951.628, "timestamp": "05:15:51", "text": "现在所有这些钱"}]
[{"type": "subtitle", "time": 19985.15, "timestamp": "05:33:05", "text": "嗯，我们已经到这个地方的尽头了，对吧？"}, {"type": "subtitle", "time": 19990.628, "timestamp": "05:33:10", "text": "马克，还有这个马库斯"}, {"type": "subtitle", "time": 19994.27, "timestamp": "05:33:14", "text": "我们已经完成了，并且收到了那两个。"}, {"type": "subtitle", "time": 19998.59, "timestamp": "05:33:18", "text": "我相信，从这里往右数，我们有两个"}, {"type": "subtitle", "time": 20002.03, "timestamp": "05:33:22", "text": "我当时觉得我们"}, {"type": "subtitle", "time": 20005.35, "timestamp": "05:33:25", "text": "我检查过了，我会再三确认是否完成。"}, {"type": "subtitle", "time": 20010.19, "timestamp": "05:33:30", "text": "后来他觉得这是最后一个地方了。"}, {"type": "subtitle", "time": 20013.59, "timestamp": "05:33:33", "text": "对，没错，不是他，但型号一样哦"}, {"type": "subtitle", "time": 20020.67, "timestamp": "05:33:40", "text": "传送"}, {"type": "subtitle", "time": 20023.03, "timestamp": "05:33:43", "text": "这一点看起来并不自然"}, {"type": "subtitle", "time": 20025.15, "timestamp": "05:33:45", "text": "关键是它看起来像一个巨大的切口，对吧？"}, {"type": "subtitle", "time": 20026.708, "timestamp": "05:33:46", "text": "穿过这个地方"}, {"type": "subtitle", "time": 20029.47, "timestamp": "05:33:49", "text": "相反，实际上却直接冲了过去"}, {"type": "subtitle", "time": 20031.14, "timestamp": "05:33:51", "text": "成为更"}, {"type": "subtitle", "time": 20032.91, "timestamp": "05:33:52", "text": "[音乐]"}, {"type": "subtitle", "time": 20036.99, "timestamp": "05:33:56", "text": "积累起来，哦，这是龙脊椎骨之类的东西，或者"}, {"type": "subtitle", "time": 20038.43, "timestamp": "05:33:58", "text": "[音乐]"}]
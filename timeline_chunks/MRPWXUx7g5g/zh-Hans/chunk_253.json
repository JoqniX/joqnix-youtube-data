[{"type": "subtitle", "time": 15180.07, "timestamp": "04:13:00", "text": "好的，我正在回家的路上，好的"}, {"type": "subtitle", "time": 15182.03, "timestamp": "04:13:02", "text": "这就是我应该结束的路了，所以……"}, {"type": "subtitle", "time": 15184.51, "timestamp": "04:13:04", "text": "今天回来的人们得到了"}, {"type": "subtitle", "time": 15187.91, "timestamp": "04:13:07", "text": "即将到来的基督徒得到了即将到来的三月"}, {"type": "subtitle", "time": 15189.429, "timestamp": "04:13:09", "text": "搞砸了"}, {"type": "subtitle", "time": 15197.91, "timestamp": "04:13:17", "text": "那么，我错过了谁呢？只有一个人。"}, {"type": "subtitle", "time": 15201.429, "timestamp": "04:13:21", "text": "呃，让我看看能不能滚动。"}, {"type": "subtitle", "time": 15205.389, "timestamp": "04:13:25", "text": "我希望我能滚动返回"}, {"type": "subtitle", "time": 15209.63, "timestamp": "04:13:29", "text": "我回去的时候忘了它的名字"}, {"type": "subtitle", "time": 15214.469, "timestamp": "04:13:34", "text": "我不能去卢，等等，现在是时候了"}, {"type": "subtitle", "time": 15216.349, "timestamp": "04:13:36", "text": "我希望是"}, {"type": "subtitle", "time": 15218.55, "timestamp": "04:13:38", "text": "走路"}, {"type": "subtitle", "time": 15220.429, "timestamp": "04:13:40", "text": "如此痛苦"}, {"type": "subtitle", "time": 15223.79, "timestamp": "04:13:43", "text": "是的，iide h"}, {"type": "subtitle", "time": 15227.99, "timestamp": "04:13:47", "text": "呃，谢谢你们的到来"}, {"type": "subtitle", "time": 15237.51, "timestamp": "04:13:57", "text": "嗯，我是拉莉，在家，好的，海军陆战队员"}]
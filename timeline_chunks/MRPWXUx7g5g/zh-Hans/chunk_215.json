[{"type": "subtitle", "time": 12927.83, "timestamp": "03:35:27", "text": "只是拥抱你，只是拥抱"}, {"type": "subtitle", "time": 12931.95, "timestamp": "03:35:31", "text": "你自己拥抱或让自己感到尴尬"}, {"type": "subtitle", "time": 12934.189, "timestamp": "03:35:34", "text": "真尴尬"}, {"type": "subtitle", "time": 12936.99, "timestamp": "03:35:36", "text": "从长远来看，一切都没问题。"}, {"type": "subtitle", "time": 12938.71, "timestamp": "03:35:38", "text": "为了"}, {"type": "subtitle", "time": 12941.15, "timestamp": "03:35:41", "text": "即使我让自己难堪，你也会这么想。"}, {"type": "subtitle", "time": 12943.87, "timestamp": "03:35:43", "text": "P是"}, {"type": "subtitle", "time": 12946.83, "timestamp": "03:35:46", "text": "我的天啊，这也太多蚊子了吧！"}, {"type": "subtitle", "time": 12958.79, "timestamp": "03:35:58", "text": "嗯，对，我们刚才在聊什么来着？"}]
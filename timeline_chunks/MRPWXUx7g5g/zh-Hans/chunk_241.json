[{"type": "subtitle", "time": 14463.189, "timestamp": "04:01:03", "text": "帮助那些反对它的人，"}, {"type": "subtitle", "time": 14464.63, "timestamp": "04:01:04", "text": "所有这些"}, {"type": "subtitle", "time": 14474.269, "timestamp": "04:01:14", "text": "人和喜欢"}, {"type": "subtitle", "time": 14476.269, "timestamp": "04:01:16", "text": "有毒的友谊"}, {"type": "subtitle", "time": 14479.429, "timestamp": "04:01:19", "text": "过剩，这是个问题，而且总是如此。"}, {"type": "subtitle", "time": 14480.67, "timestamp": "04:01:20", "text": "好的"}, {"type": "subtitle", "time": 14483.11, "timestamp": "04:01:23", "text": "朋友，而不是坏人"}, {"type": "subtitle", "time": 14487.59, "timestamp": "04:01:27", "text": "像这样的事，我学起来真的太难了。"}, {"type": "subtitle", "time": 14488.91, "timestamp": "04:01:28", "text": "我的方式"}, {"type": "subtitle", "time": 14493.189, "timestamp": "04:01:33", "text": "是的，我把它们剪掉了，就像……"}, {"type": "subtitle", "time": 14496.149, "timestamp": "04:01:36", "text": "生气"}, {"type": "subtitle", "time": 14499.55, "timestamp": "04:01:39", "text": "呃，打电话什么的，因为我有一个"}, {"type": "subtitle", "time": 14501.87, "timestamp": "04:01:41", "text": "一个人，而且有两个"}, {"type": "subtitle", "time": 14504.83, "timestamp": "04:01:44", "text": "就像那样，他们就像被两堵墙包围着一样。"}, {"type": "subtitle", "time": 14507.87, "timestamp": "04:01:47", "text": "在我面前，我可以更靠近，或者像"}, {"type": "subtitle", "time": 14510.83, "timestamp": "04:01:50", "text": "离开，嗯，就像这样的东西"}, {"type": "subtitle", "time": 14515.07, "timestamp": "04:01:55", "text": "是啊，但我没哭"}, {"type": "subtitle", "time": 14518.79, "timestamp": "04:01:58", "text": "那天我根本没哭。"}]
[{"type": "subtitle", "time": 19081.43, "timestamp": "05:18:01", "text": "我宁愿冒着生命危险，也不愿牺牲自己。"}, {"type": "subtitle", "time": 19084.31, "timestamp": "05:18:04", "text": "这里，然后躺在某个地方"}, {"type": "subtitle", "time": 19094.19, "timestamp": "05:18:14", "text": "与那极少数幸运儿截然不同"}, {"type": "subtitle", "time": 19100.948, "timestamp": "05:18:20", "text": "愿景冒险探索挑战"}, {"type": "subtitle", "time": 19102.99, "timestamp": "05:18:22", "text": "这些事情只能是"}, {"type": "subtitle", "time": 19105.51, "timestamp": "05:18:25", "text": "普通人真正体验过"}, {"type": "subtitle", "time": 19108.03, "timestamp": "05:18:28", "text": "所以归根结底，这就是……"}, {"type": "subtitle", "time": 19109.35, "timestamp": "05:18:29", "text": "关于你的一切"}, {"type": "subtitle", "time": 19112.91, "timestamp": "05:18:32", "text": "哼，你难道一点都没想过吗？"}, {"type": "subtitle", "time": 19115.51, "timestamp": "05:18:35", "text": "我之前说过，这是我自己的事。"}, {"type": "subtitle", "time": 19117.27, "timestamp": "05:18:37", "text": "私事我明白了，什么也没得到。"}, {"type": "subtitle", "time": 19119.548, "timestamp": "05:18:39", "text": "对其他人来说，我很抱歉，我感觉"}, {"type": "subtitle", "time": 19122.39, "timestamp": "05:18:42", "text": "虽然对此感到遗憾，但你还是想……"}, {"type": "subtitle", "time": 19125.11, "timestamp": "05:18:45", "text": "留下你的记忆吧，巴加"}, {"type": "subtitle", "time": 19133.59, "timestamp": "05:18:53", "text": "哦，你怎敢等待"}, {"type": "subtitle", "time": 19137.47, "timestamp": "05:18:57", "text": "我本来想问你件事，"}]
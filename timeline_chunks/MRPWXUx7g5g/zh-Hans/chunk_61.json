[{"type": "subtitle", "time": 3660.47, "timestamp": "01:01:00", "text": "我不会做咖喱鸡"}, {"type": "subtitle", "time": 3662.39, "timestamp": "01:01:02", "text": "然而是"}, {"type": "subtitle", "time": 3664.99, "timestamp": "01:01:04", "text": "啊"}, {"type": "chat", "time": 3666.076, "timestamp": "01:01:06", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "same here I can also cook"}, {"type": "subtitle", "time": 3668.19, "timestamp": "01:01:08", "text": "是的，我当时在谷歌上找到了你。"}, {"type": "subtitle", "time": 3670.63, "timestamp": "01:01:10", "text": "我正在查资料，嘿，我在谷歌上，我的意思是，我"}, {"type": "subtitle", "time": 3673.51, "timestamp": "01:01:13", "text": "因为我是唯一一个叫这个名字的人，所以我做了我"}, {"type": "chat", "time": 3675.434, "timestamp": "01:01:15", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "they sometimes go cheap on yakitori tbh, 30-50yen per skewertr"}, {"type": "subtitle", "time": 3675.63, "timestamp": "01:01:15", "text": "我确保只有我一个人有这个"}, {"type": "subtitle", "time": 3677.549, "timestamp": "01:01:17", "text": "姓名"}, {"type": "subtitle", "time": 3681.43, "timestamp": "01:01:21", "text": "因为我想成为，因为我想"}, {"type": "chat", "time": 3683.528, "timestamp": "01:01:23", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "*skewer"}, {"type": "subtitle", "time": 3683.87, "timestamp": "01:01:23", "text": "我想要一个独一无二的名字。"}, {"type": "subtitle", "time": 3686.43, "timestamp": "01:01:26", "text": "尽管这个名字有"}, {"type": "subtitle", "time": 3688.829, "timestamp": "01:01:28", "text": "没有意义，或者说是我想要给予的东西。"}, {"type": "subtitle", "time": 3689.549, "timestamp": "01:01:29", "text": "一个"}, {"type": "subtitle", "time": 3692.63, "timestamp": "01:01:32", "text": "所以，这就是我作为J的旅程。"}, {"type": "subtitle", "time": 3694.789, "timestamp": "01:01:34", "text": "接下来给予"}, {"type": "chat", "time": 3698.492, "timestamp": "01:01:38", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "and niku is niku"}, {"type": "subtitle", "time": 3699.349, "timestamp": "01:01:39", "text": "这意味着有些人会在Y Yak Yakitori上偷工减料。"}, {"type": "subtitle", "time": 3700.27, "timestamp": "01:01:40", "text": "啊"}, {"type": "subtitle", "time": 3711.71, "timestamp": "01:01:51", "text": "哦，尼克尼克，但是生肉有点……"}, {"type": "subtitle", "time": 3718.91, "timestamp": "01:01:58", "text": "你知道我只吃我们家的鸡肉。"}]
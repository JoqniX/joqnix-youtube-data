[{"type": "subtitle", "time": 9482.92, "timestamp": "02:38:02", "text": "我应该去"}, {"type": "subtitle", "time": 9485.51, "timestamp": "02:38:05", "text": "[音乐]"}, {"type": "subtitle", "time": 9488.67, "timestamp": "02:38:08", "text": "我"}, {"type": "subtitle", "time": 9492.11, "timestamp": "02:38:12", "text": "男人应该那样做吗？那是什么？人们会怎么做？"}, {"type": "subtitle", "time": 9496.83, "timestamp": "02:38:16", "text": "谁会像我一样流汗？"}, {"type": "subtitle", "time": 9499.71, "timestamp": "02:38:19", "text": "克服这一点就像很酷一样"}, {"type": "subtitle", "time": 9501.23, "timestamp": "02:38:21", "text": "外套之类的"}, {"type": "subtitle", "time": 9504.71, "timestamp": "02:38:24", "text": "我不知道该如何克服"}, {"type": "subtitle", "time": 9509.55, "timestamp": "02:38:29", "text": "这小桶秋千"}, {"type": "subtitle", "time": 9512.469, "timestamp": "02:38:32", "text": "这是什么疼痛？哦，你看那里"}, {"type": "subtitle", "time": 9514.23, "timestamp": "02:38:34", "text": "一个"}, {"type": "subtitle", "time": 9518.429, "timestamp": "02:38:38", "text": "小狗在那里，一只小狗正在母狗"}, {"type": "subtitle", "time": 9520.389, "timestamp": "02:38:40", "text": "运送"}, {"type": "subtitle", "time": 9523.11, "timestamp": "02:38:43", "text": "小狗"}, {"type": "subtitle", "time": 9526.83, "timestamp": "02:38:46", "text": "我带小狗去散步"}]
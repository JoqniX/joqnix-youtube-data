[{"type": "subtitle", "time": 13564.51, "timestamp": "03:46:04", "text": "卡西歐玩具鋼琴，我"}, {"type": "subtitle", "time": 13567.229, "timestamp": "03:46:07", "text": "當時就想，兄弟，你在"}, {"type": "subtitle", "time": 13571.95, "timestamp": "03:46:11", "text": "開玩笑嗎？你開玩笑吧？"}, {"type": "subtitle", "time": 13612.71, "timestamp": "03:46:52", "text": "我是認真的。我做音樂，我知道我做的音樂不算好，但我嘗試在錄音室裡做音樂，我每天都投入時間和精力。你知道嗎，那天"}, {"type": "subtitle", "time": 13619.55, "timestamp": "03:46:59", "text": "我哭了好久，也明白了這個世界的運作方式。後來我才明白，我父母負擔不起這些東西，他們"}]
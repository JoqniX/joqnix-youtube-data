[{"type": "subtitle", "time": 21540.628, "timestamp": "05:59:00", "text": "我需要解鎖它。我要速通。等等，它到底持續多久？多少天？ 10天？喔不，"}, {"type": "subtitle", "time": 21592.39, "timestamp": "05:59:52", "text": "我需要"}, {"type": "subtitle", "time": 21595.43, "timestamp": "05:59:55", "text": "速通這一切，無論如何。呃，鎖在哪裡？寶箱被打破了。起飛！擁抱冰雪！嗨，"}]
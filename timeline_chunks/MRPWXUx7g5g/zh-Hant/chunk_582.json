[{"type": "subtitle", "time": 34927.426, "timestamp": "09:42:07", "text": "和我的管理員談判，"}, {"type": "subtitle", "time": 34931.99, "timestamp": "09:42:11", "text": "或者想辦法弄到一些效率提升之類的東西，比如我的星星破壞者2.0，"}, {"type": "subtitle", "time": 34939.39, "timestamp": "09:42:19", "text": "鑽石鎬。現在你知道了，我把星星"}, {"type": "subtitle", "time": 34948.35, "timestamp": "09:42:28", "text": "破壞者放在這裡。呃，我們需要整理一下。這裡有很多垃圾，當我穿著緊身褲的時候，我該拿你怎麼辦？"}, {"type": "subtitle", "time": 34958.35, "timestamp": "09:42:38", "text": "我不知道。所以，我們得到了一整套好東西，我們準備好今天就開始旅程了。走吧！"}]
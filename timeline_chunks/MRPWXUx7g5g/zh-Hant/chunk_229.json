[{"type": "subtitle", "time": 13748.91, "timestamp": "03:49:08", "text": "對，是20嗎？"}, {"type": "subtitle", "time": 13764.469, "timestamp": "03:49:24", "text": "不不不，但我認為整個C是20，他和我"}, {"type": "subtitle", "time": 13779.03, "timestamp": "03:49:39", "text": "爸一起做的，就像要寄過來一樣，部分原因是那段時間"}, {"type": "subtitle", "time": 13788.59, "timestamp": "03:49:48", "text": "我們家裡的錢出了點問題，所以他現在還在，"}, {"type": "subtitle", "time": 13797.55, "timestamp": "03:49:57", "text": "呃，我不知道他是怎麼弄到錢的，但是，是的，他為我和他兒子做的p pap，"}]
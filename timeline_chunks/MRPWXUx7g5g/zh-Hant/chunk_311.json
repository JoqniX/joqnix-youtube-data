[{"type": "subtitle", "time": 18674.39, "timestamp": "05:11:14", "text": "我沒有什麼好的神器之類的東西，不過，我得找個星期一去刷。我最近得到了陰"}, {"type": "subtitle", "time": 18678.59, "timestamp": "05:11:18", "text": "媽，我把所有金神器都隨機給了她。我忘了這個遊戲裡的計算是怎麼運作的了。"}, {"type": "subtitle", "time": 18713.75, "timestamp": "05:11:53", "text": "我以前會查看神器計算器之類的東西，然後刷那些神器，現在"}, {"type": "subtitle", "time": 18719.868, "timestamp": "05:11:59", "text": "我把所有系統的"}]
[{"type": "subtitle", "time": 10088.59, "timestamp": "02:48:08", "text": "我希望有一天能擁有自己的出道作品。等等，我從來"}, {"type": "subtitle", "time": 10093.469, "timestamp": "02:48:13", "text": "沒有正式出道過。"}, {"type": "subtitle", "time": 10096.309, "timestamp": "02:48:16", "text": "你們知道嗎？我從來沒有正式出道過。所以，如果，如果，呃，如果，如果我有一張我的出道專輯，那也不會有"}]
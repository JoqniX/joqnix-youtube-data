[{"type": "subtitle", "time": 251.75, "timestamp": "00:04:11", "text": "這裡。天哪，"}, {"type": "subtitle", "time": 256.43, "timestamp": "00:04:16", "text": "我居然"}, {"type": "subtitle", "time": 258.83, "timestamp": "00:04:18", "text": "睡著了，"}, {"type": "subtitle", "time": 263.11, "timestamp": "00:04:23", "text": "這太瘋狂了。我剛醒來，心想："}, {"type": "subtitle", "time": 265.35, "timestamp": "00:04:25", "text": "等等，直播？然後"}, {"type": "subtitle", "time": 268.39, "timestamp": "00:04:28", "text": "我上樓了，"}, {"type": "subtitle", "time": 271.35, "timestamp": "00:04:31", "text": "喔"}]
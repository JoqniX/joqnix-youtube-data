[{"type": "subtitle", "time": 36678.07, "timestamp": "10:11:18", "text": "不恨我？搞什麼鬼？搞什麼鬼？搞什麼鬼？搞什麼鬼？"}, {"type": "subtitle", "time": 36701.426, "timestamp": "10:11:41", "text": "兄弟，它要幹什麼？它已經想殺我兩次了，我受夠了，為什麼生活這麼痛苦？為什麼生活這麼痛苦？ [音樂]痛苦，為什麼生活這麼痛苦？我讓那塊方塊流下去，喔我的天，為什麼這裡有東西？為什麼只是一個普通的地方？夥計，這紅色的東西是什麼？讓我在這裡安頓下來。"}, {"type": "chat", "time": 36712.877, "timestamp": "10:11:52", "author": "@zereph3459", "avatar": "https://yt4.ggpht.com/B1CIahbh4AnWCo6QjO6sGe4Op04YwbxBTfy-_zSK1rau0_3fOAHCgC86GYN7b6WzLGBoyh-LRLY=s64-c-k-c0x00ffffff-no-rj", "message": "joq"}, {"type": "chat", "time": 36719.236, "timestamp": "10:11:59", "author": "@zereph3459", "avatar": "https://yt4.ggpht.com/B1CIahbh4AnWCo6QjO6sGe4Op04YwbxBTfy-_zSK1rau0_3fOAHCgC86GYN7b6WzLGBoyh-LRLY=s64-c-k-c0x00ffffff-no-rj", "message": "you lost so much aura last night"}]
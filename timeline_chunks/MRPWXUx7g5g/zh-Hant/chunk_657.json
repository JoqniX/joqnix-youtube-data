[{"type": "subtitle", "time": 39423.266, "timestamp": "10:57:03", "text": "媽媽把他抱在懷裡……哦，我想"}, {"type": "subtitle", "time": 39441.87, "timestamp": "10:57:21", "text": "所以這不是我寫的……什麼……等等……等等……你需要"}, {"type": "subtitle", "time": 39452.07, "timestamp": "10:57:32", "text": "說……這是我……我以為這是……嗯……熱度……或者像什麼……等等……等等……你需要說……這是我……我"}, {"type": "subtitle", "time": 39456.19, "timestamp": "10:57:36", "text": "以為這是……嗯……熱度……或者像什麼…………"}, {"type": "subtitle", "time": 39472.07, "timestamp": "10:57:52", "text": "我可以寫好，新的時間……我們可以"}, {"type": "subtitle", "time": 39474.15, "timestamp": "10:57:54", "text": "做一個正常的"}]
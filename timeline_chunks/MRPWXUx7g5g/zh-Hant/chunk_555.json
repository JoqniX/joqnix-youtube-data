[{"type": "subtitle", "time": 33301.79, "timestamp": "09:15:01", "text": "浪費時間，但我想要"}, {"type": "subtitle", "time": 33304.19, "timestamp": "09:15:04", "text": "深淵滑道，這樣我就可以更好地裝飾房子了，而且祖基的"}, {"type": "subtitle", "time": 33327.068, "timestamp": "09:15:27", "text": "拿走，呃，我想要那堆東西，我真的想要那堆東西，我真的想要那堆東西，好的，卷鐵，我不需要你，給你，應該可以了，回家，我們把那些放進去吧要滑下去，"}, {"type": "subtitle", "time": 33333.068, "timestamp": "09:15:33", "text": "然後回來這裡，我，呃，附魔什麼的跟著"}, {"type": "subtitle", "time": 33335.79, "timestamp": "09:15:35", "text": "鐵砧"}]
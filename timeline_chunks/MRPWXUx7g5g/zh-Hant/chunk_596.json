[{"type": "subtitle", "time": 35776.03, "timestamp": "09:56:16", "text": "紅衣主教回來，如果我直接去"}, {"type": "subtitle", "time": 35779.87, "timestamp": "09:56:19", "text": "我知道的地方，如果我去我知道的地方，哦等等，等等，有個地方，這是個地方，這裡有什麼？寶箱？"}, {"type": "subtitle", "time": 35798.39, "timestamp": "09:56:38", "text": "不，它只是一塊黏土，不，你怎麼收集這塊黏土？我們"}, {"type": "subtitle", "time": 35802.906, "timestamp": "09:56:42", "text": "去冒險吧，實際上，我覺得，"}]
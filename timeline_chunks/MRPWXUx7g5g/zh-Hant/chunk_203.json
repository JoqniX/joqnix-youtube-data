[{"type": "subtitle", "time": 12197.79, "timestamp": "03:23:17", "text": "不想回家。所以你覺得"}, {"type": "subtitle", "time": 12207.189, "timestamp": "03:23:27", "text": "到目前為止的移動Stringer怎麼樣？我這樣"}, {"type": "subtitle", "time": 12218.55, "timestamp": "03:23:38", "text": "做好嗎？你"}, {"type": "subtitle", "time": 12222.11, "timestamp": "03:23:42", "text": "覺得怎麼樣？其實也沒什麼特別的，更像是，如果有個可以散步的地方，我們就邊走邊聊些有的沒的，邊走邊說，你能聽到很多人說話，大概就是這樣。我希望我能設定一些目標，例如去某個特定的地方"}, {"type": "subtitle", "time": 12231.189, "timestamp": "03:23:51", "text": "散步之類的。如果可以的話，我就能"}]
[{"type": "subtitle", "time": 10440.87, "timestamp": "02:54:00", "text": "いつも結局"}, {"type": "subtitle", "time": 10443.269, "timestamp": "02:54:03", "text": "メガネを拭くのを忘れて、それから"}, {"type": "subtitle", "time": 10446.65, "timestamp": "02:54:06", "text": "結局、すべてがぼやけてしまう。"}, {"type": "subtitle", "time": 10448.55, "timestamp": "02:54:08", "text": "[音楽]"}, {"type": "subtitle", "time": 10460.23, "timestamp": "02:54:20", "text": "ああ、もうすぐ真夜中だ。神"}, {"type": "subtitle", "time": 10468.07, "timestamp": "02:54:28", "text": "チョーク、君はいつ寝るの？君たちは"}, {"type": "subtitle", "time": 10471.99, "timestamp": "02:54:31", "text": "いつも、あなたは実際にいつ寝ているのですか？"}, {"type": "subtitle", "time": 10474.95, "timestamp": "02:54:34", "text": "寝る？えっと、最近は寝てばかりなんです"}, {"type": "subtitle", "time": 10478.15, "timestamp": "02:54:38", "text": "遅い時間のように"}, {"type": "subtitle", "time": 10481.91, "timestamp": "02:54:41", "text": "午前5時 午前6時 午前5時 午前6時は違います"}, {"type": "subtitle", "time": 10484.309, "timestamp": "02:54:44", "text": "遅い、あなた"}, {"type": "subtitle", "time": 10488.469, "timestamp": "02:54:48", "text": "夜行性になった。何てことだ。えっと"}, {"type": "subtitle", "time": 10492.389, "timestamp": "02:54:52", "text": "コラボレーションとか色々あるから。何てことだ。"}, {"type": "subtitle", "time": 10494.469, "timestamp": "02:54:54", "text": "昨日は深夜のコラボ企画がありました。"}, {"type": "subtitle", "time": 10497.11, "timestamp": "02:54:57", "text": "そう、それは人々が目覚める時のようなものだ"}, {"type": "subtitle", "time": 10498.63, "timestamp": "02:54:58", "text": "上。"}]
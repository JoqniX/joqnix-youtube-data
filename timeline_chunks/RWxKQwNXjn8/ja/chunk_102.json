[{"type": "subtitle", "time": 6133.189, "timestamp": "01:42:13", "text": "では、色について見てみましょう"}, {"type": "subtitle", "time": 6135.669, "timestamp": "01:42:15", "text": "パンダの は。よし、ではこれから"}, {"type": "subtitle", "time": 6137.43, "timestamp": "01:42:17", "text": "パンダと一緒に別のルートを辿ってみよう。"}, {"type": "subtitle", "time": 6139.59, "timestamp": "01:42:19", "text": "私たちは持ちこたえるつもりだ。私は私に"}, {"type": "subtitle", "time": 6142.39, "timestamp": "01:42:22", "text": "私のレイヤーをあなたのレイヤーの上に重ねてください"}, {"type": "subtitle", "time": 6144.629, "timestamp": "01:42:24", "text": "実は"}, {"type": "subtitle", "time": 6146.87, "timestamp": "01:42:26", "text": "そうすれば、もっと効果的に作業を進めることができます。だった"}, {"type": "subtitle", "time": 6149.669, "timestamp": "01:42:29", "text": "パンダを作るつもり"}, {"type": "subtitle", "time": 6156.709, "timestamp": "01:42:36", "text": "しばらくは奇妙に見えるだろうが、"}, {"type": "subtitle", "time": 6173.75, "timestamp": "01:42:53", "text": "ただ出席する必要がある"}]
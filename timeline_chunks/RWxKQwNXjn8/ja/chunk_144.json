[{"type": "subtitle", "time": 8641.11, "timestamp": "02:24:01", "text": "クリーム。だから、私があなたに見せられるように"}, {"type": "subtitle", "time": 8643.78, "timestamp": "02:24:03", "text": "チャットを表示できます"}, {"type": "subtitle", "time": 8645.349, "timestamp": "02:24:05", "text": "[音楽]"}, {"type": "subtitle", "time": 8647.51, "timestamp": "02:24:07", "text": "たとえどんな写真を見ても"}, {"type": "subtitle", "time": 8650.469, "timestamp": "02:24:10", "text": "クリシュナ、あなたは彼が盗むのを見るでしょう"}, {"type": "subtitle", "time": 8654.71, "timestamp": "02:24:14", "text": "マカンマカンのようにあなたのクリームのように"}, {"type": "subtitle", "time": 8658.79, "timestamp": "02:24:18", "text": "しかし、クリームは。うん。だから、でも私は私は私は"}, {"type": "subtitle", "time": 8664.07, "timestamp": "02:24:24", "text": "彼は私の家族にとって脅威だった。私はそうするだろう"}, {"type": "subtitle", "time": 8667.67, "timestamp": "02:24:27", "text": "盗む 毎回食べるだけ"}, {"type": "subtitle", "time": 8670.469, "timestamp": "02:24:30", "text": "私の家族はクリームを作ろうとします"}, {"type": "subtitle", "time": 8672.79, "timestamp": "02:24:32", "text": "えーと、自家製クリームみたいな感じ。私は...するだろう"}, {"type": "subtitle", "time": 8676.23, "timestamp": "02:24:36", "text": "全部食べちゃえばいいよ。私はひどい状態だった。私の"}, {"type": "subtitle", "time": 8678.79, "timestamp": "02:24:38", "text": "家族は冷蔵庫に鍵をかけなければならなかった"}, {"type": "subtitle", "time": 8684.469, "timestamp": "02:24:44", "text": "知っている。"}, {"type": "subtitle", "time": 8686.55, "timestamp": "02:24:46", "text": "また、私はそうは思わない、そうは思わない、そうは思わない"}, {"type": "subtitle", "time": 8688.71, "timestamp": "02:24:48", "text": "私はキツネが好きです。私の好きな花"}, {"type": "subtitle", "time": 8691.83, "timestamp": "02:24:51", "text": "キツネです。あなたは私のことを理解していない。私は___出身です"}, {"type": "subtitle", "time": 8694.79, "timestamp": "02:24:54", "text": "欧州連合。派手なことはしないで、"}, {"type": "subtitle", "time": 8697.19, "timestamp": "02:24:57", "text": "あなたの凝った言葉遣い。くそ。しないで"}, {"type": "subtitle", "time": 8699.83, "timestamp": "02:24:59", "text": "ポーランド語を話せばいい。"}]
[{"type": "subtitle", "time": 18661.59, "timestamp": "05:11:01", "text": "記憶と共に？わかった。あ、待って。えっと、"}, {"type": "subtitle", "time": 18663.35, "timestamp": "05:11:03", "text": "そもそも記憶って何だっけ？そうそう。"}, {"type": "subtitle", "time": 18666.23, "timestamp": "05:11:06", "text": "わかった。わかった。こんにちは。"}, {"type": "subtitle", "time": 18671.11, "timestamp": "05:11:11", "text": "ああ、神様。さあ行こう。準備はいいですか？こんにちは。"}, {"type": "subtitle", "time": 18674.868, "timestamp": "05:11:14", "text": "うん。メモリ。ええと、ここは1つです。"}, {"type": "subtitle", "time": 18678.23, "timestamp": "05:11:18", "text": "わかった。 1つ"}, {"type": "subtitle", "time": 18680.55, "timestamp": "05:11:20", "text": "えーと、2位。"}, {"type": "subtitle", "time": 18683.59, "timestamp": "05:11:23", "text": "2位は2位です。私は押しています"}, {"type": "subtitle", "time": 18691.83, "timestamp": "05:11:31", "text": "ディスプレイには4と表示されている。 4つ。えーと4番目"}, {"type": "subtitle", "time": 18693.83, "timestamp": "05:11:33", "text": "位置。"}, {"type": "subtitle", "time": 18696.55, "timestamp": "05:11:36", "text": "4位。わかった。 1を押す"}, {"type": "subtitle", "time": 18701.67, "timestamp": "05:11:41", "text": "4位。わかった。それは間違っている。はぁ？"}, {"type": "subtitle", "time": 18704.948, "timestamp": "05:11:44", "text": "ステージ1に戻る。なんてこった。ディスプレイは"}, {"type": "subtitle", "time": 18707.19, "timestamp": "05:11:47", "text": "1つ。あーあ、ボタンを押して"}, {"type": "subtitle", "time": 18708.868, "timestamp": "05:11:48", "text": "2位。"}, {"type": "subtitle", "time": 18710.39, "timestamp": "05:11:50", "text": "ディスプレイが1つとはどういう意味ですか？あなたは"}, {"type": "subtitle", "time": 18712.788, "timestamp": "05:11:52", "text": "今、私の配信を見てますか？待って、君"}, {"type": "subtitle", "time": 18715.99, "timestamp": "05:11:55", "text": "誰かがそう言ったんですよね？私は一つとは言っていません。私"}, {"type": "subtitle", "time": 18719.51, "timestamp": "05:11:59", "text": "ステージ1に戻った。ああ、そうだね。だからあなたは"}]
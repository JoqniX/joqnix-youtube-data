[{"type": "subtitle", "time": 10860.07, "timestamp": "03:01:00", "text": "[音楽]"}, {"type": "subtitle", "time": 10861.83, "timestamp": "03:01:01", "text": "正直言って、私はロティの方が好きです。"}, {"type": "subtitle", "time": 10864.389, "timestamp": "03:01:04", "text": "米が一番多い。子供の頃に使っていました。今は私は"}, {"type": "subtitle", "time": 10866.63, "timestamp": "03:01:06", "text": "ご飯も好きだけど、以前はロティの方が好きだった"}, {"type": "subtitle", "time": 10869.59, "timestamp": "03:01:09", "text": "子供。"}, {"type": "subtitle", "time": 10873.83, "timestamp": "03:01:13", "text": "ああ、俺たちは本物だ。いいですよ。ロティ"}, {"type": "subtitle", "time": 10882.79, "timestamp": "03:01:22", "text": "何てことだ。"}, {"type": "subtitle", "time": 10885.19, "timestamp": "03:01:25", "text": "ジョークは、知れば知るほど常軌を逸している"}, {"type": "subtitle", "time": 10889.19, "timestamp": "03:01:29", "text": "彼。正気を失っている。何が"}, {"type": "subtitle", "time": 10892.23, "timestamp": "03:01:32", "text": "ほら、わかるでしょ？わかった。私はそうは思わない"}, {"type": "subtitle", "time": 10894.15, "timestamp": "03:01:34", "text": "チャドがこのことを知っているかどうかは分からない。"}, {"type": "subtitle", "time": 10896.15, "timestamp": "03:01:36", "text": "チャドにVRのことを話した？"}, {"type": "subtitle", "time": 10898.389, "timestamp": "03:01:38", "text": "アドベンチャー？"}, {"type": "subtitle", "time": 10900.55, "timestamp": "03:01:40", "text": "VRアドベンチャー。"}, {"type": "subtitle", "time": 10904.389, "timestamp": "03:01:44", "text": "VRハウス。うん。ああ、つまり私は自分の"}, {"type": "subtitle", "time": 10909.59, "timestamp": "03:01:49", "text": "その時はストリーミング配信したと思う。うん。だから私は私は"}, {"type": "subtitle", "time": 10911.51, "timestamp": "03:01:51", "text": "これが欲しい、これを設定したい、"}, {"type": "subtitle", "time": 10915.19, "timestamp": "03:01:55", "text": "皆さんのために状況を説明します。わかった。えーと"}, {"type": "subtitle", "time": 10919.349, "timestamp": "03:01:59", "text": "ジョー、ムラ、イマン、京都、彼らは皆"}]
[{"type": "subtitle", "time": 4620.229, "timestamp": "01:17:00", "text": "存在するべきである"}, {"type": "subtitle", "time": 4623.51, "timestamp": "01:17:03", "text": "莫大な金額を支払わなければならない、ということですよね。"}, {"type": "subtitle", "time": 4625.83, "timestamp": "01:17:05", "text": "そう、それが問題なんです。光沢があるのは"}, {"type": "subtitle", "time": 4629.91, "timestamp": "01:17:09", "text": "一般的には、はい、それらは高価です"}, {"type": "subtitle", "time": 4632.709, "timestamp": "01:17:12", "text": "製造。"}, {"type": "subtitle", "time": 4637.35, "timestamp": "01:17:17", "text": "うん。続行できますか？うん。もちろんさ。"}, {"type": "subtitle", "time": 4641.75, "timestamp": "01:17:21", "text": "でも、7月以降ならできるかもしれない。"}, {"type": "subtitle", "time": 4644.149, "timestamp": "01:17:24", "text": "だって私は、私は自分自身をストリーミングしているから"}, {"type": "subtitle", "time": 4649.51, "timestamp": "01:17:29", "text": "まもなくビジネスが始まります。私は私は私は私は"}, {"type": "subtitle", "time": 4653.43, "timestamp": "01:17:33", "text": "私はJock Marketableのぬいぐるみを買うだろう。"}, {"type": "subtitle", "time": 4655.99, "timestamp": "01:17:35", "text": "私はそれをベッドの上で着ます"}, {"type": "subtitle", "time": 4657.99, "timestamp": "01:17:37", "text": "私の他のぬいぐるみ"}, {"type": "subtitle", "time": 4660.07, "timestamp": "01:17:40", "text": "私が心から愛している私の"}, {"type": "subtitle", "time": 4663.03, "timestamp": "01:17:43", "text": "私の娘たちと息子。"}, {"type": "subtitle", "time": 4666.79, "timestamp": "01:17:46", "text": "私は気づいた、えっと"}, {"type": "subtitle", "time": 4669.75, "timestamp": "01:17:49", "text": "えっと、ちびキャラをもっと使ってもいいと思うんだけど、"}, {"type": "subtitle", "time": 4673.35, "timestamp": "01:17:53", "text": "ぬいぐるみというよりは、見た目は確かに"}, {"type": "subtitle", "time": 4676.55, "timestamp": "01:17:56", "text": "ぬいぐるみみたい。"}, {"type": "subtitle", "time": 4679.189, "timestamp": "01:17:59", "text": "ああ、君はただ単に生意気なだけだよ。ちびは"}]
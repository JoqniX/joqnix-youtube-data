[{"type": "subtitle", "time": 17706.948, "timestamp": "04:55:06", "text": "自爆するなんて想像できますか？"}, {"type": "subtitle", "time": 17709.83, "timestamp": "04:55:09", "text": "爆弾を解除した後？"}, {"type": "subtitle", "time": 17713.59, "timestamp": "04:55:13", "text": "何が起こるか見てみたい。うん。"}, {"type": "subtitle", "time": 17715.75, "timestamp": "04:55:15", "text": "よし。"}, {"type": "subtitle", "time": 17719.11, "timestamp": "04:55:19", "text": "次の爆弾。いいえ。もしくは、あなたがやりたいこと"}, {"type": "subtitle", "time": 17722.15, "timestamp": "04:55:22", "text": "ステップ？やってみろ。わかった。 4つあります"}, {"type": "subtitle", "time": 17725.75, "timestamp": "04:55:25", "text": "モジュール。ああ、今回は君が一番だ"}, {"type": "subtitle", "time": 17728.39, "timestamp": "04:55:28", "text": "1つ。 1位。"}, {"type": "subtitle", "time": 17731.67, "timestamp": "04:55:31", "text": "41秒。ニース。あまり関係ないよ。"}, {"type": "subtitle", "time": 17733.91, "timestamp": "04:55:33", "text": "こんにちは。始めます。"}, {"type": "subtitle", "time": 17748.47, "timestamp": "04:55:48", "text": "わかった。記号が1つ見えます。記号。"}, {"type": "subtitle", "time": 17751.99, "timestamp": "04:55:51", "text": "ああ、迷路だ。えっと、数字のLEDのやつと"}, {"type": "subtitle", "time": 17753.51, "timestamp": "04:55:53", "text": "ワイヤー。"}, {"type": "subtitle", "time": 17755.43, "timestamp": "04:55:55", "text": "まずは簡単なものから始めましょう。わかった。"}, {"type": "subtitle", "time": 17758.628, "timestamp": "04:55:58", "text": "配線作業に取り掛かりましょう。ワイヤー。 4本のワイヤー。"}]
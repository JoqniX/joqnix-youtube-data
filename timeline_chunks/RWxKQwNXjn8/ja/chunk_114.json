[{"type": "subtitle", "time": 6840.229, "timestamp": "01:54:00", "text": "ああ、僕は強い女性が大好きだよ、ジョー。私"}, {"type": "subtitle", "time": 6847.03, "timestamp": "01:54:07", "text": "女性が"}, {"type": "subtitle", "time": 6849.109, "timestamp": "01:54:09", "text": "私を殺して、もしくは私の背骨を折って"}, {"type": "subtitle", "time": 6853.27, "timestamp": "01:54:13", "text": "半分に分割できるというのは、非常に魅力的な特徴です。おお"}, {"type": "subtitle", "time": 6859.669, "timestamp": "01:54:19", "text": "聞いてくれ、誰にでもタイプがあるし、私の時間も"}, {"type": "subtitle", "time": 6867.43, "timestamp": "01:54:27", "text": "ザニは大好きだけど、"}, {"type": "subtitle", "time": 6869.83, "timestamp": "01:54:29", "text": "フィービーを失った 5052。ああ、待って、"}, {"type": "subtitle", "time": 6872.39, "timestamp": "01:54:32", "text": "Sチャートが機能しなくなりましたか？"}, {"type": "subtitle", "time": 6875.189, "timestamp": "01:54:35", "text": "私もそれに気づきました。"}, {"type": "subtitle", "time": 6879.189, "timestamp": "01:54:39", "text": "はい、修正してみます。よし、"}, {"type": "subtitle", "time": 6882.87, "timestamp": "01:54:42", "text": "もう一度ご招待させてください。"}, {"type": "subtitle", "time": 6886.47, "timestamp": "01:54:46", "text": "フィービーに送ったのは、きつくなかった。誰が"}, {"type": "subtitle", "time": 6889.91, "timestamp": "01:54:49", "text": "またフィービー？忘れてしまう"}, {"type": "subtitle", "time": 6892.47, "timestamp": "01:54:52", "text": "フィービーは、あなたが出会う金髪の女の子です。"}, {"type": "subtitle", "time": 6893.99, "timestamp": "01:54:53", "text": "おお、"}, {"type": "subtitle", "time": 6896.229, "timestamp": "01:54:56", "text": "帽子をかぶっているのは、私はまだ"}, {"type": "subtitle", "time": 6899.03, "timestamp": "01:54:59", "text": "私はまだ最初のエリアにいるんです。私"}]
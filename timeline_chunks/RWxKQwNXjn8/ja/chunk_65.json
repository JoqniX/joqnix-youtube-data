[{"type": "subtitle", "time": 3915.349, "timestamp": "01:05:15", "text": "私は筆記体しか書けません。"}, {"type": "subtitle", "time": 3918.39, "timestamp": "01:05:18", "text": "H 時々同じ"}, {"type": "subtitle", "time": 3920.87, "timestamp": "01:05:20", "text": "私も同じです。それが唯一の"}, {"type": "subtitle", "time": 3923.91, "timestamp": "01:05:23", "text": "私の学校で教わったように。彼らはまるで"}, {"type": "subtitle", "time": 3926.95, "timestamp": "01:05:26", "text": "筆記体で書かなければならないし、私が"}, {"type": "subtitle", "time": 3928.549, "timestamp": "01:05:28", "text": "筆記体で書くと悪い感じ"}, {"type": "subtitle", "time": 3930.39, "timestamp": "01:05:30", "text": "手書き文字と、彼が私に教えてくれたように"}, {"type": "subtitle", "time": 3937.349, "timestamp": "01:05:37", "text": "私のパネルに住み着いた彼らは激しい"}, {"type": "subtitle", "time": 3941.349, "timestamp": "01:05:41", "text": "彼らの殺人犯。おお"}, {"type": "subtitle", "time": 3944.47, "timestamp": "01:05:44", "text": "うん。問題はパンダです。である"}, {"type": "subtitle", "time": 3947.43, "timestamp": "01:05:47", "text": "公平に、野生のパンダ"}, {"type": "subtitle", "time": 3950.95, "timestamp": "01:05:50", "text": "まあまあ生き残るだろうけど、"}, {"type": "subtitle", "time": 3952.549, "timestamp": "01:05:52", "text": "人間の介入によって、"}]
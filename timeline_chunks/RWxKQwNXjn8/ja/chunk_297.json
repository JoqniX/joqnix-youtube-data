[{"type": "subtitle", "time": 17827.91, "timestamp": "04:57:07", "text": "えーと、今はLEDが2つ点灯しています。"}, {"type": "subtitle", "time": 17831.11, "timestamp": "04:57:11", "text": "2対2。わかった。ボタンを押す"}, {"type": "subtitle", "time": 17833.51, "timestamp": "04:57:13", "text": "ステージで押すのと同じ位置"}, {"type": "subtitle", "time": 17837.51, "timestamp": "04:57:17", "text": "1つ。だから、それでいいんです。三つ。"}, {"type": "subtitle", "time": 17841.11, "timestamp": "04:57:21", "text": "三つ。えっと、３つ表示します。"}, {"type": "subtitle", "time": 17842.948, "timestamp": "04:57:22", "text": "3つ表示します。わかった。ボタンを押す"}, {"type": "subtitle", "time": 17847.75, "timestamp": "04:57:27", "text": "3位。これで2人目です。こんにちは。"}, {"type": "subtitle", "time": 17851.03, "timestamp": "04:57:31", "text": "わかった。すると、1が表示されます。ディスプレイ"}, {"type": "subtitle", "time": 17853.03, "timestamp": "04:57:33", "text": "1つ。同じボタンを押してください"}, {"type": "subtitle", "time": 17856.55, "timestamp": "04:57:36", "text": "ステージ1で押した位置と同じ位置にしてください。"}, {"type": "subtitle", "time": 17859.83, "timestamp": "04:57:39", "text": "それは2位だ。こんにちは。拡散性。"}, {"type": "subtitle", "time": 17862.23, "timestamp": "04:57:42", "text": "なんてこった。拡散しない。あと1つ。えっと、"}, {"type": "subtitle", "time": 17866.948, "timestamp": "04:57:46", "text": "2番。えっと、LED。わかった。 2つ表示します。"}, {"type": "subtitle", "time": 17869.11, "timestamp": "04:57:49", "text": "同じラベルのボタンを押してください"}, {"type": "subtitle", "time": 17870.948, "timestamp": "04:57:50", "text": "第2段階で圧力がかけられた。 ３を押して、"}, {"type": "subtitle", "time": 17874.31, "timestamp": "04:57:54", "text": "右？うん。三つ。わかった。拡散した。えっと、"}, {"type": "subtitle", "time": 17876.07, "timestamp": "04:57:56", "text": "迷路。"}]
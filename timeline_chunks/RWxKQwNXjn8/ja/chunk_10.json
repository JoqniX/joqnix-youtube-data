[{"type": "subtitle", "time": 601.269, "timestamp": "00:10:01", "text": "[音楽]"}, {"type": "subtitle", "time": 604.47, "timestamp": "00:10:04", "text": "とてもかわいいです。"}, {"type": "subtitle", "time": 617.67, "timestamp": "00:10:17", "text": "わかった。ああ、ああ。"}, {"type": "subtitle", "time": 620.79, "timestamp": "00:10:20", "text": "チャットを開くにはどうすればいいですか？このようにしてチャットを開くことができます。"}, {"type": "subtitle", "time": 623.91, "timestamp": "00:10:23", "text": "ああ、私も参加しないといけないよね？うん、君"}, {"type": "subtitle", "time": 627.11, "timestamp": "00:10:27", "text": "それをしなければならない、そしてそれから"}, {"type": "subtitle", "time": 629.11, "timestamp": "00:10:29", "text": "アカウントを持っているかどうかわかりません"}, {"type": "subtitle", "time": 633.59, "timestamp": "00:10:33", "text": "マグマ。アカウントは必要ありませんよ。"}, {"type": "subtitle", "time": 634.71, "timestamp": "00:10:34", "text": "絵を描いてもいいですよ"}, {"type": "subtitle", "time": 638.47, "timestamp": "00:10:38", "text": "匿名で。新しい"}, {"type": "subtitle", "time": 639.59, "timestamp": "00:10:39", "text": "レイヤーを敷けば、"}, {"type": "subtitle", "time": 643.75, "timestamp": "00:10:43", "text": "描画。わかった。うん。"}, {"type": "subtitle", "time": 646.389, "timestamp": "00:10:46", "text": "いいえ。でも、はい。祖母になる"}, {"type": "subtitle", "time": 649.75, "timestamp": "00:10:49", "text": "銀。ああ神様、リーグ・オブ・レジェンドを開いてない"}, {"type": "subtitle", "time": 654.23, "timestamp": "00:10:54", "text": "永遠に。また、私は技術的には"}, {"type": "subtitle", "time": 656.71, "timestamp": "00:10:56", "text": "毛深いけれど、同時に毛深いわけでもない。その"}, {"type": "subtitle", "time": 658.31, "timestamp": "00:10:58", "text": "複雑。"}]
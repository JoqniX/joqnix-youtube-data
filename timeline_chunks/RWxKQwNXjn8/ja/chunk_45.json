[{"type": "subtitle", "time": 2714.47, "timestamp": "00:45:14", "text": "うんちの言及を何個か除いて"}, {"type": "subtitle", "time": 2719.19, "timestamp": "00:45:19", "text": "ゼロは存在しますか？社会的信用。私たちは"}, {"type": "subtitle", "time": 2727.03, "timestamp": "00:45:27", "text": "なぜ私のプールはあのプールに似ているのだろう？"}, {"type": "subtitle", "time": 2729.19, "timestamp": "00:45:29", "text": "ご心配なく。心配しないでください"}, {"type": "subtitle", "time": 2732.79, "timestamp": "00:45:32", "text": "それ。それはプロセスです。信じなければならない"}, {"type": "subtitle", "time": 2737.19, "timestamp": "00:45:37", "text": "夢の中でそうすれば、あなたは勝つでしょう。"}, {"type": "subtitle", "time": 2740.79, "timestamp": "00:45:40", "text": "私は「オーマイゴッド」って感じに見える。オーのように見える"}, {"type": "subtitle", "time": 2747.27, "timestamp": "00:45:47", "text": "大丈夫だと思う。"}, {"type": "subtitle", "time": 2748.67, "timestamp": "00:45:48", "text": "えっと、"}]
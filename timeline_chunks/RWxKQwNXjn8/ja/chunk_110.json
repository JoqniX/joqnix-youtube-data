[{"type": "subtitle", "time": 6601.03, "timestamp": "01:50:01", "text": "新型モデルを見たかって？私はそうは思わない"}, {"type": "subtitle", "time": 6605.51, "timestamp": "01:50:05", "text": "私は持っている。ああ、そうだったね。私は思う"}, {"type": "subtitle", "time": 6609.59, "timestamp": "01:50:09", "text": "私の記憶力はただ悪いだけです。"}, {"type": "subtitle", "time": 6612.79, "timestamp": "01:50:12", "text": "私は記憶力が悪い。"}, {"type": "subtitle", "time": 6615.27, "timestamp": "01:50:15", "text": "新しいモデルの開発はまだ進めていない。"}, {"type": "subtitle", "time": 6617.83, "timestamp": "01:50:17", "text": "気が散ってしまった。"}, {"type": "subtitle", "time": 6619.99, "timestamp": "01:50:19", "text": "おお。"}, {"type": "subtitle", "time": 6622.629, "timestamp": "01:50:22", "text": "私が最後に"}, {"type": "subtitle", "time": 6626.79, "timestamp": "01:50:26", "text": "少しは共有した時間だったと思います。"}, {"type": "subtitle", "time": 6630.629, "timestamp": "01:50:30", "text": "ああ、なんて綺麗なの。"}, {"type": "subtitle", "time": 6632.709, "timestamp": "01:50:32", "text": "待って、あなたは私が尋ねたのを見ていないと思います"}, {"type": "subtitle", "time": 6635.03, "timestamp": "01:50:35", "text": "あなた。うん。うん。あなたは私があなたを"}, {"type": "subtitle", "time": 6639.27, "timestamp": "01:50:39", "text": "ご覧になりましたか？おそらく忘れてしまったのでしょう。私 あなた"}, {"type": "subtitle", "time": 6640.629, "timestamp": "01:50:40", "text": "おそらく私に見せてくれたのでしょう、そして私はただ"}, {"type": "subtitle", "time": 6642.629, "timestamp": "01:50:42", "text": "忘れた。言ったように、私はクソを持っています"}, {"type": "subtitle", "time": 6645.81, "timestamp": "01:50:45", "text": "メモリ。何てことだ。ジョーク。ファンボーイ。"}, {"type": "subtitle", "time": 6647.75, "timestamp": "01:50:47", "text": "[音楽]"}, {"type": "subtitle", "time": 6652.229, "timestamp": "01:50:52", "text": "ファンボーイのスポーツマン。コーディ、余分なファンボーイを救え。"}, {"type": "subtitle", "time": 6656.55, "timestamp": "01:50:56", "text": "何？わからない。どういう意味ですか？"}]
[{"type": "subtitle", "time": 1801.83, "timestamp": "00:30:01", "text": "そこで、円を描いて話し合いをします。わかった。えっと、"}, {"type": "subtitle", "time": 1810.389, "timestamp": "00:30:10", "text": "サイズを大きくするにはどうすればいいですか"}, {"type": "subtitle", "time": 1813.35, "timestamp": "00:30:13", "text": "消しゴム？"}, {"type": "subtitle", "time": 1817.59, "timestamp": "00:30:17", "text": "うん、それは"}, {"type": "subtitle", "time": 1824.149, "timestamp": "00:30:24", "text": "円を描きます。それは"}, {"type": "subtitle", "time": 1826.95, "timestamp": "00:30:26", "text": "あなたの顔になるよ。"}, {"type": "subtitle", "time": 1828.95, "timestamp": "00:30:28", "text": "いかにもスポーツマンっぽい響きだ。ねえ、作って"}, {"type": "subtitle", "time": 1831.59, "timestamp": "00:30:31", "text": "彼パンダ。私たちは彼をパンダにするつもりです。"}, {"type": "subtitle", "time": 1833.59, "timestamp": "00:30:33", "text": "わかった。"}, {"type": "subtitle", "time": 1835.59, "timestamp": "00:30:35", "text": "大丈夫だよ、ジョー。彼らの言うことを聞かないでください"}, {"type": "subtitle", "time": 1838.789, "timestamp": "00:30:38", "text": "彼らは意地悪だ。あなたはとても 彼らは"}, {"type": "subtitle", "time": 1842.23, "timestamp": "00:30:42", "text": "強い。うん。"}, {"type": "subtitle", "time": 1844.389, "timestamp": "00:30:44", "text": "わからない。待って、ジョー、あなたは観た？"}, {"type": "subtitle", "time": 1858.47, "timestamp": "00:30:58", "text": "それは、君ならこのジョークが分かるよ。君ならできるよ。おお"}]
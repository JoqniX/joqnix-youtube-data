[{"type": "subtitle", "time": 8940.63, "timestamp": "02:29:00", "text": "ポーランド語です。待って、どう発音するの？"}, {"type": "subtitle", "time": 8943.99, "timestamp": "02:29:03", "text": "研磨？それはポーランド語ですか。研磨。"}, {"type": "subtitle", "time": 8946.95, "timestamp": "02:29:06", "text": "研磨。どうやって？待って、発音しないの？"}, {"type": "subtitle", "time": 8948.469, "timestamp": "02:29:08", "text": "研磨？"}, {"type": "subtitle", "time": 8957.429, "timestamp": "02:29:17", "text": "ヒンディー語のことですか、それともヒンディー語の方言のことですか？"}, {"type": "subtitle", "time": 8960.469, "timestamp": "02:29:20", "text": "それは、方言ではありません。それは独自の"}, {"type": "subtitle", "time": 8961.99, "timestamp": "02:29:21", "text": "言語。"}, {"type": "subtitle", "time": 8964.23, "timestamp": "02:29:24", "text": "ええと、それは山岳地帯の言語です。だからそれは"}, {"type": "subtitle", "time": 8967.19, "timestamp": "02:29:27", "text": "話された、それは、それは、それは、それは来る"}, {"type": "subtitle", "time": 8968.63, "timestamp": "02:29:28", "text": "山のようなカテゴリーの下で"}, {"type": "subtitle", "time": 8971.11, "timestamp": "02:29:31", "text": "言語。"}, {"type": "subtitle", "time": 8973.91, "timestamp": "02:29:33", "text": "ポーランド。何てことだ。いいえ。どういう意味ですか？"}, {"type": "subtitle", "time": 8975.67, "timestamp": "02:29:35", "text": "どのように発音しますか？ちょっと待ってください。私は"}, {"type": "subtitle", "time": 8977.27, "timestamp": "02:29:37", "text": "私はこれを調べています。"}, {"type": "subtitle", "time": 8978.55, "timestamp": "02:29:38", "text": "今、調べているところです。探しています"}, {"type": "subtitle", "time": 8981.349, "timestamp": "02:29:41", "text": "これを上に。住民を磨く"}, {"type": "subtitle", "time": 8986.15, "timestamp": "02:29:46", "text": "ポーランド。ポーランド。研磨"}, {"type": "subtitle", "time": 8988.309, "timestamp": "02:29:48", "text": "名詞。"}]
[{"type": "subtitle", "time": 2101.75, "timestamp": "00:35:01", "text": "ソフトな素材を使いたかったのですが"}, {"type": "subtitle", "time": 2104.63, "timestamp": "00:35:04", "text": "なぜ私はインクを使っていたのか？"}, {"type": "subtitle", "time": 2114.47, "timestamp": "00:35:14", "text": "チャットチームへようこそ。はい、私は"}, {"type": "subtitle", "time": 2117.75, "timestamp": "00:35:17", "text": "今日はジョックと一緒です。こんにちは。そして私たちは"}, {"type": "subtitle", "time": 2122.31, "timestamp": "00:35:22", "text": "ジョックの人物像を描いています。"}, {"type": "subtitle", "time": 2140.95, "timestamp": "00:35:40", "text": "あるいは、そんな感じ。"}, {"type": "subtitle", "time": 2146.95, "timestamp": "00:35:46", "text": "えーと"}, {"type": "subtitle", "time": 2149.75, "timestamp": "00:35:49", "text": "デフォルトのブラシは何でしたか"}, {"type": "subtitle", "time": 2153.43, "timestamp": "00:35:53", "text": "また？インクのことですよね？はい、デフォルトのものです"}, {"type": "subtitle", "time": 2156.31, "timestamp": "00:35:56", "text": "インクのようなものか、ピクセルのようなものか。それはそれは私"}, {"type": "subtitle", "time": 2158.63, "timestamp": "00:35:58", "text": "ピクセルペンを想像してみてください。"}]
[{"type": "subtitle", "time": 9060.55, "timestamp": "02:31:00", "text": "大丈夫です。大丈夫です。脈。脈。"}, {"type": "subtitle", "time": 9063.27, "timestamp": "02:31:03", "text": "多分。"}, {"type": "subtitle", "time": 9064.87, "timestamp": "02:31:04", "text": "ほら、私、私たちは親しいとは感じないの"}, {"type": "subtitle", "time": 9067.03, "timestamp": "02:31:07", "text": "十分。"}, {"type": "subtitle", "time": 9069.429, "timestamp": "02:31:09", "text": "そうですよね？近い。十分近い。"}, {"type": "subtitle", "time": 9077.99, "timestamp": "02:31:17", "text": "意味は重要です。"}, {"type": "subtitle", "time": 9080.63, "timestamp": "02:31:20", "text": "Jo Englishの発音へようこそ"}, {"type": "subtitle", "time": 9084.07, "timestamp": "02:31:24", "text": "クラス。何てことだ。何てことだ。よし。"}, {"type": "subtitle", "time": 9086.15, "timestamp": "02:31:26", "text": "問題は、君たちが、君たちが"}, {"type": "subtitle", "time": 9088.87, "timestamp": "02:31:28", "text": "チャイとかそういうことを言うつもり"}, {"type": "subtitle", "time": 9092.63, "timestamp": "02:31:32", "text": "大丈夫です。わかった。私はこんなことを言える"}, {"type": "subtitle", "time": 9096.55, "timestamp": "02:31:36", "text": "警察。ああ、まるで警察みたいだ。研磨"}, {"type": "subtitle", "time": 9100.55, "timestamp": "02:31:40", "text": "警察。警察。警察。私がそう言っているのか"}, {"type": "subtitle", "time": 9106.71, "timestamp": "02:31:46", "text": "のように"}, {"type": "subtitle", "time": 9111.03, "timestamp": "02:31:51", "text": "警察。警察。警察。警察。警察。"}]
[{"type": "subtitle", "time": 7562.47, "timestamp": "02:06:02", "text": "それは、"}, {"type": "subtitle", "time": 7566.47, "timestamp": "02:06:06", "text": "彼らは料理をしようとするが、母親たちは"}, {"type": "subtitle", "time": 7567.51, "timestamp": "02:06:07", "text": "まるで、ほら、君は"}, {"type": "subtitle", "time": 7570.07, "timestamp": "02:06:10", "text": "長すぎる。君は遅すぎるよ。それをあげて"}, {"type": "subtitle", "time": 7576.87, "timestamp": "02:06:16", "text": "あと2回Zをプレイしたら飽きてしまうだろう"}, {"type": "subtitle", "time": 7579.51, "timestamp": "02:06:19", "text": "それからラザニアのトマトスープに戻ります。"}, {"type": "subtitle", "time": 7583.189, "timestamp": "02:06:23", "text": "ラザニアはおいしい。ラザニア。私は一度も"}, {"type": "subtitle", "time": 7587.589, "timestamp": "02:06:27", "text": "Pewdiepieから聞いただけだ。"}, {"type": "subtitle", "time": 7591.189, "timestamp": "02:06:31", "text": "ジョー、私は、あなたが知っているように、私は"}, {"type": "subtitle", "time": 7593.189, "timestamp": "02:06:33", "text": "予備の部屋がある。ジョック。私は"}, {"type": "subtitle", "time": 7595.27, "timestamp": "02:06:35", "text": "追加の部屋。"}, {"type": "subtitle", "time": 7597.109, "timestamp": "02:06:37", "text": "予備の部屋に入れてあげるから"}, {"type": "subtitle", "time": 7598.87, "timestamp": "02:06:38", "text": "1週間くらい食べさせてあげる"}, {"type": "subtitle", "time": 7601.51, "timestamp": "02:06:41", "text": "次のような"}, {"type": "subtitle", "time": 7604.39, "timestamp": "02:06:44", "text": "あなたをエキゾチックな場所へ連れて行き、食事を与えてください"}, {"type": "subtitle", "time": 7606.149, "timestamp": "02:06:46", "text": "単に他のさまざまなものと同じように"}, {"type": "subtitle", "time": 7609.27, "timestamp": "02:06:49", "text": "米。米は食べられません"}, {"type": "subtitle", "time": 7611.669, "timestamp": "02:06:51", "text": "1週間"}, {"type": "subtitle", "time": 7614.39, "timestamp": "02:06:54", "text": "そして私たちは違うものを食べるだけです"}]
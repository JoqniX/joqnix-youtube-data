[{"type": "subtitle", "time": 7081.35, "timestamp": "01:58:01", "text": "新しいことを試してみたい、"}, {"type": "subtitle", "time": 7084.07, "timestamp": "01:58:04", "text": "そしてまた"}, {"type": "subtitle", "time": 7088.709, "timestamp": "01:58:08", "text": "前に進むにつれて、うーん"}, {"type": "subtitle", "time": 7091.35, "timestamp": "01:58:11", "text": "えっと、ビジネス面ではなく、情熱的な"}, {"type": "subtitle", "time": 7093.83, "timestamp": "01:58:13", "text": "いいえ、とても気持ちいいですが、"}, {"type": "subtitle", "time": 7095.75, "timestamp": "01:58:15", "text": "ビジネスについて学ぶとき"}, {"type": "subtitle", "time": 7098.47, "timestamp": "01:58:18", "text": "横から見ると、「うわあ、すごくたくさんある」って感じ"}, {"type": "subtitle", "time": 7101.91, "timestamp": "01:58:21", "text": "「物事をこう変えていくんだ。」うん、君の言いたいことはわかるよ"}, {"type": "subtitle", "time": 7103.35, "timestamp": "01:58:23", "text": "平均。それは似たようなものだ"}, {"type": "subtitle", "time": 7105.91, "timestamp": "01:58:25", "text": "人々が話すとき、私と一緒にいると、"}, {"type": "subtitle", "time": 7107.75, "timestamp": "01:58:27", "text": "私にとって、あなたが知っているように、"}, {"type": "subtitle", "time": 7110.149, "timestamp": "01:58:30", "text": "アルゴリズムのように行うべきであり、"}, {"type": "subtitle", "time": 7112.55, "timestamp": "01:58:32", "text": "私は何も思い浮かばない、なぜなら私は"}, {"type": "subtitle", "time": 7114.55, "timestamp": "01:58:34", "text": "たくさん考えたので、私にとって"}, {"type": "subtitle", "time": 7116.229, "timestamp": "01:58:36", "text": "それは、ほら、わかってるよ、"}, {"type": "subtitle", "time": 7117.75, "timestamp": "01:58:37", "text": "重要なことだ。それは"}, {"type": "subtitle", "time": 7119.43, "timestamp": "01:58:39", "text": "大切なことは、みんなが学ぶこと"}, {"type": "subtitle", "time": 7122.709, "timestamp": "01:58:42", "text": "その物についてですが、ただ飛ぶだけです"}, {"type": "subtitle", "time": 7124.79, "timestamp": "01:58:44", "text": "私には理解できない。私は"}, {"type": "subtitle", "time": 7126.149, "timestamp": "01:58:46", "text": "バックグラウンドでストリーミング配信。私は"}, {"type": "subtitle", "time": 7128.149, "timestamp": "01:58:48", "text": "二人の間の無邪気な戦い。しかし"}, {"type": "subtitle", "time": 7130.39, "timestamp": "01:58:50", "text": "そして最後に、私の脳細胞が失われていく。"}, {"type": "subtitle", "time": 7133.51, "timestamp": "01:58:53", "text": "聞いてくれ、前回の配信は"}, {"type": "subtitle", "time": 7137.43, "timestamp": "01:58:57", "text": "RXR。えっと、RXRは最悪な面を引き出すだけです"}, {"type": "subtitle", "time": 7139.51, "timestamp": "01:58:59", "text": "私の中に。彼はただ、私たちが"}]
[{"type": "subtitle", "time": 3304.15, "timestamp": "00:55:04", "text": "わかった。また、必ず"}, {"type": "subtitle", "time": 3305.589, "timestamp": "00:55:05", "text": "何、何をしたの？何を言ってるの？"}, {"type": "subtitle", "time": 3309.27, "timestamp": "00:55:09", "text": "について？ H 落胆しないように"}, {"type": "subtitle", "time": 3310.47, "timestamp": "00:55:10", "text": "他人の作品を見る。のように"}, {"type": "subtitle", "time": 3313.19, "timestamp": "00:55:13", "text": "中盤。これらはあなたの"}, {"type": "subtitle", "time": 3315.27, "timestamp": "00:55:15", "text": "モチベーション。悪い仲間だ。どういう意味"}, {"type": "subtitle", "time": 3317.51, "timestamp": "00:55:17", "text": "悪い仲間？あ、しまった。私は何をしたのか、どのように"}, {"type": "subtitle", "time": 3319.43, "timestamp": "00:55:19", "text": "なぜ私はそれをピン留めしたのだろう？なぜ私はピン留めしたのか"}, {"type": "subtitle", "time": 3322.15, "timestamp": "00:55:22", "text": "それ？それを固定するつもりはなかったんです。おっと。"}, {"type": "subtitle", "time": 3323.91, "timestamp": "00:55:23", "text": "持続する。持続する。それは、あなたは"}, {"type": "subtitle", "time": 3325.99, "timestamp": "00:55:25", "text": "それは押さえつけられているわけではない。それは違う"}, {"type": "subtitle", "time": 3327.75, "timestamp": "00:55:27", "text": "押さえつけられている。くそっ。一体何が"}, {"type": "subtitle", "time": 3329.829, "timestamp": "00:55:29", "text": "私はします？俺は何をやらかしたんだ？持続する、"}, {"type": "subtitle", "time": 3332.549, "timestamp": "00:55:32", "text": "チャド。傷だらけだ。"}, {"type": "subtitle", "time": 3336.47, "timestamp": "00:55:36", "text": "ねえ、ジョア、ゆっくりでいいよ。"}, {"type": "subtitle", "time": 3337.829, "timestamp": "00:55:37", "text": "はい、大丈夫です。"}, {"type": "subtitle", "time": 3341.03, "timestamp": "00:55:41", "text": "すべて順調です。すべて順調です。"}, {"type": "subtitle", "time": 3343.349, "timestamp": "00:55:43", "text": "わかった。難しい。難しい。大丈夫。"}, {"type": "subtitle", "time": 3345.99, "timestamp": "00:55:45", "text": "大丈夫。ええ、そうですね。うん。自分の仕事をやりなさい"}, {"type": "subtitle", "time": 3353.43, "timestamp": "00:55:53", "text": "うん。私は、何が"}, {"type": "subtitle", "time": 3356.39, "timestamp": "00:55:56", "text": "あなたの名前の由来は？"}]
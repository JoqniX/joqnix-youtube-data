[{"type": "subtitle", "time": 2605.43, "timestamp": "00:43:25", "text": "つまり、私の息子を虐殺するつもりなのね"}, {"type": "subtitle", "time": 2607.51, "timestamp": "00:43:27", "text": "ジョック。"}, {"type": "subtitle", "time": 2615.51, "timestamp": "00:43:35", "text": "待ってはいけません。それはプロセスを信じることのようなものだ。"}, {"type": "subtitle", "time": 2617.43, "timestamp": "00:43:37", "text": "チャド。プロセスを信じてください。あなたは"}, {"type": "subtitle", "time": 2621.51, "timestamp": "00:43:41", "text": "プロセスを信じてください。わかった。私たちは描いています"}, {"type": "subtitle", "time": 2626.309, "timestamp": "00:43:46", "text": "パンダですよね？パンダ、パンダ。パンダ"}, {"type": "subtitle", "time": 2629.19, "timestamp": "00:43:49", "text": "チャット、信じなきゃいけないよ。あなた"}, {"type": "subtitle", "time": 2630.79, "timestamp": "00:43:50", "text": "信じなければならない。わかった。あなたは"}, {"type": "subtitle", "time": 2634.55, "timestamp": "00:43:54", "text": "信じる。ああ、あの膨らみにはそれが必要なんだ。おお、"}, {"type": "subtitle", "time": 2635.91, "timestamp": "00:43:55", "text": "君には勇気は必要ない。"}, {"type": "subtitle", "time": 2637.109, "timestamp": "00:43:57", "text": "正直に言うと、あなたはできるし、しないし、しない"}, {"type": "subtitle", "time": 2638.79, "timestamp": "00:43:58", "text": "膨らみが必要だ。私はそれを描いています"}]
[{"type": "subtitle", "time": 3542.549, "timestamp": "00:59:02", "text": "うん。でも大丈夫。相変わらず可愛いね。"}, {"type": "subtitle", "time": 3545.51, "timestamp": "00:59:05", "text": "少なくとも、彼らにはその点においてプラスがあった。"}, {"type": "subtitle", "time": 3547.589, "timestamp": "00:59:07", "text": "うん。"}, {"type": "subtitle", "time": 3550.47, "timestamp": "00:59:10", "text": "もちろん、"}, {"type": "subtitle", "time": 3552.789, "timestamp": "00:59:12", "text": "私は管理人になることに抵抗はありません"}, {"type": "subtitle", "time": 3555.67, "timestamp": "00:59:15", "text": "動物園。それはとても楽しい仕事だろうね。私 私 私"}, {"type": "subtitle", "time": 3556.95, "timestamp": "00:59:16", "text": "そこが問題なんです。それが私の望みだった"}, {"type": "subtitle", "time": 3560.069, "timestamp": "00:59:20", "text": "そういうことをするんだけど、ほら、たくさんの"}, {"type": "subtitle", "time": 3562.47, "timestamp": "00:59:22", "text": "いろいろあってできなかったけど、"}, {"type": "subtitle", "time": 3565.51, "timestamp": "00:59:25", "text": "いいよ、いつか海洋学を勉強するかもしれない"}, {"type": "subtitle", "time": 3567.03, "timestamp": "00:59:27", "text": "生物学"}, {"type": "subtitle", "time": 3570.069, "timestamp": "00:59:30", "text": "しかし、その日は今日ではない"}, {"type": "subtitle", "time": 3573.91, "timestamp": "00:59:33", "text": "あるいは、今のところは将来的に。"}, {"type": "subtitle", "time": 3576.71, "timestamp": "00:59:36", "text": "うん。"}, {"type": "subtitle", "time": 3579.51, "timestamp": "00:59:39", "text": "あなたのメガネは何色ですか？"}, {"type": "subtitle", "time": 3581.75, "timestamp": "00:59:41", "text": "えっと"}, {"type": "subtitle", "time": 3589.19, "timestamp": "00:59:49", "text": "何てことだ。どうしてこんなに綺麗なの？"}, {"type": "subtitle", "time": 3591.67, "timestamp": "00:59:51", "text": "A"}, {"type": "subtitle", "time": 3595.03, "timestamp": "00:59:55", "text": "ありがとう、犬。すべては"}, {"type": "subtitle", "time": 3598.39, "timestamp": "00:59:58", "text": "プロセスを信頼する。"}]
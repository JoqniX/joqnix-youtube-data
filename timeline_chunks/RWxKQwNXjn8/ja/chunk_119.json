[{"type": "subtitle", "time": 7141.83, "timestamp": "01:59:01", "text": "お互いの最悪な部分を見抜く。ヨブは"}, {"type": "subtitle", "time": 7146.31, "timestamp": "01:59:06", "text": "私の中には良いところがある。私が言えるのはそれだけです。"}, {"type": "subtitle", "time": 7149.51, "timestamp": "01:59:09", "text": "私たちにはみんな、次のような友達が一人います。"}, {"type": "subtitle", "time": 7151.669, "timestamp": "01:59:11", "text": "あなたがそばにいると、あなたの性格が好きです"}, {"type": "subtitle", "time": 7153.99, "timestamp": "01:59:13", "text": "スイッチを入れると、"}, {"type": "subtitle", "time": 7156.79, "timestamp": "01:59:16", "text": "想像しうる限り最も意地悪な人物。それはRXRです"}, {"type": "subtitle", "time": 7164.709, "timestamp": "01:59:24", "text": "待って、軽口の応酬って喧嘩みたいなものじゃないの？えっと"}, {"type": "subtitle", "time": 7167.99, "timestamp": "01:59:27", "text": "軽口の応酬は喧嘩ではない。軽口は、"}, {"type": "subtitle", "time": 7169.35, "timestamp": "01:59:29", "text": "ほら、行ったり来たりしながら"}, {"type": "subtitle", "time": 7172.79, "timestamp": "01:59:32", "text": "お互い。えっと、冗談は"}, {"type": "subtitle", "time": 7176.629, "timestamp": "01:59:36", "text": "私みたいな人が電話してきたら、えっと、もし"}, {"type": "subtitle", "time": 7178.39, "timestamp": "01:59:38", "text": "誰かがあなたを臭いと呼んでいます"}, {"type": "subtitle", "time": 7180.95, "timestamp": "01:59:40", "text": "あなたをからかうように冗談を言い、"}, {"type": "subtitle", "time": 7186.229, "timestamp": "01:59:46", "text": "もの。そうそう。うん。ジョーはとてもかわいい。"}, {"type": "subtitle", "time": 7199.669, "timestamp": "01:59:59", "text": "少なくとも1回は中盤をいじめなければならない"}]
[{"type": "subtitle", "time": 4022.15, "timestamp": "01:07:02", "text": "漫画。そこにあるから開けてみよう"}, {"type": "subtitle", "time": 4023.829, "timestamp": "01:07:03", "text": "私のTwitterブックマークに保存されています。開けてみましょう"}, {"type": "subtitle", "time": 4025.99, "timestamp": "01:07:05", "text": "別のタブで表示しています。私は自分の"}, {"type": "subtitle", "time": 4033.99, "timestamp": "01:07:13", "text": "チャットチャットは私のTwitterを見ることができません"}, {"type": "subtitle", "time": 4049.75, "timestamp": "01:07:29", "text": "私はそうではありません。それはドクシングとは関係ありません。"}, {"type": "subtitle", "time": 4051.349, "timestamp": "01:07:31", "text": "自分自身。それは戦いに関することだ。私は自由だ。"}, {"type": "subtitle", "time": 4054.309, "timestamp": "01:07:34", "text": "つまり、中にはちょっと辛いものが入っているということですね。"}, {"type": "subtitle", "time": 4058.63, "timestamp": "01:07:38", "text": "そして、私はそれを配信では見せません。"}, {"type": "subtitle", "time": 4060.63, "timestamp": "01:07:40", "text": "そうそう。そうそう。確かに"}, {"type": "subtitle", "time": 4069.43, "timestamp": "01:07:49", "text": "私と私の怪しいブックマークを放っておいてください。そして"}]
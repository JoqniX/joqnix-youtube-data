[{"type": "subtitle", "time": 1744.07, "timestamp": "00:29:04", "text": "待って、いや、これは違う。さらにいくつか"}, {"type": "subtitle", "time": 1747.75, "timestamp": "00:29:07", "text": "黒と白のように。わかった。"}, {"type": "subtitle", "time": 1750.23, "timestamp": "00:29:10", "text": "わかった。サーフィンを描きます"}, {"type": "subtitle", "time": 1751.909, "timestamp": "00:29:11", "text": "文化。"}, {"type": "subtitle", "time": 1753.59, "timestamp": "00:29:13", "text": "この側から絵を描くことができます。"}, {"type": "subtitle", "time": 1755.269, "timestamp": "00:29:15", "text": "こちらの面を描きます。あなたはそれを描き込む"}, {"type": "subtitle", "time": 1756.95, "timestamp": "00:29:16", "text": "側。絵を描いてみよう"}, {"type": "subtitle", "time": 1759.029, "timestamp": "00:29:19", "text": "一緒に。"}, {"type": "subtitle", "time": 1761.43, "timestamp": "00:29:21", "text": "はい。"}, {"type": "subtitle", "time": 1764.389, "timestamp": "00:29:24", "text": "私をとても怠け者にしてください。人間でなければ、"}, {"type": "subtitle", "time": 1766.31, "timestamp": "00:29:26", "text": "存在しなかっただろう。彼らは怠惰すぎる"}, {"type": "subtitle", "time": 1769.029, "timestamp": "00:29:29", "text": "バン。それは本当です。それは本当です。"}, {"type": "subtitle", "time": 1770.789, "timestamp": "00:29:30", "text": "パネルによっては、"}, {"type": "subtitle", "time": 1772.95, "timestamp": "00:29:32", "text": "さらに、繁殖もできる。彼らはただ"}, {"type": "subtitle", "time": 1778.549, "timestamp": "00:29:38", "text": "そうしないと決める。パンダはクレイジーだ。"}, {"type": "subtitle", "time": 1780.47, "timestamp": "00:29:40", "text": "ああ、彼らは、もし私がそのモードを持っていたら、"}, {"type": "subtitle", "time": 1782.71, "timestamp": "00:29:42", "text": "私は自分のパターンと交配するか、"}, {"type": "subtitle", "time": 1790.789, "timestamp": "00:29:50", "text": "どうやって説明すればいいのか全くわかりません"}, {"type": "subtitle", "time": 1793.669, "timestamp": "00:29:53", "text": "バカなパンダもいる。彼らは素晴らしい。私"}, {"type": "subtitle", "time": 1796.47, "timestamp": "00:29:56", "text": "大好きです。"}, {"type": "subtitle", "time": 1798.149, "timestamp": "00:29:58", "text": "わかった。"}]
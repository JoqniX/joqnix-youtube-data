[{"type": "subtitle", "time": 9121.75, "timestamp": "02:32:01", "text": "私たちって、すごくバカみたいに聞こえるよね？"}, {"type": "subtitle", "time": 9127.19, "timestamp": "02:32:07", "text": "愚かな。"}, {"type": "subtitle", "time": 9129.83, "timestamp": "02:32:09", "text": "きっと気に入っていただけると思います。聞いて、聞いて。"}, {"type": "subtitle", "time": 9133.429, "timestamp": "02:32:13", "text": "私は、誰かが話しているのを聞いたことがない、"}, {"type": "subtitle", "time": 9137.349, "timestamp": "02:32:17", "text": "知ってるよ、以前は愚かだった。だから、"}, {"type": "subtitle", "time": 9140.389, "timestamp": "02:32:20", "text": "何も問題ない。"}, {"type": "subtitle", "time": 9143.51, "timestamp": "02:32:23", "text": "YouTubeで見ただけです。わかった。方法"}, {"type": "subtitle", "time": 9145.59, "timestamp": "02:32:25", "text": "代名詞"}, {"type": "subtitle", "time": 9148.389, "timestamp": "02:32:28", "text": "私も同じことを聞かれました。"}, {"type": "subtitle", "time": 9155.11, "timestamp": "02:32:35", "text": "持続する。持続する。私は私は"}, {"type": "subtitle", "time": 9157.19, "timestamp": "02:32:37", "text": "音声なのでチャットも聞こえるので"}, {"type": "subtitle", "time": 9172.63, "timestamp": "02:32:52", "text": "[音楽]"}, {"type": "subtitle", "time": 9174.55, "timestamp": "02:32:54", "text": "わかった。わかった。"}, {"type": "subtitle", "time": 9176.71, "timestamp": "02:32:56", "text": "研磨。"}]
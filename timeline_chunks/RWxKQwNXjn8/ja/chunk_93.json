[{"type": "subtitle", "time": 5582.31, "timestamp": "01:33:02", "text": "絵を描こうとするようなものだ。正直に言うと、"}, {"type": "subtitle", "time": 5584.31, "timestamp": "01:33:04", "text": "何かを学んでいるとき、"}, {"type": "subtitle", "time": 5586.47, "timestamp": "01:33:06", "text": "必ず参考文献を使うべきです。のように"}, {"type": "subtitle", "time": 5587.99, "timestamp": "01:33:07", "text": "これは不正行為とかそういう類のものではありません。その"}, {"type": "subtitle", "time": 5589.91, "timestamp": "01:33:09", "text": "実際には、あなたがすべきことを好きになる"}, {"type": "subtitle", "time": 5591.75, "timestamp": "01:33:11", "text": "する。美術学校でも彼らは"}, {"type": "subtitle", "time": 5593.83, "timestamp": "01:33:13", "text": "いつも同じことを言う"}, {"type": "subtitle", "time": 5595.59, "timestamp": "01:33:15", "text": "参考文献"}, {"type": "subtitle", "time": 5597.83, "timestamp": "01:33:17", "text": "そうでなければ、あなたの解剖学的構造は"}, {"type": "subtitle", "time": 5599.99, "timestamp": "01:33:19", "text": "改善する。"}, {"type": "subtitle", "time": 5601.59, "timestamp": "01:33:21", "text": "うん。"}, {"type": "subtitle", "time": 5604.39, "timestamp": "01:33:24", "text": "参考文献の引用は非常に重要です"}, {"type": "subtitle", "time": 5607.51, "timestamp": "01:33:27", "text": "実際、人々の追跡も"}, {"type": "subtitle", "time": 5609.51, "timestamp": "01:33:29", "text": "重要なツール。あなたは決して"}, {"type": "subtitle", "time": 5613.59, "timestamp": "01:33:33", "text": "トレースしたものを投稿してください。"}, {"type": "subtitle", "time": 5616.39, "timestamp": "01:33:36", "text": "それは、あなたが学ぶ方法の一つです"}, {"type": "subtitle", "time": 5618.31, "timestamp": "01:33:38", "text": "何かをなぞってみる。あなたはそう思わない"}, {"type": "subtitle", "time": 5619.75, "timestamp": "01:33:39", "text": "トレースは絶対に好きじゃない。その"}, {"type": "subtitle", "time": 5621.03, "timestamp": "01:33:41", "text": "商業目的の"}, {"type": "subtitle", "time": 5623.59, "timestamp": "01:33:43", "text": "目的はありますが、それはあなたが"}, {"type": "subtitle", "time": 5629.43, "timestamp": "01:33:49", "text": "自らも学ぶことを選択する。そうそう。"}, {"type": "subtitle", "time": 5632.31, "timestamp": "01:33:52", "text": "芸術とは、多くの場合、反復作業に尽きる。"}, {"type": "subtitle", "time": 5635.189, "timestamp": "01:33:55", "text": "最終的にやり方を理解するまで"}, {"type": "subtitle", "time": 5637.91, "timestamp": "01:33:57", "text": "もの。"}]
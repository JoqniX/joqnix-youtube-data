[{"type": "subtitle", "time": 1560.789, "timestamp": "00:26:00", "text": "何何私が"}, {"type": "subtitle", "time": 1562.63, "timestamp": "00:26:02", "text": "どんな気分ですか？どんなクマが好きですか"}, {"type": "subtitle", "time": 1565.35, "timestamp": "00:26:05", "text": "のように？スポーツマン。さまざまな種類があります"}, {"type": "subtitle", "time": 1567.75, "timestamp": "00:26:07", "text": "クマの。"}, {"type": "subtitle", "time": 1570.31, "timestamp": "00:26:10", "text": "はい。ジョック。ほら、そこには"}, {"type": "subtitle", "time": 1573.83, "timestamp": "00:26:13", "text": "コアラもいるし、パンダもいるし、"}, {"type": "subtitle", "time": 1576.87, "timestamp": "00:26:16", "text": "ホッキョクグマもいるし、スロットマシンもある。"}, {"type": "subtitle", "time": 1581.19, "timestamp": "00:26:21", "text": "クマ。ポ。待って、パンダはクマだよ。おお"}, {"type": "subtitle", "time": 1583.669, "timestamp": "00:26:23", "text": "そう、パンダはクマの一種だ。"}, {"type": "subtitle", "time": 1587.11, "timestamp": "00:26:27", "text": "わかった。マレーグマ、ヒグマ、ナマケグマ、"}, {"type": "subtitle", "time": 1591.11, "timestamp": "00:26:31", "text": "アジアクロクマ、洞窟グマ、クマ、アメリカ"}, {"type": "subtitle", "time": 1593.59, "timestamp": "00:26:33", "text": "クロクマ。おお。"}, {"type": "subtitle", "time": 1596.63, "timestamp": "00:26:36", "text": "うん。おお。わかった。たくさんある"}, {"type": "subtitle", "time": 1603.51, "timestamp": "00:26:43", "text": "少々お待ちください。よし、いいね。うわぁ、すごい。"}, {"type": "subtitle", "time": 1607.909, "timestamp": "00:26:47", "text": "茶色のホッキョクグマ。何てことだ。コーラは"}, {"type": "subtitle", "time": 1609.669, "timestamp": "00:26:49", "text": "クマはいません。"}, {"type": "subtitle", "time": 1611.909, "timestamp": "00:26:51", "text": "なんてクマだ。"}, {"type": "subtitle", "time": 1614.149, "timestamp": "00:26:54", "text": "これはそれを含んでいません。ああ、スロットベア。"}, {"type": "subtitle", "time": 1617.43, "timestamp": "00:26:57", "text": "クマが私たちと一緒にいるのを見ています。 8匹のクマ"}]
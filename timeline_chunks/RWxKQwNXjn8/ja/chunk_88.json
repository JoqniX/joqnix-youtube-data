[{"type": "subtitle", "time": 5284.229, "timestamp": "01:28:04", "text": "まつげなどの細かい部分"}, {"type": "subtitle", "time": 5288.629, "timestamp": "01:28:08", "text": "あるいは、ほんのりとした輝きを添えても良いでしょう。"}, {"type": "subtitle", "time": 5290.229, "timestamp": "01:28:10", "text": "または、ちびキャラを描いていて、それが"}, {"type": "subtitle", "time": 5292.07, "timestamp": "01:28:12", "text": "色のついた目なので、黒ではなく、"}, {"type": "subtitle", "time": 5293.83, "timestamp": "01:28:13", "text": "色自体を使うだけです"}, {"type": "subtitle", "time": 5297.82, "timestamp": "01:28:17", "text": "色を塗りたいんですね。"}, {"type": "subtitle", "time": 5299.59, "timestamp": "01:28:19", "text": "[音楽]"}, {"type": "subtitle", "time": 5310.709, "timestamp": "01:28:30", "text": "青が好きなら"}, {"type": "subtitle", "time": 5326.39, "timestamp": "01:28:46", "text": "そして、そこに白を加えます。そして"}, {"type": "subtitle", "time": 5334.149, "timestamp": "01:28:54", "text": "合意は、実際に人々がボタンを押しているだけだ。"}]
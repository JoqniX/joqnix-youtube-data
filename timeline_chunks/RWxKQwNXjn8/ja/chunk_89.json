[{"type": "subtitle", "time": 5348.95, "timestamp": "01:29:08", "text": "私たちは誰の権利も侵害しません"}, {"type": "subtitle", "time": 5352.94, "timestamp": "01:29:12", "text": "境界線。私たちはただ楽しむためにやっているだけです。"}, {"type": "subtitle", "time": 5355.11, "timestamp": "01:29:15", "text": "[音楽]"}, {"type": "subtitle", "time": 5357.669, "timestamp": "01:29:17", "text": "何てことだ。"}, {"type": "subtitle", "time": 5359.91, "timestamp": "01:29:19", "text": "君の絵を描いているよ。"}, {"type": "subtitle", "time": 5365.27, "timestamp": "01:29:25", "text": "ありがとう。車輪を描いていますか？はい。"}, {"type": "subtitle", "time": 5385.35, "timestamp": "01:29:45", "text": "[音楽]"}, {"type": "subtitle", "time": 5387.11, "timestamp": "01:29:47", "text": "許可を得なければ、それは私たちを破滅させるだろう"}, {"type": "subtitle", "time": 5388.229, "timestamp": "01:29:48", "text": "どうにか。しかし、それは"}, {"type": "subtitle", "time": 5390.79, "timestamp": "01:29:50", "text": "両者にとって驚きだった。その通り。"}, {"type": "subtitle", "time": 5393.43, "timestamp": "01:29:53", "text": "私たちはただ物事をそのままにしておくだけです。"}, {"type": "subtitle", "time": 5395.27, "timestamp": "01:29:55", "text": "風刺をやっているのだから、"}, {"type": "subtitle", "time": 5398.55, "timestamp": "01:29:58", "text": "PG-13 だと思うのは、"}]
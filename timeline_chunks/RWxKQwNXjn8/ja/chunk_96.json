[{"type": "subtitle", "time": 5760.07, "timestamp": "01:36:00", "text": "人とジョギングする人も、"}, {"type": "subtitle", "time": 5761.99, "timestamp": "01:36:01", "text": "自分の時間。"}, {"type": "subtitle", "time": 5764.47, "timestamp": "01:36:04", "text": "うん、"}, {"type": "subtitle", "time": 5766.629, "timestamp": "01:36:06", "text": "だから私は改造して、"}, {"type": "subtitle", "time": 5768.79, "timestamp": "01:36:08", "text": "壊れたとか、何かあったのかも。うん、それはいいことだ。"}, {"type": "subtitle", "time": 5771.03, "timestamp": "01:36:11", "text": "それは良い。あなたが作り続ける限り"}, {"type": "subtitle", "time": 5772.55, "timestamp": "01:36:12", "text": "あなたがきちんと世話をしていることを確認してください"}, {"type": "subtitle", "time": 5774.47, "timestamp": "01:36:14", "text": "自分で、好きなだけストリーミングしてください"}, {"type": "subtitle", "time": 5777.189, "timestamp": "01:36:17", "text": "欲しい。 M"}, {"type": "subtitle", "time": 5780.87, "timestamp": "01:36:20", "text": "でも、病棟を使ったことを後悔しています"}, {"type": "subtitle", "time": 5784.149, "timestamp": "01:36:24", "text": "ストリーム配信をしない方法として、"}, {"type": "subtitle", "time": 5787.51, "timestamp": "01:36:27", "text": "と見なすことができる"}, {"type": "subtitle", "time": 5791.189, "timestamp": "01:36:31", "text": "無視する方法、あるいは何か"}, {"type": "subtitle", "time": 5793.59, "timestamp": "01:36:33", "text": "偽物とかそういう感じ。私はしません"}, {"type": "subtitle", "time": 5796.07, "timestamp": "01:36:36", "text": "ストリームをオンにしたままにする、"}, {"type": "subtitle", "time": 5798.229, "timestamp": "01:36:38", "text": "何か。わからない。つまりそれは"}, {"type": "subtitle", "time": 5800.31, "timestamp": "01:36:40", "text": "私が他の人にも見てきた共通のこと"}, {"type": "subtitle", "time": 5801.91, "timestamp": "01:36:41", "text": "配信者も同じことをする。これは"}, {"type": "subtitle", "time": 5804.709, "timestamp": "01:36:44", "text": "まるで間違ったことをしているかのように。つまり、あなたは"}, {"type": "subtitle", "time": 5806.709, "timestamp": "01:36:46", "text": "あなたは率直に、私は"}, {"type": "subtitle", "time": 5808.47, "timestamp": "01:36:48", "text": "今すぐ休憩を。私はここにいません。これは"}, {"type": "subtitle", "time": 5810.31, "timestamp": "01:36:50", "text": "過去の放送。あなたがそうでない限り"}, {"type": "subtitle", "time": 5812.55, "timestamp": "01:36:52", "text": "ストリーミングしているふりをして、"}, {"type": "subtitle", "time": 5815.109, "timestamp": "01:36:55", "text": "何の問題もないと思う。あなたのような"}, {"type": "subtitle", "time": 5817.43, "timestamp": "01:36:57", "text": "知ってる、そして、私は感じるように"}, {"type": "subtitle", "time": 5819.189, "timestamp": "01:36:59", "text": "それは人々に、ほら、"}]
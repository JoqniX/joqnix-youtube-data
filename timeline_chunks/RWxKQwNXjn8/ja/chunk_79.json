[{"type": "subtitle", "time": 4741.11, "timestamp": "01:19:01", "text": "私のタブレットで。"}, {"type": "subtitle", "time": 4743.91, "timestamp": "01:19:03", "text": "なぜ"}, {"type": "subtitle", "time": 4747.59, "timestamp": "01:19:07", "text": "そういうことは時々起こる。"}, {"type": "subtitle", "time": 4751.75, "timestamp": "01:19:11", "text": "私は、"}, {"type": "subtitle", "time": 4754.63, "timestamp": "01:19:14", "text": "もっと魚の絵のアイデアを描いてみましょう。あなた"}, {"type": "subtitle", "time": 4764.07, "timestamp": "01:19:24", "text": "私はジョックを魚として描くことができる。"}]
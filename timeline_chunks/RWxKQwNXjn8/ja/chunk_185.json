[{"type": "subtitle", "time": 11101.11, "timestamp": "03:05:01", "text": "キラー。ええと、あの、"}, {"type": "subtitle", "time": 11104.07, "timestamp": "03:05:04", "text": "肉屋。あなたのニックネームは何ですか？"}, {"type": "subtitle", "time": 11110.469, "timestamp": "03:05:10", "text": "異質な"}, {"type": "subtitle", "time": 11112.95, "timestamp": "03:05:12", "text": "無地。いいえ、私たちはそれが必要です、それはそれが必要です"}, {"type": "subtitle", "time": 11116.469, "timestamp": "03:05:16", "text": "恐怖を与える。"}, {"type": "subtitle", "time": 11119.429, "timestamp": "03:05:19", "text": "私は星座なのよ。つまりあなたは"}, {"type": "subtitle", "time": 11123.83, "timestamp": "03:05:23", "text": "星座。うん。それで"}, {"type": "subtitle", "time": 11125.51, "timestamp": "03:05:25", "text": "悲しいことに、ゾディアックキラーは"}, {"type": "subtitle", "time": 11133.59, "timestamp": "03:05:33", "text": "[音楽]"}, {"type": "subtitle", "time": 11136.79, "timestamp": "03:05:36", "text": "いいえ、新しいモデルは、"}, {"type": "subtitle", "time": 11140.469, "timestamp": "03:05:40", "text": "ラスボス。それで、ああ、"}, {"type": "subtitle", "time": 11142.63, "timestamp": "03:05:42", "text": "何てことだ。私たちはそれを"}]
[{"type": "subtitle", "time": 3601.589, "timestamp": "01:00:01", "text": "おお。待って、あなたはそれをやっているの？"}, {"type": "subtitle", "time": 3604.549, "timestamp": "01:00:04", "text": "ガラスの曇り加工方法"}, {"type": "subtitle", "time": 3606.63, "timestamp": "01:00:06", "text": "低い不透明度で、その後増加します"}, {"type": "subtitle", "time": 3609.43, "timestamp": "01:00:09", "text": "不透明度。とても良さそうですね。"}, {"type": "subtitle", "time": 3612.309, "timestamp": "01:00:12", "text": "そんな感じですね。私は絵を描くのが好きです"}, {"type": "subtitle", "time": 3613.829, "timestamp": "01:00:13", "text": "たいてい。"}, {"type": "subtitle", "time": 3616.789, "timestamp": "01:00:16", "text": "ああ、そうそう、私は自分の絵を描くのが好きなんです"}, {"type": "subtitle", "time": 3618.95, "timestamp": "01:00:18", "text": "絵がまるで絵画のように描かれている"}, {"type": "subtitle", "time": 3620.95, "timestamp": "01:00:20", "text": "最後の部屋にあったアザラシの脳の一つ。"}, {"type": "subtitle", "time": 3624.63, "timestamp": "01:00:24", "text": "はい、あなたは理解していないと思います"}, {"type": "subtitle", "time": 3628.71, "timestamp": "01:00:28", "text": "BuraをRXRと一緒にストリーミング配信していた"}, {"type": "subtitle", "time": 3631.19, "timestamp": "01:00:31", "text": "そして、私は年寄りが嫌いだと言わせてください"}, {"type": "subtitle", "time": 3633.67, "timestamp": "01:00:33", "text": "彼と一緒に配信した後、人々はそう思った。ああ、"}, {"type": "subtitle", "time": 3637.589, "timestamp": "01:00:37", "text": "あのクソガキめ"}, {"type": "subtitle", "time": 3641.109, "timestamp": "01:00:41", "text": "私たちは友達なので、私は"}, {"type": "subtitle", "time": 3643.19, "timestamp": "01:00:43", "text": "彼をからかう。"}, {"type": "subtitle", "time": 3644.71, "timestamp": "01:00:44", "text": "H"}, {"type": "subtitle", "time": 3648.069, "timestamp": "01:00:48", "text": "でもああ、なんてことだ、私の脳細胞は全部死んでしまった"}, {"type": "subtitle", "time": 3651.67, "timestamp": "01:00:51", "text": "そのゲームをプレイする"}, {"type": "subtitle", "time": 3653.51, "timestamp": "01:00:53", "text": "あなたもプレイしていたのを見ましたよね？"}, {"type": "subtitle", "time": 3657.109, "timestamp": "01:00:57", "text": "アーサンクスと一緒にプレイしましたか？"}, {"type": "subtitle", "time": 3659.349, "timestamp": "01:00:59", "text": "1"}]
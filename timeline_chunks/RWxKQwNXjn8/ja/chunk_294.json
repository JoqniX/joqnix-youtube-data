[{"type": "subtitle", "time": 17641.59, "timestamp": "04:54:01", "text": "こんにちは。拡散性。次はスマイリーフェイスです"}, {"type": "subtitle", "time": 17644.948, "timestamp": "04:54:04", "text": "舌で。 Cドット。待って。私に"}, {"type": "subtitle", "time": 17648.55, "timestamp": "04:54:08", "text": "2番。一人ずつ。"}, {"type": "subtitle", "time": 17651.83, "timestamp": "04:54:11", "text": "最後から2番目の呼び出しです。いいえ、"}, {"type": "subtitle", "time": 17653.27, "timestamp": "04:54:13", "text": "モードは2種類あります。それが理由です"}, {"type": "subtitle", "time": 17655.83, "timestamp": "04:54:15", "text": "質問しているんです。時間をください。こんにちは。えっと、それで"}, {"type": "subtitle", "time": 17657.83, "timestamp": "04:54:17", "text": "舌を出した笑顔の絵文字ですよね？うん。 C"}, {"type": "subtitle", "time": 17661.67, "timestamp": "04:54:21", "text": "ドットトライデント。 Cドットトライデント。トライデント。そして"}, {"type": "subtitle", "time": 17666.628, "timestamp": "04:54:26", "text": "えーと、反転したピーク。うん。えっと、"}, {"type": "subtitle", "time": 17672.15, "timestamp": "04:54:32", "text": "トライデント。こんにちは。笑顔の顔文字。笑顔の顔文字。 C"}, {"type": "subtitle", "time": 17681.75, "timestamp": "04:54:41", "text": "おお。ニース。"}, {"type": "subtitle", "time": 17685.03, "timestamp": "04:54:45", "text": "皮をむいた。あ、待って。実際に押した"}, {"type": "subtitle", "time": 17689.83, "timestamp": "04:54:49", "text": "ボタンを押してストライクを出した。大丈夫ですか？"}, {"type": "subtitle", "time": 17691.91, "timestamp": "04:54:51", "text": "待って。そうそう。気にしません。一度もない"}, {"type": "subtitle", "time": 17693.75, "timestamp": "04:54:53", "text": "心。うん、大丈夫だよ。待って、爆弾は"}, {"type": "subtitle", "time": 17697.83, "timestamp": "04:54:57", "text": "まだ続いているの？いいえ、拡散しました。えっと"}, {"type": "subtitle", "time": 17699.99, "timestamp": "04:54:59", "text": "ほら、拡散した後、私はただ"}]
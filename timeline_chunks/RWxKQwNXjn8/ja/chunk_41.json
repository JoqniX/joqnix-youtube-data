[{"type": "subtitle", "time": 2460.47, "timestamp": "00:41:00", "text": "フォローありがとうございます。えっと、Qさん、ありがとうと言ってください"}, {"type": "subtitle", "time": 2462.15, "timestamp": "00:41:02", "text": "あなた。"}, {"type": "subtitle", "time": 2464.55, "timestamp": "00:41:04", "text": "やったー。"}, {"type": "subtitle", "time": 2472.71, "timestamp": "00:41:12", "text": "脂肪。太ったピカチュウを見たことがありますか？チョーク。"}, {"type": "subtitle", "time": 2475.829, "timestamp": "00:41:15", "text": "いいえ。ファットピカチュウをご覧になっていないのですか？の"}, {"type": "subtitle", "time": 2478.55, "timestamp": "00:41:18", "text": "史上最高のピカチュウ？"}, {"type": "subtitle", "time": 2483.75, "timestamp": "00:41:23", "text": "いや。ああ、なんてことだ。うん、"}, {"type": "subtitle", "time": 2487.75, "timestamp": "00:41:27", "text": "私の広告の表示が遅いのはおかしい。"}, {"type": "subtitle", "time": 2490.87, "timestamp": "00:41:30", "text": "セクシーなパンダが見える。ママはお腹が空いた。何"}, {"type": "subtitle", "time": 2510.15, "timestamp": "00:41:50", "text": "彼女はとても落ち着いているので、お尻でさえも。それは"}, {"type": "subtitle", "time": 2513.75, "timestamp": "00:41:53", "text": "私のせいではない。広告は私のせいではありません。"}]
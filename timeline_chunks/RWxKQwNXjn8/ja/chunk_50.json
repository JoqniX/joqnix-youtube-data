[{"type": "subtitle", "time": 3029.03, "timestamp": "00:50:29", "text": "えっと、これって不透明ですか？そこには"}, {"type": "subtitle", "time": 3032.63, "timestamp": "00:50:32", "text": "そうではない。そこにいると思う"}, {"type": "subtitle", "time": 3034.15, "timestamp": "00:50:34", "text": "そこにいる人々は、あなたが思うような子供たちですか"}, {"type": "subtitle", "time": 3036.23, "timestamp": "00:50:36", "text": "殺す。よくも私の死者を口にしたな"}, {"type": "subtitle", "time": 3038.15, "timestamp": "00:50:38", "text": "娘たち？"}, {"type": "subtitle", "time": 3043.27, "timestamp": "00:50:43", "text": "何？何てことだ。わかった、話そう。私は持っていた"}, {"type": "subtitle", "time": 3045.75, "timestamp": "00:50:45", "text": "娘が何人もいるのよ、いい？そして彼らは"}, {"type": "subtitle", "time": 3048.549, "timestamp": "00:50:48", "text": "全員マインクラフトで死んだ。"}, {"type": "subtitle", "time": 3050.549, "timestamp": "00:50:50", "text": "ああ、マインクラフト。わかった。すべての"}, {"type": "subtitle", "time": 3052.549, "timestamp": "00:50:52", "text": "私がMinecraftで育てた娘は"}, {"type": "subtitle", "time": 3054.23, "timestamp": "00:50:54", "text": "死にかけている。そして、わからないけど、"}, {"type": "subtitle", "time": 3056.23, "timestamp": "00:50:56", "text": "鉄製の部品の一つはサーバーだったんですよね？のように"}, {"type": "subtitle", "time": 3058.95, "timestamp": "00:50:58", "text": "私たちが使っているサーバーは、彼女が亡くなりました。彼女は"}]
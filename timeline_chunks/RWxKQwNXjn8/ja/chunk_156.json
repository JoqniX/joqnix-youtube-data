[{"type": "subtitle", "time": 9361.349, "timestamp": "02:36:01", "text": "私の口はこのような形をしています。行く"}, {"type": "subtitle", "time": 9363.349, "timestamp": "02:36:03", "text": "このような。"}, {"type": "subtitle", "time": 9366.63, "timestamp": "02:36:06", "text": "つまり、私はバカではない、"}, {"type": "subtitle", "time": 9368.309, "timestamp": "02:36:08", "text": "わかった？私はこれをやっていない"}, {"type": "subtitle", "time": 9372.07, "timestamp": "02:36:12", "text": "目的。私は、実際には話すことができません"}, {"type": "subtitle", "time": 9374.55, "timestamp": "02:36:14", "text": "きちんと。"}, {"type": "subtitle", "time": 9376.63, "timestamp": "02:36:16", "text": "おばあちゃんと一緒にドラマをいくつか観た。"}, {"type": "subtitle", "time": 9388.469, "timestamp": "02:36:28", "text": "誓います、誓います、誓います、つまりそれは"}, {"type": "subtitle", "time": 9397.67, "timestamp": "02:36:37", "text": "ああ、ジョー。私は思う 私は思う 私は思う 私は思う"}, {"type": "subtitle", "time": 9399.67, "timestamp": "02:36:39", "text": "私たちは国全体を怒らせた"}, {"type": "subtitle", "time": 9402.79, "timestamp": "02:36:42", "text": "ポーランド。なんてこった、"}, {"type": "subtitle", "time": 9404.309, "timestamp": "02:36:44", "text": "ジョン。私たちは行けないと思います"}, {"type": "subtitle", "time": 9407.75, "timestamp": "02:36:47", "text": "もはやポーランドではない。何てことだ。私はそうは思わない"}, {"type": "subtitle", "time": 9410.07, "timestamp": "02:36:50", "text": "もうポーランドには行けないと思う。おお"}, {"type": "subtitle", "time": 9413.83, "timestamp": "02:36:53", "text": "いいえ。うん。いいえ、それは、それは、それは、それはオフです"}, {"type": "subtitle", "time": 9415.429, "timestamp": "02:36:55", "text": "やりたいことリスト。バケツから落ちた"}, {"type": "subtitle", "time": 9417.349, "timestamp": "02:36:57", "text": "リスト。"}, {"type": "subtitle", "time": 9419.91, "timestamp": "02:36:59", "text": "ああ、それはまずい。 1つってどういう意味ですか？"}]
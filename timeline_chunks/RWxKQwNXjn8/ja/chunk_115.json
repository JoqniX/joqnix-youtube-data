[{"type": "subtitle", "time": 6902.39, "timestamp": "01:55:02", "text": "今、このゲームを始めたところです。"}, {"type": "subtitle", "time": 6906.31, "timestamp": "01:55:06", "text": "だから、私は何も知らないけど、カルタを手に入れた。"}, {"type": "subtitle", "time": 6908.709, "timestamp": "01:55:08", "text": "彼女の名前はどのように発音しますか？カルタ。"}, {"type": "subtitle", "time": 6912.31, "timestamp": "01:55:12", "text": "待って、あの金髪の女の子が戻ってきた。"}, {"type": "subtitle", "time": 6922.07, "timestamp": "01:55:22", "text": "悪い。なぜ？つまり、赤毛の女の子は"}, {"type": "subtitle", "time": 6923.91, "timestamp": "01:55:23", "text": "去った。"}, {"type": "subtitle", "time": 6926.31, "timestamp": "01:55:26", "text": "そう、あの赤毛の女だ。ああ、彼女はもういないよ。私"}, {"type": "subtitle", "time": 6929.03, "timestamp": "01:55:29", "text": "彼女を捕まえられなかった。ああ、カルタタが脱落した。"}, {"type": "subtitle", "time": 6931.99, "timestamp": "01:55:31", "text": "そうそう。"}, {"type": "subtitle", "time": 6935.43, "timestamp": "01:55:35", "text": "では、次は誰だ？"}, {"type": "subtitle", "time": 6938.149, "timestamp": "01:55:38", "text": "今はルパです。"}, {"type": "subtitle", "time": 6949.589, "timestamp": "01:55:49", "text": "はい、sh に復帰しました。うん"}]
[{"type": "subtitle", "time": 15786.71, "timestamp": "04:23:06", "text": "ファンシー。"}, {"type": "subtitle", "time": 15788.79, "timestamp": "04:23:08", "text": "わかった。"}, {"type": "subtitle", "time": 15792.309, "timestamp": "04:23:12", "text": "皆さん、ピクルスはお好きですか？"}, {"type": "subtitle", "time": 15796.469, "timestamp": "04:23:16", "text": "なぜ自分がピクルス好きなのか、自分でもよくわからない。"}, {"type": "subtitle", "time": 15799.11, "timestamp": "04:23:19", "text": "ピクルスを見たら、"}, {"type": "subtitle", "time": 15802.71, "timestamp": "04:23:22", "text": "例えば、500グラムのピクルスを買ったとしましょう。"}, {"type": "subtitle", "time": 15807.67, "timestamp": "04:23:27", "text": "わかった？私がそれを完成させるのを見て、1日か"}, {"type": "subtitle", "time": 15810.309, "timestamp": "04:23:30", "text": "おそらく数時間程度でしょう。"}, {"type": "subtitle", "time": 15812.55, "timestamp": "04:23:32", "text": "私はそれくらい中毒です"}, {"type": "subtitle", "time": 15815.349, "timestamp": "04:23:35", "text": "あらゆる種類のピクルスと同じように。"}, {"type": "subtitle", "time": 15817.83, "timestamp": "04:23:37", "text": "わからない。うん、スパイス"}, {"type": "subtitle", "time": 15820.389, "timestamp": "04:23:40", "text": "ピクルスは人間に似ていて、"}, {"type": "subtitle", "time": 15824.149, "timestamp": "04:23:44", "text": "少しだけ持っているとき"}, {"type": "subtitle", "time": 15827.03, "timestamp": "04:23:47", "text": "ビリヤニか何かを食べている"}, {"type": "subtitle", "time": 15830.71, "timestamp": "04:23:50", "text": "えっと、今食べているのは食事ですよね？"}, {"type": "subtitle", "time": 15833.75, "timestamp": "04:23:53", "text": "なぜ好きなのか、自分でもわからない。"}]
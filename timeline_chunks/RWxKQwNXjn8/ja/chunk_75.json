[{"type": "subtitle", "time": 4504.39, "timestamp": "01:15:04", "text": "とてもかわいい。"}, {"type": "subtitle", "time": 4507.59, "timestamp": "01:15:07", "text": "ちょっとスポーツマンっぽい子だ。"}, {"type": "subtitle", "time": 4514.79, "timestamp": "01:15:14", "text": "やったー。絵を描こう"}, {"type": "subtitle", "time": 4527.99, "timestamp": "01:15:27", "text": "君をポソムみたいに描いたのを覚えてるよ。"}, {"type": "subtitle", "time": 4529.669, "timestamp": "01:15:29", "text": "まるで鉄の塊を描いているみたいだ"}, {"type": "subtitle", "time": 4531.59, "timestamp": "01:15:31", "text": "ユーチューバーをオポッサムに見立てて。覚えているよ"}, {"type": "subtitle", "time": 4544.79, "timestamp": "01:15:44", "text": "それはすごいね。"}, {"type": "subtitle", "time": 4552.63, "timestamp": "01:15:52", "text": "あなたはチョークで字を書きますか？"}, {"type": "subtitle", "time": 4555.35, "timestamp": "01:15:55", "text": "あなたは文章を書きますか？あなたは文章を書くのが好きですか？"}, {"type": "subtitle", "time": 4557.83, "timestamp": "01:15:57", "text": "チョーク？"}]
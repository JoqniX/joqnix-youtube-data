[{"type": "subtitle", "time": 10921.83, "timestamp": "03:02:01", "text": "京都の家だよ、いい？ダジャレ漫画のような"}, {"type": "subtitle", "time": 10924.63, "timestamp": "03:02:04", "text": "詐欺ですよね？そして彼らは皆、そしてあなたも"}, {"type": "subtitle", "time": 10927.91, "timestamp": "03:02:07", "text": "ムラがバスで行った時、私はまるで自分がそうだったかのように感じた。私"}, {"type": "subtitle", "time": 10929.429, "timestamp": "03:02:09", "text": "彼に連絡してみようと思ったんだ。「やあ」って感じで。"}, {"type": "subtitle", "time": 10931.19, "timestamp": "03:02:11", "text": "大丈夫？"}, {"type": "subtitle", "time": 10933.269, "timestamp": "03:02:13", "text": "そうそう、私たちは話したよね。すべて"}, {"type": "subtitle", "time": 10936.469, "timestamp": "03:02:16", "text": "ナイスは、すべてが甘くて素晴らしかった。それから私は"}, {"type": "subtitle", "time": 10939.75, "timestamp": "03:02:19", "text": "ぞっとする。私はVCに所属しています。突然、私は"}, {"type": "subtitle", "time": 10943.75, "timestamp": "03:02:23", "text": "ムラからの慌てたボイスメールが"}, {"type": "subtitle", "time": 10948.23, "timestamp": "03:02:28", "text": "「おいおい、ジョーはジョーは行くんだ」"}, {"type": "subtitle", "time": 10951.269, "timestamp": "03:02:31", "text": "クレイジー。彼は人を殺している。ジョーは"}, {"type": "subtitle", "time": 10953.99, "timestamp": "03:02:33", "text": "彼は皆を殺しに行くつもりだ。"}, {"type": "subtitle", "time": 10957.11, "timestamp": "03:02:37", "text": "命の危険さえ感じていたんだ。"}, {"type": "subtitle", "time": 10960.87, "timestamp": "03:02:40", "text": "「おい、どうしたんだ？」みたいな感じ。そして私は"}, {"type": "subtitle", "time": 10963.75, "timestamp": "03:02:43", "text": "この慌てた声を聞きなさい、"}, {"type": "subtitle", "time": 10966.71, "timestamp": "03:02:46", "text": "でも、イオーンはすごく怖がっている。彼は"}, {"type": "subtitle", "time": 10969.349, "timestamp": "03:02:49", "text": "彼は眠っている間に亡くなった。彼は死ぬために"}, {"type": "subtitle", "time": 10971.99, "timestamp": "03:02:51", "text": "彼の睡眠だよ。何てことだ。ジョックは行く"}, {"type": "subtitle", "time": 10975.269, "timestamp": "03:02:55", "text": "全員を殺す。"}, {"type": "subtitle", "time": 10977.75, "timestamp": "03:02:57", "text": "私はしません。彼らは「Jはあなたが"}]
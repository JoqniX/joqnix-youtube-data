[{"type": "subtitle", "time": 4929.51, "timestamp": "01:22:09", "text": "良い？完璧。"}, {"type": "subtitle", "time": 4934.95, "timestamp": "01:22:14", "text": "ニャー。ディオ。ニャー。ディオ。はい。"}, {"type": "subtitle", "time": 4937.27, "timestamp": "01:22:17", "text": "私がスポーツマンについて考えるとき、"}, {"type": "subtitle", "time": 4940.55, "timestamp": "01:22:20", "text": "考えられるのはディオだけだ。"}, {"type": "subtitle", "time": 4942.39, "timestamp": "01:22:22", "text": "そしていつでも"}, {"type": "subtitle", "time": 4945.03, "timestamp": "01:22:25", "text": "誰かがディオと言うと、私はただ"}, {"type": "subtitle", "time": 4951.75, "timestamp": "01:22:31", "text": "いや、違うよ。ディオ、なぜ死なないんだ？"}, {"type": "subtitle", "time": 4959.43, "timestamp": "01:22:39", "text": "エンドウ豆はいくらですか？飲みたい"}, {"type": "subtitle", "time": 4961.27, "timestamp": "01:22:41", "text": "自分？あなたは私を飲むことはできません。あなたはできません"}, {"type": "subtitle", "time": 4963.83, "timestamp": "01:22:43", "text": "私の瓶を買う余裕がある。そして、もしあなたが話しているなら"}, {"type": "subtitle", "time": 4966.55, "timestamp": "01:22:46", "text": "モデルを買うようなものだと思う"}, {"type": "subtitle", "time": 4974.07, "timestamp": "01:22:54", "text": "よし、スポーツマンを描く時間だ"}, {"type": "subtitle", "time": 4976.79, "timestamp": "01:22:56", "text": "魚。"}, {"type": "subtitle", "time": 4979.669, "timestamp": "01:22:59", "text": "うわあ、本気でやってるんだね？"}]
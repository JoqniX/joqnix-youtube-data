[{"type": "subtitle", "time": 8403.429, "timestamp": "02:20:03", "text": "それはいいですね。うん。私は"}, {"type": "subtitle", "time": 8406.15, "timestamp": "02:20:06", "text": "少なくとも今年は、もし私が"}, {"type": "subtitle", "time": 8408.309, "timestamp": "02:20:08", "text": "来月日本に行く必要がある"}, {"type": "subtitle", "time": 8410.87, "timestamp": "02:20:10", "text": "誕生日を一人で祝う。しかし"}, {"type": "subtitle", "time": 8414.309, "timestamp": "02:20:14", "text": "今回は延長があったので"}, {"type": "subtitle", "time": 8416.55, "timestamp": "02:20:16", "text": "4月まで。私には時間があると思う"}, {"type": "subtitle", "time": 8419.19, "timestamp": "02:20:19", "text": "皆と一緒にお祝いしたい年です。"}, {"type": "subtitle", "time": 8421.27, "timestamp": "02:20:21", "text": "何てことだ。私たちは、"}, {"type": "subtitle", "time": 8424.79, "timestamp": "02:20:24", "text": "冗談の誕生日祝い？"}, {"type": "subtitle", "time": 8428.79, "timestamp": "02:20:28", "text": "ええ、そう思います。うん。何てことだ。"}, {"type": "subtitle", "time": 8430.79, "timestamp": "02:20:30", "text": "よくもカレーなんて言えたもんだ。カレー。カレー。"}, {"type": "subtitle", "time": 8432.63, "timestamp": "02:20:32", "text": "カリーの言っていることは全く意味不明だ。カレー"}, {"type": "subtitle", "time": 8435.75, "timestamp": "02:20:35", "text": "カレーを英語で言うと「Oh my god」です。"}, {"type": "subtitle", "time": 8439.349, "timestamp": "02:20:39", "text": "チャド。チャド。規律が必要だ。"}, {"type": "subtitle", "time": 8442.07, "timestamp": "02:20:42", "text": "ああ、それはイエローカレーという名前です。"}, {"type": "subtitle", "time": 8444.07, "timestamp": "02:20:44", "text": "イエローカレー。"}, {"type": "subtitle", "time": 8445.91, "timestamp": "02:20:45", "text": "ああ、弟はあまり好きじゃない"}, {"type": "subtitle", "time": 8447.27, "timestamp": "02:20:47", "text": "黄色いカレーは好きではないので"}, {"type": "subtitle", "time": 8450.469, "timestamp": "02:20:50", "text": "凝乳が多すぎる。"}, {"type": "subtitle", "time": 8452.71, "timestamp": "02:20:52", "text": "うん。でも、私はイエローカレーが大好きなんです。のように"}, {"type": "subtitle", "time": 8454.79, "timestamp": "02:20:54", "text": "一般的に私たちは、あなたと一緒にそれをします"}, {"type": "subtitle", "time": 8458.55, "timestamp": "02:20:58", "text": "パコラを知っておく。"}]
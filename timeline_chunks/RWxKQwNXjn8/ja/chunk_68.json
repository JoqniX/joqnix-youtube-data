[{"type": "subtitle", "time": 4082.069, "timestamp": "01:08:02", "text": "私はあなたたちには教えません。君たち"}, {"type": "subtitle", "time": 4083.91, "timestamp": "01:08:03", "text": "私の好みを知ることは決してないだろう。"}, {"type": "subtitle", "time": 4085.99, "timestamp": "01:08:05", "text": "わかった。まあ、必要なのは"}, {"type": "subtitle", "time": 4088.95, "timestamp": "01:08:08", "text": "知ってるよ、私は熱いのが好き、強いのが好き"}, {"type": "subtitle", "time": 4096.55, "timestamp": "01:08:16", "text": "ジョーにとって悪影響を与える存在。私は良い"}, {"type": "subtitle", "time": 4099.189, "timestamp": "01:08:19", "text": "影響力、ですよね？"}, {"type": "subtitle", "time": 4101.51, "timestamp": "01:08:21", "text": "あなたは何をしましたか？私は良い"}, {"type": "subtitle", "time": 4104.47, "timestamp": "01:08:24", "text": "あなたに影響を与えている、そうでしょう？"}, {"type": "subtitle", "time": 4106.789, "timestamp": "01:08:26", "text": "わからない。つまり、あなたは優秀だということです。"}, {"type": "subtitle", "time": 4109.749, "timestamp": "01:08:29", "text": "あなたは良い友達です。ほら、ほら、[ __ ]"}, {"type": "subtitle", "time": 4111.51, "timestamp": "01:08:31", "text": "あなた、チャット。君たち、君たちはとても"}, {"type": "subtitle", "time": 4114.07, "timestamp": "01:08:34", "text": "私にとって意味する。しかし、それがこの漫画なのです"}, {"type": "subtitle", "time": 4118.229, "timestamp": "01:08:38", "text": "私は自分がどうなのかについて作った。うん、送った"}, {"type": "subtitle", "time": 4133.669, "timestamp": "01:08:53", "text": "A：なぜあなたはキツネであり、クジラでもあるのですか？マーク。"}, {"type": "subtitle", "time": 4136.709, "timestamp": "01:08:56", "text": "何てことだ。私は伝説のクジラのジブを倒した。"}, {"type": "subtitle", "time": 4139.11, "timestamp": "01:08:59", "text": "それは私です。"}]
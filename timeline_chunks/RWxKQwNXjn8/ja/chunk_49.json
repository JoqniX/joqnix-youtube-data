[{"type": "subtitle", "time": 2947.829, "timestamp": "00:49:07", "text": "ごめんね、君の想像を"}, {"type": "subtitle", "time": 2950.15, "timestamp": "00:49:10", "text": "子供は悲しんでいる。私の子供ではありません。そうではありません"}, {"type": "subtitle", "time": 2952.15, "timestamp": "00:49:12", "text": "私の子供だけど、あなたは子供を悲しませている。"}, {"type": "subtitle", "time": 2954.15, "timestamp": "00:49:14", "text": "それについてどう思いますか？はぁ？あなたは"}, {"type": "subtitle", "time": 2959.67, "timestamp": "00:49:19", "text": "子供をいじめること。子供をいじめた。"}, {"type": "subtitle", "time": 2961.91, "timestamp": "00:49:21", "text": "ひどいじゃないか。いじめをしてはいけない"}, {"type": "subtitle", "time": 2981.43, "timestamp": "00:49:41", "text": "わかった。そうです。実際そうなんです。そうです"}, {"type": "subtitle", "time": 2983.349, "timestamp": "00:49:43", "text": "かなりひどい見た目だ。でも、まるで"}, {"type": "subtitle", "time": 2985.589, "timestamp": "00:49:45", "text": "子供をいじめること。わかった。あなたはいじめをしている"}, {"type": "subtitle", "time": 2987.589, "timestamp": "00:49:47", "text": "子供。あなたは子供をいじめた。あなたがすべき"}, {"type": "subtitle", "time": 2990.23, "timestamp": "00:49:50", "text": "自分自身を恥じる。わかった。あなた"}, {"type": "subtitle", "time": 2992.47, "timestamp": "00:49:52", "text": "恥ずかしく、悲しく、"}, {"type": "subtitle", "time": 2994.309, "timestamp": "00:49:54", "text": "堕胎薬。"}]
[{"type": "subtitle", "time": 2402.23, "timestamp": "00:40:02", "text": "セレストの料理を見たことがないの？"}, {"type": "subtitle", "time": 2406.23, "timestamp": "00:40:06", "text": "ストリーム？いいえ。絶対に見てはいけない。あなた"}, {"type": "subtitle", "time": 2408.39, "timestamp": "00:40:08", "text": "あなたは決してできないと思います"}, {"type": "subtitle", "time": 2414.79, "timestamp": "00:40:14", "text": "世界で私を好きにさせたものは何もない"}, {"type": "subtitle", "time": 2417.51, "timestamp": "00:40:17", "text": "実際には吐き気がしたが、私は"}, {"type": "subtitle", "time": 2419.67, "timestamp": "00:40:19", "text": "セレストの料理配信を見て"}, {"type": "subtitle", "time": 2423.03, "timestamp": "00:40:23", "text": "内心ちょっと吐いてしまった。"}, {"type": "subtitle", "time": 2424.55, "timestamp": "00:40:24", "text": "何てことだ。"}, {"type": "subtitle", "time": 2429.43, "timestamp": "00:40:29", "text": "うん。あと、私はカイラではありません。それから、えーと、"}, {"type": "subtitle", "time": 2431.43, "timestamp": "00:40:31", "text": "私たちは力を合わせています。私は"}, {"type": "subtitle", "time": 2434.71, "timestamp": "00:40:34", "text": "Jに、自分自身をパンダとして描く方法を教える。"}, {"type": "subtitle", "time": 2436.63, "timestamp": "00:40:36", "text": "うん。"}, {"type": "subtitle", "time": 2439.829, "timestamp": "00:40:39", "text": "わかった。もう終わりだ。"}, {"type": "subtitle", "time": 2443.99, "timestamp": "00:40:43", "text": "それでは、これからあなたの鼻を描いていきます。"}, {"type": "subtitle", "time": 2445.91, "timestamp": "00:40:45", "text": "だから、かわいいものがあれば"}, {"type": "subtitle", "time": 2447.51, "timestamp": "00:40:47", "text": "可愛らしい小さな鼻。あなたは、あなたは、あなたは"}, {"type": "subtitle", "time": 2450.55, "timestamp": "00:40:50", "text": "小さなパンダ。"}, {"type": "subtitle", "time": 2453.19, "timestamp": "00:40:53", "text": "だから、ただプロセスを信じてください。私たちは行く"}, {"type": "subtitle", "time": 2456.15, "timestamp": "00:40:56", "text": "少し絵を描いてみる。"}]
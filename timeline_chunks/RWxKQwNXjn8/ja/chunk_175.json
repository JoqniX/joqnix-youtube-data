[{"type": "subtitle", "time": 10505.59, "timestamp": "02:55:05", "text": "90K地点では何が起こるんでしたっけ？いいえ、私は"}, {"type": "subtitle", "time": 10508.469, "timestamp": "02:55:08", "text": "チャットでVIP権限を付与します。それが"}, {"type": "subtitle", "time": 10510.23, "timestamp": "02:55:10", "text": "起こる。"}, {"type": "subtitle", "time": 10513.429, "timestamp": "02:55:13", "text": "あと、私の時間では午前2時です。何てことだ。"}, {"type": "subtitle", "time": 10516.63, "timestamp": "02:55:16", "text": "蓋の上にピザ。全体"}, {"type": "subtitle", "time": 10518.71, "timestamp": "02:55:18", "text": "君たちは"}, {"type": "subtitle", "time": 10521.03, "timestamp": "02:55:21", "text": "瓶。あなたは触れることができません"}, {"type": "subtitle", "time": 10525.11, "timestamp": "02:55:25", "text": "瓶。ひどいチャットだった。悪い。悪い。"}, {"type": "subtitle", "time": 10527.59, "timestamp": "02:55:27", "text": "それは悪い会話だ。"}, {"type": "subtitle", "time": 10531.03, "timestamp": "02:55:31", "text": "行儀よくしなさい。私は、私は、それだけです。"}, {"type": "subtitle", "time": 10533.03, "timestamp": "02:55:33", "text": "チャット機能を封印します。チャットはチャットです"}, {"type": "subtitle", "time": 10536.63, "timestamp": "02:55:36", "text": "チャットが刑務所に入れられようとしている。"}, {"type": "subtitle", "time": 10541.429, "timestamp": "02:55:41", "text": "それは刑務所だ。チャットしただけで刑務所行き。"}, {"type": "subtitle", "time": 10551.19, "timestamp": "02:55:51", "text": "ギターに。"}]
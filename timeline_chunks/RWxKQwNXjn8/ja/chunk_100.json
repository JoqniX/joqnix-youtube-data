[{"type": "subtitle", "time": 6001.99, "timestamp": "01:40:01", "text": "多くの場合、ママフェアは"}, {"type": "subtitle", "time": 6004.87, "timestamp": "01:40:04", "text": "彼女が出産しようとしているように"}, {"type": "subtitle", "time": 6007.109, "timestamp": "01:40:07", "text": "彼女は手をつかむだろう"}, {"type": "subtitle", "time": 6008.709, "timestamp": "01:40:08", "text": "人"}, {"type": "subtitle", "time": 6010.95, "timestamp": "01:40:10", "text": "そして彼女は、あなたが知っているように、それらを"}, {"type": "subtitle", "time": 6013.669, "timestamp": "01:40:13", "text": "彼女の赤ちゃんはどこにいるのか、なぜなら彼女は"}, {"type": "subtitle", "time": 6016.07, "timestamp": "01:40:16", "text": "彼女はあなたがそこにいてほしいと思っていて、彼女はちょっと"}, {"type": "subtitle", "time": 6018.07, "timestamp": "01:40:18", "text": "相手を赤ん坊のように扱う。"}, {"type": "subtitle", "time": 6039.83, "timestamp": "01:40:39", "text": "あのね？私は、私は、私は"}, {"type": "subtitle", "time": 6042.149, "timestamp": "01:40:42", "text": "あなたのアクセサリーをあなたの"}, {"type": "subtitle", "time": 6045.109, "timestamp": "01:40:45", "text": "パンダ。わかった。彼にあげるつもりです"}, {"type": "subtitle", "time": 6047.27, "timestamp": "01:40:47", "text": "アクセサリー。彼にこうしてあげようと思う"}, {"type": "subtitle", "time": 6048.87, "timestamp": "01:40:48", "text": "あなたの"}, {"type": "subtitle", "time": 6050.709, "timestamp": "01:40:50", "text": "彼には何をあげたらいいでしょうか？自由に"}, {"type": "subtitle", "time": 6052.79, "timestamp": "01:40:52", "text": "それ。はい。"}, {"type": "subtitle", "time": 6057.99, "timestamp": "01:40:57", "text": "止めます、もしよろしければ、えっと"}]
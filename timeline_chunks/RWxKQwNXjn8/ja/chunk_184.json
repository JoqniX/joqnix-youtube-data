[{"type": "subtitle", "time": 11042.309, "timestamp": "03:04:02", "text": "ああ、それは"}, {"type": "subtitle", "time": 11044.309, "timestamp": "03:04:04", "text": "これらの少年たちは"}, {"type": "subtitle", "time": 11046.23, "timestamp": "03:04:06", "text": "私を呼ぶ声が聞こえる。彼らはこう言う。「ミック、"}, {"type": "subtitle", "time": 11060.07, "timestamp": "03:04:20", "text": "私たちの小さな犬はそうではありません。"}, {"type": "subtitle", "time": 11063.59, "timestamp": "03:04:23", "text": "それほど無防備ではない。彼は強い子だ。"}, {"type": "subtitle", "time": 11065.59, "timestamp": "03:04:25", "text": "彼は強い子だ。ナイフを渡すと"}, {"type": "subtitle", "time": 11074.15, "timestamp": "03:04:34", "text": "彼の可愛い顔に騙されてはいけません。彼は"}, {"type": "subtitle", "time": 11087.11, "timestamp": "03:04:47", "text": "ストリーム。ありがとうございました。何てことだ。もし"}, {"type": "subtitle", "time": 11088.79, "timestamp": "03:04:48", "text": "わかった。わかった。キラーが必要だ"}, {"type": "subtitle", "time": 11090.469, "timestamp": "03:04:50", "text": "ジョーのニックネーム。殺人者が必要だ"}, {"type": "subtitle", "time": 11094.15, "timestamp": "03:04:54", "text": "ニックネームですよね？私たちには必要 私たちには必要 私たちには必要"}, {"type": "subtitle", "time": 11095.59, "timestamp": "03:04:55", "text": "最高のニックネームだ。ほら、ほら、"}, {"type": "subtitle", "time": 11097.67, "timestamp": "03:04:57", "text": "ほら、ゾディアックみたいなやつ"}]
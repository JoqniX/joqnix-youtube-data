[{"type": "subtitle", "time": 7980.069, "timestamp": "02:13:00", "text": "では、それが揚げられている間に、皮をむきましょう。"}, {"type": "subtitle", "time": 7982.79, "timestamp": "02:13:02", "text": "これらのトマト。皮をむくだけです。"}, {"type": "subtitle", "time": 7985.27, "timestamp": "02:13:05", "text": "え、そうなんですか？しかし、鶏は"}, {"type": "subtitle", "time": 7987.91, "timestamp": "02:13:07", "text": "もっと水っぽくする。変えたいですか"}, {"type": "subtitle", "time": 7990.31, "timestamp": "02:13:10", "text": "チキンにしようか、ダーリン？うん。私はしません"}, {"type": "subtitle", "time": 7991.51, "timestamp": "02:13:11", "text": "鶏肉を調理する際は、"}, {"type": "subtitle", "time": 7992.87, "timestamp": "02:13:12", "text": "8～"}, {"type": "subtitle", "time": 7995.03, "timestamp": "02:13:15", "text": "10分。"}, {"type": "subtitle", "time": 7998.31, "timestamp": "02:13:18", "text": "揚げバターチキンのように見える"}, {"type": "subtitle", "time": 8003.83, "timestamp": "02:13:23", "text": "あれ、バターチキン食べたっけ？私"}, {"type": "subtitle", "time": 8004.79, "timestamp": "02:13:24", "text": "わからない。"}, {"type": "subtitle", "time": 8008.069, "timestamp": "02:13:28", "text": "バターチキンを食べたことがないのですか？"}, {"type": "subtitle", "time": 8010.229, "timestamp": "02:13:30", "text": "えっと、"}, {"type": "subtitle", "time": 8014.149, "timestamp": "02:13:34", "text": "もう一度見てみると、どんな感じでしたか？バター。"}, {"type": "subtitle", "time": 8021.43, "timestamp": "02:13:41", "text": "そうそう。黄色に見えますよね？"}, {"type": "subtitle", "time": 8025.27, "timestamp": "02:13:45", "text": "オレンジカレーみたい。うん。"}, {"type": "subtitle", "time": 8027.35, "timestamp": "02:13:47", "text": "うん。うん。うん。私はそれを食べたことがあります。"}, {"type": "subtitle", "time": 8035.99, "timestamp": "02:13:55", "text": "よし、彼は白を塗っている。あなたではない"}, {"type": "subtitle", "time": 8037.589, "timestamp": "02:13:57", "text": "カシューバターを使うべきなのは"}]
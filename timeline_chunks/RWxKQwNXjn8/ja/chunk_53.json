[{"type": "subtitle", "time": 3189.91, "timestamp": "00:53:09", "text": "アクセサリーの多く。"}, {"type": "subtitle", "time": 3192.069, "timestamp": "00:53:12", "text": "プロセスを信じるしかない。それはすべて"}, {"type": "subtitle", "time": 3194.95, "timestamp": "00:53:14", "text": "プロセスを信頼する。すべての主な"}, {"type": "subtitle", "time": 3197.589, "timestamp": "00:53:17", "text": "ジョギングを描く上で学ばなければならないこと"}, {"type": "subtitle", "time": 3199.109, "timestamp": "00:53:19", "text": "お前は一体何をやらかしたんだ？"}, {"type": "subtitle", "time": 3201.43, "timestamp": "00:53:21", "text": "私は今、何をしたの？私の生き物を使ってみてください"}, {"type": "subtitle", "time": 3204.15, "timestamp": "00:53:24", "text": "近道。それは、"}, {"type": "subtitle", "time": 3206.95, "timestamp": "00:53:26", "text": "プロセス。そして、そのプロセスを信頼するようになれば、"}, {"type": "subtitle", "time": 3210.79, "timestamp": "00:53:30", "text": "あなたがすること全てに意味が生まれるでしょう。"}, {"type": "subtitle", "time": 3220.15, "timestamp": "00:53:40", "text": "なぜ私は鎧を着けているように感じるのだろうか"}, {"type": "subtitle", "time": 3227.589, "timestamp": "00:53:47", "text": "そして、すべて順調です。その読み方は"}, {"type": "subtitle", "time": 3233.109, "timestamp": "00:53:53", "text": "ああ、ちょっと待って。私は何か間違ったことをした。"}, {"type": "subtitle", "time": 3234.95, "timestamp": "00:53:54", "text": "それは私に任せてください。 Z"}, {"type": "subtitle", "time": 3237.91, "timestamp": "00:53:57", "text": "コントロールZ、コントロールZ、コントロールZ。できない"}]
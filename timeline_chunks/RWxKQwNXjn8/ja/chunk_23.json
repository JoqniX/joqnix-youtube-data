[{"type": "subtitle", "time": 1382.39, "timestamp": "00:23:02", "text": "フランス人だよ。高級版。わかった。えっと"}, {"type": "subtitle", "time": 1385.75, "timestamp": "00:23:05", "text": "デザート。私はパイを食べたことがない。ぜひ"}, {"type": "subtitle", "time": 1387.75, "timestamp": "00:23:07", "text": "パイを食べる。"}, {"type": "subtitle", "time": 1390.31, "timestamp": "00:23:10", "text": "いいえ、パイを食べたことはありません。私は必要としている 私は必要としている"}, {"type": "subtitle", "time": 1392.31, "timestamp": "00:23:12", "text": "自分を誘拐して"}, {"type": "subtitle", "time": 1395.83, "timestamp": "00:23:15", "text": "実際に何かを食べさせてくれるような。"}, {"type": "chat", "time": 1400.694, "timestamp": "00:23:20", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "yoo thank god I ate before opening the stream"}, {"type": "subtitle", "time": 1401.59, "timestamp": "00:23:21", "text": "気に入ったよ。いいえ、私は純粋で無垢な人を手に入れました。彼"}, {"type": "subtitle", "time": 1404.23, "timestamp": "00:23:24", "text": "絶対に「ディック」とは言わない。"}, {"type": "subtitle", "time": 1406.789, "timestamp": "00:23:26", "text": "何？心配しないで、ジョー。しないで"}, {"type": "subtitle", "time": 1409.909, "timestamp": "00:23:29", "text": "それについて心配してください。えっと"}, {"type": "subtitle", "time": 1412.71, "timestamp": "00:23:32", "text": "ああ、よかった。ああ、食べておいてよかった"}, {"type": "subtitle", "time": 1415.19, "timestamp": "00:23:35", "text": "これを開く。"}, {"type": "subtitle", "time": 1417.75, "timestamp": "00:23:37", "text": "お腹が空いてしまった？サブは言った、「ああ、私の"}, {"type": "subtitle", "time": 1420.63, "timestamp": "00:23:40", "text": "ああ、神様。でも、あなたの配信へようこ​​そ。"}, {"type": "subtitle", "time": 1423.27, "timestamp": "00:23:43", "text": "それで、クマを手に入れた。あなたは"}, {"type": "subtitle", "time": 1425.909, "timestamp": "00:23:45", "text": "あなたを愛する人たちは、優しくて愛情深い人たちです。"}, {"type": "subtitle", "time": 1429.59, "timestamp": "00:23:49", "text": "おお。オーケー、私たちは行くよ"}, {"type": "subtitle", "time": 1431.83, "timestamp": "00:23:51", "text": "あなたを熊に変えてしまう。冗談じゃない。だった"}, {"type": "subtitle", "time": 1434.789, "timestamp": "00:23:54", "text": "お前を熊にしてやる。ああ、違うよ"}, {"type": "subtitle", "time": 1437.75, "timestamp": "00:23:57", "text": "ゲイの男性のようなタイプ。"}]
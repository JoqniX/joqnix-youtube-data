[{"type": "subtitle", "time": 8040.47, "timestamp": "02:14:00", "text": "まず最初に。"}, {"type": "subtitle", "time": 8042.149, "timestamp": "02:14:02", "text": "カシューバターは使用してはいけません"}, {"type": "subtitle", "time": 8053.35, "timestamp": "02:14:13", "text": "緊張を和らげたいなら"}, {"type": "subtitle", "time": 8056.95, "timestamp": "02:14:16", "text": "スパイス。そして彼はクソみたいなマンゴーチャツネを加える"}, {"type": "subtitle", "time": 8064.31, "timestamp": "02:14:24", "text": "うん。"}, {"type": "subtitle", "time": 8067.589, "timestamp": "02:14:27", "text": "ああ、マンゴーは入れてはいけないよ"}, {"type": "subtitle", "time": 8069.27, "timestamp": "02:14:29", "text": "チャツネからバターチキンまで。それは"}, {"type": "subtitle", "time": 8073.03, "timestamp": "02:14:33", "text": "全く別のものだ。"}, {"type": "subtitle", "time": 8076.149, "timestamp": "02:14:36", "text": "上に少しコリアンダーを散らす。そしてそれは"}, {"type": "subtitle", "time": 8079.189, "timestamp": "02:14:39", "text": "素晴らしいカレーになりそうだ。"}, {"type": "subtitle", "time": 8082.87, "timestamp": "02:14:42", "text": "それは彼らが知らなかったことです"}, {"type": "subtitle", "time": 8085.75, "timestamp": "02:14:45", "text": "卵子を押収する理由があるのです"}, {"type": "subtitle", "time": 8089.589, "timestamp": "02:14:49", "text": "推測ですが。ちくしょう。味のない"}, {"type": "subtitle", "time": 8095.189, "timestamp": "02:14:55", "text": "スープはただの水だ。それはただの水です。"}, {"type": "subtitle", "time": 8097.35, "timestamp": "02:14:57", "text": "それはただの水で、塊のようなものが"}]
[{"type": "subtitle", "time": 6060.709, "timestamp": "01:41:00", "text": "ペンを少し動かして"}, {"type": "subtitle", "time": 6063.43, "timestamp": "01:41:03", "text": "空間"}, {"type": "subtitle", "time": 6071.51, "timestamp": "01:41:11", "text": "待って、ハートとオーって何？"}, {"type": "subtitle", "time": 6074.87, "timestamp": "01:41:14", "text": "動かすことができません。わかった。出来ますか"}, {"type": "subtitle", "time": 6077.189, "timestamp": "01:41:17", "text": "できますか？ ああ、はい。最後に見たのはハートだった。"}, {"type": "subtitle", "time": 6079.27, "timestamp": "01:41:19", "text": "ああ、また描けばいいんだ。おお、"}, {"type": "subtitle", "time": 6082.55, "timestamp": "01:41:22", "text": "わかった。うん。"}, {"type": "subtitle", "time": 6084.709, "timestamp": "01:41:24", "text": "えっと、"}, {"type": "subtitle", "time": 6087.83, "timestamp": "01:41:27", "text": "そして、サイズを変更してはいけないんですよね？"}, {"type": "subtitle", "time": 6090.31, "timestamp": "01:41:30", "text": "それはあなた次第です。それはあなたの"}, {"type": "subtitle", "time": 6092.31, "timestamp": "01:41:32", "text": "描画。あなたは好きなようにできます"}, {"type": "subtitle", "time": 6098.709, "timestamp": "01:41:38", "text": "はい、どうぞ。それで十分だろう。"}, {"type": "subtitle", "time": 6101.83, "timestamp": "01:41:41", "text": "わかった、私は作るつもりだ"}, {"type": "subtitle", "time": 6111.83, "timestamp": "01:41:51", "text": "パンダは暗い"}]
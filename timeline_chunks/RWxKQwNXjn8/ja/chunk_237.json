[{"type": "subtitle", "time": 14227.189, "timestamp": "03:57:07", "text": "ああ、そうですね"}, {"type": "subtitle", "time": 14231.51, "timestamp": "03:57:11", "text": "開けなければならない、開けたままにしておかなければならない"}, {"type": "subtitle", "time": 14236.79, "timestamp": "03:57:16", "text": "働く。おい、一体どういうことだ？"}, {"type": "subtitle", "time": 14240.229, "timestamp": "03:57:20", "text": "バックグラウンドでは動作しません。"}, {"type": "subtitle", "time": 14243.11, "timestamp": "03:57:23", "text": "え、何？"}, {"type": "subtitle", "time": 14258.309, "timestamp": "03:57:38", "text": "ああ、わかりました。わかった。わかった。わかった。だから私が"}, {"type": "subtitle", "time": 14260.55, "timestamp": "03:57:40", "text": "ブラウザを維持しなければならないことを理解しました"}, {"type": "subtitle", "time": 14264.79, "timestamp": "03:57:44", "text": "この機能を使用するには、タブを開いておく必要があります。"}, {"type": "subtitle", "time": 14271.51, "timestamp": "03:57:51", "text": "おお。"}, {"type": "subtitle", "time": 14275.349, "timestamp": "03:57:55", "text": "クレイジーだね"}, {"type": "subtitle", "time": 14277.189, "timestamp": "03:57:57", "text": "誰でも"}]
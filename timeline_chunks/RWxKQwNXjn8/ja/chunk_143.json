[{"type": "subtitle", "time": 8588.07, "timestamp": "02:23:08", "text": "何てことだ。よくもそんなことを！チャド！よくもそんなことを"}, {"type": "subtitle", "time": 8590.55, "timestamp": "02:23:10", "text": "あなた？"}, {"type": "subtitle", "time": 8592.87, "timestamp": "02:23:12", "text": "makanとは何ですか？"}, {"type": "subtitle", "time": 8596.71, "timestamp": "02:23:16", "text": "マカンは、えっと、それは"}, {"type": "subtitle", "time": 8601.67, "timestamp": "02:23:21", "text": "バター。そうそう。マカンはバターのことです。それ"}, {"type": "subtitle", "time": 8612.389, "timestamp": "02:23:32", "text": "うん。私はクリームが大好きです。私の私は"}, {"type": "subtitle", "time": 8614.95, "timestamp": "02:23:34", "text": "わかりました。では、参加しましょう。ヒンドゥー教についてご存知ですか？"}, {"type": "subtitle", "time": 8617.91, "timestamp": "02:23:37", "text": "神話？ヒンドゥー神話が好きですか？ない"}, {"type": "subtitle", "time": 8619.67, "timestamp": "02:23:39", "text": "多くの。"}, {"type": "subtitle", "time": 8622.55, "timestamp": "02:23:42", "text": "わかった。えっと、クリシュナって誰だか知ってる？おお、"}, {"type": "subtitle", "time": 8624.95, "timestamp": "02:23:44", "text": "うん。うん。うん。基本的なものは知っています。"}, {"type": "subtitle", "time": 8627.83, "timestamp": "02:23:47", "text": "うん。うん。うん。それで、えっと、どうやって"}, {"type": "subtitle", "time": 8630.469, "timestamp": "02:23:50", "text": "クリシュナは？えっと、知ってますか？"}, {"type": "subtitle", "time": 8633.11, "timestamp": "02:23:53", "text": "クリシュナはマクルと呼ばれているのか？"}, {"type": "subtitle", "time": 8635.67, "timestamp": "02:23:55", "text": "いいえ。ああ、彼は盗むからです。ええ、彼は"}, {"type": "subtitle", "time": 8638.15, "timestamp": "02:23:58", "text": "いつも盗む、あの"}]
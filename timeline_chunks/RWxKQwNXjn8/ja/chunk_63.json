[{"type": "subtitle", "time": 3780.15, "timestamp": "01:03:00", "text": "私は茶色を選びました。"}, {"type": "subtitle", "time": 3782.71, "timestamp": "01:03:02", "text": "うん。要するに、私は一般的に"}, {"type": "subtitle", "time": 3786.069, "timestamp": "01:03:06", "text": "私は濃い色、もっと赤っぽい色が好きです"}, {"type": "subtitle", "time": 3787.829, "timestamp": "01:03:07", "text": "ニュアンスはあったけど、今回はああ"}, {"type": "subtitle", "time": 3790.309, "timestamp": "01:03:10", "text": "あなたは紫色のトーンの方が好き"}, {"type": "subtitle", "time": 3807.829, "timestamp": "01:03:27", "text": "また、次のような理論もある。"}, {"type": "subtitle", "time": 3809.349, "timestamp": "01:03:29", "text": "パンダは遺伝子操作によって作られた生き物です"}, {"type": "subtitle", "time": 3812.549, "timestamp": "01:03:32", "text": "レッサーパンダとホッキョクグマの遺伝子を持つ"}, {"type": "subtitle", "time": 3815.349, "timestamp": "01:03:35", "text": "そして普通のクマたち。わかりました、それは"}, {"type": "subtitle", "time": 3818.23, "timestamp": "01:03:38", "text": "それはおかしいように聞こえる。私はそうは思わない"}, {"type": "subtitle", "time": 3820.549, "timestamp": "01:03:40", "text": "それは、私には現実とは思えないんです。"}, {"type": "subtitle", "time": 3822.71, "timestamp": "01:03:42", "text": "ホッキョクグマはペンギンを食べるという恐れがある。"}, {"type": "subtitle", "time": 3826.309, "timestamp": "01:03:46", "text": "ネタバレは本当ではありませんでした。私はそうは思わない"}, {"type": "subtitle", "time": 3828.39, "timestamp": "01:03:48", "text": "これらの小さなフグには"}, {"type": "subtitle", "time": 3831.349, "timestamp": "01:03:51", "text": "それらの中にはホッキョクグマが写っている。"}, {"type": "subtitle", "time": 3834.47, "timestamp": "01:03:54", "text": "わかった。他に何か追加できることはありますか？"}, {"type": "subtitle", "time": 3836.309, "timestamp": "01:03:56", "text": "彼をさらに驚かせるために、小さな男を？私"}, {"type": "subtitle", "time": 3837.829, "timestamp": "01:03:57", "text": "知る。"}]
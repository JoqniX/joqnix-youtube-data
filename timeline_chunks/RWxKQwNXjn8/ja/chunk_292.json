[{"type": "subtitle", "time": 17524.39, "timestamp": "04:52:04", "text": "黄色い線がちょうど1本、赤い線はありません。"}, {"type": "subtitle", "time": 17527.03, "timestamp": "04:52:07", "text": "えっと、4本目のワイヤーをもう一度切断してください。わかった。"}, {"type": "subtitle", "time": 17529.03, "timestamp": "04:52:09", "text": "１、２、３、４。こんにちは、diffuseさん。"}, {"type": "subtitle", "time": 17532.07, "timestamp": "04:52:12", "text": "次に、ボタンを作成しましょう。ボタン。"}, {"type": "subtitle", "time": 17536.07, "timestamp": "04:52:16", "text": "わかった。黄色。ボタンを押してください。"}, {"type": "subtitle", "time": 17540.31, "timestamp": "04:52:20", "text": "えっと、ボタンには何て書いてあるの？えっと、プレス。"}, {"type": "subtitle", "time": 17543.51, "timestamp": "04:52:23", "text": "わかった。ボタンは青色です。もしあるとしたら"}, {"type": "subtitle", "time": 17546.948, "timestamp": "04:52:26", "text": "ボタンが白い場合、と書かれています。もし"}, {"type": "subtitle", "time": 17550.31, "timestamp": "04:52:30", "text": "えっと、爆弾は何個の電池で動いてるんですか？"}, {"type": "subtitle", "time": 17553.59, "timestamp": "04:52:33", "text": "爆弾？ええと、小型電池が4個。えっと"}, {"type": "subtitle", "time": 17555.83, "timestamp": "04:52:35", "text": "わかった。 2つ以上。えっと、そこにありますか？"}, {"type": "subtitle", "time": 17559.67, "timestamp": "04:52:39", "text": "FRKと呼ばれるもの？ FRKというラベル？いいえ。"}, {"type": "subtitle", "time": 17562.788, "timestamp": "04:52:42", "text": "いいえ。いいえ。わかりました。えっと、ボタンは黄色です。"}, {"type": "subtitle", "time": 17565.67, "timestamp": "04:52:45", "text": "右？うん。黄色。ちょっと待って。所有"}, {"type": "subtitle", "time": 17569.35, "timestamp": "04:52:49", "text": "ボタン。こんにちは。赤い帯。赤い帯。"}, {"type": "subtitle", "time": 17573.75, "timestamp": "04:52:53", "text": "えっと、タイマーが1になるまで待ってください。はい、"}, {"type": "subtitle", "time": 17577.19, "timestamp": "04:52:57", "text": "拒否した。こんにちは。えっと、次は青って書いてあります。プレス"}, {"type": "subtitle", "time": 17579.19, "timestamp": "04:52:59", "text": "ボタン。"}]
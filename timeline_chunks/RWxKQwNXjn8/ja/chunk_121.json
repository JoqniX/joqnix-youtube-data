[{"type": "subtitle", "time": 7260.229, "timestamp": "02:01:00", "text": "あまりにも純粋すぎる。富士山と呼ぶ"}, {"type": "subtitle", "time": 7263.99, "timestamp": "02:01:03", "text": "臭い。でも、あなたがあなたがあなたがあなたが"}, {"type": "subtitle", "time": 7266.629, "timestamp": "02:01:06", "text": "親しい人をふざけていじめる"}, {"type": "subtitle", "time": 7268.229, "timestamp": "02:01:08", "text": "と。"}, {"type": "subtitle", "time": 7271.03, "timestamp": "02:01:11", "text": "ああ、それは一種の兆候のようなもの"}, {"type": "subtitle", "time": 7272.95, "timestamp": "02:01:12", "text": "クローズアップで、わかるように"}, {"type": "subtitle", "time": 7276.55, "timestamp": "02:01:16", "text": "お互いに気心が知れている。"}, {"type": "subtitle", "time": 7278.31, "timestamp": "02:01:18", "text": "だから人はいじめを好むのだ。"}, {"type": "subtitle", "time": 7280.629, "timestamp": "02:01:20", "text": "君がそうするのを見るのも楽しいよ"}, {"type": "subtitle", "time": 7282.629, "timestamp": "02:01:22", "text": "ばかげた反応。だから人々は"}, {"type": "subtitle", "time": 7284.79, "timestamp": "02:01:24", "text": "いじめっ子。"}, {"type": "subtitle", "time": 7286.95, "timestamp": "02:01:26", "text": "だからこそ、人は時々友達になるのでしょうか"}, {"type": "subtitle", "time": 7290.149, "timestamp": "02:01:30", "text": "からかいとかそういうこと？ええ、それは、それは、それは"}, {"type": "subtitle", "time": 7299.03, "timestamp": "02:01:39", "text": "何てことだ。また、"}, {"type": "subtitle", "time": 7300.55, "timestamp": "02:01:40", "text": "水分補給と、おしっこをありがとう"}, {"type": "subtitle", "time": 7302.55, "timestamp": "02:01:42", "text": "ゴール。水分補給はするけど、感じない"}, {"type": "subtitle", "time": 7305.589, "timestamp": "02:01:45", "text": "まるで私が小便をしないみたいに。いいえ。"}, {"type": "subtitle", "time": 7311.189, "timestamp": "02:01:51", "text": "夕食作り、頑張ってくださいね。団子"}, {"type": "subtitle", "time": 7314.149, "timestamp": "02:01:54", "text": "赤いスープでいただくのが良さそうですね。"}, {"type": "subtitle", "time": 7318.95, "timestamp": "02:01:58", "text": "いくつか送ってください。何てことだ。赤い兄弟。"}]
[{"type": "subtitle", "time": 11220.389, "timestamp": "03:07:00", "text": "それは最初の"}, {"type": "subtitle", "time": 11222.63, "timestamp": "03:07:02", "text": "シリーズ、かな。初期デザイン、コンセプト"}, {"type": "subtitle", "time": 11224.63, "timestamp": "03:07:04", "text": "デザイン"}, {"type": "subtitle", "time": 11226.79, "timestamp": "03:07:06", "text": "公式に発表されるかもしれない"}, {"type": "subtitle", "time": 11230.469, "timestamp": "03:07:10", "text": "シリーズ、かな。わからない。何てことだ。"}, {"type": "subtitle", "time": 11234.15, "timestamp": "03:07:14", "text": "ホーリーはDジョッカーとジョッキークルーガーと言った"}, {"type": "subtitle", "time": 11236.309, "timestamp": "03:07:16", "text": "現実になり得る。"}, {"type": "subtitle", "time": 11242.15, "timestamp": "03:07:22", "text": "美しい。持続する。私は調整する必要がある"}, {"type": "subtitle", "time": 11244.95, "timestamp": "03:07:24", "text": "姿勢。"}, {"type": "subtitle", "time": 11247.429, "timestamp": "03:07:27", "text": "うん。はい、大丈夫です。"}, {"type": "subtitle", "time": 11249.51, "timestamp": "03:07:29", "text": "私は座っていましたが、私は座ることができません"}, {"type": "subtitle", "time": 11252.389, "timestamp": "03:07:32", "text": "ポーズが長すぎるんだよ。私は座ることができた"}, {"type": "subtitle", "time": 11255.91, "timestamp": "03:07:35", "text": "バイセクシャルのポーズをとって、私の好きなように"}, {"type": "subtitle", "time": 11258.07, "timestamp": "03:07:38", "text": "変な姿勢で座る。平"}, {"type": "subtitle", "time": 11259.75, "timestamp": "03:07:39", "text": "私はバイセクシャルではないけれど、"}, {"type": "subtitle", "time": 11262.71, "timestamp": "03:07:42", "text": "知る。うん。"}, {"type": "subtitle", "time": 11264.71, "timestamp": "03:07:44", "text": "ジョーは青いが、赤くなると、"}, {"type": "subtitle", "time": 11268.469, "timestamp": "03:07:48", "text": "殺し屋のスポーツマンになる。"}, {"type": "subtitle", "time": 11270.15, "timestamp": "03:07:50", "text": "何てことだ。私たちはそれができる"}, {"type": "subtitle", "time": 11272.87, "timestamp": "03:07:52", "text": "色を反転させると"}]
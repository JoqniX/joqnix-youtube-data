[{"type": "subtitle", "time": 7621.83, "timestamp": "02:07:01", "text": "ハラスの性格タイプは何ですか？彼は"}, {"type": "subtitle", "time": 7624.31, "timestamp": "02:07:04", "text": "[ __ ]、兄弟。彼は、彼はちょっとしたクソ野郎だ。"}, {"type": "subtitle", "time": 7627.03, "timestamp": "02:07:07", "text": "彼は、彼は、彼は、ほら、彼は"}, {"type": "subtitle", "time": 7629.03, "timestamp": "02:07:09", "text": "意地悪な女の子。彼は意地悪な女の子だ。それは"}, {"type": "subtitle", "time": 7633.51, "timestamp": "02:07:13", "text": "彼が何者なのか。何てことだ。"}, {"type": "subtitle", "time": 7639.109, "timestamp": "02:07:19", "text": "つまり、1つ見ればわかるよ"}, {"type": "subtitle", "time": 7640.55, "timestamp": "02:07:20", "text": "彼のストリームを見れば、彼の"}, {"type": "subtitle", "time": 7642.31, "timestamp": "02:07:22", "text": "性格タイプ。つまり、"}, {"type": "subtitle", "time": 7645.51, "timestamp": "02:07:25", "text": "あいつはちっぽけなクソ野郎だ。アメリカを忘れないで"}, {"type": "subtitle", "time": 7648.39, "timestamp": "02:07:28", "text": "季節ですよね？塩を振るなどの味付け"}, {"type": "subtitle", "time": 7650.149, "timestamp": "02:07:30", "text": "などなど。"}, {"type": "subtitle", "time": 7652.709, "timestamp": "02:07:32", "text": "ウィンクシーズンライス。あれは何だ？"}, {"type": "subtitle", "time": 7655.27, "timestamp": "02:07:35", "text": "どういう意味ですか？"}, {"type": "subtitle", "time": 7663.03, "timestamp": "02:07:43", "text": "つまり、塩と油を入れない人なんていないでしょ"}, {"type": "subtitle", "time": 7670.55, "timestamp": "02:07:50", "text": "正直に言って。"}, {"type": "subtitle", "time": 7673.35, "timestamp": "02:07:53", "text": "いいって聞いたんだけど。私は"}]
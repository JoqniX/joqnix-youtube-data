[{"type": "subtitle", "time": 2046.07, "timestamp": "00:34:06", "text": "ああ、わかった。わかった。うん、円があるね"}, {"type": "subtitle", "time": 2052.389, "timestamp": "00:34:12", "text": "うん、これはうまくいくかもしれない。"}, {"type": "subtitle", "time": 2055.27, "timestamp": "00:34:15", "text": "円があります。大丈夫。今、私たちは"}, {"type": "subtitle", "time": 2058.069, "timestamp": "00:34:18", "text": "耳を描きます。では、"}, {"type": "subtitle", "time": 2065.99, "timestamp": "00:34:25", "text": "それは単に丸められたという意味です"}, {"type": "subtitle", "time": 2081.75, "timestamp": "00:34:41", "text": "待って、違う絵を描くべきなの？"}, {"type": "subtitle", "time": 2084.149, "timestamp": "00:34:44", "text": "レイヤー？いいえ。そうです。わかった。"}, {"type": "subtitle", "time": 2085.75, "timestamp": "00:34:45", "text": "いやいや、大丈夫です。あなたは"}, {"type": "subtitle", "time": 2087.43, "timestamp": "00:34:47", "text": "異なる絵を描く。私たちはただ"}, {"type": "subtitle", "time": 2090.95, "timestamp": "00:34:50", "text": "単純。筆を使っていますか、それとも鉛筆を使っていますか？"}, {"type": "subtitle", "time": 2092.31, "timestamp": "00:34:52", "text": "わかった。私はブラシを使っています。私は"}, {"type": "subtitle", "time": 2094.71, "timestamp": "00:34:54", "text": "ブラシ。私は筆を使う方が好きです。おお、"}, {"type": "subtitle", "time": 2097.829, "timestamp": "00:34:57", "text": "あなたは柔らかいものを使っていますね。そうそう。私"}]
[{"type": "subtitle", "time": 10742.07, "timestamp": "02:59:02", "text": "夕食のおやつ。私はご飯を食べました。"}, {"type": "subtitle", "time": 10744.63, "timestamp": "02:59:04", "text": "今度は米"}, {"type": "subtitle", "time": 10748.95, "timestamp": "02:59:08", "text": "おやつにさえご飯を食べるなんて、冗談でしょ。私は"}, {"type": "subtitle", "time": 10763.269, "timestamp": "02:59:23", "text": "見たい。わかった。何てことだ。もしあなたが"}, {"type": "subtitle", "time": 10766.389, "timestamp": "02:59:26", "text": "もしあなたがここにいられないなら、私たちは"}, {"type": "subtitle", "time": 10769.03, "timestamp": "02:59:29", "text": "大丈夫です。さあ、行こう。"}, {"type": "subtitle", "time": 10771.429, "timestamp": "02:59:31", "text": "わかった。ここのご飯は美味しい。米は"}, {"type": "subtitle", "time": 10773.59, "timestamp": "02:59:33", "text": "美味しい。誤解しないでほしいのですが、"}, {"type": "subtitle", "time": 10776.95, "timestamp": "02:59:36", "text": "一日のすべての食事に米は"}, {"type": "subtitle", "time": 10781.19, "timestamp": "02:59:41", "text": "過度に。それはやりすぎだ。なんてこった。いいえ。ああ、"}, {"type": "subtitle", "time": 10785.269, "timestamp": "02:59:45", "text": "うん。えっと、真夜中って、つまり"}, {"type": "subtitle", "time": 10787.91, "timestamp": "02:59:47", "text": "えっと、昨日の真夜中は文字通り"}, {"type": "subtitle", "time": 10792.23, "timestamp": "02:59:52", "text": "午前7時。だから、私はそこでご飯を食べました。"}, {"type": "subtitle", "time": 10794.71, "timestamp": "02:59:54", "text": "カレーのように注文しました"}, {"type": "subtitle", "time": 10796.95, "timestamp": "02:59:56", "text": "カレーが来て、私は「ああ」と思った"}]
[{"type": "subtitle", "time": 8281.349, "timestamp": "02:18:01", "text": "うん。 Cヌードル。"}, {"type": "subtitle", "time": 8285.11, "timestamp": "02:18:05", "text": "試したことがないの？いいえ。何ですか？私は決して"}, {"type": "subtitle", "time": 8288.79, "timestamp": "02:18:08", "text": "試してみました。でも、カーテンライスを置いたよ"}, {"type": "subtitle", "time": 8291.19, "timestamp": "02:18:11", "text": "そして、それを成し遂げた。わかった。ええ、タラご飯は"}, {"type": "subtitle", "time": 8294.629, "timestamp": "02:18:14", "text": "良い。 Cライスは定番です。"}, {"type": "subtitle", "time": 8297.83, "timestamp": "02:18:17", "text": "うん。よくも私のチャイティーを"}, {"type": "subtitle", "time": 8300.629, "timestamp": "02:18:20", "text": "チャット？よくもチャイの話を持ち出せたな！その"}, {"type": "subtitle", "time": 8304.23, "timestamp": "02:18:24", "text": "チャイ。ただのチャイだよ。あなたじゃないの？"}, {"type": "subtitle", "time": 8307.19, "timestamp": "02:18:27", "text": "クソみたいなこと言うなよ"}, {"type": "subtitle", "time": 8310.549, "timestamp": "02:18:30", "text": "バゲットパン。ほら、言わないで"}, {"type": "subtitle", "time": 8322.23, "timestamp": "02:18:42", "text": "ただのチャイだよ。チャイです。ナンではありません"}, {"type": "subtitle", "time": 8325.19, "timestamp": "02:18:45", "text": "パン。それはナンです。そしてそれはチャイです。私はしません"}, {"type": "subtitle", "time": 8326.87, "timestamp": "02:18:46", "text": "実は、チャイがそれほど好きなんです。私は"}, {"type": "subtitle", "time": 8329.03, "timestamp": "02:18:49", "text": "正直に言うと。何をするの？何をするの？"}, {"type": "subtitle", "time": 8331.19, "timestamp": "02:18:51", "text": "通常、コーヒーまたはブラックコーヒーを考えます"}, {"type": "subtitle", "time": 8335.11, "timestamp": "02:18:55", "text": "お茶？私は普段コーヒーを飲みます。えっと、"}, {"type": "subtitle", "time": 8338.389, "timestamp": "02:18:58", "text": "最後にチャイを飲んだのは私の誕生日でした"}]
[{"type": "subtitle", "time": 13263.269, "timestamp": "03:41:03", "text": "私は"}, {"type": "subtitle", "time": 13265.91, "timestamp": "03:41:05", "text": "うん。だから、私には選択肢がある。"}, {"type": "subtitle", "time": 13269.75, "timestamp": "03:41:09", "text": "ライセンス料を支払い、"}, {"type": "subtitle", "time": 13273.11, "timestamp": "03:41:13", "text": "なぜ支払いのしきい値が50になっているのですか？"}, {"type": "subtitle", "time": 13276.55, "timestamp": "03:41:16", "text": "50には載せたくない。"}, {"type": "subtitle", "time": 13278.95, "timestamp": "03:41:18", "text": "どうすれば変更できますか"}, {"type": "subtitle", "time": 13294.309, "timestamp": "03:41:34", "text": "感じるよ。いいえ。それは私を検証できません。なぜなら私は"}, {"type": "subtitle", "time": 13318.79, "timestamp": "03:41:58", "text": "チル。私は本当にデビューしたかった"}]
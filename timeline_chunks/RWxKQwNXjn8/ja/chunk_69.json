[{"type": "subtitle", "time": 4153.189, "timestamp": "01:09:13", "text": "私は気にしない。私はジョックをガスライティングしているわけではありません。"}, {"type": "subtitle", "time": 4154.63, "timestamp": "01:09:14", "text": "君たちは私に対して何も情報を持っていない。"}, {"type": "subtitle", "time": 4157.59, "timestamp": "01:09:17", "text": "何？私の"}, {"type": "subtitle", "time": 4159.749, "timestamp": "01:09:19", "text": "おお？"}, {"type": "subtitle", "time": 4161.99, "timestamp": "01:09:21", "text": "ドクター、アイアンユーチューバーの記事を読んだことがありますか？"}, {"type": "subtitle", "time": 4164.87, "timestamp": "01:09:24", "text": "Kyraが書いたファンフィクション？"}, {"type": "subtitle", "time": 4175.189, "timestamp": "01:09:35", "text": "それで、カイラ、えっと、私たちはくつろいでいたんだよね？"}, {"type": "subtitle", "time": 4178.47, "timestamp": "01:09:38", "text": "私たちはくつろいでいて、ハラスとアリス"}, {"type": "subtitle", "time": 4180.87, "timestamp": "01:09:40", "text": "普段通りに戦っていた。それで、カイラはこう書いた"}, {"type": "subtitle", "time": 4188.55, "timestamp": "01:09:48", "text": "あなたはそれを読んでいないのですか？いいえ。私は持っている"}, {"type": "subtitle", "time": 4189.99, "timestamp": "01:09:49", "text": "ない。"}, {"type": "subtitle", "time": 4193.99, "timestamp": "01:09:53", "text": "わかりました、私が持ちます。"}, {"type": "subtitle", "time": 4197.43, "timestamp": "01:09:57", "text": "ロードは激怒していた"}]
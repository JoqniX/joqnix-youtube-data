[{"type": "subtitle", "time": 7866.47, "timestamp": "02:11:06", "text": "バターチキン。"}, {"type": "subtitle", "time": 7870.149, "timestamp": "02:11:10", "text": "まるで私がそれを見て、私の"}, {"type": "subtitle", "time": 7872.149, "timestamp": "02:11:12", "text": "問題は、母が私にそれを見せてくれたのですが、"}, {"type": "subtitle", "time": 7873.75, "timestamp": "02:11:13", "text": "昔は、"}, {"type": "subtitle", "time": 7875.589, "timestamp": "02:11:15", "text": "ジェイミー・オリバーは大好きだけど、"}, {"type": "subtitle", "time": 7878.149, "timestamp": "02:11:18", "text": "彼女は「彼を許せない」という感じだった。"}, {"type": "subtitle", "time": 7880.92, "timestamp": "02:11:20", "text": "彼がしたことに対して。"}, {"type": "subtitle", "time": 7885.91, "timestamp": "02:11:25", "text": "私は彼が許されるべきではないと思う"}, {"type": "subtitle", "time": 7888.629, "timestamp": "02:11:28", "text": "インド料理に触れる。"}, {"type": "subtitle", "time": 7891.35, "timestamp": "02:11:31", "text": "それは、ローおじさんが出てくるやつだった。ローおじさん"}, {"type": "subtitle", "time": 7893.99, "timestamp": "02:11:33", "text": "素晴らしいです。"}, {"type": "subtitle", "time": 7895.589, "timestamp": "02:11:35", "text": "問題は、イギリス人は"}, {"type": "subtitle", "time": 7897.189, "timestamp": "02:11:37", "text": "バターチキンを食べ、"}, {"type": "subtitle", "time": 7899.43, "timestamp": "02:11:39", "text": "まるでそれが彼ら自身のものであるかのように、そして彼らは"}, {"type": "subtitle", "time": 7902.069, "timestamp": "02:11:42", "text": "兄弟、これをやって、"}, {"type": "subtitle", "time": 7905.75, "timestamp": "02:11:45", "text": "私の国の食べ物から手を離して"}, {"type": "subtitle", "time": 7908.39, "timestamp": "02:11:48", "text": "文化"}, {"type": "subtitle", "time": 7913.189, "timestamp": "02:11:53", "text": "自分のムスクとイエスを作る"}, {"type": "subtitle", "time": 7915.669, "timestamp": "02:11:55", "text": "なんてこった"}, {"type": "subtitle", "time": 7917.27, "timestamp": "02:11:57", "text": "マサラ"}]
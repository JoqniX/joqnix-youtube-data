[{"type": "subtitle", "time": 15246.55, "timestamp": "04:14:06", "text": "ええ、うまくいくはずです。とにかく、私は"}, {"type": "subtitle", "time": 15257.59, "timestamp": "04:14:17", "text": "それは本当に素晴らしいですね。"}, {"type": "subtitle", "time": 15260.87, "timestamp": "04:14:20", "text": "外国のお菓子。"}, {"type": "subtitle", "time": 15264.229, "timestamp": "04:14:24", "text": "いいもの。"}, {"type": "subtitle", "time": 15265.91, "timestamp": "04:14:25", "text": "うん、"}, {"type": "subtitle", "time": 15267.83, "timestamp": "04:14:27", "text": "何か食べないと。知ってるでしょ"}, {"type": "subtitle", "time": 15271.75, "timestamp": "04:14:31", "text": "何？ご飯でも炊くか何かしようかな。"}, {"type": "subtitle", "time": 15275.99, "timestamp": "04:14:35", "text": "でも、お腹が空いたな。"}, {"type": "subtitle", "time": 15279.349, "timestamp": "04:14:39", "text": "私に何ができる？"}, {"type": "subtitle", "time": 15281.99, "timestamp": "04:14:41", "text": "お腹が空きました。眠くない。"}, {"type": "subtitle", "time": 15284.55, "timestamp": "04:14:44", "text": "たった10だよ。いや、10じゃないよね？"}, {"type": "subtitle", "time": 15287.59, "timestamp": "04:14:47", "text": "今何時ですか？"}]
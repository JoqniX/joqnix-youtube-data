[{"type": "subtitle", "time": 6781.27, "timestamp": "01:53:01", "text": "みんなが立ち止まったと思った。いいえ、私たちは"}, {"type": "subtitle", "time": 6783.669, "timestamp": "01:53:03", "text": "ほとんど毎回プレイした"}, {"type": "subtitle", "time": 6785.51, "timestamp": "01:53:05", "text": "人々をそのゲームに参加させることができる、"}, {"type": "subtitle", "time": 6788.629, "timestamp": "01:53:08", "text": "彼らにそれをプレイさせるように強制する。私は脅威です"}, {"type": "subtitle", "time": 6792.87, "timestamp": "01:53:12", "text": "社会に対して特に私はいつも"}, {"type": "subtitle", "time": 6801.51, "timestamp": "01:53:21", "text": "最近Vuvaをプレイし始めたので"}, {"type": "subtitle", "time": 6811.109, "timestamp": "01:53:31", "text": "うん、君もプレイしたよね、冗談だよ"}, {"type": "subtitle", "time": 6813.99, "timestamp": "01:53:33", "text": "最新のキャラクターを入手しましたか？"}, {"type": "subtitle", "time": 6816.31, "timestamp": "01:53:36", "text": "ザニを手に入れた"}, {"type": "subtitle", "time": 6819.84, "timestamp": "01:53:39", "text": "おお。何てことだ。彼女はとても魅力的だ。"}, {"type": "subtitle", "time": 6821.669, "timestamp": "01:53:41", "text": "[音楽]"}, {"type": "subtitle", "time": 6824.87, "timestamp": "01:53:44", "text": "ザニのように。ザニは、"}, {"type": "subtitle", "time": 6828.31, "timestamp": "01:53:48", "text": "シールドとか持ってるよね？はい。"}, {"type": "subtitle", "time": 6830.87, "timestamp": "01:53:50", "text": "ああ、彼女は本当に魅力的だ。ニックが彼女に見せたように"}, {"type": "subtitle", "time": 6833.589, "timestamp": "01:53:53", "text": "私にとって、そして私は一目惚れしました。"}, {"type": "subtitle", "time": 6835.99, "timestamp": "01:53:55", "text": "でも、彼女の横断幕を見逃してしまった。"}]
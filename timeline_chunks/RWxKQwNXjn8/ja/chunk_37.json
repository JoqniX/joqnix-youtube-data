[{"type": "subtitle", "time": 2220.47, "timestamp": "00:37:00", "text": "ジャックは純粋で無垢な心の持ち主だ。そして"}, {"type": "subtitle", "time": 2222.55, "timestamp": "00:37:02", "text": "チャット、あなたは汚職をしてはいけません"}, {"type": "subtitle", "time": 2226.15, "timestamp": "00:37:06", "text": "彼。ああ、幽霊の女王をありがとう。"}, {"type": "subtitle", "time": 2228.069, "timestamp": "00:37:08", "text": "A"}, {"type": "subtitle", "time": 2233.109, "timestamp": "00:37:13", "text": "幽霊、本当に久しぶりだね。こんにちは、幽霊さん。"}, {"type": "subtitle", "time": 2247.27, "timestamp": "00:37:27", "text": "わかった。なぜ良くないのか？ああ、"}, {"type": "subtitle", "time": 2250.15, "timestamp": "00:37:30", "text": "神。私のいいえ、でも私たちはできる、私たちはできる"}, {"type": "subtitle", "time": 2251.91, "timestamp": "00:37:31", "text": "後でまたね。作る必要があるだけです"}, {"type": "subtitle", "time": 2255.109, "timestamp": "00:37:35", "text": "まず何か始めないとね。わかった。あなたはできる"}, {"type": "subtitle", "time": 2263.829, "timestamp": "00:37:43", "text": "もしかしたら、あなたは良い魂を作るべきかもしれません"}, {"type": "subtitle", "time": 2267.91, "timestamp": "00:37:47", "text": "トップギア。ジェレミー・クラークソンは最高だ。"}, {"type": "subtitle", "time": 2270.31, "timestamp": "00:37:50", "text": "ああ、これは昔の…いや、そうじゃない"}, {"type": "subtitle", "time": 2272.55, "timestamp": "00:37:52", "text": "人。別人です。それ"}, {"type": "subtitle", "time": 2273.91, "timestamp": "00:37:53", "text": "あなたが話しているその人は"}, {"type": "subtitle", "time": 2276.55, "timestamp": "00:37:56", "text": "カンズ、そして彼は私は見ていない"}, {"type": "subtitle", "time": 2278.23, "timestamp": "00:37:58", "text": "正直言って、彼とはずっと一緒だよ。彼はちょっと"}]
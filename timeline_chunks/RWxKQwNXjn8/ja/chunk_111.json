[{"type": "subtitle", "time": 6672.229, "timestamp": "01:51:12", "text": "なぜ私のフレットはライオンのように見えるのでしょうか？"}, {"type": "subtitle", "time": 6673.99, "timestamp": "01:51:13", "text": "正直に言うと、彼らは"}, {"type": "subtitle", "time": 6676.629, "timestamp": "01:51:16", "text": "長い体を描くと"}, {"type": "subtitle", "time": 6678.87, "timestamp": "01:51:18", "text": "フレットのように見えるでしょう。あなたはただ"}, {"type": "subtitle", "time": 6682.629, "timestamp": "01:51:22", "text": "プロセスを信じてください。"}, {"type": "subtitle", "time": 6687.189, "timestamp": "01:51:27", "text": "プロセスか全てが来る"}, {"type": "subtitle", "time": 6697.03, "timestamp": "01:51:37", "text": "自信を持たなければならないし、"}, {"type": "subtitle", "time": 6699.35, "timestamp": "01:51:39", "text": "他のすべては"}, {"type": "subtitle", "time": 6718.39, "timestamp": "01:51:58", "text": "つまり、私がそれをあなたに見せたかどうか"}]
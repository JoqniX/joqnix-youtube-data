[{"type": "subtitle", "time": 8823.429, "timestamp": "02:27:03", "text": "コピーのために。何てことだ。 Hは"}, {"type": "subtitle", "time": 8826.63, "timestamp": "02:27:06", "text": "彼はその芸術の達人だ。彼はここにいる。ああ、"}, {"type": "subtitle", "time": 8829.67, "timestamp": "02:27:09", "text": "神。さっきあなたのことを話していたんですよ。"}, {"type": "subtitle", "time": 8833.19, "timestamp": "02:27:13", "text": "ええ、学びましたよ。"}, {"type": "subtitle", "time": 8835.19, "timestamp": "02:27:15", "text": "行っていただき、ありがとうございました。 Q. それは"}, {"type": "subtitle", "time": 8837.11, "timestamp": "02:27:17", "text": "そんなことはあり得ない。そんなことはあり得ないよ。"}, {"type": "subtitle", "time": 8839.19, "timestamp": "02:27:19", "text": "もう泣くのはやめていいよ。私はそうではない"}, {"type": "subtitle", "time": 8850.15, "timestamp": "02:27:30", "text": "Fってすごく可愛いね、ジョック。大好きです。"}, {"type": "subtitle", "time": 8857.83, "timestamp": "02:27:37", "text": "うん。"}, {"type": "subtitle", "time": 8861.03, "timestamp": "02:27:41", "text": "私がストリーミング配信を始めてどれくらい経ちますか？"}, {"type": "subtitle", "time": 8864.07, "timestamp": "02:27:44", "text": "くそ、もう2時間半も経ったのか。 2と"}, {"type": "subtitle", "time": 8867.75, "timestamp": "02:27:47", "text": "ええ、9歳から始めたんですよね？ 9～10"}, {"type": "subtitle", "time": 8870.469, "timestamp": "02:27:50", "text": "11. 君が若かった頃、僕は君を勝ち取ったんだ。うん、"}, {"type": "subtitle", "time": 8872.55, "timestamp": "02:27:52", "text": "最悪なところは何か知ってる？"}, {"type": "subtitle", "time": 8875.11, "timestamp": "02:27:55", "text": "は？ハラスは私の母国語を知っているが、"}]
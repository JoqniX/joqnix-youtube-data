[{"type": "subtitle", "time": 18901.83, "timestamp": "05:15:01", "text": "金庫のLED装置。そして記憶。それから、えーと"}, {"type": "subtitle", "time": 18907.75, "timestamp": "05:15:07", "text": "2つの記号みたいなものかな。どれが"}, {"type": "subtitle", "time": 18911.83, "timestamp": "05:15:11", "text": "最初に何をしたいですか？記号。"}, {"type": "subtitle", "time": 18915.19, "timestamp": "05:15:15", "text": "わかった。こんにちは。それで、何が見えますか？"}, {"type": "subtitle", "time": 18917.75, "timestamp": "05:15:17", "text": "ロリポップ。"}, {"type": "subtitle", "time": 18922.15, "timestamp": "05:15:22", "text": "何？棒付きキャンディー。これについては、ええと"}, {"type": "subtitle", "time": 18925.51, "timestamp": "05:15:25", "text": "あれ。わかった。おお。"}, {"type": "subtitle", "time": 18927.83, "timestamp": "05:15:27", "text": "人生の半分。"}, {"type": "subtitle", "time": 18933.43, "timestamp": "05:15:33", "text": "シンボル。"}, {"type": "subtitle", "time": 18935.75, "timestamp": "05:15:35", "text": "脈拍が強い。まあ、いいでしょう。わかった。それから"}, {"type": "subtitle", "time": 18940.628, "timestamp": "05:15:40", "text": "Aの中にDが入っているピラミッド"}, {"type": "subtitle", "time": 18945.11, "timestamp": "05:15:45", "text": "ロリポップ。こんにちは。で"}, {"type": "subtitle", "time": 18949.11, "timestamp": "05:15:49", "text": "ハーフライフ。こんにちは。拡散した。やりたい"}, {"type": "subtitle", "time": 18952.708, "timestamp": "05:15:52", "text": "暗記する？わかった。暗記しましょう。わかった。"}, {"type": "subtitle", "time": 18954.708, "timestamp": "05:15:54", "text": "暗記しましょう。ください。"}, {"type": "subtitle", "time": 18959.35, "timestamp": "05:15:59", "text": "わかった。開ける。第一段階。それは2つです"}]
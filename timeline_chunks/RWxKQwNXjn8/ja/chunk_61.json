[{"type": "subtitle", "time": 3661.19, "timestamp": "01:01:01", "text": "私たちはパンダの世話をしたことがないかもしれない"}, {"type": "subtitle", "time": 3663.03, "timestamp": "01:01:03", "text": "パンダが"}, {"type": "subtitle", "time": 3665.75, "timestamp": "01:01:05", "text": "彼らは自分たちだけで行く、彼らはすごい"}, {"type": "subtitle", "time": 3668.789, "timestamp": "01:01:08", "text": "うん、彼らは生存能力がかなり低いんだ"}, {"type": "subtitle", "time": 3670.309, "timestamp": "01:01:10", "text": "今すぐ彼にDMを送って伝える"}, {"type": "subtitle", "time": 3672.63, "timestamp": "01:01:12", "text": "率直に話してください"}, {"type": "subtitle", "time": 3674.309, "timestamp": "01:01:14", "text": "あのクソガキに私が話してるって伝えて"}, {"type": "subtitle", "time": 3676.71, "timestamp": "01:01:16", "text": "彼の悪口を言っている。彼は私が"}, {"type": "subtitle", "time": 3678.069, "timestamp": "01:01:18", "text": "私がそうするから彼の悪口を言う"}, {"type": "subtitle", "time": 3686.87, "timestamp": "01:01:26", "text": "サイズを小さくする必要がある"}, {"type": "subtitle", "time": 3696.87, "timestamp": "01:01:36", "text": "ええと、クリエイティブな理由で、私は"}, {"type": "subtitle", "time": 3699.829, "timestamp": "01:01:39", "text": "あなたのメガネを紫色にする。"}, {"type": "subtitle", "time": 3706.39, "timestamp": "01:01:46", "text": "おばあちゃんに見せてやるわ。あなたは本当に意地悪ね。"}, {"type": "subtitle", "time": 3708.549, "timestamp": "01:01:48", "text": "わかった。わかった。おばあちゃんは例外だ。"}, {"type": "subtitle", "time": 3710.63, "timestamp": "01:01:50", "text": "おばあちゃんはいい人だ。私は愛する"}, {"type": "subtitle", "time": 3717.43, "timestamp": "01:01:57", "text": "おばあちゃんは例外だ。私は彼女を愛している。"}]
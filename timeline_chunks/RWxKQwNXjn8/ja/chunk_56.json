[{"type": "subtitle", "time": 3360.23, "timestamp": "00:56:00", "text": "わかった。これは本当に狂気じみている。それは私が"}, {"type": "subtitle", "time": 3363.51, "timestamp": "00:56:03", "text": "ベールが好きで、私は好きです"}, {"type": "subtitle", "time": 3366.71, "timestamp": "00:56:06", "text": "神話。だから私はただ"}, {"type": "subtitle", "time": 3370.309, "timestamp": "00:56:10", "text": "ランダムに組み合わせて、1つ手に入れるまで試しました"}, {"type": "subtitle", "time": 3373.19, "timestamp": "00:56:13", "text": "それはまだ使われていなかった。"}, {"type": "subtitle", "time": 3376.39, "timestamp": "00:56:16", "text": "ああ、そうだね。私はただ、本当に好きだった"}, {"type": "subtitle", "time": 3377.75, "timestamp": "00:56:17", "text": "クジラ。私は海兵隊員になりたかった"}, {"type": "subtitle", "time": 3380.549, "timestamp": "00:56:20", "text": "実は生物学者なんです。"}, {"type": "subtitle", "time": 3384.309, "timestamp": "00:56:24", "text": "そうそう。私にはできなかったけど、"}, {"type": "subtitle", "time": 3387.109, "timestamp": "00:56:27", "text": "ほら、私もそうなりたかったんだ。ああ、でももし"}, {"type": "subtitle", "time": 3390.069, "timestamp": "00:56:30", "text": "クジラが好きだったのに、なぜ"}, {"type": "subtitle", "time": 3392.549, "timestamp": "00:56:32", "text": "あなたの野菜キャラクターのためにクジラを？なぜなら"}, {"type": "subtitle", "time": 3395.27, "timestamp": "00:56:35", "text": "私もキツネが好きです。"}, {"type": "subtitle", "time": 3398.95, "timestamp": "00:56:38", "text": "ああ、ハイブリッドはどうだろう？キツネとクジラ"}, {"type": "subtitle", "time": 3401.91, "timestamp": "00:56:41", "text": "赤ちゃんとハイブリッド犬を産んだ。"}, {"type": "subtitle", "time": 3403.589, "timestamp": "00:56:43", "text": "それはどのように機能するのでしょうか？私はそうは思わない"}, {"type": "subtitle", "time": 3406.069, "timestamp": "00:56:46", "text": "それは"}, {"type": "subtitle", "time": 3409.109, "timestamp": "00:56:49", "text": "いいえ。たぶん。多分。あなたは持っていますか あなたは持っていますか あなたは"}, {"type": "subtitle", "time": 3412.39, "timestamp": "00:56:52", "text": "私の漫画のジョークをまだ見ていないの？私はハイブリッドです。"}, {"type": "subtitle", "time": 3415.109, "timestamp": "00:56:55", "text": "漫画。漫画を描いているの？何？私は"}, {"type": "subtitle", "time": 3417.91, "timestamp": "00:56:57", "text": "漫画。これについて漫画を描きました。何？"}, {"type": "subtitle", "time": 3419.99, "timestamp": "00:56:59", "text": "私は保持しています。見せます、共有します"}]
[{"type": "subtitle", "time": 7502.31, "timestamp": "02:05:02", "text": "ああ、ヴィニー。私の汗は赤くなっている"}, {"type": "subtitle", "time": 7506.07, "timestamp": "02:05:06", "text": "その通りだよ、兄弟。私は、あなたが"}, {"type": "subtitle", "time": 7508.79, "timestamp": "02:05:08", "text": "例えば、何か別のものを食べるために飲み物を飲むとか。"}, {"type": "subtitle", "time": 7512.31, "timestamp": "02:05:12", "text": "わからない。それは私だけの考えかもしれないけど、"}, {"type": "subtitle", "time": 7514.39, "timestamp": "02:05:14", "text": "今、君はスポーツマンみたいに振る舞ってる"}, {"type": "subtitle", "time": 7521.91, "timestamp": "02:05:21", "text": "ほら、誰にでもそういうのがあるでしょ？"}, {"type": "subtitle", "time": 7524.31, "timestamp": "02:05:24", "text": "彼らが一生食べ続けるであろう食べ物。私にとって、"}, {"type": "subtitle", "time": 7529.189, "timestamp": "02:05:29", "text": "サンドイッチです。私はサンドイッチが大好きです"}, {"type": "subtitle", "time": 7539.35, "timestamp": "02:05:39", "text": "母は絶品のチャーハンを作る。それはとても"}, {"type": "subtitle", "time": 7541.109, "timestamp": "02:05:41", "text": "良い。"}, {"type": "subtitle", "time": 7544.229, "timestamp": "02:05:44", "text": "ああ、あなたはいつか料理をするんですか？私はやり方を知っています"}, {"type": "subtitle", "time": 7547.75, "timestamp": "02:05:47", "text": "料理する。私は時々料理をしますが、普段は"}, {"type": "subtitle", "time": 7551.35, "timestamp": "02:05:51", "text": "料理をするのは私の母です"}, {"type": "subtitle", "time": 7553.189, "timestamp": "02:05:53", "text": "結局怠けてしまうので"}, {"type": "subtitle", "time": 7555.109, "timestamp": "02:05:55", "text": "母は「あなたは、あなたはやりすぎです」と言いました"}]
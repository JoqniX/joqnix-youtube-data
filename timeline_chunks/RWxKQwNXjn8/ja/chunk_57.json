[{"type": "subtitle", "time": 3422.549, "timestamp": "00:57:02", "text": "あなた。何てことだ。"}, {"type": "subtitle", "time": 3425.589, "timestamp": "00:57:05", "text": "ウェブチューンコミックやマンガマンガのようなもの。"}, {"type": "subtitle", "time": 3427.27, "timestamp": "00:57:07", "text": "それは小さな独立した"}, {"type": "subtitle", "time": 3430.47, "timestamp": "00:57:10", "text": "ちょっとした落書き漫画。"}, {"type": "subtitle", "time": 3434.309, "timestamp": "00:57:14", "text": "ああ、そうだね。それは重要です ミッチの伝承"}, {"type": "subtitle", "time": 3438.63, "timestamp": "00:57:18", "text": "私がどのようにしてキツネクジラになったのかについて。"}, {"type": "subtitle", "time": 3440.309, "timestamp": "00:57:20", "text": "ああ、ありがとう。私は"}, {"type": "subtitle", "time": 3442.87, "timestamp": "00:57:22", "text": "まだおしっこはしてないけど。"}, {"type": "subtitle", "time": 3447.27, "timestamp": "00:57:27", "text": "ミス、私はうんこなんかじゃないよ。わかった。"}, {"type": "subtitle", "time": 3450.789, "timestamp": "00:57:30", "text": "まったくのクソ野郎だ。あれって足じゃないの？三番目。"}, {"type": "subtitle", "time": 3455.43, "timestamp": "00:57:35", "text": "トッドはクソ野郎だ。ああ、さようなら。"}, {"type": "subtitle", "time": 3457.829, "timestamp": "00:57:37", "text": "何てことだ。いくつなのかわからない"}, {"type": "subtitle", "time": 3459.19, "timestamp": "00:57:39", "text": "これを説明するには、"}, {"type": "subtitle", "time": 3461.75, "timestamp": "00:57:41", "text": "私のチャットが夢中になっている理由"}, {"type": "subtitle", "time": 3463.67, "timestamp": "00:57:43", "text": "尿で。"}, {"type": "subtitle", "time": 3465.829, "timestamp": "00:57:45", "text": "はぁ？どう説明すればいいのかわからない"}, {"type": "subtitle", "time": 3467.67, "timestamp": "00:57:47", "text": "誰でも。とても恥ずかしい。いつでも"}, {"type": "subtitle", "time": 3469.67, "timestamp": "00:57:49", "text": "私は他の人と一緒に配信していて、彼らは"}, {"type": "subtitle", "time": 3473.75, "timestamp": "00:57:53", "text": "尿の話ばかりする。何てことだ。うん、"}, {"type": "subtitle", "time": 3476.95, "timestamp": "00:57:56", "text": "残念なことだが、"}, {"type": "subtitle", "time": 3478.47, "timestamp": "00:57:58", "text": "それでも私の子供だし、私は彼らを愛している"}]
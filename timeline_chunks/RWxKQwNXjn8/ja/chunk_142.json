[{"type": "subtitle", "time": 8522.15, "timestamp": "02:22:02", "text": "私もそう思います。あれはいったい何なんだ？"}, {"type": "subtitle", "time": 8525.91, "timestamp": "02:22:05", "text": "それはまるで「クソミスウォーター」と言うようなものだ。"}, {"type": "subtitle", "time": 8528.469, "timestamp": "02:22:08", "text": "ああ、実はそれ専用のブランドがあるんですよ。"}, {"type": "subtitle", "time": 8533.349, "timestamp": "02:22:13", "text": "アクアパナパナみたいな感じ。ああ、"}, {"type": "subtitle", "time": 8536.71, "timestamp": "02:22:16", "text": "神。天然水"}, {"type": "subtitle", "time": 8540.23, "timestamp": "02:22:20", "text": "イタリアのスキャン。ああ、イタリアだと思うよ。イタリア語"}, {"type": "subtitle", "time": 8544.389, "timestamp": "02:22:24", "text": "水。私はファストフードのように遊んでいました"}, {"type": "subtitle", "time": 8547.91, "timestamp": "02:22:27", "text": "プロローグのようにシミュレートし、"}, {"type": "subtitle", "time": 8551.429, "timestamp": "02:22:31", "text": "彼らはクソみたいなミズウォーターを持っている。私は見た"}, {"type": "subtitle", "time": 8555.67, "timestamp": "02:22:35", "text": "あのクソ野郎。私は「一体どういうことだ？」と思いました。"}, {"type": "subtitle", "time": 8558.55, "timestamp": "02:22:38", "text": "わかった。メルク。メルクチキンは実際には"}, {"type": "subtitle", "time": 8562.71, "timestamp": "02:22:42", "text": "皿。 Mチキン。聞いたことがない"}, {"type": "subtitle", "time": 8566.55, "timestamp": "02:22:46", "text": "Mは"}, {"type": "subtitle", "time": 8569.59, "timestamp": "02:22:49", "text": "おお。たくさんのこと。"}, {"type": "subtitle", "time": 8571.75, "timestamp": "02:22:51", "text": "バターチキン風カレー。うん。その"}, {"type": "subtitle", "time": 8575.349, "timestamp": "02:22:55", "text": "バターチキンの種類"}]
[{"type": "subtitle", "time": 7682.629, "timestamp": "02:08:02", "text": "ああ、もっと悪いこともあると思うよ"}, {"type": "subtitle", "time": 7683.99, "timestamp": "02:08:03", "text": "彼らがしてきたこと。それは彼らのものではない"}, {"type": "subtitle", "time": 7704.709, "timestamp": "02:08:24", "text": "持続する。 OBSの設定を間違えてしまった。"}, {"type": "subtitle", "time": 7725.83, "timestamp": "02:08:45", "text": "持続する。私はしくじった。私はしくじった。その"}, {"type": "subtitle", "time": 7728.629, "timestamp": "02:08:48", "text": "壊れています。何もかも壊れている。待って、"}, {"type": "subtitle", "time": 7731.589, "timestamp": "02:08:51", "text": "何？あなたの配信は途絶えてしまったのですか？いや、いや、いや。"}, {"type": "subtitle", "time": 7733.99, "timestamp": "02:08:53", "text": "えっと、ほら、ドックがあるでしょ"}, {"type": "subtitle", "time": 7736.149, "timestamp": "02:08:56", "text": "明らかに、あのドックのことだよ"}, {"type": "subtitle", "time": 7739.109, "timestamp": "02:08:59", "text": "もの。それは白ですか？それは白ですか？いいえ、私は"}]
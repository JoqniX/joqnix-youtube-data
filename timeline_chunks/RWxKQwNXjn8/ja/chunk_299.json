[{"type": "subtitle", "time": 17942.47, "timestamp": "04:59:02", "text": "あなた。あなたの助けがなければ、私は"}, {"type": "subtitle", "time": 17945.03, "timestamp": "04:59:05", "text": "これを作りました。どういう意味ですか？いいえ、あなた"}, {"type": "subtitle", "time": 17946.708, "timestamp": "04:59:06", "text": "君は爆弾処理班だ。君こそがその人だ"}, {"type": "subtitle", "time": 17948.55, "timestamp": "04:59:08", "text": "爆弾が不足していた。私はただここにいるだけです"}, {"type": "subtitle", "time": 17950.47, "timestamp": "04:59:10", "text": "本を手に持って座っていると、"}, {"type": "subtitle", "time": 17953.75, "timestamp": "04:59:13", "text": "頭の上にグラスが4つ乗っている。"}, {"type": "subtitle", "time": 17956.868, "timestamp": "04:59:16", "text": "いいえ、本当にあなたです。"}, {"type": "subtitle", "time": 17961.59, "timestamp": "04:59:21", "text": "「かわいい」ってどういう意味？私は可愛くない。"}, {"type": "subtitle", "time": 17970.55, "timestamp": "04:59:30", "text": "やりたいの？うん。よし。病気"}, {"type": "subtitle", "time": 17972.15, "timestamp": "04:59:32", "text": "次はディフューザーだ。あなたは"}, {"type": "subtitle", "time": 17975.03, "timestamp": "04:59:35", "text": "ハンドラ。"}, {"type": "subtitle", "time": 17977.83, "timestamp": "04:59:37", "text": "さあ行こう。私は1つのステップを実行します"}, {"type": "subtitle", "time": 17979.99, "timestamp": "04:59:39", "text": "上へ。"}, {"type": "subtitle", "time": 17981.99, "timestamp": "04:59:41", "text": "こんにちは。"}, {"type": "subtitle", "time": 17983.43, "timestamp": "04:59:43", "text": "わかった。入手したら教えてください"}, {"type": "chat", "time": 17988.253, "timestamp": "04:59:48", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Joq's Activity State is Returing back to stream"}, {"type": "subtitle", "time": 17988.788, "timestamp": "04:59:48", "text": "手動で上げてください。ええ、私はすでに"}, {"type": "chat", "time": 17999.566, "timestamp": "04:59:59", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "J
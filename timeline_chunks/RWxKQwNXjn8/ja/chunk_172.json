[{"type": "subtitle", "time": 10326.95, "timestamp": "02:52:06", "text": "私たちは、あなたの拳をジョックにしました"}, {"type": "subtitle", "time": 10330.84, "timestamp": "02:52:10", "text": "ソナのために。私たちは本当に誇りに思う。"}, {"type": "subtitle", "time": 10333.429, "timestamp": "02:52:13", "text": "[音楽]"}, {"type": "subtitle", "time": 10335.99, "timestamp": "02:52:15", "text": "うん、"}, {"type": "subtitle", "time": 10337.91, "timestamp": "02:52:17", "text": "いつかきっとそこにたどり着けるよ。カラス、君"}, {"type": "subtitle", "time": 10339.91, "timestamp": "02:52:19", "text": "ポイントを無駄遣いするのはもうやめよう"}, {"type": "subtitle", "time": 10346.469, "timestamp": "02:52:26", "text": "問題は、問題は、私は持っている"}, {"type": "subtitle", "time": 10349.67, "timestamp": "02:52:29", "text": "100ポイントに設定してもまだ"}, {"type": "subtitle", "time": 10352.87, "timestamp": "02:52:32", "text": "みんなの、そしてある時私は"}, {"type": "subtitle", "time": 10354.63, "timestamp": "02:52:34", "text": "価格を上げて、それからみんな"}, {"type": "subtitle", "time": 10357.19, "timestamp": "02:52:37", "text": "乾燥してしまったので、返品しなければなりませんでした。"}, {"type": "subtitle", "time": 10364.55, "timestamp": "02:52:44", "text": "いいよ、いいよ"}, {"type": "subtitle", "time": 10372.469, "timestamp": "02:52:52", "text": "えーと、基本的に私の"}, {"type": "subtitle", "time": 10375.83, "timestamp": "02:52:55", "text": "メガネ 私は3つくらい持っています"}, {"type": "subtitle", "time": 10379.83, "timestamp": "02:52:59", "text": "視力が悪い"}]
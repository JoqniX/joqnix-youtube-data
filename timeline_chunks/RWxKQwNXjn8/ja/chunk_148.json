[{"type": "subtitle", "time": 8880.71, "timestamp": "02:28:00", "text": "私はしません。おお。ええ、それは、それは、それは"}, {"type": "subtitle", "time": 8883.349, "timestamp": "02:28:03", "text": "本当に悲しいよ、兄弟。彼は私の母国語を知っている"}, {"type": "chat", "time": 8884.854, "timestamp": "02:28:04", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "teehee"}, {"type": "subtitle", "time": 8884.87, "timestamp": "02:28:04", "text": "言語。"}, {"type": "subtitle", "time": 8887.11, "timestamp": "02:28:07", "text": "では、地元のバスと"}, {"type": "subtitle", "time": 8889.349, "timestamp": "02:28:09", "text": "店名とか全部？いいえ、私はしません"}, {"type": "subtitle", "time": 8892.87, "timestamp": "02:28:12", "text": "私は、えーと、私の、えーと、私の"}, {"type": "subtitle", "time": 8896.309, "timestamp": "02:28:16", "text": "州。ああ、わかりました。わかった。うん。いいえ。それで、"}, {"type": "subtitle", "time": 8898.87, "timestamp": "02:28:18", "text": "私の言語は、ある意味消滅しつつある言語です"}, {"type": "subtitle", "time": 8902.469, "timestamp": "02:28:22", "text": "言語。つまり、消滅しつつある言語は"}, {"type": "subtitle", "time": 8905.19, "timestamp": "02:28:25", "text": "インド。何？うん。つまり、消滅しつつある言語は"}, {"type": "subtitle", "time": 8906.63, "timestamp": "02:28:26", "text": "つまり、それは"}, {"type": "subtitle", "time": 8910.309, "timestamp": "02:28:30", "text": "話す人の数は減少している。"}, {"type": "subtitle", "time": 8912.469, "timestamp": "02:28:32", "text": "おお、"}, {"type": "subtitle", "time": 8920.23, "timestamp": "02:28:40", "text": "ああ、なんてことだ、私の私のものがまた壊れてしまった。私"}, {"type": "subtitle", "time": 8922.15, "timestamp": "02:28:42", "text": "私のスマホでチャットが読み込まれません。私"}, {"type": "subtitle", "time": 8924.309, "timestamp": "02:28:44", "text": "たくさんのチャットが恋しかった。持続する。ちょうど"}, {"type": "subtitle", "time": 8926.71, "timestamp": "02:28:46", "text": "5000ポイント達成。何てことだ。同じ"}, {"type": "subtitle", "time": 8928.23, "timestamp": "02:28:48", "text": "と"}, {"type": "subtitle", "time": 8932.71, "timestamp": "02:28:52", "text": "ファンシー。それは地獄の言葉だ。"}, {"type": "subtitle", "time": 8935.33, "timestamp": "02:28:55", "text": "ああ、気分を害しました。"}, {"type": "subtitle", "time": 8937.67, "timestamp": "02:28:57", "text": "[音楽]"}]
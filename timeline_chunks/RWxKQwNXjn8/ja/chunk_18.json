[{"type": "subtitle", "time": 1081.11, "timestamp": "00:18:01", "text": "ええ、待ってください。それも失礼にあたるだろう。えっと、"}, {"type": "subtitle", "time": 1083.909, "timestamp": "00:18:03", "text": "わかった。これは難しい。ええ、それは、それは、それは"}, {"type": "subtitle", "time": 1087.59, "timestamp": "00:18:07", "text": "難しいですよね？えっと、泣き始めてください"}, {"type": "subtitle", "time": 1090.549, "timestamp": "00:18:10", "text": "そして、私が忘れたと言ってください。多分"}, {"type": "subtitle", "time": 1092.63, "timestamp": "00:18:12", "text": "あなたは泣き出すでしょう。ジャックは"}, {"type": "subtitle", "time": 1095.99, "timestamp": "00:18:15", "text": "間違いなく泣く。わかった、泣くよ。えっと、"}, {"type": "subtitle", "time": 1097.75, "timestamp": "00:18:17", "text": "嫌いな人が一緒に遊びたがっている"}, {"type": "subtitle", "time": 1100.63, "timestamp": "00:18:20", "text": "あなたと一緒にいたいけれど、本当はしたくない"}, {"type": "subtitle", "time": 1104.23, "timestamp": "00:18:24", "text": "する。えっと、嘘をついていると伝えてください"}, {"type": "subtitle", "time": 1106.15, "timestamp": "00:18:26", "text": "そして、忙しいと言いましょう。"}, {"type": "subtitle", "time": 1107.75, "timestamp": "00:18:27", "text": "彼らに一緒に過ごす機会を与えて"}, {"type": "subtitle", "time": 1110.789, "timestamp": "00:18:30", "text": "はい、そうします。しかし与える"}, {"type": "subtitle", "time": 1112.71, "timestamp": "00:18:32", "text": "彼ら、ああ、私はただ嘘をつくか"}, {"type": "subtitle", "time": 1119.11, "timestamp": "00:18:39", "text": "朝食。"}, {"type": "subtitle", "time": 1122.23, "timestamp": "00:18:42", "text": "米がない。わかった、"}, {"type": "subtitle", "time": 1125.029, "timestamp": "00:18:45", "text": "手。君は私、君はご飯を食べる"}, {"type": "subtitle", "time": 1126.789, "timestamp": "00:18:46", "text": "朝食。"}, {"type": "subtitle", "time": 1129.51, "timestamp": "00:18:49", "text": "私は3年前からご飯を食べています。"}, {"type": "subtitle", "time": 1131.909, "timestamp": "00:18:51", "text": "米"}, {"type": "subtitle", "time": 1135.59, "timestamp": "00:18:55", "text": "長年にわたり、米を食べ続けてきた。三つ"}, {"type": "subtitle", "time": 1139.029, "timestamp": "00:18:59", "text": "1日に何回。"}]
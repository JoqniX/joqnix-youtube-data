[{"type": "subtitle", "time": 12300.229, "timestamp": "03:25:00", "text": "どうしたの？わかった。ああ、わかった。私はしなければならない"}, {"type": "subtitle", "time": 12309.59, "timestamp": "03:25:09", "text": "くそ、"}, {"type": "subtitle", "time": 12328.15, "timestamp": "03:25:28", "text": "ええ、評価ガイドラインですね。ええ、そうですね"}, {"type": "subtitle", "time": 12330.87, "timestamp": "03:25:30", "text": "明確にして切り捨てる必要があると思う"}, {"type": "subtitle", "time": 12334.309, "timestamp": "03:25:34", "text": "将来のあらゆるシナリオに関するガイドライン"}, {"type": "subtitle", "time": 12336.15, "timestamp": "03:25:36", "text": "商品であれ人々であれ"}, {"type": "subtitle", "time": 12338.229, "timestamp": "03:25:38", "text": "私の商品を再販し、"}, {"type": "subtitle", "time": 12341.59, "timestamp": "03:25:41", "text": "私の物や何か"}, {"type": "subtitle", "time": 12346.63, "timestamp": "03:25:46", "text": "そこにあるものは、そうしなければならない"}, {"type": "subtitle", "time": 12348.55, "timestamp": "03:25:48", "text": "大丈夫だよ"}, {"type": "subtitle", "time": 12351.59, "timestamp": "03:25:51", "text": "マイナスにリクエストする 待って、それはどこにあるの"}, {"type": "subtitle", "time": 12358.71, "timestamp": "03:25:58", "text": "待って、ラジオのガイドラインはどこ？待って、"}]
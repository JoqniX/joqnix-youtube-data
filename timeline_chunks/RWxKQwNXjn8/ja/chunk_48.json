[{"type": "subtitle", "time": 2891.829, "timestamp": "00:48:11", "text": "[音楽]"}, {"type": "subtitle", "time": 2894.309, "timestamp": "00:48:14", "text": "うん。よく考えてみると、これは"}, {"type": "subtitle", "time": 2897.589, "timestamp": "00:48:17", "text": "これが私たちの最初の本格的なコラボレーションになるよね？うん。"}, {"type": "subtitle", "time": 2899.03, "timestamp": "00:48:19", "text": "これは私たちの、つまり、私たちはすでに"}, {"type": "subtitle", "time": 2902.95, "timestamp": "00:48:22", "text": "以前のグループ通話で。うん。それは私たちの"}, {"type": "subtitle", "time": 2906.309, "timestamp": "00:48:26", "text": "初めてです。"}, {"type": "subtitle", "time": 2907.829, "timestamp": "00:48:27", "text": "一緒に。"}, {"type": "subtitle", "time": 2910.15, "timestamp": "00:48:30", "text": "うん。"}, {"type": "subtitle", "time": 2912.71, "timestamp": "00:48:32", "text": "私はそうする必要は全くありません。私は雇われてこう言った"}, {"type": "subtitle", "time": 2914.95, "timestamp": "00:48:34", "text": "もの。私はミツが"}, {"type": "subtitle", "time": 2917.43, "timestamp": "00:48:37", "text": "彼ら。あなたたちは私にとても意地悪です。彼は"}, {"type": "subtitle", "time": 2920.23, "timestamp": "00:48:40", "text": "小さな男の子。彼はまだ赤ちゃんだ。そして"}, {"type": "subtitle", "time": 2921.99, "timestamp": "00:48:41", "text": "君たちは、君たちは、"}, {"type": "subtitle", "time": 2923.67, "timestamp": "00:48:43", "text": "赤ちゃん、今すぐ。どう思いますか？"}, {"type": "subtitle", "time": 2925.99, "timestamp": "00:48:45", "text": "赤ちゃんをいじめる？はぁ？気分はどうですか"}, {"type": "subtitle", "time": 2927.829, "timestamp": "00:48:47", "text": "あなたがいじめた"}, {"type": "subtitle", "time": 2929.91, "timestamp": "00:48:49", "text": "赤ちゃん？幸せですか？あなたは誇りに思う"}, {"type": "subtitle", "time": 2934.87, "timestamp": "00:48:54", "text": "自分でチャットする？彼はまだ赤ちゃんだ。"}, {"type": "subtitle", "time": 2936.63, "timestamp": "00:48:56", "text": "はい、チャットは繋がっています。チャット"}]
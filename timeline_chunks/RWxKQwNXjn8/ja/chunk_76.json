[{"type": "subtitle", "time": 4562.229, "timestamp": "01:16:02", "text": "右。うん。いや、物語とかそういう類いのやつ。"}, {"type": "subtitle", "time": 4564.55, "timestamp": "01:16:04", "text": "私は書きたかった。だから私は"}, {"type": "subtitle", "time": 4567.11, "timestamp": "01:16:07", "text": "英語文学を学べることを願っています"}, {"type": "subtitle", "time": 4569.03, "timestamp": "01:16:09", "text": "簡単な学位を取得し、"}, {"type": "subtitle", "time": 4571.83, "timestamp": "01:16:11", "text": "物語を書くために、私は書く。"}, {"type": "subtitle", "time": 4575.03, "timestamp": "01:16:15", "text": "思ったようにはいかなかった。"}, {"type": "subtitle", "time": 4579.11, "timestamp": "01:16:19", "text": "残念ながら、大丈夫です。正直に言うと、"}, {"type": "subtitle", "time": 4581.11, "timestamp": "01:16:21", "text": "アドバイスが欲しい場合や"}, {"type": "subtitle", "time": 4583.59, "timestamp": "01:16:23", "text": "何か書いてください。そうすれば、私たちにも何かできることがあります。"}, {"type": "subtitle", "time": 4588.87, "timestamp": "01:16:28", "text": "わかった。仕事の計画を書き始めなければならない。"}, {"type": "subtitle", "time": 4591.189, "timestamp": "01:16:31", "text": "わかった。カラスを閉じ込める。ロックイン。ロックイン"}, {"type": "subtitle", "time": 4603.27, "timestamp": "01:16:43", "text": "A. 小さなスポーツマンタイプのテディベアです。ジョック。"}, {"type": "subtitle", "time": 4605.35, "timestamp": "01:16:45", "text": "いつになったら、俺たちはスポーツ選手として商品化されるようになるんだ？"}, {"type": "subtitle", "time": 4610.47, "timestamp": "01:16:50", "text": "いつになったらジョックが手に入るの？"}, {"type": "subtitle", "time": 4613.669, "timestamp": "01:16:53", "text": "販売可能なぬいぐるみ？何かありますか？"}, {"type": "subtitle", "time": 4615.83, "timestamp": "01:16:55", "text": "製造する会社"}, {"type": "subtitle", "time": 4618.07, "timestamp": "01:16:58", "text": "インドで？"}]
[{"type": "subtitle", "time": 2161.19, "timestamp": "00:36:01", "text": "筆で描いたやつは、確かインクだったと思う。わかった、"}, {"type": "subtitle", "time": 2163.67, "timestamp": "00:36:03", "text": "それはインクだった。そう、それだ。ジョックは今"}, {"type": "subtitle", "time": 2167.67, "timestamp": "00:36:07", "text": "ケモナー。彼はBBCにたどり着くだろうか？私たちは"}, {"type": "subtitle", "time": 2169.99, "timestamp": "00:36:09", "text": "ジョックにBBCを与える。何をするの？何をするの？"}, {"type": "subtitle", "time": 2173.67, "timestamp": "00:36:13", "text": "それはどういう意味ですか？はぁ？私はBBCに出演しています。"}, {"type": "subtitle", "time": 2175.75, "timestamp": "00:36:15", "text": "いや、いや、いや。"}, {"type": "subtitle", "time": 2179.99, "timestamp": "00:36:19", "text": "BBCと「ああ、BBC」は別物だ。"}, {"type": "subtitle", "time": 2185.43, "timestamp": "00:36:25", "text": "イギリス人。あぁ、忘れてた、忘れてた"}, {"type": "subtitle", "time": 2188.55, "timestamp": "00:36:28", "text": "えっと、何でしたっけ？イギリス"}, {"type": "subtitle", "time": 2192.15, "timestamp": "00:36:32", "text": "えーと、ブランドチャンネル。いいえ。私もそうは思いません。"}, {"type": "subtitle", "time": 2197.91, "timestamp": "00:36:37", "text": "えっと、"}, {"type": "subtitle", "time": 2201.349, "timestamp": "00:36:41", "text": "こんにちは、ナッシュ。フォローありがとうございます。"}, {"type": "subtitle", "time": 2203.829, "timestamp": "00:36:43", "text": "大きな黒いワニ。"}, {"type": "subtitle", "time": 2206.39, "timestamp": "00:36:46", "text": "英国放送協会。うん、"}, {"type": "subtitle", "time": 2208.23, "timestamp": "00:36:48", "text": "ありがとう。ああ、そうだね。ありがとう"}, {"type": "subtitle", "time": 2211.03, "timestamp": "00:36:51", "text": "ナシャ。ありがとう。ありがとう。どちらも大好きです"}, {"type": "subtitle", "time": 2213.43, "timestamp": "00:36:53", "text": "BBCの。私たちは"}, {"type": "subtitle", "time": 2216.95, "timestamp": "00:36:56", "text": "他のBBC。いいえ、"}]
[{"type": "subtitle", "time": 11162.389, "timestamp": "03:06:02", "text": "チキンジョッキー。"}, {"type": "subtitle", "time": 11164.79, "timestamp": "03:06:04", "text": "チキン犬。そうそう。そういうこともある"}, {"type": "subtitle", "time": 11167.51, "timestamp": "03:06:07", "text": "チキンジョッキーみたいなやつだよね？うん、"}, {"type": "subtitle", "time": 11170.309, "timestamp": "03:06:10", "text": "それは本当にひどいと感じたよ、兄弟。私"}, {"type": "subtitle", "time": 11173.19, "timestamp": "03:06:13", "text": "問題は、私は"}, {"type": "subtitle", "time": 11175.51, "timestamp": "03:06:15", "text": "マインクラフトの映画で声優を務めた。いいえ、"}, {"type": "subtitle", "time": 11178.95, "timestamp": "03:06:18", "text": "問題は VC のような R&P 塊茎にあります。"}, {"type": "subtitle", "time": 11181.11, "timestamp": "03:06:21", "text": "こいつらは、"}, {"type": "subtitle", "time": 11183.349, "timestamp": "03:06:23", "text": "チキンジョッキー"}, {"type": "subtitle", "time": 11185.91, "timestamp": "03:06:25", "text": "そして今、それが私の頭から離れない。私は責める"}, {"type": "subtitle", "time": 11195.11, "timestamp": "03:06:35", "text": "何てことだ。"}, {"type": "subtitle", "time": 11196.87, "timestamp": "03:06:36", "text": "美しい。どれも美しいですね。"}, {"type": "subtitle", "time": 11200.15, "timestamp": "03:06:40", "text": "チシュ、もしあなたが"}, {"type": "subtitle", "time": 11202.15, "timestamp": "03:06:42", "text": "ダークサイド、"}, {"type": "subtitle", "time": 11204.79, "timestamp": "03:06:44", "text": "少なくとも私たちはあなたがクールであることは知っています"}, {"type": "subtitle", "time": 11211.429, "timestamp": "03:06:51", "text": "ああ、昔はダークなスポーツマンがいて、"}, {"type": "subtitle", "time": 11214.95, "timestamp": "03:06:54", "text": "などなど。黒髪とかそういう感じ。ああ、"}, {"type": "subtitle", "time": 11217.91, "timestamp": "03:06:57", "text": "神。邪悪なスポーツマン。"}]
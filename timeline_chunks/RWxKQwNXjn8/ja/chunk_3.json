[{"type": "subtitle", "time": 189.35, "timestamp": "00:03:09", "text": "うん、気持ちわかるよ。初めて"}, {"type": "subtitle", "time": 191.99, "timestamp": "00:03:11", "text": "Minecraftをプレイしたことがあるのは私です"}, {"type": "subtitle", "time": 194.949, "timestamp": "00:03:14", "text": "つる植物を殴り倒す、"}, {"type": "subtitle", "time": 197.43, "timestamp": "00:03:17", "text": "クモ、骸骨、骸骨、そして男"}, {"type": "subtitle", "time": 200.39, "timestamp": "00:03:20", "text": "素手で、知らなかったから"}, {"type": "subtitle", "time": 202.949, "timestamp": "00:03:22", "text": "これらのツールや"}, {"type": "subtitle", "time": 204.55, "timestamp": "00:03:24", "text": "剣が必要です。私は知りません。"}, {"type": "subtitle", "time": 208.22899999999998, "timestamp": "00:03:28", "text": "工作材料など全て揃っています。"}, {"type": "subtitle", "time": 211.36, "timestamp": "00:03:31", "text": "とても楽しかった。"}, {"type": "subtitle", "time": 213.19, "timestamp": "00:03:33", "text": "[音楽]"}, {"type": "subtitle", "time": 216.789, "timestamp": "00:03:36", "text": "モンスターを倒すのはとても楽しかった"}, {"type": "subtitle", "time": 221.91, "timestamp": "00:03:41", "text": "BFSはFPSスキルを使って回避します"}, {"type": "subtitle", "time": 225.99, "timestamp": "00:03:45", "text": "そしてクソ野郎を避けて"}, {"type": "subtitle", "time": 228.22899999999998, "timestamp": "00:03:48", "text": "とても楽しかった。"}, {"type": "subtitle", "time": 231.11, "timestamp": "00:03:51", "text": "しかし、ハードコアにも"}, {"type": "subtitle", "time": 234.869, "timestamp": "00:03:54", "text": "そして私は死んだ"}]
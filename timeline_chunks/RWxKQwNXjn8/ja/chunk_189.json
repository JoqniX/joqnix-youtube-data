[{"type": "subtitle", "time": 11342.63, "timestamp": "03:09:02", "text": "今月は私の月です。親切にしなければならない"}, {"type": "subtitle", "time": 11345.67, "timestamp": "03:09:05", "text": "自分。プライド月間です。"}, {"type": "subtitle", "time": 11352.389, "timestamp": "03:09:12", "text": "実際はアンドロセクシャルです。おお、それは"}, {"type": "subtitle", "time": 11355.19, "timestamp": "03:09:15", "text": "面白い。もちろん。"}, {"type": "subtitle", "time": 11358.07, "timestamp": "03:09:18", "text": "まるで、自分を愛しているみたいですよね？いいえ、"}, {"type": "subtitle", "time": 11369.91, "timestamp": "03:09:29", "text": "ありがとう、ミッド。あと、言い忘れてたんだけど"}, {"type": "subtitle", "time": 11373.67, "timestamp": "03:09:33", "text": "こんにちは。またお会いできて嬉しいです。"}, {"type": "subtitle", "time": 11379.83, "timestamp": "03:09:39", "text": "ハッピー・プライド、ガールフレンドの皆さん。"}, {"type": "subtitle", "time": 11381.349, "timestamp": "03:09:41", "text": "私は捕まらない。彼らは"}, {"type": "subtitle", "time": 11383.19, "timestamp": "03:09:43", "text": "絶対に私を捕まえられない。聞いてくれ、いいかい、私たちは昔"}, {"type": "subtitle", "time": 11386.15, "timestamp": "03:09:46", "text": "子供の頃はよく警察ごっこをして遊んで、"}, {"type": "subtitle", "time": 11388.309, "timestamp": "03:09:48", "text": "彼らは決して手に入れなかった。知ってるか？私"}, {"type": "chat", "time": 11389.771, "timestamp": "03:09:49", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "are you sleepy?"}, {"type": "subtitle", "time": 11390.63, "timestamp": "03:09:50", "text": "とても滑りやすかった。彼らは捕まえようとするだろう"}, {"type": "subtitle", "time": 11393.269, "timestamp": "03:09:53", "text": "私ですが、私はただ彼らの"}, {"type": "subtitle", "time": 11395.75, "timestamp": "03:09:55", "text": "把握する。私は走るだろうが、彼らは走らないだろう"}]
[{"type": "subtitle", "time": 4680.95, "timestamp": "01:18:00", "text": "やりたいときにやるべきこと"}, {"type": "subtitle", "time": 4684.31, "timestamp": "01:18:04", "text": "すでに簡略化されているため、ぬいぐるみのような質感です"}, {"type": "subtitle", "time": 4687.11, "timestamp": "01:18:07", "text": "十分。うん。"}, {"type": "subtitle", "time": 4693.99, "timestamp": "01:18:13", "text": "顔を赤らめる。"}, {"type": "subtitle", "time": 4708.55, "timestamp": "01:18:28", "text": "持続する。ちょっと席を外さなければならなかった。おお"}, {"type": "subtitle", "time": 4724.39, "timestamp": "01:18:44", "text": "あのね？待っている間に、"}, {"type": "subtitle", "time": 4728.229, "timestamp": "01:18:48", "text": "ジョック、君も猫として描いてあげよう。"}, {"type": "subtitle", "time": 4731.669, "timestamp": "01:18:51", "text": "うん。君を小さな猫として描いてみるよ。"}, {"type": "subtitle", "time": 4739.11, "timestamp": "01:18:59", "text": "チョ"}]
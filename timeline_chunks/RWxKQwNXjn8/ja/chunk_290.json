[{"type": "subtitle", "time": 17410.15, "timestamp": "04:50:10", "text": "私はハンドラーになるつもりです"}, {"type": "subtitle", "time": 17412.628, "timestamp": "04:50:12", "text": "次。こんにちは。"}, {"type": "subtitle", "time": 17415.35, "timestamp": "04:50:15", "text": "さぁ行こう。こんにちは。私たちはあなたの2倍のことをします"}, {"type": "subtitle", "time": 17421.03, "timestamp": "04:50:21", "text": "準備は整いました。"}, {"type": "subtitle", "time": 17422.55, "timestamp": "04:50:22", "text": "隣にあるデジタル時計に気づきましたか？"}, {"type": "subtitle", "time": 17426.788, "timestamp": "04:50:26", "text": "爆弾箱には正確な時刻が表示されている"}, {"type": "subtitle", "time": 17429.83, "timestamp": "04:50:29", "text": "そうそう。私もそれに気づきました。忙しすぎる"}, {"type": "subtitle", "time": 17431.43, "timestamp": "04:50:31", "text": "爆弾を見て気づくことができる"}, {"type": "subtitle", "time": 17435.67, "timestamp": "04:50:35", "text": "そんな感じ。現地時間。"}, {"type": "subtitle", "time": 17437.51, "timestamp": "04:50:37", "text": "よし、やろう。準備はできたか、"}, {"type": "subtitle", "time": 17441.27, "timestamp": "04:50:41", "text": "ミア？起動。えっと、"}, {"type": "subtitle", "time": 17443.99, "timestamp": "04:50:43", "text": "待って。あなたが始めたのですか？うん。"}, {"type": "subtitle", "time": 17447.83, "timestamp": "04:50:47", "text": "え、何？わかった。よし。"}, {"type": "subtitle", "time": 17451.03, "timestamp": "04:50:51", "text": "教えて。つまり、ワイヤーモジュールが1つあるということですね。"}, {"type": "subtitle", "time": 17453.11, "timestamp": "04:50:53", "text": "いいえ、2つのワイヤモジュール、2つのシンプルな"}, {"type": "subtitle", "time": 17455.83, "timestamp": "04:50:55", "text": "モジュール、ボタン2つ。配線をしましょう"}, {"type": "subtitle", "time": 17458.788, "timestamp": "04:50:58", "text": "初め。わかった。ワイヤー。だから、私は見ている"}]
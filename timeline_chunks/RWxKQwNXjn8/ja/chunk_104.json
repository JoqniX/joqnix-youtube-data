[{"type": "subtitle", "time": 6241.109, "timestamp": "01:44:01", "text": "ピクと私は気づいた、ブリューは"}, {"type": "subtitle", "time": 6244.149, "timestamp": "01:44:04", "text": "危険な場合もある？私のチャンネルは"}, {"type": "subtitle", "time": 6246.87, "timestamp": "01:44:06", "text": "非営利のため危険など"}, {"type": "subtitle", "time": 6251.109, "timestamp": "01:44:11", "text": "あれのことですよね？うんうん。それで私はこう思った"}, {"type": "subtitle", "time": 6253.91, "timestamp": "01:44:13", "text": "私は星が好きなように思い出す"}, {"type": "subtitle", "time": 6256.47, "timestamp": "01:44:16", "text": "昔はよく星空を眺めていたから"}, {"type": "subtitle", "time": 6258.79, "timestamp": "01:44:18", "text": "子供。流れ星が好きで"}, {"type": "subtitle", "time": 6260.31, "timestamp": "01:44:20", "text": "すべて。"}, {"type": "subtitle", "time": 6264.39, "timestamp": "01:44:24", "text": "それで、最初の"}, {"type": "subtitle", "time": 6267.189, "timestamp": "01:44:27", "text": "インスピレーションが湧いてきたのは、"}, {"type": "subtitle", "time": 6269.109, "timestamp": "01:44:29", "text": "星座"}, {"type": "subtitle", "time": 6272.47, "timestamp": "01:44:32", "text": "実体のような存在になる"}, {"type": "subtitle", "time": 6274.629, "timestamp": "01:44:34", "text": "えーと、制御して守る"}, {"type": "subtitle", "time": 6277.59, "timestamp": "01:44:37", "text": "星座とその他すべて"}, {"type": "subtitle", "time": 6280.709, "timestamp": "01:44:40", "text": "そうやって領主は拡大していった"}, {"type": "subtitle", "time": 6284.149, "timestamp": "01:44:44", "text": "時間だと思いますが、現在私が持っているのは"}, {"type": "subtitle", "time": 6287.03, "timestamp": "01:44:47", "text": "どちらかというと、快適なスポーツマンといった感じ"}, {"type": "subtitle", "time": 6289.43, "timestamp": "01:44:49", "text": "えっと、だからパーカーとか着心地がいいんだよ"}, {"type": "subtitle", "time": 6293.109, "timestamp": "01:44:53", "text": "快適なウェアタイプとピアスと"}, {"type": "subtitle", "time": 6295.99, "timestamp": "01:44:55", "text": "周囲に溶け込みたかったから"}, {"type": "subtitle", "time": 6299.35, "timestamp": "01:44:59", "text": "かっこよくなろうよ。よくわからない。あなた"}]
[{"type": "subtitle", "time": 12482.55, "timestamp": "03:28:02", "text": "[音楽]"}, {"type": "subtitle", "time": 12485.83, "timestamp": "03:28:05", "text": "ソーシャルリンクみたいなものを作りたいんです"}, {"type": "subtitle", "time": 12487.99, "timestamp": "03:28:07", "text": "このような。"}, {"type": "subtitle", "time": 12491.349, "timestamp": "03:28:11", "text": "私はそうすべきかどうかわからない"}, {"type": "subtitle", "time": 12493.59, "timestamp": "03:28:13", "text": "メディアを作る必要はなくショーケース"}, {"type": "subtitle", "time": 12496.469, "timestamp": "03:28:16", "text": "メディアキットやスラッシュのようなプロ向けのキットができました"}, {"type": "subtitle", "time": 12499.75, "timestamp": "03:28:19", "text": "ブランドであればプレスキットが必要です"}, {"type": "subtitle", "time": 12502.71, "timestamp": "03:28:22", "text": "ソーシャルメディアのフォロワー数はいくつですか？"}, {"type": "subtitle", "time": 12504.389, "timestamp": "03:28:24", "text": "どれくらい成長するのか、目標は何か"}, {"type": "subtitle", "time": 12507.59, "timestamp": "03:28:27", "text": "聴衆などなど、詳細を知りたい"}, {"type": "subtitle", "time": 12509.83, "timestamp": "03:28:29", "text": "そしてそれをブランドなどに送る"}, {"type": "subtitle", "time": 12511.99, "timestamp": "03:28:31", "text": "スポンサーシップおよび申請について"}, {"type": "subtitle", "time": 12519.91, "timestamp": "03:28:39", "text": "カードには、このカードの埋め込みが表示されます。それで"}, {"type": "subtitle", "time": 12522.07, "timestamp": "03:28:42", "text": "このカードをお持ちでない場合は、"}, {"type": "subtitle", "time": 12525.51, "timestamp": "03:28:45", "text": "このカードを使用する方法として、"}, {"type": "subtitle", "time": 12528.389, "timestamp": "03:28:48", "text": "すべて横に添えて。"}, {"type": "subtitle", "time": 12531.59, "timestamp": "03:28:51", "text": "プログラマーを見つけなきゃいけないんだ、"}, {"type": "subtitle", "time": 12533.51, "timestamp": "03:28:53", "text": "計画していなかったことがたくさんあり、"}, {"type": "subtitle", "time": 12536.71, "timestamp": "03:28:56", "text": "右？モバイルアプリ、"}]
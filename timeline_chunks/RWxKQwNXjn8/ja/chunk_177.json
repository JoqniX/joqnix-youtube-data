[{"type": "subtitle", "time": 10621.19, "timestamp": "02:57:01", "text": "一番好きなもの？わからない。りんご。"}, {"type": "subtitle", "time": 10622.71, "timestamp": "02:57:02", "text": "りんご？"}, {"type": "subtitle", "time": 10625.269, "timestamp": "02:57:05", "text": "わからない。"}, {"type": "subtitle", "time": 10632.07, "timestamp": "02:57:12", "text": "私は落書きをするのが大好きです。いつものように"}, {"type": "subtitle", "time": 10633.75, "timestamp": "02:57:13", "text": "落書きをしていた"}, {"type": "subtitle", "time": 10636.469, "timestamp": "02:57:16", "text": "勉強する。"}, {"type": "subtitle", "time": 10641.67, "timestamp": "02:57:21", "text": "ヒンディー語を自分のものだと主張したくなる衝動を見てください。しないで"}, {"type": "subtitle", "time": 10644.309, "timestamp": "02:57:24", "text": "よくもそんなことを。いや、いや、いや。悪い"}, {"type": "subtitle", "time": 10647.429, "timestamp": "02:57:27", "text": "チャット。ジョークをそのまま入力するよ。あなた"}, {"type": "subtitle", "time": 10650.389, "timestamp": "02:57:30", "text": "瓶には触れてはいけません。何？心配しないで"}, {"type": "subtitle", "time": 10651.99, "timestamp": "02:57:31", "text": "そのジョークについて。彼らはただ彼らは"}, {"type": "subtitle", "time": 10655.75, "timestamp": "02:57:35", "text": "彼らは私を倒そうとしている。"}, {"type": "subtitle", "time": 10658.389, "timestamp": "02:57:38", "text": "おお、"}, {"type": "subtitle", "time": 10660.15, "timestamp": "02:57:40", "text": "彼らは彼らは試みている 彼らは試みている"}, {"type": "subtitle", "time": 10661.75, "timestamp": "02:57:41", "text": "私にちょっかい出すなよ。彼らは、"}, {"type": "subtitle", "time": 10664.15, "timestamp": "02:57:44", "text": "私を揺さぶってみて。彼らは奪おうとしている"}, {"type": "subtitle", "time": 10668.23, "timestamp": "02:57:48", "text": "私の瓶を振ってください。"}, {"type": "subtitle", "time": 10669.83, "timestamp": "02:57:49", "text": "ねえ、ジョー？私は行くつもりです"}, {"type": "subtitle", "time": 10671.51, "timestamp": "02:57:51", "text": "ジョーの後ろに隠れて。私はただ隠れるだけです"}, {"type": "subtitle", "time": 10673.51, "timestamp": "02:57:53", "text": "ジョックの後ろにいる。"}, {"type": "subtitle", "time": 10675.429, "timestamp": "02:57:55", "text": "私はジョーの後ろに隠れている。君たちは手に入れることができない"}, {"type": "subtitle", "time": 10678.15, "timestamp": "02:57:58", "text": "今の私。"}]
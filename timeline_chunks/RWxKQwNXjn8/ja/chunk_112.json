[{"type": "subtitle", "time": 6727.43, "timestamp": "01:52:07", "text": "いいえ。あなたが自由になったら、私は"}, {"type": "subtitle", "time": 6729.51, "timestamp": "01:52:09", "text": "猫の動画がたくさんあるので、お見せします。"}, {"type": "subtitle", "time": 6732.31, "timestamp": "01:52:12", "text": "あなた。何てことだ。わーい。"}, {"type": "subtitle", "time": 6736.629, "timestamp": "01:52:16", "text": "はい。はい。はい、どうぞご自由に。"}, {"type": "subtitle", "time": 6739.669, "timestamp": "01:52:19", "text": "私たちは座る必要がある 私たちは置く必要がある"}, {"type": "subtitle", "time": 6743.35, "timestamp": "01:52:23", "text": "百万匹の猫のように、あなたは落ち込んで見守る"}, {"type": "subtitle", "time": 6746.47, "timestamp": "01:52:26", "text": "動画。あなたはたくさんのものを逃しています"}, {"type": "subtitle", "time": 6754.79, "timestamp": "01:52:34", "text": "だから、私たちはたくさんのくだらないものを持っている"}, {"type": "subtitle", "time": 6758.07, "timestamp": "01:52:38", "text": "ここ数日、ビデオ会議で行われた。"}, {"type": "subtitle", "time": 6760.07, "timestamp": "01:52:40", "text": "何てことだ。"}, {"type": "subtitle", "time": 6763.35, "timestamp": "01:52:43", "text": "うん。ああ、君たちは本当に"}, {"type": "subtitle", "time": 6765.589, "timestamp": "01:52:45", "text": "今見ている時間、私たちが見ている"}, {"type": "subtitle", "time": 6769.669, "timestamp": "01:52:49", "text": "彼ら。うん、私は毎日みんなに連絡してるよ"}, {"type": "subtitle", "time": 6772.07, "timestamp": "01:52:52", "text": "彼らに遊びたいかどうか尋ねる"}, {"type": "subtitle", "time": 6778.629, "timestamp": "01:52:58", "text": "ねえ、君たちまだそれやってるの？ああ、私は"}]
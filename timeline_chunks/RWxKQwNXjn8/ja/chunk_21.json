[{"type": "subtitle", "time": 1261.99, "timestamp": "00:21:01", "text": "毎日。うん。しかし、３つすべてと同じように"}, {"type": "subtitle", "time": 1266.149, "timestamp": "00:21:06", "text": "一日の食事の中で、米はそうではない。"}, {"type": "subtitle", "time": 1268.87, "timestamp": "00:21:08", "text": "本物。"}, {"type": "subtitle", "time": 1270.95, "timestamp": "00:21:10", "text": "何てことだ、"}, {"type": "subtitle", "time": 1272.549, "timestamp": "00:21:12", "text": "男。"}, {"type": "subtitle", "time": 1274.95, "timestamp": "00:21:14", "text": "それは冗談です。私たちは今でもあなたを愛しています"}, {"type": "subtitle", "time": 1285.59, "timestamp": "00:21:25", "text": "何てことだ。ああ、わかった。ああ、お気に入り"}, {"type": "subtitle", "time": 1289.19, "timestamp": "00:21:29", "text": "朝食。私は何をしますか？なぜ人々は"}, {"type": "subtitle", "time": 1291.35, "timestamp": "00:21:31", "text": "朝食にビスケットを食べる？それは"}, {"type": "subtitle", "time": 1294.549, "timestamp": "00:21:34", "text": "でも、お腹を満たすのに役立ちますよ。しかし、"}, {"type": "subtitle", "time": 1296.23, "timestamp": "00:21:36", "text": "食べますか？たくさん食べると"}, {"type": "subtitle", "time": 1300.71, "timestamp": "00:21:40", "text": "たくさん食べると。うん。パンケーキ。"}, {"type": "subtitle", "time": 1303.59, "timestamp": "00:21:43", "text": "私はあらゆる場所でパンケーキクレーターを食べようとしました"}, {"type": "subtitle", "time": 1306.789, "timestamp": "00:21:46", "text": "その日、私は苦しんだ。私は何も食べられなかった。"}, {"type": "subtitle", "time": 1309.669, "timestamp": "00:21:49", "text": "私はパンケーキが大好きです"}, {"type": "subtitle", "time": 1314.63, "timestamp": "00:21:54", "text": "だって、今は食べ物が山ほどあったから。ビスケット。"}, {"type": "subtitle", "time": 1316.87, "timestamp": "00:21:56", "text": "それは白人の食べ物です。だから私たちは"}, {"type": "subtitle", "time": 1319.43, "timestamp": "00:21:59", "text": "理解できないだろう。白人だと思う。おお"}]
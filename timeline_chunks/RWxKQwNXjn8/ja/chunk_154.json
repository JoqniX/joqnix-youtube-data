[{"type": "subtitle", "time": 9247.99, "timestamp": "02:34:07", "text": "うん。なぜあなたは違うものを持っているのですか"}, {"type": "subtitle", "time": 9250.469, "timestamp": "02:34:10", "text": "発音は？ P."}, {"type": "subtitle", "time": 9260.15, "timestamp": "02:34:20", "text": "パンダは、"}, {"type": "subtitle", "time": 9262.63, "timestamp": "02:34:22", "text": "空中を通り抜けて全体を回ります"}, {"type": "subtitle", "time": 9264.15, "timestamp": "02:34:24", "text": "もの。"}, {"type": "subtitle", "time": 9267.19, "timestamp": "02:34:27", "text": "あなたは私の息子にとても意地悪です。"}, {"type": "subtitle", "time": 9279.429, "timestamp": "02:34:39", "text": "研磨。研磨。研磨。研磨。おお、"}, {"type": "subtitle", "time": 9282.79, "timestamp": "02:34:42", "text": "研磨。研磨。研磨。私は言っている"}, {"type": "subtitle", "time": 9285.51, "timestamp": "02:34:45", "text": "今すぐそうする。右。研磨。"}, {"type": "subtitle", "time": 9287.59, "timestamp": "02:34:47", "text": "研磨。研磨。理解できましたか？私は"}, {"type": "subtitle", "time": 9289.83, "timestamp": "02:34:49", "text": "わかった？私は 私は 私は 私は 私は 私はもう"}]
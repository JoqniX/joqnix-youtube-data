[{"type": "subtitle", "time": 3841.19, "timestamp": "01:04:01", "text": "彼に聞かれなくてもいいのがいい。"}, {"type": "subtitle", "time": 3842.71, "timestamp": "01:04:02", "text": "大丈夫です。大丈夫です。あなたはただ"}, {"type": "subtitle", "time": 3846.23, "timestamp": "01:04:06", "text": "パンダの絵を描いている。ええ、私は"}, {"type": "subtitle", "time": 3848.63, "timestamp": "01:04:08", "text": "参考資料とかパンダのぬいぐるみとか"}, {"type": "subtitle", "time": 3850.63, "timestamp": "01:04:10", "text": "そして、まるで私がそれを描いているかのように。おお。私は"}, {"type": "subtitle", "time": 3853.029, "timestamp": "01:04:13", "text": "参照も使用しています。もしあなたが望むなら"}, {"type": "subtitle", "time": 3855.19, "timestamp": "01:04:15", "text": "絵を描くには、参考資料が必要です。"}, {"type": "subtitle", "time": 3878.069, "timestamp": "01:04:38", "text": "これはジョーのお気に入りのセリフです"}, {"type": "subtitle", "time": 3885.829, "timestamp": "01:04:45", "text": "何てことだ。"}, {"type": "subtitle", "time": 3887.349, "timestamp": "01:04:47", "text": "通常のクマの毛幅はどれくらいですか？"}, {"type": "subtitle", "time": 3889.19, "timestamp": "01:04:49", "text": "技術的には、すべてのBSは通常のBだからです。"}, {"type": "subtitle", "time": 3894.23, "timestamp": "01:04:54", "text": "もっと見やすくフォーマットできますよ。私"}]
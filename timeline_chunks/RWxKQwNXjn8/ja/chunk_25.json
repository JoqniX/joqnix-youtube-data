[{"type": "subtitle", "time": 1503.029, "timestamp": "00:25:03", "text": "ああ、そうだね。"}, {"type": "subtitle", "time": 1504.63, "timestamp": "00:25:04", "text": "でも、私はあなたがあなただとは思わない"}, {"type": "subtitle", "time": 1507.51, "timestamp": "00:25:07", "text": "あなたは大きいか毛深いかのどちらかなので、"}, {"type": "subtitle", "time": 1509.35, "timestamp": "00:25:09", "text": "普通のクマを作るだけ"}, {"type": "subtitle", "time": 1511.43, "timestamp": "00:25:11", "text": "その代わり。"}, {"type": "subtitle", "time": 1513.19, "timestamp": "00:25:13", "text": "ええ、レズビアンみたいな人もいます"}, {"type": "subtitle", "time": 1515.11, "timestamp": "00:25:15", "text": "彼女たちはママベアでもあり、"}, {"type": "subtitle", "time": 1524.149, "timestamp": "00:25:24", "text": "わかった。わかった。それでは、"}, {"type": "subtitle", "time": 1525.83, "timestamp": "00:25:25", "text": "さまざまな種類のクマ。私たちは、"}, {"type": "subtitle", "time": 1529.51, "timestamp": "00:25:29", "text": "かわいいクマさん。待って、レッサーパンダは"}, {"type": "subtitle", "time": 1532.39, "timestamp": "00:25:32", "text": "クマ？は"}, {"type": "subtitle", "time": 1535.11, "timestamp": "00:25:35", "text": "レッサーパンダ"}, {"type": "subtitle", "time": 1537.269, "timestamp": "00:25:37", "text": "クマ？"}, {"type": "subtitle", "time": 1544.95, "timestamp": "00:25:44", "text": "クマ。"}, {"type": "subtitle", "time": 1548.31, "timestamp": "00:25:48", "text": "わかった。ジョギングしながら探す。"}, {"type": "subtitle", "time": 1550.87, "timestamp": "00:25:50", "text": "そして、どんなクマになれるのか、どんな種類のクマになれるのか"}, {"type": "subtitle", "time": 1557.43, "timestamp": "00:25:57", "text": "それで"}]
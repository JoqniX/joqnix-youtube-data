[{"type": "subtitle", "time": 5941.91, "timestamp": "01:39:01", "text": "えっと、何て呼ばれてたっけ？"}, {"type": "subtitle", "time": 5946.95, "timestamp": "01:39:06", "text": "ファレット。いいえ。ナマケモノではありません。ああ、覚えてるよね"}, {"type": "subtitle", "time": 5949.75, "timestamp": "01:39:09", "text": "Fで始まるんですよね？もし私が"}, {"type": "subtitle", "time": 5955.99, "timestamp": "01:39:15", "text": "正しい。それはフェットですか？いいえ。フェレットです。"}, {"type": "subtitle", "time": 5958.229, "timestamp": "01:39:18", "text": "それはあなたがずっと前に言っていたものですか？私"}, {"type": "subtitle", "time": 5961.51, "timestamp": "01:39:21", "text": "スロットを見るのが好き、または何か"}, {"type": "subtitle", "time": 5963.119, "timestamp": "01:39:23", "text": "何か とてもふわふわしていて、"}, {"type": "subtitle", "time": 5966.159, "timestamp": "01:39:26", "text": "とてもふわふわしていて、 とてもかわいい。うん、フェレットってすごく可愛いよね。"}, {"type": "subtitle", "time": 5968.639, "timestamp": "01:39:28", "text": "とてもかわいい。うん、フェレットってすごく可愛いよね。 私もフェレットが大好きです。"}, {"type": "subtitle", "time": 5972.159, "timestamp": "01:39:32", "text": "私もフェレットが大好きです。 ええ、彼らは実際には"}, {"type": "subtitle", "time": 5974.239, "timestamp": "01:39:34", "text": "ええ、彼らは実際には 狩猟の腕もかなり良い。彼らは"}, {"type": "subtitle", "time": 5976.8, "timestamp": "01:39:36", "text": "狩猟の腕もかなり良い。彼らは 小さくてかわいいけど、まるで"}, {"type": "subtitle", "time": 5979.119, "timestamp": "01:39:39", "text": "小さくてかわいいけど、まるで 捕食者のように。彼らは肉食動物です。"}, {"type": "subtitle", "time": 5986.39, "timestamp": "01:39:46", "text": "フェレットのようなものを見たことがありますか"}, {"type": "subtitle", "time": 5987.75, "timestamp": "01:39:47", "text": "動画ですか？"}, {"type": "subtitle", "time": 5991.91, "timestamp": "01:39:51", "text": "いや。ああ、なんてことだ。いいえ、私たちは、私たちは"}, {"type": "subtitle", "time": 5995.43, "timestamp": "01:39:55", "text": "「公平さを見せて」って、本当に可愛いよね。"}]
[{"type": "subtitle", "time": 11701.67, "timestamp": "03:15:01", "text": "今後はもっと一緒に過ごすべきだ。地獄"}, {"type": "subtitle", "time": 11706.389, "timestamp": "03:15:06", "text": "うん。私に「ノー」を教えてください。あのゲームはああ"}, {"type": "subtitle", "time": 11708.79, "timestamp": "03:15:08", "text": "神。はい、ジョー。あなたを訓練します"}, {"type": "subtitle", "time": 11711.67, "timestamp": "03:15:11", "text": "スピードランナーになろう、ジョー。"}, {"type": "subtitle", "time": 11712.79, "timestamp": "03:15:12", "text": "うん。"}, {"type": "subtitle", "time": 11715.67, "timestamp": "03:15:15", "text": "それでおしまい。トレーニングを開始します。"}, {"type": "subtitle", "time": 11717.99, "timestamp": "03:15:17", "text": "いつか旅に出よう。"}, {"type": "subtitle", "time": 11719.59, "timestamp": "03:15:19", "text": "うん。"}, {"type": "subtitle", "time": 11724.07, "timestamp": "03:15:24", "text": "よし。ジョー、お元気で。こんにちは。感謝"}, {"type": "subtitle", "time": 11726.95, "timestamp": "03:15:26", "text": "今日はあなたへ。素敵な夜をお過ごしください"}, {"type": "subtitle", "time": 11729.429, "timestamp": "03:15:29", "text": "さあ、皆さん、前へ進みましょう。"}, {"type": "subtitle", "time": 11733.19, "timestamp": "03:15:33", "text": "うん。バイバイ。こんにちは。バイバイ。バイバイ、"}, {"type": "subtitle", "time": 11740.229, "timestamp": "03:15:40", "text": "気をつけて。気をつけて。楽しむ。そして持っている"}, {"type": "subtitle", "time": 11742.15, "timestamp": "03:15:42", "text": "素晴らしいストリームでした。おやすみなさい。"}, {"type": "subtitle", "time": 11748.79, "timestamp": "03:15:48", "text": "先に。こんにちは。おやすみ。こんにちは。"}, {"type": "subtitle", "time": 11750.79, "timestamp": "03:15:50", "text": "つまり、ミシック・ウェールズだった人たちは皆"}, {"type": "subtitle", "time": 11754.71, "timestamp": "03:15:54", "text": "ホイールと、えっと、コラボレーションをやめなければなりません。"}, {"type": "subtitle", "time": 11757.99, "timestamp": "03:15:57", "text": "それは神話のウェールズであり、"}]
[{"type": "subtitle", "time": 5702.149, "timestamp": "01:35:02", "text": "ああ、これは私が目を覚ましたばかりです、"}, {"type": "subtitle", "time": 5706.709, "timestamp": "01:35:06", "text": "私は食事をして、また眠りにつく。"}, {"type": "subtitle", "time": 5708.95, "timestamp": "01:35:08", "text": "ジョー、君はどう？調子はどうですか？"}, {"type": "subtitle", "time": 5710.79, "timestamp": "01:35:10", "text": "あなたのために？"}, {"type": "subtitle", "time": 5713.59, "timestamp": "01:35:13", "text": "私の1日は、いつも通りだった。私は"}, {"type": "subtitle", "time": 5716.709, "timestamp": "01:35:16", "text": "現在、毎日24時間ストリーミング配信を行っています。"}, {"type": "subtitle", "time": 5720.709, "timestamp": "01:35:20", "text": "ああ、君は忙しかったんだね。"}, {"type": "subtitle", "time": 5723.669, "timestamp": "01:35:23", "text": "わからない。私はそれをする必要はありません"}, {"type": "subtitle", "time": 5726.39, "timestamp": "01:35:26", "text": "もう。最初はただ"}, {"type": "subtitle", "time": 5728.79, "timestamp": "01:35:28", "text": "YouTube、YouTube のようなもの"}, {"type": "subtitle", "time": 5732.229, "timestamp": "01:35:32", "text": "収益化に関するもの、視聴時間など。それから"}, {"type": "subtitle", "time": 5735.83, "timestamp": "01:35:35", "text": "私はそれを始めてから、"}, {"type": "subtitle", "time": 5739.59, "timestamp": "01:35:39", "text": "止められなかった。理由がわからない"}, {"type": "subtitle", "time": 5742.709, "timestamp": "01:35:42", "text": "終わらせるのがとても難しい"}, {"type": "subtitle", "time": 5747.03, "timestamp": "01:35:47", "text": "小川。ボタンはすぐそこにあります。"}, {"type": "subtitle", "time": 5749.75, "timestamp": "01:35:49", "text": "私はできません。でも、必ず"}, {"type": "subtitle", "time": 5752.47, "timestamp": "01:35:52", "text": "休憩も取っています"}, {"type": "subtitle", "time": 5755.189, "timestamp": "01:35:55", "text": "あなたはただ休んでいるだけではないから"}, {"type": "subtitle", "time": 5757.43, "timestamp": "01:35:57", "text": "ストリーマーを軽く動かす。あなたもジョギングをします"}]
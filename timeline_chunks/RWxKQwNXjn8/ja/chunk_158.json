[{"type": "subtitle", "time": 9480.79, "timestamp": "02:38:00", "text": "国歌を歌う？私は感じます"}, {"type": "subtitle", "time": 9483.429, "timestamp": "02:38:03", "text": "私は彼らをさらに怒らせるつもりだ。"}, {"type": "subtitle", "time": 9490.309, "timestamp": "02:38:10", "text": "ごめん。"}, {"type": "subtitle", "time": 9496.63, "timestamp": "02:38:16", "text": "私はキリスト教の聖書には載っていません"}, {"type": "subtitle", "time": 9501.03, "timestamp": "02:38:21", "text": "研磨。研磨。研磨。研磨。研磨。"}, {"type": "subtitle", "time": 9509.27, "timestamp": "02:38:29", "text": "研磨。わかった。大丈夫。ジョーを捕まえたよ。"}, {"type": "subtitle", "time": 9510.95, "timestamp": "02:38:30", "text": "私たちは勝つつもりだ"}, {"type": "subtitle", "time": 9514.469, "timestamp": "02:38:34", "text": "戻る。いずれは取り戻すだろう。"}, {"type": "subtitle", "time": 9517.349, "timestamp": "02:38:37", "text": "うん。"}, {"type": "subtitle", "time": 9518.87, "timestamp": "02:38:38", "text": "すべてうまくいくよ。ただ"}, {"type": "subtitle", "time": 9520.389, "timestamp": "02:38:40", "text": "君も知ってると思うけど、時々"}, {"type": "subtitle", "time": 9522.63, "timestamp": "02:38:42", "text": "いくつかの挫折で、あなたは全体を怒らせる"}, {"type": "subtitle", "time": 9524.389, "timestamp": "02:38:44", "text": "国"}, {"type": "subtitle", "time": 9527.83, "timestamp": "02:38:47", "text": "でも、あなたは続けていくし、"}, {"type": "subtitle", "time": 9530.95, "timestamp": "02:38:50", "text": "あなたの勝ちです。"}, {"type": "subtitle", "time": 9538.79, "timestamp": "02:38:58", "text": "何てことだ。私はあなたの"}]
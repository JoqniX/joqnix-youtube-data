[{"type": "subtitle", "time": 10200.79, "timestamp": "02:50:00", "text": "うーん、それはそのままにしておきましょう。私はユーチューバーです"}, {"type": "subtitle", "time": 10203.349, "timestamp": "02:50:03", "text": "推測。うん、私もそう思うよ"}, {"type": "subtitle", "time": 10206.63, "timestamp": "02:50:06", "text": "今でも良いものだと分かっています。そして、そうです、ゼン・キスミッド"}, {"type": "subtitle", "time": 10209.99, "timestamp": "02:50:09", "text": "インド人でもある。私はインド人ですが、"}, {"type": "subtitle", "time": 10212.71, "timestamp": "02:50:12", "text": "ネパール。おお、"}, {"type": "subtitle", "time": 10214.79, "timestamp": "02:50:14", "text": "ジョーは、みんなにとって特別な存在です。"}, {"type": "subtitle", "time": 10217.99, "timestamp": "02:50:17", "text": "誰もが知っているように真実を試みている"}, {"type": "subtitle", "time": 10220.07, "timestamp": "02:50:20", "text": "まるで、あなたが知っているような人が誰もいないかのように"}, {"type": "subtitle", "time": 10222.87, "timestamp": "02:50:22", "text": "共通点がない まったく知らない"}, {"type": "subtitle", "time": 10225.99, "timestamp": "02:50:25", "text": "少なくともジョックは少なくともいくつか持っているだろう"}, {"type": "subtitle", "time": 10229.19, "timestamp": "02:50:29", "text": "その人がどんな人物かというイメージ"}, {"type": "subtitle", "time": 10231.269, "timestamp": "02:50:31", "text": "しかし彼らはジョックが誰なのかを知っているだろう"}, {"type": "subtitle", "time": 10233.11, "timestamp": "02:50:33", "text": "は。"}, {"type": "subtitle", "time": 10235.11, "timestamp": "02:50:35", "text": "ジョックは今、本当に一生懸命祝福している。は"}, {"type": "subtitle", "time": 10238.469, "timestamp": "02:50:38", "text": "ジョックを祝福しているのか？"}, {"type": "subtitle", "time": 10240.95, "timestamp": "02:50:40", "text": "わからない。顔が赤くなってる？あなたは"}, {"type": "subtitle", "time": 10249.91, "timestamp": "02:50:49", "text": "ええ、彼はとても動揺しやすいんです。ジンは"}, {"type": "subtitle", "time": 10253.03, "timestamp": "02:50:53", "text": "非常に動揺しやすい。"}]
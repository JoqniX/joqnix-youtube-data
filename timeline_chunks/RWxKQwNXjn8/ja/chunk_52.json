[{"type": "subtitle", "time": 3136.47, "timestamp": "00:52:16", "text": "うん。いつから私に電話をかけてきたのですか？"}, {"type": "subtitle", "time": 3141.03, "timestamp": "00:52:21", "text": "もう2年くらい経ったと思う。"}, {"type": "subtitle", "time": 3146.309, "timestamp": "00:52:26", "text": "ああ。うん。 2年。うん。"}, {"type": "subtitle", "time": 3152.79, "timestamp": "00:52:32", "text": "追加します"}, {"type": "subtitle", "time": 3156.47, "timestamp": "00:52:36", "text": "あなたの唇とすべてが"}, {"type": "subtitle", "time": 3165.27, "timestamp": "00:52:45", "text": "面白い事実ですが、中国があなたを好きでない場合、"}, {"type": "subtitle", "time": 3166.71, "timestamp": "00:52:46", "text": "彼らはあなたのパンダを奪っていくでしょう。取る"}, {"type": "subtitle", "time": 3168.87, "timestamp": "00:52:48", "text": "あなたの主要なものから離れてください。だから彼らは"}, {"type": "subtitle", "time": 3175.91, "timestamp": "00:52:55", "text": "うっかり1時間チャットを無視してしまいました。"}, {"type": "subtitle", "time": 3177.829, "timestamp": "00:52:57", "text": "あれは事故だった。君は"}, {"type": "subtitle", "time": 3179.67, "timestamp": "00:52:59", "text": "もうその話はやめてください。わかった。それは起こった"}]
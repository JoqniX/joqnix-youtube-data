[{"type": "subtitle", "time": 7922.39, "timestamp": "02:12:02", "text": "仕事は見つかりましたか？見ています。それから私は"}, {"type": "subtitle", "time": 7925.35, "timestamp": "02:12:05", "text": "大きくていいものが欲しい"}, {"type": "subtitle", "time": 7934.31, "timestamp": "02:12:14", "text": "生姜"}, {"type": "subtitle", "time": 7937.75, "timestamp": "02:12:17", "text": "塩とコショウを加える。何が怒っているのか"}, {"type": "subtitle", "time": 7947.189, "timestamp": "02:12:27", "text": "あれはニワトリです。わかった。鶏むね肉、"}, {"type": "subtitle", "time": 7950.629, "timestamp": "02:12:30", "text": "私は推測する。わからない。得点を出し始める"}, {"type": "subtitle", "time": 7960.39, "timestamp": "02:12:40", "text": "そして彼はそれをそこに置いて"}, {"type": "subtitle", "time": 7973.35, "timestamp": "02:12:53", "text": "フライパンに少量の油をひく"}, {"type": "subtitle", "time": 7976.629, "timestamp": "02:12:56", "text": "そのままオイルの中へ"}, {"type": "subtitle", "time": 7978.149, "timestamp": "02:12:58", "text": "そして金色"}]
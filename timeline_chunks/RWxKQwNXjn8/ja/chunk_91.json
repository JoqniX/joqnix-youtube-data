[{"type": "subtitle", "time": 5481.11, "timestamp": "01:31:21", "text": "それは素晴らしいですね。クルーの皆さん、待ちきれません"}, {"type": "subtitle", "time": 5491.03, "timestamp": "01:31:31", "text": "Delta Rune Jockをプレイしたことはありますか？ない"}, {"type": "subtitle", "time": 5495.189, "timestamp": "01:31:35", "text": "まだ。まだ。ああ、とても美味しい。すべき"}, {"type": "subtitle", "time": 5497.27, "timestamp": "01:31:37", "text": "完全に。 Undertaleをプレイしたことはありますか？"}, {"type": "subtitle", "time": 5502.149, "timestamp": "01:31:42", "text": "いいえ。 Undertaleをプレイしたことがないのですか？いいえ。"}, {"type": "subtitle", "time": 5504.79, "timestamp": "01:31:44", "text": "何てことだ。ジョブ、君にはプレイしてもらいたいんだ"}, {"type": "subtitle", "time": 5507.27, "timestamp": "01:31:47", "text": "アンダーテール。"}, {"type": "subtitle", "time": 5515.189, "timestamp": "01:31:55", "text": "それは私という人間を定義づけるものだった"}]
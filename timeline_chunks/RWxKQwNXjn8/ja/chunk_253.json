[{"type": "subtitle", "time": 15180.229, "timestamp": "04:13:00", "text": "ああ、うまくいってる。うまくいっている。それは"}, {"type": "subtitle", "time": 15184.71, "timestamp": "04:13:04", "text": "働く。ニース。私の声が聞こえるでしょう。そして私は"}, {"type": "subtitle", "time": 15187.99, "timestamp": "04:13:07", "text": "バグがあると言っていたのですが"}, {"type": "subtitle", "time": 15191.429, "timestamp": "04:13:11", "text": "切断されるが、切断されるべきではない"}, {"type": "subtitle", "time": 15194.71, "timestamp": "04:13:14", "text": "オフ。理由は分かりません。"}, {"type": "subtitle", "time": 15198.229, "timestamp": "04:13:18", "text": "でも、今はオーディオ担当の仲間になるべきだね。"}, {"type": "subtitle", "time": 15204.63, "timestamp": "04:13:24", "text": "えーと"}, {"type": "subtitle", "time": 15206.149, "timestamp": "04:13:26", "text": "そして"}, {"type": "subtitle", "time": 15209.11, "timestamp": "04:13:29", "text": "うん"}, {"type": "subtitle", "time": 15225.429, "timestamp": "04:13:45", "text": "そしてブラウザ関連のものも載せます"}, {"type": "subtitle", "time": 15228.469, "timestamp": "04:13:48", "text": "このような。"}, {"type": "subtitle", "time": 15230.469, "timestamp": "04:13:50", "text": "わかった、"}, {"type": "subtitle", "time": 15232.55, "timestamp": "04:13:52", "text": "みんな、私の声が聞こえるかどうか教えて。"}, {"type": "subtitle", "time": 15235.67, "timestamp": "04:13:55", "text": "配信中。そうあるべきだと思う。"}, {"type": "subtitle", "time": 15237.59, "timestamp": "04:13:57", "text": "えっと、"}]
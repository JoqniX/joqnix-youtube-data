[{"type": "subtitle", "time": 7740.87, "timestamp": "02:09:00", "text": "うっかり台無しにしてしまった"}, {"type": "subtitle", "time": 7744.069, "timestamp": "02:09:04", "text": "それらのプレート。ああ、ドックをロックして"}, {"type": "subtitle", "time": 7746.709, "timestamp": "02:09:06", "text": "けれど。そっちの方が簡単じゃないですか？ええ、そうです"}, {"type": "subtitle", "time": 7748.47, "timestamp": "02:09:08", "text": "より簡単に。でも、どのように使われたかは覚えていません"}, {"type": "subtitle", "time": 7749.99, "timestamp": "02:09:09", "text": "見た目がどうなのか、今はわからない"}, {"type": "subtitle", "time": 7752.629, "timestamp": "02:09:12", "text": "やりました。"}, {"type": "subtitle", "time": 7754.709, "timestamp": "02:09:14", "text": "なぜだめですか？"}, {"type": "subtitle", "time": 7756.069, "timestamp": "02:09:16", "text": "大丈夫です。チェック。すべて順調です。"}, {"type": "subtitle", "time": 7758.629, "timestamp": "02:09:18", "text": "すべて順調です。すべて順調です。"}, {"type": "subtitle", "time": 7761.189, "timestamp": "02:09:21", "text": "パニックになる必要はありません。私はやり方を知っています"}, {"type": "subtitle", "time": 7765.43, "timestamp": "02:09:25", "text": "私は配信者です。わかった。着る"}, {"type": "subtitle", "time": 7767.35, "timestamp": "02:09:27", "text": "私の国の伝統的な日。試してみてください"}, {"type": "subtitle", "time": 7770.79, "timestamp": "02:09:30", "text": "本物として偽装する。おお"}, {"type": "subtitle", "time": 7773.189, "timestamp": "02:09:33", "text": "うん、それはとてもアメリカ的なことだね"}, {"type": "subtitle", "time": 7776.069, "timestamp": "02:09:36", "text": "やるべきこと。もっと悪いことって何だと思う？クソッ"}, {"type": "subtitle", "time": 7778.79, "timestamp": "02:09:38", "text": "えっと、彼の何を見た？"}, {"type": "subtitle", "time": 7781.589, "timestamp": "02:09:41", "text": "名前？あの人の名前は何ですか？試みる"}, {"type": "subtitle", "time": 7784.55, "timestamp": "02:09:44", "text": "覚えて。彼のお名前は？"}, {"type": "subtitle", "time": 7789.83, "timestamp": "02:09:49", "text": "えっと、ジェイミー・オリバーさんですか？あなたは"}, {"type": "subtitle", "time": 7792.069, "timestamp": "02:09:52", "text": "ジョック、ジェイミーがどうだったか見た？"}, {"type": "subtitle", "time": 7796.47, "timestamp": "02:09:56", "text": "オリバーはバターチキンを作ったの？いいえ。"}, {"type": "subtitle", "time": 7799.03, "timestamp": "02:09:59", "text": "わかったよ、ジョー、"}]
[{"type": "subtitle", "time": 8767.19, "timestamp": "02:26:07", "text": "言語。えっと、私はマラヤーラム語とヒンディー語が話せます"}, {"type": "subtitle", "time": 8771.19, "timestamp": "02:26:11", "text": "少しだけ英語が話せます。そして学習"}, {"type": "subtitle", "time": 8773.349, "timestamp": "02:26:13", "text": "日本語を学ぼうと思っています"}, {"type": "subtitle", "time": 8776.469, "timestamp": "02:26:16", "text": "中国語（北京語）うん。"}, {"type": "subtitle", "time": 8780.389, "timestamp": "02:26:20", "text": "もちろんさ。何てことだ。"}, {"type": "subtitle", "time": 8784.23, "timestamp": "02:26:24", "text": "君を見てごらん。めちゃくちゃ賢い。おお"}, {"type": "subtitle", "time": 8787.27, "timestamp": "02:26:27", "text": "我が神よ。"}, {"type": "subtitle", "time": 8789.99, "timestamp": "02:26:29", "text": "いいえ、私は母国語が苦手で、"}, {"type": "chat", "time": 8791.053, "timestamp": "02:26:31", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "hey hey Joqqy how u doing?"}, {"type": "subtitle", "time": 8792.63, "timestamp": "02:26:32", "text": "ヒンディー語とかそういう類。私はそれが本当に下手なんです"}, {"type": "subtitle", "time": 8795.19, "timestamp": "02:26:35", "text": "私には読めない。私はそうは思わない 私はそうは思わない"}, {"type": "subtitle", "time": 8797.27, "timestamp": "02:26:37", "text": "できない、私は文すら作れない"}, {"type": "subtitle", "time": 8805.349, "timestamp": "02:26:45", "text": "私が知っている限りでは、実際の"}, {"type": "subtitle", "time": 8807.75, "timestamp": "02:26:47", "text": "母語は、私が"}, {"type": "subtitle", "time": 8810.79, "timestamp": "02:26:50", "text": "頭痛。お前を倒すか、"}, {"type": "subtitle", "time": 8813.27, "timestamp": "02:26:53", "text": "ここは、ほら、そういう感じだから"}, {"type": "subtitle", "time": 8815.59, "timestamp": "02:26:55", "text": "母が言うこと。"}, {"type": "subtitle", "time": 8817.27, "timestamp": "02:26:57", "text": "[音楽]"}, {"type": "subtitle", "time": 8819.83, "timestamp": "02:26:59", "text": "私はごく基本的な感謝しか知りません"}]
[{"type": "subtitle", "time": 1686.87, "timestamp": "00:28:06", "text": "わかった。どんな種類のクマですか？私は実際に"}, {"type": "subtitle", "time": 1690.47, "timestamp": "00:28:10", "text": "わからない。何てことだ。えっと、何ですか"}, {"type": "subtitle", "time": 1693.75, "timestamp": "00:28:13", "text": "私に似合うと思うものは何ですか？"}, {"type": "subtitle", "time": 1696.07, "timestamp": "00:28:16", "text": "あなたのために？"}, {"type": "subtitle", "time": 1698.47, "timestamp": "00:28:18", "text": "はぁ？"}, {"type": "subtitle", "time": 1700.63, "timestamp": "00:28:20", "text": "あなたをパンダにできるような気がする。私たちは"}, {"type": "subtitle", "time": 1703.83, "timestamp": "00:28:23", "text": "あなたを子パンダのように好きにさせてくれるでしょう。そうそう、"}, {"type": "subtitle", "time": 1706.789, "timestamp": "00:28:26", "text": "パンダがいたらいいですね。絵を描くこと。おお"}, {"type": "subtitle", "time": 1711.029, "timestamp": "00:28:31", "text": "我が神よ。チャック、それ君が描いたの？ A"}, {"type": "subtitle", "time": 1714.07, "timestamp": "00:28:34", "text": "わからない。私はパンダを描くことができます。だから私は試してみます"}, {"type": "subtitle", "time": 1716.23, "timestamp": "00:28:36", "text": "私のベスト。"}, {"type": "subtitle", "time": 1718.63, "timestamp": "00:28:38", "text": "わかった。わかった。私たちはジョーを"}, {"type": "subtitle", "time": 1720.389, "timestamp": "00:28:40", "text": "パンダ。つまり、ここには噛み応えがある"}, {"type": "subtitle", "time": 1722.31, "timestamp": "00:28:42", "text": "すでに、"}, {"type": "subtitle", "time": 1724.71, "timestamp": "00:28:44", "text": "右？つまり、半分まで来たってことだよね。"}, {"type": "subtitle", "time": 1726.23, "timestamp": "00:28:46", "text": "そこには。"}, {"type": "subtitle", "time": 1727.83, "timestamp": "00:28:47", "text": "[音楽]"}, {"type": "subtitle", "time": 1730.149, "timestamp": "00:28:50", "text": "わかった。クマのジョギングを描くには、"}, {"type": "subtitle", "time": 1734.07, "timestamp": "00:28:54", "text": "まず円を描きます。"}, {"type": "subtitle", "time": 1736.789, "timestamp": "00:28:56", "text": "髪の色を変えようと思う。私は"}, {"type": "subtitle", "time": 1739.75, "timestamp": "00:28:59", "text": "この輪郭を描き込む。"}]
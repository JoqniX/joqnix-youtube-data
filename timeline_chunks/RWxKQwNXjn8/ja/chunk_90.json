[{"type": "subtitle", "time": 5400.629, "timestamp": "01:30:00", "text": "境界を指定しましたが、"}, {"type": "subtitle", "time": 5436.229, "timestamp": "01:30:36", "text": "尻尾の描写はよくできていますね。それはいいですね"}, {"type": "subtitle", "time": 5443.83, "timestamp": "01:30:43", "text": "私も昔は車輪を描くのが大好きでした。"}, {"type": "subtitle", "time": 5445.43, "timestamp": "01:30:45", "text": "それは私が最初にしたことの1つでした"}, {"type": "subtitle", "time": 5448.149, "timestamp": "01:30:48", "text": "初めてノートパソコンを手に入れた時に描いた絵"}, {"type": "subtitle", "time": 5451.11, "timestamp": "01:30:51", "text": "そして、私のペンタブレット。はい。私は次のように描きました"}, {"type": "subtitle", "time": 5454.31, "timestamp": "01:30:54", "text": "私は昔の絵が好きです。彼らはいた"}, {"type": "subtitle", "time": 5457.09, "timestamp": "01:30:57", "text": "彼らはすごく尖っていて、ヤバかった。"}]
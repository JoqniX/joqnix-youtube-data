[{"type": "subtitle", "time": 1022.23, "timestamp": "00:17:02", "text": "大都市は混沌としていて、時に手に負えないほどだ。"}, {"type": "subtitle", "time": 1025.11, "timestamp": "00:17:05", "text": "山もいいですね。 M. 知ってるでしょ？"}, {"type": "subtitle", "time": 1027.27, "timestamp": "00:17:07", "text": "何？山はいいものだ。私は感じることができる"}, {"type": "subtitle", "time": 1031.11, "timestamp": "00:17:11", "text": "風。うん。何か食べ物を選んでください。"}, {"type": "subtitle", "time": 1032.71, "timestamp": "00:17:12", "text": "健康"}, {"type": "subtitle", "time": 1035.829, "timestamp": "00:17:15", "text": "ぬいぐるみの上にパンが乗っている。あ、待って。ただ"}, {"type": "subtitle", "time": 1038.47, "timestamp": "00:17:18", "text": "わかった。ちょうど"}, {"type": "subtitle", "time": 1041.429, "timestamp": "00:17:21", "text": "ピザは不健康すぎる。ハンバーガーは不健康です。"}, {"type": "subtitle", "time": 1043.27, "timestamp": "00:17:23", "text": "ステーキとか色々。不健康。はい、"}, {"type": "subtitle", "time": 1047.51, "timestamp": "00:17:27", "text": "こちらでどうぞ。 B. ああ、なんてことだ、"}, {"type": "subtitle", "time": 1050.39, "timestamp": "00:17:30", "text": "兄弟。あれはめちゃくちゃ高い。できました"}, {"type": "subtitle", "time": 1052.549, "timestamp": "00:17:32", "text": "絶対に買えない。でも、もし誰かが"}, {"type": "subtitle", "time": 1056.04, "timestamp": "00:17:36", "text": "それをくれたら、私はそれを食べるよ。"}, {"type": "subtitle", "time": 1057.99, "timestamp": "00:17:37", "text": "[音楽]"}, {"type": "subtitle", "time": 1059.909, "timestamp": "00:17:39", "text": "今日は親友の誕生日で、"}, {"type": "subtitle", "time": 1061.51, "timestamp": "00:17:41", "text": "何を贈るか忘れてしまった。あなたならどうしますか？"}, {"type": "subtitle", "time": 1065.51, "timestamp": "00:17:45", "text": "する？ええ、それでも彼らにそう伝えるんですね。待って、"}, {"type": "subtitle", "time": 1067.99, "timestamp": "00:17:47", "text": "それらを受け取るのを忘れていましたね。怒る"}, {"type": "subtitle", "time": 1070.47, "timestamp": "00:17:50", "text": "彼らを先に。オーケー、待って。いいえ、"}, {"type": "subtitle", "time": 1072.63, "timestamp": "00:17:52", "text": "道に迷ったと伝えてください。いいえ、それは"}, {"type": "subtitle", "time": 1076.87, "timestamp": "00:17:56", "text": "嘘をついている。私は"}]
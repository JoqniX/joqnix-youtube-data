[{"type": "subtitle", "time": 15600.87, "timestamp": "04:20:00", "text": "えっと、牛肉だったかな、それとも鶏肉だったかな？わからない。"}, {"type": "subtitle", "time": 15603.11, "timestamp": "04:20:03", "text": "うん。えっと、"}, {"type": "subtitle", "time": 15607.349, "timestamp": "04:20:07", "text": "サシュワールとカレーか何かグレービーソースか"}, {"type": "subtitle", "time": 15610.149, "timestamp": "04:20:10", "text": "何か。うん。うん。うん。うん。だから私は"}, {"type": "subtitle", "time": 15612.79, "timestamp": "04:20:12", "text": "それを注文した。美味しかった。私は"}, {"type": "subtitle", "time": 15614.79, "timestamp": "04:20:14", "text": "味。"}, {"type": "subtitle", "time": 15617.429, "timestamp": "04:20:17", "text": "えっと"}, {"type": "subtitle", "time": 15620.07, "timestamp": "04:20:20", "text": "うん、楽しかったよ。"}, {"type": "subtitle", "time": 15623.11, "timestamp": "04:20:23", "text": "この男を洗わなきゃ。"}, {"type": "subtitle", "time": 15638.389, "timestamp": "04:20:38", "text": "わかった。"}, {"type": "subtitle", "time": 15641.91, "timestamp": "04:20:41", "text": "あの男を洗ってやれ。"}, {"type": "subtitle", "time": 15657.67, "timestamp": "04:20:57", "text": "オフにしてこのカレーを"}]
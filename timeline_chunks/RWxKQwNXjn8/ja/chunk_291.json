[{"type": "subtitle", "time": 17461.83, "timestamp": "04:51:01", "text": "6本のワイヤー。六。えっと、教えていただけますか？"}, {"type": "subtitle", "time": 17464.31, "timestamp": "04:51:04", "text": "上から下まで配線が通っている？青、青、"}, {"type": "subtitle", "time": 17467.83, "timestamp": "04:51:07", "text": "黒、青、赤、青、黒。青、"}, {"type": "subtitle", "time": 17472.39, "timestamp": "04:51:12", "text": "青、黒。そして、青、赤、黒。"}, {"type": "subtitle", "time": 17475.03, "timestamp": "04:51:15", "text": "青、赤、"}, {"type": "subtitle", "time": 17477.11, "timestamp": "04:51:17", "text": "黒。"}, {"type": "subtitle", "time": 17479.35, "timestamp": "04:51:19", "text": "わかった。 6本のワイヤー。黄色がない場合"}, {"type": "subtitle", "time": 17481.83, "timestamp": "04:51:21", "text": "ワイヤーと最後の桁、えっと、"}, {"type": "subtitle", "time": 17484.788, "timestamp": "04:51:24", "text": "最後の桁？それは何ですか？最後の桁"}, {"type": "subtitle", "time": 17490.47, "timestamp": "04:51:30", "text": "シリアル番号の。うんうん。ゼロです。"}, {"type": "subtitle", "time": 17491.91, "timestamp": "04:51:31", "text": "シリアル番号が奇数です。ゼロではない。"}, {"type": "subtitle", "time": 17494.15, "timestamp": "04:51:34", "text": "わかった。そうでなければ、正確に"}, {"type": "subtitle", "time": 17497.51, "timestamp": "04:51:37", "text": "赤い線がない場合は、"}, {"type": "subtitle", "time": 17499.35, "timestamp": "04:51:39", "text": "そうでなければ、4番目をカットします"}, {"type": "subtitle", "time": 17503.11, "timestamp": "04:51:43", "text": "ワイヤー。わかった。 １、２、３、４。こんにちは、"}, {"type": "subtitle", "time": 17507.67, "timestamp": "04:51:47", "text": "拡散する。次のワイヤーもまた6番です。赤、"}, {"type": "subtitle", "time": 17511.27, "timestamp": "04:51:51", "text": "白、黄色、黄色、青、白、"}, {"type": "subtitle", "time": 17515.19, "timestamp": "04:51:55", "text": "黄色、黄色、青、白、白、赤、"}, {"type": "subtitle", "time": 17517.75, "timestamp": "04:51:57", "text": "白、黄色、黄色、青、白。"}, {"type": "subtitle", "time": 17519.83, "timestamp": "04:51:59", "text": "黄色のワイヤーがない場合、"}]
[{"type": "subtitle", "time": 14280.15, "timestamp": "03:58:00", "text": "あなたは私と一緒にここにいる。私の言うことを聞いて"}, {"type": "subtitle", "time": 14281.75, "timestamp": "03:58:01", "text": "話す。"}, {"type": "subtitle", "time": 14285.189, "timestamp": "03:58:05", "text": "自分の音声がどれくらい聞き取りやすいのか分かりません。"}, {"type": "subtitle", "time": 14287.51, "timestamp": "03:58:07", "text": "家族は寝ています。"}, {"type": "subtitle", "time": 14290.63, "timestamp": "03:58:10", "text": "私はこっそりキッチンに忍び込んでいる。"}, {"type": "subtitle", "time": 14293.59, "timestamp": "03:58:13", "text": "わーい。"}, {"type": "subtitle", "time": 14296.229, "timestamp": "03:58:16", "text": "何か食べるものはありますか？"}, {"type": "subtitle", "time": 14299.189, "timestamp": "03:58:19", "text": "ああ、朝に注文したものですね。"}, {"type": "subtitle", "time": 14301.59, "timestamp": "03:58:21", "text": "わかった。"}, {"type": "subtitle", "time": 14304.63, "timestamp": "03:58:24", "text": "特に何もない"}, {"type": "subtitle", "time": 14307.67, "timestamp": "03:58:27", "text": "いや、待って。彼らは何かを持ってきた。"}, {"type": "subtitle", "time": 14311.269, "timestamp": "03:58:31", "text": "彼らは何かを持ってきた。これは何ですか？私"}, {"type": "subtitle", "time": 14320.95, "timestamp": "03:58:40", "text": "よし、冷蔵庫の中をちょっと覗いてみよう"}, {"type": "subtitle", "time": 14323.11, "timestamp": "03:58:43", "text": "今"}]
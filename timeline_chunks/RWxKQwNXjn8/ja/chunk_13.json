[{"type": "subtitle", "time": 781.19, "timestamp": "00:13:01", "text": "そして中立。だから、良いことはあなたのような"}, {"type": "subtitle", "time": 782.55, "timestamp": "00:13:02", "text": "あなたがしようとしていることを知っている"}, {"type": "subtitle", "time": 784.55, "timestamp": "00:13:04", "text": "他の人を助けること。あなたが気にしていること"}, {"type": "subtitle", "time": 787.35, "timestamp": "00:13:07", "text": "その他。中立とは、時々あなたが気にするということです"}, {"type": "subtitle", "time": 789.43, "timestamp": "00:13:09", "text": "他の人についてですが、あなたは"}, {"type": "subtitle", "time": 791.829, "timestamp": "00:13:11", "text": "もっと自分自身を。悪よ、あなたは気にしない"}, {"type": "subtitle", "time": 794.629, "timestamp": "00:13:14", "text": "誰に対しても悪口を言う。あなたはここにいるのは"}, {"type": "subtitle", "time": 796.31, "timestamp": "00:13:16", "text": "問題。"}, {"type": "subtitle", "time": 800.23, "timestamp": "00:13:20", "text": "そして、その上、中立的な、"}, {"type": "subtitle", "time": 804.15, "timestamp": "00:13:24", "text": "秩序あるものと、混沌あるものがある。"}, {"type": "subtitle", "time": 807.11, "timestamp": "00:13:27", "text": "君はめちゃくちゃだ、まるでグレムリンみたいだ。あなたは"}, {"type": "subtitle", "time": 809.99, "timestamp": "00:13:29", "text": "あなたも問題を起こすためにそこにいるのでしょう。"}, {"type": "subtitle", "time": 811.75, "timestamp": "00:13:31", "text": "中立というのは、気にしないという意味です"}, {"type": "subtitle", "time": 813.75, "timestamp": "00:13:33", "text": "くそっ。あなたはただ存在しているだけだ。"}, {"type": "subtitle", "time": 818.23, "timestamp": "00:13:38", "text": "合法とは、あなたがルールに従ってプレイすることを好むということです。"}, {"type": "subtitle", "time": 820.79, "timestamp": "00:13:40", "text": "つまり、あなたが演奏しているような意味があるということです"}, {"type": "subtitle", "time": 822.87, "timestamp": "00:13:42", "text": "規則を完全に遵守してください。"}, {"type": "subtitle", "time": 825.43, "timestamp": "00:13:45", "text": "うん。つまり、合法的なというのは、"}, {"type": "subtitle", "time": 827.43, "timestamp": "00:13:47", "text": "法治善とは、ほら、"}, {"type": "subtitle", "time": 828.87, "timestamp": "00:13:48", "text": "あなたはいい人ですね。あなたは"}, {"type": "subtitle", "time": 832.23, "timestamp": "00:13:52", "text": "君みたいな騎士たち"}, {"type": "subtitle", "time": 834.389, "timestamp": "00:13:54", "text": "君のような兵士やその他諸々を知っている"}, {"type": "subtitle", "time": 837.03, "timestamp": "00:13:57", "text": "彼らは義務を果たすためにそこにいることを知っており、"}]
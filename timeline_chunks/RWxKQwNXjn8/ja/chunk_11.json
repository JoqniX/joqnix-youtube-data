[{"type": "subtitle", "time": 660.55, "timestamp": "00:11:00", "text": "私はファーリーになれるほどお金持ちじゃない。私"}, {"type": "subtitle", "time": 661.91, "timestamp": "00:11:01", "text": "金持ちになる必要があると感じている"}, {"type": "subtitle", "time": 664.069, "timestamp": "00:11:04", "text": "毛むくじゃら。"}, {"type": "subtitle", "time": 667.19, "timestamp": "00:11:07", "text": "あなたはそうしなければならないと思います、いいえ、あなたは"}, {"type": "subtitle", "time": 669.59, "timestamp": "00:11:09", "text": "ジョック。フライドポテトが"}, {"type": "subtitle", "time": 672.069, "timestamp": "00:11:12", "text": "彼らは大量の"}, {"type": "subtitle", "time": 674.79, "timestamp": "00:11:14", "text": "物事、ですよね？彼らは金持ちでなければならない。おお"}, {"type": "subtitle", "time": 676.87, "timestamp": "00:11:16", "text": "うん、その通り、その通り、その通り。ええ、ええ。私は"}, {"type": "subtitle", "time": 678.87, "timestamp": "00:11:18", "text": "まだ十分なお金持ちじゃないから。私はできません"}, {"type": "subtitle", "time": 681.829, "timestamp": "00:11:21", "text": "まだ自分をファーリーと呼んでいない。"}, {"type": "subtitle", "time": 683.67, "timestamp": "00:11:23", "text": "よし、ジョー、何か考えていることはある？"}, {"type": "subtitle", "time": 692.63, "timestamp": "00:11:32", "text": "実際は、いいえ。全く見当もつかない。我々はできる"}, {"type": "subtitle", "time": 694.71, "timestamp": "00:11:34", "text": "グーグルで何か検索すると"}, {"type": "subtitle", "time": 697.829, "timestamp": "00:11:37", "text": "私たちの心、または猫をグーグルで検索することができます。"}, {"type": "subtitle", "time": 699.99, "timestamp": "00:11:39", "text": "お好きなものをどうぞ。知ってるかい？"}, {"type": "subtitle", "time": 702.23, "timestamp": "00:11:42", "text": "フライドポテトの話が出たので、"}, {"type": "subtitle", "time": 705.99, "timestamp": "00:11:45", "text": "あなたのペルソナ jo。"}, {"type": "subtitle", "time": 708.23, "timestamp": "00:11:48", "text": "うん。わかった。私たちはあなたを"}, {"type": "subtitle", "time": 711.509, "timestamp": "00:11:51", "text": "ペルソナ。さて、これがうまくいくためには、ジョー、"}, {"type": "subtitle", "time": 716.069, "timestamp": "00:11:56", "text": "新しいものを開けるように、あなたに行ってほしい"}]
[{"type": "subtitle", "time": 6301.03, "timestamp": "01:45:01", "text": "彼はなりたかった、彼はそうするつもりだった"}, {"type": "subtitle", "time": 6305.75, "timestamp": "01:45:05", "text": "彼はクールな子だよ。彼は反逆者だ。"}, {"type": "subtitle", "time": 6308.629, "timestamp": "01:45:08", "text": "まあ、そんな感じですね。最初は"}, {"type": "subtitle", "time": 6313.27, "timestamp": "01:45:13", "text": "したくなかった 私はこう思った 私はしない 私はしない"}, {"type": "subtitle", "time": 6316.149, "timestamp": "01:45:16", "text": "私はあなたの"}, {"type": "subtitle", "time": 6318.31, "timestamp": "01:45:18", "text": "あなたのピアスとか、そういうのを私にも入れたい。"}, {"type": "subtitle", "time": 6322.47, "timestamp": "01:45:22", "text": "矢印。それを試してみよう"}, {"type": "subtitle", "time": 6324.709, "timestamp": "01:45:24", "text": "ここ？とにかく、摩擦があるから、"}, {"type": "subtitle", "time": 6335.35, "timestamp": "01:45:35", "text": "そして、その結果がどうなったか見てみましょう。"}, {"type": "subtitle", "time": 6336.95, "timestamp": "01:45:36", "text": "うん。"}, {"type": "subtitle", "time": 6338.95, "timestamp": "01:45:38", "text": "それが私が自分のキャラクターに与えた理由の一つです"}, {"type": "subtitle", "time": 6341.35, "timestamp": "01:45:41", "text": "最初は髪を染めたかったから"}, {"type": "subtitle", "time": 6344.39, "timestamp": "01:45:44", "text": "ずっと髪を染めたいと思っていました"}, {"type": "subtitle", "time": 6345.669, "timestamp": "01:45:45", "text": "そして最終的に私は"}, {"type": "subtitle", "time": 6347.109, "timestamp": "01:45:47", "text": "染めた髪。いや、正しくない"}, {"type": "subtitle", "time": 6349.189, "timestamp": "01:45:49", "text": "髪を切ったからだけど、"}, {"type": "subtitle", "time": 6352.709, "timestamp": "01:45:52", "text": "もう一度色を塗る。"}, {"type": "subtitle", "time": 6355.43, "timestamp": "01:45:55", "text": "ああ"}, {"type": "subtitle", "time": 6359.109, "timestamp": "01:45:59", "text": "あなたは星についてとても詳しいんですね。"}]
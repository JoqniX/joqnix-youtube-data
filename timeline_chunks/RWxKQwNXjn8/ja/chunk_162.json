[{"type": "subtitle", "time": 9725.03, "timestamp": "02:42:05", "text": "黒い粘液か何かのように見える。"}, {"type": "subtitle", "time": 9726.63, "timestamp": "02:42:06", "text": "右？"}, {"type": "subtitle", "time": 9729.27, "timestamp": "02:42:09", "text": "うん。まあ、そんな感じですね。うん。"}, {"type": "subtitle", "time": 9732.15, "timestamp": "02:42:12", "text": "しかし、それは生命を持ち、あなたは動いている。"}, {"type": "subtitle", "time": 9735.51, "timestamp": "02:42:15", "text": "うん。おお。うん。それは、それは、それは"}, {"type": "subtitle", "time": 9739.03, "timestamp": "02:42:19", "text": "私の好きなところにある素材"}, {"type": "subtitle", "time": 9752.389, "timestamp": "02:42:32", "text": "それはおかしい。いや、私が言っているのは、焼け焦げた犬のことだ。"}, {"type": "subtitle", "time": 9755.27, "timestamp": "02:42:35", "text": "なんてこった？私はただのドロドロした"}, {"type": "subtitle", "time": 9759.429, "timestamp": "02:42:39", "text": "ちっちゃな子。あなたは私にとても意地悪です。"}, {"type": "subtitle", "time": 9761.11, "timestamp": "02:42:41", "text": "今日私が学んだことは"}, {"type": "subtitle", "time": 9762.79, "timestamp": "02:42:42", "text": "配信チャット？私はあなたが"}, {"type": "subtitle", "time": 9770.79, "timestamp": "02:42:50", "text": "右。"}, {"type": "subtitle", "time": 9774.07, "timestamp": "02:42:54", "text": "チャット、これはチャットです、"}, {"type": "subtitle", "time": 9776.87, "timestamp": "02:42:56", "text": "右？"}]
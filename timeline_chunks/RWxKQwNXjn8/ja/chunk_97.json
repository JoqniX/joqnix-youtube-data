[{"type": "subtitle", "time": 5821.03, "timestamp": "01:37:01", "text": "思い出話にも花を咲かせている。だから、私はそうは思わない"}, {"type": "subtitle", "time": 5824.07, "timestamp": "01:37:04", "text": "それはどんな意味でも悪いことだ。あなたが"}, {"type": "subtitle", "time": 5826.229, "timestamp": "01:37:06", "text": "自分が何をしているのかを正直に話すこと、"}, {"type": "subtitle", "time": 5827.99, "timestamp": "01:37:07", "text": "ほら、誰もそんなの持ってないよ、ほら、"}, {"type": "subtitle", "time": 5830.39, "timestamp": "01:37:10", "text": "ああ、ほら、ああ、彼は"}, {"type": "subtitle", "time": 5832.87, "timestamp": "01:37:12", "text": "不正行為。"}, {"type": "subtitle", "time": 5835.27, "timestamp": "01:37:15", "text": "M、ジョン、君はズルをしていないよ。やめて、やめて"}, {"type": "subtitle", "time": 5838.31, "timestamp": "01:37:18", "text": "それについてストレスを感じる。"}, {"type": "subtitle", "time": 5841.109, "timestamp": "01:37:21", "text": "そう、ちょっと考えてみるしかないね。もし"}, {"type": "subtitle", "time": 5843.99, "timestamp": "01:37:23", "text": "他の誰かがこのことをやっていた、"}, {"type": "subtitle", "time": 5845.83, "timestamp": "01:37:25", "text": "あなたと同じことをします、"}, {"type": "subtitle", "time": 5849.109, "timestamp": "01:37:29", "text": "何か問題でも？いいえ。"}, {"type": "subtitle", "time": 5850.709, "timestamp": "01:37:30", "text": "うん。それなら問題ないはずです"}, {"type": "subtitle", "time": 5854.87, "timestamp": "01:37:34", "text": "あなたがそれをやってくれることで。うん。最も"}, {"type": "subtitle", "time": 5858.39, "timestamp": "01:37:38", "text": "これまで私が受けたアドバイスのように重要なもの"}, {"type": "subtitle", "time": 5860.709, "timestamp": "01:37:40", "text": "聞いた話では、自分自身に与えるべきだということだった"}, {"type": "subtitle", "time": 5862.79, "timestamp": "01:37:42", "text": "あなたが他の人に与えるのと同じ優しさ"}, {"type": "subtitle", "time": 5865.03, "timestamp": "01:37:45", "text": "人々、"}, {"type": "subtitle", "time": 5866.55, "timestamp": "01:37:46", "text": "右？あなたも同じ親切心を示すべきです"}, {"type": "subtitle", "time": 5868.95, "timestamp": "01:37:48", "text": "あなたは他の人に与える。そうそう。もし"}, {"type": "subtitle", "time": 5871.51, "timestamp": "01:37:51", "text": "もしあなたが親切なら"}, {"type": "subtitle", "time": 5873.669, "timestamp": "01:37:53", "text": "誰かに何かについて話すなら、"}, {"type": "subtitle", "time": 5875.669, "timestamp": "01:37:55", "text": "あなたはそれについて自分に優しくするべきです"}, {"type": "subtitle", "time": 5877.35, "timestamp": "01:37:57", "text": "あまりにも。"}, {"type": "subtitle", "time": 5878.87, "timestamp": "01:37:58", "text": "M"}]
[{"type": "subtitle", "time": 18304.07, "timestamp": "05:05:04", "text": "残り1つ。残り1つ。 1人減った。 1人減った。"}, {"type": "subtitle", "time": 18307.03, "timestamp": "05:05:07", "text": "残り1つ。残り1つ。"}, {"type": "subtitle", "time": 18310.628, "timestamp": "05:05:10", "text": "ええと、一番上まで上がってください。"}, {"type": "subtitle", "time": 18314.07, "timestamp": "05:05:14", "text": "くそ。本当に惜しかった。なんてこった。待って。あなた"}, {"type": "subtitle", "time": 18317.11, "timestamp": "05:05:17", "text": "そうしなかった。あなたは理解していない。いいえ。爆発しました。"}, {"type": "subtitle", "time": 18319.59, "timestamp": "05:05:19", "text": "時間がなくなってしまった。"}, {"type": "subtitle", "time": 18321.83, "timestamp": "05:05:21", "text": "あと少しだったのに。"}, {"type": "subtitle", "time": 18325.19, "timestamp": "05:05:25", "text": "いいえ。私は死にました。"}, {"type": "subtitle", "time": 18327.19, "timestamp": "05:05:27", "text": "行く。"}, {"type": "subtitle", "time": 18335.27, "timestamp": "05:05:35", "text": "ああ、信じられないよ、ジョックの"}, {"type": "subtitle", "time": 18338.46, "timestamp": "05:05:38", "text": "殺された、残った。"}, {"type": "subtitle", "time": 18341.59, "timestamp": "05:05:41", "text": "[笑い]"}, {"type": "subtitle", "time": 18344.55, "timestamp": "05:05:44", "text": "心配しないで、ジョック。何もない。"}, {"type": "subtitle", "time": 18349.59, "timestamp": "05:05:49", "text": "価値のあるものは何も失われなかった。何もない。"}, {"type": "subtitle", "time": 18351.59, "timestamp": "05:05:51", "text": "こんにちは。"}, {"type": "subtitle", "time": 18353.75, "timestamp": "05:05:53", "text": "あなたはそれに「はい」と言うつもりですか？私 私"}, {"type": "subtitle", "time": 18357.67, "timestamp": "05:05:57", "text": "そうでないことを願います。くそっ、価値がない。でも、いや、私は"}]
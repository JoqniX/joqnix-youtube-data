[{"type": "subtitle", "time": 363.35, "timestamp": "00:06:03", "text": "私はたくさんの食べ物を手に入れています。 5 67 6 えー"}, {"type": "subtitle", "time": 365.35, "timestamp": "00:06:05", "text": "230."}, {"type": "subtitle", "time": 367.83, "timestamp": "00:06:07", "text": "五。右。"}, {"type": "subtitle", "time": 371.11, "timestamp": "00:06:11", "text": "でも彼はあそこにいる。 1回出現。はい。私"}, {"type": "subtitle", "time": 373.27, "timestamp": "00:06:13", "text": "平均スポーン"}, {"type": "subtitle", "time": 375.749, "timestamp": "00:06:15", "text": "それは南インドの都市です"}, {"type": "subtitle", "time": 385.11, "timestamp": "00:06:25", "text": "食べ物をいただけますか？"}, {"type": "subtitle", "time": 399.27, "timestamp": "00:06:39", "text": "こんにちは"}, {"type": "subtitle", "time": 405.27, "timestamp": "00:06:45", "text": "それはジョークです。私の番です"}, {"type": "subtitle", "time": 409.029, "timestamp": "00:06:49", "text": "今はスポーツマンと一緒にいる。今度は私の番だ。"}, {"type": "subtitle", "time": 411.59000000000003, "timestamp": "00:06:51", "text": "他のすべての人やユーチューバーは"}, {"type": "subtitle", "time": 414.15, "timestamp": "00:06:54", "text": "彼らにも順番が回ってきた。だから、母は私の"}]
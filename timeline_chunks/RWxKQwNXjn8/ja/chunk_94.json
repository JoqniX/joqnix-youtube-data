[{"type": "subtitle", "time": 5640.55, "timestamp": "01:34:00", "text": "だから、いつもただ、ただ続けるだけです"}, {"type": "subtitle", "time": 5650.39, "timestamp": "01:34:10", "text": "作るべきだと感じています"}, {"type": "subtitle", "time": 5652.95, "timestamp": "01:34:12", "text": "魚はより紫色"}, {"type": "subtitle", "time": 5692.709, "timestamp": "01:34:52", "text": "さて、今日はどんな一日でしたか？それはありました"}, {"type": "subtitle", "time": 5694.79, "timestamp": "01:34:54", "text": "良い。私はほとんど寝て過ごしています。私は"}, {"type": "subtitle", "time": 5698.31, "timestamp": "01:34:58", "text": "今は夏休み中です。 H."}]
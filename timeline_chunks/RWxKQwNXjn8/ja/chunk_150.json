[{"type": "subtitle", "time": 9005.03, "timestamp": "02:30:05", "text": "研磨。研磨。研磨。研磨。研磨。"}, {"type": "subtitle", "time": 9019.75, "timestamp": "02:30:19", "text": "待って。とても混乱しています。正しいのは"}, {"type": "subtitle", "time": 9027.75, "timestamp": "02:30:27", "text": "全て"}, {"type": "subtitle", "time": 9030.15, "timestamp": "02:30:30", "text": "研磨。ポーランド語ですか？私がそう言っているのか"}, {"type": "subtitle", "time": 9034.07, "timestamp": "02:30:34", "text": "今すぐ？ポーランド語です。"}, {"type": "subtitle", "time": 9037.429, "timestamp": "02:30:37", "text": "チャド。チャド。私は、私は、私は、私は"}, {"type": "subtitle", "time": 9040.63, "timestamp": "02:30:40", "text": "わからない。英語。わかった。私は少し"}, {"type": "subtitle", "time": 9043.19, "timestamp": "02:30:43", "text": "バカ。"}, {"type": "subtitle", "time": 9045.429, "timestamp": "02:30:45", "text": "研磨。"}, {"type": "subtitle", "time": 9050.95, "timestamp": "02:30:50", "text": "多分。わからない。研磨。"}, {"type": "subtitle", "time": 9054.55, "timestamp": "02:30:54", "text": "研磨。研磨。研磨。研磨。"}, {"type": "subtitle", "time": 9056.95, "timestamp": "02:30:56", "text": "わかった。わかった。大丈夫です。大丈夫です。その"}]
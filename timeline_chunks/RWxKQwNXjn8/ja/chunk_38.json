[{"type": "subtitle", "time": 2286.15, "timestamp": "00:38:06", "text": "君ならできるよ、ベイビー。なぜでしょうか？ああ、それは"}, {"type": "subtitle", "time": 2288.39, "timestamp": "00:38:08", "text": "私の頭の形が"}, {"type": "subtitle", "time": 2292.31, "timestamp": "00:38:12", "text": "奇妙な。ああ、それは私のものです。"}, {"type": "subtitle", "time": 2296.47, "timestamp": "00:38:16", "text": "ごめん。あなた"}, {"type": "subtitle", "time": 2304.23, "timestamp": "00:38:24", "text": "ありがとう。"}, {"type": "subtitle", "time": 2306.63, "timestamp": "00:38:26", "text": "ありがとうございます、Go for the 貢献していただきありがとうございます"}, {"type": "subtitle", "time": 2309.67, "timestamp": "00:38:29", "text": "ヨアトンへ。"}, {"type": "subtitle", "time": 2312.15, "timestamp": "00:38:32", "text": "ありがとう。これまでで最高のJoond"}, {"type": "subtitle", "time": 2317.91, "timestamp": "00:38:37", "text": "ジョーはパンダになる予定だ。彼は"}, {"type": "subtitle", "time": 2320.23, "timestamp": "00:38:40", "text": "小さなパンダになろう。かわいいものになりそう"}, {"type": "subtitle", "time": 2322.39, "timestamp": "00:38:42", "text": "小さなパンダ。"}, {"type": "subtitle", "time": 2325.43, "timestamp": "00:38:45", "text": "うん。どうして私が正解できたんだろう？"}, {"type": "subtitle", "time": 2337.03, "timestamp": "00:38:57", "text": "いいえ、大丈夫です。"}]
[{"type": "subtitle", "time": 11281.11, "timestamp": "03:08:01", "text": "うん"}, {"type": "subtitle", "time": 11282.79, "timestamp": "03:08:02", "text": "大丈夫、わかった、わかった、"}, {"type": "subtitle", "time": 11286.71, "timestamp": "03:08:06", "text": "私はジョーになる、私はあなたの邪悪な相棒になる"}, {"type": "subtitle", "time": 11288.95, "timestamp": "03:08:08", "text": "私は、私は、私たちは征服する"}, {"type": "subtitle", "time": 11290.87, "timestamp": "03:08:10", "text": "世界の仕事、私たちは征服を始めます"}, {"type": "subtitle", "time": 11293.83, "timestamp": "03:08:13", "text": "世界"}, {"type": "subtitle", "time": 11295.59, "timestamp": "03:08:15", "text": "ウィル・ルー"}, {"type": "subtitle", "time": 11302.389, "timestamp": "03:08:22", "text": "私は自分が一体何者なのか全く分からない"}, {"type": "subtitle", "time": 11304.55, "timestamp": "03:08:24", "text": "もう。私はただのクィアです。私はクィアです"}, {"type": "subtitle", "time": 11311.03, "timestamp": "03:08:31", "text": "つまり、私は死ぬわけじゃない。クィアとは"}, {"type": "subtitle", "time": 11312.55, "timestamp": "03:08:32", "text": "まるで自分の"}, {"type": "subtitle", "time": 11315.03, "timestamp": "03:08:35", "text": "セクシュアリティは、そうですよね？"}, {"type": "subtitle", "time": 11316.95, "timestamp": "03:08:36", "text": "厳密にはそうではない。クィアとは、まるで"}, {"type": "subtitle", "time": 11318.71, "timestamp": "03:08:38", "text": "何かを特定しないことを選択する"}, {"type": "subtitle", "time": 11321.59, "timestamp": "03:08:41", "text": "特定の。"}, {"type": "subtitle", "time": 11323.429, "timestamp": "03:08:43", "text": "うん。だから、まあ、そうですね、"}, {"type": "subtitle", "time": 11325.83, "timestamp": "03:08:45", "text": "あなたはストレートではないけれど、"}, {"type": "subtitle", "time": 11327.75, "timestamp": "03:08:47", "text": "ラベルは一切不要です。ラベルを貼りたくない"}, {"type": "chat", "time": 11328.61, "timestamp": "03:08:48", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "hlo JOQQ"}, {"type": "subtitle", "time": 11329.26, "timestamp": "03:08:49", "text": "自分自身に対して。"}, {"type": "subtitle", "time": 11330.95, "timestamp": "03:08:50", "text": "[音楽]"}, {"type": "subtitle", "time": 11336.79, "timestamp": "03:08:56", "text": "ええ、私はただただプライド月間を祝っています。彼"}, {"type": "subtitle", "time": 11339.91, "timestamp": "03:08:59", "text": "プライド月間。うん、今月は私の月だよ、チャット。"}]
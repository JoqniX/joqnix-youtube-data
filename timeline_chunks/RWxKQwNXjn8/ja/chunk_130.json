[{"type": "subtitle", "time": 7802.229, "timestamp": "02:10:02", "text": "私はそれをグーグルで調べてほしいのですが、"}, {"type": "subtitle", "time": 7806.069, "timestamp": "02:10:06", "text": "配信中にそれに対する反応を見たい。わかった。"}, {"type": "subtitle", "time": 7809.589, "timestamp": "02:10:09", "text": "ジェイミー・オリバー。"}, {"type": "subtitle", "time": 7813.589, "timestamp": "02:10:13", "text": "バターチキン。バターチキン。"}, {"type": "subtitle", "time": 7816.629, "timestamp": "02:10:16", "text": "それは人道に対する罪だ。"}, {"type": "subtitle", "time": 7820.39, "timestamp": "02:10:20", "text": "ジェイミーとママ"}, {"type": "subtitle", "time": 7823.99, "timestamp": "02:10:23", "text": "えっと、ジェイミー・オリーブのバターチキンレシピです。"}, {"type": "subtitle", "time": 7827.35, "timestamp": "02:10:27", "text": "ジェイミーとマリカ、またはジェイミーのカシューナッツ"}, {"type": "subtitle", "time": 7829.35, "timestamp": "02:10:29", "text": "バターチキンは、家族みんなで料理を楽しもう。"}, {"type": "subtitle", "time": 7832.709, "timestamp": "02:10:32", "text": "どちらですか？"}, {"type": "subtitle", "time": 7834.87, "timestamp": "02:10:34", "text": "2番目だと思います。バター"}, {"type": "subtitle", "time": 7837.189, "timestamp": "02:10:37", "text": "鶏肉1羽。わかった。それは、"}, {"type": "subtitle", "time": 7839.75, "timestamp": "02:10:39", "text": "彼がやったのはこれだと思う"}, {"type": "subtitle", "time": 7843.83, "timestamp": "02:10:43", "text": "えっと、ロジャーおじさん。"}, {"type": "subtitle", "time": 7847.99, "timestamp": "02:10:47", "text": "いや、あれはアンガがそれに反応しただけだ。おお、"}, {"type": "subtitle", "time": 7851.03, "timestamp": "02:10:51", "text": "うん。彼が反応したのはそれだった。わかった。"}, {"type": "subtitle", "time": 7853.91, "timestamp": "02:10:53", "text": "では、これだ。わかった。"}, {"type": "subtitle", "time": 7855.99, "timestamp": "02:10:55", "text": "うん。"}]
[{"type": "subtitle", "time": 10261.67, "timestamp": "02:51:01", "text": "それについてはよく分かりません。"}, {"type": "subtitle", "time": 10265.75, "timestamp": "02:51:05", "text": "みんながあなたのことを知っているので、あなたも知っていて、彼らは"}, {"type": "subtitle", "time": 10269.11, "timestamp": "02:51:09", "text": "愛している。みんながどうやって"}, {"type": "subtitle", "time": 10272.23, "timestamp": "02:51:12", "text": "私のことを知っている。私はただ自分が"}, {"type": "subtitle", "time": 10275.429, "timestamp": "02:51:15", "text": "安いし、そう、他の人は"}, {"type": "subtitle", "time": 10279.03, "timestamp": "02:51:19", "text": "あなたはここで、あなたはなり"}, {"type": "subtitle", "time": 10281.51, "timestamp": "02:51:21", "text": "彼らと友達になりたいなら、もしあなたが"}, {"type": "subtitle", "time": 10284.389, "timestamp": "02:51:24", "text": "孤独を感じたり、何か知っていることがある"}, {"type": "subtitle", "time": 10287.91, "timestamp": "02:51:27", "text": "私一人で外にいる。"}, {"type": "subtitle", "time": 10291.67, "timestamp": "02:51:31", "text": "ジョーは、人々が"}, {"type": "subtitle", "time": 10293.75, "timestamp": "02:51:33", "text": "みんながそうするわけじゃない、みんながそうするわけじゃない"}, {"type": "subtitle", "time": 10296.07, "timestamp": "02:51:36", "text": "いつも誰かを歓迎してくれる"}, {"type": "subtitle", "time": 10297.51, "timestamp": "02:51:37", "text": "でもあなたはいつもそこにいる、それは何か"}, {"type": "subtitle", "time": 10300.309, "timestamp": "02:51:40", "text": "あなたはそれを誇りに思うべきです、それは違います"}, {"type": "subtitle", "time": 10301.67, "timestamp": "02:51:41", "text": "何もしていない、あなたがやっている"}, {"type": "subtitle", "time": 10303.83, "timestamp": "02:51:43", "text": "すべて順調なので、誇りに思ってください"}, {"type": "subtitle", "time": 10306.309, "timestamp": "02:51:46", "text": "あなた自身"}, {"type": "subtitle", "time": 10308.81, "timestamp": "02:51:48", "text": "よくやった、いい子だ"}, {"type": "subtitle", "time": 10314.23, "timestamp": "02:51:54", "text": "1"}, {"type": "subtitle", "time": 10316.87, "timestamp": "02:51:56", "text": "とっても可愛い！本当にパンダみたい！"}]
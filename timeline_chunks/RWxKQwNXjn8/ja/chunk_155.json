[{"type": "subtitle", "time": 9304.95, "timestamp": "02:35:04", "text": "かわいいですね。あなたたちは私の"}, {"type": "subtitle", "time": 9306.63, "timestamp": "02:35:06", "text": "ちっちゃな子。君たちって本当に意地悪だね。見て"}, {"type": "subtitle", "time": 9309.99, "timestamp": "02:35:09", "text": "彼に向かって。彼はまだ小柄な子だ。"}, {"type": "subtitle", "time": 9318.95, "timestamp": "02:35:18", "text": "ごめんなさい。ごめんなさい。 Qとあなたの"}, {"type": "subtitle", "time": 9335.67, "timestamp": "02:35:35", "text": "誓います、誓います、私はただ、私は、私は"}, {"type": "subtitle", "time": 9339.99, "timestamp": "02:35:39", "text": "悪い。私は言語障害があります。"}, {"type": "subtitle", "time": 9342.63, "timestamp": "02:35:42", "text": "冗談じゃないよ。私の体は実際には"}, {"type": "subtitle", "time": 9345.67, "timestamp": "02:35:45", "text": "形が間違っている。私は、私はあなたがそうではないと思う"}, {"type": "subtitle", "time": 9347.27, "timestamp": "02:35:47", "text": "私がこれを配信で言ったことがあるかどうかはわかりませんが、"}, {"type": "subtitle", "time": 9348.63, "timestamp": "02:35:48", "text": "でも、君たちの口がどんなものかは知ってるよね"}, {"type": "subtitle", "time": 9350.79, "timestamp": "02:35:50", "text": "こういう見た目になるはずなの？これは"}, {"type": "subtitle", "time": 9352.79, "timestamp": "02:35:52", "text": "君の口みたいに、君の形みたいに"}, {"type": "subtitle", "time": 9355.75, "timestamp": "02:35:55", "text": "ご存知のように、口の中では"}, {"type": "subtitle", "time": 9358.55, "timestamp": "02:35:58", "text": "あなたの図はどのようなものですか。うん。それで"}]
[{"type": "subtitle", "time": 962.71, "timestamp": "00:16:02", "text": "何てことだ。わかった。ええと、わかりました。中性。"}, {"type": "subtitle", "time": 964.87, "timestamp": "00:16:04", "text": "中立的な善。それなら結構です。もし誰かが言ったら"}, {"type": "subtitle", "time": 967.59, "timestamp": "00:16:07", "text": "あなたにとってそれはどういう意味ですか？あなたならどうしますか？ああ、"}, {"type": "subtitle", "time": 971.03, "timestamp": "00:16:11", "text": "神。殴ってやれ。"}, {"type": "subtitle", "time": 973.59, "timestamp": "00:16:13", "text": "えっと"}, {"type": "subtitle", "time": 978.069, "timestamp": "00:16:18", "text": "苦闘は、それはあまり良いことではないと言った。"}, {"type": "subtitle", "time": 980.069, "timestamp": "00:16:20", "text": "自分が住みたい場所を選びましょう。"}, {"type": "subtitle", "time": 982.55, "timestamp": "00:16:22", "text": "どこかの森の寒さの中で"}, {"type": "subtitle", "time": 986.069, "timestamp": "00:16:26", "text": "山々に囲まれた田舎の大都市"}, {"type": "subtitle", "time": 989.03, "timestamp": "00:16:29", "text": "ビーチ。えっと"}, {"type": "subtitle", "time": 991.509, "timestamp": "00:16:31", "text": "もし私が寒い場所に住むとしたら"}, {"type": "subtitle", "time": 993.749, "timestamp": "00:16:33", "text": "雪だるまを作ることができた。"}, {"type": "subtitle", "time": 996.87, "timestamp": "00:16:36", "text": "それは本当です。雪だるまってかっこいいよね。もし私が"}, {"type": "subtitle", "time": 999.59, "timestamp": "00:16:39", "text": "森の中にいたとき、心配しなければならないのは"}, {"type": "subtitle", "time": 1001.59, "timestamp": "00:16:41", "text": "湿気と汚れと"}, {"type": "subtitle", "time": 1003.91, "timestamp": "00:16:43", "text": "すべて。でも私もそうしたい"}, {"type": "subtitle", "time": 1007.99, "timestamp": "00:16:47", "text": "木の上にいる猿。になる予定"}, {"type": "subtitle", "time": 1009.189, "timestamp": "00:16:49", "text": "猿のように。スイングするよ"}, {"type": "subtitle", "time": 1011.59, "timestamp": "00:16:51", "text": "木々から。私は"}, {"type": "subtitle", "time": 1015.59, "timestamp": "00:16:55", "text": "千。何てことだ。国内では"}, {"type": "subtitle", "time": 1018.87, "timestamp": "00:16:58", "text": "すごく良さそうですね。自然"}]
[{"type": "subtitle", "time": 2760.87, "timestamp": "00:46:00", "text": "それは、それは、それは"}, {"type": "subtitle", "time": 2762.87, "timestamp": "00:46:02", "text": "素晴らしい仕事ぶりです。信じるしかない"}, {"type": "subtitle", "time": 2765.589, "timestamp": "00:46:05", "text": "その過程で全てがうまくいくでしょう"}, {"type": "subtitle", "time": 2776.79, "timestamp": "00:46:16", "text": "ジョーンはとても素敵な人に見える。ウッド夫人"}, {"type": "subtitle", "time": 2782.069, "timestamp": "00:46:22", "text": "人事部に報告する"}, {"type": "subtitle", "time": 2783.589, "timestamp": "00:46:23", "text": "ただ"}, {"type": "subtitle", "time": 2785.67, "timestamp": "00:46:25", "text": "あなたたちは私の小さな子にとても意地悪です"}, {"type": "subtitle", "time": 2791.589, "timestamp": "00:46:31", "text": "それは、それは、それを与える"}, {"type": "subtitle", "time": 2793.03, "timestamp": "00:46:33", "text": "一瞬。少し時間をください。それは"}, {"type": "subtitle", "time": 2794.87, "timestamp": "00:46:34", "text": "パンダに似ている。少し時間をください。"}, {"type": "subtitle", "time": 2801.109, "timestamp": "00:46:41", "text": "君たちはプロセスを急ぎすぎている。あなた"}]
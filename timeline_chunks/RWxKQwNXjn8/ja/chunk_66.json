[{"type": "subtitle", "time": 3961.029, "timestamp": "01:06:01", "text": "それは、えっと、それは、それは、それは、"}, {"type": "subtitle", "time": 3963.349, "timestamp": "01:06:03", "text": "これも大部分が人間の過ちである。"}, {"type": "subtitle", "time": 3966.23, "timestamp": "01:06:06", "text": "ほとんどの自然物と同様に。しかし、パナスも"}, {"type": "subtitle", "time": 3968.23, "timestamp": "01:06:08", "text": "生存能力がかなり低い"}, {"type": "subtitle", "time": 3970.63, "timestamp": "01:06:10", "text": "とにかく。"}, {"type": "subtitle", "time": 3979.43, "timestamp": "01:06:19", "text": "それは美しい。あなたはやっている"}, {"type": "subtitle", "time": 3981.99, "timestamp": "01:06:21", "text": "素晴らしい仕事ぶりです。自分が何者なのかさえわからない"}, {"type": "subtitle", "time": 3985.349, "timestamp": "01:06:25", "text": "実行中。信じられない。ええ、あなたは削除しました"}, {"type": "subtitle", "time": 3992.63, "timestamp": "01:06:32", "text": "まるで自分が遊んでいるみたいだった"}, {"type": "subtitle", "time": 3995.109, "timestamp": "01:06:35", "text": "その周り。"}, {"type": "subtitle", "time": 3999.67, "timestamp": "01:06:39", "text": "しかし彼はもういない。彼は今では貧乏だ。彼は貧しい。"}, {"type": "subtitle", "time": 4009.829, "timestamp": "01:06:49", "text": "大丈夫だよ、ジョー。大丈夫。私たちは私たちは"}, {"type": "subtitle", "time": 4017.43, "timestamp": "01:06:57", "text": "私もそうは思わない。ああ、そうだね。私は欲しかった"}, {"type": "subtitle", "time": 4019.75, "timestamp": "01:06:59", "text": "私が描いたものをお見せします"}]
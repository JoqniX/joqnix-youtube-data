[{"type": "subtitle", "time": 9780.15, "timestamp": "02:43:00", "text": "こちらはチャットです。そして彼らは邪悪だ。その"}, {"type": "subtitle", "time": 9783.349, "timestamp": "02:43:03", "text": "邪悪なチャット。"}, {"type": "subtitle", "time": 9785.51, "timestamp": "02:43:05", "text": "悪質なチャット。"}, {"type": "subtitle", "time": 9787.91, "timestamp": "02:43:07", "text": "チャットは悪だ。"}, {"type": "subtitle", "time": 9796.71, "timestamp": "02:43:16", "text": "ニューエイジはアフリカのエジプトから生まれた。わかった。"}, {"type": "subtitle", "time": 9800.79, "timestamp": "02:43:20", "text": "それは知りませんでした。それはおかしい。"}, {"type": "subtitle", "time": 9803.67, "timestamp": "02:43:23", "text": "おお。私たちは、それが汚染されていないことを学んだ。はい。"}, {"type": "subtitle", "time": 9806.15, "timestamp": "02:43:26", "text": "チョークは非常に純度が高い。"}, {"type": "subtitle", "time": 9808.389, "timestamp": "02:43:28", "text": "チョークは小さな天使だ。絵を描かせてください"}, {"type": "subtitle", "time": 9810.469, "timestamp": "02:43:30", "text": "チョーク。天使。"}, {"type": "subtitle", "time": 9821.75, "timestamp": "02:43:41", "text": "[音楽]"}, {"type": "subtitle", "time": 9823.429, "timestamp": "02:43:43", "text": "あなたはアバターを作成する必要があります。"}, {"type": "subtitle", "time": 9826.54, "timestamp": "02:43:46", "text": "ああ、まだマスコットがいないんですね。"}, {"type": "subtitle", "time": 9829.59, "timestamp": "02:43:49", "text": "[音楽]"}, {"type": "subtitle", "time": 9831.75, "timestamp": "02:43:51", "text": "M. マスコットはいません"}, {"type": "subtitle", "time": 9834.71, "timestamp": "02:43:54", "text": "まだ。私は彼らをマスコットにはしていません。見る"}]
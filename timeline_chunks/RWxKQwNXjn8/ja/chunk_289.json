[{"type": "subtitle", "time": 17342.628, "timestamp": "04:49:02", "text": "最後の2つは黄色？黄色が2つ。わかった。"}, {"type": "subtitle", "time": 17344.948, "timestamp": "04:49:04", "text": "えっと"}, {"type": "subtitle", "time": 17348.55, "timestamp": "04:49:08", "text": "赤い配線はありますか？いいえ。"}, {"type": "subtitle", "time": 17353.59, "timestamp": "04:49:13", "text": "えっと、最後のワイヤーを切ってください。最後のワイヤー。終わり。"}, {"type": "subtitle", "time": 17355.59, "timestamp": "04:49:15", "text": "わかった。良い。"}, {"type": "subtitle", "time": 17361.03, "timestamp": "04:49:21", "text": "わーい！"}, {"type": "subtitle", "time": 17375.11, "timestamp": "04:49:35", "text": "なんてこった、"}, {"type": "subtitle", "time": 17377.43, "timestamp": "04:49:37", "text": "言わないで。ズチズチはまだ"}, {"type": "subtitle", "time": 17379.67, "timestamp": "04:49:39", "text": "私の残りの時間の倍以上。何"}, {"type": "subtitle", "time": 17383.67, "timestamp": "04:49:43", "text": "なんだよ、ジ？"}, {"type": "subtitle", "time": 17386.47, "timestamp": "04:49:46", "text": "何てことだ。"}, {"type": "subtitle", "time": 17393.67, "timestamp": "04:49:53", "text": "音量を上げないといけないかもしれない。"}]
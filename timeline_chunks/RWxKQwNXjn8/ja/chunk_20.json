[{"type": "subtitle", "time": 1203.669, "timestamp": "00:20:03", "text": "米だけではない。もし夕方なら"}, {"type": "subtitle", "time": 1205.43, "timestamp": "00:20:05", "text": "家の中には何もない、私は"}, {"type": "subtitle", "time": 1209.19, "timestamp": "00:20:09", "text": "「よし、また昼食の時間だ。」みたいな感じ。"}, {"type": "subtitle", "time": 1211.75, "timestamp": "00:20:11", "text": "ああ、ジョー、あなたはオーケーが必要です。"}, {"type": "subtitle", "time": 1213.59, "timestamp": "00:20:13", "text": "わかった。たとえあなたが正しい食生活を送りたいと思っていても、"}, {"type": "subtitle", "time": 1216.549, "timestamp": "00:20:16", "text": "君が作るようにできる、君が作るようにできる"}, {"type": "subtitle", "time": 1219.909, "timestamp": "00:20:19", "text": "その他のこと。それは何ですか？"}, {"type": "subtitle", "time": 1222.07, "timestamp": "00:20:22", "text": "なぜか分からないけど、もし私が"}, {"type": "subtitle", "time": 1224.39, "timestamp": "00:20:24", "text": "ご飯を食べないで、お腹が痛くならない"}, {"type": "subtitle", "time": 1226.39, "timestamp": "00:20:26", "text": "満杯か何かだ。わからない。それ"}, {"type": "subtitle", "time": 1229.99, "timestamp": "00:20:29", "text": "まさにあの瞬間のようだった。たとえ私が食べても"}, {"type": "subtitle", "time": 1235.59, "timestamp": "00:20:35", "text": "麺類は、うん、足りない"}, {"type": "subtitle", "time": 1238.149, "timestamp": "00:20:38", "text": "そういう類のもの。でも、食べる量も減りました。"}, {"type": "subtitle", "time": 1241.43, "timestamp": "00:20:41", "text": "そういう側面もあるんですね。それはとても多いです、"}, {"type": "subtitle", "time": 1244.23, "timestamp": "00:20:44", "text": "右？ Q. 私は、これが"}, {"type": "subtitle", "time": 1247.909, "timestamp": "00:20:47", "text": "アジアにとっても、それは普通のことではない。これは"}, {"type": "subtitle", "time": 1256.149, "timestamp": "00:20:56", "text": "そうではありません。みんなそうするものだと思っていました。"}, {"type": "subtitle", "time": 1259.43, "timestamp": "00:20:59", "text": "冗談じゃないよ。わかった。うん。人々は米が好きです"}]
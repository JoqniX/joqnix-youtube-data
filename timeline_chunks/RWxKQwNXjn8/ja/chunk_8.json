[{"type": "subtitle", "time": 480.469, "timestamp": "00:08:00", "text": "働く。うまくいっている。うまくいっている。"}, {"type": "subtitle", "time": 483.27, "timestamp": "00:08:03", "text": "わかった。私のいたずらはうまくいっている。私は元気です。私"}, {"type": "subtitle", "time": 486.39, "timestamp": "00:08:06", "text": "元気です。全ては"}, {"type": "subtitle", "time": 488.39, "timestamp": "00:08:08", "text": "わかった。"}, {"type": "subtitle", "time": 493.35, "timestamp": "00:08:13", "text": "ちょっと待って、私も自分のを確認してみる。なんてこった。"}, {"type": "subtitle", "time": 495.909, "timestamp": "00:08:15", "text": "私たちはとてもよく計画しました。私たちはとても得意です"}, {"type": "subtitle", "time": 498.79, "timestamp": "00:08:18", "text": "計画。何てことだ。プロ"}, {"type": "subtitle", "time": 500.39, "timestamp": "00:08:20", "text": "ストリーマー。"}, {"type": "subtitle", "time": 510.869, "timestamp": "00:08:30", "text": "何？あなたはどんな試合に出ているのですか？"}, {"type": "subtitle", "time": 512.79, "timestamp": "00:08:32", "text": "どんな試合ですか？でも、あなたはプレイしていますか？"}, {"type": "subtitle", "time": 516.23, "timestamp": "00:08:36", "text": "またリーグ・オブ・レジェンドかよ？"}, {"type": "subtitle", "time": 525.59, "timestamp": "00:08:45", "text": "リーグ。私はリーグ・オブ・レジェンドをプレイしたいのですが、"}, {"type": "subtitle", "time": 529.43, "timestamp": "00:08:49", "text": "ただ、長すぎるんです。"}, {"type": "subtitle", "time": 531.269, "timestamp": "00:08:51", "text": "長すぎる。"}]
[{"type": "subtitle", "time": 7202.79, "timestamp": "02:00:02", "text": "ストリーミングしないと違和感がある。おお。それはとても"}, {"type": "subtitle", "time": 7208.07, "timestamp": "02:00:08", "text": "平均。それは[ __ ]ではない。"}, {"type": "subtitle", "time": 7211.75, "timestamp": "02:00:11", "text": "おお。本当に、私に対してひどい。ほら、これが理由だよ"}, {"type": "subtitle", "time": 7214.149, "timestamp": "02:00:14", "text": "ジョーはあなたたち全員よりずっと優れている。彼"}, {"type": "subtitle", "time": 7217.91, "timestamp": "02:00:17", "text": "私をいじめることは決してないだろう。"}, {"type": "subtitle", "time": 7220.87, "timestamp": "02:00:20", "text": "このコメントに気づきました。なぜ"}, {"type": "subtitle", "time": 7225.109, "timestamp": "02:00:25", "text": "チャットで配信者をいじめる人がまたいるの？"}, {"type": "subtitle", "time": 7228.149, "timestamp": "02:00:28", "text": "ああ、それはそれはそれはそれはそれはそれは何"}, {"type": "subtitle", "time": 7230.07, "timestamp": "02:00:30", "text": "冗談を言うのは。だから、ジョー、冗談を言うときは、"}, {"type": "subtitle", "time": 7232.31, "timestamp": "02:00:32", "text": "問題は、えーと、冗談を言うのは一種の"}, {"type": "subtitle", "time": 7235.51, "timestamp": "02:00:35", "text": "えっと、どう言えばいいかな？"}, {"type": "subtitle", "time": 7238.55, "timestamp": "02:00:38", "text": "えっと、ジョー、誰かに近づいて"}, {"type": "subtitle", "time": 7240.79, "timestamp": "02:00:40", "text": "意地悪な言い方をするなら、"}, {"type": "subtitle", "time": 7243.91, "timestamp": "02:00:43", "text": "見知らぬ人に「臭い」と言う？"}, {"type": "subtitle", "time": 7247.27, "timestamp": "02:00:47", "text": "いいえ。ええ。でも、もしそれが"}, {"type": "subtitle", "time": 7249.35, "timestamp": "02:00:49", "text": "富士。"}, {"type": "subtitle", "time": 7253.109, "timestamp": "02:00:53", "text": "わかった。富士山は臭いと思いますか？"}, {"type": "subtitle", "time": 7254.39, "timestamp": "02:00:54", "text": "んーん。"}, {"type": "subtitle", "time": 7258.31, "timestamp": "02:00:58", "text": "いいえ、あなたはそうしないでしょう。いいえ。わかりました。あなた あなたは"}]
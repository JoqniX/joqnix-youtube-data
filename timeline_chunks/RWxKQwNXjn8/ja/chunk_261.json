[{"type": "subtitle", "time": 15660.229, "timestamp": "04:21:00", "text": "良い。"}, {"type": "subtitle", "time": 15663.83, "timestamp": "04:21:03", "text": "皆さんはスプーンを使って食事をしますか？"}, {"type": "subtitle", "time": 15665.99, "timestamp": "04:21:05", "text": "つまり、最終的には私は"}, {"type": "subtitle", "time": 15668.71, "timestamp": "04:21:08", "text": "箸を使う"}, {"type": "subtitle", "time": 15671.59, "timestamp": "04:21:11", "text": "ええ、私は毎日スプーンを使っています。私はしません"}, {"type": "subtitle", "time": 15673.11, "timestamp": "04:21:13", "text": "知る"}, {"type": "subtitle", "time": 15675.269, "timestamp": "04:21:15", "text": "家族はみんな私にたくさん話してくれる"}, {"type": "subtitle", "time": 15678.469, "timestamp": "04:21:18", "text": "周りの人たちが、あなたの仕事について教えてくれる"}, {"type": "subtitle", "time": 15682.07, "timestamp": "04:21:22", "text": "手で食べる"}, {"type": "subtitle", "time": 15686.55, "timestamp": "04:21:26", "text": "さもないと、えっと、君か、さもないと何もない"}, {"type": "subtitle", "time": 15688.71, "timestamp": "04:21:28", "text": "体内に何も現れません"}, {"type": "subtitle", "time": 15691.11, "timestamp": "04:21:31", "text": "消化に良いものなど"}, {"type": "subtitle", "time": 15693.75, "timestamp": "04:21:33", "text": "食べ方って、"}, {"type": "subtitle", "time": 15697.269, "timestamp": "04:21:37", "text": "重要なのは"}, {"type": "subtitle", "time": 15703.189, "timestamp": "04:21:43", "text": "あなたが食べる米がどのような方法であるか"}, {"type": "subtitle", "time": 15705.91, "timestamp": "04:21:45", "text": "食物"}, {"type": "subtitle", "time": 15710.229, "timestamp": "04:21:50", "text": "スプーンでもフォークでも"}, {"type": "subtitle", "time": 15712.87, "timestamp": "04:21:52", "text": "もの。"}, {"type": "subtitle", "time": 15716.95, "timestamp": "04:21:56", "text": "皆さんはどう思いますか？"}]
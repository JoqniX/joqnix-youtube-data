[{"type": "subtitle", "time": 10568.15, "timestamp": "02:56:08", "text": "悪い奴らは去る。いいえ、あなたは"}, {"type": "subtitle", "time": 10577.91, "timestamp": "02:56:17", "text": "私ですか？何てことだ。なんて失礼な。なんて失礼な。それで"}, {"type": "subtitle", "time": 10579.91, "timestamp": "02:56:19", "text": "失礼。"}, {"type": "subtitle", "time": 10586.79, "timestamp": "02:56:26", "text": "私はフェレットが大好きです。とてもかわいい。"}, {"type": "subtitle", "time": 10589.51, "timestamp": "02:56:29", "text": "私はフェレットが大好きです。"}, {"type": "subtitle", "time": 10591.03, "timestamp": "02:56:31", "text": "周りに小さなハートを描きます"}, {"type": "subtitle", "time": 10592.81, "timestamp": "02:56:32", "text": "フェレット。"}, {"type": "subtitle", "time": 10598.53, "timestamp": "02:56:38", "text": "はい。"}, {"type": "subtitle", "time": 10605.83, "timestamp": "02:56:45", "text": "おお。信じられない"}, {"type": "subtitle", "time": 10614.23, "timestamp": "02:56:54", "text": "やったー。あなたの一番好きなことは"}, {"type": "subtitle", "time": 10617.269, "timestamp": "02:56:57", "text": "ジョック、引くのか？"}]
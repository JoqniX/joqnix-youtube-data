[{"type": "subtitle", "time": 1622.65, "timestamp": "00:27:02", "text": "世界の種。クマ。えっと。"}, {"type": "subtitle", "time": 1624.149, "timestamp": "00:27:04", "text": "[音楽]"}, {"type": "subtitle", "time": 1627.59, "timestamp": "00:27:07", "text": "はぁ？おお。はぁ。"}, {"type": "subtitle", "time": 1629.83, "timestamp": "00:27:09", "text": "そうではないと思う。"}, {"type": "subtitle", "time": 1634.23, "timestamp": "00:27:14", "text": "それらはカンガルーに近い。くそ。"}, {"type": "subtitle", "time": 1636.88, "timestamp": "00:27:16", "text": "くそ。 君たちはクールにはなれないみたいだね。"}, {"type": "subtitle", "time": 1641.2, "timestamp": "00:27:21", "text": "君たちはクールにはなれないみたいだね。 マレーグマはめちゃくちゃハイになってるように見える。マレーグマ"}, {"type": "subtitle", "time": 1644.24, "timestamp": "00:27:24", "text": "マレーグマはめちゃくちゃハイになってるように見える。マレーグマ クマの着ぐるみを着た男がいるように見える"}, {"type": "subtitle", "time": 1647.12, "timestamp": "00:27:27", "text": "クマの着ぐるみを着た男がいるように見える スーツ。彼らは"}, {"type": "subtitle", "time": 1649.6, "timestamp": "00:27:29", "text": "スーツ。彼らは これを見てください、そうです。"}, {"type": "subtitle", "time": 1656.63, "timestamp": "00:27:36", "text": "怒りよりも関係性を優先する。抽象的な"}, {"type": "subtitle", "time": 1660.149, "timestamp": "00:27:40", "text": "怒り。ああ、コンクリート。わかった。マイクロフォーカス。"}, {"type": "subtitle", "time": 1662.39, "timestamp": "00:27:42", "text": "何を理解するのか？何？私はどこにいるのか"}, {"type": "subtitle", "time": 1665.669, "timestamp": "00:27:45", "text": "私？私は今、どこまで来たのだろうか？何？何が"}, {"type": "subtitle", "time": 1671.99, "timestamp": "00:27:51", "text": "仕事、友情、親友。"}, {"type": "subtitle", "time": 1675.59, "timestamp": "00:27:55", "text": "わかった。待って。いいえ。ええと、純粋な性格です。"}, {"type": "subtitle", "time": 1678.31, "timestamp": "00:27:58", "text": "わかった。自信があり、倫理的で、革新的で、"}]
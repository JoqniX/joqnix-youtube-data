[{"type": "subtitle", "time": 10081.349, "timestamp": "02:48:01", "text": "薬を飲むことさえも"}, {"type": "subtitle", "time": 10082.389, "timestamp": "02:48:02", "text": "私を助けてくれるはず"}, {"type": "subtitle", "time": 10083.99, "timestamp": "02:48:03", "text": "先延ばし。"}, {"type": "subtitle", "time": 10086.63, "timestamp": "02:48:06", "text": "それで、えーと、"}, {"type": "subtitle", "time": 10088.23, "timestamp": "02:48:08", "text": "彼"}, {"type": "subtitle", "time": 10089.91, "timestamp": "02:48:09", "text": "エラーのように聞こえます。ええ、"}, {"type": "subtitle", "time": 10093.349, "timestamp": "02:48:13", "text": "よく言われます。"}, {"type": "subtitle", "time": 10095.91, "timestamp": "02:48:15", "text": "インド人以外の人とはどういう関係ですか？えっと、"}, {"type": "subtitle", "time": 10097.91, "timestamp": "02:48:17", "text": "大統領ではないインド人。つまり、"}, {"type": "subtitle", "time": 10100.63, "timestamp": "02:48:20", "text": "海外在住のインド人。ああ、それは"}, {"type": "subtitle", "time": 10104.15, "timestamp": "02:48:24", "text": "将来の私になるだろう。いいえ。"}, {"type": "subtitle", "time": 10107.51, "timestamp": "02:48:27", "text": "我が神よ。何てことだ。"}, {"type": "subtitle", "time": 10116.15, "timestamp": "02:48:36", "text": "そして鶏肉。"}, {"type": "subtitle", "time": 10124.87, "timestamp": "02:48:44", "text": "今、すごく侮辱された気分です。私"}, {"type": "subtitle", "time": 10127.15, "timestamp": "02:48:47", "text": "信じられない。"}, {"type": "subtitle", "time": 10129.429, "timestamp": "02:48:49", "text": "[音楽]"}, {"type": "subtitle", "time": 10133.67, "timestamp": "02:48:53", "text": "いいえ、正直に言うと、私のヒンディー語は下手です。"}, {"type": "subtitle", "time": 10136.87, "timestamp": "02:48:56", "text": "私の発音はひどい。"}]
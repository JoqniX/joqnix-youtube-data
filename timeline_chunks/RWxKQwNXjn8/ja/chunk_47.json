[{"type": "subtitle", "time": 2828.069, "timestamp": "00:47:08", "text": "男たちもプロセスを急いでいる"}, {"type": "subtitle", "time": 2830.47, "timestamp": "00:47:10", "text": "多くの。信念を持たなければならない。できない"}, {"type": "subtitle", "time": 2834.23, "timestamp": "00:47:14", "text": "チャド、君は勝てないと思ってるんだね。"}, {"type": "subtitle", "time": 2836.15, "timestamp": "00:47:16", "text": "もしあなたが私を信じたいなら"}, {"type": "subtitle", "time": 2859.589, "timestamp": "00:47:39", "text": "いいよ、チャットしよう。大丈夫だよ。"}, {"type": "subtitle", "time": 2862.39, "timestamp": "00:47:42", "text": "すべてうまくいくよ。そして"}, {"type": "subtitle", "time": 2864.95, "timestamp": "00:47:44", "text": "ジャグは本物のパンダになるよ、みんな。"}]
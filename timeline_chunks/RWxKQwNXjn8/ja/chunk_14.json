[{"type": "subtitle", "time": 844.47, "timestamp": "00:14:04", "text": "それを踏まえて、"}, {"type": "subtitle", "time": 847.59, "timestamp": "00:14:07", "text": "中立って何だったっけ？法的な中立。"}, {"type": "subtitle", "time": 850.55, "timestamp": "00:14:10", "text": "法中立は法中立のようなもの"}, {"type": "subtitle", "time": 854.47, "timestamp": "00:14:14", "text": "あなたは法律を遵守する市民です。あなたはあなたです"}, {"type": "subtitle", "time": 858.389, "timestamp": "00:14:18", "text": "君はまるでNPCみたいだ。あなたは存在する、"}, {"type": "subtitle", "time": 860.629, "timestamp": "00:14:20", "text": "でも、つまり、あなたはまだ"}, {"type": "subtitle", "time": 863.189, "timestamp": "00:14:23", "text": "ルールに従うように、でもあなたはそうしない"}, {"type": "subtitle", "time": 864.629, "timestamp": "00:14:24", "text": "わざわざ"}, {"type": "subtitle", "time": 874.15, "timestamp": "00:14:34", "text": "あなたは秩序善か中立かもしれません"}, {"type": "subtitle", "time": 879.67, "timestamp": "00:14:39", "text": "ジョックジョックはとてもいい人です。あなたはそうしなければならない"}, {"type": "subtitle", "time": 883.35, "timestamp": "00:14:43", "text": "良い方の範疇に入る。ジョックジョックはあまりにも"}, {"type": "subtitle", "time": 887.829, "timestamp": "00:14:47", "text": "[音楽]"}, {"type": "subtitle", "time": 890.23, "timestamp": "00:14:50", "text": "えっと"}, {"type": "subtitle", "time": 898.47, "timestamp": "00:14:58", "text": "なぜか分からないけど、富士山が"}]
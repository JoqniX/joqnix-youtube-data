[{"type": "subtitle", "time": 1440.31, "timestamp": "00:24:00", "text": "ゲイの男性のような。何？何？あなた"}, {"type": "subtitle", "time": 1442.31, "timestamp": "00:24:02", "text": "クマが何なのか知らないの？"}, {"type": "subtitle", "time": 1450.149, "timestamp": "00:24:10", "text": "わかった。それで、ジョン、それは"}, {"type": "subtitle", "time": 1452.47, "timestamp": "00:24:12", "text": "クマの足と"}, {"type": "subtitle", "time": 1456.07, "timestamp": "00:24:16", "text": "いろいろなもの、そしてあなたはクマのコスプレをして、"}, {"type": "subtitle", "time": 1459.029, "timestamp": "00:24:19", "text": "まるでエコーナナに似ている"}, {"type": "subtitle", "time": 1463.909, "timestamp": "00:24:23", "text": "いいえ、そういうことです。わかった。話す。だから私たちが"}, {"type": "subtitle", "time": 1466.87, "timestamp": "00:24:26", "text": "同性愛関係について話す"}, {"type": "subtitle", "time": 1469.99, "timestamp": "00:24:29", "text": "レズビアン同士、あるいは男性同士で、"}, {"type": "subtitle", "time": 1473.11, "timestamp": "00:24:33", "text": "ステレオタイプな用語のように、異なる。"}, {"type": "subtitle", "time": 1479.029, "timestamp": "00:24:39", "text": "つまり、ベアとは、大きくて毛深いゲイの男性のこと"}, {"type": "subtitle", "time": 1481.59, "timestamp": "00:24:41", "text": "それらは、ご存知のように大きく、そして"}, {"type": "subtitle", "time": 1483.59, "timestamp": "00:24:43", "text": "体毛が多い。クマは"}, {"type": "subtitle", "time": 1485.51, "timestamp": "00:24:45", "text": "手段。"}, {"type": "subtitle", "time": 1488.549, "timestamp": "00:24:48", "text": "そうそう。"}, {"type": "subtitle", "time": 1490.07, "timestamp": "00:24:50", "text": "もう一度繰り返していただけますか？"}, {"type": "subtitle", "time": 1494.39, "timestamp": "00:24:54", "text": "ちょっとの間、三つ編みをそのままにしておいた。えっと、"}, {"type": "subtitle", "time": 1498.87, "timestamp": "00:24:58", "text": "ベアとは、毛深い大柄なゲイ男性のことを指す。"}]
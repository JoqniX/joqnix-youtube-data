[{"type": "subtitle", "time": 13320.79, "timestamp": "03:42:00", "text": "私の誕生日にモデルとして"}, {"type": "subtitle", "time": 13324.469, "timestamp": "03:42:04", "text": "8月。でもお金がないとできない"}, {"type": "subtitle", "time": 13335.75, "timestamp": "03:42:15", "text": "だから、電流を流そうと思って"}, {"type": "subtitle", "time": 13339.11, "timestamp": "03:42:19", "text": "アカウントに支払わなければならない、"}, {"type": "subtitle", "time": 13341.349, "timestamp": "03:42:21", "text": "私には2つの選択肢があります 5,000と"}, {"type": "subtitle", "time": 13343.19, "timestamp": "03:42:23", "text": "10,000"}, {"type": "subtitle", "time": 13345.67, "timestamp": "03:42:25", "text": "現在の口座開設に必要な最低残高"}, {"type": "subtitle", "time": 13348.07, "timestamp": "03:42:28", "text": "Joのアカウントが次にあります。だから私は"}, {"type": "subtitle", "time": 13350.07, "timestamp": "03:42:30", "text": "そのためのお金。私はそうは思わない"}, {"type": "subtitle", "time": 13352.79, "timestamp": "03:42:32", "text": "そのお金を入れる"}, {"type": "subtitle", "time": 13354.79, "timestamp": "03:42:34", "text": "ジョアトン。私は実際にそのお金を"}, {"type": "subtitle", "time": 13357.75, "timestamp": "03:42:37", "text": "ライセンスのリードを購入するか、"}, {"type": "subtitle", "time": 13361.59, "timestamp": "03:42:41", "text": "年ですが、再びライセンスを購入します"}, {"type": "subtitle", "time": 13364.71, "timestamp": "03:42:44", "text": "1年ではあまり効果はないだろう。つまりそれは"}, {"type": "subtitle", "time": 13367.269, "timestamp": "03:42:47", "text": "それは私が公に"}, {"type": "subtitle", "time": 13369.99, "timestamp": "03:42:49", "text": "モデルについての投稿と、"}, {"type": "subtitle", "time": 13374.229, "timestamp": "03:42:54", "text": "そのシルエットとかをモデルにするんだ。しかし"}, {"type": "subtitle", "time": 13376.63, "timestamp": "03:42:56", "text": "それを貯めておく方がずっといいんじゃない？"}, {"type": "subtitle", "time": 13379.91, "timestamp": "03:42:59", "text": "約1000ドルかかるリギング"}]
[{"type": "subtitle", "time": 2644.15, "timestamp": "00:44:04", "text": "だから、膨らみではないのです。その"}, {"type": "subtitle", "time": 2645.75, "timestamp": "00:44:05", "text": "膨らみはない。膨らみではありません。それは"}, {"type": "subtitle", "time": 2648.23, "timestamp": "00:44:08", "text": "鼻先。"}, {"type": "subtitle", "time": 2649.67, "timestamp": "00:44:09", "text": "それは鼻面です。それは鼻面です。そしてそれは"}, {"type": "subtitle", "time": 2651.589, "timestamp": "00:44:11", "text": "素晴らしいものになるだろう。わかった。その"}, {"type": "subtitle", "time": 2660.95, "timestamp": "00:44:20", "text": "素晴らしいものになるだろう。我が神よ。うん、君、君"}, {"type": "subtitle", "time": 2662.63, "timestamp": "00:44:22", "text": "くまのプーさんにちょっと似てるよね"}, {"type": "subtitle", "time": 2669.349, "timestamp": "00:44:29", "text": "くまのプーさん。うん、君はかわいいね"}, {"type": "subtitle", "time": 2682.95, "timestamp": "00:44:42", "text": "全てがうまくいくでしょう。"}, {"type": "subtitle", "time": 2684.87, "timestamp": "00:44:44", "text": "チャド。全てがうまくいくでしょう"}, {"type": "subtitle", "time": 2687.589, "timestamp": "00:44:47", "text": "そしてそれは素晴らしいものになるでしょう。そして"}, {"type": "subtitle", "time": 2689.19, "timestamp": "00:44:49", "text": "あなたはすべての悪いものを取り戻すつもりです"}]
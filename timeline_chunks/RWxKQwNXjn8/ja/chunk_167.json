[{"type": "subtitle", "time": 10021.11, "timestamp": "02:47:01", "text": "友達が「ねえ、私には必要なの」って言ってたのを知ってる"}, {"type": "subtitle", "time": 10022.79, "timestamp": "02:47:02", "text": "ポートフォリオ用の資料。私はこう思った"}, {"type": "subtitle", "time": 10023.91, "timestamp": "02:47:03", "text": "あなたに無償で働かせるつもりはありません。"}, {"type": "subtitle", "time": 10025.67, "timestamp": "02:47:05", "text": "彼は大丈夫そうだ。そのまま入れることができます"}, {"type": "subtitle", "time": 10028.55, "timestamp": "02:47:08", "text": "君は僕が君に借りがあることを知ってるし、ただ僕に"}, {"type": "subtitle", "time": 10030.71, "timestamp": "02:47:10", "text": "それには何かがある。そして私は「わかった、"}, {"type": "subtitle", "time": 10032.79, "timestamp": "02:47:12", "text": "「これだよ」彼は「わかった」と言った。それで私は今"}, {"type": "subtitle", "time": 10034.79, "timestamp": "02:47:14", "text": "編集者。"}, {"type": "subtitle", "time": 10036.87, "timestamp": "02:47:16", "text": "えっと"}, {"type": "subtitle", "time": 10038.79, "timestamp": "02:47:18", "text": "私はインスタグラムのアカウントを持っていますが、"}, {"type": "subtitle", "time": 10042.15, "timestamp": "02:47:22", "text": "1年くらい前にそこに投稿された。そして、私は"}, {"type": "subtitle", "time": 10044.71, "timestamp": "02:47:24", "text": "インド人。私は完全な"}, {"type": "subtitle", "time": 10047.429, "timestamp": "02:47:27", "text": "純粋なインディアン。私はここで生まれました"}, {"type": "subtitle", "time": 10051.51, "timestamp": "02:47:31", "text": "インド。私はインドで育ちました。私はただ"}, {"type": "subtitle", "time": 10055.51, "timestamp": "02:47:35", "text": "ちょっと、ほら、"}, {"type": "subtitle", "time": 10057.91, "timestamp": "02:47:37", "text": "異なるアクセント。"}, {"type": "subtitle", "time": 10058.87, "timestamp": "02:47:38", "text": "そしてそれはまた別のレベルの"}, {"type": "subtitle", "time": 10061.59, "timestamp": "02:47:41", "text": "先延ばし。わかってる、わかってる、悪いことだって。"}, {"type": "subtitle", "time": 10064.07, "timestamp": "02:47:44", "text": "でも私はそれを続けている。やり方がわからない"}, {"type": "subtitle", "time": 10067.83, "timestamp": "02:47:47", "text": "アクセントを止めてください。"}, {"type": "subtitle", "time": 10071.03, "timestamp": "02:47:51", "text": "いや、いや、いや。えっと、私の先延ばし癖です。"}, {"type": "subtitle", "time": 10073.59, "timestamp": "02:47:53", "text": "ああ、つまり誰もが1つか2つ持っているということ"}, {"type": "subtitle", "time": 10076.389, "timestamp": "02:47:56", "text": "この先延ばしのレベル。うん。"}, {"type": "subtitle", "time": 10078.95, "timestamp": "02:47:58", "text": "問題は、結局先延ばしにしてしまうことだ"}]
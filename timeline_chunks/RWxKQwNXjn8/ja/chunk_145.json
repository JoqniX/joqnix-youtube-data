[{"type": "subtitle", "time": 8701.99, "timestamp": "02:25:01", "text": "つまり、ポーランド語のことです。ポーランド語もまたそれは"}, {"type": "subtitle", "time": 8704.309, "timestamp": "02:25:04", "text": "それは違う。私はあまりよく知りません"}, {"type": "subtitle", "time": 8706.309, "timestamp": "02:25:06", "text": "研磨。実際、私は知りません"}, {"type": "subtitle", "time": 8709.03, "timestamp": "02:25:09", "text": "研磨。"}, {"type": "subtitle", "time": 8712.07, "timestamp": "02:25:12", "text": "あなたはどんな言語を知っていますか？ジョック。"}, {"type": "subtitle", "time": 8714.23, "timestamp": "02:25:14", "text": "えっと。"}, {"type": "subtitle", "time": 8717.59, "timestamp": "02:25:17", "text": "ああ。ライタとは何ですか？ああ、それは"}, {"type": "subtitle", "time": 8722.87, "timestamp": "02:25:22", "text": "バターファは、ええと、それはcとどちらかを混ぜたものです"}, {"type": "subtitle", "time": 8725.27, "timestamp": "02:25:25", "text": "ライタには2種類あります。だから、"}, {"type": "subtitle", "time": 8728.07, "timestamp": "02:25:28", "text": "ブンディと混ぜる"}, {"type": "subtitle", "time": 8731.11, "timestamp": "02:25:31", "text": "それは、えっと、それは、ちょっとちょっと"}, {"type": "subtitle", "time": 8734.63, "timestamp": "02:25:34", "text": "ビーズで、ちょっと塩辛い感じ。"}, {"type": "subtitle", "time": 8736.55, "timestamp": "02:25:36", "text": "彼らは優秀だ。または、"}, {"type": "subtitle", "time": 8738.389, "timestamp": "02:25:38", "text": "キュウリ"}, {"type": "subtitle", "time": 8742.309, "timestamp": "02:25:42", "text": "玉ねぎと少量の塩。"}, {"type": "subtitle", "time": 8744.309, "timestamp": "02:25:44", "text": "そして、一般的には同じようなもの同士で同じようなものになります"}, {"type": "subtitle", "time": 8746.07, "timestamp": "02:25:46", "text": "ビリヤニ。"}, {"type": "subtitle", "time": 8747.11, "timestamp": "02:25:47", "text": "おお。"}, {"type": "subtitle", "time": 8748.71, "timestamp": "02:25:48", "text": "ええ、ビリヤニは食べられません"}, {"type": "subtitle", "time": 8751.429, "timestamp": "02:25:51", "text": "作家なし。それはあなたの頼みの綱のようなものですね。"}, {"type": "subtitle", "time": 8754.98, "timestamp": "02:25:54", "text": "ビリヤニにはライタが必要です。"}]
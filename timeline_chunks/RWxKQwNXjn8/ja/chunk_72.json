[{"type": "subtitle", "time": 4323.27, "timestamp": "01:12:03", "text": "あなたはこれが私たちの内にあるものだと知っています。みんな"}, {"type": "subtitle", "time": 4327.91, "timestamp": "01:12:07", "text": "ヤヒこそが大金が動く場所だと知っている。"}, {"type": "subtitle", "time": 4331.99, "timestamp": "01:12:11", "text": "そうです。うん。うん。わかった。 Ch.メーカーまたは"}, {"type": "subtitle", "time": 4335.99, "timestamp": "01:12:15", "text": "アニメの休憩時間は、フオシスがいくつあるかです"}, {"type": "subtitle", "time": 4338.55, "timestamp": "01:12:18", "text": "それは引きつけることができる。"}, {"type": "subtitle", "time": 4342.39, "timestamp": "01:12:22", "text": "ああ、腐女子って何だか知ってるよね？"}, {"type": "subtitle", "time": 4344.149, "timestamp": "01:12:24", "text": "男性版ですか、それとも男性ですか、それとも"}, {"type": "subtitle", "time": 4347.189, "timestamp": "01:12:27", "text": "女性版？腐女子は、ほら、"}, {"type": "subtitle", "time": 4349.189, "timestamp": "01:12:29", "text": "好きなカップルを応援する女の子"}, {"type": "subtitle", "time": 4352.07, "timestamp": "01:12:32", "text": "ヤーウィ。"}, {"type": "subtitle", "time": 4355.11, "timestamp": "01:12:35", "text": "もしファンダムが"}, {"type": "subtitle", "time": 4358.07, "timestamp": "01:12:38", "text": "腐女子なら誰でも知っているように、"}, {"type": "subtitle", "time": 4360.149, "timestamp": "01:12:40", "text": "それはまさに破滅だ"}, {"type": "subtitle", "time": 4365.75, "timestamp": "01:12:45", "text": "彼らは作ることができないだろう"}, {"type": "subtitle", "time": 4373.59, "timestamp": "01:12:53", "text": "でも、これを拡張できる気がする yahi"}, {"type": "subtitle", "time": 4377.11, "timestamp": "01:12:57", "text": "あなたを支持し、すべてを書いてください"}]
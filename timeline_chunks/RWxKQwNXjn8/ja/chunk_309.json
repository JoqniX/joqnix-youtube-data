[{"type": "subtitle", "time": 18543.84, "timestamp": "05:09:03", "text": "爆弾？こんにちは。はい。やりましょう。うん。さあ やってみて。やりましょう。"}, {"type": "subtitle", "time": 18556.55, "timestamp": "05:09:16", "text": "それで、えっと、爆弾をやってるの？うん、君"}, {"type": "subtitle", "time": 18559.59, "timestamp": "05:09:19", "text": "最高だ。わかった。ええ、私たちは"}, {"type": "subtitle", "time": 18564.07, "timestamp": "05:09:24", "text": "ボタン、キーパッド、メモリ、迷路があります。"}, {"type": "subtitle", "time": 18565.91, "timestamp": "05:09:25", "text": "あの、あのね？迷路に挑戦しよう"}, {"type": "subtitle", "time": 18569.51, "timestamp": "05:09:29", "text": "初め。迷路。わかった。わかった。わかった。全て"}, {"type": "subtitle", "time": 18572.628, "timestamp": "05:09:32", "text": "右。こんにちは。えっと、ページは準備できましたか？"}, {"type": "subtitle", "time": 18574.23, "timestamp": "05:09:34", "text": "うん。"}, {"type": "subtitle", "time": 18576.948, "timestamp": "05:09:36", "text": "まず最初の円"}, {"type": "subtitle", "time": 18583.83, "timestamp": "05:09:43", "text": "最初の列の5行目にあります。わかった。"}, {"type": "subtitle", "time": 18591.11, "timestamp": "05:09:51", "text": "私は最初の列にいます。 3列目。"}, {"type": "subtitle", "time": 18596.788, "timestamp": "05:09:56", "text": "三番目。わかった。えーっと、ちょっと待って"}]
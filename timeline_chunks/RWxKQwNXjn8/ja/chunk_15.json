[{"type": "subtitle", "time": 901.269, "timestamp": "00:15:01", "text": "富士は中立を選ぶだろう"}, {"type": "subtitle", "time": 905.35, "timestamp": "00:15:05", "text": "理由は分かりません。なぜ私が見るとき"}, {"type": "subtitle", "time": 908.15, "timestamp": "00:15:08", "text": "「中立」という言葉を聞くと、富士山を思い浮かべる。ああ、"}, {"type": "subtitle", "time": 911.11, "timestamp": "00:15:11", "text": "神。うん。富士富士はとても富士です"}, {"type": "subtitle", "time": 913.11, "timestamp": "00:15:13", "text": "極めて混沌とした中立的な性格。私は感じます"}, {"type": "subtitle", "time": 915.43, "timestamp": "00:15:15", "text": "混沌中立。"}, {"type": "subtitle", "time": 924.31, "timestamp": "00:15:24", "text": "あなたはそうではないと思う"}, {"type": "subtitle", "time": 934.949, "timestamp": "00:15:34", "text": "ジョー、じっくり考えてみて。持って行ってください"}, {"type": "subtitle", "time": 948.15, "timestamp": "00:15:48", "text": "えっと、私は秩序中立でいいかな。"}, {"type": "subtitle", "time": 950.069, "timestamp": "00:15:50", "text": "多分。"}, {"type": "subtitle", "time": 953.43, "timestamp": "00:15:53", "text": "うん。あ、待って。一つしか選べません。"}, {"type": "subtitle", "time": 955.509, "timestamp": "00:15:55", "text": "あ、待って。何？私は選べると思った"}, {"type": "subtitle", "time": 957.509, "timestamp": "00:15:57", "text": "中立善、秩序、中立、混沌"}, {"type": "subtitle", "time": 959.509, "timestamp": "00:15:59", "text": "良い。"}]
[{"type": "subtitle", "time": 12124.07, "timestamp": "03:22:04", "text": "与格"}, {"type": "subtitle", "time": 12126.15, "timestamp": "03:22:06", "text": "ガイドライン。"}, {"type": "subtitle", "time": 12130.79, "timestamp": "03:22:10", "text": "はい、調べてみます。表示されるはずです"}, {"type": "subtitle", "time": 12134.07, "timestamp": "03:22:14", "text": "上ですよね？いいえ、そうではありません。わかった、絶対にない"}, {"type": "subtitle", "time": 12136.07, "timestamp": "03:22:16", "text": "心。"}, {"type": "subtitle", "time": 12139.75, "timestamp": "03:22:19", "text": "ラジオのガイドライン"}, {"type": "subtitle", "time": 12142.55, "timestamp": "03:22:22", "text": "暗闇。"}, {"type": "subtitle", "time": 12145.51, "timestamp": "03:22:25", "text": "ああ、表示されないんですね。"}, {"type": "subtitle", "time": 12148.229, "timestamp": "03:22:28", "text": "暗闇は"}, {"type": "subtitle", "time": 12151.51, "timestamp": "03:22:31", "text": "一体どういうことだ？表示されません。"}, {"type": "subtitle", "time": 12154.469, "timestamp": "03:22:34", "text": "よし、ウェブサイトのSEO対策をしないといけないと思う。"}, {"type": "subtitle", "time": 12157.269, "timestamp": "03:22:37", "text": "兄弟。何てことだ。"}, {"type": "subtitle", "time": 12162.55, "timestamp": "03:22:42", "text": "ええと、たぶん分かったと思います。私の理解が正しければ。"}, {"type": "subtitle", "time": 12166.15, "timestamp": "03:22:46", "text": "私の推測が正しければ、私はそれを持っているはずだ。"}, {"type": "subtitle", "time": 12170.389, "timestamp": "03:22:50", "text": "わからない。えっと、トムの"}, {"type": "subtitle", "time": 12174.71, "timestamp": "03:22:54", "text": "ああ、持っていません。おお。"}, {"type": "subtitle", "time": 12177.67, "timestamp": "03:22:57", "text": "えっと"}]
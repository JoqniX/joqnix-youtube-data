[{"type": "subtitle", "time": 9967.03, "timestamp": "02:46:07", "text": "だから、これをどう伝えればいいのか分からない"}, {"type": "subtitle", "time": 9968.71, "timestamp": "02:46:08", "text": "ジョグ。ずっとそうしようと思っていたんです"}, {"type": "subtitle", "time": 9971.349, "timestamp": "02:46:11", "text": "最も長い時間。私は本当に怠け者なんです。私"}, {"type": "subtitle", "time": 9973.83, "timestamp": "02:46:13", "text": "5分くらい経つまで忘れてしまう"}, {"type": "subtitle", "time": 9975.83, "timestamp": "02:46:15", "text": "ストリームを始める前に、そして私は"}, {"type": "subtitle", "time": 9977.59, "timestamp": "02:46:17", "text": "つまり、本当にセットアップするつもりなのか"}, {"type": "subtitle", "time": 9979.75, "timestamp": "02:46:19", "text": "マルチストリームは初めて"}, {"type": "subtitle", "time": 9982.469, "timestamp": "02:46:22", "text": "5分後に配信開始予定なんだけど？だから私は"}, {"type": "subtitle", "time": 9986.23, "timestamp": "02:46:26", "text": "結局、それを実行しないまま終わってしまう。"}, {"type": "subtitle", "time": 9988.87, "timestamp": "02:46:28", "text": "大丈夫。"}, {"type": "subtitle", "time": 9990.469, "timestamp": "02:46:30", "text": "では、時計をアップロードしてください"}, {"type": "subtitle", "time": 10000.63, "timestamp": "02:46:40", "text": "何てことだ。"}, {"type": "subtitle", "time": 10002.87, "timestamp": "02:46:42", "text": "つまり、私が取り組んでいるのは"}, {"type": "subtitle", "time": 10006.15, "timestamp": "02:46:46", "text": "動画。私はビデオを制作中です。"}, {"type": "subtitle", "time": 10009.83, "timestamp": "02:46:49", "text": "つまり、私の編集者のキースは"}, {"type": "subtitle", "time": 10013.59, "timestamp": "02:46:53", "text": "動画制作中。編集者がいるんですか？"}, {"type": "subtitle", "time": 10016.95, "timestamp": "02:46:56", "text": "いや、いや、そうじゃないんだ。私は私は作った"}, {"type": "subtitle", "time": 10019.429, "timestamp": "02:46:59", "text": "友達に言ったんだ、ねえ君"}]
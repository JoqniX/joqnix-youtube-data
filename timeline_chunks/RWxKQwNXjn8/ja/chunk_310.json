[{"type": "subtitle", "time": 18600.788, "timestamp": "05:10:00", "text": "１、２、３、３ダウン。"}, {"type": "subtitle", "time": 18601.99, "timestamp": "05:10:01", "text": "あなたは私にどこにいるのか聞かないつもりですか"}, {"type": "subtitle", "time": 18605.03, "timestamp": "05:10:05", "text": "三角形は。"}, {"type": "subtitle", "time": 18608.07, "timestamp": "05:10:08", "text": "大丈夫、それが一番"}, {"type": "subtitle", "time": 18611.35, "timestamp": "05:10:11", "text": "おそらく、おそらく"}, {"type": "subtitle", "time": 18616.23, "timestamp": "05:10:16", "text": "2列目。えっと、最後です。私は推測する"}, {"type": "subtitle", "time": 18617.91, "timestamp": "05:10:17", "text": "そうに違いない。なぜそれを知っているのですか？なぜ"}, {"type": "subtitle", "time": 18621.03, "timestamp": "05:10:21", "text": "あなたはそれを知っていますか？なぜなら、私たちも"}, {"type": "subtitle", "time": 18625.35, "timestamp": "05:10:25", "text": "同じことがまた起こった。私たちはそうだったのでしょうか？今私たちは"}, {"type": "subtitle", "time": 18628.07, "timestamp": "05:10:28", "text": "した。私は信じている。"}, {"type": "subtitle", "time": 18630.15, "timestamp": "05:10:30", "text": "わかりました、では、"}, {"type": "subtitle", "time": 18632.628, "timestamp": "05:10:32", "text": "それ。まあ、いいでしょう。えーと、３つダウン、"}, {"type": "subtitle", "time": 18636.31, "timestamp": "05:10:36", "text": "右？こんにちは。 ３人ダウン。"}, {"type": "subtitle", "time": 18640.31, "timestamp": "05:10:40", "text": "わかった。 １、２、３、そして右"}, {"type": "subtitle", "time": 18645.59, "timestamp": "05:10:45", "text": "1つ。ああ、そうだね。右。よし、これでいい。終わり。"}, {"type": "subtitle", "time": 18648.15, "timestamp": "05:10:48", "text": "モジュールは完了しました。 SIMカードを手に入れました。私たちは"}, {"type": "subtitle", "time": 18651.03, "timestamp": "05:10:51", "text": "キーパッド、メモリ、ボタン。"}, {"type": "subtitle", "time": 18654.948, "timestamp": "05:10:54", "text": "こんにちは。記憶力を鍛えましょう。"}, {"type": "subtitle", "time": 18658.15, "timestamp": "05:10:58", "text": "わかった。準備はいいですか？メモリ。はい。準備はいいですか？"}]
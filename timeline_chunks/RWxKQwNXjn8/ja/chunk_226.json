[{"type": "subtitle", "time": 13562.469, "timestamp": "03:46:02", "text": "バージョン。わかった。私が黙りすぎると。わかった。"}, {"type": "subtitle", "time": 13570.07, "timestamp": "03:46:10", "text": "後でこれを自動化する必要があるかもしれない。"}, {"type": "subtitle", "time": 13573.51, "timestamp": "03:46:13", "text": "とりあえず今はモバイルモードでプレイします。私はただ"}, {"type": "subtitle", "time": 13596.63, "timestamp": "03:46:36", "text": "温水点検。ええと、通常の水質検査です。"}, {"type": "subtitle", "time": 13598.79, "timestamp": "03:46:38", "text": "ビスケットはそこにある。私はただ作らなければならない"}, {"type": "subtitle", "time": 13608.71, "timestamp": "03:46:48", "text": "ええと、近いうちに切り替えます。"}, {"type": "subtitle", "time": 13613.67, "timestamp": "03:46:53", "text": "わかった。 4時間後にまた会おう。バイバイ。"}]
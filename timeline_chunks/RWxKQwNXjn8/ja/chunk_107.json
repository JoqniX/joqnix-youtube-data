[{"type": "subtitle", "time": 6422.55, "timestamp": "01:47:02", "text": "レオ血清癌のような感じだと知っている"}, {"type": "subtitle", "time": 6424.95, "timestamp": "01:47:04", "text": "すべて。あ、待って、それって星座のことだった。"}, {"type": "subtitle", "time": 6427.189, "timestamp": "01:47:07", "text": "あ、いやいや、あれは星座だよ"}, {"type": "subtitle", "time": 6430.07, "timestamp": "01:47:10", "text": "同じように。ああ、彼らは大丈夫だよ。星座は"}, {"type": "subtitle", "time": 6433.189, "timestamp": "01:47:13", "text": "星座に基づいている。"}, {"type": "subtitle", "time": 6435.03, "timestamp": "01:47:15", "text": "あなたの星座は"}, {"type": "subtitle", "time": 6437.99, "timestamp": "01:47:17", "text": "星座は、"}, {"type": "subtitle", "time": 6440.629, "timestamp": "01:47:20", "text": "空は、"}, {"type": "subtitle", "time": 6442.88, "timestamp": "01:47:22", "text": "時間。それが一番重要な点です。"}, {"type": "subtitle", "time": 6444.47, "timestamp": "01:47:24", "text": "[音楽]"}, {"type": "subtitle", "time": 6447.03, "timestamp": "01:47:27", "text": "だから、そうやって自分の"}, {"type": "subtitle", "time": 6455.59, "timestamp": "01:47:35", "text": "覚えてるよ、私たちは「やったことある？」って感じだったよね。"}, {"type": "subtitle", "time": 6456.95, "timestamp": "01:47:36", "text": "今まで"}, {"type": "subtitle", "time": 6459.669, "timestamp": "01:47:39", "text": "子供の頃、プラネタリウムに行ったことがありますか？"}, {"type": "subtitle", "time": 6462.629, "timestamp": "01:47:42", "text": "惑星？学校の勉強をしていた時と同じような気分です"}, {"type": "subtitle", "time": 6469.189, "timestamp": "01:47:49", "text": "プラナトリアムがあったのを覚えています"}, {"type": "subtitle", "time": 6471.03, "timestamp": "01:47:51", "text": "私たちの学校も同様です。まるで彼らが建てたかのように"}, {"type": "subtitle", "time": 6474.31, "timestamp": "01:47:54", "text": "小さなテントのようなプランタトルム"}, {"type": "subtitle", "time": 6476.55, "timestamp": "01:47:56", "text": "あるイベントのために、彼らが私たちをそこへ連れて行ってくれた。それ"}, {"type": "subtitle", "time": 6479.75, "timestamp": "01:47:59", "text": "すごくかっこよかった。"}]
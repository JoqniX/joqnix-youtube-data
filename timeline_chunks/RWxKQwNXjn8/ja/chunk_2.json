[{"type": "subtitle", "time": 121.35, "timestamp": "00:02:01", "text": "あの、私のベッドを返してもらえますか？"}, {"type": "subtitle", "time": 128.55, "timestamp": "00:02:08", "text": "あなたが欲しい種子。"}, {"type": "subtitle", "time": 137.19, "timestamp": "00:02:17", "text": "5年間続けてきたハードコアの世界を失いかけた"}, {"type": "subtitle", "time": 139.51, "timestamp": "00:02:19", "text": "クソみたいなクリーパーのせいで。おお"}, {"type": "subtitle", "time": 143.35, "timestamp": "00:02:23", "text": "ああ、クリーパーは厄介だ。"}, {"type": "subtitle", "time": 148.63, "timestamp": "00:02:28", "text": "待って、5年。何？それはすごいですね。どうやって"}, {"type": "subtitle", "time": 150.79, "timestamp": "00:02:30", "text": "生き残りますか？"}, {"type": "subtitle", "time": 155.35, "timestamp": "00:02:35", "text": "特にハードコアでは？おお。"}, {"type": "subtitle", "time": 157.91, "timestamp": "00:02:37", "text": "さようなら。"}, {"type": "subtitle", "time": 160.63, "timestamp": "00:02:40", "text": "それはすごいね。"}, {"type": "subtitle", "time": 164.07, "timestamp": "00:02:44", "text": "本当に素晴らしいです。インドより愛を込めて。"}, {"type": "subtitle", "time": 166.47, "timestamp": "00:02:46", "text": "うん。こんにちは、プラサンドさん。"}, {"type": "subtitle", "time": 169.99, "timestamp": "00:02:49", "text": "調子はどうですか？"}, {"type": "subtitle", "time": 179.11, "timestamp": "00:02:59", "text": "私たちはMinecraft Reaperをプレイします。ああ、時間だ"}]
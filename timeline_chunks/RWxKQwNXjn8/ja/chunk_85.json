[{"type": "subtitle", "time": 5102.47, "timestamp": "01:25:02", "text": "燃えているし最悪だ、それでも"}, {"type": "subtitle", "time": 5105.75, "timestamp": "01:25:05", "text": "何度も繰り返し見直す。そして私は"}, {"type": "subtitle", "time": 5108.38, "timestamp": "01:25:08", "text": "リーグを説明する"}, {"type": "subtitle", "time": 5156.79, "timestamp": "01:25:56", "text": "ああ、なんだかすごく呪われた感じになっちゃった。おお、"}]
[{"type": "subtitle", "time": 10383.91, "timestamp": "02:53:03", "text": "そうすれば手が届く。いいえ、違います。"}, {"type": "subtitle", "time": 10387.269, "timestamp": "02:53:07", "text": "ジョック、君は眼鏡をかけているの？ええ、私は着ています"}, {"type": "subtitle", "time": 10389.429, "timestamp": "02:53:09", "text": "私の車の中にあるのと同じメガネです。の"}, {"type": "subtitle", "time": 10392.309, "timestamp": "02:53:12", "text": "丸めた1。私は丸いメガネが好きです。"}, {"type": "subtitle", "time": 10396.469, "timestamp": "02:53:16", "text": "とても可愛いですね。ええ、そうです"}, {"type": "subtitle", "time": 10398.71, "timestamp": "02:53:18", "text": "えっと、私は完全に丸い"}, {"type": "subtitle", "time": 10400.469, "timestamp": "02:53:20", "text": "メガネですが、ご存知のように、"}, {"type": "subtitle", "time": 10403.75, "timestamp": "02:53:23", "text": "丸いグラスの。うん。彼らは少し"}, {"type": "subtitle", "time": 10405.51, "timestamp": "02:53:25", "text": "ラウンド。"}, {"type": "subtitle", "time": 10407.91, "timestamp": "02:53:27", "text": "現在のモデルは黒い丸い"}, {"type": "subtitle", "time": 10412.309, "timestamp": "02:53:32", "text": "眼鏡。えっと、でも今は私は"}, {"type": "subtitle", "time": 10415.19, "timestamp": "02:53:35", "text": "金色の丸い眼鏡で"}, {"type": "subtitle", "time": 10417.99, "timestamp": "02:53:37", "text": "新型モデルにはそれが備わっている。"}, {"type": "subtitle", "time": 10420.309, "timestamp": "02:53:40", "text": "M"}, {"type": "subtitle", "time": 10422.23, "timestamp": "02:53:42", "text": "眼鏡。メガネってかっこいいよね。私が"}, {"type": "subtitle", "time": 10424.63, "timestamp": "02:53:44", "text": "私がまだ幼かった頃は、"}, {"type": "subtitle", "time": 10427.349, "timestamp": "02:53:47", "text": "小さな男の子、昔はこうだった"}, {"type": "subtitle", "time": 10430.23, "timestamp": "02:53:50", "text": "ああ、それはすごくクールだね"}, {"type": "subtitle", "time": 10432.15, "timestamp": "02:53:52", "text": "眼鏡。しかし、私の酸は"}, {"type": "subtitle", "time": 10434.07, "timestamp": "02:53:54", "text": "実際、私は「ああ、やばい。縁起が悪い」って感じ。"}]
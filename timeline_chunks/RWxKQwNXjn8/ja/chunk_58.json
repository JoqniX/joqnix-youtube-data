[{"type": "subtitle", "time": 3484.789, "timestamp": "00:58:04", "text": "また、介護者も"}, {"type": "subtitle", "time": 3486.309, "timestamp": "00:58:06", "text": "生まれたばかりの子供の世話、または"}, {"type": "subtitle", "time": 3488.789, "timestamp": "00:58:08", "text": "誤って母親に押しつぶされてしまうかもしれない。"}, {"type": "subtitle", "time": 3491.829, "timestamp": "00:58:11", "text": "パンダの母親もまた"}, {"type": "subtitle", "time": 3496.47, "timestamp": "00:58:16", "text": "もしそうなら、問題は仕事です。パンダ"}, {"type": "subtitle", "time": 3499.109, "timestamp": "00:58:19", "text": "双子を出産する可能性が高い。"}, {"type": "subtitle", "time": 3500.789, "timestamp": "00:58:20", "text": "わかった。"}, {"type": "subtitle", "time": 3502.71, "timestamp": "00:58:22", "text": "M 出産する可能性が高くなります"}, {"type": "subtitle", "time": 3505.829, "timestamp": "00:58:25", "text": "双子。しかし、何らかの理由で、"}, {"type": "subtitle", "time": 3507.589, "timestamp": "00:58:27", "text": "出産する可能性が高くなる"}, {"type": "subtitle", "time": 3510.39, "timestamp": "00:58:30", "text": "双子の世話をすることを拒否する"}, {"type": "subtitle", "time": 3517.03, "timestamp": "00:58:37", "text": "介護者がしなければならないことは"}, {"type": "subtitle", "time": 3519.67, "timestamp": "00:58:39", "text": "双子をすぐに分離しなければならない"}, {"type": "subtitle", "time": 3522.23, "timestamp": "00:58:42", "text": "生まれたらすぐに切り替えなければならない"}, {"type": "subtitle", "time": 3524.309, "timestamp": "00:58:44", "text": "双子は時々外出する。だから、"}, {"type": "subtitle", "time": 3526.15, "timestamp": "00:58:46", "text": "母は港の世話をしない"}, {"type": "subtitle", "time": 3529.109, "timestamp": "00:58:49", "text": "それを認識する。"}, {"type": "subtitle", "time": 3532.39, "timestamp": "00:58:52", "text": "ああ、そうだね。パンダに関するすべては"}, {"type": "subtitle", "time": 3534.309, "timestamp": "00:58:54", "text": "彼らはただ単にあまり良くないだけです"}, {"type": "subtitle", "time": 3537.9, "timestamp": "00:58:57", "text": "生き残ること。"}, {"type": "subtitle", "time": 3539.589, "timestamp": "00:58:59", "text": "[音楽]"}]
[{"type": "subtitle", "time": 13621.189, "timestamp": "03:47:01", "text": "全て自動化しなければならない。おお"}, {"type": "subtitle", "time": 13622.63, "timestamp": "03:47:02", "text": "我が神よ。全体を自動化する必要がある"}, {"type": "subtitle", "time": 13632.71, "timestamp": "03:47:12", "text": "わかった。私の軍隊は今や私の携帯電話から。こんにちは。"}, {"type": "subtitle", "time": 13636.95, "timestamp": "03:47:16", "text": "えっと、これでうまくいくはずですよね？"}, {"type": "subtitle", "time": 13639.51, "timestamp": "03:47:19", "text": "こんにちは。私と来て。"}, {"type": "subtitle", "time": 13642.71, "timestamp": "03:47:22", "text": "私はそうしないように"}, {"type": "subtitle", "time": 13651.349, "timestamp": "03:47:31", "text": "犬の鳴き声が聞こえるかもしれません。しないでください"}, {"type": "subtitle", "time": 13668.389, "timestamp": "03:47:48", "text": "わかった。"}, {"type": "subtitle", "time": 13670.229, "timestamp": "03:47:50", "text": "ああ"}, {"type": "subtitle", "time": 13679.75, "timestamp": "03:47:59", "text": "ある意味、行くのはいいことだ"}]
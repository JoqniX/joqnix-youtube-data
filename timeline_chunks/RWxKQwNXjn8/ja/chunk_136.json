[{"type": "subtitle", "time": 8161.109, "timestamp": "02:16:01", "text": "生き残るんだ、ジョー。私たちは飢饉に陥っているわけではない"}, {"type": "subtitle", "time": 8164.629, "timestamp": "02:16:04", "text": "ジョー、私たちが楽しみながら食事ができる場所だよ。"}, {"type": "subtitle", "time": 8167.669, "timestamp": "02:16:07", "text": "そうそう。それは忘れていたことだ。うん。"}, {"type": "subtitle", "time": 8171.589, "timestamp": "02:16:11", "text": "ほら、ほら、君は僕を料理してくれないんだよ。"}, {"type": "subtitle", "time": 8173.43, "timestamp": "02:16:13", "text": "私たちはそうじゃない。あなたは私を料理していない。 Q."}, {"type": "subtitle", "time": 8176.47, "timestamp": "02:16:16", "text": "あなたは私を料理しているわけではない。いいえ。あなたを支持し。"}, {"type": "subtitle", "time": 8179.43, "timestamp": "02:16:19", "text": "悪い。悪い。"}, {"type": "subtitle", "time": 8181.91, "timestamp": "02:16:21", "text": "何てことだ。"}, {"type": "subtitle", "time": 8184.55, "timestamp": "02:16:24", "text": "わかった。ジョーク。私の主な"}, {"type": "subtitle", "time": 8187.51, "timestamp": "02:16:27", "text": "今日の配信から得られる教訓は、"}, {"type": "subtitle", "time": 8189.669, "timestamp": "02:16:29", "text": "趣味がかなり疑わしい"}, {"type": "subtitle", "time": 8192.629, "timestamp": "02:16:32", "text": "私が知っていたよりも多くの食べ物。"}, {"type": "subtitle", "time": 8195.429, "timestamp": "02:16:35", "text": "わからない。私はあまり食事をしていません"}, {"type": "subtitle", "time": 8198.709, "timestamp": "02:16:38", "text": "インド各地から。私は思う"}, {"type": "subtitle", "time": 8201.589, "timestamp": "02:16:41", "text": "インド料理についてはほとんど何も知らず、"}, {"type": "subtitle", "time": 8204.629, "timestamp": "02:16:44", "text": "もの。プナに行ったときのように、"}, {"type": "subtitle", "time": 8206.95, "timestamp": "02:16:46", "text": "創造主の母"}, {"type": "subtitle", "time": 8210.23, "timestamp": "02:16:50", "text": "食器とかそういうものを作る"}, {"type": "subtitle", "time": 8212.549, "timestamp": "02:16:52", "text": "ピザの材料で、これはすごいと思った"}, {"type": "subtitle", "time": 8216.389, "timestamp": "02:16:56", "text": "こんなことは今までなかった"}, {"type": "subtitle", "time": 8219.19, "timestamp": "02:16:59", "text": "でも大丈夫だよ、正直言って"}]
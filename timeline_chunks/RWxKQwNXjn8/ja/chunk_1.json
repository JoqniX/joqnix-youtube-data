[{"type": "subtitle", "time": 62.389, "timestamp": "00:01:02", "text": "あ、待って。寝る。待って。私は手に入れる必要がある"}, {"type": "subtitle", "time": 73.429, "timestamp": "00:01:13", "text": "うん。配信外で言ってください。"}, {"type": "subtitle", "time": 79.67, "timestamp": "00:01:19", "text": "わかった。"}, {"type": "subtitle", "time": 81.51, "timestamp": "00:01:21", "text": "何か見たいですか？だろう"}, {"type": "subtitle", "time": 84.39, "timestamp": "00:01:24", "text": "楽しい。あ、待って。"}, {"type": "subtitle", "time": 91.51, "timestamp": "00:01:31", "text": "我慢する。忘れた。私たちは"}, {"type": "subtitle", "time": 95.749, "timestamp": "00:01:35", "text": "今週は一緒に視聴しましょう。いいえ、最後"}, {"type": "subtitle", "time": 101.10900000000001, "timestamp": "00:01:41", "text": "週。そして、私はそのことをすっかり忘れていました。いいえ、"}, {"type": "subtitle", "time": 103.03, "timestamp": "00:01:43", "text": "あなたは、"}, {"type": "subtitle", "time": 107.83, "timestamp": "00:01:47", "text": "私と一緒にシリーズを。ああ、もう。私 私"}, {"type": "subtitle", "time": 110.71000000000001, "timestamp": "00:01:50", "text": "時間が取れなかった。"}]
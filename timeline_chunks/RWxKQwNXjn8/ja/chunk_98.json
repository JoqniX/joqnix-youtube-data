[{"type": "subtitle", "time": 5881.75, "timestamp": "01:38:01", "text": "そしてジョー、あなたは私が今まで出会った中で一番素敵な人です"}, {"type": "subtitle", "time": 5883.75, "timestamp": "01:38:03", "text": "知る。あなたは、あなたは、あなたは、だからあなたは"}, {"type": "subtitle", "time": 5885.99, "timestamp": "01:38:05", "text": "あなたは本当に優しい人ですね。"}, {"type": "subtitle", "time": 5893.189, "timestamp": "01:38:13", "text": "うん。"}, {"type": "subtitle", "time": 5894.709, "timestamp": "01:38:14", "text": "こんにちは。"}, {"type": "subtitle", "time": 5897.75, "timestamp": "01:38:17", "text": "はい。それこそが、私たちが知っていて愛しているあのスポーツマンだ。"}, {"type": "subtitle", "time": 5901.109, "timestamp": "01:38:21", "text": "ジョックは強い少年だ。彼はとても強い"}, {"type": "subtitle", "time": 5903.91, "timestamp": "01:38:23", "text": "そして、勤勉な少年。"}, {"type": "subtitle", "time": 5906.07, "timestamp": "01:38:26", "text": "ああ、ありがとうございます。"}, {"type": "subtitle", "time": 5913.59, "timestamp": "01:38:33", "text": "それはそれは素晴らしい"}, {"type": "subtitle", "time": 5921.27, "timestamp": "01:38:41", "text": "それは良いことです。よくやった、君。それは"}, {"type": "subtitle", "time": 5924.07, "timestamp": "01:38:44", "text": "初めて車輪を描きましたか？はい。"}, {"type": "subtitle", "time": 5933.27, "timestamp": "01:38:53", "text": "何てことだ。そして今、私は猫を描かなければならない。"}, {"type": "subtitle", "time": 5935.51, "timestamp": "01:38:55", "text": "右？いいえ。"}, {"type": "subtitle", "time": 5938.07, "timestamp": "01:38:58", "text": "あの生き物は何だ？"}]
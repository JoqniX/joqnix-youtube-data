[{"type": "subtitle", "time": 422.79, "timestamp": "00:07:02", "text": "それを回してみましょう。"}, {"type": "subtitle", "time": 427.189, "timestamp": "00:07:07", "text": "わーい。わーい。"}, {"type": "subtitle", "time": 431.35, "timestamp": "00:07:11", "text": "みなさん、お元気ですか？こんにちは。"}, {"type": "subtitle", "time": 433.189, "timestamp": "00:07:13", "text": "私は猫だけが好きです。私の"}, {"type": "subtitle", "time": 436.15, "timestamp": "00:07:16", "text": "ペンタブレット？ここにあります。大丈夫です。"}, {"type": "subtitle", "time": 438.309, "timestamp": "00:07:18", "text": "それは隅っこで埃をかぶっていた。"}, {"type": "subtitle", "time": 440.87, "timestamp": "00:07:20", "text": "同じ。"}, {"type": "subtitle", "time": 443.43, "timestamp": "00:07:23", "text": "ああ、もう。それは厚い層があり"}, {"type": "subtitle", "time": 445.67, "timestamp": "00:07:25", "text": "その上に埃が積もっている。"}, {"type": "subtitle", "time": 447.589, "timestamp": "00:07:27", "text": "何てことだ。大丈夫です。あなたが知っている、"}, {"type": "subtitle", "time": 450.71, "timestamp": "00:07:30", "text": "時にはウインクするだけでいいんです。"}, {"type": "subtitle", "time": 459.51, "timestamp": "00:07:39", "text": "よし。それは、それは、もし"}, {"type": "subtitle", "time": 461.51, "timestamp": "00:07:41", "text": "私のペンタブレットは動作しますが、私は実際には"}, {"type": "subtitle", "time": 475.27, "timestamp": "00:07:55", "text": "ああ、USB Type-Cじゃないんですね。ああ、神様。わかった。"}, {"type": "subtitle", "time": 478.07, "timestamp": "00:07:58", "text": "別のケーブルです。わかった。"}]
[{"type": "subtitle", "time": 10800.23, "timestamp": "03:00:00", "text": "「神様、ご飯を炊いてください。」そして私はそれを食べた。"}, {"type": "subtitle", "time": 10802.63, "timestamp": "03:00:02", "text": "それから私は眠りについた。私は"}, {"type": "subtitle", "time": 10804.79, "timestamp": "03:00:04", "text": "ストリームに戻るか、または"}, {"type": "subtitle", "time": 10807.51, "timestamp": "03:00:07", "text": "少なくともモバイルモードにしてください。"}, {"type": "subtitle", "time": 10810.389, "timestamp": "03:00:10", "text": "電話をストリーミング配信して、音声をオーバーする"}, {"type": "subtitle", "time": 10813.75, "timestamp": "03:00:13", "text": "戦争が繰り広げられている間。えっと、でも私は寝ました"}, {"type": "subtitle", "time": 10818.15, "timestamp": "03:00:18", "text": "オフ。そして朝目が覚めて、それから年齢"}, {"type": "subtitle", "time": 10820.71, "timestamp": "03:00:20", "text": "再びレース。そして午後の8レース"}, {"type": "subtitle", "time": 10828.79, "timestamp": "03:00:28", "text": "犬。泣かせてくれよ。私は"}, {"type": "subtitle", "time": 10830.79, "timestamp": "03:00:30", "text": "泣きそう。"}, {"type": "subtitle", "time": 10834.07, "timestamp": "03:00:34", "text": "知っている。侵入する必要があるんじゃないの？"}, {"type": "subtitle", "time": 10838.55, "timestamp": "03:00:38", "text": "お前の家に連れ込んで、そのままお前を誘拐するんだ。"}, {"type": "subtitle", "time": 10841.51, "timestamp": "03:00:41", "text": "まるで君を誘拐するみたいに言うんだ。"}, {"type": "subtitle", "time": 10845.51, "timestamp": "03:00:45", "text": "それでおしまい。兄貴は見た目通りアジア人だ。彼は"}, {"type": "subtitle", "time": 10848.469, "timestamp": "03:00:48", "text": "彼は最もアジア的なアジア人のような存在だ。"}, {"type": "subtitle", "time": 10850.79, "timestamp": "03:00:50", "text": "私は米ではありません。私はただ、お米が大好きなんです。"}, {"type": "subtitle", "time": 10853.83, "timestamp": "03:00:53", "text": "わかった。私はご飯が大好きですが、あなたは食べられません"}, {"type": "subtitle", "time": 10856.07, "timestamp": "03:00:56", "text": "毎食ごとに。持つことができます"}, {"type": "subtitle", "time": 10859.01, "timestamp": "03:00:59", "text": "異なるもの。"}]
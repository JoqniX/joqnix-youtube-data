[{"type": "subtitle", "time": 15321.11, "timestamp": "04:15:21", "text": "私は犯人を見た。もう1つあります"}, {"type": "subtitle", "time": 15324.229, "timestamp": "04:15:24", "text": "こっちにももう一人、生意気なガキがいるよ。"}, {"type": "subtitle", "time": 15333.59, "timestamp": "04:15:33", "text": "えっと、せっかく来たので、洗っちゃいますね"}, {"type": "subtitle", "time": 15335.349, "timestamp": "04:15:35", "text": "それ。"}]
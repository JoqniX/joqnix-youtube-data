[{"type": "subtitle", "time": 18361.67, "timestamp": "05:06:01", "text": "つまり、ああ、なんてことだ。おい。"}, {"type": "subtitle", "time": 18364.23, "timestamp": "05:06:04", "text": "ほんの冗談です。つまり、ほら、"}, {"type": "subtitle", "time": 18366.708, "timestamp": "05:06:06", "text": "本当に何も価値のあるものは失われなかった"}, {"type": "subtitle", "time": 18368.628, "timestamp": "05:06:08", "text": "だって、リセットボタンを押せばいいんだから。"}, {"type": "subtitle", "time": 18370.948, "timestamp": "05:06:10", "text": "リトライ。"}, {"type": "subtitle", "time": 18375.67, "timestamp": "05:06:15", "text": "はい。よし。もう一度試してみますか？"}, {"type": "subtitle", "time": 18379.03, "timestamp": "05:06:19", "text": "もう一度、手を出そう。はい。やりましょう。"}, {"type": "subtitle", "time": 18381.43, "timestamp": "05:06:21", "text": "もう一度両手を振ります。"}, {"type": "subtitle", "time": 18383.75, "timestamp": "05:06:23", "text": "爆弾を再び始動する。"}, {"type": "subtitle", "time": 18385.35, "timestamp": "05:06:25", "text": "ああ、くそ。誰かがドアをノックしている。"}, {"type": "subtitle", "time": 18402.948, "timestamp": "05:06:42", "text": "チャットの調子はどうですか？"}, {"type": "subtitle", "time": 18406.948, "timestamp": "05:06:46", "text": "私の側からも、スティーンの側からも？どうやって"}, {"type": "subtitle", "time": 18415.35, "timestamp": "05:06:55", "text": "二人は元気ですか？"}, {"type": "subtitle", "time": 18417.83, "timestamp": "05:06:57", "text": "あ、待って。私のデバイスはアップデートされませんでした。おお、"}]
[{"type": "subtitle", "time": 4200.709, "timestamp": "01:10:00", "text": "彼の人生最愛の人。アレクサー、彼は"}, {"type": "subtitle", "time": 4203.91, "timestamp": "01:10:03", "text": "自分の耳を疑った。アレックスは決して"}, {"type": "subtitle", "time": 4206.63, "timestamp": "01:10:06", "text": "私にそう言ってください。彼はどうしてこんなことができるのか"}, {"type": "chat", "time": 4208.329, "timestamp": "01:10:08", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "hi"}, {"type": "subtitle", "time": 4209.35, "timestamp": "01:10:09", "text": "自分？ドアのところに立っている"}, {"type": "subtitle", "time": 4212.47, "timestamp": "01:10:12", "text": "言葉もなく、パートナーが種を蒔くのを見守る"}, {"type": "subtitle", "time": 4217.59, "timestamp": "01:10:17", "text": "怒りを込めて。ロリ、こうするしかないのよ。"}, {"type": "subtitle", "time": 4221.03, "timestamp": "01:10:21", "text": "ごめんなさい。アイリスは両手を伸ばした"}, {"type": "subtitle", "time": 4223.83, "timestamp": "01:10:23", "text": "ハラッサの顔に向かって"}, {"type": "subtitle", "time": 4227.27, "timestamp": "01:10:27", "text": "叩き飛ばした。大きな静寂が訪れた"}, {"type": "subtitle", "time": 4229.51, "timestamp": "01:10:29", "text": "デュカシルの香りで満たされ、"}, {"type": "subtitle", "time": 4232.79, "timestamp": "01:10:32", "text": "呼吸。ハラスの涙が溜まる"}, {"type": "subtitle", "time": 4237.27, "timestamp": "01:10:37", "text": "目。彼は負傷した。彼は怒っていた。その上"}, {"type": "subtitle", "time": 4241.03, "timestamp": "01:10:41", "text": "彼は完全に打ちのめされた気分だった。彼はアクサを見つめた"}, {"type": "subtitle", "time": 4243.83, "timestamp": "01:10:43", "text": "まるで永遠のように感じられた。彼は"}, {"type": "subtitle", "time": 4246.709, "timestamp": "01:10:46", "text": "彼がそうではないと言うのを聞いてみよう。彼は彼に"}, {"type": "subtitle", "time": 4250.149, "timestamp": "01:10:50", "text": "それは偽物だったと言う。それは全て嘘だった。"}, {"type": "subtitle", "time": 4254.63, "timestamp": "01:10:54", "text": "しかし、それは現実ではなかった。ライプー"}, {"type": "subtitle", "time": 4258.39, "timestamp": "01:10:58", "text": "信じられなかったが、彼の赤ちゃん魚が"}]
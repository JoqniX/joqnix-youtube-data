[{"type": "subtitle", "time": 5523.03, "timestamp": "01:32:03", "text": "昔はただ見てただけだった"}, {"type": "subtitle", "time": 5525.99, "timestamp": "01:32:05", "text": "YouTube は、えーと、マップとか、"}, {"type": "subtitle", "time": 5528.07, "timestamp": "01:32:08", "text": "YouTube にあります"}, {"type": "subtitle", "time": 5531.99, "timestamp": "01:32:11", "text": "地図？いいえ。わかりました。地図はまあまあですね"}, {"type": "subtitle", "time": 5534.55, "timestamp": "01:32:14", "text": "今日一般的に目にする地図"}, {"type": "subtitle", "time": 5537.03, "timestamp": "01:32:17", "text": "非常に悪いことを指します。しかし、"}, {"type": "subtitle", "time": 5539.91, "timestamp": "01:32:19", "text": "かつて地図とは"}, {"type": "subtitle", "time": 5543.59, "timestamp": "01:32:23", "text": "複数アニメーターによるプロジェクト。そして、えーと、"}, {"type": "subtitle", "time": 5546.229, "timestamp": "01:32:26", "text": "アニメーターたちが集まって"}, {"type": "subtitle", "time": 5549.35, "timestamp": "01:32:29", "text": "そして彼らは、"}, {"type": "subtitle", "time": 5551.11, "timestamp": "01:32:31", "text": "それぞれがアニメーション化する"}, {"type": "subtitle", "time": 5553.91, "timestamp": "01:32:33", "text": "シーンを作り、彼らは一種の"}, {"type": "subtitle", "time": 5557.59, "timestamp": "01:32:37", "text": "一緒に短いビデオを作るような感じ。"}, {"type": "subtitle", "time": 5560.79, "timestamp": "01:32:40", "text": "すごくかっこよかった。私はいつも"}, {"type": "subtitle", "time": 5573.669, "timestamp": "01:32:53", "text": "いい感じだね、ジョー。私は試してみました"}, {"type": "subtitle", "time": 5577.59, "timestamp": "01:32:57", "text": "最高。それは良いことです。それは良い法案だ。で"}, {"type": "subtitle", "time": 5579.91, "timestamp": "01:32:59", "text": "これは私が芸術を参照しているようなもので、"}]
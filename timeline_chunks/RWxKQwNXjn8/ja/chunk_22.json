[{"type": "subtitle", "time": 1322.87, "timestamp": "00:22:02", "text": "我が神よ。うん。妻は理解できない"}, {"type": "subtitle", "time": 1326.23, "timestamp": "00:22:06", "text": "それ。けっこうだ、"}, {"type": "subtitle", "time": 1328.789, "timestamp": "00:22:08", "text": "兄弟。私は白人ですらない。私はできません"}, {"type": "subtitle", "time": 1331.83, "timestamp": "00:22:11", "text": "米の量を把握する。ベーグル"}, {"type": "subtitle", "time": 1336.549, "timestamp": "00:22:16", "text": "サンドイッチ。ベーグルって何？つまり、ベーグルは"}, {"type": "subtitle", "time": 1339.35, "timestamp": "00:22:19", "text": "えっと、あなたのパンみたいなものです。"}, {"type": "subtitle", "time": 1342.149, "timestamp": "00:22:22", "text": "スライスパンのように、しかし"}, {"type": "subtitle", "time": 1346.23, "timestamp": "00:22:26", "text": "まるで、もっとしっかりしていて、"}, {"type": "subtitle", "time": 1348.549, "timestamp": "00:22:28", "text": "彼らは一般的にゴマなどを加えるだろう"}, {"type": "subtitle", "time": 1352.23, "timestamp": "00:22:32", "text": "そして、それに関連するその他諸々。良い。"}, {"type": "subtitle", "time": 1355.669, "timestamp": "00:22:35", "text": "ああ。うん。"}, {"type": "subtitle", "time": 1359.59, "timestamp": "00:22:39", "text": "M：クランペットを食べたことがないんです。ジャムを少し入れてください。"}, {"type": "subtitle", "time": 1361.83, "timestamp": "00:22:41", "text": "見た目は良いですね。クランペットは確かに"}, {"type": "subtitle", "time": 1363.51, "timestamp": "00:22:43", "text": "良い。試してみたい理由は"}, {"type": "subtitle", "time": 1365.75, "timestamp": "00:22:45", "text": "イチゴ。私は「わかった、行くよ」って感じ"}, {"type": "subtitle", "time": 1367.83, "timestamp": "00:22:47", "text": "ワッフルにしよう。"}, {"type": "subtitle", "time": 1369.83, "timestamp": "00:22:49", "text": "そうそう。"}, {"type": "subtitle", "time": 1374.63, "timestamp": "00:22:54", "text": "えっと、このカップケーキはエビみたい。エカイルではない"}, {"type": "subtitle", "time": 1377.51, "timestamp": "00:22:57", "text": "トフィー。それは何ですか？"}]
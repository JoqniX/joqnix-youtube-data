[{"type": "subtitle", "time": 5222.55, "timestamp": "01:27:02", "text": "そして、小さなテキストを追加する必要があります"}, {"type": "subtitle", "time": 5234.55, "timestamp": "01:27:14", "text": "グロー"}, {"type": "subtitle", "time": 5243.51, "timestamp": "01:27:23", "text": "よし、これでいい。それは、魚になったあなた自身です。"}, {"type": "subtitle", "time": 5268.629, "timestamp": "01:27:48", "text": "目に関しては、次のようにしたいのです。"}, {"type": "subtitle", "time": 5270.87, "timestamp": "01:27:50", "text": "一般的に、あなたが"}, {"type": "subtitle", "time": 5275.91, "timestamp": "01:27:55", "text": "正直に言うと、あなたはそうする必要はありません"}, {"type": "subtitle", "time": 5277.91, "timestamp": "01:27:57", "text": "色を塗ってください。"}, {"type": "subtitle", "time": 5279.99, "timestamp": "01:27:59", "text": "黒い点のように、そして追加するだけです"}]
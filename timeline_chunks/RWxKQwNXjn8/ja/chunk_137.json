[{"type": "subtitle", "time": 8220.95, "timestamp": "02:17:00", "text": "インド全土の料理を食べたことがない"}, {"type": "subtitle", "time": 8223.75, "timestamp": "02:17:03", "text": "正直に言うと、それは"}, {"type": "subtitle", "time": 8226.95, "timestamp": "02:17:06", "text": "めちゃくちゃ大変な仕事だ。インド料理はとても"}, {"type": "subtitle", "time": 8233.27, "timestamp": "02:17:13", "text": "でも、やってみなくちゃいけないんだよ"}, {"type": "subtitle", "time": 8235.91, "timestamp": "02:17:15", "text": "米だけではない。そこには、そこには"}, {"type": "subtitle", "time": 8240.549, "timestamp": "02:17:20", "text": "世界には米以外にも多くのものがある。"}, {"type": "subtitle", "time": 8244.309, "timestamp": "02:17:24", "text": "はい。試してみたことはありますか？"}, {"type": "subtitle", "time": 8246.549, "timestamp": "02:17:26", "text": "少なくとも一度は？"}, {"type": "subtitle", "time": 8248.709, "timestamp": "02:17:28", "text": "映画「レイブン」を観たことありますか？"}, {"type": "subtitle", "time": 8250.95, "timestamp": "02:17:30", "text": "あるいは、シャー・フカーンのような"}, {"type": "subtitle", "time": 8253.349, "timestamp": "02:17:33", "text": "ロボットか何か？"}, {"type": "subtitle", "time": 8256.95, "timestamp": "02:17:36", "text": "えっと、私はボリウッド映画はあまり見ないんです。"}, {"type": "subtitle", "time": 8259.91, "timestamp": "02:17:39", "text": "私も見ていませんが、長いですね"}, {"type": "subtitle", "time": 8262.87, "timestamp": "02:17:42", "text": "子供の頃によく見ていた。あなた"}, {"type": "subtitle", "time": 8266.79, "timestamp": "02:17:46", "text": "「チャマケロ」とかいう曲知ってる？"}, {"type": "subtitle", "time": 8272.309, "timestamp": "02:17:52", "text": "そう、それだ。それで、ここにいる男は"}]
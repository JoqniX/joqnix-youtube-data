[{"type": "subtitle", "time": 6361.51, "timestamp": "01:46:01", "text": "うーん、大したことないですね。実はあまりよく知らないんです"}, {"type": "subtitle", "time": 6363.75, "timestamp": "01:46:03", "text": "占星術について。"}, {"type": "subtitle", "time": 6367.03, "timestamp": "01:46:07", "text": "ああ、順番に学ぶ必要がある気がする"}, {"type": "subtitle", "time": 6375.189, "timestamp": "01:46:15", "text": "ええ、学ぶべきことがたくさんありますね。"}, {"type": "subtitle", "time": 6377.91, "timestamp": "01:46:17", "text": "大丈夫です。"}, {"type": "subtitle", "time": 6381.83, "timestamp": "01:46:21", "text": "星ってすごくかっこいいと思う。"}, {"type": "subtitle", "time": 6385.03, "timestamp": "01:46:25", "text": "今やスターは至る所にいる。"}, {"type": "subtitle", "time": 6387.35, "timestamp": "01:46:27", "text": "父は私に少し教えてくれた"}, {"type": "subtitle", "time": 6390.149, "timestamp": "01:46:30", "text": "まるで私たちが一緒に遊んでいるみたいに"}, {"type": "subtitle", "time": 6392.709, "timestamp": "01:46:32", "text": "星々が何であったか、"}, {"type": "subtitle", "time": 6394.55, "timestamp": "01:46:34", "text": "どの星座が何だったか、といった具合に。"}, {"type": "subtitle", "time": 6396.39, "timestamp": "01:46:36", "text": "覚えていますよ。それはとても楽しかった"}, {"type": "subtitle", "time": 6398.709, "timestamp": "01:46:38", "text": "子供。"}, {"type": "subtitle", "time": 6402.229, "timestamp": "01:46:42", "text": "Mはただ星を見ているだけです。"}, {"type": "subtitle", "time": 6404.31, "timestamp": "01:46:44", "text": "どの星座かを特定するような"}, {"type": "subtitle", "time": 6409.669, "timestamp": "01:46:49", "text": "どの星座を知っていますか？"}, {"type": "subtitle", "time": 6416.79, "timestamp": "01:46:56", "text": "いや、実際は"}, {"type": "subtitle", "time": 6419.109, "timestamp": "01:46:59", "text": "いや、星座だよ、ほとんどは"}]
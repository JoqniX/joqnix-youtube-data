[{"type": "subtitle", "time": 322.02, "timestamp": "00:05:22", "text": "Mは危うく死にかけた。私は辞めた。"}, {"type": "subtitle", "time": 328.39, "timestamp": "00:05:28", "text": "発音しないでください。ああ、心配しないで。私"}, {"type": "subtitle", "time": 333.59000000000003, "timestamp": "00:05:33", "text": "知る。ええと、それは州の名前です。例えば"}, {"type": "subtitle", "time": 336.23, "timestamp": "00:05:36", "text": "子供だけどね。私は子供ではありません。私は"}, {"type": "subtitle", "time": 343.43, "timestamp": "00:05:43", "text": "うん。気遣ってくれてありがとう"}, {"type": "subtitle", "time": 351.749, "timestamp": "00:05:51", "text": "そして、私は助けが欲しいのです。ああ神様、罰金が必要だ"}, {"type": "subtitle", "time": 355.59000000000003, "timestamp": "00:05:55", "text": "食べ物。近くにモンスターはいません。なし"}, {"type": "subtitle", "time": 359.189, "timestamp": "00:05:59", "text": "そこには。うん。"}]
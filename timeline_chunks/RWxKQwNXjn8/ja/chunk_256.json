[{"type": "subtitle", "time": 15360.55, "timestamp": "04:16:00", "text": "水。"}, {"type": "subtitle", "time": 15363.03, "timestamp": "04:16:03", "text": "実際、私たちは浄水器を持っています"}, {"type": "subtitle", "time": 15367.189, "timestamp": "04:16:07", "text": "家。これは普通の浄水器です。"}, {"type": "subtitle", "time": 15370.95, "timestamp": "04:16:10", "text": "冷水とかお湯みたいな感じじゃないよ"}, {"type": "subtitle", "time": 15372.87, "timestamp": "04:16:12", "text": "物事の。"}, {"type": "subtitle", "time": 15376.87, "timestamp": "04:16:16", "text": "そういうことだ。あのね？"}, {"type": "subtitle", "time": 15379.03, "timestamp": "04:16:19", "text": "浄水器から水を汲んできます。"}, {"type": "subtitle", "time": 15388.87, "timestamp": "04:16:28", "text": "そして、もう一度加熱するつもりだ。"}, {"type": "subtitle", "time": 15392.07, "timestamp": "04:16:32", "text": "うん、ちょっと温めるだけだよ"}, {"type": "subtitle", "time": 15394.63, "timestamp": "04:16:34", "text": "また。"}]
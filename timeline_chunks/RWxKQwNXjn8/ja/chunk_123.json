[{"type": "subtitle", "time": 7382.55, "timestamp": "02:03:02", "text": "ビーツみたいな？"}, {"type": "subtitle", "time": 7385.189, "timestamp": "02:03:05", "text": "私はビーツが好きではありません。"}, {"type": "subtitle", "time": 7387.83, "timestamp": "02:03:07", "text": "まるで私がそれを食べられるかのように、もしあなたが私の"}, {"type": "subtitle", "time": 7391.03, "timestamp": "02:03:11", "text": "母はビーツのパラタのようなものを作る。"}, {"type": "subtitle", "time": 7394.07, "timestamp": "02:03:14", "text": "でも、私はそれが好きではない。"}, {"type": "subtitle", "time": 7397.189, "timestamp": "02:03:17", "text": "7つのクレームが入った瓶。はい。回収された瓶。"}, {"type": "subtitle", "time": 7399.75, "timestamp": "02:03:19", "text": "そして私は、ぬるぬるしたヒキガエルではありません。私はただ"}, {"type": "subtitle", "time": 7401.99, "timestamp": "02:03:21", "text": "瓶の形。"}, {"type": "subtitle", "time": 7410.149, "timestamp": "02:03:30", "text": "単なるfです。大丈夫。試してみます"}, {"type": "subtitle", "time": 7413.189, "timestamp": "02:03:33", "text": "一度食べたことはあるけど、ビーツは好きじゃない。"}, {"type": "subtitle", "time": 7415.35, "timestamp": "02:03:35", "text": "私は普段、好き嫌いはあまりない。私はただ"}, {"type": "subtitle", "time": 7421.99, "timestamp": "02:03:41", "text": "私はただ、食べ物を食べるように体を訓練しているだけです"}, {"type": "subtitle", "time": 7424.149, "timestamp": "02:03:44", "text": "それは私が好きではない。それは私が好きではない。それは"}, {"type": "subtitle", "time": 7426.31, "timestamp": "02:03:46", "text": "それ。そして最終的には、とても気に入りました。あなた"}, {"type": "subtitle", "time": 7430.229, "timestamp": "02:03:50", "text": "ほとんどご飯しか食べない。ジョー、"}, {"type": "subtitle", "time": 7436.31, "timestamp": "02:03:56", "text": "私も特にこだわりはないよ。だから私は食べる"}, {"type": "subtitle", "time": 7439.27, "timestamp": "02:03:59", "text": "すべて。"}]
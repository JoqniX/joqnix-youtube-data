[{"type": "subtitle", "time": 9421.429, "timestamp": "02:37:01", "text": "男？ Jモーメント。お前はいったい何者だ"}, {"type": "subtitle", "time": 9423.51, "timestamp": "02:37:03", "text": "私に何をしようとしているの？はぁ？近づかないでください"}, {"type": "subtitle", "time": 9437.03, "timestamp": "02:37:17", "text": "知っている。謝罪として、私は"}, {"type": "subtitle", "time": 9439.59, "timestamp": "02:37:19", "text": "ポーランドという国。"}, {"type": "subtitle", "time": 9442.469, "timestamp": "02:37:22", "text": "うん。どうやって絵を描けばいいですか？"}, {"type": "subtitle", "time": 9445.19, "timestamp": "02:37:25", "text": "わかった。ただ"}, {"type": "subtitle", "time": 9447.67, "timestamp": "02:37:27", "text": "私はポーランドの国を描きます"}, {"type": "subtitle", "time": 9453.349, "timestamp": "02:37:33", "text": "持続する。もう一度見てみると、どんな感じですか？"}, {"type": "subtitle", "time": 9455.51, "timestamp": "02:37:35", "text": "上は白で下は赤です"}, {"type": "subtitle", "time": 9457.91, "timestamp": "02:37:37", "text": "底。"}, {"type": "subtitle", "time": 9461.429, "timestamp": "02:37:41", "text": "[音楽]"}, {"type": "subtitle", "time": 9464.63, "timestamp": "02:37:44", "text": "ポーランド国歌。"}, {"type": "subtitle", "time": 9467.91, "timestamp": "02:37:47", "text": "ごめんなさい。ごめんなさい。"}, {"type": "subtitle", "time": 9469.91, "timestamp": "02:37:49", "text": "やり方がわからない。歌うってどういう意味？"}, {"type": "subtitle", "time": 9472.55, "timestamp": "02:37:52", "text": "ポーランド国民？私はできない"}, {"type": "subtitle", "time": 9475.349, "timestamp": "02:37:55", "text": "発音すらできない"}, {"type": "subtitle", "time": 9477.75, "timestamp": "02:37:57", "text": "ポーランド語の発音すらできない。あなたは私を求めている"}]
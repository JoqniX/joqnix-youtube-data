[{"type": "subtitle", "time": 12062.71, "timestamp": "03:21:02", "text": "AIやL関連のことで思いつくことは"}, {"type": "subtitle", "time": 12063.75, "timestamp": "03:21:03", "text": "主張をしようとしている、または"}, {"type": "subtitle", "time": 12065.59, "timestamp": "03:21:05", "text": "物事を維持するためなら何でも奨励する"}, {"type": "subtitle", "time": 12067.67, "timestamp": "03:21:07", "text": "整理整頓されているので忘れることはできません。私は実験室で、"}, {"type": "subtitle", "time": 12070.71, "timestamp": "03:21:10", "text": "ミームです。他人のアートを宣伝投稿しないでください。"}, {"type": "subtitle", "time": 12072.79, "timestamp": "03:21:12", "text": "そして私はいつもオリジナルのアーティストを探しています"}, {"type": "subtitle", "time": 12074.95, "timestamp": "03:21:14", "text": "ストリームでアートを使用する前にリンクを貼る"}, {"type": "subtitle", "time": 12077.75, "timestamp": "03:21:17", "text": "うんうん、私は従いたい"}, {"type": "subtitle", "time": 12080.87, "timestamp": "03:21:20", "text": "アメリア・ワトソンがやったのと同じ形式です"}, {"type": "subtitle", "time": 12082.79, "timestamp": "03:21:22", "text": "物事を整理したいだけです"}, {"type": "subtitle", "time": 12085.03, "timestamp": "03:21:25", "text": "人々はそれをTwitterに投稿したり、"}, {"type": "subtitle", "time": 12089.19, "timestamp": "03:21:29", "text": "どこでもいいよね？それでおしまい。"}, {"type": "subtitle", "time": 12090.95, "timestamp": "03:21:30", "text": "えっと"}, {"type": "subtitle", "time": 12094.15, "timestamp": "03:21:34", "text": "だって、たとえ私がやらなくても、"}, {"type": "subtitle", "time": 12097.51, "timestamp": "03:21:37", "text": "それを実行する人々。えっと、そして私は"}, {"type": "subtitle", "time": 12099.75, "timestamp": "03:21:39", "text": "それをやることリストに入れたくない"}, {"type": "subtitle", "time": 12103.51, "timestamp": "03:21:43", "text": "タグ。だから、この点には気をつけなければならない。"}, {"type": "subtitle", "time": 12105.19, "timestamp": "03:21:45", "text": "ポイント。私は本当に作りたい"}, {"type": "subtitle", "time": 12107.51, "timestamp": "03:21:47", "text": "指示ガイドラインだよ、兄弟。何てことだ。私"}, {"type": "subtitle", "time": 12110.15, "timestamp": "03:21:50", "text": "本当に、本当に、本当に作りたい"}, {"type": "subtitle", "time": 12112.309, "timestamp": "03:21:52", "text": "派生的なガイドライン。私は自分が持っていることを知っています"}, {"type": "chat", "time": 12113.218, "timestamp": "03:21:53", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "yeah that's very true"}, {"type": "subtitle", "time": 12115.349, "timestamp": "03:21:55", "text": "派生的なガイドラインですが、私はただ"}]
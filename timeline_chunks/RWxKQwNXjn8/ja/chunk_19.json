[{"type": "subtitle", "time": 1141.51, "timestamp": "00:19:01", "text": "うん。待って、待って、待って。いいえ、興味があるんです。"}, {"type": "subtitle", "time": 1143.35, "timestamp": "00:19:03", "text": "なるほど、あなたは朝食にご飯を食べるんですね。"}, {"type": "subtitle", "time": 1146.95, "timestamp": "00:19:06", "text": "昼食には何を召し上がりますか？米。"}, {"type": "subtitle", "time": 1157.27, "timestamp": "00:19:17", "text": "あなたはまるで大きな山頂のようです"}, {"type": "subtitle", "time": 1165.75, "timestamp": "00:19:25", "text": "何てことだ。待って、待って、待って、待って。わかった、"}, {"type": "subtitle", "time": 1168.07, "timestamp": "00:19:28", "text": "わかった。朝食は何にしますか？どのような"}, {"type": "subtitle", "time": 1170.31, "timestamp": "00:19:30", "text": "ご飯と一緒に食べますか？えっと、"}, {"type": "subtitle", "time": 1173.11, "timestamp": "00:19:33", "text": "何かあるんですか、えっと、何の中に？"}, {"type": "subtitle", "time": 1175.27, "timestamp": "00:19:35", "text": "そこにあるものは何でも、"}, {"type": "subtitle", "time": 1178.47, "timestamp": "00:19:38", "text": "今夜は"}, {"type": "subtitle", "time": 1180.63, "timestamp": "00:19:40", "text": "チキンカレーか何かと"}, {"type": "subtitle", "time": 1182.63, "timestamp": "00:19:42", "text": "朝には"}, {"type": "subtitle", "time": 1184.549, "timestamp": "00:19:44", "text": "その時作られるカレーは何であれ"}, {"type": "subtitle", "time": 1187.43, "timestamp": "00:19:47", "text": "その日は午後になります"}, {"type": "subtitle", "time": 1191.35, "timestamp": "00:19:51", "text": "夜にもう一度行い、その後同じことを繰り返す。"}, {"type": "subtitle", "time": 1192.63, "timestamp": "00:19:52", "text": "うん。"}, {"type": "subtitle", "time": 1195.75, "timestamp": "00:19:55", "text": "先生、来ていただきたいんです"}, {"type": "subtitle", "time": 1199.029, "timestamp": "00:19:59", "text": "ここで、私が食べるもの"}]
[{"type": "subtitle", "time": 15960.07, "timestamp": "04:26:00", "text": "小雨が降っている。"}, {"type": "subtitle", "time": 15963.429, "timestamp": "04:26:03", "text": "えっと、君たちは私みたいに"}, {"type": "subtitle", "time": 15966.229, "timestamp": "04:26:06", "text": "私が好きな理由を知ってください"}, {"type": "subtitle", "time": 15969.189, "timestamp": "04:26:09", "text": "私はじっと見つめるのが好きだ"}, {"type": "subtitle", "time": 15971.51, "timestamp": "04:26:11", "text": "雨が降ることもある"}, {"type": "subtitle", "time": 15974.63, "timestamp": "04:26:14", "text": "だっていいものだから。"}, {"type": "subtitle", "time": 15978.87, "timestamp": "04:26:18", "text": "ただ雨を見つめているだけで、わからない"}, {"type": "subtitle", "time": 15985.99, "timestamp": "04:26:25", "text": "実は気に入ってるんです。"}]
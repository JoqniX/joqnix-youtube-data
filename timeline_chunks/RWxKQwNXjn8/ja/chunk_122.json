[{"type": "subtitle", "time": 7322.39, "timestamp": "02:02:02", "text": "くそっ。それは何ですか？これは、えっと、"}, {"type": "subtitle", "time": 7327.75, "timestamp": "02:02:07", "text": "まるで、ボリュームたっぷりのスープのような感じ。ああ、そうだね。それ"}, {"type": "subtitle", "time": 7331.27, "timestamp": "02:02:11", "text": "すごく赤く見える。赤、赤。"}, {"type": "subtitle", "time": 7341.51, "timestamp": "02:02:21", "text": "Mは本当に素敵に見える。ああ、私は"}, {"type": "subtitle", "time": 7345.51, "timestamp": "02:02:25", "text": "いくつかの。辛い感じがする。"}, {"type": "subtitle", "time": 7347.83, "timestamp": "02:02:27", "text": "うん。"}, {"type": "subtitle", "time": 7349.83, "timestamp": "02:02:29", "text": "今まで一度も持ったことのないものが欲しい。私は"}, {"type": "subtitle", "time": 7351.99, "timestamp": "02:02:31", "text": "聞いたよ、それについてたくさん聞いたよ、どんな感じか"}, {"type": "subtitle", "time": 7354.229, "timestamp": "02:02:34", "text": "それは一種の主食のようなものですが、"}, {"type": "subtitle", "time": 7361.99, "timestamp": "02:02:41", "text": "スープは体に良い。あなたが知っている、"}, {"type": "subtitle", "time": 7364.87, "timestamp": "02:02:44", "text": "スープはとても美味しいです。とても簡単です"}, {"type": "subtitle", "time": 7372.79, "timestamp": "02:02:52", "text": "それほど辛くはないよ。温かみがある"}, {"type": "subtitle", "time": 7375.43, "timestamp": "02:02:55", "text": "それには、ある種の感覚がある。ビーツに似ている。一度もない"}, {"type": "subtitle", "time": 7377.109, "timestamp": "02:02:57", "text": "心。私はビーツが大嫌いです。私はほしくない"}, {"type": "subtitle", "time": 7379.99, "timestamp": "02:02:59", "text": "もうブラシは使わないで。ブラシ。ブラシ。あなたはしない"}]
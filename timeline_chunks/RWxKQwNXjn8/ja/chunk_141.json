[{"type": "subtitle", "time": 8461.59, "timestamp": "02:21:01", "text": "そこにパコラを加えます。"}, {"type": "subtitle", "time": 8465.59, "timestamp": "02:21:05", "text": "パコラ。えっと、パコラって、ほら、あれみたいなやつ"}, {"type": "subtitle", "time": 8469.67, "timestamp": "02:21:09", "text": "えっと、揚げパンのことだよ。ああ"}, {"type": "subtitle", "time": 8471.67, "timestamp": "02:21:11", "text": "うん"}, {"type": "subtitle", "time": 8476.63, "timestamp": "02:21:16", "text": "それは良いです。パコラとカレーは美味しい。"}, {"type": "subtitle", "time": 8478.95, "timestamp": "02:21:18", "text": "来てよ。料理してあげるよ"}, {"type": "subtitle", "time": 8482.469, "timestamp": "02:21:22", "text": "えっと、君にベアを味わわせてあげるよ"}, {"type": "subtitle", "time": 8486.389, "timestamp": "02:21:26", "text": "インド料理。パハリとは何ですか？パー"}, {"type": "subtitle", "time": 8489.11, "timestamp": "02:21:29", "text": "バハールは山です。つまりパハリとは"}, {"type": "subtitle", "time": 8490.87, "timestamp": "02:21:30", "text": "山"}, {"type": "subtitle", "time": 8494.469, "timestamp": "02:21:34", "text": "ヒマラヤ山脈からご存知のように、"}, {"type": "subtitle", "time": 8498.71, "timestamp": "02:21:38", "text": "そうそう。"}, {"type": "subtitle", "time": 8501.27, "timestamp": "02:21:41", "text": "正直言って、私の州には"}, {"type": "subtitle", "time": 8503.83, "timestamp": "02:21:43", "text": "その土地独自の料理の多く。それはある意味"}, {"type": "subtitle", "time": 8506.469, "timestamp": "02:21:46", "text": "まるで周りから借りてきたように、そして"}, {"type": "subtitle", "time": 8509.27, "timestamp": "02:21:49", "text": "まるでネパールと国境を接しているようなものだ。それはある意味"}, {"type": "subtitle", "time": 8511.59, "timestamp": "02:21:51", "text": "そこから取ったような感じ。まるで"}, {"type": "subtitle", "time": 8513.51, "timestamp": "02:21:53", "text": "混ぜ合わせる。"}, {"type": "subtitle", "time": 8515.51, "timestamp": "02:21:55", "text": "でも、それは良いことだ。私の鋼材にとって良い"}]
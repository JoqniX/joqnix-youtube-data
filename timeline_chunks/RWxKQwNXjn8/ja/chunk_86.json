[{"type": "subtitle", "time": 5160.07, "timestamp": "01:26:00", "text": "大丈夫だよ、ジョー。大丈夫。"}, {"type": "subtitle", "time": 5171.03, "timestamp": "01:26:11", "text": "目ってどうやって描くの？理解できない"}, {"type": "subtitle", "time": 5173.27, "timestamp": "01:26:13", "text": "それ。持続する。持続する。手伝います"}, {"type": "subtitle", "time": 5184.709, "timestamp": "01:26:24", "text": "わあ、とてもきれい。"}, {"type": "subtitle", "time": 5198.95, "timestamp": "01:26:38", "text": "[音楽]"}, {"type": "subtitle", "time": 5202.149, "timestamp": "01:26:42", "text": "フィッシュドッグ。魚料理を作らなきゃいけないんだよね？"}, {"type": "subtitle", "time": 5205.83, "timestamp": "01:26:45", "text": "わかった。えっと、あなたはとても輝いています"}]
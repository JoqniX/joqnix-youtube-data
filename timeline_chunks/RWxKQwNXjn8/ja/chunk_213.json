[{"type": "subtitle", "time": 12780.389, "timestamp": "03:33:00", "text": "ディスコアルバムの作品になる予定ですか、"}, {"type": "subtitle", "time": 12784.389, "timestamp": "03:33:04", "text": "イベントとかそういうもの。わからない。"}, {"type": "subtitle", "time": 12787.11, "timestamp": "03:33:07", "text": "だから私は自分の余分な"}, {"type": "subtitle", "time": 12790.469, "timestamp": "03:33:10", "text": "1マイルくらいかな。"}, {"type": "subtitle", "time": 12799.11, "timestamp": "03:33:19", "text": "神椿プロジェクトXのやつを見たよ。"}, {"type": "subtitle", "time": 12801.83, "timestamp": "03:33:21", "text": "これは本当に素晴らしいウェブサイトですね。私は見る"}, {"type": "subtitle", "time": 12805.269, "timestamp": "03:33:25", "text": "これ。彼らのテレビアニメシリーズ"}, {"type": "subtitle", "time": 12808.389, "timestamp": "03:33:28", "text": "ミニダイビングを開始しました。そしてこれは"}, {"type": "subtitle", "time": 12811.19, "timestamp": "03:33:31", "text": "なんてかっこいい神明なんだ。人々は私にとても"}, {"type": "subtitle", "time": 12812.95, "timestamp": "03:33:32", "text": "多くのインスピレーションを与えてくれた。この時点で、私は"}, {"type": "subtitle", "time": 12815.83, "timestamp": "03:33:35", "text": "日本に行って仕事を探す"}, {"type": "subtitle", "time": 12818.95, "timestamp": "03:33:38", "text": "上椿スタジオ。わからない"}, {"type": "subtitle", "time": 12821.19, "timestamp": "03:33:41", "text": "来ることへの私の愛の量"}, {"type": "subtitle", "time": 12823.19, "timestamp": "03:33:43", "text": "この時点では。私はただ働きたいだけです"}, {"type": "subtitle", "time": 12830.229, "timestamp": "03:33:50", "text": "もし可能なら。わからない。でも、そうですね、"}]
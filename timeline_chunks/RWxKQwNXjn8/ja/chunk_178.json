[{"type": "subtitle", "time": 10680.95, "timestamp": "02:58:00", "text": "お前ら全員クソくらえだ。私を捕まえることはできない。入手できません"}, {"type": "subtitle", "time": 10691.429, "timestamp": "02:58:11", "text": "[音楽]"}, {"type": "subtitle", "time": 10698.389, "timestamp": "02:58:18", "text": "そうだよ、だってすごく簡単だから。私は持っていません"}, {"type": "subtitle", "time": 10701.19, "timestamp": "02:58:21", "text": "に。何てことだ。"}, {"type": "subtitle", "time": 10702.63, "timestamp": "02:58:22", "text": "下品な考えはやめろ。得る"}, {"type": "subtitle", "time": 10704.15, "timestamp": "02:58:24", "text": "下品な考えはやめろ。私はただ"}, {"type": "subtitle", "time": 10711.11, "timestamp": "02:58:31", "text": "ああ。"}, {"type": "subtitle", "time": 10716.87, "timestamp": "02:58:36", "text": "誰かに彼女を送り返してもらう必要があった"}, {"type": "subtitle", "time": 10722.0, "timestamp": "02:58:42", "text": "彼女。おお。意地悪なチャットですね。"}, {"type": "subtitle", "time": 10723.91, "timestamp": "02:58:43", "text": "[音楽]"}, {"type": "subtitle", "time": 10726.07, "timestamp": "02:58:46", "text": "ところで、夕食は食べましたか？"}, {"type": "subtitle", "time": 10729.11, "timestamp": "02:58:49", "text": "そうそう。はい、そうしました。私はそれを食べたと思います"}, {"type": "subtitle", "time": 10733.19, "timestamp": "02:58:53", "text": "6か7か、そんな感じ。ああ、しまった。あなたは食べる"}, {"type": "subtitle", "time": 10737.03, "timestamp": "02:58:57", "text": "早い。ああ、すごくお腹が空いていた。私はまるで"}]
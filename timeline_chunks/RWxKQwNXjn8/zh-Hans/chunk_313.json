[{"type": "subtitle", "time": 18781.83, "timestamp": "05:13:01", "text": "显示屏是四。好的。呃，按下"}, {"type": "subtitle", "time": 18784.47, "timestamp": "05:13:04", "text": "标有“4”的按钮。"}, {"type": "subtitle", "time": 18785.99, "timestamp": "05:13:05", "text": "标有“4”的按钮位于第一个位置。"}, {"type": "subtitle", "time": 18787.27, "timestamp": "05:13:07", "text": "位置。第一回合按四"}, {"type": "subtitle", "time": 18790.788, "timestamp": "05:13:10", "text": "位置。第一的。好的。然后是第四个"}, {"type": "subtitle", "time": 18793.59, "timestamp": "05:13:13", "text": "阶段。第四阶段标签显示是"}, {"type": "subtitle", "time": 18797.03, "timestamp": "05:13:17", "text": "一。好的。呃，按压与上述相同的位置"}, {"type": "subtitle", "time": 18800.708, "timestamp": "05:13:20", "text": "你在第一阶段按下了按钮。那是"}, {"type": "subtitle", "time": 18803.67, "timestamp": "05:13:23", "text": "呃，第二名。你按下三。"}, {"type": "subtitle", "time": 18805.19, "timestamp": "05:13:25", "text": "第二。正确的。好的。我们拥有的少于"}, {"type": "subtitle", "time": 18808.07, "timestamp": "05:13:28", "text": "还剩30秒。好的。和"}, {"type": "subtitle", "time": 18809.91, "timestamp": "05:13:29", "text": "我们还剩下两个模块。 20"}, {"type": "subtitle", "time": 18813.35, "timestamp": "05:13:33", "text": "秒。第五阶段显示两个。"}, {"type": "subtitle", "time": 18815.51, "timestamp": "05:13:35", "text": "用同样的按钮"}, {"type": "subtitle", "time": 18818.55, "timestamp": "05:13:38", "text": "等级。按下第二阶段按钮。那是呃"}, {"type": "subtitle", "time": 18820.39, "timestamp": "05:13:40", "text": "你按了"}, {"type": "subtitle", "time": 18822.628, "timestamp": "05:13:42", "text": "呃"}, {"type": "subtitle", "time": 18826.23, "timestamp": "05:13:46", "text": "嗯嗯，三。是的。一。繁荣。等待。"}, {"type": "subtitle", "time": 18828.39, "timestamp": "05:13:48", "text": "什么？"}, {"type": "subtitle", "time": 18831.51, "timestamp": "05:13:51", "text": "我的天啊。"}, {"type": "subtitle", "time": 18833.99, "timestamp": "05:13:53", "text": "不。"}]
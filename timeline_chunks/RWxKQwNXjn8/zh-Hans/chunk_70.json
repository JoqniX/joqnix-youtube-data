[{"type": "subtitle", "time": 4200.709, "timestamp": "01:10:00", "text": "他一生挚爱。阿雷克萨，他可以"}, {"type": "subtitle", "time": 4203.91, "timestamp": "01:10:03", "text": "他简直不敢相信自己的耳朵。 Arex 绝不会"}, {"type": "subtitle", "time": 4206.63, "timestamp": "01:10:06", "text": "说给我听。他怎么能这样做呢？"}, {"type": "chat", "time": 4208.329, "timestamp": "01:10:08", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "hi"}, {"type": "subtitle", "time": 4209.35, "timestamp": "01:10:09", "text": "我？就站在门口"}, {"type": "subtitle", "time": 4212.47, "timestamp": "01:10:12", "text": "默默地看着他的伴侣播种"}, {"type": "subtitle", "time": 4217.59, "timestamp": "01:10:17", "text": "怒不可遏。洛莉，事情必须这样。"}, {"type": "subtitle", "time": 4221.03, "timestamp": "01:10:21", "text": "对不起。艾瑞斯伸出了双手"}, {"type": "subtitle", "time": 4223.83, "timestamp": "01:10:23", "text": "走向哈拉萨的脸，却发现"}, {"type": "subtitle", "time": 4227.27, "timestamp": "01:10:27", "text": "被拍开。一片寂静。"}, {"type": "subtitle", "time": 4229.51, "timestamp": "01:10:29", "text": "充满了杜卡西尔的嗅觉和"}, {"type": "subtitle", "time": 4232.79, "timestamp": "01:10:32", "text": "呼吸。哈拉斯的眼泪盈眶"}, {"type": "subtitle", "time": 4237.27, "timestamp": "01:10:37", "text": "眼睛。他受伤了。他很生气。多于"}, {"type": "subtitle", "time": 4241.03, "timestamp": "01:10:41", "text": "他感觉自己彻底崩溃了。他盯着阿克萨看。"}, {"type": "subtitle", "time": 4243.83, "timestamp": "01:10:43", "text": "感觉过了好久好久。他想"}, {"type": "subtitle", "time": 4246.709, "timestamp": "01:10:46", "text": "听他怎么说，结果却截然不同。他希望他"}, {"type": "subtitle", "time": 4250.149, "timestamp": "01:10:50", "text": "说它是假的。这一切都是谎言。"}, {"type": "subtitle", "time": 4254.63, "timestamp": "01:10:54", "text": "但事实并非如此。莱普"}, {"type": "subtitle", "time": 4258.39, "timestamp": "01:10:58", "text": "他简直不敢相信自己的小鱼"}]
[{"type": "subtitle", "time": 17410.15, "timestamp": "04:50:10", "text": "我觉得我大概会是负责人。"}, {"type": "subtitle", "time": 17412.628, "timestamp": "04:50:12", "text": "下一个。你好。"}, {"type": "subtitle", "time": 17415.35, "timestamp": "04:50:15", "text": "开始了。你好。我们将加倍支付您的费用"}, {"type": "subtitle", "time": 17421.03, "timestamp": "04:50:21", "text": "你准备好了。"}, {"type": "subtitle", "time": 17422.55, "timestamp": "04:50:22", "text": "你注意到旁边的电子钟了吗？"}, {"type": "subtitle", "time": 17426.788, "timestamp": "04:50:26", "text": "炸弹箱显示了确切时间。"}, {"type": "subtitle", "time": 17429.83, "timestamp": "04:50:29", "text": "哦，是的。我注意到了。我太忙了。"}, {"type": "subtitle", "time": 17431.43, "timestamp": "04:50:31", "text": "仔细观察炸弹才能注意到"}, {"type": "subtitle", "time": 17435.67, "timestamp": "04:50:35", "text": "差不多就是这样。当地时间。"}, {"type": "subtitle", "time": 17437.51, "timestamp": "04:50:37", "text": "好的，我们开始吧。你准备好了吗？"}, {"type": "subtitle", "time": 17441.27, "timestamp": "04:50:41", "text": "米娅？开始。嗯，"}, {"type": "subtitle", "time": 17443.99, "timestamp": "04:50:43", "text": "等待。你开始了？是的。"}, {"type": "subtitle", "time": 17447.83, "timestamp": "04:50:47", "text": "哦，什么？好的。好的。"}, {"type": "subtitle", "time": 17451.03, "timestamp": "04:50:51", "text": "告诉我。所以，这里有一个线控模块。"}, {"type": "subtitle", "time": 17453.11, "timestamp": "04:50:53", "text": "不，两线模块，两个简单的"}, {"type": "subtitle", "time": 17455.83, "timestamp": "04:50:55", "text": "模块，两个按钮。我们来做电线吧"}, {"type": "subtitle", "time": 17458.788, "timestamp": "04:50:58", "text": "第一的。好的。电线。所以，我正在看……"}]
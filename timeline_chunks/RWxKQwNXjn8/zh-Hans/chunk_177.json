[{"type": "subtitle", "time": 10621.19, "timestamp": "02:57:01", "text": "最喜欢的东西？我不知道。苹果。"}, {"type": "subtitle", "time": 10622.71, "timestamp": "02:57:02", "text": "苹果？"}, {"type": "subtitle", "time": 10625.269, "timestamp": "02:57:05", "text": "我不知道。"}, {"type": "subtitle", "time": 10632.07, "timestamp": "02:57:12", "text": "我喜欢涂鸦。就像我总是会做的那样"}, {"type": "subtitle", "time": 10633.75, "timestamp": "02:57:13", "text": "本该涂鸦的时候我却在涂鸦"}, {"type": "subtitle", "time": 10636.469, "timestamp": "02:57:16", "text": "学习中。"}, {"type": "subtitle", "time": 10641.67, "timestamp": "02:57:21", "text": "看看人们多么渴望宣称自己是印地语使用者。不"}, {"type": "subtitle", "time": 10644.309, "timestamp": "02:57:24", "text": "你他妈敢！不，不，不。坏事"}, {"type": "subtitle", "time": 10647.429, "timestamp": "02:57:27", "text": "聊天。我直接把笑话打出来就行了。你"}, {"type": "subtitle", "time": 10650.389, "timestamp": "02:57:30", "text": "不能碰罐子。什么？不用担心"}, {"type": "subtitle", "time": 10651.99, "timestamp": "02:57:31", "text": "关于这个笑话。他们只是他们他们是"}, {"type": "subtitle", "time": 10655.75, "timestamp": "02:57:35", "text": "他们想扳倒我。"}, {"type": "subtitle", "time": 10658.389, "timestamp": "02:57:38", "text": "哦，"}, {"type": "subtitle", "time": 10660.15, "timestamp": "02:57:40", "text": "他们正在尝试，他们正在尝试"}, {"type": "subtitle", "time": 10661.75, "timestamp": "02:57:41", "text": "别惹我。他们正在尝试"}, {"type": "subtitle", "time": 10664.15, "timestamp": "02:57:44", "text": "摇晃我。他们试图抓住"}, {"type": "subtitle", "time": 10668.23, "timestamp": "02:57:48", "text": "我的罐子，摇晃我。"}, {"type": "subtitle", "time": 10669.83, "timestamp": "02:57:49", "text": "你知道吗，乔？我要去 我 我将"}, {"type": "subtitle", "time": 10671.51, "timestamp": "02:57:51", "text": "躲在乔身后就行了。我还是躲起来吧。"}, {"type": "subtitle", "time": 10673.51, "timestamp": "02:57:53", "text": "在乔克身后。"}, {"type": "subtitle", "time": 10675.429, "timestamp": "02:57:55", "text": "我躲在乔身后。你们都搞不定"}, {"type": "subtitle", "time": 10678.15, "timestamp": "02:57:58", "text": "现在的我。"}]
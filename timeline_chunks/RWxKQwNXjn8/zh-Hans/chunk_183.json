[{"type": "subtitle", "time": 10980.309, "timestamp": "03:03:00", "text": "我认为他是。他假装很和善，"}, {"type": "subtitle", "time": 10982.55, "timestamp": "03:03:02", "text": "但他是个杀人犯，兄弟。他是个杀人犯，"}, {"type": "subtitle", "time": 10984.71, "timestamp": "03:03:04", "text": "男人。”"}, {"type": "subtitle", "time": 10986.71, "timestamp": "03:03:06", "text": "然后，然后我，然后我得到一个"}, {"type": "subtitle", "time": 10989.429, "timestamp": "03:03:09", "text": "语音通话。然后我就收到一段视频"}, {"type": "subtitle", "time": 10993.269, "timestamp": "03:03:13", "text": "称呼。他们会和我视频通话。而乔是"}, {"type": "subtitle", "time": 10997.67, "timestamp": "03:03:17", "text": "在虚拟现实中。他正在玩虚拟现实游戏，而且他正在切菜。"}, {"type": "subtitle", "time": 11000.23, "timestamp": "03:03:20", "text": "砍掉人们的头颅。"}, {"type": "subtitle", "time": 11002.55, "timestamp": "03:03:22", "text": "他正在砍掉别人的头。他是"}, {"type": "subtitle", "time": 11005.03, "timestamp": "03:03:25", "text": "他用刀刺他们，而且他"}, {"type": "subtitle", "time": 11009.349, "timestamp": "03:03:29", "text": "“你为什么不死？迪奥，"}, {"type": "subtitle", "time": 11011.75, "timestamp": "03:03:31", "text": "去死吧。"}, {"type": "subtitle", "time": 11013.429, "timestamp": "03:03:33", "text": "就像他坐在那里，沉浸在甜蜜之中。"}, {"type": "subtitle", "time": 11015.51, "timestamp": "03:03:35", "text": "有点像，你知道，哦，没关系。"}, {"type": "subtitle", "time": 11018.389, "timestamp": "03:03:38", "text": "一切都很可爱。声音很可爱。但他"}, {"type": "subtitle", "time": 11022.23, "timestamp": "03:03:42", "text": "他妈的杀人犯。我当时正在做我的"}, {"type": "subtitle", "time": 11026.23, "timestamp": "03:03:46", "text": "内部基托物品。离开。他就像他"}, {"type": "subtitle", "time": 11030.309, "timestamp": "03:03:50", "text": "他手里拿着两个。是的。中的一个"}, {"type": "subtitle", "time": 11034.469, "timestamp": "03:03:54", "text": "将冷冻头颅的一侧砍下来。"}, {"type": "subtitle", "time": 11038.15, "timestamp": "03:03:58", "text": "他把它砍掉了。我用了反手击球法"}]
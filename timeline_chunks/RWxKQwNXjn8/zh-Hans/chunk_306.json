[{"type": "subtitle", "time": 18361.67, "timestamp": "05:06:01", "text": "我的意思是，我的天哪。喂。"}, {"type": "subtitle", "time": 18364.23, "timestamp": "05:06:04", "text": "我只是在开玩笑。我的意思是，你知道，它"}, {"type": "subtitle", "time": 18366.708, "timestamp": "05:06:06", "text": "真的，真的没有损失任何有价值的东西。"}, {"type": "subtitle", "time": 18368.628, "timestamp": "05:06:08", "text": "因为，你知道，我可以按下重置键。"}, {"type": "subtitle", "time": 18370.948, "timestamp": "05:06:10", "text": "重试。"}, {"type": "subtitle", "time": 18375.67, "timestamp": "05:06:15", "text": "是的。好的。你想再试一次吗？"}, {"type": "subtitle", "time": 18379.03, "timestamp": "05:06:19", "text": "再次交手。是的。我们开始做吧。"}, {"type": "subtitle", "time": 18381.43, "timestamp": "05:06:21", "text": "再次挥拳。"}, {"type": "subtitle", "time": 18383.75, "timestamp": "05:06:23", "text": "炸弹再次启动。"}, {"type": "subtitle", "time": 18385.35, "timestamp": "05:06:25", "text": "妈的。有人在敲门。"}, {"type": "subtitle", "time": 18402.948, "timestamp": "05:06:42", "text": "聊天进行得怎么样？"}, {"type": "subtitle", "time": 18406.948, "timestamp": "05:06:46", "text": "既从我的角度，也从斯蒂安的角度？如何"}, {"type": "subtitle", "time": 18415.35, "timestamp": "05:06:55", "text": "他们俩现在情况怎么样？"}, {"type": "subtitle", "time": 18417.83, "timestamp": "05:06:57", "text": "哦，等等。我的设备没有更新。哦，"}]
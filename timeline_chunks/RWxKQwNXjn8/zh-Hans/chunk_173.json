[{"type": "subtitle", "time": 10383.91, "timestamp": "02:53:03", "text": "这样我才能到达。不，不是。"}, {"type": "subtitle", "time": 10387.269, "timestamp": "02:53:07", "text": "乔克，你戴眼镜吗？是的，我穿"}, {"type": "subtitle", "time": 10389.429, "timestamp": "02:53:09", "text": "跟我车里戴的眼镜一模一样。这"}, {"type": "subtitle", "time": 10392.309, "timestamp": "02:53:12", "text": "圆角一。我喜欢圆形眼镜。"}, {"type": "subtitle", "time": 10396.469, "timestamp": "02:53:16", "text": "它们看起来好可爱。是的，他们是"}, {"type": "subtitle", "time": 10398.71, "timestamp": "02:53:18", "text": "呃，我没有完全圆润的"}, {"type": "subtitle", "time": 10400.469, "timestamp": "02:53:20", "text": "戴眼镜，但我有那种你知道的……"}, {"type": "subtitle", "time": 10403.75, "timestamp": "02:53:23", "text": "圆形玻璃杯。嗯。他们会很少"}, {"type": "subtitle", "time": 10405.51, "timestamp": "02:53:25", "text": "圆形的。"}, {"type": "subtitle", "time": 10407.91, "timestamp": "02:53:27", "text": "当前型号采用黑色圆形设计"}, {"type": "subtitle", "time": 10412.309, "timestamp": "02:53:32", "text": "眼镜。呃，但是目前我去了"}, {"type": "subtitle", "time": 10415.19, "timestamp": "02:53:35", "text": "配上金色的圆形玻璃杯"}, {"type": "subtitle", "time": 10417.99, "timestamp": "02:53:37", "text": "这是新车型所具备的。"}, {"type": "subtitle", "time": 10420.309, "timestamp": "02:53:40", "text": "M"}, {"type": "subtitle", "time": 10422.23, "timestamp": "02:53:42", "text": "眼镜。眼镜很酷。当我当我"}, {"type": "subtitle", "time": 10424.63, "timestamp": "02:53:44", "text": "就像你小时候那样，我很少……"}, {"type": "subtitle", "time": 10427.349, "timestamp": "02:53:47", "text": "我以前就像个小家伙"}, {"type": "subtitle", "time": 10430.23, "timestamp": "02:53:50", "text": "我的天啊，这也太酷了吧！"}, {"type": "subtitle", "time": 10432.15, "timestamp": "02:53:52", "text": "眼镜。但并非我的酸"}, {"type": "subtitle", "time": 10434.07, "timestamp": "02:53:54", "text": "其实我当时想的是，“哦，糟了。我可能会说不吉利的话。”"}]
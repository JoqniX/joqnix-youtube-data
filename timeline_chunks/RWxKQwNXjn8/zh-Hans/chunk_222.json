[{"type": "subtitle", "time": 13320.79, "timestamp": "03:42:00", "text": "我生日那天的模特"}, {"type": "subtitle", "time": 13324.469, "timestamp": "03:42:04", "text": "八月。但是没钱，就什么也做不了。"}, {"type": "subtitle", "time": 13335.75, "timestamp": "03:42:15", "text": "所以我在想，呃，开一个电流"}, {"type": "subtitle", "time": 13339.11, "timestamp": "03:42:19", "text": "账户我必须支付，呃，我必须"}, {"type": "subtitle", "time": 13341.349, "timestamp": "03:42:21", "text": "我有两个选择，5000 和"}, {"type": "subtitle", "time": 13343.19, "timestamp": "03:42:23", "text": "10,000"}, {"type": "subtitle", "time": 13345.67, "timestamp": "03:42:25", "text": "嗯，启动当前账户所需的最低余额"}, {"type": "subtitle", "time": 13348.07, "timestamp": "03:42:28", "text": "接下来是 Jo 的账户。所以要么我放"}, {"type": "subtitle", "time": 13350.07, "timestamp": "03:42:30", "text": "买这笔钱。我觉得我不会"}, {"type": "subtitle", "time": 13352.79, "timestamp": "03:42:32", "text": "把钱放在那里，就是从那里拿出来的钱"}, {"type": "subtitle", "time": 13354.79, "timestamp": "03:42:34", "text": "乔森。我真的会把那笔钱存起来。"}, {"type": "subtitle", "time": 13357.75, "timestamp": "03:42:37", "text": "要么买个牵引绳许可证"}, {"type": "subtitle", "time": 13361.59, "timestamp": "03:42:41", "text": "一年，但再次购买许可证"}, {"type": "subtitle", "time": 13364.71, "timestamp": "03:42:44", "text": "一年时间不会有太大改变。我的意思是，那将会"}, {"type": "subtitle", "time": 13367.269, "timestamp": "03:42:47", "text": "这将有助于我公开地"}, {"type": "subtitle", "time": 13369.99, "timestamp": "03:42:49", "text": "发帖介绍这款模型，并放出一些预告"}, {"type": "subtitle", "time": 13374.229, "timestamp": "03:42:54", "text": "模仿那个轮廓之类的。但"}, {"type": "subtitle", "time": 13376.63, "timestamp": "03:42:56", "text": "难道攒起来不是更好吗？"}, {"type": "subtitle", "time": 13379.91, "timestamp": "03:42:59", "text": "索具的成本大约是"}]
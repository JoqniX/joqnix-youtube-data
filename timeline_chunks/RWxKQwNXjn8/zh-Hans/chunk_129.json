[{"type": "subtitle", "time": 7740.87, "timestamp": "02:09:00", "text": "不小心搞砸了"}, {"type": "subtitle", "time": 7744.069, "timestamp": "02:09:04", "text": "它们的镀层。哦，记得锁好你的码头。"}, {"type": "subtitle", "time": 7746.709, "timestamp": "02:09:06", "text": "尽管。那样不是更容易吗？是的，就是这样。"}, {"type": "subtitle", "time": 7748.47, "timestamp": "02:09:08", "text": "更轻松。但我记不清它是怎么用的了。"}, {"type": "subtitle", "time": 7749.99, "timestamp": "02:09:09", "text": "看起来像什么，现在我不知道了"}, {"type": "subtitle", "time": 7752.629, "timestamp": "02:09:12", "text": "我已经完成了。"}, {"type": "subtitle", "time": 7754.709, "timestamp": "02:09:14", "text": "为什么不呢？"}, {"type": "subtitle", "time": 7756.069, "timestamp": "02:09:16", "text": "没关系。查看。一切都很好。"}, {"type": "subtitle", "time": 7758.629, "timestamp": "02:09:18", "text": "一切都很好。一切都好。"}, {"type": "subtitle", "time": 7761.189, "timestamp": "02:09:21", "text": "无需惊慌。我知道如何"}, {"type": "subtitle", "time": 7765.43, "timestamp": "02:09:25", "text": "直播，我是一名主播。好的。穿上"}, {"type": "subtitle", "time": 7767.35, "timestamp": "02:09:27", "text": "我国家的传统节日。尽量"}, {"type": "subtitle", "time": 7770.79, "timestamp": "02:09:30", "text": "把它冒充成真品。哦"}, {"type": "subtitle", "time": 7773.189, "timestamp": "02:09:33", "text": "是啊，这很美国化。"}, {"type": "subtitle", "time": 7776.069, "timestamp": "02:09:36", "text": "待办事项。你知道更糟糕的是什么吗？操"}, {"type": "subtitle", "time": 7778.79, "timestamp": "02:09:38", "text": "你见过他那玩意儿吗？"}, {"type": "subtitle", "time": 7781.589, "timestamp": "02:09:41", "text": "姓名？那个人叫什么名字？尝试"}, {"type": "subtitle", "time": 7784.55, "timestamp": "02:09:44", "text": "记住。他叫什么名字？"}, {"type": "subtitle", "time": 7789.83, "timestamp": "02:09:49", "text": "呃，是杰米·奥利弗吗？你……"}, {"type": "subtitle", "time": 7792.069, "timestamp": "02:09:52", "text": "乔克，你有没有看到杰米"}, {"type": "subtitle", "time": 7796.47, "timestamp": "02:09:56", "text": "奥利弗做了黄油鸡？不。"}, {"type": "subtitle", "time": 7799.03, "timestamp": "02:09:59", "text": "好的，乔。"}]
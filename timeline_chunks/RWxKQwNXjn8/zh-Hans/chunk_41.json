[{"type": "subtitle", "time": 2460.47, "timestamp": "00:41:00", "text": "感谢关注。呃，Q 说谢谢"}, {"type": "subtitle", "time": 2462.15, "timestamp": "00:41:02", "text": "你。"}, {"type": "subtitle", "time": 2464.55, "timestamp": "00:41:04", "text": "耶！"}, {"type": "subtitle", "time": 2472.71, "timestamp": "00:41:12", "text": "胖的。你见过胖皮卡丘吗？粉笔。"}, {"type": "subtitle", "time": 2475.829, "timestamp": "00:41:15", "text": "没有。你没见过胖皮卡丘吗？这"}, {"type": "subtitle", "time": 2478.55, "timestamp": "00:41:18", "text": "史上最棒的皮卡丘？"}, {"type": "subtitle", "time": 2483.75, "timestamp": "00:41:23", "text": "不。我的天哪。是的，"}, {"type": "subtitle", "time": 2487.75, "timestamp": "00:41:27", "text": "我的广告卡顿得厉害，真是太离谱了。"}, {"type": "subtitle", "time": 2490.87, "timestamp": "00:41:30", "text": "我看到一只性感的熊猫。妈妈饿了。什么"}, {"type": "subtitle", "time": 2510.15, "timestamp": "00:41:50", "text": "她太冷静了，连屁股都冷静。那是"}, {"type": "subtitle", "time": 2513.75, "timestamp": "00:41:53", "text": "不是我的错。广告不是我的错。"}]
[{"type": "subtitle", "time": 6781.27, "timestamp": "01:53:01", "text": "以为所有人都停下来了。不，我们"}, {"type": "subtitle", "time": 6783.669, "timestamp": "01:53:03", "text": "我几乎每次都会玩那个游戏"}, {"type": "subtitle", "time": 6785.51, "timestamp": "01:53:05", "text": "我可以让别人玩那个游戏。"}, {"type": "subtitle", "time": 6788.629, "timestamp": "01:53:08", "text": "强迫他们玩。我是一个威胁"}, {"type": "subtitle", "time": 6792.87, "timestamp": "01:53:12", "text": "社会，尤其是我总是"}, {"type": "subtitle", "time": 6801.51, "timestamp": "01:53:21", "text": "最近我开始玩Vuva了"}, {"type": "subtitle", "time": 6811.109, "timestamp": "01:53:31", "text": "是啊，你也玩得不错，对吧？开玩笑的。"}, {"type": "subtitle", "time": 6813.99, "timestamp": "01:53:33", "text": "你拿到最新角色了吗？"}, {"type": "subtitle", "time": 6816.31, "timestamp": "01:53:36", "text": "我得到了扎尼"}, {"type": "subtitle", "time": 6819.84, "timestamp": "01:53:39", "text": "哦。我的天啊。她真性感。"}, {"type": "subtitle", "time": 6821.669, "timestamp": "01:53:41", "text": "[音乐]"}, {"type": "subtitle", "time": 6824.87, "timestamp": "01:53:44", "text": "就像扎尼一样。扎尼就像那个人"}, {"type": "subtitle", "time": 6828.31, "timestamp": "01:53:48", "text": "有盾牌之类的东西，对吧？是的。"}, {"type": "subtitle", "time": 6830.87, "timestamp": "01:53:50", "text": "啊，她真性感。就像尼克向她展示的那样"}, {"type": "subtitle", "time": 6833.589, "timestamp": "01:53:53", "text": "我和她一见钟情。"}, {"type": "subtitle", "time": 6835.99, "timestamp": "01:53:55", "text": "但我错过了她的横幅。"}]
[{"type": "subtitle", "time": 10800.23, "timestamp": "03:00:00", "text": "上帝啊，煮点米饭吧。”然后我就吃了。"}, {"type": "subtitle", "time": 10802.63, "timestamp": "03:00:02", "text": "然后我就睡着了。我本该是"}, {"type": "subtitle", "time": 10804.79, "timestamp": "03:00:04", "text": "应该回到直播或或在"}, {"type": "subtitle", "time": 10807.51, "timestamp": "03:00:07", "text": "至少要像使用我的手机一样开启移动模式"}, {"type": "subtitle", "time": 10810.389, "timestamp": "03:00:10", "text": "手机将接入直播流并进行语音播报"}, {"type": "subtitle", "time": 10813.75, "timestamp": "03:00:13", "text": "战争正在进行中。呃，但我睡着了"}, {"type": "subtitle", "time": 10818.15, "timestamp": "03:00:18", "text": "离开。然后我早上醒来，然后就到了这个年纪。"}, {"type": "subtitle", "time": 10820.71, "timestamp": "03:00:20", "text": "再来一场比赛。然后是下午八点的比赛"}, {"type": "subtitle", "time": 10828.79, "timestamp": "03:00:28", "text": "狗。你快把我弄哭了。我是"}, {"type": "subtitle", "time": 10830.79, "timestamp": "03:00:30", "text": "我要哭了。"}, {"type": "subtitle", "time": 10834.07, "timestamp": "03:00:34", "text": "我知道。难道我不需要闯入吗？"}, {"type": "subtitle", "time": 10838.55, "timestamp": "03:00:38", "text": "把你从家里带走，然后把你绑架走。"}, {"type": "subtitle", "time": 10841.51, "timestamp": "03:00:41", "text": "我说这话就好像我要绑架你一样。"}, {"type": "subtitle", "time": 10845.51, "timestamp": "03:00:45", "text": "就是这样。兄弟是亚洲人，他本来就是。他是"}, {"type": "subtitle", "time": 10848.469, "timestamp": "03:00:48", "text": "他就像最亚洲的亚洲人。"}, {"type": "subtitle", "time": 10850.79, "timestamp": "03:00:50", "text": "我不是米饭。我就是喜欢米饭。"}, {"type": "subtitle", "time": 10853.83, "timestamp": "03:00:53", "text": "好的。我喜欢吃米饭，但你不能吃。"}, {"type": "subtitle", "time": 10856.07, "timestamp": "03:00:56", "text": "每餐都是如此。你可以拥有"}, {"type": "subtitle", "time": 10859.01, "timestamp": "03:00:59", "text": "不同的事情。"}]
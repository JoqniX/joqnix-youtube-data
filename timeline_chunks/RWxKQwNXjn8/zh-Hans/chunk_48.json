[{"type": "subtitle", "time": 2891.829, "timestamp": "00:48:11", "text": "[音乐]"}, {"type": "subtitle", "time": 2894.309, "timestamp": "00:48:14", "text": "是的。如果我仔细想想，这会"}, {"type": "subtitle", "time": 2897.589, "timestamp": "00:48:17", "text": "这应该是我们第一次正式合作了吧？是的。"}, {"type": "subtitle", "time": 2899.03, "timestamp": "00:48:19", "text": "这是我们的，我的意思是，我们已经……"}, {"type": "subtitle", "time": 2902.95, "timestamp": "00:48:22", "text": "之前在群组通话中。是的。这是我们的"}, {"type": "subtitle", "time": 2906.309, "timestamp": "00:48:26", "text": "第一次。"}, {"type": "subtitle", "time": 2907.829, "timestamp": "00:48:27", "text": "一起。"}, {"type": "subtitle", "time": 2910.15, "timestamp": "00:48:30", "text": "是的。"}, {"type": "subtitle", "time": 2912.71, "timestamp": "00:48:32", "text": "我从来不需要这样做。我被录用了，然后说"}, {"type": "subtitle", "time": 2914.95, "timestamp": "00:48:34", "text": "事物。我相信米茨是其中之一。"}, {"type": "subtitle", "time": 2917.43, "timestamp": "00:48:37", "text": "他们。你们对我太坏了。他是"}, {"type": "subtitle", "time": 2920.23, "timestamp": "00:48:40", "text": "只是个小家伙。他还是个婴儿。和"}, {"type": "subtitle", "time": 2921.99, "timestamp": "00:48:41", "text": "你们在欺负人"}, {"type": "subtitle", "time": 2923.67, "timestamp": "00:48:43", "text": "现在正在生孩子。你对此有何感想"}, {"type": "subtitle", "time": 2925.99, "timestamp": "00:48:45", "text": "欺负婴儿？嗯？你感觉如何"}, {"type": "subtitle", "time": 2927.829, "timestamp": "00:48:47", "text": "你欺负过别人"}, {"type": "subtitle", "time": 2929.91, "timestamp": "00:48:49", "text": "婴儿？你快乐吗？你为此感到自豪"}, {"type": "subtitle", "time": 2934.87, "timestamp": "00:48:54", "text": "自言自语？他还是个婴儿。"}, {"type": "subtitle", "time": 2936.63, "timestamp": "00:48:56", "text": "是的，聊天记录已关联。聊天记录"}]
[{"type": "subtitle", "time": 7322.39, "timestamp": "02:02:02", "text": "拉屎。那是什么？这就像……嗯……"}, {"type": "subtitle", "time": 7327.75, "timestamp": "02:02:07", "text": "就像一碗浓汤。啊，是的。它"}, {"type": "subtitle", "time": 7331.27, "timestamp": "02:02:11", "text": "看起来好红。红色，红色。"}, {"type": "subtitle", "time": 7341.51, "timestamp": "02:02:21", "text": "M看起来真帅。我的天哪，我想要"}, {"type": "subtitle", "time": 7345.51, "timestamp": "02:02:25", "text": "一些。感觉很辣。"}, {"type": "subtitle", "time": 7347.83, "timestamp": "02:02:27", "text": "嗯。"}, {"type": "subtitle", "time": 7349.83, "timestamp": "02:02:29", "text": "我想要我从未拥有过的兄弟。我已经"}, {"type": "subtitle", "time": 7351.99, "timestamp": "02:02:31", "text": "我听说过很多关于它的事情，比如……"}, {"type": "subtitle", "time": 7354.229, "timestamp": "02:02:34", "text": "它有点像主食，但是"}, {"type": "subtitle", "time": 7361.99, "timestamp": "02:02:41", "text": "汤对身体有益。你知道，"}, {"type": "subtitle", "time": 7364.87, "timestamp": "02:02:44", "text": "汤很好喝。太容易了"}, {"type": "subtitle", "time": 7372.79, "timestamp": "02:02:52", "text": "其实没那么辣。它有那种温暖的感觉"}, {"type": "subtitle", "time": 7375.43, "timestamp": "02:02:55", "text": "对此有所感觉。它就像甜菜根。绝不"}, {"type": "subtitle", "time": 7377.109, "timestamp": "02:02:57", "text": "头脑。我讨厌甜菜根。我不想"}, {"type": "subtitle", "time": 7379.99, "timestamp": "02:02:59", "text": "不再刷牙了。刷子。刷子。你没有"}]
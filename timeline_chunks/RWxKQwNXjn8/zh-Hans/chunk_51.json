[{"type": "subtitle", "time": 3062.069, "timestamp": "00:51:02", "text": "被一个令人毛骨悚然的笑话杀死了。"}, {"type": "subtitle", "time": 3064.15, "timestamp": "00:51:04", "text": "哇。这些人，他们不断地带来"}, {"type": "subtitle", "time": 3081.43, "timestamp": "00:51:21", "text": "我写下了英文感受记录。我不"}, {"type": "subtitle", "time": 3084.71, "timestamp": "00:51:24", "text": "在乎吗？你们这些人太坏了。"}, {"type": "subtitle", "time": 3086.79, "timestamp": "00:51:26", "text": "男生真坏。谢谢你，卖面包的。"}, {"type": "subtitle", "time": 3090.39, "timestamp": "00:51:30", "text": "谢谢您善待我的孩子。我"}, {"type": "subtitle", "time": 3102.15, "timestamp": "00:51:42", "text": "[音乐]"}, {"type": "subtitle", "time": 3104.39, "timestamp": "00:51:44", "text": "好了，现在我们要像这样慢跑。"}, {"type": "subtitle", "time": 3107.27, "timestamp": "00:51:47", "text": "我们将添加一些配件"}, {"type": "subtitle", "time": 3109.829, "timestamp": "00:51:49", "text": "哦，我们应该那样做。哦，我"}, {"type": "subtitle", "time": 3111.75, "timestamp": "00:51:51", "text": "我们以为我们在做一只熊猫。熊猫。"}, {"type": "subtitle", "time": 3113.43, "timestamp": "00:51:53", "text": "好的。哦，不。不，等等。这是你的"}, {"type": "subtitle", "time": 3116.15, "timestamp": "00:51:56", "text": "第一个儿子。这是你的第一个角色形象。"}]
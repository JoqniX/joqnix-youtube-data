[{"type": "subtitle", "time": 17706.948, "timestamp": "04:55:06", "text": "你能想象自己把自己炸死吗？"}, {"type": "subtitle", "time": 17709.83, "timestamp": "04:55:09", "text": "拆除炸弹之后呢？"}, {"type": "subtitle", "time": 17713.59, "timestamp": "04:55:13", "text": "我想看看会发生什么。是的。"}, {"type": "subtitle", "time": 17715.75, "timestamp": "04:55:15", "text": "好的。"}, {"type": "subtitle", "time": 17719.11, "timestamp": "04:55:19", "text": "下一颗炸弹。不。或者你想做一件事"}, {"type": "subtitle", "time": 17722.15, "timestamp": "04:55:22", "text": "步？去做。好的。将会有四个"}, {"type": "subtitle", "time": 17725.75, "timestamp": "04:55:25", "text": "模块。哦，这次你是最棒的"}, {"type": "subtitle", "time": 17728.39, "timestamp": "04:55:28", "text": "一。第一。"}, {"type": "subtitle", "time": 17731.67, "timestamp": "04:55:31", "text": "41秒。好的。其实并不重要。"}, {"type": "subtitle", "time": 17733.91, "timestamp": "04:55:33", "text": "你好。我们开始了。"}, {"type": "subtitle", "time": 17748.47, "timestamp": "04:55:48", "text": "好的。我看到一个符号。符号。"}, {"type": "subtitle", "time": 17751.99, "timestamp": "04:55:51", "text": "呃，迷宫。呃，就是那个数字LED指示灯和"}, {"type": "subtitle", "time": 17753.51, "timestamp": "04:55:53", "text": "电线。"}, {"type": "subtitle", "time": 17755.43, "timestamp": "04:55:55", "text": "我们先从简单的开始吧。好的。"}, {"type": "subtitle", "time": 17758.628, "timestamp": "04:55:58", "text": "我们来做电线吧。电线。四根电线。"}]
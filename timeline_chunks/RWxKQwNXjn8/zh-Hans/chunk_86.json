[{"type": "subtitle", "time": 5160.07, "timestamp": "01:26:00", "text": "没关系，乔。没关系。"}, {"type": "subtitle", "time": 5171.03, "timestamp": "01:26:11", "text": "眼睛到底该怎么画？我不明白"}, {"type": "subtitle", "time": 5173.27, "timestamp": "01:26:13", "text": "它。坚持，稍等。坚持，稍等。我会帮忙的"}, {"type": "subtitle", "time": 5184.709, "timestamp": "01:26:24", "text": "哇，真漂亮。"}, {"type": "subtitle", "time": 5198.95, "timestamp": "01:26:38", "text": "[音乐]"}, {"type": "subtitle", "time": 5202.149, "timestamp": "01:26:42", "text": "鱼狗。我得做鱼，对吧？"}, {"type": "subtitle", "time": 5205.83, "timestamp": "01:26:45", "text": "好的。呃，你真是个闪亮的新星！"}]
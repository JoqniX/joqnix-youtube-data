[{"type": "subtitle", "time": 1801.83, "timestamp": "00:30:01", "text": "所以，我们画了一个圆圈来讨论。好的。呃，让我"}, {"type": "subtitle", "time": 1810.389, "timestamp": "00:30:10", "text": "如何增大尺寸？"}, {"type": "subtitle", "time": 1813.35, "timestamp": "00:30:13", "text": "橡皮？"}, {"type": "subtitle", "time": 1817.59, "timestamp": "00:30:17", "text": "是的，它应该像这样开启"}, {"type": "subtitle", "time": 1824.149, "timestamp": "00:30:24", "text": "我们要画一个圆。那是"}, {"type": "subtitle", "time": 1826.95, "timestamp": "00:30:26", "text": "将成为你的脸。"}, {"type": "subtitle", "time": 1828.95, "timestamp": "00:30:28", "text": "听起来像个运动员。你知道，我们来做"}, {"type": "subtitle", "time": 1831.59, "timestamp": "00:30:31", "text": "他是熊猫。我们要把他变成一只熊猫。"}, {"type": "subtitle", "time": 1833.59, "timestamp": "00:30:33", "text": "好的。"}, {"type": "subtitle", "time": 1835.59, "timestamp": "00:30:35", "text": "没关系，乔。如果"}, {"type": "subtitle", "time": 1838.789, "timestamp": "00:30:38", "text": "他们很刻薄。你非常……他们是"}, {"type": "subtitle", "time": 1842.23, "timestamp": "00:30:42", "text": "强的。是的。"}, {"type": "subtitle", "time": 1844.389, "timestamp": "00:30:44", "text": "我不知道。等等，乔，你看过吗？"}, {"type": "subtitle", "time": 1858.47, "timestamp": "00:30:58", "text": "你懂这个笑话。你一定可以的。哦"}]
[{"type": "subtitle", "time": 8040.47, "timestamp": "02:14:00", "text": "首先。"}, {"type": "subtitle", "time": 8042.149, "timestamp": "02:14:02", "text": "你不应该使用腰果酱。"}, {"type": "subtitle", "time": 8053.35, "timestamp": "02:14:13", "text": "如果你想缓解紧张情绪"}, {"type": "subtitle", "time": 8056.95, "timestamp": "02:14:16", "text": "香料。他还加了该死的芒果酸辣酱"}, {"type": "subtitle", "time": 8064.31, "timestamp": "02:14:24", "text": "是的。"}, {"type": "subtitle", "time": 8067.589, "timestamp": "02:14:27", "text": "哦，你不应该加芒果。"}, {"type": "subtitle", "time": 8069.27, "timestamp": "02:14:29", "text": "用酸辣酱搭配黄油鸡。那是一个"}, {"type": "subtitle", "time": 8073.03, "timestamp": "02:14:33", "text": "完全是两码事。"}, {"type": "subtitle", "time": 8076.149, "timestamp": "02:14:36", "text": "顶部撒上少许香菜。而那"}, {"type": "subtitle", "time": 8079.189, "timestamp": "02:14:39", "text": "这将是一道美味的咖喱。"}, {"type": "subtitle", "time": 8082.87, "timestamp": "02:14:42", "text": "那是他们不知道的。"}, {"type": "subtitle", "time": 8085.75, "timestamp": "02:14:45", "text": "它会因为某种原因夺走你的卵子。"}, {"type": "subtitle", "time": 8089.589, "timestamp": "02:14:49", "text": "我猜的。该死。无味"}, {"type": "subtitle", "time": 8095.189, "timestamp": "02:14:55", "text": "汤其实就是水。那只是水。"}, {"type": "subtitle", "time": 8097.35, "timestamp": "02:14:57", "text": "那只是水，里面有一些像块状物一样的东西"}]
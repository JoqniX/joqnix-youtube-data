[{"type": "subtitle", "time": 1203.669, "timestamp": "00:20:03", "text": "不仅仅是米饭。如果晚上"}, {"type": "subtitle", "time": 1205.43, "timestamp": "00:20:05", "text": "房子里什么都没有，我会的"}, {"type": "subtitle", "time": 1209.19, "timestamp": "00:20:09", "text": "比如，“好了，又到了吃午饭的时间了。”"}, {"type": "subtitle", "time": 1211.75, "timestamp": "00:20:11", "text": "我的天哪，乔，你知道，你需要好起来。"}, {"type": "subtitle", "time": 1213.59, "timestamp": "00:20:13", "text": "好的。即使你想吃得健康，你"}, {"type": "subtitle", "time": 1216.549, "timestamp": "00:20:16", "text": "可以像你一样，可以像某些人一样"}, {"type": "subtitle", "time": 1219.909, "timestamp": "00:20:19", "text": "其他事情。是什么？"}, {"type": "subtitle", "time": 1222.07, "timestamp": "00:20:22", "text": "我不知道为什么感觉好像如果我"}, {"type": "subtitle", "time": 1224.39, "timestamp": "00:20:24", "text": "别吃米饭，我的肚子感觉不舒服。"}, {"type": "subtitle", "time": 1226.39, "timestamp": "00:20:26", "text": "满了之类的。我不知道。它"}, {"type": "subtitle", "time": 1229.99, "timestamp": "00:20:29", "text": "就像那一刻一样。即使我吃"}, {"type": "subtitle", "time": 1235.59, "timestamp": "00:20:35", "text": "面条，感觉就像，是啊，不够。"}, {"type": "subtitle", "time": 1238.149, "timestamp": "00:20:38", "text": "那种东西。而且，我吃得也少了。"}, {"type": "subtitle", "time": 1241.43, "timestamp": "00:20:41", "text": "所以，还有这方面的原因。那真是太多了。"}, {"type": "subtitle", "time": 1244.23, "timestamp": "00:20:44", "text": "正确的？问：我想让你知道这是"}, {"type": "subtitle", "time": 1247.909, "timestamp": "00:20:47", "text": "即使对亚洲来说也不正常。并非如此"}, {"type": "subtitle", "time": 1256.149, "timestamp": "00:20:56", "text": "它不是。我以为大家都这么做。"}, {"type": "subtitle", "time": 1259.43, "timestamp": "00:20:59", "text": "不开玩笑。好的。是的。人们喜欢米饭"}]
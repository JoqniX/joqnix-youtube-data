[{"type": "subtitle", "time": 3189.91, "timestamp": "00:53:09", "text": "很多配件。"}, {"type": "subtitle", "time": 3192.069, "timestamp": "00:53:12", "text": "必须相信过程。这一切都与……有关"}, {"type": "subtitle", "time": 3194.95, "timestamp": "00:53:14", "text": "相信过程。每个主要"}, {"type": "subtitle", "time": 3197.589, "timestamp": "00:53:17", "text": "你必须学习的关于画慢跑的事情"}, {"type": "subtitle", "time": 3199.109, "timestamp": "00:53:19", "text": "你他妈的到底在干什么？"}, {"type": "subtitle", "time": 3201.43, "timestamp": "00:53:21", "text": "我刚才做了什么？试着用我的小动物"}, {"type": "subtitle", "time": 3204.15, "timestamp": "00:53:24", "text": "快捷方式。那就是你必须信任……"}, {"type": "subtitle", "time": 3206.95, "timestamp": "00:53:26", "text": "过程。一旦你信任这个过程，"}, {"type": "subtitle", "time": 3210.79, "timestamp": "00:53:30", "text": "你做的每一件事都会变得有意义。"}, {"type": "subtitle", "time": 3220.15, "timestamp": "00:53:40", "text": "为什么我感觉自己像穿上了盔甲？"}, {"type": "subtitle", "time": 3227.589, "timestamp": "00:53:47", "text": "一切都很好。它的读数是"}, {"type": "subtitle", "time": 3233.109, "timestamp": "00:53:53", "text": "好的，稍等。我做错了什么。"}, {"type": "subtitle", "time": 3234.95, "timestamp": "00:53:54", "text": "就让我来控制这件事吧。 Z"}, {"type": "subtitle", "time": 3237.91, "timestamp": "00:53:57", "text": "控制 Z 控制 Z 控制 Z。我不能"}]
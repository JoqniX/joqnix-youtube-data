[{"type": "subtitle", "time": 9780.15, "timestamp": "02:43:00", "text": "这是聊天界面。他们是邪恶的。它是"}, {"type": "subtitle", "time": 9783.349, "timestamp": "02:43:03", "text": "恶意聊天。"}, {"type": "subtitle", "time": 9787.91, "timestamp": "02:43:07", "text": "聊天是邪恶的。"}, {"type": "subtitle", "time": 9796.71, "timestamp": "02:43:16", "text": "新时代起源于非洲的埃及。好的。"}, {"type": "subtitle", "time": 9800.79, "timestamp": "02:43:20", "text": "我对此并不知情。太疯狂了。"}, {"type": "subtitle", "time": 9803.67, "timestamp": "02:43:23", "text": "哇。我们了解到，未被腐蚀。是的。"}, {"type": "subtitle", "time": 9806.15, "timestamp": "02:43:26", "text": "白垩非常纯净。"}, {"type": "subtitle", "time": 9808.389, "timestamp": "02:43:28", "text": "Chalk是个小天使。让我画"}, {"type": "subtitle", "time": 9810.469, "timestamp": "02:43:30", "text": "粉笔。天使。"}, {"type": "subtitle", "time": 9821.75, "timestamp": "02:43:41", "text": "[音乐]"}, {"type": "subtitle", "time": 9823.429, "timestamp": "02:43:43", "text": "你需要创建一个头像。"}, {"type": "subtitle", "time": 9826.54, "timestamp": "02:43:46", "text": "哦，你们还没有吉祥物呢。"}, {"type": "subtitle", "time": 9829.59, "timestamp": "02:43:49", "text": "[音乐]"}, {"type": "subtitle", "time": 9831.75, "timestamp": "02:43:51", "text": "M：你需要……我没有吉祥物"}, {"type": "subtitle", "time": 9834.71, "timestamp": "02:43:54", "text": "然而。我没有把它们当作吉祥物。看"}]
[{"type": "subtitle", "time": 4380.31, "timestamp": "01:13:00", "text": "你想写的yahi也写"}, {"type": "subtitle", "time": 4383.83, "timestamp": "01:13:03", "text": "百合百合也很重要。"}, {"type": "subtitle", "time": 4386.229, "timestamp": "01:13:06", "text": "我用K制作了一个铁质的超级尤里"}, {"type": "subtitle", "time": 4389.27, "timestamp": "01:13:09", "text": "还有塞莱斯特。我想我可能见过"}, {"type": "subtitle", "time": 4391.27, "timestamp": "01:13:11", "text": "它。"}, {"type": "subtitle", "time": 4396.229, "timestamp": "01:13:16", "text": "我不知道我做了什么表情，但他们"}, {"type": "subtitle", "time": 4398.709, "timestamp": "01:13:18", "text": "不播放。是的。"}, {"type": "subtitle", "time": 4401.43, "timestamp": "01:13:21", "text": "是我发的帖子 Yahi"}, {"type": "subtitle", "time": 4403.189, "timestamp": "01:13:23", "text": "在我的推特上。它就在那里。没错"}, {"type": "subtitle", "time": 4415.669, "timestamp": "01:13:35", "text": "乔，你会喵喵叫吗？"}, {"type": "subtitle", "time": 4418.87, "timestamp": "01:13:38", "text": "嗯，我想我不知道。"}, {"type": "subtitle", "time": 4421.51, "timestamp": "01:13:41", "text": "快点。试着引导你的内心"}, {"type": "subtitle", "time": 4424.76, "timestamp": "01:13:44", "text": "猫。快点。"}, {"type": "subtitle", "time": 4435.75, "timestamp": "01:13:55", "text": "这就是动物发出声音来扫描你的方式吗？"}, {"type": "subtitle", "time": 4437.99, "timestamp": "01:13:57", "text": "制作？"}]
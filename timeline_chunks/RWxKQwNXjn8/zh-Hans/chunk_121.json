[{"type": "subtitle", "time": 7260.229, "timestamp": "02:01:00", "text": "太天真了。我会把富士山称为富士山。"}, {"type": "subtitle", "time": 7263.99, "timestamp": "02:01:03", "text": "臭。但就像你一样，当你你你你"}, {"type": "subtitle", "time": 7266.629, "timestamp": "02:01:06", "text": "和亲近的人开玩笑地欺负他们。"}, {"type": "subtitle", "time": 7268.229, "timestamp": "02:01:08", "text": "和。"}, {"type": "subtitle", "time": 7271.03, "timestamp": "02:01:11", "text": "哦，这有点像是一个标志"}, {"type": "subtitle", "time": 7272.95, "timestamp": "02:01:12", "text": "就像特写镜头，你知道的"}, {"type": "subtitle", "time": 7276.55, "timestamp": "02:01:16", "text": "彼此相处融洽。"}, {"type": "subtitle", "time": 7278.31, "timestamp": "02:01:18", "text": "这就是为什么有人喜欢欺凌别人。"}, {"type": "subtitle", "time": 7280.629, "timestamp": "02:01:20", "text": "而且看到你知道这一点也很有趣。"}, {"type": "subtitle", "time": 7282.629, "timestamp": "02:01:22", "text": "愚蠢的反应。这就是为什么人们"}, {"type": "subtitle", "time": 7284.79, "timestamp": "02:01:24", "text": "欺负。"}, {"type": "subtitle", "time": 7286.95, "timestamp": "02:01:26", "text": "这就是为什么人们有时会成为朋友的原因吗？"}, {"type": "subtitle", "time": 7290.149, "timestamp": "02:01:30", "text": "戏弄之类的？是的，是的，是的"}, {"type": "subtitle", "time": 7299.03, "timestamp": "02:01:39", "text": "我的天啊。另外，非常感谢。"}, {"type": "subtitle", "time": 7300.55, "timestamp": "02:01:40", "text": "补充水分，谢谢你的加油小便。"}, {"type": "subtitle", "time": 7302.55, "timestamp": "02:01:42", "text": "戈尔。我会补充水分，但我感觉不到。"}, {"type": "subtitle", "time": 7305.589, "timestamp": "02:01:45", "text": "就好像我不会小便一样。不。"}, {"type": "subtitle", "time": 7311.189, "timestamp": "02:01:51", "text": "祝你晚餐准备顺利。饺子"}, {"type": "subtitle", "time": 7314.149, "timestamp": "02:01:54", "text": "配上红肉汤听起来不错。"}, {"type": "subtitle", "time": 7318.95, "timestamp": "02:01:58", "text": "送一些过来。我的天啊。红兄弟。"}]
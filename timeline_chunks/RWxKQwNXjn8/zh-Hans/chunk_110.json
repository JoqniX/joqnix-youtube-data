[{"type": "subtitle", "time": 6601.03, "timestamp": "01:50:01", "text": "我见过新款吗？我不认为"}, {"type": "subtitle", "time": 6605.51, "timestamp": "01:50:05", "text": "我有。哦，你真的做到了。我认为"}, {"type": "subtitle", "time": 6609.59, "timestamp": "01:50:09", "text": "我记性很差。"}, {"type": "subtitle", "time": 6612.79, "timestamp": "01:50:12", "text": "我的记性很差。"}, {"type": "subtitle", "time": 6615.27, "timestamp": "01:50:15", "text": "我还需要继续完善我的新模型。"}, {"type": "subtitle", "time": 6617.83, "timestamp": "01:50:17", "text": "我分心了。"}, {"type": "subtitle", "time": 6619.99, "timestamp": "01:50:19", "text": "哦。"}, {"type": "subtitle", "time": 6622.629, "timestamp": "01:50:22", "text": "自从我上次更新以来，它就一直在更新。"}, {"type": "subtitle", "time": 6626.79, "timestamp": "01:50:26", "text": "我觉得我分享了一点时间。"}, {"type": "subtitle", "time": 6630.629, "timestamp": "01:50:30", "text": "我的天哪，太漂亮了。"}, {"type": "subtitle", "time": 6632.709, "timestamp": "01:50:32", "text": "等等，你还没看到……我想我问过"}, {"type": "subtitle", "time": 6635.03, "timestamp": "01:50:35", "text": "你。是的。是的。你觉得我觉得你"}, {"type": "subtitle", "time": 6639.27, "timestamp": "01:50:39", "text": "看过吗？我可能忘了。我 你"}, {"type": "subtitle", "time": 6640.629, "timestamp": "01:50:40", "text": "可能确实给我看过，我只是"}, {"type": "subtitle", "time": 6642.629, "timestamp": "01:50:42", "text": "忘了。就像我说的，我有很多破事。"}, {"type": "subtitle", "time": 6645.81, "timestamp": "01:50:45", "text": "记忆。我的天啊。开玩笑。狂热粉丝。"}, {"type": "subtitle", "time": 6647.75, "timestamp": "01:50:47", "text": "[音乐]"}, {"type": "subtitle", "time": 6652.229, "timestamp": "01:50:52", "text": "狂热的体育迷。科迪，别再给那个多余的粉丝添堵了。"}, {"type": "subtitle", "time": 6656.55, "timestamp": "01:50:56", "text": "什么？我不知道。你是什​​么意思？"}]
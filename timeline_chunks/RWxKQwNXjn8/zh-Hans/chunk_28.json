[{"type": "subtitle", "time": 1686.87, "timestamp": "00:28:06", "text": "好的。什么品种的熊？我其实"}, {"type": "subtitle", "time": 1690.47, "timestamp": "00:28:10", "text": "不知道。我的天啊。嗯，你说什么？"}, {"type": "subtitle", "time": 1693.75, "timestamp": "00:28:13", "text": "你觉得什么最适合我"}, {"type": "subtitle", "time": 1696.07, "timestamp": "00:28:16", "text": "为你？"}, {"type": "subtitle", "time": 1698.47, "timestamp": "00:28:18", "text": "嗯？"}, {"type": "subtitle", "time": 1700.63, "timestamp": "00:28:20", "text": "我觉得我们可以把你变成一只熊猫。我们"}, {"type": "subtitle", "time": 1703.83, "timestamp": "00:28:23", "text": "能让你喜欢上熊猫宝宝。哦，是的。"}, {"type": "subtitle", "time": 1706.789, "timestamp": "00:28:26", "text": "熊猫图案的不错。开始画画。哦"}, {"type": "subtitle", "time": 1711.029, "timestamp": "00:28:31", "text": "我的上帝。查克，那是你画的吗？一个"}, {"type": "subtitle", "time": 1714.07, "timestamp": "00:28:34", "text": "我不知道。我会画熊猫。所以我尝试"}, {"type": "subtitle", "time": 1716.23, "timestamp": "00:28:36", "text": "我尽力了。"}, {"type": "subtitle", "time": 1718.63, "timestamp": "00:28:38", "text": "好的。好的。我们正在把乔变成一个"}, {"type": "subtitle", "time": 1720.389, "timestamp": "00:28:40", "text": "熊猫。我的意思是，你被咬到了。"}, {"type": "subtitle", "time": 1722.31, "timestamp": "00:28:42", "text": "已经，"}, {"type": "subtitle", "time": 1724.71, "timestamp": "00:28:44", "text": "正确的？所以，你知道，我们已经走了一半了。"}, {"type": "subtitle", "time": 1726.23, "timestamp": "00:28:46", "text": "那里。"}, {"type": "subtitle", "time": 1727.83, "timestamp": "00:28:47", "text": "[音乐]"}, {"type": "subtitle", "time": 1730.149, "timestamp": "00:28:50", "text": "好的。所以，要画一只熊慢跑，我们……"}, {"type": "subtitle", "time": 1734.07, "timestamp": "00:28:54", "text": "首先画一个圆。"}, {"type": "subtitle", "time": 1736.789, "timestamp": "00:28:56", "text": "我要换个颜色。我更喜欢"}, {"type": "subtitle", "time": 1739.75, "timestamp": "00:28:59", "text": "按照这个轮廓画出来。"}]
[{"type": "subtitle", "time": 4153.189, "timestamp": "01:09:13", "text": "我不在乎。我没有对乔克进行精神操控。"}, {"type": "subtitle", "time": 4154.63, "timestamp": "01:09:14", "text": "你们根本就没给我提供任何信息。"}, {"type": "subtitle", "time": 4157.59, "timestamp": "01:09:17", "text": "什么？我的"}, {"type": "subtitle", "time": 4159.749, "timestamp": "01:09:19", "text": "哇？"}, {"type": "subtitle", "time": 4161.99, "timestamp": "01:09:21", "text": "医生，你读过那个铁人油管博主的文章吗？"}, {"type": "subtitle", "time": 4164.87, "timestamp": "01:09:24", "text": "Kyra写的同人小说？"}, {"type": "subtitle", "time": 4175.189, "timestamp": "01:09:35", "text": "所以，Kyra，嗯，我们当时在放松，对吧？"}, {"type": "subtitle", "time": 4178.47, "timestamp": "01:09:38", "text": "我们当时正在放松，哈拉斯和阿里斯"}, {"type": "subtitle", "time": 4180.87, "timestamp": "01:09:40", "text": "战斗一切如常。于是，凯拉写道"}, {"type": "subtitle", "time": 4188.55, "timestamp": "01:09:48", "text": "你没读过吗？没有。我有"}, {"type": "subtitle", "time": 4189.99, "timestamp": "01:09:49", "text": "不是。"}, {"type": "subtitle", "time": 4193.99, "timestamp": "01:09:53", "text": "好的，我来帮你拿。"}, {"type": "subtitle", "time": 4197.43, "timestamp": "01:09:57", "text": "领主怒不可遏，他面对着"}]
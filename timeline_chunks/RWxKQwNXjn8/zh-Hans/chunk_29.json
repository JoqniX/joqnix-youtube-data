[{"type": "subtitle", "time": 1744.07, "timestamp": "00:29:04", "text": "等等，不对，不是这个。还有一些"}, {"type": "subtitle", "time": 1747.75, "timestamp": "00:29:07", "text": "就像黑白一样。好的。"}, {"type": "subtitle", "time": 1750.23, "timestamp": "00:29:10", "text": "好的。我们要画一幅海浪图。"}, {"type": "subtitle", "time": 1751.909, "timestamp": "00:29:11", "text": "文化。"}, {"type": "subtitle", "time": 1753.59, "timestamp": "00:29:13", "text": "你可以在这边画画。"}, {"type": "subtitle", "time": 1755.269, "timestamp": "00:29:15", "text": "我在这边画。你画了那个"}, {"type": "subtitle", "time": 1756.95, "timestamp": "00:29:16", "text": "边。我们将尝试画画"}, {"type": "subtitle", "time": 1759.029, "timestamp": "00:29:19", "text": "一起。"}, {"type": "subtitle", "time": 1761.43, "timestamp": "00:29:21", "text": "是的。"}, {"type": "subtitle", "time": 1764.389, "timestamp": "00:29:24", "text": "让我变得如此懒惰。如果不是人类，那就是他们"}, {"type": "subtitle", "time": 1766.31, "timestamp": "00:29:26", "text": "不会存在。他们太懒了"}, {"type": "subtitle", "time": 1769.029, "timestamp": "00:29:29", "text": "砰。没错。没错。"}, {"type": "subtitle", "time": 1770.789, "timestamp": "00:29:30", "text": "有时候，面板就是不工作。"}, {"type": "subtitle", "time": 1772.95, "timestamp": "00:29:32", "text": "甚至，你知道，还能繁衍后代。他们只是"}, {"type": "subtitle", "time": 1778.549, "timestamp": "00:29:38", "text": "决定不这么做。熊猫真是疯了。"}, {"type": "subtitle", "time": 1780.47, "timestamp": "00:29:40", "text": "哦，他们会说，如果我开启了这种模式，"}, {"type": "subtitle", "time": 1782.71, "timestamp": "00:29:42", "text": "我会呃，用我的模式进行交配，或者"}, {"type": "subtitle", "time": 1790.789, "timestamp": "00:29:50", "text": "我不知道该怎么跟你解释。"}, {"type": "subtitle", "time": 1793.669, "timestamp": "00:29:53", "text": "愚蠢的熊猫有时确实很愚蠢。他们很棒。我"}, {"type": "subtitle", "time": 1796.47, "timestamp": "00:29:56", "text": "爱他们。"}, {"type": "subtitle", "time": 1798.149, "timestamp": "00:29:58", "text": "好的。"}]
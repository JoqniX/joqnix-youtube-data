[{"type": "subtitle", "time": 10440.87, "timestamp": "02:54:00", "text": "真是太烦人了，因为我总是最后"}, {"type": "subtitle", "time": 10443.269, "timestamp": "02:54:03", "text": "忘记擦眼镜了，然后"}, {"type": "subtitle", "time": 10446.65, "timestamp": "02:54:06", "text": "反正一切都变得模糊不清了。"}, {"type": "subtitle", "time": 10448.55, "timestamp": "02:54:08", "text": "[音乐]"}, {"type": "subtitle", "time": 10460.23, "timestamp": "02:54:20", "text": "我的天哪，都快午夜了。上帝"}, {"type": "subtitle", "time": 10468.07, "timestamp": "02:54:28", "text": "Chalk，你什么时候睡觉？你们是"}, {"type": "subtitle", "time": 10471.99, "timestamp": "02:54:31", "text": "你到底什么时候睡觉？"}, {"type": "subtitle", "time": 10474.95, "timestamp": "02:54:34", "text": "睡觉？呃，最近我一直在睡觉"}, {"type": "subtitle", "time": 10478.15, "timestamp": "02:54:38", "text": "就像在深夜"}, {"type": "subtitle", "time": 10481.91, "timestamp": "02:54:41", "text": "凌晨5点 凌晨6点 凌晨5:00 凌晨6点 不是"}, {"type": "subtitle", "time": 10484.309, "timestamp": "02:54:44", "text": "迟到了，你"}, {"type": "subtitle", "time": 10488.469, "timestamp": "02:54:48", "text": "已经变成了夜行性动物。我的天啊。呃"}, {"type": "subtitle", "time": 10492.389, "timestamp": "02:54:52", "text": "因为合作之类的原因。我的天啊。"}, {"type": "subtitle", "time": 10494.469, "timestamp": "02:54:54", "text": "昨天午夜进行了一次合作。"}, {"type": "subtitle", "time": 10497.11, "timestamp": "02:54:57", "text": "是啊，就像人们醒来的时候一样"}, {"type": "subtitle", "time": 10498.63, "timestamp": "02:54:58", "text": "向上。"}]
[{"type": "subtitle", "time": 3029.03, "timestamp": "00:50:29", "text": "呃，这里面有透明度吗？那里"}, {"type": "subtitle", "time": 3032.63, "timestamp": "00:50:32", "text": "不是。我认为那里"}, {"type": "subtitle", "time": 3034.15, "timestamp": "00:50:34", "text": "那里的人就像你身边的孩子一样。"}, {"type": "subtitle", "time": 3036.23, "timestamp": "00:50:36", "text": "杀。你竟敢提起我的死者"}, {"type": "subtitle", "time": 3038.15, "timestamp": "00:50:38", "text": "女儿？"}, {"type": "subtitle", "time": 3043.27, "timestamp": "00:50:43", "text": "什么？我的天啊。好的，说吧。我曾有过"}, {"type": "subtitle", "time": 3045.75, "timestamp": "00:50:45", "text": "有好几个女儿，好吗？他们"}, {"type": "subtitle", "time": 3048.549, "timestamp": "00:50:48", "text": "他们都在我的世界里死了。"}, {"type": "subtitle", "time": 3050.549, "timestamp": "00:50:50", "text": "哦，我的世界。好的。每一个"}, {"type": "subtitle", "time": 3052.549, "timestamp": "00:50:52", "text": "我在Minecraft里养的女儿一直"}, {"type": "subtitle", "time": 3054.23, "timestamp": "00:50:54", "text": "垂死。我也不知道，就像……"}, {"type": "subtitle", "time": 3056.23, "timestamp": "00:50:56", "text": "铁制的其中一个是服务器，对吧？喜欢"}, {"type": "subtitle", "time": 3058.95, "timestamp": "00:50:58", "text": "我们用的那台服务器，它坏了。她得到了"}]
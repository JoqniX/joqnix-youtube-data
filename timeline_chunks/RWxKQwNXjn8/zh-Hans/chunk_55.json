[{"type": "subtitle", "time": 3304.15, "timestamp": "00:55:04", "text": "好的。另外，还要确保你不会……"}, {"type": "subtitle", "time": 3305.589, "timestamp": "00:55:05", "text": "什么？你说什么？你在说什么？"}, {"type": "subtitle", "time": 3309.27, "timestamp": "00:55:09", "text": "关于？所以你不会因此而气馁"}, {"type": "subtitle", "time": 3310.47, "timestamp": "00:55:10", "text": "欣赏其他人的艺术作品。喜欢"}, {"type": "subtitle", "time": 3313.19, "timestamp": "00:55:13", "text": "中段。这些只是为了降低你的"}, {"type": "subtitle", "time": 3315.27, "timestamp": "00:55:15", "text": "动机。坏家伙。你是什​​么意思"}, {"type": "subtitle", "time": 3317.51, "timestamp": "00:55:17", "text": "坏朋友？哦，糟糕。我做了什么？"}, {"type": "subtitle", "time": 3319.43, "timestamp": "00:55:19", "text": "我为什么要置顶它？我为什么别针"}, {"type": "subtitle", "time": 3322.15, "timestamp": "00:55:22", "text": "那？我并非有意置顶。哎呀。"}, {"type": "subtitle", "time": 3323.91, "timestamp": "00:55:23", "text": "坚持，稍等。坚持，稍等。那就是你不是"}, {"type": "subtitle", "time": 3325.99, "timestamp": "00:55:25", "text": "那条信息不会被置顶。那不是"}, {"type": "subtitle", "time": 3327.75, "timestamp": "00:55:27", "text": "被压制。拉屎。到底发生了什么"}, {"type": "subtitle", "time": 3329.829, "timestamp": "00:55:29", "text": "我愿意？我到底做了什么？坚持，稍等，"}, {"type": "subtitle", "time": 3332.549, "timestamp": "00:55:32", "text": "乍得。我身上有擦伤。"}, {"type": "subtitle", "time": 3336.47, "timestamp": "00:55:36", "text": "嘿，乔亚，别着急。"}, {"type": "subtitle", "time": 3337.829, "timestamp": "00:55:37", "text": "好的，没事的。"}, {"type": "subtitle", "time": 3341.03, "timestamp": "00:55:41", "text": "一切都很好。一切都好。"}, {"type": "subtitle", "time": 3343.349, "timestamp": "00:55:43", "text": "好的。难的。难的。没关系。"}, {"type": "subtitle", "time": 3345.99, "timestamp": "00:55:45", "text": "没关系。嗯，是的。是的。做你的事"}, {"type": "subtitle", "time": 3353.43, "timestamp": "00:55:53", "text": "是的。我想问的是，那是什么？"}, {"type": "subtitle", "time": 3356.39, "timestamp": "00:55:56", "text": "你的名字灵感来自哪里？"}]
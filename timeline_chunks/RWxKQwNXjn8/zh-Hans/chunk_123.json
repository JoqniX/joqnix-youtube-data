[{"type": "subtitle", "time": 7382.55, "timestamp": "02:03:02", "text": "像甜菜根那样？"}, {"type": "subtitle", "time": 7385.189, "timestamp": "02:03:05", "text": "我不喜欢甜菜根。"}, {"type": "subtitle", "time": 7387.83, "timestamp": "02:03:07", "text": "就像我可以吃它，如果你像我一样的话"}, {"type": "subtitle", "time": 7391.03, "timestamp": "02:03:11", "text": "妈妈做的像甜菜根馅饼，"}, {"type": "subtitle", "time": 7394.07, "timestamp": "02:03:14", "text": "但我并不喜欢它。"}, {"type": "subtitle", "time": 7397.189, "timestamp": "02:03:17", "text": "七个索赔罐。是的。已兑换的罐子。"}, {"type": "subtitle", "time": 7399.75, "timestamp": "02:03:19", "text": "我可不是一只黏糊糊的癞蛤蟆。我只是个"}, {"type": "subtitle", "time": 7401.99, "timestamp": "02:03:21", "text": "罐装。"}, {"type": "subtitle", "time": 7410.149, "timestamp": "02:03:30", "text": "只是一个 f。美好的。我试试看。"}, {"type": "subtitle", "time": 7413.189, "timestamp": "02:03:33", "text": "我吃过一次，但我不喜欢甜菜根。"}, {"type": "subtitle", "time": 7415.35, "timestamp": "02:03:35", "text": "我一般不挑食。我只是"}, {"type": "subtitle", "time": 7421.99, "timestamp": "02:03:41", "text": "我只是训练我的身体去吃东西。"}, {"type": "subtitle", "time": 7424.149, "timestamp": "02:03:44", "text": "我不喜欢这样。那是"}, {"type": "subtitle", "time": 7426.31, "timestamp": "02:03:46", "text": "它。最后我非常喜欢它。你"}, {"type": "subtitle", "time": 7430.229, "timestamp": "02:03:50", "text": "基本上只吃米饭。乔，"}, {"type": "subtitle", "time": 7436.31, "timestamp": "02:03:56", "text": "我也不挑剔。所以，我吃"}, {"type": "subtitle", "time": 7439.27, "timestamp": "02:03:59", "text": "一切。"}]
[{"type": "subtitle", "time": 5284.229, "timestamp": "01:28:04", "text": "睫毛之类的小细节"}, {"type": "subtitle", "time": 5288.629, "timestamp": "01:28:08", "text": "或者你可以加一点眼部高光。"}, {"type": "subtitle", "time": 5290.229, "timestamp": "01:28:10", "text": "或者如果你画的是Q版人物，而且是……"}, {"type": "subtitle", "time": 5292.07, "timestamp": "01:28:12", "text": "彩色眼睛，所以不是黑色的，"}, {"type": "subtitle", "time": 5293.83, "timestamp": "01:28:13", "text": "你只需要使用颜色本身即可。"}, {"type": "subtitle", "time": 5297.82, "timestamp": "01:28:17", "text": "你想给它涂上颜色。"}, {"type": "subtitle", "time": 5299.59, "timestamp": "01:28:19", "text": "[音乐]"}, {"type": "subtitle", "time": 5310.709, "timestamp": "01:28:30", "text": "你想要像蓝色一样的东西"}, {"type": "subtitle", "time": 5326.39, "timestamp": "01:28:46", "text": "然后加入白色。和"}, {"type": "subtitle", "time": 5334.149, "timestamp": "01:28:54", "text": "共识是，真正的人只是在按按钮。"}]
[{"type": "subtitle", "time": 18600.788, "timestamp": "05:10:00", "text": "一二三，三下。"}, {"type": "subtitle", "time": 18601.99, "timestamp": "05:10:01", "text": "你不会问我哪里有"}, {"type": "subtitle", "time": 18605.03, "timestamp": "05:10:05", "text": "三角形是。"}, {"type": "subtitle", "time": 18608.07, "timestamp": "05:10:08", "text": "没关系，因为我知道这将是最……"}, {"type": "subtitle", "time": 18611.35, "timestamp": "05:10:11", "text": "很可能，最有可能的是，它会在"}, {"type": "subtitle", "time": 18616.23, "timestamp": "05:10:16", "text": "第二列。呃，最后一个。我猜"}, {"type": "subtitle", "time": 18617.91, "timestamp": "05:10:17", "text": "一定是这样。你为什么知道这一点？为什么"}, {"type": "subtitle", "time": 18621.03, "timestamp": "05:10:21", "text": "你知道吗？因为我也有过"}, {"type": "subtitle", "time": 18625.35, "timestamp": "05:10:25", "text": "同样的事情再次发生。真的吗？现在我们"}, {"type": "subtitle", "time": 18628.07, "timestamp": "05:10:28", "text": "做过。我相信。"}, {"type": "subtitle", "time": 18630.15, "timestamp": "05:10:30", "text": "好的，那我接受你的提议。"}, {"type": "subtitle", "time": 18632.628, "timestamp": "05:10:32", "text": "那。好吧，大概是这样。呃，三个都过去了，"}, {"type": "subtitle", "time": 18636.31, "timestamp": "05:10:36", "text": "正确的？你好。三个倒下了。"}, {"type": "subtitle", "time": 18640.31, "timestamp": "05:10:40", "text": "好的。一、二、三，然后向右"}, {"type": "subtitle", "time": 18645.59, "timestamp": "05:10:45", "text": "一。啊，是的。正确的。好了。完毕。"}, {"type": "subtitle", "time": 18648.15, "timestamp": "05:10:48", "text": "模块已完成。我们收到了模拟器。我们得到了"}, {"type": "subtitle", "time": 18651.03, "timestamp": "05:10:51", "text": "键盘、内存和按钮。"}, {"type": "subtitle", "time": 18654.948, "timestamp": "05:10:54", "text": "你好。我们来学习记忆。"}, {"type": "subtitle", "time": 18658.15, "timestamp": "05:10:58", "text": "好的。准备好了吗？记忆。是的。你准备好了吗？"}]
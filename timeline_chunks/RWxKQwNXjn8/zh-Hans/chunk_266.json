[{"type": "subtitle", "time": 15960.07, "timestamp": "04:26:00", "text": "下着小雨。"}, {"type": "subtitle", "time": 15963.429, "timestamp": "04:26:03", "text": "呃，你们有没有像我一样对待过你们？"}, {"type": "subtitle", "time": 15966.229, "timestamp": "04:26:06", "text": "我知道我为什么喜欢"}, {"type": "subtitle", "time": 15969.189, "timestamp": "04:26:09", "text": "我喜欢盯着看"}, {"type": "subtitle", "time": 15971.51, "timestamp": "04:26:11", "text": "有时下雨"}, {"type": "subtitle", "time": 15974.63, "timestamp": "04:26:14", "text": "因为它很好，你知道的。"}, {"type": "subtitle", "time": 15978.87, "timestamp": "04:26:18", "text": "只是盯着雨看，我不知道"}, {"type": "subtitle", "time": 15985.99, "timestamp": "04:26:25", "text": "我其实挺喜欢的。"}]
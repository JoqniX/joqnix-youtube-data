[{"type": "subtitle", "time": 7922.39, "timestamp": "02:12:02", "text": "你找到工作了吗？我正在关注。然后我"}, {"type": "subtitle", "time": 7925.35, "timestamp": "02:12:05", "text": "想要一个漂亮的大"}, {"type": "subtitle", "time": 7934.31, "timestamp": "02:12:14", "text": "姜"}, {"type": "subtitle", "time": 7937.75, "timestamp": "02:12:17", "text": "加盐和胡椒粉。什么叫疯狂"}, {"type": "subtitle", "time": 7947.189, "timestamp": "02:12:27", "text": "那是一只鸡。好的。鸡胸肉，"}, {"type": "subtitle", "time": 7950.629, "timestamp": "02:12:30", "text": "我猜也是。我不知道。开始得分"}, {"type": "subtitle", "time": 7960.39, "timestamp": "02:12:40", "text": "他把它放在那里，然后放"}, {"type": "subtitle", "time": 7973.35, "timestamp": "02:12:53", "text": "锅里加一点油"}, {"type": "subtitle", "time": 7976.629, "timestamp": "02:12:56", "text": "直接进入那种油里"}, {"type": "subtitle", "time": 7978.149, "timestamp": "02:12:58", "text": "金色的"}]
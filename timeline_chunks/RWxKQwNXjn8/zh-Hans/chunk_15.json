[{"type": "subtitle", "time": 901.269, "timestamp": "00:15:01", "text": "富士会选择中立"}, {"type": "subtitle", "time": 905.35, "timestamp": "00:15:05", "text": "我不知道为什么。为什么当我看到"}, {"type": "subtitle", "time": 908.15, "timestamp": "00:15:08", "text": "提到“中立”，我想到的是富士山。哦，我的"}, {"type": "subtitle", "time": 911.11, "timestamp": "00:15:11", "text": "上帝。是的。富士山 富士山 非常 富士山"}, {"type": "subtitle", "time": 913.11, "timestamp": "00:15:13", "text": "非常混乱中立。我觉得"}, {"type": "subtitle", "time": 915.43, "timestamp": "00:15:15", "text": "混乱中立。"}, {"type": "subtitle", "time": 924.31, "timestamp": "00:15:24", "text": "我觉得你要么不会，要么不会。"}, {"type": "subtitle", "time": 934.949, "timestamp": "00:15:34", "text": "乔，别着急，慢慢想。拿走你的"}, {"type": "subtitle", "time": 948.15, "timestamp": "00:15:48", "text": "嗯，我想我会选择守序中立。"}, {"type": "subtitle", "time": 950.069, "timestamp": "00:15:50", "text": "或许。"}, {"type": "subtitle", "time": 953.43, "timestamp": "00:15:53", "text": "嗯。哦，等等。我只能选择一个。"}, {"type": "subtitle", "time": 955.509, "timestamp": "00:15:55", "text": "哦，等等。什么？我以为我可以自己选择"}, {"type": "subtitle", "time": 957.509, "timestamp": "00:15:57", "text": "中立善良，守序，中立，混乱"}, {"type": "subtitle", "time": 959.509, "timestamp": "00:15:59", "text": "好的。"}]
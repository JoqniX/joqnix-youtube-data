[{"type": "subtitle", "time": 10742.07, "timestamp": "02:59:02", "text": "夜宵。我吃了米饭。"}, {"type": "subtitle", "time": 10744.63, "timestamp": "02:59:04", "text": "现在是米饭"}, {"type": "subtitle", "time": 10748.95, "timestamp": "02:59:08", "text": "开玩笑说，连零食都吃米饭。我当时"}, {"type": "subtitle", "time": 10763.269, "timestamp": "02:59:23", "text": "我想看看。好的。我的天啊。如果你"}, {"type": "subtitle", "time": 10766.389, "timestamp": "02:59:26", "text": "如果你不能留下，我们就走。"}, {"type": "subtitle", "time": 10769.03, "timestamp": "02:59:29", "text": "没关系。走吧。"}, {"type": "subtitle", "time": 10771.429, "timestamp": "02:59:31", "text": "好的。它的米饭很好吃。大米是"}, {"type": "subtitle", "time": 10773.59, "timestamp": "02:59:33", "text": "可口的。好吧，别误会我的意思，但是……"}, {"type": "subtitle", "time": 10776.95, "timestamp": "02:59:36", "text": "一天三餐都吃米饭"}, {"type": "subtitle", "time": 10781.19, "timestamp": "02:59:41", "text": "太多了。太过分了。哦，不。不。哦，"}, {"type": "subtitle", "time": 10785.269, "timestamp": "02:59:45", "text": "是的。我想，呃，午夜，就像……"}, {"type": "subtitle", "time": 10787.91, "timestamp": "02:59:47", "text": "呃，昨天午夜简直就像真的"}, {"type": "subtitle", "time": 10792.23, "timestamp": "02:59:52", "text": "早上7点。所以，我在那里吃了米饭，因为我"}, {"type": "subtitle", "time": 10794.71, "timestamp": "02:59:54", "text": "点餐方式像咖喱"}, {"type": "subtitle", "time": 10796.95, "timestamp": "02:59:56", "text": "咖喱端上来了，我当时就想：“哦”"}]
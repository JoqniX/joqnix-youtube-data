[{"type": "subtitle", "time": 1382.39, "timestamp": "00:23:02", "text": "是法国人。高级款。好的。嗯"}, {"type": "subtitle", "time": 1385.75, "timestamp": "00:23:05", "text": "甜点。我从来没吃过馅饼。我非常乐意"}, {"type": "subtitle", "time": 1387.75, "timestamp": "00:23:07", "text": "吃一块馅饼。"}, {"type": "subtitle", "time": 1390.31, "timestamp": "00:23:10", "text": "不，我从来没吃过馅饼。我需要 我需要"}, {"type": "subtitle", "time": 1392.31, "timestamp": "00:23:12", "text": "我需要你像绑架自己一样去"}, {"type": "subtitle", "time": 1395.83, "timestamp": "00:23:15", "text": "比如真的给你喂东西。"}, {"type": "chat", "time": 1400.694, "timestamp": "00:23:20", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "yoo thank god I ate before opening the stream"}, {"type": "subtitle", "time": 1401.59, "timestamp": "00:23:21", "text": "我喜欢。不，我得到的是一个纯洁无辜的人。他"}, {"type": "subtitle", "time": 1404.23, "timestamp": "00:23:24", "text": "我绝不会说“dick”（阴茎）这个词。"}, {"type": "subtitle", "time": 1406.789, "timestamp": "00:23:26", "text": "什么？别担心，乔。不"}, {"type": "subtitle", "time": 1409.909, "timestamp": "00:23:29", "text": "别担心。嗯"}, {"type": "subtitle", "time": 1412.71, "timestamp": "00:23:32", "text": "谢天谢地。谢天谢地我之前吃过东西了"}, {"type": "subtitle", "time": 1415.19, "timestamp": "00:23:35", "text": "打开这个。"}, {"type": "subtitle", "time": 1417.75, "timestamp": "00:23:37", "text": "我让你饿了吗？萨布说：“哦，我的"}, {"type": "subtitle", "time": 1420.63, "timestamp": "00:23:40", "text": "“上帝。”不过，欢迎来到你的直播间。"}, {"type": "subtitle", "time": 1423.27, "timestamp": "00:23:43", "text": "所以，我得到了熊。你很保护……"}, {"type": "subtitle", "time": 1425.909, "timestamp": "00:23:45", "text": "爱你的人都是善良有爱心的人。"}, {"type": "subtitle", "time": 1429.59, "timestamp": "00:23:49", "text": "哇。好的，我们要走了"}, {"type": "subtitle", "time": 1431.83, "timestamp": "00:23:51", "text": "把你变成熊。不是开玩笑。是"}, {"type": "subtitle", "time": 1434.789, "timestamp": "00:23:54", "text": "我要把你变成一只熊。哦，不是的"}, {"type": "subtitle"
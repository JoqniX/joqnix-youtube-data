[{"type": "subtitle", "time": 3720.23, "timestamp": "01:02:00", "text": "黑暗真让人头疼。好的。他是一个……"}, {"type": "subtitle", "time": 3732.47, "timestamp": "01:02:12", "text": "是的。我的天啊。那是 那是 那是"}, {"type": "subtitle", "time": 3736.39, "timestamp": "01:02:16", "text": "一只浑身湿透的熊猫。我告诉你妈妈。"}, {"type": "subtitle", "time": 3739.67, "timestamp": "01:02:19", "text": "你不认识我妈妈。你不了解我的"}, {"type": "subtitle", "time": 3741.75, "timestamp": "01:02:21", "text": "妈妈。"}, {"type": "subtitle", "time": 3746.23, "timestamp": "01:02:26", "text": "但阿尔克萨尔究竟多大了？老的。好的。我的上帝，"}, {"type": "subtitle", "time": 3749.589, "timestamp": "01:02:29", "text": "那好美丽。那真是太美了"}, {"type": "subtitle", "time": 3752.47, "timestamp": "01:02:32", "text": "工作。好工作。"}, {"type": "subtitle", "time": 3754.87, "timestamp": "01:02:34", "text": "黄金"}, {"type": "subtitle", "time": 3758.309, "timestamp": "01:02:38", "text": "我的天哪。我不知道。"}, {"type": "subtitle", "time": 3760.39, "timestamp": "01:02:40", "text": "这就是美。好工作，"}, {"type": "subtitle", "time": 3768.71, "timestamp": "01:02:48", "text": "我知道你用了我的颜色。我"}, {"type": "subtitle", "time": 3771.03, "timestamp": "01:02:51", "text": "他本来可以去的，也确实去了。我没有"}, {"type": "subtitle", "time": 3776.47, "timestamp": "01:02:56", "text": "我知道我本来可以做到。没关系。"}]
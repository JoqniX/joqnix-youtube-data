[{"type": "subtitle", "time": 17942.47, "timestamp": "04:59:02", "text": "你。如果没有你的帮助，我就不会……"}, {"type": "subtitle", "time": 17945.03, "timestamp": "04:59:05", "text": "是我做的。你是什​​么意思？不，你"}, {"type": "subtitle", "time": 17946.708, "timestamp": "04:59:06", "text": "你是拆弹专家。就是你"}, {"type": "subtitle", "time": 17948.55, "timestamp": "04:59:08", "text": "炸弹不足。我只是在这里"}, {"type": "subtitle", "time": 17950.47, "timestamp": "04:59:10", "text": "我手里拿着一本书，坐在那里，感觉就像……"}, {"type": "subtitle", "time": 17953.75, "timestamp": "04:59:13", "text": "头上顶着四个杯子。"}, {"type": "subtitle", "time": 17956.868, "timestamp": "04:59:16", "text": "不，真的是你。"}, {"type": "subtitle", "time": 17961.59, "timestamp": "04:59:21", "text": "你说的“可爱”是什么意思？我不可爱。"}, {"type": "subtitle", "time": 17970.55, "timestamp": "04:59:30", "text": "你想这么做吗？是的。好的。患病的"}, {"type": "subtitle", "time": 17972.15, "timestamp": "04:59:32", "text": "接下来轮到你担任扩散器。你可以成为"}, {"type": "subtitle", "time": 17975.03, "timestamp": "04:59:35", "text": "处理程序。"}, {"type": "subtitle", "time": 17977.83, "timestamp": "04:59:37", "text": "我们走吧。我要走一步。"}, {"type": "subtitle", "time": 17979.99, "timestamp": "04:59:39", "text": "也向上。"}, {"type": "subtitle", "time": 17981.99, "timestamp": "04:59:41", "text": "你好。"}, {"type": "subtitle", "time": 17983.43, "timestamp": "04:59:43", "text": "好的。收到后请告诉我。"}, {"type": "chat", "time": 17988.253, "timestamp": "04:59:48", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Joq's Activity State is Returing back to stream"}, {"type": "subtitle", "time": 17988.788, "timestamp": "04:59:48", "text": "手动启动。是的，我已经有了"}, {"type": "chat", "time": 17999.566, "timestamp": "04:59:59", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Joq's Activity State is Returing back to stream"}]
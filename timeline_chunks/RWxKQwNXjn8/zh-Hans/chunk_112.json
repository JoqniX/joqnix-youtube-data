[{"type": "subtitle", "time": 6727.43, "timestamp": "01:52:07", "text": "不。一旦你自由了，我就有"}, {"type": "subtitle", "time": 6729.51, "timestamp": "01:52:09", "text": "我有很多猫咪视频要展示。"}, {"type": "subtitle", "time": 6732.31, "timestamp": "01:52:12", "text": "你。我的天啊。耶。"}, {"type": "subtitle", "time": 6736.629, "timestamp": "01:52:16", "text": "是的。是的。请随意回答“是”。"}, {"type": "subtitle", "time": 6739.669, "timestamp": "01:52:19", "text": "我们需要，我们需要放置，我们需要坐下"}, {"type": "subtitle", "time": 6743.35, "timestamp": "01:52:23", "text": "你坐下来，像百万只猫一样看着。"}, {"type": "subtitle", "time": 6746.47, "timestamp": "01:52:26", "text": "视频。你错过了太多……"}, {"type": "subtitle", "time": 6754.79, "timestamp": "01:52:34", "text": "所以我们有太多愚蠢的东西了。"}, {"type": "subtitle", "time": 6758.07, "timestamp": "01:52:38", "text": "过去几天在 VC 上完成。"}, {"type": "subtitle", "time": 6760.07, "timestamp": "01:52:40", "text": "我的天啊。"}, {"type": "subtitle", "time": 6763.35, "timestamp": "01:52:43", "text": "嗯。哦，是的，你们都是所有人"}, {"type": "subtitle", "time": 6765.589, "timestamp": "01:52:45", "text": "我们现在所看到的时代，就是我们看到的时代。"}, {"type": "subtitle", "time": 6769.669, "timestamp": "01:52:49", "text": "他们。是的，我经常给别人发消息。"}, {"type": "subtitle", "time": 6772.07, "timestamp": "01:52:52", "text": "白天问问他们想不想玩"}, {"type": "subtitle", "time": 6778.629, "timestamp": "01:52:58", "text": "嘿，你们现在还玩那个游戏吗？哦，我"}]
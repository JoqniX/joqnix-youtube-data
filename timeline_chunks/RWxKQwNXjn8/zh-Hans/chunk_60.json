[{"type": "subtitle", "time": 3601.589, "timestamp": "01:00:01", "text": "哇。等等，你是说要那样做吗？"}, {"type": "subtitle", "time": 3604.549, "timestamp": "01:00:04", "text": "玻璃磨砂方法，就是画出它"}, {"type": "subtitle", "time": 3606.63, "timestamp": "01:00:06", "text": "一开始透明度很低，但后来你增加了透明度"}, {"type": "subtitle", "time": 3609.43, "timestamp": "01:00:09", "text": "不透明度。看起来真不错。"}, {"type": "subtitle", "time": 3612.309, "timestamp": "01:00:12", "text": "差不多是这样。我喜欢画画"}, {"type": "subtitle", "time": 3613.829, "timestamp": "01:00:13", "text": "大多。"}, {"type": "subtitle", "time": 3616.789, "timestamp": "01:00:16", "text": "啊，是的，我喜欢画我的"}, {"type": "subtitle", "time": 3618.95, "timestamp": "01:00:18", "text": "绘画就像绘画一样进行着"}, {"type": "subtitle", "time": 3620.95, "timestamp": "01:00:20", "text": "其中一个是上个房间里的海豹脑。"}, {"type": "subtitle", "time": 3624.63, "timestamp": "01:00:24", "text": "是的，我觉得你没明白我的意思。"}, {"type": "subtitle", "time": 3628.71, "timestamp": "01:00:28", "text": "当时正在用 RXR 直播 Bura"}, {"type": "subtitle", "time": 3631.19, "timestamp": "01:00:31", "text": "让我告诉你，我讨厌老古董。"}, {"type": "subtitle", "time": 3633.67, "timestamp": "01:00:33", "text": "人们在和他一起直播后都成了焦点。哦，我的"}, {"type": "subtitle", "time": 3637.589, "timestamp": "01:00:37", "text": "天啊，那小混蛋兄弟"}, {"type": "subtitle", "time": 3641.109, "timestamp": "01:00:41", "text": "我们是朋友，所以我可以……"}, {"type": "subtitle", "time": 3643.19, "timestamp": "01:00:43", "text": "嘲笑他。"}, {"type": "subtitle", "time": 3644.71, "timestamp": "01:00:44", "text": "H"}, {"type": "subtitle", "time": 3648.069, "timestamp": "01:00:48", "text": "我的天哪，我的脑细胞全没了。"}, {"type": "subtitle", "time": 3651.67, "timestamp": "01:00:51", "text": "玩那个游戏"}, {"type": "subtitle", "time": 3653.51, "timestamp": "01:00:53", "text": "我看到你也在玩，对吧？"}, {"type": "subtitle", "time": 3657.109, "timestamp": "01:00:57", "text": "你和Arthanx一起玩过吗？"}, {"type": "subtitle", "time": 3659.349, "timestamp": "01:00:59", "text": "一个"}]
[{"type": "subtitle", "time": 9725.03, "timestamp": "02:42:05", "text": "看起来像黑色的粘稠物之类的东西，"}, {"type": "subtitle", "time": 9726.63, "timestamp": "02:42:06", "text": "正确的？"}, {"type": "subtitle", "time": 9729.27, "timestamp": "02:42:09", "text": "是的。差不多就是这样。是的。"}, {"type": "subtitle", "time": 9732.15, "timestamp": "02:42:12", "text": "但它有生命，而且你正在前进。"}, {"type": "subtitle", "time": 9735.51, "timestamp": "02:42:15", "text": "是的。哇。是的。是，是，是"}, {"type": "subtitle", "time": 9739.03, "timestamp": "02:42:19", "text": "我内心深处的那种感觉"}, {"type": "subtitle", "time": 9752.389, "timestamp": "02:42:32", "text": "太疯狂了。不，我是指那只烧焦的狗。"}, {"type": "subtitle", "time": 9755.27, "timestamp": "02:42:35", "text": "我勒个去？我只是，我只是个黏糊糊的家伙"}, {"type": "subtitle", "time": 9759.429, "timestamp": "02:42:39", "text": "小家伙。你对我太坏了。"}, {"type": "subtitle", "time": 9761.11, "timestamp": "02:42:41", "text": "你知道我今天学到了什么吗？"}, {"type": "subtitle", "time": 9762.79, "timestamp": "02:42:42", "text": "直播聊天？我了解到你是"}, {"type": "subtitle", "time": 9770.79, "timestamp": "02:42:50", "text": "正确的。"}, {"type": "subtitle", "time": 9774.07, "timestamp": "02:42:54", "text": "所以，聊天，这就是聊天，"}, {"type": "subtitle", "time": 9776.87, "timestamp": "02:42:56", "text": "正确的？"}]
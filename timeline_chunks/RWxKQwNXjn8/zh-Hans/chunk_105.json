[{"type": "subtitle", "time": 6301.03, "timestamp": "01:45:01", "text": "他想成为他，他就是他，他要成为"}, {"type": "subtitle", "time": 6305.75, "timestamp": "01:45:05", "text": "他是个很酷的孩子。他是个叛逆者。"}, {"type": "subtitle", "time": 6308.629, "timestamp": "01:45:08", "text": "差不多就是这样。我最初可以说"}, {"type": "subtitle", "time": 6313.27, "timestamp": "01:45:13", "text": "我不想，我当时想，我不会，我不会"}, {"type": "subtitle", "time": 6316.149, "timestamp": "01:45:16", "text": "我会拥有，我不会把你的呃"}, {"type": "subtitle", "time": 6318.31, "timestamp": "01:45:18", "text": "把你的耳洞之类的东西都戴在我身上。"}, {"type": "subtitle", "time": 6322.47, "timestamp": "01:45:22", "text": "箭。我为什么不试试把那句话写出来呢？"}, {"type": "subtitle", "time": 6324.709, "timestamp": "01:45:24", "text": "这里？因为无论如何，它都是摩擦性的。"}, {"type": "subtitle", "time": 6335.35, "timestamp": "01:45:35", "text": "看看结果如何。"}, {"type": "subtitle", "time": 6336.95, "timestamp": "01:45:36", "text": "嗯。"}, {"type": "subtitle", "time": 6338.95, "timestamp": "01:45:38", "text": "这就是我赋予角色这个角色的原因之一。"}, {"type": "subtitle", "time": 6341.35, "timestamp": "01:45:41", "text": "一开始染发是因为我想要……"}, {"type": "subtitle", "time": 6344.39, "timestamp": "01:45:44", "text": "一直想染发"}, {"type": "subtitle", "time": 6345.669, "timestamp": "01:45:45", "text": "那时，最终到现在，我的确拥有"}, {"type": "subtitle", "time": 6347.109, "timestamp": "01:45:47", "text": "染发。我不，我的意思是不对。"}, {"type": "subtitle", "time": 6349.189, "timestamp": "01:45:49", "text": "现在因为我剪了头发，但我还是要走"}, {"type": "subtitle", "time": 6352.709, "timestamp": "01:45:52", "text": "再给它上色。"}, {"type": "subtitle", "time": 6355.43, "timestamp": "01:45:55", "text": "啊"}, {"type": "subtitle", "time": 6359.109, "timestamp": "01:45:59", "text": "所以你对星星了解很多。"}]
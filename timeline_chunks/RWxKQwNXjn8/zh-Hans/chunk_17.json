[{"type": "subtitle", "time": 1022.23, "timestamp": "00:17:02", "text": "大城市可能会让人感到混乱不堪。"}, {"type": "subtitle", "time": 1025.11, "timestamp": "00:17:05", "text": "山脉也很美。 M，你知道"}, {"type": "subtitle", "time": 1027.27, "timestamp": "00:17:07", "text": "什么？山脉很美。我能感觉到"}, {"type": "subtitle", "time": 1031.11, "timestamp": "00:17:11", "text": "微风。是的。挑点吃的。"}, {"type": "subtitle", "time": 1032.71, "timestamp": "00:17:12", "text": "健康"}, {"type": "subtitle", "time": 1035.829, "timestamp": "00:17:15", "text": "毛绒玩具上的小圆面包。哦，等等。只是"}, {"type": "subtitle", "time": 1038.47, "timestamp": "00:17:18", "text": "好的。可能只是"}, {"type": "subtitle", "time": 1041.429, "timestamp": "00:17:21", "text": "披萨太不健康了。汉堡不健康。"}, {"type": "subtitle", "time": 1043.27, "timestamp": "00:17:23", "text": "牛排之类的。不良。好的，我会"}, {"type": "subtitle", "time": 1047.51, "timestamp": "00:17:27", "text": "就用这个吧。 B. 我的天哪，"}, {"type": "subtitle", "time": 1050.39, "timestamp": "00:17:30", "text": "兄弟。那玩意儿太贵了。我可以"}, {"type": "subtitle", "time": 1052.549, "timestamp": "00:17:32", "text": "永远买不起。但就像如果有人"}, {"type": "subtitle", "time": 1056.04, "timestamp": "00:17:36", "text": "给我，我吃。"}, {"type": "subtitle", "time": 1057.99, "timestamp": "00:17:37", "text": "[音乐]"}, {"type": "subtitle", "time": 1059.909, "timestamp": "00:17:39", "text": "今天是你最好的朋友的生日，而你"}, {"type": "subtitle", "time": 1061.51, "timestamp": "00:17:41", "text": "忘了该给他们买什么了。你会怎么做？"}, {"type": "subtitle", "time": 1065.51, "timestamp": "00:17:45", "text": "做？呃，你还是会告诉他们这些。等待，"}, {"type": "subtitle", "time": 1067.99, "timestamp": "00:17:47", "text": "你忘了拿。呃，生气"}, {"type": "subtitle", "time": 1070.47, "timestamp": "00:17:50", "text": "先说他们。你只会得到“好的，等等”。不，"}, {"type": "subtitle", "time": 1072.63, "timestamp": "00:17:52", "text": "告诉他们你迷路了。不，那是"}, {"type": "subtitle", "time": 1076.87, "timestamp": "00:17:56", "text": "说谎。我会说我"}]
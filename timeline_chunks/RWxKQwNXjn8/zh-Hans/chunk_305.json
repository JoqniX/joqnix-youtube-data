[{"type": "subtitle", "time": 18304.07, "timestamp": "05:05:04", "text": "还剩一个。还剩一个。搞定一个。搞定一个。"}, {"type": "subtitle", "time": 18307.03, "timestamp": "05:05:07", "text": "还剩一个。还剩一个。"}, {"type": "subtitle", "time": 18310.628, "timestamp": "05:05:10", "text": "呃，一路向上。"}, {"type": "subtitle", "time": 18314.07, "timestamp": "05:05:14", "text": "他妈的。就差一点点。哦，不。等待。你"}, {"type": "subtitle", "time": 18317.11, "timestamp": "05:05:17", "text": "没有。你没明白。不，爆炸了。"}, {"type": "subtitle", "time": 18319.59, "timestamp": "05:05:19", "text": "我时间不够了。"}, {"type": "subtitle", "time": 18321.83, "timestamp": "05:05:21", "text": "就差一点。"}, {"type": "subtitle", "time": 18325.19, "timestamp": "05:05:25", "text": "不，我死了。"}, {"type": "subtitle", "time": 18327.19, "timestamp": "05:05:27", "text": "去。"}, {"type": "subtitle", "time": 18335.27, "timestamp": "05:05:35", "text": "天哪，我简直不敢相信乔克的"}, {"type": "subtitle", "time": 18338.46, "timestamp": "05:05:38", "text": "被杀的人留下了。"}, {"type": "subtitle", "time": 18341.59, "timestamp": "05:05:41", "text": "[笑声]"}, {"type": "subtitle", "time": 18344.55, "timestamp": "05:05:44", "text": "别担心，乔克。没有什么。"}, {"type": "subtitle", "time": 18349.59, "timestamp": "05:05:49", "text": "没有损失任何有价值的东西。没有什么。"}, {"type": "subtitle", "time": 18351.59, "timestamp": "05:05:51", "text": "你好。"}, {"type": "subtitle", "time": 18353.75, "timestamp": "05:05:53", "text": "你会答应吗？我 我"}, {"type": "subtitle", "time": 18357.67, "timestamp": "05:05:57", "text": "希望不是。毫无价值。不，我"}]
[{"type": "subtitle", "time": 9480.79, "timestamp": "02:38:00", "text": "唱国歌？我觉得"}, {"type": "subtitle", "time": 9483.429, "timestamp": "02:38:03", "text": "我还要进一步冒犯他们。"}, {"type": "subtitle", "time": 9490.309, "timestamp": "02:38:10", "text": "对不起。"}, {"type": "subtitle", "time": 9496.63, "timestamp": "02:38:16", "text": "我不属于基督教圣经。"}, {"type": "subtitle", "time": 9501.03, "timestamp": "02:38:21", "text": "抛光。抛光。抛光。抛光。抛光。"}, {"type": "subtitle", "time": 9509.27, "timestamp": "02:38:29", "text": "抛光。好的。没关系。我们找到了乔。"}, {"type": "subtitle", "time": 9510.95, "timestamp": "02:38:30", "text": "我们一定会赢！"}, {"type": "subtitle", "time": 9514.469, "timestamp": "02:38:34", "text": "后退。我们最终会赢回他们的。"}, {"type": "subtitle", "time": 9517.349, "timestamp": "02:38:37", "text": "是的。"}, {"type": "subtitle", "time": 9518.87, "timestamp": "02:38:38", "text": "一切都会好起来的。只是"}, {"type": "subtitle", "time": 9520.389, "timestamp": "02:38:40", "text": "我们得让你知道，有时候你会……"}, {"type": "subtitle", "time": 9522.63, "timestamp": "02:38:42", "text": "遭遇一些挫折，你就会得罪所有人。"}, {"type": "subtitle", "time": 9524.389, "timestamp": "02:38:44", "text": "国家"}, {"type": "subtitle", "time": 9527.83, "timestamp": "02:38:47", "text": "但你知道你必须坚持下去，"}, {"type": "subtitle", "time": 9530.95, "timestamp": "02:38:50", "text": "你赢了。"}, {"type": "subtitle", "time": 9538.79, "timestamp": "02:38:58", "text": "我的天啊。我要给你"}]
[{"type": "subtitle", "time": 9660.389, "timestamp": "02:41:00", "text": "感谢关注。又一个伟大的"}, {"type": "subtitle", "time": 9662.389, "timestamp": "02:41:02", "text": "嗯"}, {"type": "subtitle", "time": 9664.95, "timestamp": "02:41:04", "text": "今天。我了解到自己像一团软泥怪。"}, {"type": "subtitle", "time": 9667.51, "timestamp": "02:41:07", "text": "罐子。好了，这就是我的最终形态。"}, {"type": "subtitle", "time": 9670.87, "timestamp": "02:41:10", "text": "你竟敢如此？哪些熊猫很可爱？它是"}, {"type": "subtitle", "time": 9673.11, "timestamp": "02:41:13", "text": "那"}, {"type": "subtitle", "time": 9674.71, "timestamp": "02:41:14", "text": "是的，萨莫萨其实不是印度菜。"}, {"type": "subtitle", "time": 9677.19, "timestamp": "02:41:17", "text": "盘子。没错。等等，什么？是的。"}, {"type": "subtitle", "time": 9679.11, "timestamp": "02:41:19", "text": "不，是萨莫萨三角饺。他们是被带到这里的"}, {"type": "subtitle", "time": 9680.95, "timestamp": "02:41:20", "text": "麻瓜们。"}, {"type": "subtitle", "time": 9682.95, "timestamp": "02:41:22", "text": "什么？它实际上并不是"}, {"type": "subtitle", "time": 9684.79, "timestamp": "02:41:24", "text": "印度菜。"}, {"type": "subtitle", "time": 9687.11, "timestamp": "02:41:27", "text": "而我不是"}, {"type": "subtitle", "time": 9689.349, "timestamp": "02:41:29", "text": "粪。我只是个孩子。我是一个我是一个"}, {"type": "subtitle", "time": 9693.59, "timestamp": "02:41:33", "text": "黏糊糊的。我是Goop。我浑身黏糊糊的。"}, {"type": "subtitle", "time": 9699.349, "timestamp": "02:41:39", "text": "哦，这是波斯食物。它是"}, {"type": "subtitle", "time": 9700.63, "timestamp": "02:41:40", "text": "哇。"}, {"type": "subtitle", "time": 9704.389, "timestamp": "02:41:44", "text": "是的。这岂不是很疯狂吗？是的。"}, {"type": "subtitle", "time": 9705.429, "timestamp": "02:41:45", "text": "就是这样。我的意思是……"}, {"type": "subtitle", "time": 9714.23, "timestamp": "02:41:54", "text": "他看起来像一罐色彩斑斓的颜料。"}]
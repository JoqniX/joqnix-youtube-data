[{"type": "subtitle", "time": 962.71, "timestamp": "00:16:02", "text": "我的天啊。好的。嗯，好的。中性的。"}, {"type": "subtitle", "time": 964.87, "timestamp": "00:16:04", "text": "中性好。那很好。如果有人说"}, {"type": "subtitle", "time": 967.59, "timestamp": "00:16:07", "text": "对你来说意味着什么？你会怎么做？哦，我的"}, {"type": "subtitle", "time": 971.03, "timestamp": "00:16:11", "text": "上帝。揍他们。"}, {"type": "subtitle", "time": 973.59, "timestamp": "00:16:13", "text": "呃"}, {"type": "subtitle", "time": 978.069, "timestamp": "00:16:18", "text": "挣扎着说，这不太好。"}, {"type": "subtitle", "time": 980.069, "timestamp": "00:16:20", "text": "选择你喜欢居住的地方。"}, {"type": "subtitle", "time": 982.55, "timestamp": "00:16:22", "text": "在森林里某个寒冷的地方"}, {"type": "subtitle", "time": 986.069, "timestamp": "00:16:26", "text": "国家大城市依山而建"}, {"type": "subtitle", "time": 989.03, "timestamp": "00:16:29", "text": "海滩。嗯"}, {"type": "subtitle", "time": 991.509, "timestamp": "00:16:31", "text": "比如，如果我要住在寒冷的地方……"}, {"type": "subtitle", "time": 993.749, "timestamp": "00:16:33", "text": "可以堆雪人。"}, {"type": "subtitle", "time": 996.87, "timestamp": "00:16:36", "text": "没错。雪人很酷。如果我"}, {"type": "subtitle", "time": 999.59, "timestamp": "00:16:39", "text": "我们身处森林中，我得担心……"}, {"type": "subtitle", "time": 1001.59, "timestamp": "00:16:41", "text": "潮湿的空气和所有的灰尘"}, {"type": "subtitle", "time": 1003.91, "timestamp": "00:16:43", "text": "一切。但我也会很喜欢它"}, {"type": "subtitle", "time": 1007.99, "timestamp": "00:16:47", "text": "像树上的猴子一样。将会是"}, {"type": "subtitle", "time": 1009.189, "timestamp": "00:16:49", "text": "像猴子一样。你要挥杆了。"}, {"type": "subtitle", "time": 1011.59, "timestamp": "00:16:51", "text": "从树上。我将会是"}, {"type": "subtitle", "time": 1015.59, "timestamp": "00:16:55", "text": "千。我的天啊。在该国"}, {"type": "subtitle", "time": 1018.87, "timestamp": "00:16:58", "text": "听起来真不错。自然"}]
[{"type": "subtitle", "time": 1081.11, "timestamp": "00:18:01", "text": "等等。这样做也很不礼貌。呃，"}, {"type": "subtitle", "time": 1083.909, "timestamp": "00:18:03", "text": "好的。这很难。是的，是的，是的"}, {"type": "subtitle", "time": 1087.59, "timestamp": "00:18:07", "text": "很难，不是吗？呃，开始哭吧"}, {"type": "subtitle", "time": 1090.549, "timestamp": "00:18:10", "text": "然后说我忘了。或许"}, {"type": "subtitle", "time": 1092.63, "timestamp": "00:18:12", "text": "你会开始哭泣。杰克会"}, {"type": "subtitle", "time": 1095.99, "timestamp": "00:18:15", "text": "肯定会哭。好吧，我要哭了。呃，一个"}, {"type": "subtitle", "time": 1097.75, "timestamp": "00:18:17", "text": "你不喜欢的人想和你出去玩"}, {"type": "subtitle", "time": 1100.63, "timestamp": "00:18:20", "text": "和你在一起，但你真的不想"}, {"type": "subtitle", "time": 1104.23, "timestamp": "00:18:24", "text": "做。嗯，你就告诉他们你在撒谎吧。"}, {"type": "subtitle", "time": 1106.15, "timestamp": "00:18:26", "text": "然后说你很忙。"}, {"type": "subtitle", "time": 1107.75, "timestamp": "00:18:27", "text": "给他们一个机会一起玩玩，看看情况。"}, {"type": "subtitle", "time": 1110.789, "timestamp": "00:18:30", "text": "如果你愿意，好的，我会这么做。但给予"}, {"type": "subtitle", "time": 1112.71, "timestamp": "00:18:32", "text": "是的，我要么就撒谎。"}, {"type": "subtitle", "time": 1119.11, "timestamp": "00:18:39", "text": "早餐。"}, {"type": "subtitle", "time": 1122.23, "timestamp": "00:18:42", "text": "没有大米了。好的，"}, {"type": "subtitle", "time": 1125.029, "timestamp": "00:18:45", "text": "手。你我，你吃米饭"}, {"type": "subtitle", "time": 1126.789, "timestamp": "00:18:46", "text": "早餐。"}, {"type": "subtitle", "time": 1129.51, "timestamp": "00:18:49", "text": "我三年前就开始吃米饭了。"}, {"type": "subtitle", "time": 1131.909, "timestamp": "00:18:51", "text": "米"}, {"type": "subtitle", "time": 1135.59, "timestamp": "00:18:55", "text": "多年来一直吃米饭。三"}, {"type": "subtitle", "time": 1139.029, "timestamp": "00:18:59", "text": "一天数次。"}]
[{"type": "subtitle", "time": 6195.91, "timestamp": "01:43:15", "text": "为什么是乔？灵感是什么？"}, {"type": "subtitle", "time": 6197.83, "timestamp": "01:43:17", "text": "你身后就像，你知道的，明星。"}, {"type": "subtitle", "time": 6199.669, "timestamp": "01:43:19", "text": "基于？"}, {"type": "subtitle", "time": 6202.229, "timestamp": "01:43:22", "text": "哦，我只是喜欢看看。它，它是，它是"}, {"type": "subtitle", "time": 6206.47, "timestamp": "01:43:26", "text": "因为呃"}, {"type": "subtitle", "time": 6208.95, "timestamp": "01:43:28", "text": "起初我完全不知道自己想要什么。"}, {"type": "subtitle", "time": 6211.59, "timestamp": "01:43:31", "text": "做我想做的事，用我的方式去实现"}, {"type": "subtitle", "time": 6215.51, "timestamp": "01:43:35", "text": "bashana 让 jock 给 um 来制作"}, {"type": "subtitle", "time": 6220.629, "timestamp": "01:43:40", "text": "像个运动员一样，喜欢……嗯，就像……是的"}, {"type": "subtitle", "time": 6223.109, "timestamp": "01:43:43", "text": "人格之类的东西，我不知道我"}, {"type": "subtitle", "time": 6225.35, "timestamp": "01:43:45", "text": "可以"}, {"type": "subtitle", "time": 6227.51, "timestamp": "01:43:47", "text": "呃，然后"}, {"type": "subtitle", "time": 6229.669, "timestamp": "01:43:49", "text": "这是之前的事了，嗯，这是在……期间"}, {"type": "subtitle", "time": 6233.75, "timestamp": "01:43:53", "text": "祖奇帮我的时候"}, {"type": "subtitle", "time": 6237.669, "timestamp": "01:43:57", "text": "我以前用过这个模型的艺术图。"}]
[{"type": "subtitle", "time": 8767.19, "timestamp": "02:26:07", "text": "语言。呃，我会说马拉雅拉姆语和印地语。"}, {"type": "subtitle", "time": 8771.19, "timestamp": "02:26:11", "text": "略懂一点英语。然后学习"}, {"type": "subtitle", "time": 8773.349, "timestamp": "02:26:13", "text": "日语，并且即将学习"}, {"type": "subtitle", "time": 8776.469, "timestamp": "02:26:16", "text": "中文普通话。是的。"}, {"type": "subtitle", "time": 8780.389, "timestamp": "02:26:20", "text": "当然。我的天啊。"}, {"type": "subtitle", "time": 8784.23, "timestamp": "02:26:24", "text": "看看你。真是太他妈聪明了。哦"}, {"type": "subtitle", "time": 8787.27, "timestamp": "02:26:27", "text": "我的上帝。"}, {"type": "subtitle", "time": 8789.99, "timestamp": "02:26:29", "text": "不，我的母语很差。"}, {"type": "chat", "time": 8791.053, "timestamp": "02:26:31", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "hey hey Joqqy how u doing?"}, {"type": "subtitle", "time": 8792.63, "timestamp": "02:26:32", "text": "印地语之类的。我在这方面太差劲了"}, {"type": "subtitle", "time": 8795.19, "timestamp": "02:26:35", "text": "我看不懂。我不，我不，我"}, {"type": "subtitle", "time": 8797.27, "timestamp": "02:26:37", "text": "我甚至连一句完整的句子都说不出来。"}, {"type": "subtitle", "time": 8805.349, "timestamp": "02:26:45", "text": "就像我最了解的，就像我实际的"}, {"type": "subtitle", "time": 8807.75, "timestamp": "02:26:47", "text": "母语是说“我正在经历……”的方式"}, {"type": "subtitle", "time": 8810.79, "timestamp": "02:26:50", "text": "头痛。我要么打败你，要么就来。"}, {"type": "subtitle", "time": 8813.27, "timestamp": "02:26:53", "text": "这里是因为你知道，这有点像……"}, {"type": "subtitle", "time": 8815.59, "timestamp": "02:26:55", "text": "我妈妈说的话。"}, {"type": "subtitle", "time": 8817.27, "timestamp": "02:26:57", "text": "[音乐]"}, {"type": "subtitle", "time": 8819.83, "timestamp": "02:26:59", "text": "我只知道一些非常基本的感谢"}]
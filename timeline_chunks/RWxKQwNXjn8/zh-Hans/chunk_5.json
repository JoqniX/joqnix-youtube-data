[{"type": "subtitle", "time": 322.02, "timestamp": "00:05:22", "text": "M差点丧命。我辞职了。"}, {"type": "subtitle", "time": 328.39, "timestamp": "00:05:28", "text": "不要发音。嗯，别担心。我"}, {"type": "subtitle", "time": 333.59000000000003, "timestamp": "00:05:33", "text": "知道。呃，那是一个州名。比如说"}, {"type": "subtitle", "time": 336.23, "timestamp": "00:05:36", "text": "虽然是个孩子。但我并非孩童。我是"}, {"type": "subtitle", "time": 343.43, "timestamp": "00:05:43", "text": "是的。谢谢你关心我"}, {"type": "subtitle", "time": 351.749, "timestamp": "00:05:51", "text": "我需要帮助。天哪，我需要罚款"}, {"type": "subtitle", "time": 355.59000000000003, "timestamp": "00:05:55", "text": "食物。附近没有怪物。没有任何"}, {"type": "subtitle", "time": 359.189, "timestamp": "00:05:59", "text": "那里。是的。"}]
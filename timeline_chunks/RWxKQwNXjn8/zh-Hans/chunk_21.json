[{"type": "subtitle", "time": 1261.99, "timestamp": "00:21:01", "text": "每天。是的。但就像这三者一样"}, {"type": "subtitle", "time": 1266.149, "timestamp": "00:21:06", "text": "一日三餐中，米饭不是。它不是。"}, {"type": "subtitle", "time": 1268.87, "timestamp": "00:21:08", "text": "真实的。"}, {"type": "subtitle", "time": 1270.95, "timestamp": "00:21:10", "text": "我的天啊，"}, {"type": "subtitle", "time": 1272.549, "timestamp": "00:21:12", "text": "男人。"}, {"type": "subtitle", "time": 1274.95, "timestamp": "00:21:14", "text": "这只是个玩笑。即使如此，我们依然爱你"}, {"type": "subtitle", "time": 1285.59, "timestamp": "00:21:25", "text": "我的天啊。嗯，好的。呃，最喜欢的"}, {"type": "subtitle", "time": 1289.19, "timestamp": "00:21:29", "text": "早餐。我该怎么办？为什么人们"}, {"type": "subtitle", "time": 1291.35, "timestamp": "00:21:31", "text": "早餐吃饼干？那不会"}, {"type": "subtitle", "time": 1294.549, "timestamp": "00:21:34", "text": "不过也能填饱肚子。但是什么"}, {"type": "subtitle", "time": 1296.23, "timestamp": "00:21:36", "text": "你会吃吗？如果你吃很多它们"}, {"type": "subtitle", "time": 1300.71, "timestamp": "00:21:40", "text": "如果你吃很多的话。是的。饼子。"}, {"type": "subtitle", "time": 1303.59, "timestamp": "00:21:43", "text": "我试着吃煎饼，结果到处都是坑。"}, {"type": "subtitle", "time": 1306.789, "timestamp": "00:21:46", "text": "那天我受了苦。我吃不下东西。"}, {"type": "subtitle", "time": 1309.669, "timestamp": "00:21:49", "text": "我喜欢煎饼"}, {"type": "subtitle", "time": 1314.63, "timestamp": "00:21:54", "text": "因为现在食物太多了。饼干。"}, {"type": "subtitle", "time": 1316.87, "timestamp": "00:21:56", "text": "这是白人的食物。所以，我们"}, {"type": "subtitle", "time": 1319.43, "timestamp": "00:21:59", "text": "不会的。我猜是白人。哦"}]
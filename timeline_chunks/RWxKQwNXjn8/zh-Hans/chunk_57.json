[{"type": "subtitle", "time": 3422.549, "timestamp": "00:57:02", "text": "你。我的天啊。"}, {"type": "subtitle", "time": 3425.589, "timestamp": "00:57:05", "text": "就像网络漫画或漫画一样。"}, {"type": "subtitle", "time": 3427.27, "timestamp": "00:57:07", "text": "它一直像个独立的小公司一样。"}, {"type": "subtitle", "time": 3430.47, "timestamp": "00:57:10", "text": "小涂鸦漫画。"}, {"type": "subtitle", "time": 3434.309, "timestamp": "00:57:14", "text": "哦是的。这是米奇传说中很重要的事"}, {"type": "subtitle", "time": 3438.63, "timestamp": "00:57:18", "text": "关于我如何变成狐鲸的故事。"}, {"type": "subtitle", "time": 3440.309, "timestamp": "00:57:20", "text": "哦，谢谢你的“去撒尿”指令。我是"}, {"type": "subtitle", "time": 3442.87, "timestamp": "00:57:22", "text": "还没尿呢。"}, {"type": "subtitle", "time": 3447.27, "timestamp": "00:57:27", "text": "小姐，我不是一坨屎。好的。"}, {"type": "subtitle", "time": 3450.789, "timestamp": "00:57:30", "text": "真是坨屎。那不是一只脚吗？第三。"}, {"type": "subtitle", "time": 3455.43, "timestamp": "00:57:35", "text": "Todd 就是个混蛋。哦，再见。"}, {"type": "subtitle", "time": 3457.829, "timestamp": "00:57:37", "text": "我的天啊。我不知道有多少"}, {"type": "subtitle", "time": 3459.19, "timestamp": "00:57:39", "text": "为了解释这一点，但就像某些人一样。"}, {"type": "subtitle", "time": 3461.75, "timestamp": "00:57:41", "text": "我的聊天记录如此痴迷的原因"}, {"type": "subtitle", "time": 3463.67, "timestamp": "00:57:43", "text": "用尿液。"}, {"type": "subtitle", "time": 3465.829, "timestamp": "00:57:45", "text": "嗯？我不知道该怎么解释。"}, {"type": "subtitle", "time": 3467.67, "timestamp": "00:57:47", "text": "任何人。太尴尬了。随时"}, {"type": "subtitle", "time": 3469.67, "timestamp": "00:57:49", "text": "我和别人一起直播，他们"}, {"type": "subtitle", "time": 3473.75, "timestamp": "00:57:53", "text": "一直提起尿液。我的天啊。是的，"}, {"type": "subtitle", "time": 3476.95, "timestamp": "00:57:56", "text": "这很不幸，你知道，但事实就是如此。"}, {"type": "subtitle", "time": 3478.47, "timestamp": "00:57:58", "text": "他们仍然是我的孩子，我爱他们。"}]
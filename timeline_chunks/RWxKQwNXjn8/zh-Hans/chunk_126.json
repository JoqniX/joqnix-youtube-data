[{"type": "subtitle", "time": 7562.47, "timestamp": "02:06:02", "text": "我想，这大概就是……"}, {"type": "subtitle", "time": 7564.87, "timestamp": "02:06:04", "text": "就像很多人知道的那样"}, {"type": "subtitle", "time": 7566.47, "timestamp": "02:06:06", "text": "他们试着做饭，但他们的母亲却不行。"}, {"type": "subtitle", "time": 7567.51, "timestamp": "02:06:07", "text": "就像，你知道，你在拿"}, {"type": "subtitle", "time": 7570.07, "timestamp": "02:06:10", "text": "太长了。你太慢了。给它"}, {"type": "subtitle", "time": 7576.87, "timestamp": "02:06:16", "text": "再过两个Z我就腻了。"}, {"type": "subtitle", "time": 7579.51, "timestamp": "02:06:19", "text": "然后回去吃千层面番茄汤。"}, {"type": "subtitle", "time": 7583.189, "timestamp": "02:06:23", "text": "千层面很好吃。千层面。我从未有过"}, {"type": "subtitle", "time": 7587.589, "timestamp": "02:06:27", "text": "只从Pewdiepie那里听说过。"}, {"type": "subtitle", "time": 7591.189, "timestamp": "02:06:31", "text": "Jo，我得……你知道的，我"}, {"type": "subtitle", "time": 7593.189, "timestamp": "02:06:33", "text": "有多余的房间。乔克。我有一个"}, {"type": "subtitle", "time": 7595.27, "timestamp": "02:06:35", "text": "额外的空间。"}, {"type": "subtitle", "time": 7597.109, "timestamp": "02:06:37", "text": "我把你安排到空房间去。"}, {"type": "subtitle", "time": 7598.87, "timestamp": "02:06:38", "text": "就喂你吃一个星期左右吧"}, {"type": "subtitle", "time": 7601.51, "timestamp": "02:06:41", "text": "类似"}, {"type": "subtitle", "time": 7604.39, "timestamp": "02:06:44", "text": "带你去像异国风情的地方，就像喂你一样"}, {"type": "subtitle", "time": 7606.149, "timestamp": "02:06:46", "text": "就像其他不同的事物一样"}, {"type": "subtitle", "time": 7609.27, "timestamp": "02:06:49", "text": "米。你不是，我们没米吃了"}, {"type": "subtitle", "time": 7611.669, "timestamp": "02:06:51", "text": "一周"}, {"type": "subtitle", "time": 7614.39, "timestamp": "02:06:54", "text": "我们只会吃不同的东西。"}]
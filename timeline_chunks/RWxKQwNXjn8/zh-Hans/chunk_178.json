[{"type": "subtitle", "time": 10680.95, "timestamp": "02:58:00", "text": "去你妈的。联系不上我。无法获取"}, {"type": "subtitle", "time": 10691.429, "timestamp": "02:58:11", "text": "[音乐]"}, {"type": "subtitle", "time": 10698.389, "timestamp": "02:58:18", "text": "是啊，因为它们太容易了。我没有"}, {"type": "subtitle", "time": 10701.19, "timestamp": "02:58:21", "text": "到。我的天啊。"}, {"type": "subtitle", "time": 10702.63, "timestamp": "02:58:22", "text": "别想歪了。得到"}, {"type": "subtitle", "time": 10704.15, "timestamp": "02:58:24", "text": "别想歪了。我只是"}, {"type": "subtitle", "time": 10711.11, "timestamp": "02:58:31", "text": "啊。"}, {"type": "subtitle", "time": 10716.87, "timestamp": "02:58:36", "text": "我们不得不安排人把她送回去。"}, {"type": "subtitle", "time": 10722.0, "timestamp": "02:58:42", "text": "她。哇。所以，聊天很刻薄。"}, {"type": "subtitle", "time": 10723.91, "timestamp": "02:58:43", "text": "[音乐]"}, {"type": "subtitle", "time": 10726.07, "timestamp": "02:58:46", "text": "对了，你晚饭也吃了吗？"}, {"type": "subtitle", "time": 10729.11, "timestamp": "02:58:49", "text": "哦，是的。我做了。我相信我把它吃掉了"}, {"type": "subtitle", "time": 10733.19, "timestamp": "02:58:53", "text": "6、7之类的。哦，糟糕。你吃"}, {"type": "subtitle", "time": 10737.03, "timestamp": "02:58:57", "text": "早期的。哦，我当时好饿啊。我当时就像……"}]
[{"type": "subtitle", "time": 8220.95, "timestamp": "02:17:00", "text": "我没有吃过来自印度各地的食物。"}, {"type": "subtitle", "time": 8223.75, "timestamp": "02:17:03", "text": "要么是因为老实说，那就是……"}, {"type": "subtitle", "time": 8226.95, "timestamp": "02:17:06", "text": "这他妈是个难事。印度菜真是太棒了"}, {"type": "subtitle", "time": 8233.27, "timestamp": "02:17:13", "text": "但是你知道，你必须，你必须尝试。"}, {"type": "subtitle", "time": 8235.91, "timestamp": "02:17:15", "text": "不只是米饭。有，有"}, {"type": "subtitle", "time": 8240.549, "timestamp": "02:17:20", "text": "世界不仅仅只有大米。"}, {"type": "subtitle", "time": 8244.309, "timestamp": "02:17:24", "text": "是的。你有没有尝试过在……做一些事情？"}, {"type": "subtitle", "time": 8246.549, "timestamp": "02:17:26", "text": "至少一次？"}, {"type": "subtitle", "time": 8248.709, "timestamp": "02:17:28", "text": "你有没有看过那部电影《乌鸦》？"}, {"type": "subtitle", "time": 8250.95, "timestamp": "02:17:30", "text": "或者像沙胡汗那样"}, {"type": "subtitle", "time": 8253.349, "timestamp": "02:17:33", "text": "成为机器人之类的？"}, {"type": "subtitle", "time": 8256.95, "timestamp": "02:17:36", "text": "呃，我不太看宝莱坞电影。"}, {"type": "subtitle", "time": 8259.91, "timestamp": "02:17:39", "text": "我也没看，感觉像是……很久很久以前了。"}, {"type": "subtitle", "time": 8262.87, "timestamp": "02:17:42", "text": "小时候我经常看。你"}, {"type": "subtitle", "time": 8266.79, "timestamp": "02:17:46", "text": "知道那首叫Chamakello之类的歌吗？"}, {"type": "subtitle", "time": 8272.309, "timestamp": "02:17:52", "text": "对，就是那个。所以，这个人……"}]
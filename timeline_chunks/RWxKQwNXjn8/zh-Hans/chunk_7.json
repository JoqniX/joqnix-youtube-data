[{"type": "subtitle", "time": 422.79, "timestamp": "00:07:02", "text": "让我来转动它。"}, {"type": "subtitle", "time": 427.189, "timestamp": "00:07:07", "text": "耶。耶。"}, {"type": "subtitle", "time": 431.35, "timestamp": "00:07:11", "text": "大家最近怎么样？你好。"}, {"type": "subtitle", "time": 433.189, "timestamp": "00:07:13", "text": "我只喜欢猫。我的车到底在哪儿？"}, {"type": "subtitle", "time": 436.15, "timestamp": "00:07:16", "text": "绘图板？它在这里。没关系。"}, {"type": "subtitle", "time": 438.309, "timestamp": "00:07:18", "text": "它一直放在角落里积灰。"}, {"type": "subtitle", "time": 440.87, "timestamp": "00:07:20", "text": "相同的。"}, {"type": "subtitle", "time": 443.43, "timestamp": "00:07:23", "text": "我的天哪。它有一层厚厚的……"}, {"type": "subtitle", "time": 445.67, "timestamp": "00:07:25", "text": "上面有灰尘。"}, {"type": "subtitle", "time": 447.589, "timestamp": "00:07:27", "text": "我的天啊。没关系。你知道，"}, {"type": "subtitle", "time": 450.71, "timestamp": "00:07:30", "text": "有时候你只需要眨眨眼就行了，"}, {"type": "subtitle", "time": 459.51, "timestamp": "00:07:39", "text": "好的。只要"}, {"type": "subtitle", "time": 461.51, "timestamp": "00:07:41", "text": "我的绘图板能用，但我不太会用。"}, {"type": "subtitle", "time": 475.27, "timestamp": "00:07:55", "text": "哦，它不是 USB Type-C 接口。我的天哪。好的。"}, {"type": "subtitle", "time": 478.07, "timestamp": "00:07:58", "text": "不同的电缆。好的。"}]
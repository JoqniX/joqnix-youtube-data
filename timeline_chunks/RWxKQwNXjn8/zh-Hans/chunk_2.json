[{"type": "subtitle", "time": 121.35, "timestamp": "00:02:01", "text": "呃，你能把我的床还给我吗？"}, {"type": "subtitle", "time": 128.55, "timestamp": "00:02:08", "text": "你想要的种子。"}, {"type": "subtitle", "time": 137.19, "timestamp": "00:02:17", "text": "我差点失去了我五年来的硬核世界"}, {"type": "subtitle", "time": 139.51, "timestamp": "00:02:19", "text": "就因为那个该死的爬行者。哦"}, {"type": "subtitle", "time": 143.35, "timestamp": "00:02:23", "text": "天哪，爬藤植物真烦人。"}, {"type": "subtitle", "time": 148.63, "timestamp": "00:02:28", "text": "等等，五年。什么？哇！如何"}, {"type": "subtitle", "time": 150.79, "timestamp": "00:02:30", "text": "你能活下来吗？"}, {"type": "subtitle", "time": 155.35, "timestamp": "00:02:35", "text": "尤其是在硬核游戏中？哇。"}, {"type": "subtitle", "time": 157.91, "timestamp": "00:02:37", "text": "再见。"}, {"type": "subtitle", "time": 160.63, "timestamp": "00:02:40", "text": "哇，老兄。"}, {"type": "subtitle", "time": 164.07, "timestamp": "00:02:44", "text": "太佩服你了！来自印度的爱。"}, {"type": "subtitle", "time": 166.47, "timestamp": "00:02:46", "text": "是的。你好，普拉桑德。"}, {"type": "subtitle", "time": 169.99, "timestamp": "00:02:49", "text": "你好吗？"}, {"type": "subtitle", "time": 179.11, "timestamp": "00:02:59", "text": "我们玩的是《我的世界》死神模式。哦，是时候了"}]
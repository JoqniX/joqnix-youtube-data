[{"type": "subtitle", "time": 8161.109, "timestamp": "02:16:01", "text": "活下去，乔。我们并没有处于饥荒之中。"}, {"type": "subtitle", "time": 8164.629, "timestamp": "02:16:04", "text": "乔，我们可以去哪里享受美食呢？"}, {"type": "subtitle", "time": 8167.669, "timestamp": "02:16:07", "text": "哦，是的。我把这件事忘了。是的。"}, {"type": "subtitle", "time": 8171.589, "timestamp": "02:16:11", "text": "你知道，你知道，你没给我做饭。"}, {"type": "subtitle", "time": 8173.43, "timestamp": "02:16:13", "text": "我们不是，你不是在煮我。问："}, {"type": "subtitle", "time": 8176.47, "timestamp": "02:16:16", "text": "你别想把我煮了。不。支持你。"}, {"type": "subtitle", "time": 8179.43, "timestamp": "02:16:19", "text": "坏的。坏的。"}, {"type": "subtitle", "time": 8181.91, "timestamp": "02:16:21", "text": "我的天啊。"}, {"type": "subtitle", "time": 8184.55, "timestamp": "02:16:24", "text": "好的。开玩笑。我认为我的主要"}, {"type": "subtitle", "time": 8187.51, "timestamp": "02:16:27", "text": "今天直播的重点是："}, {"type": "subtitle", "time": 8189.669, "timestamp": "02:16:29", "text": "品味方面有很多值得商榷的地方"}, {"type": "subtitle", "time": 8192.629, "timestamp": "02:16:32", "text": "我以前从未吃过这种食物。"}, {"type": "subtitle", "time": 8195.429, "timestamp": "02:16:35", "text": "我不知道。我没怎么吃东西。"}, {"type": "subtitle", "time": 8198.709, "timestamp": "02:16:38", "text": "来自印度各地。我想我"}, {"type": "subtitle", "time": 8201.589, "timestamp": "02:16:41", "text": "我对印度菜几乎一无所知。"}, {"type": "subtitle", "time": 8204.629, "timestamp": "02:16:44", "text": "东西。就像我去普纳的时候一样"}, {"type": "subtitle", "time": 8206.95, "timestamp": "02:16:46", "text": "创造之母"}, {"type": "subtitle", "time": 8210.23, "timestamp": "02:16:50", "text": "像餐具之类的东西，还有那些"}, {"type": "subtitle", "time": 8212.549, "timestamp": "02:16:52", "text": "披萨相关的东西，我当时就想，哇，这真是……"}, {"type": "subtitle", "time": 8216.389, "timestamp": "02:16:56", "text": "从未有过这种感觉"}, {"type": "subtitle", "time": 8219.19, "timestamp": "02:16:59", "text": "但没关系，说实话，我"}]
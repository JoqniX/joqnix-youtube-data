[{"type": "subtitle", "time": 4266.47, "timestamp": "01:11:06", "text": "我的天啊。你如何评价"}, {"type": "subtitle", "time": 4268.95, "timestamp": "01:11:08", "text": "同人小说？"}, {"type": "subtitle", "time": 4278.55, "timestamp": "01:11:18", "text": "这个故事很有趣。嗯。"}, {"type": "subtitle", "time": 4280.95, "timestamp": "01:11:20", "text": "嗯。你发货吗？你发货吗？你发货吗？你发货吗？"}, {"type": "subtitle", "time": 4285.35, "timestamp": "01:11:25", "text": "是吗，乔？你们发货吗？呃，我迷路了。"}, {"type": "subtitle", "time": 4292.47, "timestamp": "01:11:32", "text": "为什么我觉得自己能画出这个？你"}, {"type": "subtitle", "time": 4294.87, "timestamp": "01:11:34", "text": "应该，纳什。你一定要画画"}, {"type": "subtitle", "time": 4297.43, "timestamp": "01:11:37", "text": "Iron Vuber Yahi。"}, {"type": "subtitle", "time": 4300.47, "timestamp": "01:11:40", "text": "嗯。我觉得铁杆 YouTuber Yahi 是"}, {"type": "subtitle", "time": 4302.31, "timestamp": "01:11:42", "text": "什么是铁杆 YouTuber 社群"}, {"type": "subtitle", "time": 4304.79, "timestamp": "01:11:44", "text": "还差一点就能成功。就像我一样，我已经"}, {"type": "subtitle", "time": 4307.03, "timestamp": "01:11:47", "text": "我一直跟所有铁匠这么说。"}, {"type": "subtitle", "time": 4310.709, "timestamp": "01:11:50", "text": "我认识的一些油管博主。我们得开始了。"}, {"type": "subtitle", "time": 4314.229, "timestamp": "01:11:54", "text": "制作铁艺 YouTuber Yahi，这样我们就可以……"}, {"type": "subtitle", "time": 4317.669, "timestamp": "01:11:57", "text": "知道如何让 YouTuber 像世界一样受欢迎"}, {"type": "subtitle", "time": 4319.35, "timestamp": "01:11:59", "text": "阶段。"}]
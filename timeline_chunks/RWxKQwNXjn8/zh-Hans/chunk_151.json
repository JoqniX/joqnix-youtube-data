[{"type": "subtitle", "time": 9060.55, "timestamp": "02:31:00", "text": "没关系。没关系。脉冲。脉冲。"}, {"type": "subtitle", "time": 9063.27, "timestamp": "02:31:03", "text": "或许。"}, {"type": "subtitle", "time": 9064.87, "timestamp": "02:31:04", "text": "你看，我觉得我们关系并不亲近。"}, {"type": "subtitle", "time": 9067.03, "timestamp": "02:31:07", "text": "足够的。"}, {"type": "subtitle", "time": 9069.429, "timestamp": "02:31:09", "text": "当然是这样，对吧？关闭。足够接近。"}, {"type": "subtitle", "time": 9077.99, "timestamp": "02:31:17", "text": "意思表达清楚就好。"}, {"type": "subtitle", "time": 9080.63, "timestamp": "02:31:20", "text": "欢迎来到Jo英语发音"}, {"type": "subtitle", "time": 9084.07, "timestamp": "02:31:24", "text": "班级。我的天啊。我的天啊。好的。"}, {"type": "subtitle", "time": 9086.15, "timestamp": "02:31:26", "text": "问题是，如果你们，如果你们"}, {"type": "subtitle", "time": 9088.87, "timestamp": "02:31:28", "text": "然后就会说些像“柴”之类的蠢话了"}, {"type": "subtitle", "time": 9092.63, "timestamp": "02:31:32", "text": "没关系。好的。我可以说些类似这样的话"}, {"type": "subtitle", "time": 9096.55, "timestamp": "02:31:36", "text": "警察。哦，就像警察一样。抛光"}, {"type": "subtitle", "time": 9100.55, "timestamp": "02:31:40", "text": "警察。警察。警察。我这么说了吗？"}, {"type": "subtitle", "time": 9106.71, "timestamp": "02:31:46", "text": "就像"}, {"type": "subtitle", "time": 9111.03, "timestamp": "02:31:51", "text": "警察。警察。警察。警察。警察。"}]
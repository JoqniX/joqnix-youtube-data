[{"type": "subtitle", "time": 11342.63, "timestamp": "03:09:02", "text": "这个月轮到我了。你必须对……友好"}, {"type": "subtitle", "time": 11345.67, "timestamp": "03:09:05", "text": "我。现在是骄傲月。"}, {"type": "subtitle", "time": 11352.389, "timestamp": "03:09:12", "text": "实际上是双性恋。哦，那是"}, {"type": "subtitle", "time": 11355.19, "timestamp": "03:09:15", "text": "有趣的。当然。"}, {"type": "subtitle", "time": 11358.07, "timestamp": "03:09:18", "text": "你好像很爱自己，对吧？不，"}, {"type": "subtitle", "time": 11369.91, "timestamp": "03:09:29", "text": "谢谢你，米德。还有，我忘了说"}, {"type": "subtitle", "time": 11373.67, "timestamp": "03:09:33", "text": "你好。很高兴再次见到你。"}, {"type": "subtitle", "time": 11379.83, "timestamp": "03:09:39", "text": "骄傲月快乐，我的同好！"}, {"type": "subtitle", "time": 11381.349, "timestamp": "03:09:41", "text": "我不会被抓到的。他们会"}, {"type": "subtitle", "time": 11383.19, "timestamp": "03:09:43", "text": "永远别抓到我。听着，好吧，我们过去"}, {"type": "subtitle", "time": 11386.15, "timestamp": "03:09:46", "text": "小时候经常玩警察抓小偷的游戏，"}, {"type": "subtitle", "time": 11388.309, "timestamp": "03:09:48", "text": "他们始终没明白。你知道吗？我"}, {"type": "chat", "time": 11389.771, "timestamp": "03:09:49", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "are you sleepy?"}, {"type": "subtitle", "time": 11390.63, "timestamp": "03:09:50", "text": "太滑了。他们会试图抓住"}, {"type": "subtitle", "time": 11393.269, "timestamp": "03:09:53", "text": "我，但我会悄悄溜走。"}, {"type": "subtitle", "time": 11395.75, "timestamp": "03:09:55", "text": "抓牢。我会跑，他们不会。"}]
[{"type": "subtitle", "time": 6902.39, "timestamp": "01:55:02", "text": "刚开始玩这个游戏。"}, {"type": "subtitle", "time": 6906.31, "timestamp": "01:55:06", "text": "所以，我什么都不懂，但我有卡塔。"}, {"type": "subtitle", "time": 6908.709, "timestamp": "01:55:08", "text": "她的名字该怎么念？卡尔塔。"}, {"type": "subtitle", "time": 6912.31, "timestamp": "01:55:12", "text": "等等，那个金发女孩又回来了。"}, {"type": "subtitle", "time": 6922.07, "timestamp": "01:55:22", "text": "坏的。为什么？所以，那个红头发的女孩是"}, {"type": "subtitle", "time": 6923.91, "timestamp": "01:55:23", "text": "走了。"}, {"type": "subtitle", "time": 6926.31, "timestamp": "01:55:26", "text": "对，就是那个红头发的。是的，她走了。我"}, {"type": "subtitle", "time": 6929.03, "timestamp": "01:55:29", "text": "没能找到她。哦，卡塔塔出局了。"}, {"type": "subtitle", "time": 6931.99, "timestamp": "01:55:31", "text": "哦，是的。"}, {"type": "subtitle", "time": 6935.43, "timestamp": "01:55:35", "text": "那么下一个是谁？"}, {"type": "subtitle", "time": 6938.149, "timestamp": "01:55:38", "text": "现在是卢帕。"}, {"type": "subtitle", "time": 6949.589, "timestamp": "01:55:49", "text": "好的，我已经重新加入 sh。是的"}]
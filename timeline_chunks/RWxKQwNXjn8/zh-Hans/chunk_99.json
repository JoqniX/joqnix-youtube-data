[{"type": "subtitle", "time": 5941.91, "timestamp": "01:39:01", "text": "你知道吗？但是，呃，它叫什么来着？"}, {"type": "subtitle", "time": 5946.95, "timestamp": "01:39:06", "text": "法郎。不，呃，不是懒惰。呃，你还记得吗？"}, {"type": "subtitle", "time": 5949.75, "timestamp": "01:39:09", "text": "它以字母 F 开头，对吧？如果我是"}, {"type": "subtitle", "time": 5955.99, "timestamp": "01:39:15", "text": "正确的。是 FET 吗？不。F E R R E T。是"}, {"type": "subtitle", "time": 5958.229, "timestamp": "01:39:18", "text": "是你很久以前提到的那个吗？我"}, {"type": "subtitle", "time": 5961.51, "timestamp": "01:39:21", "text": "喜欢看老虎机之类的东西"}, {"type": "subtitle", "time": 5963.109, "timestamp": "01:39:23", "text": "某物"}, {"type": "subtitle", "time": 5966.149, "timestamp": "01:39:26", "text": "那种毛茸茸的动物"}, {"type": "subtitle", "time": 5968.629, "timestamp": "01:39:28", "text": "太可爱了。是啊，雪貂确实很可爱。"}, {"type": "subtitle", "time": 5972.149, "timestamp": "01:39:32", "text": "我也很喜欢雪貂。"}, {"type": "subtitle", "time": 5974.229, "timestamp": "01:39:34", "text": "是的，他们，他们，他们实际上就像"}, {"type": "subtitle", "time": 5976.79, "timestamp": "01:39:36", "text": "他们也是相当不错的猎人。他们是"}, {"type": "subtitle", "time": 5979.109, "timestamp": "01:39:39", "text": "小巧可爱，但它们就像……"}, {"type": "subtitle", "time": 5986.39, "timestamp": "01:39:46", "text": "你见过像雪貂一样的东西吗？"}, {"type": "subtitle", "time": 5987.75, "timestamp": "01:39:47", "text": "视频？"}, {"type": "subtitle", "time": 5991.91, "timestamp": "01:39:51", "text": "不。我的天哪。不，我们需要，我们需要"}, {"type": "subtitle", "time": 5995.43, "timestamp": "01:39:55", "text": "给你看的这个公平真是太可爱了。"}]
[{"type": "subtitle", "time": 8588.07, "timestamp": "02:23:08", "text": "我的天啊。查德，你竟敢这样？何敢"}, {"type": "subtitle", "time": 8590.55, "timestamp": "02:23:10", "text": "你？"}, {"type": "subtitle", "time": 8592.87, "timestamp": "02:23:12", "text": "makan是什么？"}, {"type": "subtitle", "time": 8596.71, "timestamp": "02:23:16", "text": "Makan 是呃，它是"}, {"type": "subtitle", "time": 8601.67, "timestamp": "02:23:21", "text": "黄油。哦，是的。 Makan是黄油。它"}, {"type": "subtitle", "time": 8612.389, "timestamp": "02:23:32", "text": "是的。我太爱奶油了。我的我"}, {"type": "subtitle", "time": 8614.95, "timestamp": "02:23:34", "text": "我好的。所以，加入我们，你知道印度教吗？"}, {"type": "subtitle", "time": 8617.91, "timestamp": "02:23:37", "text": "神话？喜欢印度教神话吗？不是"}, {"type": "subtitle", "time": 8619.67, "timestamp": "02:23:39", "text": "很多。"}, {"type": "subtitle", "time": 8622.55, "timestamp": "02:23:42", "text": "好的。你知道克里希纳是谁吗？哦，"}, {"type": "subtitle", "time": 8624.95, "timestamp": "02:23:44", "text": "是的。是的。是的。我只会一些最基本的。"}, {"type": "subtitle", "time": 8627.83, "timestamp": "02:23:47", "text": "是的。是的。是的。所以，呃，你知道怎么做的"}, {"type": "subtitle", "time": 8630.469, "timestamp": "02:23:50", "text": "克里希那叫什么？呃，你知道吗？"}, {"type": "subtitle", "time": 8633.11, "timestamp": "02:23:53", "text": "克里希那被称为马库尔？"}, {"type": "subtitle", "time": 8635.67, "timestamp": "02:23:55", "text": "不。哦，因为他偷了。是的，他"}, {"type": "subtitle", "time": 8638.15, "timestamp": "02:23:58", "text": "总是偷走所有东西，比如呃……"}]
[{"type": "subtitle", "time": 1622.65, "timestamp": "00:27:02", "text": "世界物种。熊。嗯。"}, {"type": "subtitle", "time": 1624.149, "timestamp": "00:27:04", "text": "[音乐]"}, {"type": "subtitle", "time": 1627.59, "timestamp": "00:27:07", "text": "嗯？哦。嗯。"}, {"type": "subtitle", "time": 1629.83, "timestamp": "00:27:09", "text": "我想他们不是。"}, {"type": "subtitle", "time": 1634.23, "timestamp": "00:27:14", "text": "它们更像是袋鼠。该死。"}, {"type": "subtitle", "time": 1636.88, "timestamp": "00:27:16", "text": "该死。 看来你们都太逊了。"}, {"type": "subtitle", "time": 1641.2, "timestamp": "00:27:21", "text": "看来你们都太逊了。 太阳熊看起来嗨翻了。太阳熊"}, {"type": "subtitle", "time": 1644.24, "timestamp": "00:27:24", "text": "太阳熊看起来嗨翻了。太阳熊 看起来好像有个男人穿着熊皮"}, {"type": "subtitle", "time": 1647.12, "timestamp": "00:27:27", "text": "看起来好像有个男人穿着熊皮 套装。他们"}, {"type": "subtitle", "time": 1649.6, "timestamp": "00:27:29", "text": "套装。他们 看看这个，真是太棒了。"}, {"type": "subtitle", "time": 1656.63, "timestamp": "00:27:36", "text": "一段因愤怒而破裂的关系。抽象的"}, {"type": "subtitle", "time": 1660.149, "timestamp": "00:27:40", "text": "愤怒。哦，混凝土。好的。微距对焦。"}, {"type": "subtitle", "time": 1662.39, "timestamp": "00:27:42", "text": "理解什么？什么？我在哪里"}, {"type": "subtitle", "time": 1665.669, "timestamp": "00:27:45", "text": "我？我到达了哪里？什么？有什么"}, {"type": "subtitle", "time": 1671.99, "timestamp": "00:27:51", "text": "事业、友谊、挚友。"}, {"type": "subtitle", "time": 1675.59, "timestamp": "00:27:55", "text": "好的。等待。不。呃，赤裸裸的个性。"}, {"type": "subtitle", "time": 1678.31, "timestamp": "00:27:58", "text": "好的。自信、有道德、有启发性"}]
[{"type": "subtitle", "time": 7621.83, "timestamp": "02:07:01", "text": "Haras是什么性格类型？他是一个"}, {"type": "subtitle", "time": 7624.31, "timestamp": "02:07:04", "text": "婊子，兄弟。他是个小混蛋。"}, {"type": "subtitle", "time": 7627.03, "timestamp": "02:07:07", "text": "他，他，他，他就像，你知道，他"}, {"type": "subtitle", "time": 7629.03, "timestamp": "02:07:09", "text": "一个刻薄的女孩。他是个坏女孩。那是"}, {"type": "subtitle", "time": 7633.51, "timestamp": "02:07:13", "text": "他究竟是什么样的人？我的天啊。"}, {"type": "subtitle", "time": 7639.109, "timestamp": "02:07:19", "text": "我的意思是，你只需要看一看就行了。"}, {"type": "subtitle", "time": 7640.55, "timestamp": "02:07:20", "text": "看看他的直播，你就会知道他"}, {"type": "subtitle", "time": 7642.31, "timestamp": "02:07:22", "text": "人格类型。我的意思是"}, {"type": "subtitle", "time": 7645.51, "timestamp": "02:07:25", "text": "他真是个小混蛋。记住美国"}, {"type": "subtitle", "time": 7648.39, "timestamp": "02:07:28", "text": "是季节吧？调味就像放盐一样"}, {"type": "subtitle", "time": 7650.149, "timestamp": "02:07:30", "text": "还有其他一些东西。"}, {"type": "subtitle", "time": 7652.709, "timestamp": "02:07:32", "text": "眨眼调味米饭。那他妈是什么玩意儿？"}, {"type": "subtitle", "time": 7655.27, "timestamp": "02:07:35", "text": "意思是？"}, {"type": "subtitle", "time": 7663.03, "timestamp": "02:07:43", "text": "我的意思是，谁会在食物里不放盐和油呢？"}, {"type": "subtitle", "time": 7670.55, "timestamp": "02:07:50", "text": "我是说，老实说。"}, {"type": "subtitle", "time": 7673.35, "timestamp": "02:07:53", "text": "我听说它不错之类的。我当时"}]
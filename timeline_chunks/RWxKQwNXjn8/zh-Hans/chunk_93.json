[{"type": "subtitle", "time": 5582.31, "timestamp": "01:33:02", "text": "就像尝试画画一样。说实话，就像"}, {"type": "subtitle", "time": 5584.31, "timestamp": "01:33:04", "text": "当你学习某件事的时候，你"}, {"type": "subtitle", "time": 5586.47, "timestamp": "01:33:06", "text": "一定要参考文献。喜欢"}, {"type": "subtitle", "time": 5587.99, "timestamp": "01:33:07", "text": "这不算作弊什么的。它是"}, {"type": "subtitle", "time": 5589.91, "timestamp": "01:33:09", "text": "实际上喜欢你应该喜欢的东西"}, {"type": "subtitle", "time": 5591.75, "timestamp": "01:33:11", "text": "做。即使是在艺术学校，他们也会"}, {"type": "subtitle", "time": 5593.83, "timestamp": "01:33:13", "text": "告诉你同样的事情，要始终使用"}, {"type": "subtitle", "time": 5595.59, "timestamp": "01:33:15", "text": "参考"}, {"type": "subtitle", "time": 5597.83, "timestamp": "01:33:17", "text": "否则你的身体构造就无法正常运作。"}, {"type": "subtitle", "time": 5599.99, "timestamp": "01:33:19", "text": "需要改进。"}, {"type": "subtitle", "time": 5601.59, "timestamp": "01:33:21", "text": "嗯。"}, {"type": "subtitle", "time": 5604.39, "timestamp": "01:33:24", "text": "所以引用非常重要"}, {"type": "subtitle", "time": 5607.51, "timestamp": "01:33:27", "text": "实际上，就像……人们追踪也是"}, {"type": "subtitle", "time": 5609.51, "timestamp": "01:33:29", "text": "一个重要的工具。你从来不会"}, {"type": "subtitle", "time": 5613.59, "timestamp": "01:33:33", "text": "发布你追踪到的任何东西，但你是其中之一。"}, {"type": "subtitle", "time": 5616.39, "timestamp": "01:33:36", "text": "这是一种学习方式，就像你一样。"}, {"type": "subtitle", "time": 5618.31, "timestamp": "01:33:38", "text": "在某物上描摹。你不"}, {"type": "subtitle", "time": 5619.75, "timestamp": "01:33:39", "text": "从不喜欢在任何东西上留下痕迹。它是"}, {"type": "subtitle", "time": 5621.03, "timestamp": "01:33:41", "text": "就像你知道的，是用于商业用途的。"}, {"type": "subtitle", "time": 5623.59, "timestamp": "01:33:43", "text": "目的，但它是一种技巧，你"}, {"type": "subtitle", "time": 5629.43, "timestamp": "01:33:49", "text": "选择学习。哦，是的。"}, {"type": "subtitle", "time": 5632.31, "timestamp": "01:33:52", "text": "艺术很大程度上就是重复的。"}, {"type": "subtitle", "time": 5635.189, "timestamp": "01:33:55", "text": "直到你最终明白该怎么做"}, {"type": "subtitle", "time": 5637.91, "timestamp": "01:33:57", "text": "事物。"}]
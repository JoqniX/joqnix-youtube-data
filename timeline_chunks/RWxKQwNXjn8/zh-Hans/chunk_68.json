[{"type": "subtitle", "time": 4082.069, "timestamp": "01:08:02", "text": "我不会告诉你们的。你们"}, {"type": "subtitle", "time": 4083.91, "timestamp": "01:08:03", "text": "我永远不会知道我的喜好。"}, {"type": "subtitle", "time": 4085.99, "timestamp": "01:08:05", "text": "好的。嗯，你只需要……"}, {"type": "subtitle", "time": 4088.95, "timestamp": "01:08:08", "text": "我知道我喜欢热情奔放，我喜欢强势强劲。"}, {"type": "subtitle", "time": 4096.55, "timestamp": "01:08:16", "text": "对乔产生了不良影响。我是一个好人"}, {"type": "subtitle", "time": 4099.189, "timestamp": "01:08:19", "text": "影响力，对吧？"}, {"type": "subtitle", "time": 4101.51, "timestamp": "01:08:21", "text": "你做了什么？我 我 我 我 好"}, {"type": "subtitle", "time": 4104.47, "timestamp": "01:08:24", "text": "对你有影响，对吧？"}, {"type": "subtitle", "time": 4106.789, "timestamp": "01:08:26", "text": "我不知道。我的意思是，你很棒。"}, {"type": "subtitle", "time": 4109.749, "timestamp": "01:08:29", "text": "你是个好朋友。看，看，操"}, {"type": "subtitle", "time": 4111.51, "timestamp": "01:08:31", "text": "你，聊天。你们，你们真是太……"}, {"type": "subtitle", "time": 4114.07, "timestamp": "01:08:34", "text": "对我而言很刻薄。但这就是漫画的魅力所在。"}, {"type": "subtitle", "time": 4118.229, "timestamp": "01:08:38", "text": "我做了关于我如何如何的事情，是的，我发送了"}, {"type": "subtitle", "time": 4133.669, "timestamp": "01:08:53", "text": "你为什么既是狐狸又是鲸鱼？标记。"}, {"type": "subtitle", "time": 4136.709, "timestamp": "01:08:56", "text": "我的天啊。我杀死了神话鲸鱼吉布。"}, {"type": "subtitle", "time": 4139.11, "timestamp": "01:08:59", "text": "这就是我。"}]
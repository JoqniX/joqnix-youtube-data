[{"type": "subtitle", "time": 9547.429, "timestamp": "02:39:07", "text": "你真是太可爱了。"}, {"type": "subtitle", "time": 9550.309, "timestamp": "02:39:10", "text": "翅膀太多了。我知道。真是太"}, {"type": "subtitle", "time": 9556.07, "timestamp": "02:39:16", "text": "被取消资格。不，不，不，我不要。"}, {"type": "subtitle", "time": 9567.03, "timestamp": "02:39:27", "text": "我们一共打了172杆。是的，"}, {"type": "subtitle", "time": 9569.99, "timestamp": "02:39:29", "text": "我们是抽屉。画。"}, {"type": "subtitle", "time": 9580.79, "timestamp": "02:39:40", "text": "我们画。我们现在画了很多画。今天我画画"}, {"type": "subtitle", "time": 9582.79, "timestamp": "02:39:42", "text": "很多。"}, {"type": "subtitle", "time": 9588.23, "timestamp": "02:39:48", "text": "乔，你做得太棒了。你已经学会了。 M"}, {"type": "subtitle", "time": 9591.27, "timestamp": "02:39:51", "text": "那么，我们今天的艺术课学到了什么呢？"}, {"type": "subtitle", "time": 9593.91, "timestamp": "02:39:53", "text": "会议发言你能告诉我们吗？"}, {"type": "subtitle", "time": 9596.07, "timestamp": "02:39:56", "text": "你所学到的"}, {"type": "subtitle", "time": 9599.11, "timestamp": "02:39:59", "text": "呃，我学会了怎么画熊猫雪貂"}]
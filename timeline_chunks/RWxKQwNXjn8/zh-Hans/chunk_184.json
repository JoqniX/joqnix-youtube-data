[{"type": "subtitle", "time": 11042.309, "timestamp": "03:04:02", "text": "是的，那就是"}, {"type": "subtitle", "time": 11044.309, "timestamp": "03:04:04", "text": "这些男孩，他们就像"}, {"type": "subtitle", "time": 11046.23, "timestamp": "03:04:06", "text": "有人在叫我。他们会说：“米克，"}, {"type": "subtitle", "time": 11060.07, "timestamp": "03:04:20", "text": "我们的小狗不是不是不是不是"}, {"type": "subtitle", "time": 11063.59, "timestamp": "03:04:23", "text": "并非毫无防备。他是个强壮的男孩。"}, {"type": "subtitle", "time": 11065.59, "timestamp": "03:04:25", "text": "他是个强壮的男孩。如果你给一把刀"}, {"type": "subtitle", "time": 11074.15, "timestamp": "03:04:34", "text": "不要被他可爱的外表所迷惑。他是"}, {"type": "subtitle", "time": 11087.11, "timestamp": "03:04:47", "text": "溪流。所以，谢谢。我的天啊。如果"}, {"type": "subtitle", "time": 11088.79, "timestamp": "03:04:48", "text": "好的。好的。我们需要……我们需要一个杀手"}, {"type": "subtitle", "time": 11090.469, "timestamp": "03:04:50", "text": "乔的昵称。我们需要一个杀手"}, {"type": "subtitle", "time": 11094.15, "timestamp": "03:04:54", "text": "昵称，对吧？我们需要 我们需要 我们需要"}, {"type": "subtitle", "time": 11095.59, "timestamp": "03:04:55", "text": "一个绝妙的绰号。你知道那种感觉，"}, {"type": "subtitle", "time": 11097.67, "timestamp": "03:04:57", "text": "你知道，就像有十二宫杀手一样"}]
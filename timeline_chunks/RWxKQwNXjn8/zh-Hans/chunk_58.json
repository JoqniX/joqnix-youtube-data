[{"type": "subtitle", "time": 3484.789, "timestamp": "00:58:04", "text": "此外，看护人员也必须采取"}, {"type": "subtitle", "time": 3486.309, "timestamp": "00:58:06", "text": "照顾新生儿或他们"}, {"type": "subtitle", "time": 3488.789, "timestamp": "00:58:08", "text": "可能会被妈妈不小心压扁。"}, {"type": "subtitle", "time": 3491.829, "timestamp": "00:58:11", "text": "她们是熊猫妈妈，她们也是熊猫妈妈。"}, {"type": "subtitle", "time": 3496.47, "timestamp": "00:58:16", "text": "如果是这样的话，问题是熊猫的工作"}, {"type": "subtitle", "time": 3499.109, "timestamp": "00:58:19", "text": "更有可能生双胞胎。"}, {"type": "subtitle", "time": 3500.789, "timestamp": "00:58:20", "text": "好的。"}, {"type": "subtitle", "time": 3502.71, "timestamp": "00:58:22", "text": "M 她们更有可能生育"}, {"type": "subtitle", "time": 3505.829, "timestamp": "00:58:25", "text": "双胞胎。但不知何故，尽管"}, {"type": "subtitle", "time": 3507.589, "timestamp": "00:58:27", "text": "更有可能生育"}, {"type": "subtitle", "time": 3510.39, "timestamp": "00:58:30", "text": "双胞胎，他们拒绝照顾更多"}, {"type": "subtitle", "time": 3517.03, "timestamp": "00:58:37", "text": "看护人员需要做的是："}, {"type": "subtitle", "time": 3519.67, "timestamp": "00:58:39", "text": "必须立即将双胞胎分开"}, {"type": "subtitle", "time": 3522.23, "timestamp": "00:58:42", "text": "出生后，他们必须更换"}, {"type": "subtitle", "time": 3524.309, "timestamp": "00:58:44", "text": "偶尔会有双胞胎一起出来玩。所以，"}, {"type": "subtitle", "time": 3526.15, "timestamp": "00:58:46", "text": "母亲照料港口，无需"}, {"type": "subtitle", "time": 3529.109, "timestamp": "00:58:49", "text": "意识到这一点。"}, {"type": "subtitle", "time": 3532.39, "timestamp": "00:58:52", "text": "啊，是的。关于熊猫的一切都是那样。"}, {"type": "subtitle", "time": 3534.309, "timestamp": "00:58:54", "text": "他们就是，他们就是不太好。"}, {"type": "subtitle", "time": 3537.9, "timestamp": "00:58:57", "text": "生存下来。"}, {"type": "subtitle", "time": 3539.589, "timestamp": "00:58:59", "text": "[音乐]"}]
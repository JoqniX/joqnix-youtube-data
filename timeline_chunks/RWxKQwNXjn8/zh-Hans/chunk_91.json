[{"type": "subtitle", "time": 5481.11, "timestamp": "01:31:21", "text": "听起来不错。船员们，我迫不及待了"}, {"type": "subtitle", "time": 5491.03, "timestamp": "01:31:31", "text": "你玩过《Delta Rune Jock》吗？不是"}, {"type": "subtitle", "time": 5495.189, "timestamp": "01:31:35", "text": "然而。还没有。哦，太棒了。应该"}, {"type": "subtitle", "time": 5497.27, "timestamp": "01:31:37", "text": "完全。你玩过《传说之下》（Undertale）吗？"}, {"type": "subtitle", "time": 5502.149, "timestamp": "01:31:42", "text": "没有。你没玩过《传说之下》（Undertale）吗？不。"}, {"type": "subtitle", "time": 5504.79, "timestamp": "01:31:44", "text": "我的天啊。乔布，我们需要你来玩"}, {"type": "subtitle", "time": 5507.27, "timestamp": "01:31:47", "text": "传说之下。"}, {"type": "subtitle", "time": 5515.189, "timestamp": "01:31:55", "text": "它定义了我作为一个人是什么样的人。"}]
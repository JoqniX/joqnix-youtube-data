[{"type": "subtitle", "time": 3841.19, "timestamp": "01:04:01", "text": "我喜欢我甚至都没让他问我。"}, {"type": "subtitle", "time": 3842.71, "timestamp": "01:04:02", "text": "没关系。没关系。你只是"}, {"type": "subtitle", "time": 3846.23, "timestamp": "01:04:06", "text": "画一只熊猫。是的，我一直都保持着"}, {"type": "subtitle", "time": 3848.63, "timestamp": "01:04:08", "text": "参考资料和类似熊猫毛绒玩具之类的东西"}, {"type": "subtitle", "time": 3850.63, "timestamp": "01:04:10", "text": "就像我当时在画的那样。哇。我当时"}, {"type": "subtitle", "time": 3853.029, "timestamp": "01:04:13", "text": "同时使用参考文献。如果你想的话"}, {"type": "subtitle", "time": 3855.19, "timestamp": "01:04:15", "text": "画画时需要参考资料。"}, {"type": "subtitle", "time": 3878.069, "timestamp": "01:04:38", "text": "这是我最喜欢的乔的台词。"}, {"type": "subtitle", "time": 3885.829, "timestamp": "01:04:45", "text": "我的天啊。"}, {"type": "subtitle", "time": 3887.349, "timestamp": "01:04:47", "text": "正常的熊毛修剪得宽一些？"}, {"type": "subtitle", "time": 3889.19, "timestamp": "01:04:49", "text": "因为从技术上讲，所有BS都是正常的B。"}, {"type": "subtitle", "time": 3894.23, "timestamp": "01:04:54", "text": "让我来，我可以把它排版得更好一些。我"}]
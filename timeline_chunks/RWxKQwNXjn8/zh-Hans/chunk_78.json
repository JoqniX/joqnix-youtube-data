[{"type": "subtitle", "time": 4680.95, "timestamp": "01:18:00", "text": "当你想做某事时，应该怎么做？"}, {"type": "subtitle", "time": 4684.31, "timestamp": "01:18:04", "text": "因为它已经简化了，所以显得很柔软。"}, {"type": "subtitle", "time": 4687.11, "timestamp": "01:18:07", "text": "足够的。是的。"}, {"type": "subtitle", "time": 4693.99, "timestamp": "01:18:13", "text": "脸红了。"}, {"type": "subtitle", "time": 4708.55, "timestamp": "01:18:28", "text": "坚持，稍等。我得出去一下。哦"}, {"type": "subtitle", "time": 4724.39, "timestamp": "01:18:44", "text": "你知道吗？等待期间，我先去别的地方。"}, {"type": "subtitle", "time": 4728.229, "timestamp": "01:18:48", "text": "乔克，我也想把你画成猫。"}, {"type": "subtitle", "time": 4731.669, "timestamp": "01:18:51", "text": "是的。我要把你画成一只小猫。"}, {"type": "subtitle", "time": 4739.11, "timestamp": "01:18:59", "text": "cho"}]
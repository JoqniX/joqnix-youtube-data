[{"type": "subtitle", "time": 14280.15, "timestamp": "03:58:00", "text": "你和我在一起。你听我说"}, {"type": "subtitle", "time": 14281.75, "timestamp": "03:58:01", "text": "说话。"}, {"type": "subtitle", "time": 14285.189, "timestamp": "03:58:05", "text": "我不知道我的听力如何。"}, {"type": "subtitle", "time": 14287.51, "timestamp": "03:58:07", "text": "家人都睡着了。"}, {"type": "subtitle", "time": 14290.63, "timestamp": "03:58:10", "text": "我偷偷溜进了厨房。"}, {"type": "subtitle", "time": 14293.59, "timestamp": "03:58:13", "text": "耶。"}, {"type": "subtitle", "time": 14296.229, "timestamp": "03:58:16", "text": "有什么吃的？"}, {"type": "subtitle", "time": 14299.189, "timestamp": "03:58:19", "text": "哦，是我早上点的那个东西。"}, {"type": "subtitle", "time": 14301.59, "timestamp": "03:58:21", "text": "好的。"}, {"type": "subtitle", "time": 14304.63, "timestamp": "03:58:24", "text": "没什么特别的"}, {"type": "subtitle", "time": 14307.67, "timestamp": "03:58:27", "text": "不，等等。他们带来了东西。"}, {"type": "subtitle", "time": 14311.269, "timestamp": "03:58:31", "text": "他们带来了东西。这是什么？我"}, {"type": "subtitle", "time": 14320.95, "timestamp": "03:58:40", "text": "好吧，我要去冰箱里看看。"}, {"type": "subtitle", "time": 14323.11, "timestamp": "03:58:43", "text": "现在"}]
[{"type": "subtitle", "time": 10261.67, "timestamp": "02:51:01", "text": "我对此并不了解。"}, {"type": "subtitle", "time": 10265.75, "timestamp": "02:51:05", "text": "大家都认识你，所以你也知道，他们"}, {"type": "subtitle", "time": 10269.11, "timestamp": "02:51:09", "text": "爱你。我甚至不知道大家是怎么想的"}, {"type": "subtitle", "time": 10272.23, "timestamp": "02:51:12", "text": "认识我。我感觉自己就像……我发现自己就是这样。"}, {"type": "subtitle", "time": 10275.429, "timestamp": "02:51:15", "text": "便宜，而且就像其他人一样。"}, {"type": "subtitle", "time": 10279.03, "timestamp": "02:51:19", "text": "你在这里，你可以成为"}, {"type": "subtitle", "time": 10281.51, "timestamp": "02:51:21", "text": "如果你愿意，可以和他们交朋友。"}, {"type": "subtitle", "time": 10284.389, "timestamp": "02:51:24", "text": "感到孤独或者你知道的"}, {"type": "subtitle", "time": 10287.91, "timestamp": "02:51:27", "text": "我独自一人待在那里。"}, {"type": "subtitle", "time": 10291.67, "timestamp": "02:51:31", "text": "这就是乔喜欢的人的原因。"}, {"type": "subtitle", "time": 10293.75, "timestamp": "02:51:33", "text": "不是每个人都这样做，不是每个人"}, {"type": "subtitle", "time": 10296.07, "timestamp": "02:51:36", "text": "总是在那里迎接客人"}, {"type": "subtitle", "time": 10297.51, "timestamp": "02:51:37", "text": "但你一直都在那里，这本身就是一种慰藉。"}, {"type": "subtitle", "time": 10300.309, "timestamp": "02:51:40", "text": "你应该为此感到自豪，这不是，这不是"}, {"type": "subtitle", "time": 10301.67, "timestamp": "02:51:41", "text": "你什么都没做，是你做的"}, {"type": "subtitle", "time": 10303.83, "timestamp": "02:51:43", "text": "一切都好，你应该感到自豪。"}, {"type": "subtitle", "time": 10306.309, "timestamp": "02:51:46", "text": "你自己"}, {"type": "subtitle", "time": 10308.81, "timestamp": "02:51:48", "text": "干得好，好孩子"}, {"type": "subtitle", "time": 10314.23, "timestamp": "02:51:54", "text": "一个"}, {"type": "subtitle", "time": 10316.87, "timestamp": "02:51:56", "text": "他太可爱了，真的就像一只熊猫。"}]
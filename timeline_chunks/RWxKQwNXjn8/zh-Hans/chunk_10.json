[{"type": "subtitle", "time": 601.269, "timestamp": "00:10:01", "text": "[音乐]"}, {"type": "subtitle", "time": 604.47, "timestamp": "00:10:04", "text": "他们太可爱了。"}, {"type": "subtitle", "time": 617.67, "timestamp": "00:10:17", "text": "好的。嗯哦。"}, {"type": "subtitle", "time": 620.79, "timestamp": "00:10:20", "text": "我该怎么做？你可以像这样打开聊天窗口。"}, {"type": "subtitle", "time": 623.91, "timestamp": "00:10:23", "text": "哦，我必须参加，对吧？是的，你"}, {"type": "subtitle", "time": 627.11, "timestamp": "00:10:27", "text": "必须这样做，然后"}, {"type": "subtitle", "time": 629.11, "timestamp": "00:10:29", "text": "我不知道我是否拥有账户"}, {"type": "subtitle", "time": 633.59, "timestamp": "00:10:33", "text": "岩浆。哦，你不需要注册账号。"}, {"type": "subtitle", "time": 634.71, "timestamp": "00:10:34", "text": "你知道，你可以画画。"}, {"type": "subtitle", "time": 638.47, "timestamp": "00:10:38", "text": "匿名。你只需要创建一个新的"}, {"type": "subtitle", "time": 639.59, "timestamp": "00:10:39", "text": "分层，你应该就可以开始了"}, {"type": "subtitle", "time": 643.75, "timestamp": "00:10:43", "text": "绘画。好的。是的。"}, {"type": "subtitle", "time": 646.389, "timestamp": "00:10:46", "text": "不。也是。祖母"}, {"type": "subtitle", "time": 649.75, "timestamp": "00:10:49", "text": "银。我的天啊，我还没打开英雄联盟呢"}, {"type": "subtitle", "time": 654.23, "timestamp": "00:10:54", "text": "永远。另外，严格来说，我是一名"}, {"type": "subtitle", "time": 656.71, "timestamp": "00:10:56", "text": "毛茸茸的，但又不是完全毛茸茸的。它是"}, {"type": "subtitle", "time": 658.31, "timestamp": "00:10:58", "text": "复杂的。"}]
[{"type": "subtitle", "time": 17342.628, "timestamp": "04:49:02", "text": "最后两个是黄色的？两黄。好的。"}, {"type": "subtitle", "time": 17344.948, "timestamp": "04:49:04", "text": "呃"}, {"type": "subtitle", "time": 17348.55, "timestamp": "04:49:08", "text": "有红色电线吗？不。"}, {"type": "subtitle", "time": 17353.59, "timestamp": "04:49:13", "text": "呃，把最后一根电线剪断。最后一根电线。完毕。"}, {"type": "subtitle", "time": 17355.59, "timestamp": "04:49:15", "text": "好的。好的。"}, {"type": "subtitle", "time": 17361.03, "timestamp": "04:49:21", "text": "耶！"}, {"type": "subtitle", "time": 17375.11, "timestamp": "04:49:35", "text": "哦不，"}, {"type": "subtitle", "time": 17377.43, "timestamp": "04:49:37", "text": "别告诉我。 Zuchi Zuchi 仍然有"}, {"type": "subtitle", "time": 17379.67, "timestamp": "04:49:39", "text": "剩余时间超过我预期时间的两倍。什么"}, {"type": "subtitle", "time": 17383.67, "timestamp": "04:49:43", "text": "什么鬼，Zi？"}, {"type": "subtitle", "time": 17386.47, "timestamp": "04:49:46", "text": "我的天啊。"}, {"type": "subtitle", "time": 17393.67, "timestamp": "04:49:53", "text": "我可能得把音量调大点。"}]
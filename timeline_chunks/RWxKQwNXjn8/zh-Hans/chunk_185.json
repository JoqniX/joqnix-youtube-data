[{"type": "subtitle", "time": 11101.11, "timestamp": "03:05:01", "text": "杀手。你知道，嗯，有"}, {"type": "subtitle", "time": 11104.07, "timestamp": "03:05:04", "text": "屠夫。你的昵称是什么？"}, {"type": "subtitle", "time": 11110.469, "timestamp": "03:05:10", "text": "不"}, {"type": "subtitle", "time": 11112.95, "timestamp": "03:05:12", "text": "清楚的。不，我们需要它，它需要它需要"}, {"type": "subtitle", "time": 11116.469, "timestamp": "03:05:16", "text": "制造恐惧。"}, {"type": "subtitle", "time": 11119.429, "timestamp": "03:05:19", "text": "但我本身就是一个星座。所以你是"}, {"type": "subtitle", "time": 11123.83, "timestamp": "03:05:23", "text": "星座。是的。所以"}, {"type": "subtitle", "time": 11125.51, "timestamp": "03:05:25", "text": "令人悲哀的是，十二宫杀手"}, {"type": "subtitle", "time": 11133.59, "timestamp": "03:05:33", "text": "[音乐]"}, {"type": "subtitle", "time": 11136.79, "timestamp": "03:05:36", "text": "不，新模型就像……"}, {"type": "subtitle", "time": 11140.469, "timestamp": "03:05:40", "text": "最终boss。所以，哦，"}, {"type": "subtitle", "time": 11142.63, "timestamp": "03:05:42", "text": "我的天啊。我们可以称之为"}]
[{"type": "subtitle", "time": 10568.15, "timestamp": "02:56:08", "text": "坏人会离开。不，你得到了"}, {"type": "subtitle", "time": 10577.91, "timestamp": "02:56:17", "text": "什么？我？我的天啊。太没礼貌了。太没礼貌了。所以"}, {"type": "subtitle", "time": 10579.91, "timestamp": "02:56:19", "text": "粗鲁的。"}, {"type": "subtitle", "time": 10586.79, "timestamp": "02:56:26", "text": "我太喜欢这只雪貂了。它太可爱了。"}, {"type": "subtitle", "time": 10589.51, "timestamp": "02:56:29", "text": "我喜欢雪貂。"}, {"type": "subtitle", "time": 10591.03, "timestamp": "02:56:31", "text": "准备在周围画些小爱心"}, {"type": "subtitle", "time": 10592.81, "timestamp": "02:56:32", "text": "雪貂。"}, {"type": "subtitle", "time": 10598.53, "timestamp": "02:56:38", "text": "是的。"}, {"type": "subtitle", "time": 10605.83, "timestamp": "02:56:45", "text": "哇。我简直不敢相信你竟然是这样的人。"}, {"type": "subtitle", "time": 10614.23, "timestamp": "02:56:54", "text": "耶！你最喜欢做什么？"}, {"type": "subtitle", "time": 10617.269, "timestamp": "02:56:57", "text": "打平，乔克？"}]
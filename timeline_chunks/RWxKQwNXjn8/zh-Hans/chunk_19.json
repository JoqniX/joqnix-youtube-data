[{"type": "subtitle", "time": 1141.51, "timestamp": "00:19:01", "text": "是的。等等，等等，等等。不，我只是好奇。"}, {"type": "subtitle", "time": 1143.35, "timestamp": "00:19:03", "text": "好的，所以你早餐吃米饭。"}, {"type": "subtitle", "time": 1146.95, "timestamp": "00:19:06", "text": "你午饭吃什么？米。"}, {"type": "subtitle", "time": 1157.27, "timestamp": "00:19:17", "text": "你就像一座巍峨的高峰"}, {"type": "subtitle", "time": 1165.75, "timestamp": "00:19:25", "text": "我的天啊。等等，等等，等等，等等。好的，"}, {"type": "subtitle", "time": 1168.07, "timestamp": "00:19:28", "text": "好的。你早餐吃什么？比如，什么"}, {"type": "subtitle", "time": 1170.31, "timestamp": "00:19:30", "text": "你是和米饭一起吃的吗？呃，"}, {"type": "subtitle", "time": 1173.11, "timestamp": "00:19:33", "text": "里面到底有什么？"}, {"type": "subtitle", "time": 1175.27, "timestamp": "00:19:35", "text": "无论那里有什么，就像……"}, {"type": "subtitle", "time": 1178.47, "timestamp": "00:19:38", "text": "就像我说我喜欢说今晚我曾有"}, {"type": "subtitle", "time": 1180.63, "timestamp": "00:19:40", "text": "鸡肉咖喱之类的，还有"}, {"type": "subtitle", "time": 1182.63, "timestamp": "00:19:42", "text": "东西会在早上准备好，"}, {"type": "subtitle", "time": 1184.549, "timestamp": "00:19:44", "text": "不管做什么咖喱"}, {"type": "subtitle", "time": 1187.43, "timestamp": "00:19:47", "text": "那天下午的活动就安排在那里。"}, {"type": "subtitle", "time": 1191.35, "timestamp": "00:19:51", "text": "晚上再重复一遍。"}, {"type": "subtitle", "time": 1192.63, "timestamp": "00:19:52", "text": "是的。"}, {"type": "subtitle", "time": 1195.75, "timestamp": "00:19:55", "text": "医生，我需要你过来一趟。"}, {"type": "subtitle", "time": 1199.029, "timestamp": "00:19:59", "text": "所以我可以在这里吃你吃的东西"}]
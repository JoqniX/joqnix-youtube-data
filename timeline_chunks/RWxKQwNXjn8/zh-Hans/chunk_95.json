[{"type": "subtitle", "time": 5702.149, "timestamp": "01:35:02", "text": "哦，就是这样，我刚醒来。"}, {"type": "subtitle", "time": 5706.709, "timestamp": "01:35:06", "text": "我吃完饭，然后继续睡觉。"}, {"type": "subtitle", "time": 5708.95, "timestamp": "01:35:08", "text": "乔，你呢？最近怎么样？"}, {"type": "subtitle", "time": 5710.79, "timestamp": "01:35:10", "text": "为你？"}, {"type": "subtitle", "time": 5713.59, "timestamp": "01:35:13", "text": "我今天过得很平常。我一直"}, {"type": "subtitle", "time": 5716.709, "timestamp": "01:35:16", "text": "现在每天24小时不间断直播。"}, {"type": "subtitle", "time": 5720.709, "timestamp": "01:35:20", "text": "是啊，你最近挺忙的，小伙子。"}, {"type": "subtitle", "time": 5723.669, "timestamp": "01:35:23", "text": "我不知道。我不需要这么做。"}, {"type": "subtitle", "time": 5726.39, "timestamp": "01:35:26", "text": "不再是了。最初只是为了"}, {"type": "subtitle", "time": 5728.79, "timestamp": "01:35:28", "text": "YouTube 呃 YouTube 就像"}, {"type": "subtitle", "time": 5732.229, "timestamp": "01:35:32", "text": "盈利模式，比如观看时长。然后"}, {"type": "subtitle", "time": 5735.83, "timestamp": "01:35:35", "text": "自从我开始做这件事以来，我就一直是这样。"}, {"type": "subtitle", "time": 5739.59, "timestamp": "01:35:39", "text": "阻止不了。我不知道为什么"}, {"type": "subtitle", "time": 5742.709, "timestamp": "01:35:42", "text": "就像结束一样，结束真的很难。"}, {"type": "subtitle", "time": 5747.03, "timestamp": "01:35:47", "text": "溪流。按钮就在那里。"}, {"type": "subtitle", "time": 5749.75, "timestamp": "01:35:49", "text": "我不能。但你必须确保你"}, {"type": "subtitle", "time": 5752.47, "timestamp": "01:35:52", "text": "你也在休息，你"}, {"type": "subtitle", "time": 5755.189, "timestamp": "01:35:55", "text": "休息是因为你不仅仅是"}, {"type": "subtitle", "time": 5757.43, "timestamp": "01:35:57", "text": "让主线慢跑。你也在慢跑"}]
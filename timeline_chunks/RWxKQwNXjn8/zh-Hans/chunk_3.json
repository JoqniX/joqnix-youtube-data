[{"type": "subtitle", "time": 189.35, "timestamp": "00:03:09", "text": "是的，我懂你的感受。我记得我的第一次"}, {"type": "subtitle", "time": 191.99, "timestamp": "00:03:11", "text": "我玩Minecraft的时间就是我。"}, {"type": "subtitle", "time": 194.949, "timestamp": "00:03:14", "text": "击倒爬行者，"}, {"type": "subtitle", "time": 197.43, "timestamp": "00:03:17", "text": "蜘蛛、骷髅、骷髅，还有那个人"}, {"type": "subtitle", "time": 200.39, "timestamp": "00:03:20", "text": "我赤手空拳，因为我不知道。"}, {"type": "subtitle", "time": 202.949, "timestamp": "00:03:22", "text": "关于这些工具和"}, {"type": "subtitle", "time": 204.55, "timestamp": "00:03:24", "text": "你需要的剑，我不知道。"}, {"type": "subtitle", "time": 208.22899999999998, "timestamp": "00:03:28", "text": "制作材料等等。"}, {"type": "subtitle", "time": 211.36, "timestamp": "00:03:31", "text": "太好玩了。"}, {"type": "subtitle", "time": 213.19, "timestamp": "00:03:33", "text": "[音乐]"}, {"type": "subtitle", "time": 216.789, "timestamp": "00:03:36", "text": "用你的武器痛扁怪物真是太有趣了"}, {"type": "subtitle", "time": 221.91, "timestamp": "00:03:41", "text": "利用我的第一人称射击游戏技巧进行BFS，躲避"}, {"type": "subtitle", "time": 225.99, "timestamp": "00:03:45", "text": "躲避混蛋"}, {"type": "subtitle", "time": 228.22899999999998, "timestamp": "00:03:48", "text": "太好玩了。"}, {"type": "subtitle", "time": 231.11, "timestamp": "00:03:51", "text": "但它也是硬核的"}, {"type": "subtitle", "time": 234.869, "timestamp": "00:03:54", "text": "而且我也像这样死了"}]
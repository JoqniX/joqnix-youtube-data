[{"type": "subtitle", "time": 9421.429, "timestamp": "02:37:01", "text": "男人？ J 时刻。你他妈是什么东西？"}, {"type": "subtitle", "time": 9423.51, "timestamp": "02:37:03", "text": "你想对我做什么？嗯？远离"}, {"type": "subtitle", "time": 9437.03, "timestamp": "02:37:17", "text": "我知道。作为道歉，我将画"}, {"type": "subtitle", "time": 9439.59, "timestamp": "02:37:19", "text": "波兰这个国家。"}, {"type": "subtitle", "time": 9442.469, "timestamp": "02:37:22", "text": "是的。我该如何画图？"}, {"type": "subtitle", "time": 9445.19, "timestamp": "02:37:25", "text": "好的。只是"}, {"type": "subtitle", "time": 9447.67, "timestamp": "02:37:27", "text": "我将把波兰这个国家画出来"}, {"type": "subtitle", "time": 9453.349, "timestamp": "02:37:33", "text": "坚持，稍等。它看起来怎么样？"}, {"type": "subtitle", "time": 9455.51, "timestamp": "02:37:35", "text": "它的白色在上，红色在下。"}, {"type": "subtitle", "time": 9457.91, "timestamp": "02:37:37", "text": "底部。"}, {"type": "subtitle", "time": 9461.429, "timestamp": "02:37:41", "text": "[音乐]"}, {"type": "subtitle", "time": 9464.63, "timestamp": "02:37:44", "text": "波兰国歌。"}, {"type": "subtitle", "time": 9467.91, "timestamp": "02:37:47", "text": "对不起。对不起。"}, {"type": "subtitle", "time": 9469.91, "timestamp": "02:37:49", "text": "我不知道该怎么做。你说的唱歌是什么意思？"}, {"type": "subtitle", "time": 9472.55, "timestamp": "02:37:52", "text": "波兰国民？我不，我不能"}, {"type": "subtitle", "time": 9475.349, "timestamp": "02:37:55", "text": "我甚至连“我”这个音都发不出来。"}, {"type": "subtitle", "time": 9477.75, "timestamp": "02:37:57", "text": "连波兰语都念不出来。你想要我"}]
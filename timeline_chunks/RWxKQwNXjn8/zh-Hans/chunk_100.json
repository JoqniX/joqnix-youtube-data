[{"type": "subtitle", "time": 6001.99, "timestamp": "01:40:01", "text": "很多时候，就像妈妈集市一样"}, {"type": "subtitle", "time": 6004.87, "timestamp": "01:40:04", "text": "她即将分娩，就像她喜欢的那样。"}, {"type": "subtitle", "time": 6007.109, "timestamp": "01:40:07", "text": "她会抓住那人的手"}, {"type": "subtitle", "time": 6008.709, "timestamp": "01:40:08", "text": "人"}, {"type": "subtitle", "time": 6010.95, "timestamp": "01:40:10", "text": "她会像你知道的那样带他们去"}, {"type": "subtitle", "time": 6013.669, "timestamp": "01:40:13", "text": "她的孩子在哪里，因为她"}, {"type": "subtitle", "time": 6016.07, "timestamp": "01:40:16", "text": "她希望你在场，而且她有点……"}, {"type": "subtitle", "time": 6018.07, "timestamp": "01:40:18", "text": "也把这个人当婴儿一样对待。"}, {"type": "subtitle", "time": 6039.83, "timestamp": "01:40:39", "text": "你知道吗？我，我要去，我是"}, {"type": "subtitle", "time": 6042.149, "timestamp": "01:40:42", "text": "准备为你的你的你的配饰"}, {"type": "subtitle", "time": 6045.109, "timestamp": "01:40:45", "text": "熊猫。好的。我要给他"}, {"type": "subtitle", "time": 6047.27, "timestamp": "01:40:47", "text": "配件。我要给他就像"}, {"type": "subtitle", "time": 6048.87, "timestamp": "01:40:48", "text": "你的"}, {"type": "subtitle", "time": 6050.709, "timestamp": "01:40:50", "text": "我该送他什么？请随意去做"}, {"type": "subtitle", "time": 6052.79, "timestamp": "01:40:52", "text": "那。是的。"}, {"type": "subtitle", "time": 6057.99, "timestamp": "01:40:57", "text": "我不介意的话，我就停下来吧，嗯……"}]
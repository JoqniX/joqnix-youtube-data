[{"type": "subtitle", "time": 15786.71, "timestamp": "04:23:06", "text": "想要。"}, {"type": "subtitle", "time": 15788.79, "timestamp": "04:23:08", "text": "好的。"}, {"type": "subtitle", "time": 15792.309, "timestamp": "04:23:12", "text": "你们喜欢吃酸黄瓜吗？"}, {"type": "subtitle", "time": 15796.469, "timestamp": "04:23:16", "text": "我也不知道自己为什么会如此迷恋腌黄瓜。"}, {"type": "subtitle", "time": 15799.11, "timestamp": "04:23:19", "text": "如果我看到一根酸黄瓜，"}, {"type": "subtitle", "time": 15802.71, "timestamp": "04:23:22", "text": "比如说你买了一根500克的腌黄瓜，"}, {"type": "subtitle", "time": 15807.67, "timestamp": "04:23:27", "text": "好的？看着我一天之内完成它"}, {"type": "subtitle", "time": 15810.309, "timestamp": "04:23:30", "text": "大概几个小时吧。"}, {"type": "subtitle", "time": 15812.55, "timestamp": "04:23:32", "text": "我上瘾了。"}, {"type": "subtitle", "time": 15815.349, "timestamp": "04:23:35", "text": "就像各种腌菜一样。"}, {"type": "subtitle", "time": 15817.83, "timestamp": "04:23:37", "text": "我不知道。是的，香料"}, {"type": "subtitle", "time": 15820.389, "timestamp": "04:23:40", "text": "泡菜就像人一样，他们吃……"}, {"type": "subtitle", "time": 15824.149, "timestamp": "04:23:44", "text": "当你……的时候，稍微有点"}, {"type": "subtitle", "time": 15827.03, "timestamp": "04:23:47", "text": "吃印度香饭或其他什么"}, {"type": "subtitle", "time": 15830.71, "timestamp": "04:23:50", "text": "呃，你正在吃什么？"}, {"type": "subtitle", "time": 15833.75, "timestamp": "04:23:53", "text": "我不知道为什么我这么喜欢它。"}]
[{"type": "subtitle", "time": 9304.95, "timestamp": "02:35:04", "text": "真可爱。你们对我太坏了"}, {"type": "subtitle", "time": 9306.63, "timestamp": "02:35:06", "text": "小家伙。你们这些人太坏了。看"}, {"type": "subtitle", "time": 9309.99, "timestamp": "02:35:09", "text": "看着他。他个子很小。"}, {"type": "subtitle", "time": 9318.95, "timestamp": "02:35:18", "text": "对不起。对不起。问：以及你的"}, {"type": "subtitle", "time": 9335.67, "timestamp": "02:35:35", "text": "我发誓，我发誓，我就是，我就是，我就是"}, {"type": "subtitle", "time": 9339.99, "timestamp": "02:35:39", "text": "坏的。我有口吃。"}, {"type": "subtitle", "time": 9342.63, "timestamp": "02:35:42", "text": "我没开玩笑。我的身体其实就像"}, {"type": "subtitle", "time": 9345.67, "timestamp": "02:35:45", "text": "形状不对。我觉得你，我不这么认为"}, {"type": "subtitle", "time": 9347.27, "timestamp": "02:35:47", "text": "不知道我有没有在直播中说过这句话，"}, {"type": "subtitle", "time": 9348.63, "timestamp": "02:35:48", "text": "但你们知道你们的嘴是什么样的。"}, {"type": "subtitle", "time": 9350.79, "timestamp": "02:35:50", "text": "应该长这样吗？就像这样"}, {"type": "subtitle", "time": 9352.79, "timestamp": "02:35:52", "text": "就像你的嘴巴，就像你的形状"}, {"type": "subtitle", "time": 9355.75, "timestamp": "02:35:55", "text": "就像你知道的那样，在你嘴里。"}, {"type": "subtitle", "time": 9358.55, "timestamp": "02:35:58", "text": "你的图表长什么样？是的。所以"}]
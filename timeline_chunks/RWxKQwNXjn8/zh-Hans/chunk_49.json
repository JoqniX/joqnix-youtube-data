[{"type": "subtitle", "time": 2947.829, "timestamp": "00:49:07", "text": "抱歉，伙计，让你产生了幻想。"}, {"type": "subtitle", "time": 2950.15, "timestamp": "00:49:10", "text": "孩子伤心了。这不是我的孩子。它不是"}, {"type": "subtitle", "time": 2952.15, "timestamp": "00:49:12", "text": "我的孩子，但你这样做会让孩子伤心。"}, {"type": "subtitle", "time": 2954.15, "timestamp": "00:49:14", "text": "你对此有何感想？嗯？你是"}, {"type": "subtitle", "time": 2959.67, "timestamp": "00:49:19", "text": "欺凌儿童。欺凌儿童。"}, {"type": "subtitle", "time": 2961.91, "timestamp": "00:49:21", "text": "真乱来。你不应该欺凌他人。"}, {"type": "subtitle", "time": 2981.43, "timestamp": "00:49:41", "text": "好的。确实如此。确实如此。确实如此。"}, {"type": "subtitle", "time": 2983.349, "timestamp": "00:49:43", "text": "看起来不太妙。但就像你一样"}, {"type": "subtitle", "time": 2985.589, "timestamp": "00:49:45", "text": "欺凌儿童。好的。你这是在欺凌弱小。"}, {"type": "subtitle", "time": 2987.589, "timestamp": "00:49:47", "text": "一个孩子。你欺凌了孩子。你应该"}, {"type": "subtitle", "time": 2990.23, "timestamp": "00:49:50", "text": "感到羞愧。好的。你"}, {"type": "subtitle", "time": 2992.47, "timestamp": "00:49:52", "text": "应该感到羞愧和悲伤，"}, {"type": "subtitle", "time": 2994.309, "timestamp": "00:49:54", "text": "堕胎药。"}]
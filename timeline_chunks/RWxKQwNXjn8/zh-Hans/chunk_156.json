[{"type": "subtitle", "time": 9361.349, "timestamp": "02:36:01", "text": "我的嘴型是这样的。就这样"}, {"type": "subtitle", "time": 9363.349, "timestamp": "02:36:03", "text": "像这样。"}, {"type": "subtitle", "time": 9366.63, "timestamp": "02:36:06", "text": "所以，其实我并不笨。"}, {"type": "subtitle", "time": 9368.309, "timestamp": "02:36:08", "text": "好的？我没有，我没有这样做"}, {"type": "subtitle", "time": 9372.07, "timestamp": "02:36:12", "text": "目的。我的天哪，我其实说不出话来。"}, {"type": "subtitle", "time": 9374.55, "timestamp": "02:36:14", "text": "适当地。"}, {"type": "subtitle", "time": 9376.63, "timestamp": "02:36:16", "text": "和奶奶一起看了会儿剧。"}, {"type": "subtitle", "time": 9388.469, "timestamp": "02:36:28", "text": "我发誓我发誓我发誓我的意思是，那是"}, {"type": "subtitle", "time": 9397.67, "timestamp": "02:36:37", "text": "我的天哪，乔。我觉得我觉得我觉得"}, {"type": "subtitle", "time": 9399.67, "timestamp": "02:36:39", "text": "我们冒犯了整个国家。"}, {"type": "subtitle", "time": 9402.79, "timestamp": "02:36:42", "text": "波兰。哦不，"}, {"type": "subtitle", "time": 9404.309, "timestamp": "02:36:44", "text": "约翰。我不认为我们可以去"}, {"type": "subtitle", "time": 9407.75, "timestamp": "02:36:47", "text": "波兰已不复存在。我的天啊。我不"}, {"type": "subtitle", "time": 9410.07, "timestamp": "02:36:50", "text": "我觉得我们还能去波兰。哦"}, {"type": "subtitle", "time": 9413.83, "timestamp": "02:36:53", "text": "不。是的。不，它关了。"}, {"type": "subtitle", "time": 9415.429, "timestamp": "02:36:55", "text": "遗愿清单。它掉出桶了"}, {"type": "subtitle", "time": 9417.349, "timestamp": "02:36:57", "text": "列表。"}, {"type": "subtitle", "time": 9419.91, "timestamp": "02:36:59", "text": "哦不，那糟了。你说的“一个”是什么意思？"}]
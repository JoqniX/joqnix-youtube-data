[{"type": "subtitle", "time": 6672.229, "timestamp": "01:51:12", "text": "为什么我的琴格看起来像狮子？"}, {"type": "subtitle", "time": 6673.99, "timestamp": "01:51:13", "text": "说实话，他们确实有……"}, {"type": "subtitle", "time": 6676.629, "timestamp": "01:51:16", "text": "你一旦画出像长身子那样的东西，它"}, {"type": "subtitle", "time": 6678.87, "timestamp": "01:51:18", "text": "看起来像琴格。你只需要"}, {"type": "subtitle", "time": 6682.629, "timestamp": "01:51:22", "text": "相信过程。"}, {"type": "subtitle", "time": 6687.189, "timestamp": "01:51:27", "text": "过程或一切都会到来"}, {"type": "subtitle", "time": 6697.03, "timestamp": "01:51:37", "text": "我们必须要有自信，一旦你"}, {"type": "subtitle", "time": 6699.35, "timestamp": "01:51:39", "text": "相信其他一切都会迎刃而解"}, {"type": "subtitle", "time": 6718.39, "timestamp": "01:51:58", "text": "我的意思是，我有没有给你看过那个？"}]
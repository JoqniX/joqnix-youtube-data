[{"type": "subtitle", "time": 5821.03, "timestamp": "01:37:01", "text": "也在回忆往事。所以，我不认为"}, {"type": "subtitle", "time": 5824.07, "timestamp": "01:37:04", "text": "无论从哪个方面来看，这都很糟糕。只要你"}, {"type": "subtitle", "time": 5826.229, "timestamp": "01:37:06", "text": "坦诚地说明你在做什么，"}, {"type": "subtitle", "time": 5827.99, "timestamp": "01:37:07", "text": "你知道，没有人像，你知道，"}, {"type": "subtitle", "time": 5830.39, "timestamp": "01:37:10", "text": "事情大概就是这样，哦，你知道，哦，他是"}, {"type": "subtitle", "time": 5832.87, "timestamp": "01:37:12", "text": "作弊。"}, {"type": "subtitle", "time": 5835.27, "timestamp": "01:37:15", "text": "约翰，你没有作弊。别，别"}, {"type": "subtitle", "time": 5838.31, "timestamp": "01:37:18", "text": "为此感到压力。"}, {"type": "subtitle", "time": 5841.109, "timestamp": "01:37:21", "text": "是啊，你得好好想想。如果"}, {"type": "subtitle", "time": 5843.99, "timestamp": "01:37:23", "text": "这件事是别人做的。"}, {"type": "subtitle", "time": 5845.83, "timestamp": "01:37:25", "text": "你也做同样的事情，好吗？"}, {"type": "subtitle", "time": 5849.109, "timestamp": "01:37:29", "text": "有问题吗？不。"}, {"type": "subtitle", "time": 5850.709, "timestamp": "01:37:30", "text": "是的。那么你应该不会有问题。"}, {"type": "subtitle", "time": 5854.87, "timestamp": "01:37:34", "text": "你这样做。嗯。其中最"}, {"type": "subtitle", "time": 5858.39, "timestamp": "01:37:38", "text": "像我曾经收到的那些重要的建议一样。"}, {"type": "subtitle", "time": 5860.709, "timestamp": "01:37:40", "text": "听说你应该把自己交给自己"}, {"type": "subtitle", "time": 5862.79, "timestamp": "01:37:42", "text": "你给予他人的那种善意"}, {"type": "subtitle", "time": 5865.03, "timestamp": "01:37:45", "text": "人们，"}, {"type": "subtitle", "time": 5866.55, "timestamp": "01:37:46", "text": "正确的？你也应该给予同样的善意。"}, {"type": "subtitle", "time": 5868.95, "timestamp": "01:37:48", "text": "你给予他人。哦，是的。如果"}, {"type": "subtitle", "time": 5871.51, "timestamp": "01:37:51", "text": "如果你是……如果……如果你会很友善"}, {"type": "subtitle", "time": 5873.669, "timestamp": "01:37:53", "text": "你应该就某事对某人说"}, {"type": "subtitle", "time": 5875.669, "timestamp": "01:37:55", "text": "你应该善待自己。"}, {"type": "subtitle", "time": 5877.35, "timestamp": "01:37:57", "text": "也。"}, {"type": "subtitle", "time": 5878.87, "timestamp": "01:37:58", "text": "M"}]
[{"type": "subtitle", "time": 7502.31, "timestamp": "02:05:02", "text": "我的天啊，文尼。这时我的汗都红了"}, {"type": "subtitle", "time": 7506.07, "timestamp": "02:05:06", "text": "说得对，兄弟。我觉得你需要"}, {"type": "subtitle", "time": 7508.79, "timestamp": "02:05:08", "text": "比如喝点东西来搭配其他食物。"}, {"type": "subtitle", "time": 7512.31, "timestamp": "02:05:12", "text": "我不知道。也许只是我个人的感觉，但是"}, {"type": "subtitle", "time": 7514.39, "timestamp": "02:05:14", "text": "你现在就像个运动员一样"}, {"type": "subtitle", "time": 7521.91, "timestamp": "02:05:21", "text": "你知道，每个人都有那么一个。"}, {"type": "subtitle", "time": 7524.31, "timestamp": "02:05:24", "text": "他们永远吃不腻的食物。为我，"}, {"type": "subtitle", "time": 7529.189, "timestamp": "02:05:29", "text": "是三明治。我喜欢三明治。"}, {"type": "subtitle", "time": 7539.35, "timestamp": "02:05:39", "text": "我妈妈做的炒饭很好吃。真是太"}, {"type": "subtitle", "time": 7541.109, "timestamp": "02:05:41", "text": "好的。"}, {"type": "subtitle", "time": 7544.229, "timestamp": "02:05:44", "text": "哦，你哪天会做饭呢？我知道如何"}, {"type": "subtitle", "time": 7547.75, "timestamp": "02:05:47", "text": "厨师。我偶尔会做饭，但通常"}, {"type": "subtitle", "time": 7551.35, "timestamp": "02:05:51", "text": "是我妈妈做饭。"}, {"type": "subtitle", "time": 7553.189, "timestamp": "02:05:53", "text": "因为我最后变得懒惰，而且我的"}, {"type": "subtitle", "time": 7555.109, "timestamp": "02:05:55", "text": "妈妈说：“你拿得太多了。”"}]
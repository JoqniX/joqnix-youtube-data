[{"type": "subtitle", "time": 10921.83, "timestamp": "03:02:01", "text": "京都的房子，好吗？就像双关漫画"}, {"type": "subtitle", "time": 10924.63, "timestamp": "03:02:04", "text": "骗子，对吧？他们都是，还有你。"}, {"type": "subtitle", "time": 10927.91, "timestamp": "03:02:07", "text": "我知道我当时就像穆拉乘公交车走了一样。我"}, {"type": "subtitle", "time": 10929.429, "timestamp": "03:02:09", "text": "决定去看看他，就像跟他说“嘿，伙计”。"}, {"type": "subtitle", "time": 10931.19, "timestamp": "03:02:11", "text": "你还好吗？"}, {"type": "subtitle", "time": 10933.269, "timestamp": "03:02:13", "text": "是啊，我们聊过。这一切都是"}, {"type": "subtitle", "time": 10936.469, "timestamp": "03:02:16", "text": "nice 就是一切都很美好。然后我"}, {"type": "subtitle", "time": 10939.75, "timestamp": "03:02:19", "text": "令人不寒而栗。我在风险投资行业。突然，我得到了"}, {"type": "subtitle", "time": 10943.75, "timestamp": "03:02:23", "text": "Mura 焦急的语音留言"}, {"type": "subtitle", "time": 10948.23, "timestamp": "03:02:28", "text": "比如，“伙计，伙计，乔要走了"}, {"type": "subtitle", "time": 10951.269, "timestamp": "03:02:31", "text": "疯狂的。他在杀人。乔是"}, {"type": "subtitle", "time": 10953.99, "timestamp": "03:02:33", "text": "他要去杀光所有人。"}, {"type": "subtitle", "time": 10957.11, "timestamp": "03:02:37", "text": "他甚至都害怕丢掉性命了，伙计。” 我是"}, {"type": "subtitle", "time": 10960.87, "timestamp": "03:02:40", "text": "比如，“兄弟，到底怎么回事？”而且我"}, {"type": "subtitle", "time": 10963.75, "timestamp": "03:02:43", "text": "听到这焦急的声音，又听到另一个焦急的声音，"}, {"type": "subtitle", "time": 10966.71, "timestamp": "03:02:46", "text": "但Eon看起来很害怕。他将要"}, {"type": "subtitle", "time": 10969.349, "timestamp": "03:02:49", "text": "他在睡梦中去世。他必死无疑"}, {"type": "subtitle", "time": 10971.99, "timestamp": "03:02:51", "text": "他的睡眠，伙计。我的天啊。乔克要走了"}, {"type": "subtitle", "time": 10975.269, "timestamp": "03:02:55", "text": "杀光所有人。"}, {"type": "subtitle", "time": 10977.75, "timestamp": "03:02:57", "text": "我不。他们会说，“J 不是你认识的那个人。”"}]
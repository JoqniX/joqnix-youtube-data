[{"type": "subtitle", "time": 5400.629, "timestamp": "01:30:00", "text": "他们划定了界限，而我们没有。"}, {"type": "subtitle", "time": 5436.229, "timestamp": "01:30:36", "text": "尾部做得不错。那真不错"}, {"type": "subtitle", "time": 5443.83, "timestamp": "01:30:43", "text": "我以前也很喜欢画轮子。"}, {"type": "subtitle", "time": 5445.43, "timestamp": "01:30:45", "text": "就像那是我最先想到的事情之一"}, {"type": "subtitle", "time": 5448.149, "timestamp": "01:30:48", "text": "我刚拿到笔记本电脑的时候就开始画画了。"}, {"type": "subtitle", "time": 5451.11, "timestamp": "01:30:51", "text": "还有我的绘图板。是的。我画得像"}, {"type": "subtitle", "time": 5454.31, "timestamp": "01:30:54", "text": "我喜欢我以前的画作。他们是"}, {"type": "subtitle", "time": 5457.09, "timestamp": "01:30:57", "text": "他们当时真是超级前卫什么的。"}]
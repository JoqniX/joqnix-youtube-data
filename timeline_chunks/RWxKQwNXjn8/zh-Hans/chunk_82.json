[{"type": "subtitle", "time": 4929.51, "timestamp": "01:22:09", "text": "好的？完美的。"}, {"type": "subtitle", "time": 4934.95, "timestamp": "01:22:14", "text": "喵。迪奥。喵。迪奥。是的。"}, {"type": "subtitle", "time": 4937.27, "timestamp": "01:22:17", "text": "每当我想起运动员，我脑海里就浮现出各种各样的画面。"}, {"type": "subtitle", "time": 4940.55, "timestamp": "01:22:20", "text": "我能想到的就是迪奥。"}, {"type": "subtitle", "time": 4942.39, "timestamp": "01:22:22", "text": "每当我想到任何时候"}, {"type": "subtitle", "time": 4945.03, "timestamp": "01:22:25", "text": "有人提到迪奥，我就会想到……"}, {"type": "subtitle", "time": 4951.75, "timestamp": "01:22:31", "text": "算了，不。迪奥，你为什么还不死？"}, {"type": "subtitle", "time": 4959.43, "timestamp": "01:22:39", "text": "豌豆多少钱？你想喝酒"}, {"type": "subtitle", "time": 4961.27, "timestamp": "01:22:41", "text": "我？你不能喝我。你不能"}, {"type": "subtitle", "time": 4963.83, "timestamp": "01:22:43", "text": "买得起我的罐子。如果你在说话的话"}, {"type": "subtitle", "time": 4966.55, "timestamp": "01:22:46", "text": "就像买个模型一样，我想是这样的。"}, {"type": "subtitle", "time": 4974.07, "timestamp": "01:22:54", "text": "好了，现在该画一个运动员了。"}, {"type": "subtitle", "time": 4976.79, "timestamp": "01:22:56", "text": "鱼。"}, {"type": "subtitle", "time": 4979.669, "timestamp": "01:22:59", "text": "我的天哪，你这是要全力以赴啊？"}]
[{"type": "subtitle", "time": 5881.75, "timestamp": "01:38:01", "text": "乔，你是我见过最善良的人。"}, {"type": "subtitle", "time": 5883.75, "timestamp": "01:38:03", "text": "知道。你你你你如此你"}, {"type": "subtitle", "time": 5885.99, "timestamp": "01:38:05", "text": "你真好。"}, {"type": "subtitle", "time": 5893.189, "timestamp": "01:38:13", "text": "是的。"}, {"type": "subtitle", "time": 5894.709, "timestamp": "01:38:14", "text": "你好。"}, {"type": "subtitle", "time": 5897.75, "timestamp": "01:38:17", "text": "是的。这就是我们认识和喜爱的运动健将。"}, {"type": "subtitle", "time": 5901.109, "timestamp": "01:38:21", "text": "乔克是个强壮的男孩。他非常强壮"}, {"type": "subtitle", "time": 5903.91, "timestamp": "01:38:23", "text": "一个勤奋的男孩。"}, {"type": "subtitle", "time": 5906.07, "timestamp": "01:38:26", "text": "啊，谢谢。"}, {"type": "subtitle", "time": 5913.59, "timestamp": "01:38:33", "text": "那真是太棒了"}, {"type": "subtitle", "time": 5921.27, "timestamp": "01:38:41", "text": "很好。干得好，兄弟。是吗？"}, {"type": "subtitle", "time": 5924.07, "timestamp": "01:38:44", "text": "这是你第一次画车轮吗？是的。"}, {"type": "subtitle", "time": 5933.27, "timestamp": "01:38:53", "text": "我的天啊。现在我得画一只猫。"}, {"type": "subtitle", "time": 5935.51, "timestamp": "01:38:55", "text": "正确的？不。呃"}, {"type": "subtitle", "time": 5938.07, "timestamp": "01:38:58", "text": "那是什么生物？"}]
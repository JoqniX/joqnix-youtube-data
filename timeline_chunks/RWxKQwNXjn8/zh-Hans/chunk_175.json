[{"type": "subtitle", "time": 10505.59, "timestamp": "02:55:05", "text": "90K 的时候会发生什么？不，我会"}, {"type": "subtitle", "time": 10508.469, "timestamp": "02:55:08", "text": "我会在聊天中给你VIP待遇。就是这样"}, {"type": "subtitle", "time": 10510.23, "timestamp": "02:55:10", "text": "事情发生了。"}, {"type": "subtitle", "time": 10513.429, "timestamp": "02:55:13", "text": "另外，现在是我这边的凌晨2点。我的天啊。"}, {"type": "subtitle", "time": 10516.63, "timestamp": "02:55:16", "text": "盖子上放着披萨。整个"}, {"type": "subtitle", "time": 10518.71, "timestamp": "02:55:18", "text": "你们不准招惹他们"}, {"type": "subtitle", "time": 10521.03, "timestamp": "02:55:21", "text": "罐子。你不是你不能碰它"}, {"type": "subtitle", "time": 10525.11, "timestamp": "02:55:25", "text": "罐。糟糕的聊天。坏的。坏的。"}, {"type": "subtitle", "time": 10527.59, "timestamp": "02:55:27", "text": "这是一次糟糕的聊天。"}, {"type": "subtitle", "time": 10531.03, "timestamp": "02:55:31", "text": "注意你的言行。我就是我，就是这样。"}, {"type": "subtitle", "time": 10533.03, "timestamp": "02:55:33", "text": "我要把聊天功能关进监狱。聊天就是聊天"}, {"type": "subtitle", "time": 10536.63, "timestamp": "02:55:36", "text": "聊天功能被禁用了。"}, {"type": "subtitle", "time": 10541.429, "timestamp": "02:55:41", "text": "这是监狱。因为聊天被关进监狱。"}, {"type": "subtitle", "time": 10551.19, "timestamp": "02:55:51", "text": "进入吉他。"}]
[{"type": "subtitle", "time": 7866.47, "timestamp": "02:11:06", "text": "黄油鸡。"}, {"type": "subtitle", "time": 7870.149, "timestamp": "02:11:10", "text": "我看着它，就像我的"}, {"type": "subtitle", "time": 7872.149, "timestamp": "02:11:12", "text": "问题是，我妈妈给我看了，然后她"}, {"type": "subtitle", "time": 7873.75, "timestamp": "02:11:13", "text": "就像，你知道，我曾经很喜欢"}, {"type": "subtitle", "time": 7875.589, "timestamp": "02:11:15", "text": "我喜欢杰米·奥利弗，但在看了他的节目后……"}, {"type": "subtitle", "time": 7878.149, "timestamp": "02:11:18", "text": "她当时说，我无法原谅他。"}, {"type": "subtitle", "time": 7880.92, "timestamp": "02:11:20", "text": "因为他所做的一切。"}, {"type": "subtitle", "time": 7885.91, "timestamp": "02:11:25", "text": "我认为不应该允许他这样做。"}, {"type": "subtitle", "time": 7888.629, "timestamp": "02:11:28", "text": "尝尝印度菜。"}, {"type": "subtitle", "time": 7891.35, "timestamp": "02:11:31", "text": "就是有罗叔叔的那部。罗叔叔"}, {"type": "subtitle", "time": 7893.99, "timestamp": "02:11:33", "text": "太好了。"}, {"type": "subtitle", "time": 7895.589, "timestamp": "02:11:35", "text": "问题是英国人好像……"}, {"type": "subtitle", "time": 7897.189, "timestamp": "02:11:37", "text": "他们吃了黄油鸡，然后声称"}, {"type": "subtitle", "time": 7899.43, "timestamp": "02:11:39", "text": "就像在那里，那是他们自己的，然后他们"}, {"type": "subtitle", "time": 7902.069, "timestamp": "02:11:42", "text": "像这样对它做这种事，兄弟，保持你的"}, {"type": "subtitle", "time": 7905.75, "timestamp": "02:11:45", "text": "我的手远离我国家的食物"}, {"type": "subtitle", "time": 7908.39, "timestamp": "02:11:48", "text": "文化"}, {"type": "subtitle", "time": 7913.189, "timestamp": "02:11:53", "text": "我自己制造麝香和耶稣"}, {"type": "subtitle", "time": 7915.669, "timestamp": "02:11:55", "text": "哦，不"}, {"type": "subtitle", "time": 7917.27, "timestamp": "02:11:57", "text": "玛萨拉"}]
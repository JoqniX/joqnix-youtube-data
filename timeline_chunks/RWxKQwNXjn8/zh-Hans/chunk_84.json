[{"type": "subtitle", "time": 5051.11, "timestamp": "01:24:11", "text": "好的，找到匹配项。所以，回到正题……"}, {"type": "subtitle", "time": 5055.99, "timestamp": "01:24:15", "text": "研磨。当然。去买面包"}, {"type": "subtitle", "time": 5058.709, "timestamp": "01:24:18", "text": "我想，大概就是提升一个等级吧。"}, {"type": "subtitle", "time": 5061.43, "timestamp": "01:24:21", "text": "祝你好运。"}, {"type": "subtitle", "time": 5064.95, "timestamp": "01:24:24", "text": "人们为什么玩游戏？他们为什么喜欢"}, {"type": "subtitle", "time": 5067.51, "timestamp": "01:24:27", "text": "联盟？我不明白。我的意思是，要成为"}, {"type": "subtitle", "time": 5071.03, "timestamp": "01:24:31", "text": "说实话，英雄联盟真的很有趣。而且，它就像"}, {"type": "subtitle", "time": 5073.35, "timestamp": "01:24:33", "text": "它就像太阳一样。你知道太阳是什么吗？"}, {"type": "subtitle", "time": 5076.87, "timestamp": "01:24:36", "text": "成本谬误，对吧？没有。好的。所以，"}, {"type": "subtitle", "time": 5079.11, "timestamp": "01:24:39", "text": "太阳导致谬误就像你曾经……"}, {"type": "subtitle", "time": 5081.669, "timestamp": "01:24:41", "text": "像时间一样沉浸其中"}, {"type": "subtitle", "time": 5084.47, "timestamp": "01:24:44", "text": "即使它就像一艘正在下沉的船，"}, {"type": "subtitle", "time": 5086.229, "timestamp": "01:24:46", "text": "好像你还是不想放弃它。"}, {"type": "subtitle", "time": 5090.47, "timestamp": "01:24:50", "text": "你知道，就像那种很烂的游戏一样"}, {"type": "subtitle", "time": 5093.03, "timestamp": "01:24:53", "text": "你知道你讨厌，但就像你总是那样"}, {"type": "subtitle", "time": 5095.59, "timestamp": "01:24:55", "text": "花那么多时间，就像你总是那样。"}, {"type": "subtitle", "time": 5097.83, "timestamp": "01:24:57", "text": "投入了那么多钱，你根本做不到"}, {"type": "subtitle", "time": 5099.83, "timestamp": "01:24:59", "text": "算了。所以即使一切"}]
[{"type": "subtitle", "time": 3360.23, "timestamp": "00:56:00", "text": "好的。这简直太疯狂了。因为我"}, {"type": "subtitle", "time": 3363.51, "timestamp": "00:56:03", "text": "我喜欢面纱，我喜欢我喜欢"}, {"type": "subtitle", "time": 3366.71, "timestamp": "00:56:06", "text": "神话。所以，我就想，我刚刚"}, {"type": "subtitle", "time": 3370.309, "timestamp": "00:56:10", "text": "我反复尝试各种组合，直到得到一个。"}, {"type": "subtitle", "time": 3373.19, "timestamp": "00:56:13", "text": "那块地还没被占用。"}, {"type": "subtitle", "time": 3376.39, "timestamp": "00:56:16", "text": "啊，是的。我真的很喜欢"}, {"type": "subtitle", "time": 3377.75, "timestamp": "00:56:17", "text": "鲸鱼。我曾想成为一名海军陆战队员。"}, {"type": "subtitle", "time": 3380.549, "timestamp": "00:56:20", "text": "实际上，我是一名生物学家。"}, {"type": "subtitle", "time": 3384.309, "timestamp": "00:56:24", "text": "哦，是的。我做不到，但是，"}, {"type": "subtitle", "time": 3387.109, "timestamp": "00:56:27", "text": "你知道吗，我曾经也想成为其中一员。啊，但是如果"}, {"type": "subtitle", "time": 3390.069, "timestamp": "00:56:30", "text": "你喜欢鲸鱼，为什么不去当一只鲸鱼呢？"}, {"type": "subtitle", "time": 3392.549, "timestamp": "00:56:32", "text": "用鲸鱼来塑造你的蔬菜角色？库兹"}, {"type": "subtitle", "time": 3395.27, "timestamp": "00:56:35", "text": "我也喜欢狐狸。"}, {"type": "subtitle", "time": 3398.95, "timestamp": "00:56:38", "text": "啊，为什么不考虑混合动力呢？狐狸和一头鲸鱼"}, {"type": "subtitle", "time": 3401.91, "timestamp": "00:56:41", "text": "生了个孩子，还生了个混血儿。"}, {"type": "subtitle", "time": 3403.589, "timestamp": "00:56:43", "text": "那该如何操作呢？我不认为"}, {"type": "subtitle", "time": 3406.069, "timestamp": "00:56:46", "text": "那就是"}, {"type": "subtitle", "time": 3409.109, "timestamp": "00:56:49", "text": "不。也许吧。或许。你吃过吗？"}, {"type": "subtitle", "time": 3412.39, "timestamp": "00:56:52", "text": "没看到我的笑话吗？我是混血儿。"}, {"type": "subtitle", "time": 3415.109, "timestamp": "00:56:55", "text": "漫画。你有漫画吗？什么？我做了一个"}, {"type": "subtitle", "time": 3417.91, "timestamp": "00:56:57", "text": "漫画。我把这件事画成了漫画。什么？"}, {"type": "subtitle", "time": 3419.99, "timestamp": "00:56:59", "text": "我被困住了。我会展示，我会分享。"}]
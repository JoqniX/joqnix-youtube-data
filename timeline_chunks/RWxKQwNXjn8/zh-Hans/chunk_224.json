[{"type": "subtitle", "time": 13440.309, "timestamp": "03:44:00", "text": "我无法做到，但我可以确保我不会"}, {"type": "subtitle", "time": 13442.309, "timestamp": "03:44:02", "text": "动了Joathon的钱，一切就都完了。"}, {"type": "subtitle", "time": 13445.189, "timestamp": "03:44:05", "text": "绝对安全。不，我本不该那样做"}, {"type": "subtitle", "time": 13448.389, "timestamp": "03:44:08", "text": "之前也遇到过这种情况，但再次遇到困难"}, {"type": "subtitle", "time": 13451.59, "timestamp": "03:44:11", "text": "说服我的家人，你知道，帮忙"}, {"type": "subtitle", "time": 13454.389, "timestamp": "03:44:14", "text": "我带着这些东西，因为"}, {"type": "subtitle", "time": 13456.79, "timestamp": "03:44:16", "text": "又会出现并发症，对吧？"}, {"type": "subtitle", "time": 13460.15, "timestamp": "03:44:20", "text": "因为我要去日本，而且，嗯，我有"}, {"type": "subtitle", "time": 13463.269, "timestamp": "03:44:23", "text": "将其转换为另一个账户"}, {"type": "subtitle", "time": 13465.83, "timestamp": "03:44:25", "text": "系统之类的，因为我要走了"}, {"type": "subtitle", "time": 13469.11, "timestamp": "03:44:29", "text": "国际权利，所以很多事情"}, {"type": "subtitle", "time": 13471.75, "timestamp": "03:44:31", "text": "事关重大"}, {"type": "subtitle", "time": 13475.11, "timestamp": "03:44:35", "text": "不要押注很多你需要的东西"}, {"type": "subtitle", "time": 13478.15, "timestamp": "03:44:38", "text": "因为这事儿需要考虑很多因素。"}, {"type": "subtitle", "time": 13481.51, "timestamp": "03:44:41", "text": "延期至2026年4月，我是"}, {"type": "subtitle", "time": 13483.199, "timestamp": "03:44:43", "text": "我是 能够说服我爸爸喜欢"}, {"type": "subtitle", "time": 13486.399, "timestamp": "03:44:46", "text": "能够说服我爸爸喜欢 调查清楚，把那些事情都做了。"}, {"type": "subtitle", "time": 13490.56, "timestamp": "03:44:50", "text": "调查清楚，把那些事情都做了。 那里有很多我不知道的东西。"}, {"type": "subtitle", "time": 13493.12, "timestamp": "03:44:53", "text": "那里有很多我不知道的东西。 只希望有人能找到我"}, {"type": "subtitle", "time": 13495.84, "timestamp": "03:44:55", "text": "只希望有人能找到我 右边那个东西不显示我的"}, {"type": "subtitle", "time": 13498.96, "timestamp": "03:44:58", "text": "右边那个东西不显示我的 地址或任何其他信息"}]
[{"type": "subtitle", "time": 7802.229, "timestamp": "02:10:02", "text": "我希望你用谷歌搜索一下，然后我"}, {"type": "subtitle", "time": 7806.069, "timestamp": "02:10:06", "text": "希望你在直播中对此做出反应。好的。"}, {"type": "subtitle", "time": 7809.589, "timestamp": "02:10:09", "text": "杰米·奥利弗。"}, {"type": "subtitle", "time": 7813.589, "timestamp": "02:10:13", "text": "黄油鸡。黄油鸡。"}, {"type": "subtitle", "time": 7816.629, "timestamp": "02:10:16", "text": "这是反人类罪。"}, {"type": "subtitle", "time": 7820.39, "timestamp": "02:10:20", "text": "杰米和妈妈"}, {"type": "subtitle", "time": 7823.99, "timestamp": "02:10:23", "text": "这是杰米·奥利弗的黄油鸡食谱。"}, {"type": "subtitle", "time": 7827.35, "timestamp": "02:10:27", "text": "杰米和玛丽卡，或者杰米的腰果"}, {"type": "subtitle", "time": 7829.35, "timestamp": "02:10:29", "text": "黄油鸡，让家人继续烹饪。"}, {"type": "subtitle", "time": 7832.709, "timestamp": "02:10:32", "text": "是哪一个？"}, {"type": "subtitle", "time": 7834.87, "timestamp": "02:10:34", "text": "我认为是第二个。黄油"}, {"type": "subtitle", "time": 7837.189, "timestamp": "02:10:37", "text": "鸡一。好的。我觉得是。"}, {"type": "subtitle", "time": 7839.75, "timestamp": "02:10:39", "text": "我觉得他就是用那一个做的。"}, {"type": "subtitle", "time": 7843.83, "timestamp": "02:10:43", "text": "呃，罗杰叔叔。"}, {"type": "subtitle", "time": 7847.99, "timestamp": "02:10:47", "text": "不，那是安加对此的反应。哦，"}, {"type": "subtitle", "time": 7851.03, "timestamp": "02:10:51", "text": "是的。这是他做出反应的那条评论。好的。"}, {"type": "subtitle", "time": 7853.91, "timestamp": "02:10:53", "text": "就是这个。好的。"}, {"type": "subtitle", "time": 7855.99, "timestamp": "02:10:55", "text": "是的。"}]
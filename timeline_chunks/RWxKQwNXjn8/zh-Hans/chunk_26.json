[{"type": "subtitle", "time": 1560.789, "timestamp": "00:26:00", "text": "我是什么"}, {"type": "subtitle", "time": 1562.63, "timestamp": "00:26:02", "text": "你感觉如何？你是什​​么熊？"}, {"type": "subtitle", "time": 1565.35, "timestamp": "00:26:05", "text": "喜欢？运动健将。有不同类型的"}, {"type": "subtitle", "time": 1567.75, "timestamp": "00:26:07", "text": "熊。"}, {"type": "subtitle", "time": 1570.31, "timestamp": "00:26:10", "text": "是的。乔克。你知道，有……"}, {"type": "subtitle", "time": 1573.83, "timestamp": "00:26:13", "text": "有考拉，还有熊猫，"}, {"type": "subtitle", "time": 1576.87, "timestamp": "00:26:16", "text": "那里有北极熊，还有老虎机"}, {"type": "subtitle", "time": 1581.19, "timestamp": "00:26:21", "text": "熊。波。等等，熊猫不就是熊吗？哦"}, {"type": "subtitle", "time": 1583.669, "timestamp": "00:26:23", "text": "是的，熊猫是熊科动物。"}, {"type": "subtitle", "time": 1587.11, "timestamp": "00:26:27", "text": "好的。马来熊、棕熊、懒熊"}, {"type": "subtitle", "time": 1591.11, "timestamp": "00:26:31", "text": "亚洲黑熊、洞熊、熊、美洲熊"}, {"type": "subtitle", "time": 1593.59, "timestamp": "00:26:33", "text": "黑熊。哇。"}, {"type": "subtitle", "time": 1596.63, "timestamp": "00:26:36", "text": "是的。哇。好的。有很多"}, {"type": "subtitle", "time": 1603.51, "timestamp": "00:26:43", "text": "请耐心等待。好的，不错。哇哦。"}, {"type": "subtitle", "time": 1607.909, "timestamp": "00:26:47", "text": "棕色北极熊。我的天啊。可乐不是"}, {"type": "subtitle", "time": 1609.669, "timestamp": "00:26:49", "text": "没有熊。"}, {"type": "subtitle", "time": 1611.909, "timestamp": "00:26:51", "text": "真是只熊。"}, {"type": "subtitle", "time": 1614.149, "timestamp": "00:26:54", "text": "这里没有。哦，懒熊。"}, {"type": "subtitle", "time": 1617.43, "timestamp": "00:26:57", "text": "我正在观察我们。八熊"}]
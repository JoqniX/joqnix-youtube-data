[{"type": "subtitle", "time": 2760.87, "timestamp": "00:46:00", "text": "它要走了，它将会是，它要走了"}, {"type": "subtitle", "time": 2762.87, "timestamp": "00:46:02", "text": "干得好。你只需要相信"}, {"type": "subtitle", "time": 2765.589, "timestamp": "00:46:05", "text": "在这个过程中，一切都会顺利进行。"}, {"type": "subtitle", "time": 2776.79, "timestamp": "00:46:16", "text": "琼看起来真漂亮。威尔夫人"}, {"type": "subtitle", "time": 2782.069, "timestamp": "00:46:22", "text": "你会向人力资源部汇报工作。"}, {"type": "subtitle", "time": 2783.589, "timestamp": "00:46:23", "text": "只是"}, {"type": "subtitle", "time": 2785.67, "timestamp": "00:46:25", "text": "你们对我家孩子太坏了"}, {"type": "subtitle", "time": 2791.589, "timestamp": "00:46:31", "text": "它要来了，它会给它一个"}, {"type": "subtitle", "time": 2793.03, "timestamp": "00:46:33", "text": "片刻。请稍等片刻。它将"}, {"type": "subtitle", "time": 2794.87, "timestamp": "00:46:34", "text": "长得像熊猫。请稍等片刻。"}, {"type": "subtitle", "time": 2801.109, "timestamp": "00:46:41", "text": "你们太着急了。你"}]
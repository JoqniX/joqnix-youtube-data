[{"type": "subtitle", "time": 6961.99, "timestamp": "01:56:01", "text": "是的。它奏效了。是的。"}, {"type": "subtitle", "time": 6964.07, "timestamp": "01:56:04", "text": "是的。为什么我的主播模式突然开启了"}, {"type": "subtitle", "time": 6978.229, "timestamp": "01:56:18", "text": "使能够。好了。"}, {"type": "subtitle", "time": 6991.43, "timestamp": "01:56:31", "text": "头看起来好大。"}, {"type": "subtitle", "time": 6994.149, "timestamp": "01:56:34", "text": "没关系。它真是太可爱了。"}, {"type": "subtitle", "time": 6996.31, "timestamp": "01:56:36", "text": "这才是最重要的。"}, {"type": "subtitle", "time": 6998.629, "timestamp": "01:56:38", "text": "我打算暂停写作一段时间。哦，"}, {"type": "subtitle", "time": 7002.149, "timestamp": "01:56:42", "text": "等不及了，我迫不及待想看！"}, {"type": "subtitle", "time": 7016.39, "timestamp": "01:56:56", "text": "所以，你觉得我玩水上滑板怎么样？"}, {"type": "subtitle", "time": 7017.99, "timestamp": "01:56:57", "text": "还有别的什么？你一直都在吗？"}]
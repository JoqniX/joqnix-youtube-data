[{"type": "subtitle", "time": 8403.429, "timestamp": "02:20:03", "text": "那很好。是的。我很高兴在"}, {"type": "subtitle", "time": 8406.15, "timestamp": "02:20:06", "text": "至少今年，如果我要去……"}, {"type": "subtitle", "time": 8408.309, "timestamp": "02:20:08", "text": "下个月我要去日本了。"}, {"type": "subtitle", "time": 8410.87, "timestamp": "02:20:10", "text": "我独自一人过生日。但"}, {"type": "subtitle", "time": 8414.309, "timestamp": "02:20:14", "text": "这次是因为延期发生了。"}, {"type": "subtitle", "time": 8416.55, "timestamp": "02:20:16", "text": "直到四月。我觉得我有时间。"}, {"type": "subtitle", "time": 8419.19, "timestamp": "02:20:19", "text": "一年一度的盛事，值得和大家一起庆祝。"}, {"type": "subtitle", "time": 8421.27, "timestamp": "02:20:21", "text": "我的天啊。我们会有一个吗？我们会有一个吗？"}, {"type": "subtitle", "time": 8424.79, "timestamp": "02:20:24", "text": "开个玩笑的生日庆祝方式？"}, {"type": "subtitle", "time": 8428.79, "timestamp": "02:20:28", "text": "是的，我也这么认为。是的。我的天啊。"}, {"type": "subtitle", "time": 8430.79, "timestamp": "02:20:30", "text": "你竟敢说咖喱！咖喱。咖喱。"}, {"type": "subtitle", "time": 8432.63, "timestamp": "02:20:32", "text": "库里这个名字根本说不通。咖喱"}, {"type": "subtitle", "time": 8435.75, "timestamp": "02:20:35", "text": "咖喱在英语里就是“Oh my god”。"}, {"type": "subtitle", "time": 8439.349, "timestamp": "02:20:39", "text": "乍得。乍得。你需要自律。"}, {"type": "subtitle", "time": 8442.07, "timestamp": "02:20:42", "text": "哦，它叫黄咖喱。"}, {"type": "subtitle", "time": 8444.08, "timestamp": "02:20:44", "text": "黄咖喱。 哦，我哥哥不太喜欢"}, {"type": "subtitle", "time": 8445.92, "timestamp": "02:20:45", "text": "哦，我哥哥不太喜欢 因为他不喜欢黄咖喱"}, {"type": "subtitle", "time": 8447.28, "timestamp": "02:20:47", "text": "因为他不喜欢黄咖喱 凝乳很多。"}, {"type": "subtitle", "time": 8450.479, "timestamp": "02:20:50", "text": "凝乳很多。 嗯。不过我倒是很喜欢黄咖喱。喜欢"}, {"type": "subtitle", "time": 8452.72, "timestamp": "02:20:52", "text": "嗯。不过我倒是很喜欢黄咖喱。喜欢 通常我们和你这样的人都有这种感觉。"}, {"type": "subtitle", "time": 8454.8, "timestamp": "02:20:54", "text": "通常我们和你这样的人都有这种感觉。 了解一下印度炸蔬菜饼（pakora）。"}, {"type": "subtitle", "time": 8458.56, "timestamp": "02:20:58", "text": "了解一下印度炸蔬菜饼（pakora）。 我们在里面加入了炸蔬菜饼。"}]
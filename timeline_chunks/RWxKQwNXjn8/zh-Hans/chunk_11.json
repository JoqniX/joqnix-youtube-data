[{"type": "subtitle", "time": 660.55, "timestamp": "00:11:00", "text": "我没那么有钱，所以当不了兽迷。我"}, {"type": "subtitle", "time": 661.91, "timestamp": "00:11:01", "text": "感觉你需要富有才能成为一个"}, {"type": "subtitle", "time": 664.069, "timestamp": "00:11:04", "text": "毛茸茸的。"}, {"type": "subtitle", "time": 667.19, "timestamp": "00:11:07", "text": "你必须，我想你已经有了。不，你"}, {"type": "subtitle", "time": 669.59, "timestamp": "00:11:09", "text": "乔克。你知道，你知道薯条喜欢什么"}, {"type": "subtitle", "time": 672.069, "timestamp": "00:11:12", "text": "他们可以委托制作一大堆东西"}, {"type": "subtitle", "time": 674.79, "timestamp": "00:11:14", "text": "事情就是这样，对吧？他们肯定很有钱。哦"}, {"type": "subtitle", "time": 676.87, "timestamp": "00:11:16", "text": "是的，没错，没错，没错。是啊是啊。我是"}, {"type": "subtitle", "time": 678.87, "timestamp": "00:11:18", "text": "不，我还没那么有钱。我不能"}, {"type": "subtitle", "time": 681.829, "timestamp": "00:11:21", "text": "虽然我现在还不能称自己为兽迷。"}, {"type": "subtitle", "time": 683.67, "timestamp": "00:11:23", "text": "好的，乔，你有什么想法吗？"}, {"type": "subtitle", "time": 692.63, "timestamp": "00:11:32", "text": "实际上，并非如此。没有具体想法。我们可以"}, {"type": "subtitle", "time": 694.71, "timestamp": "00:11:34", "text": "随便谷歌一下，搜什么都行。"}, {"type": "subtitle", "time": 697.829, "timestamp": "00:11:37", "text": "我们可以通过谷歌搜索猫来了解它们。"}, {"type": "subtitle", "time": 699.99, "timestamp": "00:11:39", "text": "随你喜欢。告诉你什么？"}, {"type": "subtitle", "time": 702.23, "timestamp": "00:11:42", "text": "既然我们聊到了薯条，那就来做薯条吧！"}, {"type": "subtitle", "time": 705.99, "timestamp": "00:11:45", "text": "你的个人简介。"}, {"type": "subtitle", "time": 708.23, "timestamp": "00:11:48", "text": "是的。好的。我们将让你成为一个"}, {"type": "subtitle", "time": 711.509, "timestamp": "00:11:51", "text": "角色。现在，为了让这件事奏效，乔，"}, {"type": "subtitle", "time": 716.069, "timestamp": "00:11:56", "text": "我希望，我希望你去开一家新的"}]
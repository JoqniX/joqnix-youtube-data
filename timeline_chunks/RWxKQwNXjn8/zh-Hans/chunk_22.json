[{"type": "subtitle", "time": 1322.87, "timestamp": "00:22:02", "text": "我的上帝。是的。我妻子无法理解"}, {"type": "subtitle", "time": 1326.23, "timestamp": "00:22:06", "text": "那。很公平，"}, {"type": "subtitle", "time": 1328.789, "timestamp": "00:22:08", "text": "兄弟。我的天，我甚至都不是白人。我不能"}, {"type": "subtitle", "time": 1331.83, "timestamp": "00:22:11", "text": "了解大米的数量。百吉饼"}, {"type": "subtitle", "time": 1336.549, "timestamp": "00:22:16", "text": "三明治。什么是百吉饼？所以，百吉饼是"}, {"type": "subtitle", "time": 1339.35, "timestamp": "00:22:19", "text": "就像你的面包一样，"}, {"type": "subtitle", "time": 1342.149, "timestamp": "00:22:22", "text": "就像你的切片面包，但又像它们"}, {"type": "subtitle", "time": 1346.23, "timestamp": "00:22:26", "text": "感觉更像是坚固的，呃，就像"}, {"type": "subtitle", "time": 1348.549, "timestamp": "00:22:28", "text": "他们通常会添加芝麻之类的东西。"}, {"type": "subtitle", "time": 1352.23, "timestamp": "00:22:32", "text": "以及其他一些东西。好的。"}, {"type": "subtitle", "time": 1355.669, "timestamp": "00:22:35", "text": "啊。是的。"}, {"type": "subtitle", "time": 1359.59, "timestamp": "00:22:39", "text": "我从未吃过烤饼。放些果酱。"}, {"type": "subtitle", "time": 1361.83, "timestamp": "00:22:41", "text": "看起来不错。这些烤饼看起来确实不错。"}, {"type": "subtitle", "time": 1363.51, "timestamp": "00:22:43", "text": "好的。我想尝试一下，因为……"}, {"type": "subtitle", "time": 1365.75, "timestamp": "00:22:45", "text": "草莓。我心想，好吧，我走了"}, {"type": "subtitle", "time": 1367.83, "timestamp": "00:22:47", "text": "配华夫饼。"}, {"type": "subtitle", "time": 1369.83, "timestamp": "00:22:49", "text": "哦，是的。"}, {"type": "subtitle", "time": 1374.63, "timestamp": "00:22:54", "text": "呃，这个纸杯蛋糕就像 ekles。不是 ekair"}, {"type": "subtitle", "time": 1377.51, "timestamp": "00:22:57", "text": "奶糖。这是什么？"}]
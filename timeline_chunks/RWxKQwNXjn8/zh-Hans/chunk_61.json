[{"type": "subtitle", "time": 3661.19, "timestamp": "01:01:01", "text": "我们从未照顾过熊猫，我们可能"}, {"type": "subtitle", "time": 3663.03, "timestamp": "01:01:03", "text": "我从未见过像熊猫那样的动物。"}, {"type": "subtitle", "time": 3665.75, "timestamp": "01:01:05", "text": "他们自己进入S，他们很厉害。"}, {"type": "subtitle", "time": 3668.789, "timestamp": "01:01:08", "text": "是的，他们的生存能力很差。"}, {"type": "subtitle", "time": 3670.309, "timestamp": "01:01:10", "text": "我现在就私信他告诉他"}, {"type": "subtitle", "time": 3672.63, "timestamp": "01:01:12", "text": "你直截了当地说吧，继续。"}, {"type": "subtitle", "time": 3674.309, "timestamp": "01:01:14", "text": "告诉那个小混蛋，我在说话。"}, {"type": "subtitle", "time": 3676.71, "timestamp": "01:01:16", "text": "说他坏话。他知道我是"}, {"type": "subtitle", "time": 3678.069, "timestamp": "01:01:18", "text": "因为我经常这么做，所以我才会说他的坏话。"}, {"type": "subtitle", "time": 3686.87, "timestamp": "01:01:26", "text": "我需要减小尺寸"}, {"type": "subtitle", "time": 3696.87, "timestamp": "01:01:36", "text": "呃，出于创作方面的原因，我是"}, {"type": "subtitle", "time": 3699.829, "timestamp": "01:01:39", "text": "把你的眼镜变成紫色。"}, {"type": "subtitle", "time": 3706.39, "timestamp": "01:01:46", "text": "我会告诉奶奶的，你真坏。"}, {"type": "subtitle", "time": 3708.549, "timestamp": "01:01:48", "text": "好的。好的。奶奶是个例外。"}, {"type": "subtitle", "time": 3710.63, "timestamp": "01:01:50", "text": "奶奶是个好老人。我爱"}, {"type": "subtitle", "time": 3717.43, "timestamp": "01:01:57", "text": "奶奶是个例外。我爱她。"}]
[{"type": "subtitle", "time": 6422.55, "timestamp": "01:47:02", "text": "有点像狮子座浆液性癌症"}, {"type": "subtitle", "time": 6424.95, "timestamp": "01:47:04", "text": "一切。哦，等等，那些是星座。"}, {"type": "subtitle", "time": 6427.189, "timestamp": "01:47:07", "text": "哦等等，不不，那些是星座。"}, {"type": "subtitle", "time": 6430.07, "timestamp": "01:47:10", "text": "也一样。哦，他们没事。十二星座是"}, {"type": "subtitle", "time": 6433.189, "timestamp": "01:47:13", "text": "基于星座。"}, {"type": "subtitle", "time": 6435.03, "timestamp": "01:47:15", "text": "所以你的星座是哪个？"}, {"type": "subtitle", "time": 6437.99, "timestamp": "01:47:17", "text": "星座就像你知道的那样"}, {"type": "subtitle", "time": 6440.629, "timestamp": "01:47:20", "text": "天空中的星座"}, {"type": "subtitle", "time": 6442.88, "timestamp": "01:47:22", "text": "时间。这是最主要的一点。"}, {"type": "subtitle", "time": 6444.47, "timestamp": "01:47:24", "text": "[音乐]"}, {"type": "subtitle", "time": 6447.03, "timestamp": "01:47:27", "text": "这就是为什么你需要通过这种方式来发现自己的"}, {"type": "subtitle", "time": 6455.59, "timestamp": "01:47:35", "text": "我记得我们当时就像，你做过吗？"}, {"type": "subtitle", "time": 6456.95, "timestamp": "01:47:36", "text": "你有没有过……？你有没有去过……？"}, {"type": "subtitle", "time": 6459.669, "timestamp": "01:47:39", "text": "小时候去过天文馆吗？"}, {"type": "subtitle", "time": 6462.629, "timestamp": "01:47:42", "text": "行星？我觉得我为学校做了很多事"}, {"type": "subtitle", "time": 6469.189, "timestamp": "01:47:49", "text": "我记得我当时好像有个天文馆"}, {"type": "subtitle", "time": 6471.03, "timestamp": "01:47:51", "text": "我们学校也是。就像他们建造的那样"}, {"type": "subtitle", "time": 6474.31, "timestamp": "01:47:54", "text": "更像是一个小帐篷式的天文台"}, {"type": "subtitle", "time": 6476.55, "timestamp": "01:47:56", "text": "他们带我们去参加了一个活动。它"}, {"type": "subtitle", "time": 6479.75, "timestamp": "01:47:59", "text": "太酷了。"}]
[{"type": "subtitle", "time": 10081.349, "timestamp": "02:48:01", "text": "甚至连吃药都做不到，这"}, {"type": "subtitle", "time": 10082.389, "timestamp": "02:48:02", "text": "应该能帮我"}, {"type": "subtitle", "time": 10083.99, "timestamp": "02:48:03", "text": "拖延。"}, {"type": "subtitle", "time": 10086.63, "timestamp": "02:48:06", "text": "所以，呃，"}, {"type": "subtitle", "time": 10088.23, "timestamp": "02:48:08", "text": "他"}, {"type": "subtitle", "time": 10089.91, "timestamp": "02:48:09", "text": "听起来像个错误。是的，我"}, {"type": "subtitle", "time": 10093.349, "timestamp": "02:48:13", "text": "经常听到这种说法。"}, {"type": "subtitle", "time": 10095.91, "timestamp": "02:48:15", "text": "什么是类似非印度人的情况？呃，"}, {"type": "subtitle", "time": 10097.91, "timestamp": "02:48:17", "text": "非总统级印度人。所以，就像"}, {"type": "subtitle", "time": 10100.63, "timestamp": "02:48:20", "text": "一位居住在国外的印度人。哦，那是"}, {"type": "subtitle", "time": 10104.15, "timestamp": "02:48:24", "text": "未来的我。不。"}, {"type": "subtitle", "time": 10107.51, "timestamp": "02:48:27", "text": "我的上帝。我的天啊。"}, {"type": "subtitle", "time": 10116.15, "timestamp": "02:48:36", "text": "还有鸡肉。"}, {"type": "subtitle", "time": 10124.87, "timestamp": "02:48:44", "text": "我现在感觉受到了极大的侮辱。我"}, {"type": "subtitle", "time": 10127.15, "timestamp": "02:48:47", "text": "简直难以置信。"}, {"type": "subtitle", "time": 10129.429, "timestamp": "02:48:49", "text": "[音乐]"}, {"type": "subtitle", "time": 10133.67, "timestamp": "02:48:53", "text": "不，老实说，我的印地语很差。"}, {"type": "subtitle", "time": 10136.87, "timestamp": "02:48:56", "text": "我的发音糟透了。"}]
[{"type": "subtitle", "time": 8940.63, "timestamp": "02:29:00", "text": "这是波兰语。等等，这怎么念？"}, {"type": "subtitle", "time": 8943.99, "timestamp": "02:29:03", "text": "抛光？是波兰语吗？抛光。"}, {"type": "subtitle", "time": 8946.95, "timestamp": "02:29:06", "text": "抛光。如何？等等，难道不是这样发音的吗？"}, {"type": "subtitle", "time": 8948.469, "timestamp": "02:29:08", "text": "抛光？"}, {"type": "subtitle", "time": 8957.429, "timestamp": "02:29:17", "text": "您指的是印地语还是印地语的某种方言？"}, {"type": "subtitle", "time": 8960.469, "timestamp": "02:29:20", "text": "呃，这不是方言。它有自己的"}, {"type": "subtitle", "time": 8961.99, "timestamp": "02:29:21", "text": "语言。"}, {"type": "subtitle", "time": 8964.23, "timestamp": "02:29:24", "text": "呃，那是一种山区语言。所以是"}, {"type": "subtitle", "time": 8967.19, "timestamp": "02:29:27", "text": "口语呃，它叫它，它来了"}, {"type": "subtitle", "time": 8968.63, "timestamp": "02:29:28", "text": "就像山脉一样"}, {"type": "subtitle", "time": 8971.11, "timestamp": "02:29:31", "text": "语言。"}, {"type": "subtitle", "time": 8973.91, "timestamp": "02:29:33", "text": "波兰。我的天啊。不。你什么意思？"}, {"type": "subtitle", "time": 8975.67, "timestamp": "02:29:35", "text": "它怎么发音？好的，稍等一下。我是"}, {"type": "subtitle", "time": 8977.27, "timestamp": "02:29:37", "text": "我正在搜索。"}, {"type": "subtitle", "time": 8978.55, "timestamp": "02:29:38", "text": "我正在查找相关信息。我正在搜索"}, {"type": "subtitle", "time": 8981.349, "timestamp": "02:29:41", "text": "搞定。波兰居民"}, {"type": "subtitle", "time": 8986.15, "timestamp": "02:29:46", "text": "波兰。波兰。抛光"}, {"type": "subtitle", "time": 8988.309, "timestamp": "02:29:48", "text": "名词。"}]
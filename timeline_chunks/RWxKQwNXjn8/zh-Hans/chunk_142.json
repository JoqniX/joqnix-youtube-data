[{"type": "subtitle", "time": 8522.15, "timestamp": "02:22:02", "text": "我也有这种感觉。那他妈到底是什么玩意儿？"}, {"type": "subtitle", "time": 8525.91, "timestamp": "02:22:05", "text": "这就像说“他妈的米苏水”一样。"}, {"type": "subtitle", "time": 8528.469, "timestamp": "02:22:08", "text": "哦，原来它有个品牌啊。"}, {"type": "subtitle", "time": 8533.349, "timestamp": "02:22:13", "text": "就像水波那波那之类的东西。哦，我的"}, {"type": "subtitle", "time": 8536.71, "timestamp": "02:22:16", "text": "上帝。来自天然的水"}, {"type": "subtitle", "time": 8540.23, "timestamp": "02:22:20", "text": "扫描意大利。哦，我说意大利。意大利语"}, {"type": "subtitle", "time": 8544.389, "timestamp": "02:22:24", "text": "水。我当时玩得像快餐一样"}, {"type": "subtitle", "time": 8547.91, "timestamp": "02:22:27", "text": "模拟就像序章那样，并且在"}, {"type": "subtitle", "time": 8551.429, "timestamp": "02:22:31", "text": "他们居然有Mizu牌饮用水。我看见"}, {"type": "subtitle", "time": 8555.67, "timestamp": "02:22:35", "text": "那玩意儿。我当时就想：这他妈什么鬼？"}, {"type": "subtitle", "time": 8558.55, "timestamp": "02:22:38", "text": "好的。默克。 Merk鸡实际上是一种"}, {"type": "subtitle", "time": 8562.71, "timestamp": "02:22:42", "text": "盘子。 M 鸡。从未听说过"}, {"type": "subtitle", "time": 8566.55, "timestamp": "02:22:46", "text": "就像M一样"}, {"type": "subtitle", "time": 8569.59, "timestamp": "02:22:49", "text": "哇。太多事情了。"}, {"type": "subtitle", "time": 8571.75, "timestamp": "02:22:51", "text": "黄油鸡咖喱。是的。它是"}, {"type": "subtitle", "time": 8575.349, "timestamp": "02:22:55", "text": "黄油鸡的一种"}]
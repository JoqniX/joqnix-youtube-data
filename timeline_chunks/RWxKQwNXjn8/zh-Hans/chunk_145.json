[{"type": "subtitle", "time": 8701.99, "timestamp": "02:25:01", "text": "我指的是波兰语。波兰语也是它的"}, {"type": "subtitle", "time": 8704.309, "timestamp": "02:25:04", "text": "情况不一样。我不太了解。"}, {"type": "subtitle", "time": 8706.309, "timestamp": "02:25:06", "text": "抛光。实际上，我一个也不认识。"}, {"type": "subtitle", "time": 8709.03, "timestamp": "02:25:09", "text": "抛光。"}, {"type": "subtitle", "time": 8712.07, "timestamp": "02:25:12", "text": "你会哪些语言？乔克。"}, {"type": "subtitle", "time": 8714.23, "timestamp": "02:25:14", "text": "呃。"}, {"type": "subtitle", "time": 8717.59, "timestamp": "02:25:17", "text": "H. Oh.什么是酸奶黄瓜酱？哦，这是一个"}, {"type": "subtitle", "time": 8722.87, "timestamp": "02:25:22", "text": "黄油是嗯，它是和两种物质混合在一起的。"}, {"type": "subtitle", "time": 8725.27, "timestamp": "02:25:25", "text": "酸奶酱有两种类型。所以，它可以"}, {"type": "subtitle", "time": 8728.07, "timestamp": "02:25:28", "text": "与邦迪混合"}, {"type": "subtitle", "time": 8731.11, "timestamp": "02:25:31", "text": "这就像……嗯，就像一点点"}, {"type": "subtitle", "time": 8734.63, "timestamp": "02:25:34", "text": "珠子，而且有点咸。"}, {"type": "subtitle", "time": 8736.55, "timestamp": "02:25:36", "text": "它们很好。或者你可以把它和……混合"}, {"type": "subtitle", "time": 8738.389, "timestamp": "02:25:38", "text": "黄瓜"}, {"type": "subtitle", "time": 8742.309, "timestamp": "02:25:42", "text": "嗯，洋葱和少许盐。"}, {"type": "subtitle", "time": 8744.309, "timestamp": "02:25:44", "text": "而且你通常会像这样看待它"}, {"type": "subtitle", "time": 8746.07, "timestamp": "02:25:46", "text": "印度香饭。"}, {"type": "subtitle", "time": 8747.11, "timestamp": "02:25:47", "text": "哦。"}, {"type": "subtitle", "time": 8748.71, "timestamp": "02:25:48", "text": "是的，你不能吃印度香饭。"}, {"type": "subtitle", "time": 8751.429, "timestamp": "02:25:51", "text": "没有作者。那就像你的首选。"}, {"type": "subtitle", "time": 8754.98, "timestamp": "02:25:54", "text": "吃印度香饭需要配酸奶黄瓜酱。"}]
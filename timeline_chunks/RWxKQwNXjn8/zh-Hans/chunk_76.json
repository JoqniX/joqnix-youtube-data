[{"type": "subtitle", "time": 4562.229, "timestamp": "01:16:02", "text": "正确的。是的。不，我是说故事之类的。"}, {"type": "subtitle", "time": 4564.55, "timestamp": "01:16:04", "text": "我想写作。这就是我接受的原因"}, {"type": "subtitle", "time": 4567.11, "timestamp": "01:16:07", "text": "希望我能获得英语文学学位"}, {"type": "subtitle", "time": 4569.03, "timestamp": "01:16:09", "text": "轻松获得学位，还能学习如何……"}, {"type": "subtitle", "time": 4571.83, "timestamp": "01:16:11", "text": "写，这样我才能写我的故事。"}, {"type": "subtitle", "time": 4575.03, "timestamp": "01:16:15", "text": "事情的发展不如我意。"}, {"type": "subtitle", "time": 4579.11, "timestamp": "01:16:19", "text": "很遗憾，没关系。我是说真的，我是说"}, {"type": "subtitle", "time": 4581.11, "timestamp": "01:16:21", "text": "如果你需要建议或者你想"}, {"type": "subtitle", "time": 4583.59, "timestamp": "01:16:23", "text": "写点什么，我们就能做点什么。"}, {"type": "subtitle", "time": 4588.87, "timestamp": "01:16:28", "text": "好的。我得开始写工作报告了。"}, {"type": "subtitle", "time": 4591.189, "timestamp": "01:16:31", "text": "好的。锁在乌鸦身上。锁定。锁定"}, {"type": "subtitle", "time": 4603.27, "timestamp": "01:16:43", "text": "A. 这是一只小小的运动型泰迪熊。乔克。"}, {"type": "subtitle", "time": 4605.35, "timestamp": "01:16:45", "text": "我们什么时候才能让运动员具备市场竞争力？"}, {"type": "subtitle", "time": 4610.47, "timestamp": "01:16:50", "text": "我们什么时候才能拿到那个运动健将？"}, {"type": "subtitle", "time": 4613.669, "timestamp": "01:16:53", "text": "可以出售的毛绒玩具？有什么呃"}, {"type": "subtitle", "time": 4615.83, "timestamp": "01:16:55", "text": "将生产它的公司"}, {"type": "subtitle", "time": 4618.07, "timestamp": "01:16:58", "text": "在印度？"}]
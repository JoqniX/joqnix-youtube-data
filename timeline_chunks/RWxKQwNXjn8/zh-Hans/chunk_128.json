[{"type": "subtitle", "time": 7682.629, "timestamp": "02:08:02", "text": "我想，我想，还有更糟糕的情况。"}, {"type": "subtitle", "time": 7683.99, "timestamp": "02:08:03", "text": "他们做过的事。这不是他们的事。"}, {"type": "subtitle", "time": 7704.709, "timestamp": "02:08:24", "text": "坚持，稍等。我把我的 OBS 设置搞砸了。"}, {"type": "subtitle", "time": 7725.83, "timestamp": "02:08:45", "text": "坚持，稍等。我搞砸了。我搞砸了。它是"}, {"type": "subtitle", "time": 7728.629, "timestamp": "02:08:48", "text": "它坏了。一切都坏了。等待，"}, {"type": "subtitle", "time": 7731.589, "timestamp": "02:08:51", "text": "什么？你的直播中断了吗？不，不，不。"}, {"type": "subtitle", "time": 7733.99, "timestamp": "02:08:53", "text": "我的呃，你知道，就像那里有码头一样。"}, {"type": "subtitle", "time": 7736.149, "timestamp": "02:08:56", "text": "就像你明明知道的那些码头一样，显而易见。"}, {"type": "subtitle", "time": 7739.109, "timestamp": "02:08:59", "text": "事物。它是白色的吗？它是白色的吗？不，我"}]
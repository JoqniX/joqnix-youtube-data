[{"type": "subtitle", "time": 8281.349, "timestamp": "02:18:01", "text": "是的。 C面条。"}, {"type": "subtitle", "time": 8285.11, "timestamp": "02:18:05", "text": "你从来没试过？不。什么？我从未"}, {"type": "subtitle", "time": 8288.79, "timestamp": "02:18:08", "text": "试过了。是的，我放了窗帘米"}, {"type": "subtitle", "time": 8291.19, "timestamp": "02:18:11", "text": "而且成功了。好的。是的，鳕鱼饭是"}, {"type": "subtitle", "time": 8294.629, "timestamp": "02:18:14", "text": "好的。 C米饭是经典款。"}, {"type": "subtitle", "time": 8297.83, "timestamp": "02:18:17", "text": "是的。你竟敢在我的博客里说印度奶茶！"}, {"type": "subtitle", "time": 8300.629, "timestamp": "02:18:20", "text": "聊天？你竟敢提起奶茶？它是"}, {"type": "subtitle", "time": 8304.23, "timestamp": "02:18:24", "text": "柴。就是一杯奶茶。是你，不是你"}, {"type": "subtitle", "time": 8307.19, "timestamp": "02:18:27", "text": "别他妈说“像他妈的那样”"}, {"type": "subtitle", "time": 8310.549, "timestamp": "02:18:30", "text": "法棍面包。你知道，你不会这么说。"}, {"type": "subtitle", "time": 8322.23, "timestamp": "02:18:42", "text": "就是一杯奶茶。是印度奶茶。这不是馕饼。"}, {"type": "subtitle", "time": 8325.19, "timestamp": "02:18:45", "text": "面包。是馕。是印度奶茶。我不"}, {"type": "subtitle", "time": 8326.87, "timestamp": "02:18:46", "text": "其实我真的很喜欢印度奶茶。我是"}, {"type": "subtitle", "time": 8329.03, "timestamp": "02:18:49", "text": "实话实说。你做什么？"}, {"type": "subtitle", "time": 8331.19, "timestamp": "02:18:51", "text": "你通常会考虑咖啡还是黑咖啡"}, {"type": "subtitle", "time": 8335.11, "timestamp": "02:18:55", "text": "茶？我一般喝咖啡。呃"}, {"type": "subtitle", "time": 8338.389, "timestamp": "02:18:58", "text": "我上次喝印度奶茶还是在我生日那天。"}]
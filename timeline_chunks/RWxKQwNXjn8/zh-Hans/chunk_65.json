[{"type": "subtitle", "time": 3915.349, "timestamp": "01:05:15", "text": "我只会写草书。"}, {"type": "subtitle", "time": 3918.39, "timestamp": "01:05:18", "text": "有时也一样"}, {"type": "subtitle", "time": 3920.87, "timestamp": "01:05:20", "text": "我也是。这是唯一的"}, {"type": "subtitle", "time": 3923.91, "timestamp": "01:05:23", "text": "学校教我的方式。他们就像"}, {"type": "subtitle", "time": 3926.95, "timestamp": "01:05:26", "text": "你必须用草书书写，当我"}, {"type": "subtitle", "time": 3928.549, "timestamp": "01:05:28", "text": "用草书写字就像坏事一样"}, {"type": "subtitle", "time": 3930.39, "timestamp": "01:05:30", "text": "笔迹，我就像他教我的那样"}, {"type": "subtitle", "time": 3937.349, "timestamp": "01:05:37", "text": "占据我的面板，它们凶猛地基于"}, {"type": "subtitle", "time": 3941.349, "timestamp": "01:05:41", "text": "他们的凶手。哦"}, {"type": "subtitle", "time": 3944.47, "timestamp": "01:05:44", "text": "是的。问题是熊猫。是"}, {"type": "subtitle", "time": 3947.43, "timestamp": "01:05:47", "text": "公平，野生熊猫"}, {"type": "subtitle", "time": 3950.95, "timestamp": "01:05:50", "text": "勉强能活下来，但之后"}, {"type": "subtitle", "time": 3952.549, "timestamp": "01:05:52", "text": "现在有了类似人为干预，他们就……"}]
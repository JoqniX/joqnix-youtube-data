[{"type": "subtitle", "time": 12780.389, "timestamp": "03:33:00", "text": "会是迪斯科舞曲专辑之类的东西吗？"}, {"type": "subtitle", "time": 12784.389, "timestamp": "03:33:04", "text": "比如活动之类的。我不知道。"}, {"type": "subtitle", "time": 12787.11, "timestamp": "03:33:07", "text": "这就是为什么我要把我的额外收入……"}, {"type": "subtitle", "time": 12790.469, "timestamp": "03:33:10", "text": "我猜是英里吧。"}, {"type": "subtitle", "time": 12799.11, "timestamp": "03:33:19", "text": "我看到了神椿Project X那个东西。"}, {"type": "subtitle", "time": 12801.83, "timestamp": "03:33:21", "text": "这个网站真棒！我看着"}, {"type": "subtitle", "time": 12805.269, "timestamp": "03:33:25", "text": "这些东西。他们的电视动画系列"}, {"type": "subtitle", "time": 12808.389, "timestamp": "03:33:28", "text": "已经开始了小规模潜水。这就是"}, {"type": "subtitle", "time": 12811.19, "timestamp": "03:33:31", "text": "好酷的神明。人们给了我这么多"}, {"type": "subtitle", "time": 12812.95, "timestamp": "03:33:32", "text": "灵感迸发。此时此刻，我想要"}, {"type": "subtitle", "time": 12815.83, "timestamp": "03:33:35", "text": "去日本找份工作"}, {"type": "subtitle", "time": 12818.95, "timestamp": "03:33:38", "text": "神椿工作室。我不知道"}, {"type": "subtitle", "time": 12821.19, "timestamp": "03:33:41", "text": "我对即将到来的爱意之深切"}, {"type": "subtitle", "time": 12823.19, "timestamp": "03:33:43", "text": "回到这一点。我只想工作"}, {"type": "subtitle", "time": 12830.229, "timestamp": "03:33:50", "text": "如果可能的话。我不知道。是的，我"}]
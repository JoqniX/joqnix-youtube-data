[{"type": "subtitle", "time": 7202.79, "timestamp": "02:00:02", "text": "播放流畅或者感觉不对劲。哇。真是这样"}, {"type": "subtitle", "time": 7208.07, "timestamp": "02:00:08", "text": "意思是。这不是他妈的。"}, {"type": "subtitle", "time": 7211.75, "timestamp": "02:00:11", "text": "哇。对我太刻薄了。你看，这就是原因。"}, {"type": "subtitle", "time": 7214.149, "timestamp": "02:00:14", "text": "Jo比你们所有人都强多了。他"}, {"type": "subtitle", "time": 7217.91, "timestamp": "02:00:17", "text": "他们绝不会欺负我。"}, {"type": "subtitle", "time": 7220.87, "timestamp": "02:00:20", "text": "我注意到这条评论了。为什么要这样做"}, {"type": "subtitle", "time": 7225.109, "timestamp": "02:00:25", "text": "人们又在聊天室里欺负主播了？"}, {"type": "subtitle", "time": 7228.149, "timestamp": "02:00:28", "text": "哦，是，是，是，是，是……"}, {"type": "subtitle", "time": 7230.07, "timestamp": "02:00:30", "text": "开玩笑是。所以，当你开玩笑的时候，乔，"}, {"type": "subtitle", "time": 7232.31, "timestamp": "02:00:32", "text": "问题是，呃，开玩笑其实有点……"}, {"type": "subtitle", "time": 7235.51, "timestamp": "02:00:35", "text": "你知道，好吧，我该怎么说呢？"}, {"type": "subtitle", "time": 7238.55, "timestamp": "02:00:38", "text": "呃，乔，你会走上前去和某人搭讪吗？"}, {"type": "subtitle", "time": 7240.79, "timestamp": "02:00:40", "text": "比如说，你知道，你会去吗？"}, {"type": "subtitle", "time": 7243.91, "timestamp": "02:00:43", "text": "随便找个人说他身上有臭味？"}, {"type": "subtitle", "time": 7247.27, "timestamp": "02:00:47", "text": "不。是的。但如果这么说的话，就好像"}, {"type": "subtitle", "time": 7249.35, "timestamp": "02:00:49", "text": "富士山。"}, {"type": "subtitle", "time": 7253.109, "timestamp": "02:00:53", "text": "好的。你会说富士山有异味吗？"}, {"type": "subtitle", "time": 7254.39, "timestamp": "02:00:54", "text": "毫米-毫米。"}, {"type": "subtitle", "time": 7258.31, "timestamp": "02:00:58", "text": "不，你不会。不。好的。你 你是"}]
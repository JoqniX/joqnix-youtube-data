[{"type": "subtitle", "time": 15660.229, "timestamp": "04:21:00", "text": "好的。"}, {"type": "subtitle", "time": 15663.83, "timestamp": "04:21:03", "text": "你们用勺子吃饭吗？"}, {"type": "subtitle", "time": 15665.99, "timestamp": "04:21:05", "text": "我的意思是，最终我必须学会如何……"}, {"type": "subtitle", "time": 15668.71, "timestamp": "04:21:08", "text": "使用筷子"}, {"type": "subtitle", "time": 15671.59, "timestamp": "04:21:11", "text": "是的，我每天都用勺子。我不"}, {"type": "subtitle", "time": 15673.11, "timestamp": "04:21:13", "text": "知道"}, {"type": "subtitle", "time": 15675.269, "timestamp": "04:21:15", "text": "虽然我的家人都跟我说了很多。"}, {"type": "subtitle", "time": 15678.469, "timestamp": "04:21:18", "text": "我身边的人告诉我，你现在的工作是……"}, {"type": "subtitle", "time": 15682.07, "timestamp": "04:21:22", "text": "用手吃饭"}, {"type": "subtitle", "time": 15686.55, "timestamp": "04:21:26", "text": "否则你呃，否则什么都没有"}, {"type": "subtitle", "time": 15688.71, "timestamp": "04:21:28", "text": "你的身体里不会出现任何症状。"}, {"type": "subtitle", "time": 15691.11, "timestamp": "04:21:31", "text": "一些对消化有益的东西"}, {"type": "subtitle", "time": 15693.75, "timestamp": "04:21:33", "text": "我心想，兄弟，这吃法真够奇葩的。"}, {"type": "subtitle", "time": 15697.269, "timestamp": "04:21:37", "text": "重要的是什么并不重要"}, {"type": "subtitle", "time": 15699.83, "timestamp": "04:21:39", "text": "重要的是你如何摄入食物。"}, {"type": "subtitle", "time": 15703.189, "timestamp": "04:21:43", "text": "你所摄入的米饭是如何发挥作用的？"}, {"type": "subtitle", "time": 15705.91, "timestamp": "04:21:45", "text": "食物"}, {"type": "subtitle", "time": 15710.229, "timestamp": "04:21:50", "text": "无论你用的是勺子还是叉子。"}, {"type": "subtitle", "time": 15712.87, "timestamp": "04:21:52", "text": "事物。"}, {"type": "subtitle", "time": 15716.95, "timestamp": "04:21:56", "text": "你们觉得怎么样？"}]
[{"type": "subtitle", "time": 8641.11, "timestamp": "02:24:01", "text": "奶油。所以就像我可以向你展示我一样"}, {"type": "subtitle", "time": 8643.78, "timestamp": "02:24:03", "text": "可以向您展示聊天记录"}, {"type": "subtitle", "time": 8645.349, "timestamp": "02:24:05", "text": "[音乐]"}, {"type": "subtitle", "time": 8647.51, "timestamp": "02:24:07", "text": "即使你看任何一张照片"}, {"type": "subtitle", "time": 8650.469, "timestamp": "02:24:10", "text": "克里希纳，你会看到他像偷东西一样。"}, {"type": "subtitle", "time": 8654.71, "timestamp": "02:24:14", "text": "就像makan makan 就像你的奶油一样"}, {"type": "subtitle", "time": 8658.79, "timestamp": "02:24:18", "text": "但奶油。是的。所以，但我，我，我"}, {"type": "subtitle", "time": 8664.07, "timestamp": "02:24:24", "text": "对我家人来说是个威胁。我会"}, {"type": "subtitle", "time": 8667.67, "timestamp": "02:24:27", "text": "偷窃 我每次都会吃"}, {"type": "subtitle", "time": 8670.469, "timestamp": "02:24:30", "text": "我的家人会尝试制作类似奶油的东西"}, {"type": "subtitle", "time": 8672.79, "timestamp": "02:24:32", "text": "呃，就像你知道的，自制奶油。我会"}, {"type": "subtitle", "time": 8676.23, "timestamp": "02:24:36", "text": "全部吃掉。我当时状态很糟糕。我的"}, {"type": "subtitle", "time": 8678.79, "timestamp": "02:24:38", "text": "家人不得不把该死的冰箱锁起来。"}, {"type": "subtitle", "time": 8684.469, "timestamp": "02:24:44", "text": "我知道。"}, {"type": "subtitle", "time": 8686.55, "timestamp": "02:24:46", "text": "还有，我的f我不我不我不我不认为"}, {"type": "subtitle", "time": 8688.71, "timestamp": "02:24:48", "text": "我喜欢狐狸。我最喜欢的花"}, {"type": "subtitle", "time": 8691.83, "timestamp": "02:24:51", "text": "是狐狸。你没理解我的意思。我是从"}, {"type": "subtitle", "time": 8694.79, "timestamp": "02:24:54", "text": "欧盟。不要花哨的，不要说"}, {"type": "subtitle", "time": 8697.19, "timestamp": "02:24:57", "text": "你这语言真华丽。该死。不"}, {"type": "subtitle", "time": 8699.83, "timestamp": "02:24:59", "text": "你就说波兰语就行了。"}]
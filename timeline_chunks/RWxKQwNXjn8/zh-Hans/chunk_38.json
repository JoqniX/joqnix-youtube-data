[{"type": "subtitle", "time": 2286.15, "timestamp": "00:38:06", "text": "宝贝，你一定可以的。为什么会这样？哦，是的"}, {"type": "subtitle", "time": 2288.39, "timestamp": "00:38:08", "text": "因为我的头型太……"}, {"type": "subtitle", "time": 2292.31, "timestamp": "00:38:12", "text": "诡异的。哦，那是我的。"}, {"type": "subtitle", "time": 2296.47, "timestamp": "00:38:16", "text": "对不起。你"}, {"type": "subtitle", "time": 2304.23, "timestamp": "00:38:24", "text": "谢谢。"}, {"type": "subtitle", "time": 2306.63, "timestamp": "00:38:26", "text": "感谢您的贡献。"}, {"type": "subtitle", "time": 2309.67, "timestamp": "00:38:29", "text": "去乔顿。"}, {"type": "subtitle", "time": 2312.15, "timestamp": "00:38:32", "text": "谢谢。那里最好的Joond"}, {"type": "subtitle", "time": 2317.91, "timestamp": "00:38:37", "text": "乔要扮成熊猫。他将要"}, {"type": "subtitle", "time": 2320.23, "timestamp": "00:38:40", "text": "做一只小熊猫吧。会很可爱"}, {"type": "subtitle", "time": 2322.39, "timestamp": "00:38:42", "text": "小熊猫。"}, {"type": "subtitle", "time": 2325.43, "timestamp": "00:38:45", "text": "是的。我怎么会答对呢？"}, {"type": "subtitle", "time": 2337.03, "timestamp": "00:38:57", "text": "不，很好。"}]
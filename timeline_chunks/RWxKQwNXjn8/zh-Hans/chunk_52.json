[{"type": "subtitle", "time": 3136.47, "timestamp": "00:52:16", "text": "是的。你什么时候开始给我打电话的？"}, {"type": "subtitle", "time": 3141.03, "timestamp": "00:52:21", "text": "我想大概已经过去两年了吧。"}, {"type": "subtitle", "time": 3146.309, "timestamp": "00:52:26", "text": "啊。是的。两年。是的。"}, {"type": "subtitle", "time": 3152.79, "timestamp": "00:52:32", "text": "我打算补充"}, {"type": "subtitle", "time": 3156.47, "timestamp": "00:52:36", "text": "你的，你的，你的嘴唇，还有所有的一切"}, {"type": "subtitle", "time": 3165.27, "timestamp": "00:52:45", "text": "有趣的是，如果中国不喜欢你，"}, {"type": "subtitle", "time": 3166.71, "timestamp": "00:52:46", "text": "他们会把你的熊猫带走。拿"}, {"type": "subtitle", "time": 3168.87, "timestamp": "00:52:48", "text": "远离你的主要住所。所以他们会采取"}, {"type": "subtitle", "time": 3175.91, "timestamp": "00:52:55", "text": "我不小心忽略了聊天信息一个小时。"}, {"type": "subtitle", "time": 3177.829, "timestamp": "00:52:57", "text": "那只是一场意外。你得……"}, {"type": "subtitle", "time": 3179.67, "timestamp": "00:52:59", "text": "别再提这件事了。好的。事情发生了"}]
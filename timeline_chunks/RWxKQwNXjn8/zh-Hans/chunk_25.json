[{"type": "subtitle", "time": 1503.029, "timestamp": "00:25:03", "text": "啊，是的。"}, {"type": "subtitle", "time": 1504.63, "timestamp": "00:25:04", "text": "但我不认为你是你"}, {"type": "subtitle", "time": 1507.51, "timestamp": "00:25:07", "text": "你要么体型庞大，要么毛发旺盛，所以我们……"}, {"type": "subtitle", "time": 1509.35, "timestamp": "00:25:09", "text": "就做一只普通的熊"}, {"type": "subtitle", "time": 1511.43, "timestamp": "00:25:11", "text": "反而。"}, {"type": "subtitle", "time": 1513.19, "timestamp": "00:25:13", "text": "是的，那里有女同性恋者。"}, {"type": "subtitle", "time": 1515.11, "timestamp": "00:25:15", "text": "她们也是母熊，而且她们"}, {"type": "subtitle", "time": 1524.149, "timestamp": "00:25:24", "text": "好的。好的。那么，让我们来看看……"}, {"type": "subtitle", "time": 1525.83, "timestamp": "00:25:25", "text": "不同种类的熊。我们想要喜欢"}, {"type": "subtitle", "time": 1529.51, "timestamp": "00:25:29", "text": "可爱的熊。等等，它们是小熊猫吗？"}, {"type": "subtitle", "time": 1532.39, "timestamp": "00:25:32", "text": "熊？是"}, {"type": "subtitle", "time": 1535.11, "timestamp": "00:25:35", "text": "小熊猫"}, {"type": "subtitle", "time": 1537.269, "timestamp": "00:25:37", "text": "熊？"}, {"type": "subtitle", "time": 1544.95, "timestamp": "00:25:44", "text": "熊。"}, {"type": "subtitle", "time": 1548.31, "timestamp": "00:25:48", "text": "好的。慢跑时四处张望。"}, {"type": "subtitle", "time": 1550.87, "timestamp": "00:25:50", "text": "你会像哪种熊？"}, {"type": "subtitle", "time": 1557.43, "timestamp": "00:25:57", "text": "所以"}]
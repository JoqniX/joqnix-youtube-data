[{"type": "subtitle", "time": 11220.389, "timestamp": "03:07:00", "text": "那就像是最初的一部分。"}, {"type": "subtitle", "time": 11222.63, "timestamp": "03:07:02", "text": "我猜是系列作品吧。初步设计，概念"}, {"type": "subtitle", "time": 11224.63, "timestamp": "03:07:04", "text": "设计"}, {"type": "subtitle", "time": 11226.79, "timestamp": "03:07:06", "text": "这可能会成为官方的一部分。"}, {"type": "subtitle", "time": 11230.469, "timestamp": "03:07:10", "text": "我猜是系列作品吧。没有把握。我的天啊。"}, {"type": "subtitle", "time": 11234.15, "timestamp": "03:07:14", "text": "霍利说 D jocker 和 jockey Krueger"}, {"type": "subtitle", "time": 11236.309, "timestamp": "03:07:16", "text": "可能是真的。"}, {"type": "subtitle", "time": 11242.15, "timestamp": "03:07:22", "text": "美丽的。坚持，稍等。我需要调整我的"}, {"type": "subtitle", "time": 11244.95, "timestamp": "03:07:24", "text": "姿势。"}, {"type": "subtitle", "time": 11247.429, "timestamp": "03:07:27", "text": "是的。好的，我没事了。"}, {"type": "subtitle", "time": 11249.51, "timestamp": "03:07:29", "text": "我一直坐着，我不能再坐着了"}, {"type": "subtitle", "time": 11252.389, "timestamp": "03:07:32", "text": "你知道，摆姿势时间太长了。我得坐在一起。"}, {"type": "subtitle", "time": 11255.91, "timestamp": "03:07:35", "text": "那个双性恋的姿势，让我很开心"}, {"type": "subtitle", "time": 11258.07, "timestamp": "03:07:38", "text": "坐着的姿势非常怪异。甚至"}, {"type": "subtitle", "time": 11259.75, "timestamp": "03:07:39", "text": "虽然我不是双性恋，但是你"}, {"type": "subtitle", "time": 11262.71, "timestamp": "03:07:42", "text": "知道。嗯。"}, {"type": "subtitle", "time": 11264.71, "timestamp": "03:07:44", "text": "乔是蓝色的，但当他变成红色时，他"}, {"type": "subtitle", "time": 11268.469, "timestamp": "03:07:48", "text": "成为杀手。"}, {"type": "subtitle", "time": 11270.15, "timestamp": "03:07:50", "text": "我的天啊。我们可以做那件事"}, {"type": "subtitle", "time": 11272.87, "timestamp": "03:07:52", "text": "就像你知道的，我们把颜色反转一下"}]
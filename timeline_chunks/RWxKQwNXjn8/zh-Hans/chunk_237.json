[{"type": "subtitle", "time": 14227.189, "timestamp": "03:57:07", "text": "哦，我想呃"}, {"type": "subtitle", "time": 14231.51, "timestamp": "03:57:11", "text": "我必须打开，我必须保持这个打开状态"}, {"type": "subtitle", "time": 14236.79, "timestamp": "03:57:16", "text": "去工作。兄弟，这到底是怎么回事？"}, {"type": "subtitle", "time": 14240.229, "timestamp": "03:57:20", "text": "它无法在后台运行。"}, {"type": "subtitle", "time": 14243.11, "timestamp": "03:57:23", "text": "等等，什么？"}, {"type": "subtitle", "time": 14258.309, "timestamp": "03:57:38", "text": "哦好的。好的。好的。好的。所以，我"}, {"type": "subtitle", "time": 14260.55, "timestamp": "03:57:40", "text": "我的意思是，我必须保留浏览器。"}, {"type": "subtitle", "time": 14264.79, "timestamp": "03:57:44", "text": "要使此功能生效，请打开一个标签页。"}, {"type": "subtitle", "time": 14271.51, "timestamp": "03:57:51", "text": "哇。"}, {"type": "subtitle", "time": 14275.349, "timestamp": "03:57:55", "text": "真不可思议"}, {"type": "subtitle", "time": 14277.189, "timestamp": "03:57:57", "text": "任何人"}]
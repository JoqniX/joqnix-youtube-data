[{"type": "subtitle", "time": 844.47, "timestamp": "00:14:04", "text": "所以基于此，"}, {"type": "subtitle", "time": 847.59, "timestamp": "00:14:07", "text": "中立的含义是什么来着？守序中立。"}, {"type": "subtitle", "time": 850.55, "timestamp": "00:14:10", "text": "守序中立就是守序中立，就像"}, {"type": "subtitle", "time": 854.47, "timestamp": "00:14:14", "text": "你是一名守法公民。你就是你"}, {"type": "subtitle", "time": 858.389, "timestamp": "00:14:18", "text": "你就像个NPC一样。你存在，"}, {"type": "subtitle", "time": 860.629, "timestamp": "00:14:20", "text": "但是，呃，我的意思是，你还是会的，你仍然会的。"}, {"type": "subtitle", "time": 863.189, "timestamp": "00:14:23", "text": "就像遵守规则一样，但你却不遵守。"}, {"type": "subtitle", "time": 864.629, "timestamp": "00:14:24", "text": "比如特意去做"}, {"type": "subtitle", "time": 874.15, "timestamp": "00:14:34", "text": "你可以是守序善良阵营，也可以是中立阵营。"}, {"type": "subtitle", "time": 879.67, "timestamp": "00:14:39", "text": "运动健将人很好。你必须是"}, {"type": "subtitle", "time": 883.35, "timestamp": "00:14:43", "text": "处于良好状态。运动健将太"}, {"type": "subtitle", "time": 887.829, "timestamp": "00:14:47", "text": "[音乐]"}, {"type": "subtitle", "time": 890.23, "timestamp": "00:14:50", "text": "呃"}, {"type": "subtitle", "time": 898.47, "timestamp": "00:14:58", "text": "我不知道为什么我感觉像富士山"}]
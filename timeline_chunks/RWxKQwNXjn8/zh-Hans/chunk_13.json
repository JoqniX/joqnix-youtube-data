[{"type": "subtitle", "time": 781.19, "timestamp": "00:13:01", "text": "中立。所以，就像你一样，好就像你"}, {"type": "subtitle", "time": 782.55, "timestamp": "00:13:02", "text": "我知道你在努力，你是"}, {"type": "subtitle", "time": 784.55, "timestamp": "00:13:04", "text": "帮助他人。你关心"}, {"type": "subtitle", "time": 787.35, "timestamp": "00:13:07", "text": "其他的。中立就是你有时在乎"}, {"type": "subtitle", "time": 789.43, "timestamp": "00:13:09", "text": "关注其他人，但你却专注于"}, {"type": "subtitle", "time": 791.829, "timestamp": "00:13:11", "text": "多做自己。邪恶，你毫不在乎"}, {"type": "subtitle", "time": 794.629, "timestamp": "00:13:14", "text": "诋毁任何人。你来这里是为了造成"}, {"type": "subtitle", "time": 796.31, "timestamp": "00:13:16", "text": "问题。"}, {"type": "subtitle", "time": 800.23, "timestamp": "00:13:20", "text": "而且，除此之外，还有中立选项。"}, {"type": "subtitle", "time": 804.15, "timestamp": "00:13:24", "text": "有守序阵营，也有混乱阵营。"}, {"type": "subtitle", "time": 807.11, "timestamp": "00:13:27", "text": "你真是个小恶魔，太混乱了。你是"}, {"type": "subtitle", "time": 809.99, "timestamp": "00:13:29", "text": "你也是来捣乱的。"}, {"type": "subtitle", "time": 811.75, "timestamp": "00:13:31", "text": "呃，中立就像你不在乎。"}, {"type": "subtitle", "time": 813.75, "timestamp": "00:13:33", "text": "拉屎。你只是在活着。"}, {"type": "subtitle", "time": 818.23, "timestamp": "00:13:38", "text": "守法就是按规则行事。"}, {"type": "subtitle", "time": 820.79, "timestamp": "00:13:40", "text": "所以你扮演的角色有意义"}, {"type": "subtitle", "time": 822.87, "timestamp": "00:13:42", "text": "完全遵守规则。"}, {"type": "subtitle", "time": 825.43, "timestamp": "00:13:45", "text": "是的。所以，呃，合法性就像是……"}, {"type": "subtitle", "time": 827.43, "timestamp": "00:13:47", "text": "守序善良就像你知道的那样。"}, {"type": "subtitle", "time": 828.87, "timestamp": "00:13:48", "text": "你就像个好人。你是"}, {"type": "subtitle", "time": 832.23, "timestamp": "00:13:52", "text": "就像你知道的那些骑士一样，比如你"}, {"type": "subtitle", "time": 834.389, "timestamp": "00:13:54", "text": "认识一些像你这样的士兵和其他人"}, {"type": "subtitle", "time": 837.03, "timestamp": "00:13:57", "text": "他们知道自己在那里是为了履行职责，"}]
[{"type": "subtitle", "time": 2344.79, "timestamp": "00:39:04", "text": "[笑声]"}, {"type": "subtitle", "time": 2347.19, "timestamp": "00:39:07", "text": "Holodex是什么？ Holex是一个网站，"}, {"type": "subtitle", "time": 2350.63, "timestamp": "00:39:10", "text": "你可以同时关注多个用户、转播者等。"}, {"type": "subtitle", "time": 2353.349, "timestamp": "00:39:13", "text": "呃，YouTube 和 Twitch。你不需要"}, {"type": "subtitle", "time": 2355.19, "timestamp": "00:39:15", "text": "将它们放在不同的标签页上。你可以"}, {"type": "subtitle", "time": 2358.95, "timestamp": "00:39:18", "text": "用一个标签页观察别人。哦好的。"}, {"type": "subtitle", "time": 2360.87, "timestamp": "00:39:20", "text": "大米则不同。你可以吃番茄酱"}, {"type": "subtitle", "time": 2364.31, "timestamp": "00:39:24", "text": "配乌木饭，但只有米饭和番茄酱"}, {"type": "subtitle", "time": 2369.91, "timestamp": "00:39:29", "text": "太可怕了，对吧？米饭也行。等待，"}, {"type": "subtitle", "time": 2373.349, "timestamp": "00:39:33", "text": "炒饭加番茄酱？等等，你有"}, {"type": "subtitle", "time": 2376.31, "timestamp": "00:39:36", "text": "它？什么？餐厅里有卖。"}, {"type": "subtitle", "time": 2379.03, "timestamp": "00:39:39", "text": "还有其他一些东西。炒饭和番茄酱。我使用"}, {"type": "subtitle", "time": 2381.19, "timestamp": "00:39:41", "text": "我的炒饭里加了咖喱。比如，你"}, {"type": "subtitle", "time": 2393.67, "timestamp": "00:39:53", "text": "好的，没问题。没事的，狗狗。它是"}, {"type": "subtitle", "time": 2395.589, "timestamp": "00:39:55", "text": "美好的。你不可能比塞莱斯特更糟糕。"}, {"type": "subtitle", "time": 2397.99, "timestamp": "00:39:57", "text": "没关系。那是……等等，你说什么？"}, {"type": "subtitle", "time": 2399.829, "timestamp": "00:39:59", "text": "意思是？"}]
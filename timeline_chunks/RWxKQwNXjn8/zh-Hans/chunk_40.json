[{"type": "subtitle", "time": 2402.23, "timestamp": "00:40:02", "text": "你没看过塞莱斯特的厨艺吗？"}, {"type": "subtitle", "time": 2406.23, "timestamp": "00:40:06", "text": "溪流？不，很好。千万别看。你"}, {"type": "subtitle", "time": 2408.39, "timestamp": "00:40:08", "text": "我认为你永远不可能做到"}, {"type": "subtitle", "time": 2414.79, "timestamp": "00:40:14", "text": "世界上没有什么能让我如此喜欢"}, {"type": "subtitle", "time": 2417.51, "timestamp": "00:40:17", "text": "其实有点恶心，但我还是努力想……"}, {"type": "subtitle", "time": 2419.67, "timestamp": "00:40:19", "text": "观看 Celeste 的烹饪直播"}, {"type": "subtitle", "time": 2423.03, "timestamp": "00:40:23", "text": "我当时其实有点想吐。"}, {"type": "subtitle", "time": 2424.55, "timestamp": "00:40:24", "text": "我的天啊。"}, {"type": "subtitle", "time": 2429.43, "timestamp": "00:40:29", "text": "是的。另外，我不是凯拉。还有，呃，"}, {"type": "subtitle", "time": 2431.43, "timestamp": "00:40:31", "text": "我们正在一起作画。我正在尝试"}, {"type": "subtitle", "time": 2434.71, "timestamp": "00:40:34", "text": "教 J 把自己画成熊猫。"}, {"type": "subtitle", "time": 2436.63, "timestamp": "00:40:36", "text": "是的。"}, {"type": "subtitle", "time": 2439.829, "timestamp": "00:40:39", "text": "好的。我完成了。"}, {"type": "subtitle", "time": 2443.99, "timestamp": "00:40:43", "text": "现在我们要画出你的鼻子。"}, {"type": "subtitle", "time": 2445.91, "timestamp": "00:40:45", "text": "所以，你，你有一个可爱的，你就会有一个"}, {"type": "subtitle", "time": 2447.51, "timestamp": "00:40:47", "text": "可爱的小鼻子。你是 你是 你是"}, {"type": "subtitle", "time": 2450.55, "timestamp": "00:40:50", "text": "一只小熊猫。"}, {"type": "subtitle", "time": 2453.19, "timestamp": "00:40:53", "text": "所以，相信过程就好。我们要走了"}, {"type": "subtitle", "time": 2456.15, "timestamp": "00:40:56", "text": "画一点。"}]
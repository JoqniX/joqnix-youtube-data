[{"type": "subtitle", "time": 7081.35, "timestamp": "01:58:01", "text": "想要尝试新鲜事物"}, {"type": "subtitle", "time": 7084.07, "timestamp": "01:58:04", "text": "而且"}, {"type": "subtitle", "time": 7088.709, "timestamp": "01:58:08", "text": "感觉我越往前走，就越觉得……"}, {"type": "subtitle", "time": 7091.35, "timestamp": "01:58:11", "text": "嗯，商业方面，不，激情方面。"}, {"type": "subtitle", "time": 7093.83, "timestamp": "01:58:13", "text": "不，感觉很好，但是也……"}, {"type": "subtitle", "time": 7095.75, "timestamp": "01:58:15", "text": "比如当我了解这个行业的时候"}, {"type": "subtitle", "time": 7098.47, "timestamp": "01:58:18", "text": "我心想，“哇，这里有好多东西啊！”"}, {"type": "subtitle", "time": 7101.91, "timestamp": "01:58:21", "text": "把事情变成这样。” 是的，我明白你的意思"}, {"type": "subtitle", "time": 7103.35, "timestamp": "01:58:23", "text": "意思是。这其实是一回事。"}, {"type": "subtitle", "time": 7105.91, "timestamp": "01:58:25", "text": "就像你知道人们谈论事情的时候那样。"}, {"type": "subtitle", "time": 7107.75, "timestamp": "01:58:27", "text": "对我来说，你知道吗？"}, {"type": "subtitle", "time": 7110.149, "timestamp": "01:58:30", "text": "应该像算法一样，等等"}, {"type": "subtitle", "time": 7112.55, "timestamp": "01:58:32", "text": "我脑子里一片空白，因为我从来不喜欢"}, {"type": "subtitle", "time": 7114.55, "timestamp": "01:58:34", "text": "我对此深思熟虑，对我来说也是如此。"}, {"type": "subtitle", "time": 7116.229, "timestamp": "01:58:36", "text": "感觉就像你知道我知道它是"}, {"type": "subtitle", "time": 7117.75, "timestamp": "01:58:37", "text": "一件重要的事情。这是一个"}, {"type": "subtitle", "time": 7119.43, "timestamp": "01:58:39", "text": "学习所有重要的事情"}, {"type": "subtitle", "time": 7122.709, "timestamp": "01:58:42", "text": "这东西，但我感觉它飞起来了。"}, {"type": "subtitle", "time": 7124.79, "timestamp": "01:58:44", "text": "超出我的理解范围。我一直在听"}, {"type": "subtitle", "time": 7126.149, "timestamp": "01:58:46", "text": "背景音乐流。我喜欢"}, {"type": "subtitle", "time": 7128.149, "timestamp": "01:58:48", "text": "两人之间无伤大雅的争斗。但"}, {"type": "subtitle", "time": 7130.39, "timestamp": "01:58:50", "text": "最后，我的脑细胞也开始减少。"}, {"type": "subtitle", "time": 7133.51, "timestamp": "01:58:53", "text": "听着，上次直播只是因为……"}, {"type": "subtitle", "time": 7137.43, "timestamp": "01:58:57", "text": "RXR。嗯，RXR只会把最糟糕的一面激发出来。"}, {"type": "subtitle", "time": 7139.51, "timestamp": "01:58:59", "text": "在我心中。他只是带来了我们带来的"}]
[{"type": "subtitle", "time": 13621.189, "timestamp": "03:47:01", "text": "我希望Twitch能保管這筆錢。  但這真的太糟糕了。"}, {"type": "subtitle", "time": 13622.63, "timestamp": "03:47:02", "text": "我不希望那樣的事情發生。"}, {"type": "subtitle", "time": 13632.71, "timestamp": "03:47:12", "text": "說實話，我現在更多的是感到壓力，覺得錢幾天之內就會沒了，因為有最低餘額之類的限制"}, {"type": "subtitle", "time": 13636.95, "timestamp": "03:47:16", "text": "，對吧？  我不想，"}, {"type": "subtitle", "time": 13642.71, "timestamp": "03:47:22", "text": "我並不"}]
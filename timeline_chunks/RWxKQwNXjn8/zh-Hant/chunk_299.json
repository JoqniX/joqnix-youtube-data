[{"type": "subtitle", "time": 17948.55, "timestamp": "04:59:08", "text": "我實際上"}, {"type": "subtitle", "time": 17950.47, "timestamp": "04:59:10", "text": "按了按下"}, {"type": "subtitle", "time": 17953.75, "timestamp": "04:59:13", "text": "按鈕，然後擊中目標。可以嗎？等等。哦，好的。我沒事。沒事。好的，沒問題。等等，炸彈還在引爆嗎？不，它已經拆除了。我只是，你知道，拆除之後，我按下了按鈕，然後擊中目標。"}, {"type": "subtitle", "time": 17972.15, "timestamp": "04:59:32", "text": "你能想像拆除炸彈後把自己炸飛嗎？我想看看會發生什麼事。好的。下一個炸彈。不。還是你想先完成一步？完成它。"}, {"type": "subtitle", "time": 17983.43, "timestamp": "04:59:43", "text": "好的。會有四個模組。"}, {"type": "chat", "time": 17988.253, "timestamp": "04:59:48", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Joq's Activity State is Returing back to stream"}, {"type": "subtitle", "time": 17988.788, "timestamp": "04:59:48", "text": "哦，這次你是第一個。 1號。 41秒。不錯。其實"}, {"type": "chat", "time": 17999.566, "timestamp": "04:59:59", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Joq's Activity State is Returing back to stream"}]
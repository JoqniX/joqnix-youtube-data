[{"type": "subtitle", "time": 21301.99, "timestamp": "05:55:01", "text": "第一模組。首先，這根電線有"}, {"type": "subtitle", "time": 21303.43, "timestamp": "05:55:03", "text": "四根線。好的。"}, {"type": "subtitle", "time": 21311.83, "timestamp": "05:55:11", "text": "四根電線。  嗨，Gare，關於烹飪。  [音樂] 好的。呃，四根電線。是的。有紅色電線嗎？呃，不只一條紅線"}, {"type": "subtitle", "time": 21322.39, "timestamp": "05:55:22", "text": "。  好的。一根紅色電線。呃……序號是奇數嗎？"}, {"type": "subtitle", "time": 21342.708, "timestamp": "05:55:42", "text": "。  好的。有一根黃色電線嗎？一根黃色電線。是的。  好的。呃"}, {"type": "subtitle", "time": 21344.23, "timestamp": "05:55:44", "text": "，只有一條藍線嗎"}, {"type": "subtitle", "time": 21348.31, "timestamp": "05:55:48", "text": "？  哦，有兩個。不，我想應該有兩個。好的。所以，"}, {"type": "subtitle", "time": 21350.628, "timestamp": "05:55:50", "text": "剪斷第二根電線。第二根"}]
[{"type": "subtitle", "time": 26485.83, "timestamp": "07:21:25", "text": "開了家咖啡館。  咖啡店。是的。我想知道為什麼，呃，我在印度的學校裡沒見過，呃，在…該怎麼稱呼它呢"}, {"type": "subtitle", "time": 26489.43, "timestamp": "07:21:29", "text": "？呃，你"}, {"type": "subtitle", "time": 26499.43, "timestamp": "07:21:39", "text": "知道動漫裡總會有各種節日，這個班級就準備開一家女僕咖啡廳。我想看看。是的，在我們的那個東西裡面。"}, {"type": "subtitle", "time": 26503.91, "timestamp": "07:21:43", "text": "[音樂]"}, {"type": "subtitle", "time": 26509.99, "timestamp": "07:21:49", "text": "想像一下喬當女傭的樣子吧。"}, {"type": "subtitle", "time": 26515.71, "timestamp": "07:21:55", "text": "我曾經做過女傭"}]
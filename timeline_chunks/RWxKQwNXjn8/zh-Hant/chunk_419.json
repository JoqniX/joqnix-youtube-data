[{"type": "subtitle", "time": 25156.23, "timestamp": "06:59:16", "text": "[音樂] 我的"}, {"type": "subtitle", "time": 25160.708, "timestamp": "06:59:20", "text": "天哪。  哦，他好可愛。  抱著它哄它睡覺。  我的天啊。我睡著了，你知道，我把臉綁起來，然後說：「哦，你這混蛋。你根本不理我"}, {"type": "subtitle", "time": 25163.75, "timestamp": "06:59:23", "text": "。現在我要讓你想拉多少就拉多少。」我的天哪"}, {"type": "subtitle", "time": 25168.708, "timestamp": "06:59:28", "text": "。飛漲。是的。布加。飛漲。  [音樂] 放大。飛漲。飛漲。飛漲。"}, {"type": "subtitle", "time": 25177.35, "timestamp": "06:59:37", "text": "我喜歡你做的縮放效果。  飛漲。  好的。  我的天哪。  我需要做一個喵喵叫的按鈕。  這個按鈕是做什麼用的"}, {"type": "subtitle", "time": 25191.11, "timestamp": "06:59:51", "text": "？"}, {"type": "subtitle", "time": 25195.35, "timestamp": "06:59:55", "text": "我的天哪，喬克的下半身不見了。  等等，什麼？  他現在"}]
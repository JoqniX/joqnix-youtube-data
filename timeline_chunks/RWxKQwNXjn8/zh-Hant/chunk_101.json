[{"type": "subtitle", "time": 6077.189, "timestamp": "01:41:17", "text": "。  它非常可愛。  我喜歡雪貂。  我現在該畫什麼呢？  你知道嗎？我要給你的熊貓配上飾品。好的。我打算"}, {"type": "subtitle", "time": 6079.27, "timestamp": "01:41:19", "text": "送他一些配件。我"}, {"type": "subtitle", "time": 6087.83, "timestamp": "01:41:27", "text": "要給他什麼？我該給他什麼？請隨意這樣"}, {"type": "subtitle", "time": 6092.31, "timestamp": "01:41:32", "text": "做。是的。  我不介意的話，我就停"}, {"type": "subtitle", "time": 6098.709, "timestamp": "01:41:38", "text": "下來，我稍微挪一下筆，這樣"}, {"type": "subtitle", "time": 6101.83, "timestamp": "01:41:41", "text": "我就有空間畫“等等，什麼？心形圖案是什麼？哦，"}]
[{"type": "subtitle", "time": 4562.229, "timestamp": "01:16:02", "text": "耶！"}, {"type": "subtitle", "time": 4564.55, "timestamp": "01:16:04", "text": "我"}, {"type": "subtitle", "time": 4567.11, "timestamp": "01:16:07", "text": "打算在它周圍畫一些愛心。  哇。"}, {"type": "subtitle", "time": 4579.11, "timestamp": "01:16:19", "text": "我記得我把你畫得像"}, {"type": "subtitle", "time": 4603.27, "timestamp": "01:16:43", "text": "個小精靈。  就像我畫了一群鐵桿 YouTuber 一樣。我記得我做過那件事。  哦，糟糕。  太瘋狂了，老兄。  我喜歡pendas。"}, {"type": "subtitle", "time": 4605.35, "timestamp": "01:16:45", "text": "你用粉筆寫字嗎？  你寫作嗎？你喜歡用粉筆寫字嗎"}, {"type": "subtitle", "time": 4613.669, "timestamp": "01:16:53", "text": "？  正確的。是的。不，我是說故事之類的。  我想寫作。所以我選擇了英國文學"}, {"type": "subtitle", "time": 4615.83, "timestamp": "01:16:55", "text": "專業，希望能夠輕鬆獲得學位，同時也能學習寫作，這樣我就可以寫自己的故事了"}]
[{"type": "subtitle", "time": 9480.79, "timestamp": "02:38:00", "text": "？我不是"}, {"type": "subtitle", "time": 9490.309, "timestamp": "02:38:10", "text": "故意的。我，我其實說話都不太清楚。  和奶奶一起看了會兒"}, {"type": "subtitle", "time": 9496.63, "timestamp": "02:38:16", "text": "劇。  好的，保重。可愛的。小心。  我發誓我發誓我發誓，我絕對不是故意的。"}, {"type": "subtitle", "time": 9509.27, "timestamp": "02:38:29", "text": "我的天哪，喬。我覺得我們"}, {"type": "subtitle", "time": 9522.63, "timestamp": "02:38:42", "text": "得罪了整個"}, {"type": "subtitle", "time": 9524.389, "timestamp": "02:38:44", "text": "波蘭。哦，不，約翰。我覺得我們不能再去波蘭了。"}, {"type": "subtitle", "time": 9538.79, "timestamp": "02:38:58", "text": "我的天啊。我覺得我們不能再去波蘭了"}]
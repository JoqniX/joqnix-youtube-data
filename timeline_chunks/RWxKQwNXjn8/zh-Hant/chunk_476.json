[{"type": "subtitle", "time": 28567.75, "timestamp": "07:56:07", "text": "不是這樣的，對吧？  我差點就"}, {"type": "subtitle", "time": 28571.27, "timestamp": "07:56:11", "text": "成功了。"}, {"type": "subtitle", "time": 28580.868, "timestamp": "07:56:20", "text": "我差點就成功了。疼痛。  [音樂] 是啊。你好。噓。歡迎。歡迎。"}, {"type": "subtitle", "time": 28591.99, "timestamp": "07:56:31", "text": "[音樂] 歡迎。  他"}, {"type": "subtitle", "time": 28610.97, "timestamp": "07:56:50", "text": "這人太過分了。  [音樂] 咦？真是太哦。哦，就差一點點。但更多的是喵喵聲，沒有"}]
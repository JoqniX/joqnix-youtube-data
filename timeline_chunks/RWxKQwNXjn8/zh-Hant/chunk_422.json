[{"type": "subtitle", "time": 25321.11, "timestamp": "07:02:01", "text": "哦，是的。是的。這個人說話比她稍微低一點。親愛的，你是這個意思嗎"}, {"type": "subtitle", "time": 25327.11, "timestamp": "07:02:07", "text": "？哦，"}, {"type": "subtitle", "time": 25331.99, "timestamp": "07:02:11", "text": "不。你比較喜歡那種嗎？哦，不。  是的"}, {"type": "subtitle", "time": 25340.548, "timestamp": "07:02:20", "text": "。  你是什​​麼意思？你的「哦不」是什麼？我的天啊。  你們還在用免持通話。  揚聲器。"}, {"type": "subtitle", "time": 25346.15, "timestamp": "07:02:26", "text": "為什麼？你是什​​麼意思？我們又沒"}, {"type": "subtitle", "time": 25349.27, "timestamp": "07:02:29", "text": "做什麼可疑的事"}, {"type": "subtitle", "time": 25353.03, "timestamp": "07:02:33", "text": "，對吧？我認為我們沒有。不"}, {"type": "subtitle", "time": 25361.91, "timestamp": "07:02:41", "text": "，我們沒有做任何可疑的事情。是的，黑暗絕對不是想從背後對我做什麼。"}, {"type": "subtitle", "time": 25378.868, "timestamp": "07:02:58", "text": "不，別指責我。  看過一次就"}]
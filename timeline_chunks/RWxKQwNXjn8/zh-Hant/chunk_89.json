[{"type": "subtitle", "time": 5355.11, "timestamp": "01:29:15", "text": "俱樂部。  好了。那就是"}, {"type": "subtitle", "time": 5359.91, "timestamp": "01:29:19", "text": "你化身為一條魚。  哇。好的。 Glo。"}, {"type": "subtitle", "time": 5365.27, "timestamp": "01:29:25", "text": "你是條發光的魚。  所以畫眼睛的時候，想畫得簡單一些，其實不需要上色"}, {"type": "subtitle", "time": 5388.229, "timestamp": "01:29:48", "text": "。"}, {"type": "subtitle", "time": 5393.43, "timestamp": "01:29:53", "text": "你可以只畫一個黑點，然後添加一些小細節，例如睫毛，或是加一點眼部高光。  或者如果"}, {"type": "subtitle", "time": 5395.27, "timestamp": "01:29:55", "text": "你畫的是Q版人物，而且眼睛是彩色的，"}]
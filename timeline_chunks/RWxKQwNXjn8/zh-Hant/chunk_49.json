[{"type": "subtitle", "time": 2954.15, "timestamp": "00:49:14", "text": "？嗯？你覺得自己欺負了一個嬰兒，你有什麼感覺？你快樂嗎？你為自己感到驕傲嗎，聊天對象？他還是"}, {"type": "subtitle", "time": 2959.67, "timestamp": "00:49:19", "text": "個嬰兒。  是的，聊天記錄已關聯。聊天記錄已關聯"}, {"type": "subtitle", "time": 2961.91, "timestamp": "00:49:21", "text": "。  [音樂] 對不起，夥計，讓你想像中的"}, {"type": "subtitle", "time": 2981.43, "timestamp": "00:49:41", "text": "這不是我的孩子。雖然"}, {"type": "subtitle", "time": 2985.589, "timestamp": "00:49:45", "text": "孩子不是我的，但你這樣做會讓"}, {"type": "subtitle", "time": 2987.589, "timestamp": "00:49:47", "text": "一個孩子難過。  你對此有何感想？嗯？你在欺負孩子。欺凌兒童。  真亂來。"}, {"type": "subtitle", "time": 2990.23, "timestamp": "00:49:50", "text": "你不"}, {"type": "subtitle", "time": 2992.47, "timestamp": "00:49:52", "text": "應該欺負"}]
[{"type": "subtitle", "time": 20167.91, "timestamp": "05:36:07", "text": "然後是符號，大概兩個符號吧。你想先做哪一個"}, {"type": "subtitle", "time": 20170.948, "timestamp": "05:36:10", "text": "？符號。好的。你好。嗯，"}, {"type": "subtitle", "time": 20187.35, "timestamp": "05:36:27", "text": "你看到了什麼？棒棒糖。什麼？棒棒糖"}, {"type": "subtitle", "time": 20190.788, "timestamp": "05:36:30", "text": "。"}, {"type": "subtitle", "time": 20193.35, "timestamp": "05:36:33", "text": "我知道用這個……嗯……東西。好的。哦。半條命。半條命。好的。熱的，呃，一個硬脈衝符號。硬"}, {"type": "subtitle", "time": 20203.11, "timestamp": "05:36:43", "text": "嗨。在半場。嗨。擴散。想做記憶練習嗎？好的。我們來做記憶練習。好的。我們來做記憶練習。"}]
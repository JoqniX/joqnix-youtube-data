[{"type": "subtitle", "time": 121.35, "timestamp": "00:02:01", "text": "呃，你能把我的床還給我嗎？"}, {"type": "subtitle", "time": 128.55, "timestamp": "00:02:08", "text": "想要的種子來款待你。"}, {"type": "subtitle", "time": 139.51, "timestamp": "00:02:19", "text": "因為那該死的苦力怕，我差點就失去了我五年來在硬核遊戲世界裡累積的寶貴經驗。"}, {"type": "subtitle", "time": 143.35, "timestamp": "00:02:23", "text": "天哪，爬行者真煩。"}, {"type": "subtitle", "time": 148.63, "timestamp": "00:02:28", "text": "等等，五年。什麼？哇！"}, {"type": "subtitle", "time": 155.35, "timestamp": "00:02:35", "text": "尤其是在高難度模式下，你如何生存？哇。  再見。"}, {"type": "subtitle", "time": 166.47, "timestamp": "00:02:46", "text": "哇，老兄。  太佩服你了！來自印度的愛。  是的。你好，普拉桑德。  你好嗎？"}, {"type": "subtitle", "time": 179.11, "timestamp": "00:02:59", "text": "我們玩的是《我的世界》死神模式。哦，是時候"}]
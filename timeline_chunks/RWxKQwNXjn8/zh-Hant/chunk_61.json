[{"type": "subtitle", "time": 3670.309, "timestamp": "01:01:10", "text": "告訴你，和他一起直播之後，我討厭老年人。我的天啊，那個"}, {"type": "subtitle", "time": 3674.309, "timestamp": "01:01:14", "text": "小混蛋兄弟，我們是朋友，所以我可以取笑"}, {"type": "subtitle", "time": 3676.71, "timestamp": "01:01:16", "text": "他。  喔"}, {"type": "subtitle", "time": 3678.069, "timestamp": "01:01:18", "text": "我的"}, {"type": "subtitle", "time": 3686.87, "timestamp": "01:01:26", "text": "我把腦"}, {"type": "subtitle", "time": 3706.39, "timestamp": "01:01:46", "text": "我看到你也在玩，對吧？你和誰一起玩的？呃，Arthanx，我們從來沒照顧過熊貓，我們可能永遠看不到它們。"}, {"type": "subtitle", "time": 3708.549, "timestamp": "01:01:48", "text": "熊貓會自己去…它們很厲害，是啊，它們生存能力很差。我現在就去私訊"}]
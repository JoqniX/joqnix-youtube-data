[{"type": "subtitle", "time": 31452.308, "timestamp": "08:44:12", "text": "[音樂]"}, {"type": "subtitle", "time": 31467.17, "timestamp": "08:44:27", "text": "我們先結束這段，然後繼續。  快點。滑鼠左鍵不起作用。  哦"}, {"type": "subtitle", "time": 31479.03, "timestamp": "08:44:39", "text": "，什麼？  為什麼滑鼠左鍵不起作用？你好。  待在……你為什麼在說疼痛"}, {"type": "subtitle", "time": 31481.75, "timestamp": "08:44:41", "text": "？  點擊滑鼠左鍵即可播放"}]
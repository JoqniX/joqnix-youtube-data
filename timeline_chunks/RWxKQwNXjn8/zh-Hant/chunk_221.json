[{"type": "subtitle", "time": 13265.91, "timestamp": "03:41:05", "text": "目前，我想去日本，試著在神椿工作室找份工作。我"}, {"type": "subtitle", "time": 13276.55, "timestamp": "03:41:16", "text": "不知道，我不知道"}, {"type": "subtitle", "time": 13278.95, "timestamp": "03:41:18", "text": "我現在對回歸究竟有多大的熱情。如果可以的話，我只想在那裡工作。"}, {"type": "subtitle", "time": 13294.309, "timestamp": "03:41:34", "text": "我不知道。不過，我倒是不介意。我非常樂意。"}, {"type": "subtitle", "time": 13318.79, "timestamp": "03:41:58", "text": "我好想小便。  我需要為此製作一些東西"}]
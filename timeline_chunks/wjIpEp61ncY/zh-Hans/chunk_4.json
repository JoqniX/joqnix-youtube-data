[{"type": "subtitle", "time": 246.67, "timestamp": "00:04:06", "text": "今晚好吧，我打算去玩。"}, {"type": "subtitle", "time": 249.869, "timestamp": "00:04:09", "text": "重新装弹很容易"}, {"type": "subtitle", "time": 255.50900000000001, "timestamp": "00:04:15", "text": "排名处有一个点击图标 C 点击有一个"}, {"type": "subtitle", "time": 258.909, "timestamp": "00:04:18", "text": "皮肤？嗯，我觉得快了。"}, {"type": "subtitle", "time": 264.79, "timestamp": "00:04:24", "text": "哦"}, {"type": "subtitle", "time": 267.27, "timestamp": "00:04:27", "text": "不错，我不知道我是否收藏了这个"}, {"type": "subtitle", "time": 270.43, "timestamp": "00:04:30", "text": "我想我还是没有。"}, {"type": "subtitle", "time": 271.59, "timestamp": "00:04:31", "text": "我是银级"}, {"type": "subtitle", "time": 273.95, "timestamp": "00:04:33", "text": "我不太擅长"}, {"type": "subtitle", "time": 276.35, "timestamp": "00:04:36", "text": "等等，我不知道这到底是不是这个版本。"}, {"type": "subtitle", "time": 282.51, "timestamp": "00:04:42", "text": "构建过程中没有构建重载或"}, {"type": "subtitle", "time": 285.909, "timestamp": "00:04:45", "text": "等等，你为什么要加入大厅？"}, {"type": "subtitle", "time": 289.31, "timestamp": "00:04:49", "text": "还没，我得先进入游戏。"}, {"type": "subtitle", "time": 292.27, "timestamp": "00:04:52", "text": "走吧，那里有M，快走，兄弟"}, {"type": "subtitle", "time": 293.27, "timestamp": "00:04:53", "text": "什么"}, {"type": "subtitle", "time": 296.23, "timestamp": "00:04:56", "text": "操，我们走吧，泽尔"}]
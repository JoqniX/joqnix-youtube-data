[{"type": "subtitle", "time": 3541.789, "timestamp": "00:59:01", "text": "啊，我身上有两个人，所以你可能"}, {"type": "subtitle", "time": 3556.27, "timestamp": "00:59:16", "text": "等等，他是个机器人？"}, {"type": "subtitle", "time": 3560.589, "timestamp": "00:59:20", "text": "不行，你没事的，我身上有机器人。"}, {"type": "subtitle", "time": 3563.47, "timestamp": "00:59:23", "text": "也可能是一个"}, {"type": "subtitle", "time": 3577.19, "timestamp": "00:59:37", "text": "BT，你在哪里？"}, {"type": "subtitle", "time": 3581.349, "timestamp": "00:59:41", "text": "所以，姨妈来了，她很喜欢她。"}, {"type": "subtitle", "time": 3584.789, "timestamp": "00:59:44", "text": "pH模拟器好像出了问题，或者其他什么原因。"}, {"type": "subtitle", "time": 3587.15, "timestamp": "00:59:47", "text": "我当时正在帮她照顾那位阿姨"}, {"type": "subtitle", "time": 3590.75, "timestamp": "00:59:50", "text": "需要技术支持方面的帮助"}, {"type": "subtitle", "time": 3594.029, "timestamp": "00:59:54", "text": "是的，他们会打电话给我寻求帮助。"}, {"type": "subtitle", "time": 3599.27, "timestamp": "00:59:59", "text": "不知道为什么，哦，好吧，我相信"}]
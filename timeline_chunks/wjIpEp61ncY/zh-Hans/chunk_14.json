[{"type": "subtitle", "time": 842.99, "timestamp": "00:14:02", "text": "我仍然不知道如何在……上进行抢劫。"}, {"type": "subtitle", "time": 845.43, "timestamp": "00:14:05", "text": "火车上没人认识我的朋友"}, {"type": "subtitle", "time": 869.91, "timestamp": "00:14:29", "text": "Royale 疯狂的直播看起来不一样了"}, {"type": "subtitle", "time": 871.749, "timestamp": "00:14:31", "text": "我的意思是，我玩的时候画面设置调得很低。"}, {"type": "subtitle", "time": 873.03, "timestamp": "00:14:33", "text": "但它看起来"}, {"type": "subtitle", "time": 876.509, "timestamp": "00:14:36", "text": "不同的"}, {"type": "subtitle", "time": 878.79, "timestamp": "00:14:38", "text": "直播黄金"}, {"type": "subtitle", "time": 886.79, "timestamp": "00:14:46", "text": "哇哦，所以那些刚加入的人"}]
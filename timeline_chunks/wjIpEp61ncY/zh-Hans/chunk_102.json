[{"type": "subtitle", "time": 6120.75, "timestamp": "01:42:00", "text": "看起来像真的"}, {"type": "subtitle", "time": 6122.43, "timestamp": "01:42:02", "text": "人，一个真实的人，你就是那个人"}, {"type": "subtitle", "time": 6129.669, "timestamp": "01:42:09", "text": "快要死了，你的朋友在哪儿？"}, {"type": "subtitle", "time": 6143.589, "timestamp": "01:42:23", "text": "朋友，哦，我明白了，你真的不是"}, {"type": "subtitle", "time": 6145.43, "timestamp": "01:42:25", "text": "去吧，你不会真的来的。"}, {"type": "subtitle", "time": 6147.87, "timestamp": "01:42:27", "text": "你不会得到你朋友的"}, {"type": "subtitle", "time": 6155.35, "timestamp": "01:42:35", "text": "离开"}, {"type": "subtitle", "time": 6158.43, "timestamp": "01:42:38", "text": "你好，敲门，那是另一个"}, {"type": "subtitle", "time": 6161.39, "timestamp": "01:42:41", "text": "这到底是怎么回事？为什么会有真人？"}, {"type": "subtitle", "time": 6162.87, "timestamp": "01:42:42", "text": "站在这里，你知道自己该做什么。"}, {"type": "subtitle", "time": 6169.03, "timestamp": "01:42:49", "text": "到"}, {"type": "subtitle", "time": 6177.91, "timestamp": "01:42:57", "text": "那家伙当时在露营"}]
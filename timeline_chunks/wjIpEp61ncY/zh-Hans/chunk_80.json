[{"type": "subtitle", "time": 4801.11, "timestamp": "01:20:01", "text": "[音乐]"}, {"type": "subtitle", "time": 4803.95, "timestamp": "01:20:03", "text": "那没关系，因为我们很容易就能获得黄金。"}, {"type": "subtitle", "time": 4806.79, "timestamp": "01:20:06", "text": "无论如何，在这个世界里，我不会……"}, {"type": "subtitle", "time": 4808.669, "timestamp": "01:20:08", "text": "撒谎，我的反应也一样，我当时就像……"}, {"type": "subtitle", "time": 4811.95, "timestamp": "01:20:11", "text": "我当时就想，这肯定是个骗局。"}, {"type": "subtitle", "time": 4813.99, "timestamp": "01:20:13", "text": "哦，我们轻易就得到了黄金"}, {"type": "subtitle", "time": 4819.51, "timestamp": "01:20:19", "text": "到处都能挖到它"}, {"type": "subtitle", "time": 4821.19, "timestamp": "01:20:21", "text": "你自己也这么认为。"}, {"type": "subtitle", "time": 4823.629, "timestamp": "01:20:23", "text": "[音乐]"}, {"type": "subtitle", "time": 4826.51, "timestamp": "01:20:26", "text": "哎呀，糟糕，我不小心买了两个。"}, {"type": "subtitle", "time": 4828.149, "timestamp": "01:20:28", "text": "你需要枪吗？"}, {"type": "subtitle", "time": 4838.03, "timestamp": "01:20:38", "text": "一个感谢"}, {"type": "subtitle", "time": 4847.47, "timestamp": "01:20:47", "text": "弹药 哦，这个 这是"}]
[{"type": "subtitle", "time": 1446.909, "timestamp": "00:24:06", "text": "好的，哟，怎么样，怎么样，怎么样？"}, {"type": "subtitle", "time": 1449.549, "timestamp": "00:24:09", "text": "欢迎来到"}, {"type": "subtitle", "time": 1453.11, "timestamp": "00:24:13", "text": "我不是这个频道的拥有者"}, {"type": "subtitle", "time": 1455.669, "timestamp": "00:24:15", "text": "但我只是个客人"}, {"type": "subtitle", "time": 1459.59, "timestamp": "00:24:19", "text": "显然，并且确实要离开才能得到"}, {"type": "subtitle", "time": 1462.149, "timestamp": "00:24:22", "text": "晚饭时他出去了，是的，他"}, {"type": "subtitle", "time": 1464.87, "timestamp": "00:24:24", "text": "就这样，我把你们所有人都留下了。"}, {"type": "subtitle", "time": 1467.789, "timestamp": "00:24:27", "text": "我，我来这里是为了娱乐大家。"}, {"type": "subtitle", "time": 1471.83, "timestamp": "00:24:31", "text": "很高兴见到你们。"}, {"type": "subtitle", "time": 1475.07, "timestamp": "00:24:35", "text": "请叫我客人，我不是来做广告的。"}, {"type": "subtitle", "time": 1483.11, "timestamp": "00:24:43", "text": "哦，糟了，我应该喝这个的。"}, {"type": "subtitle", "time": 1486.95, "timestamp": "00:24:46", "text": "首先，啊，我不付钱。"}, {"type": "subtitle", "time": 1489.83, "timestamp": "00:24:49", "text": "注意哦，客人，我也是客人，你"}, {"type": "subtitle", "time": 1491.789, "timestamp": "00:24:51", "text": "欢迎来到地狱"}, {"type": "subtitle", "time": 1495.51, "timestamp": "00:24:55", "text": "是的，欢迎来到直播间，我是嘉宾。"}, {"type": "subtitle", "time": 1498.87, "timestamp": "00:24:58", "text": "另一位客人正在玩游戏。"}]
[{"type": "subtitle", "time": 6660.31, "timestamp": "01:51:00", "text": "他们正在打架，我要去……"}, {"type": "subtitle", "time": 6662.149, "timestamp": "01:51:02", "text": "我们要回去的那辆车，我没有"}, {"type": "subtitle", "time": 6664.79, "timestamp": "01:51:04", "text": "我不在乎，我只想让那混蛋死，我"}, {"type": "subtitle", "time": 6667.669, "timestamp": "01:51:07", "text": "我打算去……我打算去……"}, {"type": "subtitle", "time": 6669.91, "timestamp": "01:51:09", "text": "自行车没问题，我先走，不，过来"}, {"type": "subtitle", "time": 6678.189, "timestamp": "01:51:18", "text": "死吧"}, {"type": "subtitle", "time": 6682.83, "timestamp": "01:51:22", "text": "去他哪儿？我没事吧？我正在运行这个"}, {"type": "subtitle", "time": 6684.47, "timestamp": "01:51:24", "text": "哦，是的哦"}, {"type": "subtitle", "time": 6686.31, "timestamp": "01:51:26", "text": "是的"}, {"type": "subtitle", "time": 6688.95, "timestamp": "01:51:28", "text": "真的吗？哦，是的，哦，直截了当"}, {"type": "subtitle", "time": 6691.03, "timestamp": "01:51:31", "text": "直的"}, {"type": "subtitle", "time": 6699.99, "timestamp": "01:51:39", "text": "你一个人"}, {"type": "subtitle", "time": 6702.189, "timestamp": "01:51:42", "text": "我根本不在乎你"}, {"type": "subtitle", "time": 6704.87, "timestamp": "01:51:44", "text": "你也会死的哦"}, {"type": "subtitle", "time": 6708.27, "timestamp": "01:51:48", "text": "请上车"}, {"type": "subtitle", "time": 6711.189, "timestamp": "01:51:51", "text": "好吧，我要去哪儿了？"}, {"type": "subtitle", "time": 6713.43, "timestamp": "01:51:53", "text": "我看到了。"}, {"type": "subtitle", "time": 6715.229, "timestamp": "01:51:55", "text": "那是你吗"}, {"type": "subtitle", "time": 6718.55, "timestamp": "01:51:58", "text": "先生，不，是另一个人，那是个机器人。"}]
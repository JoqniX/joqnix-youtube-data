[{"type": "subtitle", "time": 480.23, "timestamp": "00:08:00", "text": "如果你想玩更多游戏，可以参加派对。"}, {"type": "subtitle", "time": 482.589, "timestamp": "00:08:02", "text": "比赛我会回来我会特别"}, {"type": "subtitle", "time": 485.99, "timestamp": "00:08:05", "text": "速跑伊恩回来了，好吗？我在"}, {"type": "subtitle", "time": 489.909, "timestamp": "00:08:09", "text": "如果你愿意的话，我可以有这个。"}, {"type": "subtitle", "time": 491.189, "timestamp": "00:08:11", "text": "那饲料"}, {"type": "subtitle", "time": 494.309, "timestamp": "00:08:14", "text": "我确实设置好了。"}, {"type": "subtitle", "time": 498.39, "timestamp": "00:08:18", "text": "好吧，没有别的选择，上面写着“我”。"}, {"type": "subtitle", "time": 500.99, "timestamp": "00:08:20", "text": "这个频道无法播放，哦，等等"}, {"type": "subtitle", "time": 503.07, "timestamp": "00:08:23", "text": "等等，等等，我来修，我来修。"}, {"type": "subtitle", "time": 506.749, "timestamp": "00:08:26", "text": "其次，好吧，我忘了……"}, {"type": "subtitle", "time": 525.829, "timestamp": "00:08:45", "text": "与此同时，我将分享以下链接："}, {"type": "subtitle", "time": 527.35, "timestamp": "00:08:47", "text": "这个"}]
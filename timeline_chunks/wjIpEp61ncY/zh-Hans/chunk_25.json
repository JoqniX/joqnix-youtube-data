[{"type": "subtitle", "time": 1503.909, "timestamp": "00:25:03", "text": "拖延时间等运动员回来"}, {"type": "subtitle", "time": 1505.43, "timestamp": "00:25:05", "text": "我应该得到"}, {"type": "subtitle", "time": 1508.51, "timestamp": "00:25:08", "text": "这是因为在这种模式下，有人告诉我"}, {"type": "subtitle", "time": 1512.07, "timestamp": "00:25:12", "text": "我需要知道这该死的东西到底在哪儿。"}, {"type": "subtitle", "time": 1514.149, "timestamp": "00:25:14", "text": "我不会为此道歉"}, {"type": "subtitle", "time": 1516.909, "timestamp": "00:25:16", "text": "我咒骂这件事，因为我通常都会骂人。"}, {"type": "subtitle", "time": 1523.75, "timestamp": "00:25:23", "text": "看到和"}, {"type": "subtitle", "time": 1526.43, "timestamp": "00:25:26", "text": "主播呃，他，他把我一个人留给你了。"}, {"type": "subtitle", "time": 1528.87, "timestamp": "00:25:28", "text": "所以他应该知道那是什么"}, {"type": "subtitle", "time": 1530.43, "timestamp": "00:25:30", "text": "将会"}, {"type": "subtitle", "time": 1533.35, "timestamp": "00:25:33", "text": "我找不到"}, {"type": "subtitle", "time": 1537.23, "timestamp": "00:25:37", "text": "啊"}, {"type": "subtitle", "time": 1542.51, "timestamp": "00:25:42", "text": "当然，它在外面，甚至不在里面。"}, {"type": "subtitle", "time": 1542.85, "timestamp": "00:25:42", "text": "当"}, {"type": "subtitle", "time": 1546.43, "timestamp": "00:25:46", "text": "[音乐]"}, {"type": "subtitle", "time": 1550.71, "timestamp": "00:25:50", "text": "它甚至算不上更好的枪，我"}, {"type": "subtitle", "time": 1552.83, "timestamp": "00:25:52", "text": "想"}, {"type": "subtitle", "time": 1555.51, "timestamp": "00:25:55", "text": "我觉得那不是个好主意。"}, {"type": "subtitle", "time": 1558.95, "timestamp": "00:25:58", "text": "我想，但我不会，我不知道"}]
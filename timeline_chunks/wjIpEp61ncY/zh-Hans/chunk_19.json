[{"type": "subtitle", "time": 1152.909, "timestamp": "00:19:12", "text": "音乐别惹我，我们别惹我"}, {"type": "subtitle", "time": 1158.59, "timestamp": "00:19:18", "text": "我该怎么办"}, {"type": "subtitle", "time": 1162.029, "timestamp": "00:19:22", "text": "扮演乔希的话，我本来想扮演樱，但是有些"}, {"type": "subtitle", "time": 1164.99, "timestamp": "00:19:24", "text": "人们不喜欢她，因为……"}, {"type": "subtitle", "time": 1169.39, "timestamp": "00:19:29", "text": "不知何故，哦哦 2.0 粉色漂亮的小圆面包"}, {"type": "subtitle", "time": 1170.909, "timestamp": "00:19:30", "text": "就像面包一样"}, {"type": "subtitle", "time": 1172.87, "timestamp": "00:19:32", "text": "一个这个"}, {"type": "subtitle", "time": 1177.669, "timestamp": "00:19:37", "text": "你确定大厅没问题吗？哦"}, {"type": "subtitle", "time": 1180.549, "timestamp": "00:19:40", "text": "这是这个这个这个这是"}, {"type": "subtitle", "time": 1192.909, "timestamp": "00:19:52", "text": "它就在那里"}, {"type": "subtitle", "time": 1198.149, "timestamp": "00:19:58", "text": "走吧，我要去个热门地点，等等"}, {"type": "subtitle", "time": 1199.549, "timestamp": "00:19:59", "text": "既然我们正在这样做，我们就不这样做了。"}]
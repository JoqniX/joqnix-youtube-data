[{"type": "subtitle", "time": 16562.47, "timestamp": "04:36:02", "text": "你好，你最近怎么样？"}, {"type": "subtitle", "time": 16566.709, "timestamp": "04:36:06", "text": "乔，你能再做一次吗？"}, {"type": "subtitle", "time": 16568.31, "timestamp": "04:36:08", "text": "请"}, {"type": "subtitle", "time": 16573.029, "timestamp": "04:36:13", "text": "啊，我想说我今天过得不错。"}, {"type": "subtitle", "time": 16592.429, "timestamp": "04:36:32", "text": "笨蛋，为什么会这样"}, {"type": "subtitle", "time": 16596.15, "timestamp": "04:36:36", "text": "跳舞，为什么它会跳舞？但那是"}, {"type": "subtitle", "time": 16602.029, "timestamp": "04:36:42", "text": "嗨，谢谢你。"}, {"type": "subtitle", "time": 16605.269, "timestamp": "04:36:45", "text": "提醒一下，我去倒点热水。"}, {"type": "subtitle", "time": 16607.269, "timestamp": "04:36:47", "text": "和"}]
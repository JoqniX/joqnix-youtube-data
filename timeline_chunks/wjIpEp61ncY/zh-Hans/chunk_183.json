[{"type": "subtitle", "time": 10992.269, "timestamp": "03:03:12", "text": "什么？不，我的天啊，电脑，电脑，求求你别这样！"}, {"type": "subtitle", "time": 10995.469, "timestamp": "03:03:15", "text": "死吧，我的天啊，我的一切显而易见"}, {"type": "subtitle", "time": 11004.07, "timestamp": "03:03:24", "text": "1920年和1980年在哪里？我的天哪"}, {"type": "subtitle", "time": 11029.429, "timestamp": "03:03:49", "text": "猜猜我得不到H"}, {"type": "subtitle", "time": 11032.71, "timestamp": "03:03:52", "text": "呃，我该如何解锁我的鼠标？呃"}]
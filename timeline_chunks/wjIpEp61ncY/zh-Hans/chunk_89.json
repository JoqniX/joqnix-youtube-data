[{"type": "subtitle", "time": 5341.83, "timestamp": "01:29:01", "text": "留下来，我喊名字喊累了。"}, {"type": "subtitle", "time": 5344.149, "timestamp": "01:29:04", "text": "就像CH说的，我们走吧，我们需要离开。"}, {"type": "subtitle", "time": 5346.27, "timestamp": "01:29:06", "text": "你还在那儿狙击呢。"}, {"type": "subtitle", "time": 5348.75, "timestamp": "01:29:08", "text": "你没捡掉的弹药，等等"}, {"type": "subtitle", "time": 5350.31, "timestamp": "01:29:10", "text": "你做到了"}, {"type": "subtitle", "time": 5352.47, "timestamp": "01:29:12", "text": "好的，谢谢。"}, {"type": "subtitle", "time": 5355.91, "timestamp": "01:29:15", "text": "你等等，它在哪儿？哦，谢谢，我就是它"}, {"type": "subtitle", "time": 5358.43, "timestamp": "01:29:18", "text": "我再次醒来时，却感觉不到任何不适。"}, {"type": "subtitle", "time": 5360.629, "timestamp": "01:29:20", "text": "如果你想狙击，那就离开吧。"}, {"type": "subtitle", "time": 5367.189, "timestamp": "01:29:27", "text": "哦"}, {"type": "subtitle", "time": 5369.109, "timestamp": "01:29:29", "text": "我们"}, {"type": "subtitle", "time": 5372.39, "timestamp": "01:29:32", "text": "你好哦"}, {"type": "subtitle", "time": 5375.669, "timestamp": "01:29:35", "text": "呃，如果你想的话，我们可以去这里。"}, {"type": "subtitle", "time": 5378.39, "timestamp": "01:29:38", "text": "下一座山"}, {"type": "subtitle", "time": 5391.75, "timestamp": "01:29:51", "text": "请注意，我希望我们进去了，是的，哦，上帝"}]
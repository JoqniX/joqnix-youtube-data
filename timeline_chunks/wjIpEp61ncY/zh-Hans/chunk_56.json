[{"type": "subtitle", "time": 3360.029, "timestamp": "00:56:00", "text": "你知道为什么吗？因为我去的地方他们一直……"}, {"type": "subtitle", "time": 3364.15, "timestamp": "00:56:04", "text": "喂我们吃卷心菜，我们算是喂饱了。"}, {"type": "subtitle", "time": 3367.309, "timestamp": "00:56:07", "text": "现在卷心菜都长出来了，他们继续喂食。"}, {"type": "subtitle", "time": 3368.71, "timestamp": "00:56:08", "text": "卷心菜"}, {"type": "chat", "time": 3369.641, "timestamp": "00:56:09", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "more like a tomato"}, {"type": "subtitle", "time": 3371.589, "timestamp": "00:56:11", "text": "CH别担心，你"}, {"type": "chat", "time": 3372.968, "timestamp": "00:56:12", "author": "@Hero_338", "avatar": "https://yt4.ggpht.com/0uNlIhqsigPTN5hDlTHiX6E1xHNJL_TKrsEvxszwXL5t9cJLNqnfZ0L6Wz1pkyw3Fb-F_l4e=s64-c-k-c0x00ffffff-no-rj", "message": "HAHAHAH"}, {"type": "chat", "time": 3379.522, "timestamp": "00:56:19", "author": "@Hero_338", "avatar": "https://yt4.ggpht.com/0uNlIhqsigPTN5hDlTHiX6E1xHNJL_TKrsEvxszwXL5t9cJLNqnfZ0L6Wz1pkyw3Fb-F_l4e=s64-c-k-c0x00ffffff-no-rj", "message": "CABBAGE "}, {"type": "subtitle", "time": 3384.23, "timestamp": "00:56:24", "text": "那更像个番茄"}, {"type": "subtitle", "time": 3387.109, "timestamp": "00:56:27", "text": "哈哈，没关系，查德叫我什么来着"}, {"type": "subtitle", "time": 3391.43, "timestamp": "00:56:31", "text": "你想要这个没问题，你知道为什么吗？因为我"}, {"type": "subtitle", "time": 3393.47, "timestamp": "00:56:33", "text": "我一生中听过太多事情了。"}, {"type": "subtitle", "time": 3394.95, "timestamp": "00:56:34", "text": "关于我的声音"}, {"type": "subtitle", "time": 3403.27, "timestamp": "00:56:43", "text": "老板现在在这里，我不知道。"}, {"type": "subtitle", "time": 3407.069, "timestamp": "00:56:47", "text": "他要去的地方，我们一起去吧。"}, {"type": "subtitle", "time": 3411.309, "timestamp": "00:56:51", "text": "老板，如果你能听到我说话，乔，我想让你……"}, {"type": "subtitle", "time": 3418.67, "timestamp": "00:56:58", "text": "因为我绝对不会去那里。"}]
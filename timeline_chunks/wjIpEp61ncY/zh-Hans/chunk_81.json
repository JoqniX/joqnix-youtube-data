[{"type": "subtitle", "time": 4861.669, "timestamp": "01:21:01", "text": "我跑光了，哦不，不可能，枪……"}, {"type": "subtitle", "time": 4863.43, "timestamp": "01:21:03", "text": "买的，就在这儿，我刚拿到。"}, {"type": "subtitle", "time": 4865.99, "timestamp": "01:21:05", "text": "从一个箱子里，更不用说我"}, {"type": "subtitle", "time": 4868.31, "timestamp": "01:21:08", "text": "买了两个"}, {"type": "subtitle", "time": 4878.51, "timestamp": "01:21:18", "text": "事情是这样的，这游戏真让我生气。"}, {"type": "subtitle", "time": 4880.95, "timestamp": "01:21:20", "text": "目的"}, {"type": "subtitle", "time": 4883.55, "timestamp": "01:21:23", "text": "为什么浪费我的"}, {"type": "subtitle", "time": 4887.79, "timestamp": "01:21:27", "text": "能量哦，过来，稍等片刻"}, {"type": "subtitle", "time": 4891.39, "timestamp": "01:21:31", "text": "我可以吃点RS吗？还是不行？"}, {"type": "subtitle", "time": 4900.31, "timestamp": "01:21:40", "text": "这儿谁有辆自行车？哦，是那辆。"}, {"type": "subtitle", "time": 4903.87, "timestamp": "01:21:43", "text": "骑日本牦牛不良少年自行车哦"}, {"type": "subtitle", "time": 4915.07, "timestamp": "01:21:55", "text": "[音乐]"}, {"type": "subtitle", "time": 4916.55, "timestamp": "01:21:56", "text": "我们来吧"}, {"type": "subtitle", "time": 4919.189, "timestamp": "01:21:59", "text": "不，我们在下面"}]
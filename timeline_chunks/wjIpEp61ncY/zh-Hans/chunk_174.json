[{"type": "subtitle", "time": 10452.429, "timestamp": "02:54:12", "text": "我当时就想，我要搞到武器，我要搞到"}, {"type": "subtitle", "time": 10456.07, "timestamp": "02:54:16", "text": "进入其中一节火车车厢"}, {"type": "subtitle", "time": 10460.07, "timestamp": "02:54:20", "text": "但我谁知道会有这样一种情况呢？"}, {"type": "subtitle", "time": 10463.229, "timestamp": "02:54:23", "text": "那里真的就像"}, {"type": "subtitle", "time": 10483.07, "timestamp": "02:54:43", "text": "他拿走了我的SL，哦，我的HP全满了"}, {"type": "subtitle", "time": 10490.79, "timestamp": "02:54:50", "text": "我杀了"}, {"type": "subtitle", "time": 10493.67, "timestamp": "02:54:53", "text": "我又回到游戏中了。"}]
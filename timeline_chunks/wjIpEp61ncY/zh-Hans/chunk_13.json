[{"type": "subtitle", "time": 784.829, "timestamp": "00:13:04", "text": "法律信息查看否否我"}, {"type": "subtitle", "time": 786.389, "timestamp": "00:13:06", "text": "我不想把自己停靠在溪流中"}, {"type": "subtitle", "time": 790.11, "timestamp": "00:13:10", "text": "我觉得最糟糕的就是这里了。"}, {"type": "subtitle", "time": 794.069, "timestamp": "00:13:14", "text": "那就别玩，别玩，静音许可证"}, {"type": "subtitle", "time": 799.55, "timestamp": "00:13:19", "text": "音频应用在那里，让我试试保持"}, {"type": "subtitle", "time": 803.11, "timestamp": "00:13:23", "text": "真不错。"}, {"type": "subtitle", "time": 806.629, "timestamp": "00:13:26", "text": "想象一下，如果他就这样走了，而我……"}, {"type": "subtitle", "time": 810.829, "timestamp": "00:13:30", "text": "开始播放你知道吗"}, {"type": "subtitle", "time": 813.35, "timestamp": "00:13:33", "text": "音乐，然后他"}, {"type": "subtitle", "time": 816.949, "timestamp": "00:13:36", "text": "无缘无故获得版权"}, {"type": "subtitle", "time": 818.949, "timestamp": "00:13:38", "text": "本来会很可怕，但我们"}, {"type": "subtitle", "time": 821.67, "timestamp": "00:13:41", "text": "负责任的主播 Fortnite 战斗"}, {"type": "subtitle", "time": 825.189, "timestamp": "00:13:45", "text": "我正在努力完成这件事。"}, {"type": "subtitle", "time": 826.949, "timestamp": "00:13:46", "text": "是"}, {"type": "subtitle", "time": 831.47, "timestamp": "00:13:51", "text": "我现在70多级了。"}]
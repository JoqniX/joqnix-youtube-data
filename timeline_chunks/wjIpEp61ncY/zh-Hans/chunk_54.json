[{"type": "subtitle", "time": 3249.19, "timestamp": "00:54:09", "text": "胡说八道，你搞定了，我的天啊，我的天啊"}, {"type": "subtitle", "time": 3254.63, "timestamp": "00:54:14", "text": "天哪，太多人了。"}, {"type": "subtitle", "time": 3258.99, "timestamp": "00:54:18", "text": "好的，下次我们一定抓住他，准备好了。"}, {"type": "subtitle", "time": 3261.15, "timestamp": "00:54:21", "text": "向上"}, {"type": "subtitle", "time": 3265.27, "timestamp": "00:54:25", "text": "是的，下次她来的时候别再给她打电话了。"}, {"type": "subtitle", "time": 3268.99, "timestamp": "00:54:28", "text": "兴奋地等着瞧，哦，原来是那款皮肤啊，好吧"}, {"type": "subtitle", "time": 3272.349, "timestamp": "00:54:32", "text": "是啊是啊，他们已经拿到了"}, {"type": "subtitle", "time": 3276.069, "timestamp": "00:54:36", "text": "皮肤，我以为你需要等待一个"}, {"type": "subtitle", "time": 3279.19, "timestamp": "00:54:39", "text": "哦，好吧，我以为你需要一个他们"}, {"type": "subtitle", "time": 3281.349, "timestamp": "00:54:41", "text": "他们需要开始新的生活，他们需要……"}, {"type": "subtitle", "time": 3284.67, "timestamp": "00:54:44", "text": "生活，搞点大麻，怎么可能，怎么他妈的"}, {"type": "subtitle", "time": 3287.589, "timestamp": "00:54:47", "text": "他们已经有了和我一模一样的东西。"}, {"type": "subtitle", "time": 3289.23, "timestamp": "00:54:49", "text": "以为你需要等待"}, {"type": "subtitle", "time": 3292.15, "timestamp": "00:54:52", "text": "他们露营时遇到的挑战和其他事情"}, {"type": "subtitle", "time": 3295.27, "timestamp": "00:54:55", "text": "什么鬼？是啊，他们在露营哦"}]
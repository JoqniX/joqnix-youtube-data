[{"type": "subtitle", "time": 14592.75, "timestamp": "04:03:12", "text": "大门是什么"}, {"type": "subtitle", "time": 14596.71, "timestamp": "04:03:16", "text": "地狱，谁怎么"}, {"type": "subtitle", "time": 14600.99, "timestamp": "04:03:20", "text": "我尽了全力"}, {"type": "subtitle", "time": 14605.59, "timestamp": "04:03:25", "text": "我们哦，这是"}, {"type": "subtitle", "time": 14612.349, "timestamp": "04:03:32", "text": "我们的基地是"}, {"type": "subtitle", "time": 14616.189, "timestamp": "04:03:36", "text": "不再死去，你知道我是什么吗？"}, {"type": "subtitle", "time": 14621.75, "timestamp": "04:03:41", "text": "那里没有"}, {"type": "subtitle", "time": 14625.07, "timestamp": "04:03:45", "text": "如果不是这样，如果我和团队在一起的话……"}, {"type": "subtitle", "time": 14627.91, "timestamp": "04:03:47", "text": "我本可以制定更好的策略，但是"}, {"type": "subtitle", "time": 14629.149, "timestamp": "04:03:49", "text": "另一个人"}, {"type": "subtitle", "time": 14633.75, "timestamp": "04:03:53", "text": "我不知道，我们……"}, {"type": "subtitle", "time": 14637.96, "timestamp": "04:03:57", "text": "我想要更多"}, {"type": "subtitle", "time": 14639.75, "timestamp": "04:03:59", "text": "[音乐]"}]
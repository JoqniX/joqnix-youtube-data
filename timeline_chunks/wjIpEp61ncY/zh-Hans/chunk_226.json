[{"type": "subtitle", "time": 13560.75, "timestamp": "03:46:00", "text": "洗床洗幸运床"}, {"type": "subtitle", "time": 13568.389, "timestamp": "03:46:08", "text": "天空有好多游戏"}, {"type": "subtitle", "time": 13571.71, "timestamp": "03:46:11", "text": "嗯，枪战游戏，我想要那种……"}, {"type": "subtitle", "time": 13574.07, "timestamp": "03:46:14", "text": "我觉得起床战争会更好，幸运起床战争"}, {"type": "subtitle", "time": 13575.52, "timestamp": "03:46:15", "text": "战争 这个更受欢迎，我就选这个。"}, {"type": "subtitle", "time": 13577.96, "timestamp": "03:46:17", "text": "这个更受欢迎，我就选这个。 这些贸易团队升级了你的基地"}, {"type": "subtitle", "time": 13581.6, "timestamp": "03:46:21", "text": "这些贸易团队升级了你的基地 用钻石玩这个游戏就像我的世界一样吗？"}, {"type": "subtitle", "time": 13584.64, "timestamp": "03:46:24", "text": "用钻石玩这个游戏就像我的世界一样吗？ 床战等等，我想知道它是怎么玩的"}, {"type": "subtitle", "time": 13587.359, "timestamp": "03:46:27", "text": "床战等等，我想知道它是怎么玩的 Fortnite 的起床战争模式是什么样的？"}, {"type": "subtitle", "time": 13590.479, "timestamp": "03:46:30", "text": "Fortnite 的起床战争模式是什么样的？ 它是如何做到的？"}, {"type": "subtitle", "time": 13593.0, "timestamp": "03:46:33", "text": "它是如何做到的？ 工作让我吃点东西"}, {"type": "subtitle", "time": 13602.189, "timestamp": "03:46:42", "text": "橙色，我心情很好"}, {"type": "subtitle", "time": 13605.79, "timestamp": "03:46:45", "text": "嘿，玩游戏的时候别拿其他东西。"}, {"type": "subtitle", "time": 13615.99, "timestamp": "03:46:55", "text": "虚拟的这个 TR 奖励 B 消除到 V"}]
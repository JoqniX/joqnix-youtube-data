[{"type": "subtitle", "time": 6068.91, "timestamp": "01:41:08", "text": "我吃完了晚饭，但我还有……"}, {"type": "subtitle", "time": 6087.189, "timestamp": "01:41:27", "text": "我的游戏显示我有一张钥匙卡，我们来吧。"}, {"type": "subtitle", "time": 6096.91, "timestamp": "01:41:36", "text": "它，而且有很多"}, {"type": "subtitle", "time": 6099.55, "timestamp": "01:41:39", "text": "有两个机器人跟着我们。"}, {"type": "subtitle", "time": 6101.149, "timestamp": "01:41:41", "text": "绝对不可能，就像我说过的，没有"}, {"type": "subtitle", "time": 6103.27, "timestamp": "01:41:43", "text": "这里简直胡说八道太多了，我的意思是"}, {"type": "subtitle", "time": 6105.43, "timestamp": "01:41:45", "text": "真正的人想放弃"}, {"type": "subtitle", "time": 6108.91, "timestamp": "01:41:48", "text": "哦，天哪，请救救我"}, {"type": "subtitle", "time": 6116.109, "timestamp": "01:41:56", "text": "好的。"}, {"type": "subtitle", "time": 6119.149, "timestamp": "01:41:59", "text": "各位，那肯定是机器人，没有真人。"}]
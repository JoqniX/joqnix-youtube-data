[{"type": "subtitle", "time": 16740.629, "timestamp": "04:39:00", "text": "汗流浃背，你的健康状况如何，兄弟？"}, {"type": "subtitle", "time": 16742.83, "timestamp": "04:39:02", "text": "你的"}, {"type": "subtitle", "time": 16756.189, "timestamp": "04:39:16", "text": "拥有这种皮肤的人"}, {"type": "subtitle", "time": 16759.109, "timestamp": "04:39:19", "text": "所以我觉得这就像是一个免费皮肤一样。"}, {"type": "subtitle", "time": 16769.51, "timestamp": "04:39:29", "text": "我几乎为你感到骄傲，兄弟，谢谢。"}, {"type": "subtitle", "time": 16779.868, "timestamp": "04:39:39", "text": "唉，我就是停不下来，我不知道为什么。"}, {"type": "subtitle", "time": 16781.43, "timestamp": "04:39:41", "text": "赌博"}, {"type": "subtitle", "time": 16782.39, "timestamp": "04:39:42", "text": "相当"}, {"type": "subtitle", "time": 16784.23, "timestamp": "04:39:44", "text": "比"}, {"type": "subtitle", "time": 16796.39, "timestamp": "04:39:56", "text": "等等，这是什么？忍者风格的皮肤复制品"}, {"type": "subtitle", "time": 16799.23, "timestamp": "04:39:59", "text": "皮肤来到这里，这简直就是……"}]
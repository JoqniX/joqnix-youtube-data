[{"type": "subtitle", "time": 8641.99, "timestamp": "02:24:01", "text": "首先，我正在观看"}, {"type": "subtitle", "time": 8645.07, "timestamp": "02:24:05", "text": "你们所有人"}, {"type": "subtitle", "time": 8648.349, "timestamp": "02:24:08", "text": "我可能正在观看"}, {"type": "subtitle", "time": 8655.91, "timestamp": "02:24:15", "text": "刺伤，去她在哪里？"}, {"type": "subtitle", "time": 8660.79, "timestamp": "02:24:20", "text": "这是机器人吗？"}, {"type": "subtitle", "time": 8669.07, "timestamp": "02:24:29", "text": "嗯，不，哦，他是"}, {"type": "subtitle", "time": 8672.59, "timestamp": "02:24:32", "text": "他很聪明。"}, {"type": "subtitle", "time": 8683.19, "timestamp": "02:24:43", "text": "兄弟，你死了，兄弟，我先杀了你。"}, {"type": "subtitle", "time": 8686.309, "timestamp": "02:24:46", "text": "天才真棒"}]
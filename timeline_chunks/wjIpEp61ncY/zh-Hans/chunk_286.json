[{"type": "subtitle", "time": 17185.35, "timestamp": "04:46:25", "text": "去他妈的，杀了他！警官们好，我只是个……"}, {"type": "subtitle", "time": 17187.14, "timestamp": "04:46:27", "text": "清白的"}, {"type": "subtitle", "time": 17188.35, "timestamp": "04:46:28", "text": "[音乐]"}, {"type": "subtitle", "time": 17190.948, "timestamp": "04:46:30", "text": "星座并不介意"}, {"type": "subtitle", "time": 17206.99, "timestamp": "04:46:46", "text": "我本来想说“向九头蛇致敬”，结果……"}]
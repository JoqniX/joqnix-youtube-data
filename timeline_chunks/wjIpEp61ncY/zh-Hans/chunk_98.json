[{"type": "subtitle", "time": 5882.51, "timestamp": "01:38:02", "text": "我的H Brutus机枪离我这么近，我怎么"}, {"type": "subtitle", "time": 5884.43, "timestamp": "01:38:04", "text": "兄弟，我们能拿到那把枪吗？我真的想要。"}, {"type": "subtitle", "time": 5886.43, "timestamp": "01:38:06", "text": "那看起来像个该死的奥丁一世"}, {"type": "subtitle", "time": 5889.47, "timestamp": "01:38:09", "text": "想要那玩意儿"}, {"type": "subtitle", "time": 5893.91, "timestamp": "01:38:13", "text": "其次，GG在哪里？"}, {"type": "subtitle", "time": 5898.43, "timestamp": "01:38:18", "text": "那玩意儿一模一样，我拿到了44000。"}, {"type": "subtitle", "time": 5899.99, "timestamp": "01:38:19", "text": "XP，你呢？我觉得我们应该走了。"}, {"type": "subtitle", "time": 5903.55, "timestamp": "01:38:23", "text": "游说，还有收集东西"}, {"type": "subtitle", "time": 5904.229, "timestamp": "01:38:24", "text": "我们"}, {"type": "subtitle", "time": 5907.75, "timestamp": "01:38:27", "text": "我明白了，我想我明白了，等等，我怎么才能看到？"}, {"type": "subtitle", "time": 5909.51, "timestamp": "01:38:29", "text": "H"}, {"type": "subtitle", "time": 5912.189, "timestamp": "01:38:32", "text": "XP 哦，当你意识到我们身处蓝色之中"}, {"type": "subtitle", "time": 5915.35, "timestamp": "01:38:35", "text": "屏幕哦，我能看到你拿到了"}, {"type": "subtitle", "time": 5917.87, "timestamp": "01:38:37", "text": "16500号"}, {"type": "subtitle", "time": 5921.55, "timestamp": "01:38:41", "text": "165,000 嗯，好的，好的，我刚刚看到了我的"}, {"type": "subtitle", "time": 5924.709, "timestamp": "01:38:44", "text": "屏幕，所以在阅读之前先阅读"}, {"type": "subtitle", "time": 5926.47, "timestamp": "01:38:46", "text": "它会显示你从……获得了多少经验值"}, {"type": "subtitle", "time": 5929.07, "timestamp": "01:38:49", "text": "什么任务等等等等"}, {"type": "subtitle", "time": 5939.75, "timestamp": "01:38:59", "text": "今天是几号？21号，好的，我有"}]
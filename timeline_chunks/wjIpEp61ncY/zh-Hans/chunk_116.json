[{"type": "subtitle", "time": 6961.55, "timestamp": "01:56:01", "text": "它们也能藏匿。"}, {"type": "subtitle", "time": 6964.43, "timestamp": "01:56:04", "text": "就像我们在这里待了一段时间了，"}, {"type": "subtitle", "time": 6966.55, "timestamp": "01:56:06", "text": "哪里在哪里"}, {"type": "subtitle", "time": 6969.069, "timestamp": "01:56:09", "text": "你哦，是的，我明白了，好的，好的，我们"}, {"type": "subtitle", "time": 6971.55, "timestamp": "01:56:11", "text": "听到枪战声"}, {"type": "subtitle", "time": 6974.27, "timestamp": "01:56:14", "text": "前面哦，但是有个奖章"}, {"type": "subtitle", "time": 6978.069, "timestamp": "01:56:18", "text": "小心点，好吗，哦哦"}, {"type": "subtitle", "time": 6981.95, "timestamp": "01:56:21", "text": "实际上，没有办法绕过他，他就在那边。"}, {"type": "subtitle", "time": 6983.51, "timestamp": "01:56:23", "text": "剪"}, {"type": "subtitle", "time": 6985.39, "timestamp": "01:56:25", "text": "我的意思是，我落后了。"}, {"type": "subtitle", "time": 6989.629, "timestamp": "01:56:29", "text": "你先看那家伙，他是谁？"}, {"type": "subtitle", "time": 6997.39, "timestamp": "01:56:37", "text": "你和错的人混在一起了，兄弟。"}, {"type": "subtitle", "time": 6998.629, "timestamp": "01:56:38", "text": "错误的"}, {"type": "subtitle", "time": 7003.589, "timestamp": "01:56:43", "text": "你的敌人就在那里，快来吧！"}, {"type": "subtitle", "time": 7005.87, "timestamp": "01:56:45", "text": "来吧，我的天哪，没关系，我擅长……"}, {"type": "subtitle", "time": 7007.51, "timestamp": "01:56:47", "text": "擅长这个，我们去吧，我们去吧"}, {"type": "subtitle", "time": 7009.069, "timestamp": "01:56:49", "text": "那些人，但我能为他们瞄准吗？"}, {"type": "subtitle", "time": 7013.069, "timestamp": "01:56:53", "text": "我不能，你他妈的走吧，我们走吧"}, {"type": "subtitle", "time": 7016.27, "timestamp": "01:56:56", "text": "走吧，走吧，那些人"}, {"type": "subtitle", "time": 7018.55, "timestamp": "01:56:58", "text": "在《Oh Straight Ahead》之前战斗"}]
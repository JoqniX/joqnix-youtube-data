[{"type": "subtitle", "time": 363.39, "timestamp": "00:06:03", "text": "没事没事没事没事"}, {"type": "subtitle", "time": 365.15, "timestamp": "00:06:05", "text": "没关系，别担心，别担心，哦，如果"}, {"type": "subtitle", "time": 368.27, "timestamp": "00:06:08", "text": "你想的话我可以，你想的话也可以。"}, {"type": "subtitle", "time": 370.87, "timestamp": "00:06:10", "text": "这叫做电脑串流延迟吗？"}, {"type": "subtitle", "time": 377.39, "timestamp": "00:06:17", "text": "有"}, {"type": "subtitle", "time": 380.27, "timestamp": "00:06:20", "text": "哦，没关系，你可以，我会的。"}, {"type": "subtitle", "time": 389.67, "timestamp": "00:06:29", "text": "然后你就可以一边开枪一边解说了。"}, {"type": "subtitle", "time": 399.55, "timestamp": "00:06:39", "text": "还剩两秒钟。"}, {"type": "subtitle", "time": 402.87, "timestamp": "00:06:42", "text": "我也可能先死，我不是。"}, {"type": "subtitle", "time": 405.629, "timestamp": "00:06:45", "text": "好的，没问题，你能试着看一下吗？"}, {"type": "subtitle", "time": 409.629, "timestamp": "00:06:49", "text": "我现在好，等等，我应该离开再加入吗？"}, {"type": "subtitle", "time": 416.51, "timestamp": "00:06:56", "text": "尝试加入派对"}, {"type": "subtitle", "time": 419.1, "timestamp": "00:06:59", "text": "看啊"}]
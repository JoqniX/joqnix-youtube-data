[{"type": "subtitle", "time": 1682.11, "timestamp": "00:28:02", "text": "那是不是意味着我该如何应对"}, {"type": "subtitle", "time": 1683.71, "timestamp": "00:28:03", "text": "无需射击即可造成更多伤害"}, {"type": "subtitle", "time": 1686.99, "timestamp": "00:28:06", "text": "枪，你想让我用别的枪吗？"}, {"type": "subtitle", "time": 1693.75, "timestamp": "00:28:13", "text": "意思是，我没有战利品，因为我在哪里？"}, {"type": "subtitle", "time": 1697.11, "timestamp": "00:28:17", "text": "着陆后没有战利品"}, {"type": "subtitle", "time": 1704.59, "timestamp": "00:28:24", "text": "这更喜欢这样"}, {"type": "subtitle", "time": 1712.95, "timestamp": "00:28:32", "text": "不，你不能那样做，停止那样做，停止"}, {"type": "subtitle", "time": 1714.389, "timestamp": "00:28:34", "text": "停止做那件事，停止做那件事"}, {"type": "subtitle", "time": 1729.59, "timestamp": "00:28:49", "text": "你在哪里"}, {"type": "subtitle", "time": 1736.71, "timestamp": "00:28:56", "text": "不管是谁，他们都要来了。"}]
[{"type": "subtitle", "time": 11888.79, "timestamp": "03:18:08", "text": "上帝"}, {"type": "subtitle", "time": 11917.99, "timestamp": "03:18:37", "text": "我有点儿……哦我的天哪，我有点儿……我"}, {"type": "subtitle", "time": 11920.229, "timestamp": "03:18:40", "text": "我数了数，我把它分类了，我把它分类了"}, {"type": "subtitle", "time": 11931.55, "timestamp": "03:18:51", "text": "我骗我我"}, {"type": "subtitle", "time": 11935.55, "timestamp": "03:18:55", "text": "那让他……哦我的天哪……我被噎住了"}, {"type": "subtitle", "time": 11938.99, "timestamp": "03:18:58", "text": "我被呛住了。"}]
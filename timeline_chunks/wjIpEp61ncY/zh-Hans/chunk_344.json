[{"type": "subtitle", "time": 20649.468, "timestamp": "05:44:09", "text": "在所有这些事情中，我们能够获得"}, {"type": "subtitle", "time": 20650.868, "timestamp": "05:44:10", "text": "一个"}, {"type": "subtitle", "time": 20657.548, "timestamp": "05:44:17", "text": "好的"}, {"type": "subtitle", "time": 20659.868, "timestamp": "05:44:19", "text": "比如等等，如果我是"}, {"type": "subtitle", "time": 20664.708, "timestamp": "05:44:24", "text": "说实话，让我回头再看看他们吧。"}, {"type": "subtitle", "time": 20667.75, "timestamp": "05:44:27", "text": "我的游戏电脑在它报废之前一直都在用。"}, {"type": "subtitle", "time": 20671.35, "timestamp": "05:44:31", "text": "在它真正死亡之前，CPU FR 就死了"}, {"type": "subtitle", "time": 20672.868, "timestamp": "05:44:32", "text": "和"}, {"type": "subtitle", "time": 20677.51, "timestamp": "05:44:37", "text": "诸如“好吧”之类的东西"}, {"type": "subtitle", "time": 20684.59, "timestamp": "05:44:44", "text": "频道，等等，呃，是哪个直播流来着？"}, {"type": "subtitle", "time": 20688.788, "timestamp": "05:44:48", "text": "在GPU坏掉之前，对吧？"}, {"type": "subtitle", "time": 20690.59, "timestamp": "05:44:50", "text": "如果我能找到"}, {"type": "subtitle", "time": 20693.948, "timestamp": "05:44:53", "text": "我为什么要这么做？我这就去查一下。"}, {"type": "subtitle", "time": 20697.788, "timestamp": "05:44:57", "text": "那个 Fortnite 播放列表"}]
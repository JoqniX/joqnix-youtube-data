[{"type": "subtitle", "time": 1803.389, "timestamp": "00:30:03", "text": "Miku，好的，我有三种Miku"}, {"type": "subtitle", "time": 1804.509, "timestamp": "00:30:04", "text": "明亮的"}, {"type": "subtitle", "time": 1807.63, "timestamp": "00:30:07", "text": "初音未来"}, {"type": "subtitle", "time": 1814.23, "timestamp": "00:30:14", "text": "绝对不想让我妈扔塔基"}, {"type": "subtitle", "time": 1817.149, "timestamp": "00:30:17", "text": "平底锅既涉及身体也涉及精神"}, {"type": "subtitle", "time": 1819.669, "timestamp": "00:30:19", "text": "损害"}, {"type": "subtitle", "time": 1824.19, "timestamp": "00:30:24", "text": "哦，我妈妈没用过这种东西。"}, {"type": "subtitle", "time": 1828.909, "timestamp": "00:30:28", "text": "呃，暴力"}, {"type": "subtitle", "time": 1831.71, "timestamp": "00:30:31", "text": "她肯定用了衣架。"}, {"type": "subtitle", "time": 1835.11, "timestamp": "00:30:35", "text": "不过不像用平底锅那样，因为平底锅看起来……"}, {"type": "subtitle", "time": 1838.029, "timestamp": "00:30:38", "text": "就像非常危险的"}, {"type": "subtitle", "time": 1841.47, "timestamp": "00:30:41", "text": "武器我记不清了，但我就是知道"}, {"type": "subtitle", "time": 1843.07, "timestamp": "00:30:43", "text": "我小时候她经常打我"}, {"type": "subtitle", "time": 1846.269, "timestamp": "00:30:46", "text": "还有一些零零碎碎的东西，比如衣服"}, {"type": "subtitle", "time": 1849.71, "timestamp": "00:30:49", "text": "衣架或她的拖鞋"}, {"type": "subtitle", "time": 1852.789, "timestamp": "00:30:52", "text": "扫帚，哦，还有梳子，这样就行了。"}, {"type": "subtitle", "time": 1855.389, "timestamp": "00:30:55", "text": "态度好点儿，好吗？"}, {"type": "subtitle", "time": 1857.629, "timestamp": "00:30:57", "text": "好的，我只是想确认一下我没有……"}, {"type": "subtitle", "time": 1858.43, "timestamp": "00:30:58", "text": "这"}]
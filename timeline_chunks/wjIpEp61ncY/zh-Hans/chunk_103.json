[{"type": "subtitle", "time": 6180.31, "timestamp": "01:43:00", "text": "后面还有"}, {"type": "subtitle", "time": 6183.95, "timestamp": "01:43:03", "text": "你躲藏的那个人"}, {"type": "subtitle", "time": 6186.75, "timestamp": "01:43:06", "text": "的"}, {"type": "subtitle", "time": 6190.629, "timestamp": "01:43:10", "text": "雕像，布鲁斯也在这里，哦等等等等"}, {"type": "subtitle", "time": 6193.03, "timestamp": "01:43:13", "text": "等等，我会雇佣他，好的好的"}, {"type": "subtitle", "time": 6195.55, "timestamp": "01:43:15", "text": "他的迷你机枪在这边，好吗？"}, {"type": "subtitle", "time": 6199.75, "timestamp": "01:43:19", "text": "好的，好的，所以这里，所以这里是什么"}, {"type": "subtitle", "time": 6203.709, "timestamp": "01:43:23", "text": "你需要……好吧"}, {"type": "subtitle", "time": 6206.149, "timestamp": "01:43:26", "text": "我看到这混蛋在卖这些东西。"}, {"type": "subtitle", "time": 6210.47, "timestamp": "01:43:30", "text": "这些商品价格低廉，而且可以折扣价出售。"}, {"type": "subtitle", "time": 6214.95, "timestamp": "01:43:34", "text": "人们都在随机数生成器（RNG）上操纵我们，我应该随机数生成器。"}, {"type": "subtitle", "time": 6229.47, "timestamp": "01:43:49", "text": "哦，它在这里，好的，我可以"}, {"type": "subtitle", "time": 6233.189, "timestamp": "01:43:53", "text": "打开它，我的天哪，给我这玩意儿！"}]
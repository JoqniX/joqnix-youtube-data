[{"type": "subtitle", "time": 19937.23, "timestamp": "05:32:17", "text": "金色的，我记得那个棉花糖玩意儿"}, {"type": "subtitle", "time": 19945.67, "timestamp": "05:32:25", "text": "[音乐]"}, {"type": "subtitle", "time": 19955.07, "timestamp": "05:32:35", "text": "相信"}, {"type": "subtitle", "time": 19963.35, "timestamp": "05:32:43", "text": "我挺喜欢这种拍打动作的，它让我想起了拍打。"}, {"type": "subtitle", "time": 19970.19, "timestamp": "05:32:50", "text": "它让我想起了什么"}, {"type": "subtitle", "time": 19973.23, "timestamp": "05:32:53", "text": "嗯，这让我想起了……你……"}]
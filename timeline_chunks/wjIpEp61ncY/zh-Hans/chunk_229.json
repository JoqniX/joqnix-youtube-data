[{"type": "subtitle", "time": 13741.83, "timestamp": "03:49:01", "text": "所以我是"}, {"type": "subtitle", "time": 13744.429, "timestamp": "03:49:04", "text": "什么？哦，这是我们的，好的，我们是"}, {"type": "subtitle", "time": 13747.51, "timestamp": "03:49:07", "text": "保护我们的床，哦，这是我们的床"}, {"type": "subtitle", "time": 13750.48, "timestamp": "03:49:10", "text": "哦，我没有"}, {"type": "subtitle", "time": 13753.469, "timestamp": "03:49:13", "text": "[音乐]"}, {"type": "subtitle", "time": 13756.269, "timestamp": "03:49:16", "text": "知道了"}, {"type": "subtitle", "time": 13772.269, "timestamp": "03:49:32", "text": "金字塔就是这样"}, {"type": "subtitle", "time": 13774.469, "timestamp": "03:49:34", "text": "奇怪，他是什么人？"}, {"type": "subtitle", "time": 13777.349, "timestamp": "03:49:37", "text": "让他做一切，我走了，我走了"}, {"type": "subtitle", "time": 13780.269, "timestamp": "03:49:40", "text": "我会特意抽出时间去参加体育课。"}, {"type": "subtitle", "time": 13792.59, "timestamp": "03:49:52", "text": "[掌声]"}, {"type": "subtitle", "time": 13794.8, "timestamp": "03:49:54", "text": "不不不不"}, {"type": "subtitle", "time": 13797.95, "timestamp": "03:49:57", "text": "[掌声]"}]
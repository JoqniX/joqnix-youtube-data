[{"type": "subtitle", "time": 6000.75, "timestamp": "01:40:00", "text": "即使我扮演的是亡命之徒，如果我真的要这么做的话"}, {"type": "subtitle", "time": 6009.55, "timestamp": "01:40:09", "text": "100，是啊，下一个任务是什么呢？"}, {"type": "subtitle", "time": 6012.589, "timestamp": "01:40:12", "text": "下一个任务让我看看……"}, {"type": "subtitle", "time": 6018.55, "timestamp": "01:40:18", "text": "亡命之徒，你也说了些什么？"}, {"type": "subtitle", "time": 6020.07, "timestamp": "01:40:20", "text": "你刚才说"}, {"type": "subtitle", "time": 6023.189, "timestamp": "01:40:23", "text": "我做了什么？没有问“亡命之徒”的问题，对吧？"}, {"type": "subtitle", "time": 6025.75, "timestamp": "01:40:25", "text": "嗯嗯，接下来是村民。"}, {"type": "subtitle", "time": 6027.229, "timestamp": "01:40:27", "text": "女孩"}, {"type": "subtitle", "time": 6030.629, "timestamp": "01:40:30", "text": "任务，是啊是啊，那是什么？好的，我会的"}, {"type": "subtitle", "time": 6032.55, "timestamp": "01:40:32", "text": "做好标记。"}, {"type": "subtitle", "time": 6035.31, "timestamp": "01:40:35", "text": "地图是那张吗？"}, {"type": "subtitle", "time": 6040.47, "timestamp": "01:40:40", "text": "乔什，对，乔什，音乐的魔力"}, {"type": "subtitle", "time": 6047.669, "timestamp": "01:40:47", "text": "摩西，它说你有什么？"}, {"type": "subtitle", "time": 6049.589, "timestamp": "01:40:49", "text": "跟她聊聊天，就是这样，对，聊聊天"}]
[{"type": "subtitle", "time": 1921.389, "timestamp": "00:32:01", "text": "开启单人模式，单人模式没问题。"}, {"type": "subtitle", "time": 1927.669, "timestamp": "00:32:07", "text": "等等，反正我还没老，我马上就来。"}, {"type": "subtitle", "time": 1939.149, "timestamp": "00:32:19", "text": "是啊，我很好奇你得到了什么。"}, {"type": "subtitle", "time": 1942.75, "timestamp": "00:32:22", "text": "晚餐，Jo H，我回来了，哦，你"}, {"type": "subtitle", "time": 1945.149, "timestamp": "00:32:25", "text": "已经回来了，你得到了什么？"}, {"type": "subtitle", "time": 1950.75, "timestamp": "00:32:30", "text": "晚餐我先吃了米饭，然后是咖喱。"}, {"type": "subtitle", "time": 1955.47, "timestamp": "00:32:35", "text": "薯条你已经吃过了，是的。"}, {"type": "subtitle", "time": 1959.629, "timestamp": "00:32:39", "text": "哦等等，那我应该取消吗？等等，我会的"}, {"type": "subtitle", "time": 1962.95, "timestamp": "00:32:42", "text": "加入你，好吗？好吗？好吗？好吗？我应该关门吗？"}, {"type": "subtitle", "time": 1977.07, "timestamp": "00:32:57", "text": "好吧，我还以为你出去拿东西了。"}, {"type": "subtitle", "time": 1978.71, "timestamp": "00:32:58", "text": "晚餐"}]
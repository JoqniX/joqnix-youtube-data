[{"type": "subtitle", "time": 911.389, "timestamp": "00:15:11", "text": "好了，我刚才说到哪儿了？"}, {"type": "subtitle", "time": 913.03, "timestamp": "00:15:13", "text": "谁刚刚"}, {"type": "subtitle", "time": 929.55, "timestamp": "00:15:29", "text": "好的，我去吃晚饭。"}, {"type": "subtitle", "time": 932.99, "timestamp": "00:15:32", "text": "他离开了我，这是……"}, {"type": "subtitle", "time": 940.91, "timestamp": "00:15:40", "text": "婊子，我要死了"}, {"type": "subtitle", "time": 945.79, "timestamp": "00:15:45", "text": "勇敢的BR Peak没有被火炬击毙。"}, {"type": "subtitle", "time": 950.67, "timestamp": "00:15:50", "text": "精英和黄金，你们为什么不是？"}]
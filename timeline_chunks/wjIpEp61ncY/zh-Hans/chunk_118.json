[{"type": "subtitle", "time": 7082.709, "timestamp": "01:58:02", "text": "这次我回到大厅，已经78k了。"}, {"type": "subtitle", "time": 7085.95, "timestamp": "01:58:05", "text": "是的，那是最后一场比赛了。"}, {"type": "subtitle", "time": 7089.149, "timestamp": "01:58:09", "text": "嗨，真有趣，谢谢。"}, {"type": "subtitle", "time": 7093.99, "timestamp": "01:58:13", "text": "你，伙计，我们一起奋斗过，伙计，这个圣地"}, {"type": "subtitle", "time": 7096.55, "timestamp": "01:58:16", "text": "你收到的都是些什么玩意儿？"}, {"type": "subtitle", "time": 7100.43, "timestamp": "01:58:20", "text": "XP 真的有 200，对，有 20 万"}, {"type": "subtitle", "time": 7103.149, "timestamp": "01:58:23", "text": "我得了78分。"}, {"type": "subtitle", "time": 7104.069, "timestamp": "01:58:24", "text": "那就是"}, {"type": "subtitle", "time": 7105.95, "timestamp": "01:58:25", "text": "好的"}, {"type": "subtitle", "time": 7108.55, "timestamp": "01:58:28", "text": "是的"}, {"type": "subtitle", "time": 7113.109, "timestamp": "01:58:33", "text": "哇哦，200，太棒了！那你打算去哪儿？"}, {"type": "subtitle", "time": 7117.43, "timestamp": "01:58:37", "text": "接下来要说什么呢，也许是M"}, {"type": "subtitle", "time": 7123.51, "timestamp": "01:58:43", "text": "嗯，我"}, {"type": "subtitle", "time": 7126.669, "timestamp": "01:58:46", "text": "别这样，是的，谢谢你。"}, {"type": "subtitle", "time": 7130.39, "timestamp": "01:58:50", "text": "今天没问题，我记得以前……"}, {"type": "subtitle", "time": 7132.149, "timestamp": "01:58:52", "text": "我们在 Roku 服务器上讨论过这个问题。"}, {"type": "subtitle", "time": 7134.55, "timestamp": "01:58:54", "text": "或者在我不认识的地方"}, {"type": "subtitle", "time": 7136.75, "timestamp": "01:58:56", "text": "记得我说过我会帮你吗？"}, {"type": "subtitle", "time": 7139.109, "timestamp": "01:58:59", "text": "把那玩意儿拿出来，所以，是的，我帮你。"}]
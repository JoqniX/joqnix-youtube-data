[{"type": "subtitle", "time": 6903.189, "timestamp": "01:55:03", "text": "老虎，没错，白虎穿着西装"}, {"type": "subtitle", "time": 6909.95, "timestamp": "01:55:09", "text": "我真想揍那混蛋一顿"}, {"type": "subtitle", "time": 6916.709, "timestamp": "01:55:16", "text": "最后我想杀了他，我们要……"}, {"type": "subtitle", "time": 6923.589, "timestamp": "01:55:23", "text": "哦，对了，还有辆更好的车。"}, {"type": "subtitle", "time": 6926.31, "timestamp": "01:55:26", "text": "没事的，我们会痊愈的。"}, {"type": "subtitle", "time": 6943.709, "timestamp": "01:55:43", "text": "更好了，还有汽车维修，我的天哪"}, {"type": "subtitle", "time": 6948.03, "timestamp": "01:55:48", "text": "我的天哪，这太棒了，耶耶，我们"}, {"type": "subtitle", "time": 6954.95, "timestamp": "01:55:54", "text": "这里肯定没人耕种，谁会在这里耕作？"}, {"type": "subtitle", "time": 6958.51, "timestamp": "01:55:58", "text": "否则就在那片愚蠢的森林里，是啊。"}]
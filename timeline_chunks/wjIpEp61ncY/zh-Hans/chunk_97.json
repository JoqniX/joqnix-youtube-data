[{"type": "subtitle", "time": 5823.39, "timestamp": "01:37:03", "text": "我们，我在车里，我在车里。"}, {"type": "subtitle", "time": 5826.629, "timestamp": "01:37:06", "text": "哦，你竟然抛下我独自离开了？"}, {"type": "subtitle", "time": 5840.43, "timestamp": "01:37:20", "text": "跑，得抓住这家伙，得抓住他"}, {"type": "subtitle", "time": 5843.83, "timestamp": "01:37:23", "text": "这个人YY需要抓住这个人，他是"}, {"type": "subtitle", "time": 5844.669, "timestamp": "01:37:24", "text": "为了"}, {"type": "subtitle", "time": 5847.31, "timestamp": "01:37:27", "text": "当然，肯定会有“哦，天哪，有个NPC”这种反应。"}, {"type": "subtitle", "time": 5849.95, "timestamp": "01:37:29", "text": "他们有一个NPC"}, {"type": "subtitle", "time": 5853.91, "timestamp": "01:37:33", "text": "小心，他们在这里，他们正匆匆赶路。"}, {"type": "subtitle", "time": 5857.43, "timestamp": "01:37:37", "text": "我的天哪，别伤害NPC！"}, {"type": "subtitle", "time": 5863.149, "timestamp": "01:37:43", "text": "好的，哦，奖章，我要去拿那个"}, {"type": "subtitle", "time": 5870.55, "timestamp": "01:37:50", "text": "做"}, {"type": "subtitle", "time": 5872.109, "timestamp": "01:37:52", "text": "不"}, {"type": "subtitle", "time": 5874.99, "timestamp": "01:37:54", "text": "兄弟"}, {"type": "subtitle", "time": 5877.87, "timestamp": "01:37:57", "text": "他是我的"}]
[{"type": "subtitle", "time": 13385.07, "timestamp": "03:43:05", "text": "我知道它实际上是一个金色的士兵。"}, {"type": "subtitle", "time": 13424.51, "timestamp": "03:43:44", "text": "圣钢铁侠就是钢铁侠。"}, {"type": "subtitle", "time": 13426.149, "timestamp": "03:43:46", "text": "战锤"}, {"type": "subtitle", "time": 13429.55, "timestamp": "03:43:49", "text": "他们有一款钢铁侠的皮肤"}, {"type": "subtitle", "time": 13434.79, "timestamp": "03:43:54", "text": "什么时候"}]
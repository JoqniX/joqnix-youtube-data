[{"type": "subtitle", "time": 5464.39, "timestamp": "01:31:04", "text": "我想要那玩意儿，我的天哪"}, {"type": "subtitle", "time": 5467.43, "timestamp": "01:31:07", "text": "很好，所以我觉得有人去世了。"}, {"type": "subtitle", "time": 5478.03, "timestamp": "01:31:18", "text": "炸弹 哦，那是我们的，耶耶耶"}, {"type": "subtitle", "time": 5482.99, "timestamp": "01:31:22", "text": "嗯，臭死了，啊儿子，啊，算了，走吧"}, {"type": "subtitle", "time": 5485.109, "timestamp": "01:31:25", "text": "接下来，我们等等等等。"}, {"type": "subtitle", "time": 5488.79, "timestamp": "01:31:28", "text": "等等，我们有他们的车"}, {"type": "subtitle", "time": 5493.98, "timestamp": "01:31:33", "text": "耶，哦，太棒了，我们走吧"}, {"type": "subtitle", "time": 5503.87, "timestamp": "01:31:43", "text": "那个敌人，哦，敌人，是啊，哦不，是啊，胡扯"}, {"type": "chat", "time": 5505.881, "timestamp": "01:31:45", "author": "@Dragnozer", "avatar": "https://yt4.ggpht.com/S76Kh7cHFwpQNz9yjhQC88CHN2CaFRgcX6E1lcl7bEXBNP_DPdf1iSETHK2qlrHYkwo6BbPw=s64-c-k-c0x00ffffff-no-rj", "message": "moshi mosh"}, {"type": "subtitle", "time": 5505.99, "timestamp": "01:31:45", "text": "别这样，这辆愚蠢的车"}, {"type": "subtitle", "time": 5508.55, "timestamp": "01:31:48", "text": "没有，没有"}, {"type": "subtitle", "time": 5513.07, "timestamp": "01:31:53", "text": "不，你们可以在这里露营吗？"}, {"type": "subtitle", "time": 5515.03, "timestamp": "01:31:55", "text": "想和他们打架？那就去打吧。"}, {"type": "subtitle", "time": 5516.75, "timestamp": "01:31:56", "text": "这里有人，这里有人，乔"}, {"type": "subtitle", "time": 5519.35, "timestamp": "01:31:59", "text": "这里，对对对，我看到了"}]
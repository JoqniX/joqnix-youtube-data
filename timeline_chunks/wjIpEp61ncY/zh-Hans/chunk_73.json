[{"type": "subtitle", "time": 4380.629, "timestamp": "01:13:00", "text": "我来接手这部分。"}, {"type": "subtitle", "time": 4383.95, "timestamp": "01:13:03", "text": "硬币地狱"}, {"type": "subtitle", "time": 4387.03, "timestamp": "01:13:07", "text": "对了，如果你死了，你会掉落"}, {"type": "subtitle", "time": 4388.669, "timestamp": "01:13:08", "text": "他们"}, {"type": "subtitle", "time": 4391.149, "timestamp": "01:13:11", "text": "是的，所以如果我们你知道的话，那就很好。"}, {"type": "subtitle", "time": 4394.149, "timestamp": "01:13:14", "text": "去类似市场的地方，但话说回来，如果"}, {"type": "subtitle", "time": 4396.11, "timestamp": "01:13:16", "text": "我们去吧，他们会杀了我们的，因为"}, {"type": "subtitle", "time": 4403.87, "timestamp": "01:13:23", "text": "国王，等等，是吗？"}, {"type": "subtitle", "time": 4406.59, "timestamp": "01:13:26", "text": "敌人，是的，那将会"}, {"type": "subtitle", "time": 4415.75, "timestamp": "01:13:35", "text": "是啊，他们挖不了土，他们太蠢了。"}, {"type": "subtitle", "time": 4418.03, "timestamp": "01:13:38", "text": "哦，原来是你啊！"}, {"type": "subtitle", "time": 4421.27, "timestamp": "01:13:41", "text": "请注意，那是一个……"}, {"type": "subtitle", "time": 4424.07, "timestamp": "01:13:44", "text": "是啊是啊是啊，但我听到你说话了，嗯"}, {"type": "subtitle", "time": 4425.51, "timestamp": "01:13:45", "text": "用镐子对吧？我以为……"}, {"type": "subtitle", "time": 4427.47, "timestamp": "01:13:47", "text": "实际"}, {"type": "subtitle", "time": 4429.99, "timestamp": "01:13:49", "text": "有人想在这里挖土，这太愚蠢了。"}, {"type": "subtitle", "time": 4433.75, "timestamp": "01:13:53", "text": "因为我们身处VA内部"}, {"type": "subtitle", "time": 4436.31, "timestamp": "01:13:56", "text": "是啊是啊，我在露营，哦，我看到他了"}]
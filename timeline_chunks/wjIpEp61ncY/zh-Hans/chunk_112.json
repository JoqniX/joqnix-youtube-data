[{"type": "subtitle", "time": 6721.75, "timestamp": "01:52:01", "text": "是的，我觉得他被杀了。"}, {"type": "subtitle", "time": 6724.75, "timestamp": "01:52:04", "text": "我不知道机器人会怎么做。"}, {"type": "subtitle", "time": 6727.03, "timestamp": "01:52:07", "text": "不，他还活着，他就在某个地方。"}, {"type": "subtitle", "time": 6729.39, "timestamp": "01:52:09", "text": "我想要那只毛茸茸的老虎"}, {"type": "subtitle", "time": 6731.79, "timestamp": "01:52:11", "text": "我不在乎，我做得太棒了，我做得太棒了"}, {"type": "subtitle", "time": 6733.55, "timestamp": "01:52:13", "text": "对于"}, {"type": "subtitle", "time": 6740.91, "timestamp": "01:52:20", "text": "天哪，他跑了，他跑得真快！"}, {"type": "subtitle", "time": 6743.629, "timestamp": "01:52:23", "text": "他快疯了"}, {"type": "subtitle", "time": 6746.149, "timestamp": "01:52:26", "text": "真的，我不在乎，我，我，我正在得到"}, {"type": "subtitle", "time": 6749.43, "timestamp": "01:52:29", "text": "我想要那个人给你，啊，那个"}, {"type": "subtitle", "time": 6753.95, "timestamp": "01:52:33", "text": "听起来好糟糕，我，我，我想要，我想要"}, {"type": "subtitle", "time": 6756.51, "timestamp": "01:52:36", "text": "杀了你这家伙，我不想要他"}, {"type": "subtitle", "time": 6759.39, "timestamp": "01:52:39", "text": "为了你们，我想杀了他，哦哦"}, {"type": "subtitle", "time": 6761.35, "timestamp": "01:52:41", "text": "那边有枪声，你真的应该听我说"}, {"type": "subtitle", "time": 6763.229, "timestamp": "01:52:43", "text": "跟我来，好吗？好吗？我来了，进来吧。"}, {"type": "subtitle", "time": 6766.43, "timestamp": "01:52:46", "text": "上车"}]
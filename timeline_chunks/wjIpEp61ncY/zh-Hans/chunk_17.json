[{"type": "subtitle", "time": 1023.59, "timestamp": "00:17:03", "text": "我差点就用了一个带歌曲的表情动作"}, {"type": "subtitle", "time": 1038.15, "timestamp": "00:17:18", "text": "哦，把所有曲目都给我看看，兄弟。"}, {"type": "subtitle", "time": 1039.669, "timestamp": "00:17:19", "text": "这"}, {"type": "subtitle", "time": 1042.71, "timestamp": "00:17:22", "text": "见鬼，Doom 的那个在哪儿？我没有吗？"}, {"type": "subtitle", "time": 1044.35, "timestamp": "00:17:24", "text": "左"}, {"type": "subtitle", "time": 1047.37, "timestamp": "00:17:27", "text": "是的"}, {"type": "subtitle", "time": 1062.71, "timestamp": "00:17:42", "text": "我找不到它，它在哪儿？"}, {"type": "subtitle", "time": 1065.909, "timestamp": "00:17:45", "text": "歌曲游戏动作"}]
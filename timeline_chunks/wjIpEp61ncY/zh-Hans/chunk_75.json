[{"type": "subtitle", "time": 4503.95, "timestamp": "01:15:03", "text": "没错哦，我的比特币加入我的游戏"}, {"type": "subtitle", "time": 4511.11, "timestamp": "01:15:11", "text": "没有 goh"}, {"type": "subtitle", "time": 4517.87, "timestamp": "01:15:17", "text": "是的，当我在地图上看到你飞行时"}, {"type": "subtitle", "time": 4519.75, "timestamp": "01:15:19", "text": "我屏幕上没看到他，我当时就想，啊，他在哪儿？"}, {"type": "subtitle", "time": 4523.189, "timestamp": "01:15:23", "text": "否则我就用精灵图了"}, {"type": "subtitle", "time": 4525.83, "timestamp": "01:15:25", "text": "我也很困惑，你这是什么意思？"}, {"type": "subtitle", "time": 4528.31, "timestamp": "01:15:28", "text": "幽灵泰宝可梦，因为在你之前"}, {"type": "subtitle", "time": 4530.43, "timestamp": "01:15:30", "text": "称之为"}, {"type": "subtitle", "time": 4532.709, "timestamp": "01:15:32", "text": "鸡肉，我简直不敢相信我们做了所有这些"}, {"type": "subtitle", "time": 4534.27, "timestamp": "01:15:34", "text": "努力工作，而这些混蛋却……"}, {"type": "subtitle", "time": 4536.87, "timestamp": "01:15:36", "text": "决定向我们发起进攻。"}, {"type": "subtitle", "time": 4540.669, "timestamp": "01:15:40", "text": "是的，我三次都非常难过"}, {"type": "subtitle", "time": 4544.11, "timestamp": "01:15:44", "text": "我们不能和平地玩这个游戏。"}, {"type": "subtitle", "time": 4546.59, "timestamp": "01:15:46", "text": "为什么会这样"}, {"type": "subtitle", "time": 4548.87, "timestamp": "01:15:48", "text": "恼人的"}, {"type": "subtitle", "time": 4551.11, "timestamp": "01:15:51", "text": "嗨，是的。"}]
[{"type": "subtitle", "time": 21908.51, "timestamp": "06:05:08", "text": "当然，哦，太好了，我给了他，我给了他"}, {"type": "subtitle", "time": 21910.11, "timestamp": "06:05:10", "text": "是他吗？"}, {"type": "subtitle", "time": 21912.67, "timestamp": "06:05:12", "text": "我从不表达情感"}, {"type": "subtitle", "time": 21915.99, "timestamp": "06:05:15", "text": "情绪激动地说：哦，上帝"}]
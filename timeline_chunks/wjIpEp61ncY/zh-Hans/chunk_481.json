[{"type": "subtitle", "time": 28867.23, "timestamp": "08:01:07", "text": "房间在哪儿？我没有房间。"}, {"type": "subtitle", "time": 28871.83, "timestamp": "08:01:11", "text": "[音乐]"}, {"type": "subtitle", "time": 28883.548, "timestamp": "08:01:23", "text": "哦，天哪，我在那边说话了，我说话了"}, {"type": "subtitle", "time": 28907.04, "timestamp": "08:01:47", "text": "虽然哦"}, {"type": "subtitle", "time": 28914.788, "timestamp": "08:01:54", "text": "[音乐]"}, {"type": "subtitle", "time": 28919.56, "timestamp": "08:01:59", "text": "我的天啊，他真聪明！"}]
[{"type": "subtitle", "time": 20889.35, "timestamp": "05:48:09", "text": "我喜欢这款游戏甚至都没打开的样子。"}, {"type": "subtitle", "time": 20892.31, "timestamp": "05:48:12", "text": "就好像，就好像命中注定一样"}, {"type": "subtitle", "time": 20895.548, "timestamp": "05:48:15", "text": "是啊，你该去睡觉了，你这个爱开玩笑的家伙。"}, {"type": "subtitle", "time": 20898.91, "timestamp": "05:48:18", "text": "我需要一个类似 Gohost 的睡眠辅助设备。"}, {"type": "subtitle", "time": 20904.91, "timestamp": "05:48:24", "text": "太喜欢了，我太喜欢了，我的天哪"}, {"type": "subtitle", "time": 20908.67, "timestamp": "05:48:28", "text": "天哪，它好像不想让我……"}, {"type": "subtitle", "time": 20929.51, "timestamp": "05:48:49", "text": "但我需要有足够的精力。"}, {"type": "subtitle", "time": 20932.788, "timestamp": "05:48:52", "text": "明天我不能太低调。"}, {"type": "subtitle", "time": 20937.59, "timestamp": "05:48:57", "text": "能源无需任何成本，绝非我所愿。"}]
[{"type": "subtitle", "time": 1579.23, "timestamp": "00:26:19", "text": "我他妈在想什么"}, {"type": "subtitle", "time": 1590.47, "timestamp": "00:26:30", "text": "他在那里看到了我，你能做到吗？"}, {"type": "subtitle", "time": 1592.669, "timestamp": "00:26:32", "text": "虽然那是一个机器人，但我们不可能……"}, {"type": "subtitle", "time": 1596.87, "timestamp": "00:26:36", "text": "这里有个机器人，但这不是机器人，真好，真好。"}, {"type": "subtitle", "time": 1600.75, "timestamp": "00:26:40", "text": "有 Miku Miku The hatun 大葱"}, {"type": "subtitle", "time": 1602.11, "timestamp": "00:26:42", "text": "当然！"}, {"type": "subtitle", "time": 1606.31, "timestamp": "00:26:46", "text": "等等，我这就换皮肤，等等"}, {"type": "subtitle", "time": 1611.75, "timestamp": "00:26:51", "text": "去"}, {"type": "subtitle", "time": 1616.23, "timestamp": "00:26:56", "text": "嗯，好吧，你看，好的，好的，我已经，我已经"}]
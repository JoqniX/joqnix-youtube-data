[{"type": "subtitle", "time": 301.23, "timestamp": "00:05:01", "text": "但我不太明白他们是怎么把“rang”放进去的。"}, {"type": "subtitle", "time": 303.35, "timestamp": "00:05:03", "text": "就像会是C级，会有警察，而且"}, {"type": "subtitle", "time": 309.71, "timestamp": "00:05:09", "text": "我不太明白他们是怎么表达的。"}, {"type": "subtitle", "time": 312.35, "timestamp": "00:05:12", "text": "涵盖了这些游戏"}, {"type": "subtitle", "time": 316.07, "timestamp": "00:05:16", "text": "模式很酷，哦，有点疯狂"}, {"type": "subtitle", "time": 317.79, "timestamp": "00:05:17", "text": "你和高段位玩家一起玩，就是这样。"}, {"type": "subtitle", "time": 319.87, "timestamp": "00:05:19", "text": "太疯狂了，感觉太不公平了，你不想这样"}, {"type": "subtitle", "time": 324.11, "timestamp": "00:05:24", "text": "不想再玩了，是啊，我当时就是这样。"}, {"type": "subtitle", "time": 327.23, "timestamp": "00:05:27", "text": "这反而让我更想玩了。"}, {"type": "subtitle", "time": 330.95, "timestamp": "00:05:30", "text": "大逃杀模式，因为里面会有机器人。"}, {"type": "subtitle", "time": 333.79, "timestamp": "00:05:33", "text": "哦，我喜欢我想消灭的是胡说八道，而不是这些。"}, {"type": "subtitle", "time": 336.189, "timestamp": "00:05:36", "text": "虚幻的人，而真实才是最高境界。"}, {"type": "subtitle", "time": 338.55, "timestamp": "00:05:38", "text": "在这个游戏中，排名和真实排名是"}, {"type": "subtitle", "time": 342.51, "timestamp": "00:05:42", "text": "比如，呃，最高等级是什么？"}, {"type": "subtitle", "time": 344.67, "timestamp": "00:05:44", "text": "在瓦尔一号"}, {"type": "subtitle", "time": 347.189, "timestamp": "00:05:47", "text": "我忘了你的意思。"}, {"type": "subtitle", "time": 349.51, "timestamp": "00:05:49", "text": "反正我在玩游戏，你可以看我玩。"}, {"type": "subtitle", "time": 351.909, "timestamp": "00:05:51", "text": "目前还无法观看此内容。"}, {"type": "subtitle", "time": 353.35, "timestamp": "00:05:53", "text": "匹配"}, {"type": "subtitle", "time": 356.11, "timestamp": "00:05:56", "text": "哇哦，可能是因为我还没进入游戏吧。"}, {"type": "subtitle", "time": 358.67, "timestamp": "00:05:58", "text": "我不知道，别担心，我会的"}]
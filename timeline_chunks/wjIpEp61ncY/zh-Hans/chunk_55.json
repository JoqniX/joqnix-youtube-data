[{"type": "subtitle", "time": 3312.829, "timestamp": "00:55:12", "text": "其次，你看到的不仅仅是露营。"}, {"type": "subtitle", "time": 3323.51, "timestamp": "00:55:23", "text": "人们难以置信，前一秒我还在……"}, {"type": "subtitle", "time": 3324.91, "timestamp": "00:55:24", "text": "后一"}, {"type": "subtitle", "time": 3330.95, "timestamp": "00:55:30", "text": "嘿，我没有广告博客，因为我"}, {"type": "subtitle", "time": 3333.27, "timestamp": "00:55:33", "text": "我想支持我的好朋友乔"}, {"type": "subtitle", "time": 3335.51, "timestamp": "00:55:35", "text": "安迪听起来像个卷心菜兄弟你"}, {"type": "subtitle", "time": 3337.43, "timestamp": "00:55:37", "text": "不能先这么说，然后再说我"}, {"type": "subtitle", "time": 3339.95, "timestamp": "00:55:39", "text": "听起来像卷心菜，这他妈是什么？"}, {"type": "chat", "time": 3340.002, "timestamp": "00:55:40", "author": "@Hero_338", "avatar": "https://yt4.ggpht.com/0uNlIhqsigPTN5hDlTHiX6E1xHNJL_TKrsEvxszwXL5t9cJLNqnfZ0L6Wz1pkyw3Fb-F_l4e=s64-c-k-c0x00ffffff-no-rj", "message": "two monkeys on pipes"}, {"type": "subtitle", "time": 3341.71, "timestamp": "00:55:41", "text": "那本意是……"}, {"type": "chat", "time": 3347.843, "timestamp": "00:55:47", "author": "@Hero_338", "avatar": "https://yt4.ggpht.com/0uNlIhqsigPTN5hDlTHiX6E1xHNJL_TKrsEvxszwXL5t9cJLNqnfZ0L6Wz1pkyw3Fb-F_l4e=s64-c-k-c0x00ffffff-no-rj", "message": "lol"}, {"type": "subtitle", "time": 3351.549, "timestamp": "00:55:51", "text": "用“卷心菜”这个词来形容卷心菜可不是什么好话。"}, {"type": "chat", "time": 3359.74, "timestamp": "00:55:59", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "dw suwumi, u dont"}]
[{"type": "subtitle", "time": 421.95, "timestamp": "00:07:01", "text": "[音乐]"}, {"type": "subtitle", "time": 424.35, "timestamp": "00:07:04", "text": "好的，我加入了"}, {"type": "subtitle", "time": 426.869, "timestamp": "00:07:06", "text": "那么，您是否看到一个选项，上面写着："}, {"type": "subtitle", "time": 429.189, "timestamp": "00:07:09", "text": "不不，它说正在观看不是"}, {"type": "subtitle", "time": 432.589, "timestamp": "00:07:12", "text": "还没上线，所以也许你在玩"}, {"type": "subtitle", "time": 436.029, "timestamp": "00:07:16", "text": "零建造，那怎么可能不是呢？"}, {"type": "subtitle", "time": 439.189, "timestamp": "00:07:19", "text": "因为我还没落地呢。"}, {"type": "subtitle", "time": 441.35, "timestamp": "00:07:21", "text": "如果不是这种情况，我不知道为什么。"}, {"type": "subtitle", "time": 442.589, "timestamp": "00:07:22", "text": "不知道为什么"}, {"type": "subtitle", "time": 446.43, "timestamp": "00:07:26", "text": "否则等等，你还没着陆呢，是的。"}, {"type": "subtitle", "time": 448.79, "timestamp": "00:07:28", "text": "已经着陆了，好的，等等，让我先离开。"}, {"type": "subtitle", "time": 453.749, "timestamp": "00:07:33", "text": "这是"}, {"type": "subtitle", "time": 456.629, "timestamp": "00:07:36", "text": "奇怪，是啊，我不知道，我不知道怎么回事"}, {"type": "subtitle", "time": 458.71, "timestamp": "00:07:38", "text": "它要么有效，要么我刚刚加入了我的"}, {"type": "subtitle", "time": 460.35, "timestamp": "00:07:40", "text": "兄弟大厅，可供使用"}, {"type": "subtitle", "time": 462.67, "timestamp": "00:07:42", "text": "通常情况下，它会告诉我不要观看。"}, {"type": "subtitle", "time": 465.189, "timestamp": "00:07:45", "text": "暂无"}, {"type": "subtitle", "time": 467.029, "timestamp": "00:07:47", "text": "为什么会这样呢？"}, {"type": "subtitle", "time": 478.43, "timestamp": "00:07:58", "text": "什么事？哦，是的，我会离开的。"}]
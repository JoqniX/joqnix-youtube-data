[{"type": "subtitle", "time": 5583.149, "timestamp": "01:33:03", "text": "好的，我们要从SN出发"}, {"type": "subtitle", "time": 5586.229, "timestamp": "01:33:06", "text": "在这里，但要小心，我会看着我们的"}, {"type": "subtitle", "time": 5589.629, "timestamp": "01:33:09", "text": "好的，我会掩护你的。"}, {"type": "subtitle", "time": 5592.31, "timestamp": "01:33:12", "text": "这里又出现了同样的问题，我看不见。"}, {"type": "subtitle", "time": 5594.83, "timestamp": "01:33:14", "text": "这里有人死了，尸体很新鲜。"}, {"type": "subtitle", "time": 5598.59, "timestamp": "01:33:18", "text": "在这里，我看到了新鲜的死亡，有人"}, {"type": "subtitle", "time": 5601.629, "timestamp": "01:33:21", "text": "消失，等一下，我会，我会，我会"}, {"type": "subtitle", "time": 5603.83, "timestamp": "01:33:23", "text": "去设置里找找那玩意儿不起作用的地方"}, {"type": "subtitle", "time": 5607.59, "timestamp": "01:33:27", "text": "兄弟，别走 ..."}, {"type": "subtitle", "time": 5610.47, "timestamp": "01:33:30", "text": "我会在这里，我会在这里，呃，我只是"}, {"type": "subtitle", "time": 5612.83, "timestamp": "01:33:32", "text": "需要将视野距离调整到史诗级"}, {"type": "subtitle", "time": 5619.79, "timestamp": "01:33:39", "text": "显然它什么也没显示。"}, {"type": "subtitle", "time": 5622.31, "timestamp": "01:33:42", "text": "不应该……呃，我应该拿的"}, {"type": "subtitle", "time": 5629.35, "timestamp": "01:33:49", "text": "狙击手"}, {"type": "subtitle", "time": 5632.47, "timestamp": "01:33:52", "text": "不，我有臭味"}, {"type": "subtitle", "time": 5635.99, "timestamp": "01:33:55", "text": "哦，德拉格来了，你好德拉格"}, {"type": "subtitle", "time": 5637.83, "timestamp": "01:33:57", "text": "欢迎"}]
[{"type": "subtitle", "time": 16380.59, "timestamp": "04:33:00", "text": "终于到了，伙计，我很高兴我赢了，我"}, {"type": "subtitle", "time": 16393.31, "timestamp": "04:33:13", "text": "赢了，看看那把伞"}, {"type": "subtitle", "time": 16394.31, "timestamp": "04:33:14", "text": "我是"}, {"type": "subtitle", "time": 16406.709, "timestamp": "04:33:26", "text": "哇，这里真美！"}, {"type": "subtitle", "time": 16430.789, "timestamp": "04:33:50", "text": "哦，我的主，圣洁的上帝，赞美你，充满"}, {"type": "subtitle", "time": 16437.029, "timestamp": "04:33:57", "text": "你，哦，你"}]
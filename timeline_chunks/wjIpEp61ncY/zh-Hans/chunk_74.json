[{"type": "subtitle", "time": 4449.35, "timestamp": "01:14:09", "text": "他拿了弹药，谢谢你。"}, {"type": "subtitle", "time": 4452.709, "timestamp": "01:14:12", "text": "他们得到了他们"}, {"type": "subtitle", "time": 4465.709, "timestamp": "01:14:25", "text": "兄弟，别站在我旁边，就这么简单。"}, {"type": "subtitle", "time": 4474.11, "timestamp": "01:14:34", "text": "我的天啊，我被击倒了"}, {"type": "subtitle", "time": 4477.59, "timestamp": "01:14:37", "text": "你他妈到底朝他扔了什么东西？"}, {"type": "subtitle", "time": 4482.189, "timestamp": "01:14:42", "text": "虽然我的天啊我的天啊"}, {"type": "subtitle", "time": 4494.35, "timestamp": "01:14:54", "text": "不，这些露营者并不信任我们。"}, {"type": "subtitle", "time": 4495.91, "timestamp": "01:14:55", "text": "怎么了"}]
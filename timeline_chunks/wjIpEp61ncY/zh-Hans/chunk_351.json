[{"type": "subtitle", "time": 21070.67, "timestamp": "05:51:10", "text": "所以，M，当我解释旧的事情时"}, {"type": "subtitle", "time": 21073.83, "timestamp": "05:51:13", "text": "当我玩堡垒之夜时，我拍下了游戏画面。"}, {"type": "subtitle", "time": 21076.59, "timestamp": "05:51:16", "text": "我的游戏电脑啊，我的天哪"}, {"type": "subtitle", "time": 21085.11, "timestamp": "05:51:25", "text": "啊，我累得都快不行了。"}, {"type": "subtitle", "time": 21088.87, "timestamp": "05:51:28", "text": "我不知道，伙计。"}]
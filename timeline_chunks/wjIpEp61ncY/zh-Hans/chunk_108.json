[{"type": "subtitle", "time": 6486.51, "timestamp": "01:48:06", "text": "好吧，他妈的死了"}, {"type": "subtitle", "time": 6490.149, "timestamp": "01:48:10", "text": "死人了，在我身后，好吧，我想。"}, {"type": "subtitle", "time": 6520.669, "timestamp": "01:48:40", "text": "这把枪的弹药无限，是的，不要"}, {"type": "subtitle", "time": 6537.229, "timestamp": "01:48:57", "text": "我的天啊，你是不是把另一个人杀了？为什么？"}, {"type": "subtitle", "time": 6539.79, "timestamp": "01:48:59", "text": "你蜇人了，是的，我不得不杀了它。"}]
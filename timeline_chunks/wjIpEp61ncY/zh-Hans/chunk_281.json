[{"type": "subtitle", "time": 16860.27, "timestamp": "04:41:00", "text": "不，我运气好，又赢回了比赛。"}, {"type": "subtitle", "time": 16862.708, "timestamp": "04:41:02", "text": "我拿到了那把伞，就是那把伞。"}, {"type": "subtitle", "time": 16866.67, "timestamp": "04:41:06", "text": "一直想玩这款游戏。"}, {"type": "subtitle", "time": 16872.03, "timestamp": "04:41:12", "text": "里面全是汗水，我就像……"}, {"type": "subtitle", "time": 16873.35, "timestamp": "04:41:13", "text": "但"}, {"type": "subtitle", "time": 16879.708, "timestamp": "04:41:19", "text": "我也想玩堡垒之夜。"}, {"type": "subtitle", "time": 16889.708, "timestamp": "04:41:29", "text": "明天是星期六，今天是"}, {"type": "subtitle", "time": 16893.47, "timestamp": "04:41:33", "text": "星期五，明天几点？8点10分？"}, {"type": "subtitle", "time": 16895.15, "timestamp": "04:41:35", "text": "如果我是对的"}, {"type": "subtitle", "time": 16898.27, "timestamp": "04:41:38", "text": "上帝啊，我真的需要休息一下。"}, {"type": "subtitle", "time": 16902.11, "timestamp": "04:41:42", "text": "睡个好觉，并且真正有精力"}, {"type": "subtitle", "time": 16904.948, "timestamp": "04:41:44", "text": "明天吧，因为我不知道该怎么办"}, {"type": "subtitle", "time": 16908.15, "timestamp": "04:41:48", "text": "其他人会一直待下去，但我"}, {"type": "subtitle", "time": 16910.51, "timestamp": "04:41:50", "text": "计划至少待到第三天。"}, {"type": "subtitle", "time": 16916.868, "timestamp": "04:41:56", "text": "9:30 到 9 点。至300"}]
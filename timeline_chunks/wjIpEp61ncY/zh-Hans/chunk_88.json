[{"type": "subtitle", "time": 5282.55, "timestamp": "01:28:02", "text": "开车和真人打架，你现在怎么样？"}, {"type": "subtitle", "time": 5286.189, "timestamp": "01:28:06", "text": "想找个地方玩，现在是11点，哦耶！"}, {"type": "subtitle", "time": 5297.59, "timestamp": "01:28:17", "text": "是的，所以我们干掉了气象预报员。"}, {"type": "subtitle", "time": 5305.31, "timestamp": "01:28:25", "text": "如果你想要的话，L卡低。"}, {"type": "subtitle", "time": 5307.709, "timestamp": "01:28:27", "text": "你想"}, {"type": "subtitle", "time": 5310.83, "timestamp": "01:28:30", "text": "好的，上面有个家伙，我们可以"}, {"type": "subtitle", "time": 5312.55, "timestamp": "01:28:32", "text": "杀了他"}, {"type": "subtitle", "time": 5314.91, "timestamp": "01:28:34", "text": "或许我以为你想保持低调。"}, {"type": "subtitle", "time": 5316.189, "timestamp": "01:28:36", "text": "正要找的，我正在找的"}, {"type": "subtitle", "time": 5320.27, "timestamp": "01:28:40", "text": "好吧，那就选他吧"}, {"type": "subtitle", "time": 5322.83, "timestamp": "01:28:42", "text": "是的"}, {"type": "subtitle", "time": 5327.59, "timestamp": "01:28:47", "text": "好的，你好，你好，那是虫子吗？"}, {"type": "subtitle", "time": 5330.03, "timestamp": "01:28:50", "text": "女孩"}, {"type": "subtitle", "time": 5333.229, "timestamp": "01:28:53", "text": "不错，好的，狙击手会提供帮助"}, {"type": "subtitle", "time": 5334.79, "timestamp": "01:28:54", "text": "有用的帮助"}, {"type": "subtitle", "time": 5339.07, "timestamp": "01:28:59", "text": "你从来不跟我一起来，兄弟，你"}]
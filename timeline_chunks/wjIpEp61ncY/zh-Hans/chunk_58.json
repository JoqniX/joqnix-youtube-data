[{"type": "subtitle", "time": 3484.51, "timestamp": "00:58:04", "text": "他好像都没跟我说过话，就好像……"}, {"type": "subtitle", "time": 3486.19, "timestamp": "00:58:06", "text": "哦，我要去陪大家聊天了。"}, {"type": "subtitle", "time": 3488.109, "timestamp": "00:58:08", "text": "或者他只是"}, {"type": "subtitle", "time": 3502.829, "timestamp": "00:58:22", "text": "乔库也许会保留一点哇阿斯罗"}, {"type": "chat", "time": 3503.309, "timestamp": "00:58:23", "author": "@Astro-9999", "avatar": "https://yt4.ggpht.com/I0atDf8aJGAiY3Z-U4COpBQFW4_qYnJ5GkhRqDK8dE_sjbhzV3NcVv5LuXD4hdY7IHeyOXW2OQ=s64-c-k-c0x00ffffff-no-rj", "message": "something must hv came up suwumi"}, {"type": "subtitle", "time": 3503.75, "timestamp": "00:58:23", "text": "你是"}, {"type": "subtitle", "time": 3506.39, "timestamp": "00:58:26", "text": "主持聊天"}, {"type": "subtitle", "time": 3507.349, "timestamp": "00:58:27", "text": "在"}, {"type": "subtitle", "time": 3514.27, "timestamp": "00:58:34", "text": "其他"}, {"type": "subtitle", "time": 3517.15, "timestamp": "00:58:37", "text": "各位主播，我回来了，我回来了，信不信由你！"}, {"type": "subtitle", "time": 3523.99, "timestamp": "00:58:43", "text": "工作等等，为什么我听到你在说什么？哦"}, {"type": "subtitle", "time": 3527.19, "timestamp": "00:58:47", "text": "我的天啊，我戴着耳机"}, {"type": "subtitle", "time": 3530.029, "timestamp": "00:58:50", "text": "断线了，好的，我在这里"}, {"type": "subtitle", "time": 3534.67, "timestamp": "00:58:54", "text": "哇哇，我简直不敢相信！我的天哪！"}, {"type": "subtitle", "time": 3536.35, "timestamp": "00:58:56", "text": "那家伙简直在追我。"}, {"type": "subtitle", "time": 3539.39, "timestamp": "00:58:59", "text": "[掌声]"}]
[{"type": "subtitle", "time": 5701.669, "timestamp": "01:35:01", "text": "哦，我的天，他们打起来了，让他们打吧。"}, {"type": "subtitle", "time": 5708.629, "timestamp": "01:35:08", "text": "否则你需要护盾或其他什么东西，哦我的天"}, {"type": "subtitle", "time": 5710.629, "timestamp": "01:35:10", "text": "天哪，他们互相推搡着"}, {"type": "subtitle", "time": 5713.59, "timestamp": "01:35:13", "text": "其他人都他妈的……哦，是那家伙吗？"}, {"type": "subtitle", "time": 5716.64, "timestamp": "01:35:16", "text": "你不可能死了"}, {"type": "subtitle", "time": 5724.43, "timestamp": "01:35:24", "text": "我的天啊，我还活着！"}, {"type": "subtitle", "time": 5727.07, "timestamp": "01:35:27", "text": "我不了解这里那些家伙的情况。"}, {"type": "subtitle", "time": 5728.83, "timestamp": "01:35:28", "text": "我们仍然在那里"}, {"type": "subtitle", "time": 5732.43, "timestamp": "01:35:32", "text": "区域哦，我们仍然在区域内，是的。"}, {"type": "subtitle", "time": 5735.109, "timestamp": "01:35:35", "text": "好的，把注意力放在我们这些人身上。"}, {"type": "subtitle", "time": 5740.189, "timestamp": "01:35:40", "text": "[掌声]"}, {"type": "subtitle", "time": 5748.31, "timestamp": "01:35:48", "text": "优势在于还剩下五支队伍。"}, {"type": "subtitle", "time": 5749.31, "timestamp": "01:35:49", "text": "五"}, {"type": "subtitle", "time": 5751.83, "timestamp": "01:35:51", "text": "双人组更像是五队，我不确定。"}, {"type": "subtitle", "time": 5758.43, "timestamp": "01:35:58", "text": "但有八个人"}]
[{"type": "subtitle", "time": 3901.029, "timestamp": "01:05:01", "text": "下次去露营的时候就去吧"}, {"type": "subtitle", "time": 3903.67, "timestamp": "01:05:03", "text": "一起，耶耶，哦，你看到这个了吗？"}, {"type": "subtitle", "time": 3907.63, "timestamp": "01:05:07", "text": "你看到水 Bo M 是的，那会给你"}, {"type": "subtitle", "time": 3910.15, "timestamp": "01:05:10", "text": "你的护盾和健康"}, {"type": "subtitle", "time": 3915.95, "timestamp": "01:05:15", "text": "哦，对，只有50个护盾，哦，你真可爱"}, {"type": "subtitle", "time": 3918.67, "timestamp": "01:05:18", "text": "也随身携带。"}, {"type": "subtitle", "time": 3922.63, "timestamp": "01:05:22", "text": "嗯，那很好，我喜欢这个"}, {"type": "subtitle", "time": 3926.63, "timestamp": "01:05:26", "text": "精灵的皮肤，是的，我有。"}, {"type": "subtitle", "time": 3928.95, "timestamp": "01:05:28", "text": "那是我第一个战斗通行证，所以才这样。"}, {"type": "subtitle", "time": 3936.47, "timestamp": "01:05:36", "text": "弹得不错，就是讨厌弹琴的人。"}, {"type": "subtitle", "time": 3942.71, "timestamp": "01:05:42", "text": "不过，他们为什么要露营呢？露营者们"}, {"type": "subtitle", "time": 3945.589, "timestamp": "01:05:45", "text": "我的意思是，我知道有人会这样做，但是"}, {"type": "subtitle", "time": 3949.75, "timestamp": "01:05:49", "text": "我从未如此强烈地感受到与他们相遇的喜悦。"}, {"type": "subtitle", "time": 3953.47, "timestamp": "01:05:53", "text": "速度太快了，每局游戏都这样，真烦人。"}, {"type": "subtitle", "time": 3956.39, "timestamp": "01:05:56", "text": "为什么我先死？为什么你走了？"}, {"type": "subtitle", "time": 3958.829, "timestamp": "01:05:58", "text": "你的任务是什么？你为什么进入？"}]
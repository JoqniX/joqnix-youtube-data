[{"type": "subtitle", "time": 4149.95, "timestamp": "01:09:09", "text": "货币巢穴我完成了亡命之徒哦耶"}, {"type": "subtitle", "time": 4151.229, "timestamp": "01:09:11", "text": "你这有点烦人。"}, {"type": "subtitle", "time": 4154.43, "timestamp": "01:09:14", "text": "完成亡命之徒任务"}, {"type": "subtitle", "time": 4157.07, "timestamp": "01:09:17", "text": "获取各种类型的钥匙卡"}, {"type": "subtitle", "time": 4158.87, "timestamp": "01:09:18", "text": "钥匙卡可以打开不同类型的门"}, {"type": "subtitle", "time": 4161.95, "timestamp": "01:09:21", "text": "那些游戏里真烂，哦，所以宝箱翻过来了"}, {"type": "subtitle", "time": 4164.11, "timestamp": "01:09:24", "text": "那里需要一张特定的钥匙卡。"}, {"type": "subtitle", "time": 4167.63, "timestamp": "01:09:27", "text": "你将获得"}, {"type": "subtitle", "time": 4171.189, "timestamp": "01:09:31", "text": "通过活动而非活动任务和我"}, {"type": "subtitle", "time": 4172.55, "timestamp": "01:09:32", "text": "不知道是哪一个，因为"}, {"type": "subtitle", "time": 4174.07, "timestamp": "01:09:34", "text": "你做得越多，你的房卡就越好用。"}, {"type": "subtitle", "time": 4177.47, "timestamp": "01:09:37", "text": "我不知道它是如何运作的。"}, {"type": "subtitle", "time": 4179.11, "timestamp": "01:09:39", "text": "不知道是哪一个，所以会是"}, {"type": "subtitle", "time": 4181.789, "timestamp": "01:09:41", "text": "永远开放"}, {"type": "subtitle", "time": 4184.149, "timestamp": "01:09:44", "text": "我觉得你可以再次打开它。"}, {"type": "subtitle", "time": 4185.39, "timestamp": "01:09:45", "text": "和"}, {"type": "subtitle", "time": 4186.95, "timestamp": "01:09:46", "text": "再次"}, {"type": "subtitle", "time": 4189.59, "timestamp": "01:09:49", "text": "呃，我没有弹药了，我们去……"}, {"type": "subtitle", "time": 4192.91, "timestamp": "01:09:52", "text": "哥谭，它不是，它不是夜之城，它是"}, {"type": "subtitle", "time": 4196.31, "timestamp": "01:09:56", "text": "今天是城市日，城市，是的，不是，是的"}]
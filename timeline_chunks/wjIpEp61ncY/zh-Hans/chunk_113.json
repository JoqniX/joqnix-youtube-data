[{"type": "subtitle", "time": 6785.31, "timestamp": "01:53:05", "text": "你好，我错过了所有……哦，真好"}, {"type": "subtitle", "time": 6796.109, "timestamp": "01:53:16", "text": "萨尔，我的天哪，太好了，不，他们叫我"}, {"type": "subtitle", "time": 6801.87, "timestamp": "01:53:21", "text": "好吧，这东西在这儿，呃，金子"}, {"type": "subtitle", "time": 6804.55, "timestamp": "01:53:24", "text": "Splash，你想在上面加什么？我只要PL就行了"}, {"type": "subtitle", "time": 6806.91, "timestamp": "01:53:26", "text": "一些金币，因为我们杀了一个人，用它吧"}, {"type": "subtitle", "time": 6811.109, "timestamp": "01:53:31", "text": "你需要的时候就用在自己身上吧。"}, {"type": "subtitle", "time": 6815.35, "timestamp": "01:53:35", "text": "好了，我们有无限弹药。"}, {"type": "subtitle", "time": 6819.51, "timestamp": "01:53:39", "text": "是的，我们确实有很多。"}, {"type": "subtitle", "time": 6822.99, "timestamp": "01:53:42", "text": "我没有猎枪，不过没关系。"}, {"type": "subtitle", "time": 6826.069, "timestamp": "01:53:46", "text": "你想用霰弹枪？你可以用，不，我"}, {"type": "subtitle", "time": 6827.39, "timestamp": "01:53:47", "text": "我不想，我不想。"}, {"type": "subtitle", "time": 6830.31, "timestamp": "01:53:50", "text": "拿走吧，拿走吧，哦"}, {"type": "subtitle", "time": 6833.47, "timestamp": "01:53:53", "text": "好了，我狙击了一个满垒的球棒，我准备好了。"}, {"type": "subtitle", "time": 6837.589, "timestamp": "01:53:57", "text": "摇滚起来，Ry，我们走吧，好吗？嗯，我们走吧"}]
[{"type": "subtitle", "time": 3603.029, "timestamp": "01:00:03", "text": "你就像空气一样 P Sim 呃，我不知道"}, {"type": "subtitle", "time": 3606.63, "timestamp": "01:00:06", "text": "我知道为什么会显示使用了5GB内存。"}, {"type": "subtitle", "time": 3609.589, "timestamp": "01:00:09", "text": "搞不明白她为什么没收到"}, {"type": "chat", "time": 3611.059, "timestamp": "01:00:11", "author": "@Astro-9999", "avatar": "https://yt4.ggpht.com/I0atDf8aJGAiY3Z-U4COpBQFW4_qYnJ5GkhRqDK8dE_sjbhzV3NcVv5LuXD4hdY7IHeyOXW2OQ=s64-c-k-c0x00ffffff-no-rj", "message": "avg tech person in house"}, {"type": "subtitle", "time": 3613.95, "timestamp": "01:00:13", "text": "数据可能她已经完成了，上面写着5G"}, {"type": "subtitle", "time": 3618.39, "timestamp": "01:00:18", "text": "用过，兄弟，是的，用了很多次，她说。"}, {"type": "subtitle", "time": 3620.27, "timestamp": "01:00:20", "text": "她刚打开，但没播放。"}, {"type": "subtitle", "time": 3622.23, "timestamp": "01:00:22", "text": "使用移动数据"}, {"type": "subtitle", "time": 3626.47, "timestamp": "01:00:26", "text": "设置，是的，我确实告诉过她。"}, {"type": "subtitle", "time": 3628.15, "timestamp": "01:00:28", "text": "她确定他们没有吗？"}, {"type": "subtitle", "time": 3631.069, "timestamp": "01:00:31", "text": "打开她的Wi-Fi或我热点并使用"}, {"type": "subtitle", "time": 3640.51, "timestamp": "01:00:40", "text": "哦，是的，我真的可以给他们。"}, {"type": "subtitle", "time": 3643.029, "timestamp": "01:00:43", "text": "我的Wi-Fi密码，哦，我忘了。"}, {"type": "subtitle", "time": 3645.95, "timestamp": "01:00:45", "text": "真的吗？没有，你为什么要这么做？"}, {"type": "subtitle", "time": 3648.19, "timestamp": "01:00:48", "text": "等等，什么鬼？你为什么要这么做？"}, {"type": "subtitle", "time": 3650.029, "timestamp": "01:00:50", "text": "不，你为什么要分享你的"}, {"type": "subtitle", "time": 3651.47, "timestamp": "01:00:51", "text": "把你的密码告诉邻居。"}, {"type": "subtitle", "time": 3653.19, "timestamp": "01:00:53", "text": "如果他们开始喜欢分享呢？"}, {"type": "subtitle", "time": 3654.67, "timestamp": "01:00:54", "text": "他们周围的人都说，哦，这人挺好的。"}, {"type": "subtitle", "time": 3656.47, "timestamp": "01:00:56", "text": "他们用它，然后分享它。"}, {"type": "subtitle", "time": 3658.75, "timestamp": "01:00:58", "text": "然后你就没有了，然后他们"}]
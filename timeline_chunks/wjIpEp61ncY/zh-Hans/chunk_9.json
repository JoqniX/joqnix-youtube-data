[{"type": "subtitle", "time": 549.35, "timestamp": "00:09:09", "text": "你应该能够"}, {"type": "subtitle", "time": 556.35, "timestamp": "00:09:16", "text": "希望不是这样。"}, {"type": "subtitle", "time": 558.75, "timestamp": "00:09:18", "text": "卡顿？希望不会。"}, {"type": "subtitle", "time": 562.15, "timestamp": "00:09:22", "text": "[音乐]"}, {"type": "subtitle", "time": 566.509, "timestamp": "00:09:26", "text": "卡顿吗？哦，怎么样？"}, {"type": "subtitle", "time": 570.43, "timestamp": "00:09:30", "text": "游戏怎么样？游戏是的"}, {"type": "subtitle", "time": 571.47, "timestamp": "00:09:31", "text": "那就是"}, {"type": "subtitle", "time": 575.59, "timestamp": "00:09:35", "text": "好的，去吃晚饭吧。"}, {"type": "subtitle", "time": 577.67, "timestamp": "00:09:37", "text": "你最好把它带来吃掉。"}, {"type": "subtitle", "time": 578.91, "timestamp": "00:09:38", "text": "和"}, {"type": "subtitle", "time": 581.75, "timestamp": "00:09:41", "text": "我们等等，我不能带，我得走了。"}, {"type": "subtitle", "time": 584.67, "timestamp": "00:09:44", "text": "在朋友家外面"}, {"type": "subtitle", "time": 587.43, "timestamp": "00:09:47", "text": "房子"}, {"type": "subtitle", "time": 591.31, "timestamp": "00:09:51", "text": "求求你，他要把我留给你，不，不，不"}, {"type": "subtitle", "time": 594.47, "timestamp": "00:09:54", "text": "不，我会看着你，别这样。"}, {"type": "subtitle", "time": 596.03, "timestamp": "00:09:56", "text": "担心"}, {"type": "subtitle", "time": 597.99, "timestamp": "00:09:57", "text": "好吧，我又不是要说……"}]
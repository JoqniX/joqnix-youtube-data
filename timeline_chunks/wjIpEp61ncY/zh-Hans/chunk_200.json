[{"type": "subtitle", "time": 12001.63, "timestamp": "03:20:01", "text": "[掌声]"}, {"type": "subtitle", "time": 12010.389, "timestamp": "03:20:10", "text": "不，我的天啊，等等等等，什么？"}, {"type": "subtitle", "time": 12017.75, "timestamp": "03:20:17", "text": "晚上我得拿这个，不，我需要冲锋枪"}, {"type": "subtitle", "time": 12031.349, "timestamp": "03:20:31", "text": "不，这不一样，这是……"}, {"type": "subtitle", "time": 12034.03, "timestamp": "03:20:34", "text": "哦，原来是这个，好的，那它在哪儿？"}, {"type": "subtitle", "time": 12036.349, "timestamp": "03:20:36", "text": "行动枪"}, {"type": "subtitle", "time": 12041.91, "timestamp": "03:20:41", "text": "你这玩意儿在这儿吗？冲锋枪、霰弹枪、突击步枪"}, {"type": "subtitle", "time": 12050.83, "timestamp": "03:20:50", "text": "[音乐]"}, {"type": "subtitle", "time": 12053.59, "timestamp": "03:20:53", "text": "这不这"}, {"type": "subtitle", "time": 12056.389, "timestamp": "03:20:56", "text": "或许"}, {"type": "subtitle", "time": 12059.99, "timestamp": "03:20:59", "text": "不，你偷了我的枪"}]
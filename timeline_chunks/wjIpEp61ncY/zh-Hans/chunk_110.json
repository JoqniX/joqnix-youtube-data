[{"type": "subtitle", "time": 6600.79, "timestamp": "01:50:00", "text": "和布鲁斯"}, {"type": "subtitle", "time": 6605.98, "timestamp": "01:50:05", "text": "布鲁图斯也死了。"}, {"type": "subtitle", "time": 6607.83, "timestamp": "01:50:07", "text": "[掌声]"}, {"type": "subtitle", "time": 6612.669, "timestamp": "01:50:12", "text": "他牺牲得真快，不，他"}, {"type": "subtitle", "time": 6614.589, "timestamp": "01:50:14", "text": "感觉"}, {"type": "subtitle", "time": 6617.47, "timestamp": "01:50:17", "text": "他太弱了，真的死了"}, {"type": "subtitle", "time": 6619.39, "timestamp": "01:50:19", "text": "哦，那是什么？"}, {"type": "subtitle", "time": 6621.149, "timestamp": "01:50:21", "text": "那"}, {"type": "subtitle", "time": 6629.03, "timestamp": "01:50:29", "text": "灌木丛就在那里，你真的可以……"}, {"type": "subtitle", "time": 6630.47, "timestamp": "01:50:30", "text": "某人可以是"}, {"type": "subtitle", "time": 6633.99, "timestamp": "01:50:33", "text": "躲藏起来，逃走，那就是逃脱"}, {"type": "subtitle", "time": 6640.87, "timestamp": "01:50:40", "text": "混蛋"}, {"type": "subtitle", "time": 6643.35, "timestamp": "01:50:43", "text": "不"}, {"type": "subtitle", "time": 6649.51, "timestamp": "01:50:49", "text": "我们当时"}, {"type": "subtitle", "time": 6654.109, "timestamp": "01:50:54", "text": "迟到了，呃，他拿走了那张卡，他拿走了"}, {"type": "subtitle", "time": 6657.39, "timestamp": "01:50:57", "text": "C 把车开到那里"}]
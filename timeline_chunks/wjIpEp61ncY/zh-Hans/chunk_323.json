[{"type": "subtitle", "time": 19382.35, "timestamp": "05:23:02", "text": "他很冷静"}, {"type": "subtitle", "time": 19392.75, "timestamp": "05:23:12", "text": "我杀了他，因为我想要"}, {"type": "subtitle", "time": 19396.11, "timestamp": "05:23:16", "text": "好的 2v"}, {"type": "subtitle", "time": 19401.19, "timestamp": "05:23:21", "text": "一不不不啊不，我怎么会这样"}, {"type": "subtitle", "time": 19410.19, "timestamp": "05:23:30", "text": "不不，这家伙，哦，我还是出现了。"}, {"type": "subtitle", "time": 19415.99, "timestamp": "05:23:35", "text": "[音乐]"}, {"type": "subtitle", "time": 19419.83, "timestamp": "05:23:39", "text": "笨蛋，那真是一场精彩的游戏"}, {"type": "subtitle", "time": 19422.548, "timestamp": "05:23:42", "text": "说实话，我当时只是在瞎胡闹。"}, {"type": "subtitle", "time": 19426.27, "timestamp": "05:23:46", "text": "安眠药 我想睡觉 停不下来"}]
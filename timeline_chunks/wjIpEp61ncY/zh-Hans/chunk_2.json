[{"type": "subtitle", "time": 124.27, "timestamp": "00:02:04", "text": "[音乐]"}, {"type": "subtitle", "time": 128.669, "timestamp": "00:02:08", "text": "好的，那我先开始，呃，或者你想让我……"}, {"type": "subtitle", "time": 132.27, "timestamp": "00:02:12", "text": "等等，我得去拿东西，我可以坐在外面吗？"}, {"type": "subtitle", "time": 135.589, "timestamp": "00:02:15", "text": "现在这种情况有可能发生"}, {"type": "subtitle", "time": 138.22899999999998, "timestamp": "00:02:18", "text": "Fortnite 什么什么什么你是什么意思"}, {"type": "subtitle", "time": 139.79, "timestamp": "00:02:19", "text": "我可以坐吗？"}, {"type": "subtitle", "time": 143.71, "timestamp": "00:02:23", "text": "坐下来 出去 出去 参加聚会 出去"}, {"type": "subtitle", "time": 148.03, "timestamp": "00:02:28", "text": "坐在外面，哦，当然，怎么做？"}, {"type": "subtitle", "time": 150.71, "timestamp": "00:02:30", "text": "你在堡垒之夜里会这么做"}, {"type": "subtitle", "time": 152.03, "timestamp": "00:02:32", "text": "呃，按"}, {"type": "subtitle", "time": 156.589, "timestamp": "00:02:36", "text": "逃脱，然后到右侧"}, {"type": "subtitle", "time": 159.149, "timestamp": "00:02:39", "text": "你会看到你的，呃，我们的派对，对吧？"}, {"type": "subtitle", "time": 162.949, "timestamp": "00:02:42", "text": "点击“离开派对”即可离开派对。"}, {"type": "subtitle", "time": 165.27, "timestamp": "00:02:45", "text": "通常的露天座位，我仍然可以在那里"}, {"type": "subtitle", "time": 169.55, "timestamp": "00:02:49", "text": "党内难道就没有这种情况吗？"}, {"type": "subtitle", "time": 172.39, "timestamp": "00:02:52", "text": "就像我不能再看着你一样，我可以看着你"}, {"type": "subtitle", "time": 176.43, "timestamp": "00:02:56", "text": "玩那种游戏之类的，哦，那发生了，等等"}]
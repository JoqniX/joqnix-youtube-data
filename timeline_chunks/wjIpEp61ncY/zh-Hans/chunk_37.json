[{"type": "subtitle", "time": 2220.069, "timestamp": "00:37:00", "text": "[掌声]"}, {"type": "subtitle", "time": 2223.91, "timestamp": "00:37:03", "text": "为什么我去了H这里和这里"}, {"type": "subtitle", "time": 2226.23, "timestamp": "00:37:06", "text": "这混蛋居然已经把我忘了，我的天哪！"}, {"type": "subtitle", "time": 2228.309, "timestamp": "00:37:08", "text": "希望说脏话没关系，没关系，没关系。"}, {"type": "subtitle", "time": 2231.47, "timestamp": "00:37:11", "text": "好吧，你说的对，因为现在人们更爱说脏话了。"}, {"type": "subtitle", "time": 2234.95, "timestamp": "00:37:14", "text": "他们比我做得多疯狂。"}, {"type": "subtitle", "time": 2238.03, "timestamp": "00:37:18", "text": "比我更喜欢的东西，比如你"}, {"type": "chat", "time": 2240.049, "timestamp": "00:37:20", "author": "@Hero_338", "avatar": "https://yt4.ggpht.com/0uNlIhqsigPTN5hDlTHiX6E1xHNJL_TKrsEvxszwXL5t9cJLNqnfZ0L6Wz1pkyw3Fb-F_l4e=s64-c-k-c0x00ffffff-no-rj", "message": "omg i would never"}, {"type": "subtitle", "time": 2240.87, "timestamp": "00:37:20", "text": "认识斯佩德哦耶"}, {"type": "subtitle", "time": 2244.03, "timestamp": "00:37:24", "text": "哦，还有什么新鲜事？有什么新鲜事？"}, {"type": "subtitle", "time": 2246.51, "timestamp": "00:37:26", "text": "姓名"}, {"type": "chat", "time": 2248.866, "timestamp": "00:37:28", "author": "@Hero_338", "avatar": "https://yt4.ggpht.com/0uNlIhqsigPTN5hDlTHiX6E1xHNJL_TKrsEvxszwXL5t9cJLNqnfZ0L6Wz1pkyw3Fb-F_l4e=s64-c-k-c0x00ffffff-no-rj", "message": "i am a holy person"}, {"type": "subtitle", "time": 2252.87, "timestamp": "00:37:32", "text": "呃，我们，是的，我们，我们嘲笑它"}, {"type": "subtitle", "time": 2256.67, "timestamp": "00:37:36", "text": "我说我们我你知道猫咪表情包啊"}, {"type": "subtitle", "time": 2259.19, "timestamp": "00:37:39", "text": "是啊是啊，那只正在吃东西的猫……"}, {"type": "subtitle", "time": 2261.19, "timestamp": "00:37:41", "text": "那只正在狼吞虎咽的小猫"}, {"type": "subtitle", "time": 2275.39, "timestamp": "00:37:55", "text": "我的天哪，我绝不会，我是个圣人"}]
[{"type": "subtitle", "time": 2885.589, "timestamp": "00:48:05", "text": "干得漂亮，杀了他们，真棒。"}, {"type": "subtitle", "time": 2888.349, "timestamp": "00:48:08", "text": "他很低，而且很好"}, {"type": "subtitle", "time": 2894.069, "timestamp": "00:48:14", "text": "现在还有另一个人，你看到了吗？"}, {"type": "subtitle", "time": 2895.309, "timestamp": "00:48:15", "text": "任何人"}, {"type": "subtitle", "time": 2898.63, "timestamp": "00:48:18", "text": "否则，呃，我会放一个脉冲SC"}, {"type": "subtitle", "time": 2916.589, "timestamp": "00:48:36", "text": "绝对零度，你知道什么是“Subzero”。"}, {"type": "subtitle", "time": 2920.069, "timestamp": "00:48:40", "text": "戴上绝对零度手套，它就能给你……"}, {"type": "subtitle", "time": 2921.03, "timestamp": "00:48:41", "text": "水"}, {"type": "subtitle", "time": 2924.19, "timestamp": "00:48:44", "text": "走路，哦，我是说霜冻"}, {"type": "subtitle", "time": 2928.109, "timestamp": "00:48:48", "text": "走路的时候，你拿到全部三个了吗？"}, {"type": "subtitle", "time": 2931.589, "timestamp": "00:48:51", "text": "不，呃，我需要"}, {"type": "subtitle", "time": 2934.71, "timestamp": "00:48:54", "text": "再拿一个"}, {"type": "subtitle", "time": 2938.39, "timestamp": "00:48:58", "text": "好的，我想应该还有一个在附近。"}]
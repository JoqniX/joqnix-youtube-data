[{"type": "subtitle", "time": 19269.628, "timestamp": "05:21:09", "text": "好吧，上帝啊，我的天啊，我的天啊，不不不不不"}, {"type": "subtitle", "time": 19273.43, "timestamp": "05:21:13", "text": "不不不，你不会杀人的"}, {"type": "subtitle", "time": 19277.39, "timestamp": "05:21:17", "text": "我的天哪，你不会杀我的，不会的。"}, {"type": "subtitle", "time": 19278.628, "timestamp": "05:21:18", "text": "杀"}, {"type": "subtitle", "time": 19281.75, "timestamp": "05:21:21", "text": "它在哪里？"}, {"type": "subtitle", "time": 19284.548, "timestamp": "05:21:24", "text": "哦不不不，他简直就是在计划"}, {"type": "subtitle", "time": 19300.628, "timestamp": "05:21:40", "text": "他会来吗？他会来吗？"}, {"type": "subtitle", "time": 19305.07, "timestamp": "05:21:45", "text": "他来了吗？我喝得酩酊大醉，我的天哪！"}, {"type": "subtitle", "time": 19307.628, "timestamp": "05:21:47", "text": "我当时的做法确实很鲁莽。"}, {"type": "subtitle", "time": 19311.35, "timestamp": "05:21:51", "text": "说实话，那真是太漂亮了。"}, {"type": "subtitle", "time": 19316.788, "timestamp": "05:21:56", "text": "我，这人是谁？"}, {"type": "subtitle", "time": 19319.868, "timestamp": "05:21:59", "text": "那家伙到底在干什么？他到底在走路吗？"}]
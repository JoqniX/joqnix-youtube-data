[{"type": "subtitle", "time": 27680.67, "timestamp": "07:41:20", "text": "蠢死了，那是什么？我根本不知道。"}, {"type": "subtitle", "time": 27683.03, "timestamp": "07:41:23", "text": "那家伙的手指在干什么？"}, {"type": "subtitle", "time": 27693.35, "timestamp": "07:41:33", "text": "为什么我还是会听到这种说法？"}, {"type": "subtitle", "time": 27696.03, "timestamp": "07:41:36", "text": "好的，我超级"}, {"type": "subtitle", "time": 27699.83, "timestamp": "07:41:39", "text": "迟来的上帝，我不知道我该何去何从。"}, {"type": "subtitle", "time": 27705.07, "timestamp": "07:41:45", "text": "我其实不知道自己该如何是好。"}, {"type": "subtitle", "time": 27708.03, "timestamp": "07:41:48", "text": "我其实不知道我该怎么做。"}, {"type": "subtitle", "time": 27710.75, "timestamp": "07:41:50", "text": "就像醒来一样"}, {"type": "subtitle", "time": 27713.868, "timestamp": "07:41:53", "text": "明天见，希望你喜欢。"}, {"type": "subtitle", "time": 27715.99, "timestamp": "07:41:55", "text": "至少我"}, {"type": "subtitle", "time": 27719.308, "timestamp": "07:41:59", "text": "猜猜看"}]
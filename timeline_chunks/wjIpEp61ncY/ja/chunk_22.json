[{"type": "subtitle", "time": 1327.789, "timestamp": "00:22:07", "text": "わかった、なんで私が試合をするの？"}, {"type": "subtitle", "time": 1336.669, "timestamp": "00:22:16", "text": "それなら間違いなくこれをプレイしてください"}, {"type": "subtitle", "time": 1339.31, "timestamp": "00:22:19", "text": "右"}, {"type": "subtitle", "time": 1358.149, "timestamp": "00:22:38", "text": "そこで私たちは"}, {"type": "subtitle", "time": 1361.99, "timestamp": "00:22:41", "text": "行かない、リロードは本当に好きじゃない"}, {"type": "subtitle", "time": 1367.23, "timestamp": "00:22:47", "text": "でもこの配信のためだけに、私の配信ですらありません"}, {"type": "subtitle", "time": 1369.149, "timestamp": "00:22:49", "text": "苦しむだろう"}, {"type": "subtitle", "time": 1372.99, "timestamp": "00:22:52", "text": "私のVレートは"}]
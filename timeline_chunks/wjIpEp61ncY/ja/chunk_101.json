[{"type": "subtitle", "time": 6068.91, "timestamp": "01:41:08", "text": "夕食は食べ終わったけどまだ"}, {"type": "subtitle", "time": 6087.189, "timestamp": "01:41:27", "text": "私のゲームでは、キーカードを持っていると言っています。"}, {"type": "subtitle", "time": 6096.91, "timestamp": "01:41:36", "text": "それとたくさんの"}, {"type": "subtitle", "time": 6099.55, "timestamp": "01:41:39", "text": "2人のボットが私たちを追跡しています"}, {"type": "subtitle", "time": 6101.149, "timestamp": "01:41:41", "text": "絶対にありえない、言った通り、"}, {"type": "subtitle", "time": 6103.27, "timestamp": "01:41:43", "text": "クソみたいな話がここに流れてる"}, {"type": "subtitle", "time": 6105.43, "timestamp": "01:41:45", "text": "実際の人々はドロップしたいと思っています"}, {"type": "subtitle", "time": 6108.91, "timestamp": "01:41:48", "text": "ここ、ああ、それはああ神様、どうか私を助けてください"}, {"type": "subtitle", "time": 6116.109, "timestamp": "01:41:56", "text": "はい、わかりました。"}, {"type": "subtitle", "time": 6119.149, "timestamp": "01:41:59", "text": "みんな、それは間違いなくボットだよ、実際は違う"}]
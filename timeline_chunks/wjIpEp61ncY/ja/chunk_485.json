[{"type": "subtitle", "time": 29115.468, "timestamp": "08:05:15", "text": "いいえ、ああ"}, {"type": "subtitle", "time": 29119.07, "timestamp": "08:05:19", "text": "神よ、彼に"}, {"type": "subtitle", "time": 29124.708, "timestamp": "08:05:24", "text": "来てください、聖なる神、聖なる神、聖なる神、聖なる神"}, {"type": "subtitle", "time": 29128.948, "timestamp": "08:05:28", "text": "なんてこった、なんてこった、ここにいるよ"}, {"type": "subtitle", "time": 29131.43, "timestamp": "08:05:31", "text": "あそこに1つあります。"}, {"type": "subtitle", "time": 29132.628, "timestamp": "08:05:32", "text": "3番目を見つける"}, {"type": "subtitle", "time": 29135.708, "timestamp": "08:05:35", "text": "1つは3つ目を見つける必要がある"}, {"type": "subtitle", "time": 29139.51, "timestamp": "08:05:39", "text": "1つはもう1つを見つける必要がある"}, {"type": "subtitle", "time": 29151.948, "timestamp": "08:05:51", "text": "[音楽]"}, {"type": "subtitle", "time": 29154.628, "timestamp": "08:05:54", "text": "オーケーセント"}]
[{"type": "subtitle", "time": 13501.87, "timestamp": "03:45:01", "text": "ああ、わかった、じゃあ実際に出発しよう"}, {"type": "subtitle", "time": 13505.429, "timestamp": "03:45:05", "text": "そして実際に出発して"}, {"type": "subtitle", "time": 13513.79, "timestamp": "03:45:13", "text": "何か温めるものか何か"}, {"type": "subtitle", "time": 13521.11, "timestamp": "03:45:21", "text": "えっと、私はピラミッドを使っていません。どうやって使うのですか？"}, {"type": "subtitle", "time": 13528.75, "timestamp": "03:45:28", "text": "B、もし古いマウスがあれば"}, {"type": "subtitle", "time": 13552.71, "timestamp": "03:45:52", "text": "サベロン ワンV ワンV ワンV"}, {"type": "subtitle", "time": 13556.99, "timestamp": "03:45:56", "text": "フードベッドの1つ"}]
[{"type": "subtitle", "time": 19382.35, "timestamp": "05:23:02", "text": "落ち着いて、彼は"}, {"type": "subtitle", "time": 19392.75, "timestamp": "05:23:12", "text": "私は彼を殺したかったから"}, {"type": "subtitle", "time": 19396.11, "timestamp": "05:23:16", "text": "2VでOK"}, {"type": "subtitle", "time": 19401.19, "timestamp": "05:23:21", "text": "1つ、いやいやいや、ああ、どうして私は"}, {"type": "subtitle", "time": 19410.19, "timestamp": "05:23:30", "text": "いやいや、この男はまだ現れている"}, {"type": "subtitle", "time": 19415.99, "timestamp": "05:23:35", "text": "[音楽]"}, {"type": "subtitle", "time": 19419.83, "timestamp": "05:23:39", "text": "バカ、いい試合だったよ"}, {"type": "subtitle", "time": 19422.548, "timestamp": "05:23:42", "text": "正直に言うと、私はふざけていたんです"}, {"type": "subtitle", "time": 19426.27, "timestamp": "05:23:46", "text": "眠る、飲む、眠りたい、止められない"}]
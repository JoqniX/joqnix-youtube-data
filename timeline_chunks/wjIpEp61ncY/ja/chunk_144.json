[{"type": "subtitle", "time": 8641.99, "timestamp": "02:24:01", "text": "まず私は見ている"}, {"type": "subtitle", "time": 8645.07, "timestamp": "02:24:05", "text": "皆さん"}, {"type": "subtitle", "time": 8648.349, "timestamp": "02:24:08", "text": "見ているかもしれない"}, {"type": "subtitle", "time": 8655.91, "timestamp": "02:24:15", "text": "刺す、彼女はどこにいるの？"}, {"type": "subtitle", "time": 8660.79, "timestamp": "02:24:20", "text": "これはボットですか？"}, {"type": "subtitle", "time": 8669.07, "timestamp": "02:24:29", "text": "まあ、彼は"}, {"type": "subtitle", "time": 8672.59, "timestamp": "02:24:32", "text": "賢い、彼は賢い"}, {"type": "subtitle", "time": 8683.19, "timestamp": "02:24:43", "text": "兄弟、お前は死んだよ、兄弟、俺が先にお前を殺したんだ"}, {"type": "subtitle", "time": 8686.309, "timestamp": "02:24:46", "text": "天才的、素晴らしい"}]
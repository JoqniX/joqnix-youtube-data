[{"type": "subtitle", "time": 5766.109, "timestamp": "01:36:06", "text": "このガキ"}, {"type": "subtitle", "time": 5769.189, "timestamp": "01:36:09", "text": "私が彼をノックした"}, {"type": "subtitle", "time": 5771.75, "timestamp": "01:36:11", "text": "ラッシュに行きたいなんていいですね"}, {"type": "subtitle", "time": 5775.5, "timestamp": "01:36:15", "text": "彼らに、私たちは彼を急がせることができます。彼は"}, {"type": "subtitle", "time": 5776.91, "timestamp": "01:36:16", "text": "[音楽]"}, {"type": "subtitle", "time": 5789.51, "timestamp": "01:36:29", "text": "[拍手]"}, {"type": "subtitle", "time": 5799.59, "timestamp": "01:36:39", "text": "弾薬はいい5HPで、私はむしろ逃げたい"}, {"type": "subtitle", "time": 5802.83, "timestamp": "01:36:42", "text": "外で、兄弟、君はクレイジーだよ、ああ、ジョー、私たちの"}, {"type": "subtitle", "time": 5806.87, "timestamp": "01:36:46", "text": "背後を警戒せよ、彼を殺せ、彼を殺せ"}, {"type": "subtitle", "time": 5809.51, "timestamp": "01:36:49", "text": "大隊がいる場所"}, {"type": "subtitle", "time": 5812.07, "timestamp": "01:36:52", "text": "走れる、走れる、走れる"}]
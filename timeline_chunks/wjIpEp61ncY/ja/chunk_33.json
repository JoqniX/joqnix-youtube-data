[{"type": "subtitle", "time": 1980.909, "timestamp": "00:33:00", "text": "好きじゃない"}, {"type": "subtitle", "time": 1983.75, "timestamp": "00:33:03", "text": "まるで私が行ったように"}, {"type": "subtitle", "time": 1987.47, "timestamp": "00:33:07", "text": "私の家の階下へ"}, {"type": "subtitle", "time": 1996.669, "timestamp": "00:33:16", "text": "はい、わかりました。準備させてください。"}, {"type": "subtitle", "time": 1999.629, "timestamp": "00:33:19", "text": "了解、ちなみにランクマッチをプレイしています"}, {"type": "subtitle", "time": 2003.07, "timestamp": "00:33:23", "text": "ゼロビルド"}, {"type": "subtitle", "time": 2004.909, "timestamp": "00:33:24", "text": "大丈夫です"}, {"type": "subtitle", "time": 2008.19, "timestamp": "00:33:28", "text": "汗だい"}, {"type": "subtitle", "time": 2009.99, "timestamp": "00:33:29", "text": "リロードをプレイしたが、すぐに良くなかった。"}, {"type": "subtitle", "time": 2012.23, "timestamp": "00:33:32", "text": "戦利品を手に入れた時、人々は私を殺した。"}, {"type": "subtitle", "time": 2013.83, "timestamp": "00:33:33", "text": "ああ、ドロップがあるかもしれない、私は"}, {"type": "subtitle", "time": 2015.23, "timestamp": "00:33:35", "text": "ドロップには何か良いものがあり、私は"}, {"type": "subtitle", "time": 2016.669, "timestamp": "00:33:36", "text": "見ていたところ、誰かが私を撃った"}, {"type": "subtitle", "time": 2018.75, "timestamp": "00:33:38", "text": "頭"}, {"type": "subtitle", "time": 2023.11, "timestamp": "00:33:43", "text": "ああ、それは本当にひどかったし、私は"}, {"type": "subtitle", "time": 2025.029, "timestamp": "00:33:45", "text": "1時間以内に起こったと思う"}, {"type": "subtitle", "time": 2027.83, "timestamp": "00:33:47", "text": "ストリームI"}, {"type": "subtitle", "time": 2030.83, "timestamp": "00:33:50", "text": "少なくとも私の視聴者は見ていないことを知っています"}]
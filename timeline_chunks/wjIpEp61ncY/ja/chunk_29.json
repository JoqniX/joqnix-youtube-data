[{"type": "subtitle", "time": 1744.59, "timestamp": "00:29:04", "text": "クソ、私には読めないわ"}, {"type": "subtitle", "time": 1752.909, "timestamp": "00:29:12", "text": "ドロップ、銃を持ってドロップをゲットしよう"}, {"type": "subtitle", "time": 1755.35, "timestamp": "00:29:15", "text": "敵よ、それはできない、そういうやり方じゃない"}, {"type": "subtitle", "time": 1757.99, "timestamp": "00:29:17", "text": "このゲームは機能します。私は試すことができます。"}, {"type": "subtitle", "time": 1761.909, "timestamp": "00:29:21", "text": "平和主義者はPUBGのような通常のVRで動作します"}, {"type": "subtitle", "time": 1763.35, "timestamp": "00:29:23", "text": "このゲームでは私は"}, {"type": "subtitle", "time": 1766.63, "timestamp": "00:29:26", "text": "私はしたくない"}, {"type": "subtitle", "time": 1771.389, "timestamp": "00:29:31", "text": "b 戦利品じゃないって書いてもいい？死んだの？"}, {"type": "subtitle", "time": 1784.269, "timestamp": "00:29:44", "text": "Hと私は、人々が戦っていると思った。"}, {"type": "subtitle", "time": 1786.07, "timestamp": "00:29:46", "text": "他の場所ではああ"}, {"type": "subtitle", "time": 1788.87, "timestamp": "00:29:48", "text": "ええと、B があります。モードがもっとあります。"}, {"type": "subtitle", "time": 1791.269, "timestamp": "00:29:51", "text": "再生して待って、私に"}, {"type": "subtitle", "time": 1794.149, "timestamp": "00:29:54", "text": "h両方"}, {"type": "subtitle", "time": 1797.63, "timestamp": "00:29:57", "text": "キャラクター 私はその2つのPRを持っていますかなり"}, {"type": "subtitle", "time": 1799.389, "timestamp": "00:29:59", "text": "バブルG"}]
[{"type": "subtitle", "time": 3122.99, "timestamp": "00:52:02", "text": "金を使いたいなら"}, {"type": "subtitle", "time": 3124.549, "timestamp": "00:52:04", "text": "行きたいと思うかもしれない"}, {"type": "subtitle", "time": 3126.829, "timestamp": "00:52:06", "text": "えーと、曲がりくねった"}, {"type": "subtitle", "time": 3129.91, "timestamp": "00:52:09", "text": "機械か、"}, {"type": "subtitle", "time": 3133.23, "timestamp": "00:52:13", "text": "そう、だから黒の中で"}, {"type": "subtitle", "time": 3137.43, "timestamp": "00:52:17", "text": "当店では銃やその他諸々を取り扱っております"}, {"type": "subtitle", "time": 3139.67, "timestamp": "00:52:19", "text": "ココナッツを買う"}, {"type": "subtitle", "time": 3141.06, "timestamp": "00:52:21", "text": "右"}, {"type": "subtitle", "time": 3142.67, "timestamp": "00:52:22", "text": "[音楽]"}, {"type": "subtitle", "time": 3145.19, "timestamp": "00:52:25", "text": "ココナッツ、マークしよう、うん、そうしよう"}, {"type": "subtitle", "time": 3148.23, "timestamp": "00:52:28", "text": "ただそれを置くだけで、これはあなたに"}, {"type": "subtitle", "time": 3156.95, "timestamp": "00:52:36", "text": "そこには"}, {"type": "subtitle", "time": 3167.87, "timestamp": "00:52:47", "text": "やった、その通り、正直に言うと私たちは"}, {"type": "subtitle", "time": 3169.99, "timestamp": "00:52:49", "text": "飛行機雲は撮れたけど、グライダーは撮れなかった"}, {"type": "subtitle", "time": 3172.829, "timestamp": "00:52:52", "text": "メイクと一緒に、なぜグライダーが欲しいのか"}, {"type": "subtitle", "time": 3174.87, "timestamp": "00:52:54", "text": "あまりにも"}, {"type": "subtitle", "time": 3177.15, "timestamp": "00:52:57", "text": "大きな価値"}, {"type": "subtitle", "time": 3179.75, "timestamp": "00:52:59", "text": "そんな感じのものがいいだろう"}]
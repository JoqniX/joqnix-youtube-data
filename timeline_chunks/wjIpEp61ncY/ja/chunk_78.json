[{"type": "subtitle", "time": 4683.39, "timestamp": "01:18:03", "text": "オーケー、落としたの？オーケーじゃないよ、いいえ"}, {"type": "subtitle", "time": 4686.55, "timestamp": "01:18:06", "text": "まだだ、まだだ。わかった、ここに寄るよ。"}, {"type": "subtitle", "time": 4687.55, "timestamp": "01:18:07", "text": "のために"}, {"type": "subtitle", "time": 4689.07, "timestamp": "01:18:09", "text": "今"}, {"type": "subtitle", "time": 4700.44, "timestamp": "01:18:20", "text": "お母さん、ここはいい場所だよ、大丈夫だよ"}, {"type": "subtitle", "time": 4701.95, "timestamp": "01:18:21", "text": "[音楽]"}, {"type": "subtitle", "time": 4709.51, "timestamp": "01:18:29", "text": "W 2人で1チーム"}, {"type": "subtitle", "time": 4718.51, "timestamp": "01:18:38", "text": "OCTA 彼らは"}, {"type": "subtitle", "time": 4732.75, "timestamp": "01:18:52", "text": "私はここで、実際の"}, {"type": "subtitle", "time": 4735.669, "timestamp": "01:18:55", "text": "人々はここで飛び跳ねるだろう"}, {"type": "subtitle", "time": 4737.75, "timestamp": "01:18:57", "text": "でも遅れたのでそうしましたが、私は"}, {"type": "subtitle", "time": 4739.229, "timestamp": "01:18:59", "text": "実際の人々について考えてみてください"}]
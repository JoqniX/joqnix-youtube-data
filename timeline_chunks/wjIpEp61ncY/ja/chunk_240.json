[{"type": "subtitle", "time": 14423.349, "timestamp": "04:00:23", "text": "金が必要だ"}, {"type": "subtitle", "time": 14425.67, "timestamp": "04:00:25", "text": "ああ"}, {"type": "subtitle", "time": 14427.79, "timestamp": "04:00:27", "text": "後戻りはできない"}, {"type": "subtitle", "time": 14429.75, "timestamp": "04:00:29", "text": "家に帰った"}, {"type": "subtitle", "time": 14434.95, "timestamp": "04:00:34", "text": "あなたの息子があなたにお金をあげたので、私は買いました"}, {"type": "subtitle", "time": 14441.03, "timestamp": "04:00:41", "text": "物も、これで金持ちになれる、いや待て"}, {"type": "subtitle", "time": 14443.67, "timestamp": "04:00:43", "text": "16にするよ"}, {"type": "subtitle", "time": 14445.71, "timestamp": "04:00:45", "text": "さあ、私は戻ってくる"}]
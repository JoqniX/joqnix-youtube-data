[{"type": "subtitle", "time": 14134.91, "timestamp": "03:55:34", "text": "よし、殺した、それは何か"}, {"type": "subtitle", "time": 14138.11, "timestamp": "03:55:38", "text": "それはかっこいいですね、キラキラしています"}, {"type": "subtitle", "time": 14142.54, "timestamp": "03:55:42", "text": "光ってる、それを欲しい"}, {"type": "subtitle", "time": 14144.91, "timestamp": "03:55:44", "text": "[拍手]"}, {"type": "subtitle", "time": 14152.91, "timestamp": "03:55:52", "text": "どんどん進め"}, {"type": "subtitle", "time": 14155.83, "timestamp": "03:55:55", "text": "行く 私は泥棒です 私はゲーマーです 私は"}, {"type": "subtitle", "time": 14159.11, "timestamp": "03:55:59", "text": "ゲーマーは打たない"}]
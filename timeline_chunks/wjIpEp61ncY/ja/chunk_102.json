[{"type": "subtitle", "time": 6120.75, "timestamp": "01:42:00", "text": "実際の"}, {"type": "subtitle", "time": 6129.669, "timestamp": "01:42:09", "text": "君の友達はどこで死んだんだ？"}, {"type": "subtitle", "time": 6143.589, "timestamp": "01:42:23", "text": "友達、ああ、本当にそうなのかわかったよ"}, {"type": "subtitle", "time": 6145.43, "timestamp": "01:42:25", "text": "行くつもりはないよ、本当に"}, {"type": "subtitle", "time": 6147.87, "timestamp": "01:42:27", "text": "友達の"}, {"type": "subtitle", "time": 6155.35, "timestamp": "01:42:35", "text": "離れて"}, {"type": "subtitle", "time": 6158.43, "timestamp": "01:42:38", "text": "こんにちは、ノックした、それはまた別の"}, {"type": "subtitle", "time": 6161.39, "timestamp": "01:42:41", "text": "おい、一体何なんだ、なぜ実際の人間が"}, {"type": "subtitle", "time": 6162.87, "timestamp": "01:42:42", "text": "ここに立って、あなたが何をしているか知っています"}, {"type": "subtitle", "time": 6169.03, "timestamp": "01:42:49", "text": "に"}, {"type": "subtitle", "time": 6177.91, "timestamp": "01:42:57", "text": "その男はキャンプをしていた"}]
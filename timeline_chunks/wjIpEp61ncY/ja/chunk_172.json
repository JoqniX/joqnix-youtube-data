[{"type": "subtitle", "time": 10336.15, "timestamp": "02:52:16", "text": "たぶん頭が痛いからこう思う"}, {"type": "subtitle", "time": 10339.79, "timestamp": "02:52:19", "text": "あぁ、もしかしたら、もし私が"}, {"type": "subtitle", "time": 10342.269, "timestamp": "02:52:22", "text": "こんな風に苦労していた"}, {"type": "subtitle", "time": 10346.389, "timestamp": "02:52:26", "text": "そしてゼロ"}, {"type": "subtitle", "time": 10348.05, "timestamp": "02:52:28", "text": "おい、それは"}, {"type": "subtitle", "time": 10358.269, "timestamp": "02:52:38", "text": "狂ってるし、私は"}, {"type": "subtitle", "time": 10361.309, "timestamp": "02:52:41", "text": "パニックになって、文字通り"}, {"type": "subtitle", "time": 10363.59, "timestamp": "02:52:43", "text": "終わり"}]
[{"type": "subtitle", "time": 7511.27, "timestamp": "02:05:11", "text": "このブーストは、一瞬の猶予を与えてくれます。"}, {"type": "subtitle", "time": 7516.189, "timestamp": "02:05:16", "text": "ブーストはもっと走っているような感じ"}, {"type": "subtitle", "time": 7551.39, "timestamp": "02:05:51", "text": "たぶん少しゲームをするだろう"}, {"type": "subtitle", "time": 7554.149, "timestamp": "02:05:54", "text": "わかってる、わかってる、11時だって。わかってる、私は"}, {"type": "subtitle", "time": 7556.79, "timestamp": "02:05:56", "text": "寝る 何をしているのかわからない 男"}]
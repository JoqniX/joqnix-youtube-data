[{"type": "subtitle", "time": 180.63, "timestamp": "00:03:00", "text": "私が演奏するのを見たいの？"}, {"type": "subtitle", "time": 182.83, "timestamp": "00:03:02", "text": "食事を楽しんでいる間、"}, {"type": "subtitle", "time": 185.83, "timestamp": "00:03:05", "text": "夕食はいいえ、今すぐ階下に行かなければなりません"}, {"type": "subtitle", "time": 187.589, "timestamp": "00:03:07", "text": "それは"}, {"type": "chat", "time": 187.724, "timestamp": "00:03:07", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "lmao"}, {"type": "subtitle", "time": 191.309, "timestamp": "00:03:11", "text": "ああ、チャットで楽しませてほしいの？"}, {"type": "subtitle", "time": 194.47, "timestamp": "00:03:14", "text": "もしあなたがそうしたいなら、自由にそうしてください"}, {"type": "subtitle", "time": 199.11, "timestamp": "00:03:19", "text": "はい、わかりました。それについては、"}, {"type": "subtitle", "time": 200.55, "timestamp": "00:03:20", "text": "パーティーを抜け出したいし、"}, {"type": "subtitle", "time": 203.63, "timestamp": "00:03:23", "text": "ゲームに参加して、それから私のゲームに参加してください"}, {"type": "subtitle", "time": 205.35, "timestamp": "00:03:25", "text": "私のロビーのように、そしてオプションがあります"}, {"type": "chat", "time": 205.925, "timestamp": "00:03:25", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "\"wut if i rest up, and u give me content suwumi\""}, {"type": "subtitle", "time": 207.07, "timestamp": "00:03:27", "text": "それは「見る」と書いてあるので、ただ見ることができます"}, {"type": "subtitle", "time": 209.11, "timestamp": "00:03:29", "text": "私がゲームをやっていると知るまで"}, {"type": "subtitle", "time": 212.50900000000001, "timestamp": "00:03:32", "text": "はい、プレイしています。では、"}, {"type": "subtitle", "time": 216.11, "timestamp": "00:03:36", "text": "タスクなので簡単ですが、入力できません"}, {"type": "subtitle", "time": 226.22899999999998, "timestamp": "00:03:46", "text": "わかった、そして私にちょうだい、ああ神様"}, {"type": "subtitle", "time": 229.99, "timestamp": "00:03:49", "text": "クロノスはどうだろう、もし私が休んだらどうなるだろう"}, {"type": "subtitle", "time": 233.47, "timestamp": "00:03:53", "text": "そしてあなたは私に自信を与えてくれる"}, {"type": "subtitle", "time": 236.949, "timestamp": "00:03:56", "text": "いや、切り替えるよ、切り替えるよ"}, {"type": "subtitle", "time": 239.19, "timestamp": "00:03:59", "text": "彼が何を言っているのかわかりません"}]
[{"type": "subtitle", "time": 8708.67, "timestamp": "02:25:08", "text": "それは実際の選手だった"}, {"type": "subtitle", "time": 8721.79, "timestamp": "02:25:21", "text": "95 ビルドファイトをやれたはずなのに"}, {"type": "subtitle", "time": 8725.349, "timestamp": "02:25:25", "text": "私がソロでやったことすべて、私たちは"}, {"type": "subtitle", "time": 8727.51, "timestamp": "02:25:27", "text": "ビルドファイトを行い、"}, {"type": "subtitle", "time": 8736.91, "timestamp": "02:25:36", "text": "90年代、一体何をしているんだ"}]
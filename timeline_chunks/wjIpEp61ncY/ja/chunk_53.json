[{"type": "subtitle", "time": 3182.39, "timestamp": "00:53:02", "text": "ええ、彼らは私たちに何もくれなかったんです。"}, {"type": "subtitle", "time": 3184.03, "timestamp": "00:53:04", "text": "彼らは私たちにたくさんのものを与えてくれる"}, {"type": "subtitle", "time": 3185.789, "timestamp": "00:53:05", "text": "しかし、"}, {"type": "subtitle", "time": 3188.23, "timestamp": "00:53:08", "text": "私も良い"}, {"type": "subtitle", "time": 3190.91, "timestamp": "00:53:10", "text": "銃、ああ、大丈夫、私たちは"}, {"type": "subtitle", "time": 3194.19, "timestamp": "00:53:14", "text": "うん、君の車はとても良いね、君は"}, {"type": "subtitle", "time": 3195.27, "timestamp": "00:53:15", "text": "買う"}, {"type": "chat", "time": 3200.611, "timestamp": "00:53:20", "author": "@Hero_338", "avatar": "https://yt4.ggpht.com/0uNlIhqsigPTN5hDlTHiX6E1xHNJL_TKrsEvxszwXL5t9cJLNqnfZ0L6Wz1pkyw3Fb-F_l4e=s64-c-k-c0x00ffffff-no-rj", "message": "suwumi sounds like cabbage"}, {"type": "subtitle", "time": 3200.75, "timestamp": "00:53:20", "text": "これは、私がカスタマイズしたように作ったものです。"}, {"type": "subtitle", "time": 3201.789, "timestamp": "00:53:21", "text": "できる"}, {"type": "subtitle", "time": 3204.95, "timestamp": "00:53:24", "text": "カスタマイズもできますよ。"}, {"type": "subtitle", "time": 3206.99, "timestamp": "00:53:26", "text": "ロケットリーグみたいなゲームをやってるんだね"}, {"type": "subtitle", "time": 3210.47, "timestamp": "00:53:30", "text": "ああ、私はそれをやっていない、待って、一体なぜ"}, {"type": "subtitle", "time": 3211.95, "timestamp": "00:53:31", "text": "私のマーカーは"}, {"type": "subtitle", "time": 3215.47, "timestamp": "00:53:35", "text": "ああ、混乱している"}, {"type": "subtitle", "time": 3236.589, "timestamp": "00:53:56", "text": "H 私たちは"}]
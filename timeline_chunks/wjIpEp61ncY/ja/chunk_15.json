[{"type": "subtitle", "time": 911.389, "timestamp": "00:15:11", "text": "よし、話を戻そう。みんな、何の話をしてたんだっけ？"}, {"type": "subtitle", "time": 913.03, "timestamp": "00:15:13", "text": "誰がちょうど"}, {"type": "subtitle", "time": 929.55, "timestamp": "00:15:29", "text": "よし、夕食を食べに行こう"}, {"type": "subtitle", "time": 932.99, "timestamp": "00:15:32", "text": "彼は私を置いていった、これは"}, {"type": "subtitle", "time": 940.91, "timestamp": "00:15:40", "text": "クソ、私は死ぬんだ"}, {"type": "subtitle", "time": 945.79, "timestamp": "00:15:45", "text": "フレアで殺された勇敢なBRピークは"}, {"type": "subtitle", "time": 950.67, "timestamp": "00:15:50", "text": "エリートとゴールド、なぜあなたは"}]
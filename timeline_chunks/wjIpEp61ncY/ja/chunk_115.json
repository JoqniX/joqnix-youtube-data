[{"type": "subtitle", "time": 6903.189, "timestamp": "01:55:03", "text": "トラ、そう、スーツを着たホワイトタイガー"}, {"type": "subtitle", "time": 6909.95, "timestamp": "01:55:09", "text": "おい、俺はあの野郎と戦いたいんだ"}, {"type": "subtitle", "time": 6916.709, "timestamp": "01:55:16", "text": "終わり 私は彼を殺したい 私たちは行く"}, {"type": "subtitle", "time": 6923.589, "timestamp": "01:55:23", "text": "ああ、もっといい車があるよ"}, {"type": "subtitle", "time": 6926.31, "timestamp": "01:55:26", "text": "ああ、大丈夫、私たちはただ癒されるだけだ"}, {"type": "subtitle", "time": 6943.709, "timestamp": "01:55:43", "text": "より良い自動車修理も、ああ神様"}, {"type": "subtitle", "time": 6948.03, "timestamp": "01:55:48", "text": "最高だ、ああ、これはいい、うんうん、私たち"}, {"type": "subtitle", "time": 6954.95, "timestamp": "01:55:54", "text": "サークルがここで農業をしているなんてありえない"}, {"type": "subtitle", "time": 6958.51, "timestamp": "01:55:58", "text": "他にはバカな森の中にいるよ、そうだね。"}]
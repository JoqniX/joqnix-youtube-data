[{"type": "subtitle", "time": 2885.589, "timestamp": "00:48:05", "text": "いいぞ、奴らを殺せ、いいぞ、それはとても"}, {"type": "subtitle", "time": 2888.349, "timestamp": "00:48:08", "text": "低かった彼は良い"}, {"type": "subtitle", "time": 2894.069, "timestamp": "00:48:14", "text": "そこにもう一人いたのを見たかい？"}, {"type": "subtitle", "time": 2895.309, "timestamp": "00:48:15", "text": "誰でも"}, {"type": "subtitle", "time": 2898.63, "timestamp": "00:48:18", "text": "そうでなければ、プルSCを置きます"}, {"type": "subtitle", "time": 2916.589, "timestamp": "00:48:36", "text": "サブゼロは、サブを持っているときにわかります"}, {"type": "subtitle", "time": 2920.069, "timestamp": "00:48:40", "text": "サブゼロのガントレットを装着すると、"}, {"type": "subtitle", "time": 2921.03, "timestamp": "00:48:41", "text": "水"}, {"type": "subtitle", "time": 2924.19, "timestamp": "00:48:44", "text": "歩いている、いや、フロスト"}, {"type": "subtitle", "time": 2928.109, "timestamp": "00:48:48", "text": "歩いてるよ、3つ全部手に入れたの？"}, {"type": "subtitle", "time": 2931.589, "timestamp": "00:48:51", "text": "彼らは、いや、私は"}, {"type": "subtitle", "time": 2934.71, "timestamp": "00:48:54", "text": "もう1つ手に入れる"}, {"type": "subtitle", "time": 2938.39, "timestamp": "00:48:58", "text": "うん、たぶん1つあると思う"}]
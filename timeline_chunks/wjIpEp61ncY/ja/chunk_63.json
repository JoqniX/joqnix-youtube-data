[{"type": "subtitle", "time": 3780.15, "timestamp": "01:03:00", "text": "薪割り検索休憩検索"}, {"type": "subtitle", "time": 3786.67, "timestamp": "01:03:06", "text": "クエストで取った胸のブードを壊した"}, {"type": "subtitle", "time": 3790.43, "timestamp": "01:03:10", "text": "ああ、ここの場所がわかりますか？"}, {"type": "subtitle", "time": 3792.789, "timestamp": "01:03:12", "text": "そして地図上ではそこが"}, {"type": "subtitle", "time": 3794.67, "timestamp": "01:03:14", "text": "埋めてよ"}, {"type": "subtitle", "time": 3797.549, "timestamp": "01:03:17", "text": "はい、もう片方もマークしてください"}, {"type": "subtitle", "time": 3800.309, "timestamp": "01:03:20", "text": "ああ、早くこっちに来て"}, {"type": "subtitle", "time": 3803.91, "timestamp": "01:03:23", "text": "闇市場があるから、"}, {"type": "subtitle", "time": 3806.309, "timestamp": "01:03:26", "text": "クソを買うよ、わかった、わかった、わかった、来るよ、来るよ"}, {"type": "subtitle", "time": 3809.51, "timestamp": "01:03:29", "text": "ガントレットが来るぞ、お前はそれを望んでいる"}, {"type": "subtitle", "time": 3811.029, "timestamp": "01:03:31", "text": "ここ"}, {"type": "subtitle", "time": 3815.069, "timestamp": "01:03:35", "text": "ガントレット、持ってるよ。ガントレットZ1、ああ、わかった。"}, {"type": "subtitle", "time": 3817.67, "timestamp": "01:03:37", "text": "ああ、NPCを雇うことができます。"}, {"type": "subtitle", "time": 3822.269, "timestamp": "01:03:42", "text": "彼女か彼だと思う、それはそれはそれはそれは"}, {"type": "subtitle", "time": 3833.19, "timestamp": "01:03:53", "text": "間違ってる、君はここから来たんだ、私は"}, {"type": "subtitle", "time": 3835.95, "timestamp": "01:03:55", "text": "敵がやってくる"}, {"type": "subtitle", "time": 3838.069, "timestamp": "01:03:58", "text": "恥を知れ、この野郎、恥を知れ"}]
[{"type": "subtitle", "time": 19151.23, "timestamp": "05:19:11", "text": "私は自分が何をするのかわかりません。"}, {"type": "subtitle", "time": 19153.708, "timestamp": "05:19:13", "text": "自分が何をするかは分かってるけど、それはそれでいいよ"}, {"type": "subtitle", "time": 19156.07, "timestamp": "05:19:16", "text": "私は車を修理した"}, {"type": "subtitle", "time": 19172.15, "timestamp": "05:19:32", "text": "いいですね、いいですね。わかりません、私は"}, {"type": "subtitle", "time": 19175.47, "timestamp": "05:19:35", "text": "いや、公共の場でストリーミング配信している"}]
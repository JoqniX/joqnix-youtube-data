[{"type": "subtitle", "time": 1503.909, "timestamp": "00:25:03", "text": "ジョックが戻ってくるのを遅らせる"}, {"type": "subtitle", "time": 1505.43, "timestamp": "00:25:05", "text": "私は手に入れるべきだ"}, {"type": "subtitle", "time": 1508.51, "timestamp": "00:25:08", "text": "このモードでは誰かが私に"}, {"type": "subtitle", "time": 1512.07, "timestamp": "00:25:12", "text": "私が必要としているのは、このクソ野郎はどこにいるのかということです"}, {"type": "subtitle", "time": 1514.149, "timestamp": "00:25:14", "text": "胸については謝罪するつもりはない"}, {"type": "subtitle", "time": 1516.909, "timestamp": "00:25:16", "text": "普段は呪うから呪うし"}, {"type": "subtitle", "time": 1523.75, "timestamp": "00:25:23", "text": "見て、そして"}, {"type": "subtitle", "time": 1526.43, "timestamp": "00:25:26", "text": "ストリーマー、彼は、私をあなたと一緒に残して去って行った"}, {"type": "subtitle", "time": 1528.87, "timestamp": "00:25:28", "text": "みんな、だから彼は何を知っていたはずなんだ"}, {"type": "subtitle", "time": 1530.43, "timestamp": "00:25:30", "text": "予定"}, {"type": "subtitle", "time": 1533.35, "timestamp": "00:25:33", "text": "見つけられない"}, {"type": "subtitle", "time": 1537.23, "timestamp": "00:25:37", "text": "それはまだああ"}, {"type": "subtitle", "time": 1539.59, "timestamp": "00:25:39", "text": "あああ"}, {"type": "subtitle", "time": 1542.51, "timestamp": "00:25:42", "text": "もちろん外にある、中ではない"}, {"type": "subtitle", "time": 1542.85, "timestamp": "00:25:42", "text": "くそっ"}, {"type": "subtitle", "time": 1546.43, "timestamp": "00:25:46", "text": "[音楽]"}, {"type": "subtitle", "time": 1550.71, "timestamp": "00:25:50", "text": "それは私が"}, {"type": "subtitle", "time": 1552.83, "timestamp": "00:25:52", "text": "欲しい"}, {"type": "subtitle", "time": 1555.51, "timestamp": "00:25:55", "text": "それは良い考えだとは思わない"}, {"type": "subtitle", "time": 1558.95, "timestamp": "00:25:58", "text": "欲しいけど、しないと思う。わからない。"}]
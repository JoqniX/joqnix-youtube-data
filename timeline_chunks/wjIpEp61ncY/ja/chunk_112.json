[{"type": "subtitle", "time": 6721.75, "timestamp": "01:52:01", "text": "うん、彼は殺されたと思う"}, {"type": "subtitle", "time": 6724.75, "timestamp": "01:52:04", "text": "ボットが知らない何か"}, {"type": "subtitle", "time": 6727.03, "timestamp": "01:52:07", "text": "いや、彼は生きている。どこかにいる。"}, {"type": "subtitle", "time": 6729.39, "timestamp": "01:52:09", "text": "欲しい、あの毛むくじゃらの虎が欲しい"}, {"type": "subtitle", "time": 6731.79, "timestamp": "01:52:11", "text": "気にしない、私は最高だ、私は最高だ"}, {"type": "subtitle", "time": 6733.55, "timestamp": "01:52:13", "text": "そのため"}, {"type": "subtitle", "time": 6740.91, "timestamp": "01:52:20", "text": "神よ、彼は走った、とても速く逃げた"}, {"type": "subtitle", "time": 6743.629, "timestamp": "01:52:23", "text": "彼はパニックになっている"}, {"type": "subtitle", "time": 6746.149, "timestamp": "01:52:26", "text": "本当は気にしない、私は、私は、私は手に入れている"}, {"type": "subtitle", "time": 6749.43, "timestamp": "01:52:29", "text": "あの男、君のためにあれが欲しいんだ、あああれ"}, {"type": "subtitle", "time": 6753.95, "timestamp": "01:52:33", "text": "すごく悪い音ですね。私は、私は、私は、私は、私は"}, {"type": "subtitle", "time": 6756.51, "timestamp": "01:52:36", "text": "君のために殺す、私は欲しくない"}, {"type": "subtitle", "time": 6759.39, "timestamp": "01:52:39", "text": "君のために、彼を殺したいんだ。"}, {"type": "subtitle", "time": 6761.35, "timestamp": "01:52:41", "text": "あちらで銃声が聞こえる、本当に"}, {"type": "subtitle", "time": 6763.229, "timestamp": "01:52:43", "text": "一緒に行こう、わかった、わかった、今行くから、入って"}, {"type": "subtitle", "time": 6766.43, "timestamp": "01:52:46", "text": "車に乗る"}]
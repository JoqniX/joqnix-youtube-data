[{"type": "subtitle", "time": 3603.029, "timestamp": "01:00:03", "text": "それはまるで空気のようだった。P Sim えーと、私は"}, {"type": "subtitle", "time": 3606.63, "timestamp": "01:00:06", "text": "なぜ5GBも使われていると言われるのか、私は知っています"}, {"type": "subtitle", "time": 3609.589, "timestamp": "01:00:09", "text": "彼女がなぜ受け取れないのか理解できなかった"}, {"type": "chat", "time": 3611.059, "timestamp": "01:00:11", "author": "@Astro-9999", "avatar": "https://yt4.ggpht.com/I0atDf8aJGAiY3Z-U4COpBQFW4_qYnJ5GkhRqDK8dE_sjbhzV3NcVv5LuXD4hdY7IHeyOXW2OQ=s64-c-k-c0x00ffffff-no-rj", "message": "avg tech person in house"}, {"type": "subtitle", "time": 3613.95, "timestamp": "01:00:13", "text": "データ、彼女はそれを終えたのかもしれない。5Gと書いてある。"}, {"type": "subtitle", "time": 3618.39, "timestamp": "01:00:18", "text": "使ったよ、うん、よく使ったって彼女は言った"}, {"type": "subtitle", "time": 3620.27, "timestamp": "01:00:20", "text": "電源を入れただけで、彼女は再生しなかった"}, {"type": "subtitle", "time": 3622.23, "timestamp": "01:00:22", "text": "モバイルデータで"}, {"type": "subtitle", "time": 3626.47, "timestamp": "01:00:26", "text": "設定して、そう、彼女に言ったんだ"}, {"type": "subtitle", "time": 3628.15, "timestamp": "01:00:28", "text": "彼女は彼らがそうしなかったと確信しているのでしょうか"}, {"type": "subtitle", "time": 3631.069, "timestamp": "01:00:31", "text": "彼女のWi-Fiをオンにするか、ホットポットを使用して"}, {"type": "subtitle", "time": 3640.51, "timestamp": "01:00:40", "text": "ああ、文字通り彼らにあげられるよ"}, {"type": "subtitle", "time": 3643.029, "timestamp": "01:00:43", "text": "Wi-Fiのパスワードを忘れた"}, {"type": "subtitle", "time": 3645.95, "timestamp": "01:00:45", "text": "文字通りここにある、なぜそんなことをするんだ"}, {"type": "subtitle", "time": 3648.19, "timestamp": "01:00:48", "text": "待って、何なんだよ、なんでそんなことするんだ"}, {"type": "subtitle", "time": 3650.029, "timestamp": "01:00:50", "text": "なぜ共有するのか"}, {"type": "subtitle", "time": 3651.47, "timestamp": "01:00:51", "text": "隣人にあなたのパスワードを教える"}, {"type": "subtitle", "time": 3653.19, "timestamp": "01:00:53", "text": "彼らがそれを好きになって共有し始めたらどうなるだろうか"}, {"type": "subtitle", "time": 3654.67, "timestamp": "01:00:54", "text": "周りの人たちは「この男はいい人だ」って感じ"}, {"type": "subtitle", "time": 3656.47, "timestamp": "01:00:56", "text": "それと一緒に、そしてそれを共有します"}, {"type": "subtitle", "time": 3658.75, "timestamp": "01:00:58", "text": "そして、あなたはそれを持っていなくて、そして彼らは"}]
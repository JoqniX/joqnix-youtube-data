[{"type": "subtitle", "time": 14592.75, "timestamp": "04:03:12", "text": "ゲートとは"}, {"type": "subtitle", "time": 14596.71, "timestamp": "04:03:16", "text": "一体誰がどうやって"}, {"type": "subtitle", "time": 14600.99, "timestamp": "04:03:20", "text": "D 私は最善を尽くしました"}, {"type": "subtitle", "time": 14605.59, "timestamp": "04:03:25", "text": "私たち、これは、これは"}, {"type": "subtitle", "time": 14612.349, "timestamp": "04:03:32", "text": "男よ、我々の基地は"}, {"type": "subtitle", "time": 14616.189, "timestamp": "04:03:36", "text": "もう死なないよ、私が何者か分かるでしょ"}, {"type": "subtitle", "time": 14621.75, "timestamp": "04:03:41", "text": "後ろでは、"}, {"type": "subtitle", "time": 14625.07, "timestamp": "04:03:45", "text": "もし私がチームにいたら"}, {"type": "subtitle", "time": 14627.91, "timestamp": "04:03:47", "text": "もっとうまく戦略を立てられたかもしれないが、"}, {"type": "subtitle", "time": 14629.149, "timestamp": "04:03:49", "text": "もう一人の男"}, {"type": "subtitle", "time": 14633.75, "timestamp": "04:03:53", "text": "わからない、"}, {"type": "subtitle", "time": 14637.96, "timestamp": "04:03:57", "text": "スイッチ もっと欲しい"}, {"type": "subtitle", "time": 14639.75, "timestamp": "04:03:59", "text": "[音楽]"}]
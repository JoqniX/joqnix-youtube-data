[{"type": "subtitle", "time": 4020.84, "timestamp": "01:07:00", "text": "見た目はそうだけど、"}, {"type": "subtitle", "time": 4023.589, "timestamp": "01:07:03", "text": "[音楽]"}, {"type": "subtitle", "time": 4034.39, "timestamp": "01:07:14", "text": "寒いから私は食べるのが好きじゃないし"}, {"type": "subtitle", "time": 4036.99, "timestamp": "01:07:16", "text": "時々配信する 私はたくさんしゃべってから"}, {"type": "subtitle", "time": 4040.109, "timestamp": "01:07:20", "text": "ゲームをたくさんプレイしたが、忘れてしまった。"}, {"type": "subtitle", "time": 4041.99, "timestamp": "01:07:21", "text": "絶対に誰かの"}, {"type": "subtitle", "time": 4043.589, "timestamp": "01:07:23", "text": "ここに来たら、お前をぶちのめしてやる"}, {"type": "subtitle", "time": 4044.65, "timestamp": "01:07:24", "text": "お尻"}]
[{"type": "subtitle", "time": 17185.35, "timestamp": "04:46:25", "text": "くそ、彼を殺せ、こんにちは警官、私はただ"}, {"type": "subtitle", "time": 17187.14, "timestamp": "04:46:27", "text": "無実の"}, {"type": "subtitle", "time": 17188.35, "timestamp": "04:46:28", "text": "[音楽]"}, {"type": "subtitle", "time": 17190.948, "timestamp": "04:46:30", "text": "星座は気にしない"}, {"type": "subtitle", "time": 17206.99, "timestamp": "04:46:46", "text": "ヒドラ万歳と言おうとしてたのに、"}]
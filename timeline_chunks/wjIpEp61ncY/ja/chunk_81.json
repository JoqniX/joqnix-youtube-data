[{"type": "subtitle", "time": 4861.669, "timestamp": "01:21:01", "text": "私は逃げ出した、ああ、なんてこった、銃は"}, {"type": "subtitle", "time": 4863.43, "timestamp": "01:21:03", "text": "買いました、ここにあります、今手に入れました"}, {"type": "subtitle", "time": 4865.99, "timestamp": "01:21:05", "text": "箱から、言うまでもなく私は"}, {"type": "subtitle", "time": 4868.31, "timestamp": "01:21:08", "text": "2つ購入しました"}, {"type": "subtitle", "time": 4878.51, "timestamp": "01:21:18", "text": "ゲームが私をイライラさせているのは"}, {"type": "subtitle", "time": 4880.95, "timestamp": "01:21:20", "text": "目的"}, {"type": "subtitle", "time": 4883.55, "timestamp": "01:21:23", "text": "なぜなぜ私の"}, {"type": "subtitle", "time": 4887.79, "timestamp": "01:21:27", "text": "エネルギーよ、みんなここに来て、ちょっと待って"}, {"type": "subtitle", "time": 4891.39, "timestamp": "01:21:31", "text": "RSを少しもらってもいいですか？それともダメですか？"}, {"type": "subtitle", "time": 4900.31, "timestamp": "01:21:40", "text": "ここに自転車がある、ああ、あれだ"}, {"type": "subtitle", "time": 4903.87, "timestamp": "01:21:43", "text": "日本のヤクの自転車、不良自転車、ああ"}, {"type": "subtitle", "time": 4915.07, "timestamp": "01:21:55", "text": "[音楽]"}, {"type": "subtitle", "time": 4916.55, "timestamp": "01:21:56", "text": "さあ"}, {"type": "subtitle", "time": 4919.189, "timestamp": "01:21:59", "text": "行かない、私たちは"}]
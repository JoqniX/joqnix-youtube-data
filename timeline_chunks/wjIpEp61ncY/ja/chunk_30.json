[{"type": "subtitle", "time": 1803.389, "timestamp": "00:30:03", "text": "ミク、じゃあ私は3種類のミクを持っている"}, {"type": "subtitle", "time": 1804.509, "timestamp": "00:30:04", "text": "明るい"}, {"type": "subtitle", "time": 1807.63, "timestamp": "00:30:07", "text": "ミクは"}, {"type": "subtitle", "time": 1811.029, "timestamp": "00:30:11", "text": "ミクと普通のミク、どちらが好きですか？"}, {"type": "subtitle", "time": 1814.23, "timestamp": "00:30:14", "text": "絶対にタキは欲しくない、母が投げる"}, {"type": "subtitle", "time": 1817.149, "timestamp": "00:30:17", "text": "パンは肉体的、精神的な両方に作用する"}, {"type": "subtitle", "time": 1819.669, "timestamp": "00:30:19", "text": "ダメージ"}, {"type": "subtitle", "time": 1824.19, "timestamp": "00:30:24", "text": "ああ、私の母はそんなことはしなかった"}, {"type": "subtitle", "time": 1828.909, "timestamp": "00:30:28", "text": "えーっと、暴力"}, {"type": "subtitle", "time": 1831.71, "timestamp": "00:30:31", "text": "彼女は間違いなくハンガーを使った"}, {"type": "subtitle", "time": 1835.11, "timestamp": "00:30:35", "text": "でもフライパンは見た目が良くないから"}, {"type": "subtitle", "time": 1838.029, "timestamp": "00:30:38", "text": "とても危険な"}, {"type": "subtitle", "time": 1841.47, "timestamp": "00:30:41", "text": "武器は覚えていないが、ただ知っている"}, {"type": "subtitle", "time": 1843.07, "timestamp": "00:30:43", "text": "私が幼い頃、彼女は私を殴っていた"}, {"type": "subtitle", "time": 1846.269, "timestamp": "00:30:46", "text": "服などのランダムなもの"}, {"type": "subtitle", "time": 1849.71, "timestamp": "00:30:49", "text": "ハンガーまたはスリッパと一緒に"}, {"type": "subtitle", "time": 1852.789, "timestamp": "00:30:52", "text": "ほうきだけど、あ、櫛も一緒にこれ"}, {"type": "subtitle", "time": 1855.389, "timestamp": "00:30:55", "text": "もっと優しくしてね"}, {"type": "subtitle", "time": 1857.629, "timestamp": "00:30:57", "text": "はい、私が持っていないことを確認しているだけです"}, {"type": "subtitle", "time": 1858.43, "timestamp": "00:30:58", "text": "の"}]
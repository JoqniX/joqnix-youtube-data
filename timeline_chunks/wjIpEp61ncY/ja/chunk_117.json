[{"type": "subtitle", "time": 7022.35, "timestamp": "01:57:02", "text": "まっすぐ進む、いや、いや、行くべきだ"}, {"type": "subtitle", "time": 7026.39, "timestamp": "01:57:06", "text": "まっすぐH、車はDになる、あぁあ"}, {"type": "subtitle", "time": 7029.589, "timestamp": "01:57:09", "text": "神様、走れ走れ走れ走れ走れジョン"}, {"type": "subtitle", "time": 7036.83, "timestamp": "01:57:16", "text": "チーム、別のチーム、死なないで、死なないで、ああ"}, {"type": "subtitle", "time": 7038.91, "timestamp": "01:57:18", "text": "ああ神様、私は死にかけている"}, {"type": "subtitle", "time": 7042.709, "timestamp": "01:57:22", "text": "死ぬな、死なないで、そして"}, {"type": "subtitle", "time": 7045.79, "timestamp": "01:57:25", "text": "もう一つ先にどうぞ"}, {"type": "subtitle", "time": 7049.47, "timestamp": "01:57:29", "text": "ああ、彼らはやってくる"}, {"type": "subtitle", "time": 7061.79, "timestamp": "01:57:41", "text": "神様、ノック1回でこのチャンスを掴め"}, {"type": "subtitle", "time": 7064.709, "timestamp": "01:57:44", "text": "もう一人の男、いや"}, {"type": "subtitle", "time": 7067.589, "timestamp": "01:57:47", "text": "いや、ああ"}, {"type": "subtitle", "time": 7070.109, "timestamp": "01:57:50", "text": "神様"}, {"type": "subtitle", "time": 7078.95, "timestamp": "01:57:58", "text": "大丈夫だよ"}]
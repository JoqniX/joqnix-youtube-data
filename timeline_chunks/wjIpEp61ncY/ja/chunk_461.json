[{"type": "subtitle", "time": 27680.67, "timestamp": "07:41:20", "text": "バカ、あれは何だったの？私にはわからない"}, {"type": "subtitle", "time": 27683.03, "timestamp": "07:41:23", "text": "その男は指で何をしていたのか"}, {"type": "subtitle", "time": 27693.35, "timestamp": "07:41:33", "text": "なんでまだそんなこと言われてるんだよ"}, {"type": "subtitle", "time": 27696.03, "timestamp": "07:41:36", "text": "はい、私は最高です"}, {"type": "subtitle", "time": 27699.83, "timestamp": "07:41:39", "text": "神様、私は自分がどうなっているのかわかりません"}, {"type": "subtitle", "time": 27705.07, "timestamp": "07:41:45", "text": "実際には、自分がどうなっているのか分かりません"}, {"type": "subtitle", "time": 27710.75, "timestamp": "07:41:50", "text": "目を覚ますように"}, {"type": "subtitle", "time": 27713.868, "timestamp": "07:41:53", "text": "明日はうん、でも楽しんでくれるといいな"}, {"type": "subtitle", "time": 27715.99, "timestamp": "07:41:55", "text": "少なくとも私は"}, {"type": "subtitle", "time": 27719.308, "timestamp": "07:41:59", "text": "もっと推測する"}]
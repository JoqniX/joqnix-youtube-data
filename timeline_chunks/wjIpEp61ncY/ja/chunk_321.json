[{"type": "subtitle", "time": 19269.628, "timestamp": "05:21:09", "text": "オーケー、神様、ああ神様、ああ神様、いやいやいやいや"}, {"type": "subtitle", "time": 19273.43, "timestamp": "05:21:13", "text": "いやいやいや、殺さないで"}, {"type": "subtitle", "time": 19277.39, "timestamp": "05:21:17", "text": "私、ああ神様、あなたは私を殺さないで、ああ、殺さないで"}, {"type": "subtitle", "time": 19278.628, "timestamp": "05:21:18", "text": "殺す"}, {"type": "subtitle", "time": 19281.75, "timestamp": "05:21:21", "text": "それはどこにあるのか"}, {"type": "subtitle", "time": 19284.548, "timestamp": "05:21:24", "text": "いやいやいや、彼は文字通り計画している"}, {"type": "subtitle", "time": 19300.628, "timestamp": "05:21:40", "text": "しかし、彼は来るのか、彼は来るのか、彼は来るのか"}, {"type": "subtitle", "time": 19305.07, "timestamp": "05:21:45", "text": "彼は来るの？私はチャグジャグよ、ああ神様"}, {"type": "subtitle", "time": 19307.628, "timestamp": "05:21:47", "text": "それは実際、私の無謀な行動だった。"}, {"type": "subtitle", "time": 19311.35, "timestamp": "05:21:51", "text": "正直に言うと、それはかなりかなり"}, {"type": "subtitle", "time": 19316.788, "timestamp": "05:21:56", "text": "私、この男は何者？"}, {"type": "subtitle", "time": 19319.868, "timestamp": "05:21:59", "text": "あの男は一体何をしているんだ？文字通り歩いているのか？"}]
[{"type": "subtitle", "time": 10025.429, "timestamp": "02:47:05", "text": "ダブルキル、私はいいよ"}, {"type": "subtitle", "time": 10027.83, "timestamp": "02:47:07", "text": "兄弟、俺は"}, {"type": "subtitle", "time": 10033.51, "timestamp": "02:47:13", "text": "すべて素敵です、愛しています"}, {"type": "subtitle", "time": 10037.83, "timestamp": "02:47:17", "text": "ショットガン、またはツインファイアは実際には"}, {"type": "subtitle", "time": 10053.429, "timestamp": "02:47:33", "text": "ほとんどだけど、そうだ、殺しに行かなきゃ"}]
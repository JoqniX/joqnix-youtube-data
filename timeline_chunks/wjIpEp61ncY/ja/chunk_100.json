[{"type": "subtitle", "time": 6000.75, "timestamp": "01:40:00", "text": "アウトローをやっているけど、もし私が"}, {"type": "subtitle", "time": 6009.55, "timestamp": "01:40:09", "text": "100 そうですね、次のクエストは何ですか？"}, {"type": "subtitle", "time": 6012.589, "timestamp": "01:40:12", "text": "次のクエスト、えっと…"}, {"type": "subtitle", "time": 6018.55, "timestamp": "01:40:18", "text": "アウトローも何か言ってるね H"}, {"type": "subtitle", "time": 6020.07, "timestamp": "01:40:20", "text": "あなたは言っていました"}, {"type": "subtitle", "time": 6023.189, "timestamp": "01:40:23", "text": "何かアウトローの質問は正しくありません"}, {"type": "subtitle", "time": 6025.75, "timestamp": "01:40:25", "text": "ああ、それは終わった。次は村人だ。"}, {"type": "subtitle", "time": 6027.229, "timestamp": "01:40:27", "text": "女の子"}, {"type": "subtitle", "time": 6030.629, "timestamp": "01:40:30", "text": "クエスト、うんうん、何？わかった、私は"}, {"type": "subtitle", "time": 6032.55, "timestamp": "01:40:32", "text": "それをマークする"}, {"type": "subtitle", "time": 6035.31, "timestamp": "01:40:35", "text": "地図は、"}, {"type": "subtitle", "time": 6040.47, "timestamp": "01:40:40", "text": "ジョシュ、そう、ジョシュ、音楽の魔法"}, {"type": "subtitle", "time": 6047.669, "timestamp": "01:40:47", "text": "モーゼ、それは何ですか、あなたは持っていますか"}, {"type": "subtitle", "time": 6049.589, "timestamp": "01:40:49", "text": "彼女と話す、それだけ、そう、話す"}]
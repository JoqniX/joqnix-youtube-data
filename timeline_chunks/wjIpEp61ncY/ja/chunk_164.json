[{"type": "subtitle", "time": 9881.95, "timestamp": "02:44:41", "text": "シールドを手に入れて、私は"}, {"type": "subtitle", "time": 9883.71, "timestamp": "02:44:43", "text": "意思"}, {"type": "subtitle", "time": 9886.95, "timestamp": "02:44:46", "text": "えっと、これをこっちに持ってきて、いいですか。"}, {"type": "subtitle", "time": 9889.19, "timestamp": "02:44:49", "text": "良いはずだ"}, {"type": "subtitle", "time": 9891.79, "timestamp": "02:44:51", "text": "宝箱を探しているのですが、どこに"}, {"type": "subtitle", "time": 9892.95, "timestamp": "02:44:52", "text": "の"}, {"type": "subtitle", "time": 9895.19, "timestamp": "02:44:55", "text": "胸"}]
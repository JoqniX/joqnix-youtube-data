[{"type": "subtitle", "time": 16860.27, "timestamp": "04:41:00", "text": "いいえ、幸運にもゲームに勝ちました。"}, {"type": "subtitle", "time": 16862.708, "timestamp": "04:41:02", "text": "私は傘を手に入れた、それが私が"}, {"type": "subtitle", "time": 16866.67, "timestamp": "04:41:06", "text": "このゲームを手に入れたくて待っていました"}, {"type": "subtitle", "time": 16872.03, "timestamp": "04:41:12", "text": "汗だくで、私は"}, {"type": "subtitle", "time": 16873.35, "timestamp": "04:41:13", "text": "しかし"}, {"type": "subtitle", "time": 16879.708, "timestamp": "04:41:19", "text": "私もフォートナイトをプレイしたい"}, {"type": "subtitle", "time": 16889.708, "timestamp": "04:41:29", "text": "遊ぶ 待って 明日は土曜日 今日は"}, {"type": "subtitle", "time": 16893.47, "timestamp": "04:41:33", "text": "金曜日、明日は何時ですか？8時10分です。"}, {"type": "subtitle", "time": 16895.15, "timestamp": "04:41:35", "text": "もし私が正しいなら"}, {"type": "subtitle", "time": 16898.27, "timestamp": "04:41:38", "text": "そうだ、神様、私は本当に休まなければならない"}, {"type": "subtitle", "time": 16902.11, "timestamp": "04:41:42", "text": "睡眠をとれば実際にエネルギーが湧いてくる"}, {"type": "subtitle", "time": 16904.948, "timestamp": "04:41:44", "text": "明日、私はどうなるかわからない"}, {"type": "subtitle", "time": 16908.15, "timestamp": "04:41:48", "text": "他の人たちは長く滞在するだろうが、私は"}, {"type": "subtitle", "time": 16910.51, "timestamp": "04:41:50", "text": "少なくとも3日目まで滞在する予定です"}, {"type": "subtitle", "time": 16916.868, "timestamp": "04:41:56", "text": "15分、つまり午後9時30分です。 300まで"}]
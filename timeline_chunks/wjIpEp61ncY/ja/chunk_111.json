[{"type": "subtitle", "time": 6660.31, "timestamp": "01:51:00", "text": "彼らが戦っている人々、私は手に入れるつもりです"}, {"type": "subtitle", "time": 6662.149, "timestamp": "01:51:02", "text": "私たちが戻る車は"}, {"type": "subtitle", "time": 6664.79, "timestamp": "01:51:04", "text": "気にしない、あのクソ野郎を殺したい、私は"}, {"type": "subtitle", "time": 6667.669, "timestamp": "01:51:07", "text": "私はそれを取るつもりです"}, {"type": "subtitle", "time": 6669.91, "timestamp": "01:51:09", "text": "自転車よし、私が先に行くわ、来ないで"}, {"type": "subtitle", "time": 6678.189, "timestamp": "01:51:18", "text": "死ぬ"}, {"type": "subtitle", "time": 6682.83, "timestamp": "01:51:22", "text": "彼はどこにいるの？大丈夫？これを実行中"}, {"type": "subtitle", "time": 6684.47, "timestamp": "01:51:24", "text": "ああ、そうだよ"}, {"type": "subtitle", "time": 6686.31, "timestamp": "01:51:26", "text": "うん"}, {"type": "subtitle", "time": 6688.95, "timestamp": "01:51:28", "text": "本当に、ああ、そうだ、まったくその通り"}, {"type": "subtitle", "time": 6691.03, "timestamp": "01:51:31", "text": "真っ直ぐ"}, {"type": "subtitle", "time": 6699.99, "timestamp": "01:51:39", "text": "あなた"}, {"type": "subtitle", "time": 6702.189, "timestamp": "01:51:42", "text": "お前のことなんてどうでもいい"}, {"type": "subtitle", "time": 6704.87, "timestamp": "01:51:44", "text": "君も死ぬんだよ"}, {"type": "subtitle", "time": 6708.27, "timestamp": "01:51:48", "text": "さあ、車に乗って"}, {"type": "subtitle", "time": 6711.189, "timestamp": "01:51:51", "text": "わかったよ、どこへ行くんだ"}, {"type": "subtitle", "time": 6713.43, "timestamp": "01:51:53", "text": "これは私が見たものです"}, {"type": "subtitle", "time": 6715.229, "timestamp": "01:51:55", "text": "あなたなの"}, {"type": "subtitle", "time": 6718.55, "timestamp": "01:51:58", "text": "いいえ、それは別の人です、それはボットです"}]
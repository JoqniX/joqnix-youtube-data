[{"type": "subtitle", "time": 5056.39, "timestamp": "01:24:16", "text": "急いで車か乗り物を見つけよう"}, {"type": "subtitle", "time": 5059.87, "timestamp": "01:24:19", "text": "そうすれば、私たちは"}, {"type": "subtitle", "time": 5063.15, "timestamp": "01:24:23", "text": "走れ、何も見えない"}, {"type": "subtitle", "time": 5065.189, "timestamp": "01:24:25", "text": "[音楽]"}, {"type": "subtitle", "time": 5066.31, "timestamp": "01:24:26", "text": "あなたが持っている"}, {"type": "subtitle", "time": 5072.99, "timestamp": "01:24:32", "text": "癒しがすぐにやって来る"}, {"type": "subtitle", "time": 5080.669, "timestamp": "01:24:40", "text": "また死ぬの？うん、いや、いや"}, {"type": "subtitle", "time": 5084.75, "timestamp": "01:24:44", "text": "いいえ、はい、はい、大丈夫です、あなたはやり遂げました"}, {"type": "subtitle", "time": 5088.149, "timestamp": "01:24:48", "text": "いいけど、私は死ぬよ 20 20 hp ああ、なんてことだ"}, {"type": "subtitle", "time": 5090.99, "timestamp": "01:24:50", "text": "神様、大丈夫です、癒されました、十分です"}, {"type": "subtitle", "time": 5094.149, "timestamp": "01:24:54", "text": "癒やすには、集中力を高める必要がある"}, {"type": "subtitle", "time": 5098.79, "timestamp": "01:24:58", "text": "それはゾーンランでまっすぐ走る"}]
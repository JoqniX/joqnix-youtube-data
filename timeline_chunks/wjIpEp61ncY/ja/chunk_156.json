[{"type": "subtitle", "time": 9362.15, "timestamp": "02:36:02", "text": "はい、コントロール シフト オルト 誰か"}, {"type": "subtitle", "time": 9364.91, "timestamp": "02:36:04", "text": "私にとってそれはまた"}, {"type": "subtitle", "time": 9368.429, "timestamp": "02:36:08", "text": "より良いコントロールシフトオルタネート"}, {"type": "subtitle", "time": 9372.75, "timestamp": "02:36:12", "text": "バックスペース、はい、Nはまだ"}, {"type": "subtitle", "time": 9376.23, "timestamp": "02:36:16", "text": "もう一方のモニターは、"}, {"type": "subtitle", "time": 9379.99, "timestamp": "02:36:19", "text": "大丈夫だけど、大丈夫だよ。まだ手に入るよ。"}, {"type": "subtitle", "time": 9383.429, "timestamp": "02:36:23", "text": "私がやりたいことはうまくいかない"}, {"type": "subtitle", "time": 9387.71, "timestamp": "02:36:27", "text": "外側はシフトなし、シフトなし、バック"}, {"type": "subtitle", "time": 9390.23, "timestamp": "02:36:30", "text": "スペースシフトバック"}]
[{"type": "subtitle", "time": 602.63, "timestamp": "00:10:02", "text": "何か変なことだけど、大丈夫だよ"}, {"type": "subtitle", "time": 607.03, "timestamp": "00:10:07", "text": "心配はさておき、君が引き継ぐんだから、そうだね"}, {"type": "subtitle", "time": 618.23, "timestamp": "00:10:18", "text": "大丈夫、私に優しくして、心配しないで、彼らは"}, {"type": "subtitle", "time": 619.79, "timestamp": "00:10:19", "text": "彼らがそうでないなら、私が面倒を見ます"}, {"type": "subtitle", "time": 621.389, "timestamp": "00:10:21", "text": "その"}, {"type": "subtitle", "time": 625.55, "timestamp": "00:10:25", "text": "こんにちは、チャドさん、私はためらいません。"}, {"type": "subtitle", "time": 629.03, "timestamp": "00:10:29", "text": "Jとは違って、私はこのクソみたいなことを言うだろう"}, {"type": "subtitle", "time": 643.629, "timestamp": "00:10:43", "text": "同じものを入手できますか？"}, {"type": "subtitle", "time": 647.389, "timestamp": "00:10:47", "text": "ところで、このファルコンアイ・スナイパーって何？"}, {"type": "subtitle", "time": 649.03, "timestamp": "00:10:49", "text": "ファルコンI"}, {"type": "subtitle", "time": 651.03, "timestamp": "00:10:51", "text": "スナイパー、これは"}, {"type": "subtitle", "time": 655.87, "timestamp": "00:10:55", "text": "金、それも金だと思うよ。"}, {"type": "subtitle", "time": 657.87, "timestamp": "00:10:57", "text": "私が心配していることはただ一つ"}]
[{"type": "subtitle", "time": 14004.229, "timestamp": "03:53:24", "text": "ああ、ベットだ、そう、ベットが必要だ、私は"}, {"type": "subtitle", "time": 14008.87, "timestamp": "03:53:28", "text": "家に帰る、私の愛しい家、私は"}, {"type": "subtitle", "time": 14011.469, "timestamp": "03:53:31", "text": "今日は一生懸命頑張った"}, {"type": "subtitle", "time": 14014.87, "timestamp": "03:53:34", "text": "ダイヤモンド、そこに行きたいの。"}, {"type": "subtitle", "time": 14032.189, "timestamp": "03:53:52", "text": "はい"}, {"type": "subtitle", "time": 14035.63, "timestamp": "03:53:55", "text": "ああああ"}, {"type": "subtitle", "time": 14037.95, "timestamp": "03:53:57", "text": "気をつけて"}]
[{"type": "subtitle", "time": 5282.55, "timestamp": "01:28:02", "text": "車と実際の人と戦う"}, {"type": "subtitle", "time": 5286.189, "timestamp": "01:28:06", "text": "遊びを見つけたい、今は11時だ、ああそうだ"}, {"type": "subtitle", "time": 5297.59, "timestamp": "01:28:17", "text": "そう、それで天気予報士を殺したんだ"}, {"type": "subtitle", "time": 5305.31, "timestamp": "01:28:25", "text": "カードL低値が必要な場合は"}, {"type": "subtitle", "time": 5307.709, "timestamp": "01:28:27", "text": "そしてあなたは"}, {"type": "subtitle", "time": 5310.83, "timestamp": "01:28:30", "text": "うん、わかった、上に男がいるから"}, {"type": "subtitle", "time": 5312.55, "timestamp": "01:28:32", "text": "彼を殺せ"}, {"type": "subtitle", "time": 5314.91, "timestamp": "01:28:34", "text": "もしかしたら、あなたは目立たないようにしていたいと思ったのかもしれない"}, {"type": "subtitle", "time": 5316.189, "timestamp": "01:28:36", "text": "探していたもの"}, {"type": "subtitle", "time": 5320.27, "timestamp": "01:28:40", "text": "彼だけど、じゃあ彼を選ぶことにしよう"}, {"type": "subtitle", "time": 5322.83, "timestamp": "01:28:42", "text": "うん"}, {"type": "subtitle", "time": 5327.59, "timestamp": "01:28:47", "text": "はい、こんにちは、こんにちは、それはバグですか"}, {"type": "subtitle", "time": 5330.03, "timestamp": "01:28:50", "text": "女の子"}, {"type": "subtitle", "time": 5333.229, "timestamp": "01:28:53", "text": "いいね、うん、わかった、スナイパーが"}, {"type": "subtitle", "time": 5334.79, "timestamp": "01:28:54", "text": "役立つ支援"}, {"type": "subtitle", "time": 5339.07, "timestamp": "01:28:59", "text": "お前は俺と一緒に来ないだろ、兄弟、お前は"}]
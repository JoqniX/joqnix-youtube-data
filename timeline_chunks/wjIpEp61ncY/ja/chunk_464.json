[{"type": "subtitle", "time": 27844.51, "timestamp": "07:44:04", "text": "聖なる"}, {"type": "subtitle", "time": 27847.59, "timestamp": "07:44:07", "text": "神よ、何が"}, {"type": "subtitle", "time": 27852.468, "timestamp": "07:44:12", "text": "それは何だったのか、それは何だったのか"}, {"type": "subtitle", "time": 27858.99, "timestamp": "07:44:18", "text": "なんてこった、あれは何だったんだ？"}, {"type": "subtitle", "time": 27862.468, "timestamp": "07:44:22", "text": "事前にダイアリ ADV こんにちは、幸せなダイアリも"}, {"type": "subtitle", "time": 27865.07, "timestamp": "07:44:25", "text": "チャットの皆さんにも前もって"}, {"type": "subtitle", "time": 27866.948, "timestamp": "07:44:26", "text": "として"}, {"type": "subtitle", "time": 27869.59, "timestamp": "07:44:29", "text": "まあ、幸せ"}, {"type": "subtitle", "time": 27872.75, "timestamp": "07:44:32", "text": "ええ、でも私はそれを祝うつもりはありませんが"}, {"type": "subtitle", "time": 27877.35, "timestamp": "07:44:37", "text": "光の祭典おめでとう"}]
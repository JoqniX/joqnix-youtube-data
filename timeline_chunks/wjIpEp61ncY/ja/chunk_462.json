[{"type": "subtitle", "time": 27723.43, "timestamp": "07:42:03", "text": "もっともっともっと、ああ神様、きっと"}, {"type": "subtitle", "time": 27727.59, "timestamp": "07:42:07", "text": "実際に少し寝ようと思います"}, {"type": "subtitle", "time": 27744.868, "timestamp": "07:42:24", "text": "おそらく明日遅くに"}, {"type": "subtitle", "time": 27748.11, "timestamp": "07:42:28", "text": "朝のセクションを完全にVにアップ"}, {"type": "subtitle", "time": 27754.388, "timestamp": "07:42:34", "text": "再生が必要だからだと思う"}, {"type": "subtitle", "time": 27763.27, "timestamp": "07:42:43", "text": "まあ、私がそこに留まっていたのが悪いんだ"}, {"type": "subtitle", "time": 27768.43, "timestamp": "07:42:48", "text": "フォートナイトをやりすぎたので"}, {"type": "subtitle", "time": 27769.99, "timestamp": "07:42:49", "text": "うん"}]
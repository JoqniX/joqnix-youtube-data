[{"type": "subtitle", "time": 660.79, "timestamp": "00:11:00", "text": "チャットがラグったらどうなる？"}, {"type": "subtitle", "time": 662.35, "timestamp": "00:11:02", "text": "つまり、もしそうじゃなかったらどうなるか"}, {"type": "subtitle", "time": 665.91, "timestamp": "00:11:05", "text": "読み込み中なので、チャットは問題ないと思います"}, {"type": "subtitle", "time": 673.629, "timestamp": "00:11:13", "text": "問題ない場合は"}, {"type": "subtitle", "time": 677.47, "timestamp": "00:11:17", "text": "いいよ、チャド、ここにいないよ"}, {"type": "subtitle", "time": 680.19, "timestamp": "00:11:20", "text": "もうこれ以上は"}, {"type": "subtitle", "time": 684.069, "timestamp": "00:11:24", "text": "オーバー 私はあなたの友達です ああ、私はちょっと"}, {"type": "subtitle", "time": 688.55, "timestamp": "00:11:28", "text": "襲撃したい、襲撃したくない、何が"}, {"type": "subtitle", "time": 696.23, "timestamp": "00:11:36", "text": "ああ、強盗だ。強盗をしたい。テストがある。"}, {"type": "subtitle", "time": 697.99, "timestamp": "00:11:37", "text": "シャドウブリーフィングを完了する"}, {"type": "subtitle", "time": 699.67, "timestamp": "00:11:39", "text": "私の"}, {"type": "subtitle", "time": 703.79, "timestamp": "00:11:43", "text": "敵を信用しない、どうすればいいんだ"}, {"type": "subtitle", "time": 705.19, "timestamp": "00:11:45", "text": "見知らぬ人"}, {"type": "chat", "time": 709.185, "timestamp": "00:11:49", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "fortnite battlepass"}, {"type": "subtitle", "time": 719.55, "timestamp": "00:11:59", "text": "危険だ、いやいや、実際はそうではない"}]
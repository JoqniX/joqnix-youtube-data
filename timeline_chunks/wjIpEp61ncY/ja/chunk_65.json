[{"type": "subtitle", "time": 3901.029, "timestamp": "01:05:01", "text": "次回はキャンプに行こう"}, {"type": "subtitle", "time": 3903.67, "timestamp": "01:05:03", "text": "一緒に、うんうん、ああ、見えるかい？"}, {"type": "subtitle", "time": 3907.63, "timestamp": "01:05:07", "text": "水が見えるよ、Bo M、そう、それが"}, {"type": "subtitle", "time": 3910.15, "timestamp": "01:05:10", "text": "シールドと健康"}, {"type": "subtitle", "time": 3915.95, "timestamp": "01:05:15", "text": "ああ、シールドはたった50個。かわいいね。"}, {"type": "subtitle", "time": 3918.67, "timestamp": "01:05:18", "text": "持ち歩くのも"}, {"type": "subtitle", "time": 3922.63, "timestamp": "01:05:22", "text": "ああ、それは良いですね。私はこれが好きです。"}, {"type": "subtitle", "time": 3926.63, "timestamp": "01:05:26", "text": "エルフのスキン、うん、持ってるよ"}, {"type": "subtitle", "time": 3928.95, "timestamp": "01:05:28", "text": "それが私の最初のバトルパスだから"}, {"type": "subtitle", "time": 3936.47, "timestamp": "01:05:36", "text": "いい選曲だけど、演奏者は嫌い。"}, {"type": "subtitle", "time": 3942.71, "timestamp": "01:05:42", "text": "でも、なんで彼らはキャンプしてるんだよ、キャンパーたち"}, {"type": "subtitle", "time": 3945.589, "timestamp": "01:05:45", "text": "なんでかって？そういう人がいるのは知ってたけど"}, {"type": "subtitle", "time": 3949.75, "timestamp": "01:05:49", "text": "私はこれまで彼らに会ったことがない"}, {"type": "subtitle", "time": 3953.47, "timestamp": "01:05:53", "text": "1試合あたりが速いのは、イライラする。"}, {"type": "subtitle", "time": 3956.39, "timestamp": "01:05:56", "text": "なぜ私が先に死んだのか、なぜあなたは行ったのか"}, {"type": "subtitle", "time": 3958.829, "timestamp": "01:05:58", "text": "それはあなたの仕事である前に、なぜあなたは入ったのですか"}]
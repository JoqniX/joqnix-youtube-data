[{"type": "subtitle", "time": 6785.31, "timestamp": "01:53:05", "text": "こんにちは、見逃しました、見逃しました、ああ、いいですね"}, {"type": "subtitle", "time": 6796.109, "timestamp": "01:53:16", "text": "サル、なんてこった、いいえ、彼らは私を呼んだ"}, {"type": "subtitle", "time": 6801.87, "timestamp": "01:53:21", "text": "私、これはここにあるよ、えっと、金"}, {"type": "subtitle", "time": 6804.55, "timestamp": "01:53:24", "text": "スプラッシュをかけたいですか？PLだけ"}, {"type": "subtitle", "time": 6806.91, "timestamp": "01:53:26", "text": "金貨を少し使ってキルしたから"}, {"type": "subtitle", "time": 6811.109, "timestamp": "01:53:31", "text": "自分に使ってください、必要なら"}, {"type": "subtitle", "time": 6815.35, "timestamp": "01:53:35", "text": "よし、弾薬は無限だ"}, {"type": "subtitle", "time": 6819.51, "timestamp": "01:53:39", "text": "ええ、実際たくさんあります。"}, {"type": "subtitle", "time": 6822.99, "timestamp": "01:53:42", "text": "私はショットガンを持っていませんが、大丈夫です"}, {"type": "subtitle", "time": 6826.069, "timestamp": "01:53:46", "text": "ショットガンが欲しいなら、それを使ってもいいよ。"}, {"type": "subtitle", "time": 6827.39, "timestamp": "01:53:47", "text": "いらない、いらない、いらない"}, {"type": "subtitle", "time": 6830.31, "timestamp": "01:53:50", "text": "取って、取って、取って、ああ"}, {"type": "subtitle", "time": 6833.47, "timestamp": "01:53:53", "text": "よし、ベースボールのフルバットを狙う準備はできている"}, {"type": "subtitle", "time": 6837.589, "timestamp": "01:53:57", "text": "ロックして、ライ、行こうよ、オーケー、えっと、行こう"}]
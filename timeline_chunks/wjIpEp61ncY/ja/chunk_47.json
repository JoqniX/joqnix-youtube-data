[{"type": "subtitle", "time": 2820.069, "timestamp": "00:47:00", "text": "ストリーミングのみのビデオ"}, {"type": "subtitle", "time": 2824.03, "timestamp": "00:47:04", "text": "動画、ああ、それはもっと"}, {"type": "subtitle", "time": 2826.43, "timestamp": "00:47:06", "text": "デフォルトのものをプレイできるといいな"}, {"type": "subtitle", "time": 2828.03, "timestamp": "00:47:08", "text": "人々がいる"}, {"type": "subtitle", "time": 2840.47, "timestamp": "00:47:20", "text": "了解"}, {"type": "subtitle", "time": 2845.43, "timestamp": "00:47:25", "text": "そこに、あなたがいるあの建物があります"}, {"type": "subtitle", "time": 2856.79, "timestamp": "00:47:36", "text": "君がペイオンを妨害したから、私は全部手に入れなきゃいけない"}, {"type": "subtitle", "time": 2858.99, "timestamp": "00:47:38", "text": "ペイワンズ 私はペイワンズのために走るだけです"}, {"type": "subtitle", "time": 2860.95, "timestamp": "00:47:40", "text": "うんうん、君は君の"}, {"type": "subtitle", "time": 2862.549, "timestamp": "00:47:42", "text": "地図または"}, {"type": "subtitle", "time": 2865.19, "timestamp": "00:47:45", "text": "たぶん私はそう思わない"}, {"type": "subtitle", "time": 2867.23, "timestamp": "00:47:47", "text": "覚えておいて、あなたは彼らに会うでしょう、あなたは"}, {"type": "subtitle", "time": 2868.71, "timestamp": "00:47:48", "text": "小さな感嘆符のように"}, {"type": "subtitle", "time": 2870.51, "timestamp": "00:47:50", "text": "ああ、何かクエストが進行中なんですね"}, {"type": "subtitle", "time": 2873.67, "timestamp": "00:47:53", "text": "ここ、オーケー、あ、人がいる、誰か"}]
[{"type": "subtitle", "time": 1023.59, "timestamp": "00:17:03", "text": "歌付きのエモートをプレイしそうになった"}, {"type": "subtitle", "time": 1038.15, "timestamp": "00:17:18", "text": "ああ、俺のトラック全部見せてくれよ、兄弟。"}, {"type": "subtitle", "time": 1039.669, "timestamp": "00:17:19", "text": "の"}, {"type": "subtitle", "time": 1042.71, "timestamp": "00:17:22", "text": "くそ、ドゥームはどこだ？持ってないのか？"}, {"type": "subtitle", "time": 1044.35, "timestamp": "00:17:24", "text": "Lへ"}, {"type": "subtitle", "time": 1047.37, "timestamp": "00:17:27", "text": "そうだね"}, {"type": "subtitle", "time": 1062.71, "timestamp": "00:17:42", "text": "見つかりません。どこにあるのですか？"}, {"type": "subtitle", "time": 1065.909, "timestamp": "00:17:45", "text": "歌のゲームの動き"}]
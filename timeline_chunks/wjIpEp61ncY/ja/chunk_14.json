[{"type": "subtitle", "time": 842.99, "timestamp": "00:14:02", "text": "私はまだ強盗のやり方がわかりません"}, {"type": "subtitle", "time": 845.43, "timestamp": "00:14:05", "text": "電車は誰も知らない、私の友達も誰も知らない"}, {"type": "subtitle", "time": 869.91, "timestamp": "00:14:29", "text": "ロイヤルクレイジー、ストリームの見た目が違う"}, {"type": "subtitle", "time": 871.749, "timestamp": "00:14:31", "text": "つまり、私は低画質設定でプレイしているということです。"}, {"type": "subtitle", "time": 873.03, "timestamp": "00:14:33", "text": "しかし、"}, {"type": "subtitle", "time": 876.509, "timestamp": "00:14:36", "text": "異なる"}, {"type": "subtitle", "time": 878.79, "timestamp": "00:14:38", "text": "金をストリーミングする"}, {"type": "subtitle", "time": 886.79, "timestamp": "00:14:46", "text": "わーい、それで、最近参加した人たち"}]
[{"type": "subtitle", "time": 480.23, "timestamp": "00:08:00", "text": "もっと遊びたい場合はパーティーに参加してください"}, {"type": "subtitle", "time": 482.589, "timestamp": "00:08:02", "text": "試合は、また戻ってきます。"}, {"type": "subtitle", "time": 485.99, "timestamp": "00:08:05", "text": "スピードラン イアン、戻ってきて、大丈夫、オン"}, {"type": "subtitle", "time": 489.909, "timestamp": "00:08:09", "text": "もしあなたが望むなら、私はこれを持つことができます"}, {"type": "subtitle", "time": 491.189, "timestamp": "00:08:11", "text": "そのフィード"}, {"type": "subtitle", "time": 494.309, "timestamp": "00:08:14", "text": "私がこれを設定しました"}, {"type": "subtitle", "time": 498.39, "timestamp": "00:08:18", "text": "うん、わかった、他に選択肢はない、と書いてある"}, {"type": "subtitle", "time": 500.99, "timestamp": "00:08:20", "text": "このチャンネルではストリーミングできません。あ、待って"}, {"type": "subtitle", "time": 503.07, "timestamp": "00:08:23", "text": "待って待って、直します、直します"}, {"type": "subtitle", "time": 506.749, "timestamp": "00:08:26", "text": "2つ目、忘れてた"}, {"type": "subtitle", "time": 525.829, "timestamp": "00:08:45", "text": "その間、私はリンクを共有します"}, {"type": "subtitle", "time": 527.35, "timestamp": "00:08:47", "text": "これです"}]
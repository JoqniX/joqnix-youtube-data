[{"type": "subtitle", "time": 19209.23, "timestamp": "05:20:09", "text": "ここでやっていること"}, {"type": "subtitle", "time": 19215.35, "timestamp": "05:20:15", "text": "行う"}, {"type": "subtitle", "time": 19230.35, "timestamp": "05:20:30", "text": "わかったよ、行くよ。"}, {"type": "subtitle", "time": 19236.868, "timestamp": "05:20:36", "text": "彼が私をブロックしようとしたので、変更しました。いいえ、いいえ、いいえ。"}, {"type": "subtitle", "time": 19240.07, "timestamp": "05:20:40", "text": "いやいやいや"}, {"type": "subtitle", "time": 19241.35, "timestamp": "05:20:41", "text": "ああ、私は"}, {"type": "subtitle", "time": 19244.948, "timestamp": "05:20:44", "text": "死んでも、せめて君を連れて行くよ"}, {"type": "subtitle", "time": 19247.75, "timestamp": "05:20:47", "text": "あなたはただその車に乗り込む"}, {"type": "subtitle", "time": 19249.19, "timestamp": "05:20:49", "text": "ランダム"}]
[{"type": "subtitle", "time": 5160.35, "timestamp": "01:26:00", "text": "再び"}, {"type": "subtitle", "time": 5162.669, "timestamp": "01:26:02", "text": "またもやとても役に立つよ、ジョー、こっちに来て"}, {"type": "subtitle", "time": 5164.83, "timestamp": "01:26:04", "text": "これらを殺せ"}, {"type": "subtitle", "time": 5167.27, "timestamp": "01:26:07", "text": "人々、この人たち、ああ、待って、やめて、やめて"}, {"type": "subtitle", "time": 5177.03, "timestamp": "01:26:17", "text": "ローウィ、気にしないで、彼らは"}, {"type": "subtitle", "time": 5179.95, "timestamp": "01:26:19", "text": "NPC ああ、私は"}, {"type": "subtitle", "time": 5183.03, "timestamp": "01:26:23", "text": "敵 いやいやいやいやいやいや 実際の敵"}, {"type": "subtitle", "time": 5184.91, "timestamp": "01:26:24", "text": "敵は"}, {"type": "subtitle", "time": 5188.189, "timestamp": "01:26:28", "text": "ああ、いや、ああ、あそこ、なぜ彼らは行くの？"}, {"type": "subtitle", "time": 5189.55, "timestamp": "01:26:29", "text": "ゾーンの外だとちょっと変だ"}, {"type": "subtitle", "time": 5191.79, "timestamp": "01:26:31", "text": "ここに来て、ここに隠れて"}, {"type": "subtitle", "time": 5195.149, "timestamp": "01:26:35", "text": "オーケー、健康に良い"}, {"type": "subtitle", "time": 5197.83, "timestamp": "01:26:37", "text": "ありがとう。そう、シールドももらえるよ。"}, {"type": "subtitle", "time": 5199.55, "timestamp": "01:26:39", "text": "一体なぜ敵は外に出たのか"}, {"type": "subtitle", "time": 5202.27, "timestamp": "01:26:42", "text": "奇妙なゾーンで彼らは何をしているのでしょうか"}, {"type": "subtitle", "time": 5204.109, "timestamp": "01:26:44", "text": "タスクとして"}, {"type": "subtitle", "time": 5207.709, "timestamp": "01:26:47", "text": "さて、もう終わりかな？彼は疲れているのかな？"}, {"type": "subtitle", "time": 5210.47, "timestamp": "01:26:50", "text": "わかった、彼はそうだ、7時まで待つ必要がある"}, {"type": "subtitle", "time": 5211.91, "timestamp": "01:26:51", "text": "数秒後にまた使用します"}, {"type": "subtitle", "time": 5214.91, "timestamp": "01:26:54", "text": "その前に天気予報士を殺そう"}, {"type": "subtitle", "time": 5216.31, "timestamp": "01:26:56", "text": "ああ、"}]
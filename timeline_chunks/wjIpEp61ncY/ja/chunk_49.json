[{"type": "subtitle", "time": 2941.63, "timestamp": "00:49:01", "text": "どこかで、ああ、こっちで手に入れたよ、ああ、３つ"}, {"type": "subtitle", "time": 2942.349, "timestamp": "00:49:02", "text": "の"}, {"type": "subtitle", "time": 2944.789, "timestamp": "00:49:04", "text": "彼らに私は最後のものを手に入れている"}, {"type": "subtitle", "time": 2947.23, "timestamp": "00:49:07", "text": "1つ"}, {"type": "subtitle", "time": 2950.87, "timestamp": "00:49:10", "text": "いいですね、手に入れます"}, {"type": "subtitle", "time": 2964.47, "timestamp": "00:49:24", "text": "信号チェック"}, {"type": "subtitle", "time": 2968.589, "timestamp": "00:49:28", "text": "あなたの、これは"}, {"type": "subtitle", "time": 2970.87, "timestamp": "00:49:30", "text": "DFTOK"}, {"type": "subtitle", "time": 2973.549, "timestamp": "00:49:33", "text": "わかった、あなたは"}, {"type": "subtitle", "time": 2977.43, "timestamp": "00:49:37", "text": "ミニシールドのようなものをお持ちですか？"}, {"type": "subtitle", "time": 2979.39, "timestamp": "00:49:39", "text": "の上"}, {"type": "subtitle", "time": 2982.19, "timestamp": "00:49:42", "text": "うん、わかった。ごめん、あなたの"}, {"type": "subtitle", "time": 2984.069, "timestamp": "00:49:44", "text": "シールド"}, {"type": "subtitle", "time": 2985.58, "timestamp": "00:49:45", "text": "ああ、ありがとう"}, {"type": "subtitle", "time": 2987.829, "timestamp": "00:49:47", "text": "[音楽]"}, {"type": "subtitle", "time": 2992.75, "timestamp": "00:49:52", "text": "あなたが望むなら、これらを受け取ってもいいですよ。"}]
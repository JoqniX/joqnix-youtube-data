[{"type": "subtitle", "time": 20830.868, "timestamp": "05:47:10", "text": "もう1ゲームだけプレイします。なぜ"}, {"type": "subtitle", "time": 20847.91, "timestamp": "05:47:27", "text": "プレイ中、本当に頑張っています"}, {"type": "subtitle", "time": 20850.31, "timestamp": "05:47:30", "text": "だから、私があなたに教えることは"}, {"type": "subtitle", "time": 20852.19, "timestamp": "05:47:32", "text": "これから起こること"}, {"type": "subtitle", "time": 20853.99, "timestamp": "05:47:33", "text": "明日"}, {"type": "subtitle", "time": 20856.548, "timestamp": "05:47:36", "text": "多分すごく疲れるだろう"}, {"type": "subtitle", "time": 20859.39, "timestamp": "05:47:39", "text": "眠くて寝て、明日は何もかも"}, {"type": "subtitle", "time": 20862.91, "timestamp": "05:47:42", "text": "ええと、その日をやり直さなければならないとき"}, {"type": "subtitle", "time": 20864.83, "timestamp": "05:47:44", "text": "11"}, {"type": "subtitle", "time": 20869.948, "timestamp": "05:47:49", "text": "土曜日の午前9時に配信します。"}, {"type": "subtitle", "time": 20873.31, "timestamp": "05:47:53", "text": "ああ、すごく疲れた、心は死んでる、私は"}, {"type": "subtitle", "time": 20876.91, "timestamp": "05:47:56", "text": "もっと寝るよ、そしたらまた来るよ"}]
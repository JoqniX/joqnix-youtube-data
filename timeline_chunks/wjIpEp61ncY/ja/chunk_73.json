[{"type": "subtitle", "time": 4380.629, "timestamp": "01:13:00", "text": "私はその部分を引き受けます"}, {"type": "subtitle", "time": 4383.95, "timestamp": "01:13:03", "text": "コイン地獄"}, {"type": "subtitle", "time": 4387.03, "timestamp": "01:13:07", "text": "そうそう、もし死んだらドロップするよ"}, {"type": "subtitle", "time": 4388.669, "timestamp": "01:13:08", "text": "彼ら"}, {"type": "subtitle", "time": 4391.149, "timestamp": "01:13:11", "text": "うん、だから、ほら、"}, {"type": "subtitle", "time": 4394.149, "timestamp": "01:13:14", "text": "マーケットのようなところに行くけど、もし"}, {"type": "subtitle", "time": 4396.11, "timestamp": "01:13:16", "text": "俺たちは行く、奴らは俺たちを殺すつもりだ、なぜなら"}, {"type": "subtitle", "time": 4403.87, "timestamp": "01:13:23", "text": "キング、待って、それは"}, {"type": "subtitle", "time": 4406.59, "timestamp": "01:13:26", "text": "敵、ああ、それは"}, {"type": "subtitle", "time": 4415.75, "timestamp": "01:13:35", "text": "ああ、彼らは掘り下げることができない、彼らは愚かだ"}, {"type": "subtitle", "time": 4418.03, "timestamp": "01:13:38", "text": "ああ、それはあなたじゃない"}, {"type": "subtitle", "time": 4421.27, "timestamp": "01:13:41", "text": "それは人である"}, {"type": "subtitle", "time": 4424.07, "timestamp": "01:13:44", "text": "うんうんうん、でも君の声が聞こえたよ"}, {"type": "subtitle", "time": 4425.51, "timestamp": "01:13:45", "text": "つるはしを使って、"}, {"type": "subtitle", "time": 4427.47, "timestamp": "01:13:47", "text": "実際の"}, {"type": "subtitle", "time": 4429.99, "timestamp": "01:13:49", "text": "ここで掘り起こそうとする人は愚かだ"}, {"type": "subtitle", "time": 4433.75, "timestamp": "01:13:53", "text": "だって私たちはVAの中にいるから"}, {"type": "subtitle", "time": 4436.31, "timestamp": "01:13:56", "text": "うんうん、キャンプの時間だよ、あ、彼が見える"}]
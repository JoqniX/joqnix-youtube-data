[{"type": "subtitle", "time": 5583.149, "timestamp": "01:33:03", "text": "まさにその通りです。SNから行きます"}, {"type": "subtitle", "time": 5586.229, "timestamp": "01:33:06", "text": "ここだけど気をつけて、私たちは"}, {"type": "subtitle", "time": 5589.629, "timestamp": "01:33:09", "text": "戻るよ、うん、俺が俺たちの背後を守るから、お前も"}, {"type": "subtitle", "time": 5592.31, "timestamp": "01:33:12", "text": "またこれですね、私には見えません"}, {"type": "subtitle", "time": 5594.83, "timestamp": "01:33:14", "text": "誰かがここで死んだ。新鮮な死体。"}, {"type": "subtitle", "time": 5598.59, "timestamp": "01:33:18", "text": "ここで新鮮な死体を見た"}, {"type": "subtitle", "time": 5601.629, "timestamp": "01:33:21", "text": "消える ちょっと待って する する する する"}, {"type": "subtitle", "time": 5603.83, "timestamp": "01:33:23", "text": "設定に移動すると、そのクソみたいなことは起こらない"}, {"type": "subtitle", "time": 5607.59, "timestamp": "01:33:27", "text": "燃料を持ってるよ、行かないで、いやいやいやいや"}, {"type": "subtitle", "time": 5610.47, "timestamp": "01:33:30", "text": "私はここにいます、私はここにいます、ええと、私はただ"}, {"type": "subtitle", "time": 5612.83, "timestamp": "01:33:32", "text": "視界距離をエピックにするために必要"}, {"type": "subtitle", "time": 5619.79, "timestamp": "01:33:39", "text": "明らかに何も表示されていない"}, {"type": "subtitle", "time": 5622.31, "timestamp": "01:33:42", "text": "取るべきではなかった、取るべきだった"}, {"type": "subtitle", "time": 5629.35, "timestamp": "01:33:49", "text": "スナイパー"}, {"type": "subtitle", "time": 5632.47, "timestamp": "01:33:52", "text": "いいえ、私は臭い"}, {"type": "subtitle", "time": 5635.99, "timestamp": "01:33:55", "text": "あれ、ドラガーがここにいるよ、こんにちはドラガー"}, {"type": "subtitle", "time": 5637.83, "timestamp": "01:33:57", "text": "いらっしゃいませ"}]
[{"type": "subtitle", "time": 3360.029, "timestamp": "00:56:00", "text": "なぜか分かるだろ、俺が行ったところではみんな"}, {"type": "subtitle", "time": 3364.15, "timestamp": "00:56:04", "text": "キャベツを食べさせてもらった私たちは、"}, {"type": "subtitle", "time": 3367.309, "timestamp": "00:56:07", "text": "キャベツを育てながら、"}, {"type": "subtitle", "time": 3368.71, "timestamp": "00:56:08", "text": "キャベツ"}, {"type": "chat", "time": 3369.641, "timestamp": "00:56:09", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "more like a tomato"}, {"type": "subtitle", "time": 3371.589, "timestamp": "00:56:11", "text": "CH 心配しないで、私とあなた"}, {"type": "chat", "time": 3372.968, "timestamp": "00:56:12", "author": "@Hero_338", "avatar": "https://yt4.ggpht.com/0uNlIhqsigPTN5hDlTHiX6E1xHNJL_TKrsEvxszwXL5t9cJLNqnfZ0L6Wz1pkyw3Fb-F_l4e=s64-c-k-c0x00ffffff-no-rj", "message": "HAHAHAH"}, {"type": "chat", "time": 3379.522, "timestamp": "00:56:19", "author": "@Hero_338", "avatar": "https://yt4.ggpht.com/0uNlIhqsigPTN5hDlTHiX6E1xHNJL_TKrsEvxszwXL5t9cJLNqnfZ0L6Wz1pkyw3Fb-F_l4e=s64-c-k-c0x00ffffff-no-rj", "message": "CABBAGE "}, {"type": "subtitle", "time": 3384.23, "timestamp": "00:56:24", "text": "それはどちらかというとトマトに近い"}, {"type": "subtitle", "time": 3387.109, "timestamp": "00:56:27", "text": "はあ、大丈夫だよ。チャドは私を何と呼んだか。"}, {"type": "subtitle", "time": 3391.43, "timestamp": "00:56:31", "text": "あなたが望むならそれでいい、理由はわかるでしょ、だって私の"}, {"type": "subtitle", "time": 3393.47, "timestamp": "00:56:33", "text": "人生でたくさんのことを聞いてきた"}, {"type": "subtitle", "time": 3394.95, "timestamp": "00:56:34", "text": "私の声について"}, {"type": "subtitle", "time": 3403.27, "timestamp": "00:56:43", "text": "もうボスはここにいると思う"}, {"type": "subtitle", "time": 3407.069, "timestamp": "00:56:47", "text": "彼がどこへ行くのか、"}, {"type": "subtitle", "time": 3411.309, "timestamp": "00:56:51", "text": "ボス、もし私の声が聞こえるなら、ジョー、あなたに"}, {"type": "subtitle", "time": 3418.67, "timestamp": "00:56:58", "text": "だって、絶対にそこには行かないから。"}]
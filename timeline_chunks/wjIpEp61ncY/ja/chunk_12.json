[{"type": "subtitle", "time": 722.11, "timestamp": "00:12:02", "text": "よし、これをくれ"}, {"type": "subtitle", "time": 723.75, "timestamp": "00:12:03", "text": "1つ"}, {"type": "subtitle", "time": 731.069, "timestamp": "00:12:11", "text": "決定的な"}, {"type": "subtitle", "time": 733.71, "timestamp": "00:12:13", "text": "待って、やばい、CH に入れる"}, {"type": "subtitle", "time": 738.43, "timestamp": "00:12:18", "text": "くそ、俺はただ"}, {"type": "subtitle", "time": 742.11, "timestamp": "00:12:22", "text": "ストリーマーモードがオンになっていることに気づいた"}, {"type": "subtitle", "time": 744.55, "timestamp": "00:12:24", "text": "危なかったよ"}, {"type": "subtitle", "time": 760.069, "timestamp": "00:12:40", "text": "戻って、ストリーマーモードをオンにしました。神に感謝します。"}, {"type": "subtitle", "time": 761.949, "timestamp": "00:12:41", "text": "今気づいた、そうでなければ"}, {"type": "subtitle", "time": 763.55, "timestamp": "00:12:43", "text": "彼を困らせたよ、どこだ"}, {"type": "subtitle", "time": 766.43, "timestamp": "00:12:46", "text": "ストリーマーモード ああ、無理だ"}, {"type": "subtitle", "time": 768.829, "timestamp": "00:12:48", "text": "えーっと、どうすればいいの？どうすればいいの？"}, {"type": "subtitle", "time": 769.829, "timestamp": "00:12:49", "text": "は"}]
[{"type": "subtitle", "time": 5701.669, "timestamp": "01:35:01", "text": "ああ、わかった、彼らは戦っている、彼らに任せよう"}, {"type": "subtitle", "time": 5708.629, "timestamp": "01:35:08", "text": "他にシールドや何か必要なものがあるの？ああ、"}, {"type": "subtitle", "time": 5710.629, "timestamp": "01:35:10", "text": "彼らは互いに押し合っている"}, {"type": "subtitle", "time": 5713.59, "timestamp": "01:35:13", "text": "他の人はクソ野郎だ、あいつは"}, {"type": "subtitle", "time": 5716.64, "timestamp": "01:35:16", "text": "死んでるなんてありえない"}, {"type": "subtitle", "time": 5724.43, "timestamp": "01:35:24", "text": "生きている、ああ神様"}, {"type": "subtitle", "time": 5727.07, "timestamp": "01:35:27", "text": "ここの人たちについてはよくわからないけど"}, {"type": "subtitle", "time": 5728.83, "timestamp": "01:35:28", "text": "私たちはまだそこにいます"}, {"type": "subtitle", "time": 5732.43, "timestamp": "01:35:32", "text": "ゾーン、ああ、まだゾーンの中にいるよ、そうだね"}, {"type": "subtitle", "time": 5735.109, "timestamp": "01:35:35", "text": "よし、私たちが"}, {"type": "subtitle", "time": 5740.189, "timestamp": "01:35:40", "text": "[拍手]"}, {"type": "subtitle", "time": 5748.31, "timestamp": "01:35:48", "text": "残り5チームが有利"}, {"type": "subtitle", "time": 5749.31, "timestamp": "01:35:49", "text": "五"}, {"type": "subtitle", "time": 5751.83, "timestamp": "01:35:51", "text": "デュオというよりは5チームくらいかな、よくわからないけど。"}, {"type": "subtitle", "time": 5758.43, "timestamp": "01:35:58", "text": "しかし8人"}]
[{"type": "subtitle", "time": 5882.51, "timestamp": "01:38:02", "text": "私のHブルータス機関銃はとても近いので、"}, {"type": "subtitle", "time": 5884.43, "timestamp": "01:38:04", "text": "俺が本当に欲しい銃、手に入れられるか？"}, {"type": "subtitle", "time": 5886.43, "timestamp": "01:38:06", "text": "あれはまるでオーディンのようだ"}, {"type": "subtitle", "time": 5889.47, "timestamp": "01:38:09", "text": "そんなの欲しい"}, {"type": "subtitle", "time": 5893.91, "timestamp": "01:38:13", "text": "2番目はGGからどこにあるのか"}, {"type": "subtitle", "time": 5898.43, "timestamp": "01:38:18", "text": "まさにその通り、私は44,000を手に入れました"}, {"type": "subtitle", "time": 5899.99, "timestamp": "01:38:19", "text": "XP、君はどう思う？私たちは行くべきだと思う。"}, {"type": "subtitle", "time": 5903.55, "timestamp": "01:38:23", "text": "ロビー活動や、いろいろなものを集めるために"}, {"type": "subtitle", "time": 5904.229, "timestamp": "01:38:24", "text": "私たちは"}, {"type": "subtitle", "time": 5907.75, "timestamp": "01:38:27", "text": "手に入れたと思う、待って、どうやって見るの？"}, {"type": "subtitle", "time": 5909.51, "timestamp": "01:38:29", "text": "H"}, {"type": "subtitle", "time": 5912.189, "timestamp": "01:38:32", "text": "XP ああ、私たちが青い世界にいることを知っているとき"}, {"type": "subtitle", "time": 5915.35, "timestamp": "01:38:35", "text": "画面、ああ、君が手に入れたのがわかるよ"}, {"type": "subtitle", "time": 5917.87, "timestamp": "01:38:37", "text": "16500 いいえ、"}, {"type": "subtitle", "time": 5921.55, "timestamp": "01:38:41", "text": "165,000 うん、わかった、わかった、今見たよ"}, {"type": "subtitle", "time": 5924.709, "timestamp": "01:38:44", "text": "画面なので、読む前に読む"}, {"type": "subtitle", "time": 5926.47, "timestamp": "01:38:46", "text": "これは、あなたがどれだけの経験値を得たかを示しています。"}, {"type": "subtitle", "time": 5929.07, "timestamp": "01:38:49", "text": "どんなクエストで、云々"}, {"type": "subtitle", "time": 5939.75, "timestamp": "01:38:59", "text": "今日は何日ですか？21日です。わかりました。"}]
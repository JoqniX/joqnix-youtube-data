[{"type": "subtitle", "time": 301.23, "timestamp": "00:05:01", "text": "でも、どうしてこれにrangを入れたのか理解できない"}, {"type": "subtitle", "time": 303.35, "timestamp": "00:05:03", "text": "警官がいるような感じで"}, {"type": "subtitle", "time": 309.71, "timestamp": "00:05:09", "text": "まるで、どうして彼らが「まるで」という表現を使うのか理解できない"}, {"type": "subtitle", "time": 312.35, "timestamp": "00:05:12", "text": "これらのゲームの範囲"}, {"type": "subtitle", "time": 316.07, "timestamp": "00:05:16", "text": "モードはクールですね、ちょっとクレイジーな"}, {"type": "subtitle", "time": 317.79, "timestamp": "00:05:17", "text": "高ランクの人たちとプレイすると"}, {"type": "subtitle", "time": 319.87, "timestamp": "00:05:19", "text": "おかしい、とても不公平に感じる、あなたは望んでいない"}, {"type": "subtitle", "time": 324.11, "timestamp": "00:05:24", "text": "もうプレイしない、そう、私はそうだった"}, {"type": "subtitle", "time": 327.23, "timestamp": "00:05:27", "text": "それが実際に私にプレイしたくなった"}, {"type": "subtitle", "time": 330.95, "timestamp": "00:05:30", "text": "バトルロイヤルはボットが登場するから"}, {"type": "subtitle", "time": 333.79, "timestamp": "00:05:33", "text": "ああ、私はBSを殺したいのであって、これらを殺したいわけではない"}, {"type": "subtitle", "time": 336.189, "timestamp": "00:05:36", "text": "非現実的な人々と現実が最高"}, {"type": "subtitle", "time": 338.55, "timestamp": "00:05:38", "text": "このゲームでのランクは、"}, {"type": "subtitle", "time": 342.51, "timestamp": "00:05:42", "text": "えーっと、最高ランクは"}, {"type": "subtitle", "time": 344.67, "timestamp": "00:05:44", "text": "Val I で"}, {"type": "subtitle", "time": 347.189, "timestamp": "00:05:47", "text": "忘れたよ、君が何を言いたかったか分かるよね"}, {"type": "subtitle", "time": 349.51, "timestamp": "00:05:49", "text": "とにかく、私はゲーム中なので、私の様子を見ることができます。"}, {"type": "subtitle", "time": 351.909, "timestamp": "00:05:51", "text": "視聴はまだできません"}, {"type": "subtitle", "time": 353.35, "timestamp": "00:05:53", "text": "マッチ"}, {"type": "subtitle", "time": 356.11, "timestamp": "00:05:56", "text": "わあ、たぶんまだゲームに参加してないからかな"}, {"type": "subtitle", "time": 358.67, "timestamp": "00:05:58", "text": "わからない、心配しないで、私は"}]
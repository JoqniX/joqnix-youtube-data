[{"type": "subtitle", "time": 3963.47, "timestamp": "01:06:03", "text": "前に、つまり私の前に、ええ、そうですね"}, {"type": "subtitle", "time": 3971.349, "timestamp": "01:06:11", "text": "私は胸に気を取られて"}, {"type": "subtitle", "time": 3980.23, "timestamp": "01:06:20", "text": "ああ、それは"}, {"type": "subtitle", "time": 3984.15, "timestamp": "01:06:24", "text": "わかった、なぜ隣にいるあの肌が見えるの？"}, {"type": "subtitle", "time": 3987.23, "timestamp": "01:06:27", "text": "えーと、ドゥーム、ああ、これ、これ"}, {"type": "subtitle", "time": 3989.47, "timestamp": "01:06:29", "text": "うん、これはかなり古いよね"}, {"type": "subtitle", "time": 3992.109, "timestamp": "01:06:32", "text": "我々はその辺りで遊び始めたと思う"}, {"type": "subtitle", "time": 3996.19, "timestamp": "01:06:36", "text": "時間か、それとも何かを買う必要があるか"}, {"type": "chat", "time": 3997.212, "timestamp": "01:06:37", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "herro"}, {"type": "subtitle", "time": 3997.71, "timestamp": "01:06:37", "text": "右"}, {"type": "subtitle", "time": 4001.029, "timestamp": "01:06:41", "text": "じゃあ、ここに行こう。誰もいないことを願うよ。"}, {"type": "subtitle", "time": 4003.029, "timestamp": "01:06:43", "text": "我々より先にそこへ来るだろう、そして私は誓う"}, {"type": "subtitle", "time": 4004.51, "timestamp": "01:06:44", "text": "神様、もし私が兄より先にそこに着いたら"}, {"type": "subtitle", "time": 4006.19, "timestamp": "01:06:46", "text": "キャンプ"}, {"type": "subtitle", "time": 4019.589, "timestamp": "01:06:59", "text": "また、私は夕食を食べています。"}]
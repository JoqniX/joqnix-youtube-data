[{"type": "subtitle", "time": 2701.069, "timestamp": "00:45:01", "text": "どうやって追加するのか、どうやって追加するのか、全くわからない"}, {"type": "subtitle", "time": 2703.03, "timestamp": "00:45:03", "text": "手動で広告を出すのは、"}, {"type": "subtitle", "time": 2705.63, "timestamp": "00:45:05", "text": "十分です。追加しながらAFKしたいです。"}, {"type": "subtitle", "time": 2707.27, "timestamp": "00:45:07", "text": "少なくとも広告を見せながら"}, {"type": "subtitle", "time": 2710.349, "timestamp": "00:45:10", "text": "見るものにはなるけど、そうじゃない"}, {"type": "subtitle", "time": 2714.829, "timestamp": "00:45:14", "text": "そうやって仕事をして、今彼らはやり遂げたんだ。"}, {"type": "subtitle", "time": 2717.03, "timestamp": "00:45:17", "text": "今日気づいたんだけど、"}, {"type": "subtitle", "time": 2719.91, "timestamp": "00:45:19", "text": "昨日の前の日にそこにいた、うん、私はこう思った"}, {"type": "subtitle", "time": 2722.349, "timestamp": "00:45:22", "text": "待って、私は収益化すらしていないのに、どうして"}, {"type": "subtitle", "time": 2729.15, "timestamp": "00:45:29", "text": "ちなみに、私は今これを手に入れました"}, {"type": "subtitle", "time": 2731.829, "timestamp": "00:45:31", "text": "いいですね、卵チャーハンを食べています"}, {"type": "subtitle", "time": 2734.75, "timestamp": "00:45:34", "text": "卵が嫌い"}, {"type": "subtitle", "time": 2738.15, "timestamp": "00:45:38", "text": "えっと、いい感じ"}, {"type": "subtitle", "time": 2740.829, "timestamp": "00:45:40", "text": "夕食のジョーは10日間配信を続けている"}, {"type": "chat", "time": 2741.027, "timestamp": "00:45:41", "author": "@Astro-9999", "avatar": "https://yt4.ggpht.com/I0atDf8aJGAiY3Z-U4COpBQFW4_qYnJ5GkhRqDK8dE_sjbhzV3NcVv5LuXD4hdY7IHeyOXW2OQ=s64-c-k-c0x00ffffff-no-rj", "message": "\"i hv premium nd add blocker so i dont see add anyway\" "}, {"type": "subtitle", "time": 2744.63, "timestamp": "00:45:44", "text": "ジョーは本当に素晴らしい。うん、彼は"}, {"type": "subtitle", "time": 2747.349, "timestamp": "00:45:47", "text": "私は見ていない"}, {"type": "subtitle", "time": 2750.67, "timestamp": "00:45:50", "text": "実際、映画はそうですね"}, {"type": "subtitle", "time": 2752.87, "timestamp": "00:45:52", "text": "さあ、行こう"}, {"type": "subtitle", "time": 2755.95, "timestamp": "00:45:55", "text": "前方に、外は雨が降っている。"}, {"type": "subtitle", "time": 2758.069, "timestamp": "00:45:58", "text": "カットが行われた時に何が起こったか分かる"}]
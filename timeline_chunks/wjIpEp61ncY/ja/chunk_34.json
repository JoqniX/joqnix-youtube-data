[{"type": "subtitle", "time": 2042.11, "timestamp": "00:34:02", "text": "魚のカレー？どんな魚？"}, {"type": "subtitle", "time": 2045.909, "timestamp": "00:34:05", "text": "カレー、あの赤いやつ"}, {"type": "subtitle", "time": 2048.51, "timestamp": "00:34:08", "text": "水っぽいスパイシー"}, {"type": "subtitle", "time": 2051.909, "timestamp": "00:34:11", "text": "1匹はどんな魚だったか忘れてしまった"}, {"type": "subtitle", "time": 2055.829, "timestamp": "00:34:15", "text": "大丈夫ですか、あなたはそうしません、あなたはそうしません"}, {"type": "subtitle", "time": 2059.19, "timestamp": "00:34:19", "text": "ほとんどのヒンディー料理の名前は知っている"}, {"type": "subtitle", "time": 2062.19, "timestamp": "00:34:22", "text": "はい、つまりヒンディー語のインド料理のことではありません"}, {"type": "subtitle", "time": 2064.829, "timestamp": "00:34:24", "text": "はい、覚えています、あなたは何が起こっているのか全く知りませんでした"}, {"type": "subtitle", "time": 2066.23, "timestamp": "00:34:26", "text": "パン"}, {"type": "subtitle", "time": 2068.669, "timestamp": "00:34:28", "text": "何かね"}, {"type": "subtitle", "time": 2070.829, "timestamp": "00:34:30", "text": "この男はどうやって"}, {"type": "subtitle", "time": 2072.31, "timestamp": "00:34:32", "text": "インド人"}, {"type": "subtitle", "time": 2075.99, "timestamp": "00:34:35", "text": "YouTuberはフライパンが何なのか知らない"}, {"type": "subtitle", "time": 2078.069, "timestamp": "00:34:38", "text": "ご飯は何を食べているの？"}, {"type": "subtitle", "time": 2080.069, "timestamp": "00:34:40", "text": "あなたをフィーチャー"}, {"type": "subtitle", "time": 2084.71, "timestamp": "00:34:44", "text": "家でクレイジー、ただ普通、古き良き"}, {"type": "subtitle", "time": 2087.869, "timestamp": "00:34:47", "text": "米、それは本当のはずがない"}, {"type": "subtitle", "time": 2092.43, "timestamp": "00:34:52", "text": "パニールやバスティライスが何かわかりません"}, {"type": "subtitle", "time": 2094.99, "timestamp": "00:34:54", "text": "他に何があったっけ？ああ、パンがあったな"}, {"type": "subtitle", "time": 2098.75, "timestamp": "00:34:58", "text": "そうですね、それもそうですね。"}]
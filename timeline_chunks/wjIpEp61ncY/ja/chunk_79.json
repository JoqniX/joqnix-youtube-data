[{"type": "subtitle", "time": 4741.51, "timestamp": "01:19:01", "text": "私が戦う場所"}, {"type": "subtitle", "time": 4769.91, "timestamp": "01:19:29", "text": "[音楽]"}, {"type": "subtitle", "time": 4771.51, "timestamp": "01:19:31", "text": "うん、あれは"}, {"type": "subtitle", "time": 4776.149, "timestamp": "01:19:36", "text": "BS うんうん、言った"}, {"type": "subtitle", "time": 4780.87, "timestamp": "01:19:40", "text": "あなた、私、人々は"}, {"type": "subtitle", "time": 4783.629, "timestamp": "01:19:43", "text": "ここから銃を買うことは絶対に許されない"}, {"type": "subtitle", "time": 4786.79, "timestamp": "01:19:46", "text": "しかし、あなたは与える必要がある"}, {"type": "subtitle", "time": 4789.35, "timestamp": "01:19:49", "text": "税金、あ、タグを見たい"}, {"type": "subtitle", "time": 4792.51, "timestamp": "01:19:52", "text": "あれ、そうだよ、タグをあげるんだね"}]
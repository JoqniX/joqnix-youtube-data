[{"type": "subtitle", "time": 1446.909, "timestamp": "00:24:06", "text": "オーケーよ、どうしたの？どうしたの？"}, {"type": "subtitle", "time": 1449.549, "timestamp": "00:24:09", "text": "ようこそ"}, {"type": "subtitle", "time": 1453.11, "timestamp": "00:24:13", "text": "ストリーム 私はこのチャンネルの所有者ではありません"}, {"type": "subtitle", "time": 1455.669, "timestamp": "00:24:15", "text": "でも私はゲストです"}, {"type": "subtitle", "time": 1459.59, "timestamp": "00:24:19", "text": "どうやら、そして左に行く"}, {"type": "subtitle", "time": 1462.149, "timestamp": "00:24:22", "text": "夕食に彼は外に出た、うん、彼は"}, {"type": "subtitle", "time": 1464.87, "timestamp": "00:24:24", "text": "文字通り、あなたたち全員に"}, {"type": "subtitle", "time": 1467.789, "timestamp": "00:24:27", "text": "私と私は楽しませるためにここにいます 楽しませるために"}, {"type": "subtitle", "time": 1471.83, "timestamp": "00:24:31", "text": "皆さん、お会いできて嬉しいです。"}, {"type": "subtitle", "time": 1475.07, "timestamp": "00:24:35", "text": "私をゲストと呼んでください。私は宣伝するためにここにいるのではありません。"}, {"type": "subtitle", "time": 1483.11, "timestamp": "00:24:43", "text": "ああ、しまった、これを飲んでおけばよかった"}, {"type": "subtitle", "time": 1486.95, "timestamp": "00:24:46", "text": "まず、私は支払いません"}, {"type": "subtitle", "time": 1489.83, "timestamp": "00:24:49", "text": "注目、おお、ゲスト、私もゲスト、あなたも"}, {"type": "subtitle", "time": 1491.789, "timestamp": "00:24:51", "text": "地獄へようこそ"}, {"type": "subtitle", "time": 1495.51, "timestamp": "00:24:55", "text": "はい、ストリームゲストへようこそ。"}, {"type": "subtitle", "time": 1498.87, "timestamp": "00:24:58", "text": "ゲームをプレイしている別のゲスト"}]
[{"type": "subtitle", "time": 421.95, "timestamp": "00:07:01", "text": "[音楽]"}, {"type": "subtitle", "time": 424.35, "timestamp": "00:07:04", "text": "はい、参加しました"}, {"type": "subtitle", "time": 426.869, "timestamp": "00:07:06", "text": "すると、次のようなオプションが表示されますか？"}, {"type": "subtitle", "time": 429.189, "timestamp": "00:07:09", "text": "見ない、見ない、それは、見ることは"}, {"type": "subtitle", "time": 432.589, "timestamp": "00:07:12", "text": "まだ利用可能ではないので、あなたがプレイしているものかもしれません"}, {"type": "subtitle", "time": 436.029, "timestamp": "00:07:16", "text": "ゼロビルドなら、なぜそうではないのか"}, {"type": "subtitle", "time": 439.189, "timestamp": "00:07:19", "text": "まだ着陸していないので、"}, {"type": "subtitle", "time": 441.35, "timestamp": "00:07:21", "text": "そうでないなら、なぜ私が"}, {"type": "subtitle", "time": 442.589, "timestamp": "00:07:22", "text": "理由はわからない"}, {"type": "subtitle", "time": 446.43, "timestamp": "00:07:26", "text": "そうでなければ、まだ着陸していないのに、ええ、"}, {"type": "subtitle", "time": 448.79, "timestamp": "00:07:28", "text": "着陸したよ、よし、待って、私が出て行くから"}, {"type": "subtitle", "time": 453.749, "timestamp": "00:07:33", "text": "これは"}, {"type": "subtitle", "time": 456.629, "timestamp": "00:07:36", "text": "変だね、わからない、どうしてかわからない"}, {"type": "subtitle", "time": 458.71, "timestamp": "00:07:38", "text": "うまくいきますか、私は参加しました"}, {"type": "subtitle", "time": 460.35, "timestamp": "00:07:40", "text": "兄弟のロビーで利用可能です"}, {"type": "subtitle", "time": 462.67, "timestamp": "00:07:42", "text": "私には通常見ないと書いてあります"}, {"type": "subtitle", "time": 465.189, "timestamp": "00:07:45", "text": "利用不可"}, {"type": "subtitle", "time": 467.029, "timestamp": "00:07:47", "text": "なぜそれが"}, {"type": "subtitle", "time": 478.43, "timestamp": "00:07:58", "text": "何でも、ああ、私は残します"}]
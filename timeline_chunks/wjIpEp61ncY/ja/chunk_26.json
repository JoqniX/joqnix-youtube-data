[{"type": "subtitle", "time": 1579.23, "timestamp": "00:26:19", "text": "一体何なんだこれは"}, {"type": "subtitle", "time": 1590.47, "timestamp": "00:26:30", "text": "そこで彼は私を見て、これをできますか"}, {"type": "subtitle", "time": 1592.669, "timestamp": "00:26:32", "text": "たとえそれがボットであっても、"}, {"type": "subtitle", "time": 1596.87, "timestamp": "00:26:36", "text": "ボットはここにいません、ボットではありません、いいですね、あなた"}, {"type": "subtitle", "time": 1600.75, "timestamp": "00:26:40", "text": "ミクミク ハトゥン ネギ"}, {"type": "subtitle", "time": 1602.11, "timestamp": "00:26:42", "text": "もちろんだ"}, {"type": "subtitle", "time": 1606.31, "timestamp": "00:26:46", "text": "待って、スキンを変えるから待って"}, {"type": "subtitle", "time": 1611.75, "timestamp": "00:26:51", "text": "行く"}, {"type": "subtitle", "time": 1616.23, "timestamp": "00:26:56", "text": "えーっと、ここを見て、わかった、わかった、私は"}]
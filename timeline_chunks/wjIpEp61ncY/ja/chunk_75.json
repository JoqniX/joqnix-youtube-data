[{"type": "subtitle", "time": 4503.95, "timestamp": "01:15:03", "text": "まさに私のビットコインが私のゲームに参加します"}, {"type": "subtitle", "time": 4511.11, "timestamp": "01:15:11", "text": "ゴーなし"}, {"type": "subtitle", "time": 4517.87, "timestamp": "01:15:17", "text": "うん、地図上で君が飛んでいるのを見たとき"}, {"type": "subtitle", "time": 4519.75, "timestamp": "01:15:19", "text": "私の画面には映っていなかった。ああ、彼は"}, {"type": "subtitle", "time": 4523.189, "timestamp": "01:15:23", "text": "ブーを使ってスプライトを使わないと"}, {"type": "subtitle", "time": 4525.83, "timestamp": "01:15:25", "text": "私も混乱しました。どういう意味ですか？"}, {"type": "subtitle", "time": 4528.31, "timestamp": "01:15:28", "text": "ゴーストタイポケモンより、あなたが"}, {"type": "subtitle", "time": 4530.43, "timestamp": "01:15:30", "text": "それを"}, {"type": "subtitle", "time": 4532.709, "timestamp": "01:15:32", "text": "チキン 信じられない、私たちは"}, {"type": "subtitle", "time": 4534.27, "timestamp": "01:15:34", "text": "大変な仕事なのに、このクソ野郎どもは"}, {"type": "subtitle", "time": 4536.87, "timestamp": "01:15:36", "text": "私たちに突進することを決めた"}, {"type": "subtitle", "time": 4540.669, "timestamp": "01:15:40", "text": "うん、私はとても動揺している"}, {"type": "subtitle", "time": 4544.11, "timestamp": "01:15:44", "text": "このままでは平和にこのゲームをプレイすることはできない"}, {"type": "subtitle", "time": 4546.59, "timestamp": "01:15:46", "text": "なぜそうなのか"}, {"type": "subtitle", "time": 4548.87, "timestamp": "01:15:48", "text": "迷惑な"}, {"type": "subtitle", "time": 4551.11, "timestamp": "01:15:51", "text": "うん、こんにちは"}]
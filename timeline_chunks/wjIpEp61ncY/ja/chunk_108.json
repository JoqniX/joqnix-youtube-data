[{"type": "subtitle", "time": 6486.51, "timestamp": "01:48:06", "text": "オーケー、クソ、死んだ、クソ"}, {"type": "subtitle", "time": 6490.149, "timestamp": "01:48:10", "text": "後ろにいるのは死人だと思う"}, {"type": "subtitle", "time": 6520.669, "timestamp": "01:48:40", "text": "この銃の弾薬は無制限です。"}, {"type": "subtitle", "time": 6537.229, "timestamp": "01:48:57", "text": "ああ、なんてことだ、あなたはもう一人の男を殺したのか、なぜ"}, {"type": "subtitle", "time": 6539.79, "timestamp": "01:48:59", "text": "君は座っている、ああ、私はそれを殺さなければならなかった"}]
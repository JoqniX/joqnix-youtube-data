[{"type": "subtitle", "time": 4449.35, "timestamp": "01:14:09", "text": "彼に弾薬をくれ、ありがとう"}, {"type": "subtitle", "time": 4452.709, "timestamp": "01:14:12", "text": "彼らは彼らを手に入れた"}, {"type": "subtitle", "time": 4465.709, "timestamp": "01:14:25", "text": "マジで俺の隣に立たないでくれよ、兄弟、ただのG"}, {"type": "subtitle", "time": 4474.11, "timestamp": "01:14:34", "text": "ああ、なんてことだ、私はノックされてしまった"}, {"type": "subtitle", "time": 4477.59, "timestamp": "01:14:37", "text": "彼に何を投げつけたんだ？"}, {"type": "subtitle", "time": 4482.189, "timestamp": "01:14:42", "text": "ああ、なんてことだ、なんてことだ"}, {"type": "subtitle", "time": 4494.35, "timestamp": "01:14:54", "text": "いいえ、これらのキャンパーは私たちを信頼していません"}, {"type": "subtitle", "time": 4495.91, "timestamp": "01:14:55", "text": "何が起こっている"}]
[{"type": "subtitle", "time": 3841.029, "timestamp": "01:04:01", "text": "彼らがキャンプしている場所は本当に残念だ"}, {"type": "subtitle", "time": 3843.829, "timestamp": "01:04:03", "text": "彼らはキャンプをしている。なぜキャンプをしているのだろうか。"}, {"type": "subtitle", "time": 3846.789, "timestamp": "01:04:06", "text": "ああ神様、なぜ、なぜあなたは来たのですか"}, {"type": "subtitle", "time": 3849.029, "timestamp": "01:04:09", "text": "ここで早くどこに"}, {"type": "subtitle", "time": 3853.269, "timestamp": "01:04:13", "text": "君は大丈夫だった、私はそれを記録した"}, {"type": "subtitle", "time": 3855.47, "timestamp": "01:04:15", "text": "彼らがそれを復活させている方法を示した"}, {"type": "subtitle", "time": 3863.63, "timestamp": "01:04:23", "text": "ああ、神様、私は気にしない、彼女を殺して殺す"}, {"type": "subtitle", "time": 3866.51, "timestamp": "01:04:26", "text": "彼女を殺せ、私は気にしない、殺せ"}, {"type": "subtitle", "time": 3869.15, "timestamp": "01:04:29", "text": "彼女のなぜ人々は"}, {"type": "subtitle", "time": 3872.829, "timestamp": "01:04:32", "text": "キャンプ um ブラック"}, {"type": "subtitle", "time": 3877.589, "timestamp": "01:04:37", "text": "デュオを売り込む、これは2番目だ"}, {"type": "subtitle", "time": 3880.309, "timestamp": "01:04:40", "text": "ああ、長距離では使用すべきではありません"}, {"type": "subtitle", "time": 3883.069, "timestamp": "01:04:43", "text": "短銃"}, {"type": "subtitle", "time": 3887.309, "timestamp": "01:04:47", "text": "オーケー、広告が戻ってきた。おかえり、おかえり。"}, {"type": "subtitle", "time": 3889.109, "timestamp": "01:04:49", "text": "戻る"}, {"type": "subtitle", "time": 3892.029, "timestamp": "01:04:52", "text": "このタスクはどうなると思いますか？"}, {"type": "subtitle", "time": 3898.87, "timestamp": "01:04:58", "text": "イライラする2つ連続で、うん、そうだ"}]
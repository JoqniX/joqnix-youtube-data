[{"type": "subtitle", "time": 5341.83, "timestamp": "01:29:01", "text": "後ろにいてください。名前を叫ぶのに疲れます。"}, {"type": "subtitle", "time": 5344.149, "timestamp": "01:29:04", "text": "CHのように、さあ行こう、出発する必要がある、"}, {"type": "subtitle", "time": 5346.27, "timestamp": "01:29:06", "text": "君はまだそこに立って狙撃しているし、私も"}, {"type": "subtitle", "time": 5348.75, "timestamp": "01:29:08", "text": "弾薬を落としたけど拾わなかったよ、待って"}, {"type": "subtitle", "time": 5350.31, "timestamp": "01:29:10", "text": "あなたは"}, {"type": "subtitle", "time": 5352.47, "timestamp": "01:29:12", "text": "はい、ありがとうございます"}, {"type": "subtitle", "time": 5355.91, "timestamp": "01:29:15", "text": "待って、どこにあるの？ああ、ありがとう、それ"}, {"type": "subtitle", "time": 5358.43, "timestamp": "01:29:18", "text": "再び立ち上がったが、感じなかった"}, {"type": "subtitle", "time": 5360.629, "timestamp": "01:29:20", "text": "スナイプしたいなら、去ろう"}, {"type": "subtitle", "time": 5367.189, "timestamp": "01:29:27", "text": "おお"}, {"type": "subtitle", "time": 5369.109, "timestamp": "01:29:29", "text": "私たちは"}, {"type": "subtitle", "time": 5372.39, "timestamp": "01:29:32", "text": "こんにちは"}, {"type": "subtitle", "time": 5375.669, "timestamp": "01:29:35", "text": "くそ、もし君が望むならここに行けるよ"}, {"type": "subtitle", "time": 5378.39, "timestamp": "01:29:38", "text": "次の山は次の"}, {"type": "subtitle", "time": 5391.75, "timestamp": "01:29:51", "text": "気づいて、私たちが入ったことを願うよ、ああ神様"}]
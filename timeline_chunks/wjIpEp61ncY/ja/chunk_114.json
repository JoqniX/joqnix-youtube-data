[{"type": "subtitle", "time": 6840.95, "timestamp": "01:54:00", "text": "どこかいいところへ行こうよ、えっと、どこへ？"}, {"type": "subtitle", "time": 6844.95, "timestamp": "01:54:04", "text": "私たちは、もしよければここでキャンプできますよ。"}, {"type": "subtitle", "time": 6847.55, "timestamp": "01:54:07", "text": "そして待つように、そして第三者のように"}, {"type": "subtitle", "time": 6850.149, "timestamp": "01:54:10", "text": "あなたが望むなら、私は手放さない"}, {"type": "subtitle", "time": 6860.51, "timestamp": "01:54:20", "text": "ええ、この車は調子が良くありません。"}, {"type": "subtitle", "time": 6865.149, "timestamp": "01:54:25", "text": "壊れてないみたい。あ、男がいる"}, {"type": "subtitle", "time": 6874.99, "timestamp": "01:54:34", "text": "ウラカ、私たちはMの人々を殺している、そこにいるのか。"}, {"type": "subtitle", "time": 6876.709, "timestamp": "01:54:36", "text": "他の"}, {"type": "subtitle", "time": 6879.35, "timestamp": "01:54:39", "text": "1会計年度"}, {"type": "subtitle", "time": 6881.069, "timestamp": "01:54:41", "text": "男"}, {"type": "subtitle", "time": 6887.27, "timestamp": "01:54:47", "text": "あなたが持っているのは、毛皮の男ではない人です。"}, {"type": "subtitle", "time": 6894.069, "timestamp": "01:54:54", "text": "ええ、毛皮のために"}, {"type": "subtitle", "time": 6897.43, "timestamp": "01:54:57", "text": "おい、俺はどこへ行ってしまったんだ？タイガーホワイト"}]
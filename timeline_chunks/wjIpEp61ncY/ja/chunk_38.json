[{"type": "chat", "time": 2291.271, "timestamp": "00:38:11", "author": "@Hero_338", "avatar": "https://yt4.ggpht.com/0uNlIhqsigPTN5hDlTHiX6E1xHNJL_TKrsEvxszwXL5t9cJLNqnfZ0L6Wz1pkyw3Fb-F_l4e=s64-c-k-c0x00ffffff-no-rj", "message": "who is this right next to you joq?"}, {"type": "subtitle", "time": 2293.19, "timestamp": "00:38:13", "text": "友よ、猫の中で何をしたんだ？"}, {"type": "subtitle", "time": 2296.23, "timestamp": "00:38:16", "text": "カフェ、詳細が必要だ。ああ、行ったよ。"}, {"type": "subtitle", "time": 2299.309, "timestamp": "00:38:19", "text": "2階で、えっと、待って、何も食べてないよ"}, {"type": "subtitle", "time": 2301.75, "timestamp": "00:38:21", "text": "そこから"}, {"type": "chat", "time": 2302.038, "timestamp": "00:38:22", "author": "@Hero_338", "avatar": "https://yt4.ggpht.com/0uNlIhqsigPTN5hDlTHiX6E1xHNJL_TKrsEvxszwXL5t9cJLNqnfZ0L6Wz1pkyw3Fb-F_l4e=s64-c-k-c0x00ffffff-no-rj", "message": "she sounds...silly"}, {"type": "subtitle", "time": 2305.309, "timestamp": "00:38:25", "text": "ええ、私たちは何も食べませんでした"}, {"type": "subtitle", "time": 2310.069, "timestamp": "00:38:30", "text": "そこにいるけど、だって私たちはすでに"}, {"type": "subtitle", "time": 2314.91, "timestamp": "00:38:34", "text": "ラーメンとか食べたよ、うん、ジは"}, {"type": "subtitle", "time": 2322.069, "timestamp": "00:38:42", "text": "ええ、それで他に何て呼ばれたか"}, {"type": "subtitle", "time": 2323.43, "timestamp": "00:38:43", "text": "そこには"}, {"type": "subtitle", "time": 2324.55, "timestamp": "00:38:44", "text": "[音楽]"}, {"type": "subtitle", "time": 2328.349, "timestamp": "00:38:48", "text": "彼女は次に私にそこへ行くように頼んだ。"}, {"type": "subtitle", "time": 2330.99, "timestamp": "00:38:50", "text": "年だけど、私は本当にしたくない"}, {"type": "subtitle", "time": 2333.51, "timestamp": "00:38:53", "text": "ほとんどの人が"}, {"type": "subtitle", "time": 2335.39, "timestamp": "00:38:55", "text": "人々は「ああ、ムンバイのコミックだ」と言っていた"}, {"type": "subtitle", "time": 2338.43, "timestamp": "00:38:58", "text": "コンの方がずっと良かった"}]
[{"type": "subtitle", "time": 4338.47, "timestamp": "01:12:18", "text": "1つ"}, {"type": "subtitle", "time": 4341.07, "timestamp": "01:12:21", "text": "はい、私は"}, {"type": "subtitle", "time": 4367.11, "timestamp": "01:12:47", "text": "弾薬は大丈夫、少しあげるよ"}, {"type": "subtitle", "time": 4369.51, "timestamp": "01:12:49", "text": "後でBRは"}, {"type": "subtitle", "time": 4371.83, "timestamp": "01:12:51", "text": "死ぬ"}, {"type": "subtitle", "time": 4375.75, "timestamp": "01:12:55", "text": "わかった、わかったよ、どうぞ"}, {"type": "subtitle", "time": 4378.669, "timestamp": "01:12:58", "text": "周りを漁って欲しいものを何でも手に入れろよ"}]
[{"type": "subtitle", "time": 13560.75, "timestamp": "03:46:00", "text": "ベッドを洗う幸運のベッド"}, {"type": "subtitle", "time": 13568.389, "timestamp": "03:46:08", "text": "空にはたくさんのゲームがある"}, {"type": "subtitle", "time": 13571.71, "timestamp": "03:46:11", "text": "えーと銃ゲーム、私は何か欲しい"}, {"type": "subtitle", "time": 13574.07, "timestamp": "03:46:14", "text": "ベッドウォーの方が良いと思う。幸運なベッドウォー"}, {"type": "subtitle", "time": 13575.51, "timestamp": "03:46:15", "text": "戦争"}, {"type": "subtitle", "time": 13577.95, "timestamp": "03:46:17", "text": "こっちの方が人気があるから、"}, {"type": "subtitle", "time": 13581.59, "timestamp": "03:46:21", "text": "このトレードチームは基地をアップグレードします"}, {"type": "subtitle", "time": 13584.63, "timestamp": "03:46:24", "text": "ダイヤモンド付きって、マインクラフトみたいなもの？"}, {"type": "subtitle", "time": 13587.349, "timestamp": "03:46:27", "text": "ベッドウォー待って、どうやってなのか知りたい"}, {"type": "subtitle", "time": 13590.469, "timestamp": "03:46:30", "text": "フォートナイトのベッドウォーはどんな感じですか？"}, {"type": "subtitle", "time": 13592.99, "timestamp": "03:46:32", "text": "どうやって"}, {"type": "subtitle", "time": 13602.189, "timestamp": "03:46:42", "text": "オレンジ色 私はその気分です"}, {"type": "subtitle", "time": 13605.79, "timestamp": "03:46:45", "text": "ゲームのために他のものを取り込まないでください"}, {"type": "subtitle", "time": 13615.99, "timestamp": "03:46:55", "text": "このTRボーナスBをダミーにしてVに排除する"}]
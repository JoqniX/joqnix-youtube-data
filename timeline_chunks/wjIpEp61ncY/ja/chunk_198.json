[{"type": "subtitle", "time": 11888.79, "timestamp": "03:18:08", "text": "神"}, {"type": "subtitle", "time": 11917.99, "timestamp": "03:18:37", "text": "ちょっとそうしちゃった、ああ神様、ちょっとそうしちゃった"}, {"type": "subtitle", "time": 11920.229, "timestamp": "03:18:40", "text": "私はそれを数えた私はそれを数えた"}, {"type": "subtitle", "time": 11931.55, "timestamp": "03:18:51", "text": "私は私が"}, {"type": "subtitle", "time": 11935.55, "timestamp": "03:18:55", "text": "それで彼は、ああ神様、私は窒息しそうになった"}, {"type": "subtitle", "time": 11938.99, "timestamp": "03:18:58", "text": "それを強く吸い込んだら、私はひどくむせてしまった"}]
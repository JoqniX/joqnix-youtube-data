[{"type": "subtitle", "time": 7082.709, "timestamp": "01:58:02", "text": "今回は78kでロビーに戻ります"}, {"type": "subtitle", "time": 7085.95, "timestamp": "01:58:05", "text": "あれが最後の試合だったね"}, {"type": "subtitle", "time": 7089.149, "timestamp": "01:58:09", "text": "こんにちは、楽しかったです、ありがとう"}, {"type": "subtitle", "time": 7093.99, "timestamp": "01:58:13", "text": "おい、俺たちは苦労したんだ、この聖なるキャンプで"}, {"type": "subtitle", "time": 7096.55, "timestamp": "01:58:16", "text": "クソ、たくさん"}, {"type": "subtitle", "time": 7100.43, "timestamp": "01:58:20", "text": "XP 本当に200を手に入れたのか、そう、20万を手に入れたのか"}, {"type": "subtitle", "time": 7103.149, "timestamp": "01:58:23", "text": "ええと、78点くらい取ったよ"}, {"type": "subtitle", "time": 7104.069, "timestamp": "01:58:24", "text": "それは"}, {"type": "subtitle", "time": 7105.95, "timestamp": "01:58:25", "text": "ニース"}, {"type": "subtitle", "time": 7108.55, "timestamp": "01:58:28", "text": "うん"}, {"type": "subtitle", "time": 7113.109, "timestamp": "01:58:33", "text": "くそ、うん、200、やった、それで何するの？"}, {"type": "subtitle", "time": 7117.43, "timestamp": "01:58:37", "text": "次にすべきことは何か別のことを言うことかもしれないM"}, {"type": "subtitle", "time": 7123.51, "timestamp": "01:58:43", "text": "えーと"}, {"type": "subtitle", "time": 7126.669, "timestamp": "01:58:46", "text": "こんにちは、はい、ありがとうございます"}, {"type": "subtitle", "time": 7130.39, "timestamp": "01:58:50", "text": "今日は問題ない 以前のことを覚えている"}, {"type": "subtitle", "time": 7132.149, "timestamp": "01:58:52", "text": "Rokuサーバーでそのことについて話していました"}, {"type": "subtitle", "time": 7134.55, "timestamp": "01:58:54", "text": "あるいは私が知らない場所"}, {"type": "subtitle", "time": 7136.75, "timestamp": "01:58:56", "text": "私があなたを助けると言ったのを覚えている？"}, {"type": "subtitle", "time": 7139.109, "timestamp": "01:58:59", "text": "あれを取り出して、うん、手伝うよ"}]
[{"type": "subtitle", "time": 7461.44, "timestamp": "02:04:21", "text": "[拍手]"}, {"type": "subtitle", "time": 7463.03, "timestamp": "02:04:23", "text": "[音楽]"}, {"type": "subtitle", "time": 7467.99, "timestamp": "02:04:27", "text": "ああ、そうだ、彼はスナイパーを持っている。"}, {"type": "subtitle", "time": 7469.87, "timestamp": "02:04:29", "text": "それ"}, {"type": "subtitle", "time": 7472.669, "timestamp": "02:04:32", "text": "スナイピーは要らない"}, {"type": "subtitle", "time": 7475.95, "timestamp": "02:04:35", "text": "私はこれらのことを学びたい"}, {"type": "subtitle", "time": 7484.91, "timestamp": "02:04:44", "text": "まず、この物のように、私は"}, {"type": "subtitle", "time": 7489.669, "timestamp": "02:04:49", "text": "充電して、彼を蹴って、そんなことしないで"}, {"type": "subtitle", "time": 7493.39, "timestamp": "02:04:53", "text": "しかし、これは移動速度を速める効果がある"}]
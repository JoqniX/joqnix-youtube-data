[{"type": "subtitle", "time": 6600.79, "timestamp": "01:50:00", "text": "そしてブルース"}, {"type": "subtitle", "time": 6605.98, "timestamp": "01:50:05", "text": "ああ、ブルータスも死んだ"}, {"type": "subtitle", "time": 6607.83, "timestamp": "01:50:07", "text": "[拍手]"}, {"type": "subtitle", "time": 6612.669, "timestamp": "01:50:12", "text": "男はすぐに犠牲になる、いや彼は"}, {"type": "subtitle", "time": 6614.589, "timestamp": "01:50:14", "text": "感じる"}, {"type": "subtitle", "time": 6617.47, "timestamp": "01:50:17", "text": "弱って本当に死んでしまう"}, {"type": "subtitle", "time": 6619.39, "timestamp": "01:50:19", "text": "ああ、それは"}, {"type": "subtitle", "time": 6621.149, "timestamp": "01:50:21", "text": "それ"}, {"type": "subtitle", "time": 6629.03, "timestamp": "01:50:29", "text": "茂みは文字通りそこにあります"}, {"type": "subtitle", "time": 6630.47, "timestamp": "01:50:30", "text": "誰かが"}, {"type": "subtitle", "time": 6633.99, "timestamp": "01:50:33", "text": "隠れて逃げる、それは逃げる"}, {"type": "subtitle", "time": 6640.87, "timestamp": "01:50:40", "text": "マザーファッカーサ"}, {"type": "subtitle", "time": 6643.35, "timestamp": "01:50:43", "text": "いいえ"}, {"type": "subtitle", "time": 6646.709, "timestamp": "01:50:46", "text": "いや、私たちはバカだ"}, {"type": "subtitle", "time": 6649.51, "timestamp": "01:50:49", "text": "行くよ、私たちは"}, {"type": "subtitle", "time": 6654.109, "timestamp": "01:50:54", "text": "遅れて、彼はカードを取った、彼は"}, {"type": "subtitle", "time": 6657.39, "timestamp": "01:50:57", "text": "C 車を手に入れる"}]
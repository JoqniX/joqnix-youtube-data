[{"type": "subtitle", "time": 4627.189, "timestamp": "01:17:07", "text": "今日は気味が悪いですね。私は6時間6時間"}, {"type": "subtitle", "time": 4630.75, "timestamp": "01:17:10", "text": "時間、うん、今日は旅行してたから。"}, {"type": "subtitle", "time": 4633.03, "timestamp": "01:17:13", "text": "ああ、あなたは家に帰ってきたのですね"}, {"type": "subtitle", "time": 4634.629, "timestamp": "01:17:14", "text": "今日"}, {"type": "subtitle", "time": 4642.27, "timestamp": "01:17:22", "text": "休憩中、今夕食を食べています"}, {"type": "subtitle", "time": 4645.43, "timestamp": "01:17:25", "text": "疲れたので"}, {"type": "subtitle", "time": 4646.87, "timestamp": "01:17:26", "text": "私は寝るのが好きじゃない"}, {"type": "subtitle", "time": 4648.629, "timestamp": "01:17:28", "text": "夕食後もどちらでも、私は残るつもりです"}, {"type": "subtitle", "time": 4651.229, "timestamp": "01:17:31", "text": "みんなが「ああ、でも私はゲームをしなかった」と言う一方で"}, {"type": "subtitle", "time": 4655.31, "timestamp": "01:17:35", "text": "しばらくしたら、ゲームをプレイしたい"}, {"type": "subtitle", "time": 4657.75, "timestamp": "01:17:37", "text": "ニキ、あのゲーム本当に好き"}, {"type": "subtitle", "time": 4660.709, "timestamp": "01:17:40", "text": "私もプレイするべきだ、私は持っている"}, {"type": "subtitle", "time": 4663.11, "timestamp": "01:17:43", "text": "インストール済み"}, {"type": "subtitle", "time": 4666.43, "timestamp": "01:17:46", "text": "君はそうするべきだと信じているよ、そうするべきだ"}, {"type": "subtitle", "time": 4669.95, "timestamp": "01:17:49", "text": "アジアでプレイして、スキ、ズキ、いや、"}, {"type": "subtitle", "time": 4671.51, "timestamp": "01:17:51", "text": "彼女は本当にそのゲームが大好きだ"}, {"type": "subtitle", "time": 4675.709, "timestamp": "01:17:55", "text": "ああ、待って、君はアジアではプレイしていないんだね"}, {"type": "subtitle", "time": 4678.95, "timestamp": "01:17:58", "text": "私は、私は、ああ、わかりました"}]
[{"type": "subtitle", "time": 1682.11, "timestamp": "00:28:02", "text": "それは、どう対処すればいいかという意味ですか？"}, {"type": "subtitle", "time": 1683.71, "timestamp": "00:28:03", "text": "射撃せずにさらにダメージを与える"}, {"type": "subtitle", "time": 1686.99, "timestamp": "00:28:06", "text": "銃、他の銃を使いたいですか？"}, {"type": "subtitle", "time": 1693.75, "timestamp": "00:28:13", "text": "つまり、私は戦利品を持っていないということです。"}, {"type": "subtitle", "time": 1697.11, "timestamp": "00:28:17", "text": "着陸したが、戦利品はなかった"}, {"type": "subtitle", "time": 1704.59, "timestamp": "00:28:24", "text": "これは、"}, {"type": "subtitle", "time": 1712.95, "timestamp": "00:28:32", "text": "いや、そんなことしないで、やめなさい、やめなさい"}, {"type": "subtitle", "time": 1714.389, "timestamp": "00:28:34", "text": "それをやめる、それをやめる、それをやめる"}, {"type": "subtitle", "time": 1729.59, "timestamp": "00:28:49", "text": "あなたがどこにいたか"}, {"type": "subtitle", "time": 1736.71, "timestamp": "00:28:56", "text": "誰であろうと、彼らが来るぞ"}]
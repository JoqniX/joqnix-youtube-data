[{"type": "subtitle", "time": 124.27, "timestamp": "00:02:04", "text": "[音楽]"}, {"type": "subtitle", "time": 128.669, "timestamp": "00:02:08", "text": "じゃあ、私が始めますね。それとも、あなたが私に"}, {"type": "subtitle", "time": 132.27, "timestamp": "00:02:12", "text": "待って、取りに行かなきゃいけないんだけど、外に座っててもいい？"}, {"type": "subtitle", "time": 135.589, "timestamp": "00:02:15", "text": "それは今可能だ"}, {"type": "subtitle", "time": 138.22899999999998, "timestamp": "00:02:18", "text": "フォートナイトってどういう意味？"}, {"type": "subtitle", "time": 139.79, "timestamp": "00:02:19", "text": "座ってもいいですか？"}, {"type": "subtitle", "time": 143.71, "timestamp": "00:02:23", "text": "座って、座って、パーティーで座って"}, {"type": "subtitle", "time": 148.03, "timestamp": "00:02:28", "text": "座って、ああ、もちろん、どうやって"}, {"type": "subtitle", "time": 150.71, "timestamp": "00:02:30", "text": "フォートナイトでそれを行う"}, {"type": "subtitle", "time": 152.03, "timestamp": "00:02:32", "text": "えーと押す"}, {"type": "subtitle", "time": 156.589, "timestamp": "00:02:36", "text": "脱出、そして右側"}, {"type": "subtitle", "time": 159.149, "timestamp": "00:02:39", "text": "あなたは私たちのパーティーを見るでしょう"}, {"type": "subtitle", "time": 162.949, "timestamp": "00:02:42", "text": "パーティーを抜ける パーティーを抜ける いいえをクリックする"}, {"type": "subtitle", "time": 165.27, "timestamp": "00:02:45", "text": "普段の座り心地の良い場所で私はまだ"}, {"type": "subtitle", "time": 169.55, "timestamp": "00:02:49", "text": "党内で、それはないのか"}, {"type": "subtitle", "time": 172.39, "timestamp": "00:02:52", "text": "もう、あなたを見ることができないように、あなたを見ることができます"}, {"type": "subtitle", "time": 176.43, "timestamp": "00:02:56", "text": "遊ぶタイプのもの、ああ、そういうことが起こるんだ、待って"}]
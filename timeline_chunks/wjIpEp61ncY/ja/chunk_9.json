[{"type": "subtitle", "time": 549.35, "timestamp": "00:09:09", "text": "あなたはできるはずです"}, {"type": "subtitle", "time": 556.35, "timestamp": "00:09:16", "text": "うん、そうでないことを願うよ"}, {"type": "subtitle", "time": 558.75, "timestamp": "00:09:18", "text": "ラグいですね、そうでないことを願います"}, {"type": "subtitle", "time": 562.15, "timestamp": "00:09:22", "text": "[音楽]"}, {"type": "subtitle", "time": 566.509, "timestamp": "00:09:26", "text": "ラグい、ああ、どうですか、"}, {"type": "subtitle", "time": 570.43, "timestamp": "00:09:30", "text": "ゲームはどうですか？"}, {"type": "subtitle", "time": 571.47, "timestamp": "00:09:31", "text": "それは"}, {"type": "subtitle", "time": 575.59, "timestamp": "00:09:35", "text": "よし、じゃあ夕食を取りに行って"}, {"type": "subtitle", "time": 577.67, "timestamp": "00:09:37", "text": "そう、持ってきて食べればいいよ"}, {"type": "subtitle", "time": 578.91, "timestamp": "00:09:38", "text": "と"}, {"type": "subtitle", "time": 581.75, "timestamp": "00:09:41", "text": "待って、持って行けない、行かなきゃ"}, {"type": "subtitle", "time": 584.67, "timestamp": "00:09:44", "text": "家の外の友人"}, {"type": "subtitle", "time": 587.43, "timestamp": "00:09:47", "text": "家 家"}, {"type": "subtitle", "time": 591.31, "timestamp": "00:09:51", "text": "お願い、彼は私をあなたと一緒に残していくの、いやいやいや"}, {"type": "subtitle", "time": 594.47, "timestamp": "00:09:54", "text": "いいえ、私はあなたを見守っています、"}, {"type": "subtitle", "time": 596.03, "timestamp": "00:09:56", "text": "心配"}, {"type": "subtitle", "time": 597.99, "timestamp": "00:09:57", "text": "わかった、私が言うつもりはないんだけど"}]
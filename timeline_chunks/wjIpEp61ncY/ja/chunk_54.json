[{"type": "subtitle", "time": 3249.19, "timestamp": "00:54:09", "text": "嘘だ、君ならできる、ああ神様、ああ"}, {"type": "subtitle", "time": 3254.63, "timestamp": "00:54:14", "text": "ああ、男が多すぎる"}, {"type": "subtitle", "time": 3258.99, "timestamp": "00:54:18", "text": "よし、次は彼を捕まえよう。準備はいいか？"}, {"type": "subtitle", "time": 3261.15, "timestamp": "00:54:21", "text": "上"}, {"type": "subtitle", "time": 3265.27, "timestamp": "00:54:25", "text": "はい、彼女が次にTを手に入れるときには"}, {"type": "subtitle", "time": 3268.99, "timestamp": "00:54:28", "text": "ああ、これがその肌か、わかった"}, {"type": "subtitle", "time": 3272.349, "timestamp": "00:54:32", "text": "うんうん、彼らはもう手に入れた"}, {"type": "subtitle", "time": 3276.069, "timestamp": "00:54:36", "text": "肌は待つ必要があると思った"}, {"type": "subtitle", "time": 3279.19, "timestamp": "00:54:39", "text": "ああ、わかった、君には彼らが必要だと思ったんだけど"}, {"type": "subtitle", "time": 3281.349, "timestamp": "00:54:41", "text": "人生を取り戻さなければならない 彼らは人生を取り戻さなければならない"}, {"type": "subtitle", "time": 3284.67, "timestamp": "00:54:44", "text": "人生は草を手に入れる、どうやって"}, {"type": "subtitle", "time": 3287.589, "timestamp": "00:54:47", "text": "彼らはすでに私と全く同じものを持っている"}, {"type": "subtitle", "time": 3289.23, "timestamp": "00:54:49", "text": "待つ必要があると思った"}, {"type": "subtitle", "time": 3292.15, "timestamp": "00:54:52", "text": "彼らがキャンプで直面する課題や事柄"}, {"type": "subtitle", "time": 3295.27, "timestamp": "00:54:55", "text": "えっ、そうだよ、彼らはキャンプしてるんだ"}]
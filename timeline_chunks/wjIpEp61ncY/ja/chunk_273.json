[{"type": "subtitle", "time": 16380.59, "timestamp": "04:33:00", "text": "やっと来たよ、勝てて嬉しいよ"}, {"type": "subtitle", "time": 16393.31, "timestamp": "04:33:13", "text": "傘を見て"}, {"type": "subtitle", "time": 16394.31, "timestamp": "04:33:14", "text": "私は"}, {"type": "subtitle", "time": 16396.15, "timestamp": "04:33:16", "text": "リッチョ 私は"}, {"type": "subtitle", "time": 16406.709, "timestamp": "04:33:26", "text": "はい、わあ、ここはとても美しいです"}, {"type": "subtitle", "time": 16430.789, "timestamp": "04:33:50", "text": "おお、我が主よ、聖なる神よ、万歳、満ち溢れる"}, {"type": "subtitle", "time": 16437.029, "timestamp": "04:33:57", "text": "あなた、ああ、あなた"}]
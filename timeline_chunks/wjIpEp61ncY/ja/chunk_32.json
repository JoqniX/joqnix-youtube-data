[{"type": "subtitle", "time": 1921.389, "timestamp": "00:32:01", "text": "ソロをオンにする、そう、ソロでいいよ"}, {"type": "subtitle", "time": 1927.669, "timestamp": "00:32:07", "text": "待って、私はとにかく年を取っていないので、私は行く"}, {"type": "subtitle", "time": 1939.149, "timestamp": "00:32:19", "text": "うん、何を手に入れたのか気になるな"}, {"type": "subtitle", "time": 1942.75, "timestamp": "00:32:22", "text": "夕食だけど、ジョーH、ただいま、ああ、あなたは"}, {"type": "subtitle", "time": 1945.149, "timestamp": "00:32:25", "text": "もう戻ってきたの？何を手に入れたの？"}, {"type": "subtitle", "time": 1950.75, "timestamp": "00:32:30", "text": "夕食は、ご飯を食べて、それからフレッシュカレーを食べました。"}, {"type": "subtitle", "time": 1955.47, "timestamp": "00:32:35", "text": "フライドポテトはもう食べたよね"}, {"type": "subtitle", "time": 1959.629, "timestamp": "00:32:39", "text": "あ、待って、じゃあキャンセルした方がいいかな、待って、私は"}, {"type": "subtitle", "time": 1962.95, "timestamp": "00:32:42", "text": "参加します、わかりました、わかりました、閉じるべきでしょうか"}, {"type": "subtitle", "time": 1977.07, "timestamp": "00:32:57", "text": "わかった、君は出かけて行ったと思ったよ"}, {"type": "subtitle", "time": 1978.71, "timestamp": "00:32:58", "text": "夕食"}]
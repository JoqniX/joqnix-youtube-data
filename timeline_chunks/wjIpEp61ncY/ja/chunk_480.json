[{"type": "subtitle", "time": 28809.27, "timestamp": "08:00:09", "text": "サイン、もう一つサインがある、どこにいるの"}, {"type": "subtitle", "time": 28818.67, "timestamp": "08:00:18", "text": "隠していたのか、見逃したのか、私は知らない"}, {"type": "subtitle", "time": 28843.308, "timestamp": "08:00:43", "text": "神よ、私は知っています"}, {"type": "subtitle", "time": 28845.23, "timestamp": "08:00:45", "text": "私は"}]
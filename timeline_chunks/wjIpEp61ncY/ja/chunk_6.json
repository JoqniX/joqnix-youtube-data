[{"type": "subtitle", "time": 363.39, "timestamp": "00:06:03", "text": "大丈夫、大丈夫、大丈夫、大丈夫"}, {"type": "subtitle", "time": 365.15, "timestamp": "00:06:05", "text": "大丈夫、心配ない、心配ないよ、ああもし"}, {"type": "subtitle", "time": 368.27, "timestamp": "00:06:08", "text": "あなたが望むなら、私はできます。あなたが望むなら、できます。"}, {"type": "subtitle", "time": 370.87, "timestamp": "00:06:10", "text": "これはストリーミングラグと呼ばれ、PC に"}, {"type": "subtitle", "time": 377.39, "timestamp": "00:06:17", "text": "持っている"}, {"type": "subtitle", "time": 380.27, "timestamp": "00:06:20", "text": "ああ、大丈夫だよ、君はできるよ、私は"}, {"type": "subtitle", "time": 389.67, "timestamp": "00:06:29", "text": "そうすれば、ピューピューと撃って解説することができます"}, {"type": "subtitle", "time": 399.55, "timestamp": "00:06:39", "text": "残り時間はあと2秒くらいしかない"}, {"type": "subtitle", "time": 402.87, "timestamp": "00:06:42", "text": "私も先に死ぬかもしれないし、そうじゃない"}, {"type": "subtitle", "time": 405.629, "timestamp": "00:06:45", "text": "はい、わかりました。見ていただけますか？"}, {"type": "subtitle", "time": 409.629, "timestamp": "00:06:49", "text": "今の私、よし、待って、出て行って参加した方がいいかな？"}, {"type": "subtitle", "time": 416.51, "timestamp": "00:06:56", "text": "パーティーに参加して"}, {"type": "subtitle", "time": 419.1, "timestamp": "00:06:59", "text": "見てよ"}]
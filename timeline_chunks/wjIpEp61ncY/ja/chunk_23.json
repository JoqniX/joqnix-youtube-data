[{"type": "subtitle", "time": 1381.39, "timestamp": "00:23:01", "text": "低い、そうだ、リロードだ、いやいや、クソ、ああ、わかった"}, {"type": "subtitle", "time": 1383.99, "timestamp": "00:23:03", "text": "閉店します"}, {"type": "subtitle", "time": 1407.19, "timestamp": "00:23:27", "text": "うわあ、よくもまあ"}, {"type": "subtitle", "time": 1416.07, "timestamp": "00:23:36", "text": "行き詰まった なぜ なぜあなたは"}, {"type": "subtitle", "time": 1421.39, "timestamp": "00:23:41", "text": "詰まってリロードするよ。どこへ行けばいいかな？"}, {"type": "subtitle", "time": 1426.07, "timestamp": "00:23:46", "text": "パラダイス"}, {"type": "subtitle", "time": 1431.95, "timestamp": "00:23:51", "text": "スプリングス・グアコ・タウンの大人"}, {"type": "subtitle", "time": 1437.99, "timestamp": "00:23:57", "text": "ボート、ここ、Kスプリング、ああ、人々"}]
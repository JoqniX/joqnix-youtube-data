[{"type": "subtitle", "time": 4801.11, "timestamp": "01:20:01", "text": "[音楽]"}, {"type": "subtitle", "time": 4803.95, "timestamp": "01:20:03", "text": "W それは大丈夫、私たちは簡単に金を手に入れるから"}, {"type": "subtitle", "time": 4806.79, "timestamp": "01:20:06", "text": "この世界はとにかく私は私は私はしないつもりだ"}, {"type": "subtitle", "time": 4808.669, "timestamp": "01:20:08", "text": "嘘をついた。私も同じ反応をした。"}, {"type": "subtitle", "time": 4811.95, "timestamp": "01:20:11", "text": "これは詐欺だ、そして私はこう思った"}, {"type": "subtitle", "time": 4813.99, "timestamp": "01:20:13", "text": "ああ、私たちは簡単に金を手に入れる"}, {"type": "subtitle", "time": 4819.51, "timestamp": "01:20:19", "text": "どこでも採掘できる"}, {"type": "subtitle", "time": 4821.19, "timestamp": "01:20:21", "text": "あなた自身もそれは本当です"}, {"type": "subtitle", "time": 4823.629, "timestamp": "01:20:23", "text": "[音楽]"}, {"type": "subtitle", "time": 4826.51, "timestamp": "01:20:26", "text": "ああ、しまった、間違って2つ買ってしまった"}, {"type": "subtitle", "time": 4828.149, "timestamp": "01:20:28", "text": "銃が必要ですか"}, {"type": "subtitle", "time": 4838.03, "timestamp": "01:20:38", "text": "感謝"}, {"type": "subtitle", "time": 4847.47, "timestamp": "01:20:47", "text": "弾薬、これは"}]
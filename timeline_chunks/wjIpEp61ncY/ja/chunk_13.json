[{"type": "subtitle", "time": 784.829, "timestamp": "00:13:04", "text": "法律 法律情報 表示 いいえ いいえ 私は"}, {"type": "subtitle", "time": 786.389, "timestamp": "00:13:06", "text": "ストリームにドッキングしたくない"}, {"type": "subtitle", "time": 790.11, "timestamp": "00:13:10", "text": "それは最悪だと思う、ここだと思う"}, {"type": "subtitle", "time": 794.069, "timestamp": "00:13:14", "text": "それなら再生しないで、ミュートライセンスを再生しないで"}, {"type": "subtitle", "time": 799.55, "timestamp": "00:13:19", "text": "オーディオ適用、試してみます、保持"}, {"type": "subtitle", "time": 803.11, "timestamp": "00:13:23", "text": "よかったですね"}, {"type": "subtitle", "time": 806.629, "timestamp": "00:13:26", "text": "彼が去って、私が"}, {"type": "subtitle", "time": 810.829, "timestamp": "00:13:30", "text": "遊び始めたんだよ"}, {"type": "subtitle", "time": 813.35, "timestamp": "00:13:33", "text": "音楽、そして彼は"}, {"type": "subtitle", "time": 816.949, "timestamp": "00:13:36", "text": "理由もなく著作権を取得する"}, {"type": "subtitle", "time": 818.949, "timestamp": "00:13:38", "text": "怖かっただろうけど、私たちは"}, {"type": "subtitle", "time": 821.67, "timestamp": "00:13:41", "text": "責任あるストリーマー フォートナイト バトル"}, {"type": "subtitle", "time": 825.189, "timestamp": "00:13:45", "text": "パス 私はそれを終わらせようとしています"}, {"type": "subtitle", "time": 826.949, "timestamp": "00:13:46", "text": "午前"}, {"type": "subtitle", "time": 831.47, "timestamp": "00:13:51", "text": "私はレベル70くらいです"}]
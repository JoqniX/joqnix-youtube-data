[{"type": "subtitle", "time": 21809.23, "timestamp": "06:03:29", "text": "彼が私に怒っていること、私は何をしたの？"}, {"type": "subtitle", "time": 21810.67, "timestamp": "06:03:30", "text": "あなた"}, {"type": "subtitle", "time": 21816.11, "timestamp": "06:03:36", "text": "兄弟、ただプレイすればいいんだ、それは私のせいなのか"}, {"type": "subtitle", "time": 21820.468, "timestamp": "06:03:40", "text": "それは私のせいですか、それは私の"}, {"type": "subtitle", "time": 21824.43, "timestamp": "06:03:44", "text": "間違いです、私はただ遊んでいるだけです"}, {"type": "subtitle", "time": 21826.708, "timestamp": "06:03:46", "text": "ゲーム"}, {"type": "subtitle", "time": 21829.99, "timestamp": "06:03:49", "text": "私があなたと同じように作れると思いますか？いいえ、私は"}, {"type": "subtitle", "time": 21833.43, "timestamp": "06:03:53", "text": "できないし、私のデバイスはラグっている"}]
[{"type": "subtitle", "time": 11348.67, "timestamp": "03:09:08", "text": "新しい銃は大丈夫？トレーニングが必要なんだ"}, {"type": "subtitle", "time": 11351.309, "timestamp": "03:09:11", "text": "わかった、トレーニングを受ける必要がある"}, {"type": "subtitle", "time": 11352.99, "timestamp": "03:09:12", "text": "取る"}, {"type": "subtitle", "time": 11354.55, "timestamp": "03:09:14", "text": "これ"}, {"type": "subtitle", "time": 11367.15, "timestamp": "03:09:27", "text": "他にスナイパーは？"}, {"type": "subtitle", "time": 11370.55, "timestamp": "03:09:30", "text": "訓練した人間はより良い魚は"}, {"type": "subtitle", "time": 11372.83, "timestamp": "03:09:32", "text": "より良い"}, {"type": "subtitle", "time": 11376.59, "timestamp": "03:09:36", "text": "いいえ、そうすべきです。私は治癒が必要です。"}, {"type": "subtitle", "time": 11388.67, "timestamp": "03:09:48", "text": "知りたいんだけど、大丈夫だよ、"}, {"type": "subtitle", "time": 11393.63, "timestamp": "03:09:53", "text": "行け、ああ、君は変更できる、ああ私の"}]
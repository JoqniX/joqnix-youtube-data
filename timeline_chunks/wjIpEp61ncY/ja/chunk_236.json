[{"type": "subtitle", "time": 14169.75, "timestamp": "03:56:09", "text": "私が"}, {"type": "subtitle", "time": 14172.99, "timestamp": "03:56:12", "text": "ゲーマー、スライドできないよ、やったー、戻ってきたよ"}, {"type": "subtitle", "time": 14175.469, "timestamp": "03:56:15", "text": "家"}, {"type": "subtitle", "time": 14177.75, "timestamp": "03:56:17", "text": "さあ、次は"}, {"type": "subtitle", "time": 14182.95, "timestamp": "03:56:22", "text": "ああ、ヘリコプターが必要だ。"}, {"type": "subtitle", "time": 14185.95, "timestamp": "03:56:25", "text": "時間のために"}, {"type": "subtitle", "time": 14189.83, "timestamp": "03:56:29", "text": "神よ、私たちには安全があります。"}, {"type": "subtitle", "time": 14191.99, "timestamp": "03:56:31", "text": "神の上に"}, {"type": "subtitle", "time": 14195.63, "timestamp": "03:56:35", "text": "ヘリコプターが必要だ"}, {"type": "subtitle", "time": 14199.95, "timestamp": "03:56:39", "text": "はい、私のアイテムのダメージブーストは1つです"}, {"type": "subtitle", "time": 14204.309, "timestamp": "03:56:44", "text": "Zシールドブースト、そう、そして私は"}, {"type": "subtitle", "time": 14208.149, "timestamp": "03:56:48", "text": "スピードブーストのためのお金"}, {"type": "subtitle", "time": 14212.83, "timestamp": "03:56:52", "text": "金庫は大丈夫、それを手に入れる"}, {"type": "subtitle", "time": 14215.429, "timestamp": "03:56:55", "text": "私が持っているもの"}, {"type": "subtitle", "time": 14218.149, "timestamp": "03:56:58", "text": "金庫、大丈夫、盗むつもりだ"}]
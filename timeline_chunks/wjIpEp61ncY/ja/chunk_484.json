[{"type": "subtitle", "time": 29049.468, "timestamp": "08:04:09", "text": "赤、ああ神様、ああ神様、ああ神様、ああ神様"}, {"type": "subtitle", "time": 29052.788, "timestamp": "08:04:12", "text": "ああ神よ、ああ神よ、ああ神よ、ああ神よ、ああ神よ、聖なる"}, {"type": "subtitle", "time": 29063.83, "timestamp": "08:04:23", "text": "神よ、何が"}, {"type": "subtitle", "time": 29067.75, "timestamp": "08:04:27", "text": "それは何ですか？"}]
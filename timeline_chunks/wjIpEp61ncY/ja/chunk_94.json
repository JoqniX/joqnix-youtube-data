[{"type": "subtitle", "time": 5644.85, "timestamp": "01:34:04", "text": "五"}, {"type": "subtitle", "time": 5651.709, "timestamp": "01:34:11", "text": "彼は、ああ、人々から"}, {"type": "subtitle", "time": 5659.87, "timestamp": "01:34:19", "text": "そこには"}, {"type": "subtitle", "time": 5663.16, "timestamp": "01:34:23", "text": "ああ、そこ"}, {"type": "subtitle", "time": 5672.51, "timestamp": "01:34:32", "text": "[拍手]"}, {"type": "subtitle", "time": 5684.87, "timestamp": "01:34:44", "text": "オーケー、別のチームが何"}, {"type": "subtitle", "time": 5688.8, "timestamp": "01:34:48", "text": "ああ、こっちで1つ倒しちゃったよ"}, {"type": "subtitle", "time": 5695.47, "timestamp": "01:34:55", "text": "あの男は"}, {"type": "subtitle", "time": 5697.59, "timestamp": "01:34:57", "text": "死んだ、ああ、私たちは"}]
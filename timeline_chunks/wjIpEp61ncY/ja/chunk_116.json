[{"type": "subtitle", "time": 6961.55, "timestamp": "01:56:01", "text": "彼らも隠れることができる"}, {"type": "subtitle", "time": 6964.43, "timestamp": "01:56:04", "text": "まるで私たちがここにしばらくいたかのように"}, {"type": "subtitle", "time": 6966.55, "timestamp": "01:56:06", "text": "どこに"}, {"type": "subtitle", "time": 6969.069, "timestamp": "01:56:09", "text": "ああ、そうだ、私は通るよ、わかった、わかった、私たちは"}, {"type": "subtitle", "time": 6971.55, "timestamp": "01:56:11", "text": "銃撃戦の音を聞け ストレート"}, {"type": "subtitle", "time": 6974.27, "timestamp": "01:56:14", "text": "前方にメダルがある"}, {"type": "subtitle", "time": 6978.069, "timestamp": "01:56:18", "text": "気をつけて、オーケー、オーオー"}, {"type": "subtitle", "time": 6981.95, "timestamp": "01:56:21", "text": "彼を避けて通ることはできない、実際はあそこにいる"}, {"type": "subtitle", "time": 6983.51, "timestamp": "01:56:23", "text": "切り取り線"}, {"type": "subtitle", "time": 6985.39, "timestamp": "01:56:25", "text": "つまり、私は遅れているということです"}, {"type": "subtitle", "time": 6989.629, "timestamp": "01:56:29", "text": "まずあの男を見てみろ、誰だ？"}, {"type": "subtitle", "time": 6997.39, "timestamp": "01:56:37", "text": "君は間違った人たちと付き合っているよ、相棒。"}, {"type": "subtitle", "time": 6998.629, "timestamp": "01:56:38", "text": "間違っている"}, {"type": "subtitle", "time": 7003.589, "timestamp": "01:56:43", "text": "人々よ、あなたの敵がそこにいる。"}, {"type": "subtitle", "time": 7005.87, "timestamp": "01:56:45", "text": "ああ、神様、大丈夫、私は得意です"}, {"type": "subtitle", "time": 7007.51, "timestamp": "01:56:47", "text": "これ上手ですね、行きましょう、行きましょう"}, {"type": "subtitle", "time": 7009.069, "timestamp": "01:56:49", "text": "あの人たちは、でも私は撃つことができるだろうか"}, {"type": "subtitle", "time": 7013.069, "timestamp": "01:56:53", "text": "これはできない、お前はクソだ、行こう"}, {"type": "subtitle", "time": 7016.27, "timestamp": "01:56:56", "text": "さあ行こう、さあ行こう、"}, {"type": "subtitle", "time": 7018.55, "timestamp": "01:56:58", "text": "オーストレートアヘッドの前に戦う"}]
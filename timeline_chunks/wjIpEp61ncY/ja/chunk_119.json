[{"type": "subtitle", "time": 7142.91, "timestamp": "01:59:02", "text": "あれを出してありがとう、そうそう"}, {"type": "subtitle", "time": 7145.91, "timestamp": "01:59:05", "text": "おそらくちゃんとしたオープンなVCを用意するつもりです"}, {"type": "subtitle", "time": 7150.149, "timestamp": "01:59:10", "text": "サーバーやチャンネルのように"}, {"type": "subtitle", "time": 7153.99, "timestamp": "01:59:13", "text": "参加する、それはいいですね。そうします。そうすれば私は自由になります。"}, {"type": "subtitle", "time": 7155.51, "timestamp": "01:59:15", "text": "わかった、ちょうど家に帰ってきたところだから"}, {"type": "subtitle", "time": 7156.83, "timestamp": "01:59:16", "text": "やりたいことが山ほどある"}, {"type": "subtitle", "time": 7159.55, "timestamp": "01:59:19", "text": "私もそう、とても自由です"}, {"type": "subtitle", "time": 7162.35, "timestamp": "01:59:22", "text": "うんうん、ああ、言おうとしてた"}, {"type": "subtitle", "time": 7165.55, "timestamp": "01:59:25", "text": "他に忘れたことがあって、"}, {"type": "subtitle", "time": 7169.31, "timestamp": "01:59:29", "text": "こんにちは、大丈夫です、来てください"}, {"type": "subtitle", "time": 7172.79, "timestamp": "01:59:32", "text": "次回は「うん」と言える"}, {"type": "subtitle", "time": 7177.31, "timestamp": "01:59:37", "text": "あの時のことを今思い出しました。ええと、"}, {"type": "subtitle", "time": 7179.31, "timestamp": "01:59:39", "text": "インフィニティ・ニック"}, {"type": "subtitle", "time": 7182.31, "timestamp": "01:59:42", "text": "プレイするなら私を追加して"}, {"type": "subtitle", "time": 7185.43, "timestamp": "01:59:45", "text": "私たちはアジアでプレーしています。私はアジアにいます。"}, {"type": "subtitle", "time": 7189.109, "timestamp": "01:59:49", "text": "ええ、IDを確認する必要があるので"}, {"type": "subtitle", "time": 7192.189, "timestamp": "01:59:52", "text": "そういうこと、プレイするときとか何でも"}, {"type": "subtitle", "time": 7194.99, "timestamp": "01:59:54", "text": "友達IDを教えてください、もしくは私が"}, {"type": "subtitle", "time": 7199.83, "timestamp": "01:59:59", "text": "行くよ、私も送るよ、はい、うん"}]
[{"type": "subtitle", "time": 19803.548, "timestamp": "05:30:03", "text": "ああ、彼らが古いものを置かないものもある"}, {"type": "subtitle", "time": 19805.51, "timestamp": "05:30:05", "text": "彼らがしないもの"}, {"type": "subtitle", "time": 19809.91, "timestamp": "05:30:09", "text": "新しいものには「うん」と書いてください"}, {"type": "subtitle", "time": 19811.03, "timestamp": "05:30:11", "text": "来る"}, {"type": "subtitle", "time": 19814.15, "timestamp": "05:30:14", "text": "そうですね、でも新しいものには彼らは"}, {"type": "subtitle", "time": 19838.67, "timestamp": "05:30:38", "text": "アニメーション、新しいものは"}, {"type": "subtitle", "time": 19852.43, "timestamp": "05:30:52", "text": "なぜこれは"}]
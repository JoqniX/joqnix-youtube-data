[{"type": "subtitle", "time": 16740.629, "timestamp": "04:39:00", "text": "汗はどれくらいだった？健康状態はどうだった？"}, {"type": "subtitle", "time": 16742.83, "timestamp": "04:39:02", "text": "あなたの"}, {"type": "subtitle", "time": 16756.189, "timestamp": "04:39:16", "text": "この肌を持つ人は"}, {"type": "subtitle", "time": 16759.109, "timestamp": "04:39:19", "text": "だからこれは無料のスキンか"}, {"type": "subtitle", "time": 16769.51, "timestamp": "04:39:29", "text": "ほぼ完璧だ、君を誇りに思うよ、ありがとう"}, {"type": "subtitle", "time": 16779.868, "timestamp": "04:39:39", "text": "えっと、どうして止められないのかわからない"}, {"type": "subtitle", "time": 16781.43, "timestamp": "04:39:41", "text": "ゲーム"}, {"type": "subtitle", "time": 16782.39, "timestamp": "04:39:42", "text": "それよりも"}, {"type": "subtitle", "time": 16784.24, "timestamp": "04:39:44", "text": "よりも ああ、一度その気になったらできない"}, {"type": "subtitle", "time": 16796.39, "timestamp": "04:39:56", "text": "やめろ、これは忍者みたいなスキンのコピーだ"}, {"type": "subtitle", "time": 16799.23, "timestamp": "04:39:59", "text": "肌がここに来る、それは文字通り"}]
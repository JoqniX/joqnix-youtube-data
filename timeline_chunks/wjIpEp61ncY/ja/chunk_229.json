[{"type": "subtitle", "time": 13741.83, "timestamp": "03:49:01", "text": "だから私は"}, {"type": "subtitle", "time": 13744.429, "timestamp": "03:49:04", "text": "え、これは私たちのものです、わかりました、私たちは"}, {"type": "subtitle", "time": 13747.51, "timestamp": "03:49:07", "text": "私たちのベッドを守る、これは私たちのベッドです"}, {"type": "subtitle", "time": 13750.48, "timestamp": "03:49:10", "text": "ワセス、ああ、私はしなかった"}, {"type": "subtitle", "time": 13753.469, "timestamp": "03:49:13", "text": "[音楽]"}, {"type": "subtitle", "time": 13756.269, "timestamp": "03:49:16", "text": "知ってるよ"}, {"type": "subtitle", "time": 13772.269, "timestamp": "03:49:32", "text": "ピラミッドはとても"}, {"type": "subtitle", "time": 13774.469, "timestamp": "03:49:34", "text": "変な奴だ"}, {"type": "subtitle", "time": 13777.349, "timestamp": "03:49:37", "text": "全部やらせて、彼にやらせて、私は行く、私は行く"}, {"type": "subtitle", "time": 13780.269, "timestamp": "03:49:40", "text": "私はわざわざPEに行くつもりです"}, {"type": "subtitle", "time": 13792.59, "timestamp": "03:49:52", "text": "[拍手]"}, {"type": "subtitle", "time": 13794.8, "timestamp": "03:49:54", "text": "いやいやいやいや"}, {"type": "subtitle", "time": 13797.95, "timestamp": "03:49:57", "text": "[拍手]"}]
[{"type": "subtitle", "time": 18449.23, "timestamp": "05:07:29", "text": "ああ、彼は試した、彼は試した、私は"}, {"type": "subtitle", "time": 18453.07, "timestamp": "05:07:33", "text": "あなたの努力に感謝します、ブーブー"}, {"type": "subtitle", "time": 18456.47, "timestamp": "05:07:36", "text": "でも大丈夫、あなたは最善を尽くしたから。"}, {"type": "subtitle", "time": 18460.07, "timestamp": "05:07:40", "text": "感謝します、あなたは最善を尽くしました"}, {"type": "subtitle", "time": 18462.59, "timestamp": "05:07:42", "text": "ありがとうございます。"}]
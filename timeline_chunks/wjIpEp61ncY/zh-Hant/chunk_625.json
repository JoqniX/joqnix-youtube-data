[{"type": "subtitle", "time": 37524.15, "timestamp": "10:25:24", "text": "聲音敏感症。所以當時我特別難過，心想：喔不，我該怎麼混音？我該怎麼混鼓？我該怎麼調整均衡器"}, {"type": "subtitle", "time": 37541.07, "timestamp": "10:25:41", "text": "和"}, {"type": "subtitle", "time": 37544.746, "timestamp": "10:25:44", "text": "混音器？我當時真的很難過。是啊，我不知道現在是不是還這樣，"}, {"type": "subtitle", "time": 37546.87, "timestamp": "10:25:46", "text": "但沒關係，我"}, {"type": "subtitle", "time": 37549.586, "timestamp": "10:25:49", "text": "想我們會找到解決辦法的。伊恩，你打算做人聲還是電子"}, {"type": "subtitle", "time": 37554.906, "timestamp": "10:25:54", "text": "音樂？其實我兩個都打算做，因為我會唱歌。"}, {"type": "subtitle", "time": 37557.63, "timestamp": "10:25:57", "text": "自從我開始嘗試唱歌以來，我就一直在想，也許我可以學習唱歌，然後創作"}]
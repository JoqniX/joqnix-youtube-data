[{"type": "subtitle", "time": 31569.228, "timestamp": "08:46:09", "text": "哎呀，我討厭這樣，我得結束了。我想你們看到"}, {"type": "subtitle", "time": 31573.228, "timestamp": "08:46:13", "text": "我的角色變小了，這意味著我剛剛打了個大"}, {"type": "subtitle", "time": 31577.43, "timestamp": "08:46:17", "text": "噴嚏，哦，天哪，好痛啊，"}, {"type": "subtitle", "time": 31585.468, "timestamp": "08:46:25", "text": "是的，哦，天哪，我差點就……呃，暴露我的噴嚏了，哦，"}, {"type": "subtitle", "time": 31590.35, "timestamp": "08:46:30", "text": "我的天哪，謝天謝地我把它靜音了，哦，天哪，哦，它又來了。我這就結束，好的，"}, {"type": "subtitle", "time": 31599.91, "timestamp": "08:46:39", "text": "我這結束。"}, {"type": "subtitle", "time": 31602.15, "timestamp": "08:46:42", "text": "所以"}]
[{"type": "subtitle", "time": 5651.709, "timestamp": "01:34:11", "text": "朋友在哪裡？我要把它幹掉。在這邊，在這邊。它在哪裡？哦，"}, {"type": "subtitle", "time": 5688.8, "timestamp": "01:34:48", "text": "我要帶你去看看這該死的世界，混蛋。好吧，你怎麼敢不死？我知道這裡。"}, {"type": "subtitle", "time": 5697.59, "timestamp": "01:34:57", "text": "你怎麼敢？哦，它，它，它，哦，天哪，它在"}]
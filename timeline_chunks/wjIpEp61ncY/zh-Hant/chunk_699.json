[{"type": "subtitle", "time": 41949.47, "timestamp": "11:39:09", "text": "不得不重錄了37次，我的天哪，太痛苦了，"}, {"type": "subtitle", "time": 41975.03, "timestamp": "11:39:35", "text": "度過了一個美好的早晨，還有，大家要多"}, {"type": "subtitle", "time": 41985.71, "timestamp": "11:39:45", "text": "喝水，別忘了多喝水，是啊，所以，嗯，等等，我剛才說到哪兒了，嗯，"}]
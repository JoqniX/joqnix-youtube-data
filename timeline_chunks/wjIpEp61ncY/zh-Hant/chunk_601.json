[{"type": "subtitle", "time": 36062.39, "timestamp": "10:01:02", "text": "電腦傳來，我的電腦傳來，我得買個"}, {"type": "subtitle", "time": 36066.23, "timestamp": "10:01:06", "text": "不停的電腦。店裡那個"}, {"type": "subtitle", "time": 36069.106, "timestamp": "10:01:09", "text": "檢查主機板和"}, {"type": "subtitle", "time": 36071.586, "timestamp": "10:01:11", "text": "CPU的人說，是啊，你最好買新的"}, {"type": "subtitle", "time": 36074.106, "timestamp": "10:01:14", "text": "CPU。我當時"}, {"type": "subtitle", "time": 36080.79, "timestamp": "10:01:20", "text": "感覺心都碎了，心想"}, {"type": "subtitle", "time": 36089.95, "timestamp": "10:01:29", "text": "為什麼。不過還好，"}, {"type": "subtitle", "time": 36092.83, "timestamp": "10:01:32", "text": "至少我還有兩台電腦，"}, {"type": "subtitle", "time": 36097.35, "timestamp": "10:01:37", "text": "所以我還能用"}, {"type": "subtitle", "time": 36099.67, "timestamp": "10:01:39", "text": "我的直播"}, {"type": "subtitle", "time": 36104.35, "timestamp": "10:01:44", "text": "電腦直播。 CPU和電源都壞了。"}, {"type": "subtitle", "time": 36107.15, "timestamp": "10:01:47", "text": "說到電源，我"}, {"type": "subtitle", "time": 36110.71, "timestamp": "10:01:50", "text": "想了想，如果我買個"}, {"type": "subtitle", "time": 36113.266, "timestamp": "10:01:53", "text": "模組化電源，就不用換"}, {"type": "subtitle", "time": 36116.266, "timestamp": "10:01:56", "text": "整個電源了，對吧？如果我的"}, {"type": "subtitle", "time": 36118.87, "timestamp": "10:01:58", "text": "電源壞了，或者電路短路了，"}]
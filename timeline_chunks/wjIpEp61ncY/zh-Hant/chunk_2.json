[{"type": "subtitle", "time": 124.27, "timestamp": "00:02:04", "text": "[音樂]"}, {"type": "subtitle", "time": 128.669, "timestamp": "00:02:08", "text": "好吧，那我開始了。呃，還是你想讓我等？"}, {"type": "subtitle", "time": 132.27, "timestamp": "00:02:12", "text": "我得去拿。我可以退出嗎？"}, {"type": "subtitle", "time": 135.589, "timestamp": "00:02:15", "text": "現在在"}, {"type": "subtitle", "time": 138.22899999999998, "timestamp": "00:02:18", "text": "堡壘之夜裡可以退出嗎？什麼？什麼？你說的「"}, {"type": "subtitle", "time": 139.79, "timestamp": "00:02:19", "text": "我可以退出嗎？」是什麼意思？退出？退出？退出？"}, {"type": "subtitle", "time": 143.71, "timestamp": "00:02:23", "text": "派對？退出？退出？對吧？"}, {"type": "subtitle", "time": 148.03, "timestamp": "00:02:28", "text": "哦，當然可以。"}, {"type": "subtitle", "time": 150.71, "timestamp": "00:02:30", "text": "在堡壘之夜裡怎麼操作？"}, {"type": "subtitle", "time": 152.03, "timestamp": "00:02:32", "text": "呃，按"}, {"type": "subtitle", "time": 156.589, "timestamp": "00:02:36", "text": "Esc鍵，然後在右邊"}, {"type": "subtitle", "time": 159.149, "timestamp": "00:02:39", "text": "你會看到你的…我們的派對，對吧？你"}, {"type": "subtitle", "time": 162.949, "timestamp": "00:02:42", "text": "只要點擊「離開派對」就"}]
[{"type": "subtitle", "time": 4803.95, "timestamp": "01:20:03", "text": "我們是不是打開了這個。哇，不，我們沒有。他要"}, {"type": "subtitle", "time": 4813.99, "timestamp": "01:20:13", "text": "拿到它"}, {"type": "subtitle", "time": 4826.51, "timestamp": "01:20:26", "text": "六個小時。六個小時。是的，因為我今天在旅行。哦，你今天回家了。是的，那"}, {"type": "subtitle", "time": 4828.149, "timestamp": "01:20:28", "text": "你應該休息。我在吃飯。我現在也累了，所以我不會……我也不喜歡晚餐後馬上睡覺，所以"}, {"type": "subtitle", "time": 4838.03, "timestamp": "01:20:38", "text": "一會兒。"}, {"type": "subtitle", "time": 4847.47, "timestamp": "01:20:47", "text": "哦，我已經好久沒玩遊戲了。啊，我想玩Niki，我真的很喜歡那個"}]
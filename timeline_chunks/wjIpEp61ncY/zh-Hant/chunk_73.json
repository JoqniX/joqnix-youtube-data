[{"type": "subtitle", "time": 4380.629, "timestamp": "01:13:00", "text": "我沒有"}, {"type": "subtitle", "time": 4383.95, "timestamp": "01:13:03", "text": "彈藥。我們去哥譚吧。它不是夜城，它是白天。對，它不是黑夜之城。為什麼不是夜城？等等，一個金人"}, {"type": "subtitle", "time": 4387.03, "timestamp": "01:13:07", "text": "打倒了一個金人。原子武士丟下皇冠。"}, {"type": "subtitle", "time": 4415.75, "timestamp": "01:13:35", "text": "砸碎原子武士。怎麼回事？你看到皇冠的位置了嗎？是的，那裡發生了什麼事。哦，你想去搶劫嗎？我有物品。好的，"}, {"type": "subtitle", "time": 4424.07, "timestamp": "01:13:44", "text": "但我需要"}, {"type": "subtitle", "time": 4425.51, "timestamp": "01:13:45", "text": "彈藥。是的，我也是。哦，"}]
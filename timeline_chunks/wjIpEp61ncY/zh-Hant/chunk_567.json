[{"type": "subtitle", "time": 34028.906, "timestamp": "09:27:08", "text": "你為什麼又提到這個了？哦，對了，我家裡還有一包GL Cony，不過是普通版的。你在廣告裡看到的是橘子"}, {"type": "subtitle", "time": 34031.95, "timestamp": "09:27:11", "text": "口味的，我喝的是普通版的。"}, {"type": "subtitle", "time": 34043.07, "timestamp": "09:27:23", "text": "我以前喝過，我想我應該還在，"}, {"type": "subtitle", "time": 34052.266, "timestamp": "09:27:32", "text": "我好像在"}, {"type": "subtitle", "time": 34054.906, "timestamp": "09:27:34", "text": "Phas網站上看過包裝袋，我好像還在，我記不清了。我有時候會喝葡萄糖水，因為葡萄糖水對身體有好處，當你覺得虛弱什麼的時候。以前"}, {"type": "subtitle", "time": 34070.586, "timestamp": "09:27:50", "text": "我常運動什麼的，嗯，這都是很久以前的事了。我有沒有跟你們說過？關於"}]
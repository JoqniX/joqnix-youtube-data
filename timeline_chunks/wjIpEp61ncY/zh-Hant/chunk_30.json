[{"type": "subtitle", "time": 1817.149, "timestamp": "00:30:17", "text": "空投。我"}, {"type": "subtitle", "time": 1824.19, "timestamp": "00:30:24", "text": "不能那樣做，這遊戲不是這樣玩的。我可以，我可以嘗試和平主義。這在"}, {"type": "subtitle", "time": 1835.11, "timestamp": "00:30:35", "text": "像PUBG這樣的普通VR遊戲中是有效的。在這個遊戲中，"}, {"type": "subtitle", "time": 1841.47, "timestamp": "00:30:41", "text": "我不知道，我不想。 A B，我可以放嗎？"}, {"type": "subtitle", "time": 1852.789, "timestamp": "00:30:52", "text": "這不是戰利品嗎？我死了嗎？我死了。是的，這就是我們不喜歡這個模式的原因。他們根本不讓我搜刮。 H，我還以為人們在其他地方戰鬥。"}]
[{"type": "subtitle", "time": 13260.52, "timestamp": "03:41:00", "text": "Better. Wait, what is that?"}, {"type": "subtitle", "time": 13274.309, "timestamp": "03:41:14", "text": "I owed money. There's a fellow. He"}, {"type": "subtitle", "time": 13276.389, "timestamp": "03:41:16", "text": "offered to wipe away my debt in exchange"}, {"type": "subtitle", "time": 13278.01, "timestamp": "03:41:18", "text": "for you."}, {"type": "subtitle", "time": 13290.79, "timestamp": "03:41:30", "text": "Come on. Everything's going to be okay."}, {"type": "subtitle", "time": 13292.389, "timestamp": "03:41:32", "text": "Will you just turn around and talk to"}, {"type": "subtitle", "time": 13316.63, "timestamp": "03:41:56", "text": "I'mma add it to the playlist."}]
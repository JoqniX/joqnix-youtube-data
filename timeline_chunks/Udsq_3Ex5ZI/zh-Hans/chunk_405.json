[{"type": "subtitle", "time": 24302.07, "timestamp": "06:45:02", "text": "有点累了。"}, {"type": "subtitle", "time": 24305.35, "timestamp": "06:45:05", "text": "我昨天打开了Zuki的直播。"}, {"type": "subtitle", "time": 24309.948, "timestamp": "06:45:09", "text": "呃，她直播的时间是11:15吗？"}, {"type": "subtitle", "time": 24314.03, "timestamp": "06:45:14", "text": "昨天晚上11点。"}, {"type": "subtitle", "time": 24318.868, "timestamp": "06:45:18", "text": "我曾是一条溪流。嗯，是啊，我当时就想……"}, {"type": "subtitle", "time": 24322.948, "timestamp": "06:45:22", "text": "就像躺下一样。呃，我的脖子朝向"}, {"type": "subtitle", "time": 24325.11, "timestamp": "06:45:25", "text": "右"}, {"type": "subtitle", "time": 24328.628, "timestamp": "06:45:28", "text": "呃，就像篮子一样，不是……"}, {"type": "subtitle", "time": 24331.548, "timestamp": "06:45:31", "text": "篮子状的。你管它叫什么？"}, {"type": "subtitle", "time": 24333.65, "timestamp": "06:45:33", "text": "斯坦迪什 斯坦迪什"}, {"type": "subtitle", "time": 24335.83, "timestamp": "06:45:35", "text": "[音乐]"}, {"type": "subtitle", "time": 24339.51, "timestamp": "06:45:39", "text": "呃，坚持要保留手机？我 我"}, {"type": "subtitle", "time": 24341.788, "timestamp": "06:45:41", "text": "我没有手机"}, {"type": "subtitle", "time": 24346.07, "timestamp": "06:45:46", "text": "覆盖。不，我"}, {"type": "subtitle", "time": 24349.51, "timestamp": "06:45:49", "text": "呃，我不知道。你看到那条鱼了吗？"}, {"type": "subtitle", "time": 24353.19, "timestamp": "06:45:53", "text": "电影？我不知道。我觉得我的"}, {"type": "subtitle", "time": 24357.708, "timestamp": "06:45:57", "text": "他是我表弟，他当时在用我的电脑，对吧？"}]
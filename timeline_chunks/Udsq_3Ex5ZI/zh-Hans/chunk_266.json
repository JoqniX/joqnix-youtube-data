[{"type": "subtitle", "time": 15961.389, "timestamp": "04:26:01", "text": "这些视频来自"}, {"type": "subtitle", "time": 15965.59, "timestamp": "04:26:05", "text": "他就像……我觉得就像……就像"}, {"type": "subtitle", "time": 15969.149, "timestamp": "04:26:09", "text": "就像来自他"}, {"type": "subtitle", "time": 15972.429, "timestamp": "04:26:12", "text": "就像真的从他那里流出来一样"}, {"type": "subtitle", "time": 15975.99, "timestamp": "04:26:15", "text": "溪流。等等，他的编辑们是不是放了个……"}, {"type": "subtitle", "time": 15982.03, "timestamp": "04:26:22", "text": "那结尾呢？我可以问一下吗？好的，就……"}, {"type": "subtitle", "time": 15986.55, "timestamp": "04:26:26", "text": "呃，好的，他们会加结尾吗？我认为"}, {"type": "subtitle", "time": 15989.269, "timestamp": "04:26:29", "text": "他们现在不再加片尾曲了。我会"}, {"type": "subtitle", "time": 15991.99, "timestamp": "04:26:31", "text": "绝对会。等等，等等，"}, {"type": "subtitle", "time": 15994.389, "timestamp": "04:26:34", "text": "等等，等等。他他们我看到了基本的编辑"}, {"type": "subtitle", "time": 15996.189, "timestamp": "04:26:36", "text": "事物"}, {"type": "subtitle", "time": 15999.469, "timestamp": "04:26:39", "text": "这里。我看到一些基本的编辑"}, {"type": "subtitle", "time": 16003.309, "timestamp": "04:26:43", "text": "事物。该死。"}, {"type": "subtitle", "time": 16007.149, "timestamp": "04:26:47", "text": "好的，这里做了一些基本的编辑。"}]
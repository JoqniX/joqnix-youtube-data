[{"type": "subtitle", "time": 29842.07, "timestamp": "08:17:22", "text": "谁在给你口交"}, {"type": "subtitle", "time": 29851.03, "timestamp": "08:17:31", "text": "头带，因为头带是我们……"}, {"type": "subtitle", "time": 29853.708, "timestamp": "08:17:33", "text": "每个人都提了很多要求，"}, {"type": "subtitle", "time": 29856.59, "timestamp": "08:17:36", "text": "正确的？是的，我"}, {"type": "subtitle", "time": 29859.51, "timestamp": "08:17:39", "text": "我以为我有时应该"}, {"type": "subtitle", "time": 29866.388, "timestamp": "08:17:46", "text": "问题儿童。是的，那边在叫我"}, {"type": "subtitle", "time": 29875.788, "timestamp": "08:17:55", "text": "有时。"}]
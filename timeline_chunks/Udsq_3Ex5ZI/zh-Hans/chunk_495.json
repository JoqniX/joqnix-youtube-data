[{"type": "subtitle", "time": 29703.708, "timestamp": "08:15:03", "text": "[音乐]"}, {"type": "subtitle", "time": 29706.628, "timestamp": "08:15:06", "text": "想知道我把这个游戏叫做什么吗？但"}, {"type": "subtitle", "time": 29708.708, "timestamp": "08:15:08", "text": "不用担心。但我想知道我"}, {"type": "subtitle", "time": 29710.67, "timestamp": "08:15:10", "text": "把这个游戏叫做"}, {"type": "subtitle", "time": 29713.19, "timestamp": "08:15:13", "text": "由你。想知道我把这个叫做什么吗？"}, {"type": "subtitle", "time": 29736.31, "timestamp": "08:15:36", "text": "你？我的天啊。"}, {"type": "subtitle", "time": 29748.948, "timestamp": "08:15:48", "text": "嘿，不错。你好吗？我也在做"}]
[{"type": "subtitle", "time": 10501.429, "timestamp": "02:55:01", "text": "请不要滑倒。请不要滑倒。"}, {"type": "subtitle", "time": 10503.19, "timestamp": "02:55:03", "text": "请不要滑倒。你知道你会"}, {"type": "subtitle", "time": 10510.75, "timestamp": "02:55:10", "text": "去。我们差点就死了。差点死了"}, {"type": "subtitle", "time": 10515.23, "timestamp": "02:55:15", "text": "再次。所以怀旧很难，"}, {"type": "subtitle", "time": 10529.71, "timestamp": "02:55:29", "text": "惊慌失措。不，不，不，不"}, {"type": "subtitle", "time": 10534.15, "timestamp": "02:55:34", "text": "不。我的天啊。我当时"}, {"type": "subtitle", "time": 10537.79, "timestamp": "02:55:37", "text": "我当时大声尖叫"}, {"type": "subtitle", "time": 10540.99, "timestamp": "02:55:40", "text": "兄弟，给你。你好，"}, {"type": "subtitle", "time": 10556.99, "timestamp": "02:55:56", "text": "[音乐]"}]
[{"type": "subtitle", "time": 8765.91, "timestamp": "02:26:05", "text": "事情完成了。接下来是绝地求生。我希望我"}, {"type": "subtitle", "time": 8768.91, "timestamp": "02:26:08", "text": "想多玩几局绝地求生，"}, {"type": "subtitle", "time": 8774.19, "timestamp": "02:26:14", "text": "男人。我想念玩绝地求生的日子。战场。"}, {"type": "subtitle", "time": 8782.95, "timestamp": "02:26:22", "text": "哦，那是个球员。那是我们的"}, {"type": "subtitle", "time": 8784.99, "timestamp": "02:26:24", "text": "团队。我的天啊。我太"}, {"type": "subtitle", "time": 8787.63, "timestamp": "02:26:27", "text": "对不起。你是谁？"}, {"type": "subtitle", "time": 8806.309, "timestamp": "02:26:46", "text": "那时候我真是太酷了。"}]
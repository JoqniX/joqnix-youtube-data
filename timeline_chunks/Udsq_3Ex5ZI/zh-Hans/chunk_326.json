[{"type": "subtitle", "time": 19568.27, "timestamp": "05:26:08", "text": "这"}, {"type": "subtitle", "time": 19571.15, "timestamp": "05:26:11", "text": "也很糟糕。谢谢你给我打电话"}, {"type": "subtitle", "time": 19575.11, "timestamp": "05:26:15", "text": "昨天虽然我没醒"}, {"type": "subtitle", "time": 19579.83, "timestamp": "05:26:19", "text": "即使像“让我看看”那样，即使这样……"}, {"type": "subtitle", "time": 19582.55, "timestamp": "05:26:22", "text": "我昨天接到了很多电话。"}, {"type": "subtitle", "time": 19585.82, "timestamp": "05:26:25", "text": "呃，在Zuki直播期间"}, {"type": "subtitle", "time": 19593.03, "timestamp": "05:26:33", "text": "一，是的，他们是10。"}, {"type": "subtitle", "time": 19597.07, "timestamp": "05:26:37", "text": "[音乐]"}, {"type": "subtitle", "time": 19599.99, "timestamp": "05:26:39", "text": "再加上很多人，我是说10个人。"}, {"type": "subtitle", "time": 19604.47, "timestamp": "05:26:44", "text": "打电话过去，但试图给我打电话，但是呃……"}, {"type": "subtitle", "time": 19608.07, "timestamp": "05:26:48", "text": "每人两到三次。我仍然"}, {"type": "subtitle", "time": 19609.868, "timestamp": "05:26:49", "text": "没醒"}, {"type": "subtitle", "time": 19614.23, "timestamp": "05:26:54", "text": "向上。所以，我的表弟在这里。"}, {"type": "subtitle", "time": 19617.948, "timestamp": "05:26:57", "text": "我的呃，两个呃，他在这里"}]
[{"type": "subtitle", "time": 23522.75, "timestamp": "06:32:02", "text": "害怕的。什么？娜妮"}, {"type": "subtitle", "time": 23525.83, "timestamp": "06:32:05", "text": "它就一直在那里，自从"}, {"type": "subtitle", "time": 23528.708, "timestamp": "06:32:08", "text": "YouTube 开始推出直播功能"}, {"type": "subtitle", "time": 23533.23, "timestamp": "06:32:13", "text": "直播中断了，我们没看到。"}, {"type": "subtitle", "time": 23535.99, "timestamp": "06:32:15", "text": "知道大家今天过得怎么样，也开心"}, {"type": "subtitle", "time": 23536.99, "timestamp": "06:32:16", "text": "生日快乐"}, {"type": "subtitle", "time": 23540.31, "timestamp": "06:32:20", "text": "祖基，我为睡着深表歉意"}, {"type": "subtitle", "time": 23553.948, "timestamp": "06:32:33", "text": "我怎么这么困？因为我"}, {"type": "subtitle", "time": 23558.23, "timestamp": "06:32:38", "text": "呃，我坐在这个热乎乎的……什么？什么？"}, {"type": "subtitle", "time": 23560.75, "timestamp": "06:32:40", "text": "你把热叫做什么？"}, {"type": "subtitle", "time": 23563.51, "timestamp": "06:32:43", "text": "敲诈勒索？中暑。那是什么？"}, {"type": "subtitle", "time": 23565.548, "timestamp": "06:32:45", "text": "叫什么？你管它叫什么？"}, {"type": "subtitle", "time": 23568.43, "timestamp": "06:32:48", "text": "那？那叫什么？我"}, {"type": "subtitle", "time": 23573.15, "timestamp": "06:32:53", "text": "我忘了那件事。我也有那种"}, {"type": "subtitle", "time": 23575.59, "timestamp": "06:32:55", "text": "事物。住口。睡眠源于"}, {"type": "subtitle", "time": 23579.27, "timestamp": "06:32:59", "text": "无处。是的，Zuki变成了1K。"}]
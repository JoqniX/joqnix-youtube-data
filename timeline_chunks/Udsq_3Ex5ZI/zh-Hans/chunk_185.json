[{"type": "subtitle", "time": 11102.91, "timestamp": "03:05:02", "text": "死。请不要死。请不要"}, {"type": "subtitle", "time": 11111.87, "timestamp": "03:05:11", "text": "不。我的天哪。上帝，"}, {"type": "subtitle", "time": 11113.91, "timestamp": "03:05:13", "text": "上帝。求求你，求求你，求求你，求求你"}, {"type": "subtitle", "time": 11115.269, "timestamp": "03:05:15", "text": "求求你，求求你，求求你。我为什么会这样"}, {"type": "subtitle", "time": 11117.269, "timestamp": "03:05:17", "text": "攻击？我为什么要发动攻击？我为什么会这样"}, {"type": "subtitle", "time": 11118.87, "timestamp": "03:05:18", "text": "攻击？求求你，求求你，求求你，求求你"}, {"type": "subtitle", "time": 11120.63, "timestamp": "03:05:20", "text": "求求你了。在一个人身上，在一个人身上"}, {"type": "subtitle", "time": 11123.75, "timestamp": "03:05:23", "text": "一个男人身上的肌肉，一个男人身上的肌肉，一个男人身上的肌肉"}, {"type": "subtitle", "time": 11131.389, "timestamp": "03:05:31", "text": "回家去。我有时做不到，我真的做不到。"}, {"type": "subtitle", "time": 11135.19, "timestamp": "03:05:35", "text": "相信我就是那个说出“谁”的人"}, {"type": "subtitle", "time": 11137.99, "timestamp": "03:05:37", "text": "我说了所有这些话。"}, {"type": "subtitle", "time": 11140.87, "timestamp": "03:05:40", "text": "我的天哪，我简直不敢相信"}]
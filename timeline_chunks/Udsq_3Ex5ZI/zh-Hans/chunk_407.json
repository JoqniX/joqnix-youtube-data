[{"type": "subtitle", "time": 24421.23, "timestamp": "06:47:01", "text": "是的，我和家人一起出去了。"}, {"type": "subtitle", "time": 24424.948, "timestamp": "06:47:04", "text": "昨天。去了，是的，我们去了"}, {"type": "subtitle", "time": 24427.83, "timestamp": "06:47:07", "text": "一个购物中心，是的，我们和一个男人闲逛。什么时候"}, {"type": "subtitle", "time": 24430.39, "timestamp": "06:47:10", "text": "说到走路，我正在走路"}, {"type": "subtitle", "time": 24433.468, "timestamp": "06:47:13", "text": "很多。我好累啊"}, {"type": "subtitle", "time": 24436.43, "timestamp": "06:47:16", "text": "容易地。所以，对于一个内向的人来说，就是这样。"}, {"type": "subtitle", "time": 24438.83, "timestamp": "06:47:18", "text": "还算正常。但"}, {"type": "subtitle", "time": 24444.468, "timestamp": "06:47:24", "text": "尽管如此，我还是回家了。我几乎不"}, {"type": "subtitle", "time": 24447.51, "timestamp": "06:47:27", "text": "也就是说，我设法吃了一些晚餐。"}, {"type": "subtitle", "time": 24451.35, "timestamp": "06:47:31", "text": "我睡了一会儿。"}, {"type": "subtitle", "time": 24453.51, "timestamp": "06:47:33", "text": "然后他们醒了，也把我叫醒了，呃，去……"}, {"type": "subtitle", "time": 24456.468, "timestamp": "06:47:36", "text": "一些能帮上忙的东西。我不得不帮助我的"}, {"type": "subtitle", "time": 24459.23, "timestamp": "06:47:39", "text": "祖母和"}, {"type": "subtitle", "time": 24463.19, "timestamp": "06:47:43", "text": "东西。然后我就醒了，然后……我想"}, {"type": "subtitle", "time": 24465.67, "timestamp": "06:47:45", "text": "那是我让表弟玩的时候。"}, {"type": "subtitle", "time": 24469.19, "timestamp": "06:47:49", "text": "我用电脑一会儿。是啊，我刚睡着了。"}]
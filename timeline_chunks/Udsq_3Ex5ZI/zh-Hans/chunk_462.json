[{"type": "subtitle", "time": 27721.948, "timestamp": "07:42:01", "text": "官方公共"}, {"type": "subtitle", "time": 27725.51, "timestamp": "07:42:05", "text": "公告有两个账号。一支AR55"}, {"type": "subtitle", "time": 27727.31, "timestamp": "07:42:07", "text": "和一"}, {"type": "subtitle", "time": 27732.23, "timestamp": "07:42:12", "text": "AR56 等 46。哦，不错。等等，两个"}, {"type": "subtitle", "time": 27734.628, "timestamp": "07:42:14", "text": "两个独立账户，一个账户"}, {"type": "subtitle", "time": 27745.23, "timestamp": "07:42:25", "text": "你如何跟踪"}, {"type": "subtitle", "time": 27754.83, "timestamp": "07:42:34", "text": "[音乐]"}, {"type": "subtitle", "time": 27757.27, "timestamp": "07:42:37", "text": "难的？那真是太方便了。"}, {"type": "subtitle", "time": 27759.43, "timestamp": "07:42:39", "text": "正确的？你只需要登录一个账号。"}, {"type": "subtitle", "time": 27764.11, "timestamp": "07:42:44", "text": "帐户。就我而言，我赞成45"}, {"type": "subtitle", "time": 27769.19, "timestamp": "07:42:49", "text": "团伙。我之后就再也没升级过。"}, {"type": "subtitle", "time": 27774.11, "timestamp": "07:42:54", "text": "嗯，大概一两年前开始的。"}, {"type": "subtitle", "time": 27778.07, "timestamp": "07:42:58", "text": "是的。不，源氏是两年前出现的。是的。"}]
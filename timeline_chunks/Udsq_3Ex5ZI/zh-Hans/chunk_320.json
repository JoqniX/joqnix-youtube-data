[{"type": "subtitle", "time": 19202.15, "timestamp": "05:20:02", "text": "好的。好的。听听你们的。但"}, {"type": "subtitle", "time": 19217.43, "timestamp": "05:20:17", "text": "像 Twitch 这样的技术，当移动用户使用时"}, {"type": "subtitle", "time": 19220.628, "timestamp": "05:20:20", "text": "当我能够观看我的直播时"}, {"type": "subtitle", "time": 19225.99, "timestamp": "05:20:25", "text": "这让我非常痛苦，我……呃……我喜欢……"}, {"type": "subtitle", "time": 19228.07, "timestamp": "05:20:28", "text": "就像流媒体一样，一遍又一遍地播放。"}, {"type": "subtitle", "time": 19230.47, "timestamp": "05:20:30", "text": "终于开始转码了"}, {"type": "subtitle", "time": 19232.868, "timestamp": "05:20:32", "text": "Twitch，以便人们可以更改"}, {"type": "subtitle", "time": 19234.788, "timestamp": "05:20:34", "text": "质量和"}, {"type": "subtitle", "time": 19237.27, "timestamp": "05:20:37", "text": "太高兴了。现在它已经上传到YouTube了。"}, {"type": "subtitle", "time": 19239.47, "timestamp": "05:20:39", "text": "这是油漆。"}, {"type": "subtitle", "time": 19241.23, "timestamp": "05:20:41", "text": "那里。好的"}, {"type": "subtitle", "time": 19247.31, "timestamp": "05:20:47", "text": "浅黄色。"}, {"type": "subtitle", "time": 19250.708, "timestamp": "05:20:50", "text": "嘿，大家今天过得怎么样？呃，零号硬币"}, {"type": "subtitle", "time": 19252.99, "timestamp": "05:20:52", "text": "zuki 硬币"}, {"type": "subtitle", "time": 19256.15, "timestamp": "05:20:56", "text": "硬币。如果你在这里看着我，我看到你了。"}, {"type": "subtitle", "time": 19259.27, "timestamp": "05:20:59", "text": "大家今天过得怎么样？我可以要一个热的吗？"}]
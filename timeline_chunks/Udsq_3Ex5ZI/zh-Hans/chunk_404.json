[{"type": "subtitle", "time": 24244.31, "timestamp": "06:44:04", "text": "即使像“让我检查一下”那样。如何"}, {"type": "subtitle", "time": 24245.868, "timestamp": "06:44:05", "text": "我接到了很多电话。"}, {"type": "subtitle", "time": 24250.41, "timestamp": "06:44:10", "text": "昨天？呃，在 Zuki 直播期间"}, {"type": "subtitle", "time": 24258.27, "timestamp": "06:44:18", "text": "两个10"}, {"type": "subtitle", "time": 24260.19, "timestamp": "06:44:20", "text": "加"}, {"type": "subtitle", "time": 24261.708, "timestamp": "06:44:21", "text": "[音乐]"}, {"type": "subtitle", "time": 24264.548, "timestamp": "06:44:24", "text": "天哪，很多人，我是说10个人。"}, {"type": "subtitle", "time": 24269.03, "timestamp": "06:44:29", "text": "打电话过去，但试图给我打电话，但是呃……"}, {"type": "subtitle", "time": 24272.628, "timestamp": "06:44:32", "text": "每人两到三次，我仍然"}, {"type": "subtitle", "time": 24275.51, "timestamp": "06:44:35", "text": "没醒。"}, {"type": "subtitle", "time": 24279.75, "timestamp": "06:44:39", "text": "所以，我的表弟在这里"}, {"type": "subtitle", "time": 24282.59, "timestamp": "06:44:42", "text": "呃，我的意思是，呃，他在这里"}, {"type": "subtitle", "time": 24286.628, "timestamp": "06:44:46", "text": "大约一周左右，或者两周左右。所以他"}, {"type": "subtitle", "time": 24288.91, "timestamp": "06:44:48", "text": "昨天在看电影，但是"}, {"type": "subtitle", "time": 24292.83, "timestamp": "06:44:52", "text": "想想10点11分的事"}, {"type": "subtitle", "time": 24295.75, "timestamp": "06:44:55", "text": "下午左右。我当时就躺在床上"}, {"type": "subtitle", "time": 24299.35, "timestamp": "06:44:59", "text": "用手机浏览网页。我当时非常累。"}]
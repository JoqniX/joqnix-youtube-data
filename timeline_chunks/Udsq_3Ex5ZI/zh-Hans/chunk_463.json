[{"type": "subtitle", "time": 27780.91, "timestamp": "07:43:00", "text": "所以，首先……"}, {"type": "subtitle", "time": 27783.388, "timestamp": "07:43:03", "text": "9 年"}, {"type": "subtitle", "time": 27791.67, "timestamp": "07:43:11", "text": "45. 老兄，如果是《幻想之塔》的话，我"}, {"type": "subtitle", "time": 27794.628, "timestamp": "07:43:14", "text": "我现在会哭，因为……"}, {"type": "subtitle", "time": 27797.548, "timestamp": "07:43:17", "text": "原神是如何达到顶峰的。即使你是"}, {"type": "subtitle", "time": 27799.548, "timestamp": "07:43:19", "text": "封盖，硬"}, {"type": "subtitle", "time": 27803.15, "timestamp": "07:43:23", "text": "达到上限后，你将拥有足够的经验值。"}, {"type": "subtitle", "time": 27807.388, "timestamp": "07:43:27", "text": "比如达到最高等级之类的，"}, {"type": "subtitle", "time": 27811.35, "timestamp": "07:43:31", "text": "正确的？但是，随着《幻想之塔》"}, {"type": "subtitle", "time": 27815.99, "timestamp": "07:43:35", "text": "东西，它不会保留你的进度经验值。"}, {"type": "subtitle", "time": 27818.708, "timestamp": "07:43:38", "text": "更痛苦了。"}, {"type": "subtitle", "time": 27835.788, "timestamp": "07:43:55", "text": "快的。我们开始吧"}, {"type": "subtitle", "time": 27839.948, "timestamp": "07:43:59", "text": "去美国，然后带上AR46"}]
[{"type": "subtitle", "time": 4260.47, "timestamp": "01:11:00", "text": "是的，这可能是我第一次……"}, {"type": "subtitle", "time": 4264.43, "timestamp": "01:11:04", "text": "第一个加入直播的人。"}, {"type": "subtitle", "time": 4266.59, "timestamp": "01:11:06", "text": "是的。是的。"}, {"type": "subtitle", "time": 4271.87, "timestamp": "01:11:11", "text": "是的。等等，我的追踪功能好像出了问题。"}, {"type": "subtitle", "time": 4273.63, "timestamp": "01:11:13", "text": "嗯。"}, {"type": "subtitle", "time": 4276.95, "timestamp": "01:11:16", "text": "有趣的。是的。因为，呃，什么？"}, {"type": "subtitle", "time": 4278.63, "timestamp": "01:11:18", "text": "你管它叫什么？"}, {"type": "subtitle", "time": 4282.55, "timestamp": "01:11:22", "text": "因为，呃，我还没有……"}, {"type": "subtitle", "time": 4286.07, "timestamp": "01:11:26", "text": "还没把摄像头装好呢。所以"}, {"type": "subtitle", "time": 4288.03, "timestamp": "01:11:28", "text": "它是"}, {"type": "subtitle", "time": 4292.63, "timestamp": "01:11:32", "text": "疼痛。这将加快进程。我需要"}, {"type": "subtitle", "time": 4295.83, "timestamp": "01:11:35", "text": "去拿我的显示器。我的天哪，是"}, {"type": "subtitle", "time": 4298.35, "timestamp": "01:11:38", "text": "现在更小了。我的天哪。"}, {"type": "subtitle", "time": 4303.11, "timestamp": "01:11:43", "text": "不。孩子，我该如何才能出人头地？来。"}, {"type": "subtitle", "time": 4316.03, "timestamp": "01:11:56", "text": "追踪。不，等等。我够不着。"}, {"type": "subtitle", "time": 4318.43, "timestamp": "01:11:58", "text": "不，不"}]
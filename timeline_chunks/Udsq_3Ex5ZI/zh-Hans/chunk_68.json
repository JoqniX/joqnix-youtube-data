[{"type": "subtitle", "time": 4097.87, "timestamp": "01:08:17", "text": "我刚和我的偶像通完电话。"}, {"type": "subtitle", "time": 4102.55, "timestamp": "01:08:22", "text": "朋友。邻居有台笔记本电脑"}, {"type": "subtitle", "time": 4105.189, "timestamp": "01:08:25", "text": "砰砰一声，他正在做"}, {"type": "subtitle", "time": 4109.03, "timestamp": "01:08:29", "text": "作业之类的。所以他问我是否"}, {"type": "subtitle", "time": 4112.229, "timestamp": "01:08:32", "text": "如果我有一台笔记本电脑就好了。我说我不。我"}, {"type": "subtitle", "time": 4114.309, "timestamp": "01:08:34", "text": "我有一台电脑，而且他知道我有一台电脑。"}, {"type": "subtitle", "time": 4115.07, "timestamp": "01:08:35", "text": "正在做"}, {"type": "subtitle", "time": 4118.149, "timestamp": "01:08:38", "text": "乔森。我跟他说起我的东西。"}, {"type": "chat", "time": 4119.359, "timestamp": "01:08:39", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "lmao"}, {"type": "subtitle", "time": 4122.07, "timestamp": "01:08:42", "text": "很久以前。所以我向他解释了那是什么。"}, {"type": "subtitle", "time": 4124.55, "timestamp": "01:08:44", "text": "以及所有的一切。我想他看到了我的"}, {"type": "subtitle", "time": 4126.43, "timestamp": "01:08:46", "text": "Instagram"}, {"type": "chat", "time": 4126.457, "timestamp": "01:08:46", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Joq's Activity State is Toilet-Break"}, {"type": "subtitle", "time": 4128.99, "timestamp": "01:08:48", "text": "故事。哦，我的"}, {"type": "subtitle", "time": 4130.749, "timestamp": "01:08:50", "text": "上帝。"}, {"type": "subtitle", "time": 4133.709, "timestamp": "01:08:53", "text": "嗯，但是"}, {"type": "subtitle", "time": 4137.269, "timestamp": "01:08:57", "text": "嗯，我去休息一下，一会儿就回来。"}, {"type": "subtitle", "time": 4139.03, "timestamp": "01:08:59", "text": "后退。好的，我先去趟洗手间。"}]
[{"type": "subtitle", "time": 6908.83, "timestamp": "01:55:08", "text": "夹子。我的凡人"}, {"type": "subtitle", "time": 6910.51, "timestamp": "01:55:10", "text": "出现故障。"}, {"type": "subtitle", "time": 6912.27, "timestamp": "01:55:12", "text": "十一月"}, {"type": "subtitle", "time": 6939.83, "timestamp": "01:55:39", "text": "空白的。感觉就像我在驾驶一台引擎"}, {"type": "subtitle", "time": 6943.33, "timestamp": "01:55:43", "text": "机器磨损。它是"}, {"type": "subtitle", "time": 6951.27, "timestamp": "01:55:51", "text": "就像我在轰油门一样，或者"}, {"type": "subtitle", "time": 6954.709, "timestamp": "01:55:54", "text": "某物。我的天啊。关键在于时机。"}, {"type": "subtitle", "time": 6957.229, "timestamp": "01:55:57", "text": "看起来是这样。"}]
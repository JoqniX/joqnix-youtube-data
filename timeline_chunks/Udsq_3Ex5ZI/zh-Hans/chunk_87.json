[{"type": "subtitle", "time": 5224.99, "timestamp": "01:27:04", "text": "我想我刚才展示了什么"}, {"type": "subtitle", "time": 5227.59, "timestamp": "01:27:07", "text": "我喜欢哈卡面。我认为那是哈卡舞。"}, {"type": "subtitle", "time": 5231.189, "timestamp": "01:27:11", "text": "面条。是的，我之前确实展示过我"}, {"type": "subtitle", "time": 5233.95, "timestamp": "01:27:13", "text": "得到"}, {"type": "subtitle", "time": 5237.83, "timestamp": "01:27:17", "text": "毯子。我不做这种事。"}, {"type": "subtitle", "time": 5241.189, "timestamp": "01:27:21", "text": "感觉网上订餐太讲究了。"}, {"type": "subtitle", "time": 5242.11, "timestamp": "01:27:22", "text": "和"}, {"type": "subtitle", "time": 5245.39, "timestamp": "01:27:25", "text": "等等。我完全是个传统主义者。"}, {"type": "subtitle", "time": 5249.189, "timestamp": "01:27:29", "text": "种类。我打算去买点吃的，然后就回来。"}, {"type": "subtitle", "time": 5252.629, "timestamp": "01:27:32", "text": "回家类型。"}, {"type": "chat", "time": 5258.826, "timestamp": "01:27:38", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "food's really nice over there"}, {"type": "subtitle", "time": 5276.59, "timestamp": "01:27:56", "text": "是的，"}, {"type": "subtitle", "time": 5278.83, "timestamp": "01:27:58", "text": "就是这样。"}]
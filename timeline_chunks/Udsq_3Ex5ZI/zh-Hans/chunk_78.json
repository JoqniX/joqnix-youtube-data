[{"type": "subtitle", "time": 4681.709, "timestamp": "01:18:01", "text": "东西。哦好的。好的。"}, {"type": "subtitle", "time": 4686.75, "timestamp": "01:18:06", "text": "指南。"}, {"type": "subtitle", "time": 4693.709, "timestamp": "01:18:13", "text": "好的。好的。饺子。"}, {"type": "subtitle", "time": 4697.03, "timestamp": "01:18:17", "text": "哦，圭亚。特殊设计"}, {"type": "subtitle", "time": 4698.91, "timestamp": "01:18:18", "text": "主要神圣。这是"}, {"type": "subtitle", "time": 4702.87, "timestamp": "01:18:22", "text": "油炸烘焙的糕点，里面填满了"}, {"type": "subtitle", "time": 4705.95, "timestamp": "01:18:25", "text": "干果与酸甜口味的混合。"}, {"type": "subtitle", "time": 4711.07, "timestamp": "01:18:31", "text": "哦，它们太可爱了。我的天啊。"}, {"type": "subtitle", "time": 4713.63, "timestamp": "01:18:33", "text": "一个"}, {"type": "subtitle", "time": 4716.75, "timestamp": "01:18:36", "text": "看。这"}, {"type": "subtitle", "time": 4718.27, "timestamp": "01:18:38", "text": "似乎"}, {"type": "subtitle", "time": 4721.63, "timestamp": "01:18:41", "text": "好的。音乐是吗？"}, {"type": "subtitle", "time": 4724.709, "timestamp": "01:18:44", "text": "体积？希望不要太低。好的，它"}, {"type": "subtitle", "time": 4727.51, "timestamp": "01:18:47", "text": "应该没问题吧？"}, {"type": "subtitle", "time": 4732.83, "timestamp": "01:18:52", "text": "忘了。让我进入我的呃这个"}, {"type": "subtitle", "time": 4736.99, "timestamp": "01:18:56", "text": "杂乱的线路布置。你管这叫什么？"}]
[{"type": "subtitle", "time": 16621.629, "timestamp": "04:37:01", "text": "出色地。不，你要专门制作一个视频。"}, {"type": "subtitle", "time": 16625.029, "timestamp": "04:37:05", "text": "视频以及所有那些东西。当它"}, {"type": "subtitle", "time": 16626.709, "timestamp": "04:37:06", "text": "至于录音之类的事情，我做"}, {"type": "subtitle", "time": 16630.07, "timestamp": "04:37:10", "text": "直播效果更好。如果我在直播，我会这么做。"}, {"type": "subtitle", "time": 16633.029, "timestamp": "04:37:13", "text": "最好是原声，但如果我要录音，我"}, {"type": "subtitle", "time": 16636.869, "timestamp": "04:37:16", "text": "所以我犯了很多错误。"}, {"type": "subtitle", "time": 16639.189, "timestamp": "04:37:19", "text": "我知道我可以剪辑和编辑"}, {"type": "chat", "time": 16639.606, "timestamp": "04:37:19", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "trust me I can not even watch myself after uploading video because its just so cringe"}, {"type": "subtitle", "time": 16642.629, "timestamp": "04:37:22", "text": "还有一些其他的东西。我会说：“好，拿一个。”"}, {"type": "subtitle", "time": 16644.39, "timestamp": "04:37:24", "text": "再来一份，两份，三份，四份，"}, {"type": "subtitle", "time": 16646.789, "timestamp": "04:37:26", "text": "像这样拿100个。” 真的"}, {"type": "subtitle", "time": 16647.869, "timestamp": "04:37:27", "text": "发生的事情"}, {"type": "subtitle", "time": 16652.31, "timestamp": "04:37:32", "text": "我直播时的样子。我不知道什么事发生了"}, {"type": "subtitle", "time": 16654.709, "timestamp": "04:37:34", "text": "不过我倒是挺喜欢的。就像我第一次就做对了一样"}, {"type": "subtitle", "time": 16661.75, "timestamp": "04:37:41", "text": "时间。我无法在大约之后再看自己"}, {"type": "subtitle", "time": 16664.629, "timestamp": "04:37:44", "text": "每个视频都这样，因为它太尴尬了。相同的。我"}, {"type": "subtitle", "time": 16667.029, "timestamp": "04:37:47", "text": "也。但我正在慢慢习惯。"}, {"type": "subtitle", "time": 16668.109, "timestamp": "04:37:48", "text": "我的"}, {"type": "subtitle", "time": 16671.59, "timestamp": "04:37:51", "text": "把剪辑片段和镜头都塞进去"}, {"type": "subtitle", "time": 16674.789, "timestamp": "04:37:54", "text": "我现在有时间看视频了。"}, {"type": "subtitle", "time": 16678.551, "timestamp": "04:37:58", "text": "那样的话，我觉得不太尴尬。"}]
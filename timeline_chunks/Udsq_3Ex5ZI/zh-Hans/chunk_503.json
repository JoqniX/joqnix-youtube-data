[{"type": "subtitle", "time": 30185.19, "timestamp": "08:23:05", "text": "我正在看恐怖片。"}, {"type": "subtitle", "time": 30186.628, "timestamp": "08:23:06", "text": "我以为有人在敲我的门"}, {"type": "subtitle", "time": 30191.07, "timestamp": "08:23:11", "text": "窗户。我的天哪，太棒了！"}, {"type": "subtitle", "time": 30201.548, "timestamp": "08:23:21", "text": "那。我们需要联系那边，"}, {"type": "subtitle", "time": 30205.07, "timestamp": "08:23:25", "text": "正确的？传送过去"}, {"type": "subtitle", "time": 30218.67, "timestamp": "08:23:38", "text": "嗯？好的。"}, {"type": "subtitle", "time": 30221.71, "timestamp": "08:23:41", "text": "你知道吗？我要去"}, {"type": "subtitle", "time": 30230.51, "timestamp": "08:23:50", "text": "去保存"}, {"type": "subtitle", "time": 30233.468, "timestamp": "08:23:53", "text": "志乃。发生了什么事？"}]
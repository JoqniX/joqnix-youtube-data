[{"type": "subtitle", "time": 5282.47, "timestamp": "01:28:02", "text": "夜幕降临。我们该怎么办？"}, {"type": "subtitle", "time": 5294.07, "timestamp": "01:28:14", "text": "日本的头部。你的意思是，我希望我能"}, {"type": "subtitle", "time": 5297.43, "timestamp": "01:28:17", "text": "去那边拿酪乳。让我先说明一下"}, {"type": "chat", "time": 5304.809, "timestamp": "01:28:24", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "go and talk to random people in the street"}, {"type": "subtitle", "time": 5306.669, "timestamp": "01:28:26", "text": "知道可用"}, {"type": "subtitle", "time": 5313.59, "timestamp": "01:28:33", "text": "日本。虽然在……方面并不普遍"}, {"type": "subtitle", "time": 5315.91, "timestamp": "01:28:35", "text": "有些国家有售酪乳。"}, {"type": "chat", "time": 5317.774, "timestamp": "01:28:37", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "i'm more of a \"if i can pay someone else to do it for me\" kinda person"}, {"type": "subtitle", "time": 5318.87, "timestamp": "01:28:38", "text": "在日本，它以粉末状的形式存在。"}, {"type": "subtitle", "time": 5321.51, "timestamp": "01:28:41", "text": "他们种族的特产。你可以"}, {"type": "subtitle", "time": 5324.149, "timestamp": "01:28:44", "text": "从较小的厂家购买液态黄油。"}, {"type": "chat", "time": 5327.328, "timestamp": "01:28:47", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "saves me time to focus on my stuff"}, {"type": "chat", "time": 5331.904, "timestamp": "01:28:51", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "Butter milk"}, {"type": "subtitle", "time": 5333.189, "timestamp": "01:28:53", "text": "JP，只需在
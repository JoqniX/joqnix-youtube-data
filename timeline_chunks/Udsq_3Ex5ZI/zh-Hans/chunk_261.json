[{"type": "subtitle", "time": 15662.469, "timestamp": "04:21:02", "text": "最近发生了一件涉及……的事情"}, {"type": "subtitle", "time": 15665.75, "timestamp": "04:21:05", "text": "像威尔·内夫和卡罗琳这样的创作者"}, {"type": "subtitle", "time": 15668.79, "timestamp": "04:21:08", "text": "当时没在看。然而，该公司"}, {"type": "subtitle", "time": 15672.07, "timestamp": "04:21:12", "text": "当时正在看它们，这就造成了那些"}, {"type": "subtitle", "time": 15674.389, "timestamp": "04:21:14", "text": "创作者们因为一些小事而受到很多批评"}, {"type": "subtitle", "time": 15677.67, "timestamp": "04:21:17", "text": "原因。但很多肛门就是这样"}, {"type": "subtitle", "time": 15679.59, "timestamp": "04:21:19", "text": "赞助商正在获得。而这正是……"}, {"type": "subtitle", "time": 15681.67, "timestamp": "04:21:21", "text": "很多赞助商都开始变得精明起来。"}, {"type": "subtitle", "time": 15683.91, "timestamp": "04:21:23", "text": "因为他们意识到，如果他们查看机器人"}, {"type": "subtitle", "time": 15686.07, "timestamp": "04:21:26", "text": "有了这些创作者，会有更多人观看。"}, {"type": "subtitle", "time": 15688.469, "timestamp": "04:21:28", "text": "它们的溪流。然而，很多"}, {"type": "subtitle", "time": 15691.11, "timestamp": "04:21:31", "text": "过去的那些主播，嗯，他们是"}, {"type": "subtitle", "time": 15692.71, "timestamp": "04:21:32", "text": "现在被坑了"}, {"type": "subtitle", "time": 15694.95, "timestamp": "04:21:34", "text": "大家都说他们是刷流量的。"}, {"type": "subtitle", "time": 15696.79, "timestamp": "04:21:36", "text": "哇。而最糟糕的是这些"}, {"type": "subtitle", "time": 15698.87, "timestamp": "04:21:38", "text": "公司甚至都不会征求你的同意"}, {"type": "subtitle", "time": 15701.03, "timestamp": "04:21:41", "text": "他们不会用机器人刷流量，因为他们不需要"}, {"type": "subtitle", "time": 15703.67, "timestamp": "04:21:43", "text": "告诉你。哇。真的真的"}, {"type": "subtitle", "time": 15707.67, "timestamp": "04:21:47", "text": "非常糟糕。我从来没有遇到过这种情况，所以我"}, {"type": "subtitle", "time": 15711.59, "timestamp": "04:21:51", "text": "了解得不够多"}, {"type": "subtitle", "time": 15713.59, "timestamp": "04:21:53", "text": "集成。"}, {"type": "subtitle", "time": 15717.429, "timestamp": "04:21:57", "text": "我预见未来流媒体将会是"}, {"type": "subtitle", "time": 15719.229, "timestamp": "04:21:59", "text": "即将开始领取减薪"}]
[{"type": "subtitle", "time": 17162.628, "timestamp": "04:46:02", "text": "tecton tecton 是个主播，他是个 gen"}, {"type": "subtitle", "time": 17166.948, "timestamp": "04:46:06", "text": "主播不喜欢这种羞耻感"}, {"type": "subtitle", "time": 17169.99, "timestamp": "04:46:09", "text": "没错，但当我想到这一点时……"}, {"type": "subtitle", "time": 17172.708, "timestamp": "04:46:12", "text": "作为一名普通创作者，这是一种怎样的概念？"}, {"type": "subtitle", "time": 17175.15, "timestamp": "04:46:15", "text": "将内容创作者的概念融入视频制作中"}, {"type": "subtitle", "time": 17177.91, "timestamp": "04:46:17", "text": "传统视频拍摄的感觉是"}, {"type": "subtitle", "time": 17180.868, "timestamp": "04:46:20", "text": "就像你上传的专属视频一样"}, {"type": "subtitle", "time": 17184.35, "timestamp": "04:46:24", "text": "内容涵盖音乐歌曲翻唱"}, {"type": "subtitle", "time": 17187.31, "timestamp": "04:46:27", "text": "视频，所有那些东西，"}, {"type": "subtitle", "time": 17191.35, "timestamp": "04:46:31", "text": "正确的？我的意思是，我有自由去做这件事。"}, {"type": "subtitle", "time": 17194.23, "timestamp": "04:46:34", "text": "随心所欲。所以，有时候我会想，"}, {"type": "subtitle", "time": 17196.628, "timestamp": "04:46:36", "text": "不，我更看重传统的一面。"}, {"type": "subtitle", "time": 17198.948, "timestamp": "04:46:38", "text": "当跟随或"}, {"type": "subtitle", "time": 17201.27, "timestamp": "04:46:41", "text": "提到其他创作者，我就想说："}, {"type": "subtitle", "time": 17204.15, "timestamp": "04:46:44", "text": "“哦，他们不这样做。他们正在这样做"}, {"type": "subtitle", "time": 17206.07, "timestamp": "04:46:46", "text": "这样做，所以我也应该这样做。"}, {"type": "subtitle", "time": 17210.07, "timestamp": "04:46:50", "text": "格式或其他什么。”而我自己却有"}, {"type": "subtitle", "time": 17212.868, "timestamp": "04:46:52", "text": "打破这种模式的能力或"}, {"type": "subtitle", "time": 17215.03, "timestamp": "04:46:55", "text": "重建该格式或创建一个新格式"}]
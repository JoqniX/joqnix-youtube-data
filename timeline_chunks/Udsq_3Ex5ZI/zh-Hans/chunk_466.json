[{"type": "subtitle", "time": 27967.15, "timestamp": "07:46:07", "text": "感觉。如果我太困了，请不要介意。"}, {"type": "subtitle", "time": 27971.99, "timestamp": "07:46:11", "text": "累了，因为通常这个时候就像"}, {"type": "subtitle", "time": 27974.548, "timestamp": "07:46:14", "text": "每天早上，无论何时我都会这样。"}, {"type": "subtitle", "time": 27976.948, "timestamp": "07:46:16", "text": "感觉很累之类的。不知道为什么"}, {"type": "subtitle", "time": 27984.19, "timestamp": "07:46:24", "text": "[音乐]"}, {"type": "subtitle", "time": 27987.628, "timestamp": "07:46:27", "text": "是。但我会习惯的。我"}, {"type": "subtitle", "time": 27992.468, "timestamp": "07:46:32", "text": "我想我得反思一下：我为什么偷懒？"}, {"type": "subtitle", "time": 27995.59, "timestamp": "07:46:35", "text": "让我起来。"}]
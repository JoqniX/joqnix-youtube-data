[{"type": "subtitle", "time": 13690.189, "timestamp": "03:48:10", "text": "不，它不在那里。"}, {"type": "subtitle", "time": 13698.59, "timestamp": "03:48:18", "text": "不再是了。她的凡人模样看起来像"}, {"type": "subtitle", "time": 13702.429, "timestamp": "03:48:22", "text": "这。嗯，是的，就像"}, {"type": "subtitle", "time": 13707.07, "timestamp": "03:48:27", "text": "这种假小子式的酷"}, {"type": "subtitle", "time": 13710.469, "timestamp": "03:48:30", "text": "女士。我认为这是一个新型号"}, {"type": "subtitle", "time": 13715.349, "timestamp": "03:48:35", "text": "某物。中国中世纪模型"}, {"type": "subtitle", "time": 13719.63, "timestamp": "03:48:39", "text": "太酷了，兄弟。真是太"}, {"type": "subtitle", "time": 13728.15, "timestamp": "03:48:48", "text": "他们身上有那种特质，你知道的。"}, {"type": "subtitle", "time": 13730.189, "timestamp": "03:48:50", "text": "当你看着"}]
[{"type": "subtitle", "time": 6063.229, "timestamp": "01:41:03", "text": "我还没放呢。"}, {"type": "subtitle", "time": 6066.39, "timestamp": "01:41:06", "text": "好的。所以，Twitch上只有少数几个片段。"}, {"type": "subtitle", "time": 6091.07, "timestamp": "01:41:31", "text": "他。那是一个假克隆体"}, {"type": "subtitle", "time": 6101.629, "timestamp": "01:41:41", "text": "什么？那是一个假克隆品。"}, {"type": "subtitle", "time": 6105.75, "timestamp": "01:41:45", "text": "我以为是假的。"}, {"type": "subtitle", "time": 6108.629, "timestamp": "01:41:48", "text": "这是假的。"}, {"type": "subtitle", "time": 6113.07, "timestamp": "01:41:53", "text": "我的天哪。是的，那是假的"}, {"type": "subtitle", "time": 6116.75, "timestamp": "01:41:56", "text": "骑师。这是假的。他们得到了"}]
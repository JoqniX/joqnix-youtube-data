[{"type": "subtitle", "time": 27062.03, "timestamp": "07:31:02", "text": "不重叠。我暂时先把它定在45。"}, {"type": "subtitle", "time": 27064.468, "timestamp": "07:31:04", "text": "好的。请告诉我现在的音频是否正常。"}, {"type": "subtitle", "time": 27065.23, "timestamp": "07:31:05", "text": "是"}, {"type": "subtitle", "time": 27069.628, "timestamp": "07:31:09", "text": "好的。你好。什么？是的。我们开始吧"}, {"type": "subtitle", "time": 27072.83, "timestamp": "07:31:12", "text": "去。你好吗"}, {"type": "subtitle", "time": 27075.75, "timestamp": "07:31:15", "text": "伙计们？今天我们要直播……"}, {"type": "subtitle", "time": 27078.708, "timestamp": "07:31:18", "text": "原神。我想知道我们是否可以"}, {"type": "subtitle", "time": 27081.91, "timestamp": "07:31:21", "text": "正在播放，因为就在我们说话的此刻"}, {"type": "subtitle", "time": 27083.708, "timestamp": "07:31:23", "text": "我"}, {"type": "subtitle", "time": 27089.19, "timestamp": "07:31:29", "text": "渲染视频愿望板"}, {"type": "subtitle", "time": 27091.788, "timestamp": "07:31:31", "text": "我们直播了1小时。"}, {"type": "subtitle", "time": 27095.868, "timestamp": "07:31:35", "text": "前。大约是35%。"}, {"type": "subtitle", "time": 27098.468, "timestamp": "07:31:38", "text": "完毕。这其实是我第一次。"}, {"type": "subtitle", "time": 27100.868, "timestamp": "07:31:40", "text": "在直播中做这件事"}, {"type": "subtitle", "time": 27103.83, "timestamp": "07:31:43", "text": "所有事情，每一件事，都存在延迟。"}, {"type": "subtitle", "time": 27106.19, "timestamp": "07:31:46", "text": "我当时就想："}, {"type": "subtitle", "time": 27109.23, "timestamp": "07:31:49", "text": "是的。等等，你说“是”是什么意思？"}, {"type": "subtitle", "time": 27112.23, "timestamp": "07:31:52", "text": "开玩笑？我的天啊。我的意思是，它会是"}, {"type": "subtitle", "time": 27115.468, "timestamp": "07:31:55", "text": "美好的。我们可以玩这个游戏。我"}]
[{"type": "subtitle", "time": 16022.11, "timestamp": "04:27:02", "text": "[音乐]"}, {"type": "subtitle", "time": 16026.55, "timestamp": "04:27:06", "text": "如何？我该怎么办？什么？哦，天哪，我"}, {"type": "subtitle", "time": 16029.229, "timestamp": "04:27:09", "text": "没有编辑。加"}, {"type": "subtitle", "time": 16032.63, "timestamp": "04:27:12", "text": "疼痛。我只能指望你们了。"}, {"type": "subtitle", "time": 16035.469, "timestamp": "04:27:15", "text": "剪辑片段，呃，用于拍摄和"}, {"type": "subtitle", "time": 16038.55, "timestamp": "04:27:18", "text": "东西。但对于视频内容，我需要"}, {"type": "subtitle", "time": 16042.189, "timestamp": "04:27:22", "text": "现在就开始考虑这个问题。我可以做什么"}, {"type": "subtitle", "time": 16045.99, "timestamp": "04:27:25", "text": "做？我的意思是，我知道该怎么做。"}, {"type": "subtitle", "time": 16048.469, "timestamp": "04:27:28", "text": "只是我的电脑不让我录制视频。"}, {"type": "subtitle", "time": 16049.309, "timestamp": "04:27:29", "text": "和"}, {"type": "subtitle", "time": 16052.55, "timestamp": "04:27:32", "text": "一切。 CPU使用率将达到100%。"}, {"type": "subtitle", "time": 16054.269, "timestamp": "04:27:34", "text": "不。"}, {"type": "subtitle", "time": 16061.429, "timestamp": "04:27:41", "text": "嗯，我觉得这就是一个定义。"}, {"type": "subtitle", "time": 16064.389, "timestamp": "04:27:44", "text": "内容创作者。与他相比，我算什么？"}, {"type": "subtitle", "time": 16066.269, "timestamp": "04:27:46", "text": "Techon 和"}, {"type": "subtitle", "time": 16069.51, "timestamp": "04:27:49", "text": "东西。不。就像我为什么说的那样"}, {"type": "subtitle", "time": 16071.83, "timestamp": "04:27:51", "text": "这就好比不去和别人比较一样。"}, {"type": "subtitle", "time": 16074.67, "timestamp": "04:27:54", "text": "其他创作者。更像是"}, {"type": "subtitle", "time": 16077.67, "timestamp": "04:27:57", "text": "嗯，即使我已经直播了5年"}]
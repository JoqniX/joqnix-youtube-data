[{"type": "subtitle", "time": 28145.548, "timestamp": "07:49:05", "text": "经过。等待，"}, {"type": "subtitle", "time": 28148.628, "timestamp": "07:49:08", "text": "真的吗？我没有提出城堡建造请求。"}, {"type": "subtitle", "time": 28157.628, "timestamp": "07:49:17", "text": "剑"}, {"type": "subtitle", "time": 28161.51, "timestamp": "07:49:21", "text": "他们开始等待。所以如果你"}, {"type": "subtitle", "time": 28167.99, "timestamp": "07:49:27", "text": "事件会奖励一把剑，这把剑也"}, {"type": "subtitle", "time": 28171.59, "timestamp": "07:49:31", "text": "在剧情任务中你会得到那把剑。"}, {"type": "subtitle", "time": 28175.99, "timestamp": "07:49:35", "text": "即使发生这种情况，也不要这样做"}, {"type": "subtitle", "time": 28179.27, "timestamp": "07:49:39", "text": "不在那里。"}, {"type": "subtitle", "time": 28181.03, "timestamp": "07:49:41", "text": "如果他们真那样做，那就……"}, {"type": "subtitle", "time": 28184.23, "timestamp": "07:49:44", "text": "超好的。"}, {"type": "subtitle", "time": 28186.788, "timestamp": "07:49:46", "text": "我相信如果我完成阿尔贝托的任务，我"}, {"type": "subtitle", "time": 28189.468, "timestamp": "07:49:49", "text": "可以买到阿尔贝托的"}, {"type": "subtitle", "time": 28193.35, "timestamp": "07:49:53", "text": "剑。我不知道。"}, {"type": "subtitle", "time": 28196.388, "timestamp": "07:49:56", "text": "如果真是那样的话……"}, {"type": "subtitle", "time": 28199.75, "timestamp": "07:49:59", "text": "这样做，就更容易获得"}]
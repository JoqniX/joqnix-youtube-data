[{"type": "subtitle", "time": 4381.669, "timestamp": "01:13:01", "text": "说？回来继续聊天吧"}, {"type": "subtitle", "time": 4384.63, "timestamp": "01:13:04", "text": "大概是些什么事之类的。"}, {"type": "subtitle", "time": 4385.95, "timestamp": "01:13:05", "text": "是的。是的。是的。"}, {"type": "subtitle", "time": 4388.47, "timestamp": "01:13:08", "text": "是的。我们需要找到哈什。有一个"}, {"type": "subtitle", "time": 4390.79, "timestamp": "01:13:10", "text": "记录了很多消息"}, {"type": "subtitle", "time": 4392.91, "timestamp": "01:13:12", "text": "最后的"}, {"type": "subtitle", "time": 4395.83, "timestamp": "01:13:15", "text": "溪流。好的。让我先解决这个问题。"}, {"type": "subtitle", "time": 4400.55, "timestamp": "01:13:20", "text": "给我打断一下。再次中断。等等，这个"}, {"type": "subtitle", "time": 4405.55, "timestamp": "01:13:25", "text": "应该为零。等等，伯爵"}, {"type": "subtitle", "time": 4409.27, "timestamp": "01:13:29", "text": "呃，我以为这一次我不需要了"}, {"type": "subtitle", "time": 4417.87, "timestamp": "01:13:37", "text": "但事情并非你想的那样。"}, {"type": "subtitle", "time": 4431.229, "timestamp": "01:13:51", "text": "[音乐]"}, {"type": "subtitle", "time": 4434.97, "timestamp": "01:13:54", "text": "今天？你的到来真的让我非常感动。"}, {"type": "subtitle", "time": 4437.149, "timestamp": "01:13:57", "text": "[音乐]"}]
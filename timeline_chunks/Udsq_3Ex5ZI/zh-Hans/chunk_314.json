[{"type": "subtitle", "time": 18842.15, "timestamp": "05:14:02", "text": "另外，我本来应该……呃……演奏一些……呃……"}, {"type": "subtitle", "time": 18845.07, "timestamp": "05:14:05", "text": "非商业音乐，但我意外地"}, {"type": "subtitle", "time": 18849.27, "timestamp": "05:14:09", "text": "曾拥有日本音乐版权"}, {"type": "subtitle", "time": 18858.19, "timestamp": "05:14:18", "text": "害怕的。什么？娜妮"}, {"type": "subtitle", "time": 18861.27, "timestamp": "05:14:21", "text": "它就一直在那里，自从"}, {"type": "subtitle", "time": 18864.15, "timestamp": "05:14:24", "text": "YouTube 开始推出直播功能"}, {"type": "subtitle", "time": 18868.67, "timestamp": "05:14:28", "text": "直播就是我们没有做的"}, {"type": "subtitle", "time": 18871.35, "timestamp": "05:14:31", "text": "知道大家今天过得怎么样，也开心"}, {"type": "subtitle", "time": 18872.43, "timestamp": "05:14:32", "text": "生日快乐"}, {"type": "subtitle", "time": 18875.75, "timestamp": "05:14:35", "text": "祖基，我为睡着深表歉意"}, {"type": "subtitle", "time": 18889.39, "timestamp": "05:14:49", "text": "我怎么这么困？因为我"}, {"type": "subtitle", "time": 18893.67, "timestamp": "05:14:53", "text": "呃，我坐在这个热乎乎的……什么？什么？"}, {"type": "subtitle", "time": 18896.19, "timestamp": "05:14:56", "text": "你把热叫做什么？"}, {"type": "subtitle", "time": 18898.948, "timestamp": "05:14:58", "text": "敲诈勒索？中暑。那是什么？"}]
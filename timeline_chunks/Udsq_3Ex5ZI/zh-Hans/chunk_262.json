[{"type": "subtitle", "time": 15722.55, "timestamp": "04:22:02", "text": "评分和专属视频是……的方式"}, {"type": "subtitle", "time": 15726.269, "timestamp": "04:22:06", "text": "未来。现在，作为一名……，你该如何……"}, {"type": "subtitle", "time": 15729.11, "timestamp": "04:22:09", "text": "创作者，别搞砸你的频道好吗？"}, {"type": "subtitle", "time": 15731.75, "timestamp": "04:22:11", "text": "我们都知道专门的视频是"}, {"type": "subtitle", "time": 15734.389, "timestamp": "04:22:14", "text": "导致你流失订阅者的视频"}, {"type": "subtitle", "time": 15739.269, "timestamp": "04:22:19", "text": "最多。这是事实。这是。所以"}, {"type": "subtitle", "time": 15741.59, "timestamp": "04:22:21", "text": "你可以像我一样做，那就是"}, {"type": "subtitle", "time": 15745.11, "timestamp": "04:22:25", "text": "策略，即用大量信息淹没你的受众"}, {"type": "subtitle", "time": 15748.07, "timestamp": "04:22:28", "text": "一天要拍四到五个视频，因为，老兄，我"}, {"type": "subtitle", "time": 15750.87, "timestamp": "04:22:30", "text": "被唠叨了四到五次"}, {"type": "subtitle", "time": 15753.429, "timestamp": "04:22:33", "text": "视频。确保每一位专职人员都尽职尽责。"}, {"type": "subtitle", "time": 15756.07, "timestamp": "04:22:36", "text": "你拍摄的视频，你投入了很多"}, {"type": "subtitle", "time": 15758.07, "timestamp": "04:22:38", "text": "努力融入其中，直到感觉不到为止。"}, {"type": "subtitle", "time": 15759.91, "timestamp": "04:22:39", "text": "就像是对人的侮辱和打耳光一样。"}, {"type": "subtitle", "time": 15762.55, "timestamp": "04:22:42", "text": "你的受众。那非常困难。"}, {"type": "subtitle", "time": 15765.189, "timestamp": "04:22:45", "text": "当你专门为 Rage 拍摄视频时"}, {"type": "subtitle", "time": 15767.269, "timestamp": "04:22:47", "text": "《暗影传说》，但我认为"}, {"type": "subtitle", "time": 15768.389, "timestamp": "04:22:48", "text": "互联网用户肯定会非常高兴"}, {"type": "subtitle", "time": 15771.83, "timestamp": "04:22:51", "text": "这。创作者们将停止创作"}, {"type": "subtitle", "time": 15773.91, "timestamp": "04:22:53", "text": "产量将会大幅减少。"}, {"type": "subtitle", "time": 15776.229, "timestamp": "04:22:56", "text": "比他们平时赚的钱要多。所以"}, {"type": "subtitle", "time": 15779.349, "timestamp": "04:22:59", "text": "为未来做准备非常重要"}]
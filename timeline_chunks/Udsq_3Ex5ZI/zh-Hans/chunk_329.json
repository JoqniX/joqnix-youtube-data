[{"type": "subtitle", "time": 19749.43, "timestamp": "05:29:09", "text": "很多。是的，他确实看了一部电影。是的，他"}, {"type": "subtitle", "time": 19756.67, "timestamp": "05:29:16", "text": "是的，我和家人一起出去了。"}, {"type": "subtitle", "time": 19760.39, "timestamp": "05:29:20", "text": "昨天。去了，是的，我们去了"}, {"type": "subtitle", "time": 19763.27, "timestamp": "05:29:23", "text": "一个购物中心，是的，我们和一个男人闲逛。什么时候"}, {"type": "subtitle", "time": 19765.75, "timestamp": "05:29:25", "text": "说到走路，我正在走路"}, {"type": "subtitle", "time": 19768.83, "timestamp": "05:29:28", "text": "很多。我好累啊"}, {"type": "subtitle", "time": 19771.788, "timestamp": "05:29:31", "text": "容易地。所以，对于一个内向的人来说，就是这样。"}, {"type": "subtitle", "time": 19773.788, "timestamp": "05:29:33", "text": "还算正常。但是，"}, {"type": "subtitle", "time": 19778.788, "timestamp": "05:29:38", "text": "你依然……但我还是回家了。我"}, {"type": "subtitle", "time": 19782.07, "timestamp": "05:29:42", "text": "勉强吃了一些东西。"}, {"type": "subtitle", "time": 19785.51, "timestamp": "05:29:45", "text": "吃过晚饭就睡了，我只睡了一会儿。"}, {"type": "subtitle", "time": 19788.708, "timestamp": "05:29:48", "text": "少量。然后他们醒了，也把我吵醒了。"}, {"type": "subtitle", "time": 19791.11, "timestamp": "05:29:51", "text": "找点东西帮忙，我不得不……"}, {"type": "subtitle", "time": 19798.628, "timestamp": "05:29:58", "text": "东西。然后我就醒了，然后……我想"}]
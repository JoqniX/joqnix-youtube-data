[{"type": "subtitle", "time": 19441.47, "timestamp": "05:24:01", "text": "应该等等。快点。为什么会这样？"}, {"type": "subtitle", "time": 19445.75, "timestamp": "05:24:05", "text": "不要等待。我是否违反了显而易见的规则？"}, {"type": "subtitle", "time": 19454.39, "timestamp": "05:24:14", "text": "我得出去吃饭。你好。你好，Zuki。去。"}, {"type": "subtitle", "time": 19457.03, "timestamp": "05:24:17", "text": "去。去吃饭。今天是你的生日。享受"}, {"type": "subtitle", "time": 19459.03, "timestamp": "05:24:19", "text": "你的一天。祝您今天愉快。你没有"}, {"type": "subtitle", "time": 19463.15, "timestamp": "05:24:23", "text": "来现场观看我比赛。跟你说过很多"}, {"type": "subtitle", "time": 19467.868, "timestamp": "05:24:27", "text": "事物。祝你今天过得愉快。祝你玩得开心"}, {"type": "subtitle", "time": 19476.948, "timestamp": "05:24:36", "text": "YouTube。呃，我可能会降低成本。"}, {"type": "subtitle", "time": 19478.55, "timestamp": "05:24:38", "text": "实际上。"}, {"type": "subtitle", "time": 19482.11, "timestamp": "05:24:42", "text": "我会降低成本。降低"}, {"type": "subtitle", "time": 19486.23, "timestamp": "05:24:46", "text": "费用太高了，40太多了，不是吗？"}, {"type": "subtitle", "time": 19488.55, "timestamp": "05:24:48", "text": "思考？"}, {"type": "subtitle", "time": 19492.23, "timestamp": "05:24:52", "text": "是的，这太过分了。"}, {"type": "subtitle", "time": 19494.31, "timestamp": "05:24:54", "text": "但这太多了。或许会是五次或多次。"}, {"type": "subtitle", "time": 19496.948, "timestamp": "05:24:56", "text": "某物。我不知道。"}]
[{"type": "subtitle", "time": 27301.948, "timestamp": "07:35:01", "text": "在我安装 BTRC 之前。是的，这就是"}, {"type": "subtitle", "time": 27305.83, "timestamp": "07:35:05", "text": "东西。我会把它戴上，呃，我会的"}, {"type": "subtitle", "time": 27307.468, "timestamp": "07:35:07", "text": "把它放上"}, {"type": "subtitle", "time": 27311.03, "timestamp": "07:35:11", "text": "描述一下，因为每当我这样做的时候，哦，"}, {"type": "subtitle", "time": 27313.91, "timestamp": "07:35:13", "text": "等待。夜板查玛。他在那里。你好。"}, {"type": "subtitle", "time": 27316.07, "timestamp": "07:35:16", "text": "很高兴看到这一点。很高兴看到这一点"}, {"type": "subtitle", "time": 27318.948, "timestamp": "07:35:18", "text": "你还在。夜板查玛。"}, {"type": "subtitle", "time": 27320.708, "timestamp": "07:35:20", "text": "是的。每当我执行此命令时，"}, {"type": "subtitle", "time": 27323.11, "timestamp": "07:35:23", "text": "每当有人执行此命令时，"}, {"type": "subtitle", "time": 27325.51, "timestamp": "07:35:25", "text": "晚上因为夜班板在工作"}, {"type": "subtitle", "time": 27329.03, "timestamp": "07:35:29", "text": "感叹号，呃，命令就在那里"}, {"type": "subtitle", "time": 27331.91, "timestamp": "07:35:31", "text": "正因为如此，才会触发那个东西。"}, {"type": "subtitle", "time": 27335.11, "timestamp": "07:35:35", "text": "它烧焦了，幸好我没有。"}, {"type": "subtitle", "time": 27336.75, "timestamp": "07:35:36", "text": "再添加吧。"}, {"type": "subtitle", "time": 27340.59, "timestamp": "07:35:40", "text": "好的，它应该能正常工作了。"}, {"type": "subtitle", "time": 27342.788, "timestamp": "07:35:42", "text": "现在。是的，应该没问题了。"}, {"type": "subtitle", "time": 27343.948, "timestamp": "07:35:43", "text": "现在我"}, {"type": "subtitle", "time": 27347.75, "timestamp": "07:35:47", "text": "相信。它应该能正常工作。让我"}, {"type": "subtitle", "time": 27351.07, "timestamp": "07:35:51", "text": "用彩虹来验证一下就行了。来"}, {"type": "subtitle", "time": 27354.31, "timestamp": "07:35:54", "text": "在。我很好。很高兴看到你"}]
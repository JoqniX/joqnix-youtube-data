[{"type": "subtitle", "time": 19622.07, "timestamp": "05:27:02", "text": "大约一周左右，或者两周左右。所以他"}, {"type": "subtitle", "time": 19624.27, "timestamp": "05:27:04", "text": "昨天在看电影，但是"}, {"type": "subtitle", "time": 19629.03, "timestamp": "05:27:09", "text": "想想晚上10点到11点左右的事。"}, {"type": "subtitle", "time": 19631.75, "timestamp": "05:27:11", "text": "我当时正躺在床上浏览网页。"}, {"type": "subtitle", "time": 19636.43, "timestamp": "05:27:16", "text": "电话。我当时非常累。所以"}, {"type": "subtitle", "time": 19640.23, "timestamp": "05:27:20", "text": "有点累了。我打开了Zuki直播"}, {"type": "subtitle", "time": 19642.788, "timestamp": "05:27:22", "text": "昨天她直播的时候。我认为"}, {"type": "subtitle", "time": 19645.39, "timestamp": "05:27:25", "text": "是11点15分还是"}, {"type": "subtitle", "time": 19649.47, "timestamp": "05:27:29", "text": "昨天晚上11点。"}, {"type": "subtitle", "time": 19651.47, "timestamp": "05:27:31", "text": "我当时"}, {"type": "subtitle", "time": 19655.27, "timestamp": "05:27:35", "text": "直播。我当时就想，呃，就像在撒谎一样。"}, {"type": "subtitle", "time": 19659.75, "timestamp": "05:27:39", "text": "向下。呃，我的脖子向右倾斜"}, {"type": "subtitle", "time": 19662.868, "timestamp": "05:27:42", "text": "手机呃，我有一个像这样的"}, {"type": "subtitle", "time": 19665.07, "timestamp": "05:27:45", "text": "篮子状的，不是篮子状的，你说什么？"}, {"type": "subtitle", "time": 19666.91, "timestamp": "05:27:46", "text": "称呼"}, {"type": "subtitle", "time": 19669.06, "timestamp": "05:27:49", "text": "斯坦迪什 斯坦迪什"}, {"type": "subtitle", "time": 19671.19, "timestamp": "05:27:51", "text": "[音乐]"}, {"type": "subtitle", "time": 19674.628, "timestamp": "05:27:54", "text": "呃，坚持要保留手机，因为我"}]
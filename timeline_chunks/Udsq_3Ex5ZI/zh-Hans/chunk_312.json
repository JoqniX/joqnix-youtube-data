[{"type": "subtitle", "time": 18720.23, "timestamp": "05:12:00", "text": "和你在一起，我凌晨四点就醒了。然后我就睡着了。"}, {"type": "subtitle", "time": 18725.07, "timestamp": "05:12:05", "text": "然后睡着了。然后我就醒了，呃，醒了。"}, {"type": "subtitle", "time": 18730.15, "timestamp": "05:12:10", "text": "什么时间？ 6 7. 然后我又睡着了。"}, {"type": "subtitle", "time": 18733.03, "timestamp": "05:12:13", "text": "早上10点起床。又睡着了。醒了"}, {"type": "subtitle", "time": 18734.11, "timestamp": "05:12:14", "text": "在"}, {"type": "subtitle", "time": 18735.708, "timestamp": "05:12:15", "text": "2."}, {"type": "subtitle", "time": 18738.55, "timestamp": "05:12:18", "text": "是的。嗨，Jo，欢迎来到直播间。"}, {"type": "subtitle", "time": 18742.27, "timestamp": "05:12:22", "text": "希望你"}, {"type": "subtitle", "time": 18750.708, "timestamp": "05:12:30", "text": "我对此深表歉意。"}, {"type": "subtitle", "time": 18753.31, "timestamp": "05:12:33", "text": "背叛问题。你知道，就是"}, {"type": "subtitle", "time": 18756.868, "timestamp": "05:12:36", "text": "缓冲。你知道吗，YouTube 就是个垃圾。"}, {"type": "subtitle", "time": 18760.948, "timestamp": "05:12:40", "text": "真糟糕。我 我 设定了背叛的呃"}, {"type": "subtitle", "time": 18764.868, "timestamp": "05:12:44", "text": "流媒体密钥到 6000，但我只有"}, {"type": "subtitle", "time": 18766.83, "timestamp": "05:12:46", "text": "获得"}, {"type": "subtitle", "time": 18769.91, "timestamp": "05:12:49", "text": "当我直播时，有 2,500 个"}, {"type": "subtitle", "time": 18773.03, "timestamp": "05:12:53", "text": "不知为何，YouTube 出现了这种情况。我不知道。我"}, {"type": "subtitle", "time": 18776.23, "timestamp": "05:12:56", "text": "不知道。离开很痛苦。"}, {"type": "subtitle", "time": 18779.868, "timestamp": "05:12:59", "text": "不，这是缓冲过程。我的天哪。哦"}]
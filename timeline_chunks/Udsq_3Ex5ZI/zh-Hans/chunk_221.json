[{"type": "subtitle", "time": 13260.52, "timestamp": "03:41:00", "text": "更好的。等等，那是什么？"}, {"type": "subtitle", "time": 13274.309, "timestamp": "03:41:14", "text": "我欠了钱。有个家伙。他"}, {"type": "subtitle", "time": 13276.389, "timestamp": "03:41:16", "text": "提出帮我免除债务作为交换"}, {"type": "subtitle", "time": 13278.01, "timestamp": "03:41:18", "text": "为你。"}, {"type": "subtitle", "time": 13290.79, "timestamp": "03:41:30", "text": "快点。一切都会好起来的。"}, {"type": "subtitle", "time": 13292.389, "timestamp": "03:41:32", "text": "你愿意转身和……说话吗？"}, {"type": "subtitle", "time": 13316.63, "timestamp": "03:41:56", "text": "我把它添加到播放列表里。"}]
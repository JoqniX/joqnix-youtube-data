[{"type": "subtitle", "time": 27180.948, "timestamp": "07:33:00", "text": "是的。希望它别崩溃，伙计。我"}, {"type": "subtitle", "time": 27184.548, "timestamp": "07:33:04", "text": "希望不会。但愿如此。你是什​​么"}, {"type": "subtitle", "time": 27185.708, "timestamp": "07:33:05", "text": "做？"}, {"type": "subtitle", "time": 27189.07, "timestamp": "07:33:09", "text": "嗯，我该怎么做才能不让它发生"}, {"type": "subtitle", "time": 27193.91, "timestamp": "07:33:13", "text": "碰撞？好的。发射。我希望能够暂停一下"}, {"type": "subtitle", "time": 27199.788, "timestamp": "07:33:19", "text": "东西。我希望我的声音能被听到。"}, {"type": "subtitle", "time": 27205.708, "timestamp": "07:33:25", "text": "是的。"}, {"type": "subtitle", "time": 27212.27, "timestamp": "07:33:32", "text": "是啊，就像如果你……我不知道你是否……"}, {"type": "subtitle", "time": 27216.07, "timestamp": "07:33:36", "text": "有时候在直播中会看到，对吧？我的"}, {"type": "subtitle", "time": 27219.03, "timestamp": "07:33:39", "text": "直播时我的声音听起来确实像机器人。"}, {"type": "subtitle", "time": 27222.548, "timestamp": "07:33:42", "text": "这是因为使用了噪声滤波器。"}, {"type": "subtitle", "time": 27225.27, "timestamp": "07:33:45", "text": "我不知道它为什么会那样做。"}, {"type": "subtitle", "time": 27230.628, "timestamp": "07:33:50", "text": "疼痛。我成功启动了游戏。"}, {"type": "subtitle", "time": 27232.868, "timestamp": "07:33:52", "text": "我们走吧。好的。让我们没有任何"}, {"type": "subtitle", "time": 27235.11, "timestamp": "07:33:55", "text": "废话不多说，我们换个场景吧。希望"}, {"type": "subtitle", "time": 27237.868, "timestamp": "07:33:57", "text": "你们在《Genki》这门课学得很好！"}]
[{"type": "subtitle", "time": 734.23, "timestamp": "00:12:14", "text": "卢比。奖杯炮。我没有做我需要的"}, {"type": "subtitle", "time": 736.35, "timestamp": "00:12:16", "text": "喝这种饮料"}, {"type": "subtitle", "time": 752.91, "timestamp": "00:12:32", "text": "吉普森。"}, {"type": "subtitle", "time": 756.71, "timestamp": "00:12:36", "text": "南。哇，这太酷了。我从未"}, {"type": "subtitle", "time": 759.069, "timestamp": "00:12:39", "text": "预计你可以买到很多"}, {"type": "subtitle", "time": 763.7, "timestamp": "00:12:43", "text": "事物。你累了吗？是的，我是"}, {"type": "subtitle", "time": 765.87, "timestamp": "00:12:45", "text": "[音乐]"}, {"type": "subtitle", "time": 769.99, "timestamp": "00:12:49", "text": "疲劳的。我累了。立即的。也许我会"}]
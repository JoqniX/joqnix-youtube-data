[{"type": "subtitle", "time": 18423.11, "timestamp": "05:07:03", "text": "那个东西。呃，那个词，不，那个词是"}, {"type": "subtitle", "time": 18424.19, "timestamp": "05:07:04", "text": "下载"}, {"type": "subtitle", "time": 18427.43, "timestamp": "05:07:07", "text": "视频片段发布的地方"}, {"type": "subtitle", "time": 18429.55, "timestamp": "05:07:09", "text": "呃，我们已经正式完成了所有……"}, {"type": "subtitle", "time": 18432.868, "timestamp": "05:07:12", "text": "来自 Twitch 的片段。现在只有 YouTuber 了"}, {"type": "subtitle", "time": 18434.27, "timestamp": "05:07:14", "text": "左边。后"}, {"type": "subtitle", "time": 18436.628, "timestamp": "05:07:16", "text": "之后我会乞求"}, {"type": "subtitle", "time": 18440.15, "timestamp": "05:07:20", "text": "大家都要剪辑我，但我还是要谢谢大家。"}, {"type": "subtitle", "time": 18443.75, "timestamp": "05:07:23", "text": "今天就到这里。很有趣。我去睡觉了。我"}, {"type": "subtitle", "time": 18445.59, "timestamp": "05:07:25", "text": "不想造成任何延误"}, {"type": "subtitle", "time": 18448.07, "timestamp": "05:07:28", "text": "更长。我也得去吃饭了。我做了"}, {"type": "subtitle", "time": 18451.75, "timestamp": "05:07:31", "text": "我吃了点午饭，哦不，是晚饭。"}, {"type": "subtitle", "time": 18455.11, "timestamp": "05:07:35", "text": "但我想要吃得更健康一些。所以"}, {"type": "subtitle", "time": 18458.39, "timestamp": "05:07:38", "text": "是的，我得……我得……"}, {"type": "subtitle", "time": 18460.39, "timestamp": "05:07:40", "text": "嗯，往米里加水什么的。"}, {"type": "subtitle", "time": 18462.39, "timestamp": "05:07:42", "text": "就像把所有东西都放进去一样。"}, {"type": "subtitle", "time": 18465.43, "timestamp": "05:07:45", "text": "冰箱里的东西都齐全。是的，我要走了"}, {"type": "subtitle", "time": 18468.39, "timestamp": "05:07:48", "text": "我要去吃尿。你们"}, {"type": "subtitle", "time": 18471.51, "timestamp": "05:07:51", "text": "小心。谢谢你今天抽出时间。明天"}, {"type": "subtitle", "time": 18473.51, "timestamp": "05:07:53", "text": "我们将尝试制作视频或"}, {"type": "subtitle", "time": 18476.23, "timestamp": "05:07:56", "text": "某物。我要强迫自己不要"}, {"type": "subtitle", "time": 18479.99, "timestamp": "05:07:59", "text": "强迫自己，挑战自己去尝试"}]
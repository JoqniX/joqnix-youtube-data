[{"type": "subtitle", "time": 16263.03, "timestamp": "04:31:03", "text": "录音文件夹位于 Google 云端硬盘中"}, {"type": "subtitle", "time": 16266.149, "timestamp": "04:31:06", "text": "嗯，或者说那个文件夹好像出了点问题。"}, {"type": "subtitle", "time": 16268.95, "timestamp": "04:31:08", "text": "Google 云端硬盘确实同步成功了，对吧？"}, {"type": "subtitle", "time": 16271.59, "timestamp": "04:31:11", "text": "当他停止录音时，呃……"}, {"type": "subtitle", "time": 16273.59, "timestamp": "04:31:13", "text": "上传到他的谷歌云端硬盘"}, {"type": "subtitle", "time": 16276.75, "timestamp": "04:31:16", "text": "就在背景中，对吧？"}, {"type": "subtitle", "time": 16282.95, "timestamp": "04:31:22", "text": "嗯，还有，还有，还有，嗯，他的编辑们"}, {"type": "subtitle", "time": 16285.349, "timestamp": "04:31:25", "text": "能够下载它，然后你就可以开始了"}, {"type": "subtitle", "time": 16287.03, "timestamp": "04:31:27", "text": "编辑后上传并推送到"}, {"type": "subtitle", "time": 16289.189, "timestamp": "04:31:29", "text": "YouTube。我们在谈论什么？我们"}, {"type": "subtitle", "time": 16291.67, "timestamp": "04:31:31", "text": "我们在看Techon，我当时非常激动。"}, {"type": "subtitle", "time": 16294.469, "timestamp": "04:31:34", "text": "我深受他的启发。他谈到了"}, {"type": "subtitle", "time": 16296.79, "timestamp": "04:31:36", "text": "Twitch上的赞助和其他一切"}, {"type": "subtitle", "time": 16298.79, "timestamp": "04:31:38", "text": "还有 YouTube。我们学到了很多东西。"}, {"type": "subtitle", "time": 16301.83, "timestamp": "04:31:41", "text": "关于品类推送等等。所以，"}, {"type": "subtitle", "time": 16304.389, "timestamp": "04:31:44", "text": "我们当时就像在看着科技公司转型一样。"}, {"type": "subtitle", "time": 16306.71, "timestamp": "04:31:46", "text": "呃，至少已经过了10分钟了。他"}, {"type": "subtitle", "time": 16310.99, "timestamp": "04:31:50", "text": "兄弟，我录了两个YouTube视频。"}, {"type": "subtitle", "time": 16314.149, "timestamp": "04:31:54", "text": "直播中如何进行？那是纯粹的溪流。"}, {"type": "subtitle", "time": 16316.63, "timestamp": "04:31:56", "text": "这就是理想的内容创作方式。"}, {"type": "subtitle", "time": 16319.71, "timestamp": "04:31:59", "text": "我希望以目标为导向"}]
[{"type": "subtitle", "time": 3545.069, "timestamp": "00:59:05", "text": "是"}, {"type": "subtitle", "time": 3555.549, "timestamp": "00:59:15", "text": "响亮。并非如此。"}, {"type": "subtitle", "time": 3558.789, "timestamp": "00:59:18", "text": "较少的。我应该吃这个吗？"}, {"type": "subtitle", "time": 3586.15, "timestamp": "00:59:46", "text": "做？加入面条，再加入酱汁。"}, {"type": "subtitle", "time": 3589.349, "timestamp": "00:59:49", "text": "混合。倒入沸水至刻度线。"}, {"type": "subtitle", "time": 3591.19, "timestamp": "00:59:51", "text": "充分搅拌。盖上盖子焖6分钟。"}]
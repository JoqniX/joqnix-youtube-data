[{"type": "subtitle", "time": 27120.388, "timestamp": "07:32:00", "text": "希望。我发誓，如果它行不通，我会……"}, {"type": "subtitle", "time": 27122.75, "timestamp": "07:32:02", "text": "我会像这样"}, {"type": "subtitle", "time": 27125.75, "timestamp": "07:32:05", "text": "不。是的，直播延迟了30分钟。"}, {"type": "subtitle", "time": 27128.15, "timestamp": "07:32:08", "text": "分钟逗号。我本应该从……开始"}, {"type": "subtitle", "time": 27131.11, "timestamp": "07:32:11", "text": "三位指挥官。呃，我得帮帮忙。"}, {"type": "subtitle", "time": 27131.948, "timestamp": "07:32:11", "text": "朋友"}, {"type": "subtitle", "time": 27136.07, "timestamp": "07:32:16", "text": "尽管。你知道，快乐不会说“不”"}, {"type": "subtitle", "time": 27138.19, "timestamp": "07:32:18", "text": "每当朋友在"}, {"type": "subtitle", "time": 27140.75, "timestamp": "07:32:20", "text": "需要。所以"}, {"type": "subtitle", "time": 27144.468, "timestamp": "07:32:24", "text": "是的。所以，呃，我那样做是为了能专注于……"}, {"type": "subtitle", "time": 27148.788, "timestamp": "07:32:28", "text": "呃，你知道，把它完成，而且"}, {"type": "subtitle", "time": 27152.07, "timestamp": "07:32:32", "text": "呃，我得抽出点时间来直播。"}, {"type": "subtitle", "time": 27153.83, "timestamp": "07:32:33", "text": "然后我就可以……再回来找他们了。"}, {"type": "subtitle", "time": 27157.03, "timestamp": "07:32:37", "text": "稍后再把它们也解决掉。"}, {"type": "subtitle", "time": 27159.67, "timestamp": "07:32:39", "text": "彻底完成帮助。我做了一半"}, {"type": "subtitle", "time": 27163.35, "timestamp": "07:32:43", "text": "他们中的。对，就是这样。那么，情况如何？"}, {"type": "subtitle", "time": 27165.468, "timestamp": "07:32:45", "text": "你们的一天"}, {"type": "subtitle", "time": 27167.75, "timestamp": "07:32:47", "text": "今天？距离我上次……已经有一段时间了。"}, {"type": "subtitle", "time": 27170.708, "timestamp": "07:32:50", "text": "我也玩过原神。而我是有意的"}, {"type": "subtitle", "time": 27172.948, "timestamp": "07:32:52", "text": "我故意没参加那个活动，因为我"}, {"type": "subtitle", "time": 27174.67, "timestamp": "07:32:54", "text": "想直播"}, {"type": "subtitle", "time": 27177.548, "timestamp": "07:32:57", "text": "它。"}]
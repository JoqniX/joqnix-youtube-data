[{"type": "subtitle", "time": 13989.59, "timestamp": "03:53:09", "text": "尽管。呃"}, {"type": "subtitle", "time": 14000.75, "timestamp": "03:53:20", "text": "[音乐]"}, {"type": "subtitle", "time": 14004.21, "timestamp": "03:53:24", "text": "嗯，我所做的"}, {"type": "subtitle", "time": 14024.51, "timestamp": "03:53:44", "text": "私信提醒他们我的体重"}, {"type": "subtitle", "time": 14028.469, "timestamp": "03:53:48", "text": "我很高兴我能得到我想要的"}, {"type": "subtitle", "time": 14035.349, "timestamp": "03:53:55", "text": "这里。我应该从我……的那一刻起就信任她。"}, {"type": "subtitle", "time": 14037.389, "timestamp": "03:53:57", "text": "我此刻"}]
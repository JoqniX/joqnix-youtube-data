[{"type": "subtitle", "time": 4982.87, "timestamp": "01:23:02", "text": "9:00 因为我当时就对他们说了"}, {"type": "subtitle", "time": 4984.99, "timestamp": "01:23:04", "text": "我跟他们说我感觉不太好。"}, {"type": "subtitle", "time": 4987.35, "timestamp": "01:23:07", "text": "因为我在吃杯子，所以饿了。"}, {"type": "subtitle", "time": 4996.55, "timestamp": "01:23:16", "text": "现在。顺便说一句，呃，我知道我"}, {"type": "subtitle", "time": 4997.95, "timestamp": "01:23:17", "text": "买了八个"}, {"type": "subtitle", "time": 5012.95, "timestamp": "01:23:32", "text": "等一下。我房间里有一个。"}, {"type": "subtitle", "time": 5015.83, "timestamp": "01:23:35", "text": "我要吃的，呃，拿走吧"}, {"type": "subtitle", "time": 5020.99, "timestamp": "01:23:40", "text": "现在。我给了阿姨两份，"}, {"type": "subtitle", "time": 5024.07, "timestamp": "01:23:44", "text": "叔叔。还有我的母亲和我的祖母"}, {"type": "subtitle", "time": 5026.47, "timestamp": "01:23:46", "text": "我不想要那个，所以留下了剩下的。"}]
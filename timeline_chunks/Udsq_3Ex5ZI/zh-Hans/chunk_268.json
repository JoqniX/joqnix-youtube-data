[{"type": "subtitle", "time": 16081.189, "timestamp": "04:28:01", "text": "好几年了，我也不知道是什么情况。"}, {"type": "subtitle", "time": 16084.55, "timestamp": "04:28:04", "text": "意味着成为一名创造者。我不"}, {"type": "subtitle", "time": 16087.189, "timestamp": "04:28:07", "text": "获得赞助。我没有多少。"}, {"type": "subtitle", "time": 16091.03, "timestamp": "04:28:11", "text": "观众向观众展示观众之类的东西。但"}, {"type": "subtitle", "time": 16094.55, "timestamp": "04:28:14", "text": "平均而言，CCV 之类的东西人们品牌会关注"}, {"type": "subtitle", "time": 16097.67, "timestamp": "04:28:17", "text": "现在还有一些其他的东西。而且还有很多"}, {"type": "subtitle", "time": 16100.59, "timestamp": "04:28:20", "text": "他解释的那些事"}, {"type": "subtitle", "time": 16102.59, "timestamp": "04:28:22", "text": "不像"}, {"type": "subtitle", "time": 16106.309, "timestamp": "04:28:26", "text": "哇，我之前对这些一无所知。"}, {"type": "subtitle", "time": 16110.269, "timestamp": "04:28:30", "text": "类别推送"}, {"type": "subtitle", "time": 16122.03, "timestamp": "04:28:42", "text": "疯狂的"}, {"type": "subtitle", "time": 16133.07, "timestamp": "04:28:53", "text": "哇。它是"}, {"type": "subtitle", "time": 16136.229, "timestamp": "04:28:56", "text": "疯狂的。就像，不，就像我会"}, {"type": "subtitle", "time": 16138.87, "timestamp": "04:28:58", "text": "我会如实告诉你我的感受。就像"}]
[{"type": "subtitle", "time": 3434.87, "timestamp": "00:57:14", "text": "提醒你。提醒你，因为我认识你"}, {"type": "subtitle", "time": 3438.27, "timestamp": "00:57:18", "text": "我会记住的，兄弟。来"}, {"type": "subtitle", "time": 3441.15, "timestamp": "00:57:21", "text": "在。来"}, {"type": "subtitle", "time": 3443.549, "timestamp": "00:57:23", "text": "在。是的，你当时"}, {"type": "subtitle", "time": 3451.829, "timestamp": "00:57:31", "text": "实际上。哦，天哪，奶油饼干是"}]
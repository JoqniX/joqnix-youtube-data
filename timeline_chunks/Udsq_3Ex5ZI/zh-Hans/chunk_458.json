[{"type": "subtitle", "time": 27481.868, "timestamp": "07:38:01", "text": "主要想做这件事"}, {"type": "subtitle", "time": 27489.868, "timestamp": "07:38:09", "text": "看起来很忙"}, {"type": "subtitle", "time": 27494.11, "timestamp": "07:38:14", "text": "所以我们需要解决掉这个人。"}, {"type": "subtitle", "time": 27497.75, "timestamp": "07:38:17", "text": "他的东西。我不知道为什么像某些人"}, {"type": "subtitle", "time": 27499.99, "timestamp": "07:38:19", "text": "事情就这么发生了，我从未碰过绫田"}, {"type": "subtitle", "time": 27502.35, "timestamp": "07:38:22", "text": "任务，但我刚刚用……解锁了它"}, {"type": "subtitle", "time": 27504.868, "timestamp": "07:38:24", "text": "关键故事线索。"}, {"type": "subtitle", "time": 27508.31, "timestamp": "07:38:28", "text": "然而，即使像这样的事件发生时也是如此。"}, {"type": "subtitle", "time": 27509.15, "timestamp": "07:38:29", "text": "来"}, {"type": "subtitle", "time": 27512.788, "timestamp": "07:38:32", "text": "他们想要的是某种特定的角色，"}, {"type": "subtitle", "time": 27514.948, "timestamp": "07:38:34", "text": "对，为了能够继续进行"}, {"type": "subtitle", "time": 27517.91, "timestamp": "07:38:37", "text": "活动任务，但没有快速完成的方法。是的，"}, {"type": "subtitle", "time": 27520.51, "timestamp": "07:38:40", "text": "甚至连快速启动都没有。"}, {"type": "subtitle", "time": 27523.35, "timestamp": "07:38:43", "text": "东西。我想我的确点击了快速链接"}, {"type": "subtitle", "time": 27526.548, "timestamp": "07:38:46", "text": "开始。我不知道，但我做不到。"}, {"type": "subtitle", "time": 27532.708, "timestamp": "07:38:52", "text": "为什么。我的意思是，如果能快速……"}, {"type": "subtitle", "time": 27535.35, "timestamp": "07:38:55", "text": "开始吧，它是为我准备的，但是……"}, {"type": "subtitle", "time": 27536.18, "timestamp": "07:38:56", "text": "不在那里"}, {"type": "subtitle", "time": 27538.35, "timestamp": "07:38:58", "text": "[音乐]"}]
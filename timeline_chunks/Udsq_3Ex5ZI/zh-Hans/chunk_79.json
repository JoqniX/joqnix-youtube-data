[{"type": "subtitle", "time": 4740.83, "timestamp": "01:19:00", "text": "再次？这个东西叫什么来着？"}, {"type": "subtitle", "time": 4743.229, "timestamp": "01:19:03", "text": "呃，你的电脑"}, {"type": "subtitle", "time": 4745.55, "timestamp": "01:19:05", "text": "电缆"}, {"type": "subtitle", "time": 4748.709, "timestamp": "01:19:08", "text": "管理。我已经整理好了我的线缆。"}, {"type": "subtitle", "time": 4753.91, "timestamp": "01:19:13", "text": "东西。但问题是，这有点像我"}, {"type": "subtitle", "time": 4757.27, "timestamp": "01:19:17", "text": "我忘了考虑这件事。什么？如果什么？"}, {"type": "subtitle", "time": 4759.91, "timestamp": "01:19:19", "text": "我回来了。我回来了。我回来了。有"}, {"type": "subtitle", "time": 4763.35, "timestamp": "01:19:23", "text": "晚安。好的。"}, {"type": "subtitle", "time": 4766.669, "timestamp": "01:19:26", "text": "好了，我回来了。该吃饭了。时间到了"}, {"type": "subtitle", "time": 4779.79, "timestamp": "01:19:39", "text": "耶。我的天啊。我的天啊。哦，我的"}, {"type": "subtitle", "time": 4783.99, "timestamp": "01:19:43", "text": "上帝。我的天啊。我的天啊。"}, {"type": "subtitle", "time": 4785.63, "timestamp": "01:19:45", "text": "我是"}, {"type": "subtitle", "time": 4788.11, "timestamp": "01:19:48", "text": "后退。希望你喜欢"}]
[{"type": "subtitle", "time": 14640.55, "timestamp": "04:04:00", "text": "某物。其实我并不介意。"}, {"type": "subtitle", "time": 14667.75, "timestamp": "04:04:27", "text": "最好的。这就是人们眼中的我。"}, {"type": "subtitle", "time": 14669.03, "timestamp": "04:04:29", "text": "正确的？"}, {"type": "subtitle", "time": 14672.469, "timestamp": "04:04:32", "text": "去我的频道看看。你看到了吗？这我"}, {"type": "subtitle", "time": 14674.75, "timestamp": "04:04:34", "text": "需要创建一个目录"}, {"type": "subtitle", "time": 14689.11, "timestamp": "04:04:49", "text": "我想创建一个细胞。不，是那个东西"}, {"type": "subtitle", "time": 14691.59, "timestamp": "04:04:51", "text": "我想一次性完成所有这些事情。"}, {"type": "subtitle", "time": 14694.309, "timestamp": "04:04:54", "text": "我得到了我的新凡人。这就是我的原因"}, {"type": "subtitle", "time": 14698.63, "timestamp": "04:04:58", "text": "呃，我应该这么做吗？"}, {"type": "subtitle", "time": 14699.87, "timestamp": "04:04:59", "text": "诚实地"}]
[{"type": "subtitle", "time": 16143.11, "timestamp": "04:29:03", "text": "现在，嗯，因为我太感兴趣了……"}, {"type": "subtitle", "time": 16145.189, "timestamp": "04:29:05", "text": "就像我现在观看时的感受一样"}, {"type": "subtitle", "time": 16148.07, "timestamp": "04:29:08", "text": "Takon真是个博学多识的人，所以"}, {"type": "subtitle", "time": 16151.269, "timestamp": "04:29:11", "text": "太棒了，而且是一位非常优秀的创作者。以便"}, {"type": "subtitle", "time": 16153.349, "timestamp": "04:29:13", "text": "这让我很想再去看看他的直播。"}, {"type": "subtitle", "time": 16156.349, "timestamp": "04:29:16", "text": "继续观察他。"}, {"type": "subtitle", "time": 16160.03, "timestamp": "04:29:20", "text": "小时。我想那样做。"}, {"type": "subtitle", "time": 16165.349, "timestamp": "04:29:25", "text": "实际上。所以，每一天都是如此。"}, {"type": "subtitle", "time": 16166.67, "timestamp": "04:29:26", "text": "新的"}, {"type": "subtitle", "time": 16169.189, "timestamp": "04:29:29", "text": "经验。虽然是同一个创作者，但"}, {"type": "subtitle", "time": 16171.67, "timestamp": "04:29:31", "text": "你仍然会看到一些新的东西"}, {"type": "subtitle", "time": 16174.79, "timestamp": "04:29:34", "text": "时间。你体内的多巴胺或其他什么东西"}, {"type": "subtitle", "time": 16177.83, "timestamp": "04:29:37", "text": "身体撞击，还有，嗯，你想保持"}, {"type": "subtitle", "time": 16181.03, "timestamp": "04:29:41", "text": "越来越关注这位创作者"}, {"type": "subtitle", "time": 16183.71, "timestamp": "04:29:43", "text": "想了解更多知识，想知道"}, {"type": "subtitle", "time": 16187.469, "timestamp": "04:29:47", "text": "各方面都更多，而且"}, {"type": "subtitle", "time": 16191.149, "timestamp": "04:29:51", "text": "纯粹的事物和一切。"}, {"type": "subtitle", "time": 16193.349, "timestamp": "04:29:53", "text": "这就是流媒体的娱乐方式。"}, {"type": "subtitle", "time": 16194.67, "timestamp": "04:29:54", "text": "应该"}, {"type": "subtitle", "time": 16196.269, "timestamp": "04:29:56", "text": "是"}]
[{"type": "subtitle", "time": 14164.11, "timestamp": "03:56:04", "text": "船。她弄到了100艘船，兄弟。那是"}, {"type": "subtitle", "time": 14167.71, "timestamp": "03:56:07", "text": "等等，那不是吗？"}, {"type": "subtitle", "time": 14171.67, "timestamp": "03:56:11", "text": "等等，那差不多有多少个船长？"}, {"type": "subtitle", "time": 14174.349, "timestamp": "03:56:14", "text": "你需要100个吗？"}, {"type": "subtitle", "time": 14177.63, "timestamp": "03:56:17", "text": "船？那相当于 1000 万 C。"}, {"type": "subtitle", "time": 14182.59, "timestamp": "03:56:22", "text": "等等，多少钱？我想看看。"}, {"type": "subtitle", "time": 14193.79, "timestamp": "03:56:33", "text": "等等，8K。哦，我的"}, {"type": "subtitle", "time": 14202.73, "timestamp": "03:56:42", "text": "那"}, {"type": "subtitle", "time": 14205.87, "timestamp": "03:56:45", "text": "[音乐]"}, {"type": "subtitle", "time": 14209.189, "timestamp": "03:56:49", "text": "叽叽喳喳？粉丝数量，数量"}, {"type": "subtitle", "time": 14212.229, "timestamp": "03:56:52", "text": "球迷，8 分。哦，等等。她的粉丝数量"}, {"type": "subtitle", "time": 14215.99, "timestamp": "03:56:55", "text": "较少。 8K。好的。锚点不在。"}, {"type": "subtitle", "time": 14217.429, "timestamp": "03:56:57", "text": "只要用心留意，你就能收到"}]
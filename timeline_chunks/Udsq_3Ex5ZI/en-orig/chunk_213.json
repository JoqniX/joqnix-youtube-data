[{"type": "subtitle", "time": 12788.63, "timestamp": "03:33:08", "text": "He will abandon you, my sweet Elizabeth."}, {"type": "subtitle", "time": 12790.55, "timestamp": "03:33:10", "text": "Once he has what he needs, he will leave"}, {"type": "subtitle", "time": 12793.349, "timestamp": "03:33:13", "text": "you alone. What else can you expect from"}, {"type": "subtitle", "time": 12796.91, "timestamp": "03:33:16", "text": "a liar and killer of women?"}, {"type": "subtitle", "time": 12824.389, "timestamp": "03:33:44", "text": "Rockets."}]
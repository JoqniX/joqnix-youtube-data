[{"type": "subtitle", "time": 14640.55, "timestamp": "04:04:00", "text": "等等的時候，我一直在尋找"}, {"type": "subtitle", "time": 14667.75, "timestamp": "04:04:27", "text": "合適的人。我的訂閱用戶達到了54人。我們一起去上學吧"}, {"type": "subtitle", "time": 14672.469, "timestamp": "04:04:32", "text": "。謝謝。人真不少啊！現在人可真不少。從一開始就有人在。就像一群非常非常"}, {"type": "subtitle", "time": 14694.309, "timestamp": "04:04:54", "text": "古老的元老級人物。女王分享團隊現實分享"}]
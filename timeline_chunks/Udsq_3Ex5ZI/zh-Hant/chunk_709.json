[{"type": "subtitle", "time": 42541.106, "timestamp": "11:49:01", "text": "但我覺得它已經太大了"}, {"type": "subtitle", "time": 42550.79, "timestamp": "11:49:10", "text": "。即使對我來說它們很小，但我把它們看作像"}, {"type": "subtitle", "time": 42558.426, "timestamp": "11:49:18", "text": "企業集團一樣的大公司。這就是"}, {"type": "subtitle", "time": 42588.55, "timestamp": "11:49:48", "text": "為什麼 Sask 和壽司生活就像一個 shima 集團，你可以說它和 Nilasan 和 Ivaki 一起，"}]
[{"type": "subtitle", "time": 23535.99, "timestamp": "06:32:15", "text": "知道嗎？我要[音樂] 去救Shino。他怎麼了？你好。完畢。好了。 [音樂] 好了，他被關起來了。別再這樣了。哦，我們可以扮演阿亞特。我的天啊。"}, {"type": "subtitle", "time": 23553.948, "timestamp": "06:32:33", "text": "什麼？他太酷了。等等，這是什麼？"}, {"type": "subtitle", "time": 23558.23, "timestamp": "06:32:38", "text": "什麼？等一下"}, {"type": "subtitle", "time": 23563.51, "timestamp": "06:32:43", "text": "。這太強了。寶貝，"}, {"type": "subtitle", "time": 23565.548, "timestamp": "06:32:45", "text": "什麼？比神坂還厲害。"}, {"type": "subtitle", "time": 23579.27, "timestamp": "06:32:59", "text": "寶貝，這太酷了。什麼？"}]
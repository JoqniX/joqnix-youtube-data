[{"type": "subtitle", "time": 27064.468, "timestamp": "07:31:04", "text": "音樂] 哦，天哪。告訴我們這件事。這只是在開玩笑。 [音樂] 咚咚咚"}, {"type": "subtitle", "time": 27078.708, "timestamp": "07:31:18", "text": "。不，我要說謊。"}, {"type": "subtitle", "time": 27083.708, "timestamp": "07:31:23", "text": "我一直在嘗試"}, {"type": "subtitle", "time": 27089.19, "timestamp": "07:31:29", "text": "發出呃童年的提示音，但我做不到我當時就想，“哇。” [音樂] [笑聲] [音樂] 最佳報道。"}, {"type": "subtitle", "time": 27109.23, "timestamp": "07:31:49", "text": "祝你倒楣。  你畫得"}, {"type": "subtitle", "time": 27115.468, "timestamp": "07:31:55", "text": "真好。 [音樂] 的表情迫不及待地想看到你"}]
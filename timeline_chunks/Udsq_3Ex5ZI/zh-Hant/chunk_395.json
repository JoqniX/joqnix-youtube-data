[{"type": "subtitle", "time": 23712.99, "timestamp": "06:35:12", "text": "麥克風怎麼了？等等，什麼？等等，麥克風怎麼了？等等，什麼？"}, {"type": "subtitle", "time": 23718.708, "timestamp": "06:35:18", "text": "你聽不到我"}, {"type": "subtitle", "time": 23723.63, "timestamp": "06:35:23", "text": "說話嗎？怎麼回事？怎麼回事？怎麼回事？怎麼回事？"}, {"type": "subtitle", "time": 23724.788, "timestamp": "06:35:24", "text": "[音樂][音樂]"}, {"type": "subtitle", "time": 23727.468, "timestamp": "06:35:27", "text": "你會說話嗎？麥克風卡頓了。啊，是我的降噪功能。原來如此。原來如此。"}, {"type": "subtitle", "time": 23753.35, "timestamp": "06:35:53", "text": "對不起，塔莉婭。我對此無能為力。就是……這意味著我的電腦卡頓了。這很煩人，但這真的太"}]
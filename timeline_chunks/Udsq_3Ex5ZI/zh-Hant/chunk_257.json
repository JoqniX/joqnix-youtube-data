[{"type": "subtitle", "time": 15420.349, "timestamp": "04:17:00", "text": "聊天記錄飛速增長，我都"}, {"type": "subtitle", "time": 15423.99, "timestamp": "04:17:03", "text": "感覺多巴胺飆升，特別爽。這很棒。而且"}, {"type": "subtitle", "time": 15434.07, "timestamp": "04:17:14", "text": "我還有一點小技巧，所以"}, {"type": "subtitle", "time": 15436.469, "timestamp": "04:17:16", "text": "我可以同時做"}, {"type": "subtitle", "time": 15439.189, "timestamp": "04:17:19", "text": "這兩件事。我他媽太喜歡它了。  這很棒。"}, {"type": "subtitle", "time": 15442.79, "timestamp": "04:17:22", "text": "YouTube 直播、"}, {"type": "subtitle", "time": 15448.309, "timestamp": "04:17:28", "text": "Twitch直播、專屬視頻，它們都不會消失。開頭一個，結尾一個，中間一個。雖然花了"}, {"type": "subtitle", "time": 15453.11, "timestamp": "04:17:33", "text": "六年時間才醒悟過來，但各公司開始意識到自己正被人佔便宜。整合環節很容易被忽略，"}, {"type": "subtitle", "time": 15461.59, "timestamp": "04:17:41", "text": "所以我盡可能地在影片中加入"}, {"type": "subtitle", "time": 15474.71, "timestamp": "04:17:54", "text": "整合環節。 YouTube，很多創作者都在大量觀看，公司也開始意識到這一點，很多公司開始失去信心，因為很多頂級創作者都在觀看，這其實並不"}]
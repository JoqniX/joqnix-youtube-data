[{"type": "subtitle", "time": 30185.19, "timestamp": "08:23:05", "text": "我們來看看即將到來的這些。  我永遠也完不成[音樂]。"}, {"type": "subtitle", "time": 30201.548, "timestamp": "08:23:21", "text": "我們將對此進行探討。我們去拿個雞蛋進去吧。好的，在我走之前，呃，讓我呃，讓我呃，把這個關掉。"}, {"type": "subtitle", "time": 30218.67, "timestamp": "08:23:38", "text": "好的。呃，我這就關掉這個視窗。"}, {"type": "subtitle", "time": 30221.71, "timestamp": "08:23:41", "text": "我把它放在這裡，然後我們很快就上去了。所以，我不用擔心，對吧"}]
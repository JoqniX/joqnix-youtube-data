[{"type": "subtitle", "time": 29706.628, "timestamp": "08:15:06", "text": "？我忘了她"}, {"type": "subtitle", "time": 29710.67, "timestamp": "08:15:10", "text": "叫什麼名字。  萊拉。  莉娜。莉娜。莉娜。正確的。是的。"}, {"type": "subtitle", "time": 29736.31, "timestamp": "08:15:36", "text": "啊。"}, {"type": "subtitle", "time": 29748.948, "timestamp": "08:15:48", "text": "哦好的。  我的錯。到時候過來吧。  [音樂] 嘿，熱浪。  [音樂] 嗨"}]
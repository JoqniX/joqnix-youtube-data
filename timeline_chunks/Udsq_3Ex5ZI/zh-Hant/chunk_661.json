[{"type": "subtitle", "time": 39664.586, "timestamp": "11:01:04", "text": "我上次休息是什麼時候？我做了"}, {"type": "subtitle", "time": 39673.906, "timestamp": "11:01:13", "text": "海灘溪流之類的事情是什麼時候？對，就是那個"}, {"type": "subtitle", "time": 39695.586, "timestamp": "11:01:35", "text": "地方。所以，如果一切順利的話，我就可以把我的"}, {"type": "subtitle", "time": 39697.55, "timestamp": "11:01:37", "text": "電腦設定好，把所有事情都安排妥當。"}, {"type": "subtitle", "time": 39703.07, "timestamp": "11:01:43", "text": "我唯一擔心的是隱私問題，這樣我就無法在晚上進行"}, {"type": "subtitle", "time": 39706.266, "timestamp": "11:01:46", "text": "直播之類的活動了。哦"}, {"type": "subtitle", "time": 39710.15, "timestamp": "11:01:50", "text": "，真的，隨便。另外，最重要的是，就像"}, {"type": "subtitle", "time": 39716.19, "timestamp": "11:01:56", "text": "火燒到賓士車上一樣，因為我也在那裡。就這樣，就這樣，還能說什麼呢？"}]
[{"type": "subtitle", "time": 16923.31, "timestamp": "04:42:03", "text": "直播是"}, {"type": "subtitle", "time": 16926.948, "timestamp": "04:42:06", "text": "我臨時起意的。 YouTube不提供兌換服務。呃，你"}, {"type": "subtitle", "time": 16928.03, "timestamp": "04:42:08", "text": "可以通過……來補充"}, {"type": "subtitle", "time": 16931.43, "timestamp": "04:42:11", "text": "水分。兌換保濕產品。你可以這樣做。 YouTube的視頻流量不足以維持其正常運營。呃，各位，我該怎麼辦"}, {"type": "subtitle", "time": 16933.51, "timestamp": "04:42:13", "text": "？ 這裡"}, {"type": "subtitle", "time": 16935.868, "timestamp": "04:42:15", "text": "有人知道原因嗎"}, {"type": "subtitle", "time": 16938.788, "timestamp": "04:42:18", "text": "？終於實現了轉碼功能，讓人們"}, {"type": "subtitle", "time": 16957.788, "timestamp": "04:42:37", "text": "可以更改畫質，我才真正感到高興。我該怎麼辦？ 我該怎麼辦？ 呃，YouTube頭枕？ 請問有人"}, {"type": "subtitle", "time": 16968.868, "timestamp": "04:42:48", "text": "知道嗎？ 我該"}, {"type": "subtitle", "time": 16975.51, "timestamp": "04:42:55", "text": "做YouTube上的那種頭槌攻擊嗎？"}]
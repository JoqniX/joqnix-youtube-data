[{"type": "subtitle", "time": 18842.15, "timestamp": "05:14:02", "text": "また、私は、えーと、いくつかの曲を演奏する予定でした。"}, {"type": "subtitle", "time": 18845.07, "timestamp": "05:14:05", "text": "非企業音楽ですが、私は偶然"}, {"type": "subtitle", "time": 18849.27, "timestamp": "05:14:09", "text": "日本の音楽の著作権を持っていた"}, {"type": "subtitle", "time": 18858.19, "timestamp": "05:14:18", "text": "怖がった。何？ナニが"}, {"type": "subtitle", "time": 18861.27, "timestamp": "05:14:21", "text": "それがそこにあるとき"}, {"type": "subtitle", "time": 18864.15, "timestamp": "05:14:24", "text": "YouTubeはライブ配信を開始しました"}, {"type": "subtitle", "time": 18868.67, "timestamp": "05:14:28", "text": "ストリームは、私たちが単にしなかった"}, {"type": "subtitle", "time": 18871.35, "timestamp": "05:14:31", "text": "みんなの一日がどんな感じか、そして幸せかどうかを知る"}, {"type": "subtitle", "time": 18872.43, "timestamp": "05:14:32", "text": "誕生日"}, {"type": "subtitle", "time": 18875.75, "timestamp": "05:14:35", "text": "ズキ、寝てしまって本当にごめんなさい。"}, {"type": "subtitle", "time": 18889.39, "timestamp": "05:14:49", "text": "なんでこんなに眠いんだろう？なぜなら私は"}, {"type": "subtitle", "time": 18893.67, "timestamp": "05:14:53", "text": "えっと、この暑いところに座って、何が起きてるの？"}, {"type": "subtitle", "time": 18896.19, "timestamp": "05:14:56", "text": "熱って呼ぶの？"}, {"type": "subtitle", "time": 18898.948, "timestamp": "05:14:58", "text": "恐喝？熱中症。それは何？"}]
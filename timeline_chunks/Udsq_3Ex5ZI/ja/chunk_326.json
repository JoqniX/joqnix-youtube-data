[{"type": "subtitle", "time": 19568.27, "timestamp": "05:26:08", "text": "これ"}, {"type": "subtitle", "time": 19571.15, "timestamp": "05:26:11", "text": "それも悪い。お電話ありがとうございます"}, {"type": "subtitle", "time": 19575.11, "timestamp": "05:26:15", "text": "昨日私は目を覚まさなかったけれど"}, {"type": "subtitle", "time": 19579.83, "timestamp": "05:26:19", "text": "たとえその後でも、どうやって"}, {"type": "subtitle", "time": 19582.55, "timestamp": "05:26:22", "text": "昨日、何件の電話を受けましたか？"}, {"type": "subtitle", "time": 19585.82, "timestamp": "05:26:25", "text": "えっと、ズキの配信中に"}, {"type": "subtitle", "time": 19593.03, "timestamp": "05:26:33", "text": "1つ、うん、10個だよ"}, {"type": "subtitle", "time": 19597.07, "timestamp": "05:26:37", "text": "[音楽]"}, {"type": "subtitle", "time": 19599.99, "timestamp": "05:26:39", "text": "それにたくさんの人、つまり10人"}, {"type": "subtitle", "time": 19604.47, "timestamp": "05:26:44", "text": "電話してきたけど、私に電話しようとしたけど、えっと、"}, {"type": "subtitle", "time": 19608.07, "timestamp": "05:26:48", "text": "一人当たり2～3回。私はまだ"}, {"type": "subtitle", "time": 19609.868, "timestamp": "05:26:49", "text": "目を覚まさなかった"}, {"type": "subtitle", "time": 19614.23, "timestamp": "05:26:54", "text": "上。それで、私のいとこがここにいる"}, {"type": "subtitle", "time": 19617.948, "timestamp": "05:26:57", "text": "私の、えーと、彼はここにいます"}]
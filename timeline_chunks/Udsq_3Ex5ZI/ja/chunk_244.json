[{"type": "subtitle", "time": 14640.55, "timestamp": "04:04:00", "text": "何か。実際、それで構いません。"}, {"type": "subtitle", "time": 14667.75, "timestamp": "04:04:27", "text": "最高。つまり、人々は私をこのように見ているということです。"}, {"type": "subtitle", "time": 14669.03, "timestamp": "04:04:29", "text": "右？"}, {"type": "subtitle", "time": 14672.469, "timestamp": "04:04:32", "text": "私のチャンネルへ行ってください。これが見えますか？これは私が"}, {"type": "subtitle", "time": 14674.75, "timestamp": "04:04:34", "text": "間接的に行う必要がある"}, {"type": "subtitle", "time": 14689.11, "timestamp": "04:04:49", "text": "そして、細胞を作りたいのです。いや、それは"}, {"type": "subtitle", "time": 14691.59, "timestamp": "04:04:51", "text": "私はこれらすべてを一度はやってみたい"}, {"type": "subtitle", "time": 14694.309, "timestamp": "04:04:54", "text": "私は新しい人間を手に入れた。だから私は"}, {"type": "subtitle", "time": 14698.63, "timestamp": "04:04:58", "text": "えっと、やるべきでしょうか？"}, {"type": "subtitle", "time": 14699.87, "timestamp": "04:04:59", "text": "正直に"}]
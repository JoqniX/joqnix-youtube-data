[{"type": "subtitle", "time": 13260.52, "timestamp": "03:41:00", "text": "より良い。待って、あれは何？"}, {"type": "subtitle", "time": 13274.309, "timestamp": "03:41:14", "text": "私は借金があった。そこに男がいる。彼"}, {"type": "subtitle", "time": 13276.389, "timestamp": "03:41:16", "text": "その代わりに私の借金を帳消しにしてくれると申し出た。"}, {"type": "subtitle", "time": 13278.01, "timestamp": "03:41:18", "text": "あなたのために。"}, {"type": "subtitle", "time": 13290.79, "timestamp": "03:41:30", "text": "来て。すべてうまくいくよ。"}, {"type": "subtitle", "time": 13292.389, "timestamp": "03:41:32", "text": "振り向いて話しかけて"}, {"type": "subtitle", "time": 13316.63, "timestamp": "03:41:56", "text": "プレイリストに追加しておきます。"}]
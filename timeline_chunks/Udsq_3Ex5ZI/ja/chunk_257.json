[{"type": "subtitle", "time": 15420.349, "timestamp": "04:17:00", "text": "このライブ配信の間に、私は"}, {"type": "subtitle", "time": 15422.55, "timestamp": "04:17:02", "text": "現在、12,600人が私を見ています。はい、"}, {"type": "subtitle", "time": 15423.99, "timestamp": "04:17:03", "text": "それはとても、とても、とても気持ちがいい。そして私は"}, {"type": "subtitle", "time": 15426.07, "timestamp": "04:17:06", "text": "私の両方の配信を見てくださる皆さんに感謝します。"}, {"type": "subtitle", "time": 15427.75, "timestamp": "04:17:07", "text": "ようこそ、皆さん。お二人ともありがとうございました"}, {"type": "subtitle", "time": 15430.71, "timestamp": "04:17:10", "text": "ここ。おやすみ。皆さん、ありがとうございました。ああ、"}, {"type": "subtitle", "time": 15432.469, "timestamp": "04:17:12", "text": "待って。いいえ、まだです。それは"}, {"type": "subtitle", "time": 15434.07, "timestamp": "04:17:14", "text": "つまり、私が配信をしようとしたら"}, {"type": "subtitle", "time": 15436.469, "timestamp": "04:17:16", "text": "オファーというのは、私が報酬を受け取れるという意味ですか？"}, {"type": "subtitle", "time": 15439.189, "timestamp": "04:17:19", "text": "私の両方の配信についてですか？いいえ。残念ながら、"}, {"type": "subtitle", "time": 15440.79, "timestamp": "04:17:20", "text": "それはそういう仕組みではない、なぜなら"}, {"type": "subtitle", "time": 15442.79, "timestamp": "04:17:22", "text": "YouTube、あなたの収入は減るでしょう"}, {"type": "subtitle", "time": 15444.95, "timestamp": "04:17:24", "text": "押していないため"}, {"type": "subtitle", "time": 15447.03, "timestamp": "04:17:27", "text": "カテゴリがあり、すでにストリーミングしています"}, {"type": "subtitle", "time": 15448.309, "timestamp": "04:17:28", "text": "Twitchでは、つまり"}, {"type": "subtitle", "time": 15450.87, "timestamp": "04:17:30", "text": "簡約和を得る。だから、それはただ"}, {"type": "subtitle", "time": 15453.11, "timestamp": "04:17:33", "text": "ちょっとした嬉しいボーナスですね。だから、2時間"}, {"type": "subtitle", "time": 15455.349, "timestamp": "04:17:35", "text": "配信すれば、おそらく12,300ドルもらえるだろう"}, {"type": "subtitle", "time": 15457.03, "timestamp": "04:17:37", "text": "Twitchでの配信のみを対象としています。その後、"}, {"type": "subtitle", "time": 15458.87, "timestamp": "04:17:38", "text": "私もYouTubeで配信しているので、"}, {"type": "subtitle", "time": 15461.59, "timestamp": "04:17:41", "text": "20～30％程度のボーナスがもらえるかもしれない。それで、"}, {"type": "subtitle", "time": 15463.75, "timestamp": "04:17:43", "text": "追加で2.5～3Kもらえるかもしれない"}, {"type": "subtitle", "time": 15465.51, "timestamp": "04:17:45", "text": "なぜなら現実的に考えて、彼らは"}, {"type": "subtitle", "time": 15467.189, "timestamp": "04:17:47", "text": "カテゴリーの推進を本当に望んでいる"}, {"type": "subtitle", "time": 15469.75, "timestamp": "04:17:49", "text": "そこには。わかった。私はあまり知らなかった"}, {"type": "subtitle", "time": 15472.469, "timestamp": "04:17:52", "text": "ストリーミングについてできること"}, {"type": "subtitle", "time": 15474.71, "timestamp": "04:17:54", "text": "ライブ配信。 4つをおすすめします"}, {"type": "subtitle", "time": 15476.389, "timestamp": "04:17:56", "text": "少なくとも5日間は"}, {"type": "subtitle", "time": 15478.349, "timestamp": "04:17:58", "text": "週。それは素晴らしい。本当に"}]
[{"type": "subtitle", "time": 30185.19, "timestamp": "08:23:05", "text": "ホラー映画を観ています。"}, {"type": "subtitle", "time": 30186.628, "timestamp": "08:23:06", "text": "誰かが私の"}, {"type": "subtitle", "time": 30191.07, "timestamp": "08:23:11", "text": "ウィンドウ。ああ、それは本当に素晴らしい"}, {"type": "subtitle", "time": 30201.548, "timestamp": "08:23:21", "text": "それ。私たちはあちらへ手を伸ばす必要がある、"}, {"type": "subtitle", "time": 30205.07, "timestamp": "08:23:25", "text": "右？テレポートオーバー"}, {"type": "subtitle", "time": 30218.67, "timestamp": "08:23:38", "text": "はぁ？わかった。"}, {"type": "subtitle", "time": 30221.71, "timestamp": "08:23:41", "text": "それでね、知ってる？私は行きます"}, {"type": "subtitle", "time": 30230.51, "timestamp": "08:23:50", "text": "保存する"}, {"type": "subtitle", "time": 30233.468, "timestamp": "08:23:53", "text": "シノ。何が起こったのか"}]
[{"type": "subtitle", "time": 13690.189, "timestamp": "03:48:10", "text": "いいえ、そこにはありません。"}, {"type": "subtitle", "time": 13698.59, "timestamp": "03:48:18", "text": "もう。彼女の人間としての姿は"}, {"type": "subtitle", "time": 13702.429, "timestamp": "03:48:22", "text": "これ。ああ、そう、"}, {"type": "subtitle", "time": 13707.07, "timestamp": "03:48:27", "text": "このボーイッシュな感じのクールな感じ"}, {"type": "subtitle", "time": 13710.469, "timestamp": "03:48:30", "text": "レディ。これは新しいモデルだと思います"}, {"type": "subtitle", "time": 13715.349, "timestamp": "03:48:35", "text": "何か。中国の中世モデルは"}, {"type": "subtitle", "time": 13719.63, "timestamp": "03:48:39", "text": "めっちゃかっこいいよ。それはとても"}, {"type": "subtitle", "time": 13728.15, "timestamp": "03:48:48", "text": "彼らには独特の魅力があるんだよ、"}, {"type": "subtitle", "time": 13730.189, "timestamp": "03:48:50", "text": "見てみると"}]
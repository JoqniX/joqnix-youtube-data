[{"type": "subtitle", "time": 3494.51, "timestamp": "00:58:14", "text": "拳？どうやら私は"}, {"type": "subtitle", "time": 3497.069, "timestamp": "00:58:17", "text": "そうしなかった。そうそう。私は幸せを感じなかった"}, {"type": "subtitle", "time": 3535.789, "timestamp": "00:58:55", "text": "[音楽]"}, {"type": "subtitle", "time": 3539.19, "timestamp": "00:58:59", "text": "人々。インスタント。これはとても少ないように見えます"}]
[{"type": "subtitle", "time": 27967.15, "timestamp": "07:46:07", "text": "センス。私がとても眠くても気にしないでください"}, {"type": "subtitle", "time": 27971.99, "timestamp": "07:46:11", "text": "疲れているのは、通常この時間帯は"}, {"type": "subtitle", "time": 27974.548, "timestamp": "07:46:14", "text": "朝はいつでも朝は"}, {"type": "subtitle", "time": 27976.948, "timestamp": "07:46:16", "text": "疲れているとか、そういう感じ。理由はわからない"}, {"type": "subtitle", "time": 27984.19, "timestamp": "07:46:24", "text": "[音楽]"}, {"type": "subtitle", "time": 27987.628, "timestamp": "07:46:27", "text": "は。でも、そのうち慣れるでしょう。私"}, {"type": "subtitle", "time": 27992.468, "timestamp": "07:46:32", "text": "たぶん、私は自分のことをするだろう。なぜ私は怠けているのだろうか？"}, {"type": "subtitle", "time": 27995.59, "timestamp": "07:46:35", "text": "立ち上がらせてください。"}]
[{"type": "subtitle", "time": 27120.388, "timestamp": "07:32:00", "text": "希望。誓って言うけど、もしうまくいかなかったら、"}, {"type": "subtitle", "time": 27122.75, "timestamp": "07:32:02", "text": "私はこう思うだろう"}, {"type": "subtitle", "time": 27125.75, "timestamp": "07:32:05", "text": "いいえ。ええ、配信は30秒遅れました"}, {"type": "subtitle", "time": 27128.15, "timestamp": "07:32:08", "text": "分コンマ。私は、"}, {"type": "subtitle", "time": 27131.11, "timestamp": "07:32:11", "text": "3人の指揮官。えっと、私は"}, {"type": "subtitle", "time": 27131.948, "timestamp": "07:32:11", "text": "友人"}, {"type": "subtitle", "time": 27136.07, "timestamp": "07:32:16", "text": "けれど。喜びはノーとは言わない"}, {"type": "subtitle", "time": 27138.19, "timestamp": "07:32:18", "text": "友達が"}, {"type": "subtitle", "time": 27140.75, "timestamp": "07:32:20", "text": "必要。それで"}, {"type": "subtitle", "time": 27144.468, "timestamp": "07:32:24", "text": "うん。それで、私は集中できるようにそうしました"}, {"type": "subtitle", "time": 27148.788, "timestamp": "07:32:28", "text": "えっと、仕上げて、そして"}, {"type": "subtitle", "time": 27152.07, "timestamp": "07:32:32", "text": "えっと、配信をする時間を作って"}, {"type": "subtitle", "time": 27153.83, "timestamp": "07:32:33", "text": "そして私は彼らのところに戻って来ることができます"}, {"type": "subtitle", "time": 27157.03, "timestamp": "07:32:37", "text": "後でそれらを終わらせる"}, {"type": "subtitle", "time": 27159.67, "timestamp": "07:32:39", "text": "完全に完全に手伝いを終えました。半分やった"}, {"type": "subtitle", "time": 27163.35, "timestamp": "07:32:43", "text": "彼らのうちの。そう、そんな感じ。それで、どうだったか"}, {"type": "subtitle", "time": 27165.468, "timestamp": "07:32:45", "text": "君たちの日"}, {"type": "subtitle", "time": 27167.75, "timestamp": "07:32:47", "text": "今日？そして、私が"}, {"type": "subtitle", "time": 27170.708, "timestamp": "07:32:50", "text": "原神もプレイしました。そして私は意図的に"}, {"type": "subtitle", "time": 27172.948, "timestamp": "07:32:52", "text": "私は意図的にイベントに参加しませんでした"}, {"type": "subtitle", "time": 27174.67, "timestamp": "07:32:54", "text": "ストリーミング配信したかった"}, {"type": "subtitle", "time": 27177.548, "timestamp": "07:32:57", "text": "それ。"}]
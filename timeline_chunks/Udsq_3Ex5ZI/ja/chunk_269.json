[{"type": "subtitle", "time": 16143.11, "timestamp": "04:29:03", "text": "えっと、私は興味がありすぎるので"}, {"type": "subtitle", "time": 16145.189, "timestamp": "04:29:05", "text": "今見ていると、まさにこんな気持ちになる"}, {"type": "subtitle", "time": 16148.07, "timestamp": "04:29:08", "text": "タコンはとても情報通なので、"}, {"type": "subtitle", "time": 16151.269, "timestamp": "04:29:11", "text": "かっこいいし、本当に素晴らしいクリエイターだ。となることによって"}, {"type": "subtitle", "time": 16153.349, "timestamp": "04:29:13", "text": "彼の配信にまた来たくなる"}, {"type": "subtitle", "time": 16156.349, "timestamp": "04:29:16", "text": "そして彼を見守り続ける"}, {"type": "subtitle", "time": 16160.03, "timestamp": "04:29:20", "text": "時間。私はそれをしたい"}, {"type": "subtitle", "time": 16165.349, "timestamp": "04:29:25", "text": "実は。だから毎日が"}, {"type": "subtitle", "time": 16166.67, "timestamp": "04:29:26", "text": "新しい"}, {"type": "subtitle", "time": 16169.189, "timestamp": "04:29:29", "text": "経験。同じクリエイターですが"}, {"type": "subtitle", "time": 16171.67, "timestamp": "04:29:31", "text": "それでも、毎日新しい発見がある"}, {"type": "subtitle", "time": 16174.79, "timestamp": "04:29:34", "text": "時間。あなたのドーパミンか何かがあなたの"}, {"type": "subtitle", "time": 16177.83, "timestamp": "04:29:37", "text": "ボディーヒットして、えっと、あなたは"}, {"type": "subtitle", "time": 16181.03, "timestamp": "04:29:41", "text": "このクリエイターをますます見ていく"}, {"type": "subtitle", "time": 16183.71, "timestamp": "04:29:43", "text": "もっと知識を知りたい"}, {"type": "subtitle", "time": 16187.469, "timestamp": "04:29:47", "text": "あらゆるものをもっと"}, {"type": "subtitle", "time": 16191.149, "timestamp": "04:29:51", "text": "物と純粋なものすべて"}, {"type": "subtitle", "time": 16193.349, "timestamp": "04:29:53", "text": "エンターテイメント、それがストリーミングです"}, {"type": "subtitle", "time": 16194.67, "timestamp": "04:29:54", "text": "すべき"}, {"type": "subtitle", "time": 16196.269, "timestamp": "04:29:56", "text": "なれ"}, {"type": "subtitle", "time": 16199.67, "timestamp": "04:29:59", "text": "うん、それは本当にやらなきゃいけないことだ"}]
[{"type": "subtitle", "time": 16022.11, "timestamp": "04:27:02", "text": "[音楽]"}, {"type": "subtitle", "time": 16026.55, "timestamp": "04:27:06", "text": "どうやって？私は何をすべきですか？何？ああ神様、私は"}, {"type": "subtitle", "time": 16029.229, "timestamp": "04:27:09", "text": "編集者がいません。 Gh"}, {"type": "subtitle", "time": 16032.63, "timestamp": "04:27:12", "text": "痛み。私が頼れるのはあなたたちだけです"}, {"type": "subtitle", "time": 16035.469, "timestamp": "04:27:15", "text": "クリップ、ショット用、そして"}, {"type": "subtitle", "time": 16038.55, "timestamp": "04:27:18", "text": "もの。しかし、ビデオコンテンツの場合は、"}, {"type": "subtitle", "time": 16042.189, "timestamp": "04:27:22", "text": "今から考え始めてください。何ができるだろうか"}, {"type": "subtitle", "time": 16045.99, "timestamp": "04:27:25", "text": "する？つまり、私はそれを実行するための手段を知っているということです。"}, {"type": "subtitle", "time": 16048.469, "timestamp": "04:27:28", "text": "ただ、私のPCでは録画ができないんです。"}, {"type": "subtitle", "time": 16049.309, "timestamp": "04:27:29", "text": "そして"}, {"type": "subtitle", "time": 16052.55, "timestamp": "04:27:32", "text": "すべて。 CPU使用率は100%になります。"}, {"type": "subtitle", "time": 16054.269, "timestamp": "04:27:34", "text": "いいえ。"}, {"type": "subtitle", "time": 16061.429, "timestamp": "04:27:41", "text": "えっと、それは定義だと思う"}, {"type": "subtitle", "time": 16064.389, "timestamp": "04:27:44", "text": "コンテンツクリエイター。私は"}, {"type": "subtitle", "time": 16066.269, "timestamp": "04:27:46", "text": "テクオンと"}, {"type": "subtitle", "time": 16069.51, "timestamp": "04:27:49", "text": "もの。いいえ。つまり、私が言うのはそういうことです。"}, {"type": "subtitle", "time": 16071.83, "timestamp": "04:27:51", "text": "それはまるで自分を他人と比較しないようなものだ"}, {"type": "subtitle", "time": 16074.67, "timestamp": "04:27:54", "text": "他のクリエイターたち。むしろこうだ"}, {"type": "subtitle", "time": 16077.67, "timestamp": "04:27:57", "text": "えっと、たとえ私が5年間ストリーミング配信をしていて"}]
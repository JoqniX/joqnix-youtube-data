[{"type": "subtitle", "time": 4320.87, "timestamp": "01:12:00", "text": "方法。大丈夫です。大丈夫です。大丈夫です。"}, {"type": "subtitle", "time": 4324.87, "timestamp": "01:12:04", "text": "わかった。えっと、なぜなのかはわかりませんが"}, {"type": "subtitle", "time": 4336.07, "timestamp": "01:12:16", "text": "ええと、時々そう見えるんですよね？クラッシュする"}, {"type": "subtitle", "time": 4338.43, "timestamp": "01:12:18", "text": "誰かに新しいメッセージが届くたびに"}, {"type": "subtitle", "time": 4341.43, "timestamp": "01:12:21", "text": "理由。ええ、そうですね。ヤマ、もしあなたがまだ"}, {"type": "subtitle", "time": 4343.75, "timestamp": "01:12:23", "text": "そこで、こんにちはのようなことを入力できますか？"}, {"type": "subtitle", "time": 4347.43, "timestamp": "01:12:27", "text": "それとも何か別のこと？ほんの少しだけ"}, {"type": "subtitle", "time": 4350.99, "timestamp": "01:12:30", "text": "修正するまで2行か何か"}, {"type": "subtitle", "time": 4355.59, "timestamp": "01:12:35", "text": "これ。はい、こんにちはと表示されて、クラッシュします。"}, {"type": "subtitle", "time": 4359.669, "timestamp": "01:12:39", "text": "いいえ、手動で編集する必要があります"}, {"type": "subtitle", "time": 4363.669, "timestamp": "01:12:43", "text": "ファイル。ああ、神様。こんにちは。こんにちは。そうします。"}, {"type": "subtitle", "time": 4369.59, "timestamp": "01:12:49", "text": "えーと、しばらくぶりに"}, {"type": "subtitle", "time": 4374.47, "timestamp": "01:12:54", "text": "ストリーミング配信されたので、良いと思った"}, {"type": "subtitle", "time": 4375.63, "timestamp": "01:12:55", "text": "一瞬"}, {"type": "subtitle", "time": 4377.79, "timestamp": "01:12:57", "text": "何に対して"}]
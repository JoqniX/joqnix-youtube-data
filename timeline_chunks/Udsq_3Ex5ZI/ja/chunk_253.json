[{"type": "subtitle", "time": 15180.87, "timestamp": "04:13:00", "text": "例えばミシックの場合？えっと、それでは"}, {"type": "subtitle", "time": 15183.269, "timestamp": "04:13:03", "text": "現実。えっと、私は作ろうと思ってたんだけど"}, {"type": "subtitle", "time": 15184.87, "timestamp": "04:13:04", "text": "この動画はともかく。先に進みましょう"}, {"type": "subtitle", "time": 15186.469, "timestamp": "04:13:06", "text": "今すぐやってください。先に進む必要がある"}, {"type": "subtitle", "time": 15188.07, "timestamp": "04:13:08", "text": "そして幕を剥がす。私は"}, {"type": "subtitle", "time": 15189.429, "timestamp": "04:13:09", "text": "皆さんもご存知の通り、これはクリックベイトではありません。"}, {"type": "subtitle", "time": 15192.95, "timestamp": "04:13:12", "text": "ビデオ。えーと、このYouTuberの多くが"}, {"type": "subtitle", "time": 15194.309, "timestamp": "04:13:14", "text": "この時点から、ああ神様、私は"}, {"type": "subtitle", "time": 15196.149, "timestamp": "04:13:16", "text": "掲載済み。すみません、この毛皮フィルターがかかっていました"}, {"type": "subtitle", "time": 15197.429, "timestamp": "04:13:17", "text": "私のチャットでみんながこう言ってる"}, {"type": "subtitle", "time": 15198.71, "timestamp": "04:13:18", "text": "猫たち、そして私はこう話し始めました"}, {"type": "subtitle", "time": 15200.87, "timestamp": "04:13:20", "text": "クソ猫だ。えーと、YouTubeをたくさん見てる"}, {"type": "subtitle", "time": 15202.469, "timestamp": "04:13:22", "text": "クリエイターたちは多くのものを失い始めるだろう"}, {"type": "subtitle", "time": 15206.229, "timestamp": "04:13:26", "text": "お金の。あなたは。あなたは。そして"}, {"type": "subtitle", "time": 15209.51, "timestamp": "04:13:29", "text": "その理由は、新しい"}, {"type": "subtitle", "time": 15211.429, "timestamp": "04:13:31", "text": "スポンサーで開発が行われた"}, {"type": "subtitle", "time": 15214.71, "timestamp": "04:13:34", "text": "文化。私たちは黄金時代を迎えていたのです"}, {"type": "subtitle", "time": 15218.389, "timestamp": "04:13:38", "text": "co co はインターネットの場所"}, {"type": "subtitle", "time": 15221.71, "timestamp": "04:13:41", "text": "インターネットのユーザーベースは増加しました"}, {"type": "subtitle", "time": 15224.389, "timestamp": "04:13:44", "text": "417%。ちなみに、それは実在する数字です。"}, {"type": "subtitle", "time": 15226.63, "timestamp": "04:13:46",
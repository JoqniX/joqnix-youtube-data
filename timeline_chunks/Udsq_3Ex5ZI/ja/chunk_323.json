[{"type": "subtitle", "time": 19383.75, "timestamp": "05:23:03", "text": "えっと、どうすればこれを直せるんですか？ああ神様、"}, {"type": "subtitle", "time": 19389.868, "timestamp": "05:23:09", "text": "上。皆さん、お元気ですか？"}, {"type": "subtitle", "time": 19392.948, "timestamp": "05:23:12", "text": "えっと、ちょっと待ってください。 5時半から配信します"}, {"type": "subtitle", "time": 19396.868, "timestamp": "05:23:16", "text": "午後ああ、午後5時30分。うん、行くよ。"}, {"type": "subtitle", "time": 19398.91, "timestamp": "05:23:18", "text": "今日は暇だと思う。"}, {"type": "subtitle", "time": 19402.15, "timestamp": "05:23:22", "text": "まあ、そんな感じですね。まだ直してないんだけど"}, {"type": "subtitle", "time": 19405.31, "timestamp": "05:23:25", "text": "意味は他の"}, {"type": "subtitle", "time": 19408.708, "timestamp": "05:23:28", "text": "情報源。私はこの新しいものを試しています"}, {"type": "subtitle", "time": 19410.99, "timestamp": "05:23:30", "text": "方法"}, {"type": "subtitle", "time": 19413.59, "timestamp": "05:23:33", "text": "ストリーミングだけど、それでもまだ、えーと、"}, {"type": "subtitle", "time": 19417.27, "timestamp": "05:23:37", "text": "まだ終わっていません。"}, {"type": "subtitle", "time": 19422.11, "timestamp": "05:23:42", "text": "それで、私が作ったものは"}]
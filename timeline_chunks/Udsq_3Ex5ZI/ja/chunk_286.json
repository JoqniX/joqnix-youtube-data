[{"type": "subtitle", "time": 17162.628, "timestamp": "04:46:02", "text": "テクトン テクトンはストリーマーで、彼は天才です"}, {"type": "subtitle", "time": 17166.948, "timestamp": "04:46:06", "text": "ストリーマー、いいえ、私はこれが好きです、今は残念です"}, {"type": "subtitle", "time": 17169.99, "timestamp": "04:46:09", "text": "そうだけど、私がそう考えるとき"}, {"type": "subtitle", "time": 17172.708, "timestamp": "04:46:12", "text": "普通のクリエイターとしてのコンセプト"}, {"type": "subtitle", "time": 17175.15, "timestamp": "04:46:15", "text": "コンテンツクリエイターのコンセプトをビデオ化"}, {"type": "subtitle", "time": 17177.91, "timestamp": "04:46:17", "text": "従来のビデオ撮影の感覚は"}, {"type": "subtitle", "time": 17180.868, "timestamp": "04:46:20", "text": "専用ビデオをアップロードするのと同じように"}, {"type": "subtitle", "time": 17184.35, "timestamp": "04:46:24", "text": "コンテンツカバー音楽曲カバー音楽"}, {"type": "subtitle", "time": 17187.31, "timestamp": "04:46:27", "text": "ビデオとか、そういう類のもの全部"}, {"type": "subtitle", "time": 17191.35, "timestamp": "04:46:31", "text": "右？つまり、私には自由がある"}, {"type": "subtitle", "time": 17194.23, "timestamp": "04:46:34", "text": "私が望むものなら何でも。だから、時々私はこう思うんです。"}, {"type": "subtitle", "time": 17196.628, "timestamp": "04:46:36", "text": "いいえ、私は伝統的な側面を見ています"}, {"type": "subtitle", "time": 17198.948, "timestamp": "04:46:38", "text": "物事を追跡しているときまたは"}, {"type": "subtitle", "time": 17201.27, "timestamp": "04:46:41", "text": "他のクリエイターを参考にすると、私はこう思う。"}, {"type": "subtitle", "time": 17204.15, "timestamp": "04:46:44", "text": "「ああ、彼らはこんなことはしない。彼らは"}, {"type": "subtitle", "time": 17206.07, "timestamp": "04:46:46", "text": "こうすれば、私もこうするべきだ"}, {"type": "subtitle", "time": 17210.07, "timestamp": "04:46:50", "text": "「フォーマットか何か」私自身が"}, {"type": "subtitle", "time": 17212.868, "timestamp": "04:46:52", "text": "その形式を破る力、または"}, {"type": "subtitle", "time": 17215.03, "timestamp": "04:46:55", "text": "そのフォーマットを再構築するか、新しいフォーマットを作成する"}]
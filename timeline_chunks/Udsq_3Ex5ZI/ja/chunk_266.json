[{"type": "subtitle", "time": 15961.389, "timestamp": "04:26:01", "text": "これらのビデオは"}, {"type": "subtitle", "time": 15965.59, "timestamp": "04:26:05", "text": "彼って、まるで、まるで"}, {"type": "subtitle", "time": 15969.149, "timestamp": "04:26:09", "text": "それは彼の"}, {"type": "subtitle", "time": 15972.429, "timestamp": "04:26:12", "text": "文字通り彼のストリームから"}, {"type": "subtitle", "time": 15975.99, "timestamp": "04:26:15", "text": "ストリーム。じゃあ、彼の編集者は"}, {"type": "subtitle", "time": 15982.03, "timestamp": "04:26:22", "text": "アウトロは？聞いてもいいですか？ いいですよ、ただ"}, {"type": "subtitle", "time": 15986.55, "timestamp": "04:26:26", "text": "えっと、アウトロは入るのかな？私は思う"}, {"type": "subtitle", "time": 15989.269, "timestamp": "04:26:29", "text": "彼らはもうアウトロを入れない。私はそうするだろう"}, {"type": "subtitle", "time": 15991.99, "timestamp": "04:26:31", "text": "もちろんそうします。それは待って、待って、"}, {"type": "subtitle", "time": 15994.389, "timestamp": "04:26:34", "text": "待って、待って。彼、彼らは基本的な編集を見る"}, {"type": "subtitle", "time": 15996.189, "timestamp": "04:26:36", "text": "もの"}, {"type": "subtitle", "time": 15999.469, "timestamp": "04:26:39", "text": "ここ。基本的な編集がいくつか見られます"}, {"type": "subtitle", "time": 16003.309, "timestamp": "04:26:43", "text": "もの。くそ。"}, {"type": "subtitle", "time": 16007.149, "timestamp": "04:26:47", "text": "はい、基本的な編集があります。"}]
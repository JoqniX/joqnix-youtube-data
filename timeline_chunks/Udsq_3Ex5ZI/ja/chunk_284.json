[{"type": "subtitle", "time": 17041.39, "timestamp": "04:44:01", "text": "私にとっては十分すぎる量です。目"}, {"type": "subtitle", "time": 17046.788, "timestamp": "04:44:06", "text": "バカ。なぜもうあなたなの？何だって？"}, {"type": "subtitle", "time": 17055.27, "timestamp": "04:44:15", "text": "非常識な。この段階では、"}, {"type": "subtitle", "time": 17057.99, "timestamp": "04:44:17", "text": "そうすればするほど、もっとやりたくなる"}, {"type": "subtitle", "time": 17061.47, "timestamp": "04:44:21", "text": "私もそう思います。自分のアルバムを作ろう"}, {"type": "subtitle", "time": 17063.91, "timestamp": "04:44:23", "text": "日。いつになったら"}, {"type": "subtitle", "time": 17070.39, "timestamp": "04:44:30", "text": "うん、今は色々なことで苦労してる"}, {"type": "subtitle", "time": 17073.27, "timestamp": "04:44:33", "text": "今すぐ。たくさんのことを同時にこなしている。"}, {"type": "subtitle", "time": 17075.31, "timestamp": "04:44:35", "text": "うん。"}, {"type": "subtitle", "time": 17079.19, "timestamp": "04:44:39", "text": "でも、でも、正直に言うと、"}, {"type": "subtitle", "time": 17081.11, "timestamp": "04:44:41", "text": "話すと、私はただ自分の"}, {"type": "subtitle", "time": 17083.75, "timestamp": "04:44:43", "text": "ビリー・ビリー、YouTube、そして"}, {"type": "subtitle", "time": 17086.948, "timestamp": "04:44:46", "text": "トゥイッチ。それ以上でもそれ以下でもない。すでに"}, {"type": "subtitle", "time": 17089.59, "timestamp": "04:44:49", "text": "YouTubeとTwitchでいろいろと問題が起きています"}, {"type": "subtitle", "time": 17092.31, "timestamp": "04:44:52", "text": "でも、ウィリー・ウィリーはただ横にいるだけ"}, {"type": "subtitle", "time": 17093.628, "timestamp": "04:44:53", "text": "しかし"}]
[{"type": "subtitle", "time": 17463.91, "timestamp": "04:51:03", "text": "ゲームは何本持っていますか？わからない。 A"}, {"type": "subtitle", "time": 17467.51, "timestamp": "04:51:07", "text": "多く。数試合。問題は私が"}, {"type": "subtitle", "time": 17471.19, "timestamp": "04:51:11", "text": "原神スターレールとブーヴァがあります"}, {"type": "subtitle", "time": 17473.59, "timestamp": "04:51:13", "text": "インストール済み。私はそれらをプレイしません。私は"}, {"type": "subtitle", "time": 17476.39, "timestamp": "04:51:16", "text": "明日はMoubaをプレイしますが、Genshin Star"}, {"type": "subtitle", "time": 17478.39, "timestamp": "04:51:18", "text": "レール なぜ持っているのか自分でもわからない"}, {"type": "subtitle", "time": 17480.39, "timestamp": "04:51:20", "text": "そこにインストールされています。"}, {"type": "subtitle", "time": 17481.39, "timestamp": "04:51:21", "text": "私は"}, {"type": "subtitle", "time": 17483.788, "timestamp": "04:51:23", "text": "まるで私は"}, {"type": "subtitle", "time": 17487.35, "timestamp": "04:51:27", "text": "アンインストールしようと思っているのですが、"}, {"type": "subtitle", "time": 17491.51, "timestamp": "04:51:31", "text": "新しい記念日のように、それらすべて"}, {"type": "subtitle", "time": 17493.59, "timestamp": "04:51:33", "text": "物事が起こり、出来事が起こり、今私は"}]
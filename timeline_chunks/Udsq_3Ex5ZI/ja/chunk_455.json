[{"type": "subtitle", "time": 27301.948, "timestamp": "07:35:01", "text": "BTRCを入れる前に。ええ、これは"}, {"type": "subtitle", "time": 27305.83, "timestamp": "07:35:05", "text": "あれ。私はそれを着るつもりです。"}, {"type": "subtitle", "time": 27307.468, "timestamp": "07:35:07", "text": "それを着る"}, {"type": "subtitle", "time": 27311.03, "timestamp": "07:35:11", "text": "説明 なぜなら私がこれをするたびに、ああ、"}, {"type": "subtitle", "time": 27313.91, "timestamp": "07:35:13", "text": "待って。ナイトボード・チャマ。彼はそこにいる。こんにちは。"}, {"type": "subtitle", "time": 27316.07, "timestamp": "07:35:16", "text": "それは良いことだ。それを見るのは良いことだ"}, {"type": "subtitle", "time": 27318.948, "timestamp": "07:35:18", "text": "あなたはまだここにいる。ナイトボード・チャマ。"}, {"type": "subtitle", "time": 27320.708, "timestamp": "07:35:20", "text": "うん。このコマンドを実行するたびに、"}, {"type": "subtitle", "time": 27323.11, "timestamp": "07:35:23", "text": "誰かがこのコマンドを実行すると、"}, {"type": "subtitle", "time": 27325.51, "timestamp": "07:35:25", "text": "夜はナイトボードが"}, {"type": "subtitle", "time": 27329.03, "timestamp": "07:35:29", "text": "感嘆符のコマンドがまさにそこにあります"}, {"type": "subtitle", "time": 27331.91, "timestamp": "07:35:31", "text": "そのため、それがその現象を引き起こす"}, {"type": "subtitle", "time": 27335.11, "timestamp": "07:35:35", "text": "そしてそれは続くが、幸い私はそうしなかった"}, {"type": "subtitle", "time": 27336.75, "timestamp": "07:35:36", "text": "まだ追加していません。"}, {"type": "subtitle", "time": 27340.59, "timestamp": "07:35:40", "text": "でも大丈夫、ちゃんと動くはずだ"}, {"type": "subtitle", "time": 27342.788, "timestamp": "07:35:42", "text": "今。ええ、正常に動作するはずです"}, {"type": "subtitle", "time": 27343.948, "timestamp": "07:35:43", "text": "今私は"}, {"type": "subtitle", "time": 27347.75, "timestamp": "07:35:47", "text": "信じる。うまくいくはずです。私にさせて"}, {"type": "subtitle", "time": 27351.07, "timestamp": "07:35:51", "text": "虹で確認してみてください。来る"}, {"type": "subtitle", "time": 27354.31, "timestamp": "07:35:54", "text": "の上。私は大丈夫です。あなたが"}]
[{"type": "subtitle", "time": 27000.51, "timestamp": "07:30:00", "text": "Y こんにちは Y こんにちは"}, {"type": "subtitle", "time": 27003.468, "timestamp": "07:30:03", "text": "みなさんこんにちは"}, {"type": "subtitle", "time": 27010.91, "timestamp": "07:30:10", "text": "みんな元気？"}, {"type": "subtitle", "time": 27013.628, "timestamp": "07:30:13", "text": "行う"}, {"type": "subtitle", "time": 27019.948, "timestamp": "07:30:19", "text": "うん、そうだね"}, {"type": "subtitle", "time": 27023.23, "timestamp": "07:30:23", "text": "こんにちは、お元気ですか？"}, {"type": "subtitle", "time": 27026.948, "timestamp": "07:30:26", "text": "大丈夫ですか？調子はどうですか？"}, {"type": "subtitle", "time": 27028.75, "timestamp": "07:30:28", "text": "行う"}, {"type": "subtitle", "time": 27036.31, "timestamp": "07:30:36", "text": "ここ。えっと、音に気付いたんだけど"}, {"type": "subtitle", "time": 27040.15, "timestamp": "07:30:40", "text": "このシーンの音楽は"}, {"type": "subtitle", "time": 27043.388, "timestamp": "07:30:43", "text": "ちょっとうるさい。"}, {"type": "subtitle", "time": 27050.99, "timestamp": "07:30:50", "text": "えっと、もう少し下げた方がいいかな。"}, {"type": "subtitle", "time": 27053.07, "timestamp": "07:30:53", "text": "右？何"}, {"type": "subtitle", "time": 27056.548, "timestamp": "07:30:56", "text": "そうなんですか？重複していないことを願います"}, {"type": "subtitle", "time": 27059.11, "timestamp": "07:30:59", "text": "私の声。そうであることを確認する必要がある"}]
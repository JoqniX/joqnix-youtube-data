[{"type": "subtitle", "time": 17280.27, "timestamp": "04:48:00", "text": "これらのビデオだけを撮影します"}, {"type": "subtitle", "time": 17283.43, "timestamp": "04:48:03", "text": "こういう専用の配信ってことですよね？"}, {"type": "subtitle", "time": 17286.23, "timestamp": "04:48:06", "text": "再生リストに登録された専用ストリーム。私はできません"}, {"type": "subtitle", "time": 17290.11, "timestamp": "04:48:10", "text": "ここから出ている道路沿いのどれでも選んでください。"}, {"type": "subtitle", "time": 17300.83, "timestamp": "04:48:20", "text": "できません。こんにちは、ヴィック。行くよ"}, {"type": "subtitle", "time": 17302.91, "timestamp": "04:48:22", "text": "中。それが"}, {"type": "subtitle", "time": 17306.628, "timestamp": "04:48:26", "text": "もの。そうですね、コンテンツ制作ですね。手に入れた"}, {"type": "subtitle", "time": 17309.39, "timestamp": "04:48:29", "text": "全力を尽くす。こんにちは、"}, {"type": "subtitle", "time": 17313.03, "timestamp": "04:48:33", "text": "V. ご存知のとおり、私はどういうわけか"}, {"type": "subtitle", "time": 17317.91, "timestamp": "04:48:37", "text": "ダイバーズをダウンロードしてください。 25GB中21.6GB使用済み"}, {"type": "subtitle", "time": 17322.15, "timestamp": "04:48:42", "text": "GB。しかし、この正しいエラーは、私には"}, {"type": "subtitle", "time": 17323.868, "timestamp": "04:48:43", "text": "空間。私は"}, {"type": "subtitle", "time": 17328.07, "timestamp": "04:48:48", "text": "もがく。置くスペースがありません"}, {"type": "subtitle", "time": 17331.11, "timestamp": "04:48:51", "text": "地獄のダイバーを投入する。ストリーミング配信します"}, {"type": "subtitle", "time": 17335.47, "timestamp": "04:48:55", "text": "土曜日はあなたと一緒に、その後は"}, {"type": "subtitle", "time": 17338.11, "timestamp": "04:48:58", "text": "アンインストールしています。私は持っていません"}]
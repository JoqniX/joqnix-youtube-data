[{"type": "subtitle", "time": 17669.948, "timestamp": "04:54:29", "text": "動画を作成する"}, {"type": "subtitle", "time": 17672.47, "timestamp": "04:54:32", "text": "ストリーム。あのね？その間のように"}, {"type": "subtitle", "time": 17674.47, "timestamp": "04:54:34", "text": "ジョーカー、あのね？試してみます"}, {"type": "subtitle", "time": 17676.27, "timestamp": "04:54:36", "text": "動画を作成する"}, {"type": "subtitle", "time": 17679.67, "timestamp": "04:54:39", "text": "ストリーム。実験してみたいんです、皆さん。私"}, {"type": "subtitle", "time": 17682.39, "timestamp": "04:54:42", "text": "自分がどこまで行けるか試してみたい。私"}, {"type": "subtitle", "time": 17684.55, "timestamp": "04:54:44", "text": "自分の限界に挑戦してみたい。"}, {"type": "subtitle", "time": 17687.11, "timestamp": "04:54:47", "text": "このジョッカソンは、"}, {"type": "subtitle", "time": 17689.11, "timestamp": "04:54:49", "text": "私はただ時間を無駄にして、"}, {"type": "subtitle", "time": 17691.67, "timestamp": "04:54:51", "text": "私が望むものなら何でも。それは私が"}, {"type": "subtitle", "time": 17694.55, "timestamp": "04:54:54", "text": "新たな一歩を踏み出すための新たな取り組みと"}, {"type": "subtitle", "time": 17697.99, "timestamp": "04:54:57", "text": "怠惰の古いサイクルを断ち切る"}]
[{"type": "subtitle", "time": 6002.07, "timestamp": "01:40:02", "text": "[音楽]"}, {"type": "subtitle", "time": 6011.83, "timestamp": "01:40:11", "text": "良い。リストに追加すべきだ"}, {"type": "subtitle", "time": 6013.39, "timestamp": "01:40:13", "text": "1つ学ぶ"}, {"type": "subtitle", "time": 6036.43, "timestamp": "01:40:36", "text": "わかった。えーと、ジャンプスケアツリー"}, {"type": "subtitle", "time": 6038.95, "timestamp": "01:40:38", "text": "アニメーション。よし、このクリップを入手しよう。"}, {"type": "subtitle", "time": 6040.91, "timestamp": "01:40:40", "text": "右？もし私が"}, {"type": "subtitle", "time": 6055.39, "timestamp": "01:40:55", "text": "これ？そうだった"}, {"type": "subtitle", "time": 6059.47, "timestamp": "01:40:59", "text": "大きなOK。わかった。私"}]
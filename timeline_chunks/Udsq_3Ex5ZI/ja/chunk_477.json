[{"type": "subtitle", "time": 28620.03, "timestamp": "07:57:00", "text": "予想外"}, {"type": "subtitle", "time": 28622.468, "timestamp": "07:57:02", "text": "旅。予測はできない。たとえ"}, {"type": "subtitle", "time": 28624.868, "timestamp": "07:57:04", "text": "あなたが予測しても、あなたの思い通りにはならない"}, {"type": "subtitle", "time": 28641.11, "timestamp": "07:57:21", "text": "[音楽]"}, {"type": "subtitle", "time": 28663.868, "timestamp": "07:57:43", "text": "ここ。"}, {"type": "subtitle", "time": 28667.7, "timestamp": "07:57:47", "text": "わかった。ああ、誕生日パーティーをやっているんだね。"}]
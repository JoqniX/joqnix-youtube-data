[{"type": "subtitle", "time": 14401.83, "timestamp": "04:00:01", "text": "なぜ？なぜ道に迷ったのですか？どこに保管すればいいですか"}, {"type": "subtitle", "time": 14406.04, "timestamp": "04:00:06", "text": "どこに保管すればいいですか 追跡？"}, {"type": "subtitle", "time": 14408.359, "timestamp": "04:00:08", "text": "追跡？ えっと、E用です"}, {"type": "subtitle", "time": 14419.189, "timestamp": "04:00:19", "text": "ラダム。どうやら彼らは"}, {"type": "subtitle", "time": 14422.71, "timestamp": "04:00:22", "text": "多くのユーチューバーを受け入れ"}, {"type": "subtitle", "time": 14424.03, "timestamp": "04:00:24", "text": "クリエイタークラブ"}, {"type": "subtitle", "time": 14431.07, "timestamp": "04:00:31", "text": "私はまだ自分が"}, {"type": "subtitle", "time": 14449.309, "timestamp": "04:00:49", "text": "ない。私はソラキシスか"}, {"type": "subtitle", "time": 14452.309, "timestamp": "04:00:52", "text": "ない。ああ、クインにメッセージを送らなきゃ"}, {"type": "subtitle", "time": 14455.03, "timestamp": "04:00:55", "text": "息子ですよね？"}, {"type": "subtitle", "time": 14458.99, "timestamp": "04:00:58", "text": "私は彼女にコラボレーションを依頼しました"}]
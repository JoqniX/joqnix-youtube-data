[{"type": "subtitle", "time": 15302.55, "timestamp": "04:15:02", "text": "どのように給料を受け取りますか？視聴者1人あたり1ドル"}, {"type": "subtitle", "time": 15304.87, "timestamp": "04:15:04", "text": "時給。それが真実だ。それは"}, {"type": "subtitle", "time": 15307.59, "timestamp": "04:15:07", "text": "平均してその数。それはどこかにあるかもしれない"}, {"type": "subtitle", "time": 15309.07, "timestamp": "04:15:09", "text": "0.85の間"}, {"type": "subtitle", "time": 15313.51, "timestamp": "04:15:13", "text": "時給85～115ドル。通常は1ドルです"}, {"type": "subtitle", "time": 15315.99, "timestamp": "04:15:15", "text": "1時間あたりの視聴者数。その数字、分かりますか？"}, {"type": "subtitle", "time": 15318.469, "timestamp": "04:15:18", "text": "では、ここへ行ってチェックしてください"}, {"type": "subtitle", "time": 15321.269, "timestamp": "04:15:21", "text": "過去28日間。すべてのクリエイターは"}, {"type": "subtitle", "time": 15322.87, "timestamp": "04:15:22", "text": "いつでも広告会社に行く"}, {"type": "subtitle", "time": 15324.309, "timestamp": "04:15:24", "text": "彼らは素晴らしい月を過ごして、彼らにこう伝えます。"}, {"type": "subtitle", "time": 15327.51, "timestamp": "04:15:27", "text": "「過去28日間を活用してください。」だから、私の過去28"}, {"type": "subtitle", "time": 15331.11, "timestamp": "04:15:31", "text": "日数は6,36日のように見えます"}, {"type": "subtitle", "time": 15333.269, "timestamp": "04:15:33", "text": "ええと、視聴者。つまり、もし私が"}, {"type": "subtitle", "time": 15335.189, "timestamp": "04:15:35", "text": "2時間広告を出せば報酬がもらえる"}, {"type": "subtitle", "time": 15340.309, "timestamp": "04:15:40", "text": "2時間のスポンサーとして、"}, {"type": "subtitle", "time": 15343.83, "timestamp": "04:15:43", "text": "素晴らしい。さて、ここで補足事項です。私も"}, {"type": "subtitle", "time": 15345.91, "timestamp": "04:15:45", "text": "同時にYouTubeでも配信する。今、"}, {"type": "subtitle", "time": 15347.67, "timestamp": "04:15:47", "text": "YouTubeライブがなぜ"}, {"type": "subtitle", "time": 15349.349, "timestamp": "04:15:49", "text": "ストリームとTwitchライブストリームは報酬を得る"}, {"type": "subtitle", "time": 15350.79, "timestamp": "04:15:50", "text": "異なる方法で、特に"}, {"type": "subtitle", "time": 15353.59, "timestamp": "04:15:53", "text": "それをマルチリームします。 Twitchの場合、"}, {"type": "subtitle", "time": 15355.349, "timestamp": "04:15:55", "text": "カテゴリーと呼ばれるもの、そして私は"}]
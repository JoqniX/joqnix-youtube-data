[{"type": "subtitle", "time": 27721.948, "timestamp": "07:42:01", "text": "公式の公的な"}, {"type": "subtitle", "time": 27725.51, "timestamp": "07:42:05", "text": "発表には2つのアカウントがあります。 AR55 1丁"}, {"type": "subtitle", "time": 27727.31, "timestamp": "07:42:07", "text": "そして1つ"}, {"type": "subtitle", "time": 27732.23, "timestamp": "07:42:12", "text": "AR56 46 待ち。おお、いいね。待って、２"}, {"type": "subtitle", "time": 27734.628, "timestamp": "07:42:14", "text": "2つの別々の口座、1つの口座"}, {"type": "subtitle", "time": 27745.23, "timestamp": "07:42:25", "text": "どうやって記録するの？"}, {"type": "subtitle", "time": 27754.83, "timestamp": "07:42:34", "text": "[音楽]"}, {"type": "subtitle", "time": 27757.27, "timestamp": "07:42:37", "text": "難しい？それはとても便利です。"}, {"type": "subtitle", "time": 27759.43, "timestamp": "07:42:39", "text": "右？ 1つだけログインすればいい"}, {"type": "subtitle", "time": 27764.11, "timestamp": "07:42:44", "text": "アカウント。私としては、45年を支持します。"}, {"type": "subtitle", "time": 27769.19, "timestamp": "07:42:49", "text": "ギャング。それ以来レベルアップしていません"}, {"type": "subtitle", "time": 27774.11, "timestamp": "07:42:54", "text": "ええと、1、2年前から。"}, {"type": "subtitle", "time": 27778.07, "timestamp": "07:42:58", "text": "はい。いいえ。源氏が来たのは2年前です。うん。"}]
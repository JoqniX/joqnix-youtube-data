[{"type": "subtitle", "time": 23522.75, "timestamp": "06:32:02", "text": "怖がった。何？ナニが"}, {"type": "subtitle", "time": 23525.83, "timestamp": "06:32:05", "text": "それがそこにあるとき"}, {"type": "subtitle", "time": 23528.708, "timestamp": "06:32:08", "text": "YouTubeはライブ配信を開始しました"}, {"type": "subtitle", "time": 23533.23, "timestamp": "06:32:13", "text": "ストリームは配信されていませんでしたが、"}, {"type": "subtitle", "time": 23535.99, "timestamp": "06:32:15", "text": "みんなの一日がどんな感じか、そして幸せかどうかを知る"}, {"type": "subtitle", "time": 23536.99, "timestamp": "06:32:16", "text": "誕生日"}, {"type": "subtitle", "time": 23540.31, "timestamp": "06:32:20", "text": "ズキ、寝てしまって本当にごめんなさい。"}, {"type": "subtitle", "time": 23553.948, "timestamp": "06:32:33", "text": "なんでこんなに眠いんだろう？なぜなら私は"}, {"type": "subtitle", "time": 23558.23, "timestamp": "06:32:38", "text": "えっと、この暑いところに座って、何を手に入れようか"}, {"type": "subtitle", "time": 23560.75, "timestamp": "06:32:40", "text": "熱って呼ぶの？"}, {"type": "subtitle", "time": 23563.51, "timestamp": "06:32:43", "text": "恐喝？熱中症。それは何？"}, {"type": "subtitle", "time": 23565.548, "timestamp": "06:32:45", "text": "電話した？何と呼ぶか"}, {"type": "subtitle", "time": 23568.43, "timestamp": "06:32:48", "text": "それ？あれは何て言うんだ？私"}, {"type": "subtitle", "time": 23573.15, "timestamp": "06:32:53", "text": "そのことを忘れていた。私はそれを持っていた"}, {"type": "subtitle", "time": 23575.59, "timestamp": "06:32:55", "text": "もの。黙れ。睡眠は"}, {"type": "subtitle", "time": 23579.27, "timestamp": "06:32:59", "text": "どこにもない。ええ、ズキは1Kになりました。"}]
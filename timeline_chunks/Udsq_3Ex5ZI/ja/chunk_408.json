[{"type": "subtitle", "time": 24482.788, "timestamp": "06:48:02", "text": "ああ、まさにその通りだ。あなたが知っている、"}, {"type": "subtitle", "time": 24483.708, "timestamp": "06:48:03", "text": "それが"}, {"type": "subtitle", "time": 24487.03, "timestamp": "06:48:07", "text": "起こった。うん。あと、えっと、教えてください"}, {"type": "subtitle", "time": 24490.15, "timestamp": "06:48:10", "text": "時々、私の声が聞こえないことがあります。あなたが知っている、"}, {"type": "subtitle", "time": 24497.67, "timestamp": "06:48:17", "text": "強いなら、私は持っていない。私は弱い少年だ。"}, {"type": "subtitle", "time": 24500.07, "timestamp": "06:48:20", "text": "私はとても痩せていて、弱っている。"}, {"type": "subtitle", "time": 24503.75, "timestamp": "06:48:23", "text": "誰かが償うまで私は運動しません"}, {"type": "subtitle", "time": 24506.23, "timestamp": "06:48:26", "text": "Twitchで配信中。 YouTubeに追加しないといけない"}, {"type": "subtitle", "time": 24509.07, "timestamp": "06:48:29", "text": "運動する"}, {"type": "subtitle", "time": 24522.83, "timestamp": "06:48:42", "text": "また。私は"}, {"type": "subtitle", "time": 24526.67, "timestamp": "06:48:46", "text": "えっと、Streamlabs ではありません"}, {"type": "subtitle", "time": 24530.15, "timestamp": "06:48:50", "text": "YouTube。私は使う予定でした"}, {"type": "subtitle", "time": 24532.468, "timestamp": "06:48:52", "text": "YouTube 用のストリーム要素を使用しています"}, {"type": "subtitle", "time": 24535.19, "timestamp": "06:48:55", "text": "Twitchのストリーム要素、"}]
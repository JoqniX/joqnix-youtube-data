[{"type": "subtitle", "time": 15363.03, "timestamp": "04:16:03", "text": "超形成的な。"}, {"type": "subtitle", "time": 15365.59, "timestamp": "04:16:05", "text": "今日の配信に参加してよかった。わかった。"}, {"type": "subtitle", "time": 15367.429, "timestamp": "04:16:07", "text": "テクノロジーについて。そして企業が"}, {"type": "subtitle", "time": 15369.51, "timestamp": "04:16:09", "text": "本当に推進したいのは、より多くの人々が"}, {"type": "subtitle", "time": 15371.429, "timestamp": "04:16:11", "text": "これらのカテゴリーのストリーム、"}, {"type": "subtitle", "time": 15373.349, "timestamp": "04:16:13", "text": "さらに、それは"}, {"type": "subtitle", "time": 15375.67, "timestamp": "04:16:15", "text": "おすすめリストのトップ。そしてこれがその理由です"}, {"type": "subtitle", "time": 15377.349, "timestamp": "04:16:17", "text": "Twitchの配信は非常に一般的で、"}, {"type": "subtitle", "time": 15378.79, "timestamp": "04:16:18", "text": "スポンサー付きおよび YouTube ストリームは"}, {"type": "subtitle", "time": 15381.99, "timestamp": "04:16:21", "text": "スポンサーがつきすぎていて、これらは"}, {"type": "subtitle", "time": 15384.149, "timestamp": "04:16:24", "text": "いわゆるカテゴリー推進者と呼ばれる人々。"}, {"type": "subtitle", "time": 15386.229, "timestamp": "04:16:26", "text": "新しいゲームが出るたびに、エマも"}, {"type": "subtitle", "time": 15387.83, "timestamp": "04:16:27", "text": "フロストはここではめちゃくちゃカッコいい。えっと、"}, {"type": "subtitle", "time": 15389.67, "timestamp": "04:16:29", "text": "新しいゲームが出ると、多くの人が"}, {"type": "subtitle", "time": 15390.87, "timestamp": "04:16:30", "text": "人々はスポンサーを欲しがるだろう"}, {"type": "subtitle", "time": 15392.71, "timestamp": "04:16:32", "text": "Twitchでプッシュする"}, {"type": "subtitle", "time": 15394.309, "timestamp": "04:16:34", "text": "彼らのカテゴリーをトップにすることは、"}, {"type": "subtitle", "time": 15395.51, "timestamp": "04:16:35", "text": "小さな子供にこれを勧めよう"}, {"type": "subtitle", "time": 15396.87, "timestamp": "04:16:36", "text": "フォロワーリストはこちら、ライブ配信"}, {"type": "subtitle", "time": 15399.03, "timestamp": "04:16:39", "text": "チャンネルはこちらです。"}, {"type": "subtitle", "time": 15400.55, "timestamp": "04:16:40", "text": "だから、それが非常に重要な点なのです。今、"}, {"type": "subtitle", "time": 15402.309, "timestamp": "04:16:42", "text": "もし私がYouTubeでストリーミング配信しているなら"}, {"type": "subtitle", "time": 15405.03, "timestamp": "04:16:45", "text": "今すぐ。では、ここで簡単に見てみましょう"}, {"type": "subtitle", "time": 15409.11, "timestamp": "04:16:49", "text": "YouTubeで。新しいビデオを見ました"}, {"type": "subtitle", "time": 15411.269, "timestamp": "04:16:51", "text": "ついさっき発売されたばかりです。 2000人が視聴している。"}, {"type": "subtitle", "time": 15413.83, "timestamp": "04:16:53", "text": "実際には100％待って、あのビデオ"}, {"type": "subtitle", "time": 15415.99, "timestamp": "04:16:55", "text": "彼が録音したものは既に編集済みで"}, {"type": "subtitle", "time": 15418.07, "timestamp": "04:16:58", "text": "既にドロップ済みです。それは正気の沙汰ではない。それで、"}]
[{"type": "subtitle", "time": 19749.43, "timestamp": "05:29:09", "text": "多く。ええ、彼は映画を観ましたよ。ええ、彼は"}, {"type": "subtitle", "time": 19756.67, "timestamp": "05:29:16", "text": "ええ、家族と出かけました"}, {"type": "subtitle", "time": 19760.39, "timestamp": "05:29:20", "text": "昨日。行ったよ、行ったよ"}, {"type": "subtitle", "time": 19763.27, "timestamp": "05:29:23", "text": "ショッピングモールで、そう、私たちは男をさまよわせた。いつ"}, {"type": "subtitle", "time": 19765.75, "timestamp": "05:29:25", "text": "歩いていると、"}, {"type": "subtitle", "time": 19768.83, "timestamp": "05:29:28", "text": "多く。とても疲れる"}, {"type": "subtitle", "time": 19771.788, "timestamp": "05:29:31", "text": "簡単に。内向的な人なので、"}, {"type": "subtitle", "time": 19773.788, "timestamp": "05:29:33", "text": "まあ、普通。しかしそれでも、"}, {"type": "subtitle", "time": 19778.788, "timestamp": "05:29:38", "text": "それでも、私は家に帰った。私"}, {"type": "subtitle", "time": 19782.07, "timestamp": "05:29:42", "text": "かろうじて、つまり、なんとか少しは食べ物を食べることができた。"}, {"type": "subtitle", "time": 19785.51, "timestamp": "05:29:45", "text": "夕食を食べて寝た。"}, {"type": "subtitle", "time": 19788.708, "timestamp": "05:29:48", "text": "少し。それから彼らは目を覚ました、私を起こした"}, {"type": "subtitle", "time": 19791.11, "timestamp": "05:29:51", "text": "何か助けになるものを手に入れて、私は"}, {"type": "subtitle", "time": 19798.628, "timestamp": "05:29:58", "text": "もの。それから目が覚めて、それから、えっと、"}]
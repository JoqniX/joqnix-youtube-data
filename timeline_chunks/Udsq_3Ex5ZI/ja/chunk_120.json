[{"type": "subtitle", "time": 7202.31, "timestamp": "02:00:02", "text": "そして、早めのクリスマス。セットアップが恋しい"}, {"type": "subtitle", "time": 7214.229, "timestamp": "02:00:14", "text": "ADHDは消滅した。でも、覚えてるよ"}, {"type": "subtitle", "time": 7223.43, "timestamp": "02:00:23", "text": "自分。それは聖霊の働きとは似ても似つかない。それ"}, {"type": "subtitle", "time": 7226.95, "timestamp": "02:00:26", "text": "それは実は私なんです。"}, {"type": "subtitle", "time": 7230.589, "timestamp": "02:00:30", "text": "それはとてもそう感じたので、とてもそう感じた"}, {"type": "subtitle", "time": 7235.03, "timestamp": "02:00:35", "text": "なんだか、えっと、なんて言うんだっけ"}, {"type": "subtitle", "time": 7238.149, "timestamp": "02:00:38", "text": "えっと、なんて言うんだっけ、それは"}, {"type": "subtitle", "time": 7240.39, "timestamp": "02:00:40", "text": "それによって私は昇天したような気がした"}, {"type": "subtitle", "time": 7244.47, "timestamp": "02:00:44", "text": "光の筋か何か。"}, {"type": "subtitle", "time": 7248.83, "timestamp": "02:00:48", "text": "ああ、それはAIA（アメリカ建築家協会）のことだ。"}]
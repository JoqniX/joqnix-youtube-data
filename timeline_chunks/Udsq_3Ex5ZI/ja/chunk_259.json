[{"type": "subtitle", "time": 15542.229, "timestamp": "04:19:02", "text": "彼らの動画にはバターが使われている。ミスタービーストは"}, {"type": "subtitle", "time": 15545.189, "timestamp": "04:19:05", "text": "動画1本につき3つの統合を行うことが多い。"}, {"type": "subtitle", "time": 15547.269, "timestamp": "04:19:07", "text": "初めに1つ、終わりに1つ、"}, {"type": "subtitle", "time": 15548.95, "timestamp": "04:19:08", "text": "真ん中に1つ。多くのクリエイター"}, {"type": "subtitle", "time": 15551.269, "timestamp": "04:19:11", "text": "2つでも構わない。最初は、"}, {"type": "subtitle", "time": 15554.309, "timestamp": "04:19:14", "text": "真ん中に1つ。しかし統合は"}, {"type": "subtitle", "time": 15557.11, "timestamp": "04:19:17", "text": "かなり高い金額を支払いますが、私は何も知りませんでした"}, {"type": "subtitle", "time": 15559.11, "timestamp": "04:19:19", "text": "これについて。あなたのビデオが"}, {"type": "subtitle", "time": 15561.349, "timestamp": "04:19:21", "text": "約10万回の再生回数。おそらく"}, {"type": "subtitle", "time": 15563.429, "timestamp": "04:19:23", "text": "2,000ドルから3,000ドルを見込んでください。"}, {"type": "subtitle", "time": 15565.75, "timestamp": "04:19:25", "text": "広告を掲載するだけで"}, {"type": "subtitle", "time": 15568.55, "timestamp": "04:19:28", "text": "簡単に読み飛ばせる。あなたも"}, {"type": "subtitle", "time": 15571.189, "timestamp": "04:19:31", "text": "人々が利用できるアドオンをダウンロードする"}, {"type": "subtitle", "time": 15574.189, "timestamp": "04:19:34", "text": "YouTube をスキップして見る"}, {"type": "subtitle", "time": 15576.91, "timestamp": "04:19:36", "text": "それらの。ここに"}, {"type": "subtitle", "time": 15578.91, "timestamp": "04:19:38", "text": "問題。これら"}, {"type": "subtitle", "time": 15582.229, "timestamp": "04:19:42", "text": "企業って、本当にバカばっかりだ。"}, {"type": "subtitle", "time": 15584.75, "timestamp": "04:19:44", "text": "彼らが捕まえるのに6年かかった"}, {"type": "subtitle", "time": 15587.429, "timestamp": "04:19:47", "text": "だが、企業は"}, {"type": "subtitle", "time": 15589.309, "timestamp": "04:19:49", "text": "自分たちが利用されていることに気づく"}, {"type": "subtitle", "time": 15592.11, "timestamp": "04:19:52", "text": "の。そして今、彼らは"}, {"type": "subtitle", "time": 15595.349, "timestamp": "04:19:55", "text": "連携機能はほとんど役に立たない。"}, {"type": "subtitle", "time": 15598.79, "timestamp": "04:19:58", "text": "ああ、専用のコンバージョン率"}]
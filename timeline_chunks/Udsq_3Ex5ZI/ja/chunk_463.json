[{"type": "subtitle", "time": 27780.91, "timestamp": "07:43:00", "text": "えーと、まず1つ目"}, {"type": "subtitle", "time": 27783.388, "timestamp": "07:43:03", "text": "年と9"}, {"type": "subtitle", "time": 27791.67, "timestamp": "07:43:11", "text": "45. もしそれがタワー・オブ・ファンタジーだったら、"}, {"type": "subtitle", "time": 27794.628, "timestamp": "07:43:14", "text": "今頃泣いてるだろうな、だって"}, {"type": "subtitle", "time": 27797.548, "timestamp": "07:43:17", "text": "原神はどのように頂点に達するのか。たとえあなたが"}, {"type": "subtitle", "time": 27799.548, "timestamp": "07:43:19", "text": "キャップ付き、硬い"}, {"type": "subtitle", "time": 27803.15, "timestamp": "07:43:23", "text": "キャップすると、XP を獲得できます。"}, {"type": "subtitle", "time": 27807.388, "timestamp": "07:43:27", "text": "最高レベルに到達するとか、"}, {"type": "subtitle", "time": 27811.35, "timestamp": "07:43:31", "text": "右？しかしタワーオブファンタジーと"}, {"type": "subtitle", "time": 27815.99, "timestamp": "07:43:35", "text": "そういうもの、それはあなたのプログラムのXPを保持しません。"}, {"type": "subtitle", "time": 27818.708, "timestamp": "07:43:38", "text": "さらに苦痛が増す。"}, {"type": "subtitle", "time": 27835.788, "timestamp": "07:43:55", "text": "素早い。さあ"}, {"type": "subtitle", "time": 27839.948, "timestamp": "07:43:59", "text": "アメリカに行ってAR46で"}]
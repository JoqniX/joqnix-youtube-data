[{"type": "subtitle", "time": 8968.389, "timestamp": "02:29:28", "text": "ダウ。これは終末だ。だからワウ"}, {"type": "subtitle", "time": 8970.67, "timestamp": "02:29:30", "text": "わ"}, {"type": "subtitle", "time": 8997.03, "timestamp": "02:29:57", "text": "夜明けに空白をめくる。ああ、それはそれは"}, {"type": "subtitle", "time": 8999.27, "timestamp": "02:29:59", "text": "プレーヤー。それが私たちのチームです。何てことだ。私は"}]
[{"type": "subtitle", "time": 4560.39, "timestamp": "01:16:00", "text": "グハのやつ。はい、これで正しいはずです。"}, {"type": "subtitle", "time": 4563.75, "timestamp": "01:16:03", "text": "右？それとも、そうすべきだろうか？私は怖いです。お願いします"}, {"type": "subtitle", "time": 4569.47, "timestamp": "01:16:09", "text": "壊す。とりあえず2つにしておきます。"}, {"type": "subtitle", "time": 4573.35, "timestamp": "01:16:13", "text": "わかった。保存。二重に確認する。"}, {"type": "subtitle", "time": 4576.55, "timestamp": "01:16:16", "text": "保存。わかった。それでは、Yash Jamaと入力してください。あなた"}, {"type": "subtitle", "time": 4579.51, "timestamp": "01:16:19", "text": "入力する必要があります。それは、えーと、一部の人にとって"}, {"type": "subtitle", "time": 4582.709, "timestamp": "01:16:22", "text": "私の持ち物が壊れる理由。ええ、そうですね。"}, {"type": "subtitle", "time": 4583.709, "timestamp": "01:16:23", "text": "うん。"}, {"type": "subtitle", "time": 4597.87, "timestamp": "01:16:37", "text": "はぁ？何"}, {"type": "subtitle", "time": 4600.47, "timestamp": "01:16:40", "text": "何が起こったのか？送信されませんでした。ああ、そうだった"}, {"type": "subtitle", "time": 4603.59, "timestamp": "01:16:43", "text": "送信。直せてよかった。さあ行こう。私たちは"}, {"type": "subtitle", "time": 4605.51, "timestamp": "01:16:45", "text": "直しました。わかった。わかった。だから、もしあなたが"}, {"type": "subtitle", "time": 4607.75, "timestamp": "01:16:47", "text": "何が起こっているのか不思議に思っていたが、"}, {"type": "subtitle", "time": 4611.03, "timestamp": "01:16:51", "text": "チャットを保存するような設定をしました"}, {"type": "subtitle", "time": 4615.03, "timestamp": "01:16:55", "text": "各ユーザー向けのメッセージ"}, {"type": "subtitle", "time": 4617.27, "timestamp": "01:16:57", "text": "組織的な方法、従来の方法とは異なり"}]
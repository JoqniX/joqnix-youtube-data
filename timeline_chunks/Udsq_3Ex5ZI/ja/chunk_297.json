[{"type": "subtitle", "time": 17833.31, "timestamp": "04:57:13", "text": "私"}, {"type": "subtitle", "time": 17836.708, "timestamp": "04:57:16", "text": "ノックした。ああ、それなら私は"}, {"type": "subtitle", "time": 17838.75, "timestamp": "04:57:18", "text": "通知。テストしてみましょう"}, {"type": "subtitle", "time": 17851.27, "timestamp": "04:57:31", "text": "私？うん。ベクター。"}, {"type": "subtitle", "time": 17853.55, "timestamp": "04:57:33", "text": "私の中の私は、コラボレーションしたいと思っています。クリックして"}, {"type": "subtitle", "time": 17856.31, "timestamp": "04:57:36", "text": "受け入れる。だから、あなたは私たちが"}, {"type": "subtitle", "time": 17863.19, "timestamp": "04:57:43", "text": "今。ビクターはまだここにはいません。小川"}, {"type": "subtitle", "time": 17866.27, "timestamp": "04:57:46", "text": "セクションはビクターによって開始されなければならない"}, {"type": "subtitle", "time": 17871.19, "timestamp": "04:57:51", "text": "VT Victor MT に参加してください。行く"}, {"type": "subtitle", "time": 17875.07, "timestamp": "04:57:55", "text": "Vexチャンネル。わかった。だからあなたは"}, {"type": "subtitle", "time": 17878.91, "timestamp": "04:57:58", "text": "ストリーミングして、それからあなたは"}]
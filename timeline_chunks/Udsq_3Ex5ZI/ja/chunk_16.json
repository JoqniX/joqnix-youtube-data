[{"type": "subtitle", "time": 962.829, "timestamp": "00:16:02", "text": "今ダウンロードしているところです"}, {"type": "subtitle", "time": 982.91, "timestamp": "00:16:22", "text": "わかった。それで、"}, {"type": "subtitle", "time": 987.43, "timestamp": "00:16:27", "text": "えっと、それは何ですか？えっと、暑いですか？"}, {"type": "subtitle", "time": 990.03, "timestamp": "00:16:30", "text": "インドは今や？はい、"}, {"type": "subtitle", "time": 994.87, "timestamp": "00:16:34", "text": "は。はい、インドは暑いです。"}, {"type": "subtitle", "time": 997.269, "timestamp": "00:16:37", "text": "暑い。これが私の建設工事です"}, {"type": "subtitle", "time": 997.64, "timestamp": "00:16:37", "text": "行く"}, {"type": "subtitle", "time": 999.069, "timestamp": "00:16:39", "text": "[音楽]"}, {"type": "subtitle", "time": 1011.97, "timestamp": "00:16:51", "text": "あなたへ"}]
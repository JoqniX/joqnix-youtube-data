[{"type": "subtitle", "time": 19622.07, "timestamp": "05:27:02", "text": "1週間か2週間くらい。だから彼は"}, {"type": "subtitle", "time": 19624.27, "timestamp": "05:27:04", "text": "昨日映画を見ていたのですが、"}, {"type": "subtitle", "time": 19629.03, "timestamp": "05:27:09", "text": "午後10時か11時頃だと思う"}, {"type": "subtitle", "time": 19631.75, "timestamp": "05:27:11", "text": "私はベッドでネットサーフィンをしていた"}, {"type": "subtitle", "time": 19636.43, "timestamp": "05:27:16", "text": "電話。とても疲れていた。それで"}, {"type": "subtitle", "time": 19640.23, "timestamp": "05:27:20", "text": "少し疲れている。そして私はZukiストリームを開いた"}, {"type": "subtitle", "time": 19642.788, "timestamp": "05:27:22", "text": "昨日、彼女が配信した時。私は思う"}, {"type": "subtitle", "time": 19645.39, "timestamp": "05:27:25", "text": "11時15分か"}, {"type": "subtitle", "time": 19649.47, "timestamp": "05:27:29", "text": "昨日の夜11時。"}, {"type": "subtitle", "time": 19651.47, "timestamp": "05:27:31", "text": "私は"}, {"type": "subtitle", "time": 19655.27, "timestamp": "05:27:35", "text": "ストリーム はい。私は嘘をついていた"}, {"type": "subtitle", "time": 19659.75, "timestamp": "05:27:39", "text": "下。ああ、私の首は右に向いています"}, {"type": "subtitle", "time": 19662.868, "timestamp": "05:27:42", "text": "電話、えっと、私はこれを持っている"}, {"type": "subtitle", "time": 19665.07, "timestamp": "05:27:45", "text": "バスケットのような、バスケットのようなものではない、あなたは"}, {"type": "subtitle", "time": 19666.91, "timestamp": "05:27:46", "text": "電話"}, {"type": "subtitle", "time": 19669.06, "timestamp": "05:27:49", "text": "スタンディッシュ スタンディッシュ"}, {"type": "subtitle", "time": 19671.19, "timestamp": "05:27:51", "text": "[音楽]"}, {"type": "subtitle", "time": 19674.628, "timestamp": "05:27:54", "text": "えっと、電話をキープするためにスタンディッシュ、だって私は"}]
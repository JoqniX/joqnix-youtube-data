[{"type": "subtitle", "time": 24061.43, "timestamp": "06:41:01", "text": "午後ああ、午後5時30分。うん、行くよ。"}, {"type": "subtitle", "time": 24063.548, "timestamp": "06:41:03", "text": "今日は暇だと思う。"}, {"type": "subtitle", "time": 24067.03, "timestamp": "06:41:07", "text": "まあ、そんな感じですね。まだ直してないんだけど"}, {"type": "subtitle", "time": 24071.75, "timestamp": "06:41:11", "text": "他の情報源も作りましたが、私は"}, {"type": "subtitle", "time": 24075.628, "timestamp": "06:41:15", "text": "この新しい方法を試している"}, {"type": "subtitle", "time": 24078.59, "timestamp": "06:41:18", "text": "ストリーミングだけど、それでもまだ、えーと、私は"}, {"type": "subtitle", "time": 24081.83, "timestamp": "06:41:21", "text": "まだ終わっていません。"}, {"type": "subtitle", "time": 24086.67, "timestamp": "06:41:26", "text": "今のところ私が作ったものは"}, {"type": "subtitle", "time": 24105.19, "timestamp": "06:41:45", "text": "待つべきだ。待って。さあ、行こう。なぜ"}, {"type": "subtitle", "time": 24105.948, "timestamp": "06:41:45", "text": "それ"}, {"type": "subtitle", "time": 24110.31, "timestamp": "06:41:50", "text": "待つ必要はありません。私は明らかに"}, {"type": "subtitle", "time": 24118.948, "timestamp": "06:41:58", "text": "外食に行かなきゃ。こんにちは。こんにちは、ズキ。行く。"}]
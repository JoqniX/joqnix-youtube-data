[{"type": "subtitle", "time": 19861.948, "timestamp": "05:31:01", "text": "えっと、Streamlabs ではありません"}, {"type": "subtitle", "time": 19865.51, "timestamp": "05:31:05", "text": "YouTube。私は使う予定でした"}, {"type": "subtitle", "time": 19867.91, "timestamp": "05:31:07", "text": "YouTube 用のストリーム要素を使用しています"}, {"type": "subtitle", "time": 19870.47, "timestamp": "05:31:10", "text": "Twitchのストリーム要素、"}, {"type": "subtitle", "time": 19874.99, "timestamp": "05:31:14", "text": "しかし、Stream Elementsはクソだ"}, {"type": "subtitle", "time": 19876.99, "timestamp": "05:31:16", "text": "ひどい"}, {"type": "subtitle", "time": 19880.788, "timestamp": "05:31:20", "text": "YouTubeで。彼らはただ雑談するだけだ。彼らは"}, {"type": "subtitle", "time": 19884.67, "timestamp": "05:31:24", "text": "他の人しかいない。なあ、兄弟、"}, {"type": "subtitle", "time": 19888.07, "timestamp": "05:31:28", "text": "何？チャットボットはどこですか？どこにあるの"}, {"type": "subtitle", "time": 19890.628, "timestamp": "05:31:30", "text": "チャットボット？何て言うの？"}, {"type": "subtitle", "time": 19892.99, "timestamp": "05:31:32", "text": "ここにはカペンはありません。"}, {"type": "subtitle", "time": 19901.75, "timestamp": "05:31:41", "text": "それでも。それでも。私はできる"}, {"type": "subtitle", "time": 19904.15, "timestamp": "05:31:44", "text": "これですよね？私ならできる。あなたに"}, {"type": "subtitle", "time": 19906.99, "timestamp": "05:31:46", "text": "Twitchからのすべての頭を撫でるハートから"}, {"type": "subtitle", "time": 19909.948, "timestamp": "05:31:49", "text": "YouTube。ただ"}, {"type": "subtitle", "time": 19912.75, "timestamp": "05:31:52", "text": "まるで"}, {"type": "subtitle", "time": 19915.39, "timestamp": "05:31:55", "text": "これ。わかった。待って。おお、"}, {"type": "subtitle", "time": 19917.07, "timestamp": "05:31:57", "text": "[音楽]"}, {"type": "subtitle", "time": 19919.67, "timestamp": "05:31:59", "text": "忘れた。待って。"}]
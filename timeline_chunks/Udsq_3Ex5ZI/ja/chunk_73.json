[{"type": "subtitle", "time": 4381.669, "timestamp": "01:13:01", "text": "言う？戻ってきて、話したり話したりしてください"}, {"type": "subtitle", "time": 4384.63, "timestamp": "01:13:04", "text": "何かについてとか、そんな感じのこと。"}, {"type": "subtitle", "time": 4385.95, "timestamp": "01:13:05", "text": "うん。うん。うん。"}, {"type": "subtitle", "time": 4388.47, "timestamp": "01:13:08", "text": "うん。ハッシュを見つけなければならない。そこには"}, {"type": "subtitle", "time": 4390.79, "timestamp": "01:13:10", "text": "ログに記録された多数のメッセージ"}, {"type": "subtitle", "time": 4392.91, "timestamp": "01:13:12", "text": "最後"}, {"type": "subtitle", "time": 4395.83, "timestamp": "01:13:15", "text": "ストリーム。わかった。あなたがこれを修正する前に"}, {"type": "subtitle", "time": 4400.55, "timestamp": "01:13:20", "text": "私にとっては休憩です。また壊れた。待って、これ"}, {"type": "subtitle", "time": 4405.55, "timestamp": "01:13:25", "text": "ゼロであるべきです。待って、伯爵"}, {"type": "subtitle", "time": 4409.27, "timestamp": "01:13:29", "text": "えっと、一度は必要ないと思ったんだけど"}, {"type": "subtitle", "time": 4417.87, "timestamp": "01:13:37", "text": "しかし、それはあなたが考えているようなものではありません。"}, {"type": "subtitle", "time": 4431.229, "timestamp": "01:13:51", "text": "[音楽]"}, {"type": "subtitle", "time": 4434.97, "timestamp": "01:13:54", "text": "今日？あなたが来てくれたことは本当に嬉しいです"}, {"type": "subtitle", "time": 4437.149, "timestamp": "01:13:57", "text": "[音楽]"}]
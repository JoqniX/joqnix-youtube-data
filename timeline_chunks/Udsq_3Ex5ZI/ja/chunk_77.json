[{"type": "subtitle", "time": 4620.39, "timestamp": "01:17:00", "text": "方法。うん。うん。うん。つまり、どうやら"}, {"type": "subtitle", "time": 4622.79, "timestamp": "01:17:02", "text": "何かが起こって壊れてしまった。"}, {"type": "subtitle", "time": 4626.07, "timestamp": "01:17:06", "text": "時々、そういうことが起こる人もいる。"}, {"type": "subtitle", "time": 4629.03, "timestamp": "01:17:09", "text": "ええ、まだ方法を探しているところです"}, {"type": "subtitle", "time": 4632.31, "timestamp": "01:17:12", "text": "それを直すために。時間がかかるかもしれません。えっと"}, {"type": "subtitle", "time": 4634.63, "timestamp": "01:17:14", "text": "ええ、"}, {"type": "subtitle", "time": 4637.91, "timestamp": "01:17:17", "text": "前回の配信はうまくいっていましたが、"}, {"type": "subtitle", "time": 4641.11, "timestamp": "01:17:21", "text": "しかし、雪が降っていたある人にとっては、"}, {"type": "subtitle", "time": 4643.99, "timestamp": "01:17:23", "text": "スノーウィーのために壊れた。しかし、墜落はしなかった。"}, {"type": "subtitle", "time": 4645.79, "timestamp": "01:17:25", "text": "けれど。しかし、これは初めてのことです"}, {"type": "subtitle", "time": 4647.91, "timestamp": "01:17:27", "text": "クラッシュしています。だから、何が"}, {"type": "subtitle", "time": 4650.07, "timestamp": "01:17:30", "text": "ハプニング。でも今は全て順調です。"}, {"type": "subtitle", "time": 4653.75, "timestamp": "01:17:33", "text": "えっと、これを引っ掛けるだけ"}, {"type": "subtitle", "time": 4655.99, "timestamp": "01:17:35", "text": "マイクスタンドをベッドとモニターに"}, {"type": "subtitle", "time": 4658.229, "timestamp": "01:17:38", "text": "ベッドの方へ向かってチャットを読めるように"}, {"type": "subtitle", "time": 4661.11, "timestamp": "01:17:41", "text": "そして睡眠。いいえ、いいえ、ただ読んで「いいね」してください"}, {"type": "subtitle", "time": 4662.75, "timestamp": "01:17:42", "text": "横になって眠る"}, {"type": "subtitle", "time": 4665.63, "timestamp": "01:17:45", "text": "形。でも母は"}, {"type": "subtitle", "time": 4669.149, "timestamp": "01:17:49", "text": "ゴア。待って、これは何？ Googleで調べてみよう"}, {"type": "subtitle", "time": 4672.79, "timestamp": "01:17:52", "text": "これ。検索してグーグルで調べてみてください。何が"}, {"type": "subtitle", "time": 4676.229, "timestamp": "01:17:56", "text": "これ？ああ、それはモモのようだ"}, {"type": "subtitle", "time": 4678.55, "timestamp": "01:17:58", "text": "あれだけど、モモじゃない。カリカリとした食感"}]
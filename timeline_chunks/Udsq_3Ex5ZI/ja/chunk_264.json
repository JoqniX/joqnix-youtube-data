[{"type": "subtitle", "time": 15842.63, "timestamp": "04:24:02", "text": "gr 少し、少し情報"}, {"type": "subtitle", "time": 15844.79, "timestamp": "04:24:04", "text": "そこにコンテンツがあります。"}, {"type": "subtitle", "time": 15847.99, "timestamp": "04:24:07", "text": "それはほんの少しのことだった。これはフィルターだったのか？いいえ"}, {"type": "subtitle", "time": 15849.349, "timestamp": "04:24:09", "text": "フィルター。実際、私はこんなにハンサムに見えたんです"}, {"type": "subtitle", "time": 15851.189, "timestamp": "04:24:11", "text": "現実世界で。私は当然知っている？えっと、みんな、"}, {"type": "subtitle", "time": 15854.309, "timestamp": "04:24:14", "text": "男の子たち、もしあなたがここに来たばかりなら、"}, {"type": "subtitle", "time": 15856.63, "timestamp": "04:24:16", "text": "ストリームをフォローして、"}, {"type": "subtitle", "time": 15861.349, "timestamp": "04:24:21", "text": "YouTubeよ、ベイビー、今すぐ動画を見て。"}, {"type": "subtitle", "time": 15862.63, "timestamp": "04:24:22", "text": "すべての通知を受け取るには、ベルマークをオンにしてください。"}, {"type": "subtitle", "time": 15865.59, "timestamp": "04:24:25", "text": "私たちは20分ほど見ていました"}, {"type": "subtitle", "time": 15867.51, "timestamp": "04:24:27", "text": "分。 YouTubeチャンネル登録をお願いします。それ"}, {"type": "subtitle", "time": 15870.63, "timestamp": "04:24:30", "text": "めちゃくちゃすごいだろうな。それはおかしい。"}, {"type": "subtitle", "time": 15873.59, "timestamp": "04:24:33", "text": "えっと、何？あなたならできますよ。できますか？"}, {"type": "subtitle", "time": 15881.429, "timestamp": "04:24:41", "text": "ああ、だってそれは起こるだろうから。それに対して。"}, {"type": "subtitle", "time": 15887.229, "timestamp": "04:24:47", "text": "トリミングする"}, {"type": "subtitle", "time": 15890.309, "timestamp": "04:24:50", "text": "編集者が短く編集するための動画が公開されました"}, {"type": "subtitle", "time": 15894.389, "timestamp": "04:24:54", "text": "世界のビデオタレントエージェンシー"}, {"type": "subtitle", "time": 15898.63, "timestamp": "04:24:58", "text": "えっと、私はたくさんのことを知っています。おお"}]
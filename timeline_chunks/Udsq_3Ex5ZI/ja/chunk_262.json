[{"type": "subtitle", "time": 15722.55, "timestamp": "04:22:02", "text": "レートと専用ビデオは"}, {"type": "subtitle", "time": 15726.269, "timestamp": "04:22:06", "text": "未来。さて、あなたはどのように"}, {"type": "subtitle", "time": 15729.11, "timestamp": "04:22:09", "text": "クリエイターは、あなたのチャンネルを台無しにしないようにしますか？"}, {"type": "subtitle", "time": 15731.75, "timestamp": "04:22:11", "text": "専用ビデオは"}, {"type": "subtitle", "time": 15734.389, "timestamp": "04:22:14", "text": "登録者を失う原因となる動画"}, {"type": "subtitle", "time": 15739.269, "timestamp": "04:22:19", "text": "最も。それが真実だ。そうです。それで"}, {"type": "subtitle", "time": 15741.59, "timestamp": "04:22:21", "text": "あなたも私と同じことができます。"}, {"type": "subtitle", "time": 15745.11, "timestamp": "04:22:25", "text": "戦略とは、聴衆を圧倒することです"}, {"type": "subtitle", "time": 15748.07, "timestamp": "04:22:28", "text": "1日に4～5本の動画を撮るよ、だって"}, {"type": "subtitle", "time": 15750.87, "timestamp": "04:22:30", "text": "4～5歳くらいの人がたくさんおしゃべりしていた"}, {"type": "subtitle", "time": 15753.429, "timestamp": "04:22:33", "text": "動画。すべての専任担当者が"}, {"type": "subtitle", "time": 15756.07, "timestamp": "04:22:36", "text": "あなたが撮影するビデオには、たくさんの"}, {"type": "subtitle", "time": 15758.07, "timestamp": "04:22:38", "text": "作業を進めて、感じない場所にたどり着く"}, {"type": "subtitle", "time": 15759.91, "timestamp": "04:22:39", "text": "侮辱と平手打ちのように"}, {"type": "subtitle", "time": 15762.55, "timestamp": "04:22:42", "text": "あなたの聴衆。そしてそれはとても難しい"}, {"type": "subtitle", "time": 15765.189, "timestamp": "04:22:45", "text": "レイジ専用のビデオを撮影するとき"}, {"type": "subtitle", "time": 15767.269, "timestamp": "04:22:47", "text": "シャドウレジェンドですが、"}, {"type": "subtitle", "time": 15768.389, "timestamp": "04:22:48", "text": "インターネットはきっと喜ぶだろう"}, {"type": "subtitle", "time": 15771.83, "timestamp": "04:22:51", "text": "これ。クリエイターたちは制作をやめるだろう"}, {"type": "subtitle", "time": 15773.91, "timestamp": "04:22:53", "text": "これからはもっと少なくなるだろう"}, {"type": "subtitle", "time": 15776.229, "timestamp": "04:22:56", "text": "通常よりも多くのお金。それで"}, {"type": "subtitle", "time": 15779.349, "timestamp": "04:22:59", "text": "将来に備えることはとても"}]
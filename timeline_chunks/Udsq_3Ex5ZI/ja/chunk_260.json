[{"type": "subtitle", "time": 15602.95, "timestamp": "04:20:02", "text": "皮肉抜きで統合へのビデオは"}, {"type": "subtitle", "time": 15607.91, "timestamp": "04:20:07", "text": "平均して1対147。なぜなら"}, {"type": "subtitle", "time": 15609.59, "timestamp": "04:20:09", "text": "専用ビデオ、これらの企業は"}, {"type": "subtitle", "time": 15611.91, "timestamp": "04:20:11", "text": "これらの人々が望んでいることを知ることになるでしょう"}, {"type": "subtitle", "time": 15614.59, "timestamp": "04:20:14", "text": "これを見てください。だから彼らはクリックしたのだ。"}, {"type": "subtitle", "time": 15617.67, "timestamp": "04:20:17", "text": "統合は非常に簡単にスキップできます。"}, {"type": "subtitle", "time": 15619.75, "timestamp": "04:20:19", "text": "だから私はできるだけ多くのことについて一つずつやっています"}, {"type": "subtitle", "time": 15622.229, "timestamp": "04:20:22", "text": "可能な限り動画でお願いします。言っておくけど、もし"}, {"type": "subtitle", "time": 15624.469, "timestamp": "04:20:24", "text": "あなたはクリエイターです、すべての"}, {"type": "subtitle", "time": 15626.79, "timestamp": "04:20:26", "text": "統合は今すぐ可能です"}, {"type": "subtitle", "time": 15629.429, "timestamp": "04:20:29", "text": "なぜなら、それらは消え去っていくからだ。企業"}, {"type": "subtitle", "time": 15632.389, "timestamp": "04:20:32", "text": "賢くなってきた。私もこう言おう"}, {"type": "subtitle", "time": 15634.95, "timestamp": "04:20:34", "text": "これは、そしてこれは衝撃を与えるだろう"}, {"type": "subtitle", "time": 15638.55, "timestamp": "04:20:38", "text": "たくさんの人だよ、いいかい？このプラットフォームで"}, {"type": "subtitle", "time": 15642.469, "timestamp": "04:20:42", "text": "TwitchやYouTubeには、たくさんのクリエイターがいます"}, {"type": "subtitle", "time": 15643.149, "timestamp": "04:20:43", "text": "は"}, {"type": "subtitle", "time": 15646.79, "timestamp": "04:20:46", "text": "多くの企業が視聴し始めています"}, {"type": "subtitle", "time": 15648.63, "timestamp": "04:20:48", "text": "それに気づいて、"}, {"type": "subtitle", "time": 15650.389, "timestamp": "04:20:50", "text": "企業は信頼を失い始めている"}, {"type": "subtitle", "time": 15653.59, "timestamp": "04:20:53", "text": "トップクリエイターの多くは"}, {"type": "subtitle", "time": 15655.91, "timestamp": "04:20:55", "text": "見るのは本当は良くない"}, {"type": "subtitle", "time": 15657.99, "timestamp": "04:20:57", "text": "あなたにとっては驚きでしょう。"}, {"type": "subtitle", "time": 15659.83, "timestamp": "04:20:59", "text": "かなり物議を醸すストリームがありました"}]
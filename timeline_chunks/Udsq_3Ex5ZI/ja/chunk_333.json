[{"type": "subtitle", "time": 19980.43, "timestamp": "05:33:00", "text": "ない。待って。何？"}, {"type": "subtitle", "time": 19984.03, "timestamp": "05:33:04", "text": "お前。わかった。何？言い訳"}, {"type": "subtitle", "time": 19987.948, "timestamp": "05:33:07", "text": "自分。ああ、虫だ。ええ、私の配信についてですが、"}, {"type": "subtitle", "time": 19991.51, "timestamp": "05:33:11", "text": "男。私が配信するたびに、"}, {"type": "subtitle", "time": 19993.83, "timestamp": "05:33:13", "text": "機能しないもの。ああ、そうだね。誰が"}, {"type": "subtitle", "time": 19997.19, "timestamp": "05:33:17", "text": "チャット？誰がチャットしたの？わかった。誰が来たの？赤見"}, {"type": "subtitle", "time": 19998.58, "timestamp": "05:33:18", "text": "来た。わかった。"}, {"type": "subtitle", "time": 20011.628, "timestamp": "05:33:31", "text": "ゼロが来るなんて、すごいね。楽しんでいただければ幸いです"}, {"type": "subtitle", "time": 20014.83, "timestamp": "05:33:34", "text": "日。楽しむ。水分補給をしっかりしてください。滞在する"}, {"type": "subtitle", "time": 20017.15, "timestamp": "05:33:37", "text": "ポジティブ。ご来場ありがとうございました"}, {"type": "subtitle", "time": 20019.868, "timestamp": "05:33:39", "text": "また。ヘッドパッチ"}, {"type": "subtitle", "time": 20026.708, "timestamp": "05:33:46", "text": "わかった。つまり、エモートは正常に機能しているということですね。うん、"}, {"type": "subtitle", "time": 20028.59, "timestamp": "05:33:48", "text": "絵文字は正常に動作しています。"}, {"type": "subtitle", "time": 20031.35, "timestamp": "05:33:51", "text": "しかし、エモートは正常に機能しています。ええと、そして"}, {"type": "subtitle", "time": 20033.868, "timestamp": "05:33:53", "text": "ようこそ"}, {"type": "subtitle", "time": 20037.708, "timestamp": "05:33:57", "text": "作品。ええと、ボードは正常に動作しています。"}]
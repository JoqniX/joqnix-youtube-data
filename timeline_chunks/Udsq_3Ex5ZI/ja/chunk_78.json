[{"type": "subtitle", "time": 4681.709, "timestamp": "01:18:01", "text": "あれ。ああ、わかりました。わかった。"}, {"type": "subtitle", "time": 4686.75, "timestamp": "01:18:06", "text": "ガイド。"}, {"type": "subtitle", "time": 4693.709, "timestamp": "01:18:13", "text": "わかった。わかった。団子。"}, {"type": "subtitle", "time": 4697.03, "timestamp": "01:18:17", "text": "ああ、ギア。特別にデザインされた"}, {"type": "subtitle", "time": 4698.91, "timestamp": "01:18:18", "text": "主に神聖なもの。それは"}, {"type": "subtitle", "time": 4702.87, "timestamp": "01:18:22", "text": "揚げて焼いたペストリーに"}, {"type": "subtitle", "time": 4705.95, "timestamp": "01:18:25", "text": "ドライフルーツと甘酸っぱいもののミックス。"}, {"type": "subtitle", "time": 4711.07, "timestamp": "01:18:31", "text": "ああ、なんて可愛いの。何てことだ。"}, {"type": "subtitle", "time": 4713.63, "timestamp": "01:18:33", "text": "A"}, {"type": "subtitle", "time": 4716.75, "timestamp": "01:18:36", "text": "見て。これ"}, {"type": "subtitle", "time": 4718.27, "timestamp": "01:18:38", "text": "どうやら"}, {"type": "subtitle", "time": 4721.63, "timestamp": "01:18:41", "text": "わかりました。音楽は"}, {"type": "subtitle", "time": 4724.709, "timestamp": "01:18:44", "text": "音量？あまり低くないといいんだけど。はい、"}, {"type": "subtitle", "time": 4727.51, "timestamp": "01:18:47", "text": "大丈夫ですよね？"}, {"type": "subtitle", "time": 4732.83, "timestamp": "01:18:52", "text": "忘れていた。私のこの"}, {"type": "subtitle", "time": 4736.99, "timestamp": "01:18:56", "text": "配線がごちゃごちゃしている。これは何と呼ぶのですか？"}]
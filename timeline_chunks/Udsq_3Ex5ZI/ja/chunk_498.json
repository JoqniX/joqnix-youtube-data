[{"type": "subtitle", "time": 29883.788, "timestamp": "08:18:03", "text": "上。設定はしていません。"}, {"type": "subtitle", "time": 29886.83, "timestamp": "08:18:06", "text": "えっと、私は"}, {"type": "subtitle", "time": 29889.99, "timestamp": "08:18:09", "text": "私にそれが実現できるかどうか試させてください。"}, {"type": "subtitle", "time": 29892.23, "timestamp": "08:18:12", "text": "私が歩いて行くと"}, {"type": "subtitle", "time": 29898.12, "timestamp": "08:18:18", "text": "わかった。欲しい"}, {"type": "subtitle", "time": 29899.388, "timestamp": "08:18:19", "text": "[音楽]"}, {"type": "subtitle", "time": 29902.43, "timestamp": "08:18:22", "text": "私ができるかどうか確認するために"}, {"type": "subtitle", "time": 29905.708, "timestamp": "08:18:25", "text": "これ。ヘッドパッチが欲しい"}, {"type": "subtitle", "time": 29907.548, "timestamp": "08:18:27", "text": "あなた"}, {"type": "subtitle", "time": 29912.15, "timestamp": "08:18:32", "text": "みんな。できるか試してみます。"}, {"type": "subtitle", "time": 29923.15, "timestamp": "08:18:43", "text": "おお。あなたはいつも私たちを支えてくれる"}, {"type": "subtitle", "time": 29927.19, "timestamp": "08:18:47", "text": "こんにちは、キャディ。不可能。"}, {"type": "subtitle", "time": 29928.83, "timestamp": "08:18:48", "text": "私は 私は 私は"}]
[{"type": "subtitle", "time": 12788.63, "timestamp": "03:33:08", "text": "彼はあなたを見捨てるでしょう、愛しいエリザベス。"}, {"type": "subtitle", "time": 12790.55, "timestamp": "03:33:10", "text": "必要なものを手に入れたら、彼は去るだろう"}, {"type": "subtitle", "time": 12793.349, "timestamp": "03:33:13", "text": "あなた一人だけ。他に何を期待できるだろうか"}, {"type": "subtitle", "time": 12796.91, "timestamp": "03:33:16", "text": "嘘つきで女性殺し？"}, {"type": "subtitle", "time": 12824.389, "timestamp": "03:33:44", "text": "ロケット。"}]
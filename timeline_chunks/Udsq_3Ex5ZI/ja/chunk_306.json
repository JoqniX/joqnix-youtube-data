[{"type": "subtitle", "time": 18363.948, "timestamp": "05:06:03", "text": "5月。よし。"}, {"type": "subtitle", "time": 18366.55, "timestamp": "05:06:06", "text": "とにかく、皆さん、私は"}, {"type": "subtitle", "time": 18370.03, "timestamp": "05:06:10", "text": "私の寝る場所。ありがとうございます"}, {"type": "subtitle", "time": 18372.39, "timestamp": "05:06:12", "text": "今日。本日は本当にありがとうございました。病気"}, {"type": "subtitle", "time": 18374.47, "timestamp": "05:06:14", "text": "それでは失礼します。またね"}, {"type": "subtitle", "time": 18377.27, "timestamp": "05:06:17", "text": "明日の朝、午前6時。"}, {"type": "subtitle", "time": 18381.55, "timestamp": "05:06:21", "text": "ここに来るでしょう。私が登場するのを見てください"}, {"type": "subtitle", "time": 18384.948, "timestamp": "05:06:24", "text": "5時30分。私はここにいます。それでは、おやすみなさい。"}, {"type": "subtitle", "time": 18387.75, "timestamp": "05:06:27", "text": "みんな。良い夢を。楽しんでください"}, {"type": "subtitle", "time": 18390.868, "timestamp": "05:06:30", "text": "va.私は行くつもりです。ええ、そうですね。そして感謝します"}, {"type": "subtitle", "time": 18392.948, "timestamp": "05:06:32", "text": "立ち寄ってくださった皆様にも感謝いたします。感謝"}, {"type": "subtitle", "time": 18395.07, "timestamp": "05:06:35", "text": "あなた。配信を終了します"}, {"type": "subtitle", "time": 18398.15, "timestamp": "05:06:38", "text": "信じられないほど、そして本当にありがとうございます"}, {"type": "subtitle", "time": 18400.948, "timestamp": "05:06:40", "text": "通りかかるよ。たくさんの贈り物をありがとうございました。"}, {"type": "subtitle", "time": 18405.948, "timestamp": "05:06:45", "text": "そして"}, {"type": "subtitle", "time": 18411.47, "timestamp": "05:06:51", "text": "私の"}, {"type": "subtitle", "time": 18413.788, "timestamp": "05:06:53", "text": "モイ。アレックスが行く"}, {"type": "subtitle", "time": 18418.59, "timestamp": "05:06:58", "text": "そしてついにアップロードが完了しました"}]
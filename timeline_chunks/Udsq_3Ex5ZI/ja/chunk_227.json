[{"type": "subtitle", "time": 13620.95, "timestamp": "03:47:00", "text": "コミュニティとかそういうもの。"}, {"type": "subtitle", "time": 13629.429, "timestamp": "03:47:09", "text": "我々のうちの一人。そのうちの一人が彼女だ。"}, {"type": "subtitle", "time": 13631.99, "timestamp": "03:47:11", "text": "スクリューイー・レイブンズ、彼女はバイオをプレイしている"}, {"type": "subtitle", "time": 13639.99, "timestamp": "03:47:19", "text": "彼女はTwitchで配信している。"}, {"type": "subtitle", "time": 13642.71, "timestamp": "03:47:22", "text": "しかし、私たちのTwitchアカウント。待って、君君"}, {"type": "subtitle", "time": 13651.03, "timestamp": "03:47:31", "text": "何？それは奇妙だ。"}, {"type": "subtitle", "time": 13655.03, "timestamp": "03:47:35", "text": "それは奇妙だ。ああ、ARブラウザを使ってるよ"}, {"type": "subtitle", "time": 13658.95, "timestamp": "03:47:38", "text": "今。ええ、彼女はTwitchアカウントを持っていました"}, {"type": "subtitle", "time": 13669.67, "timestamp": "03:47:49", "text": "そこには。彼女は一度だけTwitchで配信を行った。私"}, {"type": "subtitle", "time": 13673.11, "timestamp": "03:47:53", "text": "まだそこにあるかどうかは分かりません。"}, {"type": "subtitle", "time": 13675.75, "timestamp": "03:47:55", "text": "いいえ、まだそこにはありません。そうではありません。いいえ"}]
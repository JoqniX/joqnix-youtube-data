[{"type": "subtitle", "time": 17220.11, "timestamp": "04:47:00", "text": "自分用のフォーマット。いいえ、それは私が"}, {"type": "subtitle", "time": 17222.19, "timestamp": "04:47:02", "text": "気がついた。"}, {"type": "subtitle", "time": 17229.35, "timestamp": "04:47:09", "text": "ジョッカソン。他の人がどう思うかはわかりません"}, {"type": "subtitle", "time": 17232.31, "timestamp": "04:47:12", "text": "私と同じようなサムネイル形式を作った人がいます。"}, {"type": "subtitle", "time": 17235.43, "timestamp": "04:47:15", "text": "つまり、とても停滞していて、いいえ、"}, {"type": "subtitle", "time": 17239.83, "timestamp": "04:47:19", "text": "その言葉？毎月同じことだけど"}, {"type": "subtitle", "time": 17247.51, "timestamp": "04:47:27", "text": "変化。もう一つは紫色のもの"}, {"type": "subtitle", "time": 17250.31, "timestamp": "04:47:30", "text": "ここで見られる紫の量、"}, {"type": "subtitle", "time": 17252.23, "timestamp": "04:47:32", "text": "それはあなたが"}, {"type": "subtitle", "time": 17254.708, "timestamp": "04:47:34", "text": "今月はピンク色を探してみよう"}, {"type": "subtitle", "time": 17266.15, "timestamp": "04:47:46", "text": "神様、神様、これら全てを想像してみてください"}, {"type": "subtitle", "time": 17269.19, "timestamp": "04:47:49", "text": "ジョッカソンの動画ですよね？面白いところ"}, {"type": "subtitle", "time": 17271.91, "timestamp": "04:47:51", "text": "これらすべてに関して言えば、私は"}, {"type": "subtitle", "time": 17275.15, "timestamp": "04:47:55", "text": "私のVのためにどれでも1つ"}, {"type": "subtitle", "time": 17278.23, "timestamp": "04:47:58", "text": "サイクル。そこが面白いところなんだ。 Vサイクル"}]
[{"type": "subtitle", "time": 24302.07, "timestamp": "06:45:02", "text": "すごく疲れた。"}, {"type": "subtitle", "time": 24305.35, "timestamp": "06:45:05", "text": "そして昨日、ズキの配信を始めました。"}, {"type": "subtitle", "time": 24309.948, "timestamp": "06:45:09", "text": "えっと、彼女が配信したのは11時15分か"}, {"type": "subtitle", "time": 24314.03, "timestamp": "06:45:14", "text": "昨日の夜11時。"}, {"type": "subtitle", "time": 24318.868, "timestamp": "06:45:18", "text": "私は流れだった。ええ、私はこう思いました"}, {"type": "subtitle", "time": 24322.948, "timestamp": "06:45:22", "text": "横になっているような感じ。ああ、私の首は"}, {"type": "subtitle", "time": 24325.11, "timestamp": "06:45:25", "text": "右"}, {"type": "subtitle", "time": 24328.628, "timestamp": "06:45:28", "text": "えーと、バスケットみたいなのを持ってるんだけど、"}, {"type": "subtitle", "time": 24331.548, "timestamp": "06:45:31", "text": "バスケットのような。何と呼ぶか"}, {"type": "subtitle", "time": 24333.65, "timestamp": "06:45:33", "text": "スタンディッシュ スタンディッシュ"}, {"type": "subtitle", "time": 24335.83, "timestamp": "06:45:35", "text": "[音楽]"}, {"type": "subtitle", "time": 24339.51, "timestamp": "06:45:39", "text": "電話を保管しておくには、スタンディッシュが必要ですか？私 私"}, {"type": "subtitle", "time": 24341.788, "timestamp": "06:45:41", "text": "電話を持っていません"}, {"type": "subtitle", "time": 24346.07, "timestamp": "06:45:46", "text": "カバー。いいえ、私は"}, {"type": "subtitle", "time": 24349.51, "timestamp": "06:45:49", "text": "うーん、わからない。ショーを見ましたか"}, {"type": "subtitle", "time": 24353.19, "timestamp": "06:45:53", "text": "映画？わかりません。私は"}, {"type": "subtitle", "time": 24357.708, "timestamp": "06:45:57", "text": "いとこだった彼は、私のパソコンを使っていたんですよね？"}]
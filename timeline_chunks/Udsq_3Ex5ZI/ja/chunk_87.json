[{"type": "subtitle", "time": 5224.99, "timestamp": "01:27:04", "text": "私が今見せたのは"}, {"type": "subtitle", "time": 5227.59, "timestamp": "01:27:07", "text": "私は麺をハカします。これはハカだと思います"}, {"type": "subtitle", "time": 5231.189, "timestamp": "01:27:11", "text": "麺。ええ、私は以前、"}, {"type": "subtitle", "time": 5233.95, "timestamp": "01:27:13", "text": "から入手しました"}, {"type": "subtitle", "time": 5237.83, "timestamp": "01:27:17", "text": "ブランケット。私はこういうことはしない。"}, {"type": "subtitle", "time": 5241.189, "timestamp": "01:27:21", "text": "オンラインで食べ物を注文するのは、ちょっと気取っているように感じる"}, {"type": "subtitle", "time": 5242.11, "timestamp": "01:27:22", "text": "そして"}, {"type": "subtitle", "time": 5245.39, "timestamp": "01:27:25", "text": "など。私は完全に伝統的な"}, {"type": "subtitle", "time": 5249.189, "timestamp": "01:27:29", "text": "親切。食べ物を買いに行って、"}, {"type": "subtitle", "time": 5252.629, "timestamp": "01:27:32", "text": "故郷に戻るタイプ。"}, {"type": "chat", "time": 5258.826, "timestamp": "01:27:38", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "food's really nice over there"}, {"type": "subtitle", "time": 5276.59, "timestamp": "01:27:56", "text": "うん、"}, {"type": "subtitle", "time": 5278.83, "timestamp": "01:27:58", "text": "そうです"}]
[{"type": "subtitle", "time": 27180.948, "timestamp": "07:33:00", "text": "はい。墜落しないことを祈るよ。私"}, {"type": "subtitle", "time": 27184.548, "timestamp": "07:33:04", "text": "そうならないことを願います。願っています。あなたは何を"}, {"type": "subtitle", "time": 27185.708, "timestamp": "07:33:05", "text": "する？"}, {"type": "subtitle", "time": 27189.07, "timestamp": "07:33:09", "text": "えっと、どうすればそれをなくせるでしょうか"}, {"type": "subtitle", "time": 27193.91, "timestamp": "07:33:13", "text": "クラッシュ？わかった。打ち上げ。ちょっと待ってください"}, {"type": "subtitle", "time": 27199.788, "timestamp": "07:33:19", "text": "もの。声が聞こえるといいな"}, {"type": "subtitle", "time": 27205.708, "timestamp": "07:33:25", "text": "うん。"}, {"type": "subtitle", "time": 27207.548, "timestamp": "07:33:27", "text": "はい。しかし"}, {"type": "subtitle", "time": 27212.27, "timestamp": "07:33:32", "text": "うん、もし君が、もし君が"}, {"type": "subtitle", "time": 27216.07, "timestamp": "07:33:36", "text": "配信中に時々見かけますよね？私の"}, {"type": "subtitle", "time": 27219.03, "timestamp": "07:33:39", "text": "配信中の私の声は確かにロボットみたいに聞こえる。"}, {"type": "subtitle", "time": 27222.548, "timestamp": "07:33:42", "text": "ノイズフィルターのせいだよ。"}, {"type": "subtitle", "time": 27225.27, "timestamp": "07:33:45", "text": "なぜそうなるのか分からないが、"}, {"type": "subtitle", "time": 27230.628, "timestamp": "07:33:50", "text": "痛み。ゲームを開始することができました。"}, {"type": "subtitle", "time": 27232.868, "timestamp": "07:33:52", "text": "さあ行こう。よし。何もせずに"}, {"type": "subtitle", "time": 27235.11, "timestamp": "07:33:55", "text": "それでは、場面転換しましょう。希望"}, {"type": "subtitle", "time": 27237.868, "timestamp": "07:33:57", "text": "君たちは元気でよくやっているね、"}]
[{"type": "subtitle", "time": 8122.27, "timestamp": "02:15:22", "text": "はい、私は"}, {"type": "subtitle", "time": 8124.95, "timestamp": "02:15:24", "text": "戻る。母は私に寝るように言った"}, {"type": "subtitle", "time": 8127.31, "timestamp": "02:15:27", "text": "階下"}, {"type": "subtitle", "time": 8130.39, "timestamp": "02:15:30", "text": "今日はそれが起きていないので、家にいません"}, {"type": "subtitle", "time": 8156.61, "timestamp": "02:15:56", "text": "わかった、"}]
[{"type": "subtitle", "time": 734.23, "timestamp": "00:12:14", "text": "ルピー。トロフィー大砲。私は必要なことをしなかった"}, {"type": "subtitle", "time": 736.35, "timestamp": "00:12:16", "text": "このような飲み物を飲む"}, {"type": "subtitle", "time": 752.91, "timestamp": "00:12:32", "text": "ジプソン。"}, {"type": "subtitle", "time": 756.71, "timestamp": "00:12:36", "text": "名。わあ、これはすごくクールだ。私は決して"}, {"type": "subtitle", "time": 759.069, "timestamp": "00:12:39", "text": "たくさん買えると思います"}, {"type": "subtitle", "time": 763.7, "timestamp": "00:12:43", "text": "もの。疲れましたか？ええ、そうです"}, {"type": "subtitle", "time": 765.87, "timestamp": "00:12:45", "text": "[音楽]"}, {"type": "subtitle", "time": 769.99, "timestamp": "00:12:49", "text": "疲れた。私は疲れている。インスタント。たぶん私は"}]
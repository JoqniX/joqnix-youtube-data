[{"type": "subtitle", "time": 19153.51, "timestamp": "05:19:13", "text": "ああ、神様。戻ってくる。戻ってくる。戻ってくる。"}, {"type": "subtitle", "time": 19156.39, "timestamp": "05:19:16", "text": "頑張れよ。頑張れよ。ということで、今日の配信は"}, {"type": "subtitle", "time": 19159.31, "timestamp": "05:19:19", "text": "計画外のストリーム"}, {"type": "subtitle", "time": 19162.31, "timestamp": "05:19:22", "text": "自分。 YouTubeは換金しません。ええ、できますよ"}, {"type": "subtitle", "time": 19164.27, "timestamp": "05:19:24", "text": "えーとやってみて"}, {"type": "subtitle", "time": 19165.948, "timestamp": "05:19:25", "text": "償還"}, {"type": "subtitle", "time": 19169.628, "timestamp": "05:19:29", "text": "水分補給する。水分補給をしましょう。できるよ"}, {"type": "subtitle", "time": 19173.51, "timestamp": "05:19:33", "text": "それ。ああ、YouTubeは十分ではない"}, {"type": "subtitle", "time": 19181.27, "timestamp": "05:19:41", "text": "えっと、皆さん、これについてどうすればいいでしょうか？"}, {"type": "subtitle", "time": 19190.23, "timestamp": "05:19:50", "text": "アイデア？ここに、どうすればいいかアイデアを持っている人はいますか？"}, {"type": "subtitle", "time": 19191.708, "timestamp": "05:19:51", "text": "このYouTubeを修正してください"}, {"type": "subtitle", "time": 19196.868, "timestamp": "05:19:56", "text": "問題？私はめちゃくちゃ怒ってる。立ち去る"}, {"type": "subtitle", "time": 19198.19, "timestamp": "05:19:58", "text": "それ。"}]
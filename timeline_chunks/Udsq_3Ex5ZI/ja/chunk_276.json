[{"type": "subtitle", "time": 16560.629, "timestamp": "04:36:00", "text": "いや、でも、それを取りたいんだ"}, {"type": "subtitle", "time": 16562.709, "timestamp": "04:36:02", "text": "真剣に、でもどうすればいいのかわからない"}, {"type": "subtitle", "time": 16569.75, "timestamp": "04:36:09", "text": "真剣に、もしくはもっと言えば、えーと、私自身は"}, {"type": "subtitle", "time": 16574.029, "timestamp": "04:36:14", "text": "自分のせいで自分を制限しているってどういうこと？"}, {"type": "subtitle", "time": 16576.551, "timestamp": "04:36:16", "text": "標準品質？わからない。私はしません"}, {"type": "subtitle", "time": 16579.029, "timestamp": "04:36:19", "text": "知る。私はそうしているように感じ、"}, {"type": "subtitle", "time": 16581.83, "timestamp": "04:36:21", "text": "それはまずい。"}, {"type": "subtitle", "time": 16584.07, "timestamp": "04:36:24", "text": "私はもっ​​と好きになるべきだ"}, {"type": "subtitle", "time": 16586.31, "timestamp": "04:36:26", "text": "動画クリエイターというよりはライブストリーマー"}, {"type": "chat", "time": 16588.348, "timestamp": "04:36:28", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "oh dw i get that a lot"}, {"type": "subtitle", "time": 16589.51, "timestamp": "04:36:29", "text": "右？だから、私にはその機会がある"}, {"type": "subtitle", "time": 16593.429, "timestamp": "04:36:33", "text": "ライブストリームを利用して"}, {"type": "subtitle", "time": 16596.47, "timestamp": "04:36:36", "text": "それをビデオ形式に変換して、"}, {"type": "subtitle", "time": 16597.869, "timestamp": "04:36:37", "text": "私がすべきこと"}, {"type": "subtitle", "time": 16602.789, "timestamp": "04:36:42", "text": "する。分からないような気がする。できました"}, {"type": "subtitle", "time": 16605.029, "timestamp": "04:36:45", "text": "いつもリアクションコンテンツをやっているけど、"}, {"type": "subtitle", "time": 16617.109, "timestamp": "04:36:57", "text": "専用のビデオタイプがあります"}]
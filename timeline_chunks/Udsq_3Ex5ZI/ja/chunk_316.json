[{"type": "subtitle", "time": 18960.07, "timestamp": "05:16:00", "text": "心。 YouTubeのストリームに関しては、"}, {"type": "subtitle", "time": 18962.35, "timestamp": "05:16:02", "text": "私は設定していません"}, {"type": "subtitle", "time": 18964.51, "timestamp": "05:16:04", "text": "忠誠心。忠誠心"}, {"type": "subtitle", "time": 18967.628, "timestamp": "05:16:07", "text": "もの。あ、待って。忠誠心について語る"}, {"type": "subtitle", "time": 18970.47, "timestamp": "05:16:10", "text": "もの。この新しいものには追加していません"}, {"type": "subtitle", "time": 18973.75, "timestamp": "05:16:13", "text": "私が使っているのはOBSです。"}, {"type": "subtitle", "time": 18978.03, "timestamp": "05:16:18", "text": "ああ、忘れてた。ああ神様、私は"}, {"type": "subtitle", "time": 18985.27, "timestamp": "05:16:25", "text": "秒ええと、その歌は知っています。曲名"}, {"type": "subtitle", "time": 18988.868, "timestamp": "05:16:28", "text": "待ってください。ああ、私は"}, {"type": "subtitle", "time": 18990.868, "timestamp": "05:16:30", "text": "YouTube動画。ああ、それは持っていません"}, {"type": "subtitle", "time": 19001.03, "timestamp": "05:16:41", "text": "これが私の嫌いなところだ。えっと、私がしたかったように"}, {"type": "subtitle", "time": 19003.59, "timestamp": "05:16:43", "text": "再生"}, {"type": "subtitle", "time": 19011.55, "timestamp": "05:16:51", "text": "でも私はYouTubeを使って"}, {"type": "subtitle", "time": 19014.788, "timestamp": "05:16:54", "text": "今。待って。いや、実際はそうじゃない"}, {"type": "subtitle", "time": 19019.39, "timestamp": "05:16:59", "text": "うまくいった？ 1秒。いや、待って。えっと、1つ"}]
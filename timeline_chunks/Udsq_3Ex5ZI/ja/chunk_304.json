[{"type": "subtitle", "time": 18251.91, "timestamp": "05:04:11", "text": "[音楽]"}, {"type": "subtitle", "time": 18256.07, "timestamp": "05:04:16", "text": "そう、メディアキットはちょっと面倒だし、"}, {"type": "subtitle", "time": 18258.23, "timestamp": "05:04:18", "text": "メディアキットの資料をいくつか作成する必要がある"}, {"type": "subtitle", "time": 18259.948, "timestamp": "05:04:19", "text": "まあ私の"}, {"type": "subtitle", "time": 18269.03, "timestamp": "05:04:29", "text": "実は。とにかく、えーとみんな、えーと私たちは"}, {"type": "subtitle", "time": 18279.868, "timestamp": "05:04:39", "text": "寝る。遅いです"}]
[{"type": "subtitle", "time": 27602.67, "timestamp": "07:40:02", "text": "いつか。だから、私のクエストで見てみると"}, {"type": "subtitle", "time": 27604.91, "timestamp": "07:40:04", "text": "タブ"}, {"type": "subtitle", "time": 27607.948, "timestamp": "07:40:07", "text": "ああ、これだけだ"}, {"type": "subtitle", "time": 27611.03, "timestamp": "07:40:11", "text": "ストーリークエストがたくさんあるんだけど、これは何？"}, {"type": "subtitle", "time": 27612.868, "timestamp": "07:40:12", "text": "また？"}, {"type": "subtitle", "time": 27616.13, "timestamp": "07:40:16", "text": "モナモナ、それからえーと"}, {"type": "subtitle", "time": 27617.868, "timestamp": "07:40:17", "text": "[音楽]"}, {"type": "subtitle", "time": 27620.91, "timestamp": "07:40:20", "text": "えっと、どのキャラクターだったか忘れちゃった"}, {"type": "subtitle", "time": 27625.15, "timestamp": "07:40:25", "text": "これ、それから、これ J"}, {"type": "subtitle", "time": 27628.07, "timestamp": "07:40:28", "text": "チェンバーはこれがどのキャラクターだったか忘れてしまった"}, {"type": "subtitle", "time": 27630.868, "timestamp": "07:40:30", "text": "他の星座はよくわからない"}, {"type": "subtitle", "time": 27633.15, "timestamp": "07:40:33", "text": "子供、そうだね、"}, {"type": "subtitle", "time": 27635.67, "timestamp": "07:40:35", "text": "多くの人が、これが何であるかを信じている"}, {"type": "subtitle", "time": 27638.45, "timestamp": "07:40:38", "text": "蝶なのでこれは"}, {"type": "subtitle", "time": 27640.51, "timestamp": "07:40:40", "text": "[音楽]"}, {"type": "subtitle", "time": 27644.06, "timestamp": "07:40:44", "text": "フタ、それから、とても"}, {"type": "subtitle", "time": 27648.83, "timestamp": "07:40:48", "text": "[音楽]"}, {"type": "subtitle", "time": 27651.99, "timestamp": "07:40:51", "text": "多くの。待って、なぜ"}]
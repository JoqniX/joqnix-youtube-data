[{"type": "subtitle", "time": 14223.79, "timestamp": "03:57:03", "text": "わかった。えーと、レベル"}, {"type": "subtitle", "time": 14229.469, "timestamp": "03:57:09", "text": "4つ。彼女はアプリのアイコンも入手した。"}, {"type": "subtitle", "time": 14231.429, "timestamp": "03:57:11", "text": "プレミアム。あ、待って、待って、待って。私は思う"}, {"type": "subtitle", "time": 14234.99, "timestamp": "03:57:14", "text": "それは彼女自身のせいだ"}, {"type": "subtitle", "time": 14238.71, "timestamp": "03:57:18", "text": "自分の。ああ、それはプレミアムですね。彼女はビリーを手に入れた"}, {"type": "subtitle", "time": 14244.63, "timestamp": "03:57:24", "text": "サブスクリプション。プレミアム会員の場合"}, {"type": "subtitle", "time": 14246.71, "timestamp": "03:57:26", "text": "サブスクリプション サブスクリプション、"}, {"type": "subtitle", "time": 14249.349, "timestamp": "03:57:29", "text": "カスタムアイテム。プレミアム会員になりたい"}, {"type": "subtitle", "time": 14250.75, "timestamp": "03:57:30", "text": "サブスクリプション、"}, {"type": "subtitle", "time": 14253.91, "timestamp": "03:57:33", "text": "男。しかし、私のAlip Payは機能しません。いつ"}, {"type": "subtitle", "time": 14256.95, "timestamp": "03:57:36", "text": "これを手に入れた、もし私が作ったら"}, {"type": "subtitle", "time": 14259.51, "timestamp": "03:57:39", "text": "お金が十分あれば、プレミアムになります。"}, {"type": "subtitle", "time": 14261.95, "timestamp": "03:57:41", "text": "推測。私はしません"}, {"type": "subtitle", "time": 14265.99, "timestamp": "03:57:45", "text": "知る。必須ではないけれど、まあね。"}, {"type": "subtitle", "time": 14269.67, "timestamp": "03:57:49", "text": "彼女がその表紙を飾った。問題は今"}, {"type": "subtitle", "time": 14274.349, "timestamp": "03:57:54", "text": "人々は良質なコンテンツをアップロードします"}, {"type": "subtitle", "time": 14277.71, "timestamp": "03:57:57", "text": "ビデオ。それは"}]
[{"type": "subtitle", "time": 4440.669, "timestamp": "01:14:00", "text": "による。あなたの一日はどうでした？楽しかったですか？"}, {"type": "subtitle", "time": 4443.39, "timestamp": "01:14:03", "text": "今日？また、それは神聖なものであり、"}, {"type": "subtitle", "time": 4450.63, "timestamp": "01:14:10", "text": "聖なる。聖なるものを楽しんでいただけましたか？あ、待って。"}, {"type": "subtitle", "time": 4452.59, "timestamp": "01:14:12", "text": "明日は大きなヒイラギです。"}, {"type": "subtitle", "time": 4457.87, "timestamp": "01:14:17", "text": "右？うん、明日は大事な日だ"}, {"type": "subtitle", "time": 4462.63, "timestamp": "01:14:22", "text": "ヒイラギ。ヤシュのメッセージしか見つかりません"}, {"type": "subtitle", "time": 4476.709, "timestamp": "01:14:36", "text": "ヤシ？いいえ、彼は4回です。うん。"}, {"type": "subtitle", "time": 4488.91, "timestamp": "01:14:48", "text": "母と一緒に作りました。とは"}, {"type": "subtitle", "time": 4497.99, "timestamp": "01:14:57", "text": "良い？あなたにとってのサウンドステージまたは"}]
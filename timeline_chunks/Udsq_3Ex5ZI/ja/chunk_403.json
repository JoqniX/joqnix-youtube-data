[{"type": "subtitle", "time": 24189.03, "timestamp": "06:43:09", "text": "それ。待って、YouTubeで忘れてたよ、"}, {"type": "subtitle", "time": 24192.468, "timestamp": "06:43:12", "text": "剣と言ってもいいだろう。ああ、忘れてた。"}, {"type": "subtitle", "time": 24194.548, "timestamp": "06:43:14", "text": "最後の配信は、"}, {"type": "subtitle", "time": 24197.708, "timestamp": "06:43:17", "text": "Twitchで配信する"}, {"type": "subtitle", "time": 24201.91, "timestamp": "06:43:21", "text": "ニャー。待てよ、実はズキズキ"}, {"type": "subtitle", "time": 24205.35, "timestamp": "06:43:25", "text": "うっかり剣と言った、流れ"}, {"type": "subtitle", "time": 24208.31, "timestamp": "06:43:28", "text": "言葉。"}, {"type": "subtitle", "time": 24210.31, "timestamp": "06:43:30", "text": "何も起こらなかったのは良かったけど、それでも"}, {"type": "subtitle", "time": 24219.19, "timestamp": "06:43:39", "text": "猫。彼は『スウィンギング・キャップス』を書いた。"}, {"type": "subtitle", "time": 24221.91, "timestamp": "06:43:41", "text": "爆発するキャップを撃ち、"}, {"type": "subtitle", "time": 24230.43, "timestamp": "06:43:50", "text": "パパイ。ああ、神様。何をすべきか"}, {"type": "subtitle", "time": 24234.23, "timestamp": "06:43:54", "text": "これ？ああ、悪い息子だ。うん。おお。うん。また、"}, {"type": "subtitle", "time": 24235.708, "timestamp": "06:43:55", "text": "お電話ありがとうございます"}, {"type": "subtitle", "time": 24239.67, "timestamp": "06:43:59", "text": "昨日私は目を覚まさなかったけれど"}]
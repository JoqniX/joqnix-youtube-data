[{"type": "subtitle", "time": 7170.99, "timestamp": "01:59:30", "text": "D. 本当に"}, {"type": "subtitle", "time": 7174.629, "timestamp": "01:59:34", "text": "楽しい。どうしたの？それではまた"}, {"type": "subtitle", "time": 7176.629, "timestamp": "01:59:36", "text": "28."}, {"type": "subtitle", "time": 7179.629, "timestamp": "01:59:39", "text": "もしできるなら、私は"}, {"type": "subtitle", "time": 7186.99, "timestamp": "01:59:46", "text": "[音楽]"}, {"type": "subtitle", "time": 7191.189, "timestamp": "01:59:51", "text": "可能性はあるが、同時に、ただ希望を捨てるようなものでもある。"}, {"type": "subtitle", "time": 7193.35, "timestamp": "01:59:53", "text": "あれは退屈だったと思う。私はただあくびをした"}, {"type": "subtitle", "time": 7196.39, "timestamp": "01:59:56", "text": "火事のために出かけるので、私のPCへ"}, {"type": "subtitle", "time": 7198.43, "timestamp": "01:59:58", "text": "日"}]
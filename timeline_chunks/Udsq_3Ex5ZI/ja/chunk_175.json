[{"type": "subtitle", "time": 10501.439, "timestamp": "02:55:01", "text": "滑らないでください。滑らないでください。 滑らないでください。あなたはそうするでしょう"}, {"type": "subtitle", "time": 10503.2, "timestamp": "02:55:03", "text": "滑らないでください。あなたはそうするでしょう 死ぬ。やめてください"}, {"type": "subtitle", "time": 10510.75, "timestamp": "02:55:10", "text": "行く。私たちはもう少しで死ぬところだった。死にかけた"}, {"type": "subtitle", "time": 10515.23, "timestamp": "02:55:15", "text": "また。だから懐かしさは難しい、"}, {"type": "subtitle", "time": 10529.71, "timestamp": "02:55:29", "text": "パニック状態。いや、いや、いや、いや、"}, {"type": "subtitle", "time": 10534.15, "timestamp": "02:55:34", "text": "いいえ。何てことだ。私は"}, {"type": "subtitle", "time": 10537.79, "timestamp": "02:55:37", "text": "私は叫んでいた"}, {"type": "subtitle", "time": 10540.99, "timestamp": "02:55:40", "text": "はい、どうぞ。こんにちは、"}, {"type": "subtitle", "time": 10556.99, "timestamp": "02:55:56", "text": "[音楽]"}]
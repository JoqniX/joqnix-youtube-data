[{"type": "subtitle", "time": 8840.71, "timestamp": "02:27:20", "text": "[音楽]"}, {"type": "subtitle", "time": 8860.389, "timestamp": "02:27:40", "text": "それは選手だ。それが私たちの"}, {"type": "subtitle", "time": 8862.429, "timestamp": "02:27:42", "text": "チーム。何てことだ。私はとても"}, {"type": "subtitle", "time": 8865.91, "timestamp": "02:27:45", "text": "ごめん。あなたは誰だったのですか？どこ"}, {"type": "subtitle", "time": 8876.27, "timestamp": "02:27:56", "text": "[音楽]"}]
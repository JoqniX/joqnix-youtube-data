[{"type": "subtitle", "time": 27363.708, "timestamp": "07:36:03", "text": "メリッサ。"}, {"type": "subtitle", "time": 27378.548, "timestamp": "07:36:18", "text": "もっと。さて、原人はどうでしたか？あなたは"}, {"type": "subtitle", "time": 27380.99, "timestamp": "07:36:20", "text": "また、原人もプレイします。"}, {"type": "subtitle", "time": 27388.948, "timestamp": "07:36:28", "text": "これ。 Skyは契約できましたか？いや、違う。いいえ、いいえ、"}, {"type": "subtitle", "time": 27410.868, "timestamp": "07:36:50", "text": "ここ。私も彼を理解できませんでした。それなし"}, {"type": "subtitle", "time": 27414.23, "timestamp": "07:36:54", "text": "これ以上は何もせず、グラフィックを下げて"}, {"type": "subtitle", "time": 27415.31, "timestamp": "07:36:55", "text": "前に"}]
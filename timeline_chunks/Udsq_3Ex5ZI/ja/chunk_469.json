[{"type": "subtitle", "time": 28145.548, "timestamp": "07:49:05", "text": "合格。待って、"}, {"type": "subtitle", "time": 28148.628, "timestamp": "07:49:08", "text": "本当に？私は城の依頼は受けませんでした。"}, {"type": "subtitle", "time": 28157.628, "timestamp": "07:49:17", "text": "剣"}, {"type": "subtitle", "time": 28161.51, "timestamp": "07:49:21", "text": "彼らは待ち始めた。だからもしあなたが"}, {"type": "subtitle", "time": 28167.99, "timestamp": "07:49:27", "text": "剣も手に入るイベント"}, {"type": "subtitle", "time": 28171.59, "timestamp": "07:49:31", "text": "ストーリークエストで同じ剣を入手できます"}, {"type": "subtitle", "time": 28175.99, "timestamp": "07:49:35", "text": "イベントが"}, {"type": "subtitle", "time": 28179.27, "timestamp": "07:49:39", "text": "そこにはない。"}, {"type": "subtitle", "time": 28181.03, "timestamp": "07:49:41", "text": "もし彼らがそのようにやっているなら、それは"}, {"type": "subtitle", "time": 28184.23, "timestamp": "07:49:44", "text": "とても良い。"}, {"type": "subtitle", "time": 28186.788, "timestamp": "07:49:46", "text": "アルベルトのクエストをやれば、"}, {"type": "subtitle", "time": 28189.468, "timestamp": "07:49:49", "text": "アルベルトのものを入手できます"}, {"type": "subtitle", "time": 28193.35, "timestamp": "07:49:53", "text": "剣。わからない。"}, {"type": "subtitle", "time": 28196.388, "timestamp": "07:49:56", "text": "それがもし彼らがそうであるならば"}, {"type": "subtitle", "time": 28199.75, "timestamp": "07:49:59", "text": "そうすれば、"}]
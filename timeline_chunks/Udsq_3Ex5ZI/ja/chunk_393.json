[{"type": "subtitle", "time": 23581.39, "timestamp": "06:33:01", "text": "はい。千年"}, {"type": "subtitle", "time": 23584.07, "timestamp": "06:33:04", "text": "古い。私は彼女が100歳だと思っていました"}, {"type": "subtitle", "time": 23586.788, "timestamp": "06:33:06", "text": "彼女は年老いていたが、実際は千年も生きていたのだ。私"}, {"type": "subtitle", "time": 23595.75, "timestamp": "06:33:15", "text": "なるほど。えっと、ちょっと待ってください。えっと、どうやってアクセスすればいいですか？"}, {"type": "subtitle", "time": 23598.75, "timestamp": "06:33:18", "text": "アクセス"}, {"type": "subtitle", "time": 23602.27, "timestamp": "06:33:22", "text": "ダッシュボード？ああ、わかりました。手に入れた"}, {"type": "subtitle", "time": 23604.03, "timestamp": "06:33:24", "text": "それ。手に入れた"}, {"type": "subtitle", "time": 23608.31, "timestamp": "06:33:28", "text": "それ。また、YouTubeに関しては"}, {"type": "subtitle", "time": 23611.19, "timestamp": "06:33:31", "text": "ストリーム、私はとても傷ついています"}, {"type": "subtitle", "time": 23619.27, "timestamp": "06:33:39", "text": "えっと、これは私の庭で流れる音楽です。待って、"}, {"type": "subtitle", "time": 23622.35, "timestamp": "06:33:42", "text": "ストリーミング配信。え、何？わかった、絶対にない"}, {"type": "subtitle", "time": 23624.788, "timestamp": "06:33:44", "text": "心。 YouTubeのストリームに関しては、"}, {"type": "subtitle", "time": 23626.99, "timestamp": "06:33:46", "text": "私は設定していません"}, {"type": "subtitle", "time": 23629.23, "timestamp": "06:33:49", "text": "忠誠心。忠誠心"}, {"type": "subtitle", "time": 23632.15, "timestamp": "06:33:52", "text": "もの。あ、待って。忠誠心について語る"}, {"type": "subtitle", "time": 23635.19, "timestamp": "06:33:55", "text": "もの。この新しいものには追加していません"}, {"type": "subtitle", "time": 23638.468, "timestamp": "06:33:58", "text": "私が使っているのはOBSです。"}]
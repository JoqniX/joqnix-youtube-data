[{"type": "subtitle", "time": 24244.31, "timestamp": "06:44:04", "text": "確認させてください、その後でも。どうやって"}, {"type": "subtitle", "time": 24245.868, "timestamp": "06:44:05", "text": "私は何件の電話を受けましたか"}, {"type": "subtitle", "time": 24250.41, "timestamp": "06:44:10", "text": "昨日？えっと、ズキの配信1の時"}, {"type": "subtitle", "time": 24258.27, "timestamp": "06:44:18", "text": "2つの10"}, {"type": "subtitle", "time": 24260.19, "timestamp": "06:44:20", "text": "プラス"}, {"type": "subtitle", "time": 24261.708, "timestamp": "06:44:21", "text": "[音楽]"}, {"type": "subtitle", "time": 24264.548, "timestamp": "06:44:24", "text": "ああ、たくさんの人、つまり10人"}, {"type": "subtitle", "time": 24269.03, "timestamp": "06:44:29", "text": "電話してきたけど、私に電話しようとしたけど、えっと、"}, {"type": "subtitle", "time": 24272.628, "timestamp": "06:44:32", "text": "1人あたり2～3回"}, {"type": "subtitle", "time": 24275.51, "timestamp": "06:44:35", "text": "目を覚まさなかった。"}, {"type": "subtitle", "time": 24279.75, "timestamp": "06:44:39", "text": "それで、私のいとこがここにいます"}, {"type": "subtitle", "time": 24282.59, "timestamp": "06:44:42", "text": "えーと、つまり2人、彼はここにいます"}, {"type": "subtitle", "time": 24286.628, "timestamp": "06:44:46", "text": "1週間か2週間くらい。だから彼は"}, {"type": "subtitle", "time": 24288.91, "timestamp": "06:44:48", "text": "昨日映画を見ていたのですが、"}, {"type": "subtitle", "time": 24292.83, "timestamp": "06:44:52", "text": "10 11 で考える"}, {"type": "subtitle", "time": 24295.75, "timestamp": "06:44:55", "text": "午後頃私はちょうどベッドにいました"}, {"type": "subtitle", "time": 24299.35, "timestamp": "06:44:59", "text": "スマホでネットサーフィンをしている。とても疲れていた。"}]
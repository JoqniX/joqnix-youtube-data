[{"type": "subtitle", "time": 4740.83, "timestamp": "01:19:00", "text": "また？これは何て言うんでしたっけ？"}, {"type": "subtitle", "time": 4743.229, "timestamp": "01:19:03", "text": "えっと、あなたのコンピューター"}, {"type": "subtitle", "time": 4745.55, "timestamp": "01:19:05", "text": "wケーブル"}, {"type": "subtitle", "time": 4748.709, "timestamp": "01:19:08", "text": "管理。私はすでにケーブルを整理しました"}, {"type": "subtitle", "time": 4753.91, "timestamp": "01:19:13", "text": "もの。でも、それはある意味、私は"}, {"type": "subtitle", "time": 4757.27, "timestamp": "01:19:17", "text": "考え忘れていた。何？もしも？"}, {"type": "subtitle", "time": 4759.91, "timestamp": "01:19:19", "text": "戻ってきました。戻ってきました。戻ってきました。持つ"}, {"type": "subtitle", "time": 4763.35, "timestamp": "01:19:23", "text": "おやすみ。わかった。"}, {"type": "subtitle", "time": 4766.669, "timestamp": "01:19:26", "text": "はい、戻ってきました。食事の時間だ。その時が来た"}, {"type": "subtitle", "time": 4779.79, "timestamp": "01:19:39", "text": "わーい。何てことだ。何てことだ。ああ、"}, {"type": "subtitle", "time": 4783.99, "timestamp": "01:19:43", "text": "神。何てことだ。何てことだ。"}, {"type": "subtitle", "time": 4785.63, "timestamp": "01:19:45", "text": "私は"}, {"type": "subtitle", "time": 4788.11, "timestamp": "01:19:48", "text": "戻る。楽しんでいただければ幸いです"}]
[{"type": "subtitle", "time": 16874.67, "timestamp": "04:41:14", "text": "男。 Genshinatはノードと共に変化しています"}, {"type": "subtitle", "time": 16876.43, "timestamp": "04:41:16", "text": "[音楽]"}, {"type": "subtitle", "time": 16878.19, "timestamp": "04:41:18", "text": "泣く。"}, {"type": "subtitle", "time": 16881.51, "timestamp": "04:41:21", "text": "H 私は本当に多くのことを調査する必要がある"}, {"type": "subtitle", "time": 16881.79, "timestamp": "04:41:21", "text": "もの"}, {"type": "subtitle", "time": 16884.11, "timestamp": "04:41:24", "text": "[音楽]"}, {"type": "subtitle", "time": 16886.91, "timestamp": "04:41:26", "text": "今。私は感じる"}, {"type": "subtitle", "time": 16890.15, "timestamp": "04:41:30", "text": "正直に言うと、これらのバックエンドはすべて"}, {"type": "subtitle", "time": 16893.11, "timestamp": "04:41:33", "text": "私がしていること、それらの感じ"}, {"type": "subtitle", "time": 16895.59, "timestamp": "04:41:35", "text": "考えてみると不必要だ"}, {"type": "subtitle", "time": 16897.31, "timestamp": "04:41:37", "text": "ちょうど"}, {"type": "subtitle", "time": 16899.75, "timestamp": "04:41:39", "text": "自分のストリームを録画して"}, {"type": "subtitle", "time": 16902.628, "timestamp": "04:41:42", "text": "ビデオですが、ビデオエディターが必要です"}, {"type": "subtitle", "time": 16904.83, "timestamp": "04:41:44", "text": "動画がわからない"}, {"type": "subtitle", "time": 16907.43, "timestamp": "04:41:47", "text": "編集するには今となっては手間がかかりすぎる"}, {"type": "subtitle", "time": 16911.75, "timestamp": "04:41:51", "text": "すでにそれは巨大な仕事です"}, {"type": "subtitle", "time": 16915.59, "timestamp": "04:41:55", "text": "もう多すぎる"}, {"type": "subtitle", "time": 16917.31, "timestamp": "04:41:57", "text": "終わらせる"}]
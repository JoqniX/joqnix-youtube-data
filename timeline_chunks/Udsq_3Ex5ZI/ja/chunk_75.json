[{"type": "subtitle", "time": 4515.59, "timestamp": "01:15:15", "text": "わかった。えっと、私が「ダメ」と言うまで1分間"}, {"type": "subtitle", "time": 4519.75, "timestamp": "01:15:19", "text": "何でも入力してください。わかった。今後は"}, {"type": "subtitle", "time": 4522.63, "timestamp": "01:15:22", "text": "何も入力しないでください。しばらくお待ちください"}, {"type": "subtitle", "time": 4525.47, "timestamp": "01:15:25", "text": "若干。持ち続ける"}, {"type": "subtitle", "time": 4529.31, "timestamp": "01:15:29", "text": "つま先。 H それをちょうど"}, {"type": "subtitle", "time": 4533.189, "timestamp": "01:15:33", "text": "待って。ちょっと待って。"}, {"type": "subtitle", "time": 4538.03, "timestamp": "01:15:38", "text": "削除してください。私が入力するまで入力しないでください"}, {"type": "subtitle", "time": 4541.11, "timestamp": "01:15:41", "text": "すべき。わかった。えっと、あれは削除しないと。"}, {"type": "subtitle", "time": 4542.55, "timestamp": "01:15:42", "text": "アカウント。カウントはどこですか？どこ"}, {"type": "subtitle", "time": 4544.51, "timestamp": "01:15:44", "text": "カウント？どこにあるの"}, {"type": "subtitle", "time": 4548.229, "timestamp": "01:15:48", "text": "カウント？ヤシュをすぐに見つけて。わかった。ヤシュ"}, {"type": "subtitle", "time": 4549.07, "timestamp": "01:15:49", "text": "は"}, {"type": "subtitle", "time": 4551.87, "timestamp": "01:15:51", "text": "1つ。うん、そうしよう"}, {"type": "subtitle", "time": 4554.27, "timestamp": "01:15:54", "text": "なれ。他に何かありますか？"}, {"type": "subtitle", "time": 4557.669, "timestamp": "01:15:57", "text": "ヤシュ？わかった。グラブジャムみたいなもの。いいえ、"}]
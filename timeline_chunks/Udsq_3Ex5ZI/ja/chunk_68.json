[{"type": "subtitle", "time": 4097.87, "timestamp": "01:08:17", "text": "憧れの人との電話が終わった"}, {"type": "subtitle", "time": 4102.55, "timestamp": "01:08:22", "text": "友人。隣人がノートパソコンを持っていて"}, {"type": "subtitle", "time": 4105.189, "timestamp": "01:08:25", "text": "ドンドンと音がして、彼は"}, {"type": "subtitle", "time": 4109.03, "timestamp": "01:08:29", "text": "課題とか色々。それで彼は私に尋ねた"}, {"type": "subtitle", "time": 4112.229, "timestamp": "01:08:32", "text": "もしノートパソコンを持っていたら。私は「いいえ」と答えた。私"}, {"type": "subtitle", "time": 4114.309, "timestamp": "01:08:34", "text": "私はPCを持っていて、彼は私が"}, {"type": "subtitle", "time": 4115.07, "timestamp": "01:08:35", "text": "行う"}, {"type": "subtitle", "time": 4118.149, "timestamp": "01:08:38", "text": "ジョアソン。私は彼に自分の持ち物について話しました"}, {"type": "chat", "time": 4119.359, "timestamp": "01:08:39", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "lmao"}, {"type": "subtitle", "time": 4122.07, "timestamp": "01:08:42", "text": "ずっと昔。そこで私は彼にそれが何であるかを説明しました。"}, {"type": "subtitle", "time": 4124.55, "timestamp": "01:08:44", "text": "そして全て。彼は私の"}, {"type": "subtitle", "time": 4126.43, "timestamp": "01:08:46", "text": "インスタグラム"}, {"type": "chat", "time": 4126.457, "timestamp": "01:08:46", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Joq's Activity State is Toilet-Break"}, {"type": "subtitle", "time": 4128.99, "timestamp": "01:08:48", "text": "話。ああ、"}, {"type": "subtitle", "time": 4130.749, "timestamp": "01:08:50", "text": "神。"}, {"type": "subtitle", "time": 4133.709, "timestamp": "01:08:53", "text": "えっと、でも"}, {"type": "subtitle", "time": 4137.269, "timestamp": "01:08:57", "text": "うん、ちょっと休憩して戻ってくるよ"}, {"type": "subtitle", "time": 4139.03, "timestamp": "01:08:59", "text": "戻る。よし、ちょっとトイレに行ってくるね"}]
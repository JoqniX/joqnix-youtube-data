[{"type": "subtitle", "time": 27062.03, "timestamp": "07:31:02", "text": "重複しない。とりあえず今は45のままにしておきます。"}, {"type": "subtitle", "time": 27064.468, "timestamp": "07:31:04", "text": "わかった。音声が今"}, {"type": "subtitle", "time": 27065.23, "timestamp": "07:31:05", "text": "は"}, {"type": "subtitle", "time": 27069.628, "timestamp": "07:31:09", "text": "わかった。こんにちは。何？はい。さあ"}, {"type": "subtitle", "time": 27072.83, "timestamp": "07:31:12", "text": "行く。で、あなたは元気ですか"}, {"type": "subtitle", "time": 27075.75, "timestamp": "07:31:15", "text": "みんな？今日はストリーミング配信します"}, {"type": "subtitle", "time": 27078.708, "timestamp": "07:31:18", "text": "原神インパクト。できるかどうか疑問に思います"}, {"type": "subtitle", "time": 27081.91, "timestamp": "07:31:21", "text": "ストリーミング配信中"}, {"type": "subtitle", "time": 27083.708, "timestamp": "07:31:23", "text": "私"}, {"type": "subtitle", "time": 27089.19, "timestamp": "07:31:29", "text": "願いのボードのビデオをレンダリングする"}, {"type": "subtitle", "time": 27091.788, "timestamp": "07:31:31", "text": "1時間配信しました"}, {"type": "subtitle", "time": 27095.868, "timestamp": "07:31:35", "text": "前。 35％くらい"}, {"type": "subtitle", "time": 27098.468, "timestamp": "07:31:38", "text": "終わり。実は初めてなんです"}, {"type": "subtitle", "time": 27100.868, "timestamp": "07:31:40", "text": "配信で配信して"}, {"type": "subtitle", "time": 27103.83, "timestamp": "07:31:43", "text": "すべて、あらゆるものが遅れている"}, {"type": "subtitle", "time": 27106.19, "timestamp": "07:31:46", "text": "そして私はこう思う"}, {"type": "subtitle", "time": 27109.23, "timestamp": "07:31:49", "text": "はい。待って、どういう意味ですか？はい"}, {"type": "subtitle", "time": 27112.23, "timestamp": "07:31:52", "text": "冗談？何てことだ。つまり、"}, {"type": "subtitle", "time": 27115.468, "timestamp": "07:31:55", "text": "大丈夫。私たちはゲームに参加できます。私"}]
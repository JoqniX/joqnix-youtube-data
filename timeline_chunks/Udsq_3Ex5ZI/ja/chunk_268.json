[{"type": "subtitle", "time": 16081.189, "timestamp": "04:28:01", "text": "何年もか何か、何なのか分からない"}, {"type": "subtitle", "time": 16084.55, "timestamp": "04:28:04", "text": "創造者になるという意味です。私はしません"}, {"type": "subtitle", "time": 16087.189, "timestamp": "04:28:07", "text": "スポンサーシップがある。私はあまり持っていません"}, {"type": "subtitle", "time": 16091.03, "timestamp": "04:28:11", "text": "視聴者が視聴者に何かを見せている。しかし"}, {"type": "subtitle", "time": 16094.55, "timestamp": "04:28:14", "text": "平均的なCCVは、人々がブランドに注目しているものです。"}, {"type": "subtitle", "time": 16097.67, "timestamp": "04:28:17", "text": "今はそんな感じです。そして、とてもたくさんあります"}, {"type": "subtitle", "time": 16100.59, "timestamp": "04:28:20", "text": "彼が説明したようなこと"}, {"type": "subtitle", "time": 16102.59, "timestamp": "04:28:22", "text": "のような"}, {"type": "subtitle", "time": 16106.309, "timestamp": "04:28:26", "text": "わあ、そんなこと全然知らなかったよ"}, {"type": "subtitle", "time": 16110.269, "timestamp": "04:28:30", "text": "カテゴリプッシュ"}, {"type": "subtitle", "time": 16122.03, "timestamp": "04:28:42", "text": "クレイジー"}, {"type": "subtitle", "time": 16133.07, "timestamp": "04:28:53", "text": "おお。その"}, {"type": "subtitle", "time": 16136.229, "timestamp": "04:28:56", "text": "クレイジー。いや、私は"}, {"type": "subtitle", "time": 16138.87, "timestamp": "04:28:58", "text": "正直に私の気持ちを伝えます。まるで"}]
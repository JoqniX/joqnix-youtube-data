[{"type": "subtitle", "time": 28990.948, "timestamp": "08:03:10", "text": "経験。寝て過ごすのが大好き"}, {"type": "subtitle", "time": 28994.67, "timestamp": "08:03:14", "text": "その中間。おお。"}, {"type": "subtitle", "time": 28997.03, "timestamp": "08:03:17", "text": "待って、顔を洗った方がいいかな？私は思う"}, {"type": "subtitle", "time": 28999.23, "timestamp": "08:03:19", "text": "すべき。私はしません"}]
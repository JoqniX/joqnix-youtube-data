[{"type": "subtitle", "time": 18423.11, "timestamp": "05:07:03", "text": "その物。えっと、その言葉は、その言葉は"}, {"type": "subtitle", "time": 18424.19, "timestamp": "05:07:04", "text": "ダウンロード中"}, {"type": "subtitle", "time": 18427.43, "timestamp": "05:07:07", "text": "クリップが投稿された場​​所"}, {"type": "subtitle", "time": 18429.55, "timestamp": "05:07:09", "text": "ええと、私たちは正式にすべての"}, {"type": "subtitle", "time": 18432.868, "timestamp": "05:07:12", "text": "Twitchからのクリップ。今はただのユーチューバーだけ"}, {"type": "subtitle", "time": 18434.27, "timestamp": "05:07:14", "text": "左。後"}, {"type": "subtitle", "time": 18436.628, "timestamp": "05:07:16", "text": "その後、私は懇願するつもりです"}, {"type": "subtitle", "time": 18440.15, "timestamp": "05:07:20", "text": "みんな私を切り取ってくれてありがとう"}, {"type": "subtitle", "time": 18443.75, "timestamp": "05:07:23", "text": "今日はここまで。楽しかった。寝ます。私"}, {"type": "subtitle", "time": 18445.59, "timestamp": "05:07:25", "text": "遅延させたくありません"}, {"type": "subtitle", "time": 18448.07, "timestamp": "05:07:28", "text": "より長く。私も食事に行かなければならない。私はそうしました"}, {"type": "subtitle", "time": 18451.75, "timestamp": "05:07:31", "text": "昼食、いや夕食を少し食べる"}, {"type": "subtitle", "time": 18455.11, "timestamp": "05:07:35", "text": "でも、もっときちんと食事をしたいんです。それで"}, {"type": "subtitle", "time": 18458.39, "timestamp": "05:07:38", "text": "うん、取らなきゃいけないんだ、えっと、私は"}, {"type": "subtitle", "time": 18460.39, "timestamp": "05:07:40", "text": "えっと、お米に水を入れて、"}, {"type": "subtitle", "time": 18462.39, "timestamp": "05:07:42", "text": "そして、すべてを"}, {"type": "subtitle", "time": 18465.43, "timestamp": "05:07:45", "text": "冷蔵庫も何もかも。ええ、私は行きます"}, {"type": "subtitle", "time": 18468.39, "timestamp": "05:07:48", "text": "私はおしっこを食べに行くつもりです。君たち"}, {"type": "subtitle", "time": 18471.51, "timestamp": "05:07:51", "text": "気をつけて。本日はありがとうございました。明日"}, {"type": "subtitle", "time": 18473.51, "timestamp": "05:07:53", "text": "私たちはビデオを作ろうとしています、"}, {"type": "subtitle", "time": 18476.23, "timestamp": "05:07:56", "text": "何か。私は無理やり"}, {"type": "subtitle", "time": 18479.99, "timestamp": "05:07:59", "text": "自分に無理強いして、挑戦して"}]
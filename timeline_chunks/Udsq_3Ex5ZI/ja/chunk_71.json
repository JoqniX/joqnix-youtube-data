[{"type": "subtitle", "time": 4260.47, "timestamp": "01:11:00", "text": "でも、たぶん初めて"}, {"type": "subtitle", "time": 4264.43, "timestamp": "01:11:04", "text": "配信に最初に参加した人。"}, {"type": "subtitle", "time": 4266.59, "timestamp": "01:11:06", "text": "はい。はい。"}, {"type": "subtitle", "time": 4271.87, "timestamp": "01:11:11", "text": "うん。待って、トラッキングが機能していません。"}, {"type": "subtitle", "time": 4273.63, "timestamp": "01:11:13", "text": "はぁ。"}, {"type": "subtitle", "time": 4276.95, "timestamp": "01:11:16", "text": "面白い。うん。それは、えっと、何"}, {"type": "subtitle", "time": 4278.63, "timestamp": "01:11:18", "text": "あなたはそれを何と呼びますか？"}, {"type": "subtitle", "time": 4282.55, "timestamp": "01:11:22", "text": "それは、えーと、私は"}, {"type": "subtitle", "time": 4286.07, "timestamp": "01:11:26", "text": "まだカメラを設置していないんです。それで"}, {"type": "subtitle", "time": 4288.03, "timestamp": "01:11:28", "text": "その"}, {"type": "subtitle", "time": 4292.63, "timestamp": "01:11:32", "text": "痛み。これは加速するだろう。そして私は必要とする"}, {"type": "subtitle", "time": 4295.83, "timestamp": "01:11:35", "text": "モニターを取りに行く。ああ、それは"}, {"type": "subtitle", "time": 4298.35, "timestamp": "01:11:38", "text": "今は小さくなった。ああ、なんてことだ。"}, {"type": "subtitle", "time": 4303.11, "timestamp": "01:11:43", "text": "いいえ。どうすれば大きくなれるの、坊や？来る。"}, {"type": "subtitle", "time": 4316.03, "timestamp": "01:11:56", "text": "トラッキング。いや、待って。手が届かない。"}, {"type": "subtitle", "time": 4318.43, "timestamp": "01:11:58", "text": "いいえ。いいえ"}]
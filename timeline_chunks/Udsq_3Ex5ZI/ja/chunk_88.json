[{"type": "subtitle", "time": 5282.47, "timestamp": "01:28:02", "text": "今は夜です。私たちはどうすべきでしょうか？"}, {"type": "subtitle", "time": 5294.07, "timestamp": "01:28:14", "text": "日本のヘッダー。つまり、私はそうできたらいいのに、ということですね。"}, {"type": "subtitle", "time": 5297.43, "timestamp": "01:28:17", "text": "あちらでバターミルクを買ってきて。ちょっと待ってください"}, {"type": "chat", "time": 5304.809, "timestamp": "01:28:24", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "go and talk to random people in the street"}, {"type": "subtitle", "time": 5306.669, "timestamp": "01:28:26", "text": "利用可能であることを知っていた"}, {"type": "subtitle", "time": 5313.59, "timestamp": "01:28:33", "text": "日本。広くは入手できないが、"}, {"type": "subtitle", "time": 5315.91, "timestamp": "01:28:35", "text": "国によっては、バターミルクが入手可能です"}, {"type": "chat", "time": 5317.774, "timestamp": "01:28:37", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "i'm more of a \"if i can pay someone else to do it for me\" kinda person"}, {"type": "subtitle", "time": 5318.87, "timestamp": "01:28:38", "text": "日本では粉末状で発見されている"}, {"type": "subtitle", "time": 5321.51, "timestamp": "01:28:41", "text": "その種族の特別な産物。あなたはできる"}, {"type": "subtitle", "time": 5324.149, "timestamp": "01:28:44", "text": "少量の液体バターを探してください。"}, {"type": "chat", "time": 5327.328, "timestamp": "01:28:47", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "saves me time to focus on my stuff"}, {"type": "chat", "time": 5331.904, "timestamp": "01:28:51", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "Butter milk"}, {"type": "subtitle", "time": 5333.189, "timestamp": "01:28:53", "text": "JPさん、牛乳にレモン汁を加えるだけでいいですよ。兄弟、私は"}, {"type": "subtitle", "time": 5336.03, "timestamp": "01:28:56", "text": "本物が欲しい"}]
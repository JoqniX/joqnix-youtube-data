[{"type": "subtitle", "time": 8765.91, "timestamp": "02:26:05", "text": "これで完了です。次はPUBGです。願わくば"}, {"type": "subtitle", "time": 8768.91, "timestamp": "02:26:08", "text": "PUBGをもっとプレイしたい、"}, {"type": "subtitle", "time": 8774.19, "timestamp": "02:26:14", "text": "男。 PUBGをプレイするのが恋しい。戦場。"}, {"type": "subtitle", "time": 8782.95, "timestamp": "02:26:22", "text": "ああ、あれは選手だ。それが私たちの"}, {"type": "subtitle", "time": 8784.99, "timestamp": "02:26:24", "text": "チーム。何てことだ。私はとても"}, {"type": "subtitle", "time": 8787.63, "timestamp": "02:26:27", "text": "ごめん。あなたは誰だったのですか？"}, {"type": "subtitle", "time": 8806.309, "timestamp": "02:26:46", "text": "あの頃の私はすごくかっこよかった。"}]
[{"type": "subtitle", "time": 11228.95, "timestamp": "03:07:08", "text": "私たちはハビビ・ジャズマを手に入れました。作ってみて"}, {"type": "subtitle", "time": 11230.469, "timestamp": "03:07:10", "text": "うるさい。"}, {"type": "subtitle", "time": 11233.11, "timestamp": "03:07:13", "text": "赤側にはかわいい"}, {"type": "subtitle", "time": 11236.85, "timestamp": "03:07:16", "text": "愛らしいジョックン。騒ぎを起こせ。"}, {"type": "subtitle", "time": 11238.469, "timestamp": "03:07:18", "text": "[音楽]"}, {"type": "subtitle", "time": 11241.03, "timestamp": "03:07:21", "text": "ジョックンとハビビの喧嘩"}, {"type": "subtitle", "time": 11243.19, "timestamp": "03:07:23", "text": "あと3分でスタート。なぜ私は緊張しているのだろう？私は"}, {"type": "subtitle", "time": 11245.269, "timestamp": "03:07:25", "text": "震えている。"}, {"type": "subtitle", "time": 11253.269, "timestamp": "03:07:33", "text": "始める。おお、ジョー、いい攻撃だ。で"}, {"type": "subtitle", "time": 11265.19, "timestamp": "03:07:45", "text": "ニース。この映像クリップが欲しいです。私"}]
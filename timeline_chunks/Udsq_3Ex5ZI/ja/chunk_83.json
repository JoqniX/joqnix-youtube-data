[{"type": "subtitle", "time": 4982.87, "timestamp": "01:23:02", "text": "9:00 なぜなら私は私は彼らに言った"}, {"type": "subtitle", "time": 4984.99, "timestamp": "01:23:04", "text": "気分が良くないと彼らに言った"}, {"type": "subtitle", "time": 4987.35, "timestamp": "01:23:07", "text": "カップを食べているからお腹が空いた"}, {"type": "subtitle", "time": 4996.55, "timestamp": "01:23:16", "text": "今。ところで、えっと、私は知ってるんだけど"}, {"type": "subtitle", "time": 4997.95, "timestamp": "01:23:17", "text": "8個購入しました"}, {"type": "subtitle", "time": 5012.95, "timestamp": "01:23:32", "text": "ちょっと待ってください。私の部屋に1つあります"}, {"type": "subtitle", "time": 5015.83, "timestamp": "01:23:35", "text": "そして、私が食べるのは、ええと、右です"}, {"type": "subtitle", "time": 5020.99, "timestamp": "01:23:40", "text": "今。そして私は叔母に2つあげて"}, {"type": "subtitle", "time": 5024.07, "timestamp": "01:23:44", "text": "叔父。そして私の母と祖母"}, {"type": "subtitle", "time": 5026.47, "timestamp": "01:23:46", "text": "欲しくなかったので、残りは取っておいた。"}]